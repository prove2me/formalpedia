theorem big_ev_sol_aux (K x : ℕ) : ∃ B₀ : ℕ, ∀ b, B₀ ≤ b →
    2 * ((K * b ^ 5 * (6 * b ^ (1 + x)) ^ 9) * (K * b ^ 5 * (6 * b ^ (1 + x)) ^ 9)) * b ^ (1 + x) ≤
      2 ^ (b + 1) := by
  obtain ⟨B₀, hB⟩ := poly_le_two_pow_half (11 + 19 * (1 + x))
  refine ⟨max B₀ (2 * K ^ 2 * 6 ^ 18), fun b hb => ?_⟩
  have h1 := hB b (le_of_max_le_left hb)
  have h2 : 2 * K ^ 2 * 6 ^ 18 ≤ b := le_of_max_le_right hb
  have e : 2 * ((K * b ^ 5 * (6 * b ^ (1 + x)) ^ 9) * (K * b ^ 5 * (6 * b ^ (1 + x)) ^ 9)) *
      b ^ (1 + x) = (2 * K ^ 2 * 6 ^ 18) * b ^ (10 + 19 * (1 + x)) := by ring
  have e2 : b ^ (11 + 19 * (1 + x)) = b * b ^ (10 + 19 * (1 + x)) := by ring
  have h3 : 2 ^ (b / 2) ≤ 2 ^ (b + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  rw [e]
  calc (2 * K ^ 2 * 6 ^ 18) * b ^ (10 + 19 * (1 + x)) ≤ b * b ^ (10 + 19 * (1 + x)) :=
        Nat.mul_le_mul_right _ h2
    _ = b ^ (11 + 19 * (1 + x)) := e2.symm
    _ ≤ 8 * b ^ (11 + 19 * (1 + x)) := by omega
    _ ≤ _ := h1.trans h3

