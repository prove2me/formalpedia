-- title:
--   Base change of the crossing algebra B[u,v]/(uv-b)
-- statement:
--   Let $W$ be a commutative ring, $t$ an element of $W$, and $B$ a commutative ring equipped with a $W$-algebra structure; let $b$ be an element of $B$ with $\mathrm{algebraMap}_{W\to B}(t)=b$. Write, for a commutative ring $R$ and an element $s\in R$, $\mathrm{CrossingQuotient}\,R\,s$ for the quotient of the polynomial ring $R[X_0,X_1]$ in two variables indexed by $\mathrm{Fin}\ 2$ by the ideal generated by $X_0X_1-s$, and let $\mathrm{CrossingQuotient.U}\,s$ and $\mathrm{CrossingQuotient.V}\,s$ be the two distinguished elements of that quotient (whose product is the image of $s$). The assertion is that there exists an isomorphism $e$ of $B$-algebras from $\mathrm{CrossingQuotient}\,B\,b$, i.e. $B[X_0,X_1]/(X_0X_1-b)$, to the tensor product $B\otimes_W \mathrm{CrossingQuotient}\,W\,t$, i.e. $B\otimes_W W[X_0,X_1]/(X_0X_1-t)$, such that $e(\mathrm{CrossingQuotient.U}\,b)=1\otimes \mathrm{CrossingQuotient.U}\,t$ and $e(\mathrm{CrossingQuotient.V}\,b)=1\otimes \mathrm{CrossingQuotient.V}\,t$. Both rings are taken in the same universe. The isomorphism is asserted to exist together with its effect on the two generators, not produced as a named map.
--
--   This is the base-change compatibility of the standard presentation of a node, $uv=t$: forming the crossing algebra commutes with extension of the base ring along $W\to B$, matched up on the two coordinate functions. It is used to transport étale crossing charts on models of modular curves along base change of the coefficient ring, and is cited by the statements about crossing charts over a valuation subring and about the order of a read-off chart function.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPolynomial_CrossingQuotient_exists_algEquiv_tensorProduct_apply_U_and_apply_V.lean

import Mathlib
import Definitions.Def_MvPolynomial_CrossingResolutionScheme

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open MvPolynomial TensorProduct

universe u v

theorem MvPolynomial.CrossingQuotient.exists_algEquiv_tensorProduct_apply_U_and_apply_V
    (W : Type u) [CommRing W] (t : W) (B : Type u) [CommRing B] [Algebra W B] (b : B) (hb : algebraMap W B t = b) :
    ∃ e : CrossingQuotient B b ≃ₐ[B] B ⊗[W] CrossingQuotient W t,
      e (CrossingQuotient.U b) = (1 : B) ⊗ₜ[W] CrossingQuotient.U t ∧
      e (CrossingQuotient.V b) = (1 : B) ⊗ₜ[W] CrossingQuotient.V t := by sorry
