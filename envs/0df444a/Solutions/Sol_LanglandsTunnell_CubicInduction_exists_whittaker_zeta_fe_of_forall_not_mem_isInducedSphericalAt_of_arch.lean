variable {F : Type*} [CommRing F]

private theorem _root_.LanglandsTunnell.CubicInduction.TorusDilation.transposeInv3_mul
    (g h : GL (Fin 3) F) : transposeInv3 (g * h) = transposeInv3 g * transposeInv3 h := by
  refine Units.ext ?_
  show ((((g * h)⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)).transpose =
    (((g⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)).transpose * (((h⁻¹ : GL (Fin 3) F) : Matrix _ _ F)).transpose
  rw [mul_inv_rev, Units.val_mul, Matrix.transpose_mul]

p2m_export "LanglandsTunnell.CubicInduction.TorusDilation" "transposeInv3_mul"

private theorem map_transposeInv3 {E : Type*} [CommRing E] (f : F →+* E) (g : GL (Fin 3) F) :
    Matrix.GeneralLinearGroup.map f (transposeInv3 g) = transposeInv3 (Matrix.GeneralLinearGroup.map f g) := by
  refine Units.ext ?_
  ext i j
  show f ((((g⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)).transpose i j) =
    ((((Matrix.GeneralLinearGroup.map f g)⁻¹ : GL (Fin 3) E) : Matrix (Fin 3) (Fin 3) E)).transpose i j
  rw [← map_inv, Matrix.transpose_apply, Matrix.transpose_apply, Matrix.GeneralLinearGroup.map_apply]

end
