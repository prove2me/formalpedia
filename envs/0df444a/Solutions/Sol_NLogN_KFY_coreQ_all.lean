/-- One slice: `gD : gints x ++ r ↦ r`, `gZB : Z ↦ (gints (f x)).reverse ++ Z`. -/
theorem chunkBody_all2 (ax : GL.Axis M Ctx B) (Bo : ℕ) (s0 : IState HS) (Q : ℕ) (hr : AxReady2 ax Bo s0 Q)
