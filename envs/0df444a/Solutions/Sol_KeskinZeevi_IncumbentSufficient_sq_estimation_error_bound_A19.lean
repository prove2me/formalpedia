/-- the history σ-algebra generated by `ε 1, …, ε n`. -/
def F {Ω : Type*} (ε : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ Set.Icc 1 n, MeasurableSpace.comap (ε i) inferInstance

lemma F_mono {Ω : Type*} (ε : ℕ → Ω → ℝ) {m n : ℕ} (h : m ≤ n) : F ε m ≤ F ε n := by
  unfold F
  exact biSup_mono (fun i hi => ⟨hi.1, le_trans hi.2 h⟩)

lemma eps_measF {Ω : Type*} (ε : ℕ → Ω → ℝ) {i n : ℕ} (h1 : 1 ≤ i) (h2 : i ≤ n) :
    Measurable[F ε n] (ε i) := by
  rw [measurable_iff_comap_le]
  unfold F
  exact le_iSup₂_of_le (f := fun j (_ : j ∈ Set.Icc 1 n) =>
    MeasurableSpace.comap (ε j) inferInstance) i ⟨h1, h2⟩ le_rfl

lemma priceAux_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[F ε n] (fun ω => priceAux π β ε ω n) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    have h : (fun ω => priceAux π β ε ω n) = fun ω => π.rule n (fun i : Fin n =>
        (M.DHat + β * (priceAux π β ε ω i - M.pHat) + ε ((i : ℕ) + 1) ω, priceAux π β ε ω i)) := by
      funext ω
      rw [priceAux]
    rw [h]
    letI : MeasurableSpace Ω := F ε n
    refine (π.measurable_rule n).comp (measurable_pi_lambda _ (fun i => ?_))
    have hi : Measurable[F ε n] (fun ω => priceAux π β ε ω i) :=
      (ih i i.isLt).mono (F_mono ε (le_of_lt i.isLt)) le_rfl
    have he : Measurable[F ε n] (ε ((i : ℕ) + 1)) := eps_measF ε (by omega) (by omega)
    exact ((measurable_const.add (measurable_const.mul (hi.sub_const _))).add he).prodMk hi

lemma dev_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (s : ℕ) :
    Measurable[F ε (s - 1)] (fun ω => dev π β ε s ω) :=
  (priceAux_measF π β ε (s - 1)).sub_const _

lemma indep_eps {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (ε : ℕ → Ω → ℝ)
    (hm : ∀ t, Measurable (ε t)) (hind : iIndepFun ε P) (s : ℕ) (hs : 1 ≤ s)
    (Y : Ω → ℝ) (hY : Measurable[F ε (s - 1)] Y) : IndepFun (ε s) Y P := by
  rw [IndepFun_iff_Indep]
  have h := indep_iSup_of_disjoint (m := fun i => MeasurableSpace.comap (ε i) inferInstance)
    (fun i => (hm i).comap_le) hind.iIndep (S := {s}) (T := Set.Icc 1 (s - 1))
    (by rw [Set.disjoint_singleton_left]; simp; omega)
  refine indep_of_indep_of_le_right (indep_of_indep_of_le_left h ?_) ?_
  · exact le_iSup₂_of_le (f := fun j (_ : j ∈ ({s} : Set ℕ)) =>
      MeasurableSpace.comap (ε j) inferInstance) s rfl le_rfl
  · exact hY.comap_le


lemma F_le {Ω : Type*} [MeasurableSpace Ω] (ε : ℕ → Ω → ℝ) (hm : ∀ t, Measurable (ε t))
    (n : ℕ) : F ε n ≤ ‹MeasurableSpace Ω› := by
  unfold F
  exact iSup₂_le (fun i _ => (hm i).comap_le)

lemma dev_meas {M : Model} {Ω : Type*} [MeasurableSpace Ω] (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (hm : ∀ t, Measurable (ε t)) (s : ℕ) :
    Measurable (fun ω => dev π β ε s ω) :=
  (dev_measF π β ε s).mono (F_le ε hm _) le_rfl

lemma price_mem {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (t : ℕ) (ω : Ω) : price π β ε t ω ∈ Set.Icc M.l M.u := by
  unfold price
  rw [priceAux]
  exact π.rule_mem _ _

lemma dev_abs {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (t : ℕ) (ω : Ω) : |dev π β ε t ω| ≤ M.u - M.l := by
  have h2 := price_mem π β ε t ω
  have h3 := M.pHat_mem
  unfold dev
  simp only [Set.mem_Icc] at h2 h3
  rw [abs_le]; constructor <;> linarith

lemma prod_int {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (π : Policy M) (β : ℝ) (s r : ℕ) :
    Integrable (fun ω => (ε s ω * dev π β ε s ω) * (ε r ω * dev π β ε r ω)) P := by
  have hm := hε.measurable
  set B := M.u - M.l
  refine Integrable.mono' (g := fun ω => B ^ 2 * (ε s ω ^ 2 + ε r ω ^ 2))
    ((((hε.memLp_two s).integrable_sq).add ((hε.memLp_two r).integrable_sq)).const_mul _)
    ((((hm s).mul (dev_meas π β ε hm s)).mul ((hm r).mul (dev_meas π β ε hm r))).aestronglyMeasurable)
    (Filter.Eventually.of_forall (fun ω => ?_))
  have h1 := dev_abs π β ε s ω
  have h2 := dev_abs π β ε r ω
  rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul]
  have he : |ε s ω| * |ε r ω| ≤ ε s ω ^ 2 + ε r ω ^ 2 := by
    rw [← sq_abs (ε s ω), ← sq_abs (ε r ω)]
    nlinarith [sq_nonneg (|ε s ω| - |ε r ω|), abs_nonneg (ε s ω), abs_nonneg (ε r ω)]
  have hx : |dev π β ε s ω| * |dev π β ε r ω| ≤ B ^ 2 := by
    rw [sq]; exact mul_le_mul h1 h2 (abs_nonneg _) (le_trans (abs_nonneg _) h1)
  calc |ε s ω| * |dev π β ε s ω| * (|ε r ω| * |dev π β ε r ω|)
      = (|dev π β ε s ω| * |dev π β ε r ω|) * (|ε s ω| * |ε r ω|) := by ring
    _ ≤ B ^ 2 * (ε s ω ^ 2 + ε r ω ^ 2) :=
        mul_le_mul hx he (by positivity) (by positivity)

lemma cross_zero {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (π : Policy M) (β : ℝ) (s r : ℕ) (hr : 1 ≤ r) (hrs : r < s) :
    ∫ ω, (ε s ω * dev π β ε s ω) * (ε r ω * dev π β ε r ω) ∂P = 0 := by
  have hm := hε.measurable
  set Y : Ω → ℝ := fun ω => dev π β ε s ω * (ε r ω * dev π β ε r ω)
  have hY : Measurable[F ε (s - 1)] Y := by
    have h1 := dev_measF π β ε s
    have h2 : Measurable[F ε (s - 1)] (ε r) := eps_measF ε hr (by omega)
    have h3 : Measurable[F ε (s - 1)] (fun ω => dev π β ε r ω) :=
      (dev_measF π β ε r).mono (F_mono ε (by omega)) le_rfl
    exact h1.mul (h2.mul h3)
  have hind := indep_eps P ε hm hε.indep s (by omega) Y hY
  have : ∀ ω, (ε s ω * dev π β ε s ω) * (ε r ω * dev π β ε r ω) = ε s ω * Y ω := by
    intro ω; simp only [Y]; ring
  simp_rw [this]
  rw [hind.integral_fun_mul_eq_mul_integral (hm s).aestronglyMeasurable
    (hY.mono (F_le ε hm _) le_rfl).aestronglyMeasurable, hε.mean_zero s, zero_mul]

lemma diag_eq {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (π : Policy M) (β : ℝ) (s : ℕ) (hs : 1 ≤ s) :
    ∫ ω, (ε s ω * dev π β ε s ω) * (ε s ω * dev π β ε s ω) ∂P =
      σ ^ 2 * ∫ ω, dev π β ε s ω ^ 2 ∂P := by
  have hm := hε.measurable
  have hind := (indep_eps P ε hm hε.indep s hs _ (dev_measF π β ε s)).comp
    (show Measurable (fun x : ℝ => x ^ 2) from measurable_id.pow_const 2)
    (show Measurable (fun x : ℝ => x ^ 2) from measurable_id.pow_const 2)
  have : ∀ ω, (ε s ω * dev π β ε s ω) * (ε s ω * dev π β ε s ω) =
      ((fun x : ℝ => x ^ 2) ∘ ε s) ω * ((fun x : ℝ => x ^ 2) ∘ (fun ω => dev π β ε s ω)) ω := by
    intro ω; simp only [Function.comp]; ring
  simp_rw [this]
  rw [hind.integral_fun_mul_eq_mul_integral (((hm s).pow_const 2)).aestronglyMeasurable
    ((dev_meas π β ε hm s).pow_const 2).aestronglyMeasurable]
  simp only [Function.comp]
  rw [hε.variance_eq s]

lemma noiseSum_sq {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (π : Policy M) (β : ℝ) (t : ℕ) :
    Integrable (fun ω => noiseSum π β ε t ω ^ 2) P ∧
      ∫ ω, noiseSum π β ε t ω ^ 2 ∂P =
        σ ^ 2 * ∑ s ∈ Finset.Icc 1 t, ∫ ω, dev π β ε s ω ^ 2 ∂P := by
  have hexp : ∀ ω, noiseSum π β ε t ω ^ 2 = ∑ s ∈ Finset.Icc 1 t, ∑ r ∈ Finset.Icc 1 t,
      (ε s ω * dev π β ε s ω) * (ε r ω * dev π β ε r ω) := by
    intro ω; unfold noiseSum; rw [sq, Finset.sum_mul_sum]
  simp_rw [hexp]
  have hint : ∀ s ∈ Finset.Icc 1 t, Integrable (fun ω => ∑ r ∈ Finset.Icc 1 t,
      (ε s ω * dev π β ε s ω) * (ε r ω * dev π β ε r ω)) P :=
    fun s _ => integrable_finset_sum _ (fun r _ => prod_int P ε σ hε π β s r)
  refine ⟨integrable_finset_sum _ hint, ?_⟩
  rw [integral_finset_sum _ hint, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro s hs
  rw [integral_finset_sum _ (fun r _ => prod_int P ε σ hε π β s r)]
  have hs1 : 1 ≤ s := (Finset.mem_Icc.mp hs).1
  rw [Finset.sum_eq_single s]
  · exact diag_eq P ε σ hε π β s hs1
  · intro r hr hne
    have hr1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
    rcases lt_or_gt_of_ne hne with h | h
    · exact cross_zero P ε σ hε π β s r hr1 h
    · have := cross_zero P ε σ hε π β r s hs1 h
      rw [← this]; congr 1; funext ω; ring
  · intro h; exact absurd hs h

