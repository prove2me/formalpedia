section
-- Source module: Solutions.KFZParam
/-!
# KFZ Param: the chirp procedure parameters for `n`

For `n ≥ n0` and `dP n = D + 1`: `h = ℓ - 1`, `σ = D + 1 - dpN n`, bits `bs`, sources `ss`.
`tBD n D i = 2^{h + bit i}`, `(D+1) h + σ = L`, `∏ t = 2^L`, the setup descriptor is
`descChirpN n`, the chirp-table descriptor is `descT (sBD n D) (tBD n D)`, and the register width
`B` satisfies `RB` and `B ≤ 5 p`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP

noncomputable section

/-- The bit of axis `j`. -/
def bitN (n j : ℕ) : ℕ := if dpN n ≤ j then 1 else 0

/-- The bit list. -/
def bsN (n : ℕ) : List ℕ := (List.range (IntMul.OpenAI.Glue.dP n)).map (bitN n)

/-- The source list. -/
def ssN (n : ℕ) : List ℕ := (List.range (IntMul.OpenAI.Glue.dP n)).map (srcN n)

/-- `h = ℓ - 1`. -/
def hN (n : ℕ) : ℕ := ℓP n - 1

/-- `σ = d - dpN`. -/
def σN (n : ℕ) : ℕ := IntMul.OpenAI.Glue.dP n - dpN n

/-- The register width. -/
def BN (n : ℕ) : ℕ := dlV (pP n) (NLogN.KFZ.hN n) (IntMul.OpenAI.Glue.dP n) + (IntMul.OpenAI.Glue.dP n * NLogN.KFZ.hN n + σN n) + 8 + KP n + αP n + 1

section Facts

variable {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hn hD

theorem length_bsN : (NLogN.KFZ.bsN n).length = D + 1 := by simp [NLogN.KFZ.bsN, hD]

theorem length_ssN : (ssN n).length = D + 1 := by simp [ssN, hD]

end Facts

end

end NLogN.KFZ

end

