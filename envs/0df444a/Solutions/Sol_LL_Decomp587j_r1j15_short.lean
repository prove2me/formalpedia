private lemma buchstab_table_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    (∀ k ≤ 1024, tk k * ω (tk k) ≤ (getV k : ℝ) / S_scale) ∧
    (∀ k < 1024, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (getU k : ℝ) / S_scale) :=
  buchstab_table_sound_aux hω getV getU validBuchstab_V256 (fun _ hk => validBuchstab_all hk)

private lemma buchstab_le_M4 {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu : 4 ≤ u) :
    ω u ≤ (M4_val : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  apply buchstab_max_propagate hω (a := 4) (by norm_num) _ u hu
  intro x hx
  have hx_le5 : x ≤ 5 := by linarith [hx.2]
  by_cases hx5 : x = 5
  · subst hx5
    have hx_in : (5 : ℝ) ∈ Icc (tk 1023) (tk 1024) := by unfold tk; constructor <;> norm_num
    have h1 := hU 1023 (by omega) 5 hx_in
    have hle : (getU 1023 : ℝ) ≤ M4_val := by exact_mod_cast getU1023_le_M4
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))
  · have hx_lt5 : x < 5 := lt_of_le_of_ne hx_le5 hx5
    set k : ℕ := Nat.floor ((x - 1) * 256)
    have hk_ge : 768 ≤ k := Nat.le_floor (by push_cast; linarith [hx.1])
    have hk_lt : k < 1024 := (Nat.floor_lt (by linarith [hx.1])).mpr (by push_cast; linarith)
    have hfl1 : (k : ℝ) ≤ (x - 1) * 256 := Nat.floor_le (by linarith [hx.1])
    have hfl2 : (x - 1) * 256 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
    have hx_in : x ∈ Icc (tk k) (tk (k + 1)) := by unfold tk; push_cast; constructor <;> linarith
    have h1 := hU k hk_lt x hx_in
    have hst := validBuchstab_all hk_lt
    have hn1 : ¬ k < 256 := by omega
    have hn2 : ¬ k < 512 := by omega
    simp only [checkBuchstabStepWith, hn1, hn2, hk_ge, ↓reduceIte, Bool.and_eq_true,
      decide_eq_true_eq] at hst
    have hle : (getU k : ℝ) ≤ M4_val := by exact_mod_cast hst.2
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))

private lemma buchstab_le_M3 {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu : 3 ≤ u) :
    ω u ≤ (M3_val : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  apply buchstab_max_propagate hω (a := 3) (by norm_num) _ u hu
  intro x hx
  have hx_le4 : x ≤ 4 := by linarith [hx.2]
  by_cases hx4 : x = 4
  · subst hx4
    have hx_in : (4 : ℝ) ∈ Icc (tk 767) (tk 768) := by unfold tk; constructor <;> norm_num
    have h1 := hU 767 (by omega) 4 hx_in
    have hle : (getU 767 : ℝ) ≤ M3_val := by exact_mod_cast getU767_le_M3
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))
  · have hx_lt4 : x < 4 := lt_of_le_of_ne hx_le4 hx4
    set k : ℕ := Nat.floor ((x - 1) * 256)
    have hk_ge : 512 ≤ k := Nat.le_floor (by push_cast; linarith [hx.1])
    have hk_lt : k < 768 := (Nat.floor_lt (by linarith [hx.1])).mpr (by push_cast; linarith)
    have hfl1 : (k : ℝ) ≤ (x - 1) * 256 := Nat.floor_le (by linarith [hx.1])
    have hfl2 : (x - 1) * 256 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
    have hx_in : x ∈ Icc (tk k) (tk (k + 1)) := by unfold tk; push_cast; constructor <;> linarith
    have h1 := hU k (by omega) x hx_in
    have hst := validBuchstab_all (by omega : k < 1024)
    have hn1 : ¬ k < 256 := by omega
    have hn2 : ¬ k < 512 := by omega
    have hn3 : ¬ 768 ≤ k := by omega
    simp only [checkBuchstabStepWith, hn1, hn2, hn3, ↓reduceIte, Bool.and_eq_true,
      decide_eq_true_eq] at hst
    have hle : (getU k : ℝ) ≤ M3_val := by exact_mod_cast hst.2
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))

private lemma getU_le_buchstabUB {k0 k1 k : ℕ} (h0 : k0 ≤ k) (h1 : k ≤ k1) (hk : k < 768) :
    getU k ≤ buchstabUB k0 k1 := by
  have hm0 : ∀ i j, i ≤ j → j ≤ 255 → getU j ≤ getU i := by
    intro i j hij hj
    exact mono_dec_le (f := getU) (a := 0) (b := 255) (fun t _ ht => monoU_0_spec ht) (Nat.zero_le i) hij hj
  have hm1 : ∀ i j, 256 ≤ i → i ≤ j → j ≤ 450 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 256) (b := 450) (fun t ht1 ht2 => monoU_1_spec ht1 ht2) hi hij hj
  have hm2 : ∀ i j, 450 ≤ i → i ≤ j → j ≤ 631 → getU j ≤ getU i := by
    intro i j hi hij hj
    exact mono_dec_le (f := getU) (a := 450) (b := 631) (fun t ht1 ht2 => monoU_2_spec ht1 ht2) hi hij hj
  have hm3 : ∀ i j, 631 ≤ i → i ≤ j → j ≤ 767 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 631) (b := 767) (fun t ht1 ht2 => monoU_3_spec ht1 ht2) hi hij hj
  unfold buchstabUB
  have hk0_lt : Nat.ble 768 k0 = false := by rw [ble_false_iff]; omega
  rw [hk0_lt]; dsimp only
  split
  · rename_i h; rw [Nat.ble_eq] at h; exact hm0 k0 k h0 (by omega)
  · split
    · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm1 k k1 (by omega) h1 (by omega)
    · split
      · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm2 k0 k (by omega) h0 (by omega)
      · split
        · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm3 k k1 (by omega) h1 (by omega)
        · exact getU_le_buchstabUB_fallback hm0 hm1 hm2 hm3 h0 h1 hk

private lemma M4_le_buchstabUB {k0 k1 : ℕ} (hk1 : 768 ≤ k1) :
    M4_val ≤ buchstabUB k0 k1 := by
  have hfb : M4_val ≤ buchstabUB_fallback k0 k1 := by
    unfold buchstabUB_fallback; dsimp only
    have h768 : Nat.ble 768 k1 = true := by rw [Nat.ble_eq]; omega
    rw [h768]; dsimp only
    exact le_trans (le_trans (le_trans (le_max2_right _ _) (le_max2_right _ _)) (le_max2_right _ _)) (le_max2_right _ _)
  unfold buchstabUB
  split
  · exact le_refl _
  · split
    · rename_i h; rw [Nat.ble_eq] at h; omega
    · split
      · rename_i _ h; rw [Nat.ble_eq] at h; omega
      · split
        · rename_i _ h; rw [Nat.ble_eq] at h; omega
        · split
          · rename_i _ h; rw [Nat.ble_eq] at h; omega
          · exact hfb

private lemma buchstab_le_buchstabUB {ω : ℝ → ℝ} (hω : IsBuchstab ω) {k0 k1 : ℕ}
    (hk01 : k0 ≤ k1) {u : ℝ} (hlo : tk k0 ≤ u) (hhi : u ≤ tk (k1 + 1)) :
    ω u ≤ (buchstabUB k0 k1 : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  by_cases hu4 : 4 < u
  · have hk1_ge : 768 ≤ k1 := by
      unfold tk at hhi; push_cast at hhi
      have : (768 : ℝ) < (k1 : ℝ) + 1 := by linarith
      have : (768 : ℕ) < k1 + 1 := by exact_mod_cast this
      omega
    exact le_trans (buchstab_le_M4 hω (le_of_lt hu4))
      (div_le_div_of_nonneg_right (by exact_mod_cast M4_le_buchstabUB hk1_ge) (le_of_lt hSpos))
  · push Not at hu4
    by_cases hu4eq : u = 4
    · subst hu4eq
      by_cases hk0_ge : 768 ≤ k0
      · have hM : M4_val ≤ buchstabUB k0 k1 := by
          unfold buchstabUB; have : Nat.ble 768 k0 = true := by rw [Nat.ble_eq]; omega
          rw [this]
        exact le_trans (buchstab_le_M4 hω (le_refl 4))
          (div_le_div_of_nonneg_right (by exact_mod_cast hM) (le_of_lt hSpos))
      · have hk1_ge : 767 ≤ k1 := by
          unfold tk at hhi; push_cast at hhi
          have : (768 : ℝ) ≤ (k1 : ℝ) + 1 := by linarith
          have : (768 : ℕ) ≤ k1 + 1 := by exact_mod_cast this
          omega
        have hx_in : (4 : ℝ) ∈ Icc (tk 767) (tk 768) := by unfold tk; constructor <;> norm_num
        have h1 := hU 767 (by omega) 4 hx_in
        have h2 : getU 767 ≤ buchstabUB k0 k1 := getU_le_buchstabUB (by omega) hk1_ge (by omega)
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hu_lt4 : u < 4 := lt_of_le_of_ne hu4 hu4eq
      have hu1 : 1 ≤ u := by unfold tk at hlo; linarith [(show (0 : ℝ) ≤ (k0 : ℝ) / 256 by positivity)]
      by_cases heq : u = tk (k1 + 1)
      · have hk1_lt : k1 < 768 := by
          rw [heq] at hu_lt4; unfold tk at hu_lt4; push_cast at hu_lt4
          have : (k1 : ℝ) + 1 < 768 := by linarith
          have : k1 + 1 < 768 := by exact_mod_cast this
          omega
        have hx_in : u ∈ Icc (tk k1) (tk (k1 + 1)) := by
          rw [heq]; unfold tk; push_cast; constructor <;> linarith
        have h1 := hU k1 (by omega) u hx_in
        have h2 : getU k1 ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk01 (le_refl k1) hk1_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
      · have hu_lt : u < tk (k1 + 1) := lt_of_le_of_ne hhi heq
        set k : ℕ := Nat.floor ((u - 1) * 256)
        have hk0_le : k0 ≤ k := Nat.le_floor (by unfold tk at hlo; linarith)
        have hk_le1 : k ≤ k1 := by
          have hlt : (u - 1) * 256 < ((k1 + 1 : ℕ) : ℝ) := by unfold tk at hu_lt; push_cast at *; linarith
          have := (Nat.floor_lt (by linarith)).mpr hlt; omega
        have hk_lt : k < 768 := (Nat.floor_lt (by linarith)).mpr (by push_cast; linarith)
        have hx_in : u ∈ Icc (tk k) (tk (k + 1)) := by
          unfold tk; push_cast
          constructor <;> linarith [Nat.floor_le (a := (u - 1) * 256) (by linarith),
                                    Nat.lt_floor_add_one ((u - 1) * 256)]
        have h1 := hU k (by omega) u hx_in
        have h2 : getU k ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk0_le hk_le1 hk_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))

/-! ### Part 4: 2D Rectangle Decomposition & 1D-`F(s)` Factorization -/

private lemma sumUpTo_eq_finset_sum (n : ℕ) (f : ℕ → ℕ) :
    (sumUpTo n f : ℝ) = ∑ i ∈ Finset.range n, (f i : ℝ) := by
  induction n with
  | zero => simp [sumUpTo]
  | succ n ih => simp only [sumUpTo, Finset.sum_range_succ, Nat.cast_add, ih]

private lemma setIntegral_union_le_of_nonneg {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B : Set α} {f : α → ℝ} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hnnB : ∀ x ∈ B, 0 ≤ f x) (hintA : IntegrableOn f A μ) (hintB : IntegrableOn f B μ) :
    ∫ x in A ∪ B, f x ∂μ ≤ (∫ x in A, f x ∂μ) + (∫ x in B, f x ∂μ) := by
  have hAB : A ∪ B = A ∪ (B \ A) := (Set.union_sdiff_self).symm
  rw [hAB, setIntegral_union disjoint_sdiff_self_right (hB.diff hA) hintA
    (hintB.mono_set Set.sdiff_subset)]
  have hle : ∫ x in B \ A, f x ∂μ ≤ ∫ x in B, f x ∂μ :=
    setIntegral_mono_set hintB
      (ae_restrict_of_forall_mem hB hnnB)
      (Filter.Eventually.of_forall Set.sdiff_subset)
  linarith

private lemma integrableOn_biUnion_finset {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) {f : α → ℝ}
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    IntegrableOn f (⋃ i ∈ s, A i) μ := by
  induction s using Finset.induction_on with
  | empty => simp [integrableOn_empty]
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by ext x; simp
    rw [hun]
    exact (hint a (Finset.mem_insert_self a s)).union
      (ih (fun i hi => hint i (Finset.mem_insert_of_mem hi)))

private lemma setIntegral_le_sum_biUnion {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) (D : Set α) {f : α → ℝ}
    (hD : D ⊆ ⋃ i ∈ s, A i)
    (hmeas : ∀ i ∈ s, MeasurableSet (A i))
    (hnn : ∀ i ∈ s, ∀ x ∈ A i, 0 ≤ f x)
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    ∫ x in D, f x ∂μ ≤ ∑ i ∈ s, ∫ x in A i, f x ∂μ := by
  have hunion_meas : MeasurableSet (⋃ i ∈ s, A i) := Finset.measurableSet_biUnion s hmeas
  have hunion_nn : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
    intro x hx; simp only [mem_iUnion, exists_prop] at hx
    rcases hx with ⟨i, hi, hxi⟩; exact hnn i hi x hxi
  have hunion_int : IntegrableOn f (⋃ i ∈ s, A i) μ := integrableOn_biUnion_finset s A hint
  have hsub : ∫ x in D, f x ∂μ ≤ ∫ x in ⋃ i ∈ s, A i, f x ∂μ :=
    setIntegral_mono_set hunion_int
      (ae_restrict_of_forall_mem hunion_meas hunion_nn)
      (Filter.Eventually.of_forall hD)
  refine le_trans hsub ?_
  clear hD hunion_meas hunion_nn hunion_int hsub
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by ext x; simp
    rw [hun, Finset.sum_insert ha]
    have hms : MeasurableSet (⋃ i ∈ s, A i) :=
      Finset.measurableSet_biUnion s (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
    have hnns : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
      intro x hx; simp only [mem_iUnion, exists_prop] at hx
      rcases hx with ⟨i, hi, hxi⟩; exact hnn i (Finset.mem_insert_of_mem hi) x hxi
    have hints : IntegrableOn f (⋃ i ∈ s, A i) μ :=
      integrableOn_biUnion_finset s A (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    have h1 := setIntegral_union_le_of_nonneg
      (hmeas a (Finset.mem_insert_self a s)) hms hnns
      (hint a (Finset.mem_insert_self a s)) hints
    have h2 := ih
      (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
      (fun i hi => hnn i (Finset.mem_insert_of_mem hi))
      (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    linarith

private lemma wInv_bound_den {D a b : ℕ} (hD : 0 < D) (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D)..((b : ℝ) / D), (1 / t : ℝ) ≤ (wInv a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D := by exact_mod_cast hD
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D ≤ (b : ℝ) / D :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  have htrap := integral_inv_le_trapezoid (div_pos har hDpos) habr
  have hsimp : ((b : ℝ) / D - (a : ℝ) / D) / 2 *
      (1 / ((a : ℝ) / D) + 1 / ((b : ℝ) / D)) =
      ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) := by field_simp; ring
  have h2ab_pos : 0 < 2 * a * b := Nat.mul_pos (Nat.mul_pos (by omega) ha) hb
  have hceil : W_scale * (b * b - a * a) ≤ (2 * a * b) * wInv a b := le_mul_ceilDiv h2ab_pos
  have hsub : ((b * b - a * a : ℕ) : ℝ) = (b : ℝ) * b - (a : ℝ) * a := by
    rw [Nat.cast_sub (Nat.mul_le_mul hab hab)]; push_cast; ring
  have hceilr : (W_scale : ℝ) * ((b : ℝ) * b - (a : ℝ) * a) ≤
      (2 * (a : ℝ) * b) * (wInv a b : ℝ) := by rw [← hsub]; exact_mod_cast hceil
  have hle : ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) ≤ (wInv a b : ℝ) / W_scale := by
    rw [div_le_div_iff₀ (by positivity) hWpos]; linarith
  linarith

private lemma wInvSqIn_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_in)..((b : ℝ) / D_in), (1 / (t * t) : ℝ) ≤ (wInvSqIn a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D_in ≤ (b : ℝ) / D_in :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  rw [integral_inv_sq_eq (div_pos har hDpos) habr]
  have hsimp : 1 / ((a : ℝ) / D_in) - 1 / ((b : ℝ) / D_in) =
      (D_in : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by field_simp
  rw [hsimp]
  have hceil : W_scale * D_in * (b - a) ≤ (a * b) * wInvSqIn a b :=
    le_mul_ceilDiv (Nat.mul_pos ha hb)
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * D_in * ((b : ℝ) - a) ≤ (a : ℝ) * b * (wInvSqIn a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  rw [div_le_div_iff₀ (by positivity) hWpos]; linarith

private lemma rect2_weight_eq {a1 b1 a2 b2 : ℝ} (h1 : a1 ≤ b1) (h2 : a2 ≤ b2) :
    ∫ p in Icc a1 b1 ×ˢ Icc a2 b2, (1 / (p.1 * p.1 * p.2) : ℝ) =
      (∫ t in a1..b1, (1 / (t * t) : ℝ)) * (∫ t in a2..b2, (1 / t : ℝ)) := by
  have hfun : (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ)) =
      (fun p : ℝ × ℝ => (1 / (p.1 * p.1)) * (1 / p.2)) := by
    funext p; ring
  rw [hfun, show (volume : Measure (ℝ × ℝ)) = volume.prod volume from rfl,
      MeasureTheory.setIntegral_prod_mul (f := fun t : ℝ => (1 / (t * t) : ℝ)) (g := fun t : ℝ => (1 / t : ℝ))]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h1,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h2]

private def F_fn (ω : ℝ → ℝ) (s : ℝ) : ℝ :=
  ∫ p in Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
         Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in),
    ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)

private lemma nat_grid_step_le {A B N hh i : ℕ} (hAB : A ≤ B) (hNh : N * hh = B - A) (hi : i < N) :
    A + i * hh + hh ≤ B := by
  have h1 : (i + 1) * hh ≤ N * hh := Nat.mul_le_mul_right hh hi
  have h2 : i * hh + hh = (i + 1) * hh := by ring
  omega

private lemma nat_grid_step_pos {A B N hh : ℕ} (hAB : A < B) (hNh : N * hh = B - A) : 0 < hh := by
  by_contra h
  have h0 : hh = 0 := by omega
  rw [h0, Nat.mul_zero] at hNh
  omega

private lemma cover1d_nat {D A B N hh : ℕ} (hD : 0 < D) (hN : 0 < N) (hhh : 0 < hh)
    (hNh : N * hh = B - A) (hAB : A ≤ B) {x : ℝ}
    (hxlo : (A : ℝ) / D ≤ x) (hxhi : x ≤ (B : ℝ) / D) :
    ∃ i < N, ((A + i * hh : ℕ) : ℝ) / D ≤ x ∧ x ≤ ((A + i * hh + hh : ℕ) : ℝ) / D := by
  have hDpos : (0 : ℝ) < D := by exact_mod_cast hD
  by_cases htop : x = (B : ℝ) / D
  · refine ⟨N - 1, by omega, ?_, ?_⟩
    · rw [htop]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      have : (N - 1) * hh ≤ N * hh := Nat.mul_le_mul_right hh (by omega)
      exact_mod_cast (by omega : A + (N - 1) * hh ≤ B)
    · rw [htop]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      have h1 : (N - 1) * hh + hh = N * hh := by
        cases N with | zero => omega | succ m => simp [Nat.succ_mul]
      exact_mod_cast (by omega : B ≤ A + (N - 1) * hh + hh)
  · have hxlt : x < (B : ℝ) / D := lt_of_le_of_ne hxhi htop
    set i : ℕ := Nat.floor ((x * D - A) / hh)
    have hhh_r : (0 : ℝ) < hh := by exact_mod_cast hhh
    have hnonneg : 0 ≤ (x * D - A) / hh := by
      apply div_nonneg _ (le_of_lt hhh_r)
      have := (div_le_iff₀ hDpos).mp hxlo; linarith
    have hi_lt : i < N := by
      apply (Nat.floor_lt hnonneg).mpr
      rw [div_lt_iff₀ hhh_r]
      have h1 : x * D < B := (lt_div_iff₀ hDpos).mp hxlt
      have h2 : (N : ℝ) * hh = (B : ℝ) - A := by rw [← Nat.cast_sub hAB]; exact_mod_cast hNh
      linarith
    refine ⟨i, hi_lt, ?_, ?_⟩
    · have hfl := Nat.floor_le hnonneg
      rw [le_div_iff₀ hhh_r] at hfl; rw [div_le_iff₀ hDpos]; push_cast; linarith
    · have hfl := Nat.lt_floor_add_one ((x * D - A) / hh)
      rw [div_lt_iff₀ hhh_r] at hfl; rw [le_div_iff₀ hDpos]; push_cast; linarith

private lemma inner2d_integrableOn {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {s : ℝ} (hs : ((211 * S_step_in : ℕ) : ℝ) / D_in ≤ s)
    {E : Set (ℝ × ℝ)} (hE : IsCompact E)
    (hsub : E ⊆ Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in)) :
    IntegrableOn (fun p : ℝ × ℝ => ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)) E volume := by
  apply ContinuousOn.integrableOn_compact hE
  have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
  have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
  have hBsum : 2 * ((B1_num : ℝ) / D_in) + ((B2_num : ℝ) / D_in) ≤ ((211 * S_step_in : ℕ) : ℝ) / D_in := by
    unfold B1_num B2_num S_step_in D_in; norm_num
  have hp_ok : ∀ p ∈ E, 0 < p.1 ∧ 0 < p.2 ∧ 1 ≤ (s - p.1 - p.2) / p.1 := by
    intro p hp
    have hm := hsub hp
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hm.1.1
    have h2p : 0 < p.2 := lt_of_lt_of_le hA2 hm.2.1
    refine ⟨h1p, h2p, ?_⟩
    rw [le_div_iff₀ h1p]
    linarith [hm.1.2, hm.2.2]
  have harg : ContinuousOn (fun p : ℝ × ℝ => (s - p.1 - p.2) / p.1) E :=
    ((continuousOn_const.sub continuous_fst.continuousOn).sub continuous_snd.continuousOn).div
      continuous_fst.continuousOn (fun p hp => ne_of_gt (hp_ok p hp).1)
  have hnum : ContinuousOn (fun p : ℝ × ℝ => ω ((s - p.1 - p.2) / p.1)) E :=
    hω.1.comp harg (fun p hp => (hp_ok p hp).2.2)
  have hden : ContinuousOn (fun p : ℝ × ℝ => p.1 * p.1 * p.2) E :=
    ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn
  exact hnum.div hden (fun p hp => by rcases hp_ok p hp with ⟨h1, h2, _⟩; positivity)

private lemma F_fn_bound_of_sum {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (ub : ℕ → ℕ → ℕ)
    (hub : ∀ k0 k1 : ℕ, k0 ≤ k1 → ∀ u : ℝ, tk k0 ≤ u → u ≤ tk (k1 + 1) → ω u ≤ (ub k0 k1 : ℝ) / S_scale)
    {m N1 N2 : ℕ} (hN1 : 0 < N1) (hN2 : 0 < N2)
    (hd1 : N1 ∣ (B1_num - A1_num)) (hd2 : N2 ∣ (B2_num - A2_num))
    {s : ℝ}
    (hs_lo : (((211 + m) * S_step_in : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((212 + m) * S_step_in : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (F_sumWith ub m N1 N2 : ℝ) / ((S_scale : ℝ) * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  set sa := (211 + m) * S_step_in
  set sb := (212 + m) * S_step_in
  set h1 := (B1_num - A1_num) / N1
  set h2 := (B2_num - A2_num) / N2
  have hh1_eq : N1 * h1 = B1_num - A1_num := Nat.mul_div_cancel' hd1
  have hh2_eq : N2 * h2 = B2_num - A2_num := Nat.mul_div_cancel' hd2
  have hAB1 : A1_num < B1_num := by unfold A1_num B1_num; omega
  have hAB2 : A2_num < B2_num := by unfold A2_num B2_num; omega
  have hh1_pos : 0 < h1 := nat_grid_step_pos hAB1 hh1_eq
  have hh2_pos : 0 < h2 := nat_grid_step_pos hAB2 hh2_eq
  have hs_base : ((211 * S_step_in : ℕ) : ℝ) / D_in ≤ s := by
    have h1r : ((211 * S_step_in : ℕ) : ℝ) / D_in ≤ (sa : ℝ) / D_in := by
      apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      exact_mod_cast (Nat.mul_le_mul_right S_step_in (by omega : 211 ≤ 211 + m))
    linarith
  let cell2 : ℕ × ℕ → Set (ℝ × ℝ) := fun ⟨j, k⟩ =>
    Icc (((A1_num + j * h1 : ℕ) : ℝ) / D_in) (((A1_num + j * h1 + h1 : ℕ) : ℝ) / D_in) ×ˢ
    Icc (((A2_num + k * h2 : ℕ) : ℝ) / D_in) (((A2_num + k * h2 + h2 : ℕ) : ℝ) / D_in)
  let idx2 : Finset (ℕ × ℕ) := (Finset.range N1) ×ˢ (Finset.range N2)
  have hcell_sub : ∀ c ∈ idx2,
      cell2 c ⊆ Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in) := by
    rintro ⟨j, k⟩ hc p hp
    simp only [idx2, Finset.mem_product, Finset.mem_range] at hc
    have hj_le := nat_grid_step_le (le_of_lt hAB1) hh1_eq hc.1
    have hk_le := nat_grid_step_le (le_of_lt hAB2) hh2_eq hc.2
    exact ⟨⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hp.1.1,
            le_trans hp.1.2 (div_le_div_of_nonneg_right (by exact_mod_cast hj_le) (le_of_lt hDpos))⟩,
           ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hp.2.1,
            le_trans hp.2.2 (div_le_div_of_nonneg_right (by exact_mod_cast hk_le) (le_of_lt hDpos))⟩⟩
  have hcover : Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
      Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in) ⊆ ⋃ c ∈ idx2, cell2 c := by
    intro p hp
    obtain ⟨j, hj, hj0, hj1⟩ := cover1d_nat (by unfold D_in; omega) hN1 hh1_pos hh1_eq (le_of_lt hAB1) hp.1.1 hp.1.2
    obtain ⟨k, hk, hk0, hk1⟩ := cover1d_nat (by unfold D_in; omega) hN2 hh2_pos hh2_eq (le_of_lt hAB2) hp.2.1 hp.2.2
    simp only [mem_iUnion, exists_prop]
    exact ⟨(j, k), by simp [idx2, hj, hk], ⟨⟨hj0, hj1⟩, ⟨hk0, hk1⟩⟩⟩
  let g : ℝ × ℝ → ℝ := fun p => ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)
  have hsum_le : F_fn ω s ≤ ∑ j ∈ Finset.range N1, ∑ k ∈ Finset.range N2, ∫ p in cell2 (j, k), g p := by
    rw [← Finset.sum_product']
    unfold F_fn
    apply setIntegral_le_sum_biUnion idx2 cell2 _ hcover
    · rintro ⟨j, k⟩ _; exact measurableSet_Icc.prod measurableSet_Icc
    · rintro c hc p hp
      have hm := hcell_sub c hc hp
      have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
      have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
      have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hm.1.1
      have h2p : 0 < p.2 := lt_of_lt_of_le hA2 hm.2.1
      exact div_nonneg (buchstab_nonneg hω hz _) (by positivity)
    · rintro ⟨j, k⟩ hc
      exact inner2d_integrableOn hω hs_base (isCompact_Icc.prod isCompact_Icc) (hcell_sub (j, k) hc)
  have hBsum_sa : 2 * B1_num + B2_num ≤ sa := by
    have h1b : 2 * B1_num + B2_num ≤ 211 * S_step_in := by unfold B1_num B2_num S_step_in; omega
    have h2b : 211 * S_step_in ≤ sa := Nat.mul_le_mul_right S_step_in (by omega)
    omega
  have hcell_le : ∀ j ∈ Finset.range N1, ∀ k ∈ Finset.range N2,
      ∫ p in cell2 (j, k), g p ≤
        ((wInvSqIn (A1_num + j * h1) (A1_num + j * h1 + h1) : ℝ) *
         ((ub (((sa - 2 * (A1_num + j * h1 + h1) - (A2_num + k * h2 + h2)) * 256) / (A1_num + j * h1 + h1))
              (((sb - 2 * (A1_num + j * h1) - (A2_num + k * h2)) * 256) / (A1_num + j * h1)) : ℝ) *
          (wInv (A2_num + k * h2) (A2_num + k * h2 + h2) : ℝ))) /
        ((S_scale : ℝ) * W_scale * W_scale) := by
    intro j hj k hk
    simp only [Finset.mem_range] at hj hk
    set lo1 := A1_num + j * h1
    set hi1 := lo1 + h1
    set lo2 := A2_num + k * h2
    set hi2 := lo2 + h2
    have hhi1_le : hi1 ≤ B1_num := nat_grid_step_le (le_of_lt hAB1) hh1_eq hj
    have hhi2_le : hi2 ≤ B2_num := nat_grid_step_le (le_of_lt hAB2) hh2_eq hk
    have hlo1_le : lo1 ≤ hi1 := Nat.le_add_right _ _
    have hlo2_le : lo2 ≤ hi2 := Nat.le_add_right _ _
    have hlo1_pos : 0 < lo1 := by dsimp only [lo1]; unfold A1_num; omega
    have hlo2_pos : 0 < lo2 := by dsimp only [lo2]; unfold A2_num; omega
    have hhi1_pos : 0 < hi1 := lt_of_lt_of_le hlo1_pos hlo1_le
    have hsab : sa ≤ sb := Nat.mul_le_mul_right S_step_in (by omega)
    set nlo := sa - 2 * hi1 - hi2
    set nhi := sb - 2 * lo1 - lo2
    set k0 := (nlo * 256) / hi1
    set k1 := (nhi * 256) / lo1
    have hk01 : k0 ≤ k1 := by
      have hnl : nlo ≤ nhi := by dsimp only [nlo, nhi]; omega
      exact le_trans (Nat.div_le_div_left hlo1_le hlo1_pos)
        (Nat.div_le_div_right (Nat.mul_le_mul_right 256 hnl))
    set Mo : ℝ := (ub k0 k1 : ℝ) / S_scale
    have hMo_nn : 0 ≤ Mo := div_nonneg (Nat.cast_nonneg _) (le_of_lt hSpos)
    set R := Icc ((lo1 : ℝ) / D_in) ((hi1 : ℝ) / D_in) ×ˢ Icc ((lo2 : ℝ) / D_in) ((hi2 : ℝ) / D_in)
    have hpt : ∀ p ∈ R, g p ≤ Mo * (1 / (p.1 * p.1 * p.2)) := by
      intro p hp
      have hp1_pos : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1.1
      have hp2_pos : 0 < p.2 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) hp.2.1
      have hw : ω ((s - p.1 - p.2) / p.1) ≤ Mo := by
        apply hub k0 k1 hk01 ((s - p.1 - p.2) / p.1)
        · unfold tk
          have hdiv : (k0 : ℝ) * (hi1 : ℝ) ≤ (nlo : ℝ) * 256 := by
            exact_mod_cast Nat.div_mul_le_self (nlo * 256) hi1
          have hnlo_eq : (nlo : ℝ) = (sa : ℝ) - 2 * hi1 - hi2 := by
            have : nlo + (2 * hi1 + hi2) = sa := by dsimp only [nlo]; omega
            have hc : (nlo : ℝ) + (2 * (hi1 : ℝ) + hi2) = (sa : ℝ) := by exact_mod_cast this
            linarith
          have h1s : (sa : ℝ) - hi1 - hi2 ≤ (s - p.1 - p.2) * D_in := by
            have hs1 := (div_le_iff₀ hDpos).mp hs_lo
            have h1b := (le_div_iff₀ hDpos).mp hp.1.2
            have h2b := (le_div_iff₀ hDpos).mp hp.2.2
            linarith
          have h2s : p.1 * D_in ≤ hi1 := (le_div_iff₀ hDpos).mp hp.1.2
          rw [le_div_iff₀ hp1_pos]
          have h3 : (1 + (k0 : ℝ) / 256) * (hi1 : ℝ) ≤ (sa : ℝ) - hi1 - hi2 := by linarith
          have h4 : (1 + (k0 : ℝ) / 256) * (p.1 * D_in) ≤ (1 + (k0 : ℝ) / 256) * hi1 :=
            mul_le_mul_of_nonneg_left h2s (add_nonneg zero_le_one (div_nonneg (Nat.cast_nonneg k0) (by norm_num)))
          exact le_of_mul_le_mul_right (by linarith : (1 + (k0 : ℝ) / 256) * p.1 * D_in ≤ (s - p.1 - p.2) * D_in) hDpos
        · unfold tk
          have hdiv : (nhi : ℝ) * 256 < ((k1 : ℝ) + 1) * (lo1 : ℝ) := by
            have hlt : nhi * 256 < (k1 + 1) * lo1 := by
              dsimp only [k1]; rw [Nat.add_mul, Nat.one_mul]; exact Nat.lt_div_mul_add (a := nhi * 256) hlo1_pos
            have hc := (Nat.cast_lt (α := ℝ)).mpr hlt
            push_cast at hc; exact hc
          have hnhi_eq : (nhi : ℝ) = (sb : ℝ) - 2 * lo1 - lo2 := by
            have : nhi + (2 * lo1 + lo2) = sb := by dsimp only [nhi]; omega
            have hc : (nhi : ℝ) + (2 * (lo1 : ℝ) + lo2) = (sb : ℝ) := by exact_mod_cast this
            linarith
          have h1s : (s - p.1 - p.2) * D_in ≤ (sb : ℝ) - lo1 - lo2 := by
            have hs2 := (le_div_iff₀ hDpos).mp hs_hi
            have h1b := (div_le_iff₀ hDpos).mp hp.1.1
            have h2b := (div_le_iff₀ hDpos).mp hp.2.1
            linarith
          have h2s : (lo1 : ℝ) ≤ p.1 * D_in := (div_le_iff₀ hDpos).mp hp.1.1
          rw [div_le_iff₀ hp1_pos]; push_cast
          have h3 : (sb : ℝ) - lo1 - lo2 ≤ (1 + ((k1 : ℝ) + 1) / 256) * (lo1 : ℝ) := by linarith
          have h4 : (1 + ((k1 : ℝ) + 1) / 256) * (lo1 : ℝ) ≤ (1 + ((k1 : ℝ) + 1) / 256) * (p.1 * D_in) :=
            mul_le_mul_of_nonneg_left h2s (add_nonneg zero_le_one (div_nonneg (add_nonneg (Nat.cast_nonneg k1) zero_le_one) (by norm_num)))
          exact le_of_mul_le_mul_right (by linarith : (s - p.1 - p.2) * D_in ≤ (1 + ((k1 : ℝ) + 1) / 256) * p.1 * D_in) hDpos
      dsimp only [g]; rw [mul_one_div]
      exact div_le_div_of_nonneg_right hw (by positivity)
    have hsub_jk : R ⊆
        Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
        Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in) :=
      hcell_sub (j, k) (by simp [idx2, hj, hk])
    have hint_g := inner2d_integrableOn hω hs_base (isCompact_Icc.prod isCompact_Icc) hsub_jk
    have hint_w : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ)) R volume := by
      apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
      refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
      intro p hp
      have h1p : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1.1
      have h2p : 0 < p.2 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) hp.2.1
      positivity
    have hmono := setIntegral_mono_on hint_g (hint_w.const_mul Mo)
      (measurableSet_Icc.prod measurableSet_Icc) hpt
    rw [integral_const_mul, rect2_weight_eq
      (div_le_div_of_nonneg_right (by exact_mod_cast hlo1_le) (le_of_lt hDpos))
      (div_le_div_of_nonneg_right (by exact_mod_cast hlo2_le) (le_of_lt hDpos))] at hmono
    have hw1 := wInvSqIn_bound hlo1_pos hlo1_le
    have hw2 := wInv_bound_den (D := D_in) (by unfold D_in; omega) hlo2_pos hlo2_le
    have hi2_nn : 0 ≤ ∫ t in ((lo2 : ℝ) / D_in)..((hi2 : ℝ) / D_in), (1 / t : ℝ) := by
      apply intervalIntegral.integral_nonneg
        (div_le_div_of_nonneg_right (by exact_mod_cast hlo2_le) (le_of_lt hDpos))
      intro t ht
      exact div_nonneg zero_le_one (le_of_lt (lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) ht.1))
    have hprod := mul_le_mul hw1 hw2 hi2_nn (div_nonneg (Nat.cast_nonneg _) (le_of_lt hWpos))
    refine le_trans hmono (le_trans (mul_le_mul_of_nonneg_left hprod hMo_nn) ?_)
    apply le_of_eq; dsimp only [Mo]; ring
  have hrow_le : ∀ j ∈ Finset.range N1,
      ∑ k ∈ Finset.range N2, ∫ p in cell2 (j, k), g p ≤
        ((wInvSqIn (A1_num + j * h1) (A1_num + j * h1 + h1) : ℝ) *
         ∑ k ∈ Finset.range N2,
           (ub (((sa - 2 * (A1_num + j * h1 + h1) - (A2_num + k * h2 + h2)) * 256) / (A1_num + j * h1 + h1))
               (((sb - 2 * (A1_num + j * h1) - (A2_num + k * h2)) * 256) / (A1_num + j * h1)) : ℝ) *
           (wInv (A2_num + k * h2) (A2_num + k * h2 + h2) : ℝ)) /
        ((S_scale : ℝ) * W_scale * W_scale) := by
    intro j hj
    have h := Finset.sum_le_sum (hcell_le j hj)
    rw [← Finset.sum_div, ← Finset.mul_sum] at h
    exact h
  refine le_trans hsum_le (le_trans (Finset.sum_le_sum hrow_le) ?_)
  rw [← Finset.sum_div]
  apply div_le_div_of_nonneg_right _ (mul_nonneg (mul_nonneg (le_of_lt hSpos) (le_of_lt hWpos)) (le_of_lt hWpos))
  unfold F_sumWith; dsimp only
  rw [sumUpTo_eq_finset_sum]
  apply le_of_eq; apply Finset.sum_congr rfl; intro j _
  rw [Nat.cast_mul, sumUpTo_eq_finset_sum]
  congr 1; apply Finset.sum_congr rfl; intro k _
  rw [Nat.cast_mul]

private lemma F_fn_le_getF {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {m : ℕ} (hm : m < 64) {s : ℝ}
    (hs_lo : (((211 + m) * S_step_in : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((212 + m) * S_step_in : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (getF m : ℝ) / S_scale := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hN1 : 0 < N1_of m := by unfold N1_of; split_ifs <;> omega
  have hN2 : 0 < N2_of m := by unfold N2_of; split_ifs <;> omega
  have hd1 : N1_of m ∣ (B1_num - A1_num) := by unfold N1_of B1_num A1_num; split_ifs <;> decide
  have hd2 : N2_of m ∣ (B2_num - A2_num) := by unfold N2_of B2_num A2_num; split_ifs <;> decide
  have h1 := F_fn_bound_of_sum hω hz buchstabUB
    (fun _ _ hk01 _ hlo hhi => buchstab_le_buchstabUB hω hk01 hlo hhi)
    hN1 hN2 hd1 hd2 hs_lo hs_hi
  have hcert : (F_sumWith buchstabUB m (N1_of m) (N2_of m) : ℝ) ≤
      (getF m : ℝ) * W_scale * W_scale := by exact_mod_cast checkF_all hm
  refine le_trans h1 ?_
  rw [div_le_div_iff₀ (mul_pos (mul_pos hSpos hWpos) hWpos) hSpos]
  nlinarith

private lemma F_fn_le_tail {ω : ℝ → ℝ} (hω : IsBuchstab ω) (_hz : ZeroBelowOne ω)
    {s : ℝ} (hs : ((275 * S_step_in : ℕ) : ℝ) / D_in ≤ s) :
    F_fn ω s ≤ (F_tail_val : ℝ) / S_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hs_base : ((211 * S_step_in : ℕ) : ℝ) / D_in ≤ s := by
    have : ((211 * S_step_in : ℕ) : ℝ) / D_in ≤ ((275 * S_step_in : ℕ) : ℝ) / D_in := by
      unfold S_step_in D_in; norm_num
    linarith
  have hpt : ∀ p ∈ Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                   Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in),
      ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2) ≤
        ((M3_val : ℝ) / S_scale) * (1 / (p.1 * p.1 * p.2)) := by
    intro p hp
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hp.1.1
    have h2p : 0 < p.2 := lt_of_lt_of_le hA2 hp.2.1
    have h4B : 4 * ((B1_num : ℝ) / D_in) + ((B2_num : ℝ) / D_in) ≤ ((275 * S_step_in : ℕ) : ℝ) / D_in := by
      unfold B1_num B2_num S_step_in D_in; norm_num
    have hu3 : 3 ≤ (s - p.1 - p.2) / p.1 := by
      rw [le_div_iff₀ h1p]; linarith [hp.1.2, hp.2.2]
    have hw := buchstab_le_M3 hω hu3
    rw [mul_one_div]
    exact div_le_div_of_nonneg_right hw (by positivity)
  have hint_g := inner2d_integrableOn hω hs_base (isCompact_Icc.prod isCompact_Icc) (subset_refl _)
  have hint_w : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ))
      (Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
       Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in)) volume := by
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
    refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
    intro p hp
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hp.1.1
    have h2p : 0 < p.2 := lt_of_lt_of_le hA2 hp.2.1
    positivity
  have hmono : F_fn ω s ≤ ((M3_val : ℝ) / S_scale) *
      ∫ p in Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
             Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in), (1 / (p.1 * p.1 * p.2) : ℝ) := by
    unfold F_fn; rw [← integral_const_mul]
    exact setIntegral_mono_on hint_g (hint_w.const_mul _) (measurableSet_Icc.prod measurableSet_Icc) hpt
  rw [rect2_weight_eq (by unfold A1_num B1_num D_in; norm_num) (by unfold A2_num B2_num D_in; norm_num)] at hmono
  have hw1 := wInvSqIn_bound (a := A1_num) (b := B1_num) (by unfold A1_num; omega) (by unfold A1_num B1_num; omega)
  set h2 := (B2_num - A2_num) / 8
  have hh2_eq : 8 * h2 = B2_num - A2_num := by unfold h2 A2_num B2_num; decide
  have hw2 : ∫ t in ((A2_num : ℝ) / D_in)..((B2_num : ℝ) / D_in), (1 / t : ℝ) ≤
      (sumUpTo 8 (fun k => wInv (A2_num + k * h2) (A2_num + k * h2 + h2)) : ℝ) / W_scale := by
    have h0eq : ((A2_num + 0 * h2 : ℕ) : ℝ) / D_in = (A2_num : ℝ) / D_in := by simp
    have h8nat : A2_num + 8 * h2 = B2_num := by rw [hh2_eq]; unfold A2_num B2_num; omega
    have h8eq : ((A2_num + 8 * h2 : ℕ) : ℝ) / D_in = (B2_num : ℝ) / D_in := by rw [h8nat]
    have hadj : ∑ k ∈ Finset.range 8,
        ∫ t in (((A2_num + k * h2 : ℕ) : ℝ) / D_in)..(((A2_num + (k + 1) * h2 : ℕ) : ℝ) / D_in), (1 / t : ℝ) =
        ∫ t in ((A2_num : ℝ) / D_in)..((B2_num : ℝ) / D_in), (1 / t : ℝ) := by
      rw [← h0eq, ← h8eq]
      apply intervalIntegral.sum_integral_adjacent_intervals
      intro k _
      have hcont : ContinuousOn (fun t : ℝ => 1 / t)
          (Icc (((A2_num + k * h2 : ℕ) : ℝ) / D_in) (((A2_num + (k + 1) * h2 : ℕ) : ℝ) / D_in)) :=
        continuousOn_const.div continuousOn_id (fun t ht => by
          have : (0 : ℝ) < ((A2_num + k * h2 : ℕ) : ℝ) / D_in :=
            div_pos (by exact_mod_cast (by unfold A2_num; omega : 0 < A2_num + k * h2)) hDpos
          exact ne_of_gt (lt_of_lt_of_le this ht.1))
      exact hcont.intervalIntegrable_of_Icc
        (div_le_div_of_nonneg_right (by exact_mod_cast (by nlinarith : A2_num + k * h2 ≤ A2_num + (k + 1) * h2)) (le_of_lt hDpos))
    rw [← hadj, sumUpTo_eq_finset_sum, Finset.sum_div]
    apply Finset.sum_le_sum; intro k _
    have hstep_eq : ((A2_num + (k + 1) * h2 : ℕ) : ℝ) / D_in = ((A2_num + k * h2 + h2 : ℕ) : ℝ) / D_in := by
      congr 1; exact_mod_cast (by ring : A2_num + (k + 1) * h2 = A2_num + k * h2 + h2)
    rw [hstep_eq]
    exact wInv_bound_den (D := D_in) (by unfold D_in; omega) (by unfold A2_num; omega) (Nat.le_add_right _ _)
  have hi2_nn : 0 ≤ ∫ t in ((A2_num : ℝ) / D_in)..((B2_num : ℝ) / D_in), (1 / t : ℝ) := by
    apply intervalIntegral.integral_nonneg (by unfold A2_num B2_num D_in; norm_num)
    intro t ht
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
    exact div_nonneg zero_le_one (le_of_lt (lt_of_lt_of_le hA2 ht.1))
  have hW12 : (∫ t in ((A1_num : ℝ) / D_in)..((B1_num : ℝ) / D_in), (1 / (t * t) : ℝ)) *
      (∫ t in ((A2_num : ℝ) / D_in)..((B2_num : ℝ) / D_in), (1 / t : ℝ)) ≤
      (W12_ub8 : ℝ) / ((W_scale : ℝ) * W_scale) := by
    have hp := mul_le_mul hw1 hw2 hi2_nn (div_nonneg (Nat.cast_nonneg _) (le_of_lt hWpos))
    refine le_trans hp (le_of_eq ?_)
    unfold W12_ub8; dsimp only [h2]; rw [Nat.cast_mul]; ring
  have hmul := mul_le_mul_of_nonneg_left hW12 (div_nonneg (Nat.cast_nonneg M3_val) (le_of_lt hSpos))
  refine le_trans hmono (le_trans hmul ?_)
  have hvt : (M3_val : ℝ) * W12_ub8 ≤ (F_tail_val : ℝ) * W_scale * W_scale := by exact_mod_cast validF_tail
  have heq : (M3_val : ℝ) / S_scale * ((W12_ub8 : ℝ) / (W_scale * W_scale)) =
      ((M3_val : ℝ) * W12_ub8) / ((S_scale : ℝ) * W_scale * W_scale) := by ring
  rw [heq, div_le_div_iff₀ (mul_pos (mul_pos hSpos hWpos) hWpos) hSpos]
  have hvt2 := mul_le_mul_of_nonneg_right hvt (le_of_lt hSpos)
  linarith

private lemma F_fn_le_F_UB {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {m0 m1 : ℕ} (hm01 : m0 ≤ m1) {s : ℝ}
    (hs_lo : (((211 + m0) * S_step_in : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((211 + m1 + 1) * S_step_in : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (F_UB m0 m1 : ℝ) / S_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hSstep_pos : (0 : ℝ) < S_step_in := by unfold S_step_in; positivity
  have hD128 : (D_in : ℝ) = (S_step_in : ℝ) * 128 := by unfold D_in S_step_in; norm_num
  unfold F_UB
  split_ifs with hm0_big hm1_lt
  · have hs_tail : ((275 * S_step_in : ℕ) : ℝ) / D_in ≤ s := by
      have h1 : ((275 * S_step_in : ℕ) : ℝ) / D_in ≤ (((211 + m0) * S_step_in : ℕ) : ℝ) / D_in := by
        apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
        exact_mod_cast (Nat.mul_le_mul_right S_step_in (by omega : 275 ≤ 211 + m0))
      linarith
    exact F_fn_le_tail hω hz hs_tail
  · by_cases heq : s = (((211 + m1 + 1) * S_step_in : ℕ) : ℝ) / D_in
    · have hm_eq : (211 + m1 + 1) * S_step_in = (212 + m1) * S_step_in := by
        congr 1; omega
      have h1 := F_fn_le_getF hω hz hm1_lt (s := s)
        (by rw [heq]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
            exact_mod_cast (Nat.mul_le_mul_right S_step_in (by omega : 211 + m1 ≤ 211 + m1 + 1)))
        (by rw [heq, hm_eq])
      have h2 : getF m1 ≤ F_tree.rangeMax 6 m0 m1 :=
        SegTree.get_le_rangeMax validF_tree hm01 (le_refl m1) (by simpa using hm1_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hs_lt : s < (((211 + m1 + 1) * S_step_in : ℕ) : ℝ) / D_in := lt_of_le_of_ne hs_hi heq
      set m : ℕ := Nat.floor (s * 128 - 211)
      have hs128_lo : (211 : ℝ) + m0 ≤ s * 128 := by
        have h := (div_le_iff₀ hDpos).mp hs_lo
        rw [hD128] at h; push_cast at h
        exact le_of_mul_le_mul_right (by linarith : ((211 : ℝ) + m0) * S_step_in ≤ (s * 128) * S_step_in) hSstep_pos
      have hs128_hi : s * 128 < (211 : ℝ) + m1 + 1 := by
        have h := (lt_div_iff₀ hDpos).mp hs_lt
        rw [hD128] at h; push_cast at h
        exact lt_of_mul_lt_mul_right (by linarith : (s * 128) * S_step_in < ((211 : ℝ) + m1 + 1) * S_step_in) (le_of_lt hSstep_pos)
      have hm0_le : m0 ≤ m := Nat.le_floor (by linarith)
      have hm_le1 : m ≤ m1 := by
        have hlt : s * 128 - 211 < ((m1 + 1 : ℕ) : ℝ) := by push_cast; linarith
        have := (Nat.floor_lt (by linarith)).mpr hlt; omega
      have hm_lt : m < 64 := lt_of_le_of_lt hm_le1 hm1_lt
      have hfl1 : (m : ℝ) ≤ s * 128 - 211 := Nat.floor_le (by linarith)
      have hfl2 : s * 128 - 211 < (m : ℝ) + 1 := Nat.lt_floor_add_one _
      have h1 := F_fn_le_getF hω hz hm_lt (s := s)
        (by rw [div_le_iff₀ hDpos, hD128]; push_cast; nlinarith)
        (by rw [le_div_iff₀ hDpos, hD128]; push_cast; nlinarith)
      have h2 : getF m ≤ F_tree.rangeMax 6 m0 m1 :=
        SegTree.get_le_rangeMax validF_tree hm0_le hm_le1 (by simpa using hm_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
  · by_cases hs_tail : ((275 * S_step_in : ℕ) : ℝ) / D_in ≤ s
    · have h1 := F_fn_le_tail hω hz hs_tail
      have h2 : F_tail_val ≤ max (F_tree.rangeMax 6 m0 63) F_tail_val := le_max_right _ _
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · push Not at hs_tail
      set m : ℕ := Nat.floor (s * 128 - 211)
      have hs128_lo : (211 : ℝ) + m0 ≤ s * 128 := by
        have h := (div_le_iff₀ hDpos).mp hs_lo
        rw [hD128] at h; push_cast at h
        exact le_of_mul_le_mul_right (by linarith : ((211 : ℝ) + m0) * S_step_in ≤ (s * 128) * S_step_in) hSstep_pos
      have hs128_hi : s * 128 < (211 : ℝ) + 64 := by
        have h := (lt_div_iff₀ hDpos).mp hs_tail
        rw [hD128] at h; push_cast at h
        exact lt_of_mul_lt_mul_right (by linarith : (s * 128) * S_step_in < ((211 : ℝ) + 64) * S_step_in) (le_of_lt hSstep_pos)
      have hm0_le : m0 ≤ m := Nat.le_floor (by linarith)
      have hm_lt : m < 64 := (Nat.floor_lt (by linarith)).mpr (by push_cast; linarith)
      have hfl1 : (m : ℝ) ≤ s * 128 - 211 := Nat.floor_le (by linarith)
      have hfl2 : s * 128 - 211 < (m : ℝ) + 1 := Nat.lt_floor_add_one _
      have h1 := F_fn_le_getF hω hz hm_lt (s := s)
        (by rw [div_le_iff₀ hDpos, hD128]; push_cast; nlinarith)
        (by rw [le_div_iff₀ hDpos, hD128]; push_cast; nlinarith)
      have h2 : getF m ≤ F_tree.rangeMax 6 m0 63 :=
        SegTree.get_le_rangeMax validF_tree hm0_le (by omega) (by simpa using hm_lt)
      have h3 : getF m ≤ max (F_tree.rangeMax 6 m0 63) F_tail_val := le_trans h2 (le_max_left _ _)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h3) (le_of_lt hSpos))

/-! ### Part 5: Fubini Reduction of `buchstabIntegral` & Final Outer Assembly -/

private lemma buchstabIntegral_box_eq_iterated {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hφ : 2 ≤ φ) :
    buchstabIntegral ω 1 (fun j => (r1j15_lo j : ℝ)) (fun j => (r1j15_hi j : ℝ)) φ =
      ∫ x0 in Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out), (1 / x0) * F_fn ω (φ - x0) := by
  let e : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
    (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow))
  have hmp : MeasurePreserving e volume volume := by
    have h1 := MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0
    have h2 : MeasurePreserving
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow (α := ℝ)))
        (volume.prod volume) (volume.prod (volume.prod volume)) :=
      (MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ)
    exact h2.comp h1
  have hlo0 : (r1j15_lo 0 : ℝ) = (A0_num : ℝ) / D_out := by simp [r1j15_lo, A0_num, D_out]; norm_num
  have hhi0 : (r1j15_hi 0 : ℝ) = (B0_num : ℝ) / D_out := by simp [r1j15_hi, B0_num, D_out]; norm_num
  have hlo1 : (r1j15_lo 1 : ℝ) = (A1_num : ℝ) / D_in := by simp [r1j15_lo, A1_num, D_in]; norm_num
  have hhi1 : (r1j15_hi 1 : ℝ) = (B1_num : ℝ) / D_in := by simp [r1j15_hi, B1_num, D_in]; norm_num
  have hlo2 : (r1j15_lo 2 : ℝ) = (A2_num : ℝ) / D_in := by simp [r1j15_lo, A2_num, D_in]; norm_num
  have hhi2 : (r1j15_hi 2 : ℝ) = (B2_num : ℝ) / D_in := by simp [r1j15_hi, B2_num, D_in]; norm_num
  set Sprod : Set (ℝ × (ℝ × ℝ)) :=
    Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out) ×ˢ
    (Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
     Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in))
  have he_apply : ∀ x : Fin 3 → ℝ, e x = (x 0, (x 1, x 2)) := fun _ => rfl
  have hdom : domain (fun j => (r1j15_lo j : ℝ)) (fun j => (r1j15_hi j : ℝ)) = e ⁻¹' Sprod := by
    ext x
    simp only [domain, Sprod, mem_ofPred_eq, mem_preimage, mem_prod, mem_Icc, he_apply]
    constructor
    · rintro ⟨_, hbox⟩
      have h0 := hbox 0; rw [hlo0, hhi0] at h0
      have h1 := hbox 1; rw [hlo1, hhi1] at h1
      have h2 := hbox 2; rw [hlo2, hhi2] at h2
      exact ⟨h0, h1, h2⟩
    · rintro ⟨h0, h1, h2⟩
      have hgap01 : (B0_num : ℝ) / D_out ≤ (A1_num : ℝ) / D_in := by
        unfold B0_num D_out A1_num D_in; norm_num
      have hgap12 : (B1_num : ℝ) / D_in ≤ (A2_num : ℝ) / D_in := by
        unfold B1_num A2_num D_in; norm_num
      refine ⟨?_, ?_⟩
      · intro i j hij
        fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> linarith
      · intro j
        fin_cases j
        · change (r1j15_lo 0 : ℝ) ≤ x 0 ∧ x 0 ≤ (r1j15_hi 0 : ℝ); rw [hlo0, hhi0]; exact h0
        · change (r1j15_lo 1 : ℝ) ≤ x 1 ∧ x 1 ≤ (r1j15_hi 1 : ℝ); rw [hlo1, hhi1]; exact h1
        · change (r1j15_lo 2 : ℝ) ≤ x 2 ∧ x 2 ≤ (r1j15_hi 2 : ℝ); rw [hlo2, hhi2]; exact h2
  let g3 : ℝ × (ℝ × ℝ) → ℝ := fun q =>
    ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1) / (q.1 * q.2.1 * q.2.1 * q.2.2)
  have hfun_eq : (fun x : Fin 3 → ℝ =>
      ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩)) = fun x => g3 (e x) := by
    funext x
    have hidx1 : (⟨1, by omega⟩ : Fin 3) = 1 := rfl
    simp only [g3, he_apply, Fin.sum_univ_three, Fin.prod_univ_three, hidx1]
    congr 1
    · congr 1; ring
    · ring
  unfold buchstabIntegral
  rw [hdom, hfun_eq]
  have hpre := hmp.setIntegral_preimage_emb e.measurableEmbedding g3 Sprod
  rw [hpre]
  have hint_g3 : IntegrableOn g3 Sprod volume := by
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_out := by unfold A0_num D_out; norm_num
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
    have hBsum : (B0_num : ℝ) / D_out + 2 * ((B1_num : ℝ) / D_in) + ((B2_num : ℝ) / D_in) ≤ 2 := by
      unfold B0_num D_out B1_num B2_num D_in; norm_num
    have hq_ok : ∀ q ∈ Sprod, 0 < q.1 ∧ 0 < q.2.1 ∧ 0 < q.2.2 ∧
        1 ≤ (φ - q.1 - q.2.1 - q.2.2) / q.2.1 := by
      intro q hq
      have h0p : 0 < q.1 := lt_of_lt_of_le hA0 hq.1.1
      have h1p : 0 < q.2.1 := lt_of_lt_of_le hA1 hq.2.1.1
      have h2p : 0 < q.2.2 := lt_of_lt_of_le hA2 hq.2.2.1
      refine ⟨h0p, h1p, h2p, ?_⟩
      rw [le_div_iff₀ h1p]
      linarith [hq.1.2, hq.2.1.2, hq.2.2.2]
    have harg : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => (φ - q.1 - q.2.1 - q.2.2) / q.2.1) Sprod :=
      (((continuousOn_const.sub continuous_fst.continuousOn).sub
        (continuous_fst.comp continuous_snd).continuousOn).sub
        (continuous_snd.comp continuous_snd).continuousOn).div
        (continuous_fst.comp continuous_snd).continuousOn (fun q hq => ne_of_gt (hq_ok q hq).2.1)
    have hnum : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1)) Sprod :=
      hω.1.comp harg (fun q hq => (hq_ok q hq).2.2.2)
    have hden : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => q.1 * q.2.1 * q.2.1 * q.2.2) Sprod :=
      (((continuous_fst.mul (continuous_fst.comp continuous_snd)).mul
        (continuous_fst.comp continuous_snd)).mul
        (continuous_snd.comp continuous_snd)).continuousOn
    exact hnum.div hden (fun q hq => by rcases hq_ok q hq with ⟨h0, h1, h2, _⟩; positivity)
  rw [show (volume : Measure (ℝ × (ℝ × ℝ))) = volume.prod volume from rfl,
      setIntegral_prod g3 hint_g3]
  apply setIntegral_congr_fun measurableSet_Icc
  intro x0 _
  dsimp only
  unfold F_fn
  rw [← integral_const_mul]
  congr 1; funext p
  dsimp only [g3]
  ring

private lemma outer_integrableOn {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hφ : 2 ≤ φ) :
    IntegrableOn (fun x0 : ℝ => (1 / x0) * F_fn ω (φ - x0))
      (Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out)) volume := by
  let g3 : ℝ × (ℝ × ℝ) → ℝ := fun q =>
    ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1) / (q.1 * q.2.1 * q.2.1 * q.2.2)
  set Sprod : Set (ℝ × (ℝ × ℝ)) :=
    Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out) ×ˢ
    (Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
     Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in))
  have hint_g3 : IntegrableOn g3 Sprod (volume.prod volume) := by
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_out := by unfold A0_num D_out; norm_num
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_in := by unfold A2_num D_in; norm_num
    have hBsum : (B0_num : ℝ) / D_out + 2 * ((B1_num : ℝ) / D_in) + ((B2_num : ℝ) / D_in) ≤ 2 := by
      unfold B0_num D_out B1_num B2_num D_in; norm_num
    have hq_ok : ∀ q ∈ Sprod, 0 < q.1 ∧ 0 < q.2.1 ∧ 0 < q.2.2 ∧
        1 ≤ (φ - q.1 - q.2.1 - q.2.2) / q.2.1 := by
      intro q hq
      have h0p : 0 < q.1 := lt_of_lt_of_le hA0 hq.1.1
      have h1p : 0 < q.2.1 := lt_of_lt_of_le hA1 hq.2.1.1
      have h2p : 0 < q.2.2 := lt_of_lt_of_le hA2 hq.2.2.1
      refine ⟨h0p, h1p, h2p, ?_⟩
      rw [le_div_iff₀ h1p]
      linarith [hq.1.2, hq.2.1.2, hq.2.2.2]
    have harg : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => (φ - q.1 - q.2.1 - q.2.2) / q.2.1) Sprod :=
      (((continuousOn_const.sub continuous_fst.continuousOn).sub
        (continuous_fst.comp continuous_snd).continuousOn).sub
        (continuous_snd.comp continuous_snd).continuousOn).div
        (continuous_fst.comp continuous_snd).continuousOn (fun q hq => ne_of_gt (hq_ok q hq).2.1)
    have hnum : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1)) Sprod :=
      hω.1.comp harg (fun q hq => (hq_ok q hq).2.2.2)
    have hden : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => q.1 * q.2.1 * q.2.1 * q.2.2) Sprod :=
      (((continuous_fst.mul (continuous_fst.comp continuous_snd)).mul
        (continuous_fst.comp continuous_snd)).mul
        (continuous_snd.comp continuous_snd)).continuousOn
    exact hnum.div hden (fun q hq => by rcases hq_ok q hq with ⟨h0, h1, h2, _⟩; positivity)
  have hint_prod : Integrable g3
      ((volume.restrict (Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out))).prod
       (volume.restrict (Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                         Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in)))) := by
    rw [Measure.prod_restrict]
    exact hint_g3
  have hint_iter : IntegrableOn
      (fun x0 => ∫ p in Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                        Icc ((A2_num : ℝ) / D_in) ((B2_num : ℝ) / D_in), g3 (x0, p))
      (Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out)) volume :=
    hint_prod.integral_prod_left
  refine hint_iter.congr_fun ?_ measurableSet_Icc
  intro x0 _
  dsimp only
  unfold F_fn
  rw [← integral_const_mul]
  congr 1; funext p; dsimp only [g3]; ring

lemma outer_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (_hz : ZeroBelowOne ω)
    (fub : ℕ → ℕ → ℕ)
