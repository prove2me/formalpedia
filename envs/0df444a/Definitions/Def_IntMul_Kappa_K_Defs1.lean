-- Source module: Solutions.AModel
/-!
# Array model: mixed-radix arrays, pull maps, and linear address maps via Bruhat factors

Arrays are lists in row-major lexicographic order over fields (first field most significant).
All denotations are plain `List` functions.
-/

namespace AModel

open Matrix

/-! ## 1. Mixed-radix basics -/

/-- A shape is the list of field sizes. -/
abbrev Shape := List ℕ

/-- Volume (number of entries) of a shape. -/
def vol (sh : Shape) : ℕ := sh.prod

/-- Mixed-radix decoding, first field most significant. -/
def decode : Shape → ℕ → List ℕ
  | [], _ => []
  | q :: sh, n => (n / vol sh) % q :: decode sh (n % vol sh)

/-- Mixed-radix encoding, first field most significant. -/
def encode : Shape → List ℕ → ℕ
  | [], _ => 0
  | _ :: sh, a => a.headD 0 * vol sh + encode sh a.tail

/-- A valid address: same length as the shape, each digit below its field size. -/
def Valid (sh : Shape) (a : List ℕ) : Prop := List.Forall₂ (· < ·) a sh

@[simp] lemma vol_nil : vol [] = 1 := rfl
@[simp] lemma vol_cons (q : ℕ) (sh : Shape) : vol (q :: sh) = q * vol sh := List.prod_cons

lemma valid_iff (sh : Shape) (a : List ℕ) :
    Valid sh a ↔ a.length = sh.length ∧
      ∀ (k : ℕ) (h₁ : k < a.length) (h₂ : k < sh.length), a[k] < sh[k] := by
  unfold Valid; rw [List.forall₂_iff_get]; rfl

lemma Valid.length_eq {sh : Shape} {a : List ℕ} (h : Valid sh a) : a.length = sh.length :=
  ((valid_iff sh a).1 h).1

lemma encode_lt {sh : Shape} {a : List ℕ} (h : Valid sh a) : encode sh a < vol sh := by
  induction h with
  | nil => simp [encode]
  | @cons x q as sh hx _ ih =>
    simp only [encode, List.headD_cons, List.tail_cons, vol_cons]
    have : (x + 1) * vol sh ≤ q * vol sh := Nat.mul_le_mul_right _ hx
    nlinarith

lemma valid_decode {sh : Shape} {m : ℕ} (h : m < vol sh) : Valid sh (decode sh m) := by
  induction sh generalizing m with
  | nil => exact List.Forall₂.nil
  | cons q sh ih =>
    simp only [vol_cons] at h
    have hV : 0 < vol sh := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    have hq : 0 < q := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    exact List.Forall₂.cons (Nat.mod_lt _ hq) (ih (Nat.mod_lt m hV))

/-! ## 2. Pull maps -/

/-- Array permutation by its pull map: output address `y` reads input address `g y`. -/
def pull {α : Type*} (sh sh' : Shape) (g : List ℕ → List ℕ) (d : α) (xs : List α) : List α :=
  (List.range (vol sh')).map (fun j => xs.getD (encode sh (g (decode sh' j))) d)

section Pull
variable {α : Type*}

end Pull

/-! ## 3. Active fields -/

/-- `n` active fields of size `Q` inside the shape `sh`, at strictly increasing positions. -/
structure Layout (sh : Shape) (n Q : ℕ) where
  pos : Fin n → Fin sh.length
  mono : StrictMono pos
  size : ∀ i, sh.get (pos i) = Q

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- The active field (if any) at list index `k`. -/
def Layout.actIdx (k : ℕ) : Option (Fin n) :=
  (List.finRange n).find? (fun i => (Λ.pos i : ℕ) == k)

/-- Active vector of an address. -/
def act (a : List ℕ) (i : Fin n) : ZMod Q := ((a.getD (Λ.pos i) 0 : ℕ) : ZMod Q)

/-- Replace the active digits of `a` by `(v i).val`. -/
def setAct (a : List ℕ) (v : Fin n → ZMod Q) : List ℕ :=
  a.mapIdx fun k x => match Λ.actIdx k with
    | some i => (v i).val
    | none => x

/-- Address map induced by a map on active vectors. -/
def vmap (F : (Fin n → ZMod Q) → (Fin n → ZMod Q)) (a : List ℕ) : List ℕ :=
  setAct Λ a (F (act Λ a))

/-- Address map of a matrix acting on the active vector. -/
def amap (L : Matrix (Fin n) (Fin n) (ZMod Q)) (a : List ℕ) : List ℕ :=
  setAct Λ a (L *ᵥ act Λ a)

namespace Layout

end Layout

/-! ## 4. Controlled shift -/

/-- Active-vector form of the controlled shift. -/
def shiftVec (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q) (x : Fin n → ZMod Q) :
    Fin n → ZMod Q :=
  Function.update x i (u * x i + ∑ j, c j * x j)

/-- Inverse of `shiftVec` (when `u` is a unit and `c j = 0` for `j ≥ i`). -/
def shiftInvVec (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q) (y : Fin n → ZMod Q) :
    Fin n → ZMod Q :=
  Function.update y i (u⁻¹ * (y i - ∑ j, c j * y j))

/-- Controlled shift address map: `x_i ↦ u x_i + Σ_j c_j x_j`. -/
def shiftMap (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q) (a : List ℕ) : List ℕ :=
  setAct Λ a (Function.update (act Λ a) i (u * act Λ a i + ∑ j, c j * act Λ a j))

/-- Its explicit inverse: `y_i ↦ u⁻¹ (y_i - Σ_j c_j y_j)`. -/
def shiftInv (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q) (a : List ℕ) : List ℕ :=
  setAct Λ a (Function.update (act Λ a) i (u⁻¹ * (act Λ a i - ∑ j, c j * act Λ a j)))

/-! ## 5. Field transposition -/

/-- Exchange the digits at `pos i` and `pos j`. -/
def swapMap (i j : Fin n) (a : List ℕ) : List ℕ :=
  (a.set (Λ.pos i) (a.getD (Λ.pos j) 0)).set (Λ.pos j) (a.getD (Λ.pos i) 0)

section Shift

end Shift

section Swap

end Swap

/-! ## Primitive steps and their composition -/

/-- A primitive step on the active fields. -/
inductive Step (n Q : ℕ) where
  /-- Controlled shift (d): `x_i ↦ u x_i + Σ_j c_j x_j`. -/
  | shift (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q)
  /-- Field transposition (e): exchange fields `i` and `j`. -/
  | swap (i j : Fin n)

namespace Step

/-- Well-formedness: shifts have unit coefficient and only read earlier fields. -/
def WF : Step n Q → Prop
  | shift i u c => IsUnit u ∧ ∀ j, i ≤ j → c j = 0
  | swap _ _ => True

/-- Action on active vectors. -/
def vec : Step n Q → (Fin n → ZMod Q) → (Fin n → ZMod Q)
  | shift i u c => shiftVec i u c
  | swap i j => fun x => x ∘ Equiv.swap i j

/-- Inverse action on active vectors. -/
def invVec : Step n Q → (Fin n → ZMod Q) → (Fin n → ZMod Q)
  | shift i u c => shiftInvVec i u c
  | swap i j => fun x => x ∘ Equiv.swap i j

/-- Address map of a step. -/
def addr (s : Step n Q) : List ℕ → List ℕ :=
  match s with
  | shift i u c => shiftMap Λ i u c
  | swap i j => swapMap Λ i j

/-- Explicit inverse address map of a step. -/
def inv (s : Step n Q) : List ℕ → List ℕ :=
  match s with
  | shift i u c => shiftInv Λ i u c
  | swap i j => swapMap Λ i j

/-- Array action of a step: `pull` with the inverse address map. -/
def arr {α : Type*} (d : α) (s : Step n Q) (xs : List α) : List α :=
  pull sh sh (s.inv Λ) d xs

variable [NeZero Q]

end Step

/-- Run a list of steps on an address (first step first). -/
def run (steps : List (Step n Q)) (a : List ℕ) : List ℕ :=
  steps.foldl (fun b s => s.addr Λ b) a

/-- Run a list of steps on an array (first step first). -/
def runArr {α : Type*} (d : α) (steps : List (Step n Q)) (xs : List α) : List α :=
  steps.foldl (fun ys s => s.arr Λ d ys) xs

/-- Run a list of steps on an active vector (first step first). -/
def runVec (steps : List (Step n Q)) (x : Fin n → ZMod Q) : Fin n → ZMod Q :=
  steps.foldl (fun y s => s.vec y) x

/-- Composition of the inverse address maps: `inv s₁ ∘ inv s₂ ∘ ⋯ ∘ inv sₖ`. -/
def invChain (steps : List (Step n Q)) : List ℕ → List ℕ :=
  steps.foldr (fun s g => s.inv Λ ∘ g) id

section Run
variable [NeZero Q]

end Run

/-! ## 6. Linear address maps through Bruhat factors -/

section Bruhat

/-- The controlled shift realizing row `i` of a lower triangular `E`:
`x_i ↦ E i i * x_i + Σ_{j < i} E i j * x_j`. -/
def shiftStep (E : Matrix (Fin n) (Fin n) (ZMod Q)) (i : Fin n) : Step n Q :=
  .shift i (E i i) (fun j => if j < i then E i j else 0)

/-- Shifts for `E`, in descending target order `n-1, …, 0`. -/
def shiftSteps (E : Matrix (Fin n) (Fin n) (ZMod Q)) : List (Step n Q) :=
  (List.finRange n).reverse.map (shiftStep E)

/-- Field transpositions, one per pair. -/
def swapSteps (ts : List (Fin n × Fin n)) : List (Step n Q) :=
  ts.map fun p => .swap p.1 p.2

/-- The full pipeline for `E₁ * w * E₂`: shifts for `E₂`, then swaps, then shifts for `E₁`. -/
def bruhatSteps (E₁ : Matrix (Fin n) (Fin n) (ZMod Q)) (ts : List (Fin n × Fin n))
    (E₂ : Matrix (Fin n) (Fin n) (ZMod Q)) : List (Step n Q) :=
  shiftSteps E₂ ++ swapSteps ts ++ shiftSteps E₁

variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}

/-- The product of the transpositions of `ts`, leftmost first. -/
def swapProd (ts : List (Fin n × Fin n)) : Equiv.Perm (Fin n) :=
  (ts.map fun p => Equiv.swap p.1 p.2).prod

variable [NeZero Q]

end Bruhat

end AModel

end

