/-- The selected-branch inequalities hold near `0⁺` (from the actual limits `Z → f₁`, `r → b₁`). -/
theorem branch : ∀ᶠ x in 𝓝[>] (0:ℝ),
    0 < 2 - x * Zf h F x + 2 * (1 - h * x) * x * rf b x ∧
    0 < 2 - x * Zf h F x + (1 - h * x) * x * rf b x := by
  have tx : Tendsto (fun x : ℝ => x) (𝓝[>] (0:ℝ)) (𝓝 0) := nhdsWithin_le_nhds.trans (by simp)
  have t1 : Tendsto (fun x => 2 - x * Zf h F x + 2 * (1 - h * x) * x * rf b x) (𝓝[>] (0:ℝ))
      (𝓝 (2 - 0 * f₁ + 2 * 1 * 0 * b₁)) :=
    ((tendsto_const_nhds.sub (tx.mul S.tZ)).add (((tendsto_const_nhds.mul (tendsto_u h)).mul tx).mul S.tr))
  have t2 : Tendsto (fun x => 2 - x * Zf h F x + (1 - h * x) * x * rf b x) (𝓝[>] (0:ℝ))
      (𝓝 (2 - 0 * f₁ + 1 * 0 * b₁)) :=
    ((tendsto_const_nhds.sub (tx.mul S.tZ)).add (((tendsto_u h).mul tx).mul S.tr))
  simp only [zero_mul, mul_zero, sub_zero, add_zero] at t1 t2
  exact (t1.eventually (lt_mem_nhds two_pos)).and (t2.eventually (lt_mem_nhds two_pos))

