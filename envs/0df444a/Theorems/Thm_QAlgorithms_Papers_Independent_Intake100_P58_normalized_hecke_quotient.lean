-- title:
--   Section 2, unnumbered: normalized Hecke quotient
-- statement:
--   Let $k\ge1$ and let $R$ be a commutative unital ring. Choose units $q_0,q,\lambda\in R^\times$, coefficients $q_1,\ldots,q_{k-1}\in R$, and $A_0,\ldots,A_{k-1}\in R$. Put $\delta=q-q^{-1}$ and assume $\lambda-\lambda^{-1}=\delta(1-A_0)$. Let $B=B_2^k(R)$ be the unital associative algebra on invertible $Y,X$ and an element $e$, with relations (1)–(6) of Definition 2.1. In particular, $Y^k=\sum_{i=0}^{k-1}q_iY^i$, $X-X^{-1}=\delta(1-e)$, $XYXY=YXYX$, $Xe=eX=\lambda e$, $YXYe=eYXY=\lambda^{-1}e$, and $eY^me=A_me$ for $0\le m<k$.
--
--   Assume multiplication by $\delta$ on $R$ is injective (Assumption 2.2). Neither $A_0$ nor $\delta$ need be units, and the cyclotomic polynomial need not split.
--
--   Let $H=h_2^k(R)$ be the independent unital algebra generated by invertible $T_0,T_1$ with
--   $$
--   T_0T_1T_0T_1=T_1T_0T_1T_0,\qquad T_0^k=\sum_{i=0}^{k-1}q_iT_0^i,\qquad T_1^2=\delta T_1+1.
--   $$
--   If $I=BeB$ is the two-sided ideal generated by $e$, there is an $R$-algebra isomorphism
--   $$
--   B/I\simeq H,\qquad [Y]\mapsto T_0,\quad [X]\mapsto T_1,\quad[e]\mapsto0.
--   $$
--   This realizes the source's normalized cyclotomic Hecke algebra as the actual quotient. No admissibility is assumed.
-- source:
--   The cyclotomic BMW algebra associated with the two string type B braid group, arXiv:math/0611518v3, PDF p. 4, Normalized Hecke quotient

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P58

noncomputable section

open scoped BigOperators Classical

namespace QAlgorithms.Papers.Independent.Intake100.P58

open Accepted

variable {R : Type*} [CommRing R] {k : ℕ}

/-- Section 2, normalized Hecke quotient, PDF p.4. The equivalence sends
Y to T0 and X to T1, with no q-scaling. -/
theorem normalized_hecke_quotient (P : NonsplitParameters R k) (hdelta : RegularDelta P) :
    ∃ f : EQuotient P ≃ₐ[R] NormalizedHecke P,
      f (eQuotientMap P (y P)) = heckeGen P .t0 ∧
      f (eQuotientMap P (x P)) = heckeGen P .t1 ∧
      f (eQuotientMap P (e P)) = 0 := by sorry

end QAlgorithms.Papers.Independent.Intake100.P58

end
