values of the unknown proxies. -/
theorem runMinorRequest_height {n : ℕ} (v : Fin (n+1) → ℝ) (w : Fin (n+1) → ℚ)
    (g : Fin (n+1) → Fin (n+1) → ℤ) (oracle : (Fin (n+1) → ℤ) → ℤ → Bool)
