-- Source module: Solutions.KFWC10
/-!
# KFW C-layer 10: the layer body `S_D ; C ; S_D ; b^D ; Q_p`

With the core registers and the total scale `E = q₀ + lowF ES k D' + ⌊D/2⌋ + D mod 2` on
register `24`, the fixed code `bodyC jT jW` runs the uniform `S_D` (`sdC`), the `C`-layer
(`clC`), `S_D`, the scalar `b^D` (`mdC`), and the truncation `truncU 17 18` (frame
`17 = 2^E`, `18 = 2 N`).

**`bodyQ`**: the output is `prop14Proc … (tens Cm)` (as in `KFM.p14Ph_iruns`), with `GB (p+1)`,
the `√2 · 2^{-p}` error against `layerH`, and cost `cBody`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul RS AModel KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-- The truncation frame. -/
def trE : List (Fin HS × Ex HS) := [(17, .pow2 (.reg 24)), (18, NLogN.KFW.eL)]

/-- The layer body. -/
def bodyC {Pp : ℕ} (jT jW : Fin Pp) : IStmt HS Pp :=
  .seq (.seq (.seq (.seq sdC (clC jT jW)) sdC) mdC) (withPushI trE (fcode (NLogN.KFW.truncU 17 18)))

/-- The push cost of the truncation frame. -/
def cTrP (E Z : ℕ) : ℕ :=
  (1 * 10 ^ 7 * (Z + 2) ^ 2 + 2 * moveCost Z + pow2Cost E + 2 * Z + 100) +
    (2 * moveCost (E + Z + 1) + 19) +
  (NLogN.KFW.eL.size * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost (E + Z + 1) + 19) + 1)

/-- The cost of the body. -/
noncomputable def cBody (Kc : ℝ) (K S r H P D k q0 Bp Z Zr Bz : ℕ) (w : ℕ) : ℕ :=
  cSD K S r P D Z w + cCL Kc K S r H P D k q0 Bp Z Zr Bz w +
    cSD K S r P D Z (w + (2 * q0 + lowF DWl k (D - q0))) +
    (7 * cMdT Bz + cMdK (P * 2 ^ (K * D) * S * r) Z Bz (w + (2 * q0 + lowF DWl k (D - q0)))) +
  (cTrP (q0 + lowF ES k (D - q0) + (D / 2 + D % 2)) Z +
    400 * (cTrunc (w + (2 * q0 + lowF DWl k (D - q0) + 2)) (q0 + lowF ES k (D - q0) + (D / 2 + D % 2))
      (2 * (P * 2 ^ (K * D) * S * r)) Z + 0) +
    (2 * (2 * ((q0 + lowF ES k (D - q0) + (D / 2 + D % 2)) + Z + 1) + 2) + 1))

