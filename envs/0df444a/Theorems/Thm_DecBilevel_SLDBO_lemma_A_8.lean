-- title:
--   Lemma A.8, (41), p. 18 — descent of Φ along the averaged iterates
-- statement:
--   Under Assumptions 2.1 and 2.2, let $y^*(x)$ minimize $f(x,\cdot)$ for every $x$, and let the sequences be generated by Algorithm 1 from BOX 1 with any $\alpha,\beta,\eta>0$. For every $k\ge0$,
--   $$\begin{aligned}\Phi(\bar x^{k+1})-\Phi(\bar x^k)\le{}&-\frac\alpha2\|\nabla\Phi(\bar x^k)\|^2-\frac12\Big(\frac1\alpha-L_\Phi\Big)\|\bar x^{k+1}-\bar x^k\|^2+\frac{5\alpha L_{f,1}^2}2\|\bar v^k-v^*(\bar x^k)\|^2\\&+\frac{5\alpha(L_{F,1}+L_{f,2}r_v)^2}2\|\bar y^k-y^*(\bar x^k)\|^2+\frac{5\alpha L_{f,1}^2}{2n}\sum_{i=1}^n\|v^k_i-\bar v^k\|^2\\&+\frac{5\alpha(L_{F,1}+r_vL_{f,2})^2}{2n}\sum_{i=1}^n\big(\|x^k_i-\bar x^k\|^2+\|y^k_i-\bar y^k\|^2\big).\end{aligned}$$
--
--   This is the descent inequality for the upper-level objective that the Lyapunov function (15) is built around.
--
--   **Formalization Note.** $\nabla\Phi$ is the formula (7) (`hypergrad`), and $L_\Phi=L_1(1+L_{f,1}/\sigma)^2$ is the corrected constant of (8) (see the Lipschitz milestone).
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 18, Lemma A.8, (41)

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_8 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0)
    (ystar : E p → E q) (hystar : ∀ x, IsMinOn (avgf f x) Set.univ (ystar x)) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    Phi F ystar (avg (s (k + 1)).x) - Phi F ystar (avg (s k).x) ≤
      -(α / 2) * ‖hypergrad F f ystar (avg (s k).x)‖ ^ 2 -
      (1 / 2) * (1 / α - LPhi σ LF0 LF1 Lf1 Lf2) * ‖avg (s (k + 1)).x - avg (s k).x‖ ^ 2 +
      5 * α * Lf1 ^ 2 / 2 * ‖avg (s k).v - vstar F f ystar (avg (s k).x)‖ ^ 2 +
      5 * α * (LF1 + Lf2 * rv σ LF0) ^ 2 / 2 * ‖avg (s k).y - ystar (avg (s k).x)‖ ^ 2 +
      5 * α * Lf1 ^ 2 / (2 * n) * ∑ i, ‖(s k).v i - avg (s k).v‖ ^ 2 +
      5 * α * (LF1 + rv σ LF0 * Lf2) ^ 2 / (2 * n) * ∑ i, (‖(s k).x i - avg (s k).x‖ ^ 2 + ‖(s k).y i - avg (s k).y‖ ^ 2) := by sorry

end DecBilevel.SLDBO
