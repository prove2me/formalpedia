theorem OAI.InitialMeanSquare.initial_log_box_small_power (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ U V K : ℝ,1≤U → 0<V → 0<K → V≤U → K≤U →
