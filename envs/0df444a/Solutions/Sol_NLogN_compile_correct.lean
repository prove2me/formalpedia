            (Runs.iteT hb (Runs.seq (Runs.push _ (ι i) hdPos) (by rw [hp]; exact h)))).mono ?_
          omega
    · have : (encI s).top (ι i) = some hdMark := by simp [St.top_eq, hG, Item.enc]
      rw [this]
      simp only [Option.some_ne_none, if_false, if_true]
      exact h.mono (by omega)

theorem Runs.flagOf {i : Fin S} {f : Cls → Bool} (s : IState S) :
    Runs I prog (NLogN.flagOf i f) (encI s) (encF i f s) 21 :=
  Runs.branchOn (Runs.push _ _ _)

theorem encF_top (i : Fin S) (f : Cls → Bool) (s : IState S) :
    (encF i f s).top (s3 S) = some (if f (s.cl i) then 1 else 0) := by
  simp [encF, St.top_eq]

end NLogN

