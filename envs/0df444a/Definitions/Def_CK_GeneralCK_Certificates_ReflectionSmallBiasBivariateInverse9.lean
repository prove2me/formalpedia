  have h12 := ((lossPower12_approximates hk hklog).scale (125970 : ℚ)).addAppend h13
  have h11 := ((lossPower11_approximates hk hklog).scale (75582 : ℚ)).addAppend h12
  have h10 := ((lossPower10_approximates hk hklog).scale (43758 : ℚ)).addAppend h11
  have h9 := ((lossPower9_approximates hk hklog).scale (24310 : ℚ)).addAppend h10
