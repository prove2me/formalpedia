theorem ts18_18 (ℓ : ℕ) (ts : List ℕ) [NeZero ts.length] (hℓ : 1 ≤ ℓ)
    (hts : ∀ t ∈ ts, t = 2 ^ ℓ ∨ 2 * t = 2 ^ ℓ) : ts18 ts.length ℓ (long18 ℓ ts) = ts := by
  apply List.ext_getElem (by simp [ts18])
  intro i h1 h2
  have ht := hts _ (List.getElem_mem h2)
  have ha : al ts.length ℓ (long18 ℓ ts) ⟨i, h2⟩ = if ts[i] = 2 ^ ℓ then ℓ else ℓ - 1 := by
    simp [al, long18]
  simp only [ts18, List.getElem_ofFn]
  rw [ha]
  by_cases hc : ts[i] = 2 ^ ℓ
  · rw [if_pos hc]; exact hc.symm
  · rw [if_neg hc]
    have h2t := ht.resolve_left hc
    have : 2 ^ ℓ = 2 * 2 ^ (ℓ - 1) := by rw [← pow_succ']; congr 1; omega
    omega

