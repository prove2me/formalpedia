/-!
# B-line IL, the `J` kernel (B4), part 9: the backward loop

`bwdP` runs `bwdB` for the `m = top HM` records: from `A = bts`, `Z = BZ = []` and the table
`flatB k bs` on `dTJ` it leaves `Z = (bwdS P bs bts m).1 = bwdK P bs bts [] []`
(`bwdK_eq_bwdS`), `BZ = (bwdS m).2`, `A = []`, the table moved onto `TT` (`bwdP_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section bwd
variable {P k : ℕ} {F : Fin HS → List ℤ} {bs : List (List ℤ × List ℤ × ℤ × ℤ)} {bts R T0 : List ℤ}

theorem bwdP_spec_sol_aux {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M (k + 2) Φm) (s : IState HS)
    {lp lp1 lk lh : List ℤ} (hF : BwdF P k F lp lp1 lk) (hD : BwdD P bs bts Xb Bc)
    (hk : 2 * Xb + 2 * P + Bc + 6 ≤ k) (hBx : 2 * k + 8 ≤ Bx)
    (hT : F dTJ = flatB k bs ++ R) (hTT : F TT = T0) (hA : F A = bts) (hZ : F Z = [])
    (hBZ : F BZ = []) (hHM : F HM = (bs.length : ℤ) :: lh) :
    MSp M bwdP (encK s F) (encK s (bSt P k F bs bts R T0 bs.length))
      ((∑ j ∈ range bs.length, (recL bs j + 6) + 1) * uC Φm Bx Bc) := by
  have e0 : bSt P k F bs bts R T0 0 = F := by
    funext j
    simp only [bSt, update_apply, List.drop_zero, List.take_zero, bwdS_zero]
    by_cases j1 : j = BZ
    · subst j1; simp +decide [hBZ]
    by_cases j2 : j = Z
    · subst j2; simp +decide [hZ]
    by_cases j3 : j = A
    · subst j3; simp +decide [hA]
    by_cases j4 : j = TT
    · subst j4; simp +decide [hTT, flatB]
    by_cases j5 : j = dTJ
    · subst j5; simp +decide [hT]
    simp [j1, j2, j3, j4, j5]
  have hCR : ∀ j, bSt P k F bs bts R T0 j CR = [] := fun j => by
    simp +decide [bSt, update_apply, hF.cr]
  have hw : CR ∉ bwdB.writes := by
    simp +decide [bwdB, divB, flB, recip, dotP, kD, rdT, RM.writes, RS.writes, mvK]
  have hzm : zsz (bs.length : ℤ) ≤ Bc := by apply zsz_le_of_lt; simp; exact hD.mB
  have hloop := MSp.repS (M := M) (C := CR) (n := .reg HM) (b := bwdB) (s := s)
    (F := fun j => bSt P k F bs bts R T0 j) (N := bs.length) (B := Bc)
    (c := fun j => (recL bs j + 5) * uC Φm Bx Bc) (by decide) hCR hw
    (RS.clean_of_lt (by decide))
    (by simp only [e0]; exact isInt_encK hHM) (by simp only [e0, Ex.Bnd, top_encK hHM]; exact hzm)
    (by simp only [e0]; simp [Ex.eval, top_encK hHM]) (fun j hj => by
      have := bwd_body (R := R) (T0 := T0) hMB s hF hD hk hBx bs.length j hj
      simp only [recL, List.getD_eq_getElem _ _ hj]; exact this)
  simp only [e0] at hloop
  refine hloop.mono ?_
  simp only [Ex.size]
  have hsum : ∑ j ∈ range bs.length, ((recL bs j + 5) * uC Φm Bx Bc +
      4 * 10 ^ 7 * (Bc + 2) ^ 2 + 30) ≤
      ∑ j ∈ range bs.length, (recL bs j + 6) * uC Φm Bx Bc := by
    apply Finset.sum_le_sum
    intro j _
    simp only [uC]; nlinarith
  have e1 : (∑ j ∈ range bs.length, (recL bs j + 6) + 1) * uC Φm Bx Bc =
      ∑ j ∈ range bs.length, (recL bs j + 6) * uC Φm Bx Bc + uC Φm Bx Bc := by
    rw [add_mul, Finset.sum_mul, one_mul]
  rw [e1]
  have : 2 * 10 ^ 7 * (Bc + 2) ^ 2 + 32 ≤ uC Φm Bx Bc := by simp only [uC]; nlinarith
  omega

end bwd

end J6Seg.JK

end

