  obtain ⟨hc1, -⟩ := h𝒯.1 k Cb⁻¹ xk.level.2.2
  have hcurve' : (𝒯.act Cb⁻¹ xk.level.2.2).curve = xet.curve.map ψet.toRingHom := by
    rw [hc1, hpkc, E1']
  have hΔ' : IsUnit (𝒯.act Cb⁻¹ xk.level.2.2).curve.Δ := by rw [hcurve']; exact hΔk
  have hact1 := glue_act_one 𝒢 h𝒢O q 𝒯 h𝒯 Cb⁻¹ xk.level.2.2 hΔpk hΔ'
  have hPone : (𝒯.act Cb⁻¹ xk.level.2.2).P =
      (𝒢 k (𝒯.act Cb⁻¹ xk.level.2.2).curve hΔ').one (𝟙 (base (T := k))) := hact1.1 hPk
  have hQne : (𝒯.act Cb⁻¹ xk.level.2.2).Q ≠
