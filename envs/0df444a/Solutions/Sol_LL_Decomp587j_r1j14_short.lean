    rw [← hadj, sumUpTo_eq_finset_sum, Finset.sum_div]
    apply Finset.sum_le_sum; intro i _
    have hstep_eq : ((A0_num + (i + 1) * h0 : ℕ) : ℝ) / D_out = ((A0_num + i * h0 + h0 : ℕ) : ℝ) / D_out := by
      congr 1; exact_mod_cast (by ring : A0_num + (i + 1) * h0 = A0_num + i * h0 + h0)
    rw [hstep_eq]
    exact wInv_bound_den (D := D_out) (by unfold D_out; omega) (by unfold A0_num; omega) (Nat.le_add_right _ _)
  have hmul := mul_le_mul_of_nonneg_left hI0 (div_nonneg (Nat.cast_nonneg F_tail_val) (le_of_lt hSpos))
  refine le_trans hmono (le_trans hmul ?_)
  have heq_t : ((F_tail_val : ℝ) / S_scale) *
      ((sumUpTo 32 (fun i => wInv (A0_num + i * h0) (A0_num + i * h0 + h0)) : ℝ) / W_scale) =
      (outerTailSum : ℝ) / ((S_scale : ℝ) * W_scale) := by
    unfold outerTailSum; dsimp only [h0]; rw [Nat.cast_mul]; ring
  rw [heq_t]
  have hcert_r : (outerTailSum : ℝ) ≤ (targetBoundNat : ℝ) := by exact_mod_cast checkOuter_tail
  set ts : ℝ := (outerTailSum : ℝ)
  rw [div_le_div_iff₀ (mul_pos hSpos hWpos) (by norm_num)]
  unfold targetBoundNat W_scale at hcert_r
  unfold S_scale W_scale
  push_cast at hcert_r ⊢
  linarith

end

