theorem Formalism.HC.Frame.thick_part_two {L : ℕ} (T : Finset ℕ) (hT : ∀ s ∈ T, 4 * L * s < φ.n0)
    (u₀ t x : φ.A) (hord : addOrderOf (φ.h x) ≤ 4 * L) :
    {y : φ.A | (∃ i : ℤ, y = t + i • x) ∧ φ.InTranslate T u₀ y}.ncard ≤ 1 := by sorry
