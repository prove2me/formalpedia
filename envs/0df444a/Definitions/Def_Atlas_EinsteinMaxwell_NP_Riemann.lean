namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

/-! ### Definitions -/

/-- `R^a_{bcd}`, read off II's matrix curvature of `connMat (christoffel g gi)`. -/
noncomputable def riem (g gi : Metric n) (a b c d : Fin n) (x : Pt n) : ℝ :=
  curv (connMat (christoffel g gi)) c d x a b

/-- `R_{abcd} = Σ_e g_{ae} R^e_{bcd}`. -/
noncomputable def riemLow (g gi : Metric n) (a b c d : Fin n) (x : Pt n) : ℝ :=
  ∑ e, g a e x * riem g gi e b c d x

/-- Weyl tensor (4D), all indices down, built from `riemLow`, IV's `ricciOf` and `ricciScalar`. -/
noncomputable def weyl (g gi : Metric 4) (a b c d : Fin 4) (x : Pt 4) : ℝ :=
  riemLow g gi a b c d x
    - (g a c x * ricciOf g gi b d x - g a d x * ricciOf g gi b c x
        - g b c x * ricciOf g gi a d x + g b d x * ricciOf g gi a c x) / 2
    + ricciScalar g gi x * (g a c x * g b d x - g a d x * g b c x) / 6

/-- Proof-internal notation: second coordinate derivatives of the metric, `∂_i ∂_j g_{kl}`. -/
noncomputable def hessG (g : Metric n) (i j k l : Fin n) (y : Pt n) : ℝ := pd i (pd j (g k l)) y

/-- Proof-internal notation: the quadratic part `Σ_{e f} g^{ef} (Γ_{e,da} Γ_{f,cb} − Γ_{e,ca} Γ_{f,db})`. -/
noncomputable def quadQ (g gi : Metric n) (a b c d : Fin n) (y : Pt n) : ℝ :=
  ∑ e, ∑ f, gi e f y * (chr1 g e d a y * chr1 g f c b y - chr1 g e c a y * chr1 g f d b y)

/-- The metric with reversed sign (signature `(+,−,−,−)` from `(−,+,+,+)`). -/
def negMetric (g : Metric n) : Metric n := fun i j x => -g i j x

