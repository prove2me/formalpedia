theorem ThreeSum.SharedReportingBankResourceBounds.wanted_selected_ends : ∀ {pair bank cover srcB srcC NB NC g h J cut occ i j code stop : Nat}
  (hg : @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) g)
  (hi : @LT.lt.{0} Nat instLTNat i (ThreeSum.BandPartition.size NB g))
  (hj : @LT.lt.{0} Nat instLTNat j (ThreeSum.BandPartition.size NC g))
  (hk : @LT.lt.{0} Nat instLTNat code (ThreeSum.LightBlockSourceCatalog.count h J))
  (hsrcB : @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) srcB NB) stop)
  (hsrcC : @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) srcC NC) stop)
  (hpair :
    @LE.le.{0} Nat instLENat (ThreeSum.SourceBandPairData.next pair NB NC g (ThreeSum.BlockSourceEncoding.modulus h J))
      stop)
  (hbank : @LE.le.{0} Nat instLENat (ThreeSum.SourceBandBankData.finish bank NB NC g h J cut) stop)
  (hocc :
    @LE.le.{0} Nat instLENat
      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) occ
        (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat) (ThreeSum.LightBlockSourceCatalog.count h J)
          J))
      bank)
  (hcover : @LE.le.{0} Nat instLENat (ThreeSum.LightCoverKeyData.keyEnd cover h J) stop),
  ThreeSum.SharedReportingBankResourceBounds.WantedSourceEnds
    (ThreeSum.ReportingHostSourceSelectionStored.retained pair bank cover NB NC g h J cut occ i j code) pair bank cover
    srcB srcC i j code h J cut stop := by
