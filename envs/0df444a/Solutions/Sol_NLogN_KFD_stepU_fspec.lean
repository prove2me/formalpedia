variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

theorem stepG_fspec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k d : ℕ) (neg : Bool) (hk : 1 ≤ k) (hkQ : k ≤ Q)
    (hd : 1 ≤ d) (hdQ : d ≤ Q) (hQk : Nat.Coprime Q k) (hQd : Nat.Coprime Q d)
    (t : IState HS) (xs : List ℤ) (w Bb : ℕ) (R : List Item)
    (hlen : xs.length = vol sh) (hb : Bnd w xs) (hB1 : 1 ≤ vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ vol A) (hV : zsz ((vol A * (Q * vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R)
    (pa pc : Ex HS) (stg : List (Ex HS × Ex HS)) (ac : List (ℕ × ℕ))
    (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : vol (ac.map Prod.fst) = vol A) (htbl : NLogN.KIL.tbl Q ac = NLogN.KIL.tbl Q (A.zip (csOf Λ c A)))
    {LN LQ : List Item} (hNQ : t.G sNQ = .int (-(Q : ℤ)) :: LN)
    (hQQ : t.G sQQ = .int (Q : ℤ) :: LQ)
    (hpa : pa.eval t = (vol A : ℤ)) (hpc : pc.eval t = (vol C : ℤ))
    (hsA : stg.map (·.1.eval t) = ac.map fun p => (p.1 : ℤ))
    (hsC : stg.map (·.2.eval t) = ac.map fun p => (p.2 : ℤ))
    (hok : PushOK t Bb (prmL pa pc ++ stgPush stg)) :
    FSp (stepG k d neg pa pc stg) t (t.upd 0 (ints (shiftArr Λ i (fracU Q k d neg) c 0 xs) ++ R))
      (cStepGF k d stg.length (vol A * (Q * vol C)) w Bb pa pc stg) := by
  have S1 := FSp.of_sp (Sp.pushes Bb _ t hok)
  -- the pushed values
  have eQ : (Ex.reg sQQ : Ex HS).eval t = (Q : ℤ) := by
    simp only [Ex.eval]; rw [IState.top_eq hQQ]
  set P0 : List (Fin HS × ℤ) := [(sPA, (vol A : ℤ)), (sPC, (vol C : ℤ)),
    (sVV, ((vol A * (Q * vol C) : ℕ) : ℤ)), (sQB, ((Q * vol C : ℕ) : ℤ))] with hP0
  have eP : evalP t (prmL pa pc) = P0 := by
    have eQ' : t.top sQQ = (Q : ℤ) := IState.top_eq hQQ
    simp only [evalP, prmL, List.map_cons, List.map_nil, Ex.eval, hpa, hpc, eQ', hP0]
    push_cast; rfl
  have eL : (prmL pa pc ++ stgPush stg).map (fun p => (p.1, p.2.eval t)) =
      P0 ++ evalP t (stgPush stg) := by
    rw [← eP, ← evalP_append]; rfl
  rw [eL, pushSt_append] at S1
  set T0 := pushSt t P0 with hT0
  set E := evalP t (stgPush stg) with hE
  set T1 := pushSt T0 E with hT1
  have hP0f : P0.map Prod.fst = [sPA, sPC, sVV, sQB] := rfl
  have nmE : ∀ r : Fin HS, r ∉ [sSA, sSC, sSM, sSAM] → T1.G r = T0.G r := fun r hr =>
    pushSt_G_of_not_mem T0 r E (by
      rw [hE, evalP_fst]; intro hm
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hm
      rcases stgPush_fst stg p hp with h | h | h | h <;> simp [h] at hr)
  have nm0 : ∀ r : Fin HS, r ∉ [sPA, sPC, sVV, sQB] → T0.G r = t.G r := fun r hr =>
    pushSt_G_of_not_mem t r P0 (by rw [hP0f]; exact hr)
  have hS : StgOK T1 Q ac (T0.G sSA) (T0.G sSC) (T0.G sSM) (T0.G sSAM) :=
    stgOK_of_pushSt T0 Q E ac (by rw [hE, filterA_stg, hsA]) (by rw [hE, filterC_stg, hsC])
      (filterM_stg t stg ac hsA) (filterAM_stg t stg ac hsA)
  have g0 : T1.G 0 = ints xs ++ R := by
    rw [nmE 0 (by simp (config := {decide := true})), nm0 0 (by simp (config := {decide := true})), h0]
  have gNQ : T1.G sNQ = .int (-(Q : ℤ)) :: LN := by
    rw [nmE _ (by simp (config := {decide := true})), nm0 _ (by simp (config := {decide := true})), hNQ]
  have T0G : ∀ r : Fin HS, T0.G r = ints ((P0.filter (fun p => p.1 = r)).map Prod.snd).reverse
      ++ t.G r := fun r => pushSt_G t r P0
  have hp : StP T1 (vol A) Q (vol C) := by
    refine ⟨⟨LQ, ?_⟩, ⟨t.G sPC, ?_⟩, ⟨t.G sPA, ?_⟩, ⟨t.G sVV, ?_⟩, ⟨t.G sQB, ?_⟩⟩
    · rw [nmE _ (by simp (config := {decide := true})), nm0 _ (by simp (config := {decide := true})), hQQ]
    · rw [nmE _ (by simp (config := {decide := true})), T0G, hP0]
      simp (config := {decide := true}) [ints]
    · rw [nmE _ (by simp (config := {decide := true})), T0G, hP0]
      simp (config := {decide := true}) [ints]
    · rw [nmE _ (by simp (config := {decide := true})), T0G, hP0]
      simp (config := {decide := true}) [ints]
    · rw [nmE _ (by simp (config := {decide := true})), T0G, hP0]
      simp (config := {decide := true}) [ints]
  have hlenS : (stg.map (·.1.eval t)).length = ac.length := by
    rw [hsA, List.length_map]
  have hlS : stg.length = ac.length := by simpa using hlenS
  have S2 := shFracU_fspec Λ i c hc A C hsh hA k d neg hk hkQ hd hdQ hQk hQd T1 xs w Bb R hlen hb
    hB1 hQ1 hP1 hV hQ2 g0 ac hac hvol htbl hS gNQ hp
  set ys := shiftArr Λ i (fracU Q k d neg) c 0 xs
  have ePost : postSt T1 ys R (T0.G sSA) (T0.G sSC) (T0.G sSM) (T0.G sSAM) =
      pushSt (t.upd 0 (ints ys ++ R)) P0 := by
    rw [pushSt_upd_comm _ _ _ _ (by rw [hP0f]; simp (config := {decide := true}))]
    refine IState.ext' (fun x => ?_) ?_ ?_
    · simp only [postSt, IState.upd_G]
      by_cases h1 : x = sSAM
      · subst h1; simp (config := {decide := true}) [hT0]
      by_cases h2 : x = sSM
      · subst h2; simp (config := {decide := true}) [hT0]
      by_cases h3 : x = sSC
      · subst h3; simp (config := {decide := true}) [hT0]
      by_cases h4 : x = sSA
      · subst h4; simp (config := {decide := true}) [hT0]
      simp only [h1, h2, h3, h4, if_false]
      rw [nmE x (by simp [h1, h2, h3, h4])]
    · simp [postSt, hT1, hT0]
    · simp [postSt, hT1, hT0]
  rw [← hlS, ePost] at S2
  have hle : ∀ m : ℕ, m ≤ vol A * (Q * vol C) → zsz (m : ℤ) ≤ Bb :=
    fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have S3 := FSp.of_sp <| Sp.popsR Bb P0 (t.upd 0 (ints ys ++ R)) (by
    intro p hp
    simp only [hP0, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact ⟨by simp (config := {decide := true}), hle _ (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))⟩
    · exact ⟨by simp (config := {decide := true}), hle _ (le_trans (Nat.le_mul_of_pos_left _ (by omega))
        (Nat.le_mul_of_pos_left _ hP1))⟩
    · exact ⟨by simp (config := {decide := true}), hle _ le_rfl⟩
    · exact ⟨by simp (config := {decide := true}), hle _ (Nat.le_mul_of_pos_left _ hP1)⟩)
  rw [hP0f] at S3
  refine (S1.seq (S2.seq S3)).mono (le_of_eq ?_)
  simp only [cStepGF, hlS, hP0, List.length_cons, List.length_nil]
  ring

