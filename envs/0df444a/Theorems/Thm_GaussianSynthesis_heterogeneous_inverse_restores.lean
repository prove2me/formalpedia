theorem GaussianSynthesis.heterogeneous_inverse_restores (x y : Fraction) :
    SameValue (packedLeft (rawCInverse (rawAlignedC x y))) x ∧
    SameValue (packedRight (rawCInverse (rawAlignedC x y))) y := by sorry
