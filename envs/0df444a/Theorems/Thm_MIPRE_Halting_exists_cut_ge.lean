variable (G : GapCompression) (U : UniversalMachine) (UT : ClockedUniversalMachine)

theorem MIPRE.Halting.exists_cut_ge : ∃ K, ∀ lam : ℕ,
    G.bound.eval (C G + lam) ≤ 2 ^ (K + G.bound.natDegree * esize lam) := by sorry
