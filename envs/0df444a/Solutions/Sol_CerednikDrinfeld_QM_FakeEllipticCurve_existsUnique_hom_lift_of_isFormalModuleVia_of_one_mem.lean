theorem CerednikDrinfeld.FormalODModule.Hom.eq_of_comp_act_pow_eq_of_hasHeight
    {q : ℕ} [Fact q.Prime] {B : Type} [CommRing B] [IsNoetherianRing B]
    {X X' : FormalODModule q B} (hX4 : X.HasHeight 4) (k : ℕ) (ψ ψ' : FormalODModule.Hom X X')
    (h : ψ.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ k)) = ψ'.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ k))) :
    ψ = ψ' := by
  have hq0 : ∀ i, MvPowerSeries.constantCoeff (X.act ((q : ℕ) : Zp2 q) i) = 0 := (X.isLawHom_act _).1
  have hk1 : FormalODModule.HasKernelOfDegree (X.act (((q : ℕ) : Zp2 q) ^ 1)) (q ^ 4) := by
    rw [pow_one]; exact hX4

  have cancel : ∀ χ χ' : FormalODModule.Hom X X',
      χ.toSeries.comp (X.act ((q : ℕ) : Zp2 q)) = χ'.toSeries.comp (X.act ((q : ℕ) : Zp2 q)) → χ = χ' := by
    intro χ χ' hχ
    refine CerednikDrinfeld.FormalODModule.Hom.eq_of_comp_act_pow_eq_of_hasKernelOfDegree 1 (q ^ 4) hk1 χ χ' ?_
    rw [pow_one]; exact hχ
  induction k generalizing ψ ψ' with
  | zero =>
      apply FormalODModule.Hom.ext
      have h1 : X.act (((q : ℕ) : Zp2 q) ^ 0) = Series.id B := by rw [pow_zero, X.act_one]
      rwa [h1, Series.comp_id, Series.comp_id] at h
  | succ k ih =>

      have hk : (ψ.comp ⟨X.act (((q : ℕ) : Zp2 q) ^ k), FormalODModule.IsODHom.act_natCast_pow X k⟩) =
          (ψ'.comp ⟨X.act (((q : ℕ) : Zp2 q) ^ k), FormalODModule.IsODHom.act_natCast_pow X k⟩) := by
        apply cancel
        show (ψ.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ k))).comp (X.act ((q : ℕ) : Zp2 q)) =
          (ψ'.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ k))).comp (X.act ((q : ℕ) : Zp2 q))
        rw [Series.comp_assoc _ _ _ (X.isLawHom_act _).1 hq0, Series.comp_assoc _ _ _ (X.isLawHom_act _).1 hq0,
          ← X.act_mul, ← pow_succ]
        exact h
      exact ih ψ ψ' (congrArg FormalODModule.Hom.toSeries hk)

