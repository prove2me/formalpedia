      (readCfg (q := q) (x := x) (σ.stk q) σ 1 (I.getD σ.ip codeEnd :: σ.stk x) (σ.ip + 1)) 1 := by
    refine Reaches.step' (by simp [St.top_eq, hlt]) ?_ (Reaches.refl _)
    simp [mstep, St.tops, St.top_eq, readδ, runOps, Op.run, readCfg, St.inRd_eq, St.push_eq_set,
      St.pop_eq_set, hqx, hqx', St.set, St.setIp, St.adv]
    funext j; simp only [Function.update_apply]; split_ifs <;> simp_all
  have hfin : ∃ m, Reaches I q [x] (readδ q x stop) (σ.push q 0)
      (readCfg (q := q) (x := x) (σ.stk q) σ hlt (W.reverse ++ σ.stk x) (σ.ip + W.length + 1)) m ∧
      m ≤ W.length + 2 := by
    rcases W with _ | ⟨w, W⟩
    · refine ⟨1 + 1, h0.trans ?_, by simp⟩
      simp only [List.length_nil, add_zero] at hstop
      rw [hstop]
      refine Reaches.step' (by simp [readCfg, hlt]) ?_ (Reaches.refl _)
      simp [mstep, St.tops, readCfg, St.top_set, hqx', readδ, runOps, Op.run, St.pop_set_ne, hqx]
    · have hw0 := hk 0 (by simp)
      simp only [add_zero, List.getElem_cons_zero] at hw0
      rw [hw0] at h0
      have := read_reaches (I := I) hqx stop (σ.stk q) σ W w (σ.stk x) (σ.ip + 1)
        (fun h => hW (h ▸ List.mem_cons_self ..)) (fun h => hW (List.mem_cons_of_mem _ h))
        (fun k hk' => by
          have := hk (k + 1) (by simp; omega); simpa [add_assoc, add_comm 1] using this)
        (by simpa [add_assoc, add_comm 1] using hstop)
      refine ⟨1 + (W.length + 2), h0.trans ?_, by simp; omega⟩
      simpa [add_assoc, add_comm 1, add_left_comm] using this
  obtain ⟨m, hR, hm⟩ := hfin
  have := Runs.machine_reach (prog := prog) 3 (readδ_length q x stop) σ _ m hR
    (by simp [readCfg])
  have e : (readCfg (q := q) (x := x) (σ.stk q) σ hlt (W.reverse ++ σ.stk x)
      (σ.ip + W.length + 1)).pop q = (σ.set x (W.reverse ++ σ.stk x)).setIp (σ.ip + W.length + 1) := by
    simp only [readCfg, St.pop_set_same, List.tail_cons]
    apply St.ext_iff'.mpr
    refine ⟨fun j => ?_, rfl, rfl⟩
    simp only [St.set_stk, St.setIp_stk]; split_ifs <;> simp_all
  rw [e] at this
  refine this.mono ?_
  simp only [readCost, List.length_singleton]
  nlinarith

end read

