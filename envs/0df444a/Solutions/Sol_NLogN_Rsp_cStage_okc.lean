theorem ex_eval_congr {σ σ' : IState HS} :
    ∀ e : Ex HS, (∀ i ∈ e.regs, σ.G i = σ'.G i) → e.eval σ = e.eval σ'
  | .reg i, h => by simp only [Ex.eval, IState.top, h i (by simp [Ex.regs])]
  | .lit _, _ => rfl
  | .add a b, h | .mul a b, h | .shl a b, h | .quo a b, h | .rem a b, h | .ndiv a b, h
  | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.eval, ex_eval_congr a (fun i hi => h i (Or.inl hi)),
      ex_eval_congr b (fun i hi => h i (Or.inr hi))]
  | .neg a, h | .pow2 a, h => by
    simp only [Ex.regs] at h; simp only [Ex.eval, ex_eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.eval, ex_eval_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
      ex_eval_congr x (fun i hi => h i (Or.inl (Or.inr hi))),
      ex_eval_congr y (fun i hi => h i (Or.inr hi))]

theorem ex_ok_congr {σ σ' : IState HS} :
    ∀ e : Ex HS, (∀ i ∈ e.regs, σ.G i = σ'.G i) → (e.ok σ ↔ e.ok σ')
  | .reg i, h => by simp only [Ex.ok, IState.IsInt, IState.top, h i (by simp [Ex.regs])]
  | .lit _, _ => Iff.rfl
  | .add a b, h | .mul a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ex_ok_congr a (fun i hi => h i (Or.inl hi)),
      ex_ok_congr b (fun i hi => h i (Or.inr hi))]
  | .shl a b, h | .quo a b, h | .rem a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ex_ok_congr a (fun i hi => h i (Or.inl hi)),
      ex_ok_congr b (fun i hi => h i (Or.inr hi)), ex_eval_congr b (fun i hi => h i (Or.inr hi))]
  | .ndiv a b, h | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ex_ok_congr a (fun i hi => h i (Or.inl hi)),
      ex_ok_congr b (fun i hi => h i (Or.inr hi)), ex_eval_congr a (fun i hi => h i (Or.inl hi)),
      ex_eval_congr b (fun i hi => h i (Or.inr hi))]
  | .neg a, h => by simp only [Ex.regs] at h; simp only [Ex.ok, ex_ok_congr a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h; simp only [Ex.ok, ex_ok_congr a h, ex_eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ex_ok_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
      ex_ok_congr x (fun i hi => h i (Or.inl (Or.inr hi))),
      ex_ok_congr y (fun i hi => h i (Or.inr hi)),
      ex_eval_congr c (fun i hi => h i (Or.inl (Or.inl hi)))]

theorem ex_cost_congr {σ σ' : IState HS} :
    ∀ e : Ex HS, (∀ i ∈ e.regs, σ.G i = σ'.G i) → e.cost σ = e.cost σ'
  | .reg i, h => by simp only [Ex.cost, IState.top, h i (by simp [Ex.regs])]
  | .lit _, _ => rfl
