import Mathlib
import Definitions.Def_Tropical_TropicalConvexity_Caratheodory

/-!
# Finite max-plus tropical convexity

This file develops normalized max-plus combinations and proves a finite tropical
Carathéodory theorem.  In `Fin d → ℝ`, every point generated by finitely many
points is generated by a subset of at most `d + 1` of them.
-/

open Finset Set

open TropicalConvexity

variable {d : ℕ}









open TropicalConvexity in
theorem solution(S : Set (Fin d → ℝ)) (z : Fin d → ℝ)
    (hz : z ∈ tropicalConvexHull S) :
    ∃ T : Finset (Fin d → ℝ), (T : Set (Fin d → ℝ)) ⊆ S ∧
      T.card ≤ d + 1 ∧ z ∈ tropicalConvexHull (T : Set (Fin d → ℝ)) := by
  rw [tropicalConvexHull] at hz
  obtain ⟨m, p, hp, hz⟩ := hz
  obtain ⟨hm, w, hw_bound, ⟨j₀, hw₀⟩, hz_eq⟩ := hz
  -- For each coordinate i, pick an index achieving the supremum
  have h0 : Fin m := ⟨0, hm⟩
  have h_nonempty : Finset.univ.Nonempty := ⟨h0, Finset.mem_univ _⟩
  have h_exists_argmax : ∀ i : Fin d, ∃ j : Fin m, w j + p j i = Finset.univ.sup' h_nonempty (fun j => w j + p j i) := by
    intro i
    obtain ⟨j, _, hj⟩ := Finset.exists_max_image Finset.univ (fun j => w j + p j i) h_nonempty
    refine ⟨j, ?_⟩
    apply le_antisymm
    · exact Finset.le_sup' (fun j : Fin m => w j + p j i) (Finset.mem_univ j)
    · exact Finset.sup'_le _ _ hj
  -- Define a choice function for argmax
  choose argmax hargmax using h_exists_argmax
  -- Construct T: image of argmax plus p j₀
  let T : Finset (Fin d → ℝ) := (Finset.univ.image fun i => p (argmax i)) ∪ ({p j₀} : Finset (Fin d → ℝ))
  use T
  refine ⟨?_, ?_, ?_⟩
  · -- T ⊆ S
    intro x hx
    simp only [T] at hx
    have : x ∈ (Finset.univ.image fun i => p (argmax i)) ∪ {p j₀} := hx
    rcases Finset.mem_union.mp this with hx | hx
    · rcases Finset.mem_image.mp hx with ⟨i, _, hi⟩
      rw [← hi]
      exact hp _
    · rw [Finset.mem_singleton.mp hx]
      exact hp _
  · -- #T ≤ d + 1
    have h1 : T.card ≤ (Finset.univ.image fun i => p (argmax i)).card + ({p j₀} : Finset (Fin d → ℝ)).card := Finset.card_union_le _ _
    have h2 : (Finset.univ.image fun i => p (argmax i)).card ≤ Finset.card Finset.univ := Finset.card_image_le
    have h3 : ({p j₀} : Finset (Fin d → ℝ)).card = 1 := Finset.card_singleton _
    simp only [Finset.card_fin] at *
    omega
  · -- z ∈ tropicalConvexHull T
    -- Define the new generator function and weights
    let q : Fin (d + 1) → Fin d → ℝ := fun i => if hi : i.val < d then p (argmax ⟨i.val, hi⟩) else p j₀
    let v : Fin (d + 1) → ℝ := fun i => if hi : i.val < d then w (argmax ⟨i.val, hi⟩) else w j₀
    have hv_nonpos : ∀ i, v i ≤ 0 := by
      intro i
      simp only [v]
      split_ifs with hi
      · exact hw_bound _
      · rw [hw₀]
    have hv_zero : ∃ i, v i = 0 := ⟨⟨d, by omega⟩, by simp [v, hw₀]⟩
    refine ⟨d + 1, q, ?_, ⟨by omega, v, hv_nonpos, hv_zero, ?_⟩⟩
    · -- All generators are in T
      intro i
      simp only [q, T]
      split_ifs with hi
      · let i' : Fin d := ⟨i.val, hi⟩
        have h : p (argmax i') ∈ Finset.image (fun i => p (argmax i)) Finset.univ := by
          apply Finset.mem_image.mpr
          exact ⟨i', Finset.mem_univ _, rfl⟩
        rw [Finset.mem_coe]
        exact Finset.mem_union_left _ h
      · rw [Finset.mem_coe, Finset.mem_union, Finset.mem_singleton]; exact Or.inr rfl
    · -- z i = sup_j (v j + q j i)
      intro i
      rw [hz_eq i]
      have h_nonempty_1 : (Finset.univ : Finset (Fin (d + 1))).Nonempty := ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
      apply le_antisymm
      · -- sup' (w k + p k i) ≤ sup' (v j + q j i)
        have h_argmax_in_range : (⟨i.val, by omega⟩ : Fin (d + 1)) ∈ Finset.univ := Finset.mem_univ _
        calc (Finset.univ : Finset (Fin m)).sup' h_nonempty (fun k => w k + p k i)
            = w (argmax i) + p (argmax i) i := (hargmax i).symm
          _ = v ⟨i.val, by omega⟩ + q ⟨i.val, by omega⟩ i := by
              simp only [v, q]
              have hi : (i : ℕ) < d := i.2
              simp [hi]
          _ ≤ (Finset.univ : Finset (Fin (d + 1))).sup' h_nonempty_1 (fun j => v j + q j i) :=
              Finset.le_sup' (fun j => v j + q j i) h_argmax_in_range
      · -- sup' (v j + q j i) ≤ sup' (w k + p k i)
        apply Finset.sup'_le
        intro j _
        simp only [v, q]
        by_cases hj : (j : ℕ) < d
        · -- j < d case: v j + q j i = w (argmax j) + p (argmax j) i ≤ sup' (w k + p k i)
          have hj' : j.val < d := hj
          simp only [hj', ↓reduceDIte]
          exact Finset.le_sup' (fun k => w k + p k i) (Finset.mem_univ _)
        · -- j = d case: v j + q j i = w j₀ + p j₀ i ≤ sup' (w k + p k i)
          simp only [hj, ↓reduceDIte, hw₀, zero_add]
          have := Finset.le_sup' (fun k => w k + p k i) (Finset.mem_univ j₀)
          linarith [hw₀]
