        η L₂ ((frobTwist Onr Fr (-(j₂ : ℤ)) (φ₂.comp ψ) : Onr →ₐ[𝒪] L₂) : Onr →+* L₂) hLr₂ t₂⟩ :
        ModuliPackage.GPoint 𝒪 M L₂).map m₂ := by
  classical
  have hL₁ : IsNilpotent (algebraMap 𝒪 L₁ π) := isNilpotent_algebraMap_of_algHom π φ₁ hBπ
  have hL₂ : IsNilpotent (algebraMap 𝒪 L₂ π) := isNilpotent_algebraMap_of_algHom π φ₂ hBπ
