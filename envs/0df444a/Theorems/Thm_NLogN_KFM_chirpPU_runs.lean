    (st : IState HS) (LR L1 LXa RD : List Item) (hR : st.G pR = .int (2 ^ Δ) :: LR)
    (hD : st.G rDl = .int (Δ : ℤ) :: L1) (hX : st.G aX = .int (L.length : ℤ) :: LXa)
    (hdS : st.G NLogN.KFM.dS = ints (descA 1 L) ++ RD) :
