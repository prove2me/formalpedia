open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
theorem solution {j Aq : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) :
    HasDerivAt (bext j q) (MbFun j q) 3 := by
  have hdiff : DifferentiableOn ℝ (bfun j q) (Ioi 3) :=
    (contDiffOn_two_bfun (j := j) hqc).differentiableOn (by norm_num)
  have hcont : ContinuousWithinAt (bfun j q) (Ioi 3) 3 :=
    tendsto_bfun_three (j := j) hqc hq hAq
  have hright : HasDerivWithinAt (bfun j q) (MbFun j q) (Ici 3) 3 :=
    hasDerivWithinAt_Ici_of_tendsto_deriv hdiff hcont self_mem_nhdsWithin
      (tendsto_deriv_bfun_three (j := j) hqc hq hAq)
  have hright' : HasDerivWithinAt (bext j q) (MbFun j q) (Ici 3) 3 := by
    refine hright.congr ?_ ?_
    · intro x hx
      rcases eq_or_lt_of_le (show (3:ℝ) ≤ x from hx) with h3 | h3
      · rw [← h3, bext_three]
      · exact bext_eq_gt h3
    · rw [bext_three]
  have hleft : HasDerivWithinAt (bext j q) (MbFun j q) (Iic 3) 3 := by
    have haff : HasDerivWithinAt (fun R : ℝ => bfun j q 3 + MbFun j q * (R - 3)) (MbFun j q)
        (Iic 3) 3 := (hasDerivAt_affine j q 3).hasDerivWithinAt
    refine haff.congr ?_ ?_
    · intro x hx
      exact bext_eq_le hx
    · exact bext_eq_le le_rfl
  have hunion : HasDerivWithinAt (bext j q) (MbFun j q) (Iic 3 ∪ Ici 3) 3 := hleft.union hright'
  rw [Iic_union_Ici] at hunion
  exact hasDerivWithinAt_univ.mp hunion
