-- title:
--   Lemma 6.2 — ε-optimal stationary strategies with bounded patience
-- statement:
--   Consider a game $G$ with a reward function $r$ (values in $[0,1]$) and a discount factor $\lambda\in[0,1)$. Let $\varepsilon\in(0,1]$, $m=\max(|A|,|B|)$ and
--   $$p_{\min}=\frac{(1-\lambda)\varepsilon}{2m}.$$
--   Then there exist $\varepsilon$-optimal stationary strategies $\sigma$ and $\tau$ for $\mathrm{Disc}(r,\lambda)$ such that all their nonzero probabilities are at least $p_{\min}$. In particular, their patience is at most $1/p_{\min}$.
--
--   Bounded patience bounds the exponents of the power-series representation of the strategies.
--
--   Differences from the source:
--   - encoding: a finite game G = (S, A, B, δ) with |S| = n and at most m actions per player → states Fin n, actions Fin mA and Fin mB with n, mA, mB ≥ 1, m = max(mA, mB), distributions as nonnegative real vectors summing to one; reason: relabelling of finite sets; nonempty state and action sets are the source game convention
--   - encoding: the probability measure on valid plays Ω_s generated by finite histories, strategies on valid histories → the Ionescu-Tulcea trajectory measure on all sequences in (S × A × B)^ℕ; strategies are defined on all finite stage lists; reason: invalid plays have probability zero and values of strategies on invalid histories never matter, so every expectation and value is unchanged
-- source:
--   Ali Asadi, Krishnendu Chatterjee, The Computational Complexity of Concurrent Stochastic Games: Exact Value and Approximation, STOC 2027 submission #285 (October 2026), SHA-256 5cff187cf6b230b3bdfe540f2832f824d1ddb6acb43239fbf469d37c43b0d461, https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/285.pdf, Lemma 6.2, printed p. 19 (PDF p. 21)

import Mathlib
import Definitions.Def_ConcurrentStochasticApprox_Approx_Game
import Definitions.Def_ConcurrentStochasticApprox_Approx_PowerSeries
open Finset

namespace ConcurrentStochasticApprox.Approx

/-- **Lemma 6.2 (Bounded patience).** For a game `G` with reward function `r` and discount factor
`λ ∈ [0,1)`, let `ε ∈ (0,1]` and `p_min = (1 - λ) ε / (2m)` with `m = max(|A|, |B|)`. Then there
exist `ε`-optimal stationary strategies `σ, τ` all of whose nonzero probabilities are at least
`p_min`; in particular their patience is at most `1 / p_min`. -/
theorem lemma_6_2 {n mA mB : ℕ} (G : CSG n mA mB) (r : Reward n mA mB) (hr : IsReward r)
    (lam : ℝ) (hlam0 : 0 ≤ lam) (hlam1 : lam < 1) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    ∃ (σ : Stationary₁ n mA) (τ : Stationary₂ n mB),
      IsEpsOptimal₁ G (discObj r lam) ε (σ.toStrategy mB) ∧
      IsEpsOptimal₂ G (discObj r lam) ε (τ.toStrategy mA) ∧
      (∀ s a, (σ s).1 a ≠ 0 → (1 - lam) * ε / (2 * (max mA mB : ℕ)) ≤ (σ s).1 a) ∧
      (∀ s b, (τ s).1 b ≠ 0 → (1 - lam) * ε / (2 * (max mA mB : ℕ)) ≤ (τ s).1 b) ∧
      patienceStat σ ≤ 1 / ((1 - lam) * ε / (2 * (max mA mB : ℕ))) ∧
      patienceStat τ ≤ 1 / ((1 - lam) * ε / (2 * (max mA mB : ℕ))) := by sorry

end ConcurrentStochasticApprox.Approx
