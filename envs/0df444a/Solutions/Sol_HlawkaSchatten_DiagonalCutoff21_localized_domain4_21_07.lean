    (∀ i, lpNorm p (X i) ≤ (298190083/250000000 : ℝ)) ∧ coordinateBox (4473/10000 : ℝ) (553/500 : ℝ) (61/80 : ℝ) (11837/10000 : ℝ) X ∧
    (∀ i j k : Fin 3, i ≠ j → i ≠ k → j ≠ k →
