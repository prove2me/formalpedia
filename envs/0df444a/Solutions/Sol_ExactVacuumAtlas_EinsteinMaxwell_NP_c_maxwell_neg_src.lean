theorem cL_eq_omL (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (C A B : Fin 4) :
    cL E Θ C A B x = omL g gi E Θ C A B x - omL g gi E Θ C B A x := by
