theorem WeierstrassCurve.isDomain_rationalEndSubring
    {k : Type*} [Field k] [IsAlgClosed k] [DecidableEq k]
    (X : WeierstrassCurve k) [X.IsElliptic] :
    IsDomain ↥(WeierstrassCurve.rationalEndSubring k X) := by sorry
