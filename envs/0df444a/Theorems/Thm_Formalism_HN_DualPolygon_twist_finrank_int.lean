theorem Formalism.HN.DualPolygon.twist_finrank_int [StarRing K] (X : Submodule (𝓞 K) W) (hX : X.FG) :
    finrank ℤ X = finrank ℚ K * finrank K (Submodule.span K (X : Set W)) := by sorry
