theorem NLogN.KIL.desc4_sp (s : IState HS) (F : Fin HS → List ℤ) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    {W K R : ℕ} (hW : 1 ≤ W) (v : Fin HS → ℕ) (hv : ∀ i ∈ regD, v i ≤ M)
    (vK : v aK = K) (vR : v aQR = R) (hF23 : F 23 = []) (hWK : W ^ K ≤ R) (hRM : 2 * R ≤ M)
    (hWM : W ≤ M) :
    ∃ v', (∀ i, i ∉ [aWK, aRp] → v' i = v i) ∧ v' aWK = W ^ K ∧ v' aRp = padRows W K R ∧
      Sp (desc4 W) (encK s (regState F v regD)) (encK s (regState F v' regD))
