open J6Seg J6Seg.Slab
set_option maxRecDepth 20000
open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
variable {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

theorem J6Seg.Slab.branch_runs (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) (op a : ℤ) (C CU OP ARG ACC : List ℤ)
    (inp tmp : List U) (hlen : op ≠ 0 → m ≤ inp.length) (hok : ∀ u ∈ inp, OkU u)
    (ha : 0 < op → OkA a) :
    IRuns I iprog
      (.ite rOP (fun c => c == .neg) (rptX rM lA lC lD dr)
        (.ite rOP (fun c => c == .zero) (rptX rM lA lC lD (.op (.const rACC 0))) (emitP rd it bk)))
      (encK s (lin inp tmp (skS G C CU (op :: OP) (a :: ARG) ACC)))
      (encK s (lin (if op < 0 then inp.drop m else inp) tmp
        (skS G C CU (op :: OP) (a :: ARG) ((runC m g [(op, a)] inp).reverse ++ ACC))))
      (50 + (m + 1) * (cdr + crd + cit + cbk + 12002)) := by sorry
