theorem mem_iff_of_centre (hfrac : ∀ f : F, ∃ a b : ↥O, b ≠ 0 ∧ f * (b : F) = (a : F))
    (V : ValuationSubring F) (hV : O ≤ V.toSubring) (htV : t ∈ ((maximalIdeal ↥V).comap (Subring.inclusion hV)))
    (hVm : ((maximalIdeal ↥V).comap (Subring.inclusion hV)) ≠ maximalIdeal ↥O) :
    ∀ f : F, f ∈ V ↔ ∃ a b : ↥O, b ∉ ((maximalIdeal ↥V).comap (Subring.inclusion hV)) ∧ f * (b : F) = (a : F) := by
  classical
  set Q := ((maximalIdeal ↥V).comap (Subring.inclusion hV)) with hQ

  have hdvr : IsDiscreteValuationRing (Localization.AtPrime Q) :=
    IsLocalRing.isDiscreteValuationRing_localization_of_ringEquiv_adicCompletion_uvCrossingModel_of_mem_of_ne
      π hπ E hE ι t ht Q htV hVm

  haveI : FaithfulSMul ↥O F := (faithfulSMul_iff_algebraMap_injective ↥O F).mpr Subtype.val_injective
  haveI hFO : IsFractionRing ↥O F := by
    refine IsFractionRing.of_field (R := ↥O) (K := F) fun z => ?_
    obtain ⟨a, b, hb, e⟩ := hfrac z
    refine ⟨a, b, ?_⟩
    show z = (a : F) / (b : F)
    rw [eq_div_iff (fun h => hb (Subtype.ext h))]; exact e
  have hunit : ∀ y : Q.primeCompl, IsUnit (O.subtype y) := fun y => by
    apply IsUnit.mk0
    intro h; exact y.2 (by rw [show (y : ↥O) = 0 from Subtype.ext h]; exact Q.zero_mem)
  letI algQ : Algebra (Localization.AtPrime Q) F :=
    (IsLocalization.lift (M := Q.primeCompl) (S := Localization.AtPrime Q) (g := O.subtype) hunit).toAlgebra
  haveI : IsScalarTower ↥O (Localization.AtPrime Q) F :=
    IsScalarTower.of_algebraMap_eq fun a => (IsLocalization.lift_eq hunit a).symm
  haveI : IsFractionRing (Localization.AtPrime Q) F :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization Q.primeCompl (Localization.AtPrime Q) F

  have hint : ∀ f : F, IsLocalization.IsInteger (Localization.AtPrime Q) f →
      ∃ a b : ↥O, b ∉ Q ∧ f * (b : F) = (a : F) := by
    rintro f ⟨y, rfl⟩
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq Q.primeCompl y
    refine ⟨a, s, s.2, ?_⟩
    have := (IsLocalization.lift_mk'_spec (M := Q.primeCompl) (g := O.subtype) hunit a
      (algebraMap (Localization.AtPrime Q) F (IsLocalization.mk' _ a s)) s).mp rfl
    rw [mul_comm]; exact this.symm
  have hback : ∀ f : F, (∃ a b : ↥O, b ∉ Q ∧ f * (b : F) = (a : F)) → f ∈ V := by
    rintro f ⟨a, b, hb, e⟩
    have hbu : (b : F) ∉ V.nonunits := fun h => hb ((mem_centre_iff O V hV b).mpr h)
    obtain ⟨hb0, hbinv⟩ := vs_inv_mem_of_not_mem_nonunits V _ hbu
    have : f = (a : F) * ((b : F))⁻¹ := by rw [← e, mul_inv_cancel_right₀ hb0]
    rw [this]; exact V.mul_mem _ _ (hV a.2) hbinv
  intro f
  refine ⟨fun hf => ?_, hback f⟩
  by_cases hf0 : f = 0
  · exact ⟨0, 1, fun h1 => (centre_isPrime O V hV).ne_top ((Ideal.eq_top_iff_one _).mpr h1), by simp [hf0]⟩
  haveI : ValuationRing (Localization.AtPrime Q) := inferInstance
  rcases (ValuationRing.iff_isInteger_or_isInteger (Localization.AtPrime Q) F).mp inferInstance f with h | h
  · exact hint f h
  · obtain ⟨a, b, hb, e⟩ := hint f⁻¹ h
    have hbu : (b : F) ∉ V.nonunits := fun h => hb ((mem_centre_iff O V hV b).mpr h)
    have ha : a ∉ Q := by
      intro haQ
      have haV : ((a : ↥O) : F) ∈ V.nonunits := (mem_centre_iff O V hV a).mp haQ
      rw [ValuationSubring.mem_nonunits_iff] at haV hbu
      push Not at hbu
      have hvb : V.valuation (b : F) = 1 := le_antisymm ((V.valuation_le_one_iff _).mpr (hV b.2)) hbu
      have hvf : V.valuation f ≤ 1 := (V.valuation_le_one_iff _).mpr hf
      have hvfi : V.valuation f⁻¹ < 1 := by
        have hb0 : ((b : ↥O) : F) ≠ 0 := fun h => by rw [h, map_zero] at hvb; exact zero_ne_one hvb
        have : f⁻¹ = (a : F) * ((b : F))⁻¹ := by rw [← e, mul_inv_cancel_right₀ hb0]
        rw [this, map_mul, map_inv₀, hvb, inv_one, mul_one]; exact haV
      have h1 : V.valuation (f * f⁻¹) = 1 := by rw [mul_inv_cancel₀ hf0, map_one]
      rw [map_mul] at h1
      have : V.valuation f * V.valuation f⁻¹ < 1 := by
        calc V.valuation f * V.valuation f⁻¹ ≤ 1 * V.valuation f⁻¹ := mul_le_mul' hvf le_rfl
          _ = V.valuation f⁻¹ := one_mul _
          _ < 1 := hvfi
      rw [h1] at this
      exact lt_irrefl _ this
    have ha0 : ((a : ↥O) : F) ≠ 0 := fun h => ha (by rw [show a = 0 from Subtype.ext h]; exact Q.zero_mem)
    refine ⟨b, a, ha, ?_⟩

    have : (b : F) = f * (a : F) := by
      rw [← e, ← mul_assoc, mul_inv_cancel₀ hf0, one_mul]
    exact this.symm

