open NLogN
open IntMul

theorem NLogN.ss_lift (n k Q M : ℕ) (x y : ℤ) (hn : 1 ≤ n) (hKQ : 2 ^ k * Q = n)
    (hb : 2 * ((2 : ℤ) ^ k) ^ 2 * ((2 : ℤ) ^ M) ^ 2 < 2 ^ (n - 1)) :
    liftL n k Q (2 ^ k) (ditZ (2 ^ n + 1) n (2 * Q) k (pmulZ (2 ^ n + 1)
      (difZ (2 ^ n + 1) (2 * Q) k (wtZ (2 ^ n + 1) Q 0 (pcs M (2 ^ k) x)))
      (difZ (2 ^ n + 1) (2 * Q) k (wtZ (2 ^ n + 1) Q 0 (pcs M (2 ^ k) y))))) =
      ncZ (2 ^ k) (pcs M (2 ^ k) x) (pcs M (2 ^ k) y) := by sorry
