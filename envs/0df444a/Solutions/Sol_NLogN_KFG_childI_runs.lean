variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem withL4_runs (p : IStmt HS Pp) (A q M Bb : ℕ) (hA : zsz (A : ℤ) ≤ Bb)
    (hq : zsz (q : ℤ) ≤ Bb) (hM : zsz (M : ℤ) ≤ Bb) (h2 : zsz (2 : ℤ) ≤ Bb) (t : IState HS)
    (xs ys : List ℤ) (R : List Item) (h0 : t.G 0 = ints xs ++ R) (cp : ℕ)
    (hp : ∀ u : IState HS, u.G 0 = ints xs ++ R → u.G 1 = .int (A : ℤ) :: t.G 1 →
      u.G 2 = .int (q : ℤ) :: t.G 2 → u.G 3 = .int (M : ℤ) :: t.G 3 →
      u.G 4 = .int 2 :: t.G 4 → IRuns I iprog p u (u.upd 0 (ints ys ++ R)) cp) :
    IRuns I iprog (withPushI (l4 A q M) p) t (t.upd 0 (ints ys ++ R))
      (pushCost Bb (l4 A q M) + cp + (4 * (2 * Bb + 2) + 1)) := by
  have hPO : PushOK t Bb (l4 A q M) := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l4, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact goodE_lit hA
    · exact goodE_lit hq
    · exact goodE_lit hM
    · exact goodE_lit h2)
  have hv : ∀ x ∈ l4 A q M, zsz (x.2.eval t) ≤ Bb := by
    intro x hx; simp only [l4, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl <;> simpa [Ex.eval]
  have hev : evalP t (l4 A q M) = [(1, (A : ℤ)), (2, (q : ℤ)), (3, (M : ℤ)), (4, 2)] := rfl
  set u := pushSt t (evalP t (l4 A q M))
  have hu : ∀ i : Fin HS, u.G i = if i = 4 then .int 2 :: t.G 4 else
      if i = 3 then .int (M : ℤ) :: t.G 3 else if i = 2 then .int (q : ℤ) :: t.G 2 else
      if i = 1 then .int (A : ℤ) :: t.G 1 else t.G i := by
    intro i
    simp only [u, hev, pushSt]
    by_cases h4 : i = 4
    · subst h4; simp +decide [IState.upd_G]
    by_cases h3 : i = 3
    · subst h3; simp +decide [IState.upd_G]
    by_cases h2 : i = 2
    · subst h2; simp +decide [IState.upd_G]
    by_cases h1 : i = 1
    · subst h1; simp +decide [IState.upd_G]
    simp [IState.upd_G, h1, h2, h3, h4]
  have Mr := hp u (by rw [hu]; simp +decide [h0]) (by rw [hu]; simp +decide)
    (by rw [hu]; simp +decide) (by rw [hu]; simp +decide) (by rw [hu]; simp +decide)
  exact IRuns.withPushI (I := I) (iprog := iprog) (l4 A q M) p t Bb hPO hv
    (by simp +decide [l4]) ys R _ Mr |>.mono (by simp [l4])

/-- The first field move on a managed state: `seg ↦ mvL M q seg`. -/
theorem fwd_runs (A q M Bb w : ℕ) (hA : zsz (A : ℤ) ≤ Bb) (hq : zsz (q : ℤ) ≤ Bb)
    (hM : zsz (M : ℤ) ≤ Bb) (h2 : zsz (2 : ℤ) ≤ Bb) (hA1 : 1 ≤ A) (hq1 : 1 ≤ q) (hM1 : 1 ≤ M)
    (s : IState HS) (f : Fin HS → List ℤ) (seg : List GI) (L : List ℤ)
    (hl : seg.length = A * M * q) (hb : NLogN.KFB.GB w seg) (h0 : f 0 = gflat seg ++ L) :
    IRuns I iprog (withPushI (l4 A q M) KFC.fwdF) (encK s f)
      (encK s (Function.update f 0 (gflat (NLogN.KFB.mvL M q seg) ++ L)))
      (pushCost Bb (l4 A q M) + KFC.cFwdF A q M 2 w + (4 * (2 * Bb + 2) + 1)) := by
  have e0 : (encK s f).G 0 = ints (gflat seg) ++ (ints L ++ s.G 0) := by
    simp [h0, ints_append]
  have H := withL4_runs (I := I) (iprog := iprog) KFC.fwdF A q M Bb hA hq hM h2 (encK s f)
    (gflat seg) (gflat (NLogN.KFB.mvL M q seg)) (ints L ++ s.G 0) e0 (KFC.cFwdF A q M 2 w) (by
      intro u u0 u1 u2 u3 u4
      rw [gflat_mvL (A := A) seg hl]
      exact KFC.fwdF_spec u (gflat seg) A q M 2 w _ _ _ _ _
        (by rw [length_gflat, hl]; ring) hb.bnd (by norm_num) hM1 hq1 hA1 u0 u1 u2 u3
        (by simpa using u4))
  refine H.mono' ?_ le_rfl
  rw [← List.append_assoc, ← ints_append, encK_upd]

/-- The second field move: `ys ↦ mvL q M ys`. -/
theorem bwd_runs (A q M Bb w : ℕ) (hA : zsz (A : ℤ) ≤ Bb) (hq : zsz (q : ℤ) ≤ Bb)
    (hM : zsz (M : ℤ) ≤ Bb) (h2 : zsz (2 : ℤ) ≤ Bb) (hA1 : 1 ≤ A) (hq1 : 1 ≤ q) (hM1 : 1 ≤ M)
    (s : IState HS) (f : Fin HS → List ℤ) (ys : List GI) (L : List ℤ)
    (hl : ys.length = A * q * M) (hb : NLogN.KFB.GB w ys) (h0 : f 0 = gflat ys ++ L) :
    IRuns I iprog (withPushI (l4 A q M) KFC.bwdF) (encK s f)
      (encK s (Function.update f 0 (gflat (NLogN.KFB.mvL q M ys) ++ L)))
      (pushCost Bb (l4 A q M) + KFC.cBwdF A q M 2 w + (4 * (2 * Bb + 2) + 1)) := by
  have e0 : (encK s f).G 0 = ints (gflat ys) ++ (ints L ++ s.G 0) := by
    simp [h0, ints_append]
  have H := withL4_runs (I := I) (iprog := iprog) KFC.bwdF A q M Bb hA hq hM h2 (encK s f)
    (gflat ys) (gflat (NLogN.KFB.mvL q M ys)) (ints L ++ s.G 0) e0 (KFC.cBwdF A q M 2 w) (by
      intro u u0 u1 u2 u3 u4
      rw [gflat_mvL (A := A) ys hl]
      exact KFC.bwdF_spec u (gflat ys) A q M 2 w _ _ _ _ _
        (by rw [length_gflat, hl]; ring) hb.bnd (by norm_num) hM1 hq1 hA1 u0 u1 u2 u3
        (by simpa using u4))
  refine H.mono' ?_ le_rfl
  rw [← List.append_assoc, ← ints_append, encK_upd]

theorem fok_parkP (off : ℕ) : fok (parkP off) = true := by
  simp +decide [parkP, fok, fok_mvK_eq, touch, scr, Ex.regs]

theorem fok_unparkP : fok unparkP = true := by
  simp +decide [unparkP, fok, fok_mvK_eq, touch, scr, Ex.regs]

theorem parkP_fsp (s : IState HS) (f : Fin HS → List ℤ) (pre : List GI) (L : List ℤ)
    {w : ℕ} (hb : NLogN.KFB.GB w pre) (h0 : f 0 = gflat pre ++ L) (hP : f qP = []) (hR : f NLogN.KFB.rP = [])
    (Z : ℕ) (hZ : zsz ((2 * pre.length : ℕ) : ℤ) ≤ Z) :
    FSp (parkP pre.length) (encK s f) (encK s (Function.update (Function.update
      (Function.update f NLogN.KFB.rP [((2 * pre.length : ℕ) : ℤ)]) 0 L) qP (gflat pre).reverse))
      (2 * 2000 * (Z + 2) + (2 * pre.length * (250 * w + 2600) + 2000)) := by
  have p1 := Sp.push s f (i := NLogN.KFB.rP) (e := .lit ((2 * pre.length : ℕ) : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial hZ
  rw [show Ex.eval (encK s f) (.lit ((2 * pre.length : ℕ) : ℤ)) :: f NLogN.KFB.rP =
    [((2 * pre.length : ℕ) : ℤ)] by simp [Ex.eval, hR]] at p1
  set f1 := Function.update f NLogN.KFB.rP [((2 * pre.length : ℕ) : ℤ)]
  have m2 := FSp.mvN (X := 0) (Y := qP) (C := NLogN.KFB.c1) (r := NLogN.KFB.rP) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f1 (gflat pre) L
    (by simp +decide [f1, h0]) (Lr := s.G NLogN.KFB.rP) (by simp +decide [f1, ints]) w hb.bnd
  refine ((FSp.of_norep rfl p1).seq m2).mono ?_ |>.congr ?_
  · simp only [Ex.size, length_gflat]; omega
  · congr 1; funext x
    simp only [f1, Function.update_apply]
    by_cases x1 : x = qP
    · subst x1; simp +decide [hP]
    simp [x1]

theorem unparkP_fsp (s : IState HS) (f : Fin HS → List ℤ) (pre : List GI) (L : List ℤ)
    {w : ℕ} (hb : NLogN.KFB.GB w pre) (h0 : f 0 = L) (hP : f qP = (gflat pre).reverse)
    (hR : f NLogN.KFB.rP = [((2 * pre.length : ℕ) : ℤ)]) (Z : ℕ) (hZ : zsz ((2 * pre.length : ℕ) : ℤ) ≤ Z) :
    FSp unparkP (encK s f) (encK s (Function.update (Function.update
      (Function.update f qP []) 0 (gflat pre ++ L)) NLogN.KFB.rP []))
      (2 * pre.length * (250 * w + 2600) + 2000 + (2 * Z + 2)) := by
  have m1 := FSp.mvN (X := qP) (Y := 0) (C := NLogN.KFB.c1) (r := NLogN.KFB.rP) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f (gflat pre).reverse []
    (by simp [hP]) (Lr := s.G NLogN.KFB.rP) (by simp +decide [hR, ints]) w (NLogN.KIL.bnd_reverse hb.bnd)
  set f1 := Function.update (Function.update f qP []) 0 ((gflat pre).reverse.reverse ++ f 0)
  have p2 := Sp.pop s f1 (i := NLogN.KFB.rP) (a := ((2 * pre.length : ℕ) : ℤ)) (l := []) (B := Z) (by decide)
    (by simp +decide [f1, hR]) hZ
  refine (m1.seq (FSp.of_norep rfl p2)).mono ?_ |>.congr ?_
  · simp only [List.length_reverse, length_gflat]; omega
  · simp [f1, h0]

