theorem solution {iprog : Fin 1 → NLogN.IStmt NLogN.HS 1} {code} {Kc : ℝ}
    (H : IntMul.OpenAI.R129.P.NLogN.KFR.Lem13Body iprog code Kc) (Isym : List NLogN.Sym) {K m k r : ℕ} (hK : 6 ≤ K) (hm : 3 ≤ m)
    (hr : 1 ≤ r) (pos : Fin m × Fin (m ^ k) → ℕ) (t S0 B : ℕ) (hinj : Function.Injective pos)
    (hpos : ∀ p, pos p < t) (haff : NLogN.KFN.AffK2 K t m k pos) (hS0 : 1 ≤ S0) (hB : 1 ≤ B)
    (i j : Fin m) (hij : i ≠ j) :
    ∃ codeR : ℕ → NLogN.IStmt NLogN.HS 1,
      NLogN.KFN.SImplI Isym iprog r (fun p => 2 ^ pos p * S0) (B * 2 ^ t * S0)
        (P8Lift.Pm i j : Butterfly.Op (Fin m × Fin (m ^ k))) codeR 0 0
        (fun w => ⌈IntMul.OpenAI.R129.P.NLogN.KFR.bnd Kc K (m ^ k) (B * 2 ^ t * S0) r w⌉₊) := by
  obtain ⟨e, he, htop⟩ := haff
  obtain ⟨σ, px, py, hσ, hpx, hpy, hpxy⟩ := NLogN.KFR.slots3 hm hij
  set n := B * 2 ^ t * S0 with hn
  set sh := NLogN.KFR.shR K (m ^ k) e t S0 B σ with hsh
  have hvol : AModel.vol sh = n := NLogN.KFR.shR_vol he htop hσ
  have hf : 1 ≤ m ^ k := Nat.one_le_pow _ _ (by omega)
  have hK1 : 1 ≤ K := by omega
  set st : Fin m × Fin (m ^ k) → ℕ := fun p => 2 ^ pos p * S0
  have hL := NLogN.KFN.slaws_pow pos hinj t S0 B hpos
  have henc : ∀ q < n, AModel.encode sh (NLogN.KFH.rowAddAddr K (e % K) (m ^ k) px py (AModel.decode sh q)) =
      NLogN.KFN.fset st q (P8Lift.rowAddr i j (NLogN.KFN.fbit st q)) := fun q hq => by
    have := NLogN.KFR.encode_rowAddAddr he htop hσ hK1 hq hpx hpy hij
    unfold NLogN.KFN.fset; rw [← this]; simp; rfl
  set N0 := B * 2 ^ (t - NLogN.KFR.sR K (m ^ k) e (σ 0) - m ^ k * K)
  set N1 := 2 ^ (NLogN.KFR.sR K (m ^ k) e (σ 0) - NLogN.KFR.sR K (m ^ k) e (σ 1) - m ^ k * K)
  set N2 := 2 ^ (NLogN.KFR.sR K (m ^ k) e (σ 1) - NLogN.KFR.sR K (m ^ k) e (σ 2) - m ^ k * K)
  set N3 := 2 ^ NLogN.KFR.sR K (m ^ k) e (σ 2) * S0
  have hsh' : sh = NLogN.KFH.rect N0 N1 N2 N3 (m ^ k * K) := rfl
  refine ⟨fun w => code N0 N1 N2 N3 K (m ^ k) (e % K) r w px py, ?_⟩
  intro s g zs l xs F w hcl hg hrec hlen hgb
  have hzl : zs.length = n * r := by rw [hrec.1, hlen]
  obtain ⟨c, hrun, hc⟩ := H (I := Isym) N0 N1 N2 N3 K (m ^ k) (e % K) r w px py hpxy hK
    (Nat.mod_lt _ (by omega)) hf (Nat.one_le_iff_ne_zero.2 (by positivity))
    (Nat.one_le_iff_ne_zero.2 (by positivity)) (Nat.one_le_iff_ne_zero.2 (by positivity))
    (Nat.one_le_iff_ne_zero.2 (by positivity)) hr s g zs l hg
    (by rw [hzl, ← hsh', hvol]) hgb
  rw [← hsh'] at hrun hc
  refine ⟨_, ?_, by rw [add_zero]; exact NLogN.KFR.permRecs_GB hgb, hrun.mono ?_⟩
  · rw [add_zero]
    have hP := NLogN.KFR.permRecs_recRep (π := NLogN.KFH.rowAddAddr K (e % K) (m ^ k) px py) hrec (hlen.trans hvol.symm)
      (fun q hq => by rw [hvol] at hq ⊢; rw [henc q hq]; exact hL.lt q hq _)
    have e1 : NLogN.KFN.selOpF st n (P8Lift.Pm i j : Butterfly.Op (Fin m × Fin (m ^ k))) xs =
        (List.range (AModel.vol sh)).map fun q =>
          xs.getD (AModel.encode sh (NLogN.KFH.rowAddAddr K (e % K) (m ^ k) px py (AModel.decode sh q))) 0 := by
      rw [NLogN.KFR.selOpF_Pm, hvol]
      refine List.map_congr_left fun q hq => ?_
      rw [henc q (List.mem_range.1 hq)]
    rw [e1]; exact hP
  · have h2 : (c : ℝ) ≤ IntMul.OpenAI.R129.P.NLogN.KFR.bnd Kc K (m ^ k) n r w := by
      rw [hvol, hzl] at hc
      exact hc
    exact_mod_cast h2.trans (Nat.le_ceil _)
end
