theorem nsmul_hom_rootsOfUnity_eq_zero {S : Type*} [Fintype S] (m : ℕ)
    (χ : characterLattice S →+ Additive ↥(rootsOfUnity m (AlgebraicClosure ℚ))) : m • χ = 0 := by
  ext a
  have hg : ((Additive.toMul (χ a) : ↥(rootsOfUnity m (AlgebraicClosure ℚ))) : (AlgebraicClosure ℚ)ˣ) ^ m = 1 :=
    (mem_rootsOfUnity m _).mp (Additive.toMul (χ a)).2
  rw [AddMonoidHom.zero_apply, show (m • χ) a = m • χ a from rfl, toMul_nsmul, toMul_zero, Subgroup.coe_pow,
    OneMemClass.coe_one, hg]

