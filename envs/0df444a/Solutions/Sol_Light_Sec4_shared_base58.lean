    (s.filter fun x : Fin L => (x : ℕ) < (s.orderEmbOfFin h j : ℕ)).card = j := by
  simpa only [Finset.map_orderEmbOfFin_univ] using card_filter_lt_map (s.orderEmbOfFin h) j

