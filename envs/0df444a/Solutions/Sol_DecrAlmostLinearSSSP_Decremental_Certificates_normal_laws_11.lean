    have ht : ¬(Test.natLess 56 214).holds s := by simp only [Test.holds,henv.globals.zeroN,hq.count,List.length_nil,lt_self_iff_false,not_false_eq_true]
    refine ⟨2,s,xs,Eval.loopNo s ht,?_,h,by simp,henv,?_,ReportFrame.refl i B reserve N j.val s⟩
    · simp only [List.length_nil,Nat.mul_zero,allEvents,List.flatMap_nil,pointerTravel,Nat.zero_add,le_refl]
    · simpa only [List.length_nil,Nat.add_zero] using hq
