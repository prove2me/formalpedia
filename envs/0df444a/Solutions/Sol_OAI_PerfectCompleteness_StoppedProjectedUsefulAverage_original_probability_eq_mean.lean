theorem solution : type_of% @OAI.PerfectCompleteness.StoppedProjectedUsefulAverage.original_probability_eq_mean_oai := @OAI.PerfectCompleteness.StoppedProjectedUsefulAverage.original_probability_eq_mean_oai
