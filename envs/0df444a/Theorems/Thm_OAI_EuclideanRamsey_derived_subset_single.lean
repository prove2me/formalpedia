variable {G : Type uGroup} [Group G]

theorem OAI.EuclideanRamsey.derived_subset_single (N : Subgroup G) [N.Normal] (n : ℕ) :
    ∀ (ι : Type uIndex) [Fintype ι] [DecidableEq ι] (M : Submonoid (ι → G))
      (hd : HasDiagonal M) (_hi : PairInverse M) (_hc : PairCoverage M N),
      Fintype.card ι ≤ n+2 → ∀ i,Derived N n ≤ singleFractions M hd i := by sorry
