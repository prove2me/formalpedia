private theorem coeff_append (q : ℚ) (L M : Law) (σ : FactorType) :
    (Expr.eval q (lawCoeff (L ++ M) σ)) = (Expr.eval q (lawCoeff L σ)) + (Expr.eval q (lawCoeff M σ)) := by
  induction L with
  | nil => simp [coeff_nil]
  | cons z L ih => rw [List.cons_append, coeff_cons, coeff_cons, ih, add_assoc]

