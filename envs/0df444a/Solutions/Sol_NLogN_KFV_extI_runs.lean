    rw [show Ex.eval (NLogN.KIL.encK s G) (.quo (.add (.reg NLogN.KFV.vT) (.neg (.reg vT4))) (.lit (2 ^ Δ))) =
      fdt Δ u[k] v[k] by
      simp only [Ex.eval, fdt]; rw [top_encK hGu, top_encK hGv, sub_eq_add_neg]] at s1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G O (fdt Δ u[k] v[k] :: G O) := ⟨_, rfl⟩
