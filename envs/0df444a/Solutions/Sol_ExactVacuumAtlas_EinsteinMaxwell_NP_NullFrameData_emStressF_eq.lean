      Matrix.mul_assoc]
  have hfs : ((fieldSq gi F x : ℝ) : ℂ) = ∑ C, ∑ D, FfrM F E x C D * (etaNull * FfrM F E x * etaNull) C D := by
    rw [fieldSq_cmat, hgiT, hgi]
    have e : frMat E x * etaNull * (frMat E x)ᵀ * cmat F x * (frMat E x * etaNull * (frMat E x)ᵀ)
        = frMat E x * (etaNull * FfrM F E x * etaNull) * (frMat E x)ᵀ := by
      simp only [FfrM, Matrix.mul_assoc]
    rw [e, sum_entry_conj]
    rfl
  rw [← frame2_apply, emStress_cmat, hfs]
  have e1 : (frMat E x)ᵀ * (cmat F x * cmat gi x * (cmat F x)ᵀ
      - (((∑ C, ∑ D, FfrM F E x C D * (etaNull * FfrM F E x * etaNull) C D)) / 4) • cmat g x) * frMat E x
      = FfrM F E x * etaNull * (FfrM F E x)ᵀ
        - ((∑ C, ∑ D, FfrM F E x C D * (etaNull * FfrM F E x * etaNull) C D) / 4) • etaNull := by
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_smul, Matrix.smul_mul, hG, hgi]
    simp only [FfrM, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
  rw [e1]
  simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]
  ring
