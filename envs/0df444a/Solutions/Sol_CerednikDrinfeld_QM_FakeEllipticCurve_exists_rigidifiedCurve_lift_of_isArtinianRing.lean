    CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.parity_eq_and_isIsomorphic_of_isRigTransport_of_isPullbackVia_corr_of_rigidified
      hrr hrN 𝒪 hdvr π hπ hcomplete hres hunr K₀ Onr Fr hOnr_complete hOnr_max hOnr_alg hOnr_closed hFr hB Λ hΛ hΛℤ
      coord hcoord A₀ X₀ hX₀ θ₀ hA₀ ι Φ hΦ hΦ4 M hM η hη E₀ hE₀ κbr hκbr n₀ β₀ hβ₀
      A hA hAr κ hκ hrκnil qκ hqκ hkerNil ψ x₀ X₀κ θ₀κ hx₀ j₀ t₀ hj₀ ht₀X htr₀ hadm₀ t htadm₀'
      u₀ v₀ m₀ hu₀ hv₀ hvu₀ huv₀ hc₀ E g hgE' θ hEX θt hEθt hθg' hθtw
      ρ ρ' hρρ' ib hib₁ hib₂ uA' huA'₁ huA'₂ i₁ j₁ hrel j t'' hj ht''X htr'' hadm''
  have hadm_t : t.IsAdmissible ι ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] A) : Onr →+* A) := by
    rw [hjj₀]; exact htadm₀'

  have hΞxy : Ξ A ψ hA x =
      ⟨frobTwist Onr Fr (-(j : ℤ)) ψ, hAr, η A ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] A) : Onr →+* A) hAr t⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.rigidifiedToG_eq_of_isRigTransport_of_isIsomorphic
      hrr hrN 𝒪 hdvr π hπ hcomplete hres hunr K₀ Onr Fr hOnr_complete hOnr_max hOnr_alg hOnr_closed hFr hB Λ hΛ hΛℤ
      coord hcoord A₀ X₀ hX₀ θ₀ hA₀ ι Φ hΦ hΦ4 M hM η hη E₀ hE₀ κbr hκbr n₀ β₀ hβ₀ Ξ hΞdef
      A hA hconn hAr ψ x t.X θ hEX j hj t t'' ht''X htr'' hadm'' hadm_t hiso
