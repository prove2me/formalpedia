  have hcomapι : ∀ i, Ideal.comap ιR (Ideal.comap ((ee i : R →ₐ[F] R) : R →+* R) 𝔓x) =
      Ideal.comap ((e i : P₀.B₀ →ₐ[A] P₀.B₀) : P₀.B₀ →+* P₀.B₀) 𝔭x := by
    intro i
    ext b
    simp only [Ideal.mem_comap]
    change (ee i) (ιR b) ∈ 𝔓x ↔ (e i) b ∈ 𝔭x
    rw [hee' i b, ← h𝔓x_comap, Ideal.mem_comap]

  have hinjB : ∀ i i' : (ZMod ℓ)ˣ × (ZMod q)ˣ,
      Ideal.comap ((e i : P₀.B₀ →ₐ[A] P₀.B₀) : P₀.B₀ →+* P₀.B₀) 𝔭x =
        Ideal.comap ((e i' : P₀.B₀ →ₐ[A] P₀.B₀) : P₀.B₀ →+* P₀.B₀) 𝔭x → i = i' := by
    intro i i' hB
    have hker : RingHom.ker (P₀.classify ((σ i).act xT)).toRingHom = RingHom.ker (P₀.classify ((σ i').act xT)).toRingHom := by
