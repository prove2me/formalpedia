variable {d : ℕ}

/-! ## Balls and cubes of the product -/

lemma QFS.volume_closedCube_two {h : ℝ} (hh : 0 ≤ h)
    (u : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d)) :
    volume (closedCube_two h u) = ENNReal.ofReal (h ^ (2 * d)) := by sorry
