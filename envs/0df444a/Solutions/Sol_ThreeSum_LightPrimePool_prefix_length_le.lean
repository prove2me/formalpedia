namespace ThreeSum.LightPrimePool
theorem _root_.solution (y i : ℕ) : (scanned y i).length ≤ i := by
  induction i with
  | zero => simp [scanned]
  | succ i ih =>
      unfold scanned
      split
      · simp only [List.length_append,List.length_singleton]
        omega
      · omega
end ThreeSum.LightPrimePool
