-- url     : https://prove2.me/theorems/70bbfa5a-48ff-4f87-9618-df5066e270e9
-- title:
--   The KM-myopic ordering policy $Y^{KM}_T$ as a function of the demand path
-- statement:
--   Fix a target ratio $r$, an initial order $y_1\in\mathbb N$ and a sequence of integer demands $D_1,D_2,\dots$. The **KM-myopic policy** orders $Y_1=y_1$ in period $1$. In period $T\ge2$ it knows the $T-1$ past observations $Z_t=\min\{D_t,Y_t\}$ and $\delta_t=\mathbf 1[D_t\le Y_t]$, $t<T$, forms the Kaplan–Meier estimator $\bar F$ from them, and orders the empirical $r$-quantile
--   $$Y^{KM}_T=\min\{d\in\mathbb N:\ \bar F(d)\le 1-r\}.$$
--   If no such $d$ exists, which happens exactly when the largest past observation $Z_{(T-1)}$ is censored and the estimator at $Z_{(T-1)}$ still exceeds $1-r$, the policy orders twice the largest past observation, $Y^{KM}_T=2Z_{(T-1)}$.
--
--   The order in period $T$ depends only on $D_1,\dots,D_{T-1}$ (through the censored observations), never on $D_T$. The sales $Z_t$ and censoring indicators $\delta_t$ generated by the policy are also defined here; the estimator built from the first $T$ of them is the one whose convergence Lemma 2 (i) asserts.
--
--   **Formalization Note** Time is $0$-based in Lean: `kmOrder r y₁ dem n` is the order of the source's period $n+1$, `kmOrder r y₁ dem 0 = y₁`, and the order of Lean period $n+1$ is computed (`nextOrder`) from the observations of Lean periods $0,\dots,n$. `orderPrefix` builds the orders by recursion on the horizon. The source defines the order as an infimum over real $d$; the estimator is $1$ for $d<0$ and a right-continuous step function with jumps at integers, so the infimum is the least natural number with the property (`Nat.find`). The initial order $y_1$ is not specified in the source (its experiments use an "initial ordering level"), so it is an explicit parameter. `kmSales` and `kmUncensored` are the policy's observations $Z_t$ and $\delta_t$.
-- source:
--   Huh, Levi, Rusmevichientong, Orlin, Adaptive Data-Driven Inventory Control with Censored Demand Based on Kaplan-Meier Estimator, Oper. Res. 59(4) (2011), doi:10.1287/opre.1100.0906, p. 933, §4 (Y_T^KM = inf{d: F-bar_T(d) <= 1 - r*}) and §5 (the variant with Y_T^KM = 2 Z_(T) when the definition is ill-defined)

import Mathlib
import Definitions.Def_KMNewsvendor_kmSurv

namespace KMNewsvendor

open Finset

/-- One step of the KM-myopic policy (§4–§5, p. 933). Given the demands `dem` and the orders `y`
of Lean periods `0, …, n`, the order of Lean period `n + 1` is computed from the `n + 1` past
observations `Z_i = min {dem i, y i}`, `δ_i = [dem i ≤ y i]` (`i ≤ n`): it is the least `d` with
`F̄_{n+1}(d) ≤ 1 - r`, and, if no such `d` exists (the paper's "ill-defined" case: the largest
observation is censored and `F̄_{n+1}(Z_(n+1)) > 1 - r`), it is `2 Z_(n+1)`, twice the largest
past observation. Only `dem i` and `y i` with `i ≤ n` are read. -/
noncomputable def nextOrder (r : ℝ) (dem : ℕ → ℕ) (n : ℕ) (y : ℕ → ℕ) : ℕ :=
  open Classical in
  if h : ∃ d : ℕ, kmSurv (n + 1) (fun i => ((min (dem i) (y i) : ℕ) : ℝ))
      (fun i => decide (dem i ≤ y i)) d ≤ 1 - r then
    Nat.find h
  else
    2 * (range (n + 1)).sup (fun i => min (dem i) (y i))

/-- `orderPrefix r y₁ dem n i` is the KM-myopic order of Lean period `i` for every `i ≤ n`
(its values at `i > n` are a placeholder). Lean period `0` orders the initial level `y₁`. -/
noncomputable def orderPrefix (r : ℝ) (y₁ : ℕ) (dem : ℕ → ℕ) : ℕ → ℕ → ℕ
  | 0 => fun _ => y₁
  | n + 1 => fun i =>
      if i ≤ n then orderPrefix r y₁ dem n i else nextOrder r dem n (orderPrefix r y₁ dem n)

/-- The KM-myopic order `Y^KM` of Lean period `n` (the paper's period `n + 1`) on the demand
path `dem`, with target ratio `r` and initial order `y₁`. It depends only on
the demands `dem i` with `i < n`. -/
noncomputable def kmOrder (r : ℝ) (y₁ : ℕ) (dem : ℕ → ℕ) (n : ℕ) : ℕ :=
  orderPrefix r y₁ dem n n

/-- The observed sales `Z_i = min {D_i, Y_i^KM}` of Lean period `i` under the KM-myopic policy,
as a real number. -/
noncomputable def kmSales (r : ℝ) (y₁ : ℕ) (dem : ℕ → ℕ) (i : ℕ) : ℝ :=
  ((min (dem i) (kmOrder r y₁ dem i) : ℕ) : ℝ)

/-- The censoring indicator `δ_i = I[D_i ≤ Y_i^KM]` of Lean period `i` under the KM-myopic
policy (`true` = uncensored). -/
noncomputable def kmUncensored (r : ℝ) (y₁ : ℕ) (dem : ℕ → ℕ) (i : ℕ) : Bool :=
  decide (dem i ≤ kmOrder r y₁ dem i)

end KMNewsvendor


