/-! # One-variable derivative shapes

Explicit `HasDerivAt` witnesses for the few expression shapes that occur in closed-form
metric and Christoffel tables. Closed forms are written in exactly these shapes, so each table
entry is certified by one of these lemmas (no symbolic differentiation is trusted).
-/

open Real

namespace ExactVacuumAtlas.Deriv

theorem mul_sin_sq (K θ : ℝ) :
    HasDerivAt (fun t => K * sin t ^ 2) (K * (2 * sin θ * cos θ)) θ := by
  refine ((Real.hasDerivAt_sin θ).fun_pow 2).const_mul K |>.congr_deriv ?_
  push_cast
  ring

end ExactVacuumAtlas.Deriv

-- ==== segment from Atlas/Core/Pd.lean ====
/-! # Partial derivatives: locality, genuine-derivative and smoothness lemmas

Reusable facts about `pd`, `christoffel`, `ricci`:
* locality: they only depend on the fields on an open neighbourhood (`*_congr_of_eqOn`);
* no junk values: on an open set where the fields are `C^∞`, every slice used by `pd` is
  differentiable and `pd` is its true derivative (`hasDerivAt_pd`);
* smoothness propagates: `pd` and `christoffel` of `C^∞` fields are `C^∞` (`contDiffOn_*`).
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

theorem pd_const (c : ℝ) (i : Fin n) (x : Pt n) : pd i (fun _ => c) x = 0 := by
  simp [pd]

end ExactVacuumAtlas

-- ==== segment from Atlas/Core/Lift.lean ====
/-! # Fields depending only on `(x₁, x₂) = (r, θ)` in four dimensions

Stationary axisymmetric metrics (Schwarzschild, Kerr, Minkowski spherical, in every coordinate
system of release 0.1 except Cartesian) have components that depend only on `r = x₁` and
`θ = x₂`. `liftRT F` is the field `x ↦ F (x₁) (x₂)`; its partial derivatives reduce to ordinary
one-variable derivatives of `F`.
-/

namespace ExactVacuumAtlas

@[simp] theorem liftRT_apply (F : ℝ → ℝ → ℝ) (x : Pt 4) : liftRT F x = F (x 1) (x 2) := rfl

theorem pd_liftRT_zero (F : ℝ → ℝ → ℝ) (y : Pt 4) : pd 0 (liftRT F) y = 0 := by
  simp [pd, liftRT]

theorem pd_liftRT_three (F : ℝ → ℝ → ℝ) (y : Pt 4) : pd 3 (liftRT F) y = 0 := by
  simp [pd, liftRT, Function.update_apply]

theorem pd_liftRT_one (F : ℝ → ℝ → ℝ) (y : Pt 4) :
    pd 1 (liftRT F) y = deriv (fun u => F u (y 2)) (y 1) := by
  simp [pd, liftRT, Function.update_apply]

theorem pd_liftRT_two (F : ℝ → ℝ → ℝ) (y : Pt 4) :
    pd 2 (liftRT F) y = deriv (fun u => F (y 1) u) (y 2) := by
  simp [pd, liftRT, Function.update_apply]

end ExactVacuumAtlas

