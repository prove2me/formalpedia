  have hconstV : ∀ a : A₀, algebraMap A₀ ↥F₀ a ∈ V₀ := fun a => hCV₀ ⟨_, Subalgebra.algebraMap_mem _ a⟩
  have hĵV : (⟨_, hjF₀⟩ : ↥F₀) ∈ V₀ := hCV₀ ⟨_, hjC⟩

  have hϖ𝔮 : algebraMap A₀ ↥(TwoChartIntegralModel.chartAlg A₀ ↥F₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ϖ₀ ∈ 𝔮 ℓ' :=
    (hMIN ℓ').1.2 (Ideal.mem_map_of_mem _ (by rw [hϖ₀]; exact Ideal.mem_span_singleton_self _))
  have hϖV : (⟨algebraMap A₀ ↥F₀ ϖ₀, hconstV ϖ₀⟩ : ↥V₀) ∈ maximalIdeal ↥V₀ := by
    apply (IsLocalRing.mem_maximalIdeal _).mpr
    intro hu
    obtain ⟨hinv, h0⟩ := (vs_isUnit_iff V₀ _ _).mp hu
    rw [hV₀, hLOC ℓ'] at hinv
    obtain ⟨b, d, hd, hbd⟩ := hinv
    apply hd
    have : d = algebraMap A₀ ↥(TwoChartIntegralModel.chartAlg A₀ ↥F₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ϖ₀ * b := by
      apply Subtype.ext
      rw [MulMemClass.coe_mul, ← hbd, ← mul_assoc]
      change (d : ↥F₀) = algebraMap A₀ ↥F₀ ϖ₀ * (algebraMap A₀ ↥F₀ ϖ₀)⁻¹ * (d : ↥F₀)
      rw [mul_inv_cancel₀ h0, one_mul]
    rw [this]; exact (𝔮 ℓ').mul_mem_right _ hϖ𝔮

  have hWlaw : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
      (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
          ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ≠ 0 →
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ (↑(OIg ℓ') : Set ↥(fieldBar q M')) ∧
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M'))⁻¹ ∈ (↑(OIg ℓ') : Set ↥(fieldBar q M')) :=
    fun g hg hgi _ hne =>
      ModularCurve.FullLevel.inclusion_mem_igusaRing_and_inv_mem_of_residue_ne_zero q M' hqM' A hA hle R₀ hR₀ ζ OIg
        hIg_inf hIg _ hgi hne ℓ'
  have hA_int := intPoly_mem_and_inv_mem_of_rational_law q M' A hle R₀ hR₀ (↑(OIg ℓ')) hWlaw
  have hA_V : ∀ M : Polynomial ℤ, M.map (Int.castRingHom (ResidueField ↥A)) ≠ 0 →
      IsUnit (M.eval₂ (Int.castRingHom ↥V₀) ⟨(⟨_, hjF₀⟩ : ↥F₀), hĵV⟩) := by
    intro M hM
    obtain ⟨hne, -, hMW'⟩ := hA_int M hM
    have hval : (((M.eval₂ (Int.castRingHom ↥V₀) ⟨(⟨_, hjF₀⟩ : ↥F₀), hĵV⟩ : ↥V₀) : ↥F₀) : ↥(fieldBar q M')) =
        M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) :=
      map_eval₂_intCast M (F₀.subtype.comp V₀.subtype) _
    apply (vs_isUnit_iff V₀ _ (M.eval₂ (Int.castRingHom ↥V₀) _).2).mpr
    constructor
    · rw [hV₀]
      have e1 : ((((M.eval₂ (Int.castRingHom ↥V₀) ⟨(⟨_, hjF₀⟩ : ↥F₀), hĵV⟩ : ↥V₀) : ↥F₀)⁻¹ : ↥F₀) : ↥(fieldBar q M')) =
          (M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')))⁻¹ := by rw [← hval]; push_cast; rfl
      rw [e1]; exact hMW'
    · intro h0; apply hne; rw [← hval, h0]; rfl
  have hGauss := gauss_of_intPoly_units q M' A hA hle A₀ ι hι hres ϖ₀ hϖ₀ F₀ hjF₀ V₀ hconstV hϖV hĵV hA_V

  have hcoef : ∀ i : ℕ, ∃ a : A₀, ((ι a : ↥A) : AlgebraicClosure ℚ) = ((p.coeff i : ↥k₀) : AlgebraicClosure ℚ) := by
    intro i
    have : ((p.coeff i : ↥k₀) : AlgebraicClosure ℚ) ∈ (A : Set (AlgebraicClosure ℚ)) ∩ (K₀ : Set (AlgebraicClosure ℚ)) :=
      ⟨hpA i, (hk₀ _).mp (p.coeff i).2⟩
    rw [← hιK₀] at this
    exact this
  choose a ha using hcoef
  let P : Polynomial A₀ := ∑ i ∈ Finset.range (p.natDegree + 1), Polynomial.monomial i (a i)
  have hPcoeff : ∀ i, P.coeff i = if i ∈ Finset.range (p.natDegree + 1) then a i else 0 := by
    intro i
    simp only [P, Polynomial.finset_sum_coeff, Polynomial.coeff_monomial]
    rw [Finset.sum_ite_eq']
  have hPval : ∀ i, ((ι (P.coeff i) : ↥A) : AlgebraicClosure ℚ) = ((p.coeff i : ↥k₀) : AlgebraicClosure ℚ) := by
    intro i
    rw [hPcoeff]
    split_ifs with hi
    · exact ha i
    · rw [Finset.mem_range, not_lt] at hi
      rw [map_zero, ZeroMemClass.coe_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), ZeroMemClass.coe_zero]
  have hPbar : P.map (IsLocalRing.residue A₀) ≠ 0 := by
    intro h0
    have h1 : P.coeff p.natDegree = 1 := by
      apply hι
      apply Subtype.ext
      rw [hPval, hpm.coeff_natDegree, map_one, OneMemClass.coe_one, OneMemClass.coe_one]
    have := congrArg (fun r => Polynomial.coeff r p.natDegree) h0
    simp only [Polynomial.coeff_map, h1, map_one, Polynomial.coeff_zero] at this
    exact one_ne_zero this
  obtain ⟨hmemV₀, hu₀⟩ := hGauss P hPbar

  have hpolys : P.map (F₀.subtype.comp (algebraMap A₀ ↥F₀)) =
      p.map ((IntermediateField.val F₀').toRingHom.comp (algebraMap ↥k₀ ↥F₀')) := by
    refine Polynomial.ext fun i => ?_
    rw [Polynomial.coeff_map, Polynomial.coeff_map, RingHom.comp_apply, RingHom.comp_apply]
    change ((algebraMap A₀ ↥F₀ (P.coeff i) : ↥F₀) : ↥(fieldBar q M')) =
      ((algebraMap ↥k₀ ↥F₀' (p.coeff i) : ↥F₀') : ↥(fieldBar q M'))
    rw [hj₀, hPval, hconstk₀]
  have hvals : ((Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P : ↥F₀) : ↥(fieldBar q M')) =
      ((Polynomial.aeval (⟨_, hjF⟩ : ↥F₀') (p.map (algebraMap ↥k₀ ↥F₀')) : ↥F₀') : ↥(fieldBar q M')) := by
    change F₀.subtype (Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P) =
      (IntermediateField.val F₀').toRingHom (Polynomial.aeval (⟨_, hjF⟩ : ↥F₀') (p.map (algebraMap ↥k₀ ↥F₀')))
    rw [Polynomial.coe_aeval_eq_eval, Polynomial.eval_map, Polynomial.aeval_def, Polynomial.hom_eval₂,
      Polynomial.hom_eval₂, ← Polynomial.eval_map, ← Polynomial.eval_map, hpolys]
    rfl

  intro hmax
  have hunit : IsUnit (⟨_, hp⟩ : ↥((OIg ℓ').comap (IntermediateField.val F₀').toRingHom)) := by
    obtain ⟨hinv₀, hne₀⟩ := (vs_isUnit_iff V₀ _ hmemV₀).mp hu₀
    apply (vs_isUnit_iff _ _ hp).mpr
    constructor
    · rw [ValuationSubring.mem_comap, map_inv₀]
      change (((Polynomial.aeval (⟨_, hjF⟩ : ↥F₀') (p.map (algebraMap ↥k₀ ↥F₀')) : ↥F₀') : ↥(fieldBar q M')))⁻¹ ∈ OIg ℓ'
      rw [← hvals]
      rw [hV₀] at hinv₀
      have e1 : (((Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P)⁻¹ : ↥F₀) : ↥(fieldBar q M')) =
          (((Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P) : ↥F₀) : ↥(fieldBar q M'))⁻¹ := by push_cast; rfl
      rw [e1] at hinv₀
      exact hinv₀
    · intro h0; apply hne₀
      apply Subtype.ext
      rw [ZeroMemClass.coe_zero, hvals, h0, ZeroMemClass.coe_zero]
  exact (IsLocalRing.mem_maximalIdeal _).mp hmax hunit

set_option maxHeartbeats 4000000 in

theorem node_constant
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ))
    (hκ : ∀ a : AlgebraicClosure ℚ, a ∈ A → ∃ c : ↥k₀, (c : AlgebraicClosure ℚ) ∈ A ∧
      ∃ h : a - c ∈ A, (⟨_, h⟩ : ↥A) ∈ maximalIdeal ↥A)
    (s : ↥W) :
    letI : Algebra ↥k₀ ↥(fieldBar q M') :=
      ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).comp (algebraMap ↥k₀ (AlgebraicClosure ℚ))).toAlgebra
    ∀ (F₀' : IntermediateField ↥k₀ ↥(fieldBar q M'))
      (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀')
      (W₀ : ValuationSubring ↥F₀')
      (hK4 : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
        (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
        (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
            ↥(modularFunctionFieldBar M'))) →
        (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
          ∃ hF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ F₀',
            (⟨_, hF⟩ : ↥F₀') ∈ W₀ ∧
            ∀ (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A),
              residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
              ∃ hm : (⟨_, hF⟩ : ↥F₀') - algebraMap ↥k₀ ↥F₀' c ∈ W₀, (⟨_, hm⟩ : ↥W₀) ∈ maximalIdeal ↥W₀)
      (O : Subring ↥F₀')
      (hN1const : ∀ x : ↥k₀, (x : (AlgebraicClosure ℚ)) ∈ A ↔ algebraMap ↥k₀ ↥F₀' x ∈ O)
      (Wx : ValuationSubring ↥F₀')
      (hN3law : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
        (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
        (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
            ↥(modularFunctionFieldBar M'))) →
        ∃ hF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ F₀',
          (⟨_, hF⟩ : ↥F₀') ∈ Wx ∧
          (∀ hW : (⟨_, hF⟩ : ↥F₀') ∈ Wx, (⟨_, hW⟩ : ↥Wx) ∈ maximalIdeal ↥Wx ↔
            (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = 0) ∧
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
            (⟨_, hF⟩ : ↥F₀') ∈ O ∧
            ∀ (hO : (⟨_, hF⟩ : ↥F₀') ∈ O) (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A) (hcO : algebraMap ↥k₀ ↥F₀' c ∈ O),
              residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
              ¬ IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, hcO⟩)))
      (hĵO : (⟨_, hjF₀⟩ : ↥F₀') ∈ O),
    ∃ (c₀ : ↥k₀) (hc₀ : (c₀ : AlgebraicClosure ℚ) ∈ A) (hc₀O : algebraMap ↥k₀ ↥F₀' c₀ ∈ O),
      ¬ IsUnit ((⟨_, hĵO⟩ : ↥O) - ⟨_, hc₀O⟩) ∧
      (∀ hW : (⟨_, hjF₀⟩ : ↥F₀') - algebraMap ↥k₀ ↥F₀' c₀ ∈ W₀, (⟨_, hW⟩ : ↥W₀) ∈ maximalIdeal ↥W₀) ∧
      (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c₀ : AlgebraicClosure ℚ) ≠ 0 ∧
      ∀ ℓ' : CuspidalType.ProjLine q,
        (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c₀ : AlgebraicClosure ℚ) ∈ OIg ℓ' ∧
        ((IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c₀ : AlgebraicClosure ℚ))⁻¹ ∈ OIg ℓ' := by
  intro F₀' hjF₀ W₀ hK4 O hN1const Wx hN3law hĵO
  classical
  have hJmem : coeffEmb (AlgebraicClosure ℚ) jq ∈ modularFunctionFieldBar M' :=
    coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))

  have hyA : coeffMap A.subtype (jqModC ↥A) = coeffEmb (AlgebraicClosure ℚ) jq := by
    rw [coeffMap_jqModC']
    show jqModC (AlgebraicClosure ℚ) = coeffMap (algebraMap ℚ (AlgebraicClosure ℚ)) jq
    rw [← jqModC_rat, coeffMap_jqModC']
  have hmem : coeffMap A.subtype (jqModC ↥A) ∈ modularFunctionFieldBar M' := by rw [hyA]; exact hJmem
  obtain ⟨hgi', hres'⟩ := hR₀ (jqModC ↥A) hmem
  have htrans : ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
      ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
        coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A) := by
    have aux : ∀ (z : LaurentSeries (AlgebraicClosure ℚ)) (hz : z ∈ modularFunctionFieldBar M'),
        z = coeffEmb (AlgebraicClosure ℚ) jq →
        (∃ h : (⟨z, hz⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A)) →
        ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A) := by
      intro z hz e h; subst e; exact h
    exact aux _ hmem hyA ⟨hgi', hres'⟩
  obtain ⟨hgi, hres⟩ := htrans
  have hresj : (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = jGeomGen (ResidueField ↥A) M' := by
    apply Subtype.ext; rw [hres, coeffMap_jqModC']; rfl
  have hss : IsSupersingularPlace q M' (ResidueField ↥A)
      (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) := (hW _).mp s.2
  have hreg : (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
      (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring := by
    rw [hresj]; exact hss.2.1.1

  have hlift : ∀ v : ResidueField ↥A, ∃ (c : ↥k₀) (hc : (c : AlgebraicClosure ℚ) ∈ A),
      residue A ⟨(c : AlgebraicClosure ℚ), hc⟩ = v := by
    intro v
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective v
    obtain ⟨c, hcA, h, hm⟩ := hκ (a : AlgebraicClosure ℚ) a.2
    refine ⟨c, hcA, ?_⟩
    symm
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    have hrw : a - ⟨(c : AlgebraicClosure ℚ), hcA⟩ = ⟨(a : AlgebraicClosure ℚ) - c, h⟩ :=
      Subtype.ext (by simp only [AddSubgroupClass.coe_sub])
    rw [hrw]; exact hm
  obtain ⟨c₀, hc₀A, hc₀⟩ :=
