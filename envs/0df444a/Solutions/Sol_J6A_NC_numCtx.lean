**`numCtx P hP K`**: for large `n`, on every axis `k`, with `W = L + 2p + 10`: the geometry of
`axA_geom`, `pre · (t · post) = T`, `64 T < 2^W`, the descriptor entries below `2^W`,
`sWidth p α + 4 ≤ W`, `W + 4 ≤ 3p`, `p + 1 ≤ t`, `K t p⁶ ≤ T` and `T p ≤ cU6 P n A / (D + 1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6A.NC

open IntMul NLogN IntMul.Kappa.R6 J6Seg

set_option maxHeartbeats 4000000 in
theorem numCtx_sol_aux (P : Prm) (hP : P.Ok) (K : ℕ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, Ctx P n src D k K := by
  obtain ⟨n₁, hG⟩ := axA_geom P hP
  obtain ⟨n₂, hQ⟩ := qok_of P hP
  obtain ⟨n₃, hd2⟩ := eventually_d_ge P hP 2
  obtain ⟨B₀, hB⟩ := J6Seg.PreT.big_ev K P.x
  obtain ⟨n₄, hb4⟩ := eventually_b_ge (max B₀ 2)
  obtain ⟨n₅, hN⟩ := r6_axis_nat P hP
  obtain ⟨n₆, htb⟩ := t_big P hP
  refine ⟨max (max n₁ n₂) (max (max n₃ n₅) (max n₄ (max n₆ 2))),
    fun n hn src hs D hD k hk => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hn4 : n₄ ≤ n := by omega
  have hn5 : n₅ ≤ n := by omega
  have hn6 : n₆ ≤ n := by omega
  have hn7 : 2 ≤ n := by omega
  obtain ⟨gH, gM, gt, gWs, gst, gsep, gWw, -, gpre, gpost⟩ := hG n hn1 src hs D hD k hk
  have hq := hQ n hn2 src hs
  have hd : 2 ≤ dP6 P n := hd2 n hn3
  have hbB : max B₀ 2 ≤ bP6 n := hb4 n hn4
  have hkd : k < dP6 P n := by omega
  obtain ⟨-, -, hα2, -, -, -, hαp, -, hb', hd1⟩ := hN n hn5 src hs k hkd
  have h512 := htb n hn6
  set b := bP6 n with hbdef
  set b' := b'P6 P n with hb'def
  set p := pP6 P n with hpdef
  set d := dP6 P n with hddef
  set t := tF6 P n k with htdef
  set T := TP6 P n with hTdef
  set L := LP6 P n with hLdef
  set ℓ := ℓP6 P n with hℓdef
  set α := αN6 P n with hαdef
  set pre := preT P n D k
  set post := postT P n D k
  have hpe : p = 6 * b' := rfl
  have hb'e : b' = b ^ (1 + P.x) := rfl
  have hLb : L + 2 ≤ b' := hq.hLb
  have hℓ2 : 2 ≤ ℓ := hq.hℓ2
  -- `t = 2^h` or `2^(h+1)`, `h = ℓ - 1`
  have ht_lo : 2 ^ hN6 P n ≤ t := by simp only [htdef, tF6]; split_ifs <;> omega
  have htl : t ≤ 2 ^ ℓ := by
    have e : ℓ = hN6 P n + 1 := by simp only [hℓdef, hN6]; omega
    simp only [htdef, tF6]; rw [e, pow_succ]; split_ifs <;> omega
  -- `pre · t · post = T`
  have hprod := pre_t_post P n D k hk
  have hTW := TW_eq P n D hD (by omega)
  have hTeq : pre * (t * post) = T := by
    have : (List.ofFn (tD6 P n D)).prod = T := hTW
    rw [← this, ← hprod]; ring
  have htT : t ≤ T := by
    rw [← hTeq]
    calc t = 1 * (t * 1) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul gpre (Nat.mul_le_mul_left _ gpost)
  have hpreT : pre ≤ T := by
    rw [← hTeq]
    have : 1 ≤ t * post := Nat.mul_pos (by omega) gpost
    calc pre = pre * 1 := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul_left _ this
  have hpostT : post ≤ T := by
    rw [← hTeq]
    calc post = 1 * (1 * post) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul gpre (Nat.mul_le_mul_right _ (by omega))
  have hp1 : 1 ≤ p := by have := b'P6_pos P n; omega
  have hpt : p + 1 ≤ t := by omega
  have hpT : p ≤ T := by omega
  -- `2^W`
  set W := L + 2 * p + 10 with hWdef
  have hT2 : T = 2 ^ L := rfl
  have h64 : 64 * T < 2 ^ W := by
    rw [hWdef, pow_add, hT2]
    have : 64 < 2 ^ 10 := by norm_num
    have h1 : 1 ≤ 2 ^ (2 * p) := Nat.one_le_two_pow
    have h2 : 2 ^ L * 2 ^ (2 * p) * 2 ^ 10 = 2 ^ L * (2 ^ (2 * p) * 2 ^ 10) := by ring
    rw [pow_add, h2]
    have h3 : 64 < 2 ^ (2 * p) * 2 ^ 10 := by nlinarith
    have h4 : 0 < 2 ^ L := Nat.two_pow_pos L
    nlinarith
  have hpW : p < 2 ^ W := by
    have := Nat.lt_two_pow_self (n := p)
    exact lt_of_lt_of_le this (Nat.pow_le_pow_right (by norm_num) (by omega))
  have hdb : d ≤ b := d_le_b P hP n
  have hbb' : b ≤ b' := by
    rw [hb'e]; exact Nat.le_self_pow (by omega) b
  have hαle : α ≤ p := by nlinarith
  have hdL : ∀ x ∈ J6A.PA.dL k pre post (src k) t p α d, |x| < 2 ^ W := by
    intro x hx
    have hlt : ∀ a : ℕ, a < 2 ^ W → |((a : ℕ) : ℤ)| < 2 ^ W := fun a ha => by
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast ha
    simp only [J6A.PA.dL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact hlt _ (by omega)
    · exact hlt _ (by omega)
    · exact hlt _ (by omega)
    · exact hlt _ (by omega)
    · exact hlt _ (by omega)
    · exact hlt _ hpW
    · exact hlt _ (by omega)
    · exact hlt _ (by omega)
  have hmW : IntMul.HvdH.sWidth p α + 4 ≤ W := by
    have := J6Seg.sWidth_le p α hp1 hαp
    omega
  have hW3 : W + 4 ≤ 3 * p := by omega
  -- `K t p⁶ ≤ T`
  have hdl : d * ℓ ≤ L + d - 1 := by
    have := Nat.div_mul_le_self (L + d - 1) d
    simp only [hℓdef, ℓP6]; rw [mul_comm]; exact this
  have h2l : 2 * ℓ ≤ L + 1 := by
    have : 2 * (ℓ - 1) ≤ d * (ℓ - 1) := Nat.mul_le_mul_right _ hd
    have e : d * (ℓ - 1) = d * ℓ - d := by rw [Nat.mul_sub_one]
    omega
  have ht2 : t * t ≤ 2 * T := by
    calc t * t ≤ 2 ^ ℓ * 2 ^ ℓ := Nat.mul_le_mul htl htl
      _ = 2 ^ (2 * ℓ) := by ring
      _ ≤ 2 ^ (L + 1) := Nat.pow_le_pow_right (by norm_num) h2l
      _ = 2 * T := by rw [hT2, pow_succ]; ring
  have hn4' : 4 * n ≤ T * b' := by
    have := Nat.find_spec (LP6_exists P n)
    simp only [hTdef, TP6, LP6]; exact this
  have hbn : 2 ^ (b + 1) < 4 * n := by
    have := two_pow_b_lt hn7
    have e : 2 ^ (b + 1) = 4 * 2 ^ (b - 1) := by
      rw [show b + 1 = (b - 1) + 2 by omega, pow_add]; ring
    have h' : 2 ^ (b - 1) < n := this
    rw [e]; omega
  have hX : 2 * ((K * b ^ 5 * p ^ 9) * (K * b ^ 5 * p ^ 9)) ≤ T := by
    have h := hB b (le_of_max_le_left hbB)
    rw [← hb'e, ← hpe] at h
    have : 2 * ((K * b ^ 5 * p ^ 9) * (K * b ^ 5 * p ^ 9)) * b' ≤ T * b' :=
      h.trans (hbn.le.trans hn4')
    exact Nat.le_of_mul_le_mul_right this (by omega)
  have hKt : K * t * p ^ 6 ≤ T := by
    set X := K * b ^ 5 * p ^ 9 with hXd
    have hsq : (X * t) * (X * t) ≤ T * T := by
      calc (X * t) * (X * t) = (X * X) * (t * t) := by ring
        _ ≤ (X * X) * (2 * T) := Nat.mul_le_mul_left _ ht2
        _ = (2 * (X * X)) * T := by ring
        _ ≤ T * T := Nat.mul_le_mul_right _ hX
    have hXt : X * t ≤ T := Nat.mul_self_le_mul_self_iff.1 hsq
    have hb5 : 1 ≤ b ^ 5 := Nat.one_le_pow _ _ (by omega)
    have hp3 : 1 ≤ p ^ 3 := Nat.one_le_pow _ _ (by omega)
    have : K * t * p ^ 6 ≤ X * t := by
      rw [hXd]
      have e : K * b ^ 5 * p ^ 9 * t = (K * t * p ^ 6) * (b ^ 5 * p ^ 3) := by ring
      rw [e]
      exact Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega))
    omega
  -- the budget
  have hU : ∀ A : ℕ, ((T * p : ℕ) : ℝ) ≤ cU6 P n A / (D + 1) := by
    intro A
    have hdR : ((D : ℝ) + 1) = (d : ℝ) := by exact_mod_cast hD.symm
    have hd0 : (0 : ℝ) < d := by exact_mod_cast (show 0 < d by omega)
    rw [hdR, le_div_iff₀ hd0]
    have h2 := J6Seg.Side.dl_le_Ncost6 P n
    have hl0 : (0 : ℝ) ≤ (ℓ : ℝ) := Nat.cast_nonneg _
    have h3 : (1 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A := one_le_pow₀ (lgn_ge n)
    have h0 : (0 : ℝ) ≤ (T : ℝ) * (p : ℝ) := by positivity
    have hN0 : (d : ℝ) ≤ Ncost6 P n := by linarith
    have hd0' : (0 : ℝ) ≤ d := le_of_lt hd0
    have hcu : cU6 P n A = (T : ℝ) * (p : ℝ) * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A := rfl
    rw [hcu]
    have m1 : (T : ℝ) * p * d ≤ (T : ℝ) * p * Ncost6 P n := mul_le_mul_of_nonneg_left hN0 h0
    have m2 : (T : ℝ) * p * Ncost6 P n * 1 ≤
        (T : ℝ) * p * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A :=
      mul_le_mul_of_nonneg_left h3 (mul_nonneg h0 (by linarith))
    push_cast
    linarith
  exact ⟨gH, gM, gt, gWs, gst, gsep, gWw, gpre, gpost, hTeq, h64, hdL, hp1, by omega, hmW, hW3, hpt, htT, hpT,
    hKt, hU⟩

end J6A.NC
end

end

theorem solution : type_of% @J6A.NC.numCtx_sol_aux := @J6A.NC.numCtx_sol_aux
