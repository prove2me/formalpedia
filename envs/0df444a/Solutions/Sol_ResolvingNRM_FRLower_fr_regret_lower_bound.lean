        rcases fin2_eq_or j with rfl | rfl
        · have hsub : (fun l' : Fin 1 => (c : ℝ) - (tcInst r₁ r₂ hr₂ hr).A l' 0) =
              (fun _ => ((c - 1 : ℕ) : ℝ)) := by
            ext l'; rw [fin1_eq_zero l']; simp [tcInst, twoClass, Nat.cast_sub hc]
          have hs : replayStep (c, z₁, z₂) (0, true) = (c - 1, z₁ + 1, z₂) := by
            simp [replayStep, hc]
          have hsf : stepFn (rev₀, fun _ => (c : ℝ)) (0, true) =
              (rev₀ + r₁, fun _ => ((c - 1 : ℕ) : ℝ)) := by
            dsimp [stepFn]; rw [hcond', hsub]; simp [tcInst, twoClass]
          rw [hsf, hs]
          have hih := ih (rev₀ + r₁) (c - 1) (z₁ + 1) z₂
          convert hih using 2
          push_cast; ring
        · have hsub : (fun l' : Fin 1 => (c : ℝ) - (tcInst r₁ r₂ hr₂ hr).A l' 1) =
              (fun _ => ((c - 1 : ℕ) : ℝ)) := by
            ext l'; rw [fin1_eq_zero l']; simp [tcInst, twoClass, Nat.cast_sub hc]
          have hs : replayStep (c, z₁, z₂) (1, true) = (c - 1, z₁, z₂ + 1) := by
            simp [replayStep, hc]
          have hsf : stepFn (rev₀, fun _ => (c : ℝ)) (1, true) =
              (rev₀ + r₂, fun _ => ((c - 1 : ℕ) : ℝ)) := by
            dsimp [stepFn]; rw [hcond', hsub]; simp [tcInst, twoClass]
          rw [hsf, hs]
          have hih := ih (rev₀ + r₂) (c - 1) z₁ (z₂ + 1)
          convert hih using 2
          push_cast; ring
      · have hcond' : decide (∀ l' : Fin 1, (tcInst r₁ r₂ hr₂ hr).A l' j ≤ (c : ℝ)) = false :=
          decide_eq_false (mt hcond.mp hc)
        have hs : replayStep (c, z₁, z₂) (j, true) = (c, z₁, z₂) := by simp [replayStep, hc]
        have hsf : stepFn (rev₀, fun _ => (c : ℝ)) (j, true) = (rev₀, fun _ => (c : ℝ)) := by
          dsimp [stepFn]; rw [hcond']; simp
        rw [hsf, hs]
        exact ih rev₀ c z₁ z₂
    · have hbf : b = false := by cases b <;> tauto
      subst hbf
      have hs : replayStep (c, z₁, z₂) (j, false) = (c, z₁, z₂) := by simp [replayStep]
      have hsf : stepFn (rev₀, fun _ => (c : ℝ)) (j, false) = (rev₀, fun _ => (c : ℝ)) := by
        dsimp [stepFn]
      rw [hsf, hs]
      exact ih rev₀ c z₁ z₂

lemma histRev_append_singleton
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T : ℕ) (h : History) (w : Window) :
    let out := runWindow (tcInst r₁ r₂ hr₂ hr) (fun _ => (capAfter T h : ℝ)) (windowList w)
    histRev T r₁ r₂ (h ++ [w]) = histRev T r₁ r₂ h + out.1 ∧
      out.2 = (fun _ => (capAfter T (h ++ [w]) : ℝ)) := by
  have hrw := runWindow_tcInst_eq_replayList r₁ r₂ hr₂ hr (capAfter T h) (windowList w)
  have hrep := replayHistory_append_singleton T h w
  simp only [histRev, admHigh, admLow, capAfter] at hrw hrep ⊢
  rw [hrw, hrep]
  constructor
  · push_cast; ring
  · rfl

/-! ### Minimal Hindsight LP (`piValue`) Facts -/

private lemma tcInst_mulVec_zero
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (y : Fin 2 → ℝ) :
    ((tcInst r₁ r₂ hr₂ hr).A *ᵥ y) 0 = y 0 + y 1 := by
  simp [tcInst, twoClass, mulVec, dotProduct, Fin.sum_univ_two]

private lemma tcInst_dotProduct_r
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (y : Fin 2 → ℝ) :
    (tcInst r₁ r₂ hr₂ hr).r ⬝ᵥ y = r₁ * y 0 + r₂ * y 1 := by
  simp [tcInst, twoClass, dotProduct, Fin.sum_univ_two]

private lemma bddAbove_piSet
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (T : ℕ) (y₀ : Fin 2 → ℝ) :
    BddAbove {v : ℝ | ∃ y : Fin 2 → ℝ,
      (tcInst r₁ r₂ hr₂ hr).A *ᵥ y ≤ initialCapacity T ∧
        0 ≤ y ∧ y ≤ y₀ ∧ v = (tcInst r₁ r₂ hr₂ hr).r ⬝ᵥ y} := by
  refine ⟨r₁ * (T : ℝ), ?_⟩
  rintro v ⟨y, hAy, hy0, _, rfl⟩
  have hA0 := hAy 0
  rw [tcInst_mulVec_zero, initialCapacity] at hA0
  rw [tcInst_dotProduct_r]
  have hy0_0 : 0 ≤ y 0 := hy0 0
  have hy0_1 : 0 ≤ y 1 := hy0 1
  nlinarith

lemma piValue_tcInst_nonneg
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T : ℕ) (y₀ : Fin 2 → ℝ) (hy₀ : 0 ≤ y₀) :
    0 ≤ RLPBidPrice.Unbiased.piValue
      (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T) y₀ := by
  unfold RLPBidPrice.Unbiased.piValue
  refine le_csSup (bddAbove_piSet r₁ r₂ hr₂ hr T y₀) ⟨0, ?_, le_rfl, hy₀, by simp⟩
  intro l; rw [fin1_eq_zero l]; simp [initialCapacity]

lemma piValue_tcInst_le
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T : ℕ) (y₀ : Fin 2 → ℝ) (hy₀ : 0 ≤ y₀) :
    RLPBidPrice.Unbiased.piValue
      (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T) y₀ ≤ r₁ * (T : ℝ) := by
  unfold RLPBidPrice.Unbiased.piValue
  have h0 : ({v : ℝ | ∃ y : Fin 2 → ℝ,
      (tcInst r₁ r₂ hr₂ hr).A *ᵥ y ≤ initialCapacity T ∧
        0 ≤ y ∧ y ≤ y₀ ∧ v = (tcInst r₁ r₂ hr₂ hr).r ⬝ᵥ y}).Nonempty := by
    refine ⟨0, 0, ?_, le_rfl, hy₀, by simp⟩
    intro l; rw [fin1_eq_zero l]; simp [initialCapacity]
  refine csSup_le h0 ?_
  rintro v ⟨y, hAy, hy0, _, rfl⟩
  have hA0 := hAy 0
  rw [tcInst_mulVec_zero, initialCapacity] at hA0
  rw [tcInst_dotProduct_r]
  have hy0_0 : 0 ≤ y 0 := hy0 0
  have hy0_1 : 0 ≤ y 1 := hy0 1
  nlinarith

lemma histRev_le_piValue
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T : ℕ) (h : History) :
    histRev T r₁ r₂ h ≤
      RLPBidPrice.Unbiased.piValue
        (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
        ![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)] := by
  unfold RLPBidPrice.Unbiased.piValue
  refine le_csSup (bddAbove_piSet r₁ r₂ hr₂ hr T _)
    ⟨![(admHigh T h : ℝ), (admLow T h : ℝ)], ?_, ?_, ?_, ?_⟩
  · intro l
    rw [fin1_eq_zero l, tcInst_mulVec_zero]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, initialCapacity]
    have hsum := capAfter_add_adm T h
    have hle : admHigh T h + admLow T h ≤ T := by omega
    exact_mod_cast hle
  · intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
  · intro j; rcases fin2_eq_or j with rfl | rfl
    · simp; exact admHigh_le_offered T h
    · simp; exact admLow_le_offered T h
  · rw [tcInst_dotProduct_r]; simp [histRev]

lemma piValue_tcInst_eq_of_ge
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T a₁ a₂ : ℕ) (ha₁ : T ≤ a₁) :
    RLPBidPrice.Unbiased.piValue
      (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
      ![(a₁ : ℝ), (a₂ : ℝ)] = r₁ * (T : ℝ) := by
  have hy₀ : 0 ≤ (![(a₁ : ℝ), (a₂ : ℝ)] : Fin 2 → ℝ) := by
    intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
  apply le_antisymm (piValue_tcInst_le r₁ r₂ hr₂ hr T _ hy₀)
  unfold RLPBidPrice.Unbiased.piValue
  refine le_csSup (bddAbove_piSet r₁ r₂ hr₂ hr T _) ⟨![(T : ℝ), 0], ?_, ?_, ?_, ?_⟩
  · intro l
    rw [fin1_eq_zero l, tcInst_mulVec_zero]; simp [initialCapacity]
  · intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
  · intro j; rcases fin2_eq_or j with rfl | rfl
    · simp; exact ha₁
    · simp
  · rw [tcInst_dotProduct_r]; simp

lemma histRev_nonneg
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (T : ℕ) (h : History) :
    0 ≤ histRev T r₁ r₂ h := by
  unfold histRev
  have hr₁ : 0 < r₁ := lt_trans hr₂ hr
  positivity

lemma histRev_le
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) (T : ℕ) (h : History) :
    histRev T r₁ r₂ h ≤ r₁ * (T : ℝ) := by
  have hy₀ : 0 ≤ (![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)] : Fin 2 → ℝ) := by
    intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
  exact le_trans (histRev_le_piValue r₁ r₂ hr₂ hr T h)
    (piValue_tcInst_le r₁ r₂ hr₂ hr T _ hy₀)

end ResolvingNRM.FRLower.ProofPlan
