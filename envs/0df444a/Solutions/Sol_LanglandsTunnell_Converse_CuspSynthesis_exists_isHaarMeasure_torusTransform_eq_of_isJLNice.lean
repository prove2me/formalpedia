private theorem t1005 {F G : ℂ → ℂ} (hF : d117 F) (hG : d117 G) :
    d117 fun s => F s + G s := by
  intro A B
  obtain ⟨C₁, D₁, h₁⟩ := hF A B
  obtain ⟨C₂, D₂, h₂⟩ := hG A B
  refine ⟨|C₁| + |C₂|, |D₁| + |D₂|, fun s ha hb => ?_⟩
  have hD₁ : Real.exp (D₁ * |s.im|) ≤ Real.exp ((|D₁| + |D₂|) * |s.im|) := by
    apply Real.exp_le_exp.2
    have := abs_nonneg s.im
    nlinarith [le_abs_self D₁, abs_nonneg D₂]
  have hD₂ : Real.exp (D₂ * |s.im|) ≤ Real.exp ((|D₁| + |D₂|) * |s.im|) := by
    apply Real.exp_le_exp.2
    have := abs_nonneg s.im
    nlinarith [le_abs_self D₂, abs_nonneg D₁]
  have e₁ : ‖F s‖ ≤ |C₁| * Real.exp ((|D₁| + |D₂|) * |s.im|) :=
    (h₁ s ha hb).trans (mul_le_mul (le_abs_self _) hD₁ (Real.exp_pos _).le (abs_nonneg _))
  have e₂ : ‖G s‖ ≤ |C₂| * Real.exp ((|D₁| + |D₂|) * |s.im|) :=
    (h₂ s ha hb).trans (mul_le_mul (le_abs_self _) hD₂ (Real.exp_pos _).le (abs_nonneg _))
  calc ‖F s + G s‖ ≤ ‖F s‖ + ‖G s‖ := norm_add_le _ _
    _ ≤ |C₁| * Real.exp ((|D₁| + |D₂|) * |s.im|) + |C₂| * Real.exp ((|D₁| + |D₂|) * |s.im|) := add_le_add e₁ e₂
    _ = (|C₁| + |C₂|) * Real.exp ((|D₁| + |D₂|) * |s.im|) := by ring

private theorem t1006 {ι : Type*} (t : Finset ι) (F : ι → ℂ → ℂ)
    (hF : ∀ i ∈ t, d117 (F i)) : d117 fun s => ∑ i ∈ t, F i s := by
