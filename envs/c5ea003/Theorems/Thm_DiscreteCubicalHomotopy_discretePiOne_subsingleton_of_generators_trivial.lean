open PresentedGroup

open DiscreteCubicalHomotopy

/-! ## The synthetic discrete fundamental group -/

theorem DiscreteCubicalHomotopy.discretePiOne_subsingleton_of_generators_trivial    {E : Type*} {rels : Set (FreeGroup E)}
    (h : ∀ a, (PresentedGroup.of a : DiscretePiOne rels) = 1) :
    Subsingleton (DiscretePiOne rels) := by sorry
