variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ}

theorem NLogN.KFN.step_child {k Ek DWk Wk : ℕ} {ck : ℝ} (IH : Lv Isym iprog K W m r Z Ψ k Ek DWk Wk ck) (G : ℝ)
    (hG : 0 ≤ G) (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    (pos : Fin m × Fin (m ^ k) → ℕ) (hinj : Function.Injective pos) {t S0 B : ℕ}
    (hpos : ∀ p, pos p < t) (haff : AffK2 K t m k pos) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hdvd : W ^ k ∣ B)
    (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (w0 : Fin W) (h : Fin m) (fwd : Bool)
    (O : ℕ) (hO : DWk + (Ek + 2) * W + Ek + 4 ≤ O) :
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      RImplI Isym iprog r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.child w0 h fwd : RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ Ek ∧ dw ≤ DWk + (Ek + 2) * W ∧ ∀ w, (cost w : ℝ) ≤
        ck * ((nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + Wk) : ℝ) +
        ((alN W A : ℝ) + G) * ((W * nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + O) : ℝ) := by sorry
