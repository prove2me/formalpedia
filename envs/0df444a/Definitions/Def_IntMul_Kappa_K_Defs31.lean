-- Source module: Solutions.KFV54Par
/-!
# KFV §54: the numeric side conditions of the uniform Proposition 18 (`Par18Need`)

For the paper's parameters (`p = pP n`, `ℓ = ℓP n`, `K = KP n`, `D = dP n - 1`) the side conditions of the Proposition 18 program hold for
all large `n`. `Zm = Dℓ + ℓ + 8` and `Bm = p + 2 + Zm + Dℓ + D + 1` bound the counter size `Z` and
the register bound `B` for every axis-length pattern (`n18 ≤ D ℓ`).
-/

namespace NLogN.KFV

open IntMul IntMul.OpenAI.Glue

/-- **The width condition of the uniform Proposition 14** for its constant `A`: the width growth
`EwB A D` fits in `p + 3` for large `n`. It holds for fixed `A` when `log_{10^6} Gb(A) < 2^75`
(`EwB ≈ Gb^2 · D^{log_{10^6} Gb}`, `D ≈ b^{2^-75}`, `p = 6b`), so it is supplied with `A`. -/
def EwB18 (A : ℕ) : Prop := ∃ n₂ : ℕ, ∀ n : ℕ, n₂ ≤ n → KFM.EwB A (IntMul.OpenAI.Glue.dP n - 1) ≤ pP n + 3

/-- **The numeric side conditions of Proposition 18** (pure arithmetic of the parameters). -/
def Par18Need : Prop :=
  ∃ n₁ : ℕ, ∀ n : ℕ, IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n →
    let p := pP n
    let ℓ := ℓP n
    let K := KP n
    let D := IntMul.OpenAI.Glue.dP n - 1
    let Zm := D * ℓ + ℓ + 8
    let Bm := p + 2 + Zm + D * ℓ + D + 1
    2 ≤ D ∧ 2 ≤ ℓ ∧ 6 ≤ K ∧ K + 1 ≤ ℓ ∧
    80 * Zm * (Zm + 2) ≤ 2 ^ K ∧
    zsz (p : ℤ) ≤ ℓ ∧
    (K : ℝ) ≤ 2 * (D : ℝ) ^ ((2 : ℝ)⁻¹ ^ 56) ∧
    2 * p + 7 < 2 ^ ℓ ∧
    2 * (2 * Zm + 4) ^ 3 + 2 ≤ 2 ^ ℓ ∧
    (K * D + 11) * (Zm + 2) ≤ 2 ^ ℓ ∧
    (∀ B ≤ Bm, 10 ^ 12 * (B + 2) ^ 3 + 16 * KFUU.cU B ≤ 2 ^ ℓ) ∧
    2 * 2 ^ (D * ℓ) * (3 * ℓ + 1) ≤ 2 ^ p ∧
    D * ℓ ≤ p

end NLogN.KFV

end

