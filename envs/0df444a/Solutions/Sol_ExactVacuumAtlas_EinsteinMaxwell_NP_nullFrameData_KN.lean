`l^μ∂_μ = Δ⁻¹((r²+a²)∂_t + Δ∂_r + a∂_φ)`, `n^μ∂_μ = (2ρ̄ρ̄*)⁻¹((r²+a²)∂_t − Δ∂_r + a∂_φ)`,
`m^μ∂_μ = sinθ/(ρ̄√2) (ia∂_t + (1/sinθ)∂_θ + (i/sin²θ)∂_φ)`, with `ρ̄ = q`, `ρ̄* = q̄`. -/

section Display
variable {M a Q : ℝ} {x : Pt 4}

end Display

/-! ### Real Gram identities on `domReg` -/

section RealGram
variable {M a Q : ℝ} {x : Pt 4}

theorem rg_ll (hx : x ∈ domReg M a Q) : rcontr (gKN M a Q) x (lR M a Q x) (lR M a Q x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, lR, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

theorem rg_ln (hx : x ∈ domReg M a Q) : rcontr (gKN M a Q) x (lR M a Q x) (nR M a Q x) = -1 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, lR, nR, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

theorem rg_nn (hx : x ∈ domReg M a Q) : rcontr (gKN M a Q) x (nR M a Q x) (nR M a Q x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, nR, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

theorem rg_lRe (x : Pt 4) : rcontr (gKN M a Q) x (lR M a Q x) mRe = 0 := by
  simp [rcontr, Fin.sum_univ_four, lR, mRe, gKN]

theorem rg_lIm (hx : x ∈ domReg M a Q) : rcontr (gKN M a Q) x (lR M a Q x) (mIm a x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, lR, mIm, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

theorem rg_nRe (x : Pt 4) : rcontr (gKN M a Q) x (nR M a Q x) mRe = 0 := by
  simp [rcontr, Fin.sum_univ_four, nR, mRe, gKN]

theorem rg_nIm (hx : x ∈ domReg M a Q) : rcontr (gKN M a Q) x (nR M a Q x) (mIm a x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, nR, mIm, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

theorem rg_ReRe (x : Pt 4) : rcontr (gKN M a Q) x mRe mRe = Sig a (x 1) (x 2) := by
  simp [rcontr, Fin.sum_univ_four, mRe, gKN]

theorem rg_ReIm (x : Pt 4) : rcontr (gKN M a Q) x mRe (mIm a x) = 0 := by
  simp [rcontr, Fin.sum_univ_four, mRe, mIm, gKN]

theorem rg_ImIm (hx : x ∈ domReg M a Q) :
    rcontr (gKN M a Q) x (mIm a x) (mIm a x) = Sig a (x 1) (x 2) := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, mIm, gKN]
  field_simp
  simp only [Sig, Del, cos_sq']; ring

end RealGram

/-! ### The 16 complex-bilinear Gram entries -/

section Gram
variable {M a Q : ℝ} {x : Pt 4}

private theorem gsymm (M a Q : ℝ) (x : Pt 4) : ∀ i j, gKN M a Q i j x = gKN M a Q j i x :=
  fun i j => KN.symm M a Q x i j

theorem gram_ll (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knL M a Q x) (knL M a Q x) = 0 := by
  rw [knL_eq, ccontr_ofReal, rg_ll hx, Complex.ofReal_zero]

theorem gram_ln (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knL M a Q x) (knN M a Q x) = -1 := by
  rw [knL_eq, knN_eq, ccontr_ofReal, rg_ln hx]; push_cast; ring

theorem gram_nn (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knN M a Q x) (knN M a Q x) = 0 := by
  rw [knN_eq, ccontr_ofReal, rg_nn hx, Complex.ofReal_zero]

theorem gram_lm (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knL M a Q x) (knM a x) = 0 := by
  rw [knL_eq, knM_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rg_lRe x, rg_lIm hx]; simp

theorem gram_lmbar (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knL M a Q x) (knMbar a x) = 0 := by
  rw [knL_eq, knMbar_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rg_lRe x, rg_lIm hx]; simp

theorem gram_nm (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knN M a Q x) (knM a x) = 0 := by
  rw [knN_eq, knM_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rg_nRe x, rg_nIm hx]; simp

theorem gram_nmbar (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knN M a Q x) (knMbar a x) = 0 := by
  rw [knN_eq, knMbar_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rg_nRe x, rg_nIm hx]; simp

theorem gram_mm (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knM a x) (knM a x) = 0 := by
  rw [knM_eq, ccontr_lin_left, ccontr_lin_right, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal,
    ccontr_ofReal, ccontr_ofReal, rg_ReRe, rg_ReIm, rcontr_symm (gsymm M a Q x), rg_ReIm, rg_ImIm hx]
  push_cast
  linear_combination (mFac a x ^ 2 * ((Sig a (x 1) (x 2) : ℝ) : ℂ)) * Complex.I_sq

theorem gram_mmbar (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knM a x) (knMbar a x) = 1 := by
  have key := mFac_mul_conj (domReg_S hx)
  rw [knM_eq, knMbar_eq, ccontr_lin_left, ccontr_lin_right, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal,
    ccontr_ofReal, ccontr_ofReal, rg_ReRe, rg_ReIm, rcontr_symm (gsymm M a Q x), rg_ReIm, rg_ImIm hx]
  push_cast
  linear_combination key + (-(mFac a x * conj (mFac a x) * ((Sig a (x 1) (x 2) : ℝ) : ℂ))) * Complex.I_sq

theorem gram_mbarmbar (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knMbar a x) (knMbar a x) = 0 := by
  rw [knMbar_eq, ccontr_lin_left, ccontr_lin_right, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal,
    ccontr_ofReal, ccontr_ofReal, rg_ReRe, rg_ReIm, rcontr_symm (gsymm M a Q x), rg_ReIm, rg_ImIm hx]
  push_cast
  linear_combination (conj (mFac a x) ^ 2 * ((Sig a (x 1) (x 2) : ℝ) : ℂ)) * Complex.I_sq

theorem gram_nl (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knN M a Q x) (knL M a Q x) = -1 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_ln hx

theorem gram_ml (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knM a x) (knL M a Q x) = 0 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_lm hx

theorem gram_mn (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knM a x) (knN M a Q x) = 0 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_nm hx

theorem gram_mbarl (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knMbar a x) (knL M a Q x) = 0 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_lmbar hx

theorem gram_mbarn (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knMbar a x) (knN M a Q x) = 0 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_nmbar hx

theorem gram_mbarm (hx : x ∈ domReg M a Q) : ccontr (gKN M a Q) x (knMbar a x) (knM a x) = 1 := by
  rw [ccontr_symm (gsymm M a Q x)]; exact gram_mmbar hx

/-- **All 16 Gram entries**: `g(e_A, e_B) = etaNull A B` (complex-bilinear contraction). -/
theorem gram (hx : x ∈ domReg M a Q) (A B : Fin 4) :
    ccontr (gKN M a Q) x (knFrame M a Q x A) (knFrame M a Q x B) = etaNull A B := by
  fin_cases A <;> fin_cases B <;> simp only [knFrame, etaNull] <;> simp
  exacts [gram_ll hx, gram_ln hx, gram_lm hx, gram_lmbar hx, gram_nl hx, gram_nn hx, gram_nm hx, gram_nmbar hx,
    gram_ml hx, gram_mn hx, gram_mm hx, gram_mmbar hx, gram_mbarl hx, gram_mbarn hx, gram_mbarm hx,
    gram_mbarmbar hx]

/-- Matrix form `Tᵀ g T = etaNull` (`Tᵀ`, not the conjugate transpose). -/
theorem gram_matrix (hx : x ∈ domReg M a Q) : (knT M a Q x)ᵀ * cmat (gKN M a Q) x * knT M a Q x = etaNull := by
  ext A B
  rw [transpose_mul_cmat_mul_apply]
  exact gram hx A B

end Gram

/-! ### Dual coframe, two-sided inverse, inverse metric, reconstruction -/

theorem etaNull_mul_self : etaNull * etaNull = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [etaNull, Matrix.mul_apply, Fin.sum_univ_four]

section Dual
variable {M a Q : ℝ} {x : Pt 4}

/-- `θ^A(e_B) = δ^A_B`. -/
theorem knDual_mul_knT (hx : x ∈ domReg M a Q) : knDual M a Q x * knT M a Q x = 1 := by
  have hg := gram_matrix hx
  simp only [Matrix.mul_assoc] at hg
  simp only [knDual, Matrix.mul_assoc, hg, etaNull_mul_self]

end Dual

/-! ### `C^∞` (order `∞`) of every frame component on `domReg` -/

section Smooth
variable (M a Q : ℝ)

private theorem cdOn_ofReal {f : Pt 4 → ℝ} {s : Set (Pt 4)} (hf : ContDiffOn ℝ ∞ f s) :
    ContDiffOn ℝ ∞ (fun x => (f x : ℂ)) s :=
  Complex.ofRealCLM.contDiff.comp_contDiffOn hf

private theorem cd_qK : ContDiff ℝ ∞ (fun x : Pt 4 => qK a x) := by
  have e : (fun x : Pt 4 => qK a x) =
      fun x => ((x 1 : ℝ) : ℂ) + Complex.I * ((a * cos (x 2) : ℝ) : ℂ) := funext (qK_eq a)
  rw [e]
  have h1 : ContDiff ℝ ∞ (fun x : Pt 4 => ((x 1 : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ 1)
  have h2 : ContDiff ℝ ∞ (fun x : Pt 4 => ((a * cos (x 2) : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul (Real.contDiff_cos.comp (contDiff_apply ℝ ℝ 2)))
  exact h1.add (contDiff_const.mul h2)

private theorem cd_qbarK : ContDiff ℝ ∞ (fun x : Pt 4 => qbarK a x) := by
  have e : (fun x : Pt 4 => qbarK a x) =
      fun x => ((x 1 : ℝ) : ℂ) - Complex.I * ((a * cos (x 2) : ℝ) : ℂ) := funext (qbarK_eq a)
  rw [e]
  have h1 : ContDiff ℝ ∞ (fun x : Pt 4 => ((x 1 : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ 1)
  have h2 : ContDiff ℝ ∞ (fun x : Pt 4 => ((a * cos (x 2) : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul (Real.contDiff_cos.comp (contDiff_apply ℝ ℝ 2)))
  exact h1.sub (contDiff_const.mul h2)

private theorem cdOn_inv_sqrt2_qK :
    ContDiffOn ℝ ∞ (fun x : Pt 4 => (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)⁻¹) (domReg M a Q) :=
  (contDiff_const.mul (cd_qK a)).contDiffOn.inv
    (fun _ hy => mul_ne_zero sqrt2C_ne_zero (qK_ne_zero (domReg_S hy)))

private theorem cdOn_inv_sqrt2_qbarK :
    ContDiffOn ℝ ∞ (fun x : Pt 4 => (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x)⁻¹) (domReg M a Q) :=
  (contDiff_const.mul (cd_qbarK a)).contDiffOn.inv
    (fun _ hy => mul_ne_zero sqrt2C_ne_zero (qbarK_ne_zero (domReg_S hy)))

private theorem cdOn_sinInv : ContDiffOn ℝ ∞ (fun x : Pt 4 => 1 / sin (x 2)) (domReg M a Q) :=
  ContDiffOn.div contDiffOn_const (Real.contDiff_sin.comp (contDiff_apply ℝ ℝ 2)).contDiffOn
    (fun _ hy => domReg_s hy)

private theorem cdOn_asin : ContDiffOn ℝ ∞ (fun x : Pt 4 => a * sin (x 2)) (domReg M a Q) :=
  (contDiff_const.mul (Real.contDiff_sin.comp (contDiff_apply ℝ ℝ 2))).contDiffOn

private theorem cdOn_vec4 {f0 f1 f2 f3 : Pt 4 → ℂ} {s : Set (Pt 4)} (h0 : ContDiffOn ℝ ∞ f0 s)
    (h1 : ContDiffOn ℝ ∞ f1 s) (h2 : ContDiffOn ℝ ∞ f2 s) (h3 : ContDiffOn ℝ ∞ f3 s) (μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun x => (![f0 x, f1 x, f2 x, f3 x] : Fin 4 → ℂ) μ) s := by
  fin_cases μ
  exacts [h0, h1, h2, h3]

theorem contDiffOn_knL (μ : Fin 4) : ContDiffOn ℝ ∞ (fun x => knL M a Q x μ) (domReg M a Q) := by
  refine cdOn_vec4 (cdOn_ofReal ?_) contDiffOn_const contDiffOn_const (cdOn_ofReal ?_) μ
  · simp only [Del]
    exact ContDiffOn.div (by fun_prop) (by fun_prop) (fun _ hy => domReg_D hy)
  · simp only [Del]
    exact ContDiffOn.div contDiffOn_const (by fun_prop) (fun _ hy => domReg_D hy)

theorem contDiffOn_knN (μ : Fin 4) : ContDiffOn ℝ ∞ (fun x => knN M a Q x μ) (domReg M a Q) := by
  refine cdOn_vec4 (cdOn_ofReal ?_) (cdOn_ofReal ?_) contDiffOn_const (cdOn_ofReal ?_) μ
  · simp only [Sig]
    exact ContDiffOn.div (by fun_prop) (by fun_prop) (fun _ hy => mul_ne_zero two_ne_zero (domReg_S hy))
  · simp only [Sig, Del]
    exact ContDiffOn.div (by fun_prop) (by fun_prop) (fun _ hy => mul_ne_zero two_ne_zero (domReg_S hy))
  · simp only [Sig]
    exact ContDiffOn.div contDiffOn_const (by fun_prop) (fun _ hy => mul_ne_zero two_ne_zero (domReg_S hy))

theorem contDiffOn_knM (μ : Fin 4) : ContDiffOn ℝ ∞ (fun x => knM a x μ) (domReg M a Q) := by
  have e : (fun x => knM a x μ) = fun x =>
      (![Complex.I * ((a * sin (x 2) : ℝ) : ℂ), 0, 1, Complex.I * ((1 / sin (x 2) : ℝ) : ℂ)] : Fin 4 → ℂ) μ *
        (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)⁻¹ := by
    funext x; simp only [knM, div_eq_mul_inv]
  rw [e]
  exact (cdOn_vec4 (contDiffOn_const.mul (cdOn_ofReal (cdOn_asin M a Q))) contDiffOn_const contDiffOn_const
    (contDiffOn_const.mul (cdOn_ofReal (cdOn_sinInv M a Q))) μ).mul (cdOn_inv_sqrt2_qK M a Q)

theorem contDiffOn_knMbar (μ : Fin 4) : ContDiffOn ℝ ∞ (fun x => knMbar a x μ) (domReg M a Q) := by
  have e : (fun x => knMbar a x μ) = fun x =>
      (![-(Complex.I * ((a * sin (x 2) : ℝ) : ℂ)), 0, 1, -(Complex.I * ((1 / sin (x 2) : ℝ) : ℂ))] :
          Fin 4 → ℂ) μ * (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x)⁻¹ := by
    funext x; simp only [knMbar, div_eq_mul_inv]
  rw [e]
  exact (cdOn_vec4 (contDiffOn_const.mul (cdOn_ofReal (cdOn_asin M a Q))).neg contDiffOn_const contDiffOn_const
    (contDiffOn_const.mul (cdOn_ofReal (cdOn_sinInv M a Q))).neg μ).mul (cdOn_inv_sqrt2_qbarK M a Q)

/-- Every component `e_A^μ` of the frame is `C^∞` (order `∞`) in the real coordinates on `domReg`. -/
theorem contDiffOn_knFrame (A μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun x => knFrame M a Q x A μ) (domReg M a Q) := by
  fin_cases A
  · exact contDiffOn_knL M a Q μ
