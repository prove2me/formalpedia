        ∀ τ : ↥K ≃ₐ[L] ↥K, ModularCurve.FullLevel.IsLevelAutAt L (q * ℓ) ξ (q * ℓ) ((q * ℓ) ^ 2 * M')
            (ModularCurve.FullLevel.levelH (q * ℓ) M') γ⁻¹ K τ →
          (∀ (b : ↥(chartAlgFin A (↥K) j)) (hb : τ (b : ↥K) ∈ chartAlgFin A (↥K) j),
              b ∈ y ↔ (⟨τ (b : ↥K), hb⟩ : ↥(chartAlgFin A (↥K) j)) ∈ y) →
          ∀ f : ↥K, f ∈ W ↔ τ f ∈ W))
    :
      ∀ 𝔭 𝔭' : Ideal ↥(chartAlgFin A (↥K) j), (𝔭.IsPrime ∧ algebraMap A ↥(chartAlgFin A (↥K) j) ϖ ∈ 𝔭 ∧ 𝔭 ≤ y ∧ 𝔭 ≠ y) → (𝔭'.IsPrime ∧ algebraMap A ↥(chartAlgFin A (↥K) j) ϖ ∈ 𝔭' ∧ 𝔭' ≤ y ∧ 𝔭' ≠ y) →
        ∃ (γ : SL(2, ℤ)) (_ : γ ∈ CongruenceSubgroup.Gamma0 M') (τ : ↥K ≃ₐ[L] ↥K)
          (_ : ModularCurve.FullLevel.IsLevelAutAt L (q * ℓ) ξ (q * ℓ) ((q * ℓ) ^ 2 * M') (ModularCurve.FullLevel.levelH (q * ℓ) M') γ⁻¹ K τ),
          (∀ f : ↥K, f ∈ W ↔ τ f ∈ W) ∧
          (∀ a : ↥K, a ∈ chartAlgFin A (↥K) j → τ a ∈ chartAlgFin A (↥K) j) ∧
          (∀ (c : ↥(chartAlgFin A (↥K) j)) (hc : τ (c : ↥K) ∈ chartAlgFin A (↥K) j), c ∈ 𝔭 ↔ (⟨τ (c : ↥K), hc⟩ : ↥(chartAlgFin A (↥K) j)) ∈ 𝔭') := by sorry
