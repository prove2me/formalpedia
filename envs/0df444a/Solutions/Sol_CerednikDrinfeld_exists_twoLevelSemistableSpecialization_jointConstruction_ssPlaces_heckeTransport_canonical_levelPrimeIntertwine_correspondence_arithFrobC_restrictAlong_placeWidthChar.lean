  have hS₂ := legS A M q' hq' hA hq'M D₂ h₂ e₂ hc.2.2.2.1 (fun v => (hw₂ v).symm.trans (hpin₂ v))
  refine ⟨spliceT A (M * s) q' hq' D₁ h₁, spliceN A (M * s) q' hq' D₁ h₁,
          spliceT A M q' hq' D₂ h₂, spliceN A M q' hq' D₂ h₂,

          fun ℓ t => splice_colsum A (M * s) q' hq' D₁ h₁ ℓ t,
          fun ℓ => splice_transport A (M * s) q' hq' D₁ h₁ ℓ,
