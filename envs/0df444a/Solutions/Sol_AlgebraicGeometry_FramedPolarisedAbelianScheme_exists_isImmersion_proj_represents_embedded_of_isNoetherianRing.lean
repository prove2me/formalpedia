variable {B : Type} [CommRing B] {N g : ℕ} {hf : ℕ → ℕ} (C : KCtx B N g hf)

theorem Φ_congr {R : Type} [CommRing R] {p p' : Point R N hf} (h : p = p') :
    ∃ e : (C.Φ R p).1 ≅ (C.Φ R p').1, e.hom ≫ (C.Φ R p').2 = (C.Φ R p).2 := by
  subst h; exact ⟨Iso.refl _, Category.id_comp _⟩

variable {n : ℕ} (F : C.FramedPt n)

section PT
variable {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R)

noncomputable def eX : C.Z (C.ptW F X).1 ≅ X.A :=
  (C.Φ_congr (C.q_ptW F X)).choose ≪≫ (F.iso R X).choose

theorem eX_toProj : (C.eX F X).hom ≫ X.frame.toProj = C.ι (C.ptW F X).1 := by
  show ((C.Φ_congr (C.q_ptW F X)).choose.hom ≫ (F.iso R X).choose.hom) ≫ X.frame.toProj = _
  rw [Category.assoc, (F.iso R X).choose_spec, (C.Φ_congr (C.q_ptW F X)).choose_spec]; rfl

theorem eX_f : (C.eX F X).hom ≫ X.f = C.f (C.ptW F X).1 := by
  rw [← X.frame.toProj_π, ← Category.assoc, eX_toProj]; rfl

theorem eX_inv_ι : (C.eX F X).inv ≫ C.ι (C.ptW F X).1 = X.frame.toProj := by
  rw [← eX_toProj, Iso.inv_hom_id_assoc]

theorem β_ptW : C.β (C.ptW F X).1 = algebraMap B R := by
  have h : Spec.map (CommRingCat.ofHom (C.β (C.ptW F X).1)) = Spec.map (CommRingCat.ofHom (algebraMap B R)) := by
    rw [specMap_β]; exact (C.ptW F X).2
  exact congrArg CommRingCat.Hom.hom (Spec.map_injective h)

theorem algebra_eq_ptW : (C.β (C.ptW F X).1).toAlgebra = (inferInstance : Algebra B R) :=
  Algebra.algebra_ext _ _ fun r => by rw [RingHom.algebraMap_toAlgebra, β_ptW]

noncomputable def secX (j : Fin (2 * g + 1)) : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) X.f :=
  if h : j.1 = 0 then X.L.one (𝟙 _) else X.P ⟨j.1 - 1, by omega⟩

theorem framedSec_eq_secX (j : Fin (2 * g + 1)) :
    framedSec (B := B) X j = (secX X j).1 ≫ X.frame.toProj ≫ ProjSpace.map B R N := by
  unfold framedSec secX
  split_ifs <;> rfl

theorem ysec_ptW (j : Fin (2 * g + 1)) : C.ysec (C.ptW F X).1 j = (secX X j).1 ≫ X.frame.toProj := by
  have hm := C.ysec_map (C.ptW F X).1 j
  rw [algebra_eq_ptW] at hm
  apply (AlgebraicGeometry.ProjSpace.isPullback_map B R N).hom_ext
  · rw [hm, ptW_prY, framedSec_eq_secX, Category.assoc]
  · rw [ysec_π, Category.assoc, X.frame.toProj_π, (secX X j).2]

theorem h₁_ptW : (⨆ j, C.Jsec (C.ptW F X).1 j) = ⊥ := by
  rw [iSup_eq_bot]
  intro j
  rw [Jsec_eq_bot_iff, ysec_ptW]
  exact ⟨(secX X j).1 ≫ (C.eX F X).inv, by rw [Category.assoc, eX_inv_ι]⟩

theorem zsec_ptW (j : Fin (2 * g + 1)) :
    (C.zsec (C.ptW F X).1 (C.lifts_of_iSup_eq_bot _ (C.h₁_ptW F X)) j).1 = (secX X j).1 ≫ (C.eX F X).inv := by
  apply (inferInstance : Mono (C.ι (C.ptW F X).1)).right_cancellation
  rw [C.zsec_ι, ysec_ptW, Category.assoc, eX_inv_ι]

end PT
