variable [TopologicalSpace A] [Fintype ι]

private theorem pow_mul_norm_mFourierCoeff_torusLift_le (hΘ : IsOpenQuotientMap Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (hc : Continuous H)
    (γ : ℝ →+ A) (c : ι → ℝ) (hγ : ∀ t, Θ (γ t) = dirFlow c t) (k : ℕ)
    (K : Set A) (hK : ∀ x : UnitAddTorus ι, ∃ a ∈ K, Θ a = x)
    (hs : ∀ a ∈ K, ContDiff ℝ ∞ (fun t : ℝ => H (a + γ t)))
    {M : ℝ} (hM : ∀ a ∈ K, ‖iteratedDeriv k (fun t : ℝ => H (a + γ t)) 0‖ ≤ M) (n : ι → ℤ) :
    (2 * π * |dirFreq n c|) ^ k * ‖mFourierCoeff (torusLift Θ hΘ.surjective H) n‖ ≤ M := by
  refine pow_mul_norm_mFourierCoeff_le_of_contDiff_flow c (continuous_torusLift hΘ hH hc) k (fun x => ?_) (fun x => ?_) n
  · obtain ⟨a, ha, rfl⟩ := hK x
    rw [torusLift_flow_eq hΘ.surjective hH γ c hγ a]
    exact hs a ha
  · obtain ⟨a, ha, rfl⟩ := hK x
    rw [torusLift_flow_eq hΘ.surjective hH γ c hγ a]
    exact hM a ha

end Lift
