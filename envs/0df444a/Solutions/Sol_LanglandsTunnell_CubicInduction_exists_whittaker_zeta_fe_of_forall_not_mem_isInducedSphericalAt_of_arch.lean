variable (K : Type) [Field K] [NumberField K]

private theorem card_toFinset_primeFibre_le (v : HeightOneSpectrum (𝓞 ℚ)) :
    (FibreDegree.primeFibre_finite K v).toFinset.card ≤ Module.finrank ℚ K := by
  rw [← FibreDegree.sum_toFinset_ramificationIdx_mul_inertiaDeg K v, Finset.card_eq_sum_ones]
  refine Finset.sum_le_sum fun 𝔓 h𝔓 => ?_
  have h𝔓' : 𝔓 ∈ primeFibre ℚ K v := (FibreDegree.primeFibre_finite K v).mem_toFinset.1 h𝔓
  exact Nat.mul_pos (FibreDegree.ramificationIdx_pos_of_mem_primeFibre K v 𝔓 h𝔓')
    (FibreDegree.inertiaDeg_pos_of_mem_primeFibre K v 𝔓 h𝔓')

end
