variable {N0 N1 N2 N3 K f ρ R w : ℕ} {px py : Fin 3} {t : IState HS}

theorem NLogN.KFX.coreBU_runs {q : ℕ} {Ksw Kc : ℝ} (hKsw : 0 ≤ Ksw) (hKc : 0 ≤ Kc) (HSw : SwEOK q Ksw)
    (HC : CorrUOK Kc) (hK6 : 6 ≤ K) (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog (coreBU q) t
        (t.upd 0 (ints (rixT (gB N0 N1 N2 N3 K f R w) (RAc K ρ f) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 400 * coreCost Ksw Kc K ρ f (gB N0 N1 N2 N3 K f R w) +
        10 ^ 10 * (((zsz ((gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 : ℕ) : ℝ) + 2) ^ 2 := by sorry
