theorem Formalism.MainNotions.ModuliIntegralCharts.H1.CIndFrFix2b.formal_log_add_last_two (G : FGLaw S d) (l : Fin d) :
    ev (n := 3) ![G.add (pt S d 1) (pt S d 2)] (LogPf.logOf G l) =
      ev (n := 3) ![pt S d 1] (LogPf.logOf G l) + ev (n := 3) ![pt S d 2] (LogPf.logOf G l) := by sorry
