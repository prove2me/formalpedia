section
-- Source module: NLogNP.TM
/-!
# Running flat code on the platform's Turing machines

Tapes: `0` input, `1` output, `2` control stack (return addresses), `3 + i` stack `i`.
On every stack tape the head rests on the top symbol (on `▷` when empty), so `push` is two
steps, `pop` and tests are one step, and a call is two steps.  Each flat step is at most two
machine steps (`flat_tm`).
-/

namespace NLogN

open IntMul IntMul.Mach

variable {S L : ℕ}

/-- Tape alphabet: `none` is `▷`, `some none` is the blank. -/
abbrev Γ (L : ℕ) := Option (Option (Sym ⊕ Fin L))

def gst : Γ L := none
def gbl : Γ L := some none
def gsym (a : Sym) : Γ L := some (some (Sum.inl a))
def gret (x : Fin L) : Γ L := some (some (Sum.inr x))

def syms (L : ℕ) : Syms (Γ L) :=
  ⟨gbl, gst, gsym 0, gsym 1, gsym 2, by simp [gbl, gst, gsym]⟩

/-- Return address symbol (blank for an out-of-range address, which never occurs). -/
def retSym (e : ℕ) : Γ L := if h : e < L then gret ⟨e, h⟩ else gbl

def topOf : Γ L → Option Sym
  | some (some (Sum.inl a)) => some a
  | _ => none

def inCode : Γ L → Sym
  | some (some (Sum.inl a)) => a
  | _ => codeEnd

def toPc (e : ℕ) : Option (Fin L) := if h : e < L then some ⟨e, h⟩ else none

def tin : Fin (S + 3) := ⟨0, by omega⟩
def tout : Fin (S + 3) := ⟨1, by omega⟩
def tctl : Fin (S + 3) := ⟨2, by omega⟩
def tst (i : Fin S) : Fin (S + 3) := ⟨i.val + 3, by omega⟩

/-- No change on any tape. -/
def stayAll {k : ℕ} (a : Fin k → Γ L) : Fin k → Γ L × Move := fun l => (a l, Move.stay)

/-- The transition function. State `(pc, false)` starts an instruction, `(pc, true)` is the
second step of a two-step instruction. -/
def δf (code : ℕ → Instr S) (q : Fin L × Bool) (a : Fin (S + 3) → Γ L) :
    Option ((Fin L × Bool) × (Fin (S + 3) → Γ L × Move)) :=
  match code q.1, q.2 with
  | .jmp e, _ => (toPc e).map fun e => ((e, false), stayAll a)
  | .push i _ _, false => some ((q.1, true), wr1 a (tst i) (a (tst i)) Move.right)
  | .push i x e, true => (toPc e).map fun e => ((e, false), wr1 a (tst i) (gsym x) Move.stay)
  | .pop i e, _ => (toPc e).map fun e => ((e, false), wr1 a (tst i) gbl Move.left)
  | .inRd i _, false => some ((q.1, true), wr2 a tin (a tin) Move.right (tst i) (a (tst i)) Move.right)
  | .inRd i e, true => (toPc e).map fun e => ((e, false), wr1 a (tst i) (gsym (inCode (a tin))) Move.stay)
  | .out _ _, false => some ((q.1, true), wr1 a tout (a tout) Move.right)
  | .out b e, true => (toPc e).map fun e =>
      ((e, false), wr1 a tout (gsym (if b then 1 else 0)) Move.stay)
  | .br i f y n, _ => (toPc (if f (topOf (a (tst i))) then y else n)).map fun e => ((e, false), stayAll a)
  | .call _ _, false => some ((q.1, true), wr1 a tctl (a tctl) Move.right)
  | .call t e, true => (toPc t).map fun t => ((t, false), wr1 a tctl (retSym e) Move.stay)
  | .ret, _ => match a tctl with
    | some (some (Sum.inr x)) => some ((x, false), wr1 a tctl gbl Move.left)
    | _ => none

def progOf (code : ℕ → Instr S) (L : ℕ) (pc0 : Fin L) : Prog (Γ L) (S + 3) where
  Q := Fin L × Bool
  q0 := (pc0, false)
  δ := δf code

/-! ## Encoding of configurations -/

/-- Tapes of a flat configuration; `inp` is the input tape. -/
def enc (inp : ℕ → Γ L) (c : Cfg S) : Tapes (Γ L) (S + 3) where
  cells l := if l.val = 0 then inp else if l.val = 1 then tapeOf (syms L) (c.σ.out.map (bitSym (syms L)))
    else if l.val = 2 then tapeOf (syms L) (c.ctl.map retSym).reverse
    else if h : l.val - 3 < S then tapeOf (syms L) ((c.σ.stk ⟨l.val - 3, h⟩).map gsym).reverse
    else tapeOf (syms L) []
  head l := if l.val = 0 then c.σ.ip else if l.val = 1 then c.σ.out.length
    else if l.val = 2 then c.ctl.length
    else if h : l.val - 3 < S then (c.σ.stk ⟨l.val - 3, h⟩).length else 0

end NLogN

namespace NLogN

open IntMul IntMul.Mach

variable {S L : ℕ}

theorem tst_ne_tin (i : Fin S) : tst i ≠ tin := by simp [tst, tin, Fin.ext_iff]
theorem tst_ne_tout (i : Fin S) : tst i ≠ tout := by simp [tst, tout, Fin.ext_iff]
theorem tst_ne_tctl (i : Fin S) : tst i ≠ tctl := by simp [tst, tctl, Fin.ext_iff]

theorem tin_ne_tout : (tin : Fin (S + 3)) ≠ tout := by simp [tin, tout, Fin.ext_iff]
theorem tin_ne_tctl : (tin : Fin (S + 3)) ≠ tctl := by simp [tin, tctl, Fin.ext_iff]
theorem tout_ne_tctl : (tout : Fin (S + 3)) ≠ tctl := by simp [tout, tctl, Fin.ext_iff]

/-! ## Partial runs -/

/-- `t` steps of a program from one state to another (no halting in between). -/
inductive Reach {Γ' : Type} [DecidableEq Γ'] {k : ℕ} (st : Γ') (P : Prog Γ' k) :
    P.Q → Tapes Γ' k → ℕ → P.Q → Tapes Γ' k → Prop
  | refl (q T) : Reach st P q T 0 q T
  | step {q q' q'' : P.Q} {T T'' : Tapes Γ' k} {w : Fin k → Γ' × Move} {n : ℕ} :
      P.δ q T.read = some (q', w) → Reach st P q' (T.write (fix st T.read w)) n q'' T'' →
      Reach st P q T (n + 1) q'' T''

attribute [simp] tst_ne_tin tst_ne_tout tst_ne_tctl tin_ne_tout tin_ne_tctl tout_ne_tctl

@[simp] theorem tst_val (i : Fin S) : (tst i).val = i.val + 3 := rfl
@[simp] theorem tout_val : (tout : Fin (S + 3)).val = 1 := rfl
@[simp] theorem tctl_val : (tctl : Fin (S + 3)).val = 2 := rfl

/-! ## One flat step -/

section Sim

variable (code : ℕ → Instr S) (L) (pc0 : Fin L) (inp : ℕ → Γ L)

/-- All addresses in an instruction are below `L`. -/
def Instr.Valid (L : ℕ) : Instr S → Prop
  | .jmp e => e < L
  | .push _ _ e => e < L
  | .pop _ e => e < L
  | .inRd _ e => e < L
  | .out _ e => e < L
  | .br _ _ y n => y < L ∧ n < L
  | .call t e => t < L ∧ e < L
  | .ret => True

end Sim

end NLogN

end

section
-- Source module: NLogNP.Top
/-!
# From stack programs to the platform model

`multipliesAt_of_exec`: if procedure `0` of a stack program, run on input `x # y`, writes
`bin (2n) (val x · val y)` with cost `c`, then the compiled platform machine multiplies at `n`
within `2c + 1` steps.
-/

namespace NLogN

open IntMul IntMul.Mach

variable {S P : ℕ}

/-- The initial state: all stacks empty. -/
def St.init (S : ℕ) : St S := ⟨fun _ => [], 0, []⟩

theorem codeLen_pos (prog : Fin P → Stmt S P) (hP : 0 < P) : 0 < codeLen prog := by
  have := entryOf_le_codeLen prog ⟨0, hP⟩; omega

/-- The platform machine of a stack program (procedure `0` is the main program). -/
def machineOf (prog : Fin P → Stmt S P) (hP : 0 < P) : MultitapeTM :=
  IntMul.Mach.compile (syms (codeLen prog)) (by omega : 2 ≤ S + 3)
    (progOf (codeOf prog) (codeLen prog) ⟨0, codeLen_pos prog hP⟩)

end NLogN

end

section
-- Source module: NLogNP.Prims
/-!
# Constants, input and output of integer items
-/

namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Constants -/

def constI (i : Fin S) (c : ℤ) : Stmt S P :=
  opsStmt ((((zbits c).map codeBit).reverse ++ [hdOf c]).map (Op.push i))

/-! ## Output -/

def outR (q i j t1 : Fin S) : Stmt S P :=
  .seq (.pop i) (.seq (.pop j) (.seq (padMove q i j t1) (.seq (.pop t1) (outWord q t1))))

def outRCost (m : ℕ) : ℕ := padCost (m + 1) + outCost m + 3

/-! ## Input -/

def fZero (_x _y _c : Bool) : Bool × Bool := (false, false)

/-- Read a bit word `W` (most significant bit first) up to `stop`; push `val W` on `i` and the
ruler `2 ^ |W|` on `j`. -/
def readR (q i j t1 t2 t3 : Fin S) (stop : Sym) : Stmt S P :=
  .seq (readUntil q t1 stop) (.seq (.push j 1) (.seq (zip q t2 t1 j t3 true fZero finNone false)
    (.seq (.push j hdPos) (.seq (trimTop t3) (.seq (moveBits q t3 i) (.push i hdPos))))))

def readRCost (m : ℕ) : ℕ := readCost m + zipCost 0 m + 2 * m + moveCost m + 5

end NLogN

end

section
-- Source module: NLogNP.Cat
/-!
# Concatenation: `a * 2^m + b` for `0 ≤ b < 2^m`, in time `O(m)`

`catR q i j k t1 t2`: `i` holds `int a` with `a ≠ 0`, `j` the ruler `int (2^m)`, `k` holds `int b`
with `0 ≤ b < 2^m`.  The result `int (sg a (|a| * 2^m + b))` replaces `a`; `b` is consumed and the
ruler is kept.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def fFst (x _y _c : Bool) : Bool × Bool := (x, false)

def padL (l : List Bool) (m : ℕ) : List Bool := l ++ List.replicate (m - l.length) false

def catR (q i j k t1 t2 : Fin S) : Stmt S P :=
  caseTop i fun o =>
    let h := if o = some hdNeg then hdNeg else hdPos
    .seq (.pop i) (.seq (.pop j) (.seq (move q j t2 g0) (.seq (.pop k)
      (.seq (zip q k t2 t1 j true fFst finNone false) (.seq (.push j hdPos)
        (.seq (moveBits q t1 i) (.push i h)))))))

def catCost (m : ℕ) : ℕ := 2 * moveCost m + zipCost 0 m + 23

end NLogN

end

section
-- Source module: NLogNP.ILang
/-!
# The item language

Programs over `S` stacks of items (integers and marks), compiled to stack programs over `S + 4`
stacks (the last four are scratch).  `compile_correct` turns item-level executions into
`Runs` of the compiled program, with the same cost.
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

structure IState (S : ℕ) where
  G : Fin S → List Item
  ip : ℕ
  out : List Bool

def IState.upd (s : IState S) (i : Fin S) (L : List Item) : IState S :=
  { s with G := Function.update s.G i L }

@[simp] theorem IState.upd_ip (s : IState S) (i : Fin S) (L : List Item) : (s.upd i L).ip = s.ip :=
  rfl
@[simp] theorem IState.upd_out (s : IState S) (i : Fin S) (L : List Item) :
    (s.upd i L).out = s.out := rfl

/-! ## Stacks of the compiled program -/

def ι (i : Fin S) : Fin (S + 4) := Fin.castAdd 4 i
def sq (S : ℕ) : Fin (S + 4) := ⟨S, by omega⟩
def s1 (S : ℕ) : Fin (S + 4) := ⟨S + 1, by omega⟩
def s2 (S : ℕ) : Fin (S + 4) := ⟨S + 2, by omega⟩
def s3 (S : ℕ) : Fin (S + 4) := ⟨S + 3, by omega⟩

/-- The machine state of an item state: scratch stacks empty. -/
def encI (s : IState S) : St (S + 4) :=
  ⟨fun x => if h : x.val < S then encL (s.G ⟨x.val, h⟩) else [], s.ip, s.out⟩

@[simp] theorem enc_ip (s : IState S) : (encI s).ip = s.ip := rfl
@[simp] theorem enc_out (s : IState S) : (encI s).out = s.out := rfl

@[simp] theorem bitOf_none' : bitOf none = none := rfl

/-! ## Operations -/

inductive IOp (S : ℕ) where
  | add (i j k : Fin S)
  | neg (i : Fin S)
  | dup (i j : Fin S)
  | drop (i : Fin S)
  | mv (i j : Fin S)
  | const (i : Fin S) (c : ℤ)
  | mark (i : Fin S)
  | unmark (i : Fin S)
  | shl (i j : Fin S)
  | split (i j k : Fin S)
  | read (i j : Fin S) (stop : Sym)
  | write (i j : Fin S)
  | cat (i j k : Fin S)

def IOp.stmt : IOp S → Stmt (S + 4) P
  | .add i j k => addInt (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)
  | .neg i => negInt (ι i)
  | .dup i j => dupInt (sq S) (ι i) (ι j) (s1 S) (s2 S)
  | .drop i => popInt (ι i)
  | .mv i j => moveInt (sq S) (ι i) (ι j) (s1 S)
  | .const i c => constI (ι i) c
  | .mark i => .push (ι i) hdMark
  | .unmark i => .pop (ι i)
  | .shl i j => shlR (sq S) (ι i) (ι j) (s1 S) (s2 S)
  | .split i j k => splitR (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)
  | .read i j stop => readR (sq S) (ι i) (ι j) (s1 S) (s2 S) (s3 S) stop
  | .write i j => outR (sq S) (ι i) (ι j) (s1 S)
  | .cat i j k => catR (sq S) (ι i) (ι j) (ι k) (s1 S) (s2 S)

/-- Item-level semantics of the operations, with costs. -/
inductive IOp.Step (I : List Sym) : IOp S → IState S → IState S → ℕ → Prop
  | add {s : IState S} {i j k : Fin S} {a b : ℤ} {Li Lj : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: Li) (hj : s.G j = .int b :: Lj) :
      Step I (.add i j k) s
        (((s.upd i Li).upd j Lj).upd k (.int (a + b) :: ((s.upd i Li).upd j Lj).G k))
        (addIntCost (zsz a + zsz b))
  | neg {s : IState S} {i : Fin S} {a : ℤ} {L : List Item} (hi : s.G i = .int a :: L) :
      Step I (.neg i) s (s.upd i (.int (-a) :: L)) 20
  | dup {s : IState S} {i j : Fin S} {a : ℤ} {L : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: L) :
      Step I (.dup i j) s (s.upd j (.int a :: s.G j)) (dupCost (zsz a) + 17)
  | drop {s : IState S} {i : Fin S} {a : ℤ} {L : List Item} (hi : s.G i = .int a :: L) :
      Step I (.drop i) s (s.upd i L) (2 * zsz a + 2)
  | mv {s : IState S} {i j : Fin S} {a : ℤ} {L : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: L) :
      Step I (.mv i j) s ((s.upd i L).upd j (.int a :: s.G j)) (2 * moveCost (zsz a) + 19)
  | const {s : IState S} {i : Fin S} (c : ℤ) :
      Step I (.const i c) s (s.upd i (.int c :: s.G i)) (zsz c + 2)
  | mark {s : IState S} {i : Fin S} : Step I (.mark i) s (s.upd i (.mark :: s.G i)) 1
  | unmark {s : IState S} {i : Fin S} {L : List Item} (hi : s.G i = .mark :: L) :
      Step I (.unmark i) s (s.upd i L) 1
  | shl {s : IState S} {i j : Fin S} {a : ℤ} {m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hi : s.G i = .int a :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.shl i j) s (s.upd i (.int (a * 2 ^ m) :: Li)) (shlCost m)
  | split {s : IState S} {i j k : Fin S} {a : ℤ} {m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hik : i ≠ k) (hjk : j ≠ k) (hi : s.G i = .int a :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.split i j k) s
        ((s.upd i (.int (sg a (a.natAbs / 2 ^ m)) :: Li)).upd k
          (.int (sg a (a.natAbs % 2 ^ m)) :: s.G k)) (splitCost m + 17)
  | read {s : IState S} {i j : Fin S} {stop : Sym} (W : List Bool) (hij : i ≠ j) (hs0 : stop ≠ 0)
      (hs1 : stop ≠ 1) (hk : ∀ k (hk : k < W.length), I.getD (s.ip + k) codeEnd = codeBit W[k])
      (hstop : I.getD (s.ip + W.length) codeEnd = stop) :
      Step I (.read i j stop) s
        { (s.upd i (.int (val W : ℤ) :: s.G i)).upd j
            (.int (2 ^ W.length) :: (s.upd i (.int (val W : ℤ) :: s.G i)).G j) with
          ip := s.ip + W.length + 1 }
        (readRCost W.length)
  | write {s : IState S} {i j : Fin S} {n m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
      (hn : n < 2 ^ m) (hi : s.G i = .int (n : ℤ) :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
      Step I (.write i j) s { (s.upd i Li).upd j Lj with out := s.out ++ bin m n } (outRCost m)
  | cat {s : IState S} {i j k : Fin S} {a : ℤ} {b m : ℕ} {Li Lj Lk : List Item} (hij : i ≠ j)
      (hik : i ≠ k) (hjk : j ≠ k) (ha : a ≠ 0) (hb : b < 2 ^ m) (hi : s.G i = .int a :: Li)
      (hj : s.G j = .int (2 ^ m) :: Lj) (hk : s.G k = .int (b : ℤ) :: Lk) :
      Step I (.cat i j k) s ((s.upd i (.int (sg a (a.natAbs * 2 ^ m + b)) :: Li)).upd k Lk)
        (catCost m)

variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

end NLogN

end


