section LawII

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S : Type} [CommRing S]
  {N : ℕ} [NeZero N] [Fact (IsUnit ((N : ℕ) : S))] [Fact (IsUnit ((N₀ : ℕ) : S))] {m : ℕ}

theorem via_comp {T T' : Type} [CommRing T] [CommRing T'] (φ : S →+* T) (ψ : T →+* T')
    (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (E'' : FakeEllipticCurve Λ N₀ T')
    (g₁ : E'.A ⟶ E.A) (h₁ : FakeEllipticCurve.IsPullbackVia φ E E' g₁)
    (g : E''.A ⟶ E'.A) (hg : FakeEllipticCurve.IsPullbackVia ψ E' E'' g) :
    FakeEllipticCurve.IsPullbackVia (ψ.comp φ) E E'' (g ≫ g₁) := by
  have hsq : Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hpb : IsPullback (g ≫ g₁) E''.f E.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))) := by
    rw [hsq]; exact (via_isPullback ψ E' E'' g hg).paste_horiz (via_isPullback φ E E' g₁ h₁)
  refine ⟨hpb, ?_, ?_, ?_⟩
  · intro TT t P Q
    have e1 := congrArg Subtype.val (via_isHom ψ E' E'' g hg t P Q)
    have e2 := congrArg Subtype.val (via_isHom φ E E' g₁ h₁ _
      (Transfer.push ψ g (via_isPullback ψ E' E'' g hg) P) (Transfer.push ψ g (via_isPullback ψ E' E'' g hg) Q))
    simp only [Transfer.push_coe] at e1 e2
    rw [← Category.assoc, e1, e2]
    apply KerOps.mul_coe_congr E.L
    · rw [Category.assoc, hsq]
    · simp only [Transfer.push_coe, Category.assoc]
    · simp only [Transfer.push_coe, Category.assoc]
  · intro x
    rw [← Category.assoc, via_act ψ E' E'' g hg, Category.assoc, via_act φ E E' g₁ h₁, Category.assoc]
  · intro TT t P hP
    obtain ⟨P₁, hP₁⟩ := hg.choose_spec.2.2 t P hP
    have hP' : CerednikDrinfeld.QM.FactorsThrough E'.lev (Transfer.push ψ g (via_isPullback ψ E' E'' g hg) P) :=
      ⟨P₁, hP₁⟩
    obtain ⟨P₀, hP₀⟩ := h₁.choose_spec.2.2 _ _ hP'
    exact ⟨P₀, by rw [hP₀, Transfer.push_coe, Category.assoc]⟩

variable (u : FakeEllipticCurve.WithFullLevel Λ N₀ m S) (D : L1aData u.1 N) (s : Finset ↥Λ)
  {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) (hB : QuaternionAlgebra.IsIndefiniteRamifiedExactlyAt a b q q')
  (hΛ : QuaternionAlgebra.IsMaximalOrder Λ) (hm : 3 ≤ m) (hm' : IsUnit ((m : ℕ) : S))

include hqq' hB hΛ hm hm' in

theorem law_ii {T T' : Type} [CommRing T] [CommRing T'] (φ : S →+* T) (ψ : T →+* T')
    (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (u'' : FakeEllipticCurve.WithFullLevel Λ N₀ m T')
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u')
    (hu'' : FakeEllipticCurve.WithFullLevel.IsPullback (ψ.comp φ) u u'')
    (K' : u'.1.ExtraLevel N) (K'' : u''.1.ExtraLevel N) (g : u''.1.A ⟶ u'.1.A)
    (hg : FakeEllipticCurve.IsPullbackVia ψ u'.1 u''.1 g)
    (hP : (u''.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom ψ) ≫ (u'.2.P).1)
    (hK : ∀ {T₀ : Scheme.{0}} (t : T₀ ⟶ Spec (CommRingCat.of T')) (P : SchemeHomOver t u''.1.f),
      CerednikDrinfeld.QM.FactorsThrough K''.levK P → ∃ P₀ : T₀ ⟶ K'.K, P₀ ≫ K'.levK = P.1 ≫ g) :
    ptZ u D s (ψ.comp φ) u'' hu'' K'' = Spec.map (CommRingCat.ofHom ψ) ≫ ptZ u D s φ u' hu' K' := by
  haveI : IsFinite (u'.1.L.schemeKerStr N) := isFinite_ker _ N (isUnit_map (S := S) (N := N) φ)
  haveI : Etale (u'.1.L.schemeKerStr N) := etale_ker _ N (isUnit_map (S := S) (N := N) φ)
  haveI : IsFinite (u''.1.L.schemeKerStr N) := isFinite_ker _ N (isUnit_map (S := S) (N := N) (ψ.comp φ))
  haveI : Etale (u''.1.L.schemeKerStr N) := etale_ker _ N (isUnit_map (S := S) (N := N) (ψ.comp φ))
  set g₁ := hu'.choose
  have via₁ : FakeEllipticCurve.IsPullbackVia φ u.1 u'.1 g₁ := via_of_wfl φ u u' hu'
  set g₂ := hu''.choose
  have via₂ : FakeEllipticCurve.IsPullbackVia (ψ.comp φ) u.1 u''.1 g₂ := via_of_wfl (ψ.comp φ) u u'' hu''

  have hg₂ : g₂ = g ≫ g₁ := by
    apply g_unique hqq' hB Λ hΛ m hm (ψ.comp φ) ?_ u u'' g₂ (g ≫ g₁) via₂ (via_comp φ ψ u.1 u'.1 u''.1 g₁ via₁ g hg)
      (P_of_wfl (ψ.comp φ) u u'' hu'') ?_
    · have := hm'.map (ψ.comp φ); rwa [map_natCast] at this
    · rw [← Category.assoc, hP, Category.assoc, P_of_wfl φ u u' hu', ← Category.assoc, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp]

  set k := kN ψ u'.1 u''.1 g hg N
  have hk := kN_isPullback ψ u'.1 u''.1 g hg N
  have hkι := kN_ι ψ u'.1 u''.1 g hg N
  have hkN : kN (ψ.comp φ) u.1 u''.1 g₂ via₂ N = k ≫ kN φ u.1 u'.1 g₁ via₁ N := by
    symm
    apply kN_unique
    · rw [Category.assoc, (kN_isPullback φ u.1 u'.1 g₁ via₁ N).w, ← Category.assoc, hk.w, Category.assoc,
        ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    · rw [Category.assoc, kN_ι, ← Category.assoc, hkι, Category.assoc, hg₂]
  have h' : IsPullback (k ≫ kN φ u.1 u'.1 g₁ via₁ N) (u''.1.L.schemeKerStr N) (u.1.L.schemeKerStr N)
      (Spec.map (CommRingCat.ofHom (ψ.comp φ))) := by
    rw [← hkN]; exact kN_isPullback (ψ.comp φ) u.1 u''.1 g₂ via₂ N
  have hcl : IsClosed ((k ⁻¹ᵁ UK (N := N) φ u' K' : (u''.1.L.schemeKer N).Opens) : Set ↥(u''.1.L.schemeKer N)) :=
    (UK_closed (N := N) φ u' K').preimage k.continuous

  have hle : UK (N := N) (ψ.comp φ) u'' K'' ≤ k ⁻¹ᵁ UK (N := N) φ u' K' := by
    intro y hy
    let x : ↑(UK (N := N) (ψ.comp φ) u'' K'') ⟶ u''.1.L.schemeKer N := (UK (N := N) (ψ.comp φ) u'' K'').ι
    let P := KerOps.toPt u''.1.L N x rfl
    have hP1 : CerednikDrinfeld.QM.FactorsThrough ((UK (N := N) (ψ.comp φ) u'' K'').ι ≫ KerOps.ι u''.1.L N) P := by
      rw [Bridge.factorsThrough_iff_of_lift u''.1.L N _ P x rfl, Scheme.Opens.range_ι]
    have hP2 := (UK_pts (N := N) (ψ.comp φ) u'' K'' _ P).mpr hP1
    obtain ⟨P₁, hP₁⟩ := hK _ P hP2
    have hP3 : CerednikDrinfeld.QM.FactorsThrough K'.levK (Transfer.push ψ g (via_isPullback ψ _ _ g hg) P) := ⟨P₁, hP₁⟩
    have hP4 := (UK_pts (N := N) φ u' K' _ _).mp hP3
    rw [Bridge.factorsThrough_iff_of_lift u'.1.L N _ _ (x ≫ k)
      (by rw [Transfer.push_coe, KerOps.toPt_coe, Category.assoc, hkι, Category.assoc])] at hP4
    show x ⟨y, hy⟩ ∈ (k ⁻¹ᵁ UK (N := N) φ u' K')
    exact hP4 ⟨⟨y, hy⟩, by rw [Scheme.Hom.comp_apply]⟩
  have hrk : ∀ t, ((UK (N := N) (ψ.comp φ) u'' K'').ι ≫ u''.1.L.schemeKerStr N).finrank t =
      ((k ⁻¹ᵁ UK (N := N) φ u' K').ι ≫ u''.1.L.schemeKerStr N).finrank t := fun t => by
    rw [UK_rank, finrank_piece_transfer _ _ k _ hk _ (UK_closed (N := N) φ u' K'), UK_rank]
  have hU : UK (N := N) (ψ.comp φ) u'' K'' = k ⁻¹ᵁ UK (N := N) φ u' K' :=
    opens_eq_of_le_of_finrank_eq (u''.1.L.schemeKerStr N) _ _ (UK_closed (N := N) (ψ.comp φ) u'' K'') hcl hle hrk

  have step := D.h2 T T' φ ψ _ (u'.1.L.schemeKerStr N) (kN φ u.1 u'.1 g₁ via₁ N)
    (kN_isPullback φ u.1 u'.1 g₁ via₁ N) _ (u''.1.L.schemeKerStr N) (k ≫ kN φ u.1 u'.1 g₁ via₁ N) h' k hk.w rfl
    (UK (N := N) φ u' K') (UK_closed (N := N) φ u' K') (k ⁻¹ᵁ UK (N := N) φ u' K') hcl rfl
  apply (cancel_mono (Zsub D s).ι).mp
  rw [ptZ_ι, Category.assoc, ptZ_ι, zCK, zCK, zC, zC, ← Category.assoc]
  congr 1
  show z₀ D (ψ.comp φ) u''.1 g₂ via₂ _ _ = Spec.map (CommRingCat.ofHom ψ) ≫ z₀ D φ u'.1 g₁ via₁ _ _
  rw [z₀, z₀, ← step]
  rw [Pk.pt_congr D.pt T' rfl _ (u''.1.L.schemeKerStr N) hkN (kN_isPullback (ψ.comp φ) u.1 u''.1 g₂ via₂ N) h'
    (UK (N := N) (ψ.comp φ) u'' K'') (UK_closed (N := N) (ψ.comp φ) u'' K'')]
  congr 1

end LawII
