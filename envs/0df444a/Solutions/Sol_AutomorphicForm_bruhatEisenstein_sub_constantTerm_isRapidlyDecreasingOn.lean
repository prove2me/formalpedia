variable (g : Matrix (Fin 2) (Fin 2) ℂ)

private noncomputable def linePhat (z₀ : ℂ) (θ : ℝ) (t : ℝ) : ℂ :=
  botP g (z₀ + t * Complex.exp (θ * Complex.I))
    / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)

private noncomputable def lineQhat (z₀ : ℂ) (θ : ℝ) (t : ℝ) : ℂ :=
  botQ g (z₀ + t * Complex.exp (θ * Complex.I))
    / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)

private noncomputable def lineQSq (z₀ : ℂ) (θ : ℝ) (t : ℝ) : ℝ := normSq (lineQhat g z₀ θ t)

