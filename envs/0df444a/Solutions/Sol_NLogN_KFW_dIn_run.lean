namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

variable {Pp : ℕ}

section Run

variable {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- One move on an `encK` state. -/
theorem mvK1 {X Y : Fin HS} (hXY : X ≠ Y) (s : IState HS) (f : Fin HS → List ℤ) (a : ℤ)
    (l : List ℤ) (hf : f X = a :: l) {B : ℕ} (ha : zsz a ≤ B) :
    IRuns Isym tbl (mvI X Y) (encK s f)
      (encK s (Function.update (Function.update f X l) Y (a :: f Y))) (2 * moveCost B + 19) := by
  have h := IRuns.mv (I := Isym) (iprog := tbl) (s := encK s f) (a := a) (L := ints l ++ s.G X)
    hXY (by simp [hf])
  rw [encK_upd] at h
  have e2 : (encK s f).G Y = ints (f Y) ++ s.G Y := by
    first | simp | simp [encK]
  rw [e2] at h
  have e3 : (encK s (Function.update f X l)).upd Y (Item.int a :: (ints (f Y) ++ s.G Y)) =
      encK s (Function.update (Function.update f X l) Y (a :: f Y)) := by
    first | exact encK_upd s (Function.update f X l) Y (a :: f Y) | simpa [ints] using encK_upd s (Function.update f X l) Y (a :: f Y)
  rw [e3] at h
  exact h.mono (by have := moveCost_mono ha; omega)

set_option maxHeartbeats 1000000 in
theorem dIn_run_sol_aux (s : IState HS) (f : Fin HS → List ℤ) (P K D S ρ r p w : ℤ) (rest : List ℤ)
    (h36 : f 36 = P :: K :: D :: S :: ρ :: r :: p :: w :: rest)
    (he : ∀ j : Fin HS, j ∈ [(21 : Fin HS), 1, 22, 3, 23, 4, 26, 25] → f j = []) {B : ℕ}
    (hB : ∀ x ∈ [P, K, D, S, ρ, r, p, w], zsz x ≤ B) :
    IRuns Isym tbl (dIn (Pp := Pp)) (encK s f) (encK s (fIn f P K D S ρ r p w rest))
      (8 * (2 * moveCost B + 19)) := by
  have b : ∀ x ∈ [P, K, D, S, ρ, r, p, w], zsz x ≤ B := hB
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at b
  obtain ⟨bP, bK, bD, bS, bρ, br, bp, bw⟩ := b
  have e : ∀ j : Fin HS, j ∈ [(21 : Fin HS), 1, 22, 3, 23, 4, 26, 25] → f j = [] := he
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at e
  obtain ⟨e21, e1, e22, e3, e23, e4, e26, e25⟩ := e
  have R := IRuns.seq
    (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 21) (by (try dsimp only); decide) s f P
      (K :: D :: S :: ρ :: r :: p :: w :: rest) h36 bP)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 1) (by (try dsimp only); decide) s _ K
      (D :: S :: ρ :: r :: p :: w :: rest) (by simp [Function.update_apply]) bK)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 22) (by (try dsimp only); decide) s _ D
      (S :: ρ :: r :: p :: w :: rest) (by simp [Function.update_apply]) bD)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 3) (by (try dsimp only); decide) s _ S
      (ρ :: r :: p :: w :: rest) (by simp [Function.update_apply]) bS)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 23) (by (try dsimp only); decide) s _ ρ
      (r :: p :: w :: rest) (by simp [Function.update_apply]) bρ)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 4) (by (try dsimp only); decide) s _ r
      (p :: w :: rest) (by simp [Function.update_apply]) br)
    (IRuns.seq (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 26) (by (try dsimp only); decide) s _ p
      (w :: rest) (by simp [Function.update_apply]) bp)
      (mvK1 (Isym := Isym) (tbl := tbl) (X := 36) (Y := 25) (by (try dsimp only); decide) s _ w
      rest (by simp [Function.update_apply]) bw)))))))
  refine R.mono' ?_ (by omega)
  congr 1
  funext j
  by_cases hj0 : j = 0
  · subst hj0; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj36 : j = 36
  · subst hj36; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj21 : j = 21
  · subst hj21; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj1 : j = 1
  · subst hj1; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj22 : j = 22
  · subst hj22; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj3 : j = 3
  · subst hj3; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj23 : j = 23
  · subst hj23; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj4 : j = 4
  · subst hj4; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj26 : j = 26
  · subst hj26; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  by_cases hj25 : j = 25
  · subst hj25; simp [fIn, Function.update_apply, e21, e1, e22, e3, e23, e4, e26, e25, h36]
  simp only [fIn, Function.update_apply, hj0, hj36, hj21, hj1, hj22, hj3, hj23, hj4, hj26, hj25, if_false]

