private abbrev unipotentNormalizer (K : Type*) [Field K] : Subgroup (GL (Fin 2) K) :=
  Subgroup.normalizer ((unipotentGL2Hom (R := K)).range : Set (GL (Fin 2) K))

variable {K : Type*} [Field K]

private def mirabolicReindex (d : GL (Fin 2) K) (hd : d ∈ unipotentNormalizer K) :
    MirabolicIndex K ≃ MirabolicIndex K :=
  Quotient.congr (Equiv.mulLeft d) fun g h => by
    rw [QuotientGroup.rightRel_apply, QuotientGroup.rightRel_apply, Subgroup.mem_normalizer_iff.mp hd (h * g⁻¹)]
    show _ ↔ d * h * (d * g)⁻¹ ∈ _
    simp only [_root_.mul_inv_rev, mul_assoc]

private theorem mirabolicReindex_mk (d : GL (Fin 2) K) (hd : d ∈ unipotentNormalizer K)
    (g : GL (Fin 2) K) :
    mirabolicReindex d hd (Quotient.mk _ g) = Quotient.mk _ (d * g) := rfl

private theorem exists_mul_mirabolicRep_eq (d : GL (Fin 2) K) (hd : d ∈ unipotentNormalizer K)
    (i : MirabolicIndex K) :
    ∃ x : K, d * mirabolicRep K i = unipotentGL2 x * mirabolicRep K (mirabolicReindex d hd i) := by
  have h : (Quotient.mk _ (mirabolicRep K (mirabolicReindex d hd i)) : MirabolicIndex K) =
      Quotient.mk _ (d * mirabolicRep K i) := by
    rw [mirabolicRep_spec, ← mirabolicReindex_mk d hd, mirabolicRep_spec]
  obtain ⟨x, hx⟩ := QuotientGroup.rightRel_apply.mp (Quotient.exact h)
  refine ⟨x.toAdd, ?_⟩
  have hx' : unipotentGL2 x.toAdd = d * mirabolicRep K i * (mirabolicRep K (mirabolicReindex d hd i))⁻¹ := hx
  rw [hx', inv_mul_cancel_right]

private theorem coe_inv_of_coe_eq_diagonal₂ {p q : K} (hp : p ≠ 0) (hq : q ≠ 0) (d : GL (Fin 2) K)
    (hd : (d : Matrix (Fin 2) (Fin 2) K) = Matrix.diagonal ![p, q]) :
    ((d⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = Matrix.diagonal ![p⁻¹, q⁻¹] := by
  rw [Matrix.coe_units_inv, hd]
  refine Matrix.inv_eq_right_inv ?_
  rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  refine congrArg Matrix.diagonal (funext fun i => ?_)
  fin_cases i <;> simp [hp, hq]

private theorem mul_unipotentGL2_mul_inv_of_coe_eq_diagonal {p q : K} (hp : p ≠ 0) (hq : q ≠ 0) (d : GL (Fin 2) K)
    (hd : (d : Matrix (Fin 2) (Fin 2) K) = Matrix.diagonal ![p, q]) (x : K) :
    d * unipotentGL2 x * d⁻¹ = unipotentGL2 (p * x * q⁻¹) := by
  have hi := coe_inv_of_coe_eq_diagonal₂ hp hq d hd
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, hd, hi, unipotentGL2_coe, unipotentGL2_coe]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Matrix.diagonal, hp, hq]

private theorem mem_normalizer_of_coe_eq_diagonal {p q : K} (hp : p ≠ 0) (hq : q ≠ 0) (d : GL (Fin 2) K)
    (hd : (d : Matrix (Fin 2) (Fin 2) K) = Matrix.diagonal ![p, q]) :
    d ∈ unipotentNormalizer K := by
  refine Subgroup.mem_normalizer_iff.mpr fun h => ⟨?_, ?_⟩
  · rintro ⟨x, rfl⟩
    exact ⟨Multiplicative.ofAdd (p * x.toAdd * q⁻¹),
      (mul_unipotentGL2_mul_inv_of_coe_eq_diagonal hp hq d hd x.toAdd).symm⟩
  · rintro ⟨y, hy⟩
    have hy' : unipotentGL2 y.toAdd = d * h * d⁻¹ := hy
    have e : h = d⁻¹ * unipotentGL2 y.toAdd * d⁻¹⁻¹ := by
      rw [hy']
      group
    rw [e, mul_unipotentGL2_mul_inv_of_coe_eq_diagonal (inv_ne_zero hp) (inv_ne_zero hq) d⁻¹
      (coe_inv_of_coe_eq_diagonal₂ hp hq d hd)]
    exact ⟨Multiplicative.ofAdd _, rfl⟩

end
