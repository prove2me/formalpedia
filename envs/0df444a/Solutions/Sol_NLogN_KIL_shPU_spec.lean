theorem stCost_le_vol {Bb : ℕ} {ac : List (ℕ × ℕ)} (hac : ∀ p ∈ ac, 1 ≤ p.1) :
    NLogN.KIL.stCost Bb ac.reverse [] ≤ 10 ^ 8 * (ac.length + 1) * (vol (ac.map Prod.fst) + 1) * (Bb + 2) := by
  have := stCost_le Bb ac.reverse [] (fun p hp => hac p (List.mem_reverse.1 hp)) (by simp)
  simpa using this

theorem sh_cost {Bb nst VA V cc : ℕ} (hVA : VA ≤ V) (hst : nst ≥ 0)
    (hcc : cc ≤ 250000 * (V + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2) {sc : ℕ}
    (hsc : sc ≤ 10 ^ 8 * (nst + 1) * (VA + 1) * (Bb + 2)) :
    (1 + 1) * 2000 * (Bb + 2) + sc + (3 * ((1 + 1) * 2000 * (Bb + 2)) + (cc + 3 * (2 * Bb + 2))) ≤
      cShiftUU nst V Bb := by
  unfold cShiftUU
  have h1 : (nst + 1) * (VA + 1) ≤ (nst + 1) * (V + 1) := Nat.mul_le_mul_left _ (by omega)
  have h2 : 10 ^ 8 * (nst + 1) * (VA + 1) * (Bb + 2) ≤ 10 ^ 8 * (nst + 1) * (V + 1) * (Bb + 2) := by
    have := Nat.mul_le_mul_right (10 ^ 8 * (Bb + 2)) h1
    calc _ = (nst + 1) * (VA + 1) * (10 ^ 8 * (Bb + 2)) := by ring
      _ ≤ (nst + 1) * (V + 1) * (10 ^ 8 * (Bb + 2)) := this
      _ = _ := by ring
  have h3 : (V + 1) * (Bb + 2) ≤ (nst + 1) * (V + 1) * (Bb + 2) := by
    rw [mul_assoc]; exact Nat.le_mul_of_pos_left _ (by omega)
  have h4 : Bb + 2 ≤ (V + 1) * (Bb + 2) := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : 10 ^ 9 * (nst + 1) * (V + 1) * (Bb + 2) = 10 * (10 ^ 8 * (nst + 1) * (V + 1) * (Bb + 2)) := by
    ring
  have e2 : 10 ^ 8 * (nst + 1) * (V + 1) * (Bb + 2) = 10 ^ 8 * ((nst + 1) * (V + 1) * (Bb + 2)) := by
    ring
  have e3 : 250000 * (V + 1) * (Bb + 2) = 250000 * ((V + 1) * (Bb + 2)) := by ring
  omega

end Body

end NLogN.KIL

