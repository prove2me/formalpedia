variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem tsum_dualValue_eq_inv_eval (hdeg : Module.finrank ℚ K = 3) {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hμu : IsUnitaryChar (𝓞 K) K μ) {S : Finset (HeightOneSpectrum (𝓞 ℚ))}
    (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v) (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (hvS : ∀ v, v ∉ T → v ∉ S) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ)
    (hχT : ∀ w ∉ T, IsUnramifiedCharAt χ w) {χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (s : ℂ) (hs : (8 : ℝ) ≤ s.re) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ T) :
    ∑' m : ℤ, dualValue (inducedCoeff K μ) v m * ((χ⁻¹ (uniformizerIdele ℚ v) ^ m : ℂˣ) : ℂ) *
        ((((Ideal.absNorm v.asIdeal : ℝ))⁻¹ ^ m : ℝ) : ℂ) ^ (s - 1) =
      ((inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ := by
  subst hχTdef
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hbad : ¬ IsBadPlace K μ v := fun h => hvS v hv ((hS v).mpr h)
  have hχ1 : ∀ w, w ∉ T →
      ‖((χ⁻¹ (uniformizerIdele ℚ w) : ℂˣ) : ℂ)‖ ≤ ((Ideal.absNorm w.asIdeal : ℕ) : ℝ) ^ (0 : ℝ) := by
    intro w _
    rw [Real.rpow_zero, MonoidHom.inv_apply, Units.val_inv_eq_inv_val, norm_inv, hχu (uniformizerIdele ℚ w), inv_one]
  have hsum := EulerProduct30.summable_shellSum_of_not_mem T χ⁻¹ (fun w => dualValue (inducedCoeff K μ) w) (κ := 4)
    (τ₀ := 0) (fun w _ m hm => dualValue_of_neg _ _ hm) (fun w hw n => norm_dualValue_le hdeg hμu
      (fun h => hvS w hw ((hS w).mpr h)) n) hχ1 s (by linarith) hv
  have hc : ∀ 𝔓 ∈ primeFibre ℚ K v, inducedCoeff K μ 𝔓 ≠ 0 := by
    intro 𝔓 h𝔓
    have hun := BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hbad 𝔓 h𝔓
    simp only [inducedCoeff, if_pos hun]
    exact Units.ne_zero _
  have he := BadPlaceBridges.ramificationIdx_under_eq_one_of_not_isBadPlace K μ v hbad
  rw [ShellToSeries.tsum_eq_inv_eval_inducedEulerPoly_of_forall_natCast_eq hdeg.le
      (c := fun 𝔓 => (inducedCoeff K μ 𝔓)⁻¹) (dualValue (inducedCoeff K μ) v) (fun m hm => dualValue_of_neg _ _ hm)
