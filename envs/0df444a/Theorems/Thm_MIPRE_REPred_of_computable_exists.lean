theorem MIPRE.REPred.of_computable_exists {α β : Type*} [Primcodable α] [Primcodable β]
    [Inhabited β] {test : α → β → Bool} (h : Computable fun q : α × β => test q.1 q.2) :
    REPred fun a => ∃ b, test a b = true := by sorry
