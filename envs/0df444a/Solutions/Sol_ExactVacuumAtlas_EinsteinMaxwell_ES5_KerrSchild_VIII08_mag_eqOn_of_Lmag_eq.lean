/-! ## The zero function and differences stay in the endpoint class -/

theorem magClass_zero : MagClass 3 (fun _ : ℝ => 0) := by
  refine ⟨contDiffOn_const, ⟨1, by norm_num, fun _ => 0, contDiffOn_const, ?_⟩, ?_⟩
  · intro R _
    rfl
  · exact ⟨0, le_rfl, 4, by norm_num, fun R _ => by
      constructor <;> simp⟩

theorem magClass_sub {b1 b2 : ℝ → ℝ} (h1 : MagClass 3 b1) (h2 : MagClass 3 b2) :
    MagClass 3 (fun s => b1 s - b2 s) := by
  refine ⟨h1.1.sub h2.1, h1.2.1.sub h2.2.1, ?_⟩
  exact ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05.AFDecay.sub
    (h1.1.of_le (m := 1) (by norm_num)) (h2.1.of_le (m := 1) (by norm_num)) h1.2.2 h2.2.2

theorem Lmag_zero (R : ℝ) : Lmag (fun _ : ℝ => 0) R = 0 := by
  unfold Lmag
  simp

