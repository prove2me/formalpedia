def Φ (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) : R →ₐ[O] A :=
  (Rig.existsUnique_P H.hPRO hs hc
    (exists_rig coord θ₀ resA H.hcoord H.hqO H.hX₀ hs hc E g hg).choose_spec.choose_spec.choose_spec).exists.choose

theorem Φ_spec (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) :
    ∃ (X : FormalODModule q A) (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (w : (X.map resA).Hom X₀.toFormalODModule),
      Rig coord θ₀ resA E g X θ w ∧ P resR Xu wu resA X w (Φ coord θ₀ resR Xu wu resA H hs hc E g hg) :=
  ⟨_, _, _, (exists_rig coord θ₀ resA H.hcoord H.hqO H.hX₀ hs hc E g hg).choose_spec.choose_spec.choose_spec,
    (Rig.existsUnique_P H.hPRO hs hc
      (exists_rig coord θ₀ resA H.hcoord H.hqO H.hX₀ hs hc E g hg).choose_spec.choose_spec.choose_spec).exists.choose_spec⟩

end
