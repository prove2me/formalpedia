theorem chunkL_nil {α : Type*} (n : ℕ) : Ref.chunkL n ([] : List α) = [] := by
  simp only [Ref.chunkL, List.length_nil, zero_add]
  rcases n with _ | n
  · simp
  · rw [Nat.div_eq_of_lt (by omega)]; simp

theorem chunkL_succ {α : Type*} (n : ℕ) (hn : 0 < n) (L : List α) (hL : n ≤ L.length) :
    Ref.chunkL n L = L.take n :: Ref.chunkL n (L.drop n) := by
  simp only [Ref.chunkL, List.length_drop]
  have e1 : (L.length + n - 1) / n = (L.length - n + n - 1) / n + 1 := by
    rw [show L.length + n - 1 = (L.length - n + n - 1) + 1 * n by omega,
      Nat.add_mul_div_right _ _ hn]
  rw [e1, List.range_succ_eq_map, List.map_cons, List.map_map]
  congr 1
  · simp
  · apply List.map_congr_left; intro i _
    simp only [Function.comp_apply, List.drop_drop]
    congr 2; rw [Nat.succ_eq_add_one]; ring

theorem chunkL_short {α : Type*} (n : ℕ) (L : List α) (h0 : 0 < L.length) (hL : L.length ≤ n) :
    Ref.chunkL n L = [L] := by
