-- name    : NAPPAL_Rate_Setting
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-10-15T23:14:40.229749+00:00
-- url     : https://prove2.me/theorems/a4ee91e7-913a-4401-996b-0b452f33dd1b
-- title:
--   §1.1–§3, (8), (18) — problem (P), Assumptions 1–2, L_γ, the stationarity set ∂L_γ, NAPP-AL and the potential Λ^k
-- statement:
--   This file fixes the model of Zhu, Zhao and Zhang's first-order primal-dual method NAPP-AL and everything the convergence analysis of its §4 is stated about.
--
--   **Problem (P).** For dimensions $n,d,m$ consider
--   $$\min_{u\in U,\ v\in\mathbb R^d}\ F(u,v):=G(u,v)+J(u)+H(v)\quad\text{s.t.}\quad \Theta(u)+Bv=0,\qquad \Theta:=\Omega+\Phi .$$
--   Here $G:\mathbb R^n\times\mathbb R^d\to\mathbb R$, $H:\mathbb R^d\to\mathbb R$ are differentiable, $J:\mathbb R^n\to\mathbb R$ is lower semicontinuous, $\Omega,\Phi:\mathbb R^n\to\mathbb R^m$, $B$ is a linear map $\mathbb R^d\to\mathbb R^m$ and $U\subseteq\mathbb R^n$. Write $\nabla_uG,\nabla_vG$ for the partial gradients, $\nabla\Theta(u)$ for the Jacobian, $\|B\|$ for the spectral norm and $\lambda_{\min}(B^\top B)=\min_{\|v\|=1}\|Bv\|^2$.
--
--   **Assumption 1** (p. 7). There are constants $L_G,L_H,L^0_\Theta\ge0$ and $L_{\Omega_j}\ge 0$ ($j=1,\dots,m$), with $L_\Omega:=\sum_j L_{\Omega_j}$, such that
--   1. (H1) $\nabla G$ is $L_G$-Lipschitz on $\mathbb R^n\times\mathbb R^d$ (Euclidean norm);
--   2. (H2) $\nabla H$ is $L_H$-Lipschitz;
--   3. (H3) $J$ is lower semicontinuous, every $u\in U$ has a neighbourhood in $\mathbb R^n$ on which $J$ is Lipschitz, and $U$ is closed and convex;
--   4. (H4) $\Omega$, $\Phi$ are differentiable and $\|\Theta(u)-\Theta(u')\|\le L^0_\Theta\|u-u'\|$;
--   5. (H5) each component $\Omega_j$ has an $L_{\Omega_j}$-Lipschitz gradient;
--   6. (H6) $\operatorname{Im}\Theta\subseteq\operatorname{Im}B$ and $\lambda_{\min}(B^\top B)>0$;
--   7. (H7) $F$ is bounded below on the feasible set $\{(u,v):\Theta(u)+Bv=0\}$ and every sublevel set $\{(u,v):\Theta(u)+Bv=0,\ F(u,v)\le M\}$ is bounded.
--
--   **Assumption 2** (p. 9). $K:\mathbb R^n\to\mathbb R$ is differentiable, $\beta$-strongly convex ($\beta>0$) with $L_K$-Lipschitz gradient, and
--   $$\gamma>\frac{\sqrt{57}+1}{2\lambda_{\min}(B^\top B)}(L_G+L_H).$$
--
--   **Augmented Lagrangian and stationarity** (p. 6). For $w=(u,v,p)$,
--   $$\mathcal L_\gamma(w)=F(u,v)+\langle p,\Theta(u)+Bv\rangle+\frac\gamma2\|\Theta(u)+Bv\|^2 .$$
--   With $r:=\Theta(u)+Bv$ and $y:=p+\gamma r$, the set $\partial\mathcal L_\gamma(w)$ consists of the triples $(\xi_u,\xi_v,\xi_p)$ with
--   $$\xi_u\in\nabla_uG(u,v)+\partial J(u)+N_U(u)+(\nabla\Theta(u))^\top y,\qquad \xi_v=\nabla_vG(u,v)+\nabla H(v)+B^\top y,\qquad \xi_p=r,$$
--   where $\partial J$ is the limiting subdifferential and $N_U(u)=\{\xi:\langle\xi,\zeta-u\rangle\le0\ \forall\zeta\in U\}$ for $u\in U$, $N_U(u)=\emptyset$ for $u\notin U$. A point $w$ is *stationary* if $0\in\partial\mathcal L_\gamma(w)$. $\operatorname{dist}(0,S)=\inf\{\|\xi\|:\xi\in S\}\in[0,+\infty]$, with $\operatorname{dist}(0,\emptyset)=+\infty$; here $\|(u,v,p)\|=\sqrt{\|u\|^2+\|v\|^2+\|p\|^2}$.
--
--   **NAPP-AL** (p. 8). With the Bregman distance $D(u,u')=K(u)-K(u')-\langle\nabla K(u'),u-u'\rangle$, parameters $\gamma>0$, $0<\sigma<1$, steps $\delta_k>0$ and $\sigma\delta_k\le\epsilon^k\le\delta_k$, a sequence $w^k=(u^k,v^k,p^k)$ is generated by NAPP-AL if, with $q^k=p^k+\gamma(\Theta(u^k)+Bv^k)$,
--   $$u^{k+1}\in\arg\min_{u\in U}\ \langle\nabla_uG(u^k,v^k),u\rangle+J(u)+\langle q^k,\nabla\Omega(u^k)u+\Phi(u)\rangle+\tfrac1{\epsilon^k}D(u,u^k),\tag{5}$$
--   $$v^{k+1}\in\arg\min_{v}\ \langle\nabla_vG(u^k,v^k)+\nabla H(v^k),v\rangle+\langle q^k,Bv\rangle+\tfrac\gamma2\|B(v-v^k)\|^2,\tag{6}$$
--   $$p^{k+1}=p^k+\gamma(\Theta(u^{k+1})+Bv^{k+1}).\tag{7}$$
--   The step rule (8) is
--   $$\delta_k=\beta\Big(L_G+\|q^k\|L_\Omega+\gamma(L^0_\Theta)^2+\frac{14\gamma\|B\|^2(L^0_\Theta)^2}{\lambda_{\min}(B^\top B)}+\frac{14(L_G+\gamma\|B\|L^0_\Theta)^2}{\gamma\lambda_{\min}(B^\top B)}+1\Big)^{-1}.$$
--   The bundle *RunHyp* says: Assumptions 1 and 2 hold, $\{w^k\}$ is generated by NAPP-AL and $\delta_k$ is set by (8).
--
--   **Constants and potential** ((18), Lemma 4.3, Proposition 3.1). $c_1=\frac{7(L_G+\gamma\|B\|L^0_\Theta)^2}{\gamma\lambda_{\min}(B^\top B)}$, $c_2=\frac{7(L_G+L_H)^2}{\gamma\lambda_{\min}(B^\top B)}$, $c_4=\frac{\gamma\lambda_{\min}(B^\top B)-(L_G+L_H)}2-c_2$, $c_3=\min\{\frac12,c_4,\frac1{3\gamma}\}$,
--   $$\Lambda^k=\mathcal L_\gamma(w^k)+c_1\|u^{k-1}-u^k\|^2+c_2\|v^{k-1}-v^k\|^2+\frac1{2\gamma}\|p^{k-1}-p^k\|^2\qquad(k\ge1),$$
--   and $h(u^k,p^k)=\max\{2L_G+\|q^k\|L_\Omega+\gamma\|B\|L^0_\Theta+\gamma(L^0_\Theta)^2+\frac{L_K}{\sigma\delta_k},\ 2L_G+L_H+\gamma\|B\|L^0_\Theta,\ L^0_\Theta+\|B\|+\frac1\gamma\}$.
--
--   These objects are the common ground of Proposition 3.1, Lemmas 4.1–4.3, Theorem 4.1 and Proposition 4.1.
--
--   **Formalization Note** Points live in `EuclideanSpace ℝ (Fin k)`; the norm of a triple is the explicit Euclidean `tnorm`, never Mathlib's sup norm on products. $B$ is a continuous linear map with its operator norm (= spectral norm), $B^\top$ its adjoint; $\lambda_{\min}(B^\top B)$ is the Rayleigh infimum over the unit sphere. $\operatorname{dist}(0,\cdot)$ takes values in $[0,+\infty]$ so that it is $+\infty$ on $\emptyset$, as on p. 5. Disclosed readings of the page: $G,H,J$ are real valued with gradients Lipschitz on the whole space (the page allows extended values with Lipschitz gradients "on dom"); "$J$ locally Lipschitz on $\operatorname{dom}J\cap U$" is read as Lipschitz on a full neighbourhood of each point of $U$ (Mathlib's relative `LocallyLipschitzOn` is not used); full column rank $\lambda_{\min}(B^\top B)>0$, which the proof of Lemma 4.2 invokes; $N_U(u)=\emptyset$ off $U$. NAPP-AL is a relation on given sequences: $u^{k+1}$ is any global minimizer of (5) over $U$ (existence is not asserted, Remark 3.2), and $u^0$ need not lie in $U$. $\Lambda^k$ uses natural-number subtraction and is meaningful only for $k\ge1$; every statement about it quantifies over $k\ge1$. The limiting subdifferential is the published `NonconvexSplitting.Shared.LimitingSubdiff` applied to $J$ viewed as an extended-real function.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, pp. 2–9, 14, 15, (P), Definition 2.1, the KKT display on p. 6, Assumption 1, NAPP-AL (5)–(7), Assumption 2, (8), Proposition 3.1 (h), (18), Lemma 4.3 (c_3, c_4)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NAPPAL_KL_Setting

namespace NAPPAL.Rate

open Filter Topology
open scoped InnerProductSpace

variable {n d m : ℕ}

/-- `q^k = p^k + γ(Θ(u^k) + Bv^k)`. -/
noncomputable def qseq (P : NAPPAL.KL.Problem n d m) (γ : ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d)
    (p : ℕ → NAPPAL.KL.E m) (k : ℕ) : NAPPAL.KL.E m :=
  p k + γ • (NAPPAL.KL.Theta P (u k) + P.B (v k))

/-- The objective of subproblem (5) at `x`:
`⟨∇_uG(u^k,v^k), x⟩ + J(x) + ⟨q^k, ∇Ω(u^k)x + Φ(x)⟩ + D(x, u^k)/ǫ^k`. -/
noncomputable def obj5 (P : NAPPAL.KL.Problem n d m) (K : NAPPAL.KL.E n → ℝ) (uk : NAPPAL.KL.E n) (vk : NAPPAL.KL.E d) (q : NAPPAL.KL.E m)
    (εk : ℝ) (x : NAPPAL.KL.E n) : ℝ :=
  ⟪NAPPAL.KL.gradU P uk vk, x⟫_ℝ + P.J x + ⟪q, fderiv ℝ P.Om uk x + P.Phi x⟫_ℝ + NAPPAL.KL.bregman K x uk / εk

/-- The objective of subproblem (6) at `y`:
`⟨∇_vG(u^k,v^k) + ∇H(v^k), y⟩ + ⟨q^k, By⟩ + γ/2 ‖B(y - v^k)‖²`. -/
noncomputable def obj6 (P : NAPPAL.KL.Problem n d m) (γ : ℝ) (uk : NAPPAL.KL.E n) (vk : NAPPAL.KL.E d) (q : NAPPAL.KL.E m)
    (y : NAPPAL.KL.E d) : ℝ :=
  ⟪NAPPAL.KL.gradV P uk vk + gradient P.H vk, y⟫_ℝ + ⟪q, P.B y⟫_ℝ + γ / 2 * ‖P.B (y - vk)‖ ^ 2

/-- `(u, v, p)` is a run of NAPP-AL (p. 8) with parameters `γ > 0`, `0 < σ < 1`, steps
`δ_k > 0`, `σδ_k ≤ ǫ^k ≤ δ_k`: `u^{k+1}` is a global minimizer of (5) over `U`, `v^{k+1}` a
minimizer of (6) over `ℝ^d`, and `p^{k+1}` is given by (7). The start `(u^0, v^0, p^0)` is free. -/
def IsNAPPAL (P : NAPPAL.KL.Problem n d m) (K : NAPPAL.KL.E n → ℝ) (γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n)
    (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m) : Prop :=
  0 < γ ∧ 0 < σ ∧ σ < 1 ∧ ∀ k : ℕ,
    (0 < δ k ∧ σ * δ k ≤ ε k ∧ ε k ≤ δ k) ∧
    -- (5)
    (u (k + 1) ∈ P.U ∧ ∀ x ∈ P.U,
      obj5 P K (u k) (v k) (qseq P γ u v p k) (ε k) (u (k + 1)) ≤
        obj5 P K (u k) (v k) (qseq P γ u v p k) (ε k) x) ∧
    -- (6)
    (∀ y : NAPPAL.KL.E d, obj6 P γ (u k) (v k) (qseq P γ u v p k) (v (k + 1)) ≤
      obj6 P γ (u k) (v k) (qseq P γ u v p k) y) ∧
    -- (7)
    p (k + 1) = p k + γ • (NAPPAL.KL.Theta P (u (k + 1)) + P.B (v (k + 1)))

/-- "Under Assumptions 1 and 2, set `δ_k` as in (8); `{w^k}` is generated by NAPP-AL." -/
def RunHyp (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ) (K : NAPPAL.KL.E n → ℝ)
    (β LK γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m) : Prop :=
  NAPPAL.KL.Assumption1 P LG LH L0 LOmj ∧ NAPPAL.KL.Assumption2 P K β LK γ LG LH ∧
    IsNAPPAL P K γ σ δ ε u v p ∧
    ∀ k, δ k = NAPPAL.KL.delta8 P LG L0 (NAPPAL.KL.LOm LOmj) β γ (qseq P γ u v p k)

/-- `h(u^k, p^k)` of Proposition 3.1 (p. 9), as a function of `q = q^k` and `δ_k`. -/
noncomputable def hfun (P : NAPPAL.KL.Problem n d m) (LG LH L0 LOm LK γ σ : ℝ) (q : NAPPAL.KL.E m) (δk : ℝ) : ℝ :=
  max (max (2 * LG + ‖q‖ * LOm + γ * ‖P.B‖ * L0 + γ * L0 ^ 2 + LK / (σ * δk))
    (2 * LG + LH + γ * ‖P.B‖ * L0)) (L0 + ‖P.B‖ + 1 / γ)

end NAPPAL.Rate


