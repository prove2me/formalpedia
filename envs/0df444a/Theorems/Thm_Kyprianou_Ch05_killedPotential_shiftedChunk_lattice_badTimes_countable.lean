-- title:
--   Bad times for the shifted chunk on the lattice are countable
-- statement:
--   Let $Y$ be a killed subordinator with Laplace triplet $(\eta, d, \Pi, \Phi)$. Let $h > 0$ and $0 < a \le b$ with the chunk $[a,b]$ containing no lattice point $nh$ ($n \in \mathbb{Z}$). Then for every $\delta$, the set of times $t \in (0, \delta]$ at which $P(\text{alive at } t,\ Y_t \in dt + [a,b],\ Y_t \in h\mathbb{Z}) \ne 0$ is countable.
-- source:
--   Kyprianou, Fluctuations of Lévy Processes with Applications (2006), Ch. 5, Theorem 5.4 — supporting countability step for the lattice-restricted occupation charge.

import Mathlib
import Mathlib.MeasureTheory.Group.Convolution
import Definitions.Def_Kyprianou_Ch03_IsSubordinator
import Definitions.Def_Kyprianou_Ch03_EntryAndHittingTimes
import Definitions.Def_Kyprianou_Ch05_RenewalMeasure
import Definitions.Def_Kyprianou_Ch05_KilledSubordinatorPotential
open MeasureTheory Filter ProbabilityTheory
open scoped NNReal ENNReal
set_option autoImplicit false

namespace Kyprianou.Ch05

/-- The set of times at which the drift-shifted chunk charges the lattice with
positive probability is countable: a bad time forces an atom of the law of
$Y_t$ at a lattice point $nh$ with $nh - dt$ in the chunk, and the atoms of
the laws of a subordinator lie in the countable semigroup generated by the
atoms of its Lévy measure, shifted by the drift. -/
theorem killedPotential_shiftedChunk_lattice_badTimes_countable
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (Y : NNReal → Omega → Real)
    (death : Omega → WithTop NNReal)
    (eta d : Real) (Pi : Measure Real) (Phi : Real → Real)
    (hKilled : IsKilledSubordinator P Y death eta)
    (hTriplet : IsKilledLaplaceTriplet eta d Pi Phi)
    (hLaplaceLaw : ∀ (t : NNReal) (theta : Real), 0 ≤ theta →
      (∫ omega, Real.exp (-theta * Y t omega) ∂P) =
        Real.exp (-(t : Real) * (Phi theta - eta)))
    (U : Real → Measure Real)
    (hPotential : IsKilledPotentialFamily P Y death U) :
  (∀ h : Real, 0 < h → ∀ a b : Real, 0 < a → a ≤ b →
      (∀ z ∈ Set.Icc a b, ∀ n : Int, z ≠ (n : Real) * h) →
      ∀ δ : Real,
        Set.Countable {t : Real | t ∈ Set.Ioc (0 : Real) δ ∧
          P {omega : Omega | (Real.toNNReal t : WithTop NNReal) < death omega ∧
            Y (Real.toNNReal t) omega ∈ {z : Real | ∃ y ∈ Set.Icc a b, z = d * t + y} ∧
            Y (Real.toNNReal t) omega ∈ {z : Real | ∃ n : Int, z = (n : Real) * h}} ≠ 0})
 := by
  sorry

end Kyprianou.Ch05
