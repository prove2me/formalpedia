open MeasureTheory Set
open scoped NNReal ENNReal
open AvramDividend.Classical

theorem AvramDividend.Classical.runningSup_dividendMeasure_Ioc_rightLim
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕) (ω : Ω) (s t : ℝ) :
    (dividendMeasure (runningSup X) ω) (Set.Ioc s t) =
      ENNReal.ofReal
        (Function.rightLim (fun r : ℝ => runningSup X r.toNNReal ω) t -
         Function.rightLim (fun r : ℝ => runningSup X r.toNNReal ω) s) := by sorry
