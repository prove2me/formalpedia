theorem clearMem_get (B : ℕ) (m : ℕ → ℕ) (n i : ℕ) (hi : i < n) :
    clearMem B m n (B + i) = 0 := by
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases h : i = n
      · subst i
        simp [clearMem]
      · rw [clearMem, Function.update_of_ne (by omega : B + i ≠ B + n)]
        exact ih (by omega)

theorem clearMem_frame (B : ℕ) (m : ℕ → ℕ) (n a : ℕ)
    (ha : a < B ∨ B + n ≤ a) : clearMem B m n a = m a := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [clearMem, Function.update_of_ne (by omega : a ≠ B + n)]
      exact ih (by omega)

theorem clearCond_eval (pc B L : ℕ) (m : ℕ → ℕ) (r : Fin 16 → ℕ) (j : ℕ) :
    clearCond.eval (clearState pc B L m r j) ↔ j < L := by
  simp [clearCond, Cond.eval, clearState]

theorem clearBody_spec (E : RAMEnv) (pc B L : ℕ) (m : ℕ → ℕ) (r : Fin 16 → ℕ)
    (j : ℕ) (hj : j < L) (hW : 1 < 2 ^ E.W) (hL : L < 2 ^ E.W)
    (hB : B + L ≤ 2 ^ E.W) :
    runBlock clearBody E
      { runBlock clearCond.code E (clearState pc B L m r j) with pc := pc + 2 } =
      { clearState pc B L m r (j + 1) with pc := pc + 7 } := by
  have haddr : (B + j) % 2 ^ E.W = B + j := Nat.mod_eq_of_lt (by omega)
  have hnext : (j + 1) % 2 ^ E.W = j + 1 := Nat.mod_eq_of_lt (by omega)
  have h1 : (1 : ℕ) % 2 ^ E.W = 1 := Nat.mod_eq_of_lt hW
  apply ramState_eq_of
  ·     simp only [clearBody, Fin.isValue, Cond.code, clearCond, clearState, runBlock_cons, execInstr,
      ↓reduceIte, one_ne_zero, runBlock_nil, ne_eq, Fin.reduceEq, not_false_eq_true, Function.update_of_ne,
      Function.update_self, Nat.zero_mod, Nat.add_right_cancel_iff, Nat.add_left_cancel_iff] <;> omega
  ·     simp only [clearBody, Fin.isValue, Cond.code, clearCond, clearState, runBlock_cons, execInstr,
      ↓reduceIte, one_ne_zero, hj, h1, runBlock_nil, ne_eq, Fin.reduceEq, not_false_eq_true,
      Function.update_of_ne, haddr, Function.update_self, hnext, Nat.zero_mod, clearMem]
  · intro d
    fin_cases d <;>
      simp only [clearBody, Fin.isValue, Cond.code, clearCond, clearState, runBlock_cons, execInstr,
        ↓reduceIte, one_ne_zero, hj, h1, runBlock_nil, ne_eq, Fin.reduceEq, not_false_eq_true,
        Function.update_of_ne, haddr, Function.update_self, hnext, Nat.zero_mod, Fin.zero_eta,
        Nat.add_left_cancel_iff, Fin.mk_one, Fin.reduceFinMk]

theorem clearBodyIter (P : Program) (E : RAMEnv) (pc B L : ℕ)
    (m : ℕ → ℕ) (r : Fin 16 → ℕ) (j : ℕ) (hj : j < L)
    (hAt : At P pc (Stmt.compile clearStmt pc))
    (hW : 1 < 2 ^ E.W) (hL : L < 2 ^ E.W) (hB : B + L ≤ 2 ^ E.W) :
    Sem P E (pc + clearCond.code.length + 1) pc
      { runBlock clearCond.code E (clearState pc B L m r j) with pc := pc + clearCond.code.length + 1 }
      (fun k s' => k = 6 ∧ s' = clearState pc B L m r (j + 1)) := by
  obtain ⟨_, _, hbody, hjmp⟩ := at_loop hAt
  have hbodyAt : At P (pc + 2) clearBody := hbody
  have hjmpAt : P[pc + 7]? = some (iJmp pc) := hjmp
  have hrun : Sem P E (pc + 2) (pc + 7)
      { runBlock clearCond.code E (clearState pc B L m r j) with pc := pc + 2 }
      (fun k s' => k = 5 ∧ s' = { clearState pc B L m r (j + 1) with pc := pc + 7 }) := by
    refine Sem.mono (Sem.block P E (pc + 2) clearBody _ hbodyAt
      (by simp [clearBody]) rfl) ?_
    intro k s' h
    obtain ⟨hk, hs⟩ := h
    refine ⟨hk, ?_⟩
    rw [hs]
    exact clearBody_spec E pc B L m r j hj hW hL hB
  refine Sem.jmp_append (hAt := hjmpAt) (Sem.mono hrun ?_)
  intro k s' h
  obtain ⟨hk, hs⟩ := h
  refine ⟨by omega, ?_⟩
  rw [hs]
  rfl

theorem clearCond_exit (E : RAMEnv) (pc B L : ℕ) (m : ℕ → ℕ) (r : Fin 16 → ℕ) :
    ({ runBlock clearCond.code E (clearState pc B L m r L) with pc := pc + 8 } : RAMState) =
      { clearState pc B L m r L with pc := pc + 8 } := by
  apply ramState_eq_of
  · rfl
  · rfl
  · intro d
    fin_cases d <;> simp [clearCond, Cond.code, runBlock_cons, runBlock_nil, execInstr, clearState]

/-- An actual counted RAM loop clears the array and preserves all memory
outside it, with at most `8L+2` steps. -/
theorem clearArray_spec (P : Program) (E : RAMEnv) (pc B L : ℕ)
    (m : ℕ → ℕ) (r : Fin 16 → ℕ)
    (hAt : At P pc (Stmt.compile clearStmt pc))
    (hW : 1 < 2 ^ E.W) (hL : L < 2 ^ E.W) (hB : B + L ≤ 2 ^ E.W) :
    Sem P E pc (pc + 8) (clearState pc B L m r 0)
      (fun k s' => k ≤ 8 * L + 2 ∧ s' = { clearState pc B L m r L with pc := pc + 8 }) := by
  have h := Sem.loop P E pc clearCond (.code clearBody) hAt hW L
    (fun j => clearState pc B L m r j) (fun _ => 6)
    (fun _ => rfl)
    (fun j hj => (clearCond_eval pc B L m r j).mpr hj)
    (fun hf => (Nat.lt_irrefl L) ((clearCond_eval pc B L m r L).mp hf))
    (fun j hj => clearBodyIter P E pc B L m r j hj hAt hW hL hB)
  refine Sem.mono h ?_
  intro k s' hQ
  obtain ⟨hcost, hs⟩ := hQ
  refine ⟨?_, ?_⟩
  · have hsum : (∑ j ∈ Finset.range L, (clearCond.code.length + 1 + 6)) = 8 * L := by
      change (∑ j ∈ Finset.range L, (8 : ℕ)) = 8 * L
      exact sum_range_const_mul L 8
    rw [hsum] at hcost
    change k ≤ 2 + 8 * L at hcost
    omega
  · rw [hs]
    exact clearCond_exit E pc B L m r

theorem posTab_zero_iff {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (v : F) :
    posTab N ι v = 0 ↔ ¬ ∃ i, i < N ∧ ι i = v := by
  classical
  by_cases h : ∃ i, i < N ∧ ι i = v <;> simp [posTab, h]

theorem posTab_positive_spec {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (v : F)
    (hpos : 0 < posTab N ι v) : ∃ i, i < N ∧ posTab N ι v = i + 1 ∧ ι i = v := by
  classical
  by_cases h : ∃ i, i < N ∧ ι i = v
  · exact ⟨Classical.choose h, (Classical.choose_spec h).1, by simp [posTab, h], (Classical.choose_spec h).2⟩
  · simp [posTab, h] at hpos

theorem posTab_iota {F : Type} [Field F] (N : ℕ) (ι : ℕ → F)
    (hinj : Set.InjOn ι (Set.Iio N)) (i : ℕ) (hi : i < N) : posTab N ι (ι i) = i + 1 := by
  classical
  have h : ∃ j, j < N ∧ ι j = ι i := ⟨i, hi, rfl⟩
  have hc := Classical.choose_spec h
  have heq : Classical.choose h = i := hinj hc.1 hi hc.2
  simp [posTab, h, heq]

theorem OutputStored.of_frame {A : ℕ → Prop} {m m' : ℕ → ℕ} {B : ℕ} {xs : List ℕ}
    (h : OutputStored m B xs) (hf : MemoryFrame A m m') (hr : ∀ j < xs.length, ¬ A (B + j)) :
    OutputStored m' B xs := by
  intro j hj
  rw [hf (B + j) (hr j hj)]
  exact h j hj

theorem positionValidBit_eq_one (p : ℕ) : positionValidBit p = 1 ↔ 0 < p := by
  by_cases hp : 0 < p <;> simp [positionValidBit, hp]

theorem bit_mul_eq_one (a b : ℕ) (ha : a ≤ 1) (hb : b ≤ 1) : a * b = 1 ↔ a = 1 ∧ b = 1 := by
  interval_cases a <;> interval_cases b <;> norm_num

theorem rootPositionFlag_valid {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us : List F) :
    rootPositionFlag N ι us = 1 ↔ ∀ u ∈ us, 0 < posTab N ι u⁻¹ := by
  induction us with
  | nil => simp [rootPositionFlag]
  | cons u us ih =>
      change positionValidBit (posTab N ι u⁻¹) * rootPositionFlag N ι us = 1 ↔ _
      rw [bit_mul_eq_one _ _ (positionValidBit_le _) (rootPositionFlag_le_one N ι us)]
      simp [positionValidBit_eq_one, ih]

theorem rootPositionIndex_inj {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (u v : F)
    (hu : 0 < posTab N ι u⁻¹) (hv : 0 < posTab N ι v⁻¹)
    (heq : posTab N ι u⁻¹ - 1 = posTab N ι v⁻¹ - 1) : u = v := by
  obtain ⟨i, hi, hpi, hvi⟩ := posTab_positive_spec N ι u⁻¹ hu
  obtain ⟨j, hj, hpj, hvj⟩ := posTab_positive_spec N ι v⁻¹ hv
  have hij : i = j := by rw [hpi, hpj] at heq; simpa using heq
  have he : u⁻¹ = v⁻¹ := by rw [← hvi, ← hvj, hij]
  calc
    u = (u⁻¹)⁻¹ := (inv_inv u).symm
    _ = (v⁻¹)⁻¹ := congrArg (fun x : F => x⁻¹) he
    _ = v := inv_inv v

theorem rootPositionList_nodup {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us : List F)
    (hnd : us.Nodup) (hvalid : rootPositionFlag N ι us = 1) : (rootPositionList N ι us).Nodup := by
  suffices hh : ∀ xs : List F, xs.Nodup → (∀ u ∈ xs, 0 < posTab N ι u⁻¹) →
      (rootPositionList N ι xs).Nodup from hh us hnd ((rootPositionFlag_valid N ι us).mp hvalid)
  intro xs
  induction xs with
  | nil => intro _ _; simp [rootPositionList]
  | cons u xs ih =>
      intro hnd hv
      have hnd' := List.nodup_cons.mp hnd
      have hvu := hv u (by simp)
      have hvt : ∀ v ∈ xs, 0 < posTab N ι v⁻¹ := fun v hv' => hv v (by simp [hv'])
      rw [rootPositionList, List.map_cons, List.nodup_cons]
      refine ⟨?_, ih hnd'.2 hvt⟩
      intro hbad
      obtain ⟨v, hv', hveq⟩ := List.mem_map.mp hbad
      have he := rootPositionIndex_inj N ι v u (hvt v hv') hvu hveq
      exact hnd'.1 (he ▸ hv')

theorem rootPositionList_range {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us : List F)
    (hN : 1 ≤ N) : ∀ i ∈ rootPositionList N ι us, i < N := by
  intro i hi
  obtain ⟨u, hu, rfl⟩ := List.mem_map.mp hi
  have hp := posTab_le N ι u⁻¹
  omega

theorem rootPositionList_iota {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us : List F)
    (hvalid : rootPositionFlag N ι us = 1) (u : F) (hu : u ∈ us) :
    ι (posTab N ι u⁻¹ - 1) = u⁻¹ := by
  have hp := (rootPositionFlag_valid N ι us).mp hvalid u hu
  obtain ⟨i, hi, hpi, hvi⟩ := posTab_positive_spec N ι u⁻¹ hp
  simpa [hpi] using hvi

theorem FieldArrayStored.meta_update {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m : ℕ → ℕ} {B len : ℕ} {v : ℕ → F}
    (h : FieldArrayStored b m B len v) (hB : 128 ≤ B) (slot value : ℕ) (hs : slot < 128) :
    FieldArrayStored b (Function.update m slot value) B len v := by
  intro j hj
  rw [Function.update_of_ne (by omega : B + j ≠ slot)]
  exact h j hj

theorem FieldArrayStored.congr_values {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m : ℕ → ℕ} {B len : ℕ} {v v' : ℕ → F}
    (h : FieldArrayStored b m B len v) (hv : ∀ j < len, v j = v' j) : FieldArrayStored b m B len v' := by
  intro j hj
  rw [← hv j hj]
  exact h j hj

theorem listPowerSums_nil {F : Type} [Field F] (ι : ℕ → F) (j : ℕ) : listPowerSums ι [] j = 0 := by
  simp [listPowerSums]

theorem listPowerSums_append_one {F : Type} [Field F] (ι : ℕ → F) (xs : List ℕ) (i j : ℕ) :
    listPowerSums ι (xs ++ [i]) j = listPowerSums ι xs j + ι i ^ (j + 1) := by
  simp [listPowerSums, List.sum_append]

theorem powerPrefix_zero {F : Type} [Field F] (v : ℕ → F) (a : F) : powerPrefix v a 0 = v := by
  funext j
  simp [powerPrefix]

theorem powerPrefix_complete {F : Type} [Field F] (v : ℕ → F) (a : F) (len j : ℕ) (hj : j < len) :
    powerPrefix v a len j = v j + a ^ (j + 1) := by simp [powerPrefix, hj]

theorem powerPrefix_succ_stored {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (B len k : ℕ) (v : ℕ → F) (a : F)
    (hk : k < len) (h : FieldArrayStored b m B len (powerPrefix v a k)) :
    FieldArrayStored b (Function.update m (B + k) (enc b (v k + a ^ (k + 1)))) B len (powerPrefix v a (k + 1)) := by
  intro j hj
  by_cases heq : j = k
  · subst j
    rw [Function.update_self]
    simp [powerPrefix]
  · rw [Function.update_of_ne (by omega : B + j ≠ B + k), h j hj]
    congr 1
    dsimp [powerPrefix]
    have hiff : (j < k + 1) = (j < k) := propext (by omega)
    simp only [hiff]

theorem fieldImage_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState) (i : ℕ)
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hi : i < 2 ^ w) (h10 : s.regs r10 = i) :
    runBlock fieldImageCode E s =
      { s with pc := s.pc + 4, regs := Function.update (Function.update (Function.update s.regs r15 (detImgBase w)) r14 (detImgBase w + i)) r10 (enc b (ι i)) } := by
  have hwe : w ≤ E.W := by omega
  have hend : detEnd w < 2 ^ E.W := by rw [hW]; exact detEnd_lt hw
  have hbase : detImgBase w < 2 ^ E.W := by
    have hpos := Nat.two_pow_pos w
    unfold detEnd at hend
    omega
  have haddr : detImgBase w + i < 2 ^ E.W := by unfold detEnd at hend; omega
  have h10Word : (10 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (10 : ℕ) < 2 ^ 8) hp
  have hh : E.det 10 = detImgBase w := by
    rw [hdet, detStd_hdr t N w b ι (by decide : 10 < 13)]
    rfl
  have ht : E.det (detImgBase w + i) = enc b (ι i) := by rw [hdet, detStd_img t N b ι hi]
  have hv : enc b (ι i) < 2 ^ E.W := lt_of_lt_of_le (enc_lt b _) (Nat.pow_le_pow_right (by norm_num) hwe)
  apply ramState_eq_of
  · simp [fieldImageCode, runBlock_cons, runBlock_nil, execInstr] <;> omega
  · rfl
  · intro r
    fin_cases r <;> simp [fieldImageCode, runBlock_cons, runBlock_nil, execInstr, h10, hh, ht,
      Nat.mod_eq_of_lt h10Word, Nat.mod_eq_of_lt hbase, Nat.mod_eq_of_lt haddr, Nat.mod_eq_of_lt hv]

theorem advanceCounter_spec (E : RAMEnv) (s : RAMState) (index counter j n : ℕ)
    (hi : index < 2 ^ E.W) (hc : counter < 2 ^ E.W) (hne : index ≠ counter)
    (hj : j + 1 < 2 ^ E.W) (hn : n + 1 < 2 ^ E.W)
    (hmi : s.mem index = j) (hmc : s.mem counter = n + 1) :
    runBlock (advanceCounterCode index counter) E s = rankState (s.pc + 51)
      (Function.update (Function.update s.mem index (j + 1)) counter n) n := by
  rw [advanceCounterCode, runBlock_append, incrementMeta_spec E s index j hi hj hmi]
  have hcounter : (boundaryState (s.pc + 24) (Function.update s.mem index (j + 1))).mem counter = n + 1 := by
    simpa [boundaryState, Ne.symm hne] using hmc
  rw [countdown_spec E _ counter n hc hn hcounter] <;> rfl

theorem powerAccumulate_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (B j : ℕ) (x y : F)
    (hmeta : (115 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hB : B < 2 ^ E.W) (hj : j < 2 ^ E.W) (haddr : B + j < 2 ^ E.W)
    (hm86 : s.mem 86 = B) (hm113 : s.mem 113 = j) (hm115 : s.mem 115 = enc b y) (hmV : s.mem (B + j) = enc b x) :
    ∃ z, runBlock powerAccumulateCode E s = z ∧ z.pc = s.pc + 13 ∧
      z.mem = Function.update s.mem (B + j) (enc b (x + y)) := by
  have hsmall (i : ℕ) (hi : i ≤ 115) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  have hEnc (a : F) : enc b a % 2 ^ E.W = enc b a :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le (enc_lt b a) (Nat.pow_le_pow_right (by norm_num) hwe))
  let sA := runBlock (metaReadCode r2 86 ++ metaReadCode r0 113 ++ [iAdd r2 r2 r0, iLd r10 r2]) E s
  have hA2 : sA.regs r2 = B + j := by
    simp [sA, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm86, hm113, Nat.mod_eq_of_lt hB, Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt haddr]
  have hA10 : sA.regs r10 = enc b x := by
    simp [sA, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm86, hm113, Nat.mod_eq_of_lt hB, Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt haddr, hmV, hEnc]
  let sB := runBlock (metaReadCode r11 115) E sA
  have hB2 : sB.regs r2 = B + j := by simp [sB, metaRead_spec, hA2]
  have hB10 : sB.regs r10 = enc b x := by simp [sB, metaRead_spec, hA10]
  have hB11 : sB.regs r11 = enc b y := by
    have hmA : sA.mem = s.mem := rfl
    simp [sB, metaRead_spec, hsmall, hmA, hm115, hEnc]
  let sC := runBlock [iBxor r10 r10 r11, iSt r2 r10] E sB
  have hCmem : sC.mem = Function.update s.mem (B + j) (enc b (x + y)) := by
    simp [sC, runBlock_cons, runBlock_nil, execInstr, hB2, hB10, hB11, ← enc_add_xor, hEnc] <;> rfl
  have he : runBlock powerAccumulateCode E s = sC := by
    simp only [powerAccumulateCode, runBlock_append]
    rfl
  refine ⟨sC, he, ?_, hCmem⟩
  have hp := runBlock_pc powerAccumulateCode E s (by simp [powerAccumulateCode, metaReadCode])
  rw [he] at hp
  exact hp

theorem powerMultiply_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState) (y a : F)
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (116 : ℕ) < 2 ^ E.W)
    (hm115 : s.mem 115 = enc b y) (hm116 : s.mem 116 = enc b a) (hm77 : s.mem 77 = w) :
    ∃ z, runBlock powerMultiplyCode E s = z ∧ z.pc = s.pc + 19 ∧
      z.mem = Function.update s.mem 115 (enc b (y * a)) := by
  have hwe : w ≤ E.W := by omega
  have hsmall (i : ℕ) (hi : i ≤ 116) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  have hEnc (v : F) : enc b v % 2 ^ E.W = enc b v :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le (enc_lt b v) (Nat.pow_le_pow_right (by norm_num) hwe))
  have hdim : w % 2 ^ E.W = w := Nat.mod_eq_of_lt (by have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self; omega)
  let sA := runBlock (metaReadCode r10 115 ++ metaReadCode r11 116 ++ metaReadCode r3 77) E s
  have hA3 : sA.regs r3 = w := by simp [sA, runBlock_append, metaRead_spec, hsmall, hm115, hm116, hm77, hEnc, hdim]
  have hA10 : sA.regs r10 = enc b y := by simp [sA, runBlock_append, metaRead_spec, hsmall, hm115, hm116, hm77, hEnc, hdim]
  have hA11 : sA.regs r11 = enc b a := by simp [sA, runBlock_append, metaRead_spec, hsmall, hm115, hm116, hm77, hEnc, hdim]
  let sB := runBlock fieldMulCode E sA
  have hB := fieldMulCode_spec b ι t N E sA y a hw hW hdet hA3 hA10 hA11
  have hB10 : sB.regs r10 = enc b (y * a) := by dsimp only [sB]; rw [hB]; simp
  let sC := runBlock (metaStoreCode r10 115) E sB
  have hCmem : sC.mem = Function.update s.mem 115 (enc b (y * a)) := by
    dsimp only [sC]
    rw [metaStore_spec E _ r10 115 (by decide)]
    change Function.update sB.mem (115 % 2 ^ E.W) (sB.regs r10) = _
    rw [hsmall 115 (by norm_num), hB10]
    rfl
  have he : runBlock powerMultiplyCode E s = sC := by simp only [powerMultiplyCode, runBlock_append]; rfl
  refine ⟨sC, he, ?_, hCmem⟩
  have hp := runBlock_pc powerMultiplyCode E s (by simp [powerMultiplyCode, fieldMulCode, metaReadCode, metaStoreCode])
  rw [he] at hp
  exact hp

theorem powerStep_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState)
    (B j : ℕ) (x y a : F) (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (116 : ℕ) < 2 ^ E.W) (hB : 128 ≤ B) (haddr : B + j < 2 ^ E.W)
    (hm86 : s.mem 86 = B) (hm113 : s.mem 113 = j) (hm115 : s.mem 115 = enc b y)
    (hm116 : s.mem 116 = enc b a) (hm77 : s.mem 77 = w) (hmV : s.mem (B + j) = enc b x) :
    ∃ z, runBlock powerStepCode E s = z ∧ z.pc = s.pc + 32 ∧
      z.mem = Function.update (Function.update s.mem (B + j) (enc b (x + y))) 115 (enc b (y * a)) := by
  obtain ⟨z1, hz1, hpc1, hmem1⟩ := powerAccumulate_spec b E s B j x y (by omega) (by omega) (by omega) (by omega)
    haddr hm86 hm113 hm115 hmV
  have hm115' : z1.mem 115 = enc b y := by rw [hmem1, Function.update_of_ne (by omega : 115 ≠ B + j)]; exact hm115
  have hm116' : z1.mem 116 = enc b a := by rw [hmem1, Function.update_of_ne (by omega : 116 ≠ B + j)]; exact hm116
  have hm77' : z1.mem 77 = w := by rw [hmem1, Function.update_of_ne (by omega : 77 ≠ B + j)]; exact hm77
  obtain ⟨z2, hz2, hpc2, hmem2⟩ := powerMultiply_spec b ι t N E z1 y a hw hW hdet hmeta hm115' hm116' hm77'
  refine ⟨z2, ?_, by rw [hpc2, hpc1] <;> omega, by rw [hmem2, hmem1]⟩
  rw [powerStepCode, runBlock_append, hz1, hz2]

theorem powerLoopBody_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc B len j n : ℕ) (v : ℕ → F) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc powerLoopBodyCode)
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (116 : ℕ) < 2 ^ E.W) (hB : 128 ≤ B) (hword : B + len ≤ 2 ^ E.W)
    (hj : j < len) (hn : n + 1 < 2 ^ E.W)
    (hstored : FieldArrayStored b m B len (powerPrefix v a j))
    (hm86 : m 86 = B) (hm113 : m 113 = j) (hm114 : m 114 = n + 1)
    (hm115 : m 115 = enc b (a ^ (j + 1))) (hm116 : m 116 = enc b a) (hm77 : m 77 = w) :
    Sem P E pc (pc + 83) (rankState pc m (n + 1))
      (fun k z => k ≤ 83 ∧ ∃ m', z = rankState (pc + 83) m' n ∧
        FieldArrayStored b m' B len (powerPrefix v a (j + 1)) ∧
        m' 86 = B ∧ m' 113 = j + 1 ∧ m' 114 = n ∧ m' 115 = enc b (a ^ (j + 2)) ∧
        m' 116 = enc b a ∧ m' 77 = w ∧ MemoryFrame (powerLoopWritable B len) m m') := by
  have hvalue : m (B + j) = enc b (v j) := by simpa [powerPrefix] using hstored j hj
  obtain ⟨z1, hz1, hpc1, hmem1⟩ := powerStep_spec b ι t N E (rankState pc m (n + 1)) B j (v j) (a ^ (j + 1)) a
    hw hW hdet hmeta hB (by omega) hm86 hm113 hm115 hm116 hm77 hvalue
  let mA := Function.update (Function.update m (B + j) (enc b (v j + a ^ (j + 1)))) 115 (enc b (a ^ (j + 1) * a))
  let m' := Function.update (Function.update mA 113 (j + 1)) 114 n
  have hmA114 : z1.mem 114 = n + 1 := by
    rw [hmem1]
    simpa [rankState, boundaryState, show 114 ≠ B + j by omega] using hm114
  have hmA113 : z1.mem 113 = j := by
    rw [hmem1]
    simpa [rankState, boundaryState, show 113 ≠ B + j by omega] using hm113
  have hrun : runBlock powerLoopBodyCode E (rankState pc m (n + 1)) = rankState (pc + 83) m' n := by
    rw [powerLoopBodyCode, runBlock_append, hz1, advanceCounter_spec E z1 113 114 j n
      (by omega) (by omega) (by decide) (by omega) hn hmA113 hmA114, hpc1, hmem1]
    rfl
  have hbody := Sem.block P E pc powerLoopBodyCode (rankState pc m (n + 1)) hAt
    (by simp [powerLoopBodyCode, powerStepCode, powerAccumulateCode, powerMultiplyCode, fieldMulCode,
      advanceCounterCode, incrementMetaCode, countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl
  have hstoreA : FieldArrayStored b mA B len (powerPrefix v a (j + 1)) :=
    (powerPrefix_succ_stored b m B len j v a hj hstored).meta_update hB 115 (enc b (a ^ (j + 1) * a)) (by norm_num)
  have hstore' : FieldArrayStored b m' B len (powerPrefix v a (j + 1)) :=
    (hstoreA.meta_update hB 113 (j + 1) (by norm_num)).meta_update hB 114 n (by norm_num)
  have hfixed (slot : ℕ) (hs : slot < 128) (hne113 : slot ≠ 113) (hne114 : slot ≠ 114) (hne115 : slot ≠ 115) :
      m' slot = m slot := by
    simp [m', mA, hne113, hne114, hne115, show slot ≠ B + j by omega]
  have hframe : MemoryFrame (powerLoopWritable B len) m m' :=
    MemoryFrame.trans
      (MemoryFrame.trans
        (MemoryFrame.trans (MemoryFrame.update_allowed _ m (B + j) _ (Or.inr (Or.inr (Or.inr ⟨by omega, by omega⟩))))
          (MemoryFrame.update_allowed _ _ 115 _ (Or.inr (Or.inr (Or.inl rfl)))))
        (MemoryFrame.update_allowed _ _ 113 _ (Or.inl rfl)))
      (MemoryFrame.update_allowed _ _ 114 _ (Or.inr (Or.inl rfl)))
  refine Sem.mono hbody ?_
  intro k z hQ
  obtain ⟨hk, hz⟩ := hQ
  change k = 83 at hk
  refine ⟨by omega, m', hz.trans hrun, hstore', ?_, by simp [m'], by simp [m'], ?_, ?_, ?_, hframe⟩
  · exact (hfixed 86 (by norm_num) (by norm_num) (by norm_num) (by norm_num)).trans hm86
  · simp [m', mA, pow_succ]
  · exact (hfixed 116 (by norm_num) (by norm_num) (by norm_num) (by norm_num)).trans hm116
  · exact (hfixed 77 (by norm_num) (by norm_num) (by norm_num) (by norm_num)).trans hm77

theorem powerLoop_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc B len : ℕ) (v : ℕ → F) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile powerLoopStmt pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (116 : ℕ) < 2 ^ E.W) (hB : 128 ≤ B) (hword : B + len ≤ 2 ^ E.W)
    (hstored : FieldArrayStored b m B len v)
    (hm86 : m 86 = B) (hm113 : m 113 = 0) (hm114 : m 114 = len)
    (hm115 : m 115 = enc b a) (hm116 : m 116 = enc b a) (hm77 : m 77 = w) :
    Sem P E pc (pc + 85) (rankState pc m len)
      (fun k z => k ≤ 85 * len + 1 ∧ z.regs = (fun _ => 0) ∧
        FieldArrayStored b z.mem B len (fun j => v j + a ^ (j + 1)) ∧
        z.mem 86 = B ∧ z.mem 113 = len ∧ z.mem 114 = 0 ∧ z.mem 115 = enc b (a ^ (len + 1)) ∧
        z.mem 116 = enc b a ∧ z.mem 77 = w ∧ MemoryFrame (powerLoopWritable B len) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ len ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    z.mem 86 = B ∧ z.mem 113 = len - n ∧ z.mem 114 = n ∧ z.mem 115 = enc b (a ^ (len - n + 1)) ∧
    z.mem 116 = enc b a ∧ z.mem 77 = w ∧ FieldArrayStored b z.mem B len (powerPrefix v a (len - n)) ∧
    MemoryFrame (powerLoopWritable B len) m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by intro n z pc' h; simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by intro n z h; rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 } (fun k z' => k ≤ 84 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, h86, h113, h114, h115, h116, h77, hstoredz, hf⟩ := hI
    have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (n + 1) := by
      apply ramState_eq_of
      · rfl
      · rfl
      · intro r; exact congrFun hregs r
    rw [hz]
    have hrun := powerLoopBody_spec b ι t N P E (pc + 1) B len (len - (n + 1)) n v a z.mem hBodyAt
      hw hW hdet hmeta hB hword (by omega) (by omega) hstoredz h86 h113 h114 h115 h116 h77
    refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
    intro k z' hQ
    obtain ⟨hk, m', hz', hs', h86', h113', h114', h115', h116', h77', hf'⟩ := hQ
    have hidx : len - (n + 1) + 1 = len - n := by omega
    have hexp : len - (n + 1) + 2 = len - n + 1 := by omega
    refine ⟨by omega, by omega, ?_⟩
    rw [hz']
    refine ⟨rfl, h86', ?_, h114', ?_, h116', h77', ?_, MemoryFrame.trans hf hf'⟩
    · simpa only [hidx, rankState, boundaryState] using h113'
    · simpa only [hexp, rankState, boundaryState] using h115'
    · simpa only [hidx, rankState, boundaryState] using hs'
  have hinit : I len (rankState pc m len) := by
    refine ⟨le_rfl, rfl, hm86, ?_, hm114, ?_, hm116, hm77, ?_, ?_⟩
    · simpa only [Nat.sub_self, rankState, boundaryState] using hm113
    · simpa only [Nat.sub_self, zero_add, pow_one, rankState, boundaryState] using hm115
    · simpa only [Nat.sub_self, powerPrefix_zero, rankState, boundaryState] using hstored
    · intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc (.code powerLoopBodyCode) hAt (by omega) I 84 hframe hcounter hbody
    len (rankState pc m len) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, h86, h113, h114, h115, h116, h77, hstore, hf⟩ := hQ
  refine ⟨hk, ?_, ?_, h86, ?_, h114, ?_, h116, h77, hf⟩
  · rw [hregs]
    funext r
    simp [Function.update_apply]
  · apply hstore.congr_values
    intro j hj
    exact powerPrefix_complete v a (len - 0) j (by omega)
  · simpa only [Nat.sub_zero] using h113
  · simpa only [Nat.sub_zero] using h115

theorem powerProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc B len : ℕ) (v : ℕ → F) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile powerProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (116 : ℕ) < 2 ^ E.W) (hB : 128 ≤ B) (hword : B + len ≤ 2 ^ E.W)
    (hstored : FieldArrayStored b m B len v)
    (hm86 : m 86 = B) (hm113 : m 113 = 0) (hm114 : m 114 = len)
    (hm115 : m 115 = enc b a) (hm116 : m 116 = enc b a) (hm77 : m 77 = w) :
    Sem P E pc (pc + 88) (boundaryState pc m)
      (fun k z => k ≤ 85 * len + 4 ∧ ∃ m', z = boundaryState (pc + 88) m' ∧
        FieldArrayStored b m' B len (fun j => v j + a ^ (j + 1)) ∧ m' 86 = B ∧ m' 113 = len ∧
        m' 114 = 0 ∧ m' 115 = enc b (a ^ (len + 1)) ∧ m' 116 = enc b a ∧ m' 77 = w ∧
        MemoryFrame (powerLoopWritable B len) m m') := by
  have hn : len < 2 ^ E.W := by omega
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m len) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 114) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 3 := hQ.1
    exact ⟨by omega, hQ.2.trans (rankReadSlot_spec E pc m 114 len (by omega) hn hm114)⟩
  have hLoop := powerLoop_spec b ι t N P E (pc + 3) B len v a m hLoopAt hw hW hdet hmeta hB hword
    hstored hm86 hm113 hm114 hm115 hm116 hm77
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, hs, h86, h113, h114, h115, h116, h77, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, hs, h86, h113, h114, h115, h116, h77, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r; exact congrFun hregs r

theorem candidateRead_spec (E : RAMEnv) (s : RAMState) (B j idx : ℕ)
    (hmeta : (117 : ℕ) < 2 ^ E.W) (hB : B < 2 ^ E.W) (hj : j < 2 ^ E.W)
    (haddr : B + j < 2 ^ E.W) (hidx : idx < 2 ^ E.W)
    (hm85 : s.mem 85 = B) (hm117 : s.mem 117 = j) (hm : s.mem (B + j) = idx) :
    ∃ z, runBlock candidateReadCode E s = z ∧ z.pc = s.pc + 8 ∧ z.mem = s.mem ∧ z.regs r10 = idx := by
  have hsmall (i : ℕ) (hi : i ≤ 117) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  let z := runBlock candidateReadCode E s
  refine ⟨z, rfl, ?_, rfl, ?_⟩
  · exact runBlock_pc candidateReadCode E s (by simp [candidateReadCode, metaReadCode])
  · simp [z, candidateReadCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm85, hm117, Nat.mod_eq_of_lt hB, Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt haddr, hm, Nat.mod_eq_of_lt hidx]

theorem powerPrepare_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState)
    (B j idx len : ℕ) (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hB : B < 2 ^ E.W) (hj : j < 2 ^ E.W)
    (haddr : B + j < 2 ^ E.W) (hidx : idx < 2 ^ w) (hlen : len < 2 ^ E.W)
    (hm85 : s.mem 85 = B) (hm117 : s.mem 117 = j) (hm : s.mem (B + j) = idx) (hm121 : s.mem 121 = len) :
    runBlock powerPrepareCode E s = boundaryState (s.pc + 60) (powerPrepareMemory b s.mem (ι idx) len) := by
  have hwe : w ≤ E.W := by omega
  have hidxWord : idx < 2 ^ E.W := lt_of_lt_of_le hidx (Nat.pow_le_pow_right (by norm_num) hwe)
  obtain ⟨z1, hz1, hpc1, hmem1, h10⟩ := candidateRead_spec E s B j idx (by omega) hB hj haddr hidxWord hm85 hm117 hm
  let z2 := runBlock fieldImageCode E z1
  have hImage := fieldImage_spec b ι t N E z1 idx hw hW hdet hidx h10
  have h210 : z2.regs r10 = enc b (ι idx) := by dsimp only [z2]; rw [hImage]; simp
  have h2mem : z2.mem = s.mem := by dsimp only [z2]; rw [hImage]; exact hmem1
  let z3 := runBlock (metaStoreCode r10 115 ++ metaStoreCode r10 116) E z2
  have h3mem : z3.mem = Function.update (Function.update s.mem 115 (enc b (ι idx))) 116 (enc b (ι idx)) := by
    simp [z3, runBlock_append, metaStore_spec, h210, h2mem, Nat.mod_eq_of_lt (show 115 < 2 ^ E.W by omega),
      Nat.mod_eq_of_lt (show 116 < 2 ^ E.W by omega)]
  generalize hz4 : runBlock (setMetaCode 113 0) E z3 = z4
  have h4 : z4 = boundaryState (z3.pc + 20) (Function.update z3.mem 113 0) :=
    hz4.symm.trans (setMeta_spec E z3 113 0 (by omega) (by omega))
  have h4121 : z4.mem 121 = len := by rw [h4]; simpa [boundaryState, h3mem] using hm121
  have he : runBlock powerPrepareCode E s = runBlock (copyMetaCode 121 114) E z4 := by
    simp only [powerPrepareCode, runBlock_append]
    rw [hz1]
    change runBlock (copyMetaCode 121 114) E (runBlock (setMetaCode 113 0) E z3) = _
    rw [hz4]
  have hpc4 : z4.pc + 22 = s.pc + 60 := by
    have hp := runBlock_pc powerPrepareCode E s (by
      simp [powerPrepareCode, candidateReadCode, fieldImageCode, metaReadCode, metaStoreCode, setMetaCode, copyMetaCode, zeroRegsCode])
    rw [he, copyMeta_spec E z4 121 114 len hmeta (by omega) hlen h4121] at hp
    exact hp
  rw [he, copyMeta_spec E z4 121 114 len hmeta (by omega) hlen h4121, hpc4]
  have h4mem : z4.mem = Function.update (Function.update (Function.update s.mem 115 (enc b (ι idx))) 116 (enc b (ι idx))) 113 0 := by
    rw [h4]
    change Function.update z3.mem 113 0 = _
    rw [h3mem]
  rw [h4mem]
  rfl

theorem powerPrepare_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (a : F) (len : ℕ) :
    MemoryFrame (fun addr => addr = 113 ∨ addr = 114 ∨ addr = 115 ∨ addr = 116) m (powerPrepareMemory b m a len) := by
  intro addr ha
  dsimp [powerPrepareMemory]
  simp only [Function.update_of_ne (show addr ≠ 114 by omega), Function.update_of_ne (show addr ≠ 113 by omega),
    Function.update_of_ne (show addr ≠ 116 by omega), Function.update_of_ne (show addr ≠ 115 by omega)]

theorem power_outer_meta_readonly (V len slot : ℕ) (hV : 128 ≤ V) (hs : slot < 128) (hn : ¬ powerOuterMeta slot) :
    ¬ powerOuterWritable V len slot := by
  intro h
  rcases h with h | h
  · exact hn h
  · omega

theorem power_prepare_le_outer (V len addr : ℕ) (ha : addr = 113 ∨ addr = 114 ∨ addr = 115 ∨ addr = 116) :
    powerOuterWritable V len addr := by
  left
  dsimp [powerOuterMeta]
  omega

theorem power_loop_le_outer (V len addr : ℕ) (ha : powerLoopWritable V len addr) :
    powerOuterWritable V len addr := by
  dsimp [powerLoopWritable] at ha
  dsimp [powerOuterWritable, powerOuterMeta]
  omega

theorem OutputStored.of_power_frame {m m' : ℕ → ℕ} {BP V len T : ℕ} {xs : List ℕ}
    (h : OutputStored m BP xs) (hBP : 128 ≤ BP) (hlen : xs.length ≤ T)
    (hdisj : BP + T ≤ V ∨ V + len ≤ BP) (hf : MemoryFrame (powerOuterWritable V len) m m') : OutputStored m' BP xs := by
  apply h.of_frame hf
  intro j hj
  dsimp [powerOuterWritable, powerOuterMeta]
  omega

theorem powerOuterBody_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc BP V len T : ℕ) (xs done pending : List ℕ) (i : ℕ) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile powerOuterBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ w)
    (hBP : 128 ≤ BP) (hBPword : BP + T ≤ 2 ^ E.W) (hV : 128 ≤ V) (hVword : V + len ≤ 2 ^ E.W)
    (hdisj : BP + T ≤ V ∨ V + len ≤ BP) (hcount : xs.length ≤ T) (hrange : ∀ i ∈ xs, i < N)
    (heq : xs = done ++ (i :: pending)) (hv : PowerOuterView b ι BP V len xs done (i :: pending) m) :
    Sem P E pc (pc + 199) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ 85 * len + 115 ∧ ∃ m', z = rankState (pc + 199) m' pending.length ∧
        PowerOuterView b ι BP V len xs (done ++ [i]) pending m' ∧ MemoryFrame (powerOuterWritable V len) m m') := by
  have hlenEq : xs.length = done.length + (pending.length + 1) := by simp [heq]
  have hiMem : i ∈ xs := by rw [heq]; simp
  have hi := hrange i hiMem
  have hidx : i < 2 ^ w := lt_trans hi hN
  have hnWord : pending.length + 1 < 2 ^ E.W := by omega
  have hjWord : done.length + 1 < 2 ^ E.W := by omega
  have hlenWord : len < 2 ^ E.W := by omega
  have hpos : m (BP + done.length) = i := by
    have hj : done.length < xs.length := by omega
    have hh := hv.positions done.length hj
    rw [heq, List.getD_append_right done (i :: pending) 0 done.length le_rfl, Nat.sub_self] at hh
    exact hh
  let m1 := powerPrepareMemory b m (ι i) len
  have hf01 : MemoryFrame (powerOuterWritable V len) m m1 :=
    (powerPrepare_frame b m (ι i) len).mono (power_prepare_le_outer V len)
  have hstore1 : FieldArrayStored b m1 V len (listPowerSums ι done) :=
    (((hv.powers.meta_update hV 115 (enc b (ι i)) (by norm_num)).meta_update hV 116 (enc b (ι i)) (by norm_num)).meta_update
      hV 113 0 (by norm_num)).meta_update hV 114 len (by norm_num)
  have hm1meta (slot : ℕ) (hne115 : slot ≠ 115) (hne116 : slot ≠ 116) (hne113 : slot ≠ 113) (hne114 : slot ≠ 114) :
      m1 slot = m slot := by simp [m1, powerPrepareMemory, hne115, hne116, hne113, hne114]
  obtain ⟨hPrepareAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hPowerAt, hTailAt⟩ := At.seqStmt hRestAt
  have hPrepare : Sem P E pc (pc + 60) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ 60 ∧ z = boundaryState (pc + 60) m1) := by
    refine Sem.mono (Sem.block P E pc powerPrepareCode _ hPrepareAt
      (by simp [powerPrepareCode, candidateReadCode, fieldImageCode, metaReadCode, metaStoreCode, setMetaCode, copyMetaCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 60 := hQ.1
    exact ⟨by omega, hQ.2.trans (powerPrepare_spec b ι t N E _ BP done.length i len hw hW hdet hmeta (by omega) (by omega)
      (by omega) hidx hlenWord hv.positionsBase hv.index hpos hv.length)⟩
  have hPower := powerProcedure_spec b ι t N P E (pc + 60) V len (listPowerSums ι done) (ι i) m1 hPowerAt
    hw hW hdet (by omega) hV hVword hstore1
    ((hm1meta 86 (by norm_num) (by norm_num) (by norm_num) (by norm_num)).trans hv.powersBase)
    (by simp [m1, powerPrepareMemory]) (by simp [m1, powerPrepareMemory])
    (by simp [m1, powerPrepareMemory]) (by simp [m1, powerPrepareMemory])
    ((hm1meta 77 (by norm_num) (by norm_num) (by norm_num) (by norm_num)).trans hv.dimension)
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, m2, hz2, hstore2, h86, h113, h114, h115, h116, h77, hf12raw⟩ := hPower
  have hf12 : MemoryFrame (powerOuterWritable V len) m1 m2 := hf12raw.mono (power_loop_le_outer V len)
  have hf02 := MemoryFrame.trans hf01 hf12
  have h117 : m2 117 = done.length := by
    rw [hf12raw 117 (by dsimp [powerLoopWritable]; omega), hm1meta 117 (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
    exact hv.index
  have h118 : m2 118 = pending.length + 1 := by
    rw [hf12raw 118 (by dsimp [powerLoopWritable]; omega), hm1meta 118 (by norm_num) (by norm_num) (by norm_num) (by norm_num)]
    exact hv.remaining
  let m3 := Function.update (Function.update m2 117 (done.length + 1)) 118 pending.length
  have hf23 : MemoryFrame (powerOuterWritable V len) m2 m3 :=
    MemoryFrame.trans (MemoryFrame.update_allowed _ m2 117 (done.length + 1) (by left; dsimp [powerOuterMeta]; omega))
      (MemoryFrame.update_allowed _ _ 118 pending.length (by left; dsimp [powerOuterMeta]; omega))
  have hf03 := MemoryFrame.trans hf02 hf23
  have hfixed (slot : ℕ) (hs : slot < 128) (hn : ¬ powerOuterMeta slot) : m3 slot = m slot :=
    hf03 slot (power_outer_meta_readonly V len slot hV hs hn)
  have hs3 : FieldArrayStored b m3 V len (listPowerSums ι (done ++ [i])) := by
    apply ((hstore2.meta_update hV 117 (done.length + 1) (by norm_num)).meta_update hV 118 pending.length (by norm_num)).congr_values
    intro j _
    exact (listPowerSums_append_one ι done i j).symm
  have hv3 : PowerOuterView b ι BP V len xs (done ++ [i]) pending m3 := by
    refine ⟨hv.positions.of_power_frame hBP hcount hdisj hf03, hs3, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact (hfixed 85 (by norm_num) (by norm_num [powerOuterMeta])).trans hv.positionsBase
    · exact (hfixed 86 (by norm_num) (by norm_num [powerOuterMeta])).trans hv.powersBase
    · exact (hfixed 77 (by norm_num) (by norm_num [powerOuterMeta])).trans hv.dimension
    · exact (hfixed 121 (by norm_num) (by norm_num [powerOuterMeta])).trans hv.length
    · exact (hfixed 101 (by norm_num) (by norm_num [powerOuterMeta])).trans hv.count
    · simp [m3]
    · simp [m3]
  have hPowerExact : Sem P E (pc + 60) (pc + 148) (boundaryState (pc + 60) m1)
      (fun k z => k ≤ 85 * len + 4 ∧ z = boundaryState (pc + 148) m2) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hTail : Sem P E (pc + 148) (pc + 199) (boundaryState (pc + 148) m2)
      (fun k z => k ≤ 51 ∧ z = rankState (pc + 199) m3 pending.length) := by
    refine Sem.mono (Sem.block P E _ (advanceCounterCode 117 118) _ hTailAt
      (by simp [advanceCounterCode, incrementMetaCode, countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 51 := hQ.1
    exact ⟨by omega, hQ.2.trans (advanceCounter_spec E _ 117 118 done.length pending.length
      (by omega) (by omega) (by decide) hjWord hnWord h117 h118)⟩
  have hFull := Sem.seq_bound hPrepare (fun z _ hz => by
    subst z
    exact Sem.seq_bound hPowerExact (fun z _ hz => by subst z; exact hTail))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, m3, hQ.2, hv3, hf03⟩)

theorem powerOuterLoop_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc BP V len T : ℕ) (xs : List ℕ) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile powerOuterLoop pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ w)
    (hBP : 128 ≤ BP) (hBPword : BP + T ≤ 2 ^ E.W) (hV : 128 ≤ V) (hVword : V + len ≤ 2 ^ E.W)
    (hdisj : BP + T ≤ V ∨ V + len ≤ BP) (hcount : xs.length ≤ T) (hrange : ∀ i ∈ xs, i < N)
    (hv : PowerOuterView b ι BP V len xs [] xs m) :
    Sem P E pc (pc + 201) (rankState pc m xs.length)
      (fun k z => k ≤ (85 * len + 117) * xs.length + 1 ∧ z.regs = (fun _ => 0) ∧
        PowerOuterView b ι BP V len xs xs [] z.mem ∧ MemoryFrame (powerOuterWritable V len) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ xs.length ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    ∃ done pending, xs = done ++ pending ∧ pending.length = n ∧
      PowerOuterView b ι BP V len xs done pending z.mem ∧ MemoryFrame (powerOuterWritable V len) m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by intro n z pc' h; simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by intro n z h; rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 } (fun k z' => k ≤ 85 * len + 116 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, done, pending, heq, hrem, hvz, hf⟩ := hI
    cases pending with
    | nil => simp at hrem
    | cons i pending =>
      have heN : n = pending.length := by simp only [List.length_cons] at hrem; omega
      subst n
      have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (pending.length + 1) := by
        apply ramState_eq_of
        · rfl
        · rfl
        · intro r; exact congrFun hregs r
      rw [hz]
      have hrun := powerOuterBody_spec b ι t N P E (pc + 1) BP V len T xs done pending i z.mem hBodyAt
        hw hW hdet hmeta hN hBP hBPword hV hVword hdisj hcount hrange heq hvz
      refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
      intro k z' hQ
      obtain ⟨hk, m', hz', hv', hf'⟩ := hQ
      refine ⟨by omega, by omega, ?_⟩
      rw [hz']
      refine ⟨rfl, done ++ [i], pending, ?_, rfl, hv', MemoryFrame.trans hf hf'⟩
      simpa only [List.append_assoc, List.singleton_append] using heq
  have hinit : I xs.length (rankState pc m xs.length) := by
    refine ⟨le_rfl, rfl, [], xs, by simp, rfl, hv, ?_⟩
    intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc powerOuterBody hAt (by omega) I (85 * len + 116)
    hframe hcounter hbody xs.length (rankState pc m xs.length) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, done, pending, heq, hrem, hvz, hf⟩ := hQ
  have hp : pending = [] := by
    cases pending with
    | nil => rfl
    | cons i pending => simp at hrem
  subst pending
  have hd : done = xs := by simpa using heq.symm
  subst done
  refine ⟨hk, ?_, hvz, hf⟩
  rw [hregs]
  funext r
  simp [Function.update_apply]

theorem powerOuterProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc BP V len T : ℕ) (xs : List ℕ) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile powerOuterProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ w)
    (hBP : 128 ≤ BP) (hBPword : BP + T ≤ 2 ^ E.W) (hV : 128 ≤ V) (hVword : V + len ≤ 2 ^ E.W)
    (hdisj : BP + T ≤ V ∨ V + len ≤ BP) (hcount : xs.length ≤ T) (hrange : ∀ i ∈ xs, i < N)
    (hv : PowerOuterView b ι BP V len xs [] xs m) :
    Sem P E pc (pc + 204) (boundaryState pc m)
      (fun k z => k ≤ (85 * len + 117) * xs.length + 4 ∧ ∃ m', z = boundaryState (pc + 204) m' ∧
        PowerOuterView b ι BP V len xs xs [] m' ∧ MemoryFrame (powerOuterWritable V len) m m') := by
  have hn : xs.length < 2 ^ E.W := by omega
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m xs.length) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 118) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 3 := hQ.1
    exact ⟨by omega, hQ.2.trans (rankReadSlot_spec E pc m 118 xs.length (by omega) hn hv.remaining)⟩
  have hLoop := powerOuterLoop_spec b ι t N P E (pc + 3) BP V len T xs m hLoopAt
    hw hW hdet hmeta hN hBP hBPword hV hVword hdisj hcount hrange hv
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, hvz, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, hvz, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r; exact congrFun hregs r

theorem equalBit_le_one {α : Type} [DecidableEq α] (x y : α) : equalBit x y ≤ 1 := by
  by_cases h : x = y <;> simp [equalBit, h]

theorem equalBit_eq_one {α : Type} [DecidableEq α] (x y : α) : equalBit x y = 1 ↔ x = y := by
  by_cases h : x = y <;> simp [equalBit, h]

theorem equalBit_enc {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (x y : F) : equalBit (enc b x) (enc b y) = equalBit x y := by
  have hh : enc b x = enc b y ↔ x = y := (enc_injective b).eq_iff
  simp [equalBit, hh]

theorem equalPrefix_le_one {α : Type} [DecidableEq α] (u v : ℕ → α) (k : ℕ) : equalPrefix u v k ≤ 1 := by
  induction k with
  | zero => simp [equalPrefix]
  | succ k ih => exact le_trans (Nat.mul_le_mul ih (equalBit_le_one _ _)) (by norm_num)

theorem equalPrefix_eq_one {α : Type} [DecidableEq α] (u v : ℕ → α) (k : ℕ) :
    equalPrefix u v k = 1 ↔ ∀ j < k, u j = v j := by
  induction k with
  | zero => simp [equalPrefix]
  | succ k ih =>
      rw [equalPrefix, bit_mul_eq_one _ _ (equalPrefix_le_one u v k) (equalBit_le_one _ _), ih, equalBit_eq_one]
      constructor
      · rintro ⟨hp, hk⟩ j hj
        by_cases he : j = k
        · simpa [he] using hk
        · exact hp j (by omega)
      · intro hp
        exact ⟨fun j hj => hp j (by omega), hp k (by omega)⟩

theorem compareFlag_succ {α : Type} [DecidableEq α] (u v : ℕ → α) (flag k : ℕ) :
    (flag * equalPrefix u v k) * equalBit (u k) (v k) = flag * equalPrefix u v (k + 1) := by
  simp [equalPrefix, Nat.mul_assoc]

theorem compareFlag_accept {α : Type} [DecidableEq α] (u v : ℕ → α) (flag len : ℕ) (hf : flag ≤ 1) :
    flag * equalPrefix u v len = 1 ↔ flag = 1 ∧ ∀ j < len, u j = v j := by
  rw [bit_mul_eq_one _ _ hf (equalPrefix_le_one u v len), equalPrefix_eq_one]

theorem equalityTest_spec (E : RAMEnv) (s : RAMState) (x y : ℕ)
    (hword : 2 < 2 ^ E.W) (hx : s.regs r10 = x) (hy : s.regs r11 = y) :
    ∃ z, runBlock equalityTestCode E s = z ∧ z.pc = s.pc + 5 ∧ z.mem = s.mem ∧ z.regs r0 = equalBit x y := by
  let z := runBlock equalityTestCode E s
  refine ⟨z, rfl, runBlock_pc equalityTestCode E s (by simp [equalityTestCode]), rfl, ?_⟩
  have h1 : (1 : ℕ) % 2 ^ E.W = 1 := Nat.mod_eq_of_lt (by omega)
  rcases lt_trichotomy x y with h | h | h
  · have hnot : ¬ y < x := by omega
    have hne : x ≠ y := by omega
    simp [z, equalityTestCode, runBlock_cons, runBlock_nil, execInstr, hx, hy, h, hnot, hne, equalBit, h1]
  · have hy' : s.regs r11 = x := hy.trans h.symm
    simp [z, equalityTestCode, runBlock_cons, runBlock_nil, execInstr, hx, hy', equalBit, h, h1, Nat.add_mod_right]
  · have hnot : ¬ x < y := by omega
    have hne : x ≠ y := by omega
    simp [z, equalityTestCode, runBlock_cons, runBlock_nil, execInstr, hx, hy, h, hnot, hne, equalBit, h1]

theorem matchFlag_spec (E : RAMEnv) (s : RAMState) (x y flag : ℕ)
    (hmeta : (100 : ℕ) < 2 ^ E.W) (hf : flag ≤ 1)
    (hx : s.regs r10 = x) (hy : s.regs r11 = y) (hm100 : s.mem 100 = flag) :
    ∃ z, runBlock matchFlagCode E s = z ∧ z.pc = s.pc + 12 ∧
      z.mem = Function.update s.mem 100 (flag * equalBit x y) := by
  obtain ⟨z1, hz1, hpc1, hmem1, hbit⟩ := equalityTest_spec E s x y (by omega) hx hy
  have h100 : (100 : ℕ) % 2 ^ E.W = 100 := Nat.mod_eq_of_lt hmeta
  have hfmod : flag % 2 ^ E.W = flag := Nat.mod_eq_of_lt (by omega)
  have hb := equalBit_le_one x y
  have hm : flag * equalBit x y ≤ 1 := le_trans (Nat.mul_le_mul hf hb) (by norm_num)
  have hmod : (flag * equalBit x y) % 2 ^ E.W = flag * equalBit x y := Nat.mod_eq_of_lt (by omega)
  let z2 := runBlock (metaReadCode r1 100 ++ [iMul r1 r1 r0]) E z1
  have h21 : z2.regs r1 = flag * equalBit x y := by
    simp [z2, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hmem1, h100, hm100, hfmod, hbit, hmod]
  let z3 := runBlock (metaStoreCode r1 100) E z2
  have h3mem : z3.mem = Function.update s.mem 100 (flag * equalBit x y) := by
    dsimp only [z3]
    rw [metaStore_spec E _ r1 100 (by decide)]
    change Function.update z2.mem (100 % 2 ^ E.W) (z2.regs r1) = _
    rw [h100, h21]
    change Function.update z1.mem 100 _ = _
    rw [hmem1]
  have he : runBlock matchFlagCode E s = z3 := by
    simp only [matchFlagCode, runBlock_append]
    rw [hz1] <;> rfl
  refine ⟨z3, he, ?_, h3mem⟩
  have hp := runBlock_pc matchFlagCode E s (by simp [matchFlagCode, equalityTestCode, metaReadCode, metaStoreCode])
  rw [he] at hp
  exact hp

theorem comparisonRead_spec (E : RAMEnv) (s : RAMState) (EB V j x y : ℕ)
    (hmeta : (119 : ℕ) < 2 ^ E.W) (hEB : EB < 2 ^ E.W) (hV : V < 2 ^ E.W) (hj : j < 2 ^ E.W)
    (hEaddr : EB + j < 2 ^ E.W) (hVaddr : V + j < 2 ^ E.W) (hx : x < 2 ^ E.W) (hy : y < 2 ^ E.W)
    (hm79 : s.mem 79 = EB) (hm86 : s.mem 86 = V) (hm119 : s.mem 119 = j)
    (hmE : s.mem (EB + j) = x) (hmV : s.mem (V + j) = y) :
    ∃ z, runBlock comparisonReadCode E s = z ∧ z.pc = s.pc + 13 ∧ z.mem = s.mem ∧ z.regs r10 = x ∧ z.regs r11 = y := by
  have hsmall (i : ℕ) (hi : i ≤ 119) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  let z1 := runBlock (metaReadCode r2 79 ++ metaReadCode r0 119 ++ [iAdd r2 r2 r0, iLd r10 r2]) E s
  have h10 : z1.regs r10 = x := by
    simp [z1, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm79, hm119, Nat.mod_eq_of_lt hEB, Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt hEaddr, hmE, Nat.mod_eq_of_lt hx]
  have h0 : z1.regs r0 = j := by
    simp [z1, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm79, hm119, Nat.mod_eq_of_lt hj]
  have hm1 : z1.mem = s.mem := rfl
  let z2 := runBlock (metaReadCode r2 86 ++ [iAdd r2 r2 r0, iLd r11 r2]) E z1
  have h210 : z2.regs r10 = x := by
    simp [z2, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr, h10]
  have h211 : z2.regs r11 = y := by
    simp [z2, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm1, hm86, Nat.mod_eq_of_lt hV, h0, Nat.mod_eq_of_lt hVaddr, hmV, Nat.mod_eq_of_lt hy]
  have he : runBlock comparisonReadCode E s = z2 := by simp only [comparisonReadCode, runBlock_append]; rfl
  refine ⟨z2, he, ?_, rfl, h210, h211⟩
  have hp := runBlock_pc comparisonReadCode E s (by simp [comparisonReadCode, metaReadCode])
  rw [he] at hp
  exact hp

theorem comparisonStep_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (EB V j flag : ℕ) (x y : F)
    (hmeta : (119 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hEB : EB < 2 ^ E.W) (hV : V < 2 ^ E.W) (hj : j < 2 ^ E.W)
    (hEaddr : EB + j < 2 ^ E.W) (hVaddr : V + j < 2 ^ E.W) (hflag : flag ≤ 1)
    (hm79 : s.mem 79 = EB) (hm86 : s.mem 86 = V) (hm119 : s.mem 119 = j)
    (hmE : s.mem (EB + j) = enc b x) (hmV : s.mem (V + j) = enc b y) (hm100 : s.mem 100 = flag) :
    ∃ z, runBlock comparisonStepCode E s = z ∧ z.pc = s.pc + 25 ∧
      z.mem = Function.update s.mem 100 (flag * equalBit x y) := by
  have hEnc (v : F) : enc b v < 2 ^ E.W := lt_of_lt_of_le (enc_lt b v) (Nat.pow_le_pow_right (by norm_num) hwe)
  obtain ⟨z1, hz1, hpc1, hmem1, h10, h11⟩ := comparisonRead_spec E s EB V j (enc b x) (enc b y) hmeta hEB hV hj
    hEaddr hVaddr (hEnc x) (hEnc y) hm79 hm86 hm119 hmE hmV
  obtain ⟨z2, hz2, hpc2, hmem2⟩ := matchFlag_spec E z1 (enc b x) (enc b y) flag (by omega) hflag h10 h11 (by rw [hmem1]; exact hm100)
  refine ⟨z2, ?_, by rw [hpc2, hpc1] <;> omega, ?_⟩
  · rw [comparisonStepCode, runBlock_append, hz1, hz2]
  · rw [hmem2, hmem1, equalBit_enc]

theorem comparisonLoopBody_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc EB V len flag j n : ℕ) (e v : ℕ → F) (m : ℕ → ℕ)
    (hAt : At P pc comparisonLoopBodyCode) (hmeta : (120 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hEB : 128 ≤ EB) (hV : 128 ≤ V) (hEword : EB + len ≤ 2 ^ E.W) (hVword : V + len ≤ 2 ^ E.W)
    (hj : j < len) (hn : n + 1 < 2 ^ E.W) (hflag : flag ≤ 1)
    (hv : ComparisonView b EB V len e v flag j (n + 1) m) :
    Sem P E pc (pc + 76) (rankState pc m (n + 1))
      (fun k z => k ≤ 76 ∧ ∃ m', z = rankState (pc + 76) m' n ∧
        ComparisonView b EB V len e v flag (j + 1) n m' ∧ MemoryFrame comparisonWritable m m') := by
  have hprod : flag * equalPrefix e v j ≤ 1 := le_trans (Nat.mul_le_mul hflag (equalPrefix_le_one e v j)) (by norm_num)
  obtain ⟨z1, hz1, hpc1, hmem1⟩ := comparisonStep_spec b E (rankState pc m (n + 1)) EB V j (flag * equalPrefix e v j)
    (e j) (v j) (by omega) hwe (by omega) (by omega) (by omega) (by omega) (by omega) hprod
    hv.expectedBase hv.actualBase hv.index (hv.expected j hj) (hv.actual j hj) hv.flag
  let m1 := Function.update m 100 ((flag * equalPrefix e v j) * equalBit (e j) (v j))
  let m' := Function.update (Function.update m1 119 (j + 1)) 120 n
  have h119 : z1.mem 119 = j := by rw [hmem1]; simpa [rankState, boundaryState] using hv.index
  have h120 : z1.mem 120 = n + 1 := by rw [hmem1]; simpa [rankState, boundaryState] using hv.remaining
  have hrun : runBlock comparisonLoopBodyCode E (rankState pc m (n + 1)) = rankState (pc + 76) m' n := by
    rw [comparisonLoopBodyCode, runBlock_append, hz1, advanceCounter_spec E z1 119 120 j n
      (by omega) hmeta (by decide) (by omega) hn h119 h120, hpc1, hmem1]
    rfl
  have hbody := Sem.block P E pc comparisonLoopBodyCode (rankState pc m (n + 1)) hAt
    (by simp [comparisonLoopBodyCode, comparisonStepCode, comparisonReadCode, matchFlagCode, equalityTestCode,
      advanceCounterCode, incrementMetaCode, countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl
  have hframe : MemoryFrame comparisonWritable m m' :=
    MemoryFrame.trans
      (MemoryFrame.trans (MemoryFrame.update_allowed _ m 100 _ (Or.inl rfl))
        (MemoryFrame.update_allowed _ _ 119 _ (Or.inr (Or.inl rfl))))
      (MemoryFrame.update_allowed _ _ 120 _ (Or.inr (Or.inr rfl)))
  have hv' : ComparisonView b EB V len e v flag (j + 1) n m' := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact ((hv.expected.meta_update hEB 100 _ (by norm_num)).meta_update hEB 119 (j + 1) (by norm_num)).meta_update hEB 120 n (by norm_num)
    · exact ((hv.actual.meta_update hV 100 _ (by norm_num)).meta_update hV 119 (j + 1) (by norm_num)).meta_update hV 120 n (by norm_num)
    · simpa [m', m1] using hv.expectedBase
    · simpa [m', m1] using hv.actualBase
    · simp [m']
    · simp [m']
    · simp [m', m1, compareFlag_succ]
  refine Sem.mono hbody ?_
  intro k z hQ
  obtain ⟨hk, hz⟩ := hQ
  change k = 76 at hk
  exact ⟨by omega, m', hz.trans hrun, hv', hframe⟩

theorem comparisonLoop_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv) (pc EB V len flag : ℕ) (e v : ℕ → F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile comparisonLoopStmt pc)) (hmeta : (120 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hEB : 128 ≤ EB) (hV : 128 ≤ V) (hEword : EB + len ≤ 2 ^ E.W) (hVword : V + len ≤ 2 ^ E.W)
    (hflag : flag ≤ 1) (hv : ComparisonView b EB V len e v flag 0 len m) :
    Sem P E pc (pc + 78) (rankState pc m len)
      (fun k z => k ≤ 78 * len + 1 ∧ z.regs = (fun _ => 0) ∧
        ComparisonView b EB V len e v flag len 0 z.mem ∧ MemoryFrame comparisonWritable m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ len ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    ComparisonView b EB V len e v flag (len - n) n z.mem ∧ MemoryFrame comparisonWritable m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by intro n z pc' h; simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by intro n z h; rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 } (fun k z' => k ≤ 77 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, hvz, hf⟩ := hI
    have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (n + 1) := by
      apply ramState_eq_of
      · rfl
      · rfl
      · intro r; exact congrFun hregs r
    rw [hz]
    have hrun := comparisonLoopBody_spec b P E (pc + 1) EB V len flag (len - (n + 1)) n e v z.mem hBodyAt
      hmeta hwe hEB hV hEword hVword (by omega) (by omega) hflag hvz
    refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
    intro k z' hQ
    obtain ⟨hk, m', hz', hv', hf'⟩ := hQ
    have hidx : len - (n + 1) + 1 = len - n := by omega
    refine ⟨by omega, by omega, ?_⟩
    rw [hz']
    refine ⟨rfl, ?_, MemoryFrame.trans hf hf'⟩
    simpa only [hidx, rankState, boundaryState] using hv'
  have hinit : I len (rankState pc m len) := by
    refine ⟨le_rfl, rfl, ?_, ?_⟩
    · simpa only [Nat.sub_self, rankState, boundaryState] using hv
    · intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc (.code comparisonLoopBodyCode) hAt (by omega) I 77
    hframe hcounter hbody len (rankState pc m len) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, hvz, hf⟩ := hQ
  refine ⟨hk, ?_, ?_, hf⟩
  · rw [hregs]
    funext r
    simp [Function.update_apply]
  · simpa only [Nat.sub_zero] using hvz

theorem comparisonProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv) (pc EB V len flag : ℕ) (e v : ℕ → F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile comparisonProcedure pc)) (hmeta : (120 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hEB : 128 ≤ EB) (hV : 128 ≤ V) (hEword : EB + len ≤ 2 ^ E.W) (hVword : V + len ≤ 2 ^ E.W)
    (hflag : flag ≤ 1) (hv : ComparisonView b EB V len e v flag 0 len m) :
    Sem P E pc (pc + 81) (boundaryState pc m)
      (fun k z => k ≤ 78 * len + 4 ∧ ∃ m', z = boundaryState (pc + 81) m' ∧
        ComparisonView b EB V len e v flag len 0 m' ∧ MemoryFrame comparisonWritable m m') := by
  have hn : len < 2 ^ E.W := by omega
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m len) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 120) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 3 := hQ.1
    exact ⟨by omega, hQ.2.trans (rankReadSlot_spec E pc m 120 len hmeta hn hv.remaining)⟩
  have hLoop := comparisonLoop_spec b P E (pc + 3) EB V len flag e v m hLoopAt hmeta hwe hEB hV hEword hVword hflag hv
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, hvz, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, hvz, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r; exact congrFun hregs r

theorem verifierClearArgs_spec (E : RAMEnv) (pc V len : ℕ) (m : ℕ → ℕ)
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hV : V < 2 ^ E.W) (hlen : len < 2 ^ E.W)
    (hm86 : m 86 = V) (hm121 : m 121 = len) :
    runBlock verifierClearArgsCode E (boundaryState pc m) = clearState (pc + 7) V len m (fun _ => 0) 0 := by
  have hsmall (i : ℕ) (hi : i ≤ 121) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  apply ramState_eq_of
  ·     simp only [verifierClearArgsCode, Fin.isValue, List.append_assoc, boundaryState, runBlock_append, ne_eq,
      Fin.reduceEq, not_false_eq_true, metaRead_spec, runBlock_cons, execInstr, runBlock_nil, clearState,
      ite_self, Nat.add_right_cancel_iff, Nat.add_left_cancel_iff]
  · rfl
  · intro r
    fin_cases r <;>                     simp only [verifierClearArgsCode, Fin.isValue, List.append_assoc, boundaryState,
                      runBlock_append, ne_eq, Fin.reduceEq, not_false_eq_true, metaRead_spec,
                      Nat.reduceLeDiff, hsmall, hm86, Nat.mod_eq_of_lt hV, Std.le_refl, hm121,
                      Nat.mod_eq_of_lt hlen, runBlock_cons, execInstr, Nat.one_le_ofNat, runBlock_nil,
                      Fin.zero_eta, Function.update_of_ne, zero_ne_one, clearState, ite_self, ↓reduceIte,
                      Fin.mk_one, Function.update_self, one_ne_zero, Fin.reduceFinMk]

theorem verifierClearProcedure_spec (P : Program) (E : RAMEnv) (pc V len : ℕ) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile verifierClearProcedure pc))
    (hmeta : (121 : ℕ) < 2 ^ E.W) (hV : 128 ≤ V) (hVfit : V < 2 ^ E.W) (hword : V + len ≤ 2 ^ E.W)
    (hm86 : m 86 = V) (hm121 : m 121 = len) :
    Sem P E pc (pc + 31) (boundaryState pc m)
      (fun k z => k ≤ 8 * len + 25 ∧ z = boundaryState (pc + 31) (clearMem V m len)) := by
  obtain ⟨hArgsAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hClearAt, hZeroAt⟩ := At.seqStmt hRestAt
  have hArgs : Sem P E pc (pc + 7) (boundaryState pc m)
      (fun k z => k ≤ 7 ∧ z = clearState (pc + 7) V len m (fun _ => 0) 0) := by
    refine Sem.mono (Sem.block P E pc verifierClearArgsCode _ hArgsAt (by simp [verifierClearArgsCode, metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 7 := hQ.1
    exact ⟨by omega, hQ.2.trans (verifierClearArgs_spec E pc V len m hmeta hVfit (by omega) hm86 hm121)⟩
  have hClear := clearArray_spec P E (pc + 7) V len m (fun _ => 0) hClearAt (by omega) (by omega) hword
  have hZero := Sem.zero_block P E (pc + 15) { clearState (pc + 7) V len m (fun _ => 0) len with pc := pc + 15 } hZeroAt rfl
  have hFull := Sem.seq_bound hArgs (fun z _ hz => by
    subst z
    exact Sem.seq_bound hClear (fun z _ hz => by subst z; exact hZero))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem FieldArrayStored.cleared {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (V len : ℕ) :
    FieldArrayStored b (clearMem V m len) V len (fun _ => 0) := by
