-- title:
--   The law $P_g^M(\cdot\mid x)$ of a chain of thought
-- statement:
--   The law on $\{0,1\}^M$ of the $M$ tokens generated by $g$ from the prompt $x$, with mass $P_g^M(z\mid x)$.
--
--   **Formalization Note** The module also holds the structural facts this needs: the first-token factorization of the trajectory mass, its nonnegativity, and that it sums to $1$.
-- source:
--   Doron-Arad–Mehalel–Mossel, Stochastic Autoregressive Learning, arXiv:2608.07224, §1.1, p.2; §2, p.7

import Mathlib
import Definitions.Def_StochAutoreg_trajMass

namespace StochAutoreg

/-- Peeling the first token off a trajectory: the state after token `b` is `x ++ [b]`. -/
theorem trajMass_cons (g : Generator) (M : ℕ) (x : List Bool) (b : Bool) (z : Fin M → Bool) :
    trajMass g (M + 1) x (Fin.cons b z) = bernMass (g x) b * trajMass g M (x ++ [b]) z := by
  unfold trajMass
  rw [Fin.prod_univ_succ]
  simp [List.ofFn_succ, Fin.cons_zero, Fin.cons_succ, List.take_succ_cons]

theorem bernMass_nonneg (p : unitInterval) (b : Bool) : 0 ≤ bernMass p b := by
  cases b
  · simpa [bernMass] using p.2.2
  · simpa [bernMass] using p.2.1

theorem trajMass_nonneg (g : Generator) (M : ℕ) (x : List Bool) (z : Fin M → Bool) :
    0 ≤ trajMass g M x z :=
  Finset.prod_nonneg fun _ _ => bernMass_nonneg _ _

theorem trajMass_sum (g : Generator) (M : ℕ) (x : List Bool) :
    ∑ z : Fin M → Bool, trajMass g M x z = 1 := by
  induction M generalizing x with
  | zero => simp [trajMass]
  | succ M ih =>
    rw [← (Fin.consEquiv (fun _ : Fin (M + 1) => Bool)).sum_comp, Fintype.sum_prod_type,
      Fintype.sum_bool]
    simp only [Fin.consEquiv, Equiv.coe_fn_mk, trajMass_cons, ← Finset.mul_sum, ih]
    simp [bernMass]

/-- The law `P_g^M(· | x)` of the `M` generated tokens from the prompt `x`, with mass `trajMass`.
Doron-Arad–Mehalel–Mossel, *Stochastic Autoregressive Learning*, arXiv:2608.07224, §1.1, p.2, and §2, p.7. -/
noncomputable def trajPMF (g : Generator) (M : ℕ) (x : List Bool) : PMF (Fin M → Bool) :=
  PMF.ofFintype (fun z => ENNReal.ofReal (trajMass g M x z)) (by
    rw [← ENNReal.ofReal_sum_of_nonneg fun z _ => trajMass_nonneg g M x z, trajMass_sum]
    simp)

end StochAutoreg


