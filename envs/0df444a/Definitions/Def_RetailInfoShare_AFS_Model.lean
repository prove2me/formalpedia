-- title:
--   §3, pp. 8–15 — Cournot sellers on a platform: Gaussian shock and signals, platform-designed noise matrix, Bayesian equilibrium, profits, AFS format
-- statement:
--   This file sets up the model of Liu, Zhang and Zhang for a retail platform that shares demand information with the sellers on it.
--
--   **Parameters.** There are $N \ge 1$ sellers, indexed $0, \dots, N-1$ (the paper's sellers $1, \dots, N$). The inverse demand has intercept $a \in \mathbb R$ and substitution parameter $b$ with $0 < b \le 1$. The common demand shock $u$ has prior variance $\sigma > 0$, each signal noise $e_i$ has variance $t > 0$, and the platform keeps a commission rate $\alpha$ with $0 < \alpha < 1$. These are bundled in the predicate *Standing*.
--
--   **Primitives.** On a probability space $(\Omega, \mathcal F, \mu)$ live mutually independent random variables
--   $$u \sim N(0,\sigma), \qquad e_i \sim N(0,t), \qquad \xi_{ij} \sim N(0,1) \quad (i,j = 1,\dots,N),$$
--   where the second argument of $N(\cdot,\cdot)$ is a variance. The platform observes the signal $x_i = u + e_i$ from its customer interaction with seller $i$.
--
--   **Sharing strategies.** A noise matrix $M = (m_{ij})$ has entries in $[0, +\infty]$. Seller $j$ receives, for every $i$ with $m_{ij} < +\infty$, the signal
--   $$\hat x_{ij} = x_i + \epsilon_{ij}, \qquad \epsilon_{ij} = \sqrt{m_{ij}}\,\xi_{ij} \sim N(0, m_{ij}),$$
--   and nothing about $x_i$ when $m_{ij} = +\infty$. Seller $j$'s information $y_j(M)$ is the $\sigma$-algebra generated by the delivered signals; it is trivial when nothing is delivered.
--
--   **Payoffs.** Given quantities $q = (q_1, \dots, q_N)$, the price of seller $i$ is (eq. (1))
--   $$p_i = a - q_i - b \sum_{d \ne i} q_d + u.$$
--   Seller $i$'s expected profit is $\pi_i = E[(1-\alpha) q_i p_i]$ and the platform's expected profit is $\Pi = E[\alpha \sum_i q_i p_i]$.
--
--   **Equilibrium.** A strategy of seller $j$ is admissible under $M$ if it is square integrable and measurable with respect to $y_j(M)$. A profile $q$ is a (Bayesian Nash) equilibrium under $M$ if every $q_j$ is admissible and no seller can increase his expected profit by switching to another admissible strategy.
--
--   **Formats.** $M$ is *Asymmetric Full Sharing* (AFS, Table 2) if $m_{i_1 j} = m_{i_2 j}$ for all $i_1, i_2, j$: every seller $j$ gets all $N$ signals with a common noise level $\eta_j \in [0,+\infty]$, which may differ across sellers. The file also names the truthful $K$-group matrix ($m_{ij} = 0$ for $j < K$, $+\infty$ otherwise), the no-sharing matrix (all $+\infty$), the matrix $M$ with seller $j$'s column replaced by $\eta$, and optimality among AFS matrices: $M$ is AFS, has an equilibrium, and no equilibrium of any AFS matrix gives the platform a larger expected profit. Finally it names the closed forms $q_{NS} = a/(2+b(N-1))$, $\Pi_{NS} = \alpha N a^2/[2+b(N-1)]^2$, the gain $\alpha K\sigma^2/([2+b(K-1)]^2(\sigma + t/N))$ of eq. (8), and $\min\{2/b - 1, N\}$; these appear only in theorem conclusions, never in the definition of profits or equilibria.
--
--   This is the common ground of every statement of the mission: the platform's design problem is to choose $M$ to maximize $\Pi$ at the sellers' equilibrium.
--
--   **Formalization Note.** $\sigma$, $t$ and $m_{ij}$ are variances, as in the paper's eq. (3). The hypotheses $0 < \alpha < 1$ (never stated in the paper), $\sigma, t > 0$ and $N \ge 1$ are made explicit. The paper's "cov = 0" is read as mutual independence of $u$, the $e_i$ and the $\xi_{ij}$. A signal with $m_{ij} = +\infty$ never enters the information $\sigma$-algebra (the Lean value of $\hat x_{ij}$ at $+\infty$ is unused). Profits are unconditional (ex-ante) expectations: the platform commits to $M$ before the signals are realized (p. 12), and the ex-ante best response over square-integrable strategies is equivalent a.e. to the interim maximization in eq. (2). Quantities and prices are real-valued, without sign constraints, as in the paper.
-- source:
--   Liu, Zhang & Zhang, Information Sharing on Retail Platforms, SSRN 3258109 (PDF of 2023-03-01), pp. 8–15, §3.1–§3.2, eqs. (1)–(4), Table 2

import Mathlib

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace RetailInfoShare.AFS

/-- Parameters of the model (§3.1): `N` sellers, demand intercept `a`, substitution
parameter `b`, prior variance `sig` (= σ) of the demand shock `u`, variance `t` of each
signal noise `e_i`, and commission rate `alpha` (= α). -/
structure Params where
  N : ℕ
  a : ℝ
  b : ℝ
  sig : ℝ≥0
  t : ℝ≥0
  alpha : ℝ

/-- Standing assumptions: `N ≥ 1`, `0 < b ≤ 1` (p. 9), `σ > 0`, `t > 0` (variances, made
explicit), `0 < α < 1` (commission rate, added). -/
def Params.Standing (P : Params) : Prop :=
  1 ≤ P.N ∧ 0 < P.b ∧ P.b ≤ 1 ∧ 0 < P.sig ∧ 0 < P.t ∧ 0 < P.alpha ∧ P.alpha < 1

/-- Index set of the primitive random variables: the demand shock `u`, the signal noises
`e i`, and the standard normals `ξ i j` that drive the platform's added noise. -/
inductive Prim (N : ℕ) where
  | u : Prim N
  | e : Fin N → Prim N
  | ξ : Fin N → Fin N → Prim N

/-- Gaussian primitives on a probability space `(Ω, μ)`: `u ~ N(0, σ)`, `e i ~ N(0, t)`,
`ξ i j ~ N(0, 1)` (second arguments are variances), all measurable and mutually
independent. The platform's noise on signal `i` sent to seller `j` is
`ε i j = √(m i j) · ξ i j ~ N(0, m i j)`. -/
structure Primitives (P : Params) (Ω : Type*) [MeasurableSpace Ω] (μ : Measure Ω) where
  u : Ω → ℝ
  e : Fin P.N → Ω → ℝ
  ξ : Fin P.N → Fin P.N → Ω → ℝ
  isProb : IsProbabilityMeasure μ
  meas_u : Measurable u
  meas_e : ∀ i, Measurable (e i)
  meas_ξ : ∀ i j, Measurable (ξ i j)
  law_u : HasLaw u (gaussianReal 0 P.sig) μ
  law_e : ∀ i, HasLaw (e i) (gaussianReal 0 P.t) μ
  law_ξ : ∀ i j, HasLaw (ξ i j) (gaussianReal 0 1) μ
  indep : iIndepFun (fun k : Prim P.N => (match k with
    | .u => u
    | .e i => e i
    | .ξ i j => ξ i j : Ω → ℝ)) μ

/-- A noise matrix `M i j = m_ij ∈ [0, +∞]`: the variance of the noise the platform adds to
signal `x_i` before sending it to seller `j`; `⊤ = +∞` means the signal is not sent. -/
abbrev NoiseMatrix (N : ℕ) := Fin N → Fin N → ℝ≥0∞

section

variable {P : Params} {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The shared signal `x̂_ij = x_i + ε_ij = u + e_i + √(m_ij) ξ_ij`. It enters seller `j`'s
information only when `m_ij ≠ ⊤` (see `info`); its value at `m_ij = ⊤` is never used. -/
noncomputable def xhat (Z : Primitives P Ω μ) (M : NoiseMatrix P.N) (i j : Fin P.N) :
    Ω → ℝ :=
  fun ω => Z.u ω + Z.e i ω + Real.sqrt (M i j).toReal * Z.ξ i j ω

/-- Seller `j`'s information `y_j(M)`: the σ-algebra generated by the delivered signals
`x̂_ij` with `m_ij ≠ ⊤`. It is `⊥` when nothing is delivered. -/
noncomputable def info (Z : Primitives P Ω μ) (M : NoiseMatrix P.N) (j : Fin P.N) : MeasurableSpace Ω :=
  ⨆ (i : Fin P.N) (_ : M i j ≠ ⊤), MeasurableSpace.comap (xhat Z M i j) inferInstance

/-- Price of seller `i`'s product, eq. (1): `p_i = a − q_i − b Σ_{d≠i} q_d + u`. -/
def price (Z : Primitives P Ω μ) (Q : Fin P.N → Ω → ℝ) (i : Fin P.N) : Ω → ℝ :=
  fun ω => P.a - Q i ω - P.b * ∑ d ∈ Finset.univ.erase i, Q d ω + Z.u ω

/-- Seller `i`'s ex-ante expected profit `E[(1 − α) q_i p_i]` (eq. (2), unconditional). -/
noncomputable def sellerProfit (Z : Primitives P Ω μ) (Q : Fin P.N → Ω → ℝ) (i : Fin P.N) :
    ℝ :=
  ∫ ω, (1 - P.alpha) * (Q i ω * price Z Q i ω) ∂μ

/-- The platform's expected profit `Π = E[α Σ_i q_i p_i]` (p. 12, unconditional). -/
noncomputable def platformProfit (Z : Primitives P Ω μ) (Q : Fin P.N → Ω → ℝ) : ℝ :=
  ∫ ω, P.alpha * ∑ i, Q i ω * price Z Q i ω ∂μ

/-- An admissible strategy of seller `j` under `M`: a square-integrable quantity that is
measurable with respect to seller `j`'s information. -/
def IsAdmissible (Z : Primitives P Ω μ) (M : NoiseMatrix P.N) (j : Fin P.N) (q : Ω → ℝ) :
    Prop :=
  StronglyMeasurable[info Z M j] q ∧ MemLp q 2 μ

/-- Bayesian Nash equilibrium under `M`: every seller plays an admissible strategy, and no
seller can raise his expected profit by switching to another admissible strategy. -/
def IsEquilibrium (Z : Primitives P Ω μ) (M : NoiseMatrix P.N) (Q : Fin P.N → Ω → ℝ) :
    Prop :=
  (∀ j, IsAdmissible Z M j (Q j)) ∧
    ∀ j q, IsAdmissible Z M j q →
      sellerProfit Z (Function.update Q j q) j ≤ sellerProfit Z Q j

end

/-- Asymmetric Full Sharing (Table 2): `m_{i₁ j} = m_{i₂ j}` for all `i₁, i₂, j`. -/
def IsAFS {N : ℕ} (M : NoiseMatrix N) : Prop :=
  ∀ i₁ i₂ j, M i₁ j = M i₂ j

/-- Truthful full sharing with the sellers `0, …, K − 1` (the paper's sellers `1, …, K`):
`m_ij = 0` if `j < K`, `m_ij = +∞` otherwise. -/
def truthfulGroup (N K : ℕ) : NoiseMatrix N :=
  fun _ j => if (j : ℕ) < K then 0 else ⊤

/-- No information sharing: `m_ij = +∞` for all `i, j`. -/
def noSharing (N : ℕ) : NoiseMatrix N :=
  fun _ _ => ⊤

/-- The matrix `M` with seller `j`'s column set to `η`: `M[j ↦ η]`. -/
def setColumn {N : ℕ} (M : NoiseMatrix N) (j : Fin N) (η : ℝ≥0∞) : NoiseMatrix N :=
  fun i j' => if j' = j then η else M i j'

/-- `M` is an optimal AFS strategy: `M` is AFS, it has an equilibrium `Q`, and no
equilibrium of any AFS matrix gives the platform more expected profit than `Q`. -/
def IsOptimalAFS {P : Params} {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (Z : Primitives P Ω μ) (M : NoiseMatrix P.N) : Prop :=
  IsAFS M ∧ ∃ Q, IsEquilibrium Z M Q ∧
    ∀ M', IsAFS M' → ∀ Q', IsEquilibrium Z M' Q' → platformProfit Z Q' ≤ platformProfit Z Q

/-- The no-sharing equilibrium quantity `a / (2 + b(N − 1))` (Lemma 1). -/
noncomputable def qNS (P : Params) : ℝ :=
  P.a / (2 + P.b * ((P.N : ℝ) - 1))

/-- The no-sharing platform profit `Π_NS = α N a² / [2 + b(N − 1)]²` (Lemma 1). -/
noncomputable def PiNS (P : Params) : ℝ :=
  P.alpha * P.N * P.a ^ 2 / (2 + P.b * ((P.N : ℝ) - 1)) ^ 2

/-- The gain from truthful full sharing with `K` sellers, the second term of eq. (8):
`α K σ² / ([2 + b(K − 1)]² (σ + t/N))`. -/
noncomputable def sharingGain (P : Params) (K : ℕ) : ℝ :=
  P.alpha * K * (P.sig : ℝ) ^ 2 /
    ((2 + P.b * ((K : ℝ) - 1)) ^ 2 * ((P.sig : ℝ) + (P.t : ℝ) / P.N))

/-- The real number `min{2/b − 1, N}` around which the optimal group size lies (eq. (7)). -/
noncomputable def mStar (P : Params) : ℝ :=
  min (2 / P.b - 1) (P.N : ℝ)

end RetailInfoShare.AFS


