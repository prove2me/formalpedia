section R05Seg7
/-!
# Atlas V-02 (D, general): second Bianchi identity in a general complex frame

For any `FrameData` (no curvature, NP or field equation):

* `gauge_bianchi`: the curvature `Fom` of the coordinate-direction connection `ω_μ` satisfies
  `Σ_cyc(μνλ) (∂_μ F_{νλ} + [ω_μ, F_{νλ}]) = 0` (symmetry of mixed partials + Jacobi identity);
* **`frame_bianchi`**: `Σ_cyc(E,A,B) (D_E R_{AB} + [Ω_E, R_{AB}] − Σ_K c^K_{EA} R_{KB}) = 0` for the frame curvature
  `R_{AB} = Rfr A B` — the non-coordinate term `−c R` is kept;
* `frame_bianchi_cov`: the same in covariant form, `Σ_cyc (∇_E R)_{AB} = 0` with
  `(∇_E R)_{AB} = D_E R_{AB} + [Ω_E, R_{AB}] − Σ_K Ω_E^K_A R_{KB} − Σ_K Ω_E^K_B R_{AK}` (torsion-free).
-/

open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

section bianchi

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem Fom_antisymm (g gi : Metric n) (E Θ : Fin n → Fin n → Pt n → ℂ) (μ ν : Fin n) (x : Pt n) :
    Fom g gi E Θ ν μ x = -Fom g gi E Θ μ ν x := by
  unfold Fom; abel

theorem smoothOnC_Fom (hF : FrameData g gi E Θ U) (μ ν : Fin n) : SmoothOnC (Fom g gi E Θ μ ν) U := by
  have hU := hF.isOpen
  exact ((((hF.smoothOnC_omegaC ν).pdMC hU μ).sub ((hF.smoothOnC_omegaC μ).pdMC hU ν)).add
    ((hF.smoothOnC_omegaC μ).mul (hF.smoothOnC_omegaC ν))).sub
    ((hF.smoothOnC_omegaC ν).mul (hF.smoothOnC_omegaC μ))

theorem pdMC_Fom (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ ν l : Fin n) :
    pdMC μ (Fom g gi E Θ ν l) x
      = pdMC μ (fun z => pdMC ν (omegaC g gi E Θ l) z) x - pdMC μ (fun z => pdMC l (omegaC g gi E Θ ν) z) x
        + (pdMC μ (omegaC g gi E Θ ν) x * omegaC g gi E Θ l x
          + omegaC g gi E Θ ν x * pdMC μ (omegaC g gi E Θ l) x)
        - (pdMC μ (omegaC g gi E Θ l) x * omegaC g gi E Θ ν x
          + omegaC g gi E Θ l x * pdMC μ (omegaC g gi E Θ ν) x) := by
  have hU := hF.isOpen
  have hω := hF.smoothOnC_omegaC
  unfold Fom
  rw [pdMC_sub hU hx μ ((((hω l).pdMC hU ν).sub ((hω ν).pdMC hU l)).add ((hω ν).mul (hω l)))
      ((hω l).mul (hω ν)),
    pdMC_add hU hx μ (((hω l).pdMC hU ν).sub ((hω ν).pdMC hU l)) ((hω ν).mul (hω l)),
    pdMC_sub hU hx μ ((hω l).pdMC hU ν) ((hω ν).pdMC hU l),
    pdMC_mul hU hx μ (hω ν) (hω l), pdMC_mul hU hx μ (hω l) (hω ν)]

/-- **Bianchi identity of the coordinate-direction connection `ω`**. -/
theorem gauge_bianchi (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ ν l : Fin n) :
    (pdMC μ (Fom g gi E Θ ν l) x + omegaC g gi E Θ μ x * Fom g gi E Θ ν l x
        - Fom g gi E Θ ν l x * omegaC g gi E Θ μ x)
      + (pdMC ν (Fom g gi E Θ l μ) x + omegaC g gi E Θ ν x * Fom g gi E Θ l μ x
        - Fom g gi E Θ l μ x * omegaC g gi E Θ ν x)
      + (pdMC l (Fom g gi E Θ μ ν) x + omegaC g gi E Θ l x * Fom g gi E Θ μ ν x
        - Fom g gi E Θ μ ν x * omegaC g gi E Θ l x) = 0 := by
  have hU := hF.isOpen
  have hω := hF.smoothOnC_omegaC
  rw [pdMC_Fom hF hx μ ν l, pdMC_Fom hF hx ν l μ, pdMC_Fom hF hx l μ ν,
    pdMC_pdMC_symm hU hx (hω ν) μ l, pdMC_pdMC_symm hU hx (hω l) ν μ, pdMC_pdMC_symm hU hx (hω μ) l ν]
  unfold Fom
  noncomm_ring

theorem pdMC_Rfr (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ A B : Fin n) :
    pdMC μ (Rfr g gi E Θ A B) x = ∑ ν, ∑ l, ((cpdC μ (E A ν) x * E B l x + E A ν x * cpdC μ (E B l) x)
      • Fom g gi E Θ ν l x + (E A ν x * E B l x) • pdMC μ (Fom g gi E Θ ν l) x) := by
  have hU := hF.isOpen
  rw [pdMC_congr_of_eqOn hU hx μ (fun z hz => Rfr_eq hF hz A B)]
  rw [pdMC_sum hU hx μ Finset.univ fun ν _ => SmoothOnC.sum Finset.univ fun l _ =>
    SmoothOnC.smul ((hF.smooth_E A ν).mul (hF.smooth_E B l)) (smoothOnC_Fom hF ν l)]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [pdMC_sum hU hx μ Finset.univ fun l _ =>
    SmoothOnC.smul ((hF.smooth_E A ν).mul (hF.smooth_E B l)) (smoothOnC_Fom hF ν l)]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [pdMC_smul hU hx μ ((hF.smooth_E A ν).mul (hF.smooth_E B l)) (smoothOnC_Fom hF ν l),
    cpdC_mul_of hU hx μ (hF.smooth_E A ν) (hF.smooth_E B l)]

theorem Dmat_Rfr (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (C A B : Fin n) :
    Dmat E C (Rfr g gi E Θ A B) x
      = ∑ ν, ∑ l, (fdir E C (E A ν) x * E B l x + E A ν x * fdir E C (E B l) x) • Fom g gi E Θ ν l x
        + ∑ μ, ∑ ν, ∑ l, (E C μ x * (E A ν x * E B l x)) • pdMC μ (Fom g gi E Θ ν l) x := by
  unfold Dmat
  simp only [pdMC_Rfr hF hx, Finset.smul_sum, smul_add, Finset.sum_add_distrib, smul_smul]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [← Finset.sum_smul]
  congr 1
  simp only [fdir, mul_add, Finset.sum_add_distrib, Finset.sum_mul]
  congr 1
  · exact Finset.sum_congr rfl fun μ _ => by ring
  · rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun μ _ => by ring

theorem sum_cfr_Rfr (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (C A B : Fin n) :
    ∑ K, cfr E Θ K C A x • Rfr g gi E Θ K B x
      = ∑ ν, ∑ l, (brk E C A ν x * E B l x) • Fom g gi E Θ ν l x := by
  simp only [Rfr_eq hF hx, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [← Finset.sum_smul]
  congr 1
  rw [← hF.sum_coeff hx (fun ρ => brk E C A ρ x) ν, Finset.sum_mul]
  exact Finset.sum_congr rfl fun K _ => by unfold cfr; ring

theorem sum3_rot {α : Type*} [AddCommMonoid α] (f : Fin n → Fin n → Fin n → α) :
    ∑ ν, ∑ l, ∑ μ, f ν l μ = ∑ μ, ∑ ν, ∑ l, f ν l μ :=
  calc ∑ ν, ∑ l, ∑ μ, f ν l μ = ∑ ν, ∑ μ, ∑ l, f ν l μ := Finset.sum_congr rfl fun ν _ => Finset.sum_comm
    _ = ∑ μ, ∑ ν, ∑ l, f ν l μ := Finset.sum_comm

theorem comm_Omega_Rfr (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (C A B : Fin n) :
    Omega g gi E Θ C x * Rfr g gi E Θ A B x - Rfr g gi E Θ A B x * Omega g gi E Θ C x
      = ∑ μ, ∑ ν, ∑ l, (E C μ x * (E A ν x * E B l x)) • (omegaC g gi E Θ μ x * Fom g gi E Θ ν l x
        - Fom g gi E Θ ν l x * omegaC g gi E Θ μ x) := by
  have h1 : Omega g gi E Θ C x * Rfr g gi E Θ A B x = ∑ μ, ∑ ν, ∑ l,
      (E C μ x * (E A ν x * E B l x)) • (omegaC g gi E Θ μ x * Fom g gi E Θ ν l x) := by
    simp only [Rfr_eq hF hx, Omega, Finset.sum_mul, Finset.mul_sum, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
    rw [sum3_rot]
    exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => Finset.sum_congr rfl fun l _ => by
      rw [mul_comm (E A ν x * E B l x)]
  have h2 : Rfr g gi E Θ A B x * Omega g gi E Θ C x = ∑ μ, ∑ ν, ∑ l,
      (E C μ x * (E A ν x * E B l x)) • (Fom g gi E Θ ν l x * omegaC g gi E Θ μ x) := by
    simp only [Rfr_eq hF hx, Omega, Finset.sum_mul, Finset.mul_sum, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  rw [h1, h2]
  simp only [← Finset.sum_sub_distrib, smul_sub]

theorem sum2_antisymm_pair {F : Fin n → Fin n → Matrix (Fin n) (Fin n) ℂ} (hF : ∀ ν l, F l ν = -F ν l)
    (p q : Fin n → ℂ) : ∑ ν, ∑ l, (p ν * q l) • F ν l + ∑ ν, ∑ l, (q ν * p l) • F ν l = 0 := by
  have h : ∑ ν, ∑ l, (q ν * p l) • F ν l = -∑ ν, ∑ l, (p ν * q l) • F ν l := by
    rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [hF, smul_neg, mul_comm]
  rw [h, add_neg_cancel]

theorem sum3_rot' {α : Type*} [AddCommMonoid α] (f : Fin n → Fin n → Fin n → α) :
    ∑ ν, ∑ l, ∑ μ, f ν l μ = ∑ l, ∑ μ, ∑ ν, f ν l μ := by
  rw [sum3_rot, sum3_rot]

end bianchi

