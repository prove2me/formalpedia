    rw [← sapF_aff]
    refine (sapF_le h Φ k (Finset.mem_range.1 hk)).trans (le_of_eq ?_)
    ring
  unfold CSK
  have := Nat.mul_le_mul_left Φ h1
  omega

theorem CBK_le {K N β W : ℕ} (h : HB K N β W) (Φ : ℕ) :
    CBK K N Φ ≤ (10 ^ 14 * (2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2 +
        10 ^ 60 * (2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12) +
      Φ * (2 * (W + 2) * 2 ^ (mkParams K N).logT) := by
  have h0 : CB0 K N ≤ 10 ^ 14 * (2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2 +
        10 ^ 60 * (2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12 := Finset.sup_le fun k hk => by
    have := bapF_le h 0 k (Finset.mem_range.1 hk); simp only [mul_zero, zero_add] at this; exact this
  have h1 : DB K N ≤ 2 * (W + 2) * 2 ^ (mkParams K N).logT := Finset.sup_le fun k hk => by
    apply slope_le (bapF K N 0 k) _ (10 ^ 14 * (2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2 +
        10 ^ 60 * (2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12)
    intro Φ
    rw [← bapF_aff]
    refine (bapF_le h Φ k (Finset.mem_range.1 hk)).trans (le_of_eq ?_)
    ring
  unfold CBK
  have := Nat.mul_le_mul_left Φ h1
  omega

theorem L_a (K CS CB Φ W T r β : ℕ)
    (hCS : CS ≤ (10 ^ 14 * (T + 1) * (β + 2) ^ 2 + 10 ^ 60 * (r + 1) ^ 3 * (β + 2) ^ 12) +
      Φ * (2 * (W + 2) * T))
    (hCB : CB ≤ (10 ^ 14 * (T + 1) * (β + 2) ^ 2 + 10 ^ 60 * (r + 1) ^ 3 * (β + 2) ^ 12) +
      Φ * (2 * (W + 2) * T)) :
    3 * K * CS + 3 * K * CB ≤ 6 * 10 ^ 14 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) +
      6 * 10 ^ 60 * ((K + 1) ^ 2 * ((r + 1) ^ 3 * (β + 2) ^ 12)) + Φ * (12 * K * (W + 2) * T) := by
  calc 3 * K * CS + 3 * K * CB ≤
      3 * K * ((10 ^ 14 * (T + 1) * (β + 2) ^ 2 + 10 ^ 60 * (r + 1) ^ 3 * (β + 2) ^ 12) +
        Φ * (2 * (W + 2) * T)) +
      3 * K * ((10 ^ 14 * (T + 1) * (β + 2) ^ 2 + 10 ^ 60 * (r + 1) ^ 3 * (β + 2) ^ 12) +
        Φ * (2 * (W + 2) * T)) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_b (K T N' r β Bx Q P e kb : ℕ) (hBx : Bx ≤ β) (hQ : Q ≤ β) (hP : P ≤ β) (he : e ≤ β)
    (hkb : kb ≤ β) (hNr : N' * r = T) (hN1 : 1 ≤ N') (hr1 : 1 ≤ r) :
    10 ^ 14 * (K + 1) * ((T + 1) * (Bx + Q + 2) ^ 2 + (N' + 1) * (r + 1) * (P + e + kb + 2) ^ 2) ≤
      10 ^ 17 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) := by
  have h1 : (N' + 1) * (r + 1) ≤ 4 * T := by rw [← hNr]; nlinarith
  calc _ ≤ 10 ^ 14 * (K + 1) * ((T + 1) * (β + β + 2) ^ 2 + (4 * T) * (β + β + β + 2) ^ 2) := by
        gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_c (K p Bd Bs r β : ℕ) (hp : p ≤ β) (hBd : Bd ≤ 16 * r * β) (hBs : Bs ≤ 16 * r * β) :
    10 ^ 12 * (K + 1) * (p + Bd + Bs + 2) ^ 3 ≤ 10 ^ 18 * ((K + 1) ^ 2 * ((r + 1) ^ 3 * (β + 2) ^ 12)) := by
  calc _ ≤ 10 ^ 12 * (K + 1) * (β + 16 * r * β + 16 * r * β + 2) ^ 3 := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_key (K S T Bc β : ℕ) (hS : S ≤ T) (hB : Bc ≤ β) :
    10 ^ 9 * (K + 1) * ((S + 1) * (Bc + 2) ^ 2) ≤ 10 ^ 9 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) := by
  calc _ ≤ 10 ^ 9 * (K + 1) * ((T + 1) * (β + 2) ^ 2) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_chirp (K T r kb Bc p Z β : ℕ) (hr : r ≤ T) (hkb : kb ≤ β) (hB : Bc ≤ β) (hp : p ≤ β)
    (hZ : Z ≤ β) :
    10 ^ 12 * (K + 6) * ((T + r + 1) * (kb + Bc + 2) ^ 2) + 10 ^ 46 * ((r + 1) * (p + Z + Bc + 2) ^ 6) ≤
      10 ^ 14 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) +
        10 ^ 50 * ((K + 1) ^ 2 * ((r + 1) ^ 3 * (β + 2) ^ 12)) := by
  calc _ ≤ 10 ^ 12 * (K + 6) * ((T + T + 1) * (β + β + 2) ^ 2) +
        10 ^ 46 * ((r + 1) * (β + β + β + 2) ^ 6) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_crt (S T kb Bc β : ℕ) (hS : S ≤ T) (hkb : kb ≤ β) (hB : Bc ≤ β) (K : ℕ) :
    10 ^ 9 * ((S + 1) * (kb + Bc + 2) ^ 2) ≤ 10 ^ 10 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) := by
  calc _ ≤ 10 ^ 9 * ((T + 1) * (β + β + 2) ^ 2) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_tail (K T S Mo kb Bc b N β : ℕ) (hS : S ≤ T) (hMo : Mo ≤ T) (hkb : kb ≤ β) (hB : Bc ≤ β)
    (hbMo : b * Mo ≤ 2 * N + 2 * β) :
    10 ^ 9 * ((T + S + Mo + 1) * (kb + Bc + 2) ^ 2) + 20000 * (b * Mo) ≤
      10 ^ 11 * ((K + 1) ^ 2 * ((T + 1) * (β + 2) ^ 2)) + 10 ^ 5 * ((N + 1) * (β + 2)) := by
  calc _ ≤ 10 ^ 9 * ((T + T + T + 1) * (β + β + 2) ^ 2) + 20000 * (2 * N + 2 * β) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_head (K N b zN zz P0 Bc lT β T r : ℕ) (hz : zN ≤ β) (hzz : zz ≤ β) (hP0 : P0 ≤ β)
    (hB : Bc ≤ β) (hlT : lT ≤ β) (hK : K ≤ β) :
    (2 * (4000 * (N + 2)) + 2 * (2 * N + 2)) + (3 * (4000 * (zN + 2)) +
      (2000 * (zN + 1) * (zz + 2) + 2) + 2 * (2 * zN + 2)) +
      ((CR.facN K + 2 * K + 5 * zN + 102) * 10 ^ 9 * (P0 + 2) ^ 2 + 4 * 2000 * (lT + 5)) +
      (4000 * (2 * N + 2) + (2 * (2 * N) + 2)) + (20 * (2 * (Bc + N) + 2) + 1) ≤
      10 ^ 15 * ((K + 1) ^ 2 * ((r + 1) ^ 3 * (β + 2) ^ 12)) + 10 ^ 5 * ((N + 1) * (β + 2)) := by
  unfold CR.facN
  calc _ ≤ (2 * (4000 * (N + 2)) + 2 * (2 * N + 2)) + (3 * (4000 * (β + 2)) +
      (2000 * (β + 1) * (β + 2) + 2) + 2 * (2 * β + 2)) +
      ((256 * K ^ 2 + 2 * K + 5 * β + 102) * 10 ^ 9 * (β + 2) ^ 2 + 4 * 2000 * (β + 5)) +
      (4000 * (2 * N + 2) + (2 * (2 * N) + 2)) + (20 * (2 * (β + N) + 2) + 1) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

theorem L_bMo (b L N β : ℕ) (hLb : L * b ≤ N + b) (hb : b ≤ β) : b * (2 * L - 1) ≤ 2 * N + 2 * β := by
  have : b * (2 * L - 1) ≤ b * (2 * L) := Nat.mul_le_mul_left _ (Nat.sub_le _ _)
  have e : b * (2 * L) = 2 * (L * b) := by ring
  omega

theorem L_cnt (K S T W Φ : ℕ) (hS : S ≤ T) :
    (24 * T + 5 * S) * Φ + Φ * (12 * K * (W + 2) * T) ≤ Φ * (100 * (K + 1) * (W + 2) * T) := by
  calc _ ≤ (24 * T + 5 * T) * Φ + Φ * (12 * K * (W + 2) * T) := by gcongr
    _ ≤ _ := by (((try clear * -); zify; rw [← sub_nonneg]; ring_nf; positivity))

end NLogN.FIN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 8000000
set_option maxRecDepth 100000
open NLogN
open NLogN.FIN
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.ST
theorem solution {K N β W : ℕ} (h : NLogN.FIN.HB K N β W) (Φf Φm : ℕ) :
    NLogN.ST.GK K N Φf Φm ≤ 3 * 2 ^ (mkParams K N).logOuter * Φf +
      Φm * (100 * (K + 1) * (W + 2) * 2 ^ (mkParams K N).logT) +
      (10 ^ 22 * ((K + 1) ^ 2 * ((2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2)) +
        10 ^ 64 * ((K + 1) ^ 2 * ((2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12)) +
        10 ^ 7 * ((N + 1) * (β + 2))) := by
  have kf := h.kf
  have pf := kf.pf
  have hqK : (mkParams K N).K = K := rfl
  have hT : NLogN.EX.TT (mkParams K N) = 2 ^ (mkParams K N).logT := kf.TT
  have hT' : (mkParams K N).tdims.prod = 2 ^ (mkParams K N).logT := kf.TT
  have hrT : 2 ^ (mkParams K N).e ≤ 2 ^ (mkParams K N).logT :=
    Nat.pow_le_pow_right (by norm_num) kf.e_le
  have hr1 : 1 ≤ 2 ^ (mkParams K N).e := Nat.one_le_two_pow
  have hN1 : 1 ≤ 2 ^ (mkParams K N).logOuter := Nat.one_le_two_pow
  have hNr : 2 ^ (mkParams K N).logOuter * 2 ^ (mkParams K N).e = 2 ^ (mkParams K N).logT := by
    rw [← pow_add, pf.lo]
  have hS : (mkParams K N).S ≤ 2 ^ (mkParams K N).logT := by
    have hsl : (mkParams K N).s.length = (mkParams K N).K := kf.sl
    have e0 := NLogN.EX.NS_le (mkParams K N) hsl (fun i hi => kf.sle i hi) 0
    rw [NLogN.EX.NS_zero, hT] at e0; exact e0
  have hL4 := pf.E4
  have hLb := pf.Lb
  have hkb : (mkParams K N).logT + 2 ≤ β := h.kb
  have he_le : (mkParams K N).e ≤ β := le_trans kf.e_le (by omega)
  have hzN : NLogN.zsz (N : ℤ) = (mkParams K N).b := pf.zN
  have hCS := NLogN.FIN.CSK_le h Φm
  have hCB := NLogN.FIN.CBK_le h Φm
  have hex := NLogN.FIN.ex_le (mkParams K N) ((mkParams K N).logT + 2) (NLogN.ST.CSK K N Φm) (NLogN.ST.CBK K N Φm) (NLogN.ST.BxK K N) (NLogN.ST.QK K N)
    Φf Φm (2 ^ (mkParams K N).logT) (2 ^ (mkParams K N).logOuter) (2 ^ (mkParams K N).e) hT hS
    rfl rfl rfl rfl
  have hmid := NLogN.FIN.midP_le (mkParams K N) ((mkParams K N).logT + 2) (NLogN.ST.BsK K N) (NLogN.ST.CSK K N Φm) (NLogN.ST.CBK K N Φm)
    (NLogN.ST.BxK K N) (NLogN.ST.QK K N) Φf Φm (NLogN.ST.BdK K N)
  rw [hqK] at hex hmid
  have ha := NLogN.FIN.L_a K _ _ Φm W _ _ β hCS hCB
  have hb := NLogN.FIN.L_b K (2 ^ (mkParams K N).logT) _ _ β _ _ _ _ _ h.Bx h.Q h.P he_le hkb hNr hN1 hr1
  have hc := NLogN.FIN.L_c K _ _ _ (2 ^ (mkParams K N).e) β h.p (by have := h.Bd; linarith) (by have := h.Bs; linarith)
  have hk1 := NLogN.FIN.key_le K (mkParams K N).S (NLogN.ST.BcK K N)
  have hk2 := NLogN.FIN.L_key K _ _ _ β hS h.Bc
  have hz2 : NLogN.zsz ((2 * 2 ^ (mkParams K N).e : ℕ) : ℤ) ≤ β := by
    have : NLogN.zsz ((2 * 2 ^ (mkParams K N).e : ℕ) : ℤ) ≤ (mkParams K N).e + 2 := by
      apply NLogN.NK.zlt; rw [pow_add]; norm_num; omega
    have := kf.e_le; omega
  have hch1 := NLogN.FIN.chirp_le (mkParams K N) ((mkParams K N).logT + 2) (NLogN.ST.BcK K N) (2 ^ (mkParams K N).logT)
    (2 ^ (mkParams K N).e) β hT' rfl hz2
  have hch2 := NLogN.FIN.L_chirp K _ _ _ _ _ _ β hrT hkb h.Bc h.p le_rfl
  rw [hqK] at hch1
  have hcr1 := NLogN.FIN.crt_le (mkParams K N).S ((mkParams K N).logT + 2) (NLogN.ST.BcK K N)
  have hcr2 := NLogN.FIN.L_crt _ _ _ _ β hS hkb h.Bc K
  have ht1 := NLogN.FIN.tail_le (mkParams K N).tdims.prod (mkParams K N).S (2 * (mkParams K N).L - 1)
    ((mkParams K N).logT + 2) (mkParams K N).b (NLogN.ST.BcK K N)
  rw [hT'] at ht1
  have ht2 := NLogN.FIN.L_tail K _ _ _ _ _ _ N β hS (by omega) hkb h.Bc (NLogN.FIN.L_bMo _ _ N β hLb h.b)
  have hzz : NLogN.zsz ((NLogN.zsz (N : ℤ) : ℕ) : ℤ) ≤ β := by
    have := NLogN.FIN.zsz_le_self (NLogN.zsz (N : ℤ)); have := h.b; omega
  have hhd := NLogN.FIN.L_head K N (mkParams K N).b (NLogN.zsz (N : ℤ)) (NLogN.zsz ((NLogN.zsz (N : ℤ) : ℕ) : ℤ))
    (Nat.size (NLogN.CR.parBnd K N (NLogN.zsz (N : ℤ)))) (NLogN.ST.BcK K N) (mkParams K N).logT β
    (2 ^ (mkParams K N).logT) (2 ^ (mkParams K N).e) (by have := h.b; omega) hzz h.par h.Bc
    (by omega) h.Kβ
  have hcnt := NLogN.FIN.L_cnt K (mkParams K N).S (2 ^ (mkParams K N).logT) W Φm hS
  have hpl : NLogN.ST.parRegs.length = 20 := rfl
  unfold NLogN.ST.GK NLogN.ST.stepCost NLogN.Top.blenCost
  have hSd : (mkParams K N).s.prod = (mkParams K N).S := rfl
  rw [hpl, hSd, hT']
  generalize NLogN.ST.exCost (mkParams K N) ((mkParams K N).logT + 2) (NLogN.ST.CSK K N Φm) (NLogN.ST.CBK K N Φm) (NLogN.ST.BxK K N)
    (NLogN.ST.QK K N) Φf Φm = EXC at *
  generalize (K + 1) ^ 2 * ((2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2) = MK at *
  generalize (K + 1) ^ 2 * ((2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12) = JK at *
  generalize (N + 1) * (β + 2) = NB at *
  linarith
end
