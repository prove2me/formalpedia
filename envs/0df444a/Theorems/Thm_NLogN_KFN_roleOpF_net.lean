theorem NLogN.KFN.roleOpF_net {st : Fin m × κ → ℕ} {n : ℕ} (h : SLaws st n) (T : Butterfly.Op κ) :
    ∀ (l : List (RStep (Fin W) m)) (X : Fin W → List M), (∀ w, (X w).length = n) →
