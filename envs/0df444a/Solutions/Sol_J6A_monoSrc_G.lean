lemma jcB_nonneg (s t H k : ℕ) : 0 ≤ jcB s t H k := by unfold jcB; positivity

lemma jcB_le (s t H k : ℕ) (ht : 0 < t) (hk : kcB H k < t) : jcB s t H k ≤ s := by
  unfold jcB
  have : (2 * s * kcB H k + t) / (2 * t) ≤ s := by
    rw [Nat.div_le_iff_le_mul_add_pred (by omega)]
    have h1 : kcB H k + 1 ≤ t := hk
    have h2 := Nat.mul_le_mul_left (2 * s) h1
    rw [Nat.mul_add, mul_one] at h2
    have h3 : 2 * s * t = 2 * t * s := by ring
    omega
  exact_mod_cast this

/-- The separation of the windows of blocks `b` and `b + 8 i` (`i ≥ 1`). -/
lemma jcB_sep (s t H W b b' : ℕ) (ht : 0 < t) (hH : 1 ≤ H) (hsep : 2 * W * t ≤ 16 * H * s)
    (hb : b + 8 ≤ b') : jcB s t H (kkA H b) + 2 * W ≤ jcB s t H (kkA H b') := by
  unfold jcB
  have e1 : kcB H (kkA H b) = b * (2 * H) + H := by
    unfold kcB kkA; rw [Nat.mul_div_cancel _ (by omega)]
  have e2 : kcB H (kkA H b') = b' * (2 * H) + H := by
    unfold kcB kkA; rw [Nat.mul_div_cancel _ (by omega)]
  rw [e1, e2]
  have hle : 2 * s * (b * (2 * H) + H) + t + 2 * t * (2 * W) ≤ 2 * s * (b' * (2 * H) + H) + t := by
    have : b' * (2 * H) ≥ (b + 8) * (2 * H) := Nat.mul_le_mul_right _ hb
    nlinarith
  have h1 : (2 * s * (b * (2 * H) + H) + t) / (2 * t) + 2 * W ≤
      (2 * s * (b' * (2 * H) + H) + t) / (2 * t) := by
    calc (2 * s * (b * (2 * H) + H) + t) / (2 * t) + 2 * W
        = (2 * s * (b * (2 * H) + H) + t + 2 * t * (2 * W)) / (2 * t) := by
          rw [Nat.add_mul_div_left _ _ (by omega)]
      _ ≤ _ := Nat.div_le_div_right hle
  exact_mod_cast h1

lemma posE_lt (s t W : ℕ) (hWs : W ≤ s) (hst : s ≤ t) {j : ℤ} (h0 : -(W : ℤ) ≤ j)
    (h1 : j < s + W) : posE s t j < 3 * t := by
  unfold posE; split_ifs <;> omega

lemma posE_mono (s t W : ℕ) (hWs : W ≤ s) (hst : s ≤ t) {j j' : ℤ} (h0 : -(W : ℤ) ≤ j)
    (hjj : j ≤ j') (h1 : j' < s + W) : posE s t j ≤ posE s t j' := by
  unfold posE; split_ifs <;> omega

