import Mathlib
import Theorems.Thm_KroneckerWeyl_denseRange_torusFlow_iff

set_option autoImplicit false

namespace Sol_KroneckerWeyl_closure_range_torusFlow_equiv_torus

/-- An integer matrix acts on product tori by continuous homomorphisms. -/
theorem exists_intMap {α β : Type*} [Fintype β] (a : α → β → ℤ) :
    ∃ φ : UnitAddTorus β →ₜ+ UnitAddTorus α, ∀ y i, φ y i = ∑ j, a i j • y j :=
  ⟨{ toFun := fun y i ↦ ∑ j, a i j • y j
     map_zero' := by funext i; simp
     map_add' := fun y z ↦ by funext i; simp [smul_add, Finset.sum_add_distrib]
     continuous_toFun := continuous_pi fun i ↦
       continuous_finsetSum _ fun j _ ↦ (continuous_apply j).zsmul (a i j) },
    fun _ _ ↦ rfl⟩

end Sol_KroneckerWeyl_closure_range_torusFlow_equiv_torus

open KroneckerWeyl Sol_KroneckerWeyl_closure_range_torusFlow_equiv_torus

theorem solution {ι : Type*} [Finite ι] (τ : ι → ℝ)
    (G : AddSubgroup (UnitAddTorus ι))
    (hG : (G : Set (UnitAddTorus ι)) =
      closure (Set.range fun t : ℝ => fun k : ι => ((t * τ k : ℝ) : UnitAddCircle))) :
    Nonempty (G ≃ₜ+ UnitAddTorus (Fin (Module.finrank ℚ (Submodule.span ℚ (Set.range τ))))) := by
  classical
  have := Fintype.ofFinite ι
  -- An integer basis `β` of the group generated by the frequencies.
  let M : Submodule ℤ ℝ := Submodule.span ℤ (Set.range τ)
  have : Module.Finite ℤ M := Module.Finite.span_of_finite ℤ (Set.finite_range τ)
  let b : Module.Basis (Fin (Module.finrank ℤ M)) ℤ M := Module.finBasis ℤ M
  let β : Fin (Module.finrank ℤ M) → ℝ := fun j ↦ (b j : ℝ)
  have hτM (i : ι) : τ i ∈ M := Submodule.subset_span ⟨i, rfl⟩
  let a : ι → Fin (Module.finrank ℤ M) → ℤ := fun i j ↦ b.repr ⟨τ i, hτM i⟩ j
  have hτ (i : ι) : τ i = ∑ j, a i j • β j := by
    have h := congrArg Subtype.val (b.sum_repr ⟨τ i, hτM i⟩)
    rw [Submodule.coe_sum] at h
    simp_rw [Submodule.coe_smul] at h
    exact h.symm
  have hβZ : LinearIndependent ℤ β := b.linearIndependent.map' M.subtype M.ker_subtype
  have hβQ : LinearIndependent ℚ β := (LinearIndependent.iff_fractionRing ℤ ℚ).mp hβZ
  choose c hc using fun j ↦ Submodule.mem_span_range_iff_exists_fun ℤ |>.mp (b j).2
  -- The coefficient matrices are inverse to each other on the integer side.
  have hca (j j' : Fin (Module.finrank ℤ M)) :
      ∑ i, c j i * a i j' = if j = j' then 1 else 0 := by
    have hsum : ∑ k, (∑ i, c j i * a i k) • β k = β j := by
      refine Eq.trans ?_ (hc j)
      simp_rw [hτ, Finset.smul_sum, smul_smul, Finset.sum_smul]
      exact Finset.sum_comm
    have h0 := Fintype.linearIndependent_iff.mp hβZ
      (fun k ↦ (∑ i, c j i * a i k) - if j = k then 1 else 0) (by
        simp_rw [sub_smul, Finset.sum_sub_distrib, hsum, ite_smul, one_smul, zero_smul,
          Finset.sum_ite_eq, Finset.mem_univ, ite_true, sub_self]) j'
    exact sub_eq_zero.mp h0
  -- The rational span of the frequencies is that of the basis.
  have hrank : Module.finrank ℚ (Submodule.span ℚ (Set.range τ)) = Module.finrank ℤ M := by
    have hspan : Submodule.span ℚ (Set.range τ) = Submodule.span ℚ (Set.range β) := by
      refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
      · rintro _ ⟨i, rfl⟩
        rw [hτ i]
        exact Submodule.sum_mem _ fun j _ ↦
          zsmul_mem (Submodule.subset_span (Set.mem_range_self j)) _
      · rintro _ ⟨j, rfl⟩
        rw [show β j = ∑ i, c j i • τ i from (hc j).symm]
        exact Submodule.sum_mem _ fun i _ ↦
          zsmul_mem (Submodule.subset_span (Set.mem_range_self i)) _
    rw [hspan, finrank_span_eq_card hβQ, Fintype.card_fin]
  rw [hrank]
  obtain ⟨φ, hφ⟩ := exists_intMap a
  obtain ⟨ψ, hψ⟩ := exists_intMap (fun j i ↦ c j i)
  have hψφ (y : UnitAddTorus (Fin (Module.finrank ℤ M))) : ψ (φ y) = y := by
    funext j
    simp_rw [hψ, hφ, Finset.smul_sum, smul_smul]
    rw [Finset.sum_comm]
    simp_rw [← Finset.sum_smul, hca, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
      Finset.mem_univ, ite_true]
  -- The integer map carries the basis flow to the frequency flow.
  have hflow (t : ℝ) : φ (fun k => ((t * β k : ℝ) : UnitAddCircle)) =
      fun k => ((t * τ k : ℝ) : UnitAddCircle) := by
    funext i
    rw [hφ]
    change ∑ j, a i j • (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)) (t * β j)) =
      QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ)) (t * τ i)
    rw [hτ i, Finset.mul_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [mul_smul_comm, map_zsmul]
  have hdense : DenseRange (fun t : ℝ => fun k => ((t * β k : ℝ) : UnitAddCircle)) :=
    (denseRange_torusFlow_iff β).mpr hβQ
  have hrange : (G : Set (UnitAddTorus ι)) = Set.range φ := by
    rw [hG]
    refine le_antisymm (closure_minimal ?_ (isCompact_range φ.continuous).isClosed) ?_
    · rintro _ ⟨t, rfl⟩
      exact ⟨_, hflow t⟩
    · rintro _ ⟨y, rfl⟩
      have hy : y ∈ closure (Set.range fun t : ℝ => fun k => ((t * β k : ℝ) : UnitAddCircle)) :=
        hdense y
      refine image_closure_subset_closure_image φ.continuous ⟨y, hy, rfl⟩ |> closure_mono ?_
      rintro _ ⟨_, ⟨t, rfl⟩, rfl⟩
      exact ⟨t, (hflow t).symm⟩
  have hmem (y : UnitAddTorus (Fin (Module.finrank ℤ M))) : φ y ∈ G := by
    rw [← SetLike.mem_coe, hrange]
    exact ⟨y, rfl⟩
  refine ⟨ContinuousAddEquiv.symm
    { toFun := fun y ↦ ⟨φ y, hmem y⟩
      invFun := fun x ↦ ψ x
      left_inv := fun y ↦ hψφ y
      right_inv := fun x ↦ ?_
      map_add' := fun y z ↦ Subtype.ext (map_add φ y z)
      continuous_toFun := φ.continuous.subtype_mk _
      continuous_invFun := ψ.continuous.comp continuous_subtype_val }⟩
  obtain ⟨y, hy⟩ : (x : UnitAddTorus ι) ∈ Set.range φ := hrange ▸ x.2
  exact Subtype.ext (by simp only [← hy, hψφ])
