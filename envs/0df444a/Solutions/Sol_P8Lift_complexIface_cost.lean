namespace Prop8IfaceR

variable {W s : ℕ}

variable [NeZero W]

/-- **§5.3 cost bound through the restricted interface.** Local work at a node on volume `V`
is charged `nloc · W · V` (the actual entry-operation count, `locWork_le`); the recurrence
then counts only the `s` child calls, and the bound of `recCost_le` holds. -/
theorem recCostR_le (J : Prop8IfaceR W m s) (u : ℕ) (hu : 1 ≤ u) (hm : 2 ≤ m) (lam σ C₀ : ℝ)
    (hlam : 0 ≤ lam) (hsσ : (s : ℝ) / W ≤ (m : ℝ) ^ σ) (hσl : σ < lam) (hC₀ : 0 ≤ C₀) :
    ∃ K₁ : ℝ, 0 ≤ K₁ ∧ ∀ (Cleaf : ℝ → ℝ), (∀ V, 0 ≤ V → Cleaf V ≤ C₀ * V * u) →
      ∀ k V, 0 ≤ V → recCost J.toIface u (fun _ V => (J.nloc * W : ℝ) * V) Cleaf k V ≤
        V * (K₁ * ((u : ℝ) * (m : ℝ) ^ k) ^ lam +
          C₀ * (((u : ℝ) * (m : ℝ) ^ k) ^ σ * (u : ℝ) ^ (1 - σ))) := by
  obtain ⟨K₁, hK₁, h⟩ := recCost_le J.toIface u hm lam σ (J.nloc * W) C₀ hsσ hσl
    (by positivity) hC₀
  refine ⟨K₁, hK₁, fun Cleaf hleaf => h _ Cleaf hleaf ?_⟩
  intro k V hV
  have h1 : (1 : ℝ) ≤ (u : ℝ) * (m : ℝ) ^ (k + 1) := by
    have : (1 : ℝ) ≤ u := by exact_mod_cast hu
    have : (1 : ℝ) ≤ (m : ℝ) ^ (k + 1) := one_le_pow₀ (by exact_mod_cast (by omega : 1 ≤ m))
    nlinarith
  have h2 : (1 : ℝ) ≤ ((u : ℝ) * (m : ℝ) ^ (k + 1)) ^ lam := Real.one_le_rpow h1 hlam
  have h3 : (0 : ℝ) ≤ (J.nloc * W : ℝ) * V := by positivity
  nlinarith

end Prop8IfaceR

