  have HAJ := And.intro h3 (And.intro h4 (And.intro h5 (And.intro h6 (And.intro h7 (And.intro h8 (And.intro h9 (And.intro h10
    (And.intro h11 (And.intro h12 h13)))))))))
  have hΛ : GoodReductionJacobian.AbelianSchemePropertyBundle (baseRing p) ΛT.f :=
    JHNeronObjectAtP.LevelData.abelianSchemePropertyBundle_of_nonempty_representsRelSubPic p (N₀ * p) ⊤ hpM hpM2 hj 𝔛 A ΛT hrepΛ

