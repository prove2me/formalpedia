theorem Formalism.LFunctionChainParameters.LHost.field_frob_of (h : HostHyp q d) (hL : IsLayer (e + 2) q d ζ a b) (p : ℕ) [Fact p.Prime]
    (P : Ideal (𝓞 (hostE ζ a b))) [P.IsPrime] [P.LiesOver (span {(p : ℤ)})]
    (σ₀ : hostE ζ a b ≃ₐ[ℚ] hostE ζ a b) (h₀ : IsArithFrobAt ℤ σ₀ P)
    (h1 : galoisToProduct e (galE e ζ a b σ₀) - (hostData e q d).frob p ∈ (hostData e q d).inertia p)
    (σ : hostE ζ a b ≃ₐ[ℚ] hostE ζ a b) :
    IsArithFrobAt ℤ σ P ↔
      galoisToProduct e (galE e ζ a b σ) - (hostData e q d).frob p ∈ (hostData e q d).inertia p := by sorry
