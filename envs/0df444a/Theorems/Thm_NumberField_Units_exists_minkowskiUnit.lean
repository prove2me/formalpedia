-- title:
--   Existence of a Minkowski unit in a Galois number field
-- statement:
--   Let $K$ be a number field which is Galois over $\mathbb{Q}$, with Galois group $G = \mathrm{Gal}(K/\mathbb{Q})$ and ring of integers $\mathcal{O}_K$. Every $\sigma \in G$ restricts to a ring automorphism of $\mathcal{O}_K$ and hence acts on the unit group $\mathcal{O}_K^\times$.
--
--   **Theorem (existence of a Minkowski unit).** There is a unit $\varepsilon \in \mathcal{O}_K^\times$ such that the subgroup generated by its Galois conjugates
--   $$\langle \sigma(\varepsilon) \;:\; \sigma \in G \rangle \subseteq \mathcal{O}_K^\times$$
--   has finite index in $\mathcal{O}_K^\times$.
--
--   No hypothesis on the signature of $K$ is needed (it may be totally real, CM, or neither). Equivalently, $\mathbb{Q}\otimes_{\mathbb{Z}} \mathcal{O}_K^\times$ is a cyclic $\mathbb{Q}[G]$-module, generated by $1\otimes\varepsilon$; this is the classical starting point for the Galois-module approach to Leopoldt's conjecture (Ax, Brumer).
--
--   In the formal statement, $\sigma(\varepsilon)$ is `Units.map (RingOfIntegers.mapRingEquiv σ.toRingEquiv) ε`, the image of $\varepsilon$ under the restriction of $\sigma : K \simeq_{\mathbb{Q}} K$ to $\mathcal{O}_K$, and finite index is `Subgroup.FiniteIndex`.
-- source:
--   L. C. Washington, Introduction to Cyclotomic Fields (2nd ed., GTM 83), Lemma 5.27 (existence of a Minkowski unit); see also J. Neukirch, Algebraic Number Theory, Ch. I §7 (Dirichlet unit theorem).

import Mathlib.NumberTheory.NumberField.Units.Regulator
import Mathlib.NumberTheory.NumberField.InfinitePlace.Ramification
open NumberField

namespace NumberField.Units
theorem exists_minkowskiUnit (K : Type*) [Field K] [NumberField K] [IsGalois ℚ K] :
    ∃ ε : (𝓞 K)ˣ, (Subgroup.closure (Set.range fun σ : K ≃ₐ[ℚ] K =>
      _root_.Units.map (RingOfIntegers.mapRingEquiv σ.toRingEquiv).toMonoidHom ε)).FiniteIndex := by sorry
end NumberField.Units
