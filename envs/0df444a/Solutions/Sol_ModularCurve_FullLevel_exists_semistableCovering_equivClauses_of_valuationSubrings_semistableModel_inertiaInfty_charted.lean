    (hpm : ∀ P Q, Q ∉ N → P ∈ disc Q → C.placeMap P = Q)
    {Q : Place (ResidueField A) Fbar} (hQ : Q ∉ N) :
    {P | P ∈ C.dom ∧ C.placeMap P = Q} = disc Q := by
  ext P
  constructor
  · rintro ⟨hP, hPQ⟩
    obtain ⟨Q', hQ', hP'⟩ := (hdom P).mp hP
