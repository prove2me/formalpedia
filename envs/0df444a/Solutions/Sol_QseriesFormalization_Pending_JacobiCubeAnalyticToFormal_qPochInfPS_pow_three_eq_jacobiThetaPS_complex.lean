theorem jacobiIdentity_pochhammer (q : ℂ) (hq : ‖q‖ < 1) :
    (eulerPentagonalInfiniteProduct q) ^ 3 =
      ∑' n : ℕ, ((-1) ^ n * (2 * (n : ℂ) + 1) * q ^ (n * (n + 1) / 2)) := by
  rw [show eulerPentagonalInfiniteProduct q = ∏' k : ℕ, (1 - q ^ (k + 1)) from rfl]
  exact jacobiIdentity q hq

