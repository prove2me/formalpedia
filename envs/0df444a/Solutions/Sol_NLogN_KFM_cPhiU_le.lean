  have eT : ∏ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n), NLogN.KFU.tP (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) j = IntMul.OpenAI.Glue.TP n := by
    rw [hD, ← Fin.prod_univ_eq_prod_range (fun j => NLogN.KFU.tP (D + 1) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) j) (D + 1)]
    rw [← NLogN.KFQ.prod_tBD hn hD]
