  unfold alphaG
  positivity

theorem alpha_sum (r : Fin 88) :
    ∑ c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 5 r),
      alphaG (n3 5) (m3 5) r c = 1 := by
  have hc := mme_released_recursive_stage_region5_counts
  have hq : ((n3 5 r : ℕ) : ℚ) ≠ 0 := by exact_mod_cast (hc.1 r).ne'
  unfold alphaG
  rw [← Finset.sum_div, ← Nat.cast_sum, hc.2 r]
  exact div_self hq

