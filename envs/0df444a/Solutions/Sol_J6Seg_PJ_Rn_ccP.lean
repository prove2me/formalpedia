theorem accR_bnd {g : ℕ → List ℤ} {V : ℤ} : ∀ k, (∀ i < k, ∀ x ∈ g i, |x| ≤ V) →
    ∀ x ∈ accR g k, |x| ≤ V
  | 0, _, x, hx => by simp [accR] at hx
  | k + 1, h, x, hx => by
    rw [accR, List.mem_append] at hx
    rcases hx with hx | hx
    · exact h k (by omega) x hx
    · exact accR_bnd k (fun i hi => h i (by omega)) x hx

theorem accR_length {g : ℕ → List ℤ} {m : ℕ} (hg : ∀ i, (g i).length = m) :
    ∀ k, (accR g k).length = k * m
