          (∀ (c : ↥(chartAlgFin A (↥K) j)) (hc : τ (c : ↥K) ∈ chartAlgFin A (↥K) j), c ∈ 𝔭 ↔ (⟨τ (c : ↥K), hc⟩ : ↥(chartAlgFin A (↥K) j)) ∈ 𝔭') →
