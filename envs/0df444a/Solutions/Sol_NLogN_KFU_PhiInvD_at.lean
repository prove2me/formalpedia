  rw [← mod_prefix_eq_sum]
  have h1 : k = k % Ppre s i + Ppre s i * (k / Ppre s i) := (Nat.mod_add_div k _).symm
  have h2 : ((k / Ppre s i : ℕ) : ZMod (s i)) = ((IntMul.OpenAI.RCRT.digit s k i : ℕ) : ZMod (s i)) := by
    rw [IntMul.OpenAI.RCRT.digit, ZMod.natCast_mod]
  conv_lhs => rw [h1]
