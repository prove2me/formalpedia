  haveI : Fintype ↥(Submodule.torsionBy ℤ (JZero p) ((ℓ : ℤ) ^ k)) := Fintype.ofFinite _

  have hredk : ∀ x : ↥(Submodule.torsionBy ℤ (JZero p) ((ℓ : ℤ) ^ k)),
