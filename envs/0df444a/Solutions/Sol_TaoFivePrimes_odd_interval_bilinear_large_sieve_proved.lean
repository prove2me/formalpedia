    _ = Real.sqrt ((n1 - n0) / 2 + 1 / delta) *
        Real.sqrt ((m1 - m0) / (2 * M) + 1) *
          Real.sqrt (∑ n ∈ I, ‖A n‖ ^ 2) *
            Real.sqrt (∑ m ∈ J, ‖B m‖ ^ 2) := by
