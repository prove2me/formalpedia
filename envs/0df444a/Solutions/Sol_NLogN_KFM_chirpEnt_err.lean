theorem vP_oneP (P : ℕ) : vP P (oneP P) = 1 := by
  simp [vP, oneP, NLogN.KFB.toC]

theorem prodF_err (P : ℕ) {e : ℝ} (he : 0 ≤ e) :
    ∀ (n : ℕ) (x : Fin n → GI) (X : Fin n → ℂ), (∀ i, ‖X i‖ ≤ 1) →
      (∀ i, ‖vP P (x i) - X i‖ ≤ e) → n * (2 * e + 2 * (2 : ℝ)⁻¹ ^ P) ≤ 1 →
      ‖vP P (prodF P n x) - ∏ i, X i‖ ≤ n * (2 * e + 2 * (2 : ℝ)⁻¹ ^ P)
  | 0, x, X, _, _, _ => by simp [prodF, vP_oneP]
  | n + 1, x, X, hX, hx, hs => by
    have hu : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ P := by positivity
    have hs' : (n : ℝ) * (2 * e + 2 * (2 : ℝ)⁻¹ ^ P) ≤ 1 := by
      push_cast at hs; nlinarith
    have ih := prodF_err P he n (fun i => x i.castSucc) (fun i => X i.castSucc) (fun i => hX _)
      (fun i => hx _) hs'
    have hP : ‖∏ i : Fin n, X i.castSucc‖ ≤ 1 := by
      rw [norm_prod]; exact Finset.prod_le_one (fun i _ => norm_nonneg _) (fun i _ => hX _)
    have st := step_err P _ _ _ _ hP (hX (Fin.last n)) ih hs' (hx (Fin.last n))
    rw [Fin.prod_univ_castSucc]
    simp only [prodF]
    refine st.trans (le_of_eq ?_)
    push_cast; ring

theorem norm_exp_phase (x : ℝ) (c : ℂ) (hc : c = (x : ℂ) * I) : ‖exp c‖ ≤ 1 := by
  rw [hc, Complex.norm_exp_ofReal_mul_I]

end

