variable {d : ℕ}

/-! ## Discs and bit bounds -/

theorem gC_zero : gC (0 : GI) = 0 := by simp [gC]

theorem zsz_of_disc {p : ℕ} {z : GI} (h : ‖gC z‖ ≤ 2 ^ p) :
    zsz z.1 ≤ p + 2 ∧ zsz z.2 ≤ p + 2 := by
  have h1 : |(gC z).re| ≤ 2 ^ p := (Complex.abs_re_le_norm _).trans h
  have h2 : |(gC z).im| ≤ 2 ^ p := (Complex.abs_im_le_norm _).trans h
  simp only [gC, add_re, intCast_re, mul_re, I_re, mul_zero, intCast_im, I_im, mul_one,
    sub_self, add_zero, add_im, mul_im, zero_add] at h1 h2
  have hp : (2 : ℝ) ^ p < 2 ^ (p + 2) := pow_lt_pow_right₀ (by norm_num) (by omega)
  constructor
  · apply zsz_le_of_lt
    have : ((z.1.natAbs : ℕ) : ℝ) < ((2 ^ (p + 2) : ℕ) : ℝ) := by
      rw [Nat.cast_natAbs]; push_cast
      have : |((z.1 : ℤ) : ℝ)| = ((|z.1| : ℤ) : ℝ) := by push_cast; rfl
      linarith [this]
    exact_mod_cast this
  · apply zsz_le_of_lt
    have : ((z.2.natAbs : ℕ) : ℝ) < ((2 ^ (p + 2) : ℕ) : ℝ) := by
      rw [Nat.cast_natAbs]; push_cast
      linarith
    exact_mod_cast this

theorem GB_of_disc {p : ℕ} {L : List GI} (h : DiscL p L) : KFB.GB (p + 2) L :=
  fun z hz => zsz_of_disc (h z hz)

