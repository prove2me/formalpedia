section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFW
open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {jL : Fin Pp} {rowC : IStmt HS Pp} {K r Z Zr H : ℕ}
theorem lvQ_all_aux {Kc : ℝ} (hRow : NLogN.KFW.RowU Isym tbl rowC Kc) (hKc : 0 ≤ Kc)
    (hj : tbl jL = NLogN.KFW.levC jL rowC)
    (hK6 : 6 ≤ K) (hr : 1 ≤ r) (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (hZZ : Z ≤ Zr) (hZr : Zr + 2 ≤ r)
    (hHZ : H + 1 < 2 ^ Z) : ∀ k, NLogN.KFW.LvQ Isym tbl jL rowC K r Z Zr H k (NLogN.KFW.cbW Kc K k) 
  | 0 => NLogN.KFW.lvQ_zero Kc (by omega) hr
  | k + 1 => NLogN.KFW.lvQ_succ hRow hKc hj hK6 hr hKZ hZZ hZr hHZ (lvQ_all_aux hRow hKc hj hK6 hr hKZ hZZ hZr hHZ k)

theorem solution {Kc : ℝ} (hRow : NLogN.KFW.RowU Isym tbl rowC Kc) (hKc : 0 ≤ Kc)
    (hj : tbl jL = NLogN.KFW.levC jL rowC)
    (hK6 : 6 ≤ K) (hr : 1 ≤ r) (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (hZZ : Z ≤ Zr) (hZr : Zr + 2 ≤ r)
    (hHZ : H + 1 < 2 ^ Z) : ∀ k, NLogN.KFW.LvQ Isym tbl jL rowC K r Z Zr H k (NLogN.KFW.cbW Kc K k) := by
  first
  | exact lvQ_all_aux
  | exact lvQ_all_aux hRow hKc hj hK6 hr hKZ hZZ hZr hHZ
  | (intros; apply lvQ_all_aux <;> assumption)
end
