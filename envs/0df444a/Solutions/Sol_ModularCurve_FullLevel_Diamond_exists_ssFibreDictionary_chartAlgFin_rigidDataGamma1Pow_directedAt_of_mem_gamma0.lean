theorem exists_primitiveRoot_mul {k : Type*} [Field k] (ι : k →+* ℂ) (q ℓ : ℕ) (hq : 0 < q) (hℓ : 0 < ℓ)
    (hcop : Nat.Coprime q ℓ) (ξ ζ : k) (hξ : IsPrimitiveRoot ξ q) (hζ : IsPrimitiveRoot ζ ℓ)
    (hι : ι ξ = Complex.exp (2 * Real.pi * Complex.I / q)) :
    ∃ ξ' : k, IsPrimitiveRoot ξ' (q * ℓ) ∧ ι ξ' = Complex.exp (2 * Real.pi * Complex.I / (q * ℓ)) ∧ ξ' ^ ℓ = ξ := by
  have hqℓ : q * ℓ ≠ 0 := Nat.mul_ne_zero hq.ne' hℓ.ne'
  obtain ⟨ω, hω⟩ : ∃ ω : k, IsPrimitiveRoot ω (q * ℓ) := by
    have h := IsPrimitiveRoot.pow_mul_pow_lcm hξ hζ hq.ne' hℓ.ne'
    rw [hcop.lcm_eq_mul] at h
    exact ⟨_, h⟩
  have hιω : IsPrimitiveRoot (ι ω) (q * ℓ) := hω.map_of_injective ι.injective
  haveI : NeZero (q * ℓ) := ⟨hqℓ⟩
  have hexp : IsPrimitiveRoot (Complex.exp (2 * Real.pi * Complex.I / ((q * ℓ : ℕ) : ℂ))) (q * ℓ) :=
    Complex.isPrimitiveRoot_exp (q * ℓ) hqℓ
  obtain ⟨i, hi, hieq⟩ := hιω.eq_pow_of_pow_eq_one hexp.pow_eq_one
  have hcast : ((q * ℓ : ℕ) : ℂ) = (q : ℂ) * (ℓ : ℂ) := by push_cast; rfl
  refine ⟨ω ^ i, ?_, ?_, ?_⟩
  · have hcop' : i.Coprime (q * ℓ) := by
      have h' : IsPrimitiveRoot ((ι ω) ^ i) (q * ℓ) := hieq ▸ hexp
      exact (hιω.pow_iff_coprime (Nat.pos_of_ne_zero hqℓ) i).mp h'
    exact hω.pow_of_coprime i hcop'
  · rw [map_pow, hieq, hcast]
  · apply ι.injective
    rw [map_pow, map_pow, hieq, hι, ← Complex.exp_nat_mul, hcast]
    congr 1
    have hq0 : (q : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
    have hℓ0 : (ℓ : ℂ) ≠ 0 := by exact_mod_cast hℓ.ne'
    field_simp

end DictRedH1

