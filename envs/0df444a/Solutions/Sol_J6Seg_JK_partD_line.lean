  have hB := mkBlocks_ok (s := s) (t := t) (lam := lam) h.hs w h.hw
  have hE : (0 : ℝ) ≤ 3 * lam + 3 := by positivity
  refine ⟨1 / 7 + (lam : ℝ) * (2 * w + 1) * (15 * ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) *
      (((lam : ℝ) + 1) * (3 * lam + 3) + 1) / 2 ^ P), ?_, ?_, ?_, ?_, ?_⟩
  · have := one_le_ddR (α := (α : ℝ)) (sigma_ge h.hs h.hst) (lam - 1)
    positivity
  · linarith
  · have hm : ((LJ s t lam w).length : ℝ) ≤ s := by exact_mod_cast LJ_length_le_s s t lam w
    rw [div_le_iff₀ hS]
    have : (((LJ s t lam w).length : ℝ) + 1) ^ 2 ≤ ((s : ℝ) + 1) ^ 2 :=
      pow_le_pow_left₀ (by positivity) (by linarith) 2
    linarith
  · intro i hi
    exact cap_row hB h.hs h.hst h.hα h.hx hT hE (fun i _ => mkBlocks_len h.hl w i) hG2 (LJ_lt (s := s) (t := t) (lam := lam) (w := w) hi)
  · intro i hi k _ hnb
    exact capI_band hB h.hs (fun i _ => mkBlocks_len h.hl w i) (LJ_lt (s := s) (t := t) (lam := lam) (w := w) hi) hnb

end reg

