  intro ⟨k, hk⟩ ⟨m, hm⟩ he
  simp only [length_permIdx] at hk hm
  simp only [getElem_permIdx] at he
  rw [List.getD_eq_getElem _ _ (by rw [hl]; exact o.idx_lt h (by omega)),
    List.getD_eq_getElem _ _ (by rw [hl]; exact o.idx_lt h (by omega))] at he
