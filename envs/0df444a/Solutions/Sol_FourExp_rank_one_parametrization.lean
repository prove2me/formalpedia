/-- If everything in `T` is algebraic over a subalgebra `B` of transcendence degree at most one,
then so is the algebra generated by `T`. -/
lemma trdeg_adjoin_tower (B : Subalgebra ℚ ℂ) (T : Set ℂ) (hB : Algebra.trdeg ℚ ↥B ≤ 1)
    (halg : ∀ x ∈ T, IsAlgebraic ↥B x) :
    Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ T) ≤ 1 := by
  have hCalg : Algebra.IsAlgebraic ↥B ↥(Algebra.adjoin ↥B T) := by
    rw [← Subalgebra.isAlgebraic_iff, Algebra.isAlgebraic_adjoin_iff]
    exact halg
  have hsum : Algebra.trdeg ℚ ↥B + Algebra.trdeg ↥B ↥(Algebra.adjoin ↥B T)
      = Algebra.trdeg ℚ ↥(Algebra.adjoin ↥B T) := trdeg_add_eq ℚ ↥B
  rw [show Algebra.trdeg ↥B ↥(Algebra.adjoin ↥B T) = 0 from trdeg_eq_zero, add_zero] at hsum
  have hle : Algebra.adjoin ℚ T ≤ (Algebra.adjoin ↥B T).restrictScalars ℚ :=
    Algebra.adjoin_le fun x hx => Algebra.subset_adjoin hx
  refine (trdeg_le_of_injective (Subalgebra.inclusion hle)
    (Subalgebra.inclusion_injective hle)).trans ?_
  show Algebra.trdeg ℚ ↥(Algebra.adjoin ↥B T) ≤ 1
  rw [← hsum]
  exact hB

end FourExpRank

theorem solution :
    ∀ l₁₁ l₁₂ l₂₁ l₂₂ : ℂ,
      IsAlgebraic ℚ (Complex.exp l₁₁) → IsAlgebraic ℚ (Complex.exp l₁₂) →
      IsAlgebraic ℚ (Complex.exp l₂₁) → IsAlgebraic ℚ (Complex.exp l₂₂) →
      l₁₁ ≠ 0 → l₁₂ ≠ 0 → l₂₁ ≠ 0 → l₂₂ ≠ 0 →
      l₁₁ * l₂₂ = l₁₂ * l₂₁ →
      Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) ≤ 1 →
      ¬ (∃ a b : ℚ, ¬(a = 0 ∧ b = 0) ∧
          (a : ℂ) * l₁₁ + (b : ℂ) * l₂₁ = 0 ∧ (a : ℂ) * l₁₂ + (b : ℂ) * l₂₂ = 0) →
      ¬ (∃ a b : ℚ, ¬(a = 0 ∧ b = 0) ∧
          (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = 0 ∧ (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = 0) →
      ∃ x₁ x₂ y₁ y₂ : ℂ, LinearIndependent ℚ ![x₁, x₂] ∧ LinearIndependent ℚ ![y₁, y₂] ∧
        (∀ i j : Fin 2, IsAlgebraic ℚ (Complex.exp (![x₁, x₂] i * ![y₁, y₂] j))) ∧
        Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({x₁, x₂, y₁, y₂} : Set ℂ)) ≤ 1 := by
  intro l₁₁ l₁₂ l₂₁ l₂₂ he11 he12 he21 he22 h11 h12 h21 h22 hrank htr hcols hrows
  have ht12 : l₁₁ * (l₁₂ / l₁₁) = l₁₂ := by field_simp
  have ht22 : l₂₁ * (l₁₂ / l₁₁) = l₂₂ := by
    field_simp
    linear_combination -hrank

  refine ⟨l₁₁, l₂₁, 1, l₁₂ / l₁₁, ?_, ?_, ?_, ?_⟩
  · -- the first pair is independent over `ℚ`
    rw [LinearIndependent.pair_iff]
    intro a b hab
    by_contra hne
    refine hcols ⟨a, b, hne, ?_, ?_⟩
    · simpa [Rat.smul_def] using hab
    · have h : (a : ℂ) * l₁₁ + (b : ℂ) * l₂₁ = 0 := by simpa [Rat.smul_def] using hab
      have key : (a : ℂ) * l₁₂ + (b : ℂ) * l₂₂ = (l₁₂ / l₁₁) * ((a : ℂ) * l₁₁ + (b : ℂ) * l₂₁) := by
        field_simp
        linear_combination (b : ℂ) * hrank
      rw [key, h, mul_zero]
  · -- the second pair is independent over `ℚ`
    rw [LinearIndependent.pair_iff]
    intro a b hab
    simp only [Rat.smul_def, mul_one] at hab
    by_cases hb : b = 0
    · refine ⟨?_, hb⟩
      rw [hb] at hab
      simpa using hab
    · exfalso
      have hbc : (b : ℂ) ≠ 0 := by exact_mod_cast hb
      have hab' : (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = 0 := by
        have key : (a : ℂ) * l₁₁ + (b : ℂ) * l₁₂ = ((a : ℂ) + (b : ℂ) * (l₁₂ / l₁₁)) * l₁₁ := by
          field_simp
        rw [key, hab, zero_mul]
      have hab'' : (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = 0 := by
        have key : (a : ℂ) * l₂₁ + (b : ℂ) * l₂₂ = (l₂₁ / l₁₁) * ((a : ℂ) * l₁₁ + (b : ℂ) * l₁₂) := by
          field_simp
          linear_combination (b : ℂ) * hrank
        rw [key, hab', mul_zero]
      exact hrows ⟨a, b, fun hzero => hb hzero.2, hab', hab''⟩
  · -- the four exponentials
    intro i j
    fin_cases i <;> fin_cases j <;> simp [ht12, ht22]
    · exact he11
    · exact he12
    · exact he21
    · exact he22
  · -- transcendence degree
    have htalg : IsAlgebraic ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) (l₁₂ / l₁₁) := by
      refine ⟨Polynomial.C ⟨l₁₁, Algebra.subset_adjoin (by simp)⟩ * Polynomial.X
        - Polynomial.C ⟨l₁₂, Algebra.subset_adjoin (by simp)⟩, ?_, ?_⟩
      · intro hzero
        have hc := congrArg (fun p => Polynomial.coeff p 1) hzero
        simp [Polynomial.coeff_C] at hc
        exact h11 (by simpa using congrArg Subtype.val hc)
      · simp [Polynomial.aeval_def, Polynomial.eval₂_sub, Polynomial.eval₂_mul, ht12]
    refine FourExpRank.trdeg_adjoin_tower (Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)) _ htr ?_
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with h | h | h | h <;> rw [h]
    · exact isAlgebraic_algebraMap (⟨l₁₁, Algebra.subset_adjoin (by simp)⟩ :
        ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)))
    · exact isAlgebraic_algebraMap (⟨l₂₁, Algebra.subset_adjoin (by simp)⟩ :
        ↥(Algebra.adjoin ℚ ({l₁₁, l₁₂, l₂₁, l₂₂} : Set ℂ)))
    · exact isAlgebraic_one
    · exact htalg

