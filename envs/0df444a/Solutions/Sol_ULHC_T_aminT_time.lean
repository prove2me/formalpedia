variable {α : Type} [DecidableEq α]
namespace ULHC.T
theorem _root_.solution {γ β : Type} (f : γ → TimeM (Option (ℕ × β))) : ∀ l : List γ,
    (aminT f l).time = (l.map fun y => (f y).time + 1).sum + 1
  | [] => by simp [aminT]
  | y :: ys => by
    simp only [aminT, time_bind, time_tick, time_pure, List.map_cons, List.sum_cons, solution f ys]
    omega
end ULHC.T
