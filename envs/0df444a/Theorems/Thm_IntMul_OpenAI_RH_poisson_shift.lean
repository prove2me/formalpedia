open IntMul IntMul.OpenAI IntMul.OpenAI.RH
open Complex Real

theorem IntMul.OpenAI.RH.poisson_shift (α : ℝ) (hα : 0 < α) (s : ℝ) (hs : 0 < s) (x ρ : ℝ) :
    ∑' j : ℤ, ((Real.exp (-π * α⁻¹ ^ 2 * s ^ 2 * (x - j / s) ^ 2) : ℝ) : ℂ) *
        cexp (2 * π * I * ρ * j / s)
      = α * ∑' n : ℤ, ((Real.exp (-π * α ^ 2 * (n - ρ / s) ^ 2) : ℝ) : ℂ) *
        cexp (-2 * π * I * s * x * (n - ρ / s)) := by sorry
