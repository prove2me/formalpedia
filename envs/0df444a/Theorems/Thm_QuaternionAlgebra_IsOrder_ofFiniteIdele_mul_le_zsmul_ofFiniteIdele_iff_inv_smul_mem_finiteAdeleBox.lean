    (x g : (ℍ[ℚ, a, b] ⊗[ℚ] IsDedekindDomain.FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) (n : ℕ) [NeZero n] :
    Submodule.ofFiniteIdele Λ (x * g) ≤ ((n : ℕ) : ℤ) • Submodule.ofFiniteIdele Λ x ↔
      (n : ℚ)⁻¹ • ((g : (ℍ[ℚ, a, b] ⊗[ℚ] IsDedekindDomain.FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : (ℍ[ℚ, a, b] ⊗[ℚ] IsDedekindDomain.FiniteAdeleRing (𝓞 ℚ) ℚ)) ∈ Submodule.finiteAdeleBox Λ := by sorry
