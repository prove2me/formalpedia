/-!
# KFV §59: cost of the Kronecker stage, the shuttles and the scaling

* `cRec_le`: one record product costs `≤ 10^8 (r+1)(b+Δ+p+10) + 4 φ`;
* **`cKronS_le`**: the Kronecker stage costs `≤ 10^14 (p+3) X + 8000 N φ + 10^9 (BK+2)^2`;
* `cShut_le`, `cScale_le`: `≤ 10^6 (B+2) X + 10^9 (B+2)^2`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT

theorem zsz2_le (r : ℕ) : zsz ((2 * r : ℕ) : ℤ) ≤ 2 * r + 2 :=
  le_trans (zsz_natCast_le_self' _) (by omega)

theorem cPack_le (r w b : ℕ) :
    cPack r w b (b * r + 2) ≤ 10 ^ 6 * (r + 1) * (w + b + 10) := by
  unfold cPack cLp
  have h := KFT.cCar_le b w r
  nlinarith

theorem cExt_le (esz r b Δ : ℕ) (he : esz ≤ 4) :
    cExt esz r b Δ (b * (2 * r) + 2) (zsz ((2 * r : ℕ) : ℤ)) ≤
      10 ^ 7 * (r + 1) * (b + Δ + 10) := by
  unfold cExt cLp
  have h := KFT.cDig_le b 0 (2 * r) (2 * r)
  have hz := zsz2_le r
  nlinarith

theorem cRec_le (r p b Δ φ : ℕ) :
    cRec r p b Δ φ ≤ 10 ^ 8 * (r + 1) * (b + Δ + p + 10) + 4 * φ := by
  unfold cRec cLp
  have h1 := cPack_le r (p + 2) b
  have h2 := cExt_le 4 r b Δ (by norm_num)
  have h3 := cExt_le 3 r b Δ (by norm_num)
  have hz := zsz2_le r
  nlinarith

end NLogN.KFV

end

