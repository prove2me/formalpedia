  intro R'' _ χ
  refine Iff.trans ?_ (range_comap_subset_preimage_iff ψ χ (C.U₄lin s h₁ h₂)).symm

  let A : Scheme.{0} := Limits.pullback (C.f (Spec.map (CommRingCat.ofHom ψ) ≫ s)) (Spec.map (CommRingCat.ofHom χ))
