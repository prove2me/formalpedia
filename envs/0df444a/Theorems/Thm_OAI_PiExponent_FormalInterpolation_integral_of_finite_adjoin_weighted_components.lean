-- title:
--   Finite adjoin makes coordinates integral
-- statement:
--   If the polynomial ring is finite as a module over the subalgebra generated by the degree-D weighted components, each coordinate is integral over that subalgebra. This separates the standard finite-module implication from the filtered-lifting argument.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.integral_of_finite_adjoin_weighted_components
    {d : Nat} (w : Fin d → Rat) (D : Nat) (m : Nat)
    (g : Fin m → MvPolynomial (Fin d) Complex)
    (hfinite : Module.Finite
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j))))
      (MvPolynomial (Fin d) Complex))
    (i : Fin d) :
    IsIntegral
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j))) :
        Subalgebra Complex (MvPolynomial (Fin d) Complex))
      (MvPolynomial.X i : MvPolynomial (Fin d) Complex) := by sorry
