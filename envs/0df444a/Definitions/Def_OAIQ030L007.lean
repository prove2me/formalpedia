def uCoefficient (c z T p : ℕ) : ℚ :=
  if z ≤ T then ∑ h ∈ Finset.range (p+1),
    (-1:ℚ)^(z-h) * (z.choose h) * ((T-z).choose (p-h)) * (c:ℚ)^(p-h) else 0

