-- Source module: Solutions.J6SegR6
/-!
# Segmented inverse (S2): the round-six regime

`r6_axis_hyps`: for every `P` with `P.Ok` there is `n₁` such that for `n ≥ n₁`, every admissible
source list (`SrcOK6`) and every axis `j < d`, the hypotheses of the segmented-inverse theorems
hold with `s = src j`, `t = tF6 j`, `α = αN6`:
`0 < s < t`, `2 ≤ α` and `α²θ = xθ s t α ≥ 3`.

Proof: `SrcOK6` forces the window `w_j = ⌊t/(8d²)⌋ ≥ 1`, so `t - s ≥ w_j ≥ t/(16d²)`; and
`α² ≥ 48 d²` as soon as `b' = b^{1+x} ≥ 3072 d³`, which holds for large `b` because
`d ≤ b^ε` and `3ε < 1 + x` (`Prm.Ok.three_eps`).
-/

open Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf IntMul.Kappa.R6

/-- Eventually `D₀ ≤ d` (since `d ≥ b^ε/2 ≥ √b/2`). -/
lemma eventually_d_ge (P : Prm) (hP : P.Ok) (D₀ : ℕ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → D₀ ≤ dP6 P n := by
  obtain ⟨n₁, hn₁⟩ := eventually_b_ge (4 + 4 * D₀ ^ 2)
  refine ⟨n₁, fun n hn => ?_⟩
  have hb := hn₁ n hn
  have hb4 : 4 ≤ bP6 n := by omega
  have h1 := d_half P hP hb4
  have hB : ((4 + 4 * D₀ ^ 2 : ℕ) : ℝ) ≤ bP6 n := by exact_mod_cast hb
  have hB1 : (1 : ℝ) ≤ bP6 n := by push_cast at hB; nlinarith
  have h2 : (bP6 n : ℝ) ^ ((1 : ℝ) / 2) ≤ (bP6 n : ℝ) ^ P.ε :=
    Real.rpow_le_rpow_of_exponent_le hB1 hP.eps_ge
  have h3 : ((bP6 n : ℝ) ^ ((1 : ℝ) / 2)) ^ 2 = bP6 n := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by linarith)]; norm_num
  have h4 : (2 * D₀ : ℝ) ≤ (bP6 n : ℝ) ^ ((1 : ℝ) / 2) := by
    have h0 : (0 : ℝ) ≤ (bP6 n : ℝ) ^ ((1 : ℝ) / 2) := by positivity
    push_cast at hB
    nlinarith
  have : (D₀ : ℝ) ≤ dP6 P n := by linarith
  exact_mod_cast this

/-- The extra regime facts used by the fitted parameters: `3 d² (t - s) ≤ s` (`θ ≤ 1/(3d²)`),
`6 d² ≤ s`, `48 d α² ≤ p`, `2 ≤ d`. -/
theorem r6_axis_fit (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ j < dP6 P n,
      3 * dP6 P n ^ 2 * (tF6 P n j - src j) ≤ src j ∧ 6 * dP6 P n ^ 2 ≤ src j ∧
      48 * dP6 P n * αN6 P n ^ 2 ≤ pP6 P n ∧ 2 ≤ dP6 P n := by
  obtain ⟨n₁, hn₁⟩ := eventually_d_ge P hP 2
  refine ⟨n₁, fun n hn src hsrc j hj => ?_⟩
  have hd2 := hn₁ n hn
  set d := dP6 P n
  have hlo := hsrc.lo j hj
  have hhi := hsrc.hi j hj
  set t := tF6 P n j
  set w := wnd6 P n j
  have hwdef : w = t / (8 * d ^ 2) := rfl
  have hw1 : 1 ≤ w := by omega
  have hwt : 8 * d ^ 2 * w ≤ t := by rw [hwdef]; exact Nat.mul_div_le t _
  have hd2' : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ (by omega)
  have e : 8 * d ^ 2 * w = 8 * (d ^ 2 * w) := by ring
  have h1 : d ^ 2 * 1 ≤ d ^ 2 * w := Nat.mul_le_mul_left _ hw1
  have h2 : 1 * w ≤ d ^ 2 * w := Nat.mul_le_mul_right w hd2'
  have hts : t - src j ≤ 2 * w := by omega
  have h3 : 3 * d ^ 2 * (t - src j) ≤ 3 * d ^ 2 * (2 * w) := Nat.mul_le_mul_left _ hts
  have e3 : 3 * d ^ 2 * (2 * w) = 6 * (d ^ 2 * w) := by ring
  have hsX : 6 * (d ^ 2 * w) ≤ src j := by
    rw [e] at hwt
    generalize d ^ 2 * w = X at hwt h1 h2
    omega
  refine ⟨by omega, by omega, ?_, hd2⟩
  have ha : αN6 P n ^ 2 ≤ α2P6 P n := Nat.sqrt_le' _
  have hb : 48 * d * α2P6 P n ≤ 6 * b'P6 P n := by
    have := Nat.div_mul_le_self (6 * b'P6 P n) (48 * d)
    have e2 : α2P6 P n = 6 * b'P6 P n / (48 * d) := rfl
    rw [e2]; linarith
  have e4 : pP6 P n = 6 * b'P6 P n := rfl
  have : 48 * d * αN6 P n ^ 2 ≤ 48 * d * α2P6 P n := Nat.mul_le_mul_left _ ha
  omega

end J6Seg

end

section
-- Source module: Solutions.J6SegLine
/-!
# Segmented inverse (S2): the `B₀` line maps of `LineNeed6` (math side)

`r6_axisMaps_seg`: in the round-six regime (`n ≥ n₁`, every `SrcOK6` source list, `d = D + 1`)
there are per-axis exact maps `M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D)` (the structure
of `R6Ifaces`, unchanged) such that on every axis `i` the **segmented** fixed-point procedure

  `B0seg p (segP p d s_i) 0 1 (6d) s_i t_i α`   (`λ = 1`, `R = 0`, `w = 6d`)

approximates `2^p M.B i` within `9` units of `2^{-p}` (`p = pP6 P n`), and `Sapprox`
approximates `2^p M.A i` within the base bound `6 sWidth p α + 4`. The `9` is far inside the
interface budget `errW6 P n · 2^{-p} = 2^{⌊p/2⌋ - p}`.

The machine side (`IRuns` of the B₀ line procedure, `RepFull`/`RepPad`, the tensor layout, the
cost row) is not addressed here.
-/

open Complex Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.P47 IntMul.Kappa.R6

lemma tF6_coprime (P : Prm) (n j s : ℕ) (hs : Odd s) : Nat.Coprime s (tF6 P n j) := by
  have h2 : Nat.Coprime s 2 := Nat.coprime_two_right.2 hs
  unfold tF6
  split_ifs
  · rw [← pow_succ]; exact Nat.Coprime.pow_right _ h2
  · exact Nat.Coprime.pow_right _ h2

/-- **The segmented `B₀` lines in the round-six regime at the fitted (cost-row) parameters**
`λ = lamP d` (the power of two in `(dk/2, dk]`), `w = 7k` (`k = ⌊√d⌋ + 1`), `R = ⌊p/7⌋`,
`P = segPF p d s`; moreover `‖B_i‖ ≤ 1/2` and `B₀` sends the zero line to zero. -/
theorem r6_axisMaps_fit_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
    ∃ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D), ∀ i : Fin (D + 1), ‖M.B i‖ ≤ 1 / 2 ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ k, ‖toC (U k)‖ ≤ 2 ^ pP6 P n) → ∀ k : ZMod (tD6 P n D i),
        ‖toC (Sapprox (pP6 P n) (sD6 src D i) (tD6 P n D i) (αN6 P n) U k.val) -
          2 ^ pP6 P n * M.A i (fun j => toC (U j.val) / 2 ^ pP6 P n) k‖
          ≤ 6 * sWidth (pP6 P n) (αN6 P n) + 4) ∧
      (∀ W : ℕ → ℤ × ℤ, (∀ k, ‖toC (W k)‖ ≤ 2 ^ pP6 P n) → ∀ l : ZMod (sD6 src D i),
        ‖toC (B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i)) (pP6 P n / 7)
            (lamP (dP6 P n)) (wF (dP6 P n))
            (sD6 src D i) (tD6 P n D i) (αN6 P n) W l.val) -
          2 ^ pP6 P n * M.B i (fun k => toC (W k.val) / 2 ^ pP6 P n) l‖ ≤ 9) ∧
      B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i)) (pP6 P n / 7)
        (lamP (dP6 P n)) (wF (dP6 P n)) (sD6 src D i) (tD6 P n D i) (αN6 P n)
        (fun _ => (0, 0)) = fun _ => (0, 0) := by
  obtain ⟨n₁, h⟩ := r6_axis_nat P hP
  obtain ⟨n₂, h'⟩ := r6_axis_fit P hP
  refine ⟨max n₁ n₂, fun n hn src hsrc D hD _ _ => ?_⟩
  have hn1 : n₁ ≤ n := le_of_max_le_left hn
  have hn2 : n₂ ≤ n := le_of_max_le_right hn
  have hax : ∀ i : Fin (D + 1), ∃ (A : (ZMod (sD6 src D i) → ℂ) →L[ℂ] (ZMod (tD6 P n D i) → ℂ))
      (B₀ : (ZMod (tD6 P n D i) → ℂ) →L[ℂ] (ZMod (sD6 src D i) → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 / 2 ∧
      (∀ u, IntMul.OpenAI.RH.permS (sD6 src D i) (tD6 P n D i)
          (((sD6 src D i : ℕ) : ℂ)⁻¹ • ZMod.dft u) =
        (2 : ℂ) ^ (2 * αN6 P n ^ 2) • B₀ (IntMul.OpenAI.RH.permT (sD6 src D i) (tD6 P n D i)
          (((tD6 P n D i : ℕ) : ℂ)⁻¹ • ZMod.dft (A u)))) ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ k, ‖toC (U k)‖ ≤ 2 ^ pP6 P n) → ∀ k : ZMod (tD6 P n D i),
        ‖toC (Sapprox (pP6 P n) (sD6 src D i) (tD6 P n D i) (αN6 P n) U k.val) -
          2 ^ pP6 P n * A (fun j => toC (U j.val) / 2 ^ pP6 P n) k‖
          ≤ 6 * sWidth (pP6 P n) (αN6 P n) + 4) ∧
      (∀ W : ℕ → ℤ × ℤ, (∀ k, ‖toC (W k)‖ ≤ 2 ^ pP6 P n) → ∀ l : ZMod (sD6 src D i),
        ‖toC (B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i)) (pP6 P n / 7)
            (lamP (dP6 P n)) (wF (dP6 P n))
            (sD6 src D i) (tD6 P n D i) (αN6 P n) W l.val) -
          2 ^ pP6 P n * B₀ (fun k => toC (W k.val) / 2 ^ pP6 P n) l‖ ≤ 9) ∧
      B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i)) (pP6 P n / 7)
        (lamP (dP6 P n)) (wF (dP6 P n)) (sD6 src D i) (tD6 P n D i) (αN6 P n)
        (fun _ => (0, 0)) = fun _ => (0, 0) := by
    intro i
    have hi : i.val < dP6 P n := by rw [hD]; exact i.isLt
    obtain ⟨hs0, hst, hα2, hkey, -, hαd, hαp, hpα, hb', hd1⟩ := h n hn1 src hsrc i.val hi
    obtain ⟨hθ, h6d, h48d, hd2⟩ := h' n hn2 src hsrc i.val hi
    have h48 : 48 ≤ αN6 P n ^ 2 := by
      have : 48 * 1 ≤ 48 * dP6 P n ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow _ _ hd1)
      omega
    have hp : 100 ≤ pP6 P n := by
      have e : pP6 P n = 6 * b'P6 P n := rfl
      omega
    exact lemma19_seg_fit (pP6 P n) (dP6 P n) (sD6 src D i) (tD6 P n D i) (αN6 P n)
      (lamP (dP6 P n)) hst (tF6_coprime P n i.val _ (hsrc.odd i.val hi)) hα2 hαp hkey hd2 h6d h48
      hpα hθ h48d hp (lamP_pos _) (lamP_le _ hd1)
  choose A B hA hB hid hS hB0 hZ using hax
  exact ⟨⟨A, B, hA, fun i => (hB i).trans (by norm_num), hid⟩,
    fun i => ⟨hB i, hS i, hB0 i, hZ i⟩⟩

end J6Seg

end

theorem solution : type_of% @J6Seg.r6_axisMaps_fit_sol_aux := @J6Seg.r6_axisMaps_fit_sol_aux
