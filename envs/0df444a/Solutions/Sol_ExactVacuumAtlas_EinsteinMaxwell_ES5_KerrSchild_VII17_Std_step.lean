theorem zder : ∀ᶠ x in 𝓝[>] (0:ℝ),
    zrhsE h Q J x (F x) (b x) (Vf A x) (Wf b A x) = deriv (Zf h F) x := by
  filter_upwards [ev_ne, S.eF, S.eb, ev_u h, S.cF, S.hPF, S.hPC] with x hx hF hb hu cF hPF hPC
