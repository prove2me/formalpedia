  have ht : t ∈ Algebra.adjoin ℤ_[p] (Set.range op) := by rw [hgen]; exact Algebra.mem_top
  induction ht using Algebra.adjoin_induction with
  | mem t ht =>
      obtain ⟨g, rfl⟩ := ht
      have hψ : smulEnd p (op g) = ModularCurve.tateGenOpH M H S p g :=
        LinearMap.ext fun v => hop g v
      rw [hψ]
      cases g with
      | T ℓ hℓ hℓS hℓM => exact hB1 ℓ hℓ
      | U q hq hqM => exact hB1 q hq
      | dia d => exact hB2 d
  | algebraMap r =>
      rw [smulEnd_algebraMap]
      exact isSelfAdj_smul B r (isSelfAdj_one B)
  | add s u hs hu ihs ihu =>
      rw [smulEnd_add]
      exact isSelfAdj_add B ihs ihu
  | mul s u hs hu ihs ihu =>
      rw [smulEnd_mul]
      exact isSelfAdj_mul_of_commute B ihs ihu (by rw [← smulEnd_mul, ← smulEnd_mul, mul_comm])

end MR.H3
