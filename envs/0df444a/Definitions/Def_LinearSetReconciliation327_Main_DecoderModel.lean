abbrev tbl (d a : Fin 16) : List Instr := [iTbl d a]

/-- The body of one machine step: exactly the per-instruction branch of `step`. -/
def execInstr (i : Instr) (E : RAMEnv) (s : RAMState) : RAMState :=
  let wr (d : Fin 16) (v : ℕ) : RAMState :=
    { s with pc := s.pc + 1, regs := Function.update s.regs d (v % 2 ^ E.W) }
  let r := s.regs
  match i with
  | .halt => s
  | .imm d v => wr d v
  | .add d a b => wr d (r a + r b)
  | .sub d a b => wr d (r a + 2 ^ E.W - r b)
  | .mul d a b => wr d (r a * r b)
  | .div d a b => wr d (r a / r b)
  | .mod d a b => wr d (r a % r b)
  | .band d a b => wr d (r a &&& r b)
  | .bor d a b => wr d (r a ||| r b)
  | .bxor d a b => wr d (r a ^^^ r b)
  | .shl d a b => wr d (r a * 2 ^ r b)
  | .shr d a b => wr d (r a / 2 ^ r b)
  | .lt d a b => wr d (if r a < r b then 1 else 0)
  | .load d a => wr d (s.mem (r a))
  | .store a v => { s with pc := s.pc + 1, mem := Function.update s.mem (r a) (r v) }
  | .jz c t => { s with pc := if r c = 0 then t else s.pc + 1 }
  | .jmp t => { s with pc := t }
  | .qDet d a => wr d (E.det (r a))
  | .qPerm d k a => wr d (E.perm (r k) (r a))
  | .qPermInv d k a => wr d (E.permInv (r k) (r a))
  | .qCoeff d k a => wr d (E.coeff (r k) (r a))

/-- An instruction that neither jumps nor halts. -/
def Instr.NoBranchI (i : Instr) : Prop :=
  (∀ t, i ≠ .jmp t) ∧ (∀ d t, i ≠ .jz d t) ∧ i ≠ .halt

/-- A chunk is straight-line when it has no `jmp`, no `jz` and no `halt`. -/
def NoBranch : List Instr → Prop
  | [] => True
  | i :: c => i.NoBranchI ∧ NoBranch c

/-- Run a jump-free block of instructions. -/
def runBlock (code : List Instr) (E : RAMEnv) (s : RAMState) : RAMState :=
  code.foldl (fun acc i => execInstr i E acc) s

/-- `At P a l`: the instructions of `l` occupy the consecutive addresses `a, a+1, …, a+l.length-1`
of `P`. -/
def At (P : Program) (a : ℕ) (l : List Instr) : Prop :=
  ∀ r, r < l.length → P[a + r]? = l[r]?

/-- A test on the machine's registers. -/
inductive Cond where
  /-- Holds iff `r ≠ 0`. -/
  | neqz (r : Fin 16)
  /-- Holds iff `a < b`, materialised as `d := (a < b)`. -/
  | lt (d a b : Fin 16)

/-- The straight-line code that materialises a test. -/
def Cond.code : Cond → List Instr
  | .neqz _ => []
  | .lt d a b => [iLt d a b]

/-- The register whose being zero means that the test fails. -/
def Cond.test : Cond → Fin 16
  | .neqz r => r
  | .lt d _ _ => d

/-- A statement of the programming language. -/
inductive Stmt where
  /-- A straight-line chunk. -/
  | code (l : List Instr)
  /-- `a` then `b`. -/
  | seq (a b : Stmt)
  /-- If the test holds then `a`, else `b`. -/
  | ite (c : Cond) (a b : Stmt)
  /-- While the test holds, `b`. -/
  | loop (c : Cond) (b : Stmt)

/-- The number of instructions a statement compiles to. -/
def Stmt.len : Stmt → ℕ
  | .code l => l.length
  | .seq a b => a.len + b.len
  | .ite c a b => c.code.length + a.len + b.len + 3
  | .loop c b => c.code.length + b.len + 2

/-- Compile a statement at the absolute address `base`: every jump target is computed here, once. -/
def Stmt.compile : Stmt → ℕ → Program
  | .code l, _ => l
  | .seq a b, base => a.compile base ++ b.compile (base + a.len)
  | .ite c a b, base =>
      c.code ++ [iJz c.test (base + c.code.length + a.len + 2)] ++ a.compile (base + c.code.length + 1) ++
        [iJmp (base + c.code.length + a.len + b.len + 3)] ++ b.compile (base + c.code.length + a.len + 2) ++
        [iJmp (base + c.code.length + a.len + b.len + 3)]
  | .loop c b, base =>
      c.code ++ [iJz c.test (base + c.code.length + b.len + 2)] ++ b.compile (base + c.code.length + 1) ++
        [iJmp base]

/-- `Sem P E a b s Q`: from the state `s`, whose program counter is `a`, the machine reaches a state
whose program counter is `b`, in `k` steps, and `Q k` holds of that state.  The cost is the first
argument of `Q`, so a time bound is part of the postcondition. -/
def Sem (P : Program) (E : RAMEnv) (a b : ℕ) (s : RAMState) (Q : ℕ → RAMState → Prop) : Prop :=
  s.pc = a ∧ ∃ (k : ℕ) (s' : RAMState), (step P E)^[k] s = s' ∧ s'.pc = b ∧ Q k s'

section Enc

variable {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}

/-- The integer whose `k`-th bit is the `k`-th coordinate of `z` in the basis `b`.  This is the form
in which the word-RAM stores a field element: one `w`-bit field of a word. -/
noncomputable def enc (b : Module.Basis (Fin w) (ZMod 2) F) (z : F) : ℕ :=
  ∑ k : Fin w, (b.repr z k).val * 2 ^ (k : ℕ)

/-- The field element spelled by the `w`-bit integer `a`; the machine side of `enc`. -/
noncomputable def dec (b : Module.Basis (Fin w) (ZMod 2) F) (a : ℕ) : F :=
  b.repr.symm
    (Finsupp.equivFunOnFinite.symm (fun k : Fin w => (((a / 2 ^ (k : ℕ)) % 2 : ℕ) : ZMod 2)))

end Enc

