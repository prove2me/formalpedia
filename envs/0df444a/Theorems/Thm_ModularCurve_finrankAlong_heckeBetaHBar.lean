open ModularCurve AlgebraicCurve

theorem ModularCurve.finrankAlong_heckeBetaHBar
    (L : Type*) [Field L] [Algebra ℚ L] (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (ℓ : ℕ) [Fact ℓ.Prime] :
    finrankAlong L (heckeBetaHBar L M H ℓ) = if ℓ ∣ M then ℓ else ℓ + 1 := by sorry
