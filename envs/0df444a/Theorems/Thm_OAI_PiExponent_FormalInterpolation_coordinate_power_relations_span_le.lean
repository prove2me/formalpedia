-- title:
--   Relations place the coordinate-power ideal inside the generated ideal
-- statement:
--   If each coordinate power is expressed as a finite linear combination of the polynomials `p`, the ideal generated by those powers is contained in the ideal generated by `p`.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.coordinate_power_relations_span_le (d m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ) (N : Fin d → Nat) (hpower : ∀ i, ∃ q : Fin m → MvPolynomial (Fin d) ℂ, (MvPolynomial.X i : MvPolynomial (Fin d) ℂ) ^ N i = ∑ j, q j * p j) : Ideal.span (Set.range (fun i : Fin d => (MvPolynomial.X i : MvPolynomial (Fin d) ℂ) ^ N i)) ≤ Ideal.span (Set.range p) := by sorry
