    (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) M.Fbar)
    (WT : ∀ ℓ : HeckeTower.AwayPrime q q', Fin 2 → SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ)) : Prop :=
  (∃ (hisoP : Fact (A.DecompositionIsometric ℚ))
         (vP : HeightOneSpectrum (𝓞 ℚ))
         (ιP : ℍ[ℚ, ad, bd] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A))
         (ρP : (ℍ[ℚ, ad, bd])ˣ →* PGL(2, ↥(ValuationSubring.ratClosure A)))
         (ϖP : Omega.PseudoUniformizer ↥(ValuationSubring.ratClosure A) A.valuation.Completion)
         (hdomP : IsDomain (Omega.HolRingOf ϖP ρP))
         (sP : HeckeTower.AwayPrime q q' → (ℍ[ℚ, ad, bd])ˣ)
         (sfP : HeckeTower.AwayPrime q q' → (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
         (ΓP : HeckeTower.Obj q q' → Subgroup (ℍ[ℚ, ad, bd])ˣ)
         (wP wbarP : HeckeTower.Obj q q' → (ℍ[ℚ, ad, bd])ˣ)
         (dIsoP : ↥(A.decompositionSubgroup ℚ) →* Omega.IsometricAut ↥(ValuationSubring.ratClosure A) A.valuation.Completion)
         (χP : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
         (ιMP : ∀ j : HeckeTower.Obj q q', 𝕋.objField j →+* FractionRing (Omega.HolRingOf ϖP ρP)),
        haveI := hisoP
        haveI := hdomP
        (((r : ℕ) : 𝓞 ℚ) ∈ vP.asIdeal) ∧
        (Function.Injective ιP) ∧
        (∀ x : (ℍ[ℚ, ad, bd])ˣ, ρP x = Matrix.ProjGenLinGroup.mk (Units.map (ιP : ℍ[ℚ, ad, bd] →* Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A)) x)) ∧
        (algebraMap ↥(ValuationSubring.ratClosure A) A.valuation.Completion ϖP.ϖ = ((r : AlgebraicClosure ℚ) : A.valuation.Completion)) ∧
        (∀ ℓ : HeckeTower.AwayPrime q q',
          (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
          Submodule.finiteAdeleEvalAt ℍ[ℚ, ad, bd] u (sfP ℓ : ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) =
          (sP ℓ : ℍ[ℚ, ad, bd]) ⊗ₜ[ℚ] (1 : u.adicCompletion ℚ)) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∈ u.asIdeal →
          Submodule.finiteAdeleEvalAt ℍ[ℚ, ad, bd] u (sfP ℓ : ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) = 1) ∧
          Submodule.finiteIdeleDiagonal ℍ[ℚ, ad, bd]
          (Units.map (algebraMap ℚ ℍ[ℚ, ad, bd]).toMonoidHom
          (Units.mk0 ((ℓ.1 : ℕ) : ℚ) (Nat.cast_ne_zero.mpr ℓ.1.prop.ne_zero))) * (sfP ℓ)⁻¹ ∈
          (if (ℓ.1 : ℕ) ∣ N then levelHeckeUSet Λd (meetOrder Rd nd) (ℓ.1 : ℕ)
          else primeHeckeSet (meetOrder Rd nd) (ℓ.1 : ℕ)) ∧
          nrd (sP ℓ : ℍ[ℚ, ad, bd]) = ((ℓ.1 : ℕ) : ℚ)) ∧
        (∀ x : (ℍ[ℚ, ad, bd])ˣ, x ∈ ΓP none ↔
          x ∈ CerednikDrinfeld.CosetGraph.awayUnits Rd vP ∧ Even (padicValRat r (nrd (x : ℍ[ℚ, ad, bd])))) ∧
        (∀ ℓ : HeckeTower.AwayPrime q q', ΓP (some ℓ) = ΓP none ⊓ (ΓP none).map (MulAut.conj (sP ℓ)).toMonoidHom) ∧
        ((wP none ∈ CerednikDrinfeld.CosetGraph.awayUnits Rd vP ∧ nrd (wP none : ℍ[ℚ, ad, bd]) = (r : ℚ)) ∧
          ∀ ℓ : HeckeTower.AwayPrime q q',
          wP (some ℓ) ∈ CerednikDrinfeld.CosetGraph.awayUnits (meetOrder Rd (sfP ℓ)) vP ∧ nrd (wP (some ℓ) : ℍ[ℚ, ad, bd]) = (r : ℚ)) ∧
        ((nrd (wbarP none : ℍ[ℚ, ad, bd]) = (r' : ℚ) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ vP → ((r' : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
          CosetGraph.toLoc u (wbarP none) ∈ Submodule.localBoxUnits Rd u) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ vP → ∀ x : CosetGraph.Loc ad bd u,
          ((((CosetGraph.toLoc u (wbarP none))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
          ((CosetGraph.toLoc u (wbarP none) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Rd u ↔
          x ∈ Submodule.localBox Rd u) ∧
          ((((CosetGraph.toLoc u (wbarP none))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
          ((CosetGraph.toLoc u (wbarP none) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Λd u ↔
          x ∈ Submodule.localBox Λd u))) ∧
          ∀ ℓ : HeckeTower.AwayPrime q q',
          (nrd (wbarP (some ℓ) : ℍ[ℚ, ad, bd]) = (r' : ℚ) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ vP → ((r' : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
          CosetGraph.toLoc u (wbarP (some ℓ)) ∈ Submodule.localBoxUnits (meetOrder Rd (sfP ℓ)) u) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ vP → ∀ x : CosetGraph.Loc ad bd u,
          ((((CosetGraph.toLoc u (wbarP (some ℓ)))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
          ((CosetGraph.toLoc u (wbarP (some ℓ)) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox (meetOrder Rd (sfP ℓ)) u ↔
          x ∈ Submodule.localBox (meetOrder Rd (sfP ℓ)) u) ∧
          ((((CosetGraph.toLoc u (wbarP (some ℓ)))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
          ((CosetGraph.toLoc u (wbarP (some ℓ)) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Λd u ↔
          x ∈ Submodule.localBox Λd u)))) ∧
        (∀ (τ : ↥(A.decompositionSubgroup ℚ)) (x : A.valuation.Completion), (dIsoP τ).toRingEquiv x = τ • x) ∧
        CerednikDrinfeld.DescentIntertwining r i i' A ρP ϖP ΓP wP wbarP sP dIsoP
          M.Fbar 𝕋 (M.gal.comp (A.decompositionSubgroup ℚ).subtype)
          (fun ℓ => (galT ℓ).comp (A.decompositionSubgroup ℚ).subtype) W WT χP ιMP)

def OmegaActionCard (N q q' r r' : ℕ) (i i' : Fin 2) [Fact r.Prime] [Fact r'.Prime] [NeZero N] [Fact q.Prime] [Fact q'.Prime]
    (A : ValuationSubring (AlgebraicClosure ℚ))
    {ad bd : ℚ} (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))] : Prop :=
  ∀ (FN : Type) [Field FN] [Algebra (AlgebraicClosure ℚ) FN] [IsCurveOver (AlgebraicClosure ℚ) FN]
    [Algebra.EssFiniteType (AlgebraicClosure ℚ) FN]
    (𝕋 : HeckeTower.TowerData q q' FN)
    (hfg : ∀ j : HeckeTower.Obj q q', ∃ x : 𝕋.objField j, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set (𝕋.objField j))) (𝕋.objField j))
    (galN : ↥(A.decompositionSubgroup ℚ) →* SemilinearAut (AlgebraicClosure ℚ) FN)
    (galT : ∀ ℓ : HeckeTower.AwayPrime q q', ↥(A.decompositionSubgroup ℚ) →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    (hgalN : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (a : AlgebraicClosure ℚ),
      SemilinearAut.baseAut (galN τ) a = (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a)
    (hgalT : ∀ ℓ (τ : ↥(A.decompositionSubgroup ℚ)) (a : AlgebraicClosure ℚ),
      SemilinearAut.baseAut (galT ℓ τ) a = (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a)
    (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) FN) (WT : ∀ ℓ : HeckeTower.AwayPrime q q', Fin 2 → SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    [hiso₂ : Fact (A.DecompositionIsometric ℚ)]
    (v₂ : HeightOneSpectrum (𝓞 ℚ)) (hv₂ : ((r : ℕ) : 𝓞 ℚ) ∈ v₂.asIdeal)
    (ι₂ : ℍ[ℚ, ad, bd] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A)) (hι₂ : Function.Injective ι₂)
    (ρ₂ : (ℍ[ℚ, ad, bd])ˣ →* PGL(2, ↥(ValuationSubring.ratClosure A)))
    (hρ₂ : ∀ x : (ℍ[ℚ, ad, bd])ˣ, ρ₂ x = Matrix.ProjGenLinGroup.mk (Units.map (ι₂ : ℍ[ℚ, ad, bd] →* Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A)) x))
    (ϖ₂ : Omega.PseudoUniformizer ↥(ValuationSubring.ratClosure A) A.valuation.Completion)
    (hϖ₂ : algebraMap ↥(ValuationSubring.ratClosure A) A.valuation.Completion ϖ₂.ϖ = ((r : AlgebraicClosure ℚ) : A.valuation.Completion))
    [hdom₂ : IsDomain (Omega.HolRingOf ϖ₂ ρ₂)]
    (s₂ : HeckeTower.AwayPrime q q' → (ℍ[ℚ, ad, bd])ˣ)
    (sf₂ : HeckeTower.AwayPrime q q' → (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hs₂ : ∀ ℓ : HeckeTower.AwayPrime q q',
      (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, ad, bd] u (sf₂ ℓ : ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) =
          (s₂ ℓ : ℍ[ℚ, ad, bd]) ⊗ₜ[ℚ] (1 : u.adicCompletion ℚ)) ∧
      (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∈ u.asIdeal →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, ad, bd] u (sf₂ ℓ : ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) = 1) ∧
      Submodule.finiteIdeleDiagonal ℍ[ℚ, ad, bd]
          (Units.map (algebraMap ℚ ℍ[ℚ, ad, bd]).toMonoidHom
            (Units.mk0 ((ℓ.1 : ℕ) : ℚ) (Nat.cast_ne_zero.mpr ℓ.1.prop.ne_zero))) * (sf₂ ℓ)⁻¹ ∈
        (if (ℓ.1 : ℕ) ∣ N then levelHeckeUSet Λd (meetOrder Rd nd) (ℓ.1 : ℕ)
          else primeHeckeSet (meetOrder Rd nd) (ℓ.1 : ℕ)) ∧
      nrd (s₂ ℓ : ℍ[ℚ, ad, bd]) = ((ℓ.1 : ℕ) : ℚ))
    (Γ₂ : HeckeTower.Obj q q' → Subgroup (ℍ[ℚ, ad, bd])ˣ)
    (hΓ₂0 : ∀ x : (ℍ[ℚ, ad, bd])ˣ, x ∈ Γ₂ none ↔
      x ∈ CerednikDrinfeld.CosetGraph.awayUnits Rd v₂ ∧ Even (padicValRat r (nrd (x : ℍ[ℚ, ad, bd]))))
    (hΓ₂ℓ : ∀ ℓ : HeckeTower.AwayPrime q q', Γ₂ (some ℓ) = Γ₂ none ⊓ (Γ₂ none).map (MulAut.conj (s₂ ℓ)).toMonoidHom)
    (w₂ wbar₂ : HeckeTower.Obj q q' → (ℍ[ℚ, ad, bd])ˣ)
    (hw₂ : (w₂ none ∈ CerednikDrinfeld.CosetGraph.awayUnits Rd v₂ ∧ nrd (w₂ none : ℍ[ℚ, ad, bd]) = (r : ℚ)) ∧
      ∀ ℓ : HeckeTower.AwayPrime q q',
        w₂ (some ℓ) ∈ CerednikDrinfeld.CosetGraph.awayUnits (meetOrder Rd (sf₂ ℓ)) v₂ ∧ nrd (w₂ (some ℓ) : ℍ[ℚ, ad, bd]) = (r : ℚ))
    (hwbar₂ :
      (nrd (wbar₂ none : ℍ[ℚ, ad, bd]) = (r' : ℚ) ∧
        (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ v₂ → ((r' : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
          CosetGraph.toLoc u (wbar₂ none) ∈ Submodule.localBoxUnits Rd u) ∧
        (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ v₂ → ∀ x : CosetGraph.Loc ad bd u,
          ((((CosetGraph.toLoc u (wbar₂ none))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
              ((CosetGraph.toLoc u (wbar₂ none) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Rd u ↔
            x ∈ Submodule.localBox Rd u) ∧
          ((((CosetGraph.toLoc u (wbar₂ none))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
              ((CosetGraph.toLoc u (wbar₂ none) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Λd u ↔
            x ∈ Submodule.localBox Λd u))) ∧
      ∀ ℓ : HeckeTower.AwayPrime q q',
        (nrd (wbar₂ (some ℓ) : ℍ[ℚ, ad, bd]) = (r' : ℚ) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ v₂ → ((r' : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
            CosetGraph.toLoc u (wbar₂ (some ℓ)) ∈ Submodule.localBoxUnits (meetOrder Rd (sf₂ ℓ)) u) ∧
          (∀ u : HeightOneSpectrum (𝓞 ℚ), u ≠ v₂ → ∀ x : CosetGraph.Loc ad bd u,
            ((((CosetGraph.toLoc u (wbar₂ (some ℓ)))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
                ((CosetGraph.toLoc u (wbar₂ (some ℓ)) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox (meetOrder Rd (sf₂ ℓ)) u ↔
              x ∈ Submodule.localBox (meetOrder Rd (sf₂ ℓ)) u) ∧
            ((((CosetGraph.toLoc u (wbar₂ (some ℓ)))⁻¹ : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) * x *
                ((CosetGraph.toLoc u (wbar₂ (some ℓ)) : (CosetGraph.Loc ad bd u)ˣ) : CosetGraph.Loc ad bd u) ∈ Submodule.localBox Λd u ↔
              x ∈ Submodule.localBox Λd u))))
    (dIso₂ : ↥(A.decompositionSubgroup ℚ) →* Omega.IsometricAut ↥(ValuationSubring.ratClosure A) A.valuation.Completion)
    (hdIso₂ : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (x : A.valuation.Completion), (dIso₂ τ).toRingEquiv x = τ • x)
    (χ₂ : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
    (ιM₂ : ∀ j : HeckeTower.Obj q q', 𝕋.objField j →+* FractionRing (Omega.HolRingOf ϖ₂ ρ₂))
    (hI : CerednikDrinfeld.DescentIntertwining r i i' A ρ₂ ϖ₂ Γ₂ w₂ wbar₂ s₂ dIso₂
      FN 𝕋 galN galT W WT χ₂ ιM₂),
    ∃ (S₂ : Type) (_ : Group S₂) (scalar₂ : S₂ →* ↥(A.decompositionSubgroup ℚ))
      (ιS₂ : ↥(A.decompositionSubgroup ℚ) →* S₂) (_ : ∀ τ, scalar₂ (ιS₂ τ) = τ)

      (σ₀₂ σ₁₂ : S₂)
      (χS₂ : S₂ →* Multiplicative (ZMod 2))

      (galF₂ : ∀ j : HeckeTower.Obj q q', S₂ →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j))

      (galFC₂ : ∀ j : HeckeTower.Obj q q',
        S₂ →* SemilinearAut A.valuation.Completion ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j)))

      (sgn₂ : S₂ →* ℤˣ),

      (∀ σ : S₂, ∃ (τ : ↥(A.decompositionSubgroup ℚ)) (u v : ℕ), σ = ιS₂ τ * σ₀₂ ^ u * σ₁₂ ^ v) ∧
      scalar₂ σ₀₂ = 1 ∧ scalar₂ σ₁₂ = 1 ∧ σ₀₂ * σ₀₂ = 1 ∧ σ₁₂ * σ₁₂ = 1 ∧
      σ₀₂ * σ₁₂ = σ₁₂ * σ₀₂ ∧ (∀ τ, ιS₂ τ * σ₀₂ = σ₀₂ * ιS₂ τ) ∧ (∀ τ, ιS₂ τ * σ₁₂ = σ₁₂ * ιS₂ τ) ∧

      (∀ (H : Type) [Group H] (f : ↥(A.decompositionSubgroup ℚ) →* H) (h₀ h₁ : H),
        h₀ * h₀ = 1 → h₁ * h₁ = 1 → h₀ * h₁ = h₁ * h₀ → (∀ τ, f τ * h₀ = h₀ * f τ) → (∀ τ, f τ * h₁ = h₁ * f τ) →
        ∃ F : S₂ →* H, (∀ τ, F (ιS₂ τ) = f τ) ∧ F σ₀₂ = h₀ ∧ F σ₁₂ = h₁) ∧

      (∀ j (σ : S₂) (a : AlgebraicClosure ℚ), SemilinearAut.baseAut (galF₂ j σ) a =
        ((scalar₂ σ : ↥(A.decompositionSubgroup ℚ)) : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a) ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ), galF₂ none (ιS₂ τ) = galN τ) ∧
      (∀ (ℓ : HeckeTower.AwayPrime q q') (τ : ↥(A.decompositionSubgroup ℚ)), galF₂ (some ℓ) (ιS₂ τ) = galT ℓ τ) ∧
      (∀ (α : HeckeTower.Arr q q') (σ : S₂) (x : 𝕋.objField (HeckeTower.cod α)),
        galF₂ (HeckeTower.dom α) σ • (show 𝕋.objField (HeckeTower.dom α) from 𝕋.φ α x) =
          (show 𝕋.objField (HeckeTower.dom α) from 𝕋.φ α (galF₂ (HeckeTower.cod α) σ • x))) ∧
      galF₂ none σ₀₂ = W i ∧ galF₂ none σ₁₂ = W i' ∧
      (∀ ℓ : HeckeTower.AwayPrime q q', galF₂ (some ℓ) σ₀₂ = WT ℓ i ∧ galF₂ (some ℓ) σ₁₂ = WT ℓ i') ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ), χS₂ (ιS₂ τ) = χ₂ τ) ∧ χS₂ σ₀₂ ≠ 1 ∧ χS₂ σ₁₂ = 1 ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ),
        (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ → χS₂ (ιS₂ τ) = 1) ∧
      (∀ φ : ↥(A.decompositionSubgroup ℚ),
        A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r → χS₂ (ιS₂ φ) ≠ 1) ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ), χS₂ (ιS₂ τ) = 1 ↔
        ∀ x : IsLocalRing.ResidueField ↥A, x ^ (r ^ 2) = x → τ • x = x) ∧

      (∀ j (σ : S₂) (c : A.valuation.Completion),
        SemilinearAut.baseAut (galFC₂ j σ) c = (scalar₂ σ) • c) ∧
      (∀ j (σ : S₂) (c : A.valuation.Completion),
        SemilinearAut.baseAut (galFC₂ j σ) c = (dIso₂ (scalar₂ σ)).toRingEquiv c) ∧
      (∀ j (c : A.valuation.Completion), SemilinearAut.baseAut (galFC₂ j σ₀₂) c = c) ∧
      (∀ j (c : A.valuation.Completion), SemilinearAut.baseAut (galFC₂ j σ₁₂) c = c) ∧
      (∀ j (σ : S₂) (x : 𝕋.objField j) (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))),
        (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = ιM₂ j x →
          ((galFC₂ j σ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = ιM₂ j (galF₂ j σ • x)) ∧
      (∀ j (τ : ↥(A.decompositionSubgroup ℚ)) (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))),
        ((galFC₂ j (ιS₂ τ) • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) =
          (if χ₂ τ = 1 then (1 : (ℍ[ℚ, ad, bd])ˣ) else w₂ j) •
            Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ (dIso₂ τ)) (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∧
      (∀ j (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))),
        ((galFC₂ j σ₀₂ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = (w₂ j) • (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∧
      (∀ j (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))),
        ((galFC₂ j σ₁₂ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = (wbar₂ j) • (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∧

      (∀ j (σ : S₂), ∃ (n : (ℍ[ℚ, ad, bd])ˣ) (t : Omega.IsometricAut ↥(ValuationSubring.ratClosure A) A.valuation.Completion),
        n ∈ Subgroup.normalizer ((Γ₂ j : Subgroup (ℍ[ℚ, ad, bd])ˣ) : Set (ℍ[ℚ, ad, bd])ˣ) ∧
        ∀ y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j)),
          ((galFC₂ j σ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) =
            n • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t) (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∧

      (∀ j (σ : S₂), ∃ n : (ℍ[ℚ, ad, bd])ˣ,
        n ∈ Subgroup.normalizer ((Γ₂ j : Subgroup (ℍ[ℚ, ad, bd])ˣ) : Set (ℍ[ℚ, ad, bd])ˣ) ∧ (sgn₂ σ = 1 ↔ Even (padicValRat r (nrd (n : ℍ[ℚ, ad, bd])))) ∧
        ∀ y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j)),
          ((galFC₂ j σ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) =
            n • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ (dIso₂ (scalar₂ σ))) (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ), χS₂ (ιS₂ τ) = 1 → sgn₂ (ιS₂ τ) = 1) ∧
      (∀ τ : ↥(A.decompositionSubgroup ℚ), χS₂ (ιS₂ τ) ≠ 1 → sgn₂ (ιS₂ τ) = sgn₂ σ₀₂) ∧
      sgn₂ σ₀₂ = -1 ∧ sgn₂ σ₁₂ = 1 ∧
      (∀ (α : HeckeTower.Arr q q') (σ : S₂)
        (φC : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ (HeckeTower.cod α))) →ₐ[A.valuation.Completion] ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ (HeckeTower.dom α)))),
        (∀ x, (φC x : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = (if α.2 = 0 then (1 : (ℍ[ℚ, ad, bd])ˣ) else s₂ α.1) • (x : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) →
        ∀ x, galFC₂ (HeckeTower.dom α) σ • φC x = φC (galFC₂ (HeckeTower.cod α) σ • x))

def MSLiteCard (N q q' r r' : ℕ) (i i' : Fin 2) [Fact r.Prime] [Fact r'.Prime] [NeZero N] [Fact q.Prime] [Fact q'.Prime]
    (A : ValuationSubring (AlgebraicClosure ℚ))
    {ad bd : ℚ} (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))] : Prop :=
  ∀ (FN : Type) [Field FN] [Algebra (AlgebraicClosure ℚ) FN] [IsCurveOver (AlgebraicClosure ℚ) FN]
    [Algebra.EssFiniteType (AlgebraicClosure ℚ) FN]
