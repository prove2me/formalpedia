-- Source module: Solutions.KFV50Base
/-!
# KFV §50: the base context of the Proposition 18 core

From the register frame `regs18 p ℓ K ts` (with `sT` overwritten by anything) we get the
contexts of the layout programs (`LRg`) and of the rounds (`PCtx`), for `D = |ts|` and
`long i = (t_i = 2^ℓ)`. **`base18_ctx`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

theorem flOf_18 (ℓ : ℕ) (ts : List ℕ) [NeZero ts.length] :
    flOf ts.length (long18 ℓ ts) = fl18 ℓ ts := by
  apply List.ext_getElem (by simp [flOf, fl18])
  intro i h1 h2
  simp [flOf, fl18, long18]

theorem nLong_18 (ℓ : ℕ) (ts : List ℕ) [NeZero ts.length] :
    nLong ts.length (long18 ℓ ts) = nL18 ℓ ts := by
  rw [← flOf_count, flOf_18]; rfl

theorem pLP_18 (ℓ K : ℕ) (ts : List ℕ) [NeZero ts.length] (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    pLP ts.length ℓ K (long18 ℓ ts) =
      ⟨ts.length, ℓ, K, bb ℓ K, qq ℓ K, nL18 ℓ ts, lst18 ℓ K ts, n18 ℓ K ts⟩ := by
  obtain ⟨-, -, hLst, hn, -⟩ := pLP_OK ts.length ℓ K (long18 ℓ ts) hK hℓ
  simp only [pLP, nLong_18] at hLst hn ⊢
  rw [hn, hLst]; simp [n18, lst18, Nat.mul_comm]

theorem regs18_of (p ℓ K : ℕ) (ts : List ℕ) {j : Fin HS}
    (hj : j ∉ [gD, gLl, gKk, gBb, gQq, gNL, gLst, gNn, gH, gLG, gMk, gPp, gWw, gZz, dS18]) :
    regs18 p ℓ K ts j = [] := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩ := hj
  rw [regs18, if_neg h1, if_neg h2, if_neg h3, if_neg h4, if_neg h5, if_neg h6, if_neg h7,
    if_neg h8, if_neg h9, if_neg h10, if_neg h11, if_neg h12, if_neg h13, if_neg h14, if_neg h15]

theorem regs18_sT (p ℓ K : ℕ) (ts : List ℕ) : regs18 p ℓ K ts sT = [] :=
  regs18_of p ℓ K ts (by decide)

theorem twFree_regs : ∀ j ∈ twFree,
    j ∉ [gD, gLl, gKk, gBb, gQq, gNL, gLst, gNn, gH, gLG, gMk, gPp, gWw, gZz, dS18] := by decide

theorem twFree_sT : ∀ j ∈ twFree, j ≠ sT := by decide

/-- **The base context.** -/
theorem base18_ctx (p ℓ K : ℕ) (ts : List ℕ) [NeZero ts.length] (hK : 0 < K) (hℓ : 1 ≤ ℓ)
    (s : IState HS) (X : List ℤ) :
    let S := encK s (Function.update (regs18 p ℓ K ts) sT X)
    LRg S (pLP ts.length ℓ K (long18 ℓ ts)) (mkOf (flOf ts.length (long18 ℓ ts))) (p + 2) ∧
      PCtx (pLP ts.length ℓ K (long18 ℓ ts)) (flOf ts.length (long18 ℓ ts)) p (p + 2)
        (n18 ℓ K ts + ℓ + 8) S := by
  intro S
  rw [pLP_18 ℓ K ts hK hℓ, flOf_18]
  have g : ∀ j : Fin HS, j ≠ sT → (encK s (Function.update (regs18 p ℓ K ts) sT X)).G j =
      ints (regs18 p ℓ K ts j) ++ s.G j := fun j hj => by
    rw [encK_G, Function.update_of_ne hj]
  have rt : ∀ j : Fin HS, j ≠ sT → ∀ v : ℤ, regs18 p ℓ K ts j = [v] → RT S j v :=
    fun j hj v h => ⟨s.G j, by rw [g j hj, h]; simp [ints]⟩
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
  all_goals try (exact rt _ (by decide) _ rfl)
  refine ⟨s, Function.update (regs18 p ℓ K ts) sT X, [], 0, rfl, ?_, ?_, ?_, ?_⟩
  · have rv : ∀ j : Fin HS, j ≠ sT → ∀ v : ℤ, regs18 p ℓ K ts j = [v] →
        RV s (Function.update (regs18 p ℓ K ts) sT X) j v :=
      fun j hj v h => RV.of_list (l := []) (by rw [Function.update_of_ne hj, h])
    exact ⟨rv _ (by decide) _ rfl, rv _ (by decide) _ rfl,
      rv _ (by decide) _ rfl, rv _ (by decide) _ rfl,
      rv _ (by decide) _ rfl, rv _ (by decide) _ rfl,
      rv _ (by decide) _ rfl, rv _ (by decide) _ rfl,
      rv _ (by decide) _ rfl⟩
  · rw [Function.update_of_ne (by decide)]; simp only [List.append_nil]; rfl
  · intro j hj
    rw [Function.update_of_ne (twFree_sT j hj)]
    exact regs18_of p ℓ K ts (twFree_regs j hj)
  · refine ⟨rt _ (by decide) _ rfl, rt _ (by decide) _ rfl,
      rt _ (by decide) _ rfl⟩

end NLogN.KFV

