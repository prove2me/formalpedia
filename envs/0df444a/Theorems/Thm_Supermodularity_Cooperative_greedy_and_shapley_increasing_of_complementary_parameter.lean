-- title:
--   Theorem 5.2.7(a,b) - the greedy payoff and the Shapley value increase with a complementary parameter
-- statement:
--   Suppose $T$ is a partially ordered set, $(N, f^t)$ is a cooperative game for each $t \in T$, and
--   $t$ is a complementary parameter, i.e. $f^t(S)$ has increasing differences in $(S,t)$ on the
--   Boolean lattice of coalitions. Then:
--   (a) the payoff vector $y^t_\pi$ generated by the greedy algorithm is an increasing function of $t$
--   on $T$, for each permutation $\pi$ of the players $N$;
--   (b) the Shapley value is an increasing function of $t$ on $T$.
--
--   This is parts (a) and (b) of Theorem 5.2.7 (p. 221-222), from Topkis [1987]. Part (c), which needs
--   a further convex-combination-of-extreme-points construction from Theorem 5.2.4, is omitted from
--   this mission.
--
--   **Formalization note.** "Complementary parameter" reuses
--   `Supermodularity.Monotonicity.IncreasingDifferencesOn`, instantiated with the Boolean lattice
--   `Finset (Fin n)` playing the role of increasing-differences' abstract lattice `X`, exactly as
--   chunk `02-monotonicity` states it, rather than restating the hypothesis ad hoc for coalitions.
-- source:
--   Topkis, Supermodularity and Complementarity, Princeton University Press, 2011, p. 221-222, Theorem 5.2.7(a,b)

import Mathlib
import Definitions.Def_Supermodularity_Cooperative_GreedyPayoff
import Definitions.Def_Supermodularity_Cooperative_ShapleyValue
import Definitions.Def_Supermodularity_Monotonicity_IncreasingDifferencesOn

namespace Supermodularity.Cooperative

theorem greedy_and_shapley_increasing_of_complementary_parameter
    {n : ℕ} {T : Type*} [PartialOrder T] (f : T → Finset (Fin n) → ℝ)
    (hcomp : Supermodularity.Monotonicity.IncreasingDifferencesOn
      (fun (S : Finset (Fin n)) (t : T) => f t S) Set.univ) :
    (∀ σ : Equiv.Perm (Fin n), Monotone (fun t : T => GreedyPayoff σ (f t))) ∧
    Monotone (fun t : T => ShapleyValue (f t)) := by sorry

end Supermodularity.Cooperative
