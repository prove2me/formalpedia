  simp only [BF_vj, BF_du, BFu_vj, BFu_du, BFu_dt] at g5
  exact (g1.seq (g2.seq (g3.seq (g4.seq g5)))).mono (by omega)

/-- Facts on `j = clog₂ 2n`. -/
theorem clog_facts {n : ℕ} (hn : 1 ≤ n) :
    2 * n ≤ 2 ^ Nat.clog 2 (2 * n) ∧ 2 ^ Nat.clog 2 (2 * n) < 4 * n := by
  refine ⟨Nat.le_pow_clog (by norm_num) _, ?_⟩
  have h1 := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (x := 2 * n) (by omega)
  have h2 := Nat.clog_pos (b := 2) (by norm_num) (show 1 < 2 * n by omega)
  have e : Nat.clog 2 (2 * n) = (Nat.clog 2 (2 * n)).pred + 1 := (Nat.succ_pred_eq_of_pos h2).symm
  rw [e, pow_succ]; omega

set_option maxHeartbeats 4000000 in
/-- **The new block header** on the block frame. -/
theorem hdrF2 (s : IState HS) {G : Fin HS → List ℤ} {P pk b : ℕ} (hG : GOK P pk b G)
    {r0 o du T : List ℤ} {bc : List ℤ} {n BH : ℕ} (hn : 1 ≤ n) (hb : 1 ≤ b) (hpk : pk < b)
    (hBH : ∀ v ∈ blkHdr2 n b, zsz v ≤ BH) :
    Sp hdrRS2 (encK s (BF G r0 [] [] o (blkHdr2 n b ++ T) du [] [] [] [] [] bc))
      (encK s (BF G r0 [] [] o T ((blkHdr2 n b).reverse ++ du) [(n : ℤ)] [((2 * n : ℕ) : ℤ)]
        [((2 * n : ℕ) : ℤ)] [kG b (2 * n) (2 ^ pk)] [(2 ^ b) ^ (2 * (2 * n))] bc))
      (52000 * (BH + 2) + cKG (Nat.clog 2 (2 * n)) (b * (2 * n)) (BkN b n)) := by
  set j := Nat.clog 2 (2 * n)
  have H1 := hdrF_gen s G (r0 := r0) (o := o) (du := du) (T := T) (bc := bc) (n := n) (BH := BH)
    (x3 := (j : ℤ)) (x4 := ((2 * n * b : ℕ) : ℤ)) (hBH _ (by simp [blkHdr2]))
    (hBH _ (by simp [blkHdr2])) (hBH _ (by simp [blkHdr2, j])) (hBH _ (by simp [blkHdr2]))
  have e1 : blkHdr2 n b ++ T = (n : ℤ) :: ((2 * n : ℕ) : ℤ) :: (j : ℤ) :: ((2 * n * b : ℕ) : ℤ) :: T :=
    rfl
  have e2 : (blkHdr2 n b).reverse ++ du =
      ((2 * n * b : ℕ) : ℤ) :: (j : ℤ) :: ((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du := by
    simp [blkHdr2, j]
  rw [e1, e2]
  obtain ⟨cl1, cl2⟩ := clog_facts hn
  set F := BF G r0 [] [] o T (((2 * n * b : ℕ) : ℤ) :: (j : ℤ) :: ((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du)
    [(n : ℤ)] [((2 * n : ℕ) : ℤ)] [((2 * n : ℕ) : ℤ)] [(j : ℤ)] [((2 * n * b : ℕ) : ℤ)] bc with hF
  have hG' := hG.bf (r0 := r0) (w1 := []) (w2 := []) (o := o) (dt := T)
    (du := ((2 * n * b : ℕ) : ℤ) :: (j : ℤ) :: ((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du)
    (bn := [(n : ℤ)]) (bn2 := [((2 * n : ℕ) : ℤ)]) (vr := [((2 * n : ℕ) : ℤ)]) (vk := [(j : ℤ)])
    (vj := [((2 * n * b : ℕ) : ℤ)]) (bc := bc)
  have hbj : b * 2 ^ j ≤ b * (4 * n) := Nat.mul_le_mul_left _ cl2.le
  have hjz : zsz (j : ℤ) ≤ BkN b n := by
    have : j < 2 ^ j := Nat.lt_two_pow_self
    have h := zsz_lt_pow (x := (j : ℤ)) (M := j) (by positivity) (by exact_mod_cast this)
    unfold BkN; nlinarith
  have K := sp_kg s F (pk := pk) (b := b) (j := j) (n := n) (Bk := BkN b n) hG'.x hG'.y hG'.cn
    hG'.c hG'.kb (by rw [hF, BF_vk]) (by rw [hF, BF_vj]; congr 2; ring) hpk cl1
    (by unfold BkN; nlinarith) (by unfold BkN; nlinarith) hjz
  rw [hF, BFu_vk, BFu_vj] at K
  exact H1.seq K

/-- The block constants are within `BkN`. -/
theorem kconst_bnd {n pk b : ℕ} (hpk : pk < b) :
    zsz (kG b (2 * n) (2 ^ pk)) ≤ BkN b n ∧ zsz ((2 ^ b : ℤ) ^ (2 * (2 * n))) ≤ BkN b n := by
  have c0 : (0 : ℤ) ≤ 2 ^ pk := by positivity
  have cb : (2 : ℤ) ^ pk < 2 ^ b := pow_lt_pow_right₀ (by norm_num) hpk
  refine ⟨?_, ?_⟩
  · have h := kG_lt b c0 cb (2 * n)
    rw [← pow_mul] at h
    exact le_trans (zsz_lt_pow (kG_nonneg b c0 _) h) (by unfold BkN; omega)
  · rw [← pow_mul, zsz_two_pow]; unfold BkN; nlinarith

