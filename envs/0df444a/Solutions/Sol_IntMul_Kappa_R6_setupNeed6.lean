-- Source module: Solutions.KFMBig1
/-!
# KFM Big1: the setup phase of `bigE`

From the state after the reads (`readSt x y`, KFMK1), `setP` computes all run-time parameters:

1. `startP`: `n` from the ruler `2^n` on `kT1` (`nP`, KFMU5) and `b = lg n` (`lgP`, KFMU4), onto
   `zN`, `zB`;
2. `setupS` (KFMS3/S4): the §9.2 parameters on `zD … zMf`;
3. `parS`, `parQ` (KFMBig0): the registers `rS … rOne`;
4. `oP`: `2^{2n}` on `rO` by two IL shifts by the ruler `2^n`.

* **`setP_runs`**: the run, ending in the base state `baseSt n x y`.
* `regIdx`: the register stacks. **`BaseOK`**: what the later phases read from them. Any state
  that agrees with the base state on `regIdx` satisfies `BaseOK` (**`BaseOK.of_agree`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue RS KFT

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Step 1 -/

theorem readSt_G (x y : List Bool) (j : Fin HS) (h1 : j ≠ ARGM) (h2 : j ≠ kT1) (h3 : j ≠ kT2) :
    (readSt x y).G j = [] := by
  simp [readSt, h1, h2, h3]

theorem startP_runs (x y : List Bool) (hn : 3 ≤ x.length) :
    IRuns I iprog startP (readSt x y)
      (((readSt x y).upd zN [.int (x.length : ℤ)]).upd zB [.int (lg x.length : ℤ)])
      (cStart x.length) := by
  set n := x.length
  set s0 := readSt x y
  have hT1 : s0.G kT1 = [.int ((2 : ℤ) ^ n)] := by simp +decide [s0, readSt, n]
  have hN0 : s0.G gN = [] := readSt_G x y _ (by decide) (by decide) (by decide)
  have hJ0 : s0.G gJ = [] := readSt_G x y _ (by decide) (by decide) (by decide)
  have hB0 : s0.G zB = [] := readSt_G x y _ (by decide) (by decide) (by decide)
  have r1 := IRuns.dup (I := I) (iprog := iprog) (s := s0) (i := kT1) (j := gN) (a := (2 : ℤ) ^ n)
    (L := []) (by decide) hT1
  set s1 := s0.upd gN (.int ((2 : ℤ) ^ n) :: s0.G gN)
  have h1N : s1.G gN = .int ((2 : ℤ) ^ n) :: s0.G gN := by simp [s1]
  have r2 := nP_runs (I := I) (iprog := iprog) s1 n (s0.G gN) h1N
  set s2 := s1.upd gJ (.int (n : ℤ) :: s1.G gJ)
  have r3 := lgP_runs (I := I) (iprog := iprog) s2 n hn (s0.G gN) (by simp +decide [s2, h1N])
  set s3 := s2.upd gJ (.int (lg n : ℤ) :: s2.G gJ)
  have r4 := IRuns.mv (I := I) (iprog := iprog) (s := s3) (i := gJ) (j := zB) (a := (lg n : ℤ))
    (L := .int (n : ℤ) :: s1.G gJ) (by decide) (by simp [s3, s2])
  set s4 := (s3.upd gJ (.int (n : ℤ) :: s1.G gJ)).upd zB (.int (lg n : ℤ) :: s3.G zB)
  have r5 := IRuns.drop (I := I) (iprog := iprog) (s := s4) (i := gN) (a := (2 : ℤ) ^ n)
    (L := s0.G gN) (by simp +decide [s4, s3, s2, h1N])
  refine (r1.seq (r2.seq (r3.seq (r4.seq r5)))).mono' ?_ (by unfold cStart; omega)
  refine IState.ext' (fun j => ?_) (by simp [s4, s3, s2, s1]) (by simp [s4, s3, s2, s1])
  simp only [s4, s3, s2, s1, IState.upd_G]
  split_ifs <;> simp_all +decide

/-! ## Step 4 -/

theorem oP_runs (t : IState HS) (n : ℕ) (LT : List Item) (hT : t.G kT1 = .int ((2 : ℤ) ^ n) :: LT) :
    IRuns I iprog oP t (t.upd rO (.int ((2 : ℤ) ^ (2 * n)) :: t.G rO)) (3 + 2 * shlCost n) := by
  have r1 := IRuns.const (I := I) (iprog := iprog) (s := t) rO 1
  have r2 := IRuns.shl (I := I) (iprog := iprog) (s := t.upd rO (.int 1 :: t.G rO)) (i := rO)
    (j := kT1) (a := 1) (m := n) (Li := t.G rO) (Lj := LT) (by decide) (by simp)
    (by simp +decide [hT])
  have r3 := IRuns.shl (I := I) (iprog := iprog)
    (s := (t.upd rO (.int 1 :: t.G rO)).upd rO (.int (1 * 2 ^ n) :: t.G rO)) (i := rO)
    (j := kT1) (a := 1 * 2 ^ n) (m := n) (Li := t.G rO) (Lj := LT) (by decide) (by simp)
    (by simp +decide [hT])
  refine (r1.seq (r2.seq r3)).mono' ?_ (by rw [zsz_one]; omega)
  simp only [IState.upd_upd_same]
  congr 3
  rw [two_mul, pow_add]; ring

/-! ## The whole setup -/

/-! ## The base state -/

end NLogN.KFM

