  have ha : Nat.Coprime (a : ZMod p).val p := ZMod.val_coe_unit_coprime a
  set u₀ : ℤ_[p]ˣ := (isUnit_natCast_padicInt (p := p) ha).unit with hu₀_def
  have hu₀ : (u₀ : ℤ_[p]) = ((a : ZMod p).val : ℕ) := IsUnit.unit_spec _
