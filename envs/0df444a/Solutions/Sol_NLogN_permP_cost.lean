  set t3 := (t2.upd 41 (s.G 41)).upd 3 ((ints (List.map (Nat.cast : ℕ → ℤ) Kl).reverse).reverse ++
    t2.G 3) with ht3
  have u45 : t3.G 45 = .int ((n * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [ht3, ht2, IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt]
  refine ⟨⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩, ?_⟩
  · rw [hz]
    refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of g1) ?_, ?_⟩
    · intro p hp
      rw [e1, Int.toNat_natCast] at hp ⊢
      exact (p_step d n Kl D Rest RK s hKl hD hDw _ _ p hp).1
    · rw [hloop]
      refine ⟨m1.1, ?_⟩
      rw [m1.2]
      refine ⟨m2.1, ?_⟩
      rw [m2.2]
      exact ⟨by decide, IState.isInt_of u45⟩
  · simp only [pAttachP, run_seq]
    rw [hz, hloop, m1.2, m2.2]
    apply IState.ext' _ (by simp [ht3, ht2, ht, NLogN.pSt]) (by simp [ht3, ht2, ht, NLogN.pSt])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [u45]
    simp only [if_neg x45]
    by_cases x3 : x = 3
    · subst x3
      simp (config := {decide := true}) [ht3, ht2, ht, NLogN.pSt, ← hKl, natInts, ints_reverse, h3]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [ht3, ht2, ht, NLogN.pSt, ← hD, ints_reverse]
    simp only [if_neg x3, if_neg x0, ht3, ht2, IState.upd_G]
    by_cases x41 : x = 41
    · subst x41; simp
    by_cases x40 : x = 40
    · subst x40; simp
    simp only [if_neg x41, if_neg x40]
    rw [ht, NLogN.pSt_G_other _ _ _ _ _ _ _ _ x0 x3 x40 x41 x45]

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
set_option maxHeartbeats 1000000
theorem solution (d n kb B : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List NLogN.Item)
    (s : NLogN.IState NLogN.HS) (hKl : Kl.length = n) (hK : Kl.Perm (List.range n)) (hD : D.length = n)
    (hDw : ∀ r ∈ D, r.length = d) (hN : n ≤ 2 ^ kb) (L1 L2 : List NLogN.Item)
    (h0 : s.G 0 = NLogN.ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int kb :: L2) (h3 : s.G 3 = NLogN.natInts Kl ++ RK) (hDB : ∀ r ∈ D, NLogN.Bnd B r) :
    (NLogN.permP d).cost s ≤ 10 ^ 6 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
  set X := B + kb + d + 2 with hX
  have hXB : ∀ r ∈ D, NLogN.Bnd X r := fun r hr x hx => le_trans (hDB r hr x hx) (by omega)
  have hKlt : ∀ k ∈ Kl, k < n := fun k hk => by
    have := hK.subset hk; simpa using this
  have hpow : 2 ^ kb * (d + 1) < 2 ^ (kb + d + 1) := by
    rw [show kb + d + 1 = kb + (d + 1) by ring, pow_add]
    exact Nat.mul_lt_mul_of_pos_left Nat.lt_two_pow_self (by positivity)
  have hX2 : NLogN.zsz ((n * (d + 1) : ℕ) : ℤ) ≤ X := by
    have : n * (d + 1) < 2 ^ (kb + d + 1) :=
      lt_of_le_of_lt (Nat.mul_le_mul_right _ hN) hpow
    exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
  have hXd : NLogN.zsz ((d + 1 : ℕ) : ℤ) ≤ X := by
    have : d + 1 < 2 ^ (d + 1) := Nat.lt_two_pow_self
    exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
  have hn : n ≤ n * (d + 1) := Nat.le_mul_of_pos_right _ (by omega)
  have hA := NLogN.pAttachP_spec d n Kl D Rest RK s hKl hD hDw L1 h0 h1 h3
  have cA := NLogN.pAttachP_cost d n Kl D Rest RK s hKl hKlt hD hDw L1 h0 h1 h3 X hXB hX2 hXd
  set s1 := s.upd 0 (NLogN.ints (NLogN.pflat Kl D n) ++ Rest) with hs1
  set K := (List.range n).map (NLogN.pRec Kl D) with hK'
  have hKw : ∀ r ∈ K, r.length = d + 1 := by
    intro r hr; simp only [hK', List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    simp only [NLogN.pRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
  have hKB : ∀ r ∈ K, NLogN.Bnd X r := by
    intro r hr; simp only [hK', List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    intro x hx
    simp only [NLogN.pRec, List.mem_cons] at hx
    rcases hx with rfl | hx
    · rw [List.getD_eq_getElem _ _ (by omega)]
      exact NLogN.zsz_le_of_nat_le (le_trans (hKlt _ (List.getElem_mem _)).le hn) hX2
    · rw [List.getD_eq_getElem _ _ (by omega : p < D.length)] at hx
      exact hXB _ (List.getElem_mem _) x hx
  have hKl' : K.length = n := by simp [hK']
  have s10 : s1.G 0 = NLogN.ints K.flatten ++ Rest := by simp [hs1, hK', NLogN.pflat]
  have s11 : s1.G 1 = .int K.length :: L1 := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [hKl', h1]
  have s12 : s1.G 2 = .int kb :: L2 := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [h2]
  have hS := NLogN.sortP_spec (d + 1) kb s1 K Rest hKw (by omega) L1 L2 s10 s11 s12
  have cS := NLogN.sortP_cost (d + 1) kb s1 K Rest hKw (by omega) L1 L2 s10 s11 s12 X hKB
    (by rw [hKl']; exact hX2) (by omega) hXd
  rw [hKl'] at cS
  set S := NLogN.radixSort kb K with hSdef
  have hSw : ∀ r ∈ S, r.length = d + 1 := fun r hr => hKw r ((NLogN.radixSort_perm kb K).subset hr)
  have hSB : ∀ r ∈ S, NLogN.Bnd X r := fun r hr => hKB r ((NLogN.radixSort_perm kb K).subset hr)
  have hSl : S.length = n := by rw [(NLogN.radixSort_perm kb K).length_eq, hKl']
  have g1 : (s1.upd 0 (NLogN.ints S.flatten ++ Rest)).G 1 = .int K.length :: L1 := by
    simp only [NLogN.IState.upd_G]; simp (config := {decide := true}) [s11]
  set s2 := (NLogN.RS.push 45 (.lit 0)).run ((NLogN.RS.push 54 (.reg 1)).run (s1.upd 0 (NLogN.ints S.flatten ++ Rest)))
    with hs2
  have s254 : s2.G 54 = .int S.length :: s.G 54 := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]
    simp (config := {decide := true}) [hSl, NLogN.Ex.eval, NLogN.IState.top_eq s11, hKl', hs1]
    rw [NLogN.IState.top_eq (L := L1) (a := n)]; simp (config := {decide := true}) [h1]
  have s20 : s2.G 0 = NLogN.ints S.flatten ++ Rest := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]; simp (config := {decide := true})
  have s245 : s2.G 45 = .int 0 :: s.G 45 := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]; simp (config := {decide := true}) [NLogN.Ex.eval, hs1]
  have hP := NLogN.stripP_spec d S Rest s2 hSw (s.G 54) s254 s20 (NLogN.IState.isInt_of s245)
  have cP := NLogN.stripP_cost d S Rest s2 hSw (s.G 54) s254 s20 0 (s.G 45) s245 X hSB
    (by rw [hSl]; exact hX2) hXd (by rw [NLogN.zsz_zero]; omega)
  rw [hSl] at cP
  set s3 := (s2.upd 0 (NLogN.ints (S.map List.tail).flatten ++ Rest)).upd 45
        (.int ((S.length * d : ℕ) : ℤ) :: (s2.G 45).tail) with hs3
  have s345 : s3.G 45 = .int ((S.length * d : ℕ) : ℤ) :: s.G 45 := by
    simp only [hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s245]
  have s354 : ((NLogN.RS.pop 45).run s3).G 54 = .int S.length :: s.G 54 := by
    simp only [NLogN.RS.run_pop_G, hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s254]
  have cpush : (NLogN.RS.push 54 (.reg 1)).cost (s1.upd 0 (NLogN.ints S.flatten ++ Rest)) ≤ (1 + 1) * 2000 * (X + 2) :=
    NLogN.RS.pushCost_le_lin (.reg 1) _ X (by simp [NLogN.Ex.Lin])
      (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq g1, hKl']; exact NLogN.zsz_le_of_nat_le hn hX2)
  have p1 : NLogN.zsz (S.length : ℤ) ≤ X := by rw [hSl]; exact NLogN.zsz_le_of_nat_le hn hX2
  have p2 : NLogN.zsz ((S.length * d : ℕ) : ℤ) ≤ X := by
    rw [hSl]; exact NLogN.zsz_le_of_nat_le (Nat.mul_le_mul_left _ (by omega)) hX2
  simp only [NLogN.permP, NLogN.cost_seq, NLogN.cost_pop, NLogN.cost_push_lit0]
  rw [hA.2, hS.2, ← hs2, hP.2, NLogN.IState.top_eq s345, NLogN.IState.top_eq s354]
  have hX2' : X + 2 = B + kb + d + 4 := by omega
  rw [hX2'] at cA cS cP cpush
  have e1 : 200000 * (kb + 1) * (n * (d + 1) + 1) * (B + kb + d + 4) ≤
      200000 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
    have h : n * (d + 1) + 1 ≤ (n + 1) * (d + 1) := by nlinarith
    calc 200000 * (kb + 1) * (n * (d + 1) + 1) * (B + kb + d + 4)
        ≤ 200000 * (kb + 1) * ((n + 1) * (d + 1)) * (B + kb + d + 4) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h)
      _ = _ := by ring
  have e2 : 100000 * (n + 1) * (d + 1) * (B + kb + d + 4) ≤
      100000 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
    nlinarith [Nat.zero_le ((n + 1) * (d + 1) * (B + kb + d + 4))]
  have e3 : 50000 * (n + 1) * (d + 1) * (B + kb + d + 4) ≤
      50000 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
    nlinarith [Nat.zero_le ((n + 1) * (d + 1) * (B + kb + d + 4))]
  have e4 : 5000 * (B + kb + d + 4) ≤
      5000 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
    have : 1 ≤ (kb + 1) * (n + 1) * (d + 1) := Nat.one_le_iff_ne_zero.2 (by positivity)
    nlinarith
  have e5 := Nat.zero_le ((kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4))
  linarith only [cA, cS, cP, cpush, e1, e2, e3, e4, e5, p1, p2, hX2']
end
