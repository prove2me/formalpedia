open MvPolynomial Matrix RobustPMI.Hierarchy

variable {n q : ℕ}

/-- Scalar quadratic module of `G`: sums of squares plus sums of `vᵀ G v`. -/
def QS (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)) : Set (MvPolynomial (Fin n) ℝ) :=
  {f | ∃ (k : ℕ) (h : Fin k → MvPolynomial (Fin n) ℝ) (l : ℕ)
      (v : Fin l → Fin q → MvPolynomial (Fin n) ℝ),
      f = ∑ i, h i ^ 2 + ∑ j, v j ⬝ᵥ (G *ᵥ v j)}

variable {G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)}

theorem QS_zero : (0 : MvPolynomial (Fin n) ℝ) ∈ QS G :=
  ⟨0, Fin.elim0, 0, Fin.elim0, by simp⟩

theorem QS_sq (h : MvPolynomial (Fin n) ℝ) : h ^ 2 ∈ QS G :=
  ⟨1, fun _ => h, 0, Fin.elim0, by simp⟩

theorem QS_vec (v : Fin q → MvPolynomial (Fin n) ℝ) : v ⬝ᵥ (G *ᵥ v) ∈ QS G :=
  ⟨0, Fin.elim0, 1, fun _ => v, by simp⟩

theorem QS_add {f g : MvPolynomial (Fin n) ℝ} (hf : f ∈ QS G) (hg : g ∈ QS G) :
    f + g ∈ QS G := by
  obtain ⟨k, h, l, v, rfl⟩ := hf
  obtain ⟨k', h', l', v', rfl⟩ := hg
  refine ⟨k + k', Fin.append h h', l + l', Fin.append v v', ?_⟩
  rw [Fin.sum_univ_add, Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right]
  ring

theorem QS_sum {ι : Type*} (s : Finset ι) (f : ι → MvPolynomial (Fin n) ℝ)
    (hf : ∀ i ∈ s, f i ∈ QS G) : ∑ i ∈ s, f i ∈ QS G := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (QS_zero (G := G))
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact QS_add (hf a (Finset.mem_insert_self a s))
      (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))

theorem QS_mul_sq (g : MvPolynomial (Fin n) ℝ) {f : MvPolynomial (Fin n) ℝ} (hf : f ∈ QS G) :
    g ^ 2 * f ∈ QS G := by
  obtain ⟨k, h, l, v, rfl⟩ := hf
  refine ⟨k, fun i => g * h i, l, fun j => g • v j, ?_⟩
  rw [mul_add, Finset.mul_sum, Finset.mul_sum]
  congr 1
  · exact Finset.sum_congr rfl fun i _ => by ring
  · refine Finset.sum_congr rfl fun j _ => ?_
    rw [Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul]
    ring

theorem QS_smul {c : ℝ} (hc : 0 ≤ c) {f : MvPolynomial (Fin n) ℝ} (hf : f ∈ QS G) :
    C c * f ∈ QS G := by
  have : (C c : MvPolynomial (Fin n) ℝ) = C (Real.sqrt c) ^ 2 := by
    rw [← map_pow, Real.sq_sqrt hc]
  rw [this]
  exact QS_mul_sq _ hf

theorem QS_const {c : ℝ} (hc : 0 ≤ c) : (C c : MvPolynomial (Fin n) ℝ) ∈ QS G := by
  have h1 : (1 : MvPolynomial (Fin n) ℝ) ∈ QS G := by simpa using (QS_sq (G := G) 1)
  simpa using QS_smul hc h1

theorem half_two : (C (1 / 2 : ℝ) : MvPolynomial (Fin n) ℝ) * 2 = 1 := by
  rw [show (2 : MvPolynomial (Fin n) ℝ) = C 2 from (map_ofNat C 2).symm, ← map_mul]
  norm_num

/-- If `-1 ∈ QS G` then `QS G` is everything. -/
theorem QS_univ_of_neg_one (h : (-1 : MvPolynomial (Fin n) ℝ) ∈ QS G)
    (a : MvPolynomial (Fin n) ℝ) : a ∈ QS G := by
  have e : a = (C (1 / 2 : ℝ) * (a + 1)) ^ 2 + (C (1 / 2 : ℝ) * (a - 1)) ^ 2 * (-1) := by
    linear_combination (-a * (1 + 2 * C (1 / 2 : ℝ))) * (half_two (n := n))
  rw [e]
  exact QS_add (QS_sq _) (QS_mul_sq _ h)

/-- `f` is bounded for the order of `QS G`. -/
def Bd (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)) (f : MvPolynomial (Fin n) ℝ) : Prop :=
  ∃ N : ℝ, C N - f ∈ QS G ∧ C N + f ∈ QS G

theorem Bd_C (c : ℝ) : Bd G (C c) := by
  refine ⟨|c|, ?_, ?_⟩
  · rw [← map_sub]; exact QS_const (by linarith [le_abs_self c])
  · rw [← map_add]; exact QS_const (by linarith [neg_abs_le c])

theorem Bd_add {f g : MvPolynomial (Fin n) ℝ} (hf : Bd G f) (hg : Bd G g) : Bd G (f + g) := by
  obtain ⟨N1, h1, h1'⟩ := hf
  obtain ⟨N2, h2, h2'⟩ := hg
  refine ⟨N1 + N2, ?_, ?_⟩
  · have : C (N1 + N2) - (f + g) = (C N1 - f) + (C N2 - g) := by rw [map_add]; ring
    rw [this]; exact QS_add h1 h2
  · have : C (N1 + N2) + (f + g) = (C N1 + f) + (C N2 + g) := by rw [map_add]; ring
    rw [this]; exact QS_add h1' h2'

/-- Upper bound with a positive constant. -/
theorem Bd_pos {f : MvPolynomial (Fin n) ℝ} (hf : Bd G f) :
    ∃ N : ℝ, 0 < N ∧ C N - f ∈ QS G ∧ C N + f ∈ QS G := by
  obtain ⟨N, h1, h2⟩ := hf
  refine ⟨max N 1, by positivity, ?_, ?_⟩
  · have : C (max N 1) - f = (C N - f) + C (max N 1 - N) := by rw [map_sub]; ring
    rw [this]; exact QS_add h1 (QS_const (by linarith [le_max_left N 1]))
  · have : C (max N 1) + f = (C N + f) + C (max N 1 - N) := by rw [map_sub]; ring
    rw [this]; exact QS_add h2 (QS_const (by linarith [le_max_left N 1]))

/-- `N² - h² ∈ QS` from `N ± h ∈ QS`. -/
theorem Bd_sq_upper {h : MvPolynomial (Fin n) ℝ} (hh : Bd G h) :
    ∃ M : ℝ, 0 ≤ M ∧ C M - h ^ 2 ∈ QS G := by
  obtain ⟨N, hN, h1, h2⟩ := Bd_pos hh
  refine ⟨N ^ 2, by positivity, ?_⟩
  have key : (C N + h) ^ 2 * (C N - h) + (C N - h) ^ 2 * (C N + h)
      = C (2 * N) * (C (N ^ 2) - h ^ 2) := by
    simp only [map_mul, map_pow, map_ofNat]; ring
  have e : C (N ^ 2) - h ^ 2 = C (1 / (2 * N)) * ((C N + h) ^ 2 * (C N - h)
      + (C N - h) ^ 2 * (C N + h)) := by
    rw [key, ← mul_assoc, ← map_mul, show 1 / (2 * N) * (2 * N) = 1 by field_simp, map_one,
      one_mul]
  rw [e]
  exact QS_smul (by positivity) (QS_add (QS_mul_sq _ h1) (QS_mul_sq _ h2))

theorem Bd_neg {f : MvPolynomial (Fin n) ℝ} (hf : Bd G f) : Bd G (-f) := by
  obtain ⟨N, a, b⟩ := hf
  exact ⟨N, by rw [sub_neg_eq_add]; exact b, by rw [← sub_eq_add_neg]; exact a⟩

theorem Bd_mul {f g : MvPolynomial (Fin n) ℝ} (hf : Bd G f) (hg : Bd G g) : Bd G (f * g) := by
  obtain ⟨M1, hM1, k1⟩ := Bd_sq_upper (Bd_add hf hg)
  obtain ⟨M2, hM2, k2⟩ := Bd_sq_upper (Bd_add hf (Bd_neg hg))
  have e := half_two (n := n)
  set c : MvPolynomial (Fin n) ℝ := C (1 / 2 : ℝ) with hc
  have hC : ∀ M : ℝ, (C (M / 4) : MvPolynomial (Fin n) ℝ) = c ^ 2 * C M := by
    intro M; rw [hc, ← map_pow, ← map_mul]; congr 1; ring
  refine ⟨M1 / 4 + M2 / 4, ?_, ?_⟩
  · have id : C (M1 / 4 + M2 / 4) - f * g = c ^ 2 * (C M1 - (f + g) ^ 2) + (c * (f + -g)) ^ 2
        + C (M2 / 4) := by
      rw [map_add, hC M1]; linear_combination (f * g * (2 * c + 1)) * e
    rw [id]
    exact QS_add (QS_add (QS_mul_sq _ k1) (QS_sq _)) (QS_const (by positivity))
  · have id : C (M1 / 4 + M2 / 4) + f * g = c ^ 2 * (C M2 - (f + -g) ^ 2) + (c * (f + g)) ^ 2
        + C (M1 / 4) := by
      rw [map_add, hC M2]; linear_combination (-(f * g * (2 * c + 1))) * e
    rw [id]
    exact QS_add (QS_add (QS_mul_sq _ k2) (QS_sq _)) (QS_const (by positivity))

theorem Bd_X {R : ℝ} (hR : C R - ∑ i, X i ^ 2 ∈ QS G) (i : Fin n) : Bd G (X i) := by
  have e := half_two (n := n)
  set c : MvPolynomial (Fin n) ℝ := C (1 / 2 : ℝ) with hc
  have hsum : ∑ j, (X j : MvPolynomial (Fin n) ℝ) ^ 2
      = X i ^ 2 + ∑ j ∈ Finset.univ.erase i, X j ^ 2 :=
    (Finset.add_sum_erase _ _ (Finset.mem_univ i)).symm
  have hS : ∑ j ∈ Finset.univ.erase i, (X j : MvPolynomial (Fin n) ℝ) ^ 2 ∈ QS G :=
    QS_sum _ _ fun j _ => QS_sq _
  have hk : (C ((R + 1) / 2) : MvPolynomial (Fin n) ℝ) = c * C R + c := by
    rw [hc, ← map_mul, ← map_add]; congr 1; ring
  refine ⟨(R + 1) / 2, ?_, ?_⟩
  · have id : C ((R + 1) / 2) - X i = C (1 / 2) * ((C R - ∑ j, X j ^ 2)
        + ∑ j ∈ Finset.univ.erase i, X j ^ 2 + (X i - 1) ^ 2) := by
      rw [hk, hsum, ← hc]; linear_combination (X i : MvPolynomial (Fin n) ℝ) * e
    rw [id]
    exact QS_smul (by norm_num) (QS_add (QS_add hR hS) (QS_sq _))
  · have id : C ((R + 1) / 2) + X i = C (1 / 2) * ((C R - ∑ j, X j ^ 2)
        + ∑ j ∈ Finset.univ.erase i, X j ^ 2 + (X i + 1) ^ 2) := by
      rw [hk, hsum, ← hc]; linear_combination (-(X i : MvPolynomial (Fin n) ℝ)) * e
    rw [id]
    exact QS_smul (by norm_num) (QS_add (QS_add hR hS) (QS_sq _))

theorem Bd_all {R : ℝ} (hR : C R - ∑ i, X i ^ 2 ∈ QS G) (f : MvPolynomial (Fin n) ℝ) :
    Bd G f :=
  MvPolynomial.induction_on f (fun a => Bd_C a) (fun _ _ hp hq => Bd_add hp hq)
    (fun _ i hp => Bd_mul hp (Bd_X hR i))

theorem innerMat_gram {l : ℕ} (T : Matrix (Fin l) (Fin q) (MvPolynomial (Fin n) ℝ)) :
    innerMat (Tᵀ * T) G = ∑ k, T k ⬝ᵥ (G *ᵥ T k) := by
  simp only [innerMat, Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.trace,
    Matrix.diag, Matrix.mul_apply, Matrix.transpose_apply, dotProduct, Matrix.mulVec,
    Finset.sum_mul, Finset.mul_sum]
  calc _ = ∑ a, ∑ k, ∑ j, T k a * T k j * G j a :=
          Finset.sum_congr rfl fun a _ => Finset.sum_comm
    _ = ∑ k, ∑ a, ∑ j, T k a * T k j * G j a := Finset.sum_comm
    _ = ∑ k, ∑ j, ∑ a, T k a * T k j * G j a :=
          Finset.sum_congr rfl fun k _ => Finset.sum_comm
    _ = _ := Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ =>
          Finset.sum_congr rfl fun a _ => by ring

/-- Assumption 2 makes `QS G` archimedean. -/
theorem arch (h2 : Assumption2 G) (f : MvPolynomial (Fin n) ℝ) : Bd G f := by
  obtain ⟨r, Sig, ⟨l, T, rfl⟩, ⟨t, g, hg⟩⟩ := h2
  have hR : C (r ^ 2) - ∑ i, X i ^ 2 ∈ QS G := by
    have : C (r ^ 2) - ∑ i, X i ^ 2 = ∑ i, g i ^ 2 + innerMat (Tᵀ * T) G := by
      rw [← hg]; ring
    rw [this, innerMat_gram]
    exact QS_add (QS_sum _ _ fun i _ => QS_sq _) (QS_sum _ _ fun k _ => QS_vec _)
  exact Bd_all hR f

/-! ## B4: Cauchy-Schwarz and the power trick for positive functionals -/

theorem cs (L : MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ) {q : MvPolynomial (Fin n) ℝ}
    (hq : ∀ w, 0 ≤ L (w ^ 2 * q)) (u v : MvPolynomial (Fin n) ℝ) :
    L (u * v * q) ^ 2 ≤ L (u ^ 2 * q) * L (v ^ 2 * q) := by
  have h : ∀ t : ℝ, 0 ≤ L (v ^ 2 * q) * (t * t) + 2 * L (u * v * q) * t + L (u ^ 2 * q) := by
    intro t
    have h0 := hq (u + C t * v)
    have e : (u + C t * v) ^ 2 * q = u ^ 2 * q + C (2 * t) * (u * v * q)
        + C (t * t) * (v ^ 2 * q) := by
      simp only [map_mul, map_ofNat]; ring
    rw [e, map_add, map_add, MvPolynomial.C_mul', MvPolynomial.C_mul', L.map_smul,
      L.map_smul, smul_eq_mul, smul_eq_mul] at h0
    linarith
  have hd := discrim_le_zero h
  unfold discrim at hd
  nlinarith

/-- Power trick: a positive functional is positive on `(N - b²) q` for `q ∈ QS`. -/
theorem pow_trick (L : MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ) (hL1 : L 1 = 1)
    (hL : ∀ p ∈ QS G, 0 ≤ L p) (harch : ∀ f, Bd G f) {q : MvPolynomial (Fin n) ℝ}
    (hq : q ∈ QS G) {b : MvPolynomial (Fin n) ℝ} {N : ℝ} (hN : C N - b ^ 2 ∈ QS G) :
    0 ≤ L ((C N - b ^ 2) * q) := by
  set c : ℕ → ℝ := fun j => L ((b ^ j) ^ 2 * q) with hc
  have cnn : ∀ j, 0 ≤ c j := fun j => hL _ (QS_mul_sq _ hq)
  have hpsd : ∀ w, 0 ≤ L (w ^ 2 * q) := fun w => hL _ (QS_mul_sq _ hq)
  have lc : ∀ j, c (j + 1) ^ 2 ≤ c j * c (j + 2) := by
    intro j
    have := cs L hpsd (b ^ j) (b ^ (j + 2))
    have e1 : b ^ j * b ^ (j + 2) * q = (b ^ (j + 1)) ^ 2 * q := by ring
    rw [e1] at this
    exact this
  -- bounds
  have hN0 : 0 ≤ N := by
    have h1 := hL _ hN
    have h2 := hL _ (QS_sq (G := G) b)
    rw [map_sub, MvPolynomial.C_eq_smul_one, L.map_smul, hL1, smul_eq_mul, mul_one] at h1
    linarith
  have pw : ∀ j, L ((b ^ j) ^ 2) ≤ N ^ j := by
    intro j
    induction j with
    | zero => simp [hL1]
    | succ j ih =>
      have h1 := hL _ (QS_mul_sq (b ^ j) hN)
      have e : (b ^ j) ^ 2 * (C N - b ^ 2) = N • (b ^ j) ^ 2 - (b ^ (j + 1)) ^ 2 := by
        rw [MvPolynomial.smul_eq_C_mul]; ring
      rw [e, map_sub, L.map_smul, smul_eq_mul] at h1
      calc L ((b ^ (j + 1)) ^ 2) ≤ N * L ((b ^ j) ^ 2) := by linarith
        _ ≤ N * N ^ j := mul_le_mul_of_nonneg_left ih hN0
        _ = N ^ (j + 1) := by ring
  obtain ⟨Nq, hNq, hq1, -⟩ := Bd_pos (harch q)
  have cb : ∀ j, c j ≤ Nq * N ^ j := by
    intro j
    have h1 := hL _ (QS_mul_sq (b ^ j) hq1)
    have e : (b ^ j) ^ 2 * (C Nq - q) = Nq • (b ^ j) ^ 2 - (b ^ j) ^ 2 * q := by
      rw [MvPolynomial.smul_eq_C_mul]; ring
    rw [e, map_sub, L.map_smul, smul_eq_mul] at h1
    calc c j ≤ Nq * L ((b ^ j) ^ 2) := by simp only [hc]; linarith
      _ ≤ Nq * N ^ j := mul_le_mul_of_nonneg_left (pw j) hNq.le
  -- goal in terms of c 0, c 1
  have goal : L ((C N - b ^ 2) * q) = N * c 0 - c 1 := by
    have e : (C N - b ^ 2) * q = N • ((b ^ 0) ^ 2 * q) - (b ^ 1) ^ 2 * q := by
      rw [MvPolynomial.smul_eq_C_mul]; ring
    rw [e, map_sub, L.map_smul, smul_eq_mul]
  rw [goal]
  rcases (cnn 0).eq_or_lt with h0 | h0
  · have := lc 0
    rw [← h0, zero_mul] at this
    have : c 1 = 0 := by nlinarith [cnn 1]
    rw [this, ← h0]; simp
  rcases (cnn 1).eq_or_lt with h1 | h1
  · rw [← h1]; nlinarith
  set ρ := c 1 / c 0 with hρ
  have hρc : ρ * c 0 = c 1 := by rw [hρ]; field_simp
  have inv : ∀ j, 0 < c j ∧ ρ * c j ≤ c (j + 1) := by
    intro j
    induction j with
    | zero => exact ⟨h0, hρc.le⟩
    | succ j ih =>
      obtain ⟨hp, hr⟩ := ih
      have hρ0 : 0 < ρ := by rw [hρ]; positivity
      have hp1 : 0 < c (j + 1) := lt_of_lt_of_le (by positivity) hr
      refine ⟨hp1, ?_⟩
      have := lc j
      have : ρ * c (j + 1) * c j ≤ c j * c (j + 2) := by nlinarith
      nlinarith
  have grow : ∀ j, c 0 * ρ ^ j ≤ c j := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      have hρ0 : 0 < ρ := by rw [hρ]; positivity
      calc c 0 * ρ ^ (j + 1) = ρ * (c 0 * ρ ^ j) := by ring
        _ ≤ ρ * c j := mul_le_mul_of_nonneg_left ih hρ0.le
        _ ≤ c (j + 1) := (inv j).2
  by_contra hcon
  rw [not_le] at hcon
  have hρN : N < ρ := by
    rw [hρ, lt_div_iff₀ h0]; linarith
  have hρ0 : 0 < ρ := by rw [hρ]; positivity
  rcases hN0.eq_or_lt with hN | hN
  · have := cb 1
    have := grow 1
    rw [← hN] at *
    simp at *
    nlinarith
  · obtain ⟨j, hj⟩ := pow_unbounded_of_one_lt (Nq / c 0) (by rwa [one_lt_div hN])
    have h2 := cb j
    have h3 := grow j
    rw [div_pow, div_lt_div_iff₀ h0 (pow_pos hN j)] at hj
    linarith

/-! ## B5 (algebraic half) and B6 -/

theorem mul_of_sq (L : MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ)
    (h : ∀ a b : MvPolynomial (Fin n) ℝ, L (b ^ 2 * a) = L (b ^ 2) * L a)
    (a b : MvPolynomial (Fin n) ℝ) : L (b * a) = L b * L a := by
  have e := half_two (n := n)
  set c : MvPolynomial (Fin n) ℝ := C (1 / 2 : ℝ)
  have i1 : b * a = (c * (b + 1)) ^ 2 * a - (c * (b - 1)) ^ 2 * a := by
    linear_combination (-(b * a) * (2 * c + 1)) * e
  have i2 : b = (c * (b + 1)) ^ 2 - (c * (b - 1)) ^ 2 := by
    linear_combination (-b * (2 * c + 1)) * e
  rw [i1, map_sub, h, h]
  conv_rhs => rw [i2, map_sub]
  ring

theorem eq_eval (L : MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ) (hL1 : L 1 = 1)
    (hmul : ∀ a b : MvPolynomial (Fin n) ℝ, L (b * a) = L b * L a)
    (p : MvPolynomial (Fin n) ℝ) : L p = eval (fun i => L (X i)) p := by
  induction p using MvPolynomial.induction_on with
  | C a => rw [MvPolynomial.C_eq_smul_one, L.map_smul, hL1, smul_eq_mul, mul_one]; simp
  | add p r hp hr => rw [map_add, map_add, hp, hr]
  | mul_X p i hp => rw [mul_comm, hmul, hp, eval_mul, eval_X, mul_comm]

theorem mem_Xset (hG : G.IsSymm) (x : Fin n → ℝ) (hx : ∀ p ∈ QS G, 0 ≤ eval x p) :
    x ∈ Xset G := by
  show (G.map (eval x)).PosSemidef
  rw [Matrix.posSemidef_iff_dotProduct_mulVec]
  refine ⟨?_, fun v => ?_⟩
  · ext i j
    simp only [Matrix.conjTranspose_apply, Matrix.map_apply, star_trivial]
    rw [hG.apply i j]
  · have h0 := hx _ (QS_vec (G := G) (fun a => C (v a)))
    have e : eval x ((fun a => C (v a)) ⬝ᵥ (G *ᵥ fun a => C (v a)))
        = star v ⬝ᵥ (G.map (eval x) *ᵥ v) := by
      simp only [dotProduct, Matrix.mulVec, map_sum, map_mul, eval_C, Finset.mul_sum,
        Matrix.map_apply, star_trivial]
    rw [← e]; exact h0

/-! ## B1: the state space, closed and compact in the product topology -/

def St (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)) :
    Set (MvPolynomial (Fin n) ℝ → ℝ) :=
  {L | (∀ a b, L (a + b) = L a + L b) ∧ (∀ (c : ℝ) a, L (c • a) = c * L a) ∧ L 1 = 1 ∧
    ∀ p ∈ QS G, 0 ≤ L p}

/-- A state as a linear map. -/
def toLin {L : MvPolynomial (Fin n) ℝ → ℝ} (h : L ∈ St G) :
    MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ where
  toFun := L
  map_add' := h.1
  map_smul' c a := h.2.1 c a

theorem St_C {L : MvPolynomial (Fin n) ℝ → ℝ} (h : L ∈ St G) (c : ℝ) : L (C c) = c := by
  rw [MvPolynomial.C_eq_smul_one, h.2.1, h.2.2.1, mul_one]

theorem St_C_mul {L : MvPolynomial (Fin n) ℝ → ℝ} (h : L ∈ St G) (c : ℝ)
    (p : MvPolynomial (Fin n) ℝ) : L (C c * p) = c * L p := by
  rw [MvPolynomial.C_mul', h.2.1]

theorem St_isClosed : IsClosed (St G) := by
  have e : St G = ((⋂ a, ⋂ b, {L : MvPolynomial (Fin n) ℝ → ℝ | L (a + b) = L a + L b}) ∩
      (⋂ (c : ℝ), ⋂ a, {L : MvPolynomial (Fin n) ℝ → ℝ | L (c • a) = c * L a}) ∩
      {L | L 1 = 1}) ∩ ⋂ p ∈ QS G, {L | 0 ≤ L p} := by
    ext L
    simp only [St, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
    tauto
  rw [e]
  have ca : ∀ p : MvPolynomial (Fin n) ℝ, Continuous fun L : MvPolynomial (Fin n) ℝ → ℝ => L p :=
    fun p => continuous_apply p
  refine ((IsClosed.inter (isClosed_iInter fun a => isClosed_iInter fun b => ?_)
    (isClosed_iInter fun c => isClosed_iInter fun a => ?_)).inter ?_).inter
    (isClosed_biInter fun p _ => ?_)
  all_goals first
    | exact isClosed_eq (ca _) ((ca _).add (ca _))
    | exact isClosed_eq (ca _) (continuous_const.mul (ca _))
    | exact isClosed_eq (ca _) continuous_const
    | exact isClosed_le continuous_const (ca _)

theorem St_bound (harch : ∀ f, Bd G f) (a : MvPolynomial (Fin n) ℝ) :
    ∃ N : ℝ, ∀ L ∈ St G, L a ∈ Set.Icc (-N) N := by
  obtain ⟨N, h1, h2⟩ := harch a
  refine ⟨N, fun L hL => ⟨?_, ?_⟩⟩
  · have := hL.2.2.2 _ h2
    rw [hL.1, St_C hL] at this; linarith
  · have := hL.2.2.2 _ h1
    have hn : L (-a) = -L a := by
      rw [show -a = (-1 : ℝ) • a by simp, hL.2.1]; ring
    rw [sub_eq_add_neg, hL.1, St_C hL, hn] at this; linarith

theorem St_isCompact (harch : ∀ f, Bd G f) : IsCompact (St G) := by
  choose N hN using St_bound harch
  exact IsCompact.of_isClosed_subset
    (isCompact_univ_pi fun a : MvPolynomial (Fin n) ℝ =>
      (isCompact_Icc : IsCompact (Set.Icc (-N a) (N a))))
    St_isClosed fun L hL => Set.mem_univ_pi.2 fun a => hN a L hL

/-! ## B2: separation by the Riesz extension theorem -/

/-- The cone generated by `QS G` and `-f`. -/
def Cone (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)) (f : MvPolynomial (Fin n) ℝ) :
    PointedCone ℝ (MvPolynomial (Fin n) ℝ) where
  carrier := {p | ∃ r ∈ QS G, ∃ t : ℝ, 0 ≤ t ∧ p = r - C t * f}
  add_mem' := by
    rintro _ _ ⟨r, hr, t, ht, rfl⟩ ⟨r', hr', t', ht', rfl⟩
    exact ⟨r + r', QS_add hr hr', t + t', add_nonneg ht ht', by rw [map_add]; ring⟩
  zero_mem' := ⟨0, QS_zero, 0, le_rfl, by simp⟩
  smul_mem' := by
    rintro ⟨c, hc⟩ _ ⟨r, hr, t, ht, rfl⟩
    refine ⟨C c * r, QS_smul hc hr, c * t, mul_nonneg hc ht, ?_⟩
    show c • (r - C t * f) = _
    rw [MvPolynomial.smul_eq_C_mul, map_mul]; ring

theorem mem_Cone {f p : MvPolynomial (Fin n) ℝ} :
    p ∈ Cone G f ↔ ∃ r ∈ QS G, ∃ t : ℝ, 0 ≤ t ∧ p = r - C t * f := Iff.rfl

theorem exists_state (h2 : Assumption2 G) {f : MvPolynomial (Fin n) ℝ} (hf : f ∉ QS G) :
    ∃ L ∈ St G, L f ≤ 0 := by
  have harch := arch h2
  have h10 : (1 : MvPolynomial (Fin n) ℝ) ≠ 0 := one_ne_zero
  let φ : MvPolynomial (Fin n) ℝ →ₗ.[ℝ] ℝ := LinearPMap.mkSpanSingleton (1 : MvPolynomial (Fin n) ℝ) (1 : ℝ) h10
  have hφ : ∀ x : φ.domain, ∃ c : ℝ, (x : MvPolynomial (Fin n) ℝ) = C c ∧ φ x = c := by
    rintro ⟨x, hx⟩
    have hx' : x ∈ Submodule.span ℝ {(1 : MvPolynomial (Fin n) ℝ)} := hx
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hx'
    refine ⟨c, by rw [MvPolynomial.C_eq_smul_one], ?_⟩
    exact (LinearPMap.mkSpanSingleton'_apply _ _ _ c hx).trans (by simp)
  have hnonneg : ∀ x : φ.domain, (x : MvPolynomial (Fin n) ℝ) ∈ Cone G f → 0 ≤ φ x := by
    intro x hx
    obtain ⟨c, hxc, hφx⟩ := hφ x
    rw [hφx]
    by_contra hc
    push_neg at hc
    obtain ⟨r, hr, t, ht, hrt⟩ := mem_Cone.1 hx
    rw [hxc] at hrt
    rcases ht.eq_or_lt with h0 | h0
    · apply hf
      apply QS_univ_of_neg_one
      have hr' : r = C c := by rw [hrt, ← h0, map_zero, zero_mul, sub_zero]
      have : (-1 : MvPolynomial (Fin n) ℝ) = C (-1 / c) * r := by
        rw [hr', ← map_mul, show -1 / c * c = -1 from div_mul_cancel₀ _ hc.ne, map_neg, map_one]
      rw [this]
      exact QS_smul (div_nonneg_of_nonpos (by norm_num) hc.le) hr
    · apply hf
      have key : C t * f ∈ QS G := by
        have : C t * f = r + C (-c) := by rw [map_neg]; linear_combination hrt
        rw [this]; exact QS_add hr (QS_const (by linarith))
      have : f = C (1 / t) * (C t * f) := by
        rw [← mul_assoc, ← map_mul, show 1 / t * t = 1 by field_simp, map_one, one_mul]
      rw [this]; exact QS_smul (by positivity) key
  have hdense : ∀ y, ∃ x : φ.domain, (x : MvPolynomial (Fin n) ℝ) + y ∈ Cone G f := by
    intro y
    obtain ⟨N, -, hN⟩ := harch y
    have hmem : C N ∈ φ.domain := by
      show C N ∈ Submodule.span ℝ {(1 : MvPolynomial (Fin n) ℝ)}
      rw [MvPolynomial.C_eq_smul_one]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    exact ⟨⟨C N, hmem⟩, mem_Cone.2 ⟨C N + y, hN, 0, le_rfl, by simp⟩⟩
  obtain ⟨g, hg1, hg2⟩ := riesz_extension (Cone G f) φ hnonneg hdense
  have g1 : g 1 = 1 := by
    have hm : (1 : MvPolynomial (Fin n) ℝ) ∈ φ.domain := Submodule.mem_span_singleton_self _
    obtain ⟨c, hc1, hc2⟩ := hφ ⟨1, hm⟩
    have h := hg1 ⟨1, hm⟩
    have hc : c = 1 := by
      have : (C c : MvPolynomial (Fin n) ℝ) = C 1 := by rw [← hc1, MvPolynomial.C_1]
      exact MvPolynomial.C_injective _ _ this
    rw [hc2, hc] at h
    exact h
  refine ⟨g, ⟨fun a b => g.map_add a b, fun c a => by rw [g.map_smul, smul_eq_mul], g1,
    fun p hp => hg2 p (mem_Cone.2 ⟨p, hp, 0, le_rfl, by simp⟩)⟩, ?_⟩
  have := hg2 (-f) (mem_Cone.2 ⟨0, QS_zero, 1, zero_le_one, by simp⟩)
  rw [map_neg] at this
  linarith

/-! ## B5: an extreme state is a character -/

theorem char_of_extreme (harch : ∀ f, Bd G f) {L : MvPolynomial (Fin n) ℝ → ℝ}
    (hL : L ∈ (St G).extremePoints ℝ) (a b : MvPolynomial (Fin n) ℝ) :
    L (b ^ 2 * a) = L (b ^ 2) * L a := by
  rw [mem_extremePoints] at hL
  obtain ⟨hS, hext⟩ := hL
  set Λ := toLin hS with hΛdef
  have hpos : ∀ p ∈ QS G, 0 ≤ Λ p := hS.2.2.2
  have hΛ1 : Λ 1 = 1 := hS.2.2.1
  have hΛC : ∀ (c : ℝ) p, Λ (C c * p) = c * Λ p := fun c p => St_C_mul hS c p
  obtain ⟨M, hM0, hM⟩ := Bd_sq_upper (harch b)
  set N := M + 1 with hNdef
  have hN : C N - b ^ 2 ∈ QS G := by
    have : C N - b ^ 2 = (C M - b ^ 2) + C 1 := by rw [hNdef, map_add]; ring
    rw [this]; exact QS_add hM (QS_const zero_le_one)
  have hNpos : 0 < N := by linarith
  have hβ0 : 0 ≤ Λ (b ^ 2) := hpos _ (QS_sq b)
  have hsplit : ∀ p, Λ ((C N - b ^ 2) * p) = N * Λ p - Λ (b ^ 2 * p) := by
    intro p; rw [sub_mul, map_sub, hΛC]
  have hβN : Λ (b ^ 2) ≤ N := by
    have h1 := hpos _ hN
    have h2 := hsplit 1
    simp only [mul_one] at h2
    rw [hΛ1] at h2
    linarith
  have hq2 : ∀ w, 0 ≤ Λ (w ^ 2 * (C N - b ^ 2)) := fun w => by
    rw [mul_comm]; exact pow_trick Λ hΛ1 hpos harch (QS_sq w) hN
  show Λ (b ^ 2 * a) = Λ (b ^ 2) * Λ a
  rcases hβ0.eq_or_lt with h0 | h0
  · have hcs := cs Λ (q := 1) (fun w => by rw [mul_one]; exact hpos _ (QS_sq w)) b (b * a)
    simp only [mul_one] at hcs
    rw [show b * (b * a) = b ^ 2 * a by ring, ← h0, zero_mul] at hcs
    rw [← h0, zero_mul]
    nlinarith [sq_nonneg (Λ (b ^ 2 * a))]
  rcases hβN.eq_or_lt with h1 | h1
  · have hcs := cs Λ hq2 1 a
    rw [one_pow, one_mul, one_mul] at hcs
    have hz : Λ (C N - b ^ 2) = 0 := by
      have h2 := hsplit 1
      simp only [mul_one] at h2
      rw [hΛ1] at h2
      linarith
    rw [hz, zero_mul] at hcs
    have hz2 : Λ (a * (C N - b ^ 2)) = 0 := by nlinarith [sq_nonneg (Λ (a * (C N - b ^ 2)))]
    rw [mul_comm] at hz2
    have h3 := hsplit a
    rw [hz2] at h3
    rw [h1]; linarith
  set β := Λ (b ^ 2) with hβ
  have hNβ : 0 < N - β := by linarith
  let L1 : MvPolynomial (Fin n) ℝ → ℝ := fun p => Λ (b ^ 2 * p) / β
  let L2 : MvPolynomial (Fin n) ℝ → ℝ := fun p => Λ ((C N - b ^ 2) * p) / (N - β)
  have hL1 : L1 ∈ St G := by
    refine ⟨fun x y => ?_, fun c x => ?_, ?_, fun p hp => ?_⟩
    · simp only [L1]; rw [mul_add, map_add, add_div]
    · simp only [L1]; rw [mul_smul_comm, Λ.map_smul, smul_eq_mul, mul_div_assoc]
    · simp only [L1]; rw [mul_one, div_self h0.ne']
    · exact div_nonneg (hpos _ (QS_mul_sq b hp)) h0.le
  have hL2 : L2 ∈ St G := by
    refine ⟨fun x y => ?_, fun c x => ?_, ?_, fun p hp => ?_⟩
    · simp only [L2]; rw [mul_add, map_add, add_div]
    · simp only [L2]; rw [mul_smul_comm, Λ.map_smul, smul_eq_mul, mul_div_assoc]
    · have h2 := hsplit 1
      simp only [mul_one] at h2
      rw [hΛ1, mul_one] at h2
      simp only [L2]; rw [mul_one, h2]; exact div_self hNβ.ne'
    · exact div_nonneg (pow_trick Λ hΛ1 hpos harch hp hN) hNβ.le
  have hseg : L ∈ openSegment ℝ L1 L2 := by
    refine ⟨β / N, (N - β) / N, div_pos h0 hNpos, div_pos hNβ hNpos, ?_, ?_⟩
    · rw [← add_div]; ring_nf; exact div_self hNpos.ne'
    · funext p
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, L1, L2]
      rw [hsplit p]
      show _ = Λ p
      have := h0.ne'
      have := hNpos.ne'
      have := hNβ.ne'
      field_simp
      all_goals ring
  have := congrFun (hext L1 hL1 L2 hL2 hseg).1 a
  simp only [L1] at this
  rw [div_eq_iff h0.ne'] at this
  rw [this]
  show L a * β = β * L a
  ring

/-! ## B3 + B7: Krein-Milman and the scalar Jacobi representation -/

theorem exists_char (hG : G.IsSymm) (h2 : Assumption2 G) {f : MvPolynomial (Fin n) ℝ}
    (hf : f ∉ QS G) : ∃ x ∈ Xset G, eval x f ≤ 0 := by
  have harch := arch h2
  obtain ⟨L0, hL0, hL0f⟩ := exists_state h2 hf
  have hK := St_isCompact harch
  let l : StrongDual ℝ (MvPolynomial (Fin n) ℝ → ℝ) := -ContinuousLinearMap.proj f
  have hl : ∀ y : MvPolynomial (Fin n) ℝ → ℝ, l y = -(y f) := fun y => rfl
  let F := {x ∈ St G | ∀ y ∈ St G, l y ≤ l x}
  have hexp : IsExposed ℝ (St G) F := fun _ => ⟨l, rfl⟩
  obtain ⟨m, hm, hmin⟩ := hK.exists_isMinOn ⟨L0, hL0⟩ (continuous_apply f).continuousOn
  have hFne : F.Nonempty := ⟨m, hm, fun y hy => by
    rw [hl, hl, neg_le_neg_iff]; exact isMinOn_iff.1 hmin y hy⟩
  obtain ⟨e, he⟩ := (hexp.isCompact hK).extremePoints_nonempty hFne
  have heS := hexp.isExtreme.extremePoints_subset_extremePoints he
  have hef : e f ≤ 0 := by
    have := he.1.2 L0 hL0
    rw [hl, hl, neg_le_neg_iff] at this
    linarith
  have hS := heS.1
  have hmul := mul_of_sq (toLin hS) (fun a b => char_of_extreme harch heS a b)
  have hev := eq_eval (toLin hS) hS.2.2.1 hmul
  refine ⟨fun i => e (X i), mem_Xset hG _ fun p hp => ?_, ?_⟩
  · show 0 ≤ eval (fun i => toLin hS (X i)) p
    rw [← hev]; exact hS.2.2.2 p hp
  · show eval (fun i => toLin hS (X i)) f ≤ 0
    rw [← hev]; exact hef

/-- Scalar Jacobi representation (archimedean Positivstellensatz for `QS G`). -/
theorem jacobi (hG : G.IsSymm) (h2 : Assumption2 G) {f : MvPolynomial (Fin n) ℝ}
    (hpos : ∀ x ∈ Xset G, 0 < eval x f) : f ∈ QS G := by
  by_contra hf
  obtain ⟨x, hx, hle⟩ := exists_char hG h2 hf
  linarith [hpos x hx]

/-! ## C1-C3: the matrix quadratic module, rank-one generators, diagonal dominance -/

def QMm (m : ℕ) (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ)) :
    Set (Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ)) :=
  {F | ∃ (Sig0 : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ))
      (Sig1 : Matrix (Fin m × Fin q) (Fin m × Fin q) (MvPolynomial (Fin n) ℝ)),
      IsSOSMat Sig0 ∧ IsSOSMat Sig1 ∧ F = Sig0 + pairM Sig1 G}

variable {m : ℕ}

theorem IsSOSMat_zero {ι : Type*} [Fintype ι] :
    IsSOSMat (0 : Matrix ι ι (MvPolynomial (Fin n) ℝ)) :=
  ⟨0, 0, by simp⟩

theorem IsSOSMat_add {ι : Type*} [Fintype ι] {A B : Matrix ι ι (MvPolynomial (Fin n) ℝ)}
    (hA : IsSOSMat A) (hB : IsSOSMat B) : IsSOSMat (A + B) := by
  obtain ⟨l, T, rfl⟩ := hA
  obtain ⟨l', T', rfl⟩ := hB
  refine ⟨l + l', Matrix.of (Fin.append (fun r => T r) (fun r => T' r)), ?_⟩
  ext i j
  simp only [Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply,
    Fin.sum_univ_add, Fin.append_left, Fin.append_right]

theorem pairM_add (A B : Matrix (Fin m × Fin q) (Fin m × Fin q) (MvPolynomial (Fin n) ℝ)) :
    pairM (A + B) G = pairM A G + pairM B G := by
  ext j k
  simp only [pairM, trBlocks, Matrix.transpose_add, Matrix.add_mul, Matrix.of_apply,
    Matrix.add_apply, Finset.sum_add_distrib]

theorem pairM_zero :
    pairM (0 : Matrix (Fin m × Fin q) (Fin m × Fin q) (MvPolynomial (Fin n) ℝ)) G = 0 := by
  ext j k
  simp [pairM, trBlocks]

theorem QMm_add {A B : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ)} (hA : A ∈ QMm m G)
    (hB : B ∈ QMm m G) : A + B ∈ QMm m G := by
  obtain ⟨S0, S1, h0, h1, rfl⟩ := hA
  obtain ⟨S0', S1', h0', h1', rfl⟩ := hB
  exact ⟨S0 + S0', S1 + S1', IsSOSMat_add h0 h0', IsSOSMat_add h1 h1', by rw [pairM_add]; abel⟩

theorem QMm_zero : (0 : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ)) ∈ QMm m G :=
  ⟨0, 0, IsSOSMat_zero, IsSOSMat_zero, by rw [pairM_zero, add_zero]⟩

theorem QMm_sum {ι : Type*} (s : Finset ι)
    (A : ι → Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ))
    (hA : ∀ i ∈ s, A i ∈ QMm m G) : ∑ i ∈ s, A i ∈ QMm m G := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (QMm_zero (G := G))
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    exact QMm_add (hA a (Finset.mem_insert_self a s))
      (ih fun i hi => hA i (Finset.mem_insert_of_mem hi))

theorem QMm_gram {l : ℕ} (T : Matrix (Fin l) (Fin m) (MvPolynomial (Fin n) ℝ)) :
    Tᵀ * T ∈ QMm m G :=
  ⟨Tᵀ * T, 0, ⟨l, T, rfl⟩, IsSOSMat_zero, by rw [pairM_zero, add_zero]⟩

theorem pairM_gram {l : ℕ} (w : Fin m → ℝ) (v : Fin l → Fin q → MvPolynomial (Fin n) ℝ) :
    pairM ((Matrix.of fun (r : Fin l) (p : Fin m × Fin q) => C (w p.1) * v r p.2)ᵀ *
      Matrix.of fun (r : Fin l) (p : Fin m × Fin q) => C (w p.1) * v r p.2) G
      = Matrix.of fun j k => C (w j * w k) * ∑ r, v r ⬝ᵥ (G *ᵥ v r) := by
  refine Matrix.ext fun j k => ?_
  simp only [pairM, trBlocks, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Matrix.kroneckerMap_apply, Matrix.one_apply, Fintype.sum_prod_type, dotProduct,
    Matrix.mulVec, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.sum_ite_eq',
    Finset.mem_univ, if_true, Finset.mul_sum, Finset.sum_mul, map_mul]
  have e1 : ∀ a, ∑ x, ∑ b, ∑ r, C (w x) * v r b * (C (w j) * v r a) *
      (if x = k then G b a else 0) = ∑ b, ∑ r, C (w k) * v r b * (C (w j) * v r a) * G b a :=
    fun a => by
      rw [Fintype.sum_eq_single k fun x hx => by simp [hx]]
      simp
  rw [Finset.sum_congr rfl fun a _ => e1 a]
  calc ∑ a, ∑ b, ∑ r, C (w k) * v r b * (C (w j) * v r a) * G b a
      = ∑ b, ∑ a, ∑ r, C (w k) * v r b * (C (w j) * v r a) * G b a := Finset.sum_comm
    _ = ∑ b, ∑ r, ∑ a, C (w k) * v r b * (C (w j) * v r a) * G b a :=
        Finset.sum_congr rfl fun b _ => Finset.sum_comm
    _ = ∑ r, ∑ b, ∑ a, C (w k) * v r b * (C (w j) * v r a) * G b a := Finset.sum_comm
    _ = _ := Finset.sum_congr rfl fun r _ => Finset.sum_congr rfl fun b _ =>
        Finset.sum_congr rfl fun a _ => by ring

theorem QMm_rank1 (w : Fin m → ℝ) {f : MvPolynomial (Fin n) ℝ} (hf : f ∈ QS G) :
    (Matrix.of fun j k => C (w j * w k) * f) ∈ QMm m G := by
  obtain ⟨kk, h, l, v, rfl⟩ := hf
  refine ⟨_, _, ⟨kk, Matrix.of fun (i : Fin kk) (j : Fin m) => C (w j) * h i, rfl⟩,
    ⟨l, Matrix.of fun (r : Fin l) (p : Fin m × Fin q) => C (w p.1) * v r p.2, rfl⟩, ?_⟩
  rw [pairM_gram]
  refine Matrix.ext fun j k => ?_
  simp only [Matrix.of_apply, Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply]
  rw [mul_add, Finset.mul_sum]
  refine congrArg₂ (· + ·) (Finset.sum_congr rfl fun i _ => ?_) rfl
  rw [map_mul]; ring

theorem sum_delta (k l : Fin m) :
    ∑ i : Fin m, (if i = k then (1 : ℝ) else 0) * (if i = l then 1 else 0)
      = if k = l then 1 else 0 := by
  rcases eq_or_ne k l with h | h
  · subst h; simp [ite_mul, Finset.sum_ite_eq']
  · simp [ite_mul, Finset.sum_ite_eq', h, h.symm]

/-- C3: diagonal dominance. A symmetric `E` with entries below `a` on `Xset G` is absorbed by
`a m · 1`. -/
theorem dd (hG : G.IsSymm) (h2 : Assumption2 G) (E : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ))
    (hE : E.IsSymm) {a : ℝ} (hb : ∀ x ∈ Xset G, ∀ i j, |eval x (E i j)| < a) :
    Matrix.diagonal (fun _ => C (a * m)) + E ∈ QMm m G := by
  let δ : Fin m → Fin m → ℝ := fun i k => if i = k then 1 else 0
  have hp : ∀ i j, C (1 / 4 : ℝ) * (C a + E i j) ∈ QS G := fun i j => jacobi hG h2 fun x hx => by
    have := abs_lt.1 (hb x hx i j)
    simp only [eval_mul, eval_add, eval_C]; linarith
  have hm : ∀ i j, C (1 / 4 : ℝ) * (C a - E i j) ∈ QS G := fun i j => jacobi hG h2 fun x hx => by
    have := abs_lt.1 (hb x hx i j)
    simp only [eval_mul, eval_sub, eval_C]; linarith
  have term : ∀ i j k l,
      C ((δ i k + δ j k) * (δ i l + δ j l)) * (C (1 / 4 : ℝ) * (C a + E i j))
        + C ((δ i k - δ j k) * (δ i l - δ j l)) * (C (1 / 4 : ℝ) * (C a - E i j))
      = C ((1 / 2 * a) * (δ i k * δ i l) + (1 / 2 * a) * (δ j k * δ j l))
        + ((1 / 2 : ℝ) • (δ i k • δ j l • E i j) + (1 / 2 : ℝ) • (δ j k • δ i l • E i j)) := by
    intro i j k l
    simp only [MvPolynomial.smul_eq_C_mul, map_mul, map_add, map_sub]
    have h4 : (C (1 / 2 : ℝ) : MvPolynomial (Fin n) ℝ) = C (1 / 4) + C (1 / 4) := by
      rw [← map_add]; norm_num
    rw [h4]; ring
  have key : Matrix.diagonal (fun _ => C (a * m)) + E = ∑ i, ∑ j,
      ((Matrix.of fun k l => C ((δ i k + δ j k) * (δ i l + δ j l)) *
          (C (1 / 4 : ℝ) * (C a + E i j)))
        + Matrix.of fun k l => C ((δ i k - δ j k) * (δ i l - δ j l)) *
          (C (1 / 4 : ℝ) * (C a - E i j))) := by
    refine Matrix.ext fun k l => ?_
    simp only [Matrix.add_apply, Matrix.sum_apply, Matrix.of_apply, Matrix.diagonal_apply]
    rw [Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => term i j k l]
    simp only [Finset.sum_add_distrib]
    have r1 : ∑ i : Fin m, ∑ j : Fin m,
        ((1 / 2 * a) * (δ i k * δ i l) + (1 / 2 * a) * (δ j k * δ j l))
        = if k = l then a * m else 0 := by
      have hS : ∑ i, δ i k * δ i l = if k = l then 1 else 0 := sum_delta k l
      calc _ = ∑ i : Fin m, ((m : ℝ) * ((1 / 2 * a) * (δ i k * δ i l))
              + (1 / 2 * a) * ∑ j : Fin m, δ j k * δ j l) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
              nsmul_eq_mul, ← Finset.mul_sum]
        _ = (m : ℝ) * (1 / 2 * a) * (∑ i, δ i k * δ i l)
              + (m : ℝ) * ((1 / 2 * a) * ∑ j : Fin m, δ j k * δ j l) := by
            rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
              nsmul_eq_mul, ← Finset.mul_sum, ← Finset.mul_sum]
            ring
        _ = _ := by rw [hS]; split_ifs <;> ring
    have r2 : ∑ i : Fin m, ∑ j : Fin m, δ i k • δ j l • E i j = E k l := by
      simp [δ, ite_smul, Finset.sum_ite_eq']
    have r3 : ∑ i : Fin m, ∑ j : Fin m, δ j k • δ i l • E i j = E k l := by
      simp [δ, ite_smul, Finset.sum_ite_eq', hE.apply k l]
    have r1c : ∑ i : Fin m, ∑ j : Fin m,
        (C ((1 / 2 * a) * (δ i k * δ i l) + (1 / 2 * a) * (δ j k * δ j l)) : MvPolynomial (Fin n) ℝ)
        = C (if k = l then a * m else 0) := by
      rw [← r1]; simp only [map_sum]
    have hA : ∑ i : Fin m, ∑ j : Fin m, (1 / 2 : ℝ) • (δ i k • δ j l • E i j)
        = (1 / 2 : ℝ) • E k l := by
      rw [← r2]; simp only [Finset.smul_sum]
    have hB : ∑ i : Fin m, ∑ j : Fin m, (1 / 2 : ℝ) • (δ j k • δ i l • E i j)
        = (1 / 2 : ℝ) • E k l := by
      rw [← r3]; simp only [Finset.smul_sum]
    rw [r1c, hA, hB, ← add_smul, show (1 / 2 : ℝ) + 1 / 2 = 1 by norm_num, one_smul]
    split_ifs <;> simp
  rw [key]
  exact QMm_sum _ _ fun i _ => QMm_sum _ _ fun j _ =>
    QMm_add (QMm_rank1 _ (hp i j)) (QMm_rank1 _ (hm i j))

/-! ## C4-C7: compactness, spectral entry bounds, square-root approximation, assembly -/

theorem QS_eval_nonneg {x : Fin n → ℝ} (hx : x ∈ Xset G) {p : MvPolynomial (Fin n) ℝ}
    (hp : p ∈ QS G) : 0 ≤ eval x p := by
  obtain ⟨k, h, l, v, rfl⟩ := hp
  have hx' : (G.map (eval x)).PosSemidef := hx
  have hpsd := (Matrix.posSemidef_iff_dotProduct_mulVec.1 hx').2
  rw [eval_add, map_sum, map_sum]
  refine add_nonneg (Finset.sum_nonneg fun i _ => by rw [eval_pow]; positivity)
    (Finset.sum_nonneg fun j _ => ?_)
  have h0 := hpsd (fun a => eval x (v j a))
  have e : eval x (v j ⬝ᵥ (G *ᵥ v j))
      = star (fun a => eval x (v j a)) ⬝ᵥ (G.map (eval x) *ᵥ fun a => eval x (v j a)) := by
    simp only [dotProduct, Matrix.mulVec, map_sum, map_mul, Finset.mul_sum, Matrix.map_apply,
      star_trivial]
  rw [e]; exact h0

theorem Xset_closed (hG : G.IsSymm) : IsClosed (Xset G) := by
  have e : Xset G = ⋂ v : Fin q → ℝ, {x | 0 ≤ star v ⬝ᵥ ((G.map (eval x)) *ᵥ v)} := by
    ext x
    simp only [Set.mem_iInter, Set.mem_setOf_eq]
    constructor
    · intro hx v
      have hx' : (G.map (eval x)).PosSemidef := hx
      exact (Matrix.posSemidef_iff_dotProduct_mulVec.1 hx').2 v
    · intro h
      show (G.map (eval x)).PosSemidef
      rw [Matrix.posSemidef_iff_dotProduct_mulVec]
      refine ⟨?_, h⟩
      ext i j
      simp only [Matrix.conjTranspose_apply, Matrix.map_apply, star_trivial]
      rw [hG.apply i j]
  rw [e]
  refine isClosed_iInter fun v => isClosed_le continuous_const ?_
  simp only [dotProduct, Matrix.mulVec, Matrix.map_apply]
  exact continuous_finsetSum _ fun i _ => continuous_const.mul
    (continuous_finsetSum _ fun j _ => (MvPolynomial.continuous_eval _).mul continuous_const)

theorem Xset_compact (hG : G.IsSymm) (h2 : Assumption2 G) : IsCompact (Xset G) := by
  have harch := arch h2
  choose N hN using fun i => harch (X i : MvPolynomial (Fin n) ℝ)
  refine IsCompact.of_isClosed_subset
    (isCompact_univ_pi fun i => (isCompact_Icc : IsCompact (Set.Icc (-N i) (N i))))
    (Xset_closed hG) fun x hx => Set.mem_univ_pi.2 fun i => ⟨?_, ?_⟩
  · have := QS_eval_nonneg hx (hN i).2
    simp only [eval_add, eval_C, eval_X] at this; linarith
  · have := QS_eval_nonneg hx (hN i).1
    simp only [eval_sub, eval_C, eval_X] at this; linarith

theorem c4 (hK : IsCompact (Xset G)) (F : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ))
    (hpd : ∀ x ∈ Xset G, (F.map (eval x)).PosDef) :
    ∃ μ N : ℝ, 0 < μ ∧ ∀ x ∈ Xset G, ∀ v : EuclideanSpace ℝ (Fin m), ‖v‖ = 1 →
      μ ≤ star ⇑v ⬝ᵥ ((F.map (eval x)) *ᵥ ⇑v) ∧ star ⇑v ⬝ᵥ ((F.map (eval x)) *ᵥ ⇑v) ≤ N := by
  set S := Xset G ×ˢ Metric.sphere (0 : EuclideanSpace ℝ (Fin m)) 1 with hSdef
  have hS : IsCompact S := hK.prod (isCompact_sphere _ _)
  let g : (Fin n → ℝ) × EuclideanSpace ℝ (Fin m) → ℝ :=
    fun p => star ⇑p.2 ⬝ᵥ ((F.map (eval p.1)) *ᵥ ⇑p.2)
  have hc : ∀ i, Continuous fun p : (Fin n → ℝ) × EuclideanSpace ℝ (Fin m) => p.2 i :=
    fun i => by fun_prop
  have he : ∀ i j, Continuous fun p : (Fin n → ℝ) × EuclideanSpace ℝ (Fin m) =>
      eval p.1 (F i j) := fun i j => (MvPolynomial.continuous_eval _).comp continuous_fst
  have hg : Continuous g := by
    have : g = fun p => ∑ i, p.2 i * ∑ j, eval p.1 (F i j) * p.2 j := by
      funext p
      simp only [g, dotProduct, Matrix.mulVec, Matrix.map_apply, Pi.star_apply, star_trivial]
    rw [this]
    exact continuous_finsetSum _ fun i _ => (hc i).mul
      (continuous_finsetSum _ fun j _ => (he i j).mul (hc j))
  have memS : ∀ x ∈ Xset G, ∀ v : EuclideanSpace ℝ (Fin m), ‖v‖ = 1 → (x, v) ∈ S :=
    fun x hx v hv => ⟨hx, by simpa using hv⟩
  rcases S.eq_empty_or_nonempty with hE | hne
  · refine ⟨1, 0, one_pos, fun x hx v hv => ?_⟩
    have := memS x hx v hv
    rw [hE] at this
    simp at this
  · obtain ⟨p, hp, hmin⟩ := hS.exists_isMinOn hne hg.continuousOn
    obtain ⟨p', hp', hmax⟩ := hS.exists_isMaxOn hne hg.continuousOn
    refine ⟨g p, g p', ?_, fun x hx v hv =>
      ⟨isMinOn_iff.1 hmin (x, v) (memS x hx v hv), isMaxOn_iff.1 hmax (x, v) (memS x hx v hv)⟩⟩
    have hpd' := (Matrix.posDef_iff_dotProduct_mulVec.1 (hpd p.1 hp.1)).2
    show 0 < star ⇑p.2 ⬝ᵥ ((F.map (eval p.1)) *ᵥ ⇑p.2)
    apply hpd'
    intro h0
    have h1 : ‖p.2‖ = 1 := by simpa using hp.2
    rw [EuclideanSpace.norm_eq] at h1
    simp [h0] at h1

theorem cfc_entry {k : ℕ} (A : Matrix (Fin k) (Fin k) ℝ) (hA : A.IsHermitian) (f : ℝ → ℝ)
    {η : ℝ} (hf : ∀ l, |f (hA.eigenvalues l)| ≤ η) (i j : Fin k) :
    |hA.cfc f i j| ≤ η := by
  set U : Matrix (Fin k) (Fin k) ℝ := (hA.eigenvectorUnitary : Matrix (Fin k) (Fin k) ℝ)
    with hUdef
  have hU : U * star U = 1 := Unitary.mul_star_self_of_mem hA.eigenvectorUnitary.2
  have row : ∀ i, ∑ l, U i l * U i l = 1 := by
    intro i
    have := congrFun (congrFun hU i) i
    simpa [Matrix.mul_apply, Matrix.star_apply] using this
  have e : hA.cfc f i j = ∑ l, U i l * f (hA.eigenvalues l) * U j l := by
    simp [Matrix.IsHermitian.cfc, hUdef, Matrix.mul_apply, Matrix.star_apply,
      Matrix.diagonal_apply]
  rw [e]
  calc |∑ l, U i l * f (hA.eigenvalues l) * U j l|
      ≤ ∑ l, |U i l * f (hA.eigenvalues l) * U j l| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ l, η * ((U i l * U i l + U j l * U j l) / 2) := Finset.sum_le_sum fun l _ => by
        rw [abs_mul, abs_mul]
        have h1 := hf l
        have h2 : |U i l| * |U j l| ≤ (U i l * U i l + U j l * U j l) / 2 := by
          nlinarith [sq_nonneg (|U i l| - |U j l|), sq_abs (U i l), sq_abs (U j l)]
        have h3 : 0 ≤ |U i l| * |U j l| := by positivity
        calc |U i l| * |f (hA.eigenvalues l)| * |U j l|
            = |f (hA.eigenvalues l)| * (|U i l| * |U j l|) := by ring
          _ ≤ η * ((U i l * U i l + U j l * U j l) / 2) :=
            mul_le_mul h1 h2 h3 ((abs_nonneg _).trans h1)
    _ = η := by
        rw [← Finset.mul_sum, ← Finset.sum_div, Finset.sum_add_distrib, row i, row j]; ring

theorem aeval_entry {k : ℕ} (A : Matrix (Fin k) (Fin k) ℝ) (hA : A.IsHermitian)
    (p : Polynomial ℝ) {η : ℝ} (hp : ∀ l, |p.eval (hA.eigenvalues l)| ≤ η) (i j : Fin k) :
    |Polynomial.aeval A p i j| ≤ η := by
  have hA' : IsSelfAdjoint A := hA
  rw [← cfc_polynomial p A hA', hA.cfc_eq]
  exact cfc_entry A hA _ hp i j

theorem aeval_symm {k : ℕ} (A : Matrix (Fin k) (Fin k) ℝ) (hA : A.IsHermitian)
    (p : Polynomial ℝ) : (Polynomial.aeval A p)ᵀ = Polynomial.aeval A p := by
  have hA' : IsSelfAdjoint A := hA
  have h : IsSelfAdjoint (cfc p.eval A) := cfc_predicate _ _
  rw [cfc_polynomial p A hA'] at h
  have := h.star_eq
  rwa [Matrix.star_eq_conjTranspose, Matrix.conjTranspose_eq_transpose_of_trivial] at this

theorem main (hG : G.IsSymm) (h2 : Assumption2 G)
    (F : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ)) (hF : F.IsSymm)
    (hpd : ∀ x ∈ Xset G, (F.map (eval x)).PosDef) : F ∈ QMm m G := by
  rcases Nat.eq_zero_or_pos m with hm | hm
  · subst hm
    have : F = 0 := Matrix.ext fun i => i.elim0
    rw [this]; exact QMm_zero
  obtain ⟨μ, N, hμ, hb⟩ := c4 (Xset_compact hG h2) F hpd
  have hm' : (0 : ℝ) < m := Nat.cast_pos.2 hm
  set c : ℝ := μ / 2 with hc
  set a : ℝ := c / m with ha
  have hcpos : 0 < c := by positivity
  have hapos : 0 < a := by positivity
  set B : ℝ := 2 * max 1 N + 1 with hB
  have hBpos : 0 < B := by have := le_max_left 1 N; linarith
  set ε : ℝ := min 1 (a / (2 * B)) with hε
  have hεpos : 0 < ε := lt_min one_pos (by positivity)
  have hε1 : ε ≤ 1 := min_le_left _ _
  obtain ⟨φ, hφ⟩ := exists_polynomial_near_of_continuousOn μ N (fun t => Real.sqrt (t - c))
    (Real.continuous_sqrt.comp (continuous_id.sub continuous_const)).continuousOn ε hεpos
  set ψ : Polynomial ℝ := Polynomial.X - φ ^ 2 - Polynomial.C c with hψdef
  have hψ : ∀ t ∈ Set.Icc μ N, |ψ.eval t| ≤ ε * B := by
    intro t ht
    have h1 : |φ.eval t - Real.sqrt (t - c)| < ε := hφ t ht
    set s := Real.sqrt (t - c) with hsdef
    have hs0 : 0 ≤ s := Real.sqrt_nonneg _
    have hss : s ^ 2 = t - c := Real.sq_sqrt (by linarith [ht.1])
    have hsle : s ≤ max 1 N := by
      rcases le_or_gt s 1 with h | h
      · exact le_max_of_le_left h
      · exact le_max_of_le_right (by nlinarith [ht.2])
    have e : ψ.eval t = (s - φ.eval t) * (s + φ.eval t) := by
      simp only [hψdef, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_pow,
        Polynomial.eval_C]
      linear_combination -1 * hss
    rw [e, abs_mul]
    have h2 : |s - φ.eval t| ≤ ε := by rw [abs_sub_comm]; exact h1.le
    have h3 : |s + φ.eval t| ≤ B := by
      have := abs_lt.1 h1
      rw [abs_le]; constructor <;> linarith
    exact mul_le_mul h2 h3 (abs_nonneg _) hεpos.le
  have hεB : ε * B < a := by
    have : ε ≤ a / (2 * B) := min_le_right _ _
    calc ε * B ≤ a / (2 * B) * B := mul_le_mul_of_nonneg_right this hBpos.le
      _ = a / 2 := by field_simp
      _ < a := by linarith
  set P := Polynomial.aeval F φ with hPdef
  set R := F - Pᵀ * P with hRdef
  set E := R - Matrix.diagonal (fun _ => (C c : MvPolynomial (Fin n) ℝ)) with hEdef
  have hEsymm : E.IsSymm := by
    show Eᵀ = E
    simp only [hEdef, hRdef, Matrix.transpose_sub, Matrix.transpose_mul,
      Matrix.transpose_transpose, Matrix.diagonal_transpose, hF.eq]
  have hev : ∀ x ∈ Xset G, ∀ i j, |eval x (E i j)| < a := by
    intro x hx i j
    have hA : (F.map (eval x)).IsHermitian := (hpd x hx).1
    have hPx : P.map (eval x) = Polynomial.aeval (F.map (eval x)) φ := by
      have h := Polynomial.aeval_algHom_apply
        ((MvPolynomial.aeval x).mapMatrix :
          Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ) →ₐ[ℝ] Matrix (Fin m) (Fin m) ℝ) F φ
      simp only [AlgHom.mapMatrix_apply] at h
      exact h.symm
    have hQ := aeval_symm _ hA φ
    have key : E.map (eval x) = Polynomial.aeval (F.map (eval x)) ψ := by
      rw [hEdef, hRdef, Matrix.map_sub _ (map_sub (eval x)), Matrix.map_sub _ (map_sub (eval x)),
        Matrix.map_mul, Matrix.transpose_map,
        hPx, hQ, Matrix.diagonal_map (map_zero _)]
      simp only [hψdef, map_sub, map_pow, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, eval_C,
        Matrix.algebraMap_eq_diagonal, sq]
      rfl
    have hentry : eval x (E i j) = Polynomial.aeval (F.map (eval x)) ψ i j := by
      rw [← key]; rfl
    rw [hentry]
    refine lt_of_le_of_lt (aeval_entry _ hA ψ (fun l => hψ _ ?_) i j) hεB
    have hk := hA.eigenvalues_eq l
    rw [RCLike.re_to_real] at hk
    have hn : ‖hA.eigenvectorBasis l‖ = 1 := hA.eigenvectorBasis.orthonormal.1 l
    obtain ⟨hl, hu⟩ := hb x hx _ hn
    rw [hk]; exact ⟨hl, hu⟩
  have hR : R ∈ QMm m G := by
    have h := dd hG h2 E hEsymm hev
    have e : Matrix.diagonal (fun _ => (C (a * m) : MvPolynomial (Fin n) ℝ)) + E = R := by
      rw [show a * (m : ℝ) = c by rw [ha]; field_simp, hEdef]; abel
    rwa [e] at h
  have : F = Pᵀ * P + R := by rw [hRdef]; abel
  rw [this]; exact QMm_add (QMm_gram P) hR

end P95574e4b

open RobustPMI.Hierarchy MvPolynomial in
theorem solution {n m q : ℕ} (G : Matrix (Fin q) (Fin q) (MvPolynomial (Fin n) ℝ))
    (hG : G.IsSymm) (h2 : Assumption2 G)
    (F : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ)) (hF : F.IsSymm)
    (hpd : ∀ x ∈ Xset G, (F.map (eval x)).PosDef) :
    ∃ (Sig0 : Matrix (Fin m) (Fin m) (MvPolynomial (Fin n) ℝ))
      (Sig1 : Matrix (Fin m × Fin q) (Fin m × Fin q) (MvPolynomial (Fin n) ℝ)),
      IsSOSMat Sig0 ∧ IsSOSMat Sig1 ∧ F = Sig0 + pairM Sig1 G := by
  exact P95574e4b.main hG h2 F hF hpd
