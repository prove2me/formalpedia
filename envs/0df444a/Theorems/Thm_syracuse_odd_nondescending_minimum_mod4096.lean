-- title:
--   A 226-residue sieve modulo 4096 for Syracuse orbit minima
-- statement:
--   An odd state at least 1,048,576 which never descends below itself under Syracuse must lie in one of the 226 residues encoded by the displayed bit mask modulo 4096. This applies to a minimum of a cycle and to the minimum of a nonperiodic tail.
-- source:
--   A kernel-checked shortcut affine descent sieve, with half-step and odd-part comparison adapted from immiq's accepted submission 15e9cc1c-1fe1-48ea-9827-5a349c909d76.

import Definitions.Def_syracuseStep
import Mathlib.Logic.Function.Iterate
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.Data.Finset.Card

theorem syracuse_odd_nondescending_minimum_mod4096 :
    ((Finset.range 4096).filter (fun r => ( : ℕ).testBit r = true)).card = 226 ∧
    ∀ x : ℕ, 1048576 ≤ x → x%2=1 → (∀ j : ℕ, x ≤ syracuseStep^[j] x) →
      ( : ℕ).testBit (x%4096) = true := by sorry
