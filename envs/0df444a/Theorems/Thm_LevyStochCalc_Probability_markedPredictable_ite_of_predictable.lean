    (hf : Measurable fun q : ℝ × (Fin n → ℝ) × E => f q.1 q.2.1 q.2.2) :
    MarkedPredictable ℱ ν fun (ω : Ω) (s : ℝ) (e : E) => if 0 < s then f s (Λ s ω) e else 0 := by sorry
