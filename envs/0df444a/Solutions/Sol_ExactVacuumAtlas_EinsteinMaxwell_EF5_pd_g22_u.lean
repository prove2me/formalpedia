open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.EF5
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.EF5
set_option maxHeartbeats 4000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
variable (mu beta Q : ℝ)
theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 2 (gEF5 mu beta 2 2) x = x 1 ^ 2 * (2 * x 2 - 1) / (4 * x 2 ^ 2 * (1 - x 2) ^ 2) := by
  have hu   := domU5_u_pos hx
  have h1u  := domU5_1mu_pos hx
  rw [gEF5_22_fun, pd]
  have hslice : (fun u : ℝ => (Function.update x 2 u) 1 ^ 2 /
                              (4 * (Function.update x 2 u) 2 * (1 - (Function.update x 2 u) 2)))
              = fun u => x 1 ^ 2 / (4 * u * (1 - u)) := by
    funext u; simp [Function.update_apply, show (1 : Fin 5) ≠ 2 from by decide]
  rw [hslice]
  -- rewrite 4*u*(1-u) = 4u - 4u^2 to get a rational function we can differentiate
  have hfun : (fun u : ℝ => x 1 ^ 2 / (4 * u * (1 - u)))
            = fun u => x 1 ^ 2 / (4 * u - 4 * u ^ 2) := by funext u; ring_nf
  rw [hfun]
  have hd : 4 * x 2 - 4 * x 2 ^ 2 ≠ 0 := by nlinarith [hu.le, h1u.le]
  exact ((hasDerivAt_const (x 2) (x 1 ^ 2)).fun_div
    (((hasDerivAt_id' (x 2)).const_mul 4).fun_sub
      ((hasDerivAt_id' (x 2)).fun_pow 2 |>.const_mul 4)) hd).congr_deriv
    (by push_cast; field_simp; ring) |>.deriv
