variable {K : UQ} (B : InvAlg K)

theorem GlobalTheory.UnitLemma.BaseChange.herm_sum_left {ι : Type} (s : Finset ι) (x : B.A) (f : ι → B.A) (z : B.A) :
    B.herm x (∑ k ∈ s, f k) z = ∑ k ∈ s, B.herm x (f k) z := by sorry
