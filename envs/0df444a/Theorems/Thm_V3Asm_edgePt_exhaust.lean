open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

theorem V3Asm.edgePt_exhaust (p : ℕ) [Fact p.Prime] (𝔛 : ModularCurve.DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    (H : V3Asm.SiteHyps p 𝔛 O κ toκ) (hξ : ∀ j, V3Asm.ξ p 𝔛 O κ toκ j ∈ (V3Asm.C p 𝔛 O κ toκ hϖ H).X0) :
    ∀ v w, v ≠ w → ∀ y ∈ ((V3Asm.comp p 𝔛 O κ toκ hϖ H hξ v).support : Set (V3Asm.Y p 𝔛 O κ toκ hϖ H)) ∩ ((V3Asm.comp p 𝔛 O κ toκ hϖ H hξ w).support : Set (V3Asm.Y p 𝔛 O κ toκ hϖ H)),
      ∃ (n : V3Glue.Site.Node p 𝔛 κ) (d : Fin ((V3Asm.width p 𝔛 O κ toκ hϖ H) n)), y = V3Asm.edgePt p 𝔛 O κ toκ hϖ H n d ∧
        ((v = ModularCurve.DRResolvedModelPackage.chainPos (V3Asm.width p 𝔛 O κ toκ hϖ H) n d ∧ w = ModularCurve.DRResolvedModelPackage.chainPos (V3Asm.width p 𝔛 O κ toκ hϖ H) n (d + 1)) ∨ (w = ModularCurve.DRResolvedModelPackage.chainPos (V3Asm.width p 𝔛 O κ toκ hϖ H) n d ∧ v = ModularCurve.DRResolvedModelPackage.chainPos (V3Asm.width p 𝔛 O κ toκ hϖ H) n (d + 1))) := by sorry
