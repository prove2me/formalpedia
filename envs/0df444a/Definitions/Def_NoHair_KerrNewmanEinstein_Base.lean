-- title:
--   Kerr–Newman solves the Einstein equation: Base (block 1 of 13)
-- statement:
--   **Base.** Atoms r, k1, k2, k3, W = 1/(r^2 + a^2 k3^2) of the Kerr–Schild geometry; a small calculus of coordinate partials (`HasCP`); the closed-form polynomial expressions (Christoffel symbols, their divergences, Ricci tensor, field strength) used in later parts.
--
--   This block belongs to a machine-checked proof that the Kerr–Newman metric $g=\eta+f\,k\otimes k$ (Kerr–Schild form, $f=r^2(2mr-e^2)/(r^4+a^2z^2)$) and field $F=dA$, $A=\frac{e r^3}{r^4+a^2z^2}k$, satisfy the Einstein equation $G_{\mu\nu}=2(F_{\mu\alpha}F_\nu{}^\alpha-\tfrac14 g_{\mu\nu}F_{\alpha\beta}F^{\alpha\beta})$ at every point with $r>0$, using the definitions `NoHair_coordinates` and `NoHair_kerrNewman` (statement `NoHair.kerrNewman_einstein`). Everything is expressed through the atoms $r$, $k_1,k_2,k_3$ and $W=1/(r^2+a^2k_3^2)$, which satisfy $k_1^2+k_2^2+k_3^2=1$ and $W(r^2+a^2k_3^2)=1$. The curvature computation becomes polynomial identities modulo these two relations; each identity is closed by `linear_combination` with cofactors precomputed by a Gröbner-basis division. The proof is split into 13 blocks only so that each compiles within the platform's time limit; they contain no `sorry` and use only the standard axioms.
-- source:
--   Original formalization for the Prove2Me mission *No-Hair Conjecture: Uniqueness of Stationary Kerr–Newman Black Holes*. Kerr–Newman metric: E. T. Newman et al., J. Math. Phys. 6 (1965) 918, https://doi.org/10.1063/1.1704351; Kerr–Schild form as in the platform definition `NoHair_kerrNewman`.

/-
Kerr–Newman satisfies the Einstein equation (Kerr–Schild coordinates): Base (1 of 13).
Atoms r, k1, k2, k3, W = 1/(r^2 + a^2 k3^2) of the Kerr–Schild geometry; a small calculus of coordinate partials (`HasCP`); the closed-form polynomial expressions (Christoffel symbols, their divergences, Ricci tensor, field strength) used in later parts.
The development is split into parts only so that each piece compiles within the platform limits.
-/
import Mathlib
import Definitions.Def_NoHair_kerrNewman

set_option autoImplicit false
set_option linter.all false
set_option Elab.async false

open scoped BigOperators
open NoHair

theorem ksRadius_eq' (a : ℝ) : ksRadius a = fun w : E4 => Real.sqrt ((w 1 ^ 2 + w 2 ^ 2 + w 3 ^ 2 - a ^ 2 +
    Real.sqrt ((w 1 ^ 2 + w 2 ^ 2 + w 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * w 3 ^ 2)) / 2) := rfl

theorem ks_Q_pos (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    0 < (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2 +
      Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)) / 2 := by
  rw [ksRadius_eq'] at hz
  exact Real.sqrt_pos.mp hz

theorem ks_sq (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    ksRadius a z ^ 2 = (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2 +
      Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)) / 2 := by
  have h := ks_Q_pos a z hz
  rw [ksRadius_eq']
  exact Real.sq_sqrt h.le

theorem ks_S_sq (a : ℝ) (z : E4) :
    Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2) ^ 2
      = (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2 :=
  Real.sq_sqrt (by positivity)

theorem ks_C (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    ksRadius a z ^ 4 - (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) * ksRadius a z ^ 2 - a ^ 2 * z 3 ^ 2 = 0 := by
  have h1 := ks_sq a z hz
  have h2 := ks_S_sq a z
  set S := Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)
  set P := z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2
  set r := ksRadius a z
  linear_combination (r ^ 2 - P / 2 + S / 2) * h1 + (1 / 4 : ℝ) * h2

theorem ks_S_eq (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)
      = 2 * ksRadius a z ^ 2 - (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) := by
  have h1 := ks_sq a z hz
  linarith

theorem ks_D_pos (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    0 < (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2 := by
  have h1 := ks_sq a z hz
  have hr2 : 0 < ksRadius a z ^ 2 := by positivity
  rcases (show (0:ℝ) ≤ (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2 by positivity).lt_or_eq with h | h
  · exact h
  · exfalso
    rw [← h, Real.sqrt_zero] at h1
    have hP : (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 = 0 := by nlinarith [sq_nonneg (a * z 3)]
    have hP' : z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2 = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hP
    rw [hP'] at h1
    linarith

theorem ks_S_pos (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    0 < 2 * ksRadius a z ^ 2 - (z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) := by
  rw [← ks_S_eq a z hz]
  exact Real.sqrt_pos.mpr (ks_D_pos a z hz)

theorem ks_den_pos (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    0 < ksRadius a z ^ 4 + a ^ 2 * z 3 ^ 2 := by positivity

theorem ksRadius_differentiableAt (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    DifferentiableAt ℝ (ksRadius a) z := by
  have hD := (ks_D_pos a z hz).ne'
  have hQ := (ks_Q_pos a z hz).ne'
  rw [ksRadius_eq']
  fun_prop (disch := assumption)

theorem line_apply (z v : E4) (t : ℝ) (j : Fin 4) : (z + t • v) j = z j + t * v j := by simp

theorem hasDerivAt_line_coord (z v : E4) (j : Fin 4) :
    HasDerivAt (fun t : ℝ => z j + t * v j) (v j) 0 := by
  simpa using ((hasDerivAt_id (0:ℝ)).mul_const (v j)).const_add (z j)

theorem hasDerivAt_ksRadius_line (a : ℝ) (z v : E4) (hz : 0 < ksRadius a z) :
    HasDerivAt (fun t : ℝ => ksRadius a (z + t • v))
      (ksRadius a z * (ksRadius a z ^ 2 * (z 1 * v 1 + z 2 * v 2) + (ksRadius a z ^ 2 + a ^ 2) * z 3 * v 3)
        / (ksRadius a z ^ 4 + a ^ 2 * z 3 ^ 2)) 0 := by
  have e : (fun t : ℝ => ksRadius a (z + t • v)) = fun t : ℝ =>
      Real.sqrt (((z 1 + t * v 1) ^ 2 + (z 2 + t * v 2) ^ 2 + (z 3 + t * v 3) ^ 2 - a ^ 2 +
        Real.sqrt (((z 1 + t * v 1) ^ 2 + (z 2 + t * v 2) ^ 2 + (z 3 + t * v 3) ^ 2 - a ^ 2) ^ 2
          + 4 * a ^ 2 * (z 3 + t * v 3) ^ 2)) / 2) := by
    funext t
    rw [ksRadius_eq']
    simp only [line_apply]
  rw [e]
  have h1 := hasDerivAt_line_coord z v 1
  have h2 := hasDerivAt_line_coord z v 2
  have h3 := hasDerivAt_line_coord z v 3
  have hP := (((h1.pow 2).add (h2.pow 2)).add (h3.pow 2)).sub_const (a ^ 2)
  have hD := (hP.pow 2).add ((h3.pow 2).const_mul (4 * a ^ 2))
  have hD0 := ks_D_pos a z hz
  have hQ0 := ks_Q_pos a z hz
  have hSq := hD.sqrt (by simpa using hD0.ne')
  have hQ := (hP.add hSq).div_const 2
  have hR := hQ.sqrt (by simpa using hQ0.ne')
  convert hR using 1
  · rfl
  have hr0 : Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2 + Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)) / 2) = ksRadius a z := rfl
  simp only [zero_mul, add_zero, Pi.add_apply, Pi.pow_apply, Nat.cast_ofNat,
    show (2:ℕ) - 1 = 1 from rfl, pow_one]
  rw [hr0]
  have hSe := ks_S_eq a z hz
  have hS := ks_S_pos a z hz
  rw [← hSe] at hS
  have hC := ks_C a z hz
  have hden := ks_den_pos a z hz
  have hr1 := hz
  set S := Real.sqrt ((z 1 ^ 2 + z 2 ^ 2 + z 3 ^ 2 - a ^ 2) ^ 2 + 4 * a ^ 2 * z 3 ^ 2)
  set r := ksRadius a z
  field_simp
  linear_combination (2*(2*a^2*r^2*(v 3)*(z 3) - a^2*(v 1)*(z 3)^2*(z 1) - a^2*(v 2)*(z 3)^2*(z 2) - a^2*(v 3)*(z 3)^3 + r^4*(v 1)*(z 1) + r^4*(v 2)*(z 2) + r^4*(v 3)*(z 3))) * hSe + (4*(a^2*(v 3)*(z 3) + r^2*(v 1)*(z 1) + r^2*(v 2)*(z 2) + r^2*(v 3)*(z 3))) * hC

theorem fderiv_eq_of_line {g : E4 → ℝ} {z v : E4} {c : ℝ} (hg : DifferentiableAt ℝ g z)
    (h : HasDerivAt (fun t : ℝ => g (z + t • v)) c 0) : fderiv ℝ g z v = c := by
  have h1 : HasDerivAt (fun t : ℝ => z + t • v) v 0 := by
    simpa using ((hasDerivAt_id (0:ℝ)).smul_const v).const_add z
  have h2 : HasFDerivAt g (fderiv ℝ g z) (z + (0:ℝ) • v) := by
    simpa using hg.hasFDerivAt
  exact (h2.comp_hasDerivAt (0:ℝ) h1).unique h

theorem hasDerivAt_k1_aux {R X1 X2 : ℝ → ℝ} {dr d1 d2 : ℝ} (a : ℝ) (hR : HasDerivAt R dr 0)
    (h1 : HasDerivAt X1 d1 0) (h2 : HasDerivAt X2 d2 0) (hne : R 0 ^ 2 + a ^ 2 ≠ 0) :
    HasDerivAt (fun t => (R t * X1 t + a * X2 t) / (R t ^ 2 + a ^ 2))
      (((dr * X1 0 + R 0 * d1 + a * d2) * (R 0 ^ 2 + a ^ 2)
        - (R 0 * X1 0 + a * X2 0) * (2 * R 0 * dr)) / (R 0 ^ 2 + a ^ 2) ^ 2) 0 := by
  have := ((hR.fun_mul h1).fun_add (h2.const_mul a)).fun_div ((hR.fun_pow 2).add_const (a ^ 2)) hne
  refine this.congr_deriv ?_
  norm_num

theorem hasDerivAt_k2_aux {R X1 X2 : ℝ → ℝ} {dr d1 d2 : ℝ} (a : ℝ) (hR : HasDerivAt R dr 0)
    (h1 : HasDerivAt X1 d1 0) (h2 : HasDerivAt X2 d2 0) (hne : R 0 ^ 2 + a ^ 2 ≠ 0) :
    HasDerivAt (fun t => (R t * X2 t - a * X1 t) / (R t ^ 2 + a ^ 2))
      (((dr * X2 0 + R 0 * d2 - a * d1) * (R 0 ^ 2 + a ^ 2)
        - (R 0 * X2 0 - a * X1 0) * (2 * R 0 * dr)) / (R 0 ^ 2 + a ^ 2) ^ 2) 0 := by
  have := ((hR.fun_mul h2).fun_sub (h1.const_mul a)).fun_div ((hR.fun_pow 2).add_const (a ^ 2)) hne
  refine this.congr_deriv ?_
  norm_num

theorem hasDerivAt_k3_aux {R X3 : ℝ → ℝ} {dr d3 : ℝ} (hR : HasDerivAt R dr 0)
    (h3 : HasDerivAt X3 d3 0) (hne : R 0 ≠ 0) :
    HasDerivAt (fun t => X3 t / R t) ((d3 * R 0 - X3 0 * dr) / R 0 ^ 2) 0 :=
  h3.fun_div hR hne

theorem ksNull_zero (a : ℝ) (w : E4) : ksNull a w 0 = 1 := rfl
theorem ksNull_one (a : ℝ) (w : E4) :
    ksNull a w 1 = (ksRadius a w * w 1 + a * w 2) / (ksRadius a w ^ 2 + a ^ 2) := rfl
theorem ksNull_two (a : ℝ) (w : E4) :
    ksNull a w 2 = (ksRadius a w * w 2 - a * w 1) / (ksRadius a w ^ 2 + a ^ 2) := rfl
theorem ksNull_three (a : ℝ) (w : E4) : ksNull a w 3 = w 3 / ksRadius a w := rfl

/-- directional derivative of `r` -/
noncomputable def drf (a : ℝ) (z v : E4) : ℝ :=
  ksRadius a z * (ksRadius a z ^ 2 * (z 1 * v 1 + z 2 * v 2) + (ksRadius a z ^ 2 + a ^ 2) * z 3 * v 3)
    / (ksRadius a z ^ 4 + a ^ 2 * z 3 ^ 2)

noncomputable def dk1f (a : ℝ) (z v : E4) : ℝ :=
  ((drf a z v * z 1 + ksRadius a z * v 1 + a * v 2) * (ksRadius a z ^ 2 + a ^ 2)
    - (ksRadius a z * z 1 + a * z 2) * (2 * ksRadius a z * drf a z v)) / (ksRadius a z ^ 2 + a ^ 2) ^ 2

noncomputable def dk2f (a : ℝ) (z v : E4) : ℝ :=
  ((drf a z v * z 2 + ksRadius a z * v 2 - a * v 1) * (ksRadius a z ^ 2 + a ^ 2)
    - (ksRadius a z * z 2 - a * z 1) * (2 * ksRadius a z * drf a z v)) / (ksRadius a z ^ 2 + a ^ 2) ^ 2

noncomputable def dk3f (a : ℝ) (z v : E4) : ℝ :=
  (v 3 * ksRadius a z - z 3 * drf a z v) / ksRadius a z ^ 2

theorem ksNull_differentiableAt (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) (i : Fin 4) :
    DifferentiableAt ℝ (fun w => ksNull a w i) z := by
  have hr := ksRadius_differentiableAt a z hz
  have hne : ksRadius a z ^ 2 + a ^ 2 ≠ 0 := by positivity
  have hne' : ksRadius a z ≠ 0 := hz.ne'
  fin_cases i
  · simp only [Fin.zero_eta, ksNull_zero]; fun_prop
  · simp only [Fin.mk_one, ksNull_one]; fun_prop (disch := assumption)
  · show DifferentiableAt ℝ (fun w => ksNull a w 2) z
    simp only [ksNull_two]; fun_prop (disch := assumption)
  · show DifferentiableAt ℝ (fun w => ksNull a w 3) z
    simp only [ksNull_three]; fun_prop (disch := assumption)

theorem fderiv_k1 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) (v : E4) :
    fderiv ℝ (fun w => ksNull a w 1) z v = dk1f a z v := by
  apply fderiv_eq_of_line (ksNull_differentiableAt a z hz 1)
  have hR := hasDerivAt_ksRadius_line a z v hz
  have := hasDerivAt_k1_aux a hR (hasDerivAt_line_coord z v 1) (hasDerivAt_line_coord z v 2)
    (by simp only [zero_smul, add_zero]; positivity)
  have e : (fun t : ℝ => ksNull a (z + t • v) 1) = fun t => (ksRadius a (z + t • v) * (z 1 + t * v 1)
      + a * (z 2 + t * v 2)) / (ksRadius a (z + t • v) ^ 2 + a ^ 2) := by
    funext t; rw [ksNull_one, line_apply, line_apply]
  rw [e]
  refine this.congr_deriv ?_
  simp only [zero_smul, add_zero, zero_mul]
  rfl

theorem fderiv_k2 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) (v : E4) :
    fderiv ℝ (fun w => ksNull a w 2) z v = dk2f a z v := by
  apply fderiv_eq_of_line (ksNull_differentiableAt a z hz 2)
  have hR := hasDerivAt_ksRadius_line a z v hz
  have := hasDerivAt_k2_aux a hR (hasDerivAt_line_coord z v 1) (hasDerivAt_line_coord z v 2)
    (by simp only [zero_smul, add_zero]; positivity)
  have e : (fun t : ℝ => ksNull a (z + t • v) 2) = fun t => (ksRadius a (z + t • v) * (z 2 + t * v 2)
      - a * (z 1 + t * v 1)) / (ksRadius a (z + t • v) ^ 2 + a ^ 2) := by
    funext t; rw [ksNull_two, line_apply, line_apply]
  rw [e]
  refine this.congr_deriv ?_
  simp only [zero_smul, add_zero, zero_mul]
  rfl

theorem fderiv_k3 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) (v : E4) :
    fderiv ℝ (fun w => ksNull a w 3) z v = dk3f a z v := by
  apply fderiv_eq_of_line (ksNull_differentiableAt a z hz 3)
  have hR := hasDerivAt_ksRadius_line a z v hz
  have := hasDerivAt_k3_aux hR (hasDerivAt_line_coord z v 3)
    (by simp only [zero_smul, add_zero]; exact hz.ne')
  have e : (fun t : ℝ => ksNull a (z + t • v) 3) = fun t => (z 3 + t * v 3) / ksRadius a (z + t • v) := by
    funext t; rw [ksNull_three, line_apply]
  rw [e]
  refine this.congr_deriv ?_
  simp only [zero_smul, add_zero, zero_mul]
  rfl

theorem fderiv_k0 (a : ℝ) (z : E4) : fderiv ℝ (fun w => ksNull a w 0) z = 0 := by
  simp only [ksNull_zero]
  exact fderiv_const_apply _

theorem ks_null (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    -(ksNull a z 0) ^ 2 + ksNull a z 1 ^ 2 + ksNull a z 2 ^ 2 + ksNull a z 3 ^ 2 = 0 := by
  rw [ksNull_zero, ksNull_one, ksNull_two, ksNull_three]
  have hC := ks_C a z hz
  have hne : ksRadius a z ^ 2 + a ^ 2 ≠ 0 := by positivity
  have hr := hz.ne'
  set r := ksRadius a z
  field_simp
  linear_combination (-a^2 - r^2) * hC


theorem mul_inv_KS (f : ℝ) (k : Fin 4 → ℝ) (hnull : -(k 0) ^ 2 + k 1 ^ 2 + k 2 ^ 2 + k 3 ^ 2 = 0) :
    (Matrix.of fun μ ν => minkowski μ ν + f * k μ * k ν) *
      (Matrix.of fun μ ν => minkowski μ ν - f * ![-k 0, k 1, k 2, k 3] μ * ![-k 0, k 1, k 2, k 3] ν) = 1 := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.of_apply, Fin.sum_univ_four]
  linear_combination (norm := skip) (-f ^ 2 * k i * ![-k 0, k 1, k 2, k 3] j) * hnull
  fin_cases i <;> fin_cases j <;> simp [minkowski] <;> ring

namespace NoHair.KNE

/-! ## Atoms `R = r, K1, K2, K3` (components of `k`) on `U = {r > 0}` -/

theorem ks_x1 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    z 1 = ksRadius a z * ksNull a z 1 - a * ksNull a z 2 := by
  rw [ksNull_one, ksNull_two]
  have hne : ksRadius a z ^ 2 + a ^ 2 ≠ 0 := by positivity
  field_simp
  ring

theorem ks_x2 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    z 2 = a * ksNull a z 1 + ksRadius a z * ksNull a z 2 := by
  rw [ksNull_one, ksNull_two]
  have hne : ksRadius a z ^ 2 + a ^ 2 ≠ 0 := by positivity
  field_simp
  ring

theorem ks_x3 (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    z 3 = ksRadius a z * ksNull a z 3 := by
  rw [ksNull_three]
  have hne : ksRadius a z ≠ 0 := hz.ne'
  field_simp

theorem ks_rel (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    ksNull a z 1 ^ 2 + ksNull a z 2 ^ 2 + ksNull a z 3 ^ 2 = 1 := by
  have h := ks_null a z hz
  rw [ksNull_zero] at h
  linarith

theorem ksNull_eq_Kv (a : ℝ) (z : E4) :
    ksNull a z = ![1, ksNull a z 1, ksNull a z 2, ksNull a z 3] := by
  funext i
  fin_cases i <;> rfl

/-! ## Coordinate partials along lines -/

/-- `f` is differentiable at `z` with coordinate partials `d k`. -/
structure HasCP (f : E4 → ℝ) (z : E4) (d : Fin 4 → ℝ) : Prop where
  diff : DifferentiableAt ℝ f z
  line : ∀ k, HasDerivAt (fun t : ℝ => f (z + t • coordBasis k)) (d k) 0

namespace HasCP

variable {f g : E4 → ℝ} {z : E4} {df dg : Fin 4 → ℝ}

theorem eq (h : HasCP f z df) (k : Fin 4) : coordPartial f k z = df k :=
  fderiv_eq_of_line h.diff (h.line k)

theorem cst (c : ℝ) (z : E4) : HasCP (fun _ => c) z (fun _ => 0) :=
  ⟨differentiableAt_const c, fun _ => hasDerivAt_const _ c⟩

theorem add (hf : HasCP f z df) (hg : HasCP g z dg) :
    HasCP (fun w => f w + g w) z (fun k => df k + dg k) :=
  ⟨hf.diff.add hg.diff, fun k => (hf.line k).fun_add (hg.line k)⟩

theorem sub (hf : HasCP f z df) (hg : HasCP g z dg) :
    HasCP (fun w => f w - g w) z (fun k => df k - dg k) :=
  ⟨hf.diff.sub hg.diff, fun k => (hf.line k).fun_sub (hg.line k)⟩

theorem neg (hf : HasCP f z df) : HasCP (fun w => -f w) z (fun k => -df k) :=
  ⟨hf.diff.neg, fun k => (hf.line k).fun_neg⟩

theorem mul (hf : HasCP f z df) (hg : HasCP g z dg) :
    HasCP (fun w => f w * g w) z (fun k => df k * g z + f z * dg k) :=
  ⟨hf.diff.mul hg.diff, fun k => by
    have h := (hf.line k).fun_mul (hg.line k)
    simp only [zero_smul, add_zero] at h
    exact h⟩

theorem div (hf : HasCP f z df) (hg : HasCP g z dg) (hne : g z ≠ 0) :
    HasCP (fun w => f w / g w) z (fun k => (df k * g z - f z * dg k) / g z ^ 2) :=
  ⟨by have h1 := hf.diff; have h2 := hg.diff; fun_prop (disch := exact hne), fun k => by
    have h := (hf.line k).fun_div (hg.line k) (by simpa only [zero_smul, add_zero] using hne)
    simp only [zero_smul, add_zero] at h
    exact h⟩

theorem pow (hf : HasCP f z df) (n : ℕ) :
    HasCP (fun w => f w ^ n) z (fun k => (n : ℝ) * f z ^ (n - 1) * df k) :=
  ⟨hf.diff.pow n, fun k => by
    have h := (hf.line k).fun_pow n
    simp only [zero_smul, add_zero] at h
    exact h⟩

theorem of_fderiv (hd : DifferentiableAt ℝ f z) (h : ∀ k, fderiv ℝ f z (coordBasis k) = df k) :
    HasCP f z df :=
  ⟨hd, fun k => by
    have h1 : HasDerivAt (fun t : ℝ => z + t • coordBasis k) (coordBasis k) 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const (coordBasis k)).const_add z
    have h2 : HasFDerivAt f (fderiv ℝ f z) (z + (0:ℝ) • coordBasis k) := by
      simpa using hd.hasFDerivAt
    have h3 := h2.comp_hasDerivAt (0:ℝ) h1
    rw [h k] at h3
    exact h3⟩

theorem congr_d (h : HasCP f z df) (hd : ∀ k, df k = dg k) : HasCP f z dg :=
  ⟨h.diff, fun k => (hd k) ▸ h.line k⟩

end HasCP

theorem hasCP_coord (z : E4) (j : Fin 4) : HasCP (fun w => w j) z (fun k => coordBasis k j) :=
  ⟨by fun_prop, fun k => by simpa [line_apply] using hasDerivAt_line_coord z (coordBasis k) j⟩

/-- Coordinate partials vanish in the time direction for functions of the spatial atoms. -/
theorem time_shift (z : E4) (t : ℝ) (j : Fin 4) (hj : j ≠ 0) : (z + t • coordBasis 0) j = z j := by
  rw [line_apply]
  simp [coordBasis, hj]

theorem ksRadius_time (a : ℝ) (z : E4) (t : ℝ) : ksRadius a (z + t • coordBasis 0) = ksRadius a z := by
  simp only [ksRadius, time_shift z t 1 (by decide), time_shift z t 2 (by decide),
    time_shift z t 3 (by decide)]

theorem ksNull_time (a : ℝ) (z : E4) (t : ℝ) (i : Fin 4) : ksNull a (z + t • coordBasis 0) i = ksNull a z i := by
  simp only [ksNull, ksRadius_time, time_shift z t 1 (by decide), time_shift z t 2 (by decide),
    time_shift z t 3 (by decide)]

theorem cp_time (a : ℝ) (Φ : ℝ → ℝ → ℝ → ℝ → ℝ) (y : E4) :
    coordPartial (fun w => Φ (ksRadius a w) (ksNull a w 1) (ksNull a w 2) (ksNull a w 3)) 0 y = 0 := by
  unfold coordPartial
  by_cases hd : DifferentiableAt ℝ (fun w => Φ (ksRadius a w) (ksNull a w 1) (ksNull a w 2) (ksNull a w 3)) y
  · apply fderiv_eq_of_line hd
    simp only [ksRadius_time, ksNull_time]
    exact hasDerivAt_const _ _
  · rw [fderiv_zero_of_not_differentiableAt hd]
    rfl

/-- The atom `W = 1/(r² + a² k₃²)`. -/
noncomputable def Wf (a : ℝ) (w : E4) : ℝ := 1 / (ksRadius a w ^ 2 + a ^ 2 * ksNull a w 3 ^ 2)

theorem ks_W (a : ℝ) (z : E4) (hz : 0 < ksRadius a z) :
    Wf a z * (ksRadius a z ^ 2 + a ^ 2 * ksNull a z 3 ^ 2) = 1 := by
  have hS : ksRadius a z ^ 2 + a ^ 2 * ksNull a z 3 ^ 2 ≠ 0 := by positivity
  unfold Wf
  field_simp

