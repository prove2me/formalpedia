  set s1 := ((s.upd NLogN.V RV).upd NLogN.DX RX).upd NLogN.ARG (.int a :: .int b :: s.G NLogN.ARG) with hs1
  have h1 : NLogN.IRuns I iprog (.seq (.op (.mv NLogN.DX NLogN.ARG)) (.op (.mv NLogN.V NLogN.ARG))) s s1 (500 * (n + 2)) := by
    apply NLogN.IRuns.of_runsTo 0
