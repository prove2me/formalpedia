theorem solution {iprog : Fin 1 → NLogN.IStmt NLogN.HS 1} (H : NLogN.KFR.Lem13ILP iprog) :
    ∃ Kc : ℝ, 0 < Kc ∧ ∀ (Isym : List NLogN.Sym) {K m r Z : ℕ}, 6 ≤ K → 3 ≤ m → 1 ≤ r →
      80 * Z * (Z + 2) ≤ 2 ^ K →
      NLogN.KFN.RowHyp Isym iprog K m r Z (NLogN.KFR.PsiR r Z) (Kc * (K + 2) + 1) τ50 := by
  obtain ⟨code, Kc, hKc, H⟩ := H
  refine ⟨Kc, hKc, fun Isym K m r Z hK hm hr hKZ => ?_⟩
  intro k pos t S0 B hinj hpos haff hS0 hB hZ i j hij
  obtain ⟨codeR, hc⟩ := NLogN.KFR.rowImpl_of_lem13 H Isym hK hm hr pos t S0 B hinj hpos haff hS0 hB i j hij
  refine ⟨codeR, _, hc, fun w => ?_⟩
  have hcard : m * m ^ k ≤ t := by
    have := Fintype.card_le_of_injective (fun p => (⟨pos p, hpos p⟩ : Fin t))
      (fun a b h => hinj (by simpa using h))
    simpa using this
  have ht : t < Z := by
    have h1 := NLogN.zsz_le_iff.1 hZ
    rw [Int.natAbs_natCast] at h1
    have h2 : 2 ^ t ≤ B * 2 ^ t * S0 * r := by
      calc 2 ^ t = 1 * 2 ^ t * 1 * 1 := by ring
        _ ≤ B * 2 ^ t * S0 * r := by gcongr
    have h3 : 2 ^ t < 2 ^ Z := by omega
    exact (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3
  have hf : 1 ≤ m ^ k := Nat.one_le_pow _ _ (by omega)
  have hfZ : m ^ k ≤ Z := by
    have : m ^ k ≤ m * m ^ k := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hn : 1 ≤ B * 2 ^ t * S0 := Nat.one_le_iff_ne_zero.2 (by positivity)
  have := NLogN.KFR.ceil_bnd_le hKc (by omega) hf hfZ hKZ hn hZ w
  rw [Nat.cast_pow] at this
  exact this
