-- title:
--   Theorem 5.4(3), p. 16 — two-sided exit and upward first passage of an MBI
-- statement:
--   Let $(X,\mathbb P)$ be a Markov branching process with immigration (MBI) with parameters $(\alpha,\mu,p,\beta,\nu,q)$ on $E=\{0,1,2,\dots\}$, with Q-matrix (5.1), branching mechanism $\psi$, immigration mechanism $\phi$, root $s_0$, and the sequences $W,\pi,\varpi$ of Lemma 5.1 (with $W(z)=0$ for $z\le -1$). For $x,y\ge 0$ let
--   $$\mathscr H^{[y}(x)=\sum_{l=0}^{y-x-1}\pi(y-x-1-l)\,\frac{(W\star\varpi)(l)}{l+x+1}\qquad(=0\text{ if }y\le x),$$. In every regime (transient, recurrent or MBP), for integers $0\le a\le x\le b-1$:
--   $$\mathbb P_x(T_a<T_{[b}\wedge\zeta)=\frac{\mathscr H^{[b}(x)}{\mathscr H^{[b}(a)},$$
--   $$\mathbb P_x(T_{(a,b)^\complement}<\zeta)=1-\sum_{z=a+1}^{b-1}(pz+q)\Big(\frac{\mathscr H^{[b}(x)}{\mathscr H^{[b}(a)}\,\mathscr H^{[z}(a)-\mathscr H^{[z}(x)\Big),$$
--   $$\mathbb P_x(T_{[b}<\zeta)=\begin{cases}1-\sum_{z=0}^{b-1}(pz+q)\Big(\frac{\pi(z)}{\pi(b)}\mathscr H^{[b}(x)-\mathscr H^{[z}(x)\Big), & \beta+q>0,\\[6pt] 1+p\sum_{z=0}^{b-x-2}W(z)-\frac{W(b-x-1)}{W(b-1)}\Big(1+p\sum_{z=0}^{b-2}W(z)\Big), & \beta=q=0.\end{cases}$$
--
--   This is item (3) of Theorem 5.4: one-sided-before-two-sided hitting, exit from $(a,b)$, and upward first passage over $b$.
--
--   **Formalization Note** This is one item of `SkipFreeFluct.MBI.theorem_5_4`, stated verbatim with the same encodings (the MBI is the chain generated by `mbiQ P` on `Set.Ici (0 : ℤ)`; probabilities and the resolvent are $\mathbb R_{\ge0}\cup\{\infty\}$-valued path sums compared through `.toReal`; transience is $G(x,x)<\infty$ for all $x$, recurrence $G(x,x)=\infty$; MBP means $\beta=q=0$). Sums $\sum_{z=a+1}^{b-1}$, $\sum_{z=0}^{b-1}$, $\sum_{z=0}^{b-x-2}$, $\sum_{z=0}^{b-2}$ are `Finset.Ioo a b`, `range b`, `range (b - x - 1)`, `range (b - 1)`; the case $\beta=q=0$ is the `else` branch of `0 < β + q`.
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, pp. 15–16, Theorem 5.4(3)

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
import Definitions.Def_SkipFreeFluct_MBI_Model
open scoped ENNReal Topology
open Filter MeasureTheory

namespace SkipFreeFluct.MBI

theorem theorem_5_4_3 (P : MBIParams) (hP : P.Valid) :
    ∀ a x b : ℕ, a ≤ x → x + 1 ≤ b →
      (hitBeforeProb (Set.Ici 0) (mbiQ P) {(a : ℤ)} (Set.Ici (b : ℤ)) x).toReal =
          calH P b x / calH P b a ∧
      (hitProb (Set.Ici 0) (mbiQ P) (Set.Ioo (a : ℤ) b)ᶜ x).toReal =
          1 - ∑ z ∈ Finset.Ioo a b,
            (P.p * z + P.q) * (calH P b x / calH P b a * calH P z a - calH P z x) ∧
      (hitProb (Set.Ici 0) (mbiQ P) (Set.Ici (b : ℤ)) x).toReal =
          if 0 < P.beta + P.q then
            1 - ∑ z ∈ Finset.range b,
              (P.p * z + P.q) * (piSeq P z / piSeq P b * calH P b x - calH P z x)
          else
            1 + P.p * (∑ z ∈ Finset.range (b - x - 1), W P z) -
              W P (b - x - 1) / W P (b - 1) * (1 + P.p * ∑ z ∈ Finset.range (b - 1), W P z) := by sorry

end SkipFreeFluct.MBI
