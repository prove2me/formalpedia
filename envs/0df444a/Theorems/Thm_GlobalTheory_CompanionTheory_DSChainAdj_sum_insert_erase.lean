variable {n : ℕ} {ε : Fin n → Bool}

theorem GlobalTheory.CompanionTheory.DSChainAdj.sum_insert_erase (i : NC ε) (f : Finset (NC ε) → Finset (NC ε) → ℂ) :
    (∑ A : Finset (NC ε), if i ∈ A then 0 else f (insert i A) A) =
      ∑ B : Finset (NC ε), if i ∈ B then f B (B.erase i) else 0 := by sorry
