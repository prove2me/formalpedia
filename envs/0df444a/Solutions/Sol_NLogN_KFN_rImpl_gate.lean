        · exact he t
      rw [gateE, ih (a.sc e) (fun b hb => hl b (List.mem_cons_of_mem _ hb)) he0' he' t]
      simp only [List.map_cons, List.mem_cons]
      by_cases h1 : t = a.t
      · subst h1
        simp only [true_or, if_true, KFG.Atom.sc, Function.update_self, KFG.Atom.E, has, hah, he0]
        split_ifs <;> (have := he a.t; omega)
      · simp only [h1, false_or]
        split_ifs <;> simp [KFG.Atom.sc, Function.update_of_ne h1]
  intro t ht
  rw [key (levA W t0) e (fun a ha => ⟨(levA_src a ha).1, (levA_src a ha).2.1, by
      simp only [levA, List.mem_map, List.mem_filter, List.mem_range] at ha
      obtain ⟨t, ⟨-, hne⟩, rfl⟩ := ha; simpa using hne⟩) he0 he t]
  split_ifs with h
  · rfl
  · by_cases h' : t = t0
    · subst h'; exact he0
    · exfalso; apply h
      simp only [levA, List.map_map, List.mem_map, List.mem_filter, List.mem_range]
      exact ⟨t, ⟨ht, by simpa using h'⟩, rfl⟩

end Scales

section Bounds

theorem cAtom_mono {w w' D D' L W Z : ℕ} (hw : w ≤ w') (hD : D ≤ D') :
    cAtom w D L W Z ≤ cAtom w' D' L W Z := by
  unfold cAtom cPairW
  have := cPair_mono (L := L) (P := 0 * L) (Q := (W - 0 - 1) * L) (P' := 0 * L)
    (Q' := (W - 0 - 1) * L) hw hD le_rfl
  omega

theorem sc_inv (G : ℕ) {a : KFG.Atom} {as : List KFG.Atom} {e : ℕ → ℕ} (hts : NoTS (a :: as))
    (hs : ∀ b ∈ a :: as, e b.s + b.h ≤ G + 1) (he : ∀ t, G ≤ e t ∧ e t ≤ G + 1) :
    (∀ b ∈ as, a.sc e b.s + b.h ≤ G + 1) ∧ (∀ t, G ≤ a.sc e t ∧ a.sc e t ≤ G + 1) ∧
      a.D e ≤ 1 := by
  refine ⟨fun b hb => ?_, fun t => ?_, ?_⟩
  · rw [sc_src hts e hb]; exact hs b (List.mem_cons_of_mem _ hb)
  · simp only [KFG.Atom.sc, Function.update_apply, KFG.Atom.E]
    split_ifs with h
    · have := hs a List.mem_cons_self; have := he a.t
      constructor <;> omega
    · exact he t
  · have h1 := hs a List.mem_cons_self; have h2 := he a.t; have h3 := he a.s
    simp only [KFG.Atom.D, KFG.Atom.al, KFG.Atom.be, KFG.Atom.E]
    omega

theorem gateW_le (G : ℕ) : ∀ (as : List KFG.Atom) (e : ℕ → ℕ) (w : ℕ), NoTS as →
    (∀ a ∈ as, e a.s + a.h ≤ G + 1) → (∀ t, G ≤ e t ∧ e t ≤ G + 1) →
    gateW as e w ≤ w + 3 * as.length
  | [], _, _, _, _, _ => by simp [gateW]
  | a :: as, e, w, hts, hs, he => by
    obtain ⟨h1, h2, h3⟩ := sc_inv G hts hs he
    have := gateW_le G as (a.sc e) (w + a.D e + 2) (NoTS.tail hts) h1 h2
    simp only [gateW, List.length_cons]
    omega

theorem cGate_le (G L W Z : ℕ) : ∀ (as : List KFG.Atom) (e : ℕ → ℕ) (w : ℕ), NoTS as →
    (∀ a ∈ as, e a.s + a.h ≤ G + 1) → (∀ t, G ≤ e t ∧ e t ≤ G + 1) →
    cGate as e w L W Z ≤ as.length * cAtom (w + 3 * as.length) 1 L W Z + 1
  | [], _, _, _, _, _ => by simp [cGate]
  | a :: as, e, w, hts, hs, he => by
    obtain ⟨h1, h2, h3⟩ := sc_inv G hts hs he
    have IH := cGate_le G L W Z as (a.sc e) (w + a.D e + 2) (NoTS.tail hts) h1 h2
    have m1 : cAtom w (a.D e) L W Z ≤ cAtom (w + 3 * (as.length + 1)) 1 L W Z :=
      cAtom_mono (by omega) h3
    have m2 : cAtom (w + a.D e + 2 + 3 * as.length) 1 L W Z ≤
        cAtom (w + 3 * (as.length + 1)) 1 L W Z := cAtom_mono (by omega) le_rfl
    simp only [cGate, List.length_cons]
    nlinarith

end Bounds

section GateStep

theorem gateY_zero {l : List KFG.Atom} (h : ∀ a ∈ l, a.c = (0, 0)) (y : ℕ → ℕ → ℂ) :
    gateY l y = y := by
  funext v p
  simp only [gateY]
  rw [List.sum_eq_zero, add_zero]
  intro x hx
  simp only [List.mem_map] at hx
  obtain ⟨a, ha, rfl⟩ := hx
  split_ifs <;> simp [h a ha, NLogN.KFB.toC]

theorem levOf_props {W : ℕ} {as : List KFG.Atom} (hok : ∀ a ∈ as, a.Ok W ∧ a.h ≤ 1) :
    (∀ a ∈ levOf W as, a.Ok W ∧ a.h ≤ 1) ∧ NoTS (levOf W as) ∧
      (∀ a ∈ levOf W as, a.c = (0, 0)) ∧ (levOf W as).length ≤ W := by
  unfold levOf
  split
  · rename_i a0 h
    have ha0 : a0 ∈ as := List.mem_of_find?_eq_some h
    have ht := (hok a0 ha0).1.1
    exact ⟨levA_ok ht, levA_nots _ _, fun a ha => (levA_src a ha).2.2, levA_len _ _⟩
  · exact ⟨by simp, fun a ha => by simp at ha, by simp, by simp⟩

/-- Scales after a gate step. -/
theorem gate_scales {W : ℕ} {as : List KFG.Atom} (hok : ∀ a ∈ as, a.Ok W ∧ a.h ≤ 1)
    (hts : NoTS as) (F : ℕ) :
    ∀ t < W, gateE (levOf W as) (gateE as fun _ => F) t = F + gδ as := by
  intro t ht
  have hs : ∀ a ∈ as, (fun _ => F) a.s + a.h ≤ F + 1 := fun a ha => by
    have := (hok a ha).2; simp; omega
  have hb := gateE_bnd F as (fun _ => F) hts hs (fun _ => by simp)
  unfold levOf gδ
  split
  · rename_i a0 h
    have ha0 : a0 ∈ as := List.mem_of_find?_eq_some h
    have h1 : a0.h = 1 := by have := List.find?_some h; simpa using this
    have htop := gateE_top F as (fun _ => F) hts hs (fun _ => by simp) a0 ha0 (by simp [h1])
    rw [gateE_levA (hok a0 ha0).1.1 _ htop (fun t => (hb t).2) t ht]
    simp [h]
  · rename_i h
    have h0 : ∀ a ∈ as, a.h = 0 := by
      intro a ha
      have h1 := List.find?_eq_none.1 h a ha
      have h2 := (hok a ha).2
      simp at h1; omega
    simp only [gateE]
    rw [gateE_zero F as _ h0 (fun _ => rfl)]
    simp [h]

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

theorem yR_val {r : ℕ} (hr : 0 < r) (X : Fin W → List (Fin r → ℂ)) (q : Fin W) (j : ℕ)
    (c : Fin r) : yR r X q.val (j * r + c) = (X q).getD j 0 c := by
  have h1 : (j * r + c) / r = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt c.isLt, zero_add]
  have h2 : (j * r + c) % r = c := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt c.isLt]
  simp only [yR, dif_pos (And.intro q.isLt hr), h1, Fin.eta]
  have hc : (⟨(j * r + c) % r, Nat.mod_lt _ hr⟩ : Fin r) = c := Fin.ext h2
  rw [hc]

end GateStep

end NLogN.KFN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
theorem solution (T : Butterfly.Op κ) (as : List NLogN.KFG.Atom) (hok : ∀ a ∈ as, a.Ok W ∧ a.h ≤ 1)
    (hts : NLogN.KFG.NoTS as) {r n : ℕ} (hr : 0 < r) (st : Fin m × κ → ℕ) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * (W * (n * r)) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.RImpl r n st ((P8Lift.RStep.gate (NLogN.KFG.gateMat W as) : P8Lift.RStep (Fin W) m).den T) (NLogN.KFN.gateC W (n * r) as)
      (NLogN.KFN.gδ as) (3 * as.length + 3 * W) (NLogN.KFN.cGateC W (n * r) Z as.length) := by
  intro s f zs l X F w hC h0 hx hX hb
  set L := n * r
  have hok' : ∀ a ∈ as, a.Ok W := fun a ha => (hok a ha).1
  obtain ⟨lok, lts, lc, llen⟩ := NLogN.KFN.levOf_props hok
  have E0 := NLogN.KFN.enc_of_rec hr hX hx
  obtain ⟨E1, B1, H1⟩ := NLogN.KFG.gate_fsp s l Z hZ as hok' hts (fun _ => F) f zs (NLogN.KFN.yR r X) w E0 h0 hC.p hb
  set zs1 := NLogN.KFG.gateL as (fun _ => F) L zs
  set e1 := NLogN.KFG.gateE as (fun _ => F)
  obtain ⟨E2, B2, H2⟩ := NLogN.KFG.gate_fsp s l Z hZ (NLogN.KFN.levOf W as) (fun a ha => (lok a ha).1) lts e1
    (Function.update f 0 (NLogN.KFB.gflat zs1 ++ l)) zs1 (NLogN.KFG.gateY as (NLogN.KFN.yR r X)) (NLogN.KFG.gateW as (fun _ => F) w) E1
    (by simp) (hC.p.upd0 _) B1
  have hs : ∀ a ∈ as, (fun _ => F) a.s + a.h ≤ F + 1 := fun a ha => by
    have := (hok a ha).2; simp; omega
  have hb1 := NLogN.KFN.gateE_bnd F as (fun _ => F) hts hs (fun _ => by simp)
  have e0eq : (fun _ : ℕ => F) = NLogN.KFN.shE F (fun _ => 0) := by funext; simp [NLogN.KFN.shE]
  have e1eq : e1 = NLogN.KFN.shE F (NLogN.KFG.gateE as fun _ => 0) := by simp only [e1]; rw [e0eq, NLogN.KFN.gateE_shE]
  refine ⟨NLogN.KFG.gateL (NLogN.KFN.levOf W as) e1 L zs1, ?_, ?_, ?_⟩
  · refine NLogN.KFN.rec_of_enc hr (fun v => NLogN.KFN.length_roleOpF _ _ _ _ _)
      (NLogN.KFN.enc_congr_e E2 (NLogN.KFN.gate_scales hok hts F)) (fun v j hj c => ?_)
    rw [NLogN.KFN.gateY_zero lc, NLogN.KFN.roleOpF_gate, List.getD_eq_getElem _ _ (by simpa using hj),
      List.getElem_map, List.getElem_range, Finset.sum_apply]
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [NLogN.KFG.gateMat_sum as hok' (fun q => (X q).getD j 0 c) (fun q => NLogN.KFN.yR r X q (j * r + c))
      (fun q => NLogN.KFN.yR_val hr X q j c)]
    simp only [NLogN.KFG.gateY]
    rw [NLogN.KFN.yR_val hr X v j c]
  · have w1 := NLogN.KFN.gateW_le F as (fun _ => F) w hts hs (fun _ => by simp)
    have hs2 : ∀ a ∈ NLogN.KFN.levOf W as, e1 a.s + a.h ≤ F + 1 := fun a ha => by
      have h1 : e1 a.s ≤ F + 1 := (hb1 a.s).2
      have := (lok a ha).2
      unfold NLogN.KFN.levOf at ha
      split at ha
      · have := (NLogN.KFN.levA_src a ha).2.1; omega
      · simp at ha
    have w2 := NLogN.KFN.gateW_le F (NLogN.KFN.levOf W as) e1 (NLogN.KFG.gateW as (fun _ => F) w) lts hs2 hb1
    exact B2.mono (by omega)
  · have := H1.seq H2
    rw [Function.update_idem] at this
    have c1 := NLogN.KFN.cGate_le F L W Z as (fun _ => F) w hts hs (fun _ => by simp)
    have hs2 : ∀ a ∈ NLogN.KFN.levOf W as, e1 a.s + a.h ≤ F + 1 := fun a ha => by
      have h1 : e1 a.s ≤ F + 1 := (hb1 a.s).2
      have := (lok a ha).2
      unfold NLogN.KFN.levOf at ha
      split at ha
      · have := (NLogN.KFN.levA_src a ha).2.1; omega
      · simp at ha
    have w1 := NLogN.KFN.gateW_le F as (fun _ => F) w hts hs (fun _ => by simp)
    have c2 := NLogN.KFN.cGate_le F L W Z (NLogN.KFN.levOf W as) e1 (NLogN.KFG.gateW as (fun _ => F) w) lts hs2 hb1
    have m2 : (NLogN.KFN.levOf W as).length * NLogN.KFG.cAtom (NLogN.KFG.gateW as (fun _ => F) w + 3 * (NLogN.KFN.levOf W as).length) 1
        L W Z ≤ W * NLogN.KFG.cAtom (w + 3 * as.length + 3 * W) 1 L W Z :=
      Nat.mul_le_mul llen (NLogN.KFN.cAtom_mono (by omega) le_rfl)
    have hc : NLogN.KFN.gateC W L as = .seq (NLogN.KFG.gateP as (fun _ => F) L) (NLogN.KFG.gateP (NLogN.KFN.levOf W as) e1 L) := by
      unfold NLogN.KFN.gateC; rw [e1eq, NLogN.KFN.gateP_shE, e0eq, NLogN.KFN.gateP_shE]
    rw [hc]
    refine this.mono ?_
    unfold NLogN.KFN.cGateC
    omega
end
