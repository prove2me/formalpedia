open DAREx

theorem solution :
    ∀ p : ℝ, 0 < p → p < 1 →
      0 < phi p ∧ phi p ≤ 1 / 2 ∧
      ∀ t : ℝ, (1 - p) * Real.exp (-t * p) + p * Real.exp (t * (1 - p)) ≤
        Real.exp (phi p * t ^ 2 / 4) :=
