theorem lam_le_p : axl6 P n ≤ 4 * pP6 P n ^ 2 := by
  have hlamC := h.lamC
  have hfC := h.fC
  have hb0 : bP6 n ≠ 0 := by have := bP6_pos n; omega
  have h1 : 2 ^ Nat.log 2 (bP6 n) ≤ bP6 n := Nat.pow_log_le_self 2 hb0
  have h2 : bP6 n ≤ pP6 P n := by
    have : bP6 n ≤ b'P6 P n := by unfold b'P6; exact Nat.le_self_pow (by omega) _
    unfold pP6; omega
  rw [hlamC]
  calc 2 ^ axfC6 P n ≤ 2 ^ (2 * Nat.log 2 (bP6 n) + 2) := Nat.pow_le_pow_right (by norm_num) hfC
    _ = 4 * (2 ^ Nat.log 2 (bP6 n)) ^ 2 := by rw [pow_add, pow_mul']; ring
    _ ≤ 4 * pP6 P n ^ 2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (h1.trans h2) 2)

/-- The three logarithmic arguments are `≤ 64 p3`, `p3 = (Wt+1) p³`. -/
theorem p3_facts :
    2 * axl6 P n ≤ 64 * ((Wt ap + 1) * pP6 P n ^ 3) ∧
    axb6 P n src k ap * (2 * axl6 P n) ≤ 64 * ((Wt ap + 1) * pP6 P n ^ 3) ∧
    4 * axb6 P n src k ap * axl6 P n + 4 ≤ 64 * ((Wt ap + 1) * pP6 P n ^ 3) := by
  have hl := lam_le_p h
  have hb := (wt_facts ap h).2.2.2.1
  have hp := h.p1
  set p := pP6 P n
  set W := Wt ap
  have hp2 : p ^ 2 ≤ p ^ 3 := Nat.pow_le_pow_right hp (by norm_num)
  have hp3 : 1 ≤ p ^ 3 := Nat.one_le_pow _ _ hp
  have hbl : axb6 P n src k ap * axl6 P n ≤ 4 * (W * p ^ 3) := by
    calc axb6 P n src k ap * axl6 P n ≤ (W * p) * (4 * p ^ 2) := Nat.mul_le_mul hb hl
      _ = 4 * (W * p ^ 3) := by ring
  have e : 64 * ((W + 1) * p ^ 3) = 64 * (W * p ^ 3) + 64 * p ^ 3 := by ring
  have e1 : axb6 P n src k ap * (2 * axl6 P n) = 2 * (axb6 P n src k ap * axl6 P n) := by ring
  have e2 : 4 * axb6 P n src k ap * axl6 P n = 4 * (axb6 P n src k ap * axl6 P n) := by ring
  refine ⟨by omega, by rw [e1]; omega, by rw [e2]; omega⟩

theorem L3_le : Real.log (((Wt ap + 1) * pP6 P n ^ 3 : ℕ) : ℝ) + 1 ≤
    K3 P ap * (Real.log (IntMul.lg n) + 1) := by
  have hp1 : (1 : ℝ) ≤ pP6 P n := by exact_mod_cast h.p1
  have hL := lgn_ge n
  have hlp := lgp_le P n
  have hW0 : (0 : ℝ) ≤ Wt ap := Nat.cast_nonneg _
  have hx0 : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  push_cast
  rw [Real.log_mul (by positivity) (pow_ne_zero _ (by linarith)), Real.log_pow]
  push_cast
  have h1 : Real.log ((Wt ap : ℝ) + 1) ≤ Wt ap := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < (Wt ap : ℝ) + 1 by positivity)
    linarith
  have hlp0 : 0 ≤ Real.log (pP6 P n : ℝ) := Real.log_nonneg hp1
  have hWL : (Wt ap : ℝ) * 1 ≤ (Wt ap : ℝ) * (Real.log (IntMul.lg n) + 1) :=
    mul_le_mul_of_nonneg_left hL hW0
  unfold K3
  push_cast
  nlinarith

end ax

