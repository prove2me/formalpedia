theorem NLogN.KFM.srcS_ok_n {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (d' : ℕ) (hd' : d' ≤ IntMul.OpenAI.Glue.dP n) :
    (∀ i : Fin (IntMul.OpenAI.Glue.dP n), Odd (srcS (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) i)) ∧
    (∀ i j : Fin (IntMul.OpenAI.Glue.dP n), i ≠ j → Nat.Coprime (srcS (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) i) (srcS (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) j)) ∧
    ∀ i : Fin (IntMul.OpenAI.Glue.dP n), (4 * IntMul.OpenAI.Glue.dP n - 2) * (if (i : ℕ) < d' then IntMul.OpenAI.Glue.rP n / 2 else IntMul.OpenAI.Glue.rP n) <
        4 * IntMul.OpenAI.Glue.dP n * srcS (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) i ∧
      4 * IntMul.OpenAI.Glue.dP n * srcS (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) i ≤ (4 * IntMul.OpenAI.Glue.dP n - 1) * (if (i : ℕ) < d' then IntMul.OpenAI.Glue.rP n / 2 else IntMul.OpenAI.Glue.rP n) := by sorry
