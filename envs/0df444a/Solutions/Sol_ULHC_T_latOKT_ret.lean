theorem _root_.solution (F : Finset Edge) (c : Pt) (s : Side) (j : ℕ) :
    (latOKT F c s j).ret = decide (LatOK F c s j) := by
  unfold latOKT LatOK
  by_cases h1 : lat1 (cellJ c s j) s ∈ F <;> by_cases h2 : lat2 (cellJ c s j) s ∈ F <;>
    by_cases h3 : j % 2 = 1 <;> simp [memT, h1, h2, h3]
end ULHC.T
