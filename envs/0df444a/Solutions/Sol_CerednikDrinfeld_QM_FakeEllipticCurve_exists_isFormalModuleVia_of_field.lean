theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {q : ℕ} [Fact q.Prime]
    (coord : ↥Λ → Zp2 q × Zp2 q) (hcoord : IsOrderCoord Λ q coord)
    (k : Type) [Field k] (hq : IsNilpotent ((q : ℕ) : k)) (E : FakeEllipticCurve Λ N k) :
    ∃ (X : FormalODModule q k) (θ : RelativeGroupLaw.FormalCoordinates E.f 2), E.IsFormalModuleVia coord X θ := by
  obtain ⟨n, f, hspan, hcov⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_cover_connected_isFormalModuleVia_pair coord hcoord k hq E E
  have hex : ∃ i, f i ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    have hbot : Ideal.span (Set.range f) = ⊥ := by
      rw [Ideal.span_eq_bot]
      rintro x ⟨i, rfl⟩
      exact h i
    exact bot_ne_top (hbot ▸ hspan)
  obtain ⟨i, hi⟩ := hex
  haveI : IsLocalization.Away (f i) k :=
    IsLocalization.away_of_isUnit_of_bijective k (isUnit_iff_ne_zero.mpr hi) Function.bijective_id
  obtain ⟨-, hE, -⟩ := hcov i k
  exact hE E (𝟙 E.A) (CerednikDrinfeld.QM.FakeEllipticCurve.isPullbackVia_id k E)

