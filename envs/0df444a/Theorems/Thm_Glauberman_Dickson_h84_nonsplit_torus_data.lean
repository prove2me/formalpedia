import Mathlib.Algebra.BigOperators.Ring.Nat
import Mathlib.Algebra.CharP.CharAndCard
import Mathlib.Algebra.Polynomial.SpecificDegree
import Mathlib.FieldTheory.Finite.Extension
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.FieldTheory.Finite.Trace
import Mathlib.GroupTheory.GroupAction.ConjAct
import Mathlib.GroupTheory.SchurZassenhaus
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Card
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.FinTwo
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Projective
import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
set_option autoImplicit false
universe u

theorem Glauberman.Dickson.h84_nonsplit_torus_data
    {F : Type u} [Field F] [Finite F] {p f : ℕ} [Fact p.Prime]
    (hFcard : Nat.card F = p ^ f) :
    ∃ S : Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F),
      IsCyclic S ∧
      Nat.card S =
        (Nat.card F + 1) / Nat.gcd (Nat.card F - 1) 2 ∧
      Nat.card (Subgroup.normalizer (S : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))) =
        2 * Nat.card S ∧
      (∃ w : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F,
        w ∈ Subgroup.normalizer (S : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) ∧
        w ∉ S ∧
        w * w = 1 ∧
        (∀ t : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F, t ∈ S → w * t * w⁻¹ = t⁻¹) ∧
        Nat.card (S ⊔ Subgroup.zpowers w :
          Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) = 2 * Nat.card S ∧
        ∀ R : Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F), R ≤ S → R ≠ ⊥ →
          Subgroup.normalizer (R : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) =
            S ⊔ Subgroup.zpowers w) ∧
      (∀ y : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F, y ∈ S → y ≠ 1 →
        ∀ g : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F,
          g * y * g⁻¹ ∈ S →
            g ∈ Subgroup.normalizer
              (S : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F))) ∧
      ∀ A : Matrix.SpecialLinearGroup (Fin 2) F,
        Matrix.trace (A : Matrix (Fin 2) (Fin 2) F) ^ 2 ≠ (4 : F) →
        (¬ ∃ (μ : F) (v : Fin 2 → F), v ≠ 0 ∧
          (A : Matrix (Fin 2) (Fin 2) F).mulVec v = μ • v) →
        ∃ g : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F,
          (QuotientGroup.mk' (Subgroup.center
            (Matrix.SpecialLinearGroup (Fin 2) F))) A ∈
            S.map (MulAut.conj g).toMonoidHom := by sorry
