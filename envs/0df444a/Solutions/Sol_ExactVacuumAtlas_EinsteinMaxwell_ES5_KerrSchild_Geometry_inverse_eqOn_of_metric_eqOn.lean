theorem solution {g g' gi gi' : Metric 5} {V : Set (Pt 5)}
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hinv : ∀ x ∈ V, metricMatrix g x * metricMatrix gi x = 1)
    (hinv' : ∀ x ∈ V, metricMatrix gi' x * metricMatrix g' x = 1) :
    ∀ i j, Set.EqOn (gi i j) (gi' i j) V := by
  intro i j x hx
  have hm : metricMatrix g x = metricMatrix g' x := by
    ext p q
    exact hg p q hx
  have hM : metricMatrix gi x = metricMatrix gi' x :=
    calc metricMatrix gi x = (metricMatrix gi' x * metricMatrix g' x) * metricMatrix gi x := by
          rw [hinv' x hx, Matrix.one_mul]
      _ = metricMatrix gi' x * (metricMatrix g x * metricMatrix gi x) := by
          rw [hm, Matrix.mul_assoc]
      _ = metricMatrix gi' x := by rw [hinv x hx, Matrix.mul_one]
  have := congrFun (congrFun hM i) j
  simpa [metricMatrix] using this
