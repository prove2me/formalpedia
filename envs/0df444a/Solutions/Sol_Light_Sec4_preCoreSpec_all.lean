symbols P₀. -/
theorem memRow_eq (h : Sec2.SharedReadyP p hmL aX aY b0 X Y μ) {β : ℕ} (hβ : β < p.nB)
    (τ : Leaf p.L) (hτ : (digitsT τ).count 9 ≤ p.m) : memRow p b0 μ β τ = encRow p hmL X β τ :=
