lemma qlu_xR_sq : xR α σ ^ 2 = qR α σ := by
  unfold xR qR
  rw [← Real.exp_nat_mul]; congr 1; push_cast; ring

lemma qlu_zR_ne : zR α b ≠ 0 := (Real.exp_pos _).ne'

lemma qlu_qpoch_ne (h : 0 < α ^ 2 * σ) (i : ℕ) : qpoch (qR α σ) i ≠ 0 := by
  unfold qpoch
  rw [Finset.prod_ne_zero_iff]
  intro k _
  have h0 : 0 < qR α σ := Real.exp_pos _
  have h1 : qR α σ < 1 := by
    unfold qR
    have := Real.pi_pos
    have h2 := Real.exp_lt_exp.mpr (show -(2 * π * α ^ 2 * σ) < 0 by nlinarith)
    rwa [Real.exp_zero] at h2
  have : qR α σ ^ (k + 1) < 1 := pow_lt_one₀ h0.le h1 (by omega)
  linarith

lemma qlu_realToep_eq (n : ℕ) : realToep α σ b n = gaussToep (xR α σ) (zR α b) n := by
  ext u v
  unfold realToep gaussToep xR zR
  rw [← Real.exp_nat_mul, ← Real.rpow_intCast, ← Real.exp_mul, ← Real.exp_add]
  congr 1
  push_cast
  rw [Nat.cast_natAbs, Int.cast_abs, sq_abs]
  push_cast
  ring

lemma qlu_bplus_eq : bplus α σ b = bP (xR α σ) (zR α b) := by
  funext h
  unfold bplus bP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1; push_cast; ring

lemma qlu_bminus_eq : bminus α σ b = bP (xR α σ) (zR α b)⁻¹ := by
  funext h
  unfold bminus bP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_neg, ← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1; push_cast; ring

lemma qlu_aplus_eq : aplus α σ b = aP (xR α σ) (zR α b) := by
  funext h
  unfold aplus aP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_add, neg_pow (Real.exp _) h, ← Real.exp_nat_mul]
  congr 2; ring

lemma qlu_aminus_eq : aminus α σ b = aP (xR α σ) (zR α b)⁻¹ := by
  funext h
  unfold aminus aP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_neg, ← Real.exp_add, neg_pow (Real.exp _) h, ← Real.exp_nat_mul]
  congr 2; ring

theorem solution (h : 0 < α ^ 2 * σ) (n : ℕ) :
    realToep α σ b n = Gam (qR α σ) n * lowT (bminus α σ b) * GamInv (qR α σ) n *
      upT (bplus α σ b) * Gam (qR α σ) n := by
  rw [qlu_realToep_eq, qlu_bminus_eq, qlu_bplus_eq, ← qlu_xR_sq]
  exact qlu_main _ _ n (qlu_zR_ne α b) (fun i _ => by rw [qlu_xR_sq]; exact qlu_qpoch_ne α σ h i)
