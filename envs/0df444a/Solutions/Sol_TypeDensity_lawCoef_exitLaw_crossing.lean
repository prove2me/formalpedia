        (TypeDensity.divisorProbability (TypeDensity.State.crossing a b c h) d).rational *
        ((if rt = 0 then 1 else TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing (a + b) a rt (c - d)))) *
        (if rx = 0 then 1 else TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing (a + b) b rx (h - d)))) *
        TypeDensity.patternSum (-1) (a + b) (a * c + b * h) (d - rt - rx)) else 0) := by
  classical
  unfold TypeDensity.exitLaw
  rw [TypeDensity.lawCoef_flatMap, Finset.sum_map_toList]
  have hns : ∀ P, ¬ TypeDensity.SelfPattern (TypeDensity.State.crossing a b c h) P := by
    rintro P ⟨a', c', h1, -⟩
    exact TypeDensity.State.noConfusion h1
  simp only [hns, if_false]
  refine (Finset.sum_congr rfl (fun P hP ↦ TypeDensity.lawCoef_crossing_term a b c h ha hb hc hh P
    (by unfold TypeDensity.allowedPatterns at hP; exact (Finset.mem_filter.mp hP).2))).trans ?_
  rw [TypeDensity.sum_allowedPatterns_crossing a b c h ha hb hh (fun d rt rx m ↦
    TypeDensity.scalar ((TypeDensity.divisorCount (-1) m).rational * (TypeDensity.divisorProbability (TypeDensity.State.crossing a b c h)
        d).rational) *
      ((if rt = 0 then 1 else TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing (a + b) a rt (c - d)))) *
        (if rx = 0 then 1 else TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing (a + b) b rx (h - d)))) *
        ∏ ij : Fin (TypeDensity.State.crossing a b c h).degree × Fin (TypeDensity.State.crossing a b c h).degree,
          (TypeDensity.adamsCoef (ij.1.val + 1) (TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.single (a + b) (ij.2.val + 1))))) ^
              (m ij).val))]
  refine Finset.sum_congr rfl (fun d _ ↦ Finset.sum_congr rfl
