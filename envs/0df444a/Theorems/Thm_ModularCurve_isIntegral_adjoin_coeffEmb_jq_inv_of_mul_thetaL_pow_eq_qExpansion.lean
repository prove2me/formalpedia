open UpperHalfPlane ModularCurve

theorem ModularCurve.isIntegral_adjoin_coeffEmb_jq_inv_of_mul_thetaL_pow_eq_qExpansion (N : ℕ) [NeZero N] (m : ℕ)
    (f : ModularForm (CongruenceSubgroup.Gamma0 N) (2 * (m : ℤ))) (Y : LaurentSeries ℂ)
    (hY : Y * thetaL ℂ (coeffEmb ℂ jq) ^ m =
      ((qExpansion 1 (f : ℍ → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ)) :
    IsIntegral (Algebra.adjoin ℂ ({(coeffEmb ℂ jq)⁻¹} : Set (LaurentSeries ℂ)))
      (Y ^ 2 * coeffEmb ℂ jq ^ m * (coeffEmb ℂ jq - algebraMap ℂ (LaurentSeries ℂ) 1728) ^ m) := by sorry
