open OAI OAI.MetricEntropyDuality

theorem OAI.MetricEntropyDuality.tupleSym_eq_iff {r j : ℕ} (a b : Fin j → Fin r) :
    tupleSym a = tupleSym b ↔ ∃ σ : Equiv.Perm (Fin j), a ∘ σ = b := by sorry
