    simp only [coeffMap_coeff, HahnSeries.C_mul_eq_smul, HahnSeries.coeff_smul, smul_eq_mul] at hn
    have hyn : y.coeff n = ⟨π, hπP⟩ * x.coeff n := Subtype.val_injective (by simpa using hn)
    rw [coeffMap_coeff, HahnSeries.coeff_zero, hyn, IsLocalRing.residue_eq_zero_iff]
    exact Ideal.mul_mem_right _ _ hπmax

  have hcSS : ∀ s' : ↥W, (∀ b : ↥B, ((b : ↥F₀) : ↥(fieldBar q M')) ∈ OSS s') → s' = s := by
    intro s' hBs'
