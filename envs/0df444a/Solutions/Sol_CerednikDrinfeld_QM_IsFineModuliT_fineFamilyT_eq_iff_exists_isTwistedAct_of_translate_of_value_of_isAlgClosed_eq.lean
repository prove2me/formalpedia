    {G : Type} [Group G] {ρ : G →* Aut M} {χ : G → ↥Λ} (hρ : IsLevelTwistAction Λ N n M πM ptF G ρ χ) (h : G) :
    (∃ y : ↥Λ, (χ h : ℍ[ℚ, a, b]) * (χ h⁻¹ : ℍ[ℚ, a, b]) - 1 = (n : ℚ) • (y : ℍ[ℚ, a, b])) ∧
    (∃ y : ↥Λ, (χ h⁻¹ : ℍ[ℚ, a, b]) * (χ h : ℍ[ℚ, a, b]) - 1 = (n : ℚ) • (y : ℍ[ℚ, a, b])) := by
  obtain ⟨y₁, hy₁⟩ := hρ.label_one
  constructor
  · obtain ⟨y₂, hy₂⟩ := hρ.label_mul h h⁻¹
    rw [mul_inv_cancel] at hy₂
    refine ⟨y₁ - y₂, ?_⟩
    rw [Submodule.coe_sub, smul_sub, ← hy₁, ← hy₂]; abel
  · obtain ⟨y₂, hy₂⟩ := hρ.label_mul h⁻¹ h
    rw [inv_mul_cancel] at hy₂
    refine ⟨y₁ - y₂, ?_⟩
    rw [Submodule.coe_sub, smul_sub, ← hy₁, ← hy₂]; abel

end label

