variable (lam : ℝ)
theorem solution {x : Pt 4} (hx : x ∈ domEF) (b d : Fin 4) :
    ricciOf (gCtl lam) (giCtl lam) b d x = ctlR lam b d x := by
  fin_cases b <;> fin_cases d
  exacts [ricci_0_0 lam x hx, ricci_0_1 lam x hx, ricci_0_2 lam x hx, ricci_0_3 lam x hx,
    ricci_1_0 lam x hx, ricci_1_1 lam x hx, ricci_1_2 lam x hx, ricci_1_3 lam x hx,
    ricci_2_0 lam x hx, ricci_2_1 lam x hx, ricci_2_2 lam x hx, ricci_2_3 lam x hx,
    ricci_3_0 lam x hx, ricci_3_1 lam x hx, ricci_3_2 lam x hx, ricci_3_3 lam x hx]
