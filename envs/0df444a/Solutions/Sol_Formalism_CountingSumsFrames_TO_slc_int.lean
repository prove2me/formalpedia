variable {p : ℕ} [Fact p.Prime] {N r : ℕ}
namespace Formalism.CountingSumsFrames.TO
theorem _root_.solution (j0 : ℕ) (m : Fin N × Fin r →₀ ℕ) {x : MvPolynomial (Fin N × Fin r) ℚ_[p]}
    (hx : x ∈ IntPol p (Fin N × Fin r)) : slc (fsj N r j0) m x ∈ IntPol p (Fin N × Fin r) := by
  classical
  rw [x.as_sum, map_sum]
  refine Submodule.sum_mem _ fun m' _ => ?_
  rw [sl_monomial]
  split_ifs
  · refine TM.mem_intPol_of_norm _ fun k => ?_
    rw [coeff_monomial]
    split_ifs
    · exact intPol_norm x hx m'
    · simp
  · exact Submodule.zero_mem _
end Formalism.CountingSumsFrames.TO
