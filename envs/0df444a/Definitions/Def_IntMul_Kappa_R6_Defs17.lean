-- Source module: Solutions.R6MTotal
/-!
# Round-six machine: the total cost of one context

* `cU6_mono`, `ZU6_le`: the unit `ZU6` is within `Kz6 · cU6 A` (`A ≥ 2`).
* **`total_le6`**: the setup (within `C_S · cU6 A_S`) plus `kMul6 + kFin6 + 2` of a context is at
  most `Ctot6 · cU6 A'` with `A' = A_Φ + A_L + A_C + A_S + 2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open Finset IntMul NLogN NLogN.KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

/-- The constant of the unit. -/
def Kz6 (P : Prm) : ℝ := (32500 * (NLogN.KFZ.Cfm : ℝ) + 200) * ((P.x : ℝ) + 4) ^ 2

/-- The constant of the total. -/
def Ctot6 (P : Prm) (CΦ CL CC CS : ℝ) : ℝ := 10 ^ 11 * Kz6 P + 3 * CΦ + 6 * CL + 3 * CC + CS + 2

end

end IntMul.Kappa.R6

