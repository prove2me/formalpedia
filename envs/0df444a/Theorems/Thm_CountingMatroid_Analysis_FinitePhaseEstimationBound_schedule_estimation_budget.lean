theorem CountingMatroid.Analysis.FinitePhaseEstimationBound.schedule_estimation_budget (n : ℕ) (p : InputParams) (hn : 0 < n) :
    let s := CountingMatroid.Interface.Pseudocode.setup n p
    0 < s.η ∧ 0 < s.observations ∧
      (Fintype.card (Observable n) : ℚ) *
        (40000 * (n : ℚ) ^ 8 / s.observations) /
        (s.η * (1 / (20 * (n : ℚ) ^ 2))) ^ 2 ≤
          1 / (32 * ((s.L : ℚ) + 1)) := by sorry
