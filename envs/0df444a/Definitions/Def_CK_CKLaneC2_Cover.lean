theorem Wt_neg_cover : ∀ t : ℝ, ((69 / 5000 : ℚ) : ℝ) ≤ t → t ≤ ((23 / 25 : ℚ) : ℝ) → Wt t < 0 := by
  intro t h1 h2
  refine cacc0 t ?_ ?_
  · rw [cover_first]; exact h1
  · rw [cover_last]; exact h2

/-- Hence the arctan-comparison slope, in the contact coordinate, is antitone there. -/
theorem Gf_antitone_cover : AntitoneOn Gf (Icc ((69 / 5000 : ℚ) : ℝ) ((23 / 25 : ℚ) : ℝ)) :=
  Gf_antitone_of_Wt_neg (by norm_num) (by norm_num) Wt_neg_cover

end CKLaneC2

