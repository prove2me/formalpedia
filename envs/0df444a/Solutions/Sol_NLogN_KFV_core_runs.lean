theorem truncNum_div (p ℓ : ℕ) (H : ℤ) :
    truncNum p ((H : ℝ) / 2 ^ (2 * p) / 2 ^ ℓ) = H.tdiv (2 ^ (p + ℓ)) := by
  have hx : (H : ℝ) / 2 ^ (2 * p) / 2 ^ ℓ * 2 ^ p = (H : ℝ) / ((2 ^ (p + ℓ) : ℕ) : ℝ) := by
    push_cast
    rw [show 2 * p = p + p by ring, pow_add, pow_add]; field_simp
  have hN : ((2 ^ (p + ℓ) : ℕ) : ℤ) = 2 ^ (p + ℓ) := by push_cast; rfl
  have hs : (0 : ℝ) ≤ (H : ℝ) / 2 ^ (2 * p) / 2 ^ ℓ ↔ 0 ≤ H := by
    rw [le_div_iff₀ (by positivity), zero_mul, le_div_iff₀ (by positivity), zero_mul]
    norm_cast
  unfold truncNum
  rw [hx]
  split_ifs with h
  · have hH : 0 ≤ H := hs.1 h
    rw [Int.floor_div_natCast, Int.floor_intCast, hN, Int.tdiv_eq_ediv_of_nonneg hH]
  · have hH : H < 0 := by
      by_contra hn; push Not at hn; exact h (hs.2 hn)
    have : (H : ℝ) / ((2 ^ (p + ℓ) : ℕ) : ℝ) = -(((-H : ℤ) : ℝ) / ((2 ^ (p + ℓ) : ℕ) : ℝ)) := by
      push_cast; ring
    rw [this, Int.ceil_neg, Int.floor_div_natCast, Int.floor_intCast, hN,
      ← Int.tdiv_eq_ediv_of_nonneg (by omega), Int.neg_tdiv, neg_neg]

/-- **The returned coefficient** `Q_p(2^{-2p} H_j / r)` for `r = 2^ℓ` has component numerators
`(ℜH_j).tdiv 2^{p+ℓ}` and `(ℑH_j).tdiv 2^{p+ℓ}`. -/
theorem Qp_normalized (p ℓ : ℕ) (Hre Him : ℤ) :
    Qp p (((2 : ℂ) ^ p)⁻¹ ^ 2 * ⟨Hre, Him⟩ / ((2 ^ ℓ : ℕ) : ℂ)) =
      ⟨(Hre.tdiv (2 ^ (p + ℓ)) : ℝ) / 2 ^ p, (Him.tdiv (2 ^ (p + ℓ)) : ℝ) / 2 ^ p⟩ := by
  have e : ((2 : ℂ) ^ p)⁻¹ ^ 2 * ⟨Hre, Him⟩ / ((2 ^ ℓ : ℕ) : ℂ) =
      ⟨(Hre : ℝ) / 2 ^ (2 * p) / 2 ^ ℓ, (Him : ℝ) / 2 ^ (2 * p) / 2 ^ ℓ⟩ := by
    have hc : ((2 : ℂ) ^ p)⁻¹ ^ 2 * ⟨Hre, Him⟩ / ((2 ^ ℓ : ℕ) : ℂ) =
        (((2 : ℝ) ^ (2 * p) * 2 ^ ℓ)⁻¹ : ℝ) * ⟨Hre, Him⟩ := by
      push_cast; rw [pow_mul]; field_simp; rw [← pow_mul, ← pow_mul, mul_comm, mul_comm 2 p]
    rw [hc]
    apply Complex.ext
    · rw [Complex.re_ofReal_mul]; simp only; field_simp
    · rw [Complex.im_ofReal_mul]; simp only; field_simp
  rw [e]
  simp only [Qp, truncR, truncNum_div]

end Synth

