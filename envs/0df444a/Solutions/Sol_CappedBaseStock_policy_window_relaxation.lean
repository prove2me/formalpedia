/-- One error controls the order mean and all windows through L+1 periods. -/
def approximationError (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (T : ℕ) : ℝ :=
  ((c.L : ℝ) + 3) * orderError P c π T

lemma approximationError_nonneg (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (T : ℕ) : 0 ≤ approximationError P c π T := by
  exact mul_nonneg (by positivity) (orderError_nonneg P c π T)

lemma approximationError_tendsto_zero (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (T : ℕ → ℕ) (hT : Tendsto T atTop atTop)
    (hblock : Tendsto (fun j => block (inventoryMean P c π) c.L (T j) / (T j : ℝ))
      atTop (𝓝 0)) :
    Tendsto (fun j => approximationError P c π (T j)) atTop (𝓝 0) := by
  simpa only [approximationError, mul_zero] using
    (orderError_tendsto_zero P c π T hT hblock).const_mul ((c.L : ℝ) + 3)

lemma order_average_le_mean_add_error (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (T : ℕ) (hT : c.L + 1 ≤ T) :
    CappedPolicyCesaro.mean (orderMean P π) T ≤ mean P + approximationError P c π T := by
  have hu := order_average_upper P c π hfinite T hT
  have hδ := orderError_nonneg P c π T
  have hnum : (2 * block (inventoryMean P c π) c.L T + (c.L : ℝ) * mean P) / (T : ℝ) ≤
      2 * orderError P c π T := by
    unfold orderError
    rw [← mul_div_assoc]
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg T)
    have hmean : 0 ≤ (c.L : ℝ) * mean P := mul_nonneg (Nat.cast_nonneg _) P.positiveMean.le
    linarith
  unfold approximationError
  nlinarith [mul_nonneg (Nat.cast_nonneg c.L : (0 : ℝ) ≤ c.L) hδ]

lemma delivery_average_lower (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (T : ℕ) (hT : c.L + 1 ≤ T) (i : Fin (c.L + 1)) :
    CappedPolicyCesaro.mean (orderMean P π) T - orderError P c π T ≤
      CappedPolicyCesaro.mean (fun t => arrivalMean P c π (t + i.val)) T := by
  rw [average_arrivalMean_shift_eq_delayedMean]
  have hg := (order_average_gap P c π hfinite (c.L - i.val) T (Nat.sub_le _ _) hT).2
  change CappedPolicyCesaro.mean (orderMean P π) T -
    CappedPolicyCesaro.delayedMean (orderMean P π) (c.L - i.val) T ≤ orderError P c π T at hg
  linarith

lemma integral_realInventory_average_le_add_error (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (hfinite : policyCost P c π < ⊤)
    (T : ℕ) (hT : c.L + 1 ≤ T) (m : ℕ) (hm : m ≤ c.L + 1) :
    (∫ d, realInventory d (CappedPolicyCesaro.mean (orderMean P π) T)
      (CappedPolicyCesaro.mean (inventoryMean P c π) T) m ∂demandPathLaw P) ≤
      CappedPolicyCesaro.mean (inventoryMean P c π) T + approximationError P c π T := by
  have hpos : 0 < T := by omega
  have hδ := orderError_nonneg P c π T
  have hG := integral_realInventory_le_mean_shift P c π hfinite T hpos
    (CappedPolicyCesaro.mean (orderMean P π) T) (orderError P c π T)
    (order_average_nonneg P π T) hδ (delivery_average_lower P c π hfinite T hT) m hm
  have hs := shifted_mean_le (inventoryMean P c π) (inventoryMean_nonneg P c π) c.L T m hm
  have hb := block_div_le_orderError P c π T
  have hcoef : (m : ℝ) ≤ (c.L : ℝ) + 1 := by exact_mod_cast hm
  have hmul := mul_le_mul_of_nonneg_right hcoef hδ
  unfold approximationError
  nlinarith

end CappedPolicyApproximateBounds
