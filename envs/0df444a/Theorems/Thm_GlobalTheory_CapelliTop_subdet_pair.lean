variable {A : Type} [Ring A] {n : ℕ}

theorem GlobalTheory.CapelliTop.subdet_pair (E : Fin n → Fin n → A) (i j : Fin n) (hij : i < j) :
    subdet E {i, j} = E i i * E j j - E j i * E i j := by sorry
