namespace FourColor.Discharge

/-- A closed arity interval; `none` is an unbounded upper endpoint. -/
structure ArityRange where
  lower : ℕ
  upper : Option ℕ
  deriving DecidableEq, Repr

namespace ArityRange

def Contains (r : ArityRange) (n : ℕ) : Prop :=
  r.lower ≤ n ∧ ∀ u ∈ r.upper, n ≤ u

instance (r : ArityRange) (n : ℕ) : Decidable (r.Contains n) :=
  inferInstanceAs (Decidable (r.lower ≤ n ∧ ∀ u ∈ r.upper, n ≤ u))

def contains (r : ArityRange) (n : ℕ) : Bool := decide (r.Contains n)

/-- The unconstrained range used for pentagonal hypermaps. -/
def free : ArityRange := ⟨5, none⟩

def exactly (n : ℕ) : ArityRange := ⟨n, some n⟩
def atLeast (n : ℕ) : ArityRange := ⟨n, none⟩
def atMost (n : ℕ) : ArityRange := ⟨5, some n⟩

/-- Sufficient interval containment, with the same result as `cmp_range = Psubset`
on the fifteen nonempty source ranges. -/
def subset (r s : ArityRange) : Bool :=
  decide (s.lower ≤ r.lower) && match s.upper, r.upper with
  | none, _ => true
  | some _, none => false
  | some v, some u => decide (u ≤ v)

theorem contains_iff (r : ArityRange) (n : ℕ) :
    r.contains n = true ↔ r.Contains n := by simp [contains]

theorem subset_sound {r s : ArityRange} (h : r.subset s = true) :
    ∀ n, r.Contains n → s.Contains n := by
  intro n hn
  have hh : decide (s.lower ≤ r.lower) = true ∧ (match s.upper, r.upper with
    | none, _ => true
    | some _, none => false
    | some v, some u => decide (u ≤ v)) = true := by simpa [subset] using h
  obtain ⟨lo, hu⟩ := hh
  refine ⟨le_trans (of_decide_eq_true lo) hn.1, ?_⟩
  cases hs : s.upper with
  | none => simp
  | some u =>
    cases hr : r.upper with
    | none => simp [hs, hr] at hu
    | some v =>
      have hvu : v ≤ u := by simpa [hs, hr] using hu
      intro z hz
      have hz' : z = u := by simpa [hs, eq_comm] using hz
      subst z
      exact le_trans (hn.2 v (by simp [hr])) hvu

end ArityRange

/-- One sector, with an optional fixed number of constrained fan faces.
Nontrivial fans fix the spoke arity, so reflection preserves their indexing. -/
inductive Sector where
  | basic (spoke hat : ArityRange)
  | six (hat fan : ArityRange)
  | seven (hat fan₁ fan₂ : ArityRange)
  | eight (hat fan₁ fan₂ fan₃ : ArityRange)
  deriving DecidableEq, Repr

namespace Sector

def spoke : Sector → ArityRange
  | .basic s _ => s
  | .six .. => .exactly 6
  | .seven .. => .exactly 7
  | .eight .. => .exactly 8

def hat : Sector → ArityRange
  | .basic _ h | .six h _ | .seven h _ _ | .eight h _ _ _ => h

def fans : Sector → List ArityRange
  | .basic .. => []
  | .six _ f => [f]
  | .seven _ f₁ f₂ => [f₁, f₂]
  | .eight _ f₁ f₂ f₃ => [f₁, f₂, f₃]

/-- Reflection reverses fans and takes the hat from the next sector. -/
def reflect (h : ArityRange) : Sector → Sector
  | .basic s _ => .basic s h
  | .six _ f => .six h f
  | .seven _ f₁ f₂ => .seven h f₂ f₁
  | .eight _ f₁ f₂ f₃ => .eight h f₃ f₂ f₁

/-- The source's sufficient subset test, including its conservative treatment
of a basic sector compared with one carrying fan constraints. -/
def subset (p q : Sector) : Bool :=
  p.spoke.subset q.spoke && p.hat.subset q.hat &&
    match p, q with
    | _, .basic .. => true
    | .six _ f, .six _ g => f.subset g
    | .seven _ f₁ f₂, .seven _ g₁ g₂ => f₁.subset g₁ && f₂.subset g₂
    | .eight _ f₁ f₂ f₃, .eight _ g₁ g₂ g₃ =>
      f₁.subset g₁ && f₂.subset g₂ && f₃.subset g₃
    | _, _ => false

end Sector

/-- An ordered, counterclockwise sequence of sectors around the hub face. -/
abbrev Part := List Sector

/-- Executable orbit arity, using Mathlib's bounded finite-cycle decision procedure. -/
def faceArity {n : ℕ} (H : Hypermap n) (x : Fin n) : ℕ :=
  (Finset.univ.filter (H.face.SameCycle x)).card

theorem faceArity_eq {n : ℕ} (H : Hypermap n) (x : Fin n) :
    faceArity H x = H.faceArity x := by
  unfold faceArity Hypermap.faceArity
  congr 1
  ext y
  simp [Hypermap.faceDarts, Hypermap.SameFace]

/-- Local face addressed by a subpart location: 0 is the spoke; 1 is the hat;
2, 3, and 4 are the three possible fans. -/
def localDart {n : ℕ} (H : Hypermap n) (x : Fin n) : ℕ → Fin n
  | 0 => H.edge x
  | i + 1 => H.edge ((H.face : Fin n → Fin n)^[i + 2] (H.edge x))

namespace Sector

/-- Exact local arity constraints, stated using the original hypermap semantics. -/
def Matches {n : ℕ} (s : Sector) (H : Hypermap n) (x : Fin n) : Prop :=
  s.spoke.Contains (H.faceArity (localDart H x 0)) ∧
  s.hat.Contains (H.faceArity (localDart H x 1)) ∧
  ∀ i : Fin s.fans.length, s.fans[i].Contains (H.faceArity (localDart H x (i + 2)))

def matchBool {n : ℕ} (s : Sector) (H : Hypermap n) (x : Fin n) : Bool :=
  s.spoke.contains (faceArity H (localDart H x 0)) &&
  s.hat.contains (faceArity H (localDart H x 1)) &&
  decide (∀ i : Fin s.fans.length,
    s.fans[i].Contains (faceArity H (localDart H x (i + 2))))

theorem matches_iff {n : ℕ} (s : Sector) (H : Hypermap n) (x : Fin n) :
    s.matchBool H x = true ↔ s.Matches H x := by
  simp [matchBool, Matches, faceArity_eq, ArityRange.contains, and_assoc]

end Sector

namespace Part

def rotate (i : ℕ) (p : Part) : Part := p.drop i ++ p.take i

private def mirrorAux (firstHat : ArityRange) (acc : Part) : Part → Part
  | [] => acc
  | s :: rest =>
    let nextHat := match rest with | [] => firstHat | t :: _ => t.hat
    mirrorAux firstHat (s.reflect nextHat :: acc) rest

/-- The source's reflection across the first spoke, without changing the hub. -/
def mirror (p : Part) : Part :=
  mirrorAux (match p with | [] => .free | s :: _ => s.hat) [] p

/-- Sufficient source-compatible containment of sectors. -/
def subset : Part → Part → Bool
  | _, [] => true
  | [], _ :: _ => false
  | p :: ps, q :: qs => p.subset q && subset ps qs

def sectorFits {n : ℕ} (H : Hypermap n) : Fin n → Part → Prop
  | _, [] => True
  | x, s :: rest => s.Matches H x ∧ sectorFits H (H.face x) rest

def sectorMatches {n : ℕ} (H : Hypermap n) : Fin n → Part → Bool
  | _, [] => true
  | x, s :: rest => s.matchBool H x && sectorMatches H (H.face x) rest

/-- Exact matching includes hub arity, rather than merely matching a partial sector. -/
def Matches {n : ℕ} (p : Part) (H : Hypermap n) (x : Fin n) : Prop :=
  H.faceArity x = p.length ∧ sectorFits H x p

def matchBool {n : ℕ} (p : Part) (H : Hypermap n) (x : Fin n) : Bool :=
  decide (faceArity H x = p.length) && sectorMatches H x p

theorem sectorMatches_iff {n : ℕ} (H : Hypermap n) (x : Fin n) (p : Part) :
    sectorMatches H x p = true ↔ sectorFits H x p := by
  induction p generalizing x with
  | nil => simp [sectorMatches, sectorFits]
  | cons s p ih => simp [sectorMatches, sectorFits, Sector.matches_iff, ih]

theorem matches_iff {n : ℕ} (p : Part) (H : Hypermap n) (x : Fin n) :
    p.matchBool H x = true ↔ p.Matches H x := by
  simp [matchBool, Matches, faceArity_eq, sectorMatches_iff]

end Part

/-- Complete the rule list with source-prescribed reflected patterns.
The rotation is repeated five times, exactly as in `symmetrize_drules`. -/
def symmetrize : List Part → List Part
  | [] => []
  | p :: rest =>
    let reflected := (Part.rotate (p.length - 1))^[5] (Part.mirror p)
    let tail := p :: symmetrize rest
    if p.subset reflected then tail else reflected :: tail

