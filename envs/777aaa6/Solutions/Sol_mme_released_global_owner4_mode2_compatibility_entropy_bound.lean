      if yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, shapeEquiv s⟩ then (profile 4).2 2 ⟨0, shapeEquiv s⟩ w else 0 := by
