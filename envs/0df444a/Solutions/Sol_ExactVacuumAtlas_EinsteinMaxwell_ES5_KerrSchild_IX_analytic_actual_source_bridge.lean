theorem solution (a b u v r α η x : ℝ)
    (hη : 0 ≤ η) (hη1 : η < 1)
    (hbound : |r| ≤ α + η * |r|) :
    HasDerivAt (fun t : ℝ => a * t + b) a x ∧
      |a * u + b * v| ≤ |a| * |u| + |b| * |v| ∧
      |r| ≤ α / (1 - η) := by
  have hderiv : HasDerivAt (fun t : ℝ => a * t + b) a x := by
    have hmul : HasDerivAt (fun t : ℝ => a * t) a x := by
      simpa using (HasDerivAt.const_mul a (hasDerivAt_id x))
    have hadd := hmul.add (hasDerivAt_const x b)
    have heq : (fun t : ℝ => a * t + b) =ᶠ[nhds x]
        ((fun t : ℝ => a * t) + fun _ => b) := by
      filter_upwards [] with t
      simp
    exact (hadd.congr_of_eventuallyEq heq).congr_deriv (by simp)
  exact ⟨hderiv, weighted_residual_triangle a b u v,
    residual_absorption hη hη1 hbound⟩
