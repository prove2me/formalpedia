-- title:
--   The Mathieu group $M_{23}$ as a subgroup of $S_{23}$
-- statement:
--   Let $S_{23}$ be the symmetric group on $23$ points, acting on the left. Following §3 of the source, define the permutations
--
--   $$g_1=(1,11)(2,23)(3,8)(4,16)(5,21)(7,20)(15,19)(18,22),$$
--   $$g_2=(1,2,11,10,16,9,6,3,23,19,20,14,21,17,4,8,22,5,18,15,13,7,12),$$
--   $$g_3=(1,2,3,4,10,11,12,7,19,18,8,6,9,16,17,21,22,5,14,20,13,15,23).$$
--
--   The **Mathieu group** is $M_{23}:=\langle g_1,g_2\rangle\le S_{23}$. For $g\in S_{23}$, the **$M_{23}$-conjugacy class of $g$** is $\{kgk^{-1}: k\in M_{23}\}$.
--
--   These are the basic objects of every statement in the mission: the group $M_{23}$, its explicit generators, and the third element $g_3$ of the triple $(g_1,g_2,g_3)$ used to build the $M_{23}$-cover.
--
--   **Formalization Note** The points $1,\dots,23$ are encoded as `Fin 23` via $k\mapsto k-1$. The helper `labelPerm` takes the cycles in the paper's labels and performs this shift. Permutations compose as functions, matching the paper's left action.
-- source:
--   X. Huang, B. Jackson, K.-H. Lee, B. Poonen, R. Pries, S. Zhang, *The Mathieu group M23 is a Galois group over Q*, arXiv:2608.08538v1 (2026), https://arxiv.org/abs/2608.08538, p. 4–5, §3 (generators $g_1,g_2$ and the permutation $g_3$; footnote 3 on the left action)

import Mathlib

/-!
# The Mathieu group `M₂₃` as a permutation group (Huang–Jackson–Lee–Poonen–Pries–Zhang, §3)

Points `1, …, 23` of the paper are encoded as elements of `Fin 23` by `k ↦ k - 1`;
`MathieuM23.labelPerm` performs this shift, so the cycles below are copied verbatim from the paper.
Permutations act on the left: `(σ * τ) x = σ (τ x)`, matching the paper's footnote 3.
-/

namespace MathieuM23

/-- The permutation of `Fin 23` given by a list of disjoint cycles written with the paper's
labels `1, …, 23` (label `k` is the element `k - 1 : Fin 23`). -/
def labelPerm (cycles : List (List ℕ)) : Equiv.Perm (Fin 23) :=
  (cycles.map fun c => (c.map fun k => (Fin.ofNat 23 (k - 1))).formPerm).prod

/-- `g₁ = (1,11)(2,23)(3,8)(4,16)(5,21)(7,20)(15,19)(18,22)`. -/
def g₁ : Equiv.Perm (Fin 23) :=
  labelPerm [[1, 11], [2, 23], [3, 8], [4, 16], [5, 21], [7, 20], [15, 19], [18, 22]]

/-- `g₂ = (1,2,11,10,16,9,6,3,23,19,20,14,21,17,4,8,22,5,18,15,13,7,12)`. -/
def g₂ : Equiv.Perm (Fin 23) :=
  labelPerm [[1, 2, 11, 10, 16, 9, 6, 3, 23, 19, 20, 14, 21, 17, 4, 8, 22, 5, 18, 15, 13, 7, 12]]

/-- `g₃ = (1,2,3,4,10,11,12,7,19,18,8,6,9,16,17,21,22,5,14,20,13,15,23)`. -/
def g₃ : Equiv.Perm (Fin 23) :=
  labelPerm [[1, 2, 3, 4, 10, 11, 12, 7, 19, 18, 8, 6, 9, 16, 17, 21, 22, 5, 14, 20, 13, 15, 23]]

/-- The Mathieu group `M₂₃`, the subgroup of `S₂₃` generated by `g₁` and `g₂`. -/
def M23 : Subgroup (Equiv.Perm (Fin 23)) :=
  Subgroup.closure {g₁, g₂}

/-- The conjugacy class in `M₂₃` of a permutation `g`: all `k g k⁻¹` with `k ∈ M₂₃`. -/
def classIn (g : Equiv.Perm (Fin 23)) : Set (Equiv.Perm (Fin 23)) :=
  {h | ∃ k ∈ M23, h = k * g * k⁻¹}

end MathieuM23


