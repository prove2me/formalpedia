/-- A particular good witnesses a strict failure of the EFX inequality. -/
def Violation (owner : Fin 8 → Fin 3) (w : Fin 3 × Fin 3 × Fin 8) : Prop :=
  owner w.2.2 = w.2.1 ∧
    valueN w.1 (bundle owner w.1) <
    valueN w.1 ((bundle owner w.2.1).erase w.2.2)

instance (owner : Fin 8 → Fin 3) (w : Fin 3 × Fin 3 × Fin 8) :
    Decidable (Violation owner w) :=
  inferInstanceAs (Decidable (owner w.2.2 = w.2.1 ∧
    valueN w.1 (bundle owner w.1) <
    valueN w.1 ((bundle owner w.2.1).erase w.2.2)))

