theorem clean_pow2 {a : Ex HS} (ha : a.Clean) : (Ex.pow2 a).Clean := fun j hj => ha j hj
theorem clean_quo {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.quo a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem zsz_le_one {b : ℤ} (h : b = 0 ∨ b = 1) {B : ℕ} (hB : 1 ≤ B) : zsz b ≤ B := by
  rcases h with rfl | rfl
  · simp [zsz_zero]
  · exact le_trans (by simpa using zsz_natCast_le_self 1) hB

end J6Seg

