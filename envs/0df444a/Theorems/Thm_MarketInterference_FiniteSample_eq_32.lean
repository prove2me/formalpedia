-- title:
--   (32), proof of Theorem 6, p. 54 — conditional expectation of treatment and control counts given the total demand
-- statement:
--   On a probability space, let $D^{\tau,\rho(\lambda+\beta)}$ (treatment counts) and $D^{\tau,(1-\rho)\lambda}$ (control counts) be random vectors in $\mathbb N^{n_d}$ whose $2n_d$ coordinates are mutually independent, with $D^{\tau,\rho(\lambda_i+\beta_i)}_i\sim\mathrm{Poisson}(\rho(\lambda_i+\beta_i)\tau)$ and $D^{\tau,(1-\rho)\lambda_i}_i\sim\mathrm{Poisson}((1-\rho)\lambda_i\tau)$, where $\lambda\ge0$, $\lambda+\beta\ge0$, $\rho\in(0,1)$ and $\tau>0$. Let $D^{\tau,\lambda+\rho\beta}=D^{\tau,\rho(\lambda+\beta)}+D^{\tau,(1-\rho)\lambda}$ be the total demand. Then for every type $i$, almost surely,
--   $$
--   \mathbb E\big[D^{\tau,\rho(\lambda_i+\beta_i)}_i\,\big|\,D^{\tau,\lambda+\rho\beta}\big]=D^{\tau,\lambda_i+\rho\beta_i}_i\,\frac{\rho(\lambda_i+\beta_i)}{\lambda_i+\rho\beta_i},\qquad
--   \mathbb E\big[D^{\tau,(1-\rho)\lambda_i}_i\,\big|\,D^{\tau,\lambda+\rho\beta}\big]=D^{\tau,\lambda_i+\rho\beta_i}_i\,\frac{(1-\rho)\lambda_i}{\lambda_i+\rho\beta_i}.
--   $$
--
--   Given the total experiment demand, each type's treatment and control counts are a binomial split of that type's total; this identity converts the shadow-price estimator into a function of the total demand alone.
--
--   **Formalization Note** The paper writes $\mathbb E_{|S}$, i.e. it also conditions on the supply vector; supply is independent of demand, so that conditioning does not change the conditional expectations and is dropped. Conditioning is on the $\sigma$-algebra generated by the whole total-demand vector. If $\lambda_i+\rho\beta_i=0$, both counts vanish almost surely and Lean's $x/0=0$ makes the right-hand sides $0$, so the identity still holds. Measurability of the count vectors is stated so that their laws are meaningful.
-- source:
--   Bright, Delarue and Lobel, Reducing Marketplace Interference Bias Via Shadow Prices, arXiv:2205.02274v4, p. 54, proof of Theorem 6, (32)

import Mathlib

namespace MarketInterference.FiniteSample

open MeasureTheory ProbabilityTheory

theorem eq_32 {nd : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (lam beta : Fin nd → ℝ) (hlam : 0 ≤ lam) (hlamb : 0 ≤ lam + beta)
    (ρ : ℝ) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (τ : ℝ) (hτ : 0 < τ)
    (Dt Dc : Ω → Fin nd → ℕ) (hDt : Measurable Dt) (hDc : Measurable Dc)
    (hind : iIndepFun (fun (k : Fin nd ⊕ Fin nd) (ω : Ω) => Sum.elim (Dt ω) (Dc ω) k) P)
    (hlawt : ∀ i, P.map (fun ω => Dt ω i) = poissonMeasure (Real.toNNReal (ρ * (lam i + beta i) * τ)))
    (hlawc : ∀ i, P.map (fun ω => Dc ω i) = poissonMeasure (Real.toNNReal ((1 - ρ) * lam i * τ)))
    (i : Fin nd) :
    P[fun ω => (Dt ω i : ℝ) | MeasurableSpace.comap (fun ω => Dt ω + Dc ω) inferInstance] =ᵐ[P]
        (fun ω => ((Dt ω i + Dc ω i : ℕ) : ℝ) * (ρ * (lam i + beta i) / (lam i + ρ * beta i))) ∧
      P[fun ω => (Dc ω i : ℝ) | MeasurableSpace.comap (fun ω => Dt ω + Dc ω) inferInstance] =ᵐ[P]
        (fun ω => ((Dt ω i + Dc ω i : ℕ) : ℝ) * ((1 - ρ) * lam i / (lam i + ρ * beta i))) := by sorry

end MarketInterference.FiniteSample
