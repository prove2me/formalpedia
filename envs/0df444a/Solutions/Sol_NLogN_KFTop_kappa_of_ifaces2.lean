  · exact kTable_fixed _ _ _ _ _ j hj
  · have e : NLogN.KFM.gI E₁ (E₁ + E₂ + E₃ + E₀) 0 (by omega) j = ⟨(j.val - 7) + 7, by omega⟩ := by
      simp [NLogN.KFM.gI, hj]; omega
    rw [e, mTable, kTable_ext _ ⟨j.val - 7, by omega⟩]
    have e2 : kTable ext₁ j = ext₁ ⟨j.val - 7, by omega⟩ := kTable_ext' ext₁ j (by omega)
    rw [e2, mExt, dif_pos (by simp; omega)]

theorem mTable_own (k : Fin E₀) : mTable ext₁ ext₂ ext₃ own (gO E₁ E₂ E₃ E₀ k) = own k := by
  rw [gO, mTable, kTable_ext _ ⟨E₁ + E₂ + E₃ + k.val, by omega⟩, mExt, dif_neg (by simp; omega),
    dif_neg (by simp; omega), dif_neg (by simp)]
