open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}
theorem solution (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (A B : Fin n) :
    Rfr g gi E Θ A B x = ∑ μ, ∑ ν, (E A μ x * E B ν x) • Fom g gi E Θ μ ν x := by
  have h2 : ∑ μ, ∑ ν, (E B μ x * E A ν x) • pdMC μ (omegaC g gi E Θ ν) x
      = ∑ μ, ∑ ν, (E A μ x * E B ν x) • pdMC ν (omegaC g gi E Θ μ) x := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by rw [mul_comm]
  have h3 : ∑ μ, ∑ ν, (E B μ x * E A ν x) • (omegaC g gi E Θ μ x * omegaC g gi E Θ ν x)
      = ∑ μ, ∑ ν, (E A μ x * E B ν x) • (omegaC g gi E Θ ν x * omegaC g gi E Θ μ x) := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by rw [mul_comm (E B ν x)]
  unfold Rfr
  rw [Dmat_Omega hF hx A B, Dmat_Omega hF hx B A, Omega_mul, Omega_mul, sum_cfr_Omega hF hx, h2, h3]
  simp only [Fom, smul_sub, smul_add, Finset.sum_sub_distrib, Finset.sum_add_distrib, brk, sub_smul]
  abel
