theorem FixHi.ge_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    m ≤ (σ i).val ↔ m ≤ i.val := by
  constructor
  · intro h
    have h1 : σ (σ i) = σ i := hσ _ (by omega)
    have := σ.injective h1
    rw [this] at h; exact h
  · intro h; rw [hσ i (by omega)]; exact h

theorem FixHi.lt_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    (σ i).val < m ↔ i.val < m := by
  have := hσ.ge_iff m hm i; omega

theorem FixHi.lt55 (hσ : FixHi σ) (i : Fin HS) : (σ i).val < 55 ↔ i.val < 55 := hσ.lt_iff 55 le_rfl i
