theorem tdiv_sel (x d : ℤ) : x.tdiv d = if x < 0 then 0 - (0 - x) / d else x / d := by
  split_ifs with h
  · have : x = -(-x) := by ring
    rw [this, Int.neg_tdiv, Int.tdiv_eq_ediv_of_nonneg (by omega)]; ring_nf
  · exact Int.tdiv_eq_ediv_of_nonneg (by omega)

set_option maxHeartbeats 1000000 in
/-- **The output-scaling loop.** -/
theorem Rn.loopC_sol_aux {W p s t α : ℕ} {v0 : Vr} {c0 : Cs} (hv0 : BV W v0) (hc0 : c0 cI = [])
    (h1 : v0 1 = ((2 * p : ℕ) : ℤ)) (h2 : v0 2 = ((p / 2 : ℕ) : ℤ)) (h3 : v0 3 = s)
    (h4 : v0 4 = t) (h5 : v0 5 = 2 ^ (2 * p)) (h6 : v0 6 = betaT (2 * p) α)
    (h8 : v0 8 = HAx p α) (h10 : v0 10 = ((2 * HAx p α : ℕ) : ℤ))
    (h11 : v0 11 = ((t ^ 2 * α ^ 2 : ℕ) : ℤ))
    (hpW : 2 * p ≤ W + 1) (hpW' : 2 * p < 2 ^ W) (hN : 2 * HAx p α < 2 ^ W)
    (hK : t ^ 2 * α ^ 2 < 2 ^ W)
    (hb1 : ∀ κ < 2 * HAx p α, cNumA s t (HAx p α) κ < 2 ^ W)
    (hb2 : ∀ κ < 2 * HAx p α, |expPos (2 * p) (t ^ 2 * α ^ 2) (cNumA s t (HAx p α) κ) (p / 2) *
      betaT (2 * p) α| < 2 ^ W)
    (hb3 : ∀ κ < 2 * HAx p α, |expPos (2 * p) (t ^ 2 * α ^ 2) (cNumA s t (HAx p α) κ) (p / 2)| <
      2 ^ W) :
    Rn loopC v0 c0 (fun v' => (∀ j, j ∉ ([26, 28, 29] : List (Fin HS)) → v' j = v0 j) ∧ BV W v')
      (update c0 sS (PreT.rv (fC p s t α) (2 * HAx p α) ++ c0 sS))
      (cFor W (2 * HAx p α) (cBodyC W)) := by
  have hβ0 : 0 ≤ betaT (2 * p) α := by unfold betaT; positivity
  have hP0 : (0 : ℤ) < 2 ^ (2 * p) := by positivity
  refine Rn.pushFor (C := cI) (rN := 10) (ix := 26) (S := sS) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) hN (by decide) hc0 _ ?_ hv0
    (by rw [h10])
  intro k hk v hI hx hB
  have g := fun j (hj : j ∉ ([26, 28, 29] : List (Fin HS))) => hI j hj
  have v1 : v 1 = ((2 * p : ℕ) : ℤ) := by rw [g 1 (by decide), h1]
  have v2 : v 2 = ((p / 2 : ℕ) : ℤ) := by rw [g 2 (by decide), h2]
  have v3 : v 3 = s := by rw [g 3 (by decide), h3]
  have v4 : v 4 = t := by rw [g 4 (by decide), h4]
  have v5 : v 5 = 2 ^ (2 * p) := by rw [g 5 (by decide), h5]
  have v6 : v 6 = betaT (2 * p) α := by rw [g 6 (by decide), h6]
  have v8 : v 8 = HAx p α := by rw [g 8 (by decide), h8]
  have v11 : v 11 = ((t ^ 2 * α ^ 2 : ℕ) : ℤ) := by rw [g 11 (by decide), h11]
  set aN := cNumA s t (HAx p α) k with haN
  have eA : eC1.den v = (aN : ℤ) := by
    rw [haN]; unfold cNumA
    simp only [eC1, eKx, E.den, eTS_den v3 v4, v3, v8, hx]
    push_cast; rw [sq_abs]; ring
  have hA0 : (0 : ℤ) ≤ aN := by positivity
  set c1 := update (update c0 sS (PreT.rv (fC p s t α) k ++ c0 sS)) cI
    [((2 * HAx p α : ℕ) : ℤ) - k] with hc1
  have s1 := Rn.asgE (c := c1) (i := 28) (e := eC1) (by decide) (by decide) (lb_le (by decide)) hB
  refine Rn.seq s1 (fun w1 e1 => ?_)
  subst e1
  rw [eA] at *
  have hB1 : BV W (update v 28 (aN : ℤ)) :=
    BV_upd hB (by rw [abs_of_nonneg hA0]; exact_mod_cast (hb1 k hk).le)
  set x := expPos (2 * p) (t ^ 2 * α ^ 2) aN (p / 2) with hxd
  have hxb : |x| < 2 ^ W := hb3 k hk
  have hp2 : p / 2 < 2 ^ W := by omega
  have s2 := Rn.epR (c := c1) hB1 (d := 29) (n := 1) (k := 11) (j := 28) (g := 2)
    (by decide) (by decide) (by decide) (by decide) (by decide)
    (a := 2 * p) (b := t ^ 2 * α ^ 2) (e := aN) (σ := p / 2)
    (by rw [update_of_ne (by decide), v1]) (by rw [update_of_ne (by decide), v11])
    (by rw [update_self]) (by rw [update_of_ne (by decide), v2]) hpW' hK (hb1 k hk) hp2 hpW
    (by omega) hxb
  refine Rn.seq s2 (fun w2 ⟨e2, hB2⟩ => ?_)
  subst e2
  have s3 := Rn.asgE (c := c1) (i := 29) (e := eCb) (by decide) (by decide) (lb_le (by decide))
    hB2
  refine Rn.seq s3 (fun w3 e3 => ?_)
  subst e3
  have eB : eCb.den (update (update v 28 (aN : ℤ)) 29 x) = x * betaT (2 * p) α := by
    simp only [eCb, E.den, update_self, update_of_ne (show (6 : Fin HS) ≠ 29 by decide),
      update_of_ne (show (6 : Fin HS) ≠ 28 by decide), v6]
  rw [eB]
  have hB3 : BV W (update (update (update v 28 (aN : ℤ)) 29 x) 29 (x * betaT (2 * p) α)) :=
    BV_upd hB2 (hb2 k hk).le
  have s4 := Rn.pushE (c := c1) (X := sS) (e := eTd) (by decide) (by decide) (by decide)
    (lb_le (by decide)) hB3
  have eP : eTd.den (update (update (update v 28 (aN : ℤ)) 29 x) 29 (x * betaT (2 * p) α)) =
      fC p s t α k := by
    simp only [eTd, E.den, update_self, update_of_ne (show (5 : Fin HS) ≠ 29 by decide),
      update_of_ne (show (5 : Fin HS) ≠ 28 by decide), v5, fC, hxd, haN]
