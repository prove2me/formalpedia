-- title:
--   (4.10), proof of Theorem 4.2, pp. 8–9 — along a convergent subsequence, multipliers of constraints inactive at x_* vanish
-- statement:
--   Let $\{x_k\}$ be generated by Algorithm 3.1 for problem (2.1), with $C^1$ data, and let $K=\{k_0<k_1<k_2<\dots\}\subseteq\mathbb N$ be an infinite index set with $\lim_{k\in K}x_k=x_*$. Then there is $k_5$ such that for all $k\in K$ with $k\ge k_5$ and every index $i$,
--   $$\big[\,[g_1(x_*)]_i<0\ \Rightarrow\ [\mu_{k+1}]_i=0\,\big]\quad\text{and}\quad\big[\,[g_2(x_*)]_i<0\ \Rightarrow\ [u_k]_i=0\,\big].$$
--
--   In words: eventually along the subsequence, the multiplier estimates attached to inequality constraints that are strictly inactive at the limit point are exactly zero. Neither feasibility of $x_*$ nor any constraint qualification is needed. This complementarity property is what turns the approximate KKT relation (4.9) into one involving only active constraints.
--
--   **Formalization Note.** The subsequence is $x_{\varphi(j)}$ for a strictly increasing $\varphi:\mathbb N\to\mathbb N$, and "for $k\in K$, $k\ge k_5$" becomes "for $j\ge j_0$".
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, pp. 8–9, proof of Theorem 4.2, (4.10)

import Mathlib
import Definitions.Def_AugLagLLC_KKT_Setting

namespace AugLagLLC.KKT

open Filter Topology

/-- (4.10), proof of Theorem 4.2, pp. 8–9: along any subsequence `x ∘ φ` of a run of
Algorithm 3.1 converging to `xs`, from some index on, `[μₖ₊₁]ᵢ = 0` whenever `[g₁(xs)]ᵢ < 0` and
`[uₖ]ᵢ = 0` whenever `[g₂(xs)]ᵢ < 0`. Neither feasibility of `xs` nor CPLD is assumed. -/
theorem eq_4_10 {n m1 p1 m2 p2 : ℕ} (P : Problem n m1 p1 m2 p2) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin p1 → ℝ} {ε : ℕ → ℝ}
    (hpar : Problem.IsParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin p1 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin p2 → ℝ}
    (hrun : P.IsRun τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    {xs : EuclideanSpace ℝ (Fin n)} (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (hconv : Tendsto (x ∘ φ) atTop (𝓝 xs)) :
    ∃ j₀ : ℕ, ∀ j ≥ j₀,
      (∀ i, P.g1 i xs < 0 → P.muNext x ρ muBar (φ j) i = 0) ∧
        (∀ i, P.g2 i xs < 0 → u (φ j) i = 0) := by sorry

end AugLagLLC.KKT
