    have := (Nat.le_div_iff_mul_le hs).1 (show j + 1 ≤ (n + Light.Filter2.sOf n - 1) / Light.Filter2.sOf n by omega)
    exact this
  rw [Nat.add_mul, Nat.one_mul] at h1
  omega

