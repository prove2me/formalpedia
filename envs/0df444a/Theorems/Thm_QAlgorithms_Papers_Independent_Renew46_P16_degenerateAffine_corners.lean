-- title:
--   Lemma 6.12 — degenerate affine BMW corners and centralizer
-- statement:
--   Let $S$ be a commutative unital ring, $\Omega=(\omega_j)_{j\ge0}$ a supplied sequence, and $W_n^{\mathrm{aff}}$ the degenerate affine BMW algebras. Use canonical generator images for all comparisons of levels. Products of subspaces denote their $S$-linear spans. Then
--
--   $$\begin{aligned}
--   e_{n-1}W_{n-1}^{\mathrm{aff}}e_{n-1}&=W_{n-2}^{\mathrm{aff}}e_{n-1} &&(n\ge3),\\
--   e_1W_1^{\mathrm{aff}}e_1&=\langle\omega_j:j\ge0\rangle_S e_1 &&\text{in }W_2^{\mathrm{aff}},\\
--   e_{n-1}a&=ae_{n-1} &&(n\ge2,\ a\in W_{n-2}^{\mathrm{aff}}).
--   \end{aligned}$$
--
--   The coefficient ideal in the second line is generated by the entire sequence. These three assertions describe the corners and relative centralizer without an admissibility hypothesis.
-- source:
--   On Cellular Algebras with Jucys Murphy Elements, arXiv:0907.3459v2, PDF p. 24, Lemma 6.12

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P16

noncomputable section

open scoped BigOperators

namespace QAlgorithms.Papers.Independent.Renew46.P16

/-- Lemma 6.12, all three clauses, PDF p.24. Corners and right products are
additive S-spans. The two-strand corner uses the ideal generated by ALL omega_j. -/
theorem degenerateAffine_corners (S : Type*) [CommRing S] (omega : ℕ → S) :
    (∀ n : ℕ, 3 ≤ n →
      cornerSpan S (affineLevel S omega n (n - 1) : Set (AffineBMW S omega n))
        (affineE S omega n (n - 2)) =
      rightProductSpan S (affineLevel S omega n (n - 2) : Set (AffineBMW S omega n))
        (affineE S omega n (n - 2))) ∧
    (cornerSpan S (affineLevel S omega 2 1 : Set (AffineBMW S omega 2))
        (affineE S omega 2 0) =
      Submodule.span S {z : AffineBMW S omega 2 |
        ∃ c : S, c ∈ Ideal.span (Set.range omega) ∧
          z = algebraMap S (AffineBMW S omega 2) c * affineE S omega 2 0}) ∧
    (∀ n : ℕ, 2 ≤ n → ∀ a ∈ affineLevel S omega n (n - 2),
      affineE S omega n (n - 2) * a = a * affineE S omega n (n - 2)) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P16

end
