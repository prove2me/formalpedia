-- title:
--   Theorem 2.1 — constant-length steps reach a level surface within $h(1+\varepsilon)/2$ of $x^*$
-- statement:
--   Let $f$ be a convex function on $E_n$ with a nonempty set $M^*$ of minimum points. Let $\{x_k\}$ be generated by the subgradient method with constant step length,
--   $$
--   x_{k+1} = x_k - h\,\frac{g_f(x_k)}{\|g_f(x_k)\|}, \qquad h > 0,
--   $$
--   from any starting point $x_0$, where $g_f(x)$ is any subgradient of $f$ at $x$ (the method stops if $g_f(x_k) = 0$). Then for every $\varepsilon > 0$ and every $x^* \in M^*$ there exist an index $k^*$ and a point $\bar x$ with
--   $$
--   f(\bar x) = f(x_{k^*}) \quad\text{and}\quad \|\bar x - x^*\| < \frac{h(1+\varepsilon)}{2}.
--   $$
--
--   In words: with steps of fixed length $h$ the method cannot guarantee convergence, but it reaches a level of $f$ whose level surface passes within about $h/2$ of any minimizer.
--
--   **Formalization Note** The subgradient selection $g_f$ and the starting point are universally quantified; the stopped sequence is represented as constant from the stopping index on.
-- source:
--   Shor, Minimization Methods for Non-Differentiable Functions, Springer 1985, p. 23, Theorem 2.1

import Mathlib
import Definitions.Def_ShorNonsmooth_SubgradMethod_SubgradientMethod

open Filter Topology

namespace ShorNonsmooth.SubgradMethod

/-- Shor (1985), p. 23, Theorem 2.1. Let `f` be convex on `E_n` with a nonempty set `M*` of
minimum points, and let `{x_k}` be computed by the subgradient method with stepsizes
`h_{k+1}(x_k) = h / ‖g_f(x_k)‖`, `h > 0` (for every subgradient selection `g` and every start
`x₀`). Then for any `ε > 0` and any `x* ∈ M*` there are `k*` and `x̄` with `f(x̄) = f(x_{k*})` and
`‖x̄ - x*‖ < h(1 + ε)/2`. -/
theorem constant_step_level_set_near_minimum {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (hf : ConvexOn ℝ Set.univ f) (hM : (MinSet f).Nonempty)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hg : ∀ x, ShorNonsmooth.AlmostDiff.IsSubgradient f x (g x)) (h : ℝ) (hh : 0 < h) (x₀ : EuclideanSpace ℝ (Fin n)) :
    ∀ ε > 0, ∀ xstar ∈ MinSet f, ∃ kstar : ℕ, ∃ xbar : EuclideanSpace ℝ (Fin n),
      f xbar = f (normalizedIter g (fun _ => h) x₀ kstar) ∧
        ‖xbar - xstar‖ < h * (1 + ε) / 2 := by sorry

end ShorNonsmooth.SubgradMethod
