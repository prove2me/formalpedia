  {𝕋 : TowerData q q' Fbase} {A : ValuationSubring (AlgebraicClosure ℚ)}
  {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
  {galF : ∀ j : Obj q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j)}
  (𝔉 : FCSide 𝕋 A S scalar galF)

@[reducible] noncomputable def algFC (α : Arr q q') : Algebra (𝔉.FC (cod α)) (𝔉.FC (dom α)) :=
  algebraAlong (𝔉.φC α)

theorem isScalarTower_algFC (α : Arr q q') :
    letI := 𝔉.algFC α
    IsScalarTower A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α)) := by
  letI := 𝔉.algFC α
  exact IsScalarTower.of_algebraMap_eq fun c => ((𝔉.φC α).commutes c).symm

theorem halgFC (α : Arr q q') (f : 𝕋.objField (cod α)) :
    letI := 𝔉.algFC α
    letI := 𝕋.algF α
    algebraMap (𝔉.FC (cod α)) (𝔉.FC (dom α)) (@algebraMap _ _ _ _ (𝔉.instAlgF (cod α)) f) =
      @algebraMap _ _ _ _ (𝔉.instAlgF (dom α)) (algebraMap (𝕋.objField (cod α)) (𝕋.objField (dom α)) f) :=
  𝔉.hcomm α f

theorem hgalC_arr (α : Arr q q') (σ : S) (f : 𝔉.FC (cod α)) :
    letI := 𝔉.algFC α
    𝔉.galFC (dom α) σ • algebraMap (𝔉.FC (cod α)) (𝔉.FC (dom α)) f =
      algebraMap (𝔉.FC (cod α)) (𝔉.FC (dom α)) (𝔉.galFC (cod α) σ • f) :=
  𝔉.hgalC α σ f

theorem hφC (α : Arr q q') :
    letI := 𝔉.algFC α
    haveI := 𝔉.isScalarTower_algFC α
    (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))).toRingHom.IsIntegral := by
  letI := 𝔉.algFC α
  haveI := 𝔉.isScalarTower_algFC α
  have h : (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))) = 𝔉.φC α :=
    AlgHom.ext fun _ => rfl
  rw [h]; exact 𝔉.hφC_int α

theorem hfinC (α : Arr q q') :
    letI := 𝔉.algFC α
    haveI := 𝔉.isScalarTower_algFC α
    FiniteAlong A.valuation.Completion (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))) := by
  letI := 𝔉.algFC α
  haveI := 𝔉.isScalarTower_algFC α
  have h : (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))) = 𝔉.φC α :=
    AlgHom.ext fun _ => rfl
  rw [h]; exact 𝔉.hφC_fin α

theorem hsepC (α : Arr q q') :
    letI := 𝔉.algFC α
    haveI := 𝔉.isScalarTower_algFC α
    SeparableAlong A.valuation.Completion (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))) := by
  letI := 𝔉.algFC α
  haveI := 𝔉.isScalarTower_algFC α
  have h : (IsScalarTower.toAlgHom A.valuation.Completion (𝔉.FC (cod α)) (𝔉.FC (dom α))) = 𝔉.φC α :=
    AlgHom.ext fun _ => rfl
  rw [h]; exact 𝔉.hφC_sep α

end FCSide

theorem nonempty_FCSide {q q' : ℕ} (Fbase : Type) [Field Fbase] [Algebra (AlgebraicClosure ℚ) Fbase]
    [IsCurveOver (AlgebraicClosure ℚ) Fbase] [Algebra.EssFiniteType (AlgebraicClosure ℚ) Fbase]
    (𝕋 : TowerData q q' Fbase)
    (hfg : ∀ j : Obj q q', ∃ x : 𝕋.objField j, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set (𝕋.objField j))) (𝕋.objField j))
    {r : ℕ} [Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime r)
    (S : Type) [Group S] (scalar : S →* ↥(A.decompositionSubgroup ℚ))
    (galF : ∀ j : Obj q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j))
    (hgalF : ∀ j (σ : S) (a : AlgebraicClosure ℚ), SemilinearAut.baseAut (galF j σ) a =
      ((scalar σ : ↥(A.decompositionSubgroup ℚ)) : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a)
    (hgal_arr : ∀ (α : Arr q q') (σ : S) (x : 𝕋.objField (cod α)),
      letI := 𝕋.algF α
      galF (dom α) σ • algebraMap (𝕋.objField (cod α)) (𝕋.objField (dom α)) x =
        algebraMap (𝕋.objField (cod α)) (𝕋.objField (dom α)) (galF (cod α) σ • x)) :
    Nonempty (FCSide 𝕋 A S scalar galF) := by
  classical
  haveI : IsAlgClosed A.valuation.Completion :=
    ValuationSubring.isAlgClosed_completion_of_liesOverPrime r Fact.out A hA
  haveI : Fact (A.DecompositionIsometric ℚ) :=
    ⟨fun σ x => ValuationSubring.valuation_map_eq_of_mem_decompositionSubgroup A σ.2 x⟩
  haveI : AlgebraicCurve.HasCanonicalDivisor (K := AlgebraicClosure ℚ) (F := Fbase) :=
    AlgebraicCurve.hasCanonicalDivisor_of_isCurveOver
  haveI : CharZero Fbase := charZero_of_injective_algebraMap (algebraMap (AlgebraicClosure ℚ) Fbase).injective

  have hfgb : ∃ x : Fbase, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set Fbase)) Fbase := hfg none
  let galFb : S →* SemilinearAut (AlgebraicClosure ℚ) Fbase := galF none
  have hgalFb : ∀ (σ : S) (a : AlgebraicClosure ℚ), SemilinearAut.baseAut (galFb σ) a =
      ((scalar σ : ↥(A.decompositionSubgroup ℚ)) : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a := hgalF none

  have hfgl : ∀ ℓ : AwayPrime q q', ∃ x : 𝕋.F ℓ, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set (𝕋.F ℓ))) (𝕋.F ℓ) :=
    fun ℓ => hfg (some ℓ)
  let galFl : ∀ ℓ : AwayPrime q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ) := fun ℓ => galF (some ℓ)
  have hgalFl : ∀ (ℓ : AwayPrime q q') (σ : S) (a : AlgebraicClosure ℚ), SemilinearAut.baseAut (galFl ℓ σ) a =
      ((scalar σ : ↥(A.decompositionSubgroup ℚ)) : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a :=
    fun ℓ => hgalF (some ℓ)
  have hgal_arrb : ∀ (ℓ : AwayPrime q q') (i : Fin 2) (σ : S) (x : Fbase),
      galFl ℓ σ • 𝕋.φ (ℓ, i) x = 𝕋.φ (ℓ, i) (galFb σ • x) :=
    fun ℓ i σ x => hgal_arr (ℓ, i) σ x

  obtain ⟨FC0, iF0, iAC0, iAF0, iAK0, iTC0, iTF0, iCu0, -, hfg0, hgen0⟩ :=
    AlgebraicCurve.exists_constantFieldExtension (AlgebraicClosure ℚ) Fbase A.valuation.Completion hfgb
  obtain ⟨galFC0, hb0, he0⟩ := exists_galFC_aux A hA S scalar Fbase hfgb galFb hgalFb FC0 hfg0 hgen0

  have H : ∀ ℓ : AwayPrime q q',
      ∃ (F'E : Type) (_ : Field F'E) (_ : Algebra A.valuation.Completion F'E) (_ : Algebra (𝕋.F ℓ) F'E)
        (_ : Algebra (AlgebraicClosure ℚ) F'E) (_ : IsScalarTower (AlgebraicClosure ℚ) A.valuation.Completion F'E)
        (_ : IsScalarTower (AlgebraicClosure ℚ) (𝕋.F ℓ) F'E) (_ : IsCurveOver A.valuation.Completion F'E)
        (φE ψE : FC0 →ₐ[A.valuation.Completion] F'E),
        (∃ x' : F'E, Transcendental A.valuation.Completion x' ∧
          FiniteDimensional (IntermediateField.adjoin A.valuation.Completion ({x'} : Set F'E)) F'E) ∧
        IntermediateField.adjoin A.valuation.Completion (Set.range (algebraMap (𝕋.F ℓ) F'E)) = ⊤ ∧
        (∀ f : Fbase, φE (algebraMap Fbase FC0 f) = algebraMap (𝕋.F ℓ) F'E (𝕋.φ (ℓ, 0) f)) ∧
        (∀ f : Fbase, ψE (algebraMap Fbase FC0 f) = algebraMap (𝕋.F ℓ) F'E (𝕋.φ (ℓ, 1) f)) ∧
        φE.toRingHom.IsIntegral ∧ ψE.toRingHom.IsIntegral ∧
        FiniteAlong A.valuation.Completion φE ∧ FiniteAlong A.valuation.Completion ψE ∧
        SeparableAlong A.valuation.Completion φE ∧ SeparableAlong A.valuation.Completion ψE := by
    intro ℓ
    haveI : HasPrincipalDivisors (AlgebraicClosure ℚ) (𝕋.F ℓ) := IsCurveOver.hasPrincipalDivisors
    have hsep0 : SeparableAlong (AlgebraicClosure ℚ) (𝕋.φ (ℓ, 0)) :=
      separableAlong_of_charZero (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0))
    have hsep1 : SeparableAlong (AlgebraicClosure ℚ) (𝕋.φ (ℓ, 1)) :=
      separableAlong_of_charZero (𝕋.φ (ℓ, 1)) (𝕋.integral (ℓ, 1))
    exact exists_constantFieldExtension_pair_aux (AlgebraicClosure ℚ) Fbase hfgb (𝕋.F ℓ) (hfgl ℓ)
      (𝕋.φ (ℓ, 0)) (𝕋.φ (ℓ, 1)) (𝕋.integral (ℓ, 0)) (𝕋.integral (ℓ, 1))
      (fundamentalIdentityAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)) (𝕋.finite (ℓ, 0)) hsep0) (𝕋.finite (ℓ, 1))
      (normFormulaAlong_of_separableAlong (𝕋.φ (ℓ, 1)) (𝕋.finite (ℓ, 1)) hsep1)
      A.valuation.Completion FC0 hfg0 hgen0
  choose FCl iFl iACl iAFl iAKl iTCl iTFl iCul φE ψE hpk using H

  have H2 : ∀ ℓ : AwayPrime q q', ∃ g : S →* SemilinearAut A.valuation.Completion (FCl ℓ),
      (∀ (σ : S) (c : A.valuation.Completion), SemilinearAut.baseAut (g σ) c = (scalar σ) • c) ∧
      (∀ (σ : S) (f : 𝕋.F ℓ), g σ • algebraMap (𝕋.F ℓ) (FCl ℓ) f = algebraMap (𝕋.F ℓ) (FCl ℓ) (galFl ℓ σ • f)) :=
    fun ℓ => exists_galFC_aux A hA S scalar (𝕋.F ℓ) (hfgl ℓ) (galFl ℓ) (hgalFl ℓ) (FCl ℓ) (hpk ℓ).1 (hpk ℓ).2.1
  choose galFCl hbl hel using H2

  refine ⟨{
    FC := fun j => match j with | none => FC0 | some ℓ => FCl ℓ
    instField := fun j => match j with | none => iF0 | some ℓ => iFl ℓ
    instAlgC := fun j => match j with | none => iAC0 | some ℓ => iACl ℓ
    instAlgF := fun j => match j with | none => iAF0 | some ℓ => iAFl ℓ
    instAlgK := fun j => match j with | none => iAK0 | some ℓ => iAKl ℓ
    instTowC := fun j => match j with | none => iTC0 | some ℓ => iTCl ℓ
    instTowF := fun j => match j with | none => iTF0 | some ℓ => iTFl ℓ
    instCurve := fun j => match j with | none => iCu0 | some ℓ => iCul ℓ
    hfg' := fun j => match j with | none => hfg0 | some ℓ => (hpk ℓ).1
    hgen := fun j => match j with | none => hgen0 | some ℓ => (hpk ℓ).2.1
    galFC := fun j => match j with | none => galFC0 | some ℓ => galFCl ℓ
    hgalFC_base := fun j => match j with | none => hb0 | some ℓ => hbl ℓ
    hgalFC_ext := fun j => match j with | none => he0 | some ℓ => hel ℓ
    φC := fun α => ![φE α.1, ψE α.1] α.2
    hcomm := ?_
    hφC_int := ?_
    hφC_fin := ?_
    hφC_sep := ?_
    hgalC := ?_ }⟩
  · rintro ⟨ℓ, i⟩ f
    obtain ⟨-, -, hc0, hc1, -⟩ := hpk ℓ
    fin_cases i
    · exact hc0 f
    · exact hc1 f
  · rintro ⟨ℓ, i⟩
    obtain ⟨-, -, -, -, hi0, hi1, -⟩ := hpk ℓ
    fin_cases i
    · exact hi0
    · exact hi1
  · rintro ⟨ℓ, i⟩
    obtain ⟨-, -, -, -, -, -, hf0, hf1, -⟩ := hpk ℓ
    fin_cases i
    · exact hf0
    · exact hf1
  · rintro ⟨ℓ, i⟩
    obtain ⟨-, -, -, -, -, -, -, -, hs0, hs1⟩ := hpk ℓ
    fin_cases i
    · exact hs0
    · exact hs1
  · rintro ⟨ℓ, i⟩ σ x
    obtain ⟨-, -, hc0, hc1, -⟩ := hpk ℓ
    have hbase : SemilinearAut.baseAut (galFC0 σ) = SemilinearAut.baseAut (galFCl ℓ σ) :=
      RingEquiv.ext fun c => (hb0 σ c).trans (hbl ℓ σ c).symm
    fin_cases i
    · exact smul_algHom_eq_algHom_smul_aux (𝕋.φ (ℓ, 0)) (φE ℓ) hc0 hgen0 (galFb σ) (galFl ℓ σ)
        (hgal_arrb ℓ 0 σ) (galFC0 σ) (galFCl ℓ σ) hbase (he0 σ) (hel ℓ σ) x
    · exact smul_algHom_eq_algHom_smul_aux (𝕋.φ (ℓ, 1)) (ψE ℓ) hc1 hgen0 (galFb σ) (galFl ℓ σ)
        (hgal_arrb ℓ 1 σ) (galFC0 σ) (galFCl ℓ σ) hbase (he0 σ) (hel ℓ σ) x

end FCSideSection

