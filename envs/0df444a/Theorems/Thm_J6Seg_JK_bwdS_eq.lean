open J6Seg J6Seg.JK
open Finset
variable {P : ℕ} {L : List ℕ} {mw c : ℕ} {A : ℕ → ℕ → ℤ}

theorem J6Seg.JK.bwdS_eq (hsort : L.Pairwise (· < ·)) (Y : ℕ → ℤ) : ∀ j ≤ L.length,
    bwdS P (bsOf P L mw c A) (accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y)
      L.length) j =
      (accZ P (bandS mw c) L A Y (L.length - j),
        accB P (bandS mw c) L A Y (flOf L (c ≤ ·)) (L.length - j)) := by sorry
