/-!
# Round-six machine: the merged table, the contexts and `BigSpec`

The frozen `KFMBig11` at the round-six parameters.

* `ixM6`: the index data of the merged table `mExt4 ext₁ ext₂ ext₃ ext₄ [bigP6]` (setup, `Φ`,
  lines, chirp; chirp descriptor stack `cS`).
* **`ctx_exists6`**: from the per-size guarantees of `Φ` (`CrtBody6`), the lines (`LineBody6`)
  and the chirp (`chirp_of_P18`), a `BigCtx6` exists for every admissible size and every `Isym`,
  with the fixed constants and the canonical descriptor bounds `dzB`.
* **`bigSpec_of6`**: contexts and setup runs for all `n ≥ N₁` give `BigSpec`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6

open Finset AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM Complex

noncomputable section

/-- The index data of the merged table (own procedure `0` is `bigP6`). -/
def ixM6 (E₁ E₂ E₃ E₄ : ℕ) (eS : Fin (7 + E₁)) (eF eI : Fin (7 + E₂)) (eA eB : Fin (7 + E₃))
    (eC : Fin (7 + E₄)) (dSΦ dSL : Fin HS) : Ix6 (7 + (E₁ + E₂ + E₃ + E₄ + 1)) where
  P₁ := E₁
  P₂ := E₂
  P₃ := E₃
  P₄ := E₄
  g₁ := g4₁ E₁ E₂ E₃ E₄ 1
  g₂ := g4₂ E₁ E₂ E₃ E₄ 1
  g₃ := g4₃ E₁ E₂ E₃ E₄ 1
  g₄ := g4₄ E₁ E₂ E₃ E₄ 1
  eS := eS
  eF := eF
  eI := eI
  eA := eA
  eB := eB
  eC := eC
  dSΦ := dSΦ
  dSL := dSL
  dSC := NLogN.KFZ.cS

end

end IntMul.Kappa.R6

