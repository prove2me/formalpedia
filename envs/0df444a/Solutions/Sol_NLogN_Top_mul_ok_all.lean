section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.Top
open IntMul NLogN
theorem solution {st : RM} {n₀ : ℕ} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)}
    (hst : StepOK st n₀ lin calls) {I : List Sym} {iprog : Fin 5 → IStmt HS 5}
    (h1 : iprog 1 = (mulRM n₀ st).code 1 pcH)
    (h2 : iprog 2 = (difBody 2).ren ssH id) (h3 : iprog 3 = (ditBody 3).ren ssH id)
    (h4 : iprog 4 = blenProc) (G : ℕ → ℕ) (hGm : Monotone G)
    (hG : ∀ N, topCost n₀ N + (if N < n₀ then smallCost N else
        lin N + ((calls N).map fun q => q.1 * G q.2).sum) + 2 ≤ G N) :
    ∀ n, MulOK I iprog 1 (Mlt G n) := by
  intro n
  induction n with
  | zero => intro s a b L hd; exact absurd hd.1 (Nat.not_lt_zero _)
  | succ n ih =>
    intro s a b L hd hA
    have hM : n₀ ≤ NLogN.Top.nOf a b → ∀ q ∈ calls (NLogN.Top.nOf a b), NLogN.MulBnd (NLogN.Top.Mlt G n) q.2 (G q.2) := by
      intro hn q hq a' b' ha' hb'
      have hlt := hst.smaller _ hn q hq
      have hN : NLogN.Top.nOf a b ≤ n := by rw [NLogN.Top.nOf_eq]; have := hd.1; have := hd.2; omega
      refine ⟨⟨by omega, by omega⟩, hGm (max_le ha' hb')⟩
    have hr := NLogN.RM.code_runs (NLogN.Top.Mlt G n) 1 NLogN.Top.pcH ih (NLogN.Top.mulRM n₀ st)
      (NLogN.Top.mulRM_prcOK hst h2 h3 h4) s (NLogN.Top.mulRM_ok hst (NLogN.Top.Mlt G n) G s a b L hA hM)
    rw [NLogN.Top.mulRM_run hst s a b L hA, ← h1] at hr
    have hc := NLogN.Top.mulRM_cost hst (NLogN.Top.Mlt G n) G s a b L hA hM
    have := hG (NLogN.Top.nOf a b)
    refine (NLogN.IRuns.call hr).mono ?_
    show _ ≤ G (max (NLogN.zsz a) (NLogN.zsz b))
    rw [← NLogN.Top.nOf_eq]; omega
end
