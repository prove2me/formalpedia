  haveI : LocallyOfFinitePresentation (jK E K ≫ E.L.schemeKerStr ℓ) := by rw [jK_snd]; exact K.levK_finitePresentation
  exact (AlgebraicGeometry.IsOpenImmersion.of_isClosedImmersion_of_flat_comp_of_etale (jK E K) (E.L.schemeKerStr ℓ)).1

theorem mapPt_nsmulPt (E : FakeEllipticCurve Λ N S) (φ : E.A ⟶ E.A) (hφ : φ ≫ E.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f),
      mapPt φ hφ (E.L.mul t P Q) = E.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (n : ℕ) (P : SchemeHomOver t E.f) :
    mapPt φ hφ (nsmulPt E.L t n P) = nsmulPt E.L t n (mapPt φ hφ P) := by
  induction n with
  | zero =>

    set x := mapPt φ hφ (E.L.one t) with hx
    have hxx : E.L.mul t x x = x := by rw [hx, ← hmul, E.L.one_mul]
    letI := E.L.pointGroup t
    have h2 : x * x = x * 1 := by rw [mul_one]; exact hxx
    exact mul_left_cancel h2
  | succ n ih =>
    show mapPt φ hφ (E.L.mul t (nsmulPt E.L t n P) P) = E.L.mul t (nsmulPt E.L t n (mapPt φ hφ P)) (mapPt φ hφ P)
    rw [hmul, ih]

theorem factorsThrough_mapPt_of_forall_point (E : FakeEllipticCurve Λ N S) (hℓS : IsUnit ((ℓ : ℕ) : S)) (K : E.ExtraLevel ℓ)
    (φ : E.A ⟶ E.A) (hφ : φ ≫ E.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f),
      mapPt φ hφ (E.L.mul t P Q) = E.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (R : SchemeHomOver t E.f) (hR : FactorsThrough K.levK R)
    (hpts : ∀ y : T, ∃ z : K.K, K.levK.base z = (R.1 ≫ φ).base y) :
    FactorsThrough K.levK (mapPt φ hφ R) := by
  have htor : nsmulPt E.L t ℓ (mapPt φ hφ R) = E.L.one t := by
    rw [← mapPt_nsmulPt E φ hφ hmul, K.levK_torsion t R hR]
    exact mapPt_nsmulPt E φ hφ hmul t 0 R
  have w : (R.1 ≫ φ) ≫ E.L.schemeNsmul ℓ = t ≫ (E.L.one (𝟙 _)).1 := by
    have := congrArg Subtype.val htor
    rw [nsmulPt_coe, one_coe] at this
    exact this
  let φT : T ⟶ E.L.schemeKer ℓ := pullback.lift (R.1 ≫ φ) t w
  haveI := isOpenImmersion_jK E hℓS K
  haveI := isClosedImmersion_one E
  have H' : Set.range φT.base ⊆ Set.range (jK E K).base := by
    rintro _ ⟨y, rfl⟩
    obtain ⟨z, hz⟩ := hpts y
    refine ⟨z, ?_⟩
    apply (pullback.fst (E.L.schemeNsmul ℓ) (E.L.one (𝟙 _)).1).isClosedEmbedding.injective
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, jK_fst, pullback.lift_fst]
    exact hz
  refine ⟨IsOpenImmersion.lift (jK E K) φT H', ?_⟩
  rw [mapPt_coe, ← jK_fst E K, ← Category.assoc, IsOpenImmersion.lift_fac, pullback.lift_fst]

theorem exists_common_field (k₀ : Type) [Field k₀] (K₁ K₂ : Type) [CommRing K₁] [CommRing K₂] [Nontrivial K₁] [Nontrivial K₂]
    (f₁ : k₀ →+* K₁) (f₂ : k₀ →+* K₂) :
    ∃ (Ω : Type) (_ : Field Ω) (_ : IsAlgClosed Ω) (g₁ : K₁ →+* Ω) (g₂ : K₂ →+* Ω), g₁.comp f₁ = g₂.comp f₂ := by
  classical
  letI : Algebra k₀ K₁ := f₁.toAlgebra
  letI : Algebra k₀ K₂ := f₂.toAlgebra
  haveI : Nontrivial (K₁ ⊗[k₀] K₂) :=
    (Algebra.TensorProduct.includeLeft_injective (R := k₀) (S := k₀) (A := K₁) (B := K₂) f₂.injective).nontrivial
  obtain ⟨m, hm⟩ := Ideal.exists_maximal (K₁ ⊗[k₀] K₂)
  letI : Field ((K₁ ⊗[k₀] K₂) ⧸ m) := Ideal.Quotient.field m
  refine ⟨AlgebraicClosure ((K₁ ⊗[k₀] K₂) ⧸ m), inferInstance, inferInstance,
    (algebraMap ((K₁ ⊗[k₀] K₂) ⧸ m) (AlgebraicClosure ((K₁ ⊗[k₀] K₂) ⧸ m))).comp
      ((Ideal.Quotient.mk m).comp (Algebra.TensorProduct.includeLeftRingHom)),
    (algebraMap ((K₁ ⊗[k₀] K₂) ⧸ m) (AlgebraicClosure ((K₁ ⊗[k₀] K₂) ⧸ m))).comp
      ((Ideal.Quotient.mk m).comp ((Algebra.TensorProduct.includeRight : K₂ →ₐ[k₀] K₁ ⊗[k₀] K₂) : K₂ →+* K₁ ⊗[k₀] K₂)), ?_⟩
  ext x
  simp only [RingHom.comp_apply]
  congr 1
  congr 1
  show f₁ x ⊗ₜ[k₀] (1 : K₂) = (1 : K₁) ⊗ₜ[k₀] f₂ x
  rw [show f₁ x = algebraMap k₀ K₁ x from rfl, show f₂ x = algebraMap k₀ K₂ x from rfl,
    ← Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply']

