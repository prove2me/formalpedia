    (fun k => (a ((k : ZMod m),j)).1.2.1.val)
  · simpa only [Nat.cast_zero] using (ha (0,j)).1 (by simp)
  · intro k hk
    have ht := (ha ((k : ZMod m),j)).2.2.1
    have hkval : (k : ZMod m).val = k := ZMod.val_cast_of_lt (by omega)
    have hh := ht (by rw [hkval]; omega)
    simpa only [gridRight,Nat.cast_add,Nat.cast_one] using hh
  · have ht := (ha (((m-1 : ℕ) : ZMod m),j)).2.2.2.2.1
    exact ht (ZMod.val_cast_of_lt (by omega))

theorem row_total {m : ℕ} [NeZero m] (a : (ZMod m × ZMod m) → GridState)
    (ha : Valid a) (i : ZMod m) :
    ∑ k ∈ Finset.range m,(a (i,(k : ZMod m))).1.1.val = 1 := by
