theorem encK_Fsw (t : IState HS) (R : List Item) (ys : List ℤ) (vP vG vS u : ℕ) :
    NLogN.KIL.encK (t.upd 0 R) (Fsw ys vP vG vS u) =
      (pushSt t [(kP, (vP : ℤ)), (NLogN.KIL.kG, (vG : ℤ)), (NLogN.KIL.kS, (vS : ℤ)), (aU, (u : ℤ))]).upd 0
        (ints ys ++ R) := by
