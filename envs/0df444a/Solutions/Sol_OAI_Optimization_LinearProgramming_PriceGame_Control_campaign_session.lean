theorem Computation.allQueries_mono (P Q : Query N → Prop) (f : ∀ q, P q → Q q)
    (p : Computation N α) (hp : p.AllQueries P) : p.AllQueries Q := by
  induction p with
  | pure => exact True.intro
  | ask q next ih => exact ⟨f q hp.1, fun b => ih b (hp.2 b)⟩

