/-!
# The Schönhage–Strassen bound `O(n log n log log n)`
-/

namespace NLogN

open IntMul

attribute [local irreducible] fmA

/-- The Schönhage–Strassen machine. -/
def ssMachine : MultitapeTM := machineOf (fun j => compile (ssProg j)) (by norm_num)

