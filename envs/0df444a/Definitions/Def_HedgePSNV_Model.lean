-- url     : https://prove2.me/theorems/aea474be-81d4-46e3-a5f1-c2b6feca6b71
-- title:
--   Demand–asset model, risk-neutral measure $\mathbb P^M$, $V_t$, $Z^M_t$, $\delta_t$ and Assumptions 4–5
-- statement:
--   The model of §3.1. On a probability space $(\Omega,\mathbb P)$ live two independent standard Brownian motions $B$ and $\tilde B$; $\mathcal F$ and $\mathcal G$ are the augmented filtrations of $(B,\tilde B)$ and of $B$. The **asset price** solves
--   $$
--   dX_t=X_t(\mu_t\,dt+\sigma_t\,dB_t),\qquad X_0=x_0, \qquad (8)
--   $$
--   with continuous $\mathcal G$-adapted $\mu$, $\sigma>0$, and $(X,\mu,\sigma)$ Markov under $\mathbb P$. The **asset-driven demand** $C$ is continuous, $\mathcal G$-adapted, $C_0=0$, and each increment $C_v-C_u$ is measurable with respect to $\sigma\{X_t:u\le t\le v\}$. The **market size** is $A_T=C_T+\tilde\sigma\tilde B_T$ (10).
--
--   The **market price of risk** is $\eta_t=\mu_t/\sigma_t$ (11) and
--   $$
--   Z_t=\exp\Big(-\int_0^t\eta_s\,dB_s-\tfrac12\int_0^t\eta_s^2\,ds\Big),\qquad \frac{d\mathbb P^M}{d\mathbb P}=Z_T \qquad (12),
--   $$
--   with $(X,\sigma)$ Markov under $\mathbb P^M$. Derived objects: the payoff $H_T(P,R)$ evaluated at $A_T$; $V_0(P,R)=\mathbb E^M[H_T(P,R)]$; $V_t(P,R)=\mathbb E^M[H_T(P,R)\mid\mathcal F_t]$ (17); $Z^M_t=\mathbb E^M[Z_T\mid\mathcal F_t]$ and the constant $Z^M_0=\mathbb E^M[Z_T]$ (16); $\delta_t(P,R)=\tilde\sigma(P-s)\,\mathbb P^M(A_T\le R\mid\mathcal F_t)$ (19).
--
--   A pair $(\theta,\chi)$ is an **$X$-gains pair** when $\chi_t=\int_0^t\theta_u\,dX_u=\int_0^t\theta_uX_u\mu_u\,du+\int_0^t\theta_uX_u\sigma_u\,dB_u$ a.s. for $t\le T$; $L=\int_0^\cdot b\,d\tilde B$ is the analogous relation for $\tilde B$.
--
--   **Assumption 4**: $\int_0^T\mathbb E[(X_t\sigma_t)^2]\,dt<\infty$. **Assumption 5**: $Z$ is a square-integrable martingale on $[0,T]$ under $\mathbb P$. Two integrability predicates state presuppositions of the paper: `NegPartIntegrable Q` ($\mathbb E_Q[(C_T)^-]<\infty$, so that $\mathbb E_Q[H_T]$ exists) and `NegPartL2` ($\mathbb E[((C_T)^-)^2]<\infty$, so that $\mathrm{Var}[H_T]<\infty$).
--
--   **Formalization Note** Processes are indexed by $\mathbb R_{\ge0}$ and constrained on $[0,T]$. Stochastic integrals are the published relation `EthierKurtz.HasBrownianItoIntegral` (step approximations converging in probability; every-path square integrability, integrands cut off after $T$ for strategies), and drift integrals are pathwise. The Itô integrals $\int X\sigma\,dB$ and $\int\eta\,dB$ are carried as data; the latter is taken in a $\mathcal G$-adapted version so that $Z$ is $\mathcal G$-adapted, as the paper uses (p.ec23). Brownian independence is independence of the two path-valued maps. Conditional expectations are Mathlib's `condExp`.
-- source:
--   Wang–Yao–Zhang, How Does Risk Hedging Impact Operations? Insights from a Price-Setting Newsvendor Model, arXiv:2201.01026v4, §3.1, (8)–(12), Assumptions 4–5, pp.11–12; (16)–(19), p.15; (13), p.13

import Mathlib
import Definitions.Def_EthierKurtz_HasBrownianItoIntegral
import Definitions.Def_HedgePSNV_Params
import Definitions.Def_HedgePSNV_Newsvendor
import Definitions.Def_HedgePSNV_IsMartingaleOn
import Definitions.Def_HedgePSNV_IsMarkovWrt
import Definitions.Def_HedgePSNV_IsAugmentedNaturalFiltration

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace HedgePSNV

/-- The data of the demand–asset model, arXiv:2201.01026v4, §3.1, pp.11–12: a probability
space `(Ω, P)`; two Brownian motions `B` and `B̃` (`Bt`); the filtrations `F` (generated by
`(B, B̃)`) and `G` (generated by `B`); the asset price `X`, its drift `µ` and volatility `σ`
in `dX_t = X_t(µ_t dt + σ_t dB_t)` (8); the asset-driven demand component `C` of (9)–(10);
`J`, the Itô integral `∫_0^· X_uσ_u dB_u` of (8); and `I`, the Itô integral
`∫_0^· η_u dB_u` of the market price of risk in (12). The hypotheses on these data are
`Model.Standing`.

**Formalization Note** Processes are indexed by `ℝ≥0` and only `t ∈ [0, T]` matters. The two
Itô integrals are carried as data and pinned down by `EthierKurtz.HasBrownianItoIntegral` in
`Model.Standing`. -/
structure Model (p : Params) (Ω : Type*) [m : MeasurableSpace Ω] where
  P : Measure Ω
  B : ℝ≥0 → Ω → ℝ
  Bt : ℝ≥0 → Ω → ℝ
  F : Filtration ℝ≥0 m
  G : Filtration ℝ≥0 m
  X : ℝ≥0 → Ω → ℝ
  μ : ℝ≥0 → Ω → ℝ
  σ : ℝ≥0 → Ω → ℝ
  C : ℝ≥0 → Ω → ℝ
  J : ℝ≥0 → Ω → ℝ
  I : ℝ≥0 → Ω → ℝ

namespace Model

variable {p : Params} {Ω : Type*} [m : MeasurableSpace Ω]

/-- The market size `A_T = C_T + σ̃B̃_T`, arXiv:2201.01026v4, (10), p.11. -/
def AT (M : Model p Ω) (ω : Ω) : ℝ := M.C p.T ω + p.σt * M.Bt p.T ω

/-- The market price of risk `η_t = µ_t/σ_t`, arXiv:2201.01026v4, (11), p.12. -/
noncomputable def η (M : Model p Ω) (t : ℝ≥0) (ω : Ω) : ℝ := M.μ t ω / M.σ t ω

/-- `Z_t = exp(−∫_0^t η_s dB_s − ½∫_0^t η_s² ds)`, arXiv:2201.01026v4, (12), p.12, with the
Itô integral `∫_0^t η dB = I_t`. -/
noncomputable def Z (M : Model p Ω) (t : ℝ≥0) (ω : Ω) : ℝ :=
  Real.exp (-(M.I t ω) - (1 / 2) * ∫ u in (0 : ℝ)..(t : ℝ), M.η u.toNNReal ω ^ 2)

/-- The risk-neutral measure `P^M`, `dP^M/dP := Z_T`, arXiv:2201.01026v4, (12), p.12. -/
noncomputable def PM (M : Model p Ω) : Measure Ω :=
  M.P.withDensity (fun ω => ENNReal.ofReal (M.Z p.T ω))

/-- The production payoff `H_T(P,R) = (P − c)(R − bP) − (P − s)(R − A_T)^+` as a random
variable, arXiv:2201.01026v4, pp.7–8. -/
def H (M : Model p Ω) (P R : ℝ) (ω : Ω) : ℝ := payoff p P R (M.AT ω)

/-- `V_0(P,R) = E^M[H_T(P,R)]`, the expected production payoff under `P^M`,
arXiv:2201.01026v4, (18), p.15. -/
noncomputable def V0 (M : Model p Ω) (P R : ℝ) : ℝ := nvValue p M.PM M.AT P R

/-- The projected production payoff `V_t(P,R) := E^M[H_T(P,R) | F_t]`, arXiv:2201.01026v4,
(17), p.15. -/
noncomputable def V (M : Model p Ω) (P R : ℝ) (t : ℝ≥0) : Ω → ℝ :=
  condExp (M.F t) M.PM (M.H P R)

/-- `Z^M_t := E^M(Z_T | F_t)`, arXiv:2201.01026v4, (16), p.15. -/
noncomputable def ZM (M : Model p Ω) (t : ℝ≥0) : Ω → ℝ :=
  condExp (M.F t) M.PM (M.Z p.T)

/-- The constant `Z^M_0 = E^M(Z_T)`, arXiv:2201.01026v4, (16), p.15.

**Formalization Note** `F_0` is trivial up to null sets, so `E^M(Z_T | F_0)` is a.s. this
constant; the constant is used where the paper writes `Z^M_0` in a formula. -/
noncomputable def ZM0 (M : Model p Ω) : ℝ := ∫ ω, M.Z p.T ω ∂M.PM

/-- The process `δ_t(P,R) = σ̃(P − s) P^M(A_T ≤ R | F_t)` of (19), arXiv:2201.01026v4, p.15. -/
noncomputable def delta (M : Model p Ω) (P R : ℝ) (t : ℝ≥0) (ω : Ω) : ℝ :=
  p.σt * (P - p.s) *
    condExp (M.F t) M.PM (Set.indicator {x | M.AT x ≤ R} (fun _ => (1 : ℝ))) ω

/-- `χ` is the gains process `χ_t = ∫_0^t θ_s dX_s` on `[0, T]`, arXiv:2201.01026v4, (13),
p.13 and (EC.7.15), p.ec29 ("ϑ is X_t-integrable"): with `dX = Xµ dt + Xσ dB`, almost surely
for every `t ≤ T`, `χ_t = ∫_0^t θ_uX_uµ_u du + K_t`, where `K` is the Itô integral
`∫_0^· θ_uX_uσ_u dB_u`.

**Formalization Note** The Itô integral is the published relation
`EthierKurtz.HasBrownianItoIntegral` (integrand cut off after `T`), which asks for
`∫_0^t (θXσ)² du < ∞` on every path; the `du`-integral is a pathwise interval integral,
asked to exist on every path. The paper's condition is almost-sure finiteness; under the
augmented filtration a strategy can be set to zero on the exceptional null set without losing
adaptedness, so the class of gains processes is the same up to indistinguishability. -/
def IsXGains (M : Model p Ω) (θ χ : ℝ≥0 → Ω → ℝ) : Prop :=
  (∀ ω, ∀ t : ℝ≥0, t ≤ p.T → IntervalIntegrable
      (fun u : ℝ => θ u.toNNReal ω * M.X u.toNNReal ω * M.μ u.toNNReal ω) volume 0 (t : ℝ)) ∧
  ∃ K : ℝ≥0 → Ω → ℝ,
    EthierKurtz.HasBrownianItoIntegral M.P (fun t => M.F t) M.B
      (fun t ω => if t ≤ p.T then θ t ω * M.X t ω * M.σ t ω else 0) K ∧
    ∀ᵐ ω ∂M.P, ∀ t : ℝ≥0, t ≤ p.T →
      χ t ω = (∫ u in (0 : ℝ)..(t : ℝ),
        θ u.toNNReal ω * M.X u.toNNReal ω * M.μ u.toNNReal ω) + K t ω

/-- `L` is the Itô integral `∫_0^· b_s dB̃_s` on `[0, T]` (the `dB̃` terms of (18) and
(EC.7.1), arXiv:2201.01026v4, pp.15, ec23), via `EthierKurtz.HasBrownianItoIntegral` with the
integrand cut off after `T`. -/
def IsBtIntegral (M : Model p Ω) (b L : ℝ≥0 → Ω → ℝ) : Prop :=
  EthierKurtz.HasBrownianItoIntegral M.P (fun t => M.F t) M.Bt
    (fun t ω => if t ≤ p.T then b t ω else 0) L

/-- The standing model of arXiv:2201.01026v4, §3.1, pp.11–12 (with footnote 4):
1. `P` is a probability measure; `B` and `B̃` are standard Brownian motions under `P`,
   independent of each other (as path-valued random variables);
2. `F` and `G` are the `P`-augmented natural filtrations of `(B, B̃)` and of `B`;
3. `µ`, `σ` are continuous `G`-adapted processes with `σ > 0`;
4. `X` is a continuous `G`-adapted process with `X_0 = x₀` solving (8):
   a.s., for all `t ≤ T`, `X_t = x₀ + ∫_0^t X_uµ_u du + ∫_0^t X_uσ_u dB_u`;
5. `(X, µ, σ)` is Markovian under `P` (with respect to `F`);
6. `C` is a continuous `G`-adapted process with `C_0 = 0` and, for `u ≤ v ≤ T`,
   `C_v − C_u` measurable with respect to `σ{X_t : u ≤ t ≤ v}` (9);
7. `I` is the Itô integral `∫_0^· η dB` entering `Z` in (12), taken in a `G`-adapted version;
8. `(X, σ)` is Markovian under `P^M` (with respect to `F`).

**Formalization Note** In item 6 "adapted to the sigma-algebra generated by {X_t, u ≤ t ≤ v}" is
read as measurability, restricted to `v ≤ T`. The Markov property is `IsMarkovWrt`; the
filtrations are augmented (`IsAugmentedNaturalFiltration`). The pathwise drift integral in
item 4 exists because the paths are continuous. In item 7 the Itô integral of the `G`-adapted
integrand `η` is a limit in probability and is fixed only up to a null set; it is taken in a
`G`-adapted version (one exists because `G` is augmented), so that `Z_T` and the density of
`P^M` are `G_T`-measurable, as the paper uses (p.ec23, "{Z_t} is clearly adapted to G_t"). -/
structure Standing (M : Model p Ω) : Prop where
  prob : IsProbabilityMeasure M.P
  brownB : IsBrownianReal M.B M.P
  brownBt : IsBrownianReal M.Bt M.P
  indep : IndepFun (fun ω t => M.B t ω) (fun ω t => M.Bt t ω) M.P
  filtF : IsAugmentedNaturalFiltration M.P (fun t ω => (M.B t ω, M.Bt t ω)) M.F
  filtG : IsAugmentedNaturalFiltration M.P M.B M.G
  μ_cont : ∀ ω, Continuous (fun t => M.μ t ω)
  σ_cont : ∀ ω, Continuous (fun t => M.σ t ω)
  μ_adapted : StronglyAdapted M.G M.μ
  σ_adapted : StronglyAdapted M.G M.σ
  σ_pos : ∀ t ω, 0 < M.σ t ω
  X_cont : ∀ ω, Continuous (fun t => M.X t ω)
  X_adapted : StronglyAdapted M.G M.X
  X_zero : ∀ ω, M.X 0 ω = p.x₀
  X_ito : EthierKurtz.HasBrownianItoIntegral M.P (fun t => M.F t) M.B
    (fun t ω => M.X t ω * M.σ t ω) M.J
  X_sde : ∀ᵐ ω ∂M.P, ∀ t : ℝ≥0, t ≤ p.T →
    M.X t ω = p.x₀ + (∫ u in (0 : ℝ)..(t : ℝ), M.X u.toNNReal ω * M.μ u.toNNReal ω) + M.J t ω
  markovP : IsMarkovWrt M.P M.F p.T (fun t ω => (M.X t ω, M.μ t ω, M.σ t ω))
  C_cont : ∀ ω, Continuous (fun t => M.C t ω)
  C_adapted : StronglyAdapted M.G M.C
  C_zero : ∀ ω, M.C 0 ω = 0
  C_incr : ∀ u v : ℝ≥0, u ≤ v → v ≤ p.T →
    Measurable[⨆ t : ℝ≥0, ⨆ (_ : t ∈ Set.Icc u v), MeasurableSpace.comap (M.X t) inferInstance]
      (fun ω => M.C v ω - M.C u ω)
  I_ito : EthierKurtz.HasBrownianItoIntegral M.P (fun t => M.F t) M.B M.η M.I
  I_adapted : StronglyAdapted M.G M.I
  markovPM : IsMarkovWrt M.PM M.F p.T (fun t ω => (M.X t ω, M.σ t ω))

/-- The negative part of the asset-driven demand component is integrable under `Q`:
`E_Q[(C_T)^−] < ∞`. With the Gaussian term `σ̃B̃_T` this is the integrability of `H_T(P,R)` under
`Q` for every `(P, R)`.

**Formalization Note** Not printed: statements about `E[H_T(P,R)]`, `V_0(P,R) = E^M[H_T(P,R)]`
or `V_t(P,R) = E^M[H_T(P,R) | F_t]` presuppose that these expectations exist; this predicate
states it, so that the Bochner integrals are the paper's values rather than a junk `0`. -/
def NegPartIntegrable (M : Model p Ω) (Q : Measure Ω) : Prop :=
  Integrable (fun ω => max (-(M.C p.T ω)) 0) Q

/-- Square integrability of the negative part of the asset-driven demand component under `P`:
`E[((C_T)^−)²] < ∞`.

**Formalization Note** Not printed: the mean–variance problems (7), (13), (14) presuppose
`Var[H_T(P,R)] < ∞` (p.9: `Var[H_T(P,R)] = (P − s)²Var[(R − A_T)^+]`; p.ec23: "Var(A_T) < ∞"),
which Assumptions 1–3 do not imply. With the Gaussian term `σ̃B̃_T` it is equivalent to
`H_T(P,R) ∈ L²(P)` for all `(P,R)`; without it every hedged payoff has infinite variance,
problem (14) is undefined, and `B ≡ ⊤`. It is a hypothesis of exactly the statements that
involve `B(m,P,R)`. -/
def NegPartL2 (M : Model p Ω) : Prop :=
  MemLp (fun ω => max (-(M.C p.T ω)) 0) 2 M.P

/-- Assumption 4, arXiv:2201.01026v4, p.11: `∫_0^T E[(X_tσ_t)²] dt < ∞`. -/
def Assumption4 (M : Model p Ω) : Prop :=
  ∫⁻ u in Set.Icc (0 : ℝ) (p.T : ℝ),
      ∫⁻ ω, ENNReal.ofReal ((M.X u.toNNReal ω * M.σ u.toNNReal ω) ^ 2) ∂M.P < ⊤

/-- Assumption 5, arXiv:2201.01026v4, p.12: `Z_t` is a square-integrable martingale over
`[0, T]` under `P` (with respect to `F`). -/
def Assumption5 (M : Model p Ω) : Prop :=
  IsMartingaleOn p.T M.F M.P M.Z ∧ ∀ t : ℝ≥0, t ≤ p.T → MemLp (M.Z t) 2 M.P

end Model

end HedgePSNV


