end CPQ

open CirclePackingConstants in
theorem solution (n : ℕ → ℕ) (hn : ∀ i, n i ≤ 2) (hsum : ∑ i ∈ Finset.range 16, n i = 16) (hne : ∃ i < 16, n i ≠ 1)
    (hab : (n 0 = 0 ∧ n 1 = 0)) :
    ∃ e s tx ty, Sixteen.Matches Sixteen.sixteenLib n e s tx ty := by
  have h0 := hn 0
  have h1 := hn 1
  have h2 := hn 2
  obtain ⟨ha, hb⟩ := hab
  exact CPQ.piece_sound Sixteen.sixteenLib CPQ.covTabP00 CPQ.tabP00_ok CPQ.covTokP00 0 0 CPQ.pieceP00_ok (by omega) (by omega) n hn hsum hne ha hb
