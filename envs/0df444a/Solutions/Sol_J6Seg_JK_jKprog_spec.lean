namespace J6Seg.JK

open IntMul NLogN NLogN.KIL NLogN.KFB Function Finset

/-! ## The list side -/

theorem gflat_zip_append {a b c d : List ℤ} (h : a.length = b.length) :
    gflat ((a ++ c).zip (b ++ d)) = gflat (a.zip b) ++ gflat (c.zip d) := by
  rw [List.zip_append h, gflat_append]

theorem gflat_zip_replicate (n : ℕ) :
    gflat ((List.replicate n (0 : ℤ)).zip (List.replicate n 0)) = List.replicate (2 * n) 0 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by ring]
    simp only [List.replicate_succ, List.zip_cons_cons, gflat_cons, ih]

theorem jKerG_eq {P k K G : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
    {cc : List (List ℤ)} {v : List ℤ} (hb : bs.length = fs.length) (hv : fs.length ≤ v.length) :
    jKerG P K G fs.length fs bs cc v = wOut P k K fs bs cc v ++ List.replicate (G - fs.length) 0 := by
  have h1 : fwdK P fs (v.take fs.length) [] = fA P fs v fs.length := by
    rw [fwdK_eq_fA P fs _ (by simp; omega)]
    simp [fA, List.take_take]
  have hl : (fA P fs v fs.length).length = fs.length := fA_length P fs v le_rfl hv
  have h2 : bwdK P bs (fA P fs v fs.length) [] [] = (bwdS P bs (fA P fs v fs.length) bs.length).1 :=
    bwdK_eq_bwdS P bs _ (by rw [hl, hb])
  simp only [jKerG, wOut, h1, h2, wF, hb]
  rfl

theorem gbnd_of {B : ℕ} {x : List GI} (h1 : Bnd B (x.map Prod.fst)) (h2 : Bnd B (x.map Prod.snd)) :
    GBnd B x := by
  intro a ha
  obtain ⟨z, hz, ha'⟩ := List.mem_flatMap.1 ha
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha'
  rcases ha' with rfl | rfl
  · exact h1 _ (List.mem_map.2 ⟨z, hz, rfl⟩)
  · exact h2 _ (List.mem_map.2 ⟨z, hz, rfl⟩)

end J6Seg.JK

end

