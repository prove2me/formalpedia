  · obtain ⟨rfl, rfl⟩ := h1
    simp [TypeDensity.crossingQ]
  · by_cases h2 : 0 < c ∧ 0 < h
    · rw [TypeDensity.crossingQ_of_pos a b c h h2.1 h2.2, TypeDensity.crossingQ_of_pos b a h c h2.2 h2.1,
        TypeDensity.lawCoef_stateLaw_crossing_comm a b c h ha hb h2.1 h2.2]
    · rw [TypeDensity.qPositive_crossingQ a b c h (by omega) h1,
        TypeDensity.qPositive_crossingQ b a h c (by omega) (by tauto)]
