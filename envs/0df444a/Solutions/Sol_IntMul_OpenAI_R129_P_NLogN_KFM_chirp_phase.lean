      by_cases j1 : j = mOc
      · subst j1; simp [Ne.symm hdO]
      by_cases j2 : j = dst
      · subst j2
        simp only [if_pos rfl, if_neg hdO]
        rw [pushL_succ v d k hk, ints_cons, show d - k - 1 = d - k - 1 from rfl]
        rfl
      · simp [j1, j2])
  have e : St d = s.upd dst (ints ((List.range d).map v) ++ s.G dst) := by
    simp only [hSt, pushL_full]
  rw [e] at H
  exact H

/-- **All sources**: `srcP dst` leaves `s_0, …, s_{d−1}` on top of `dst`. -/
theorem srcP_run (dst : Fin HS) (hdst : DstOk dst) (s : IState HS) (d d' Q Mh Mf : ℕ)
    (LD : List Item) (hD : s.G NLogN.KFM.zD = .int (d : ℤ) :: LD) (h : SrcRegs s d' Q Mh Mf)
    (hj : ∀ j < d, (j < d' → j ≤ Mh) ∧ (d' ≤ j → j - d' ≤ Mf)) :
