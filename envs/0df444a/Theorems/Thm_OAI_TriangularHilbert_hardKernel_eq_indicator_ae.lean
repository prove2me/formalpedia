theorem OAI.TriangularHilbert.hardKernel_eq_indicator_ae {r R : ℝ} (hR : r ≤ R) :
    (fun t => hardKernel r R t) =ᵐ[volume]
      (annulus r R).indicator (fun t : ℝ => 1/t) := by sorry
