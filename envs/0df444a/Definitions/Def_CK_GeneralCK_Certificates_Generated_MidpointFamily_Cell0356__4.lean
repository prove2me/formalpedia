theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨279825709268,280375465083⟩ ⟨744048730101,744122103983⟩ ⟨138510977309,141589609867⟩ := rfl
noncomputable def centerUpper : ℝ := (608186764465 / 1099511627776)
