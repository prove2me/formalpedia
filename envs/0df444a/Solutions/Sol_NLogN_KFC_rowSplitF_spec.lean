set_option linter.unusedSimpArgs false

namespace NLogN.KIL

open AModel

theorem map_val_finRange (n : ℕ) : (List.finRange n).map Fin.val = List.range n := by
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp

theorem flatMap_finRange {α : Type*} (n : ℕ) (f : Fin n → List α) :
    (List.finRange n).flatMap f =
      (List.range n).flatMap fun i => if h : i < n then f ⟨i, h⟩ else [] := by
  rw [← map_val_finRange, List.flatMap_map]
  exact fm_congr fun x _ => by simp [x.isLt]

theorem decode3 {P L : ℕ} {rest : Shape} {p g b : ℕ} (hp : p < P) (hg : g < L)
    (hb : b < AModel.vol rest) :
    decode (P :: L :: rest) ((p * L + g) * AModel.vol rest + b) = p :: g :: decode rest b := by
  have hv : Valid (P :: L :: rest) (p :: g :: decode rest b) :=
    List.Forall₂.cons hp (List.Forall₂.cons hg (valid_decode hb))
  have he : encode (P :: L :: rest) (p :: g :: decode rest b) = (p * L + g) * AModel.vol rest + b := by
    simp only [encode, List.headD_cons, List.tail_cons, vol_cons, encode_decode hb]; ring
  rw [← he, decode_encode hv]

/-- The concatenation of all `W` streams of the cyclic row split. -/
theorem rowSplit_all_eq (P W L : ℕ) (rest : Shape) (xs : List ℤ) :
    (List.finRange W).flatMap (fun w => rowSplit P W L rest w 0 xs) =
      AModel.pull [1, P * L, W, AModel.vol rest] [1, W, P * L, AModel.vol rest] gS 0 xs := by
  rw [← inp_recOf', flatMap_finRange]
  unfold inp blkIn
  simp only [List.range_one, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  refine fm_congr fun w hw => ?_
  simp only [List.mem_range] at hw
  rw [dif_pos hw]
  unfold rowSplit AModel.pull
  rw [show AModel.vol (P :: L :: rest) = P * L * AModel.vol rest by simp [AModel.vol]; ring, range_mul]
  simp only [List.map_flatMap, List.map_map]
  rw [range_mul]
  simp only [List.flatMap_assoc, List.flatMap_map]
  refine fm_congr fun p hp => fm_congr fun g hg => List.map_congr_left fun b hb => ?_
  simp only [List.mem_range] at hp hg hb
  simp only [Function.comp, decode3 hp hg hb]
  congr 1
  simp only [rowSplitAddr, encode, List.headD_cons, List.tail_cons, vol_cons,
    encode_decode hb]
  ring

