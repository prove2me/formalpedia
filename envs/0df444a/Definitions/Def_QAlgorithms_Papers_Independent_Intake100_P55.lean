import Mathlib

/-!
Goodman--Hauschild, arXiv:math/0411155v2. Algebraic statement targets.
This file constructs the presentations of Definitions 3.1 and 3.6 directly.
Paper-specific names distinguish these multiplicative presentations from the
degenerate/cyclotomic accepted presentations and unrelated short-name collisions.
No geometric tangle algebra is replaced by an algebraic presentation or a free module.
The geometric and remaining combinatorial interfaces are deferred in HARD.md.
Indices are one based. Out-of-range generator helpers return zero; all source
uses carry explicit range guards. Integer powers use the inverse generator word.
Compilation is pending the batch mechanical handoff.
-/

noncomputable section

open scoped Classical

namespace QAlgorithms.Papers.Independent.Intake100.P55

/-- Ordinary ground data, Definition 2.6, PDF p.7 and §3.1, PDF p.15.
Neither z nor any loop parameter is required to be invertible. -/
structure Ground (R : Type*) [CommRing R] where
  lam : Rˣ
  delta : Rˣ
  z : R
  compatibility : (↑lam⁻¹ : R) - ↑lam = z * ((delta : R) - 1)

/-- One-based generator range, Definitions 3.1 and 3.6, PDF pp.15,17. -/
def BMWIndex (n i : ℕ) : Prop := 1 ≤ i ∧ i < n

/-- Both adjacency choices in i±1, Definitions 3.1 and 3.6, PDF pp.15,17. -/
def BMWAdjacent (i j : ℕ) : Prop := i + 1 = j ∨ j + 1 = i

/-- Generators of the ordinary (aff=false) or affine (aff=true) presentation,
PDF pp.15,17. At level zero there are no letters; ordinary level one is empty. -/
inductive BMWGenerator (aff : Bool) (n : ℕ)
  | g : {i : ℕ // BMWIndex n i} → Bool → BMWGenerator aff n
  | e : {i : ℕ // BMWIndex n i} → BMWGenerator aff n
  | x : Fin (if aff then min n 1 else 0) → Bool → BMWGenerator aff n

/-- Free g_i, or its inverse if inv=true; zero outside 1≤i<n, PDF pp.15,17. -/
def bmwFreeG (R : Type*) [CommRing R] (aff : Bool) (n i : ℕ) (inv : Bool) :
    FreeAlgebra R (BMWGenerator aff n) :=
  if h : BMWIndex n i then FreeAlgebra.ι R (.g ⟨i, h⟩ inv) else 0

/-- Free e_i; zero outside 1≤i<n, PDF pp.15,17. -/
def bmwFreeE (R : Type*) [CommRing R] (aff : Bool) (n i : ℕ) :
    FreeAlgebra R (BMWGenerator aff n) :=
  if h : BMWIndex n i then FreeAlgebra.ι R (.e ⟨i, h⟩) else 0

/-- Free x_1 or x_1 inverse, present only at positive affine levels, PDF p.17. -/
def bmwFreeX (R : Type*) [CommRing R] (aff : Bool) (n : ℕ) (inv : Bool) :
    FreeAlgebra R (BMWGenerator aff n) :=
  if h : 0 < (if aff then min n 1 else 0) then
    FreeAlgebra.ι R (.x ⟨0, h⟩ inv) else 0

section Presentation

variable {R : Type*} [CommRing R] (P : Ground R) (q : ℕ → R) (aff : Bool) (n : ℕ)

/-- Exactly the seven ordinary relation groups (Definition 3.1, PDF p.15)
and, when aff=true, the eight affine groups (Definition 3.6, PDF p.17).
The q argument specifies every positive q_r; q_0 is unused. There is no
cyclotomic relation or admissibility condition. Adjacent index pairs are ordered. -/
inductive OrdinaryAffineBMWRel (P : Ground R) (q : ℕ → R) (aff : Bool) (n : ℕ) :
    FreeAlgebra R (BMWGenerator aff n) → FreeAlgebra R (BMWGenerator aff n) → Prop
  | invL (i : ℕ) (hi : BMWIndex n i) : OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeG R aff n) i true) 1
  | invR (i : ℕ) (hi : BMWIndex n i) : OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i true * (bmwFreeG R aff n) i false) 1
  | squareE (i : ℕ) (hi : BMWIndex n i) : OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i ^ 2) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (P.delta : R) * (bmwFreeE R aff n) i)
  | braid (i : ℕ) (hi : 1 ≤ i) (hin : i + 1 < n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeG R aff n) (i+1) false * (bmwFreeG R aff n) i false)
        ((bmwFreeG R aff n) (i+1) false * (bmwFreeG R aff n) i false * (bmwFreeG R aff n) (i+1) false)
  | ggFar (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j)
      (hd : i + 1 < j ∨ j + 1 < i) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeG R aff n) j false) ((bmwFreeG R aff n) j false * (bmwFreeG R aff n) i false)
  | geFar (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j)
      (hd : i + 1 < j ∨ j + 1 < i) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeE R aff n) j) ((bmwFreeE R aff n) j * (bmwFreeG R aff n) i false)
  | eeFar (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j)
      (hd : i + 1 < j ∨ j + 1 < i) : OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i * (bmwFreeE R aff n) j) ((bmwFreeE R aff n) j * (bmwFreeE R aff n) i)
  | tripleE (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j) (ha : BMWAdjacent i j) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i * (bmwFreeE R aff n) j * (bmwFreeE R aff n) i) ((bmwFreeE R aff n) i)
  | tangleL (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j) (ha : BMWAdjacent i j) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeG R aff n) j false * (bmwFreeE R aff n) i) ((bmwFreeE R aff n) j * (bmwFreeE R aff n) i)
  | tangleR (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j) (ha : BMWAdjacent i j) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i * (bmwFreeG R aff n) j false * (bmwFreeG R aff n) i false) ((bmwFreeE R aff n) i * (bmwFreeE R aff n) j)
  | skein (i : ℕ) (hi : BMWIndex n i) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false - (bmwFreeG R aff n) i true) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) P.z * ((bmwFreeE R aff n) i - 1))
  | untwistL (i : ℕ) (hi : BMWIndex n i) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeG R aff n) i false * (bmwFreeE R aff n) i) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (↑P.lam⁻¹ : R) * (bmwFreeE R aff n) i)
  | untwistR (i : ℕ) (hi : BMWIndex n i) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i * (bmwFreeG R aff n) i false) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (↑P.lam⁻¹ : R) * (bmwFreeE R aff n) i)
  | untwistNear (i j : ℕ) (hi : BMWIndex n i) (hj : BMWIndex n j) (ha : BMWAdjacent i j) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) i * (bmwFreeG R aff n) j false * (bmwFreeE R aff n) i) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (P.lam : R) * (bmwFreeE R aff n) i)
  | xInvL (haf : aff = true) (hn : 1 ≤ n) : OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) false * (bmwFreeX R aff n) true) 1
  | xInvR (haf : aff = true) (hn : 1 ≤ n) : OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) true * (bmwFreeX R aff n) false) 1
  | affineBraid (haf : aff = true) (hn : 2 ≤ n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) false * (bmwFreeG R aff n) 1 false * (bmwFreeX R aff n) false * (bmwFreeG R aff n) 1 false)
        ((bmwFreeG R aff n) 1 false * (bmwFreeX R aff n) false * (bmwFreeG R aff n) 1 false * (bmwFreeX R aff n) false)
  | xgFar (haf : aff = true) (j : ℕ) (hj : 2 ≤ j) (hjn : j < n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) false * (bmwFreeG R aff n) j false) ((bmwFreeG R aff n) j false * (bmwFreeX R aff n) false)
  | xeFar (haf : aff = true) (j : ℕ) (hj : 2 ≤ j) (hjn : j < n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) false * (bmwFreeE R aff n) j) ((bmwFreeE R aff n) j * (bmwFreeX R aff n) false)
  | loop (haf : aff = true) (r : ℕ) (hr : 1 ≤ r) (hn : 2 ≤ n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) 1 * (bmwFreeX R aff n) false ^ r * (bmwFreeE R aff n) 1) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (q r) * (bmwFreeE R aff n) 1)
  | unwrapL (haf : aff = true) (hn : 2 ≤ n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeE R aff n) 1 * (bmwFreeX R aff n) false * (bmwFreeG R aff n) 1 false * (bmwFreeX R aff n) false) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (↑P.lam⁻¹ : R) * (bmwFreeE R aff n) 1)
  | unwrapR (haf : aff = true) (hn : 2 ≤ n) :
      OrdinaryAffineBMWRel P q aff n ((bmwFreeX R aff n) false * (bmwFreeG R aff n) 1 false * (bmwFreeX R aff n) false * (bmwFreeE R aff n) 1) ((algebraMap R (FreeAlgebra R (BMWGenerator aff n))) (↑P.lam⁻¹ : R) * (bmwFreeE R aff n) 1)

/-- Presented ordinary or affine BMW algebra, PDF pp.15,17. -/
abbrev OrdinaryAffineBMW := RingQuot (OrdinaryAffineBMWRel P q aff n)

/-- Canonical quotient map, Definitions 3.1 and 3.6, PDF pp.15,17. -/
def presentation : FreeAlgebra R (BMWGenerator aff n) →ₐ[R] OrdinaryAffineBMW P q aff n :=
  RingQuot.mkAlgHom R (OrdinaryAffineBMWRel P q aff n)

/-- Source g_i or its inverse, PDF pp.15,17. -/
def ghCrossing (i : ℕ) (inv : Bool) : OrdinaryAffineBMW P q aff n := presentation P q aff n (bmwFreeG R aff n i inv)

/-- Source e_i, PDF pp.15,17. -/
def ghContraction (i : ℕ) : OrdinaryAffineBMW P q aff n := presentation P q aff n (bmwFreeE R aff n i)

/-- Source x_1 or its inverse, Definition 3.6, PDF p.17. -/
def bmwX (inv : Bool) : OrdinaryAffineBMW P q aff n := presentation P q aff n (bmwFreeX R aff n inv)

/-- Sanity check: the e-square relation descends to the quotient, PDF pp.15,17. -/
example (i : ℕ) (hi : BMWIndex n i) :
    ghContraction P q aff n i ^ 2 = algebraMap R _ (P.delta : R) * ghContraction P q aff n i := by
  simpa [ghContraction, presentation] using (RingQuot.mkAlgHom_rel R (OrdinaryAffineBMWRel.squareE (P := P) (q := q) (aff := aff) (n := n) i hi))

/-- Sanity check: level zero has no e_1 generator, PDF pp.15,17. -/
example : bmwFreeE R aff 0 1 = 0 := by simp [bmwFreeE, BMWIndex]

end Presentation

section Words

variable {A : Type*} [Monoid A]

/-- Ordered product h_a ... h_(a+l-1); empty product is 1, PDF p.18. -/
def forward (h : ℕ → A) (a l : ℕ) : A :=
  ((List.range l).map fun j => h (a+j)).prod

/-- Ordered product in the reverse order of forward, PDF p.18. -/
def backward (h : ℕ → A) (a l : ℕ) : A :=
  ((List.range l).reverse.map fun j => h (a+j)).prod

/-- Positive powers use u, negative powers use its specified inverse v,
PDF pp.19--21. This avoids the junk-value inverse operation on a general ring. -/
def signedPower (u v : A) (s : ℤ) : A :=
  if s < 0 then v ^ (-s).toNat else u ^ s.toNat

/-- Recursive f_k word, Definition 5.22, PDF p.40. The offset is a shift
of generator indices; f_0=1 extends the empty word convention. -/
def fWord (g e : ℕ → A) (offset : ℕ) : ℕ → A
  | 0 => 1
  | k+1 => forward g (offset+1) (2*k) * fWord g e offset k *
      e (offset+2*k+1) * backward g (offset+1) (2*k)

/-- The j-th diamond column e_(k-j) e_(k-j+2) ... e_(k+j), PDF p.40.
Only j<k is used. -/
def diamondColumn (e : ℕ → A) (k j : ℕ) : A :=
  ((List.range (j+1)).map fun a => e (k-j+2*a)).prod

/-- Diamond columns in forward then reverse order, omitting the repeated
middle column, Proposition 5.24, PDF p.40. -/
def diamondWord (e : ℕ → A) (k : ℕ) : A :=
  forward (diamondColumn e k) 0 k * backward (diamondColumn e k) 0 (k-1)

/-- Interleaved word z_0 x^r_1 z_1 ... x^r_k z_k, Lemma 3.15, PDF p.21. -/
def alternatingWord (u : A) (k : ℕ) (zs : Fin (k+1) → A) (rs : Fin k → ℕ) : A :=
  (List.ofFn fun j : Fin k => zs ⟨j.val, Nat.lt_trans j.isLt (Nat.lt_succ_self k)⟩ *
    u ^ rs j).prod * zs ⟨k, Nat.lt_succ_self k⟩

/-- Empty and first diamond checks, PDF p.40. -/
example (g e : ℕ → A) : fWord g e 0 0 = 1 ∧ fWord g e 0 1 = e 1 := by
  simp [fWord, forward, backward]

/-- The middle column is not tripled in the k=1 case, PDF p.40. -/
example (e : ℕ → A) : diamondWord e 1 = e 1 := by
  simp [diamondWord, diamondColumn, forward, backward]

end Words

section Algebras

variable {R : Type*} [CommRing R] (P : Ground R) (q : ℕ → R)

/-- x_r and its explicit inverse word, §3.3, PDF p.19. At r=0 the helper
is zero; assertions about x_r always have 1≤r≤n. -/
def bmwWinding (n : ℕ) (inv : Bool) (r : ℕ) : OrdinaryAffineBMW P q true n :=
  if r = 0 then 0 else
    backward (fun j => ghCrossing P q true n j inv) 1 (r-1) * bmwX P q true n inv *
      forward (fun j => ghCrossing P q true n j inv) 1 (r-1)

/-- Integer bmwWinding powers, §3.4, PDF p.21. -/
def windingPower (n r : ℕ) (s : ℤ) : OrdinaryAffineBMW P q true n :=
  signedPower (bmwWinding P q n false r) (bmwWinding P q n true r) s

/-- Base winding normalization, PDF p.19. -/
example (n : ℕ) : bmwWinding P q n false 1 = bmwX P q true n false := by
  simp [bmwWinding, forward, backward]

/-- The canonical image of a lower-level algebra in W_n, §3.4, PDF pp.21--25.
Adjoining the images of its defining generators gives the canonical image,
without assuming tower injectivity. sourceAff=false also gives the ordinary
subalgebra in an affine ambient algebra. -/
def bmwLevel (aff sourceAff : Bool) (n m : ℕ) : Subalgebra R (OrdinaryAffineBMW P q aff n) :=
  Algebra.adjoin R {a | (∃ i, BMWIndex m i ∧
    (a = ghCrossing P q aff n i false ∨ a = ghCrossing P q aff n i true ∨ a = ghContraction P q aff n i)) ∨
    (sourceAff = true ∧ 1 ≤ m ∧ (a = bmwX P q aff n false ∨ a = bmwX P q aff n true))}

/-- The f_k word evaluated in W_n with an optional one-step index shift,
Definition 5.22 and Proposition 5.26, PDF pp.40--42. -/
def fElement (n offset k : ℕ) : OrdinaryAffineBMW P q false n :=
  fWord (fun i => ghCrossing P q false n i false) (ghContraction P q false n) offset k

/-- Ordered odd contraction word, Definition 5.29, PDF p.44. -/
def oddContractions (n k : ℕ) : OrdinaryAffineBMW P q false n :=
  ((List.range k).map fun j => ghContraction P q false n (2*j+1)).prod

/-- Sanity check for the zero-contraction filtration, PDF p.44. -/
example (n : ℕ) : oddContractions P q n 0 = 1 := rfl

/-- All Laurent monomials x_1^mu_1 ... x_n^mu_n, §6.2, PDF p.56. -/
def laurent (n : ℕ) (mu : Fin n → ℤ) : OrdinaryAffineBMW P q true n :=
  (List.ofFn fun i : Fin n => windingPower P q n (i.val+1) (mu i)).prod

/-- The empty Laurent word is 1 at bmwLevel zero, PDF p.56. -/
example (mu : Fin 0 → ℤ) : laurent P q 0 mu = 1 := by simp [laurent]

end Algebras

section Spans

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- Linear span of U e, §3.4, PDF p.25. -/
def rightSpan (U : Set A) (e : A) : Submodule R A :=
  Submodule.span R {v | ∃ a ∈ U, v = a * e}

/-- Linear span of e U, §5.4, PDF p.44. -/
def leftSpan (e : A) (U : Set A) : Submodule R A :=
  Submodule.span R {v | ∃ a ∈ U, v = e * a}

/-- Linear span of e U e, §3.4, PDF p.25. -/
def bmwCornerSpan (e : A) (U : Set A) : Submodule R A :=
  Submodule.span R {v | ∃ a ∈ U, v = e * a * e}

/-- Linear span of U e U, §5.4, PDF pp.44--45. With U=univ this is
the two-sided ideal generated by e, represented as an R-submodule. -/
def sandwichSpan (U : Set A) (e : A) : Submodule R A :=
  Submodule.span R {v | ∃ a ∈ U, ∃ b ∈ U, v = a * e * b}

/-- Lower-bmwLevel bimodule span U C U, §3.4, PDF p.21. -/
def insertionSpan (U C : Set A) : Submodule R A :=
  Submodule.span R {v | ∃ a ∈ U, ∃ b ∈ U, ∃ chi ∈ C, v = a * chi * b}

/-- Left translate of a submodule as a linear span, Lemma 3.19, PDF p.25. -/
def translateSpan (a : A) (V : Submodule R A) : Submodule R A :=
  Submodule.span R {v | ∃ w ∈ V, v = a * w}

end Spans

section Statements

variable {R : Type*} [CommRing R] (P : Ground R) (q : ℕ → R)

end Statements

end QAlgorithms.Papers.Independent.Intake100.P55


