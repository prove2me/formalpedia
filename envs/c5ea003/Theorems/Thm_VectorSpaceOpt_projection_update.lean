-- title:
--   The projection-updating theorem
-- statement:
--   Work in a Hilbert space $H$ of random variables, where the inner product of two variables is their correlation, $\langle a, b\rangle = E[ab]$.
--
--   Let $\beta \in H$ and let $\hat\beta_1$ be its orthogonal projection on a closed subspace $Y_1$ — the best estimate of $\beta$ given the data generating $Y_1$. Let $y_2$ be an $m$-vector of random variables generating a subspace $Y_2$, let $\hat y_2$ be the vector of projections of the components of $y_2$ onto $Y_1$ (the best estimates of $y_2$ from the old data), and set
--
--   $$\tilde y_2 = y_2 - \hat y_2 .$$
--
--   Then the projection of $\beta$ onto $Y_1 + Y_2$ is
--
--   $$\hat\beta = \hat\beta_1 + E[\beta\,\tilde y_2^\top]\,\big(E[\tilde y_2 \tilde y_2^\top]\big)^{-1} \tilde y_2 ,$$
--
--   that is, $\hat\beta_1$ plus the best estimate of $\beta$ in the subspace generated by $\tilde y_2$.
--
--   The mechanism is purely geometric: $\tilde y_2$ is orthogonal to $Y_1$ by construction and generates a subspace $\tilde Y_2$ with $Y_1 + Y_2 = Y_1 \oplus \tilde Y_2$, and a projection onto a sum of *orthogonal* subspaces is the sum of the projections. The old estimate is never recomputed — only the part of the new data that could not be anticipated from the old contributes. This is the engine behind sequential estimation and, in particular, the Kalman recursion.
--
--   **Formalization Note.** As in the source, the statement is given for a single random variable $\beta$; the vector case is $n$ separate problems. The projection onto the enlarged subspace is characterized by membership plus orthogonality of the error, which determines it uniquely, rather than through a projection operator. `G` is the Gram matrix of the innovations, assumed invertible.
-- source:
--   David G. Luenberger, Optimization by Vector Space Methods, John Wiley & Sons, 1969, §4.6, Theorem 3, p. 92

import Mathlib
open Matrix
open scoped RealInnerProductSpace

namespace VectorSpaceOpt

theorem projection_update {H : Type} [NormedAddCommGroup H]
    [InnerProductSpace ℝ H] {m : ℕ}
    (Y₁ : Submodule ℝ H) (β b₁ : H) (hb₁ : b₁ ∈ Y₁)
    (hproj : ∀ s ∈ Y₁, ⟪β - b₁, s⟫ = 0)
    (y₂ yh₂ yt : Fin m → H)
    (hyh : ∀ i, yh₂ i ∈ Y₁)
    (hyproj : ∀ i, ∀ s ∈ Y₁, ⟪y₂ i - yh₂ i, s⟫ = 0)
    (hyt : ∀ i, yt i = y₂ i - yh₂ i)
    (G : Matrix (Fin m) (Fin m) ℝ) (hG : ∀ i j, G i j = ⟪yt i, yt j⟫)
    (hdet : IsUnit G.det)
    (c : Fin m → ℝ) (hc : ∀ i, c i = ⟪β, yt i⟫)
    (bh : H) (hbh : bh = b₁ + ∑ i, (G⁻¹.mulVec c) i • yt i) :
    bh ∈ Y₁ ⊔ Submodule.span ℝ (Set.range y₂) ∧
    (∀ s ∈ Y₁ ⊔ Submodule.span ℝ (Set.range y₂), ⟪β - bh, s⟫ = 0) := by sorry

end VectorSpaceOpt
