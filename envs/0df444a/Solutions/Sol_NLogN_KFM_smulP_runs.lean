    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hS : s.G pX3 = .int S :: LS)
    (st : IState HS) (x : ℤ) (L0 : List Item) (hF : Fixd s st) (h0 : st.G 0 = .int x :: L0) :
    IRuns I iprog (smulB pM) st ((st.upd 0 L0).upd pO (.int ((S * x).tdiv (2 ^ Δ)) :: st.G pO))
      (110 * (zsz x + 1) + cMulC M x S + 2 + 1000 * (zsz S + zsz x + Δ + 3) + 2 * zsz x + 2) := by
  have hR' : st.G pR = .int (2 ^ Δ) :: LR := by
    rw [hF pR (by decide) (by decide) (by decide) (by decide) (by decide), hR]
  have hS' : st.G pX3 = .int S :: LS := by
    rw [hF pX3 (by decide) (by decide) (by decide) (by decide) (by decide), hS]
  have m1 := IRuns.mv (I := I) (iprog := iprog) (s := st) (i := 0) (j := pX1) (a := x) (L := L0)
    (by decide) h0
  set s1 := (st.upd 0 L0).upd pX1 (.int x :: st.G pX1) with hs1
  have m2 := mulC_runs (I := I) (iprog := iprog) hM pP1 pX1 pX3 (by decide) (by decide) (by decide)
    s1 x S (st.G pX1) LS (by simp +decide [hs1]) (by simp +decide [hs1, hS']) (hdom _ _)
  rw [show s1.G pP1 = st.G pP1 by simp +decide [hs1]] at m2
  set s2 := s1.upd pP1 (.int (S * x) :: st.G pP1) with hs2
  have m3 := IRuns.const (I := I) (iprog := iprog) (s := s2) pP2 0
  rw [show s2.G pP2 = st.G pP2 by simp +decide [hs2, hs1], zsz_zero] at m3
  set s3 := s2.upd pP2 (.int 0 :: st.G pP2) with hs3
  have m4 := combC_runs (I := I) (iprog := iprog) false s3 (S * x) 0 Δ (st.G pP1) (st.G pP2) LR
    (by simp +decide [hs3, hs2]) (by simp +decide [hs3]) (by simp +decide [hs3, hs2, hs1, hR'])
  rw [show s3.G pO = st.G pO by simp +decide [hs3, hs2, hs1]] at m4
  set s4 := ((s3.upd pP1 (st.G pP1)).upd pP2 (st.G pP2)).upd pO
    (.int ((S * x + if false then -0 else 0).tdiv (2 ^ Δ)) :: st.G pO) with hs4
  have m5 := IRuns.drop (I := I) (iprog := iprog) (s := s4) (i := pX1) (a := x) (L := st.G pX1)
    (by simp +decide [hs4, hs3, hs2, hs1])
  refine (m1.seq (m2.seq (m3.seq (m4.seq m5)))).mono' ?_ ?_
  · simp only [hs4, hs3, hs2, hs1, if_false, Bool.false_eq_true, add_zero]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have c1 := moveIntCost_le (zsz x); have := zsz_mul_le S x
    simp only [zsz_zero] at *
    omega

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT KIL
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {w φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ w → NLogN.zsz y ≤ w → M.Φ x y ≤ φ) (Δ : ℕ) (S : ℤ)
    (s : NLogN.IState NLogN.HS) (L : List ℤ) (R0 LR LS : List NLogN.Item)
    (h0 : s.G 0 = NLogN.ints L ++ R0) (hR : s.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR) (hS : s.G NLogN.KFM.pX3 = .int S :: LS)
    (hw : ∀ x ∈ L, NLogN.zsz x ≤ w) (hSw : NLogN.zsz S ≤ w) :
    NLogN.IRuns I iprog (NLogN.KFM.itemP (NLogN.KFM.smulB pM) L.length) s
      (s.upd 0 (NLogN.ints (L.map fun x => (S * x).tdiv (2 ^ Δ)) ++ R0))
      (NLogN.KFM.cItem L.length (φ + 5000 * (w + Δ + 3)) (2 * w)) := by
  refine NLogN.KFM.itemP_runs (NLogN.KFM.smulB pM) _ _ (2 * w) s L R0 h0 (fun x hx => ?_)
    (fun st x L0 hF hst hx => ?_)
  · have := NLogN.KFH.zsz_tdiv_le (S * x) (2 ^ Δ); have := NLogN.zsz_mul_le S x; have := hw x hx; omega
  · refine (NLogN.KFM.smulB_runs hM hdom Δ S s LR LS hR hS st x L0 hF hst).mono ?_
    have := NLogN.KFM.cMulC_le hΦ (hw x hx) hSw; have := hw x hx; omega
end
