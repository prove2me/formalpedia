    have h : c ^ i₀ * (c ^ i₀ * a) ≤ c ^ i₀ * (c ^ (s - i₀) * b) := by
      calc c ^ i₀ * (c ^ i₀ * a) = c ^ (2 * i₀) * a := by rw [two_mul, pow_add, mul_assoc]
