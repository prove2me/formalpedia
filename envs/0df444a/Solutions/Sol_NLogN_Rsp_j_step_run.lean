set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN

theorem gints_eq_ints' (L : List (ℤ × ℤ)) : gints L = ints (pairInts L) := by
  induction L with
  | nil => rfl
  | cons z L ih => simp [gints_cons, pairInts, ih, ints] at *

theorem pairInts_length' (L : List (ℤ × ℤ)) : (pairInts L).length = 2 * L.length := by
  induction L with
  | nil => rfl
  | cons z L ih => simp [pairInts] at *; omega

theorem pairInts_zipWith (ng : Bool) :
    ∀ (A W : List (ℤ × ℤ)), A.length = W.length →
      pairInts (List.zipWith (gsgF ng) A W) = List.zipWith (sgF ng) (pairInts A) (pairInts W)
  | [], [], _ => rfl
  | a :: A, w :: W, h => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    simp [pairInts, gsgF] at *
    exact pairInts_zipWith ng A W h
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem vL_length (p s t α : ℕ) (u : List (ℤ × ℤ)) (hu : u.length = s) :
    ∀ j, (vL p s t α u j).length = s
  | 0 => by simp [vL, halfL, hu]
  | j + 1 => by simp [vL, eapL]

theorem accL_length (p s t α : ℕ) (u : List (ℤ × ℤ)) (n : ℕ) : (accL p s t α u n).length = s := by
  simp [accL]

theorem sgF_pow (j : ℕ) (a w : ℤ) : sgF (decide (j % 2 = 1)) a w = a + (-1) ^ j * w := by
  rcases Nat.mod_two_eq_zero_or_one j with h | h
  · obtain ⟨k, rfl⟩ : ∃ k, j = 2 * k := ⟨j / 2, by omega⟩
    simp [sgF, pow_mul]
  · obtain ⟨k, rfl⟩ : ∃ k, j = 2 * k + 1 := ⟨j / 2, by omega⟩
    simp [sgF, pow_succ, pow_mul]

theorem accL_succ (p s t α : ℕ) (u : List (ℤ × ℤ)) (hu : u.length = s) (n : ℕ) :
    accL p s t α u (n + 1) =
      List.zipWith (gsgF (decide (n % 2 = 1))) (accL p s t α u n) (vL p s t α u n) := by
  apply List.ext_getElem (by simp [accL_length, vL_length p s t α u hu])
  intro l h1 h2
  simp only [accL_length] at h1
  have hv : l < (vL p s t α u n).length := by rw [vL_length p s t α u hu]; exact h1
  simp only [List.getElem_zipWith, accL, List.getElem_map, List.getElem_range, gsgF, sgF_pow,
    Finset.sum_range_succ, List.getD_eq_getElem _ _ hv]

end NLogN.Rsp

