/-! # Lorentzian signature from an explicit frame

If `Eᵀ G E = diag(-1, 1, …, 1)` then `E` is automatically invertible (take determinants), so a
certificate only has to exhibit the frame and check one matrix identity. -/

namespace ExactVacuumAtlas

theorem det_eta (n : ℕ) : (eta n).det = -1 := by
  simp [eta, Matrix.det_diagonal, Fin.prod_univ_succ, Fin.succ_ne_zero]

theorem isUnit_det_of_frame {n : ℕ} {G E : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
    (h : E.transpose * G * E = eta n) : IsUnit E.det := by
  have hd := congrArg Matrix.det h
  rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, det_eta] at hd
  refine isUnit_iff_ne_zero.mpr fun h0 => ?_
  rw [h0] at hd
  norm_num at hd

theorem isLorentzian_of_frame {n : ℕ} {G : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
    (E : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) (h : E.transpose * G * E = eta n) :
    IsLorentzian G :=
  ⟨E, isUnit_det_of_frame h, h⟩

end ExactVacuumAtlas

