variable {q : ℕ} [Fact q.Prime]

theorem exists_pow_eq (ζ₀ ζ : Idx q) : ∃ d : (ZMod q)ˣ, ζ₀.pow d = ζ := by
  have hq : 0 < q := (Fact.out : q.Prime).pos
  obtain ⟨i, -, hi⟩ := ζ₀.isPrimitiveRoot.eq_pow_of_pow_eq_one ζ.isPrimitiveRoot.pow_eq_one
  have hcop : i.Coprime q := by
    have := (ζ₀.isPrimitiveRoot.pow_iff_coprime hq i).mp (hi ▸ ζ.isPrimitiveRoot)
    exact this
  refine ⟨ZMod.unitOfCoprime i hcop, Idx.ext ?_⟩
  rw [Idx.val_pow, ZMod.coe_unitOfCoprime, ZMod.val_natCast, ← hi]
  conv_rhs => rw [← Nat.mod_add_div i q, pow_add, pow_mul, ζ₀.isPrimitiveRoot.pow_eq_one, one_pow, mul_one]

theorem exists_redQ_eq_unipotent (M' : ℕ) (t : ZMod q) :
    ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ redQ q γ = CuspidalType.unipotent q t := by
  refine ⟨⟨!![1, (t.val : ℤ); 0, 1], by simp [Matrix.det_fin_two_of]⟩, ?_, ?_⟩
  · rw [CongruenceSubgroup.Gamma0_mem]
    simp
  · refine Units.ext ?_
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [redQ, CuspidalType.unipotent, Matrix.SpecialLinearGroup.toGL, Matrix.SpecialLinearGroup.map]

theorem unipotent_smul_lineInfty (t : ZMod q) : CuspidalType.unipotent q t • lineInfty q = lineInfty q := by
  rw [lineInfty, Projectivization.smul_mk]
  congr 1
  rw [Units.smul_def, CuspidalType.unipotent_val]
  ext i
  fin_cases i <;> simp [Matrix.mulVec]

variable {A : ValuationSubring (AlgebraicClosure ℚ)}

theorem apply_eq_of_tameCharacter_eq_one (hP : A.LiesOverPrime q) (π : AlgebraicClosure ℚ)
    (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) {τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ}
    (hχ : A.tameCharacter π τ = 1) : τ π = π :=
  ((ValuationSubring.tameCharacter_eq_one_iff_apply_eq_and_conj_mem_and_exists_apply_eq_of_pow_sq_sub_one_eq
    q A hP π hπ).1 τ).mp hχ

theorem smul_idx_eq_of_tameCharacter_eq_one (hP : A.LiesOverPrime q) (π : AlgebraicClosure ℚ)
    (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) {τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ}
    (hτ : τ ∈ A.inertiaSubgroupIn ℚ) (hχ : A.tameCharacter π τ = 1) (ζ : Idx q) : τ • ζ = ζ :=
  Idx.ext (ValuationSubring.apply_eq_self_of_pow_eq_one_of_tameCharacter_eq_one q A hP π hπ hτ hχ
    ζ.isPrimitiveRoot.pow_eq_one)

theorem mem_iff_of_smul_eq (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hstab : σ • A = A)
    (a : AlgebraicClosure ℚ) : a ∈ A ↔ σ a ∈ A := by
  constructor
  · intro ha
    have := ValuationSubring.smul_mem_pointwise_smul σ a A ha
    rwa [hstab] at this
  · intro ha
    rw [← hstab, ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def, AlgEquiv.aut_inv,
      AlgEquiv.symm_apply_apply] at ha
    exact ha

theorem inertia_laws {τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ} (hτ : τ ∈ A.inertiaSubgroupIn ℚ)
    (σ : AlgebraicClosure ℚ ≃+* AlgebraicClosure ℚ) (hσ : ∀ a, σ a = τ a) :
    (∀ a : AlgebraicClosure ℚ, a ∈ A ↔ σ a ∈ A) ∧
    ∀ (a : A) (h : σ (a : AlgebraicClosure ℚ) ∈ A), IsLocalRing.residue A ⟨σ a, h⟩ = IsLocalRing.residue A a := by
  obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp hτ
  refine ⟨fun a => ?_, fun a h => ?_⟩
  · rw [hσ]
    exact mem_iff_of_smul_eq _ d.prop a
  · have hk := MonoidHom.mem_ker.mp hd
    have h1 := congrArg (fun f => f (IsLocalRing.residue A a)) hk
    simp only [MulSemiringAction.toRingAut_apply, RingAut.one_apply] at h1
    have h3 : (⟨σ a, h⟩ : A) = d • a := Subtype.ext (hσ a)
    rw [h3]
    convert h1 using 2 <;> first | (with_reducible_and_instances rfl) | rfl | skip

