-- title:
--   p. 9 and Definition 4.1, pp. 15–16 — the limiting Brownian motions and the diffusion model
-- statement:
--   Let $W=(W_0,W_1,\dots,W_K)$ be a standard $(K+1)$-dimensional Brownian motion on $(\Omega',\mathbb P')$. The limiting arrival and service processes are
--   $$\hat X(t)=(\hat\lambda-\langle\hat\mu,\mathbf 1\rangle)t+\sqrt{\bar\lambda\alpha^2}\,W_0(t),\qquad \hat S_k(t)=\sqrt{\bar\mu_k\gamma_k^2}\,W_k(t),$$
--   a Brownian motion with drift $\hat\lambda-\langle\hat\mu,\mathbf 1\rangle$ and variance $\bar\lambda\alpha^2$, and an independent driftless Brownian motion with covariance $\mathrm{diag}(\bar\mu_k\gamma_k^2)$. Let $\hat{\mathcal F}_t$ be generated by $\{\hat X(s),\hat S(s):s\le t\}$ and $\hat{\mathcal G}_t$ by $\{\hat X(s),\hat S(\tau(s)):s\le t\}$, with $\hat S(\tau(s))=(\hat S_1(\tau_1(s)),\dots,\hat S_K(\tau_K(s)))$, both augmented by the null sets.
--
--   A pair $(\hat Q,\hat A)$ is a **solution of the diffusion model** associated with $(\hat X,\hat S,\hat\Phi)$ if
--
--   1. $\hat Q$ is $\{\hat{\mathcal F}_t\}$-adapted and continuous, and there is a continuous $\{\hat{\mathcal F}_t\}$-adapted $\hat L$ such that almost surely $\hat L_k(0)=0$, $\hat L_k$ is non-decreasing and increases only when $\hat Q_k=0$, and
--   $$\hat Q(t)=\hat A(t)-\hat S(t)+\hat L(t)\in\mathbb R_+^K,\qquad t\ge0;\tag{39}$$
--   2. $\hat A$ is $\{\hat{\mathcal G}_t\}$-adapted and continuous, and almost surely $\hat A_1(t)+\dots+\hat A_K(t)=\hat X(t)$ for $t\ge0$ (40);
--   3. almost surely, with $\hat R=\hat\Phi(\hat Q,\hat A)$,
--   $$\hat R_1(t)=\dots=\hat R_K(t),\qquad t\ge0.\tag{41}$$
--
--   Equation (41) is state space collapse of the *estimated* queue lengths; the actual queue lengths $\hat Q_k$ need not be equal. The diffusion model is the limit object of Theorem 4.4.
--
--   **Formalization Note** "Generated by" is read as the natural filtration, augmented by all subsets of $\mathbb P'$-null sets. The page places $\hat X,\hat S$ on the prelimit space; here they live on any probability space carrying a standard Brownian motion, which includes the page's case. "$\hat L_k$ increases only when $\hat Q_k=0$" is the published `StieltjesComplementary`: $\int\hat Q_k\,d\hat L_k=0$. The page's remark that $\hat R$ is $\{\hat{\mathcal G}_t\}$-adapted is a consequence and is not imposed.
-- source:
--   Atar & Lipshutz, Heavy traffic limits for join the shortest estimated queue policy using delayed information, authors' manuscript of January 12, 2020 (Math. Oper. Res. 46(3), 2021, doi:10.1287/moor.2020.1056), p. 9 (the Brownian motions X̂, Ŝ); pp. 15–16, Definition 4.1, (39)–(41)

import Mathlib
import Definitions.Def_RankBasedSDI_LoadBalancing_Reflection
import Definitions.Def_RankBasedSDI_LoadBalancing_StochasticBasis
import Definitions.Def_JSEQDelay_Diffusion_Model
import Definitions.Def_JSEQDelay_Diffusion_Assumptions

namespace JSEQDelay.Diffusion

open MeasureTheory
open RankBasedSDI.LoadBalancing

/-!
Atar & Lipshutz (authors' manuscript of January 12, 2020), p. 9 (the limiting Brownian motions)
and Definition 4.1, pp. 15–16 (the diffusion model).
-/

/-- The limiting exogenous arrival process (p. 9): a one-dimensional Brownian motion with drift
`λ̂ − ⟨μ̂, 𝟏⟩` and variance `λ̄ α²`, built from coordinate `0` of a standard
`(K + 1)`-dimensional Brownian motion `W`:
`X̂(t) = (λ̂ − ⟨μ̂, 𝟏⟩) t + √(λ̄ α²) W₀(t)`. -/
noncomputable def limX {Ω' : Type*} {K : ℕ} (lamBar lamHat : ℝ) (muHat : Fin K → ℝ) (α : ℝ)
    (W : Ω' → ℝ → Fin (K + 1) → ℝ) : Ω' → ℝ → ℝ :=
  fun ω t => (lamHat - ∑ k, muHat k) * t + Real.sqrt (lamBar * α ^ 2) * W ω t 0

/-- The limiting service process (p. 9): a `K`-dimensional Brownian motion with zero drift and
diagonal covariance `diag(μ̄_k γ_k²)`, independent of `X̂`, built from coordinates `1, …, K` of
`W`: `Ŝ_k(t) = √(μ̄_k γ_k²) W_{k+1}(t)`. -/
noncomputable def limS {Ω' : Type*} {K : ℕ} (muBar : Fin K → ℝ) (γ : Fin K → ℝ)
    (W : Ω' → ℝ → Fin (K + 1) → ℝ) : Ω' → Path K :=
  fun ω t k => Real.sqrt (muBar k * γ k ^ 2) * W ω t k.succ

/-- The filtration `F̂_t` of Definition 4.1 (p. 15): the σ-algebra generated by
`{X̂(s), Ŝ(s) : 0 ≤ s ≤ t}`, augmented by the `P'`-null sets. -/
noncomputable def Fhat {Ω' : Type*} [MeasurableSpace Ω'] {K : ℕ} (P' : Measure Ω')
    (X : Ω' → ℝ → ℝ) (S : Ω' → Path K) (t : ℝ) : MeasurableSpace Ω' :=
  (⨆ (s : ℝ) (_ : s ∈ Set.Icc 0 t),
    MeasurableSpace.comap (fun ω => (X ω s, S ω s)) inferInstance) ⊔
  MeasurableSpace.generateFrom {A | P' A = 0}

/-- The filtration `Ĝ_t` of Definition 4.1 (p. 15): the σ-algebra generated by
`{X̂(s), Ŝ(τ(s)) : 0 ≤ s ≤ t}`, where `Ŝ(τ(s)) = (Ŝ₁(τ₁(s)), …, Ŝ_K(τ_K(s)))` (17), augmented by
the `P'`-null sets. -/
noncomputable def Ghat {Ω' : Type*} [MeasurableSpace Ω'] {K : ℕ} (P' : Measure Ω')
    (X : Ω' → ℝ → ℝ) (S : Ω' → Path K) (τ : ℝ → Fin K → ℝ) (t : ℝ) : MeasurableSpace Ω' :=
  (⨆ (s : ℝ) (_ : s ∈ Set.Icc 0 t),
    MeasurableSpace.comap (fun ω => (X ω s, fun k => S ω (τ s k) k)) inferInstance) ⊔
  MeasurableSpace.generateFrom {A | P' A = 0}

/-- **Definition 4.1** (pp. 15–16): `(Q̂, Â)` on `(Ω', P')` is a solution of the diffusion model
associated with `(X̂, Ŝ, Φ̂)` iff
* (i) `Q̂` is `F̂`-adapted with continuous paths on `[0, ∞)`, and there is an `F̂`-adapted
  process `L̂` with continuous paths such that almost surely
  `Q̂(t) = Â(t) − Ŝ(t) + L̂(t) ∈ ℝ₊^K` for `t ≥ 0` (39), `L̂_k(0) = 0`, `L̂_k` is non-decreasing
  and `L̂_k` increases only when `Q̂_k = 0` (`∫ Q̂_k dL̂_k = 0`);
* (ii) `Â` is `Ĝ`-adapted with continuous paths on `[0, ∞)`, and almost surely
  `Â₁(t) + ⋯ + Â_K(t) = X̂(t)` for `t ≥ 0` (40);
* (iii) almost surely `R̂₁(t) = ⋯ = R̂_K(t)` for `t ≥ 0` (41), where `R̂ = Φ̂(Q̂, Â)` (32). -/
def IsDiffusionSolution {Ω' : Type*} [MeasurableSpace Ω'] {K : ℕ} (P' : Measure Ω')
    (X : Ω' → ℝ → ℝ) (S : Ω' → Path K) (τ : ℝ → Fin K → ℝ) (PsiLim : Path K → Path K → Path K)
    (Qh Ah : Ω' → Path K) : Prop :=
  -- (i)
  ((∀ t, 0 ≤ t → Measurable[Fhat P' X S t] (fun ω => Qh ω t)) ∧
    (∀ ω, ContinuousOn (Qh ω) (Set.Ici 0)) ∧
    ∃ L : Ω' → Path K,
      (∀ t, 0 ≤ t → Measurable[Fhat P' X S t] (fun ω => L ω t)) ∧
      (∀ ω, ContinuousOn (L ω) (Set.Ici 0)) ∧
      ∀ᵐ ω ∂P',
        (∀ t, 0 ≤ t → Qh ω t = Ah ω t - S ω t + L ω t ∧ ∀ k, 0 ≤ Qh ω t k) ∧
        ∀ k, L ω 0 k = 0 ∧ MonotoneOn (fun t => L ω t k) (Set.Ici 0) ∧
          StieltjesComplementary (fun t => Qh ω t k) (fun t => L ω t k)) ∧
  -- (ii)
  ((∀ t, 0 ≤ t → Measurable[Ghat P' X S τ t] (fun ω => Ah ω t)) ∧
    (∀ ω, ContinuousOn (Ah ω) (Set.Ici 0)) ∧
    ∀ᵐ ω ∂P', ∀ t, 0 ≤ t → ∑ k, Ah ω t k = X ω t) ∧
  -- (iii)
  (∀ᵐ ω ∂P', ∀ t, 0 ≤ t → ∀ k j,
    PhiLim τ PsiLim (Qh ω) (Ah ω) t k = PhiLim τ PsiLim (Qh ω) (Ah ω) t j)

end JSEQDelay.Diffusion


