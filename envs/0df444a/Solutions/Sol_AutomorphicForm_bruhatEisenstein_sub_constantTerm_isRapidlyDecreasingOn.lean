    (hαbf : (αb : 𝔸).2 = 1) (hαba : ∀ v : InfinitePlace F, ‖(αb : 𝔸).1 v‖ = t) :
    ‖frameChar F (etaFst μ α hα s) (etaSnd ν α hα s) t₁ t₂‖ ≤ 1 := by
