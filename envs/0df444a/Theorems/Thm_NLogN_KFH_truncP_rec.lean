theorem NLogN.KFH.truncP_rec (s : IState HS) {r p Δ w : ℕ} (f : Fin HS → List ℤ) (zs : List GI)
    (xs : List (Fin r → ℂ)) (l : List ℤ) (hx : RecRep r (p + Δ) zs xs)
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz ((2 * zs.length : ℕ) : ℤ) ≤ Z) :
    RecRep r p (zs.map (gtr Δ)) (Butterfly.QpArr p xs) ∧ NLogN.KFB.GB w (zs.map (gtr Δ)) ∧
      FSp (truncP Δ (2 * zs.length)) (encK s f)
        (encK s (Function.update f 0 (gflat (zs.map (gtr Δ)) ++ l)))
        (cTrunc w Δ (2 * zs.length) Z) := by sorry
