theorem tensorGo_snoc {α : Type*} [Inhabited α] :
    ∀ (As : List (ℕ × (List α → List α))) (a : ℕ × (List α → List α)) (dims : List ℕ)
      (L : List α), tensorGo (As ++ [a]) dims L = tensorGo [a] (tgD As dims) (tensorGo As dims L)
  | [], a, dims, L => by simp [tgD, tensorGo]
  | (n', A) :: As, a, [], L => by simp [tgD, tensorGo]
  | (n', A) :: As, a, n :: rest, L => by
    simp only [List.cons_append, tensorGo, tgD]
    exact tensorGo_snoc As a _ _

theorem tgD_snoc {α : Type*} :
    ∀ (As : List (ℕ × (List α → List α))) (a : ℕ × (List α → List α)) (dims : List ℕ),
      tgD (As ++ [a]) dims = tgD [a] (tgD As dims)
  | [], a, dims => by simp [tgD]
  | (n', A) :: As, a, [] => by simp [tgD]
  | (n', A) :: As, a, n :: rest => by
    simp only [List.cons_append, tgD]
    exact tgD_snoc As a _

theorem tgD_one {α : Type*} (a : ℕ × (List α → List α)) (n : ℕ) (rest : List ℕ) :
    tgD [a] (n :: rest) = rest ++ [a.1] := by
  obtain ⟨n', A⟩ := a; simp [tgD]

/-- `take (k+1)` of a mapped range. -/
theorem take_succ_map_range {β : Type*} (f : ℕ → β) (K k : ℕ) (hk : k < K) :
    ((List.range K).map f).take (k + 1) = ((List.range K).map f).take k ++ [f k] := by
  rw [List.take_add_one]
  congr 1
  simp [hk]

/-- One step of a generic staged `tensorGo` over a mapped range of axes. -/
theorem tensorGo_stage {α : Type*} [Inhabited α] (f : ℕ → ℕ × (List α → List α)) (K k : ℕ)
    (hk : k < K) (dims : List ℕ) (L : List α) :
    tensorGo (((List.range K).map f).take (k + 1)) dims L =
      tensorGo [f k] (tgD (((List.range K).map f).take k) dims)
        (tensorGo (((List.range K).map f).take k) dims L) := by
  rw [take_succ_map_range f K k hk, tensorGo_snoc]

theorem tgD_stage {α : Type*} (f : ℕ → ℕ × (List α → List α)) (K k : ℕ) (hk : k < K)
    (dims : List ℕ) :
    tgD (((List.range K).map f).take (k + 1)) dims =
      tgD [f k] (tgD (((List.range K).map f).take k) dims) := by
  rw [take_succ_map_range f K k hk, tgD_snoc]

theorem pushes_all (B : ℕ) : ∀ (l : List (Fin HS × Ex HS)) (vs : List (Fin HS × ℤ))
    (s : IState HS), PushOK B s l vs →
    (pushes l).run s = NLogN.EX.pushV s vs ∧ (pushes l).ok s ∧
      (pushes l).cost s ≤ pwt l * 10 ^ 7 * (B + 2) ^ 2 + 1
  | [], [], s, _ => by simp [pushes, NLogN.EX.pushV, RS.run, RS.ok, RS.cost, pwt]
  | [], _ :: _, s, h => by simp [PushOK] at h
  | _ :: _, [], s, h => by simp [PushOK] at h
  | (r, e) :: l, (r', v) :: vs, s, h => by
    obtain ⟨rfl, hr, hc, ho, hb, hv, hl⟩ := h
    have e1 : (RS.push r' e).run s = s.upd r' (.int v :: s.G r') := by simp [RS.run, hv]
    obtain ⟨a1, a2, a3⟩ := pushes_all B l vs _ hl
    have c1 := RS.pushCost_le e s B hb
    refine ⟨?_, ⟨⟨hr, hc, ho⟩, ?_⟩, ?_⟩
    · simp only [pushes, RS.run] at e1 ⊢; rw [e1, a1]; rfl
    · rw [e1]; exact a2
    · simp only [pushes, RS.cost]
      rw [e1]
      simp only [pwt, List.map_cons, List.sum_cons] at a3 ⊢
      nlinarith

theorem pushV_append (s : IState HS) : ∀ (a b : List (Fin HS × ℤ)),
    NLogN.EX.pushV s (a ++ b) = NLogN.EX.pushV (NLogN.EX.pushV s a) b
  | [], b => rfl
  | (r, v) :: a, b => pushV_append _ a b

theorem pushV_G_not (s : IState HS) (j : Fin HS) : ∀ (vs : List (Fin HS × ℤ)),
    j ∉ vs.map Prod.fst → (NLogN.EX.pushV s vs).G j = s.G j
  | [], _ => rfl
  | (r, v) :: vs, h => by
    simp only [List.map_cons, List.mem_cons, not_or] at h
    simp only [NLogN.EX.pushV]
    rw [pushV_G_not _ j vs h.2, IState.upd_G, if_neg h.1]

theorem pushV_G_mem (s : IState HS) : ∀ (vs : List (Fin HS × ℤ)), (vs.map Prod.fst).Nodup →
    ∀ r v, (r, v) ∈ vs → (NLogN.EX.pushV s vs).G r = .int v :: s.G r
  | [], _, r, v, h => by simp at h
  | (r', v') :: vs, hn, r, v, h => by
    simp only [List.map_cons, List.nodup_cons] at hn
    simp only [NLogN.EX.pushV]
    rcases List.mem_cons.1 h with h1 | h1
    · obtain ⟨rfl, rfl⟩ := Prod.mk.inj h1
      rw [pushV_G_not _ _ vs hn.1]; simp
    · have hr : r ≠ r' := by
        intro e; subst e; exact hn.1 (List.mem_map.2 ⟨(r, v), h1, rfl⟩)
      rw [pushV_G_mem _ vs hn.2 r v h1, IState.upd_G, if_neg hr]

/-- Popping the pushed values (last first) undoes `pushV` (whatever happened to `j`). -/
theorem ex_pushV (w : IState HS) (B : ℕ) (e : Ex HS) : ∀ (pre : List (Fin HS × ℤ)),
    (∀ i ∈ e.regs, i ∉ pre.map Prod.fst) →
    e.eval (NLogN.EX.pushV w pre) = e.eval w ∧ (e.ok (NLogN.EX.pushV w pre) ↔ e.ok w) ∧
      (e.Bnd (NLogN.EX.pushV w pre) B ↔ e.Bnd w B)
  | [], _ => ⟨rfl, Iff.rfl, Iff.rfl⟩
  | (r, v) :: pre, h => by
    have h1 : r ∉ e.regs := fun hr => h r hr (by simp)
    have h2 : ∀ i ∈ e.regs, i ∉ pre.map Prod.fst := fun i hi hm => h i hi (by simp [hm])
    obtain ⟨a, b, c⟩ := ex_pushV (w.upd r (.int v :: w.G r)) B e pre h2
    simp only [NLogN.EX.pushV]
    refine ⟨a.trans (Ex.eval_upd _ _ _ e h1), b.trans (Ex.ok_upd _ _ _ e h1),
      c.trans (NLogN.CR.Ex.bnd_upd _ _ _ _ e h1)⟩

/-- `PushOK` when no expression reads a pushed register. -/
theorem pushOK_of (B : ℕ) (w : IState HS) : ∀ (l : List (Fin HS × Ex HS))
    (pre vs : List (Fin HS × ℤ)),
    l.map Prod.fst = vs.map Prod.fst →
    (∀ x ∈ l, ∀ i ∈ x.2.regs, i ∉ pre.map Prod.fst ++ l.map Prod.fst) →
    (∀ x ∈ l, x.1.val < 56 ∧ x.2.Clean ∧ x.2.ok w ∧ x.2.Bnd w B) →
    List.Forall₂ (fun x y => x.2.eval w = y.2) l vs →
    PushOK B (NLogN.EX.pushV w pre) l vs
  | [], pre, [], _, _, _, _ => trivial
  | [], pre, _ :: _, h, _, _, _ => by simp at h
  | _ :: _, pre, [], h, _, _, _ => by simp at h
  | (r, e) :: l, pre, (r', v) :: vs, hm, hd, hx, hf => by
    simp only [List.map_cons, List.cons.injEq] at hm
    obtain ⟨hr, hc, ho, hb⟩ := hx (r, e) (by simp)
    have hdis : ∀ i ∈ e.regs, i ∉ pre.map Prod.fst := fun i hi hm' =>
      hd (r, e) (by simp) i hi (List.mem_append_left _ hm')
    obtain ⟨a, b, c⟩ := ex_pushV w B e pre hdis
    rw [List.forall₂_cons] at hf
    refine ⟨hm.1.symm, hr, hc, b.2 ho, c.2 hb, by rw [a]; exact hf.1, ?_⟩
    have e1 : (NLogN.EX.pushV w pre).upd r (.int v :: (NLogN.EX.pushV w pre).G r) = NLogN.EX.pushV w (pre ++ [(r, v)]) := by
      rw [pushV_append]; rfl
    rw [e1]
    refine pushOK_of B w l (pre ++ [(r, v)]) vs hm.2 ?_ (fun x hx' => hx x (by simp [hx'])) hf.2
    intro x hx' i hi
    have := hd x (by simp [hx']) i hi
    simp only [List.map_append, List.map_cons, List.map_nil, List.mem_append, List.mem_cons,
      List.not_mem_nil, or_false, not_or] at this ⊢
    exact ⟨⟨this.1, this.2.1⟩, this.2.2⟩

theorem pops_pushV (j : Fin HS) (X : List Item) : ∀ (vs : List (Fin HS × ℤ)) (s : IState HS),
    j ∉ vs.map Prod.fst →
    (pops (vs.map Prod.fst)).run ((NLogN.EX.pushV s vs).upd j X) = s.upd j X
  | [], s, _ => rfl
  | (r, v) :: vs, s, h => by
    simp only [List.map_cons, List.mem_cons, not_or] at h
    simp only [List.map_cons, NLogN.EX.pushV, pops, RS.run]
    rw [pops_pushV j X vs _ h.2]
    apply IState.ext' _ (by simp) (by simp)
    intro x
    by_cases hx : x = r
    · subst hx; simp [Ne.symm h.1]
    · simp [hx]

theorem pops_okc (B : ℕ) (j : Fin HS) (X : List Item) : ∀ (vs : List (Fin HS × ℤ))
    (s : IState HS), j ∉ vs.map Prod.fst → (∀ x ∈ vs, x.1.val < 56 ∧ zsz x.2 ≤ B) →
    (pops (vs.map Prod.fst)).ok ((NLogN.EX.pushV s vs).upd j X) ∧
      (pops (vs.map Prod.fst)).cost ((NLogN.EX.pushV s vs).upd j X) ≤ vs.length * (2 * B + 2) + 1
