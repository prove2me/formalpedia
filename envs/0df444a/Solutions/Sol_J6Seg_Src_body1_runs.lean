          ((2 ^ (m - j) : ℕ) : ℤ) := by
        rw [show m - j = m - (j + 1) + 1 by omega, pow_succ]; push_cast; ring
      have hle : 2 ^ (m - j) ≤ 2 ^ A := le_trans (Nat.pow_le_pow_right (by norm_num) (by omega)) hmA
      have hle' : 2 ^ (m - (j + 1)) ≤ 2 ^ A :=
