@[simp] private theorem row_dualPos (j : Fin d) :
    (jointRowEquiv m d (.inr (.inr (.inl j)))).val = m+m+j := by
  change m+(m+j.val) = _; omega
@[simp] private theorem row_dualNeg (j : Fin d) :
