variable {S : Type*} [CommRing S] {F : Type*} [CommRing F]

private theorem ringHom_apply_one_entry (f : S →+* F) (i j : Fin 2) :
    f ((1 : Matrix (Fin 2) (Fin 2) S) i j) = (1 : Matrix (Fin 2) (Fin 2) F) i j := by
  by_cases h : i = j <;> simp [Matrix.one_apply, h]

