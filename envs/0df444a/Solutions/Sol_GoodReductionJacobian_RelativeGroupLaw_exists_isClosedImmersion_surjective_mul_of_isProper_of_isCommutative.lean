theorem nsmul_eq_pow (L : RelativeGroupLaw k fX) (hc : L.IsCommutative) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of k)) (n : ℕ) (x : SchemeHomOver t fX) :
    L.nsmul t n x = @HPow.hPow _ ℕ _ (@instHPow _ ℕ (pointCommGroup L hc t).toMonoid.toPow) x n := by
  letI := pointCommGroup L hc t
  induction n with
  | zero => rfl
  | succ n ih => rw [L.nsmul_succ, pow_succ, ih]; rfl

theorem comp_eq_transition {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)}
    (x : SchemeHomOver t fX) (P : SchemeHomOver fX fY) :
    NeronModelInfra.schemeHomOverComp x P = GoodReductionJacobian.schemeHomOverComp x.1 x.2 P :=
  rfl

theorem comp_lawMul (LY : RelativeGroupLaw k fY) {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t fX) (P Q : SchemeHomOver fX fY) :
    NeronModelInfra.schemeHomOverComp x (LY.mul fX P Q) =
      LY.mul t (NeronModelInfra.schemeHomOverComp x P) (NeronModelInfra.schemeHomOverComp x Q) := by
  rw [comp_eq_transition, LY.mul_natural fX t x.1 x.2 P Q]
  rfl

theorem comp_lawOne (LY : RelativeGroupLaw k fY) {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t fX) :
    NeronModelInfra.schemeHomOverComp x (LY.one fX) = LY.one t := by
  rw [comp_eq_transition, LY.one_natural fX t x.1 x.2]

theorem comp_lawNsmul (LY : RelativeGroupLaw k fY) {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t fX) (n : ℕ) (P : SchemeHomOver fX fY) :
    NeronModelInfra.schemeHomOverComp x (LY.nsmul fX n P) =
      LY.nsmul t n (NeronModelInfra.schemeHomOverComp x P) := by
  rw [comp_eq_transition, LY.nsmul_natural fX t x.1 x.2 n P]
  rfl

theorem comp_lawInv (LY : RelativeGroupLaw k fY) {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t fX) (P : SchemeHomOver fX fY) :
    NeronModelInfra.schemeHomOverComp x (LY.inv fX P) =
      LY.inv t (NeronModelInfra.schemeHomOverComp x P) := by
  letI := LY.pointGroup t
  have h : LY.mul t (NeronModelInfra.schemeHomOverComp x (LY.inv fX P))
      (NeronModelInfra.schemeHomOverComp x P) = LY.one t := by
    rw [← comp_lawMul, LY.inv_mul_cancel, comp_lawOne]
  exact (inv_eq_of_mul_eq_one_left h).symm

def IsHom (LX : RelativeGroupLaw k fX) (LY : RelativeGroupLaw k fY) (φ : SchemeHomOver fX fY) :
    Prop :=
  ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x y : SchemeHomOver t fX),
    NeronModelInfra.schemeHomOverComp (LX.mul t x y) φ =
      LY.mul t (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp y φ)

namespace IsHom

variable {LX : RelativeGroupLaw k fX} {LY : RelativeGroupLaw k fY} {LZ : RelativeGroupLaw k fZ}

theorem one {φ : SchemeHomOver fX fY} (h : IsHom LX LY φ) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of k)) :
    NeronModelInfra.schemeHomOverComp (LX.one t) φ = LY.one t := by
  letI := LY.pointGroup t
  have h1 := h t (LX.one t) (LX.one t)
  rw [LX.one_mul] at h1

  have : NeronModelInfra.schemeHomOverComp (LX.one t) φ *
      NeronModelInfra.schemeHomOverComp (LX.one t) φ =
      NeronModelInfra.schemeHomOverComp (LX.one t) φ := h1.symm
  exact mul_eq_left.mp this

theorem inv {φ : SchemeHomOver fX fY} (h : IsHom LX LY φ) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t fX) :
    NeronModelInfra.schemeHomOverComp (LX.inv t x) φ =
      LY.inv t (NeronModelInfra.schemeHomOverComp x φ) := by
  letI := LY.pointGroup t
  have h1 : LY.mul t (NeronModelInfra.schemeHomOverComp (LX.inv t x) φ)
      (NeronModelInfra.schemeHomOverComp x φ) = LY.one t := by
    rw [← h, LX.inv_mul_cancel, h.one]
  exact (inv_eq_of_mul_eq_one_left h1).symm

theorem nsmul {φ : SchemeHomOver fX fY} (h : IsHom LX LY φ) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of k)) (n : ℕ) (x : SchemeHomOver t fX) :
    NeronModelInfra.schemeHomOverComp (LX.nsmul t n x) φ =
      LY.nsmul t n (NeronModelInfra.schemeHomOverComp x φ) := by
  induction n with
  | zero => exact h.one t
  | succ n ih => rw [LX.nsmul_succ, LY.nsmul_succ, h, ih]

theorem comp {φ : SchemeHomOver fX fY} {ψ : SchemeHomOver fY fZ} (h₁ : IsHom LX LY φ)
    (h₂ : IsHom LY LZ ψ) : IsHom LX LZ (NeronModelInfra.schemeHomOverComp φ ψ) := by
  intro T t x y
  rw [← NeronModelInfra.schemeHomOverComp_assoc, h₁, h₂, NeronModelInfra.schemeHomOverComp_assoc,
    NeronModelInfra.schemeHomOverComp_assoc]

end IsHom

theorem eq_of_comp_mono_eq (φ : SchemeHomOver fX fY) [Mono φ.1] {T : Scheme.{u}}
    {t : T ⟶ Spec (CommRingCat.of k)} {x y : SchemeHomOver t fX}
    (hxy : NeronModelInfra.schemeHomOverComp x φ = NeronModelInfra.schemeHomOverComp y φ) :
    x = y := by
  have hval := congrArg Subtype.val hxy
  simp only [NeronModelInfra.schemeHomOverComp_coe] at hval
  exact Subtype.ext ((cancel_mono φ.1).1 hval)

theorem isCommutative_of_isHom_mono {LX : RelativeGroupLaw k fX} {LY : RelativeGroupLaw k fY}
    (hc : LY.IsCommutative) (φ : SchemeHomOver fX fY) [Mono φ.1] (h : IsHom LX LY φ) :
    LX.IsCommutative := by
  intro T t x y
  apply eq_of_comp_mono_eq φ
  rw [h t x y, h t y x, hc t]

def castLaw {f₁ f₂ : X ⟶ Spec (CommRingCat.of k)} (e : f₁ = f₂) (L : RelativeGroupLaw k f₁) :
    RelativeGroupLaw k f₂ :=
  e ▸ L

theorem castLaw_mul_val {f₁ f₂ : X ⟶ Spec (CommRingCat.of k)} (e : f₁ = f₂)
    (L : RelativeGroupLaw k f₁) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (x y : SchemeHomOver t f₂) :
    ((castLaw e L).mul t x y).1 =
      (L.mul t ⟨x.1, by rw [e]; exact x.2⟩ ⟨y.1, by rw [e]; exact y.2⟩).1 := by
  subst e
  rfl

theorem castLaw_isCommutative {f₁ f₂ : X ⟶ Spec (CommRingCat.of k)} (e : f₁ = f₂)
    (L : RelativeGroupLaw k f₁) (hc : L.IsCommutative) : (castLaw e L).IsCommutative := by
  subst e
  exact hc

theorem castLaw_isHom {f₁ f₂ : X ⟶ Spec (CommRingCat.of k)} (e : f₁ = f₂)
    (L : RelativeGroupLaw k f₁) (LY : RelativeGroupLaw k fY) (φ : SchemeHomOver f₁ fY)
    (h : IsHom L LY φ) : IsHom (castLaw e L) LY ⟨φ.1, by rw [φ.2, e]⟩ := by
  subst e
  exact h

end Calculus

section Kernel

variable {k : Type u} [Field k] {G A : Scheme.{u}}
  {f : G ⟶ Spec (CommRingCat.of k)} {fA : A ⟶ Spec (CommRingCat.of k)}

abbrev kerScheme (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) : Scheme.{u} :=
  pullback π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1

abbrev kerStr (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) :
    kerScheme LA π ⟶ Spec (CommRingCat.of k) :=
  pullback.snd π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1

theorem kerι_comp (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) :
    pullback.fst π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1 ≫ f = kerStr LA π := by
  have h1 : pullback.fst π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1 ≫ f =
      pullback.fst π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1 ≫ π.1 ≫ fA := by rw [π.2]
  rw [h1, pullback.condition_assoc, (LA.one (𝟙 (Spec (CommRingCat.of k)))).2, Category.comp_id]

def kerIncl (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) : SchemeHomOver (kerStr LA π) f :=
  ⟨pullback.fst π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1, kerι_comp LA π⟩

@[scoped simp]
theorem kerIncl_coe (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) :
    (kerIncl LA π).1 = pullback.fst π.1 (LA.one (𝟙 (Spec (CommRingCat.of k)))).1 :=
  rfl

scoped instance (LA : RelativeGroupLaw k fA) : IsClosedImmersion (LA.one (𝟙 (Spec (CommRingCat.of k)))).1 :=
  isClosedImmersion_of_comp_eq_id fA _ (LA.one (𝟙 (Spec (CommRingCat.of k)))).2

scoped instance (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA) : IsClosedImmersion (kerIncl LA π).1 := by
  rw [kerIncl_coe]; infer_instance

theorem exists_kerLaw (L : RelativeGroupLaw k f) (LA : RelativeGroupLaw k fA) (π : SchemeHomOver f fA)
    (hπ : IsHom L LA π) :
    ∃ L₀ : RelativeGroupLaw k (kerStr LA π),
      IsHom L₀ L (kerIncl LA π) ∧ (L.IsCommutative → L₀.IsCommutative) ∧
      (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (y : SchemeHomOver t (kerStr LA π)),
        NeronModelInfra.schemeHomOverComp (NeronModelInfra.schemeHomOverComp y (kerIncl LA π)) π =
          LA.one t) ∧
      (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t f),
        NeronModelInfra.schemeHomOverComp x π = LA.one t →
          ∃ y : SchemeHomOver t (kerStr LA π), NeronModelInfra.schemeHomOverComp y (kerIncl LA π) = x) := by
  obtain ⟨e, he⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_schemeHomOver_pullback_unit_equiv_ker LA π

  have he' : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (y : SchemeHomOver t (kerStr LA π)),
      ((e t y : {x : SchemeHomOver t f // _}) : SchemeHomOver t f) =
        NeronModelInfra.schemeHomOverComp y (kerIncl LA π) :=
    fun t y => Subtype.ext (he t y)

  have hnat : ∀ {T T' : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
      (t' : T' ⟶ Spec (CommRingCat.of k)) (ψ : T' ⟶ T) (hψ : ψ ≫ t = t')
      (y : SchemeHomOver t (kerStr LA π)),
      ((e t' (GoodReductionJacobian.schemeHomOverComp ψ hψ y) : {x : SchemeHomOver t' f // _}) :
          SchemeHomOver t' f) =
        GoodReductionJacobian.schemeHomOverComp ψ hψ ((e t y : {x : SchemeHomOver t f // _}) :
          SchemeHomOver t f) := by
    intro T T' t t' ψ hψ y
    rw [he', he']
    apply Subtype.ext
    simp only [NeronModelInfra.schemeHomOverComp_coe, GoodReductionJacobian.schemeHomOverComp_coe,
      Category.assoc]

  let L₀ : RelativeGroupLaw k (kerStr LA π) :=
    { mul := fun t y y' => (e t).symm ⟨L.mul t (e t y).1 (e t y').1, by
          rw [hπ, (e t y).2, (e t y').2, LA.one_mul]⟩
      one := fun t => (e t).symm ⟨L.one t, hπ.one t⟩
      inv := fun t y => (e t).symm ⟨L.inv t (e t y).1, by
          letI := LA.pointGroup t
          rw [hπ.inv, (e t y).2]
          exact inv_one⟩
      mul_assoc := fun t x y z => by
        apply (e t).injective
        apply Subtype.ext
        simp only [Equiv.apply_symm_apply]
        exact L.mul_assoc t _ _ _
      one_mul := fun t x => by
        apply (e t).injective
        apply Subtype.ext
        simp only [Equiv.apply_symm_apply]
        exact L.one_mul t _
      mul_one := fun t x => by
        apply (e t).injective
        apply Subtype.ext
        simp only [Equiv.apply_symm_apply]
        exact L.mul_one t _
      inv_mul_cancel := fun t x => by
        apply (e t).injective
        apply Subtype.ext
        simp only [Equiv.apply_symm_apply]
        exact L.inv_mul_cancel t _
      mul_natural := fun t t' ψ hψ x y => by
        apply (e t').injective
        apply Subtype.ext
        rw [hnat]
        simp only [Equiv.apply_symm_apply]
        rw [L.mul_natural t t' ψ hψ, ← hnat t t' ψ hψ x, ← hnat t t' ψ hψ y] }
  refine ⟨L₀, ?_, ?_, ?_, ?_⟩
  · intro T t y y'
    rw [← he', ← he', ← he']
    show ((e t ((e t).symm _) : {x : SchemeHomOver t f // _}) : SchemeHomOver t f) = _
    rw [Equiv.apply_symm_apply]
  · intro hc T t y y'
    apply (e t).injective
    apply Subtype.ext
    show ((e t ((e t).symm _) : {x : SchemeHomOver t f // _}) : SchemeHomOver t f) =
      ((e t ((e t).symm _) : {x : SchemeHomOver t f // _}) : SchemeHomOver t f)
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact hc t _ _
  · intro T t y
    rw [← he']
    exact (e t y).2
  · intro T t x hx
    exact ⟨(e t).symm ⟨x, hx⟩, by rw [← he', Equiv.apply_symm_apply]⟩

end Kernel

section Translate

variable {k : Type u} [Field k] {G : Scheme.{u}} {f : G ⟶ Spec (CommRingCat.of k)}

abbrev idPt (f : G ⟶ Spec (CommRingCat.of k)) : SchemeHomOver f f := ⟨𝟙 G, Category.id_comp f⟩

def constPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) : SchemeHomOver t f :=
  ⟨t ≫ s.1, by rw [Category.assoc, s.2, Category.comp_id]⟩

@[scoped simp]
theorem constPt_coe {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) : (constPt t s).1 = t ≫ s.1 :=
  rfl

theorem comp_constPt {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t f)
    (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    NeronModelInfra.schemeHomOverComp x (constPt f s) = constPt t s := by
  apply Subtype.ext
  simp only [NeronModelInfra.schemeHomOverComp_coe, constPt_coe, ← Category.assoc, x.2]

theorem constPt_id (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    constPt (𝟙 (Spec (CommRingCat.of k))) s = s :=
  Subtype.ext (Category.id_comp _)

theorem comp_idPt {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp x (idPt f) = x :=
  Subtype.ext (Category.comp_id _)

def translate (L : RelativeGroupLaw k f) (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    SchemeHomOver f f :=
  L.mul f (idPt f) (constPt f s)

theorem comp_translate (L : RelativeGroupLaw k f) (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp x (translate L s) = L.mul t x (constPt t s) := by
  rw [translate, comp_lawMul, comp_idPt, comp_constPt]

theorem translate_comp_translate_inv (L : RelativeGroupLaw k f)
    (s : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    (translate L s).1 ≫ (translate L (L.inv _ s)).1 = 𝟙 G := by
  have key : constPt f (L.inv _ s) = L.inv f (constPt f s) := by
    have e1 : constPt f s = GoodReductionJacobian.schemeHomOverComp f (Category.comp_id f) s := rfl
    have e2 : constPt f (L.inv _ s) =
        GoodReductionJacobian.schemeHomOverComp f (Category.comp_id f) (L.inv _ s) := rfl
    letI := L.pointGroup f
    have h : L.mul f (constPt f (L.inv _ s)) (constPt f s) = L.one f := by
      rw [e1, e2, ← L.mul_natural, L.inv_mul_cancel, L.one_natural]
    exact (inv_eq_of_mul_eq_one_left h).symm
  have h : NeronModelInfra.schemeHomOverComp (translate L s) (translate L (L.inv _ s)) = idPt f := by
    rw [comp_translate, translate, L.mul_assoc, key, L.mul_inv_cancel, L.mul_one]
  exact congrArg Subtype.val h

abbrev pt (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) : G :=
  x.1.base (IsLocalRing.closedPoint k)

theorem pt_comp {H : Scheme.{u}} {fH : H ⟶ Spec (CommRingCat.of k)}
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) (φ : SchemeHomOver f fH) :
    pt (NeronModelInfra.schemeHomOverComp x φ) = φ.1.base (pt x) := by
  simp only [pt, NeronModelInfra.schemeHomOverComp_coe, Scheme.Hom.comp_apply]

theorem isClosed_pt [IsAlgClosed k] [LocallyOfFiniteType f]
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) : IsClosed ({pt x} : Set G) :=
  ((pointEquivClosedPoint f) x).2

theorem eq_of_pt_eq [IsAlgClosed k] [LocallyOfFiniteType f]
    {x y : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f} (h : pt x = pt y) : x = y :=
  (pointEquivClosedPoint f).injective (Subtype.ext h)

theorem exists_pt_eq [IsAlgClosed k] [LocallyOfFiniteType f] {z : G} (hz : IsClosed ({z} : Set G)) :
    ∃ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f, pt x = z :=
  ⟨(pointEquivClosedPoint f).symm ⟨z, hz⟩, by
    have := (pointEquivClosedPoint f).apply_symm_apply ⟨z, hz⟩
    exact congrArg Subtype.val this⟩

end Translate

section Main

variable (k : Type u) [Field k] [IsAlgClosed k]

theorem exists_complement {G : Scheme.{u}}
    (f : G ⟶ Spec (CommRingCat.of k)) [IsSeparated f] [QuasiCompact f] [ConnectedSpace G]
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (g : ℕ) [SmoothOfRelativeDimension g f]
    {A : Scheme.{u}} (j : A ⟶ G) [IsClosedImmersion j] [ConnectedSpace A] [IsProper (j ≫ f)]
    (LA : RelativeGroupLaw k (j ≫ f)) (a : ℕ) [SmoothOfRelativeDimension a (j ≫ f)]
    (hj : IsHom LA L ⟨j, rfl⟩) (n : ℕ) (hn : 0 < n) (π : SchemeHomOver f (j ≫ f)) (hπ : IsHom L LA π)
    (hπj : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t (j ≫ f)),
      NeronModelInfra.schemeHomOverComp
        (NeronModelInfra.schemeHomOverComp x (⟨j, rfl⟩ : SchemeHomOver (j ≫ f) f)) π = LA.nsmul t n x) :
    ∃ (N : Scheme.{u}) (i : N ⟶ G) (LN : RelativeGroupLaw k (i ≫ f)),
      IsClosedImmersion i ∧ ConnectedSpace N ∧ SmoothOfRelativeDimension (g - a) (i ≫ f) ∧
      a ≤ g ∧ IsHom LN L ⟨i, rfl⟩ ∧
      Surjective
        (L.mul (pullback.fst (j ≫ f) (i ≫ f) ≫ j ≫ f)
          ⟨pullback.fst (j ≫ f) (i ≫ f) ≫ j, Category.assoc _ _ _⟩
          ⟨pullback.snd (j ≫ f) (i ≫ f) ≫ i,
            (Category.assoc _ _ _).trans pullback.condition.symm⟩).1 := by
  classical
  haveI : Smooth f := SmoothOfRelativeDimension.smooth g f
  haveI : Smooth (j ≫ f) := SmoothOfRelativeDimension.smooth a (j ≫ f)
  have hAc : LA.IsCommutative := isCommutative_of_isHom_mono hc ⟨j, rfl⟩ hj
  set jG : SchemeHomOver (j ≫ f) f := ⟨j, rfl⟩ with hjG

  obtain ⟨L₀, h0hom, h0comm, h0ker, h0lift⟩ := exists_kerLaw L LA π hπ
  set ι₀ : SchemeHomOver (kerStr LA π) f := kerIncl LA π with hι₀
  have hf₀ : ι₀.1 ≫ f = kerStr LA π := ι₀.2
  haveI : LocallyOfFiniteType (kerStr LA π) := by rw [← hf₀]; infer_instance
  haveI : QuasiCompact (kerStr LA π) := by rw [← hf₀]; infer_instance
  obtain ⟨N, i₁, L₁, h, hci₁, hirr, hsm₁, -, -, -, -, hhom₁, -, S, hSfin, hcov⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_isClosedImmersion_smoothOfRelativeDimension_range_eq_connectedComponent_of_perfectField
      k L₀
  haveI := hci₁
  haveI := hirr

  set i : N ⟶ G := i₁ ≫ ι₀.1 with hi
  have ei : i₁ ≫ kerStr LA π = i ≫ f := by rw [hi, Category.assoc, hf₀]
  set LN : RelativeGroupLaw k (i ≫ f) := castLaw ei L₁ with hLN
  have h1hom : IsHom L₁ L₀ ⟨i₁, rfl⟩ := hhom₁
  have hLNhom : IsHom LN L ⟨i, rfl⟩ :=
    castLaw_isHom ei L₁ L (NeronModelInfra.schemeHomOverComp ⟨i₁, rfl⟩ ι₀) (h1hom.comp h0hom)
  haveI : IsClosedImmersion i := by rw [hi]; infer_instance
  haveI hsmN : SmoothOfRelativeDimension h (i ≫ f) := by rw [← ei]; exact hsm₁

  have hNker : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (y : SchemeHomOver t (i ≫ f)),
      NeronModelInfra.schemeHomOverComp (NeronModelInfra.schemeHomOverComp y ⟨i, rfl⟩) π =
        LA.one t := by
    intro T t y
    have : NeronModelInfra.schemeHomOverComp y (⟨i, rfl⟩ : SchemeHomOver (i ≫ f) f) =
        NeronModelInfra.schemeHomOverComp
          (NeronModelInfra.schemeHomOverComp (⟨y.1, by rw [ei]; exact y.2⟩ : SchemeHomOver t (i₁ ≫ kerStr LA π))
            (⟨i₁, rfl⟩ : SchemeHomOver (i₁ ≫ kerStr LA π) (kerStr LA π))) ι₀ := by
      apply Subtype.ext
      simp only [NeronModelInfra.schemeHomOverComp_coe, Category.assoc, hi]
    rw [this, h0ker]

  have hnormal : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t f)
      (m : SchemeHomOver t (i ≫ f)), ∃ m' : SchemeHomOver t (i ≫ f),
