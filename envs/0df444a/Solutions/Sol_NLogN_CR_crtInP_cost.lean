    (by rw [List.length_map, NLogN.CR.padL_length _ _ (by rw [NLogN.CR.chunksL_length]; exact hLS)]) (by simp) hkb
    L1 L2 (by simp +decide [hs1, NLogN.CR.flatten_single]) (by simp +decide [hs1, h1])
    (by simp +decide [hs1, h2]) (by simp +decide [hs1, h3])
    (by
      intro r hr y hy
      simp only [List.mem_map] at hr
      obtain ⟨z, hz, rfl⟩ := hr
      simp only [List.mem_singleton] at hy
      subst hy
      simp only [NLogN.CR.padL, List.mem_append, List.mem_replicate] at hz
      rcases hz with hz | ⟨_, rfl⟩
      · have := NLogN.CR.chunksL_bnd b L x _ hz
        exact NLogN.CR.zsz_le_of_abs (by
          rw [abs_of_nonneg this.1]
          exact lt_of_lt_of_le this.2 (pow_le_pow_right₀ (by norm_num) hbB))
      · simp [NLogN.zsz_zero])
  have tot := NLogN.CR.rm_seq_cost r1.2 c1 (M := M) (b := NLogN.RM.rs (NLogN.permP 1)) c2
  refine le_trans tot ?_
  clear * -
  have e1 : 60000 * (S + 1) * (B + 2) ≤ 10 ^ 6 * (kb + 1) * (S + 1) * (B + kb + 5) := by
    have : 60000 * (B + 2) ≤ 10 ^ 6 * (kb + 1) * (B + kb + 5) := by nlinarith
    nlinarith
  have e2 : 10 ^ 6 * (kb + 1) * (S + 1) * (1 + 1) * (B + kb + 1 + 4) =
      2 * (10 ^ 6 * (kb + 1) * (S + 1) * (B + kb + 5)) := by ring
  linarith
end
