  haveI : NoZeroSMulDivisors O'' (O'' ⊗[ℤ_[lam]] ↥(ModularCurve.TateModule lam (JZero (N * q)))) := noZeroSMulDivisors_tate lam O'' hsmul
  refine hne_of_vtoric_facts lam O'' K 𝒟 hsmul ρM hρ TM hT W Vt hW0 hW
