variable {n : ℕ}

theorem ReciprocityTheory.ChartRestriction.DS.lf_cm_basis_of_mem {x : Fin n × Fin n} {S : Finset (Fin (n * n))} (hx : finProdFinEquiv x ∈ S) :
    ∃ σ : ℂ, (σ = 1 ∨ σ = -1) ∧
      cmFock x.1 x.2 (fockBasis n S) = σ • fockBasis n (S.erase (finProdFinEquiv x)) ∧
      cpFock x.1 x.2 (fockBasis n (S.erase (finProdFinEquiv x))) = σ • fockBasis n S := by sorry
