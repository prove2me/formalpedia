import Definitions.Def_Chou_Growth
import Mathlib
import Definitions.Def_MilnorWolf_Growth
import Theorems.Thm_Wolf_fg_lcsFactor_and_growth_bounds_of_isNilpotent

/-!
# Chou §3, p. 399: the growth rate of a finitely generated group

Milnor's observation that `|B(n)|^{1/n}` converges, and Wolf's observation that exponential
growth does not depend on the choice of finite generating set.  Both come from Fekete's lemma
applied to the subadditive sequence `n ↦ log |B(n)|`: Mathlib's `Subadditive.lim` is *defined*
as the infimum of `u n / n` over `n ≥ 1`, so the limit `v` satisfies `v ^ n ≤ |B(n)|` for
**every** `n`, not merely eventually — which is what the `∀ n` in `HasExponentialGrowth` needs.
-/

namespace Chou
namespace Lib

open Chou

variable {G : Type*} [Group G]

/-! ### Elementary properties of word balls -/

lemma one_mem_wordBall (S : Set G) (n : ℕ) : (1 : G) ∈ wordBall S n :=
  ⟨[], by simp, by simp, by simp⟩

lemma wordBall_mono (S : Set G) {m n : ℕ} (h : m ≤ n) : wordBall S m ⊆ wordBall S n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen.trans h, hmem, rfl⟩

lemma mul_mem_wordBall {S : Set G} {a b : G} {m n : ℕ} (ha : a ∈ wordBall S m)
    (hb : b ∈ wordBall S n) : a * b ∈ wordBall S (m + n) := by
  obtain ⟨l₁, h₁, hm₁, rfl⟩ := ha
  obtain ⟨l₂, h₂, hm₂, rfl⟩ := hb
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · simpa using Nat.add_le_add h₁ h₂
  · intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hm₁ x h
    · exact hm₂ x h
  · simp

lemma inv_mem_wordBall {S : Set G} {a : G} {n : ℕ} (ha : a ∈ wordBall S n) :
    a⁻¹ ∈ wordBall S n := by
  obtain ⟨l, hlen, hmem, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, ?_, (List.prod_inv_reverse l).symm⟩
  · simpa using hlen
  · intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hmem y hy with h | h
    · exact Or.inr (by simpa using h)
    · exact Or.inl h

/-- Every element of the subgroup generated by `T` lies in some `T`-ball. -/
lemma exists_mem_wordBall_of_mem_closure {T : Set G} {g : G} (hg : g ∈ Subgroup.closure T) :
    ∃ m : ℕ, g ∈ wordBall T m := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, [x], by simp, by simpa using Or.inl hx, by simp⟩
  | one => exact ⟨0, one_mem_wordBall T 0⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨m, hm⟩ := ihx
      obtain ⟨n, hn⟩ := ihy
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv x _ ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m, inv_mem_wordBall hm⟩

/-- Comparison of balls for two generating sets: if every element of `T` is an `S`-word of
length at most `k`, then the `T`-ball of radius `n` sits inside the `S`-ball of radius `k * n`. -/
lemma wordBall_subset_wordBall_of_forall_mem {S T : Set G} {k : ℕ}
    (h : ∀ t ∈ T, t ∈ wordBall S k) (n : ℕ) : wordBall T n ⊆ wordBall S (k * n) := by
  have hstep : ∀ x : G, (x ∈ T ∨ x⁻¹ ∈ T) → x ∈ wordBall S k := by
    rintro x (hx | hx)
    · exact h x hx
    · simpa using inv_mem_wordBall (h _ hx)
  have main : ∀ l : List G, (∀ x ∈ l, x ∈ wordBall S k) →
      l.prod ∈ wordBall S (k * l.length) := by
    intro l
    induction l with
    | nil => intro _; simpa using one_mem_wordBall S 0
    | cons a t ih =>
        intro hl
        have harith : k * (a :: t).length = k + k * t.length := by
          simp only [List.length_cons]; ring
        rw [List.prod_cons, harith]
        exact mul_mem_wordBall (hl a (by simp)) (ih fun x hx => hl x (List.mem_cons_of_mem _ hx))
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact wordBall_mono S (Nat.mul_le_mul le_rfl hlen) (main l fun x hx => hstep x (hmem x hx))

/-! ### Finiteness and cardinality of balls -/

/-- For a finite generating set the balls are finite. -/
lemma finite_wordBall (S : Finset G) (n : ℕ) : (wordBall (S : Set G) n).Finite := by
  classical
  set T : Finset G := S ∪ S.image (fun x => x⁻¹) with hT
  have key : wordBall (S : Set G) n ⊆
      (fun l : List T => (l.map Subtype.val).prod) '' {l : List T | l.length ≤ n} := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    have hmemT : ∀ x ∈ l, x ∈ T := by
      intro x hx
      rcases hmem x hx with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, h, by simp⟩)
    refine ⟨l.attach.map (fun x => (⟨x.1, hmemT x.1 x.2⟩ : T)), ?_, ?_⟩
    · simpa using hlen
    · simp
  exact Set.Finite.subset (Set.Finite.image _ (List.finite_length_le _ n)) key

lemma one_le_card_wordBall (S : Finset G) (n : ℕ) : 1 ≤ Nat.card (wordBall (S : Set G) n) := by
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_pos (finite_wordBall S n)).2 ⟨1, one_mem_wordBall _ _⟩

lemma card_wordBall_pos (S : Finset G) (n : ℕ) :
    (0 : ℝ) < (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  exact_mod_cast one_le_card_wordBall S n

/-- Submultiplicativity of the ball sizes: a word of length `≤ m + n` splits as a word of
length `≤ m` times a word of length `≤ n`. -/
lemma card_wordBall_add_le (S : Finset G) (m n : ℕ) :
    Nat.card (wordBall (S : Set G) (m + n)) ≤
      Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
  have hfin : (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n).Finite :=
    (finite_wordBall S m).prod (finite_wordBall S n)
  have hsub : wordBall (S : Set G) (m + n) ⊆
      (fun p : G × G => p.1 * p.2) ''
        (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    refine ⟨((l.take m).prod, (l.drop m).prod), ⟨⟨l.take m, ?_, ?_, rfl⟩,
      ⟨l.drop m, ?_, ?_, rfl⟩⟩, ?_⟩
    · simp
    · exact fun x hx => hmem x (List.mem_of_mem_take hx)
    · have hd : (l.drop m).length = l.length - m := List.length_drop ..
      omega
    · exact fun x hx => hmem x (List.mem_of_mem_drop hx)
    · simp [← List.prod_append, List.take_append_drop]
  calc Nat.card (wordBall (S : Set G) (m + n))
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_prod

lemma card_wordBall_le_of_subset {S T : Finset G} {m n : ℕ}
    (h : wordBall (S : Set G) m ⊆ wordBall (T : Set G) n) :
    Nat.card (wordBall (S : Set G) m) ≤ Nat.card (wordBall (T : Set G) n) := by
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard h (finite_wordBall T n)

/-! ### Fekete's lemma applied to `log |B(n)|` -/

/-- The logarithm of the size of the ball of radius `n`. -/
noncomputable def logBall (S : Finset G) (n : ℕ) : ℝ :=
  Real.log (Nat.card (wordBall (S : Set G) n))

lemma logBall_nonneg (S : Finset G) (n : ℕ) : 0 ≤ logBall S n :=
  Real.log_nonneg (by exact_mod_cast one_le_card_wordBall S n)

lemma exp_logBall (S : Finset G) (n : ℕ) :
    Real.exp (logBall S n) = (Nat.card (wordBall (S : Set G) n) : ℝ) :=
  Real.exp_log (card_wordBall_pos S n)

lemma subadditive_logBall (S : Finset G) : Subadditive (logBall S) := by
  intro m n
  have h1 := card_wordBall_pos S m
  have h2 := card_wordBall_pos S n
  have hle : (Nat.card (wordBall (S : Set G) (m + n)) : ℝ) ≤
      (Nat.card (wordBall (S : Set G) m) : ℝ) * (Nat.card (wordBall (S : Set G) n) : ℝ) := by
    exact_mod_cast card_wordBall_add_le S m n
  calc logBall S (m + n)
      ≤ Real.log ((Nat.card (wordBall (S : Set G) m) : ℝ) *
          (Nat.card (wordBall (S : Set G) n) : ℝ)) :=
        Real.log_le_log (card_wordBall_pos S (m + n)) hle
    _ = logBall S m + logBall S n := Real.log_mul h1.ne' h2.ne'

lemma bddBelow_logBall_div (S : Finset G) :
    BddBelow (Set.range fun n : ℕ => logBall S n / n) := by
  refine ⟨0, ?_⟩
  rintro x ⟨n, rfl⟩
  exact div_nonneg (logBall_nonneg S n) (Nat.cast_nonneg n)

/-- The growth rate of `G` with respect to the finite generating set `S`:
`exp` of Fekete's limit of `log |B(n)| / n`. -/
noncomputable def growthRate (S : Finset G) : ℝ := Real.exp (subadditive_logBall S).lim

lemma growthRate_eq (S : Finset G) : growthRate S = Real.exp (subadditive_logBall S).lim := rfl

lemma growthRate_pos (S : Finset G) : 0 < growthRate S := Real.exp_pos _

lemma tendsto_logBall_div (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => logBall S n / n) Filter.atTop
      (nhds (subadditive_logBall S).lim) :=
  (subadditive_logBall S).tendsto_lim (bddBelow_logBall_div S)

lemma card_wordBall_rpow_eq_exp (S : Finset G) (n : ℕ) :
    (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) = Real.exp (logBall S n / n) := by
  rw [Real.rpow_def_of_pos (card_wordBall_pos S n), mul_one_div]
  rfl

/-- Milnor, p. 399: `|B(n)|^{1/n}` converges to `growthRate S`. -/
theorem tendsto_card_wordBall_rpow_inv (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds (growthRate S)) := by
  refine Filter.Tendsto.congr (fun n => (card_wordBall_rpow_eq_exp S n).symm) ?_
  exact (Real.continuous_exp.tendsto _).comp (tendsto_logBall_div S)

/-- **The infimum characterisation.**  `Subadditive.lim` is an infimum, so the growth rate is a
*lower* bound for every `|B(n)|^{1/n}` with `n ≥ 1`, not merely a limit. -/
theorem growthRate_le_card_wordBall_rpow_inv (S : Finset G) {n : ℕ} (hn : n ≠ 0) :
    growthRate S ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) := by
  rw [card_wordBall_rpow_eq_exp]
  exact Real.exp_le_exp.2 ((subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn)

/-- The form in which the infimum characterisation is used: `v ^ n ≤ |B(n)|` for **every** `n`. -/
theorem growthRate_pow_le_card_wordBall (S : Finset G) (n : ℕ) :
    growthRate S ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simpa using (by exact_mod_cast one_le_card_wordBall S 0 :
      (1 : ℝ) ≤ (Nat.card (wordBall (S : Set G) 0) : ℝ))
  · have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hle := (subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn.ne'
    rw [le_div_iff₀ hn'] at hle
    have h1 : growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) :=
      (Real.exp_nat_mul _ n).symm
    calc growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) := h1
      _ ≤ Real.exp (logBall S n) := Real.exp_le_exp.2 (by linarith)
      _ = (Nat.card (wordBall (S : Set G) n) : ℝ) := exp_logBall S n

/-! ### The two theorems -/

/-- p. 399, Milnor's theorem as Chou states it: for a finite generating set `S`, the growth rate
`lim |B(n)|^{1/n}` exists. -/
theorem exists_tendsto_card_wordBall_rpow_inv' {G : Type*} [Group G] (S : Finset G)
    (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ v : ℝ, Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds v) :=
  ⟨growthRate S, tendsto_card_wordBall_rpow_inv S⟩

/-- Every `S`-ball sits inside a `T`-ball of a uniformly rescaled radius, when `T` generates. -/
lemma exists_wordBall_subset (S T : Finset G) (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (S : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  classical
  have H : ∀ s ∈ S, ∃ m : ℕ, s ∈ wordBall (T : Set G) m := fun s _ =>
    exists_mem_wordBall_of_mem_closure (by rw [hT]; trivial)
  choose f hf using H
  refine ⟨(S.attach.sup fun s => f s.1 s.2) + 1, Nat.succ_pos _, fun n => ?_⟩
  refine wordBall_subset_wordBall_of_forall_mem (fun s hs => ?_) n
  have hs' : s ∈ S := hs
  refine wordBall_mono _ ?_ (hf s hs')
  have hsup : f s hs' ≤ S.attach.sup fun s : {x // x ∈ S} => f s.1 s.2 :=
    Finset.le_sup (f := fun s : {x // x ∈ S} => f s.1 s.2) (Finset.mem_attach S ⟨s, hs'⟩)
  omega

/-- p. 399 (Wolf): exponential growth does not depend on the choice of the finite generating
set. -/
theorem hasExponentialGrowth_iff_forall' {G : Type*} [Group G] [Group.FG G] :
    HasExponentialGrowth G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ →
        ∃ c : ℝ, 1 < c ∧ ∀ n : ℕ, c ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  constructor
  · rintro ⟨S, -, c, hc, hcn⟩ T hT
    obtain ⟨k, hk, hkn⟩ := exists_wordBall_subset S T hT
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    -- the `T`-balls of radius `k * n` are at least as big as the `S`-balls of radius `n`
    have hball : ∀ n : ℕ, (c : ℝ) ^ n ≤ (Nat.card (wordBall (T : Set G) (k * n)) : ℝ) := by
      intro n
      refine (hcn n).trans ?_
      exact_mod_cast card_wordBall_le_of_subset (hkn n)
    -- hence `log c / k` is a lower bound along the subsequence `k * n`
    have hdiv : ∀ n : ℕ, 1 ≤ n → Real.log c / k ≤ logBall T (k * n) / ((k * n : ℕ) : ℝ) := by
      intro n hn
      have hnR : (0 : ℝ) < n := by exact_mod_cast hn
      have h1 : (n : ℝ) * Real.log c ≤ logBall T (k * n) := by
        have hlog := Real.log_le_log (by positivity : (0 : ℝ) < c ^ n) (hball n)
        rwa [Real.log_pow] at hlog
      rw [div_le_div_iff₀ hkR (by push_cast; positivity)]
      have h2 : (k : ℝ) * ((n : ℝ) * Real.log c) ≤ (k : ℝ) * logBall T (k * n) :=
        mul_le_mul_of_nonneg_left h1 hkR.le
      push_cast
      linarith
    -- Fekete's limit is at least `log c / k`
    have hmul : Filter.Tendsto (fun n : ℕ => k * n) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_mul_of_pos_left n hk) Filter.tendsto_id
    have hsubseq : Filter.Tendsto (fun n : ℕ => logBall T (k * n) / ((k * n : ℕ) : ℝ))
        Filter.atTop (nhds (subadditive_logBall T).lim) := (tendsto_logBall_div T).comp hmul
    have hge : Real.log c / k ≤ (subadditive_logBall T).lim :=
      ge_of_tendsto hsubseq (Filter.eventually_atTop.2 ⟨1, fun n hn => hdiv n hn⟩)
    refine ⟨growthRate T, ?_, growthRate_pow_le_card_wordBall T⟩
    have hpos : (0 : ℝ) < Real.log c / k := div_pos (Real.log_pos hc) hkR
    calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
      _ < Real.exp (subadditive_logBall T).lim := Real.exp_lt_exp.2 (lt_of_lt_of_le hpos hge)
      _ = growthRate T := (growthRate_eq T).symm
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    obtain ⟨c, hc, hcn⟩ := h S hS
    exact ⟨S, hS, c, hc, hcn⟩

end Lib
end Chou

/-!
# Word balls: images under a homomorphism, and comparison against a non-generating set

Two additions to the ball API of the Chou development.  A ball on the image of a set is the
image of the ball, which is what identifies the balls of a subgroup with the balls of its image
in the ambient group; and balls can be compared against a set that generates only a subgroup,
which is the form needed when the comparison happens inside a finite-index subgroup rather than
in the whole group.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-- A ball on the image of a set is the image of the ball: a word on `f '' V` is `f` of the
corresponding word on `V`. -/
theorem wordBall_image {K : Type*} [Group K] (f : G →* K) (V : Set G) (n : ℕ) :
    wordBall (f '' V) n = f '' wordBall V n := by
  have lift : ∀ l : List K, (∀ x ∈ l, x ∈ f '' V ∨ x⁻¹ ∈ f '' V) →
      ∃ p : G, p ∈ wordBall V l.length ∧ f p = l.prod := by
    intro l
    induction l with
    | nil => exact fun _ => ⟨1, one_mem_wordBall V 0, by simp⟩
    | cons a t ih =>
        intro hmem
        obtain ⟨p, hp, hfp⟩ := ih (fun x hx => hmem x (List.mem_cons_of_mem _ hx))
        obtain ⟨b, hb, hfb⟩ : ∃ b : G, (b ∈ V ∨ b⁻¹ ∈ V) ∧ f b = a := by
          rcases hmem a (by simp) with ⟨v, hv, hva⟩ | ⟨v, hv, hva⟩
          · exact ⟨v, Or.inl hv, hva⟩
          · exact ⟨v⁻¹, Or.inr (by simpa using hv), by rw [map_inv, hva, inv_inv]⟩
        obtain ⟨lp, hlp, hmp, rfl⟩ := hp
        refine ⟨b * lp.prod, ⟨b :: lp, by simpa using hlp, ?_, by simp⟩, ?_⟩
        · intro x hx
          rcases List.mem_cons.1 hx with rfl | hx
          · exact hb
          · exact hmp x hx
        · rw [List.prod_cons, map_mul, hfb, hfp]
  apply Set.eq_of_subset_of_subset
  · rintro y ⟨l, hlen, hmem, rfl⟩
    obtain ⟨p, hp, hfp⟩ := lift l hmem
    exact ⟨p, wordBall_mono V hlen hp, hfp⟩
  · rintro y ⟨x, ⟨l, hlen, hmem, rfl⟩, rfl⟩
    refine ⟨l.map f, by simpa using hlen, ?_, by rw [← map_list_prod f l]⟩
    intro z hz
    obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    rcases hmem w hw with h | h
    · exact Or.inl ⟨w, h, rfl⟩
    · exact Or.inr ⟨w⁻¹, h, by simp⟩

theorem wordBall_mono_set {A B : Set G} (h : A ⊆ B) (n : ℕ) :
    wordBall A n ⊆ wordBall B n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen, fun x hx => (hmem x hx).imp (fun hh => h hh) (fun hh => h hh), rfl⟩

theorem mem_wordBall_one {U : Set G} {u : G} (hu : u ∈ U) : u ∈ wordBall U 1 :=
  ⟨[u], by simp, by simpa using Or.inl hu, by simp⟩

/-- Finitely many elements of a generated subgroup are words of a single bounded length. -/
theorem exists_forall_mem_wordBall (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ u ∈ U, u ∈ wordBall (T : Set G) k := by
  classical
  have H : ∀ u ∈ U, ∃ m : ℕ, u ∈ wordBall (T : Set G) m := fun u hu =>
    exists_mem_wordBall_of_mem_closure (hU u hu)
  choose f hf using H
  refine ⟨(U.attach.sup fun u => f u.1 u.2) + 1, Nat.succ_pos _, fun u hu => ?_⟩
  have hu' : u ∈ U := hu
  refine wordBall_mono _ ?_ (hf u hu')
  have hsup : f u hu' ≤ U.attach.sup fun u : {x // x ∈ U} => f u.1 u.2 :=
    Finset.le_sup (f := fun u : {x // x ∈ U} => f u.1 u.2) (Finset.mem_attach U ⟨u, hu'⟩)
  omega

/-- If every element of `U` lies in the subgroup generated by `T`, the `U`-balls sit inside the
`T`-balls at a linear cost.  Unlike `Chou.Lib.exists_wordBall_subset`, `T` is not required to
generate the ambient group. -/
theorem exists_wordBall_subset_of_mem_closure (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (U : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  obtain ⟨k, hk, hmem⟩ := exists_forall_mem_wordBall U T hU
  exact ⟨k, hk, fun n => wordBall_subset_wordBall_of_forall_mem (fun u hu => hmem u hu) n⟩

end Lib
end Wolf

/-!
# Schreier rewriting, with the word length carried along

Mathlib's `Subgroup.closure_mul_image_eq` is Schreier's lemma in the form "the Schreier set
generates `H`".  Wolf's Theorem 3.11 needs more: that a word of length `p` on a generating set of
the ambient group, whose value happens to lie in `H`, is a word of length `p` on the Schreier
set.  That bound is what turns a growth estimate for `H` into one for the whole group.

The rewriting is the usual telescoping.  Writing a word as `x₁ ⋯ x_p` and letting `ρ(g)` be the
representative of the left coset `gH`, the suffix products `t_i = x_{i+1} ⋯ x_p` satisfy
`t_{i-1} = x_i t_i`, so the elements `ρ(t_{i-1})⁻¹ x_i ρ(t_i)` all lie in `H` and their product
telescopes to `ρ(h)⁻¹ h ρ(1)`.  For `h ∈ H` the two outer representatives coincide, and the one
that survives is itself an element of `H`, so it costs two extra letters.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-! ### The coset representative -/

/-- The representative of the left coset `g H` picked out by the quotient. -/
noncomputable def rep (H : Subgroup G) (g : G) : G := Quotient.out (QuotientGroup.mk g : G ⧸ H)

theorem inv_rep_mul_mem (H : Subgroup G) (g : G) : (rep H g)⁻¹ * g ∈ H := by
  rw [← QuotientGroup.eq]
  exact Quotient.out_eq' _

theorem rep_mem_range (H : Subgroup G) (g : G) :
    rep H g ∈ Set.range (fun q : G ⧸ H => Quotient.out q) := ⟨_, rfl⟩

theorem rep_eq_rep_one (H : Subgroup G) {h : G} (hh : h ∈ H) : rep H h = rep H 1 := by
  have hq : (QuotientGroup.mk h : G ⧸ H) = QuotientGroup.mk 1 := by
    rw [QuotientGroup.eq]
    simpa using H.inv_mem hh
  rw [rep, rep, hq]

theorem rep_one_mem (H : Subgroup G) : rep H 1 ∈ H := by
  have h := inv_rep_mul_mem H 1
  rw [mul_one] at h
  simpa using H.inv_mem h

/-! ### The rewriting -/

/-- **Schreier rewriting with a length bound.**  A word of length `p` whose value lies in `H`
becomes, after conjugating by the representative of `H` itself, a word of length `p` on the
Schreier set `Uf`. -/
theorem schreier_rewrite (H : Subgroup G) (S Rf Uf : Finset G)
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (l : List G) (hl : ∀ x ∈ l, x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) :
    (rep H l.prod)⁻¹ * l.prod * rep H 1 ∈ wordBall (Uf : Set G) l.length := by
  induction l with
  | nil =>
      simpa using one_mem_wordBall (Uf : Set G) 0
  | cons a t ih =>
      have hrest := ih fun x hx => hl x (List.mem_cons_of_mem _ hx)
      set b : G := (rep H (a * t.prod))⁻¹ * a * rep H t.prod with hb
      have hbH : b ∈ H := by
        have h1 : (rep H (a * t.prod))⁻¹ * (a * t.prod) ∈ H := inv_rep_mul_mem H _
        have h2 : (t.prod)⁻¹ * rep H t.prod ∈ H := by
          simpa using H.inv_mem (inv_rep_mul_mem H t.prod)
        have := H.mul_mem h1 h2
        rw [hb]
        convert this using 1
        group
      have hbU : b ∈ Uf := hU _ _ (hR _) (hR _) a (hl a (by simp)) hbH
      have hsplit : (rep H (a :: t).prod)⁻¹ * (a :: t).prod * rep H 1 =
          b * ((rep H t.prod)⁻¹ * t.prod * rep H 1) := by
        rw [hb, List.prod_cons]
        group
      rw [hsplit]
      have : b * ((rep H t.prod)⁻¹ * t.prod * rep H 1) ∈ wordBall (Uf : Set G) (1 + t.length) :=
        mul_mem_wordBall (mem_wordBall_one (by exact_mod_cast hbU)) hrest
      simpa [Nat.add_comm] using this

variable (H : Subgroup G) (S Rf Uf Vf : Finset G)

/-- An element of `H` that is an `S`-word of length `≤ n` is a word of length `≤ n + 2` on the
Schreier set enlarged by the representative of `H` itself. -/
theorem mem_wordBall_schreierSet
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (hUV : (Uf : Set G) ⊆ (Vf : Set G)) (heV : rep H 1 ∈ Vf)
    {h : G} (hh : h ∈ H) {n : ℕ} (hn : h ∈ wordBall (S : Set G) n) :
    h ∈ wordBall (Vf : Set G) (n + 2) := by
  obtain ⟨l, hlen, hmem, rfl⟩ := hn
  have key := schreier_rewrite H S Rf Uf hR hU l hmem
  rw [rep_eq_rep_one H hh] at key
  have hmid : (rep H 1)⁻¹ * l.prod * rep H 1 ∈ wordBall (Vf : Set G) n :=
    wordBall_mono _ hlen (wordBall_mono_set hUV _ key)
  have h1 : rep H 1 ∈ wordBall (Vf : Set G) 1 := mem_wordBall_one (by exact_mod_cast heV)
  have h2 : (rep H 1)⁻¹ ∈ wordBall (Vf : Set G) 1 := inv_mem_wordBall h1
  have hprod := mul_mem_wordBall (mul_mem_wordBall h1 hmid) h2
  have heq : rep H 1 * ((rep H 1)⁻¹ * l.prod * rep H 1) * (rep H 1)⁻¹ = l.prod := by group
  rw [heq] at hprod
  exact wordBall_mono _ (by omega) hprod

/-- **The covering count.**  Every element of the `S`-ball of radius `m` is a coset
representative times an element of `H` of controlled length, so the ball is covered by `[G : H]`
translates of a Schreier ball. -/
theorem card_wordBall_le_mul
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (hUV : (Uf : Set G) ⊆ (Vf : Set G)) (heV : rep H 1 ∈ Vf)
    (L : ℕ) (hL : ∀ r ∈ Rf, r ∈ wordBall (S : Set G) L) (m : ℕ) :
    Nat.card (wordBall (S : Set G) m) ≤
      Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := by
  classical
  have hfin : ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)).Finite :=
    (Rf.finite_toSet).prod (finite_wordBall _ _)
  have hsub : wordBall (S : Set G) m ⊆
      (fun p : G × G => p.1 * p.2) ''
        ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)) := by
    intro g hg
    refine ⟨(rep H g, (rep H g)⁻¹ * g), ⟨hR g, ?_⟩, by simp⟩
    refine mem_wordBall_schreierSet H S Rf Uf Vf hR hU hUV heV (inv_rep_mul_mem H g) ?_
    exact mul_mem_wordBall (inv_mem_wordBall (hL _ (hR g))) hg
  calc Nat.card (wordBall (S : Set G) m)
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2))) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := by
        simp only [Nat.card_coe_set_eq]
        rw [Set.ncard_prod, Set.ncard_coe_finset]

end Lib
end Wolf

/-!
# Wolf's Theorem 3.11 (p. 431)

“Let `Σ` be a finitely generated group, and `Γ` a subgroup of finite index.  1. `Γ` is finitely
generated.  2. If `Γ` has polynomial growth of degree `≤ E`, then `Σ` has polynomial growth of
degree `≤ E`.  3. If `Γ` is nilpotent and has polynomial growth of degree `≤ E`, then `Σ` has
polynomial growth of degree `≤ min {E, E₂(Γ)}`.”

Part 1 is Schreier's lemma, which Mathlib has.  Part 2 is the content: the ball of radius `m` in
`Σ` is covered by the `[Σ : Γ]` translates of a ball in `Γ` of radius linear in `m`, the radius
being controlled by Schreier rewriting.  Wolf first reduces to the case of a normal subgroup, by
passing to the intersection `Ψ` of the conjugates of `Γ`; that reduction is not needed here,
since the rewriting argument never uses normality.  Part 3 combines part 2 with the upper bound
of Theorem 3.2, which Wolf quotes immediately before stating 3.11.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-- The image in `G` of a generating set of `H` generates `H`. -/
theorem closure_image_eq [DecidableEq G] (H : Subgroup G) (T : Finset ↥H)
    (hT : Subgroup.closure (T : Set ↥H) = ⊤) :
    Subgroup.closure (((T.image H.subtype : Finset G)) : Set G) = H := by
  rw [Finset.coe_image, ← MonoidHom.map_closure, hT, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype]

/-- Balls on the image of a generating set have the same size as balls upstairs. -/
theorem card_wordBall_image [DecidableEq G] (H : Subgroup G) (T : Finset ↥H) (n : ℕ) :
    Nat.card (wordBall (((T.image H.subtype : Finset G)) : Set G) n) =
      Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) n) := by
  rw [Finset.coe_image, wordBall_image H.subtype]
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_image_of_injective _ (Subgroup.subtype_injective H)

/-- **Wolf's Theorem 3.11 (2).**  Polynomial growth of degree `≤ E` passes from a subgroup of
finite index to the whole group. -/
theorem hasPolynomialGrowth_of_finiteIndex (H : Subgroup G) [Group.FG G] [H.FiniteIndex]
    (E : ℕ) (hH : MilnorWolf.HasPolynomialGrowthOfDegreeLE ↥H E) :
    MilnorWolf.HasPolynomialGrowthOfDegreeLE G E := by
  classical
  obtain ⟨T, hT, c, hc, hbd⟩ := hH
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := G)).1 inferInstance
  -- the transversal
  have hqfin : Finite (G ⧸ H) := H.finite_quotient_of_finiteIndex
  have hRfin : (Set.range (fun q : G ⧸ H => Quotient.out q)).Finite := Set.finite_range _
  set Rf : Finset G := hRfin.toFinset with hRf
  have hR : ∀ g : G, rep H g ∈ Rf := by
    intro g
    rw [hRf, Set.Finite.mem_toFinset]
    exact rep_mem_range H g
  -- the Schreier set
  set Sy : Finset G := S ∪ S.image (fun x => x⁻¹) with hSy
  set Uf : Finset G :=
    ((Rf ×ˢ Sy ×ˢ Rf).image (fun p : G × G × G => p.1⁻¹ * p.2.1 * p.2.2)).filter
      (fun u => u ∈ H) with hUf
  have hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G,
      (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) → r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf := by
    intro r r' hr hr' x hx hmem
    have hxSy : x ∈ Sy := by
      rcases hx with h | h
      · exact Finset.mem_union_left _ (by exact_mod_cast h)
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, by exact_mod_cast h, by simp⟩)
    rw [hUf, Finset.mem_filter]
    refine ⟨Finset.mem_image.2 ⟨(r, x, r'), ?_, rfl⟩, hmem⟩
    simp only [Finset.mem_product]
    exact ⟨hr, hxSy, hr'⟩
  set Vf : Finset G := insert (rep H 1) Uf with hVf
  have hUV : (Uf : Set G) ⊆ (Vf : Set G) := by
    rw [hVf, Finset.coe_insert]; exact Set.subset_insert _ _
  have heV : rep H 1 ∈ Vf := by rw [hVf]; exact Finset.mem_insert_self _ _
  -- lengths of the transversal elements
  obtain ⟨L, _, hL⟩ := exists_forall_mem_wordBall Rf S (fun r _ => by rw [hS]; trivial)
  -- the Schreier set lies in H, which is generated by the image of T
  set T' : Finset G := T.image H.subtype with hT'
  have hclos : Subgroup.closure ((T' : Finset G) : Set G) = H := closure_image_eq H T hT
  have hVH : ∀ v ∈ Vf, v ∈ Subgroup.closure ((T' : Finset G) : Set G) := by
    intro v hv
    rw [hclos]
    rw [hVf, Finset.mem_insert] at hv
    rcases hv with rfl | hv
    · exact rep_one_mem H
    · rw [hUf, Finset.mem_filter] at hv; exact hv.2
  obtain ⟨k, hk, hkball⟩ := exists_wordBall_subset_of_mem_closure Vf T' hVH
  -- assemble the estimate
  refine ⟨S, hS, (Rf.card : ℝ) * c * ((k * (L + 3) : ℕ) : ℝ) ^ E, ?_, ?_⟩
  · have hRpos : 0 < Rf.card := Finset.card_pos.2 ⟨rep H 1, hR 1⟩
    have h1 : (0 : ℝ) < (Rf.card : ℝ) := by exact_mod_cast hRpos
    have h2 : (0 : ℝ) < ((k * (L + 3) : ℕ) : ℝ) := by
      have : 0 < k * (L + 3) := Nat.mul_pos hk (by omega)
      exact_mod_cast this
    positivity
  · intro m hm
    set N : ℕ := k * (L + m + 2) with hN
    have hN1 : 1 ≤ N := by
      have : 0 < k * (L + m + 2) := Nat.mul_pos hk (by omega)
      omega
    have step1 : Nat.card (wordBall (S : Set G) m) ≤
        Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) :=
      card_wordBall_le_mul H S Rf Uf Vf hR hU hUV heV L hL m
    have step2 : Nat.card (wordBall (Vf : Set G) (L + m + 2)) ≤
        Nat.card (wordBall ((T' : Finset G) : Set G) N) := by
      simp only [Nat.card_coe_set_eq]
      exact Set.ncard_le_ncard (hkball _) (finite_wordBall T' N)
    have step3 : Nat.card (wordBall ((T' : Finset G) : Set G) N) =
        Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := card_wordBall_image H T N
    have hchain : (MilnorWolf.growthFunction S m : ℝ) ≤
        (Rf.card : ℝ) * (MilnorWolf.growthFunction T N : ℝ) := by
      have : Nat.card (wordBall (S : Set G) m) ≤
          Rf.card * Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := by
        calc Nat.card (wordBall (S : Set G) m)
            ≤ Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := step1
          _ ≤ Rf.card * Nat.card (wordBall ((T' : Finset G) : Set G) N) :=
              Nat.mul_le_mul_left _ step2
          _ = Rf.card * Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := by rw [step3]
      exact_mod_cast this
    have hTb : (MilnorWolf.growthFunction T N : ℝ) ≤ c * (N : ℝ) ^ E := hbd N hN1
    have hRnn : (0 : ℝ) ≤ (Rf.card : ℝ) := by positivity
    have hNle : N ≤ k * (L + 3) * m := by
      have : L + m + 2 ≤ (L + 3) * m := by nlinarith
      calc N = k * (L + m + 2) := hN
        _ ≤ k * ((L + 3) * m) := Nat.mul_le_mul_left _ this
        _ = k * (L + 3) * m := by ring
    have hpow : (N : ℝ) ^ E ≤ ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by
      have hcast : (N : ℝ) ≤ ((k * (L + 3) : ℕ) : ℝ) * (m : ℝ) := by
        have := hNle
        push_cast
        exact_mod_cast this
      calc (N : ℝ) ^ E ≤ (((k * (L + 3) : ℕ) : ℝ) * (m : ℝ)) ^ E :=
            pow_le_pow_left₀ (by positivity) hcast E
        _ = ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by rw [mul_pow]
    calc (MilnorWolf.growthFunction S m : ℝ)
        ≤ (Rf.card : ℝ) * (MilnorWolf.growthFunction T N : ℝ) := hchain
      _ ≤ (Rf.card : ℝ) * (c * (N : ℝ) ^ E) := mul_le_mul_of_nonneg_left hTb hRnn
      _ ≤ (Rf.card : ℝ) * (c * (((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow hc.le) hRnn
      _ = (Rf.card : ℝ) * c * ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by ring

/-- A finitely generated nilpotent group has polynomial growth of degree `≤ E₂`: the upper bound
of Wolf's Theorem 3.2, quoted just before Theorem 3.11 in the paper. -/
theorem hasPolynomialGrowth_of_isNilpotent (Δ : Type*) [Group Δ] [Group.FG Δ]
    [Group.IsNilpotent Δ] :
    MilnorWolf.HasPolynomialGrowthOfDegreeLE Δ (MilnorWolf.growthExponentTwo Δ) := by
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := Δ)).1 inferInstance
  obtain ⟨c₁, c₂, hc₁, hc₁₂, hbd⟩ :=
    (_root_.Wolf.fg_lcsFactor_and_growth_bounds_of_isNilpotent S hS).2
  exact ⟨S, hS, c₂, lt_of_lt_of_le hc₁ hc₁₂, fun m hm => (hbd m hm).2⟩

/-- **Wolf's Theorem 3.11** (p. 431). -/
theorem fg_and_polynomial_growth_of_finiteIndex' {G : Type*} [Group G] [Group.FG G]
    (H : Subgroup G) [H.FiniteIndex] :
    Group.FG H ∧
      (∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G E) ∧
      (Group.IsNilpotent H → ∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G
          (min E (MilnorWolf.growthExponentTwo H))) := by
  refine ⟨inferInstance, fun E hE => hasPolynomialGrowth_of_finiteIndex H E hE, ?_⟩
  intro hnil E hE
  have : Group.IsNilpotent ↥H := hnil
  rcases le_total E (MilnorWolf.growthExponentTwo ↥H) with h | h
  · rw [min_eq_left h]
    exact hasPolynomialGrowth_of_finiteIndex H E hE
  · rw [min_eq_right h]
    exact hasPolynomialGrowth_of_finiteIndex H _ (hasPolynomialGrowth_of_isNilpotent ↥H)

end Lib
end Wolf

open Wolf

theorem solution {G : Type*} [Group G] [Group.FG G] (H : Subgroup G)
    [H.FiniteIndex] :
    Group.FG H ∧
      (∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G E) ∧
      (Group.IsNilpotent H → ∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G (min E (MilnorWolf.growthExponentTwo H))) :=
  Wolf.Lib.fg_and_polynomial_growth_of_finiteIndex' H
