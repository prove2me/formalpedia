-- Source module: Solutions.R6BitNBProjB
/-!
# Round six, bit network: projectors of the codes

The codes of the local generator name projectors on `ℚ^23` (`Pc`): `LOW = 0`, `HIGH = 1`,
`PT T = 1 - Pl T` (the hyperplane `B`-orthogonal to triple `T`), `ND n` the `B`-orthogonal projector
onto the span of the triples of node `n` (`Pnd (supG n)`). The dimension records certify both the
dimension of every node span and a common point (centre) of its triples, so `Pnd` is a projector of
rank `dimN n`. A move allowed by `nestOK` is between nested projectors; its difference `Dm` is an
idempotent of rank `rkC` with `Dm + P_old - 2 Dm P_old = P_new`.
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Module R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-! ## Dimension records: dimension and centre -/

/-! ## Table lookups -/

/-! ## Arguments of gates -/

/-! ## Orthogonality to a triple -/

/-! ## Ranks of idempotents -/

/-- Nested idempotents: `A ≤ B`. -/
def Le {n : ℕ} (A B : Matrix (Fin n) (Fin n) ℚ) : Prop := B * A = A ∧ A * B = A

/-! ## The code projectors -/

/-- The projector named by a code. -/
noncomputable def Pc (c : ℕ) : Matrix (Fin 23) (Fin 23) ℚ :=
  if c = 0 then 0 else if c = 1 then 1 else if c < 1773 then 1 - Pl (c - 2) else Pnd (supG (c - 1773))

/-! ## Moves -/

/-- The move idempotent between codes `o` and `c`. -/
noncomputable def Dm (o c : ℕ) : Matrix (Fin 23) (Fin 23) ℚ :=
  if dimCF o ≤ dimCF c then Pc c - Pc o else Pc o - Pc c

end IntMul.Kappa.R6.Bit.NB

end

