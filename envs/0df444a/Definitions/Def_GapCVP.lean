def unarySourcePairOutput (input : List Bool) : List Bool :=
  match readUnaryPrefix input with
  | none => []
  | some (first, remaining) =>
      match readUnaryPrefix remaining with
      | some (second, []) =>
          List.replicate (Nat.pair first second) true
      | _ => []
