section
-- Source module: Solutions.KFLSwap
/-!
# KFL §4: the Lemma 12 swap wrapper

`swI q vP vG vS u` pushes the four Lemma 12 parameters (`kP, kG, kS, aU`), runs the fine
Lemma 12 program `l12F`, and pops them.  `swI_spec`: on any state whose stack 0 is
`enc2 xs ++ R` (arbitrary tail `R`, no other hypothesis) it interchanges the two `[2^u]`
fields of `binShape Pre G Suf (2^u)` at cost `≤ K (V + 1) u^τ`, `τ = 1 - 2^-50`.

Then `swI_rixT`: on the 8-axis geometry `sh8 = [N0,Q,N1,Q,N2,Q,N3,B]`, `Q = 2^u`, the three
swaps (axes 1↔3, 3↔5, 1↔5) are `rixT g sw01 / sw12 / sw02`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD KFE KFB AModel AModelL12 NetProp7

/-! ## Bit lists and the three geometry swaps -/

theorem bits_enc2 (zs : List ℤ) (h : Bits zs) : enc2 (zs.map fun z : ℤ => (Int.cast z : ZMod 2)) = zs := by
  simp only [enc2, List.map_map]
  conv_rhs => rw [← List.map_id zs]
  refine List.map_congr_left (fun z hz => ?_)
  rcases h z hz with rfl | rfl <;> rfl
end NLogN.KFL

end

section
-- Source module: Solutions.KFX1Sw
/-!
# KFX §1: the Lemma 12 swap wrapper with expression parameters

`swE q eP eG eS eU` pushes the four Lemma 12 parameters as the values of arbitrary expressions
(read from registers at run time), runs `l12F`, pops.  **`swE_spec`** is `KFL.swI_spec` with the
literals replaced by expressions (`KFL.ESp` facts), and **`swE_geo`** gives the three slot swaps
`rixT g (swT i)` on the 8-axis geometry.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL AModel AModelL12 NetProp7

/-! ## The three slot swaps on the 8-axis geometry -/

/-- **Slot swap `i` on the geometry** with expression parameters. -/
theorem swE_geo_sol_aux :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (i : Fin 3) (g : Geo), g.Pos → ∀ u : ℕ, 1 ≤ u → g.Q = 2 ^ u →
      ∀ (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item),
      KFL.Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
      ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (g.V : ℤ) + 3 →
      eP.size + eG.size + eS.size + eU.size ≤ 50 →
      NoK eP → NoK eG → NoK eS → NoK eU →
      ESp eP t Bb (svP g i : ℤ) → ESp eG t Bb (svG g i : ℤ) → ESp eS t Bb (svS g i : ℤ) →
      ESp eU t Bb (u : ℤ) →
      ∃ c : ℕ, IRuns I l12prog (swE q eP eG eS eU) t
          (t.upd 0 (ints (rixT g (swT i) zs) ++ R)) c ∧
          (c : ℝ) ≤ K * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  obtain ⟨T, q₀, H⟩ := swE_spec
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  refine ⟨K, hK, fun i g hg u hu hQ I t zs R hb h0 hlen eP eG eS eU Bb hBb hsz nP nG nS nU
    r1 r2 r3 r4 => ?_⟩
  set xs : List (ZMod 2) := zs.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hx : enc2 xs = zs := bits_enc2 zs hb
  have hq := hg.q; have h0' := hg.n0; have h1 := hg.n1; have h2 := hg.n2; have h3 := hg.n3
  have hB := hg.b
  have hxl : xs.length = g.V := by simp [xs, hlen]
  have hsh : ∀ Pre G Suf : Shape, binShape Pre G Suf (2 ^ u) = g.sh8 →
      vol (binShape Pre G Suf (2 ^ u)) = g.V := fun Pre G Suf e => by rw [e, Geo.vol_sh8]
  fin_cases i
  · have e : binShape [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [vol, svP] using r1) (by simpa [vol, svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw01 zs) ++ R)) c
    rw [← pull_swap13 g hg]; simpa [vol] using Hc
  · have e : binShape [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [svP] using r1) (by simpa [vol, svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw12 zs) ++ R)) c
    rw [← pull_swap35 g hg]; simpa [vol] using Hc
  · have e : binShape [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [vol, svP] using r1) (by simpa [svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw02 zs) ++ R)) c
    rw [← pull_swap15 g hg]; simpa [vol] using Hc

end NLogN.KFX

end

theorem solution : type_of% @NLogN.KFX.swE_geo_sol_aux := @NLogN.KFX.swE_geo_sol_aux
