theorem exists_orthogonalIdempotents_finrank_const
    (T : Type) [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T] (hT0 : algebraMap C T (algebraMap 𝒪 C π) = 0)
    (u : FakeEllipticCurve.WithFullLevel Λ N n T)
    (ρ : FakeEllipticCurve.Rigidification r π A₀ ((IsScalarTower.toAlgHom 𝒪 C T).comp ψ) u.1) :
    ∃ (nv : ℕ) (ev : Fin nv → T) (_ : CompleteOrthogonalIdempotents ev) (_ : Ideal.span (Set.range ev) = ⊤)
      (Aφ Γ : Fin nv → ℕ),
      ∀ (v : Fin nv) (y : ↥ρ.Ab.A),
        Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 T π}) (ev v) ∉ (ρ.Ab.f.base y).asIdeal →
          ρ.φ.finrank y = Aφ v ∧ (ρ.Ab.act ⟨(((r ^ 1 : ℕ) : ℤ) : ℚ), hΛℤ _⟩).finrank y = Γ v ∧ 0 < Aφ v ∧ 1 < Γ v := by
  classical

  obtain ⟨hφfin, hφfl, hφlfp, hφsurj⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r ρ.d _
    ρ.Eb ρ.Ab ρ.φ ρ.φ' ρ.isIsogenyPair
  obtain ⟨hcfin, hcfl, hclfp, -⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r (2 * 1) _
    ρ.Ab ρ.Ab _ _ (E2Aux.isIsogenyPair_act_rpow hΛℤ ρ.Ab r 1)

  obtain ⟨hφ1, hφ2⟩ := FakeEllipticCurve.isLocallyConstant_finrank_one _ ρ.Eb ρ.Ab ρ.φ ρ.φ_over
  obtain ⟨hc1, hc2⟩ := FakeEllipticCurve.isLocallyConstant_finrank_one _ ρ.Ab ρ.Ab
    (ρ.Ab.act ⟨(((r ^ 1 : ℕ) : ℤ) : ℚ), hΛℤ _⟩) (ρ.Ab.act_over _)

  obtain ⟨nv, eb, heb, -, hconst⟩ :=
    PrimeSpectrum.exists_completeOrthogonalIdempotents_forall_apply_eq_of_isLocallyConstant
      (T := T ⧸ Ideal.span {algebraMap 𝒪 T π}) _ (E2Aux.isLocallyConstant_prodMk hφ2 hc2)
  choose cst hcst using hconst

  have hπ0 : algebraMap 𝒪 T π = 0 := by rw [IsScalarTower.algebraMap_apply 𝒪 C T]; exact hT0
  have hinj : Function.Injective (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 T π})) := by
    rw [RingHom.injective_iff_ker_eq_bot, Ideal.mk_ker, Ideal.span_singleton_eq_bot]
    exact hπ0
  choose ev hev using fun v => Ideal.Quotient.mk_surjective (I := Ideal.span {algebraMap 𝒪 T π}) (eb v)
