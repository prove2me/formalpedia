theorem idxOf_getElem_nd {l : List ℕ} (hnd : l.Nodup) {i : ℕ} (hi : i < l.length) :
    l.idxOf l[i] = i := by
  simp [hnd]

/-- **One layout step.** -/
theorem Dl_step_sol_aux (mz : ℕ → ℕ) (bg : ℕ → Bool) {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ}
    (hP : POp g σ n) (ax0 lay' : List ℕ) (hl : lay'.length = n) (hnd : (g lay').Nodup)
    (hF : Full bg ax0 (g lay')) {α : Type*} (xs : List α) (d : α) :
    pull ((g lay').map (asz mz)) (lay'.map (asz mz)) g d (Dl mz bg ax0 (g lay') xs d) =
      Dl mz bg ax0 lay' xs d := by
  have hnd' := hP.nodup hl hnd
  have hgl := hP.length hl
  unfold Dl
  rw [pull_comp _ _ ?hv]
  case hv =>
    intro b hb
    have hbl : b.length = n := by rw [hb.length_eq]; simp [hl]
    refine (valid_iff _ _).2 ⟨by rw [hP.length hbl]; simp [hgl], fun k h1 h2 => ?_⟩
    have hk : k < n := by rw [hP.length hbl] at h1; exact h1
    obtain ⟨-, hlt⟩ := (valid_iff _ _).1 hb
    rw [hP.getElem hbl h1]
    have hs : σ k < n := hP.lt k hk
    have := hlt (σ k) (by omega) (by simp; omega)
    simp only [List.getElem_map] at this ⊢
    rw [hP.getElem hl (by omega)]
    exact this
  apply pull_congr
  intro b hb
  have hbl : b.length = n := by rw [hb.length_eq]; simp [hl]
  have key : ∀ x ∈ g lay', (g b).getD ((g lay').idxOf x) 0 = b.getD (lay'.idxOf x) 0 := by
    intro x hx
    have hi : (g lay').idxOf x < (g lay').length := List.idxOf_lt_length_iff.2 hx
    set i := (g lay').idxOf x
    have hi' : i < (g b).length := by rw [hP.length hbl]; rw [hgl] at hi; exact hi
    have e1 : (g lay')[i] = x := List.getElem_idxOf hi
    rw [hP.getElem hl hi] at e1
    have e2 : lay'.idxOf x = σ i := by rw [← e1]; exact idxOf_getElem_nd hnd' _
    rw [e2, List.getD_eq_getElem _ _ hi', hP.getElem hbl hi', List.getD_eq_getElem]
  simp only [Function.comp_apply, srcF]
  apply List.map_congr_left
  intro j hj
  unfold dig
  split_ifs with hbj
  · rw [key _ (hF j hj).1, key _ ((hF j hj).2 hbj)]
  · rw [key _ (hF j hj).1]

