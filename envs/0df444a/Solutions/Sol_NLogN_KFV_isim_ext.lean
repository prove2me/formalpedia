theorem gsim_carL (hb : 1 ≤ b) :
    GSim (πr c KG b r BJ D2) (carL (2 ^ (b - 1)) (2 ^ b) (2 * r)) carLU := by
  have hH : LitOK (πr c KG b r BJ D2) ((2 : ℤ) ^ (b - 1)) exHalf := by
    simpa using LitOK.half hb πr_B false
  have hnH : LitOK (πr c KG b r BJ D2) (-(2 : ℤ) ^ (b - 1)) (.neg exHalf) := by
    simpa using LitOK.half hb πr_B true
  have hBr := LitOK.reg (πR_low _ _ _ _ _ _) (πr_B (c := c) (KG := KG) (b := b) (r := r) (BJ := BJ) (D2 := D2))
  have hx : EG (πr c KG b r BJ D2) (xHE (2 ^ (b - 1))) xHU := .add (.refl _) (.lit hH)
  exact .seq (.push _ (.refl _)) (.seq (.rep _ (.lit (by exact_mod_cast LitOK.twoR πr_r))
    (.seq (.push _ (.add (.rem hx (.lit hBr)) (.lit hnH))) (.seq (.asg _ (.quo hx (.lit hBr)))
      (.seq (.pop _) (.pop _))))) (.pop _))

