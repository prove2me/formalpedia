    (hy : ((0 : ℝ), y) ∈ W) (k i j : Fin n) :
    HasDerivAt (fun ε => pd k (g ε i j) y) (pd k (h i j) y) 0 :=
  hasDerivAt_pd_param (Φ := fun ε => g ε i j) hfam.isOpen (hfam.smooth i j) hy
    (fun z hz => ht.metric z hz i j) k

/-- `δΓ = chrVar g ginv h`. -/
theorem hasDerivAt_christoffel (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (a b c : Fin n) :
    HasDerivAt (fun ε => christoffel (g ε) (ginv ε) a b c y) (chrVar (g 0) (ginv 0) h a b c y) 0 :=
  hasDerivAt_christoffel_of (hfam.hasDerivAt_inv ht hy) (hfam.hasDerivAt_pd_metric ht hy) a b c

/-- `δ(∂_i Γ) = ∂_i(chrVar g ginv h)` (second-order interchange from joint smoothness). -/
theorem hasDerivAt_pd_christoffel (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f)
    {x : Pt n} (hx : ((0 : ℝ), x) ∈ W) (i a b c : Fin n) :
    HasDerivAt (fun ε => pd i (christoffel (g ε) (ginv ε) a b c) x) (pd i (chrVar (g 0) (ginv 0) h a b c) x) 0 :=
  hasDerivAt_pd_param (Φ := fun ε => christoffel (g ε) (ginv ε) a b c) hfam.isOpen
    (contDiffOn_christoffel_joint hfam.isOpen hfam.smooth hfam.smooth_inv a b c) hx
    (fun _ hy => hfam.hasDerivAt_christoffel ht hy a b c) i

/-- `δRic = ricciVar g ginv h`. -/
theorem hasDerivAt_ricciOf (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {x : Pt n}
    (hx : ((0 : ℝ), x) ∈ W) (b d : Fin n) :
    HasDerivAt (fun ε => ricciOf (g ε) (ginv ε) b d x) (ricciVar (g 0) (ginv 0) h b d x) 0 :=
  hasDerivAt_ricci_of (Γ := fun ε => christoffel (g ε) (ginv ε)) (fun a b c => hfam.hasDerivAt_christoffel ht hx a b c)
    (fun i a b c => hfam.hasDerivAt_pd_christoffel ht hx i a b c) b d

end FamilyData

