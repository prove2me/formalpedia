/-! ## Managed-state operations -/

section ops
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem encK_upd' (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (encK s F).upd i (ints l ++ s.G i) = encK s (update F i l) := by
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases h : x = i
  · subst h; simp
  · simp [h]

theorem mvM (s : IState HS) (F : Fin HS → List ℤ) {i j : Fin HS} (hij : i ≠ j) {a : ℤ}
    {l : List ℤ} (hi : F i = a :: l) :
    IRuns I iprog (.op (.mv i j)) (encK s F) (encK s (update (update F i l) j (a :: F j)))
      (2 * moveCost (zsz a) + 19) := by
  have h := IRuns.mv (I := I) (iprog := iprog) (s := encK s F) (i := i) (j := j) hij
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [encK_upd', show (Item.int a :: (encK s F).G j) = ints (a :: update F i l j) ++ s.G j by
    simp [ints, Function.update_of_ne (Ne.symm hij)], encK_upd', Function.update_of_ne (Ne.symm hij)]

/-- The `rptX` counters over a managed state with empty counter stacks. -/
theorem cf3_encK (s : IState HS) (F : Fin HS → List ℤ) (hA : F lA = []) (hC : F lC = [])
    (hD : F lD = []) (LA LC LD : List Item) :
    cf3 (encK s F) lA lC lD LA LC LD = encK (cf3 s lA lC lD LA LC LD) F := by
  unfold cf3
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases e1 : x = lD
  · subst e1; simp [hD]
  · by_cases e2 : x = lC
    · subst e2; simp [hC]
    · by_cases e3 : x = lA
      · subst e3; simp [hA]
      · simp [e1, e2, e3]

end ops

/-! ## Lanes -/

/-! ## The slab loops -/

section loops
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}

theorem lin_skel (hL : LaneOK lin) {j : Fin HS} (hj : j ∈ skel) (inp tmp : List U)
    (G : Fin HS → List ℤ) : lin inp tmp G j = G j := hL.rd j hj inp tmp G

/-- The counter stacks of a lane state. -/
theorem lin_cnt (hL : LaneOK lin) (inp tmp : List U) (G : Fin HS → List ℤ)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) :
    lin inp tmp G lA = [] ∧ lin inp tmp G lC = [] ∧ lin inp tmp G lD = [] := by
  refine ⟨?_, ?_, ?_⟩
  · rw [hL.rd lA (by simp [skel]) inp tmp G, hA]
  · rw [hL.rd lC (by simp [skel]) inp tmp G, hC]
  · rw [hL.rd lD (by simp [skel]) inp tmp G, hD]

/-- A loop over `m` steps on lane states, the counter `X` (a skeleton register). -/
theorem laneLoopX (hL : LaneOK lin) {X : Fin HS} (hX : X ∈ skel) (hXA : X ≠ lA)
    (body : IStmt HS P) (c m : ℕ) (s : IState HS)
    (Ln : ℕ → List U) (Lt : ℕ → List U) (Gk : ℕ → Fin HS → List ℤ)
    (hA : ∀ k, Gk k lA = []) (hC : ∀ k, Gk k lC = []) (hD : ∀ k, Gk k lD = [])
    {LM : List ℤ} (hM : Gk 0 X = (m : ℤ) :: LM)
    (hb : ∀ k < m, ∀ s', IRuns I iprog body (encK s' (lin (Ln k) (Lt k) (Gk k)))
      (encK s' (lin (Ln (k + 1)) (Lt (k + 1)) (Gk (k + 1)))) c) :
    IRuns I iprog (rptX X lA lC lD body) (encK s (lin (Ln 0) (Lt 0) (Gk 0)))
      (encK s (lin (Ln m) (Lt m) (Gk m))) ((m + 1) * (c + 3000)) := by
  have hcnt := fun k => lin_cnt hL (Ln k) (Lt k) (Gk k) (hA k) (hC k) (hD k)
  refine rptXU_runs (I := I) (iprog := iprog) (X := X) hXA m
    (fun k => encK s (lin (Ln k) (Lt k) (Gk k)))
    (fun k => by simp only [encK_G, (hcnt k).1, (hcnt 0).1])
    (fun k => by simp only [encK_G, (hcnt k).2.1, (hcnt 0).2.1])
    (fun k => by simp only [encK_G, (hcnt k).2.2, (hcnt 0).2.2]) body c ?_ (ints LM ++ s.G X) ?_
  · intro k hk LA LC LD
    rw [cf3_encK s _ (hcnt k).1 (hcnt k).2.1 (hcnt k).2.2,
      cf3_encK s _ (hcnt (k + 1)).1 (hcnt (k + 1)).2.1 (hcnt (k + 1)).2.2]
    exact hb k hk _
  · simp only [encK_G, lin_skel hL hX, hM, ints, List.map_cons, List.cons_append]

end loops

