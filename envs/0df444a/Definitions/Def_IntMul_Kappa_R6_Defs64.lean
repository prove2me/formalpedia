-- Source module: Solutions.J6SegKr3
/-!
# B3 (chunk kernel), part 3: the diagonal stage

`dgI pM X T U Y CN CC N`: with `n` on `N`, the row `gflat z ++ lx` on `X` (`|z| = n`) and the
table `c ++ lt` on `T` (`n ≤ |c|`), it pushes `gflat (dgG P c z).reverse` onto `Y`, consumes the
row and leaves the table in place (the used entries go through `U` and back). Each item costs two
calls of the multiplication procedure (`KFM.mulC`) and two roundings `rs P` (`rsE`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The loop test: the counter is positive. -/
def isPos (c : Cls) : Bool := decide (c = .pos)

abbrev dM1 : Fin HS := 12
abbrev dM2 : Fin HS := 13

/-- The register part of one item. -/
def dgRS (X T U Y CN : Fin HS) : RS :=
  .seq (.pop X) (.seq (.push Y (rsE dM2)) (.seq (.push Y (rsE dM1)) (.seq (.pop dM1)
    (.seq (.pop dM2) (.seq (.push U (.reg T)) (.seq (.pop T)
      (.asg CN (.add (.reg CN) (.lit (-1))))))))))

/-- One item. -/
def dgBody (pM : Fin Pp) (X T U Y CN : Fin HS) : IStmt HS Pp :=
  .seq (KFM.mulC pM dM1 X T) (.seq (RS.pop X).code (.seq (KFM.mulC pM dM2 X T)
    (dgRS X T U Y CN).code))

/-- **The diagonal stage.** -/
def dgI (pM : Fin Pp) (X T U Y CN CC N : Fin HS) : IStmt HS Pp :=
  .seq (RS.push CN (.reg N)).code (.seq (.loop CN isPos (dgBody pM X T U Y CN))
    (.seq (RS.pop CN).code (NLogN.mvK U T CC (.reg N)).code))

/-- Cost of the diagonal stage on `n` items. -/
def cDG (n φ B : ℕ) : ℕ := (n + 1) * (2 * φ + 400000 * (B + 2))

end J6Seg.KR

end

