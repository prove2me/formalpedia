theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (ι : Type) [Fintype ι] (d : ι → ℕ) (ν : ∀ i, Fin (d i + 1))
    (g : ∀ i, Fin (d i + 1) → IsLocalRing.ResidueField O) (hgν : ∀ i, g i (ν i) = 1)
    (hc : TypeDensity.FormsCoprime d g) (μ : Fin ((∑ i, d i) + 1)) (hμ : TypeDensity.formProd d g μ = 1)
    (a a' : ∀ i, Fin (d i) → O)
    (ha : a ∈ Set.pi Set.univ (fun i => TypeDensity.reducedFormCell O (d i) (ν i) (g i)))
    (ha' : a' ∈ Set.pi Set.univ (fun i => TypeDensity.reducedFormCell O (d i) (ν i) (g i))) (L : ℕ)
    (hL : ∀ j, TypeDensity.reducedFormProduct O d ν g μ a j - TypeDensity.reducedFormProduct O d ν g μ a' j ∈
      (IsLocalRing.maximalIdeal O) ^ L) :
    ∀ i j, a i j - a' i j ∈ (IsLocalRing.maximalIdeal O) ^ L := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hres := TypeDensity.residue_eq_zero_iff_dvd hϖ
  have ha₁ : ∀ i, a i ∈ TypeDensity.reducedFormCell O (d i) (ν i) (g i) := fun i => ha i (Set.mem_univ _)
  have ha₁' : ∀ i, a' i ∈ TypeDensity.reducedFormCell O (d i) (ν i) (g i) := fun i => ha' i (Set.mem_univ _)
  obtain ⟨-, hPres, hu, -⟩ := TypeDensity.form_product_maps_to_and_preserves O ι d ν g μ hμ a a ha ha
  obtain ⟨-, -, hu', -⟩ := TypeDensity.form_product_maps_to_and_preserves O ι d ν g μ hμ a' a' ha' ha'
  set A : ∀ i, Fin (d i + 1) → O := fun i => TypeDensity.insertOne (ν i) (a i) with hA
  set A' : ∀ i, Fin (d i + 1) → O := fun i => TypeDensity.insertOne (ν i) (a' i) with hA'
  set P := TypeDensity.formProd d A
  set P' := TypeDensity.formProd d A'
  have hAres : ∀ i k, IsLocalRing.residue O (A i k) = g i k := fun i k => congrFun (ha₁ i).2 k
  have hA'res : ∀ i k, IsLocalRing.residue O (A' i k) = g i k := fun i k => congrFun (ha₁' i).2 k
  have hPres : ∀ k, IsLocalRing.residue O (P k) = TypeDensity.formProd d g k := fun k => congrFun hPres k
  have e1 : Ring.inverse (P μ) * P μ = 1 := Ring.inverse_mul_cancel _ hu
  have e2 : Ring.inverse (P' μ) * P' μ = 1 := Ring.inverse_mul_cancel _ hu'
  -- `hL`, cross-multiplied, in all coordinates
  have hM : ∀ k, ϖ ^ L ∣ P' μ * P k - P μ * P' k := by
    intro k
    have hN : ϖ ^ L ∣ Ring.inverse (P μ) * P k - Ring.inverse (P' μ) * P' k := by
      rcases Fin.eq_self_or_eq_succAbove μ k with rfl | ⟨j, rfl⟩
      · rw [e1, e2, sub_self]; exact dvd_zero _
      · have h := (TypeDensity.mem_maximalIdeal_pow_iff hϖ _ _).1 (hL j)
        rwa [TypeDensity.reducedFormProduct_of_mem O d ν g μ ha₁, TypeDensity.reducedFormProduct_of_mem O d ν g μ ha₁'] at h
    convert dvd_mul_of_dvd_right hN (P μ * P' μ) using 1
    linear_combination (-(P' μ * P k)) * e1 + (P μ * P' k) * e2
  -- induction on the precision
  have claim : ∀ t, 1 ≤ t → t ≤ L → ∀ i k, ϖ ^ t ∣ A' i k - A i k := by
    intro t ht
    induction t, ht using Nat.le_induction with
    | base => intro _ i k; rw [pow_one, ← hres, map_sub, hAres, hA'res, sub_self]
    | succ t ht IH =>
      intro htL
      choose H hH using IH (by omega)
      exact TypeDensity.form_congruence_step hϖ d ν g hgν hc μ hμ A A' (fun i => (ha₁ i).1)
        (fun i => (ha₁' i).1) (fun i => (ha₁ i).2) hPres ht
        (fun k => (pow_dvd_pow ϖ htL).trans (hM k)) H hH
  intro i j
  rcases Nat.eq_zero_or_pos L with rfl | hL0
  · simp
  · rw [TypeDensity.mem_maximalIdeal_pow_iff hϖ, ← dvd_neg, neg_sub]
    simpa [hA, hA', TypeDensity.insertOne] using claim L hL0 le_rfl i ((ν i).succAbove j)
