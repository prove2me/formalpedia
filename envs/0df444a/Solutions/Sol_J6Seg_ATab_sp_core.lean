set_option maxHeartbeats 1000000 in
theorem v1_asgA {W pre post s t p α pkA pkC bA bC : ℕ} {v : Vr}
    (hv : J6A.PA.PV pre post s t p α W v) :
    V1 p s t α pkA pkC bA bC (runA (asgA pkA pkC bA bC) v) := by
  have hH : (J6A.PA.HH p α : ℕ) = HAx p α := rfl
  have enc : ((ncA p t α : ℕ) : ℤ) = ↑t / (16 * ↑(J6A.PA.HH p α)) * 8 := by
    simp [ncA, HAx, J6A.PA.HH]
  constructor <;>
    simp only [asgA, runA, E.den, update_apply, Fin.isValue, Fin.reduceEq, if_false, if_true,
      ↓reduceIte, hv.r1, hv.r2, hv.r3, hv.r4, hv.r5, hv.r6, hv.r8, hv.r9, hv.r10]
  all_goals first
    | rfl
    | (rw [enc])
    | (unfold J6A.QA; rw [Nat.cast_sub (by omega)]; push_cast; ring)
    | (push_cast <;> ring)
    | (simp only [hH] <;> push_cast <;> ring)

theorem bv_asgA {W pre post s t p α pkA pkC bA bC : ℕ} {v : Vr}
    (hv : J6A.PA.PV pre post s t p α W v) (hB : PBnd W p t α pkA pkC bA bC) (c : Cs) :
    Rn (PJ.asgs (asgA pkA pkC bA bC)) v c
      (fun v' => V1 p s t α pkA pkC bA bC v' ∧ BV W v') c (cA W (asgA pkA pkC bA bC)) :=
  (Rn.asgs (W := W) (c := c) (asgA pkA pkC bA bC) (asgA_ok _ _ _ _) (asgA_lb hB) hv.bv
    (bndA_asgA hv hB)).mono (fun v' ⟨e, h⟩ => ⟨e ▸ v1_asgA hv, h⟩) le_rfl

/-! ## The powers of two -/

/-! ## The `aHdr2` constants -/

/-! ## The phase -/

/-- **The parameter phase.** -/
theorem Rn.phase {W pre post s t p α pkA pkC bA bC : ℕ} {v : Vr} {c : Cs}
    (hv : J6A.PA.PV pre post s t p α W v) (hB : PBnd W p t α pkA pkC bA bC)
    (hrW : 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) < 2 ^ W) (hc48 : c cLC = []) :
    Rn (phase pkA pkC bA bC) v c
      (fun v' => LV p s t α (pkA * p + pkC) (bA * p + bC) v' ∧ v' 10 = ncA p t α ∧ BV W v')
      (pushToC v (pushD pkA pkC) c) (cPhase W p α pkA pkC bA bC) := by
  have s1 := Rn.pushTo hv.bv (pushD pkA pkC) c (pushD_ok hB)
  refine Rn.seq s1 (fun v0 e0 => ?_)
  subst e0
  have hc1 : pushToC v0 (pushD pkA pkC) c cLC = [] := by
    simp only [pushD, pushToC, update_apply, cLC, Fin.isValue, Fin.reduceEq, if_false]; exact hc48
  refine Rn.seq (bv_asgA hv hB _) (fun v1 ⟨h1, hB1⟩ => ?_)
  refine Rn.seq (Rn.phaseP h1 hB1 hB hc1) (fun v2 ⟨h2, hB2⟩ => ?_)
  exact Rn.phaseK h2 hB2 hB hrW hc1

