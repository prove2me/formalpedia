theorem solution (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p) {r : ℕ}
    (s : Fin r → ↥(modularFunctionFieldBar (1 * p))) (hs : IsEmbBasis (1 * p) s) : r = mAnnuli p + 1 := by
  classical

  have h1 : mAnnuli p = genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (1 * p)) + 1 := by
    let K₀ := AlgebraicClosure (ZMod p)
    haveI : CharP K₀ p := charP_of_injective_algebraMap (algebraMap (ZMod p) K₀).injective p
    set S := (ssJSet_finite p K₀).toFinset with hSdef
    have hS : ∀ j, j ∈ S ↔ j ∈ ssJSet p K₀ := fun j => Set.Finite.mem_toFinset _
    have hc1 := card_eq_of_ssJSet p hp5 K₀ S hS
    have hc2 := LevelOneFibre.card_eq_genusFF_one_mul_add_one_of_ssJSet hp5 S hS
    rw [hc1] at hc2
    rw [← hc2]; rfl

  have h2 : r = genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (1 * p)) + 2 := by
    haveI := hasCanonicalDivisor_modularFunctionFieldBar (1 * p)
    haveI := isCurveOver_modularFunctionFieldBar (1 * p)
    obtain ⟨t, ht⟩ := AlgebraicCurve.exists_D_ne_zero (K := (AlgebraicClosure ℚ)) (F := ↥(modularFunctionFieldBar (1 * p)))
    have hRR := finrank_riemannRochSpace_sub_finrank_canonicalDivisorOf_sub_eq (1 * p) ht (embDivisor (1 * p))
    have hdegK := degree_canonicalDivisorOf_modularFunctionFieldBar (1 * p) ht
    rw [genus_eq_genusFF_modularFunctionFieldBar] at hdegK
    have hdegD : (embDivisor (1 * p)).degree = (embDegree (1 * p) : ℤ) := by
      rw [embDivisor, map_zsmul, Divisor.degree_single, deg_cuspInftyBar]; simp
    have hneg : (canonicalDivisorOf ht - embDivisor (1 * p)).degree < 0 := by
      rw [map_sub, hdegK, hdegD, embDegree]; push_cast; omega
    have h0 : Module.finrank (AlgebraicClosure ℚ) ↥(riemannRochSpace (canonicalDivisorOf ht - embDivisor (1 * p))) = 0 :=
      ell_eq_zero_of_degree_neg hneg
    have hfr : Module.finrank (AlgebraicClosure ℚ) ↥(riemannRochSpace (embDivisor (1 * p))) = r := by
      rw [← hs.2, finrank_span_eq_card hs.1, Fintype.card_fin]
    rw [h0, hfr, hdegD, embDegree] at hRR
    push_cast at hRR
    omega
  omega

