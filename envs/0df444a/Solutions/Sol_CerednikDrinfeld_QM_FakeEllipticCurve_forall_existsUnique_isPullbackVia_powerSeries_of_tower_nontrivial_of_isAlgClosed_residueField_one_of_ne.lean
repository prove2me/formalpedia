  have hn' : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker ((Gmap f hf x) ρ').1 := fun a ha => by
    show (f.comp (x σ).1) a = 0
    rw [RingHom.comp_apply, (RingHom.mem_ker).mp (hn ha), map_zero]
  show xiAt D ((Gmap f hf x) ρ') ρ' _ _ = Quotient.map' _ _ (xiAt D (x σ) σ n hn)
  rw [xiAt_eq D ((Gmap f hf x) ρ') ρ' _ n _ hn']
  apply Quotient.sound
