-- Source module: Solutions.KFWSub
/-!
# KFW: literals read from registers (the uniformity meta-theorem for register programs)

A uniform register program `U` reads its run-time parameters from registers (tops of stacks).
`RS.sub σ U` replaces each register `i` with `σ i = some v` by the literal `v`; the result is
the (non-uniform) program with baked-in literals, for which a spec is usually already proved.

**`FSp.of_sub`**: if `FSp (U.sub σ) s t c`, the registers of `σ` hold their values in `s`
(`Agree σ s`) and `U` never writes them, then `FSp U s t (400 c)`.  Also `fok_of_sub`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD

theorem Agree.top {σ : Fin HS → Option ℤ} {s : IState HS} (h : Agree σ s) {i : Fin HS} {v : ℤ}
    (hi : σ i = some v) : s.top i = v := by
  obtain ⟨L, hL⟩ := h i v hi; exact IState.top_eq_r6c hL

theorem Agree.isInt {σ : Fin HS → Option ℤ} {s : IState HS} (h : Agree σ s) {i : Fin HS} {v : ℤ}
    (hi : σ i = some v) : s.IsInt i := by
  obtain ⟨L, hL⟩ := h i v hi; exact ⟨L, by rw [hL, IState.top_eq_r6c hL]⟩

section ExLemmas

variable (σ : Fin HS → Option ℤ) {s : IState HS}

theorem Ex.eval_sub (hs : Agree σ s) : ∀ e : Ex HS, (Ex.sub σ e).eval s = e.eval s
  | .reg i => by
    unfold Ex.sub
    rcases h : σ i with _ | v
    · rfl
    · simp only [Ex.eval]; exact (hs.top h).symm
  | .lit c => rfl
  | .add a b | .mul a b | .shl a b | .quo a b | .rem a b | .ndiv a b | .nmod a b => by
    simp only [Ex.sub, Ex.eval, Ex.eval_sub hs a, Ex.eval_sub hs b]
  | .neg a | .pow2 a => by simp only [Ex.sub, Ex.eval, Ex.eval_sub hs a]
  | .sel c x y => by simp only [Ex.sub, Ex.eval, Ex.eval_sub hs c, Ex.eval_sub hs x, Ex.eval_sub hs y]

end ExLemmas

end NLogN.KFW

end

