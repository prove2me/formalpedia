    (hZe : zsz ((e + t + K + mC * mC ^ k + mC ^ k : ℕ) : ℤ) ≤ Z)
    (hZu : zsz ((6 * mC ^ k + 6 : ℕ) : ℤ) ≤ Z)
    (w : Fin P8Lift.Wc) (k0 k1 : ℕ) (a : Fin mC → ℕ) :
    RImplQ Isym tbl Q lo hi r (nN Bn t S0) (stN K e k S0)
      ((P8Lift.RStep.phase w k0 k1 a : P8Lift.RStep (Fin P8Lift.Wc) mC).den
        (Butterfly.tens Cm : Butterfly.Op (Fin (mC ^ k))))
      (phC' w k0 k1 a) 0 (0 + (0 + 2) * P8Lift.Wc)
      (cWrapQ P8Lift.Wc (nN Bn t S0 * r) Z 0 0
        (cPhStep Z (((k0 + k1 * mC ^ k) % 4 : ℕ) : ℤ) (εTab NLogN.KFW.vE vK vF NLogN.KFW.wF (List.ofFn a)) Bn t S0 r)) := by sorry
