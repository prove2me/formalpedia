  have hpow : (0 : ℝ) <
      (Ideal.absNorm v.asIdeal : ℝ) ^ (-(TateLocal.addCharLevel (StandardAddChar.psiLocal K v) : ℝ) / 2) :=
    Real.rpow_pos_of_pos (by linarith) _
  have hunits := TateLocal.selfDualHaarAt_real_units_eq K v
  have hunits_ne : (((TateLocal.selfDualHaarAt K v).real {x : v.adicCompletion K | Valued.v x = 1} : ℝ) : ℂ) ≠ 0 := by
    rw [hunits]
