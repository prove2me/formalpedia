          Ex.Clean, Ex.regs, zX_all], ?_⟩, ?_, ?_, ?_⟩
      · apply tdivE_ok
        · simp (config := {decide := true}) [Ex.ok, IState.IsInt, IState.top, scSt2, NLogN.scSt,
