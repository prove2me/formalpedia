section
-- Source module: Solutions.J6SegILSweep1
/-!
# B-line IL, B6 (the sweep over the axes) §1: the axis contract, the state, the arithmetic

* `descAx6 P n src D k = [k, pre_k, post_k, src k, t_k, p, α, d]` with `pre_k = ∏_{j<k} t_j`,
  `post_k = ∏_{k<j≤D} t_j` (as `List.ofFn (tD6 P n D)` take / drop products);
* **`AxisBody6`**: procedure `eX` runs the seven passes of axis `k` (`pipe6 P n src D k`) on
  stack `0`, reading `descAx6` from `dA` (the convention of `FineBody6` / `RowBody6`);
* `ax_call`: the call on any managed state with the descriptor pushed on `dA`;
* the sweep state `SS σ dS F z ds v` (registers `σ : Fin 19 → Fin HS` with contents `v`);
* the products: `t_j = 2^h (1 + b_j)`, `∏_{j<k} t_j = 2^{hk + #ones}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The axis contract -/

/-- `∏_{j<k} t_j`. -/
def preT (P : Prm) (n D k : ℕ) : ℕ := ((List.ofFn (tD6 P n D)).take k).prod
/-- `∏_{k<j≤D} t_j`. -/
def postT (P : Prm) (n D k : ℕ) : ℕ := ((List.ofFn (tD6 P n D)).drop (k + 1)).prod

/-- The descriptor of the program of axis `k`. -/
def descAx6 (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) : List ℤ :=
  [(k : ℤ), (preT P n D k : ℤ), (postT P n D k : ℤ), (src k : ℤ), (tF6 P n k : ℤ),
    (pP6 P n : ℤ), (αN6 P n : ℤ), (dP6 P n : ℤ)]

/-- **The program of one axis** (B5): `pipe6 P n src D k` on stack `0`. -/
def AxisBody6 {Pp : ℕ} (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ) (Isym : List Sym)
    (tbl : Fin Pp → IStmt HS Pp) (eX : Fin Pp) (dA : Fin HS) (C : ℝ) : Prop :=
  ∀ k ≤ D, ∀ (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dA → F j = []) → F dA = descAx6 P n src D k → F 0 = gflat L ++ l →
    L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
    ∃ c : ℕ, IRuns Isym tbl (.call eX) (encK s F)
        (encK s (update F 0 (gflat (pipe6 P n src D k L) ++ l))) c ∧ (c : ℝ) ≤ C

/-- **The program of one axis for a general axis step `pf`** (`AxisBody6` is `pf = pipe6`). -/
def AxisBodyF {Pp : ℕ} (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ) (pf : ℕ → List GI → List GI)
    (Isym : List Sym)
    (tbl : Fin Pp → IStmt HS Pp) (eX : Fin Pp) (dA : Fin HS) (C : ℝ) : Prop :=
  ∀ k ≤ D, ∀ (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dA → F j = []) → F dA = descAx6 P n src D k → F 0 = gflat L ++ l →
    L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
    ∃ c : ℕ, IRuns Isym tbl (.call eX) (encK s F)
        (encK s (update F 0 (gflat (pf k L) ++ l))) c ∧ (c : ℝ) ≤ C

/-! ## The sweep state -/

/-- The register map of the sweep is admissible. -/
structure SwOK (σ : Fin 19 → Fin HS) (dS dA : Fin HS) : Prop where
  inj : Injective σ
  ne0 : ∀ i, σ i ≠ 0
  neS : ∀ i, σ i ≠ dS
  neA : ∀ i, σ i ≠ dA
  lt : ∀ i, (σ i).val < 56
  S0 : dS ≠ 0
  Slt : dS.val < 56
  A0 : dA ≠ 0

/-- The managed state: stack `0 = z`, `dS = ds`, register `σ i = v i`, else `F`. -/
def SS (σ : Fin 19 → Fin HS) (dS : Fin HS) (F : Fin HS → List ℤ) (z ds : List ℤ)
    (v : Fin 19 → List ℤ) : Fin HS → List ℤ :=
  fun j => if j = 0 then z else if j = dS then ds else extend σ v F j

/-! ## The products of the axis lengths -/

theorem ofFn_tD6 (P : Prm) (n D : ℕ) :
    List.ofFn (tD6 P n D) = (List.range (D + 1)).map (tF6 P n) := by
  apply List.ext_getElem (by simp)
  intro i h1 h2
  rw [List.getElem_ofFn, List.getElem_map, List.getElem_range]; rfl

/-- The number of `1` bits below `k`. -/
def cntB (P : Prm) (n : ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => cntB P n k + if bL6 P n k then 1 else 0

theorem tF6_eq (P : Prm) (n j : ℕ) :
    tF6 P n j = 2 ^ hN6 P n * (1 + if bL6 P n j then 1 else 0) := by
  unfold tF6; split_ifs <;> ring

theorem prod_range_tF6 (P : Prm) (n : ℕ) :
    ∀ k, ((List.range k).map (tF6 P n)).prod = 2 ^ (hN6 P n * k + cntB P n k)
  | 0 => by simp [cntB]
  | k + 1 => by
      rw [List.range_succ, List.map_append, List.prod_append, prod_range_tF6 P n k]
      simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, cntB]
      rw [tF6_eq]
      split_ifs <;> ring

theorem total_eq (P : Prm) (n D : ℕ) :
    (List.ofFn (tD6 P n D)).prod = 2 ^ (hN6 P n * (D + 1) + cntB P n (D + 1)) := by
  rw [ofFn_tD6, prod_range_tF6]

end J6Seg

end

end

section
-- Source module: Solutions.J6LineTop1
/-!
# `LineNeed6` top level, part 1: the contracts of the remaining pieces

The three statements the top-level assembly (`J6LineTop*`) takes from the workers:

* **`AIL6s P tab`** (A lines, IL): `AIL6` (`J6AMath6`) with the descriptor stack below `56`
  (`dS.val < 56`), so the `B` sweep can share it (it reads and restores the descriptor with `RS`
  push / pop).
* **`AxisU6 P tab`** (B lines, the per-axis program, S2): a family of procedures `U`, uniform in
  the table (as `FineU6`), whose procedure `eX` meets `AxisBody6` (`J6SegILSweep1`) at cost
  `C₀ · cU6 P n A / (D + 1)` per axis on every table containing the family.
* **`PipeDisc6 P`** (B lines, math): every axis map `pipe6 P n src D k` keeps the length and the
  disc `DiscL p` (entries of modulus `≤ 2^p`) of a `t`-box array.

All three are assumed under `P.Ok` and (for the IL ones) the table facts `SwapNeedτ`, `RowUCP`,
`FineU6` that `LineNeed6` provides.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- **The A-line IL obligation with a low descriptor stack** (`AIL6` plus `dS.val < 56`). -/
def AIL6s (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eA : Fin (7 + E)) (dS : Fin HS) (C₀ : ℝ)
    (A n₁ : ℕ), dS ≠ 0 ∧ dS.val < 56 ∧ 0 ≤ C₀ ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
  ∀ (Isym : List Sym) (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descLine6 P n src →
    ∀ zs : List GI, f 0 = gflat zs ++ l → zs.length = (List.ofFn (tD6 P n D)).prod →
      GB (pP6 P n + 2) zs →
      ∃ c : ℕ, IRuns Isym (IL.kTableP tab ext) (.call eA) (encK s f)
          (encK s (Function.update f 0
            (gflat (IntMul.HvdH.Ref.tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs) ++
              l))) c ∧
        (c : ℝ) ≤ C₀ * cU6 P n A

/-- **The per-axis `B` program** (S2), uniform in the table: on every table `kTableP tab ext`
containing the family `U` (at `idx`), procedure `idx eX` meets `AxisBody6` with the axis
descriptor on `dA` at cost `C₀ · cU6 P n A / (D + 1)`. -/
def AxisU6 (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (eX : Fin nU) (dA : Fin HS) (C₀ : ℝ) (A n₁ : ℕ), dA ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
    (∀ i, IL.kTableP tab ext (idx i) = U E idx i) →
    ∀ Isym : List Sym,
      AxisBody6 P n src D Isym (IL.kTableP tab ext) (idx eX) dA (C₀ * cU6 P n A / (D + 1))

/-- **The axis maps keep the disc** (B lines, math). -/
def PipeDisc6 (P : Prm) : Prop :=
  ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ k ≤ D, ∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod →
    NLogN.KFY.DiscL (pP6 P n) L →
    (pipe6 P n src D k L).length = L.length ∧ NLogN.KFY.DiscL (pP6 P n) (pipe6 P n src D k L)

end J6Seg

end

section
-- Source module: Solutions.J6LineTopA1
/-!
# `A` lines by an axis sweep, part 1: the contracts

The `A`-line analogue of the `B` sweep (`J6SegILSweep*`, `J6LineTop*`):

* `lineA6 P n src D k`: the line map of axis `k` of `mapsA6` (`t_k` outputs of `chirpC`);
* **`pipeA6 P n src D k`** `= axisL t_k (∏_{j>k} t_j) (lineA6 … k)`: the `k`-th axis step of
  `tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D))` (`J6LineTopA2`: the steps compose to
  `tensorGo`);
* **`AxisBodyA6`**: `AxisBody6` with `pipeA6` in place of `pipe6` (descriptor `descAx6` on `dA`,
  precondition `GB (p + 2)`);
* **`AxisUA6 P tab`**: `AxisU6` with `AxisBodyA6` (the per-axis `A` program, uniform in the table);
* **`PipeGBA6 P`**: each `pipeA6` step keeps the length and `GB (p + 2)` of a `t`-box array.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

section A
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ)

/-- The line map of axis `k` of `mapsA6`. -/
def lineA6 (k : ℕ) : List GI → List GI := fun X =>
  (List.range ((List.ofFn (tD6 P n D)).getD k 1)).map
    (J6A.chirpC (pP6 P n) ((List.ofFn (sD6 src D)).getD k 1) ((List.ofFn (tD6 P n D)).getD k 1)
      (αN6 P n) (HA6 P n) fun j => X.getD j (0, 0))

/-- **The `k`-th axis step of the `A` lines.** -/
def pipeA6 (k : ℕ) : List GI → List GI :=
  axisL ((List.ofFn (tD6 P n D)).getD k 1) ((List.ofFn (tD6 P n D)).drop (k + 1)).prod
    (lineA6 P n src D k)

end A

/-- **The per-axis `A` body**: `AxisBody6` with `pipeA6`. -/
def AxisBodyA6 {Pp : ℕ} (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ) (Isym : List Sym)
    (tbl : Fin Pp → IStmt HS Pp) (eX : Fin Pp) (dA : Fin HS) (C : ℝ) : Prop :=
  ∀ k ≤ D, ∀ (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dA → F j = []) → F dA = descAx6 P n src D k → F 0 = gflat L ++ l →
    L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
    ∃ c : ℕ, IRuns Isym tbl (.call eX) (encK s F)
        (encK s (update F 0 (gflat (pipeA6 P n src D k L) ++ l))) c ∧ (c : ℝ) ≤ C

/-- **The per-axis `A` program**, uniform in the table (`AxisU6` with `AxisBodyA6`). -/
def AxisUA6 (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (eX : Fin nU) (dA : Fin HS) (C₀ : ℝ) (A n₁ : ℕ), dA ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
    (∀ i, IL.kTableP tab ext (idx i) = U E idx i) →
    ∀ Isym : List Sym,
      AxisBodyA6 P n src D Isym (IL.kTableP tab ext) (idx eX) dA (C₀ * cU6 P n A / (D + 1))

/-- **The `A` axis steps keep `GB (p + 2)`.** -/
def PipeGBA6 (P : Prm) : Prop :=
  ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ k ≤ D, ∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
    (pipeA6 P n src D k L).length = L.length ∧ GB (pP6 P n + 2) (pipeA6 P n src D k L)

end J6Seg

end

