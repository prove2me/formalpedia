section
-- Source module: Solutions.J6SegILPre4
/-!
# B-line IL, pre-tables (B5), part 4: polynomial expressions and the push loop

* `Poly e`: no `pow2`/`shl`, literals of absolute value `≤ 4`; `dg e` its degree;
  `mg_le_dg`: with every register value `≤ 2^A` (`A ≥ 2`), `mg e ≤ 2^(A·dg e)`. Every expression of
  the pre-table loops is polynomial (the powers `2^P`, `2^{P+1}` sit in registers `9`, `10`), so
  all cost conditions reduce to `dg e ≤ D` (by `decide`) and one uniform width `B = A·D + 1`.
* `pushLoop`: a counted loop whose body pushes `f k` onto `O` leaves `rv f N ++ O`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

theorem pow_le_pow' {A a b : ℕ} (h : a ≤ b) : 2 ^ (A * a) ≤ 2 ^ (A * b) :=
  Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ h)

/-- The uniform width: `dg e ≤ D` gives `mg e < 2^(A·D + 1)`. -/
theorem mg_lt {V : Fin HS → ℕ} {A D : ℕ} (hV : ∀ j, V j ≤ 2 ^ A) (hA : 2 ≤ A) {e : Ex HS}
    (hp : Poly e = true) (hd : dg e ≤ D) : mg V e < 2 ^ (A * D + 1) := by
  have h1 := (mg_le_dg hV hA e hp).trans (pow_le_pow' hd)
  have : 2 ^ (A * D) < 2 ^ (A * D + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

/-! ## The push loop -/

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre5
/-!
# B-line IL, pre-tables (B5), part 5: the fixed-point expressions

Register conventions (all in `rg`): `20 = P`, `21 = R`, `22 = s`, `23 = t`, `24 = λ`, `25 = α`,
`9 = 2^P`, `10 = 2^{P+1}`; `1 = c` (block start), `2 = n` (block length); work `4 = Γ`, `5 = ±1`,
`11 = X`, `12 = U` (loop index).

* `fmE x y` evaluates to `fmul P x y`, `fdE x y` to `fdiv P x y`;
* `jDE` (`α²(t-s)U²`), `jQE` (`2α²t(U+1)`), `jME`/`jPE` (`α²(t ∓ 2β_c)⁺U`) the exponent arguments
  of the tables of `mkTables` (`J6SegTab`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## Evaluation -/

theorem ev_reg {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (Ex.reg j).eval (encK s (RF v c)) = v j := top_RF h

theorem mx0_eval (t : IState HS) (x : Ex HS) : (mx0 x).eval t = max (x.eval t) 0 := by
  simp only [mx0, Ex.eval]; split_ifs with h
  · rw [max_eq_right h.le]
  · rw [max_eq_left (by omega)]

section ev
variable {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {P : ℕ}

theorem fdE_eval (h9 : v 9 = 2 ^ P) (x y : Ex HS) :
    (fdE x y).eval (encK s (RF v c)) =
      J6Seg.fdiv P (x.eval (encK s (RF v c))) (y.eval (encK s (RF v c))) := by
  simp only [fdE, NLogN.Ex.ediv_eval, Ex.eval, top_RF (show (9 : Fin HS) ∈ rg by decide), h9,
    J6Seg.fdiv, J6Seg.rq]

theorem jDE_eval {sN tN aN u : ℕ} (h22 : v 22 = sN) (h23 : v 23 = tN) (h25 : v 25 = aN)
    (h12 : v 12 = u) : jDE.eval (encK s (RF v c)) = ((aN ^ 2 * (tN - sN) * u ^ 2 : ℕ) : ℤ) := by
  simp only [jDE, Ex.eval, mx0_eval, top_RF (show (22 : Fin HS) ∈ rg by decide),
    top_RF (show (23 : Fin HS) ∈ rg by decide), top_RF (show (25 : Fin HS) ∈ rg by decide),
    top_RF (show (12 : Fin HS) ∈ rg by decide), h22, h23, h25, h12]
  rcases le_total sN tN with h | h
  · rw [max_eq_left (by omega)]; push_cast [Nat.cast_sub h]; ring
  · rw [max_eq_right (by omega), Nat.sub_eq_zero_of_le h]; simp

end ev

/-! ## Side conditions -/

/-- `ok` on the register file for expressions reading `rg` only. -/
theorem ok_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} (he : InRg e)
    (hs : Safe e = true) : e.ok (encK s (RF v c)) := by
  -- only the registers of `e` matter
  have : ∀ e : Ex HS, InRg e → Safe e = true → e.ok (encK s (RF v c)) := by
    intro e
    induction e with
    | reg j => intro h _; exact isInt_RF (h j (by simp [Ex.regs]))
    | lit _ => intro _ _; trivial
    | add a b iha ihb | mul a b iha ihb =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      exact ⟨iha (fun i hi => h i (by simp [Ex.regs, hi])) hs.1,
        ihb (fun i hi => h i (by simp [Ex.regs, hi])) hs.2⟩
    | neg a ih => intro h hs; exact ih (fun i hi => h i (by simpa [Ex.regs] using hi)) hs
    | sel c x y ihc ihx ihy =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      refine ⟨ihc (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.1, ?_⟩
      split_ifs
      · exact ihx (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.2
      · exact ihy (fun i hi => h i (by simp [Ex.regs, hi])) hs.2
    | _ => intro _ hs; simp [Safe] at hs
  exact this e he hs

theorem ok_ediv {t : IState HS} {a b : Ex HS} (ha : a.ok t) (hb : b.ok t) :
    (NLogN.Ex.ediv a b).ok t := NLogN.Ex.ediv_ok ha hb

end J6Seg.PreT

end

