-- title:
--   Finite generation from homogeneous coordinate-power relations
-- statement:
--   Positive rational weights, positive common degree, and homogeneous relations for a positive power of every coordinate imply that the polynomial ring is finite over the algebra generated by the degree-`D` forms. The proof clears weight denominators and reduces monomials until all coordinate exponents are bounded.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_homogeneous_coordinate_power_relations
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) Complex)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (hrel : ∀ i : Fin d, ∃ N : Nat, 0 < N ∧
      ∃ c : Fin m → MvPolynomial (Fin d) Complex,
        (∀ j, MvPolynomial.IsWeightedHomogeneous w (c j) (N • w i - (D : ℚ))) ∧
        MvPolynomial.X i ^ N = ∑ j : Fin m, c j * p j) :
    Module.Finite (Algebra.adjoin Complex (Set.range p)) (MvPolynomial (Fin d) Complex) := by sorry
