/-!
# Round six, item language: the entry of the general procedure

The general procedure reads the descriptor `DescG` (`dT = e`, `dP, dL, dA, dB, dC`) and creates
a register file `genD` holding `f = e / m`, `r = e mod m`, `N = q ^ f`, `q ^ r`, `N ^ m`,
`L' = L / W`, `vol A`, and the level volumes `vol (P :: L' :: A)`, `q ^ r vol B`, `q ^ r vol Cs`,
`v = vol (P :: L' :: hdShape A B' C' m N)`, `(T + W) v`, `T v` (`genE_sp`).

* `desc_split`: a state with the descriptor is a managed state over the descriptor values;
* `vEnt`: the valuation after the entry, with its values (`vEnt_vals`) and bounds.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## The register file and the descriptor -/

theorem genD_lt : ∀ i ∈ genD, i.val < 56 := by decide
theorem genD_nodup : genD.Nodup := by decide

theorem fDesc_free {e P L a b c : ℕ} {i : Fin HS} (h : i ∉ descD) : fDesc e P L a b c i = [] := by
  simp [fDesc, regState, h]

/-! ## Loops multiplying by a register -/

/-! ## The entry code -/

section Vals

variable (m q W T e P L a b c : ℕ)

theorem vPre_vals :
    vPre m q e P L a b c gF = e / m ∧ vPre m q e P L a b c gR = e % m ∧
    vPre m q e P L a b c sQQ = q ^ (e / m) ∧ vPre m q e P L a b c gQR = q ^ (e % m) ∧
    vPre m q e P L a b c kG = (q ^ (e / m)) ^ m ∧
    vPre m q e P L a b c dT = e ∧ vPre m q e P L a b c dP = P ∧ vPre m q e P L a b c dL = L ∧
    vPre m q e P L a b c dA = a ∧ vPre m q e P L a b c dB = b ∧ vPre m q e P L a b c dC = c := by
  simp +decide [vPre, entA1, evalA, NE.val, Function.update_apply, vDesc]

theorem vEnt_vals :
    vEnt m q W T e P L a b c gF = e / m ∧ vEnt m q W T e P L a b c gR = e % m ∧
    vEnt m q W T e P L a b c sQQ = q ^ (e / m) ∧ vEnt m q W T e P L a b c gQR = q ^ (e % m) ∧
    vEnt m q W T e P L a b c kG = (q ^ (e / m)) ^ m ∧
    vEnt m q W T e P L a b c dT = e ∧ vEnt m q W T e P L a b c dP = P ∧
    vEnt m q W T e P L a b c dL = L ∧ vEnt m q W T e P L a b c dA = a ∧
    vEnt m q W T e P L a b c dB = b ∧ vEnt m q W T e P L a b c dC = c ∧
    vEnt m q W T e P L a b c rLp = L / W ∧ vEnt m q W T e P L a b c gA = a ∧
    vEnt m q W T e P L a b c rXs = P * (L / W) * a ∧
    vEnt m q W T e P L a b c rVB = q ^ (e % m) * b ∧
    vEnt m q W T e P L a b c rVC = q ^ (e % m) * c ∧
    vEnt m q W T e P L a b c rV = volE m q W e P L a b c ∧
    vEnt m q W T e P L a b c rWV = (T + W) * volE m q W e P L a b c ∧
    vEnt m q W T e P L a b c gTV = T * volE m q W e P L a b c := by
  obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11⟩ := vPre_vals m q e P L a b c
  simp +decide only [vEnt, entA2, evalA, NE.val, Function.update_apply, volE, p1, p2, p3, p4, p5,
    p6, p7, p8, p9, p10, p11, if_true, if_false]

end Vals

theorem EntB.bounds {m q W T e P L a b c M : ℕ} (h : EntB m q W T e P L a b c M) :
    ∀ i ∈ genD, vEnt m q W T e P L a b c i ≤ M := by
  obtain ⟨v1, v2, v3, v4, v5, -, -, -, -, -, -, v12, v13, v14, v15, v16, v17, v18, v19⟩ :=
    vEnt_vals m q W T e P L a b c
  have hN1 : 1 ≤ q ^ (e / m) := Nat.one_le_pow _ _ (by have := h.q1; omega)
  have hNN : q ^ (e / m) ≤ (q ^ (e / m)) ^ m := Nat.le_self_pow (by have := h.m1; omega) _
  have hr1 : 1 ≤ q ^ (e % m) := Nat.one_le_pow _ _ (by have := h.q1; omega)
  have hqr : q ^ (e % m) ≤ q ^ (e % m) * b := Nat.le_mul_of_pos_right _ h.b1
  have hV : volE m q W e P L a b c ≤ (T + W) * volE m q W e P L a b c :=
    Nat.le_mul_of_pos_left _ (by have := h.W1; omega)
  have hTV : T * volE m q W e P L a b c ≤ (T + W) * volE m q W e P L a b c :=
    Nat.mul_le_mul_right _ (by omega)
  have hX : P * (L / W) * a ≤ volE m q W e P L a b c := by
    unfold volE
    have h1 : 1 ≤ (q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m * (q ^ (e % m) * c) :=
      Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.one_le_pow _ _ hN1) (Nat.mul_pos hr1 h.b1))
        (Nat.one_le_pow _ _ hN1)) (Nat.mul_pos hr1 h.c1)
    calc P * (L / W) * a = P * (L / W) * a * 1 := (mul_one _).symm
      _ ≤ P * (L / W) * a * ((q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m *
          (q ^ (e % m) * c)) := Nat.mul_le_mul_left _ h1
      _ = _ := by ring
  have hLW : L / W ≤ L := Nat.div_le_self _ _
  have hd := h.desc
  intro i hi
  simp only [genD, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [v3]; have := h.Nm; omega
  · rw [v2]; have := Nat.mod_le e m; omega
  · rw [v4]; have := h.qb; omega
  · rw [v14]; have := h.vv; omega
  · rw [v5]; exact h.Nm
  · rw [v15]; exact h.qb
  · rw [v16]; exact h.qc
  · rw [v17]; have := h.vv; omega
  · rw [v18]; exact h.vv
  · rw [v12]; omega
  · rw [v19]; have := h.vv; omega
  · rw [v13]; omega
  · rw [v1]; have := Nat.div_le_self e m; omega

/-! ## The entry specification -/

end

end IntMul.Kappa.R6.IL

end

