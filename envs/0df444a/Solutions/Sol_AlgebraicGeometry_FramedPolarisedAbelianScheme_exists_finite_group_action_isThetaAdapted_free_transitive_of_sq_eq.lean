theorem solution
    (g N n : ℕ) (δ : Fin g → ℕ) [hδ : ∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = N + 1)
    (e : Fin (N + 1) ≃ ((i : Fin g) → ZMod (δ i)))
    (hn : 3 ≤ n) (B : Type) [CommRing B] (hn' : IsUnit ((n : ℕ) : B)) (hd : IsUnit ((N + 1 : ℕ) : B))
    (ζ : B) (hζ : ζ ^ (N + 1) = 1) (hζu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - ζ ^ j))
    (ω : B) (hω : ω ^ 2 = ζ) :
    ∃ (Γ : Type) (_ : Group Γ) (_ : Fintype Γ)
      (act : ∀ (S : Type) [CommRing S], (Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) → Γ →
        FramedPolarisedAbelianScheme g N n S → FramedPolarisedAbelianScheme g N n S),
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : Γ)
          (X : FramedPolarisedAbelianScheme g N n S),
          (act S s γ X).toPolarisedAbelianScheme = X.toPolarisedAbelianScheme) ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : Γ)
          (X : FramedPolarisedAbelianScheme g N n S),
          X.IsThetaAdapted δ e → (act S s γ X).IsThetaAdapted δ e) ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B))
          (X : FramedPolarisedAbelianScheme g N n S),
          FramedPolarisedAbelianScheme.Iso (act S s 1 X) X) ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ γ' : Γ)
          (X : FramedPolarisedAbelianScheme g N n S),
          FramedPolarisedAbelianScheme.Iso (act S s (γ * γ') X) (act S s γ (act S s γ' X))) ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : Γ)
          (X X' : FramedPolarisedAbelianScheme g N n S),
          FramedPolarisedAbelianScheme.Iso X X' → FramedPolarisedAbelianScheme.Iso (act S s γ X) (act S s γ X')) ∧
      (∀ (S S' : Type) [CommRing S] [CommRing S'] (φ : S →+* S')
          (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (s' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of B)),
          Spec.map (CommRingCat.ofHom φ) ≫ s = s' →
          ∀ (γ : Γ) (X : FramedPolarisedAbelianScheme g N n S) (X' : FramedPolarisedAbelianScheme g N n S'),
          FramedPolarisedAbelianScheme.IsPullback φ X X' → FramedPolarisedAbelianScheme.IsPullback φ (act S s γ X) (act S' s' γ X')) ∧
      (∀ (S : Type) [CommRing S] [Nontrivial S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : Γ)
          (X : FramedPolarisedAbelianScheme g N n S),
          X.IsThetaAdapted δ e → FramedPolarisedAbelianScheme.Iso (act S s γ X) X → γ = 1) ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B))
          (X X' : FramedPolarisedAbelianScheme g N n S),
          X.IsThetaAdapted δ e → X'.IsThetaAdapted δ e →
          PolarisedAbelianScheme.Iso X.toPolarisedAbelianScheme X'.toPolarisedAbelianScheme →
          ∃ (m : ℕ) (r : Fin m → S), Ideal.span (Set.range r) = ⊤ ∧ ∀ (j : Fin m)
            (Y Y' : FramedPolarisedAbelianScheme g N n (Localization.Away (r j))),
            FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X Y →
            FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X' Y' →
            ∃ γ : Γ, FramedPolarisedAbelianScheme.Iso
              (act (Localization.Away (r j)) (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r j)))) ≫ s) γ Y) Y') := by
  classical

  have hunitB : ∀ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), IsUnit (Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1)) := by
    intro γ
    rw [Matrix.isUnit_transpose]
    exact (ThetaLevel.isIntertwiner_inter δ (N + 1) B ω e ((γ)⁻¹).1
      (AlgebraicGeometry.ThetaLevel.exists_isIntertwiner_of_mem_gam δ (N + 1) hδd B hd ζ ω hζ hζu hω e (γ⁻¹).1 (γ⁻¹).2)).1
  have hint : ∀ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), ∃ U : Matrix (Fin (N + 1)) (Fin (N + 1)) B, ThetaLevel.IsIntertwiner δ (N + 1) B ω e γ.1 U :=
    fun γ => AlgebraicGeometry.ThetaLevel.exists_isIntertwiner_of_mem_gam δ (N + 1) hδd B hd ζ ω hζ hζu hω e γ.1 γ.2

  have hpre : ∀ {S S' : Type} [CommRing S] [CommRing S'] (ψ : S →+* S')
      (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
      (Spec.preimage (Spec.map (CommRingCat.ofHom ψ) ≫ s)).hom = ψ.comp (Spec.preimage s).hom := by
    intro S S' _ _ ψ s
    have h1 : Spec.preimage (Spec.map (CommRingCat.ofHom ψ) ≫ s) = Spec.preimage s ≫ CommRingCat.ofHom ψ := by
      apply Spec.map_injective
      rw [Spec.map_preimage, Spec.map_comp, Spec.map_preimage]
    rw [h1, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
  let M : ∀ (S : Type) [CommRing S], (Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) → (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)) →
      Matrix (Fin (N + 1)) (Fin (N + 1)) S :=
    fun S _ s γ => (Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1)).map (Spec.preimage s).hom
  have hMunit : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1))),
      IsUnit (M S s γ) := by
    intro S _ s γ
    exact (hunitB γ).map (Spec.preimage s).hom.mapMatrix
  have hMcomp : ∀ {S S' : Type} [CommRing S] [CommRing S'] (ψ : S →+* S')
      (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1))),
      (M S s γ).map ψ = M S' (Spec.map (CommRingCat.ofHom ψ) ≫ s) γ := by
    intro S S' _ _ ψ s γ
    simp only [M, hpre, Matrix.map_map, RingHom.coe_comp]
  let act : ∀ (S : Type) [CommRing S], (Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) → (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)) →
      FramedPolarisedAbelianScheme g N n S → FramedPolarisedAbelianScheme g N n S :=
    fun S _ s γ X => (AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe X (M S s γ) (hMunit S s γ)).choose
  have hact : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)) (γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)))
      (X : FramedPolarisedAbelianScheme g N n S), X.IsReframe (M S s γ) (act S s γ X) :=
    fun S _ s γ X => (AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe X (M S s γ) (hMunit S s γ)).choose_spec
  refine ⟨(ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), inferInstance, inferInstance, act, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro S _ s γ X
    obtain ⟨P', h₁, h₂, hX', -⟩ := hact S s γ X
    rw [hX']
  · intro S _ s γ X hX
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.isThetaAdapted_of_isReframe_inter g N n δ hδd e B hd ζ hζ hζu ω hω
      (Spec.preimage s).hom γ X (act S s γ X) (hact S s γ X) hX
  · intro S _ s X
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_isReframe_inter_one g N n δ hδd e B hd ζ hζ hζu ω hω
      (Spec.preimage s).hom X (act S s 1 X) (hact S s 1 X)
  · intro S _ s γ γ' X
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_isReframe_inter_mul g N n δ hδd e B hd ζ hζ hζu ω hω
      (Spec.preimage s).hom γ γ' X (act S s (γ * γ') X) (act S s γ' X) (act S s γ (act S s γ' X))
      (hact S s (γ * γ') X) (hact S s γ' X) (hact S s γ (act S s γ' X))
  · intro S _ s γ X X' h
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_iso_of_isReframe (M S s γ) X X' (act S s γ X) (act S s γ X')
      h (hact S s γ X) (hact S s γ X')
  · intro S S' _ _ φ s s' hs γ X X' h
    have hre' : X'.IsReframe ((M S s γ).map φ) (act S' s' γ X') := by
      rw [hMcomp φ s γ, hs]
      exact hact S' s' γ X'
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.isPullback_of_isPullback_of_isReframe φ (M S s γ) X (act S s γ X)
      X' (act S' s' γ X') h (hact S s γ X) hre'
  · intro S _ _ s γ X hX hiso
    exact AlgebraicGeometry.FramedPolarisedAbelianScheme.eq_one_of_isReframe_inter_of_iso g N n δ hδd e B hd ζ hζ hζu ω hω
      hn hn' hint (Spec.preimage s).hom γ X (act S s γ X) hX (hact S s γ X) hiso
  · intro S _ s X X' hX hX' hiso
    obtain ⟨m, r, hr, hloc⟩ :=
      AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_cover_isReframe_inter_iso_of_isThetaAdapted_of_iso g N n δ hδd e B hd
        ζ hζ hζu ω hω hn hn' hint (Spec.preimage s).hom X X' hX hX' hiso
    refine ⟨m, r, hr, fun j Y Y' hY hY' => ?_⟩
    obtain ⟨γ, hγ⟩ := hloc j Y Y' hY hY'
    refine ⟨γ, hγ _ ?_⟩
    have := hact (Localization.Away (r j)) (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r j)))) ≫ s) γ Y
    rw [← hMcomp] at this
    exact this

