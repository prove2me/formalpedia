noncomputable section

namespace Esgk

open PachDeZeeuw.Algebraic


def HasCircularMultiplicityAtLeast (D m : ℕ) (f : PlanePoly) : Prop :=
  projectiveCircularChartI (planeHomogenization D f) ∈
      MvPolynomial.idealOfVars (Fin 2) ℂ ^ m ∧
    projectiveCircularChartJ (planeHomogenization D f) ∈
      MvPolynomial.idealOfVars (Fin 2) ℂ ^ m


end Esgk


