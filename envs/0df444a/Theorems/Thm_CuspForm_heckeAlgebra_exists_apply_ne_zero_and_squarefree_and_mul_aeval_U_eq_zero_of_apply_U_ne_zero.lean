-- title:
--   Monic squarefree relation for Uₚ at p ∥ N, ordinary case
-- statement:
--   Let $N \ge 1$ be a natural number and $S_0$ a set of natural numbers, and let $\mathbb{T} =$ [`CuspForm.heckeAlgebra N 2 S₀`](def/CuspForm_HeckeAlgebra.html#L18) be the $\mathbb{Z}$-subalgebra of $\operatorname{End}_{\mathbb{C}} S_2(\Gamma_0(N))$ generated by the Hecke operators `heckeTLin` attached to primes $\ell \nmid N$ with $\ell \notin S_0$ together with the operators `heckeULin` attached to primes $q \mid N$ with $q \notin S_0$. Let $k$ be a field and $\theta' : \mathbb{T} \to k$ a ring homomorphism. Let $p$ be a prime with $p = 0$ in $k$, $p \mid N$, $p^2 \nmid N$ and $p \notin S_0$, and write $U_p \in \mathbb{T}$ for the element [`CuspForm.heckeAlgebra.U`](def/CuspForm_HeckeAlgebra.html#L80) given by the operator `heckeULin` at $p$. Assume $\theta'(U_p) \ne 0$. The conclusion is that there exist an element $r \in \mathbb{T}$ and a polynomial $P \in \mathbb{Z}[X]$ such that $\theta'(r) \ne 0$, $P$ is monic, the image of $P$ in $\mathbb{Q}[X]$ under the coefficientwise map $\mathbb{Z} \to \mathbb{Q}$ is squarefree, and $r \cdot P(U_p) = 0$ in $\mathbb{T}$, where $P(U_p)$ denotes the evaluation of $P$ at $U_p$ in the $\mathbb{Z}$-algebra $\mathbb{T}$.
--
--   This is the ordinary-case ($\theta'(U_p) \ne 0$) contribution, at a prime exactly dividing the level, to the reducedness of the localisation of the weight-two Hecke algebra at $\theta'$: after inverting $r$, which becomes a unit in the local ring, $U_p$ is annihilated by a monic integral polynomial that is squarefree over $\mathbb{Q}$. It is used in the proof of [`CuspForm.heckeLocal.isReduced_of_charpoly_frobenius_eq_of_isAbsolutelyIrreducible`](thm.html#CuspForm.heckeLocal.isReduced_of_charpoly_frobenius_eq_of_isAbsolutelyIrreducible).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_heckeAlgebra_exists_apply_ne_zero_and_squarefree_and_mul_aeval_U_eq_zero_of_apply_U_ne_zero.lean

import Definitions.Def_CuspForm_HeckeAlgebra
import Definitions.Def_CuspForm_IntegralStructure
import Mathlib.Algebra.Squarefree.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Polynomial

theorem CuspForm.heckeAlgebra.exists_apply_ne_zero_and_squarefree_and_mul_aeval_U_eq_zero_of_apply_U_ne_zero
    (N : ℕ) [NeZero N] (S₀ : Set ℕ)
    {k : Type} [Field k] (θ' : CuspForm.heckeAlgebra N 2 S₀ →+* k)
    (p : ℕ) (hp : p.Prime) (hpk : (p : k) = 0) (hpN : p ∣ N) (hNp : ¬ p ^ 2 ∣ N) (hpS₀ : p ∉ S₀)
    (hUp : θ' (CuspForm.heckeAlgebra.U hp hpN hpS₀) ≠ 0) :
    ∃ (r : CuspForm.heckeAlgebra N 2 S₀) (P : ℤ[X]),
      θ' r ≠ 0 ∧ P.Monic ∧ Squarefree (P.map (Int.castRingHom ℚ)) ∧
      r * aeval (CuspForm.heckeAlgebra.U hp hpN hpS₀) P = 0 := by sorry
