-- BEGIN Solutions.SingleCycleCountReindex
section
namespace SingleCycleCount

open Classical WeldedPath.SingleCycleGraph

theorem filter_card_equiv {α β : Type*} [Fintype α] [Fintype β]
    (e : α ≃ β) (P : β → Prop) :
    (Finset.univ.filter fun x => P (e x)).card = (Finset.univ.filter P).card := by
  apply Finset.card_bij (fun x _ => e x)
  · intro x hx
    simpa only [Finset.mem_filter, Finset.mem_univ, true_and] using hx
  · intro x _ y _ h
    exact e.injective h
  · intro y hy
    refine ⟨e.symm y, ?_, e.apply_symm_apply y⟩
    simpa only [Finset.mem_filter, Finset.mem_univ, true_and,
      e.apply_symm_apply] using hy

theorem matchingGraph_reindex {α β V : Type*} (e : α ≃ β)
    (K : SimpleGraph V) (a b : β → V) :
    matchingGraph K (fun i => a (e i)) (fun i => b (e i)) = matchingGraph K a b := by
  apply SimpleGraph.ext
  funext x y
  apply propext
  simp only [matchingGraph, SimpleGraph.sup_adj, SimpleGraph.fromRel_adj]
  have hex (x y : V) : (∃ i : α, x = a (e i) ∧ y = b (e i)) ↔
      ∃ j : β, x = a j ∧ y = b j := by
    constructor
    · rintro ⟨i, hi⟩
      exact ⟨e i, hi⟩
    · rintro ⟨j, hj⟩
      exact ⟨e.symm j, by simpa only [e.apply_symm_apply] using hj⟩
  rw [hex x y, hex y x]

noncomputable def transportPerm {α β : Type*} (e : α ≃ β) (θ : Equiv.Perm α) :
    Equiv.Perm β := (e.symm.trans θ).trans e

theorem transportPerm_apply {α β : Type*} (e : α ≃ β) (θ : Equiv.Perm α) (i : α) :
    transportPerm e θ (e i) = e (θ i) := by
  simp [transportPerm]

theorem matchingGraph_transport {α β V : Type*} (e : α ≃ β)
    (K : SimpleGraph V) (a b : β → V) (θ : Equiv.Perm α) :
    matchingGraph K (fun i => a (e i)) (fun i => b (e (θ i))) =
      matchingGraph K a (fun j => b (transportPerm e θ j)) := by
  rw [← matchingGraph_reindex e K a (fun j => b (transportPerm e θ j))]
  congr 1
  funext i
  rw [transportPerm_apply]

end SingleCycleCount
end
-- END Solutions.SingleCycleCountReindex

-- BEGIN Solutions.SingleCycleResidualPerm
section
namespace WeldedPath.SingleCycleCounting

open Classical

variable {E K : Type*} [Fintype E]

noncomputable def residualLift (R : Finset E) (π₀ : Equiv.Perm E)
    (θ : Equiv.Perm R) : Equiv.Perm E := (Equiv.Perm.ofSubtype θ).trans π₀

theorem residualLift_off (R : Finset E) (π₀ : Equiv.Perm E) (θ : Equiv.Perm R)
    {e : E} (he : e ∉ R) : residualLift R π₀ θ e = π₀ e := by
  simp [residualLift, Equiv.Perm.ofSubtype_apply_of_not_mem θ he]

theorem residualLift_on (R : Finset E) (π₀ : Equiv.Perm E) (θ : Equiv.Perm R)
    (e : R) : residualLift R π₀ θ e.1 = π₀ (θ e).1 := by
  simp [residualLift, Equiv.Perm.ofSubtype_apply_of_mem θ e.2]

theorem residualLift_value_iff (R : Finset E) (π₀ : Equiv.Perm E) (θ : Equiv.Perm R)
    (e z : R) : residualLift R π₀ θ e.1 = π₀ z.1 ↔ θ e = z := by
  rw [residualLift_on, π₀.injective.eq_iff, Subtype.ext_iff]

theorem residualLift_injective (R : Finset E) (π₀ : Equiv.Perm E) :
    Function.Injective (residualLift R π₀) := by
  intro θ ψ heq
  apply Equiv.Perm.ofSubtype_injective
  ext x
  apply π₀.injective
  exact congrArg (fun π : Equiv.Perm E => π x) heq

theorem residualLift_surjective (R : Finset E) (π₀ π : Equiv.Perm E)
    (hπ : ∀ e ∉ R, π e = π₀ e) :
    ∃ θ : Equiv.Perm R, residualLift R π₀ θ = π := by
  let δ : Equiv.Perm E := π.trans π₀.symm
  have hs : (δ.support : Set E) ⊆ Set.ofPred (fun e => e ∈ R) := by
    intro e he
    by_contra heR
    have hfix : δ e = e := by simp [δ, hπ e heR]
    exact (Equiv.Perm.mem_support.mp he) hfix
  obtain ⟨θ, hθ⟩ := Equiv.Perm.mem_range_ofSubtype_iff.mpr hs
  refine ⟨θ, ?_⟩
  ext e
  simp only [residualLift, Equiv.trans_apply]
  rw [hθ]
  simp [δ]

noncomputable def residualEquiv (R : Finset E) (π₀ : Equiv.Perm E) :
    Equiv.Perm R ≃ {π : Equiv.Perm E // ∀ e ∉ R, π e = π₀ e} :=
  Equiv.ofBijective (fun θ => ⟨residualLift R π₀ θ, fun _ he => residualLift_off R π₀ θ he⟩)
    ⟨fun θ ψ heq => residualLift_injective R π₀ (congrArg Subtype.val heq),
      fun ⟨π, hπ⟩ => by
        obtain ⟨θ, hθ⟩ := residualLift_surjective R π₀ π hπ
        exact ⟨θ, Subtype.ext hθ⟩⟩

theorem residual_predicate_card (R : Finset E) (π₀ : Equiv.Perm E)
    (P : Equiv.Perm E → Prop) :
    (Finset.univ.filter fun θ : Equiv.Perm R => P (residualLift R π₀ θ)).card =
      (Finset.univ.filter fun π : Equiv.Perm E => (∀ e ∉ R, π e = π₀ e) ∧ P π).card := by
  apply Finset.card_bij (fun θ _ => residualLift R π₀ θ)
  · intro θ hθ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hθ ⊢
    exact ⟨fun e he => residualLift_off R π₀ θ he, hθ⟩
  · intro θ _ ψ _ heq
    exact residualLift_injective R π₀ heq
  · intro π hπ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hπ
    obtain ⟨θ, hθ⟩ := residualLift_surjective R π₀ π hπ.1
    refine ⟨θ, ?_, hθ⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, hθ, hπ.2]

theorem residualLift_preserves_block (block : E → K) (R : Finset E)
    (hR : ∀ e ∈ R, ∀ f ∈ R, block e = block f)
    (π₀ : Equiv.Perm E) (hπ : π₀ ∈ FinitePermutationCoupling.blockSupport block)
    (θ : Equiv.Perm R) : residualLift R π₀ θ ∈ FinitePermutationCoupling.blockSupport block := by
  have hb := (Finset.mem_filter.mp hπ).2
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _, ?_⟩
  intro e
  by_cases he : e ∈ R
  · rw [residualLift_on R π₀ θ ⟨e, he⟩, hb]
    exact hR _ (θ ⟨e, he⟩).2 e he
  · rw [residualLift_off R π₀ θ he, hb]

end WeldedPath.SingleCycleCounting
end
-- END Solutions.SingleCycleResidualPerm

-- BEGIN Solutions.SingleCyclePartition
section
namespace WeldedPath.SingleCycleCounting

open Classical
open scoped BigOperators

theorem partition_cap {X Y : Type*} (C : Finset X) (f : X → Y)
    (P : X → Prop) (k : ℕ)
    (hcap : ∀ y ∈ C.image f,
      k * (((C.filter fun x => f x = y).filter P).card) ≤
        (C.filter fun x => f x = y).card) :
    k * (C.filter P).card ≤ C.card := by
  have htotal := Finset.card_eq_sum_card_fiberwise
    (fun x hx => Finset.mem_image.mpr ⟨x, hx, rfl⟩ : (C : Set X).MapsTo f (C.image f))
  have hpart : (C.filter P).card =
      ∑ y ∈ C.image f, ((C.filter fun x => f x = y).filter P).card := by
    have hh := Finset.card_eq_sum_card_fiberwise
      (fun x hx => Finset.mem_image.mpr ⟨x, (Finset.mem_filter.mp hx).1, rfl⟩ :
        ((C.filter P) : Set X).MapsTo f (C.image f))
    simpa only [Finset.filter_filter, and_comm] using hh
  rw [hpart, htotal, Finset.mul_sum]
  exact Finset.sum_le_sum hcap

end WeldedPath.SingleCycleCounting
end
-- END Solutions.SingleCyclePartition

-- BEGIN Solutions.SingleCycleCountResidual
section
namespace WeldedPath.SingleCycleCounting

open Classical SingleCycleCount

variable {E V : Type*} [Fintype E] [DecidableEq E] [DecidableEq V]

theorem residual_filter_card (C : Finset (Equiv.Perm E)) (R : Finset E)
    (π₀ : Equiv.Perm E) (P : Equiv.Perm E → Prop) :
    (Finset.univ.filter fun θ : Equiv.Perm R =>
      residualLift R π₀ θ ∈ C ∧ P (residualLift R π₀ θ)).card =
    ((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter P).card := by
  classical
  apply Finset.card_bij (fun θ _ => residualLift R π₀ θ)
  · intro θ hθ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hθ ⊢
    exact ⟨⟨hθ.1, fun e he => residualLift_off R π₀ θ he⟩, hθ.2⟩
  · intro θ _ ψ _ h
    exact residualLift_injective R π₀ h
  · intro π hπ
    simp only [Finset.mem_filter] at hπ
    obtain ⟨θ, rfl⟩ := residualLift_surjective R π₀ π hπ.1.2
    refine ⟨θ, ?_, rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hπ.1.1, hπ.2⟩

theorem residual_completion_cap (C : Finset (Equiv.Perm E)) (R : Finset E)
    (π₀ : Equiv.Perm E) (a b : R → V)
    (hports : ∀ c, (Finset.univ.filter (fun i => a i = c)).card +
      (Finset.univ.filter (fun i => b i = c)).card = 2)
    (hcompletion : ∀ θ : Equiv.Perm R,
      residualLift R π₀ θ ∈ C ↔ θ ∈ completionSet a b)
    (u : R) (z : E) :
    (R.card - 1) * (((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter
      fun π => π u.1 = z).card) ≤
      (C.filter fun π => ∀ e ∉ R, π e = π₀ e).card := by
  classical
  have htotal : (completionSet a b).card =
      (C.filter fun π => ∀ e ∉ R, π e = π₀ e).card := by
    classical
    have hh := residual_filter_card C R π₀ (fun _ => True)
    convert hh using 1
    · congr 1
      ext θ
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_true, hcompletion]
    · simp only [Finset.filter_true]
  have hpart : (Finset.univ.filter fun θ : Equiv.Perm R =>
      residualLift R π₀ θ ∈ C ∧ residualLift R π₀ θ u.1 = z).card =
      ((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter fun π => π u.1 = z).card := by
    convert residual_filter_card C R π₀ (fun π => π u.1 = z) using 1 <;>
      congr 1 <;> ext θ <;> simp only [Finset.mem_filter]
  by_cases hz : π₀.symm z ∈ R
  · let v : R := ⟨π₀.symm z, hz⟩
    have hv : π₀ v.1 = z := π₀.apply_symm_apply z
    have hvalue (θ : Equiv.Perm R) : residualLift R π₀ θ u.1 = z ↔ θ u = v := by
      classical
      rw [← hv, residualLift_value_iff]
    have hf : (Finset.univ.filter fun θ : Equiv.Perm R =>
        residualLift R π₀ θ ∈ C ∧ residualLift R π₀ θ u.1 = z) =
        partnerFiber (completionSet a b) u v := by
      classical
      ext θ
      simp only [Finset.mem_filter, Finset.mem_univ, true_and,
        mem_partnerFiber, hcompletion, hvalue]
    rw [hf] at hpart
    rw [← hpart, ← htotal]
    simpa only [Fintype.card_coe] using completionSet_partner_cap a b hports u v
  · have hempty : (Finset.univ.filter fun θ : Equiv.Perm R =>
        residualLift R π₀ θ ∈ C ∧ residualLift R π₀ θ u.1 = z) = ∅ := by
      classical
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro θ hθ
      have hv := (Finset.mem_filter.mp hθ).2.2
      rw [residualLift_on] at hv
      have heq : (θ u).1 = π₀.symm z := π₀.eq_symm_apply.mpr hv
      exact hz (heq ▸ (θ u).2)
    rw [hempty, Finset.card_empty] at hpart
    rw [← hpart]
    simp

theorem residual_partition_cap (C : Finset (Equiv.Perm E)) (R : Finset E)
    (u z : E) (k : ℕ)
    (hcap : ∀ π₀ ∈ C,
      k * (((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter
        fun π => π u = z).card) ≤
        (C.filter fun π => ∀ e ∉ R, π e = π₀ e).card) :
    k * (C.filter fun π => π u = z).card ≤ C.card := by
  classical
  letI : DecidableEq ({e : E // e ∉ R} → E) := Classical.decEq _
  let f : Equiv.Perm E → ({e : E // e ∉ R} → E) := fun π e => π e.1
  have hresult := partition_cap C f (fun π => π u = z) k (by
    intro y hy
    obtain ⟨π₀, hπ₀, hπ₀y⟩ := Finset.mem_image.mp hy
    have hf (π : Equiv.Perm E) : f π = y ↔ ∀ e ∉ R, π e = π₀ e := by
      rw [← hπ₀y]
      constructor
      · intro h e he
        exact congrFun h ⟨e, he⟩
      · intro h
        funext e
        exact h e.1 e.2
    convert hcap π₀ hπ₀ using 1 <;> congr 1 <;> congr 1 <;>
      ext π <;> simp only [Finset.mem_filter, hf])
  convert hresult using 1 <;> congr 1 <;> congr 1 <;>
    ext π <;> simp only [Finset.mem_filter]

end WeldedPath.SingleCycleCounting
end
-- END Solutions.SingleCycleCountResidual

-- BEGIN Solutions.WeldedPathGraphDepth
section
namespace WeldedPath.LoopProof

lemma pow_root_ge_two (n : ℕ) : 2 ≤ 2 ^ (n + 1) := by
  have h := Nat.two_pow_pos n
  rw [pow_succ]
  omega

lemma numV_eq (n : ℕ) : numV n = 2 * (2 ^ (n + 1) - 1) := by
  have h := pow_root_ge_two n
  unfold numV
  rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
  omega

lemma col_zero (n : ℕ) : col n 0 = 0 := by
  have h := pow_root_ge_two n
  simp [col, show 0 < 2 ^ (n + 1) - 1 by omega]

lemma col_exit (n : ℕ) : col n (exitIdx n) = 2 * n + 1 := by
  simp [col, exitIdx]

lemma log_left_le (n v : ℕ) (hv : v < 2 ^ (n + 1) - 1) :
    Nat.log 2 (v + 1) ≤ n := by
  have h : v + 1 < 2 ^ (n + 1) := by omega
  have := (Nat.log_lt_iff_lt_pow (by decide : 1 < 2) (by omega : v + 1 ≠ 0)).2 h
  omega

lemma log_right_le (n v : ℕ) (hv : IsVertex n v) (hr : 2 ^ (n + 1) - 1 ≤ v) :
    Nat.log 2 (v - (2 ^ (n + 1) - 1) + 1) ≤ n := by
  have hn := pow_root_ge_two n
  rw [IsVertex, numV_eq] at hv
  have h : v - (2 ^ (n + 1) - 1) + 1 < 2 ^ (n + 1) := by omega
  have := (Nat.log_lt_iff_lt_pow (by decide : 1 < 2)
    (by omega : v - (2 ^ (n + 1) - 1) + 1 ≠ 0)).2 h
  omega

lemma col_left_le (n v : ℕ) (hv : v < 2 ^ (n + 1) - 1) : col n v ≤ n := by
  simpa [col, hv] using log_left_le n v hv

lemma col_right_ge (n v : ℕ) (hv : IsVertex n v) (hr : 2 ^ (n + 1) - 1 ≤ v) :
    n + 1 ≤ col n v := by
  have hd := log_right_le n v hv hr
  simp only [col, if_neg (by omega : ¬ v < 2 ^ (n + 1) - 1)]
  omega

lemma col_bounds (n v : ℕ) (hv : IsVertex n v) : col n v ≤ 2 * n + 1 := by
  by_cases h : v < 2 ^ (n + 1) - 1
  · have := col_left_le n v h
    omega
  · simp only [col, if_neg h]
    omega

lemma parent_spec {n v p : ℕ} (hp : parent n v = some p) :
    IsVertex n v ∧ IsVertex n p ∧
      ((col n p + 1 = col n v ∧ col n v ≤ n) ∨
        (col n v + 1 = col n p ∧ n + 1 ≤ col n v)) := by
  have hb := pow_root_ge_two n
  unfold parent at hp
  split at hp
  next h =>
    have hv := h.1
    have hvleft : v < 2 ^ (n + 1) - 1 := by
      by_contra hh
      have := col_right_ge n v hv (by omega)
      omega
    have hvpos : 1 ≤ v := by
      by_contra hh
      have heq : v = 0 := by omega
      subst v
      simp [col_zero] at h
    have hpval : p = (v - 1) / 2 := by simpa using hp.symm
    have hpv : p < v := by omega
    have hpV : IsVertex n p := by unfold IsVertex at *; omega
    have hpleft : p < 2 ^ (n + 1) - 1 := by omega
    have hdiv : p + 1 = (v + 1) / 2 := by omega
    have hlog : Nat.log 2 (p + 1) = Nat.log 2 (v + 1) - 1 := by
      rw [hdiv, Nat.log_div_base]
    have hcols : col n p + 1 = col n v := by
      simp only [col, if_pos hvleft] at h
      simp only [col, if_pos hpleft, if_pos hvleft]
      omega
    exact ⟨hv, hpV, Or.inl ⟨hcols, h.2.2⟩⟩
  next h =>
    split at hp
    next h' =>
      have hv := h'.1
      have hvright : 2 ^ (n + 1) - 1 ≤ v := by
        by_contra hh
        have := col_left_le n v (by omega)
        omega
      have hvroot : v ≠ 2 ^ (n + 1) - 1 := by
        intro heq
        have hc : col n v = 2 * n + 1 := by
          simpa [heq, exitIdx] using col_exit n
        omega
      have hvbig : 2 ^ (n + 1) ≤ v := by omega
      have hpval : p = (v - 2 ^ (n + 1)) / 2 + 2 ^ (n + 1) - 1 := by
        simpa using hp.symm
      have hpv : p < v := by omega
      have hpV : IsVertex n p := by unfold IsVertex at *; omega
      have hpright : 2 ^ (n + 1) - 1 ≤ p := by omega
      have hdiv : p - (2 ^ (n + 1) - 1) + 1 =
          (v - (2 ^ (n + 1) - 1) + 1) / 2 := by omega
      have hlog : Nat.log 2 (p - (2 ^ (n + 1) - 1) + 1) =
          Nat.log 2 (v - (2 ^ (n + 1) - 1) + 1) - 1 := by
        rw [hdiv, Nat.log_div_base]
      have hd := log_right_le n v hv hvright
      have hdpos : 1 ≤ Nat.log 2 (v - (2 ^ (n + 1) - 1) + 1) := by
        have := Nat.log_pos (by decide : 1 < 2)
          (show 2 ≤ v - (2 ^ (n + 1) - 1) + 1 by omega)
        omega
      have hcols : col n v + 1 = col n p := by
        simp only [col, if_neg (by omega : ¬ v < 2 ^ (n + 1) - 1),
          if_neg (by omega : ¬ p < 2 ^ (n + 1) - 1)]
        omega
      exact ⟨hv, hpV, Or.inr ⟨hcols, h'.2.1⟩⟩
    next h' => simp at hp

lemma parent_eq_exit_imp {n v : ℕ} (hp : parent n v = some (exitIdx n)) :
    v = 2 ^ (n + 1) ∨ v = 2 ^ (n + 1) + 1 := by
  have hs := parent_spec hp
  have hc := col_exit n
  have hb := pow_root_ge_two n
  unfold parent at hp
  split at hp
  next h =>
    rcases hs.2.2 with hleft | hright <;> omega
  next h =>
    split at hp
    next h' =>
      have hvright : 2 ^ (n + 1) - 1 ≤ v := by
        by_contra hh
        have := col_left_le n v (by omega)
        omega
      have hvroot : v ≠ 2 ^ (n + 1) - 1 := by
        intro heq
        have hc' : col n v = 2 * n + 1 := by simpa [heq, exitIdx] using col_exit n
        omega
      simp only [Option.some.injEq, exitIdx] at hp
      omega
    next h' => simp at hp

lemma tree_mem_iff {n : ℕ} {G : WeldedInstance n} {v : ℕ} :
    Edge.tree v ∈ G.edges ↔ IsVertex n v ∧ (parent n v).isSome := by
  simp [WeldedInstance.edges, WeldedInstance.treeEdges, WeldedInstance.weldEdges, IsVertex]

lemma weld_mem_iff {n : ℕ} {G : WeldedInstance n} {u w : ℕ} :
    Edge.weld u w ∈ G.edges ↔ (u, w) ∈ G.weld := by
  simp [WeldedInstance.edges, WeldedInstance.treeEdges, WeldedInstance.weldEdges]

lemma edge_endpoints {n : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    {e : Edge} (he : e ∈ G.edges) :
    IsVertex n e.tail ∧ IsVertex n (e.head n) ∧
      (col n e.tail + 1 = col n (e.head n) ∨ col n (e.head n) + 1 = col n e.tail) := by
  cases e with
  | tree v =>
    have hv := tree_mem_iff.mp he
    cases hp : parent n v with
    | none => simp [hp] at hv
    | some p =>
      have hs := parent_spec hp
      simp only [Edge.tail, Edge.head, hp, Option.getD_some]
      exact ⟨hs.1, hs.2.1, hs.2.2.elim (fun h => Or.inr h.1) (fun h => Or.inl h.1)⟩
  | weld u w =>
    have hw := hG.1.1 (u, w) (weld_mem_iff.mp he)
    dsimp only at hw
    simp only [Edge.tail, Edge.head]
    exact ⟨hw.1, hw.2.2.1, Or.inl (by omega)⟩

lemma tree_head_col {n : ℕ} {G : WeldedInstance n} {v : ℕ}
    (he : Edge.tree v ∈ G.edges) :
    col n ((Edge.tree v).head n) = if col n v ≤ n then col n v - 1 else col n v + 1 := by
  have hv := tree_mem_iff.mp he
  cases hp : parent n v with
  | none => simp [hp] at hv
  | some p =>
    have hs := (parent_spec hp).2.2
    simp only [Edge.head, hp, Option.getD_some]
    rcases hs with h | h
    · rw [if_pos h.2]
      omega
    · rw [if_neg (by omega : ¬ col n v ≤ n)]
      omega

lemma same_class_cols {n l : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    {e e' : Edge} (he : e ∈ G.edges) (he' : e' ∈ G.edges)
    (hclass : G.bEdge l e = G.bEdge l e') (hnone : G.bEdge l e ≠ none) :
    col n e.tail = col n e'.tail ∧ col n (e.head n) = col n (e'.head n) := by
  cases e with
  | tree v =>
    have hv : n - l ≤ col n v ∧ col n v ≤ n + l := by
      by_contra h
      simp only [WeldedInstance.bEdge, if_neg h, ne_eq, not_true_eq_false] at hnone
    cases e' with
    | tree w =>
      have hw : n - l ≤ col n w ∧ col n w ≤ n + l := by
        by_contra h
        simp only [WeldedInstance.bEdge, if_pos hv, if_neg h, reduceCtorEq] at hclass
      have hc : col n v = col n w := by
        have hboth : col n v = col n w ∧ G.color (.tree v) = G.color (.tree w) := by
          simpa only [WeldedInstance.bEdge, if_pos hv, if_pos hw,
            Option.some.injEq, EdgeClass.tr.injEq] using hclass
        exact hboth.1
      refine ⟨hc, ?_⟩
      rw [tree_head_col he, tree_head_col he', hc]
    | weld u w => simp [WeldedInstance.bEdge, hv] at hclass
  | weld u w =>
    cases e' with
    | tree v =>
      simp only [WeldedInstance.bEdge] at hclass
      split at hclass <;> simp_all
    | weld u' w' =>
      have hw := hG.1.1 (u, w) (weld_mem_iff.mp he)
      have hw' := hG.1.1 (u', w') (weld_mem_iff.mp he')
      dsimp only at hw hw'
      simp only [Edge.tail, Edge.head]
      exact ⟨by omega, by omega⟩

end WeldedPath.LoopProof
end
-- END Solutions.WeldedPathGraphDepth

-- BEGIN Solutions.SingleCycleGraphPorts
section
namespace WeldedPath.SingleCyclePorts

open Classical LoopProof

abbrev WeldEdge {n : ℕ} (G : WeldedInstance n) := {e : G.edges // e.1 ∈ G.weldEdges}
abbrev Port {n : ℕ} (G : WeldedInstance n) := Sum G.weld G.weld

def pairEdge {n : ℕ} (G : WeldedInstance n) (p : G.weld) : WeldEdge G :=
  ⟨⟨.weld p.1.1 p.1.2, weld_mem_iff.mpr p.2⟩, Finset.mem_image.mpr ⟨p.1, p.2, rfl⟩⟩

theorem pairEdge_bijective {n : ℕ} (G : WeldedInstance n) : Function.Bijective (pairEdge G) := by
  constructor
  · intro p q h
    apply Subtype.ext
    have hr := congrArg (fun e : WeldEdge G => e.1.1) h
    exact Prod.ext (congrArg Edge.tail hr) (congrArg (Edge.head n) hr)
  · intro e
    obtain ⟨p, hp, he⟩ := Finset.mem_image.mp e.2
    refine ⟨⟨p, hp⟩, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact he

noncomputable def pairEquiv {n : ℕ} (G : WeldedInstance n) : G.weld ≃ WeldEdge G :=
  Equiv.ofBijective (pairEdge G) (pairEdge_bijective G)

theorem weld_iff_bEdge {n l : ℕ} (G : WeldedInstance n) (e : Edge) :
    e ∈ G.weldEdges ↔ e ∈ G.edges ∧ ∃ α, G.bEdge l e = some (.wld α) := by
  cases e with
  | tree v =>
    by_cases h : n - l ≤ col n v ∧ col n v ≤ n + l <;>
      simp [WeldedInstance.weldEdges, WeldedInstance.bEdge, h]
  | weld u w =>
    simp [WeldedInstance.weldEdges, WeldedInstance.bEdge, WeldedInstance.edges,
      WeldedInstance.treeEdges]

theorem perm_weld_iff {n l : ℕ} {G : WeldedInstance n} {π : Equiv.Perm G.edges}
    (hπ : G.IsEdgePerm l π) (e : G.edges) : e.1 ∈ G.weldEdges ↔ (π e).1 ∈ G.weldEdges := by
  rw [weld_iff_bEdge (l := l), weld_iff_bEdge (l := l)]
  simp only [e.2, (π e).2, true_and, (hπ e).1]

noncomputable def weldPerm {n l : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (hπ : G.IsEdgePerm l π) : Equiv.Perm G.weld :=
  (pairEquiv G).trans ((π.subtypeEquiv (perm_weld_iff hπ)).trans (pairEquiv G).symm)

theorem pair_weldPerm {n l : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (hπ : G.IsEdgePerm l π) (p : G.weld) :
    (pairEdge G (weldPerm G π hπ p)).1 = π (pairEdge G p).1 := by
  have h := (pairEquiv G).apply_symm_apply ((π.subtypeEquiv (perm_weld_iff hπ)) (pairEquiv G p))
  exact congrArg Subtype.val h

theorem subtype_filter_card {α : Type*} [DecidableEq α] (s : Finset α)
    (P : α → Prop) [DecidablePred P] :
    (Finset.univ.filter (fun x : s => P x.1)).card = (s.filter P).card := by
  refine Finset.card_bij (fun x _ => x.1) ?_ ?_ ?_
  · intro x hx
    exact Finset.mem_filter.mpr ⟨x.2, (Finset.mem_filter.mp hx).2⟩
  · intro x _ y _ h
    exact Subtype.ext h
  · intro x hx
    refine ⟨⟨x, (Finset.mem_filter.mp hx).1⟩, ?_, rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact (Finset.mem_filter.mp hx).2

theorem left_fiber_card {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) :
    (Finset.univ.filter (fun q : G.weld => q.1.1 = p.1.1)).card = 2 := by
  rw [subtype_filter_card G.weld (fun q : ℕ × ℕ => q.1 = p.1.1)]
  have hp := hG.1 p.1 p.2
  have hc := hG.2.1 p.1.1 ⟨hp.1, Or.inl hp.2.1⟩
  convert hc using 1
  congr 1
  ext q
  simp only [Finset.mem_filter]
  constructor
  · intro h
    exact ⟨h.1, Or.inl h.2⟩
  · rintro ⟨hq, hqv | hqv⟩
    · exact ⟨hq, hqv⟩
    · have hh := (hG.1 q hq).2.2.2
      rw [hqv, hp.2.1] at hh
      omega

theorem right_fiber_card {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) :
    (Finset.univ.filter (fun q : G.weld => q.1.2 = p.1.2)).card = 2 := by
  rw [subtype_filter_card G.weld (fun q : ℕ × ℕ => q.2 = p.1.2)]
  have hp := hG.1 p.1 p.2
  have hc := hG.2.1 p.1.2 ⟨hp.2.2.1, Or.inr hp.2.2.2⟩
  convert hc using 1
  congr 1
  ext q
  simp only [Finset.mem_filter]
  constructor
  · intro h
    exact ⟨h.1, Or.inr h.2⟩
  · rintro ⟨hq, hqv | hqv⟩
    · have hh := (hG.1 q hq).2.1
      rw [hqv, hp.2.2.2] at hh
      omega
    · exact ⟨hq, hqv⟩

theorem fiber_other {A B : Type*} [Fintype A] [DecidableEq A] [DecidableEq B]
    (f : A → B) (p : A) (hcard : (Finset.univ.filter (fun q => f q = f p)).card = 2) :
    ∃ q, q ≠ p ∧ f q = f p ∧ ∀ r, f r = f p → r = p ∨ r = q := by
  obtain ⟨x, y, hxy, hs⟩ := Finset.card_eq_two.mp hcard
  have hall (r : A) : f r = f p ↔ r = x ∨ r = y := by
    have hmem : r ∈ Finset.univ.filter (fun q => f q = f p) ↔ r ∈ ({x, y} : Finset A) := by rw [hs]
    simpa using hmem
  rcases (hall p).mp rfl with hpx | hpy
  · subst x
    exact ⟨y, hxy.symm, (hall y).mpr (Or.inr rfl), fun r hr => (hall r).mp hr⟩
  · subst y
    refine ⟨x, hxy, (hall x).mpr (Or.inl rfl), ?_⟩
    intro r hr
    exact ((hall r).mp hr).symm

noncomputable def leftMate {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) : G.weld :=
  Classical.choose (fiber_other (fun q : G.weld => q.1.1) p (left_fiber_card hG p))

noncomputable def rightMate {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) : G.weld :=
  Classical.choose (fiber_other (fun q : G.weld => q.1.2) p (right_fiber_card hG p))

theorem leftMate_spec {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) :
    leftMate hG p ≠ p ∧ (leftMate hG p).1.1 = p.1.1 ∧
      ∀ q : G.weld, q.1.1 = p.1.1 → q = p ∨ q = leftMate hG p :=
  Classical.choose_spec (fiber_other (fun q : G.weld => q.1.1) p (left_fiber_card hG p))

theorem rightMate_spec {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : G.weld) :
    rightMate hG p ≠ p ∧ (rightMate hG p).1.2 = p.1.2 ∧
      ∀ q : G.weld, q.1.2 = p.1.2 → q = p ∨ q = rightMate hG p :=
  Classical.choose_spec (fiber_other (fun q : G.weld => q.1.2) p (right_fiber_card hG p))

theorem leftMate_involutive {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) :
    Function.Involutive (leftMate hG) := by
  intro p
  have hp := leftMate_spec hG p
  have hq := leftMate_spec hG (leftMate hG p)
  exact (hp.2.2 _ (hq.2.1.trans hp.2.1)).resolve_right hq.1

theorem rightMate_involutive {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) :
    Function.Involutive (rightMate hG) := by
  intro p
  have hp := rightMate_spec hG p
  have hq := rightMate_spec hG (rightMate hG p)
  exact (hp.2.2 _ (hq.2.1.trans hp.2.1)).resolve_right hq.1

end WeldedPath.SingleCyclePorts
end
-- END Solutions.SingleCycleGraphPorts

-- BEGIN Solutions.SingleCycleGraphPortGraph
section
namespace WeldedPath.SingleCyclePorts

open Classical

noncomputable def fixedMate {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) : Port G → Port G
  | .inl e => .inl (leftMate hG e)
  | .inr e => .inr (rightMate hG e)

def crossMate {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld) : Port G → Port G
  | .inl e => .inr (σ e)
  | .inr e => .inl (σ.symm e)

theorem fixedMate_involutive {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) :
    Function.Involutive (fixedMate hG) := by
  intro p
  cases p with
  | inl e => exact congrArg Sum.inl (leftMate_involutive hG e)
  | inr e => exact congrArg Sum.inr (rightMate_involutive hG e)

theorem crossMate_involutive {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld) :
    Function.Involutive (crossMate σ) := by
  intro p
  cases p <;> simp [crossMate]

theorem fixedMate_ne {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : Port G) :
    fixedMate hG p ≠ p := by
  cases p with
  | inl e => simpa only [fixedMate, ne_eq, Sum.inl.injEq] using (leftMate_spec hG e).1
  | inr e => simpa only [fixedMate, ne_eq, Sum.inr.injEq] using (rightMate_spec hG e).1

theorem crossMate_ne {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld) (p : Port G) :
    crossMate σ p ≠ p := by cases p <;> simp [crossMate]

theorem mates_ne {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (p : Port G) : fixedMate hG p ≠ crossMate σ p := by
  cases p <;> simp [fixedMate, crossMate]

noncomputable def fixedPortGraph {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) : SimpleGraph (Port G) where
  Adj p q := q = fixedMate hG p
  symm := ⟨by intro p q h; subst q; exact (fixedMate_involutive hG p).symm⟩
  loopless := ⟨by intro p h; exact fixedMate_ne hG p h.symm⟩

def crossPortGraph {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld) : SimpleGraph (Port G) where
  Adj p q := q = crossMate σ p
  symm := ⟨by intro p q h; subst q; exact (crossMate_involutive σ p).symm⟩
  loopless := ⟨by intro p h; exact crossMate_ne σ p h.symm⟩

noncomputable def portGraph {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) : SimpleGraph (Port G) := fixedPortGraph hG ⊔ crossPortGraph σ

def exposed {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld) (U : Finset G.weld) : Port G → Prop
  | .inl e => e ∈ U
  | .inr e => σ.symm e ∈ U

theorem exposed_crossMate {n : ℕ} {G : WeldedInstance n} (σ : Equiv.Perm G.weld)
    (U : Finset G.weld) (p : Port G) : exposed σ U (crossMate σ p) ↔ exposed σ U p := by
  cases p <;> simp [exposed, crossMate]

noncomputable def cutCrossGraph {n : ℕ} {G : WeldedInstance n}
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) : SimpleGraph (Port G) where
  Adj p q := q = crossMate σ p ∧ ¬ exposed σ U p
  symm := ⟨by
    intro p q h
    obtain ⟨rfl, hn⟩ := h
    exact ⟨(crossMate_involutive σ p).symm, fun h => hn ((exposed_crossMate σ U p).mp h)⟩⟩
  loopless := ⟨by intro p h; exact crossMate_ne σ p h.1.symm⟩

noncomputable def cutGraph {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) : SimpleGraph (Port G) :=
  fixedPortGraph hG ⊔ cutCrossGraph σ U

theorem cutGraph_le {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) : cutGraph hG σ U ≤ portGraph hG σ := by
  intro p q h
  exact h.elim Or.inl (fun h => Or.inr h.1)

theorem port_neighbors {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (p : Port G) :
    (portGraph hG σ).neighborFinset p = {fixedMate hG p, crossMate σ p} := by
  ext q
  rw [SimpleGraph.mem_neighborFinset]
  change (q = fixedMate hG p ∨ q = crossMate σ p) ↔ _
  simp

theorem port_degree {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (p : Port G) : (portGraph hG σ).degree p = 2 := by
  rw [SimpleGraph.degree, port_neighbors]
  simp [mates_ne hG σ p]

theorem cut_neighbors {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (p : Port G) :
    (cutGraph hG σ U).neighborFinset p =
      if exposed σ U p then {fixedMate hG p} else {fixedMate hG p, crossMate σ p} := by
  ext q
  rw [SimpleGraph.mem_neighborFinset]
  change (q = fixedMate hG p ∨ q = crossMate σ p ∧ ¬ exposed σ U p) ↔ _
  by_cases hp : exposed σ U p <;>
    simp [hp]

theorem cut_degree {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (p : Port G) :
    (cutGraph hG σ U).degree p = if exposed σ U p then 1 else 2 := by
  rw [SimpleGraph.degree, cut_neighbors]
  split_ifs <;> simp [mates_ne hG σ p]

theorem cutGraph_ne {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (hU : U.Nonempty) :
    cutGraph hG σ U ≠ portGraph hG σ := by
  obtain ⟨e, he⟩ := hU
  intro h
  have hd := congrArg (fun H : SimpleGraph (Port G) => H.degree (.inl e)) h
  rw [cut_degree, port_degree] at hd
  rw [if_pos (show exposed σ U (.inl e) from he)] at hd
  omega

def vertex {n : ℕ} {G : WeldedInstance n} : Port G → ℕ
  | .inl e => e.1.1
  | .inr e => e.1.2

theorem vertex_isLeaf {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : Port G) :
    WeldedInstance.IsLeaf n (vertex p) := by
  cases p with
  | inl e => exact ⟨(hG.1 e.1 e.2).1, Or.inl (hG.1 e.1 e.2).2.1⟩
  | inr e => exact ⟨(hG.1 e.1 e.2).2.2.1, Or.inr (hG.1 e.1 e.2).2.2.2⟩

theorem vertex_fixedMate {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld) (p : Port G) :
    vertex (fixedMate hG p) = vertex p := by
  cases p with
  | inl e => exact (leftMate_spec hG e).2.1
  | inr e => exact (rightMate_spec hG e).2.1

theorem same_vertex_fixed_reachable {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (p q : Port G) (h : vertex p = vertex q) : (fixedPortGraph hG).Reachable p q := by
  cases p with
  | inl e =>
    cases q with
    | inl f =>
      rcases (leftMate_spec hG e).2.2 f h.symm with hfe | hfe
      · subst f; exact SimpleGraph.Reachable.rfl
      · exact (show (fixedPortGraph hG).Adj (.inl e) (.inl f) from congrArg Sum.inl hfe).reachable
    | inr f =>
      have he := (hG.1 e.1 e.2).2.1
      have hf := (hG.1 f.1 f.2).2.2.2
      change e.1.1 = f.1.2 at h
      rw [h] at he
      omega
  | inr e =>
    cases q with
    | inl f =>
      have he := (hG.1 e.1 e.2).2.2.2
      have hf := (hG.1 f.1 f.2).2.1
      change e.1.2 = f.1.1 at h
      rw [h] at he
      omega
    | inr f =>
      rcases (rightMate_spec hG e).2.2 f h.symm with hfe | hfe
      · subst f; exact SimpleGraph.Reachable.rfl
      · exact (show (fixedPortGraph hG).Adj (.inr e) (.inr f) from congrArg Sum.inr hfe).reachable

end WeldedPath.SingleCyclePorts
end
-- END Solutions.SingleCycleGraphPortGraph

-- BEGIN Solutions.SingleCycleGraphPortConnectivity
section
namespace WeldedPath.SingleCyclePorts

open Classical

theorem vertex_surjective_leaf {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (v : ℕ) (hv : WeldedInstance.IsLeaf n v) : ∃ p : Port G, vertex p = v := by
  have hc := hG.2.1 v hv
  have hn : (G.weld.filter (fun p => p.1 = v ∨ p.2 = v)).Nonempty := by
    apply Finset.card_pos.mp
    omega
  obtain ⟨p, hp⟩ := hn
  obtain ⟨hp, h | h⟩ := Finset.mem_filter.mp hp
  · exact ⟨.inl ⟨p, hp⟩, h⟩
  · exact ⟨.inr ⟨p, hp⟩, h⟩

theorem right_vertex_weldPerm {n l : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (hπ : G.IsEdgePerm l π) (p : G.weld) :
    vertex (Sum.inr (weldPerm G π hπ p) : Port G) = (π (pairEdge G p).1).1.head n := by
  exact congrArg (fun e : G.edges => e.1.head n) (pair_weldPerm G π hπ p)

theorem raw_edge_ports {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π) (e : G.edges)
    (he : e.1 ∈ G.weldEdges) : ∃ p q : Port G,
      vertex p = e.1.tail ∧ vertex q = (π e).1.head n ∧
        (portGraph hG (weldPerm G π hπ)).Adj p q := by
  obtain ⟨r, hr⟩ := (pairEquiv G).surjective (⟨e, he⟩ : WeldEdge G)
  have hr' : (pairEdge G r).1 = e := congrArg Subtype.val hr
  refine ⟨.inl r, .inr (weldPerm G π hπ r), ?_, ?_, Or.inr rfl⟩
  · exact congrArg (fun e : G.edges => e.1.tail) hr'
  · rw [right_vertex_weldPerm, hr']

theorem raw_adj_ports {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π) {a b : ℕ}
    (hab : (G.permWeldGraph π).Adj a b) : ∃ p q : Port G,
      vertex p = a ∧ vertex q = b ∧ (portGraph hG (weldPerm G π hπ)).Adj p q := by
  rcases hab with ⟨_, h | h⟩
  · obtain ⟨e, he, rfl, rfl⟩ := h
    exact raw_edge_ports G hG π hπ e he
  · obtain ⟨e, he, rfl, rfl⟩ := h
    obtain ⟨p, q, hp, hq, hpq⟩ := raw_edge_ports G hG π hπ e he
    exact ⟨q, p, hq, hp, hpq.symm⟩

theorem same_vertex_port_reachable {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (p q : Port G) (h : vertex p = vertex q) :
    (portGraph hG σ).Reachable p q :=
  SimpleGraph.Reachable.mono le_sup_left (same_vertex_fixed_reachable hG p q h)

theorem raw_reachable_lift {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π) (p q : Port G)
    (h : (G.permWeldGraph π).Reachable (vertex p) (vertex q)) :
    (portGraph hG (weldPerm G π hπ)).Reachable p q := by
  have hwalk {a b : ℕ} (w : (G.permWeldGraph π).Walk a b) : ∀ p q : Port G,
      vertex p = a → vertex q = b → (portGraph hG (weldPerm G π hπ)).Reachable p q := by
    induction w with
    | nil =>
      intro p q hp hq
      exact same_vertex_port_reachable hG _ p q (hp.trans hq.symm)
    | @cons a b c hadj w ih =>
      intro p q hp hq
      obtain ⟨s, t, hs, ht, hst⟩ := raw_adj_ports G hG π hπ hadj
      exact (same_vertex_port_reachable hG _ p s (hp.trans hs.symm)).trans
        (hst.reachable.trans (ih t q ht hq))
  obtain ⟨w⟩ := h
  exact hwalk w p q rfl rfl

theorem port_reachable_project {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π) {p q : Port G}
    (h : (portGraph hG (weldPerm G π hπ)).Reachable p q) :
    (G.permWeldGraph π).Reachable (vertex p) (vertex q) := by
  have hedge (r : G.weld) : (G.permWeldGraph π).Reachable
      (vertex (Sum.inl r : Port G)) (vertex (Sum.inr (weldPerm G π hπ r) : Port G)) := by
    rw [right_vertex_weldPerm]
    exact SingleCycleGraph.perm_edge_reachable G π (pairEdge G r).2
  apply SingleCycleGraph.reachable_map_by_paths vertex _ h
  intro p q hpq
  rcases hpq with hfixed | hcross
  · change q = fixedMate hG p at hfixed
    subst q
    rw [vertex_fixedMate]
  · change q = crossMate (weldPerm G π hπ) p at hcross
    subst q
    cases p with
    | inl r => exact hedge r
    | inr r =>
      simpa only [crossMate, Equiv.apply_symm_apply] using (hedge ((weldPerm G π hπ).symm r)).symm

theorem port_preconnected_iff {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π) :
    (portGraph hG (weldPerm G π hπ)).Preconnected ↔ G.SingleCycle π := by
  constructor
  · intro h a b ha hb
    obtain ⟨p, hp⟩ := vertex_surjective_leaf hG a ha
    obtain ⟨q, hq⟩ := vertex_surjective_leaf hG b hb
    simpa only [hp, hq] using port_reachable_project G hG π hπ (h p q)
  · intro h p q
    exact raw_reachable_lift G hG π hπ p q (h _ _ (vertex_isLeaf hG p) (vertex_isLeaf hG q))

end WeldedPath.SingleCyclePorts
end
-- END Solutions.SingleCycleGraphPortConnectivity

-- BEGIN Solutions.SingleCyclePathComponents
section
namespace WeldedPath.PathComponents

open Classical SimpleGraph
open scoped BigOperators

variable {V : Type*} [Fintype V]

/-- A proper spanning subgraph of a connected cycle is a forest. -/
theorem acyclic_of_lt_cycle {H K : SimpleGraph V}
    (hH : H.Connected) (hcyc : H.IsCycles) (hKH : K ≤ H) (hne : K ≠ H) :
    K.IsAcyclic := by
  intro v p hp
  let q := p.mapLe hKH
  have hq : q.IsCycle := hp.mapLe hKH
  have hclosed (a : V) (ha : a ∈ q.toSubgraph.verts) (b : V) (hab : H.Adj a b) :
      q.toSubgraph.Adj a b :=
    (hq.adj_toSubgraph_iff_of_isCycles hcyc ha b).mpr hab
  have hv : v ∈ q.toSubgraph.verts := by
    rw [Walk.mem_verts_toSubgraph]
    exact q.start_mem_support
  have hall (a : V) : a ∈ q.toSubgraph.verts :=
    (hH.preconnected v a).mem_subgraphVerts hclosed hv
  apply hne
  apply le_antisymm hKH
  intro a b hab
  have habq := hclosed a (hall a) b hab
  have habp : p.toSubgraph.Adj a b := (Walk.adj_toSubgraph_mapLe hKH).mp habq
  exact habp.adj_sub

/-- A finite tree whose degrees are all one or two has exactly two endpoints. -/
theorem tree_two_endpoints (K : SimpleGraph V) (hK : K.IsTree)
    (hdeg : ∀ v, K.degree v = 1 ∨ K.degree v = 2) :
    (Finset.univ.filter fun v => K.degree v = 1).card = 2 := by
  have hedge := hK.card_edgeFinset
  have hsum := K.sum_degrees_eq_twice_card_edges
  have hpoint (v : V) : K.degree v + (if K.degree v = 1 then 1 else 0) = 2 := by
    rcases hdeg v with hv | hv <;> simp [hv]
  have heq : (∑ v, K.degree v) + (Finset.univ.filter fun v => K.degree v = 1).card =
      2 * Fintype.card V := by
    calc
      _ = ∑ v, (K.degree v + if K.degree v = 1 then 1 else 0) := by
        rw [Finset.sum_add_distrib]
        simp
      _ = _ := by simp [hpoint, Nat.mul_comm]
  omega

theorem component_degree_eq (K : SimpleGraph V) (c : K.ConnectedComponent) (v : c) :
    c.toSimpleGraph.degree v = K.degree v.1 := by
  have he : c.toSimpleGraph.neighborSet v ≃ K.neighborSet v.1 :=
    { toFun := fun w => ⟨w.1.1, w.2⟩
      invFun := fun w => ⟨⟨w.1, c.mem_supp_of_adj_mem_supp v.2 w.2⟩, w.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  rw [← SimpleGraph.card_neighborSet_eq_degree, ← SimpleGraph.card_neighborSet_eq_degree]
  exact Fintype.card_congr he

/-- Every component of a cut cycle has exactly two degree-one ports. The
degree hypotheses hold after deleting a nonempty matching from a cycle. -/
theorem cut_cycle_component_two_ports {H K : SimpleGraph V}
    (hH : H.Connected) (hcyc : H.IsCycles) (hKH : K ≤ H) (hne : K ≠ H)
    (hdeg : ∀ v, K.degree v = 1 ∨ K.degree v = 2) (c : K.ConnectedComponent) :
    (Finset.univ.filter fun v : c => K.degree v.1 = 1).card = 2 := by
  have hforest := acyclic_of_lt_cycle hH hcyc hKH hne
  have ht := hforest.isTree_connectedComponent c
  have hh := tree_two_endpoints c.toSimpleGraph ht (fun v => by
    rw [component_degree_eq]
    exact hdeg v.1)
  simpa only [component_degree_eq] using hh

/-- The two endpoints of each fixed component are exactly its free left and
right matching ports. This is the finite two-port equation used for counting. -/
theorem cut_cycle_two_port_fibers {A : Type*} [Fintype A] {H K : SimpleGraph V}
    (hH : H.Connected) (hcyc : H.IsCycles) (hKH : K ≤ H) (hne : K ≠ H)
    (hdeg : ∀ v, K.degree v = 1 ∨ K.degree v = 2)
    (a b : A → V) (ha : Function.Injective a) (hb : Function.Injective b)
    (hab : ∀ x y, a x ≠ b y)
    (hfree : ∀ v, K.degree v = 1 ↔ (∃ x, a x = v) ∨ ∃ x, b x = v)
    (c : K.ConnectedComponent) :
    (Finset.univ.filter fun x => K.connectedComponentMk (a x) = c).card +
      (Finset.univ.filter fun x => K.connectedComponentMk (b x) = c).card = 2 := by
  let L := {x : A // K.connectedComponentMk (a x) = c}
  let R := {x : A // K.connectedComponentMk (b x) = c}
  let E := {v : c // K.degree v.1 = 1}
  let f : L ⊕ R → E
    | .inl x => ⟨⟨a x.1, x.2⟩, (hfree _).mpr (Or.inl ⟨x.1, rfl⟩)⟩
    | .inr x => ⟨⟨b x.1, x.2⟩, (hfree _).mpr (Or.inr ⟨x.1, rfl⟩)⟩
  have hfi : Function.Injective f := by
    intro x y hxy
    have hv := congrArg (fun v : E => v.1.1) hxy
    cases x with
    | inl x =>
      cases y with
      | inl y =>
        have hx : x = y := Subtype.ext (ha hv)
        exact congrArg Sum.inl hx
      | inr y => exact (hab x.1 y.1 hv).elim
    | inr x =>
      cases y with
      | inl y => exact (hab y.1 x.1 hv.symm).elim
      | inr y =>
        have hx : x = y := Subtype.ext (hb hv)
        exact congrArg Sum.inr hx
  have hfs : Function.Surjective f := by
    rintro ⟨⟨v, hv⟩, hve⟩
    rcases (hfree v).mp hve with ⟨x, hx⟩ | ⟨x, hx⟩
    · subst v
      exact ⟨Sum.inl ⟨x, hv⟩, rfl⟩
    · subst v
      exact ⟨Sum.inr ⟨x, hv⟩, rfl⟩
  have hc := Fintype.card_congr (Equiv.ofBijective f ⟨hfi, hfs⟩)
  have heCard : Fintype.card E = 2 := by
    simpa only [E, Fintype.card_subtype] using
      cut_cycle_component_two_ports hH hcyc hKH hne hdeg c
  rw [heCard] at hc
  simpa only [Fintype.card_sum, L, R, Fintype.card_subtype] using hc

end WeldedPath.PathComponents
end
-- END Solutions.SingleCyclePathComponents

-- BEGIN Solutions.SingleCycleGraphPortComponents
section
namespace WeldedPath.SingleCyclePorts

open Classical

theorem port_isCycles {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) : (portGraph hG σ).IsCycles := by
  intro p _
  rw [Set.ncard_eq_toFinset_card', Set.toFinset_card,
    SimpleGraph.card_neighborSet_eq_degree, port_degree]

theorem cut_degree_one_iff {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (p : Port G) :
    (cutGraph hG σ U).degree p = 1 ↔
      (∃ e : U, Sum.inl e.1 = p) ∨ ∃ e : U, Sum.inr (σ e.1) = p := by
  rw [cut_degree]
  have hflag : (if exposed σ U p then 1 else 2) = 1 ↔ exposed σ U p := by
    by_cases h : exposed σ U p <;> simp [h]
  rw [hflag]
  cases p with
  | inl e =>
    change e ∈ U ↔ _
    constructor
    · intro he
      exact Or.inl ⟨⟨e, he⟩, rfl⟩
    · rintro (⟨f, hf⟩ | ⟨f, hf⟩)
      · have hfe : f.1 = e := Sum.inl.inj hf
        exact hfe ▸ f.2
      · cases hf
  | inr e =>
    change σ.symm e ∈ U ↔ _
    constructor
    · intro he
      exact Or.inr ⟨⟨σ.symm e, he⟩, by simp⟩
    · rintro (⟨f, hf⟩ | ⟨f, hf⟩)
      · cases hf
      · have hfe : σ f.1 = e := Sum.inr.inj hf
        have hf' : f.1 = σ.symm e := σ.eq_symm_apply.mpr hfe
        exact hf' ▸ f.2

theorem cut_two_port_fibers {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (hconn : (portGraph hG σ).Preconnected)
    (U : Finset G.weld) (hU : U.Nonempty) (c : (cutGraph hG σ U).ConnectedComponent) :
    (Finset.univ.filter (fun e : U =>
      (cutGraph hG σ U).connectedComponentMk (.inl e.1) = c)).card +
      (Finset.univ.filter (fun e : U =>
        (cutGraph hG σ U).connectedComponentMk (.inr (σ e.1)) = c)).card = 2 := by
  letI : Nonempty (Port G) := ⟨Sum.inl hU.choose⟩
  have hH : (portGraph hG σ).Connected := ⟨hconn⟩
  have hdeg (p : Port G) : (cutGraph hG σ U).degree p = 1 ∨
      (cutGraph hG σ U).degree p = 2 := by
    rw [cut_degree]
    split_ifs <;> simp
  exact PathComponents.cut_cycle_two_port_fibers hH (port_isCycles hG σ)
    (cutGraph_le hG σ U) (cutGraph_ne hG σ U hU) hdeg
    (fun e : U => Sum.inl e.1) (fun e : U => Sum.inr (σ e.1))
    (fun e f h => Subtype.ext (Sum.inl.inj h))
    (fun e f h => Subtype.ext (σ.injective (Sum.inr.inj h)))
    (by intro x y h; cases h)
    (cut_degree_one_iff hG σ U) c

theorem singleCycle_cut_two_port_fibers {n l : ℕ} (G : WeldedInstance n)
    (hG : G.IsWeld) (π : Equiv.Perm G.edges) (hπ : G.IsEdgePerm l π)
    (hcycle : G.SingleCycle π) (U : Finset G.weld) (hU : U.Nonempty)
    (c : (cutGraph hG (weldPerm G π hπ) U).ConnectedComponent) :
    (Finset.univ.filter (fun e : U =>
      (cutGraph hG (weldPerm G π hπ) U).connectedComponentMk (.inl e.1) = c)).card +
      (Finset.univ.filter (fun e : U =>
        (cutGraph hG (weldPerm G π hπ) U).connectedComponentMk
          (.inr (weldPerm G π hπ e.1)) = c)).card = 2 :=
  cut_two_port_fibers hG _ ((port_preconnected_iff G hG π hπ).mpr hcycle) U hU c

end WeldedPath.SingleCyclePorts
end
-- END Solutions.SingleCycleGraphPortComponents

-- BEGIN Solutions.SingleCycleGraphQuotient
section
namespace WeldedPath.SingleCycleGraph

open Classical

variable {V I : Type*}

def componentMatchingGraph (K : SimpleGraph V) (a b : I → V) :
    SimpleGraph K.ConnectedComponent :=
  SimpleGraph.fromRel fun c d =>
    ∃ i, c = K.connectedComponentMk (a i) ∧ d = K.connectedComponentMk (b i)

theorem component_reachable_of_matching {K : SimpleGraph V} (a b : I → V) {x y : V}
    (hxy : (matchingGraph K a b).Reachable x y) :
    (componentMatchingGraph K a b).Reachable (K.connectedComponentMk x) (K.connectedComponentMk y) := by
  apply reachable_map_by_paths K.connectedComponentMk _ hxy
  intro x y h
  rcases h with hK | ⟨_, h | h⟩
  · have heq := SimpleGraph.ConnectedComponent.sound hK.reachable
    simpa only [heq] using
      (SimpleGraph.Reachable.rfl : (componentMatchingGraph K a b).Reachable
        (K.connectedComponentMk y) (K.connectedComponentMk y))
  · obtain ⟨i, rfl, rfl⟩ := h
    exact fromRel_reachable ⟨i, rfl, rfl⟩
  · obtain ⟨i, rfl, rfl⟩ := h
    exact (fromRel_reachable (R := fun c d => ∃ i,
      c = K.connectedComponentMk (a i) ∧ d = K.connectedComponentMk (b i))
        ⟨i, rfl, rfl⟩).symm

theorem matching_reachable_of_component {K : SimpleGraph V} (a b : I → V) {x y : V}
    (hxy : (componentMatchingGraph K a b).Reachable
      (K.connectedComponentMk x) (K.connectedComponentMk y)) :
    (matchingGraph K a b).Reachable x y := by
  have hop {c d : K.ConnectedComponent} (h : (componentMatchingGraph K a b).Adj c d)
      (x y : V) (hx : K.connectedComponentMk x = c) (hy : K.connectedComponentMk y = d) :
      (matchingGraph K a b).Reachable x y := by
    rcases h with ⟨_, h | h⟩
    · obtain ⟨i, hc, hd⟩ := h
      have hx' := SimpleGraph.ConnectedComponent.exact (hx.trans hc)
      have hy' := SimpleGraph.ConnectedComponent.exact (hy.trans hd).symm
      exact (matching_fixed_reachable K a b hx').trans
        ((matching_edge_reachable K a b i).trans (matching_fixed_reachable K a b hy'))
    · obtain ⟨i, hd, hc⟩ := h
      have hx' := SimpleGraph.ConnectedComponent.exact (hx.trans hc)
      have hy' := SimpleGraph.ConnectedComponent.exact (hy.trans hd).symm
      exact (matching_fixed_reachable K a b hx').trans
        ((matching_edge_reachable K a b i).symm.trans (matching_fixed_reachable K a b hy'))
  have hwalk {c d : K.ConnectedComponent} (p : (componentMatchingGraph K a b).Walk c d) :
      ∀ x y, K.connectedComponentMk x = c → K.connectedComponentMk y = d →
        (matchingGraph K a b).Reachable x y := by
    induction p with
    | nil =>
      intro x y hx hy
      exact matching_fixed_reachable K a b (SimpleGraph.ConnectedComponent.exact (hx.trans hy.symm))
    | @cons c d e hadj p ih =>
      intro x y hx hy
      obtain ⟨z, hz⟩ := (Quot.mk_surjective : Function.Surjective K.connectedComponentMk) d
      exact (hop hadj x z hx hz).trans (ih z y hz hy)
  obtain ⟨p⟩ := hxy
  exact hwalk p x y rfl rfl

theorem matching_reachable_iff_component {K : SimpleGraph V} (a b : I → V) (x y : V) :
    (matchingGraph K a b).Reachable x y ↔
      (componentMatchingGraph K a b).Reachable (K.connectedComponentMk x) (K.connectedComponentMk y) :=
  ⟨component_reachable_of_matching a b, matching_reachable_of_component a b⟩

theorem matching_preconnected_iff_component (K : SimpleGraph V) (a b : I → V) :
    (matchingGraph K a b).Preconnected ↔ (componentMatchingGraph K a b).Preconnected := by
  constructor
  · intro h c d
    obtain ⟨x, rfl⟩ := (Quot.mk_surjective : Function.Surjective K.connectedComponentMk) c
    obtain ⟨y, rfl⟩ := (Quot.mk_surjective : Function.Surjective K.connectedComponentMk) d
    exact component_reachable_of_matching a b (h x y)
  · intro h x y
    exact matching_reachable_of_component a b (h _ _)

def componentMatchingIso (K : SimpleGraph V) (a b a' b' : I → V)
    (τ : Equiv.Perm K.ConnectedComponent)
    (ha : ∀ i, τ (K.connectedComponentMk (a i)) = K.connectedComponentMk (a' i))
    (hb : ∀ i, τ (K.connectedComponentMk (b i)) = K.connectedComponentMk (b' i)) :
    componentMatchingGraph K a b ≃g componentMatchingGraph K a' b' := by
  refine ⟨τ, ?_⟩
  intro x y
  constructor
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨fun hxy => hne (congrArg τ hxy),
        Or.inl ⟨i, τ.injective (hx.trans (ha i).symm), τ.injective (hy.trans (hb i).symm)⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨fun hxy => hne (congrArg τ hxy),
        Or.inr ⟨i, τ.injective (hy.trans (ha i).symm), τ.injective (hx.trans (hb i).symm)⟩⟩
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨fun hxy => hne (τ.injective hxy),
        Or.inl ⟨i, (congrArg τ hx).trans (ha i), (congrArg τ hy).trans (hb i)⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨fun hxy => hne (τ.injective hxy),
        Or.inr ⟨i, (congrArg τ hy).trans (ha i), (congrArg τ hx).trans (hb i)⟩⟩

theorem matching_preconnected_component_perm (K : SimpleGraph V) (a b a' b' : I → V)
    (τ : Equiv.Perm K.ConnectedComponent)
    (ha : ∀ i, τ (K.connectedComponentMk (a i)) = K.connectedComponentMk (a' i))
    (hb : ∀ i, τ (K.connectedComponentMk (b i)) = K.connectedComponentMk (b' i)) :
    (matchingGraph K a b).Preconnected ↔ (matchingGraph K a' b').Preconnected := by
  rw [matching_preconnected_iff_component, matching_preconnected_iff_component]
  exact (componentMatchingIso K a b a' b' τ ha hb).preconnected_iff

end WeldedPath.SingleCycleGraph
end
-- END Solutions.SingleCycleGraphQuotient

-- BEGIN Solutions.SingleCycleGraphPortResidual
section
namespace WeldedPath.SingleCyclePorts

open Classical

noncomputable def residualPerm {n : ℕ} {G : WeldedInstance n}
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (θ : Equiv.Perm U) : Equiv.Perm G.weld :=
  (Equiv.Perm.ofSubtype θ).trans σ

theorem residualPerm_apply_mem {n : ℕ} {G : WeldedInstance n}
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (θ : Equiv.Perm U) (e : U) :
    residualPerm σ U θ e.1 = σ (θ e).1 := by
  simp only [residualPerm, Equiv.trans_apply, Equiv.Perm.ofSubtype_apply_coe]

theorem residualPerm_apply_other {n : ℕ} {G : WeldedInstance n}
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (θ : Equiv.Perm U)
    (e : G.weld) (he : e ∉ U) : residualPerm σ U θ e = σ e := by
  simp only [residualPerm, Equiv.trans_apply, Equiv.Perm.ofSubtype_apply_of_not_mem θ he]

theorem portGraph_residual_eq {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (θ : Equiv.Perm U) :
    portGraph hG (residualPerm σ U θ) =
      SingleCycleGraph.matchingGraph (cutGraph hG σ U)
        (fun e : U => Sum.inl e.1) (fun e : U => Sum.inr (σ (θ e).1)) := by
  let σ' := residualPerm σ U θ
  let K := SingleCycleGraph.matchingGraph (cutGraph hG σ U)
    (fun e : U => Sum.inl e.1) (fun e : U => Sum.inr (σ (θ e).1))
  have hleft (e : G.weld) : K.Adj (.inl e) (.inr (σ' e)) := by
    by_cases he : e ∈ U
    · right
      refine ⟨by simp, Or.inl ⟨⟨e, he⟩, rfl, ?_⟩⟩
      exact congrArg Sum.inr (residualPerm_apply_mem σ U θ ⟨e, he⟩)
    · left
      right
      exact ⟨congrArg Sum.inr (residualPerm_apply_other σ U θ e he), he⟩
  apply SimpleGraph.ext
  funext p q
  apply propext
  constructor
  · intro h
    rcases h with hfixed | hcross
    · exact Or.inl (Or.inl hfixed)
    · change q = crossMate σ' p at hcross
      subst q
      cases p with
      | inl e => exact hleft e
      | inr e => simpa only [crossMate, Equiv.apply_symm_apply] using (hleft (σ'.symm e)).symm
  · intro h
    rcases h with (hfixed | hcross) | ⟨_, h | h⟩
    · exact Or.inl hfixed
    · change q = crossMate σ p ∧ ¬ exposed σ U p at hcross
      obtain ⟨rfl, hp⟩ := hcross
      cases p with
      | inl e =>
        right
        change Sum.inr (σ e) = Sum.inr (σ' e)
        exact congrArg Sum.inr (residualPerm_apply_other σ U θ e hp).symm
      | inr e =>
        have he : σ' (σ.symm e) = e := by
          rw [residualPerm_apply_other σ U θ _ hp]
          exact σ.apply_symm_apply e
        have hinv : σ'.symm e = σ.symm e := by
          apply σ'.injective
          rw [σ'.apply_symm_apply, he]
        right
        change Sum.inl (σ.symm e) = Sum.inl (σ'.symm e)
        exact congrArg Sum.inl hinv.symm
    · obtain ⟨e, rfl, rfl⟩ := h
      right
      exact congrArg Sum.inr (residualPerm_apply_mem σ U θ e).symm
    · obtain ⟨e, rfl, rfl⟩ := h
      have hh : (portGraph hG σ').Adj (Sum.inl e.1) (Sum.inr (σ (θ e).1)) :=
        Or.inr (congrArg Sum.inr (residualPerm_apply_mem σ U θ e).symm)
      exact hh.symm

theorem residual_preconnected_iff {n : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    (σ : Equiv.Perm G.weld) (U : Finset G.weld) (θ : Equiv.Perm U) :
    (portGraph hG (residualPerm σ U θ)).Preconnected ↔
      (SingleCycleGraph.matchingGraph
        (⊥ : SimpleGraph (cutGraph hG σ U).ConnectedComponent)
        (fun e : U => (cutGraph hG σ U).connectedComponentMk (.inl e.1))
        (fun e : U => (cutGraph hG σ U).connectedComponentMk (.inr (σ (θ e).1)))).Preconnected := by
  rw [portGraph_residual_eq, SingleCycleGraph.matching_preconnected_iff_component]
  simp [SingleCycleGraph.componentMatchingGraph, SingleCycleGraph.matchingGraph]

end WeldedPath.SingleCyclePorts
end
-- END Solutions.SingleCycleGraphPortResidual

-- BEGIN Solutions.SingleCycleCountWeldedPorts
section
namespace WeldedPath.SingleCycleCounting

open Classical SingleCyclePorts SingleCycleCount

set_option maxHeartbeats 800000

noncomputable def pairResidual {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges) :
    Finset G.weld := Finset.univ.filter fun p => (pairEdge G p).1 ∈ R

noncomputable def residualPairEquiv {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) : R ≃ pairResidual G R where
  toFun e := ⟨(pairEquiv G).symm ⟨e.1, hR e.1 e.2⟩, by
    simp only [pairResidual, Finset.mem_filter, Finset.mem_univ, true_and]
    have h := congrArg Subtype.val ((pairEquiv G).apply_symm_apply ⟨e.1, hR e.1 e.2⟩)
    change (pairEdge G ((pairEquiv G).symm ⟨e.1, hR e.1 e.2⟩)).1 = e.1 at h
    rw [h]
    exact e.2⟩
  invFun p := ⟨(pairEdge G p.1).1, (Finset.mem_filter.mp p.2).2⟩
  left_inv e := by
    classical
    apply Subtype.ext
    exact congrArg (fun x : WeldEdge G => x.1)
      ((pairEquiv G).apply_symm_apply ⟨e.1, hR e.1 e.2⟩)
  right_inv p := by
    classical
    apply Subtype.ext
    exact (pairEquiv G).symm_apply_apply p.1

theorem residualPairEquiv_val {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) (e : R) :
    (pairEdge G (residualPairEquiv G R hR e).1).1 = e.1 := by
  classical
  exact congrArg Subtype.val ((residualPairEquiv G R hR).symm_apply_apply e)

theorem residual_weldPerm {n l : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) (π₀ : Equiv.Perm G.edges)
    (hπ₀ : G.IsEdgePerm l π₀) (θ : Equiv.Perm R)
    (hθ : G.IsEdgePerm l (residualLift R π₀ θ)) :
    weldPerm G (residualLift R π₀ θ) hθ =
      residualPerm (weldPerm G π₀ hπ₀) (pairResidual G R)
        (transportPerm (residualPairEquiv G R hR) θ) := by
  classical
  let t := residualPairEquiv G R hR
  apply Equiv.ext
  intro p
  apply (pairEdge_bijective G).1
  apply Subtype.ext
  rw [pair_weldPerm]
  by_cases hp : p ∈ pairResidual G R
  · let u : pairResidual G R := ⟨p, hp⟩
    let e : R := t.symm u
    have he : (pairEdge G p).1 = e.1 := rfl
    have ht : t e = u := t.apply_symm_apply u
    rw [he, residualLift_on]
    rw [residualPerm_apply_mem _ _ _ u, pair_weldPerm]
    have htθ : transportPerm t θ u = t (θ e) := by
      classical
      rw [← ht, transportPerm_apply]
    rw [htθ, residualPairEquiv_val]
  · have hpR : (pairEdge G p).1 ∉ R := by
      classical
      simpa only [pairResidual, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    rw [residualLift_off R π₀ θ hpR, residualPerm_apply_other _ _ _ p hp,
      pair_weldPerm]

theorem residual_singleCycle_cap {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (R : Finset G.edges) (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges)
    (π₀ : Equiv.Perm G.edges) (hπ₀ : G.IsEdgePerm l π₀) (hcycle : G.SingleCycle π₀)
    (hpres : ∀ θ : Equiv.Perm R, G.IsEdgePerm l (residualLift R π₀ θ))
    (C : Finset (Equiv.Perm G.edges))
    (hC : ∀ θ : Equiv.Perm R,
      residualLift R π₀ θ ∈ C ↔ G.SingleCycle (residualLift R π₀ θ))
    (u : R) (z : G.edges) :
    (R.card - 1) * (((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter
      fun π => π u.1 = z).card) ≤
      (C.filter fun π => ∀ e ∉ R, π e = π₀ e).card := by
  classical
  let U := pairResidual G R
  let t : R ≃ U := residualPairEquiv G R hR
  let σ := weldPerm G π₀ hπ₀
  let K := cutGraph hG σ U
  let a : U → K.ConnectedComponent := fun e => K.connectedComponentMk (.inl e.1)
  let b : U → K.ConnectedComponent := fun e => K.connectedComponentMk (.inr (σ e.1))
  have hU : U.Nonempty := ⟨(t u).1, (t u).2⟩
  have hconn : (portGraph hG σ).Preconnected :=
    (port_preconnected_iff G hG π₀ hπ₀).mpr hcycle
  have hports (c : K.ConnectedComponent) :
      (Finset.univ.filter (fun i : R => a (t i) = c)).card +
      (Finset.univ.filter (fun i : R => b (t i) = c)).card = 2 := by
    classical
    rw [filter_card_equiv t (fun i => a i = c), filter_card_equiv t (fun i => b i = c)]
    exact cut_two_port_fibers hG σ hconn U hU c
  apply residual_completion_cap C R π₀ (fun i => a (t i)) (fun i => b (t i))
    hports ?_ u z
  intro θ
  rw [hC, ← port_preconnected_iff G hG _ (hpres θ),
    residual_weldPerm G R hR π₀ hπ₀ θ (hpres θ), residual_preconnected_iff]
  rw [mem_completionSet, matchingGraph_transport t (⊥ : SimpleGraph K.ConnectedComponent) a b θ]

end WeldedPath.SingleCycleCounting
end
-- END Solutions.SingleCycleCountWeldedPorts

-- BEGIN Solutions.WeldedPathSwitchingModel
section
namespace WeldedPath.SwitchingModel

open Classical FinitePermutationCoupling
open scoped BigOperators

variable {n : ℕ}

/-- Frozen edges have singleton classes; the other classes retain their original names. -/
def block (l : ℕ) (G : WeldedInstance n) (e : G.edges) : G.edges ⊕ EdgeClass :=
  match G.bEdge l e.1 with
  | none => Sum.inl e
  | some b => Sum.inr b

def active (G : WeldedInstance n) : G.edges ⊕ EdgeClass → Prop
  | .inr (.wld _) => True
  | _ => False

theorem block_eq_iff (l : ℕ) (G : WeldedInstance n) (e f : G.edges) :
    block l G e = block l G f ↔
      G.bEdge l e.1 = G.bEdge l f.1 ∧ (G.bEdge l f.1 = none → e = f) := by
  cases he : G.bEdge l e.1 <;> cases hf : G.bEdge l f.1 <;>
    simp [block, he, hf]

theorem blockSupport_eq (l : ℕ) (G : WeldedInstance n) :
    blockSupport (block l G) = Finset.univ.filter (G.IsEdgePerm l) := by
  ext π
  simp only [blockSupport, Finset.mem_filter, Finset.mem_univ, true_and,
    WeldedInstance.IsEdgePerm]
  exact forall_congr' fun e => block_eq_iff l G (π e) e

theorem bEdge_of_weld (l : ℕ) (G : WeldedInstance n) (e : G.edges)
    (he : e.1 ∈ G.weldEdges) : G.bEdge l e.1 = some (.wld (G.color e.1)) := by
  obtain ⟨p, _, hp⟩ := Finset.mem_image.mp he
  rw [← hp]
  rfl

theorem active_iff_weld (l : ℕ) (G : WeldedInstance n) (e : G.edges) :
    active G (block l G e) ↔ e.1 ∈ G.weldEdges := by
  rcases e with ⟨e, he⟩
  cases e with
  | tree v =>
    by_cases hc : n - l ≤ col n v ∧ col n v ≤ n + l <;>
      simp only [block, WeldedInstance.bEdge, hc, if_true, if_false, active] <;>
      simp [WeldedInstance.weldEdges]
  | weld u w =>
    have hw : Edge.weld u w ∈ G.weldEdges := by
      rcases Finset.mem_union.mp he with ht | hw
      · simp [WeldedInstance.treeEdges] at ht
      · exact hw
    simp [block, WeldedInstance.bEdge, active, hw]

theorem block_of_weld (l : ℕ) (G : WeldedInstance n) (e : G.edges)
    (he : e.1 ∈ G.weldEdges) :
    block l G e = Sum.inr (.wld (G.color e.1)) := by
  simp [block, bEdge_of_weld l G e he]

theorem blockFiber_eq_weld (l : ℕ) (G : WeldedInstance n) (e : G.edges)
    (he : e.1 ∈ G.weldEdges) :
    blockFiber (block l G) e =
      Finset.univ.filter (fun f : G.edges =>
        f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) := by
  ext f
  simp only [blockFiber, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro h
    have hf : f.1 ∈ G.weldEdges := (active_iff_weld l G f).mp
      (h ▸ (active_iff_weld l G e).mpr he)
    refine ⟨hf, ?_⟩
    rw [block_of_weld l G f hf, block_of_weld l G e he] at h
    simpa only [Sum.inr.injEq, EdgeClass.wld.injEq] using h
  · rintro ⟨hf, hc⟩
    rw [block_of_weld l G f hf, block_of_weld l G e he, hc]

theorem singleCycle_congr (G : WeldedInstance n) (f g : Equiv.Perm G.edges)
    (hfg : ∀ e : G.edges, e.1 ∈ G.weldEdges → f e = g e) :
    G.SingleCycle f ↔ G.SingleCycle g := by
  have hgraph : G.permWeldGraph f = G.permWeldGraph g := by
    unfold WeldedInstance.permWeldGraph
    congr 1
    funext a b
    apply propext
    constructor
    · rintro ⟨e, he, ha, hb⟩
      exact ⟨e, he, ha, by simpa only [hfg e he] using hb⟩
    · rintro ⟨e, he, ha, hb⟩
      exact ⟨e, he, ha, by simpa only [hfg e he] using hb⟩
  simp only [WeldedInstance.SingleCycle, hgraph]

theorem singleCycle_saturated (l : ℕ) (G : WeldedInstance n) :
    ActiveSaturated (block l G) (active G)
      ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) := by
  intro f hf g hg hfg
  rw [blockSupport_eq] at hf hg
  have hsc := singleCycle_congr G f g fun e he => hfg e ((active_iff_weld l G e).mpr he)
  simp only [Finset.mem_filter, hf, hg, true_and, hsc]

theorem edgeSing_nonempty (l : ℕ) (G : WeldedInstance n)
    (hS : (G.singSupport l).Nonempty) :
    ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle).Nonempty := by
  obtain ⟨⟨τ, π⟩, h⟩ := hS
  simp only [WeldedInstance.singSupport, WeldedInstance.prodSupport,
    Finset.mem_filter, Finset.mem_univ, true_and] at h
  exact ⟨π, by simp only [Finset.mem_filter, Finset.mem_univ, true_and]; exact ⟨h.1.2, h.2⟩⟩

end WeldedPath.SwitchingModel
end
-- END Solutions.WeldedPathSwitchingModel

-- BEGIN Solutions.SingleCycleCountWelded
section
namespace WeldedPath

open Classical FinitePermutationCoupling SingleCycleCounting SwitchingModel

set_option maxHeartbeats 800000

theorem single_cycle_completion_count_full :
    ∀ n l : ℕ, Even n → 2 ≤ l → l ≤ n - 4 →
    ∀ G : WeldedInstance n, G.IsValid →
    ∀ (D : Finset G.edges) (h : Equiv.Perm G.edges) (e z : G.edges),
      e.1 ∈ G.weldEdges → e ∉ D →
      (((Finset.univ.filter fun f : G.edges =>
          f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) \ D).card - 1) *
        ((exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).filter
            fun π => π e = z).card ≤
        (exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).card := by
  classical
  intro n l _ _ _ G hG D h e z he heD
  let R := (Finset.univ.filter fun f : G.edges =>
    f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) \ D
  let C := exposedFiber
    ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h
  have hmemR (f : G.edges) : f ∈ R ↔
      (f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) ∧ f ∉ D := by
    simp only [R, Finset.mem_sdiff, Finset.mem_filter, Finset.mem_univ, true_and]
  have heR : e ∈ R := (hmemR e).mpr ⟨⟨he, rfl⟩, heD⟩
  have hR (f : G.edges) (hf : f ∈ R) : f.1 ∈ G.weldEdges := ((hmemR f).mp hf).1.1
  have hRblock (f : G.edges) (hf : f ∈ R) (g : G.edges) (hg : g ∈ R) :
      block l G f = block l G g := by
    rw [block_of_weld l G f (hR f hf), block_of_weld l G g (hR g hg),
      ((hmemR f).mp hf).1.2, ((hmemR g).mp hg).1.2]
  apply residual_partition_cap C R e z (R.card - 1)
  intro π₀ hπ₀
  have hπ₀' : (G.IsEdgePerm l π₀ ∧ G.SingleCycle π₀) ∧
      ∀ f ∈ D, π₀ f = h f := by
    simpa only [C, exposedFiber, Finset.mem_filter, Finset.mem_univ, true_and] using hπ₀
  have hblock : π₀ ∈ blockSupport (block l G) := by
    rw [blockSupport_eq]
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hπ₀'.1.1⟩
  have hpres (θ : Equiv.Perm R) : G.IsEdgePerm l (residualLift R π₀ θ) := by
    have hh := residualLift_preserves_block (block l G) R hRblock π₀ hblock θ
    rw [blockSupport_eq] at hh
    exact (Finset.mem_filter.mp hh).2
  have hrecords (θ : Equiv.Perm R) : ∀ f ∈ D, residualLift R π₀ θ f = h f := by
    intro f hf
    have hfR : f ∉ R := fun hfr => ((hmemR f).mp hfr).2 hf
    rw [residualLift_off R π₀ θ hfR]
    exact hπ₀'.2 f hf
  apply residual_singleCycle_cap G hG.1 R hR π₀ hπ₀'.1.1 hπ₀'.1.2 hpres C ?_ ⟨e, heR⟩ z
  intro θ
  simp only [C, exposedFiber, Finset.mem_filter, Finset.mem_univ, true_and,
    hpres θ]
  constructor
  · exact And.left
  · intro hc
    exact ⟨hc, hrecords θ⟩

end WeldedPath
end
-- END Solutions.SingleCycleCountWelded

open Classical WeldedPath FinitePermutationCoupling

theorem solution :
    ∀ n l : ℕ, Even n → 2 ≤ l → l ≤ n - 4 →
    ∀ G : WeldedInstance n, G.IsValid →
    ∀ (D : Finset G.edges) (h : Equiv.Perm G.edges) (e z : G.edges),
      e.1 ∈ G.weldEdges → e ∉ D →
      (((Finset.univ.filter fun f : G.edges =>
          f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) \ D).card - 1) *
        ((exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).filter
            fun π => π e = z).card ≤
        (exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).card := by
  exact WeldedPath.single_cycle_completion_count_full
