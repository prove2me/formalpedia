namespace StableVotingDistortion.PaperMiddle
open Set MeasureTheory
open StableVotingDistortion.PaperBox
open StableVotingDistortion.PaperCurve
noncomputable section
set_option maxRecDepth 100000
def penaltyLP (p : ℝ) : ℝ := 1+max (entry Knot.eta p-1) 0
def physicalK (p q z : ℝ) : ℝ := totalPrimitive (z-p+q)-totalPrimitive z-totalPrimitive q
def physicalResidual (p q z : ℝ) : ℝ :=
  q+entry Knot.beta p*physicalK p q z+z-PaperCurve.lam+penaltyLP p*totalScore z
end
end StableVotingDistortion.PaperMiddle

