    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
    open Topology in
    by
      classical
      apply continuous_induced_rng.mpr
      apply continuous_pi
      intro y
      change Continuous (fun p : OAI.CoarseAssembly.Rips.Point X r => OAI.CoarseAssembly.Rips.coordinates (OAI.CoarseAssembly.Rips.mapPoint e he p) y)
      by_cases hy : y ∈ Set.range e
      · obtain ⟨x, rfl⟩ := hy
        simpa only [OAI.CoarseAssembly.Rips.coordinates, OAI.CoarseAssembly.Rips.mapPoint, Finsupp.embDomain_apply_self] using
          OAI.CoarseAssembly.Rips.coordinate_continuous (r := r) x
      · have hz : (fun p : OAI.CoarseAssembly.Rips.Point X r => OAI.CoarseAssembly.Rips.coordinates (OAI.CoarseAssembly.Rips.mapPoint e he p) y) = fun _ => 0 := by
          funext p
          exact Finsupp.embDomain_of_notMem_range e p.weight y hy
        rw [hz]
        exact continuous_const
  have OAI.CoarseAssembly.Rips.mapPoint_injective {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} (e : X ↪ Y) (he) : Function.Injective (OAI.CoarseAssembly.Rips.mapPoint (r := r) e he)  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
    open Topology in
    by
      intro p q h
      apply OAI.CoarseAssembly.Rips.Point.ext
      apply Finsupp.ext
      intro x
      have hx := congrArg (fun p : OAI.CoarseAssembly.Rips.Point Y r => p.weight (e x)) h
      simpa only [(
      let local_proof {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} (e : X ↪ Y) (he) (p : OAI.CoarseAssembly.Rips.Point X r) (x : X) :
          (OAI.CoarseAssembly.Rips.mapPoint e he p).weight (e x) = p.weight x :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
          open Topology in
          Finsupp.embDomain_apply_self e p.weight x
      local_proof)] using hx
  have OAI.CoarseAssembly.Rips.mapPoint_embedding {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} (e : X ↪ Y) (he : ∀ x y, dist (e x) (e y) ≤ dist x y) :
      IsEmbedding (OAI.CoarseAssembly.Rips.mapPoint (r := r) e he)  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
    open Topology in
    by
      refine ⟨IsInducing.of_comp (OAI.CoarseAssembly.Rips.mapPoint_continuous e he)
        (show Continuous (fun p : OAI.CoarseAssembly.Rips.Point Y r => fun x : X => p.weight (e x)) from
          continuous_pi (fun x => OAI.CoarseAssembly.Rips.coordinate_continuous (e x))) ?_, OAI.CoarseAssembly.Rips.mapPoint_injective e he⟩
      have hcomp : (fun p : OAI.CoarseAssembly.Rips.Point Y r => fun x : X => p.weight (e x)) ∘ OAI.CoarseAssembly.Rips.mapPoint e he =
          OAI.CoarseAssembly.Rips.coordinates (X := X) (r := r) := by
        funext p x
        exact (
      let local_proof {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} (e : X ↪ Y) (he) (p : OAI.CoarseAssembly.Rips.Point X r) (x : X) :
          (OAI.CoarseAssembly.Rips.mapPoint e he p).weight (e x) = p.weight x :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
          open Topology in
          Finsupp.embDomain_apply_self e p.weight x
      local_proof) e he p x
      rw [hcomp]
      exact ⟨rfl⟩
  have OAI.CoarseAssembly.Rips.range_mapPoint {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} (e : X ↪ Y) (he : ∀ x y, dist (e x) (e y) ≤ dist x y) :
