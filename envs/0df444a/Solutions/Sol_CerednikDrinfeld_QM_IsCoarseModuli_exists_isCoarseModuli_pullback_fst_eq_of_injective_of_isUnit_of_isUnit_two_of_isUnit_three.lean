variable {pt}

theorem liftPt_iso (hX : IsCoarseModuli Λ N X πX pt)
    (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k)) (E E' : FakeEllipticCurve Λ N S)
    (h : FakeEllipticCurve.Iso E E') : liftPt i πX pt S s E = liftPt i πX pt S s E' := by
  have := hX.pt_iso S (s ≫ Spec.map (CommRingCat.ofHom i)) E E' h
  refine Subtype.ext (pullback.hom_ext ?_ ?_)
  · rw [liftPt_fst, liftPt_fst, this]
  · rw [liftPt_snd, liftPt_snd]

