private theorem bialgHom_eq_of_points {R : Type} [CommRing R] {J : Scheme.{0}} {f : J ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (p : ℕ)
    (H₁ : Type) [CommRing H₁] [HopfAlgebra R H₁]
    (e₁ : ∀ (T : Type) [CommRing T] [Algebra R T],
      WithConv (H₁ →ₐ[R] T) ≃ L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap R T))) p)
    (H₂ : Type) [CommRing H₂] [HopfAlgebra R H₂]
    (e₂ : ∀ (T : Type) [CommRing T] [Algebra R T],
      WithConv (H₂ →ₐ[R] T) ≃
        L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap R T))) (p ^ 2))
    (q q' : H₂ →ₐc[R] H₁)
    (hq : ∀ (T : Type) [CommRing T] [Algebra R T] (ψ : WithConv (H₁ →ₐ[R] T)),
      ((e₂ T (.toConv (ψ.ofConv.comp (q : H₂ →ₐ[R] H₁)))).val : SchemeHomOver _ f) = (e₁ T ψ).val)
    (hq' : ∀ (T : Type) [CommRing T] [Algebra R T] (ψ : WithConv (H₁ →ₐ[R] T)),
      ((e₂ T (.toConv (ψ.ofConv.comp (q' : H₂ →ₐ[R] H₁)))).val : SchemeHomOver _ f) = (e₁ T ψ).val) :
    q = q' := by
  have key : (AlgHom.id R H₁).comp (q : H₂ →ₐ[R] H₁) = (AlgHom.id R H₁).comp (q' : H₂ →ₐ[R] H₁) := by
    have h := (hq H₁ (.toConv (AlgHom.id R H₁))).trans (hq' H₁ (.toConv (AlgHom.id R H₁))).symm
    exact congrArg WithConv.ofConv ((e₂ H₁).injective (Subtype.ext h))
  rw [AlgHom.id_comp, AlgHom.id_comp] at key
  exact BialgHom.coe_algHom_injective key

