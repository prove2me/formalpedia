  have hinjU : Function.Injective (unitT (R := R) (S := S) (T := T) (M := M)) := fun x y hxy =>
    hinj1 x y (by rw [← he 1 x, ← he 1 y]; exact congrArg e hxy)
  have hΦu : ∀ i x, Φ i (unitT x) = unitT (g i x) := fun i x => hΦ i 1 x
