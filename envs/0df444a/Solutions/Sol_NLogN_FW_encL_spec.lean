  have : (L.length + n - 1) / n = 1 := Nat.div_eq_of_lt_le (by omega) (by omega)
  rw [this]; simp [List.take_of_length_le hL]

theorem flatten_chunkL {α : Type*} (n : ℕ) (hn : 0 < n) (L : List α) :
    (Ref.chunkL n L).flatten = L := by
  induction' h : L.length using Nat.strong_induction_on with m ih generalizing L
  by_cases hL : n ≤ L.length
