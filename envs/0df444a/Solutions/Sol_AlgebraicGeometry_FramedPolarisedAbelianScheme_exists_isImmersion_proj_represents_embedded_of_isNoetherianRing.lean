theorem ideal_eq_of_forall_le_ker_iff {R : Type} [CommRing R] {I J : Ideal R}
    (h : ∀ (R' : Type) [CommRing R'] (χ : R →+* R'), I ≤ RingHom.ker χ ↔ J ≤ RingHom.ker χ) : I = J := by
  apply le_antisymm
  · have := (h (R ⧸ J) (Ideal.Quotient.mk J)).mpr (by rw [Ideal.mk_ker]); rwa [Ideal.mk_ker] at this
  · have := (h (R ⧸ I) (Ideal.Quotient.mk I)).mp (by rw [Ideal.mk_ker]); rwa [Ideal.mk_ker] at this

theorem set_eq_of_forall_range_comap_subset_iff {R : Type} [CommRing R] (U V : Set (PrimeSpectrum R))
    (h : ∀ (R' : Type) [CommRing R'] (χ : R →+* R'),
      Set.range (PrimeSpectrum.comap χ) ⊆ U ↔ Set.range (PrimeSpectrum.comap χ) ⊆ V) : U = V := by
  ext 𝔭
  have key := h 𝔭.asIdeal.ResidueField (algebraMap R 𝔭.asIdeal.ResidueField)
  rw [PrimeSpectrum.residueField_comap, Set.singleton_subset_iff, Set.singleton_subset_iff] at key
  exact key

structure KCtx (B : Type) [CommRing B] (N g : ℕ) (hf : ℕ → ℕ) where
  Hilb : Scheme.{0}
  ptH : ∀ (A : Type) [CommRing A], Point A N hf ≃ (Spec (CommRingCat.of A) ⟶ Hilb)
  ptH_nat : ∀ (A A' : Type) [CommRing A] [CommRing A'] (φ : A →+* A') (x : Point A N hf) (y : Point A' N hf),
    y.I = Ideal.map (MvPolynomial.map φ) x.I ↔ ptH A' y = Spec.map (CommRingCat.ofHom φ) ≫ ptH A x
  ptH_map : ∀ (A A' : Type) [CommRing A] [CommRing A'] (φ : A →+* A') (x : Point A N hf),
    ∃ y : Point A' N hf, y.I = Ideal.map (MvPolynomial.map φ) x.I
  Φ : ∀ (A : Type) [CommRing A], Point A N hf → (Z : Scheme.{0}) × (Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A))
  Φ_closed : ∀ (A : Type) [CommRing A] (p : Point A N hf),
    IsClosedImmersion (Φ A p).2 ∧ Flat ((Φ A p).2 ≫ ProjSpace.π A N) ∧ LocallyOfFinitePresentation ((Φ A p).2 ≫ ProjSpace.π A N)
  Φ_inj : ∀ (A : Type) [CommRing A] (p p' : Point A N hf),
    (∃ e : (Φ A p).1 ≅ (Φ A p').1, e.hom ≫ (Φ A p').2 = (Φ A p).2) → p = p'
  Φ_bc : ∀ (A A' : Type) [CommRing A] [CommRing A'] [Algebra A A'] (p : Point A N hf) (p' : Point A' N hf),
    p'.I = Ideal.map (MvPolynomial.map (algebraMap A A')) p.I →
    ∃ e : (Φ A' p').1 ⟶ (Φ A p).1,
      IsPullback e ((Φ A' p').2 ≫ ProjSpace.π A' N) ((Φ A p).2 ≫ ProjSpace.π A N) (Spec.map (CommRingCat.ofHom (algebraMap A A'))) ∧
      e ≫ (Φ A p).2 = (Φ A' p').2 ≫ ProjSpace.map A A' N
  W₀ : Scheme.{0}
  πW : W₀ ⟶ Spec (CommRingCat.of B)
  M : ℕ
  jW : W₀ ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B)
  jW_closed : IsClosedImmersion jW
  jW_π : jW ≫ ProjSpace.π B M = πW
  prH : W₀ ⟶ Hilb
  prY : Fin (2 * g + 1) → (W₀ ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))
  hprY : ∀ i, prY i ≫ ProjSpace.π B N = πW
  hW : ∀ (R : Type) [CommRing R] [Algebra B R],
    Function.Bijective
      (fun s : {s : Spec (CommRingCat.of R) ⟶ W₀ // s ≫ πW = Spec.map (CommRingCat.ofHom (algebraMap B R))} =>
        (⟨(s.1 ≫ prH, fun i => s.1 ≫ prY i), fun i => by rw [Category.assoc, hprY i, s.2]⟩ :
          {y : (Spec (CommRingCat.of R) ⟶ Hilb) × (Fin (2 * g + 1) → (Spec (CommRingCat.of R) ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))) //
            ∀ i, y.2 i ≫ ProjSpace.π B N = Spec.map (CommRingCat.ofHom (algebraMap B R))}))

namespace KCtx

variable {B : Type} [CommRing B] {N g : ℕ} {hf : ℕ → ℕ} (C : KCtx B N g hf)

noncomputable def β {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : B →+* R :=
  (Scheme.Spec.preimage (s ≫ C.πW)).unop.hom

theorem specMap_β {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) :
    Spec.map (CommRingCat.ofHom (C.β s)) = s ≫ C.πW := by
  show Spec.map (Scheme.Spec.preimage (s ≫ C.πW)).unop = _
  exact Scheme.Spec.map_preimage (s ≫ C.πW)

noncomputable def q {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : Point R N hf := (C.ptH R).symm (s ≫ C.prH)

noncomputable def Z {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : Scheme.{0} := (C.Φ R (C.q s)).1

noncomputable def ι {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : C.Z s ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) := (C.Φ R (C.q s)).2

noncomputable def f {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : C.Z s ⟶ Spec (CommRingCat.of R) :=
  C.ι s ≫ ProjSpace.π R N

scoped instance {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : IsClosedImmersion (C.ι s) := (C.Φ_closed R (C.q s)).1
scoped instance {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : Flat (C.f s) := (C.Φ_closed R (C.q s)).2.1
scoped instance {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : LocallyOfFinitePresentation (C.f s) := (C.Φ_closed R (C.q s)).2.2

noncomputable def ysec {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1)) :
    Spec (CommRingCat.of R) ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) :=
  letI : Algebra B R := (C.β s).toAlgebra
  (AlgebraicGeometry.ProjSpace.isPullback_map B R N).lift (s ≫ C.prY j) (𝟙 _)
    (by rw [Category.assoc, C.hprY, Category.id_comp]; exact (C.specMap_β s).symm)

theorem ysec_π {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1)) :
    C.ysec s j ≫ ProjSpace.π R N = 𝟙 _ := by
  letI : Algebra B R := (C.β s).toAlgebra
  exact (AlgebraicGeometry.ProjSpace.isPullback_map B R N).lift_snd _ _ _

theorem ysec_map {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1)) :
    letI : Algebra B R := (C.β s).toAlgebra
    C.ysec s j ≫ ProjSpace.map B R N = s ≫ C.prY j := by
  letI : Algebra B R := (C.β s).toAlgebra
  exact (AlgebraicGeometry.ProjSpace.isPullback_map B R N).lift_fst _ _ _

theorem β_comp {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀) :
    C.β (Spec.map (CommRingCat.ofHom ψ) ≫ s) = ψ.comp (C.β s) := by
  have h : Spec.map (CommRingCat.ofHom (C.β (Spec.map (CommRingCat.ofHom ψ) ≫ s))) =
      Spec.map (CommRingCat.ofHom (ψ.comp (C.β s))) := by
    rw [specMap_β, Category.assoc, ← specMap_β, ← Spec.map_comp]; rfl
  have := Spec.map_injective h
  exact congrArg CommRingCat.Hom.hom this

theorem q_comp_I {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀) :
    (C.q (Spec.map (CommRingCat.ofHom ψ) ≫ s)).I = Ideal.map (MvPolynomial.map ψ) (C.q s).I := by
  apply (C.ptH_nat R R' ψ (C.q s) (C.q _)).mpr
  simp only [q, Equiv.apply_symm_apply, Category.assoc]

theorem exists_cmp {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀) :
    letI : Algebra R R' := ψ.toAlgebra
    ∃ e : C.Z (Spec.map (CommRingCat.ofHom ψ) ≫ s) ⟶ C.Z s,
      IsPullback e (C.f (Spec.map (CommRingCat.ofHom ψ) ≫ s)) (C.f s) (Spec.map (CommRingCat.ofHom ψ)) ∧
      e ≫ C.ι s = C.ι (Spec.map (CommRingCat.ofHom ψ) ≫ s) ≫ ProjSpace.map R R' N := by
  letI : Algebra R R' := ψ.toAlgebra
  exact C.Φ_bc R R' (C.q s) (C.q _) (C.q_comp_I ψ s)

theorem map_comp_map (A B' C' : Type) [CommRing A] [CommRing B'] [CommRing C'] [Algebra A B'] [Algebra B' C'] [Algebra A C']
    [IsScalarTower A B' C'] (n : ℕ) :
    ProjSpace.map B' C' n ≫ ProjSpace.map A B' n = ProjSpace.map A C' n := by
  have h := (AlgebraicGeometry.ProjSpace.isPullback_comp_and_comp_eq_map_of_isScalarTower (A := A) B' C' (n := n)
    (𝟙 _) (𝟙 _) (𝟙 _) (ProjSpace.map A B' n) (ProjSpace.map B' C' n)
    (by simpa using AlgebraicGeometry.ProjSpace.isPullback_map A B' n) (by simp)
    (by simpa using AlgebraicGeometry.ProjSpace.isPullback_map B' C' n) (by simp)).2
  simpa using h

theorem ysec_comp {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (j : Fin (2 * g + 1)) :
    letI : Algebra R R' := ψ.toAlgebra
    C.ysec (Spec.map (CommRingCat.ofHom ψ) ≫ s) j ≫ ProjSpace.map R R' N = Spec.map (CommRingCat.ofHom ψ) ≫ C.ysec s j := by
  letI : Algebra R R' := ψ.toAlgebra
  letI iB : Algebra B R := (C.β s).toAlgebra
  letI iB' : Algebra B R' := (C.β (Spec.map (CommRingCat.ofHom ψ) ≫ s)).toAlgebra
  haveI : IsScalarTower B R R' := IsScalarTower.of_algebraMap_eq (fun b => by
    show (C.β (Spec.map (CommRingCat.ofHom ψ) ≫ s)) b = ψ ((C.β s) b)
    rw [β_comp]; rfl)
  apply (AlgebraicGeometry.ProjSpace.isPullback_map B R N).hom_ext
  · rw [Category.assoc, map_comp_map B R R' N, ysec_map]
    simp only [Category.assoc]
    rw [ysec_map]
  · rw [Category.assoc, (AlgebraicGeometry.ProjSpace.isPullback_map R R' N).w, ← Category.assoc, ysec_π, Category.id_comp,
      Category.assoc, ysec_π, Category.comp_id]

noncomputable def Jsec {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1)) : Ideal R :=
  Classical.choose (AlgebraicGeometry.exists_ideal_forall_exists_comp_eq_specMap_comp_iff_le_ker_of_isClosedImmersion
    (C.ι s) (C.ysec s j))

theorem Jsec_spec {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1))
    (R' : Type) [CommRing R'] (ψ : R →+* R') :
    (∃ z : Spec (CommRingCat.of R') ⟶ C.Z s, z ≫ C.ι s = Spec.map (CommRingCat.ofHom ψ) ≫ C.ysec s j) ↔ C.Jsec s j ≤ RingHom.ker ψ :=
  Classical.choose_spec (AlgebraicGeometry.exists_ideal_forall_exists_comp_eq_specMap_comp_iff_le_ker_of_isClosedImmersion
    (C.ι s) (C.ysec s j)) R' ψ

theorem Jsec_eq_bot_iff {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (j : Fin (2 * g + 1)) :
    C.Jsec s j = ⊥ ↔ ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j := by
  have hk : RingHom.ker (RingHom.id R) = ⊥ := by ext; simp [RingHom.mem_ker]
  rw [← le_bot_iff, ← hk, ← C.Jsec_spec s j R (RingHom.id R)]
  simp only [CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]

theorem Jsec_comp {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (j : Fin (2 * g + 1)) : C.Jsec (Spec.map (CommRingCat.ofHom ψ) ≫ s) j = (C.Jsec s j).map ψ := by
  letI : Algebra R R' := ψ.toAlgebra
  apply ideal_eq_of_forall_le_ker_iff
  intro R'' _ χ
  have hcomap : (C.Jsec s j).map ψ ≤ RingHom.ker χ ↔ C.Jsec s j ≤ RingHom.ker (χ.comp ψ) := by
    rw [Ideal.map_le_iff_le_comap, ← RingHom.comap_ker]
  rw [hcomap, ← C.Jsec_spec _ j R'' χ, ← C.Jsec_spec s j R'' (χ.comp ψ)]
  obtain ⟨e, hpb, he⟩ := C.exists_cmp ψ s
  have hy := C.ysec_comp ψ s j
  constructor
  · rintro ⟨z', hz'⟩
    refine ⟨z' ≫ e, ?_⟩
    rw [Category.assoc, he, ← Category.assoc, hz', Category.assoc, hy, ← Category.assoc, ← Spec.map_comp]; rfl
  · rintro ⟨z, hz⟩
    have hcomm : z ≫ C.f s = Spec.map (CommRingCat.ofHom χ) ≫ Spec.map (CommRingCat.ofHom ψ) := by
      rw [KCtx.f, ← Category.assoc, hz, Category.assoc, ysec_π, Category.comp_id, ← Spec.map_comp]; rfl
    refine ⟨hpb.lift z (Spec.map (CommRingCat.ofHom χ)) hcomm, ?_⟩
    apply (AlgebraicGeometry.ProjSpace.isPullback_map R R' N).hom_ext
    · rw [Category.assoc, ← he, ← Category.assoc, hpb.lift_fst, hz, Category.assoc, hy, ← Category.assoc, ← Spec.map_comp]; rfl
    · rw [Category.assoc, Category.assoc, ysec_π, Category.comp_id, show C.ι _ ≫ ProjSpace.π R' N = C.f _ from rfl, hpb.lift_snd]

theorem exists_I₁ :
    ∃ I₁ : ∀ (R : Type) [CommRing R], (Spec (CommRingCat.of R) ⟶ C.W₀) → Ideal R,
      (∀ (R R' : Type) [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀),
        I₁ R' (Spec.map (CommRingCat.ofHom ψ) ≫ s) = (I₁ R s).map ψ) ∧
      (∀ (R : Type) [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀),
        I₁ R s = ⊥ ↔ ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j) := by
  refine ⟨fun R _ s => ⨆ j, C.Jsec s j, fun R R' _ _ ψ s => ?_, fun R _ s => ?_⟩
  · rw [Ideal.map_iSup]
    exact iSup_congr fun j => C.Jsec_comp ψ s j
  · rw [iSup_eq_bot]
    exact forall_congr' fun j => C.Jsec_eq_bot_iff s j

def U₂ {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : Set ↥(Spec (CommRingCat.of R)) :=
  {t | ∀ (k : Type) [Field k] [IsAlgClosed k] (x : R →+* k), RingHom.ker x = t.asIdeal →
    Smooth (pullback.snd (C.f s) (Spec.map (CommRingCat.ofHom x))) ∧
    IrreducibleSpace ↥(pullback (C.f s) (Spec.map (CommRingCat.ofHom x))) ∧
    topologicalKrullDim ↥(pullback (C.f s) (Spec.map (CommRingCat.ofHom x))) = g ∧
    Nonempty (RelativeGroupLaw k (pullback.snd (C.f s) (Spec.map (CommRingCat.ofHom x))))}

scoped instance isProper_f {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : IsProper (C.f s) := by
  show IsProper (C.ι s ≫ ProjSpace.π R N)
  infer_instance

theorem hproj_f {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) :
    ∃ (N' : ℕ) (ι : C.Z s ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) R)),
      IsClosedImmersion ι ∧ ι ≫ ProjSpace.π R N' = C.f s :=
  ⟨N, C.ι s, inferInstance, rfl⟩

noncomputable def secOf {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (h₁ : ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s 0) :
    SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) (C.f s) :=
  ⟨h₁.choose, by rw [f, ← Category.assoc, h₁.choose_spec, ysec_π]⟩

theorem isOpen_U₂ {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (h₁ : ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s 0) : IsOpen (C.U₂ s) :=
  (GoodReductionJacobian.AbelianSchemePropertyBundle.isOpen_setOf_abelian_geometricFibre_and_preimage_eq_of_isPullback
    (C.f s) (C.hproj_f s) g (C.secOf s h₁)).1

theorem U₂_comp {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (h₁ : ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s 0) :
    C.U₂ (Spec.map (CommRingCat.ofHom ψ) ≫ s) = (Spec.map (CommRingCat.ofHom ψ)).base ⁻¹' (C.U₂ s) := by
  obtain ⟨e, hpb, -⟩ := C.exists_cmp ψ s
  exact (GoodReductionJacobian.AbelianSchemePropertyBundle.isOpen_setOf_abelian_geometricFibre_and_preimage_eq_of_isPullback
    (C.f s) (C.hproj_f s) g (C.secOf s h₁)).2 R' ψ (C.Z (Spec.map (CommRingCat.ofHom ψ) ≫ s))
    (C.f (Spec.map (CommRingCat.ofHom ψ) ≫ s)) e hpb

section L3
variable {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀)
  (h₁ : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j)
  (h₂ : C.U₂ s = Set.univ)

noncomputable def zsec (j : Fin (2 * g + 1)) : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) (C.f s) :=
  ⟨Classical.choose (h₁ j), by
    rw [KCtx.f, ← Category.assoc, Classical.choose_spec (h₁ j), ysec_π]⟩

theorem zsec_ι (j : Fin (2 * g + 1)) : (C.zsec s h₁ j).1 ≫ C.ι s = C.ysec s j := Classical.choose_spec (h₁ j)

include h₂ in
theorem hab : ∀ (t : ↥(Spec (CommRingCat.of R))) (k : Type) [Field k] [IsAlgClosed k] (x : R →+* k),
    RingHom.ker x = t.asIdeal →
    Smooth (pullback.snd (C.f s) (Spec.map (CommRingCat.ofHom x))) ∧
    IrreducibleSpace ↥(pullback (C.f s) (Spec.map (CommRingCat.ofHom x))) ∧
    topologicalKrullDim ↥(pullback (C.f s) (Spec.map (CommRingCat.ofHom x))) = g ∧
    Nonempty (RelativeGroupLaw k (pullback.snd (C.f s) (Spec.map (CommRingCat.ofHom x)))) := by
  intro t
  have : t ∈ C.U₂ s := by rw [h₂]; exact Set.mem_univ t
  exact this

noncomputable def law : RelativeGroupLaw R (C.f s) :=
  Classical.choose (GoodReductionJacobian.exists_relativeGroupLaw_one_eq_and_isCommutative_of_forall_abelian_geometricFibre
    (C.f s) (C.hproj_f s) g (C.zsec s h₁ 0) (C.hab s h₂))

theorem law_spec : (C.law s h₁ h₂).one (𝟙 _) = C.zsec s h₁ 0 ∧ (C.law s h₁ h₂).IsCommutative ∧
    ∀ L' : RelativeGroupLaw R (C.f s), L'.one (𝟙 _) = C.zsec s h₁ 0 → L' = C.law s h₁ h₂ :=
  Classical.choose_spec (GoodReductionJacobian.exists_relativeGroupLaw_one_eq_and_isCommutative_of_forall_abelian_geometricFibre
    (C.f s) (C.hproj_f s) g (C.zsec s h₁ 0) (C.hab s h₂))

include h₂ in
theorem smooth_f : Smooth (C.f s) := by
  obtain ⟨-, hV⟩ := AlgebraicGeometry.isOpen_setOf_smooth_irreducibleSpace_geometricFibre_of_isProper_of_flat (C.f s) g
  have htop : Smooth (C.f s ∣_ ⊤) := hV ⊤ (fun t _ k _ _ x hx => let h := C.hab s h₂ t k x hx; ⟨h.1, h.2.1, h.2.2.1⟩)
  exact AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top (P := @Smooth) (f := C.f s) (fun _ : Unit => ⊤) (by simp)
    (fun _ => htop)

include h₂ in
theorem topfibre (t : ↥(Spec (CommRingCat.of R))) :
    _root_.IsConnected ((C.f s).base ⁻¹' {t}) ∧ topologicalKrullDim ↥((C.f s).base ⁻¹' {t}) = g :=
  AlgebraicGeometry.isConnected_preimage_and_topologicalKrullDim_eq_of_forall_geometricFibre (C.f s) g
    (fun t k _ _ x hx => let h := C.hab s h₂ t k x hx; ⟨h.1, h.2.1, h.2.2.1⟩) t

include h₁ h₂ in

theorem bundle : AbelianSchemePropertyBundle R (C.f s) :=
  ⟨C.smooth_f s h₂, inferInstance, fun t => (C.topfibre s h₂ t).1, ⟨C.law s h₁ h₂⟩⟩

noncomputable def Tsec (n : ℕ) (i : Fin (2 * g)) : Ideal R :=
  Classical.choose (GoodReductionJacobian.RelativeGroupLaw.exists_ideal_nsmul_eq_one_iff_le_ker
    (C.law s h₁ h₂) (C.bundle s h₁ h₂) n (C.zsec s h₁ ⟨i.1 + 1, by omega⟩))

theorem Tsec_spec (n : ℕ) (i : Fin (2 * g)) (R' : Type) [CommRing R'] (φ : R →+* R') :
    (C.law s h₁ h₂).nsmul (Spec.map (CommRingCat.ofHom φ)) n
        (schemeHomOverComp (Spec.map (CommRingCat.ofHom φ)) (Category.comp_id _) (C.zsec s h₁ ⟨i.1 + 1, by omega⟩)) =
      (C.law s h₁ h₂).one (Spec.map (CommRingCat.ofHom φ)) ↔ C.Tsec s h₁ h₂ n i ≤ RingHom.ker φ :=
  Classical.choose_spec (GoodReductionJacobian.RelativeGroupLaw.exists_ideal_nsmul_eq_one_iff_le_ker
    (C.law s h₁ h₂) (C.bundle s h₁ h₂) n (C.zsec s h₁ ⟨i.1 + 1, by omega⟩)) R' φ

noncomputable def I₃ (n : ℕ) : Ideal R := ⨆ i, C.Tsec s h₁ h₂ n i

noncomputable def Psec (i : Fin (2 * g)) : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) (C.f s) :=
  C.zsec s h₁ ⟨i.1 + 1, by omega⟩

def U₄lev (n : ℕ) : Set ↥(Spec (CommRingCat.of R)) :=
  {t | ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R →+* k), RingHom.ker sk = t.asIdeal →
    (∀ c c' : Fin (2 * g) → Fin n,
      (C.law s h₁ h₂).finComb (Spec.map (CommRingCat.ofHom sk))
          (fun i => schemeHomOverComp (Spec.map (CommRingCat.ofHom sk)) (Category.comp_id _) (C.Psec s h₁ i)) (fun i => (c i : ℕ)) =
        (C.law s h₁ h₂).finComb (Spec.map (CommRingCat.ofHom sk))
          (fun i => schemeHomOverComp (Spec.map (CommRingCat.ofHom sk)) (Category.comp_id _) (C.Psec s h₁ i)) (fun i => (c' i : ℕ)) →
      c = c') ∧
    (∀ Q : SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) (C.f s),
      (C.law s h₁ h₂).nsmul (Spec.map (CommRingCat.ofHom sk)) n Q = (C.law s h₁ h₂).one (Spec.map (CommRingCat.ofHom sk)) →
      ∃ c : Fin (2 * g) → Fin n,
        (C.law s h₁ h₂).finComb (Spec.map (CommRingCat.ofHom sk))
          (fun i => schemeHomOverComp (Spec.map (CommRingCat.ofHom sk)) (Category.comp_id _) (C.Psec s h₁ i)) (fun i => (c i : ℕ)) = Q)}

noncomputable def polMod : (C.Z s).Modules :=
  Classical.choose (AlgebraicGeometry.ProjSpace.exists_projPresentation_toProj_eq_and_locallyTrivial (C.ι s))

noncomputable def polPres : (C.polMod s).ProjPresentation (C.f s) N :=
  Classical.choose (Classical.choose_spec (AlgebraicGeometry.ProjSpace.exists_projPresentation_toProj_eq_and_locallyTrivial (C.ι s)))

theorem polPres_toProj : (C.polPres s).toProj = C.ι s :=
  (Classical.choose_spec (Classical.choose_spec
    (AlgebraicGeometry.ProjSpace.exists_projPresentation_toProj_eq_and_locallyTrivial (C.ι s)))).1

theorem polMod_isInvertible : Scheme.Modules.IsInvertible (C.polMod s) :=
  ⟨(Classical.choose_spec (Classical.choose_spec
    (AlgebraicGeometry.ProjSpace.exists_projPresentation_toProj_eq_and_locallyTrivial (C.ι s)))).2⟩

theorem polMod_closedImmersionBySections : Scheme.Modules.ClosedImmersionBySections (C.polMod s) (C.f s) :=
  ⟨N, C.polPres s, by rw [polPres_toProj]; infer_instance⟩

noncomputable def U₄lin : Set ↥(Spec (CommRingCat.of R)) :=
  Classical.choose (GoodReductionJacobian.AbelianSchemePropertyBundle.exists_isOpen_forall_isSectionBasisOn_pullback_iff
    (C.law s h₁ h₂) (C.bundle s h₁ h₂) (C.polMod s) (C.polMod_isInvertible s) (C.polMod_closedImmersionBySections s)
    (C.polPres s).σ)

theorem U₄lin_spec : IsOpen (C.U₄lin s h₁ h₂) ∧
    ∀ (S' : Type) [CommRing S'] (φ : R →+* S')
      (A' : Scheme) (f' : A' ⟶ Spec (CommRingCat.of S')) (gA : A' ⟶ C.Z s),
      IsPullback gA f' (C.f s) (Spec.map (CommRingCat.ofHom φ)) →
      (Scheme.Modules.IsSectionBasisOn f' ((Scheme.Modules.pullback gA).obj (C.polMod s)) (gA ⁻¹ᵁ ⊤)
          (fun i => Scheme.Modules.pullbackLocalSection gA ((C.polPres s).σ i)) ↔
        Set.range (PrimeSpectrum.comap φ) ⊆ C.U₄lin s h₁ h₂) :=
  Classical.choose_spec (GoodReductionJacobian.AbelianSchemePropertyBundle.exists_isOpen_forall_isSectionBasisOn_pullback_iff
    (C.law s h₁ h₂) (C.bundle s h₁ h₂) (C.polMod s) (C.polMod_isInvertible s) (C.polMod_closedImmersionBySections s)
    (C.polPres s).σ)

noncomputable def U₄ (n : ℕ) : Set ↥(Spec (CommRingCat.of R)) := C.U₄lev s h₁ h₂ n ∩ C.U₄lin s h₁ h₂

end L3

section HomTransport

variable {R R' : Type} [CommRing R] [CommRing R'] {A A' : Scheme.{0}}
  {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R')}
  (ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)) (gA : A' ⟶ A) (w : gA ≫ f = f' ≫ ι)
  (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R' f')

def pushAlong {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of R')} (P : SchemeHomOver t' f') : SchemeHomOver (t' ≫ ι) f :=
  ⟨P.1 ≫ gA, by rw [Category.assoc, w, ← Category.assoc, P.2]⟩

@[scoped simp] theorem pushAlong_coe {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of R')} (P : SchemeHomOver t' f') :
    (pushAlong ι gA w P).1 = P.1 ≫ gA := rfl

variable (hmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) (x y : SchemeHomOver t' f'),
    (L'.mul t' x y).1 ≫ gA = (L.mul (t' ≫ ι) (pushAlong ι gA w x) (pushAlong ι gA w y)).1)

include hmul in
theorem one_comp_of_mul_comp {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) :
    (L'.one t').1 ≫ gA = (L.one (t' ≫ ι)).1 := by
  letI := L.pointGroup (t' ≫ ι)
  letI := L'.pointGroup t'
  have hΦ : ∀ x y : SchemeHomOver t' f', pushAlong ι gA w (x * y) = pushAlong ι gA w x * pushAlong ι gA w y :=
    fun x y => Subtype.ext (hmul t' x y)
  have h1 : pushAlong ι gA w (1 : SchemeHomOver t' f') = 1 := by
    have h := hΦ 1 1
    rw [mul_one] at h
    exact left_eq_mul.mp h
  exact congrArg Subtype.val h1

include hmul in
theorem nsmul_comp_of_mul_comp {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) (n : ℕ) (P : SchemeHomOver t' f') :
    (L'.nsmul t' n P).1 ≫ gA = (L.nsmul (t' ≫ ι) n (pushAlong ι gA w P)).1 := by
  induction n with
  | zero => simp only [RelativeGroupLaw.nsmul_zero]; exact one_comp_of_mul_comp ι gA w L L' hmul t'
  | succ n ih =>
    rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hmul]
    have : pushAlong ι gA w (L'.nsmul t' n P) = L.nsmul (t' ≫ ι) n (pushAlong ι gA w P) := Subtype.ext ih
    rw [this]

end HomTransport

theorem nsmul_coe_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (ht : t₁ = t₂) (n : ℕ)
    (P₁ : SchemeHomOver t₁ f) (P₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) :
    (L.nsmul t₁ n P₁).1 = (L.nsmul t₂ n P₂).1 := by
  subst ht
  rw [Subtype.ext hP]

theorem one_coe_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (ht : t₁ = t₂) :
    (L.one t₁).1 = (L.one t₂).1 := by
  subst ht; rfl

section L3compat
variable {R R' : Type} [CommRing R] [CommRing R'] (ψ : R →+* R') (s : Spec (CommRingCat.of R) ⟶ C.W₀)
  (h₁ : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j)
  (h₂ : C.U₂ s = Set.univ)
  (h₁' : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R') ⟶ C.Z (Spec.map (CommRingCat.ofHom ψ) ≫ s),
    z ≫ C.ι (Spec.map (CommRingCat.ofHom ψ) ≫ s) = C.ysec (Spec.map (CommRingCat.ofHom ψ) ≫ s) j)
  (h₂' : C.U₂ (Spec.map (CommRingCat.ofHom ψ) ≫ s) = Set.univ)
  (e : C.Z (Spec.map (CommRingCat.ofHom ψ) ≫ s) ⟶ C.Z s)
  (hpb : IsPullback e (C.f (Spec.map (CommRingCat.ofHom ψ) ≫ s)) (C.f s) (Spec.map (CommRingCat.ofHom ψ)))
  (he : letI : Algebra R R' := ψ.toAlgebra; e ≫ C.ι s = C.ι (Spec.map (CommRingCat.ofHom ψ) ≫ s) ≫ ProjSpace.map R R' N)

include he in

theorem zsec_comp (j : Fin (2 * g + 1)) :
    (C.zsec (Spec.map (CommRingCat.ofHom ψ) ≫ s) h₁' j).1 ≫ e = Spec.map (CommRingCat.ofHom ψ) ≫ (C.zsec s h₁ j).1 := by
  letI : Algebra R R' := ψ.toAlgebra
  rw [← cancel_mono (C.ι s), Category.assoc, he, ← Category.assoc, zsec_ι, Category.assoc, zsec_ι]
  exact C.ysec_comp ψ s j

include he in

theorem law_comp {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R'))
    (x y : SchemeHomOver t' (C.f (Spec.map (CommRingCat.ofHom ψ) ≫ s))) :
    ((C.law (Spec.map (CommRingCat.ofHom ψ) ≫ s) h₁' h₂').mul t' x y).1 ≫ e =
      ((C.law s h₁ h₂).mul (t' ≫ Spec.map (CommRingCat.ofHom ψ))
        ⟨x.1 ≫ e, by rw [Category.assoc, hpb.w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ e, by rw [Category.assoc, hpb.w, ← Category.assoc, y.2]⟩).1 := by
  refine GoodReductionJacobian.RelativeGroupLaw.mul_comp_eq_mul_of_isPullback_of_one_comp_eq ψ e hpb
    (C.law s h₁ h₂) (C.law _ h₁' h₂') (C.bundle _ h₁' h₂') ?_ t' x y
  rw [(C.law_spec s h₁ h₂).1, (C.law_spec _ h₁' h₂').1]
  exact C.zsec_comp ψ s h₁ h₁' e he 0

include he h₂ h₂' hpb in
theorem nsmul_zsec_comp {R'' : Type} [CommRing R''] (χ : R' →+* R'') (n : ℕ) (j : Fin (2 * g + 1)) :
    ((C.law (Spec.map (CommRingCat.ofHom ψ) ≫ s) h₁' h₂').nsmul (Spec.map (CommRingCat.ofHom χ)) n
        (schemeHomOverComp (Spec.map (CommRingCat.ofHom χ)) (Category.comp_id _) (C.zsec _ h₁' j))).1 ≫ e =
      ((C.law s h₁ h₂).nsmul (Spec.map (CommRingCat.ofHom (χ.comp ψ))) n
        (schemeHomOverComp (Spec.map (CommRingCat.ofHom (χ.comp ψ))) (Category.comp_id _) (C.zsec s h₁ j))).1 := by
  rw [nsmul_comp_of_mul_comp (Spec.map (CommRingCat.ofHom ψ)) e hpb.w (C.law s h₁ h₂) (C.law _ h₁' h₂')
    (fun t' x y => C.law_comp ψ s h₁ h₂ h₁' h₂' e hpb he t' x y)]
  apply nsmul_coe_congr
  · rw [← Spec.map_comp]; rfl
  · simp only [pushAlong_coe, GoodReductionJacobian.schemeHomOverComp_coe, Category.assoc]
    rw [C.zsec_comp ψ s h₁ h₁' e he j, ← Category.assoc, ← Spec.map_comp]
    rfl

include he h₂ h₂' hpb in
theorem one_comp' {R'' : Type} [CommRing R''] (χ : R' →+* R'') :
    ((C.law (Spec.map (CommRingCat.ofHom ψ) ≫ s) h₁' h₂').one (Spec.map (CommRingCat.ofHom χ))).1 ≫ e =
      ((C.law s h₁ h₂).one (Spec.map (CommRingCat.ofHom (χ.comp ψ)))).1 := by
  rw [one_comp_of_mul_comp (Spec.map (CommRingCat.ofHom ψ)) e hpb.w (C.law s h₁ h₂) (C.law _ h₁' h₂')
    (fun t' x y => C.law_comp ψ s h₁ h₂ h₁' h₂' e hpb he t' x y)]
  apply one_coe_congr
  rw [← Spec.map_comp]; rfl

include he h₂ h₂' hpb in
theorem Tsec_comp (n : ℕ) (i : Fin (2 * g)) :
    C.Tsec (Spec.map (CommRingCat.ofHom ψ) ≫ s) h₁' h₂' n i = (C.Tsec s h₁ h₂ n i).map ψ := by
  apply ideal_eq_of_forall_le_ker_iff
  intro R'' _ χ
  rw [Ideal.map_le_iff_le_comap, RingHom.comap_ker χ ψ, ← C.Tsec_spec s h₁ h₂ n i R'' (χ.comp ψ), ← C.Tsec_spec _ h₁' h₂' n i R'' χ]
  constructor
  · intro h
    apply Subtype.ext
