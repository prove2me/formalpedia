import Definitions.Def_IntMul_HvdH_M_Defs8

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000


section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.GL
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
theorem solution {M : NLogN.MulSpec} (a b : NLogN.RM) (s t u : NLogN.IState NLogN.HS) (Ca Cb : ℕ)
    (ha : a.run s = t ∧ a.ok M s ∧ a.cost M s ≤ Ca)
    (hb : b.run t = u ∧ b.ok M t ∧ b.cost M t ≤ Cb) :
    (NLogN.RM.seq a b).run s = u ∧ (NLogN.RM.seq a b).ok M s ∧ (NLogN.RM.seq a b).cost M s ≤ Ca + Cb := by
  obtain ⟨r1, o1, c1⟩ := ha
  obtain ⟨r2, o2, c2⟩ := hb
  refine ⟨?_, ⟨o1, ?_⟩, ?_⟩
  · show b.run (a.run s) = u; rw [r1, r2]
  · rw [r1]; exact o2
  · show a.cost M s + b.cost M (a.run s) ≤ _; rw [r1]; omega
end
