-- url     : https://prove2.me/theorems/eb51f3fe-8996-4864-9058-31fea2c4148e
-- title:
--   (2.24) — (Ψ(x^ag_N) − Ψ(x))/Γ_N ≤ ‖x_0 − x‖²/(2λ_1) − Σ_{k≤N} (β_k/(2Γ_k))(1 − L_Ψβ_k)‖∇Ψ(x^md_k)‖²
-- statement:
--   Let $\Psi:\mathbb R^n\to\mathbb R$ be convex and differentiable with $L_\Psi$-Lipschitz gradient, $L_\Psi>0$, and let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$; $\Gamma_k$ as in (2.6). Let $N\ge1$, and suppose that for $k=1,\dots,N$
--   $$\alpha_k\lambda_k\le\beta_k<\frac1{L_\Psi}\quad(2.9),\qquad \frac{\alpha_k}{\lambda_k\Gamma_k}\le\frac{\alpha_{k-1}}{\lambda_{k-1}\Gamma_{k-1}}\ \ (k\ge2)\quad(2.10).$$
--   Then for every $x\in\mathbb R^n$,
--   $$\frac{\Psi(x^{ag}_N)-\Psi(x)}{\Gamma_N}\le\frac{\|x_0-x\|^2}{2\lambda_1}-\sum_{k=1}^N\frac{\beta_k}{2\Gamma_k}(1-L_\Psi\beta_k)\|\nabla\Psi(x^{md}_k)\|^2 .$$
--
--   With $x=x^*$ this gives both conclusions (2.11) and (2.12) of Theorem 1 b).
--
--   **Formalization Note** The statement is the outer ends of the chain (2.24). Conditions (2.9) and (2.10) are imposed only on $k=1,\dots,N$, the indices the proof uses.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 7, (2.24)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.24), p. 7 (outer ends of the chain), for convex `Ψ`, under (2.9) and (2.10)
for `k = 1, …, N`, for every `x ∈ ℝⁿ`. -/
theorem eq_2_24 {n : ℕ} (Ψ : E n → ℝ) (g : E n → E n) (LΨ : ℝ)
    (hΨ : ConvexOptAlg.SmoothGD.IsBetaSmooth Ψ g LΨ) (hL : 0 < LΨ)
    (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) (hconv : ConvexOn ℝ Set.univ Ψ) (N : ℕ) (hN : 1 ≤ N)
    (h29 : ∀ k ∈ Finset.Icc 1 N, α k * lam k ≤ β k ∧ β k < 1 / LΨ)
    (h210 : ∀ k ∈ Finset.Icc 1 N, 2 ≤ k →
      α k / (lam k * Gamma α k) ≤ α (k - 1) / (lam (k - 1) * Gamma α (k - 1))) :
    ∀ x : E n,
      (Ψ (xagSeq g α β lam x0 N) - Ψ x) / Gamma α N ≤
        ‖x0 - x‖ ^ 2 / (2 * lam 1)
          - ∑ k ∈ Finset.Icc 1 N, β k / (2 * Gamma α k) * (1 - LΨ * β k) * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
