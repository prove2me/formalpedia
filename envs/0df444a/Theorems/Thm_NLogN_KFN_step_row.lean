theorem NLogN.KFN.step_row {CR τ : ℝ} (hrow : RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) (hinj : Function.Injective pos) {t S0 B : ℕ}
    (hpos : ∀ p, pos p < t) (haff : AffK2 K t m k pos) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (w0 : Fin W) (i j : Fin m) (hij : i ≠ j)
    (O : ℕ) (hO : dwloc W A + 5 ≤ O) :
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      RImplI Isym iprog r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.rowAdd w0 i j hij : RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ 1 ∧ dw ≤ dwloc W A ∧ ∀ w, (cost w : ℝ) ≤
        ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) * ((W * nR t S0 B : ℕ) : ℝ) *
          (Xf r Ψ (w + O) : ℝ) := by sorry
