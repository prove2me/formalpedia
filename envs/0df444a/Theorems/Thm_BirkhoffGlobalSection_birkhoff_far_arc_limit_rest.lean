-- title:
--   Degeneration of the far shooting family at its first bad parameter (rest allowed)
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. Write $(x_1,x_2)$ for the physical position relative to the primary $J$ and $(v_1,v_2)$ for the physical (Jacobi) velocity. Let $F(r)$ be the perpendicular far start at $z=(0,r)$, and let the shooting coordinates of a state on the line $x_1=0$ be $(\sin\tau, -x_2)=(v_2/|v|, -x_2)$.
--
--   **Degeneration of the far family (rest allowed).** Let $b>0$ be a first bad parameter of the far family: $F(r)$ admits a far shooting arc for every $0<r<b$, but $F(b)$ does not. Then $F(b)\in\Sigma_{\mu,c}$ has $v_2<0$, and there is $T>0$ such that for $0<t<T$ the orbit of $F(b)$ satisfies $x_2\le0$, $v_1>0$ and $|z|>0$, while at time $T$ it lies on the line $x_1=0$ with $x_2\le0$ and $v_1\ge0$. Moreover the far arc lengths $\tau(r)$ converge to $T$ as $r\to b^-$.
--
--   This is `birkhoff_far_arc_limit` without its clause "$x_2<0$ and $v_1=0$ at $T$ imply $v_2\neq0$". Dropping it allows the family to end at a state of rest exactly on the line through $J$ (the case not treated by Birkhoff, 1915, §18); the downstream statements (`…_rest`) handle that end separately, so this version is fully provable.
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18, pp. 731–742 (Rend. Circ. Mat. Palermo 39)

import Definitions.Def_BirkhoffShootingArcs
import Mathlib.Order.Filter.Basic
import Mathlib.Topology.Order.Basic

namespace BirkhoffGlobalSection

theorem birkhoff_far_arc_limit_rest (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ)
    (b : ℝ) (hb : 0 < b)
    (hgood : ∀ r ∈ Set.Ioo 0 b, ∃ x : LeftEnergyState μ c, (x : Phase) = farShootingStart μ c r ∧ ∃ τ : ℝ, IsFarShootingArc φ x τ)
    (hbad : ¬ (∃ x : LeftEnergyState μ c, (x : Phase) = farShootingStart μ c b ∧ ∃ τ : ℝ, IsFarShootingArc φ x τ)) :
    ∃ xb : LeftEnergyState μ c, (xb : Phase) = farShootingStart μ c b ∧
      jacobiVelocity (leviCivitaToJacobi μ (xb : Phase)) 1 < 0 ∧ ∃ T : ℝ, 0 < T ∧
      (∀ t ∈ Set.Ioo 0 T, relativePosition μ ((φ t xb : LeftEnergyState μ c) : Phase) 1 ≤ 0) ∧
      (∀ t ∈ Set.Ioo 0 T, 0 < jacobiVelocity (leviCivitaToJacobi μ ((φ t xb : LeftEnergyState μ c) : Phase)) 0) ∧
      (∀ t ∈ Set.Ioo 0 T, 0 < zNormSq ((φ t xb : LeftEnergyState μ c) : Phase)) ∧
      relativePosition μ ((φ T xb : LeftEnergyState μ c) : Phase) 0 = 0 ∧ relativePosition μ ((φ T xb : LeftEnergyState μ c) : Phase) 1 ≤ 0 ∧
      0 ≤ jacobiVelocity (leviCivitaToJacobi μ ((φ T xb : LeftEnergyState μ c) : Phase)) 0 ∧
      ∀ η > 0, ∃ δ > 0, ∀ r ∈ Set.Ioo (b - δ) b, ∀ x : LeftEnergyState μ c, ∀ τ : ℝ,
        (x : Phase) = farShootingStart μ c r → IsFarShootingArc φ x τ → |τ - T| < η := by sorry

end BirkhoffGlobalSection
