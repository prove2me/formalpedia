theorem _root_.solution
    (M s : ℕ) (theta eta : ℝ) :
    activeMixtureIndices (Finset.univ : Finset (Fin M))
        (centralLevelCohortSet M s theta eta) =
      admissibleCohortIndices M s theta eta := by
  classical
  unfold admissibleCohortIndices
  ext u
  simp only [activeMixtureIndices, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro hne
    by_contra hnot
    rw [centralLevelCohortSet_eq_empty u hnot] at hne
    exact Finset.not_nonempty_empty hne
  · intro hadm
    rw [centralLevelCohortSet_eq_fixed u hadm]
    apply Finset.card_pos.mp
    have hN : 0 < M - (u : ℕ) := Nat.zero_lt_one.trans hadm.1
    have hs : 0 < s := Nat.zero_lt_one.trans hadm.2.1
    rw [card_fixedSet _ _ hN hs]
    exact Nat.choose_pos
      (Nat.sub_le_sub_right (Nat.le_of_lt hadm.2.2.1) 1)
end CollatzEndpointTransport.FixedTotal
