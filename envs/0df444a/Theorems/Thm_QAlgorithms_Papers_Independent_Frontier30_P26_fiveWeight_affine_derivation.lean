-- title:
--   Theorem 4.7: Existence Theorem for five-weight affine derivations
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g$ be admissible in its structural presentation and let $x=x_z+x_l$ be ad-nilpotent with pointed $\operatorname{co}(x)$. There is a derivation $D\in D_{\rm can}+\operatorname{ad}\mathfrak g$ such that
--
--   $$Dx=x,\qquad D\text{ is diagonalizable with weights in }\{0,\pm\tfrac12,\pm1\}.$$
--
--   The same $D$ preserves every invariant cone generated by $W\cap\mathfrak l$ and a central closed convex cone $W_z$. Generated means the smallest closed convex invariant cone containing the two sets. This assertion does not concern arbitrary pointed generating cones.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 22, Theorem 4.7: Existence Theorem for five-weight affine derivations

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Derivations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Theorem 4.7, PDF pp. 22–23. D precedes W, and the five real weight spaces span g. -/
theorem fiveWeight_affine_derivation (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (x : G) (hv : vPart P x = 0)
    (hn : AdNilpotent x) (hp : Pointed (orbitHull x)) :
    ∃ D : LieDerivation ℝ G G,
      (∃ h : G, D.toLinearMap = canonicalDilation P + LieAlgebra.ad ℝ G h) ∧ D x = x ∧
      SupportedWeights D.toLinearMap ({0, -(1 / 2), 1 / 2, -1, 1} : Set ℝ) ∧
      ∀ W Wz : Set G, ClosedCone W → Invariant W → ClosedCone Wz →
        Wz ⊆ (LieAlgebra.center ℝ G : Set G) →
        W = invariantConeHull ((W ∩ (P.L : Set G)) ∪ Wz) → FlowInvariant D.toLinearMap W := by sorry

end Derivations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
