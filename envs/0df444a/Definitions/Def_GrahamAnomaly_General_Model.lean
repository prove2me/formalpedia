-- title:
--   §2, p. 416 — readiness, processor occupancy, and Graham's priority-list rule
-- statement:
--   Fix a feasible schedule, task durations $\mu$, a precedence relation $\prec$, and a **priority list** $L$ containing every task exactly once. A task is **ready** at time $t$ if all of its $\prec$-predecessors have completed by $t$. A processor is **busy** at $t$ if it executes some task during that half-open instant. The schedule follows **Graham's list rule** when:
--
--   1. every ready task that has not started finds all processors busy; and
--   2. if task $T_l$ starts before a different ready task $T_j$, then $T_l$ occurs earlier than $T_j$ in $L$.
--
--   These two conditions characterize the start times generated by scanning $L$ for ready work.
--
--   **Formalization Note** The list is a bijection from positions to tasks and need not respect precedence. The smaller-index processor tie rule is omitted because it changes processor labels but no start or finishing time. The underlying feasible schedule and its finishing time are defined in the preceding item.
-- source:
--   Graham, Bounds on multiprocessing timing anomalies, SIAM J. Appl. Math. 17 (1969), p. 416, §2 Description of the system; https://doi.org/10.1137/0117039

import Mathlib
import Definitions.Def_GrahamAnomaly_General_Schedule

namespace GrahamAnomaly.General

/-- Task `j` is ready at time `t` when all its predecessors have completed. -/
def IsReady {r n : ℕ} {μ : Fin r → ℝ}
    {prec : Fin r → Fin r → Prop} (G : Schedule n μ prec)
    (j : Fin r) (t : ℝ) : Prop :=
  ∀ i, prec i j → G.S i + μ i ≤ t

/-- Every processor executes a task at time `t`. -/
def AllBusy {r n : ℕ} {μ : Fin r → ℝ}
    {prec : Fin r → Fin r → Prop} (G : Schedule n μ prec) (t : ℝ) : Prop :=
  ∀ p : Fin n, ∃ k : Fin r, G.P k = p ∧ G.S k ≤ t ∧ t < G.S k + μ k

/-- Graham's list-scheduling rule: a ready task waiting to start never sees an idle
processor, and a task started while another ready task waits is earlier in `L`. -/
def IsListSchedule {r n : ℕ} {μ : Fin r → ℝ}
    {prec : Fin r → Fin r → Prop} (L : Fin r ≃ Fin r)
    (G : Schedule n μ prec) : Prop :=
  (∀ j t, 0 ≤ t → t < G.S j → IsReady G j t → AllBusy G t) ∧
  (∀ l j, G.S l < G.S j → IsReady G j (G.S l) →
    L.symm l < L.symm j)

end GrahamAnomaly.General


