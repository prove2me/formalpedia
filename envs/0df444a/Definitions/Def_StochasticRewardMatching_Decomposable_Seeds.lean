-- title:
--   Continuous uniform perturbation seeds
-- statement:
--   Seeds are real vectors with one coordinate per resource. Their law is the product of Lebesgue measure restricted to [0,1], a probability law because the interval has length one. The full seed average is its integral. A one-coordinate average integrates from 0 to 1 after replacing that coordinate, leaving all other coordinates fixed. The perturbation is g(x)=exp(x-1). unitSeeds records membership of every coordinate in [0,1]. These integral operators are applied in the mission only to bounded Borel functions generated by finite execution.
-- source:
--   Goyal and Udwani, Online Matching with Stochastic Rewards: Optimal Competitive Ratio via Path Based Formulation, supplied PDF marked arXiv:1905.12778v6 (10 May 2022), Algorithm 1 and §3.3, PDF/printed pp. 9, 14–15; metadata citation_basis: published. https://arxiv.org/abs/1905.12778v6

import Mathlib

open scoped BigOperators
open MeasureTheory
noncomputable section

namespace StochasticRewardMatching.Decomposable

abbrev Seeds (n : ℕ) := Fin n → ℝ

def seedLaw (n : ℕ) : Measure (Seeds n) :=
  Measure.pi (fun _ => volume.restrict (Set.Icc (0 : ℝ) 1))

def seedAverage {n : ℕ} (f : Seeds n → ℝ) : ℝ := ∫ Y, f Y ∂seedLaw n

def oneSeedAverage {n : ℕ} (i : Fin n) (Y : Seeds n) (f : Seeds n → ℝ) : ℝ :=
  ∫ y in (0 : ℝ)..1, f (Function.update Y i y)

def unitSeeds {n : ℕ} (Y : Seeds n) : Prop := ∀ i, Y i ∈ Set.Icc (0 : ℝ) 1

def g (x : ℝ) : ℝ := Real.exp (x - 1)

end StochasticRewardMatching.Decomposable


