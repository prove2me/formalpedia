-- title:
--   Finite subfamily suffices for finitely many ideal-span memberships
-- statement:
--   For a finite family of elements, if each belongs to the ideal generated by a range, then one finite subfamily of range indices suffices for all memberships.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.Ideal.Operations

theorem OAI.PiExponent.FormalInterpolation.finite_subfamily_span
    {R : Type} [CommSemiring R] {α ι : Type} [Fintype α]
    (x : α → R) (g : ι → R)
    (hx : ∀ a, x a ∈ Ideal.span (Set.range g)) :
    ∃ n : Nat, ∃ f : Fin n → ι,
      ∀ a, x a ∈ Ideal.span (Set.range (fun j => g (f j))) := by sorry
