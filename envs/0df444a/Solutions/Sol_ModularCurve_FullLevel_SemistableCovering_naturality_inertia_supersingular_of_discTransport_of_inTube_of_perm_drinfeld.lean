private theorem _root_.AlgebraicCurve.RegularProlongation.mem_ker_residue_iff_of_semiEquiv (x : R.integers) :
    R.semiIntegersEquiv g hg x ∈ RingHom.ker R.residue ↔ x ∈ RingHom.ker R.residue := by
  rw [R.ker_residue, IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff]
  exact (MulEquiv.isUnit_map (R.semiIntegersEquiv g hg).toMulEquiv).not

