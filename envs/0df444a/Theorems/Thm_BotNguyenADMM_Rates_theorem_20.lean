-- title:
--   Theorem 20 — finite, linear or sublinear convergence of the proximal ADMM iterates under the Łojasiewicz property
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is a bounded sequence generated by Algorithm 1 or Algorithm 2 that converges to $(\hat x,\hat z,\hat y)$, and suppose that the regularized augmented Lagrangian $\mathcal F_r$ of Section 3 satisfies the Łojasiewicz property (70) at $(\hat x,\hat z,\hat y,\hat x,\hat y)$ with constant $C_L>0$ and exponent $\theta\in[0,1)$. Then:
--   1. if $\theta = 0$, the algorithms converge in finite time: $(x^k,z^k,y^k) = (\hat x,\hat z,\hat y)$ for all large $k$;
--   2. if $\theta\in(0,\frac12]$, there are $k_0\ge1$, $\hat C_{0,1},\hat C_{0,2},\hat C_{0,3}>0$ and $\hat Q\in[0,1)$ such that for every $k\ge k_0$
--   $$\|x^k-\hat x\|\le\hat C_{0,1}\hat Q^k,\qquad \|y^k-\hat y\|\le\hat C_{0,2}\hat Q^k,\qquad \|z^k-\hat z\|\le\hat C_{0,3}\hat Q^k;$$
--   3. if $\theta\in(\frac12,1)$, there are $k_0\ge3$ and $\hat C_{1,1},\hat C_{1,2},\hat C_{1,3}>0$ such that for every $k\ge k_0$
--   $$\|x^k-\hat x\|\le\hat C_{1,1}(k-1)^{-\frac{1-\theta}{2\theta-1}},\qquad \|y^k-\hat y\|\le\hat C_{1,2}(k-1)^{-\frac{1-\theta}{2\theta-1}},\qquad \|z^k-\hat z\|\le\hat C_{1,3}(k-2)^{-\frac{1-\theta}{2\theta-1}}.$$
--
--   The theorem is the main convergence-rate result of the paper for the proximal and the proximal linearized ADMM with variable metrics in the nonconvex setting: the Łojasiewicz exponent of $\mathcal F_r$ decides between finite termination, a linear rate and a sublinear rate.
--
--   **Formalization Note** The limit $(\hat x,\hat z,\hat y)$ is the KKT point to which the run converges (Theorem 14); its existence is a hypothesis (part of `LojAt`), and its KKT property, which follows from Lemma 11, is not assumed. The Łojasiewicz hypothesis requires (70) for every subgradient (so $\operatorname{dist}(0,\emptyset)=+\infty$) and only at points with $\mathcal F_r(u)\ne\mathcal F_*$ (the convention $0^0=0$); the paper's hypothesis implies it. $\mathcal F_r$ is the Section 3 regularization $L_r + 2T_1\|A^*(y-y')\|^2 + C_1\|x-x'\|^2$. $\lambda_{\min}(AA^*)$ and $\sup_k\|M_i^k\|$ may be replaced by any valid bounds. All constants are quantified after the data, the run, the limit, $C_L$ and $\theta$, and before $k$; $k_0\ge3$ in part 3 makes $k-1$ and $k-2$ positive.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 28, Theorem 20

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **Theorem 20** (Boţ–Nguyen, arXiv:1801.01994v2, p. 28). Under Assumption 2, let
`(xᵏ, zᵏ, yᵏ)` be a bounded sequence generated by Algorithm 1 or Algorithm 2 converging to
`(x̂, ẑ, ŷ)`, such that `F_r` has the Łojasiewicz property (70) there with constant
`C_L > 0` and exponent `θ ∈ [0, 1)`. Then
(i) `θ = 0`: the iterates equal `(x̂, ẑ, ŷ)` from some index on;
(ii) `θ ∈ (0, 1/2]`: `‖xᵏ − x̂‖ ≤ Ĉ₀,₁Q̂ᵏ`, `‖yᵏ − ŷ‖ ≤ Ĉ₀,₂Q̂ᵏ`, `‖zᵏ − ẑ‖ ≤ Ĉ₀,₃Q̂ᵏ` for
`k ≥ k₀`, some `k₀ ≥ 1`, `Ĉ₀,ᵢ > 0`, `Q̂ ∈ [0, 1)`;
(iii) `θ ∈ (1/2, 1)`: `‖xᵏ − x̂‖ ≤ Ĉ₁,₁(k − 1)^{−(1−θ)/(2θ−1)}`,
`‖yᵏ − ŷ‖ ≤ Ĉ₁,₂(k − 1)^{−(1−θ)/(2θ−1)}`, `‖zᵏ − ẑ‖ ≤ Ĉ₁,₃(k − 2)^{−(1−θ)/(2θ−1)}` for
`k ≥ k₀`, some `k₀ ≥ 3`, `Ĉ₁,ᵢ > 0`. -/
theorem theorem_20
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (hbx : Bornology.IsBounded (Set.range x)) (hbz : Bornology.IsBounded (Set.range z))
    (hby : Bornology.IsBounded (Set.range y))
    (xh : BotNguyenADMM.KL.E n) (zh yh : BotNguyenADMM.KL.E m) (CL θ : ℝ)
    (hloj : LojAt v g h A L r ρ lam μ₁ x z y xh zh yh CL θ) :
    (θ = 0 → ∃ K : ℕ, ∀ k ≥ K, x k = xh ∧ z k = zh ∧ y k = yh) ∧
    (0 < θ ∧ θ ≤ 1 / 2 → ∃ k₀ : ℕ, 1 ≤ k₀ ∧
      ∃ C01 C02 C03 Qhat : ℝ, 0 < C01 ∧ 0 < C02 ∧ 0 < C03 ∧ 0 ≤ Qhat ∧ Qhat < 1 ∧
      ∀ k ≥ k₀, ‖x k - xh‖ ≤ C01 * Qhat ^ k ∧ ‖y k - yh‖ ≤ C02 * Qhat ^ k ∧
        ‖z k - zh‖ ≤ C03 * Qhat ^ k) ∧
    (1 / 2 < θ ∧ θ < 1 → ∃ k₀ : ℕ, 3 ≤ k₀ ∧
      ∃ C11 C12 C13 : ℝ, 0 < C11 ∧ 0 < C12 ∧ 0 < C13 ∧
      ∀ k ≥ k₀, ‖x k - xh‖ ≤ C11 * ((k : ℝ) - 1) ^ (-((1 - θ) / (2 * θ - 1))) ∧
        ‖y k - yh‖ ≤ C12 * ((k : ℝ) - 1) ^ (-((1 - θ) / (2 * θ - 1))) ∧
        ‖z k - zh‖ ≤ C13 * ((k : ℝ) - 2) ^ (-((1 - θ) / (2 * θ - 1)))) := by sorry

end BotNguyenADMM.Rates
