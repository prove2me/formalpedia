    congr 1
    symm
    refine Finset.sum_nbij' (e18rho D ℓ long) (e18sig D ℓ long)
      (fun k hk => Finset.mem_range.2 (e18rho_lt D ℓ long hk))
      (fun j' hj' => e18sig_mem D ℓ long (Finset.mem_range.1 hj'))
      (fun k hk => e18sig_rho D ℓ long hk)
      (fun j' hj' => e18rho_sig D ℓ long (Finset.mem_range.1 hj')) (fun k hk => ?_)
    rw [hfn xf fR hfR k hk, hfn xg gR hgR _ (subB_mem D _ _ k), e18rho_sub D ℓ long hx hk,
      e18rho_sig D ℓ long hj]
  refine ⟨?_, ?_, ?_⟩
  · rw [hpipe, length_pull, hvol]
  · intro j hj c
    rw [e18_mrL_get D ℓ long xf xg hj, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, norm_mul,
      norm_inv, Complex.norm_natCast]
    have hN : (0 : ℝ) < ((2 ^ ℓ * ((KFV.ts18 D ℓ long)).prod : ℕ) : ℝ) := by
      have := List.prod_pos (e18_ts_pos D ℓ long); positivity
    calc ((2 ^ ℓ * ((KFV.ts18 D ℓ long)).prod : ℕ) : ℝ)⁻¹ *
          ‖∑ k ∈ Finset.range ((KFV.ts18 D ℓ long)).prod, ncm (xf.getD k 0) (xg.getD (rmSub (KFV.ts18 D ℓ long) j k) 0) c‖
        ≤ ((2 ^ ℓ * ((KFV.ts18 D ℓ long)).prod : ℕ) : ℝ)⁻¹ * ∑ _k ∈ Finset.range ((KFV.ts18 D ℓ long)).prod, ((2 ^ ℓ : ℕ) : ℝ) := by
          refine mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans
            (Finset.sum_le_sum fun k _ => ?_)) (by positivity)
          exact ncm_le _ _ (e18_getD_norm _ hnf _) (e18_getD_norm _ hng _) c
      _ = 1 := by
        have : ((2 ^ ℓ * ((KFV.ts18 D ℓ long)).prod : ℕ) : ℝ) = (((KFV.ts18 D ℓ long)).prod : ℝ) * ((2 ^ ℓ : ℕ) : ℝ) := by
          push_cast; ring
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← this]
        exact inv_mul_cancel₀ hN.ne'
  · intro j hj c
    have hx := e18sig_mem D ℓ long hj
    have hB' := paperArr D ℓ K long hK hℓ
    have hv : Valid (binSh (tgtL D ℓ K long).length) (addrS D (tgtL D ℓ K long) (e18sig D ℓ long j)) := e18_valid_addr hB' hx
    have hcv : (paperLayout D ℓ K long hK hℓ).coord (addrS D (tgtL D ℓ K long) (e18sig D ℓ long j)) =
        e18sig D ℓ long j := e18_coord_addr hB' hx
    have H := GlueProp18.prop18_error_paper y D ℓ K long C p hK hℓ hy hfl hgl hfd hgd hv
    rw [hcv] at H
    have hL1 : (KFV.pipe18c D ℓ K long hK hℓ p xf xg).getD j 0 =
        C.co ((Mv (al D ℓ long) : ℂ) • (procQI y (paperLayout D ℓ K long hK hℓ) C p ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ (ofA (QQ y C p (GlueProp18.PP y C
          (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR))
          (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR)))))).getD
            (encode (binSh (tgtL D ℓ K long).length) (addrS D (tgtL D ℓ K long) (e18sig D ℓ long j))) 0) := by
      rw [hpipe, e18_lout D ℓ K long hK hℓ _ _ hj,
        e18_getD_map (fun v => (Mv (al D ℓ long) : ℂ) • v) _ 0 0 (smul_zero _),
        e18_getD_map C.co _ 0 0 (map_zero _), map_smul]
    rw [hL1, hR1 j hj]
    have key : ∀ A B : R, ‖C.co A c - C.co B c‖ ≤ ‖C.co (A - B)‖ := fun A B => by
      rw [map_sub]; exact norm_le_pi_norm (C.co A - C.co B) c
    refine (key _ _).trans (H.le.trans ?_)
    have hM : (Mv (al D ℓ long) : ℝ) = (((KFV.ts18 D ℓ long)).prod : ℝ) := by exact_mod_cast e18_Mv D ℓ long
    rw [hM]
    have hs2 : Real.sqrt 2 ≤ 2 := by
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    gcongr

end Main

theorem castModel_surj {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r r' : ℕ} (h : r = r')
    (C : CoeffModel y r) (hs : Function.Surjective C.co) :
    Function.Surjective (castModel h C).co := by
  subst h; exact hs

theorem rrModel_surj (m : ℕ) : Function.Surjective (rrModel m).co :=
  fun u => ⟨(rrBasis m).equivFun.symm u, (rrBasis m).equivFun.apply_symm_apply u⟩

end

