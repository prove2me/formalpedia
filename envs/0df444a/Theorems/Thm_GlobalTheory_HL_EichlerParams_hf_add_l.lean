theorem GlobalTheory.HL.EichlerParams.hf_add_l {N : ℕ} (Hm : Matrix (Fin N) (Fin N) R) (a b y : Fin N → R) :
    hf L Hm (a + b) y = hf L Hm a y + hf L Hm b y := by sorry
