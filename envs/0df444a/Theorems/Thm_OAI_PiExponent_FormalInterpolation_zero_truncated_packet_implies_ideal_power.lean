-- title:
--   Vanishing truncated packet implies logarithmic ideal power membership
-- statement:
--   For positive row parameters and truncation/scaling bounds, if every coefficient in a polynomial’s truncated packet vanishes, then the polynomial belongs to the nth power of the ideal generated by the logarithmic center coordinates.

import Definitions.Def_OAI_PiExponent_TruncatedPolynomialJets

open OAI.PiExponent OAI.PiExponent.DeterminantContradiction OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.zero_truncated_packet_implies_ideal_power
    {m K : Nat} (v0 theta : Real) (w : Fin m → Real) (H : Real)
    (r : Fin m → Complex) (T : Fin m → Nat) (e : Fin (m + 1) → Nat)
    (hv0 : 0 < v0) (htheta : 0 < theta) (hw : ∀ i, 0 < w i)
    (hH : 0 < H) (he : ∀ i, 0 < e i)
    (hT : ∀ i : Fin m, InterpolationMatrix.rowWeights v0 theta w i.succ ≤
      (T i : Real) * InterpolationMatrix.rowWeights v0 theta w 0)
    (hscale : ∀ i : Fin (m + 1), H ≤ (e i : Real) *
      InterpolationMatrix.rowWeights v0 theta w i)
    (n : Nat) (P : MvPolynomial (Fin (m + 1)) Complex)
    (hzero : truncatedPolynomialPacket K v0 theta w ((n : Real) * H) r T P = 0) :
    P ∈ (logarithmicCentersIdeal (fun j : Fin K => fun i => (j.val : Complex) * r i) T e) ^ n := by sorry
