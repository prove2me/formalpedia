-- title:
--   $F$ is generated by $A$ and $B$
-- statement:
--   Thompson's group $F$ is generated, as a subgroup of the group of order isomorphisms of
--   $[0,1]$, by the two elements $A$ and $B$ of Example 1.1, where
--   $$A(x) = \tfrac{x}{2}\ (0 \le x \le \tfrac12), \quad x - \tfrac14\ (\tfrac12 \le x \le \tfrac34), \quad 2x-1\ (\tfrac34 \le x \le 1)$$
--   and
--   $$B(x) = x\ (0 \le x \le \tfrac12), \quad \tfrac{x}{2}+\tfrac14\ (\tfrac12 \le x \le \tfrac34), \quad x - \tfrac18\ (\tfrac34 \le x \le \tfrac78), \quad 2x-1\ (\tfrac78 \le x \le 1).$$
--
--   The source obtains this from the tree-diagram normal form of section 2; the statement itself
--   refers to no trees.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathematique (2) 42 (1996) 215-256, https://doi.org/10.5169/seals-87877, Corollary 2.6, p. 224

import Definitions.Def_CannonFloydParry
import Mathlib

namespace CannonFloydParry

theorem closure_mapA_mapB_eq_F : Subgroup.closure {mapA, mapB} = F := by
  sorry

end CannonFloydParry
