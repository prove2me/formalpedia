    have a9 : w5 9 = 2 ^ Q := by rw [q 9 (by decide) (by decide) (by decide) (by decide), h9]
    have a10 : w5 10 = 2 ^ (Q + 1) := by rw [q 10 (by decide) (by decide) (by decide) (by decide), h10]
    simp only [den_fmE a9 a10, E.den]
    rw [miV_eq, hBc, hBn, hBw, ← h8, ← htud, ← htvd, ← hy1]
    rw [hw5, hw4, hw3]
