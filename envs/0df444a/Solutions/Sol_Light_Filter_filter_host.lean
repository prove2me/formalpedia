    (need n U).depth) (by (first
                           | ( (apply ThreeSumApsp.Scale.SoftO.mono)
                               (·
                                   repeat'
                                     with_reducible
                                       first
                                       | exact ThreeSumApsp.Scale.SoftO.const _
