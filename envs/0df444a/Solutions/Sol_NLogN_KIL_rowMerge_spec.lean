namespace NLogN.KIL

open AModel

theorem map_val_finRange (n : ℕ) : (List.finRange n).map Fin.val = List.range n := by
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp

theorem flatMap_finRange {α : Type*} (n : ℕ) (f : Fin n → List α) :
    (List.finRange n).flatMap f =
      (List.range n).flatMap fun i => if h : i < n then f ⟨i, h⟩ else [] := by
  rw [← map_val_finRange, List.flatMap_map]
  exact fm_congr fun x _ => by simp [x.isLt]

theorem map_range3 {α : Type*} (a b c : ℕ) (G : ℕ → α) :
    (List.range (a * b * c)).map G =
      (List.range a).flatMap fun i => (List.range b).flatMap fun j =>
        (List.range c).map fun k => G ((i * b + j) * c + k) := by
  rw [range_mul, range_mul]
  simp only [List.map_flatMap, List.flatMap_assoc, List.flatMap_map, List.map_map]
  rfl

theorem decode3 {P L : ℕ} {rest : Shape} {p g b : ℕ} (hp : p < P) (hg : g < L)
    (hb : b < AModel.vol rest) :
    decode (P :: L :: rest) ((p * L + g) * AModel.vol rest + b) = p :: g :: decode rest b := by
  have hv : Valid (P :: L :: rest) (p :: g :: decode rest b) :=
    List.Forall₂.cons hp (List.Forall₂.cons hg (valid_decode hb))
  have he : encode (P :: L :: rest) (p :: g :: decode rest b) = (p * L + g) * AModel.vol rest + b := by
    simp only [encode, List.headD_cons, List.tail_cons, vol_cons, encode_decode hb]; ring
  rw [← he, decode_encode hv]

theorem getD_flatMap_uniform (W N : ℕ) (s : Fin W → List ℤ) (hs : ∀ w, (s w).length = N)
    {w i : ℕ} (hw : w < W) (hi : i < N) :
    ((List.finRange W).flatMap s).getD (w * N + i) 0 = (s ⟨w, hw⟩).getD i 0 := by
  have hs' : ∀ w (h : w < W), s ⟨w, h⟩ = (List.range N).map fun i => (s ⟨w, h⟩).getD i 0 := by
    intro w h
    conv_lhs => rw [list_eq_range (s ⟨w, h⟩), hs]
  rw [flatMap_finRange]
  have : ((List.range W).flatMap fun i => if h : i < W then s ⟨i, h⟩ else []) =
      (List.range (W * N)).map fun j => if h : j / N < W then (s ⟨j / N, h⟩).getD (j % N) 0 else 0 := by
    rw [range_mul, List.map_flatMap]
    refine fm_congr fun v hv => ?_
    simp only [List.mem_range] at hv
    rw [dif_pos hv, hs' v hv, List.map_map]
    refine List.map_congr_left fun k hk => ?_
    simp only [List.mem_range] at hk
    have h1 : (v * N + k) / N = v := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hk, zero_add]
    have h2 : (v * N + k) % N = k := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hk]
    simp [h1, h2, hv]
  rw [this]
  have hlt : w * N + i < W * N := by nlinarith
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), List.getElem_map, List.getElem_range]
  have h1 : (w * N + i) / N = w := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hi, zero_add]
  have h2 : (w * N + i) % N = i := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]
  simp [h1, h2, hw]

/-- Merging the streams is the inverse move on their concatenation. -/
theorem rowMerge_eq (P W L : ℕ) [NeZero W] (rest : Shape) (s : Fin W → List ℤ)
    (hs : ∀ w, (s w).length = P * L * AModel.vol rest) :
    rowMerge P W L rest 0 s =
      AModel.pull [1, W, P * L, AModel.vol rest] [1, P * L, W, AModel.vol rest] gS 0 ((List.finRange W).flatMap s) := by
  rw [← outF_recOf]
  unfold outF blkOut recOf
  simp only [List.range_one, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  unfold rowMerge
  rw [show AModel.vol (P :: W * L :: rest) = P * L * W * AModel.vol rest by simp [AModel.vol]; ring]
  rw [show P * L * W * AModel.vol rest = (P * L) * W * AModel.vol rest by ring, map_range3]
  refine fm_congr fun m hm => fm_congr fun w hw => List.map_congr_left fun b hb => ?_
  simp only [List.mem_range] at hm hw hb
  have hL : 0 < L := by
    rcases Nat.eq_zero_or_pos L with h | h
    · subst h; simp at hm
    · exact h
  have hm' : m = m / L * L + m % L := (Nat.div_add_mod' m L).symm
  have hp : m / L < P := (Nat.div_lt_iff_lt_mul hL).2 hm
  have hg : m % L < L := Nat.mod_lt _ hL
  have hr : W * (m % L) + w < W * L := by
    have := Nat.mul_le_mul_left W (show m % L + 1 ≤ L by omega); rw [Nat.mul_add] at this; omega
  have hidx : (m * W + w) * AModel.vol rest + b = (m / L * (W * L) + (W * (m % L) + w)) * AModel.vol rest + b := by
    conv_lhs => rw [hm']
    ring
  rw [hidx, decode3 hp hr hb]
  have hw' : (W * (m % L) + w) % W = w := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hw]
  have hg' : (W * (m % L) + w) / W = m % L := by
    rw [Nat.add_comm, Nat.add_mul_div_left _ _ (NeZero.pos W), Nat.div_eq_of_lt hw, zero_add]
  have hri : rowIdx W (m / L :: (W * (m % L) + w) :: decode rest b) = ⟨w, hw⟩ := by
    apply Fin.ext; simp [rowIdx, hw']
  rw [hri]
  simp only [rowMergeAddr, List.headD_cons, List.tail_cons, hg']
  have he : encode (P :: L :: rest) (m / L :: m % L :: decode rest b) = m * AModel.vol rest + b := by
    simp only [encode, List.headD_cons, List.tail_cons, vol_cons, encode_decode hb]
    conv_rhs => rw [hm']
    ring
  rw [he]
  have hix : ((0 * W + w) * (P * L) + m) * AModel.vol rest + b = w * (P * L * AModel.vol rest) + (m * AModel.vol rest + b) := by
    ring
  rw [hix, getD_flatMap_uniform W (P * L * AModel.vol rest) s hs hw (by nlinarith)]

