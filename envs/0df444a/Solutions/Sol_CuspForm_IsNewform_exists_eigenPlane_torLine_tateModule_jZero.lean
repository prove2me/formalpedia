  exact G2TorHeads.false_of_goodEigensystemOccursAt (Fact.out) hg
    (ModularCurve.goodEigensystemOccursAt_of_divisible N q (ModularCurve.heckeInputsAll N)
      (ModularCurve.heckeOperatorsCommuteBar N) g hg.1 D hD hdiv
      (fun t ht hts z hz => hkD t ht hts z hz))

