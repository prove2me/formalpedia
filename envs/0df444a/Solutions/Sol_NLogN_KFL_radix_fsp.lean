    simp +decide [G13, G12, G11, G10, G9, G8, G7, G6, RP, Gb, Function.update_apply]
  have S13 := Sp.pop s G13 (B := Bb) (by decide) p4 (hW _ (by nlinarith))
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    ((FSp.of_norep rfl S4).seq (SL.seq (S6.seq (S7.seq (S8.seq (S9.seq ((FSp.of_norep rfl S10).seq
