theorem AlgebraicCurve.Pic0.exists_nsmul_eq_zero_of_charP_of_forall_pow_eq_self
    (K F : Type*) [Field K] [Field F] [Algebra K F]
    (ℓ : ℕ) [Fact ℓ.Prime] [CharP K ℓ]
    (halg : ∀ a : K, ∃ n : ℕ, 0 < n ∧ a ^ ℓ ^ n = a)
    (hfg : ∃ x : F, Transcendental K x ∧
      FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    [IsCurveOver K F] (hC : ConstantsAreBase K F) (c : Pic0 K F) :
    ∃ m : ℕ, 0 < m ∧ m • c = 0 := by sorry
