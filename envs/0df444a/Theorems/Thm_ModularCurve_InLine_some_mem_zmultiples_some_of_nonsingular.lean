theorem ModularCurve.InLine.some_mem_zmultiples_some_of_nonsingular
    {F : Type*} [Field F] [DecidableEq F] (W : WeierstrassCurve F) [W.IsElliptic] (ℓ : ℕ)
    {x₀ y₀ x y : F} (h₀ : W.toAffine.Nonsingular x₀ y₀) (h : W.toAffine.Nonsingular x y)
    (hL : ModularCurve.InLine W ℓ x₀ x) :
    WeierstrassCurve.Affine.Point.some x y h ∈ AddSubgroup.zmultiples (WeierstrassCurve.Affine.Point.some x₀ y₀ h₀) := by sorry
