  have h1 := lit_sp s0 F (i := Y) hY5 1 (by simp; exact one_le_pow₀ (by norm_num)) (by decide) hA
  let S : ℕ → Fin HS → List ℤ := fun j => update F Y (((2 ^ (m - j) : ℕ) : ℤ) :: F Y)
  have hS43 : ∀ j, S j 43 = [] := fun j => by simp [S, update_of_ne hY43.symm, h43]
  have hSX : S m X = (m : ℤ) :: LX := by simp [S, update_of_ne hXY, hFX]
  have HL := loopDown s0 S hX5 hS43 hSX hm (b := dblB Y) (by simp [dblB, RS.writes, hY43.symm])
