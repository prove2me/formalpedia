    (Nat.lt_size_self _).trans_le (Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega))
  have hlF := lamF_le_NF d s
  have hwF := wF_le_NF d s
  unfold parBig
  generalize segPF p d s = Q at *
  generalize NF d s = N at *
  have hWZ : Q + (kA * Q + kC) + (wA * Q + wC) + 1508 + 5 ≤ W := by
    have : (1 + 2 * kA + wA) * Q = Q + 2 * (kA * Q) + wA * Q := by ring
    omega
  have p5 : ∀ x : ℕ, 2 ^ (x + 5) = 32 * 2 ^ x := fun x => by rw [pow_add]; ring
  have p2 : ∀ x : ℕ, 2 ^ (x + 2) = 4 * 2 ^ x := fun x => by rw [pow_add]; ring
  have a1 : 2 ^ (kA * Q + kC + 1) ≤ 2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508) :=
    Nat.pow_le_pow_right (by norm_num) (by omega)
  have a2 : 2 ^ Q ≤ 2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508) :=
    Nat.pow_le_pow_right (by norm_num) (by omega)
  have a3 := p2 Q
  have a4 : Q + (kA * Q + kC) + (wA * Q + wC) + 1508 <
      2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508) := Nat.lt_two_pow_self
  have a5 : 2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508 + 5) ≤ 2 ^ W :=
    Nat.pow_le_pow_right (by norm_num) hWZ
  have a6 := p5 (Q + (kA * Q + kC) + (wA * Q + wC) + 1508)
  clear p5 p2
  generalize 2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508 + 5) = U at *
  generalize 2 ^ (Q + (kA * Q + kC) + (wA * Q + wC) + 1508) = Z at *
  generalize 2 ^ (Q + 2) = V at *
  generalize 2 ^ (kA * Q + kC + 1) = G at *
  generalize 2 ^ Q = E at *
  generalize 2 ^ W = WW at *
