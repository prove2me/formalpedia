-- Source module: Solutions.KFMBig9
/-!
# KFM Big9: the read-out

After the rounding passes (`finA`), `Φ⁻¹; carries; write` outputs `bin(2n, x·y)`.

* `cN_le`, `zsz_cN`: the product coefficients are small.
* **`cconv_ubar`**: the cyclic convolution of the two digit arrays at `Φ(m)` is `c_m`.
* **`pt_val`**: from the final bound (`final_call3`), the rounded numerators at `k` are
  `(c_m, 0)`, `m = Φ⁻¹ k`.
* `zsW_GB`: all rounded numerators have `p + 2` bits.
* **`fin_phase`**: `finA; Φ⁻¹; carries; write`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open Finset AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-! ## Coefficients -/

variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

/-- The final closeness (the conclusion of `final_call3`). -/
def Close (C : BigCtx ix Isym extM n D) (x y : ℕ) (Z : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ) :
    Prop :=
  ∀ j, ‖(2 : ℂ) ^ (2 * bP n + 4) * ((∏ i, (sBD n D i : ℝ) : ℝ) : ℂ) *
      (((∏ i, (sBD n D i : ℝ) : ℝ) : ℂ) * cnj Z j) - cconv (sBD n D) (ubar C x) (ubar C y) j‖ <
    1 / 2

/-- The rounded array. -/
def zsWf (n : ℕ) (zsZ : List GI) : List GI :=
  (zsZ.map NLogN.KFM.gconj).map fun z => (rndV (pP n) (bP n) (sCmp n) z.1, rndV (pP n) (bP n) (sCmp n) z.2)

/-! ## Carries -/

/-- The carries with their registers. -/
def carW {P : ℕ} : IStmt HS P := withD rB2 uB2 (withD NLogN.KFM.rS uM carIU)

/-- The read-out program. -/
def finP (ix : Ix (7 + E)) : IStmt HS (7 + E) :=
  .seq finA (.seq (callW (descPhiP (bX ix.dSΦ) rPw) (bX ix.dSΦ) (bY ix.dSΦ) ix.dSΦ (ix.g₁ ix.eI))
    (.seq carW (writeI 0 rO)))

/-- The cost bound of the read-out. -/
def kFin (C : BigCtx ix Isym extM n D) : ℝ :=
  (kFinA n D : ℝ) + kPhi n C.BΦ C.CΦ +
    ((cCarU (bP n) (pP n + 2) (sCmp n) + cW (sCmp n : ℤ) + cW (2 ^ bP n) + outRCost (2 * n) : ℕ) : ℝ)

end

end NLogN.KFM

end

