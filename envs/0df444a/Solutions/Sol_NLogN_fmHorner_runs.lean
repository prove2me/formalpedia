    (hDg : ∀ b ∈ Dg, 0 ≤ b ∧ b < 2 ^ M)
    (hG : s.G DG = (ints Dg).reverse ++ LG) (hDL : s.G DL = .int (2 ^ k) :: LL)
    (hRM : s.G RM = .int (2 ^ M) :: LM) :
    IRuns I iprog fmHorner s
      ((s.upd DG LG).upd ZZ (.int (2 ^ (2 ^ k * M) + zev (2 ^ M) Dg) :: s.G ZZ))
      (2 ^ k * (2000 * (n + 3) + 30) + 1000 * (n + 3)) := by
  set K := 2 ^ k with hK
  have hzK : zsz (K : ℤ) ≤ n := by
    have : ((K : ℕ) : ℤ) = (2 : ℤ) ^ k := by rw [hK]; push_cast; rfl
    rw [this, zsz_two_pow]; omega
  have eK : ((2 : ℤ) ^ k) = ((K : ℕ) : ℤ) := by rw [hK]; push_cast; rfl
  set R := Dg.reverse with hR
  have hRl : R.length = K := by simp [hR, hDl]
  have hRd : ∀ b ∈ R, 0 ≤ b ∧ b < 2 ^ M := by intro b hb; exact hDg b (by simpa [hR] using hb)
  set s1 := (s.upd ZZ (.int 1 :: s.G ZZ)).upd CC (.int (K : ℤ) :: s.G CC) with hs1
  have h1 : IRuns I iprog (.seq (.op (.const ZZ 1)) (.op (.dup DL CC))) s s1 (1000 * (n + 2)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hDL, eK, zsz_one]
    refine ⟨by rw [hs1], ?_⟩
    have := dupCost_le (zsz ((K : ℕ) : ℤ))
    omega
  let ss : ℕ → IState NS := fun i =>
    ((s.upd ZZ (.int ((R.take i).foldl (fun z d => z * 2 ^ M + d) 1) :: s.G ZZ)).upd DG (ints (R.drop i) ++ LG)).upd CC
      (.int ((K - i : ℕ) : ℤ) :: s.G CC)
  have h0 : ss 0 = s1 := by
    have e : ints R ++ LG = s.G DG := by rw [hG, hR, ints_reverse]
    simp only [ss, List.take_zero, List.drop_zero, List.foldl_nil, e, Nat.sub_zero]
    rw [hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  have hkk : ss K = ((s.upd ZZ (.int (2 ^ (K * M) + zev (2 ^ M) Dg) :: s.G ZZ)).upd DG LG).upd CC
      (.int 0 :: s.G CC) := by
    have e1 : R.take K = R := List.take_of_length_le (by omega)
    have e2 : R.drop K = [] := List.drop_eq_nil_of_le (by omega)
    have e3 := horner_rev M Dg 1
    simp only [ss]
    rw [e1, e2, hR, e3, hDl]
    simp
  have h2 := IRuns.loop' (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := hornerStep) ss (2000 * (n + 3)) K
    (by intro i hi; simp +decide [ss]; omega)
    (by simp +decide [ss])
    (by
      intro i hi
      have hdi : R.drop i = R[i] :: R.drop (i + 1) := List.drop_eq_getElem_cons (by omega)
      have hti : R.take (i + 1) = R.take i ++ [R[i]] := by simp [List.take_add_one]
      have hb := hRd R[i] (List.getElem_mem _)
      have hpos := horner_pos M (R.take i) 1 le_rfl (fun b hb' => (hRd b (List.mem_of_mem_take hb')).1)
      have hc : zsz (((K - i : ℕ) : ℤ)) ≤ n := le_trans (zsz_natCast_le (by omega)) hzK
      apply IRuns.of_runsTo 0
      simp only [ss]
      rw [hdi, ints_cons, List.cons_append, hti, List.foldl_append]
      have hne : (R.take i).foldl (fun z d => z * 2 ^ M + d) 1 ≠ 0 := by omega
      simp +decide [hornerStep, decC, IStmt.run, IOp.run, hRM, zsz_neg_one, hb.1, hb.2,
        not_le.mpr hb.2, not_lt.mpr hb.1, hne]
      rw [sg_cat (by omega) hb.1]
      refine ⟨?_, ?_⟩
      · have e5 : (((K - i : ℕ) : ℤ) + -1) = ((K - (i + 1) : ℕ) : ℤ) := by omega
        rw [e5]
        clear * -
        (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
      · have := catCost_le M
        have := addIntCost_mono (show zsz (((K - i : ℕ) : ℤ)) + 1 ≤ n + 1 by omega)
        have := addIntCost_le (n + 1)
        omega)
  have h3 : IRuns I iprog (.op (.drop CC)) (((s.upd ZZ (.int (2 ^ (K * M) + zev (2 ^ M) Dg) ::
      s.G ZZ)).upd DG LG).upd CC (.int 0 :: s.G CC))
      ((s.upd DG LG).upd ZZ (.int (2 ^ (K * M) + zev (2 ^ M) Dg) :: s.G ZZ)) 2 := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, zsz_zero]
    clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  rw [h0, hkk] at h2
  exact (IRuns.seq h1 (IRuns.seq h2 h3)).mono (by omega)
end
