/-- Real LAR acceptance with the secret fixed; all matrices remain fresh and uniform. -/
noncomputable def larSecretAcceptance (D : Family) (lam : ℕ) (pp : Str)
    (q N d ℓ t : ℕ) [NeZero q]
    (label : (Fin d → ZMod q) → Fin ℓ → ZMod q) (secret : Fin N → ZMod q) : ℝ :=
  avg fun matrices : Fin t → Matrix (Fin d) (Fin N) (ZMod q) =>
    acceptProb D (encInput lam pp (encTable
      (fun i => (matrices i, label ((matrices i).mulVec secret)))))

/-- Game 1 of the actual reduction: replace only zero-secret labels by ideal labels. -/
noncomputable def prZeroSecretReplacedLAR (D : Family) (lam : ℕ) (pp : Str)
    (q N d ℓ t : ℕ) [NeZero q]
    (label : (Fin d → ZMod q) → Fin ℓ → ZMod q) : ℝ :=
  avg fun secret : Fin N → ZMod q =>
    if secret = 0 then prIdealLAR D lam pp q N d ℓ t
    else _root_.InfoLossLAR.WorstCase.larSecretAcceptance D lam pp q N d ℓ t label secret





end InfoLossLAR.WorstCase

