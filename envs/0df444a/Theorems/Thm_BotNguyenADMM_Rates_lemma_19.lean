-- title:
--   Lemma 19 — distance of the iterates to the limit in terms of $\max\{\sqrt{\mathcal E_k},\varphi(\mathcal E_k)\}$
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is a bounded sequence generated by Algorithm 1 or Algorithm 2, converging to $(\hat x,\hat z,\hat y)$, such that $\mathcal F_r$ satisfies the Łojasiewicz property (70) at $(\hat x,\hat z,\hat y,\hat x,\hat y)$ with constant $C_L>0$, exponent $\theta\in[0,1)$ and desingularization function $\varphi(s) = \frac{C_L}{1-\theta}s^{1-\theta}$. Assume $C_1>0$. Then there is $k_0\ge2$ such that for every $k\ge k_0$
--   $$\|x^k-\hat x\|\le C_{20}\max\{\sqrt{\mathcal E_k},\varphi(\mathcal E_k)\},\qquad \|y^k-\hat y\|\le C_{21}\max\{\sqrt{\mathcal E_k},\varphi(\mathcal E_k)\},$$
--   $$\|z^k-\hat z\|\le C_{22}\max\{\sqrt{\mathcal E_{k-1}},\varphi(\mathcal E_{k-1})\},$$
--   with $C_{20} = \frac{7}{\sqrt{C_{17}}} + \frac{1}{C_{17}}$, $C_{21} = \frac{7}{2\sqrt{C_{17}}} + \frac{1}{2C_{17}}$, $C_{22} = C_{20}\|A\| + \frac{2C_{21}}{\rho r}$ and $C_{17} = \frac12\min\{C_1/4, 1/(\rho r)\}$.
--
--   This lemma transfers rates for $\mathcal E_k$ (Theorem 18) to rates for the iterates (Theorem 20).
--
--   **Formalization Note** The hypothesis $C_1>0$ is not in the paper. $C_1 = 0$ happens exactly for Algorithm 1 with $\mu_1 = 0$; then $C_{17} = 0$ and the paper's $C_{20}, C_{21}$ are $+\infty$, so its estimate says nothing, while Lean's convention $a/0 = 0$ would turn it into the false claim $\|x^k - \hat x\|\le0$. The case is therefore excluded. $\mathcal E_k\ge0$, so $\sqrt{\cdot}$ and the real power in $\varphi$ are evaluated on nonnegative arguments. The KKT property of the limit, which the paper's wording presupposes, follows from Lemma 11 and is not assumed.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 27, Lemma 19, (87a)–(87c); C_17 on p. 26

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **Lemma 19** (Boţ–Nguyen, arXiv:1801.01994v2, p. 27, (87a)–(87c)). Under Assumption 2,
for a bounded sequence generated by Algorithm 1 or Algorithm 2 converging to `(x̂, ẑ, ŷ)`
such that `F_r` has the Łojasiewicz property (70) there with constant `C_L`, exponent `θ`
and desingularization function `φ(s) = C_L s^{1−θ}/(1 − θ)`, there is `k₀ ≥ 2` such that for
every `k ≥ k₀`: `‖xᵏ − x̂‖ ≤ C₂₀ max{√E_k, φ(E_k)}`, `‖yᵏ − ŷ‖ ≤ C₂₁ max{√E_k, φ(E_k)}`,
`‖zᵏ − ẑ‖ ≤ C₂₂ max{√E_{k−1}, φ(E_{k−1})}`. The hypothesis `C₁ > 0` excludes Algorithm 1 with
`μ₁ = 0`, where the paper's `C₂₀ = 7/√C₁₇ + 1/C₁₇` is `+∞`. -/
theorem lemma_19
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (hbx : Bornology.IsBounded (Set.range x)) (hbz : Bornology.IsBounded (Set.range z))
    (hby : Bornology.IsBounded (Set.range y))
    (xh : BotNguyenADMM.KL.E n) (zh yh : BotNguyenADMM.KL.E m) (CL θ : ℝ)
    (hloj : LojAt v g h A L r ρ lam μ₁ x z y xh zh yh CL θ)
    (hC1 : 0 < C1 v L μ₁ lam ρ r) :
    ∃ k₀ : ℕ, 2 ≤ k₀ ∧ ∀ k ≥ k₀,
      ‖x k - xh‖ ≤ C20 v L μ₁ lam ρ r *
          max (Real.sqrt (Ek v g h A L r ρ lam μ₁ x z y xh zh yh k))
            (phiLoj CL θ (Ek v g h A L r ρ lam μ₁ x z y xh zh yh k)) ∧
      ‖y k - yh‖ ≤ C21 v L μ₁ lam ρ r *
          max (Real.sqrt (Ek v g h A L r ρ lam μ₁ x z y xh zh yh k))
            (phiLoj CL θ (Ek v g h A L r ρ lam μ₁ x z y xh zh yh k)) ∧
      ‖z k - zh‖ ≤ C22 v A L μ₁ lam ρ r *
          max (Real.sqrt (Ek v g h A L r ρ lam μ₁ x z y xh zh yh (k - 1)))
            (phiLoj CL θ (Ek v g h A L r ρ lam μ₁ x z y xh zh yh (k - 1))) := by sorry

end BotNguyenADMM.Rates
