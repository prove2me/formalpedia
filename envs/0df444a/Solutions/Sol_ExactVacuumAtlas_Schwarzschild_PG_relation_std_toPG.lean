/-!
# Transport layer I: restriction and composition of coordinate relations (ATLAS-II)

Two generic facts about the first-release bundle `CoordRelation g₁ g₂ U V Φ Ψ J`
(`Atlas/Core/Relation.lean`, unchanged):

* `restrict`: a relation restricts to any smaller domain/image pair `U' ⊆ U`, `V' ⊆ V` that the two
  maps exchange;
* `comp`: two relations `U → V → W` compose, with the composite map, the composite inverse and the
  **product Jacobian** `J₂(Φ₁ x) · J₁(x)`. The Jacobian field is the chain rule for the coordinate
  slices (`jacobian_comp`), derived from Mathlib's `HasFDerivAt.comp_hasDerivAt` and the genuine
  slice derivatives of both relations; it needs `V` open so that `Φ₂` is differentiable at `Φ₁ x`.
  The pull-back field is the associativity computation `(J₂J₁)ᵀ G (J₂J₁) = J₁ᵀ (J₂ᵀ G J₂) J₁`.

No Ricci content: this is the transport of *metric data and maps* only. The transformation law of
`ricciOf` (certificate transport) is **not** proved here; see `mission/RELEASE02_SPEC.md` A.
-/

open scoped ContDiff

namespace ExactVacuumAtlas.CoordRelation

variable {g₁ g₂ g₃ : Metric 4} {U V W : Set (Pt 4)} {Φ₁ Ψ₁ Φ₂ Ψ₂ : Pt 4 → Pt 4}
  {J₁ J₂ : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}

/-- Restriction to `U' ⊆ U`, `V' ⊆ V` with `Φ(U') ⊆ V'`, `Ψ(V') ⊆ U'`. -/
theorem restrict (h : CoordRelation g₁ g₂ U V Φ₁ Ψ₁ J₁) {U' V' : Set (Pt 4)} (hU : U' ⊆ U)
    (hV : V' ⊆ V) (hΦ : Set.MapsTo Φ₁ U' V') (hΨ : Set.MapsTo Ψ₁ V' U') :
    CoordRelation g₁ g₂ U' V' Φ₁ Ψ₁ J₁ where
  left_inv x hx := h.left_inv x (hU hx)
  right_inv y hy := h.right_inv y (hV hy)
  bijOn := Set.InvOn.bijOn ⟨fun x hx => h.left_inv x (hU hx), fun y hy => h.right_inv y (hV hy)⟩
    hΦ hΨ
  smooth := h.smooth.mono hU
  smooth_inv := h.smooth_inv.mono hV
  jacobian x hx := h.jacobian x (hU hx)
  pullback x hx := h.pullback x (hU hx)

end ExactVacuumAtlas.CoordRelation

