  have hl : Q.dLn.length = 2 * Q.d + 4 := len_descLine _ _ _ _ _ _
  obtain ⟨hs1, hs2⟩ := small_len hQ (k := 2) (c := 4) (Bd := Bd) (by norm_num) (by norm_num)
  obtain ⟨hok, hrun, hc⟩ := cpy_call (Or.inr (Or.inr rfl)) dS t Q.dLn hR.hLn Q.d hR.hD 2 4 hl
    (Bd + Q.b) (fun x hx => (hBd x hx).trans (by omega)) hs1 hs2
  obtain ⟨hA, -⟩ := hL (wS t dS R0) (wF (gflat zs) Q.dLn dS) [] wF_nil (wF_dS hd0)
  obtain ⟨zs', w, c, hrun', hw, hg, hM, hcst⟩ :=
    hA zs u (by rw [wF_zero, List.append_nil]) hu hu1
  refine ⟨zs', w, _, callW_I hprog _ hd0 eA t _ _ _ R0 h0 Bd hBd hok hrun hrun', hw, hg, hM, ?_⟩
