  have he := eval_eq_of_degrees 24 k inversePower21_raw inversePower21 z
    (degreeBound_sound inversePower21_raw_bound) (degreeBound_sound inversePower21_result_bound)
    inversePower21_degrees
  change eval k (normalize inversePower21_raw) z = eval k inversePower21 z
  rw [eval_normalize]
  exact he

