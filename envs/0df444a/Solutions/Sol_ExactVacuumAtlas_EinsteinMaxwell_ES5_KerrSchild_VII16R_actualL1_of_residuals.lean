/-- H0: a `C∞` function on `(0, ε)` has classical first and second derivatives there, given by
`deriv` and `deriv ∘ deriv`. This is what gives the `deriv` inside `realP*` its analytic meaning. -/
theorem hd1 {g : ℝ → ℝ} {ε : ℝ} (hg : ContDiffOn ℝ ∞ g (Ioo (0:ℝ) ε)) :
    ∀ x ∈ Ioo (0:ℝ) ε, HasDerivAt g (deriv g x) x := fun x hx =>
  ((hg.contDiffAt (Ioo_mem_nhds hx.1 hx.2)).differentiableAt (by simp)).hasDerivAt

theorem hd2 {g : ℝ → ℝ} {ε : ℝ} (hg : ContDiffOn ℝ ∞ g (Ioo (0:ℝ) ε)) :
    ∀ x ∈ Ioo (0:ℝ) ε, HasDerivAt (deriv g) (deriv (deriv g) x) x := by
  intro x hx
  have h1 : ContDiffOn ℝ 1 (deriv g) (Ioo (0:ℝ) ε) :=
    hg.deriv_of_isOpen isOpen_Ioo (WithTop.coe_le_coe.mpr le_top)
  exact ((h1.contDiffAt (Ioo_mem_nhds hx.1 hx.2)).differentiableAt (by simp)).hasDerivAt

