private theorem t0754 (v : HeightOneSpectrum (𝓞 K)) : ideleOf v (1 : v.adicCompletion K) = 1 := by
  rw [t0710 v one_ne_zero]
  have h1 : Units.mk0 (1 : v.adicCompletion K) one_ne_zero = 1 := Units.ext rfl
