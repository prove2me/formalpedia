def sourceSignedShiftedMomentPolynomials
    (F : Formula)
    {e : ℕ} (fieldBasis : Module.Basis (Fin e) (ZMod 2) K)
    (points : Finset K)
    (variablePlace : Fin F.variableCount → K)
    (momentBudget : ℕ)
