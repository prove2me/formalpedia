lemma bits_bound (A : ℤ) (c : ℝ) (n : ℕ)
    (ha : |(A : ℝ) - 2 ^ (2 * n + 9) * c| ≤ 20 * ((2 * n + 9 : ℕ) : ℝ) + 40) :
