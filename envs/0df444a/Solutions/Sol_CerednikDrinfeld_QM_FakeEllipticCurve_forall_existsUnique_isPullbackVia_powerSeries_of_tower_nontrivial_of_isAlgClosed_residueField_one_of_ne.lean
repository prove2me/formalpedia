theorem hG_lift (B B' : Type) [CommRing B] [CommRing B'] (ψ : O →+* B) (ψ' : O →+* B')
    (φ : B' →+* B) (hφ : φ.comp ψ' = ψ) (hφs : Function.Surjective φ) (hφ2 : RingHom.ker φ * RingHom.ker φ = ⊥)
    (x : Gobj B ψ) : ∃ x' : Gobj B' ψ', Gmap φ hφ x' = x :=
  hG_lift' φ hφ hφs hφ2 x

