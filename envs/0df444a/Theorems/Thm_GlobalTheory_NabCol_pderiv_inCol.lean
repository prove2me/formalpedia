theorem GlobalTheory.NabCol.pderiv_inCol (b c : Fin n) (j : Fin d) (f : PS k 1 d) :
    pderiv k (c, j) (inCol b f) = if b = c then inCol b (pderiv k ((0 : Fin 1), j) f) else 0 := by sorry
