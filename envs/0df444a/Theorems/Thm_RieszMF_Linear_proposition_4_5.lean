-- title:
--   Proposition 4.5, p. 20 — the particle system (1.1) has a unique strong solution, and with probability one the particles never collide
-- statement:
--   Let $d\ge3$, $0\le s<d-2$, $\sigma\ge0$, let $\mathbb M$ satisfy $\mathbb M\xi\cdot\xi\le0$ for all $\xi\in\mathbb R^d$, and let $\mathsf g$ be an admissible potential with radius $r_0$. Let $N\ge1$, let $x^0_N=(x^0_1,\dots,x^0_N)\in(\mathbb R^d)^N$ have pairwise distinct points, and let $W_1,\dots,W_N$ be independent standard Brownian motions in $\mathbb R^d$ on a probability space $(\Omega,\mathbb P)$. Then:
--
--   1. there is a strong solution $x_N$ of
--   $$x^t_i=x^0_i+\int_0^t\frac1N\sum_{1\le j\le N:\,j\ne i}\mathbb M\nabla\mathsf g(x^\tau_i-x^\tau_j)\,d\tau+\sqrt{2\sigma}\,W^t_i,\qquad t\ge0,\ 1\le i\le N,$$
--   with almost surely continuous paths and
--   $$\mathbb P\Big(\forall t\ge0,\ \min_{1\le i\ne j\le N}|x^t_i-x^t_j|>0\Big)=1;\tag{4.32}$$
--   2. $x_N$ is the limit of the truncated dynamics (4.31): for every bump function $\chi$ as in (4.1) ($\chi\in C^\infty_c$, $\chi\ge0$, $\chi=1$ on $|x|\le1/2$, $\chi=0$ on $|x|\ge1$), with probability one, whenever for each $\varepsilon>0$ the continuous paths $x_{N,\varepsilon}$ solve the same equation with $\mathsf g$ replaced by the truncated potential $\mathsf g_{(\varepsilon)}(x)=\mathsf g(x)(1-\chi(x/\varepsilon))$ and the same Brownian path, then $x^t_{N,\varepsilon}\to x^t_N$ as $\varepsilon\to0^+$ for every $t\ge0$;
--   3. any two collision-free solutions with continuous paths driven by the same Brownian motions agree, almost surely, at all times.
--
--   This is the well-posedness of the singular particle system (1.1) used throughout the paper: it gives meaning to $x^t_N$ and to $F_N(x^t_N,\mu^t)$ in Theorem 1.1, and shows that the solution class assumed there is not empty.
--
--   **Formalization Note.** Because the noise is additive, the stochastic differential equation (1.1) is the pathwise integral equation above, and no Itô integral is needed; the truncated system (4.5) is read the same way, pathwise for a fixed sample $\omega$, and the limit (4.31) is asserted on one almost sure event for all $\varepsilon$ and all solution paths of the truncated equations at once. A strong solution is one adapted to the completed filtration generated by $W_1,\dots,W_N$ (each $x^t_i$ agrees a.s. with an $\mathcal F^W_t$-measurable variable). Uniqueness is stated among solutions without collisions, which is the class (4.32) places the solution in. The hypotheses are the paper's standing assumptions (§1.3); §4 uses (1.2), (i)–(v) and (vii). The paper allows $\sigma\ge0$ in (1.1); $\sigma=0$ is included.
-- source:
--   Rosenzweig & Serfaty, Global-in-time mean-field convergence for singular Riesz-type diffusive flows, arXiv:2108.09878v1, p. 20, Proposition 4.5, (4.31), (4.32); setting p. 6

import Mathlib
import Definitions.Def_RieszMF_Linear_Setting

open MeasureTheory ProbabilityTheory Filter Topology Set Metric
open scoped NNReal ENNReal FourierTransform Laplacian

namespace RieszMF.Linear

theorem proposition_4_5 (d : ℕ) (hd : 3 ≤ d) (s : ℝ) (hs0 : 0 ≤ s) (hsd : s < d - 2)
    (σ : ℝ) (hσ : 0 ≤ σ) (M : Matrix (Fin d) (Fin d) ℝ) (hM : NegSemidef M)
    (g : E d → ℝ) (r₀ : ℝ) (hg : Admissible d s M g r₀)
    (N : ℕ) (hN : 0 < N) (x0 : Fin N → E d) (hx0 : Pairwise (fun i j => x0 i ≠ x0 j))
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (W : Fin N → ℝ≥0 → Ω → E d) (hW : IsBrownianFamily P W) :
    (∃ x : Fin N → ℝ≥0 → Ω → E d,
        IsParticleSolution P σ M g x0 W x ∧ IsAdaptedToBM P W x ∧
        ∀ χ : E d → ℝ, IsBump χ → ∀ᵐ ω ∂P,
          ∀ y : ℝ → Fin N → ℝ≥0 → E d,
            (∀ ε : ℝ, 0 < ε → ∀ i, Continuous (y ε i)) →
            (∀ ε : ℝ, 0 < ε → ∀ i (t : ℝ≥0), y ε i t = x0 i
              + (∫ τ in (0 : ℝ)..(t : ℝ), (1 / (N : ℝ)) • ∑ j ∈ Finset.univ.erase i,
                  Matrix.toEuclideanLin M
                    (gradient (truncPot g χ ε) (y ε i τ.toNNReal - y ε j τ.toNNReal)))
              + Real.sqrt (2 * σ) • W i t ω) →
            ∀ i (t : ℝ≥0), Tendsto (fun ε => y ε i t) (𝓝[>] 0) (𝓝 (x i t ω))) ∧
    ∀ x x' : Fin N → ℝ≥0 → Ω → E d,
      IsParticleSolution P σ M g x0 W x → IsParticleSolution P σ M g x0 W x' →
        ∀ᵐ ω ∂P, ∀ i t, x i t ω = x' i t ω := by sorry

end RieszMF.Linear
