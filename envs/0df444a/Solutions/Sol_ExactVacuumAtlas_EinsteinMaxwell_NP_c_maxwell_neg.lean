section rft

variable {M a Q : ℝ} {U : Set (Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

local notation "gK" => gKN M a Q
local notation "giK" => giKN M a Q
local notation "EK" => knE M a Q
local notation "ΘK" => knTh M a Q
local notation "FK" => faradayKN a Q

variable (hU : IsOpen U) (hUD : U ⊆ domReg M a Q) (ht : RealFrameTangent (gKN M a Q) (knE M a Q) U h f B)
include hU hUD ht

theorem RealFrameTangent.kn_FfrFVar (A K : Fin 4) : ContDiffOn ℝ ∞ (FfrFVar FK f EK B A K) U := by
  obtain ⟨_, _, _, _, _, _, hK, ht', hs⟩ := knRealize hU hUD ht
  rw [← hs]; exact hK.smooth_FfrFVar ht' A K

