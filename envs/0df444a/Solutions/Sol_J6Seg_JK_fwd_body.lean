    (by simp +decide [hG4, hG3, hG2, hG1, hG0, fSt, update_apply, hrp1])
    (by simp +decide [hG4, hG3, hG2, hG1, hG0, fSt, update_apply, hcd])
    (by simp +decide [hG4, hG3, hG2, hG1, hG0, fSt, update_apply, htmp])
    (by simp +decide [hG4, hG3, hG2, hG1, hG0, fSt, update_apply])
