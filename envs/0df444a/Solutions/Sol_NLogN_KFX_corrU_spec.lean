    simp only [Geo.S0, Geo.S1]; ring
  simp only [phi]
  rw [hV]
  refine sc_lt hg.s0 h0 ?_
  rw [hS0]
  refine sc_lt hg.s1 h1 ?_
  rw [hS1]
  refine sc_lt hg.s2 h2 ?_
  rw [← hS1, ← hS0, ← hV]; exact hn

