open Real Set Metric
open RealInnerProductSpace

namespace QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-! ## The gap as a distance

`coneGap v ϑ h = ‖h‖ sin(ϑ − ∠(v,h))`, which is the exact distance from `h` to the
boundary of the cone. This makes the constants in Section 5.2 computable. -/


end QFS

open QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Cones are invariant under positive scaling. -/
lemma solution {v : E} (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2)
    {t : ℝ} (ht : 0 < t) {h : E} (hh : h ∈ QFS.cone v ϑ) : t • h ∈ QFS.cone v ϑ := by
  rw [QFS.mem_cone_iff_coneGap_pos hv hϑ hϑ'] at hh ⊢
  rw [QFS.coneGap_smul v ϑ ht.le]
  positivity
