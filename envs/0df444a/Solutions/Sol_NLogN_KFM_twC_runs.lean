section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT KIL
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution (n k j : ℕ) (hk : 0 < k) (X : Fin NLogN.HS) (h51 : X ≠ 51) (h52 : X ≠ 52) (s : NLogN.IState NLogN.HS) :
    NLogN.IRuns I iprog (NLogN.KFM.twC n k j X) s
      (s.upd X (.int (IntMul.HvdH.twiddle n k j).1 :: .int (IntMul.HvdH.twiddle n k j).2 :: s.G X)) (NLogN.KFM.cTw n k j) := by
  obtain ⟨o, r, c⟩ := NLogN.KFM.twRS_spec n k j s
  have h1 := NLogN.RS.code_runs (I := I) (iprog := iprog) (NLogN.KFM.twRS n k j) s o
  rw [r] at h1
  set s1 := (s.upd 51 (.int (IntMul.HvdH.twiddle n k j).1 :: s.G 51)).upd 52
    (.int (IntMul.HvdH.twiddle n k j).2 :: s.G 52) with hs1
  have m1 := NLogN.IRuns.mv (I := I) (iprog := iprog) (s := s1) (i := 52) (j := X)
    (a := (IntMul.HvdH.twiddle n k j).2) (L := s.G 52) h52.symm (by simp +decide [hs1])
  set s2 := (s1.upd 52 (s.G 52)).upd X (.int (IntMul.HvdH.twiddle n k j).2 :: s1.G X) with hs2
  have m2 := NLogN.IRuns.mv (I := I) (iprog := iprog) (s := s2) (i := 51) (j := X)
    (a := (IntMul.HvdH.twiddle n k j).1) (L := s.G 51) h51.symm (by simp +decide [hs2, hs1, h52.symm, h51.symm])
  have hb := NLogN.KFM.zsz_of_near n (IntMul.HvdH.twiddle n k j) _ (NLogN.KFM.norm_exp_phase (2 * Real.pi * j / k) _ (by push_cast; ring))
    ((NLogN.KFM.vP_twiddle n k j hk).trans (pow_le_one₀ (by norm_num) (by norm_num)))
  refine (h1.seq (m1.seq m2)).mono' ?_ ?_
  · simp only [hs2, hs1]
    clear h1 m1 m2
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · unfold NLogN.KFM.cTw
    have := NLogN.moveIntCost_le (NLogN.zsz (IntMul.HvdH.twiddle n k j).1); have := NLogN.moveIntCost_le (NLogN.zsz (IntMul.HvdH.twiddle n k j).2)
    omega
end
