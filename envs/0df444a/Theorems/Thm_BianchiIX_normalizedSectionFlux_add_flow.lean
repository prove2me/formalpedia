theorem BianchiIX.normalizedSectionFlux_add_flow (x X : NormalizedState)
    (v : Fin 3 → NormalizedState) (c : Fin 3 → ℝ) :
    normalizedAmbientVolume (Fin.cons X (Fin.cons (normalizedField x)
        (fun i => v i + c i • normalizedField x))) =
      normalizedAmbientVolume (Fin.cons X (Fin.cons (normalizedField x) v)) := by sorry
