  [∀ v : HeightOneSpectrum (𝓞 ℚ), BorelSpace (v.adicCompletion ℚ)]
  (μ : ∀ v : HeightOneSpectrum (𝓞 ℚ), Measure (v.adicCompletion ℚ)) [∀ v, (μ v).IsAddHaarMeasure]

open scoped Classical in

private theorem inv_measure_adelicBox_mul_integral_xLine_eq
    {ψ : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ}
    (hW : ∀ v ∉ S, IsGL3PsiWhittakerFn (ψ v) (dualWhittakerFn3 (Wloc v)))
    (hU : ∀ v ∉ S, IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (h1 : ∀ v ∉ S, dualWhittakerFn3 (Wloc v) 1 = 1)
    (hψ : ∀ v ∉ S, ∀ y₀ : v.adicCompletion ℚ, y₀ ∉ v.adicCompletionIntegers ℚ →
      ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψ v y ≠ 1)
    (ha : ∀ v ∉ S, IsIntegralUnit v (unitsAt v a))
    (hg : ∀ v ∉ S, componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    ((adelicAddHaar (𝓞 ℚ) ℚ (adelicBox ℚ)).toReal : ℂ)⁻¹ * ∫ x, xLine Warch Wloc a g x ∂(adelicAddHaar (𝓞 ℚ) ℚ) =
      (∏ v ∈ S, (((μ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          ∫ y, xLineAt Wloc a g v y ∂(μ v))) *
        ∫ y : mixedEmbedding.mixedSpace ℚ, xLineArch Warch a g ((InfiniteAdeleRing.ringEquiv_mixedSpace ℚ).symm y) :=
  inv_measure_adelicBox_mul_integral_eq_prod_mul_integral_mixedSpace S μ (xLine Warch Wloc a g)
    (xLineArch Warch a g) (xLineAt Wloc a g) (xLine_eq Warch Wloc a g) (xLineAt_eq_one Wloc S hU h1 ha hg)
    (xLineAt_eq_zero Wloc S hW hU hψ hg)

