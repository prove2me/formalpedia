/-! ## The angular Maxwell residual (PaperBVP Eq. 24c, left minus right) -/

/-- Eq. 24c written as left minus right. -/
noncomputable def maxwellResidual (f m N a : ℝ → ℝ) (Q J : ℝ) (r : ℝ) : ℝ :=
  m r * deriv (fun s => m s * deriv a s) r - f r * a r
    - 2 * Q * f r * m r ^ 2 / N r ^ 2 * (J + 2 * Q * a r)

