  let side := exactReverseRightSide seed
  let context := exactReverseBobContext seed
  let marker : Fin side.card :=
    context.sideRank
      ⟨seed.coordinate,
        exactReverseRightSide_coordinate_mem seed⟩
  have hmarker : marker.val = seed.rightCut.val := by
