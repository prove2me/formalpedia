        .rs (mvList gZT bI gCV (cnt2 bT)), bapSlP, .rs (mvList bO gZB gCV (cnt2 bS))]))
      (.rs (mvList gZB gD gCV (cnt2 bTot))))

/-- **The `B̃` axis program.** -/
def bapAxP : RM :=
  RM.seqL [.rs tmpP, .rs eTabR, .rs eDelR, .rs cTabR, .rs cDelR, .rs dTabR', .rs ptKR, .rs psKR,
    .rs tmpQ, bapCoreP, .rs (popK bW gCC (.reg bNW)), .rs (popK bD gCC (.reg bS)),
    .rs (popK bW1 gCC (.reg bS)), .rs (popK bD1 gCC (.reg bS)), .rs (popK bW3 gCC (.reg bS)),
    .rs (popK bK3 gCC (.reg bT)), .rs (popK bKS gCC (.reg bS))]

