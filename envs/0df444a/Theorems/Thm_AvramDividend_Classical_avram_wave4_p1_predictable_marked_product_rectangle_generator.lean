-- title:
--   Original-filtration predictable marked-product sigma algebra generated by adapted rectangles
-- statement:
--   For any original filtration, identify the measurable space of time-history pairs with its true predictable sigma algebra, and add an arbitrary mark measurable space. Prove that the resulting product sigma algebra is generated exactly by adapted initial-atom and future-half-line time-history rectangles crossed with measurable mark sets. The key countably spanning property is proved from the bottom time atom and all positive times. This is a noncircular structural basis for density of genuinely predictable marked elementary kernels; no Campbell or martingale identity is assumed.
-- source:
--   P1 canonical predictable adapted rectangle sigma-generator 31933be5-5f90-4169-be51-4c8f889b430b; pinned generateFrom_eq_prod and IsCountablySpanning in Mathlib.MeasureTheory.MeasurableSpace.Prod/Basic.

import Mathlib
import Theorems.Thm_AvramDividend_Classical_avram_wave4_p1_predictable_adapted_rectangle_sigma_generator

open MeasureTheory MeasurableSpace Set AvramDividend.Classical
open scoped ENNReal NNReal

theorem AvramDividend.Classical.avram_wave4_p1_predictable_marked_product_rectangle_generator
    {Ω ι E : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι] [mE : MeasurableSpace E]
    (𝓕 : Filtration ι mΩ)
    [mHist : MeasurableSpace (ι × Ω)]
    (hHist : mHist = 𝓕.predictable) :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    MeasurableSpace.generateFrom
        (Set.image2 (· ×ˢ ·) G {C : Set E | MeasurableSet C}) =
      @Prod.instMeasurableSpace (ι × Ω) E mHist mE := by sorry
