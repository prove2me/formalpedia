namespace ExactVacuumAtlas.Minkowski.R4

@[simp] theorem toCart_0 (x : Pt 4) : toCart x 0 = x 0 := rfl
@[simp] theorem toCart_1 (x : Pt 4) : toCart x 1 = x 1 * sin (x 2) * cos (x 3) := rfl
@[simp] theorem toCart_2 (x : Pt 4) : toCart x 2 = x 1 * sin (x 2) * sin (x 3) := rfl
@[simp] theorem toCart_3 (x : Pt 4) : toCart x 3 = x 1 * cos (x 2) := rfl
@[simp] theorem fromCart_0 (y : Pt 4) : fromCart y 0 = y 0 := rfl
@[simp] theorem fromCart_1 (y : Pt 4) : fromCart y 1 = √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := rfl
@[simp] theorem fromCart_2 (y : Pt 4) :
    fromCart y 2 = arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) := rfl
@[simp] theorem fromCart_3 (y : Pt 4) :
    fromCart y 3 = π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) := rfl

/-! ## Domains -/

theorem S2_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < y 1 ^ 2 + y 2 ^ 2 := by
  by_cases h : y 2 = 0
  · have h1 : y 1 < 0 := by
      by_contra h'
      exact hy ⟨h, not_lt.mp h'⟩
    have h1' : y 1 ≠ 0 := h1.ne
    positivity
  · positivity

theorem S3_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2 := by
  have := S2_pos hy; positivity

theorem rho3_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
  Real.sqrt_pos.mpr (S3_pos hy)

/-- `ρ₂ − x > 0` off the slit. -/
theorem rho2_sub_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < √(y 1 ^ 2 + y 2 ^ 2) - y 1 := by
  rw [sub_pos]
  by_cases h1 : y 1 < 0
  · exact lt_of_lt_of_le h1 (Real.sqrt_nonneg _)
  · have h1' : 0 ≤ y 1 := not_lt.mp h1
    have h2 : y 2 ≠ 0 := fun h2 => hy ⟨h2, h1'⟩
    have h2' : 0 < y 2 ^ 2 := by positivity
    calc y 1 = √(y 1 ^ 2) := (Real.sqrt_sq h1').symm
      _ < √(y 1 ^ 2 + y 2 ^ 2) := Real.sqrt_lt_sqrt (by positivity) (by linarith)

theorem z_div_rho3_lt_one {y : Pt 4} (hy : y ∈ imgCart) :
    y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) < 1 := by
  rw [div_lt_one (rho3_pos hy)]
  calc y 3 ≤ |y 3| := le_abs_self _
    _ = √(y 3 ^ 2) := (Real.sqrt_sq_eq_abs _).symm
    _ < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
        Real.sqrt_lt_sqrt (by positivity) (by linarith [S2_pos hy])

theorem neg_one_lt_z_div_rho3 {y : Pt 4} (hy : y ∈ imgCart) :
    -1 < y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := by
  rw [lt_div_iff₀ (rho3_pos hy)]
  have : -y 3 < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
    calc -y 3 ≤ |y 3| := neg_le_abs _
      _ = √(y 3 ^ 2) := (Real.sqrt_sq_eq_abs _).symm
      _ < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
          Real.sqrt_lt_sqrt (by positivity) (by linarith [S2_pos hy])
  linarith

