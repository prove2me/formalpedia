/-! ### Lambda-form derivative combinators and an automatic builder -/

section comb
variable {f₁ f₂ : ℝ → ℂ} {d₁ d₂ : ℂ}
theorem hd_add (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε + f₂ ε) (d₁ + d₂) 0 := h₁.add h₂
theorem hd_sub (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε - f₂ ε) (d₁ - d₂) 0 := h₁.sub h₂
theorem hd_mul (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε * f₂ ε) (d₁ * f₂ 0 + f₁ 0 * d₂) 0 := h₁.mul h₂
theorem hd_neg (h₁ : HasDerivAt f₁ d₁ 0) : HasDerivAt (fun ε => -f₁ ε) (-d₁) 0 := h₁.neg
theorem hd_div_const (h₁ : HasDerivAt f₁ d₁ 0) (c : ℂ) : HasDerivAt (fun ε => f₁ ε / c) (d₁ / c) 0 :=
  h₁.div_const c
theorem hd_const (c : ℂ) : HasDerivAt (fun _ : ℝ => c) 0 0 := hasDerivAt_const 0 c
end comb



/-- `δΨ₂` bridge (genuine derivative of `Ψ₂ = C(l,m,m̄,n)`). -/
theorem NPFamily.hasDerivAt_psi2' {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
