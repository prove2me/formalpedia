-- title:
--   Normalised eigenforms give characters of the Hecke algebra
-- statement:
--   Let $N$ be a nonzero natural number, let $f$ be a cusp form of weight $2$ for $\Gamma_0(N)$, assume the predicate [`CuspForm.IsNormalizedEigenform`](def/FLTPrelim_Modularity.html#L28) holds for $f$, and let $S$ be an arbitrary set of natural numbers. Write $\mathbb{T} =$ [`CuspForm.heckeAlgebra N 2 S`](def/CuspForm_HeckeAlgebra.html#L18) for the $\mathbb{Z}$-subalgebra of $\operatorname{End}_{\mathbb{C}}(S_2(\Gamma_0(N)))$ generated by the operators `heckeTLin` attached to primes $\ell$ with $\ell \nmid N$ and $\ell \notin S$ together with the operators `heckeULin` attached to primes $q$ with $q \mid N$ and $q \notin S$. The assertion is that there exists a ring homomorphism $\chi : \mathbb{T} \to \mathbb{C}$ such that, first, every $t \in \mathbb{T}$, viewed as a $\mathbb{C}$-linear endomorphism of $S_2(\Gamma_0(N))$, satisfies $t f = \chi(t) \cdot f$; second, the value of $\chi$ at [`CuspForm.heckeAlgebra.T`](def/CuspForm_HeckeAlgebra.html#L77) equals [`ModularFormClass.qCoeff f ℓ`](def/FLTPrelim_Modularity.html#L19), the $\ell$-th $q$-expansion coefficient of $f$, for every prime $\ell$ with $\ell \nmid N$ and $\ell \notin S$; and third, the value of $\chi$ at [`CuspForm.heckeAlgebra.U`](def/CuspForm_HeckeAlgebra.html#L80) equals [`ModularFormClass.qCoeff f q`](def/FLTPrelim_Modularity.html#L19) for every prime $q$ with $q \mid N$ and $q \notin S$. No integrality of the values of $\chi$ is asserted.
--
--   This is the passage from a normalised weight-two eigenform to its system of Hecke eigenvalues, packaged as a character of the Hecke algebra away from the primes in $S$. It is the starting point for the eigenvalue ring attached to $f$ and for the construction of the associated Galois representation, and is invoked by the finiteness statement for the eigencoefficient ring and by the comparison of Frobenius characteristic polynomials with the coefficients $a_\ell(f)$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_IsNormalizedEigenform_exists_ringHom_heckeAlgebra.lean

import Definitions.Def_CuspForm_HeckeAlgebra

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem CuspForm.IsNormalizedEigenform.exists_ringHom_heckeAlgebra {N : ℕ} [NeZero N] {f : CuspForm (CongruenceSubgroup.Gamma0 N) 2} (hf : f.IsNormalizedEigenform) (S : Set ℕ) : ∃ χ : CuspForm.heckeAlgebra N 2 S →+* ℂ, (∀ t : CuspForm.heckeAlgebra N 2 S, (t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2)) f = χ t • f) ∧ (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S), χ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS) = ModularFormClass.qCoeff f ℓ) ∧ ∀ (q : ℕ) (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S), χ (CuspForm.heckeAlgebra.U hq hqN hqS) = ModularFormClass.qCoeff f q := by sorry
