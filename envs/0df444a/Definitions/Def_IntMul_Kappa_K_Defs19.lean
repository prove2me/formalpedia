-- Source module: Solutions.KFNGStep
/-!
# KFN: gates and role permutations on role streams of records

* `enc_of_rec` / `rec_of_enc`: role streams of records (`RecRep r F zs (flatR X)`) are the
  KFG stream encoding `Enc W (n r) (const F) zs (yR r X)`.
* Scale shifts: the gate programs depend only on scale differences (`gateP_shE`, …), so one
  program serves every scale `F`.
* Scale bookkeeping (`gateE_bnd`, `gateE_top`, `gateE_zero`, `gateE_lev`) and the width / cost
  bounds `gateW_le`, `cGate_le` (shifts of at most one bit per atom).
* **`rImpl_gate`**: a gate `gateMat W as` (atoms with `h ≤ 1`, targets never sources) followed by
  a leveling pass (`c = 0` atoms bringing every role to the common scale `F + gδ as`).
* **`rImpl_perm`**: a role permutation.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

/-! ## Streams of records as the KFG encoding -/

section EncBridge

variable {W r n F : ℕ}

/-- Entry `p` of role `v` (record `p / r`, coefficient `p mod r`). -/
noncomputable def yR (r : ℕ) (X : Fin W → List (Fin r → ℂ)) : ℕ → ℕ → ℂ := fun v p =>
  if h : v < W ∧ 0 < r then ((X ⟨v, h.1⟩).getD (p / r) 0) ⟨p % r, Nat.mod_lt _ h.2⟩ else 0

end EncBridge

/-! ## Gate programs depend only on scale differences -/

section Shift

/-- Shift all scales by `F`. -/
def shE (F : ℕ) (e : ℕ → ℕ) : ℕ → ℕ := fun t => e t + F

end Shift

/-! ## Scale bookkeeping -/

section Scales

/-- The leveling atoms: every role `t ≠ t0` gets `0 ·` role `t0`. -/
def levA (W t0 : ℕ) : List KFG.Atom :=
  ((List.range W).filter fun t => t ≠ t0).map fun t => ⟨t, t0, (0, 0), 0⟩

end Scales

/-! ## Width and cost of a gate pass -/

section Bounds

end Bounds

/-! ## The gate step -/

section GateStep

/-- The first atom with `h = 1`. -/
def h1Atom (as : List KFG.Atom) : Option KFG.Atom := as.find? fun a => a.h == 1

/-- The scale added by a gate step. -/
def gδ (as : List KFG.Atom) : ℕ := if (h1Atom as).isSome then 1 else 0

/-- The leveling atoms after a gate. -/
def levOf (W : ℕ) (as : List KFG.Atom) : List KFG.Atom :=
  match h1Atom as with
  | some a0 => levA W a0.t
  | none => []

/-- The program of a gate step: the atoms, then the leveling. -/
def gateC (W L : ℕ) (as : List KFG.Atom) : RS :=
  .seq (gateP as (fun _ => 0) L) (gateP (levOf W as) (gateE as (fun _ => 0)) L)

/-- Cost of a gate step. -/
def cGateC (W L Z A w : ℕ) : ℕ :=
  A * cAtom (w + 3 * A) 1 L W Z + W * cAtom (w + 3 * A + 3 * W) 1 L W Z + 2

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

end GateStep

end NLogN.KFN

end

