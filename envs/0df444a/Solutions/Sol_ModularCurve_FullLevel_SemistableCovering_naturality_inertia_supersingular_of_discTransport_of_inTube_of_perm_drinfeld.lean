  haveI : IsAlgClosed (ResidueField A) := ValuationSubring.isAlgClosed_residueField_algebraicClosure_rat A
  have htrS : ∀ s : ↥W, ∃ t : 𝒞.FSS s, Transcendental (ResidueField A) t := by
    intro s
    obtain ⟨t, ht, htu⟩ := hSS_tr s
    have htR : t ∈ (RSS s).integers := by rw [hRSS]; exact ht
    refine ⟨(RSS s).residue ⟨t, htR⟩, fun halg => ?_⟩

