    have h2 : ((σ : E →+* E) ∘ (Pi.single i (σ a) : Fin M → E)) ⬝ᵥ (J *ᵥ y) = a * (J *ᵥ y) i := by
      have h3 : ((σ : E →+* E) ∘ (Pi.single i (σ a) : Fin M → E)) = Pi.single i a := by
