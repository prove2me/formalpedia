     (· (subst h4_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h5_m2 : x_m2 = NLogN.KIL.aTw)
     (· (subst h5_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h6_m2 : x_m2 = NLogN.KIL.aDg)
     (· (subst h6_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h7_m2 : x_m2 = NLogN.KIL.aY)
     (· (subst h7_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (by_cases h8_m2 : x_m2 = NLogN.KIL.aL)
     (· (subst h8_m2); (simp +decide [Function.update_apply, h1, h2, h3, h4, h5]))
     (simp [Function.update_apply, h1_m2, h2_m2, h3_m2, h4_m2, h5_m2, h6_m2, h7_m2, h8_m2, h1, h2, h3,
         h4, h5])))

end NLogN.KIL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12
theorem solution {I : List NLogN.Sym} {iprog : Fin 1 → NLogN.IStmt NLogN.HS 1} (s : NLogN.IState NLogN.HS)
    (F : Fin NLogN.HS → List ℤ) (v : Fin NLogN.HS → ℕ) {M B : ℕ} (hM : NLogN.zsz (M : ℤ) ≤ B)
    {q m n P R' : ℕ} (G' Suf : AModel.Shape) (child : AModelL12.Oracle (ZMod 2)) (cO : ℕ → ℕ) (ys : List (ZMod 2))
    (hq : 2 ≤ q) (hm : 2 ≤ m) (hG' : ∀ a ∈ G', 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a) (hP : 1 ≤ P)
    (hR' : 1 ≤ R') (hO : ∀ j, m ^ j ≤ n → NLogN.KIL.CallSpec I iprog child q m j P R' (AModel.vol (AModelL12.rowShape P R' G' Suf q n)) (cO j))
    (hlenP : ∀ o j' zs, zs.length = AModel.vol (AModelL12.rowShape P R' G' Suf q n) →
      (AModelL12.pieceStep child P R' G' Suf q m n o j' zs).length = AModel.vol (AModelL12.rowShape P R' G' Suf q n))
    (hv : ∀ i ∈ NLogN.KIL.regD, v i ≤ M) (vN : v NLogN.KIL.aN = n) (vQN : v NLogN.KIL.aQN = q ^ n) (vP : v NLogN.KIL.kP = P)
    (vRp : v NLogN.KIL.aRp = R') (vGR : v NLogN.KIL.aGR = AModel.vol G') (vS : v NLogN.KIL.kS = AModel.vol Suf)
    (FP : ∃ L, F NLogN.KIL.kP = (P : ℤ) :: L) (FS : ∃ L, F NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: L)
    (F23 : F 23 = []) (F8 : F 8 = []) (F9 : F 9 = []) (F10 : F 10 = []) (F11 : F 11 = [])
    (F0 : F 0 = NLogN.KIL.enc2 ys) (hn1 : 1 ≤ n) (hys : ys.length = AModel.vol (AModelL12.rowShape P R' G' Suf q n))
    (hVM : AModel.vol (AModelL12.rowShape P R' G' Suf q n) ≤ M) (hmM : m ≤ M) (hB1 : 1 ≤ B) :
    ∃ v' : Fin NLogN.HS → ℕ, (∀ i, i ∉ NLogN.KIL.pcW → v' i = v i) ∧ (∀ i ∈ NLogN.KIL.regD, v' i ≤ M) ∧
      NLogN.IRuns I iprog (NLogN.KIL.piecesI q m) (NLogN.KIL.encK s (NLogN.KIL.regState F v NLogN.KIL.regD))
        (NLogN.KIL.encK s (NLogN.KIL.regState (Function.update F 0 (NLogN.KIL.enc2 (AModelL12.runPieces (AModelL12.pieceStep child P R' G' Suf q m n)
          (fun j => m ^ j) 0 (AModelL12.pieceLevels m n) ys))) v' NLogN.KIL.regD))
        (NLogN.KIL.cPcs m n cO B) := by
  set V := AModel.vol (AModelL12.rowShape P R' G' Suf q n) with hV
  set Ls := (Nat.digits m n).length with hLs
  set step := AModelL12.pieceStep child P R' G' Suf q m n with hstep
  have hqn : q ^ n ≤ V := NLogN.KIL.qn_le_row (by omega) hP hR' hG' hS
  have hq0 : 0 < q := by omega
  have hqle : ∀ k ≤ n, q ^ k ≤ M := fun k hk =>
    le_trans (le_trans (Nat.pow_le_pow_right hq0 hk) hqn) hVM
  have hnM : n + 1 ≤ M := by
    have := Nat.lt_pow_self (n := n) (show 1 < q by omega)
    have := hqle n le_rfl
    omega
  obtain ⟨LP, hLP⟩ := FP
  obtain ⟨LS, hLS⟩ := FS
  have hrest : 1 ≤ AModel.vol (AModelL12.restShape G' Suf q n) := by
    simp only [AModelL12.restShape, AModel.vol_append, AModel.vol_replicate]
    exact Nat.mul_pos (Nat.one_le_pow _ _ hq0) (Nat.mul_pos (NLogN.KIL.one_le_vol hG')
      (Nat.mul_pos (Nat.one_le_pow _ _ hq0) (NLogN.KIL.one_le_vol hS)))
  have hPM : P ≤ M := by
    refine le_trans ?_ hVM
    rw [hV, AModelL12.vol_rowShape]
    calc P = P * 1 * 1 := by ring
      _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_left _ hR') hrest
  have hLs1 : 1 ≤ Ls := by
    rw [hLs, Nat.digits_def' (by omega) (by omega)]; simp
  have hLsn : Ls ≤ n := (Nat.digits_length_le_iff (by omega) n).2 (Nat.lt_pow_self (by omega))
  have hpowj : ∀ j, j < Ls → m ^ j ≤ n := fun j hj => NLogN.KIL.pow_le_of_lt_len hm hn1 hj
  have hTw : ∀ j, j < Ls → q ^ m ^ j ≤ M := fun j hj => hqle _ (hpowj j hj)
  -- initialisation
  obtain ⟨vI, fr, iJ, iNN, iQO, iQM, iTw, iY, iDg, iL, S1⟩ := NLogN.KIL.pcInit_sp s F v hM hq hm hv vN vQN vP
    ⟨LP, hLP⟩ F23 (hqle n le_rfl) hmM hPM hnM hn1
  have fr' : ∀ i, i ∉ NLogN.KIL.pcW → vI i = v i := fr
  have vIRp : vI NLogN.KIL.aRp = R' := by rw [fr' _ (by decide), vRp]
  have vIGR : vI NLogN.KIL.aGR = AModel.vol G' := by rw [fr' _ (by decide), vGR]
  have vIS : vI NLogN.KIL.kS = AModel.vol Suf := by rw [fr' _ (by decide), vS]
  set Xk : ℕ → Fin NLogN.HS → List ℤ := fun k => Function.update (Function.update (Function.update F NLogN.KIL.dP
    ((P : ℤ) :: F NLogN.KIL.dP)) NLogN.KIL.dT (NLogN.KIL.towerL q m k ++ F NLogN.KIL.dT)) 0
      (NLogN.KIL.enc2 (AModelL12.runPieces step (fun j => m ^ j) 0 (NLogN.KIL.levels m n (k + 1)) ys)) with hXk
  set vk : ℕ → Fin NLogN.HS → ℕ := fun k => NLogN.KIL.vLev vI k (n / m ^ (k + 1)) (q ^ (n % m ^ (k + 1)))
    (q ^ (n - n % m ^ (k + 1))) (q ^ m ^ k) with hvk
  -- level 0
  have L0 := NLogN.KIL.lvl_run (I := I) (iprog := iprog) s (Function.update (Function.update F NLogN.KIL.dP
    ((P : ℤ) :: F NLogN.KIL.dP)) NLogN.KIL.dT ((q : ℤ) :: F NLogN.KIL.dT)) vI hM (j := 0) G' Suf child ys hq hm hG' hS hP hR'
    (hO 0 (by simp; omega)) hlenP vIRp vIGR vIS iDg
    ⟨LS, by simp +decide [Function.update_apply, hLS]⟩ ⟨F NLogN.KIL.dP, by simp +decide [Function.update_apply]⟩
    ⟨F NLogN.KIL.dT, by simp +decide [Function.update_apply, NLogN.KIL.towerL_zero]⟩
    (by simp +decide [Function.update_apply, F10])
    (by simp +decide [Function.update_apply, F0, NLogN.KIL.levels, AModelL12.runPieces])
    (by simp; omega) hys hVM hmM hB1
  rw [NLogN.KIL.vLev_zero iJ iNN iQO iQM iTw] at L0
  have e0 : Function.update (Function.update (Function.update F NLogN.KIL.dP ((P : ℤ) :: F NLogN.KIL.dP)) NLogN.KIL.dT
      ((q : ℤ) :: F NLogN.KIL.dT)) 0 (NLogN.KIL.enc2 (AModelL12.runPieces step (fun j => m ^ j) 0 (NLogN.KIL.levels m n (0 + 1)) ys)) = Xk 0 := by
    simp only [hXk, NLogN.KIL.towerL_zero]; rfl
  rw [e0] at L0
  -- the remaining levels
  have Hb : ∀ k < Ls - 1, NLogN.IRuns I iprog (.seq (NLogN.KIL.towerUp m).code (NLogN.KIL.lvlI m))
      (NLogN.KIL.encK s (Function.update (NLogN.KIL.regState (Xk k) (vk k) NLogN.KIL.regD) 11 [((Ls - 1 : ℕ) : ℤ) - k]))
      (NLogN.KIL.encK s (Function.update (NLogN.KIL.regState (Xk (k + 1)) (vk (k + 1)) NLogN.KIL.regD) 11
        [((Ls - 1 : ℕ) : ℤ) - k]))
      ((m + 1) * 10 ^ 9 * (B + 2) ^ 2 + NLogN.KIL.cLvl (n / m ^ (k + 1) % m) (cO (k + 1)) B) := by
    intro k hk
    set c11 : List ℤ := [((Ls - 1 : ℕ) : ℤ) - k]
    rw [NLogN.KIL.regState_upd_nmem _ _ (by decide), NLogN.KIL.regState_upd_nmem _ _ (by decide)]
    have T := NLogN.KIL.towerUp_sp s (Function.update (Xk k) 11 c11) vI hM (q := q) (m := m) (j := k)
      (a := n / m ^ (k + 1)) (b := q ^ (n % m ^ (k + 1))) (c := q ^ (n - n % m ^ (k + 1)))
      (by omega) hm iY (hTw (k + 1) (by omega)) (by omega) hmM
      (by simp +decide [hXk, Function.update_apply, F9])
    have Lv := NLogN.KIL.lvl_run (I := I) (iprog := iprog) s (Function.update (Function.update (Xk k) 11 c11)
      NLogN.KIL.dT (((q ^ m ^ (k + 1) : ℕ) : ℤ) :: Function.update (Xk k) 11 c11 NLogN.KIL.dT)) vI hM (j := k + 1)
      G' Suf child ys hq hm hG' hS hP hR' (hO (k + 1) (hpowj _ (by omega))) hlenP vIRp vIGR vIS iDg
      ⟨LS, by simp +decide [hXk, Function.update_apply, hLS]⟩
      ⟨F NLogN.KIL.dP, by simp +decide [hXk, Function.update_apply]⟩
      ⟨F NLogN.KIL.dT, by simp +decide [hXk, Function.update_apply, NLogN.KIL.towerL_succ]⟩
      (by simp +decide [hXk, Function.update_apply, F10])
      (by simp +decide [hXk, Function.update_apply, step])
      (hpowj _ (by omega)) hys hVM hmM hB1
    refine ((T.toIRuns).seq Lv).mono' ?_ le_rfl
    congr 2
    funext x
    by_cases h0 : x = 0
    · subst h0; simp +decide [hXk, Function.update_apply, step]
    by_cases h1 : x = NLogN.KIL.dT
    · subst h1; simp +decide [hXk, Function.update_apply, NLogN.KIL.towerL_succ]
    by_cases h2 : x = 11
    · subst h2; simp +decide [hXk, Function.update_apply]
    simp [hXk, Function.update_apply, h0, h1, h2]
  have vk0L : vk 0 NLogN.KIL.aL = Ls := by simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply, iL, Ls]
  have hLsM : Ls ≤ M := by omega
  obtain ⟨o, b, ev⟩ := NLogN.KIL.NE.good (t := NLogN.KIL.encK s (NLogN.KIL.regState (Xk 0) (vk 0) NLogN.KIL.regD)) (v := vk 0) hM
    (NLogN.KIL.NE.sub (.reg NLogN.KIL.aL) (.lit 1))
    (NLogN.KIL.NE.holds_encK (fun i hi => by
      simp [NLogN.KIL.NE.regs] at hi; subst hi; exact ⟨_, NLogN.KIL.regState_mem (by decide)⟩))
    (by simp only [NLogN.KIL.NE.OK, NLogN.KIL.NE.val]; rw [vk0L]; omega)
  have H := NLogN.KIL.IRuns.irepF (I := I) (iprog := iprog) (C := 11) (n := (NLogN.KIL.NE.sub (.reg NLogN.KIL.aL) (.lit 1)).toEx)
    (body := .seq (NLogN.KIL.towerUp m).code (NLogN.KIL.lvlI m)) (s := s) (F := fun k => NLogN.KIL.regState (Xk k) (vk k) NLogN.KIL.regD)
    (N := Ls - 1) (B := B)
    (fun k => (m + 1) * 10 ^ 9 * (B + 2) ^ 2 + NLogN.KIL.cLvl (n / m ^ (k + 1) % m) (cO (k + 1)) B) hB1
    (by decide) (fun k => by
      rw [NLogN.KIL.regState_nmem (by decide)]; simp +decide [hXk, Function.update_apply, F11])
    (NLogN.KIL.NE.clean (fun i hi => by simp [NLogN.KIL.NE.regs] at hi; subst hi; decide)) o (NLogN.KIL.NE.lin ⟨trivial, trivial⟩) b
    (by rw [ev]; simp [NLogN.KIL.NE.val, vk0L]) Hb
  -- removing the tower
  set Dfin := NLogN.KIL.enc2 (AModelL12.runPieces step (fun j => m ^ j) 0 (NLogN.KIL.levels m n (Ls - 1 + 1)) ys) with hDfin
  have hTl : (NLogN.KIL.towerL q m (Ls - 1)).length = vk (Ls - 1) aL := by
    simp +decide [NLogN.KIL.towerL, hvk, NLogN.KIL.vLev, Function.update_apply, iL]; omega
  have hTB : ∀ a ∈ NLogN.KIL.towerL q m (Ls - 1), NLogN.zsz a ≤ B := by
    intro a ha
    simp only [NLogN.KIL.towerL, List.mem_map, List.mem_reverse, List.mem_range] at ha
    obtain ⟨i, hi, rfl⟩ := ha
    exact le_trans (NLogN.KIL.zsz_nat_le (hTw i (by omega))) hM
  have Fn := NLogN.KIL.pcFin_sp s (Function.update F 0 Dfin) (vk (Ls - 1)) hM (P := P) (NLogN.KIL.towerL q m (Ls - 1))
    hTl hTB (le_trans (NLogN.KIL.zsz_nat_le hPM) hM) (by rw [← hTl]; simp [NLogN.KIL.towerL]; omega)
    (by simp +decide [Function.update_apply, F8])
  have eF : Xk (Ls - 1) = Function.update (Function.update (Function.update F 0 Dfin) NLogN.KIL.dP
      ((P : ℤ) :: Function.update F 0 Dfin NLogN.KIL.dP)) NLogN.KIL.dT (NLogN.KIL.towerL q m (Ls - 1) ++ Function.update F 0 Dfin NLogN.KIL.dT) := by
    funext x
    by_cases h0 : x = 0
    · subst h0; simp +decide [hXk, Function.update_apply, Dfin, step]
    by_cases h1 : x = NLogN.KIL.dT
    · subst h1; simp +decide [hXk, Function.update_apply]
    by_cases h2 : x = NLogN.KIL.dP
    · subst h2; simp +decide [hXk, Function.update_apply]
    simp [hXk, Function.update_apply, h0, h1, h2]
  rw [← eF] at Fn
  refine ⟨vk (Ls - 1), ?_, ?_, ?_⟩
  · intro i hi
    have hi' := hi
    simp only [NLogN.KIL.pcW, List.mem_cons, List.not_mem_nil, or_false, not_or] at hi'
    simp only [hvk, NLogN.KIL.vLev]
    rw [Function.update_of_ne hi'.2.2.2.2.1, Function.update_of_ne hi'.2.2.2.1,
      Function.update_of_ne hi'.2.2.1, Function.update_of_ne hi'.2.1, Function.update_of_ne hi'.1]
    exact fr' i hi
  · intro i hi
    by_cases hw : i ∈ NLogN.KIL.pcW
    · simp only [NLogN.KIL.pcW, List.mem_cons, List.not_mem_nil, or_false] at hw
      rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · simp +decide [hvk, NLogN.KIL.vLev]; omega
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply]
        exact le_trans (Nat.div_le_self _ _) (by omega)
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply]; exact hqle _ (Nat.mod_le _ _)
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply]; exact hqle _ (Nat.sub_le _ _)
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply]; exact hTw _ (by omega)
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply, iY]
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply, iL]; omega
      · simp +decide [hvk, NLogN.KIL.vLev, Function.update_apply, iDg]
    · have : vk (Ls - 1) i = v i := by
        have hi' := hw
        simp only [NLogN.KIL.pcW, List.mem_cons, List.not_mem_nil, or_false, not_or] at hi'
        simp only [hvk, NLogN.KIL.vLev]
        rw [Function.update_of_ne hi'.2.2.2.2.1, Function.update_of_ne hi'.2.2.2.1,
          Function.update_of_ne hi'.2.2.1, Function.update_of_ne hi'.2.1,
          Function.update_of_ne hi'.1]
        exact fr' i hw
      rw [this]; exact hv i hi
  · have HH := (S1.toIRuns (I := I) (iprog := iprog)).seq (L0.seq (H.seq Fn.toIRuns))
    refine HH.mono' ?_ ?_
    · rw [hDfin, show Ls - 1 + 1 = Ls by omega, ← NLogN.KIL.pieceLevels_eq_levels hm]
    · unfold NLogN.KIL.cPcs
      have hX : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
      have hTl' : (NLogN.KIL.towerL q m (Ls - 1)).length = Ls := by simp [NLogN.KIL.towerL]; omega
      have key := NLogN.KIL.sum_split_le (Ls - 1)
        (fun k => (m + 1) * 10 ^ 9 * (B + 2) ^ 2 + NLogN.KIL.cLvl (n / m ^ (k + 1) % m) (cO (k + 1)) B +
          8000 * (B + 2) + 30)
        (fun j => NLogN.KIL.cLvl (n / m ^ j % m) (cO j) B + (m + 2) * 10 ^ 9 * (B + 2) ^ 2)
        (100 * (n + 1) * 10 ^ 7 * (B + 2) ^ 2 + NLogN.KIL.cLvl (n / m ^ 0 % m) (cO 0) B +
          ((1 + 1 + 1 + 2) * 2000 * (B + 2) + (2 * B + 32)) + (Ls + 2) * 10 ^ 4 * (B + 2))
        (2 * 10 ^ 9 * (n + 2) * (B + 2) ^ 2) (fun k => NLogN.KIL.lvl_arith m B _ _ hX)
        (NLogN.KIL.pcs_arith n m B Ls _ _ hX hLsn)
      rw [show Ls - 1 + 1 = Ls by omega] at key
      rw [hTl', ← hLs]
      simp only [NLogN.KIL.NE.toEx, NLogN.Ex.size]
      generalize ∑ k ∈ Finset.range (Ls - 1), ((m + 1) * 10 ^ 9 * (B + 2) ^ 2 +
        NLogN.KIL.cLvl (n / m ^ (k + 1) % m) (cO (k + 1)) B + 8000 * (B + 2) + 30) = S1 at key ⊢
      generalize ∑ j ∈ Finset.range Ls, (NLogN.KIL.cLvl (n / m ^ j % m) (cO j) B +
        (m + 2) * 10 ^ 9 * (B + 2) ^ 2) = S2 at key ⊢
      linarith
end
