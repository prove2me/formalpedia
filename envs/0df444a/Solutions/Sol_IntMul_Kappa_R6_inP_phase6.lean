  obtain ⟨zs0, hz0⟩ := exists_gflat ys hev
  have hu := phiF_rep6 hQ C.hD C.H Q.b Q.e Q.M Q.S x C.hMS'
    (by rw [C.hS]; rfl) zs0 (by rw [hz0, hys, show Q.d = D + 1 from C.hD])
  have hsc : (2 : ℂ) ^ Q.e / 2 ^ Q.p = (2 : ℂ)⁻¹ ^ (Q.b + 2) :=
    scale_eq _ _ _ (by show Q.p - Q.b - 2 + (Q.b + 2) = Q.p; omega)
  rw [hsc] at hu
  have hu1 : ‖(fun k => (2 : ℂ)⁻¹ ^ (Q.b + 2) * ubar6 C x k)‖ ≤ 1 / 2 :=
    (norm_dgt_le Q.b Q.M x _).trans (by norm_num)
  -- 4. `F̃`
  have hR3 : Q.Base (t0.upd 0 (ints (gflat zs0) ++ t.G 0)) :=
    BaseOK6.upd (BaseOK6.upd hR ARGM (by decide) LA) 0 (by decide) _
  obtain ⟨zs', U, c4, r4, hU, hg, hE, hc4⟩ := ftil_phase6 C.hp₃ C.hp₄ hQ C.hD C.M
    C.hdL C.hL C.hdC C.hζ C.hθ C.hθi C.ha C.hb' C.hbg C.hC C.BL C.BC C.hBL C.hBC _ hR3 zs0
    (fun k => (2 : ℂ)⁻¹ ^ (Q.b + 2) * ubar6 C x k) (t.G 0) (by simp) hu hu1
  rw [IState.upd_upd_same] at r4
  rw [← hz0] at r3
  refine ⟨zs', U, _, r1.seq (r2.seq (r3.seq r4)), hU, hg, hE, ?_⟩
  -- cost
  have hzx : zsz (x : ℤ) ≤ Q.n + 1 := (zsz_lt_pow hx)
  have k1' : ((2 * moveCost (zsz (x : ℤ)) + 19 + kDig6 Q : ℕ) : ℝ) ≤
      ((2 * moveCost (Q.n + 1) + 19 + kDig6 Q : ℕ) : ℝ) := by
    exact_mod_cast (by unfold moveCost; omega)
  unfold kIn6 kFt6
  push_cast at k1' ⊢
  linarith

end

