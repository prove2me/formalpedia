-- title:
--   Conditional independence makes mutual information subadditive
-- statement:
--   Let $X$, $Y_1$, and $Y_2$ be measurable random variables, with arbitrary measurable codomains, on a common probability space $(\Omega,\mathcal F,\mu)$. Suppose $Y_1$ and $Y_2$ are conditionally independent given the sigma algebra generated by $X$. Write $I(V;W)$ for classical mutual information in nats, defined as the Kullback–Leibler divergence of the joint law from the product of its marginals. Then
--
--   $$
--   I\bigl(X;(Y_1,Y_2)\bigr)\le I(X;Y_1)+I(X;Y_2).
--   $$
--
--   All information values lie in $[0,\infty]$; no finite-information assumption is required. This inequality applies to the retained and erased point processes in the paper's thinning argument.
--
--   **Formalization Note** Conditional independence is expressed through conditional expectations of event indicators, so the sample space is not restricted to standard Borel spaces.
-- source:
--   The Degraded Poisson Wiretap Channel, arXiv:1004.0269v1, PDF p. 5, Unnumbered information inequality, pp.5,19, (61)

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P51

noncomputable section

namespace QAlgorithms.Papers.Independent.Intake100.P51

open MeasureTheory Filter

open InformationTheory (klDiv)

open scoped ENNReal

attribute [local instance] Classical.propDecidable

/-- Unnumbered information inequality, PDF p.5; arbitrary-ensemble proof at
PDF pp.18–19, Eqs.(59)–(61). All three variables are measurable on one
probability space. Infinite information values remain allowed. -/
theorem conditionalIndependent_information_subadditive
    {Omega A B C : Type*} [MeasurableSpace Omega] [MeasurableSpace A]
    [MeasurableSpace B] [MeasurableSpace C]
    (mu : Measure Omega) [IsProbabilityMeasure mu]
    (X : Omega → A) (Y : Omega → B) (Z : Omega → C)
    (hX : Measurable X) (hY : Measurable Y) (hZ : Measurable Z)
    (hcond : ConditionallyIndependent mu X Y Z) :
    klDiv (mu.map (fun omega => (X omega, (Y omega, Z omega))))
        ((mu.map X).prod (mu.map (fun omega => (Y omega, Z omega)))) ≤
      klDiv (mu.map (fun omega => (X omega, Y omega)))
          ((mu.map X).prod (mu.map Y)) +
        klDiv (mu.map (fun omega => (X omega, Z omega)))
          ((mu.map X).prod (mu.map Z)) := by sorry

end QAlgorithms.Papers.Independent.Intake100.P51

end
