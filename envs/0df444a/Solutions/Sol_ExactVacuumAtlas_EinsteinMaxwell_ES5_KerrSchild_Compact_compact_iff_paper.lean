namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact

variable {I : Set ℝ} {s h x : ℝ}

/-! ## Chain rule for the chart `x ↦ s + 1/x` -/

theorem hasDerivAt_chart (s : ℝ) (hx : x ≠ 0) :
    HasDerivAt (fun y => s + y⁻¹) (-(x ^ 2)⁻¹) x :=
  (hasDerivAt_inv hx).const_add s

theorem eventually_chart (hI : IsOpen I) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I) :
    ∀ᶠ y in 𝓝 x, y ≠ 0 ∧ s + y⁻¹ ∈ I :=
  (eventually_ne_nhds hx).and
    ((continuousAt_const.add (continuousAt_inv₀ hx)).preimage_mem_nhds (hI.mem_nhds hxI))

theorem hasDerivAt_pull {g : ℝ → ℝ} {g' : ℝ} (hg : HasDerivAt g g' (s + x⁻¹)) (hx : x ≠ 0) :
    HasDerivAt (pull s g) (-g' / x ^ 2) x :=
  (hg.comp x (hasDerivAt_chart s hx)).congr_deriv (by ring)

theorem hasDerivAt_pullM {g : ℝ → ℝ} {g' : ℝ} (hg : HasDerivAt g g' (s + x⁻¹)) (hx : x ≠ 0) :
    HasDerivAt (pullM s g) (g (s + x⁻¹) - g' / x) x := by
  have h1 := (hasDerivAt_id' x).mul (hasDerivAt_pull hg hx)
  refine h1.congr_deriv ?_
  try simp only [pull]
  generalize g (s + x⁻¹) = g₀
  field_simp; ring

