theorem valid_extA {sh : Shape} {r : ℕ} {g : List ℕ → List ℕ} (hg : ∀ a, Valid sh a → Valid sh (g a))
    {a : List ℕ} (ha : Valid (sh ++ [r]) a) : Valid (sh ++ [r]) (extA sh.length g a) := by
  have hl := ha.length_eq
  simp only [List.length_append, List.length_singleton] at hl
  have h1 : Valid sh (a.take sh.length) ∧ Valid [r] (a.drop sh.length) := by
    have := ha
    rw [← List.take_append_drop sh.length a] at this
    exact (valid_append_iff (by simp; omega)).1 this
  exact valid_append (hg _ h1.1) h1.2

end Pull

