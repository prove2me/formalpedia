    centerALowerYBox.Contains (Y (lower E8TAxisProd0142PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0142PaddedInputs.centerAInput.alpha = ((1582869063071984205522252427078437298396856442 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
