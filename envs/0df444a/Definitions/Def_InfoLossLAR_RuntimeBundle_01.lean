    _root_.CurrentAFT.RationalProposalProgram.bodyKernel x.1.1.length x.1.2 x.2.1 x.2.2 := by
  rw [_root_.Integration9_9.TM2NativeBodyKernel.current,_root_.Integration9_9.TM2NativeBodyKernel.sum_range]
