/-- The parameterized cubic for the Leopoldt family. -/
noncomputable def cubicPolynomial (R : Type*) [Ring R] : R[X] := X ^ 3 - C ((t : R)^2) * X - 1

theorem cubicPolynomial_monic (R : Type*) [Ring R] [CharZero R] :
    (cubicPolynomial t R).Monic := by
  rw [cubicPolynomial, sub_sub]
  apply monic_X_pow_sub
  compute_degree!

theorem cubicPolynomial_degree : (cubicPolynomial t ℚ).natDegree = 3 := by
  unfold cubicPolynomial
  compute_degree!

theorem cubicPolynomial_irreducible : Irreducible (cubicPolynomial t ℚ) := by
  rw [((cubicPolynomial_monic t) ℚ).irreducible_iff_roots_eq_zero_of_degree_le_three
    (by rw [(cubicPolynomial_degree t)]; decide) (by rw [(cubicPolynomial_degree t)])]
  rw [Multiset.eq_zero_iff_forall_notMem]
  intro x hx
  have hroot := (mem_roots ((cubicPolynomial_monic t) ℚ).ne_zero).mp hx
  have hxZ : aeval x (cubicPolynomial t ℤ) = 0 := by
    simpa only [cubicPolynomial, Polynomial.IsRoot, eval_sub, eval_mul, eval_pow, eval_X,
      eval_C, eval_natCast, eval_ofNat, eval_one, map_sub, map_mul, map_pow, aeval_X, aeval_C, map_ofNat,
      map_one, map_natCast] using hroot
  obtain ⟨z, hz, hdvd⟩ := exists_integer_of_is_root_of_monic ((cubicPolynomial_monic t) ℤ) hxZ
  have hunit : IsUnit z := isUnit_of_dvd_one (by simpa [cubicPolynomial] using hdvd)
  have htn : 2 ≤ t := Fact.out
  have ht : (2 : ℚ) ≤ (t : ℚ) := by exact_mod_cast htn
  rcases Int.isUnit_iff.mp hunit with h | h <;>
    norm_num [hz, h, cubicPolynomial, Polynomial.IsRoot] at hroot <;> first | omega | nlinarith

/-- The Galois closure of the field generated by a root of `X³ − t²X − 1`. -/
abbrev CubicK := (cubicPolynomial t ℚ).SplittingField

instance : NumberField (CubicK t) where
  to_charZero := inferInstance
  to_finiteDimensional := inferInstance

instance : IsGalois ℚ (CubicK t) := by
  let _ : IsSplittingField ℚ (CubicK t) (cubicPolynomial t ℚ) :=
    Polynomial.IsSplittingField.splittingField (cubicPolynomial t ℚ)
  exact IsGalois.of_separable_splitting_field (cubicPolynomial_irreducible t).separable

noncomputable def rootLabel : Fin 3 ≃ (cubicPolynomial t ℚ).rootSet (CubicK t) :=
  (Fintype.equivFinOfCardEq ((Polynomial.card_rootSet_eq_natDegree
    (cubicPolynomial_irreducible t).separable (Polynomial.SplittingField.splits _)).trans
    (cubicPolynomial_degree t))).symm

noncomputable def cubicRoot (i : Fin 3) : (CubicK t) := ((rootLabel t) i).val

theorem cubicRoot_injective : Function.Injective (cubicRoot t) :=
  fun _ _ h => (rootLabel t).injective (Subtype.ext h)

theorem cubicRoot_cube (i : Fin 3) : (cubicRoot t) i ^ 3 = (t : CubicK t)^2 * (cubicRoot t) i + 1 := by
  have hroot := (mem_rootSet.mp ((rootLabel t) i).property).2
  change aeval ((cubicRoot t) i) (cubicPolynomial t ℚ) = 0 at hroot
  simp only [cubicPolynomial, map_sub, map_mul, map_pow, aeval_X, map_ofNat, map_one, aeval_C, map_natCast] at hroot
  linear_combination hroot

noncomputable def integralRoot (i : Fin 3) : 𝓞 (CubicK t) :=
  ⟨(cubicRoot t) i, ⟨cubicPolynomial t ℤ, (cubicPolynomial_monic t) ℤ, by
    change aeval ((cubicRoot t) i) (cubicPolynomial t ℤ) = 0
    simp only [cubicPolynomial, map_sub, map_mul, map_pow, aeval_X, map_ofNat, map_one, aeval_C, map_natCast]
    linear_combination (cubicRoot_cube t) i⟩⟩

@[simp] theorem coe_integralRoot (i : Fin 3) : ((integralRoot t) i : (CubicK t)) = (cubicRoot t) i := rfl

theorem integralRoot_cube (i : Fin 3) : (integralRoot t) i ^ 3 = (t : 𝓞 (CubicK t))^2 * (integralRoot t) i + 1 :=
  Subtype.ext ((cubicRoot_cube t) i)

private theorem cubicRoot_pair_relation {i j : Fin 3} (hij : i ≠ j) :
    (cubicRoot t) i ^ 2 + (cubicRoot t) i * (cubicRoot t) j + (cubicRoot t) j ^ 2 = (t : CubicK t)^2 := by
  apply sub_eq_zero.mp
  refine (mul_eq_zero.mp ?_).resolve_left (sub_ne_zero.mpr ((cubicRoot_injective t).ne hij))
  linear_combination (cubicRoot_cube t) i - (cubicRoot_cube t) j

theorem cubicRoot_vieta :
    (cubicRoot t) 0 + (cubicRoot t) 1 + (cubicRoot t) 2 = 0 ∧
    (cubicRoot t) 0 * (cubicRoot t) 1 + (cubicRoot t) 0 * (cubicRoot t) 2 + (cubicRoot t) 1 * (cubicRoot t) 2 = -(t : CubicK t)^2 ∧
    (cubicRoot t) 0 * (cubicRoot t) 1 * (cubicRoot t) 2 = 1 := by
  let a := (cubicRoot t) 0
  let b := (cubicRoot t) 1
  let c := (cubicRoot t) 2
  change a + b + c = 0 ∧ a * b + a * c + b * c = -(t : CubicK t)^2 ∧ a * b * c = 1
  have hab : a ^ 2 + a * b + b ^ 2 = (t : CubicK t)^2 := (cubicRoot_pair_relation t) (by decide : (0 : Fin 3) ≠ 1)
  have hac : a ^ 2 + a * c + c ^ 2 = (t : CubicK t)^2 := (cubicRoot_pair_relation t) (by decide : (0 : Fin 3) ≠ 2)
  have hbc : b ≠ c := (cubicRoot_injective t).ne (by decide : (1 : Fin 3) ≠ 2)
  have hsum : a + b + c = 0 := by
    refine (mul_eq_zero.mp ?_).resolve_left (sub_ne_zero.mpr hbc)
    linear_combination hab - hac
  have hpair : a * b + a * c + b * c = -(t : CubicK t)^2 := by
    linear_combination (a + b) * hsum - hab
  have ha : a ^ 3 = (t : CubicK t)^2 * a + 1 := (cubicRoot_cube t) 0
  exact ⟨hsum, hpair, by linear_combination a * hpair - a ^ 2 * hsum + ha⟩

theorem integralRoot_vieta :
    (integralRoot t) 0 + (integralRoot t) 1 + (integralRoot t) 2 = 0 ∧
    (integralRoot t) 0 * (integralRoot t) 1 + (integralRoot t) 0 * (integralRoot t) 2 +
      (integralRoot t) 1 * (integralRoot t) 2 = -(t : 𝓞 (CubicK t))^2 ∧
    (integralRoot t) 0 * (integralRoot t) 1 * (integralRoot t) 2 = 1 :=
  ⟨Subtype.ext (cubicRoot_vieta t).1, Subtype.ext (cubicRoot_vieta t).2.1, Subtype.ext (cubicRoot_vieta t).2.2⟩

/-- The oriented square root of the cubic discriminant. -/
noncomputable def discriminantRoot : (CubicK t) :=
  ((cubicRoot t) 0 - (cubicRoot t) 1) * ((cubicRoot t) 0 - (cubicRoot t) 2) * ((cubicRoot t) 1 - (cubicRoot t) 2)

theorem discriminantRoot_sq : (discriminantRoot t) ^ 2 = 4*(t : CubicK t)^6 - 27 := by
  let a := (cubicRoot t) 0
  let b := (cubicRoot t) 1
  let c := (cubicRoot t) 2
  let s := a + b + c
  let v := a * b + a * c + b * c
  let u := a * b * c
  have hs : s = 0 := (cubicRoot_vieta t).1
  have ht : v = -(t : CubicK t)^2 := (cubicRoot_vieta t).2.1
  have hu : u = 1 := (cubicRoot_vieta t).2.2
  calc
    (discriminantRoot t) ^ 2 = s ^ 2 * v ^ 2 - 4 * v ^ 3 - 4 * s ^ 3 * u - 27 * u ^ 2
        + 18 * s * v * u := by
      change ((a - b) * (a - c) * (b - c)) ^ 2 = _
      dsimp only [s, v, u]
      ring
    _ = 4*(t : CubicK t)^6 - 27 := by rw [hs, ht, hu]; ring

noncomputable def integralDiscriminantRoot : 𝓞 (CubicK t) :=
  ((integralRoot t) 0 - (integralRoot t) 1) * ((integralRoot t) 0 - (integralRoot t) 2) *
    ((integralRoot t) 1 - (integralRoot t) 2)

@[simp] theorem coe_integralDiscriminantRoot :
    ((integralDiscriminantRoot t) : (CubicK t)) = (discriminantRoot t) := rfl

theorem integralDiscriminantRoot_sq : (integralDiscriminantRoot t) ^ 2 = 4*(t : 𝓞 (CubicK t))^6 - 27 :=
  Subtype.ext (discriminantRoot_sq t)

noncomputable def rootPermutation (σ : (CubicK t) ≃ₐ[ℚ] (CubicK t)) : Equiv.Perm (Fin 3) :=
  letI : MulAction ((CubicK t) ≃ₐ[ℚ] (CubicK t)) ((cubicPolynomial t ℚ).rootSet (CubicK t)) :=
    Polynomial.Gal.galActionAux (cubicPolynomial t ℚ)
  (rootLabel t).symm.permCongr (MulAction.toPerm σ)

theorem rootPermutation_apply (σ : (CubicK t) ≃ₐ[ℚ] (CubicK t)) (i : Fin 3) :
    (cubicRoot t) ((rootPermutation t) σ i) = σ ((cubicRoot t) i) := by
  change (((rootLabel t) ((rootLabel t).symm _)).val : (CubicK t)) = _
  rw [Equiv.apply_symm_apply]
  rfl

theorem map_integralRoot (σ : (CubicK t) ≃ₐ[ℚ] (CubicK t)) (i : Fin 3) :
    RingOfIntegers.mapRingEquiv σ.toRingEquiv ((integralRoot t) i) =
      (integralRoot t) ((rootPermutation t) σ i) :=
  Subtype.ext ((rootPermutation_apply t) σ i).symm

theorem rootPermutation_injective : Function.Injective (rootPermutation t) := by
  intro σ τ heq
  apply Polynomial.Gal.ext (p := cubicPolynomial t ℚ)
  intro x hx
  let i := (rootLabel t).symm ⟨x, hx⟩
  have hroot : (cubicRoot t) i = x := congrArg Subtype.val ((rootLabel t).apply_symm_apply ⟨x, hx⟩)
  change σ x = τ x
  rw [← hroot]
  exact ((rootPermutation_apply t) σ i).symm.trans
    ((congrArg (fun π : Equiv.Perm (Fin 3) => (cubicRoot t) (π i)) heq).trans ((rootPermutation_apply t) τ i))

private theorem discriminant_not_square : ¬ IsSquare (4 * (t : ℚ)^6 - 27) := by
  have hcast : (4 : ℚ) * (t : ℚ)^6 - 27 = ((4 * (t : ℤ)^6 - 27 : ℤ) : ℚ) := by norm_cast
  rw [hcast, Rat.isSquare_intCast_iff]
  rintro ⟨z, hz⟩
  let a : ℤ := 2*(t : ℤ)^3
  have ht : (2 : ℤ) ≤ t := by exact_mod_cast (Fact.out : 2 ≤ t)
  have ha : 15 < a := by
    have hcube : (2 : ℤ)^3 ≤ (t : ℤ)^3 := by gcongr
    dsimp [a]
    omega
  have heq : |z| ^ 2 = a^2 - 27 := by
    rw [sq_abs]
    dsimp [a]
    nlinarith [hz]
  by_cases h : |z| < a
  · have hzle : |z| ≤ a - 1 := by omega
    have hsq : |z|^2 ≤ (a-1)^2 := by gcongr
    nlinarith [heq, hsq]
  · have hsq : a^2 ≤ |z|^2 := by gcongr; omega
    nlinarith [heq, hsq]

private theorem two_dvd_cubicK_finrank : 2 ∣ Module.finrank ℚ (CubicK t) := by
  let q : ℚ[X] := X ^ 2 - C (4*(t : ℚ)^6 - 27)
  have hmon : q.Monic := monic_X_pow_sub_C _ (by decide)
  have hdeg : q.natDegree = 2 := natDegree_X_pow_sub_C
  have hns : ¬ IsSquare (4*(t : ℚ)^6 - 27) := (discriminant_not_square t)
  have hirr : Irreducible q := by
    rw [hmon.irreducible_iff_roots_eq_zero_of_degree_le_three (by simp [hdeg]) (by simp [hdeg])]
    refine Multiset.eq_zero_iff_forall_notMem.mpr fun x hx => hns ?_
    have hx' : x ^ 2 = (4*(t : ℚ)^6 - 27) := by
      simpa only [q, Polynomial.IsRoot, eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero]
        using (mem_roots hmon.ne_zero).mp hx
    exact (isSquare_iff_exists_sq _).mpr ⟨x, hx'.symm⟩
  have hq : aeval (discriminantRoot t) q = 0 := by
    simp only [q, map_sub, map_pow, aeval_X, aeval_C, map_ofNat, map_natCast, map_sub, map_mul, map_pow, (discriminantRoot_sq t), sub_self]
  have hmin := minpoly.eq_of_irreducible_of_monic hirr hq hmon
  rw [← hdeg, hmin]
  exact minpoly.degree_dvd ⟨q, hmon, hq⟩

private theorem card_finThreePerm : Fintype.card (Equiv.Perm (Fin 3)) = 6 := by
  rw [Fintype.card_perm, Fintype.card_fin]
  decide

theorem card_cubicGalois_eq_six : Fintype.card ((CubicK t) ≃ₐ[ℚ] (CubicK t)) = 6 := by
  have hcard : Fintype.card ((CubicK t) ≃ₐ[ℚ] (CubicK t)) = Module.finrank ℚ (CubicK t) := by
    rw [Fintype.card_eq_nat_card, IsGalois.card_aut_eq_finrank]
  have hupper := Fintype.card_le_of_injective (rootPermutation t) (rootPermutation_injective t)
  rw [hcard, card_finThreePerm] at hupper
  have hthree : 3 ∣ Module.finrank ℚ (CubicK t) := by
    rw [← (cubicPolynomial_degree t)]
    exact (cubicPolynomial_irreducible t).natDegree_dvd_finrank (Polynomial.SplittingField.splits _)
  have hsix : 6 ∣ Module.finrank ℚ (CubicK t) :=
    (by decide : Nat.Coprime 2 3).mul_dvd_of_dvd_of_dvd (two_dvd_cubicK_finrank t) hthree
  exact hcard.trans (le_antisymm hupper (Nat.le_of_dvd Module.finrank_pos hsix))

theorem rootPermutation_surjective : Function.Surjective (rootPermutation t) :=
  ((Fintype.bijective_iff_injective_and_card (rootPermutation t)).mpr
    ⟨(rootPermutation_injective t), (card_cubicGalois_eq_six t).trans card_finThreePerm.symm⟩).2

theorem rootPermutation_mul (σ τ : (CubicK t) ≃ₐ[ℚ] (CubicK t)) :
    (rootPermutation t) (σ * τ) = (rootPermutation t) σ * (rootPermutation t) τ := by
  apply Equiv.ext
  intro i
  apply (cubicRoot_injective t)
  change (cubicRoot t) ((rootPermutation t) (σ * τ) i) =
    (cubicRoot t) ((rootPermutation t) σ ((rootPermutation t) τ i))
  simp only [(rootPermutation_apply t), AlgEquiv.mul_apply]

noncomputable def cubicGaloisEquivS3 : ((CubicK t) ≃ₐ[ℚ] (CubicK t)) ≃* Equiv.Perm (Fin 3) where
  toEquiv := Equiv.ofBijective (rootPermutation t) ⟨(rootPermutation_injective t), (rootPermutation_surjective t)⟩
  map_mul' := (rootPermutation_mul t)

theorem cubicGalois_not_commutative : ¬ IsMulCommutative ((CubicK t) ≃ₐ[ℚ] (CubicK t)) := by
  intro commutative
  obtain ⟨σ, hσ⟩ := (rootPermutation_surjective t) (Equiv.swap (0 : Fin 3) 1)
  obtain ⟨τ, hτ⟩ := (rootPermutation_surjective t) (Equiv.swap (1 : Fin 3) 2)
  have hcomm := congrArg (rootPermutation t) (commutative.is_comm.comm σ τ)
  rw [(rootPermutation_mul t), (rootPermutation_mul t), hσ, hτ] at hcomm
  exact (by decide : Equiv.swap (0 : Fin 3) 1 * Equiv.swap 1 2 ≠
    Equiv.swap 1 2 * Equiv.swap 0 1) hcomm

private theorem cubicPolynomial_splits_real :
    ((cubicPolynomial t ℚ).map (algebraMap ℚ ℝ)).Splits := by
  classical
  have hm : (cubicPolynomial t ℚ).map (algebraMap ℚ ℝ) = cubicPolynomial t ℝ := by
    simp [cubicPolynomial]
  let p := cubicPolynomial t ℝ
  let f := p.eval
  have hc : Continuous f := p.continuous
  let T : ℝ := t
  have hT : 2 ≤ T := by
    dsimp [T]
    exact_mod_cast (Fact.out : 2 ≤ t)
  have heval (x : ℝ) : f x = x^3 - T^2*x - 1 := by
    simp [f, p, cubicPolynomial, T]
  obtain ⟨a, haI, ha⟩ := intermediate_value_Icc (show -T ≤ -1 by linarith) hc.continuousOn
    (show 0 ∈ Set.Icc (f (-T)) (f (-1)) by
      rw [Set.mem_Icc, heval, heval]
      constructor <;> nlinarith)
  obtain ⟨b, hbI, hb⟩ := intermediate_value_Icc' (by norm_num : (-1 : ℝ) ≤ 0) hc.continuousOn
    (show 0 ∈ Set.Icc (f 0) (f (-1)) by
      rw [Set.mem_Icc, heval, heval]
      constructor <;> nlinarith)
  obtain ⟨c, hcI, hcr⟩ := intermediate_value_Icc (show T ≤ T+1 by linarith) hc.continuousOn
    (show 0 ∈ Set.Icc (f T) (f (T+1)) by
      rw [Set.mem_Icc, heval, heval]
      constructor <;> nlinarith)
  have hane : a ≠ -1 := by
    rintro rfl
    rw [heval] at ha
    nlinarith
  have hab : a ≠ b := ne_of_lt (lt_of_lt_of_le (lt_of_le_of_ne haI.2 hane) hbI.1)
  have hac : a ≠ c := ne_of_lt (by linarith [haI.2, hcI.1])
  have hbc : b ≠ c := ne_of_lt (by linarith [hbI.2, hcI.1])
  have hdeg : p.natDegree = 3 := by
    change (cubicPolynomial t ℝ).natDegree = 3
    rw [← hm, natDegree_map, (cubicPolynomial_degree t)]
  have hmem (x : ℝ) (hx : f x = 0) : x ∈ p.roots.toFinset :=
    Multiset.mem_toFinset.mpr ((mem_roots ((cubicPolynomial_monic t) ℝ).ne_zero).mpr hx)
  have hsub : ({a, b, c} : Finset ℝ) ⊆ p.roots.toFinset := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl
    · exact hmem _ ha
    · exact hmem _ hb
    · exact hmem _ hcr
  have hle := (Finset.card_le_card hsub).trans (Multiset.toFinset_card_le p.roots)
  have hthree : ({a, b, c} : Finset ℝ).card = 3 := by simp [hab, hac, hbc]
  rw [hthree] at hle
  rw [hm, splits_iff_card_roots]
  exact le_antisymm (card_roots' p) (hdeg ▸ hle)

noncomputable def cubicRealEmbedding : (CubicK t) →ₐ[ℚ] ℝ :=
  Polynomial.SplittingField.lift (cubicPolynomial t ℚ) (cubicPolynomial_splits_real t)

instance cubicK_totallyReal : IsTotallyReal (CubicK t) := by
  let emb : (CubicK t) →ₐ[ℚ] ℂ := (IsScalarTower.toAlgHom ℚ ℝ ℂ).comp (cubicRealEmbedding t)
  let _ : Algebra (CubicK t) ℂ := emb.toRingHom.toAlgebra
  let _ : IsScalarTower ℚ (CubicK t) ℂ := IsScalarTower.of_algebraMap_eq (fun q => (emb.commutes q).symm)
  refine ⟨fun w => NumberField.InfinitePlace.isReal_iff.mpr ?_⟩
  apply ComplexEmbedding.isReal_iff.mpr
  ext x
  let f : (CubicK t) →ₐ[ℚ] ℂ := w.embedding.toRatAlgHom
  have hx := f.restrictNormal_commutes (CubicK t) x
  change (((cubicRealEmbedding t) (f.restrictNormal (CubicK t) x) : ℝ) : ℂ) = w.embedding x at hx
  rw [ComplexEmbedding.conjugate_coe_eq, ← hx, Complex.conj_ofReal]

