/-- Quotienting out one member of a generating pair leaves a cyclic quotient.
Neither finiteness nor an order condition on the killed generator is needed. -/
theorem p2m_local_abelian_quotient_zmultiples_generator_of_pair
    {Q : Type*} [AddCommGroup Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤) :
    AddSubgroup.zmultiples (α : Q ⧸ AddSubgroup.zmultiples δ) = ⊤ := by
  apply top_unique
  intro q _
  refine QuotientAddGroup.induction_on q ?_
  intro z
  have hz : z ∈ AddSubgroup.closure ({α, δ} : Set Q) := by rw [hgen]; trivial
  obtain ⟨m, n, hmn⟩ := AddSubgroup.mem_closure_pair.mp hz
  apply AddSubgroup.mem_zmultiples_iff.mpr
  refine ⟨m, ?_⟩
  have hδ : (δ : Q ⧸ AddSubgroup.zmultiples δ) = 0 :=
    (QuotientAddGroup.eq_zero_iff δ).mpr (AddSubgroup.mem_zmultiples δ)
  have he := congrArg (QuotientAddGroup.mk' (AddSubgroup.zmultiples δ)) hmn
  simpa only [map_add, map_zsmul, QuotientAddGroup.mk'_apply, hδ,
    zsmul_zero, add_zero] using he








end Couret.CayleyDoublet

