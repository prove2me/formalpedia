line `x` of `N = n_c λ` positions (`s ≤ N`):

1. `Y = applyL x`: the chunk kernel on each `λ`-chunk (`M⁻¹`);
2. the values of `Y` on the line `L = Jlist B`, the two capacitance kernels (`jsolve_eq`);
3. the coupling window kernel on the cyclic extension (`couple_window`), scattered back to the
   positions (zero off `L`);
4. `Y₂ = applyL` of the scattered coupling; the output is `Y - Y₂`.

**`segLineC_eq`**: entry `u < N` of the result is `segInvS … u` for `u < s` and `0` beyond.
-/

open Finset

namespace J6Seg

section segline
variable (P R s t lam w α K : ℕ)

variable {P R s t lam w α K}

lemma LJ_sorted : (LJ s t lam w).Pairwise (· < ·) := Jlist_pairwise _

lemma LJ_lt {x : ℕ} (hx : x ∈ LJ s t lam w) : x < s := by
  unfold LJ Jlist at hx
  rw [List.mem_filter, List.mem_range] at hx
  exact hx.1

lemma LJ_getD_lt {r : ℕ} (hr : r < (LJ s t lam w).length) : (LJ s t lam w).getD r 0 < s := by
  rw [List.getD_eq_getElem _ _ hr]; exact LJ_lt (List.getElem_mem _)

end segline

end J6Seg

end

