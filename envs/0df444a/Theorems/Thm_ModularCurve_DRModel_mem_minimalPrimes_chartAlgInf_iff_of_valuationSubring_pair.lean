-- title:
--   Minimal primes of p in the pole chart ring are branch centres
-- statement:
--   Let $p$ be a prime and let $F$ be the field `modularFunctionFieldFull p`, the subfield of the Laurent series field $\mathbb{Q}((q))$ generated over $\mathbb{Q}$ by the divisor expansions at level $p$; write $j$ for `IgusaScheme.jFull p`, the element of $F$ given by the $q$-expansion `jq`. The data are: an element $j_p$ of `TwoChartIntegralModel.chartAlgFin ℤ F j`, i.e. an element of $F$ integral over the subring $\mathbb{Z}[j]$, whose Laurent expansion is `qExpand ℚ p jq` (the series `jq` with exponents multiplied by $p$); and two valuation subrings $W_0 \neq W_1$ of $F$, in each of which $p$ is a non-unit, such that for $i \in \{0,1\}$ and every $P \in \mathbb{Z}[X]$ whose reduction modulo $p$ is nonzero both $P(j)$ and $P(j)^{-1}$ lie in $W_i$, and such that every valuation subring $V$ of $F$ in which $p$ is a non-unit and which has this same property for all such $P$ equals $W_0$ or $W_1$; finally $j_p - j^p$ lies in the non-units of $W_0$. Put $A =$ `TwoChartIntegralModel.chartAlgInf ℤ F j`, the subalgebra of elements of $F$ integral over $\mathbb{Z}[j^{-1}]$. The conclusion is that an ideal $\mathfrak{p}$ of $A$ is a minimal prime over the ideal generated by $p$ in $A$ if and only if $\mathfrak{p}$ consists exactly of those $a \in A$ that are non-units of $W_0$, or exactly of those that are non-units of $W_1$.
--
--   This is the pole-chart (coordinate $1/j$) form of the statement that the fibre at $p$ of the integral model of $X_0(p)$ has exactly two components, whose generic points are the centres in the chart ring of the two branch valuation rings $W_0$, $W_1$ of Deligne–Rapoport. It is used in the construction of the curve model and its $p$-fibre, in particular by the statements producing closed immersions of the two components and the crossing point data at the supersingular locus.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_DRModel_mem_minimalPrimes_chartAlgInf_iff_of_valuationSubring_pair.lean

import Mathlib
import Definitions.Def_ModularCurve_IgusaScheme
import Definitions.Def_AlgebraicCurve_TwoChartIntegralModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve AlgebraicCurve Polynomial
set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 800000

theorem ModularCurve.DRModel.mem_minimalPrimes_chartAlgInf_iff_of_valuationSubring_pair
    (p : ℕ) [Fact p.Prime] [NeZero p]
    (jp : ↥(TwoChartIntegralModel.chartAlgFin ℤ ↥(modularFunctionFieldFull p) (IgusaScheme.jFull p)))
    (hjp : ((jp : ↥(modularFunctionFieldFull p)) : LaurentSeries ℚ) = qExpand ℚ p jq)
    (W₀ W₁ : ValuationSubring ↥(modularFunctionFieldFull p))
    (hp₀ : ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ W₀.nonunits)
    (hp₁ : ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ W₁.nonunits)
    (hne : W₀ ≠ W₁)
    (hgen : ∀ i : Fin 2, ∀ P : Polynomial ℤ, P.map (Int.castRingHom (ZMod p)) ≠ 0 →
        Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P
            ∈ (![W₀, W₁] i) ∧
        (Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P)⁻¹
            ∈ (![W₀, W₁] i))
    (hcomplete : ∀ V : ValuationSubring ↥(modularFunctionFieldFull p),
        ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ V.nonunits →
        (∀ P : Polynomial ℤ, P.map (Int.castRingHom (ZMod p)) ≠ 0 →
          Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P ∈ V ∧
          (Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P)⁻¹ ∈ V) →
        V = W₀ ∨ V = W₁)
    (ht : ((jp : ↥(modularFunctionFieldFull p)) - (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) ^ p) ∈ W₀.nonunits) :
    let A := TwoChartIntegralModel.chartAlgInf ℤ ↥(modularFunctionFieldFull p) (IgusaScheme.jFull p)
    ∀ 𝔭 : Ideal ↥A, 𝔭 ∈ (Ideal.span {((p : ℕ) : ↥A)}).minimalPrimes ↔
        ((∀ a : ↥A, a ∈ 𝔭 ↔ ((a : ↥(modularFunctionFieldFull p)) ∈ W₀.nonunits)) ∨
         (∀ a : ↥A, a ∈ 𝔭 ↔ ((a : ↥(modularFunctionFieldFull p)) ∈ W₁.nonunits))) := by sorry
