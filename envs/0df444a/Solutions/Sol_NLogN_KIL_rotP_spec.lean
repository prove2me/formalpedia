      rw [upd_k0, upd_k0]
      exact rBlk_sp s r P Q B Bb as hr hb has p hp zQ zB)
  have hlen := length_outR r P Q B as hr has
  have m1 := Sp.mvK (X := 12) (Y := 0) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF (NLogN.KIL.rSt r P Q B as P [])) (.reg 8) (clean_reg (by decide))
    (ok_reg (l := []) rfl) (outR r Q as P).reverse [] (by rw [List.append_nil]; rfl)
    (by rw [eval_reg (l := []) rfl, List.length_reverse, hlen]; push_cast; ring) Bb
    (NLogN.KIL.bnd_reverse (bnd_flatMap fun p => bnd_rotBlk r Q Bb as hb p)) trivial
    (bnd_reg (l := []) rfl zV)
  rw [upd_o, upd_x] at m1
  refine Sp.mono (Sp.congr (p1.seq (hloop.seq (m1.seq
    (Sp.pop (i := 8) (l := []) (B := Bb) s _ (by decide) rfl zV)))) ?_) ?_
  · rw [upd_V]
    congr 2
    simp [NLogN.KIL.rSt, rIO, toF_x, outR]
