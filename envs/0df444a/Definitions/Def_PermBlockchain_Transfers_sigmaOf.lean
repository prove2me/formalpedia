-- title:
--   Fulfilment levels generated by an action profile
-- statement:
--   In the supply-chain model of Iyengar, Saleh, Sethuraman and Wang, two vendors $h,l$ supply $4m$ manufacturers, each of a type $(q_i,\xi_i)\in\{A,B\}\times\{h,l\}$, and a unit mass of consumers buys from the manufacturers or takes an outside option.
--
--   For an action profile, the fulfilment levels $\sigma_i$ are those the vendor rule chooses at the profile's vendor prices $\Psi$ and demands $s$.
-- source:
--   Iyengar, Saleh, Sethuraman, Wang, Economics of Permissioned Blockchain Adoption, SSRN 3602376 (version of 2022-08-19), §3.1, p. 11 (PDF p. 12)

import Mathlib
import Definitions.Def_PermBlockchain_Transfers_sOf
import Definitions.Def_PermBlockchain_Transfers_VendorRule

namespace PermBlockchain.Transfers

/-- **The fulfilment levels `σ_i` the vendors choose for an action profile.**
Iyengar, Saleh, Sethuraman, Wang, *Economics of Permissioned Blockchain Adoption*,
SSRN 3602376 (version of 2022-08-19), §3.1, p. 11 (PDF p. 12): "(3) and (4) show that σ_i depends upon Ψ_i, whereas s_i is a
function of P_i". -/
noncomputable def sigmaOf {m : ℕ} (ν : MeasureTheory.Measure ℝ) (fee : FeeRule m)
    (w : PurchaseRule m) (vend : VendorRule m) (θ : Mfr m → MType) (α : Mfr m → Act) :
    Mfr m → ℝ :=
  vend θ (fun i => (α i).2.2) (sOf ν fee w θ α)

end PermBlockchain.Transfers


