section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartC
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
variable {σ : Type*}
lemma degLE_iff (w : σ → ℕ) (d : ℕ) (p : MvPolynomial σ ℝ) :
    DegLE w d p ↔ ∀ s, d < Finsupp.weight w s → coeff s p = 0 := by
  constructor
  · intro h s hs
    by_contra hc
    exact absurd (h s (mem_support_iff.2 hc)) (not_le.2 hs)
  · intro h s hs
    by_contra hc
    exact mem_support_iff.1 hs (h s (not_le.1 hc))

lemma degLE_add {w : σ → ℕ} {d : ℕ} {p q : MvPolynomial σ ℝ} (hp : DegLE w d p)
    (hq : DegLE w d q) : DegLE w d (p + q) := by
  rw [degLE_iff] at *
  intro s hs; rw [coeff_add, hp s hs, hq s hs, add_zero]

lemma degLE_sub {w : σ → ℕ} {d : ℕ} {p q : MvPolynomial σ ℝ} (hp : DegLE w d p)
    (hq : DegLE w d q) : DegLE w d (p - q) := by
  rw [degLE_iff] at *
  intro s hs; rw [coeff_sub, hp s hs, hq s hs, sub_zero]

lemma degLE_zero' {w : σ → ℕ} {d : ℕ} : DegLE w d (0 : MvPolynomial σ ℝ) := by
  intro s hs; simp at hs

lemma degLE_sum {ι : Type*} {w : σ → ℕ} {d : ℕ} (T : Finset ι) (f : ι → MvPolynomial σ ℝ)
    (h : ∀ i ∈ T, DegLE w d (f i)) : DegLE w d (∑ i ∈ T, f i) := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa using degLE_zero'
  | insert a T ha ih =>
    rw [Finset.sum_insert ha]
    exact degLE_add (h a (by simp)) (ih fun i hi => h i (by simp [hi]))

lemma degLE_comp {w : σ → ℕ} {d : ℕ} {p : MvPolynomial σ ℝ} (w' : σ → ℕ) (e : ℕ)
    (hp : DegLE w d p) : DegLE w d (weightedHomogeneousComponent w' e p) := by
  classical
  rw [degLE_iff] at *
  intro s hs
  rw [coeff_weightedHomogeneousComponent, hp s hs]; simp

lemma degLE_of_homog {w : σ → ℕ} {d : ℕ} {p : MvPolynomial σ ℝ}
    (hp : IsWeightedHomogeneous w p d) : DegLE w d p := by
  intro s hs
  exact (hp (mem_support_iff.1 hs)).le

lemma topTerm_degLE {w : σ → ℕ} {f : MvPolynomial σ ℝ} {μ : σ →₀ ℕ} (hf : TopTerm w f μ) :
    DegLE w (Finsupp.weight w μ) f := by
  classical
  intro s hs
  by_cases h : s = μ
  · rw [h]
  have : s ∈ (f - monomial μ 1).support := by
    rw [mem_support_iff, coeff_sub, coeff_monomial, if_neg (fun e => h e.symm), sub_zero]
    exact mem_support_iff.1 hs
  exact (hf s this).le

lemma topTerm_comp {w : σ → ℕ} {f : MvPolynomial σ ℝ} {μ : σ →₀ ℕ} (hf : TopTerm w f μ) :
    weightedHomogeneousComponent w (Finsupp.weight w μ) f = monomial μ 1 := by
  have : f = monomial μ 1 + (f - monomial μ 1) := by ring
  rw [this, map_add, weightedHomogeneousComponent_eq_self
      (isWeightedHomogeneous_monomial _ _ _ rfl),
    weightedHomogeneousComponent_eq_zero' _ _ (fun s hs => (hf s (by simpa using hs)).ne),
    add_zero]

lemma pow_degLE_comp (w : σ → ℕ) {a : ℕ} {p : MvPolynomial σ ℝ} (hp : DegLE w a p) :
    ∀ e : ℕ, DegLE w (e * a) (p ^ e) ∧
      weightedHomogeneousComponent w (e * a) (p ^ e) = (weightedHomogeneousComponent w a p) ^ e
  | 0 => by
    simp only [zero_mul, pow_zero]
    refine ⟨?_, weightedHomogeneousComponent_eq_self (isWeightedHomogeneous_one (R := ℝ) w)⟩
    exact degLE_of_homog (isWeightedHomogeneous_one (R := ℝ) w)
  | e + 1 => by
    obtain ⟨h1, h2⟩ := pow_degLE_comp w hp e
    have he : (e + 1) * a = e * a + a := by ring
    rw [he, pow_succ, pow_succ]
    exact ⟨degLE_mul w h1 hp, by rw [comp_mul w h1 hp, h2]⟩

/-- The weight-`d` component vanishes when `p` has weight `≤ d` and component zero ⇒ `< d`. -/
lemma lt_of_comp_zero {w : σ → ℕ} {d : ℕ} {p : MvPolynomial σ ℝ} (hp : DegLE w d p)
    (hc : weightedHomogeneousComponent w d p = 0) :
    ∀ s ∈ p.support, Finsupp.weight w s < d := by
  classical
  intro s hs
  refine lt_of_le_of_ne (hp s hs) fun he => mem_support_iff.1 hs ?_
  have := congrArg (coeff s) hc
  rwa [coeff_weightedHomogeneousComponent, if_pos he, coeff_zero] at this

/-- Finite decomposition into `w'`-components. -/
lemma sum_comp_range (w' : σ → ℕ) (p : MvPolynomial σ ℝ) :
    ∃ N : ℕ, p = ∑ e ∈ Finset.range (N + 1), weightedHomogeneousComponent w' e p := by
  classical
  refine ⟨p.support.sup (Finsupp.weight w'), ?_⟩
  ext s
  rw [coeff_sum]
  simp only [coeff_weightedHomogeneousComponent]
  rw [Finset.sum_ite_eq]
  split_ifs with h
  · rfl
  · by_contra hc
    exact h (Finset.mem_range.2 (Nat.lt_succ_of_le
      (Finset.le_sup (f := Finsupp.weight w') (mem_support_iff.2 hc))))

end SoSLinAlg.WeakRank.Dev.Leaf.PartC
end
end

section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartC
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
variable {n r : ℕ} (I J : Finset (Fin n))
lemma eval_xy (X Y : Matrix (Fin n) (Fin r) ℝ) (i j : Fin n) :
    MvPolynomial.eval (assignment X Y) (xy i j) = (X * Y.transpose) i j := by
  simp [xy, x, y, assignment, Matrix.mul_apply]

lemma van_sub_gen (F : Poly n r) (hF : Van I J F) (c : Idx I J → Poly n r) :
    Van I J (F - ∑ l, c l * gen I J l) := by
  intro X Y hXY
  rw [map_sub, hF X Y hXY, map_sum]
  simp only [map_mul, gen, eval_xy]
  rw [Finset.sum_eq_zero, sub_zero]
  intro l _
  rw [hXY _ l.2.1 _ l.2.2, mul_zero]

/-- One `wx`-homogeneous piece. -/
lemma step (hIJ : I.card + J.card ≤ r) (G : Poly n r) (e d : ℕ)
    (hG : IsWeightedHomogeneous (wx I r) G e) (hv : Van I J G) (hd : DegLE (wt I J r) d G) :
    weightedHomogeneousComponent (wt I J r) d G ∈ monIdeal (mu I J hIJ) := by
  obtain ⟨ν, c, hc, hDdeg, hDcomp, hνdisj⟩ := D_top I J hIJ
  have hmem := multiplier I J hIJ G e hG hv
  obtain ⟨hp1, hp2⟩ := pow_degLE_comp (wt I J r) hDdeg e
  have hdeg := degLE_mul (wt I J r) hp1 hd
  have hl := lift (wt I J r) (gen (r := r) I J) (mu I J hIJ) (mu_disj I J hIJ)
    (gen_top I J hIJ) _ hmem _ hdeg
  rw [comp_mul (wt I J r) hp1 hd, hp2, hDcomp, monomial_pow] at hl
  refine colon (mu I J hIJ) (e • ν) (fun l => ?_) (c ^ e) (pow_ne_zero _ hc) _ hl
  exact (hνdisj l).mono_left Finsupp.support_smul

lemma star (hIJ : I.card + J.card ≤ r) (F : Poly n r) (hF : Van I J F) (d : ℕ)
    (hd : DegLE (wt I J r) d F) :
    weightedHomogeneousComponent (wt I J r) d F ∈ monIdeal (mu I J hIJ) := by
  obtain ⟨N, hN⟩ := sum_comp_range (wx I r) F
  rw [hN, map_sum]
  refine Ideal.sum_mem _ fun e _ => ?_
  exact step I J hIJ _ e d (weightedHomogeneousComponent_isWeightedHomogeneous _ _)
    (van_comp I J F hF e) (degLE_comp _ _ hd)

lemma gen_piece (hIJ : I.card + J.card ≤ r) (d : ℕ) (c : Poly n r) (l : Idx I J)
    (hc : IsWeightedHomogeneous (wt I J r) c (d - Finsupp.weight (wt I J r) (mu I J hIJ l)))
    (hc0 : c ≠ 0 → Finsupp.weight (wt I J r) (mu I J hIJ l) ≤ d) :
    DegLE (wt I J r) d (c * gen I J l) ∧
      weightedHomogeneousComponent (wt I J r) d (c * gen I J l) = c * monomial (mu I J hIJ l) 1 := by
  by_cases h0 : c = 0
  · subst h0; simp [degLE_zero']
  have hle := hc0 h0
  have ht := gen_top I J hIJ l
  have h1 := degLE_mul (wt I J r) (degLE_of_homog hc) (topTerm_degLE ht)
  have h2 := comp_mul (wt I J r) (degLE_of_homog hc) (topTerm_degLE ht)
  rw [Nat.sub_add_cancel hle] at h1 h2
  rw [h2, weightedHomogeneousComponent_eq_self hc, topTerm_comp ht]
  exact ⟨h1, rfl⟩

lemma main_aux (hIJ : I.card + J.card ≤ r) : ∀ d : ℕ, ∀ F : Poly n r, Van I J F →
    (∀ s ∈ F.support, Finsupp.weight (wt I J r) s < d) →
    F ∈ Ideal.span (Set.range (gen (r := r) I J))
  | 0 => by
    intro F _ hs
    have : F = 0 := by
      by_contra h
      obtain ⟨s, hs'⟩ := support_nonempty.2 h
      exact absurd (hs s hs') (Nat.not_lt_zero _)
    rw [this]; exact Ideal.zero_mem _
  | d + 1 => by
    intro F hF hs
    have hd : DegLE (wt I J r) d F := fun s h => Nat.lt_succ_iff.1 (hs s h)
    have hm := star I J hIJ F hF d hd
    obtain ⟨c, hceq, hch⟩ := homog_decomp (wt I J r) (mu I J hIJ) hm
      (weightedHomogeneousComponent_isWeightedHomogeneous _ _)
    set h := ∑ l, c l * gen I J l with hh
    have hha : h ∈ Ideal.span (Set.range (gen (r := r) I J)) :=
      Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)
    have hdeg : DegLE (wt I J r) d (F - h) :=
      degLE_sub hd (degLE_sum _ _ fun l _ => (gen_piece I J hIJ d (c l) l (hch l).1 (hch l).2).1)
    have hcomp : weightedHomogeneousComponent (wt I J r) d (F - h) = 0 := by
      rw [map_sub, hh, map_sum, hceq]
      rw [sub_eq_zero]
      exact (Finset.sum_congr rfl fun l _ =>
        (gen_piece I J hIJ d (c l) l (hch l).1 (hch l).2).2).symm
    have := main_aux hIJ d (F - h) (van_sub_gen I J F hF c) (lt_of_comp_zero hdeg hcomp)
    have := Ideal.add_mem _ this hha
    rwa [sub_add_cancel] at this

theorem main (hIJ : I.card + J.card ≤ r) (F : Poly n r) (hF : Van I J F) :
    F ∈ Ideal.span (Set.range (gen (r := r) I J)) :=
  main_aux I J hIJ _ F hF fun _ hs =>
    Nat.lt_succ_of_le (Finset.le_sup (f := Finsupp.weight (wt I J r)) hs)

end SoSLinAlg.WeakRank.Dev.Leaf.PartC
end
end

