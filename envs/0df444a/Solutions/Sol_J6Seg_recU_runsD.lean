-- Source module: NLogN.HRM
/-!
# Register programs with multiplication calls

`RM` extends the register programs `RS` by `mul k i j`, which pushes `top j * top i` onto `k`
by calling the multiplication procedure `pM` with the calling convention

  `ARG = 55 : a :: b :: L  ↦  (a * b) :: L`,

all other stacks unchanged.  The cost of a call and the inputs on which it may be used are a
parameter `M : MulSpec`; `RM.code_runs` holds whenever the procedure meets `MulOK M`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RM

open RS (decSt decE asgCost)

/-! ## Frame -/

theorem ne55 {i : Fin HS} (hi : i.val < 55) : i ≠ ARGM := by
  intro h; rw [h] at hi; exact absurd hi (by decide)

theorem mul_runs (M : MulSpec) (pM : Fin P) (pc : ℕ → Fin P) (hM : MulOK I iprog pM M) (k i j : Fin HS)
    (s : IState HS) (h : (mul k i j).ok M s) :
    IRuns I iprog ((mul k i j).code pM pc) s ((mul k i j).run s) ((mul k i j).cost M s) := by
  obtain ⟨hk, hi, hj, ⟨Li, hLi⟩, ⟨Lj, hLj⟩, hd⟩ := h
  have hk' := ne55 hk; have hi' := ne55 hi; have hj' := ne55 hj
  have h1 := IRuns.dup (I := I) (iprog := iprog) (s := s) (i := i) (j := ARGM) hi' hLi
  have h2 := IRuns.dup (I := I) (iprog := iprog) (s := s.upd ARGM (.int (s.top i) :: s.G ARGM))
    (i := j) (j := ARGM) hj' (a := s.top j) (L := Lj) (by simp [IState.upd_G, hj', hLj])
  have h3 := hM ((s.upd ARGM (.int (s.top i) :: s.G ARGM)).upd ARGM
    (.int (s.top j) :: (s.upd ARGM (.int (s.top i) :: s.G ARGM)).G ARGM)) (s.top j) (s.top i)
    (s.G ARGM) hd (by simp [IState.upd_G])
  have h4 := IRuns.mv (I := I) (iprog := iprog)
    (s := ((s.upd ARGM (.int (s.top i) :: s.G ARGM)).upd ARGM
    (.int (s.top j) :: (s.upd ARGM (.int (s.top i) :: s.G ARGM)).G ARGM)).upd ARGM
      (.int (s.top j * s.top i) :: s.G ARGM)) (i := ARGM) (j := k) (a := s.top j * s.top i)
    (L := s.G ARGM) (Ne.symm hk') (by simp [IState.upd_G])
  refine (h1.seq (h2.seq (h3.seq h4))).mono' ?_ ?_
  · simp only [run]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all
  · simp only [cost, mulCost]; omega

