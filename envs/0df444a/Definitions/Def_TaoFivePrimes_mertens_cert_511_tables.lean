def rho1f (m d : Nat) : Rat :=
  (((d : Rat)/(m : Rat)) - (((d : Rat)/(m : Rat))^2)/2) / (lub m)
    - ((d : Rat)/(m : Rat))^2 / (2 * ((((clbZ m : Nat) : Rat)) / 10000)^2)

def rho1 (n : Nat) : Rat := rho1f (lastP n) (n - lastP n)
def rho2f (q c : Nat) : Rat := 12 * (c : Rat) / ((q : Rat) * (lub q)^4)
def rho2 (n : Nat) : Rat := rho2f (firstP n) (firstP n - n - 1)
def rho (n : Nat) : Rat := rho1 n + rho2 n


end TaoFivePrimes


