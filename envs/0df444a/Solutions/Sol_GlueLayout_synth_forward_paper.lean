variable (y : Rˣ)

lemma yp_add (e f : ℤ) : yp y (e + f) = yp y e * yp y f := by
  simp [yp, zpow_add]

@[simp] lemma yp_zero : yp y 0 = 1 := by simp [yp]

lemma yp_sum {ι : Type*} (s : Finset ι) (f : ι → ℤ) :
    yp y (∑ i ∈ s, f i) = ∏ i ∈ s, yp y (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih => rw [sum_insert hi, prod_insert hi, yp_add, ih]

variable {r : ℕ} (hy : y ^ r = -1)
include hy

lemma yp_r_mul (n : ℤ) : yp y (r * n) = ((-1 : Rˣ) ^ n : Rˣ) := by
  unfold yp; rw [zpow_mul]; simp [hy]

lemma yp_two_r_mul (n : ℤ) : yp y (2 * r * n) = 1 := by
  rw [show (2 * r * n : ℤ) = r * (2 * n) by ring, yp_r_mul y hy, zpow_mul]; simp

omit hy

