    (24, 2 ^ (GL.exC q + 1)), (25, 2 ^ (q.p + 1)), (26, (EX.TT q : ℤ)), (27, (q.S : ℤ)),
    (5, (q.p : ℤ)), (6, ((q.α ^ 2 : ℕ) : ℤ)), (7, (sWidth q.p q.α : ℤ)),
    (8, ((2 * sWidth q.p q.α + 1 : ℕ) : ℤ)), (9, (eWidth q.p q.α : ℤ)),
    (10, ((2 * eWidth q.p q.α + 1 : ℕ) : ℤ)), (11, betaT q.p q.α), (12, 2 ^ (2 * q.p)),
