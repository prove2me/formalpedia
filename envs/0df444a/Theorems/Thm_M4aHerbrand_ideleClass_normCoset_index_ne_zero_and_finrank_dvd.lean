open NumberField M4aHerbrand

theorem M4aHerbrand.ideleClass_normCoset_index_ne_zero_and_finrank_dvd
    (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (B : AdeleBaseChange (𝓞 K) K (𝓞 L) L) :
    (principalIdeles (𝓞 K) K ⊔ B.idelicNorm.range).index ≠ 0 ∧
    Module.finrank K L ∣
    (principalIdeles (𝓞 K) K ⊔ B.idelicNorm.range).index := by sorry
