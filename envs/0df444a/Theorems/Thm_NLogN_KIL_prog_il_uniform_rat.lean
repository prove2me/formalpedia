--       ∃ (iprog : Fin 1 → IStmt HS 1) (K Kd S : ℕ),
--         ∀ (q : ℕ), q.Prime → ∀ (b Bb k : ℕ), (∀ j < k, m ^ j ≤ b) →
--         (∀ j < k, FramesOK (fun X => GoodAtQ q ((Qc.den : ℚ)⁻¹ • ratM X) ∧
--           ∀ T, TStep.sh T ∈ edgeTplQ Qc X → TOK T (q ^ m ^ j) Bb)
--           (Qc.toCircuit (q ^ b)).gates (Qc.toCircuit (q ^ b)).Min (Qc.toCircuit (q ^ b)).Mout) →
--         (∀ j < k, SubBnd (q ^ m ^ j) Bb) → zsz (k : ℤ) ≤ Bb →
--         ∀ (P L : ℕ) (A B Cs : Shape), 1 ≤ P → W ^ k ∣ L → 1 ≤ L →
--         (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
--         zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb →
--         ∀ (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
--           DescIn t q m k P L A B Cs →
--           xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
