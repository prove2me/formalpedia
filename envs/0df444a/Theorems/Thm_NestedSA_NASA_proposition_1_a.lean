-- title:
--   Proposition 1(a) — β²E‖d^k‖² ≤ E‖z^k‖² ≤ σ_J²σ_s² along NASA
-- statement:
--   Let $x^k,z^k,u^k$ be generated by Algorithm 1 with constant $\beta>0$, deterministic stepsizes with $\tau_0=1/a$ and $\tau_k\le1$, under Assumption 1, with $f,g$ continuously differentiable and $X$ closed and convex. Write $d^k=\bar y(x^k,z^k,\beta)-x^k$. Then for every $k\ge1$ the variables $\|d^k\|^2$ and $\|z^k\|^2$ are integrable,
--   $$\beta^2\,\mathbb E\big[\|d^k\|^2\,\big|\,\mathcal F_{k-1}\big]\le\mathbb E\big[\|z^k\|^2\,\big|\,\mathcal F_{k-1}\big]\quad\text{almost surely},\qquad \mathbb E\big[\|z^k\|^2\big]\le\sigma_J^2\sigma_s^2.$$
--
--   The averaged gradient estimates $z^k$ thus have second moments bounded by the oracle's, which in turn bounds the algorithm's steps.
--
--   **Formalization Note** The paper prints the second inequality conditionally on $\mathcal F_{k-1}$. In that form it is false ($z^{k-1}$ is $\mathcal F_{k-1}$-measurable and may exceed $\sigma_J\sigma_s$ on an event of positive probability), and the paper's convex-combination argument proves it in expectation, which is how it is stated. The hypothesis $\tau_k\le1$ (keeping $x^k\in X$) is used but not printed.
-- source:
--   Ghadimi, Ruszczyński, Wang, A Single Time-Scale Stochastic Approximation Method for Nested Stochastic Optimization, arXiv:1812.01094v2, p. 12, Proposition 1(a)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_NestedSA_NASA_Basic
import Definitions.Def_NestedSA_NASA_Model

open MeasureTheory ProbabilityTheory

namespace NestedSA.NASA

/-- Proposition 1(a) (p. 12). Let `x, z, u` be generated by Algorithm 1 (constant `β`, deterministic stepsizes
`τ_k ≤ 1`) under Assumption 1, with `f, g` continuously differentiable, and let `τ₀ = 1/a`. Then for every
`k ≥ 1`, with `d^k = ȳ(x^k, z^k, β) − x^k`: `‖d^k‖²` and `‖z^k‖²` are integrable,
`β² E[‖d^k‖² | ℱ_{k−1}] ≤ E[‖z^k‖² | ℱ_{k−1}]` almost surely, and `E[‖z^k‖²] ≤ σ_J² σ_s²`.
The paper prints the second inequality conditionally on `ℱ_{k−1}`; its proof establishes it in expectation. -/
theorem proposition_1_a {n m : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ)
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX_cl : IsClosed X) (hX_cvx : Convex ℝ X)
    (P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hP : SpectralProjGrad.Shared.IsProjOnto X P)
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (hf : ContDiff ℝ 1 f) (hg : ContDiff ℝ 1 g)
    (a b β : ℝ) (τ : ℕ → ℝ) (x0 z0 : EuclideanSpace ℝ (Fin n)) (u0 : EuclideanSpace ℝ (Fin m))
    (x z : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (u G s : ℕ → Ω → EuclideanSpace ℝ (Fin m))
    (J : ℕ → Ω → (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)))
    (hrun : IsStochRun X P a b β τ x0 z0 u0 x z u G s J)
    (σG σJ σs : ℝ) (hA1 : Assumption1 μ ℱ f g x z u G s J σG σJ σs)
    (hτ_one : ∀ k, τ k ≤ 1) (hτ0 : τ 0 = 1 / a) :
    ∀ k : ℕ, 1 ≤ k →
      Integrable (fun ω => ‖ybar P (x k ω) (z k ω) β - x k ω‖ ^ 2) μ ∧
      Integrable (fun ω => ‖z k ω‖ ^ 2) μ ∧
      μ[fun ω => β ^ 2 * ‖ybar P (x k ω) (z k ω) β - x k ω‖ ^ 2 | ℱ (k - 1)]
        ≤ᵐ[μ] μ[fun ω => ‖z k ω‖ ^ 2 | ℱ (k - 1)] ∧
      ∫ ω, ‖z k ω‖ ^ 2 ∂μ ≤ σJ ^ 2 * σs ^ 2 := by sorry

end NestedSA.NASA
