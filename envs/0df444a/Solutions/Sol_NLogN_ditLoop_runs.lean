    IRuns I iprog ditStep s
      (((((((s.upd NLogN.V RV).upd DX RX).upd NLogN.P1
        (.int ((t + -((b * 2 ^ (e + E)) % (2 ^ n + 1))) % (2 ^ n + 1)) :: s.G NLogN.P1)).upd P2
        (.int ((t + (b * 2 ^ (e + E)) % (2 ^ n + 1)) % (2 ^ n + 1)) :: s.G P2)).upd W
          (.int (2 ^ e) :: LW)).upd CC (.int (c + -1) :: LC)))
      (150000 * (n + 3)) := by
  have hp : (0 : ℤ) < 2 ^ n := by positivity
  have hp2 : (2 : ℤ) ^ (2 * n + 1) = 2 * 2 ^ n * 2 ^ n := by ring
  have hpn : (2 : ℤ) ≤ 2 ^ n := by
    calc (2 : ℤ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) hn
  have bt : zsz t ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  have bb : zsz b ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  set x := (b * 2 ^ (e + E)) % (2 ^ n + 1) with hxdef
  have hx0 : 0 ≤ x := Int.emod_nonneg _ (by omega)
  have hx1 : x < 2 ^ n + 1 := Int.emod_lt_of_pos _ (by omega)
  have bx : zsz x ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  have heE : zsz ((2 : ℤ) ^ (e + E)) ≤ n + 1 := by rw [NLogN.zsz_two_pow]; omega
  -- piece 1
  have h1 : IRuns I iprog (.seq (.op (.mv DX T4)) (.op (.shl T4 W))) s
      ((s.upd DX RX).upd T4 (.int (b * 2 ^ (e + E)) :: s.G T4)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hX, hW]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s1 := (s.upd DX RX).upd T4 (.int (b * 2 ^ (e + E)) :: s.G T4) with hs1
  have h2 := fred_runs (I := I) (iprog := iprog) (X := T4) (by decide) (by decide) (by decide)
    (by decide) s1 (b * 2 ^ (e + E)) n (s.G T4) LN LF (by simp [s1])
    (by simp +decide [s1, hN]) (by simp +decide [s1, hF])
    (by
      have hev : (2 : ℤ) ^ (e + E) ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) he
      have he0 : (0 : ℤ) < 2 ^ (e + E) := by positivity
      have : |b * 2 ^ (e + E)| < 2 ^ (2 * n + 1) := by
        rw [abs_mul, abs_of_pos he0, hp2, abs_of_nonneg hb.1]
        nlinarith
      have : (((b * 2 ^ (e + E)).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by
        push_cast; exact this
      exact_mod_cast this)
  set s2 := s1.upd T4 (.int x :: s.G T4) with hs2
  -- piece 3
  have h3 : IRuns I iprog (.seq (.op (.dup T4 NLogN.P1)) (.seq (.op (.neg NLogN.P1)) (.seq (.op (.dup NLogN.V NLogN.T3))
      (.op (.add NLogN.T3 NLogN.P1 NLogN.P1))))) s2 (s2.upd NLogN.P1 (.int (t + -x) :: s.G NLogN.P1)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s2, s1, hV, zsz_neg]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s3 := s2.upd NLogN.P1 (.int (t + -x) :: s.G NLogN.P1) with hs3
  have h4 := fred_runs (I := I) (iprog := iprog) (X := NLogN.P1) (by decide) (by decide) (by decide)
    (by decide) s3 (t + -x) n (s.G NLogN.P1) LN LF (by simp [s3])
    (by simp +decide [s3, s2, s1, hN]) (by simp +decide [s3, s2, s1, hF])
    (by
      have : |t + -x| < 2 ^ (2 * n + 1) := by rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((t + -x).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s4 := s3.upd NLogN.P1 (.int ((t + -x) % (2 ^ n + 1)) :: s.G NLogN.P1) with hs4
  -- piece 5
  have h5 : IRuns I iprog (.seq (.op (.mv T4 P2)) (.seq (.op (.mv NLogN.V NLogN.T3)) (.op (.add NLogN.T3 P2 P2)))) s4
      (((s4.upd T4 (s.G T4)).upd NLogN.V RV).upd P2 (.int (t + x) :: s.G P2)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s4, s3, s2, s1, hV]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s5 := ((s4.upd T4 (s.G T4)).upd NLogN.V RV).upd P2 (.int (t + x) :: s.G P2) with hs5
  have h6 := fred_runs (I := I) (iprog := iprog) (X := P2) (by decide) (by decide) (by decide)
    (by decide) s5 (t + x) n (s.G P2) LN LF (by simp [s5])
    (by simp +decide [s5, s4, s3, s2, s1, hN]) (by simp +decide [s5, s4, s3, s2, s1, hF])
    (by
      have : |t + x| < 2 ^ (2 * n + 1) := by rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((t + x).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s6 := s5.upd P2 (.int ((t + x) % (2 ^ n + 1)) :: s.G P2) with hs6
  -- piece 7
  have h7g : ∀ s' : IState NS, s'.G W = .int (2 ^ (e + E)) :: LW → s'.G NLogN.DE = .int (2 ^ E) :: LE →
      s'.G CC = .int c :: LC →
      IRuns I iprog (.seq (.op (.split W NLogN.DE NLogN.T3)) (.seq (.op (.drop NLogN.T3)) (decC CC))) s'
        ((s'.upd W (.int (2 ^ e) :: LW)).upd CC (.int (c + -1) :: LC)) (2000 * (n + 3)) := by
    intro s' hW' hE' hC'
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, hW', hE', hC', zsz_neg_one,
      two_pow_add_div', two_pow_add_mod', zsz_zero]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  have h7 := h7g s6 (by simp +decide [s6, s5, s4, s3, s2, s1, hW])
    (by simp +decide [s6, s5, s4, s3, s2, s1, hE]) (by simp +decide [s6, s5, s4, s3, s2, s1, hC])
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq h5
    (IRuns.seq h6 h7)))))).mono' ?_ (by omega)
  simp only [hs6, hs5, hs4, hs3, hs2, hs1]
  clear * - hV hX
  ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (s : NLogN.IState NLogN.NS) (n E : ℕ) (lo hi : List ℤ)
    (RV RX LW LC LE LN LF : List NLogN.Item) (hn : 1 ≤ n) (hlen : lo.length = hi.length)
    (hE : lo.length * E = n) (hcz : NLogN.zsz (lo.length : ℤ) ≤ n)
    (hlo : NLogN.Canon (2 ^ n + 1) lo) (hhi : NLogN.Canon (2 ^ n + 1) hi)
    (hV : s.G NLogN.V = NLogN.ints lo ++ RV) (hX : s.G NLogN.DX = NLogN.ints hi ++ RX) (hW : s.G NLogN.W = .int (2 ^ n) :: LW)
    (hC : s.G NLogN.CC = .int lo.length :: LC) (hDE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G NLogN.RN = .int (2 ^ n) :: LN) (hF : s.G NLogN.RF = .int (2 ^ n + 1) :: LF) :
    NLogN.IRuns I iprog (.loop NLogN.CC (fun c => c != .zero) NLogN.ditStep) s
      (((((((s.upd NLogN.V RV).upd NLogN.DX RX).upd NLogN.P1
        ((NLogN.ints (NLogN.dcomX (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G NLogN.P1)).upd NLogN.P2
        ((NLogN.ints (NLogN.dcomY (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G NLogN.P2)).upd NLogN.W
          (.int 1 :: LW)).upd NLogN.CC (.int 0 :: LC)))
      (lo.length * (150000 * (n + 3) + 30) + 30) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set L0 := lo.zip hi with hL0
  have hm1 : L0.map Prod.fst = lo := by simp [L0, List.map_fst_zip, hlen]
  have hm2 : L0.map Prod.snd = hi := by simp [L0, List.map_snd_zip, hlen]
  have hl0 : L0.length = lo.length := by simp [L0, hlen]
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → NLogN.IState NS := fun D R =>
    ((((((s.upd NLogN.V (NLogN.ints (R.map Prod.fst) ++ RV)).upd NLogN.DX (NLogN.ints (R.map Prod.snd) ++ RX)).upd NLogN.P1
      ((NLogN.ints (NLogN.dcomX F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G NLogN.P1)).upd NLogN.P2
      ((NLogN.ints (NLogN.dcomY F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G NLogN.P2)).upd NLogN.W
        (.int (2 ^ (n - D.length * E)) :: LW)).upd NLogN.CC (.int (R.length : ℤ) :: LC))
  have h0 : St [] L0 = s := by
    apply NLogN.IState.ext' <;> intros <;> simp [St, hm1, hm2, hV, hX, hW, hC, hl0, NLogN.dcomX, NLogN.dcomY] <;>
      split_ifs <;> simp_all
  have hk : St L0 [] = (((((((s.upd NLogN.V RV).upd NLogN.DX RX).upd NLogN.P1
        ((NLogN.ints (NLogN.dcomX F n E 0 lo hi)).reverse ++ s.G NLogN.P1)).upd NLogN.P2
        ((NLogN.ints (NLogN.dcomY F n E 0 lo hi)).reverse ++ s.G NLogN.P2)).upd NLogN.W
          (.int 1 :: LW)).upd NLogN.CC (.int 0 :: LC))) := by
    simp [St, hm1, hm2, hl0, hE]
  have := NLogN.IRuns.loopList (I := I) (iprog := iprog) (i := NLogN.CC) (f := fun c => c != .zero)
    (p := NLogN.ditStep) L0 St (150000 * (n + 3))
    (by intro D x R _; simp [St]; omega)
    (by simp [St])
    (by
      intro D x R hD
      have hmem : x ∈ L0 := by rw [← hD]; simp
      have hx1 : x.1 ∈ lo := by rw [← hm1]; exact List.mem_map_of_mem hmem
      have hx2 : x.2 ∈ hi := by rw [← hm2]; exact List.mem_map_of_mem hmem
      have hlD : D.length + 1 + R.length = lo.length := by
        rw [← hl0, ← hD]; simp; omega
      have hc : NLogN.zsz ((R.length + 1 : ℕ) : ℤ) ≤ n := le_trans (NLogN.zsz_natCast_le (by omega)) hcz
      have hDE1 : (D.length + 1) * E ≤ n := by rw [← hE]; exact Nat.mul_le_mul_right _ (by omega)
      have e7 : n - D.length * E = (n - (D.length + 1) * E) + E := by
        have : (D.length + 1) * E = D.length * E + E := by ring
        omega
      have hst := NLogN.ditStep_runs (I := I) (iprog := iprog) (St D (x :: R)) n
        (n - (D.length + 1) * E) E x.1 x.2 ((R.length + 1 : ℕ) : ℤ) (NLogN.ints (R.map Prod.fst) ++ RV)
        (NLogN.ints (R.map Prod.snd) ++ RX) LW LC LE LN LF hn (by omega) (hlo _ hx1) (hhi _ hx2) hc
        (by simp +decide [St]) (by simp +decide [St]) (by simp +decide [St, e7])
        (by simp +decide [St]) (by simp +decide [St, hDE]) (by simp +decide [St, hN])
        (by simp +decide [St, hF, hFdef])
      refine hst.mono' ?_ le_rfl
      have e4 := NLogN.dcomX_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      have e5 := NLogN.dcomY_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      simp only [List.length_map, zero_add] at e4 e5
      rw [e7] at e4 e5
      simp only [St, List.map_append, List.map_cons, List.map_nil, e4, e5, List.length_append,
        List.length_singleton]
      apply NLogN.IState.ext' <;> intros <;> simp [NLogN.ints_append] <;> split_ifs <;> simp_all)
  rw [h0, hk, hl0] at this
  exact this
end
