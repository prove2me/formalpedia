theorem subsingleton_of_framed (g N n : ℕ) (hP : ¬ ∃ (K : Type) (_ : Field K) (I : Ideal (MvPolynomial (Fin (N + 1)) K)),
      (∀ p ∈ I, ∀ d : ℕ, homogeneousComponent d p ∈ I) ∧
      ∃ d₁ : ℕ, ∀ d : ℕ, d₁ ≤ d → (Module.finrank K (piece I d) : ℚ) =
        (Polynomial.C ((N : ℚ) + 1) * Polynomial.X ^ g).eval (d : ℚ))
    (R : Type) [CommRing R] (X : FramedPolarisedAbelianScheme g N n R) : Subsingleton R := by
  by_contra hR
  haveI : Nontrivial R := not_subsingleton_iff_nontrivial.mp hR
  exact (AlgebraicGeometry.FramedPolarisedAbelianScheme.isEmpty_of_not_exists_hilbertPolynomial g N n hP R).false X

theorem holeE (g N n : ℕ) (B : Type) [CommRing B] (hP : ¬ ∃ (K : Type) (_ : Field K) (I : Ideal (MvPolynomial (Fin (N + 1)) K)),
      (∀ p ∈ I, ∀ d : ℕ, homogeneousComponent d p ∈ I) ∧
      ∃ d₁ : ℕ, ∀ d : ℕ, d₁ ≤ d → (Module.finrank K (piece I d) : ℚ) =
        (Polynomial.C ((N : ℚ) + 1) * Polynomial.X ^ g).eval (d : ℚ)) :
    ∃ (H : Scheme.{0}) (M : ℕ)
      (j : H ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B))
      (_ : IsImmersion j) (_ : LocallyOfFiniteType j) (_ : QuasiCompact j)
      (pt : ∀ (R : Type) [CommRing R] [Algebra B R],
        FramedPolarisedAbelianScheme g N n R →
          {h : Spec (CommRingCat.of R) ⟶ H // h ≫ j ≫ ProjSpace.π B M = Spec.map (CommRingCat.ofHom (algebraMap B R))}),
      (∀ (R : Type) [CommRing R] [Algebra B R] (h : Spec (CommRingCat.of R) ⟶ H)
          (_ : h ≫ j ≫ ProjSpace.π B M = Spec.map (CommRingCat.ofHom (algebraMap B R))),
          ∃ X : FramedPolarisedAbelianScheme g N n R, (pt R X).1 = h) ∧
      (∀ (R : Type) [CommRing R] [Algebra B R] (X X' : FramedPolarisedAbelianScheme g N n R),
          (pt R X).1 = (pt R X').1 ↔
            ∃ (e₀ : X.A ≅ X'.A), e₀.hom ≫ X'.f = X.f ∧ e₀.hom ≫ X'.frame.toProj = X.frame.toProj ∧
              (X.L.one (𝟙 (Spec (CommRingCat.of R)))).1 ≫ X.frame.toProj =
                (X'.L.one (𝟙 (Spec (CommRingCat.of R)))).1 ≫ X'.frame.toProj ∧
              ∀ i, (X.P i).1 ≫ X.frame.toProj = (X'.P i).1 ≫ X'.frame.toProj) ∧
      (∀ (R R' : Type) [CommRing R] [CommRing R'] [Algebra B R] [Algebra B R'] (φ : R →ₐ[B] R')
          (X : FramedPolarisedAbelianScheme g N n R) (X' : FramedPolarisedAbelianScheme g N n R'),
          FramedPolarisedAbelianScheme.IsPullback φ.toRingHom X X' →
            (pt R' X').1 = Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (pt R X).1) := by
  classical

  refine ⟨∅, 0, Scheme.emptyTo _, inferInstance, inferInstance, inferInstance, fun R _ _ X => ?pt, ?surj, ?inj, ?nat⟩
  ·
    haveI : Subsingleton R := subsingleton_of_framed g N n hP R X
    haveI : IsEmpty ↥(Spec (CommRingCat.of R)) := inferInstanceAs (IsEmpty (PrimeSpectrum R))
    exact ⟨(isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).to _, (isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).hom_ext _ _⟩
  · intro R _ _ h _
    haveI : IsEmpty ↥(Spec (CommRingCat.of R)) := Function.isEmpty h.base
    haveI : Subsingleton R := by
      by_contra hR
      haveI : Nontrivial R := not_subsingleton_iff_nontrivial.mp hR
      exact (‹IsEmpty ↥(Spec (CommRingCat.of R))›).false (Nonempty.some (inferInstance : Nonempty (PrimeSpectrum R)))
    obtain ⟨X⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.nonempty_of_subsingleton g N n R
    exact ⟨X, (isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).hom_ext _ _⟩
  · intro R _ _ X X'
    haveI : Subsingleton R := subsingleton_of_framed g N n hP R X
    haveI hE : IsEmpty ↥(Spec (CommRingCat.of R)) := inferInstanceAs (IsEmpty (PrimeSpectrum R))
    haveI hA : IsEmpty ↥X.A := Function.isEmpty X.f.base
    haveI hA' : IsEmpty ↥X'.A := Function.isEmpty X'.f.base
    refine iff_of_true ((isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).hom_ext _ _) ?_
    let e₀ : X.A ≅ X'.A :=
      { hom := (isInitialOfIsEmpty (X := X.A)).to _
        inv := (isInitialOfIsEmpty (X := X'.A)).to _
        hom_inv_id := (isInitialOfIsEmpty (X := X.A)).hom_ext _ _
        inv_hom_id := (isInitialOfIsEmpty (X := X'.A)).hom_ext _ _ }
    refine ⟨e₀, (isInitialOfIsEmpty (X := X.A)).hom_ext _ _, (isInitialOfIsEmpty (X := X.A)).hom_ext _ _,
      (isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).hom_ext _ _, fun i => ?_⟩
    exact (isInitialOfIsEmpty (X := Spec (CommRingCat.of R))).hom_ext _ _
  · intro R R' _ _ _ _ φ X X' _
    haveI : Subsingleton R' := subsingleton_of_framed g N n hP R' X'
    haveI : IsEmpty ↥(Spec (CommRingCat.of R')) := inferInstanceAs (IsEmpty (PrimeSpectrum R'))
    exact (isInitialOfIsEmpty (X := Spec (CommRingCat.of R'))).hom_ext _ _

