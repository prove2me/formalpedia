theorem injective_algebraMap_of_maximalIdeal_eq_span
    (A₀ A : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] [CommRing A] [IsDomain A] [CharZero A]
    [Algebra A₀ A] (q : ℕ) [Fact q.Prime] (h : IsLocalRing.maximalIdeal A₀ = Ideal.span {(q : A₀)}) :
    Function.Injective (algebraMap A₀ A) := by
  rw [RingHom.injective_iff_ker_eq_bot]
  by_contra hne
  have hprime : (RingHom.ker (algebraMap A₀ A)).IsPrime := RingHom.ker_isPrime _
  have hmax : (RingHom.ker (algebraMap A₀ A)).IsMaximal := Ring.DimensionLEOne.maximalOfPrime hne hprime
  have heq : RingHom.ker (algebraMap A₀ A) = IsLocalRing.maximalIdeal A₀ := IsLocalRing.eq_maximalIdeal hmax
  have hq : (q : A₀) ∈ RingHom.ker (algebraMap A₀ A) := by
    rw [heq, h]; exact Ideal.mem_span_singleton_self _
  rw [RingHom.mem_ker, map_natCast] at hq
  exact (NeZero.ne (q : A)) hq

