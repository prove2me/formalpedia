open Variance
open Finset Eight.SecNetworks
namespace Variance
theorem _root_.solution {g : ℕ} {X : Type} [AddCommMonoid X] (F : Fin g × Fin g → X) : ∑ p ∈ ordered g, F p = ∑ a, ∑ b ∈ univ.erase a, F (a, b) := by
  unfold ordered
  rw [sum_filter, Fintype.sum_prod_type]
  refine sum_congr rfl fun a _ => ?_
  rw [← filter_ne' univ a, sum_filter]
  refine sum_congr rfl fun b _ => ?_
  by_cases h : a = b
  · simp [h]
  · simp [h, Ne.symm h]
end Variance
