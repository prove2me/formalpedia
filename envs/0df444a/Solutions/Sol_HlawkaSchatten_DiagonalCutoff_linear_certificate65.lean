theorem linear_identity (x : ℝ) : x*cutoff65Nlo x-(23/50)*cutoff65Dup x = linearBernstein x := by
  dsimp [cutoff65Nlo, cutoff65Dup, cutoff65Glo, linearBernstein]
  ring

theorem linear_certificate {x : ℝ} (hlo : 1/66 ≤ x) (hhi : x ≤ 1/65) :
    0 < x*cutoff65Nlo x-(23/50)*cutoff65Dup x := by
  rw [linear_identity]
  unfold linearBernstein
  by_cases ht : x < 1/65
  · have hl : 0 ≤ x-1/66 := by linarith
    have hr : 0 < 1/65-x := by linarith
    positivity
  · have he : x = 1/65 := by linarith
    rw [he]
    norm_num


theorem solution (x : ℝ) (hlo : 1 / 66 ≤ x) (hhi : x ≤ 1 / 65) :
    0 < x * cutoff65Nlo x - (23 / 50) * cutoff65Dup x :=
  linear_certificate hlo hhi
