  rw [Finset.prod_congr rfl fun i _ => hi i, Finset.prod_mul_distrib, zpow_sum_eq_prod_zpow _ hz]

private theorem prod_stdRootNumberAt_mul_eq_finprod_primeFibre (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (ν : Fin 3 → (v.adicCompletion ℚ)ˣ →* ℂˣ) (a : Fin 3 → ℕ)
    (hν : ∀ i, HasConductorExponentAt ℚ v (ν i) (a i))
    (hνu : ∀ i, ‖((ν i (uniformizerUnit ℚ v) : ℂˣ) : ℂ)‖ = 1)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχ : IsUnramifiedCharAt χ v)
    (hχ0 : HasConductorExponentAt ℚ v (localChar χ v) 0)
    (hχu : ‖(localChar χ v (uniformizerUnit ℚ v) : ℂ)‖ = 1)
