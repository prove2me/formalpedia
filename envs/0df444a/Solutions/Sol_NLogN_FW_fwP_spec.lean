theorem DescOK.bounds {n kb W N : ℕ} {d : Desc} (h : DescOK n kb W N d) :
    zsz (d.1 : ℤ) ≤ W ∧ zsz (d.2.2.2 : ℤ) ≤ W ∧ zsz ((2 ^ d.2.1 * d.2.2.2 : ℕ) : ℤ) ≤ W ∧
      zsz (kb : ℤ) ≤ W ∧ zsz (N : ℤ) ≤ W ∧ 2 ^ d.2.1 * d.2.2.2 ≤ 2 ^ kb ∧
      ∀ x ∈ enc8 d, zsz x ≤ W := by
