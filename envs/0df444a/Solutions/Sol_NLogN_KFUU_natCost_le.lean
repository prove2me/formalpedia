theorem pow4_le (x : ℕ) : x ^ 4 ≤ 32 * 2 ^ x := by
  induction x with
  | zero => norm_num
  | succ n ih =>
    by_cases hn : n < 9
    · interval_cases n <;> norm_num
    · push_neg at hn
      have h1 : (n + 1) ^ 4 ≤ 2 * n ^ 4 := by
        have : 9 * n ^ 3 ≤ n ^ 4 := by
          have := Nat.mul_le_mul_right (n ^ 3) hn; nlinarith [this]
        nlinarith [Nat.zero_le n, sq_nonneg n]
      calc (n + 1) ^ 4 ≤ 2 * n ^ 4 := h1
        _ ≤ 2 * (32 * 2 ^ n) := by omega
        _ = 32 * 2 ^ (n + 1) := by ring

theorem zsz_le_size' (n : ℕ) : zsz (n : ℤ) ≤ Nat.size n :=
  zsz_le_of_lt (by simpa using Nat.lt_size_self n)

theorem two_pow_size_le {M : ℕ} (hM : 1 ≤ M) : 2 ^ Nat.size M ≤ 2 * M := by
  have h1 : 0 < Nat.size M := Nat.size_pos.2 (by omega)
  have h2 : 2 ^ (Nat.size M - 1) ≤ M := Nat.lt_size.1 (by omega)
  have h3 : 2 ^ Nat.size M = 2 * 2 ^ (Nat.size M - 1) := by
    rw [← pow_succ']; congr 1; omega
  omega

theorem two_pow_zsz_le2 {M : ℕ} (hM : 1 ≤ M) : 2 ^ zsz (M : ℤ) ≤ 2 * M :=
  le_trans (Nat.pow_le_pow_right (by norm_num) (zsz_le_size' M)) (two_pow_size_le hM)

theorem fmB_le (n : ℕ) : KFM.fmB n ≤ 1280 * NLogN.KFUU.K0 * (n + 1) ^ 2 := by
  set M := n + 1 with hM
  set z := zsz ((M : ℕ) : ℤ) with hz
  have h4 : zsz (((z + 2) ^ 4 : ℕ) : ℤ) ≤ 4 * (z + 2) := by
    apply zsz_le_of_lt
    have : z + 2 < 2 ^ (z + 2) := Nat.lt_two_pow_self
    have := Nat.pow_lt_pow_left this (show 4 ≠ 0 by norm_num)
    rw [Int.natAbs_natCast, show 4 * (z + 2) = (z + 2) * 4 by ring, pow_mul]; exact this
  have h2 : (z + 2) ^ 4 ≤ 128 * 2 ^ z := by
    have := pow4_le (z + 2); rw [pow_add] at this; omega
  have h3 : 2 ^ z ≤ 2 * M := two_pow_zsz_le2 (by omega)
  have h5 : (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ 1280 * M := by
    have a : (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ (z + 2) * (4 * (z + 2) + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    have b : (z + 2) ^ 2 ≤ (z + 2) ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    nlinarith
