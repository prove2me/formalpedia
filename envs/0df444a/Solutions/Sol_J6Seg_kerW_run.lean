  induction y with
  | nil => rfl
  | cons a y ih => simp only [gflat, List.flatMap_cons, List.length_append] at ih ⊢; simp [ih]; ring

end J6Seg

end

section
-- Source module: Solutions.J6SegILKer4
/-!
# B-line IL, B2: the kernel-pass wrapper `kerW` (`kerPass` on stack `0`)

`kerW ρ dT dF eF eB e`:

1. push `descFine w f A post` on `dF` (by `dup` from `ρ 0, 2, 3, 4`), call `eF`, drop it:
   stack `0` becomes the exposure `X = blkT (2^f) post A L` (`A = pre·nc`);
2. `iLoop`: for `i < pre`, `q < nc`: load table `q` on `dT`, run the kernel `e` on the `post`
   rows of block `i·nc + q` (each output moved onto `Acc = ρ 17`), unload; restore the store;
3. move `Acc` back onto stack `0` (`ρ 8 = 2·A·post·2^f` integers);
4. push `descFine w' f A post`, call `eB`, drop it.

**`kerW_run`**: on the managed state `F` (registers as in `J6SegILKer1`, `F dT = []`) with
`F 0 = gflat L ++ l`, `LRep A (2^f) post L φ` and the kernel hypotheses on the rows `φ b c`,
the wrapper leaves `gflat (kerPass (2^f) post A (fun b => g (b % nc)) L) ++ l` on stack `0` and
everything else unchanged, at cost
`C₀ · cFine w f A post + C₀ · cFine w' f A post + kerC …` (`kerC`: the rows at `⌊Ck⌋₊ +
O((B+2)·2^f)` each, the table moves `O((B+2)·Lmax)` per block, `O((B+2)·|tabs|)` per `i`,
`O((B+2)·N)` for the final move).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

section desc
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
  {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} (hR : RegOK ρ dT dF)
include hR

theorem desc_push (s : IState HS) (G : Fin HS → List ℤ) (rw : Fin 19) (w f a y B : ℕ)
    (hw : G (ρ rw) = [(w : ℤ)]) (hf : G (ρ 2) = [(f : ℤ)]) (ha : G (ρ 3) = [(a : ℤ)])
    (hy : G (ρ 4) = [(y : ℤ)]) (hwB : zsz (w : ℤ) ≤ B) (hfB : zsz (f : ℤ) ≤ B)
    (haB : zsz (a : ℤ) ≤ B) (hyB : zsz (y : ℤ) ≤ B) :
    IRuns I iprog (descI ρ dF (ρ rw)) (encK s G)
      (encK s (update G dF (descFine w f a y ++ G dF))) (1200 * (B + 1)) := by
  have d1 := IRuns.dupK (I := I) (iprog := iprog) s (G := G) (hR.neF 4) (a := (y : ℤ)) (l := [])
    hy
  have d2 := IRuns.dupK (I := I) (iprog := iprog) s (G := update G dF ((y : ℤ) :: G dF))
    (hR.neF 3) (a := (a : ℤ)) (l := []) (by rw [update_of_ne (hR.neF 3), ha])
  simp only [update_self, update_idem] at d2
  have d3 := IRuns.dupK (I := I) (iprog := iprog) s
    (G := update G dF ((a : ℤ) :: (y : ℤ) :: G dF)) (hR.neF 2) (a := (f : ℤ)) (l := [])
    (by rw [update_of_ne (hR.neF 2), hf])
  simp only [update_self, update_idem] at d3
  have d4 := IRuns.dupK (I := I) (iprog := iprog) s
    (G := update G dF ((f : ℤ) :: (a : ℤ) :: (y : ℤ) :: G dF)) (hR.neF rw) (a := (w : ℤ))
    (l := []) (by rw [update_of_ne (hR.neF rw), hw])
  simp only [update_self, update_idem] at d4
  have c1 := dupCost_le (zsz (y : ℤ))
  have c2 := dupCost_le (zsz (a : ℤ))
  have c3 := dupCost_le (zsz (f : ℤ))
  have c4 := dupCost_le (zsz (w : ℤ))
  refine (d1.seq (d2.seq (d3.seq d4))).mono' (by simp [descFine]) ?_
  omega

theorem desc_pop (s : IState HS) (K : Fin HS → List ℤ) (w f a y B : ℕ) (R : List ℤ)
    (hK : K dF = descFine w f a y ++ R) (hwB : zsz (w : ℤ) ≤ B) (hfB : zsz (f : ℤ) ≤ B)
    (haB : zsz (a : ℤ) ≤ B) (hyB : zsz (y : ℤ) ≤ B) :
    IRuns I iprog (dropI dF) (encK s K) (encK s (update K dF R)) (8 * (B + 1)) := by
  simp only [descFine, List.cons_append, List.nil_append] at hK
  have d1 := IRuns.dropK (I := I) (iprog := iprog) s hK
  have d2 := IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((f : ℤ) :: (a : ℤ) :: (y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d2
  have d3 := IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((a : ℤ) :: (y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d3
  have d4 := IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d4
  refine (d1.seq (d2.seq (d3.seq d4))).mono ?_
  omega

end desc

/-! ## The exposed rows -/

theorem expo_row {α : Type*} [Inhabited α] {A m post : ℕ} {L : List α} {φ : ℕ → ℕ → List α}
    (hL : LRep A m post L φ) {b c : ℕ} (hb : b < A) (hc : c < post) :
    ((blkTg m post A L).drop ((b * post + c) * m)).take m = φ b c := by
  set X := blkTg m post A L with hXdef
  have hXl : X.length = A * post * m := by rw [hXdef, length_blkTg]; ring
  apply ext_getD' (by
    rw [hL.2.1 b hb c hc]; simp only [List.length_take, List.length_drop, hXl]
    have : (b * post + c + 1) * m ≤ A * post * m :=
      Nat.mul_le_mul_right _ (by
        have : (b + 1) * post ≤ A * post := Nat.mul_le_mul_right _ hb
        rw [Nat.succ_mul] at this; omega)
    rw [Nat.succ_mul] at this; omega)
  intro k hk
  have hkm : k < m := by simp only [List.length_take] at hk; omega
  rw [getD_drop_take X _ _ _ hkm, hXdef,
    show (b * post + c) * m + k = b * (post * m) + c * m + k by ring,
    blkTg_getD m post A L hb hc hkm]
  exact hL.2.2 b hb k hkm c hc

theorem gflat_append (a b : List GI) : gflat (a ++ b) = gflat a ++ gflat b := by
  simp [gflat, List.flatMap_append]

theorem bnd_gflat {w B : ℕ} {x : List GI} (h : GB w x) (hw : w ≤ B) : Bnd B (gflat x) := by
  intro v hv
  simp only [gflat, List.mem_flatMap, List.mem_cons, List.mem_nil_iff, or_false] at hv
  obtain ⟨z, hz, rfl | rfl⟩ := hv
  · exact le_trans (h z hz).1 hw
  · exact le_trans (h z hz).2 hw

theorem GB_flatMap {w : ℕ} {ι : Type*} (l : List ι) (F : ι → List GI)
    (h : ∀ i ∈ l, GB w (F i)) : GB w (l.flatMap F) := by
  intro z hz
  obtain ⟨i, hi, hz⟩ := List.mem_flatMap.1 hz
  exact h i hi z hz

end J6Seg

end

section
-- Source module: Solutions.J6SegILKer5
/-!
# B-line IL, B2: **`kerW_run`** (the kernel-pass wrapper computes `kerPass`)

See `J6SegILKer4` for the program and `J6SegILKer1` for the register conventions.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

theorem KS_self (ρ : Fin 19 → Fin HS) (dT : Fin HS) (F : Fin HS → List ℤ) :
    KS ρ dT F (F 0) (F dT) (F (ρ 10)) (F (ρ 15)) (F (ρ 14)) (F (ρ 16)) (F (ρ 17)) (F (ρ 11))
      (F (ρ 12)) (F (ρ 13)) = F := by
  funext j; simp only [KS]; split_ifs <;> subst_vars <;> rfl

theorem upd3 {F : Fin HS → List ℤ} {a b : Fin HS} (hab : a ≠ b) (Q v : List ℤ) :
    update (update (update F a Q) b v) a (F a) = update F b v := by
  funext j
  by_cases h1 : j = a
  · subst h1; simp [hab]
  · simp [update_apply, h1]

/-- **The kernel-pass wrapper.** -/
theorem kerW_run_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eF eB e : Fin Pp}
    {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} {C₀ : ℝ} {tabOf : ℕ → List ℤ}
    {Pre : List GI → Prop} {g : ℕ → List GI → List GI} {Ck : ℝ}
    (hR : RegOK ρ dT dF) (hFine : FineBody6 Isym tbl eF eB dF C₀)
    (hRow : RowBody6 Isym tbl e dT tabOf Pre g Ck)
    (w w' f pre nc post B Lmax : ℕ) (hB : 1 ≤ B) (hpost : 1 ≤ post)
    (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l R0 : List ℤ) (φ : ℕ → ℕ → List GI)
    (hF0 : F 0 = gflat L ++ l) (hFT : F dT = [])
    (h0 : F (ρ 0) = [(w : ℤ)]) (h1 : F (ρ 1) = [(w' : ℤ)]) (h2 : F (ρ 2) = [(f : ℤ)])
    (h3 : F (ρ 3) = [((pre * nc : ℕ) : ℤ)]) (h4 : F (ρ 4) = [(post : ℤ)])
    (h5 : F (ρ 5) = [(pre : ℤ)]) (h6 : F (ρ 6) = [(nc : ℤ)])
    (h7 : F (ρ 7) = [((2 * 2 ^ f : ℕ) : ℤ)])
    (h8 : F (ρ 8) = [((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ)])
    (h9 : F (ρ 9) = [((tabsT tabOf nc).length : ℤ)])
    (h10 : F (ρ 10) = tabsT tabOf nc ++ R0)
    (hscr : ∀ i : Fin 19, 11 ≤ i.val → i.val ≤ 17 → F (ρ i) = [])
    (hzw : zsz (w : ℤ) ≤ B) (hzw' : zsz (w' : ℤ) ≤ B) (hzf : zsz (f : ℤ) ≤ B)
    (hzA : zsz ((pre * nc : ℕ) : ℤ) ≤ B) (hzp : zsz (post : ℤ) ≤ B)
    (hzpre : zsz (pre : ℤ) ≤ B) (hznc : zsz (nc : ℤ) ≤ B)
    (hzm : zsz ((2 * 2 ^ f : ℕ) : ℤ) ≤ B) (hzN : zsz ((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ) ≤ B)
    (hzT : zsz ((tabsT tabOf nc).length : ℤ) ≤ B) (hzL : zsz (Lmax : ℤ) ≤ B) (hw'B : w' ≤ B)
    (hL : LRep (pre * nc) (2 ^ f) post L φ)
    (hPre : ∀ b < pre * nc, ∀ c < post, Pre (φ b c))
    (hg : ∀ q < nc, ∀ x, Pre x → x.length = 2 ^ f → (g q x).length = 2 ^ f ∧ GB w' (g q x))
    (hGB : GB w L)
    (hTB : ∀ q < nc, Bnd B (tabOf q)) (hTL : ∀ q < nc, (tabOf q).length ≤ Lmax) :
    ∃ c : ℕ, IRuns Isym tbl (kerW ρ dT dF eF eB e) (encK s F)
        (encK s (update F 0 (gflat (kerPass (2 ^ f) post (pre * nc) (fun b => g (b % nc)) L) ++ l)))
        c ∧
      (c : ℝ) ≤ C₀ * cFine w f (pre * nc) post + C₀ * cFine w' f (pre * nc) post +
        (kerC ⌊Ck⌋₊ B (2 ^ f) post Lmax nc (tabsT tabOf nc).length pre
          (2 * (pre * nc * post * 2 ^ f)) : ℝ) := by
  set m := 2 ^ f with hmdef
  set A := pre * nc with hAdef
  set N' := pre * nc * post with hN'
  set X := blkTg m post A L with hXdef
  set xr : ℕ → List GI := fun r => (X.drop (r * m)).take m with hxr
  set zA : ℕ → List ℤ := fun r => gflat (X.drop (r * m)) ++ l with hzA'
  set outs : ℕ → List GI := fun r => (List.range r).flatMap (fun r' => g (r' / post % nc) (xr r'))
    with houts
  set aA : ℕ → List ℤ := fun r => (gflat (outs r)).reverse with haA
  have hXl : X.length = N' * m := by rw [hXdef, length_blkTg, hN']; ring
  -- the rows
  have hrow : ∀ r < N', xr r = φ (r / post) (r % post) ∧ r / post < A ∧ r % post < post ∧
      r / post % nc < nc := by
    intro r hr
    have hb : r / post < A := Nat.div_lt_of_lt_mul (by
      rw [show post * A = N' by rw [hN', hAdef]; ring]; exact hr)
    have hc : r % post < post := Nat.mod_lt _ hpost
    have hnc : 0 < nc := by
      rcases Nat.eq_zero_or_pos nc with h | h
      · exfalso
        have : A = 0 := by rw [hAdef, h, Nat.mul_zero]
        rw [this] at hb; exact absurd hb (Nat.not_lt_zero _)
      · exact h
    refine ⟨?_, hb, hc, Nat.mod_lt _ hnc⟩
    have := expo_row hL hb hc
    rw [Nat.div_add_mod' r post] at this
    exact this
  have hrf : ∀ r < N', (g (r / post % nc) (xr r)).length = m ∧ GB w' (g (r / post % nc) (xr r)) ∧
      Pre (xr r) := by
    intro r hr
    obtain ⟨e1, hb, hc, hq⟩ := hrow r hr
    rw [e1]
    exact ⟨(hg _ hq _ (hPre _ hb _ hc) (hL.2.1 _ hb _ hc)).1,
      (hg _ hq _ (hPre _ hb _ hc) (hL.2.1 _ hb _ hc)).2, hPre _ hb _ hc⟩
  have hS : RowStream Pre g B m post nc (pre * nc * post) zA aA xr := by
    intro r hr
    obtain ⟨hl, hgb, hp⟩ := hrf r hr
    refine ⟨?_, hp, hl, bnd_gflat hgb hw'B, ?_⟩
    · simp only [hzA', hxr]
      rw [← List.append_assoc, ← gflat_append, Nat.succ_mul, ← List.drop_drop,
        List.take_append_drop]
    · simp only [haA, houts, List.range_succ, List.flatMap_append, gflat_append,
        List.reverse_append, List.flatMap_cons, List.flatMap_nil, List.append_nil]
  have hlo : ∀ r ≤ N', (outs r).length = r * m := by
    intro r
    induction r with
    | zero => intro _; simp [houts]
    | succ r ih =>
      intro hr
      have := (hrf r (by omega)).1
      simp only [houts, List.range_succ, List.flatMap_append, List.length_append,
        List.flatMap_cons, List.flatMap_nil, List.append_nil] at this ⊢
      rw [show (List.range r).flatMap (fun r' => g (r' / post % nc) (xr r')) = outs r from rfl,
        ih (by omega), this, Nat.succ_mul]
  have hYgb : GB w' (outs N') := GB_flatMap _ _ (fun r hr => (hrf r (List.mem_range.1 hr)).2.1)
  -- the managed state in register form
  have KSF : ∀ z, update F 0 z = KS ρ dT F z [] (tabsT tabOf nc ++ R0) [] [] [] [] [] [] [] := by
    intro z
    rw [show update F 0 z = update (KS ρ dT F (F 0) (F dT) (F (ρ 10)) (F (ρ 15)) (F (ρ 14))
      (F (ρ 16)) (F (ρ 17)) (F (ρ 11)) (F (ρ 12)) (F (ρ 13))) 0 z by rw [KS_self], KS_z hR,
      hFT, h10, hscr 15 (by decide) (by decide), hscr 14 (by decide) (by decide),
      hscr 16 (by decide) (by decide), hscr 17 (by decide) (by decide),
      hscr 11 (by decide) (by decide), hscr 12 (by decide) (by decide),
      hscr 13 (by decide) (by decide)]
  -- 1. the exposure
  have D1 := desc_push (I := Isym) (iprog := tbl) hR s F 0 w f A post B h0 h2 h3 h4 hzw hzf hzA hzp
  obtain ⟨⟨c1, R1, k1⟩, -⟩ := fine_call hFine hR.F0 w f A post s F L l hF0 hpost hL.1 hGB
  have P1 := desc_pop (I := Isym) (iprog := tbl) hR s
    (update (update F dF (descFine w f A post ++ F dF)) 0 (gflat (blkT m post A L) ++ l))
    w f A post B (F dF) (by rw [update_of_ne hR.F0, update_self]) hzw hzf hzA hzp
  rw [upd3 hR.F0] at P1
  -- 2. the loops
  have I1 := iLoop_run hR hRow m post nc pre B Lmax hB s F R0 zA aA xr hS h7 hzm h4 hzp h6 hznc
    h5 hzpre h9 hzT hTB hTL hzL
  have ez0 : zA 0 = gflat X ++ l := by simp [hzA']
  have ea0 : aA 0 = [] := by simp [haA, houts]
  have ezN : zA (pre * nc * post) = l := by
    simp only [hzA']; rw [List.drop_eq_nil_of_le (by rw [hXl])]; rfl
  rw [ez0, ea0, ezN, ← KSF] at I1
  -- 3. the outputs back to stack 0
  have h8' : KS ρ dT F l [] (tabsT tabOf nc ++ R0) [] [] [] (aA N') [] [] [] (ρ 8) =
      [((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ)] := by
    rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 8 (by decide), h8]
  have haN : (aA N').length = 2 * (pre * nc * post * 2 ^ f) := by
    rw [haA, List.length_reverse, gflat_length, hlo N' le_rfl]
  have hbA : Bnd B (aA N') := KIL.bnd_reverse (bnd_gflat hYgb hw'B)
  have S3 := Sp.mvK (hR.ne0 17) (hR.ne (by decide : (17 : Fin 19) ≠ 18)) (Ne.symm (hR.ne0 18))
    (hR.lt 17) (by decide) (hR.lt 18) s
    (KS ρ dT F l [] (tabsT tabOf nc ++ R0) [] [] [] (aA N') [] [] []) (.reg (ρ 8))
    (clean_reg (hR.lt 8)) (ok_reg h8') (aA N') [] (by rw [KS_atAcc hR, List.append_nil])
    (by rw [eval_reg h8', haN]) B hbA trivial (bnd_reg h8' hzN)
  have hmv : ((Ex.reg (S := HS) (ρ 8)).size + 1) * 2000 * (B + 2) +
      (aA N').length * (14000 * (B + 2)) + 32 ≤
      20000 * (B + 2) * (2 * (pre * nc * post * 2 ^ f) + 1) := by
    rw [haN]; simp only [Ex.size]; ring_nf; omega
  replace S3 := S3.mono hmv
  rw [KS_at0 hR, KS_acc hR, KS_z hR, haA, List.reverse_reverse, ← KSF] at S3
  -- 4. the exposure back
  have D2 := desc_push (I := Isym) (iprog := tbl) hR s (update F 0 (gflat (outs N') ++ l)) 1 w' f A
    post B (by rw [update_of_ne (hR.ne0 1), h1]) (by rw [update_of_ne (hR.ne0 2), h2])
    (by rw [update_of_ne (hR.ne0 3), h3]) (by rw [update_of_ne (hR.ne0 4), h4]) hzw' hzf hzA hzp
  obtain ⟨-, ⟨c2, R2, k2⟩⟩ := fine_call hFine hR.F0 w' f A post s
    (update F 0 (gflat (outs N') ++ l)) (outs N') l (update_self _ _ _) hpost
    (by rw [hlo N' le_rfl, hN', hAdef, hmdef]; ring) hYgb
  have P2 := desc_pop (I := Isym) (iprog := tbl) hR s
    (update (update (update F 0 (gflat (outs N') ++ l)) dF
      (descFine w' f A post ++ update F 0 (gflat (outs N') ++ l) dF)) 0
      (gflat (blkT post m A (outs N')) ++ l))
    w' f A post B (update F 0 (gflat (outs N') ++ l) dF)
    (by rw [update_of_ne hR.F0, update_self]) hzw' hzf hzA hzp
  rw [upd3 hR.F0, update_idem] at P2
  -- assemble
  have hfin : blkT post m A (outs N') = kerPass (2 ^ f) post (pre * nc) (fun b => g (b % nc)) L :=
    rfl
  rw [hfin] at P2
  have key : ∀ a b I K : ℕ, 1200 * (B + 1) + (a + (8 * (B + 1) + (I + (K + (1200 * (B + 1) +
      (b + 8 * (B + 1))))))) ≤ a + b + (I + K + 4000 * (B + 1)) := by intros; omega
  refine ⟨_, D1.seq (R1.seq (P1.seq (I1.seq (S3.toIRuns.seq (D2.seq (R2.seq P2)))))), ?_⟩
  refine le_trans (Nat.cast_le.2 (key c1 c2 _ _)) ?_
  unfold kerC
  push_cast
  have e : (N' : ℝ) * (m : ℝ) = (pre : ℝ) * nc * post * 2 ^ f := by
    rw [hN', hmdef]; push_cast; ring
  rw [e]
  linarith

end J6Seg

end

theorem solution : type_of% @J6Seg.kerW_run_sol_aux := @J6Seg.kerW_run_sol_aux
