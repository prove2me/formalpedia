-- title:
--   $\mathcal P(\mathbb R^d)$, $\mathcal P(A)$, paths, measure flows, empirical measures, Assumptions A and B, $\mathbb F$-Brownian motion, completed filtrations, the generator (Section 2, (5.2))
-- statement:
--   This file fixes the spaces and the standing data of Lacker's closed-loop mean field game model.
--
--   Fix a dimension $d$, a horizon $T>0$, and write $\mathbb R^d$ for Euclidean space. For a Polish space $E$, $\mathcal P(E)$ is the set of Borel probability measures on $E$ with the topology of weak convergence and **its Borel $\sigma$-field**. In particular $\mathcal P(\mathbb R^d)$ is the state-measure space and $\mathcal P(A)$ the space of relaxed controls. The **path space** is $\mathcal C^d = C([0,T];\mathbb R^d)$, and the space of **measure flows** is $C([0,T];\mathcal P(\mathbb R^d))$; both carry the topology of uniform convergence and their Borel $\sigma$-fields. For $n\ge1$ points $x_1,\dots,x_n$ the **empirical measure** is
--   $$L_n(x) = \frac1n\sum_{k=1}^n \delta_{x_k}.$$
--   It depends continuously on the points; for a vector of paths $x=(x^1,\dots,x^n)$ the flow $t\mapsto \frac1n\sum_k\delta_{x^k_t}$ is therefore an element of $C([0,T];\mathcal P(\mathbb R^d))$.
--
--   The data of the game are a control set $A$ inside a real normed space, an initial law $\lambda\in\mathcal P(\mathbb R^d)$, and functions
--   $$(b,f):[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)\times A\to\mathbb R^d\times\mathbb R,\qquad g:\mathbb R^d\times\mathcal P(\mathbb R^d)\to\mathbb R.$$
--
--   1. **Assumption A.** $A$ is compact and convex; $b$, $f$, $g$ are bounded and jointly continuous.
--   2. **Assumption B.** For each $(t,x,m)$ the set $K(t,x,m)=\{(b(t,x,m,a),z): a\in A,\ z\le f(t,x,m,a)\}\subset\mathbb R^d\times\mathbb R$ is convex.
--
--   A filtration $\mathbb F=(\mathcal F_t)$ is **complete** if every $\mathbb P$-null set lies in $\mathcal F_0$. A $d$-dimensional process $W$ is a **Brownian motion with respect to** a family of $\sigma$-fields $(\mathcal G_t)$ if it is a standard Brownian motion, $W_t$ is $\mathcal G_t$-measurable, and the increments $(W_r-W_t)_{r\ge t}$ are independent of $\mathcal G_t$; an $\mathbb F$-Brownian motion is the case $\mathcal G=\mathbb F$. For a random variable $\xi$, a Brownian motion $W$ and a random flow $\mu$, the **completed filtration generated by $(\xi,W_s,\mu_s)_{s\le t}$** is $\sigma(\xi, W_s,\mu_s: s\le t)$ augmented by the $\mathbb P$-null sets, and $\mathcal F^\mu_t=\sigma(\mu_s:s\le t)$.
--
--   Finally, $C_c^\infty(\mathbb R^d)$ denotes the smooth compactly supported functions, $\langle m,\varphi\rangle=\int\varphi\,dm$, and the **generator** (5.2) is
--   $$L\varphi(t,x,m,a)=b(t,x,m,a)\cdot\nabla\varphi(x)+\tfrac12\Delta\varphi(x).$$
--
--   These objects are shared by every statement of the mission.
--
--   **Formalization Note** $\mathbb R^d$ is the platform's `EthierKurtz.SDEState d`, and standard Brownian motion is the platform's `EthierKurtz.IsStandardBrownian` (defined for all times $t\ge0$; a Brownian motion on $[0,T]$ extends to $[0,\infty)$ on an enlarged space, and every statement concerns laws only). `Prob X` is a type synonym of Mathlib's `ProbabilityMeasure X` carrying the Borel $\sigma$-field of the weak topology instead of the Giry $\sigma$-field. On maps from the compact interval $[0,T]$ into a metrizable space, the compact-open topology is the topology of uniform convergence for every compatible metric, so it is the paper's sup-metric topology built on (2.1). Coefficients take a real time argument; boundedness and continuity in Assumption A, and convexity in Assumption B, are asked only for $t\in[0,T]$ and $a\in A$, exactly the paper's domain. `ev x s` reads a path or flow at the real time $s$ projected onto $[0,T]$. The null-set augmentation uses the measurable $\mathbb P$-null sets. The empirical measure is defined as the push-forward of the uniform law on $\{1,\dots,n\}$; its continuity is proved in the file.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, pp. 5–8, Section 2 (Assumptions A and B, p. 6; Remark 2.6, p. 8); p. 24, (5.2)

import Mathlib
import Definitions.Def_EthierKurtz_SDEState
import Definitions.Def_EthierKurtz_IsStandardBrownian

namespace ClosedLoopMFG.Limit

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

/-- The state space `ℝ^d` (Lacker, arXiv:1808.02745v1, §2, p. 5), the platform's
`EthierKurtz.SDEState d = EuclideanSpace ℝ (Fin d)`. -/
abbrev E (d : ℕ) : Type := EthierKurtz.SDEState d

/-- `P(X)`: the Borel probability measures on `X` with the topology of weak convergence and the
**Borel** σ-field of that topology ("We always endow P(E) with the topology of weak convergence
and its corresponding Borel σ-field", p. 5). A type synonym of `ProbabilityMeasure X`, so that its
`MeasurableSpace` instance is `borel` rather than Mathlib's Giry σ-field. -/
def Prob (X : Type) [MeasurableSpace X] : Type := ProbabilityMeasure X

instance instTopologicalSpaceProb (X : Type) [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] : TopologicalSpace (Prob X) :=
  inferInstanceAs (TopologicalSpace (ProbabilityMeasure X))

instance instMeasurableSpaceProb (X : Type) [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] : MeasurableSpace (Prob X) :=
  borel _

instance instBorelSpaceProb (X : Type) [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] : BorelSpace (Prob X) :=
  ⟨rfl⟩

/-- A point of `P(X)` as a measure on `X`. -/
noncomputable def Prob.meas {X : Type} [MeasurableSpace X] (m : Prob X) : Measure X :=
  ((show ProbabilityMeasure X from m) : Measure X)

instance instIsProbabilityMeasureProbMeas {X : Type} [MeasurableSpace X] (m : Prob X) :
    IsProbabilityMeasure m.meas :=
  (show ProbabilityMeasure X from m).2

/-- `P(ℝ^d)`, with the weak topology and its Borel σ-field (p. 5). -/
abbrev PR (d : ℕ) : Type := Prob (E d)

/-- `P(A)`, the relaxed controls (§3, p. 15), for a control set `A` inside a real normed space
`EA`; `A` carries the subspace topology and σ-field. -/
abbrev PA {EA : Type} [MeasurableSpace EA] (A : Set EA) : Type := Prob A

/-- The path space `𝒞^d = C([0, T]; ℝ^d)` (p. 5), with the topology of uniform convergence
(compact-open topology on maps from the compact interval `[0, T]`) and its Borel σ-field. -/
abbrev Path (d : ℕ) (T : ℝ≥0) : Type := C(Set.Icc (0 : ℝ) T, E d)

instance instMeasurableSpacePath (d : ℕ) (T : ℝ≥0) : MeasurableSpace (Path d T) := borel _

instance instBorelSpacePath (d : ℕ) (T : ℝ≥0) : BorelSpace (Path d T) := ⟨rfl⟩

/-- The space of measure flows `C([0, T]; P(ℝ^d))` (p. 5), with the topology of uniform
convergence and its Borel σ-field. -/
abbrev Flow (d : ℕ) (T : ℝ≥0) : Type := C(Set.Icc (0 : ℝ) T, PR d)

instance instMeasurableSpaceFlow (d : ℕ) (T : ℝ≥0) : MeasurableSpace (Flow d T) := borel _

instance instBorelSpaceFlow (d : ℕ) (T : ℝ≥0) : BorelSpace (Flow d T) := ⟨rfl⟩

/-- The projection of a real time `s` onto `[0, T]`. -/
noncomputable def clampT (T : ℝ≥0) (s : ℝ) : Set.Icc (0 : ℝ) T :=
  Set.projIcc 0 (T : ℝ) T.2 s

/-- Reading a path or a flow at a real time `s` (projected onto `[0, T]`); for `s ∈ [0, T]` this
is `x_s`. -/
noncomputable def ev {T : ℝ≥0} {X : Type} [TopologicalSpace X] (x : C(Set.Icc (0 : ℝ) T, X))
    (s : ℝ) : X :=
  x (clampT T s)

/-- The empirical measure `(1/n) ∑_{k=1}^n δ_{x_k}` of `n ≥ 1` points of `X`, as an element of
`P(X)`. -/
noncomputable def empiricalPM {X : Type} [MeasurableSpace X] {n : ℕ} [NeZero n]
    (x : Fin n → X) : ProbabilityMeasure X :=
  ⟨(PMF.uniformOfFintype (Fin n)).toMeasure.map x,
    Measure.isProbabilityMeasure_map (Measurable.of_discrete).aemeasurable⟩

/-- The empirical measure `(1/n) ∑_{k=1}^n δ_{x_k}` as an element of `P(X)`. -/
noncomputable def empiricalMeasure {X : Type} [MeasurableSpace X] {n : ℕ} [NeZero n]
    (x : Fin n → X) : Prob X :=
  empiricalPM x

/-- The empirical measure depends continuously on the points (weak topology). -/
theorem continuous_empiricalPM {X : Type} [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] {n : ℕ} [NeZero n] :
    Continuous (fun x : Fin n → X => empiricalPM x) := by
  rw [ProbabilityMeasure.continuous_iff_forall_continuous_lintegral]
  intro f
  have h : ∀ x : Fin n → X, ∫⁻ ω, (f ω : ℝ≥0∞) ∂((empiricalPM x : ProbabilityMeasure X) : Measure X)
      = ∑ k, (f (x k) : ℝ≥0∞) * (PMF.uniformOfFintype (Fin n)).toMeasure {k} := by
    intro x
    simp only [empiricalPM, ProbabilityMeasure.coe_mk]
    rw [lintegral_map (by fun_prop) Measurable.of_discrete, lintegral_fintype]
  simp_rw [h]
  refine continuous_finsetSum _ fun k _ => ?_
  exact (ENNReal.continuous_mul_const (measure_ne_top _ _)).comp
    (ENNReal.continuous_coe.comp ((f.continuous).comp (continuous_apply k)))

theorem continuous_empiricalMeasure {X : Type} [TopologicalSpace X] [MeasurableSpace X]
    [OpensMeasurableSpace X] {n : ℕ} [NeZero n] :
    Continuous (fun x : Fin n → X => empiricalMeasure x) :=
  continuous_empiricalPM

/-- The empirical measure of `n ≥ 1` points of `ℝ^d`, an element of `P(ℝ^d)`. -/
noncomputable abbrev empirical {d n : ℕ} [NeZero n] (x : Fin n → E d) : PR d :=
  empiricalMeasure x

/-- **Assumption A** (p. 6). (A.1) `A` is a compact convex subset of the normed space `EA`.
(A.2) `b`, `f`, `g` are bounded and jointly continuous on `[0, T] × ℝ^d × P(ℝ^d) × A`
(resp. `ℝ^d × P(ℝ^d)`), where `P(ℝ^d)` has the weak topology. -/
def AssumptionA {d : ℕ} (T : ℝ≥0) {EA : Type} [NormedAddCommGroup EA] [NormedSpace ℝ EA]
    (A : Set EA) (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ)
    (g : E d → PR d → ℝ) : Prop :=
  IsCompact A ∧ Convex ℝ A ∧
  (∃ C : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ x m, ∀ a ∈ A, ‖b t x m a‖ ≤ C) ∧
  (∃ C : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ x m, ∀ a ∈ A, |f t x m a| ≤ C) ∧
  (∃ C : ℝ, ∀ x m, |g x m| ≤ C) ∧
  ContinuousOn (fun p : ℝ × E d × PR d × EA => b p.1 p.2.1 p.2.2.1 p.2.2.2)
    (Set.Icc (0 : ℝ) T ×ˢ Set.univ ×ˢ Set.univ ×ˢ A) ∧
  ContinuousOn (fun p : ℝ × E d × PR d × EA => f p.1 p.2.1 p.2.2.1 p.2.2.2)
    (Set.Icc (0 : ℝ) T ×ˢ Set.univ ×ˢ Set.univ ×ˢ A) ∧
  Continuous (fun p : E d × PR d => g p.1 p.2)

/-- **Assumption B** (p. 6): for each `(t, x, m) ∈ [0, T] × ℝ^d × P(ℝ^d)` the set
`K(t, x, m) = {(b(t, x, m, a), z) : a ∈ A, z ≤ f(t, x, m, a)} ⊂ ℝ^d × ℝ` is convex. -/
def AssumptionB {d : ℕ} (T : ℝ≥0) {EA : Type} [NormedAddCommGroup EA] [NormedSpace ℝ EA]
    (A : Set EA) (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ) : Prop :=
  ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ (x : E d) (m : PR d),
    Convex ℝ {p : E d × ℝ | ∃ a ∈ A, p.1 = b t x m a ∧ p.2 ≤ f t x m a}

/-- A filtration is **complete** for `P`: every `P`-null set (outer measure, so every subset of a
null set) is `𝓕₀`-measurable. -/
def IsCompleteFilt {Ω : Type} [mΩ : MeasurableSpace Ω] (𝓕 : Filtration ℝ≥0 mΩ)
    (P : Measure Ω) : Prop :=
  ∀ s : Set Ω, P s = 0 → MeasurableSet[𝓕 0] s

/-- `W` is a `d`-dimensional Brownian motion with respect to the family of σ-fields `G`
(an `𝔾`-Brownian motion): a standard Brownian motion, `W_t` is `G_t`-measurable, and the future
increments `(W_r − W_t)_{r ≥ t}` are independent of `G_t`. -/
def IsBMWrt {Ω : Type} [MeasurableSpace Ω] {d : ℕ} (G : ℝ≥0 → MeasurableSpace Ω)
    (P : Measure Ω) (W : ℝ≥0 → Ω → E d) : Prop :=
  EthierKurtz.IsStandardBrownian P W ∧
  (∀ t, Measurable[G t] (W t)) ∧
  ∀ t, Indep (G t)
    (MeasurableSpace.comap (fun ω (r : Set.Ici t) => W r ω - W t ω) inferInstance) P

/-- `W` is an `𝔽`-Brownian motion for the filtration `𝓕`. -/
def IsFBrownian {Ω : Type} [mΩ : MeasurableSpace Ω] {d : ℕ} (𝓕 : Filtration ℝ≥0 mΩ)
    (P : Measure Ω) (W : ℝ≥0 → Ω → E d) : Prop :=
  IsBMWrt (fun t => 𝓕 t) P W

/-- The σ-field generated by the measurable `P`-null sets. -/
abbrev nullSigma {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {N | MeasurableSet N ∧ P N = 0}

/-- The completed filtration generated by `(ξ, W_s, μ_s)_{s ≤ t}` (Remark 2.6, p. 8):
`σ(ξ, W_s, μ_s : s ≤ t)` augmented by the `P`-null sets. -/
abbrev genFilt {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω) (ξ : Ω → E d)
    (W : ℝ≥0 → Ω → E d) (μ : Ω → Flow d T) (t : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap ξ inferInstance ⊔
    (⨆ (s : ℝ≥0) (_ : s ≤ t), MeasurableSpace.comap (W s) inferInstance) ⊔
    (⨆ (s : Set.Icc (0 : ℝ) T) (_ : (s : ℝ) ≤ t),
      MeasurableSpace.comap (fun ω => μ ω s) inferInstance) ⊔
    nullSigma P

/-- `𝓕^μ_t = σ(μ_s : s ≤ t)` (Definition 2.5(6), p. 8). -/
abbrev Fμ {Ω : Type} {d : ℕ} {T : ℝ≥0} (μ : Ω → Flow d T) (t : ℝ) : MeasurableSpace Ω :=
  ⨆ (s : Set.Icc (0 : ℝ) T) (_ : (s : ℝ) ≤ t),
    MeasurableSpace.comap (fun ω => μ ω s) inferInstance

/-- The Brownian path `ω ↦ (W_t(ω))_{t ≥ 0}`, a random variable in `(ℝ^d)^{ℝ≥0}` with the product
σ-field. -/
def bmPath {Ω : Type} {d : ℕ} (W : ℝ≥0 → Ω → E d) : Ω → ℝ≥0 → E d :=
  fun ω t => W t ω

/-- The pairing `⟨m, φ⟩ = ∫ φ dm` for `m ∈ P(ℝ^d)`. -/
noncomputable def pair {d : ℕ} (m : PR d) (φ : E d → ℝ) : ℝ :=
  ∫ x, φ x ∂m.meas

/-- `C_c^∞(ℝ^d)`: smooth functions of compact support (p. 24). -/
def IsTestFn {d : ℕ} (φ : E d → ℝ) : Prop :=
  ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ

/-- The generator (5.2), p. 24: `Lφ(t, x, m, a) = b(t, x, m, a) · ∇φ(x) + ½ Δφ(x)`. -/
noncomputable def Lgen {d : ℕ} {EA : Type} (b : ℝ → E d → PR d → EA → E d) (φ : E d → ℝ)
    (t : ℝ) (x : E d) (m : PR d) (a : EA) : ℝ :=
  inner ℝ (b t x m a) (gradient φ x) + (1 / 2 : ℝ) * Laplacian.laplacian φ x

end ClosedLoopMFG.Limit


