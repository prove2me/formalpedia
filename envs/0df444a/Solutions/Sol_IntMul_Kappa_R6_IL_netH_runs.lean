section
-- Source module: Solutions.KIL4Sim
/-!
# KIL4: literal-to-register simulation of register programs

The KIL1–KIL3 programs carry the sizes of a configuration (field sizes, volumes, the modulus,
pass counts, …) as literals `Ex.lit v`.  A uniform program reads them from parameter stacks
instead.  `RSim π p p'` says that `p'` is `p` with some literal occurrences `.lit v` replaced by
register reads `.reg i`, where the parameter map `π` says `π i = some v`.

`RSim.sim`: on a state where every parameter stack `i` holds `v` on top (`PV π s`) and is not
written by `p`, the program `p'` is executable whenever `p` is, ends in the same state, and costs at
most `200 ×` the cost of `p` (a register read costs at most `200 ×` a literal of the same value).
Hence every KIL specification `Sp p s t c` transfers to `Sp p' s t (200 * c)` (`Sp.sim`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS

/-! ## Parameter maps and states -/

theorem pmOf_cons_self (i : Fin HS) (v : ℤ) (l : List (Fin HS × ℤ)) :
    pmOf ((i, v) :: l) i = some v := by simp [pmOf]

theorem pmOf_some {l : List (Fin HS × ℤ)} {i : Fin HS} {v : ℤ} (h : pmOf l i = some v) :
    (i, v) ∈ l := by
  induction l with
  | nil => simp [pmOf] at h
  | cons p l ih =>
    obtain ⟨j, w⟩ := p
    simp only [pmOf] at h
    split_ifs at h with hij
    · cases h; subst hij; exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

theorem PLow.of_list {l : List (Fin HS × ℤ)} (h : ∀ p ∈ l, p.1.val < 56) : PLow (pmOf l) :=
  fun _ _ hv => h _ (pmOf_some hv)

theorem notw_of_list {l : List (Fin HS × ℤ)} {p : RS} (h : ∀ q ∈ l, q.1 ∉ p.writes) :
    ∀ i v, pmOf l i = some v → i ∉ p.writes :=
  fun _ _ hv => h _ (pmOf_some hv)

end NLogN.KIL

end

section
-- Source module: Solutions.KIL5Tab
/-!
# KIL5: the stream table with run-time stream length

KIL3's table operations (`applyC`, `copyC`, `accC`, `buildC`, `rebuildC`, KIL3Tab) carry the
stream length `v` and the offsets `w · v` as literals.  Here the counts are read from registers:

* `rV` (`42`) holds `v`, `rWV` (`43`) holds `W · v`;
* the offset `w · v` (`w < W` a fixed wire) is computed into the temporary register `rT` (`44`)
  by one multiplication (`push rT (w · rV)`) and popped afterwards.

The element loops `dupK`, `zipK`, `zeroK`, `dropK` with register counts are obtained from the
literal ones by the literal-to-register simulation (`Sp.sim`, KIL4Sim).

`applyCU_runs` is relative to an invariant: the stream code only has to be correct on states
`t` with `Inv G0 t` (every protected stack `r ≥ 22`, `r ≠ 44`, holds `G0 r`).  This is what the
uniform procedure needs: its child calls read the descriptor and the level registers from these
stacks.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Registers and the invariant -/

theorem not_prot {r : Fin HS} (h : r.val < 22) : ¬ Prot r := fun h' => by
  unfold Prot at h'; omega

/-! ## Moves and loops with register counts -/

theorem rsim_dropK (X C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (dropK X C k) (dropKE X C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

theorem rsim_zeroK (Y C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (zeroK Y C k) (zeroKE Y C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

