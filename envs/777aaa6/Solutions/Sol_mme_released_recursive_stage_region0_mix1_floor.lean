    have h2 : (0 : ℝ) ≤ ((n3 0 r : ℕ) : ℝ) := by positivity
    calc ((n3 0 r * L3Agg.mfn r : ℕ) : ℝ)/10^30
        = ((n3 0 r : ℕ) : ℝ) * ((L3Agg.mfq r : ℚ) : ℝ) := by
          unfold L3Agg.mfq; push_cast; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (L3Agg.hmix r) h2
  refine le_trans (le_of_eq ?_) (Finset.sum_le_sum (fun r _ ↦ hterm r))
  rw [← Finset.sum_div, ← Nat.cast_sum, L3Agg.msum]
