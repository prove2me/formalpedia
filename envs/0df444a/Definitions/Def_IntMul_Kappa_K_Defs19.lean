section
-- Source module: Solutions.KFMSetup
/-!
# KFM 14: the setup arithmetic (§9.2), in the integer form the machine computes

* **`floor_root_eq`/`floor_root_spec`**: `⌊N^{1/m}⌋ = x` iff `x^m ≤ N < (x+1)^m`, so
  **`dP_spec`** (`m = 2^75`, of `b`) and **`KP_spec`** (`m = 2^56`, of `d`) are exact integer
  comparisons (computed by saturating powers and binary search).
* **`ceil_root_eq`**, **`αP_spec`**: `α = αP n` iff `(α-1)^4 < 12 d² b ≤ α^4`.
* **`LP_spec`/`LP_eq`**: `L = LP n` iff `4n ≤ 2^L b` and (`L = 0` or `4n > 2^{L-1} b`).
* **`srcS d d' r i`**: the explicit source lengths of `RCop.coprime_params`
  (`1 + Q m_i`, `Q = 2F(⌊r/(2FD)⌋+1)`, `F = D!`, `D = 256 d²`), and **`srcS_ok`**: odd, pairwise
  coprime, in the windows `((1-2η)t_i, (1-η)t_i]`; **`srcS_ok_n`** for the parameters of `n ≥ n₀`.
* **`mu_spec`**: `μ = (P mod s)⁻¹` from `Nat.gcdA` (extended Euclid) satisfies `μ P ≡ 1 (mod s)`.
-/

namespace NLogN.KFM

open IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-! ## Integer roots -/

/-! ## Explicit source lengths -/

/-- `Q = 2F(⌊r/(2FD)⌋+1)`, `F = D!`, `D = 256 d²`. -/
def srcQ (d r : ℕ) : ℕ :=
  2 * (256 * d ^ 2).factorial * (r / (2 * (256 * d ^ 2).factorial * (256 * d ^ 2)) + 1)

/-- The top index `⌊((4d-1) t - 4d)/(4dQ)⌋` of a group. -/
def srcM (d r t : ℕ) : ℕ := ((4 * d - 1) * t - 4 * d) / (4 * d * srcQ d r)

/-- The source length of axis `i` (`t_i = r/2` for `i < d'`, `r` otherwise). -/
def srcS (d d' r i : ℕ) : ℕ :=
  1 + srcQ d r * (if i < d' then srcM d r (r / 2) - i else srcM d r r - (i - d'))

/-! ## Modular inverses -/

/-- The inverse `μ = gcdA(P, s) mod s` of `P` modulo `s` (extended Euclid). -/
def muInv (P s : ℕ) : ℕ := ((Nat.gcdA P s) % (s : ℤ)).toNat

end

end NLogN.KFM

end


