theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨292470092988,293019848803⟩ ⟨742314214164,742436072420⟩ ⟨138909550274,153835420622⟩ := rfl
noncomputable def centerUpper : ℝ := (640237680479 / 1099511627776)
