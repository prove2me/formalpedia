section lane
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)}

theorem mvL (hL : LaneOK lin) (s : IState HS) (G : Fin HS → List ℤ) (inp tmp : List U)
    {i j : Fin HS} (hi : i ∈ skel) (hj : j ∈ skel) (hij : i ≠ j) {a : ℤ} {l : List ℤ}
