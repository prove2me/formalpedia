namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

theorem hasDerivAt_of_cd {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) {s : ℝ}
    (hs : s ∈ R) : HasDerivAt f (deriv f s) s :=
  ((h.contDiffAt (hR.mem_nhds hs)).differentiableAt (by simp)).hasDerivAt

theorem cd_deriv {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) :
    ContDiffOn ℝ ∞ (deriv f) R :=
  h.deriv_of_isOpen hR (by simp)

namespace ESData

variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ} {x : Pt 5}

theorem d1B (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) :
    HasDerivAt (deriv B) (deriv (deriv B) (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen (cd_deriv hE.isOpen hE.cB) hx.1
theorem d0D (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt D (deriv D (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cD hx.1

theorem d0A (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt A (deriv A (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cA hx.1
theorem d1A (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) :
    HasDerivAt (deriv A) (deriv (deriv A) (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen (cd_deriv hE.isOpen hE.cA) hx.1
theorem d0H (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt H (deriv H (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cH hx.1
theorem d1H (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) :
    HasDerivAt (deriv H) (deriv (deriv H) (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen (cd_deriv hE.isOpen hE.cH) hx.1
theorem d0W (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt W (deriv W (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cW hx.1
