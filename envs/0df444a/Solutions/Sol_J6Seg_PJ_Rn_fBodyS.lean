theorem cT_add_ix (ix : Fin HS) (W : ℕ) :
    cT (E.add (.r ix) (.k 1)).ex W = cT (E.add (.r 0) (.k 1)).ex W := by
  simp [cT, cE, E.ex, Ex.size]

/-- **Counted loop with an index register.** -/
theorem Rn.forL {C rN ix : Fin HS} (hC : C ∉ rg) (hC5 : C.val < 56) (hrN : rN ∈ rg)
    (hix : ix ∈ rg) (hixN : ix ≠ rN) {b : RS} (hw : C ∉ b.writes) {N W : ℕ} {Iv : ℕ → Vr → Prop}
    {cf : ℕ → Cs} {cb : ℕ} (hcC : ∀ k, cf k C = []) (hNW : N < 2 ^ W)
    (hb : ∀ k < N, ∀ v, Iv k v → v ix = k → BV W v →
      Rn b v (Function.update (cf k) C [((N : ℤ) - k)]) (fun v' =>
        Iv (k + 1) (Function.update v' ix ((k + 1 : ℕ) : ℤ)) ∧ v' ix = k ∧ BV W v') (Function.update (cf (k + 1)) C [((N : ℤ) - k)]) cb)
    {v : Vr} (hv : BV W v) (hvr : v rN = N) (h0 : Iv 0 (Function.update v ix 0)) :
    Rn (forL C rN ix b) v (cf 0) (fun v' => Iv N v' ∧ v' ix = N ∧ BV W v') (cf N)
      (cFor W N cb) := by
  have hW1 : (1 : ℕ) ≤ 2 ^ W := Nat.one_le_two_pow
  have h1 := Rn.asgE (c := cf 0) (e := E.k 0) hix rfl (by simp [E.lb]; exact hW1) hv
  refine Rn.seq h1 (fun v1 hv1 => ?_)
  subst hv1
  have hw' : C ∉ (RS.seq b (.asg ix (E.add (.r ix) (.k 1)).ex)).writes := by
    simp only [writes, List.mem_append, List.mem_singleton, not_or]
    exact ⟨hw, fun h => hC (h ▸ hix)⟩
  have hR := Rn.rep (C := C) (r := rN) (b := .seq b (.asg ix (E.add (.r ix) (.k 1)).ex)) hC hC5
    hrN hw' (N := N) (Iv := fun k v => Iv k v ∧ v ix = k ∧ BV W v) (cf := cf) (B := W + 1)
    (cb := cb + cT (E.add (.r ix) (.k 1)).ex W) hcC (zsz_nat_le hNW)
    (fun k hk v ⟨hI, hx, hB⟩ => by
      refine Rn.seq (hb k hk v hI hx hB) (fun v1 ⟨hI1, hx1, hB1⟩ => ?_)
      have h2 := Rn.asgE (c := Function.update (cf (k + 1)) C [((N : ℤ) - k)])
        (e := E.add (.r ix) (.k 1)) hix (by simp [E.ok, hix]) (by simp [E.lb]; exact hW1) hB1
      refine h2.mono (fun v2 hv2 => ?_) le_rfl
      subst hv2
      refine ⟨?_, by simp [E.den, hx1], BV_upd hB1 ?_⟩
      · have : E.den v1 (E.add (.r ix) (.k 1)) = ((k + 1 : ℕ) : ℤ) := by simp [E.den, hx1]
        rw [this]; exact hI1
      · simp [E.den, hx1]
        have : ((k : ℤ) + 1) = ((k + 1 : ℕ) : ℤ) := by push_cast; ring
        rw [this, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega : k + 1 ≤ 2 ^ W))
    (by refine ⟨h0, by simp, BV_upd hv (by simp)⟩) (by rw [Function.update_of_ne (Ne.symm hixN)]; exact hvr)
  refine hR.mono (fun v' h => h) ?_
  simp only [cFor, cT_add_ix, show W + 1 + 2 = W + 3 by omega]
  omega

end J6Seg.PJ

