theorem nK_succ (L : List (ℕ × ℕ)) (k : ℕ) (hk : k < L.length) : nK L (k + 1) = nK L k * (L[k]).2 := by
  simp only [nK, List.take_add_one, List.getElem?_eq_getElem hk, Option.toList_some, List.map_append,
    List.prod_append, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]

