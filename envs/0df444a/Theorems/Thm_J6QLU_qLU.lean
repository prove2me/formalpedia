open J6QLU
open Finset Matrix
variable {K : Type*} [Field K]

theorem J6QLU.qLU (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    gaussToep x z n =
      Gam (x ^ 2) n * lowT (bP x z⁻¹) * GamInv (x ^ 2) n * upT (bP x z) * Gam (x ^ 2) n := by sorry
