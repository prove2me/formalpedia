-- title:
--   Every maximal ideal of the ramified extension is generated by zeta minus one
-- statement:
--   Let $A$ be a characteristic-zero discrete valuation ring whose maximal ideal is generated by a prime number $p$, let $k\in\mathbb N$, and let $E=A[X]/(\Phi_{p^{k+1}}(X))$ with root $\zeta$ and $\pi=\zeta-1$. Then every maximal ideal $M$ of $E$ satisfies
--   $$
--   M=(\pi).
--   $$
--
--   In particular the ramified cyclotomic extension has a unique maximal ideal, generated by $\zeta-1$.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/LinearAlgebra/CirculantHadamard/RamifiedLocal.lean#L89-L122

import Mathlib
import Definitions.Def_CirculantHadamard
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_Basic
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_Witnesses
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_MatrixBridge
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_CyclicRing
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_CyclicNorm
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_CyclicProjection
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_LocalDVR
import Definitions.Def_OAI_LinearAlgebra_CirculantHadamard_IntegerTwoLocal
