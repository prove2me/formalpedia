-- title:
--   §3 p. 5, App. A pp. 10–12, App. B p. 16 — public beliefs µ_t, µ_∞, value of private information d_t, degenerate priors, single-agent decision value
-- statement:
--   Fix a social learning model, a utility $u$ and a strategy profile $\sigma$ with play measure $P_\sigma$.
--
--   1. **Public beliefs.** $\mu_t(\cdot \mid h_t)$ is the conditional distribution of the state given the history $h_t$, and $\mu_\infty(\cdot \mid h_\infty)$ is the conditional distribution given the whole infinite history of actions.
--   2. **Public-information payoff.** $\hat y_t = \max_{a\in A} E_\sigma[u(a,\omega) \mid h_t]$.
--   3. **Value of private information.** With $\mathcal H_t$ the σ-algebra generated by $h_t$ and $y_t = u(a_t,\omega)$,
--   $$
--   d_t = E_\sigma[y_t - \hat y_t \mid h_t] = E_\sigma[y_t \mid \mathcal H_t] - \hat y_t .
--   $$
--   4. **Degenerate priors.** A prior $\nu$ is degenerate if the value of private information of the first agent is zero in the game $(\Omega, \nu, F, u)$. The first agent has no history, so this says that observing one signal $s$ and best-responding to the posterior $\nu F(\cdot\mid s)$ gives no more than $\max_a E_\nu[u(a,\omega)]$:
--   $$
--   \int_S \max_{a\in A} E_{\nu F(\cdot\mid s)}[u(a,\omega)]\, d(\nu F)(s) = \max_{a \in A} E_\nu[u(a,\omega)].
--   $$
--   5. **Single-agent decision value.** For $\lambda \in \Delta(\Omega\times T\times S)$, $m$ is the supremum, over measurable strategies $\tau : T\times S\to A$, of $E_\lambda[u(\tau(t,s),\omega)]$.
--
--   These objects carry Lemma 1 (vanishing value of private information), Lemma 2 (the limit belief is degenerate) and Lemma 4.
--
--   **Formalization Note** The beliefs are Mathlib's `condDistrib` kernels under $P_\sigma$. $\hat y_t$ is computed from the regular conditional distribution, which makes the maximum over uncountably many actions well defined. Since $\hat y_t$ is $\mathcal H_t$-measurable, $d_t$ is written as $E_\sigma[y_t\mid\mathcal H_t]-\hat y_t$. The value $m$ is taken over pure measurable strategies; mixing does not raise the supremum.
-- source:
--   Arieli & Mueller-Frank, A General Analysis of Sequential Social Learning, SSRN 2466903 (version of February 21, 2019), p. 5 (ŷ_t, d_t), p. 10 (degenerate priors, D), p. 12 (single agent decision problem), p. 16 (µ_t, µ_∞)

import Mathlib
import Definitions.Def_SeqSocialLearning_Adequate_Model

namespace SeqSocialLearning.Adequate

open MeasureTheory ProbabilityTheory

variable {Ω A S : Type*} [MeasurableSpace Ω] [MeasurableSpace A] [MeasurableSpace S]

/-- The public belief `µ_t = µ_σ(dω | H_t)` (§B, p. 16): a regular conditional distribution of
the state given the history `h_t` observed by agent `t`, under the play measure `Pσ`. -/
noncomputable def publicBelief [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) (t : ℕ) : Kernel (Fin t → A) Ω :=
  condDistrib state (fun x => history x t) (playMeasure μ F p)

/-- The belief at infinity `µ_∞ = µ_σ(dω | H_∞)` (§B, p. 16): a regular conditional distribution
of the state given the infinite history of actions, under `Pσ`. -/
noncomputable def limitBelief [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) : Kernel (ℕ → A) Ω :=
  condDistrib state fullHistory (playMeasure μ F p)

instance [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) (t : ℕ) : IsMarkovKernel (publicBelief μ F p t) := by
  unfold publicBelief
  infer_instance

instance [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) : IsMarkovKernel (limitBelief μ F p) := by
  unfold limitBelief
  infer_instance

/-- The public-information payoff `ŷ_t = max_{a ∈ A} E_σ[u(a, ω) | h_t]` (§3, p. 5), computed
from the public belief `µ_t(· | h_t)`. -/
noncomputable def yhat [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) (u : A → Ω → ℝ) (t : ℕ) (x : ℕ → Ω × S × A) : ℝ :=
  ⨆ a, ∫ ω, u a ω ∂(publicBelief μ F p t (history x t))

/-- The σ-algebra `H_t` generated by the history `h_t` (§3, p. 5). -/
abbrev histSigma (t : ℕ) : MeasurableSpace (ℕ → Ω × S × A) :=
  MeasurableSpace.comap (fun x => history x t) inferInstance

/-- The value of private information `d_t = E_σ[y_t − ŷ_t | h_t]` of agent `t` (§3, p. 5), with
`y_t = u(a_t, ω)`. Since `ŷ_t` is a function of `h_t`, this is `E_σ[y_t | H_t] − ŷ_t`. -/
noncomputable def valuePrivInfo [StandardBorelSpace Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Kernel Ω S) [IsMarkovKernel F]
    (p : Profile A S) (u : A → Ω → ℝ) (t : ℕ) (x : ℕ → Ω × S × A) : ℝ :=
  (playMeasure μ F p)[fun y => u (action y t) (state y) | histSigma t] x - yhat μ F p u t x

/-- The value of the one-shot decision problem of the first agent in the game `(Ω, ν, F, u)`:
the agent observes a signal `s` (law `F ∘ ν`), forms the posterior `(F†ν)(· | s)` and takes a
best reply to it. -/
noncomputable def oneShotValue [StandardBorelSpace Ω] [Nonempty Ω]
    (ν : Measure Ω) [IsFiniteMeasure ν] (F : Kernel Ω S) [IsFiniteKernel F]
    (u : A → Ω → ℝ) : ℝ :=
  ∫ s, (⨆ a, ∫ ω, u a ω ∂((F†ν) s)) ∂(F ∘ₘ ν)

/-- A prior `ν` is degenerate (Appendix A, p. 10) if the value of private information of the
first agent is zero, `d₁ = 0`, in the game `(Ω, ν, F, u)`: observing the signal does not raise the
first agent's expected payoff above `max_a E_ν[u(a, ω)]`. -/
def IsDegenerate [StandardBorelSpace Ω] [Nonempty Ω]
    (ν : Measure Ω) [IsFiniteMeasure ν] (F : Kernel Ω S) [IsFiniteKernel F]
    (u : A → Ω → ℝ) : Prop :=
  oneShotValue ν F u = ⨆ a, ∫ ω, u a ω ∂ν

/-- The value `m` of the single-agent decision problem of Appendix A (p. 12): the agent observes
`(t, s)` drawn with the `T × S`-marginal of `λ ∈ ∆(Ω × T × S)` and takes an action; `m` is the
supremum of the expected utility over measurable strategies `T × S → A`. -/
noncomputable def decisionValue {T : Type*} [MeasurableSpace T]
    (lam : Measure (Ω × T × S)) (u : A → Ω → ℝ) : ℝ :=
  ⨆ τ : {τ : T × S → A // Measurable τ}, ∫ z, u (τ.1 (z.2.1, z.2.2)) z.1 ∂lam

end SeqSocialLearning.Adequate


