theorem NLogN.FIN.GK_le {K N β W : ℕ} (h : HB K N β W) (Φf Φm : ℕ) :
    GK K N Φf Φm ≤ 3 * 2 ^ (mkParams K N).logOuter * Φf +
      Φm * (100 * (K + 1) * (W + 2) * 2 ^ (mkParams K N).logT) +
      (10 ^ 22 * ((K + 1) ^ 2 * ((2 ^ (mkParams K N).logT + 1) * (β + 2) ^ 2)) +
        10 ^ 64 * ((K + 1) ^ 2 * ((2 ^ (mkParams K N).e + 1) ^ 3 * (β + 2) ^ 12)) +
        10 ^ 7 * ((N + 1) * (β + 2))) := by sorry
