-- title:
--   Stochastic Volterra equation (1.1), kernel conditions (2.5) and (3.4), and weak solutions
-- statement:
--   Let $K:[0,\infty)\to\mathbb R^{d\times d}$ be a deterministic convolution kernel, $b:\mathbb R^d\to\mathbb R^d$ a drift, and $\sigma:\mathbb R^d\to\mathbb R^{d\times m}$ a diffusion coefficient. This file fixes the stochastic Volterra equation
--
--   $$
--   X_t=x_0+\int_0^t K(t-s)b(X_s)\,ds+\int_0^t K(t-s)\sigma(X_s)\,dW_s.
--   $$
--
--   A solution is an adapted process with continuous paths. Each deterministic convolution is genuinely integrable, and each stochastic convolution is witnessed by a Brownian Itô integral relation at its terminal time. The equation holds almost surely at every fixed time. A weak solution chooses its probability space, usual filtration, Brownian motion, and process; a strong solution is additionally adapted to the completed Brownian past. The nonnegative orthant consists of vectors with every coordinate nonnegative.
--
--   The file also defines local $L^p$ membership componentwise, condition (2.5) by the two stated $O(h^\gamma)$ estimates, and condition (3.4) by monotonicity of a scalar kernel and its nonnegative resolvent measure. Matrix first-kind resolvents use differences of locally finite positive measures for each entry, allowing locally bounded variation without a finite total mass. Linear growth uses Euclidean vector and matrix operator norms.
--
--   **Formalization Note** Time is represented by nonnegative reals for processes and by reals in deterministic kernels. On the convolution interval, a real integration time is converted to a nonnegative time for evaluating the process. At $t=0$ the deterministic interval integral is zero. The constant initial condition is deterministic. The Brownian motion is $m$-dimensional, matching $\sigma:\mathbb R^d\to\mathbb R^{d\times m}$; the word "$d$-dimensional" in the weak-solution sentence on p. 12 is a slip. As in (2.1), the first-kind resolvent identities $K*L=L*K\equiv I$ are required at every $t>0$. The value $K(0)$ enters only when $L$ has an atom at $t$. "Usual conditions" means that $\mathcal F_0$ contains every subset of a null set and that the filtration is right-continuous. A strong solution is adapted to the $\mathbb P$-completed filtration generated by $W$.
-- source:
--   Abi Jaber, Larsson and Pulido, Affine Volterra processes, arXiv:1708.08796v3, (1.1), p. 2; (2.1)–(2.5), pp. 4–6; (2.13), p. 10; §3 setting, pp. 11–12; (3.1), p. 12; (3.4), p. 14

import Mathlib
import Definitions.Def_EthierKurtz_SDEState
import Definitions.Def_EthierKurtz_IsStandardBrownian
import Definitions.Def_EthierKurtz_HasBrownianItoIntegral
import Definitions.Def_EthierKurtz_completedBrownianPast
import Definitions.Def_HighDimProb_RandomMatrices_matrixOpNorm

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology BigOperators

namespace AffineVolterra.Existence

abbrev State (d : ℕ) := EthierKurtz.SDEState d
abbrev Kernel (d : ℕ) := ℝ → Matrix (Fin d) (Fin d) ℝ
abbrev Diffusion (d m : ℕ) := State d → Matrix (Fin d) (Fin m) ℝ

/-- Local componentwise Lᵖ membership on positive time, as in §2. -/
def LpLoc (p : ℝ≥0∞) (f : ℝ → ℝ) : Prop :=
  ∀ T : ℝ, 0 < T → MemLp f p (volume.restrict (Set.Ioc 0 T))

/-- Condition (2.5), with each big-O taken as h tends to zero from above. -/
def Cond25 (K : ℝ → ℝ) (γ : ℝ) : Prop :=
  0 < γ ∧ γ ≤ 2 ∧ LpLoc 2 K ∧
  (fun h : ℝ => ∫ t in (0 : ℝ)..h, K t ^ 2) =O[𝓝[>] (0 : ℝ)]
    (fun h : ℝ => h ^ γ) ∧
  ∀ T : ℝ, 0 < T →
    (fun h : ℝ => ∫ t in (0 : ℝ)..T, (K (t + h) - K t) ^ 2) =O[𝓝[>] (0 : ℝ)]
      (fun h : ℝ => h ^ γ)

/-- A scalar first-kind resolvent, with the positive measure representation used in (3.4). -/
def ScalarResolvent (K : ℝ → ℝ) (L : Measure ℝ) : Prop :=
  L (Set.Iio 0) = 0 ∧
  (∀ T : ℝ, 0 ≤ T → L (Set.Icc 0 T) < ⊤) ∧
  ∀ t : ℝ, 0 < t →
    IntegrableOn (fun s => K (t - s)) (Set.Icc 0 t) L ∧
    (∫ s in Set.Icc 0 t, K (t - s) ∂L) = 1

/-- The kernel and its nonnegative first-kind resolvent satisfy (3.4). -/
def Cond34 (K : ℝ → ℝ) : Prop :=
  (∀ t : ℝ, 0 < t → 0 ≤ K t) ∧
  (∃ t : ℝ, 0 < t ∧ K t ≠ 0) ∧
  (∀ s t : ℝ, 0 < s → s ≤ t → K t ≤ K s) ∧
  ContinuousOn K (Set.Ioi 0) ∧
  ∃ L : Measure ℝ, ScalarResolvent K L ∧
    ∀ (s u t : ℝ), 0 ≤ s → s ≤ u → 0 ≤ t →
      L (Set.Icc u (u + t)) ≤ L (Set.Icc s (s + t))

/-- The scalar kernels on the diagonal of K. -/
def IsDiagKernel {d : ℕ} (K : Kernel d) (Kd : Fin d → ℝ → ℝ) : Prop :=
  ∀ t : ℝ, 0 ≤ t → K t = Matrix.diagonal (fun i => Kd i t)

/-- The matrix-valued first-kind resolvent of (2.13), represented entrywise as
the difference of two locally finite positive measures. -/
def ResolventFirstKind {d : ℕ} (K : Kernel d)
    (Lpos Lneg : Fin d → Fin d → Measure ℝ) : Prop :=
  (∀ i j, Lpos i j (Set.Iio 0) = 0 ∧ Lneg i j (Set.Iio 0) = 0) ∧
  (∀ i j (T : ℝ), 0 ≤ T →
    Lpos i j (Set.Icc 0 T) < ⊤ ∧ Lneg i j (Set.Icc 0 T) < ⊤) ∧
  (∀ t : ℝ, 0 < t → ∀ i j k,
    IntegrableOn (fun s => K (t - s) i k) (Set.Icc 0 t) (Lpos k j) ∧
    IntegrableOn (fun s => K (t - s) i k) (Set.Icc 0 t) (Lneg k j) ∧
    IntegrableOn (fun s => K (t - s) k j) (Set.Icc 0 t) (Lpos i k) ∧
    IntegrableOn (fun s => K (t - s) k j) (Set.Icc 0 t) (Lneg i k)) ∧
  (∀ t : ℝ, 0 < t → ∀ i j,
    (∑ k, ((∫ s in Set.Icc 0 t, K (t - s) i k ∂(Lpos k j)) -
      (∫ s in Set.Icc 0 t, K (t - s) i k ∂(Lneg k j)))) =
      if i = j then 1 else 0) ∧
  (∀ t : ℝ, 0 < t → ∀ i j,
    (∑ k, ((∫ s in Set.Icc 0 t, K (t - s) k j ∂(Lpos i k)) -
      (∫ s in Set.Icc 0 t, K (t - s) k j ∂(Lneg i k)))) =
      if i = j then 1 else 0)

def HasResolventFirstKind {d : ℕ} (K : Kernel d) : Prop :=
  ∃ Lpos Lneg, ResolventFirstKind K Lpos Lneg

/-- Linear growth (3.1), using the Euclidean vector and operator matrix norms. -/
def LinGrowth {d m : ℕ} (b : State d → State d) (σ : Diffusion d m) (c : ℝ) : Prop :=
  ∀ x, max ‖b x‖ (HighDimProb.RandomMatrices.matrixOpNorm (σ x)) ≤ c * (1 + ‖x‖)

/-- Lipschitz continuity of both coefficients in the norms fixed on p. 4. -/
def LipschitzCoefficients {d m : ℕ} (b : State d → State d)
    (σ : Diffusion d m) : Prop :=
  ∃ c : ℝ, 0 ≤ c ∧ ∀ x y,
    ‖b x - b y‖ ≤ c * ‖x - y‖ ∧
    HighDimProb.RandomMatrices.matrixOpNorm (σ x - σ y) ≤ c * ‖x - y‖

/-- Completeness and right continuity of a stochastic basis. -/
def IsUsualBasis {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) : Prop :=
  (∀ A N : Set Ω, MeasurableSet N → P N = 0 → A ⊆ N → MeasurableSet[ℱ 0] A) ∧
  ∀ t : ℝ≥0, ℱ t = ⨅ (s : ℝ≥0) (_ : t < s), ℱ s

/-- A Brownian motion adapted to the basis, with future increments independent of its past. -/
def IsFBrownian {Ω : Type} [MeasurableSpace Ω] {m : ℕ} (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›)
    (W : ℝ≥0 → Ω → State m) : Prop :=
  EthierKurtz.IsStandardBrownian P W ∧
  (∀ t, Measurable[ℱ t] (W t)) ∧
  ∀ t, Indep (ℱ t)
    (MeasurableSpace.comap (fun ω (r : Set.Ici t) => W r.val ω - W t ω)
      inferInstance) P

/-- A fixed-terminal-time stochastic convolution is defined through published
Brownian Itô relations; no unconstrained integral process is allowed. -/
def StochConv {Ω : Type} [MeasurableSpace Ω] {d m : ℕ} (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (K : Kernel d)
    (σ : Diffusion d m) (W : ℝ≥0 → Ω → State m)
    (X : ℝ≥0 → Ω → State d)
    (J : ℝ≥0 → Fin d → Fin d → Fin m → ℝ≥0 → Ω → ℝ) : Prop :=
  ∀ t i j k, EthierKurtz.HasBrownianItoIntegral P ℱ
    (fun r ω => W r ω k)
    (fun r ω => if r < t then K ((t : ℝ) - (r : ℝ)) i j * σ (X r ω) j k else 0)
    (J t i j k)

/-- Continuous adapted solutions of (1.1), with every time-slice equation holding
almost surely and with a constrained family of stochastic convolutions. -/
def IsSolution {Ω : Type} [MeasurableSpace Ω] {d m : ℕ} (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (K : Kernel d)
    (b : State d → State d) (σ : Diffusion d m) (x₀ : State d)
    (W : ℝ≥0 → Ω → State m) (X : ℝ≥0 → Ω → State d) : Prop :=
  (∀ t, Measurable[ℱ t] (X t)) ∧
  (∀ ω, Continuous (fun t => X t ω)) ∧
  (∀ (t : ℝ≥0) ω i j, IntervalIntegrable
    (fun s : ℝ => K ((t : ℝ) - s) i j * b (X s.toNNReal ω) j)
      volume 0 t.val) ∧
  ∃ J : ℝ≥0 → Fin d → Fin d → Fin m → ℝ≥0 → Ω → ℝ,
    StochConv P ℱ K σ W X J ∧
    ∀ t : ℝ≥0, ∀ᵐ ω ∂P, ∀ i,
      X t ω i = x₀ i +
        (∑ j, ∫ s in (0 : ℝ)..t.val,
          K ((t : ℝ) - s) i j * b (X s.toNNReal ω) j) +
        ∑ j, ∑ k, J t i j k t ω

/-- A weak solution is allowed to choose its stochastic basis. -/
def HasWeakSolution {d m : ℕ} (K : Kernel d) (b : State d → State d)
    (σ : Diffusion d m) (x₀ : State d) (S : Set (State d)) : Prop :=
  ∃ (Ω : Type) (mΩ : MeasurableSpace Ω),
    letI : MeasurableSpace Ω := mΩ
    ∃ (P : Measure Ω) (hP : IsProbabilityMeasure P),
      letI : IsProbabilityMeasure P := hP
      ∃ (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›)
        (W : ℝ≥0 → Ω → State m) (X : ℝ≥0 → Ω → State d),
        IsUsualBasis P ℱ ∧ IsFBrownian P ℱ W ∧
        IsSolution P ℱ K b σ x₀ W X ∧
        ∀ t : ℝ≥0, ∀ᵐ ω ∂P, X t ω ∈ S

/-- Strongness adds adaptation to the completed filtration of the Brownian past. -/
def IsStrongSolution {Ω : Type} [MeasurableSpace Ω] {d m : ℕ} (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (K : Kernel d)
    (b : State d → State d) (σ : Diffusion d m) (x₀ : State d)
    (W : ℝ≥0 → Ω → State m) (X : ℝ≥0 → Ω → State d) : Prop :=
  IsSolution P ℱ K b σ x₀ W X ∧
  ∀ t, Measurable[EthierKurtz.completedBrownianPast P W (fun _ => (0 : State m)) t] (X t)

def NonnegativeOrthant (d : ℕ) : Set (State d) := {x | ∀ i, 0 ≤ x i}

end AffineVolterra.Existence


