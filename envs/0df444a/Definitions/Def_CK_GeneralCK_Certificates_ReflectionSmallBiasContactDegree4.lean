  · exact group4_degree12
  · exact group4_degree13
  · exact group4_degree14
  · exact group4_degree15
  · exact group4_degree16
  · exact group4_degree17
  · exact group4_degree18
  · exact group4_degree19
  · exact group4_degree20
  · exact group4_degree21
  · exact group4_degree22
  · exact group4_degree23

theorem group4_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 coefficient4 body4) z = eval k group4 z := by
  have he := eval_eq_of_aParts 24 k group4_raw group4 z
    (aBound_sound group4_raw_bound) (aBound_sound group4_result_bound)
    group4_degrees
  change eval k (normalize group4_raw) z = eval k group4 z
  rw [eval_normalize]
  exact he

theorem coefficient4_approximates (k : ℂ) :
    Approximates 24 k (fun _ => eval k coefficient4 (0:ℂ × ℂ)) coefficient4 := by
  convert Approximates.exactPolynomial 24 k coefficient4 using 1
  funext z
  simp [coefficient4,eval,evalTerm]

theorem evalContact_group4 (k s e : ℂ) :
    evalContact k phiGroup4 s e = eval k coefficient4 (0:ℂ × ℂ)*(s^4*(e⁻¹)^3) := by
  norm_num [phiGroup4,coefficient4,evalContact,evalContactTerm,eval,evalTerm]
  <;> ring

theorem group4_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => evalContact k phiGroup4 (halfSum z) (meanFunction z)) group4 := by
  have hb := ((halfPower4_approximates hk).mul hk (inversePower3_approximates hk hklog)).replacePolynomial
    (body4_eval k)
  have hh := ((coefficient4_approximates k).mul hk hb).replacePolynomial
    (group4_eval k)
  simpa only [evalContact_group4] using hh

