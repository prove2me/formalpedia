open NLogN NLogN.KIL NLogN.KIL.NE
open IntMul NLogN.RS AModel AModelL12

theorem NLogN.KIL.NE.good {t : IState HS} {v : Fin HS → ℕ} {M B : ℕ} (hM : zsz (M : ℤ) ≤ B) :
    ∀ e : NE, Holds t v e → e.OK v M →
      e.toEx.ok t ∧ e.toEx.Bnd t B ∧ e.toEx.eval t = (e.val v : ℤ) := by sorry
