theorem solution.{u_1, u_2} : type_of% @OAI.EditApproximation.BinaryFraction.onlineLinearWithWork_cost_oai.{u_1, u_2} := @OAI.EditApproximation.BinaryFraction.onlineLinearWithWork_cost_oai.{u_1, u_2}
