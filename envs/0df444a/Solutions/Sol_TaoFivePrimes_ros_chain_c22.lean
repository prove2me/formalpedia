theorem child22_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu101.lin : ℝ) ≤ (S : ℝ) * logProd gu101.lo) :
    (gu104.lfin : ℝ) ≤ (S : ℝ) * logProd gu104.top ∧
      (∀ x : ℝ, (gu101.lo : ℝ) < x → x ≤ (gu104.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u101 hγ hstate
  have s1 := sol_u102 hγ (by simpa [gu101, gu102] using s0.1)
  have s2 := sol_u103 hγ (by simpa [gu102, gu103] using s1.1)
  have s3 := sol_u104 hγ (by simpa [gu103, gu104] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu101.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu102.lo : ℝ) < x := by
        have hb : (gu101.top : ℝ) = (gu102.lo : ℝ) := by simp [gu101, gu102]
        linarith
    by_cases h1 : x ≤ (gu102.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu103.lo : ℝ) < x := by
          have hb : (gu102.top : ℝ) = (gu103.lo : ℝ) := by simp [gu102, gu103]
          linarith
      by_cases h2 : x ≤ (gu103.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu104.lo : ℝ) < x := by
            have hb : (gu103.top : ℝ) = (gu104.lo : ℝ) := by simp [gu103, gu104]
            linarith
        exact s3.2 x hx3 htop

