signature `(-,+,+,+)` `g(l,n) = −1`, `g(m,m̄) = 1`, all other pairings `0`; `m̄ = conj m`, `l`, `n` real; the dual
coframe `knDual = etaNull knTᵀ g` is a two-sided inverse (`knDual_mul_knT`, `knT_mul_knDual`), the inverse metric is
`knT etaNull knTᵀ = giKN` (componentwise `g^{μν} = −l^μn^ν − n^μl^ν + m^μm̄^ν + m̄^μm^ν`) and `g = knDualᵀ etaNull knDual`;
every component is `C^∞` (order `∞`) on `domReg`. -/

open Real
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN domReg domKN domReg_S domReg_D domReg_s)

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

-- keep real trigonometric functions real inside casts (`↑(cos θ)` stays a cast of `Real.cos`)
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

/-! ### Definitions -/

/-! ### Real building blocks (`l`, `n` real; `m = c (mRe + i mIm)` with `c = 1/(√2 q)`) -/

/-! ### Elementary facts about `q`, `q̄`, `c` -/

section Elementary
variable (a : ℝ) (x : Pt 4)

theorem qK_eq : qK a x = ((x 1 : ℝ) : ℂ) + Complex.I * ((a * cos (x 2) : ℝ) : ℂ) := by
  apply Complex.ext <;> simp [qK]

theorem qbarK_eq : qbarK a x = ((x 1 : ℝ) : ℂ) - Complex.I * ((a * cos (x 2) : ℝ) : ℂ) := by
  apply Complex.ext <;> simp [qbarK]

theorem qK_conj : conj (qK a x) = qbarK a x := by
  apply Complex.ext <;> simp [qK, qbarK]

/-- `q q̄ = Σ`. -/
theorem qK_mul_qbarK : qK a x * qbarK a x = ((Sig a (x 1) (x 2) : ℝ) : ℂ) := by
  have e : ((Sig a (x 1) (x 2) : ℝ) : ℂ) = ((x 1 : ℝ) : ℂ) ^ 2 + ((a * cos (x 2) : ℝ) : ℂ) ^ 2 := by
    simp only [Sig]; push_cast; ring
  rw [qK_eq, qbarK_eq, e]
  linear_combination (-(((a * cos (x 2) : ℝ) : ℂ) ^ 2)) * Complex.I_sq

variable {a x}

theorem qK_ne_zero (hS : Sig a (x 1) (x 2) ≠ 0) : qK a x ≠ 0 := by
  intro h; apply hS
  have := qK_mul_qbarK a x
  rw [h, zero_mul] at this
  exact_mod_cast this.symm

theorem qbarK_ne_zero (hS : Sig a (x 1) (x 2) ≠ 0) : qbarK a x ≠ 0 := by
  intro h; apply hS
  have := qK_mul_qbarK a x
  rw [h, mul_zero] at this
  exact_mod_cast this.symm

theorem sqrt2C_ne_zero : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := by
  exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 2)).ne'

theorem sqrt2C_mul_self : ((Real.sqrt 2 : ℝ) : ℂ) * ((Real.sqrt 2 : ℝ) : ℂ) = 2 := by
  rw [← Complex.ofReal_mul, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)]; norm_num

variable (a x)

theorem mFac_conj : conj (mFac a x) = 1 / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x) := by
  simp [mFac, qK_conj]

variable {a x}

/-- `c c̄ (2Σ) = 1`, i.e. `|1/(√2 q)|² = 1/(2Σ)`. -/
theorem mFac_mul_conj (hS : Sig a (x 1) (x 2) ≠ 0) :
    mFac a x * conj (mFac a x) * (2 * ((Sig a (x 1) (x 2) : ℝ) : ℂ)) = 1 := by
  rw [mFac_conj, mFac, ← qK_mul_qbarK]
  have h1 := qK_ne_zero hS; have h2 := qbarK_ne_zero hS
  have e : ((Real.sqrt 2 : ℝ) : ℂ) * qK a x * (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x) =
      2 * (qK a x * qbarK a x) := by linear_combination (qK a x * qbarK a x) * sqrt2C_mul_self
  rw [div_mul_div_comm, one_mul, e, one_div, inv_mul_cancel₀ (mul_ne_zero two_ne_zero (mul_ne_zero h1 h2))]

end Elementary

/-! ### Real/imaginary decomposition of the frame vectors -/

section Decomp
variable (M a Q : ℝ) (x : Pt 4)

theorem knL_eq : knL M a Q x = fun μ => ((lR M a Q x μ : ℝ) : ℂ) := by
  funext μ; fin_cases μ <;> simp [knL, lR]

theorem knN_eq : knN M a Q x = fun μ => ((nR M a Q x μ : ℝ) : ℂ) := by
  funext μ; fin_cases μ <;> simp [knN, nR]

theorem knM_eq : knM a x = fun μ =>
    mFac a x * ((mRe μ : ℝ) : ℂ) + (mFac a x * Complex.I) * ((mIm a x μ : ℝ) : ℂ) := by
  funext μ; fin_cases μ <;> simp [knM, mFac, mRe, mIm] <;> ring

theorem knMbar_eq : knMbar a x = fun μ =>
    conj (mFac a x) * ((mRe μ : ℝ) : ℂ) + (-(conj (mFac a x) * Complex.I)) * ((mIm a x μ : ℝ) : ℂ) := by
  rw [mFac_conj]
  funext μ; fin_cases μ <;> simp [knMbar, mRe, mIm] <;> ring

end Decomp

