set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS

/-! ## Reads -/

/-- Expressions reading only stacks below `56` are clean. -/
theorem clean_of_regs {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
  fun i hi => clean_of_lt (h i hi) i (by simp [Ex.regs])

/-! ## Elementary steps -/

section steps
variable (s : IState HS) (v : Vr) (c : Cs)

/-- Push onto a stack outside `rg`. -/
theorem sU {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (hR : Rd c e) (hc : e.Clean)
    (ho : okR v c e) {V B : ℕ} (hv : ∀ j ∈ e.regs, |tp v c j| ≤ V) (hm : mg V e < 2 ^ B) :
    Sp (.push i e) (encK s (RF v c)) (encK s (RF v (Function.update c i (ev v c e :: c i))))
      (cE e B) := by
  have h := Sp.pushQ s (RF v c) hi5 hc (ok_RF hR ho) (bnd_RF hR hv hm)
  rw [upd_RF_out hi, RF_out hi, eval_RF hR] at h
  exact h

end steps

