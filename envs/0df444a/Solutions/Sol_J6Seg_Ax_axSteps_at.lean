-- Source module: Solutions.J6SegAxis8
/-!
# B-line axis program (`AxisU6`), part 8: the kernel steps of axis `k`

* `stepC` (passes 2, 6): `kpass_ok` with the chunk kernel `KR.chunkK2_rowBody6` (B3) on
  `dT = 49`, the set-up `chunkRegs6` (B5), the chunk table bound (`TabAt`), the chunk output
  bound (`ChunkOutAt`) and the budget;
* `stepJ` (pass 4): `kpass_ok` with the `J` kernel `JK.jKer_row` (B4) on `dTJ = 33`, the set-up
  `jRegs6`, the `J` output bound (`ValAt`) and the budget.

Cost of each: `2 Cp + 2 C₀ Cc + Cc`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

section steps
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA dF : Fin HS}
  {ρ : Fin 19 → Fin HS} {eF eB eUp eDn e pM : Fin Pp}
  {P : Prm} {ap : AxPlan6} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} {C₀ Cp Cc : ℝ}

/-- **Pass 4** (the `J` kernel). -/
theorem stepJ {pc : ℕ → Fin Pp} (hMul : MulOK Isym tbl pM NLogN.KFUU.MS)
    (hJ : tbl e = JK.jKprog.code pM pc)
    (hFine : FineBody6 Isym tbl eF eB dF C₀) (hC0 : 0 ≤ C₀) (hR : RegOK ρ JK.dTJ dF)
    (hρA : ∀ i, ρ i ≠ dA) (hA0 : dA ≠ 0) (hTA : JK.dTJ ≠ dA)
    (hS : SetupBody6 Isym tbl eUp eDn ρ dA (descAx6 P n src D k) (jRegs6 P n src D k ap.pl) Cp)
    (hReg : AxReg P n src D k) (hV : ValAt P ap n src D k)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    PassOK Isym tbl (kpSt eUp eDn ρ JK.dTJ dF eF eB e) dA (descAx6 P n src D k)
      (fun L => L.length = axpre6 P n D k * (2 ^ axfJ6 P n src k * axpost6 P n D k) ∧
        GB (axwd6 P n src k ap) L ∧ ∀ b < axpre6 P n D k, ∀ c < axpost6 P n D k,
          axJPre6 P n src k ap (lineAt (2 ^ axfJ6 P n src k) (axpost6 P n D k) L b c))
      (gW6 P n src D k) (2 * Cp + (2 * C₀ * Cc + Cc)) := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have hMB : MulBnd NLogN.KFUU.MS (axkJ6 P n src k ap + 2) (mulSup (2 * (axkJ6 P n src k ap + 2))) :=
    fun a b ha hb => ⟨trivial, mulCostH_le_mulSup (by omega)⟩
  have hRow := JK.jKer_row (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
    (axw6 P n) (axα6 P n) (axw6 P n) (G := axG6 P n src k) (Xb := axXb6 P n src k ap)
    (Bc := axBc6 P n src k ap) hMul hMB hJ j0
  have H := kpass_ok hR hFine hRow (axwd6 P n src k ap) (axwd6 P n src k ap) (axfJ6 P n src k)
    (axpre6 P n D k) 1 (axpost6 P n D k) BkJ Lj hS hρA hA0 hTA j1 hReg.hp j3 j3 j4 j5
    j6 j7 j8 j9 j10 j11 j12 j2
    (fun q hq x hx _ => ⟨jker_len 0 x hx.1, hV.2 x hx⟩)
    (fun q hq => j13) (fun q hq => j14)
  rw [Nat.floor_natCast] at H
  have h1 := mul_le_mul_of_nonneg_left q2 hC0
  have H2 := H.mono (le_of_le_of_eq (add_le_add le_rfl (add_le_add (add_le_add h1 h1) q4))
    (show 2 * Cp + (C₀ * Cc + C₀ * Cc + Cc) = 2 * Cp + (2 * C₀ * Cc + Cc) by ring))
  simp only [Nat.mul_one, Nat.mod_one] at H2
  exact H2

end steps

end J6Seg.Ax

end

end

section
-- Source module: Solutions.J6SegAxis9
/-!
# B-line axis program (`AxisU6`), part 9: `AxStepsAt` from the components

**`axSteps_at`**: the nine steps of axis `k` (slab 1, chunk, copy, gather, `J`, scatter, chunk,
swap, output) with total cost `8 Cs + 6 Cp + (9 + 6 C₀) Cc`, from the step lemmas of parts 7 and
8, the copy / swap of `J6SegAxCopy` (S2), the array lengths (`arr_lens`) and the value bounds
(`ValAt`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab (passP drP rdP itO bkP)

theorem axSteps_at_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA dF : Fin HS}
    {ρ : Fin 19 → Fin HS} {eF eB eK eJK eC eCd eJ eJd pM : Fin Pp} {pc : ℕ → Fin Pp}
    {u1 d1 u3 d3 u5 d5 u7 d7 : IStmt HS Pp}
    {P : Prm} {ap : AxPlan6} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} {C₀ Cp Cs Cc : ℝ} (hk : k ≤ D)
    (hMul : MulOK Isym tbl pM NLogN.KFUU.MS) (hK : tbl eK = KR.chunkI2 pM)
    (hJ : tbl eJK = JK.jKprog.code pM pc)
    (hFine : FineBody6 Isym tbl eF eB dF C₀) (hC0 : 0 ≤ C₀)
    (hRC : RegOK ρ KR.dT dF) (hRJ : RegOK ρ JK.dTJ dF) (hρA : ∀ i, ρ i ≠ dA)
    (hfree : SlabFree dA) (hDA : AxC.DAok dA) (h49 : KR.dT ≠ dA) (h33 : JK.dTJ ≠ dA)
    (hSC : SetupBody6 Isym tbl eC eCd ρ dA (descAx6 P n src D k) (chunkRegs6 P n src D k ap.pl) Cp)
    (hSJ : SetupBody6 Isym tbl eJ eJd ρ dA (descAx6 P n src D k) (jRegs6 P n src D k ap.pl) Cp)
    (hS1 : SetupS Isym tbl u1 d1 ρS dA (descAx6 P n src D k) (slabV1 P n src D k) Cs)
    (hS3 : SetupS Isym tbl u3 d3 ρS dA (descAx6 P n src D k) (slabV3 P n src D k) Cs)
    (hS5 : SetupS Isym tbl u5 d5 ρS dA (descAx6 P n src D k) (slabV5 P n src D k) Cs)
    (hS7 : SetupS Isym tbl u7 d7 ρS dA (descAx6 P n src D k) (slabV7 P n src D k) Cs)
    (hReg : AxReg P n src D k) (hTab : TabAt P n src k) (hgC : ChunkOutAt P ap n src k)
    (hV : ValAt P ap n src D k) (hBud : AxBudgetAt P ap n src D k Cc) :
    AxStepsAt Isym tbl (slSt u1 d1 bodySc) (kpSt eC eCd ρ KR.dT dF eF eB eK) (AxC.copyRS dA).code
      (slSt u3 d3 bodyId) (kpSt eJ eJd ρ JK.dTJ dF eF eB eJK) (slSt u5 d5 bodyId)
      (kpSt eC eCd ρ KR.dT dF eF eB eK) (AxC.swapRS dA).code
      (slSt u7 d7 (passP drP rdP (itO pM) bkP)) dA P n src D k
      (8 * Cs + 6 * Cp + (9 + 6 * C₀) * Cc) := by
  obtain ⟨B, hDB, hwB, hcp, hsw⟩ := descB_of hBud
  have s1 := step1 hfree hReg hS1 hBud
  have s2 := stepC hMul hK hFine hC0 hRC hρA hfree.1 h49 hSC hReg hTab hgC hBud
  have sc := (AxC.copyAx_ok (Isym := Isym) (tbl := tbl) hDA P n src D k B (axwd6 P n src k ap)
    hk hDB hwB).mono hcp
  have s3 := step3 hfree hReg hS3 hBud
  have s4 := stepJ hMul hJ hFine hC0 hRJ hρA hfree.1 h33 hSJ hReg hV hBud
  have s5 := step5 hfree hReg hS5 hBud
  have ss := (AxC.swapAx_ok (Isym := Isym) (tbl := tbl) hDA P n src D k B (axwd6 P n src k ap)
    hk hDB hwB).mono hsw
  have s7 := step7 hMul hfree hReg hS7 hBud
  refine ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, s1, s2, sc, s3, s4, s5, s2, ss, s7,
    ?_, le_of_eq (by ring)⟩
  intro L hlen hgb
  have hX0 : (0 : ℤ) ≤ axX6 P n src k ap := by unfold axX6; positivity
  have hlenL : L.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) := by
    rw [hlen, ← pre_t_post P n D k hk, hReg.hN]; unfold axpre6 axt6 axpost6; ring
  have hprod : (List.ofFn (tD6 P n D)).prod =
      axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) := hlen.symm.trans hlenL
  obtain ⟨lS, lY, lJ, lW, lWp, lY2⟩ := arr_lens hReg L hlenL
  obtain ⟨gS, gY, gJ, gW, gWp, gY2, aS, aWp, jrows⟩ := hV.1 L hlen hgb
  have eC : axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) =
      axpre6 P n D k * axnc6 P n k * (2 ^ axfC6 P n * axpost6 P n D k) := by
    show _ = axpre6 P n D k * axnc6 P n k * (axl6 P n * axpost6 P n D k); ring
  refine ⟨⟨hlenL, bnd_of_GB hgb⟩, ⟨lS.trans eC, gS, fun b _ c _ => ⟨by simp [lineAt]; rfl,
    AB_lineAt hX0 aS _ _ _ _⟩⟩, ⟨rfl, lY.trans hprod.symm, gY⟩, ⟨lY, bnd_of_GB gY⟩,
    ⟨lJ, gJ, jrows⟩, ⟨lW, bnd_of_GB gW⟩,
    ⟨lWp.trans eC, gWp, fun b _ c _ => ⟨by simp [lineAt]; rfl, AB_lineAt hX0 aWp _ _ _ _⟩⟩,
    ⟨lY2.trans hprod.symm, lY.trans hprod.symm, gY2, gY⟩,
    ⟨lY, lY2, bnd_of_GB gY, bnd_of_GB gY2⟩⟩

end J6Seg.Ax

end

end

theorem solution : type_of% @J6Seg.Ax.axSteps_at_sol_aux := @J6Seg.Ax.axSteps_at_sol_aux
