set_option linter.unusedSimpArgs false

namespace Monod.Dev.Alg

/-! ### The positive cone: first non-trivial germ, read from `-∞` -/

/-- The right side of a point of `[-∞, ∞)`. -/
def RS : WithBot ℝ → Filter ℝ
  | Option.none => atBot
  | Option.some a => 𝓝[>] a

instance (p : WithBot ℝ) : (RS p).NeBot := by
  cases p with
  | bot => show (atBot : Filter ℝ).NeBot; infer_instance
  | coe a => show (𝓝[>] a).NeBot; infer_instance

/-- `u` is the identity left of `p` and moves points up just right of `p`. -/
def PosAt (u : ℝ ≃o ℝ) (p : WithBot ℝ) : Prop :=
  (∀ x : ℝ, (x : WithBot ℝ) < p → u x = x) ∧ ∀ᶠ x in RS p, x < u x

/-- The positive cone. -/
def Pos (u : ℝ ≃o ℝ) : Prop := ∃ p : WithBot ℝ, PosAt u p

lemma tendsto_RS {u : ℝ ≃o ℝ} {p : WithBot ℝ}
    (hleft : ∀ x : ℝ, (x : WithBot ℝ) < p → u x = x) : Tendsto u (RS p) (RS p) := by
  cases p with
  | bot => exact u.tendsto_atBot
  | coe a =>
    have hl : ∀ᶠ x in 𝓝[<] a, u x = x :=
      eventually_nhdsWithin_of_forall fun x hx => hleft x (WithBot.coe_lt_coe.2 hx)
    have ha : u a = a := by
      have h1 : Tendsto u (𝓝[<] a) (𝓝 (u a)) :=
        (u.continuous.tendsto a).mono_left nhdsWithin_le_nhds
      have h2 : Tendsto u (𝓝[<] a) (𝓝 a) :=
        (tendsto_nhdsWithin_of_tendsto_nhds tendsto_id).congr' (hl.mono fun x hx => hx.symm)
      exact tendsto_nhds_unique h1 h2
    show Tendsto u (𝓝[>] a) (𝓝[>] a)
    apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
    · have := u.continuous.tendsto a
      rw [ha] at this
      exact this.mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with y (hy : a < y)
      show a < u y
      rw [← ha]; exact u.strictMono hy

lemma eventually_lt_of_lt {p q : WithBot ℝ} (h : p < q) :
    ∀ᶠ x : ℝ in RS p, (x : WithBot ℝ) < q := by
  cases q with
  | bot => exact absurd h (not_lt_bot)
  | coe b =>
    cases p with
    | bot =>
      filter_upwards [eventually_lt_atBot b] with x hx
      exact WithBot.coe_lt_coe.2 hx
    | coe a =>
      have hab : a < b := WithBot.coe_lt_coe.1 h
      filter_upwards [nhdsWithin_le_nhds (eventually_lt_nhds hab)] with x hx
      exact WithBot.coe_lt_coe.2 hx

lemma pos_mul {u v : ℝ ≃o ℝ} (hu : Pos u) (hv : Pos v) : Pos (u * v) := by
  obtain ⟨p, hpl, hpr⟩ := hu
  obtain ⟨q, hql, hqr⟩ := hv
  rcases lt_trichotomy p q with h | rfl | h
  · refine ⟨p, fun x hx => ?_, ?_⟩
    · show u (v x) = x
      rw [hql x (hx.trans h), hpl x hx]
    · filter_upwards [hpr, eventually_lt_of_lt h] with x h1 h2
      show x < u (v x)
      rw [hql x h2]; exact h1
  · refine ⟨p, fun x hx => ?_, ?_⟩
    · show u (v x) = x
      rw [hql x hx, hpl x hx]
    · filter_upwards [hqr, (tendsto_RS hql).eventually hpr] with x h1 h2
      exact h1.trans h2
  · refine ⟨q, fun x hx => ?_, ?_⟩
    · show u (v x) = x
      rw [hql x hx, hpl x (hx.trans h)]
    · filter_upwards [hqr, (tendsto_RS hql).eventually (eventually_lt_of_lt h)] with x h1 h2
      show x < u (v x)
      rw [hpl _ h2]; exact h1

lemma not_pos_one : ¬ Pos (1 : ℝ ≃o ℝ) := by
  rintro ⟨p, -, hp⟩
  obtain ⟨x, hx⟩ := hp.exists
  exact lt_irrefl x hx

lemma pos_conj {u : ℝ ≃o ℝ} (hu : Pos u) (c : ℝ ≃o ℝ) : Pos (c⁻¹ * u * c) := by
  obtain ⟨p, hpl, hpr⟩ := hu
  have key : ∀ x : ℝ, c x < u (c x) → x < (c⁻¹ * u * c) x := by
    intro x hx
    have := (c⁻¹ : ℝ ≃o ℝ).strictMono hx
    rwa [RelIso.inv_apply_self] at this
  cases p with
  | bot =>
    refine ⟨⊥, fun x hx => absurd hx not_lt_bot, ?_⟩
    have ht : Tendsto c atBot atBot := c.tendsto_atBot
    filter_upwards [ht.eventually hpr] with x hx
    exact key x hx
  | coe a =>
    refine ⟨((c⁻¹ a : ℝ) : WithBot ℝ), fun x hx => ?_, ?_⟩
    · have h1 : c x < a := by
        have := c.strictMono (WithBot.coe_lt_coe.1 hx)
        rwa [RelIso.apply_inv_self] at this
      show c⁻¹ (u (c x)) = x
      rw [hpl _ (WithBot.coe_lt_coe.2 h1), RelIso.inv_apply_self]
    · have ht : Tendsto c (𝓝[>] (c⁻¹ a)) (𝓝[>] a) := by
        apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
        · have := c.continuous.tendsto (c⁻¹ a)
          rw [RelIso.apply_inv_self] at this
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with y (hy : c⁻¹ a < y)
          have := c.strictMono hy
          rw [RelIso.apply_inv_self] at this
          exact this
      show ∀ᶠ x in 𝓝[>] (c⁻¹ a), x < (c⁻¹ * u * c) x
      filter_upwards [ht.eventually hpr] with x hx
      exact key x hx

/-! ### Totality for elements of `H` -/

lemma goodSide_RS (p : WithBot ℝ) : GoodSide (RS p) := by
  cases p with
  | bot => exact goodSide_atBot
  | coe a => exact goodSide_nhdsGT a

lemma sign_const {u : ℝ ≃o ℝ} {I : Set ℝ} (hI : IsPreconnected I) (hne : ∀ y ∈ I, u y ≠ y) :
    (∀ y ∈ I, y < u y) ∨ ∀ y ∈ I, u y < y := by
  by_contra hcon
  push Not at hcon
  obtain ⟨⟨y₁, hy₁, h₁⟩, ⟨y₂, hy₂, h₂⟩⟩ := hcon
  have h₁' : u y₁ - y₁ < 0 := by
    have := lt_of_le_of_ne h₁ (hne y₁ hy₁); linarith
  have h₂' : 0 < u y₂ - y₂ := by
    have := lt_of_le_of_ne h₂ (Ne.symm (hne y₂ hy₂)); linarith
  have hcont : ContinuousOn (fun y => u y - y) I :=
    (u.continuous.sub continuous_id).continuousOn
  obtain ⟨y, hy, hy0⟩ := hI.intermediate_value hy₁ hy₂ hcont ⟨h₁'.le, h₂'.le⟩
  exact hne y hy (by simp only at hy0; linarith)

lemma pos_or_pos_inv {h : H ⊤} (hne : h ≠ 1) : Pos (ψ h) ∨ Pos (ψ h)⁻¹ := by
  classical
  set u := ψ h
  have hu1 : u ≠ 1 := fun e => hne (ψ_injective (by rw [map_one]; exact e))
  set S : Set ℝ := {x | u x ≠ x}
  have hSne : S.Nonempty := by
    by_contra hcon
    rw [Set.not_nonempty_iff_eq_empty] at hcon
    apply hu1
    ext x
    by_contra hx
    have : x ∈ S := hx
    rw [hcon] at this; exact this
  -- the key point
  obtain ⟨p, hleft, hfreq⟩ : ∃ p : WithBot ℝ, (∀ x : ℝ, (x : WithBot ℝ) < p → u x = x) ∧
      ¬ ∀ᶠ x in RS p, u x = x := by
    by_cases hb : BddBelow S
    · refine ⟨((sInf S : ℝ) : WithBot ℝ), fun x hx => ?_, ?_⟩
      · by_contra hux
        exact absurd (csInf_le hb hux) (not_le.2 (WithBot.coe_lt_coe.1 hx))
      · intro hev
        have hl : ∀ᶠ x in 𝓝[<] (sInf S), u x = x :=
          eventually_nhdsWithin_of_forall fun x (hx : x < sInf S) => by
            by_contra hux
            exact absurd (csInf_le hb hux) (not_le.2 hx)
        have ha : u (sInf S) = sInf S := by
          have h1 : Tendsto u (𝓝[<] (sInf S)) (𝓝 (u (sInf S))) :=
            (u.continuous.tendsto _).mono_left nhdsWithin_le_nhds
          have h2 : Tendsto u (𝓝[<] (sInf S)) (𝓝 (sInf S)) :=
            (tendsto_nhdsWithin_of_tendsto_nhds tendsto_id).congr'
              (hl.mono fun x hx => hx.symm)
          exact tendsto_nhds_unique h1 h2
        have hev' : ∀ᶠ x in 𝓝 (sInf S), u x = x := by
          rw [← nhdsLE_sup_nhdsGT, Filter.eventually_sup]
          refine ⟨eventually_nhdsWithin_of_forall fun x (hx : x ≤ sInf S) => ?_, hev⟩
          rcases hx.lt_or_eq with hx | rfl
          · by_contra hux
            exact absurd (csInf_le hb hux) (not_le.2 hx)
          · exact ha
        obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hev'
        have : sInf S + ε ≤ sInf S := by
          apply le_csInf hSne
          intro s hs
          by_contra hlt
          push Not at hlt
          have hs1 : sInf S ≤ s := csInf_le hb hs
          apply hs
          apply hball
          rw [Real.dist_eq, abs_lt]
          constructor <;> linarith
        linarith
    · refine ⟨⊥, fun x hx => absurd hx not_lt_bot, ?_⟩
      intro hev
      obtain ⟨M, hM⟩ := Filter.eventually_atBot.1 hev
      apply hb
      refine ⟨M, fun s hs => ?_⟩
      by_contra hlt
      exact hs (hM s (le_of_lt (not_le.1 hlt)))
  -- the germ on the right of the key point
  obtain ⟨B, -, hloc⟩ := mem_H_top_pw h.2
  have hgs := goodSide_RS p
  obtain ⟨k, hk⟩ := germ_side (Finset.finite_toSet B) (locMob_of_isPiecewiseProjOn hloc) hgs
  have hfixiff : ∀ᶠ y in RS p, (u y = y ↔ mob k y = y) := by
    filter_upwards [hk] with y hy
    rw [← hy, ← coe_ψ]
    exact ⟨fun e => by rw [e], fun e => OnePoint.coe_injective e⟩
  have hmove : ∀ᶠ y in RS p, u y ≠ y := by
    by_cases hfin : {y : ℝ | mob k y = y}.Finite
    · filter_upwards [hfixiff, hgs.2.1 hfin.compl_mem_cofinite] with y h1 h2
      rw [Ne, h1]; exact h2
    · exfalso
      apply hfreq
      have hid : mob k = mob (1 : SpecialLinearGroup (Fin 2) (⊤ : Subring ℝ)) :=
        mob_eq_of_infinite k 1 hfin (fun x hx => by rw [mob_one]; exact hx)
      filter_upwards [hfixiff] with y hy
      rw [hy, hid, mob_one]
  obtain ⟨I, -, hIc, hIs, hIm⟩ := hgs.2.2 _ hmove
  rcases sign_const hIc hIm with hpos | hneg
  · exact Or.inl ⟨p, hleft, Filter.mem_of_superset hIs hpos⟩
  · refine Or.inr ⟨p, fun x hx => ?_, Filter.mem_of_superset hIs fun y hy => ?_⟩
    · have := hleft x hx
      conv_lhs => rw [← this]
      exact RelIso.inv_apply_self u x
    · have h1 := (u⁻¹ : ℝ ≃o ℝ).strictMono (hneg y hy)
      rwa [RelIso.inv_apply_self] at h1

/-! ### The bi-invariant order -/

/-- Positive elements of `H`. -/
def PosH (x : H ⊤) : Prop := Pos (ψ x)

lemma posH_mul {x y : H ⊤} (hx : PosH x) (hy : PosH y) : PosH (x * y) := by
  unfold PosH; rw [map_mul]; exact pos_mul hx hy

lemma not_posH_and_inv {x : H ⊤} (h1 : PosH x) (h2 : PosH x⁻¹) : False := by
  have := posH_mul h1 h2
  rw [mul_inv_cancel] at this
  unfold PosH at this; rw [map_one] at this
  exact not_pos_one this

lemma posH_conj {x : H ⊤} (hx : PosH x) (c : H ⊤) : PosH (c⁻¹ * x * c) := by
  unfold PosH; rw [map_mul, map_mul, map_inv]; exact pos_conj hx _

set_option warn.classDefReducibility false in
/-- The bi-invariant order on `H`. -/
noncomputable def biOrder : LinearOrder (H ⊤) where
  le a b := a = b ∨ PosH (a⁻¹ * b)
  le_refl a := Or.inl rfl
  le_trans a b c hab hbc := by
    rcases hab with rfl | hab
    · exact hbc
    rcases hbc with rfl | hbc
    · exact Or.inr hab
    right
    have := posH_mul hab hbc
    rwa [show a⁻¹ * b * (b⁻¹ * c) = a⁻¹ * c by group] at this
  le_antisymm a b hab hba := by
    rcases hab with rfl | hab
    · rfl
    rcases hba with e | hba
    · exact e.symm
    exfalso
    apply not_posH_and_inv hab
    rwa [show (a⁻¹ * b)⁻¹ = b⁻¹ * a by group]
  le_total a b := by
    by_cases h : a⁻¹ * b = 1
    · left; left; rw [← mul_inv_cancel_left a b, h, mul_one]
    rcases pos_or_pos_inv h with h1 | h1
    · left; right; exact h1
    · right; right
      show PosH (b⁻¹ * a)
      unfold PosH
      rwa [show b⁻¹ * a = (a⁻¹ * b)⁻¹ by group, map_inv]
  toDecidableLE := Classical.decRel _

lemma biOrder_le_iff (a b : H ⊤) : biOrder.le a b ↔ a = b ∨ PosH (a⁻¹ * b) := Iff.rfl

lemma biOrder_inv (a b c : H ⊤) (h : biOrder.le a b) :
    biOrder.le (c * a) (c * b) ∧ biOrder.le (a * c) (b * c) := by
  rw [biOrder_le_iff] at *
  rcases h with rfl | h
  · exact ⟨Or.inl rfl, Or.inl rfl⟩
  refine ⟨Or.inr ?_, Or.inr ?_⟩
  · rwa [show (c * a)⁻¹ * (c * b) = a⁻¹ * b by group]
  · rw [show (a * c)⁻¹ * (b * c) = c⁻¹ * (a⁻¹ * b) * c by group]
    exact posH_conj h c

theorem exists_biInvariant_linearOrder_Hpp' :
    (∃ r : LinearOrder (H ⊤), ∀ a b c : H ⊤, r.le a b → r.le (c * a) (c * b) ∧ r.le (a * c) (b * c)) ∧
      ∀ K : Subgroup (H ⊤), ∃ r : LinearOrder K,
        ∀ a b c : K, r.le a b → r.le (c * a) (c * b) ∧ r.le (a * c) (b * c) := by
  refine ⟨⟨biOrder, biOrder_inv⟩, fun K => ?_⟩
  letI : LinearOrder (H ⊤) := biOrder
  refine ⟨LinearOrder.lift' (fun x : K => (x : H ⊤)) Subtype.val_injective, fun a b c h => ?_⟩
  exact biOrder_inv (a : H ⊤) b c h

end Monod.Dev.Alg
end

section
/-!
# Monod's `G` and `H` are `G ⊤` and `H ⊤`

Every point of `P¹` is fixed by a hyperbolic element of `SL(2, ℝ)`, so `P ⊤ = univ`, and
"breakpoints in `P ⊤`" is the same as "breakpoints anywhere".
-/

open Filter Topology OnePoint Matrix

namespace Monod.Dev.Gpp

open Monod Monod.Dev.Alg

end Monod.Dev.Gpp
end

open Monod in
theorem solution :
    (∃ r : LinearOrder Hpp, ∀ a b c : Hpp, r.le a b → r.le (c * a) (c * b) ∧ r.le (a * c) (b * c)) ∧
      ∀ K : Subgroup Hpp, ∃ r : LinearOrder K,
        ∀ a b c : K, r.le a b → r.le (c * a) (c * b) ∧ r.le (a * c) (b * c) := by
  rw [Gpp_eq_G_top_and_Hpp_eq_H_top.2]
  exact Dev.Alg.exists_biInvariant_linearOrder_Hpp' ..
