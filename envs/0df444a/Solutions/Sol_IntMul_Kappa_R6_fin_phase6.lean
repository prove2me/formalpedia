section
-- Source module: Solutions.KFMChain2
/-!
# KFM: chain facts needed before the later calls

`source_call` and `final_call3` conclude from all three call results at once. The assembly needs
some of their conclusions earlier, as preconditions of the next call:

* **`w_small`**: `‖w‖ ≤ 6/10` from the `A`-lines output alone (precondition of the chirp call).
* **`QA_small`**: `‖Q_p(UV)‖ ≤ 1/2` and `Grid` from `U`, `V` alone (precondition of the third
  source transform).
* **`tdiv_round`**: the IL rounding `(X + 2^{p−1}).tdiv 2^p` recovers an integer `c ≥ 0` with
  `|X/2^p − c| < 1/2`.
-/

namespace NLogN.KFM

open Complex IntMul.OpenAI.RT IntMul.OpenAI.RC NLogN.KFZ

noncomputable section

variable {D : ℕ}

/-- **IL rounding recovers the integer.** -/
theorem tdiv_round (p : ℕ) (hp : 1 ≤ p) (X c : ℤ) (hc : 0 ≤ c)
    (h : |(X : ℝ) / 2 ^ p - c| < 1 / 2) : (X + 2 ^ (p - 1)).tdiv (2 ^ p) = c := by
  have hq : (2 : ℤ) ^ p = 2 * 2 ^ (p - 1) := by
    rw [← pow_succ']; congr 1; omega
  have hq0 : (0 : ℝ) < 2 ^ p := by positivity
  have h1 : |(X : ℝ) - c * 2 ^ p| < 2 ^ p / 2 := by
    have e : (X : ℝ) - c * 2 ^ p = 2 ^ p * ((X : ℝ) / 2 ^ p - c) := by field_simp
    rw [e, abs_mul, abs_of_pos hq0]
    calc 2 ^ p * |(X : ℝ) / 2 ^ p - c| < 2 ^ p * (1 / 2) := mul_lt_mul_of_pos_left h hq0
      _ = 2 ^ p / 2 := by ring
  rw [abs_lt] at h1
  have hq' : ((2 : ℤ) ^ p : ℝ) = 2 * ((2 : ℤ) ^ (p - 1) : ℝ) := by exact_mod_cast hq
  push_cast at hq'
  rw [hq'] at h1
  obtain ⟨h1a, h1b⟩ := h1
  have a1 : c * 2 ^ p - 2 ^ (p - 1) < X := by
    have : ((c * 2 ^ p - 2 ^ (p - 1) : ℤ) : ℝ) < X := by push_cast; rw [hq']; linarith
    exact_mod_cast this
  have a2 : X < c * 2 ^ p + 2 ^ (p - 1) := by
    have : (X : ℝ) < ((c * 2 ^ p + 2 ^ (p - 1) : ℤ) : ℝ) := by push_cast; rw [hq']; linarith
    exact_mod_cast this
  have hpos : (0 : ℤ) < 2 ^ (p - 1) := by positivity
  have hcq : 0 ≤ c * 2 ^ p := mul_nonneg hc (by positivity)
  have hnn : 0 ≤ X + 2 ^ (p - 1) := by linarith
  rw [Int.tdiv_eq_ediv_of_nonneg hnn]
  have hu := (Int.ediv_emod_unique (a := X + 2 ^ (p - 1)) (b := 2 ^ p) (q := c)
    (r := X + 2 ^ (p - 1) - 2 ^ p * c) (by positivity)).2 ⟨by ring, by linarith, by linarith⟩
  exact hu.1

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFUPhiMath
/-!
# KFU §10: what `Φ` and `Φ⁻¹` compute (against `RCRT.upd`)

For a valid address `b` of `S_r` (`shR (sP)`), viewed as the function `fnL b j = b_j`:

* `fn_gRotF`: the forward step `gRot (csF) i` is `RCRT.updInv i` (subtract `μ_i Σ_{j<i} b_j P_j`),
* `fn_gRotB`: the inverse step `gRot (csB) i` is `RCRT.upd i`,

so `Gf d` undoes the `RCRT` shift chain `foldr upd (range d)` and `Gb d` is that chain.  With
`(42)` (`RCRT.coord_formula`) the shift chain sends the digit address of `k < P_d` to
`Φ(k) = (μ_j k mod s_j)_j`.  End results (`phiAddr k c = [μ_0 k mod s_0, …, μ_{d-1} k mod s_{d-1}, c]`):

* `PhiD_at`: `(PhiD xs)[enc_{T_r} (phiAddr k c)] = xs[2k + c]`,
* `PhiD_zero`: `PhiD xs` is `0` at every `T_r`-address that is not an `S_r`-address,
* `PhiInvD_at`: `(PhiInvD ys)[2k + c] = ys[enc_{T_r} (phiAddr k c)]`.

Hypotheses: `0 < s_j` and `μ_j P_j ≡ 1 (mod s_j)` for `j < d`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

theorem fnL_inj {a b : List ℕ} (hl : a.length = b.length) (h : fnL a = fnL b) : a = b := by
  apply List.ext_getElem hl
  intro j h1 h2
  have := congrFun h j
  simp only [fnL] at this
  rwa [List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2] at this

theorem fnL_rotG (n Q : ℕ) (f : List ℕ → ℕ) (b : List ℕ) (hn : n < b.length) :
    fnL (rotG n Q f b) = Function.update (fnL b) n ((b.getD n 0 + Q - f (b.take n)) % Q) := by
  have e : rotG n Q f b = b.set n ((b.getD n 0 + Q - f (b.take n)) % Q) := by
    rw [List.set_eq_take_append_cons_drop, if_pos hn]; rfl
  rw [e]
  funext j
  simp only [fnL]
  by_cases hj : j = n
  · subst hj; simp [List.getD_eq_getElem?_getD, List.getElem?_set, hn]
  · rw [Function.update_of_ne hj]
    simp only [fnL]
    simp [List.getD_eq_getElem?_getD, List.getElem?_set, Ne.symm hj]

theorem shR_range (d : ℕ) (f : ℕ → ℕ) : shR d f = (List.range (d + 1)).map f := by
  simp [shR, List.range_succ]

theorem valid_shR_lt {d : ℕ} {f : ℕ → ℕ} {b : List ℕ} (hb : Valid (shR d f) b) :
    b.length = d + 1 ∧ ∀ j < d + 1, fnL b j < f j := by
  rw [shR_range] at hb
  obtain ⟨hl, hlt⟩ := (valid_iff _ _).1 hb
  simp only [List.length_map, List.length_range] at hl
  refine ⟨hl, fun j hj => ?_⟩
  have := hlt j (by omega) (by simpa using hj)
  simp only [List.getElem_map, List.getElem_range] at this
  simp only [fnL]; rwa [List.getD_eq_getElem _ _ (by omega)]

theorem valid_shR_of {d : ℕ} {f : ℕ → ℕ} {b : List ℕ} (hl : b.length = d + 1)
    (h : ∀ j < d + 1, fnL b j < f j) : Valid (shR d f) b := by
  rw [shR_range]
  refine (valid_iff _ _).2 ⟨by simpa using hl, fun j h1 h2 => ?_⟩
  have := h j (by omega)
  simp only [fnL] at this
  rw [List.getD_eq_getElem _ _ h1] at this
  simpa using this

section Shift

variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem lf_cast (cs b : List ℕ) (i : ℕ) (hcs : cs.length = i) (hb : i ≤ b.length) (s : ℕ) :
    ((KIL.lf cs (b.take i) : ℕ) : ZMod s) =
      ∑ k ∈ Finset.range i, ((cs.getD k 0 : ℕ) : ZMod s) * (fnL b k : ZMod s) := by
  rw [KIL.lf_eq_sum _ _ (by simp; omega), hcs]
  push_cast
  refine Finset.sum_congr rfl fun k hk => ?_
  simp only [Finset.mem_range] at hk
  congr 2
  simp only [fnL, List.getD_eq_getElem?_getD, List.getElem?_take, if_pos hk]

theorem csB_getD (i k : ℕ) (hk : k < i) :
    (csB sF μ i).getD k 0 = (sF i - μ i * OpenAI.RCRT.Ppre sF k % sF i) % sF i := by
  simp [csB, List.getD_eq_getElem?_getD, hk]

theorem offset_cast (x : ℕ → ℕ) (i s : ℕ) :
    ((OpenAI.RCRT.offset sF μ x i : ℕ) : ZMod s) =
      ∑ k ∈ Finset.range i, ((μ i * OpenAI.RCRT.Ppre sF k : ℕ) : ZMod s) * (x k : ZMod s) := by
  unfold OpenAI.RCRT.offset
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  ring

theorem validUpTo_of (_hs : ∀ j < d, 1 ≤ sF j) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b)
    {i : ℕ} (hi : i < d) : OpenAI.RCRT.validUpTo sF (fnL b) i := by
  intro j hj
  have := (valid_shR_lt hb).2 j (by omega)
  simpa [sP, show j < d by omega] using this

/-- The inverse step is `RCRT.upd`. -/
theorem fn_gRotB (hs : ∀ j < d, 1 ≤ sF j) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b)
    {i : ℕ} (hi : i < d) :
    fnL (gRot sF (csB sF μ) i b) = OpenAI.RCRT.upd sF μ i (fnL b) := by
  have hl := (valid_shR_lt hb).1
  unfold gRot
  rw [fnL_rotG _ _ _ _ (by omega)]
  unfold OpenAI.RCRT.upd
  rw [if_pos (validUpTo_of hs hb hi)]
  congr 1
  have hsi := hs i hi
  set s := sF i
  set f := KIL.lf (csB sF μ i) (b.take i) % s
  set o := OpenAI.RCRT.offset sF μ (fnL b) i
  have hf : f ≤ s := (Nat.mod_lt _ (by omega)).le
  rw [Nat.add_sub_assoc hf]
  apply (ZMod.natCast_eq_natCast_iff' _ _ s).1
  have hL := lf_cast (csB sF μ i) b i (by simp [csB]) (by omega) s
  push_cast [Nat.cast_sub hf]
  simp only [f, o, ZMod.natCast_mod, ZMod.natCast_self, hL, offset_cast]
  have : ∀ k ∈ Finset.range i, ((((csB sF μ i).getD k 0 : ℕ) : ZMod s)) * (fnL b k : ZMod s) =
      -(((μ i * OpenAI.RCRT.Ppre sF k : ℕ) : ZMod s) * (fnL b k : ZMod s)) := by
    intro k hk
    have hm : μ i * OpenAI.RCRT.Ppre sF k % s ≤ s := (Nat.mod_lt _ (by omega)).le
    rw [csB_getD i k (by simpa using hk), ZMod.natCast_mod, Nat.cast_sub hm, ZMod.natCast_mod,
      ZMod.natCast_self]
    ring
  rw [Finset.sum_congr rfl this, Finset.sum_neg_distrib]
  simp only [fnL]
  ring

theorem fn_Gb (hs : ∀ j < d, 1 ≤ sF j) :
    ∀ k ≤ d, ∀ b, Valid (shR d (sP d sF)) b →
      fnL (Gb sF (csB sF μ) k b) = (List.range k).foldr (OpenAI.RCRT.upd sF μ) (fnL b)
  | 0, _, b, _ => rfl
  | k + 1, hk, b, hb => by
    simp only [Gb, Function.comp_apply]
    rw [fn_Gb hs k (by omega) _ (valid_gRot d sF hs _ (by omega) hb), fn_gRotB hs hb (by omega),
      List.range_succ, List.foldr_append]
    rfl

end Shift

/-! ## Digit addresses and `Φ`-addresses -/

theorem fnL_app (d : ℕ) (g : ℕ → ℕ) (c j : ℕ) :
    fnL ((List.range d).map g ++ [c]) j = if j < d then g j else if j = d then c else 0 := by
  simp only [fnL, List.getD_eq_getElem?_getD]
  by_cases h1 : j < d
  · rw [List.getElem?_append_left (by simpa using h1)]; simp [h1]
  · rw [List.getElem?_append_right (by simpa using h1)]
    simp only [List.length_map, List.length_range, if_neg h1]
    by_cases h2 : j = d
    · subst h2; simp
    · rw [if_neg h2]
      have : 1 ≤ j - d := by omega
      rw [List.getElem?_eq_none (by simpa using this)]; rfl

theorem valid_digAddr {d : ℕ} {sF : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j) (k : ℕ) {c : ℕ} (hc : c < 2) :
    Valid (shR d (sP d sF)) (digAddr d sF k c) := by
  refine valid_shR_of (by simp [digAddr]) fun j hj => ?_
  unfold digAddr; rw [fnL_app]
  by_cases h1 : j < d
  · simp only [if_pos h1, sP]; exact Nat.mod_lt _ (hs j h1)
  · rw [if_neg h1, if_pos (by omega)]; simp [sP, show j = d by omega, hc]

theorem valid_phiAddr {d : ℕ} {sF : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j) (μ : ℕ → ℕ) (k : ℕ) {c : ℕ}
    (hc : c < 2) : Valid (shR d (sP d sF)) (phiAddr d sF μ k c) := by
  refine valid_shR_of (by simp [phiAddr]) fun j hj => ?_
  unfold phiAddr; rw [fnL_app]
  by_cases h1 : j < d
  · simp only [if_pos h1, sP]; exact Nat.mod_lt _ (hs j h1)
  · rw [if_neg h1, if_pos (by omega)]; simp [sP, show j = d by omega, hc]

/-- **(42)**: the `RCRT` shift chain sends the digit address to the `Φ`-address. -/
theorem foldr_digAddr {d : ℕ} {sF μ : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (k c : ℕ) :
    (List.range d).foldr (OpenAI.RCRT.upd sF μ) (fnL (digAddr d sF k c)) =
      fnL (phiAddr d sF μ k c) := by
  have ha : ∀ j < d, fnL (digAddr d sF k c) j < sF j := by
    intro j hj; unfold digAddr; rw [fnL_app, if_pos hj]; exact Nat.mod_lt _ (hs j hj)
  rw [OpenAI.RCRT.shifts_realize sF μ d _ ha]
  funext j
  by_cases hj : j < d
  · rw [if_pos hj]
    unfold phiAddr; rw [fnL_app, if_pos hj]
    have hoff : OpenAI.RCRT.offset sF μ (fnL (digAddr d sF k c)) j =
        μ j * ∑ i ∈ Finset.range j, OpenAI.RCRT.digit sF k i * OpenAI.RCRT.Ppre sF i := by
      unfold OpenAI.RCRT.offset
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      simp only [Finset.mem_range] at hi
      unfold digAddr; rw [fnL_app, if_pos (by omega)]
    rw [hoff]
    unfold digAddr; rw [fnL_app, if_pos hj]
    have := OpenAI.RCRT.coord_formula sF μ j k (hμ j hj)
    rw [ZMod.natCast_eq_natCast_iff'] at this
    exact this.symm
  · rw [if_neg hj]
    unfold digAddr phiAddr; rw [fnL_app, fnL_app, if_neg hj, if_neg hj]

/-! ## Encoding the k-order address -/

theorem encode_rev (s x : ℕ → ℕ) : ∀ n,
    encode ((List.range n).map s).reverse ((List.range n).map x).reverse =
      ∑ j ∈ Finset.range n, x j * OpenAI.RCRT.Ppre s j
  | 0 => by simp [encode]
  | n + 1 => by
    rw [List.range_succ, List.map_append, List.map_append, List.reverse_append,
      List.reverse_append]
    simp only [List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil, List.nil_append]
    rw [List.singleton_append, List.singleton_append]
    simp only [encode, List.headD_cons, List.tail_cons]
    rw [encode_rev s x n, Finset.sum_range_succ]
    have : vol ((List.range n).map s).reverse = OpenAI.RCRT.Ppre s n := by
      rw [vol, List.prod_reverse, ← vol, vol_rangeMap]; rfl
    rw [this]; ring

theorem revH_digAddr (d : ℕ) (sF : ℕ → ℕ) (k c : ℕ) :
    revH d (digAddr d sF k c) = ((List.range d).map (OpenAI.RCRT.digit sF k)).reverse ++ [c] := by
  unfold revH digAddr
  rw [List.take_append_of_le_length (by simp), List.take_of_length_le (by simp),
    List.drop_append_of_le_length (by simp), List.drop_of_length_le (by simp)]
  simp

theorem encode_digAddr {d : ℕ} {sF : ℕ → ℕ} (_hs : ∀ j < d, 1 ≤ sF j) (k c : ℕ)
    (hk : k < OpenAI.RCRT.Ppre sF d) :
    encode (shK d (sP d sF)) (revH d (digAddr d sF k c)) = 2 * k + c := by
  rw [revH_digAddr, shK_eq_app, encode_append_len _ _ (by simp)]
  have e : (List.range d).map (sP d sF) = (List.range d).map sF :=
    List.map_congr_left fun j hj => by simp [sP, List.mem_range.1 hj]
  rw [e, encode_rev, ← OpenAI.RCRT.mixed_radix sF k d hk]
  simp [encode, vol, sP]; ring

theorem revH_revH {d : ℕ} {a : List ℕ} (h : d ≤ a.length) : revH d (revH d a) = a := by
  unfold revH
  have hl : ((a.take d).reverse).length = d := by simp; omega
  rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega),
    List.drop_append_of_le_length (by omega), List.drop_of_length_le (by omega),
    List.reverse_reverse, List.nil_append, List.take_append_drop]

/-! ## Pointwise results -/

theorem getD_pull {S S' : Shape} (g : List ℕ → List ℕ) (xs : List ℤ) {j : ℕ} (hj : j < vol S') :
    (pull S S' g 0 xs).getD j 0 = xs.getD (encode S (g (decode S' j))) 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa using hj), getElem_pull]

theorem Gb_digAddr {d : ℕ} {sF μ : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (k : ℕ) {c : ℕ}
    (hc : c < 2) : Gb sF (csB sF μ) d (digAddr d sF k c) = phiAddr d sF μ k c := by
  have hv := valid_digAddr hs k hc
  apply fnL_inj
  · rw [(valid_shR_lt (valid_Gb d sF hs _ d le_rfl _ hv)).1]; simp [phiAddr]
  · rw [fn_Gb hs d le_rfl _ hv, foldr_digAddr hs hμ k c]

end NLogN.KFU

end

section
-- Source module: Solutions.KFU2Cover
/-!
# KFU2 §1: coverage of the `Φ`-addresses and whole-array denotations

Hypotheses (`RCRT` side): `1 ≤ s_j`, pairwise coprime `s_j` (`j < d`), `μ_j P_j ≡ 1 (mod s_j)`.

* `cover`: every valid `S_r`-address `b` is `phiAddr (kOf b) (b_d)` with `kOf b < P_d`
  (CRT via `RCRT.PhiEquiv`).
* `phiAddr_eq_Phi`: the first `d` coordinates of `phiAddr k c` are the `RCRT.Phi` residues of `k`.
* **`PhiD_eq`**: `PhiD xs` at padded address `b` is `xs[2·kOf b + b_d]` if `b` is a source
  address, `0` otherwise (`RCRT` `Φ` on whole arrays, zero padded).
* **`PhiInvD_eq`**: `(PhiInvD ys)[m] = ys[enc_{T_r} (phiAddr (m/2) (m%2))]` (`Φ⁻¹` on whole arrays).
* **`PhiInvD_PhiD`**: `Φ⁻¹ ∘ Φ = id`; **`PhiD_PhiInvD`**: `Φ ∘ Φ⁻¹ = id` on arrays vanishing on the padding.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

section Cover

variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem Ppre_eq_prod (d : ℕ) (sF : ℕ → ℕ) :
    ∏ i : Fin d, sF i = OpenAI.RCRT.Ppre sF d := by
  rw [Fin.prod_univ_eq_prod_range (fun j => sF j) d]; rfl

end Cover

