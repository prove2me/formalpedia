  have hl : Light.Filter2.ellOf n < Light.Filter2.RR n := Nat.lt_two_pow_self
  have hlogn : Nat.log 2 n ≤ n := Nat.log_le_self 2 n
  have hsk : Nat.sqrt (Light.Filter2.kOf n) ≤ Light.Filter2.kOf n := Nat.sqrt_le_self _
  have hsl : Nat.sqrt (Light.Filter2.ellOf n) ≤ Light.Filter2.ellOf n := Nat.sqrt_le_self _
  have hb : Light.Filter2.bOf n ≤ Light.Filter2.RR n * Light.Filter2.RR n := by
    unfold Light.Filter2.bOf
    exact Nat.mul_le_mul hl.le (by omega)
  have hs : Light.Filter2.sOf n ≤ 2 * n + 1 := sOf_le_succ n
  have hlogs : Nat.log 2 (Light.Filter2.sOf n) ≤ Light.Filter2.sOf n := Nat.log_le_self 2 _
  have hcK : Light.Filter2.cKOf n ≤ Light.Filter2.sOf n := Nat.size_le.2 Nat.lt_two_pow_self
  have he : 336175 * Light.Filter2.kOf n / 10 ^ 7 ≤ Light.Filter2.kOf n := by
    rw [Nat.div_le_iff_le_mul_add_pred (by norm_num)]; omega
  have hB : Light.Filter2.BOf U ≤ Nat.log 2 (3 * U) + 1 := by
    unfold Light.Filter2.BOf
    rcases Nat.eq_zero_or_pos U with rfl | hU
    · simp
    · rw [size_eq_log (by omega)]
  have d1 := Nat.div_le_self (Light.Filter2.bOf n) 2
  have d2 := Nat.div_le_self (3 * Light.Filter2.kOf n) (Light.Filter2.dOf n)
  have d3 := Nat.div_le_self (n + Light.Filter2.sOf n - 1) (Light.Filter2.sOf n)
  have d4 := Nat.div_le_self (Light.Filter2.cKOf n + Light.Filter2.bOf n) (Light.Filter2.ellOf n)
  have d5 := Nat.div_le_self (Light.Filter2.BOf U - 1) (Light.Filter2.ellOf n)
  have hm : 2 * Light.Filter2.RR n - 1 ≤ 2 * Light.Filter2.RR n := Nat.sub_le _ _
  have hlogm : Nat.log 2 (2 * Light.Filter2.RR n - 1) ≤ 2 * Light.Filter2.RR n := (Nat.log_le_self 2 _).trans hm
