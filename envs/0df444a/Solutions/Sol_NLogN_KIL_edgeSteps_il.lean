variable {m Q : ℕ}

variable {E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)}

theorem shearSteps_WF (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i)) :
    ∀ s ∈ shearSteps E₁ W E₂, s.WF := by
  intro s hs
  simp only [shearSteps, List.mem_append] at hs
  rcases hs with (((hs | hs) | hs) | hs) | hs
  · exact dSteps_WF hd₂ s hs
  · exact revSteps_WF (hSteps_WF hd₁) s hs
  · exact addSteps_WF _ s hs
  · exact hSteps_WF hd₁ s hs
  · exact revSteps_WF (dSteps_WF hd₂) s hs

/-- Exactly one field interchange per one of `W`. -/
theorem countP_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).countP Step.isSwap =
      (Finset.univ.filter fun p : Fin m × Fin m => W p.1 p.2 = 1).card := by
  simp only [shearSteps, List.countP_append, countP_revSteps, countP_hSteps, countP_dSteps,
    countP_addSteps, length_pivots]
  ring

