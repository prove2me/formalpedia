-- title:
--   Proposition 3.3: last eigenvalue as a central-spectrum difference
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Let $J_i\in X_i$ be additively central, so $z_i=\sum_{j=1}^iJ_j\in Z(A_i)$, with $z_0=0$. For a path $T\in\operatorname{Tab}(n)$ with $n\ge1$, terminal type $\lambda$ and predecessor type $\mu$, let $c_T(n)$ be the scalar of $J_n$ on the canonical line $V_T$. Let $a_\lambda$ and $a_\mu$ be the scalars of $z_n$ and $z_{n-1}$ on their corresponding simples. Then
--
--   $$c_T(n)=a_\lambda-a_\mu.$$
--
--   Additive centrality makes the last content depend only on the last edge.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 11, Proposition 3.3: last eigenvalue as a central-spectrum difference

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 3.3, source PDF pp. 11–12. Additive centrality alone suffices;
positive length excludes a nonexistent last edge at zero. -/
theorem last_content_difference (D : Tower k AA) (J : (i : ℕ) → AA (i + 1))
    (hJ : IsAdditivelyCentral D J) (n : ℕ) (t : TowerPath D (n + 1)) :
    lastContent D J t = edgeContent D J n
      (towerTerminal D (towerPrefix D t n (by omega))) (towerTerminal D t) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
