variable {α β : Type*}

theorem swapPos_append_tail {p q : ℕ} {a b : List ℕ} (hp : p < a.length) (hq : q < a.length) :
    swapPos p q (a ++ b) = swapPos p q a ++ b := by
  unfold swapPos
  rw [List.getD_append _ _ _ _ hp, List.getD_append _ _ _ _ hq,
    List.set_append_left _ _ (by simpa using hp), List.set_append_left _ _ (by simpa using hq)]

/-- **The field swap through a uniform block expansion.** -/
theorem pull_swapPos_flatMap (sh : Shape) {p q : ℕ} (hp : p < sh.length) (hq : q < sh.length)
    (hs : sh.getD p 0 = sh.getD q 0) (f : α → List β) (B : ℕ) (hf : ∀ x, (f x).length = B)
    (d : α) (d' : β) (xs : List α) (hxs : xs.length = vol sh) :
    (AModel.pull sh sh (swapPos p q) d xs).flatMap f =
      AModel.pull (sh ++ [B]) (sh ++ [B]) (swapPos p q) d' (xs.flatMap f) := by
  rw [pull_flatMap sh _ (fun a ha => valid_swapPos hp hq hs ha) f B hf d d' xs hxs]
  apply pull_congr
  intro a ha
  have hl := ha.length_eq
  simp only [List.length_append, List.length_singleton] at hl
  conv_rhs => rw [← List.take_append_drop sh.length a]
  rw [swapPos_append_tail (by simp; omega) (by simp; omega)]

end NLogN.KFS

end

