          P.comap (algebraMap K[X] (integralClosure K[X] E)) :=
        hover.symm
      _ = ⊥ := by
        rw [hzero]
        exact Ideal.comap_bot_of_injective
          (algebraMap K[X] (integralClosure K[X] E))
          (functionFieldIntegralClosure_algebraMap_injective
            (K := K) (E := E))
