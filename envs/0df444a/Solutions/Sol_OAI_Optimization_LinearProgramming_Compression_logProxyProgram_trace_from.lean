theorem one_le_normalizedMagnitude {mag : K} (h : 0 < mag) : 1 ≤ normalizedMagnitude mag := by
  by_cases hm : mag < 1
  · simpa [normalizedMagnitude, hm] using (one_le_inv₀ h).mpr hm.le
  · simpa [normalizedMagnitude, hm] using le_of_not_gt hm

