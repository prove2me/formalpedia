-- Source module: Solutions.KFMS6
/-!
# KFM S6: the sources and their inverses (math side)

* `srcN n i = s_i`, `prodN n i = ∏_{j<i} s_j`, `muN n i = μ_i = (prodN n i)^{-1} mod s_i`.
* **`indZ_eq`**: for `0 ≤ m < s`, `(s − ((m + s − 1) mod s)) / s = [m = 1]`. This is the
  indicator the IL sum uses (only `nmod`/`ndiv`).
* **`sum_mu`**: `Σ_{y=1}^{s} y·[y·(P mod s) mod s = 1] = muInv P s` for coprime `P, s`, `s ≥ 2`.
* **`prod_mod_seq`**: the running product `c ↦ (c·s_{i−1−k}) mod s_i` ends at `prodN n i mod s_i`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP

theorem indZ_eq (s m : ℤ) (hs : 2 ≤ s) (hm0 : 0 ≤ m) (hm : m < s) :
    (s + -((m + (s + -1)) % s)) / s = if m = 1 then 1 else 0 := by
  rcases (show m = 0 ∨ m = 1 ∨ 2 ≤ m by omega) with h | h | h
  · subst h
    rw [if_neg (by norm_num), show (0 : ℤ) + (s + -1) = s - 1 by ring,
      Int.emod_eq_of_lt (by omega) (by omega), show s + -(s - 1) = 1 by ring]
    exact Int.ediv_eq_zero_of_lt (by norm_num) (by omega)
  · subst h
    rw [if_pos rfl, show (1 : ℤ) + (s + -1) = s by ring, Int.emod_self, neg_zero, add_zero,
      Int.ediv_self (by omega)]
  · rw [if_neg (by omega)]
    have e : (m + (s + -1)) % s = m - 1 := by
      rw [show m + (s + -1) = (m - 1) + s * 1 by ring, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (by omega) (by omega)]
    rw [e]
    exact Int.ediv_eq_zero_of_lt (by omega) (by omega)

end NLogN.KFM

end

