theorem OAI.TruncatedPrincipalPoisson.sum_small_add_large {ι : Type*} [DecidableEq ι] (P : ι → Ideal O)
    (S : Finset ι) (Z : ℝ) (f : Finset ι → ℂ) :
    (∑ E ∈ smallDivisors P S Z, f E) + (∑ E ∈ largeDivisors P S Z, f E) =
      ∑ E ∈ S.powerset, f E := by sorry
