/-! ## Taking header values off the table stack -/

/-- Copy the top of `dT` to `R` and to `DU`, and pop it from `dT`. -/
def tkRS (R : Fin HS) : RS := .seq (.push R (.reg dT)) (.seq (.push DU (.reg dT)) (.pop dT))

/-! ## The block -/

/-- Read the block header. -/
def hdrRS : RS := .seq (tkRS bN) (.seq (.push bN2 (.reg dT)) (.seq (tkRS kr) (.seq (tkRS kK)
  (tkRS kJ))))

/-- Clear the block registers and count the block. -/
def popRS : RS := .seq (.pop bN) (.seq (.pop bN2) (.seq (.pop kr) (.seq (.pop kK) (.seq (.pop kJ)
  (.asg BC (.add (.reg BC) (.lit (-1))))))))

/-- Cost of one block. -/
def cBlk (n pk b φD φT B BH : ℕ) : ℕ :=
  80000 * (BH + 2) + 5 * cDG n φD B + 4 * cMvP n B + 2 * cTS n pk b φT B

/-- Entry bounds. -/
def AB (A : ℤ) (u : List GI) : Prop := ∀ w ∈ u, |w.1| ≤ A ∧ |w.2| ≤ A
def TB (A : ℤ) (c : List ℤ) : Prop := ∀ a ∈ c, |a| ≤ A

/-- All stage values of a block bounded by `A`. -/
def blkOK (P : ℕ) (A : ℤ) (r : ℕ) (di gi gam dd am ap : List ℤ) (z : List GI) : Prop :=
  AB A z ∧ AB A (dgG P di z) ∧ AB A (dgG P gi (dgG P di z)) ∧
  AB A (lwG P r am (dgG P gi (dgG P di z))) ∧
  AB A (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))) ∧
  AB A (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z))))) ∧
  AB A (dgG P gi (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z)))))) ∧
  AB A (blkG P r di gi gam dd am ap z)

end J6Seg.KR

