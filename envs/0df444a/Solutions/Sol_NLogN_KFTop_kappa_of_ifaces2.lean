theorem mvLoop_runs (X Y : Fin HS) (hXY : X ≠ Y) (B : ℕ) :
    ∀ (L : List ℤ) (s : IState HS) (R : List Item), (∀ x ∈ L, zsz x ≤ B) →
      s.G X = ints L ++ .mark :: R →
      IRuns I iprog (mvLoop X Y) s ((s.upd X (.mark :: R)).upd Y (ints L.reverse ++ s.G Y))
