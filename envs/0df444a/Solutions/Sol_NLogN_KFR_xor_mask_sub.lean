theorem bitsum : ∀ (N z : ℕ), z < 2 ^ N →
    (z : ℤ) = ∑ l ∈ Finset.range N, bitZ z l * 2 ^ l
  | 0, z, h => by simp at h; simp [h]
  | N + 1, z, h => by
    rw [Finset.sum_range_succ']
    have h2 : z / 2 < 2 ^ N := by rw [pow_succ] at h; omega
    have ih := bitsum N (z / 2) h2
    have e1 : ∀ l, bitZ z (l + 1) = bitZ (z / 2) l := fun l => by
      unfold bitZ
      have := Nat.testBit_div_two_pow (n := 1) z l
      rw [pow_one] at this
      rw [this]
    have e0 : bitZ z 0 = ((z % 2 : ℕ) : ℤ) := by
      unfold bitZ; rw [Nat.testBit_zero]
      rcases Nat.mod_two_eq_zero_or_one z with h | h <;> simp [h]
    simp_rw [e1, pow_succ, ← mul_assoc]
    rw [← Finset.sum_mul, ← ih, e0, pow_zero, mul_one]
    have := Nat.div_add_mod z 2
    omega

theorem selMask_succ (K ρ f : ℕ) : KFH.selMask K ρ (f + 1) = KFH.selMask K ρ f + 2 ^ (ρ + f * K) := by
  simp [KFH.selMask, List.range_succ]

theorem selMask_bits {K ρ : ℕ} (hK : 1 ≤ K) :
    ∀ f, KFH.selMask K ρ f < 2 ^ (ρ + f * K) ∧
      ∀ l, (KFH.selMask K ρ f).testBit l = decide (∃ u < f, l = ρ + u * K)
  | 0 => ⟨by simp [KFH.selMask], fun l => by simp [KFH.selMask]⟩
  | f + 1 => by
    obtain ⟨h1, h2⟩ := selMask_bits (ρ := ρ) hK f
    rw [selMask_succ]
    have hle : 2 ^ (ρ + f * K) * 2 ≤ 2 ^ (ρ + (f + 1) * K) := by
      rw [← pow_succ]; exact Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    refine ⟨by omega, fun l => ?_⟩
    rw [show KFH.selMask K ρ f + 2 ^ (ρ + f * K) = 2 ^ (ρ + f * K) * 1 + KFH.selMask K ρ f by ring,
      Nat.testBit_two_pow_mul_add 1 h1]
    split_ifs with hl
    · rw [h2]
      apply decide_eq_decide.2
      constructor
      · rintro ⟨u, hu, rfl⟩; exact ⟨u, by omega, rfl⟩
      · rintro ⟨u, hu, rfl⟩
        refine ⟨u, ?_, rfl⟩
        by_contra hc
        have : f * K ≤ u * K := Nat.mul_le_mul_right _ (by omega)
        omega
    · have e : Nat.testBit 1 (l - (ρ + f * K)) = decide (l = ρ + f * K) := by
        rcases Nat.eq_zero_or_pos (l - (ρ + f * K)) with h0 | h0
        · rw [h0]; simp; omega
        · rw [Nat.testBit_eq_decide_div_mod_eq]
          have : 1 / 2 ^ (l - (ρ + f * K)) = 0 :=
            Nat.div_eq_of_lt (Nat.one_lt_two_pow (by omega))
          rw [this]; simp; omega
      rw [e]
      apply decide_eq_decide.2
      constructor
      · rintro rfl; exact ⟨f, by omega, rfl⟩
      · rintro ⟨u, hu, rfl⟩
        have : u ≤ f := by omega
        rcases Nat.lt_or_ge u f with h | h
        · have : u * K < f * K := Nat.mul_lt_mul_of_pos_right h (by omega)
          omega
        · have : u = f := by omega
          rw [this]

theorem testBit_selMask {K ρ : ℕ} (hK : 1 ≤ K) (f l : ℕ) :
    (KFH.selMask K ρ f).testBit l = decide (∃ u < f, l = ρ + u * K) := (selMask_bits hK f).2 l

