/-!
# The Pythagorean quadruple graph: the `n = 3` Berggren machinery

The catalog definition `IsPythQuadruple a b c d : a² + b² + c² = d²` is the integral null cone of
the Lorentz form of signature `(3,1)`.  Here we build the higher–dimensional analogue of the
Berggren moves on it:

* `quadRefl` — the `4 × 4` integral matrix of the reflection in the all-ones vector `(1,1,1;1)`;
  it is an integral Lorentz automorphism (`quadRefl_isIntegralLorentz`) and acts by
  `(a,b,c,d) ↦ (a−k, b−k, c−k, d−k)` with `k = a+b+c−d` (`quadRefl_mulVec`).
* `content` — the gcd of a quadruple; primitivity is `content = 1`.  It is invariant under the
  reflection, the sign changes and the permutations (`content_move`, `content_neg`, …).
* `Reach` — the reachability relation generated by the reflection, one sign change and two
  transpositions, starting from the root `(1,0,0,1)`.

Main theorems.

* `reach_sound` : everything reachable is a primitive Pythagorean quadruple.
* `reach_of_prim` : **completeness / connectivity** — *every* primitive Pythagorean quadruple with
  non-negative entries and positive height is reachable from `(1,0,0,1)`.  This is the exact
  analogue of Berggren's theorem in dimension three, proved by descent on the height.
* `reach_iff_prim` : the two together.
-/

open HigherPythagorean

open Matrix

/-! ## The reflection matrix -/







/-! ## Invariance of the quadruple relation and of the content -/


/-- The reflection move is an involution on quadruples. -/
theorem qk_move (a b c d : ℤ) :
    qk (a - qk a b c d) (b - qk a b c d) (c - qk a b c d) (d - qk a b c d) = -qk a b c d := by
  unfold qk; ring




theorem content_dvd_snd (a b c d : ℤ) : (content a b c d : ℤ) ∣ b :=
  dvd_trans (dvd_trans (Int.gcd_dvd_left _ _) (Int.gcd_dvd_left _ _)) (Int.gcd_dvd_right _ _)



theorem dvd_content {g : ℕ} {a b c d : ℤ} (h1 : (g : ℤ) ∣ a) (h2 : (g : ℤ) ∣ b)
    (h3 : (g : ℤ) ∣ c) (h4 : (g : ℤ) ∣ d) : g ∣ content a b c d :=
  Int.dvd_gcd (Int.natCast_dvd_natCast.mpr
    (Int.dvd_gcd (Int.natCast_dvd_natCast.mpr (Int.dvd_gcd h1 h2)) h3)) h4

/-- The content divides the content of the moved quadruple. -/
theorem content_dvd_content_move (a b c d : ℤ) :
    content a b c d ∣
      content (a - qk a b c d) (b - qk a b c d) (c - qk a b c d) (d - qk a b c d) := by
  have hx := content_dvd_fst a b c d
  have hy := content_dvd_snd a b c d
  have hz := content_dvd_thd a b c d
  have hw := content_dvd_fth a b c d
  have hkk : (content a b c d : ℤ) ∣ qk a b c d := by
    unfold qk; exact dvd_sub (dvd_add (dvd_add hx hy) hz) hw
  exact dvd_content (dvd_sub hx hkk) (dvd_sub hy hkk) (dvd_sub hz hkk) (dvd_sub hw hkk)







/-! ## The reachability relation -/






/-! ## Descent -/








open HigherPythagorean in
theorem solution(a b c d : ℤ) :
    content (a - qk a b c d) (b - qk a b c d) (c - qk a b c d) (d - qk a b c d) =
      content a b c d := by
  have h1 := content_dvd_content_move a b c d
  have h2 := content_dvd_content_move (a - qk a b c d) (b - qk a b c d) (c - qk a b c d)
    (d - qk a b c d)
  rw [qk_move a b c d] at h2
  have e : ∀ x : ℤ, x - qk a b c d - -qk a b c d = x := by intro x; ring
  simp only [e] at h2
  exact Nat.dvd_antisymm h2 h1
