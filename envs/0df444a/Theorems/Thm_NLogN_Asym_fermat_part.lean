open IntMul NLogN NLogN.Top IntMul.HvdH IntMul.HvdH.Ref

theorem NLogN.Asym.fermat_part (K : ℕ) (hK : 10 ^ 4 ≤ K) (N : ℕ) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    4 * (3 * 2 ^ (mkParams K N).logOuter * TT' ((mkParams K N).fn + 1)) ≤ TT' N := by sorry
