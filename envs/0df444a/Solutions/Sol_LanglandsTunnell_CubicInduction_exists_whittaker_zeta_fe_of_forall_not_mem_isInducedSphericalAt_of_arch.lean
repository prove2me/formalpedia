private abbrev ColS (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (ν : Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ)) (α : (v.adicCompletion ℚ)ˣ) (W : LocalGL3 v → ℂ) (gv : LocalGL3 v)
    (P : ℂ → ℂ) (σ₀ σ₁ : ℝ) : Prop :=
  (letI := localBorel ℚ v;
    (∃ (Q : Polynomial ℂ) (m : ℕ), ∀ s : ℂ,
      P s = Q.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) * (Ideal.absNorm v.asIdeal : ℂ) ^ ((m : ℂ) * s)) ∧
    IsLocalZeta30ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
      W (localChar χ v) gv σ₀ ∧
    (∀ s : ℂ, σ₀ < s.re →
      localZeta30 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
          W (localChar χ v) s gv =
        ((inducedEulerPoly ℚ (inducedCoeff K χT) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ * P s) ∧
    IsLocalZeta31ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
      (selfDualHaarAt ℚ v) (dualWhittakerFn3 W) (localChar χ v)⁻¹
      (weylPrime3 * transposeInv3 gv) σ₁ ∧
    ∃ a : Fin 3 → ℕ,
      (∀ i, LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν i * localChar χ v) (a i)) ∧
      ∀ s : ℂ, σ₁ < (1 - s).re →
        localZetaDual31 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) (selfDualHaarAt ℚ v)
            W (localChar χ v) (1 - s) gv =
          ((localChar ω v α : ℂˣ) : ℂ) * (((localChar χ v α : ℂˣ) : ℂ) ^ 3 *
            ((∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν i * localChar χ v)⁻¹ (1 - s)) *
              ((∏ i, LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (ν i * localChar χ v)) *
                (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (a i : ℂ)) * (1 / 2 - s))) * P s)))

private abbrev ColNr (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (α : (v.adicCompletion ℚ)ˣ) (W : LocalGL3 v → ℂ) (gv : LocalGL3 v) (n : ℕ) (P : ℂ → ℂ) (σ₀ σ₁ : ℝ) : Prop :=
  (letI := localBorel ℚ v;
    (∃ (Q : Polynomial ℂ) (m : ℕ), ∀ s : ℂ,
      P s = Q.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) * (Ideal.absNorm v.asIdeal : ℂ) ^ ((m : ℂ) * s)) ∧
    IsLocalZeta30ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
      W (localChar χ v) gv σ₀ ∧
    (n = 0 → ∀ s : ℂ, σ₀ < s.re →
      localZeta30 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
          W (localChar χ v) s gv =
        ((gl3LFactorPoly
                (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) *
                  inducedE1 ℚ (inducedCoeff K μ) v)
                (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) ^ 2 *
                  inducedE2 ℚ (inducedCoeff K μ) v)
                (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) ^ 3 *
                  inducedE3 ℚ (inducedCoeff K μ) v)).eval
            ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ * P s) ∧
    (1 ≤ n → ∀ s : ℂ, σ₀ < s.re →
      localZeta30 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
          W (localChar χ v) s gv = P s) ∧
    IsLocalZeta31ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
      (selfDualHaarAt ℚ v) (dualWhittakerFn3 W) (localChar χ v)⁻¹
      (weylPrime3 * transposeInv3 gv) σ₁ ∧
    (n = 0 → ∀ s : ℂ, σ₁ < (1 - s).re →
      ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          localZetaDual31 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) (selfDualHaarAt ℚ v)
            W (localChar χ v) (1 - s) gv =
        ((localChar ω v α : ℂˣ) : ℂ) * (((localChar χ v α : ℂˣ) : ℂ) ^ 3 *
          (((gl3LFactorPoly
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ *
                    (inducedE2 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v))
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ ^ 2 *
                    (inducedE1 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v))
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ ^ 3 *
                    (inducedE3 ℚ (inducedCoeff K μ) v)⁻¹)).eval
              ((Ideal.absNorm v.asIdeal : ℂ) ^ (-(1 - s))))⁻¹ * P s))) ∧
    (1 ≤ n → ∀ s : ℂ, σ₁ < (1 - s).re →
      ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          localZetaDual31 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) (selfDualHaarAt ℚ v)
            W (localChar χ v) (1 - s) gv =
        ((localChar ω v α : ℂˣ) : ℂ) * (((localChar χ v α : ℂˣ) : ℂ) ^ 3 *
          ((inducedE3 ℚ (inducedCoeff K μ) v ^ n *
                LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (localChar χ v) ^ 3 *
              (Ideal.absNorm v.asIdeal : ℂ) ^ (((3 * n : ℕ) : ℂ) * (1 / 2 - s))) * P s))))

