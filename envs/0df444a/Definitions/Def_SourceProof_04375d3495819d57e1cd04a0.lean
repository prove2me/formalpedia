/-!
# The natural filtration is generated by the counts on finite-intensity windows

The reference intensity is a product with a σ-finite mark measure, so a set of times at most `T`
splits into the null part at nonpositive times and a countable increasing union of sets inside
windows `(0, T] × A` with `ν A` finite. The counts on those windows are almost surely finite, so
their real parts generate the natural filtration modulo null sets, and the characters of those
real counts separate.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology

namespace LevyStochCalc.Poisson

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]

section Window


theorem _root_.Prove2MeSourceProof.h_04375d3495819d57e1cd04a0 (N : PoissonRandomMeasure P ν) (T : ℝ) :
    naturalFiltration N T ≤ Probability.aug (windowSigma N T) ‹MeasurableSpace Ω› P := by
  rw [LevyStochCalc.Poisson.naturalFiltration_seq_eq]
  refine iSup_le fun B => iSup_le fun hB => ?_
  obtain ⟨hBT, hBm⟩ := hB
  set Y : Ω → ℝ≥0∞ := fun ω =>
    ⨆ n : ℕ, ENNReal.ofReal (N.N ω (LevyStochCalc.Poisson.windowTrace ν T B hBm n : Set (ℝ × E))).toReal with hY
  have hYmeas : Measurable[LevyStochCalc.Poisson.windowSigma N T] Y :=
    Measurable.iSup fun n =>
      ENNReal.measurable_ofReal.comp (LevyStochCalc.Poisson.measurable_windowSigma_count N (LevyStochCalc.Poisson.windowTrace ν T B hBm n))
  refine LevyStochCalc.Poisson.comap_le_aug_of_ae_eq (N.measurable_eval hBm) hYmeas ?_
  have hfin : ∀ᵐ ω ∂P, ∀ n : ℕ,
      N.N ω (LevyStochCalc.Poisson.windowTrace ν T B hBm n : Set (ℝ × E)) ≠ ⊤ :=
    ae_all_iff.mpr fun n =>
      LevyStochCalc.Poisson.ae_count_ne_top N (LevyStochCalc.Poisson.windowTrace ν T B hBm n).measurableSet
        (LevyStochCalc.Poisson.windowTrace ν T B hBm n).intensity_ne_top
  filter_upwards [LevyStochCalc.Poisson.ae_count_Iic_zero_eq_zero N hBm, hfin] with ω hzero hne
  have hsplit : B = B ∩ Set.Iic (0 : ℝ) ×ˢ Set.univ ∪ B ∩ Set.Ioi (0 : ℝ) ×ˢ Set.univ := by
    rw [← Set.inter_union_distrib_left]
    refine (Set.inter_eq_left.mpr fun p _ => ?_).symm
    rcases le_or_gt p.1 (0 : ℝ) with h | h
    · exact Or.inl ⟨h, Set.mem_univ _⟩
    · exact Or.inr ⟨h, Set.mem_univ _⟩
  have hdisj : Disjoint (B ∩ Set.Iic (0 : ℝ) ×ˢ Set.univ) (B ∩ Set.Ioi (0 : ℝ) ×ˢ Set.univ) := by
    refine Set.disjoint_left.mpr fun p hp hq => ?_
    exact absurd (Set.mem_Ioi.mp hq.2.1) (not_lt.mpr (Set.mem_Iic.mp hp.2.1))
  have hmeas1 : MeasurableSet (B ∩ Set.Ioi (0 : ℝ) ×ˢ Set.univ) :=
    hBm.inter (measurableSet_Ioi.prod MeasurableSet.univ)
  have hunion : N.N ω B
      = N.N ω (B ∩ Set.Iic (0 : ℝ) ×ˢ Set.univ) + N.N ω (B ∩ Set.Ioi (0 : ℝ) ×ˢ Set.univ) := by
    conv_lhs => rw [hsplit]
    exact measure_union hdisj hmeas1
  have hmono : Monotone fun n => (LevyStochCalc.Poisson.windowTrace ν T B hBm n : Set (ℝ × E)) :=
    LevyStochCalc.Poisson.monotone_windowTrace (ν := ν) T B hBm
  rw [hunion, hzero, zero_add, ← LevyStochCalc.Poisson.iUnion_windowTrace (ν := ν) hBm hBT, hmono.measure_iUnion, hY]
  exact iSup_congr fun n => (ENNReal.ofReal_toReal (hne n)).symm
end Window

end LevyStochCalc.Poisson


