theorem PI.TwistedEisensteinNonvanishing.W.sum_stab {ι : Type} [Fintype ι] [DecidableEq ι] {a b A B : ℕ} (hA : a ≤ A) (hB : b ≤ B)
    {H : (ι → E) → K} (hH : Good P a b H) :
    ∑ t ∈ Fintype.piFinset (fun _ : ι => valsQ E (qOf P) A B), H t =
      ((qOf P ^ (B - b) : ℕ) : K) ^ Fintype.card ι *
        ∑ t ∈ Fintype.piFinset (fun _ : ι => valsQ E (qOf P) a b), H t := by sorry
