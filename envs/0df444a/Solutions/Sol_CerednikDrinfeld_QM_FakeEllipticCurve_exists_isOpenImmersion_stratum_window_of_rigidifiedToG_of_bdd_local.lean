    (hpad : ∀ (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ),
      deg (pad hΛℤ ρ i j) = q ^ (2 * i) * deg ρ ∧ deg' (pad hΛℤ ρ i j) = q ^ (2 * j) * deg' ρ)
