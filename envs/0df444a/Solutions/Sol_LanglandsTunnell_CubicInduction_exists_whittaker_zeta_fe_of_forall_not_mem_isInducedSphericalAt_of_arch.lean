private def integralSet : Set (AdelicGL 3 (𝓞 ℚ) ℚ) :=
  {g | ∀ v : HeightOneSpectrum (𝓞 ℚ), componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v}

private theorem one_mem_integralSet : (1 : AdelicGL 3 (𝓞 ℚ) ℚ) ∈ integralSet := fun v => by
  rw [map_one]
  exact Subgroup.one_mem _

private theorem adeleFin_mem_integralFiniteAdeles_iff (x : AdeleRing (𝓞 ℚ) ℚ) :
    AdelicLevel.adeleFin (𝓞 ℚ) ℚ x ∈ AdelicLevel.integralFiniteAdeles (𝓞 ℚ) ℚ ↔
      ∀ v : HeightOneSpectrum (𝓞 ℚ),
        Valued.v (AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v (AdelicLevel.adeleFin (𝓞 ℚ) ℚ x)) ≤ 1 := by
  simp only [AdelicLevel.integralFiniteAdeles, Set.mem_setOf_eq, AdelicLevel.finAdeleEval_apply,
    HeightOneSpectrum.mem_adicCompletionIntegers]

private theorem integralSet_eq :
    integralSet = {g : AdelicGL 3 (𝓞 ℚ) ℚ |
      (∀ i j, AdelicLevel.adeleFin (𝓞 ℚ) ℚ ((g : Matrix (Fin 3) (Fin 3) (AdeleRing (𝓞 ℚ) ℚ)) i j) ∈
        AdelicLevel.integralFiniteAdeles (𝓞 ℚ) ℚ) ∧
      ∀ i j, AdelicLevel.adeleFin (𝓞 ℚ) ℚ
        (((g⁻¹ : AdelicGL 3 (𝓞 ℚ) ℚ) : Matrix (Fin 3) (Fin 3) (AdeleRing (𝓞 ℚ) ℚ)) i j) ∈
          AdelicLevel.integralFiniteAdeles (𝓞 ℚ) ℚ} := by
  ext g
  simp only [integralSet, Set.mem_setOf_eq, mem_localMaximalCompact3_iff, adeleFin_mem_integralFiniteAdeles_iff,
    ← map_inv]
  exact ⟨fun h => ⟨fun i j v => (h v).1 i j, fun i j v => (h v).2 i j⟩,
    fun h v => ⟨fun i j => h.1 i j v, fun i j => h.2 i j v⟩⟩

private theorem isOpen_integralSet : IsOpen integralSet := by
  rw [integralSet_eq]
  have hI := AdelicLevel.isOpen_integralFiniteAdeles (𝓞 ℚ) ℚ
  have hfin := AdelicLevel.continuous_adeleFin (𝓞 ℚ) ℚ
  simp only [Set.setOf_and, Set.setOf_forall]
  refine IsOpen.inter ?_ ?_
  · exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
      hI.preimage (hfin.comp (Units.continuous_val.matrix_elem i j))
  · exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
      hI.preimage (hfin.comp (Units.continuous_coe_inv.matrix_elem i j))

end
