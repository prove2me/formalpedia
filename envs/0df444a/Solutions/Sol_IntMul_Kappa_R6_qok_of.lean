section
-- Source module: Solutions.R6MFacts
/-!
# Round-six machine: `QOk` for large `n`

* `prod_tF6`: `∏_{j<d} t_j = T`.
* `eps_room`: eventually `4 b^ε ≤ b` (so `ℓ ≥ 2`).
* **`qok_of`**: for `P.Ok`, there is `n₁` such that `QOk ⟨P, n, src⟩` holds for every `n ≥ n₁` and
  every source list with `SrcOK6 P n src`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IntMul.OpenAI.RT AModel

noncomputable section

theorem tF6_eq (P : Prm) (n : ℕ) (hl : 1 ≤ ℓP6 P n) (j : ℕ) (hj : j < dP6 P n) :
    tF6 P n j = 2 ^ OpenAI.RP.axExp (LP6 P n) (dP6 P n) ⟨j, hj⟩ := by
  have hl' : 1 ≤ OpenAI.RP.ell (LP6 P n) (dP6 P n) := hl
  unfold tF6 OpenAI.RP.axExp bL6
  have e1 : hN6 P n = OpenAI.RP.ell (LP6 P n) (dP6 P n) - 1 := rfl
  have e2 : dpN6 P n = OpenAI.RP.mcnt (LP6 P n) (dP6 P n) := rfl
  rw [e1, e2]
  simp only [decide_eq_true_eq]
  by_cases h : OpenAI.RP.mcnt (LP6 P n) (dP6 P n) ≤ j
  · rw [if_pos h, if_neg (by omega), ← pow_succ]; congr 1; omega
  · rw [if_neg h, if_pos (by omega)]

theorem prod_tF6 (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) :
    ∏ j ∈ Finset.range (dP6 P n), tF6 P n j = 2 ^ LP6 P n := by
  have e := OpenAI.RP.axLen_prod (LP6 P n) (dP6 P n) (by omega)
  rw [← e, ← Fin.prod_univ_eq_prod_range]
  refine Finset.prod_congr rfl fun j _ => ?_
  exact tF6_eq P n hl j.val j.isLt

/-- Eventually `4 b^ε ≤ b`. -/
theorem eps_room (P : Prm) (hP : P.Ok) : ∃ B : ℕ, ∀ b : ℕ, B ≤ b → 4 * (b : ℝ) ^ P.ε ≤ b := by
  have h1 : 0 < 1 - P.ε := by linarith [hP.eps_lt]
  refine ⟨⌈(4 : ℝ) ^ (1 / (1 - P.ε))⌉₊ + 1, fun b hb => ?_⟩
  have hB : (4 : ℝ) ^ (1 / (1 - P.ε)) ≤ b := by
    have := Nat.le_ceil ((4 : ℝ) ^ (1 / (1 - P.ε)))
    have : ((⌈(4 : ℝ) ^ (1 / (1 - P.ε))⌉₊ + 1 : ℕ) : ℝ) ≤ b := by exact_mod_cast hb
    push_cast at this; linarith
  have hb0 : (0 : ℝ) < b := lt_of_lt_of_le (by positivity) hB
  have h4 : (4 : ℝ) ≤ (b : ℝ) ^ (1 - P.ε) := by
    have := Real.rpow_le_rpow (by positivity) hB h1.le
    rwa [← Real.rpow_mul (by norm_num), one_div_mul_cancel h1.ne', Real.rpow_one] at this
  have hs : (b : ℝ) = (b : ℝ) ^ (1 - P.ε) * (b : ℝ) ^ P.ε := by
    rw [← Real.rpow_add hb0]; simp
  have he : 0 ≤ (b : ℝ) ^ P.ε := (Real.rpow_pos_of_pos hb0 _).le
  nlinarith

/-- Powers of two in `ℝ`. -/
theorem two_pow_le' {a c : ℕ} (h : a ≤ c) : (2 : ℝ) ^ a ≤ 2 ^ c :=
  pow_le_pow_right₀ (by norm_num) h

set_option maxHeartbeats 1000000 in
/-- **`QOk` for large `n`.** -/
theorem qok_of_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → QOk ⟨P, n, src⟩ := by
  obtain ⟨n₂, hn₂⟩ := params6_ok P hP
  obtain ⟨B₁, hB₁⟩ := eps_room P hP
  obtain ⟨B₀, hB₀⟩ := poly_le_two_pow_half (6 * (1 + P.x))
  refine ⟨max n₂ (2 ^ (max 64 (max B₁ B₀))), fun n hn src hs => ?_⟩
  have hG := hn₂ n (le_of_max_le_left hn)
  have hbB : max 64 (max B₁ B₀) ≤ bP6 n := lg_ge _ (le_of_max_le_right hn)
  have hb64 : 64 ≤ bP6 n := le_trans (le_max_left _ _) hbB
  have hbB1 : B₁ ≤ bP6 n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hbB
  have hbB0 : B₀ ≤ bP6 n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hbB
  set Q : Q6 := ⟨P, n, src⟩ with hQd
  set b := bP6 n with hbd
  have hsq : b ^ 2 ≤ Q.b := b'_ge_sq P hP n
  have hb2 : 64 * b ≤ b ^ 2 := by nlinarith
  have hbQ : 64 * b ≤ Q.b := hb2.trans hsq
  have hLb : Q.L ≤ b := hG.L_le
  have hLge : b ≤ 2 * Q.L := hG.L_ge
  have hd1 : 1 ≤ Q.d := hG.d_pos
  have hdb : Q.d ≤ b := hG.d_le_b
  -- ℓ ≥ 2
  have h4d : 4 * Q.d ≤ b := by
    have h1 := hB₁ b hbB1
    have h2 : (Q.d : ℝ) ≤ (b : ℝ) ^ P.ε := hG.d_le
    have : ((4 * Q.d : ℕ) : ℝ) ≤ (b : ℝ) := by push_cast; linarith
    exact_mod_cast this
  have hℓ2 : 2 ≤ Q.ℓ := by
    have h1 : Q.L ≤ Q.d * Q.ℓ := hG.dℓ_ge
    have : Q.d * 2 ≤ Q.d * Q.ℓ := by omega
    exact Nat.le_of_mul_le_mul_left this (by omega)
  have hℓ1 : 1 ≤ Q.ℓ := by omega
  have hℓL : Q.ℓ ≤ Q.L + b := by
    have h1 : Q.d * Q.ℓ ≤ Q.L + Q.d - 1 := hG.dℓ_le
    have : Q.ℓ ≤ Q.d * Q.ℓ := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hL3 : 3 ≤ Q.L := by omega
  -- γ
  have hγ4 : 4 * Q.γ ≤ Q.b := by
    have h1 := hG.gamma_le
    have h2 : Q.α ^ 2 ≤ α2P6 P n := Nat.sqrt_le' _
    have : 2 * Q.d * Q.α ^ 2 ≤ 2 * Q.d * α2P6 P n := Nat.mul_le_mul_left _ h2
    exact (Nat.mul_le_mul_left 4 this).trans h1
  -- sources
  have hlt : ∀ j < Q.d, Q.src j < tF6 Q.P Q.n j := by
    intro j hj
    have lo := hs.lo j hj
    have hi := hs.hi j hj
    show src j < tF6 P n j
    omega
  -- S ≤ T ≤ 2^b
  have hS : Q.S ≤ 2 ^ Q.L := by
    show ∏ j ∈ Finset.range (dP6 P n), src j ≤ 2 ^ LP6 P n
    rw [← prod_tF6 P n hd1 hℓ1]
    exact Finset.prod_le_prod (fun _ _ => Nat.zero_le _)
      (fun j hj => (hlt j (Finset.mem_range.1 hj)).le)
  have hpQ : Q.p = 6 * Q.b := rfl
  have hp2 : Q.p / 2 = 3 * Q.b := by omega
  have hhp : hp Q.p = 1 / (2 : ℝ) ^ Q.p := by
    show (2 : ℝ)⁻¹ ^ Q.p = _; rw [inv_pow, one_div]
  have hP0 : (0 : ℝ) < 2 ^ Q.p := by positivity
  have her : Q.er = (2 : ℝ) ^ (3 * Q.b) := by
    show (2 : ℝ) ^ (pP6 P n / 2) = _; rw [show pP6 P n / 2 = 3 * Q.b from hp2]
  have hEs : Q.Es ≤ (2 : ℝ) ^ (Q.γ + 3 * Q.b + 5) := by
    show (2 : ℝ) ^ Q.γ * (Q.er + (Q.er + 22) + Q.er) ≤ _
    rw [her]
    have h1 : (1 : ℝ) ≤ 2 ^ (3 * Q.b) := one_le_pow₀ (by norm_num)
    rw [show Q.γ + 3 * Q.b + 5 = Q.γ + (3 * Q.b + 5) by ring, pow_add, pow_add (2 : ℝ) (3 * Q.b)]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    nlinarith
  have hEs0 : 0 ≤ Q.Es := by show 0 ≤ (2 : ℝ) ^ Q.γ * (Q.er + (Q.er + 22) + Q.er); rw [her]; positivity
  refine ⟨hs, by omega, hd1, hℓ2, ?_, by omega, hlt, ?_, ?_, ?_, ?_, by omega, by omega,
    by show Q.ℓ - 1 ≤ Q.b; omega, ?_⟩
  · -- n ≥ 3
    have h1 : 2 ^ 64 ≤ 2 ^ (max 64 (max B₁ B₀)) := Nat.pow_le_pow_right (by norm_num) (le_max_left _ _)
    have h2 : 2 ^ (max 64 (max B₁ B₀)) ≤ n := le_of_max_le_right hn
    show 3 ≤ n
    have : (3 : ℕ) ≤ 2 ^ 64 := by norm_num
    omega
  · -- 2M ≤ S
    exact MS_of P n src hs hd1 hℓ1 hL3 (b'P6_pos P n)
  · -- εA
    rw [hhp, her, mul_one_div, div_le_iff₀ hP0]
    have : (2 : ℝ) ^ Q.p = 2 ^ (3 * Q.b) * 2 ^ (3 * Q.b) := by rw [← pow_add]; congr 1; omega
    rw [this]
    have h10 : (10 : ℝ) ≤ 2 ^ (3 * Q.b) := by
      calc (10 : ℝ) ≤ 2 ^ 4 := by norm_num
        _ ≤ _ := two_pow_le' (by omega)
    have : (0 : ℝ) ≤ 2 ^ (3 * Q.b) := by positivity
    nlinarith
  · -- Es
    rw [hhp, mul_one_div, div_le_iff₀ hP0]
    have : (2 : ℝ) ^ Q.p = 2 ^ (Q.γ + 3 * Q.b + 5) * 2 ^ (Q.p - (Q.γ + 3 * Q.b + 5)) := by
      rw [← pow_add]; congr 1; omega
    rw [this]
    have h100 : (100 : ℝ) ≤ 2 ^ (Q.p - (Q.γ + 3 * Q.b + 5)) := by
      calc (100 : ℝ) ≤ 2 ^ 7 := by norm_num
        _ ≤ _ := two_pow_le' (by omega)
    have : (0 : ℝ) ≤ 2 ^ (Q.γ + 3 * Q.b + 5) := by positivity
    nlinarith
  · -- B2
    rw [hhp, mul_one_div, div_lt_one hP0]
    have hSR : (Q.S : ℝ) ^ 2 ≤ (2 : ℝ) ^ (2 * b) := by
      have : (Q.S : ℝ) ≤ (2 : ℝ) ^ b := by
        have : Q.S ≤ 2 ^ b := hS.trans (Nat.pow_le_pow_right (by norm_num) hLb)
        exact_mod_cast this
      rw [pow_mul']; exact pow_le_pow_left₀ (Nat.cast_nonneg _) this 2
    have h3 : 3 * Q.Es + 2 ≤ (2 : ℝ) ^ (Q.γ + 3 * Q.b + 8) := by
      have h1 : (1 : ℝ) ≤ 2 ^ (Q.γ + 3 * Q.b + 5) := one_le_pow₀ (by norm_num)
      have : (2 : ℝ) ^ (Q.γ + 3 * Q.b + 8) = 8 * 2 ^ (Q.γ + 3 * Q.b + 5) := by
        rw [show Q.γ + 3 * Q.b + 8 = (Q.γ + 3 * Q.b + 5) + 3 by ring, pow_add]; ring
      rw [this]; linarith
    have hx : 2 * (2 : ℝ) ^ (2 * Q.b + 4) * (Q.S : ℝ) ^ 2 * (3 * Q.Es + 2) ≤
        2 * 2 ^ (2 * Q.b + 4) * 2 ^ (2 * b) * 2 ^ (Q.γ + 3 * Q.b + 8) := by
      have : 0 ≤ 3 * Q.Es + 2 := by linarith
      gcongr
    have hy : 2 * (2 : ℝ) ^ (2 * Q.b + 4) * 2 ^ (2 * b) * 2 ^ (Q.γ + 3 * Q.b + 8) < 2 ^ Q.p := by
      rw [show (2 : ℝ) * 2 ^ (2 * Q.b + 4) * 2 ^ (2 * b) * 2 ^ (Q.γ + 3 * Q.b + 8) =
        2 ^ (1 + (2 * Q.b + 4) + 2 * b + (Q.γ + 3 * Q.b + 8)) by
          rw [pow_add, pow_add, pow_add]; ring]
      exact pow_lt_pow_right₀ (by norm_num) (by omega)
    linarith
  · -- b'^6 ≤ T
    have h1 := hB₀ b hbB0
    show (b'P6 P n) ^ 6 ≤ 2 ^ LP6 P n
    have e : (b'P6 P n) ^ 6 = b ^ (6 * (1 + P.x)) := by
      unfold b'P6; rw [← pow_mul, mul_comm]
    rw [e]
    have h2 : b ≤ 2 * LP6 P n := hG.L_ge
    have : 2 ^ (b / 2) ≤ 2 ^ LP6 P n := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega

end

