noncomputable section

namespace CoarseAssembly.Analytic

universe u

variable (A : Type u) [NonUnitalCStarAlgebra A]

inductive CycleRelation : FreeAbelianGroup (OddCycle A) → Prop
  | degenerate (c : OddCycle A) (h : c.Degenerate) :
      CycleRelation (FreeAbelianGroup.of c)
  | unitary (c d : OddCycle A) (h : c.UnitaryEquivalent d) :
      CycleRelation (FreeAbelianGroup.of c - FreeAbelianGroup.of d)
  | directSum (c d e : OddCycle A) (h : c.IsDirectSum d e) :
      CycleRelation (FreeAbelianGroup.of e - (FreeAbelianGroup.of c + FreeAbelianGroup.of d))
  | homotopy (h : OddHomotopy A) :
      CycleRelation (FreeAbelianGroup.of (h.eval start) - FreeAbelianGroup.of (h.eval finish))

def relations : AddSubgroup (FreeAbelianGroup (OddCycle A)) :=
  AddSubgroup.closure {z | CycleRelation A z}

abbrev OddK := FreeAbelianGroup (OddCycle A) ⧸ relations A

def cycleClass (c : OddCycle A) : OddK A :=
  QuotientAddGroup.mk (FreeAbelianGroup.of c)

variable {A}

variable {B C : Type u} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]

def precompFree (φ : B →⋆ₙₐ[ℂ] A) : FreeAbelianGroup (OddCycle A) →+ OddK B :=
  FreeAbelianGroup.lift (fun c => cycleClass B (c.precomp φ))

def precomp (φ : B →⋆ₙₐ[ℂ] A) : OAI.CoarseAssembly.Analytic.OddK A →+ OAI.CoarseAssembly.Analytic.OddK B := by
  classical
  have OAI.CoarseAssembly.Analytic.degenerate_zero {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] (c : OAI.CoarseAssembly.Analytic.OddCycle A) (hc : c.Degenerate) : OAI.CoarseAssembly.Analytic.cycleClass A c = 0  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    (
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {z : FreeAbelianGroup (OAI.CoarseAssembly.Analytic.OddCycle A)} (hz : OAI.CoarseAssembly.Analytic.CycleRelation A z) :
          (QuotientAddGroup.mk z : OAI.CoarseAssembly.Analytic.OddK A) = 0 :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          (QuotientAddGroup.eq_zero_iff z).2 (AddSubgroup.subset_closure hz)
      local_proof) (.degenerate c hc)
  have OAI.CoarseAssembly.Analytic.unitary_eq {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] (c d : OAI.CoarseAssembly.Analytic.OddCycle A) (h : c.UnitaryEquivalent d) :
      OAI.CoarseAssembly.Analytic.cycleClass A c = OAI.CoarseAssembly.Analytic.cycleClass A d  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      have hz := (
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {z : FreeAbelianGroup (OAI.CoarseAssembly.Analytic.OddCycle A)} (hz : OAI.CoarseAssembly.Analytic.CycleRelation A z) :
          (QuotientAddGroup.mk z : OAI.CoarseAssembly.Analytic.OddK A) = 0 :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          (QuotientAddGroup.eq_zero_iff z).2 (AddSubgroup.subset_closure hz)
      local_proof) (.unitary c d h)
      exact sub_eq_zero.mp (by simpa only [OAI.CoarseAssembly.Analytic.cycleClass, OAI.CoarseAssembly.Analytic.OddK, QuotientAddGroup.mk_sub] using hz)
  have OAI.CoarseAssembly.Analytic.directSum_eq {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] (c d e : OAI.CoarseAssembly.Analytic.OddCycle A) (h : c.IsDirectSum d e) :
      OAI.CoarseAssembly.Analytic.cycleClass A e = OAI.CoarseAssembly.Analytic.cycleClass A c + OAI.CoarseAssembly.Analytic.cycleClass A d  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      have hz := (
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {z : FreeAbelianGroup (OAI.CoarseAssembly.Analytic.OddCycle A)} (hz : OAI.CoarseAssembly.Analytic.CycleRelation A z) :
          (QuotientAddGroup.mk z : OAI.CoarseAssembly.Analytic.OddK A) = 0 :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          (QuotientAddGroup.eq_zero_iff z).2 (AddSubgroup.subset_closure hz)
      local_proof) (.directSum c d e h)
      exact sub_eq_zero.mp (by simpa only [OAI.CoarseAssembly.Analytic.cycleClass, OAI.CoarseAssembly.Analytic.OddK, QuotientAddGroup.mk_sub, QuotientAddGroup.mk_add] using hz)
  have OAI.CoarseAssembly.Analytic.homotopy_eq {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] (h : OAI.CoarseAssembly.Analytic.OddHomotopy A) :
      OAI.CoarseAssembly.Analytic.cycleClass A (h.eval OAI.CoarseAssembly.Analytic.start) = OAI.CoarseAssembly.Analytic.cycleClass A (h.eval OAI.CoarseAssembly.Analytic.finish)  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      have hz := (
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {z : FreeAbelianGroup (OAI.CoarseAssembly.Analytic.OddCycle A)} (hz : OAI.CoarseAssembly.Analytic.CycleRelation A z) :
          (QuotientAddGroup.mk z : OAI.CoarseAssembly.Analytic.OddK A) = 0 :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          (QuotientAddGroup.eq_zero_iff z).2 (AddSubgroup.subset_closure hz)
      local_proof) (.homotopy h)
      exact sub_eq_zero.mp (by simpa only [OAI.CoarseAssembly.Analytic.cycleClass, OAI.CoarseAssembly.Analytic.OddK, QuotientAddGroup.mk_sub] using hz)
  have OAI.CoarseAssembly.Analytic.precompFree_relation {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {B : Type _} [inst_local_3 : NonUnitalCStarAlgebra B] (φ : B →⋆ₙₐ[ℂ] A)
      {z : FreeAbelianGroup (OAI.CoarseAssembly.Analytic.OddCycle A)} (hz : OAI.CoarseAssembly.Analytic.CycleRelation A z) :
      OAI.CoarseAssembly.Analytic.precompFree φ z = 0  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      cases hz with
      | degenerate c h =>
        simpa [OAI.CoarseAssembly.Analytic.precompFree] using OAI.CoarseAssembly.Analytic.degenerate_zero (c.precomp φ) (((
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {B : Type _} [inst_local_3 : NonUnitalCStarAlgebra B] {c : OAI.CoarseAssembly.Analytic.OddCycle A} (hc : c.Degenerate)
          (φ : B →⋆ₙₐ[ℂ] A) : (c.precomp φ).Degenerate :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic OAI.CoarseAssembly.Analytic.OddCycle in
          ⟨fun b => hc.1 (φ b), fun b => hc.2.1 (φ b), fun b => hc.2.2 (φ b)⟩
      local_proof) h φ))
      | unitary c d h =>
        simpa [OAI.CoarseAssembly.Analytic.precompFree] using sub_eq_zero.mpr
          (OAI.CoarseAssembly.Analytic.unitary_eq (c.precomp φ) (d.precomp φ) (h.precomp φ))
      | directSum c d e h =>
        simpa [OAI.CoarseAssembly.Analytic.precompFree] using sub_eq_zero.mpr
          (OAI.CoarseAssembly.Analytic.directSum_eq (c.precomp φ) (d.precomp φ) (e.precomp φ) (h.precomp φ))
