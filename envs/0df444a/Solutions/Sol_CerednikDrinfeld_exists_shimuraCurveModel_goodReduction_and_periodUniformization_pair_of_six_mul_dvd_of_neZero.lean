private theorem nonempty_periodUniformization
    (shift : E → E) (hsq : ∀ c, shift (shift c) = c)
    (χ : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
    (hinertχ : ∀ τ : ↥(A.decompositionSubgroup ℚ),
      (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ → χ τ = 1)
    (hfrobχ : ∀ φ : ↥(A.decompositionSubgroup ℚ),
      A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r → χ φ ≠ 1)
    (hact1 : ∀ τ, χ τ = 1 → actZ τ = 1)
    (hact2 : ∀ τ, χ τ ≠ 1 → ∀ x : ↥(ribbonKernel D),
      ((actZ τ x : ↥(ribbonKernel D)) : E → ℤ) = fun c => - (x : E → ℤ) (shift c))
    (hQinv : ∀ x y x' y' : ↥(ribbonKernel D),
      ((x' : E → ℤ) = fun c => - (x : E → ℤ) (shift c)) → ((y' : E → ℤ) = fun c => - (y : E → ℤ) (shift c)) →
        𝒰.P.Q x' y' = 𝒰.P.Q x y)
    (hadj : 𝒰.P.HeckeAdjointable H)
    (hinj : Function.Injective ιT) (hrange : ∀ t : T, IsOfFinAddOrder t → t ∈ ιT.range)
    (hgal : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (c : J),
      ιT (gal (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) c) = galT τ (ιT c))
    (hhecke : ∀ (ℓ : Nat.Primes) (u : 𝒰.P.TorusPoints) (c : J), u ∈ 𝒰.P.U → 𝒰.eFull u = ιT c →
      𝒰.eFull (𝒰.P.precomp (heckeKernelMap H ℓ) u) = ιT (hecke (heckeGen ℓ) c))
    (hsign : ∀ x : ↥(ribbonKernel D),
      ((heckeKernelMap H ⟨r, Fact.out⟩ x : ↥(ribbonKernel D)) : E → ℤ) = fun c => - (x : E → ℤ) (shift c)) :
    Nonempty (PeriodUniformization r D H A hA J hecke gal) := by
  obtain ⟨e, he⟩ := exists_e 𝒰 ιT hinj hrange
  exact ⟨{ K := 𝒰.K
           ord := 𝒰.ord
           ord_spec := 𝒰.ord_spec
           inertia_K := 𝒰.inertia_K
           hensel_K := 𝒰.hensel_K
           P := 𝒰.P
           heckeAdj := hadj
           decomp_Q := decomp_Q 𝒰 shift χ hact1 hact2 hQinv
           e := e
           e_surj_torsion := e_surj_torsion 𝒰 ιT e he hinj
           e_torsion := e_torsion 𝒰 ιT e he hinj
           e_ker := e_ker 𝒰 ιT e he hinj
           e_hecke := e_hecke H 𝒰 ιT hecke e he hinj hhecke
           e_inertia := e_inertia 𝒰 ιT gal e he hinj hgal (fun τ hτ => hact1 τ (hinertχ τ hτ))
           e_frob := e_frob H 𝒰 ιT gal e he hinj hgal shift hsq χ hfrobχ hact2 hsign }⟩

