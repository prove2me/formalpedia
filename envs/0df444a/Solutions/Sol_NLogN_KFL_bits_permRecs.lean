  rw [Nat.add_mul, one_mul] at this
  rw [Nat.min_eq_left (by omega)]; ring

theorem length_recsB {R w M : ℕ} {zs : List GI} (hl : zs.length = M * R) (m : ℕ) :
    (recsB R w M zs m).length = R * (2 * (w + 1)) := by
  unfold recsB; split_ifs with h
  · exact length_recB hl h
  · simp

theorem bits_flR_recsB {R w M : ℕ} {zs : List GI} (hl : zs.length = M * R) :
    bitsL w (gflat zs) = flR (recsB R w M zs) M := by
  conv_lhs => rw [← flatMap_chunks R M zs hl]
  rw [gflat_flatMap, bitsL_flatMap]
  exact List.flatMap_congr (fun m hm => by
    simp only [recsB, if_pos (List.mem_range.1 hm), recB])

section Geom

variable {N0 N1 N2 N3 L R w : ℕ}

theorem geoB_pos (h0 : 1 ≤ N0) (h1 : 1 ≤ N1) (h2 : 1 ≤ N2) (h3 : 1 ≤ N3) (hR : 1 ≤ R) :
    (geoB N0 N1 N2 N3 L R w).Pos :=
  ⟨by simp [geoB], h0, h1, h2, h3, by simp only [geoB]; positivity⟩

theorem vol_rect : vol (rect N0 N1 N2 N3 L) = (geoB N0 N1 N2 N3 L R w).recG.V := by
  simp [rect, vol, geoB, Geo.recG, Geo.V, Geo.S0, Geo.S1, Geo.S2]; ring

theorem dig_slot {q : ℕ} (hq : q < vol (rect N0 N1 N2 N3 L)) (t : Fin 3) :
    (decode (rect N0 N1 N2 N3 L) q).getD (slotF t) 0 =
      slotG (trOf (geoB N0 N1 N2 N3 L R w).recG q) t := by
  have hv := valid_decode hq
  have hl : (decode (rect N0 N1 N2 N3 L) q).length = 7 := by rw [length_decode]; rfl
  have := KFH.getD_digit (rect N0 N1 N2 N3 L) (decode (rect N0 N1 N2 N3 L) q) (slotF t) hv
    (by rw [hl]; fin_cases t <;> simp [slotF])
  rw [this, encode_decode hq]
  fin_cases t <;>
    simp [slotF, slotG, trOf, gc, rect, vol, geoB, Geo.recG, Geo.S0, Geo.S1, Geo.S2] <;>
    (congr 2; ring)

theorem vol_slot (t : Fin 3) :
    vol ((rect N0 N1 N2 N3 L).drop (slotF t + 1)) = strd (geoB N0 N1 N2 N3 L R w).recG t := by
  fin_cases t <;> simp [slotF, strd, rect, vol, geoB, Geo.recG, Geo.S0, Geo.S1, Geo.S2] <;> ring

end Geom

theorem slotG_lt {Q : ℕ} {c : Tr} (h : TV Q c) (t : Fin 3) : slotG c t < Q := by
  fin_cases t
  · exact h.1
  · exact h.2.1
  · exact h.2.2

theorem TV_slotS {Q : ℕ} {c : Tr} (h : TV Q c) (t : Fin 3) {v : ℕ} (hv : v < Q) :
    TV Q (slotS c t v) := by
  fin_cases t
  · exact ⟨hv, h.2.1, h.2.2⟩
  · exact ⟨h.1, hv, h.2.2⟩
  · exact ⟨h.1, h.2.1, hv⟩

theorem TV_Fpp {K ρ f L : ℕ} (px py : Fin 3) (c : Tr) (hc : TV (2 ^ L) c) :
    TV (2 ^ L) (Fpp K ρ f px py c) := by
  apply TV_slotS hc
  apply Nat.xor_lt_two_pow (slotG_lt hc py)
  exact lt_of_le_of_lt Nat.and_le_left (slotG_lt hc px)

theorem phi_slotS {g : Geo} (hg : g.Pos) {F : Tr → Tr} (hF : ∀ c, TV g.Q c → TV g.Q (F c))
    (t : Fin 3) (v : Tr → ℕ) (hFv : ∀ c, F c = slotS c t (v c)) (n : ℕ) :
    (phi g F n : ℤ) = n + ((v (trOf g n) : ℤ) - slotG (trOf g n) t) * strd g t := by
  rw [phi_int hg hF, hFv]
  fin_cases t <;> simp [slotS, slotG, strd]

theorem phi_Fpp {N0 N1 N2 N3 K ρ f R w : ℕ} (h0 : 1 ≤ N0) (h1 : 1 ≤ N1) (h2 : 1 ≤ N2)
    (h3 : 1 ≤ N3) (hR : 1 ≤ R) (px py : Fin 3) {q : ℕ}
    (hq : q < vol (rect N0 N1 N2 N3 (f * K))) :
    phi (geoB N0 N1 N2 N3 (f * K) R w).recG (Fpp K ρ f px py) q =
      encode (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py (decode (rect N0 N1 N2 N3 (f * K)) q)) := by
  set g := geoB N0 N1 N2 N3 (f * K) R w
  have hg : g.Pos := geoB_pos h0 h1 h2 h3 hR
  have hF : ∀ c, TV g.recG.Q c → TV g.recG.Q (Fpp K ρ f px py c) := fun c hc => TV_Fpp px py c hc
  have e1 := phi_slotS hg.recG hF py (fun c => slotG c py ^^^ (slotG c px &&& selM K ρ f))
    (fun c => rfl) q
  have hl : (decode (rect N0 N1 N2 N3 (f * K)) q).length = 7 := by rw [length_decode]; rfl
  have e2 := KFH.encode_set (rect N0 N1 N2 N3 (f * K)) (decode (rect N0 N1 N2 N3 (f * K)) q)
    (slotF py) ((decode (rect N0 N1 N2 N3 (f * K)) q).getD (slotF py) 0 ^^^
      ((decode (rect N0 N1 N2 N3 (f * K)) q).getD (slotF px) 0 &&& selMask K ρ f))
    (by rw [hl]; fin_cases py <;> simp [slotF]) (by rw [hl]; rfl)
  rw [encode_decode hq, dig_slot (R := R) (w := w) hq, dig_slot (R := R) (w := w) hq,
    vol_slot (R := R) (w := w)] at e2
  have : (phi g.recG (Fpp K ρ f px py) q : ℤ) =
      (encode (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py
        (decode (rect N0 N1 N2 N3 (f * K)) q)) : ℤ) := by
    rw [e1]; unfold rowAddAddr
    rw [dig_slot (R := R) (w := w) hq, dig_slot (R := R) (w := w) hq, e2]; rfl
  exact_mod_cast this

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD KFB KFH AModel Butterfly
theorem solution {N0 N1 N2 N3 K ρ f R w : ℕ} (h0 : 1 ≤ N0) (h1 : 1 ≤ N1) (h2 : 1 ≤ N2)
    (h3 : 1 ≤ N3) (hR : 1 ≤ R) (px py : Fin 3) (zs : List NLogN.KFB.GI)
    (hl : zs.length = AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R) :
    NLogN.KFL.bitsL w (NLogN.KFB.gflat (NLogN.KFH.permRecs (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) (NLogN.KFH.rowAddAddr K ρ f px py) R zs)) =
      NLogN.KFL.rixT (NLogN.KFL.geoB N0 N1 N2 N3 (f * K) R w) (NLogN.KFL.Fpp K ρ f px py) (NLogN.KFL.bitsL w (NLogN.KFB.gflat zs)) := by
  set g := NLogN.KFL.geoB N0 N1 N2 N3 (f * K) R w
  have hg : g.Pos := NLogN.KFL.geoB_pos h0 h1 h2 h3 hR
  have hM : AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) = g.recG.V := NLogN.KFL.vol_rect
  have hl' : zs.length = g.recG.V * R := by rw [hl, hM]
  have hF : ∀ c, NLogN.KFL.TV g.Q c → NLogN.KFL.TV g.Q (NLogN.KFL.Fpp K ρ f px py c) := fun c hc => NLogN.KFL.TV_Fpp px py c hc
  have hlen : ∀ m, (NLogN.KFL.recsB R w g.recG.V zs m).length = g.B := fun m => NLogN.KFL.length_recsB hl' m
  rw [NLogN.KFL.bits_flR_recsB hl', NLogN.KFL.rixT_flR hg hF hlen]
  unfold NLogN.KFH.permRecs
  rw [NLogN.KFL.gflat_flatMap, NLogN.KFL.bitsL_flatMap, hM]
  unfold NLogN.KFL.flR
  refine List.flatMap_congr (fun q hq => ?_)
  have hq' : q < g.recG.V := List.mem_range.1 hq
  have e := NLogN.KFL.phi_Fpp (R := R) (w := w) (ρ := ρ) h0 h1 h2 h3 hR px py (by rw [hM]; exact hq')
  have hlt : NLogN.KFL.phi g.recG (NLogN.KFL.Fpp K ρ f px py) q < g.recG.V :=
    NLogN.KFL.phi_lt hg.recG (g := g.recG) (fun c hc => NLogN.KFL.TV_Fpp px py c hc) hq'
  rw [NLogN.KFL.recsB, if_pos hlt, NLogN.KFL.recB, e]
end
