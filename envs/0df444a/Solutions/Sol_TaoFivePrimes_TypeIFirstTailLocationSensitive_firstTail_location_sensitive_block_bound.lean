    (hsmall : |firstTailResidual a q beta j| <
      1 / (4 * (q : ℝ))) :
    firstTailActualTag a q beta j = -2 ∨
      firstTailActualTag a q beta j = 0 := by
  have hb := firstTailActualTag_bounds_of_nonneg_beta
    a q j beta hq hj hbeta hbeta0 hsmall
  have hlo : (-3 : ℤ) < firstTailActualTag a q beta j := by
    exact_mod_cast hb.1
  have hhi : firstTailActualTag a q beta j < (1 : ℤ) := by
    exact_mod_cast (show
      ((firstTailActualTag a q beta j : ℤ) : ℝ) < 1 by linarith [hb.2])
  rcases haeven with ⟨u, hu⟩
  let z : ℤ := perturbedPhaseTag a q beta (firstTailPhi a q beta) j +
    (a * firstTailOffset q : ℕ) + u
  have hrepr : firstTailActualTag a q beta j = 2 * z := by
    rw [firstTailActualTag_eq_twice_tag]
    dsimp [z]
    rw [hu]
    push_cast
    ring
  omega
theorem firstTailActualTag_cases_of_even_of_nonpos_beta
    (a q j : ℕ) (beta : ℝ) (hq : 4 ≤ q) (hj : j < q)
    (haeven : Even a)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2) (hbeta0 : beta ≤ 0)
    (hsmall : |firstTailResidual a q beta j| <
      1 / (4 * (q : ℝ))) :
    firstTailActualTag a q beta j = 0 ∨
      firstTailActualTag a q beta j = 2 := by
  have hb := firstTailActualTag_bounds_of_nonpos_beta
    a q j beta hq hj hbeta hbeta0 hsmall
  have hlo : (-1 : ℤ) < firstTailActualTag a q beta j := by
    exact_mod_cast (show (-1 : ℝ) <
      ((firstTailActualTag a q beta j : ℤ) : ℝ) by linarith [hb.1])
  have hhi : firstTailActualTag a q beta j < (3 : ℤ) := by
    exact_mod_cast hb.2
  rcases haeven with ⟨u, hu⟩
  let z : ℤ := perturbedPhaseTag a q beta (firstTailPhi a q beta) j +
    (a * firstTailOffset q : ℕ) + u
  have hrepr : firstTailActualTag a q beta j = 2 * z := by
    rw [firstTailActualTag_eq_twice_tag]
    dsimp [z]
    rw [hu]
    push_cast
    ring
  omega
theorem firstTailActualTag_zero_point
    (a q j : ℕ) (beta : ℝ) (hq : 4 ≤ q) (hj : j < q)
    (haq : Nat.Coprime a q)
    (htag : firstTailActualTag a q beta j = 0) :
    firstTailPoint q j = q := by
  have hq0 : 0 < q := by omega
  have hdivZ : (q : ℤ) ∣ (a * firstTailPoint q j : ℕ) := by
    refine ⟨2 * round
      (perturbedPhase a q beta (firstTailPhi a q beta) j), ?_⟩
    unfold firstTailActualTag at htag
    push_cast at htag ⊢
    linarith
  have hdiv : q ∣ a * firstTailPoint q j := by
    exact_mod_cast hdivZ
  have hqd : q ∣ firstTailPoint q j :=
    (haq.symm.dvd_mul_left).mp hdiv
  obtain ⟨m, hm⟩ := hqd
  have hlow := firstTailPoint_lower q j hq
  have hupp := firstTailPoint_upper q j hq hj
  have hmpos : 0 < m := by
    by_contra hm0
    have : m = 0 := by omega
    rw [this] at hm
    simp at hm
    omega
  have hmle : m ≤ 2 := by
    have hscaled : q * (2 * m) ≤ q * 5 := by
      calc
        q * (2 * m) = 2 * (q * m) := by ac_rfl
        _ = 2 * firstTailPoint q j := by rw [hm]
        _ ≤ 5 * q := hupp
        _ = q * 5 := by ac_rfl
    have htwo : 2 * m ≤ 5 := Nat.le_of_mul_le_mul_left hscaled hq0
    omega
  have hm_cases : m = 1 ∨ m = 2 := by omega
  rcases hm_cases with rfl | rfl
  · simpa using hm
  · rcases firstTailPoint_odd q j with ⟨s, hs⟩
    omega
theorem firstTail_no_zero_and_neg_two_of_nonneg_beta
    (a q j k : ℕ) (beta : ℝ) (hq : 4 ≤ q) (hj : j < q) (hk : k < q)
    (haq : Nat.Coprime a q) (_haeven : Even a)
    (hbeta0 : 0 ≤ beta)
    (hsmallj : |firstTailResidual a q beta j| <
      1 / (4 * (q : ℝ)))
    (hsmallk : |firstTailResidual a q beta k| <
      1 / (4 * (q : ℝ)))
    (htagj : firstTailActualTag a q beta j = 0)
    (htagk : firstTailActualTag a q beta k = -2) : False := by
  have hq0 : 0 < q := by omega
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0
  have hdj := firstTailActualTag_zero_point a q j beta hq hj haq htagj
  have heqj := firstTailActualTag_eq a q beta hq0 j
  rw [htagj, hdj] at heqj
  norm_num at heqj
  have hsj := abs_lt.mp
    (firstTail_scaled_residual_lt_half a q j beta hq0 hsmallj)
  have hzero : (q : ℝ) ^ 2 * beta < 1 / 2 := by
    ring_nf at heqj ⊢
    nlinarith [hsj.2]
  have heqk := firstTailActualTag_eq a q beta hq0 k
  rw [htagk] at heqk
  norm_num at heqk
  have hsk := abs_lt.mp
    (firstTail_scaled_residual_lt_half a q k beta hq0 hsmallk)
  have hlarge : 3 / 2 <
      (q : ℝ) * beta * (firstTailPoint q k : ℝ) := by
    linarith [hsk.1]
  have hdkN := firstTailPoint_upper q k hq hk
  have hdk : (firstTailPoint q k : ℝ) ≤ 5 * (q : ℝ) / 2 := by
    have hdkR : 2 * (firstTailPoint q k : ℝ) ≤ 5 * (q : ℝ) := by
      exact_mod_cast hdkN
    linarith
  have hupp : (q : ℝ) * beta * (firstTailPoint q k : ℝ) < 5 / 4 := by
    calc
      (q : ℝ) * beta * (firstTailPoint q k : ℝ)
          ≤ (q : ℝ) * beta * (5 * (q : ℝ) / 2) := by
            gcongr
      _ = (5 / 2) * ((q : ℝ) ^ 2 * beta) := by ring
      _ < 5 / 4 := by nlinarith
  linarith
theorem firstTail_no_zero_and_two_of_nonpos_beta
    (a q j k : ℕ) (beta : ℝ) (hq : 4 ≤ q) (hj : j < q) (hk : k < q)
    (haq : Nat.Coprime a q) (_haeven : Even a)
    (hbeta0 : beta ≤ 0)
    (hsmallj : |firstTailResidual a q beta j| <
      1 / (4 * (q : ℝ)))
    (hsmallk : |firstTailResidual a q beta k| <
      1 / (4 * (q : ℝ)))
    (htagj : firstTailActualTag a q beta j = 0)
    (htagk : firstTailActualTag a q beta k = 2) : False := by
  have hq0 : 0 < q := by omega
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0
  have hdj := firstTailActualTag_zero_point a q j beta hq hj haq htagj
  have heqj := firstTailActualTag_eq a q beta hq0 j
  rw [htagj, hdj] at heqj
  norm_num at heqj
  have hsj := abs_lt.mp
    (firstTail_scaled_residual_lt_half a q j beta hq0 hsmallj)
  have hzero : (q : ℝ) ^ 2 * (-beta) < 1 / 2 := by
    ring_nf at heqj ⊢
    nlinarith [hsj.1]
  have heqk := firstTailActualTag_eq a q beta hq0 k
  rw [htagk] at heqk
  norm_num at heqk
  have hsk := abs_lt.mp
    (firstTail_scaled_residual_lt_half a q k beta hq0 hsmallk)
  have hlarge : 3 / 2 <
      (q : ℝ) * (-beta) * (firstTailPoint q k : ℝ) := by
    linarith [hsk.2]
  have hdkN := firstTailPoint_upper q k hq hk
  have hdk : (firstTailPoint q k : ℝ) ≤ 5 * (q : ℝ) / 2 := by
    have hdkR : 2 * (firstTailPoint q k : ℝ) ≤ 5 * (q : ℝ) := by
      exact_mod_cast hdkN
    linarith
  have hcoef : 0 ≤ (q : ℝ) * (-beta) := by
    exact mul_nonneg hqR.le (neg_nonneg.mpr hbeta0)
  have hupp : (q : ℝ) * (-beta) * (firstTailPoint q k : ℝ) < 5 / 4 := by
    calc
      (q : ℝ) * (-beta) * (firstTailPoint q k : ℝ)
          ≤ (q : ℝ) * (-beta) * (5 * (q : ℝ) / 2) := by
            exact mul_le_mul_of_nonneg_left hdk hcoef
      _ = (5 / 2) * ((q : ℝ) ^ 2 * (-beta)) := by ring
      _ < 5 / 4 := by nlinarith
  linarith
noncomputable def firstTailNearSet
    (a q : ℕ) (beta : ℝ) : Finset ℕ :=
  (Finset.range q).filter fun j =>
    |firstTailResidual a q beta j| < 1 / (4 * (q : ℝ))
theorem firstTailNearSet_card_le_one
    (a q : ℕ) (beta : ℝ) (hq : 4 ≤ q) (haq : Nat.Coprime a q)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2) :
    (firstTailNearSet a q beta).card ≤ 1 := by
  classical
  apply Finset.card_le_one.2
  intro j hj k hk
  have hj' := Finset.mem_filter.mp hj
  have hk' := Finset.mem_filter.mp hk
  have hjq : j < q := Finset.mem_range.mp hj'.1
  have hkq : k < q := Finset.mem_range.mp hk'.1
  have hinj := firstTailActualTag_injOn a q beta haq
  by_cases haeven : Even a
  · by_cases hbeta0 : 0 ≤ beta
    · have hjcases := firstTailActualTag_cases_of_even_of_nonneg_beta
        a q j beta hq hjq haeven hbeta hbeta0 hj'.2
      have hkcases := firstTailActualTag_cases_of_even_of_nonneg_beta
        a q k beta hq hkq haeven hbeta hbeta0 hk'.2
      rcases hjcases with hjneg | hjzero <;>
        rcases hkcases with hkneg | hkzero
      · exact hinj hj'.1 hk'.1 (hjneg.trans hkneg.symm)
      · exact False.elim (firstTail_no_zero_and_neg_two_of_nonneg_beta
          a q k j beta hq hkq hjq haq haeven hbeta0 hk'.2 hj'.2
          hkzero hjneg)
      · exact False.elim (firstTail_no_zero_and_neg_two_of_nonneg_beta
          a q j k beta hq hjq hkq haq haeven hbeta0 hj'.2 hk'.2
          hjzero hkneg)
      · exact hinj hj'.1 hk'.1 (hjzero.trans hkzero.symm)
    · have hbeta0' : beta ≤ 0 := le_of_not_ge hbeta0
      have hjcases := firstTailActualTag_cases_of_even_of_nonpos_beta
        a q j beta hq hjq haeven hbeta hbeta0' hj'.2
      have hkcases := firstTailActualTag_cases_of_even_of_nonpos_beta
        a q k beta hq hkq haeven hbeta hbeta0' hk'.2
      rcases hjcases with hjzero | hjtwo <;>
        rcases hkcases with hkzero | hktwo
      · exact hinj hj'.1 hk'.1 (hjzero.trans hkzero.symm)
      · exact False.elim (firstTail_no_zero_and_two_of_nonpos_beta
          a q j k beta hq hjq hkq haq haeven hbeta0' hj'.2 hk'.2
          hjzero hktwo)
      · exact False.elim (firstTail_no_zero_and_two_of_nonpos_beta
          a q k j beta hq hkq hjq haq haeven hbeta0' hk'.2 hj'.2
          hkzero hjtwo)
      · exact hinj hj'.1 hk'.1 (hjtwo.trans hktwo.symm)
  · have haodd : Odd a := Nat.not_even_iff_odd.mp haeven
    by_cases hbeta0 : 0 ≤ beta
    · have hjtag := firstTailActualTag_eq_neg_one_of_odd_of_nonneg_beta
        a q j beta hq hjq haodd hbeta hbeta0 hj'.2
      have hktag := firstTailActualTag_eq_neg_one_of_odd_of_nonneg_beta
        a q k beta hq hkq haodd hbeta hbeta0 hk'.2
      exact hinj hj'.1 hk'.1 (hjtag.trans hktag.symm)
    · have hbeta0' : beta ≤ 0 := le_of_not_ge hbeta0
      have hjtag := firstTailActualTag_eq_one_of_odd_of_nonpos_beta
        a q j beta hq hjq haodd hbeta hbeta0' hj'.2
      have hktag := firstTailActualTag_eq_one_of_odd_of_nonpos_beta
        a q k beta hq hkq haodd hbeta hbeta0' hk'.2
      exact hinj hj'.1 hk'.1 (hjtag.trans hktag.symm)
theorem two_abs_residual_le_abs_sin
    (x : ℝ) :
    2 * |x - round x| ≤ |Real.sin (Real.pi * x)| := by
  have hres : |x - round x| ≤ 1 / 2 := abs_sub_round x
  have h := Real.mul_le_sin (x := Real.pi * |x - round x|)
    (by positivity) (by nlinarith [Real.pi_pos])
  have hscale : 2 / Real.pi * (Real.pi * |x - round x|) =
      2 * |x - round x| := by field_simp
  rw [hscale] at h
  rw [abs_sin_pi_eq_sin_pi_abs_sub_round]
  exact h
theorem firstTail_beta_error_le_point_div_q
    (q j : ℕ) (hq : 0 < q) (beta : ℝ)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2) :
    (q : ℝ) * |beta| * (firstTailPoint q j : ℝ) ≤
      (firstTailPoint q j : ℝ) / (q : ℝ) := by
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq
  calc
    (q : ℝ) * |beta| * (firstTailPoint q j : ℝ)
        ≤ (q : ℝ) * (1 / (q : ℝ) ^ 2) *
            (firstTailPoint q j : ℝ) := by gcongr
    _ = (firstTailPoint q j : ℝ) / (q : ℝ) := by field_simp
theorem firstTail_residual_lower_of_point_lt_q
    (a q j : ℕ) (beta : ℝ) (hq : 4 ≤ q) (hj : j < q)
    (haq : Nat.Coprime a q)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hdlt : firstTailPoint q j < q) :
    ((q : ℝ) - (firstTailPoint q j : ℝ)) / (q : ℝ) ^ 2 ≤
      2 * |firstTailResidual a q beta j| := by
  have hq0 : 0 < q := by omega
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0
  have htagne : firstTailActualTag a q beta j ≠ 0 := by
    intro hzero
    have := firstTailActualTag_zero_point a q j beta hq hj haq hzero
    omega
  have htagone : (1 : ℝ) ≤
      |((firstTailActualTag a q beta j : ℤ) : ℝ)| := by
    rcases lt_or_gt_of_ne htagne with hneg | hpos
    · have hle : firstTailActualTag a q beta j ≤ -1 := by omega
      have hleR : ((firstTailActualTag a q beta j : ℤ) : ℝ) ≤ -1 := by
        exact_mod_cast hle
      rw [abs_of_neg (by exact_mod_cast hneg)]
      linarith
    · have hge : 1 ≤ firstTailActualTag a q beta j := by omega
      have hgeR : (1 : ℝ) ≤
          ((firstTailActualTag a q beta j : ℤ) : ℝ) := by exact_mod_cast hge
      rw [abs_of_pos (by exact_mod_cast hpos)]
      exact hgeR
  have htageq := firstTailActualTag_eq a q beta hq0 j
  have htriangle :
      |((firstTailActualTag a q beta j : ℤ) : ℝ)| ≤
        2 * (q : ℝ) * |firstTailResidual a q beta j| +
          (q : ℝ) * |beta| * (firstTailPoint q j : ℝ) := by
    rw [htageq]
    calc
      |2 * (q : ℝ) * firstTailResidual a q beta j -
          (q : ℝ) * beta * (firstTailPoint q j : ℝ)|
          ≤ |2 * (q : ℝ) * firstTailResidual a q beta j| +
              |(q : ℝ) * beta * (firstTailPoint q j : ℝ)| := abs_sub _ _
      _ = 2 * (q : ℝ) * |firstTailResidual a q beta j| +
          (q : ℝ) * |beta| * (firstTailPoint q j : ℝ) := by
            repeat' rw [abs_mul]
            simp [abs_of_pos hqR]
  have herr := firstTail_beta_error_le_point_div_q q j hq0 beta hbeta
  have hmain :
      1 - (firstTailPoint q j : ℝ) / (q : ℝ) ≤
        2 * (q : ℝ) * |firstTailResidual a q beta j| := by
    linarith
  have hscaled :
      ((q : ℝ) - (firstTailPoint q j : ℝ)) / (q : ℝ) ≤
        2 * (q : ℝ) * |firstTailResidual a q beta j| := by
    convert hmain using 1
    all_goals field_simp
  have hdivide :
      (((q : ℝ) - (firstTailPoint q j : ℝ)) / (q : ℝ)) /
          (q : ℝ) ≤ 2 * |firstTailResidual a q beta j| := by
    apply (div_le_iff₀ hqR).2
    simpa [mul_comm, mul_left_comm, mul_assoc] using hscaled
  convert hdivide using 1
  all_goals field_simp
theorem min_divisor_cap_reciprocal_le
    {C B q d : ℝ} (_hC : 0 ≤ C) (hB : 0 ≤ B)
    (hq : 1 ≤ q) (hd : 0 < d) (hdq : d < q) :
    min (C / d + B) (B * q ^ 2 / (q - d)) ≤ C / q + 2 * q * B := by
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  have hqd : 0 < q - d := sub_pos.mpr hdq
  by_cases hcase : C * (q - d) ≤ B * d * q ^ 2
  · refine (min_le_left _ _).trans ?_
    have hexcess : C * (q - d) / (d * q) ≤ B * q := by
      apply (div_le_iff₀ (mul_pos hd hq0)).2
      nlinarith
    have hid : C / d = C / q + C * (q - d) / (d * q) := by
      field_simp
      ring
    rw [hid]
    have hBq : B ≤ q * B := by nlinarith
    nlinarith
  · have hcase' : B * d * q ^ 2 < C * (q - d) := lt_of_not_ge hcase
    refine (min_le_right _ _).trans ?_
    have hpart : B * d * q / (q - d) < C / q := by
      rw [div_lt_div_iff₀ hqd hq0]
      nlinarith
    have hid : B * q ^ 2 / (q - d) =
        B * d * q / (q - d) + B * q := by
      field_simp
      ring
    rw [hid]
    have hBq : B * q ≤ q * B := by rw [mul_comm]
    have hqB : q * B ≤ 2 * q * B := by
      nlinarith [mul_nonneg hq0.le hB]
    linarith
theorem firstTail_safe_term_le_special
    (a q j : ℕ) (beta C B : ℝ) (hq : 4 ≤ q) (hj : j < q)
    (haq : Nat.Coprime a q)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hC : 0 ≤ C) (hB : 0 ≤ B) :
    safeCappedCosecant
        (C / (firstTailPoint q j : ℝ) + B) B
        (Real.pi * perturbedPhase a q beta (firstTailPhi a q beta) j) ≤
      C / (q : ℝ) + 2 * (q : ℝ) * B := by
  let d : ℕ := firstTailPoint q j
  let x : ℝ := perturbedPhase a q beta (firstTailPhi a q beta) j
  have hq0 : 0 < q := by omega
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0
  have hq4R : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
  have hd0N : 0 < d := by dsimp [d, firstTailPoint]; omega
  have hd0 : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd0N
  by_cases hdq : q ≤ d
  · have hdqR : (q : ℝ) ≤ (d : ℝ) := by exact_mod_cast hdq
    have hquot : C / (d : ℝ) ≤ C / (q : ℝ) :=
      div_le_div_of_nonneg_left hC hqR hdqR
    have hBsmall : B ≤ 2 * (q : ℝ) * B := by
      nlinarith [mul_nonneg hqR.le hB]
    exact (safeCappedCosecant_le_cap
      (C / (d : ℝ) + B) B (Real.pi * x)).trans (by linarith)
  · have hdqN : d < q := by omega
    have hdqR : (d : ℝ) < (q : ℝ) := by exact_mod_cast hdqN
    have hres := firstTail_residual_lower_of_point_lt_q
      a q j beta hq hj haq hbeta (by simpa [d] using hdqN)
    have hjordan := two_abs_residual_le_abs_sin x
    have hxres : x - round x = firstTailResidual a q beta j := by
      rfl
    rw [hxres] at hjordan
    have hsine : ((q : ℝ) - (d : ℝ)) / (q : ℝ) ^ 2 ≤
        |Real.sin (Real.pi * x)| := by
      exact hres.trans hjordan
    have hthreshold : 0 < ((q : ℝ) - (d : ℝ)) / (q : ℝ) ^ 2 := by
      positivity
    have hsinepos : 0 < |Real.sin (Real.pi * x)| :=
      hthreshold.trans_le hsine
    have hsinne : Real.sin (Real.pi * x) ≠ 0 := by
      intro hs
      simp [hs] at hsinepos
    have hrecip : safeCappedCosecant
          (C / (d : ℝ) + B) B (Real.pi * x) ≤
        B * (q : ℝ) ^ 2 / ((q : ℝ) - (d : ℝ)) := by
      calc
        safeCappedCosecant (C / (d : ℝ) + B) B (Real.pi * x)
            ≤ B / |Real.sin (Real.pi * x)| :=
              safeCappedCosecant_le_reciprocal_of_ne hsinne
        _ ≤ B / (((q : ℝ) - (d : ℝ)) / (q : ℝ) ^ 2) :=
          div_le_div_of_nonneg_left hB hthreshold hsine
        _ = B * (q : ℝ) ^ 2 / ((q : ℝ) - (d : ℝ)) := by
          field_simp
    have hcap := safeCappedCosecant_le_cap
      (C / (d : ℝ) + B) B (Real.pi * x)
    have hmin : safeCappedCosecant
          (C / (d : ℝ) + B) B (Real.pi * x) ≤
        min (C / (d : ℝ) + B)
          (B * (q : ℝ) ^ 2 / ((q : ℝ) - (d : ℝ))) :=
      le_min hcap hrecip
    exact hmin.trans (min_divisor_cap_reciprocal_le hC hB
      (by exact_mod_cast (show 1 ≤ q by omega)) hd0 hdqR)
theorem firstTail_safe_term_le_two_q_B_of_not_near
    (a q j : ℕ) (beta C B : ℝ) (hq : 4 ≤ q) (_hj : j < q)
    (hB : 0 ≤ B)
    (hfar : 1 / (4 * (q : ℝ)) ≤
      |firstTailResidual a q beta j|) :
    safeCappedCosecant
        (C / (firstTailPoint q j : ℝ) + B) B
        (Real.pi * perturbedPhase a q beta (firstTailPhi a q beta) j) ≤
      2 * (q : ℝ) * B := by
  let x : ℝ := perturbedPhase a q beta (firstTailPhi a q beta) j
  have hq0 : 0 < q := by omega
  have hqR : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0
  have hjordan := two_abs_residual_le_abs_sin x
  have hxres : x - round x = firstTailResidual a q beta j := by rfl
  rw [hxres] at hjordan
  have hthreshold : 0 < 1 / (2 * (q : ℝ)) := by positivity
  have hsine : 1 / (2 * (q : ℝ)) ≤ |Real.sin (Real.pi * x)| := by
    have hscale : 2 * (1 / (4 * (q : ℝ))) =
        1 / (2 * (q : ℝ)) := by field_simp; norm_num
    rw [← hscale]
    exact (mul_le_mul_of_nonneg_left hfar (by norm_num)).trans hjordan
  have hsinepos : 0 < |Real.sin (Real.pi * x)| := hthreshold.trans_le hsine
  have hsinne : Real.sin (Real.pi * x) ≠ 0 := by
    intro hs
    simp [hs] at hsinepos
  calc
    safeCappedCosecant
        (C / (firstTailPoint q j : ℝ) + B) B (Real.pi * x)
        ≤ B / |Real.sin (Real.pi * x)| :=
          safeCappedCosecant_le_reciprocal_of_ne hsinne
    _ ≤ B / (1 / (2 * (q : ℝ))) :=
      div_le_div_of_nonneg_left hB hthreshold hsine
    _ = 2 * (q : ℝ) * B := by field_simp
theorem firstTail_location_sensitive_block_bound
    (a q : ℕ) (beta C B : ℝ) (hq : 4 ≤ q) (haq : Nat.Coprime a q)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hC : 0 ≤ C) (hB : 0 ≤ B) :
    (∑ j ∈ Finset.range q,
      safeCappedCosecant
        (C / (firstTailPoint q j : ℝ) + B) B
        (Real.pi * perturbedPhase a q beta (firstTailPhi a q beta) j)) ≤
      C / (q : ℝ) +
        B * ((2 / Real.pi) * (q : ℝ) * Real.log (4 * (q : ℝ)) +
          4 * (q : ℝ)) := by
  classical
  have hq2 : 2 ≤ q := by omega
  have hq0N : 0 < q := by omega
  have hq0 : (0 : ℝ) < (q : ℝ) := by exact_mod_cast hq0N
  let phase : ℕ → ℝ := fun j =>
    Real.pi * perturbedPhase a q beta (firstTailPhi a q beta) j
  let term : ℕ → ℝ := fun j =>
    safeCappedCosecant (C / (firstTailPoint q j : ℝ) + B) B (phase j)
  obtain ⟨e, rank, hes, hecard, hinj, hrange, hsep⟩ :=
    perturbed_grid_sine_rank_certificate a q hq2 haq beta
      (firstTailPhi a q beta) hbeta
  let gridTerm : ℕ → ℝ := fun r =>
    B / Real.sin (Real.pi * (r : ℝ) / (2 * (q : ℝ)))
  have hgridpos : ∀ r ∈ Finset.Ico 1 (q - 1),
      0 < Real.sin (Real.pi * (r : ℝ) / (2 * (q : ℝ))) := by
    intro r hr
    simp only [Finset.mem_Ico] at hr
    have hr0 : (0 : ℝ) < (r : ℝ) := by exact_mod_cast hr.1
    have hrq : (r : ℝ) < (q : ℝ) := by
      exact_mod_cast (lt_of_lt_of_le hr.2 (Nat.sub_le q 1))
    apply Real.sin_pos_of_pos_of_lt_pi
    · positivity
    · apply (div_lt_iff₀ (by positivity : (0 : ℝ) < 2 * (q : ℝ))).2
      nlinarith [Real.pi_pos]
  have hnonexceptional :
      (∑ j ∈ Finset.range q \ e, term j) ≤
        ∑ r ∈ Finset.Ico 1 (q - 1), gridTerm r := by
    have hpoint : ∀ j ∈ Finset.range q \ e,
        term j ≤ gridTerm (rank j) := by
      intro j hj
      have hr := hrange j hj
      have hg0 := hgridpos (rank j) hr
      have hspos : 0 < |Real.sin (phase j)| :=
        lt_of_lt_of_le hg0 (hsep j hj)
      have hsne : Real.sin (phase j) ≠ 0 := by
        intro hs
        simp [hs] at hspos
      refine (safeCappedCosecant_le_reciprocal_of_ne hsne).trans ?_
      exact div_le_div_of_nonneg_left hB hg0 (hsep j hj)
    calc
      (∑ j ∈ Finset.range q \ e, term j)
          ≤ ∑ j ∈ Finset.range q \ e, gridTerm (rank j) :=
            Finset.sum_le_sum hpoint
      _ = ∑ r ∈ (Finset.range q \ e).image rank, gridTerm r := by
        symm
        exact Finset.sum_image hinj
      _ ≤ ∑ r ∈ Finset.Ico 1 (q - 1), gridTerm r := by
        have himage : (Finset.range q \ e).image rank ⊆
            Finset.Ico 1 (q - 1) := by
          intro r hr
          obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hr
          exact hrange j hj
        calc
          (∑ r ∈ (Finset.range q \ e).image rank, gridTerm r)
              ≤ (∑ r ∈ Finset.Ico 1 (q - 1) \
                    (Finset.range q \ e).image rank, gridTerm r) +
                  ∑ r ∈ (Finset.range q \ e).image rank, gridTerm r := by
                apply le_add_of_nonneg_left
                apply Finset.sum_nonneg
                intro r hr
                exact div_nonneg hB (hgridpos r
                  ((Finset.mem_sdiff.mp hr).1)).le
          _ = ∑ r ∈ Finset.Ico 1 (q - 1), gridTerm r :=
            Finset.sum_sdiff himage
  have hgrid : (∑ r ∈ Finset.Ico 1 (q - 1), gridTerm r) ≤
      (2 / Real.pi) * B * (q : ℝ) * Real.log (4 * (q : ℝ)) := by
    have hcsc := half_grid_cosecant_sum_le q hq2
    have hscaled := mul_le_mul_of_nonneg_left hcsc hB
    unfold gridTerm
    calc
      (∑ r ∈ Finset.Ico 1 (q - 1),
          B / Real.sin (Real.pi * (r : ℝ) / (2 * (q : ℝ)))) =
          B * (∑ r ∈ Finset.Ico 1 (q - 1),
            1 / Real.sin (Real.pi * (r : ℝ) / (2 * (q : ℝ)))) := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro r hr
              simp only [div_eq_mul_inv, one_mul]
      _ ≤ B * ((2 / Real.pi) * (q : ℝ) *
            Real.log (4 * (q : ℝ))) := hscaled
      _ = (2 / Real.pi) * B * (q : ℝ) *
            Real.log (4 * (q : ℝ)) := by ring
  let z : Finset ℕ := e.filter fun j =>
    |firstTailResidual a q beta j| < 1 / (4 * (q : ℝ))
  have hzsub : z ⊆ e := Finset.filter_subset _ _
  have hznear : z ⊆ firstTailNearSet a q beta := by
    intro j hj
    have hj' := Finset.mem_filter.mp hj
    exact Finset.mem_filter.mpr ⟨hes hj'.1, hj'.2⟩
  have hzcard : z.card ≤ 1 :=
    (Finset.card_le_card hznear).trans
      (firstTailNearSet_card_le_one a q beta hq haq hbeta)
  have hspecial : ∀ j ∈ z,
      term j ≤ C / (q : ℝ) + 2 * (q : ℝ) * B := by
    intro j hj
    have hjq : j < q := Finset.mem_range.mp (hes (hzsub hj))
    exact firstTail_safe_term_le_special a q j beta C B hq hjq haq
      hbeta hC hB
  have hfar : ∀ j ∈ e \ z, term j ≤ 2 * (q : ℝ) * B := by
    intro j hj
    have hje : j ∈ e := (Finset.mem_sdiff.mp hj).1
    have hjz : j ∉ z := (Finset.mem_sdiff.mp hj).2
    have hjq : j < q := Finset.mem_range.mp (hes hje)
    have hnotnear : 1 / (4 * (q : ℝ)) ≤
        |firstTailResidual a q beta j| := by
      dsimp [z] at hjz
      simp only [Finset.mem_filter, hje, true_and, not_lt] at hjz
      exact hjz
    exact firstTail_safe_term_le_two_q_B_of_not_near
      a q j beta C B hq hjq hB hnotnear
  have hexceptional : (∑ j ∈ e, term j) ≤
      C / (q : ℝ) + 4 * (q : ℝ) * B := by
    have hCq : 0 ≤ C / (q : ℝ) := div_nonneg hC hq0.le
    have hqB : 0 ≤ 2 * (q : ℝ) * B := by positivity
    by_cases hze : z = ∅
    · have hez : e \ z = e := by simp [hze]
      have hall : ∀ j ∈ e, term j ≤ 2 * (q : ℝ) * B := by
        intro j hj
        exact hfar j (by simpa [hez] using hj)
      calc
        (∑ j ∈ e, term j) ≤ ∑ _j ∈ e, 2 * (q : ℝ) * B :=
          Finset.sum_le_sum hall
        _ = (e.card : ℝ) * (2 * (q : ℝ) * B) := by
          rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ 2 * (2 * (q : ℝ) * B) := by
          apply mul_le_mul_of_nonneg_right _ hqB
          exact_mod_cast hecard
        _ ≤ C / (q : ℝ) + 4 * (q : ℝ) * B := by nlinarith
    · have hznon : z.Nonempty := Finset.nonempty_iff_ne_empty.mpr hze
      have hzcardeq : z.card = 1 := by
        have : 0 < z.card := Finset.card_pos.mpr hznon
        omega
      have hdiffcard : (e \ z).card ≤ 1 := by
        rw [Finset.card_sdiff_of_subset hzsub, hzcardeq]
        omega
      have hspecialNonneg :
          0 ≤ C / (q : ℝ) + 2 * (q : ℝ) * B := by positivity
      calc
        (∑ j ∈ e, term j) =
            (∑ j ∈ e \ z, term j) + ∑ j ∈ z, term j := by
              symm
              exact Finset.sum_sdiff hzsub
        _ ≤ (∑ _j ∈ e \ z, 2 * (q : ℝ) * B) +
              ∑ _j ∈ z, (C / (q : ℝ) + 2 * (q : ℝ) * B) :=
            add_le_add (Finset.sum_le_sum hfar) (Finset.sum_le_sum hspecial)
        _ = ((e \ z).card : ℝ) * (2 * (q : ℝ) * B) +
              (z.card : ℝ) * (C / (q : ℝ) + 2 * (q : ℝ) * B) := by
            simp only [Finset.sum_const, nsmul_eq_mul]
        _ ≤ 1 * (2 * (q : ℝ) * B) +
              1 * (C / (q : ℝ) + 2 * (q : ℝ) * B) := by
            apply add_le_add
            · apply mul_le_mul_of_nonneg_right _ hqB
              exact_mod_cast hdiffcard
            · norm_num [hzcardeq]
        _ = C / (q : ℝ) + 4 * (q : ℝ) * B := by ring
  change (∑ j ∈ Finset.range q, term j) ≤ _
  calc
    (∑ j ∈ Finset.range q, term j) =
        (∑ j ∈ Finset.range q \ e, term j) + ∑ j ∈ e, term j := by
          symm
          exact Finset.sum_sdiff hes
    _ ≤ (∑ r ∈ Finset.Ico 1 (q - 1), gridTerm r) +
          (C / (q : ℝ) + 4 * (q : ℝ) * B) :=
      add_le_add hnonexceptional hexceptional
    _ ≤ (2 / Real.pi) * B * (q : ℝ) * Real.log (4 * (q : ℝ)) +
          (C / (q : ℝ) + 4 * (q : ℝ) * B) := add_le_add hgrid le_rfl
    _ = C / (q : ℝ) +
        B * ((2 / Real.pi) * (q : ℝ) * Real.log (4 * (q : ℝ)) +
          4 * (q : ℝ)) := by ring
end TaoFivePrimes.TypeIFirstTailLocationSensitive
