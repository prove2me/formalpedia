section
-- Source module: Solutions.ButterflyLayer
/-!
# §5 The simultaneous butterfly layer as an array denotation

The array has complete address set `[P] × [2^K]^D × [S]` (shape `layerShape P K D S`), in
lexicographic order, one record per address. Records live in a complex vector space `M`
(a record of `r` coefficients is `Fin r → ℂ`; its sup norm is the maximum coefficient norm, and
every operator below acts coefficientwise because it is `ℂ`-linear on records).

On each of the `D` chunks, bit `ρ` (from the least significant end) is selected.
A matrix `T` on the selected bits acts by
`(selOp T xs)(a) = ∑_y T(bits a, y) • xs(a with selected bits y)`,
fixing every unselected bit and both spectator fields.

* `selOp_mul`, `selOp_one`, `selOp_list_prod`: composition = matrix product.
* `selOp_diagonal`: diagonals are pointwise maps (the phase `S_D`, the signs `Z^{⊗}`).
* `kernel_pair`: an individual selected-bit kernel is the paired map of (25) on the two
  aligned streams split at that bit.
* `layer_eq_kernels`: the layer `A^{⊗D}` is the composition of the `D` individual kernels.
* `butterflyLayer_eq` (18 on arrays): `H0`-layer `= b^D • S_D ∘ C-layer ∘ S_D`.
* `butterflyLayer_norm_le`: disk arrays go to disk arrays.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open AModel Matrix Finset

/-! ## 1. Abstract selected-bit structure on a shape -/

/-- Selected bits of a shape: read them (`bits`) and overwrite them (`set`). -/
structure SelBits (sh : Shape) (ι : Type*) where
  bits : List ℕ → ι → Fin 2
  set : List ℕ → (ι → Fin 2) → List ℕ
  valid_set : ∀ a y, Valid sh a → Valid sh (set a y)
  bits_set : ∀ a y, Valid sh a → bits (set a y) = y
  set_set : ∀ a y z, Valid sh a → set (set a y) z = set a z
  set_bits : ∀ a, Valid sh a → set a (bits a) = a

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

/-- A matrix on the selected bits acting on the array (coefficientwise on records). -/
noncomputable def selOp (Sb : SelBits sh ι) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    (xs : List M) : List M :=
  (List.range (vol sh)).map fun j =>
    ∑ y, T (Sb.bits (decode sh j)) y • xs.getD (encode sh (Sb.set (decode sh j) y)) 0

variable (Sb : SelBits sh ι)

/-! ## 2. Individual kernels and the full layer -/

/-- The individual kernel of `A` on selected bit `i`: `A` on bit `i`, identity elsewhere. -/
def kerAt (i : ι) (A : M2) : ι → M2 := Function.update (fun _ => 1) i A

/-- The normalized simultaneous butterfly layer `H0^{⊗D}`. -/
noncomputable def butterflyLayer (xs : List M) : List M := selOp Sb (Butterfly.tens H0) xs

/-- The `C`-layer `C^{⊗D}`. -/
noncomputable def cLayer (xs : List M) : List M := selOp Sb (Butterfly.tens Butterfly.Cm) xs

/-- The phase layer `S_D` (pointwise). -/
noncomputable def phaseLayer (xs : List M) : List M := selOp Sb SD xs

/-! ## 3. The concrete layout `[P] × [2^K]^D × [S]` with bit `ρ` selected in every chunk -/

/-- The shape `[P] × [2^K]^D × [S]`. -/
def layerShape (P K D S : ℕ) : Shape := P :: List.replicate D (2 ^ K) ++ [S]

/-- Bit `ρ` of `v` (from the least significant end). -/
def getBit (ρ v : ℕ) : Fin 2 := ⟨(v / 2 ^ ρ) % 2, Nat.mod_lt _ (by norm_num)⟩

/-- Overwrite bit `ρ` of `v` by `b`. -/
def setBit (ρ v : ℕ) (b : Fin 2) : ℕ := v / 2 ^ (ρ + 1) * 2 ^ (ρ + 1) + (b : ℕ) * 2 ^ ρ + v % 2 ^ ρ

section BitArith

lemma setBit_eq (ρ v : ℕ) (b : Fin 2) :
    setBit ρ v b = (2 * (v / 2 ^ (ρ + 1)) + b) * 2 ^ ρ + v % 2 ^ ρ := by
  simp only [setBit, pow_succ]; ring

lemma setBit_div (ρ v : ℕ) (b : Fin 2) : setBit ρ v b / 2 ^ ρ = 2 * (v / 2 ^ (ρ + 1)) + b := by
  rw [setBit_eq, Nat.add_comm, Nat.add_mul_div_right _ _ (by positivity),
    Nat.div_eq_of_lt (Nat.mod_lt _ (by positivity)), zero_add]

lemma setBit_mod (ρ v : ℕ) (b : Fin 2) : setBit ρ v b % 2 ^ ρ = v % 2 ^ ρ := by
  rw [setBit_eq, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_mod]

lemma getBit_setBit (ρ v : ℕ) (b : Fin 2) : getBit ρ (setBit ρ v b) = b := by
  ext; simp only [getBit, setBit_div]
  have := b.isLt; omega

lemma div_two_pow_succ (ρ v : ℕ) : v / 2 ^ (ρ + 1) = v / 2 ^ ρ / 2 := by
  rw [pow_succ, Nat.div_div_eq_div_mul]

lemma setBit_setBit (ρ v : ℕ) (b c : Fin 2) : setBit ρ (setBit ρ v b) c = setBit ρ v c := by
  have h1 : setBit ρ v b / 2 ^ (ρ + 1) = v / 2 ^ (ρ + 1) := by
    rw [div_two_pow_succ, setBit_div]; have := b.isLt; omega
  rw [setBit_eq ρ (setBit ρ v b) c, h1, setBit_mod, ← setBit_eq]

lemma setBit_getBit (ρ v : ℕ) : setBit ρ v (getBit ρ v) = v := by
  have h := Nat.div_add_mod v (2 ^ ρ)
  have h2 := Nat.div_add_mod (v / 2 ^ ρ) 2
  rw [setBit_eq, div_two_pow_succ]
  simp only [getBit]
  calc (2 * (v / 2 ^ ρ / 2) + (v / 2 ^ ρ) % 2) * 2 ^ ρ + v % 2 ^ ρ
      = (v / 2 ^ ρ) * 2 ^ ρ + v % 2 ^ ρ := by rw [h2]
    _ = v := by rw [Nat.mul_comm]; exact h

lemma setBit_lt {ρ K v : ℕ} (hρ : ρ < K) (hv : v < 2 ^ K) (b : Fin 2) : setBit ρ v b < 2 ^ K := by
  have hP : 0 < 2 ^ ρ := by positivity
  have hK : 2 ^ K = 2 ^ (ρ + 1) * 2 ^ (K - (ρ + 1)) := by rw [← pow_add]; congr 1; omega
  have hq : v / 2 ^ (ρ + 1) < 2 ^ (K - (ρ + 1)) := by
    rw [Nat.div_lt_iff_lt_mul (by positivity), Nat.mul_comm, ← hK]; exact hv
  have hr := Nat.mod_lt v hP
  rw [setBit_eq, hK, pow_succ]
  have hb := b.isLt
  have : (2 * (v / 2 ^ (ρ + 1)) + b) * 2 ^ ρ + v % 2 ^ ρ < (2 * (v / 2 ^ (ρ + 1)) + 2) * 2 ^ ρ := by
    nlinarith
  calc _ < (2 * (v / 2 ^ (ρ + 1)) + 2) * 2 ^ ρ := this
    _ = 2 ^ ρ * 2 * (v / 2 ^ (ρ + 1) + 1) := by ring
    _ ≤ 2 ^ ρ * 2 * 2 ^ (K - (ρ + 1)) := Nat.mul_le_mul_left _ hq

end BitArith

section Layout

variable (P K D S ρ : ℕ)

/-- Address normal form `p :: c₀ … c_{D-1} :: [s]`. -/
def mkAddr (p : ℕ) (c : Fin D → ℕ) (s : ℕ) : List ℕ := p :: (List.ofFn c ++ [s])

lemma getD_mkAddr_chunk (p : ℕ) (c : Fin D → ℕ) (s : ℕ) (i : Fin D) :
    (mkAddr D p c s).getD (i + 1) 0 = c i := by
  simp [mkAddr, List.getD_eq_getElem?_getD, List.getElem?_append_left (by simp : (i : ℕ) < (List.ofFn c).length)]

lemma getD_mkAddr_last (p : ℕ) (c : Fin D → ℕ) (s : ℕ) :
    (mkAddr D p c s).getD (D + 1) 0 = s := by
  simp [mkAddr, List.getD_eq_getElem?_getD, List.getElem?_append_right]

lemma headD_mkAddr (p : ℕ) (c : Fin D → ℕ) (s : ℕ) : (mkAddr D p c s).headD 0 = p := rfl

lemma eq_mkAddr {a : List ℕ} (h : a.length = D + 2) :
    a = mkAddr D (a.headD 0) (fun i => a.getD (i + 1) 0) (a.getD (D + 1) 0) := by
  apply List.ext_getElem (by simp [mkAddr, h])
  intro k h₁ h₂
  rcases k with _ | k
  · cases a with
    | nil => simp at h
    | cons x l => simp [mkAddr]
  · simp only [mkAddr, List.getElem_cons_succ]
    by_cases hk : k < D
    · rw [List.getElem_append_left (by simpa using hk)]
      simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h₁]
    · have hk' : k = D := by rw [h] at h₁; omega
      subst hk'
      rw [List.getElem_append_right (by simp)]
      simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h₁]

lemma valid_layer_iff {a : List ℕ} :
    Valid (layerShape P K D S) a ↔ a.length = D + 2 ∧ a.headD 0 < P ∧
      (∀ i : Fin D, a.getD (i + 1) 0 < 2 ^ K) ∧ a.getD (D + 1) 0 < S := by
  constructor
  · intro hv
    have hl : a.length = D + 2 := by rw [hv.length_eq]; simp [layerShape]
    rw [eq_mkAddr D hl] at hv
    refine ⟨hl, ?_, ?_, ?_⟩
    · have := (valid_iff _ _).1 hv
      have h0 := this.2 0 (by simp [mkAddr]) (by simp [layerShape])
      simpa [mkAddr, layerShape] using h0
    · intro i
      have := ((valid_iff _ _).1 hv).2 (i + 1) (by simp [mkAddr]) (by simp [layerShape])
      rw [← getD_mkAddr_chunk D (a.headD 0) (fun i => a.getD (i + 1) 0) (a.getD (D + 1) 0) i]
      rw [List.getD_eq_getElem _ _ (by simp [mkAddr])]
      simpa [layerShape, List.getElem_append_left, mkAddr] using this
    · have := ((valid_iff _ _).1 hv).2 (D + 1) (by simp [mkAddr]) (by simp [layerShape])
      rw [← getD_mkAddr_last D (a.headD 0) (fun i => a.getD (i + 1) 0) (a.getD (D + 1) 0)]
      rw [List.getD_eq_getElem _ _ (by simp [mkAddr])]
      simpa [layerShape, List.getElem_append_right, mkAddr] using this
  · rintro ⟨hl, hp, hc, hs⟩
    rw [valid_iff]
    refine ⟨by simp [hl, layerShape], ?_⟩
    intro k h₁ h₂
    rcases k with _ | k
    · cases a with
      | nil => simp at hl
      | cons x l => simpa [layerShape] using hp
    · simp only [layerShape, List.getElem_cons_succ]
      by_cases hk : k < D
      · rw [List.getElem_append_left (by simpa using hk)]
        have := hc ⟨k, hk⟩
        simpa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h₁] using this
      · have hk' : k = D := by rw [hl] at h₁; omega
        subst hk'
        rw [List.getElem_append_right (by simp)]
        simpa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h₁] using hs

/-- Selected bits of an address: bit `ρ` of each chunk. -/
def layerBits (a : List ℕ) (i : Fin D) : Fin 2 := getBit ρ (a.getD (i + 1) 0)

/-- Overwrite the selected bits. -/
def layerSet (a : List ℕ) (y : Fin D → Fin 2) : List ℕ :=
  mkAddr D (a.headD 0) (fun i => setBit ρ (a.getD (i + 1) 0) (y i)) (a.getD (D + 1) 0)

/-- The selected-bit structure of `[P] × [2^K]^D × [S]` with offset `ρ < K`. -/
def layerSel (hρ : ρ < K) : SelBits (layerShape P K D S) (Fin D) where
  bits := layerBits D ρ
  set := layerSet D ρ
  valid_set a y ha := by
    obtain ⟨hl, hp, hc, hs⟩ := (valid_layer_iff P K D S).1 ha
    refine (valid_layer_iff P K D S).2 ⟨by simp [layerSet, mkAddr], hp, fun i => ?_, ?_⟩
    · rw [layerSet, getD_mkAddr_chunk]; exact setBit_lt hρ (hc i) _
    · rw [layerSet, getD_mkAddr_last]; exact hs
  bits_set a y _ := by
    funext i; simp only [layerBits, layerSet, getD_mkAddr_chunk, getBit_setBit]
  set_set a y z _ := by
    simp only [layerSet, getD_mkAddr_chunk, getD_mkAddr_last, headD_mkAddr, setBit_setBit]
  set_bits a ha := by
    obtain ⟨hl, -⟩ := (valid_layer_iff P K D S).1 ha
    conv_rhs => rw [eq_mkAddr D hl]
    simp only [layerSet, layerBits, setBit_getBit]

/-- **The simultaneous normalized butterfly layer** of §5 on `[P] × [2^K]^D × [S]`:
`H0^{⊗D}` on bit `ρ` of each of the `D` chunks, coefficientwise, fixing all other bits. -/
noncomputable def layerH (hρ : ρ < K) (xs : List M) : List M :=
  butterflyLayer (layerSel P K D S ρ hρ) xs

end Layout

end Butterfly

end

