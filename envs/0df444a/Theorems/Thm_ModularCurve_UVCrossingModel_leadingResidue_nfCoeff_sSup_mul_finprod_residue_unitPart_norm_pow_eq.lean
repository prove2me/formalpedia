-- title:
--   End-ratio reciprocity on the crossing model W[[U,V]]/(UV-varpi^e)
-- statement:
--   Let $W$ be a commutative domain that is a discrete valuation ring, complete for the adic topology of its maximal ideal, let $\varpi\in W$ be irreducible and let $e\ge 1$. Write $R=$ `UVCrossingModel W (ϖ ^ e)`, the quotient of $W[[X_0,X_1]]$ by the ideal generated by $X_0X_1-\varpi^e$. Let $x\in R$ be non-zero and let $ab=(a,b)$ be a pair of one-variable power series over $W$ with $b$ of zero constant term whose image $a(U)+b(V)$ in $R$ is $x$. The coefficient function `nfCoeff ab` on $\mathbb{Z}$ is $n\mapsto a_n$ for $n\ge 0$ and $n\mapsto b_{-n}$ for $n<0$; for $t\in\{0,e\}$ the set `dominantIndices (addVal W) e t ab` consists of those $n$ for which the valuation of `nfCoeff ab n` plus the annulus weight of the corresponding monomial equals the Gauss order, at parameter $t$, of the representative $a(U)+b(V)$. Let $M=\sup$ of the dominant indices at $t=e$ and $m=\inf$ of those at $t=0$. For a prime $Q$ of $R$ put $u_Q=$ `unitPart ϖ` of $\mathrm{Algebra.norm}_W$ of the image of $V$ in $R/Q$, and let $\ell_Q$ be the length, over the localisation of $R$ at $Q$, of the localisation of $R/xR$ at $Q$, coerced to $\mathbb{N}$. Then `leadingResidue ϖ (nfCoeff ab M)` — the residue class of the unit part of that coefficient, or $0$ if the coefficient vanishes — multiplied by the finite product of the residues of $u_Q^{\ell_Q}$ over all primes $Q$ with $Q\ne 0$, `const (ϖ ^ e) ϖ ∉ Q` and $x\in Q$, equals $(-1)^{(m-M).\mathrm{toNat}}$ times `leadingResidue ϖ (nfCoeff ab m)`. No unit-coefficient or genericity hypothesis on $x$ beyond $x\ne 0$ is assumed.
--
--   This is the reciprocity law comparing the two end coefficients of the normal form of an element of the crossing model $W[[U,V]]/(UV-\varpi^e)$: their leading residues differ by the sign $(-1)^{h}$, where $h$ is the total number of horizontal zeros counted by the difference of the extreme dominant indices, and by the product of the residual angular parts of the $V$-norms of those zeros, taken with their multiplicities. It strengthens the version proved under a unit-coefficient assumption on the normal form, and is used in the analysis of prolongation tuples for place specialisations, where ratios of residues of the two components must be matched with an angular factor under inertia-stability.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_UVCrossingModel_leadingResidue_nfCoeff_sSup_mul_finprod_residue_unitPart_norm_pow_eq.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingInitialForm

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open ModularCurve ModularCurve.UVCrossingModel IsLocalRing

theorem ModularCurve.UVCrossingModel.leadingResidue_nfCoeff_sSup_mul_finprod_residue_unitPart_norm_pow_eq
    {W : Type u} [CommRing W] [IsDomain W] [IsDiscreteValuationRing W] [IsAdicComplete (maximalIdeal W) W]
    (ϖ : W) (hϖ : Irreducible ϖ) (e : ℕ) (he : 1 ≤ e)
    (x : UVCrossingModel W (ϖ ^ e)) (hx : x ≠ 0)
    (ab : PowerSeries W × PowerSeries W) (hb : PowerSeries.constantCoeff ab.2 = 0)
    (habx : mk (ϖ ^ e) (inU ab.1 + inV ab.2) = x) :
    leadingResidue ϖ (nfCoeff ab (sSup (dominantIndices (IsDiscreteValuationRing.addVal W) e e ab))) *
        ∏ᶠ (Q : PrimeSpectrum (UVCrossingModel W (ϖ ^ e)))
          (_ : Q.asIdeal ≠ ⊥ ∧ const (ϖ ^ e) ϖ ∉ Q.asIdeal ∧ x ∈ Q.asIdeal),
          residue W (unitPart ϖ (Algebra.norm W (Ideal.Quotient.mk Q.asIdeal (V (ϖ ^ e))))) ^
            (Module.length (Localization.AtPrime Q.asIdeal)
              (LocalizedModule Q.asIdeal.primeCompl (UVCrossingModel W (ϖ ^ e) ⧸ Ideal.span {x}))).toNat =
      (-1) ^ (sInf (dominantIndices (IsDiscreteValuationRing.addVal W) e 0 ab) -
          sSup (dominantIndices (IsDiscreteValuationRing.addVal W) e e ab)).toNat *
        leadingResidue ϖ (nfCoeff ab (sInf (dominantIndices (IsDiscreteValuationRing.addVal W) e 0 ab))) := by sorry
