theorem NLogN.encP_run (s : IState HS) (P : ℕ) (blk : List (ℤ × ℤ)) (R LR LM LW LF : List Item)
    (F : ℤ) (hU : s.G GU = gints blk ++ R) (hR : s.G CR = .int (2 ^ P) :: LR)
    (hM : s.G CM = .int blk.length :: LM)
    (hW : s.G RW = .int (2 ^ (2 * blk.length * P)) :: LW) (hF : s.G FR = .int F :: LF) :
    encP.run s = (s.upd GU R).upd EO
      (.int (if encRaw P blk < 0 then encRaw P blk + F else encRaw P blk) :: s.G EO) := by sorry
