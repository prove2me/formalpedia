-- url     : https://prove2.me/theorems/9f646d24-81cc-4336-a372-11167b7c10f5
-- title:
--   Counts (1.1), estimator (1.2), ∞-norm, return times (Definition 2), mixing coefficients (2.1)–(2.2), Assumptions 1, 2, 4, ρ★ and the constants of Theorem 2 (pp. 3, 7–14)
-- statement:
--   Fix a controlled Markov chain $\{(X_i,a_i)\}$ with $d$ states, $k$ controls and transition matrices $M^{(l)}$. Fix a sample length $m$.
--
--   **Counts and estimator** (eqs. (1.1)–(1.2)). For a state $s$, a control $l$ and a state $t$,
--   $$
--   N^{(l)}_s=\sum_{i=1}^m \mathbb 1[X_i=s,\,a_i=l],\qquad N^{(l)}_{s,t}=\sum_{i=1}^m \mathbb 1[X_i=s,\,X_{i+1}=t,\,a_i=l],\qquad \hat M^{(l)}_{s,t}=\frac{N^{(l)}_{s,t}}{N^{(l)}_s}.
--   $$
--   The rows are $\hat M^{(l)}(s,\cdot)$ and $M^{(l)}(s,\cdot)$, with $\ell^1$ distance $\|\hat M^{(l)}(s,\cdot)-M^{(l)}(s,\cdot)\|_1=\sum_t|\hat M^{(l)}_{s,t}-M^{(l)}_{s,t}|$. For a square matrix, $\|A\|_\infty=\max_s\sum_t|A_{s,t}|$ is the maximum row sum. The estimation error is $\sup_{l}\|\hat M^{(l)}-M^{(l)}\|_\infty$.
--
--   **Visit and return times** (Definition 2). Put $H_0=0$. For $i\ge 1$, let $H_i$ be the first time $n>H_{i-1}$ with $(X_n,a_n)=(s,l)$, or $\infty$ if there is none. The $i$-th return time is $\tau^{(i)}_{s,l}=H_i-H_{i-1}$ ($\infty$ once a visit is missing), with $\tau^{(0)}_{s,l}=0$. The σ-algebra $\mathcal F_{H}$ of a random time $H$ consists of the events $A$ with $A\cap\{H\le n\}\in\mathcal F_n$ for all $n$.
--
--   **Mixing coefficients** (eqs. (2.1)–(2.2)). Write $W_j=((X_j,a_j),\dots,(X_m,a_m))$ for the window from $j$ to $m$ and $\mathcal H^{i}_0=((X_0,a_0),\dots,(X_i,a_i))$ for the history. For $i<j\le m$:
--
--   1. the weak mixing coefficient $\bar\eta_{i,j}$ is the supremum of
--   $$
--   \big|\mathbb P(W_j\in\mathcal T\mid X_i=s_1,a_i=l_1,\mathcal H^{i-1}_0=h)-\mathbb P(W_j\in\mathcal T\mid X_i=s_2,a_i=l_2,\mathcal H^{i-1}_0=h)\big|
--   $$
--   over events $\mathcal T$ of the window, pairs $(s_1,l_1)$, $(s_2,l_2)$ and histories $h$ for which both conditioning events have positive probability;
--   2. the uniform mixing coefficient $\phi_{i,j}$ is the supremum of $|\mathbb P(W_j\in\mathcal T)-\mathbb P(W_j\in\mathcal T\mid \mathcal H^i_0=h)|$ over events $\mathcal T$ and histories $h$ with $\mathbb P(\mathcal H^i_0=h)>0$.
--
--   Conditional probabilities are elementary: $\mathbb P(A\mid B)=\mathbb P(A\cap B)/\mathbb P(B)$.
--
--   **Assumptions.**
--
--   1. *Assumption 1.* $0<\zeta_2$, $\zeta_1<1$, and at each time $i$ there is a set $S_i\subset\chi\times\mathbb I$ with $\zeta_2\le\mathbb P((X_i,a_i)\in S_i)\le\zeta_1$.
--   2. *Assumption 2.* An integer $T>0$ satisfies $\sup_{s,l,i}\mathbb E[\tau^{(i)}_{s,l}\mid\mathcal F_{H_{i-1}}]<T$ almost everywhere.
--   3. *Assumption 4.* A constant $C_\Delta>1$ satisfies $\bar\eta_{i,j}\le\exp(-(j-i)\log(C_\Delta/(C_\Delta-1)))$ for all $i<j\le m$.
--
--   **Constants.** Put $\rho^{(l)}_s=\sup_{1\le i\le m}\mathbb P(X_i=s,a_i=l)$, $\rho_\star=\max_{s,l}\rho^{(l)}_s$ and $\zeta^{(\max)}=\max\{\zeta_1,1-\zeta_2\}$. Given $\mathbb C_{pel}>0$,
--   $$
--   \mathbb C_\zeta=\frac{8\big(2\mathbb C_\Delta\rho_\star(1-\zeta^{(\max)})^{-2}+(1-\zeta^{(\max)})^{-1}\big)}{\mathbb C_{pel}},\qquad
--   \mathbb C_T=\frac{64(\mathbb C_\Delta\rho_\star T^2+2T)}{\mathbb C_{pel}},
--   $$
--   and $\mathbb C_{T,\delta}=\mathbb C_T\log(6dk/\delta)$, $\mathbb C_{\zeta,\delta}=\mathbb C_\zeta\log(6dk/\delta)$.
--
--   These are the objects in which Theorem 2 and its lemmas are stated.
--
--   **Formalization Note**
--   1. Lean's division gives $\hat M^{(l)}_{s,t}=0$ when $N^{(l)}_s=0$.
--   2. Visit times are $\mathbb N\cup\{\infty\}$-valued. The real return time $\tau^{(i)}$ that enters the conditional expectation is the natural-number value, and Assumption 2 also requires it to be almost surely finite and integrable (both follow from the paper's bound).
--   3. The strict bound on the supremum in Assumption 2 is witnessed, for almost every $\omega$, by a number $T'<T$ that may depend on $\omega$.
--   4. $\mathcal F_H$ is the σ-algebra generated by the events above (for a stopping time they already form a σ-algebra).
--   5. The window is listed in increasing time order, and events are arbitrary subsets of a finite set. The suprema are finite maxima of numbers in $[0,1]$, equal to $0$ when no index is admissible.
--   6. Assumption 1 is stated at the sample times $1\le i\le m$, and Assumption 4 for $0\le i<j\le m$. For $i=0$ the history $\mathcal H^{-1}_0$ is empty.
-- source:
--   Banerjee, Honnappa & Rao, Offline Estimation of Controlled Markov Chains: Minimaxity and Sample Complexity, arXiv:2211.07092v5, p. 3 eqs. (1.1)–(1.2); pp. 7–8 Definition 2; p. 8 eqs. (2.1)–(2.2); p. 9 eq. (3.1); p. 10 Assumptions 1–2; p. 11 Assumption 4; p. 12 ρ^(l)_s and ζ^(max); p. 13 Step 1 (the ∞-norm as maximum row ℓ¹ sum); p. 14 ρ★, C_ζ, C_T, C_{T,δ}, C_{ζ,δ}

import Mathlib
import Definitions.Def_OfflineCMC_Minimax_CMC

namespace OfflineCMC.Minimax

open MeasureTheory

variable {d k : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] {μ : Measure Ω}

/-! ### Counts and the empirical estimator, eqs. (1.1)–(1.2), p. 3 -/

/-- `N^(l)_s = ∑_{i=1}^m 1[X_i = s, a_i = l]`, the number of visits to `(s, l)` at times `1, …, m`. -/
def CMC.count (C : CMC d k μ) (m : ℕ) (l : Fin k) (s : Fin d) (ω : Ω) : ℕ :=
  ((Finset.Icc 1 m).filter (fun i => C.X i ω = s ∧ C.a i ω = l)).card

/-- `N^(l)_{s,t} = ∑_{i=1}^m 1[X_i = s, X_{i+1} = t, a_i = l]` (reads `X_{m+1}`). -/
def CMC.count₂ (C : CMC d k μ) (m : ℕ) (l : Fin k) (s t : Fin d) (ω : Ω) : ℕ :=
  ((Finset.Icc 1 m).filter (fun i => C.X i ω = s ∧ C.X (i + 1) ω = t ∧ C.a i ω = l)).card

/-- The empirical estimator `M̂^(l)_{s,t} = N^(l)_{s,t} / N^(l)_s` (eq. (1.2)); Lean's division
gives `0` when `N^(l)_s = 0`. -/
noncomputable def CMC.Mhat (C : CMC d k μ) (m : ℕ) (l : Fin k) (s t : Fin d) (ω : Ω) : ℝ :=
  (C.count₂ m l s t ω : ℝ) / (C.count m l s ω : ℝ)

/-- The `ℓ¹` distance `‖A(s, ·) − B(s, ·)‖₁` between the `s`-th rows of two matrices. -/
def rowDist {n : ℕ} (A B : Fin n → Fin n → ℝ) (s : Fin n) : ℝ :=
  ∑ t, |A s t - B s t|

/-- The operator `∞`-norm `‖A‖∞ = max_s ∑_t |A_{s,t}|` (maximum row `ℓ¹` sum); `0` for `n = 0`. -/
noncomputable def infNorm {n : ℕ} (A : Fin n → Fin n → ℝ) : ℝ :=
  ⨆ s, ∑ t, |A s t|

/-- The estimation error `sup_{l ∈ 𝕀} ‖M̂^(l) − M^(l)‖∞` of the sample of length `m`. -/
noncomputable def CMC.estError (C : CMC d k μ) (m : ℕ) (ω : Ω) : ℝ :=
  ⨆ l, infNorm (fun s t => C.Mhat m l s t ω - C.M l s t)

/-! ### Visit times and return times, Definition 2, pp. 7–8 -/

/-- The first time `j > n` with `(X_j, a_j) = (s, l)`; `⊤` if there is none (and for `n = ⊤`). -/
noncomputable def CMC.nextVisit (C : CMC d k μ) (s : Fin d) (l : Fin k) (n : ℕ∞) (ω : Ω) : ℕ∞ :=
  ⨅ (j : ℕ) (_ : n < (j : ℕ∞) ∧ C.X j ω = s ∧ C.a j ω = l), (j : ℕ∞)

/-- The visit times `H_0 = 0 < H_1 < H_2 < …` of `(s, l)`: `H_i` is the `i`-th time `n ≥ 1` with
`(X_n, a_n) = (s, l)` (`⊤` if there are fewer than `i` such times). -/
noncomputable def CMC.visitTime (C : CMC d k μ) (s : Fin d) (l : Fin k) : ℕ → Ω → ℕ∞
  | 0 => fun _ => 0
  | i + 1 => fun ω => C.nextVisit s l (C.visitTime s l i ω) ω

/-- The return time `τ^(i)_{s,l} = H_i − H_{i−1}` for `i ≥ 1` (`⊤` once a visit is missing);
at `i = 0` it is `0`, the convention `τ^(0) := 0`. -/
noncomputable def CMC.returnTime (C : CMC d k μ) (s : Fin d) (l : Fin k) (i : ℕ) (ω : Ω) : ℕ∞ :=
  if C.visitTime s l (i - 1) ω = ⊤ then ⊤ else C.visitTime s l i ω - C.visitTime s l (i - 1) ω

/-- The σ-algebra `𝓕_τ` of events known at a random time `τ`: generated by the events `A`
(measurable for `⨆ n, 𝓕 n`) with `A ∩ {τ ≤ n} ∈ 𝓕 n` for every `n`. For a stopping time these events
already form a σ-algebra (Mathlib's `IsStoppingTime.measurableSpace`), so this is that σ-algebra. -/
@[instance_reducible]
def stoppedSigma (𝓕 : Filtration ℕ mΩ) (τ : Ω → ℕ∞) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom
    {A | MeasurableSet[⨆ n, 𝓕 n] A ∧ ∀ n : ℕ, MeasurableSet[𝓕 n] (A ∩ {ω | τ ω ≤ (n : ℕ∞)})}

/-! ### Mixing coefficients, eqs. (2.1)–(2.2), p. 8 -/

/-- The window `(X_j, a_j), …, (X_m, a_m)`, listed as `r ↦ (X_{j+r}, a_{j+r})`, `r < m + 1 − j`. -/
def CMC.window (C : CMC d k μ) (m j : ℕ) (ω : Ω) : Fin (m + 1 - j) → Fin d × Fin k :=
  fun r => (C.X (j + r) ω, C.a (j + r) ω)

/-- The history `(X_0, a_0), …, (X_{n−1}, a_{n−1})` (so `H^{i}_0` is `history (i + 1)`). -/
def CMC.history (C : CMC d k μ) (n : ℕ) (ω : Ω) : Fin n → Fin d × Fin k :=
  fun r => (C.X r ω, C.a r ω)

/-- The elementary conditional probability `P(A | B) = P(A ∩ B) / P(B)`. -/
noncomputable def condProb (μ : Measure Ω) (A B : Set Ω) : ℝ :=
  μ.real (A ∩ B) / μ.real B

open Classical in
/-- The weak mixing coefficient `η̄_{i,j}` of eq. (2.1) on the window up to `m`: the supremum, over
events `T` of the window `(X_j, a_j), …, (X_m, a_m)`, pairs `(s₁, l₁)`, `(s₂, l₂)` and histories
`h ∈ (χ × 𝕀)^i` of `(X_0, a_0), …, (X_{i−1}, a_{i−1})` with
`P(X_i = s₁, a_i = l₁, H^{i−1}_0 = h) > 0` and `P(X_i = s₂, a_i = l₂, H^{i−1}_0 = h) > 0`, of
`|P(window ∈ T | X_i = s₁, a_i = l₁, H^{i−1}_0 = h) − P(window ∈ T | X_i = s₂, a_i = l₂, H^{i−1}_0 = h)|`.
A finite supremum of numbers in `[0, 1]`; `0` when no index is admissible. -/
noncomputable def CMC.etaBar (C : CMC d k μ) (m i j : ℕ) : ℝ :=
  ⨆ x : Finset (Fin (m + 1 - j) → Fin d × Fin k) × (Fin d × Fin k) × (Fin d × Fin k) ×
      (Fin i → Fin d × Fin k),
    if 0 < μ.real {ω | (C.X i ω, C.a i ω) = x.2.1 ∧ C.history i ω = x.2.2.2} ∧
        0 < μ.real {ω | (C.X i ω, C.a i ω) = x.2.2.1 ∧ C.history i ω = x.2.2.2} then
      |condProb μ {ω | C.window m j ω ∈ x.1}
          {ω | (C.X i ω, C.a i ω) = x.2.1 ∧ C.history i ω = x.2.2.2} -
        condProb μ {ω | C.window m j ω ∈ x.1}
          {ω | (C.X i ω, C.a i ω) = x.2.2.1 ∧ C.history i ω = x.2.2.2}|
    else 0

open Classical in
/-- The uniform mixing coefficient `φ_{i,j}` of eq. (2.2) on the window up to `m`: the supremum, over
events `T` of the window `(X_j, a_j), …, (X_m, a_m)` and histories `h ∈ (χ × 𝕀)^{i+1}` of
`(X_0, a_0), …, (X_i, a_i)` with `P(H^i_0 = h) > 0`, of `|P(window ∈ T) − P(window ∈ T | H^i_0 = h)|`.
A finite supremum of numbers in `[0, 1]`; `0` when no index is admissible. -/
noncomputable def CMC.phi (C : CMC d k μ) (m i j : ℕ) : ℝ :=
  ⨆ x : Finset (Fin (m + 1 - j) → Fin d × Fin k) × (Fin (i + 1) → Fin d × Fin k),
    if 0 < μ.real {ω | C.history (i + 1) ω = x.2} then
      |μ.real {ω | C.window m j ω ∈ x.1} -
        condProb μ {ω | C.window m j ω ∈ x.1} {ω | C.history (i + 1) ω = x.2}|
    else 0

/-! ### Assumptions 1, 2 and 4, pp. 10–11 -/

/-- **Assumption 1** at the sample times `1 ≤ i ≤ m`: `0 < ζ₂`, `ζ₁ < 1`, and for every such `i` there
is a set `S_i ⊂ χ × 𝕀` with `ζ₂ ≤ P((X_i, a_i) ∈ S_i) ≤ ζ₁`. -/
def CMC.Assumption1 (C : CMC d k μ) (m : ℕ) (ζ₁ ζ₂ : ℝ) : Prop :=
  0 < ζ₂ ∧ ζ₁ < 1 ∧ ∀ i ∈ Finset.Icc 1 m, ∃ S : Finset (Fin d × Fin k),
    ζ₂ ≤ μ.real {ω | (C.X i ω, C.a i ω) ∈ S} ∧ μ.real {ω | (C.X i ω, C.a i ω) ∈ S} ≤ ζ₁

/-- **Assumption 2** (return time): `T > 0` is an integer, every return time `τ^(i)_{s,l}`, `i ≥ 1`,
is almost surely finite and integrable, and almost everywhere
`sup_{s, l, i ≥ 1} E[τ^(i)_{s,l} | 𝓕_{H_{i−1}}] < T`, where `H_{i−1} = ∑_{p=0}^{i−1} τ^(p)_{s,l}` is the
`(i−1)`-th visit time (`H_0 = 0`). The strict bound on the supremum is witnessed by a number
`T' < T` that may depend on `ω`. -/
def CMC.Assumption2 (C : CMC d k μ) (T : ℕ) : Prop :=
  0 < T ∧
  (∀ (s : Fin d) (l : Fin k) (i : ℕ), 1 ≤ i →
      (∀ᵐ ω ∂μ, C.returnTime s l i ω ≠ ⊤) ∧
      Integrable (fun ω => ((C.returnTime s l i ω).toNat : ℝ)) μ) ∧
  ∀ᵐ ω ∂μ, ∃ T' : ℝ, T' < (T : ℝ) ∧ ∀ (s : Fin d) (l : Fin k) (i : ℕ), 1 ≤ i →
      (μ[fun ω => ((C.returnTime s l i ω).toNat : ℝ) |
          stoppedSigma C.𝓕 (C.visitTime s l (i - 1))]) ω ≤ T'

/-- **Assumption 4** (exponential `η̄`-mixing) on the window up to `m`: `C_Δ > 1` and
`η̄_{i,j} ≤ exp(−(j − i) log(C_Δ / (C_Δ − 1)))` for all `0 ≤ i < j ≤ m`. -/
def CMC.Assumption4 (C : CMC d k μ) (m : ℕ) (CΔ : ℝ) : Prop :=
  1 < CΔ ∧ ∀ i j : ℕ, i < j → j ≤ m →
    C.etaBar m i j ≤ Real.exp (-((j : ℝ) - (i : ℝ)) * Real.log (CΔ / (CΔ - 1)))

/-! ### The constants of Proposition 3 and Theorem 2, pp. 12, 14 -/

/-- `ρ^(l)_s = sup_{1 ≤ i ≤ m} P(X_i = s, a_i = l)` (`0` when `m = 0`). -/
noncomputable def CMC.rho (C : CMC d k μ) (m : ℕ) (l : Fin k) (s : Fin d) : ℝ :=
  ⨆ i : (Finset.Icc 1 m : Set ℕ), μ.real {ω | C.X i ω = s ∧ C.a i ω = l}

/-- `ρ★ = sup_{s,l} sup_{1 ≤ i ≤ m} P(X_i = s, a_i = l)`. -/
noncomputable def CMC.rhoStar (C : CMC d k μ) (m : ℕ) : ℝ :=
  ⨆ (s : Fin d) (l : Fin k), C.rho m l s

/-- `ζ^(max) = max{ζ₁, 1 − ζ₂}`. -/
def zetaMax (ζ₁ ζ₂ : ℝ) : ℝ := max ζ₁ (1 - ζ₂)

/-- `C_ζ = 8 (2 C_Δ ρ★ (1 − ζ^(max))^{−2} + (1 − ζ^(max))^{−1}) / C_pel`. -/
noncomputable def Czeta (Cpel CΔ ρ ζmax : ℝ) : ℝ :=
  8 * (2 * CΔ * ρ * ((1 - ζmax) ^ 2)⁻¹ + (1 - ζmax)⁻¹) / Cpel

/-- `C_T = 64 (C_Δ ρ★ T² + 2T) / C_pel`. -/
noncomputable def CT (Cpel CΔ ρ : ℝ) (T : ℕ) : ℝ :=
  64 * (CΔ * ρ * (T : ℝ) ^ 2 + 2 * (T : ℝ)) / Cpel

/-- `C_{T,δ} = C_T log(6dk/δ)` and likewise `C_{ζ,δ} = C_ζ log(6dk/δ)`: the factor `log(6dk/δ)`. -/
noncomputable def logFactor (d k : ℕ) (δ : ℝ) : ℝ :=
  Real.log (6 * (d : ℝ) * (k : ℝ) / δ)

end OfflineCMC.Minimax


