  have hv' : zsz (((n.eval s).toNat : ℤ) - k + -1) ≤ B := le_trans (zsz_mono (by omega)) hB
  have h1 : 1 ≤ B := by
    by_contra hc
    have := (zsz_le_iff (z := n.eval s) (m := 0)).1 (by omega); simp at this; omega
  apply RS.decCost_le
  · simpa [IState.top, withCtr] using hv
  · simpa [IState.top, withCtr] using hv'
  · exact h1

