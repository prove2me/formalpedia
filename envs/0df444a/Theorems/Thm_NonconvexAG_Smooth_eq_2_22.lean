-- url     : https://prove2.me/theorems/14b2fffc-9f60-4dbc-88db-7981db1bbef4
-- title:
--   (2.22) — α_k⟨∇Ψ(x^md_k), x_{k−1} − x⟩ = (α_k/(2λ_k))[‖x_{k−1} − x‖² − ‖x_k − x‖²] + (α_kλ_k/2)‖∇Ψ(x^md_k)‖²
-- statement:
--   Let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$, using an arbitrary map $\nabla\Psi:\mathbb R^n\to\mathbb R^n$. Then for every $k\ge1$ and every $x\in\mathbb R^n$,
--   $$\alpha_k\langle\nabla\Psi(x^{md}_k),x_{k-1}-x\rangle=\frac{\alpha_k}{2\lambda_k}\Big[\|x_{k-1}-x\|^2-\|x_k-x\|^2\Big]+\frac{\alpha_k\lambda_k}{2}\|\nabla\Psi(x^{md}_k)\|^2 .$$
--
--   The identity converts the linear term of (2.21) into a telescoping distance term.
--
--   **Formalization Note** The identity follows from (2.3) alone and is stated for any map `g`.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 7, (2.22)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.22), p. 7, for every `x ∈ ℝⁿ`. -/
theorem eq_2_22 {n : ℕ} (g : E n → E n) (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k → ∀ x : E n,
      α k * inner ℝ (g (xmdSeq g α β lam x0 k)) (xSeq g α β lam x0 (k - 1) - x) =
        α k / (2 * lam k) * (‖xSeq g α β lam x0 (k - 1) - x‖ ^ 2 - ‖xSeq g α β lam x0 k - x‖ ^ 2)
          + α k * lam k / 2 * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
