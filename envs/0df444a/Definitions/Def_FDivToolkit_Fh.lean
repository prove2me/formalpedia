-- status  : Definition
-- author  : @iris
-- created : 2026-10-31T04:21:09.640123+00:00
-- url     : https://prove2.me/theorems/9b10c9c9-1240-449c-a3de-77f0cd4fccfc
-- title:
--   The divergence function $F$ generated by $H$, and $F(0)$
-- statement:
--   For a generating function $H$, the function $F:(0,\infty)\to\mathbb R$ is
--   $$
--   F(y)=\int_1^y H(\log z)\,dz,\qquad y\in(0,\infty), \tag{2}
--   $$
--   with the convention $\int_1^y=-\int_y^1$ for $y<1$. It is extended to $[0,\infty)$ by $F(0)=\lim_{y\downarrow0}F(y)\in(0,\infty]$.
--
--   Thus $F'=H\circ\log$: the paper specifies a divergence through the transformed derivative $H$ rather than through $F$.
--
--   **Formalization Note** `Fh` is the oriented interval integral. `F0` is $\sup_{y\in(0,1)}F(y)$ in $[0,\infty]$, which is the limit at $0^+$ because $F$ decreases on $(0,1)$; milestone `lemma_1` records this. `Fbar` is the extension, with values in $[0,\infty]$.
-- source:
--   Kruse, Schneider & Schweizer, SSRN 3680475 (Aug 25, 2020), display (2), §2.1, p.5, and footnote 4

import Mathlib

open Set
open scoped ENNReal

namespace FDivToolkit

/-- The divergence function `F(y) = ∫_1^y H(log z) dz` of display (2), Kruse, Schneider & Schweizer,
SSRN 3680475 (Aug 25, 2020), §2.1, p.5, for `y ∈ (0, ∞)`.

**Formalization Note.** The oriented interval integral matches footnote 4 (`∫_1^y = −∫_y^1` for
`y < 1`). Only `y > 0` is meaningful; the value at other `y` is never used. -/
noncomputable def Fh (H : ℝ → ℝ) (y : ℝ) : ℝ :=
  ∫ z in (1 : ℝ)..y, H (Real.log z)

/-- `F(0) = lim_{y↓0} F(y) ∈ (0, ∞]`, Kruse, Schneider & Schweizer, SSRN 3680475 (Aug 25, 2020),
§2.1, p.5.

**Formalization Note.** `F` is decreasing on `(0, 1)`, because `F′ = H ∘ log < 0` there, so the limit
at `0⁺` is the supremum over `(0, 1)`. Milestone `lemma_1` records that this supremum is that limit.
The value lies in `ℝ≥0∞` because `F(0) = ∞` is possible for general `H`. -/
noncomputable def F0 (H : ℝ → ℝ) : ℝ≥0∞ :=
  ⨆ y ∈ Ioo (0 : ℝ) 1, ENNReal.ofReal (Fh H y)

open Classical in
/-- The extension of `F` to `[0, ∞)`, with values in `[0, ∞]` (Kruse, Schneider & Schweizer,
SSRN 3680475 (Aug 25, 2020), §2.1, p.5).

**Formalization Note.** `ENNReal.ofReal` loses nothing since `F ≥ 0` on `(0, ∞)` (Lemma 1). It is
evaluated only at `y ≥ 0`. -/
noncomputable def Fbar (H : ℝ → ℝ) (y : ℝ) : ℝ≥0∞ :=
  if y = 0 then F0 H else ENNReal.ofReal (Fh H y)

end FDivToolkit


