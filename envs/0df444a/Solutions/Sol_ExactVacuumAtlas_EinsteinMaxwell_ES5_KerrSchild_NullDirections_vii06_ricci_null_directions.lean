open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections
variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) {x : Pt 5}
    (hx : x ∈ esDomain I) (hf : 0 < f (x 1)) (hm : 0 < m (x 1)) (hN : 0 < N (x 1))
    (ha2 : 0 < alphaSq f m N w p a (x 1))
    (hEin : ∀ i j, einsteinMaxwellD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) i j x = 0) :
    (metricMatrix (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) x *
        metricMatrix (esFaraday p a) x) *ᵥ kPlus f m N w p a x =
        Real.sqrt (alphaSq f m N w p a (x 1)) • kPlus f m N w p a x ∧
      (metricMatrix (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) x *
        metricMatrix (esFaraday p a) x) *ᵥ kMinus f m N w p a x =
        (-Real.sqrt (alphaSq f m N w p a (x 1))) • kMinus f m N w p a x ∧
      (∀ c : ℝ, kPlus f m N w p a x ≠ c • kMinus f m N w p a x ∧
        kMinus f m N w p a x ≠ c • kPlus f m N w p a x) ∧
      ∀ k : Fin 5 → ℝ,
        (k ≠ 0 ∧ contract2 (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x k = 0 ∧
          contract2 (ricciOf (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
            (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)) x k = 0) ↔
        ∃ t : ℝ, t ≠ 0 ∧ (k = t • kPlus f m N w p a x ∨ k = t • kMinus f m N w p a x) := by
  have hE := hP.toESData
  obtain ⟨hDp, hAp, hHp⟩ := pos_frame_factors hf hm hN
  have hframe := alphaSq_eq_frame w p a (hP.nf _ hx.1) (hP.nm _ hx.1) (hP.nN _ hx.1)
  have hα : 0 < Real.sqrt (alphaSq f m N w p a (x 1)) := Real.sqrt_pos.mpr ha2
  have hαsq : Real.sqrt (alphaSq f m N w p a (x 1)) ^ 2 = alphaSq f m N w p a (x 1) :=
    Real.sq_sqrt ha2.le
  have he := eFun_ne_zero_of_alphaSq_pos hf ha2
  refine ⟨principalCoord_eigen hP hx hαsq, principalCoord_eigen hP hx (by rw [neg_sq, hαsq]),
    fun c => ⟨fun hc => ?_, fun hc => ?_⟩, fun k => ?_⟩
  · have h0 := congrFun hc 0
    have h1 := congrFun hc 1
    simp only [kPlus, kMinus, principalCoord_eq, Pi.smul_apply, smul_eq_mul] at h0 h1
    simp at h0 h1
    have hc1 : c = -1 := by
      have : Real.sqrt (alphaSq f m N w p a (x 1)) * (1 + c) = 0 := by linarith
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h hα.ne'
      · linarith
    rw [hc1] at h0
    have : eFun w p a (x 1) / f (x 1) = 0 := by linarith
    exact he (by simpa [hf.ne'] using this)
  · have h0 := congrFun hc 0
    have h1 := congrFun hc 1
    simp only [kPlus, kMinus, principalCoord_eq, Pi.smul_apply, smul_eq_mul] at h0 h1
    simp at h0 h1
    have hc1 : c = -1 := by
      have : Real.sqrt (alphaSq f m N w p a (x 1)) * (1 + c) = 0 := by linarith
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h hα.ne'
      · linarith
    rw [hc1] at h0
    have : eFun w p a (x 1) / f (x 1) = 0 := by linarith
    exact he (by simpa [hf.ne'] using this)
  · have hnull := contract2_esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w x k
    have hric := ricci_contract2 hE hx hEin k
    have hee : deriv p (x 1) + w (x 1) * deriv a (x 1) = eFun w p a (x 1) := rfl
    rw [hee] at hric
    have hcls := frame_null_classification hf hDp hAp hHp hx.2.1 hx.2.2 (a (x 1))
      (hframe ▸ ha2) (frameInv w x k)
    rw [← hframe] at hcls
    constructor
    · rintro ⟨hk, hg, hr⟩
      have hz : frameQ (f (x 1)) (Dfun f m N (x 1)) (Afun f m (x 1)) (Hfun m N (x 1)) (x 2)
          (frameZ (f (x 1)) (Dfun f m N (x 1)) (Afun f m (x 1)) (Hfun m N (x 1)) (x 2)
            (eFun w p a (x 1)) (deriv a (x 1)) (a (x 1)) (frameInv w x k)) = 0 := by
        rw [hric, hg] at hr; linarith
      obtain ⟨t, ht, hv | hv⟩ :=
        hcls.mp ⟨(frameInv_eq_zero_iff w x k).not.mpr hk, hnull ▸ hg, hz⟩
      · refine ⟨t, ht, Or.inl ?_⟩
        rw [← esFrame_mulVec_frameInv w x k, hv, Matrix.mulVec_smul]
        rfl
      · refine ⟨t, ht, Or.inr ?_⟩
        rw [← esFrame_mulVec_frameInv w x k, hv, Matrix.mulVec_smul]
        rfl
    · rintro ⟨t, ht, hk⟩
      have hv : ∃ t' : ℝ, t' ≠ 0 ∧
          (frameInv w x k = t' • principalFrame (f (x 1)) (Hfun m N (x 1)) (eFun w p a (x 1))
              (deriv a (x 1)) (Real.sqrt (alphaSq f m N w p a (x 1))) ∨
            frameInv w x k = t' • principalFrame (f (x 1)) (Hfun m N (x 1)) (eFun w p a (x 1))
              (deriv a (x 1)) (-Real.sqrt (alphaSq f m N w p a (x 1)))) := by
        refine ⟨t, ht, ?_⟩
        rcases hk with hk | hk
        · left; rw [hk, frameInv_smul, kPlus, principalCoord, frameInv_esFrame_mulVec]
        · right; rw [hk, frameInv_smul, kMinus, principalCoord, frameInv_esFrame_mulVec]
      obtain ⟨hv0, hq, hz⟩ := hcls.mpr hv
      refine ⟨fun h0 => hv0 ((frameInv_eq_zero_iff w x k).mpr h0), hnull ▸ hq, ?_⟩
      rw [hric, hnull, hq, hz]
      ring
