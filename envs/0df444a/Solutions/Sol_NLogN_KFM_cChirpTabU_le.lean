variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem cCnt_le (x : ℕ) : cCnt x ≤ 135 * (x + 2) := by
  have := zsz_natCast_le_self' x; unfold cCnt; simp only [dupCost, zipCost, moveCost]; omega

theorem cLevU_le (Δ s t n φ : ℕ) :
    cLevU Δ s t n φ ≤ cAxU Δ s t φ + (n * t) * (4 * φ) + 10 ^ 9 * (n + 1) * (t + 1) * (Δ + 3) := by
  have h1 := cOb_le t (Δ + 2) Δ φ
  have h2 := cRpt_le n; have h3 := cRpt_le (2 * t); have h4 := cRpt_le (2 * (n * t))
  have c1 := cCnt_le (2 * t); have c2 := cCnt_le n; have c3 := cCnt_le (2 * (n * t))
  have h5 : n * (cObU t (Δ + 2) Δ φ + 64) ≤
      n * (t * (4 * φ) + 10 ^ 7 * (t + 1) * (Δ + 2 + Δ + 1) + 6 * (135 * (2 * t + 2)) + 64) :=
    Nat.mul_le_mul_left _ (by unfold cObU; omega)
  unfold cLevU
  nlinarith

theorem nK_pos (L : List (ℕ × ℕ)) (ht : ∀ p ∈ L, 1 ≤ p.2) (k : ℕ) : 1 ≤ nK L k := by
  unfold nK
  apply Nat.one_le_iff_ne_zero.2
  rw [Ne, List.prod_eq_zero_iff]
  intro h
  obtain ⟨p, hp, h0⟩ := List.mem_map.1 h
  have := ht p (List.mem_of_mem_take hp); omega

theorem cStep_le (Δ φ AX : ℕ) (L : List (ℕ × ℕ)) (ht : ∀ p ∈ L, 1 ≤ p.2)
    (hAX : ∀ p ∈ L, cAxU Δ p.1 p.2 φ ≤ AX) (k : ℕ) (hk : k < L.length) :
    cStep Δ φ L k ≤ AX + nK L (k + 1) * (4 * φ + 10 ^ 10 * (Δ + 3)) := by
  have hn := nK_pos L ht k
  have htk := ht _ (List.getElem_mem hk)
  have hA := hAX _ (List.getElem_mem hk)
  rw [nK_succ L k hk]
  unfold cStep
  rw [List.getD_eq_getElem _ _ hk]
  have hl := cLevU_le Δ (L[k]).1 (L[k]).2 (nK L k) φ
  generalize nK L k = n at hn hl ⊢
  generalize (L[k]).2 = t at htk hl hA ⊢
  have hz : zV t n ≤ 2 * t + 2 * (n * t) + n := by unfold zV; exact zsz_natCast_le_self' _
  have e1 : (n + 1) * (t + 1) ≤ 4 * (n * t) := by nlinarith
  have e2 : 10 ^ 9 * (n + 1) * (t + 1) * (Δ + 3) ≤ 4 * 10 ^ 9 * (n * t) * (Δ + 3) := by
    have := Nat.mul_le_mul_right (10 ^ 9 * (Δ + 3)) e1; nlinarith
  have e3 : 2 * t + 2 * (n * t) + n + 1 ≤ 6 * (n * t) := by nlinarith
  unfold cLdV
  nlinarith

theorem sum_nK_le (L : List (ℕ × ℕ)) (ht : ∀ p ∈ L, 2 ≤ p.2) :
    ∀ m ≤ L.length, ∑ k ∈ Finset.range m, nK L (k + 1) ≤ 2 * nK L m := by
  intro m
  induction m with
  | zero => intro _; simp
  | succ m ih =>
    intro hm
    rw [Finset.sum_range_succ]
    have := ih (by omega)
    have h2 := ht _ (List.getElem_mem (show m < L.length by omega))
    rw [nK_succ L m (by omega)]
    nlinarith

theorem nK_length (L : List (ℕ × ℕ)) : nK L L.length = (L.map Prod.snd).prod := by
  simp [nK]

/-- **Cost of the uniform chirp array**: `d` axis tables plus `O(1)` products per entry. -/
theorem cChirpPU_le (Δ φ AX : ℕ) (L : List (ℕ × ℕ)) (ht : ∀ p ∈ L, 2 ≤ p.2)
    (hAX : ∀ p ∈ L, cAxU Δ p.1 p.2 φ ≤ AX) :
    cChirpPU Δ φ L ≤ L.length * (AX + 64) + 2 * (L.map Prod.snd).prod * (4 * φ + 10 ^ 10 * (Δ + 3)) +
      135 * (Δ + 3) + 2000 * (L.length + 1) + 135 * (L.length + 2) + 80 := by
  have ht1 : ∀ p ∈ L, 1 ≤ p.2 := fun p hp => le_trans (by norm_num) (ht p hp)
  have hs : ∑ k ∈ Finset.range L.length, (cStep Δ φ L k + 64) ≤
      ∑ k ∈ Finset.range L.length, (AX + 64 + nK L (k + 1) * (4 * φ + 10 ^ 10 * (Δ + 3))) :=
    Finset.sum_le_sum fun k hk => by
      have := cStep_le Δ φ AX L ht1 hAX k (Finset.mem_range.1 hk); omega
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul,
    ← Finset.sum_mul] at hs
  have hg := sum_nK_le L ht L.length le_rfl
  rw [nK_length] at hg
  have hm := Nat.mul_le_mul_right (4 * φ + 10 ^ 10 * (Δ + 3)) hg
  have hd : dupCost (Δ + 1) + 17 ≤ 135 * (Δ + 3) := by simp only [dupCost, zipCost, moveCost]; omega
  have := cRpt_le L.length; have := cCnt_le L.length
  unfold cChirpPU
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul]
  nlinarith

end IL

