-- Source module: Solutions.R6Glue
/-!
# Round six: the final reduction `kappaBound_of_machine6`

* `kappaBound_of_polylog_slack6`: copy of the analytic node `IntMul.Kappa.kappaBound_of_polylog_slack`
  (time `C n lg^(1-g) (log lg + 1)^A` with `κ < g` gives `KappaBound κ`);
* `kappaBound_of_machine6`: a correct machine with time `C₀ (V · Ncost6 · (log lg n + 1)^A + n)`
  for `n ≥ n₁` gives `KappaBound κ` for every `κ < P.gap`.
-/

open Real

namespace IntMul.Kappa.R6

theorem logpow_le6 (A : ℕ) (e : ℝ) (he : 0 < e) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x : ℝ, 1 ≤ x → (Real.log x + 1) ^ A ≤ K * x ^ e := by
  rcases Nat.eq_zero_or_pos A with hA | hA
  · refine ⟨1, zero_le_one, fun x hx => ?_⟩
    subst hA; simp only [pow_zero, one_mul]; exact Real.one_le_rpow hx he.le
  · set ε := e / A with hε
    have hε0 : 0 < ε := div_pos he (by exact_mod_cast hA)
    refine ⟨(1 / ε + 1) ^ A, by positivity, fun x hx => ?_⟩
    have hx0 : 0 ≤ x := by linarith
    have hl := Real.log_le_rpow_div hx0 hε0
    have hxe : 1 ≤ x ^ ε := Real.one_le_rpow hx hε0.le
    have hlog0 : 0 ≤ Real.log x := Real.log_nonneg hx
    have h1 : Real.log x + 1 ≤ (1 / ε + 1) * x ^ ε := by
      have : x ^ ε / ε = 1 / ε * x ^ ε := by ring
      nlinarith
    calc (Real.log x + 1) ^ A ≤ ((1 / ε + 1) * x ^ ε) ^ A := by gcongr
      _ = (1 / ε + 1) ^ A * (x ^ ε) ^ A := by rw [mul_pow]
      _ = (1 / ε + 1) ^ A * x ^ e := by
        rw [← Real.rpow_natCast (x ^ ε), ← Real.rpow_mul hx0, hε,
          div_mul_cancel₀ _ (by exact_mod_cast hA.ne')]

theorem multipliesAt_mono6 {M : IntMul.MultitapeTM} {n : ℕ} {T T' : ℝ}
    (h : IntMul.MultipliesAt M n T) (hT : T ≤ T') : IntMul.MultipliesAt M n T' := by
  intro x y hx hy
  obtain ⟨t, ht, hh⟩ := h x y hx hy
  exact ⟨t, ht.trans hT, hh⟩

/-- Copy of the analytic node `IntMul.Kappa.kappaBound_of_polylog_slack`. -/
theorem kappaBound_of_polylog_slack6 (κ g C : ℝ) (A : ℕ) (hg : κ < g) (M : IntMul.MultitapeTM)
    (hcorr : ∀ n : ℕ, 1 ≤ n → ∃ T : ℝ, IntMul.MultipliesAt M n T) (n₀ : ℕ)
    (hT : ∀ n : ℕ, n₀ ≤ n →
      IntMul.MultipliesAt M n
        (C * n * (IntMul.lg n : ℝ) ^ (1 - g) * (Real.log (IntMul.lg n) + 1) ^ A)) :
    IntMul.KappaBound κ := by
  obtain ⟨K, hK0, hK⟩ := logpow_le6 A (g - κ) (by linarith)
  refine ⟨M, hcorr, |C| * K + 1, by positivity, n₀, fun n hn _ => ?_⟩
  apply multipliesAt_mono6 (hT n hn)
  have hL : (1 : ℝ) ≤ (IntMul.lg n : ℝ) := by exact_mod_cast (le_max_right _ _ : 1 ≤ IntMul.lg n)
  have hL0 : (0 : ℝ) < (IntMul.lg n : ℝ) := by linarith
  have hlog : 0 ≤ Real.log (IntMul.lg n) + 1 := by have := Real.log_nonneg hL; linarith
  have hp := hK _ hL
  have hsplit : (IntMul.lg n : ℝ) ^ (1 - g) * (IntMul.lg n : ℝ) ^ (g - κ) =
      (IntMul.lg n : ℝ) ^ (1 - κ) := by
    rw [← Real.rpow_add hL0]; ring_nf
  have hn0 : (0 : ℝ) ≤ n := by positivity
  have hX : 0 ≤ (n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - g) * (Real.log (IntMul.lg n) + 1) ^ A := by
    positivity
  calc C * n * (IntMul.lg n : ℝ) ^ (1 - g) * (Real.log (IntMul.lg n) + 1) ^ A
      = C * ((n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - g) * (Real.log (IntMul.lg n) + 1) ^ A) := by ring
    _ ≤ |C| * ((n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - g) * (Real.log (IntMul.lg n) + 1) ^ A) :=
        mul_le_mul_of_nonneg_right (le_abs_self C) hX
    _ ≤ |C| * ((n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - g) * (K * (IntMul.lg n : ℝ) ^ (g - κ))) := by
        gcongr
    _ = |C| * K * ((n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - κ)) := by rw [← hsplit]; ring
    _ ≤ (|C| * K + 1) * ((n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - κ)) := by
        have : 0 ≤ (n : ℝ) * (IntMul.lg n : ℝ) ^ (1 - κ) := by positivity
        nlinarith

/-- **The round-six final reduction.**  A correct multitape machine whose time on length
`n ≥ n₁` is at most `C₀ (V · Ncost6 · (log lg n + 1)^A + n)` (with the round-six parameter
map of `R6Params`) satisfies `KappaBound κ` for every `κ < P.gap`. -/
theorem kappaBound_of_machine6_sol_aux (P : Prm) (hP : P.Ok) (κ : ℝ) (hκ : κ < P.gap)
    (M : IntMul.MultitapeTM) (hcorr : ∀ n, 1 ≤ n → ∃ T : ℝ, IntMul.MultipliesAt M n T)
    (n₁ A : ℕ) (C₀ : ℝ) (hC₀ : 0 ≤ C₀)
    (htime : ∀ n, n₁ ≤ n → IntMul.MultipliesAt M n
      (C₀ * (VP6 P n * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A + n))) :
    IntMul.KappaBound κ := by
  obtain ⟨n₂, hn₂⟩ := params6_ok P hP
  refine kappaBound_of_polylog_slack6 κ P.gap (C₀ * (48 * Cst P + 1)) (A + 1) hκ M hcorr
    (max n₁ n₂) (fun n hn => multipliesAt_mono6 (htime n (le_of_max_le_left hn)) ?_)
  have hG := hn₂ n (le_of_max_le_right hn)
  have hN := Ncost6_le_of P hP hG.b_ge
  have hL : (1 : ℝ) ≤ (IntMul.lg n : ℝ) := by exact_mod_cast (le_max_right _ _ : 1 ≤ IntMul.lg n)
  set L : ℝ := (IntMul.lg n : ℝ)
  set Λ : ℝ := Real.log L + 1
  have hΛ : 1 ≤ Λ := by have := Real.log_nonneg hL; simp only [Λ]; linarith
  have hE : 1 ≤ L ^ (1 - P.gap) :=
    Real.one_le_rpow hL (by linarith [P.gap_le_one_sub, hP.eps_ge])
  have hC : 0 ≤ Cst P := by unfold Cst; positivity
  have hV0 : 0 ≤ VP6 P n := le_trans (by positivity) hG.V_lo
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hΛA : 0 ≤ Λ ^ A := by positivity
  have hB0 : 0 ≤ Cst P * L ^ (1 - P.gap) * Λ := by positivity
  have h1 : VP6 P n * Ncost6 P n * Λ ^ A ≤ 48 * n * (Cst P * L ^ (1 - P.gap) * Λ) * Λ ^ A := by
    apply mul_le_mul_of_nonneg_right _ hΛA
    calc VP6 P n * Ncost6 P n ≤ VP6 P n * (Cst P * L ^ (1 - P.gap) * Λ) :=
          mul_le_mul_of_nonneg_left hN hV0
      _ ≤ 48 * n * (Cst P * L ^ (1 - P.gap) * Λ) := mul_le_mul_of_nonneg_right hG.V_hi hB0
  have hX : (1 : ℝ) ≤ L ^ (1 - P.gap) * Λ ^ (A + 1) := by
    have : 1 ≤ Λ ^ (A + 1) := one_le_pow₀ hΛ
    nlinarith
  have h2 : (n : ℝ) ≤ n * L ^ (1 - P.gap) * Λ ^ (A + 1) := by
    rw [mul_assoc]; nlinarith
  calc C₀ * (VP6 P n * Ncost6 P n * Λ ^ A + n)
      ≤ C₀ * (48 * n * (Cst P * L ^ (1 - P.gap) * Λ) * Λ ^ A + n * L ^ (1 - P.gap) * Λ ^ (A + 1)) := by
        gcongr
    _ = C₀ * (48 * Cst P + 1) * n * L ^ (1 - P.gap) * Λ ^ (A + 1) := by ring

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.kappaBound_of_machine6_sol_aux := @IntMul.Kappa.R6.kappaBound_of_machine6_sol_aux
