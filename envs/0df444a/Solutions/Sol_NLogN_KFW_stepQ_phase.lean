  intro k hk
  simp only [pairWG, RS.writes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hk
  rcases hk with h | h | h | h | h | h | h | h | h
  all_goals first | exact writes_pairPz z k h | (subst h; exact Or.inl (by decide))

