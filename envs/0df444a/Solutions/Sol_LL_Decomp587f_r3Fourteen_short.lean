def V_tree : SegTree := .N 280627283 (.N 169217306 V0 V1) (.N 280627283 V2 V3)

def getV (k : Nat) : Nat := if k < 2048 then V_tree.get 11 k else V_last
def getU (k : Nat) : Nat := U_tree.get 11 k

def allTree : Nat → Nat → (Nat → Bool) → Bool
  | 0, k, p => p k
  | d + 1, k, p => allTree d k p && allTree d (k + 2 ^ d) p

def checkBuchstabStep (k : Nat) : Bool :=
  if k < K_grid then
    decide (S_scale ≤ getV k) &&
    decide (S_scale * K_grid ≤ getU k * (K_grid + k))
  else if k < 2 * K_grid then
    decide (getV k ≤ getV (k + 1)) &&
    decide (S_scale * (2 * k + 1) ≤ 2 * k * (k + 1) * (getV (k + 1) - getV k)) &&
    decide (K_grid * getV k ≤ getU k * (K_grid + k)) &&
    decide (K_grid * (k * getV k + S_scale) ≤ k * (K_grid + k + 1) * getU k)
  else
    decide (getV k ≤ getV (k + 1)) &&
    decide (getU (k - K_grid) ≤ K_grid * (getV (k + 1) - getV k)) &&
    decide (K_grid * getV k ≤ getU k * (K_grid + k)) &&
    decide (K_grid * getV (k + 1) ≤ getU k * (K_grid + k + 1)) &&
    (if 3 * K_grid ≤ k then decide (getU k ≤ M4_val) else true)

def validBuchstabCert : Bool :=
  U_tree.isValid 11 && decide (S_scale ≤ getV K_grid) && allTree 11 0 checkBuchstabStep

theorem validBuchstabCert_ok : validBuchstabCert = true := by decide

def buchstabUB (k0 k1 : Nat) : Nat :=
  if 4 * K_grid ≤ k0 then M4_val
  else if k1 < 4 * K_grid then U_tree.rangeMax (2 * K_grid) k0 k1
  else max (U_tree.rangeMax (2 * K_grid) k0 (4 * K_grid - 1)) M4_val

def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b
def wSimp (a b : Nat) : Nat := ceilDiv (W_scale * (b - a) * ((a + b)^2 + 8 * a * b)) (6 * a * b * (a + b))
def wInvSq (a b : Nat) : Nat := ceilDiv (W_scale * D_den * (b - a)) (a * b)
def wDiag12 (a b : Nat) : Nat := ceilDiv (W_scale * W_scale * D_den * (b - a)^2 * (5 * a + b)) (6 * a * a * b * (a + b))
def wDiag012 (a b : Nat) : Nat := ceilDiv (W_scale * W_scale * W_scale * D_den * (b - a)^3) (6 * a^4)

inductive BoxTree where
  | lf : BoxTree
  | s0 (l r : BoxTree)
  | s1 (l r : BoxTree)
  | s2 (l r : BoxTree)
  | sd01 (c01 m c12 : BoxTree)
  | s2d01 (l r : BoxTree)
  | s0d12 (l r : BoxTree)
  | sd12 (c01 m c12 : BoxTree)
  | sd012 (c0 m01 m12 c1 : BoxTree)

def validTree : BoxTree → Nat → Nat → Nat → Nat → Nat → Nat → Bool
  | .lf, x0a, x0b, x1a, x1b, x2a, x2b =>
      decide (0 < x0a && x0a ≤ x0b && 0 < x1a && x1a ≤ x1b && 0 < x2a && x2a ≤ x2b) &&
      ((decide (x0b ≤ x1a && x1b ≤ x2a)) ||
       (decide (x0a == x1a && x0b == x1b && x1b ≤ x2a)) ||
       (decide (x0b ≤ x1a && x1a == x2a && x1b == x2b)) ||
       (decide (x0a == x1a && x1a == x2a && x0b == x1b && x1b == x2b)))
  | .s0 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      decide (x0a ≤ x0b) && validTree l x0a m x1a x1b x2a x2b && validTree r m x0b x1a x1b x2a x2b
  | .s1 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x1a + x1b) / 2
      decide (x1a ≤ x1b) && validTree l x0a x0b x1a m x2a x2b && validTree r x0a x0b m x1b x2a x2b
  | .s2 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x2a + x2b) / 2
      decide (x2a ≤ x2b) && validTree l x0a x0b x1a x1b x2a m && validTree r x0a x0b x1a x1b m x2b
  | .sd01 c01 mm c12, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      decide (x0a == x1a && x0b == x1b && x0a ≤ x0b) &&
      validTree c01 x0a m x0a m x2a x2b && validTree mm x0a m m x0b x2a x2b && validTree c12 m x0b m x0b x2a x2b
  | .s2d01 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x2a + x2b) / 2
      decide (x0a == x1a && x0b == x1b && x2a ≤ x2b) &&
      validTree l x0a x0b x0a x0b x2a m && validTree r x0a x0b x0a x0b m x2b
  | .s0d12 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      decide (x1a == x2a && x1b == x2b && x0a ≤ x0b) &&
      validTree l x0a m x1a x1b x1a x1b && validTree r m x0b x1a x1b x1a x1b
  | .sd12 c01 mm c12, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x1a + x1b) / 2
      decide (x1a == x2a && x1b == x2b && x1a ≤ x1b) &&
      validTree c01 x0a x0b x1a m x1a m && validTree mm x0a x0b x1a m m x1b && validTree c12 x0a x0b m x1b m x1b
  | .sd012 c0 m01 m12 c1, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      decide (x0a == x1a && x1a == x2a && x0b == x1b && x1b == x2b && x0a ≤ x0b) &&
      validTree c0 x0a m x0a m x0a m && validTree m01 x0a m x0a m m x0b &&
      validTree m12 x0a m m x0b m x0b && validTree c1 m x0b m x0b m x0b

def evalBox (pa pb : Nat) : BoxTree → Nat → Nat → Nat → Nat → Nat → Nat → Nat
  | .lf, x0a, x0b, x1a, x1b, x2a, x2b =>
      let k0 := ((pa - x0b - 2 * x1b - x2b) * K_grid) / x1b
      let k1 := ((pb - x0a - 2 * x1a - x2a) * K_grid) / x1a
      let ub := buchstabUB k0 k1
      if x0b ≤ x1a && x1b ≤ x2a then
        ub * wSimp x0a x0b * wInvSq x1a x1b * wSimp x2a x2b
      else if x0a == x1a && x0b == x1b && x1b ≤ x2a then
        ub * ceilDiv (wSimp x0a x0b * wInvSq x0a x0b) 2 * wSimp x2a x2b
      else if x0b ≤ x1a && x1a == x2a && x1b == x2b then
        ub * wSimp x0a x0b * wDiag12 x1a x1b
      else
        ub * wDiag012 x0a x0b
  | .s0 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      evalBox pa pb l x0a m x1a x1b x2a x2b + evalBox pa pb r m x0b x1a x1b x2a x2b
  | .s1 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x1a + x1b) / 2
      evalBox pa pb l x0a x0b x1a m x2a x2b + evalBox pa pb r x0a x0b m x1b x2a x2b
  | .s2 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x2a + x2b) / 2
      evalBox pa pb l x0a x0b x1a x1b x2a m + evalBox pa pb r x0a x0b x1a x1b m x2b
  | .sd01 c01 mm c12, a, b, _, _, x2a, x2b =>
      let m := (a + b) / 2
      evalBox pa pb c01 a m a m x2a x2b + evalBox pa pb mm a m m b x2a x2b + evalBox pa pb c12 m b m b x2a x2b
  | .s2d01 l r, a, b, _, _, x2a, x2b =>
      let m := (x2a + x2b) / 2
      evalBox pa pb l a b a b x2a m + evalBox pa pb r a b a b m x2b
  | .s0d12 l r, x0a, x0b, a, b, _, _ =>
      let m := (x0a + x0b) / 2
      evalBox pa pb l x0a m a b a b + evalBox pa pb r m x0b a b a b
  | .sd12 c01 mm c12, x0a, x0b, a, b, _, _ =>
      let m := (a + b) / 2
      evalBox pa pb c01 x0a x0b a m a m + evalBox pa pb mm x0a x0b a m m b + evalBox pa pb c12 x0a x0b m b m b
  | .sd012 c0 m01 m12 c1, a, b, _, _, _, _ =>
      let m := (a + b) / 2
      evalBox pa pb c0 a m a m a m + evalBox pa pb m01 a m a m m b + evalBox pa pb m12 a m m b m b + evalBox pa pb c1 m b m b m b

