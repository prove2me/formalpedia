-- Source module: NLogNP.Item
/-!
# Integer items on stacks

An item is an integer (sign–magnitude, minimal binary, least significant bit nearest the header)
or a mark.  On a stack an item is its header symbol followed by its magnitude bits; the next
item's header ends the bits.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Minimal binary -/

/-- Minimal little-endian binary representation. -/
def nbits (m : ℕ) : List Bool :=
  if h : m = 0 then [] else decide (m % 2 = 1) :: nbits (m / 2)
decreasing_by omega

/-- Drop high zero bits. -/
def trimL : List Bool → List Bool
  | [] => []
  | b :: l => if trimL l = [] ∧ b = false then [] else b :: trimL l

/-! ## Items -/

def hdPos : Sym := 4
def hdNeg : Sym := 6
def hdMark : Sym := 8

inductive Item where
  | int (z : ℤ)
  | mark
  deriving DecidableEq

def hdOf (z : ℤ) : Sym := if z < 0 then hdNeg else hdPos

/-- Magnitude bits of an integer. -/
def zbits (z : ℤ) : List Bool := nbits z.natAbs

/-- Bit size of an integer. -/
def zsz (z : ℤ) : ℕ := (zbits z).length

def Item.enc : Item → List Sym
  | .int z => hdOf z :: (zbits z).map codeBit
  | .mark => [hdMark]

def encL (L : List Item) : List Sym := L.flatMap Item.enc

@[simp] theorem encL_nil : encL [] = [] := rfl

@[simp] theorem bitOf_hdPos : bitOf (some hdPos) = none := rfl
@[simp] theorem bitOf_hdNeg : bitOf (some hdNeg) = none := rfl
@[simp] theorem bitOf_hdMark : bitOf (some hdMark) = none := rfl

end NLogN

namespace NLogN

/-! ## Bit-level functions for `zip` -/

def fAdd (x y c : Bool) : Bool × Bool := (x ^^ y ^^ c, (x && y) || (c && (x ^^ y)))
def fSub (x y c : Bool) : Bool × Bool := (x ^^ y ^^ c, (!x && (y || c)) || (x && y && c))
def fNeg (x _y c : Bool) : Bool × Bool := (x ^^ c, c || x)
/-- Copy the second word. -/
def fCopy (_x y _c : Bool) : Bool × Bool := (y, false)

end NLogN

end

section
-- Source module: NLogNP.IntOps
/-!
# Basic operations on integer items
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Moving bits -/

def bitG (s : Sym) : Option Sym := if s = 0 ∨ s = 1 then some s else none

/-- Move the bits on top of `src` to `dst` (reversing them). -/
def moveBits (q src dst : Fin S) : Stmt S P := move q src dst bitG

/-! ## Trimming high zero bits (most significant bit on top) -/

def trimTop (t : Fin S) : Stmt S P := .loop t (fun o => decide (o = some 0)) (.pop t)

/-! ## Popping and moving items -/

def popBits (t : Fin S) : Stmt S P := .loop t (fun o => (bitOf o).isSome) (.pop t)

def popInt (i : Fin S) : Stmt S P := .seq (.pop i) (popBits i)

/-- Move an integer item with header `h` and bits `l`, via the scratch stack `t`. -/
def mvInt (q i j t : Fin S) (h : Sym) : Stmt S P :=
  .seq (.pop i) (.seq (moveBits q i t) (.seq (moveBits q t j) (.push j h)))

/-- Move the integer item on top of `i` onto `j`, via the scratch stack `t`. -/
def moveInt (q i j t : Fin S) : Stmt S P :=
  caseTop i fun o => if o = some hdNeg then mvInt q i j t hdNeg else mvInt q i j t hdPos

end NLogN

end

section
-- Source module: NLogNP.Arith
/-!
# Signed addition of integer items
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def finAdd (c : Bool) : List Sym := if c then [1] else []

/-- Add the magnitudes on top of `i` and `j` (popping them) and push the sum with header `h`
on `k`. -/
def addMag (q i j k t1 t2 : Fin S) (h : Sym) : Stmt S P :=
  .seq (zip q i j t1 t2 false fAdd finAdd false)
    (.seq (trimTop t1) (.seq (moveBits q t1 k) (.push k h)))

def addMagCost (L : ℕ) : ℕ := zipCost 1 L + (2 * (L + 1) + 1) + moveCost (L + 1) + 1

section
variable {q i j k t1 t2 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqt1 : q ≠ t1) (hqt2 : q ≠ t2)
  (hij : i ≠ j) (hit1 : i ≠ t1) (hit2 : i ≠ t2) (hjt1 : j ≠ t1) (hjt2 : j ≠ t2) (ht12 : t1 ≠ t2)
  (hqk : q ≠ k) (hkt1 : k ≠ t1) (hkt2 : k ≠ t2)

end

def flagB : Sym := 9
def finSub (c : Bool) : List Sym := if c then [flagB] else []
def finNone (_c : Bool) : List Sym := []

def isBitT (o : Option Sym) : Bool := (bitOf o).isSome

/-- Subtract the magnitude on top of `j` from that on top of `i` (popping both); push the
absolute difference on `k`, with header `hpos` if it was positive, `hneg` if negative. -/
def subMag (q i j k t1 t2 : Fin S) (hpos hneg : Sym) : Stmt S P :=
  .seq (zip q i j t1 t2 false fSub finSub false)
    (.ite t1 (fun o => decide (o = some flagB))
      (.seq (.pop t1) (.seq (moveBits q t1 t2) (.seq (zip q t2 i t1 j false fNeg finNone false)
        (.seq (trimTop t1) (.seq (moveBits q t1 k) (.push k hneg))))))
      (.seq (trimTop t1) (.ite t1 isBitT (.seq (moveBits q t1 k) (.push k hpos)) (.push k hdPos))))

def subMagCost (L : ℕ) : ℕ :=
  zipCost 1 L + 1 + (1 + (moveCost L + (zipCost 0 L + (2 * L + 1 + (moveCost L + 1)))))

/-- Signed difference as a header and magnitude. -/
def subHd (a b : ℕ) (hpos hneg : Sym) : Sym := if b < a then hpos else if a < b then hneg else hdPos

section
variable {q i j k t1 t2 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqt1 : q ≠ t1) (hqt2 : q ≠ t2)
  (hij : i ≠ j) (hit1 : i ≠ t1) (hit2 : i ≠ t2) (hjt1 : j ≠ t1) (hjt2 : j ≠ t2) (ht12 : t1 ≠ t2)
