  rw [← Ideal.under_under (A := ℤ) (B := 𝓞 (↥(_root_.LanglandsTunnell.P0.fixFld (_root_.LanglandsTunnell.P5.sylowH e)))) (C := 𝓞 L),
    under_primeOver, asIdeal_under_int]

