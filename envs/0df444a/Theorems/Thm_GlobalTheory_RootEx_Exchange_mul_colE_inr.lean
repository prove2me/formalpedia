variable {k : Type*} [Field k] {n : Type*} [Fintype n] [DecidableEq n] {c : ℕ}

theorem GlobalTheory.RootEx.Exchange.mul_colE_inr (p : ℕ) (u : n → k) (M : Matrix (n ⊕ Fin c) (n ⊕ Fin c) k) (r) (s : Fin c) :
    (M * (colE c p u).val) r (Sum.inr s) =
      M r (Sum.inr s) + if s.val + 1 = p then ∑ t, M r (Sum.inl t) * u t else 0 := by sorry
