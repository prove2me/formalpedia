    (p : ℕ) : VeluDeficitFunEvalAtPlaceAt F hDD p := by
  intro W hΔ x₀ y₀ h₀ _hord r s hrs hav
  haveI := hDD W hΔ
  exact Affine.evalAt_veluDeficitFun_placeOfEquation hrs hav

theorem veluDeficitIsConstantAt_of_ordNonneg_of_dedekind {p : ℕ}
