private theorem t0085 (v : HeightOneSpectrum (𝓞 K)) (m : ℕ) (z : (AdeleRing (𝓞 K) K)ˣ)
    {g : AdelicGL2 (𝓞 K) K} (hg : MemZK0At v m g) : MemZK0At v m (centralScalar (𝓞 K) K z * g) := by
