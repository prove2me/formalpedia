/-- Componentwise Taylor form. -/
def tf (c w : DyadicJet5Enclosure P) (δ : DyadicInterval P) : DyadicJet5Enclosure P :=
  ⟨(((((tfTerm c.d0 δ 0).add (tfTerm c.d1 δ 1)).add (tfTerm c.d2 δ 2)).add (tfTerm c.d3 δ 3)).add (tfTerm c.d4 δ 4)).add (tfTerm w.d5 δ 5),
   ((((tfTerm c.d1 δ 0).add (tfTerm c.d2 δ 1)).add (tfTerm c.d3 δ 2)).add (tfTerm c.d4 δ 3)).add (tfTerm w.d5 δ 4),
   (((tfTerm c.d2 δ 0).add (tfTerm c.d3 δ 1)).add (tfTerm c.d4 δ 2)).add (tfTerm w.d5 δ 3),
   ((tfTerm c.d3 δ 0).add (tfTerm c.d4 δ 1)).add (tfTerm w.d5 δ 2),
   (tfTerm c.d4 δ 0).add (tfTerm w.d5 δ 1),
   tfTerm w.d5 δ 0⟩

/-- Soundness of the Taylor form on a segment where the jet is sound. -/
theorem tf_sound {c w : DyadicJet5Enclosure P} {δ : DyadicInterval P} {y0 y1 ys y : ℝ}
    (hs : ∀ z, y0 ≤ z → z ≤ y1 → qJet.SoundAt z)
    (hw : ∀ z, y0 ≤ z → z ≤ y1 → w.d5.Contains (qJet.d5 z))
    (hc : c.Contains qJet ys) (hys : y0 ≤ ys ∧ ys ≤ y1) (hy : y0 ≤ y ∧ y ≤ y1)
    (hd : δ.Contains (y - ys)) : (tf c w δ).Contains qJet y := by
  obtain ⟨hc0, hc1, hc2, hc3, hc4, hc5⟩ := hc
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- component d0
    obtain ⟨ξ, hξ0, hξ1, heq⟩ := seg_taylor_d0 (j := qJet) hs hys hy
    rw [heq]
    have hsum := (add_sound (add_sound (add_sound (add_sound (add_sound (tfTerm_sound hc0 hd 0) (tfTerm_sound hc1 hd 1)) (tfTerm_sound hc2 hd 2)) (tfTerm_sound hc3 hd 3)) (tfTerm_sound hc4 hd 4)) (tfTerm_sound (hw ξ hξ0 hξ1) hd 5))
    simp only [Nat.factorial, Nat.succ_eq_add_one] at hsum
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring)
  · -- component d1
    obtain ⟨ξ, hξ0, hξ1, heq⟩ := seg_taylor_d1 (j := qJet) hs hys hy
    rw [heq]
    have hsum := (add_sound (add_sound (add_sound (add_sound (tfTerm_sound hc1 hd 0) (tfTerm_sound hc2 hd 1)) (tfTerm_sound hc3 hd 2)) (tfTerm_sound hc4 hd 3)) (tfTerm_sound (hw ξ hξ0 hξ1) hd 4))
    simp only [Nat.factorial, Nat.succ_eq_add_one] at hsum
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring)
  · -- component d2
    obtain ⟨ξ, hξ0, hξ1, heq⟩ := seg_taylor_d2 (j := qJet) hs hys hy
    rw [heq]
    have hsum := (add_sound (add_sound (add_sound (tfTerm_sound hc2 hd 0) (tfTerm_sound hc3 hd 1)) (tfTerm_sound hc4 hd 2)) (tfTerm_sound (hw ξ hξ0 hξ1) hd 3))
    simp only [Nat.factorial, Nat.succ_eq_add_one] at hsum
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring)
  · -- component d3
    obtain ⟨ξ, hξ0, hξ1, heq⟩ := seg_taylor_d3 (j := qJet) hs hys hy
    rw [heq]
    have hsum := (add_sound (add_sound (tfTerm_sound hc3 hd 0) (tfTerm_sound hc4 hd 1)) (tfTerm_sound (hw ξ hξ0 hξ1) hd 2))
    simp only [Nat.factorial, Nat.succ_eq_add_one] at hsum
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring)
  · -- component d4
    obtain ⟨ξ, hξ0, hξ1, heq⟩ := seg_taylor_d4 (j := qJet) hs hys hy
    rw [heq]
    have hsum := (add_sound (tfTerm_sound hc4 hd 0) (tfTerm_sound (hw ξ hξ0 hξ1) hd 1))
    simp only [Nat.factorial, Nat.succ_eq_add_one] at hsum
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring)
  · -- component d5
    have hξ0 := hy.1
    have hξ1 := hy.2
    have hsum := (tfTerm_sound (hw y hξ0 hξ1) hd 0)
    simp only [tf, Nat.factorial, pow_zero, mul_one] at hsum ⊢
    push_cast at hsum ⊢
    convert hsum using 1 <;> first | rfl | ring | (push_cast; ring) | simp

#print axioms tf_sound

