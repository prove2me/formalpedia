open scoped IntermediateField

theorem ModularCurve.exists_coe_eq_jqModC_and_transcendental_and_finiteDimensional_and_isSeparable_x1FunctionFieldC
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hM : 5 ≤ M) (hpM : ¬ p ∣ M)
    (k : Type) [Field k] [IsAlgClosed k] [CharP k p] :
    ∃ t : ↥(ModularCurve.x1FunctionFieldC k M),
      ((t : ↥(ModularCurve.x1FunctionFieldC k M)) : LaurentSeries k) = ModularCurve.jqModC k ∧
      Transcendental k t ∧
      FiniteDimensional ↥k⟮t⟯ ↥(ModularCurve.x1FunctionFieldC k M) ∧
      Algebra.IsSeparable ↥k⟮t⟯ ↥(ModularCurve.x1FunctionFieldC k M) := by sorry
