/-! # One actual original-band histogram, buckets, and six pointer headers -/

namespace ThreeSum.LightSourceBandStep

open Light BandPartition SourceBandLayout

set_option maxHeartbeats 3000000
set_option maxRecDepth 18000



































variable {lim : Limits} {P : Program} {d : ℕ}




























































































































theorem Procs.meets_sourceProof {pMain : ℕ} (C : Procs P pMain)
    {μ : ℕ → ℤ} {src n g p m base U D i : ℕ} {shift : ℤ} (f : ℕ → ℤ)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+3 < lim.depth)
    (hg : 0 < g) (hp : 0 < p) (hm : 0 < m) (hi : i < size n g)
    (hsrc : src+n ≤ base)
    (hspace : LightSourceResidues.space (work base n g m) p U D ≤ lim.space)
    (hshift : |shift| ≤ (D : ℤ)) (hword : (word n g p m U D : ℤ) ≤ lim.word)
    (hread : ∀ j < n, μ (src+j)=f j) (hvalues : ∀ j < n, |f j| ≤ (U : ℤ)) :
    Meets lim P pMain d
      [src,n,g,p,m,shift,base,cap n g,size n g,data base n g,stride n g m,work base n g m,i]
      μ (time n g p m U D) (fun _ ν =>
        SourceBandData.At ν f base n g p m shift i ∧
        KeptBut μ ν (hist base n g m i) (base+6*i) 6) := by
  have hidx : i*g < n := start_lt hg hi
  have hcount := size_le n g
  have hnext : (i+1)*g ≤ n+g := by nlinarith
  have hwordN : ((n+g+2 : ℕ) : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr (show n+g+2 ≤ word n g p m U D by unfold word; omega)).trans hword
  have hprod : (i : ℤ)*(g : ℤ) ≤ lim.word :=
    (by exact_mod_cast (show i*g ≤ n+g+2 by omega) :
      (i : ℤ)*(g : ℤ) ≤ ((n+g+2 : ℕ) : ℤ)).trans hwordN
  have hprodN : (0 : ℤ) ≤ (i : ℤ)*(g : ℤ) := by positivity
  have hnextZ : ((i : ℤ)+1)*(g : ℤ) ≤ lim.word :=
    (by exact_mod_cast (show (i+1)*g ≤ n+g+2 by omega) :
      ((i : ℤ)+1)*(g : ℤ) ≤ ((n+g+2 : ℕ) : ℤ)).trans hwordN
  have hnextN : (0 : ℤ) ≤ ((i : ℤ)+1)*(g : ℤ) := by positivity
  have htailTime : tailTime n g p m U D=charge n g p m U D+1000 := rfl
  apply Meets.of_body C.main
  unfold body time
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (start g i : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, start,
                tailTime]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [start, tailTime] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, start, tailTime] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen ((i + 1) * g : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                tailTime]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [tailTime] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, tailTime] <;> omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine
        Light.Ends.iteIffThen ((n : ℤ) < (((i + 1) * g : ℕ) : ℤ))
          (fun hlarge => ?_) (fun hlarge => ?_) ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                tailTime]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [tailTime] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, tailTime] <;> omega)));
    (all_goals
        repeat
          with_unfolding_none
            first
            | refine Light.Ends.seqAssoc ?_
            | refine Light.Ends.skipThen ?_)
  · have hmin : n=stop n g i := by unfold stop; omega
    focus
      ((((first
              | refine Light.Ends.seqSelf ?_
              | refine Light.Ends.skipLast ?_));
          (repeat
              with_unfolding_none
                first
                | refine Light.Ends.seqAssoc ?_
                | refine Light.Ends.skipThen ?_)));
      (refine Light.Ends.setToThen (n : ℕ) ?_ ?_ ?_);
      (on_goal -1 =>
          first
          |
            ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                  List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                  tailTime]);
              (first
                | omega
                | ((ring_nf); (omega))))
          | omega
          |
            (simp [tailTime] <;>
                first
                | omega
                | ((ring_nf); (omega))));
      (on_goal -1 =>
          (((try have := Light.Std.space_le (by assumption)));
            ((try have := Light.Std.const_le (by assumption)));
            (simp [Light.Limits.Addr, abs_le, -abs_mul, tailTime] <;> omega)));
      (try with_unfolding_none refine Light.Ends.skip ?_)
    focus
      ((refine
            Light.Ends.pieceLast
              (tail_ends C.original (last := n) f hw hd hg hp hm hi hsrc hmin hspace
                hshift hword hread hvalues)
              (fun _ apspMacro_22380_0 => apspMacro_22380_0) ?_);
        (on_goal -1 =>
            first
            |
              ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                    List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, ]);
                (first
                  | omega
                  | ((ring_nf); (omega))))
            | omega
            |
              (simp [] <;>
                  first
                  | omega
                  | ((ring_nf); (omega)))))
  · have hmin : (i+1)*g=stop n g i := by unfold stop; omega
    focus
      ((refine
            Light.Ends.pieceLast
              (tail_ends C.original (last := (i + 1) * g) f hw hd hg hp hm hi hsrc
                hmin hspace hshift hword hread hvalues)
              (fun _ apspMacro_22562_0 => apspMacro_22562_0) ?_);
        (on_goal -1 =>
            first
            |
              ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                    List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, ]);
                (first
                  | omega
                  | ((ring_nf); (omega))))
            | omega
            |
              (simp [] <;>
                  first
                  | omega
                  | ((ring_nf); (omega)))))

end ThreeSum.LightSourceBandStep

