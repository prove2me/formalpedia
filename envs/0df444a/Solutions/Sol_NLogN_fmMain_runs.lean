  have hall := IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq h5 (IRuns.seq h6
    (IRuns.seq h7 (IRuns.seq h8 (IRuns.seq h9 (IRuns.seq h10 (IRuns.seq h11 (IRuns.seq h12
