theorem blk_ints (A : List ℤ) (R : List Item) : NLogN.KFY.blk (ints A ++ .mark :: R) = ints A := by
  induction A with
  | nil => simp [NLogN.KFY.blk, ints]
  | cons a A ih =>
    simp only [NLogN.KFY.blk, ints, List.map_cons, List.cons_append] at ih ⊢
    rw [List.takeWhile_cons_of_pos (by simp), ih]

theorem aft_ints (A : List ℤ) (R : List Item) : aft (ints A ++ .mark :: R) = R := by
  induction A with
  | nil => simp [aft, ints]
  | cons a A ih =>
    simp only [aft, ints, List.map_cons, List.cons_append] at ih ⊢
    rw [List.dropWhile_cons_of_pos (by simp), ih]

theorem descTr_items (w h : ℕ) (bs : List Bool) :
    ints (descTr w h bs) = .int (w : ℤ) :: .int (h : ℤ) :: .int (bs.length : ℤ) ::
      ints (bs.map fun b => if b then (1 : ℤ) else 0) := rfl

theorem hOf_descTr (w h : ℕ) (bs : List Bool) : hOf (ints (descTr w h bs)) = h := by
  simp [hOf, descTr_items, itZ]

theorem wOfD_descTr (w h : ℕ) (bs : List Bool) : wOfD (ints (descTr w h bs)) = w := by
  simp [wOfD, descTr_items, itZ]

theorem bsOf_descTr (w h : ℕ) (bs : List Bool) : bsOf (ints (descTr w h bs)) = bs := by
  rw [descTr_items]
  simp only [bsOf, ints, List.drop_succ_cons, List.drop_zero, List.map_map]
  conv_rhs => rw [← List.map_id bs]
  apply List.map_congr_left
  intro b _
  cases b <;> simp

theorem pairsOf_gflat (zs : List GI) (l : List Item) :
    pairsOf zs.length (ints (gflat zs) ++ l) = zs := by
  induction zs with
  | nil => rfl
  | cons z zs ih =>
    simp only [List.length_cons, gflat, List.flatMap_cons, ints, List.map_append,
      List.map_cons, List.map_nil, List.cons_append, List.nil_append, List.append_assoc] at ih ⊢
    simp only [pairsOf, itZ]
    rw [ih]

theorem drop_gflat (zs : List GI) (l : List Item) :
    (ints (gflat zs) ++ l).drop (2 * zs.length) = l := by
  have : (ints (gflat zs)).length = 2 * zs.length := by
    induction zs with
    | nil => rfl
    | cons z zs ih =>
      simp only [ints, gflat, List.flatMap_cons, List.map_append, List.length_append,
        List.length_map, List.length_cons, List.length_nil] at ih ⊢
      omega
  rw [← this, List.drop_left]

