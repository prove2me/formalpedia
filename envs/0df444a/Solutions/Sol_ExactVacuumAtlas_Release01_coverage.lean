/-!
# Kerr in Kerr's original (ingoing / advanced Eddington–Finkelstein) coordinates

Source: Visser, *The Kerr spacetime: a brief introduction*, arXiv:0706.0622, eq. (E:K1)
(local copy `archive/sources_atlas01/arXiv_0706.0622_eprint.tgz`, file `Survey-grqc-3.tex`,
lines 205–215), units `G = c = 1`, mass `m = M`:

`ds² = −[1 − 2Mr/Σ] (du + a sin²θ dφ)² + 2 (du + a sin²θ dφ)(dr + a sin²θ dφ) + Σ (dθ² + sin²θ dφ²)`,
`Σ = r² + a² cos²θ`.

Coordinates `(v, r, θ, φ) = (x 0, x 1, x 2, x 3)`; Visser's `u` is called `v` here (it is the
advanced null coordinate). Matrix entries are read off with the half-Hessian convention
(`g_{vr} = 1` from `2 dv dr`): with `F = 1 − 2Mr/Σ` and `A = a sin²θ`,
`g_vv = −F`, `g_vr = 1`, `g_vφ = −F A + A`, `g_rφ = A`, `g_θθ = Σ`,
`g_φφ = −F A² + 2 A² + Σ sin²θ`, all other entries `0`.

Parameters: every real `M`, `a`. Domain: `Σ ≠ 0`, `sin θ ≠ 0`. There is **no** `Δ ≠ 0`
condition: the coordinate locus `Δ = r² − 2Mr + a² = 0` (horizon radii, as a name only) lies inside
the domain. No causal statement is made.
-/

open Real

namespace ExactVacuumAtlas.Kerr.In

theorem eqPt_mem {a ρ : ℝ} (hρ : ρ ≠ 0) : eqPt ρ ∈ domIn a := by
  refine ⟨?_, ?_⟩
  · show ρ ^ 2 + a ^ 2 * cos (π / 2) ^ 2 ≠ 0
    simp [hρ]
  · show sin (π / 2) ≠ 0
    simp

/-- For `M > 0` and `a² ≤ M²` the radius `r₊ = M + √(M² − a²)` (where `Δ = 0`) is inside
the ingoing domain. -/
theorem horizon_mem {M a : ℝ} (hM : 0 < M) (ha : a ^ 2 ≤ M ^ 2) :
    eqPt (M + Real.sqrt (M ^ 2 - a ^ 2)) ∈ domIn a ∧
      (M + Real.sqrt (M ^ 2 - a ^ 2)) ^ 2 - 2 * M * (M + Real.sqrt (M ^ 2 - a ^ 2)) + a ^ 2 = 0 := by
  have hq : 0 ≤ M ^ 2 - a ^ 2 := by linarith
  have hsq := Real.sq_sqrt hq
  have hpos : 0 < M + Real.sqrt (M ^ 2 - a ^ 2) := by positivity
  exact ⟨eqPt_mem hpos.ne', by nlinarith⟩

end ExactVacuumAtlas.Kerr.In

