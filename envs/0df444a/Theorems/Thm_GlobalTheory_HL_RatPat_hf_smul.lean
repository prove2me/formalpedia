theorem GlobalTheory.HL.RatPat.hf_smul {F E : Type} [Field F] [ValuativeRel F] [TopologicalSpace F] [CommRing E] [Algebra F E]
    [TopologicalSpace E] (L : LocE F E) {n : ℕ} (Hm : Matrix (Fin n) (Fin n) E) (α β : F) (x y : Fin n → E) :
    hf L Hm (algebraMap F E α • x) (algebraMap F E β • y) =
      algebraMap F E α * algebraMap F E β * hf L Hm x y := by sorry
