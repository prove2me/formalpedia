theorem solution :
    penaltyPotential (n3 1) (m3 1) ≤ ((806290758639450817762753751715513287105041458170000000000000000000000000000000000000 : ℕ) : ℝ)/10^30 := by
  have hc := mme_released_recursive_stage_region1_counts
  unfold penaltyPotential
  have hterm : ∀ r : Fin 88,
      ((n3 1 r : ℕ) : ℝ) * Real.log 2 *
          RecursiveThinSplit.entropyPenalty (fun c ↦ ((m3 1 r c : ℕ) : ℝ) / (n3 1 r : ℝ)) ≤
        ((n3 1 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by
    intro r
    have hcast : (fun c ↦ ((m3 1 r c : ℕ) : ℝ) / ((n3 1 r : ℕ) : ℝ)) =
        fun c ↦ ((alphaG (n3 1) (m3 1) r c : ℚ) : ℝ) := by
      funext c
      unfold alphaG
      push_cast
      ring
    rw [mul_assoc, hcast]
    have h2 : (0 : ℝ) ≤ ((n3 1 r : ℕ) : ℝ) := by positivity
    calc ((n3 1 r : ℕ) : ℝ) * (Real.log 2 * RecursiveThinSplit.entropyPenalty _)
        ≤ ((n3 1 r : ℕ) : ℝ) * (((L3Agg.pgn r : ℕ) : ℝ)/10^30) :=
          mul_le_mul_of_nonneg_left (L3Agg.hpen r) h2
      _ = ((n3 1 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by push_cast; ring
  refine le_trans (Finset.sum_le_sum (fun r _ ↦ hterm r)) (le_of_eq ?_)
  rw [← Finset.sum_div, ← Nat.cast_sum, L3Agg.psum]
