/-! ## Triangle-inequality helpers -/

theorem abs_add_three_le {a b c : ℝ} : |a + b + c| ≤ |a| + |b| + |c| := by
  have h1 := abs_add_le (a + b) c
  have h2 := abs_add_le a b
