theorem encF_succ (f : ℕ → List ℤ) (a n : ℕ) :
    encF f a (n + 1) = ints (f a) ++ .mark :: encF f (a + 1) n := by
  simp [encF, List.range'_succ, enc_cons]

theorem encF_snoc (f : ℕ → List ℤ) (a n : ℕ) :
    encF f a (n + 1) = encF f a n ++ (ints (f (a + n)) ++ [.mark]) := by
  simp [encF, List.range'_concat, enc_append, enc]

theorem encF_snoc_rev (f : ℕ → List ℤ) (n : ℕ) (L : List Item) :
    (encF f 0 (n + 1)).reverse ++ L = .mark :: ints (f n).reverse ++ ((encF f 0 n).reverse ++ L) := by
  rw [encF_snoc]; simp [ints_reverse]

theorem flF_succ (f : ℕ → List ℤ) (a n : ℕ) : flF f a (n + 1) = f a ++ flF f (a + 1) n := by
  simp [flF, List.range'_succ]

theorem flF_snoc (f : ℕ → List ℤ) (a n : ℕ) : flF f a (n + 1) = flF f a n ++ f (a + n) := by
  simp [flF, List.range'_concat]

theorem encF_const_nil (a n : ℕ) : encF (fun _ => []) a n = marks n := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => rw [encF_succ, ih]; rfl

theorem NI_rev_encF (f : ℕ → List ℤ) (n : ℕ) (L : List Item) (hL : NI L) :
    NI ((encF f 0 n).reverse ++ L) := by
  rcases n with _ | n
  · simpa using hL
  · rw [encF_snoc_rev]; exact NI_mark _

theorem bnd_flF {w : ℕ} {f : ℕ → List ℤ} (h : ∀ i, Bnd w (f i)) (a n : ℕ) : Bnd w (flF f a n) := by
  intro x hx
  simp only [flF, List.mem_flatMap] at hx
  obtain ⟨i, -, hi⟩ := hx; exact h i x hi

/-! ## Forward zip column: `mvW A T; unmark A; mvB X T CB DB; mark T` -/

theorem zcol_runs (s : IState HS) (g rc : List ℤ) (LA R0 LCB LDB : List Item) (w : ℕ)
