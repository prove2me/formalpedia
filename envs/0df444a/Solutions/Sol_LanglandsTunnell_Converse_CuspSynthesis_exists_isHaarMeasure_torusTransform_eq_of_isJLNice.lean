  have h : ∀ n : ↥S → ℤ, d.a (R.rep n) * d.epsChar g * ((d034 S).toReal : ℂ) *
      ∫ z in d020 S, d043 archR archC dR dC epsS dF (R.rep n) g μ s z
        ∂(NumberField.Idele.idelicHaar K) =
      d.epsChar g * ((d034 S).toReal : ℂ) *
