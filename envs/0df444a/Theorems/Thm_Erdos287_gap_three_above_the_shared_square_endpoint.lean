-- title:
--   Erdős 287 above the complete shared-square finite endpoint
-- statement:
--   Prove Erdős #287 for each exact unit-fraction representation whose maximum denominator is strictly above the given exact endpoint, approximately $1.83073882\times10^{970}$. This is the still-open remainder above the Lean-certified finite prefix.
-- source:
--   Erdős Problem 287 and the verified shared-square finite certificate.

import Mathlib

theorem Erdos287.gap_three_above_the_shared_square_endpoint (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf1 : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hlarge :  < f (k - 1)) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
