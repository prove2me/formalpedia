theorem pushOK_step {t : IState HS} {Bb V N : ℕ} {LQ : List Item} (hV : zsz (V : ℤ) ≤ Bb)
    (hQQ : t.G sQQ = .int (N : ℤ) :: LQ) (hN : 1 ≤ N) (pa pc : Ex HS) {VA VC : ℕ}
    (hpa : PosE t pa) (hpar : ∀ r ∈ pa.regs, RdOK r) (hpae : pa.eval t = VA)
    (hpc : PosE t pc) (hpcr : ∀ r ∈ pc.regs, RdOK r) (hpce : pc.eval t = VC)
    (hVV : VA * (N * VC) ≤ V) (stg : List (Ex HS × Ex HS)) (hstg : ∀ p ∈ stg, StgE t Bb p)
    (hprod : (stg.map (·.1.eval t)).prod ≤ V) :
    PushOK t Bb (prmL pa pc ++ stgPush stg) := by
  have hq : PosE t (.reg sQQ) := ⟨IState.isInt_of hQQ, by rw [IState.top_eq hQQ]; exact_mod_cast hN⟩
  have hqr : ∀ r ∈ (Ex.reg sQQ : Ex HS).regs, RdOK r := by
    intro r hr; simp [Ex.regs] at hr; exact Or.inl hr
  have eq : (Ex.reg sQQ : Ex HS).eval t = N := by simp only [Ex.eval]; rw [IState.top_eq hQQ]
  have hA1 : 1 ≤ VA := by have := (PosE.facts pa hpa).1; omega
  have hC1 : 1 ≤ VC := by have := (PosE.facts pc hpc).1; omega
  have b1 : VA ≤ V := le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega))) hVV
  have b2 : N * VC ≤ V := le_trans (Nat.le_mul_of_pos_left _ (by omega)) hVV
  have b3 : VC ≤ V := le_trans (Nat.le_mul_of_pos_left _ (by omega)) b2
  apply pushOK_of
  · intro p hp
    rcases List.mem_append.1 hp with hp | hp
    · simp only [prmL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl <;> simp (config := {decide := true})
    · rcases stgPush_fst stg p hp with h | h | h | h <;> rw [h] <;> decide
  · intro p hp
    rcases List.mem_append.1 hp with hp | hp
    · simp only [prmL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl
      · exact goodE_pos hpa hpar (M := V) (by rw [hpae]; exact_mod_cast b1) hV
      · exact goodE_pos hpc hpcr (M := V) (by rw [hpce]; exact_mod_cast b3) hV
      · refine goodE_pos (e := .mul pa (.mul (.reg sQQ) pc)) ⟨hpa, hq, hpc⟩ ?_ (M := V) ?_ hV
        · intro r hr
          simp only [Ex.regs, List.mem_append] at hr
          rcases hr with hr | hr | hr
          · exact hpar r hr
          · exact hqr r hr
          · exact hpcr r hr
        · simp only [Ex.eval, hpae, hpce]; rw [IState.top_eq hQQ]; exact_mod_cast hVV
      · refine goodE_pos (e := .mul (.reg sQQ) pc) ⟨hq, hpc⟩ ?_ (M := V) ?_ hV
        · intro r hr
          simp only [Ex.regs, List.mem_append] at hr
          rcases hr with hr | hr
          · exact hqr r hr
          · exact hpcr r hr
        · simp only [Ex.eval, hpce]; rw [IState.top_eq hQQ]; exact_mod_cast b2
    · exact stg_good hV stg hstg hprod p hp

variable {m : ℕ}

theorem powE_regs (e : Ex HS) (n : ℕ) (h : ∀ r ∈ e.regs, RdOK r) :
    ∀ r ∈ (powE e n).regs, RdOK r := fun r hr => by
  obtain ⟨e', he', hr'⟩ := prodE_regs _ r hr
  rw [List.eq_of_mem_replicate he'] at hr'
  exact h r hr'

theorem powE_pos {t : IState HS} {e : Ex HS} (h : PosE t e) (n : ℕ) : PosE t (powE e n) :=
  prodE_pos _ fun e' he' => by rw [List.eq_of_mem_replicate he']; exact h

theorem powE_eval (t : IState HS) (e : Ex HS) (n : ℕ) : (powE e n).eval t = e.eval t ^ n := by
  simp [powE, prodE_eval, List.map_replicate, List.prod_replicate]

theorem rd_reg {r : Fin HS} (h : RdOK r) : ∀ r' ∈ (Ex.reg r : Ex HS).regs, RdOK r' := by
  intro r' hr'; simp [Ex.regs] at hr'; rw [hr']; exact h

theorem cv_ctrl {N : ℕ} (T : TSh m) {j : ℕ} (hj : j < (T.i : ℕ)) :
    cv (T.ctrl N) j = (fracZ N (T.cs j).1 (T.cs j).2).val := by
  have hjm : j < m + m := lt_trans hj T.i.2
  unfold cv TSh.ctrl
  rw [dif_pos hjm, if_pos (by rw [Fin.lt_def]; exact hj)]

theorem ctrl_zero {N : ℕ} (T : TSh m) : ∀ j, T.i ≤ j → T.ctrl N j = 0 := fun j hj => by
  unfold TSh.ctrl; rw [if_neg (not_lt.2 hj)]

theorem cv_lt {N : ℕ} [NeZero N] (c : Fin (m + m) → ZMod N) (j : ℕ) : cv c j < N := by
  unfold cv; split_ifs
  · exact ZMod.val_lt _
  · exact Nat.pos_of_ne_zero (NeZero.ne N)

theorem goodE_lit0 {t : IState HS} {Bb : ℕ} : GoodE t Bb (.lit 0) :=
  ⟨by simp [Ex.regs], trivial, by simp [Ex.Bnd, zsz_zero]⟩

theorem ctE_facts {t : IState HS} {N Bb : ℕ} {LQ : List Item} (hQQ : t.G sQQ = .int (N : ℤ) :: LQ)
    (hN : 1 ≤ N) (T : TSh m) (hT : TOK T N Bb) {j : ℕ} (hj : j < (T.i : ℕ)) :
    StgE t Bb (ctE T j) ∧ (ctE T j).1.eval t = N ∧
      (ctE T j).2.eval t = ((cv (T.ctrl N) j : ℕ) : ℤ) := by
  obtain ⟨h1, h2, h3⟩ := hT.cs j hj
  obtain ⟨ok, ev, bd⟩ := ctrlE_facts (T.cs j).1 hQQ hN h1 h2 h3
  refine ⟨⟨⟨IState.isInt_of hQQ, by rw [IState.top_eq hQQ]; exact_mod_cast hN⟩,
    rd_reg (Or.inl rfl), ⟨fun r hr => Or.inl (ctrlE_regs _ _ r hr), ok, bd⟩⟩, ?_, ?_⟩
  · simp only [ctE, Ex.eval]; rw [IState.top_eq hQQ]
  · simp only [ctE]; rw [ev, cv_ctrl T hj]

theorem prod_cast_vol (ac : List (ℕ × ℕ)) :
    (ac.map fun p => (p.1 : ℤ)).prod = ((vol (ac.map Prod.fst) : ℕ) : ℤ) := by
  induction ac with
  | nil => simp [vol]
  | cons p ac ih => simp only [List.map_cons, List.prod_cons, ih, vol_cons]; push_cast; ring

theorem map_range_const {α : Type*} (a : ℕ) (x : α) :
    (List.range a).map (fun _ => x) = List.replicate a x := by
  simp [List.map_const']

end NLogN.KIL

end

