/-! ## Section 1: the codebook homomorphism `ZMod m → ℝ/δℤ` -/


variable (δ : ℝ) (m : ℕ)

theorem QuantizedWeightLattices.Modular.range_codeHom(hm : 0 < m) :
    Set.range (codeHom δ m hm) = {x : AddCircle δ | (m : ℕ) • x = 0} := by sorry
