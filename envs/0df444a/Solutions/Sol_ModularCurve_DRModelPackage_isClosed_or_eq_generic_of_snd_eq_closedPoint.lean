theorem Scheme.isClosed_singleton_of_specializes_of_ringKrullDim_le_two {X : Scheme.{u}}
    {w η y : X} (hwη : w ⤳ η) (hwη' : w ≠ η) (hηy : η ⤳ y) (hηy' : η ≠ y)
    (hdim : ∀ z : X, y ⤳ z → ringKrullDim (X.presheaf.stalk z) ≤ 2) :
    IsClosed ({y} : Set X) := by
  rw [← closure_subset_iff_isClosed]
  intro z hz
  have hyz : y ⤳ z := specializes_iff_mem_closure.mpr hz
  rw [Set.mem_singleton_iff]
  by_contra hne
  have hyz' : y ≠ z := fun h => hne h.symm

  have hrange : ∀ v : X, v ⤳ z → ∃ q : PrimeSpectrum (X.presheaf.stalk z),
      (X.fromSpecStalk z).base q = v := by
    intro v hv
    have : v ∈ Set.range (X.fromSpecStalk z).base := by
      rw [Scheme.range_fromSpecStalk]; exact hv
    exact this
  obtain ⟨qw, hqw⟩ := hrange w (hwη.trans (hηy.trans hyz))
  obtain ⟨qη, hqη⟩ := hrange η (hηy.trans hyz)
  obtain ⟨qy, hqy⟩ := hrange y hyz
  obtain ⟨qz, hqz⟩ := hrange z specializes_rfl
  have hemb := (X.fromSpecStalk z).isEmbedding
  have lt_of : ∀ {a b : PrimeSpectrum (X.presheaf.stalk z)},
      (X.fromSpecStalk z).base a ⤳ (X.fromSpecStalk z).base b →
      (X.fromSpecStalk z).base a ≠ (X.fromSpecStalk z).base b → a < b := by
    intro a b hs hne
    have hab : a ⤳ b := hemb.specializes_iff.mp hs
    exact lt_of_le_of_ne ((PrimeSpectrum.le_iff_specializes a b).mpr hab) (fun h => hne (h ▸ rfl))
  have h₁ : qw < qη := lt_of (by rw [hqw, hqη]; exact hwη) (by rw [hqw, hqη]; exact hwη')
  have h₂ : qη < qy := lt_of (by rw [hqη, hqy]; exact hηy) (by rw [hqη, hqy]; exact hηy')
  have h₃ : qy < qz := lt_of (by rw [hqy, hqz]; exact hyz) (by rw [hqy, hqz]; exact hyz')
  let s : LTSeries (PrimeSpectrum (X.presheaf.stalk z)) :=
    LTSeries.mk 3 ![qw, qη, qy, qz] (Fin.strictMono_iff_lt_succ.mpr (by
      intro i
      fin_cases i
      · exact h₁
      · exact h₂
      · exact h₃))
  have h3 : ((3 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (X.presheaf.stalk z) :=
    Order.LTSeries.length_le_krullDim s
  have h32 := h3.trans (hdim z hyz)
  have : ((3 : ℕ) : WithBot ℕ∞) ≤ ((2 : ℕ) : WithBot ℕ∞) := by simpa using h32
  have : (3 : ℕ) ≤ 2 := by exact_mod_cast this
  omega

