-- Source module: Solutions.KFUURot8
/-!
# KFUU §7h: the backward shifts, uniform

`rotsBU`: a register-counted loop (`oD = d` iterations) of `preB; rotCU true; postB`; it runs
KFU's inverse shifts of targets `0, …, d-1` (`rotsBU_runs`: the result is KFU's
`pull … (Gb sF (csB sF μ) d)`).  Registers before: `oI = 0`, `oPi = 1`,
`oBv = vol (shR d (sP d sF))`, `oSL = [s_0, …, s_{d-1}]`, `oML = [μ_0, …, μ_{d-1}]`; after:
`oI = d`, `oPi = P_d`, `oBv = 2`, `oSP = [s_{d-1}, …, s_0]` pushed, `oSL`, `oML` consumed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFC KFT AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- One backward step. -/
def bwB : IStmt HS Pp := .seq preB.code (.seq (NLogN.KFUU.rotCU true) postB.code)

/-- The backward shifts. -/
def rotsBU : IStmt HS Pp := rptX oD NLogN.KFUU.lA lC lD bwB

/-- The volume from target `k` on. -/
def BvB (d : ℕ) (sF : ℕ → ℕ) (k : ℕ) : ℕ := vol (((List.range d).drop k ++ [d]).map (KFU.sP d sF))

/-- The loop state after `k` backward steps. -/
def bwSt (d : ℕ) (sF μ : ℕ → ℕ) (t : IState HS) (R RSL RSP RML LI LP LB : List Item) (xs : List ℤ)
    (k : ℕ) : IState HS :=
  ((((((t.upd 0 (ints (pull (KFU.shR d (KFU.sP d sF)) (KFU.shR d (KFU.sP d sF))
    (KFU.Gb sF (KFU.csB sF μ) k) 0 xs) ++ R)).upd oI (.int k :: LI)).upd oPi
    (.int (Pv sF k) :: LP)).upd oBv (.int (BvB d sF k) :: LB)).upd oSL
    (ints (((List.range d).drop k).map fun j => (sF j : ℤ)) ++ RSL)).upd oSP
    (ints ((List.range k).map fun j => (sF j : ℤ)).reverse ++ RSP)).upd oML
    (ints (((List.range d).drop k).map fun j => (μ j : ℤ)) ++ RML)

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUSet1
/-!
# KFUU §8a: copying descriptor entries (register code)

* `mv2 A H X`: pop the top of `X` and push it on `A` and on `H`;
* `mvL2 C n A H X`: `n` of them (counter `C`); `mvL2_sp`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-- Copy the top of `X` to `A` and `H`, then pop it. -/
def mv2 (A H X : Fin HS) : RS := .seq (.push A (.reg X)) (.seq (.push H (.reg X)) (.pop X))

/-- `n` copies. -/
def mvL2 (C : Fin HS) (n : Ex HS) (A H X : Fin HS) : RS := .rep C n (NLogN.KFUU.mv2 A H X)

/-- The managed lists after `k` copies. -/
def mvF (F0 : Fin HS → List ℤ) (A H X : Fin HS) (L r : List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update F0 X (L.drop k ++ r))
    A ((L.take k).reverse ++ F0 A)) H ((L.take k).reverse ++ F0 H)

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUSet2
/-!
# KFUU §8b: reading the `Φ` descriptor — the first pieces

Stacks of the set-up: `dP = 44` (the `Φ` descriptor), `hD = 30` (the entries popped, for the
restoration), `xA, xB, bT` (copies), `cL` (loop counter).

* `setA_sp`: `w, h, d` into `rW, rU, oD`;
* `sLoop_sp`: the sizes `s_0, …, s_{d-1}` copied to `Ys`, `pSR`, `xA` (each `[s_{d-1}, …, s_0]`),
  their product into `oPi`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

abbrev dP : Fin HS := 44
abbrev hD : Fin HS := 30
abbrev xA : Fin HS := 31
abbrev xB : Fin HS := 33
abbrev bT : Fin HS := 11
abbrev cL : Fin HS := 10
abbrev pSK : Fin HS := 5
abbrev pTK : Fin HS := 6
abbrev pTR : Fin HS := 8
abbrev pSR : Fin HS := 43
/-- Backward temporaries. -/
abbrev xS : Fin HS := 45
abbrev xM : Fin HS := 9

/-- `w, h, d` into registers. -/
def setA : RS := .seq (NLogN.KFUU.mv2 rW NLogN.KFUU.hD dP) (.seq (NLogN.KFUU.mv2 NLogN.KFUU.rU NLogN.KFUU.hD dP) (NLogN.KFUU.mv2 oD NLogN.KFUU.hD dP))

/-- One step of the size loop. -/
def sB (Ys : Fin HS) : RS :=
  .seq (.push Ys (.reg dP)) (.seq (.push pSR (.reg dP))
    (.seq (.asg oPi (.mul (.reg oPi) (.reg dP))) (NLogN.KFUU.mv2 xA NLogN.KFUU.hD dP)))

/-- The size loop. -/
def sLoop (Ys : Fin HS) : RS := .rep NLogN.KFUU.cL (.reg oD) (NLogN.KFUU.sB Ys)

/-- The sizes `s_0, …, s_{k-1}` as integers. -/
def sZ (sF : ℕ → ℕ) (k : ℕ) : List ℤ := (List.range k).map fun j => (sF j : ℤ)

/-- The managed lists after `k` steps. -/
def sF_k (F0 : Fin HS → List ℤ) (Ys : Fin HS) (sF : ℕ → ℕ) (d : ℕ) (r : List ℤ) (k : ℕ) :
    Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update F0 dP ((sZ sF d).drop k ++ r)) Ys ((sZ sF k).reverse ++ F0 Ys))
    pSR ((sZ sF k).reverse ++ F0 pSR)) oPi [(Pv sF k : ℤ)]) xA ((sZ sF k).reverse ++ F0 xA))
    NLogN.KFUU.hD ((sZ sF k).reverse ++ F0 NLogN.KFUU.hD)

/-- The padded sizes `t_j = 2^h (1 + b_j)`. -/
def tE : Ex HS := .mul (.reg rU2) (.add (.lit 1) (.reg NLogN.KFUU.bT))

/-- One step of the padded-size loop (bits from `bT`, top `b_{d-1}`). -/
def tB : RS := .seq (.push pTK NLogN.KFUU.tE) (.seq (.push xB NLogN.KFUU.tE) (.pop NLogN.KFUU.bT))

def tLoop : RS := .rep NLogN.KFUU.cL (.reg oD) NLogN.KFUU.tB

/-- The padded sizes `t_0, …, t_{k-1}`. -/
def tZ (h : ℕ) (bL : ℕ → Bool) (k : ℕ) : List ℤ :=
  (List.range k).map fun j => ((2 ^ h * (if bL j then 2 else 1) : ℕ) : ℤ)

/-- The managed lists after `k` steps. -/
def tF_k (F0 : Fin HS → List ℤ) (h d : ℕ) (bL : ℕ → Bool) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update F0 NLogN.KFUU.bT ((KFM.bitsZ d bL).reverse.drop k))
    pTK (((tZ h bL d).reverse.take k).reverse ++ F0 pTK))
    xB (((tZ h bL d).reverse.take k).reverse ++ F0 xB)

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUSet3
/-!
# KFUU §8c: reading the `Φ` descriptor

`readD Ys Ym` (register code) reads `descPhi w h d bL sF μ` from `dP` and restores it:
`rW = w`, `rU = h`, `oD = d`, `oPi = P_d`; the bits reversed on `bT`; the sizes
`[s_{d-1}, …, s_0]` on `Ys`, `pSR`, `xA`; the multipliers `[μ_{d-1}, …, μ_0]` on `Ym`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-- `3 + 3 d`. -/
def n3d : Ex HS := .add (.add (.add (.lit 3) (.reg oD)) (.reg oD)) (.reg oD)

def readD (Ys Ym : Fin HS) : RS :=
  .seq setA (.seq (mvL2 NLogN.KFUU.cL (.reg oD) NLogN.KFUU.bT NLogN.KFUU.hD dP) (.seq (.push oPi (.lit 1)) (.seq (sLoop Ys)
    (.seq (mvL2 NLogN.KFUU.cL (.reg oD) Ym NLogN.KFUU.hD dP) (NLogN.mvK NLogN.KFUU.hD dP NLogN.KFUU.cL n3d)))))

/-- The multipliers as integers. -/
