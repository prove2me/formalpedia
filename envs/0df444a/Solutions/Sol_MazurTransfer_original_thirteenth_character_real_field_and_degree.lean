theorem character_kernel_iff (u : (ZMod 13)ˣ) :
    character u = 1 ↔ (u : ZMod 13) = 1 ∨ (u : ZMod 13) = -1 := by
  revert u
  decide

theorem conjugateCharacter_kernel_iff (u : (ZMod 13)ˣ) :
    conjugateCharacter u = 1 ↔ (u : ZMod 13) = 1 ∨ (u : ZMod 13) = -1 := by
  change (character u)⁻¹ = 1 ↔ _
  rw [inv_eq_one, character_kernel_iff]

variable {K : Type} [Field K] [CharZero K] [Normal ℚ K]
variable (z : K) (hz : IsPrimitiveRoot z 13)

include hz in
theorem pow_twelve_eq_inv : z ^ 12 = z⁻¹ := by
  have hz0 : z ≠ 0 := hz.ne_zero (by decide)
  apply mul_right_cancel₀ hz0
  rw [← pow_succ, hz.pow_eq_one, inv_mul_cancel₀ hz0]

theorem character_kernel_iff_root (σ : K ≃ₐ[ℚ] K) :
    (conjugateCharacter.comp (hz.autToPow ℚ)) σ = 1 ↔ σ z = z ∨ σ z = z⁻¹ := by
  rw [MonoidHom.comp_apply, conjugateCharacter_kernel_iff]
  constructor
  · rintro (h | h)
    · left
      have he := hz.autToPow_spec ℚ σ
      rw [h] at he
      change z ^ 1 = σ z at he
      simpa only [pow_one] using he.symm
    · right
      have he := hz.autToPow_spec ℚ σ
      rw [h] at he
      change z ^ 12 = σ z at he
      exact he.symm.trans (pow_twelve_eq_inv z hz)
  · rintro (h | h)
    · left
      have he := (MazurTransfer.thirteenth_root_galois_quotient_certificates).1 K z hz σ 1 (by change σ z = z ^ 1; simpa only [pow_one] using h)
      rw [he]
      rfl
    · right
      have he := (MazurTransfer.thirteenth_root_galois_quotient_certificates).1 K z hz σ (-1) (by change σ z = z ^ 12; exact h.trans (pow_twelve_eq_inv z hz).symm)
      rw [he]
      rfl



include hz in
theorem fixes_realGenerator_iff (σ : K ≃ₐ[ℚ] K) :
    σ (realGenerator z) = realGenerator z ↔ σ z = z ∨ σ z = z⁻¹ := by
  have hz0 : z ≠ 0 := hz.ne_zero (by decide)
  have hx0 : σ z ≠ 0 := (map_ne_zero σ).mpr hz0
  change σ (z + z⁻¹) = z + z⁻¹ ↔ _
  rw [map_add, map_inv₀]
  constructor
  · intro h
    have hi : (σ z - z) * (σ z - z⁻¹) =
        (σ z + (σ z)⁻¹ - (z + z⁻¹)) * σ z := by field_simp; ring
    rw [h, sub_self, zero_mul] at hi
    exact (mul_eq_zero.mp hi) |>.imp sub_eq_zero.mp sub_eq_zero.mp
  · rintro (h | h)
    · rw [h]
    · rw [h, inv_inv, add_comm]

theorem character_kernel_iff_fixes_realGenerator (σ : K ≃ₐ[ℚ] K) :
    (conjugateCharacter.comp (hz.autToPow ℚ)) σ = 1 ↔ σ (realGenerator z) = realGenerator z :=
  (character_kernel_iff_root z hz σ).trans (fixes_realGenerator_iff z hz σ).symm

local notation "F" => AlgebraicClosure ℚ




theorem realField_finiteDimensional (z : F) : FiniteDimensional ℚ (realField z) :=
  IntermediateField.adjoin.finiteDimensional ((Algebra.IsAlgebraic.isAlgebraic (R := ℚ) (realGenerator z)).isIntegral)

theorem mem_realField_fixingSubgroup_iff (z : F) (σ : F ≃ₐ[ℚ] F) :
    σ ∈ (realField z).fixingSubgroup ↔ σ (realGenerator z) = realGenerator z := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  change (∀ x ∈ IntermediateField.adjoin ℚ {realGenerator z}, σ • x = x) ↔ _
  rw [IntermediateField.forall_mem_adjoin_smul_eq_self_iff]
  simp only [Set.mem_singleton_iff, forall_eq]
  rfl

theorem realField_fixingSubgroup_eq_character_kernel (z : F) (hz : IsPrimitiveRoot z 13) :
    (realField z).fixingSubgroup = (conjugateCharacter.comp (hz.autToPow ℚ)).ker := by
  ext σ
  exact (mem_realField_fixingSubgroup_iff z σ).trans (character_kernel_iff_fixes_realGenerator z hz σ).symm

