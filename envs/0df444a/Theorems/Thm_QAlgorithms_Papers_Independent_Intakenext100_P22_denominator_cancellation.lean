-- title:
--   Cancellation of the denominator-generated linear term
-- statement:
--   Fix an integer $n\ge2$. For $0<x<1$, put
--   $$\beta_y(x)=\frac{{}_2F_1(y,1-y;1;1-x)}{{}_2F_1(y,1-y;1;x)},\qquad
--   \Gamma_{rs}(x)=\frac{2i}{n}\sum_{k=1}^{n-1}\sin(\pi k/n)\beta_{k/n}(x)\cos(2\pi k(r-s)/n),$$
--   where $r,s=1,\ldots,n-1$. Let $D_n(x)=\Theta(0\mid\Gamma(x))$, a positive real number, and $a_n=(n-1/n)/6$. With $n$ fixed and $x\to0^+$,
--   $$D_n(x)=1+\tfrac12a_nx+O(x^2),\qquad D_n(x)^2=1+a_nx+O(x^2),\qquad
--   \frac{(1-x)^{-a_n}}{D_n(x)^2}=1+O(x^2).$$
--   Thus the geometric factor cancels the linear term generated by this denominator. The common interval-length power has been factored out. This assertion places no restriction on possible order-$x$ terms generated by numerator sectors at special compactification radii.
--
--   **Formalization Note** $D_n$ is represented by the norm of the theta series, which equals its value on this pure imaginary period matrix. The error bounds use the right-hand neighborhood filter; their constants may depend on the fixed $n$.
-- source:
--   Entanglement entropy of two disjoint intervals in conformal field theory II, arXiv:1011.5482v1, PDF p. 16, §5.2, equations (68)–(71)

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P22

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakenext100.P22

open scoped BigOperators Topology

open Filter MeasureTheory

/-- PDF pp. 15–16, (68)–(71): denominator-generated linear term cancels
with the geometric prefactor after factoring out the common interval-length
power. No exclusion of resonant order-x numerator sectors is asserted.
The limit is from positive x with fixed integer n≥2. -/
theorem denominator_cancellation (n : ℕ) (hn : 2 ≤ n) :
    Asymptotics.IsBigO (𝓝[>] (0 : ℝ))
      (fun x => thetaDenominator n x - (1 + replicaWeight n / 2 * x))
      (fun x => x ^ 2) ∧
    Asymptotics.IsBigO (𝓝[>] (0 : ℝ))
      (fun x => thetaDenominator n x ^ 2 - (1 + replicaWeight n * x))
      (fun x => x ^ 2) ∧
    Asymptotics.IsBigO (𝓝[>] (0 : ℝ))
      (fun x => Real.rpow (1 - x) (-replicaWeight n) /
        thetaDenominator n x ^ 2 - 1) (fun x => x ^ 2) := by sorry

end QAlgorithms.Papers.Independent.Intakenext100.P22

end
