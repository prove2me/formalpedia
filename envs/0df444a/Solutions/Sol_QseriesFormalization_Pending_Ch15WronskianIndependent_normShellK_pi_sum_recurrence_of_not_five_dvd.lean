/-- If `5 ∤ a² + b²` then `5 ∤ a - 2b`, because
`a² + b² = (a - 2b)(a + 2b) + 5b²`.  Modulo `5` the four selector forms below are
`±(a - 2b)` and `±2(a - 2b)`, which run over all of `(ℤ/5)ˣ` once `a - 2b ≢ 0`; so this
reduces both selector lemmas to linear arithmetic (`omega`, one call per residue of
`a - 2b`). -/
theorem not_five_dvd_sub_two_mul_of_sq_add_sq (a b : ℤ)
    (h5 : (a ^ 2 + b ^ 2) % 5 ≠ 0) :
    ¬ (5 : ℤ) ∣ a - 2 * b := by
  rintro ⟨k, hk⟩
  apply h5
  have h : a ^ 2 + b ^ 2 = 5 * (k * (a + 2 * b) + b ^ 2) := by
    rw [show a ^ 2 + b ^ 2 = (a - 2 * b) * (a + 2 * b) + 5 * b ^ 2 by ring, hk]
    ring
  rw [h]
  exact Int.mul_emod_right 5 _

theorem pi5Selector_exists_int (a b : ℤ)
    (h5 : (a ^ 2 + b ^ 2) % 5 ≠ 0) :
    (-(a - 2 * b) - 3 * (2 * a + b)) % 5 = 2 ∨
      (-3 * (a - 2 * b) + (2 * a + b)) % 5 = 2 ∨
      ((a - 2 * b) + 3 * (2 * a + b)) % 5 = 2 ∨
      (3 * (a - 2 * b) - (2 * a + b)) % 5 = 2 := by
  have hx := not_five_dvd_sub_two_mul_of_sq_add_sq a b h5
  clear h5
  have hr : (a - 2 * b) % 5 = 1 ∨ (a - 2 * b) % 5 = 2 ∨
      (a - 2 * b) % 5 = 3 ∨ (a - 2 * b) % 5 = 4 := by omega
  clear hx
  -- the forms are `3x, -x, 2x, x` mod 5 with `x = a - 2b`
  rcases hr with hr | hr | hr | hr
  · exact Or.inr (Or.inr (Or.inl (by omega)))
  · exact Or.inr (Or.inr (Or.inr (by omega)))
  · exact Or.inr (Or.inl (by omega))
  · exact Or.inl (by omega)

theorem wronskianCore_pi5_conj_pair_of_norm_odd {a b : ℤ}
    (hodd : (a ^ 2 + b ^ 2) % 2 = 1) :
