section RealPlace

open NumberField.InfinitePlace.Completion

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

private def rhoW (θ : ℝ) : AdelicGL2 (𝓞 F) F := adelicArchGLInclAt F w (rotW hw θ)

private theorem rhoW_apply (θ : ℝ) : rhoW hw θ = adelicArchGLInclAt F w (rotW hw θ) := rfl

private theorem rhoW_mem (θ : ℝ) : rhoW hw θ ∈ archRowIsometrySubgroup F w := by
  show adelicArchGLInclAt F w (rotW hw θ) ∈ (rowIsometrySubgroup w.Completion).map (adelicArchGLInclAt F w)
  exact Subgroup.mem_map.2 ⟨rotW hw θ, rotW_mem_rowIsometrySubgroup hw θ, rfl⟩

private theorem rhoW_zero : rhoW hw 0 = 1 := by
  rw [rhoW_apply, rotW_zero, map_one]

private theorem rhoW_add (s t : ℝ) : rhoW hw (s + t) = rhoW hw s * rhoW hw t := by
  rw [rhoW_apply, rotW_add, map_mul]
  rfl

private theorem continuous_rhoW : Continuous (rhoW hw) :=
  (continuous_adelicArchGLInclAt F w).comp (continuous_rotW hw)

private theorem rhoW_periodic : Function.Periodic (rhoW hw) (2 * Real.pi) := fun θ => by
  rw [rhoW_apply, rhoW_apply, rotW_periodic hw θ]

private def realIdeleAt : ℝˣ →* (AdeleRing (𝓞 F) F)ˣ :=
  (archIdeleAt F w).comp (Units.map (ringEquivRealOfIsReal hw).symm.toRingHom.toMonoidHom)

private theorem realIdeleAt_apply (r : ℝˣ) :
    realIdeleAt hw r = archIdeleAt F w (Units.map (ringEquivRealOfIsReal hw).symm.toRingHom.toMonoidHom r) :=
  rfl

@[scoped simp] private theorem realIdeleAt_fst_self (r : ℝˣ) :
    ((realIdeleAt hw r : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 w
      = (ringEquivRealOfIsReal hw).symm r := by
  rw [realIdeleAt_apply, archIdeleAt_fst_self]
  rfl

private theorem realIdeleAt_fst_of_ne (r : ℝˣ) {v : InfinitePlace F} (hvw : v ≠ w) :
    ((realIdeleAt hw r : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 v = 1 := by
  rw [realIdeleAt_apply, archIdeleAt_fst_of_ne F w _ hvw]

@[scoped simp] private theorem realIdeleAt_snd (r : ℝˣ) :
    ((realIdeleAt hw r : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).2 = 1 := rfl

private theorem norm_realIdeleAt_fst_self (r : ℝˣ) :
    ‖((realIdeleAt hw r : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 w‖ = ‖(r : ℝ)‖ := by
  rw [realIdeleAt_fst_self, norm_ringEquiv_symm]

private theorem borelDiagFst_incl_ofRealGL_borelGL {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    borelDiagFst ⟨adelicArchGLInclAt F w (ofRealGL hw (RealIwasawa.borelGL hg u)),
        incl_mem_adelicBorel F w (ofRealGL_borelGL_mem hw hg u)⟩
      = realIdeleAt hw (borelFstUnit hg u) := by
  rw [borelDiagFst_incl F w (ofRealGL_borelGL_mem hw hg u), realIdeleAt_apply]
  congr 1
  apply Units.ext
  rw [borelDiagFst_apply_val, Units.coe_map]
  show ((ofRealGL hw (RealIwasawa.borelGL hg u) : GL (Fin 2) w.Completion) :
      Matrix (Fin 2) (Fin 2) w.Completion) 0 0 = _
  rw [ofRealGL_apply, RealIwasawa.coe_borelGL, RealIwasawa.borel_apply_00]
  rfl

private theorem borelDiagSnd_incl_ofRealGL_borelGL {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    borelDiagSnd ⟨adelicArchGLInclAt F w (ofRealGL hw (RealIwasawa.borelGL hg u)),
        incl_mem_adelicBorel F w (ofRealGL_borelGL_mem hw hg u)⟩
      = realIdeleAt hw (borelSndUnit hg u) := by
  rw [borelDiagSnd_incl F w (ofRealGL_borelGL_mem hw hg u), realIdeleAt_apply]
  congr 1
  apply Units.ext
  rw [borelDiagSnd_apply_val, Units.coe_map]
  show ((ofRealGL hw (RealIwasawa.borelGL hg u) : GL (Fin 2) w.Completion) :
      Matrix (Fin 2) (Fin 2) w.Completion) 1 1 = _
  rw [ofRealGL_apply, RealIwasawa.coe_borelGL, RealIwasawa.borel_apply_11]
  rfl

private theorem archComponent_weyl_unipotent (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) :
    archComponent F w (glArch (𝓞 F) F (adelicWeyl (𝓞 F) F * unipotentGL2 a * x))
      = ofRealGL hw (RealIwasawa.borelGL
            (det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x)))
            (ringEquivRealOfIsReal hw (a.1 w)))
        * rotW hw (RealIwasawa.angle
            ((toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) : Matrix (Fin 2) (Fin 2) ℝ)
            (ringEquivRealOfIsReal hw (a.1 w))) := by
  have e1 : (gl2Weyl : GL (Fin 2) ℝ) = RealIwasawa.weylR := Units.ext rfl
  have e2 : ∀ u : ℝ, (unipotentGL2 u : GL (Fin 2) ℝ) = RealIwasawa.unipR u := fun u => Units.ext rfl
  have key : toRealGL hw (archComponent F w (glArch (𝓞 F) F (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)))
      = RealIwasawa.borelGL (det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x)))
          (ringEquivRealOfIsReal hw (a.1 w))
        * RealIwasawa.rotGL (RealIwasawa.angle
          ((toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) : Matrix (Fin 2) (Fin 2) ℝ)
          (ringEquivRealOfIsReal hw (a.1 w))) := by
    simp only [map_mul, archComponent_adelicWeyl, archComponent_unipotentGL2, toRealGL_gl2Weyl,
      toRealGL_unipotentGL2, e1, e2]
    exact RealIwasawa.weylR_mul_unipR_mul_eq _ _
  have h := congrArg (ofRealGL hw) key
  rw [ofRealGL_toRealGL, map_mul (ofRealGL hw)] at h
  exact h

private theorem weyl_unipotent_eq_incl_mul (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) :
    adelicWeyl (𝓞 F) F * unipotentGL2 a * x
      = adelicArchGLInclAt F w (ofRealGL hw (RealIwasawa.borelGL
            (det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x)))
            (ringEquivRealOfIsReal hw (a.1 w))))
        * (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
            * rhoW hw (RealIwasawa.angle
                ((toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) : Matrix (Fin 2) (Fin 2) ℝ)
                (ringEquivRealOfIsReal hw (a.1 w)))) := by
  conv_lhs => rw [← incl_mul_awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)]
  rw [archComponent_weyl_unipotent hw, map_mul, mul_assoc, incl_mul_awayFrom_comm, rhoW_apply]

private theorem inducedSection_weyl_unipotent {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ)
    (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) :
    φ (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = ((χ₁ (realIdeleAt hw (borelFstUnit
            (det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x)))
            (ringEquivRealOfIsReal hw (a.1 w)))) : ℂˣ) : ℂ)
        * ((χ₂ (realIdeleAt hw (borelSndUnit
            (det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x)))
            (ringEquivRealOfIsReal hw (a.1 w)))) : ℂˣ) : ℂ)
        * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
            * rhoW hw (RealIwasawa.angle
                ((toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) : Matrix (Fin 2) (Fin 2) ℝ)
                (ringEquivRealOfIsReal hw (a.1 w)))) := by
  have hg := det_toRealGL_ne_zero hw (archComponent F w (glArch (𝓞 F) F x))
  conv_lhs => rw [weyl_unipotent_eq_incl_mul hw x a]
  rw [hφ _ (incl_mem_adelicBorel F w
      (ofRealGL_borelGL_mem hw hg (ringEquivRealOfIsReal hw (a.1 w)))) _,
    borelDiagFst_incl_ofRealGL_borelGL hw hg, borelDiagSnd_incl_ofRealGL_borelGL hw hg]

end RealPlace
