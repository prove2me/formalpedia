theorem ModularCurve.adjoin_jqModC_eq_top (k₀ : Type*) [Field k₀] :
    IntermediateField.adjoin k₀
      ({⟨jqModC k₀, jqModC_mem_full k₀ 1⟩} : Set ↥(modularFunctionFieldFullC k₀ 1)) = ⊤ := by sorry
