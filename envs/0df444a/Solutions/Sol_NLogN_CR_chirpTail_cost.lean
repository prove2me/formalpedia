theorem curF_bnd (B : ℕ) : ∀ (Z : List (List ℤ)) (cur : ℤ × ℤ), (∀ r ∈ Z, Bnd B r) →
    zsz cur.1 ≤ B → zsz cur.2 ≤ B → zsz (curF cur Z).1 ≤ B ∧ zsz (curF cur Z).2 ≤ B
