section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox PaperBox.Bounds Set
noncomputable section

def secondRectTest (b : Box 3) : Bool := secondAccept (b 0) (b 1) (b 2)

theorem second_cover_sound (tree : Cover 3) (b c d : Bounds) (ok : tree.verify secondRectTest ![b,c,d]=true)
    (p q z : ℝ) (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z) (hpz : p ≤ z)
    (base : secondResidual p q 1 ≤ 0) : secondResidual p q z ≤ 0 := by
  have h := cover_sound (P:=fun x => x 0 ≤ x 2 → secondResidual (x 0) (x 1) 1 ≤ 0 → secondResidual (x 0) (x 1) (x 2) ≤ 0)
    (ok:=secondRectTest) (fun _ yes _ hx order ending => secondAccept_sound (hx 0) (hx 1) (hx 2) order ending yes) tree ![b,c,d] ok
  exact h ![p,q,z] (by intro i; fin_cases i <;> first | exact hp | exact hq | exact hz) hpz base

private theorem dom_args {p q z : ℝ} (hp : p∈Icc (16/25:ℝ) (99/100)) (hq : q∈Icc (0:ℝ) lam)
    (hz : z∈Icc p 1) : p∈Icc 0 1 ∧ q∈Icc 0 1 ∧ z∈Icc 0 1 ∧ z-p+q∈Icc 0 1 ∧ lam<z := by
  have hd : lam=(703/1250:ℝ) := by norm_num [lam,lamQ]
  exact ⟨⟨by linarith only [hp.1],by linarith only [hp.2]⟩,⟨hq.1,by linarith only [hq.2,hd]⟩,
    ⟨by linarith only [hp.1,hz.1],hz.2⟩,⟨by linarith only [hz.1,hq.1],by linarith only [hp.1,hq.2,hz.2,hd]⟩,
    by linarith only [hp.1,hz.1,hd]⟩

private theorem jp_pos {p : ℝ} (hp : p∈Icc (16/25:ℝ) (99/100)) : 0<J score p := by
  have hd : lam=(703/1250:ℝ) := by norm_num [lam,lamQ]
  have hp0 : 0 ≤ p := by linarith only [hp.1]
  have hp1 : p<1 := by linarith only [hp.2]
  have hn := score_isScoreFunction.le_lam_sub p ⟨hp0,hp1.le⟩
  have hnegative : score p < 0 := by linarith only [hp.1,hn,hd]
  have hh := (primitive_sandwich score_isScoreFunction hp0 hp1.le le_rfl).2
  rw [show J score 1=0 from score_isScoreFunction.integral_eq_zero] at hh
  linarith only [hh,mul_neg_of_pos_of_neg (sub_pos.mpr hp1) hnegative]

private theorem E_cast : (massE:ℝ)=1+PaperMiddle.eps := by norm_num [massE,PaperMiddle.eps]

theorem second_at_one {p q : ℝ} (hp : p∈Icc (16/25:ℝ) (99/100)) (hq : q∈Icc (0:ℝ) lam)
    (h : q+PaperMiddle.canonical score p*deltaP score p q ≤ lam) : secondResidual p q 1 ≤ 0 := by
  have hp1 : p ≤ 1 := by linarith only [hp.2]
  obtain ⟨pd,qd,zd,xd,_⟩ := dom_args hp hq (z:=1) ⟨hp1,le_rfl⟩
  have hpos := jp_pos hp
  have hh := mul_le_mul_of_nonneg_right h hpos.le
  have βJ : PaperMiddle.canonical score p*J score p=(massE:ℝ)*p := by
    unfold PaperMiddle.canonical
    rw [E_cast];field_simp
  simp only [secondResidual,totalScore,totalPrimitive,clamp_eq zd,clamp_eq pd,clamp_eq qd,clamp_eq xd,
    score_isScoreFunction.at_one,show J score 1=0 from score_isScoreFunction.integral_eq_zero]
  unfold deltaP at hh
  nlinarith only [hh,congrArg (fun t => t*(J score (1-p+q)-J score q)) βJ]

theorem highSecond_of_residual {p q z : ℝ} (hp : p∈Icc (16/25:ℝ) (99/100))
    (hq : q∈Icc (0:ℝ) lam) (hz : z∈Icc p 1) (h : secondResidual p q z ≤ 0) :
    highSecond lam score (PaperMiddle.canonical score p) 1 (-(PaperMiddle.canonical score p*(1-p))) p q z 1 ≤ 0 := by
  obtain ⟨pd,qd,zd,xd,hL⟩ := dom_args hp hq hz
  have hpos := jp_pos hp
  have βJ : PaperMiddle.canonical score p*J score p=(massE:ℝ)*p := by
    unfold PaperMiddle.canonical
    rw [E_cast];field_simp
  simp only [secondResidual,totalScore,totalPrimitive,clamp_eq zd,clamp_eq pd,clamp_eq qd,clamp_eq xd] at h
  have hcore : q+PaperMiddle.canonical score p*KP score p q z-(lam-z-score z) ≤ 0 := by
    apply le_of_mul_le_mul_right _ hpos
    simp only [zero_mul]
    unfold KP
    nlinarith only [h,congrArg (fun t => t*(J score (z-p+q)-J score z-J score q)) βJ]
  have loss := mul_nonneg (le_max_right (-score z) 0) (le_max_right (1*1 + -(PaperMiddle.canonical score p*(1-p))) 0)
  simp only [highSecond,potential,if_pos hq.2,if_neg (not_le.mpr hL),one_mul,add_zero] at loss ⊢
  linarith only [hcore,loss]

end
end StableVotingDistortion.PaperCurve
end

