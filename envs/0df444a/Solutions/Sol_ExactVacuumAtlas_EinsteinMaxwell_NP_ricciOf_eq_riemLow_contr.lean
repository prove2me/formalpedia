open scoped ContDiff
open Matrix
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {U : Set (Pt n)}
theorem solution (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (b d : Fin n) :
    ricciOf g gi b d y = ∑ a, ∑ c, gi a c y * riemLow g gi a b c d y := by
  rw [ricciOf_eq_riem_contr hm hy]
  simp only [riemLow, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Finset.sum_comm]
  have h : ∀ e, ∑ a, gi a c y * (g a e y * riem g gi e b c d y)
      = (1 : Matrix (Fin n) (Fin n) ℝ) c e * riem g gi e b c d y := by
    intro e
    rw [← gi_g_apply hm hy c e, Finset.sum_mul]
    exact Finset.sum_congr rfl fun a _ => by rw [gi_symm hm hy a c]; ring
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
