lemma Step.rev_WF {s : AModel.Step n Q} (hs : s.WF) : s.rev.WF := by
  cases s with
  | shift i u c =>
    refine ⟨⟨⟨u⁻¹, u, ZMod.inv_mul_of_unit _ hs.1, ZMod.mul_inv_of_unit _ hs.1⟩, rfl⟩,
      fun j hj => ?_⟩
    simp [hs.2 j hj]
  | swap i j => trivial

lemma revSteps_WF {l : List (AModel.Step n Q)} (hl : ∀ s ∈ l, s.WF) : ∀ s ∈ revSteps l, s.WF := by
  intro s hs
  simp only [revSteps, List.mem_reverse, List.mem_map] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  exact Step.rev_WF (hl t ht)

lemma countP_revSteps (l : List (AModel.Step n Q)) :
    (revSteps l).countP Step.isSwap = l.countP Step.isSwap := by
