theorem ModularCurve.xHFunctionFieldBar_div_sup_adjoin_qExpand_jqModC_eq_xHFunctionFieldBar
    (p M : ℕ) [Fact p.Prime] [NeZero M] (H : Subgroup (ZMod M)ˣ) (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H) :
    haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
    xHFunctionFieldBar (M / p) (infSubgroup p M H hpM) ⊔
        IntermediateField.adjoin (AlgebraicClosure ℚ)
          {qExpand (AlgebraicClosure ℚ) p (jqModC (AlgebraicClosure ℚ))} =
      xHFunctionFieldBar M H := by sorry
