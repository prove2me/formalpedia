    fun k hk => gam_le hs hst hα hP hPl hk, fun k hk => (H k hk).2.1,
    fun c k hk => ((H k hk).2.2.2.2 c).1, fun c k hk => ((H k hk).2.2.2.2 c).2⟩

/-- **`TabB` on every round-six axis**, at `A = Q + R + 2`. -/
theorem tabB6_all (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
