/-- **The pruned encoder, for the array b.** -/
theorem encodePR_entry (std : Std lim) (hS : P[pEncStep]? = some encStepBody)
    (hE : P[pEncodeP]? = some (encodePBody pEncStep pEncodeP)) : EncodePRSpec lim P cEncodeP := by
