import Definitions.Def_MazurTransfer_Order13ActualConicFunctionParameterData
import Theorems.Thm_MazurTransfer_Order13ActualFunctionFieldGenerators_intermediateField_eq_top

noncomputable section
namespace MazurTransfer.Order13ActualConicFieldCubicExtension
open Polynomial
open GoodCharacteristicGeometryPublicProof.MazurTransfer.Order13GoodCharacteristicCurveModel
open Order13PellActualOrdinaryChart Order13ActualConicFunctionParameter
open Order13ActualDiamondQuotientFunctions RationalConicFunctionParameter
open Order13ActualFunctionFieldGenerators
local instance : Fact ((104 : ℚ) ≠ 0) := ⟨by norm_num⟩

def conicField : IntermediateField ℚ (actualCurveFunctionField ℚ) :=
  IntermediateField.adjoin ℚ {t}

theorem parameter_mem : t ∈ conicField := IntermediateField.subset_adjoin ℚ _ (by simp)

theorem u_mem_of_parameter_mem (S : IntermediateField ℚ (actualCurveFunctionField ℚ))
    (ht : t ∈ S) : u ∈ S := by
  rw [← u_parameter]
  exact S.div_mem
    (S.sub_mem (S.add_mem (pow_mem ht 2) (S.mul_mem (S.natCast_mem 4) ht)) S.one_mem)
    (S.sub_mem S.one_mem (pow_mem ht 2))

theorem v_mem_of_parameter_mem (S : IntermediateField ℚ (actualCurveFunctionField ℚ))
    (ht : t ∈ S) : v ∈ S := by
  rw [← v_parameter]
  exact S.div_mem (S.mul_mem (S.natCast_mem 2) (S.add_mem S.one_mem (pow_mem ht 2)))
    (S.sub_mem S.one_mem (pow_mem ht 2))

theorem u_mem : u ∈ conicField := u_mem_of_parameter_mem _ parameter_mem
theorem v_mem : v ∈ conicField := v_mem_of_parameter_mem _ parameter_mem

theorem conic_coordinates_generate_parameter_field :
    IntermediateField.adjoin ℚ {u, v} = conicField := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact u_mem
    · exact Set.mem_singleton_iff.mp hz ▸ v_mem
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rcases Set.mem_singleton_iff.mp hz with rfl
    let S := IntermediateField.adjoin ℚ {u, v}
    have hu : u ∈ S := IntermediateField.subset_adjoin ℚ _ (by simp)
    have hv : v ∈ S := IntermediateField.subset_adjoin ℚ _ (by simp)
    exact S.div_mem (S.sub_mem hv (S.natCast_mem 2)) (S.add_mem hu S.one_mem)

theorem x_generates : IntermediateField.adjoin conicField {xImage ℚ} = ⊤ := by
  apply IntermediateField.restrictScalars_injective ℚ
  rw [IntermediateField.restrictScalars_top]
  apply intermediateField_eq_top
  · exact IntermediateField.subset_adjoin conicField _ (by simp)
  · let S := IntermediateField.adjoin conicField {xImage ℚ}
    have hx : xImage ℚ ∈ S := IntermediateField.subset_adjoin conicField _ (by simp)
    have hv : v ∈ S := S.algebraMap_mem ⟨v, v_mem⟩
    rw [y_recovered]
    exact S.mul_mem hv (S.mul_mem hx (S.add_mem hx S.one_mem))

def cubic : Polynomial conicField :=
  X ^ 3 - C ⟨u, u_mem⟩ * X ^ 2 - C (⟨u, u_mem⟩ + 3) * X - 1

theorem cubic_monic : cubic.Monic := by
  unfold cubic
  monicity!

theorem cubic_degree : cubic.natDegree = 3 := by
  unfold cubic
  compute_degree!

theorem cubic_root : aeval (xImage ℚ) cubic = 0 := by
  simp only [cubic, map_sub, map_mul, map_pow, map_one, aeval_X, aeval_C]
  change xImage ℚ ^ 3 - u * xImage ℚ ^ 2 - (u + 3) * xImage ℚ - 1 = 0
  exact cubic_equation

theorem x_integral : IsIntegral conicField (xImage ℚ) := ⟨cubic, cubic_monic, cubic_root⟩

theorem curveField_finite : FiniteDimensional conicField (actualCurveFunctionField ℚ) := by
  have := IntermediateField.adjoin.finiteDimensional x_integral
  rw [x_generates] at this
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

theorem curveField_degree_le_three : Module.finrank conicField (actualCurveFunctionField ℚ) ≤ 3 := by
  have H := Polynomial.natDegree_le_natDegree (minpoly.min conicField (xImage ℚ) cubic_monic cubic_root)
  rw [cubic_degree] at H
  rw [← IntermediateField.finrank_top', ← x_generates, IntermediateField.adjoin.finrank x_integral]
  exact H

end MazurTransfer.Order13ActualConicFieldCubicExtension
