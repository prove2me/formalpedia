open ModularCurve AlgebraicCurve

theorem ModularCurve.natCard_closure_inertia_smul_sub_torsionBy_eq_pow_card_ssPlaces
    (M q' : ℕ) [NeZero M] (hq' : q'.Prime) (hq'M : ¬ q' ∣ M)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q')
    [DecidableEq (IsLocalRing.ResidueField A)]
    [Fintype ↥(ssPlaces q' M (IsLocalRing.ResidueField A))]
    [NeZero (M * q')]
    (m : ℕ) (hm : 0 < m) (hmq' : m.Coprime q') :
    let 𝒯ℤ : AddSubgroup (JZero (M * q')) := AddSubgroup.closure
      {y : JZero (M * q') | ∃ σ ∈ A.inertiaSubgroupIn ℚ, ∃ x : JZero (M * q'),
        (∃ n : ℕ, 0 < n ∧ n.Coprime q' ∧ n • x = 0) ∧ y = σ • x - x}
    Finite {y : ↥𝒯ℤ // m • (y : JZero (M * q')) = 0} ∧
      Nat.card {y : ↥𝒯ℤ // m • (y : JZero (M * q')) = 0}
        = m ^ (Fintype.card ↥(ssPlaces q' M (IsLocalRing.ResidueField A)) - 1) := by sorry
