section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFY
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
variable {M : MulSpec} {Ctx : IState HS → Prop}
set_option maxHeartbeats 4000000
theorem solution {Pre : List (ℤ × ℤ) → Prop} {f : List (ℤ × ℤ) → List (ℤ × ℤ)} {C : ℕ}
    (sl : NLogN.GL.LProg M Ctx Pre f C) (K rS rT : Fin NLogN.HS) (s t Q : ℕ) (hst : s ≤ t)
    (hOK : sl.O ≠ K) (hK56 : K.val < 56) (hS56 : rS.val < 56) (hT56 : rT.val < 56)
    (hQ : NLogN.zsz ((2 * t : ℕ) : ℤ) ≤ Q) (hstab : NLogN.GL.Stab Ctx [sl.O])
    (hCS : ∀ st, Ctx st → ∃ L, st.G rS = .int (s : ℤ) :: L)
    (hCT : ∀ st, Ctx st → ∃ L, st.G rT = .int (t : ℤ) :: L)
    (st : NLogN.IState NLogN.HS) (x : List (ℤ × ℤ)) (R : List NLogN.Item) (hC : Ctx st)
    (hx : Pre x) (hI : st.G sl.I = NLogN.gints x ++ R) :
    (NLogN.KFY.padOutP sl.O K rS rT sl.p).run st =
        (st.upd sl.I R).upd sl.O (NLogN.gints (f x ++ List.replicate (t - s) (0, 0)) ++ st.G sl.O) ∧
      (NLogN.KFY.padOutP sl.O K rS rT sl.p).ok M st ∧
      (NLogN.KFY.padOutP sl.O K rS rT sl.p).cost M st ≤ C + 100000 * (t + 1) * (Q + 2) := by
  obtain ⟨LS, eS⟩ := hCS st hC
  obtain ⟨LT, eT⟩ := hCT st hC
  obtain ⟨d1, d2, d3, d4, d5, d6⟩ := NLogN.KFY.cdE_facts rT rS hT56 hS56 st s t Q LT LS hst eT eS hQ
  obtain ⟨a2, a1⟩ := NLogN.KFY.pushZ_spec hOK (by have := sl.hO; omega) hK56 (NLogN.KFY.cdE rT rS) d2 st
    (2 * (t - s)) d3 d1
  have a3 := NLogN.KFY.pushZ_cost hOK (NLogN.KFY.cdE rT rS) st (2 * (t - s)) d1 Q d4 d5
  set s1 := st.upd sl.O (NLogN.ints (List.replicate (2 * (t - s)) 0) ++ st.G sl.O) with hs1
  have hIO := sl.hIO
  have hC1 : Ctx s1 := hstab st s1 hC (by
    intro j hj
    simp only [List.mem_singleton] at hj
    simp [hs1, hj])
  have hI1 : s1.G sl.I = NLogN.gints x ++ R := by simp [hs1, hIO, hI]
  have g1 := sl.run s1 x R hC1 hx hI1
  have g2 := sl.ok s1 x R hC1 hx hI1
  have g3 := sl.cost s1 x R hC1 hx hI1
  refine ⟨?_, ⟨a2, ?_⟩, ?_⟩
  · show sl.p.run ((NLogN.RM.rs _).run st) = _
    rw [NLogN.RM.run_rs, a1, g1]
    apply NLogN.IState.ext' _ (by simp [hs1]) (by simp [hs1])
    intro j
    by_cases j1 : j = sl.O
    · subst j1; simp [hs1, Ne.symm hIO, NLogN.GL.gints_append, NLogN.KFY.gints_zeros]
    by_cases j2 : j = sl.I
    · subst j2; simp [hs1, hIO]
    simp [hs1, j1, j2]
  · show sl.p.ok M ((NLogN.RM.rs _).run st); rw [NLogN.RM.run_rs, a1]; exact g2
  · show (NLogN.RM.rs _).cost M st + sl.p.cost M ((NLogN.RM.rs _).run st) ≤ _
    rw [NLogN.RM.run_rs, a1, NLogN.RM.cost_rs]
    rw [d6] at a3
    have h1 : 2 * (t - s) * (200 + 8000 * (Q + 2) + 30) ≤ 2 * t * (200 + 8000 * (Q + 2) + 30) :=
      Nat.mul_le_mul_right _ (by omega)
    nlinarith
end
