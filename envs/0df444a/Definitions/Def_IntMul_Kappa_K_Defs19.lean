-- Source module: Solutions.KFNSel
/-!
# KFN: selected-bit operators by record strides

A selected-bit operator on a record array only needs, for every selected bit `i`, its record
stride `st i`: bit `i` of record `j` is `j / st i % 2` (`fbit`), and setting the selected bits to
`y` moves to record `fset st j y = j + Σ_i (y_i - bit_i) st_i`.  `selOpF st n T xs` is the
selected-bit operator in these terms.

* `SLaws st n`: the strides are those of a genuine selected-bit structure on `n` records
  (`fset` stays below `n` and reads back `y`).
* `selOpF_mul`, `selOpF_one`, `selOpF_diagonal`: the operator calculus.
* `StrideSel Sb st`: a `SelBits` structure whose bits/sets are given by the strides;
  `selOp_eq_selOpF` and `slaws_of_strideSel`.
* `strideSel_layer`: the layer layout `[P] × [2^K]^D × [S]` has strides `stT K D S ρ i`
  (independent of `P`).
* `subOp g T` (`T` on the bits `g κ`, identity elsewhere) and **`selOpF_subOp`**:
  `selOpF st n (subOp g T) = selOpF (st ∘ g) n T`.  This one lemma gives reindexing
  (`g` an equivalence, `subOp_tens`), the child slots (`slotOp_eq_subOp`) and the pieces
  (`embed_eq_subOp`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open AModel Matrix Finset

section Basic

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Bit `i` of record `j`. -/
def fbit (st : ι → ℕ) (j : ℕ) : ι → Fin 2 := fun i => ⟨j / st i % 2, Nat.mod_lt _ (by norm_num)⟩

/-- The record with the selected bits set to `y`, as an integer. -/
def fsetZ (st : ι → ℕ) (j : ℕ) (y : ι → Fin 2) : ℤ :=
  (j : ℤ) + ∑ i, (((y i : ℕ) : ℤ) - ((fbit st j i : ℕ) : ℤ)) * (st i : ℤ)

/-- The record with the selected bits set to `y`. -/
def fset (st : ι → ℕ) (j : ℕ) (y : ι → Fin 2) : ℕ := (fsetZ st j y).toNat

/-- The strides describe a selected-bit structure on `n` records. -/
structure SLaws (st : ι → ℕ) (n : ℕ) : Prop where
  nonneg : ∀ j < n, ∀ y, 0 ≤ fsetZ st j y
  lt : ∀ j < n, ∀ y, fset st j y < n
  bit_set : ∀ j < n, ∀ y, fbit st (fset st j y) = y

variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

/-- The selected-bit operator `T` on `n` records with strides `st`. -/
noncomputable def selOpF (st : ι → ℕ) (n : ℕ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    (xs : List M) : List M :=
  (List.range n).map fun j => ∑ y, T (fbit st j) y • xs.getD (fset st j y) 0

end Basic

/-! ## The bridge to `SelBits` -/

section Bridge

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- A `SelBits` structure described by record strides. -/
def StrideSel (Sb : Butterfly.SelBits sh ι) (st : ι → ℕ) : Prop :=
  ∀ j < vol sh, Sb.bits (decode sh j) = fbit st j ∧
    ∀ y, ((encode sh (Sb.set (decode sh j) y) : ℕ) : ℤ) = fsetZ st j y

variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

end Bridge

/-! ## The layer layout -/

section Layer

variable {P K D S ρ : ℕ}

end Layer

/-! ## Operators on a subfamily of the selected bits -/

section Sub

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- `T` on the selected bits `g κ`, identity on the others. -/
def subOp (g : κ → ι) (T : Matrix (κ → Fin 2) (κ → Fin 2) ℂ) : Matrix (ι → Fin 2) (ι → Fin 2) ℂ :=
  fun x y => if ∀ i, (∀ k, g k ≠ i) → x i = y i then T (x ∘ g) (y ∘ g) else 0

/-- Extension of bits on `g κ` by the bits of `x` elsewhere. -/
noncomputable def extB (g : κ → ι) (x : ι → Fin 2) (z : κ → Fin 2) : ι → Fin 2 := by
  classical
  exact fun i => if h : ∃ k, g k = i then z (Classical.choose h) else x i

variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

end Sub

/-! ## Slots and pieces as subfamilies -/

end NLogN.KFN

