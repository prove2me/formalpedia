-- title:
--   Stembridge's theorem (§2.2) — the power sums $p_k$ generate the supersymmetric polynomials
-- statement:
--   Let $S_{r,s}[x;y]\subseteq\mathbb C[x_1,\dots,x_r,y_1,\dots,y_s]$ be the set of supersymmetric polynomials, and let $p_k=x_1^k+\dots+x_r^k+(-1)^{k+1}(y_1^k+\dots+y_s^k)$ for $k\ge0$. Then a polynomial $p$ is supersymmetric if and only if it lies in the $\mathbb C$-subalgebra generated by the power sums:
--
--   $$
--   S_{r,s}[x;y]=\mathbb C[p_0,p_1,p_2,\dots].
--   $$
--
--   The inclusion $\supseteq$ is the remark "it is easy to see that $p_k$ belongs to $S_{r,s}[x;y]$" (p. 11); the inclusion $\subseteq$ is Stembridge's theorem, which Jung and Kim cite and use to pass from power sums to all supersymmetric polynomials (Corollaries 2.9 and 3.3).
--
--   **Formalization Note** Polynomials are `MvPolynomial (Fin r ⊕ Fin s) ℂ`; "generated" is `Algebra.adjoin ℂ` of the range of `powerSum`. For $r=0$ or $s=0$ the cancellation condition is vacuous and the statement is the classical fact that power sums generate the symmetric polynomials over $\mathbb C$.
-- source:
--   Jung–Kim, Supersymmetric polynomials and the center of the walled Brauer algebra, arXiv:1508.06469v2, p. 11, §2.2 (citing Stembridge [36])

import Mathlib
import Definitions.Def_WalledBrauer_Center_Setting

namespace WalledBrauer.Center
open WalledBrauer.Blocks MvPolynomial

theorem stembridge_power_sums_generate (r s : ℕ) (p : MvPolynomial (Fin r ⊕ Fin s) ℂ) :
    IsSupersymmetric p ↔ p ∈ Algebra.adjoin ℂ (Set.range (powerSum (r := r) (s := s))) := by sorry
end WalledBrauer.Center
