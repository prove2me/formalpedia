  have e : (Ex.reg (S := HS) cnt).eval s = n := by simp [Ex.eval, IState.top_eq hC]
  have hst : ∀ k, (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))).G t =
      .int ((2 ^ m : ℕ) : ℤ) :: Lt := fun k => by
