-- title:
--   Quantitative power representatives from a finite polynomial subalgebra
-- statement:
--   For arbitrary real monomial weights, suppose s>0, D≥0, finitely many polynomials f_j belong to I^s and have weighted support at most D, and the polynomial ring is finite over the complex algebra generated by them. Then every class modulo I^n has a representative of weighted support at most n(D/s)+B for one fixed B≥0 and every n≥0.

import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Ideal.Operations

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.power_representatives_of_finite_adjoin
    {v k : Nat} (w : Fin v → Real)
    (I : Ideal (MvPolynomial (Fin v) Complex))
    (s : Nat) (hs : 0 < s) (D : Real) (hD : 0 ≤ D)
    (f : Fin k → MvPolynomial (Fin v) Complex)
    (hmem : ∀ j, f j ∈ I ^ s)
    (hweight : ∀ j, ∀ a ∈ (f j).support,
      ∑ i, w i * (a i : Real) ≤ D)
    (hfinite : Module.Finite (Algebra.adjoin Complex (Set.range f))
      (MvPolynomial (Fin v) Complex)) :
    ∃ B : Real, 0 ≤ B ∧
      ∀ n : Nat, ∀ P : MvPolynomial (Fin v) Complex,
        ∃ Q : MvPolynomial (Fin v) Complex,
          P - Q ∈ I ^ n ∧
          ∀ a ∈ Q.support,
            ∑ i, w i * (a i : Real) ≤
              (n : Real) * (D / (s : Real)) + B := by sorry
