variable {V : Type u} [DecidableEq V] [Fintype V]

/-- Remove the negative support from a Cech basis face. The resulting face
lies in its actual link, in reduced degree q-|negativeSupport|-1. The same
formula covers degrees below the shift: both index types are then empty. -/
def hochsterLinkBasisEquiv (K : Complex V) (a : V → ℤ) (q : ℕ)
    (ha : positiveSupport a = ∅) :
    CechBasis K Finset.univ a q ≃
      ReducedFaceIndex (link K (negativeSupport a))
        ((q : ℤ) - ((negativeSupport a).card : ℤ) - 1) where
  toFun F := by
    have hsub := localizationCriterion_negativeSupport_subset K F.1 a F.2.2.2
    have hF : F.1 ∈ K.faces := by simpa only [ha, Finset.empty_union] using F.2.2.2.2
    have hlink : F.1 \ negativeSupport a ∈ (link K (negativeSupport a)).faces := by
      apply Finset.mem_filter.mpr
      refine ⟨K.down_closed hF Finset.sdiff_subset, ?_, ?_⟩
      · apply Finset.disjoint_left.mpr
        intro v hv hvσ
        exact (Finset.mem_sdiff.mp hv).2 hvσ
      · rw [Finset.sdiff_union_of_subset hsub]
        exact hF
    refine ⟨F.1 \ negativeSupport a, hlink, ?_⟩
    have hc := Finset.card_sdiff_add_card_eq_card hsub
    have hq := F.2.2.1
    omega
  invFun G := by
    have hG := Finset.mem_filter.mp G.property.1
    have hcard : (negativeSupport a ∪ G.1).card = q := by
      rw [Finset.card_union_of_disjoint hG.2.1.symm]
      have hc := G.property.2
      omega
    refine ⟨negativeSupport a ∪ G.1, Finset.subset_univ _, hcard, ?_⟩
    apply (localizationCriterion_iff_support K _ a).mpr
    refine ⟨Finset.subset_union_left, ?_⟩
    simpa only [ha, Finset.empty_union, Finset.union_comm] using hG.2.2
  left_inv F := by
    apply Subtype.ext
    change negativeSupport a ∪ (F.1 \ negativeSupport a) = F.1
    rw [Finset.union_comm, Finset.sdiff_union_of_subset
      (localizationCriterion_negativeSupport_subset K F.1 a F.2.2.2)]
  right_inv G := by
    apply Subtype.ext
    change (negativeSupport a ∪ G.1) \ negativeSupport a = G.1
    have hd := (Finset.mem_filter.mp G.property.1).2.1
    ext v
    simp only [Finset.mem_sdiff, Finset.mem_union]
    constructor
    · rintro ⟨hv | hv, hn⟩
      · exact False.elim (hn hv)
      · exact hv
    · intro hv
      exact ⟨Or.inr hv, (Finset.disjoint_left.mp hd) hv⟩





