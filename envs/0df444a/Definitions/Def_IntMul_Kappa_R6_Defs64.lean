section
-- Source module: Solutions.J6SegILSlab2
/-!
# B-line IL, B1 (streaming slab pass) §2: registers, lanes, the unit loops

**Register convention** (fixed stacks, all below `56`, none `0`; the caller's data elsewhere is
preserved, since every scratch stack is restored):

| stack | role |
|---|---|
| `rK1 = 41`, `rK2 = 42` | constants of the item programs (inputs, preserved) |
| `0` | lane 1 input (the stream; the rest `l` below it is kept), and the output |
| `rZ = 53` | lane 2 input (the second array of the zipped output pass) |
| `rT = 50`, `rT2 = 51` | lane temps (scratch) |
| `rC = 45` | the control list `flatC cs` (input, preserved) |
| `rCU = 47`, `rOP = 48`, `rARG = 49`, `rACC = 52` | scratch: used commands, current command, output |
| `rNB = 37`, `rNC = 38`, `rM = 39`, `rTOT = 40` | inputs (one value each, preserved): `pre`, `|cs|`, `m`, the output length |
| `43, 46, 54` | scratch of the item programs (§5) |
| `34, 35, 36` | the `rptX` counters (`lA lC lD`) |

`55` (`ARGM`) is the multiplication argument stack. A *lane layout* `lin inp tmp G` puts the
remaining input units `inp` and the moved units `tmp` on the lane stacks over the managed state
`G`; `LaneOK lin` says it leaves the skeleton registers alone. The unit programs (`rd`, `bk`, `dr`,
`it`) are abstract with their specifications (`RdOK`, `BkOK`, `DrOK`, `ItOK`).

Here: the managed-state op lemmas, `cf3_encK` (the `rptX` counters over a managed state), and the
loops over one slab: `dropL_runs` (drop `m` units), `zeroL_runs` (emit `m` zeros), `copyL_runs`
(move `m` units to the temps while emitting `g a u`), `backL_runs` (move them back).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)

abbrev rC : Fin HS := 45
abbrev rCU : Fin HS := 47
abbrev rOP : Fin HS := 48
abbrev rARG : Fin HS := 49
abbrev rT : Fin HS := 50
abbrev rT2 : Fin HS := 51
abbrev rACC : Fin HS := 52
abbrev rZ : Fin HS := 53
abbrev rNB : Fin HS := 37
abbrev rNC : Fin HS := 38
abbrev rM : Fin HS := 39
abbrev rTOT : Fin HS := 40
abbrev rK1 : Fin HS := 41
abbrev rK2 : Fin HS := 42

/-- The skeleton registers (never lane stacks). -/
def skel : List (Fin HS) := [rC, rCU, rOP, rARG, rACC, rNB, rNC, rM, rTOT, rK1, rK2, lA, lC, lD]

/-! ## Managed-state operations -/

/-! ## Lanes -/

section lanes
variable {U : Type*}

/-- The lane layout leaves the skeleton registers alone and is the identity when empty. -/
structure LaneOK (lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)) : Prop where
  rd : ∀ j ∈ skel, ∀ inp tmp G, lin inp tmp G j = G j
  up : ∀ j ∈ skel, ∀ inp tmp G v, lin inp tmp (update G j v) = update (lin inp tmp G) j v
  nil : ∀ G, lin [] [] G = G

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  (lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)) (OkU : U → Prop)

/-- Move one unit from the inputs to the temps. -/
def RdOK (rd : IStmt HS P) (c : ℕ) : Prop :=
  ∀ s G u inp tmp, OkU u →
    IRuns I iprog rd (encK s (lin (u :: inp) tmp G)) (encK s (lin inp (u :: tmp) G)) c

/-- Move one unit back from the temps to the inputs. -/
def BkOK (bk : IStmt HS P) (c : ℕ) : Prop :=
  ∀ s G u inp tmp, OkU u →
    IRuns I iprog bk (encK s (lin inp (u :: tmp) G)) (encK s (lin (u :: inp) tmp G)) c

/-- Drop one input unit. -/
def DrOK (dr : IStmt HS P) (c : ℕ) : Prop :=
  ∀ s G u inp tmp, OkU u →
    IRuns I iprog dr (encK s (lin (u :: inp) tmp G)) (encK s (lin inp tmp G)) c

/-- Emit `g a u` for the unit `u` on top of the temps (`a` on `rARG`; `KG`: the constants). -/
def ItOK (OkA : ℤ → Prop) (KG : (Fin HS → List ℤ) → Prop) (g : ℤ → U → ℤ) (it : IStmt HS P)
    (c : ℕ) : Prop :=
  ∀ s G u inp tmp a rest, OkU u → OkA a → G rARG = a :: rest → KG G →
    IRuns I iprog it (encK s (lin inp (u :: tmp) G))
      (encK s (lin inp (u :: tmp) (update G rACC (g a u :: G rACC)))) c

end lanes

/-! ## The slab loops -/

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILSlab3
/-!
# B-line IL, B1 (streaming slab pass) §3: one command, the command loop, one block

The skeleton contents are kept in the form `skS G C CU OP ARG ACC` (control `rC`, used
commands `rCU`, current op `rOP`, current argument `rARG`, output `rACC`, over `G`).

* `cmdP`: pop `(op, arg)` from `rC` to `rOP`, `rARG`; branch on the sign of `op`:
  drop a slab (`op < 0`), emit `m` zeros (`op = 0`), emit the slab mapped by `g arg`, reading
  the units to the temps and moving them back (`op > 0`); push `op`, `arg` to `rCU`.
  **`cmd_runs`**.
* `cmdLoop`: `rptX rNC cmdP` — the whole command list; **`cmdLoop_runs`**: the output is
  `runC m g cs inp` (reversed onto `rACC`), the input loses `nDrop cs` slabs.
* `restLoop`: `rptX rNC (mv rCU rC; mv rCU rC)` restores the control list.
  **`restLoop_runs`**.
* `blockP = cmdLoop; restLoop`: **`block_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)

/-! ## The skeleton contents -/

/-- The skeleton contents over `G`. -/
def skS (G : Fin HS → List ℤ) (C CU OP ARG ACC : List ℤ) : Fin HS → List ℤ :=
  update (update (update (update (update G rC C) rCU CU) rOP OP) rARG ARG) rACC ACC

section sk
variable (G : Fin HS → List ℤ) (C CU OP ARG ACC : List ℤ)

@[simp] theorem skS_C : skS G C CU OP ARG ACC rC = C := by
  simp (config := { decide := true }) [skS, update_apply]
@[simp] theorem skS_CU : skS G C CU OP ARG ACC rCU = CU := by
  simp (config := { decide := true }) [skS, update_apply]
@[simp] theorem skS_OP : skS G C CU OP ARG ACC rOP = OP := by
  simp (config := { decide := true }) [skS, update_apply]
@[simp] theorem skS_ARG : skS G C CU OP ARG ACC rARG = ARG := by
  simp (config := { decide := true }) [skS, update_apply]
@[simp] theorem skS_ACC : skS G C CU OP ARG ACC rACC = ACC := by simp [skS]

theorem skS_ne {j : Fin HS} (h1 : j ≠ rC) (h2 : j ≠ rCU) (h3 : j ≠ rOP) (h4 : j ≠ rARG)
    (h5 : j ≠ rACC) : skS G C CU OP ARG ACC j = G j := by
  simp [skS, h1, h2, h3, h4, h5]

@[simp] theorem skS_lA : skS G C CU OP ARG ACC lA = G lA := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_lC : skS G C CU OP ARG ACC lC = G lC := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_lD : skS G C CU OP ARG ACC lD = G lD := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_rM : skS G C CU OP ARG ACC rM = G rM := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_rNC : skS G C CU OP ARG ACC rNC = G rNC := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_rNB : skS G C CU OP ARG ACC rNB = G rNB := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)
@[simp] theorem skS_rTOT : skS G C CU OP ARG ACC rTOT = G rTOT := skS_ne _ _ _ _ _ _ (by decide)
  (by decide) (by decide) (by decide) (by decide)

end sk

/-! ## Lane-state operations -/

/-! ## One command -/

section cmd
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The unit programs and their specifications. -/
structure UnitsOK (lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ))
    (OkU : U → Prop) (OkA : ℤ → Prop) (KG : (Fin HS → List ℤ) → Prop) (g : ℤ → U → ℤ)
    (dr rd it bk : IStmt HS P) (cdr crd cit cbk : ℕ) : Prop where
  hL : LaneOK lin
  hdr : DrOK (I := I) (iprog := iprog) lin OkU dr cdr
  hrd : RdOK (I := I) (iprog := iprog) lin OkU rd crd
  hit : ItOK (I := I) (iprog := iprog) lin OkU OkA KG g it cit
  hbk : BkOK (I := I) (iprog := iprog) lin OkU bk cbk

/-- Emit a slab: read it to the temps while emitting, then move it back. -/
def emitP (rd it bk : IStmt HS P) : IStmt HS P :=
  .seq (rptX rM lA lC lD (.seq rd it)) (rptX rM lA lC lD bk)

/-- **One command.** -/
def cmdP (dr rd it bk : IStmt HS P) : IStmt HS P :=
  .seq (.op (.mv rC rOP)) (.seq (.op (.mv rC rARG)) (.seq
    (.ite rOP (fun c => c == .neg) (rptX rM lA lC lD dr)
      (.ite rOP (fun c => c == .zero) (rptX rM lA lC lD (.op (.const rACC 0))) (emitP rd it bk)))
    (.seq (.op (.mv rOP rCU)) (.op (.mv rARG rCU)))))

/-- The cost bound of one command (`cu = cdr + crd + cit + cbk`). -/
def cmdC (m Ba cu : ℕ) : ℕ := 4 * (2 * moveCost Ba + 19) + 50 + (m + 1) * (cu + 12002)

variable {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

end cmd

/-! ## The command loop -/

/-- The control list of a command list. -/
def flatC (cs : List (ℤ × ℤ)) : List ℤ := cs.flatMap fun c => [c.1, c.2]

@[simp] theorem flatC_nil : flatC [] = [] := rfl

section loop
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

/-- The command loop. -/
def cmdLoop (dr rd it bk : IStmt HS P) : IStmt HS P := rptX rNC lA lC lD (cmdP dr rd it bk)

/-- Admissible commands: bounded sizes, admissible arguments for the emits. -/
def CmdsOK (OkA : ℤ → Prop) (Ba : ℕ) (cs : List (ℤ × ℤ)) : Prop :=
  ∀ c ∈ cs, zsz c.1 ≤ Ba ∧ zsz c.2 ≤ Ba ∧ (0 < c.1 → OkA c.2)

/-- The restore loop body. -/
def restP : IStmt HS P := .seq (.op (.mv rCU rC)) (.op (.mv rCU rC))

/-- One block: the command loop, then the restore loop. -/
def blockP (dr rd it bk : IStmt HS P) : IStmt HS P := .seq (cmdLoop dr rd it bk) (rptX rNC lA lC lD restP)

/-- The cost bound of one block. -/
def blockC (L m Ba cu : ℕ) : ℕ :=
  (L + 1) * (cmdC m Ba cu + 3000) + (L + 1) * (2 * (2 * moveCost Ba + 19) + 3000)

end loop

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILSlab4
/-!
# B-line IL, B1 (streaming slab pass) §4: the whole pass (generic lanes)

`passP = rptX rNB blockP; rptX rTOT (mv rACC 0)`: the blocks, then the output (collected
reversed on `rACC`) is moved onto stack `0`. **`pass_runs`**: from the lane state with the input
`xs` (`pre` blocks of `n` slabs of `m` units) the output `passOut … ++ G 0` lands on stack `0`; all
skeleton registers are restored (`rACC` empty again). **`passOut_eq`**: for the control list
`ctlOf n n' src argOf` of a monotone source, `passOut` is `slabPass` (block form).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)

/-- The output of the pass. -/
def passOut {U : Type*} (m : ℕ) (g : ℤ → U → ℤ) (cs : List (ℤ × ℤ)) (n pre : ℕ) (xs : List U) :
    List ℤ :=
  (List.range pre).flatMap fun i => runC m g cs (xs.drop (i * (n * m)))

/-- **The pass program.** -/
def passP {P : ℕ} (dr rd it bk : IStmt HS P) : IStmt HS P :=
  .seq (rptX rNB lA lC lD (blockP dr rd it bk)) (rptX rTOT lA lC lD (.op (.mv rACC 0)))

/-- The cost bound of the pass. -/
def passC (pre L m Ba cu T Bo : ℕ) : ℕ :=
  (pre + 1) * (blockC L m Ba cu + 3000) + (T + 1) * (2 * moveCost Bo + 19 + 3000)

/-! ## The pass output is the slab pass -/

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILSlab5
/-!
# B-line IL, B1 (streaming slab pass) §5: the integer lane, identity and scale items

**The integer lane** `linZ inp tmp G`: the remaining input units on stack `0`, the moved units on
`rT = 50` (both over `G`). Units: `rdZ = mv 0 rT`, `bkZ = mv rT 0`, `drZ = drop 0`; `OkU u` is
`zsz u ≤ Bu`.

**Items** (`KG` trivial):
* identity (passes 3, 5): `itI = dup rT rACC`, `g a u = u`;
* scale (pass 1): `itS = dup rT rACC; shl rACC rARG`, `g a u = u * a` for `a = 2^e`, `e ≤ E`
  (the argument of every emit command is `2^e`).

**`unitsI`**, **`unitsS`**: the `UnitsOK` bundles, with the costs `O(Bu + E + 1)` per unit.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)

/-! ## Managed `shl`, `neg`, `add`, `split` -/

/-! ## The integer lane -/

/-- The integer lane. -/
def linZ (inp tmp : List ℤ) (G : Fin HS → List ℤ) : Fin HS → List ℤ :=
  update (update G 0 (inp ++ G 0)) rT (tmp ++ G rT)

section units
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The identity item. -/
def itI : IStmt HS P := .op (.dup rT rACC)

/-- The scale item. -/
def itS : IStmt HS P := .seq (.op (.dup rT rACC)) (.op (.shl rACC rARG))

/-- The scale arguments: powers of two. -/
def PowA (E : ℕ) (a : ℤ) : Prop := ∃ e ≤ E, a = 2 ^ e

end units

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILSlab6
/-!
# B-line IL, B1 (streaming slab pass) §6: the pair lane and the output item (pass 7)

**The pair lane** `linP inp tmp G` (units `(y, y₂) : ℤ × ℤ`, the zipped input): first components
on stack `0` / temps `rT = 50`, second components on `rZ = 53` / temps `rT2 = 51`. Units:
`rdP = mv 0 rT; mv rZ rT2`, `bkP` (reverse), `drP = drop 0; drop rZ`.

**The output item** `itO pM` (constants `2^k₁` on `rK1 = 41`, `2^k₂` on `rK2 = 42`, scratch
`43, 46, 54`, multiplication via `mulC pM` / `ARGM = 55`):
`g a (y, y₂) = (a * ((y - y₂) / 2^k₁)).tdiv (2^k₂)` (`outG`), i.e. `outE` with `a = d̃_l`,
`k₁ = P - p`, `k₂ = p`. The floor division is the truncating `split` corrected by the sign of
the remainder; the cost is `O(cU Z)` with `Z = Bu + Ba + 2` (one multiplication).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000
set_option maxHeartbeats 1000000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## Managed `neg`, `add`, `split`, `mulC` -/

/-! ## The pair lane -/

/-- The pair lane. -/
def linP (inp tmp : List (ℤ × ℤ)) (G : Fin HS → List ℤ) : Fin HS → List ℤ :=
  update (update (update (update G 0 (inp.map Prod.fst ++ G 0)) rZ (inp.map Prod.snd ++ G rZ))
    rT (tmp.map Prod.fst ++ G rT)) rT2 (tmp.map Prod.snd ++ G rT2)

/-- Both components bounded. -/
def OkP (Bu : ℕ) (u : ℤ × ℤ) : Prop := zsz u.1 ≤ Bu ∧ zsz u.2 ≤ Bu

section units
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

def rdP : IStmt HS P := .seq (.op (.mv 0 rT)) (.op (.mv rZ rT2))
def bkP : IStmt HS P := .seq (.op (.mv rT 0)) (.op (.mv rT2 rZ))
def drP : IStmt HS P := .seq (.op (.drop 0)) (.op (.drop rZ))

end units

/-! ## The output item -/

/-- The output map of an entry pair. -/
def outG (k₁ k₂ : ℕ) (a : ℤ) (u : ℤ × ℤ) : ℤ := (a * ((u.1 - u.2) / 2 ^ k₁)).tdiv (2 ^ k₂)

/-- The constants of the output item. -/
def KO (k₁ k₂ : ℕ) (G : Fin HS → List ℤ) : Prop :=
  (∃ l, G rK1 = (2 : ℤ) ^ k₁ :: l) ∧ (∃ l, G rK2 = (2 : ℤ) ^ k₂ :: l)

section item
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The floor correction. -/
def fixP : IStmt HS P :=
  .ite 43 (fun c => c == .neg) (.seq (.op (.const 46 (-1))) (.op (.add 54 46 54))) .skip

/-- **The output item.** -/
def itO (pM : Fin P) : IStmt HS P :=
  .seq (.op (.dup rT 43)) (.seq (.op (.dup rT2 46)) (.seq (.op (.neg 46)) (.seq (.op (.add 43 46 54))
  (.seq (.op (.split 54 rK1 43)) (.seq fixP (.seq (.op (.drop 43))
  (.seq (NLogN.KFUU.mulC pM 54 rARG 43) (.seq (.op (.drop 54)) (.seq (.op (.split 43 rK2 46))
  (.seq (.op (.drop 46)) (.op (.mv 43 rACC))))))))))))

/-- The cost bound of the output item. -/
def cItO (Z k₁ k₂ : ℕ) : ℕ := 12 * cU Z + 200 * (k₁ + 1) + 200 * (k₂ + 1) + 100

end item

end J6Seg.Slab

