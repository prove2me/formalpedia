-- title:
--   Definitions for Covariant Quantum Dynamical Semigroups: Unbounded generators
-- statement:
--   The objects the formalized statements of *Covariant Quantum Dynamical Semigroups: Unbounded generators* (arXiv:quant-ph/9701037) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `NoiseSpace`: PDF pp.1,4: the completed Hilbert tensor product of system and noise spaces.
--   - `completedTensorMap`: PDF pp.1,4,9: continuous extension of A tensor B to the completed tensor product. The extension is along the canonical dense isometric embedding, so the default branch of `ContinuousLinearMap.extend` is never used here.
--   - `noiseInsertion`: PDF p.9: I tensor a, sending a system vector psi to psi tensor a.
--   - `StandardData`: PDF p.4, (8): actual possibly unbounded operators on one common subspace D. Density and dissipativity are hypotheses, not fields assuming any solution exists.
--   - `standardForm`: PDF p.4, (8): standard form, with the first argument conjugate-linear.
--   - `IsDissipative`: PDF p.4: the dissipativity inequality, on every vector of D.
--   - `IsCPOnBoundedOperators`: PDF p.1, (1): complete positivity tested by every finite family of system vectors and bounded operators. Realness is included in the complex inequality.
--   - `IsPositiveOperator`: PDF p.2: positivity for actual bounded operators.
--   - `operatorWOTTopology`: PDF p.1: weak operator topology from all matrix elements. This is used only on norm-bounded sets, where the source identifies it with the weak-star topology.
--   - `IsNormal`: PDF pp.1–2: normality of a bounded linear map on B(H), equivalently continuity of all output matrix elements on the operator-norm unit ball in WOT. Both the input ball and its bounded image carry their weak-star topology.
--   - `DynamicalSemigroup`: PDF p.2: the source's normal subunital quantum dynamical semigroups on the entire B(H). Matrix-element orbit continuity is weak-star continuity because complete positivity and subunitality bound the whole orbit of each X.
--   - `SolvesBackward`: PDF p.4, (9): backward equation for all bounded X and all vectors of D. Time is restricted to [0,infinity); at zero this is a right derivative. The value on negative time used to totalize the function is never tested.
--   - `IsMinimalBackward`: PDF p.4: minimality compares with every dynamical-semigroup solution of the same weak equation and identity initial condition, at every nonnegative time.
--   - `IsConservativeForm`: PDF p.4: conservative form; this is distinct from unitality of an evolution.
--   - `IsUnitalQDS`: PDF p.2: actual unitality on the entire identity, for every nonnegative time.
--   - `closedKGraph`: PDF pp.4–5: graph closure of the actual domain-restricted K in H times H.
--   - `HasMaximalAccretiveClosure`: PDF pp.4–5: K is closable, and its closure is maximal accretive. The first clause ensures the closed linear relation is an operator. The last clause is the Hilbert-space range characterization of maximal accretivity, for every positive real lambda. No bounded exponential is used.
--   - `ContractionSemigroup`: PDF p.5: an actual C0 contraction semigroup on the system Hilbert space.
--   - `IsGeneratedByNegativeClosure`: PDF p.5: T is generated by minus the actual closure of K, characterized on its entire generator graph by the Hilbert-norm right derivative at zero.
--   - `IsRelaxingEvolution`: PDF p.5: the displayed no-jump evolution, T_t adjoint X T_t. An unbounded operator is never passed to a bounded-operator exponential.
--   - `NoiseGauge`: PDF p.9: gauge parameters, with an actual unitary on the entire noise space.
--   - `gaugeMul`: PDF p.9, (23): left factor gp acts after right factor g.
--   - `gaugeIdentity`: PDF p.9, (23): identity parameters.
--   - `noiseGaugeInverse`: PDF p.9, (23): inverse parameters.
--   - `noiseRotation`: PDF p.9: the rotation I tensor D_noise.
--   - `gaugeAction`: PDF p.9: the displayed transformation of L and K, on the same subspace D.
-- source:
--   Covariant Quantum Dynamical Semigroups: Unbounded generators, arXiv:quant-ph/9701037v1, https://arxiv.org/abs/quant-ph/9701037v1

import Mathlib

/-!
Statements from Holevo, arXiv:quant-ph/9701037v1, PDF pp.4–5,9.
The system and noise Hilbert spaces can be infinite dimensional and nonseparable.
The tensor product is completed. Domain-restricted operators are linear maps
on the actual subspace, with no boundedness assumption on those maps.
Remaining analytic statements and source ambiguities are recorded in HARD.md.
Compilation is pending the batch handoff.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Claimed50.P50

open scoped TensorProduct BigOperators

variable {H N : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable [NormedAddCommGroup N] [InnerProductSpace ℂ N] [CompleteSpace N]

/-- PDF pp.1,4: the completed Hilbert tensor product of system and noise spaces. -/
abbrev NoiseSpace (H N : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [NormedAddCommGroup N] [InnerProductSpace ℂ N] :=
  UniformSpace.Completion (TensorProduct ℂ H N)

/-- PDF pp.1,4,9: continuous extension of A tensor B to the completed tensor product.
The extension is along the canonical dense isometric embedding, so the default
branch of `ContinuousLinearMap.extend` is never used here. -/
def completedTensorMap (A : H →L[ℂ] H) (B : N →L[ℂ] N) :
    NoiseSpace H N →L[ℂ] NoiseSpace H N :=
  ((UniformSpace.Completion.toComplL :
      TensorProduct ℂ H N →L[ℂ] NoiseSpace H N).comp (TensorProduct.mapL A B)).extend
    (UniformSpace.Completion.toComplL :
      TensorProduct ℂ H N →L[ℂ] NoiseSpace H N)

/-- PDF p.9: I tensor a, sending a system vector psi to psi tensor a. -/
def noiseInsertion (a : N) : H →L[ℂ] NoiseSpace H N :=
  (UniformSpace.Completion.toComplL :
    TensorProduct ℂ H N →L[ℂ] NoiseSpace H N).comp
    ((TensorProduct.mkL ℂ H N).flip a)

/-- PDF p.4, (8): actual possibly unbounded operators on one common subspace D.
Density and dissipativity are hypotheses, not fields assuming any solution exists. -/
structure StandardData (D : Submodule ℂ H) where
  L : D →ₗ[ℂ] NoiseSpace H N
  K : D →ₗ[ℂ] H

/-- PDF p.4, (8): standard form, with the first argument conjugate-linear. -/
def standardForm {D : Submodule ℂ H} (S : StandardData (N := N) D)
    (psi : D) (X : H →L[ℂ] H) (phi : D) : ℂ :=
  inner ℂ (S.L psi)
      (completedTensorMap X (ContinuousLinearMap.id ℂ N) (S.L phi)) -
    inner ℂ (S.K psi) (X (phi : H)) -
    inner ℂ (psi : H) (X (S.K phi))

/-- PDF p.4: the dissipativity inequality, on every vector of D. -/
def IsDissipative {D : Submodule ℂ H} (S : StandardData (N := N) D) : Prop :=
  ∀ psi : D, ‖S.L psi‖ ^ 2 ≤ 2 * (inner ℂ (psi : H) (S.K psi)).re

/-- PDF p.1, (1): complete positivity tested by every finite family of system
vectors and bounded operators. Realness is included in the complex inequality. -/
def IsCPOnBoundedOperators (F : (H →L[ℂ] H) → (H →L[ℂ] H)) : Prop :=
  ∀ (n : ℕ) (v : Fin n → H) (X : Fin n → (H →L[ℂ] H)),
    (∑ i, ∑ j, inner ℂ (v i) (F ((X i).adjoint.comp (X j)) (v j))).im = 0 ∧
    0 ≤ (∑ i, ∑ j, inner ℂ (v i) (F ((X i).adjoint.comp (X j)) (v j))).re

/-- PDF p.2: positivity for actual bounded operators. -/
def IsPositiveOperator (X : H →L[ℂ] H) : Prop :=
  ∀ psi : H, (inner ℂ psi (X psi)).im = 0 ∧ 0 ≤ (inner ℂ psi (X psi)).re

/-- PDF p.1: weak operator topology from all matrix elements. This is used only
on norm-bounded sets, where the source identifies it with the weak-star topology. -/
def operatorWOTTopology : TopologicalSpace (H →L[ℂ] H) :=
  TopologicalSpace.induced
    (fun X : H →L[ℂ] H => fun psi phi : H => inner ℂ psi (X phi)) inferInstance

/-- PDF pp.1–2: normality of a bounded linear map on B(H), equivalently continuity
of all output matrix elements on the operator-norm unit ball in WOT.
Both the input ball and its bounded image carry their weak-star topology. -/
def IsNormal (F : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)) : Prop :=
  letI : TopologicalSpace (H →L[ℂ] H) := operatorWOTTopology (H := H)
  ∀ psi phi : H, ContinuousOn (fun X => inner ℂ psi (F X phi))
    {X : H →L[ℂ] H | ‖X‖ ≤ 1}

/-- PDF p.2: the source's normal subunital quantum dynamical semigroups on the
entire B(H). Matrix-element orbit continuity is weak-star continuity because
complete positivity and subunitality bound the whole orbit of each X. -/
structure DynamicalSemigroup (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] where
  maps : NNReal → (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)
  initial : maps 0 = ContinuousLinearMap.id ℂ (H →L[ℂ] H)
  semigroup : ∀ s t, maps (s + t) = (maps s).comp (maps t)
  normal : ∀ t, IsNormal (maps t)
  completelyPositive : ∀ t, IsCPOnBoundedOperators (maps t)
  subunital : ∀ t, IsPositiveOperator
    (ContinuousLinearMap.id ℂ H - maps t (ContinuousLinearMap.id ℂ H))
  orbitContinuous : ∀ (X : H →L[ℂ] H) (psi phi : H),
    Continuous (fun t : NNReal => inner ℂ psi (maps t X phi))

/-- PDF p.4, (9): backward equation for all bounded X and all vectors of D.
Time is restricted to [0,infinity); at zero this is a right derivative.
The value on negative time used to totalize the function is never tested. -/
def SolvesBackward {D : Submodule ℂ H} (S : StandardData (N := N) D)
    (Phi : DynamicalSemigroup H) : Prop :=
  ∀ (t : NNReal) (X : H →L[ℂ] H) (psi phi : D),
    HasDerivWithinAt
      (fun s : ℝ => inner ℂ (psi : H) (Phi.maps s.toNNReal X (phi : H)))
      (standardForm S psi (Phi.maps t X) phi) (Set.Ici 0) (t : ℝ)

/-- PDF p.4: minimality compares with every dynamical-semigroup solution of
the same weak equation and identity initial condition, at every nonnegative time. -/
def IsMinimalBackward {D : Submodule ℂ H} (S : StandardData (N := N) D)
    (Phi : DynamicalSemigroup H) : Prop :=
  SolvesBackward S Phi ∧
    ∀ Psi : DynamicalSemigroup H, SolvesBackward S Psi →
      ∀ t, IsCPOnBoundedOperators (fun X => Psi.maps t X - Phi.maps t X)

/-- PDF p.4: conservative form; this is distinct from unitality of an evolution. -/
def IsConservativeForm {D : Submodule ℂ H} (S : StandardData (N := N) D) : Prop :=
  ∀ psi : D, ‖S.L psi‖ ^ 2 = 2 * (inner ℂ (psi : H) (S.K psi)).re

/-- PDF p.2: actual unitality on the entire identity, for every nonnegative time. -/
def IsUnitalQDS (Phi : DynamicalSemigroup H) : Prop :=
  ∀ t, Phi.maps t (ContinuousLinearMap.id ℂ H) = ContinuousLinearMap.id ℂ H

/-- PDF pp.4–5: graph closure of the actual domain-restricted K in H times H. -/
def closedKGraph {D : Submodule ℂ H} (S : StandardData (N := N) D) : Set (H × H) :=
  closure {z | ∃ psi : D, z = ((psi : H), S.K psi)}

/-- PDF pp.4–5: K is closable, and its closure is maximal accretive.
The first clause ensures the closed linear relation is an operator.
The last clause is the Hilbert-space range characterization of maximal
accretivity, for every positive real lambda. No bounded exponential is used. -/
def HasMaximalAccretiveClosure {D : Submodule ℂ H}
    (S : StandardData (N := N) D) : Prop :=
  (∀ y : H, (0, y) ∈ closedKGraph S → y = 0) ∧
  (∀ z ∈ closedKGraph S, 0 ≤ (inner ℂ z.1 z.2).re) ∧
  ∀ lambda : ℝ, 0 < lambda → ∀ f : H,
    ∃ z ∈ closedKGraph S, (lambda : ℂ) • z.1 + z.2 = f

/-- PDF p.1, (1): the empty finite test is zero and satisfies positivity. -/
example (F : (H →L[ℂ] H) → (H →L[ℂ] H))
    (v : Fin 0 → H) (X : Fin 0 → (H →L[ℂ] H)) :
    (∑ i, ∑ j, inner ℂ (v i) (F ((X i).adjoint.comp (X j)) (v j))).im = 0 ∧
    0 ≤ (∑ i, ∑ j, inner ℂ (v i) (F ((X i).adjoint.comp (X j)) (v j))).re := by
  simp

/-- PDF p.4: the zero vector has zero weak form value. -/
example {D : Submodule ℂ H} (S : StandardData (N := N) D)
    (X : H →L[ℂ] H) (phi : D) : standardForm S 0 X phi = 0 := by
  simp [standardForm]

/-- PDF p.5: an actual C0 contraction semigroup on the system Hilbert space. -/
structure ContractionSemigroup (H : Type*) [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] where
  maps : NNReal → H →L[ℂ] H
  initial : maps 0 = ContinuousLinearMap.id ℂ H
  semigroup : ∀ s t, maps (s + t) = (maps s).comp (maps t)
  contraction : ∀ t x, ‖maps t x‖ ≤ ‖x‖
  orbitContinuous : ∀ x, Continuous (fun t : NNReal => maps t x)

/-- PDF p.5: T is generated by minus the actual closure of K, characterized
on its entire generator graph by the Hilbert-norm right derivative at zero. -/
def IsGeneratedByNegativeClosure {D : Submodule ℂ H}
    (S : StandardData (N := N) D) (T : ContractionSemigroup H) : Prop :=
  letI : NormedSpace ℝ H := NormedSpace.restrictScalars ℝ ℂ H
  ∀ x y : H, (x, y) ∈ closedKGraph S ↔
    HasDerivWithinAt (fun s : ℝ => T.maps s.toNNReal x) (-y) (Set.Ici 0) (0 : ℝ)

/-- PDF p.5: the displayed no-jump evolution, T_t adjoint X T_t.
An unbounded operator is never passed to a bounded-operator exponential. -/
def IsRelaxingEvolution (T : ContractionSemigroup H) (Phi : DynamicalSemigroup H) : Prop :=
  ∀ (t : NNReal) (X : H →L[ℂ] H),
    Phi.maps t X = (T.maps t).adjoint.comp (X.comp (T.maps t))

/-- The Hilbert-space semigroup starts at the actual identity on every vector. -/
example (T : ContractionSemigroup H) (x : H) : T.maps 0 x = x := by
  rw [T.initial]
  rfl

/-- PDF p.9: gauge parameters, with an actual unitary on the entire noise space. -/
structure NoiseGauge (N : Type*) [NormedAddCommGroup N] [InnerProductSpace ℂ N] where
  Dnoise : N ≃ₗᵢ[ℂ] N
  a : N
  b : ℝ

/-- PDF p.9, (23): left factor gp acts after right factor g. -/
def gaugeMul (gp g : NoiseGauge N) : NoiseGauge N where
  Dnoise := g.Dnoise.trans gp.Dnoise
  a := gp.Dnoise g.a + gp.a
  b := g.b + gp.b - (inner ℂ gp.a (gp.Dnoise g.a)).im

/-- PDF p.9, (23): identity parameters. -/
def gaugeIdentity : NoiseGauge N where
  Dnoise := LinearIsometryEquiv.refl ℂ N
  a := 0
  b := 0

/-- PDF p.9, (23): inverse parameters. -/
def noiseGaugeInverse (g : NoiseGauge N) : NoiseGauge N where
  Dnoise := g.Dnoise.symm
  a := -(g.Dnoise.symm g.a)
  b := -g.b

/-- PDF p.9: the rotation I tensor D_noise. -/
def noiseRotation (g : NoiseGauge N) : NoiseSpace H N →L[ℂ] NoiseSpace H N :=
  completedTensorMap (ContinuousLinearMap.id ℂ H)
    g.Dnoise.toLinearIsometry.toContinuousLinearMap

/-- PDF p.9: the displayed transformation of L and K, on the same subspace D. -/
def gaugeAction {D : Submodule ℂ H} (g : NoiseGauge N)
    (S : StandardData (N := N) D) : StandardData (N := N) D where
  L := (noiseRotation g).toLinearMap.comp S.L +
    (noiseInsertion g.a).toLinearMap.comp D.subtype
  K := S.K +
    (((noiseInsertion g.a).adjoint.comp (noiseRotation g)).toLinearMap.comp S.L) +
    ((((‖g.a‖ ^ 2 / 2 : ℝ) : ℂ) - Complex.I * (g.b : ℂ)) • D.subtype)

/-- The insertion uses system first and noise second in the completed tensor. -/
example (a : N) (psi : H) : noiseInsertion a psi =
    ((psi ⊗ₜ[ℂ] a : TensorProduct ℂ H N) : NoiseSpace H N) := rfl

/-- The tensor extension preserves zero even for a zero noise or system space. -/
example (A : H →L[ℂ] H) (B : N →L[ℂ] N) : completedTensorMap A B 0 = 0 :=
  map_zero _

/-- A zero displacement contributes no affine displacement when multiplied on the right. -/
example (g : NoiseGauge N) : (gaugeMul g gaugeIdentity).a = g.a := by
  simp [gaugeMul, gaugeIdentity]

/-- The central parameter keeps its sign when composed with the identity. -/
example (g : NoiseGauge N) : (gaugeMul gaugeIdentity g).b = g.b := by
  simp [gaugeMul, gaugeIdentity]

end QAlgorithms.Papers.Independent.Claimed50.P50


