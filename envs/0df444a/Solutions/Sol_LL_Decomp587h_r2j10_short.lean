            have hsub0 : tk m - 1 = (m : ℝ) / 128 := by unfold tk; ring
            have hsub1 : tk (m + 1) - 1 = ((m : ℝ) + 1) / 128 := by unfold tk; push_cast; ring
            have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
            have htrap_simp : (tk (m + 1) - 1 - (tk m - 1)) / 2 *
                (1 / (tk m - 1) + 1 / (tk (m + 1) - 1)) =
