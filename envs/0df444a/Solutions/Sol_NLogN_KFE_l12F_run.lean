      · simp only [toEx, Ex.Bnd, IState.top_eq hL]; exact le_trans (NLogN.KIL.zsz_nat_le hok) hM
      · simp only [toEx, Ex.eval, IState.top_eq hL, NLogN.KIL.NE.val]
  | lit c, _, hok => ⟨trivial, le_trans (NLogN.KIL.zsz_nat_le hok) hM, rfl⟩
