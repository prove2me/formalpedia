-- title:
--   Lemma 4, (3.10) — $\mathbb E\|\nabla f_\mu(x_k)\|_0^*\le[2(S_1+\mu)(f(x_0)-f^*)(1-\mu/(S_1+n\mu))^k]^{1/2}$
-- statement:
--   Let the $n\ge1$ blocks $\mathbb R^{n_i}$ carry Euclidean norms (3.4), let $\|\cdot\|_0$ be the norm (3.9) with dual $\|\cdot\|_0^*$, and let $f$ be convex with coordinate-wise Lipschitz gradient, constants $L_i>0$ (2.2), $S_1(f)=\sum_iL_i$, minimizer $x_*$ and $f^*=f(x_*)$. Fix $\mu>0$, $x_0$, and the regularized objective $f_\mu(x)=f(x)+\frac\mu2\|x-x_0\|_0^2$.
--
--   Let $x_k$ be generated by RCDM$(1,x_0)$ as applied to $f_\mu$: with the constants $L_i(f_\mu)=L_i+\mu$, block $i$ is drawn with probability $(L_i+\mu)/(S_1(f)+n\mu)$, independently at each step, and $x_{s+1}=x_s-\frac1{L_{i_s}+\mu}U_{i_s}(f_\mu)'_{i_s}(x_s)^\#$, with any choice of the vectors $s^\#$ of (1.8). Then
--   $$\mathbb E\,\|\nabla f_\mu(x_k)\|_0^*\le\Big[2\big(S_1(f)+\mu\big)\big(f(x_0)-f^*\big)\Big(1-\frac{\mu}{S_1(f)+n\mu}\Big)^k\Big]^{1/2},$$
--   where the expectation is over the $k$ draws that determine $x_k$.
--
--   The lemma converts the linear rate of Theorem 2 on $f_\mu$ into a bound on the expected gradient norm, which Theorem 4 turns into a probability bound by Markov's inequality.
--
--   **Formalization Note** The paper writes $E_{\xi_k}$; $x_k$ depends only on the first $k$ draws, so the expectation over $\xi_{k-1}$ used here has the same value. Explicit hypotheses: $n\ge1$, $L_i>0$, $f$ convex (the standing assumptions of §2), $\mu>0$, and the existence of a minimizer of $f$. The method on $f_\mu$ uses $f_\mu$'s constants $L_i+\mu$, both in the step and in the sampling distribution (`prob (fun i => L i + μ) 1`). Euclidean blocks are inner-product spaces; the expectation is a finite weighted sum over draw sequences.
-- source:
--   Nesterov, Efficiency of coordinate descent methods on huge-scale optimization problems, CORE Discussion Paper 2010/2, p. 11, Lemma 4, (3.10)

import Mathlib
import Definitions.Def_NesterovRCD_HighProb_Basic

namespace NesterovRCD.HighProb

variable {n : ℕ} {E : Fin n → Type*} [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℝ (E i)]
  [∀ i, FiniteDimensional ℝ (E i)]

theorem lemma4 (hn : 0 < n) (f : NesterovRCD.Sublinear.Blocks E → ℝ) (hconv : ConvexOn ℝ Set.univ f)
    (L : Fin n → ℝ) (hL : NesterovRCD.Sublinear.CoordLipschitz f L)
    (sharp : ∀ i, (E i →L[ℝ] ℝ) → E i) (hsharp : NesterovRCD.Sublinear.IsSharpSelection sharp)
    (x0 xs : NesterovRCD.Sublinear.Blocks E) (hxs : NesterovRCD.Sublinear.IsMinimizer f xs) (μ : ℝ) (hμ : 0 < μ) (k : ℕ) :
    NesterovRCD.Sublinear.expect (NesterovRCD.Sublinear.prob (fun i => L i + μ) 1) k
        (fun idx => NesterovRCD.Sublinear.wdual L 0
          (NesterovRCD.Sublinear.gradBlocks (fReg f L μ x0) (NesterovRCD.Sublinear.rcdm (fReg f L μ x0) (fun i => L i + μ) sharp x0 k idx)))
      ≤ Real.sqrt (2 * (NesterovRCD.Sublinear.S L 1 + μ) * (f x0 - f xs) * (1 - μ / (NesterovRCD.Sublinear.S L 1 + n * μ)) ^ k) := by sorry

end NesterovRCD.HighProb
