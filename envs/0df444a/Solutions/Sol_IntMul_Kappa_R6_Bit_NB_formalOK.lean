theorem redM_mul' {N : ℕ} {A B : QMat2 529} (hA : GoodM N A) (hB : GoodM N B) :
    redM N (A * B) = redM N A * redM N B := redMap_mul hA hB

theorem redM_one' (N : ℕ) : redM N (1 : QMat2 529) = 1 := redMap_one N

/-! ## Stage facts -/

theorem seg1 : (∀ w < 65536, (genF (codeOf SG1_0) W1F).1 w = codeOf SG1_11 w) ∧
