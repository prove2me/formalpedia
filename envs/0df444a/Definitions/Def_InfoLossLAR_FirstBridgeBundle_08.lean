/-- An actual query-output machine and its fixed polynomial output layout.
The machine certificate is the platform's concrete stock TM2 PolyProgram. -/
structure QueryProgram where
  f : Str → Str
  program : PolyProgram id id f
  padding : Polynomial ℕ
  output_length : ∀ word, (f word).length = 2 * padding.eval word.length + 1

def bodyQueryProgram (Q : _root_.Integration9_9.GenericBody.QueryProgram) : PolyProgram id id Q.f := Q.program







def bodyFlagAddresses (Q : _root_.Integration9_9.GenericBody.QueryProgram) (word : Str) : List ℕ :=
  _root_.InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit.generatedAddressRange (_root_.Integration9_9.GenericBody.bodyQueryProgram Q) word (_root_.Integration9_9.LARCoinLayout.queryWireSlots Q.padding word ++ [()]) 0



def bodyPayloadAddresses (Q : _root_.Integration9_9.GenericBody.QueryProgram) (word : Str) : List ℕ :=
