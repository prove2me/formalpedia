theorem MIPRE.Halting.exists_code_halts_of_isRE {L : Set BitStr} (h : IsRE L) :
    ∃ r : BitStr → Code, Computable r ∧ ∀ x, HaltingGameValue.HaltsOnEmptyInput (r x) ↔ x ∈ L := by sorry
