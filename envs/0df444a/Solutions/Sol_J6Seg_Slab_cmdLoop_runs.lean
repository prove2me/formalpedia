theorem nDrop_append (a b : List (ℤ × ℤ)) : nDrop (a ++ b) = nDrop a + nDrop b := by
  induction a with
  | nil => simp [nDrop]
  | cons x a ih => obtain ⟨op, _⟩ := x; simp only [List.cons_append, nDrop, ih]; omega

end cmd

/-! ## Slab passes as block outputs -/

/-! ## Flattening -/

/-! ## Splitting a command list; validity -/

section valid
variable {U : Type*}

theorem runC_append (m : ℕ) (g : ℤ → U → ℤ) (a b : List (ℤ × ℤ)) (inp : List U) :
    runC m g (a ++ b) inp = runC m g a inp ++ runC m g b (inp.drop (nDrop a * m)) := by
  induction a generalizing inp with
  | nil => simp [runC, nDrop]
  | cons x a ih =>
    obtain ⟨op, c⟩ := x
    simp only [List.cons_append, runC, nDrop]
    by_cases h1 : op < 0
    · simp only [h1, if_true, ih, List.drop_drop]
      congr 2; ring
    · by_cases h2 : op = 0
      · simp [h1, h2, ih]
      · simp [h1, h2, ih]

theorem VC_get (n : ℕ) : ∀ (cs : List (ℤ × ℤ)) (d k : ℕ), VC n cs d → (hk : k < cs.length) →
    cs[k].1 ≠ 0 → d + nDrop (cs.take k) < n
  | [], _, _, _, hk, _ => absurd hk (by simp)
  | (op, c) :: cs, d, 0, h, _, hop => by
    simp only [VC] at h
    simpa [nDrop] using h.1 hop
  | (op, c) :: cs, d, k + 1, h, hk, hop => by
    simp only [VC] at h
    have := VC_get n cs _ k h.2 (by simpa using hk) (by simpa using hop)
    simp only [List.take_succ_cons, nDrop]
    omega

end valid

end J6Seg

