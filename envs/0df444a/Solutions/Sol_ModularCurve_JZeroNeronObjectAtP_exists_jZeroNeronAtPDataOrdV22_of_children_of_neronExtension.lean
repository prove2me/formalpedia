theorem pos_of_coprime {m p : ℕ} [hp : Fact p.Prime] (h : m.Coprime p) : 0 < m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · exact absurd (Nat.coprime_zero_left _ |>.mp h) hp.out.one_lt.ne'
  · exact hm

theorem inertiaSubgroupIn_le_decompositionSubgroup (A : ValuationSubring (AlgebraicClosure ℚ)) :
    A.inertiaSubgroupIn ℚ ≤ A.decompositionSubgroup ℚ := by
  rintro σ ⟨τ, -, rfl⟩
  exact τ.2

