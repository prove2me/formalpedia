/-!
# Chaînes singulières concrètes (A1, étape 1)

Le complexe singulier de Mathlib, `Chains R X`, est le complexe des faces alternées de
`toSSet X ⋙ sigmaConst.obj R` : en degré `n`, c'est le coproduit `∐_σ R` sur les `n`-simplexes
singuliers. Nous travaillons avec le modèle concret `FChains R X`, complexe des faces alternées de
`toSSet X ⋙ ModuleCat.free R`. En degré `n`, c'est le module libre `Simp n X →₀ R`, et la
différentielle est `∑ (-1)^i (δ_i)_*`.

Les deux complexes sont isomorphes, naturellement en `X` (`chainsIso`). En effet,
`sigmaConst.obj R` et `ModuleCat.free R` sont deux adjoints à gauche du même foncteur, à
isomorphisme près : `Hom(R, -)` d'un côté, l'ensemble sous-jacent de l'autre.
-/

open CategoryTheory Limits Opposite Simplicial AlgebraicTopology

namespace Hatcher.Singular

variable (R : Type) [Ring R]

/-- Les `n`-simplexes singuliers de `X`. -/
abbrev Simp (n : ℕ) (X : Type) [TopologicalSpace X] : Type :=
  (TopCat.toSSet.obj (TopCat.of X)) _⦋n⦌

/-- Le modèle concret du complexe singulier : faces alternées de `toSSet X ⋙ free R`. -/
noncomputable abbrev FChains (X : Type) [TopologicalSpace X] : ChainComplex (ModuleCat.{0} R) ℕ :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).obj (TopCat.toSSet.obj (TopCat.of X) ⋙ ModuleCat.free R)

/-- Le morphisme de complexes concret induit par une application continue. -/
noncomputable abbrev fmap {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    FChains R X ⟶ FChains R Y :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).map
    (Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f)) (ModuleCat.free R))

section Iso

/-- `Hom(R, M) ≅ M`, naturellement en `M`. -/
noncomputable def coyonedaIsoForget :
    coyoneda.obj (op (ModuleCat.of R R)) ≅ forget (ModuleCat.{0} R) :=
  NatIso.ofComponents
    (fun M ↦ Equiv.toIso
      { toFun := fun f ↦ f.hom (1 : R)
        invFun := fun m ↦ ModuleCat.ofHom (LinearMap.toSpanSingleton R M m)
        left_inv := fun f ↦ ModuleCat.hom_ext (LinearMap.ext_ring (by simp))
        right_inv := fun m ↦ by simp })
    (fun f ↦ by
      ext g
      rfl)

/-- `sigmaConst.obj R ≅ free R` (unicité de l'adjoint à gauche). -/
noncomputable def sigmaConstIsoFree :
    sigmaConst.obj (ModuleCat.of R R) ≅ ModuleCat.free R :=
  (sigmaConstAdj (ModuleCat.of R R)).leftAdjointUniq
    ((ModuleCat.adj R).ofNatIsoRight (coyonedaIsoForget R).symm)

/-- L'isomorphisme `C_•(X; R) ≅ FChains R X`. -/
noncomputable def chainsIso (X : Type) [TopologicalSpace X] : Chains R X ≅ FChains R X :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).mapIso
    (Functor.isoWhiskerLeft (TopCat.toSSet.obj (TopCat.of X)) (sigmaConstIsoFree R))

variable {R} in
theorem chainsMap_eq {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    chainsMap (R := R) f = (alternatingFaceMapComplex (ModuleCat.{0} R)).map
      (Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f))
        (sigmaConst.obj (ModuleCat.of R R))) := rfl

variable {R} in
/-- Naturalité de `chainsIso`. -/
theorem chainsMap_comp_chainsIso {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (f : C(X, Y)) :
    chainsMap (R := R) f ≫ (chainsIso R Y).hom = (chainsIso R X).hom ≫ fmap R f := by
  let F := alternatingFaceMapComplex (ModuleCat.{0} R)
  let S := sigmaConst.obj (ModuleCat.of R R)
  show F.map (Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f)) S) ≫
      F.map (Functor.isoWhiskerLeft (TopCat.toSSet.obj (TopCat.of Y)) (sigmaConstIsoFree R)).hom =
    F.map (Functor.isoWhiskerLeft (TopCat.toSSet.obj (TopCat.of X)) (sigmaConstIsoFree R)).hom ≫
      F.map (Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f)) (ModuleCat.free R))
  rw [← F.map_comp, ← F.map_comp]
  congr 1
  ext n : 2
  simp only [NatTrans.comp_app, Functor.whiskerRight_app, Functor.isoWhiskerLeft_hom,
    Functor.whiskerLeft_app]
  exact congrArg ModuleCat.Hom.hom ((sigmaConstIsoFree R).hom.naturality _)

end Iso

end Hatcher.Singular

end

