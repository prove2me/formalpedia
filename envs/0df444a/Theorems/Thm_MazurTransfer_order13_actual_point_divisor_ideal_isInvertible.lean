theorem MazurTransfer.order13_actual_point_divisor_ideal_isInvertible.{u} (K : Type u) [Field K] [CharZero K]
    (T : Scheme.{u}) (g : T ⟶ Spec (CommRingCat.of K))
    (x : T ⟶ MazurTorsion.XOneThirteenProjectiveCurve.curveScheme K)
    (hx : x ≫ MazurTorsion.XOneThirteenProjectiveCurve.curveToBase K = g) :
    (graphOver
      (MazurTorsion.XOneThirteenProjectiveCurve.curveToBase K) x hx).ker.IsInvertible := by sorry
