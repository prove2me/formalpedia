theorem popN_sp (s0 : IState HS) {X : Fin HS} (hX5 : X.val < 56) {A : ℕ} :
    ∀ (k : ℕ) (F : Fin HS → List ℤ) (L r : List ℤ), F X = L ++ r → L.length = k →
    (∀ a ∈ L, |a| ≤ 2 ^ A) →
    Sp (popN X k) (encK s0 F) (encK s0 (update F X r)) ((k + 1) * uC A DD)
  | 0, F, L, r, hF, hL, _ => by
    have hu := uC_ge A DD
    rw [List.length_eq_zero_iff] at hL; subst hL
    rw [List.nil_append] at hF
    rw [← hF, update_eq_self]
    exact (Sp.skip _).mono (by simp; omega)
  | k + 1, F, a :: L, r, hF, hL, hb => by
    have h1 := popP s0 F (i := X) (D := DD) hX5 hF (hb a (by simp)) (by decide)
    have h2 := popN_sp s0 hX5 k (update F X (L ++ r)) L r (update_self ..)
      (by simpa using hL) (fun x hx => hb x (by simp [hx]))
    rw [update_idem] at h2
    refine (h1.seq h2).mono (le_of_eq ?_)
    ring

theorem popN_w (X : Fin HS) (h : (43 : Fin HS) ≠ X) : ∀ k, (43 : Fin HS) ∉ (popN X k).writes
  | 0 => by simp [popN, RS.writes]
  | k + 1 => by
    have := popN_w X h k
    simp only [popN, RS.writes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false]
    tauto

theorem dropP_sp (s0 : IState HS) (F : Fin HS → List ℤ) {R X : Fin HS} (hR5 : R.val < 56)
    (hX5 : X.val < 56) (hRX : R ≠ X) (hX43 : X ≠ 43) (h43 : F 43 = []) {k m A : ℕ}
    {LR L r : List ℤ} (hFR : F R = (m : ℤ) :: LR) (hFX : F X = L ++ r) (hL : L.length = k * m)
    (hb : ∀ a ∈ L, |a| ≤ 2 ^ A) (hm : m ≤ 2 ^ A) :
    Sp (dropP R X k) (encK s0 F) (encK s0 (update F X r))
      ((m + 1) * ((k + 1) * uC A DD + uC A DD)) := by
  let S : ℕ → Fin HS → List ℤ := fun j => update F X (L.drop (k * (m - j)) ++ r)
  have hS43 : ∀ j, S j 43 = [] := fun j => by simp [S, update_of_ne hX43.symm, h43]
  have hSR : S m R = (m : ℤ) :: LR := by simp [S, update_of_ne hRX, hFR]
  have HL := loopDown s0 S hR5 hS43 hSR hm (b := popN X k)
    (popN_w X hX43.symm k)
    (fun j hj => by
      have e1 : k * (m - j) = k * (m - (j + 1)) + k := by
        rw [show m - j = m - (j + 1) + 1 by omega]; ring
      have hq : update (S (j + 1)) 43 [(j : ℤ) + 1] X =
          (L.drop (k * (m - (j + 1)))).take k ++ (L.drop (k * (m - j)) ++ r) := by
        simp only [S, update_of_ne hX43, update_self]
        rw [← List.append_assoc, e1, ← List.drop_drop, List.take_append_drop]
      have hlen : ((L.drop (k * (m - (j + 1)))).take k).length = k := by
        simp only [List.length_take, List.length_drop, hL]
        have : k * (m - (j + 1)) + k ≤ k * m := by
          rw [← e1]; exact Nat.mul_le_mul_left _ (by omega)
        omega
      have h := popN_sp s0 hX5 k _ _ _ hq hlen
        (fun a ha => hb a (List.mem_of_mem_drop (List.mem_of_mem_take ha)))
      have e : update (update (S (j + 1)) 43 [(j : ℤ) + 1]) X (L.drop (k * (m - j)) ++ r) =
          update (S j) 43 [(j : ℤ) + 1] := by
        simp only [S]; rw [update_comm hX43.symm, update_idem, update_comm hX43]
      rw [e] at h
      exact h)
  have e0 : S m = F := by simp [S, ← hFX]
  have e1 : S 0 = update F X r := by simp [S, ← hL]
  rw [e0, e1] at HL
  exact HL

end J6Seg.Src

