theorem perm_mid {X Y : List ℕ} (P Z : List ℕ) (h : List.Perm X Y) :
    List.Perm (P ++ X ++ Z) (P ++ Y ++ Z) := by
  simpa [List.append_assoc] using (h.append_right Z).append_left P

theorem p1_spec (mz : ℕ → ℕ) (bg : ℕ → Bool) (hmz : ∀ j, 1 ≤ mz j) (ax0 lay0 : List ℕ)
    (hnd : lay0.Nodup) (hF : Full bg ax0 lay0) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0) :
    ∀ (L pre Z : List ℕ), List.Perm (pre ++ layA bg L ++ Z) lay0 → ∀ (t : IState HS) (R : List Item),
      t.G 0 = ints (Dl mz bg ax0 (pre ++ layA bg L ++ Z) xs0 0) ++ R →
      IRuns I iprog (p1C mz bg pre L Z) t
        (t.upd 0 (ints (Dl mz bg ax0 (pre ++ mains L ++ bitsR bg L ++ Z) xs0 0) ++ R))
        ((L.length + 1) * (NLogN.KFU.cMv (AModel.vol (lay0.map (asz mz))) w + 1))
  | [], pre, Z, _, t, R, h0 => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    simp only [layA, mains, bitsR, bitsF, List.flatMap_nil, List.map_nil, List.reverse_nil,
      List.filter_nil, List.append_nil] at h0 ⊢
    rw [← h0]; simp
  | j :: L, pre, Z, hp, t, R, h0 => by
    have e0 : pre ++ layA bg (j :: L) ++ Z = (pre ++ atm bg j) ++ layA bg L ++ Z := by
      simp [layA_cons]
    rw [e0] at hp h0
    have IH := p1_spec mz bg hmz ax0 lay0 hnd hF w xs0 hx L (pre ++ atm bg j) Z hp t R h0
    set t1 := t.upd 0 (ints (Dl mz bg ax0 (pre ++ atm bg j ++ mains L ++ bitsR bg L ++ Z) xs0 0) ++ R)
    have hp1 : List.Perm (pre ++ atm bg j ++ mains L ++ bitsR bg L ++ Z) lay0 := by
      refine List.Perm.trans ?_ hp
      have := perm_mid (pre ++ atm bg j) Z (perm_layA_R bg L).symm
      simpa [List.append_assoc] using this
    by_cases hbj : bg j = true
    · simp only [p1C, hbj, if_true]
      have eL : pre ++ atm bg j ++ mains L ++ bitsR bg L ++ Z =
          (pre ++ [2 * j]) ++ [2 * j + 1] ++ (mains L ++ bitsR bg L) ++ Z := by
        simp [atm, hbj]
      rw [eL] at hp1
      have M := mvF_lay (I := I) (iprog := iprog) mz bg hmz ax0 (pre ++ [2 * j]) [2 * j + 1]
        (mains L ++ bitsR bg L) Z (hp1.nodup_iff.2 hnd) (hF.mono (fun x hx => hp1.symm.mem_iff.1 hx))
        w xs0 hx t1 R (by simp only [t1, IState.upd_G, if_true]; rw [eL])
      have eN : pre ++ [2 * j] ++ (mains L ++ bitsR bg L) ++ [2 * j + 1] ++ Z =
          pre ++ mains (j :: L) ++ bitsR bg (j :: L) ++ Z := by
        simp [mains, bitsR_cons, hbj]
      rw [eN] at M
      refine (IH.seq M).mono' (by simp [t1]) ?_
      have hc := mvF_cost mz hmz w (pre ++ [2 * j]) (mains L ++ bitsR bg L) Z (2 * j + 1)
        (by simp [asz])
      rw [vol_perm mz hp1] at hc
      simp only [List.length_cons]
      nlinarith
    · have hbj' : bg j = false := by simpa using hbj
      simp only [p1C, hbj', Bool.false_eq_true, if_false]
      refine (IH.seq (IRuns.skip t1)).mono' ?_ ?_
      · simp only [t1, IState.upd_upd_same]
        congr 3
        simp [atm, hbj', mains, bitsR_cons]
      · simp only [List.length_cons]; nlinarith

theorem p3_spec (mz : ℕ → ℕ) (bg : ℕ → Bool) (hmz : ∀ j, 1 ≤ mz j) (ax0 lay0 : List ℕ)
    (hnd : lay0.Nodup) (hF : Full bg ax0 lay0) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0) :
    ∀ (L pre Z : List ℕ), List.Perm (pre ++ layA bg L ++ Z) lay0 → ∀ (t : IState HS) (R : List Item),
      t.G 0 = ints (Dl mz bg ax0 (pre ++ mains L ++ bitsF bg L ++ Z) xs0 0) ++ R →
      IRuns I iprog (p3C mz bg pre L Z) t
        (t.upd 0 (ints (Dl mz bg ax0 (pre ++ layA bg L ++ Z) xs0 0) ++ R))
        ((L.length + 1) * (NLogN.KFU.cMv (AModel.vol (lay0.map (asz mz))) w + 1))
  | [], pre, Z, _, t, R, h0 => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    simp only [layA, mains, bitsF, List.flatMap_nil, List.map_nil,
      List.filter_nil, List.append_nil] at h0 ⊢
    rw [← h0]; simp
  | j :: L, pre, Z, hp, t, R, h0 => by
    have e0 : pre ++ layA bg (j :: L) ++ Z = (pre ++ atm bg j) ++ layA bg L ++ Z := by
      simp [layA_cons]
    rw [e0] at hp
    have hp1 : List.Perm (pre ++ mains (j :: L) ++ bitsF bg (j :: L) ++ Z) lay0 := by
      refine List.Perm.trans ?_ hp
      rw [← e0]
      simpa [List.append_assoc] using perm_mid pre Z (perm_layA_F bg (j :: L)).symm
    have IH := p3_spec mz bg hmz ax0 lay0 hnd hF w xs0 hx L (pre ++ atm bg j) Z hp
    by_cases hbj : bg j = true
    · simp only [p3C, hbj, if_true]
      have eL : pre ++ mains (j :: L) ++ bitsF bg (j :: L) ++ Z =
          (pre ++ [2 * j]) ++ mains L ++ [2 * j + 1] ++ (bitsF bg L ++ Z) := by
        simp [mains, bitsF_cons, hbj]
      rw [eL] at hp1 h0
      have M := mvB_lay (I := I) (iprog := iprog) mz bg hmz ax0 (pre ++ [2 * j]) (mains L)
        [2 * j + 1] (bitsF bg L ++ Z) (hp1.nodup_iff.2 hnd)
        (hF.mono (fun x hx => hp1.symm.mem_iff.1 hx)) w xs0 hx t R h0
      have eN : pre ++ [2 * j] ++ [2 * j + 1] ++ mains L ++ (bitsF bg L ++ Z) =
          pre ++ atm bg j ++ mains L ++ bitsF bg L ++ Z := by
        simp [atm, hbj]
      rw [eN] at M
      have IH' := IH (t.upd 0 (ints (Dl mz bg ax0 (pre ++ atm bg j ++ mains L ++ bitsF bg L ++ Z)
        xs0 0) ++ R)) R (by simp)
      refine (M.seq IH').mono' (by simp [layA_cons]) ?_
      have hc := mvB_cost mz hmz w (pre ++ [2 * j]) (mains L) (bitsF bg L ++ Z) (2 * j + 1)
        (by simp [asz])
      rw [vol_perm mz hp1] at hc
      simp only [List.length_cons]
      nlinarith
    · have hbj' : bg j = false := by simpa using hbj
      simp only [p3C, hbj', Bool.false_eq_true, if_false]
      have eL : pre ++ mains (j :: L) ++ bitsF bg (j :: L) ++ Z =
          pre ++ atm bg j ++ mains L ++ bitsF bg L ++ Z := by
        simp [atm, hbj', mains, bitsF_cons]
      rw [eL] at h0
      refine ((IRuns.skip t).seq (IH t R h0)).mono' (by simp [layA_cons]) ?_
      simp only [List.length_cons]; nlinarith

end NLogN.KFU

end

