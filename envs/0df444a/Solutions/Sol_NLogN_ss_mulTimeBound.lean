attribute [local irreducible] fmA
theorem solution :
    MulTimeBound fun n => (n : ℝ) * Real.log n * Real.log (Real.log n) := by
  obtain ⟨c, hc, n₀, h⟩ := ss_real_bound
  obtain ⟨B, hB⟩ : ∃ B : ℕ, B = 8 * fmA + 10 ^ 7 := ⟨_, rfl⟩
  have hB0 : (0 : ℝ) < B := by exact_mod_cast (show 0 < B by rw [hB]; exact Nat.lt_of_lt_of_le (by norm_num : 0 < 10 ^ 7) (Nat.le_add_left _ _))
  refine ⟨ssMachine, fun n _ => ⟨_, ss_multipliesAt n⟩, B * c, by positivity, n₀,
    fun n hn _ => multipliesAt_mono (ss_multipliesAt n) ?_⟩
  have h1 := mainCost_le n
  rw [← hB] at h1
  have h2 : ((2 * mainCost n + 1 : ℕ) : ℝ) ≤ (B : ℝ) * (((n + 1 : ℕ) : ℝ) *
      ((zsz ((n + 1 : ℕ) : ℤ) + 2 : ℕ) : ℝ) *
      ((zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1 : ℕ) : ℝ)) := by
    rw [← mul_assoc, ← mul_assoc]; exact_mod_cast h1
  have h3 := mul_le_mul_of_nonneg_left (h n hn) hB0.le
  push_cast at h2
  calc (2 * (mainCost n : ℝ) + 1) ≤ _ := h2
    _ ≤ _ := by push_cast at h3; exact h3
    _ = _ := by ring
