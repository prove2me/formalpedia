open QFS

variable {d : ℕ}

lemma solution {h : ℝ} (hh : 0 ≤ h)
    (u : EuclideanSpace ℝ (Fin d)) : QFS.halfClosedCube h u ⊆ QFS.closedCube h u := by
  intro x hx
  rw [QFS.closedCube_eq_iInter hh]
  intro T hT
  obtain ⟨i, rfl⟩ := Set.mem_range.mp hT
  exact ⟨(hx i).1, le_of_lt (hx i).2⟩
