-- title:
--   Decentralized strategy profiles and ε-Nash equilibrium (Definition 5.1)
-- statement:
--   A profile $\bar u=(\bar u^1,\dots,\bar u^N)$ of **decentralized strategies** (§5, p.14) is one in which every $\bar u^i$ is an optimal control of Problem (MFD) for agent $i$ with a mean-field pair $(x^0,u^0)$ satisfying the **consistency condition** (31):
--
--   $$x^0_t=\mathbb E[\bar X^i_t\mid\mathcal F^\theta_t],\qquad u^0_t=\mathbb E[\bar u^i_t\mid\mathcal F^\theta_t],$$
--
--   where $\bar X^i$ is the optimal limiting state of agent $i$.
--
--   **Definition 5.1.** The profile $\bar u$, with $\bar u^i\in\mathscr U^i_c$ for $1\le i\le N$, is an **$\varepsilon$-Nash equilibrium** with respect to the costs $\mathcal J_i$ if there is $\varepsilon>0$ such that
--
--   $$\mathcal J_i(\bar u^i,\bar u^{-i})\le\mathcal J_i(u^i,\bar u^{-i})+\varepsilon$$
--
--   for every agent $i$ and every alternative strategy $u^i\in\mathscr U^i_c$.
--
--   **Formalization Note** The profile is encoded by optimality and consistency rather than by the feedback formula (37), which is the conclusion of Theorem 4.12. The consistency for $u^0$ is required for a.e. $t$. In the $\varepsilon$-Nash predicate the value $\varepsilon>0$ is given; $\bar u^i\in\mathscr U^i_c$ is measured against the observations under $\bar u$, and a deviation $u^i$ against those under $(u^i,\bar u^{-i})$.
-- source:
--   Chen, Nie & Wu, Indefinite Linear-Quadratic Partially Observed Mean-Field Game, arXiv:2508.01568v1, (31)–(32) p.12, §5 opening p.14, Definition 5.1 p.15

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_IndefPOMFG_Coeffs
import Definitions.Def_IndefPOMFG_Space
import Definitions.Def_IndefPOMFG_NPlayer
import Definitions.Def_IndefPOMFG_Limiting

open MeasureTheory Set Peng1990.SMP
open scoped NNReal ENNReal Matrix

namespace IndefPOMFG

variable {n m d N : ℕ} {Ω : Type*} [MeasurableSpace Ω]

/-- `ū = (ū¹, …, ūᴺ)` is a profile of decentralized strategies (§5 opening, p.14; (31)–(32),
p.12) on the space `Sp`, with common observation `θ`, the processes `x^{0,0}` and `Y^{i,0}` of
(12)–(13), and mean-field pair `(x⁰, u⁰)`:
1. `θ` solves (4), `x^{0,0}` solves its equation, and `Y^{i,0}` is the observation (13) of agent `i`;
2. `(x⁰, u⁰)` is an `𝓕^θ`-adapted, square-integrable pair;
3. every `ūⁱ` is an optimal control of Problem (MFD) of agent `i` with parameter `(x⁰, u⁰)`;
4. the consistency condition (31) holds: `x⁰_t = E[X̄ⁱ_t | 𝓕^θ_t]` a.s. for every `t ∈ [0, T]` and
   `u⁰_t = E[ūⁱ_t | 𝓕^θ_t]` a.s. for almost every `t ∈ [0, T]`, for every agent `i`, where `X̄ⁱ` is the
   optimal state (10).

**Formalization Note** The paper's decentralized strategy is "given by (18)", i.e. `ūⁱ = ū^{i,P}`
of (32) with `(x⁰, u⁰)` fixed by the consistency condition (31) (§5 opening, p.14); the profile is
encoded by these properties rather than by the feedback formula (37), which is Theorem 4.12's
conclusion. Controls are determined only `dt ⊗ dP`-a.e., hence "a.e. `t`" for `u⁰`. -/
structure IsDecProfile (c : Coeffs n m d) (Sp : Space N d Ω) (θ : ℝ≥0 → Ω → Fin 1 → ℝ)
    (x00 : ℝ≥0 → Ω → Fin n → ℝ) (Y0 : Fin N → ℝ≥0 → Ω → Fin n → ℝ)
    (x0 : ℝ≥0 → Ω → Fin n → ℝ) (u0 : ℝ≥0 → Ω → Fin m → ℝ)
    (ub : Fin N → ℝ≥0 → Ω → Fin m → ℝ) : Prop where
  theta : IsTheta c Sp θ
  x00_sol : IsX00 c Sp x00
  lim0 : ∀ i, ∃ X0, IsLimState0 c Sp i x00 X0 (Y0 i)
  param : IsMFParam c Sp θ x0 u0
  opt : ∀ i, IsLimOptimal c Sp i x0 u0 θ (Y0 i) (ub i)
  consistent : ∀ i Xb Yb, IsLimState c Sp i x0 u0 (ub i) Xb Yb →
    (∀ t ≤ c.T, x0 t =ᵐ[Sp.P] condExp (obsTheta Sp θ t) Sp.P (Xb t)) ∧
      ∀ᵐ s ∂(volume.restrict (Icc (0 : ℝ) c.T)),
        u0 s.toNNReal =ᵐ[Sp.P] condExp (obsTheta Sp θ s.toNNReal) Sp.P (ub i s.toNNReal)

/-- Definition 5.1 (p.15), with a given `ε > 0`: the profile `ū` is an `ε`-Nash equilibrium with
respect to the costs `𝒥_i` if
1. `ūⁱ ∈ 𝒰ⁱ_c` for every agent `i` (with `𝓕^y` generated by the observations (3) under `ū`), and
2. `𝒥_i(ūⁱ, ū⁻ⁱ) ≤ 𝒥_i(uⁱ, ū⁻ⁱ) + ε` for every agent `i` and every alternative `uⁱ ∈ 𝒰ⁱ_c` (with `𝓕^y`
   generated by the observations under the profile `(uⁱ, ū⁻ⁱ)`).
`y0` is the family `(y^{j,0})ⱼ` of (7) defining `𝒰^{i,0}_c`; costs are evaluated along solutions of
(2)–(3). -/
def IsEpsNash (c : Coeffs n m d) (Sp : Space N d Ω) (θ : ℝ≥0 → Ω → Fin 1 → ℝ)
    (y0 : Fin N → ℝ≥0 → Ω → Fin n → ℝ) (ub : Fin N → ℝ≥0 → Ω → Fin m → ℝ) (ε : ℝ) : Prop :=
  0 < ε ∧
    (∀ i x y, IsNState c Sp ub x y → InUc c Sp θ y0 y (ub i)) ∧
    ∀ i (v : ℝ≥0 → Ω → Fin m → ℝ) xb yb x y, IsNState c Sp ub xb yb →
      IsNState c Sp (Function.update ub i v) x y → InUc c Sp θ y0 y v →
      NCost c Sp.P xb ub i ≤ NCost c Sp.P x (Function.update ub i v) i + ε

end IndefPOMFG


