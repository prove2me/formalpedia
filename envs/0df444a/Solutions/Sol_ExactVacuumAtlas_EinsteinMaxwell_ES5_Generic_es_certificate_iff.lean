theorem ptR_one (r : ℝ) : ptR r 1 = r := by simp [ptR]

theorem ptR_mem {r : ℝ} (hr : r ∈ R) : ptR r ∈ esDomain R :=
  ⟨by simpa [ptR] using hr, by norm_num [ptR], by norm_num [ptR]⟩

