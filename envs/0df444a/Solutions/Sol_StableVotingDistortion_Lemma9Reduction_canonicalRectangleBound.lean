open Bounds


def Secants (f : ℝ → ℝ) (x y : ℝ) (s : Bounds) : Prop :=
  ∃ m : ℝ, s.Holds m ∧ f y-f x = m*(y-x)

end StableVotingDistortion.PaperBox
