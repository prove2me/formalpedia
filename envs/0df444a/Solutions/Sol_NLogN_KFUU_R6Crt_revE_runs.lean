-- Source module: Solutions.KFURevBase
/-!
# KFU §3: labelled layouts for the axis reversal

Addresses of the working array are tracked through *layouts*: lists of atom labels (`2j` is the
main part of axis `j`, of size `mz j`; `2j+1` is its extra bit, of size `2`, present when
`bg j`).  An axis of size `tz j = mz j · (2 if bg j)` is the pair `[mz j, 2]` in row-major order.

* `Dl ax0 lay xs`: the array `xs` (shape `ax0.map tz`) viewed in the layout `lay`.
* `POp g σ n`: an address map `g = permIdx σ` on `n` digits, `σ` onto `[0, n)`.
* `Dl_step`: a program realizing `pull (g lay').map asz → lay'.map asz` by `g` turns
  `Dl ax0 (g lay')` into `Dl ax0 lay'`.  `swapPos` and `KIL.swapMid` are `POp`s.
* `Dl_layA`: for the standard layout `layA ax` of an axis order `ax`, `Dl` is an ordinary pull
  onto `ax.map tz`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFU

open AModel AModelL12

/-! ## Position permutations -/

/-! ### `swapPos` -/

/-! ### `swapMid` -/

/-! ## Layouts -/

/-! ## The standard layout -/

section Std

variable (mz : ℕ → ℕ) (bg : ℕ → Bool)

theorem layA_cons (j : ℕ) (L : List ℕ) : layA bg (j :: L) = atm bg j ++ layA bg L := by
  simp [layA]

theorem layA_append (L M : List ℕ) : layA bg (L ++ M) = layA bg L ++ layA bg M := by
  simp [layA]

theorem vol_atm (j : ℕ) : vol ((atm bg j).map (asz mz)) = tz mz bg j := by
  unfold atm tz asz; split_ifs <;> simp [vol] <;> omega

theorem vol_layA : ∀ (L : List ℕ), vol ((layA bg L).map (asz mz)) = vol (L.map (tz mz bg))
  | [] => by simp [layA, vol]
  | j :: L => by
    rw [layA_cons, List.map_append, vol_append, vol_atm, vol_layA L]; simp

/-- **`Dl` in a standard layout is an ordinary pull.** -/
theorem Dl_layA {α : Type*} (ax0 ax : List ℕ) (hnd : ax.Nodup) (hmz : ∀ j ∈ ax, 1 ≤ mz j)
    (F : List ℕ → List ℕ) (hF : ∀ b, srcF bg ax0 (layA bg ax) b = F (ax.map (dig bg (layA bg ax) b)))
    (xs : List α) (d : α) :
    Dl mz bg ax0 (layA bg ax) xs d = pull (ax0.map (tz mz bg)) (ax.map (tz mz bg)) F d xs := by
  unfold Dl
  apply List.ext_getElem (by simp [vol_layA])
  intro j h1 h2
  simp only [length_pull] at h1
  have hv := valid_decode h1
  obtain ⟨hv1, he⟩ := enc_layA mz bg ax hnd hmz _ hv
  rw [encode_decode h1] at he
  have hd : decode (ax.map (tz mz bg)) j =
      ax.map (dig bg (layA bg ax) (decode ((layA bg ax).map (asz mz)) j)) := by
    conv_lhs => rw [← he]
    exact decode_encode hv1
  rw [getElem_pull, getElem_pull, hF, hd]

theorem Dl_rev {α : Type*} (L : List ℕ) (cid : ℕ) (hnd : (L ++ [cid]).Nodup)
    (hmz : ∀ j ∈ L ++ [cid], 1 ≤ mz j) (xs : List α) (d : α) :
    Dl mz bg (L ++ [cid]) (layA bg (L.reverse ++ [cid])) xs d =
      pull ((L ++ [cid]).map (tz mz bg)) ((L.reverse ++ [cid]).map (tz mz bg)) (revH L.length) d xs := by
  apply Dl_layA mz bg _ _ ?_ (fun j hj => hmz j (by simp at hj ⊢; tauto))
  · intro b
    simp only [srcF, List.map_append, List.map_reverse, revH, List.map_cons, List.map_nil]
    rw [List.take_append_of_le_length (by simp), List.take_of_length_le (by simp),
      List.drop_append_of_le_length (by simp), List.drop_of_length_le (by simp)]
    simp
  · rw [List.nodup_append] at hnd ⊢
    exact ⟨List.nodup_reverse.2 hnd.1, hnd.2.1, fun a ha b hb => hnd.2.2 a (List.mem_reverse.1 ha) b hb⟩

end Std

end NLogN.KFU

