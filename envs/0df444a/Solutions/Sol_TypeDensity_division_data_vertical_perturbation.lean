theorem solution (O R : Type) [CommRing O] [CommRing R] [Algebra O R]
    (n : ℕ) (pi : O) (f : R) (b : Fin n → R) (E : R ≃ₗ[O] ((Fin n → O) × R))
    (hE : ∀ w, E.symm w = TypeDensity.divisionMap f b w) [IsAdicComplete (Ideal.span {pi}) ((Fin n → O) × R)]
    (h : R) :
    ∃ E' : R ≃ₗ[O] ((Fin n → O) × R), ∀ w, E'.symm w = TypeDensity.divisionMap (f + pi • h) b w := by
  set M := (Fin n → O) × R
  let r0 : M →ₗ[O] M := E.toLinearMap ∘ₗ (LinearMap.mulRight O h) ∘ₗ LinearMap.snd O (Fin n → O) R
  let rL : M →ₗ[O] M := pi • r0
  have hr : TypeDensity.RaisesAdicOrder (Ideal.span {pi}) (rL : M → M) := by
    intro j x y hxy
    have h1 := TypeDensity.linear_map_preserves_adic_congruence O M M (Ideal.span {pi}) r0 j x y hxy
    unfold TypeDensity.adicCongr at h1 ⊢
    have : rL x - rL y = pi • (r0 x - r0 y) := by
      simp [rL, smul_sub]
    rw [this, pow_succ', Submodule.mul_smul]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self pi) h1
  have hbij := TypeDensity.adic_perturb_bijective O M (Ideal.span {pi}) (rL : M → M) hr
  let L : M →ₗ[O] R := E.symm.toLinearMap ∘ₗ (LinearMap.id + rL)
  have hL : ∀ w, L w = TypeDensity.divisionMap (f + pi • h) b w := by
    intro w
    simp only [L, rL, r0, LinearMap.comp_apply, LinearMap.add_apply, LinearMap.id_apply,
      LinearMap.smul_apply, LinearEquiv.coe_coe, map_add, map_smul, LinearEquiv.symm_apply_apply,
      LinearMap.mulRight_apply]
    rw [hE]
    unfold TypeDensity.divisionMap
    rw [add_mul, smul_mul_assoc, mul_comm h]
    abel
  have hLb : Function.Bijective L := by
    have : (L : M → R) = E.symm ∘ TypeDensity.adicPerturb (rL : M → M) := by
      funext w; simp [L, TypeDensity.adicPerturb]
    rw [this]
    exact E.symm.bijective.comp hbij
