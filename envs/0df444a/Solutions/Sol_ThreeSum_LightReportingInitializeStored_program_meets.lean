    exact hmetaPtr
  have hmetaNZ : μ (((catalogs : ℤ)+4).toNat)=(LightReportingPrefixCatalog.count h 0 : ℤ) := by
    rw [show ((catalogs : ℤ)+4).toNat=catalogs+4 by omega]
    exact hmetaN
  apply Meets.of_body (p := 37) (by rfl : program[37]?=some (body 36))
  unfold body time
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (groupSize h : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hgroup,
                hgroupZ, LightReportingInitialize.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hgroup, hgroupZ, LightReportingInitialize.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hgroup, hgroupZ,
                LightReportingInitialize.time] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (D.t : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hmetaT,
                hres, LightReportingInitialize.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hmetaT, hres, LightReportingInitialize.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hmetaT, hres,
                LightReportingInitialize.time] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (D.boxCut : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
