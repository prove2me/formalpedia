open MeasureTheory Set Metric
open QEC QEC.Locality
open QEC Semantics Coding PauliSymplectic
open Coding.StabilizerCode
open Coding.StabilizerCode.BinaryStabilizerPresentation
universe u v
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable {κ : Type v} [Fintype κ]
attribute [local instance] QEC.Locality.instClassicalDecidableDGeK
namespace QEC.Locality
theorem _root_.solution
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (threshold w ell : ℝ)
    (t : GridTranslation w) :
    ((daiLiDGeKSeparator P embedding threshold w ell t).card : ℝ) ≤
      (vertexBadCount w (2 * ell) embedding.point t : ℝ) +
        2 * (edgeBadCount w (2 * ell)
          (P.daiLiLongIncidencePoint embedding threshold) t : ℝ) := by
  classical
  let vertices := gridVertexBufferQubits embedding w ell t
  let crossing := daiLiDGeKCrossingEndpoints P embedding threshold w ell t
  have hUnion : (vertices ∪ crossing).card ≤ vertices.card + crossing.card :=
    Finset.card_union_le _ _
  have hCrossing : crossing.card ≤ 2 * edgeBadCount w (2 * ell)
      (P.daiLiLongIncidencePoint embedding threshold) t := by
    simpa [crossing] using card_daiLiDGeKCrossingEndpoints_le_two_mul_edgeBadCount
      P embedding threshold w ell t
  change ((vertices ∪ crossing).card : ℝ) ≤ _
  have hUnionReal : ((vertices ∪ crossing).card : ℝ) ≤
      (vertices.card : ℝ) + (crossing.card : ℝ) := by
    exact_mod_cast hUnion
  have hVertex : (vertices.card : ℝ) =
      (vertexBadCount w (2 * ell) embedding.point t : ℝ) := by
    rfl
  have hCrossingReal : (crossing.card : ℝ) ≤
      2 * (edgeBadCount w (2 * ell)
        (P.daiLiLongIncidencePoint embedding threshold) t : ℝ) := by
    exact_mod_cast hCrossing
  rw [hVertex] at hUnionReal
  linarith
end QEC.Locality
