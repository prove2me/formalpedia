theorem exists_d_eq_and_equiv_of_rePair
    {r N : ℕ} {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    {A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})}
    {B : Type} [CommRing B] [Algebra 𝒪 B] {ψ : Onr →ₐ[𝒪] B} {E : FakeEllipticCurve Λ N B}
    (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (d' : ℕ)
    (γ : ρ.Eb.A ⟶ ρ.Ab.A) (ψ' : ρ.Ab.A ⟶ ρ.Eb.A) (hγf : γ ≫ ρ.Ab.f = ρ.Eb.f)
    (hpair : FakeEllipticCurve.IsIsogenyPair (r ^ d') ρ.Eb ρ.Ab γ ψ')
    (hlev : FakeEllipticCurve.PreservesLevel ρ.Eb ρ.Ab γ hγf)
    (i j : ℕ)
    (hsim : γ ≫ ρ.Ab.act ⟨(((r ^ i : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j : ℕ) : ℤ) : ℚ), hΛℤ _⟩) :
    ∃ ρ' : FakeEllipticCurve.Rigidification r π A₀ ψ E,
      ρ'.d = d' ∧ FakeEllipticCurve.Rigidification.Equiv hΛℤ ρ ρ' := by
  refine ⟨{ ρ with d := d', φ := γ, φ' := ψ', φ_over := hγf, isIsogenyPair := hpair, preservesLevel := hlev }, rfl, ?_⟩
  refine ⟨𝟙 _, 𝟙 _, ⟨?_, ?_, ?_, ?_⟩, j, i, ?_⟩
  · exact FakeEllipticCurve.isPullbackVia_id _ ρ.Eb
  · exact Category.id_comp _
  · exact FakeEllipticCurve.isPullbackVia_id _ ρ.Ab
  · exact Category.id_comp _
  · show 𝟙 _ ≫ ρ.φ ≫ _ = γ ≫ 𝟙 _ ≫ _
    rw [Category.id_comp, Category.id_comp]
    exact hsim.symm

end RignAsm

