  obtain ⟨o1, c1⟩ := NLogN.AX.sapR_okc M mm Φ Bacc hM p s t α st x R H.hs H.hst hx.1 hC hI
    (fun z hz => ⟨(hx.2 z hz).1.trans H.hBi, (hx.2 z hz).2.trans H.hBi⟩) H.hW H.hAcc H.hmB
    H.hLB H.hpB H.hnB H.htB
  obtain ⟨LT, hLT⟩ := hC.2.2.2.2.1
  set st1 := st.upd NLogN.AX.aI (NLogN.gints (sapL p s t α x) ++ R) with hst1
  have hyB : NLogN.GL.GB Q (sapL p s t α x) := (NLogN.AX.sapL_GB p s t α Bi Bo H.hc x hx.2).mono H.hBo
  obtain ⟨r2, o2, c2⟩ := NLogN.GL.xferG M NLogN.AX.aI NLogN.AX.aO NLogN.AX.aT st1 (sapL p s t α x) R LT Q t (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by simp [hst1]) (NLogN.BD.sapL_length p s t α x) (by simp (config := {decide := true}) [hst1, hLT]) H.htQ hyB
  refine ⟨?_, ⟨o1, ?_⟩, ?_⟩
  · show (NLogN.GL.xferP NLogN.AX.aI NLogN.AX.aO (NLogN.GL.cnt2 NLogN.AX.aT)).run ((NLogN.RM.ren NLogN.AX.σS NLogN.Rsp.sapP).run st) = _
    rw [r1, r2]
    apply NLogN.IState.ext' _ (by simp [hst1]) (by simp [hst1])
    intro j
    by_cases j1 : j = NLogN.AX.aO
    · subst j1; simp (config := {decide := true}) [hst1]
    by_cases j2 : j = NLogN.AX.aI
    · subst j2; simp (config := {decide := true}) [hst1]
    simp [hst1, j1, j2]
  · rw [r1]; exact o2
  · show (NLogN.RM.ren NLogN.AX.σS NLogN.Rsp.sapP).cost M st + (NLogN.GL.xferP NLogN.AX.aI NLogN.AX.aO (NLogN.GL.cnt2 NLogN.AX.aT)).cost M ((NLogN.RM.ren NLogN.AX.σS NLogN.Rsp.sapP).run st) ≤ _
