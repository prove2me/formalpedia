theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) (r : ℕ) (a : Fin (Φ.natDegree * r) → O)
    (hδ : 0 < Φ.natDegree)
    (B : Fin Φ.natDegree → Polynomial (AdjoinRoot Φ)) (hB : ∀ i, (B i).Monic)
    (hBr : ∀ i, (B i).map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ i ^ r)
    (hBp : ∏ i, B i = (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ)) :
    ∀ i : Fin Φ.natDegree, B i = (B ⟨0, hδ⟩).map (TypeDensity.frobeniusIter O Φ i).toRingHom := by
  intro i
  obtain ⟨_, _, -, hmax, -, hcomp, -, -⟩ := TypeDensity.unramified_is_dvr O Φ hΦ
  have hcop := (TypeDensity.conjugate_roots_distinct O Φ hΦ).2.2.2.2.2
  set τ := TypeDensity.frobeniusIter O Φ (i : ℕ)
  set F' := (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ) with hF'
  set D := (B ⟨0, hδ⟩).map τ.toRingHom with hD
  have hτF : F'.map τ.toRingHom = F' := by
    rw [hF', Polynomial.map_map]
    congr 1
    ext x
    simp [← AdjoinRoot.algebraMap_eq]
  have hDred : D.map (TypeDensity.baseReduce O Φ) = TypeDensity.conjugateFactor O Φ i ^ r :=
    TypeDensity.map_frobeniusIter_baseReduce O Φ hΦ r i _ (hBr _)
  have hprod1 : B i * ∏ j ∈ Finset.univ.erase i, B j = F' := by
    rw [Finset.mul_prod_erase _ _ (Finset.mem_univ i), hBp]
  have hprod2 : D * ∏ j ∈ Finset.univ.erase ⟨0, hδ⟩, (B j).map τ.toRingHom = F' := by
    rw [hD, Finset.mul_prod_erase (f := fun j => (B j).map τ.toRingHom) _ (Finset.mem_univ _),
      ← Polynomial.map_prod, hBp, hτF]
  have hc0 : IsCoprime ((B i).map (TypeDensity.baseReduce O Φ))
      ((∏ j ∈ Finset.univ.erase i, B j).map (TypeDensity.baseReduce O Φ)) := by
    rw [Polynomial.map_prod, hBr]
    exact IsCoprime.prod_right fun j hj => by
      rw [hBr]; exact (hcop i j (Finset.ne_of_mem_erase hj).symm).pow
  exact (TypeDensity.hensel_factor_unique_of_dvd (AdjoinRoot Φ) _ _ _ _ (hB i)
    (Polynomial.monic_prod_of_monic _ _ fun j _ => hB j) ((hB _).map _)
    (Polynomial.monic_prod_of_monic _ _ fun j _ => (hB j).map _) (hprod1.trans hprod2.symm)
    (TypeDensity.map_residue_eq_of_map_baseReduce_eq hmax (by rw [hBr, hDred]))
    (TypeDensity.isCoprime_map_residue hmax hc0)).1
