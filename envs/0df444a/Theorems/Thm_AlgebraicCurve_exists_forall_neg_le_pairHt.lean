open AlgebraicCurve

theorem AlgebraicCurve.exists_forall_neg_le_pairHt {F : Type} [Field F] [Algebra (AlgebraicClosure ℚ) F]
    {r : ℕ} (s : Fin r → F) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v w : Place (AlgebraicClosure ℚ) F, -C ≤ pairHt s v w := by sorry
