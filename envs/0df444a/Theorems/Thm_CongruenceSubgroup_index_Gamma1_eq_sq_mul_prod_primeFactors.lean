-- url     : https://prove2.me/theorems/3b0957dd-3416-438b-9f1b-8873325ad7af
-- title:
--   Index of $\Gamma_1(M)$ in $\mathrm{SL}_2(\mathbb{Z})$: $[\mathrm{SL}_2(\mathbb{Z}) : \Gamma_1(M)] = M^2 \prod_{p \mid M} (1 - p^{-2}) = \psi(M)\varphi(M)$
-- statement:
--   Let $M \ge 1$ be an integer and let
--
--   $$\Gamma_1(M) = \left\{ \begin{pmatrix} a & b \\ c & d \end{pmatrix} \in \mathrm{SL}_2(\mathbb{Z}) : a \equiv d \equiv 1,\ c \equiv 0 \pmod M \right\}.$$
--
--   Then the index of $\Gamma_1(M)$ in $\mathrm{SL}_2(\mathbb{Z})$ is
--
--   $$[\mathrm{SL}_2(\mathbb{Z}) : \Gamma_1(M)] = M^2 \prod_{p \mid M} \Bigl(1 - \frac{1}{p^2}\Bigr) = \psi(M)\,\varphi(M),$$
--
--   where the product runs over the primes $p$ dividing $M$, $\psi(M) = M \prod_{p \mid M} (1 + 1/p)$ is the Dedekind psi function and $\varphi$ is Euler's totient function. Moreover, if $M \ge 3$, the subgroup $\pm\Gamma_1(M)$ of $\mathrm{SL}_2(\mathbb{Z})$ generated by $\Gamma_1(M)$ and $-I$ has index
--
--   $$[\mathrm{SL}_2(\mathbb{Z}) : \pm\Gamma_1(M)] = \frac{M^2}{2} \prod_{p \mid M} \Bigl(1 - \frac{1}{p^2}\Bigr).$$
--
--   For example, the index of $\Gamma_1(M)$ is $1, 3, 8, 12, 24, 24$ for $M = 1, \dots, 6$, and that of $\pm\Gamma_1(M)$ is $4, 6, 12, 12$ for $M = 3, 4, 5, 6$. For $M \le 2$ one has $-I \in \Gamma_1(M)$, so the second formula needs $M \ge 3$. The number $[\mathrm{SL}_2(\mathbb{Z}) : \Gamma_1(M)]$ is also the number of vectors of exact order $M$ in $(\mathbb{Z}/M\mathbb{Z})^2$, since $\Gamma_1(M)$ is the stabilizer of $(1, 0)^{T}$ for the action of $\mathrm{SL}_2(\mathbb{Z})$ on column vectors mod $M$.
--
--   Role: $[\mathrm{SL}_2(\mathbb{Z}) : \pm\Gamma_1(M)]$ enters the leading term $\frac{k-1}{12}[\mathrm{SL}_2(\mathbb{Z}) : \pm\Gamma_1(M)]$ of the dimension formula for $S_k(\Gamma_1(M))$ and the scalar (identity) term of the Eichler-Selberg trace formula for Hecke operators on $\Gamma_1(M)$, and $[\mathrm{SL}_2(\mathbb{Z}) : \pm\Gamma_1(M)]\cdot\pi/3$ is the hyperbolic area of the modular curve $Y_1(M)$.
--
--   **Formalization Note**: $\Gamma_1(M)$ is Mathlib's `CongruenceSubgroup.Gamma1 M`, a subgroup of `SL(2, ℤ)`, and `Subgroup.index` is the index (a natural number, cast to $\mathbb{Q}$ here). $\pm\Gamma_1(M)$ is written `CongruenceSubgroup.Gamma1 M ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))`. `M.primeFactors` is the finite set of primes dividing $M$ and `M.totient` is $\varphi(M)$. The hypothesis `[NeZero M]` means $M \ne 0$.
-- source:
--   F. Diamond, J. Shurman, A First Course in Modular Forms, GTM 228, Springer 2005, Section 1.2 (index formulas for Gamma_0(N), Gamma_1(N), Gamma(N)) and Section 3.9 (dimension formulas)

import Mathlib

set_option autoImplicit false

open scoped MatrixGroups

theorem CongruenceSubgroup.index_Gamma1_eq_sq_mul_prod_primeFactors (M : ℕ) [NeZero M] :
    ((CongruenceSubgroup.Gamma1 M).index : ℚ) =
        (M : ℚ) ^ 2 * ∏ p ∈ M.primeFactors, (1 - 1 / (p : ℚ) ^ 2) ∧
      ((CongruenceSubgroup.Gamma1 M).index : ℚ) =
        ((M : ℚ) * ∏ p ∈ M.primeFactors, (1 + 1 / (p : ℚ))) * (M.totient : ℚ) ∧
      (3 ≤ M → ((CongruenceSubgroup.Gamma1 M ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))).index : ℚ) =
        (M : ℚ) ^ 2 / 2 * ∏ p ∈ M.primeFactors, (1 - 1 / (p : ℚ) ^ 2)) := by
  sorry
