theorem _root_.solution {n : ℕ} (hn : 1 ≤ n) (i : Fin n) :
    i = leftIndex (m := 1) (n := n) hn 0 ∨
      ∃ j : Fin (n - 1), i = rightIndex (m := 1) (n := n) hn j := by
  by_cases hi : i.1 = 0
  · left
    apply Fin.eq_of_val_eq
    simpa [leftIndex] using hi
  · right
    refine ⟨⟨i.1 - 1, by omega⟩, ?_⟩
    apply Fin.eq_of_val_eq
    simp [rightIndex]
    omega
end OpenQuantumProblem35
