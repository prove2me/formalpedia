    LanglandsTunnell.Converse.exists_isAdmissibleTwist_eq_formalBaseChange_b_of_isArithGenuineCuspRealizable
      ↥(LanglandsTunnell.fixFld (LanglandsTunnell.sylowH e)) Φ hΦ SQ₀ hb ha

