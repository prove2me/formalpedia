theorem ValuationSubring.mem_of_pow_eq_one' {K : Type*} [Field K] (V : ValuationSubring K) {x : K} {n : ℕ} (hn : n ≠ 0)
    (hx : x ^ n = 1) : x ∈ V := by
  rcases le_or_gt (V.valuation x) 1 with h | h
  · exact (V.valuation_le_one_iff x).mp h
  · exfalso
    have h1 : 1 < (V.valuation x) ^ n := one_lt_pow₀ h hn
    rw [← map_pow, hx, map_one] at h1
    exact lt_irrefl _ h1

