  isOpen := isOpen_domJ
  smooth i j := by
    intro p hp
    have hr : p.2 1 ≠ 0 := domRN_r hp
    refine ContDiffAt.contDiffWithinAt ?_
    fin_cases i <;> fin_cases j <;> simp only [gRN] <;>
      fun_prop (disch := first | assumption | exact pow_ne_zero _ hr)
  smooth_F i j := by
    intro p hp
    have hr : p.2 1 ≠ 0 := domRN_r hp
    refine ContDiffAt.contDiffWithinAt ?_
    fin_cases i <;> fin_cases j <;> simp only [faradayRN] <;>
      fun_prop (disch := first | assumption | exact pow_ne_zero _ hr)
  inv p hp := EF.inv_mul _ _ hp

/-! ## Genuine tangents -/

theorem isTangent_param (M Q m q : ℝ) :
    IsTangent (fun ε => gRN (M + ε * m) ((Q + ε * q) ^ 2)) (fun ε => faradayRN (Q + ε * q)) domJ
