/-
Reduction of `BurauFaithful.burau_three_kernel_word_criterion` (Theorem 4.1 for three strands)
to two children, following Birman, *Braids, Links, and Mapping Class Groups*, Ann. of Math.
Studies 82, 1974, §3.3, Theorem 3.15, pp. 129--130:

* `burau_three_spec_kernel`  -- the kernel of the $t = -1$ specialization of $\rho_3$ is the
  cyclic subgroup generated by $\Delta^4 = (\sigma_1\sigma_2)^6$ (Birman's step "setting $t=-1$
  the matrices generate the homogeneous modular group $M_2$, so the only possible relators arise
  from the braid relation and the relation $(s_1s_2s_1)^4 = 1$");
* `burau_three_fullTwist_sq_infinite_order` -- the image of $\Delta^4$ has infinite order
  ("a calculation shows that the central element has infinite order").
-/
import Definitions.Def_BurauFaithful_UnreducedBurau
import Theorems.Thm_BurauFaithful_burau_three_spec_kernel
import Theorems.Thm_BurauFaithful_burau_three_fullTwist_sq_infinite_order

set_option autoImplicit false

namespace BurauFaithful

open BraidsLinksMCG

/-- The single Artin relation `σ₁σ₂σ₁(σ₂σ₁σ₂)⁻¹` of `B₃`, as a word in the free group on the
generators `σ₁`, `σ₂`. -/
def braidRel3Aux : FreeGroup (Fin 2) :=
  FreeGroup.of (0 : Fin 2) * FreeGroup.of (1 : Fin 2) * FreeGroup.of (0 : Fin 2) *
    (FreeGroup.of (1 : Fin 2) * FreeGroup.of (0 : Fin 2) * FreeGroup.of (1 : Fin 2))⁻¹

/-- On two generators there is no commuting relation: the only pair of indices has distance `1`. -/
lemma braidRels_three_eq_singleton :
    braidRels 3 = {r | ∃ i j : Fin 2, (j : ℕ) = (i : ℕ) + 1 ∧
      r = FreeGroup.of i * FreeGroup.of j * FreeGroup.of i *
            (FreeGroup.of j * FreeGroup.of i * FreeGroup.of j)⁻¹} := by
  ext r
  simp only [braidRels, Set.mem_union, Set.mem_setOf_eq]
  constructor
  · rintro (⟨i, j, h, rfl⟩ | h)
    · exfalso
      have hi : (i : ℕ) < 2 := i.isLt
      have hj : (j : ℕ) < 2 := j.isLt
      omega
    · exact h
  · exact Or.inr

lemma braidRels_three_subset :
    braidRels 3 ⊆ ({braidRel3Aux} : Set (FreeGroup (Fin 2))) := by
  intro r hr
  rw [braidRels_three_eq_singleton] at hr
  obtain ⟨i, j, hij, rfl⟩ := hr
  have hi : (i : ℕ) < 2 := i.isLt
  have hj : (j : ℕ) < 2 := j.isLt
  have hi0 : (i : ℕ) = 0 := by omega
  have hj1 : (j : ℕ) = 1 := by omega
  have hieq : i = (0 : Fin 2) := Fin.ext hi0
  have hjeq : j = (1 : Fin 2) := Fin.ext hj1
  subst hieq; subst hjeq
  simp [braidRel3Aux]

lemma singleton_subset_braidRels_three :
    ({braidRel3Aux} : Set (FreeGroup (Fin 2))) ⊆ braidRels 3 := by
  intro r hr
  rw [Set.mem_singleton_iff] at hr
  subst hr
  rw [braidRels_three_eq_singleton]
  exact ⟨0, 1, rfl, rfl⟩

/-- `B₃` is the presented group `⟨σ₁, σ₂ | σ₁σ₂σ₁ = σ₂σ₁σ₂⟩`: the normal closure of Artin's
relations on three strands is the normal closure of the single braid relation. -/
lemma normalClosure_braidRels_three :
    Subgroup.normalClosure (braidRels 3) =
      Subgroup.normalClosure ({braidRel3Aux} : Set (FreeGroup (Fin 2))) :=
  le_antisymm
    (Subgroup.normalClosure_le_normal fun _ hx =>
      Subgroup.subset_normalClosure (braidRels_three_subset hx))
    (Subgroup.normalClosure_le_normal fun _ hx =>
      Subgroup.subset_normalClosure (singleton_subset_braidRels_three hx))

end BurauFaithful

/-- **Theorem 3.15 of Birman (Theorem 4.1 for three strands, word form).** A word in the free
group on `σ₁, σ₂` dies under the unreduced Burau representation `ρ₃` if and only if it lies in
the normal closure of the single braid relation, i.e. if and only if it represents the trivial
braid. -/
theorem solution (w : FreeGroup (Fin 2)) :
    BurauFaithful.burauRep 3 (PresentedGroup.mk (BraidsLinksMCG.braidRels 3) w) = 1 ↔
      w ∈ Subgroup.normalClosure ({BurauFaithful.braidRel3Aux} : Set (FreeGroup (Fin 2))) := by
  constructor
  · intro h
    have hφ : Matrix.GeneralLinearGroup.map (LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ))
        (BurauFaithful.burauRep 3 (PresentedGroup.mk (BraidsLinksMCG.braidRels 3) w)) = 1 := by
      rw [h]
      simp
    obtain ⟨k, hk⟩ := (BurauFaithful.burau_three_spec_kernel _).mp hφ
    have h1 : (BurauFaithful.burauRep 3
        (BraidsLinksMCG.sigma ⟨0, by decide⟩ * BraidsLinksMCG.sigma ⟨1, by decide⟩)) ^
          (6 * k) = 1 := by
      rw [← map_zpow, ← hk]
      exact h
    have hk0 : k = 0 := BurauFaithful.burau_three_fullTwist_sq_infinite_order k h1
    have hmk : PresentedGroup.mk (BraidsLinksMCG.braidRels 3) w = 1 := by
      rw [hk, hk0, mul_zero, zpow_zero]
      rfl
    rw [← BurauFaithful.normalClosure_braidRels_three]
    exact PresentedGroup.mk_eq_one_iff.mp hmk
  · intro hw
    have hmem : w ∈ Subgroup.normalClosure (BraidsLinksMCG.braidRels 3) := by
      rwa [BurauFaithful.normalClosure_braidRels_three]
    have hone : PresentedGroup.mk (BraidsLinksMCG.braidRels 3) w =
        (1 : BraidsLinksMCG.ArtinBraidGroup 3) :=
      PresentedGroup.mk_eq_one_iff.mpr hmem
    rw [hone]
    exact map_one _
