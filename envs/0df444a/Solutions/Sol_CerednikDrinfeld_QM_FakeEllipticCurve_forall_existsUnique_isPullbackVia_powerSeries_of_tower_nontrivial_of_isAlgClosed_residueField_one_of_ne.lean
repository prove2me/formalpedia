namespace CompareAway

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
variable {O : Type} [CommRing O] [IsLocalRing O]
variable {E₀ : FakeEllipticCurve Λ 1 (ResidueField O)}

section BC
variable {B B' : Type} [CommRing B] [CommRing B'] {ρ : B →+* ResidueField O} {ρ' : B' →+* ResidueField O}

def bcE (f : B →+* B') (E : FakeEllipticCurve Λ 1 B) : FakeEllipticCurve Λ 1 B' :=
  Classical.choose (CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff f E)

def bcK (f : B →+* B') (E : FakeEllipticCurve Λ 1 B) : (bcE f E).A ⟶ E.A :=
  Classical.choose (Classical.choose_spec (CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff f E))

theorem bcK_spec (f : B →+* B') (E : FakeEllipticCurve Λ 1 B) :
    FakeEllipticCurve.IsPullbackVia f E (bcE f E) (bcK f E) ∧
      ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of B')) (P : SchemeHomOver t' (bcE f E).f),
        (∃ P₀ : T ⟶ E.C, P₀ ≫ E.lev = P.1 ≫ bcK f E) → FactorsThrough (bcE f E).lev P := by
  obtain ⟨hg, hmul, hact, hlev, hlev'⟩ :=
    Classical.choose_spec (Classical.choose_spec (CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff f E))
  exact ⟨⟨hg, hmul, hact, hlev⟩, hlev'⟩

theorem exists_basePoint (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) :
    ∃ g'' : E₀.A ⟶ (bcE f x.E).A, g'' ≫ bcK f x.E = x.g ∧
      g'' ≫ (bcE f x.E).f = E₀.f ≫ Spec.map (CommRingCat.ofHom ρ') ∧
      (∀ k : E₀.A ⟶ (bcE f x.E).A, k ≫ bcK f x.E = x.g →
        k ≫ (bcE f x.E).f = E₀.f ≫ Spec.map (CommRingCat.ofHom ρ') → k = g'') ∧
      FakeEllipticCurve.IsPullbackVia ρ' (bcE f x.E) E₀ g'' :=
  CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_comp_eq_and_isPullbackVia_of_comp_eq f ρ' ρ hf x.E
    (bcE f x.E) E₀ (bcK f x.E) (bcK_spec f x.E).1 (fun t' P => (bcK_spec f x.E).2 t' P) x.g x.hg

def Defm.bc (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) : Defm E₀ B' ρ' :=
  ⟨bcE f x.E, Classical.choose (exists_basePoint f hf x), (Classical.choose_spec (exists_basePoint f hf x)).2.2.2⟩

theorem Defm.bc_E (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) : (x.bc f hf).E = bcE f x.E := rfl

theorem Defm.bc_g_comp (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) : (x.bc f hf).g ≫ bcK f x.E = x.g :=
  (Classical.choose_spec (exists_basePoint f hf x)).1

theorem Defm.bc_g_unique (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) (k : E₀.A ⟶ (bcE f x.E).A)
    (hk : k ≫ bcK f x.E = x.g) (hk' : k ≫ (bcE f x.E).f = E₀.f ≫ Spec.map (CommRingCat.ofHom ρ')) : k = (x.bc f hf).g :=
  (Classical.choose_spec (exists_basePoint f hf x)).2.2.1 k hk hk'

theorem Defm.rel_bc (f : B →+* B') (hf : ρ'.comp f = ρ) (x : Defm E₀ B ρ) (y : Defm E₀ B' ρ')
    (k : y.E.A ⟶ x.E.A) (hk : FakeEllipticCurve.IsPullbackVia f x.E y.E k) (hgk : y.g ≫ k = x.g) :
    Defm.Rel y (x.bc f hf) := by
  obtain ⟨u, hu1, hu2, -, hu4⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_comp_eq_and_isPullbackVia_of_comp_eq
      f (RingHom.id B') f (RingHom.id_comp f) x.E (bcE f x.E) y.E (bcK f x.E) (bcK_spec f x.E).1
      (fun t' P => (bcK_spec f x.E).2 t' P) k hk
  refine ⟨u, hu4, ?_⟩
  apply Defm.bc_g_unique f hf x (y.g ≫ u)
  · rw [Category.assoc, hu1, hgk]
  · obtain ⟨sq, -, -, -⟩ := y.hg
    rw [Category.assoc, hu2, ← Category.assoc, sq.w, Category.assoc, CommRingCat.ofHom_id, Spec.map_id,
      Category.comp_id]

theorem Defm.bc_rel (f : B →+* B') (hf : ρ'.comp f = ρ) {x y : Defm E₀ B ρ} (r : Defm.Rel x y) :
    Defm.Rel (x.bc f hf) (y.bc f hf) := by
  obtain ⟨h, hh, hg⟩ := r
  refine Defm.rel_bc f hf y (x.bc f hf) (bcK f x.E ≫ h) ?_ ?_
  · have := FakeEllipticCurve.IsPullbackVia.comp (RingHom.id B) f y.E x.E (bcE f x.E) h (bcK f x.E) hh (bcK_spec f x.E).1
    first | simpa using this | (simp at this; exact this) | exact this
  · rw [← Category.assoc, Defm.bc_g_comp, hg]

theorem Defm.bc_id (x : Defm E₀ B ρ) : Defm.Rel (x.bc (RingHom.id B) (RingHom.comp_id ρ)) x :=
  (Defm.rel_bc (RingHom.id B) (RingHom.comp_id ρ) x x (𝟙 _) (isPullbackVia_id x.E) (Category.comp_id _)).symm

end BC
