section Lift

variable {J : Type} [AddCommGroup J]

open scoped Classical in

noncomputable def up (K : ℕ → AddSubgroup J) (hdiv : ∀ m, ∀ y ∈ K m, ∃ z ∈ K (m + 1), 2 • z = y)
    (m : ℕ) (x : J) : ℕ → J
  | 0 => x
  | k + 1 =>
    if h : up K hdiv m x k ∈ K (m + k) then Classical.choose (hdiv (m + k) (up K hdiv m x k) h)
    else 0

variable {K : ℕ → AddSubgroup J} {hdiv : ∀ m, ∀ y ∈ K m, ∃ z ∈ K (m + 1), 2 • z = y}

theorem up_zero (m : ℕ) (x : J) : up K hdiv m x 0 = x := by
  rw [up]

theorem up_mem {m : ℕ} {x : J} (hx : x ∈ K m) : ∀ k, up K hdiv m x k ∈ K (m + k)
  | 0 => by rw [up]; exact hx
  | k + 1 => by
    rw [up, dif_pos (up_mem hx k)]
    exact (Classical.choose_spec (hdiv (m + k) _ (up_mem hx k))).1

theorem two_nsmul_up_succ {m : ℕ} {x : J} (hx : x ∈ K m) (k : ℕ) :
    2 • up K hdiv m x (k + 1) = up K hdiv m x k := by
  rw [up, dif_pos (up_mem hx k)]
  exact (Classical.choose_spec (hdiv (m + k) _ (up_mem hx k))).2

noncomputable def seq (K : ℕ → AddSubgroup J) (hdiv : ∀ m, ∀ y ∈ K m, ∃ z ∈ K (m + 1), 2 • z = y)
    (m : ℕ) (x : J) (n : ℕ) : J :=
  if m ≤ n then up K hdiv m x (n - m) else 2 ^ (m - n) • x

theorem seq_of_le {m n : ℕ} (x : J) (h : m ≤ n) : seq K hdiv m x n = up K hdiv m x (n - m) :=
  if_pos h

theorem seq_of_lt {m n : ℕ} (x : J) (h : n < m) : seq K hdiv m x n = 2 ^ (m - n) • x :=
  if_neg (Nat.not_le.2 h)

theorem seq_self (m : ℕ) (x : J) : seq K hdiv m x m = x := by
  rw [seq_of_le x le_rfl, Nat.sub_self, up_zero]

theorem two_nsmul_seq_succ {m : ℕ} {x : J} (hx : x ∈ K m) (n : ℕ) :
    2 • seq K hdiv m x (n + 1) = seq K hdiv m x n := by
  rcases Nat.lt_or_ge n m with h | h
  · rcases Nat.lt_or_ge (n + 1) m with h1 | h1
    · rw [seq_of_lt x h1, seq_of_lt x h, smul_smul, ← pow_succ',
        show m - (n + 1) + 1 = m - n by omega]
    · rw [seq_of_le x h1, seq_of_lt x h, show n + 1 - m = 0 by omega, show m - n = 1 by omega,
        pow_one, up_zero]
  · rw [seq_of_le x (Nat.le_succ_of_le h), seq_of_le x h, show n + 1 - m = (n - m) + 1 by omega]
    exact two_nsmul_up_succ hx (n - m)

theorem pow_nsmul_seq (hK : ∀ n, ∀ y ∈ K n, 2 ^ n • y = 0) {m : ℕ} {x : J} (hx : x ∈ K m)
    (n : ℕ) : 2 ^ n • seq K hdiv m x n = 0 := by
  rcases Nat.lt_or_ge n m with h | h
  · rw [seq_of_lt x h, smul_smul, ← pow_add, show n + (m - n) = m by omega]
    exact hK m x hx
  · rw [seq_of_le x h]
    have hmem := up_mem (hdiv := hdiv) hx (n - m)
    rw [show m + (n - m) = n by omega] at hmem
    exact hK n _ hmem

theorem seq_mem (D : AddSubgroup J) (hKD : ∀ n, K n ≤ D) {m : ℕ} {x : J} (hx : x ∈ K m) (n : ℕ) :
    seq K hdiv m x n ∈ D := by
  rcases Nat.lt_or_ge n m with h | h
  · rw [seq_of_lt x h]
    exact D.nsmul_mem (hKD m hx) _
  · rw [seq_of_le x h]
    exact hKD _ (up_mem hx (n - m))

end Lift

section TateL

variable {J : Type} [AddCommGroup J] (D : AddSubgroup J)

theorem mem_L_iff {s : ℕ → J} :
    s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D) ↔
      (∀ n, ((2 ^ n : ℕ) : ℤ) • s n = 0 ∧ ((2 : ℕ) : ℤ) • s (n + 1) = s n) ∧ ∀ n, s n ∈ D :=
  ⟨fun h => ⟨h.1, fun n => h.2 n (Set.mem_univ n)⟩, fun h => ⟨h.1, fun n _ => h.2 n⟩⟩

theorem exists_eq_nsmul_of_apply_eq_zero {s : ℕ → J}
    (hs : s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) (m : ℕ) (h0 : s m = 0) :
    ∃ u ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D), s = 2 ^ m • u := by
  have hsL := (mem_L_iff D).1 hs
  let S : _root_.TateModule 2 J := ⟨s, hs.1⟩
  have hS0 : _root_.TateModule.proj 2 J m S = 0 := h0
  refine ⟨fun n => s (n + m), (mem_L_iff D).2 ⟨fun n => ?_, fun n => hsL.2 (n + m)⟩, ?_⟩
  · exact (_root_.TateModule.shiftOfProjEqZero m S hS0).2 n
  · funext n
    rw [Pi.smul_apply, ← natCast_zsmul]
    exact (_root_.TateModule.compat_pow S n m).symm

theorem map_eq_zero_of_apply_eq_zero {Q : Type*} [AddCommGroup Q] {m : ℕ}
    (hQ : ∀ q : Q, 2 ^ m • q = 0)
    (Φ : ↥(_root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) →+ Q)
    (s : ↥(_root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)))
    (h0 : (s : ℕ → J) m = 0) : Φ s = 0 := by
  obtain ⟨u, hu, e⟩ := exists_eq_nsmul_of_apply_eq_zero D s.2 m h0
  have hsu : s = 2 ^ m • (⟨u, hu⟩ : ↥(_root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D))) :=
    Subtype.ext e
  rw [hsu, map_nsmul, hQ]

theorem pow_nsmul_apply_eq_zero {s : ℕ → J}
    (hs : s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) (m : ℕ) :
    2 ^ m • s m = 0 := by
  have h := ((mem_L_iff D).1 hs).1 m
  rw [natCast_zsmul] at h
  exact h.1

end TateL

section Alg

theorem pow_nsmul_quotient_eq_zero {R : Type*} [CommRing R] (m : ℕ)
    (q : R ⧸ Ideal.span {((2 : ℕ) : R) ^ m}) : 2 ^ m • q = 0 := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [← map_nsmul, nsmul_eq_mul, Ideal.Quotient.eq_zero_iff_mem, Nat.cast_pow]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

theorem eq_add_of_map_sub_sub_eq_zero {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    (f : A →+ B) {a b c : A} (h : f (a - b - c) = 0) : f a = f b + f c := by
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

theorem eq_of_map_sub_eq_zero {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    (f : A →+ B) {a b : A} (h : f (a - b) = 0) : f a = f b := by
  rw [map_sub, sub_eq_zero] at h
  exact h

theorem natCard_ker_le_of_lift {Kt Lt Q J : Type*} [AddCommGroup Kt] [AddCommGroup Lt]
    [AddCommGroup Q] [AddCommGroup J]
    (Φ : Lt →+ Q) (ι : Kt →+ Q) (π : Lt →+ J) (emb : Kt → J) (sl : Kt → Lt) (c : ℤ)
    (hemb : Function.Injective emb) (hsl : ∀ x, π (sl x) = emb x)
    (hrange : ∀ s, ∃ x, emb x = π s) (hι : ∀ x, ι x = Φ (sl x))
    (hWD : ∀ s, π s = 0 → Φ s = 0) (hshift : ∀ s, π s = 0 → ∃ u, s = c • u)
    (htors : ∀ u, π (c • u) = 0) {b : ℕ}
    (hdef : Nat.card (↥Φ.ker ⧸ (zsmulAddGroupHom c).range.addSubgroupOf Φ.ker) ≤ b) :
    Nat.card ↥ι.ker ≤ b := by
  have hmemker : ∀ z : ↥ι.ker, sl (z : Kt) ∈ Φ.ker := fun z => by
    rw [AddMonoidHom.mem_ker, ← hι]
    exact (AddMonoidHom.mem_ker).1 z.2
  refine le_trans (le_of_eq ?_) hdef
  refine Nat.card_congr (Equiv.ofBijective
    (fun z : ↥ι.ker => (QuotientAddGroup.mk (⟨sl (z : Kt), hmemker z⟩ : ↥Φ.ker) :
      ↥Φ.ker ⧸ (zsmulAddGroupHom c).range.addSubgroupOf Φ.ker)) ⟨?_, ?_⟩)
  · intro z₁ z₂ h
    have h' := QuotientAddGroup.eq.1 h
    rw [AddSubgroup.mem_addSubgroupOf, AddMonoidHom.mem_range] at h'
    obtain ⟨u, hu⟩ := h'
    have hu' := congrArg π hu
    rw [zsmulAddGroupHom_apply, htors, AddSubgroup.coe_add, AddSubgroup.coe_neg, map_add, map_neg]
      at hu'
    change (0 : J) = -π (sl (z₁ : Kt)) + π (sl (z₂ : Kt)) at hu'
    rw [hsl, hsl] at hu'
    exact Subtype.ext (hemb (neg_add_eq_zero.1 hu'.symm))
  · intro q
    induction q using QuotientAddGroup.induction_on with
    | H z =>
      obtain ⟨x, hx⟩ := hrange (z : Lt)
      have hd : π (sl x - (z : Lt)) = 0 := by rw [map_sub, hsl, hx, sub_self]
      have hxker : x ∈ ι.ker := by
        rw [AddMonoidHom.mem_ker, hι]
        have h := hWD _ hd
        rw [map_sub, sub_eq_zero] at h
        rw [h]
        exact (AddMonoidHom.mem_ker).1 z.2
      refine ⟨⟨x, hxker⟩, QuotientAddGroup.eq.2 ?_⟩
      rw [AddSubgroup.mem_addSubgroupOf, AddMonoidHom.mem_range]
      have hd' : π (-(sl x) + (z : Lt)) = 0 := by rw [map_add, map_neg, hsl, hx, neg_add_cancel]
      obtain ⟨u, hu⟩ := hshift _ hd'
      refine ⟨u, ?_⟩
      rw [zsmulAddGroupHom_apply, ← hu]
      rfl

end Alg

