  hw := by simp [RS.writes, hXC.symm]
  h0 := by simp [← hX]
  hG := fun k => by simp [hXC.symm]
  step := by
    intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro x
    simp only [withCtr, RS.run_pop_G, IState.upd_G]
    by_cases h1 : x = X
    · subst h1; simp only [if_true, if_neg hXC]; rw [hd]; rfl
    · by_cases h2 : x = C
      · subst h2; simp [hXC.symm]
      · simp [h1, h2]

theorem popK_spec {X C : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56) (n : Ex HS)
    (hnc : n.Clean) (s : IState HS) (L : List ℤ) (R : List Item) (hX : s.G X = ints L ++ R)
    (hno : n.ok s) (hn : n.eval s = L.length) :
    (popK X C n).ok s ∧ (popK X C n).run s = s.upd X R := by
  have H := popK_states hXC n s L R hX hn
  refine ⟨H.ok hC5 hnc hno ?_, ?_⟩
  · intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    refine ⟨hX5, ?_⟩
    have e : (withCtr C s (n.eval s).toNat k (s.upd X (ints (L.drop k) ++ R))).G X =
        .int L[k] :: (ints (L.drop (k + 1)) ++ R) := by
      simp [withCtr, Ne.symm hXC, hXC]; rw [hd]; rfl
    exact IState.isInt_of e
  · rw [popK, H.run, hn, Int.toNat_natCast]; simp

theorem popK_cost {X C : Fin HS} (hXC : X ≠ C) (n : Ex HS) (s : IState HS) (L : List ℤ)
    (R : List Item) (hX : s.G X = ints L ++ R) (hn : n.eval s = L.length) (B : ℕ)
    (hL : ∀ y ∈ L, zsz y ≤ B) (hnl : n.Lin) (hnb : n.Bnd s B) :
    (popK X C n).cost s ≤ (n.size + 1) * 2000 * (B + 2) + L.length * (12000 * (B + 2)) + 32 := by
  have H := popK_states hXC n s L R hX hn
  have := H.cost_le_lin B (2 * B + 2) hnl hnb ?_
  · rw [hn, Int.toNat_natCast] at this
    have h2 : L.length * (2 * B + 2 + 8000 * (B + 2) + 30) ≤ L.length * (12000 * (B + 2)) :=
      Nat.mul_le_mul_left _ (by omega)
    rw [popK]; refine le_trans this ?_
    generalize (n.size + 1) * 2000 * (B + 2) = A at *
    omega
  intro k hk
  rw [hn, Int.toNat_natCast] at hk
  have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
  have := hL _ (List.getElem_mem hk)
  have e : (withCtr C s (n.eval s).toNat k (s.upd X (ints (L.drop k) ++ R))).G X =
      .int L[k] :: (ints (L.drop (k + 1)) ++ R) := by
    simp [withCtr, Ne.symm hXC, hXC]; rw [hd]; rfl
  simp only [RS.cost, IState.top, e]
  omega

end NLogN.Rsp

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.AX
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp
theorem solution (M : NLogN.MulSpec) (X r : Fin NLogN.HS) (st : NLogN.IState NLogN.HS) (L : List ℤ) (R : List NLogN.Item)
    (N B : ℕ) (hXC : X ≠ NLogN.GL.gCC) (hX : X.val < 56) (hr : r.val < 56)
    (hXs : st.G X = NLogN.ints L ++ R) (hN : ∃ LL, st.G r = .int (N : ℤ) :: LL) (hl : L.length = N)
    (hLB : ∀ y ∈ L, NLogN.zsz y ≤ B) (hNB : NLogN.zsz (N : ℤ) ≤ B) :
    (NLogN.RM.rs (NLogN.Rsp.popK X NLogN.GL.gCC (.reg r))).run st = st.upd X R ∧ (NLogN.RM.rs (NLogN.Rsp.popK X NLogN.GL.gCC (.reg r))).ok M st ∧
      (NLogN.RM.rs (NLogN.Rsp.popK X NLogN.GL.gCC (.reg r))).cost M st ≤ 2 * 2000 * (B + 2) + N * (12000 * (B + 2)) + 32 := by
  obtain ⟨LL, hLL⟩ := hN
  have ev : (NLogN.Ex.reg r).eval st = L.length := by simp [NLogN.Ex.eval, NLogN.IState.top_eq hLL, hl]
  obtain ⟨k, rr⟩ := NLogN.Rsp.popK_spec hXC hX (by decide) (.reg r) (NLogN.RS.clean_of_lt hr) st L R hXs
    (NLogN.IState.isInt_of hLL) ev
  have c := NLogN.Rsp.popK_cost hXC (.reg r) st L R hXs ev B hLB trivial
    (by show NLogN.zsz (st.top r) ≤ B; rw [NLogN.IState.top_eq hLL]; exact hNB)
  refine ⟨rr, k, ?_⟩
  show (NLogN.Rsp.popK X NLogN.GL.gCC (.reg r)).cost st ≤ _
  rw [hl] at c; simpa [NLogN.Ex.size] using c
end
