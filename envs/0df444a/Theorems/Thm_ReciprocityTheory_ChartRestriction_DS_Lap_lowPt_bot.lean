theorem ReciprocityTheory.ChartRestriction.DS.Lap.lowPt_bot {k r : ℕ} (u : Fin k → ℝ) (v : Fin (k - 1) → ℝ) (b : Fin (2 * r + 2) → ℝ)
    (i : ℕ) (hi : i < k) (hin : i < 2 * r + k + 1) :
    lowPt k r u v b i (parLam k r v b ⟨i, hin⟩) = walkPar k r u v b i := by sorry
