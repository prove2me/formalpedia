    triple a b c ∈ F4 x r ↔ c ∈ x ∧ ZFSet.pair a b ∈ r := by
  rw [mem_F4_iff]
  constructor
  · rintro ⟨a', b', c', hc', hab', h⟩
    rcases ZFSet.pair_inj.mp h with ⟨rfl, htail⟩
    rcases ZFSet.pair_inj.mp htail with ⟨rfl, rfl⟩
    exact ⟨hc', hab'⟩
  · rintro ⟨hc, hab⟩
    exact ⟨a, b, c, hc, hab, rfl⟩

