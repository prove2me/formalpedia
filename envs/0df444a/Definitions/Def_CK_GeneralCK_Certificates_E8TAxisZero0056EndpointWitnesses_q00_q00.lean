def centerBLowerYBox : DyadicInterval precision := ⟨8630623887700647639154697588699875069511870405407, 8630623887700647639154697588699875069511879777387⟩
def centerBLowerInput : Inputs precision :=
  ⟨centerBLowerAlpha, centerBLowerExp, centerBLowerLog, endpointLogTwo⟩
def centerBLowerExpWitness : ExpWitness precision :=
  ⟨83725694751933551945584007868802200292180059358, scale precision, 83725694751933551945584007868802200292180190431, scale precision,
    0, 1024, 0, 1024, ⟨-4179417923673203105430459703727753728630588597724, -4179417923673203105430459703727753728630588595606⟩, ⟨-4179417923673203105430459703727753728630586309746, -4179417923673203105430459703727753728630586307614⟩⟩

theorem centerBLower_primitive_checks :
    expBoxCheck ((ofInt precision (-2)).mul centerBLowerAlpha) centerBLowerExp centerBLowerExpWitness = true ∧
    logBoxCheck ((ofInt precision 1).add centerBLowerExp) centerBLowerLog fastLogWitness = true := by decide +kernel

theorem centerBLower_denominators : DenominatorsPositive centerBLowerInput := by
  unfold DenominatorsPositive
  decide +kernel

theorem centerBLower_yBox_eq : (yBox centerBLowerInput).d0 = centerBLowerYBox := by decide +kernel

theorem centerBLower_contains :
    centerBLowerYBox.Contains (Y (lower E8TAxisZero0056PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0056PaddedInputs.centerBInput.alpha = ((2089708961836601552715229851863876864315293726050 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
  have ha : centerBLowerInput.alpha.Contains (lower E8TAxisZero0056PaddedInputs.centerBInput.alpha) := by
    rw [e]; exact point_contains precision 2089708961836601552715229851863876864315293726050
  have h := checked_yBox_d0_contains (i := centerBLowerInput) (we := centerBLowerExpWitness)
    (wl := fastLogWitness) (wL := fastLogWitness)
    centerBLower_primitive_checks.1 centerBLower_primitive_checks.2 endpointLogTwo_checked
    centerBLower_denominators ha
  rw [centerBLower_yBox_eq] at h
  exact h

