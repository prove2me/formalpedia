set_option maxHeartbeats 2000000 in
theorem twA_run (n k j : ℕ) (s : IState HS) (L28 L29 L53 : List Item)
    (h28 : s.G 28 = .int n :: L28) (h29 : s.G 29 = .int k :: L29)
    (h53 : s.G 53 = .int j :: L53) : twA.run s = twAState n k j s := by
  simp (config := {decide := true}) only [twA, NLogN.RS.seqL, NLogN.RS.run_seq]
  apply IState.ext' _ (by simp [twAState]) (by simp [twAState])
  intro j'
  simp (config := {decide := true}) only [twAState, RS.run_push_G, IState.upd_G, Ex.eval,
    IState.top, h28, h29, h53, if_true, if_false, List.tail_cons, Ex.ediv_eval, Ex.emod_eval,
    aE_eval, qE, NLogN.rE, NLogN.cE, NLogN.tE, jkE, Int.toNat_natCast]
  all_goals (split_ifs <;> simp_all)

set_option maxHeartbeats 4000000 in
theorem twiddleP_cost0 (n k j : ℕ) (s : IState HS) (L28 L29 L53 : List Item)
    (h28 : s.G 28 = .int n :: L28) (h29 : s.G 29 = .int k :: L29)
    (h53 : s.G 53 = .int j :: L53) :
    twiddleP.cost s ≤ 10 ^ 12 * (twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) + 6) ^ 2 +
      (octExpCost n (zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ)) (zsz (k : ℤ)) +
      10 ^ 10 * (twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) + 2) ^ 2) := by
  have hA := twA_cost n k j s L28 L29 L53 h28 h29 h53
  simp only [twiddleP, NLogN.RS.seqL, RS.cost]
  rw [twA_run n k j s L28 L29 L53 h28 h29 h53]
  have i48 : (twAState n k j s).IsInt 48 := by
    simp (config := {decide := true}) [twAState, IState.IsInt, IState.top, IState.upd_G]
  have i49 : (twAState n k j s).IsInt 49 := by
    simp (config := {decide := true}) [twAState, IState.IsInt, IState.top, IState.upd_G]
  have i50 : (twAState n k j s).IsInt 50 := by
    simp (config := {decide := true}) [twAState, IState.IsInt, IState.top, IState.upd_G]
  have t48 : (twAState n k j s).top 48 = n := by
    simp (config := {decide := true}) only [twAState, IState.top, IState.upd_G, if_true, if_false]
  have t49 : (twAState n k j s).top 49 = k := by
    simp (config := {decide := true}) only [twAState, IState.top, IState.upd_G, if_true, if_false]
  have t50 : (twAState n k j s).top 50 = (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ) := by
    simp (config := {decide := true}) only [twAState, IState.top, IState.upd_G, if_true, if_false]
  have hO := octExpP_cost' (twAState n k j s) i48 (by rw [t48]; positivity) i49
    (by rw [t49]; positivity) i50 (by rw [t50]; positivity)
  rw [octExpP_run' (twAState n k j s) i48 (by rw [t48]; positivity) i49
    (by rw [t49]; positivity) i50 (by rw [t50]; positivity)]
  rw [t48, t49, t50, Int.toNat_natCast, Int.toNat_natCast, Int.toNat_natCast] at hO ⊢
  refine add_le_add hA (add_le_add hO ?_)
  obtain ⟨zn, zj, zk, zl8, zl4, zl2, zl1, zl3, zJ', zE', zQ', zR', zkjk', zkEk', zC1', zC'', z2Q', zQ1', zH', z4H', zT', zT1', zT2', zT3', zkR', zA', zX', zY', zYp', zRe', zIm'⟩ := tw_facts n k j
  generalize twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) = Bb at *
  apply twB_cost
  all_goals simp (config := {decide := true}) only [twAState, IState.top, IState.upd_G,
    if_true, if_false, zsz_neg]
  all_goals with_reducible assumption

