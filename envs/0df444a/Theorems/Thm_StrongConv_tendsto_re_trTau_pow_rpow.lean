theorem tendsto_re_trTau_pow_rpow {D d : ℕ} (P : NCPoly D d) :
    Tendsto (fun p : ℕ => (trTau ((star (P.eval (sLimit d)) * P.eval (sLimit d)) ^ p)).re ^
        (1 / (2 * (p : ℝ)))) atTop (𝓝 ‖P.eval (sLimit d)‖) := by
  sorry

end StrongConv
