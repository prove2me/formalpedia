theorem AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.comap_of_isOpenImmersion
    {X Y : Scheme.{u}} {I : X.IdealSheafData} (hI : I.IsInvertible) (j : Y ⟶ X) [IsOpenImmersion j] :
    (I.comap j).IsInvertible := by sorry
