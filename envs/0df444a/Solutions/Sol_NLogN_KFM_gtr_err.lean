theorem solution (p g : ℕ) (z : NLogN.KFB.GI) (X : ℂ) {e : ℝ} (h : ‖NLogN.KFM.vP (p + g) z - X‖ ≤ e) :
    ‖NLogN.KFM.vP p (NLogN.KFH.gtr g z) - X‖ ≤ e + 2 * (2 : ℝ)⁻¹ ^ p := by
  rw [NLogN.KFM.vP_gtr]
  have hq := Butterfly.norm_Qp_sub_lt p (NLogN.KFM.vP (p + g) z)
  have hs2 : Real.sqrt 2 ≤ 2 := by rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have hu : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ p := by positivity
  calc _ = ‖(Butterfly.Qp p (NLogN.KFM.vP (p + g) z) - NLogN.KFM.vP (p + g) z) + (NLogN.KFM.vP (p + g) z - X)‖ := by
        congr 1; ring
    _ ≤ _ := norm_add_le _ _
    _ ≤ _ := by nlinarith
