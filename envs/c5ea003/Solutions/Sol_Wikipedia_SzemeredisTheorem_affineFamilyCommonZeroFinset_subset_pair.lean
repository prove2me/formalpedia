    (p : ℕ) [NeZero p] (forms : κ → AffineForm ι ℤ)
    (s : Finset κ) (x : ι → ZMod p) :
    x ∈ affineFamilyCommonZeroFinset p forms s ↔
      ∀ q ∈ s, (forms q).evalZMod p x = 0 := by
  simp [affineFamilyCommonZeroFinset]

















