-- url     : https://prove2.me/theorems/942af295-9952-4c23-9ab8-ed06b6b5af81
-- title:
--   (3.20), p. 17 — E[⟨∇f_µ(x_k), Δ_k⟩ | ζ_[k−1]] = 0
-- statement:
--   Assume the standing assumptions of Section 3 with $L > 0$ and the sampling model of the RSGF method: fresh, mutually independent samples $\xi_k \sim P$ and standard Gaussian $u_k$. Let $\mu > 0$, let $x_1, x_2, \dots$ be a run of the method with arbitrary real stepsizes, and let $\Delta_k = G_\mu(x_k,\xi_k,u_k) - \nabla f_\mu(x_k)$. Then for every $k \ge 1$ the random variable $\langle \nabla f_\mu(x_k), \Delta_k\rangle$ is integrable and, almost surely,
--   $$
--   \mathbb E\big[\langle \nabla f_\mu(x_k), \Delta_k\rangle \,\big|\, \zeta_{[k-1]}\big] = 0,
--   $$
--   where $\zeta_{[k-1]} = (\xi_1,u_1,\dots,\xi_{k-1},u_{k-1})$.
--
--   The cross term in (3.19) therefore has zero expectation. The identity follows from the unbiasedness (3.14), because $x_k$ is determined by $\zeta_{[k-1]}$ and $\zeta_k$ is independent of it.
--
--   **Formalization Note** The conditional expectation is with respect to the $\sigma$-algebra generated by $\zeta_1,\dots,\zeta_{k-1}$. For $k = 1$ this is the trivial $\sigma$-algebra, so the claim is that the expectation vanishes. The smoothing parameter is `μs`.
-- source:
--   Ghadimi & Lan, arXiv:1309.5549v1, proof of Theorem 3.2, Eq. (3.20), p. 17

import Mathlib
import Definitions.Def_RandomGradFree_Shared_smoothing
import Definitions.Def_GhadimiLan_RSGF_Model
import Definitions.Def_GhadimiLan_RSGF_Method

open MeasureTheory ProbabilityTheory
open scoped InnerProductSpace

namespace GhadimiLan.RSGF

/-- Eq. (3.20), proof of Theorem 3.2 (Ghadimi & Lan, arXiv:1309.5549v1, p. 17). For a run of the
RSGF method under the standing assumptions of §3 and the sampling model (`IsSZOSampling`), with
`μs > 0` (the paper's `µ`), `f_µ` the Gaussian smoothing of `f = objective P F` and
`Δ_k = G_µ(x_k, ξ_k, u_k) − ∇f_µ(x_k)`, for every `k ≥ 1` the random variable
`⟨∇f_µ(x_k), Δ_k⟩` is integrable and `E[⟨∇f_µ(x_k), Δ_k⟩ | ζ_[k−1]] = 0` almost surely, where
`ζ_[k−1] = (ξ_1, u_1, …, ξ_{k−1}, u_{k−1})`. Arbitrary real stepsizes are allowed. -/
theorem eq_3_20 {n : ℕ} {Ω Ξ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ξ]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (P : Measure Ξ) [IsProbabilityMeasure P]
    (F : EuclideanSpace ℝ (Fin n) → Ξ → ℝ) (L σ μs : ℝ) (hL : 0 < L) (hσ : 0 ≤ σ) (hμs : 0 < μs)
    (hF : SZOAssumptions P F L σ) (γ : ℕ → ℝ)
    (ξ : ℕ → Ω → Ξ) (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (hs : IsSZOSampling μ P ξ u)
    (x1 : EuclideanSpace ℝ (Fin n)) (x : ℕ → Ω → EuclideanSpace ℝ (Fin n))
    (hx : IsRSGFRun F μs γ x1 ξ u x)
    (k : ℕ) (hk : 1 ≤ k) :
    Integrable (fun ω =>
        ⟪gradient (RandomGradFree.Shared.smoothing (objective P F) μs) (x k ω),
          szoGrad F μs (x k ω) (ξ k ω) (u k ω)
            - gradient (RandomGradFree.Shared.smoothing (objective P F) μs) (x k ω)⟫_ℝ) μ ∧
      condExp (zetaSigma ξ u (k - 1)) μ (fun ω =>
          ⟪gradient (RandomGradFree.Shared.smoothing (objective P F) μs) (x k ω),
            szoGrad F μs (x k ω) (ξ k ω) (u k ω)
              - gradient (RandomGradFree.Shared.smoothing (objective P F) μs) (x k ω)⟫_ℝ)
        =ᵐ[μ] 0 := by sorry

end GhadimiLan.RSGF
