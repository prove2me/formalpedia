/-!
# Chou §3, p. 399: the growth rate of a finitely generated group

Milnor's observation that `|B(n)|^{1/n}` converges, and Wolf's observation that exponential
growth does not depend on the choice of finite generating set.  Both come from Fekete's lemma
applied to the subadditive sequence `n ↦ log |B(n)|`: Mathlib's `Subadditive.lim` is *defined*
as the infimum of `u n / n` over `n ≥ 1`, so the limit `v` satisfies `v ^ n ≤ |B(n)|` for
**every** `n`, not merely eventually — which is what the `∀ n` in `HasExponentialGrowth` needs.
-/

namespace Chou
namespace Lib

open Chou

variable {G : Type*} [Group G]

/-! ### Elementary properties of word balls -/

lemma one_mem_wordBall (S : Set G) (n : ℕ) : (1 : G) ∈ wordBall S n :=
  ⟨[], by simp, by simp, by simp⟩

lemma wordBall_mono (S : Set G) {m n : ℕ} (h : m ≤ n) : wordBall S m ⊆ wordBall S n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen.trans h, hmem, rfl⟩

lemma mul_mem_wordBall {S : Set G} {a b : G} {m n : ℕ} (ha : a ∈ wordBall S m)
    (hb : b ∈ wordBall S n) : a * b ∈ wordBall S (m + n) := by
  obtain ⟨l₁, h₁, hm₁, rfl⟩ := ha
  obtain ⟨l₂, h₂, hm₂, rfl⟩ := hb
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · simpa using Nat.add_le_add h₁ h₂
  · intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hm₁ x h
    · exact hm₂ x h
  · simp

lemma inv_mem_wordBall {S : Set G} {a : G} {n : ℕ} (ha : a ∈ wordBall S n) :
    a⁻¹ ∈ wordBall S n := by
  obtain ⟨l, hlen, hmem, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, ?_, (List.prod_inv_reverse l).symm⟩
  · simpa using hlen
  · intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hmem y hy with h | h
    · exact Or.inr (by simpa using h)
    · exact Or.inl h

/-- Every element of the subgroup generated by `T` lies in some `T`-ball. -/
lemma exists_mem_wordBall_of_mem_closure {T : Set G} {g : G} (hg : g ∈ Subgroup.closure T) :
    ∃ m : ℕ, g ∈ wordBall T m := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, [x], by simp, by simpa using Or.inl hx, by simp⟩
  | one => exact ⟨0, one_mem_wordBall T 0⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨m, hm⟩ := ihx
      obtain ⟨n, hn⟩ := ihy
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv x _ ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m, inv_mem_wordBall hm⟩

/-- Comparison of balls for two generating sets: if every element of `T` is an `S`-word of
length at most `k`, then the `T`-ball of radius `n` sits inside the `S`-ball of radius `k * n`. -/
lemma wordBall_subset_wordBall_of_forall_mem {S T : Set G} {k : ℕ}
    (h : ∀ t ∈ T, t ∈ wordBall S k) (n : ℕ) : wordBall T n ⊆ wordBall S (k * n) := by
  have hstep : ∀ x : G, (x ∈ T ∨ x⁻¹ ∈ T) → x ∈ wordBall S k := by
    rintro x (hx | hx)
    · exact h x hx
    · simpa using inv_mem_wordBall (h _ hx)
  have main : ∀ l : List G, (∀ x ∈ l, x ∈ wordBall S k) →
      l.prod ∈ wordBall S (k * l.length) := by
    intro l
    induction l with
    | nil => intro _; simpa using one_mem_wordBall S 0
    | cons a t ih =>
        intro hl
        have harith : k * (a :: t).length = k + k * t.length := by
          simp only [List.length_cons]; ring
        rw [List.prod_cons, harith]
        exact mul_mem_wordBall (hl a (by simp)) (ih fun x hx => hl x (List.mem_cons_of_mem _ hx))
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact wordBall_mono S (Nat.mul_le_mul le_rfl hlen) (main l fun x hx => hstep x (hmem x hx))

/-! ### Finiteness and cardinality of balls -/

/-- For a finite generating set the balls are finite. -/
lemma finite_wordBall (S : Finset G) (n : ℕ) : (wordBall (S : Set G) n).Finite := by
  classical
  set T : Finset G := S ∪ S.image (fun x => x⁻¹) with hT
  have key : wordBall (S : Set G) n ⊆
      (fun l : List T => (l.map Subtype.val).prod) '' {l : List T | l.length ≤ n} := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    have hmemT : ∀ x ∈ l, x ∈ T := by
      intro x hx
      rcases hmem x hx with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, h, by simp⟩)
    refine ⟨l.attach.map (fun x => (⟨x.1, hmemT x.1 x.2⟩ : T)), ?_, ?_⟩
    · simpa using hlen
    · simp
  exact Set.Finite.subset (Set.Finite.image _ (List.finite_length_le _ n)) key

lemma one_le_card_wordBall (S : Finset G) (n : ℕ) : 1 ≤ Nat.card (wordBall (S : Set G) n) := by
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_pos (finite_wordBall S n)).2 ⟨1, one_mem_wordBall _ _⟩

lemma card_wordBall_pos (S : Finset G) (n : ℕ) :
    (0 : ℝ) < (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  exact_mod_cast one_le_card_wordBall S n

/-- Submultiplicativity of the ball sizes: a word of length `≤ m + n` splits as a word of
length `≤ m` times a word of length `≤ n`. -/
lemma card_wordBall_add_le (S : Finset G) (m n : ℕ) :
    Nat.card (wordBall (S : Set G) (m + n)) ≤
      Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
  have hfin : (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n).Finite :=
    (finite_wordBall S m).prod (finite_wordBall S n)
  have hsub : wordBall (S : Set G) (m + n) ⊆
      (fun p : G × G => p.1 * p.2) ''
        (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    refine ⟨((l.take m).prod, (l.drop m).prod), ⟨⟨l.take m, ?_, ?_, rfl⟩,
      ⟨l.drop m, ?_, ?_, rfl⟩⟩, ?_⟩
    · simp
    · exact fun x hx => hmem x (List.mem_of_mem_take hx)
    · have hd : (l.drop m).length = l.length - m := List.length_drop ..
      omega
    · exact fun x hx => hmem x (List.mem_of_mem_drop hx)
    · simp [← List.prod_append, List.take_append_drop]
  calc Nat.card (wordBall (S : Set G) (m + n))
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_prod

lemma card_wordBall_le_of_subset {S T : Finset G} {m n : ℕ}
    (h : wordBall (S : Set G) m ⊆ wordBall (T : Set G) n) :
    Nat.card (wordBall (S : Set G) m) ≤ Nat.card (wordBall (T : Set G) n) := by
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard h (finite_wordBall T n)

/-! ### Fekete's lemma applied to `log |B(n)|` -/

/-- The logarithm of the size of the ball of radius `n`. -/
noncomputable def logBall (S : Finset G) (n : ℕ) : ℝ :=
  Real.log (Nat.card (wordBall (S : Set G) n))

lemma logBall_nonneg (S : Finset G) (n : ℕ) : 0 ≤ logBall S n :=
  Real.log_nonneg (by exact_mod_cast one_le_card_wordBall S n)

lemma exp_logBall (S : Finset G) (n : ℕ) :
    Real.exp (logBall S n) = (Nat.card (wordBall (S : Set G) n) : ℝ) :=
  Real.exp_log (card_wordBall_pos S n)

lemma subadditive_logBall (S : Finset G) : Subadditive (logBall S) := by
  intro m n
  have h1 := card_wordBall_pos S m
  have h2 := card_wordBall_pos S n
  have hle : (Nat.card (wordBall (S : Set G) (m + n)) : ℝ) ≤
      (Nat.card (wordBall (S : Set G) m) : ℝ) * (Nat.card (wordBall (S : Set G) n) : ℝ) := by
    exact_mod_cast card_wordBall_add_le S m n
  calc logBall S (m + n)
      ≤ Real.log ((Nat.card (wordBall (S : Set G) m) : ℝ) *
          (Nat.card (wordBall (S : Set G) n) : ℝ)) :=
        Real.log_le_log (card_wordBall_pos S (m + n)) hle
    _ = logBall S m + logBall S n := Real.log_mul h1.ne' h2.ne'

lemma bddBelow_logBall_div (S : Finset G) :
    BddBelow (Set.range fun n : ℕ => logBall S n / n) := by
  refine ⟨0, ?_⟩
  rintro x ⟨n, rfl⟩
  exact div_nonneg (logBall_nonneg S n) (Nat.cast_nonneg n)

/-- The growth rate of `G` with respect to the finite generating set `S`:
`exp` of Fekete's limit of `log |B(n)| / n`. -/
noncomputable def growthRate (S : Finset G) : ℝ := Real.exp (subadditive_logBall S).lim

lemma growthRate_eq (S : Finset G) : growthRate S = Real.exp (subadditive_logBall S).lim := rfl

lemma growthRate_pos (S : Finset G) : 0 < growthRate S := Real.exp_pos _

lemma tendsto_logBall_div (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => logBall S n / n) Filter.atTop
      (nhds (subadditive_logBall S).lim) :=
  (subadditive_logBall S).tendsto_lim (bddBelow_logBall_div S)

lemma card_wordBall_rpow_eq_exp (S : Finset G) (n : ℕ) :
    (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) = Real.exp (logBall S n / n) := by
  rw [Real.rpow_def_of_pos (card_wordBall_pos S n), mul_one_div]
  rfl

/-- Milnor, p. 399: `|B(n)|^{1/n}` converges to `growthRate S`. -/
theorem tendsto_card_wordBall_rpow_inv (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds (growthRate S)) := by
  refine Filter.Tendsto.congr (fun n => (card_wordBall_rpow_eq_exp S n).symm) ?_
  exact (Real.continuous_exp.tendsto _).comp (tendsto_logBall_div S)

/-- **The infimum characterisation.**  `Subadditive.lim` is an infimum, so the growth rate is a
*lower* bound for every `|B(n)|^{1/n}` with `n ≥ 1`, not merely a limit. -/
theorem growthRate_le_card_wordBall_rpow_inv (S : Finset G) {n : ℕ} (hn : n ≠ 0) :
    growthRate S ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) := by
  rw [card_wordBall_rpow_eq_exp]
  exact Real.exp_le_exp.2 ((subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn)

/-- The form in which the infimum characterisation is used: `v ^ n ≤ |B(n)|` for **every** `n`. -/
theorem growthRate_pow_le_card_wordBall (S : Finset G) (n : ℕ) :
    growthRate S ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simpa using (by exact_mod_cast one_le_card_wordBall S 0 :
      (1 : ℝ) ≤ (Nat.card (wordBall (S : Set G) 0) : ℝ))
  · have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hle := (subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn.ne'
    rw [le_div_iff₀ hn'] at hle
    have h1 : growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) :=
      (Real.exp_nat_mul _ n).symm
    calc growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) := h1
      _ ≤ Real.exp (logBall S n) := Real.exp_le_exp.2 (by linarith)
      _ = (Nat.card (wordBall (S : Set G) n) : ℝ) := exp_logBall S n

/-! ### The two theorems -/

/-- p. 399, Milnor's theorem as Chou states it: for a finite generating set `S`, the growth rate
`lim |B(n)|^{1/n}` exists. -/
theorem exists_tendsto_card_wordBall_rpow_inv' {G : Type*} [Group G] (S : Finset G)
    (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ v : ℝ, Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds v) :=
  ⟨growthRate S, tendsto_card_wordBall_rpow_inv S⟩

/-- Every `S`-ball sits inside a `T`-ball of a uniformly rescaled radius, when `T` generates. -/
lemma exists_wordBall_subset (S T : Finset G) (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (S : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  classical
  have H : ∀ s ∈ S, ∃ m : ℕ, s ∈ wordBall (T : Set G) m := fun s _ =>
    exists_mem_wordBall_of_mem_closure (by rw [hT]; trivial)
  choose f hf using H
  refine ⟨(S.attach.sup fun s => f s.1 s.2) + 1, Nat.succ_pos _, fun n => ?_⟩
  refine wordBall_subset_wordBall_of_forall_mem (fun s hs => ?_) n
  have hs' : s ∈ S := hs
  refine wordBall_mono _ ?_ (hf s hs')
  have hsup : f s hs' ≤ S.attach.sup fun s : {x // x ∈ S} => f s.1 s.2 :=
    Finset.le_sup (f := fun s : {x // x ∈ S} => f s.1 s.2) (Finset.mem_attach S ⟨s, hs'⟩)
  omega

/-- p. 399 (Wolf): exponential growth does not depend on the choice of the finite generating
set. -/
theorem hasExponentialGrowth_iff_forall' {G : Type*} [Group G] [Group.FG G] :
    HasExponentialGrowth G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ →
        ∃ c : ℝ, 1 < c ∧ ∀ n : ℕ, c ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  constructor
  · rintro ⟨S, -, c, hc, hcn⟩ T hT
    obtain ⟨k, hk, hkn⟩ := exists_wordBall_subset S T hT
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    -- the `T`-balls of radius `k * n` are at least as big as the `S`-balls of radius `n`
    have hball : ∀ n : ℕ, (c : ℝ) ^ n ≤ (Nat.card (wordBall (T : Set G) (k * n)) : ℝ) := by
      intro n
      refine (hcn n).trans ?_
      exact_mod_cast card_wordBall_le_of_subset (hkn n)
    -- hence `log c / k` is a lower bound along the subsequence `k * n`
    have hdiv : ∀ n : ℕ, 1 ≤ n → Real.log c / k ≤ logBall T (k * n) / ((k * n : ℕ) : ℝ) := by
      intro n hn
      have hnR : (0 : ℝ) < n := by exact_mod_cast hn
      have h1 : (n : ℝ) * Real.log c ≤ logBall T (k * n) := by
        have hlog := Real.log_le_log (by positivity : (0 : ℝ) < c ^ n) (hball n)
        rwa [Real.log_pow] at hlog
      rw [div_le_div_iff₀ hkR (by push_cast; positivity)]
      have h2 : (k : ℝ) * ((n : ℝ) * Real.log c) ≤ (k : ℝ) * logBall T (k * n) :=
        mul_le_mul_of_nonneg_left h1 hkR.le
      push_cast
      linarith
    -- Fekete's limit is at least `log c / k`
    have hmul : Filter.Tendsto (fun n : ℕ => k * n) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_mul_of_pos_left n hk) Filter.tendsto_id
    have hsubseq : Filter.Tendsto (fun n : ℕ => logBall T (k * n) / ((k * n : ℕ) : ℝ))
        Filter.atTop (nhds (subadditive_logBall T).lim) := (tendsto_logBall_div T).comp hmul
    have hge : Real.log c / k ≤ (subadditive_logBall T).lim :=
      ge_of_tendsto hsubseq (Filter.eventually_atTop.2 ⟨1, fun n hn => hdiv n hn⟩)
    refine ⟨growthRate T, ?_, growthRate_pow_le_card_wordBall T⟩
    have hpos : (0 : ℝ) < Real.log c / k := div_pos (Real.log_pos hc) hkR
    calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
      _ < Real.exp (subadditive_logBall T).lim := Real.exp_lt_exp.2 (lt_of_lt_of_le hpos hge)
      _ = growthRate T := (growthRate_eq T).symm
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    obtain ⟨c, hc, hcn⟩ := h S hS
    exact ⟨S, hS, c, hc, hcn⟩

end Lib
end Chou

/-!
# Chou §3, pp. 399–400: exponential boundedness, and how the two growth classes behave

`IsExponentiallyBounded` is the exact negation of `HasExponentialGrowth` for a finitely
generated group.  Both sides are read off the growth rate `growthRate S = lim |B(n)|^{1/n}`
of `CH_growth2`: it is always `≥ 1`, exponential growth says it is `> 1` (for one, hence by
Wolf for every, finite generating set), and exponential boundedness says it is `= 1`.

The class of exponentially bounded groups is then closed under isomorphism, quotients and
finitely generated subgroups — the closure properties Chou uses in §4 — and virtual
nilpotency passes from a finite-index subgroup to the whole group.
-/

namespace Chou
namespace Lib

open Chou

/-! ### Images of word balls under group homomorphisms -/

/-- The image of a ball is contained in the ball of the image set. -/
lemma image_wordBall_subset {G H : Type*} [Group G] [Group H] (f : G →* H) (S : Set G) (n : ℕ) :
    f '' wordBall S n ⊆ wordBall (f '' S) n := by
  rintro _ ⟨g, ⟨l, hlen, hmem, rfl⟩, rfl⟩
  refine ⟨l.map f, by simpa using hlen, ?_, List.prod_hom l f⟩
  intro x hx
  simp only [List.mem_map] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  rcases hmem y hy with h | h
  · exact Or.inl ⟨y, h, rfl⟩
  · exact Or.inr ⟨y⁻¹, h, by simp⟩

/-- A word in the image letters lifts letter by letter, so the ball of the image set is
contained in the image of the ball. -/
lemma wordBall_image_subset_image_wordBall {G H : Type*} [Group G] [Group H] (f : G →* H)
    (S : Set G) (n : ℕ) : wordBall (f '' S) n ⊆ f '' wordBall S n := by
  have lift : ∀ l : List H, (∀ x ∈ l, x ∈ f '' S ∨ x⁻¹ ∈ f '' S) →
      ∃ l' : List G, l'.length = l.length ∧ (∀ y ∈ l', y ∈ S ∨ y⁻¹ ∈ S) ∧ l'.map f = l := by
    intro l
    induction l with
    | nil => intro _; exact ⟨[], rfl, by simp, by simp⟩
    | cons a t ih =>
        intro hl
        obtain ⟨t', hlen, hmem, hmap⟩ := ih fun x hx => hl x (List.mem_cons_of_mem _ hx)
        have ha := hl a (by simp)
        obtain ⟨y, hy, hya⟩ : ∃ y : G, (y ∈ S ∨ y⁻¹ ∈ S) ∧ f y = a := by
          rcases ha with ⟨y, hy, hya⟩ | ⟨y, hy, hya⟩
          · exact ⟨y, Or.inl hy, hya⟩
          · refine ⟨y⁻¹, Or.inr (by simpa using hy), ?_⟩
            rw [map_inv, hya, inv_inv]
        refine ⟨y :: t', by simp [hlen], ?_, by simp [hmap, hya]⟩
        intro z hz
        rcases List.mem_cons.1 hz with rfl | hz
        · exact hy
        · exact hmem z hz
  rintro g ⟨l, hlen, hmem, rfl⟩
  obtain ⟨l', hlen', hmem', hmap⟩ := lift l hmem
  exact ⟨l'.prod, ⟨l', by omega, hmem', rfl⟩, by rw [← List.prod_hom l' f, hmap]⟩

/-- Along an isomorphism the ball of the image set is exactly the image of the ball. -/
lemma image_wordBall_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) (S : Set G)
    (n : ℕ) : (e : G → H) '' wordBall S n = wordBall ((e : G → H) '' S) n :=
  Set.Subset.antisymm (image_wordBall_subset (e : G →* H) S n)
    (wordBall_image_subset_image_wordBall (e : G →* H) S n)

section GrowthRate

variable {G : Type*} [Group G]

/-! ### The growth rate is at least one -/

lemma one_le_growthRate (S : Finset G) : 1 ≤ growthRate S := by
  have h : (0 : ℝ) ≤ (subadditive_logBall S).lim :=
    ge_of_tendsto (tendsto_logBall_div S)
      (Filter.Eventually.of_forall fun n => div_nonneg (logBall_nonneg S n) (Nat.cast_nonneg n))
  calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
    _ ≤ Real.exp (subadditive_logBall S).lim := Real.exp_le_exp.2 h
    _ = growthRate S := (growthRate_eq S).symm

/-- If `c ^ n` is a lower bound for every ball, then `c` is a lower bound for the growth rate:
`c = (c ^ n) ^ (1/n) ≤ |B(n)| ^ (1/n) → growthRate S`. -/
lemma le_growthRate_of_forall_pow_le (S : Finset G) {c : ℝ} (hc : 0 ≤ c)
    (h : ∀ n : ℕ, c ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ)) : c ≤ growthRate S := by
  refine ge_of_tendsto (tendsto_card_wordBall_rpow_inv S) (Filter.eventually_atTop.2 ⟨1, ?_⟩)
  intro n hn
  have hn' : 0 < n := hn
  have hn0 : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hn'.ne'
  have hnn : (0 : ℝ) ≤ 1 / (n : ℝ) := by positivity
  have hpow : c = (c ^ n) ^ (1 / (n : ℝ)) := by
    rw [← Real.rpow_natCast c n, ← Real.rpow_mul hc, mul_one_div, div_self hn0, Real.rpow_one]
  rw [hpow]
  exact Real.rpow_le_rpow (by positivity) (h n) hnn

/-- If the growth rate is strictly below `c`, then the balls are eventually below `c ^ n`. -/
lemma eventually_card_wordBall_le (S : Finset G) {c : ℝ} (hc : growthRate S < c) :
    ∃ N : ℕ, ∀ n ≥ N, (Nat.card (wordBall (S : Set G) n) : ℝ) ≤ c ^ n := by
  have htend := tendsto_card_wordBall_rpow_inv S
  have hev : ∀ᶠ n : ℕ in Filter.atTop,
      (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) ≤ c :=
    (htend.eventually_le_const hc).mono fun n hn => hn
  obtain ⟨N₁, hN₁⟩ := Filter.eventually_atTop.1 hev
  refine ⟨max N₁ 1, fun n hn => ?_⟩
  have hn1 : 1 ≤ n := le_trans (le_max_right N₁ 1) hn
  have hnN : N₁ ≤ n := le_trans (le_max_left N₁ 1) hn
  have hn0 : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (by omega)
  have hcard := card_wordBall_pos S n
  have hle := Real.rpow_le_rpow (by positivity) (hN₁ n hnN)
    (by positivity : (0 : ℝ) ≤ (n : ℝ))
  rw [← Real.rpow_mul hcard.le, one_div, inv_mul_cancel₀ hn0, Real.rpow_one,
    Real.rpow_natCast] at hle
  exact hle

/-- Exponential growth, in terms of the growth rate. -/
theorem hasExponentialGrowth_iff_exists_one_lt_growthRate {G : Type*} [Group G] :
    HasExponentialGrowth G ↔
      ∃ S : Finset G, Subgroup.closure (S : Set G) = ⊤ ∧ 1 < growthRate S := by
  constructor
  · rintro ⟨S, hS, c, hc, hcn⟩
    exact ⟨S, hS, lt_of_lt_of_le hc (le_growthRate_of_forall_pow_le S (by linarith) hcn)⟩
  · rintro ⟨S, hS, hgr⟩
    exact ⟨S, hS, growthRate S, hgr, growthRate_pow_le_card_wordBall S⟩

/-- For a finitely generated group, exponential growth is a property of *every* finite
generating set (Wolf), stated through the growth rate. -/
theorem hasExponentialGrowth_iff_forall_one_lt_growthRate {G : Type*} [Group G] [Group.FG G] :
    HasExponentialGrowth G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ → 1 < growthRate S := by
  constructor
  · intro h S hS
    obtain ⟨c, hc, hcn⟩ := hasExponentialGrowth_iff_forall'.1 h S hS
    exact lt_of_lt_of_le hc (le_growthRate_of_forall_pow_le S (by linarith) hcn)
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    exact hasExponentialGrowth_iff_exists_one_lt_growthRate.2 ⟨S, hS, h S hS⟩

/-- For a generating set of a group without exponential growth, the growth rate is `1`. -/
lemma growthRate_eq_one_of_not_hasExponentialGrowth {S : Finset G}
    (hS : Subgroup.closure (S : Set G) = ⊤) (h : ¬ HasExponentialGrowth G) :
    growthRate S = 1 := by
  have h2 : ¬ (1 < growthRate S) := fun hgt =>
    h (hasExponentialGrowth_iff_exists_one_lt_growthRate.2 ⟨S, hS, hgt⟩)
  exact le_antisymm (not_lt.1 h2) (one_le_growthRate S)

end GrowthRate

/-! ### Exponential boundedness is the negation of exponential growth -/

theorem isExponentiallyBounded_iff_not_hasExponentialGrowth' {G : Type*} [Group G]
    [Group.FG G] : IsExponentiallyBounded G ↔ ¬ HasExponentialGrowth G := by
  constructor
  · rintro ⟨S, hS, hb⟩ hexp
    obtain ⟨c, hc, hcn⟩ := hasExponentialGrowth_iff_forall'.1 hexp S hS
    obtain ⟨N, hN⟩ := hb ((1 + c) / 2) (by linarith)
    have hpow : c ^ (max N 1) ≤ ((1 + c) / 2) ^ (max N 1) :=
      le_trans (hcn _) (hN _ (le_max_left N 1))
    have hne : max N 1 ≠ 0 := by positivity
    have hle : c ≤ (1 + c) / 2 := le_of_pow_le_pow_left₀ hne (by linarith) hpow
    linarith
  · intro hexp
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    have hgr : growthRate S = 1 := growthRate_eq_one_of_not_hasExponentialGrowth hS hexp
    exact ⟨S, hS, fun c hc => eventually_card_wordBall_le S (by rw [hgr]; exact hc)⟩

theorem isExponentiallyBounded_of_not_hasExponentialGrowth' {G : Type*} [Group G] [Group.FG G]
    (h : ¬ HasExponentialGrowth G) : IsExponentiallyBounded G :=
  isExponentiallyBounded_iff_not_hasExponentialGrowth'.2 h

theorem not_hasExponentialGrowth_of_isExponentiallyBounded' {G : Type*} [Group G] [Group.FG G]
    (h : IsExponentiallyBounded G) : ¬ HasExponentialGrowth G :=
  isExponentiallyBounded_iff_not_hasExponentialGrowth'.1 h

/-- Exponential boundedness, like exponential growth, does not depend on the finite generating
set. -/
theorem isExponentiallyBounded_iff_forall' {G : Type*} [Group G] [Group.FG G] :
    IsExponentiallyBounded G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ →
        ∀ c : ℝ, 1 < c → ∃ N : ℕ, ∀ n ≥ N,
          (Nat.card (wordBall (S : Set G) n) : ℝ) ≤ c ^ n := by
  constructor
  · intro h S hS c hc
    have hgr : growthRate S = 1 :=
      growthRate_eq_one_of_not_hasExponentialGrowth hS
        (not_hasExponentialGrowth_of_isExponentiallyBounded' h)
    exact eventually_card_wordBall_le S (by rw [hgr]; exact hc)
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    exact ⟨S, hS, h S hS⟩

/-! ### Transport along an isomorphism -/

/-- The image of a generating set under a surjective homomorphism generates. -/
lemma closure_image_eq_top {G H : Type*} [Group G] [Group H] (f : G →* H)
    (hf : Function.Surjective f) {S : Set G} (hS : Subgroup.closure S = ⊤) :
    Subgroup.closure ((f : G → H) '' S) = ⊤ := by
  rw [← MonoidHom.map_closure f S, hS]
  exact Subgroup.map_top_of_surjective _ hf

theorem hasExponentialGrowth_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (h : HasExponentialGrowth G) : HasExponentialGrowth H := by
  classical
  obtain ⟨S, hS, c, hc, hcn⟩ := h
  refine ⟨S.image (e : G → H), ?_, c, hc, fun n => ?_⟩
  · have h0 : ((S.image (e : G → H) : Finset H) : Set H) = (e : G → H) '' (S : Set G) :=
      Finset.coe_image
    rw [h0]
    exact closure_image_eq_top (e : G →* H) e.surjective hS
  · have hcoe : ((S.image (e : G → H) : Finset H) : Set H) = (e : G → H) '' (S : Set G) :=
      Finset.coe_image
    have hcard : Nat.card (wordBall ((S.image (e : G → H) : Finset H) : Set H) n)
        = Nat.card (wordBall (S : Set G) n) := by
      rw [hcoe, ← image_wordBall_mulEquiv e]
      simp only [Nat.card_coe_set_eq]
      exact Set.ncard_image_of_injective _ e.injective
    rw [hcard]
    exact hcn n

theorem isExponentiallyBounded_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (h : IsExponentiallyBounded G) : IsExponentiallyBounded H := by
  classical
  obtain ⟨S, hS, hb⟩ := h
  have hcoe : ((S.image (e : G → H) : Finset H) : Set H) = (e : G → H) '' (S : Set G) :=
    Finset.coe_image
  refine ⟨S.image (e : G → H), ?_, fun c hc => ?_⟩
  · rw [hcoe]
    exact closure_image_eq_top (e : G →* H) e.surjective hS
  · obtain ⟨N, hN⟩ := hb c hc
    refine ⟨N, fun n hn => ?_⟩
    have hcard : Nat.card (wordBall ((S.image (e : G → H) : Finset H) : Set H) n)
        = Nat.card (wordBall (S : Set G) n) := by
      rw [hcoe, ← image_wordBall_mulEquiv e]
      simp only [Nat.card_coe_set_eq]
      exact Set.ncard_image_of_injective _ e.injective
    rw [hcard]
    exact hN n hn

/-! ### Quotients -/

/-- The ball of the image generating set in a quotient is no bigger than the ball upstairs. -/
lemma card_wordBall_image_le {G H : Type*} [Group G] [Group H] (f : G →* H) (S : Finset G)
    (T : Finset H) (hT : (T : Set H) = f '' (S : Set G)) (n : ℕ) :
    Nat.card (wordBall (T : Set H) n) ≤ Nat.card (wordBall (S : Set G) n) := by
  have hfin : (wordBall (S : Set G) n).Finite := finite_wordBall S n
  have hsub : wordBall (T : Set H) n ⊆ f '' wordBall (S : Set G) n := by
    rw [hT]
    exact wordBall_image_subset_image_wordBall f _ n
  simp only [Nat.card_coe_set_eq]
  exact le_trans (Set.ncard_le_ncard hsub (hfin.image _)) (Set.ncard_image_le hfin)

theorem isExponentiallyBounded_quotient {G : Type*} [Group G] [Group.FG G] (N : Subgroup G)
    [N.Normal] (h : IsExponentiallyBounded G) : IsExponentiallyBounded (G ⧸ N) := by
  classical
  obtain ⟨S, hS, hb⟩ := h
  have hcoe : ((S.image (QuotientGroup.mk' N : G → G ⧸ N) : Finset (G ⧸ N)) : Set (G ⧸ N))
      = (QuotientGroup.mk' N : G → G ⧸ N) '' (S : Set G) := Finset.coe_image
  refine ⟨S.image (QuotientGroup.mk' N : G → G ⧸ N), ?_, fun c hc => ?_⟩
  · rw [hcoe, ← MonoidHom.map_closure (QuotientGroup.mk' N), hS]
    exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)
  · obtain ⟨M, hM⟩ := hb c hc
    refine ⟨M, fun n hn => ?_⟩
    refine le_trans ?_ (hM n hn)
    exact_mod_cast card_wordBall_image_le (QuotientGroup.mk' N) S _ hcoe n

theorem not_hasExponentialGrowth_quotient {G : Type*} [Group G] [Group.FG G] (N : Subgroup G)
    [N.Normal] (h : ¬ HasExponentialGrowth G) : ¬ HasExponentialGrowth (G ⧸ N) :=
  not_hasExponentialGrowth_of_isExponentiallyBounded'
    (isExponentiallyBounded_quotient N (isExponentiallyBounded_of_not_hasExponentialGrowth' h))

/-! ### Finitely generated subgroups -/

theorem isExponentiallyBounded_subgroup {G : Type*} [Group G] (h : IsExponentiallyBounded G)
    (H : Subgroup G) [Group.FG H] : IsExponentiallyBounded H := by
  classical
  obtain ⟨S, hS, hb⟩ := h
  obtain ⟨-, T, -, hT⟩ := Group.fg_iff'.mp ‹Group.FG H›
  obtain ⟨k, hk, hkn⟩ :=
    exists_wordBall_subset (T.image ((H.subtype : H →* G) : H → G)) S hS
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hcoe : ((T.image ((H.subtype : H →* G) : H → G) : Finset G) : Set G)
      = ((H.subtype : H →* G) : H → G) '' (T : Set H) := Finset.coe_image
  -- the `H`-ball of radius `n` injects into the `G`-ball of radius `k * n`
  have hcard : ∀ n : ℕ, Nat.card (wordBall (T : Set H) n)
      ≤ Nat.card (wordBall (S : Set G) (k * n)) := by
    intro n
    have h1 : ((H.subtype : H →* G) : H → G) '' wordBall (T : Set H) n
        ⊆ wordBall (S : Set G) (k * n) := by
      refine subset_trans (image_wordBall_subset (H.subtype : H →* G) _ n) ?_
      rw [← hcoe]
      exact hkn n
    have h2 : Nat.card (((H.subtype : H →* G) : H → G) '' wordBall (T : Set H) n)
        = Nat.card (wordBall (T : Set H) n) := by
      simp only [Nat.card_coe_set_eq]
      exact Set.ncard_image_of_injective _ H.subtype_injective
    rw [← h2]
    simp only [Nat.card_coe_set_eq]
    exact Set.ncard_le_ncard h1 (finite_wordBall S (k * n))
  refine ⟨T, hT, fun c hc => ?_⟩
  have hc0 : (0 : ℝ) < c := by linarith
  set c' : ℝ := c ^ (1 / (k : ℝ)) with hc'def
  have hc' : 1 < c' := by
    rw [hc'def]
    exact (Real.one_lt_rpow_iff_of_pos hc0).2 (Or.inl ⟨hc, by positivity⟩)
  obtain ⟨M, hM⟩ := hb c' hc'
  refine ⟨M, fun n hn => ?_⟩
  have hkn' : M ≤ k * n := le_trans hn (Nat.le_mul_of_pos_left n hk)
  have hstep : (Nat.card (wordBall (T : Set H) n) : ℝ)
      ≤ (Nat.card (wordBall (S : Set G) (k * n)) : ℝ) := by exact_mod_cast hcard n
  refine le_trans hstep (le_trans (hM (k * n) hkn') ?_)
  have hkne : (k : ℝ) ≠ 0 := ne_of_gt hkR
  have : c' ^ (k * n) = c ^ n := by
    rw [hc'def, ← Real.rpow_natCast (c ^ (1 / (k : ℝ))) (k * n), ← Real.rpow_mul hc0.le]
    rw [← Real.rpow_natCast c n]
    congr 1
    push_cast
    field_simp
  exact le_of_eq this

theorem not_hasExponentialGrowth_subgroup {G : Type*} [Group G] [Group.FG G]
    (h : ¬ HasExponentialGrowth G) (H : Subgroup G) [Group.FG H] :
    ¬ HasExponentialGrowth H :=
  not_hasExponentialGrowth_of_isExponentiallyBounded'
    (isExponentiallyBounded_subgroup (isExponentiallyBounded_of_not_hasExponentialGrowth' h) H)

/-! ### Virtual nilpotency passes up from a finite-index subgroup -/

theorem isVirtuallyNilpotent_of_finiteIndex {G : Type*} [Group G] (H : Subgroup G)
    [H.FiniteIndex] (h : Group.IsVirtuallyNilpotent H) : Group.IsVirtuallyNilpotent G := by
  obtain ⟨K, hKnil, hKidx⟩ := h
  refine ⟨K.map H.subtype, ?_, ?_⟩
  · exact (Group.isNilpotent_congr
      (K.equivMapOfInjective H.subtype H.subtype_injective)).1 hKnil
  · rw [Subgroup.finiteIndex_iff, Subgroup.index_map_subtype]
    exact Nat.mul_ne_zero hKidx.index_ne_zero ‹H.FiniteIndex›.index_ne_zero

/-! ### Finite generation, from Mathlib

`Subgroup.fg_of_index_ne_zero` (Schreier) and `QuotientGroup.fg` are instances, so the two
finite generation hypotheses the results above need are found by typeclass inference. -/

example {G : Type*} [Group G] [Group.FG G] (H : Subgroup G) [H.FiniteIndex] : Group.FG H :=
  inferInstance

example {G : Type*} [Group G] [Group.FG G] (N : Subgroup G) [N.Normal] : Group.FG (G ⧸ N) :=
  inferInstance

end Lib
end Chou

/-!
# Polycyclic groups (Wolf, Proposition 4.1 (1), p. 433)

Basic closure properties of `MilnorWolf.IsPolycyclic`: trivial groups and cyclic groups are
polycyclic, the notion is invariant under isomorphism, finitely generated abelian groups are
polycyclic, and an extension of a polycyclic group by a polycyclic group is polycyclic
(Rosenblatt's Remark 4.3).  Polycyclic groups are finitely generated and finitely presented.

The `Fin (t + 1)`-indexed normal series of the published definition is replaced, for the duration
of the proofs, by the `ℕ`-indexed characterisation `MilnorWolf.Lib.IsPolyChain`: a chain
`A : ℕ → Subgroup G` with `A 0 = ⊤`, eventually `⊥`, and each step normal with cyclic quotient.
-/

universe u v

namespace MilnorWolf
namespace Lib

open Function Subgroup

/-! ### One step of a normal series -/

/-- One step `H ⊆ K` of a normal series: `H ≤ K`, `H` is normal in `K`, and `K/H` is cyclic. -/
def IsCyclicStep {G : Type*} [Group G] (H K : Subgroup G) : Prop :=
  H ≤ K ∧ ∃ _ : (H.subgroupOf K).Normal, IsCyclic (K ⧸ H.subgroupOf K)

/-- Transport of "normal with cyclic quotient" along a surjection, by pulling the subgroup back. -/
theorem normal_isCyclic_comap {A B : Type*} [Group A] [Group B] (φ : A →* B)
    (hφ : Surjective φ) {Q : Subgroup B} (hn : Q.Normal) (hc : IsCyclic (B ⧸ Q)) :
    ∃ _ : (Q.comap φ).Normal, IsCyclic (A ⧸ Q.comap φ) := by
  have : Q.Normal := hn
  have hn' : (Q.comap φ).Normal := hn.comap φ
  refine ⟨hn', ?_⟩
  have hker : Q.comap φ = ((QuotientGroup.mk' Q).comp φ).ker := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
  have hs : Surjective ((QuotientGroup.mk' Q).comp φ) :=
    (QuotientGroup.mk'_surjective Q).comp hφ
  have e : A ⧸ Q.comap φ ≃* B ⧸ Q :=
    (QuotientGroup.quotientMulEquivOfEq hker).trans
      (QuotientGroup.quotientKerEquivOfSurjective _ hs)
  exact isCyclic_of_surjective e.symm e.symm.surjective

/-- The restriction of `f : G →* H` to the preimage of `K`. -/
def restrictComap {G H : Type*} [Group G] [Group H] (f : G →* H) (K : Subgroup H) :
    ↥(K.comap f) →* ↥K :=
  (f.comp (K.comap f).subtype).codRestrict K (fun x => Subgroup.mem_comap.mp x.2)

@[simp] theorem restrictComap_coe {G H : Type*} [Group G] [Group H] (f : G →* H) (K : Subgroup H)
    (x : ↥(K.comap f)) : ((restrictComap f K x : ↥K) : H) = f (x : G) := rfl

theorem restrictComap_surjective {G H : Type*} [Group G] [Group H] {f : G →* H}
    (hf : Surjective f) (K : Subgroup H) : Surjective (restrictComap f K) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, rfl⟩ := hf y
  exact ⟨⟨x, by simpa using hy⟩, rfl⟩

/-- A step of a normal series pulls back along a surjection. -/
theorem IsCyclicStep.comap {G H : Type*} [Group G] [Group H] {f : G →* H} (hf : Surjective f)
    {K₂ K₁ : Subgroup H} (h : IsCyclicStep K₂ K₁) :
    IsCyclicStep (K₂.comap f) (K₁.comap f) := by
  obtain ⟨hle, hnorm, hcyc⟩ := h
  refine ⟨Subgroup.comap_mono hle, ?_⟩
  have hkey : (K₂.subgroupOf K₁).comap (restrictComap f K₁) =
      (K₂.comap f).subgroupOf (K₁.comap f) := by
    ext x
    simp [Subgroup.mem_subgroupOf]
  have := normal_isCyclic_comap (restrictComap f K₁) (restrictComap_surjective hf K₁)
    hnorm hcyc
  rwa [hkey] at this

/-- A step of a normal series pushes forward along an injection. -/
theorem IsCyclicStep.map {G H : Type*} [Group G] [Group H] {f : G →* H} (hf : Injective f)
    {H₂ H₁ : Subgroup G} (h : IsCyclicStep H₂ H₁) :
    IsCyclicStep (H₂.map f) (H₁.map f) := by
  obtain ⟨hle, hnorm, hcyc⟩ := h
  refine ⟨Subgroup.map_mono hle, ?_⟩
  have hcoe : ∀ x : ↥(H₁.map f),
      f (((Subgroup.equivMapOfInjective H₁ f hf).symm x : ↥H₁) : G) = (x : H) := by
    intro x
    conv_rhs => rw [← MulEquiv.apply_symm_apply (Subgroup.equivMapOfInjective H₁ f hf) x]
    exact (Subgroup.coe_equivMapOfInjective_apply H₁ f hf _).symm
  have hkey : (H₂.subgroupOf H₁).comap
      ((Subgroup.equivMapOfInjective H₁ f hf).symm : ↥(H₁.map f) →* ↥H₁) =
      (H₂.map f).subgroupOf (H₁.map f) := by
    ext x
    simp only [Subgroup.mem_comap, Subgroup.mem_subgroupOf]
    rw [← hcoe x]
    exact (Subgroup.mem_map_iff_mem hf).symm
  have := normal_isCyclic_comap
    ((Subgroup.equivMapOfInjective H₁ f hf).symm : ↥(H₁.map f) →* ↥H₁)
    (Subgroup.equivMapOfInjective H₁ f hf).symm.surjective hnorm hcyc
  rwa [hkey] at this

theorem IsCyclicStep.congr {G : Type*} [Group G] {H K H' K' : Subgroup G} (h : IsCyclicStep H K)
    (e₁ : H = H') (e₂ : K = K') : IsCyclicStep H' K' := e₁ ▸ e₂ ▸ h

/-- The trivial step `⊥ ⊆ ⊥`. -/
theorem isCyclicStep_of_eq_bot {G : Type*} [Group G] {H K : Subgroup G} (hH : H = ⊥)
    (hK : K = ⊥) : IsCyclicStep H K := by
  subst hH; subst hK
  have hn : ((⊥ : Subgroup G).subgroupOf ⊥).Normal := by
    rw [Subgroup.subgroupOf_bot_eq_top]; infer_instance
  exact ⟨le_rfl, hn,
    isCyclic_of_surjective (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)⟩

/-- The step `⊥ ⊆ ⊤` of a cyclic group. -/
theorem isCyclicStep_bot_top {G : Type*} [Group G] [IsCyclic G] :
    IsCyclicStep (⊥ : Subgroup G) ⊤ := by
  have hn : ((⊥ : Subgroup G).subgroupOf ⊤).Normal := by
    rw [Subgroup.bot_subgroupOf]; infer_instance
  exact ⟨bot_le, hn,
    isCyclic_of_surjective (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)⟩

/-! ### An `ℕ`-indexed characterisation of `IsPolycyclic` -/

/-- A normal series of `G` indexed by `ℕ`: `A 0 = ⊤`, some `A t = ⊥`, and every step
`A (i+1) ⊆ A i` is normal with cyclic quotient. -/
def IsPolyChain {G : Type*} [Group G] (A : ℕ → Subgroup G) : Prop :=
  A 0 = ⊤ ∧ (∃ t, A t = ⊥) ∧ ∀ i, IsCyclicStep (A (i + 1)) (A i)

theorem isPolycyclic_of_chain {G : Type*} [Group G] {A : ℕ → Subgroup G} (h : IsPolyChain A) :
    IsPolycyclic G := by
  obtain ⟨h0, ⟨t, ht⟩, hstep⟩ := h
  exact ⟨t, fun i => A i.val, h0, ht, fun i => hstep i.val⟩

theorem exists_chain_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) :
    ∃ A : ℕ → Subgroup G, IsPolyChain A := by
  obtain ⟨t, A, h0, hlast, hstep⟩ := h
  have hbot : ∀ m, t ≤ m →
      A ⟨min m t, Nat.lt_succ_of_le (min_le_right m t)⟩ = ⊥ := by
    intro m hm
    rw [← hlast]
    exact congrArg A (Fin.ext (by simp [Fin.val_last]; omega))
  refine ⟨fun n => A ⟨min n t, Nat.lt_succ_of_le (min_le_right n t)⟩, ?_, ⟨t, ?_⟩, ?_⟩
  · rw [← h0]; exact congrArg A (Fin.ext (by simp))
  · exact hbot t le_rfl
  · intro i
    rcases lt_or_ge i t with hi | hi
    · refine IsCyclicStep.congr (hstep ⟨i, hi⟩) (congrArg A (Fin.ext ?_))
        (congrArg A (Fin.ext ?_))
      · simp only [Fin.val_succ]; omega
      · simp only [Fin.val_castSucc]; omega
    · exact isCyclicStep_of_eq_bot (hbot (i + 1) (by omega)) (hbot i hi)

theorem isPolycyclic_iff_exists_chain {G : Type*} [Group G] :
    IsPolycyclic G ↔ ∃ A : ℕ → Subgroup G, IsPolyChain A :=
  ⟨exists_chain_of_isPolycyclic, fun ⟨_, h⟩ => isPolycyclic_of_chain h⟩

/-! ### The basic examples -/

/-- A trivial group is polycyclic. -/
theorem isPolycyclic_of_subsingleton {G : Type*} [Group G] [Subsingleton G] :
    IsPolycyclic G := by
  have hbot : (⊥ : Subgroup G) = ⊤ := by
    ext x
    simp [Subsingleton.elim x 1]
  exact isPolycyclic_of_chain (A := fun _ => ⊥)
    ⟨hbot, ⟨0, rfl⟩, fun _ => isCyclicStep_of_eq_bot rfl rfl⟩

/-- Being polycyclic is invariant under isomorphism. -/
theorem isPolycyclic_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (h : IsPolycyclic G) : IsPolycyclic H := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  refine isPolycyclic_of_chain (A := fun n => (A n).map (e : G →* H)) ⟨?_, ⟨t, ?_⟩, ?_⟩
  · show (A 0).map (e : G →* H) = ⊤
    rw [h0]; exact Subgroup.map_top_of_surjective _ e.surjective
  · show (A t).map (e : G →* H) = ⊥
    rw [ht]; exact Subgroup.map_bot _
  · exact fun i => (hstep i).map (EquivLike.injective e)

/-- A cyclic group is polycyclic. -/
theorem isPolycyclic_of_isCyclic {G : Type*} [Group G] [IsCyclic G] : IsPolycyclic G := by
  refine isPolycyclic_of_chain (A := fun n => if n = 0 then ⊤ else ⊥) ⟨rfl, ⟨1, rfl⟩, ?_⟩
  intro i
  match i with
  | 0 => exact isCyclicStep_bot_top
  | (j + 1) => exact isCyclicStep_of_eq_bot rfl rfl

/-! ### Extensions -/

/-- Rosenblatt's Remark 4.3: an extension of a polycyclic group by a polycyclic group is
polycyclic. -/
theorem isPolycyclic_of_extension {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (hN : IsPolycyclic N) (hQ : IsPolycyclic (G ⧸ N)) : IsPolycyclic G := by
  obtain ⟨C, hC0, ⟨a, hCa⟩, hCstep⟩ := exists_chain_of_isPolycyclic hN
  obtain ⟨B, hB0, ⟨b0, hBb0⟩, hBstep⟩ := exists_chain_of_isPolycyclic hQ
  obtain ⟨b, hb1, hBb⟩ : ∃ b, 1 ≤ b ∧ B b = ⊥ :=
    ⟨b0 + 1, by omega, le_bot_iff.mp (by rw [← hBb0]; exact (hBstep b0).1)⟩
  have hmkN : (B b).comap (QuotientGroup.mk' N) = N := by
    rw [hBb, MonoidHom.comap_bot, QuotientGroup.ker_mk']
  have hsubN : (C 0).map N.subtype = N := by
    rw [hC0, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  refine isPolycyclic_of_chain
    (A := fun i => if i < b then (B i).comap (QuotientGroup.mk' N)
      else (C (i - b)).map N.subtype) ⟨?_, ⟨b + a, ?_⟩, ?_⟩
  · show (if (0 : ℕ) < b then (B 0).comap (QuotientGroup.mk' N)
      else (C (0 - b)).map N.subtype) = ⊤
    rw [if_pos (by omega : (0 : ℕ) < b), hB0, Subgroup.comap_top]
  · show (if b + a < b then (B (b + a)).comap (QuotientGroup.mk' N)
      else (C (b + a - b)).map N.subtype) = ⊥
    rw [if_neg (by omega), show b + a - b = a by omega, hCa, Subgroup.map_bot]
  · intro i
    show IsCyclicStep
      (if i + 1 < b then (B (i + 1)).comap (QuotientGroup.mk' N)
        else (C (i + 1 - b)).map N.subtype)
      (if i < b then (B i).comap (QuotientGroup.mk' N) else (C (i - b)).map N.subtype)
    rcases lt_or_ge (i + 1) b with h1 | h1
    · rw [if_pos h1, if_pos (by omega : i < b)]
      exact (hBstep i).comap (QuotientGroup.mk'_surjective N)
    · rcases lt_or_ge i b with hi | hi
      · have hib : i + 1 = b := by omega
        rw [if_neg (by omega), if_pos hi, show i + 1 - b = 0 by omega]
        refine IsCyclicStep.congr ((hBstep i).comap (QuotientGroup.mk'_surjective N)) ?_ rfl
        rw [hib, hmkN, hsubN]
      · rw [if_neg (by omega), if_neg (by omega), show i + 1 - b = (i - b) + 1 by omega]
        exact (hCstep (i - b)).map (Subgroup.subtype_injective N)

/-! ### Finitely generated abelian groups -/

theorem isPolycyclic_of_top_eq_bot {G : Type*} [Group G] (h : (⊤ : Subgroup G) = ⊥) :
    IsPolycyclic G := by
  have : Subsingleton G := ⟨fun x y => by
    have hx : x ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top x
    have hy : y ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top y
    rw [Subgroup.mem_bot] at hx hy
    rw [hx, hy]⟩
  exact isPolycyclic_of_subsingleton

/-- Induction on the size of a generating family: an abelian group generated by `n` elements is
polycyclic. -/
theorem isPolycyclic_commGroup_aux (n : ℕ) : ∀ (G : Type u) [CommGroup G] (s : Fin n → G),
    Subgroup.closure (Set.range s) = ⊤ → IsPolycyclic G := by
  induction n with
  | zero =>
    intro G _ s hgen
    refine isPolycyclic_of_top_eq_bot ?_
    rw [← hgen, Set.range_eq_empty, Subgroup.closure_empty]
  | succ n ih =>
    intro G _ s hgen
    set s' : Fin n → G := fun i => s i.succ with hs'
    set N : Subgroup G := Subgroup.closure (Set.range s') with hNdef
    have hmem : ∀ i : Fin n, s' i ∈ N := fun i => Subgroup.subset_closure ⟨i, rfl⟩
    have hNpoly : IsPolycyclic N := by
      refine ih N (fun i => (⟨s' i, hmem i⟩ : ↥N)) ?_
      apply Subgroup.map_injective (Subgroup.subtype_injective N)
      rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
      have himg : (N.subtype : ↥N → G) ''
          Set.range (fun i => (⟨s' i, hmem i⟩ : ↥N)) = Set.range s' := by
        rw [← Set.range_comp]; rfl
      rw [himg, ← hNdef]
    have hgen' : Subgroup.closure ((QuotientGroup.mk' N) '' Set.range s) = ⊤ := by
      rw [← MonoidHom.map_closure, hgen]
      exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)
    have hsub : (QuotientGroup.mk' N) '' Set.range s ⊆
        (Subgroup.zpowers ((QuotientGroup.mk' N) (s 0)) : Set (G ⧸ N)) := by
      rintro _ ⟨x, ⟨i, rfl⟩, rfl⟩
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
      · exact Subgroup.mem_zpowers _
      · have h1 : (QuotientGroup.mk' N) (s j.succ) = 1 :=
          (QuotientGroup.eq_one_iff _).2 (hmem j)
        rw [h1]
        exact Subgroup.one_mem _
    have hle : (⊤ : Subgroup (G ⧸ N)) ≤ Subgroup.zpowers ((QuotientGroup.mk' N) (s 0)) := by
      rw [← hgen']
      exact (Subgroup.closure_le _).2 hsub
    have hcyc : IsCyclic (G ⧸ N) :=
      ⟨⟨(QuotientGroup.mk' N) (s 0), fun x => hle (Subgroup.mem_top x)⟩⟩
    exact isPolycyclic_of_extension N hNpoly isPolycyclic_of_isCyclic

/-- A finitely generated abelian group is polycyclic. -/
theorem isPolycyclic_of_commGroup_of_fg {G : Type*} [CommGroup G] [Group.FG G] :
    IsPolycyclic G := by
  obtain ⟨S, hS⟩ := Group.fg_def.mp ‹Group.FG G›
  have hrange : Set.range (fun i : Fin S.card => ((S.equivFin.symm i : {x // x ∈ S}) : G))
      = (S : Set G) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (S.equivFin.symm i).2
    · intro hy
      exact ⟨S.equivFin ⟨y, hy⟩, by simp⟩
  exact isPolycyclic_commGroup_aux S.card G _ (by rw [hrange]; exact hS)

/-! ### Polycyclic groups are finitely generated -/

theorem fg_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B) (h : Group.FG A) :
    Group.FG B := by
  have := h
  exact Group.fg_of_surjective (f := (e : A →* B)) (fun b => ⟨e.symm b, by simp⟩)

theorem fg_of_isCyclic {C : Type*} [Group C] [IsCyclic C] : Group.FG C := by
  obtain ⟨g, hg⟩ := ‹IsCyclic C›.exists_generator
  refine Group.fg_iff.mpr ⟨{g}, ?_, Set.finite_singleton g⟩
  rw [← Subgroup.zpowers_eq_closure]
  exact eq_top_iff.2 fun x _ => hg x

/-- `Group.FG` is closed under extensions. -/
theorem fg_of_extension {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (hN : Group.FG N) (hQ : Group.FG (G ⧸ N)) : Group.FG G := by
  obtain ⟨S, hS⟩ := (Group.fg_iff_subgroup_fg N).mp hN
  obtain ⟨T0, hT0, hT0fin⟩ := Group.fg_iff.mp hQ
  set T : Set G := (Function.surjInv (QuotientGroup.mk'_surjective N)) '' T0 with hTdef
  have hTfin : T.Finite := hT0fin.image _
  have hTimg : (QuotientGroup.mk' N) '' T = T0 := by
    rw [hTdef, ← Set.image_comp]
    refine Set.image_congr ?_ |>.trans (Set.image_id _)
    intro x _
    exact Function.surjInv_eq (QuotientGroup.mk'_surjective N) x
  have hNle : N ≤ Subgroup.closure ((S : Set G) ∪ T) := by
    rw [← hS]; exact Subgroup.closure_mono Set.subset_union_left
  have hTle : Subgroup.closure T ≤ Subgroup.closure ((S : Set G) ∪ T) :=
    Subgroup.closure_mono Set.subset_union_right
  refine Group.fg_iff.mpr ⟨(S : Set G) ∪ T, ?_, (S.finite_toSet).union hTfin⟩
  rw [eq_top_iff]
  intro x _
  have hx : (QuotientGroup.mk' N) x ∈ (Subgroup.closure T).map (QuotientGroup.mk' N) := by
    rw [MonoidHom.map_closure, hTimg, hT0]
    exact Subgroup.mem_top _
  obtain ⟨y, hy, hxy⟩ := hx
  have hmem : y⁻¹ * x ∈ N := QuotientGroup.eq.mp hxy
  have hfac : x = y * (y⁻¹ * x) := by group
  rw [hfac]
  exact Subgroup.mul_mem _ (hTle hy) (hNle hmem)

/-- A polycyclic group is finitely generated. -/
theorem fg_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) : Group.FG G := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  have key : ∀ j : ℕ, Group.FG ↥(A (t - j)) := by
    intro j
    induction j with
    | zero =>
      rw [Nat.sub_zero, ht]
      exact (Group.fg_iff_subgroup_fg _).mpr Subgroup.FG.bot
    | succ j ihj =>
      rcases le_or_gt t j with hj | hj
      · have hjj : t - (j + 1) = t - j := by omega
        rw [hjj]; exact ihj
      · have he : t - j = (t - (j + 1)) + 1 := by omega
        rw [he] at ihj
        set i := t - (j + 1) with hi
        obtain ⟨hle, hnorm, hcyc⟩ := hstep i
        have hFGP : Group.FG ↥((A (i + 1)).subgroupOf (A i)) :=
          fg_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hle).symm ihj
        have hn := hnorm
        have hc := hcyc
        have hFGQ : Group.FG (↥(A i) ⧸ (A (i + 1)).subgroupOf (A i)) := fg_of_isCyclic
        exact fg_of_extension ((A (i + 1)).subgroupOf (A i)) hFGP hFGQ
  have hfg0 : Group.FG ↥(A 0) := by simpa using key t
  rw [h0] at hfg0
  exact fg_of_mulEquiv Subgroup.topEquiv hfg0

/-! ### Polycyclic groups are finitely presented -/

/-- Freeness: any homomorphism out of a free group lifts along a surjection. -/
theorem exists_lift_of_surjective {α : Type*} {A B : Type*} [Group A] [Group B]
    {f : A →* B} (hf : Function.Surjective f) (g : FreeGroup α →* B) :
    ∃ θ : FreeGroup α →* A, f.comp θ = g := by
  refine ⟨FreeGroup.lift (fun a => Function.surjInv hf (g (FreeGroup.of a))), ?_⟩
  apply FreeGroup.ext_hom
  intro a
  simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of]
  exact Function.surjInv_eq hf _

/-- Tietze / change of generators: the kernel of *any* surjection from a finite-rank free group
onto a finitely presented group is finitely normally generated. -/
theorem ker_isFinitelyNormallyGenerated {C : Type*} [Group C]
    [Group.IsFinitelyPresented C] {n : ℕ} (χ : FreeGroup (Fin n) →* C)
    (hχ : Function.Surjective χ) : χ.ker.IsFinitelyNormallyGenerated := by
  obtain ⟨m, ψ, hψ, R, hRfin, hR⟩ := ‹Group.IsFinitelyPresented C›.out
  obtain ⟨θ, hθ⟩ := exists_lift_of_surjective hψ χ
  obtain ⟨σ, hσ⟩ := exists_lift_of_surjective hχ ψ
  have hθapp : ∀ w, ψ (θ w) = χ w := fun w => DFunLike.congr_fun hθ w
  have hσapp : ∀ w, χ (σ w) = ψ w := fun w => DFunLike.congr_fun hσ w
  set S : Set (FreeGroup (Fin n)) :=
    σ '' R ∪ Set.range (fun i : Fin n => (FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i))) with hSdef
  refine ⟨S, (hRfin.image _).union (Set.finite_range _), ?_⟩
  set K : Subgroup (FreeGroup (Fin n)) := Subgroup.normalClosure S with hKdef
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro x (⟨r, hr, rfl⟩ | ⟨i, rfl⟩)
    · have hrk : r ∈ ψ.ker := by rw [← hR]; exact Subgroup.subset_normalClosure hr
      show χ (σ r) = 1
      rw [hσapp]
      exact hrk
    · show χ ((FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i))) = 1
      rw [map_mul, map_inv, hσapp, hθapp, inv_mul_cancel]
  · have key : (QuotientGroup.mk' K).comp (σ.comp θ) = QuotientGroup.mk' K := by
      apply FreeGroup.ext_hom
      intro i
      have hmem : (FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i)) ∈ K :=
        Subgroup.subset_normalClosure (Or.inr ⟨i, rfl⟩)
      simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply]
      rw [eq_comm, ← inv_mul_eq_one, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
      exact (QuotientGroup.eq_one_iff _).2 hmem
    intro w hw
    have hθw : θ w ∈ ψ.ker := by
      show ψ (θ w) = 1
      rw [hθapp]
      exact hw
    have hmapped : σ (θ w) ∈ K := by
      have h1 : σ (θ w) ∈ (Subgroup.normalClosure R).map σ := ⟨θ w, by rw [hR]; exact hθw, rfl⟩
      have h2 : σ (θ w) ∈ Subgroup.normalClosure (σ '' R) :=
        Subgroup.map_normalClosure_le R σ h1
      exact Subgroup.normalClosure_mono (fun x hx => Or.inl hx) h2
    have hcong : (QuotientGroup.mk' K) (σ (θ w)) = (QuotientGroup.mk' K) w :=
      DFunLike.congr_fun key w
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply,
      (QuotientGroup.eq_one_iff _).2 hmapped] at hcong
    exact (QuotientGroup.eq_one_iff w).1 hcong.symm

theorem fg_of_isFinitelyPresented {A : Type*} [Group A] [h : Group.IsFinitelyPresented A] :
    Group.FG A := by
  obtain ⟨m, φ, hφ, _⟩ := h.out
  exact Group.fg_of_surjective hφ

theorem exists_freeGroup_fin_surjective {A : Type*} [Group A] [Group.FG A] :
    ∃ (m : ℕ) (φ : FreeGroup (Fin m) →* A), Function.Surjective φ := by
  obtain ⟨α, hα, φ₀, hφ₀⟩ := Group.fg_iff_exists_freeGroup_hom_surjective_finite.mp ‹Group.FG A›
  obtain ⟨m, ⟨e⟩⟩ := Finite.exists_equiv_fin α
  exact ⟨m, φ₀.comp (FreeGroup.freeGroupCongr e).symm.toMonoidHom,
    hφ₀.comp (FreeGroup.freeGroupCongr e).symm.surjective⟩

/-- A cyclic group is finitely presented. -/
theorem isFinitelyPresented_of_isCyclic {C : Type*} [Group C] [IsCyclic C] :
    Group.IsFinitelyPresented C := by
  obtain ⟨g, hg⟩ := ‹IsCyclic C›.exists_generator
  have hsurj : Function.Surjective (zpowersHom C g) := by
    intro x
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg x)
    exact ⟨Multiplicative.ofAdd m, by simpa using hm⟩
  refine Group.IsFinitelyPresented.of_surjective (zpowersHom C g) hsurj ?_
  have : Group.FG ↥(zpowersHom C g).ker := fg_of_isCyclic
  exact Subgroup.IsFinitelyNormallyGenerated.of_FG _

/-- P. Hall: an extension of a finitely presented group by a finitely presented group is
finitely presented. -/
theorem isFinitelyPresented_of_extension {G : Type*} [Group G] (N : Subgroup G)
    [hNnormal : N.Normal]
    (hN : Group.IsFinitelyPresented N) (hQ : Group.IsFinitelyPresented (G ⧸ N)) :
    Group.IsFinitelyPresented G := by
  have hNfg : Group.FG N := fg_of_isFinitelyPresented
  have hQfg : Group.FG (G ⧸ N) := fg_of_isFinitelyPresented
  have hGfg : Group.FG G := fg_of_extension N hNfg hQfg
  obtain ⟨n, φ, hφ⟩ := exists_freeGroup_fin_surjective (A := G)
  refine ⟨n, φ, hφ, ?_⟩
  -- `M = φ⁻¹ N` is finitely normally generated in the free group
  have hχ : Function.Surjective ((QuotientGroup.mk' N).comp φ) :=
    (QuotientGroup.mk'_surjective N).comp hφ
  have hMker : ((QuotientGroup.mk' N).comp φ).ker = N.comap φ := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
  obtain ⟨R, hRfin, hR⟩ : (N.comap φ).IsFinitelyNormallyGenerated := by
    rw [← hMker]; exact ker_isFinitelyNormallyGenerated _ hχ
  -- a presentation of `N`, and lifts of its generators to the free group
  obtain ⟨k, ρ₀, hρ₀⟩ := exists_freeGroup_fin_surjective (A := (↥N))
  obtain ⟨S, hSfin, hS⟩ := ker_isFinitelyNormallyGenerated ρ₀ hρ₀
  set ρ : FreeGroup (Fin k) →* G := N.subtype.comp ρ₀ with hρdef
  have hρker : ρ.ker = ρ₀.ker := by
    rw [hρdef]
    ext x
    exact ⟨fun h => Subtype.ext h, fun h => by
      show ((ρ₀ x : ↥N) : G) = 1
      rw [h]; rfl⟩
  have hρrange : ρ.range = N := by
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      exact (ρ₀ z).2
    · intro y hy
      obtain ⟨z, hz⟩ := hρ₀ ⟨y, hy⟩
      exact ⟨z, by rw [hρdef]; simp [hz]⟩
  set μ : Fin k → FreeGroup (Fin n) := fun j => Function.surjInv hφ (ρ (FreeGroup.of j)) with hμdef
  have hμφ : ∀ j, φ (μ j) = ρ (FreeGroup.of j) := fun j => Function.surjInv_eq hφ _
  set lam : FreeGroup (Fin k) →* FreeGroup (Fin n) := FreeGroup.lift μ with hlamdef
  have hlamof : ∀ j, lam (FreeGroup.of j) = μ j := by
    intro j; rw [hlamdef]; simp
  have hlam : ∀ z, φ (lam z) = ρ z := by
    have hcomp : φ.comp lam = ρ := by
      apply FreeGroup.ext_hom
      intro j
      simp only [MonoidHom.comp_apply, hlamof j, hμφ j]
    exact fun z => DFunLike.congr_fun hcomp z
  set Msub : Subgroup (FreeGroup (Fin n)) := Subgroup.closure (Set.range μ) with hMsubdef
  have hMsubmap : Msub.map φ = N := by
    have h1 : φ '' Set.range μ = ρ '' Set.range FreeGroup.of := by
      rw [← Set.range_comp, ← Set.range_comp]
      exact congrArg Set.range (funext hμφ)
    rw [hMsubdef, MonoidHom.map_closure, h1, ← MonoidHom.map_closure,
      FreeGroup.closure_range_of, ← MonoidHom.range_eq_map, hρrange]
  -- a choice of `Msub`-representative for every element whose image lies in `N`
  have hex : ∀ x : FreeGroup (Fin n), ∃ u : FreeGroup (Fin n),
      φ x ∈ N → (u ∈ Msub ∧ φ u = φ x) := by
    intro x
    by_cases hx : φ x ∈ N
    · rw [← hMsubmap] at hx
      obtain ⟨u, hu, hux⟩ := hx
      exact ⟨u, fun _ => ⟨hu, hux⟩⟩
    · exact ⟨1, fun h => absurd h hx⟩
  choose c hc using hex
  have hμN : ∀ j, φ (μ j) ∈ N := by
    intro j
    rw [hμφ j, ← hρrange]
    exact ⟨FreeGroup.of j, rfl⟩
  have hconjN : ∀ (i : Fin n) (j : Fin k),
      φ (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹) ∈ N := by
    intro i j
    simp only [map_mul, map_inv]
    exact hNnormal.conj_mem _ (hμN j) _
  have hconjN' : ∀ (i : Fin n) (j : Fin k),
      φ ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i) ∈ N := by
    intro i j
    simp only [map_mul, map_inv]
    exact hNnormal.conj_mem' _ (hμN j) _
  have hRsub : ∀ r ∈ R, φ r ∈ N := by
    intro r hr
    have hrm : r ∈ N.comap φ := by rw [← hR]; exact Subgroup.subset_normalClosure hr
    exact hrm
  -- the finite set of relations
  set T : Set (FreeGroup (Fin n)) :=
    ((fun x => x * (c x)⁻¹) '' R ∪
      Set.range (fun p : Fin n × Fin k =>
        (FreeGroup.of p.1 * μ p.2 * (FreeGroup.of p.1)⁻¹) *
          (c (FreeGroup.of p.1 * μ p.2 * (FreeGroup.of p.1)⁻¹))⁻¹) ∪
      Set.range (fun p : Fin n × Fin k =>
        ((FreeGroup.of p.1)⁻¹ * μ p.2 * FreeGroup.of p.1) *
          (c ((FreeGroup.of p.1)⁻¹ * μ p.2 * FreeGroup.of p.1))⁻¹)) ∪
      lam '' S with hTdef
  have hTfin : T.Finite :=
    (((hRfin.image _).union (Set.finite_range _)).union (Set.finite_range _)).union
      (hSfin.image _)
  refine ⟨T, hTfin, ?_⟩
  set L : Subgroup (FreeGroup (Fin n)) := Subgroup.normalClosure T with hLdef
  have hmemT : ∀ x ∈ T, x ∈ L := fun x hx => Subgroup.subset_normalClosure hx
  have hker_c : ∀ x, φ x ∈ N → x * (c x)⁻¹ ∈ φ.ker := by
    intro x hx
    simp [MonoidHom.mem_ker, (hc x hx).2]
  -- one inclusion: every relation lies in the kernel
  have hLK : L ≤ φ.ker := by
    rw [hLdef]
    apply Subgroup.normalClosure_le_normal
    rintro x (((⟨r, hr, rfl⟩ | ⟨⟨i, j⟩, rfl⟩) | ⟨⟨i, j⟩, rfl⟩) | ⟨s, hs, rfl⟩)
    · exact hker_c r (hRsub r hr)
    · exact hker_c _ (hconjN i j)
    · exact hker_c _ (hconjN' i j)
    · have hsk : s ∈ ρ₀.ker := by rw [← hS]; exact Subgroup.subset_normalClosure hs
      show φ (lam s) = 1
      rw [hlam s, ← hρker] at *
      exact hsk
  refine le_antisymm hLK ?_
  -- the other inclusion
  set π : FreeGroup (Fin n) →* FreeGroup (Fin n) ⧸ L := QuotientGroup.mk' L with hπdef
  have hπsurj : Function.Surjective π := QuotientGroup.mk'_surjective L
  set P : Subgroup (FreeGroup (Fin n) ⧸ L) := Msub.map π with hPdef
  have hP_eq : P = Subgroup.closure (Set.range (fun j => π (μ j))) := by
    rw [hPdef, hMsubdef, MonoidHom.map_closure, ← Set.range_comp]
    rfl
  have hpi_eq : ∀ x, x * (c x)⁻¹ ∈ L → π x = π (c x) := by
    intro x hx
    have h1 : π (x * (c x)⁻¹) = 1 := (QuotientGroup.eq_one_iff _).2 hx
    rw [map_mul, map_inv, mul_inv_eq_one] at h1
    exact h1
  have hcP : ∀ x, φ x ∈ N → π (c x) ∈ P := by
    intro x hx
    exact ⟨c x, (hc x hx).1, rfl⟩
  have hconjP : ∀ (i : Fin n) (j : Fin k),
      π (FreeGroup.of i) * π (μ j) * (π (FreeGroup.of i))⁻¹ ∈ P := by
    intro i j
    have hT : (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹) *
        (c (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹))⁻¹ ∈ T :=
      Or.inl (Or.inl (Or.inr ⟨(i, j), rfl⟩))
    have heq := hpi_eq _ (hmemT _ hT)
    rw [map_mul, map_mul, map_inv] at heq
    rw [heq]
    exact hcP _ (hconjN i j)
  have hconjP' : ∀ (i : Fin n) (j : Fin k),
      (π (FreeGroup.of i))⁻¹ * π (μ j) * π (FreeGroup.of i) ∈ P := by
    intro i j
    have hT : ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i) *
        (c ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i))⁻¹ ∈ T :=
      Or.inl (Or.inr ⟨(i, j), rfl⟩)
    have heq := hpi_eq _ (hmemT _ hT)
    rw [map_mul, map_mul, map_inv] at heq
    rw [heq]
    exact hcP _ (hconjN' i j)
  have hconj_into : ∀ g : FreeGroup (Fin n) ⧸ L,
      (∀ j, g * π (μ j) * g⁻¹ ∈ P) → ∀ h ∈ P, g * h * g⁻¹ ∈ P := by
    intro g hg h hh
    have hsub : Subgroup.closure (Set.range (fun j => π (μ j))) ≤
        P.comap ((MulAut.conj g : _ ≃* _) : _ →* _) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, rfl⟩
      simpa [MulAut.conj_apply] using hg j
    have := hsub (hP_eq.le hh)
    simpa [MulAut.conj_apply] using this
  have hnormalizer : ∀ i : Fin n,
      π (FreeGroup.of i) ∈ Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L)) := by
    intro i
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · exact fun hh => hconj_into _ (fun j => hconjP i j) h hh
    · intro hh
      have h2 := hconj_into (π (FreeGroup.of i))⁻¹
        (by intro j; rw [inv_inv]; exact hconjP' i j) _ hh
      have e : (π (FreeGroup.of i))⁻¹ * (π (FreeGroup.of i) * h * (π (FreeGroup.of i))⁻¹) *
          (π (FreeGroup.of i))⁻¹⁻¹ = h := by group
      rwa [e] at h2
  have hnormtop : Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L)) = ⊤ := by
    have hc2 : (Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))).comap π = ⊤ := by
      rw [eq_top_iff, ← FreeGroup.closure_range_of (Fin n), Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact hnormalizer i
    calc Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))
        = ((Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))).comap π).map π :=
          (Subgroup.map_comap_eq_self_of_surjective hπsurj _).symm
      _ = ⊤ := by rw [hc2]; exact Subgroup.map_top_of_surjective _ hπsurj
  have hPnormal : P.Normal := Subgroup.normalizer_eq_top_iff.mp hnormtop
  have hMle : (N.comap φ).map π ≤ P := by
    rw [← hR]
    refine le_trans (Subgroup.map_normalClosure_le R π) (Subgroup.normalClosure_le_normal ?_)
    rintro _ ⟨r, hr, rfl⟩
    have hT : r * (c r)⁻¹ ∈ T := Or.inl (Or.inl (Or.inl ⟨r, hr, rfl⟩))
    have heq := hpi_eq _ (hmemT _ hT)
    rw [heq]
    exact hcP _ (hRsub r hr)
  have hPrange : P = (π.comp lam).range := by
    rw [hP_eq, MonoidHom.range_eq_map, ← FreeGroup.closure_range_of (Fin k),
      MonoidHom.map_closure, ← Set.range_comp]
    exact congrArg Subgroup.closure (congrArg Set.range (funext fun j => by
      simp [hlamof j]))
  intro w hw
  have hwM : w ∈ N.comap φ := by
    have : φ w = 1 := hw
    simp [Subgroup.mem_comap, this]
  have hwP : π w ∈ P := hMle ⟨w, hwM, rfl⟩
  rw [hPrange] at hwP
  obtain ⟨z, hz⟩ := hwP
  have hdiff : (lam z)⁻¹ * w ∈ L := QuotientGroup.eq.mp hz
  have hφd : φ ((lam z)⁻¹ * w) = 1 := hLK hdiff
  have hrz : ρ z = 1 := by
    rw [← hlam z]
    have hw1 : φ w = 1 := hw
    rw [map_mul, map_inv, hw1, mul_one, inv_eq_one] at hφd
    exact hφd
  have hzker : z ∈ Subgroup.normalClosure S := by
    rw [hS, ← hρker]
    exact hrz
  have hlamz : lam z ∈ L := by
    have h1 : lam z ∈ (Subgroup.normalClosure S).map lam := ⟨z, hzker, rfl⟩
    have h2 : lam z ∈ Subgroup.normalClosure (lam '' S) :=
      Subgroup.map_normalClosure_le S lam h1
    exact Subgroup.normalClosure_le_normal (fun x hx => hmemT x (Or.inr hx)) h2
  have hπw : π w = 1 := by
    rw [← hz]
    exact (QuotientGroup.eq_one_iff _).2 hlamz
  exact (QuotientGroup.eq_one_iff w).1 hπw

/-- A polycyclic group is finitely presented. -/
theorem isFinitelyPresented_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) :
    Group.IsFinitelyPresented G := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  have key : ∀ j : ℕ, Group.IsFinitelyPresented ↥(A (t - j)) := by
    intro j
    induction j with
    | zero =>
      rw [Nat.sub_zero, ht]
      have : Finite ↥(⊥ : Subgroup G) := inferInstance
      infer_instance
    | succ j ihj =>
      rcases le_or_gt t j with hj | hj
      · have hjj : t - (j + 1) = t - j := by omega
        rw [hjj]; exact ihj
      · have he : t - j = (t - (j + 1)) + 1 := by omega
        rw [he] at ihj
        set i := t - (j + 1) with hi
        obtain ⟨hle, hnorm, hcyc⟩ := hstep i
        have hFPP : Group.IsFinitelyPresented ↥((A (i + 1)).subgroupOf (A i)) := by
          have := ihj
          exact Group.IsFinitelyPresented.equiv (Subgroup.subgroupOfEquivOfLe hle).symm
        have hn := hnorm
        have hc := hcyc
        have hFPQ : Group.IsFinitelyPresented (↥(A i) ⧸ (A (i + 1)).subgroupOf (A i)) :=
          isFinitelyPresented_of_isCyclic
        exact isFinitelyPresented_of_extension ((A (i + 1)).subgroupOf (A i)) hFPP hFPQ
  have hfp0 : Group.IsFinitelyPresented ↥(A 0) := by
    have hkt := key t
    rwa [Nat.sub_self] at hkt
  rw [h0] at hfp0
  have := hfp0
  exact Group.IsFinitelyPresented.equiv Subgroup.topEquiv

end Lib
end MilnorWolf

/-!
# A finitely generated nilpotent group is finitely presented (Chou, p. 400)

Chou uses, on p. 400, the standard fact that a finitely generated nilpotent group is finitely
presented: "`C₁` is also finitely generated and hence is finitely presented".  The route taken
here is the classical one: a finitely generated nilpotent group is *polycyclic*
(`MilnorWolf.IsPolycyclic`, Wolf Proposition 4.1 (1)), and a polycyclic group is finitely
presented by `MilnorWolf.Lib.isFinitelyPresented_of_isPolycyclic`.

The substantive content is that every term of the lower central series of a finitely generated
group is finitely generated.  This is proved here from two elementary facts:

* if `G = ⟨S⟩` then `⁅normalClosure X, G⁆` is the normal closure of the finitely many commutators
  `⁅x, s⁆`, `x ∈ X`, `s ∈ S` (`commutator_normalClosure_top`) — so each `lowerCentralSeries ⊤ n`
  is the normal closure of a finite set (`exists_finite_normalClosure_lowerCentralSeries`);
* if `⁅normalClosure X, G⁆ ≤ M` with `M` normal, then `normalClosure X ≤ closure X ⊔ M`
  (`normalClosure_le_closure_sup`), because modulo `M` the conjugates of `X` are the elements
  of `X`.

Applying the second with `M = lowerCentralSeries ⊤ (n + 1)` gives
`lowerCentralSeries ⊤ n = closure X ⊔ lowerCentralSeries ⊤ (n + 1)`, and a downward induction
starting from the vanishing term of a nilpotent group makes every term finitely generated
(`fg_lowerCentralSeries`).  The polycyclicity is then an induction on the nilpotency class over
all groups at once: the last nonzero term `A = lowerCentralSeries ⊤ n` is central, hence abelian,
and finitely generated, so polycyclic; the quotient `G ⧸ A` is finitely generated with
`lowerCentralSeries ⊤ n = ⊥`, so polycyclic by induction; and polycyclicity is closed under
extensions.
-/


namespace Chou
namespace Lib

open Subgroup
open scoped commutatorElement

/-- A finitely generated group with commutative multiplication is polycyclic. -/
theorem isPolycyclic_of_mul_comm {H : Type*} [Group H] [Group.FG H]
    (hcomm : ∀ a b : H, a * b = b * a) : MilnorWolf.IsPolycyclic H := by
  let _ : CommGroup H := { (inferInstance : Group H) with mul_comm := hcomm }
  exact MilnorWolf.Lib.isPolycyclic_of_commGroup_of_fg

/-- If `G` is generated by `S`, then `⁅normalClosure X, G⁆` is the normal closure of the set of
commutators `⁅x, s⁆` with `x ∈ X` and `s ∈ S`. -/
theorem commutator_normalClosure_top {G : Type*} [Group G] {S : Set G}
    (hS : closure S = (⊤ : Subgroup G)) (X : Set G) :
    ⁅normalClosure X, (⊤ : Subgroup G)⁆
      = normalClosure (Set.image2 (fun x s => ⁅x, s⁆) X S) := by
  refine le_antisymm ?_ ?_
  · set K := normalClosure (Set.image2 (fun x s => ⁅x, s⁆) X S) with hK
    set π := QuotientGroup.mk' K with hπ
    have hsurj : Function.Surjective π := QuotientGroup.mk'_surjective K
    -- each `π x`, `x ∈ X`, is central in `G ⧸ K`, because it commutes with the generators
    have hcenter : ∀ x ∈ X, π x ∈ Subgroup.center (G ⧸ K) := by
      intro x hx
      have htop : (⊤ : Subgroup (G ⧸ K)) ≤ Subgroup.centralizer {π x} := by
        rw [← Subgroup.map_top_of_surjective π hsurj, ← hS, MonoidHom.map_closure,
          Subgroup.closure_le]
        rintro y ⟨s, hs, rfl⟩
        rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
        rintro h rfl
        rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement]
        rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
        exact Subgroup.subset_normalClosure ⟨x, hx, s, hs, rfl⟩
      rw [Subgroup.mem_center_iff]
      intro g
      exact ((Subgroup.mem_centralizer_iff.mp (htop (Subgroup.mem_top g))) _ rfl).symm
    have hncl : normalClosure (π '' X) ≤ Subgroup.center (G ⧸ K) :=
      Subgroup.normalClosure_le_normal (by rintro y ⟨x, hx, rfl⟩; exact hcenter x hx)
    have hmap : (⁅normalClosure X, (⊤ : Subgroup G)⁆).map π = ⊥ := by
      rw [Subgroup.map_commutator, Subgroup.map_normalClosure _ _ hsurj,
        Subgroup.map_top_of_surjective π hsurj, eq_bot_iff, Subgroup.commutator_le]
      intro a ha b _
      have hac := Subgroup.mem_center_iff.mp (hncl ha)
      rw [Subgroup.mem_bot, commutatorElement_def, ← hac b]
      group
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hmap
    exact hmap
  · refine Subgroup.normalClosure_le_normal ?_
    rintro y ⟨x, hx, s, hs, rfl⟩
    exact Subgroup.commutator_mem_commutator (Subgroup.subset_normalClosure hx)
      (Subgroup.mem_top s)

/-- If `⁅normalClosure X, G⁆ ≤ M` with `M` normal, then `normalClosure X ≤ closure X ⊔ M`:
modulo `M` the normal closure of `X` is generated by the image of `X`. -/
theorem normalClosure_le_closure_sup {G : Type*} [Group G] (X : Set G) (M : Subgroup G)
    [M.Normal] (hM : ⁅normalClosure X, (⊤ : Subgroup G)⁆ ≤ M) :
    normalClosure X ≤ closure X ⊔ M := by
  have hM' : ⁅(⊤ : Subgroup G), normalClosure X⁆ ≤ M := by
    rw [Subgroup.commutator_comm]; exact hM
  have hdef : normalClosure X = closure (Group.conjugatesOfSet X) := rfl
  rw [hdef, Subgroup.closure_le]
  intro y hy
  obtain ⟨x, hx, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hy
  obtain ⟨c, hc⟩ := isConj_iff.mp hconj
  have hcx : ⁅c, x⁆ ∈ M :=
    hM' (Subgroup.commutator_mem_commutator (Subgroup.mem_top c)
      (Subgroup.subset_normalClosure hx))
  have hy' : y = ⁅c, x⁆ * x := by
    rw [commutatorElement_def, ← hc]; group
  rw [SetLike.mem_coe, hy']
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hcx)
    (Subgroup.mem_sup_left (Subgroup.subset_closure hx))

/-- Every term of the lower central series of a group generated by a finite set `S` is the normal
closure of a finite set of iterated commutators of elements of `S`. -/
theorem exists_finite_normalClosure_lowerCentralSeries {G : Type*} [Group G] {S : Set G}
    (hSfin : S.Finite) (hS : closure S = (⊤ : Subgroup G)) (n : ℕ) :
    ∃ X : Set G, X.Finite ∧ normalClosure X = (⊤ : Subgroup G).lowerCentralSeries n := by
  induction n with
  | zero =>
    refine ⟨S, hSfin, ?_⟩
    rw [Subgroup.lowerCentralSeries_zero, eq_top_iff, ← hS, Subgroup.closure_le]
    exact Subgroup.subset_normalClosure
  | succ n ih =>
    obtain ⟨X, hXfin, hX⟩ := ih
    refine ⟨Set.image2 (fun x s => ⁅x, s⁆) X S, Set.Finite.image2 _ hXfin hSfin, ?_⟩
    rw [← commutator_normalClosure_top hS X, hX, Subgroup.lowerCentralSeries_succ]

/-- Each term of the lower central series of a finitely generated group whose lower central series
reaches `⊥` is a finitely generated subgroup. -/
theorem fg_lowerCentralSeries {G : Type*} [Group G] [Group.FG G] {c : ℕ}
    (hc : (⊤ : Subgroup G).lowerCentralSeries c = ⊥) (n : ℕ) :
    ((⊤ : Subgroup G).lowerCentralSeries n).FG := by
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff _).mp (Group.fg_def.mp ‹Group.FG G›)
  have key : ∀ j : ℕ, ((⊤ : Subgroup G).lowerCentralSeries (c - j)).FG := by
    intro j
    induction j with
    | zero => rw [Nat.sub_zero, hc]; exact Subgroup.FG.bot
    | succ j ihj =>
      rcases le_or_gt c j with hj | hj
      · rw [show c - (j + 1) = c - j by omega]; exact ihj
      · rw [show c - j = (c - (j + 1)) + 1 by omega] at ihj
        set k := c - (j + 1) with hk
        obtain ⟨X, hXfin, hX⟩ := exists_finite_normalClosure_lowerCentralSeries hSfin hS k
        have hstep : (⊤ : Subgroup G).lowerCentralSeries k
            = closure X ⊔ (⊤ : Subgroup G).lowerCentralSeries (k + 1) := by
          refine le_antisymm ?_ ?_
          · rw [← hX]
            refine normalClosure_le_closure_sup X _ ?_
            rw [hX]
            exact le_of_eq (Subgroup.lowerCentralSeries_succ ⊤ k).symm
          · refine sup_le ?_ (Subgroup.lowerCentralSeries_antitone ⊤ (Nat.le_succ k))
            rw [← hX, Subgroup.closure_le]
            exact Subgroup.subset_normalClosure
        rw [hstep]
        exact Subgroup.FG.sup ((Subgroup.fg_iff _).mpr ⟨X, rfl, hXfin⟩) ihj
  rcases le_or_gt c n with hn | hn
  · have hbot : (⊤ : Subgroup G).lowerCentralSeries n = ⊥ := by
      rw [eq_bot_iff, ← hc]; exact Subgroup.lowerCentralSeries_antitone ⊤ hn
    rw [hbot]; exact Subgroup.FG.bot
  · have hk := key (c - n)
    rwa [show c - (c - n) = n by omega] at hk

/-- A finitely generated group whose lower central series vanishes at step `n` is polycyclic.
The statement is universally quantified over the group so that the inductive hypothesis applies to
the quotient `G ⧸ lowerCentralSeries ⊤ n`. -/
theorem isPolycyclic_of_lowerCentralSeries_eq_bot :
    ∀ (n : ℕ) {G : Type u} [Group G] [Group.FG G],
      (⊤ : Subgroup G).lowerCentralSeries n = ⊥ → MilnorWolf.IsPolycyclic G := by
  intro n
  induction n with
  | zero =>
    intro G _ _ h
    exact MilnorWolf.Lib.isPolycyclic_of_top_eq_bot (by simpa using h)
  | succ n ih =>
    intro G _ _ h
    set A := (⊤ : Subgroup G).lowerCentralSeries n with hA
    have hAnorm : A.Normal := by rw [hA]; infer_instance
    -- `A` is central, because `⁅A, G⁆ = lowerCentralSeries ⊤ (n + 1) = ⊥`
    have hcentral : ∀ a ∈ A, ∀ g : G, a * g = g * a := by
      intro a ha g
      have hmem : ⁅a, g⁆ ∈ (⊤ : Subgroup G).lowerCentralSeries (n + 1) :=
        Subgroup.commutator_mem_commutator ha (Subgroup.mem_top g)
      rw [h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at hmem
      exact hmem
    -- the quotient is finitely generated and its lower central series vanishes one step earlier
    have hQfg : Group.FG (G ⧸ A) := QuotientGroup.fg A
    have hQlcs : (⊤ : Subgroup (G ⧸ A)).lowerCentralSeries n = ⊥ := by
      have hmap := Subgroup.map_lowerCentralSeries (⊤ : Subgroup G) (QuotientGroup.mk' A) n
      rw [Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective A)] at hmap
      rw [← hmap, ← hA, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    have hQ : MilnorWolf.IsPolycyclic (G ⧸ A) := ih hQlcs
    -- `A` is finitely generated, hence abelian and finitely generated, hence polycyclic
    have hAfg : Group.FG A := by
      refine (Group.fg_iff_subgroup_fg A).mpr ?_
      rw [hA]
      exact fg_lowerCentralSeries h n
    have hAcomm : ∀ a b : A, a * b = b * a := by
      intro a b
      exact Subtype.ext (hcentral a.1 a.2 b.1)
    exact MilnorWolf.Lib.isPolycyclic_of_extension A (isPolycyclic_of_mul_comm hAcomm) hQ

/-- A finitely generated nilpotent group is polycyclic. -/
theorem isPolycyclic_of_isNilpotent_of_fg {G : Type*} [Group G] [Group.FG G]
    [Group.IsNilpotent G] : MilnorWolf.IsPolycyclic G := by
  obtain ⟨n, hn⟩ := Subgroup.nilpotent_iff_lowerCentralSeries.mp ‹Group.IsNilpotent G›
  exact isPolycyclic_of_lowerCentralSeries_eq_bot n hn

/-- Chou, p. 400 (external): a finitely generated nilpotent group is finitely presented. -/
theorem isFinitelyPresented_of_isNilpotent_of_fg' {G : Type*} [Group G] [Group.FG G]
    [Group.IsNilpotent G] : Group.IsFinitelyPresented G :=
  MilnorWolf.Lib.isFinitelyPresented_of_isPolycyclic isPolycyclic_of_isNilpotent_of_fg

end Lib
end Chou

/-!
# Chou, Lemma 3.1 in Rosenblatt's form (pp. 399-401)

Chou's Lemma 3.1 (pp. 399-400) says that a finitely generated extension of an almost nilpotent
group by an almost nilpotent group is either almost nilpotent or of exponential growth.  On
p. 401 he records that the same proof gives Rosenblatt's sharpening, with "contains a free
subsemigroup on two generators" in place of "has exponential growth": that is the statement
proved here.

The proof is the proof of Lemma 3.1 with each growth hypothesis replaced by its
free-subsemigroup twin.  Writing `C = B ⧸ A`:

* `C` is finitely generated and almost nilpotent, hence virtually polycyclic, so `A` is
  finitely generated — by Rosenblatt's Lemmas 4.8 and 4.9
  (`fg_of_isVirtuallyPolycyclic_quotient_of_not_hasFreeSubsemigroupOfRankTwo`) in place of
  Milnor's Lemma 3.
* Since `A` is finitely generated, M. Hall's theorem makes the intersection `A₀` of all
  subgroups of `A` of the index of a fixed nilpotent subgroup of finite index a subgroup of
  finite index which every automorphism of `A` carries into itself; conjugation by elements
  of `B` is such an automorphism, so `A₀` is normal in `B`, nilpotent, and of finite index
  in `A`.
* `B ⧸ A₀` is an extension of `B ⧸ A` by the finite group `A ⧸ A₀`, hence almost nilpotent;
  pulling a normal nilpotent subgroup `K` of finite index back to `B` gives a finite-index
  subgroup of `B` which is an extension of the nilpotent `A₀` by the nilpotent `K`, hence
  solvable.
* Rosenblatt's theorem (`isVirtuallyNilpotent_or_hasFreeSubsemigroupOfRankTwo_of_isSolvable`)
  applies to that finitely generated solvable subgroup.  It cannot contain a free subsemigroup
  on two generators, since a subgroup of `B` containing one would give one in `B`; so it is
  almost nilpotent, and therefore so is `B`.

The only hereditary property of "no free subsemigroup on two generators" needed is that it
passes to subgroups, which is immediate: an injective homomorphism carries a free subsemigroup
on two generators to one, because `FreeMonoid.lift ![f a, f b] = f ∘ FreeMonoid.lift ![a, b]`.
The quotient direction, which needs generators to be lifted, is not used here.
-/

namespace Chou
namespace Lib

open Chou

/-! ### Small general facts -/

/-- A subgroup of a nilpotent subgroup is nilpotent. -/
theorem isNilpotent_of_le {G : Type*} [Group G] {H K : Subgroup G} (hHK : H ≤ K)
    (hK : Group.IsNilpotent K) : Group.IsNilpotent H := by
  have : Group.IsNilpotent K := hK
  have : Group.IsNilpotent (H.subgroupOf K) := Subgroup.isNilpotent _
  exact (Group.isNilpotent_congr (Subgroup.subgroupOfEquivOfLe hHK)).1 inferInstance

/-- A virtually nilpotent group has a *normal* nilpotent subgroup of finite index: take the
normal core of a nilpotent subgroup of finite index. -/
theorem exists_normal_isNilpotent_finiteIndex {G : Type*} [Group G]
    (h : Group.IsVirtuallyNilpotent G) :
    ∃ N : Subgroup G, N.Normal ∧ Group.IsNilpotent N ∧ N.FiniteIndex := by
  obtain ⟨H, hnil, hidx⟩ := h
  have : H.FiniteIndex := hidx
  exact ⟨H.normalCore, Subgroup.normalCore_normal H,
    isNilpotent_of_le (Subgroup.normalCore_le H) hnil, inferInstance⟩

/-- A finitely generated almost nilpotent group is virtually polycyclic: a nilpotent subgroup of
finite index is finitely generated by Schreier, and a finitely generated nilpotent group is
polycyclic. -/
theorem isVirtuallyPolycyclic_of_isVirtuallyNilpotent_of_fg {C : Type*} [Group C] [Group.FG C]
    (h : Group.IsVirtuallyNilpotent C) :
    ∃ H : Subgroup C, H.FiniteIndex ∧ MilnorWolf.IsPolycyclic H := by
  obtain ⟨H, hHnil, hHidx⟩ := h
  have : Group.IsNilpotent H := hHnil
  have : H.FiniteIndex := hHidx
  have : Group.FG H := inferInstance
  exact ⟨H, hHidx, isPolycyclic_of_isNilpotent_of_fg⟩

/-! ### Free subsemigroups on two generators pass down to subgroups -/

/-- A free subsemigroup on two generators pushes forward along an injective homomorphism: if
`f` is one-to-one and `a, b` generate a free subsemigroup of `G`, then `f a, f b` generate one
of `H`, because `FreeMonoid.lift ![f a, f b] = f ∘ FreeMonoid.lift ![a, b]`. -/
theorem hasFreeSubsemigroupOfRankTwo_of_injective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f) (h : HasFreeSubsemigroupOfRankTwo G) :
    HasFreeSubsemigroupOfRankTwo H := by
  obtain ⟨a, b, hab⟩ := h
  refine ⟨f a, f b, ?_⟩
  have key : (FreeMonoid.lift ![f a, f b] : FreeMonoid (Fin 2) →* H)
      = f.comp (FreeMonoid.lift ![a, b]) := by
    refine FreeMonoid.hom_eq fun x => ?_
    fin_cases x <;> simp
  rw [key, MonoidHom.coe_comp]
  exact hf.comp hab

/-- A free subsemigroup on two generators of a subgroup is one of the whole group. -/
theorem hasFreeSubsemigroupOfRankTwo_of_subgroup {G : Type*} [Group G] (H : Subgroup G)
    (h : HasFreeSubsemigroupOfRankTwo H) : HasFreeSubsemigroupOfRankTwo G :=
  hasFreeSubsemigroupOfRankTwo_of_injective H.subtype (Subgroup.subtype_injective H) h

/-- Contrapositive of `hasFreeSubsemigroupOfRankTwo_of_subgroup`: the hypothesis of Lemma 3.1
in Rosenblatt's form passes to subgroups. -/
theorem not_hasFreeSubsemigroupOfRankTwo_subgroup {G : Type*} [Group G]
    (h : ¬ HasFreeSubsemigroupOfRankTwo G) (H : Subgroup G) :
    ¬ HasFreeSubsemigroupOfRankTwo H :=
  fun hH => h (hasFreeSubsemigroupOfRankTwo_of_subgroup H hH)

/-! ### Conjugation as an automorphism of a normal subgroup -/

/-- Conjugation by `b` restricts to an automorphism of a normal subgroup `A`. -/
def conjAut {B : Type*} [Group B] (A : Subgroup B) [hA : A.Normal] (b : B) : A ≃* A where
  toFun a := ⟨b * (a : B) * b⁻¹, hA.conj_mem (a : B) a.2 b⟩
  invFun a := ⟨b⁻¹ * (a : B) * b, by simpa using hA.conj_mem (a : B) a.2 b⁻¹⟩
  left_inv a := by
    apply Subtype.ext
    show b⁻¹ * (b * (a : B) * b⁻¹) * b = (a : B)
    group
  right_inv a := by
    apply Subtype.ext
    show b * (b⁻¹ * (a : B) * b) * b⁻¹ = (a : B)
    group
  map_mul' x y := by
    apply Subtype.ext
    show b * ((x : B) * (y : B)) * b⁻¹ = (b * (x : B) * b⁻¹) * (b * (y : B) * b⁻¹)
    group

@[simp] theorem coe_conjAut {B : Type*} [Group B] (A : Subgroup B) [A.Normal] (b : B) (a : A) :
    ((conjAut A b a : A) : B) = b * (a : B) * b⁻¹ := rfl

/-! ### The characteristic finite-index subgroup produced by Hall's theorem -/

/-- p. 400: in a finitely generated group the subgroups of a given finite index `m` are finite in
number (Hall), so their intersection has finite index; being the intersection of *all* of them it
is carried into itself by every automorphism. -/
theorem exists_index_ne_zero_map_le {A : Type*} [Group A] [Group.FG A] {m : ℕ} (hm : m ≠ 0) :
    ∃ N : Subgroup A, N.index ≠ 0 ∧ (∀ H : Subgroup A, H.index = m → N ≤ H) ∧
      ∀ φ : A ≃* A, N.map (φ : A →* A) ≤ N := by
  classical
  have : Finite {H : Subgroup A // H.index = m} := hall_finite_subgroups_of_index m hm
  refine ⟨⨅ H : {H : Subgroup A // H.index = m}, (H : Subgroup A), ?_, ?_, ?_⟩
  · exact Subgroup.index_iInf_ne_zero fun H => by rw [H.2]; exact hm
  · intro H hH
    exact iInf_le (fun H : {H : Subgroup A // H.index = m} => (H : Subgroup A)) ⟨H, hH⟩
  · intro φ
    refine le_iInf ?_
    rintro ⟨H, hH⟩
    rw [Subgroup.map_le_iff_le_comap]
    have hcomap : (H.comap (φ : A →* A)).index = m := by
      rw [Subgroup.index_comap_of_surjective _ φ.surjective]
      exact hH
    exact iInf_le (fun H : {H : Subgroup A // H.index = m} => (H : Subgroup A))
      ⟨H.comap (φ : A →* A), hcomap⟩

/-- p. 400: a normal, finitely generated, almost nilpotent subgroup `A` of `B` contains a
subgroup `A₀` which is nilpotent, of finite index in `A`, and normal in `B`. -/
theorem exists_normal_le_isNilpotent_of_isVirtuallyNilpotent {B : Type*} [Group B] (A : Subgroup B)
    [A.Normal] [Group.FG A] (hA : Group.IsVirtuallyNilpotent A) :
    ∃ A₀ : Subgroup B, A₀.Normal ∧ A₀ ≤ A ∧ Group.IsNilpotent A₀ ∧
      (A₀.subgroupOf A).FiniteIndex := by
  obtain ⟨A₁, hnil, hidx⟩ := hA
  obtain ⟨N, hNidx, hNle, hNinv⟩ :=
    exists_index_ne_zero_map_le (A := A) (m := A₁.index) hidx.index_ne_zero
  have hNnil : Group.IsNilpotent N := isNilpotent_of_le (hNle A₁ rfl) hnil
  refine ⟨N.map A.subtype, ⟨?_⟩, Subgroup.map_subtype_le N, ?_, ?_⟩
  · rintro x hx b
    rw [Subgroup.mem_map] at hx ⊢
    obtain ⟨n, hn, rfl⟩ := hx
    exact ⟨conjAut A b n, hNinv (conjAut A b) (Subgroup.mem_map_of_mem _ hn), rfl⟩
  · exact (Group.isNilpotent_congr (N.equivMapOfInjective A.subtype A.subtype_injective)).1 hNnil
  · have hsub : (N.map A.subtype).subgroupOf A = N :=
      Subgroup.comap_map_eq_self_of_injective A.subtype_injective N
    rw [hsub]
    exact ⟨hNidx⟩

/-! ### Pulling a subgroup back along a surjection -/

/-- The restriction of `q` to the preimage of `K`, viewed as a homomorphism onto `K`. -/
def qRestrictComap {G Q : Type*} [Group G] [Group Q] (q : G →* Q) (K : Subgroup Q) :
    (K.comap q) →* K :=
  (q.comp (K.comap q).subtype).codRestrict K (fun d => d.2)

theorem ker_qRestrictComap {G Q : Type*} [Group G] [Group Q] (q : G →* Q) (K : Subgroup Q) :
    (qRestrictComap q K).ker = q.ker.subgroupOf (K.comap q) := by
  ext d
  simp only [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, Subtype.ext_iff, OneMemClass.coe_one]
  rfl

theorem surjective_qRestrictComap {G Q : Type*} [Group G] [Group Q] {q : G →* Q}
    (hq : Function.Surjective q) (K : Subgroup Q) :
    Function.Surjective (qRestrictComap q K) := by
  rintro ⟨k, hk⟩
  obtain ⟨g, rfl⟩ := hq k
  exact ⟨⟨g, hk⟩, rfl⟩

/-- p. 399: if `q` is a surjection with finite kernel and `K` is a nilpotent subgroup of the
target, the preimage of `K` is finite-by-nilpotent, hence almost nilpotent. -/
theorem isVirtuallyNilpotent_comap_of_finite_ker {G Q : Type*} [Group G] [Group Q] {q : G →* Q}
    (hq : Function.Surjective q) (hfin : Finite q.ker) (K : Subgroup Q)
    (hK : Group.IsNilpotent K) : Group.IsVirtuallyNilpotent (K.comap q) := by
  have : Finite q.ker := hfin
  have hle : q.ker ≤ K.comap q := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    simp [Subgroup.mem_comap, hx]
  have : (q.ker.subgroupOf (K.comap q)).Normal := Subgroup.normal_subgroupOf
  have : Finite (q.ker.subgroupOf (K.comap q)) :=
    Finite.of_equiv _ (Subgroup.subgroupOfEquivOfLe hle).symm.toEquiv
  have e1 : ((K.comap q) ⧸ (qRestrictComap q K).ker) ≃* K :=
    QuotientGroup.quotientKerEquivOfSurjective _ (surjective_qRestrictComap hq K)
  have e2 : ((K.comap q) ⧸ (q.ker.subgroupOf (K.comap q)))
      ≃* ((K.comap q) ⧸ (qRestrictComap q K).ker) :=
    QuotientGroup.quotientMulEquivOfEq (ker_qRestrictComap q K).symm
  have hquot : Group.IsNilpotent ((K.comap q) ⧸ (q.ker.subgroupOf (K.comap q))) :=
    (Group.isNilpotent_congr (e2.trans e1)).2 hK
  exact isVirtuallyNilpotent_of_finite_of_isNilpotent_quotient _ hquot

/-- If the kernel of `q` is the nilpotent subgroup `A₀` and `K` is a nilpotent subgroup of the
target, the preimage of `K` is an extension of a nilpotent group by a nilpotent group, hence
solvable. -/
theorem isSolvable_comap_of_isNilpotent_ker {G Q : Type*} [Group G] [Group Q] {q : G →* Q}
    {A₀ : Subgroup G} (hker : q.ker = A₀) (hA₀ : Group.IsNilpotent A₀) (K : Subgroup Q)
    (hK : Group.IsNilpotent K) : Group.IsSolvable (K.comap q) := by
  have hle : A₀ ≤ K.comap q := by
    intro x hx
    rw [← hker, MonoidHom.mem_ker] at hx
    simp [Subgroup.mem_comap, hx]
  have : Group.IsNilpotent (A₀.subgroupOf (K.comap q)) :=
    (Group.isNilpotent_congr (Subgroup.subgroupOfEquivOfLe hle)).2 hA₀
  have : Group.IsNilpotent K := hK
  refine Group.isSolvable_of_ker_le_range (A₀.subgroupOf (K.comap q)).subtype (qRestrictComap q K) ?_
  rw [ker_qRestrictComap, hker, Subgroup.range_subtype]

/-! ### Lemma 3.1, Rosenblatt's form -/

/-- **Chou, Lemma 3.1 in the form stated on p. 401.**  If `A` is normal in the finitely
generated group `B` with `A` and `B ⧸ A` almost nilpotent, and `B` contains no free
subsemigroup on two generators, then `B` is almost nilpotent. -/
theorem isVirtuallyNilpotent_of_extension_of_not_hasFreeSubsemigroupOfRankTwo' {B : Type*}
    [Group B] [Group.FG B] (A : Subgroup B) [A.Normal] (hA : Group.IsVirtuallyNilpotent A)
    (hC : Group.IsVirtuallyNilpotent (B ⧸ A)) (hfree : ¬ HasFreeSubsemigroupOfRankTwo B) :
    Group.IsVirtuallyNilpotent B := by
  -- `B ⧸ A` is virtually polycyclic, so `A` is finitely generated
  have : Group.FG A :=
    fg_of_isVirtuallyPolycyclic_quotient_of_not_hasFreeSubsemigroupOfRankTwo hfree A
      (isVirtuallyPolycyclic_of_isVirtuallyNilpotent_of_fg hC)
  -- a nilpotent subgroup `A₀ ≤ A`, of finite index in `A`, normal in `B`
  obtain ⟨A₀, hA₀norm, hA₀le, hA₀nil, hA₀idx⟩ :=
    exists_normal_le_isNilpotent_of_isVirtuallyNilpotent A hA
  have : A₀.Normal := hA₀norm
  have : (A₀.subgroupOf A).FiniteIndex := hA₀idx
  -- the induced surjection `B ⧸ A₀ → B ⧸ A`
  have hAcomap : A₀ ≤ A.comap (MonoidHom.id B) := by simpa using hA₀le
  have hqsurj : Function.Surjective (QuotientGroup.map A₀ A (MonoidHom.id B) hAcomap) := by
    intro y
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective A y
    exact ⟨QuotientGroup.mk' A₀ b, rfl⟩
  have hkerq : (QuotientGroup.map A₀ A (MonoidHom.id B) hAcomap).ker
      = A.map (QuotientGroup.mk' A₀) := by
    rw [QuotientGroup.ker_map, Subgroup.comap_id]
  -- the kernel is the image of `A`, and it is finite
  have hfinker : Finite (QuotientGroup.map A₀ A (MonoidHom.id B) hAcomap).ker := by
    have hrange : ((QuotientGroup.mk' A₀).comp A.subtype).range
        = A.map (QuotientGroup.mk' A₀) := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype]
    have hkerpsi : ((QuotientGroup.mk' A₀).comp A.subtype).ker = A₀.subgroupOf A := by
      rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
      rfl
    have : Finite (A ⧸ (A₀.subgroupOf A)) := inferInstance
    have e1 : (A ⧸ ((QuotientGroup.mk' A₀).comp A.subtype).ker)
        ≃* ((QuotientGroup.mk' A₀).comp A.subtype).range :=
      QuotientGroup.quotientKerEquivRange _
    have e2 : (A ⧸ ((QuotientGroup.mk' A₀).comp A.subtype).ker) ≃* (A ⧸ (A₀.subgroupOf A)) :=
      QuotientGroup.quotientMulEquivOfEq hkerpsi
    rw [hkerq, ← hrange]
    exact Finite.of_equiv _ (e2.symm.trans e1).toEquiv
  -- `B ⧸ A₀` is almost nilpotent
  obtain ⟨K₁, hK₁norm, hK₁nil, hK₁idx⟩ := exists_normal_isNilpotent_finiteIndex hC
  have : (K₁.comap (QuotientGroup.map A₀ A (MonoidHom.id B) hAcomap)).FiniteIndex := ⟨by
    rw [Subgroup.index_comap_of_surjective _ hqsurj]
    exact hK₁idx.index_ne_zero⟩
  have hBA₀ : Group.IsVirtuallyNilpotent (B ⧸ A₀) :=
    isVirtuallyNilpotent_of_finiteIndex _
      (isVirtuallyNilpotent_comap_of_finite_ker hqsurj hfinker K₁ hK₁nil)
  -- pull a nilpotent normal subgroup of finite index back to `B`
  obtain ⟨K, hKnorm, hKnil, hKidx⟩ := exists_normal_isNilpotent_finiteIndex hBA₀
  have : (K.comap (QuotientGroup.mk' A₀)).FiniteIndex := ⟨by
    rw [Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective A₀)]
    exact hKidx.index_ne_zero⟩
  have : Group.FG (K.comap (QuotientGroup.mk' A₀)) := inferInstance
  have : Group.IsSolvable (K.comap (QuotientGroup.mk' A₀)) :=
    isSolvable_comap_of_isNilpotent_ker (QuotientGroup.ker_mk' A₀) hA₀nil K hKnil
  -- Rosenblatt's theorem applies to this finitely generated solvable subgroup; its second
  -- alternative is excluded because a free subsemigroup on two generators in a subgroup of
  -- `B` gives one in `B`
  rcases isVirtuallyNilpotent_or_hasFreeSubsemigroupOfRankTwo_of_isSolvable
      (G := (K.comap (QuotientGroup.mk' A₀))) with hvn | hfs
  · exact isVirtuallyNilpotent_of_finiteIndex _ hvn
  · exact absurd hfs (not_hasFreeSubsemigroupOfRankTwo_subgroup hfree _)

end Lib
end Chou

open Chou

theorem solution {B : Type*} [Group B] [Group.FG B]
    (A : Subgroup B) [A.Normal] (hA : Group.IsVirtuallyNilpotent A)
    (hC : Group.IsVirtuallyNilpotent (B ⧸ A)) (hfree : ¬ HasFreeSubsemigroupOfRankTwo B) :
    Group.IsVirtuallyNilpotent B :=
  Chou.Lib.isVirtuallyNilpotent_of_extension_of_not_hasFreeSubsemigroupOfRankTwo' A hA hC hfree
