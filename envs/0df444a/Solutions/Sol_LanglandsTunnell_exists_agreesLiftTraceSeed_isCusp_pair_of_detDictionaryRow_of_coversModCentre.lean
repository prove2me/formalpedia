    star M.trace = M.trace * M.det := by
  rw [← _root_.LanglandsTunnell.Lift48.tr2_eq_trace, ← _root_.LanglandsTunnell.Lift48.det2_eq_det]
  exact K48_star_tr2 M ((_root_.LanglandsTunnell.Lift48.mem_closure_iff_mem_K48 M).1 hM)

