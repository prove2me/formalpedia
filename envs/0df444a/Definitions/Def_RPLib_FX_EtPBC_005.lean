-- ===== S4.Def_RP_EtPBC_A_O2ZarCh =====
section

/-!
# S4-EtPBC-A, O2 GLOB (O2ZarCh): the chart toolbox for the global step

GLOB/REL PLAN v1 (file LocU+ZarCh). `c : A1 k ⟶ P` an open immersion, `D = chEt c φ` (`φ : k[X] ⟶ B`).
* `subsingleton_fib_toDF`, `nonempty_fib_toDF`, `range_toDF`: the one-point chart conditions survive a shrink
  `D_f ⟶ D` when `f` does not vanish at the special point;
* `isLocalization_away_toDF`, `comap_injective_toDF`: O2Pb (Zar) for `toDF`;
* `etale_chEt_locF`, `isOpenImmersion_chEt_locF`: `D_g := chEt c (k[X] ⟶ k[X]_g)` is an open of `P`;
  `opnDg c g := c(D(g))` its range;
* `liftDg`, `toDg`: `D_f ⟶ D_g` over `P` when `φ g` is a unit in `B_f`;
* `secD`, `secD_prT`: the section `opEt U ⟶ D ×_P U` for an open immersion `D` whose range contains `U`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtDeg

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtPBC.EtKum RamanujanPetersson.EtPBC.EtShap

universe u

section Shrink

variable {k : Type u} [Field k] {P : Scheme.{u}} (c : A1 k ⟶ P) [IsOpenImmersion c]
  {B : CommRingCat.{u}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)] (f : B)

theorem subsingleton_fib_toDF (x : P) [Subsingleton ((geomPtAt x).point.fiber.obj (chEt c φ))] :
    Subsingleton ((geomPtAt x).point.fiber.obj (chEt c (φ ≫ locF f))) :=
  ⟨fun _ _ => fib_injective_of_mono (toDF c φ f) _ (Subsingleton.elim _ _)⟩

theorem nonempty_fib_toDF (x : P) (n : (geomPtAt x).point.fiber.obj (chEt c φ)) (hf : f ∉ (fpt x n).asIdeal) :
    Nonempty ((geomPtAt x).point.fiber.obj (chEt c (φ ≫ locF f))) := by
  have hr : fpt x n ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away f))) := by
    rw [PrimeSpectrum.localization_away_comap_range (Localization.Away f) f]; exact hf
  obtain ⟨v₁, hv₁⟩ := hr
  have hv : (toDF c φ f).left v₁ = fpt x n :=
    PrimeSpectrum.ext ((toDF_left_asIdeal c φ f v₁).trans (congrArg PrimeSpectrum.asIdeal hv₁))
  obtain ⟨b, -, -⟩ := exists_lift_fib (toDF c φ f) x n v₁ hv
  exact ⟨b⟩

theorem range_toDF {Uo : P.Opens} {z : P}
    (hDr : ∀ v : (chEt c φ).left, (chEt c φ).hom v ∈ Uo ∨ (chEt c φ).hom v = z) :
    ∀ v : (chEt c (φ ≫ locF f)).left, (chEt c (φ ≫ locF f)).hom v ∈ Uo ∨ (chEt c (φ ≫ locF f)).hom v = z :=
  fun v => by
    have e := toDF_apply c φ f v
    rcases hDr ((toDF c φ f).left v) with h1 | h1
    · exact Or.inl ((congrArg (· ∈ Uo) e).mpr h1)
    · exact Or.inr (e.trans h1)

instance isAffine_chEt_left : IsAffine (chEt c φ).left := inferInstanceAs (IsAffine (Spec B))

end Shrink

section Dg

variable {k : Type u} [Field k] {P : Scheme.{u}} (c : A1 k ⟶ P) [IsOpenImmersion c]

instance etale_chEt_locF (g : k[X]) : Etale (Spec.map (locF (B := CommRingCat.of k[X]) g) ≫ c) :=
  inferInstance

variable {B : CommRingCat.{u}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)] (f : B) (g : k[X])
  (hg : IsUnit (algebraMap B (Localization.Away f) (φ.hom g)))

/-- `k[X]_g ⟶ B_f`. -/
def liftDg : CommRingCat.of (Localization.Away g) ⟶ CommRingCat.of (Localization.Away f) :=
  CommRingCat.ofHom (IsLocalization.Away.lift (g := (algebraMap B (Localization.Away f)).comp φ.hom) g hg)

end Dg

section Sec

end Sec

end RamanujanPetersson.EtPBC.EtDeg

end

