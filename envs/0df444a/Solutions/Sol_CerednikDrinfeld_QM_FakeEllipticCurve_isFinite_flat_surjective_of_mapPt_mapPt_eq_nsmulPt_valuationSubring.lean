section Generic

variable {R : Type u} [CommRing R] {A A' : Scheme.{u}}
  {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}

theorem nsmulPt_eq_nsmul (L : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (n : ℕ) (P : SchemeHomOver t f) : nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [RelativeGroupLaw.nsmul_succ, ← ih]
      rfl

theorem comp_eq_schemeNsmul (L : RelativeGroupLaw R f) (Φ : A ⟶ A') (hΦ : Φ ≫ f' = f)
    (Ψ : A' ⟶ A) (hΨ : Ψ ≫ f = f') (n : ℕ)
    (h : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f),
      mapPt Ψ hΨ (mapPt Φ hΦ P) = nsmulPt L t n P) :
    Φ ≫ Ψ = L.schemeNsmul n := by
  have := congrArg Subtype.val (h f RelativeGroupLaw.idPoint)
  rw [nsmulPt_eq_nsmul] at this
  simp only [mapPt_coe, Category.id_comp, Category.assoc] at this
  exact this

theorem connectedSpace_of_field {K : Type u} [Field K] {X : Scheme.{u}} {g : X ⟶ Spec (CommRingCat.of K)}
    (h : AbelianSchemePropertyBundle K g) : ConnectedSpace X := by
  have hc := h.connectedFibres default
  have e : (g.base ⁻¹' {default} : Set X) = Set.univ :=
    Set.eq_univ_of_forall fun x => Subsingleton.elim _ _
  rw [e] at hc
  exact connectedSpace_iff_univ.mpr hc

theorem smoothOfRelativeDimension_of_topologicalKrullDim_eq {K : Type u} [Field K] {X : Scheme.{u}}
    (g : X ⟶ Spec (CommRingCat.of K)) (h : AbelianSchemePropertyBundle K g) (d : ℕ)
    (hd : topologicalKrullDim X = d) : SmoothOfRelativeDimension d g := by
  haveI : Smooth g := h.smooth
  haveI : ConnectedSpace X := connectedSpace_of_field h
  obtain ⟨m, hm⟩ := Smooth.exists_smoothOfRelativeDimension_of_preconnectedSpace g
  haveI := hm
  have h1 : (m : WithBot ℕ∞) ≤ topologicalKrullDim X := SmoothOfRelativeDimension.le_topologicalKrullDim g m
  have h2 : topologicalKrullDim X ≤ m := SmoothOfRelativeDimension.topologicalKrullDim_le g m
  rw [hd] at h1 h2
  have : m = d := by
    have e : (m : WithBot ℕ∞) = (d : WithBot ℕ∞) := le_antisymm h1 h2
    exact_mod_cast e
  subst this
  exact hm

end Generic
