-- ==== solution ====
open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}
variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht
theorem solution (hR0 : RealPattern E0 U) {y : Pt 4} (hy : y ∈ U) (μ ν : Fin 4) :
    HasDerivAt (fun ε => rzG U g0 E0 Θ0 B ε μ ν y) (h μ ν y) 0 := by
  have hW := isOpen_rzW hN ht
  have hy0 := mem_rzW_zero hN (B := B) hy
  have hθ : ∀ C ν, HasDerivAt (fun ε => rzTh U E0 Θ0 B ε C ν y) (coVar Θ0 B C ν y) 0 := by
    intro C ν
    have := hasDerivAt_coframe_of hW (contDiffOn_rzTh_joint hN ht)
      (fun p hp => (rz_null hN ht hR0 p.1).dual p.2 hp) hy0 (fun A μ => rz_hasDerivAt_E y A μ) C ν
    rwa [rzTh_zero hN] at this
  have hd := HasDerivAt.fun_sum (u := Finset.univ) fun C _ => HasDerivAt.fun_sum (u := Finset.univ) fun D _ =>
    ((hθ C μ).mul_const (etaNull C D)).mul (hθ D ν)
  -- the derivative of `G_ε` is `h`
  have key : (∑ C, ∑ D, ((coVar Θ0 B C μ y * etaNull C D) * rzTh U E0 Θ0 B 0 D ν y
      + rzTh U E0 Θ0 B 0 C μ y * etaNull C D * coVar Θ0 B D ν y)) = (h μ ν y : ℂ) := by
    rw [rzTh_zero hN]
    set Θm := coMat Θ0 y
    set Tm := frMat E0 y
    set Bm := frMat B y
    set Gm := cmat g0 y
    set Hm := cmat h y
    have hcv : Matrix.of (fun C ν => coVar Θ0 B C ν y) = -(Θm * Bm * Θm) := by
      ext C ν
      simp only [Matrix.of_apply, coVar, Matrix.neg_apply, Matrix.mul_apply, Θm, Bm, coMat, frMat, Finset.sum_mul]
    have e1 : (∑ C, ∑ D, ((coVar Θ0 B C μ y * etaNull C D) * Θ0 D ν y
        + Θ0 C μ y * etaNull C D * coVar Θ0 B D ν y))
        = ((Matrix.of (fun C ν => coVar Θ0 B C ν y))ᵀ * etaNull * Θm
          + Θmᵀ * etaNull * Matrix.of (fun C ν => coVar Θ0 B C ν y)) μ ν := by
      rw [Matrix.add_apply, quad_eta_apply, quad_eta_apply, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun _ _ => by rw [← Finset.sum_add_distrib]; simp only [Matrix.of_apply, Θm, coMat]
    have e2 : (h μ ν y : ℂ) = Hm μ ν := by simp [Hm, cmat, metricMatrix]
    rw [e1, e2, hcv]
    have hc : Tm * Θm = 1 := hN.toFrameData.compl hy
    have hcT : Θmᵀ * Tmᵀ = 1 := by rw [← Matrix.transpose_mul, hc, Matrix.transpose_one]
    have hG : Gm = Θmᵀ * etaNull * Θm := cmat_eq_coMat hN hy
    have hcomp := ht.compat.matrix hy
    have hH : Hm = -(Θmᵀ * Bmᵀ * Gm + Gm * Bm * Θm) := by
      have h1 : Hm = Θmᵀ * (Tmᵀ * Hm * Tm) * Θm := by
        calc Hm = (Tm * Θm)ᵀ * Hm * (Tm * Θm) := by rw [hc]; simp
          _ = _ := by simp only [Matrix.transpose_mul, Matrix.mul_assoc]
      have h2 : Tmᵀ * Hm * Tm = -(Bmᵀ * Gm * Tm + Tmᵀ * Gm * Bm) := by
        rw [add_assoc] at hcomp; exact eq_neg_of_add_eq_zero_left hcomp
      have e3 : ∀ X : Matrix (Fin 4) (Fin 4) ℂ, Θmᵀ * (Tmᵀ * X) = X := fun X => by
        rw [← Matrix.mul_assoc, hcT, Matrix.one_mul]
      rw [h1, h2]
      simp only [Matrix.mul_neg, Matrix.neg_mul, Matrix.mul_add, Matrix.add_mul, Matrix.mul_assoc, e3, hc,
        Matrix.mul_one]
    rw [hH, hG]
    simp only [Matrix.transpose_neg, Matrix.transpose_mul, etaNull_transpose, Matrix.neg_mul, Matrix.mul_neg,
      Matrix.mul_assoc, Matrix.add_apply, Matrix.neg_apply]
    ring
  rw [key] at hd
  have hre := (Complex.reCLM.hasFDerivAt (x := rzGc U E0 Θ0 B 0 μ ν y)).comp_hasDerivAt (0 : ℝ) hd
  simp only [Complex.reCLM_apply, Complex.ofReal_re] at hre
  refine hre.congr_of_eventuallyEq (Filter.Eventually.of_forall fun ε => ?_)
  simp only [Function.comp, rzG, hy, if_true, rzGc, Pi.mul_apply, Complex.reCLM_apply]
