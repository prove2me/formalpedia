theorem solution {j : ℝ} (hj : j ≠ 0) {R : ℝ} (hR : 3 < R) : 0 < j * cj j R := by
  have hscale := cj_apply_smul j hR
  have hbase := cj_one_ge hR
  have hR0 : (0:ℝ) < R := by linarith
  have hpos : (0:ℝ) < j ^ 4 * cj 1 R := by
    have h4 : (0:ℝ) < j ^ 4 := by
      have : j ^ 4 = (j ^ 2) ^ 2 := by ring
      rw [this]
      exact pow_pos (sq_pos_of_ne_zero hj) 2
    have hc : (0:ℝ) < cj 1 R := by
      have := hbase
      have h5 : (0:ℝ) < 5 / (3072 * R) := by positivity
      linarith
    exact mul_pos h4 hc
  have hid : j * cj j R = j ^ 4 * cj 1 R := by
    rw [hscale]; ring
  rw [hid]
  exact hpos
