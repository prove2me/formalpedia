lemma progEdges_cons (i : Instr Wr R m) (l : List (Instr Wr R m)) :
    progEdges (i :: l) = (i.edgeOf.toList) ++ progEdges l := by
  cases i <;> simp [progEdges, Instr.edgeOf, List.filterMap_cons]

