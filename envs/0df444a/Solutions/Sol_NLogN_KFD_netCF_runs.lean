  refine ⟨⟨ha.1, ?_⟩, ?_, ?_⟩
  · rw [ha.2.1]; exact hb.1
  · simp only [NLogN.RS.run, ha.2.1, hb.2.1]
  · simp only [NLogN.RS.cost]; rw [ha.2.1]; have := ha.2.2; have := hb.2.2; omega

