        ∧ ¬ ι.toBase ϖ ∣ (s - σ.toBase s))
    (δ : Matrix.GeneralLinearGroup (Fin 2) E)
    (hnorm : LT.TwistedNorm.sigmaNormPow σ.mapGL n δ =
      ι.mapGL (Matrix.GeneralLinearGroup.map (algebraMap R K : R →+* K) γ)) :
    ∃ δ₀ : Matrix.GeneralLinearGroup (Fin 2) RE,
      twistedUnitOrbitalCount δ σ = twistedUnitOrbitalCount (Matrix.GeneralLinearGroup.map (algebraMap RE E) δ₀) σ
        ∧ LT.TwistedNorm.sigmaNormPow (Matrix.GeneralLinearGroup.map (σ.toBase : RE →+* RE)) n δ₀
          = Matrix.GeneralLinearGroup.map ι.toBase γ := by
  have hn : 0 < n := pos_of_natCard_quotient_eq_pow ι hϖE hres
  have hprime : Prime (ι.toBase ϖ) := hϖE.prime
  have hmax : (Ideal.span {ι.toBase ϖ}).IsMaximal := isMaximal_span_of_irreducible hϖE
  have hσϖ : σ.toBase (ι.toBase ϖ) = ι.toBase ϖ := hσ ϖ
