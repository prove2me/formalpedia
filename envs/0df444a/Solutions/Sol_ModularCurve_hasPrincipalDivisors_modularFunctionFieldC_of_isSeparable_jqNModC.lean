theorem solution (K : Type*) [Field K] (N : ℕ) [NeZero N]
    (hsep : IsSeparable (IntermediateField.adjoin K ({jqModC K} : Set (LaurentSeries K)))
      (jqNModC K N)) :
    HasPrincipalDivisors K (modularFunctionFieldC K N) := by
  set F := modularFunctionFieldC K N
  let jF : F := ⟨jqModC K, jqModC_mem K N⟩
  have htr : Transcendental K jF := by
    intro halg
    exact (transcendental_jqModC K) (halg.algHom (IsScalarTower.toAlgHom K F (LaurentSeries K)))
  obtain ⟨data⟩ := nonempty_modularPolynomialData N
  obtain ⟨hfd, hsepAlg⟩ :=
    finiteDimensional_and_isSeparable_adjoin_jGeomGen_of_isSeparable_jqNModC K N data hsep
  exact hasPrincipalDivisors_of_transcendental_of_isSeparable htr hfd hsepAlg

end
