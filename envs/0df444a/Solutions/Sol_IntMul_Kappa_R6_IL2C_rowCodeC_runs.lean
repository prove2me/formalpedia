section PFacts

variable {m F K e T S0 B r H : ℕ} (hp : PF m F K e T S0 B r)
include hp

theorem PF.eT : e < T := by
  have := hp.ht; have := Nat.mod_lt e (show 0 < K by have := hp.k1; omega)
  have := Nat.mod_le e K; omega

theorem PF.KT : K ≤ T := by have := hp.ht; omega

theorem PF.mT : (F * m) ≤ T := by
  have h1 : (F * m) - 1 ≤ K * ((F * m) - 1) := Nat.le_mul_of_pos_left _ hp.k1
  have := hp.he; have := hp.eT
  have : 1 ≤ (F * m) := Nat.mul_le_mul hp.f1 hp.m1
  omega

theorem PF.T80 : 80 ≤ T := by
  have h1 : m ≤ (F * m) := Nat.le_mul_of_pos_left _ hp.f1
  have h2 : 6 * 15 ≤ K * ((F * m) - 1) :=
    Nat.mul_le_mul hp.k6 (by have := hp.m16; omega)
  have := hp.he; have := hp.eT
  omega

theorem PF.fm : F * m ≤ T := hp.mT

theorem PF.mCT : m ≤ T := by
  have := hp.fm; have := hp.f1
  calc m = 1 * m := (one_mul _).symm
    _ ≤ F * m := Nat.mul_le_mul_right _ this
    _ ≤ T := hp.fm

theorem PF.fT : F ≤ T := by
  have := hp.fm
  calc F = F * 1 := (mul_one _).symm
    _ ≤ F * m := Nat.mul_le_mul_left _ (by have := hp.m16; omega)
    _ ≤ T := hp.fm

theorem PF.he' : K * (F * m - 1) ≤ e := hp.he

theorem PF.fK : F * K ≤ e := by
  have h1 : F ≤ F * m - 1 := by
    have := hp.f1
    have : F * 2 ≤ F * m := Nat.mul_le_mul_left _ (by have := hp.m16; omega)
    omega
  have := Nat.mul_le_mul_left K h1
  have := hp.he'
  rw [Nat.mul_comm (F) K]; omega

theorem PF.TV : 2 ^ T ≤ VbR T S0 B r H := by
  unfold VbR
  have := hp.s0; have := hp.b; have := hp.r
  calc 2 ^ T = 1 * 2 ^ T * 1 := by ring
    _ ≤ B * 2 ^ T * S0 := Nat.mul_le_mul (Nat.mul_le_mul_right _ hp.b) hp.s0
    _ ≤ (B * 2 ^ T * S0) * (2 * r * (H + 1)) := Nat.le_mul_of_pos_right _ (by positivity)
    _ = 2 * (B * 2 ^ T * S0) * r * (H + 1) := by ring

end PFacts

section SFacts

variable {m F K e T S0 B r : ℕ} (hp : PF m F K e T S0 B r)
include hp

theorem srw_add {x y : ℕ} (hxy : x < y) (hy : y < m) :
    srw m K e F y + F * K * (y - x) = srw m K e F x := by
  obtain ⟨_, _, hx'⟩ := sR_int (K := K) (F := F) (e := e) (hp.f1) (hxy.trans hy) hp.he'
  obtain ⟨_, _, hy'⟩ := sR_int (K := K) (F := F) (e := e) (hp.f1) hy hp.he'
  have : ((srw m K e F y : ℕ) : ℤ) + ((F * K * (y - x) : ℕ) : ℤ) = ((srw m K e F x : ℕ) : ℤ) := by
    rw [hx', hy']; push_cast [Nat.cast_sub hxy.le]; ring
  exact_mod_cast this

theorem srw_top {x : ℕ} (hx : x < m) : srw m K e F x + F * K ≤ T := by
  obtain ⟨hE, hmod, _⟩ := sR_int (K := K) (F := F) (e := e) (hp.f1) hx hp.he'
  have hf := hp.f1
  have hPQ : K * (F - 1) ≤ K * (F * (x + 1) - 1) :=
    Nat.mul_le_mul_left _ (by have : F ≤ F * (x + 1) := Nat.le_mul_of_pos_right _ (by omega)
                              omega)
  have hQ : K * (F - 1) + K = F * K := by
    rw [Nat.mul_sub_one, Nat.mul_comm (F) K]
    have : K ≤ K * F := Nat.le_mul_of_pos_right _ hf
    omega
  have ht := hp.ht
  have := Nat.mod_le e K
  unfold srw KFR.sR
  omega

theorem srw_le {x : ℕ} (hx : x < m) : srw m K e F x ≤ T := by have := srw_top hp hx; omega

end SFacts

section Par

variable {m F K e T S0 B r H : ℕ} {i j : Fin m} {u : IState HS} {Bb : ℕ}
  (hp : PF m F K e T S0 B r) (hA : Agree (rowσ m F K e T S0 B r H i j) u)
