          (nodePairsOfPlaces (arithFrobC q (ResidueField A) N) W))
      (_ : Module HeckeAlg (Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) N)))
      (spN : JZero N →+ Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) N))
