  have h1 : (d + 3) * (3 * d + 2) * (2 * a) ≤ (d + 3) * (3 * d + 2) * n :=
    Nat.mul_le_mul_left _ hn
  have h5 : 84 * (5 * a) ≤ 84 * ((d + 3) * s) := Nat.mul_le_mul_left _ hs
  have hq : 72 * d ≤ 3 * d * d + 177 := by nlinarith [hd]
