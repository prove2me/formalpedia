private lemma directionDegree_mul_le (k : Type) [Field k] (Dv : ExceptionalDivisor k)
    (Q : ClosedDirection k) : directionDegree k Q * Dv Q ≤ exceptionalDegree k Dv := by
  unfold exceptionalDegree Finsupp.sum
