  rw [natAbs_tdiv_pow]; exact Nat.div_le_of_le_mul h

theorem natAbs_sum_range_le (n C : ℕ) (f : ℕ → ℤ) (h : ∀ i < n, (f i).natAbs ≤ C) :
    (∑ i ∈ Finset.range n, f i).natAbs ≤ n * C := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ]
    refine (Int.natAbs_add_le _ _).trans ?_
    have := ih (fun i hi => h i (by omega))
    have := h n (by omega)
    rw [Nat.succ_mul]; omega

theorem geo9 (K : ℕ) : ∀ B : ℕ, ∑ k ∈ Finset.range K, B / 9 ^ k ≤ B + B / 8 := by
  induction K with
  | zero => intro B; simp
  | succ K ih =>
    intro B
    rw [Finset.sum_range_succ']
    have e : ∀ k, B / 9 ^ (k + 1) = B / 9 / 9 ^ k := by
      intro k; rw [Nat.div_div_eq_div_mul, pow_succ']
    simp only [e, pow_zero, Nat.div_one]
    have := ih (B / 9)
    omega

theorem atanh3_le (N K : ℕ) :
    ∑ k ∈ Finset.range K, 2 ^ N / ((2 * k + 1) * 3 ^ (2 * k + 1)) ≤
      2 ^ N / 3 + 2 ^ N / 3 / 8 := by
  refine le_trans (Finset.sum_le_sum fun k _ => ?_) (geo9 K (2 ^ N / 3))
  rw [Nat.div_div_eq_div_mul]
  apply Nat.div_le_div_left _ (by positivity)
  rw [pow_succ, pow_mul]
  norm_num
  nlinarith [Nat.one_le_pow k 9 (by norm_num)]

theorem log2Bits_le_pow (M : ℕ) : log2Bits M ≤ 2 ^ M := by
  have hA := atanh3_le (2 * M + 9) (2 * M + 9)
  set S := ∑ k ∈ Finset.range (2 * M + 9), 2 ^ (2 * M + 9) / ((2 * k + 1) * 3 ^ (2 * k + 1))
  have hlog : log2Approx (2 * M + 9) = 2 * (S : ℤ) := by
    simp only [log2Approx, atanhInv, S]; push_cast; ring
  have hZ : (2 : ℕ) ^ (2 * M + 9) = 4 * (2 ^ M * 2 ^ (M + 7)) := by
    rw [show 2 * M + 9 = 2 + (M + (M + 7)) by omega, pow_add, pow_add]; norm_num
  rw [hZ] at hA
  set Z := 2 ^ M
  set Y := 2 ^ (M + 7)
  have hS2 : 2 * S ≤ 3 * (Z * Y) := by omega
  simp only [log2Bits]
  rw [hlog]
  have hY8 : (2 : ℤ) ^ (M + 8) = 2 * (Y : ℤ) := by
    simp only [Y]; push_cast; rw [pow_succ]; ring
  have hY9 : (2 : ℤ) ^ (M + 9) = 4 * (Y : ℤ) := by
    simp only [Y]; push_cast; rw [show M + 9 = M + 7 + 2 by omega, pow_add]; ring
  have hZ' : (2 : ℤ) ^ M = (Z : ℤ) := by simp [Z]
  rw [hY8, hY9, hZ']
  have hY1 : (1 : ℤ) ≤ Y := by simp only [Y]; exact_mod_cast Nat.one_le_two_pow
  have hZ1 : (1 : ℤ) ≤ Z := by simp only [Z]; exact_mod_cast Nat.one_le_two_pow
  have hlt : 2 * (S : ℤ) + 2 * Y < ((Z : ℤ) + 1) * (4 * Y) := by
    have : (2 * S : ℤ) ≤ 3 * (Z * Y) := by exact_mod_cast hS2
    nlinarith
  have := Int.ediv_lt_of_lt_mul (by positivity) hlt
  omega

theorem expTerm_real_bnd (N : ℕ) (x : ℤ) (hx : |x| ≤ 2 ^ N) :
    ∀ j, (expTerm N x 0 j).2 = 0 ∧ |(expTerm N x 0 j).1| ≤ 2 ^ N := by
  intro j
  induction j with
  | zero => simp [expTerm]
  | succ j ih =>
    obtain ⟨h2, h1⟩ := ih
    have hd : (0 : ℤ) < ((j : ℤ) + 1) * 2 ^ N := by positivity
    have e : expTerm N x 0 (j + 1) =
        (((expTerm N x 0 j).1 * x - (expTerm N x 0 j).2 * 0) / (((j : ℤ) + 1) * 2 ^ N),
          ((expTerm N x 0 j).1 * 0 + (expTerm N x 0 j).2 * x) / (((j : ℤ) + 1) * 2 ^ N)) := by
      simp [expTerm]
    rw [e, h2]
    simp only [mul_zero, sub_zero, zero_mul, add_zero, Int.zero_ediv, true_and]
    apply NLogN.abs_ediv_le_of _ _ _ hd
    rw [abs_mul]
    have h0 : (0 : ℤ) ≤ 2 ^ N := by positivity
    have hj : (1 : ℤ) ≤ (j : ℤ) + 1 := by linarith [(Nat.cast_nonneg j : (0 : ℤ) ≤ j)]
    calc |(expTerm N x 0 j).1| * |x| ≤ 2 ^ N * 2 ^ N :=
          mul_le_mul h1 hx (abs_nonneg _) h0
      _ ≤ 2 ^ N * (((j : ℤ) + 1) * 2 ^ N) := by nlinarith

theorem expApprox_real_bnd (N K : ℕ) (x : ℤ) (hx : |x| ≤ 2 ^ N) :
    |(expApprox N K x 0).1| ≤ K * 2 ^ N := by
  induction K with
  | zero => simp [expApprox]
  | succ K ih =>
    rw [NLogN.expApprox_succ]
    have := (expTerm_real_bnd N x hx K).2
    refine (abs_add_le _ _).trans ?_
    push_cast; linarith

theorem expBits_real_bnd (M : ℕ) (z : ℤ) (hz : |z| ≤ 2 ^ M) :
    |(expBits M z 0).1| ≤ (2 * M + 14) * 2 ^ M := by
  simp only [expBits, zero_mul]
  have hx : |z * 2 ^ (M + 9)| ≤ 2 ^ (2 * M + 9) := by
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℤ) < 2 ^ (M + 9)),
      show (2 : ℤ) ^ (2 * M + 9) = 2 ^ M * 2 ^ (M + 9) by rw [← pow_add]; ring_nf]
    exact mul_le_mul_of_nonneg_right hz (by positivity : (0 : ℤ) ≤ 2 ^ (M + 9))
  have he := expApprox_real_bnd (2 * M + 9) (2 * M + 13) _ hx
  apply NLogN.abs_ediv_le_of _ _ _ (by positivity)
  have e1 : (2 : ℤ) ^ (2 * M + 9) = 2 ^ M * 2 ^ (M + 9) := by rw [← pow_add]; ring_nf
  have e2 : (2 : ℤ) ^ (M + 9) = 2 * 2 ^ (M + 8) := by rw [pow_succ]; ring
  have h8 : (2 : ℤ) ^ (M + 8) ≤ 2 ^ M * 2 ^ (M + 9) := by
    rw [e2]; have : (1 : ℤ) ≤ 2 ^ M := one_le_pow₀ (by norm_num)
    have : (0 : ℤ) ≤ 2 ^ (M + 8) := by positivity
    nlinarith
  refine (abs_add_le _ _).trans ?_
  rw [abs_of_pos (by positivity : (0 : ℤ) < 2 ^ (M + 8))]
  rw [e1] at he
  push_cast at he ⊢
  nlinarith

theorem expNegFix_abs_le (n M : ℕ) (X : ℤ) : |expNegFix n M X| ≤ (2 * M + 15) * 2 ^ n := by
  have hL0 := NLogN.log2Bits_pos M
  have hLM := log2Bits_le_pow M
  simp only [expNegFix]
  generalize log2Bits M = L at *
  set τ := -X / L
  have hr0 := Int.emod_nonneg (-X) (show L ≠ 0 by omega)
  have hr1 := Int.emod_lt_of_pos (-X) hL0
  have hed := Int.emod_def (-X) L
  have hz : |X + τ * L| ≤ 2 ^ M := by
    have : X + τ * L = -((-X) % L) := by simp only [τ]; rw [hed]; ring
    rw [this, abs_neg, abs_of_nonneg hr0]; linarith
  have hu := expBits_real_bnd M _ hz
  generalize (expBits M (X + τ * L) 0).1 = u at *
  set s := M - n - 1 + τ.toNat
  apply NLogN.abs_ediv_le_of _ _ _ (by positivity)
  have hM : (2 : ℤ) ^ M ≤ 2 ^ n * 2 ^ (s + 1) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by omega)
  have hs : (2 : ℤ) ^ s ≤ 2 ^ n * 2 ^ (s + 1) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by omega)
  refine (abs_add_le _ _).trans ?_
  rw [abs_of_pos (by positivity : (0 : ℤ) < 2 ^ s)]
  have hc : (0 : ℤ) ≤ 2 * (M : ℤ) + 14 := by positivity
  have := mul_le_mul_of_nonneg_left hM hc
  nlinarith

theorem expNegFix_natAbs_le (n M : ℕ) (X : ℤ) :
    (expNegFix n M X).natAbs ≤ (2 * M + 15) * 2 ^ n := by
  have h := expNegFix_abs_le n M X
  rw [Int.abs_eq_natAbs] at h
  exact_mod_cast h

/-- The exponential weights: `|expNeg n k j| ≤ (4n+35) 2^n`. -/
theorem expNeg_natAbs_le (n k j : ℕ) : (expNeg n k j).natAbs ≤ (4 * n + 35) * 2 ^ n := by
  unfold expNeg
  split_ifs
  · simp
  · have := expNegFix_natAbs_le n (2 * n + 10) (-(piBits (2 * n + 10) * j / k))
    rw [show 2 * (2 * n + 10) + 15 = 4 * n + 35 by ring] at this; exact this

theorem expPos_natAbs_le (n k j σ : ℕ) : (expPos n k j σ).natAbs ≤ (4 * n + 35) * 2 ^ n := by
  unfold expPos
  have := expNegFix_natAbs_le n (2 * n + 10)
    (min 0 (piBits (2 * n + 10) * j / k - σ * log2Bits (2 * n + 10)))
  rw [show 2 * (2 * n + 10) + 15 = 4 * n + 35 by ring] at this; exact this

theorem betaT_natAbs_le (p α : ℕ) : (betaT p α).natAbs ≤ 2 ^ p := by
  simp only [betaT, Int.natAbs_natCast]; exact Nat.div_le_self _ _

theorem dTilde_natAbs_le (p s t α l : ℕ) : (dTilde p s t α l).natAbs ≤ (4 * p + 35) * 2 ^ p :=
  expPos_natAbs_le _ _ _ _

/-- The eTerm weights. -/
theorem eWeight_natAbs_le (p s t α l : ℕ) (h : ℤ) :
    (expNeg p (s ^ 2) (α ^ 2 * (eKz s t l h).toNat)).natAbs ≤ (4 * p + 35) * 2 ^ p :=
  expNeg_natAbs_le _ _ _

/-- The sTerm weights `betaT · expNeg`. -/
theorem sWeight_natAbs_le (p s t α k : ℕ) (j : ℤ) :
    (betaT p α * expNeg p (α ^ 2 * t ^ 2) ((t * j - s * k : ℤ).natAbs ^ 2)).natAbs ≤
      2 ^ (2 * p) * (4 * p + 35) := by
  rw [Int.natAbs_mul]
  have h1 := betaT_natAbs_le p α
  have h2 := expNeg_natAbs_le p (α ^ 2 * t ^ 2) ((t * j - s * k : ℤ).natAbs ^ 2)
  calc _ ≤ 2 ^ p * ((4 * p + 35) * 2 ^ p) := Nat.mul_le_mul h1 h2
    _ = 2 ^ (2 * p) * (4 * p + 35) := by rw [two_mul, pow_add]; ring

theorem le_ceilSqrt_sq (x : ℕ) : x ≤ ceilSqrt x ^ 2 := by
  unfold ceilSqrt
  split_ifs with h
  · have := Nat.lt_succ_sqrt x
    rw [Nat.succ_eq_add_one] at this; nlinarith
  · push Not at h; nlinarith

theorem sqrt_le_ceilSqrt (x : ℕ) : Nat.sqrt x ≤ ceilSqrt x := by
  unfold ceilSqrt; split_ifs <;> omega

theorem ceilSqrt_le_self (x : ℕ) : ceilSqrt x ≤ x := by
  unfold ceilSqrt
  have h := Nat.sqrt_le_self x
  split_ifs with hh
  · by_contra hc
    have : x ≤ Nat.sqrt x := by omega
    nlinarith
  · exact h

theorem scaleZ_ZB (p : ℕ) (z : ℤ × ℤ) : NLogN.BD.ZB (scaleZ p 0 z) (2 ^ p) := by
  unfold scaleZ
  simp only [pow_zero, one_mul]
  have h4 : (4 : ℤ) ^ p = (2 ^ p) ^ 2 := by
    rw [← pow_mul, show (4 : ℤ) = 2 ^ 2 by norm_num, ← pow_mul, mul_comm]
  split_ifs with h
  · rw [h4] at h
    have hp : (0 : ℤ) ≤ 2 ^ p := by positivity
    constructor
    · have : |z.1| ≤ 2 ^ p := by
        apply abs_le_of_sq_le_sq' _ hp |>.elim (fun a b => abs_le.2 ⟨a, b⟩)
        nlinarith [sq_nonneg z.2]
      rw [Int.abs_eq_natAbs] at this; exact_mod_cast this
    · have : |z.2| ≤ 2 ^ p := by
        apply abs_le_of_sq_le_sq' _ hp |>.elim (fun a b => abs_le.2 ⟨a, b⟩)
        nlinarith [sq_nonneg z.1]
      rw [Int.abs_eq_natAbs] at this; exact_mod_cast this
  · set n := (z.1 ^ 2 + z.2 ^ 2).toNat
    have hn : (n : ℤ) = z.1 ^ 2 + z.2 ^ 2 := by
      simp only [n]; rw [Int.toNat_of_nonneg (by positivity)]
    have hsq1 : z.1.natAbs * z.1.natAbs ≤ n := by
      have : ((z.1.natAbs * z.1.natAbs : ℕ) : ℤ) ≤ n := by
        push_cast; rw [hn]; nlinarith [abs_mul_abs_self z.1, sq_nonneg z.2]
      exact_mod_cast this
    have hsq2 : z.2.natAbs * z.2.natAbs ≤ n := by
      have : ((z.2.natAbs * z.2.natAbs : ℕ) : ℤ) ≤ n := by
        push_cast; rw [hn]; nlinarith [abs_mul_abs_self z.2, sq_nonneg z.1]
      exact_mod_cast this
    have hm1 : z.1.natAbs ≤ ceilSqrt n := (Nat.le_sqrt.2 hsq1).trans (sqrt_le_ceilSqrt n)
    have hm2 : z.2.natAbs ≤ ceilSqrt n := (Nat.le_sqrt.2 hsq2).trans (sqrt_le_ceilSqrt n)
    constructor
    · rw [Int.natAbs_tdiv, Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_natCast]
      show z.1.natAbs * (2 : ℤ).natAbs ^ p / ceilSqrt n ≤ 2 ^ p
      rcases Nat.eq_zero_or_pos (ceilSqrt n) with h0 | h0
      · rw [h0, Nat.div_zero]; exact Nat.zero_le _
      · apply Nat.div_le_of_le_mul
        have : (2 : ℤ).natAbs = 2 := rfl
        rw [this, mul_comm (ceilSqrt n)]
        exact Nat.mul_le_mul_right _ hm1 |>.trans (by rw [mul_comm])
    · rw [Int.natAbs_tdiv, Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_natCast]
      show z.2.natAbs * (2 : ℤ).natAbs ^ p / ceilSqrt n ≤ 2 ^ p
      rcases Nat.eq_zero_or_pos (ceilSqrt n) with h0 | h0
      · rw [h0, Nat.div_zero]; exact Nat.zero_le _
      · apply Nat.div_le_of_le_mul
        have : (2 : ℤ).natAbs = 2 := rfl
        rw [this, mul_comm (ceilSqrt n)]
        exact Nat.mul_le_mul_right _ hm2 |>.trans (by rw [mul_comm])

/-- `|twD p n j| ≤ 2^p` componentwise. -/
theorem twD_ZB (p n j : ℕ) : NLogN.BD.ZB (twD p n j) (2 ^ p) := scaleZ_ZB p _

/-- The chirp table is bounded by `2^p`. -/
theorem chirpL_LB (q : Params) : LB (chirpL q) (2 ^ q.p) := by
  intro z hz
  simp only [chirpL, listOf, List.mem_map] at hz
  obtain ⟨l, -, rfl⟩ := hz
  exact twD_ZB _ _ _

theorem mulZ_ZB (p : ℕ) {a b : ℤ × ℤ} {A B : ℕ} (ha : NLogN.BD.ZB a A) (hb : NLogN.BD.ZB b B) :
    NLogN.BD.ZB (mulZ p a b) (2 * A * B / 2 ^ p) := by
  obtain ⟨a1, a2⟩ := ha
  obtain ⟨b1, b2⟩ := hb
  constructor
  · simp only [mulZ]
    rw [natAbs_tdiv_pow]
    apply Nat.div_le_div_right
    refine (Int.natAbs_sub_le _ _).trans ?_
    rw [Int.natAbs_mul, Int.natAbs_mul]
    nlinarith [Nat.mul_le_mul a1 b1, Nat.mul_le_mul a2 b2]
  · simp only [mulZ]
    rw [natAbs_tdiv_pow]
    apply Nat.div_le_div_right
    refine (Int.natAbs_add_le _ _).trans ?_
    rw [Int.natAbs_mul, Int.natAbs_mul]
    nlinarith [Nat.mul_le_mul a1 b2, Nat.mul_le_mul a2 b1]

/-- Multiplication by a disc element (`|a| ≤ 2^p`) at most doubles a bound. -/
theorem mulZ_disc_ZB (p : ℕ) {a b : ℤ × ℤ} {B : ℕ} (ha : NLogN.BD.ZB a (2 ^ p)) (hb : NLogN.BD.ZB b B) :
    NLogN.BD.ZB (mulZ p a b) (2 * B) := by
  have := mulZ_ZB p ha hb
  rwa [show 2 * 2 ^ p * B = 2 ^ p * (2 * B) by ring, Nat.mul_div_cancel_left _ (by positivity)]
    at this

theorem conjZ_ZB {a : ℤ × ℤ} {A : ℕ} (ha : NLogN.BD.ZB a A) : NLogN.BD.ZB (conjZ a) A := by
  simpa [conjZ, NLogN.BD.ZB] using ha

theorem cE1_pos (p α : ℕ) : 1 ≤ cE1 p α := by
  unfold cE1; nlinarith

theorem sTerm_ZB (p s t α k : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) (j : ℤ) :
    NLogN.BD.ZB (sTerm p s t α k U j) ((4 * p + 35) * B) := by
  have hw := sWeight_natAbs_le p s t α k j
  obtain ⟨h1, h2⟩ := hU (j % s).toNat
  constructor <;>
  · simp only [sTerm]
    apply natAbs_tdiv_pow_le
    rw [Int.natAbs_mul]
    calc _ ≤ 2 ^ (2 * p) * (4 * p + 35) * B := Nat.mul_le_mul hw (by assumption)
      _ = _ := by ring

theorem Sapprox_FB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) :
    FB (Sapprox p s t α U) (cS1 p α * B) := by
  intro k
  have e : cS1 p α * B = (2 * sWidth p α + 1) * ((4 * p + 35) * B) := by unfold cS1; ring
  rw [e]
  constructor
  · exact natAbs_sum_range_le _ _ _ fun i _ => (sTerm_ZB p s t α k U hU _).1
  · exact natAbs_sum_range_le _ _ _ fun i _ => (sTerm_ZB p s t α k U hU _).2

theorem eTerm_ZB (p s t α l : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) (h : ℤ) :
    NLogN.BD.ZB (eTerm p s t α l U h) ((4 * p + 35) * B) := by
  unfold eTerm
  split_ifs
  · simp [NLogN.BD.ZB]
  · have hw := eWeight_natAbs_le p s t α l h
    obtain ⟨h1, h2⟩ := hU ((l + h) % s).toNat
    constructor <;>
    · apply natAbs_tdiv_pow_le
      rw [Int.natAbs_mul]
      calc _ ≤ (4 * p + 35) * 2 ^ p * B := Nat.mul_le_mul hw (by assumption)
        _ = _ := by ring

theorem Eapprox_FB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) :
    FB (Eapprox p s t α U) (cE1 p α * B) := by
  intro l
  have e : cE1 p α * B = (2 * eWidth p α + 1) * ((4 * p + 35) * B) := by unfold cE1; ring
  rw [e]
  constructor
  · exact natAbs_sum_range_le _ _ _ fun i _ => (eTerm_ZB p s t α l U hU _).1
  · exact natAbs_sum_range_le _ _ _ fun i _ => (eTerm_ZB p s t α l U hU _).2

theorem halfFP_FB (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) : FB (halfFP U) B := by
  intro i
  simp only [halfFP]
  have h2 : ∀ a : ℤ, (a.tdiv 2).natAbs ≤ a.natAbs := by
    intro a; rw [Int.natAbs_tdiv]; exact Nat.div_le_self _ _
  exact ⟨(h2 _).trans (hU i).1, (h2 _).trans (hU i).2⟩

theorem vIter_FB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) :
    ∀ j, FB (vIter p s t α U j) (cE1 p α ^ j * B) := by
  intro j
  induction j with
  | zero => simpa [vIter] using halfFP_FB U hU
  | succ j ih =>
    have := Eapprox_FB p s t α _ ih
    simp only [vIter]
    refine this.mono (le_of_eq ?_)
    ring

theorem Japprox_FB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) :
    FB (Japprox p s t α U) (jIter p s t α * (cE1 p α ^ jIter p s t α * B)) := by
  intro l
  set J := jIter p s t α
  have hb : ∀ j < J, NLogN.BD.ZB (vIter p s t α U j l) (cE1 p α ^ J * B) := by
    intro j hj
    refine ⟨(vIter_FB p s t α U hU j l).1.trans ?_, (vIter_FB p s t α U hU j l).2.trans ?_⟩ <;>
    · exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (cE1_pos p α) hj.le)
  have hs : ∀ (j : ℕ) (x : ℤ), ((-1 : ℤ) ^ j * x).natAbs = x.natAbs := by
    intro j x; rw [Int.natAbs_mul, Int.natAbs_pow]; simp
  constructor
  · exact natAbs_sum_range_le _ _ _ fun j hj => by rw [hs]; exact (hb j hj).1
  · exact natAbs_sum_range_le _ _ _ fun j hj => by rw [hs]; exact (hb j hj).2

theorem Dapprox_FB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) {B : ℕ} (hU : FB U B) :
    FB (Dapprox p s t α U) ((4 * p + 35) * B) := by
  intro l
  have hw := dTilde_natAbs_le p s t α l
  obtain ⟨h1, h2⟩ := hU l
  constructor <;>
  · simp only [Dapprox]
    apply natAbs_tdiv_pow_le
    rw [Int.natAbs_mul]
    calc _ ≤ (4 * p + 35) * 2 ^ p * B := Nat.mul_le_mul hw (by assumption)
      _ = _ := by ring

theorem ptPerm_FB (s t : ℕ) (V : ℕ → ℤ × ℤ) {B : ℕ} (hV : FB V B) : FB (ptPerm s t V) B :=
  fun _ => hV _

theorem cSel_FB (s t : ℕ) (V : ℕ → ℤ × ℤ) {B : ℕ} (hV : FB V B) : FB (cSel s t V) B :=
  fun _ => hV _

theorem psInvPerm_FB (s t : ℕ) (V : ℕ → ℤ × ℤ) {B : ℕ} (hV : FB V B) :
    FB (psInvPerm s t V) B := fun _ => hV _

theorem cB1_mono (p α : ℕ) {J J' : ℕ} (h : J ≤ J') : cB1 p α J ≤ cB1 p α J' := by
  unfold cB1
  exact Nat.mul_le_mul_left _ (Nat.mul_le_mul h (Nat.pow_le_pow_right (cE1_pos p α) h))

theorem Bapprox_FB (p s t α : ℕ) (V : ℕ → ℤ × ℤ) {B : ℕ} (hV : FB V B) :
    FB (Bapprox p s t α V) (cB1 p α (jIter p s t α) * B) := by
  unfold Bapprox
  refine psInvPerm_FB _ _ _ ?_
  have := Dapprox_FB p s t α _
    (Japprox_FB p s t α _ (cSel_FB s t _ (ptPerm_FB s t V hV)))
  refine this.mono (le_of_eq ?_)
  unfold cB1; ring

theorem sapL_LB (p s t α : ℕ) {U : List (ℤ × ℤ)} {B : ℕ} (hU : LB U B) :
    LB (sapL p s t α U) (cS1 p α * B) := by
  intro z hz
  simp only [sapL, List.mem_map] at hz
  obtain ⟨k, -, rfl⟩ := hz
  exact Sapprox_FB p s t α _ hU.fB k

theorem bapL_LB (p s t α : ℕ) {V : List (ℤ × ℤ)} {B : ℕ} (hV : LB V B) :
    LB (bapL p s t α V) (cB1 p α (jIter p s t α) * B) := by
  intro z hz
  simp only [bapL, List.mem_map] at hz
  obtain ⟨k, -, rfl⟩ := hz
  exact Bapprox_FB p s t α _ hV.fB k

/-- Uniform version: if `jIter ≤ J` then `B̃` multiplies bounds by at most `cB1 p α J`. -/
theorem bapL_LB' (p s t α J : ℕ) (hJ : jIter p s t α ≤ J) {V : List (ℤ × ℤ)} {B : ℕ}
    (hV : LB V B) : LB (bapL p s t α V) (cB1 p α J * B) :=
  (bapL_LB p s t α hV).mono (Nat.mul_le_mul_right _ (cB1_mono p α hJ))

