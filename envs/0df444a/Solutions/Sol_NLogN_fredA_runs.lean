variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution {X : Fin NLogN.NS} (h1 : X ≠ NLogN.RN) (h2 : X ≠ NLogN.T1) (h3 : X ≠ NLogN.T2) (s : NLogN.IState NLogN.NS)
    (z : ℤ) (n : ℕ) (L LN : List NLogN.Item) (hX : s.G X = .int z :: L)
    (hN : s.G NLogN.RN = .int (2 ^ n) :: LN) (hz : z.natAbs < 2 ^ (2 * n + 1)) :
    NLogN.IRuns I iprog (NLogN.fredA X) s (s.upd X (.int (NLogN.fredW n z) :: L)) (2000 * (n + 2)) := by
  apply NLogN.IRuns.of_runsTo 0
  have hp : 0 < 2 ^ n := by positivity
  have e4 : NLogN.zsz (NLogN.sg (NLogN.sg z (z.natAbs / 2 ^ n)) ((NLogN.sg z (z.natAbs / 2 ^ n)).natAbs / 2 ^ n)) ≤ 1 := by
    apply NLogN.zsz_le_of_lt; rw [NLogN.natAbs_sg, NLogN.natAbs_sg, Nat.div_div_eq_div_mul, ← pow_add,
      Nat.div_lt_iff_lt_mul (by positivity), ← pow_add]
    calc z.natAbs < 2 ^ (2 * n + 1) := hz
      _ = 2 ^ (1 + (n + n)) := by ring_nf
  have e1 : NLogN.zsz (NLogN.sg z (z.natAbs % 2 ^ n)) ≤ n :=
    NLogN.zsz_le_of_lt (NLogN.sg_lt_pow _ (Nat.mod_lt _ hp))
  have e2 : NLogN.zsz (NLogN.sg (NLogN.sg z (z.natAbs / 2 ^ n)) ((NLogN.sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n)) ≤ n :=
    NLogN.zsz_le_of_lt (NLogN.sg_lt_pow _ (Nat.mod_lt _ hp))
  have e3 := NLogN.zsz_add_le (NLogN.sg z (z.natAbs % 2 ^ n))
    (-NLogN.sg (NLogN.sg z (z.natAbs / 2 ^ n)) ((NLogN.sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n))
  rw [NLogN.zsz_neg] at e3
  have e3' : NLogN.zsz (NLogN.sg z (z.natAbs % 2 ^ n) +
      -NLogN.sg (NLogN.sg z (z.natAbs / 2 ^ n)) ((NLogN.sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n)) ≤ n + 1 :=
    le_trans e3 (Nat.add_le_add_right (max_le e1 e2) 1)
  simp +decide [NLogN.fredA, NLogN.IStmt.run, NLogN.IOp.run, hX, hN, h1, h2, h3, Ne.symm h1, Ne.symm h2,
    Ne.symm h3, NLogN.zsz_neg]
  refine ⟨by unfold NLogN.fredW; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
  ((simp only [NLogN.addIntCost, NLogN.addMagCost, NLogN.subMagCost, NLogN.dupCost, NLogN.moveCost, NLogN.zipCost, NLogN.takeCost, NLogN.splitCost, NLogN.shlCost, NLogN.catCost] at *; omega))
