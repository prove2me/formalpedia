    intro x hx
    exact (Wfun_deriv (lt_trans hs hx.1)).hasDerivWithinAt
  have hint : IntervalIntegrable (fun t => 12 * Y t / t ^ 2) volume s R := by
    refine ContinuousOn.intervalIntegrable_of_Icc hR ?_
    apply ContinuousOn.div
    · exact continuousOn_const.mul (Y_continuousOn.mono (fun x hx => le_trans (le_of_lt hs) hx.1))
