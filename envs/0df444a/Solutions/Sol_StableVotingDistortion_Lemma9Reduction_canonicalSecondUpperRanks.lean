theorem solution {p q z : ℝ} (hp : p ∈ Icc (16/25:ℝ) (99/100)) (hq : q ∈ Icc (703/2500:ℝ) PaperCurve.lam) (hz : z ∈ Icc p 1) : highSecond PaperCurve.lam score (canonical score p) 1 (-(canonical score p*(1-p))) p q z 1 ≤ 0 := by
  have hqa : q ∈ Icc (0:ℝ) PaperCurve.lam := ⟨(by norm_num : (0:ℝ) ≤ 703/2500).trans hq.1,hq.2⟩
  apply highSecond_of_residual hp hqa hz
  obtain ⟨tree,ht⟩ := secondRangeCover
  rw [canonicalCachedTest_eq,quickSecondRectTest_eq] at ht
  apply second_cover_sound tree _ _ _ ht p q z
  · simpa only [Bounds.Holds, Set.mem_Icc, Rat.cast_zero, Rat.cast_div, Rat.cast_ofNat, Rat.cast_one, PaperCurve.lam, PaperCurve.lamQ] using hp
  · simpa only [Bounds.Holds, Set.mem_Icc, Rat.cast_zero, Rat.cast_div, Rat.cast_ofNat, Rat.cast_one, PaperCurve.lam, PaperCurve.lamQ] using hq
  · simpa only [Bounds.Holds, Set.mem_Icc, Rat.cast_zero, Rat.cast_div, Rat.cast_ofNat, Rat.cast_one, PaperCurve.lam, PaperCurve.lamQ] using And.intro (hp.1.trans hz.1) hz.2
  · exact hz.1
  · exact second_at_one hp hqa (StableVotingDistortion.Lemma9Reduction.canonicalFirst hp hqa)
