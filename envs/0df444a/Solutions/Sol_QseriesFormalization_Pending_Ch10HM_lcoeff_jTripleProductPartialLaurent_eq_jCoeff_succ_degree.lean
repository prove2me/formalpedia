theorem jFiniteJTPSummand_Qpow (a b : ℤ) (N k : ℕ) :
    QseriesFormalization.PartI.Ch03.finiteJTPSummand (Qpow b) (Qpow a) N k =
      gaussianBinom (Qpow b) (2 * N) k *
        jTermLaurent a b ((k : ℤ) - (N : ℤ)) := by
