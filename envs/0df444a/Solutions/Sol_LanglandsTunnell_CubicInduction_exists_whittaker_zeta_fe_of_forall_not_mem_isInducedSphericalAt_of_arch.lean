private theorem archHom_eq (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hE : ∀ u : (InfiniteAdeleRing ℚ)ˣ, M4aHerbrand.infPart (E u) = u ∧ RatIdele.finPart (E u) = 1) :
    E = LanglandsTunnell.CubicInduction.archIdeleHom :=
  MonoidHom.ext fun u => Units.ext
    ((LanglandsTunnell.CubicInduction.ArchIdeleCoe.coe_apply_eq_of_forall_infPart_eq_and_finPart_eq_one E hE
        u).trans
      (LanglandsTunnell.CubicInduction.ArchIdeleCoe.coe_apply_eq_of_forall_infPart_eq_and_finPart_eq_one _
        LanglandsTunnell.CubicInduction.infPart_archIdeleHom_eq_and_finPart_archIdeleHom_eq_one u).symm)

private theorem laurent_of (v : HeightOneSpectrum (𝓞 ℚ)) (P : ℂ → ℂ)
    (h : ∃ (Q : Polynomial ℂ) (m : ℕ), ∀ s : ℂ,
      P s = Q.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) * (Ideal.absNorm v.asIdeal : ℂ) ^ ((m : ℂ) * s)) :
    Differentiable ℂ P ∧ LanglandsTunnell.LDatum.BoundedOnStrips P := by
  obtain ⟨Q, m, hQ⟩ := h
  have hN : 0 < Ideal.absNorm v.asIdeal := lt_trans zero_lt_one (NumberField.HeightOneSpectrum.one_lt_absNorm v)
  obtain rfl : P = fun s =>
      Q.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) * (Ideal.absNorm v.asIdeal : ℂ) ^ ((m : ℂ) * s) := funext hQ
  refine ⟨(LanglandsTunnell.CubicInduction.StripAssembly.differentiable_polynomial_eval Q
      (LanglandsTunnell.CubicInduction.StripAssembly.differentiable_natCast_cpow_neg hN)).mul
    (LanglandsTunnell.CubicInduction.StripAssembly.differentiable_natCast_cpow_mul hN _), ?_⟩
  have hb := LanglandsTunnell.CubicInduction.StripAssembly.boundedOnStrips_mul
    (LanglandsTunnell.CubicInduction.StripAssembly.boundedOnStrips_polynomial_eval Q
      (LanglandsTunnell.CubicInduction.StripAssembly.boundedOnStrips_natCast_cpow_neg hN))
    (LanglandsTunnell.CubicInduction.StripAssembly.boundedOnStrips_natCast_cpow_mul hN (m : ℝ))
  rw [Complex.ofReal_natCast] at hb
  exact hb

private theorem colS_twist (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (ν : (v : HeightOneSpectrum (𝓞 ℚ)) → Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ))
    (aex : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ)
    (hcond : ∀ v ∈ S, ∀ i, 1 ≤ aex v i ∧ LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i) (aex v i))
    (hL : ∀ v ∈ S, ∀ s : ℂ, (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i) s) =
      ((inducedEulerPoly ℚ (inducedCoeff K μ) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∈ S) {Zv P : ℂ → ℂ} {σ₀ : ℝ}
    (hz0 : ∀ s : ℂ, σ₀ < s.re →
      Zv s = (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i * localChar χ v) s) * P s) :
    ∀ s : ℂ, σ₀ < s.re →
      Zv s = ((inducedEulerPoly ℚ (inducedCoeff K χT) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ * P s := by
  intro s hs
  have h0 : LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (localChar χ v) 0 :=
    LanglandsTunnell.CubicInduction.NormUnramified.hasConductorExponentAt_zero_of_isUnramifiedCharAt (hχS v hv)

  have hμv :=
    LanglandsTunnell.CubicInduction.EulerMatch.forall_not_isUnramifiedCharAt_of_prod_localLFactorAt_eq K μ v (ν v)
      (aex v) (hcond v hv) (hL v hv)
  have hχv :=
    LanglandsTunnell.CubicInduction.NormUnramified.forall_mem_primeFibre_isUnramifiedCharAt_comp_idelicNorm K χ v
      (hχS v hv)
  rw [hz0 s hs,
    LanglandsTunnell.CubicInduction.EulerMatch.prod_localLFactorAt_mul_eq_one v (ν v) (aex v) (hcond v hv)
      (localChar χ v) h0 s,
    hχTdef, LanglandsTunnell.CubicInduction.EulerMatch.inv_eval_inducedEulerPoly_mul_eq_one K μ _ v hμv hχv]

private theorem colN_twist (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K = 3) (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) (hχc : Continuous χ)
    {v : HeightOneSpectrum (𝓞 ℚ)} (hbad : ¬ IsBadPlace K μ v) {n : ℕ}
    (hn : LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (localChar χ v) n) {Zv P : ℂ → ℂ} {σ₀ : ℝ}
    (hz0 : n = 0 → ∀ s : ℂ, σ₀ < s.re →
      Zv s = ((gl3LFactorPoly
          (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) *
            inducedE1 ℚ (inducedCoeff K μ) v)
          (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) ^ 2 *
            inducedE2 ℚ (inducedCoeff K μ) v)
          (((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) ^ 3 *
            inducedE3 ℚ (inducedCoeff K μ) v)).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ * P s)
    (hz1 : 1 ≤ n → ∀ s : ℂ, σ₀ < s.re → Zv s = P s) :
    ∀ s : ℂ, σ₀ < s.re →
      Zv s = ((inducedEulerPoly ℚ (inducedCoeff K χT) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ * P s := by
  intro s hs
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · have hun : IsUnramifiedCharAt χ v :=
      LanglandsTunnell.CubicInduction.NormUnramified.isUnramifiedCharAt_of_hasConductorExponentAt_zero (h0 ▸ hn)
    have hϖ : ((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) =
        ((χ (AutomorphicForm.uniformizerIdele ℚ v) : ℂˣ) : ℂ) := by
      rw [← LanglandsTunnell.CubicInduction.TPartProduct.apply_finPlace,
        LanglandsTunnell.CubicInduction.IdeleNormSplit.finPlace_uniformizerUnit]
    rw [hz0 h0 s hs, hϖ,
      LanglandsTunnell.CubicInduction.EulerMatch.eval_gl3LFactorPoly_scaled_eq_eval_inducedEulerPoly K hdeg.le
        (inducedCoeff K μ) v,
      hχTdef, LanglandsTunnell.CubicInduction.TwistEuler.eval_inducedEulerPoly_twist_of_not_isBadPlace μ χ v hbad hun]
  · have hram : ¬ IsUnramifiedCharAt χ v := fun hun =>
      (Nat.pos_iff_ne_zero.1 hpos)
        (LanglandsTunnell.TateLocal.hasConductorExponentAt_unique ℚ v hn
          (LanglandsTunnell.CubicInduction.NormUnramified.hasConductorExponentAt_zero_of_isUnramifiedCharAt hun))
    rw [hz1 hpos s hs, hχTdef,
      LanglandsTunnell.CubicInduction.TwistEuler.eval_inducedEulerPoly_twist_eq_one_of_not_isBadPlace μ χ v hbad
        (NumberField.TateGlobal.continuous_localChar χ hχc v) hram,
      inv_one, one_mul]

private theorem colS_of (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (ν : (v : HeightOneSpectrum (𝓞 ℚ)) → Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ))
    (aex : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ)
    (hcond : ∀ v ∈ S, ∀ i, 1 ≤ aex v i ∧ LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i) (aex v i))
    (hL : ∀ v ∈ S, ∀ s : ℂ, (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i) s) =
      ((inducedEulerPoly ℚ (inducedCoeff K μ) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (αS : (v : HeightOneSpectrum (𝓞 ℚ)) → (v.adicCompletion ℚ)ˣ)
    (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (h3S : ∀ v ∈ S, ∀ χv : (v.adicCompletion ℚ)ˣ →* ℂˣ,
      LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v χv 0 →
      ‖((χv (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ)‖ = 1 →
      (letI := localBorel ℚ v
        ∃ (P : ℂ → ℂ) (σ₀ σ₁ : ℝ),
          (∃ (Q : Polynomial ℂ) (m : ℕ), ∀ s : ℂ,
            P s = Q.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) * (Ideal.absNorm v.asIdeal : ℂ) ^ ((m : ℂ) * s)) ∧
          IsLocalZeta30ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
            (Wloc v) χv (componentAt3 (𝓞 ℚ) ℚ v g) σ₀ ∧
          (∀ s : ℂ, σ₀ < s.re →
            localZeta30 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
                (Wloc v) χv s (componentAt3 (𝓞 ℚ) ℚ v g) =
              (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i * χv) s) * P s) ∧
          IsLocalZeta31ConvergentAbove v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v)))
            (selfDualHaarAt ℚ v)
            (dualWhittakerFn3 (Wloc v))
            χv⁻¹ (weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g)) σ₁ ∧
          ∃ a : Fin 3 → ℕ, (∀ i, LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i * χv) (a i)) ∧
            ∀ s : ℂ, σ₁ < (1 - s).re →
              localZetaDual31 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) (selfDualHaarAt ℚ v)
                  (Wloc v) χv (1 - s) (componentAt3 (𝓞 ℚ) ℚ v g) =
            ((localChar ω v (αS v) : ℂˣ) : ℂ) * (((χv (αS v) : ℂˣ) : ℂ) ^ 3 *
              ((∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i * χv)⁻¹ (1 - s)) *
                      ((∏ i, LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (ν v i * χv)) *
                        (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (a i : ℂ)) * (1 / 2 - s))) * P s)))) :
    ∀ v ∈ S, ∃ (P : ℂ → ℂ) (σ₀ σ₁ : ℝ),
      ColS K χT ω χ v (ν v) (αS v) (Wloc v) (componentAt3 (𝓞 ℚ) ℚ v g) P σ₀ σ₁ := by
  intro v hv
  obtain ⟨P, σ₀, σ₁, hP, hc0, hz0, hc1, aν, haν, hzd⟩ := h3S v hv (localChar χ v)
    (LanglandsTunnell.CubicInduction.NormUnramified.hasConductorExponentAt_zero_of_isUnramifiedCharAt (hχS v hv))
    (hχu _)
  exact ⟨P, σ₀, σ₁, hP, hc0, colS_twist K μ S χ χT hχTdef ν aex hcond hL hχS hv hz0, hc1, aν, haν, hzd⟩

