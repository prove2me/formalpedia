      have h2 := tendsto_inv_nhdsLT_zero.comp h1
      have h3 : Tendsto (fun y : ℝ => ent g 0 0 / ent g 1 0 +
          -(ent g 1 0 * (ent g 1 0 * y + ent g 1 1))⁻¹) (𝓝[<] t) atTop :=
        tendsto_atTop_add_const_left _ _ (tendsto_neg_atBot_atTop.comp h2)
      refine (tendsto_map.comp h3).congr' ?_
      filter_upwards [self_mem_nhdsWithin] with y hy
      have hy' : ent g 1 0 * y + ent g 1 1 ≠ 0 := by
        intro h0
        have := hid y
        rw [h0, mul_zero] at this
        have := mul_neg_of_pos_of_neg (mul_self_pos.2 hc) (sub_neg.2 (show y < t from hy))
        linarith
      simp only [Function.comp_apply]
      rw [mob_coe, if_neg hy', frac_eq g hc hy', sub_eq_add_neg]
    · rw [mob_coe, if_neg ht, LF_coe, LF_coe, tendsto_map'_iff]
      have h3 : Tendsto (fun y : ℝ => (ent g 0 0 * y + ent g 0 1) / (ent g 1 0 * y + ent g 1 1))
          (𝓝[<] t) (𝓝[<] ((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1))) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨(cont_frac g ht).tendsto.mono_left nhdsWithin_le_nhds, ?_⟩
        filter_upwards [self_mem_nhdsWithin, nhdsWithin_le_nhds (ev_pos_prod g ht)] with y hy hpos
        rw [mem_Iio, ← sub_neg, sub_frac g (ne_of_pos_prod hpos) ht]
        exact div_neg_of_neg_of_pos (sub_neg.2 hy) hpos
      refine (tendsto_map.comp h3).congr' ?_
      filter_upwards [nhdsWithin_le_nhds (ev_pos_prod g ht)] with y hpos
      simp only [Function.comp_apply]
      rw [mob_coe, if_neg (ne_of_pos_prod hpos)]

/-! ### Germ property, generically in a filter family -/

/-- `f` agrees along `F x` with a Möbius map, for every `x`. -/
def GermP (F : OnePoint ℝ → Filter (OnePoint ℝ)) (A : Subring ℝ)
    (f : OnePoint ℝ ≃ₜ OnePoint ℝ) : Prop :=
  ∀ x, ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[F x] mob g

section generic

variable {F : OnePoint ℝ → Filter (OnePoint ℝ)} (hle : ∀ x, F x ≤ 𝓝 x) [hne : ∀ x, NeBot (F x)]
  (htend : ∀ (g : Matrix.SpecialLinearGroup (Fin 2) A) x, Tendsto (mob g) (F x) (F (mob g x)))

include hle in
lemma germ_value {f : OnePoint ℝ → OnePoint ℝ} (hf : Continuous f)
    {g : Matrix.SpecialLinearGroup (Fin 2) A} {x : OnePoint ℝ} (h : f =ᶠ[F x] mob g) :
    f x = mob g x :=
  tendsto_nhds_unique ((hf.tendsto x).mono_left (hle x))
    ((((continuous_mob g).tendsto x).mono_left (hle x)).congr' h.symm)

include hle htend in
lemma GermP_mul {f1 f2 : OnePoint ℝ ≃ₜ OnePoint ℝ} (h1 : GermP F A f1) (h2 : GermP F A f2) :
    GermP F A (f1 * f2) := by
  intro x
  obtain ⟨g2, hg2⟩ := h2 x
  obtain ⟨g1, hg1⟩ := h1 (f2 x)
  refine ⟨g1 * g2, ?_⟩
  have hx : f2 x = mob g2 x := germ_value hle f2.continuous hg2
  have ht : Tendsto f2 (F x) (F (f2 x)) := by
    rw [hx]; exact (htend g2 x).congr' hg2.symm
  filter_upwards [ht.eventually hg1, hg2] with y hy1 hy2
  rw [Homeomorph.mul_apply, mob_mul, hy1, hy2]

include hle htend in
lemma GermP_inv {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (h : GermP F A f) : GermP F A f⁻¹ := by
  intro x
  obtain ⟨g, hg⟩ := h (f.symm x)
  refine ⟨g⁻¹, ?_⟩
  have hx : f (f.symm x) = mob g (f.symm x) := germ_value hle f.continuous hg
  rw [Homeomorph.apply_symm_apply] at hx
  have hy : mob g⁻¹ x = f.symm x := by conv_lhs => rw [hx]
                                       exact mob_inv_mob _ _
  have ht : Tendsto (mob g⁻¹) (F x) (F (f.symm x)) := by rw [← hy]; exact htend g⁻¹ x
  filter_upwards [ht.eventually hg] with z hz
  rw [mob_mob_inv] at hz
  rw [Homeomorph.inv_apply]
  conv_lhs => rw [← hz]
  exact f.symm_apply_apply _

omit hne in
lemma GermP_one : GermP F A 1 := fun _ => ⟨1, Eventually.of_forall fun y => (mob_one y).symm⟩

include hle htend in
lemma GermP_of_mem_G (hgen : ∀ f, IsPiecewiseProj A f → GermP F A f) :
    ∀ f ∈ G A, GermP F A f := by
  intro f hf
  rw [Monod.Dev.GMono.G_eq_closure_isPiecewiseProj] at hf
  induction hf using Subgroup.closure_induction with
  | mem x hx => exact hgen x hx
  | one => exact GermP_one
  | mul x y _ _ hx hy => exact GermP_mul hle htend hx hy
  | inv x _ hx => exact GermP_inv hle htend hx

end generic

lemma germ_gen_aux {f : OnePoint ℝ ≃ₜ OnePoint ℝ} {B : Finset (OnePoint ℝ)}
    (hloc : ∀ x ∉ B, ∃ g : Matrix.SpecialLinearGroup (Fin 2) A,
      ∀ᶠ y in 𝓝 x, f y = mob g y)
    (Fr : Filter ℝ) [NeBot Fr] {I : Set ℝ} (hIF : I ∈ Fr) (hI : IsPreconnected I)
    (hIB : ∀ y ∈ I, (y : OnePoint ℝ) ∉ B) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) A,
      (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[map (fun y : ℝ => (y : OnePoint ℝ)) Fr] mob g := by
  obtain ⟨y0, hy0⟩ := Filter.nonempty_of_mem hIF
  obtain ⟨g, hg⟩ := exists_mob_eqOn (A := A) f hI hy0 (fun y hy => hloc _ (hIB y hy))
  exact ⟨g, Filter.eventually_map.2 (Filter.mem_of_superset hIF (fun y hy => hg y hy))⟩

lemma gen_RF {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : IsPiecewiseProj A f) : GermP RF A f := by
  obtain ⟨B, -, hloc⟩ := hf
  intro x
  cases x with
  | infty =>
    have hev : ∀ᶠ y : ℝ in atBot, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      cases b with
      | infty => exact Eventually.of_forall (fun y => coe_ne_infty y)
      | coe s =>
        filter_upwards [eventually_lt_atBot s] with y hy h
        exact (ne_of_lt hy) (coe_injective h)
    obtain ⟨M, hM⟩ := eventually_atBot.1 hev
    exact germ_gen_aux hloc atBot (Iio_mem_atBot M) isPreconnected_Iio
      (fun y hy hyB => hM y (le_of_lt hy) _ hyB rfl)
  | coe t =>
    have hev : ∀ᶠ y : ℝ in 𝓝[>] t, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      by_cases hbt : b = (t : OnePoint ℝ)
      · subst hbt
        filter_upwards [self_mem_nhdsWithin] with y hy h
        exact (ne_of_gt (show t < y from hy)) (coe_injective h)
      · exact nhdsWithin_le_nhds ((continuous_coe.continuousAt (x := t)).eventually_ne (Ne.symm hbt))
    obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
    exact germ_gen_aux hloc (𝓝[>] t) (mem_nhdsGT_iff_exists_Ioo_subset.2 ⟨u, hu, subset_rfl⟩)
      isPreconnected_Ioo (fun y hy hyB => hsub hy _ hyB rfl)

lemma gen_LF {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : IsPiecewiseProj A f) : GermP LF A f := by
  obtain ⟨B, -, hloc⟩ := hf
  intro x
  cases x with
  | infty =>
    have hev : ∀ᶠ y : ℝ in atTop, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      cases b with
      | infty => exact Eventually.of_forall (fun y => coe_ne_infty y)
      | coe s =>
        filter_upwards [eventually_gt_atTop s] with y hy h
        exact (ne_of_gt hy) (coe_injective h)
    obtain ⟨M, hM⟩ := eventually_atTop.1 hev
    exact germ_gen_aux hloc atTop (Ioi_mem_atTop M) isPreconnected_Ioi
      (fun y hy hyB => hM y (le_of_lt hy) _ hyB rfl)
  | coe t =>
    have hev : ∀ᶠ y : ℝ in 𝓝[<] t, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      by_cases hbt : b = (t : OnePoint ℝ)
      · subst hbt
        filter_upwards [self_mem_nhdsWithin] with y hy h
        exact (ne_of_lt (show y < t from hy)) (coe_injective h)
      · exact nhdsWithin_le_nhds ((continuous_coe.continuousAt (x := t)).eventually_ne (Ne.symm hbt))
    obtain ⟨l, hl, hsub⟩ := mem_nhdsLT_iff_exists_Ioo_subset.1 hev
    exact germ_gen_aux hloc (𝓝[<] t) (mem_nhdsLT_iff_exists_Ioo_subset.2 ⟨l, hl, subset_rfl⟩)
      isPreconnected_Ioo (fun y hy hyB => hsub hy _ hyB rfl)

theorem germR_of_mem_G {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G A) : GermP RF A f :=
  GermP_of_mem_G RF_le_nhds tendsto_RF (fun _ h => gen_RF h) f hf

theorem germL_of_mem_G {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G A) : GermP LF A f :=
  GermP_of_mem_G LF_le_nhds tendsto_LF (fun _ h => gen_LF h) f hf

