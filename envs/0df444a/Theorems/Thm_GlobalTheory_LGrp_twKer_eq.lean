variable {G H V W : Type} [Group G] [Group H] [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]

theorem GlobalTheory.LGrp.twKer_eq (ρ : Representation ℂ G V) (N : Subgroup G) (ψ : N →* ℂˣ) :
    twKer ρ N ψ = Representation.Coinvariants.ker (twist ψ⁻¹ (ρ.comp N.subtype)) := by sorry
