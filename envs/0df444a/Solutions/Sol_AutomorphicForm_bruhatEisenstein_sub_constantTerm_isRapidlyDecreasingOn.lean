private theorem abs_iteratedDeriv_angle_le_rad {h : Matrix (Fin 2) (Fin 2) ℝ} (hh : h.det ≠ 0)
    (k : ℕ) (u : ℝ) :
    |iteratedDeriv (k + 1) (angle h) u|
      ≤ (k ! : ℝ) * (Real.sqrt (botNormSq h) / rad h u) ^ (k + 1) := by
  have hdir : ‖dir h‖ = Real.sqrt (botNormSq h) := by
    rw [← norm_dir_sq, Real.sqrt_sq (norm_nonneg _)]
  have hrad : ‖(u : ℂ) - center h‖ = rad h u / Real.sqrt (botNormSq h) := by
    rw [rad_eq hh, hdir]
    exact (mul_div_cancel_left₀ _ (Real.sqrt_pos.2 (botNormSq_pos hh)).ne').symm
  have hk : (-1 - (k : ℤ)) = -(((k + 1 : ℕ)) : ℤ) := by push_cast; ring
  rw [iteratedDeriv_angle_succ hh]
  refine (Complex.abs_im_le_norm _).trans ?_
  rw [invTower, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul,
    Complex.norm_natCast, hk, zpow_neg, zpow_natCast, norm_inv, norm_pow, hrad]
  rw [div_pow, div_pow, inv_div]

private theorem botNormSq_argMat (c₀ c₁ : ℂ) : botNormSq (argMat c₀ c₁) = normSq c₁ := by
  rw [botNormSq, argMat, normSq_apply]
  simp only [Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
    Matrix.cons_val_fin_one, Matrix.of_apply]
  ring

private theorem iteratedDeriv_succ_const (c : ℝ) (k : ℕ) (t : ℝ) :
    iteratedDeriv (k + 1) (fun _ : ℝ => c) t = 0 := by
  induction k with
  | zero => simp [iteratedDeriv_succ]
  | succ n ih =>
    rw [iteratedDeriv_succ']
    have : (deriv fun _ : ℝ => c) = fun _ : ℝ => (0 : ℝ) := by
      funext x
      exact deriv_const x c
    rw [this]
    induction n with
    | zero => simp [iteratedDeriv_succ]
    | succ m ihm =>
      rw [iteratedDeriv_succ']
      simpa using ihm

private theorem exists_smooth_arg_branch (c₀ c₁ : ℂ) {s : Set ℝ} (hconv : Convex ℝ s)
    (hne : ∀ t ∈ s, c₀ + t * c₁ ≠ 0) :
    ∃ μf : ℝ → ℝ, ContDiff ℝ ∞ μf ∧
      (∀ t ∈ s, Complex.exp ((μf t : ℂ) * Complex.I) * (c₀ + t * c₁)
          = (‖c₀ + t * c₁‖ : ℂ)) ∧
      ∀ k t, |iteratedDeriv (k + 1) μf t|
        ≤ (k ! : ℝ) * (Real.sqrt (normSq c₁) / ‖c₀ + t * c₁‖) ^ (k + 1) := by
  by_cases hdet : (argMat c₀ c₁).det ≠ 0
  ·
    refine ⟨fun t => -angle (argMat c₀ c₁) t, (contDiff_angle hdet).neg, ?_, ?_⟩
    · intro t ht
      have h := exp_neg_angle_argMat hdet t
      rw [rad_argMat] at h
      rw [Complex.ofReal_neg, neg_mul]
      exact h
    · intro k t
      have hb : (fun t => -angle (argMat c₀ c₁) t) = -angle (argMat c₀ c₁) := rfl
      rw [hb, iteratedDeriv_neg, abs_neg]
      have := abs_iteratedDeriv_angle_le_rad hdet k t
      rw [botNormSq_argMat, rad_argMat] at this
      exact this
  ·
    rw [ne_eq, not_not] at hdet
    rcases Set.eq_empty_or_nonempty s with hs | ⟨t₀, ht₀⟩
    · exact ⟨fun _ => 0, contDiff_const, fun t ht => by simp [hs] at ht,
        fun k t => by
          rw [iteratedDeriv_succ_const, abs_zero]
          positivity⟩
    · refine ⟨fun _ => -Complex.arg (c₀ + t₀ * c₁), contDiff_const, ?_, ?_⟩
      · intro t ht
        have harg : Complex.arg (c₀ + t * c₁) = Complex.arg (c₀ + t₀ * c₁) := by
          by_cases hc₁ : c₁ = 0
          · rw [hc₁, mul_zero, mul_zero]
          ·
            have hw : ∃ w₀ : ℝ, c₀ = (w₀ : ℂ) * c₁ := by
              refine ⟨(c₀ * conj c₁).re / normSq c₁, ?_⟩
              have hre : (c₀ * conj c₁).im = 0 := by
                have hdi := det_argMat c₀ c₁
