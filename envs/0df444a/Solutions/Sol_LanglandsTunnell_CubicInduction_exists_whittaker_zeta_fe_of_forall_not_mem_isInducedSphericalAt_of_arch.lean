section

variable (v : HeightOneSpectrum (𝓞 ℚ))
variable {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} {mA : MeasurableSpace (v.adicCompletion ℚ)}
variable (μ : Measure (v.adicCompletion ℚ)ˣ) (ν : Measure (v.adicCompletion ℚ))

private theorem localZeta31_comp_mul_left
    (hν : ∀ c : (v.adicCompletion ℚ)ˣ, TateLocal.modulus (c : v.adicCompletion ℚ) = 1 →
      ∀ f : v.adicCompletion ℚ → ℂ, ∫ x, f ((c : v.adicCompletion ℚ) * x) ∂ν = ∫ x, f x ∂ν)
    (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) (s : ℂ) {D : LocalGL3 v} {c : (v.adicCompletion ℚ)ˣ}
    (hc : TateLocal.modulus (c : v.adicCompletion ℚ) = 1)
    (hD : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      D * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x) =
        iotaGL (diagUnitGL2 y) * lowerUnipotent21 ((c : v.adicCompletion ℚ) * x) * D)
    (q : LocalGL3 v) :
    localZeta31 v μ ν (fun h => F (D * h)) χ s q = localZeta31 v μ ν F χ s (D * q) := by
  have hinner : ∀ y : (v.adicCompletion ℚ)ˣ,
      (∫ x, F (D * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * q)) ∂ν) =
        ∫ x, F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (D * q)) ∂ν := by
    intro y
    calc (∫ x, F (D * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * q)) ∂ν)
        = ∫ x, F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 ((c : v.adicCompletion ℚ) * x) * (D * q)) ∂ν := by
          congr 1
          funext x
          rw [← mul_assoc, hD y x, mul_assoc]
      _ = ∫ x, F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (D * q)) ∂ν :=
          hν c hc (fun x => F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (D * q)))
  simp only [localZeta31]
  congr 1
  funext y
  rw [hinner y]

private theorem localZeta31_glScalar_mul (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) (s : ℂ)
    {z : (v.adicCompletion ℚ)ˣ} {C : ℂ}
    (hF : ∀ X : LocalGL3 v, F (Matrix.GeneralLinearGroup.scalar (Fin 3) z * X) = C * F X) (q : LocalGL3 v) :
    localZeta31 v μ ν F χ s (Matrix.GeneralLinearGroup.scalar (Fin 3) z * q) = C * localZeta31 v μ ν F χ s q := by
  have hpoint : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (Matrix.GeneralLinearGroup.scalar (Fin 3) z * q) =
        Matrix.GeneralLinearGroup.scalar (Fin 3) z * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * q) := by
    intro y x
    rw [← mul_assoc, ← ScalarComponents.glScalar_mul_comm, mul_assoc]
  simp only [localZeta31, hpoint, hF]
  simp only [integral_const_mul, mul_assoc]

private theorem localZeta31_iotaGL_diagUnitGL2_mul
    (hμ : ∀ (u : (v.adicCompletion ℚ)ˣ) (f : (v.adicCompletion ℚ)ˣ → ℂ), ∫ y, f (u * y) ∂μ = ∫ y, f y ∂μ)
    (hν : ∀ c : (v.adicCompletion ℚ)ˣ, TateLocal.modulus (c : v.adicCompletion ℚ) = 1 →
      ∀ f : v.adicCompletion ℚ → ℂ, ∫ x, f ((c : v.adicCompletion ℚ) * x) ∂ν = ∫ x, f x ∂ν)
    (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) (s : ℂ) {b : (v.adicCompletion ℚ)ˣ}
    (hb : TateLocal.modulus (b : v.adicCompletion ℚ) = 1) (q : LocalGL3 v) :
    localZeta31 v μ ν F χ s (iotaGL (diagUnitGL2 b) * q) = ((χ b⁻¹ : ℂˣ) : ℂ) * localZeta31 v μ ν F χ s q := by
  have hmb : TateLocal.modulus ((b⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := modulus_coe_inv_eq_one hb
  have hinner : ∀ y : (v.adicCompletion ℚ)ˣ,
      (∫ x, F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (iotaGL (diagUnitGL2 b) * q)) ∂ν) =
        ∫ x, F (iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 x * q) ∂ν := by
    intro y
    calc (∫ x, F (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (iotaGL (diagUnitGL2 b) * q)) ∂ν)
        = ∫ x, F (iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 ((b : v.adicCompletion ℚ) * x) * q) ∂ν := by
          congr 1
          funext x
          rw [← mul_assoc, mul_assoc (iotaGL (diagUnitGL2 y)), lowerUnipotent21_mul_iotaGL_diagUnitGL2, ← mul_assoc,
            ← TorusPoints.iotaGL_diagUnitGL2_mul, mul_comm y b]
      _ = ∫ x, F (iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 x * q) ∂ν :=
          hν b hb (fun x => F (iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 x * q))
  calc localZeta31 v μ ν F χ s (iotaGL (diagUnitGL2 b) * q)
      = ∫ y, (∫ x, F (iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 x * q) ∂ν) *
          ((χ (b⁻¹ * (b * y)) : ℂˣ) : ℂ) *
            ((TateLocal.modulus (((b⁻¹ * (b * y) : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) : ℝ) : ℂ) ^ (s - 1)
              ∂μ := by
        simp only [localZeta31]
        congr 1
        funext y
        rw [hinner y, inv_mul_cancel_left]
    _ = ∫ z, (∫ x, F (iotaGL (diagUnitGL2 z) * lowerUnipotent21 x * q) ∂ν) * ((χ (b⁻¹ * z) : ℂˣ) : ℂ) *
          ((TateLocal.modulus (((b⁻¹ * z : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) : ℝ) : ℂ) ^ (s - 1) ∂μ :=
        hμ b (fun z => (∫ x, F (iotaGL (diagUnitGL2 z) * lowerUnipotent21 x * q) ∂ν) * ((χ (b⁻¹ * z) : ℂˣ) : ℂ) *
          ((TateLocal.modulus (((b⁻¹ * z : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) : ℝ) : ℂ) ^ (s - 1))
    _ = ((χ b⁻¹ : ℂˣ) : ℂ) * localZeta31 v μ ν F χ s q := by
        simp only [localZeta31]
        rw [← integral_const_mul]
        congr 1
        funext z
        rw [map_mul, Units.val_mul, Units.val_mul, TateLocal.modulus_mul, hmb, one_mul]
        ring

end
