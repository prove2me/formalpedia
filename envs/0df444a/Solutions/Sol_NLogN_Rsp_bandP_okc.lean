          rw [show Dl[k]! = Dl[k] by simp [hk']]; exact hdm _ (List.getElem_mem hk')
        have := Nat.mul_le_mul_right (14000 * (B + 2)) this
        omega)
    rw [eC] at cL
    have ec : NLogN.Rsp.roundBody.cost M u0 = (push BCC (.lit 0)).cost u0 +
        ((RM.rep BCK (.reg BN) kBody).cost M u + postL.cost ((RM.rep BCK (.reg BN) kBody).run u)) := by
      rfl
    rw [ec, hrun, cost_push_lit0]
    have p := hP.2
    simp only [List.length_reverse, List.length_take] at p
    have hmin : min (NLogN.Rsp.pre Dl n) Xi.length ≤ Xi.length := min_le_right _ _
    simp only [Ex.size] at cL
    unfold roundCost
    nlinarith

theorem bandF_snoc (R : ℤ) (Dl : List ℕ) (W : List ℤ) :
    ∀ (Ws : List (List ℤ)) (X acc : List ℤ),
    bandF R Dl (Ws ++ [W]) X acc = bandRound R (X.drop Ws.length) Dl W (bandF R Dl Ws X acc)
  | [], X, acc => by simp [bandF]
  | Wi :: Ws, X, acc => by
    simp only [List.cons_append, bandF, List.length_cons]
    rw [bandF_snoc R Dl W Ws, List.drop_drop]; congr 2; omega

theorem flatten_drop (Ws : List (List ℤ)) (j : ℕ) (hj : j < Ws.length) :
    (Ws.drop j).flatten = Ws[j] ++ (Ws.drop (j + 1)).flatten := by
  rw [List.drop_eq_getElem_cons hj, List.flatten_cons]

set_option maxHeartbeats 4000000 in
theorem outer_states (s : IState HS) (R : ℤ) (Xl : List ℤ) (Dl : List ℕ) (Ws : List (List ℤ))
    (acc : List ℤ) (RX RW RD RA LR LN LNR : List Item) (n NR : ℕ)
    (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n) (hDl : Dl.length = n)
    (hal : acc.length = n) (hXl : NLogN.Rsp.pre Dl n + NR ≤ Xl.length)
    (hR : s.G BR = .int R :: LR) (hN : s.G BN = .int n :: LN) (hNR : s.G BNR = .int NR :: LNR)
    (hX : s.G NLogN.Rsp.BX = ints Xl ++ RX) (hW : s.G NLogN.Rsp.BW = ints Ws.flatten ++ RW)
    (hD : s.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : s.G BA = ints acc ++ RA) :
    RM.RepStates BCR (.reg BNR) NLogN.Rsp.roundBody s (rSt s R Xl Dl Ws acc RX RW RA) where
  nonneg := by simp [Ex.eval, IState.top, hNR]
  hw := by decide
  h0 := by
    apply IState.ext' _ (by simp [rSt]) (by simp [rSt])
    intro x; simp only [rSt, IState.upd_G]
    split_ifs <;> subst_vars <;> simp_all [bandF]
  hG := fun k => by simp (config := {decide := true}) [rSt]
  step := fun k hk => by
    have e : ((Ex.reg BNR).eval s).toNat = NR := by simp [Ex.eval, IState.top, hNR]
    rw [e] at hk ⊢
    generalize ht : withCtr BCR s NR k (rSt s R Xl Dl Ws acc RX RW RA k) = t
    have tG : ∀ x, x ≠ BCR → t.G x = (rSt s R Xl Dl Ws acc RX RW RA k).G x := fun x hx => by
      rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
    have hkW : k < Ws.length := by omega
    have hlen : (Ws[k]).length = n := hWr _ (List.getElem_mem hkW)
    have hacc : (bandF R Dl (Ws.take k) Xl acc).length = n := by rw [bandF_length, hal]
    have hr := round_run t R (Xl.drop k) Dl Ws[k] (bandF R Dl (Ws.take k) Xl acc) RX
      (ints (Ws.drop (k + 1)).flatten ++ RW) RD RA LR LN n hlen hDl hacc
      (by simp; omega)
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hR])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hN])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, flatten_drop Ws k hkW,
        ints_append])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hD])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt])
    rw [hr]
    have hsnoc : bandF R Dl (Ws.take (k + 1)) Xl acc =
        bandRound R (Xl.drop k) Dl Ws[k] (bandF R Dl (Ws.take k) Xl acc) := by
      rw [← List.take_concat_get' Ws k hkW, bandF_snoc, List.length_take, min_eq_left hkW.le]
    have hft : (Ws.take (k + 1)).flatten.reverse = Ws[k].reverse ++ (Ws.take k).flatten.reverse := by
      rw [← List.take_concat_get' Ws k hkW, List.flatten_append, List.flatten_singleton,
        List.reverse_append]
    rw [← ht]
    apply IState.ext' _ (by simp [withCtr, rSt]) (by simp [withCtr, rSt])
    intro x
    simp only [withCtr, rSt, IState.upd_G]
    split_ifs <;> subst_vars <;> simp_all (config := {decide := true}) [ints_append, ints_reverse]

theorem flatten_length_eq (Ws : List (List ℤ)) (n : ℕ) (hWr : ∀ W ∈ Ws, W.length = n) :
    Ws.flatten.length = n * Ws.length := by
  induction Ws with
  | nil => simp
  | cons W Ws ih =>
    simp only [List.flatten_cons, List.length_append, List.length_cons]
    rw [hWr W (by simp), ih (fun W' h => hWr W' (by simp [h]))]; ring

end NLogN.Rsp

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.Rsp
open IntMul NLogN RS
set_option maxHeartbeats 4000000
theorem solution (M : NLogN.MulSpec) (m Φ B sh dmax : ℕ) (hM : NLogN.MulBnd M m Φ) (s : NLogN.IState NLogN.HS) (R : ℤ)
    (Xl : List ℤ) (Dl : List ℕ) (Ws : List (List ℤ))
    (acc : List ℤ) (RX RW RD RA LR LN LNR LNW : List NLogN.Item) (n NR : ℕ)
    (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n) (hDl : Dl.length = n)
    (hal : acc.length = n) (hXl : NLogN.Rsp.pre Dl n + NR ≤ Xl.length)
    (hR : s.G NLogN.Rsp.BR = .int R :: LR) (hN : s.G NLogN.Rsp.BN = .int n :: LN) (hNR : s.G NLogN.Rsp.BNR = .int NR :: LNR)
    (hNW : s.G NLogN.Rsp.BNW = .int (n * NR : ℕ) :: LNW)
    (hX : s.G NLogN.Rsp.BX = NLogN.ints Xl ++ RX) (hW : s.G NLogN.Rsp.BW = NLogN.ints Ws.flatten ++ RW)
    (hD : s.G NLogN.Rsp.BD = NLogN.ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : s.G NLogN.Rsp.BA = NLogN.ints acc ++ RA)
    (hRsh : R = 2 ^ sh)
    (hXB : ∀ y ∈ Xl, NLogN.zsz y ≤ m) (hWB : ∀ W ∈ Ws, ∀ y ∈ W, NLogN.zsz y ≤ m)
    (hAB : ∀ j ≤ NR, ∀ y ∈ NLogN.Rsp.bandF R Dl (Ws.take j) Xl acc, NLogN.zsz y ≤ B)
    (hmB : 2 * m ≤ B) (hLB : NLogN.zsz (Xl.length : ℤ) ≤ B) (hsh : sh + 1 ≤ B)
    (hnB : NLogN.zsz ((n * NR : ℕ) : ℤ) ≤ B) (hn1 : NLogN.zsz (n : ℤ) ≤ B) (hdm : ∀ d ∈ Dl, d ≤ dmax) :
    NLogN.Rsp.bandP.ok M s ∧ NLogN.Rsp.bandP.cost M s ≤ NLogN.Rsp.bandCost n NR m Φ B dmax Xl.length := by
  have H := NLogN.Rsp.outer_states s R Xl Dl Ws acc RX RW RD RA LR LN LNR n NR hWs hWr hDl hal hXl hR hN hNR
    hX hW hD hA
  have e : ((NLogN.Ex.reg NLogN.Rsp.BNR).eval s).toNat = NR := by simp [NLogN.Ex.eval, NLogN.IState.top, hNR]
  have hrun := H.run
  rw [e] at hrun
  have hround : ∀ k < ((NLogN.Ex.reg NLogN.Rsp.BNR).eval s).toNat,
      NLogN.Rsp.roundBody.ok M (NLogN.withCtr NLogN.Rsp.BCR s ((NLogN.Ex.reg NLogN.Rsp.BNR).eval s).toNat k (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA k)) ∧
      NLogN.Rsp.roundBody.cost M (NLogN.withCtr NLogN.Rsp.BCR s ((NLogN.Ex.reg NLogN.Rsp.BNR).eval s).toNat k (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA k))
        ≤ NLogN.Rsp.roundCost n m Φ B dmax Xl.length := by
    intro k hk
    rw [e] at hk ⊢
    generalize ht : NLogN.withCtr NLogN.Rsp.BCR s NR k (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA k) = t
    have tG : ∀ x, x ≠ NLogN.Rsp.BCR → t.G x = (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA k).G x := fun x hx => by
      rw [← ht, NLogN.Rsp.withCtr_G_ne' _ _ _ _ _ _ hx]
    have hkW : k < Ws.length := by omega
    have hlen : (Ws[k]).length = n := hWr _ (List.getElem_mem hkW)
    have hacc : (NLogN.Rsp.bandF R Dl (Ws.take k) Xl acc).length = n := by rw [NLogN.Rsp.bandF_length, hal]
    have hsnoc : NLogN.Rsp.bandF R Dl (Ws.take (k + 1)) Xl acc =
        NLogN.Rsp.bandRound R (Xl.drop k) Dl Ws[k] (NLogN.Rsp.bandF R Dl (Ws.take k) Xl acc) := by
      rw [← List.take_concat_get' Ws k hkW, NLogN.Rsp.bandF_snoc, List.length_take, min_eq_left hkW.le]
    have hro := NLogN.Rsp.round_okc M m Φ B sh dmax hM t R (Xl.drop k) Dl Ws[k] (NLogN.Rsp.bandF R Dl (Ws.take k) Xl acc) RX
      (NLogN.ints (Ws.drop (k + 1)).flatten ++ RW) RD RA LR LN n hlen hDl hacc
      (by simp; omega)
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt, hR])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt, hN])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt, NLogN.Rsp.flatten_drop Ws k hkW,
        NLogN.ints_append])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt, hD])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [NLogN.Rsp.rSt])
      hRsh (fun y hy => hXB y (List.mem_of_mem_drop hy)) (hWB _ (List.getElem_mem hkW))
      (hAB k (by omega)) (by rw [← hsnoc]; exact hAB (k + 1) (by omega)) hmB
      (le_trans (NLogN.zsz_natCast_le (by simp)) hLB) hsh hn1 hdm
    refine ⟨hro.1, le_trans hro.2 ?_⟩
    unfold NLogN.Rsp.roundCost
    have : (Xl.drop k).length ≤ Xl.length := by simp
    have := Nat.mul_le_mul_right (14000 * (B + 2)) this
    omega
  have hWt : Ws.take NR = Ws := List.take_of_length_le (by omega)
  have hm := NLogN.mvK_spec (X := NLogN.Rsp.BWT) (Y := NLogN.Rsp.BW) (C := NLogN.Rsp.BCK) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg NLogN.Rsp.BNW) (NLogN.RS.clean_of_lt (by decide))
    (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA NR) Ws.flatten.reverse (s.G NLogN.Rsp.BWT)
    (by simp (config := {decide := true}) [NLogN.Rsp.rSt, hWt, NLogN.ints_reverse])
    (NLogN.IState.isInt_of (L := LNW) (a := ((n * NR : ℕ) : ℤ)) (by simp (config := {decide := true}) [NLogN.Rsp.rSt, hNW]))
    (by simp (config := {decide := true}) [NLogN.Ex.eval, NLogN.IState.top, NLogN.Rsp.rSt, hNW, NLogN.Rsp.flatten_length_eq Ws n hWr, hWs])
  have hc := NLogN.mvK_cost (X := NLogN.Rsp.BWT) (Y := NLogN.Rsp.BW) (C := NLogN.Rsp.BCK) (by decide) (by decide) (by decide) (.reg NLogN.Rsp.BNW)
    (NLogN.Rsp.rSt s R Xl Dl Ws acc RX RW RA NR) Ws.flatten.reverse (s.G NLogN.Rsp.BWT)
    (by simp (config := {decide := true}) [NLogN.Rsp.rSt, hWt, NLogN.ints_reverse])
    (by simp (config := {decide := true}) [NLogN.Ex.eval, NLogN.IState.top, NLogN.Rsp.rSt, hNW, NLogN.Rsp.flatten_length_eq Ws n hWr, hWs])
    B (fun y hy => by
      obtain ⟨W, hW, hyW⟩ := List.mem_flatten.1 (List.mem_reverse.1 hy)
      exact le_trans (hWB W hW y hyW) (by omega)) trivial
    (by simpa (config := {decide := true}) [NLogN.Ex.Bnd, NLogN.IState.top, NLogN.Rsp.rSt, hNW] using hnB)
  refine ⟨⟨H.ok (by decide) (by decide) (NLogN.IState.isInt_of hNR) (fun k hk => (hround k hk).1), ?_⟩, ?_⟩
  · show (NLogN.mvK NLogN.Rsp.BWT NLogN.Rsp.BW NLogN.Rsp.BCK (.reg NLogN.Rsp.BNW)).ok ((NLogN.RM.rep NLogN.Rsp.BCR (.reg NLogN.Rsp.BNR) NLogN.Rsp.roundBody).run s)
    rw [hrun]; exact hm.1
  · have cL := H.cost_le_lin B (NLogN.Rsp.roundCost n m Φ B dmax Xl.length) trivial
      (by simpa [NLogN.Ex.Bnd, NLogN.IState.top, hNR] using (le_trans (NLogN.zsz_natCast_le (Nat.le_of_lt_succ (by omega))) hLB))
      (fun k hk => (hround k hk).2)
    rw [e] at cL
    have ec : NLogN.Rsp.bandP.cost M s = (NLogN.RM.rep NLogN.Rsp.BCR (.reg NLogN.Rsp.BNR) NLogN.Rsp.roundBody).cost M s +
        (NLogN.mvK NLogN.Rsp.BWT NLogN.Rsp.BW NLogN.Rsp.BCK (.reg NLogN.Rsp.BNW)).cost ((NLogN.RM.rep NLogN.Rsp.BCR (.reg NLogN.Rsp.BNR) NLogN.Rsp.roundBody).run s) := rfl
    rw [ec, hrun]
    simp only [NLogN.Ex.size, List.length_reverse, NLogN.Rsp.flatten_length_eq Ws n hWr, hWs] at cL hc
    unfold NLogN.Rsp.bandCost
    nlinarith
end
