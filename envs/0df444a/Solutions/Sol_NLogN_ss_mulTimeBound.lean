attribute [local irreducible] fmA

theorem mainCost_le (n : ℕ) :
    2 * mainCost n + 1 ≤ (8 * fmA + 10 ^ 7) * (n + 1) * (zsz ((n + 1 : ℕ) : ℤ) + 2) *
      (zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) := by
  obtain ⟨-, -, -, hL⟩ := mainN0_facts n
  set e := zsz ((n + 1 : ℕ) : ℤ) with he
  set l := zsz (((e + 2) ^ 4 : ℕ) : ℤ) with hl
  have hphi : fmPhi (mainN0 n) = fmA * mainN0 n * (e + 2) * l := by
    simp only [fmPhi, fmLam, hL]; rfl
  have he1 : 1 ≤ e := one_le_zsz (by omega)
  have hN : mainN0 n ≤ 4 * (n + 1) := by
    have h := two_pow_zsz_pred_le (n + 1) (by omega)
    rw [← he] at h
    show 2 ^ (e + 1) ≤ 4 * (n + 1)
    have : 2 ^ (e + 1) = 4 * 2 ^ (e - 1) := by
      rw [show e + 1 = 2 + (e - 1) by omega, pow_add]; norm_num
    omega
  have hen : e ≤ n + 1 := zsz_natCast_le_self _
  have hze : zsz (e : ℤ) ≤ e := zsz_natCast_le_self _
  have hP : fmA * mainN0 n * (e + 2) * l ≤ 4 * fmA * ((n + 1) * (e + 2)) * (l + 1) := by
    have := Nat.mul_le_mul_left fmA hN
    calc fmA * mainN0 n * (e + 2) * l ≤ fmA * (4 * (n + 1)) * (e + 2) * (l + 1) := by gcongr; omega
      _ = _ := by ring
  have hR : 2 * (2 * readRCost n + mainACost n + shlCost n + outRCost (2 * n)) + 1 ≤
      10 ^ 7 * ((n + 1) * (e + 2)) := by
    simp only [mainACost, readRCost, readCost, zipCost, moveCost, shlCost, outRCost, padCost,
      outCost, ← he]
    have h1 : (e + 1) * (zsz (e : ℤ) + 2) ≤ 2 * ((n + 1) * (e + 2)) := by
      rw [← mul_assoc]
      exact Nat.mul_le_mul (by omega : e + 1 ≤ 2 * (n + 1)) (Nat.add_le_add_right hze 2)
    nlinarith
  have hX : (n + 1) * (e + 2) ≤ (n + 1) * (e + 2) * (l + 1) := Nat.le_mul_of_pos_right _ (by omega)
  simp only [mainCost, hphi]
  obtain ⟨Φ, hΦ⟩ : ∃ Φ, Φ = fmA * mainN0 n * (e + 2) * l := ⟨_, rfl⟩
  rw [← hΦ] at hP ⊢
  obtain ⟨A, hA⟩ : ∃ A, A = fmA := ⟨_, rfl⟩
  rw [← hA] at hP ⊢
  calc 2 * (2 * readRCost n + mainACost n + Φ + shlCost n + outRCost (2 * n)) + 1
      ≤ 10 ^ 7 * ((n + 1) * (e + 2)) + 2 * (4 * A * ((n + 1) * (e + 2)) * (l + 1)) := by omega
    _ ≤ 10 ^ 7 * ((n + 1) * (e + 2) * (l + 1)) + 2 * (4 * A * ((n + 1) * (e + 2)) * (l + 1)) := by
        gcongr
    _ = _ := by ring

theorem ss_multipliesAt (n : ℕ) : MultipliesAt ssMachine n (2 * mainCost n + 1) := by
  apply multipliesAt_of_iexec ssProg (by norm_num) n
  intro x y hx hy
  obtain ⟨s', c, hE, hout, hc⟩ := ss_exec x y (hx.trans hy.symm)
  refine ⟨s', c, hE, by rw [hout, hx], ?_⟩
  have : (c : ℝ) ≤ mainCost n := by rw [← hx]; exact_mod_cast hc
  push_cast; linarith

end NLogN

