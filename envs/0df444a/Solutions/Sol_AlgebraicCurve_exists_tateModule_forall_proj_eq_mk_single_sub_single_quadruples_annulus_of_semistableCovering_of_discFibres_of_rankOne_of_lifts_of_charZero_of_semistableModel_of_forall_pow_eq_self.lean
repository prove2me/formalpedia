theorem mem_of_pow_eq_one {L : Type} [Field L] (A : ValuationSubring L) {ζ : L} {N : ℕ} (hN : 0 < N)
    (hζ : ζ ^ N = 1) : ζ ∈ A := by
  rcases A.mem_or_inv_mem ζ with h | h
  · exact h
  · have hζ' : ζ ^ (N - 1) * ζ = 1 := by rw [← pow_succ, Nat.sub_add_cancel hN, hζ]
    have : ζ = (ζ⁻¹) ^ (N - 1) := by
      rw [inv_pow]; exact eq_inv_of_mul_eq_one_right hζ'
    rw [this]
    exact pow_mem h _

theorem mem_of_pow_mem {L : Type} [Field L] (A : ValuationSubring L) {y : L} {N : ℕ} (hN : 0 < N)
    (hy : y ^ N ∈ A) : y ∈ A := by
  rw [← A.valuation_le_one_iff] at hy ⊢
  rw [map_pow] at hy
  by_contra h
  exact absurd hy (not_le.mpr (one_lt_pow' (not_le.mp h) hN.ne'))

theorem xi_pow_eq_one {L : Type} [Field L] {ℓ : ℕ} (ξ : ℕ → L) (hξ0 : ξ 0 = 1)
    (hξ : ∀ k, ξ (k + 1) ^ ℓ = ξ k) (k : ℕ) : ξ k ^ ℓ ^ k = 1 := by
  induction k with
  | zero => simpa using hξ0
  | succ k ih => rw [pow_succ', pow_mul, hξ k, ih]

theorem xi_succ_pow {L : Type} [Field L] {ℓ : ℕ} (ξ : ℕ → L)
    (hξ : ∀ k, ξ (k + 1) ^ ℓ = ξ k) (j : ℕ) : ξ (j + 1) ^ ℓ ^ j = ξ 1 := by
  induction j with
  | zero => simp
  | succ j ih => rw [pow_succ', pow_mul, hξ (j + 1), ih]

theorem isUnit_one_add_of_mem_maximalIdeal {R : Type} [CommRing R] [IsLocalRing R] {t : R}
    (ht : t ∈ IsLocalRing.maximalIdeal R) : IsUnit (1 + t) := by
  have := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (-t)
    (by rwa [← IsLocalRing.mem_maximalIdeal, neg_mem_iff])
  simpa using this

theorem mk_eq_mk_iff {K F : Type} [Field K] [Field F] [Algebra K F]
    (D E : Divisor.degZero (K := K) (F := F)) :
    Pic0.mk D = Pic0.mk E ↔ ((D : Divisor K F) - E) ∈ Divisor.principal (K := K) (F := F) := by
  unfold Pic0.mk
  rw [QuotientAddGroup.eq_iff_sub_mem, AddSubgroup.mem_addSubgroupOf]
  rfl

theorem mk_sub' {K F : Type} [Field K] [Field F] [Algebra K F]
    (D E : Divisor.degZero (K := K) (F := F)) : Pic0.mk (D - E) = Pic0.mk D - Pic0.mk E := rfl

theorem mk_zsmul' {K F : Type} [Field K] [Field F] [Algebra K F]
    (m : ℤ) (D : Divisor.degZero (K := K) (F := F)) : Pic0.mk (m • D) = m • Pic0.mk D := rfl

theorem mk_eq_zero_iff {K F : Type} [Field K] [Field F] [Algebra K F]
    (D : Divisor.degZero (K := K) (F := F)) :
    Pic0.mk D = 0 ↔ (D : Divisor K F) ∈ Divisor.principal (K := K) (F := F) := by
  unfold Pic0.mk
  rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf]

theorem mk_congr {K F : Type} [Field K] [Field F] [Algebra K F]
    {D E : Divisor K F} (hD : D ∈ Divisor.degZero (K := K) (F := F)) (hE : E ∈ Divisor.degZero (K := K) (F := F))
    (h : D = E) : Pic0.mk ⟨D, hD⟩ = Pic0.mk ⟨E, hE⟩ := by
  cases h; rfl

theorem degree_eq_sum {K F : Type} [Field K] [Field F] [Algebra K F] [IsAlgClosed K] [IsCurveOver K F]
    (D : Divisor K F) : Divisor.degree D = D.sum (fun _ n => n) := by
  unfold Divisor.degree
  rw [Finsupp.liftAddHom_apply]
  apply Finsupp.sum_congr
  intro v _
  simp [IsCurveOver.deg_eq_one_of_isAlgClosed v]

theorem degree_eq_zero_of_mapDomain_eq_zero {K F : Type} [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    [IsCurveOver K F] {β : Type} (f : Place K F → β) (D : Divisor K F) (h : Finsupp.mapDomain f D = 0) :
    Divisor.degree D = 0 := by
  rw [degree_eq_sum]
  have := congrArg (fun E : β →₀ ℤ => E.sum (fun _ n => n)) h
  simp only [Finsupp.sum_zero_index] at this
  rw [Finsupp.sum_mapDomain_index (fun _ => rfl) (fun _ _ _ => rfl)] at this
  exact this

theorem degree_single_eq_one {K F : Type} [Field K] [Field F] [Algebra K F] [IsAlgClosed K] [IsCurveOver K F]
    (P : Place K F) : Divisor.degree (Finsupp.single P 1) = 1 := by
  rw [Divisor.degree_single, IsCurveOver.deg_eq_one_of_isAlgClosed P]; simp

theorem mem_dom_of_mem_support_smul {K F : Type} [Field K] [Field F] [Algebra K F]
    (g : SemilinearAut K F) (S : Set (Place K F)) (hS : ∀ P ∈ S, g • P ∈ S)
    (D : Divisor K F) (hD : ∀ P ∈ D.support, P ∈ S) : ∀ P ∈ (g • D).support, P ∈ S := by
  intro P hP
  rw [Finsupp.mem_support_iff, SemilinearAut.divisor_smul_apply] at hP
  have h := hS _ (hD _ (Finsupp.mem_support_iff.mpr hP))
  rwa [smul_inv_smul] at h

theorem mapDomain_smul_eq {K F : Type} [Field K] [Field F] [Algebra K F] {β : Type}
    (g : SemilinearAut K F) (S : Set (Place K F)) (f : Place K F → β)
    (hf : ∀ P ∈ S, f (g • P) = f P) (D : Divisor K F) (hD : ∀ P ∈ D.support, P ∈ S) :
    Finsupp.mapDomain f (g • D) = Finsupp.mapDomain f D := by
  rw [SemilinearAut.divisor_smul_def, ← Finsupp.mapDomain_comp]
  unfold Finsupp.mapDomain
  apply Finsupp.sum_congr
  intro P hP
  simp only [Function.comp_apply, hf P (hD P hP)]

theorem smul_zsmul_divisor {K F : Type} [Field K] [Field F] [Algebra K F]
    (g : SemilinearAut K F) (z : ℤ) (D : Divisor K F) : g • (z • D) = z • (g • D) :=
  map_zsmul (DistribSMul.toAddMonoidHom (Divisor K F) g) z D

theorem smul_sum_divisor {K F : Type} [Field K] [Field F] [Algebra K F] {ι : Type} (s : Finset ι)
    (g : SemilinearAut K F) (D : ι → Divisor K F) : g • (∑ i ∈ s, D i) = ∑ i ∈ s, g • D i :=
  map_sum (DistribSMul.toAddMonoidHom (Divisor K F) g) D s

theorem smul_sub_divisor {K F : Type} [Field K] [Field F] [Algebra K F]
    (g : SemilinearAut K F) (D E : Divisor K F) : g • (D - E) = g • D - g • E :=
  map_sub (DistribSMul.toAddMonoidHom (Divisor K F) g) D E

theorem not_mem_chart_of_mem_annulus {ιP ιC ιA : Type} {domC : ιC → Set ιP} {domA : ιA → Set ιP}
    (hcover : ∀ P : ιP, (∃ i, P ∈ domC i ∧ (∀ j, P ∈ domC j → j = i) ∧ ∀ e, P ∉ domA e) ∨
      (∃ e, P ∈ domA e ∧ (∀ e', P ∈ domA e' → e' = e) ∧ ∀ i, P ∉ domC i))
    {P : ιP} {e : ιA} (hP : P ∈ domA e) : ∀ i, P ∉ domC i := by
  rcases hcover P with ⟨i, -, -, h⟩ | ⟨e', -, -, h⟩
  · exact absurd hP (h e)
  · exact h

theorem chart_eq_of_mem {ιP ιC ιA : Type} {domC : ιC → Set ιP} {domA : ιA → Set ιP}
    (hcover : ∀ P : ιP, (∃ i, P ∈ domC i ∧ (∀ j, P ∈ domC j → j = i) ∧ ∀ e, P ∉ domA e) ∨
      (∃ e, P ∈ domA e ∧ (∀ e', P ∈ domA e' → e' = e) ∧ ∀ i, P ∉ domC i))
    {P : ιP} {i j : ιC} (hP : P ∈ domC i) (hP' : P ∈ domC j) : j = i := by
  rcases hcover P with ⟨i₀, -, h, -⟩ | ⟨e, -, -, h⟩
  · rw [h i hP, h j hP']
  · exact absurd hP (h i)

theorem telescope {K F : Type} [Field K] [Field F] [Algebra K F] (R : ℕ → Place K F) (N : ℕ) :
    (N : ℤ) • (Finsupp.single (R 0) 1 - Finsupp.single (R 1) 1 : Divisor K F) =
      ∑ j ∈ Finset.range N, (Finsupp.single (R 0) 1 + Finsupp.single (R (j + 1)) 1 - Finsupp.single (R 1) 1 -
        Finsupp.single (R j) 1 : Divisor K F) + (Finsupp.single (R 0) 1 - Finsupp.single (R N) 1) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ, Nat.cast_succ, add_smul, one_smul, ih]
    abel

end KS2

namespace KS2

open scoped Classical

section Currency

variable {L : Type} [Field L] (A : ValuationSubring L) (π : A)
  {F : Type} [Field F] [Algebra L F] {n m : ℕ}
  {Fbar : Fin n → Type} [∀ i, Field (Fbar i)] [∀ i, Algebra (IsLocalRing.ResidueField A) (Fbar i)]
  (C : ∀ i, ComponentChart A F (Fbar i)) (An : Fin m → Annulus A F)

def RatDepth (e : Fin m) (P : Place L F) : Prop :=
  ∃ (N d : ℕ) (u : Aˣ), 0 < N ∧ (P.evalAt (An e).param) ^ N = ((u : A) : L) * (π : L) ^ d

def quad (Qq : Fin 4 → Place L F) : Divisor L F :=
  Finsupp.single (Qq 0) 1 + Finsupp.single (Qq 1) 1 - Finsupp.single (Qq 2) 1 - Finsupp.single (Qq 3) 1

def IsCur (X : Divisor L F) : Prop :=
  ∃ (Di : Fin n → Divisor L F) (r : ℕ) (eq : Fin r → Fin m) (nq : Fin r → ℤ) (Qq : Fin r → Fin 4 → Place L F),
    (∀ i, ∀ P ∈ (Di i).support, P ∈ (C i).dom) ∧
    (∀ i, Finsupp.mapDomain (C i).placeMap (Di i) = 0) ∧
    (∀ j l, Qq j l ∈ (An (eq j)).dom) ∧
    (∀ j, RatDepth A π An (eq j) (Qq j 0) ∧ RatDepth A π An (eq j) (Qq j 1)) ∧
    (∀ j, ∃ u : Aˣ,
      (Qq j 0).evalAt (An (eq j)).param = ((u : A) : L) * (Qq j 2).evalAt (An (eq j)).param) ∧
    (∀ j, ∃ t ∈ IsLocalRing.maximalIdeal A,
      (Qq j 0).evalAt (An (eq j)).param * (Qq j 1).evalAt (An (eq j)).param =
        (Qq j 2).evalAt (An (eq j)).param * (Qq j 3).evalAt (An (eq j)).param * (1 + ((t : A) : L))) ∧
    X = ∑ i, Di i + ∑ j, nq j • quad (Qq j)

variable {A π C An}

theorem isCur_zero : IsCur A π C An (0 : Divisor L F) := by
  refine ⟨fun _ => 0, 0, Fin.elim0, Fin.elim0, Fin.elim0, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i P hP; simp at hP
  · intro i; simp
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · simp

theorem isCur_add {X Y : Divisor L F} (hX : IsCur A π C An X) (hY : IsCur A π C An Y) :
    IsCur A π C An (X + Y) := by
  obtain ⟨Di, r, eq, nq, Qq, h1, h2, h3, h4, h5, h6, hX⟩ := hX
  obtain ⟨Di', r', eq', nq', Qq', h1', h2', h3', h4', h5', h6', hY⟩ := hY
  refine ⟨Di + Di', r + r', Fin.append eq eq', Fin.append nq nq', Fin.append Qq Qq', ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i P hP
    rcases Finset.mem_union.mp (Finsupp.support_add hP) with h | h
    · exact h1 i P h
    · exact h1' i P h
  · intro i; rw [Pi.add_apply, Finsupp.mapDomain_add, h2 i, h2' i, add_zero]
  · intro j
    refine Fin.addCases (fun j l => ?_) (fun j l => ?_) j
    · simp only [Fin.append_left]; exact h3 j l
    · simp only [Fin.append_right]; exact h3' j l
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simp only [Fin.append_left]; exact h4 j
    · simp only [Fin.append_right]; exact h4' j
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simp only [Fin.append_left]; exact h5 j
    · simp only [Fin.append_right]; exact h5' j
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simp only [Fin.append_left]; exact h6 j
    · simp only [Fin.append_right]; exact h6' j
  · rw [hX, hY, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Finset.sum_add_distrib, Pi.add_apply]
    abel

theorem isCur_zsmul (z : ℤ) {X : Divisor L F} (hX : IsCur A π C An X) : IsCur A π C An (z • X) := by
  obtain ⟨Di, r, eq, nq, Qq, h1, h2, h3, h4, h5, h6, hX⟩ := hX
  refine ⟨fun i => z • Di i, r, eq, fun j => z * nq j, Qq, ?_, ?_, h3, h4, h5, h6, ?_⟩
  · intro i P hP; exact h1 i P (Finsupp.support_smul hP)
  · intro i; rw [Finsupp.mapDomain_smul, h2 i, smul_zero]
  · rw [hX, smul_add, Finset.smul_sum, Finset.smul_sum]
    simp only [smul_smul]

theorem isCur_neg {X : Divisor L F} (hX : IsCur A π C An X) : IsCur A π C An (-X) := by
  have := isCur_zsmul (-1) hX
  rwa [neg_one_zsmul] at this

theorem isCur_sub {X Y : Divisor L F} (hX : IsCur A π C An X) (hY : IsCur A π C An Y) :
    IsCur A π C An (X - Y) := by
  rw [sub_eq_add_neg]; exact isCur_add hX (isCur_neg hY)

theorem isCur_sum {ι : Type} (s : Finset ι) (f : ι → Divisor L F) (h : ∀ i ∈ s, IsCur A π C An (f i)) :
    IsCur A π C An (∑ i ∈ s, f i) :=
  Finset.sum_induction f (IsCur A π C An) (fun _ _ ha hb => isCur_add ha hb) isCur_zero h

theorem isCur_quad (e : Fin m) (Qq : Fin 4 → Place L F)
    (hdom : ∀ l, Qq l ∈ (An e).dom)
    (hd0 : RatDepth A π An e (Qq 0)) (hd1 : RatDepth A π An e (Qq 1))
    (hrad : ∃ u : Aˣ, (Qq 0).evalAt (An e).param = ((u : A) : L) * (Qq 2).evalAt (An e).param)
    (hbal : ∃ t ∈ IsLocalRing.maximalIdeal A,
      (Qq 0).evalAt (An e).param * (Qq 1).evalAt (An e).param =
        (Qq 2).evalAt (An e).param * (Qq 3).evalAt (An e).param * (1 + ((t : A) : L))) :
    IsCur A π C An (quad Qq) := by
  refine ⟨fun _ => 0, 1, fun _ => e, fun _ => 1, fun _ => Qq, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i P hP; simp at hP
  · intro i; simp
  · intro _ l; exact hdom l
  · intro _; exact ⟨hd0, hd1⟩
  · intro _; exact hrad
  · intro _; exact hbal
  · simp

theorem isCur_chart (Di : Fin n → Divisor L F)
    (h1 : ∀ i, ∀ P ∈ (Di i).support, P ∈ (C i).dom) (h2 : ∀ i, Finsupp.mapDomain (C i).placeMap (Di i) = 0) :
    IsCur A π C An (∑ i, Di i) := by
  refine ⟨Di, 0, Fin.elim0, Fin.elim0, Fin.elim0, h1, h2, ?_, ?_, ?_, ?_, ?_⟩
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · intro j; exact Fin.elim0 j
  · simp

theorem degree_quad [IsAlgClosed L] [IsCurveOver L F] (Qq : Fin 4 → Place L F) :
    Divisor.degree (quad Qq) = 0 := by
  unfold quad
  rw [map_sub, map_sub, map_add, degree_single_eq_one, degree_single_eq_one, degree_single_eq_one,
    degree_single_eq_one]; ring

theorem IsCur.degree_eq_zero [IsAlgClosed L] [IsCurveOver L F] {X : Divisor L F} (hX : IsCur A π C An X) :
    Divisor.degree X = 0 := by
  obtain ⟨Di, r, eq, nq, Qq, -, h2, -, -, -, -, hX⟩ := hX
  rw [hX, map_add, map_sum, map_sum, Finset.sum_eq_zero (fun i _ => degree_eq_zero_of_mapDomain_eq_zero _ _ (h2 i)),
    Finset.sum_eq_zero (fun j _ => by rw [map_zsmul, degree_quad, smul_zero]), add_zero]

end Currency

section AnnulusPlaces

variable {L : Type} [Field L] {A : ValuationSubring L} {π : A}
  {F : Type} [Field F] [Algebra L F] {m : ℕ} {An : Fin m → Annulus A F}

theorem place_eq_of_evalAt_eq (X : Annulus A F) {R R' : Place L F} (hR : R ∈ X.dom) (hR' : R' ∈ X.dom)
    (hval : R.evalAt X.param = R'.evalAt X.param) : R = R' := by
  obtain ⟨-, -, ⟨hA', hm'⟩, hne, hcof⟩ := X.mem_dom R hR
  exact (X.existsUnique_evalAt_eq ⟨_, hA'⟩ hm' hne hcof).unique ⟨hR, rfl⟩ ⟨hR', hval.symm⟩

theorem exists_place_unit_mul (X : Annulus A F) {Q : Place L F} (hQ : Q ∈ X.dom) (u : Aˣ) :
    ∃ R : Place L F, R ∈ X.dom ∧ R.evalAt X.param = ((u : A) : L) * Q.evalAt X.param := by
  obtain ⟨-, -, ⟨hA', hm'⟩, hne, ⟨m', hm'm, hmod⟩⟩ := X.mem_dom Q hQ
  have hvu : (((u : A) : L)) * (((u⁻¹ : Aˣ) : A) : L) = 1 := by
    rw [← Subring.coe_mul, ← Units.val_mul, mul_inv_cancel]; rfl
  have hu0 : ((u : A) : L) ≠ 0 := fun h => by rw [h, zero_mul] at hvu; exact zero_ne_one hvu
  obtain ⟨R, ⟨hR, hRv⟩, -⟩ := X.existsUnique_evalAt_eq ((u : A) * ⟨_, hA'⟩) (Ideal.mul_mem_left _ _ hm')
    (by push_cast; exact mul_ne_zero hu0 hne)
    ⟨((u⁻¹ : Aˣ) : A) * m', Ideal.mul_mem_left _ _ hm'm, by
      rw [hmod]; push_cast; linear_combination (-(Q.evalAt X.param * (m' : L))) * hvu⟩
  exact ⟨R, hR, by rw [hRv]; push_cast; ring⟩

theorem ratDepth_of_evalAt_eq_unit_mul {e : Fin m} {Q R : Place L F} (hQ : RatDepth A π An e Q) (u : Aˣ)
    (hR : R.evalAt (An e).param = ((u : A) : L) * Q.evalAt (An e).param) : RatDepth A π An e R := by
  obtain ⟨N, d, v, hN, hv⟩ := hQ
  refine ⟨N, d, u ^ N * v, hN, ?_⟩
  rw [hR, mul_pow, hv]; push_cast; ring

end AnnulusPlaces

end KS2

namespace KS2

theorem vec4_0 {α : Type} (a b c d : α) : (![a, b, c, d] : Fin 4 → α) 0 = a := rfl
theorem vec4_1 {α : Type} (a b c d : α) : (![a, b, c, d] : Fin 4 → α) 1 = b := rfl
theorem vec4_2 {α : Type} (a b c d : α) : (![a, b, c, d] : Fin 4 → α) 2 = c := rfl
theorem vec4_3 {α : Type} (a b c d : α) : (![a, b, c, d] : Fin 4 → α) 3 = d := rfl

end KS2

namespace KS2

open scoped Classical

section Moves

variable {L : Type} [Field L] {A : ValuationSubring L} {π : A}
  {F : Type} [Field F] [Algebra L F] {n m : ℕ}
  {Fbar : Fin n → Type} [∀ i, Field (Fbar i)] [∀ i, Algebra (IsLocalRing.ResidueField A) (Fbar i)]
  {C : ∀ i, ComponentChart A F (Fbar i)} {An : Fin m → Annulus A F}

theorem rot (e : Fin m) (ζ : Aˣ) {P : Place L F} (hP : P ∈ (An e).dom) (hPd : RatDepth A π An e P) (N : ℕ) :
    ∃ W : Divisor L F, IsCur A π C An W ∧ ∀ (P₁ PN : Place L F), P₁ ∈ (An e).dom → PN ∈ (An e).dom →
      P₁.evalAt (An e).param = ((ζ : A) : L) * P.evalAt (An e).param →
      PN.evalAt (An e).param = (((ζ ^ N : Aˣ) : A) : L) * P.evalAt (An e).param →
      (N : ℤ) • (Finsupp.single P 1 - Finsupp.single P₁ 1 : Divisor L F) = W + (Finsupp.single P 1 - Finsupp.single PN 1) := by
  have hR_ex : ∀ j : ℕ, ∃ R : Place L F, R ∈ (An e).dom ∧
      R.evalAt (An e).param = (((ζ ^ j : Aˣ) : A) : L) * P.evalAt (An e).param := fun j =>
    exists_place_unit_mul (An e) hP (ζ ^ j)
  choose R hRdom hRval using hR_ex
  have hR0 : R 0 = P := place_eq_of_evalAt_eq (An e) (hRdom 0) hP (by rw [hRval, pow_zero]; push_cast; ring)
  have hζu : (((ζ : A) : L)) * (((ζ⁻¹ : Aˣ) : A) : L) = 1 := by
    rw [← Subring.coe_mul, ← Units.val_mul, mul_inv_cancel]; rfl
  refine ⟨∑ j ∈ Finset.range N, quad ![R 0, R (j + 1), R 1, R j], ?_, ?_⟩
  · refine isCur_sum _ _ (fun j _ => isCur_quad e _ ?_ ?_ ?_ ?_ ?_)
    · intro l; fin_cases l <;> simp [vec4_2, vec4_3, hRdom]
    · simpa using ratDepth_of_evalAt_eq_unit_mul hPd (ζ ^ 0) (hRval 0)
    · simpa using ratDepth_of_evalAt_eq_unit_mul hPd (ζ ^ (j + 1)) (hRval (j + 1))
    · refine ⟨ζ⁻¹, ?_⟩
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hRval 0, hRval 1]; push_cast
      linear_combination (-(P.evalAt (An e).param)) * hζu
    · refine ⟨0, Ideal.zero_mem _, ?_⟩
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hRval 0, hRval 1, hRval (j + 1), hRval j]; push_cast; ring
  · intro P₁ PN hP₁ hPN hP₁v hPNv
    have h1 : R 1 = P₁ := place_eq_of_evalAt_eq (An e) (hRdom 1) hP₁ (by rw [hRval, hP₁v, pow_one])
    have hN : R N = PN := place_eq_of_evalAt_eq (An e) (hRdom N) hPN (by rw [hRval, hPNv])
    have := telescope (K := L) R N
    rw [hR0, h1, hN] at this
    rw [this]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    simp [quad, hR0, h1]

theorem two_base (e : Fin m) (ζ : Aˣ) {Q Q' R R' : Place L F}
    (hQ : Q ∈ (An e).dom) (hQ' : Q' ∈ (An e).dom) (hR : R ∈ (An e).dom) (hR' : R' ∈ (An e).dom)
    (hQd : RatDepth A π An e Q) (hR'd : RatDepth A π An e R')
    (hQ'v : Q'.evalAt (An e).param = ((ζ : A) : L) * Q.evalAt (An e).param)
    (hR'v : R'.evalAt (An e).param = ((ζ : A) : L) * R.evalAt (An e).param) :
    IsCur A π C An ((Finsupp.single Q 1 - Finsupp.single Q' 1) - (Finsupp.single R 1 - Finsupp.single R' 1)) := by
  have hζu : (((ζ : A) : L)) * (((ζ⁻¹ : Aˣ) : A) : L) = 1 := by
    rw [← Subring.coe_mul, ← Units.val_mul, mul_inv_cancel]; rfl
  have h := isCur_quad (A := A) (π := π) (C := C) (An := An) e ![Q, R', Q', R]
    (by intro l; fin_cases l <;> simp [vec4_2, vec4_3, hQ, hQ', hR, hR'])
    (by simpa using hQd) (by simpa using hR'd)
    ⟨ζ⁻¹, by
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hQ'v]; linear_combination (-(Q.evalAt (An e).param)) * hζu⟩
    ⟨0, Ideal.zero_mem _, by
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hQ'v, hR'v]; push_cast; ring⟩
  have e1 : quad ![Q, R', Q', R] =
      ((Finsupp.single Q 1 - Finsupp.single Q' 1) - (Finsupp.single R 1 - Finsupp.single R' 1) : Divisor L F) := by
    simp [quad]; abel
  rwa [e1] at h

theorem degen (e : Fin m) {P Q Q' : Place L F}
    (hP : P ∈ (An e).dom) (hQ : Q ∈ (An e).dom) (hQ' : Q' ∈ (An e).dom)
    (hPd : RatDepth A π An e P) (hQd : RatDepth A π An e Q)
    (t : A) (ht : t ∈ IsLocalRing.maximalIdeal A)
    (hPv : P.evalAt (An e).param = Q'.evalAt (An e).param * (1 + ((t : A) : L))) :
    IsCur A π C An (Finsupp.single P 1 - Finsupp.single Q' 1) := by
  have hu : IsUnit (1 + t) := isUnit_one_add_of_mem_maximalIdeal ht
  have h := isCur_quad (A := A) (π := π) (C := C) (An := An) e ![P, Q, Q', Q]
    (by intro l; fin_cases l <;> simp [vec4_2, vec4_3, hP, hQ, hQ'])
    (by simpa using hPd) (by simpa using hQd)
    ⟨hu.unit, by
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hPv, IsUnit.unit_spec]; push_cast; ring⟩
    ⟨t, ht, by
      simp only [vec4_0, vec4_1, vec4_2, vec4_3]
      rw [hPv]; ring⟩
  have e1 : quad ![P, Q, Q', Q] = (Finsupp.single P 1 - Finsupp.single Q' 1 : Divisor L F) := by
    simp [quad]; abel
  rwa [e1] at h

theorem chart_motion (s : SemilinearAut L F)
    (hsC : ∀ i, ∀ P ∈ (C i).dom, s • P ∈ (C i).dom)
    (hsmap : ∀ i, ∀ P ∈ (C i).dom, (C i).placeMap (s • P) = (C i).placeMap P)
    (hcover : ∀ P : Place L F,
      (∃ i, P ∈ (C i).dom ∧ (∀ j, P ∈ (C j).dom → j = i) ∧ ∀ e, P ∉ (An e).dom) ∨
      (∃ e, P ∈ (An e).dom ∧ (∀ e', P ∈ (An e').dom → e' = e) ∧ ∀ i, P ∉ (C i).dom))
    (Dch : Divisor L F) (hDch : ∀ P ∈ Dch.support, ∃ i, P ∈ (C i).dom) :
    IsCur A π C An (Dch - s • Dch) := by
  classical
  set Dc : Fin n → Divisor L F := fun i => Dch.filter (fun P => P ∈ (C i).dom) with hDc
  have hDc_dom : ∀ i, ∀ P ∈ (Dc i).support, P ∈ (C i).dom := by
    intro i P hP
    simp only [hDc, Finsupp.support_filter, Finset.mem_filter] at hP
    exact hP.2
  have hsum : ∑ i, Dc i = Dch := by
    ext P
    rw [Finsupp.finsetSum_apply]
    simp only [hDc, Finsupp.filter_apply]
    by_cases hP : P ∈ Dch.support
    · obtain ⟨i₀, hi₀⟩ := hDch P hP
      have hiff : ∀ j, (P ∈ (C j).dom) ↔ j = i₀ := fun j =>
        ⟨fun hj => chart_eq_of_mem hcover hi₀ hj, fun hj => hj ▸ hi₀⟩
      simp_rw [hiff]
      rw [Finset.sum_ite_eq']; simp
    · have : Dch P = 0 := Finsupp.notMem_support_iff.mp hP
      simp [this]
  have hsum' : ∑ i, (Dc i - s • Dc i) = Dch - s • Dch := by
    rw [Finset.sum_sub_distrib, ← smul_sum_divisor, hsum]
  rw [← hsum']
  refine isCur_chart _ (fun i P hP => ?_) (fun i => ?_)
  · rcases Finset.mem_union.mp (Finsupp.support_sub hP) with h | h
    · exact hDc_dom i P h
    · exact mem_dom_of_mem_support_smul s _ (hsC i) _ (hDc_dom i) P h
  · change Finsupp.mapDomain.addMonoidHom (C i).placeMap (Dc i - s • Dc i) = 0
    rw [map_sub]
    change Finsupp.mapDomain (C i).placeMap (Dc i) - Finsupp.mapDomain (C i).placeMap (s • Dc i) = 0
    rw [mapDomain_smul_eq s _ _ (hsmap i) _ (hDc_dom i), sub_self]

end Moves

end KS2

namespace KS2

theorem ks44_mem_of_pow_mem {L : Type} [Field L] (A : ValuationSubring L) {y : L} {N : ℕ} (hN : 0 < N)
    (hy : y ^ N ∈ A) : y ∈ A := by
  rw [← A.valuation_le_one_iff] at hy ⊢
  rw [map_pow] at hy
  by_contra h
  exact absurd hy (not_le.mpr (one_lt_pow' (not_le.mp h) hN.ne'))

theorem ks44_apply_eq_self_of_pow_eq_one {L : Type} [Field L] [IsAlgClosed L] (A : ValuationSubring L)
    (σ : L ≃+* L) (hA : ∀ a : L, a ∈ A ↔ σ a ∈ A)
    (hres : ∀ (a : A) (h : σ (a : L) ∈ A), IsLocalRing.residue A ⟨σ (a : L), h⟩ = IsLocalRing.residue A a)
    (N : ℕ) (hN : 0 < N) (hNκ : ((N : ℕ) : IsLocalRing.ResidueField A) ≠ 0) (ζ : L) (hζ : ζ ^ N = 1) :
    σ ζ = ζ := by
  have hζA : ζ ∈ A := ks44_mem_of_pow_mem A hN (by rw [hζ]; exact one_mem A)
  have hσζA : σ ζ ∈ A := (hA ζ).1 hζA
  have h1 : (⟨ζ, hζA⟩ : A) ^ N = 1 := Subtype.ext (by push_cast; exact hζ)
  have h2 : (⟨σ ζ, hσζA⟩ : A) ^ N = 1 := Subtype.ext (by push_cast; rw [← map_pow, hζ, map_one])
  have key := (ValuationSubring.residue_injOn_pow_eq_one_and_exists_residue_eq_of_isAlgClosed L A N hNκ).1
    ⟨σ ζ, hσζA⟩ ⟨ζ, hζA⟩ h2 h1 (hres ⟨ζ, hζA⟩ hσζA)
  exact congrArg Subtype.val key

theorem exact_rot {L : Type} [Field L] (A : ValuationSubring L) (π : A) (hπ0 : π ≠ 0)
    (σ : L ≃+* L) (hA : ∀ a : L, a ∈ A ↔ σ a ∈ A)
    (hres : ∀ (a : A) (h : σ (a : L) ∈ A), IsLocalRing.residue A ⟨σ (a : L), h⟩ = IsLocalRing.residue A a)
    {N : ℕ} (hN : 0 < N) {ρ ζ : L} (hρ : ρ ^ N = (π : L)) (hσρ : σ ρ = ζ * ρ)
    {c : L} (v : Aˣ) (hc : c ^ N = ((v : A) : L) * (π : L)) :
    ∃ t ∈ IsLocalRing.maximalIdeal A, σ c = ζ * c * (1 + ((t : A) : L)) := by
  have hπL : (π : L) ≠ 0 := fun h => hπ0 (Subtype.ext h)
  have hρ0 : ρ ≠ 0 := by rintro rfl; rw [zero_pow hN.ne'] at hρ; exact hπL hρ.symm

  set w : L := c * ρ⁻¹ with hw
  have hwN : w ^ N = ((v : A) : L) := by
    rw [hw, mul_pow, inv_pow, hc, hρ]; field_simp
  have hvinv : (((v : A) : L))⁻¹ = (((v⁻¹ : Aˣ) : A) : L) := by
    symm; apply eq_inv_of_mul_eq_one_left
    rw [← Subring.coe_mul, ← Units.val_mul, inv_mul_cancel]; rfl
  have hwA : w ∈ A := ks44_mem_of_pow_mem A hN (by rw [hwN]; exact (v : A).2)
  have hw0 : w ≠ 0 := by
    intro h; rw [h, zero_pow hN.ne'] at hwN
    exact (Units.ne_zero v) (Subtype.ext (by simpa using hwN.symm))
  have hwiA : w⁻¹ ∈ A := ks44_mem_of_pow_mem A hN (by rw [inv_pow, hwN, hvinv]; exact ((v⁻¹ : Aˣ) : A).2)
  have hσwA : σ w ∈ A := (hA w).1 hwA

  refine ⟨⟨(σ w - w) * w⁻¹, mul_mem (sub_mem hσwA hwA) hwiA⟩, ?_, ?_⟩
  · rw [← IsLocalRing.residue_eq_zero_iff]
    have : (⟨(σ w - w) * w⁻¹, mul_mem (sub_mem hσwA hwA) hwiA⟩ : A) =
        (⟨σ w, hσwA⟩ - ⟨w, hwA⟩) * ⟨w⁻¹, hwiA⟩ := rfl
    rw [this, map_mul, map_sub, hres ⟨w, hwA⟩ hσwA, sub_self, zero_mul]
  · have hcw : c = w * ρ := by rw [hw]; field_simp
    push_cast
    rw [hcw, map_mul, hσρ]
    field_simp
    ring

theorem tame_one {L : Type} [Field L] [IsAlgClosed L] [CharZero L] (A : ValuationSubring L)
    (π : A) (hπ0 : π ≠ 0) {G : Type} (base : G → (L ≃+* L)) (S : Set G)
    (hS : ∀ s ∈ S, (∀ a : L, a ∈ A ↔ base s a ∈ A) ∧ base s (π : L) = (π : L) ∧
      (∀ (a : A) (h : base s (a : L) ∈ A), IsLocalRing.residue A ⟨base s (a : L), h⟩ = IsLocalRing.residue A a))
    (hSlift : ∀ σ : L ≃+* L, (∀ a : L, a ∈ A ↔ σ a ∈ A) → σ (π : L) = (π : L) →
      (∀ (a : A) (h : σ (a : L) ∈ A), IsLocalRing.residue A ⟨σ (a : L), h⟩ = IsLocalRing.residue A a) →
      ∃ s ∈ S, base s = σ)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : IsUnit ((ℓ : ℕ) : IsLocalRing.ResidueField A))
    (hSℓ : ∃ s ∈ S, ∃ r : L, r ^ ℓ = (π : L) ∧ base s r ≠ r)
    (ξ : ℕ → L) (hξ0 : ξ 0 = 1) (hξ : ∀ k, ξ (k + 1) ^ ℓ = ξ k) (hξ1 : ξ 1 ≠ 1)
    (k : ℕ) (hk : 0 < k) :
    ∃ s ∈ S, ∃ ρ : L, ρ ^ (ℓ ^ k) = (π : L) ∧ base s ρ = ξ k * ρ := by
  have hℓp : ℓ.Prime := Fact.out
  have hπL : (π : L) ≠ 0 := fun h => hπ0 (Subtype.ext h)
  obtain ⟨s₀, hs₀, r, hr, hσr⟩ := hSℓ
  obtain ⟨hA₀, hπ₀, hres₀⟩ := hS s₀ hs₀
  set σ₀ := base s₀ with hσ₀

  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
  obtain ⟨ρ, hρ⟩ := IsAlgClosed.exists_pow_nat_eq r (pow_pos hℓp.pos j)
  have hρπ : ρ ^ ℓ ^ (j + 1) = (π : L) := by rw [pow_succ, pow_mul, hρ, hr]
  have hρ0 : ρ ≠ 0 := by rintro rfl; rw [zero_pow (pow_pos hℓp.pos _).ne'] at hρπ; exact hπL hρπ.symm
  have hr0 : r ≠ 0 := by rintro rfl; rw [zero_pow hℓp.pos.ne'] at hr; exact hπL hr.symm

  set ζ₀ : L := σ₀ ρ * ρ⁻¹ with hζ₀
  have hσ₀ρ : σ₀ ρ = ζ₀ * ρ := by rw [hζ₀]; field_simp
  have hζ₀pow : ζ₀ ^ ℓ ^ (j + 1) = 1 := by
    rw [hζ₀, mul_pow, ← map_pow, hρπ, hπ₀, inv_pow, hρπ]; field_simp
  have hζ₀ne : ζ₀ ^ ℓ ^ j ≠ 1 := by
    intro h1
    apply hσr
    have : σ₀ r = ζ₀ ^ ℓ ^ j * r := by rw [← hρ, map_pow, hσ₀ρ, mul_pow]
    rw [this, h1, one_mul]
  have hord : orderOf ζ₀ = ℓ ^ (j + 1) := orderOf_eq_prime_pow hζ₀ne hζ₀pow
  have hprim : IsPrimitiveRoot ζ₀ (ℓ ^ (j + 1)) := hord ▸ IsPrimitiveRoot.orderOf ζ₀
  have hℓk : ((ℓ ^ (j + 1) : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    rw [Nat.cast_pow]; exact (hℓ.pow _).ne_zero
  have hσ₀ζ₀ : σ₀ ζ₀ = ζ₀ :=
    ks44_apply_eq_self_of_pow_eq_one A σ₀ hA₀ hres₀ (ℓ ^ (j + 1)) (pow_pos hℓp.pos _) hℓk ζ₀ hζ₀pow

  have hξpow : ξ (j + 1) ^ ℓ ^ (j + 1) = 1 := by
    have : ∀ i, ξ i ^ ℓ ^ i = 1 := by
      intro i; induction i with
      | zero => simpa using hξ0
      | succ i ih => rw [pow_succ', pow_mul, hξ i, ih]
    exact this (j + 1)
  haveI : NeZero (ℓ ^ (j + 1)) := ⟨(pow_pos hℓp.pos _).ne'⟩
  obtain ⟨a, -, ha⟩ := hprim.eq_pow_of_pow_eq_one hξpow

  let it : ℕ → (L ≃+* L) := fun i => Nat.rec (RingEquiv.refl L) (fun _ e => e.trans σ₀) i
  have hit_succ : ∀ i (x : L), it (i + 1) x = σ₀ (it i x) := fun i x => rfl
  have hit_zero : ∀ x : L, it 0 x = x := fun x => rfl
  have hitA : ∀ i (a : L), a ∈ A ↔ it i a ∈ A := by
    intro i; induction i with
    | zero => intro a; rw [hit_zero]
    | succ i ih => intro a; rw [hit_succ, ih a]; exact hA₀ _
  have hitπ : ∀ i, it i (π : L) = (π : L) := by
    intro i; induction i with
    | zero => rfl
    | succ i ih => rw [hit_succ, ih, hπ₀]
  have hitres : ∀ i (a : A) (h : it i (a : L) ∈ A), IsLocalRing.residue A ⟨it i (a : L), h⟩ = IsLocalRing.residue A a := by
    intro i; induction i with
    | zero => intro a h; rfl
    | succ i ih =>
      intro a h
      have h' : it i (a : L) ∈ A := (hitA i a).1 a.2
      have h'' : σ₀ (it i (a : L)) ∈ A := (hA₀ _).1 h'
      have : (⟨it (i + 1) (a : L), h⟩ : A) = ⟨σ₀ ((⟨it i (a : L), h'⟩ : A) : L), h''⟩ := rfl
      rw [this, hres₀ ⟨it i (a : L), h'⟩ h'', ih a h']
  have hitρ : ∀ i, it i ρ = ζ₀ ^ i * ρ := by
    intro i; induction i with
    | zero => rw [hit_zero, pow_zero, one_mul]
    | succ i ih => rw [hit_succ, ih, map_mul, map_pow, hσ₀ζ₀, hσ₀ρ, pow_succ]; ring
  obtain ⟨s, hs, hbs⟩ := hSlift (it a) (hitA a) (hitπ a) (hitres a)
  exact ⟨s, hs, ρ, hρπ, by rw [hbs, hitρ, ha]⟩

end KS2

namespace KS2

open scoped Classical

theorem mk_congr' {K F : Type} [Field K] [Field F] [Algebra K F]
    {D E : Divisor.degZero (K := K) (F := F)} (h : (D : Divisor K F) = E) : Pic0.mk D = Pic0.mk E :=
  congrArg _ (Subtype.ext h)

theorem torsion_mono {M : Type} [AddCommGroup M] (ℓ : ℕ) {K N : ℕ} (hKN : K ≤ N) {x : M}
    (hx : ((ℓ ^ K : ℕ) : ℤ) • x = 0) : ((ℓ ^ N : ℕ) : ℤ) • x = 0 := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hKN
  rw [pow_add, Nat.cast_mul, mul_comm, mul_smul, hx, smul_zero]

theorem level
    {L : Type} [Field L] [IsAlgClosed L] [CharZero L] (A : ValuationSubring L)
    (π : A) (hπ : π ∈ IsLocalRing.maximalIdeal A) (hπ0 : π ≠ 0)
    (hrk : ∀ x : L, x ≠ 0 → ∀ y : A, y ∈ IsLocalRing.maximalIdeal A →
      ∃ n : ℕ, A.valuation ((y : L) ^ n) ≤ A.valuation x)
    (F : Type) [Field F] [Algebra L F]
    (n m : ℕ) (Fbar : Fin n → Type) [∀ i, Field (Fbar i)]
    [∀ i, Algebra (IsLocalRing.ResidueField A) (Fbar i)]
    (hratBar : ∀ i, ∀ Q : Place (IsLocalRing.ResidueField A) (Fbar i), Q.IsRational)
    (C : ∀ i, ComponentChart A F (Fbar i))
    (hratF : ∀ i, ∀ P ∈ (C i).dom, P.IsRational)
    (An An' : Fin m → Annulus A F) (src tgt : Fin m → Fin n)
    (xs : ∀ e, Place (IsLocalRing.ResidueField A) (Fbar (src e)))
    (xt : ∀ e, Place (IsLocalRing.ResidueField A) (Fbar (tgt e)))
    (w : Fin m → ℕ)
    (hpair : ∀ e, (An' e).dom = (An e).dom ∧ (An' e).modulus = (An e).modulus ∧
      ((An e).modulus : L) ≠ 0 ∧
      (An' e).param * (An e).param = algebraMap L F ((An e).modulus : L))
    (hw : ∀ e, ∃ u : Aˣ, (An e).modulus = u * π ^ w e)
    (hatt : ∀ e, (An e).IsAttached (C (src e)) (xs e) ∧ (An' e).IsAttached (C (tgt e)) (xt e))
    (hnodes : (∀ i, ∀ x ∈ (C i).nodes, ∃ e,
        (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)) = ⟨i, x⟩ ∨
        (⟨tgt e, xt e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)) = ⟨i, x⟩) ∧
      (∀ i, ∀ x ∈ (C i).nodes, ∀ E E' : Fin m ⊕ Fin m,
        Sum.elim (fun e => (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)))
          (fun e => ⟨tgt e, xt e⟩) E = ⟨i, x⟩ →
        Sum.elim (fun e => (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)))
          (fun e => ⟨tgt e, xt e⟩) E' = ⟨i, x⟩ → E = E'))
    (hcover : ∀ P : Place L F,
      (∃ i, P ∈ (C i).dom ∧ (∀ j, P ∈ (C j).dom → j = i) ∧ ∀ e, P ∉ (An e).dom) ∨
      (∃ e, P ∈ (An e).dom ∧ (∀ e', P ∈ (An e').dom → e' = e) ∧ ∀ i, P ∉ (C i).dom))
    (hdisc : ∀ i, ∀ Q : Place (IsLocalRing.ResidueField A) (Fbar i), Q ∉ (C i).nodes →
      ∃ (T : F) (hT : T ∈ (C i).integers), (C i).residue ⟨T, hT⟩ ≠ 0 ∧ Q.ord ((C i).residue ⟨T, hT⟩) = 1 ∧
        (∀ P ∈ (C i).dom, (C i).placeMap P = Q → T ∈ P.toValuationSubring ∧
          ∃ h : P.evalAt T ∈ A, (⟨P.evalAt T, h⟩ : A) ∈ IsLocalRing.maximalIdeal A) ∧
        ∀ c : A, c ∈ IsLocalRing.maximalIdeal A →
          ∃! P : Place L F, P ∈ (C i).dom ∧ (C i).placeMap P = Q ∧ P.evalAt T = c)
    (hgenus : genusFF L F + n = (∑ i, genusFF (IsLocalRing.ResidueField A) (Fbar i)) + m + 1)
    [IsCurveOver L F] [Algebra.EssFiniteType L F]
    (S : Set (SemilinearAut L F))
    (hS : ∀ s ∈ S, (∀ a : L, a ∈ A ↔ SemilinearAut.baseAut s a ∈ A) ∧ SemilinearAut.baseAut s (π : L) = (π : L) ∧
      (∀ (a : A) (h : SemilinearAut.baseAut s (a : L) ∈ A),
        IsLocalRing.residue A ⟨SemilinearAut.baseAut s (a : L), h⟩ = IsLocalRing.residue A a) ∧
      (∀ i, ∀ P ∈ (C i).dom, s • P ∈ (C i).dom) ∧ (∀ e, ∀ P ∈ (An e).dom, s • P ∈ (An e).dom) ∧
      (∀ e, s • (An e).param = (An e).param) ∧ (∀ e, s • (An' e).param = (An' e).param) ∧
      (∀ i, ∀ f : F, ∀ hf : f ∈ (C i).integers, ∃ hf' : s • f ∈ (C i).integers,
        (C i).residue ⟨s • f, hf'⟩ = (C i).residue ⟨f, hf⟩) ∧
      (∀ i, ∀ P ∈ (C i).dom, (C i).placeMap (s • P) = (C i).placeMap P))
    (hSlift : ∀ σ : L ≃+* L, (∀ a : L, a ∈ A ↔ σ a ∈ A) → σ (π : L) = (π : L) →
      (∀ (a : A) (h : σ (a : L) ∈ A), IsLocalRing.residue A ⟨σ (a : L), h⟩ = IsLocalRing.residue A a) →
      ∃ s ∈ S, SemilinearAut.baseAut s = σ)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : IsUnit ((ℓ : ℕ) : IsLocalRing.ResidueField A))
    (hSℓ : ∃ s ∈ S, ∃ r : L, r ^ ℓ = (π : L) ∧ SemilinearAut.baseAut s r ≠ r)
    [FiniteDimensional ℚ_[ℓ] (ModularCurve.RationalTateModule ℓ (Pic0 L F))]
    [∀ i, IsCurveOver (IsLocalRing.ResidueField A) (Fbar i)]
    [∀ i, Algebra.EssFiniteType (IsLocalRing.ResidueField A) (Fbar i)]
    (M : AlgebraicCurve.SemistableModel A F Fbar C An src tgt xs xt) (D : M.Descent)
    (ξ : ℕ → L) (hξ0 : ξ 0 = 1) (hξ : ∀ k, ξ (k + 1) ^ ℓ = ξ k) (hξ1 : ξ 1 ≠ 1)
    (hκ : ∀ p : ℕ, p.Prime → CharP (IsLocalRing.ResidueField A) p →
      ∀ a : IsLocalRing.ResidueField A, ∃ n : ℕ, 0 < n ∧ a ^ (p ^ n) = a)
    (e₀ : Fin m) (k : ℕ) (hk : 0 < k) :
    ∃ (t : Pic0 L F) (K : ℕ) (R R' : Place L F) (W : Divisor L F),
      ((ℓ ^ K : ℕ) : ℤ) • t = 0 ∧ R ∈ (An e₀).dom ∧ R' ∈ (An e₀).dom ∧ RatDepth A π An e₀ R ∧ RatDepth A π An e₀ R' ∧
        R'.evalAt (An e₀).param = ξ k * R.evalAt (An e₀).param ∧ IsCur A π C An W ∧
        (Finsupp.single R 1 - Finsupp.single R' 1 + W : Divisor L F) ∈ Divisor.degZero (K := L) (F := F) ∧
        ∀ hdeg : (Finsupp.single R 1 - Finsupp.single R' 1 + W : Divisor L F) ∈ Divisor.degZero (K := L) (F := F),
          t = Pic0.mk ⟨Finsupp.single R 1 - Finsupp.single R' 1 + W, hdeg⟩ := by
  classical
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  have hξk : ∀ k, ξ k ^ ℓ ^ k = 1 := xi_pow_eq_one ξ hξ0 hξ
  have hξA : ∀ k, ξ k ∈ A := fun k => mem_of_pow_eq_one A (pow_pos hℓpos k) (hξk k)
  have hξunit : IsUnit (⟨ξ k, hξA k⟩ : A) :=
    IsUnit.of_pow_eq_one (n := ℓ ^ k) (Subtype.ext (by push_cast; exact hξk k)) (pow_pos hℓpos k).ne'
  set ξu : Aˣ := hξunit.unit with hξu_def
  have hξuL : ((ξu : A) : L) = ξ k := congrArg Subtype.val hξunit.unit_spec
  have hξupow : (((ξu ^ (ℓ ^ k) : Aˣ) : A) : L) = 1 := by push_cast; rw [hξuL, hξk]

  obtain ⟨s₁, hs₁S, ρ, hρ, hσρ⟩ := tame_one A π hπ0 (fun s : ↥(SemilinearAut L F) => SemilinearAut.baseAut s) S
    (fun s hs => ⟨(hS s hs).1, (hS s hs).2.1, (hS s hs).2.2.1⟩) hSlift ℓ hℓ hSℓ ξ hξ0 hξ hξ1 k hk
  obtain ⟨hA1, hπ1, hres1, hC1, hAn1, hpar1, -, -, hmap1⟩ := hS s₁ hs₁S

  obtain ⟨D₀, hD₀, ⟨K, hK⟩, Dch, Qe, nn, hDch, hQe, hnn, hD₀eq⟩ :=
    AlgebraicCurve.exists_zsmul_mk_eq_zero_eq_add_sum_single_pow_evalAt_param_eq_mul_of_semistableCovering_of_discFibres_of_rankOne_of_isUnit_of_charZero_of_semistableModel
      A π hπ hπ0 hrk F n m Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes hcover hdisc hgenus ℓ hℓ k M D hk hκ
      (fun e => if e = e₀ then 1 else 0)
  have hQedom : ∀ e, Qe e ∈ (An e).dom := fun e => (hQe e).1
  have hv_ex : ∀ e, ∃ v : Aˣ, ((Qe e).evalAt (An e).param) ^ (ℓ ^ k) = ((v : A) : L) * (π : L) := fun e => (hQe e).2
  choose v hv using hv_ex
  have hQed : ∀ e, RatDepth A π An e (Qe e) := fun e => ⟨ℓ ^ k, 1, v e, pow_pos hℓpos k, by rw [hv, pow_one]⟩

  have hrotE : ∀ e, ∃ t ∈ IsLocalRing.maximalIdeal A, SemilinearAut.baseAut s₁ ((Qe e).evalAt (An e).param) =
      ξ k * (Qe e).evalAt (An e).param * (1 + ((t : A) : L)) :=
    fun e => exact_rot A π hπ0 (SemilinearAut.baseAut s₁) hA1 hres1 (pow_pos hℓpos k) hρ hσρ (v e) (hv e)
  choose te hte hσc using hrotE

  have hsQdom : ∀ e, s₁ • Qe e ∈ (An e).dom := fun e => hAn1 e _ (hQedom e)
  have hsQv : ∀ e, (s₁ • Qe e).evalAt (An e).param = SemilinearAut.baseAut s₁ ((Qe e).evalAt (An e).param) := by
    intro e
    have hrat : (Qe e).IsRational := ((An e).mem_dom _ (hQedom e)).1
    have hrat' : (s₁ • Qe e).IsRational := ((An e).mem_dom _ (hsQdom e)).1
    have := AlgebraicCurve.Place.evalAt_smul_smul_eq_baseAut_evalAt s₁ (Qe e) hrat hrat' (An e).param
    rwa [hpar1 e] at this

  have hQ'ex : ∀ e, ∃ R : Place L F, R ∈ (An e).dom ∧
      R.evalAt (An e).param = ((ξu : A) : L) * (Qe e).evalAt (An e).param :=
    fun e => exists_place_unit_mul (An e) (hQedom e) ξu
  choose Qe' hQe'dom hQe'v using hQ'ex
  have hQe'd : ∀ e, RatDepth A π An e (Qe' e) := fun e => ratDepth_of_evalAt_eq_unit_mul (hQed e) ξu (hQe'v e)
  have hsQd : ∀ e, RatDepth A π An e (s₁ • Qe e) := by
    intro e
    have hu : IsUnit (1 + te e) := isUnit_one_add_of_mem_maximalIdeal (hte e)
    refine ⟨ℓ ^ k, 1, v e * hu.unit ^ (ℓ ^ k), pow_pos hℓpos k, ?_⟩
    rw [hsQv, hσc, mul_pow, mul_pow, hξk, one_mul, hv, pow_one]
    push_cast
    rw [IsUnit.unit_spec]
    push_cast
    ring

  have hdg : ∀ e, IsCur A π C An (Finsupp.single (s₁ • Qe e) 1 - Finsupp.single (Qe' e) 1) := fun e =>
    degen e (hsQdom e) (hQedom e) (hQe'dom e) (hsQd e) (hQed e) (te e) (hte e)
      (by rw [hsQv, hσc, hQe'v, hξuL])

  have hrk : ∀ e, IsCur A π C An (((ℓ ^ k : ℕ) : ℤ) • (Finsupp.single (Qe e) 1 - Finsupp.single (Qe' e) 1)) := by
    intro e
    obtain ⟨W₁, hW₁, hrot⟩ := rot (C := C) e ξu (hQedom e) (hQed e) (ℓ ^ k)
    have h := hrot (Qe' e) (Qe e) (hQe'dom e) (hQedom e) (hQe'v e) (by rw [hξupow, one_mul])
    rw [sub_self, add_zero] at h
    rw [h]; exact hW₁

  have hCM : IsCur A π C An (Dch - s₁ • Dch) := chart_motion s₁ hC1 hmap1 hcover Dch hDch

  have hmq_ex : ∀ e, ∃ q : ℤ, nn e = (if e = e₀ then 1 else 0) + q * ((ℓ ^ k : ℕ) : ℤ) := by
    intro e; obtain ⟨q, hq⟩ := hnn e; exact ⟨q, by linear_combination hq⟩
  choose mq hmq using hmq_ex

  set κ : Fin m → Divisor L F := fun e => Finsupp.single (Qe e) 1 - Finsupp.single (Qe' e) 1 with hκ
  set dg : Fin m → Divisor L F := fun e => Finsupp.single (s₁ • Qe e) 1 - Finsupp.single (Qe' e) 1 with hdg_def
  set W : Divisor L F := (Dch - s₁ • Dch) + ∑ e, mq e • (((ℓ ^ k : ℕ) : ℤ) • κ e) - ∑ e, nn e • dg e with hW
  have hWcur : IsCur A π C An W :=
    isCur_sub (isCur_add hCM (isCur_sum _ _ fun e _ => isCur_zsmul _ (hrk e)))
      (isCur_sum _ _ fun e _ => isCur_zsmul _ (hdg e))
  have key : ∑ e, nn e • κ e = κ e₀ + ∑ e, mq e • (((ℓ ^ k : ℕ) : ℤ) • κ e) := by
    have : ∀ e, nn e • κ e = (if e = e₀ then κ e else 0) + mq e • (((ℓ ^ k : ℕ) : ℤ) • κ e) := by
      intro e; rw [hmq e, add_smul, smul_smul]
      split_ifs <;> simp
    rw [Finset.sum_congr rfl (fun e _ => this e), Finset.sum_add_distrib, Finset.sum_ite_eq']
    simp
  have hDid : D₀ - s₁ • D₀ = κ e₀ + W := by
    have e1 : D₀ - s₁ • D₀ = (Dch - s₁ • Dch) + (∑ e, nn e • κ e - ∑ e, nn e • dg e) := by
      have hs : ∑ e, nn e • κ e - ∑ e, nn e • dg e =
          ∑ e, nn e • (Finsupp.single (Qe e) 1 : Divisor L F) - ∑ e, nn e • (Finsupp.single (s₁ • Qe e) 1 : Divisor L F) := by
        rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro e _
        simp only [hκ, hdg_def, smul_sub]
        abel
      rw [hD₀eq, smul_add, smul_sum_divisor, hs]
      simp only [smul_zsmul_divisor, SemilinearAut.smul_single]
      abel
    rw [e1, key, hW]; abel
  have hdeg : (κ e₀ + W : Divisor L F) ∈ Divisor.degZero (K := L) (F := F) := by
    rw [← hDid]; exact sub_mem hD₀ (SemilinearAut.smul_mem_degZero s₁ hD₀)
  refine ⟨Pic0.mk ⟨D₀, hD₀⟩ - s₁ • Pic0.mk ⟨D₀, hD₀⟩, K, Qe e₀, Qe' e₀, W, ?_, hQedom e₀, hQe'dom e₀, hQed e₀, hQe'd e₀,
    ?_, hWcur, hdeg, ?_⟩
  · have h0 : s₁ • (0 : Pic0 L F) = 0 := smul_zero (A := Pic0 L F) s₁
    rw [zsmul_sub, ← SemilinearAut.smul_zsmul, hK, h0, sub_zero]
  · rw [hQe'v, hξuL]
  · intro hdeg'
    rw [SemilinearAut.pic0_smul_mk, ← mk_sub']
    exact mk_congr' hDid

end KS2

open KS2 in
theorem solution
    {L : Type} [Field L] [IsAlgClosed L] [CharZero L] (A : ValuationSubring L)
    (π : A) (hπ : π ∈ IsLocalRing.maximalIdeal A) (hπ0 : π ≠ 0)
    (hrk : ∀ x : L, x ≠ 0 → ∀ y : A, y ∈ IsLocalRing.maximalIdeal A →
      ∃ n : ℕ, A.valuation ((y : L) ^ n) ≤ A.valuation x)
    (F : Type) [Field F] [Algebra L F]
    (n m : ℕ) (Fbar : Fin n → Type) [∀ i, Field (Fbar i)]
    [∀ i, Algebra (IsLocalRing.ResidueField A) (Fbar i)]
    (hratBar : ∀ i, ∀ Q : Place (IsLocalRing.ResidueField A) (Fbar i), Q.IsRational)
    (C : ∀ i, ComponentChart A F (Fbar i))
    (hratF : ∀ i, ∀ P ∈ (C i).dom, P.IsRational)
    (An An' : Fin m → Annulus A F) (src tgt : Fin m → Fin n)
    (xs : ∀ e, Place (IsLocalRing.ResidueField A) (Fbar (src e)))
    (xt : ∀ e, Place (IsLocalRing.ResidueField A) (Fbar (tgt e)))
    (w : Fin m → ℕ)
    (hpair : ∀ e, (An' e).dom = (An e).dom ∧ (An' e).modulus = (An e).modulus ∧
      ((An e).modulus : L) ≠ 0 ∧
      (An' e).param * (An e).param = algebraMap L F ((An e).modulus : L))
    (hw : ∀ e, ∃ u : Aˣ, (An e).modulus = u * π ^ w e)
    (hatt : ∀ e, (An e).IsAttached (C (src e)) (xs e) ∧ (An' e).IsAttached (C (tgt e)) (xt e))
    (hnodes : (∀ i, ∀ x ∈ (C i).nodes, ∃ e,
        (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)) = ⟨i, x⟩ ∨
        (⟨tgt e, xt e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)) = ⟨i, x⟩) ∧
      (∀ i, ∀ x ∈ (C i).nodes, ∀ E E' : Fin m ⊕ Fin m,
        Sum.elim (fun e => (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)))
          (fun e => ⟨tgt e, xt e⟩) E = ⟨i, x⟩ →
        Sum.elim (fun e => (⟨src e, xs e⟩ : Σ j, Place (IsLocalRing.ResidueField A) (Fbar j)))
          (fun e => ⟨tgt e, xt e⟩) E' = ⟨i, x⟩ → E = E'))
    (hcover : ∀ P : Place L F,
      (∃ i, P ∈ (C i).dom ∧ (∀ j, P ∈ (C j).dom → j = i) ∧ ∀ e, P ∉ (An e).dom) ∨
      (∃ e, P ∈ (An e).dom ∧ (∀ e', P ∈ (An e').dom → e' = e) ∧ ∀ i, P ∉ (C i).dom))
    (hdisc : ∀ i, ∀ Q : Place (IsLocalRing.ResidueField A) (Fbar i), Q ∉ (C i).nodes →
      ∃ (T : F) (hT : T ∈ (C i).integers), (C i).residue ⟨T, hT⟩ ≠ 0 ∧ Q.ord ((C i).residue ⟨T, hT⟩) = 1 ∧
        (∀ P ∈ (C i).dom, (C i).placeMap P = Q → T ∈ P.toValuationSubring ∧
          ∃ h : P.evalAt T ∈ A, (⟨P.evalAt T, h⟩ : A) ∈ IsLocalRing.maximalIdeal A) ∧
        ∀ c : A, c ∈ IsLocalRing.maximalIdeal A →
          ∃! P : Place L F, P ∈ (C i).dom ∧ (C i).placeMap P = Q ∧ P.evalAt T = c)
    (hgenus : genusFF L F + n = (∑ i, genusFF (IsLocalRing.ResidueField A) (Fbar i)) + m + 1)
    [IsCurveOver L F] [Algebra.EssFiniteType L F]
    (S : Set (SemilinearAut L F))
    (hS : ∀ s ∈ S, (∀ a : L, a ∈ A ↔ SemilinearAut.baseAut s a ∈ A) ∧ SemilinearAut.baseAut s (π : L) = (π : L) ∧
      (∀ (a : A) (h : SemilinearAut.baseAut s (a : L) ∈ A),
        IsLocalRing.residue A ⟨SemilinearAut.baseAut s (a : L), h⟩ = IsLocalRing.residue A a) ∧
      (∀ i, ∀ P ∈ (C i).dom, s • P ∈ (C i).dom) ∧ (∀ e, ∀ P ∈ (An e).dom, s • P ∈ (An e).dom) ∧
      (∀ e, s • (An e).param = (An e).param) ∧ (∀ e, s • (An' e).param = (An' e).param) ∧
      (∀ i, ∀ f : F, ∀ hf : f ∈ (C i).integers, ∃ hf' : s • f ∈ (C i).integers,
        (C i).residue ⟨s • f, hf'⟩ = (C i).residue ⟨f, hf⟩) ∧
      (∀ i, ∀ P ∈ (C i).dom, (C i).placeMap (s • P) = (C i).placeMap P))
    (hSlift : ∀ σ : L ≃+* L, (∀ a : L, a ∈ A ↔ σ a ∈ A) → σ (π : L) = (π : L) →
      (∀ (a : A) (h : σ (a : L) ∈ A), IsLocalRing.residue A ⟨σ (a : L), h⟩ = IsLocalRing.residue A a) →
      ∃ s ∈ S, SemilinearAut.baseAut s = σ)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : IsUnit ((ℓ : ℕ) : IsLocalRing.ResidueField A))
    (hSℓ : ∃ s ∈ S, ∃ r : L, r ^ ℓ = (π : L) ∧ SemilinearAut.baseAut s r ≠ r)
    [FiniteDimensional ℚ_[ℓ] (ModularCurve.RationalTateModule ℓ (Pic0 L F))]
    [∀ i, IsCurveOver (IsLocalRing.ResidueField A) (Fbar i)]
    [∀ i, Algebra.EssFiniteType (IsLocalRing.ResidueField A) (Fbar i)]
    (M : AlgebraicCurve.SemistableModel A F Fbar C An src tgt xs xt) (D : M.Descent)
    (hκ : ∀ p : ℕ, p.Prime → CharP (IsLocalRing.ResidueField A) p →
      ∀ a : IsLocalRing.ResidueField A, ∃ n : ℕ, 0 < n ∧ a ^ (p ^ n) = a)
    (ξ : ℕ → L) (hξ0 : ξ 0 = 1) (hξ : ∀ k, ξ (k + 1) ^ ℓ = ξ k) (hξ1 : ξ 1 ≠ 1)
    :
    ∃ x : Fin m → TateModule ℓ (Pic0 L F), ∀ e : Fin m,
      ∀ (k : ℕ) (Q Q' : Place L F), Q ∈ (An e).dom → Q' ∈ (An e).dom →
        (∃ (N d : ℕ) (u : Aˣ), 0 < N ∧ (Q.evalAt (An e).param) ^ N = ((u : A) : L) * (π : L) ^ d) →
        Q'.evalAt (An e).param = ξ k * Q.evalAt (An e).param →
        ∃ (Di : Fin n → Divisor L F) (r : ℕ) (eq : Fin r → Fin m) (nq : Fin r → ℤ) (Qq : Fin r → Fin 4 → Place L F),
          (∀ i, ∀ P ∈ (Di i).support, P ∈ (C i).dom) ∧
          (∀ i, Finsupp.mapDomain (C i).placeMap (Di i) = 0) ∧
          (∀ j l, Qq j l ∈ (An (eq j)).dom) ∧
          (∀ j, (∃ (N d : ℕ) (u : Aˣ), 0 < N ∧ ((Qq j 0).evalAt (An (eq j)).param) ^ N = ((u : A) : L) * (π : L) ^ d) ∧
            (∃ (N d : ℕ) (u : Aˣ), 0 < N ∧ ((Qq j 1).evalAt (An (eq j)).param) ^ N = ((u : A) : L) * (π : L) ^ d)) ∧
          (∀ j, ∃ u : Aˣ,
            (Qq j 0).evalAt (An (eq j)).param = ((u : A) : L) * (Qq j 2).evalAt (An (eq j)).param) ∧
          (∀ j, ∃ t ∈ IsLocalRing.maximalIdeal A,
            (Qq j 0).evalAt (An (eq j)).param * (Qq j 1).evalAt (An (eq j)).param =
              (Qq j 2).evalAt (An (eq j)).param * (Qq j 3).evalAt (An (eq j)).param * (1 + ((t : A) : L))) ∧
          ∀ hD : (Finsupp.single Q 1 - Finsupp.single Q' 1 - ∑ i, Di i
              - ∑ j, nq j • (Finsupp.single (Qq j 0) 1 + Finsupp.single (Qq j 1) 1
                  - Finsupp.single (Qq j 2) 1 - Finsupp.single (Qq j 3) 1) : Divisor L F) ∈
              Divisor.degZero (K := L) (F := F),
            TateModule.proj ℓ (Pic0 L F) k (x e) = Pic0.mk ⟨Finsupp.single Q 1 - Finsupp.single Q' 1 - ∑ i, Di i
              - ∑ j, nq j • (Finsupp.single (Qq j 0) 1 + Finsupp.single (Qq j 1) 1
                  - Finsupp.single (Qq j 2) 1 - Finsupp.single (Qq j 3) 1), hD⟩ := by
  classical
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  have hξk : ∀ k, ξ k ^ ℓ ^ k = 1 := xi_pow_eq_one ξ hξ0 hξ
  have hξA : ∀ k, ξ k ∈ A := fun k => mem_of_pow_eq_one A (pow_pos hℓpos k) (hξk k)
  have hξunit : ∀ k, IsUnit (⟨ξ k, hξA k⟩ : A) := fun k =>
    IsUnit.of_pow_eq_one (n := ℓ ^ k) (Subtype.ext (by push_cast; exact hξk k)) (pow_pos hℓpos k).ne'
  set ξu : ℕ → Aˣ := fun k => (hξunit k).unit with hξu_def
  have hξuL : ∀ k, (((ξu k : Aˣ) : A) : L) = ξ k := fun k => congrArg Subtype.val (hξunit k).unit_spec
  have hξuℓ : ∀ k, ((((ξu (k + 1)) ^ ℓ : Aˣ) : A) : L) = ξ k := by intro k; push_cast; rw [hξuL, hξ]
  have hξupow : ∀ k, ((((ξu k) ^ (ℓ ^ k) : Aˣ) : A) : L) = 1 := by intro k; push_cast; rw [hξuL, hξk]

  have hS1 : ∀ X : Divisor L F, IsCur A π C An X → ∀ K : ℕ,
      ((ℓ ^ K : ℕ) : ℤ) • X ∈ Divisor.principal (K := L) (F := F) → X ∈ Divisor.principal (K := L) (F := F) := by
    intro X hX K hKX
    obtain ⟨Di, r, eq, nq, Qq, h1, h2, h3, h4, h5, h6, hXeq⟩ := hX
    have hk : IsUnit (((ℓ ^ K : ℕ) : ℕ) : IsLocalRing.ResidueField A) := by rw [Nat.cast_pow]; exact hℓ.pow K
    subst hXeq
    exact AlgebraicCurve.mem_principal_of_zsmul_mem_principal_of_forall_mapDomain_placeMap_eq_zero_of_genusFF_of_semistableModel_of_descent
      A π hπ hπ0 hrk F Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes hcover hdisc
      (by simpa [Fintype.card_fin] using hgenus) M D (ℓ ^ K) hk Di h1 h2 eq nq Qq h3 h5 h6 hKX

  have LEVEL := fun e₀ k hk => level A π hπ hπ0 hrk F n m Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes hcover hdisc hgenus S hS hSlift ℓ hℓ hSℓ M D ξ hξ0 hξ hξ1 hκ e₀ k hk
  choose tt KK R R' W hKK hRdom hR'dom hRd hR'd hR'v hW hdegW htt using LEVEL

  have h5 : ∀ (e₀ : Fin m) (k : ℕ) (hk : 0 < k), ((ℓ ^ k : ℕ) : ℤ) • tt e₀ k hk = 0 := by
    intro e₀ k hk
    obtain ⟨W₁, hW₁, hrot⟩ := rot (C := C) e₀ (ξu k) (hRdom e₀ k hk) (hRd e₀ k hk) (ℓ ^ k)
    have hrot' := hrot (R' e₀ k hk) (R e₀ k hk) (hR'dom e₀ k hk) (hRdom e₀ k hk)
      (by rw [hR'v, hξuL]) (by rw [hξupow, one_mul])
    rw [sub_self, add_zero] at hrot'
    have hXcur : IsCur A π C An
        (((ℓ ^ k : ℕ) : ℤ) • (Finsupp.single (R e₀ k hk) 1 - Finsupp.single (R' e₀ k hk) 1 + W e₀ k hk)) := by
      rw [smul_add, hrot']
      exact isCur_add hW₁ (isCur_zsmul _ (hW e₀ k hk))
    have hz : ((ℓ ^ KK e₀ k hk : ℕ) : ℤ) • (((ℓ ^ k : ℕ) : ℤ) • tt e₀ k hk) = 0 := by
      rw [smul_comm, hKK, zsmul_zero]
    rw [htt e₀ k hk (hdegW e₀ k hk), ← mk_zsmul', ← mk_zsmul', mk_eq_zero_iff] at hz
    have hprin := hS1 _ hXcur (KK e₀ k hk) (by simpa using hz)
    rw [htt e₀ k hk (hdegW e₀ k hk), ← mk_zsmul', mk_eq_zero_iff]
    simpa using hprin

  have h6 : ∀ (e₀ : Fin m) (k : ℕ) (hk : 0 < k),
      ((ℓ : ℕ) : ℤ) • tt e₀ (k + 1) (Nat.succ_pos k) - tt e₀ k hk = 0 := by
    intro e₀ k hk
    have hk1 : 0 < k + 1 := Nat.succ_pos k
    obtain ⟨Pℓ, hPℓdom, hPℓv⟩ := exists_place_unit_mul (An e₀) (hRdom e₀ (k + 1) hk1) (ξu k)
    obtain ⟨W₁, hW₁, hrot⟩ := rot (C := C) e₀ (ξu (k + 1)) (hRdom e₀ (k + 1) hk1) (hRd e₀ (k + 1) hk1) ℓ
    have hrot' := hrot (R' e₀ (k + 1) hk1) Pℓ (hR'dom e₀ (k + 1) hk1) hPℓdom
      (by rw [hR'v, hξuL]) (by rw [hξuℓ, ← hξuL k]; exact hPℓv)
    have htb := two_base (C := C) e₀ (ξu k) (hRdom e₀ (k + 1) hk1) hPℓdom (hRdom e₀ k hk) (hR'dom e₀ k hk)
      (hRd e₀ (k + 1) hk1) (hR'd e₀ k hk) hPℓv (by rw [hξuL]; exact hR'v e₀ k hk)
    have hY : IsCur A π C An
        (((ℓ : ℕ) : ℤ) • (Finsupp.single (R e₀ (k + 1) hk1) 1 - Finsupp.single (R' e₀ (k + 1) hk1) 1 + W e₀ (k + 1) hk1) -
          (Finsupp.single (R e₀ k hk) 1 - Finsupp.single (R' e₀ k hk) 1 + W e₀ k hk)) := by
      have e1 : (((ℓ : ℕ) : ℤ) • (Finsupp.single (R e₀ (k + 1) hk1) 1 - Finsupp.single (R' e₀ (k + 1) hk1) 1 + W e₀ (k + 1) hk1) -
          (Finsupp.single (R e₀ k hk) 1 - Finsupp.single (R' e₀ k hk) 1 + W e₀ k hk) : Divisor L F) =
          (W₁ + ((Finsupp.single (R e₀ (k + 1) hk1) 1 - Finsupp.single Pℓ 1) -
            (Finsupp.single (R e₀ k hk) 1 - Finsupp.single (R' e₀ k hk) 1))) +
          (((ℓ : ℕ) : ℤ) • W e₀ (k + 1) hk1 - W e₀ k hk) := by
        rw [smul_add, hrot']; abel
      rw [e1]
      exact isCur_add (isCur_add hW₁ htb) (isCur_sub (isCur_zsmul _ (hW e₀ (k + 1) hk1)) (hW e₀ k hk))
    have hz : ((ℓ ^ (KK e₀ (k + 1) hk1 + KK e₀ k hk) : ℕ) : ℤ) •
        (((ℓ : ℕ) : ℤ) • tt e₀ (k + 1) hk1 - tt e₀ k hk) = 0 := by
      rw [zsmul_sub, smul_comm, torsion_mono ℓ (Nat.le_add_right _ _) (hKK e₀ (k + 1) hk1), zsmul_zero,
        torsion_mono ℓ (Nat.le_add_left _ _) (hKK e₀ k hk), sub_zero]
    rw [htt e₀ (k + 1) hk1 (hdegW e₀ (k + 1) hk1), htt e₀ k hk (hdegW e₀ k hk), ← mk_zsmul', ← mk_sub', ← mk_zsmul', mk_eq_zero_iff] at hz
    have hprin := hS1 _ hY _ (by simpa using hz)
    rw [htt e₀ (k + 1) hk1 (hdegW e₀ (k + 1) hk1), htt e₀ k hk (hdegW e₀ k hk), ← mk_zsmul', ← mk_sub', mk_eq_zero_iff]
    simpa using hprin

  let t : Fin m → ℕ → Pic0 L F := fun e₀ k => if hk : 0 < k then tt e₀ k hk else 0
  have ht0 : ∀ e₀, t e₀ 0 = 0 := fun e₀ => dif_neg (lt_irrefl 0)
  have htpos : ∀ e₀ k (hk : 0 < k), t e₀ k = tt e₀ k hk := fun e₀ k hk => dif_pos hk
  have hmem : ∀ (e₀ : Fin m) (k : ℕ),
      ((ℓ ^ k : ℕ) : ℤ) • t e₀ k = 0 ∧ ((ℓ : ℕ) : ℤ) • t e₀ (k + 1) = t e₀ k := by
    intro e₀ k
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · refine ⟨by rw [ht0]; exact zsmul_zero _, ?_⟩
      rw [ht0, htpos e₀ 1 one_pos]
      have := h5 e₀ 1 one_pos
      rwa [pow_one] at this
    · refine ⟨by rw [htpos e₀ k hk]; exact h5 e₀ k hk, ?_⟩
      rw [htpos e₀ (k + 1) (Nat.succ_pos k), htpos e₀ k hk]
      exact sub_eq_zero.mp (h6 e₀ k hk)
  refine ⟨fun e₀ => ⟨t e₀, fun k => hmem e₀ k⟩, ?_⟩
  intro e₀ k Q Q' hQ hQ' hQd hratio
  rcases Nat.eq_zero_or_pos k with rfl | hk
  ·
    have hQQ' : Q' = Q := place_eq_of_evalAt_eq (An e₀) hQ' hQ (by rw [hratio, hξ0, one_mul])
    subst hQQ'
    refine ⟨fun _ => 0, 0, Fin.elim0, Fin.elim0, Fin.elim0, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i P hP; simp at hP
    · intro i; simp
    · intro j; exact Fin.elim0 j
    · intro j; exact Fin.elim0 j
    · intro j; exact Fin.elim0 j
    · intro j; exact Fin.elim0 j
    · intro hD
      rw [TateModule.proj_apply]
      show t e₀ 0 = _
      rw [ht0]
      symm
      rw [mk_eq_zero_iff]
      simp
  · have htb := two_base (C := C) e₀ (ξu k) hQ hQ' (hRdom e₀ k hk) (hR'dom e₀ k hk) hQd (hR'd e₀ k hk)
      (by rw [hξuL]; exact hratio) (by rw [hξuL]; exact hR'v e₀ k hk)
