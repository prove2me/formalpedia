/-- **The three claims of `Err18Need` from a surjective coefficient model.** -/
theorem e18_main (hy : y ^ (2 ^ ℓ) = -1) (hs : Function.Surjective C.co) (p : ℕ)
    (xf xg : List (Fin (2 ^ ℓ) → ℂ)) (hlf : xf.length = ((KFV.ts18 D ℓ long)).prod) (hlg : xg.length = ((KFV.ts18 D ℓ long)).prod)
