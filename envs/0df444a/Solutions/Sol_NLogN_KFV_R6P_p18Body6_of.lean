/-! ## Arithmetic of the frame -/

theorem nL18_le (ℓ : ℕ) (ts : List ℕ) : nL18 ℓ ts ≤ ts.length := by
  unfold nL18
  exact (List.count_le_length).trans (by simp [fl18])

theorem n18_eq (ℓ K : ℕ) (ts : List ℕ) (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    n18 ℓ K ts = nL18 ℓ ts + ts.length * (ℓ - 1) := by
  unfold n18 lst18
  rw [← hbq ℓ K hK hℓ]; ring

theorem tgtL_18 (ℓ K : ℕ) (ts : List ℕ) [NeZero ts.length] (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    (tgtL ts.length ℓ K (long18 ℓ ts)).length = n18 ℓ K ts := by
  have := congrArg LP.n (pLP_18 ℓ K ts hK hℓ)
  simpa [pLP] using this

theorem pow2_mono {a b : ℕ} (h : a ≤ b) : 2 ^ a ≤ 2 ^ b := Nat.pow_le_pow_right (by norm_num) h

end NLogN.KFV

end

