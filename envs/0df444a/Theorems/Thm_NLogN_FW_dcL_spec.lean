theorem NLogN.FW.dcL_spec (M : MulSpec) (P r l N W : ℕ) (hP : 1 ≤ P) (hr1 : 1 ≤ r) (hl : l ≤ 4 * r * P) (s : IState HS)
    (C : List ℤ) (RD LN LS LXN LXF LB LKN LR : List Item) (hCl : C.length = N)
    (hCc : Canon (2 ^ (4 * r * P) + 1) C) (hX : s.G XD = ints C ++ RD)
    (hN : s.G NN = .int (N : ℤ) :: LN) (hS : s.G SH = .int (2 ^ (4 * r * P - l)) :: LS)
    (hXN : s.G NLogN.FW.XN = .int (2 ^ (4 * r * P)) :: LXN)
    (hXF : s.G XF = .int (2 ^ (4 * r * P) + 1) :: LXF)
    (hB : s.G KB = .int (2 ^ P) :: LB) (hKN : s.G KN = .int (2 ^ (4 * r * P)) :: LKN)
    (hR : s.G KR = .int (r : ℤ) :: LR)
    (hW : 2 * (4 * r * P) + 3 ≤ W) (hNW : zsz (N : ℤ) ≤ W) (Q : ℕ) (hPQ : P ≤ Q) (hrQ : zsz (r : ℤ) ≤ Q) :
    Spec M dcL s ((s.upd XD RD).upd KO
      (gints ((C.map (scl (4 * r * P) l)).flatMap (Ref.decBlk (2 ^ (4 * r * P) + 1) P r)).reverse ++
        s.G KO)) (dcCost N r P Q W) := by sorry
