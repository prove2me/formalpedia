private theorem _root_.ModularCurve.JZeroNeronObjectAtP.smul_mem_extPts (t : HeckeAlg) {x : JZero (N₀ * p)} (hx : x ∈ O.extPts) :
    (letI := heckeModuleBar (N₀ * p); t • x) ∈ O.extPts := by
  letI := heckeModuleBar (N₀ * p)
  obtain ⟨φ, -, hφ⟩ := O.hecke t
  obtain ⟨s, hs⟩ := hx
