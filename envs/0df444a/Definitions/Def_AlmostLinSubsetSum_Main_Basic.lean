-- title:
--   Subset sums $S(V)$, zonotopes $Z(V)$, boxes, $|K|$, support functions, $k$-fold sumsets, reanchoring
-- statement:
--   Notation of §2.1 (pp. 11–12) and §3.2 (pp. 15–16). Vectors of $\mathbb Z^d$, $\mathbb R^d$ are functions on $\{0,\dots,d-1\}$; $u\cdot x$ is the dot product.
--
--   - A multiset of items is a family $(v_i)_{i\in I}$ over a finite index set $I$; repeated values are different indices. Its **subset sums** are $S(V)=\{\sum_{i\in Y}v_i : Y\subseteq I\}$ (the empty sum $0$ included).
--   - The **zonotope** $Z(V)=\sum_{i\in I}[0,v_i]=\{\sum_{i\in I}c_iv_i : 0\le c_i\le 1\}$.
--   - The **box** with half-widths $q$ is $\prod_j[-q_j,q_j]$; $\lambda\cdot X=\{\lambda x : x\in X\}$ is geometric scaling, $p+X$ a translate, $X+Y$ the Minkowski sum.
--   - $|K|:=\#(K\cap\mathbb Z^d)$, the number of integer points.
--   - The **support function** $h_K(u)=\max_{x\in K}u\cdot x$ (a real supremum, a maximum on the nonempty compact sets where it is used) and the **width** $\mathrm{width}_K(u)=h_K(u)+h_K(-u)$.
--   - The **$k$-fold sumset** $kX=X+\dots+X$ ($k$ summands; $0X=\{0\}$), distinct from the dilate $k\cdot X$ (for $X=\{0,1\}$: $2X=\{0,1,2\}$, $2\cdot X=\{0,2\}$).
--   - **Reanchoring** at a selection $\bar x$: $v'_i=(1-2\bar x_i)v_i$, i.e. the items selected by $\bar x$ are negated.
--   - For an integer $d\times r$ matrix $F$, `realMap F` is the linear map $u\mapsto Fu$ on $\mathbb R^r$.
-- source:
--   Chen, Mao, Zhang (2026), An Almost-Linear Time Algorithm for Multidimensional Subset Sum, STOC 2027 submission, SHA-256 0cd42ca048cfff088013ad06450a278a6df72a29004c48c5c138f3f6df85d1e0, §2.1, pp. 11–12; §3.2, pp. 15–16

import Mathlib

set_option autoImplicit false

namespace AlmostLinSubsetSum.Main

open scoped BigOperators

/-!
# Subset sums, zonotopes, boxes, support functions and repeated sumsets

Chen, Mao, Zhang, *An Almost-Linear Time Algorithm for Multidimensional Subset Sum* (2026),
STOC 2027 submission, SHA-256 0cd42ca0…1e0, §2.1, pp. 11–12, and §3.2, pp. 15–16.

**Formalization Note.**
* Vectors of `ℤ^d` and `ℝ^d` are functions `Fin d → ℤ` and `Fin d → ℝ`; `x ⬝ᵥ y` is the
  standard dot product `u · x` of the paper.
* A multiset of items is a family `v : ι → (Fin d → ℤ)` together with a finite index set
  `I : Finset ι`; repeated values are distinct indices, so the sub-multisets of the paper are
  exactly the index subsets `Y ⊆ I`.
* `kFold k X` is the `k`-fold sumset `X + ⋯ + X` (`k` summands, `kFold 0 X = {0}`), and is
  **not** the dilate `k · X`, which is `dilate k X`.
-/

/-- The real vector with the same coordinates as an integer vector. -/
def toReal {d : ℕ} (v : Fin d → ℤ) : Fin d → ℝ := fun j => (v j : ℝ)

/-- `S(V)`: the subset sums `Σ_{i ∈ Y} v_i` of the items indexed by `I`, over all `Y ⊆ I`
(the empty subset gives `0`). -/
def subsetSums {ι : Type*} {d : ℕ} (I : Finset ι) (v : ι → Fin d → ℤ) : Set (Fin d → ℤ) :=
  {s | ∃ Y : Finset ι, Y ⊆ I ∧ ∑ i ∈ Y, v i = s}

/-- `Z(V) = Σ_{i ∈ I} [0, v_i]`: the zonotope generated by the vectors indexed by `I`, i.e.
the set of all `Σ_{i ∈ I} c_i v_i` with `0 ≤ c_i ≤ 1`. -/
def zonotope {ι : Type*} {d : ℕ} (I : Finset ι) (v : ι → Fin d → ℝ) : Set (Fin d → ℝ) :=
  {x | ∃ c : ι → ℝ, (∀ i ∈ I, 0 ≤ c i ∧ c i ≤ 1) ∧ x = ∑ i ∈ I, c i • v i}

/-- The box `∏_j [−q_j, q_j] ⊂ ℝ^d` with half-widths `q`. -/
def box {d : ℕ} (q : Fin d → ℝ) : Set (Fin d → ℝ) := {x | ∀ j, |x j| ≤ q j}

/-- Geometric scaling `λ · X = {λ x : x ∈ X}`. -/
def dilate {d : ℕ} (c : ℝ) (X : Set (Fin d → ℝ)) : Set (Fin d → ℝ) := (fun x => c • x) '' X

/-- The translate `p + X = {p + x : x ∈ X}`. -/
def translate {d : ℕ} (p : Fin d → ℝ) (X : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  (fun x => p + x) '' X

/-- The Minkowski sum `X + Y = {x + y : x ∈ X, y ∈ Y}`. -/
def minkSum {d : ℕ} (X Y : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  {z | ∃ x ∈ X, ∃ y ∈ Y, z = x + y}

/-- `|K| := #(K ∩ ℤ^d)`, the number of integer points of `K` (as `Set.ncard`; every set this
mission applies it to is bounded, hence has finitely many integer points). -/
noncomputable def latticeCount {d : ℕ} (K : Set (Fin d → ℝ)) : ℕ :=
  Set.ncard {z : Fin d → ℤ | toReal z ∈ K}

/-- The support function `h_K(u) = max_{x ∈ K} u · x`, as the real supremum of the image (a
maximum for the nonempty compact sets it is applied to). -/
noncomputable def supportFn {d : ℕ} (K : Set (Fin d → ℝ)) (u : Fin d → ℝ) : ℝ :=
  sSup ((fun x => u ⬝ᵥ x) '' K)

/-- The width `width_K(u) = h_K(u) + h_K(−u)`. -/
noncomputable def widthFn {d : ℕ} (K : Set (Fin d → ℝ)) (u : Fin d → ℝ) : ℝ :=
  supportFn K u + supportFn K (-u)

/-- The `k`-fold sumset `kX = X + ⋯ + X` (`k` summands) of a set in an additive monoid. -/
def kFold {G : Type*} [AddCommMonoid G] (k : ℕ) (X : Set G) : Set G :=
  {x | ∃ f : Fin k → G, (∀ i, f i ∈ X) ∧ ∑ i, f i = x}

/-- Reanchoring at the reference selection `x̄` (§3.2, p. 16): `v'_i = (1 − 2 x̄_i) v_i`, i.e.
the items selected by `x̄` are negated. -/
def reanchor {ι : Type*} {d : ℕ} [DecidableEq ι] (xbar : Finset ι) (v : ι → Fin d → ℤ) :
    ι → Fin d → ℤ :=
  fun i => if i ∈ xbar then -v i else v i

/-- The linear map `ℝ^r → ℝ^d` of an integer matrix `F`. -/
def realMap {d r : ℕ} (F : Matrix (Fin d) (Fin r) ℤ) (u : Fin r → ℝ) : Fin d → ℝ :=
  Matrix.mulVec (F.map (fun a : ℤ => (a : ℝ))) u

end AlmostLinSubsetSum.Main


