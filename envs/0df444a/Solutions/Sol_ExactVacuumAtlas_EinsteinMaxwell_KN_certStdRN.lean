/-! ## `a = 0`: Reissner–Nordström in standard coordinates -/

theorem domKN_a0 (M Q : ℝ) : domKN M 0 Q = RNStd.domStdRN M Q := by
  ext x
  have e : M ^ 2 - (0 : ℝ) ^ 2 - Q ^ 2 = M ^ 2 - Q ^ 2 := by ring
  simp only [domKN, RNStd.domStdRN, rPlus, Set.mem_ofPred_eq, e]

