      have hker := wiring_check H hHK hHnorm ⁅r, h⁆ (Subgroup.commutator_mem_commutator hrR hhH)
      have heq : r * h * r⁻¹ * h⁻¹ = 1 := by rw [← commutatorElement_def]; exact hρf _ hker
