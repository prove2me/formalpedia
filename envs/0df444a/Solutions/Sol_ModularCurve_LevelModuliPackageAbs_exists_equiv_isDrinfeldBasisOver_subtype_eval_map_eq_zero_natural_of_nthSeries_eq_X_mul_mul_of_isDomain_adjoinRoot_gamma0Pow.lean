variable {T : Type*} [CommRing T] (I : Ideal T) [IsAdicComplete I T]

theorem adicEval_rename {σ τ : Type*} [Finite σ] [Finite τ] {w : τ → T} (hw : ∀ t, w t ∈ I.radical)
    (e : σ ↪ τ) (f : MvPowerSeries σ T) :
    adicEval (R := T) I w (rename e f) = adicEval (R := T) I (fun s => w (e s)) f := by
  rw [rename_eq_subst, adicEval_subst (R := T) I hw (HasSubst.X_comp e)]
  congr 1
  funext s
  exact adicEval_X (R := T) I w (e s)

theorem eval_eq_adicEval (F : FormalGroup T) (a b : T) :
    (letI : WithIdeal T := ⟨I⟩; F.eval a b) = adicEval (R := T) I ![a, b] F.toPowerSeries := rfl

theorem val_add_zero (F : FormalGroup T) (P Q : Points (ofFormalGroup F) T I) :
    (P + Q).val 0 = (letI : WithIdeal T := ⟨I⟩; F.eval (P.val 0) (Q.val 0)) := by
  letI : WithIdeal T := ⟨I⟩
  rw [Points.val_add, eval_eq_adicEval I]
  show adicEval (R := T) I (Sum.elim P.val Q.val) (rename e2 F.toPowerSeries) = _
  have hw : ∀ t, Sum.elim P.val Q.val t ∈ I.radical := by
    rintro (j | j)
    · exact P.mem_radical j
    · exact Q.mem_radical j
  rw [adicEval_rename I hw e2]
  congr 1
  funext s
  fin_cases s
  · show Sum.elim P.val Q.val (e2 0) = P.val 0
    rw [e2_zero, Sum.elim_inl]
  · show Sum.elim P.val Q.val (e2 1) = Q.val 0
    rw [e2_one, Sum.elim_inr]

theorem val_nsmul_zero_eq_evalNSMul (F : FormalGroup T) (n : ℕ) (P : Points (ofFormalGroup F) T I) :
    (n • P).val 0 = (letI : WithIdeal T := ⟨I⟩; F.evalNSMul n (P.val 0)) := by
  letI : WithIdeal T := ⟨I⟩
  induction n with
  | zero =>
    rw [zero_nsmul, FormalGroup.evalNSMul_zero]
    rfl
  | succ n ih =>
    rw [succ_nsmul, FormalGroup.evalNSMul_succ, val_add_zero I, ih]

theorem linCombAdic_eq_val (F : FormalGroup T) (x y : T) (hx : x ∈ I.radical) (hy : y ∈ I.radical) (a b : ℕ) :
    F.linCombAdic I x y a b =
      ((a • (⟨fun _ => x, fun _ => hx⟩ : Points (ofFormalGroup F) T I)) +
        (b • (⟨fun _ => y, fun _ => hy⟩ : Points (ofFormalGroup F) T I))).val 0 := by
  rw [val_add_zero I, val_nsmul_zero_eq_evalNSMul I, val_nsmul_zero_eq_evalNSMul I]
  rfl

theorem linCombAdic_zero_right (F : FormalGroup T) (x : T) (hx : x ∈ I.radical) (a : ℕ) :
    F.linCombAdic I x x a 0 = (letI : WithIdeal T := ⟨I⟩; F.evalNSMul a x) := by
  rw [linCombAdic_eq_val I F x x hx hx a 0, zero_nsmul, _root_.add_zero, val_nsmul_zero_eq_evalNSMul I]

end Bridge

theorem hfull_of_dom
    {S T : Type} [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [IsAdicComplete (maximalIdeal S) S]
    [CommRing T] [IsLocalRing T] [IsAdicComplete (maximalIdeal T) T]
    (q : ℕ) [Fact q.Prime] (FS : FormalGroup S) [FS.IsComm]
    (g : S[X]) (hgm : g.Monic) (hgdeg : g.natDegree = q - 1) (hgcoeff : ∀ i < q - 1, g.coeff i ∈ maximalIdeal S)
    (v : PowerSeries S) (hv : IsUnit v) (hfacq : FS.nthSeries q = PowerSeries.X * (↑g : PowerSeries S) * v)
    (hdom : IsDomain (AdjoinRoot g)) (hqS : (q : S) ≠ 0)
    (Φ : S →+* T) (hΦ : ∀ s ∈ maximalIdeal S, Φ s ∈ maximalIdeal T)
    (π : T) (hπ : π ∈ maximalIdeal T) (hroot : (g.map Φ).eval π = 0) :
    ∃ u : PowerSeries T, IsUnit u ∧
      (FS.map Φ).nthSeries q = u * ∏ a ∈ Finset.range q,
        (PowerSeries.X - PowerSeries.C (letI : WithIdeal T := ⟨maximalIdeal T⟩; (FS.map Φ).evalNSMul a π)) := by
  classical
  have hq2 : 2 ≤ q := (Fact.out : q.Prime).two_le
  have hdeg1 : 1 ≤ g.natDegree := by rw [hgdeg]; omega

  obtain ⟨instLoc, instCpl, instNoe, instFin, hsurj, hrootm, hmax⟩ :=
    AdjoinRoot.exists_isLocalRing_isAdicComplete_of_monic_of_coeff_mem_maximalIdeal S g hgm hdeg1 (hgdeg ▸ hgcoeff)
  haveI := instLoc; haveI := instCpl; haveI := instNoe; haveI := hdom
  set A := AdjoinRoot g with hA
  let ι : S →+* A := AdjoinRoot.of g
  have hι : ∀ s ∈ maximalIdeal S, ι s ∈ maximalIdeal A := by
    intro s hs
    rw [hmax]
    exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hs)

  let FA : FormalGroup A := FS.map ι
  have hbcA : FS.IsBaseChange ι FA := FormalGroup.map_toPowerSeries FS ι
  haveI : FA.IsComm := FormalGroup.IsBaseChange.isComm FS ι FA hbcA
  have hFA : FA.nthSeries q = PowerSeries.X * (↑(g.map ι) : PowerSeries A) * PowerSeries.map ι v := by
    rw [FormalGroup.IsBaseChange.nthSeries_eq_map FS ι FA hbcA q, hfacq, map_mul, map_mul, PowerSeries.map_X,
      Polynomial.polynomial_map_coe]
  have hgmA : (g.map ι).Monic := hgm.map ι
  have hdegA : (g.map ι).natDegree = q - 1 := by rw [hgm.natDegree_map, hgdeg]
  have hcoeffA : ∀ i < q - 1, (g.map ι).coeff i ∈ maximalIdeal A := by
    intro i hi; rw [Polynomial.coeff_map]; exact hι _ (hgcoeff i hi)
  have hq0A : (q : A) ≠ 0 := by
    intro h
    apply hqS
    have h1 : ι (q : S) = 0 := by rw [map_natCast]; exact h
    have h2 : g ∣ Polynomial.C (q : S) := AdjoinRoot.mk_eq_zero.mp h1
    by_contra hne
    exact hgm.not_dvd_of_natDegree_lt (by rwa [Ne, Polynomial.C_eq_zero]) (by rw [Polynomial.natDegree_C]; omega) h2
  have hrootA : (g.map ι).eval (AdjoinRoot.root g) = 0 := (AdjoinRoot.isRoot_root g)

  have hfull := FormalGroup.X_mul_eq_prod_X_sub_C_evalNSMul_of_eval_eq_zero_of_isDomain A FA q hq0A (g.map ι)
    hgmA hdegA hcoeffA (PowerSeries.map ι v) (hv.map _) hFA (AdjoinRoot.root g) hrootm hrootA

  have hroot₂ : g.eval₂ Φ π = 0 := by rw [Polynomial.eval₂_eq_eval_map]; exact hroot
  let lam : A →+* T := AdjoinRoot.lift Φ π hroot₂
  have hlamι : lam.comp ι = Φ := AdjoinRoot.lift_comp_of hroot₂
  have hlamr : lam (AdjoinRoot.root g) = π := AdjoinRoot.lift_root hroot₂
  have hlamloc : ∀ a ∈ maximalIdeal A, lam a ∈ maximalIdeal T := by
    have hle : maximalIdeal A ≤ (maximalIdeal T).comap lam := by
      rw [hmax]
      refine sup_le ?_ ?_
      · rw [Ideal.map_le_iff_le_comap]
        intro s hs
        show lam (ι s) ∈ maximalIdeal T
        rw [← RingHom.comp_apply, hlamι]
        exact hΦ s hs
      · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hlamr]
        exact hπ
    intro a ha
    exact hle ha

  have hbcT : FA.IsBaseChange lam (FS.map Φ) := by
    show (FS.map Φ).toPowerSeries = MvPowerSeries.map lam FA.toPowerSeries
    rw [FormalGroup.map_toPowerSeries, FormalGroup.map_toPowerSeries, MvPowerSeries.map_map, hlamι]

  have htrans : ∀ a : ℕ, lam (letI : WithIdeal A := ⟨maximalIdeal A⟩; FA.evalNSMul a (AdjoinRoot.root g)) =
      (letI : WithIdeal T := ⟨maximalIdeal T⟩; (FS.map Φ).evalNSMul a π) := by
    intro a
    have key := FormalGroup.IsBaseChange.apply_linCombAdic_eq_of_apply_mem (maximalIdeal A) (maximalIdeal T) lam
      FA (FS.map Φ) hbcT (AdjoinRoot.root g) (AdjoinRoot.root g) hrootm hrootm
      (by rw [hlamr]; exact hπ) (by rw [hlamr]; exact hπ) a 0
    rw [hlamr, linCombAdic_zero_right (maximalIdeal A) FA _ (Ideal.le_radical hrootm) a,
      linCombAdic_zero_right (maximalIdeal T) (FS.map Φ) π (Ideal.le_radical hπ) a] at key
    exact key

  have hpoly : Polynomial.X * g.map Φ = ∏ a ∈ Finset.range q,
      (Polynomial.X - Polynomial.C (letI : WithIdeal T := ⟨maximalIdeal T⟩; (FS.map Φ).evalNSMul a π)) := by
    have h := congrArg (Polynomial.map lam) hfull
    rw [Polynomial.map_mul, Polynomial.map_X, Polynomial.map_map, hlamι] at h
    rw [h, ← Polynomial.coe_mapRingHom, map_prod]
    refine Finset.prod_congr rfl fun a _ => ?_
    rw [Polynomial.coe_mapRingHom, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, htrans a]

  have hfacqT : (FS.map Φ).nthSeries q =
      PowerSeries.X * (↑(g.map Φ) : PowerSeries T) * PowerSeries.map Φ v := by
    rw [FormalGroup.IsBaseChange.nthSeries_eq_map FS Φ (FS.map Φ) (FormalGroup.map_toPowerSeries FS Φ) q, hfacq,
      map_mul, map_mul, PowerSeries.map_X, Polynomial.polynomial_map_coe]
  exact FormalGroup.exists_isUnit_nthSeries_eq_mul_prod_of_X_mul_eq_prod T (FS.map Φ) q (g.map Φ)
    (PowerSeries.map Φ v) (hv.map _) hfacqT
    (fun a => (letI : WithIdeal T := ⟨maximalIdeal T⟩; (FS.map Φ).evalNSMul a π)) hpoly

end HfullAsm

namespace H1cAsm

variable {T : Type} [CommRing T] [IsLocalRing T] [IsAdicComplete (maximalIdeal T) T]

theorem chart_unique (W : WeierstrassCurve T) (P : Section W) (χ χ' : OriginChartRing W →+* T)
    (h : ReducesToOrigin P χ (maximalIdeal T)) (h' : ReducesToOrigin P χ' (maximalIdeal T)) : χ = χ' := by
  obtain ⟨hs, -, -⟩ := h
  obtain ⟨hs', -, -⟩ := h'
  have e : Spec.map (CommRingCat.ofHom χ) ≫ originChartι W = Spec.map (CommRingCat.ofHom χ') ≫ originChartι W := by
    rw [← hs, ← hs']
  have e2 : Spec.map (CommRingCat.ofHom χ) = Spec.map (CommRingCat.ofHom χ') := (cancel_mono _).mp e
  have e3 := Spec.map_injective e2
  exact RingHom.ext fun x => congrArg (fun g : CommRingCat.of (OriginChartRing W) ⟶ CommRingCat.of T => g.hom x) e3

noncomputable def param (W : WeierstrassCurve T) (P : Section W)
    (h : ∃ χ : OriginChartRing W →+* T, ReducesToOrigin P χ (maximalIdeal T)) : T :=
  originParam h.choose

theorem param_eq (W : WeierstrassCurve T) (P : Section W)
    (h : ∃ χ : OriginChartRing W →+* T, ReducesToOrigin P χ (maximalIdeal T))
    (χ : OriginChartRing W →+* T) (hχ : ReducesToOrigin P χ (maximalIdeal T)) :
    param W P h = originParam χ := by
  unfold param
  rw [chart_unique W P h.choose χ h.choose_spec hχ]

section RootEquiv

variable (W : WeierstrassCurve T) (G : RelativeGroupLaw T (projModelStrCR W)) (q : ℕ) (Q : Section W) (g : T[X])
  (h₁ : ∀ (P : Section W) (χP : OriginChartRing W →+* T), ReducesToOrigin P χP (maximalIdeal T) →
      (IsDrinfeldBasis G q P Q ↔ g.eval (originParam χP) = 0))
  (h₂ : ∀ π : T, g.eval π = 0 →
      ∃ (P : Section W) (χP : OriginChartRing W →+* T), ReducesToOrigin P χP (maximalIdeal T) ∧ originParam χP = π)

abbrev PartnerSet : Type :=
  {P : Section W // (∃ χ : OriginChartRing W →+* T, ReducesToOrigin P χ (maximalIdeal T)) ∧ IsDrinfeldBasis G q P Q}

abbrev RootSet : Type := {π : T // g.eval π = 0}

noncomputable def fwd (P : PartnerSet W G q Q) : RootSet g :=
  ⟨param W P.1 P.2.1, by
    rw [param_eq W P.1 P.2.1 _ P.2.1.choose_spec]
    exact (h₁ P.1 _ P.2.1.choose_spec).mp P.2.2⟩

theorem fwd_val (P : PartnerSet W G q Q) : (fwd W G q Q g h₁ P).1 = param W P.1 P.2.1 := rfl

noncomputable def bwd (π : RootSet g) : PartnerSet W G q Q :=
  ⟨(h₂ π.1 π.2).choose,
    ⟨(h₂ π.1 π.2).choose_spec.choose, (h₂ π.1 π.2).choose_spec.choose_spec.1⟩,
    (h₁ _ _ (h₂ π.1 π.2).choose_spec.choose_spec.1).mpr (by
      rw [(h₂ π.1 π.2).choose_spec.choose_spec.2]; exact π.2)⟩

theorem bwd_val (π : RootSet g) : (bwd W G q Q g h₁ h₂ π).1 = (h₂ π.1 π.2).choose := rfl

noncomputable def rootEquiv : PartnerSet W G q Q ≃ RootSet g where
  toFun := fwd W G q Q g h₁
  invFun := bwd W G q Q g h₁ h₂
  left_inv P := by
    apply Subtype.ext
    rw [bwd_val]
    have hspec := (h₂ (fwd W G q Q g h₁ P).1 (fwd W G q Q g h₁ P).2).choose_spec.choose_spec
    have hpar : originParam (h₂ (fwd W G q Q g h₁ P).1 (fwd W G q Q g h₁ P).2).choose_spec.choose =
        originParam P.2.1.choose := by
      rw [hspec.2, fwd_val, param_eq W P.1 P.2.1 _ P.2.1.choose_spec]
    exact (WeierstrassCurve.DrinfeldGlobal.section_eq_of_reducesToOrigin_of_originParam_eq W _ _ _ _
      hspec.1 P.2.1.choose_spec hpar).1
  right_inv π := by
    apply Subtype.ext
    rw [fwd_val]
    have hred : ReducesToOrigin (bwd W G q Q g h₁ h₂ π).1 (h₂ π.1 π.2).choose_spec.choose (maximalIdeal T) :=
      (h₂ π.1 π.2).choose_spec.choose_spec.1
    rw [param_eq W _ _ _ hred]
    exact (h₂ π.1 π.2).choose_spec.choose_spec.2

theorem rootEquiv_apply (P : PartnerSet W G q Q)
    (χ : OriginChartRing W →+* T) (hχ : ReducesToOrigin P.1 χ (maximalIdeal T)) :
    (rootEquiv W G q Q g h₁ h₂ P).1 = originParam χ := by
  show param W P.1 P.2.1 = originParam χ
  exact param_eq W P.1 P.2.1 χ hχ

theorem rootEquiv_symm_apply_val (π : RootSet g) :
    ((rootEquiv W G q Q g h₁ h₂).symm π).1 = (h₂ π.1 π.2).choose := rfl

end RootEquiv

section Misc

theorem natCast_mem_maximalIdeal {T : Type} [CommRing T] [IsLocalRing T] {k : Type} [Field k] (q : ℕ) [CharP k q]
    (resT : T →+* k) (hker : RingHom.ker resT = maximalIdeal T) : (q : T) ∈ maximalIdeal T := by
  rw [← hker, RingHom.mem_ker, map_natCast, CharP.cast_eq_zero]

theorem map_mem_maximalIdeal {S T : Type} [CommRing S] [IsLocalRing S] [CommRing T] [IsLocalRing T] {k : Type} [Field k]
    (resS : S →+* k) (hkerS : RingHom.ker resS = maximalIdeal S)
    (resT : T →+* k) (hkerT : RingHom.ker resT = maximalIdeal T)
    (Φ : S →+* T) (hΦ : ∀ s, resT (Φ s) = resS s) {s : S} (hs : s ∈ maximalIdeal S) : Φ s ∈ maximalIdeal T := by
  rw [← hkerT, RingHom.mem_ker, hΦ, ← RingHom.mem_ker, hkerS]
  exact hs

theorem distinguished_map {S T : Type} [CommRing S] [IsLocalRing S] [CommRing T] [IsLocalRing T] [Nontrivial T]
    (Φ : S →+* T) (hΦ : ∀ s ∈ maximalIdeal S, Φ s ∈ maximalIdeal T)
    (q : ℕ) (g : S[X]) (hgm : g.Monic) (hgdeg : g.natDegree = q - 1) (hgcoeff : ∀ i < q - 1, g.coeff i ∈ maximalIdeal S)
    (v : PowerSeries S) (hv : IsUnit v) :
    (g.map Φ).Monic ∧ (g.map Φ).natDegree = q - 1 ∧ (∀ i < q - 1, (g.map Φ).coeff i ∈ maximalIdeal T) ∧
      IsUnit (PowerSeries.map Φ v) := by
  refine ⟨hgm.map Φ, ?_, ?_, hv.map _⟩
  · rw [hgm.natDegree_map, hgdeg]
  · intro i hi
    rw [Polynomial.coeff_map]
    exact hΦ _ (hgcoeff i hi)

end Misc

section NatKey

theorem isCoefficientHom_comp {B T T' : Type} [CommRing B] [CommRing T] [CommRing T']
    (W : WeierstrassCurve.Projective B) (ψ : B →+* T) (f : T →+* T')
    (φc : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map ψ))
    (φf : projModelGradingCR (W.map ψ) →+*ᵍ projModelGradingCR ((W.map ψ).map f))
    (hc : IsCoefficientHom W ψ φc) (hf : IsCoefficientHom (W.map ψ) f φf) :
    IsCoefficientHom W (f.comp ψ) (φf.comp φc) := by
  refine ⟨fun a => ?_, fun i => ?_⟩
  · show φf (φc (cls W (MvPolynomial.C a))) = _
    rw [hc.1 a, hf.1 (ψ a)]
    rfl
  · show φf (φc (cls W (MvPolynomial.X i))) = _
    rw [hc.2 i, hf.2 i]
    rfl

theorem originParam_eq_map_originParam {B T T' : Type} [CommRing B] [CommRing T] [CommRing T']
    [IsLocalRing T'] [IsAdicComplete (maximalIdeal T') T']
    (W : WeierstrassCurve.Projective B) (ψ : B →+* T) (f : T →+* T')
    (IT : Ideal T) (hI : IT.map f ≤ maximalIdeal T')
    (Pm : base (T := T) ⟶ projModelCR W)
    (Psec : Section (W.map ψ)) (χ : OriginChartRing (W.map ψ) →+* T) (hχ : ReducesToOrigin Psec χ IT)
    (hlift : ∀ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map ψ))
      (hφ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map ψ)) ≤ (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
      IsCoefficientHom W ψ φ → Psec.1 ≫ Proj.map φ hφ = Pm)
    (Psec' : Section ((W.map ψ).map f)) (χ' : OriginChartRing ((W.map ψ).map f) →+* T')
    (hχ' : ReducesToOrigin Psec' χ' (maximalIdeal T'))
    (hlift' : ∀ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR ((W.map ψ).map f))
      (hφ : HomogeneousIdeal.irrelevant (projModelGradingCR ((W.map ψ).map f)) ≤
        (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
      IsCoefficientHom W (f.comp ψ) φ → Psec'.1 ≫ Proj.map φ hφ = Spec.map (CommRingCat.ofHom f) ≫ Pm) :
    originParam χ' = f (originParam χ) := by
  obtain ⟨φc, hφc, hcoefc⟩ := WeierstrassProjModel.exists_isCoefficientHom W ψ
  obtain ⟨φf, hφf, hcoeff⟩ := WeierstrassProjModel.exists_isCoefficientHom (W.map ψ) f
  have hcomp : IsCoefficientHom W (f.comp ψ) (φf.comp φc) := isCoefficientHom_comp W ψ f φc φf hcoefc hcoeff
  have h1 : Psec'.1 ≫ Proj.map (φf.comp φc) (HomogeneousIdeal.irrelevant_le_map_comp hφc hφf) =
      Spec.map (CommRingCat.ofHom f) ≫ Pm := hlift' _ _ hcomp
  have hsq := WeierstrassCurve.DrinfeldGlobal.isPullback_projMap_of_isCoefficientHom W ψ φc hφc hcoefc
  have hsqf := WeierstrassCurve.DrinfeldGlobal.isPullback_projMap_of_isCoefficientHom (W.map ψ) f φf hφf hcoeff
  have hP' : Psec'.1 ≫ Proj.map φf hφf = Spec.map (CommRingCat.ofHom f) ≫ Psec.1 := by
    apply hsq.hom_ext
    · have e1 : (Psec'.1 ≫ Proj.map φf hφf) ≫ Proj.map φc hφc =
          Psec'.1 ≫ Proj.map (φf.comp φc) (HomogeneousIdeal.irrelevant_le_map_comp hφc hφf) := by
        rw [Proj.map_comp φc φf hφc hφf, Category.assoc]
      rw [e1, h1, Category.assoc, hlift φc hφc hcoefc]
    · rw [Category.assoc, hsqf.w, ← Category.assoc, Psec'.2, Category.id_comp, Category.assoc, Psec.2,
        Category.comp_id]
  obtain ⟨χ'', hred'', hpar'', -⟩ :=
    WeierstrassCurve.DrinfeldGlobal.exists_reducesToOrigin_map_originParam_eq_of_isCoefficientHom
      (W.map ψ) f φf hφf hcoeff Psec χ IT hχ Psec' hP'
  have hred''' : ReducesToOrigin Psec' χ'' (maximalIdeal T') := by
    obtain ⟨h1, h2, h3⟩ := hred''
    exact ⟨h1, hI h2, hI h3⟩
  have heq : χ'' = χ' := chart_unique _ Psec' χ'' χ' hred''' hχ'
  rw [← heq, hpar'']

end NatKey

end H1cAsm

theorem solution
    (q : ℕ) [Fact q.Prime] (ℓ M' : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) [NeZero M']
    (A₀ : Type) [CommRing A₀]

    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : GroupLaws A₀) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (𝒯 : LevelTransport A₀ 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    (P₀ : LevelModuliPackageAbs A₀ (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum)
    (R : Type) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R]
    [Algebra A₀ R] (ι : P₀.B₀ →ₐ[A₀] R)
    (k : Type) [Field k] [CharP k q] (hℓk : ((ℓ : ℕ) : k) ≠ 0) (hM'k : ((M' : ℕ) : k) ≠ 0)
    (resR : R →+* k) (hresR : Function.Surjective resR) (hkerR : RingHom.ker resR = maximalIdeal R)
