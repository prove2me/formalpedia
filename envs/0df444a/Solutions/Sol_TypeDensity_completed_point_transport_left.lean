  obtain ⟨φ, hφ⟩ := TypeDensity.overlap_prime_localization_left R t x Q
  have : IsNoetherianRing (TypeDensity.BlowupOverlap R t x) :=
    IsLocalization.isNoetherianRing (Submonoid.powers (TypeDensity.chartSlope R t x)) _ inferInstance
  have : IsNoetherianRing (Localization.AtPrime Q) :=
