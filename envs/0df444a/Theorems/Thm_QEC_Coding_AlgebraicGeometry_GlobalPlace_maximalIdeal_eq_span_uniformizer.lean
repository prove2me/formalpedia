theorem QEC.Coding.AlgebraicGeometry.GlobalPlace.maximalIdeal_eq_span_uniformizer (P : GlobalPlace k F) :
    IsLocalRing.maximalIdeal P.valuationRing =
      Ideal.span ({P.uniformizerInValuationRing} : Set P.valuationRing) := by sorry
