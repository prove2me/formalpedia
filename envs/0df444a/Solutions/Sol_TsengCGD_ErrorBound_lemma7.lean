open LuoTseng.ErrorBound in
theorem L7c_comp : ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E]
    (F : Type) [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (m : ℕ) (a : Fin m → E) (b : Fin m → ℝ) (L : E →L[ℝ] F) (q : E) (g : F → ℝ)
    (μ : ℝ) (Lg : NNReal),
    0 < μ → StrongConvexOn Set.univ μ g → Differentiable ℝ g → LipschitzWith Lg (gradient g) →
    (solSet (poly a b) (gradient (fun z => g (L z) + ⟪q, z⟫))).Nonempty →
    ∀ ζ : ℝ, ∃ τ > 0, ∃ ε > 0, ∀ z w : E, z ∈ poly a b → g (L z) + ⟪q, z⟫ ≤ ζ →
      IsProjRes (poly a b) (gradient (fun z => g (L z) + ⟪q, z⟫)) z w → ‖w - z‖ ≤ ε →
        Metric.infDist z (solSet (poly a b) (gradient (fun z => g (L z) + ⟪q, z⟫))) ≤
          τ * ‖w - z‖ := by
  intro E _ _ _ F _ _ _ m a b L q g μ Lg hμ hsc hdiff hlip hne ζ
  have hgg : ∀ t, HasGradientAt g (gradient g t) t := fun t => (hdiff t).hasGradientAt
  have hG : ∀ z, gradient (fun z => g (L z) + ⟪q, z⟫) z =
      ContinuousLinearMap.adjoint L (gradient g (L z)) + q := by
    intro z
    refine HasGradientAt.gradient ?_
    rw [hasGradientAt_iff_hasFDerivAt]
    have h1 := ((hdiff (L z)).hasFDerivAt.comp z L.hasFDerivAt).add (innerSL ℝ q).hasFDerivAt
    refine h1.congr_fderiv ?_
    ext v
    have h2 := (hasGradientAt_iff_hasFDerivAt.mp (hgg (L z)))
    rw [h2.fderiv]
    simp [inner_add_left, ContinuousLinearMap.adjoint_inner_left]
  have hGi : ∀ z v, ⟪gradient (fun z => g (L z) + ⟪q, z⟫) z, v⟫ =
      ⟪gradient g (L z), L v⟫ + ⟪q, v⟫ := by
    intro z v
    rw [hG, inner_add_left, ContinuousLinearMap.adjoint_inner_left]
  have hmono : ∀ s t : F, μ * ‖s - t‖ ^ 2 ≤ ⟪gradient g s - gradient g t, s - t⟫ := by
    intro s t
    have e1 := CompAux.ca_lower_sc hgg hsc s t
    have e2 := CompAux.ca_lower_sc hgg hsc t s
    rw [norm_sub_rev t s] at e1
    simp only [inner_sub_left, inner_sub_right] at e1 e2 ⊢
    linarith
  set S := solSet (poly a b) (gradient (fun z => g (L z) + ⟪q, z⟫)) with hSdef
  obtain ⟨zb, hzb⟩ := hne
  have hS : S = {y : E | (∀ i, ⟪a i, y⟫ ≤ b i) ∧ L y = L zb ∧ ⟪q, y⟫ = ⟪q, zb⟫} := by
    ext y
    constructor
    · rintro ⟨hyZ, hyvi⟩
      have e1 := hyvi zb hzb.1
      have e2 := hzb.2 y hyZ
      rw [hGi] at e1 e2
      simp only [map_sub, inner_sub_right] at e1 e2
      have hm := hmono (L y) (L zb)
      simp only [inner_sub_left, inner_sub_right] at hm
      have h0 : ‖L y - L zb‖ ^ 2 = 0 :=
        le_antisymm (by nlinarith [sq_nonneg ‖L y - L zb‖]) (sq_nonneg _)
      have hL : L y = L zb := sub_eq_zero.1 (norm_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h0))
      refine ⟨hyZ, hL, ?_⟩
      rw [hL] at e1 e2
      linarith
    · rintro ⟨hyZ, hLy, hqy⟩
      refine ⟨hyZ, fun v hv => ?_⟩
      have e := hzb.2 v hv
      rw [hGi] at e ⊢
      simp only [map_sub, inner_sub_right] at e ⊢
      rw [hLy, hqy]
      linarith
  have hneS : S.Nonempty := ⟨zb, hzb⟩
  obtain ⟨C, hC, hH⟩ := CompAux.polyAff a b L q (L zb) ⟪q, zb⟫
  set Z0 := ζ - (g (L zb) + ⟪q, zb⟫) with hZ0
  set Γ := ‖gradient g (L zb)‖ + (Lg : ℝ) * (1 + |2 * Z0 / μ|) with hΓ
  have hΓ0 : 0 ≤ Γ := by positivity
  set ℓ := ‖L‖ with hℓ
  set D1 := 2 * C * (1 + Γ) with hD1
  have hD10 : 0 ≤ D1 := by positivity
  set α := (Lg : ℝ) * ℓ + D1 with hα
  set β := D1 * ℓ with hβ
  have hα0 : 0 ≤ α := by positivity
  have hβ0 : 0 ≤ β := by positivity
  set K := (α + β) / μ + 1 with hK
  have hμK : μ * K = α + β + μ := by rw [hK]; field_simp
  have hK1 : 1 ≤ K := by have : 0 ≤ (α + β) / μ := by positivity
                         linarith
  refine ⟨1 + D1 * (K + ℓ), by positivity, 1 / (2 * C), by positivity,
    fun z w hz hlev hproj hr => ?_⟩
  obtain ⟨hw, hvi⟩ := hproj
  set ρ := ‖w - z‖ with hρ
  have hρ0 : 0 ≤ ρ := norm_nonneg _
  have hCρ : C * ρ ≤ 1 / 2 := by
    have := mul_le_mul_of_nonneg_left hr hC.le
    rw [show C * (1 / (2 * C)) = 1 / 2 by field_simp] at this
    exact this
  set x := ‖L z - L zb‖ with hx
  have hx0 : 0 ≤ x := norm_nonneg _
  -- level set
  have hlevx : μ / 2 * x ^ 2 ≤ Z0 := by
    have e := hzb.2 z hz
    rw [hGi] at e
    have ls := CompAux.ca_lower_sc hgg hsc (L zb) (L z)
    simp only [map_sub, inner_sub_right] at e ls
    rw [hZ0]
    linarith
  have hgz : ‖gradient g (L z)‖ ≤ Γ := by
    have h1 : ‖gradient g (L z) - gradient g (L zb)‖ ≤ Lg * x := hlip.norm_sub_le _ _
    have h2 : ‖gradient g (L z)‖ ≤ ‖gradient g (L zb)‖ + Lg * x := by
      have := norm_le_insert' (gradient g (L z)) (gradient g (L zb))
      linarith
    have h3 : x ≤ 1 + |2 * Z0 / μ| := by
      have h4 : x ^ 2 ≤ 2 * Z0 / μ := by
        rw [le_div_iff₀ hμ]; linarith
      have h5 := le_abs_self (2 * Z0 / μ)
      nlinarith [sq_nonneg (x - 1)]
    have h6 : (Lg : ℝ) * x ≤ Lg * (1 + |2 * Z0 / μ|) :=
      mul_le_mul_of_nonneg_left h3 (NNReal.coe_nonneg Lg)
    rw [hΓ]; linarith
  have hgzb : ‖gradient g (L zb)‖ ≤ Γ := by
    rw [hΓ]; have : 0 ≤ (Lg : ℝ) * (1 + |2 * Z0 / μ|) := by positivity
    linarith
  -- u = L w - L zb, σ = ⟪q, w⟫ - ⟪q, zb⟫
  have hu : ‖L w - L zb‖ ≤ x + ℓ * ρ := by
    have e : L w - L zb = (L z - L zb) + L (w - z) := by rw [map_sub]; abel
    rw [e]
    refine (norm_add_le _ _).trans ?_
    have := L.le_opNorm (w - z)
    linarith
  have key : ∀ y ∈ S, |⟪q, w⟫ - ⟪q, zb⟫| ≤ Γ * ‖L w - L zb‖ + ρ * ‖y - w‖ ∧
      μ * x ^ 2 ≤ (Lg : ℝ) * ℓ * ρ * x + ρ * ‖y - w‖ := by
    intro y hy
    have hySol := hy
    rw [hS] at hy
    obtain ⟨hyZ, hLy, hqy⟩ := hy
    have hP := hvi y hyZ
    have hV := hySol.2 w hw
    have eP : z - gradient (fun z => g (L z) + ⟪q, z⟫) z - w =
        (z - w) - gradient (fun z => g (L z) + ⟪q, z⟫) z := by abel
    rw [eP, inner_sub_left, hGi] at hP
    rw [hGi] at hV
    have c5 := abs_real_inner_le_norm (z - w) (y - w)
    have c1' : ‖z - w‖ = ρ := norm_sub_rev z w
    rw [c1'] at c5
    set P3 := ⟪z - w, y - w⟫ with hP3
    simp only [map_sub, inner_sub_right, hLy, hqy] at hP hV
    have c2 := abs_real_inner_le_norm (gradient g (L z)) (L w - L zb)
    have c3 := abs_real_inner_le_norm (gradient g (L zb)) (L w - L zb)
    rw [inner_sub_right] at c2 c3
    have hun := norm_nonneg (L w - L zb)
    have g1 : ‖gradient g (L z)‖ * ‖L w - L zb‖ ≤ Γ * ‖L w - L zb‖ :=
      mul_le_mul_of_nonneg_right hgz hun
    have g2 : ‖gradient g (L zb)‖ * ‖L w - L zb‖ ≤ Γ * ‖L w - L zb‖ :=
      mul_le_mul_of_nonneg_right hgzb hun
    have hyw : 0 ≤ ρ * ‖y - w‖ := mul_nonneg hρ0 (norm_nonneg _)
    have c5' := (abs_le.1 c5).1
    refine ⟨abs_le.2 ⟨?_, ?_⟩, ?_⟩
    · have := (abs_le.1 c3).2
      linarith
    · have := (abs_le.1 c2).1
      linarith
    · have hm := hmono (L z) (L zb)
      have eM : L z - L zb = (L w - L zb) - L (w - z) := by rw [map_sub]; abel
      have i1 : ⟪gradient g (L z) - gradient g (L zb), L z - L zb⟫ =
          (⟪gradient g (L z), L w⟫ - ⟪gradient g (L z), L zb⟫) -
          (⟪gradient g (L zb), L w⟫ - ⟪gradient g (L zb), L zb⟫) -
          ⟪gradient g (L z) - gradient g (L zb), L (w - z)⟫ := by
        rw [eM, inner_sub_right, inner_sub_right, inner_sub_left, inner_sub_left]; ring
      have i2 := neg_abs_le ⟪gradient g (L z) - gradient g (L zb), L (w - z)⟫
      have i3 := abs_real_inner_le_norm (gradient g (L z) - gradient g (L zb)) (L (w - z))
      have c7 : ‖gradient g (L z) - gradient g (L zb)‖ ≤ Lg * x := hlip.norm_sub_le _ _
      have c8 : ‖L (w - z)‖ ≤ ℓ * ρ := L.le_opNorm _
      have c9 : ‖gradient g (L z) - gradient g (L zb)‖ * ‖L (w - z)‖ ≤ (Lg * x) * (ℓ * ρ) :=
        mul_le_mul c7 c8 (norm_nonneg _) (by positivity)
      linarith
  set δ := Metric.infDist w S with hδ
  have hδ0 : 0 ≤ δ := Metric.infDist_nonneg
  have approx : ∀ η > 0, ∃ y ∈ S, ‖y - w‖ < δ + η := by
    intro η hη
    obtain ⟨y, hy, hyd⟩ := (Metric.infDist_lt_iff hneS).1 (show δ < δ + η by linarith)
    refine ⟨y, hy, ?_⟩
    rw [dist_eq_norm, norm_sub_rev] at hyd
    exact hyd
  have kσ : |⟪q, w⟫ - ⟪q, zb⟫| ≤ Γ * ‖L w - L zb‖ + ρ * δ :=
    CompAux.inf_lim hρ0 fun η hη => by
      obtain ⟨y, hy, hyd⟩ := approx η hη
      exact ⟨‖y - w‖, hyd, (key y hy).1⟩
  have kx : μ * x ^ 2 ≤ (Lg : ℝ) * ℓ * ρ * x + ρ * δ :=
    CompAux.inf_lim hρ0 fun η hη => by
      obtain ⟨y, hy, hyd⟩ := approx η hη
      exact ⟨‖y - w‖, hyd, (key y hy).2⟩
  have hHw : δ ≤ C * (‖L w - L zb‖ + |⟪q, w⟫ - ⟪q, zb⟫|) := by
    rw [hδ, hS]
    exact hH w hw (by rw [← hS]; exact hneS)
  have hδb : δ ≤ D1 * ‖L w - L zb‖ := by
    have h1 : C * (‖L w - L zb‖ + |⟪q, w⟫ - ⟪q, zb⟫|) ≤
        C * (‖L w - L zb‖ + (Γ * ‖L w - L zb‖ + ρ * δ)) := by gcongr
    have h2 : C * ρ * δ ≤ 1 / 2 * δ := mul_le_mul_of_nonneg_right hCρ hδ0
    have h3 : C * (‖L w - L zb‖ + (Γ * ‖L w - L zb‖ + ρ * δ)) =
        C * (1 + Γ) * ‖L w - L zb‖ + C * ρ * δ := by ring
    rw [hD1]
    linarith
  have hkx2 : μ * x ^ 2 ≤ α * ρ * x + β * ρ ^ 2 := by
    have h1 : ρ * δ ≤ ρ * (D1 * (x + ℓ * ρ)) :=
      mul_le_mul_of_nonneg_left (hδb.trans (mul_le_mul_of_nonneg_left hu hD10)) hρ0
    have h2 : α * ρ * x + β * ρ ^ 2 = (Lg : ℝ) * ℓ * ρ * x + ρ * (D1 * (x + ℓ * ρ)) := by
      rw [hα, hβ]; ring
    linarith
  have hxK : x ≤ K * ρ := by
    by_contra hcon
    push Not at hcon
    have hKρ : 0 ≤ K * ρ := by positivity
    have hxpos : 0 < x := lt_of_le_of_lt hKρ hcon
    have hρx : ρ ≤ x := le_trans (le_mul_of_one_le_left hρ0 hK1) hcon.le
    have e1 : μ * x * (K * ρ) < μ * x * x := mul_lt_mul_of_pos_left hcon (mul_pos hμ hxpos)
    have e1' : μ * x * (K * ρ) = (α + β + μ) * ρ * x := by
      rw [← hμK]; ring
    have e2 : β * ρ * ρ ≤ β * ρ * x := mul_le_mul_of_nonneg_left hρx (mul_nonneg hβ0 hρ0)
    have e3 : 0 ≤ μ * ρ * x := by positivity
    nlinarith
  have hfin : δ ≤ D1 * (x + ℓ * ρ) := hδb.trans (mul_le_mul_of_nonneg_left hu hD10)
  have hfin2 : D1 * (x + ℓ * ρ) ≤ D1 * (K * ρ + ℓ * ρ) := by gcongr
  calc Metric.infDist z S ≤ Metric.infDist w S + dist z w := Metric.infDist_le_infDist_add_dist
    _ = δ + ρ := by rw [hδ, hρ, dist_eq_norm, norm_sub_rev]
    _ ≤ (1 + D1 * (K + ℓ)) * ρ := by nlinarith


set_option maxHeartbeats 1000000 in
open LuoTseng.ErrorBound in
theorem L7c_dual : ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E]
    (F : Type) [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    (m r : ℕ) (a : Fin m → E) (b : Fin m → ℝ) (ay : Fin r → F) (by' : Fin r → ℝ)
    (L : E →L[ℝ] F) (q : E) (g : F → ℝ) (μ : ℝ) (Lg : NNReal) (h : E → ℝ),
    0 < μ → StrongConvexOn Set.univ μ g → Differentiable ℝ g → LipschitzWith Lg (gradient g) →
    (∀ z, IsGreatest {v | ∃ y ∈ poly ay by', v = ⟪L z, y⟫ - g y} (h z - ⟪q, z⟫)) →
    (solSet (poly a b) (gradient h)).Nonempty →
    ∀ ζ : ℝ, ∃ τ > 0, ∃ ε > 0, ∀ z w : E, z ∈ poly a b → h z ≤ ζ →
      IsProjRes (poly a b) (gradient h) z w → ‖w - z‖ ≤ ε →
        Metric.infDist z (solSet (poly a b) (gradient h)) ≤ τ * ‖w - z‖ := by
  intro E _ _ _ F _ _ _ m r a b ay by' L q g μ Lg h hμ hsc hdiff hlip hgr hne ζ
  classical
  have hgg : ∀ x, HasGradientAt g (gradient g x) x := fun x => (hdiff x).hasGradientAt
  have hcvx : ConvexOn ℝ Set.univ g := (hsc.strictConvexOn hμ).convexOn
  have hex : ∀ z, ∃ y, y ∈ poly ay by' ∧ h z - ⟪q, z⟫ = ⟪L z, y⟫ - g y := fun z => by
    obtain ⟨y, hy, he⟩ := (hgr z).1
    exact ⟨y, hy, he⟩
  choose yf hyY hyv using hex
  have hY : ∀ z, ∀ i, ⟪ay i, yf z⟫ ≤ by' i := fun z => hyY z
  have hmaxv : ∀ z y', (∀ i, ⟪ay i, y'⟫ ≤ by' i) → ⟪L z, y'⟫ - g y' ≤ h z - ⟪q, z⟫ :=
    fun z y' hy' => (hgr z).2 ⟨y', hy', rfl⟩
  have hmaxf : ∀ z y', (∀ i, ⟪ay i, y'⟫ ≤ by' i) →
      ⟪L z, y'⟫ - g y' ≤ ⟪L z, yf z⟫ - g (yf z) := by
    intro z y' hy'; rw [← hyv z]; exact hmaxv z y' hy'
  have hcoc : ∀ z z', μ / 2 * ‖yf z - yf z'‖ ^ 2 ≤ ⟪L z - L z', yf z - yf z'⟫ :=
    fun z z' => DualAux.cocoerc hsc (L z) (L z') (yf z) (yf z') (hY z) (hY z') (hmaxf z)
      (hmaxf z')
  have hlipy : ∀ z z', ‖yf z' - yf z‖ ≤ (2 / μ) * ‖L z' - L z‖ := by
    intro z z'
    have e := hcoc z' z
    have c := real_inner_le_norm (L z' - L z) (yf z' - yf z)
    have hx0 : 0 ≤ ‖yf z' - yf z‖ := norm_nonneg _
    have h2 : μ / 2 * ‖yf z' - yf z‖ ≤ ‖L z' - L z‖ := by
      rcases hx0.lt_or_eq with hx | hx
      · have h1 : μ / 2 * ‖yf z' - yf z‖ * ‖yf z' - yf z‖ ≤
            ‖L z' - L z‖ * ‖yf z' - yf z‖ := by nlinarith
        exact le_of_mul_le_mul_right h1 hx
      · rw [← hx]; simp
    rw [div_mul_eq_mul_div, le_div_iff₀ hμ]
    nlinarith
  have hgrad : ∀ z, gradient h z = ContinuousLinearMap.adjoint L (yf z) + q := fun z =>
    (DualAux.danskin L q h g yf (2 / μ) (by positivity) hyv
      (fun z z' => hmaxv z (yf z') (hY z')) hlipy z).gradient
  have hGi : ∀ z v, ⟪gradient h z, v⟫ = ⟪L v, yf z⟫ + ⟪q, v⟫ := by
    intro z v
    rw [hgrad, inner_add_left, ContinuousLinearMap.adjoint_inner_left,
      real_inner_comm (L v) (yf z)]
  set S := solSet (poly a b) (gradient h) with hSdef
  obtain ⟨zb, hzb⟩ := hne
  obtain ⟨yb, hyb⟩ : ∃ yb, yf zb = yb := ⟨_, rfl⟩
  have hYb : ∀ i, ⟪ay i, yb⟫ ≤ by' i := by rw [← hyb]; exact hY zb
  have hpin : ∀ z ∈ S, yf z = yb := by
    intro z hz
    have e1 := hz.2 zb hzb.1
    have e2 := hzb.2 z hz.1
    rw [hGi] at e1 e2
    have hc := hcoc z zb
    rw [hyb] at e2 hc
    simp only [map_sub, inner_sub_right, inner_sub_left] at e1 e2 hc
    have h0 : ‖yf z - yb‖ ^ 2 = 0 :=
      le_antisymm (by nlinarith [sq_nonneg ‖yf z - yb‖]) (sq_nonneg _)
    exact sub_eq_zero.1 (norm_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h0))
  obtain ⟨Gb, hGbdef⟩ : ∃ G : E, G = ContinuousLinearMap.adjoint L yb + q := ⟨_, rfl⟩
  have hGb' : ∀ v, ⟪Gb, v⟫ = ⟪L v, yb⟫ + ⟪q, v⟫ := by
    intro v
    rw [hGbdef, inner_add_left, ContinuousLinearMap.adjoint_inner_left, real_inner_comm (L v) yb]
  have hgS : ∀ z ∈ S, gradient h z = Gb := fun z hz => by rw [hgrad, hpin z hz, hGbdef]
  obtain ⟨sb, hsbdef⟩ : ∃ s : ℝ, s = ⟪Gb, zb⟫ := ⟨_, rfl⟩
  have hsS : ∀ z ∈ S, ⟪Gb, z⟫ = sb := by
    intro z hz
    have e1 := hz.2 zb hzb.1
    have e2 := hzb.2 z hz.1
    rw [hgS z hz] at e1
    rw [hgS zb hzb] at e2
    rw [inner_sub_right] at e1 e2
    rw [hsbdef]; linarith
  have hviB : ∀ z ∈ S, ∀ y', (∀ i, ⟪ay i, y'⟫ ≤ by' i) →
      ⟪L z - gradient g yb, y' - yb⟫ ≤ 0 := by
    intro z hz y' hy'
    have hm : ∀ y'', (∀ i, ⟪ay i, y''⟫ ≤ by' i) → ⟪L z, y''⟫ - g y'' ≤ ⟪L z, yb⟫ - g yb := by
      intro y'' hy''; have := hmaxf z y'' hy''; rwa [hpin z hz] at this
    exact DualAux.vi_of_max hμ hsc hdiff hlip (L z) yb hYb hm y' hy'
