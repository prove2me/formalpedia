namespace AlgebraicCurve

theorem mem_repartitionsOf_iff_coe_mem_adeleBdd {K F : Type*} [Field K] [Field F] [Algebra K F] {D : Divisor K F} {α : ↥(repartitions K F)} :
    α ∈ repartitionsOf D ↔ (α : Place K F → F) ∈ adeleBdd D := by sorry
