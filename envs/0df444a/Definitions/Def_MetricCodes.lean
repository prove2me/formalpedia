def poleAngle (N i : ℕ) : ℝ :=
  (((2 * i + 1 : ℕ) : ℝ) * Real.pi) / (2 * (N : ℝ))
def zeroAngle (N j : ℕ) : ℝ :=
  ((j : ℝ) * Real.pi) / (N : ℝ)
