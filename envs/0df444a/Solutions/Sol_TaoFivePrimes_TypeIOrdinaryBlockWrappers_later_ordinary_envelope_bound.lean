  have hvarConst :
      (∑ d ∈ laterOddDivisors q k,
        safeCap (ordinaryDivisorCap x (d : ℝ))
          (ordinaryReciprocalBudget x)
          (Real.pi * gamma * (d : ℝ))) ≤
      ∑ d ∈ laterOddDivisors q k,
        safeCap A (ordinaryReciprocalBudget x)
          (Real.pi * gamma * (d : ℝ)) := by
    apply Finset.sum_le_sum
    intro d hd
    have hdLower : laterBlockLower q k < (d : ℝ) :=
      (Finset.mem_filter.mp hd).2.1
    have hdpos : (0 : ℝ) < (d : ℝ) := hLower.trans hdLower
    apply safeCap_mono_cap
    unfold ordinaryDivisorCap
    dsimp [A]
    have hdiv : x / (d : ℝ) ≤ x / laterBlockLower q k := by
      exact div_le_div_of_nonneg_left hx0 hLower hdLower.le
    have hhalfDiv :
        (1 / 2 : ℝ) * (x / (d : ℝ)) ≤
          (1 / 2 : ℝ) * (x / laterBlockLower q k) :=
      mul_le_mul_of_nonneg_left hdiv (by norm_num)
