-- title:
--   Independence of evaluation sigma-algebras on disjoint regions
-- statement:
--   For a Poisson point family with σ-finite intensity, the σ-algebras generated by all finite-intensity count evaluations in two disjoint regions are independent.
-- source:
--   Inspired by Shmuel Link, LeanLevy (MIT), commit 7e73fd9b23ad52956ec2756a815889a783131ce4. Independently formulated Prove2Me draft; remote elaboration and proof pending. PoissonFiltration.lean lines 421–430.

import Mathlib.Probability.Independence.Basic
import Definitions.Def_levy_foundations_isPoissonPointFamily
import Definitions.Def_levy_foundations_prmEvalSigma

open MeasureTheory ProbabilityTheory

theorem levy_foundations_prmIndepEvalSigma
    {Ω E : Type} [MeasurableSpace Ω] [MeasurableSpace E]
    [Nonempty E] (m : Measure E) [SigmaFinite m]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (K : ℕ → Ω → ℕ) (X : ℕ → ℕ → Ω → E)
    (hd : LevyFoundations.IsPoissonPointFamily K X m μ)
    {R S : Set E} (hRS : Disjoint R S) :
    Indep (LevyFoundations.prmEvalSigma K X m R)
      (LevyFoundations.prmEvalSigma K X m S) μ := by sorry
