/-!
# Naimark reduction for Pauli-test strategies

An arbitrary Pauli-test strategy is dilated questionwise to a projective
strategy on two separately enlarged local spaces. The ground-slice embeddings
are fixed across questions. Compression recovers both original POVM families,
including the complete Pauli-answer postprocessing. Composing any isometry
witness on the dilation with the embeddings returns its state comparison to
the original spaces. Operator-family distance transfer is not asserted here.

## References

Paper `references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:1426-1447`
(`thm:pauli`) and
`references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:160-190,1862-1876`.
Blueprint `thm:pauli-naimark-reduction-support`.
-/

@[expose] public section

namespace MIPStarRE.QPBT

open LIDT.MIPStarRE.Quantum MagicSquareRigidity

noncomputable section

/-- The question-independent embedding of Alice's original space in the
ground slice of the completed Naimark dilation. -/
def pauliNaimarkEmbeddingA (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) :
    EuclideanSpace ℂ S.ιA →ₗᵢ[ℂ]
      EuclideanSpace ℂ (S.ιA × Option (_root_.MIPStarRE.QPBT.PauliAnswer P)) :=
  _root_.MIPStarRE.QPBT.MagicSquareRigidity.naimarkEmbedding S.ιA (_root_.MIPStarRE.QPBT.PauliAnswer P)

/-- The corresponding question-independent embedding of Bob's space. -/
def pauliNaimarkEmbeddingB (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) :
    EuclideanSpace ℂ S.ιB →ₗᵢ[ℂ]
      EuclideanSpace ℂ (S.ιB × Option (_root_.MIPStarRE.QPBT.PauliAnswer P)) :=
  _root_.MIPStarRE.QPBT.MagicSquareRigidity.naimarkEmbedding S.ιB (_root_.MIPStarRE.QPBT.PauliAnswer P)

/-- Complete the Naimark dilation separately for every question and both
players, padding the original bipartite state at the ground coordinates. -/
@[reducible] def pauliNaimarkStrategy (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P) :=
  _root_.MIPStarRE.QPBT.paddedStrategy S (none : Option (_root_.MIPStarRE.QPBT.PauliAnswer P)) (none : Option (_root_.MIPStarRE.QPBT.PauliAnswer P))
    (fun question => _root_.MIPStarRE.QPBT.dilatedMeasurement (default : _root_.MIPStarRE.QPBT.PauliAnswer P) (S.A question))
    (fun question => _root_.MIPStarRE.QPBT.dilatedMeasurement (default : _root_.MIPStarRE.QPBT.PauliAnswer P) (S.B question))

/-- Both local families of the dilated strategy are projective measurements. -/
theorem pauliNaimarkStrategy_isProjective (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) : (_root_.MIPStarRE.QPBT.pauliNaimarkStrategy P S).IsProjective :=
  _root_.MIPStarRE.QPBT.paddedStrategy_isProjective S none none _ _
    (fun question => _root_.MIPStarRE.QPBT.dilatedMeasurement_isProjective
      (default : _root_.MIPStarRE.QPBT.PauliAnswer P) (S.A question))
    (fun question => _root_.MIPStarRE.QPBT.dilatedMeasurement_isProjective
      (default : _root_.MIPStarRE.QPBT.PauliAnswer P) (S.B question))

/-- The two ground-slice compressions preserve the value of the game exactly. -/
theorem pauliNaimarkStrategy_value (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) : (_root_.MIPStarRE.QPBT.pauliNaimarkStrategy P S).value = S.value :=
  _root_.MIPStarRE.QPBT.paddedStrategy_value S none none _ _
    (fun question answer => _root_.MIPStarRE.QPBT.dilatedMeasurement_compression
      (default : _root_.MIPStarRE.QPBT.PauliAnswer P) answer (S.A question))
    (fun question answer => _root_.MIPStarRE.QPBT.dilatedMeasurement_compression
      (default : _root_.MIPStarRE.QPBT.PauliAnswer P) answer (S.B question))



/-- A winning strategy supplies a projective setting after dilation, with no
extra premise beyond the original winning inequality. -/
def pauliNaimarkSetting (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (epsilon : ℝ)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) (hwin : 1 - epsilon ≤ S.value) :
    _root_.MIPStarRE.QPBT.ProjectiveSetting P epsilon where
  toStrategy := _root_.MIPStarRE.QPBT.pauliNaimarkStrategy P S
  isProjective := _root_.MIPStarRE.QPBT.pauliNaimarkStrategy_isProjective P S
  win := by rw [_root_.MIPStarRE.QPBT.pauliNaimarkStrategy_value]; exact hwin









/-- Compose a witness on the dilated strategy with the ground embeddings,
keeping both auxiliary carrier spaces and the same normalized auxiliary state. -/
@[reducible] def pauliNaimarkWitness (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P (_root_.MIPStarRE.QPBT.pauliNaimarkStrategy P S)) :
    _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S where
  ιA' := w.ιA'
  ιB' := w.ιB'
  ιAFintype := w.ιAFintype
  ιBFintype := w.ιBFintype
  ιADecidableEq := w.ιADecidableEq
  ιBDecidableEq := w.ιBDecidableEq
  φA := w.φA.comp (_root_.MIPStarRE.QPBT.pauliNaimarkEmbeddingA P S)
  φB := w.φB.comp (_root_.MIPStarRE.QPBT.pauliNaimarkEmbeddingB P S)
  aux := w.aux
  aux_norm := w.aux_norm





end

