private theorem t1010 (κ : ℂ) {N : ℕ} (hN : N ≠ 0) (e : ℂ → ℂ)
    (he : ∀ A B : ℝ, ∃ M : ℝ, ∀ s : ℂ, A ≤ s.re → s.re ≤ B → (e s).re ≤ M) :
    LDatum.BoundedOnStrips fun s => κ * (N : ℂ) ^ e s := by
  intro A B
  obtain ⟨M, hM⟩ := he A B
  have hNpos : (0 : ℝ) < N := by exact_mod_cast Nat.pos_of_ne_zero hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hN
  refine ⟨‖κ‖ * (N : ℝ) ^ M, fun s ha hb => ?_⟩
  rw [norm_mul, Complex.norm_natCast_cpow_of_pos (Nat.pos_of_ne_zero hN)]
  exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hN1 (hM s ha hb)) (norm_nonneg κ)

private theorem t1011 {κ : ℂ} (hκ : κ ≠ 0) {N : ℕ} (hN : N ≠ 0)
    (e : ℂ → ℂ) (he : ∀ A B : ℝ, ∃ M : ℝ, ∀ s : ℂ, A ≤ s.re → s.re ≤ B → |(e s).re| ≤ M) (m : ℤ) :
    d117 fun s => (κ * (N : ℂ) ^ e s) ^ m := by
  have hy : d117 fun s => κ * (N : ℂ) ^ e s :=
    t0998 (t1010 κ hN e fun A B => by
      obtain ⟨M, hM⟩ := he A B
      exact ⟨M, fun s ha hb => (le_abs_self _).trans (hM s ha hb)⟩)
  have hyinv : d117 fun s => (κ * (N : ℂ) ^ e s)⁻¹ := by
    have h : (fun s : ℂ => (κ * (N : ℂ) ^ e s)⁻¹) = fun s => κ⁻¹ * (N : ℂ) ^ (-(e s)) := by
      funext s
      rw [mul_inv, Complex.cpow_neg]
    rw [h]
    exact t0998 (t1010 κ⁻¹ hN _ fun A B => by
      obtain ⟨M, hM⟩ := he A B
      refine ⟨M, fun s ha hb => ?_⟩
      rw [Complex.neg_re]
      linarith [(abs_le.1 (hM s ha hb)).1])
  obtain ⟨n, hn | hn⟩ := Int.eq_nat_or_neg m
  · subst hn
    simpa only [zpow_natCast] using t1007 hy n
  · subst hn
    simpa only [zpow_neg, zpow_natCast, inv_pow] using t1007 hyinv n

private theorem t1012 {x : ℝ} (hx : 0 < x) :
    LDatum.BoundedOnStrips fun s : ℂ => ((x : ℝ) : ℂ) ^ s := by
