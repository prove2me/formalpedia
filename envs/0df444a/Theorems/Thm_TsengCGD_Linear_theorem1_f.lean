-- title:
--   Theorem 1(f) — under (22) the Armijo stepsizes are bounded away from 0, and if $F_c(x^k)$ is bounded below then $\Delta^k \to 0$ and $d^k \to 0$
-- statement:
--   Consider problem (1) with its standing assumptions. Let $\{x^k\},\{d^k\},\{H^k\}$ be generated by the CGD method under Assumption 1 ($\bar\lambda I\succeq H^k\succeq\underline\lambda I$, $0<\underline\lambda\le\bar\lambda$), with $\{\alpha^k\}$ chosen by the Armijo rule (parameters $0<\beta<1$, $0<\sigma<1$, $0\le\gamma<1$) and $\inf_k\alpha^k_{\rm init}>0$. If $f$ satisfies (22) for some $L\ge0$, then
--   $$\inf_k\alpha^k>0.$$
--   If moreover $\lim_{k\to\infty}F_c(x^k)>-\infty$, then
--   $$\{\Delta^k\}\to0\quad\text{and}\quad\{d^k\}\to0,$$
--   where $\Delta^k=\nabla f(x^k)^Td^k+\gamma\,d^{kT}H^kd^k+cP(x^k+d^k)-cP(x^k)$ is (10).
--
--   This is the step of the global analysis that the linear convergence proof of Theorem 2(b) starts from: it makes the directions, and hence the residuals, vanish along the iterates.
--
--   **Formalization Note** "$\inf_k\alpha^k_{\rm init}>0$" and "$\inf_k\alpha^k>0$" are stated as the existence of a positive lower bound. Since $F_c(x^k)$ is nonincreasing (Theorem 1(a)), "$\lim F_c(x^k)>-\infty$" is stated as: the values $F_c(x^k)$ are bounded below. The Armijo rule picks the first $j$ with (9). Iteration indices start at $0$; coordinates are 0-based.
-- source:
--   Tseng and Yun, A coordinate gradient descent method for nonsmooth separable minimization, Math. Program. Ser. B 117 (2009), pp. 399–400, Theorem 1(f)

import Mathlib
import Definitions.Def_TsengCGD_Linear_Basic
open Filter Topology Finset Matrix
open scoped RealInnerProductSpace

namespace TsengCGD.Linear

theorem theorem1_f {n : ℕ} (f : TsengCGD.Global.Vec n → ℝ) (D : Set (TsengCGD.Global.Vec n)) (P : TsengCGD.Global.Vec n → ℝ) (c : ℝ)
    (hs : TsengCGD.Global.Standing f D P c) (J : ℕ → Finset (Fin n)) (H : ℕ → Matrix (Fin n) (Fin n) ℝ)
    (x d : ℕ → TsengCGD.Global.Vec n) (α : ℕ → ℝ) (hrun : TsengCGD.Global.IsCGDRun f D P c J H x d α)
    (lam lamBar : ℝ) (hA1 : TsengCGD.Global.Assumption1 H lam lamBar)
    (β σ γ : ℝ) (αinit : ℕ → ℝ) (harm : TsengCGD.Global.IsArmijo f D P c β σ γ αinit H x d α)
    (hinit : ∃ a > 0, ∀ k, a ≤ αinit k)
    (L : ℝ) (hL : GradLipOn f D L) :
    (∃ a > 0, ∀ k, a ≤ α k) ∧
      (BddBelow (Set.range fun k => TsengCGD.Global.Fc f P c (x k)) →
        Tendsto (fun k => TsengCGD.Global.Delta f P c γ (H k) (x k) (d k)) atTop (𝓝 0) ∧
          Tendsto d atTop (𝓝 0)) := by sorry

end TsengCGD.Linear
