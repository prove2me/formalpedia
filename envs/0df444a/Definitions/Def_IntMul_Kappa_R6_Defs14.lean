namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

/-! ## The layout conversion -/

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

/-! ## The prologue (from `p2U`) -/

def proU (pM : Fin P) (pS : Fin HS) : IStmt HS P :=
  .seq (volU pM pS) (.seq powL (.seq (divE rB rM tq) (.seq (mulC pM rCZ rB tq)
    (.seq (.op (.drop rB)) (.seq (.op (.mv tq rB)) (.seq (.op (.const tq 2)) (.seq (divE rB tq tq2)
    (.seq (.op (.dup nR rH)) (.seq (divE rH tq tq2) (.op (.drop tq)))))))))))

def cPro (n Z : ℕ) : ℕ := (n + 1) * (4 * cU Z) + 10 * cU Z

/-! ## Phase 2 -/

def p2E (pM : Fin P) (pS : Fin HS) (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (proU pM pS) (.seq (globU pM) (.seq (mainU eSw dS Dsc) (.seq gdropU
    (.seq (.op (.drop rB)) (.seq (.op (.drop rM)) (.op (.drop rH)))))))

/-- The cost of `p2E`. -/
noncomputable def cP2E (τ K : ℝ) (u n w Z c2 V : ℕ) : ℕ :=
  cPro n Z + 2 * cGlob n Z + cMain τ K (2 ^ u) u n w Z c2 V + 3 * cU Z

/-! ## The reversal -/

def revE (pM : Fin P) (pS : Fin HS) (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (p1U pM pS) (.seq (p2E pM pS eSw dS Dsc) (p3U pM pS))

/-- The cost of `revE`. -/
noncomputable def cRevE (τ K : ℝ) (u w cz cr : ℕ) (bs : List Bool) (Z : ℕ) : ℕ :=
  (bs.length + 1) * (2 * KFU.cMv (vol (shP u bs) * cz) w + 120 * cU Z) +
    cP2E τ K u bs.length w Z (vol (ctB u cz bs) * cr) (vol (shP u bs) * cz)

end Gen

end NLogN.KFUU.R6Crt

