open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (flatC)

/-- The common tear-down. -/
def dnCore (Cm : Fin HS) : RS :=
  .seq (.pop 37) (.seq (.pop 39) (.seq (.pop 40) (.seq (.rep Cm (.reg 38) (.seq (.pop 45) (.pop 45)))
    (.pop 38))))

/-- Tear-down of the passes 1, 3, 5. -/
def dn0 (Cm : Fin HS) : RS := dnCore Cm

/-- Tear-down of pass 7. -/
def dn7 (Cm : Fin HS) : RS := .seq (dnCore Cm) (.seq (.pop 41) (.pop 42))

