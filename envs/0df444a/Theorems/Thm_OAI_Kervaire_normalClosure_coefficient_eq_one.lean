theorem OAI.Kervaire.normalClosure_coefficient_eq_one {A : Type*} [Group A] (w : WordGroup A)
    (hw : Unimodular w) (g : A) (hg : Coprod.inl g ∈ relatorClosure w) : g=1 := by sorry
