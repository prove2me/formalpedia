/-- A double sum of an antisymmetric array vanishes. -/
theorem sum_sum_antisymm_eq_zero {T : Fin n → Fin n → ℝ} (hT : ∀ e f, T f e = -T e f) :
    ∑ e, ∑ f, T e f = 0 := by
  have h : ∑ e, ∑ f, T e f = -∑ e, ∑ f, T e f := by
    conv_lhs => rw [Finset.sum_comm]
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun e _ => hT _ _
  linarith

