section Expand

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

/-- The memory during the expansion loop: the packed payload below `S0`, `enc (eSeq 2i)` at `S0+2i`
for `i < t` (the read loop's output), `enc (eSeq (2i+1))` at `S0+2i+1` for `i < k`, and `0`
elsewhere. -/
noncomputable def expandMem {w : ℕ} (S0 : ℕ) (b : Module.Basis (Fin w) (ZMod 2) F) {M : ℕ}
    (y : Fin M → ZMod 2) (t k : ℕ) : ℕ → ℕ :=
  fun addr =>
    if addr < S0 then packMem (8 * w) y addr
    else if (addr - S0) % 2 = 0 then
      if (addr - S0) / 2 < t then syndromeInt w y ((addr - S0) / 2) else 0
    else if (addr - S0) / 2 < k then enc b (eSeq b y (2 * ((addr - S0) / 2) + 1)) else 0

/-- The loop-head state of the expansion loop after `k` iterations.  Its registers are exactly the
read loop's; only the memory differs. -/
noncomputable def expandState (base S0 w t : ℕ) (b : Module.Basis (Fin w) (ZMod 2) F)
    (y : Fin (t * w) → ZMod 2) (k : ℕ) : RAMState where
  pc := base
  regs := ![t, w, S0, 2 ^ w - 1, detSqBase w, k, 0, 0, 1, 0, 0, 0, 0, 0, 0, 8 * w]
  mem := expandMem S0 b y t k

/-- The body of the expansion loop. -/
def expandBody : List Instr :=
  addR r6 r2 r5 ++ ld r7 r6 ++ addR r9 r4 r7 ++ tbl r10 r9 ++ addR r11 r5 r5 ++
  addR r11 r11 r2 ++ addR r12 r11 r8 ++ st r12 r10 ++ addR r5 r5 r8 ++
  movI r6 0 ++ movI r7 0 ++ movI r9 0 ++ movI r10 0 ++ movI r11 0 ++ movI r12 0 ++ movI r14 0

/-- The expansion loop, placed at address `base`: while `j < t`, set `e[2j+1] = e[j]²`. -/
def expandLoopAt (base : ℕ) : List Instr := [iLt r14 r5 r0, iJz r14 (base + 19)] ++ expandBody ++ [iJmp base]

/-- The expansion loop as a statement. -/
abbrev expandLoopStmt : Stmt := Stmt.loop readCond (Stmt.code expandBody)

/-- The state at the entry of the expansion body. -/
noncomputable def expandBodyIn (base S0 w t : ℕ) (b : Module.Basis (Fin w) (ZMod 2) F)
    (y : Fin (t * w) → ZMod 2) (k : ℕ) : RAMState where
  pc := base + 2
  regs := Function.update (expandState base S0 w t b y k).regs r14 1
  mem := expandMem S0 b y t k

end Expand

