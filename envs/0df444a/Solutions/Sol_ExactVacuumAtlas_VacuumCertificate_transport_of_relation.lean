open scoped ContDiff
open Matrix
open ExactVacuumAtlas
theorem solution {U V : Set (Pt 4)} {Φ Ψ : Pt 4 → Pt 4}
    {J K : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ} {g gi h hi : Metric 4}
    (hcert : VacuumCertificate h hi V) (r : CoordRelation g h U V Φ Ψ J) (hU : IsOpen U)
    (hne : U.Nonempty) (hJK : ∀ y ∈ U, J y * K y = 1)
    (hgi : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) :
    VacuumCertificate g gi U := by
  have hc : CoordChange U V Φ J K :=
    { isOpen := hU
      isOpen_target := hcert.isOpen
      smooth := r.smooth
      mapsTo := r.bijOn.mapsTo
      jacobian := r.jacobian
      mul_inv := hJK }
  have hg : ∀ y ∈ U, metricMatrix g y = (J y)ᵀ * metricMatrix h (Φ y) * J y :=
    fun y hy => (r.pullback y hy).symm
  -- the transported inverse is a left inverse of `g`, hence equals `gi`
  have hm := MetricData.transport (gi := fun i j y => (K y * metricMatrix hi (Φ y) * (K y)ᵀ) i j)
    hc hcert.toMetricData hg (fun y _ => by ext i j; rfl)
  have hgi' : ∀ y ∈ U, metricMatrix gi y = K y * metricMatrix hi (Φ y) * (K y)ᵀ := by
    intro y hy
    have h2 := hm.inv y hy
    have e : metricMatrix (fun i j y => (K y * metricMatrix hi (Φ y) * (K y)ᵀ) i j) y
        = K y * metricMatrix hi (Φ y) * (K y)ᵀ := by ext i j; rfl
    rw [e] at h2
    exact left_inverse_unique (hgi y hy) h2
  exact VacuumCertificate.transport hc hne hcert hg hgi'
