theorem InR_shT {T : List ℤ} (sv : ℤ) (hQ : 0 < Q) : InR Q (shT Q sv T) := by
  intro v hv
  simp only [shT, List.mem_map] at hv
  obtain ⟨w, -, rfl⟩ := hv
  exact ⟨Int.emod_nonneg _ (by omega), Int.emod_lt_of_pos _ (by omega)⟩

theorem InR_stg (a c : ℕ) (T : List ℤ) (hQ : 0 < Q) : InR Q (stg Q a c T) := by
  intro v hv
  simp only [stg, List.mem_flatMap] at hv
  obtain ⟨d, -, hv⟩ := hv
  exact InR_shT _ hQ v hv

theorem length_stg (a c : ℕ) (T : List ℤ) : (stg Q a c T).length = a * T.length := by
  rw [stg, length_fm_const _ _ T.length (fun d _ => by simp [shT])]; simp

theorem length_tbl : ∀ ac : List (ℕ × ℕ), (tbl Q ac).length = vol (ac.map Prod.fst)
  | [] => rfl
  | (a, c) :: ac => by
    rw [tbl, length_stg, length_tbl ac]; simp [vol_cons]

theorem InR_tbl (hQ : 0 < Q) : ∀ ac : List (ℕ × ℕ), InR Q (tbl Q ac)
  | [] => by intro v hv; simp [tbl] at hv; subst hv; exact ⟨le_rfl, by exact_mod_cast hQ⟩
  | (a, c) :: ac => InR_stg a c _ hQ

theorem vol_le_of_pos : ∀ (A : Shape), (∀ a ∈ A, 1 ≤ a) → 1 ≤ vol A
