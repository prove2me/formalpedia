set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

theorem NLogN.KIL.rotP_shift_spec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : IState HS) (xs : List ℤ) (Bb : ℕ)
    (R L1 L2 L4 L14 : List Item)
    (hlen : xs.length = AModel.vol sh) (hb : Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ AModel.vol A)
    (hV : zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int (AModel.vol A) :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int (AModel.vol C) :: L4)
    (h14 : t.G 14 = ints ((List.range (AModel.vol A)).map fun p => (offs Λ c A p : ℤ)) ++ L14) :
    rotP.ok t ∧ rotP.run t = (t.upd 0 (ints (shiftArr Λ i 1 c 0 xs) ++ R)).upd 14 L14 ∧
      rotP.cost t ≤ 200000 * (AModel.vol A * (Q * AModel.vol C) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by sorry
