      open OAI OAI.CoarseAssembly OAI.CoarseAssembly.DiscreteRoe in
        open scoped Topology in
        by
          let : ContinuousStar (OAI.CoarseAssembly.DiscreteRoe.Operator X H) := ⟨(ContinuousLinearMap.adjoint : OAI.CoarseAssembly.DiscreteRoe.Operator X H ≃ₗᵢ⋆[ℂ] OAI.CoarseAssembly.DiscreteRoe.Operator X H).continuous⟩
