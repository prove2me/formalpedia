variable {K : Type} [Field K] [CharZero K] {O : Type} [CommRing O] [StarRing O]
variable {R : Subring K} {l linv : PowerSeries K} {τ : O →+* K}

theorem Formalism.L2.Th1.C.Calc.cob_phi (D : Data R l linv τ) (ph : PowerSeries K) {σ : Type} (g g' : ptsSub D σ) :
    cob (phi D ph) g g' = cls D (be0 l linv ph (pt D g) (pt D g')) := by sorry
