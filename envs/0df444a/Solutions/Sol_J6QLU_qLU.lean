variable {K : Type*} [Field K]

lemma qlu_qpoch_succ (q : K) (n : ℕ) : qpoch q (n + 1) = qpoch q n * (1 - q ^ (n + 1)) := by
  simp [qpoch, Finset.prod_range_succ]

lemma qlu_qbin_zero_of_lt (q : K) : ∀ (n k : ℕ), n < k → qbin q n k = 0 := by
  intro n
  induction n with
  | zero => intro k hk; obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩; rfl
  | succ n ih =>
    intro k hk
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    show qbin q n k + q ^ (k + 1) * qbin q n (k + 1) = 0
    rw [ih k (by omega), ih (k + 1) (by omega)]; ring

lemma qlu_qbin_mul (q : K) : ∀ (n k : ℕ), k ≤ n →
    qbin q n k * qpoch q k * qpoch q (n - k) = qpoch q n := by
  intro n
  induction n with
  | zero => intro k hk; obtain rfl : k = 0 := by omega
            simp [qbin, qpoch]
  | succ n ih =>
    intro k hk
    rcases k with _ | k
    · simp [qbin, qpoch]
    · show (qbin q n k + q ^ (k + 1) * qbin q n (k + 1)) * qpoch q (k + 1) * qpoch q (n + 1 - (k + 1))
          = qpoch q (n + 1)
      rcases Nat.eq_or_lt_of_le (show k ≤ n by omega) with h | h
      · subst h
        rw [qlu_qbin_zero_of_lt q k (k + 1) (by omega)]
        have := ih k le_rfl
        simp only [Nat.sub_self] at this ⊢
        rw [qlu_qpoch_succ]
        simp [qpoch] at this ⊢
        linear_combination (1 - q ^ (k + 1)) * this
      · obtain ⟨m, rfl⟩ : ∃ m, n = k + 1 + m := ⟨n - (k + 1), by omega⟩
        have h1 := ih k (by omega)
        have h2 := ih (k + 1) (by omega)
        have e1 : k + 1 + m - k = m + 1 := by omega
        have e2 : k + 1 + m - (k + 1) = m := by omega
        have e3 : k + 1 + m + 1 - (k + 1) = m + 1 := by omega
        rw [e1] at h1; rw [e2] at h2; rw [e3]
        rw [qlu_qpoch_succ q k] at h2 ⊢
        rw [qlu_qpoch_succ q m] at h1 ⊢
        rw [qlu_qpoch_succ q (k + 1 + m)]
        linear_combination (1 - q ^ (k + 1)) * h1 + q ^ (k + 1) * (1 - q ^ (m + 1)) * h2

lemma qlu_qfall (q : K) (b : ℕ) : ∀ k : ℕ, qpoch q (k + b) = qpoch q b * qfall q (k + b) k := by
  intro k
  induction k with
  | zero => simp [qfall]
  | succ k ih =>
    have : qfall q (k + 1 + b) (k + 1) = (1 - q ^ (k + b + 1)) * qfall q (k + b) k := by
      unfold qfall
      rw [Finset.prod_range_succ']
      rw [mul_comm]
      congr 1
      · congr 2; omega
      · apply Finset.prod_congr rfl
        intro i hi
        congr 2
        omega
    rw [this, show k + 1 + b = (k + b) + 1 by omega, qlu_qpoch_succ, ih]; ring

lemma qlu_qfall_zero (q : K) (v k : ℕ) (h : v < k) : qfall q v k = 0 := by
  unfold qfall
  apply Finset.prod_eq_zero (i := v) (by simp; omega)
  simp

lemma qlu_term (x z : K) (hz : z ≠ 0) (k a b : ℕ) (hk : qpoch (x ^ 2) k ≠ 0)
    (ha : qpoch (x ^ 2) a ≠ 0) (hb : qpoch (x ^ 2) b ≠ 0) :
    qpoch (x ^ 2) (k + a) * (bP x z⁻¹ a * (qpoch (x ^ 2) k)⁻¹ * bP x z b) * qpoch (x ^ 2) (k + b)
      = x ^ ((((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs ^ 2) *
          z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) *
          (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) := by
  have h1 := qlu_qbin_mul (x ^ 2) (k + a) k (by omega)
  rw [Nat.add_sub_cancel_left] at h1
  have h2 := qlu_qfall (x ^ 2) b k
  set N := (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs with hNdef
  have hN0 : (N : ℤ) ^ 2 = ((b : ℤ) - a) ^ 2 := by
    rw [hNdef, Int.natAbs_sq]; push_cast; ring
  have hN : N ^ 2 + 2 * (a * b) = a ^ 2 + b ^ 2 := by
    zify; linear_combination hN0
  have hx : x ^ (N ^ 2) * (x ^ 2) ^ (a * b) = x ^ (a ^ 2) * x ^ (b ^ 2) := by
    rw [← pow_mul, ← pow_add, ← pow_add, hN]
  have hzz : z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) = z ^ b * (z ^ a)⁻¹ := by
    rw [show ((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ) = (b : ℤ) - (a : ℤ) by push_cast; ring,
      zpow_sub₀ hz, zpow_natCast, zpow_natCast, div_eq_mul_inv]
  rw [hzz, ← h1, h2]
  unfold bP
  rw [show x ^ (N ^ 2) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) =
      (x ^ (N ^ 2) * (x ^ 2) ^ (a * b)) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k) by ring, hx]
  rw [inv_pow]
  field_simp

theorem solution (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    gaussToep x z n =
      Gam (x ^ 2) n * lowT (bP x z⁻¹) * GamInv (x ^ 2) n * upT (bP x z) * Gam (x ^ 2) n := by
  ext ⟨u, hu⟩ ⟨v, hv⟩
  simp only [Gam, GamInv]
  rw [mul_diagonal, mul_apply]
  simp only [mul_diagonal, diagonal_mul, gaussToep, lowT, upT]
  rw [Finset.sum_mul, Fin.sum_univ_eq_sum_range (fun k : ℕ =>
    (qpoch (x ^ 2) u * if k ≤ u then bP x z⁻¹ (u - k) else 0) * (qpoch (x ^ 2) k)⁻¹ *
      (if k ≤ v then bP x z (v - k) else 0) * qpoch (x ^ 2) v) n]
  rw [← Finset.sum_subset (range_subset_range.2 (show u + 1 ≤ n by omega)) ?_]
  · conv_lhs => rw [← mul_one (_ * _), ← qpascal_identity (x ^ 2) u v, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [mem_range] at hk
    rw [if_pos (by omega)]
    by_cases hkv : k ≤ v
    · rw [if_pos hkv]
      obtain ⟨a, rfl⟩ : ∃ a, u = k + a := ⟨u - k, by omega⟩
      obtain ⟨b, rfl⟩ : ∃ b, v = k + b := ⟨v - k, by omega⟩
      simp only [Nat.add_sub_cancel_left]
      rw [← qlu_term x z hz k a b (hq k (by omega)) (hq a (by omega)) (hq b (by omega))]
      ring
    · rw [if_neg hkv, qlu_qfall_zero _ _ _ (by omega)]; ring
  · intro k hk hk'
    simp only [mem_range] at hk hk'
    rw [if_neg (by omega)]; ring
