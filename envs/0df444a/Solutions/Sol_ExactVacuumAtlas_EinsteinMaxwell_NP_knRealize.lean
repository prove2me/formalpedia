/-! ### Kerr–Newman realisation of compatible real tangents -/

/-- Restriction of null-frame data to an open subset. -/
theorem NullFrameData.restrict {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U V : Set (Pt 4)}
    (hN : NullFrameData g gi E Θ U) (hV : IsOpen V) (hVU : V ⊆ U) : NullFrameData g gi E Θ V where
  metric :=
    { isOpen := hV
      symm := fun x hx => hN.metric.symm x (hVU hx)
      inv := fun x hx => hN.metric.inv x (hVU hx)
      smooth := fun i j => (hN.metric.smooth i j).mono hVU
      smooth_inv := fun i j => (hN.metric.smooth_inv i j).mono hVU }
  smooth_E := fun A μ => (hN.smooth_E A μ).mono hVU
  smooth_Θ := fun A μ => (hN.smooth_Θ A μ).mono hVU
  dual := fun x hx => hN.dual x (hVU hx)
  gram := fun x hx => hN.gram x (hVU hx)

