    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (β : Fin (2 * 2) → ↥Λ) {d m : ℕ} {S : Type} [CommRing S] (h2 : IsUnit (2 : S))
    (X : PolarisedAbelianScheme 2 d m S) (t : QMStructure Λ star β X)
