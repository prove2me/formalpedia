    · have hcl1 : s1.cl R = .pos := by rw [cl_int _ _ _ _ hR1]; simp [h1]
      have e1 := IRuns.dup (I := I) (iprog := iprog) (s := s1) (j := T) hXT hX1
      have e2 := IRuns.add (I := I) (iprog := iprog) (s := s1.upd T (.int a :: s1.G T))
        (i := T) (j := W) (k := W) (a := a) (b := c) (Li := s1.G T) (Lj := s.G W)
        hWT' (by simp) (by simp [hW1, hWT])
      refine (IRuns.iteF (by rw [hcl1]; rfl) (IRuns.iteT (by rw [hcl1]; rfl) (IRuns.seq e1 e2))).mono' ?_ ?_
      · apply IState.ext' <;> intros <;> simp [h1] <;> split_ifs <;> simp_all <;> ring
      · have := dupCost_le (zsz a)
        have := addIntCost_mono (show zsz a + zsz c ≤ 2 * N + 1 by omega)
        have := addIntCost_le (2 * N + 1)
        omega
    · have hcl1 : s1.cl R = .neg := by rw [cl_int _ _ _ _ hR1]; simp [hm]
      have e1 := IRuns.dup (I := I) (iprog := iprog) (s := s1) (j := T) hXT hX1
      have e2 := IRuns.neg (I := I) (iprog := iprog) (s := s1.upd T (.int a :: s1.G T)) (i := T)
        (a := a) (L := s1.G T) (by simp)
      have e3 := IRuns.add (I := I) (iprog := iprog)
        (s := (s1.upd T (.int a :: s1.G T)).upd T (.int (-a) :: s1.G T))
        (i := T) (j := W) (k := W) (a := -a) (b := c) (Li := s1.G T) (Lj := s.G W)
        hWT' (by simp) (by simp [hW1, hWT])
      refine (IRuns.iteF (by rw [hcl1]; rfl) (IRuns.iteF (by rw [hcl1]; rfl)
        (IRuns.seq e1 (IRuns.seq e2 e3)))).mono' ?_ ?_
      · apply IState.ext' <;> intros <;> simp [hm] <;> split_ifs <;> simp_all <;> ring
      · have := dupCost_le (zsz a)
        have := addIntCost_mono (show zsz (-a) + zsz c ≤ 2 * N + 1 by rw [zsz_neg]; omega)
        have := addIntCost_le (2 * N + 1)
        omega
  set s2 := s1.upd W (.int (c + a * r) :: s.G W)
  have hR2 : s2.G R = .int r :: s.G R := by simp [s2, hWR', hR1]
  have h3 := IRuns.drop (I := I) (iprog := iprog) (s := s2) hR2
  have hX3 : (s2.upd R (s.G R)).G X = .int a :: s.G X := by simp [s2, hXR, hXW, hX1]
  have hQ3 : (s2.upd R (s.G R)).G Q = .int (2 ^ 1) :: s.G Q := by
    simp [s2, s1, s0, schoolSt, hQR, hWQ', hYQ']
  have h4 := IRuns.shl (I := I) (iprog := iprog) hXQ hX3 hQ3
  refine (IRuns.seq h1 (IRuns.seq hbr (IRuns.seq h3 h4))).mono' ?_ ?_
  · apply IState.ext' <;> intros <;> simp [s2, s1, s0, schoolSt, r] <;> split_ifs <;> simp_all
  · have hr' : zsz r ≤ 1 := by
      rcases hr with h | h | h <;> rw [h] <;> simp [zsz_zero, zsz_one, zsz_neg]
    have := splitCost_le 1; have := shlCost_le 1
    simp only [schoolIter]; omega

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

theorem zsz_le_add_of_natAbs_le {a : ℤ} {n : ℕ} (h : a.natAbs ≤ n) (z : ℤ) :
    zsz (z * a) ≤ zsz z + (nbits n).length := by
  refine le_trans (zsz_mul_le z a) ?_
  have : zsz a ≤ zsz (n : ℤ) := zsz_mono (by simpa using h)
  simp only [zsz, zbits, Int.natAbs_natCast] at this ⊢
  omega

end NLogN

end

section
open NLogN
variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}
theorem solution {A X Y W Q R T : Fin S} (hd : [A, X, Y, W, Q, R, T].Nodup)
    (s : IState S) (x y : ℤ) (L : List Item) (hA : s.G A = .int x :: .int y :: L) :
    IRuns I iprog (smul A X Y W Q R T) s (s.upd A (.int (x * y) :: L))
      (smulCost (zsz x + zsz y)) := by
  have hd' := hd
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, not_or,
    not_false_eq_true, List.nodup_nil, and_true, or_false] at hd'
  obtain ⟨⟨hAX, hAY, hAW, hAQ, hAR, hAT⟩, ⟨hXY, hXW, hXQ, hXR, hXT⟩, ⟨hYW, hYQ, hYR, hYT⟩,
    ⟨hWQ, hWR, hWT⟩, ⟨hQR, hQT⟩, hRT⟩ := hd'
  have hAX' := Ne.symm hAX; have hAY' := Ne.symm hAY; have hAW' := Ne.symm hAW; have hAQ' := Ne.symm hAQ; have hAR' := Ne.symm hAR; have hAT' := Ne.symm hAT; have hXY' := Ne.symm hXY; have hXW' := Ne.symm hXW; have hXQ' := Ne.symm hXQ; have hXR' := Ne.symm hXR; have hXT' := Ne.symm hXT; have hYW' := Ne.symm hYW; have hYQ' := Ne.symm hYQ; have hYR' := Ne.symm hYR; have hYT' := Ne.symm hYT; have hWQ' := Ne.symm hWQ; have hWR' := Ne.symm hWR; have hWT' := Ne.symm hWT; have hQR' := Ne.symm hQR; have hQT' := Ne.symm hQT; have hRT' := Ne.symm hRT
  set N := zsz x + zsz y with hN
  set m := zsz y with hm
  -- prologue
  have h1 := IRuns.mv (I := I) (iprog := iprog) (s := s) (j := X) hAX hA
  set s1 := (s.upd A (.int y :: L)).upd X (.int x :: s.G X)
  have h2 := IRuns.mv (I := I) (iprog := iprog) (s := s1) (i := A) (j := Y) (a := y) (L := L) hAY
    (by simp [s1, hAX])
  set s2 := (s1.upd A L).upd Y (.int y :: s1.G Y)
  have h3 := IRuns.const (I := I) (iprog := iprog) (s := s2) W 0
  have h4 := IRuns.const (I := I) (iprog := iprog) (s := s2.upd W (.int 0 :: s2.G W)) Q 2
  let ss : ℕ → IState S := fun k => schoolSt s A X Y W Q L (x * 2 ^ k) (sg y (y.natAbs / 2 ^ k))
    (x * sg y (y.natAbs % 2 ^ k))
  have e0 : (s2.upd W (.int 0 :: s2.G W)).upd Q (.int 2 :: (s2.upd W (.int 0 :: s2.G W)).G Q) =
      ss 0 := by
    apply IState.ext' <;> intros <;> simp [ss, schoolSt, s2, s1, sg_natAbs, sg_zero, Nat.mod_one] <;>
      split_ifs <;> simp_all
  rw [e0] at h4
  have hloop := IRuns.loop' (I := I) (iprog := iprog) (i := Y) (f := fun c => c != .zero)
    (p := smulBody X Y W Q R T) ss (schoolIter N) m
    (by
      intro k hk
      have hne := div_two_pow_ne_zero (n := y.natAbs) hk
      have : (ss k).G Y = .int (sg y (y.natAbs / 2 ^ k)) :: s.G Y := by
        simp [ss, schoolSt, hYQ, hYW]
      rw [cl_int _ _ _ _ this]; simp only [sg_eq_zero, hne, if_false]; split_ifs <;> simp)
    (by
      have : (ss m).G Y = .int (sg y (y.natAbs / 2 ^ m)) :: s.G Y := by
        simp [ss, schoolSt, hYQ, hYW]
      rw [cl_int _ _ _ _ this]; simp [m, zsz, zbits, div_two_pow_zsz, sg_zero])
    (by
      intro k hk
      have hne := div_two_pow_ne_zero (n := y.natAbs) hk
      have hb : sg y (y.natAbs / 2 ^ k) ≠ 0 := by rwa [Ne, sg_eq_zero]
      have := smulBody_runs (I := I) (iprog := iprog) hd s L (x * 2 ^ k) (sg y (y.natAbs / 2 ^ k))
        (x * sg y (y.natAbs % 2 ^ k)) hb N
        (by
          by_cases hx : x = 0
          · simp [hx, zsz_zero]
          · rw [zsz, zbits_mul_two_pow hx]; simp only [List.length_append, List.length_replicate]
            have : zsz x = (zbits x).length := rfl
            omega)
        (le_trans (zsz_le_add_of_natAbs_le (by rw [natAbs_sg]; exact Nat.mod_le _ _) x) le_rfl)
      refine this.mono' ?_ le_rfl
      simp only [natAbs_sg, sg_sg hne]
      congr 1
      · ring
      · rw [Nat.div_div_eq_div_mul, ← pow_succ]
      · rw [nat_mod_two_pow_succ, sg_add, sg_mul, show y.natAbs / 2 ^ k % 2 =
          y.natAbs / 2 ^ k % 2 ^ 1 by norm_num]
        push_cast; ring)
  -- epilogue
  have hz : y.natAbs / 2 ^ m = 0 := by simp only [m, zsz, zbits]; exact div_two_pow_zsz _
  have hfull : y.natAbs % 2 ^ m = y.natAbs := Nat.mod_eq_of_lt (by
    have := Nat.div_add_mod y.natAbs (2 ^ m); rw [hz] at this; omega)
  set sm := ss m
  have hY5 : sm.G Y = .int 0 :: s.G Y := by simp [sm, ss, schoolSt, hYQ, hYW, hz, sg_zero]
  have h5 := IRuns.drop (I := I) (iprog := iprog) hY5
  have h6 := IRuns.drop (I := I) (iprog := iprog) (s := sm.upd Y (s.G Y)) (i := X)
    (a := x * 2 ^ m) (L := s.G X) (by simp [sm, ss, schoolSt, hXY, hXW, hXQ])
  have h7 := IRuns.drop (I := I) (iprog := iprog) (s := (sm.upd Y (s.G Y)).upd X (s.G X)) (i := Q)
    (a := 2) (L := s.G Q) (by simp [sm, ss, schoolSt, hYQ', hXQ'])
  have h8 := IRuns.mv (I := I) (iprog := iprog)
    (s := ((sm.upd Y (s.G Y)).upd X (s.G X)).upd Q (s.G Q)) (i := W) (j := A)
    (a := x * sg y (y.natAbs % 2 ^ m)) (L := s.G W) hAW'
    (by simp [sm, ss, schoolSt, hYW', hXW', hWQ])
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq hloop
    (IRuns.seq h5 (IRuns.seq h6 (IRuns.seq h7 h8)))))))).mono' ?_ ?_
  · clear h1 h2 h3 h4 hloop h5 h6 h7 h8
    rw [hfull, sg_natAbs]
    apply IState.ext' <;> intros <;> simp [sm, ss, schoolSt] <;> split_ifs <;> simp_all
  · clear h1 h2 h3 h4 hloop h5 h6 h7 h8
    have hxm : zsz (x * 2 ^ m) ≤ N := by
      by_cases hx : x = 0
      · simp [hx, zsz_zero]
      · rw [zsz, zbits_mul_two_pow hx]; simp [N, zsz, m]; omega
    have hacc : zsz (x * sg y (y.natAbs % 2 ^ m)) ≤ N := by
      rw [hfull, sg_natAbs]; exact zsz_mul_le x y
    have := moveIntCost_le (zsz x); have := moveIntCost_le (zsz y)
    have := moveIntCost_le (zsz (x * sg y (y.natAbs % 2 ^ m)))
    have hc2 : zsz (2 : ℤ) = 2 := by
      rw [show (2 : ℤ) = 2 ^ 1 by norm_num, zsz_two_pow]
    simp only [smulCost, schoolIter, zsz_zero, hc2]
    have hmN : m ≤ N := by omega
    have := Nat.mul_le_mul_right (1500 * (N + 2) + 30) hmN
    nlinarith
end
