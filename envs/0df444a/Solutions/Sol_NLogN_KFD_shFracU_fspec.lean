  rw [e1, e2]
  omega

theorem cPassGUF_le (hc : 2 ≤ c) (hb : b ≤ 2 * c) (hB : 1 ≤ B) (hQ : 1 ≤ Q)
    (hbL : (bL + 2) ^ 2 ≤ 18 * (c * (Q * B))) :
    cPassGUF Q c B w b bL ≤ 4 * 10 ^ 9 * ((c + 1) ^ 2 * (Q * B * (w + 2))) := by
  have h0 := cPassGF_le (w := w) hc hb hB hQ
  unfold cPassGUF
  set X := Q * B
  set U := (c + 1) ^ 2 * (X * (w + 2))
  have hXw : 2 * X ≤ X * (w + 2) := by nlinarith
  have hcX : c * X ≤ U := by
    have : c ≤ (c + 1) ^ 2 := by nlinarith
    have := Nat.mul_le_mul this hXw
    simp only [U]; nlinarith
  have hbl : 2 * bL + 2 ≤ (bL + 2) ^ 2 := by nlinarith
  omega

theorem cBlkGUF_le (hc : 2 ≤ c) (hb : b ≤ 2 * c) (hB : 1 ≤ B) (hQ : 1 ≤ Q)
    (hbL : (bL + 2) ^ 2 ≤ 18 * (c * (Q * B))) :
    cBlkGUF Q c B w b bL ≤ 5 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2))) := by
  have h0 := cPassGUF_le (w := w) hc hb hB hQ hbL
  unfold cBlkGUF
  set Y := Q * B * (w + 2)
  have hY : 2 ≤ Y := by have : 1 ≤ Q * B := Nat.mul_le_mul hQ hB; simp only [Y]; nlinarith
  have h1 : c * cPassGUF Q c B w b bL ≤ c * (4 * 10 ^ 9 * ((c + 1) ^ 2 * Y)) :=
    Nat.mul_le_mul_left _ h0
  have e : c * (4 * 10 ^ 9 * ((c + 1) ^ 2 * Y)) = 4 * 10 ^ 9 * (c * (c + 1) ^ 2 * Y) := by ring
  have h2 : c * (c + 1) ^ 2 * Y ≤ (c + 1) ^ 3 * Y := Nat.mul_le_mul_right _ (by
    have : c * (c + 1) ^ 2 ≤ (c + 1) * (c + 1) ^ 2 := Nat.mul_le_mul_right _ (by omega)
    simpa [pow_succ, mul_comm, mul_assoc, mul_left_comm] using this)
  have h3 : 1 ≤ (c + 1) ^ 3 * Y := Nat.one_le_iff_ne_zero.2 (by positivity)
  omega

theorem cBlkSUF_le (hc : 2 ≤ c) (hb : b ≤ 2 * c) (hB : 1 ≤ B) (hQ : 1 ≤ Q)
    (hbL : (bL + 2) ^ 2 ≤ 18 * (c * (Q * B))) :
    cBlkSUF Q c B w b bL ≤ 6 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2))) := by
  have h0 := cBlkGUF_le (w := w) hc hb hB hQ hbL
  unfold cBlkGUF at h0
  unfold cBlkSUF cLp
  set X := Q * B
  set Y := X * (w + 2)
  have hXw : 2 * X ≤ Y := by simp only [Y]; nlinarith
  have hbl : bL + 2 ≤ (bL + 2) ^ 2 := by nlinarith
  have e2 : X * (250 * (w + 2) + 1100) = 250 * Y + 1100 * X := by simp only [Y]; ring
  have hcY : c * X ≤ (c + 1) ^ 3 * Y := by
    have : c ≤ (c + 1) ^ 3 := by
      have := Nat.le_self_pow (n := 3) (by norm_num) (c + 1); omega
    have := Nat.mul_le_mul this hXw
    nlinarith
  have hY : Y ≤ (c + 1) ^ 3 * Y := Nat.le_mul_of_pos_left _ (by positivity)
  rw [e2]
  omega

end Bounds

section Bounds2

variable {P Q c B w b bL Bb : ℕ}

theorem cRF_aux {cb : ℕ} (hQ : 1 ≤ Q) (hB : 1 ≤ B) (hc : 2 ≤ c)
    (h0 : cb ≤ 6 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2)))) :
    cLp P cb Bb + cLp (P * (Q * B)) (250 * (w + 2)) Bb ≤
      7 * 10 ^ 9 * ((c + 1) ^ 3 * ((P * (Q * B) + 1) * (w + 2))) + 2000 * (Bb + 2) := by
  unfold cLp
  set V := P * (Q * B)
  set Z := (c + 1) ^ 3 * ((V + 1) * (w + 2))
  have h1 : P * (cb + 1100) ≤ P * (6 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2))) + 1100) :=
    Nat.mul_le_mul_left _ (by omega)
  have e1 : P * (6 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2))) + 1100) =
      6 * 10 ^ 9 * ((c + 1) ^ 3 * (V * (w + 2))) + 1100 * P := by simp only [V]; ring
  have hPV : P ≤ V := Nat.le_mul_of_pos_right _ (Nat.mul_pos hQ hB)
  have hVZ : (c + 1) ^ 3 * (V * (w + 2)) ≤ Z :=
    Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (by omega))
  have hV2 : 2 * (V + 1) ≤ (V + 1) * (w + 2) := by nlinarith
  have hZ : (V + 1) * (w + 2) ≤ Z := Nat.le_mul_of_pos_left _ (by positivity)
  have e2 : V * (250 * (w + 2) + 1100) = 250 * (V * (w + 2)) + 1100 * V := by ring
  have hVw : V * (w + 2) ≤ (V + 1) * (w + 2) := Nat.mul_le_mul_right _ (by omega)
  rw [e2]
  omega

theorem cU_aux {cr : ℕ} (hc : 2 ≤ c) (V : ℕ)
    (h0 : cr ≤ 7 * 10 ^ 9 * ((c + 1) ^ 3 * ((V + 1) * (w + 2))) + 2000 * (Bb + 2)) :
    4 * 10 ^ 7 * (Bb + 2) ^ 2 + (c * cSel Bb + cr + (2 * Bb + 2)) ≤
      10 ^ 10 * ((c + 1) ^ 3 * ((V + 1) * (w + 2))) + 10 ^ 8 * ((c + 1) * (Bb + 2) ^ 2) := by
  unfold cSel
  set X := (Bb + 2) ^ 2
  have hX : Bb + 2 ≤ X := by simp only [X]; nlinarith
  have h1 : c * ((3 + 1) * 2000 * (Bb + 2) + (2 * Bb + 2) + 25) ≤ c * (9000 * X) :=
    Nat.mul_le_mul_left _ (by omega)
  have h2 : X ≤ (c + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have h3 : c * (9000 * X) ≤ 9000 * ((c + 1) * X) := by nlinarith
  omega

/-- Local loop bound for a gather / scatter block. -/
theorem bL_facts (hc : 2 ≤ c) (hQ : 1 ≤ Q) (hB : 1 ≤ B) :
    zsz (B : ℤ) ≤ zsz ((c * (Q * B) : ℕ) : ℤ) ∧ zsz (c : ℤ) ≤ zsz ((c * (Q * B) : ℕ) : ℤ) ∧
    zsz (Q : ℤ) ≤ zsz ((c * (Q * B) : ℕ) : ℤ) ∧ zsz ((Q * B : ℕ) : ℤ) ≤ zsz ((c * (Q * B) : ℕ) : ℤ) ∧
    (zsz ((c * (Q * B) : ℕ) : ℤ) + 2) ^ 2 ≤ 18 * (c * (Q * B)) := by
  have hX : 1 ≤ Q * B := Nat.mul_le_mul hQ hB
  have hcX : Q * B ≤ c * (Q * B) := Nat.le_mul_of_pos_left _ (by omega)
  refine ⟨NLogN.KIL.zsz_nat_le (le_trans (Nat.le_mul_of_pos_left _ hQ) hcX),
    NLogN.KIL.zsz_nat_le (Nat.le_mul_of_pos_right _ hX), NLogN.KIL.zsz_nat_le (le_trans (Nat.le_mul_of_pos_right _ hB) hcX),
    NLogN.KIL.zsz_nat_le hcX, sq_zsz_le (by nlinarith)⟩

end Bounds2

theorem cDivPgUF_le {P Q c B w Bb : ℕ} (hc : 2 ≤ c) (hQ : 1 ≤ Q) (hB : 1 ≤ B) :
    cDivPgUF P Q c B w (2 * c) (zsz ((c * (Q * B) : ℕ) : ℤ)) Bb ≤ cFrF c (P * (Q * B)) w Bb := by
  obtain ⟨-, -, -, -, h5⟩ := bL_facts hc hQ hB
  have h1 := cBlkGUF_le (w := w) (b := 2 * c) hc le_rfl hB hQ h5
  have h1' : cBlkGUF Q c B w (2 * c) (zsz ((c * (Q * B) : ℕ) : ℤ)) ≤
      6 * 10 ^ 9 * ((c + 1) ^ 3 * (Q * B * (w + 2))) := le_trans h1 (Nat.mul_le_mul_right _ (by norm_num))
  have h2 := cRF_aux (P := P) (Bb := Bb) hQ hB hc h1'
  exact cU_aux hc _ h2

theorem cMulPgUF_le {P Q c B w Bb : ℕ} (hc : 2 ≤ c) (hQ : 1 ≤ Q) (hB : 1 ≤ B) :
    cMulPgUF P Q c B w (2 * c) (zsz ((c * (Q * B) : ℕ) : ℤ)) Bb ≤ cFrF c (P * (Q * B)) w Bb := by
  obtain ⟨-, -, -, -, h5⟩ := bL_facts hc hQ hB
  have h1 := cBlkSUF_le (w := w) (b := 2 * c) hc le_rfl hB hQ h5
  have h2 := cRF_aux (P := P) (Bb := Bb) hQ hB hc h1
  exact cU_aux hc _ h2

theorem fdivPU_fspec (t : IState HS) (xs : List ℤ) (P Q d B w Bb : ℕ) (R : List Item)
    (hlen : xs.length = P * Q * B) (hb : Bnd w xs) (hd : 1 ≤ d) (hQ1 : 1 ≤ Q) (hB1 : 1 ≤ B)
    (hQd : Nat.Coprime Q d) (zd : zsz ((2 * d : ℕ) : ℤ) ≤ Bb)
    (zQ : zsz (Q : ℤ) ≤ Bb) (zP : zsz (P : ℤ) ≤ Bb)
    (zV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) (hp : StP t P Q B) :
    FSp (fdivPU d) t (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (divAddr Q d) 0 xs) ++ R))
      (cFrF d (P * (Q * B)) w Bb) := by
  by_cases h : d < 2
  · obtain rfl : d = 1 := by omega
    rw [fdivPU, if_pos h, pull_divAddr_one hlen, upd_eq_self h0]
    exact (FSp.skip t).mono (by unfold cFrF; exact Nat.one_le_iff_ne_zero.2 (by positivity))
  · rw [fdivPU, if_neg h]
    obtain ⟨_, hQs⟩ := hp.hQ; obtain ⟨_, hBs⟩ := hp.hB; obtain ⟨_, hAs⟩ := hp.hA
    obtain ⟨_, hVs⟩ := hp.hV
    obtain ⟨z1, z2, z3, z4, -⟩ := bL_facts (c := d) (by omega) hQ1 hB1
    exact (divPgU_fspec t xs P Q d B w (2 * d) _ Bb R hlen hb (by omega) hQd (zszN _) z1 z2 z3 z4
      zP zQ zd zV h0 hQs hBs hAs hVs).mono (cDivPgUF_le (by omega) hQ1 hB1)

theorem fmulPU_fspec (t : IState HS) (xs : List ℤ) (P Q k B w Bb : ℕ) (R : List Item)
    (hlen : xs.length = P * Q * B) (hb : Bnd w xs) (hk : 1 ≤ k) (hQ1 : 1 ≤ Q) (hB1 : 1 ≤ B)
    (hQk : Nat.Coprime Q k) (zk : zsz ((2 * k : ℕ) : ℤ) ≤ Bb)
    (zQ : zsz (Q : ℤ) ≤ Bb) (zP : zsz (P : ℤ) ≤ Bb)
    (zV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) (hp : StP t P Q B) :
    FSp (fmulPU k) t (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (mulAddr Q k) 0 xs) ++ R))
      (cFrF k (P * (Q * B)) w Bb) := by
  by_cases h : k < 2
  · obtain rfl : k = 1 := by omega
    rw [fmulPU, if_pos h, pull_mulAddr_one hlen, upd_eq_self h0]
    exact (FSp.skip t).mono (by unfold cFrF; exact Nat.one_le_iff_ne_zero.2 (by positivity))
  · rw [fmulPU, if_neg h]
    obtain ⟨_, hQs⟩ := hp.hQ; obtain ⟨_, hBs⟩ := hp.hB; obtain ⟨_, hAs⟩ := hp.hA
    obtain ⟨_, hVs⟩ := hp.hV; obtain ⟨_, hQBs⟩ := hp.hQB
    obtain ⟨z1, z2, z3, z4, -⟩ := bL_facts (c := k) (by omega) hQ1 hB1
    exact (mulPgU_fspec t xs P Q k B w (2 * k) _ Bb R hlen hb (by omega) hQk (zszN _) z1 z2 z3 z4
      zP zQ zk zV h0 hQs hBs hAs hVs hQBs).mono (cMulPgUF_le (by omega) hQ1 hB1)

theorem sh_costF {n VA Q VC b w Bb sc : ℕ} (hbQ : b ≤ 2 * Q) (hA : 1 ≤ VA) (hQ : 1 ≤ Q)
    (hC : 1 ≤ VC) (hsc : sc ≤ 2 * 10 ^ 11 * (n + 1) * (VA + 1) * (b + 2)) :
    sc + (3 * ((1 + 1) * 2000 * (Bb + 2)) + ((10 ^ 6 * (VA * (Q * VC) + 1) * (w + 2) +
      10 ^ 8 * (Bb + 2) ^ 2) + 3 * (2 * Bb + 2))) ≤ cShUF n (VA * (Q * VC)) w Bb := by
  unfold cShUF
  set V := VA * (Q * VC)
  have h1 : (VA + 1) * (b + 2) ≤ 8 * V := by
    have a1 : VA + 1 ≤ 2 * VA := by omega
    have a2 : b + 2 ≤ 4 * Q := by omega
    have a3 := Nat.mul_le_mul a1 a2
    have a4 : VA * Q ≤ V := by
      simp only [V]; rw [← mul_assoc]; exact Nat.le_mul_of_pos_right _ hC
    calc (VA + 1) * (b + 2) ≤ 2 * VA * (4 * Q) := a3
      _ = 8 * (VA * Q) := by ring
      _ ≤ 8 * V := by omega
  have h2 : 8 * V ≤ 4 * ((V + 1) * (w + 2)) := by nlinarith
  set Z := (V + 1) * (w + 2)
  have h3 : sc ≤ 2 * 10 ^ 11 * ((n + 1) * (8 * V)) := by
    have : 2 * 10 ^ 11 * (n + 1) * (VA + 1) * (b + 2) = 2 * 10 ^ 11 * ((n + 1) * ((VA + 1) * (b + 2))) := by
      ring
    rw [this] at hsc
    exact le_trans hsc (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ h1))
  have h4 : (n + 1) * (8 * V) ≤ 4 * ((n + 1) * Z) := by
    have := Nat.mul_le_mul_left (n + 1) h2; linarith
  have h5 : Z ≤ (n + 1) * Z := Nat.le_mul_of_pos_left _ (by omega)
  have h6 : Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  have e : 10 ^ 6 * (V + 1) * (w + 2) = 10 ^ 6 * Z := by simp only [Z]; ring
  rw [e]
  omega

section Body

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

theorem shF_generic [NeZero Q] (core : RS) (cc : ℕ) (A C : Shape) (t : IState HS) (xs ys : List ℤ)
    (b Bb : ℕ) (R : List Item) (hB1 : 1 ≤ vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ vol A) (hV : zsz ((vol A * (Q * vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ b) (h0 : t.G 0 = ints xs ++ R)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : vol (ac.map Prod.fst) = vol A) {LA LC LM LAM LN LP LQ LC' : List Item}
    (hS : StgOK t Q ac LA LC LM LAM) (hNQ : t.G sNQ = .int (-(Q : ℤ)) :: LN)
    (hPA : t.G sPA = .int (vol A : ℤ) :: LP) (hQQ : t.G sQQ = .int (Q : ℤ) :: LQ)
    (hPC : t.G sPC = .int (vol C : ℤ) :: LC')
    (hcore : ∀ u : IState HS, u.G 0 = ints xs ++ R → u.G 1 = .int (vol A : ℤ) :: t.G 1 →
      u.G 2 = .int (Q : ℤ) :: t.G 2 → u.G 4 = .int (vol C : ℤ) :: t.G 4 →
      u.G 14 = ints (NLogN.KIL.tbl Q ac) ++ t.G 14 →
      FSp core u ((u.upd 0 (ints ys ++ R)).upd 14 (t.G 14)) cc) :
    FSp (.seq (genPU ac.length) (.seq (.push 1 (.reg sPA)) (.seq (.push 2 (.reg sQQ))
      (.seq (.push 4 (.reg sPC)) (.seq core (.seq (.pop 1) (.seq (.pop 2) (.pop 4))))))))
      t (postSt t ys R LA LC LM LAM)
      ((1 + 1) * 2000 * (b + 2) + stCostF b ac.reverse [] + (3 * ((1 + 1) * 2000 * (Bb + 2)) +
        (cc + 3 * (2 * Bb + 2)))) := by
  set V := vol A * (Q * vol C)
  have hle : ∀ m : ℕ, m ≤ V → zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have zA := hle (vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ (by omega)) (Nat.le_mul_of_pos_left _ hP1))
  have zC := hle (vol C) (le_trans (Nat.le_mul_of_pos_left _ (by omega))
    (Nat.le_mul_of_pos_left _ hP1))
  have G := genPU_fsp (by omega) hQ2 ac hac t LA LC LM LAM LN hS.hA hS.hC hS.hM hS.hAM hNQ
  set t1 := ((((t.upd 14 (ints (NLogN.KIL.tbl Q ac) ++ t.G 14)).upd sSA LA).upd sSC LC).upd sSM LM).upd sSAM LAM
  have S2 := FSp.of_norep rfl (Sp.pushReg t1 (i := 1) (j := sPA) (by decide) (by decide)
    (a := (vol A : ℤ)) (L := LP) (by simp (config := {decide := true}) [t1, hPA]) zA)
  set t2 := t1.upd 1 (.int (vol A : ℤ) :: t1.G 1)
  have S3 := FSp.of_norep rfl (Sp.pushReg t2 (i := 2) (j := sQQ) (by decide) (by decide)
    (a := (Q : ℤ)) (L := LQ) (by simp (config := {decide := true}) [t2, t1, hQQ]) zQ)
  set t3 := t2.upd 2 (.int (Q : ℤ) :: t2.G 2)
  have S4 := FSp.of_norep rfl (Sp.pushReg t3 (i := 4) (j := sPC) (by decide) (by decide)
    (a := (vol C : ℤ)) (L := LC') (by simp (config := {decide := true}) [t3, t2, t1, hPC]) zC)
  set t4 := t3.upd 4 (.int (vol C : ℤ) :: t3.G 4)
  have S5 := hcore t4 (by simp (config := {decide := true}) [t4, t3, t2, t1, h0])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
  set t5 := (t4.upd 0 (ints ys ++ R)).upd 14 (t.G 14)
  have S6 := FSp.of_norep rfl (Sp.popI t5 (i := 1) (by decide) (a := (vol A : ℤ)) (L := t.G 1)
    (by simp (config := {decide := true}) [t5, t4, t3, t2, t1]) zA)
  have S7 := FSp.of_norep rfl (Sp.popI (t5.upd 1 (t.G 1)) (i := 2) (by decide) (a := (Q : ℤ))
    (L := t.G 2) (by simp (config := {decide := true}) [t5, t4, t3, t2, t1]) zQ)
  have S8 := FSp.of_norep rfl (Sp.popI ((t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 4) (by decide)
    (a := (vol C : ℤ)) (L := t.G 4) (by simp (config := {decide := true}) [t5, t4, t3, t2, t1]) zC)
  have H := G.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (S7.seq S8))))))
  refine (H.congr ?_).mono (le_of_eq (by ring))
  refine IState.ext' (fun j => ?_) rfl rfl
  simp only [postSt, t5, t4, t3, t2, t1, IState.upd_G]
  by_cases h4 : j = 4; · subst h4; simp (config := {decide := true})
  by_cases h2 : j = 2; · subst h2; simp (config := {decide := true})
  by_cases h1 : j = 1; · subst h1; simp (config := {decide := true})
  by_cases h14 : j = 14; · subst h14; simp (config := {decide := true})
  by_cases h0' : j = 0; · subst h0'; simp (config := {decide := true})
  simp only [h4, h2, h1, h14, h0', if_false]

/-- **Fine uniform table shift, coefficient `1`.** -/
theorem shPU_fspec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : IState HS) (xs : List ℤ) (w Bb : ℕ) (R : List Item)
    (hlen : xs.length = vol sh) (hb : Bnd w xs) (hB1 : 1 ≤ vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ vol A) (hV : zsz ((vol A * (Q * vol C) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : vol (ac.map Prod.fst) = vol A) (htbl : NLogN.KIL.tbl Q ac = NLogN.KIL.tbl Q (A.zip (csOf Λ c A)))
    {LA LC LM LAM LN LP LQ LC' : List Item}
    (hS : StgOK t Q ac LA LC LM LAM) (hNQ : t.G sNQ = .int (-(Q : ℤ)) :: LN)
    (hPA : t.G sPA = .int (vol A : ℤ) :: LP) (hQQ : t.G sQQ = .int (Q : ℤ) :: LQ)
    (hPC : t.G sPC = .int (vol C : ℤ) :: LC') :
    FSp (shPU ac.length) t (postSt t (shiftArr Λ i 1 c 0 xs) R LA LC LM LAM)
      (cShUF ac.length (vol A * (Q * vol C)) w Bb) := by
  have hlen3 : xs.length = vol A * Q * vol C := by rw [hlen, hsh, vol_append, vol_cons]; ring
  have H := shF_generic rotP _ A C t xs (shiftArr Λ i 1 c 0 xs) (zsz ((2 * Q : ℕ) : ℤ)) Bb R
    hB1 hQ1 hP1 hV le_rfl h0 ac hac hvol hS hNQ hPA hQQ hPC (fun u h0' h1 h2 h4 h14 => by
      have R5 := rotP_fspec u xs (offs Λ c A) (vol A) Q (vol C) w Bb R (t.G 1) (t.G 2) (t.G 4)
        (t.G 14) (fun p => le_of_lt (ZMod.val_lt _)) hlen3 hb hB1 hQ1 hP1 hV h0' h1 h2 h4
        (by rw [h14, htbl, tbl_eq_offs])
      rw [← shiftArr_eq_rot Λ i c hc A C hsh hA] at R5
      exact R5)
  refine H.mono (sh_costF (zszN _) hP1 hQ1 hB1 ?_)
  rw [← hvol]; exact genPU_cost_le _ ac (fun p hp => (hac p hp).1)

/-- **Fine uniform table shift, coefficient `-1`.** -/
theorem shNU_fspec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : IState HS) (xs : List ℤ) (w Bb : ℕ) (R : List Item)
    (hlen : xs.length = vol sh) (hb : Bnd w xs) (hB1 : 1 ≤ vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ vol A) (hV : zsz ((vol A * (Q * vol C) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : vol (ac.map Prod.fst) = vol A) (htbl : NLogN.KIL.tbl Q ac = NLogN.KIL.tbl Q (A.zip (csOf Λ c A)))
    {LA LC LM LAM LN LP LQ LC' : List Item}
    (hS : StgOK t Q ac LA LC LM LAM) (hNQ : t.G sNQ = .int (-(Q : ℤ)) :: LN)
    (hPA : t.G sPA = .int (vol A : ℤ) :: LP) (hQQ : t.G sQQ = .int (Q : ℤ) :: LQ)
    (hPC : t.G sPC = .int (vol C : ℤ) :: LC') :
    FSp (shNU ac.length) t (postSt t (shiftArr Λ i (-1) c 0 xs) R LA LC LM LAM)
      (cShUF ac.length (vol A * (Q * vol C)) w Bb) := by
  have hlen3 : xs.length = vol A * Q * vol C := by rw [hlen, hsh, vol_append, vol_cons]; ring
  have H := shF_generic NLogN.KIL.negP _ A C t xs (shiftArr Λ i (-1) c 0 xs) (zsz ((2 * Q : ℕ) : ℤ)) Bb R
    hB1 hQ1 hP1 hV le_rfl h0 ac hac hvol hS hNQ hPA hQQ hPC (fun u h0' h1 h2 h4 h14 => by
      have R5 := negP_fspec u xs (offs Λ c A) (vol A) Q (vol C) w Bb R (t.G 1) (t.G 2) (t.G 4)
        (t.G 14) (fun p => ZMod.val_lt _) hlen3 hb hB1 hQ1 hP1 hV h0' h1 h2 h4
        (by rw [h14, htbl, tbl_eq_offs])
      rw [← shiftArr_neg_eq_ref Λ i c hc A C hsh hA] at R5
      exact R5)
  refine H.mono (sh_costF (zszN _) hP1 hQ1 hB1 ?_)
  rw [← hvol]; exact genPU_cost_le _ ac (fun p hp => (hac p hp).1)

end Body

end KFD

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
theorem solution [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : AModel.Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k d : ℕ) (neg : Bool) (hk : 1 ≤ k) (hkQ : k ≤ Q)
    (hd : 1 ≤ d) (hdQ : d ≤ Q) (hQk : Nat.Coprime Q k) (hQd : Nat.Coprime Q d)
    (t : NLogN.IState NLogN.HS) (xs : List ℤ) (w Bb : ℕ) (R : List NLogN.Item)
    (hlen : xs.length = AModel.vol sh) (hb : NLogN.Bnd w xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : NLogN.zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hvol : AModel.vol (ac.map Prod.fst) = AModel.vol A) (htbl : NLogN.KIL.tbl Q ac = NLogN.KIL.tbl Q (A.zip (NLogN.KIL.csOf Λ c A)))
    {LA LC LM LAM LN : List NLogN.Item}
    (hS : NLogN.KIL.StgOK t Q ac LA LC LM LAM) (hNQ : t.G NLogN.KIL.sNQ = .int (-(Q : ℤ)) :: LN)
    (hp : NLogN.KIL.StP t (AModel.vol A) Q (AModel.vol C)) :
    NLogN.KFD.FSp (NLogN.KIL.shFracU k d ac.length neg) t
      (NLogN.KIL.postSt t (AModel.shiftArr Λ i (NLogN.KIL.fracU Q k d neg) c 0 xs) R LA LC LM LAM)
      (NLogN.KFD.cShFF k d ac.length (AModel.vol A * (Q * AModel.vol C)) w Bb) := by
  set V := AModel.vol A * (Q * AModel.vol C)
  have hle : ∀ m : ℕ, m ≤ V → NLogN.zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have zA := hle (AModel.vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ (by omega)) (Nat.le_mul_of_pos_left _ hP1))
  have hlen3 : xs.length = AModel.vol A * Q * AModel.vol C := by
    rw [hlen, hsh, AModel.vol_append, AModel.vol_cons]; ring
  have S1 := NLogN.KFD.fdivPU_fspec t xs (AModel.vol A) Q d (AModel.vol C) w Bb R hlen3 hb hd hQ1 hB1 hQd
    (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hQ2) zQ zA hV h0 hp
  set mid := AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (NLogN.KIL.divAddr Q d) 0 xs
  have S2 := NLogN.KFD.fmulPU_fspec (t.upd 0 (NLogN.ints mid ++ R)) mid (AModel.vol A) Q k (AModel.vol C) w Bb R
    (by rw [AModel.length_pull]; simp [AModel.vol]; ring) (NLogN.KIL.bnd_pull hb) hk hQ1 hB1 hQk
    (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hQ2) zQ zA hV (by simp) (hp.upd0 _)
  rw [NLogN.IState.upd_upd_same] at S2
  set mid2 := AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (NLogN.KIL.mulAddr Q k) 0 mid
  have hv : AModel.vol sh = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [hsh, AModel.vol_append, AModel.vol_cons]; simp [AModel.vol]
  have hml : mid2.length = AModel.vol sh := by rw [AModel.length_pull, hv]
  have hmb : NLogN.Bnd w mid2 := NLogN.KIL.bnd_pull (NLogN.KIL.bnd_pull hb)
  obtain ⟨LP, hPA⟩ := hp.hA
  obtain ⟨LQ, hQQ⟩ := hp.hQ
  obtain ⟨LC', hPC⟩ := hp.hB
  cases neg
  · have S3 := NLogN.KFD.shPU_fspec Λ i c hc A C hsh hA (t.upd 0 (NLogN.ints mid2 ++ R)) mid2 w Bb R hml hmb
      hB1 hQ1 hP1 hV (by simp) ac hac hvol htbl (hS.upd0 _)
      (by simpa (config := {decide := true}) using hNQ)
      (by simpa (config := {decide := true}) using hPA) (by simpa (config := {decide := true}) using hQQ)
      (by simpa (config := {decide := true}) using hPC)
    rw [← NLogN.KIL.shiftArr_frac_eq Λ i c hc A C hsh hA k d (by omega) hQk hQd, NLogN.KIL.postSt_upd0] at S3
    simp only [NLogN.KIL.fracU, Bool.false_eq_true, if_false] at S3 ⊢
    exact (S1.seq S2).seq S3
  · have S3 := NLogN.KFD.shNU_fspec Λ i c hc A C hsh hA (t.upd 0 (NLogN.ints mid2 ++ R)) mid2 w Bb R hml hmb
      hB1 hQ1 hP1 hV (by simp) ac hac hvol htbl (hS.upd0 _)
      (by simpa (config := {decide := true}) using hNQ)
      (by simpa (config := {decide := true}) using hPA) (by simpa (config := {decide := true}) using hQQ)
      (by simpa (config := {decide := true}) using hPC)
    rw [← NLogN.KIL.shiftArr_negfrac_eq Λ i c hc A C hsh hA k d (by omega) hQk hQd, NLogN.KIL.postSt_upd0] at S3
    exact (S1.seq S2).seq S3
end
