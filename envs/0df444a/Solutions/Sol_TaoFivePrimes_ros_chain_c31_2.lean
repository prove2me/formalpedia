theorem child31_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu138.lin : ℝ) ≤ (S : ℝ) * logProd gu138.lo) :
    (gu141.lfin : ℝ) ≤ (S : ℝ) * logProd gu141.top ∧
      (∀ x : ℝ, (gu138.lo : ℝ) < x → x ≤ (gu141.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u138 hγ hstate
  have s1 := sol_u139 hγ (by simpa [gu138, gu139] using s0.1)
  have s2 := sol_u140 hγ (by simpa [gu139, gu140] using s1.1)
  have s3 := sol_u141 hγ (by simpa [gu140, gu141] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu138.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu139.lo : ℝ) < x := by
        have hb : (gu138.top : ℝ) = (gu139.lo : ℝ) := by simp [gu138, gu139]
        linarith
    by_cases h1 : x ≤ (gu139.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu140.lo : ℝ) < x := by
          have hb : (gu139.top : ℝ) = (gu140.lo : ℝ) := by simp [gu139, gu140]
          linarith
      by_cases h2 : x ≤ (gu140.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu141.lo : ℝ) < x := by
            have hb : (gu140.top : ℝ) = (gu141.lo : ℝ) := by simp [gu140, gu141]
            linarith
        exact s3.2 x hx3 htop

