      (expPosCost (P + R) (BW A) (BW A) R)) + (cClr A +
  (cStG A lam (.reg 4) + (cClr A + (cStG A lam giE + (cClr A +
  (cSt A lam (cCall (.reg 20) (.reg 22) jDE (.lit 0) (BW A) (expNegCost P (BW A) (BW A))) +
