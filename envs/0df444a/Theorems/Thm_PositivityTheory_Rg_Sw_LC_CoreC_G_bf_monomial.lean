theorem PositivityTheory.Rg.Sw.LC.CoreC.G.bf_monomial (w : (τ →₀ ℕ) → ℂ) (s t : τ →₀ ℕ) (a b : ℂ) :
    bf w (monomial s a) (monomial t b) = if s = t then a * b * w s else 0 := by sorry
