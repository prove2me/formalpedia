set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u v

theorem MonoidAlgebra.ker_counitAlgHom_eq_span_of_closure_eq_top {𝒪 : Type u} [CommRing 𝒪] {G : Type v} [Group G] (S : Set G) (hS : Subgroup.closure S = ⊤) : RingHom.ker (Bialgebra.counitAlgHom 𝒪 (MonoidAlgebra 𝒪 G)) = Ideal.span ((fun g => MonoidAlgebra.of 𝒪 G g - 1) '' S) := by sorry
