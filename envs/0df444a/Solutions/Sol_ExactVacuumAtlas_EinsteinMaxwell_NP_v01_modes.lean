/-! ### Regularity: `C^∞` mode fields and genuine derivatives -/

section Smooth

theorem contDiff_phaseP (om mm : ℝ) : ContDiff ℝ ∞ (phaseP om mm) := by
  unfold phaseP
  have h0 : ContDiff ℝ ∞ (fun x : Pt 4 => ((x 0 : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ 0)
  have h3 : ContDiff ℝ ∞ (fun x : Pt 4 => ((x 3 : ℝ) : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ 3)
  exact ((contDiff_const.mul h0).neg.add (contDiff_const.mul h3)).cexp

theorem contDiff_toRT : ContDiff ℝ ∞ toRT := by
  refine contDiff_pi.2 (fun k => ?_)
  fin_cases k
  · exact contDiff_apply ℝ ℝ 1
  · exact contDiff_apply ℝ ℝ 2

variable (p : Hintz2026.SubextremalKN) (om mm : ℝ) {u : (Fin 2 → ℝ) → ℂ}

/-- A `C^∞` (order `∞`) amplitude on III's `U p` gives a `C^∞` mode field on the four-dimensional exterior. -/
theorem contDiffOn_modeField (hu : ContDiffOn ℝ ∞ u (Hintz2026.U p)) :
    ContDiffOn ℝ ∞ (modeField om mm u) (domKN p.M p.a p.Q) :=
  (contDiff_phaseP om mm).contDiffOn.mul
    (hu.comp contDiff_toRT.contDiffOn (fun x hx => (mem_U_iff p x).2 hx))

/-- For a `C^∞` amplitude, every `cpdC` of the mode field on the exterior is a genuine slice derivative. -/
theorem hasDerivAt_modeField (hu : ContDiffOn ℝ ∞ u (Hintz2026.U p)) {x : Pt 4}
    (hx : x ∈ domKN p.M p.a p.Q) (i : Fin 4) :
    HasDerivAt (fun s : ℝ => modeField om mm u (Function.update x i s)) (cpdC i (modeField om mm u) x) (x i) :=
  hasDerivAt_cpdC (KN.isOpen_domKN p.M p.a p.Q) (contDiffOn_modeField p om mm hu) hx i

end Smooth

end ExactVacuumAtlas.EinsteinMaxwell.NP
