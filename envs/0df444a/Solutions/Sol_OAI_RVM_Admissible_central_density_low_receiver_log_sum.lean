lemma geometry_radial_balance {I R p θ φ H : ℝ}
    (hI : 0<I) (hR : 0<R) (hp : 0<p) (hθ : 0<θ) (hφ : 0<φ) (hH : 0<H) :
    Summable (fun k : ℤ=>min (I*p^3*θ*φ^4*(H*(2:ℝ)^k))
      (R^2/(p*θ*(H*(2:ℝ)^k)))) ∧
