namespace NLogN.KIL

open IntMul RS AModel

theorem stg_zero (Q a : ℕ) {T : List ℤ} (hT : InR Q T) :
    stg Q a 0 T = (List.replicate a T).flatten := by
  unfold stg
  have hs : shT Q 0 T = T := by
    unfold shT
    conv_rhs => rw [← List.map_id T]
    refine List.map_congr_left fun v hv => ?_
    simp only [add_zero, id]
    exact Int.emod_eq_of_lt (hT v hv).1 (hT v hv).2
  simp only [Nat.cast_zero, zero_mul, Int.zero_emod, hs]
  induction a with
  | zero => simp
  | succ a ih => rw [List.range_succ, List.flatMap_append, ih, List.replicate_succ']; simp

theorem flatten_replicate_replicate {α : Type*} (a b : ℕ) (T : List α) :
    (List.replicate a (List.replicate b T).flatten).flatten = (List.replicate (a * b) T).flatten := by
  induction a with
  | zero => simp
  | succ a ih =>
    rw [List.replicate_succ, List.flatten_cons, ih, Nat.succ_mul, ← List.flatten_append,
      ← List.replicate_add, Nat.add_comm]

theorem InR_flatten_replicate {Q : ℕ} {T : List ℤ} (hT : InR Q T) (a : ℕ) :
    InR Q (List.replicate a T).flatten := by
  intro v hv
  simp only [List.mem_flatten, List.mem_replicate] at hv
  obtain ⟨l, ⟨-, rfl⟩, hl⟩ := hv
  exact hT v hl

/-- A run of control-`0` fields collapses to one field of its volume. -/
theorem tbl_zeros {Q : ℕ} (hQ : 0 < Q) (rest : List (ℕ × ℕ)) :
    ∀ L1 : List ℕ, NLogN.KIL.tbl Q (L1.map (fun a => (a, 0)) ++ rest) = NLogN.KIL.tbl Q ((vol L1, 0) :: rest)
  | [] => by
    simp only [List.map_nil, List.nil_append, NLogN.KIL.tbl, vol, List.prod_nil]
    rw [stg_zero Q 1 (InR_tbl hQ rest)]; simp
  | a :: L1 => by
    simp only [List.map_cons, List.cons_append, NLogN.KIL.tbl]
    rw [show NLogN.KIL.tbl Q (L1.map (fun a => (a, 0)) ++ rest) = NLogN.KIL.tbl Q ((vol L1, 0) :: rest) from
      tbl_zeros hQ rest L1]
    simp only [NLogN.KIL.tbl]
    rw [stg_zero Q _ (InR_tbl hQ rest), stg_zero Q _ (InR_flatten_replicate (InR_tbl hQ rest) _),
      stg_zero Q _ (InR_tbl hQ rest), flatten_replicate_replicate, vol_cons]

/-- The table of `pre ++ X` only depends on the table of `X`. -/
theorem tbl_app_congr {Q : ℕ} {X Y : List (ℕ × ℕ)} (h : NLogN.KIL.tbl Q X = NLogN.KIL.tbl Q Y) :
    ∀ pre : List (ℕ × ℕ), NLogN.KIL.tbl Q (pre ++ X) = NLogN.KIL.tbl Q (pre ++ Y)
  | [] => h
  | p :: pre => by
    obtain ⟨a, c⟩ := p
    simp only [List.cons_append, NLogN.KIL.tbl]
    rw [tbl_app_congr h pre]

end NLogN.KIL

