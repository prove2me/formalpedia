abbrev Window := Σ N : ℕ, (Fin N → Fin 2) × (Fin N → Bool)
abbrev History := List Window

def windowList (w : Window) : List (Fin 2 × Bool) :=
  List.ofFn (fun i : Fin w.1 => (w.2.1 i, w.2.2 i))

def offeredList (j : Fin 2) (l : List (Fin 2 × Bool)) : ℕ :=
  l.countP (fun a => a.1 == j)

def enabledList (j : Fin 2) (l : List (Fin 2 × Bool)) : ℕ :=
  l.countP (fun a => (a.1 == j) && a.2)

def winOffered (j : Fin 2) (w : Window) : ℕ :=
  offeredList j (windowList w)

def winEnabled (j : Fin 2) (w : Window) : ℕ :=
  enabledList j (windowList w)

def histOffered (j : Fin 2) (h : History) : ℕ :=
  offeredList j (h.flatMap windowList)

def histEnabled (j : Fin 2) (h : History) : ℕ :=
  enabledList j (h.flatMap windowList)

@[simp] lemma histOffered_nil (j : Fin 2) : histOffered j [] = 0 := rfl
@[simp] lemma histEnabled_nil (j : Fin 2) : histEnabled j [] = 0 := rfl

lemma histOffered_append (j : Fin 2) (h₁ h₂ : History) :
    histOffered j (h₁ ++ h₂) = histOffered j h₁ + histOffered j h₂ := by
  simp [histOffered, offeredList, List.flatMap_append, List.countP_append]

lemma histEnabled_append (j : Fin 2) (h₁ h₂ : History) :
    histEnabled j (h₁ ++ h₂) = histEnabled j h₁ + histEnabled j h₂ := by
  simp [histEnabled, enabledList, List.flatMap_append, List.countP_append]

@[simp] lemma histOffered_singleton (j : Fin 2) (w : Window) :
    histOffered j [w] = winOffered j w := by
  simp [histOffered, winOffered]

@[simp] lemma histEnabled_singleton (j : Fin 2) (w : Window) :
    histEnabled j [w] = winEnabled j w := by
  simp [histEnabled, winEnabled]

lemma enabledList_le_offeredList (j : Fin 2) (l : List (Fin 2 × Bool)) :
    enabledList j l ≤ offeredList j l := by
  unfold enabledList offeredList
  refine List.countP_mono_left fun a _ ha => ?_
  exact (Bool.and_eq_true _ _).mp ha |>.1

lemma winEnabled_le_winOffered (j : Fin 2) (w : Window) :
    winEnabled j w ≤ winOffered j w :=
  enabledList_le_offeredList j (windowList w)

lemma histEnabled_le_histOffered (j : Fin 2) (h : History) :
    histEnabled j h ≤ histOffered j h :=
  enabledList_le_offeredList j (h.flatMap windowList)

private lemma list_countP_ofFn {α : Type*} (N : ℕ) (f : Fin N → α) (p : α → Bool) :
    (List.ofFn f).countP p = (Finset.univ.filter (fun i : Fin N => p (f i) = true)).card := by
  induction N with
  | zero => simp
  | succ n ih =>
    rw [List.ofFn_succ, List.countP_cons, ih, Fin.card_filter_univ_succ]
    cases p (f 0) <;> simp [Nat.add_comm]

lemma winOffered_eq_card_filter (j : Fin 2) (w : Window) :
    winOffered j w = (Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = j)).card := by
  rcases w with ⟨N, cls, coin⟩
  simp [winOffered, offeredList, windowList, list_countP_ofFn]

lemma winEnabled_eq_card_filter (j : Fin 2) (w : Window) :
    winEnabled j w =
      (Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = j ∧ w.2.2 i = true)).card := by
  rcases w with ⟨N, cls, coin⟩
  simp [winEnabled, enabledList, windowList, list_countP_ofFn]

lemma winOffered_add (w : Window) :
    winOffered 0 w + winOffered 1 w = w.1 := by
  rw [winOffered_eq_card_filter, winOffered_eq_card_filter]
  have hdisj : Disjoint
      (Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = 0))
      (Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = 1)) := by
    rw [Finset.disjoint_filter]
    intro i _ h0 h1
    rw [h0] at h1
    exact absurd h1 (by decide)
  have hunion :
      Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = 0) ∪
        Finset.univ.filter (fun i : Fin w.1 => w.2.1 i = 1) = Finset.univ := by
    ext i
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and, iff_true]
    exact fin2_eq_or (w.2.1 i)
  rw [← Finset.card_union_of_disjoint hdisj, hunion, Finset.card_fin]

/-- Natural-number capacity replay step: `(cap, z₁, z₂)`. -/
def replayStep (st : ℕ × ℕ × ℕ) (a : Fin 2 × Bool) : ℕ × ℕ × ℕ :=
  if a.2 && decide (1 ≤ st.1) then
    if a.1 = 0 then (st.1 - 1, st.2.1 + 1, st.2.2)
    else (st.1 - 1, st.2.1, st.2.2 + 1)
  else st

def replayListAux (st : ℕ × ℕ × ℕ) (l : List (Fin 2 × Bool)) : ℕ × ℕ × ℕ :=
  l.foldl replayStep st

@[simp] lemma replayListAux_nil (st : ℕ × ℕ × ℕ) : replayListAux st [] = st := rfl
@[simp] lemma replayListAux_cons (st : ℕ × ℕ × ℕ) (a : Fin 2 × Bool) (tl : List (Fin 2 × Bool)) :
    replayListAux st (a :: tl) = replayListAux (replayStep st a) tl := rfl
lemma replayListAux_append (st : ℕ × ℕ × ℕ) (l₁ l₂ : List (Fin 2 × Bool)) :
    replayListAux st (l₁ ++ l₂) = replayListAux (replayListAux st l₁) l₂ := by
  simp [replayListAux, List.foldl_append]

def replayList (cap : ℕ) (l : List (Fin 2 × Bool)) : ℕ × ℕ × ℕ :=
  replayListAux (cap, 0, 0) l

def replayHistory (T : ℕ) (h : History) : ℕ × ℕ × ℕ :=
  replayList T (h.flatMap windowList)

def capAfter (T : ℕ) (h : History) : ℕ := (replayHistory T h).1
def admHigh (T : ℕ) (h : History) : ℕ := (replayHistory T h).2.1
def admLow (T : ℕ) (h : History) : ℕ := (replayHistory T h).2.2

noncomputable def histRev (T : ℕ) (r₁ r₂ : ℝ) (h : History) : ℝ :=
  r₁ * (admHigh T h : ℝ) + r₂ * (admLow T h : ℝ)

@[simp] lemma replayHistory_nil (T : ℕ) : replayHistory T [] = (T, 0, 0) := rfl
@[simp] lemma capAfter_nil (T : ℕ) : capAfter T [] = T := rfl
@[simp] lemma admHigh_nil (T : ℕ) : admHigh T [] = 0 := rfl
@[simp] lemma admLow_nil (T : ℕ) : admLow T [] = 0 := rfl
@[simp] lemma histRev_nil (T : ℕ) (r₁ r₂ : ℝ) : histRev T r₁ r₂ [] = 0 := by
  simp [histRev]

@[simp] lemma enabledList_nil (j : Fin 2) : enabledList j [] = 0 := rfl
lemma enabledList_cons (j : Fin 2) (a : Fin 2 × Bool) (tl : List (Fin 2 × Bool)) :
    enabledList j (a :: tl) = enabledList j tl + (if (a.1 == j) && a.2 then 1 else 0) := by
  simp [enabledList, List.countP_cons]

lemma replayListAux_invariants (st : ℕ × ℕ × ℕ) (l : List (Fin 2 × Bool)) :
    let out := replayListAux st l
    out.1 ≤ st.1 ∧
      st.2.1 ≤ out.2.1 ∧
      st.2.2 ≤ out.2.2 ∧
      out.1 + out.2.1 + out.2.2 = st.1 + st.2.1 + st.2.2 ∧
      out.2.1 ≤ st.2.1 + enabledList 0 l ∧
      out.2.2 ≤ st.2.2 + enabledList 1 l ∧
      (1 ≤ out.1 → out.2.1 = st.2.1 + enabledList 0 l ∧ out.2.2 = st.2.2 + enabledList 1 l) := by
  induction l generalizing st with
  | nil =>
    simp
  | cons a tl ih =>
    rw [replayListAux_cons, enabledList_cons, enabledList_cons]
    have hstep := ih (replayStep st a)
    dsimp only at hstep ⊢
    rcases st with ⟨c, z₁, z₂⟩
    rcases a with ⟨j, b⟩
    by_cases hb : b = true
    · subst hb
      by_cases hc : 1 ≤ c
      · rcases fin2_eq_or j with rfl | rfl
        · have hs : replayStep (c, z₁, z₂) (0, true) = (c - 1, z₁ + 1, z₂) := by
            simp [replayStep, hc]
          rw [hs] at hstep ⊢
          dsimp only at hstep
          have he0 : ((0 : Fin 2) == 0 && true) = true := rfl
          have he1 : ((0 : Fin 2) == 1 && true) = false := rfl
          rw [he0, he1]
          simp only [↓reduceIte, Bool.false_eq_true]
          rcases hstep with ⟨h1, h2, h3, h4, h5, h6, h7⟩
          refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, fun hp => ?_⟩
          have ⟨e1, e2⟩ := h7 hp
          exact ⟨by omega, by omega⟩
        · have hs : replayStep (c, z₁, z₂) (1, true) = (c - 1, z₁, z₂ + 1) := by
            simp [replayStep, hc]
          rw [hs] at hstep ⊢
          dsimp only at hstep
          have he0 : ((1 : Fin 2) == 0 && true) = false := rfl
          have he1 : ((1 : Fin 2) == 1 && true) = true := rfl
          rw [he0, he1]
          simp only [↓reduceIte, Bool.false_eq_true]
          rcases hstep with ⟨h1, h2, h3, h4, h5, h6, h7⟩
          refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, fun hp => ?_⟩
          have ⟨e1, e2⟩ := h7 hp
          exact ⟨by omega, by omega⟩
      · have hs : replayStep (c, z₁, z₂) (j, true) = (c, z₁, z₂) := by
          simp [replayStep, hc]
        rw [hs] at hstep ⊢
        rcases hstep with ⟨h1, h2, h3, h4, h5, h6, _⟩
        refine ⟨h1, h2, h3, h4, by omega, by omega, fun hp => by omega⟩
    · have hbf : b = false := by cases b <;> tauto
      subst hbf
      have hs : replayStep (c, z₁, z₂) (j, false) = (c, z₁, z₂) := by
        simp [replayStep]
      rw [hs] at hstep ⊢
      simp only [Bool.and_false, Bool.false_eq_true, ↓reduceIte, add_zero]
      exact hstep

lemma replayListAux_shift (c z₁ z₂ : ℕ) (l : List (Fin 2 × Bool)) :
    replayListAux (c, z₁, z₂) l =
      let out := replayList c l
      (out.1, z₁ + out.2.1, z₂ + out.2.2) := by
  induction l generalizing c z₁ z₂ with
  | nil => simp [replayList]
  | cons a tl ih =>
    simp only [replayList, replayListAux_cons]
    rcases a with ⟨j, b⟩
    by_cases hb : b = true
    · subst hb
      by_cases hc : 1 ≤ c
      · rcases fin2_eq_or j with rfl | rfl
        · have hs1 : replayStep (c, z₁, z₂) (0, true) = (c - 1, z₁ + 1, z₂) := by
            simp [replayStep, hc]
          have hs2 : replayStep (c, 0, 0) (0, true) = (c - 1, 1, 0) := by
            simp [replayStep, hc]
          rw [hs1, hs2, ih (c - 1) (z₁ + 1) z₂, ih (c - 1) 1 0]
          ext <;> simp [replayList] <;> omega
        · have hs1 : replayStep (c, z₁, z₂) (1, true) = (c - 1, z₁, z₂ + 1) := by
            simp [replayStep, hc]
          have hs2 : replayStep (c, 0, 0) (1, true) = (c - 1, 0, 1) := by
            simp [replayStep, hc]
          rw [hs1, hs2, ih (c - 1) z₁ (z₂ + 1), ih (c - 1) 0 1]
          ext <;> simp [replayList] <;> omega
      · have hs1 : replayStep (c, z₁, z₂) (j, true) = (c, z₁, z₂) := by simp [replayStep, hc]
        have hs2 : replayStep (c, 0, 0) (j, true) = (c, 0, 0) := by simp [replayStep, hc]
        rw [hs1, hs2, ih c z₁ z₂]
        rfl
    · have hbf : b = false := by cases b <;> tauto
      subst hbf
      have hs1 : replayStep (c, z₁, z₂) (j, false) = (c, z₁, z₂) := by simp [replayStep]
      have hs2 : replayStep (c, 0, 0) (j, false) = (c, 0, 0) := by simp [replayStep]
      rw [hs1, hs2, ih c z₁ z₂]
      rfl

