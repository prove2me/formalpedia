  exact (ContDiffOn.sum fun c _ => ContDiffOn.sum fun d _ => ((hgi a c).mul (hh c d)).mul (hgi d b)).neg

variable {c₁ c₂} (hh₁ : ∀ i j, ContDiffOn ℝ ∞ (h₁ i j) U) (hh₂ : ∀ i j, ContDiffOn ℝ ∞ (h₂ i j) U)
