-- title:
--   Finite conorm raises valuations to e(w∣ v); contents correspond
-- statement:
--   Let $A$ and $B$ be commutative rings with an $A$-algebra structure on $B$, $K$ and $L$ fields, with $K$ the fraction field of $A$ and $L$ the fraction field of $B$, $A$ and $B$ Dedekind domains, $B$ integral over $A$, and the algebra maps arranged into scalar towers $A \to B \to L$ and $A \to K \to L$. Let $x$ be a unit of the finite adèle ring $\mathbb{A}_K^f$ of $A$ in $K$, and let $\beta =$ `finiteConorm`$: \mathbb{A}_K^f \to \mathbb{A}_L^f$ be the ring homomorphism obtained as a restricted-product map along $w \mapsto w \cap A$ whose component at a height-one prime $w$ of $B$ is the canonical map of adic completions $K_{w \cap A} \to L_w$ attached to the extension $w$ of $w \cap A$. Two assertions are made simultaneously. First, for every height-one prime $w$ of $B$, the valuation of the $w$-component of the image of $x$ under the induced map of unit groups equals the valuation of the $(w \cap A)$-component of $x$ raised to the power $e$, the ramification index (`ramificationIdx'`) of $w$ over $w \cap A$. Second, the ideal contents agree: the (finitely supported) product over height-one primes $w$ of $B$ of $w^{-\log |\beta(x)_w|}$, taken in the fractional ideals of $B$ in $L$, equals the product over height-one primes $v$ of $A$ of $(vB)^{-\log |x_v|}$, where $vB$ denotes the ideal of $B$ generated by the image of $v$ under $A \to B$ and $-\log$ is Mathlib's `WithZero.log` normalisation of the additive valuation.
--
--   This is the compatibility of the idèlic content (divisor) map with base change along an extension of Dedekind domains: locally the conorm multiplies valuations by the ramification index, and globally the content of a conorm idèle is the extension to $B$ of the content of the original idèle. It is used where idèle class groups and Artin maps are compared along an extension, for instance in the Herbrand-quotient computations and in the Artin-map computations of the Langlands–Tunnell argument.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_M4aHerbrand_Bridge_valued_finiteConorm_apply_and_finprod_pow_eq.lean

import Mathlib
import Definitions.Def_M4aHerbrand_FiniteConorm

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
set_option maxSynthPendingDepth 3
open IsDedekindDomain
open scoped nonZeroDivisors

theorem M4aHerbrand.Bridge.valued_finiteConorm_apply_and_finprod_pow_eq
    (A K L B : Type*) [CommRing A] [CommRing B] [Algebra A B] [Field K] [Field L]
    [Algebra A K] [IsFractionRing A K] [Algebra B L] [IsDedekindDomain A]
    [Algebra K L] [Algebra A L] [IsScalarTower A B L] [IsScalarTower A K L]
    [Algebra.IsIntegral A B] [IsFractionRing B L] [IsDedekindDomain B]
    (x : (FiniteAdeleRing A K)ˣ) :
    (∀ w : HeightOneSpectrum B,
      Valued.v (((Units.map (M4aHerbrand.Bridge.finiteConorm A K L B).toMonoidHom x : (FiniteAdeleRing B L)ˣ) :
        FiniteAdeleRing B L) w) =
        Valued.v ((x : FiniteAdeleRing A K) (w.under A)) ^ (w.under A).asIdeal.ramificationIdx' w.asIdeal) ∧
    ∏ᶠ w : HeightOneSpectrum B, (w.asIdeal : FractionalIdeal B⁰ L) ^
        (-(WithZero.log (Valued.v (((Units.map (M4aHerbrand.Bridge.finiteConorm A K L B).toMonoidHom x :
          (FiniteAdeleRing B L)ˣ) : FiniteAdeleRing B L) w)))) =
      ∏ᶠ v : HeightOneSpectrum A, ((v.asIdeal.map (algebraMap A B) : Ideal B) : FractionalIdeal B⁰ L) ^
        (-(WithZero.log (Valued.v ((x : FiniteAdeleRing A K) v)))) := by sorry
