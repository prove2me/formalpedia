/-- Killing an odd-order member of a generating pair leaves an even cyclic
quotient. Reducing its distinguished generator modulo two gives the character. -/
theorem abelianPairParity_of_even_card_of_odd_order
    {Q : Type*} [AddCommGroup Q] [Finite Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤)
    (horder : Odd (addOrderOf δ)) (heven : Even (Nat.card Q)) :
    ∃ χ : Q →+ ZMod 2, χ α = 1 ∧ χ δ = 0 := by
  obtain ⟨ψ, hψ⟩ := Couret.CayleyParity.exists_parity_of_even_card
    (α : Q ⧸ AddSubgroup.zmultiples δ)
    (abelian_quotient_zmultiples_generator_of_pair α δ hgen)
    (abelian_quotient_natCard_even_of_odd_order δ horder heven)
  refine ⟨ψ.comp (QuotientAddGroup.mk' (AddSubgroup.zmultiples δ)), hψ, ?_⟩
  change ψ (δ : Q ⧸ AddSubgroup.zmultiples δ) = 0
  rw [(QuotientAddGroup.eq_zero_iff δ).mpr (AddSubgroup.mem_zmultiples δ), map_zero]

variable {G : Type*} [AddCommGroup G]

/-- The parity construction only requires finiteness of the quotient by h,
generation, and odd order of d in that quotient. No condition on the order or
nonzeroness of h is used. -/
theorem abelianParity_of_even_quotient_of_odd_order (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : Odd (addOrderOf (d : G ⧸ AddSubgroup.zmultiples h)))
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (heven : Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε d = 0 ∧ ε h = 0 := by
  obtain ⟨χ, hχa, hχd⟩ := abelianPairParity_of_even_card_of_odd_order
    (a : G ⧸ AddSubgroup.zmultiples h) (d : G ⧸ AddSubgroup.zmultiples h)
    (abelianQuotient_generated_pair a d h hgen) horder heven
  refine ⟨χ.comp (QuotientAddGroup.mk' (AddSubgroup.zmultiples h)), hχa, hχd, ?_⟩
  change χ (h : G ⧸ AddSubgroup.zmultiples h) = 0
  rw [(QuotientAddGroup.eq_zero_iff h).mpr (AddSubgroup.mem_zmultiples h), map_zero]



/-- The exact order-three interface used by the directed Cayley family. -/
theorem abelianThreeParity_of_even_quotient (a d h : G)
    [Finite (G ⧸ AddSubgroup.zmultiples h)]
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (heven : Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    ∃ ε : G →+ ZMod 2, ε a = 1 ∧ ε d = 0 ∧ ε h = 0 := by
  apply abelianParity_of_even_quotient_of_odd_order a d h _ hgen heven
  rw [horder]
  exact ⟨1, rfl⟩



end Couret.CayleyDoublet


namespace Couret.CayleyDoublet

variable {G : Type*} [AddCommGroup G] [DecidableEq G] [Fintype G]

/-- Even quotient cardinality supplies the parity required by the certified
directed spectral bridge. The half-turn, exact order-three and global
generation hypotheses of this Cayley application are all retained. -/
theorem abelianThreeCospectral_of_even_quotient
    (a d h : G) (hhalf : h + h = 0) (hne : h ≠ 0)
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (heven : Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    (abelianCayleyMatrix (AbelianSource a d h)).charpoly =
      (abelianCayleyMatrix (AbelianTarget a d h)).charpoly := by
  obtain ⟨ε, ha, _, hh⟩ := abelianThreeParity_of_even_quotient a d h horder hgen heven
  exact abelianThreeCospectral_of_parity a d h hhalf hne horder ε ha hh

/-- The full proposed sufficient condition: either the already certified
isomorphism branch applies, or even quotient cardinality supplies parity.
The converse spectral classification is a separate obligation. -/
theorem p2m_local_abelianThreeCospectral_of_nongeneration_or_even_quotient
    (a d h : G) (hhalf : h + h = 0) (hne : h ≠ 0)
    (horder : addOrderOf (d : G ⧸ AddSubgroup.zmultiples h) = 3)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤)
    (hcase : AddSubgroup.closure ({a, h} : Set G) ≠ ⊤ ∨
      Even (Nat.card (G ⧸ AddSubgroup.zmultiples h))) :
    (abelianCayleyMatrix (AbelianSource a d h)).charpoly =
      (abelianCayleyMatrix (AbelianTarget a d h)).charpoly := by
  rcases hcase with hproper | heven
  · exact abelianThreeCospectral_of_nongeneration a d h hhalf hne horder hgen hproper
  · exact abelianThreeCospectral_of_even_quotient a d h hhalf hne horder hgen heven



end Couret.CayleyDoublet


