  -- reals
  have hhτ : (h : ℝ) ^ NLogN.KFS.τS ≤ (IntMul.OpenAI.Glue.ℓP n : ℝ) ^ τ := by
    have hτ : NLogN.KFS.τS = τ := by unfold NLogN.KFS.τS IntMul.OpenAI.RCost.τ; rw [inv_pow, one_div]
    rw [hτ]
