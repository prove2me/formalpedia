theorem sizeReduce_foldl_preserves_nu_above {n m : Nat}
    (k : Nat) (hk : k < n) (e : Fin n) :
    ∀ (xs : List (Fin k)) (s' : LLLState n m),
      (∀ l ∈ xs, l.val < e.val) →
      ((xs.foldl
          (fun state j =>
            let jFin : Fin n := ⟨j.val, Nat.lt_trans j.isLt hk⟩
            state.sizeReduceColumn jFin ⟨k, hk⟩ j.isLt)
          s').ν.getRow ⟨k, hk⟩).get e = (s'.ν.getRow ⟨k, hk⟩).get e := by sorry
