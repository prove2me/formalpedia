    have := carOut_offG b c zx (fun z hz => by have := abs_le.1 (hzx z hz).1; linarith)
    rw [hlx] at this; exact this
  have vB' : (carOut b zB : ℤ) - KG = VB := by
    have := carOut_offG_swap b c zx (fun z hz => by have := abs_le.1 (hzx z hz).2; linarith)
    rw [hlx] at this; exact this
  have vC' : (carOut b zC : ℤ) - KG = VC := by
    have := carOut_offG b c zy (fun z hz => by have := abs_le.1 (hzy z hz).1; linarith)
    rw [hly] at this; exact this
  have vE' : (carOut b zE : ℤ) - KG = VE := by
    have := carOut_offG_swap b c zy (fun z hz => by have := abs_le.1 (hzy z hz).2; linarith)
    rw [hly] at this; exact this
  have k1 := packStep vA vPA (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by rw [fok_mvK_eq]; decide) zA VA f2 (by simp +decide [hzA, hlx]) (by simp +decide [hf2, hf1]) (by simp +decide [hf2, hf1, hT.l]) reA gA vA' bVA
  rw [show f2 vPA = [] by simp +decide [hf2, hf1, hT.pa]] at k1
