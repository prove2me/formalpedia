open NLogN
open IntMul
theorem solution (N k M : ℕ) (a b : ℤ) (hN : 1 ≤ N) (hKM : 2 ^ k * M = N)
    (ha : 0 ≤ a ∧ a ≤ 2 ^ N) (hb : 0 ≤ b ∧ b ≤ 2 ^ N) :
    (2 ^ (2 ^ k * M) + NLogN.zev (2 ^ M) (NLogN.carZ M (NLogN.ncZ (2 ^ k) (NLogN.pcs M (2 ^ k) (NLogN.fold N a))
      (NLogN.pcs M (2 ^ k) (NLogN.fold N b))) 0).1 - 2 ^ N -
      (NLogN.carZ M (NLogN.ncZ (2 ^ k) (NLogN.pcs M (2 ^ k) (NLogN.fold N a)) (NLogN.pcs M (2 ^ k) (NLogN.fold N b))) 0).2) %
        (2 ^ N + 1) = (a * b) % (2 ^ N + 1) := by
  set A := NLogN.pcs M (2 ^ k) (NLogN.fold N a)
  set B := NLogN.pcs M (2 ^ k) (NLogN.fold N b)
  set C := NLogN.carZ M (NLogN.ncZ (2 ^ k) A B) 0 with hC
  have hsp := NLogN.carZ_spec M (NLogN.ncZ (2 ^ k) A B) 0
  rw [← hC, NLogN.length_ncZ, hKM] at hsp
  rw [hKM]
  apply NLogN.cast_eq_emod N
  have hz := NLogN.zev_ncZ N (2 ^ k) M hKM A B (NLogN.length_pcs _ _ _) (NLogN.length_pcs _ _ _)
  have hfa : ((NLogN.fold N a).natAbs) < 2 ^ (2 ^ k * M) := by
    rw [hKM]
    have := NLogN.fold_bound N a hN ha
    have : ((NLogN.fold N a).natAbs : ℤ) < ((2 ^ N : ℕ) : ℤ) := by
      rw [Int.natCast_natAbs]; push_cast; exact this
    exact_mod_cast this
  have hfb : ((NLogN.fold N b).natAbs) < 2 ^ (2 ^ k * M) := by
    rw [hKM]
    have := NLogN.fold_bound N b hN hb
    have : ((NLogN.fold N b).natAbs : ℤ) < ((2 ^ N : ℕ) : ℤ) := by
      rw [Int.natCast_natAbs]; push_cast; exact this
    exact_mod_cast this
  rw [NLogN.pcs_spec M _ _ hfa, NLogN.pcs_spec M _ _ hfb, NLogN.cast_fold, NLogN.cast_fold] at hz
  have h2 := NLogN.two_pow_eq_neg_one N
  have hc := congrArg (fun z : ℤ => (z : ZMod (2 ^ N + 1))) hsp
  simp only [add_zero] at hc
  push_cast at hc hz ⊢
  rw [h2] at hc ⊢
  linear_combination hz - hc
end
