/-- The total cost of the `J` pair, as a function of its leaf sizes. -/
def fullJ (pl : Plan6) (W N d NF Q kJ lam w s m B n R : ℕ) : ℕ :=
  (21 * 8001 + 1) + restJ pl.kA pl.kC pl.wA pl.wC W N d NF Q kJ lam w s m
    ((lam + 1) * (50 * PreT.cUu Q R W 0)) + (21 * (2 * (W + 1) + 2) + 1) + cDistAll B n +
    cTear B n + 4

