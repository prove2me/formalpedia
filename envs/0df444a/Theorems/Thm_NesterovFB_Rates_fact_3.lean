-- title:
--   Fact 3, p. 3 — for α > 3, Σ_{k≥1} k(Θ(x_k) − Θ(x*)) ≤ (α−1)E(1)/(2s(α−3))
-- statement:
--   Under the standing assumptions of §1 ($\Psi$ proper, lower semicontinuous and convex with values in $\mathbb R\cup\{+\infty\}$; $\Phi$ real, convex, continuously differentiable with $L$-Lipschitz gradient; $\Theta=\Psi+\Phi$; $0<s<1/L$; $(x_k)$ generated by algorithm (2)), assume $\alpha>3$, let $x^*$ minimize $\Theta$ and let $\mathcal E(k)$ be the energy (5). Then
--   $$\sum_{k=1}^{\infty}k\big(\Theta(x_k)-\Theta(x^*)\big)\le\frac{(\alpha-1)\,\mathcal E(1)}{2s(\alpha-3)} .$$
--
--   The summability of $k(\Theta(x_k)-\Theta(x^*))$ is what upgrades $O(k^{-2})$ to $o(k^{-2})$ in Theorem 1.
--
--   **Formalization Note.** The series has nonnegative terms, and the claim is stated as a bound on every partial sum $\sum_{k=1}^K$, which is equivalent and avoids the junk value of an infinite sum. Terms and bound are extended reals.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 3, Fact 3

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem fact_3 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 < α)
    (xstar : H) (hxstar : ∀ y, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ K : ℕ, ∑ k ∈ Finset.Icc 1 K, ((k : ℝ) : EReal) * (theta Ψ Φ (x k) - theta Ψ Φ xstar)
      ≤ (((α - 1) / (2 * s * (α - 3)) : ℝ) : EReal) * energy Ψ Φ α s x xstar 1 := by sorry

end NesterovFB.Rates
