-- title:
--   Regular Kähler differential with q-expansion p_f
-- statement:
--   Fix $M \in \mathbb{N}$, nonzero, and a subgroup $H \leq (\mathbb{Z}/M)^{\times}$, and let $\Gamma_H(M) =$ [`CohCarrier.GammaH M H`](def/CohCarrier_Level.html#L133) be the subgroup of $\mathrm{SL}(2,\mathbb{Z})$ obtained by pulling back $H$ along the homomorphism [`CohCarrier.gamma0Units`](def/CohCarrier_Level.html#L121) which sends $\gamma \in \Gamma_0(M)$ to the unit of $\mathbb{Z}/M$ given by its lower‑right entry, and then pushing forward along the inclusion $\Gamma_0(M) \hookrightarrow \mathrm{SL}(2,\mathbb{Z})$. Let $f$ be a cusp form of weight $2$ for the image of $\Gamma_H(M)$ in $\mathrm{GL}(2,\mathbb{R})$, and let $pf \in \mathbb{Z}[[q]]$ satisfy [`ModularCurve.IsIntegralQExp f pf`](def/ModularCurve_X1.html#L37), i.e. the image of $pf$ in $\mathbb{C}[[q]]$ is the $q$-expansion of $f$ of period $1$. Write $F =$ [`ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H)`](def/ModularCurve_X1.html#L101) for the subfield of the Laurent series field $\mathbb{Q}((q))$ generated over $\mathbb{Q}$ by the ratios $pg/ph$ of the integral $q$-expansions of two modular forms of a common weight on $\Gamma_H(M)$ (denominator nonzero), and let $\Theta =$ [`ModularCurve.diffQExp F`](def/ModularCurve_HeckeDifferential.html#L128) be the $F$-linear map $\Omega_{F/\mathbb{Q}} \to \mathbb{Q}((q))$ obtained by lifting to Kähler differentials the restriction to $F$ of the derivation [`ModularCurve.qEuler`](def/ModularCurve_HeckeDifferential.html#L40) of $\mathbb{Q}((q))$. The assertion is that there is a Kähler differential $\eta \in \Omega_{F/\mathbb{Q}}$ such that, first, $\Theta(\eta)$ is the Laurent series attached to the image of $pf$ in $\mathbb{Q}[[q]]$, and, second, for every valuation subring $O$ of $F$ containing $\mathbb{Q}$ (that is, containing $\mathrm{algebraMap}_{\mathbb{Q} \to F}(a)$ for all $a \in \mathbb{Q}$) there exist $c, t \in O$ with $\eta = c \cdot dt$, where $d =$ `KaehlerDifferential.D ℚ F`.
--
--   This is the construction of the differential of the first kind $\omega_f = f\,dq/q$ on the modular curve of level $\Gamma_H(M)$ over $\mathbb{Q}$ attached to a weight‑two cusp form with integral Fourier expansion: the first clause identifies its image under the $q$-expansion derivation with the given power series, and the second expresses regularity at every place of $F/\mathbb{Q}$, in the form that $\eta$ lies in the $O$-module generated by the exact differentials of elements of $O$. It feeds the refinement [`CuspForm.exists_forall_isRegularAt_of_not_mem_ssPlacesQExp_diffQExp_eq_intSeriesC_of_isIntegralQExp_residueField`](thm.html#CuspForm.exists_forall_isRegularAt_of_not_mem_ssPlacesQExp_diffQExp_eq_intSeriesC_of_isIntegralQExp_residueField), and so the passage from cusp forms to differentials on the curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_exists_kaehlerDifferential_diffQExp_eq_ofPowerSeries_and_forall_valuationSubring_of_isIntegralQExp.lean

import Mathlib
import Definitions.Def_ModularCurve_XHDifferentialsModL

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

attribute [-instance] DivisionRing.toRatAlgebra

open scoped MatrixGroups

theorem CuspForm.exists_kaehlerDifferential_diffQExp_eq_ofPowerSeries_and_forall_valuationSubring_of_isIntegralQExp
    (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ)
    (f : CuspForm (CohCarrier.GammaH M H) 2) (pf : PowerSeries ℤ) (hpf : ModularCurve.IsIntegralQExp f pf) :
    ∃ η : Ω[↥(ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H))⁄ℚ],
      ModularCurve.diffQExp (ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H)) η =
        HahnSeries.ofPowerSeries ℤ ℚ (pf.map (Int.castRingHom ℚ)) ∧

      ∀ O : ValuationSubring ↥(ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H)), (∀ a : ℚ, algebraMap ℚ ↥(ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H)) a ∈ O) →
        ∃ c ∈ O, ∃ t ∈ O, η = c • KaehlerDifferential.D ℚ ↥(ModularCurve.qExpFunctionFieldC ℚ (CohCarrier.GammaH M H)) t := by sorry
