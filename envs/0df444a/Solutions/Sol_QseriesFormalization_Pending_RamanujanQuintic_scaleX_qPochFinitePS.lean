theorem solution {R : Type*} [CommRing R] (c : R) (N : ℕ) :
    scaleX c (qPochFinitePS R N) =
      ∏ k ∈ Finset.range N,
        ((1 : R⟦X⟧) -
          PowerSeries.C (c ^ (k + 1)) * PowerSeries.X ^ (k + 1)) := by
  simp [qPochFinitePS, scaleX_oneSubXPow]
