    intro n
    rw [hkerres, ← hker]
    exact OrientAsm.forall_coeff_mem_of_map_eq_zero _ yy h n

  have hread := hgauss₁ a x yy hyk hpres
  rw [hxk, map_zero, zero_div] at hread

  let U : (ModularCurve.TwoChartModel A (↥K) j).Opens := (ModularCurve.TwoChart.ιFin A (↥K) j) ''ᵁ ⊤
  let g : Mdl₁.C ⟶ ModularCurve.TwoChartModel A (↥K) j := e₁.hom ≫ i₁.1 ≫ pullback.fst (ModularCurve.TwoChart.modelTo A (↥K) j) (specMap A k)
