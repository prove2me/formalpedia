/-- The counts of a block lie among the counts. -/
theorem oBaseAt_add_le {t : ℕ} (ht : t < X.m) : oBaseAt X cnt t + X.n * X.n ≤ cnt + oLen X := by
  have h1 := HostData.div_chunkCount_lt ht
  have : (t / X.chunkCount + 1) * (X.n * X.n) ≤ X.h * (X.n * X.n) := Nat.mul_le_mul_right _ h1
  rw [Nat.add_mul, Nat.one_mul] at this
  unfold oBaseAt oLen
  omega

/-- The next block, after the last chunk of a block. -/
theorem oBaseAt_succ {t : ℕ} (ht : t < X.m) :
    oBaseAt X cnt (t + 1) =
      if t % X.chunkCount + 1 = X.chunkCount then oBaseAt X cnt t + X.n * X.n
      else oBaseAt X cnt t := by
  have hpos : 0 < X.chunkCount := Nat.pos_of_ne_zero fun h => by
    rw [HostData.m, h, Nat.mul_zero] at ht
    omega
  unfold oBaseAt
  split_ifs with h
  · rw [(Nat.succ_div_mod_of_eq h).1, Nat.add_mul, Nat.one_mul, Nat.add_assoc]
  · rw [(Nat.succ_div_mod_of_ne hpos h).1]

