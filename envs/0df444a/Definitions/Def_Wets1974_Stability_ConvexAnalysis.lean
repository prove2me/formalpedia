-- title:
--   Polyhedra, polyhedral functions, and stability of a convex program under perturbation of $Ax=b$ (Definition 8.1)
-- statement:
--   This file fixes the convex-analysis vocabulary used by Wets (1974), §§7–8. Throughout, $x\in\mathbb R^n$, $A$ is a real $m\times n$ matrix and $b\in\mathbb R^m$.
--
--   1. A **convex polyhedron** in $\mathbb R^n$ is the solution set of finitely many weak linear inequalities,
--   $$P=\{x\in\mathbb R^n : Gx\ge \alpha\},\qquad G\in\mathbb R^{l\times n},\ \alpha\in\mathbb R^l,\ l\in\mathbb N .$$
--   The empty set and $\mathbb R^n$ are polyhedra ($l=0$).
--   2. $\operatorname{pos}A=\{Ax : x\ge 0\}$ is the convex cone spanned by the columns of $A$.
--   3. A function $g$ with values in $[-\infty,+\infty]$ is a **finite convex polyhedral function on a set $S$** if there are finitely many (at least one) affine functions $a_0,\dots,a_k$ such that
--   $$g(t)=\max_{0\le i\le k} a_i(t)\qquad\text{for every } t\in S;$$
--   in particular $g$ is real valued on $S$. A **finite concave polyhedral function** is defined in the same way with $\min$ in place of $\max$.
--   4. $K_1=\{x : Ax=b,\ x\ge 0\}$ is the set determined by the fixed constraints.
--   5. For $f:\mathbb R^n\to[-\infty,+\infty]$ and a set $D\subseteq\mathbb R^n$ (the domain of the objective), the program
--   $$\text{minimize } f(x)\quad\text{subject to } Ax=b,\ x\ge 0,\ x\in D$$
--   has **optimal value** $v=\inf\{f(x): x\in K_1\cap D\}\in[-\infty,+\infty]$, with $v=+\infty$ when $K_1\cap D=\emptyset$. The program is **finite** if $v$ is a real number.
--   6. Following Definition 8.1(iv), with the dual generated by perturbing the right-hand side $b$, the program is **stable** if its value $v$ is finite and it has an optimal Lagrange multiplier $\pi\in\mathbb R^m$ for the constraints $Ax=b$:
--   $$v\le f(x)+\pi\,(b-Ax)\qquad\text{for all } x\in D \text{ with } x\ge 0 .$$
--
--   Item 6 is the Kuhn–Tucker form of stability. By weak duality, it says exactly that the dual program $\sup\{u : u\le f(x)+\pi(b-Ax)\ \forall x\in D,\,x\ge 0\}$ (the paper's (8.3)) is solvable, at $(\pi,v)$, and has no duality gap; this is how the paper uses the word ("if a convex program is stable, it is also dualizable").
--
--   **Formalization Note** Values live in `EReal`; the infimum is `sInf` in `EReal`, so an empty feasible set gives $+\infty$ and an unbounded one $-\infty$. Row vectors of the paper ($\pi$) are written with `dotProduct`, $Ax$ with `Matrix.mulVec`. The paper never defines "polyhedral function"; the max-of-finitely-many-affine-functions reading is what its proofs produce ("linear on every simplicial conical cell", p. 328). Affine functions are `E →ᵃ[ℝ] ℝ`, so the notion applies on $\mathbb R^m$ and on the $(p,T)$ data space alike.
-- source:
--   Wets, Stochastic Programs with Fixed Recourse: The Equivalent Deterministic Program, SIAM Review 16(3), 1974, p. 314 (K₁), p. 328 (Corollary 7.3, "convex polyhedral function", pos A), p. 334 (Definition 8.1, (8.2), (8.3))

import Mathlib

namespace Wets1974.Stability

open Matrix

/-- A convex polyhedron in `ℝⁿ`: the solution set of finitely many weak linear inequalities
`G x ≥ α`. This includes `∅` and `ℝⁿ`. -/
def IsPolyhedron {n : ℕ} (S : Set (Fin n → ℝ)) : Prop :=
  ∃ (l : ℕ) (G : Matrix (Fin l) (Fin n) ℝ) (α : Fin l → ℝ), S = {x | ∀ i, α i ≤ (G *ᵥ x) i}

/-- `pos A = {t | t = A x, x ≥ 0}`, the convex cone generated by the columns of `A`. -/
def posCone {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) : Set (Fin m → ℝ) :=
  {t | ∃ x : Fin n → ℝ, (∀ j, 0 ≤ x j) ∧ A *ᵥ x = t}

/-- `g` is a *finite convex polyhedral function on `S`*: on `S` it is real valued and equal to
the pointwise maximum of finitely many (at least one) affine functions. -/
def IsFiniteConvexPolyhedralOn {E : Type*} [AddCommGroup E] [Module ℝ E]
    (g : E → EReal) (S : Set E) : Prop :=
  ∃ (k : ℕ) (a : Fin (k + 1) → E →ᵃ[ℝ] ℝ),
    ∀ t ∈ S, g t = ((Finset.univ.sup' Finset.univ_nonempty (fun i => a i t) : ℝ) : EReal)

/-- `g` is a *finite concave polyhedral function on `S`*: on `S` it is real valued and equal to
the pointwise minimum of finitely many (at least one) affine functions. -/
def IsFiniteConcavePolyhedralOn {E : Type*} [AddCommGroup E] [Module ℝ E]
    (g : E → EReal) (S : Set E) : Prop :=
  ∃ (k : ℕ) (a : Fin (k + 1) → E →ᵃ[ℝ] ℝ),
    ∀ t ∈ S, g t = ((Finset.univ.inf' Finset.univ_nonempty (fun i => a i t) : ℝ) : EReal)

/-- The fixed constraint set `K₁ = {x | A x = b, x ≥ 0}`, p. 314. -/
def K1 {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) : Set (Fin n → ℝ) :=
  {x | A *ᵥ x = b ∧ ∀ j, 0 ≤ x j}

/-- The optimal value `inf {f x | x ∈ D, A x = b, x ≥ 0}` of the program
"minimize `f` over `D` subject to `A x = b`, `x ≥ 0`", computed in the extended reals
(`+∞` if the feasible set is empty, `−∞` if `f` is unbounded below on it). -/
noncomputable def progValue {m n : ℕ} (f : (Fin n → ℝ) → EReal) (D : Set (Fin n → ℝ))
    (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) : EReal :=
  sInf (f '' (K1 A b ∩ D))

/-- The program "minimize `f` over `D` subject to `A x = b`, `x ≥ 0`" is *finite*: its optimal
value is a real number. -/
def IsFiniteProgram {m n : ℕ} (f : (Fin n → ℝ) → EReal) (D : Set (Fin n → ℝ))
    (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) : Prop :=
  ∃ v : ℝ, progValue f D A b = (v : EReal)

/-- Definition 8.1(iv), p. 334, for perturbations of the constraints `A x = b`: the program
"minimize `f` over `D` subject to `A x = b`, `x ≥ 0`" is *stable* if its value `v` is finite
and there is an optimal Lagrange multiplier `π` for `A x = b`, i.e.
`v ≤ f x + π (b − A x)` for every `x ∈ D` with `x ≥ 0`. -/
def IsStable {m n : ℕ} (f : (Fin n → ℝ) → EReal) (D : Set (Fin n → ℝ))
    (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) : Prop :=
  ∃ v : ℝ, progValue f D A b = (v : EReal) ∧
    ∃ π : Fin m → ℝ, ∀ x ∈ D, (∀ j, 0 ≤ x j) →
      (v : EReal) ≤ f x + ((π ⬝ᵥ (b - A *ᵥ x) : ℝ) : EReal)

end Wets1974.Stability


