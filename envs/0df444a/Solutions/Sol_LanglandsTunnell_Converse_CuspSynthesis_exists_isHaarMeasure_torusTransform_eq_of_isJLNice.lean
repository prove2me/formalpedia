  unfold truncOf
  rw [map_prod]
  rfl

private theorem t0042 (f : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ)
    (T : Finset (HeightOneSpectrum (𝓞 K))) : (truncOf f T)⁻¹ = truncOf (fun v => (f v)⁻¹) T := by
  unfold truncOf
  rw [← Finset.prod_inv_distrib]
