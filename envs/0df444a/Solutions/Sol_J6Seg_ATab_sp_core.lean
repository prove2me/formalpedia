/-! ## The pushes and the first assignments -/

theorem pushD_ok {W p t α pkA pkC bA bC : ℕ} (hB : PBnd W p t α pkA pkC bA bC) :
    ∀ x ∈ pushD pkA pkC, x.1 ∉ rg ∧ x.1.val < 56 ∧ x.2.ok = true ∧ x.2.lb ≤ 2 ^ W := by
  have h1 := hB.lA; have h2 := hB.lC; have h3 := hB.w32
  intro x hx
  simp only [pushD, List.mem_cons, List.mem_nil_iff, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    refine ⟨by dsimp only; decide, by dsimp only; decide, by dsimp only [E.ok]; decide, ?_⟩ <;>
    simp only [E.lb, Int.natAbs_natCast, nA2, nA4, nA8, nA18, max_le_iff] <;> omega

theorem asgA_ok (pkA pkC bA bC : ℕ) : okA (asgA pkA pkC bA bC) = true := by
  dsimp only [asgA, okA, E.ok]; decide

theorem asgA_lb {W p t α pkA pkC bA bC : ℕ} (hB : PBnd W p t α pkA pkC bA bC) :
    lbA (asgA pkA pkC bA bC) ≤ 2 ^ W := by
  have h1 := hB.lA; have h2 := hB.lC; have h3 := hB.w32; have h4 := hB.lbA; have h5 := hB.lbC
  simp only [asgA, lbA, E.lb, Int.natAbs_natCast, nA1, nA2, nA4, nA6, nA8, max_le_iff]
