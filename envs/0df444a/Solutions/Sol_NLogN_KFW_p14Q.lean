  set G := NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc NLogN.KFW.A0 with hGd
  have hG : 1 ≤ G := by rw [hGd]; exact (Gb_parts _ _ _ _).2.2.2
  have hDW : ∀ i ≤ k, DWl i ≤ 4 * (k + 1) ^ 2 * G ^ (k + 2) := by
    intro i hi
    have h1 : DWl i ≤ 4 * (i + 1) ^ 2 * G ^ (i + 2) := by
      have := DWb_le Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 i
      show DWb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 i ≤ _
      rw [Lc_eq] at this ⊢
      exact this
    have h2 : (i + 1) ^ 2 ≤ (k + 1) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h3 : G ^ (i + 2) ≤ G ^ (k + 2) := Nat.pow_le_pow_right hG (by omega)
    exact h1.trans (Nat.mul_le_mul (Nat.mul_le_mul_left 4 h2) h3)
  have hq := q0f_le D k
  have hc := lowF_le_count DWl _ k hDW (D - q0f D k)
  have h1 := lowF_one k (D - q0f D k)
  have h2 : (D - q0f D k) / mC ^ k < mC := by
    rw [Nat.div_lt_iff_lt_mul (mC_pow_pos k), ← pow_succ']
    omega
  have e1 : (k + 1) * mC = k * mC + mC := by ring
  have h3 : lowF (fun _ => 1) k (D - q0f D k) ≤ (k + 1) * mC := by omega
  have h4 : lowF DWl k (D - q0f D k) ≤ (k + 1) * mC * (4 * (k + 1) ^ 2 * G ^ (k + 2)) :=
