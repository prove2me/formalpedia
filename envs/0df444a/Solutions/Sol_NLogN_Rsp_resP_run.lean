theorem zerosP_states {X C : Fin HS} (hXC : X ≠ C) (n : Ex HS) (s : IState HS) (k : ℕ)
    (hn : n.eval s = k) :
    RepStates C n (push X (.lit 0)) s (fun j => s.upd X (ints (List.replicate j 0) ++ s.G X)) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, hXC.symm]
  h0 := by simp
  hG := fun k => by simp [hXC.symm]
  step := by
    intro j _
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro x
    simp only [withCtr, RS.run_push_G, IState.upd_G]
    by_cases h1 : x = X
    · subst h1; simp [hXC, Ex.eval, List.replicate_succ]
    · by_cases h2 : x = C
      · subst h2; simp [hXC.symm]
      · simp [h1, h2]

theorem zerosP_spec {X C : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56) (n : Ex HS)
    (hnc : n.Clean) (s : IState HS) (k : ℕ) (hno : n.ok s) (hn : n.eval s = k) :
    (NLogN.Rsp.zerosP X C n).ok s ∧ (NLogN.Rsp.zerosP X C n).run s = s.upd X (ints (List.replicate k 0) ++ s.G X) := by
  have H := NLogN.Rsp.zerosP_states hXC n s k hn
  refine ⟨H.ok hC5 hnc hno (fun _ _ => ⟨hX5, by decide, trivial⟩), ?_⟩
  rw [NLogN.Rsp.zerosP, H.run, hn, Int.toNat_natCast]

