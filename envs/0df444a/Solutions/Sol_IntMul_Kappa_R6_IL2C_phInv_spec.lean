/-!
# Round six, compact controls (I2C): the value-level mechanism

Colkitt's compact dirty controls, uniform variant (see `jain6/compact/DESIGN.md`).  The state of
one record is `(t, u, y)` (the temporary `T`, the control `U`, the target slot `Y`); the source
slot `x` is a parameter.  Radices: `W = 2^K` (slot segments), `R = 2^G` (compact digits);
`n` low selected positions `j_s = ρ + s K`.

* `dgt W s x = x / W^s % W`; `digits_add`: digit-wise addition without carries;
  `eq_of_digits`: equal low digits and equal high part give equal numbers.
* `segSum tf ru rv rw w0 u v n = Σ_{s<n} w0 rw^s tf (u / ru^s) (v / rv^s)` (the register loop).
* The offsets `oA` (`Y += Σ 2 z_s t_s 2^{j_s}`), `oB` (`Y += Σ z_s (1 - 2 t_s) 2^{j_s}`), `oS`
  (packed selected bits), `oC` (`Σ (y_s xor z_s) R^s`), `oT` (the ideal toggle).
* The pull maps `rT, rU, rY`, the inverse phase `phInv` and the whole pull composite `Psi`.
* **`Psi_good`**: on a good state `Psi` is the ideal map (toggle the `n` low selected bits of `y`
  by those of `x`); `Psi_bij`-type facts are proved at rank level.
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL2C

open Finset

/-! ## Digits -/

theorem dgt_zero (W x : ℕ) : dgt W 0 x = x % W := by simp [dgt]

theorem dgt_succ (W s x : ℕ) : dgt W (s + 1) x = dgt W s (x / W) := by
  simp only [dgt, pow_succ, Nat.div_div_eq_div_mul, mul_comm]

/-- **Digit-wise addition without carries.** -/
theorem digits_add (W : ℕ) (hW : 0 < W) : ∀ (n x : ℕ) (δ : ℕ → ℤ),
    (∀ s < n, 0 ≤ (dgt W s x : ℤ) + δ s ∧ (dgt W s x : ℤ) + δ s < W) →
    ∃ x' : ℕ, (x' : ℤ) = x + ∑ s ∈ range n, δ s * (W : ℤ) ^ s ∧
      (∀ s < n, (dgt W s x' : ℤ) = dgt W s x + δ s) ∧ x' / W ^ n = x / W ^ n
  | 0, x, δ, _ => ⟨x, by simp, fun s hs => absurd hs (by omega), rfl⟩
  | n + 1, x, δ, h => by
    obtain ⟨y', e1, e2, e3⟩ := digits_add W hW n (x / W) (fun s => δ (s + 1)) (fun s hs => by
      have := h (s + 1) (by omega); rwa [dgt_succ] at this)
    have h0 := h 0 (by omega)
    rw [dgt_zero] at h0
    set d0 : ℤ := ((x % W : ℕ) : ℤ) + δ 0
    have hd0 : 0 ≤ d0 := h0.1
    refine ⟨d0.toNat + W * y', ?_, ?_, ?_⟩
    · push_cast
      rw [Int.toNat_of_nonneg hd0, e1, sum_range_succ']
      have hx : (x : ℤ) = ((x % W : ℕ) : ℤ) + (W : ℤ) * ((x / W : ℕ) : ℤ) := by
        exact_mod_cast (Nat.mod_add_div x W).symm
      simp only [d0, pow_zero, mul_one, pow_succ]
      rw [hx, mul_add, mul_sum]
      have : ∀ s ∈ range n, (W : ℤ) * (δ (s + 1) * (W : ℤ) ^ s) = δ (s + 1) * ((W : ℤ) ^ s * W) :=
        fun s _ => by ring
      rw [sum_congr rfl this]
      ring
    · intro s hs
      have hlt : d0.toNat < W := by
        have := h0.2; omega
      have hdiv : (d0.toNat + W * y') / W = y' := by
        rw [Nat.add_mul_div_left _ _ hW, Nat.div_eq_of_lt hlt, zero_add]
      rcases s with _ | s
      · rw [dgt_zero, dgt_zero, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hlt,
          Int.toNat_of_nonneg hd0]
      · rw [dgt_succ, dgt_succ, hdiv, e2 s (by omega)]
    · have hlt : d0.toNat < W := by
        have := h0.2; omega
      have hdiv : (d0.toNat + W * y') / W = y' := by
        rw [Nat.add_mul_div_left _ _ hW, Nat.div_eq_of_lt hlt, zero_add]
      have k : ∀ a, a / W ^ (n + 1) = a / W / W ^ n := fun a => by
        rw [pow_succ, mul_comm, Nat.div_div_eq_div_mul]
      rw [k, k, hdiv, e3]

/-- A number with the same high part as one below `W^n (q+1)`. -/
theorem lt_of_hi {W n x : ℕ} (hW : 0 < W) : x < W ^ n * (x / W ^ n + 1) := by
  have h := Nat.lt_mul_div_succ x (pow_pos hW n)
  linarith [Nat.mul_comm (W ^ n) (x / W ^ n + 1)]

/-! ## The register-loop sum -/

/-- For an even radix, the parity of `u / W^s` is that of its digit. -/
theorem par_dgt {W : ℕ} (hW : 2 ∣ W) (s u : ℕ) : (u / W ^ s) % 2 = dgt W s u % 2 := by
  unfold dgt; rw [Nat.mod_mod_of_dvd _ hW]

/-! ## Parameters and the offsets -/

/-! ## Closed forms of the offsets -/

section Closed

variable {K ρ G n : ℕ}

theorem two_pow_dvd {G : ℕ} (hG : 1 ≤ G) : 2 ∣ 2 ^ G := dvd_pow_self 2 (by omega)

theorem cdiv (u W s : ℕ) : ((u : ℤ) / ((W : ℤ)) ^ s) = ((u / W ^ s : ℕ) : ℤ) := by
  rw [Int.natCast_div]; push_cast; rfl

theorem cdivG (u G s : ℕ) : ((u : ℤ) / ((2 : ℤ) ^ G) ^ s) = ((u / (2 ^ G) ^ s : ℕ) : ℤ) := by
  have := cdiv u (2 ^ G) s; push_cast at this; exact this

theorem cpar {W : ℕ} (hW : 2 ∣ W) (u s : ℕ) :
    ((u / W ^ s : ℕ) : ℤ) % 2 = ((dgt W s u % 2 : ℕ) : ℤ) := by
  exact_mod_cast par_dgt hW s u

theorem cmodG (u G s : ℕ) : ((u / (2 ^ G) ^ s : ℕ) : ℤ) % 2 ^ G = ((cdg G s u : ℕ) : ℤ) := by
  unfold cdg dgt; push_cast; rfl

theorem oA_eq (hG : 1 ≤ G) (u t : ℕ) : oA K ρ G n u t =
    ∑ s ∈ range n, (2 * (cdg G s u % 2 : ℕ) * (cdg G s t : ℕ) : ℤ) * ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) := by
  unfold oA segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cdivG, cpar (two_pow_dvd hG), cmodG]
  unfold cdg; push_cast; ring

theorem oB_eq (hG : 1 ≤ G) (u t : ℕ) : oB K ρ G n u t =
    ∑ s ∈ range n, ((cdg G s u % 2 : ℕ) * (1 - 2 * (cdg G s t : ℕ)) : ℤ) *
      ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) := by
  unfold oB segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cdivG, cpar (two_pow_dvd hG), cmodG]
  unfold cdg; push_cast; ring

theorem oS_eq (hK : 1 ≤ K) (y : ℕ) : oS K ρ G n y =
    ∑ s ∈ range n, ((ybit K ρ s y : ℕ) : ℤ) * ((2 : ℤ) ^ G) ^ s := by
  unfold oS segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cpar (two_pow_dvd hK)]
  unfold ybit seg; ring

theorem oC_eq (hK : 1 ≤ K) (hG : 1 ≤ G) (u y : ℕ) : oC K ρ G n u y =
    ∑ s ∈ range n, (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ) * ((2 : ℤ) ^ G) ^ s := by
  unfold oC segSum
  refine sum_congr rfl fun s _ => ?_
  beta_reduce
  rw [cdivG, cdivG]
  have h3 : ((((y / 2 ^ ρ / (2 ^ K) ^ s : ℕ) : ℤ) + ((u / (2 ^ G) ^ s : ℕ) : ℤ)) % 2) =
      (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ) := by
    have h1 := par_dgt (two_pow_dvd hK) s (y / 2 ^ ρ)
    have h2 := par_dgt (two_pow_dvd hG) s u
    have h3' : (y / 2 ^ ρ / (2 ^ K) ^ s + u / (2 ^ G) ^ s) % 2 =
        (ybit K ρ s y + cdg G s u % 2) % 2 := by
      rw [Nat.add_mod, h1, h2]; rfl
    exact_mod_cast h3'
  rw [h3]; ring

end Closed

/-! ## Segment-wise updates of a slot -/

section Slot

variable {K ρ n L : ℕ}

/-- Compact fields: digit-wise addition, staying below `R^n`. -/
theorem cf_add {G : ℕ} {w : ℕ} (hw : w < (2 ^ G) ^ n) (δ : ℕ → ℤ)
    (h : ∀ s < n, 0 ≤ (cdg G s w : ℤ) + δ s ∧ (cdg G s w : ℤ) + δ s < 2 ^ G) :
    ∃ w' : ℕ, (w' : ℤ) = w + ∑ s ∈ range n, δ s * ((2 : ℤ) ^ G) ^ s ∧ w' < (2 ^ G) ^ n ∧
      (∀ s < n, (cdg G s w' : ℤ) = cdg G s w + δ s) := by
  obtain ⟨z, e1, e2, e3⟩ := digits_add (2 ^ G) (by positivity) n w δ (by
    intro s hs; have := h s hs; unfold cdg at this; push_cast at this ⊢; exact this)
  refine ⟨z, by push_cast at e1 ⊢; exact e1, ?_, fun s hs => e2 s hs⟩
  have : w / (2 ^ G) ^ n = 0 := Nat.div_eq_of_lt hw
  have hz := lt_of_hi (W := 2 ^ G) (n := n) (x := z) (by positivity)
  rw [e3, this] at hz; simpa using hz

end Slot

/-! ## Modular pulls -/

/-- `subM` of an exact result. -/
theorem subM_of {Q : ℕ} {a a' : ℕ} {o : ℤ} (h : (a' : ℤ) = a - o) (ha' : a' < Q) :
    subM Q a o = a' := by
  unfold subM; rw [← h, Int.emod_eq_of_lt (by omega) (by omega)]; simp

/-! ## States, the phases, the composites -/

/-! ## Exactness on good states -/

section Good

variable {K ρ G n L : ℕ}

/-- One phase on a state whose `t`-digits are `≤ R - 2` and whose segments satisfy
`1 ≤ v`, `v + 2R < W`: `t, u` unchanged, segment `v ↦ v + z (1 - 2 a)`. -/
theorem phInv_spec_sol_aux (hK : 1 ≤ K) (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) {t u y : ℕ}
    (hb : Box G n L ⟨t, u, y⟩) (ht : ∀ s < n, cdg G s t + 2 ≤ 2 ^ G)
    (hv : ∀ s < n, 1 ≤ seg K ρ s y ∧ seg K ρ s y + 2 * 2 ^ G < 2 ^ K) :
    ∃ y', phInv K ρ G n L ⟨t, u, y⟩ = ⟨t, u, y'⟩ ∧ y' < 2 ^ L ∧ y' % 2 ^ ρ = y % 2 ^ ρ ∧
      y' / 2 ^ ρ / (2 ^ K) ^ n = y / 2 ^ ρ / (2 ^ K) ^ n ∧
      ∀ s < n, (seg K ρ s y' : ℤ) = seg K ρ s y +
        ((cdg G s u % 2 : ℕ) : ℤ) * (1 - 2 * ((ybit K ρ s y : ℕ) : ℤ)) := by
  have hbt : t < Qc G n := hb.1
  have hby : y < 2 ^ L := hb.2.2
  -- step 1: t1 = t + oC u y
  obtain ⟨t1, et1, ht1, dt1⟩ := cf_add (n := n) (G := G) hbt
    (fun s => (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ)) (by
    intro s hs
    have h1 := ht s hs
    have h2 : (ybit K ρ s y + cdg G s u % 2) % 2 < 2 := Nat.mod_lt _ (by norm_num)
    have h3 : cdg G s t + (ybit K ρ s y + cdg G s u % 2) % 2 < 2 ^ G := by omega
    exact ⟨by positivity, by exact_mod_cast h3⟩)
  have s1 : pT G n (-(oC K ρ G n u y)) ⟨t, u, y⟩ = ⟨t1, u, y⟩ := by
    simp only [pT]; congr 1
    refine subM_of ?_ ht1
    rw [et1, oC_eq hK hG]; ring
  -- step 2: y2 = y - oB u t1
  obtain ⟨y2, ey2, hy2, ly2, dy2, hhy2⟩ := slot_add hK hL hby
    (fun s => -(((cdg G s u % 2 : ℕ) : ℤ) * (1 - 2 * (cdg G s t1 : ℤ)))) (by
    intro s hs
    have h1 : (1 : ℤ) ≤ seg K ρ s y ∧ (seg K ρ s y : ℤ) + 2 * 2 ^ G < 2 ^ K := by
      exact_mod_cast hv s hs
    have h2 := dt1 s hs
    have h3 : (cdg G s t : ℤ) + 2 ≤ 2 ^ G := by exact_mod_cast ht s hs
    have hc : (ybit K ρ s y + cdg G s u % 2) % 2 < 2 := Nat.mod_lt _ (by norm_num)
    have hc' : (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ) < 2 := by exact_mod_cast hc
    rw [h2]
    rcases (show cdg G s u % 2 = 0 ∨ cdg G s u % 2 = 1 by omega) with h | h <;> rw [h] <;>
      push_cast <;> omega)
  have s2 : pY L (oB K ρ G n u t1) ⟨t1, u, y⟩ = ⟨t1, u, y2⟩ := by
    simp only [pY]; congr 1
    refine subM_of ?_ hy2
    rw [ey2, oB_eq hG, sub_eq_add_neg, ← sum_neg_distrib]
    congr 1; refine sum_congr rfl fun s _ => ?_; ring
  -- parities of y2
  have py2 : ∀ s < n, ybit K ρ s y2 = (ybit K ρ s y + cdg G s u % 2) % 2 := by
    intro s hs
    have h2 := dy2 s hs
    have e := dt1 s hs
    rw [e] at h2
    unfold ybit at h2 ⊢
    rcases (show cdg G s u % 2 = 0 ∨ cdg G s u % 2 = 1 by omega) with h | h <;> rw [h] at h2 ⊢ <;>
      push_cast at h2 <;> omega
  -- step 3: t3 = t1 - oS y2 = t
  have s3 : pT G n (oS K ρ G n y2) ⟨t1, u, y2⟩ = ⟨t, u, y2⟩ := by
    simp only [pT]; congr 1
    refine subM_of ?_ hbt
    rw [oS_eq hK, et1]
    have : ∑ s ∈ range n, ((ybit K ρ s y2 : ℕ) : ℤ) * ((2 : ℤ) ^ G) ^ s =
        ∑ s ∈ range n, (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ) * ((2 : ℤ) ^ G) ^ s :=
      sum_congr rfl fun s hs => by rw [py2 s (mem_range.1 hs)]
    rw [this]; ring
  -- step 4: y4 = y2 - oA u t
  obtain ⟨y4, ey4, hy4, ly4, dy4, hhy4⟩ := slot_add hK hL hy2
    (fun s => -(2 * ((cdg G s u % 2 : ℕ) : ℤ) * (cdg G s t : ℤ))) (by
    intro s hs
    have h1 : (1 : ℤ) ≤ seg K ρ s y ∧ (seg K ρ s y : ℤ) + 2 * 2 ^ G < 2 ^ K := by
      exact_mod_cast hv s hs
    have h2 := dy2 s hs
    have e := dt1 s hs
    have h3 : (cdg G s t : ℤ) + 2 ≤ 2 ^ G := by exact_mod_cast ht s hs
    have hc : (ybit K ρ s y + cdg G s u % 2) % 2 < 2 := Nat.mod_lt _ (by norm_num)
    have hc' : (((ybit K ρ s y + cdg G s u % 2) % 2 : ℕ) : ℤ) < 2 := by exact_mod_cast hc
    rw [h2, e]
    rcases (show cdg G s u % 2 = 0 ∨ cdg G s u % 2 = 1 by omega) with h | h <;> rw [h] <;>
      push_cast <;> omega)
  have s4 : pY L (oA K ρ G n u t) ⟨t, u, y2⟩ = ⟨t, u, y4⟩ := by
    simp only [pY]; congr 1
    refine subM_of ?_ hy4
    rw [ey4, oA_eq hG, sub_eq_add_neg, ← sum_neg_distrib]
    congr 1; refine sum_congr rfl fun s _ => ?_; ring
  have E : phInv K ρ G n L ⟨t, u, y⟩ = ⟨t, u, y4⟩ := by
    simp only [phInv, s1, s2, s3, s4]
  refine ⟨y4, E, hy4, by rw [ly4, ly2], by rw [hhy4, hhy2], fun s hs => ?_⟩
  have h2 := dy2 s hs
  have h4 := dy4 s hs
  have e := dt1 s hs
  rw [h4, h2, e]
  unfold ybit
  rcases (show cdg G s u % 2 = 0 ∨ cdg G s u % 2 = 1 by omega) with h | h <;> rw [h] <;>
    push_cast <;> omega

end Good

end IntMul.Kappa.R6.IL2C

