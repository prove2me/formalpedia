/-- `d^{2^51} ≤ b`. -/
theorem dP_pow_le (n : ℕ) : IntMul.OpenAI.R154.dP n ^ (2 ^ 51) ≤ bP n := by
  have hb : (0 : ℝ) ≤ (bP n : ℝ) := Nat.cast_nonneg _
  have hE : (IntMul.OpenAI.R154.dP n : ℝ) ≤ (bP n : ℝ) ^ ε := Nat.floor_le (Real.rpow_nonneg hb _)
  have h1 : ((IntMul.OpenAI.R154.dP n : ℝ)) ^ (2 ^ 51 : ℕ) ≤ ((bP n : ℝ) ^ ε) ^ (2 ^ 51 : ℕ) :=
    pow_le_pow_left₀ (Nat.cast_nonneg _) hE _
  rw [← Real.rpow_natCast ((bP n : ℝ) ^ ε), ← Real.rpow_mul hb,
    show ε * ((2 ^ 51 : ℕ) : ℝ) = 1 by unfold ε; push_cast; norm_num, Real.rpow_one] at h1
  exact_mod_cast h1

/-- **The width condition for `A0 = W_c²`.** -/
theorem ewB18_A0 : IntMul.OpenAI.R154.P.NLogN.KFV.EwB18 A0 := by
  refine ⟨2 ^ Mw, fun n hn => ?_⟩
  have hb : Mw ≤ bP n := KFM.lg_ge Mw n hn
  have hMw : Mw = 2 * NLogN.KFAz.K0 + Cw * NLogN.KFAz.K0 ^ 11 + 2 := rfl
  have hK : NLogN.KFAz.K0 = Cw + 4 := rfl
  have hew := ewb_le NLogN.KFAz.A0 (IntMul.OpenAI.R154.dP n - 1) Gb_le
  have hp : pP n = 6 * bP n := rfl
  rw [hp]
  by_cases hs : IntMul.OpenAI.R154.dP n - 1 + 1 ≤ NLogN.KFAz.K0
  · have h1 : (IntMul.OpenAI.R154.dP n - 1 + 1) ^ 11 ≤ NLogN.KFAz.K0 ^ 11 := Nat.pow_le_pow_left hs _
    have h2 := Nat.mul_le_mul_left Cw h1
    omega
  · push Not at hs
    have hE1 : 1 ≤ IntMul.OpenAI.R154.dP n := by
      by_contra h0
      have : IntMul.OpenAI.R154.dP n = 0 := by omega
      rw [this] at hs
      omega
    have he : IntMul.OpenAI.R154.dP n - 1 + 1 = IntMul.OpenAI.R154.dP n := by omega
    rw [he] at hew hs
    have hpow := dP_pow_le n
    have h12 : IntMul.OpenAI.R154.dP n ^ 12 ≤ IntMul.OpenAI.R154.dP n ^ (2 ^ 51) := Nat.pow_le_pow_right hE1 (by norm_num)
    have h11 : IntMul.OpenAI.R154.dP n ≤ IntMul.OpenAI.R154.dP n ^ 11 := by
      calc IntMul.OpenAI.R154.dP n = IntMul.OpenAI.R154.dP n ^ 1 := (pow_one _).symm
        _ ≤ IntMul.OpenAI.R154.dP n ^ 11 := Nat.pow_le_pow_right hE1 (by norm_num)
    have hmul : (Cw + 4) * IntMul.OpenAI.R154.dP n ^ 11 ≤ IntMul.OpenAI.R154.dP n * IntMul.OpenAI.R154.dP n ^ 11 := Nat.mul_le_mul_right _ (by omega)
    have e12 : IntMul.OpenAI.R154.dP n * IntMul.OpenAI.R154.dP n ^ 11 = IntMul.OpenAI.R154.dP n ^ 12 := by ring
    have e4 : (Cw + 4) * IntMul.OpenAI.R154.dP n ^ 11 = Cw * IntMul.OpenAI.R154.dP n ^ 11 + 4 * IntMul.OpenAI.R154.dP n ^ 11 := by ring
    omega

end IntMul.OpenAI.R154.P.NLogN.KFAz

