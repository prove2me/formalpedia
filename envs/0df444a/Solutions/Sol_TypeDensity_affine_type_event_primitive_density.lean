  have hcellD : ∀ D ∈ S, μ (A ∩ Pr ∩ PC D) * (μ Pr)⁻¹ =
      ν * ∑ m ∈ TypeDensity.residuePatterns n, if TypeDensity.HasArray k n D m then c m else 0 := by
    intro D hD
    obtain ⟨⟨m₀, hm₀, hm₀R⟩, huniq⟩ := TypeDensity.divisor_array_exists_unique k n D ((hS D).1 hD)
