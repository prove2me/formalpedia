        (∫ a, Φ a * ((χ a : ℂˣ) : ℂ) * ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)
            ∂(NumberField.Idele.sPartMeasure ℚ T)) *
          ∏' v : {v : HeightOneSpectrum (𝓞 ℚ) // v ∉ T},
