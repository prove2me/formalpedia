theorem targetCode_cons (s : State) (ss : List State) (n : ℕ) :
    targetCode (Int3.ofFn (weightSum (s::ss))) (n+1)=
      point s+targetCode (Int3.ofFn (weightSum ss)) n := by
  simp only [targetCode,linear,Int3.ofFn,weightSum,List.map_cons,List.sum_cons,
    point,weight3]
  push_cast
  ring

theorem bit_of_follows (p : Plan) (hv : p.Valid) (ss : List State) (hf : p.Follows ss) :
    0≤ targetCode (Int3.ofFn (weightSum ss)) p.length ∧
    p.bits.testBit (targetCode (Int3.ofFn (weightSum ss)) p.length).toNat=true := by
  induction p generalizing ss with
  | done =>
      cases ss with
      | nil => decide
      | cons s ss => exact False.elim hf
  | step cs bits tail ih =>
      cases ss with
      | nil => exact False.elim hf
      | cons s ss =>
          obtain ⟨hm,ht⟩ := hf
          obtain ⟨hp,hcover⟩ := hv.2 s hm
          obtain ⟨hc,hb⟩ := ih hv.1 ss ht
          simp only [Plan.length,Plan.bits,targetCode_cons]
          refine ⟨by omega,?_⟩
          rw [Int.toNat_add hp hc]
          have hshift : (tail.bits <<< (point s).toNat).testBit
              ((point s).toNat+(targetCode (Int3.ofFn (weightSum ss)) tail.length).toNat)=true := by
            rw [Nat.testBit_shiftLeft]
            simp only [Nat.le_add_right,decide_true,Bool.true_and,Nat.add_sub_cancel_left,hb]
          have h := congrArg (fun b:ℕ=>b.testBit
            ((point s).toNat+(targetCode (Int3.ofFn (weightSum ss)) tail.length).toNat)) hcover
          simpa only [Nat.testBit_and,hshift,Bool.true_and] using h

theorem ofFn_get (x : Int3) : Int3.ofFn x.get=x := by cases x <;> rfl

theorem reached_of_follows (p : Plan) (hv : p.Valid) (ss : List State) (hf : p.Follows ss)
    (remaining : Int3) (hw : weightSum ss=remaining.get) :
    reached p.bits (targetCode remaining p.length)=true := by
  have he := congrArg Int3.ofFn hw
  rw [ofFn_get] at he
  obtain ⟨hn,hb⟩ := bit_of_follows p hv ss hf
  rw [he] at hn hb
  simp only [reached,decide_eq_true hn,Bool.true_and,hb]

theorem follows_of_choices (p : Plan) (n ng : ℕ) (ss : List State)
    (he : p.choices=(ss.map State.kind).map (options n ng))
    (hs : ∀s∈ss,Local n ng s) : p.Follows ss := by
  induction ss generalizing p with
  | nil => cases p <;> simp_all [Plan.choices,Plan.Follows]
  | cons s ss ih =>
      cases p with
      | done => simp [Plan.choices] at he
      | step cs bits tail =>
          simp only [Plan.choices,List.map_cons,List.cons.injEq] at he
          refine ⟨?_,ih tail he.2 (fun z hz=>hs z (by simp [hz]))⟩
          rw [he.1]
          exact mem_options n ng s (hs s (by simp))



theorem run_complete (tree : Tree) (hk : tree.checkKeys=true) (p : Plan) (hv : p.Valid)
    (pre ss : List State) (previous : Option State) (remaining : Int3)
    (hn : (pre++ss).length≤ 9) (ho : ∀s∈pre++ss,s.out≤ 4) (hi : ∀s∈pre++ss,s.incoming≤ 8)
    (hf : p.Follows ss) (hc : Canonical previous ss) (hw : weightSum ss=remaining.get)
    (hcheck : p.run tree pre previous remaining=true) : ThreeBoundRelaxed.record (pre++ss)∈tree.rows := by
  induction p generalizing pre ss previous remaining with
  | done =>
      cases ss with
      | nil =>
