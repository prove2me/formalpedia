/-! ### The exact anticommuting probability -/

theorem MIPStarRE.QPBT.anticommProb_eq (P : _root_.MIPStarRE.QPBT.AdmissibleParams) :
    _root_.MIPStarRE.QPBT.anticommProb P = (1 - (P.q : ℝ)⁻¹) ^ (P.m + 1) / 2 := by sorry
