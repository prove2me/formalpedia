* `mapsA6`: the machine's `A` line maps, `chirpC` along every axis.
* `AIL6 P tab`: a procedure `eA` turns `gflat zs ++ l` into
  `gflat (tensorGo (mapsA6 …) zs) ++ l`, exactly, at cost `≤ C₀ · cU6 P n A`.
* **`ALineHyp6_of_AIL6`**: `AIL6 P tab → ALineHyp6 P tab` (`P.Ok`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN NLogN.KIL NLogN.KFB AModel
open IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

/-- The half-block `2^{⌊log₂ m⌋}`. -/
noncomputable def HA6 (P : Prm) (n : ℕ) : ℕ := 2 ^ Nat.log 2 (sWidth (pP6 P n) (αN6 P n))

/-- The machine's `A` line maps. -/
noncomputable def mapsA6 (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ) : List (ℕ × (List GI → List GI)) :=
  J6A.mapsGen (tD6 P n D) fun i => J6A.chirpC (pP6 P n) ((List.ofFn (sD6 src D)).getD i 1)
    ((List.ofFn (tD6 P n D)).getD i 1) (αN6 P n) (HA6 P n)

end J6Seg

end

section
-- Source module: Solutions.J6SegSw1
/-!
# B-line machine, sweep 1: in-place axis maps

The machine keeps the array in its row-major layout and applies the line map of axis `i` in
place (no axis rotation). For a box `dims` and an axis `i`, the array is `(pre, n, post)`
(`pre = ∏_{j<i}`, `n = dims_i`, `post = ∏_{j>i}`), and

* `axisL n post f L`: every `(n, post)` block is transposed, `f` is applied to each of its `post`
  lines, and the block is transposed back;
* **`axisL_getD`**: entry `b (n·post) + a·post + c` of `axisL n post f L` is entry `a` of `f`
  applied to the line `k ↦ L[b (n·post) + k·post + c]`;
* **`digL_split`**: the row-major digits of `b (n·post) + a·post + c`;
* **`axisL_listOf`**: on `listOf dims g`, `axisL` is the slice map `j ↦ A (k ↦ g (j[i ↦ k])) (j i)`.
-/

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Products of a list around a position -/

/-! ## Row-major digits of a split index -/

/-! ## In-place axis maps -/

section axis
variable {α : Type*} [Inhabited α]

/-- The line through `b, c` of a `(pre, n, post)` array. -/
def lineAt (n post : ℕ) (L : List α) (b c : ℕ) : List α :=
  (List.range n).map fun k => L.getD (b * (n * post) + k * post + c) default

/-- The transposed block of one `(n, post)` block. -/
def blkImg (n post : ℕ) (f : List α → List α) (B : List α) : List α :=
  transposeL post n ((IntMul.HvdH.Ref.chunkL n (transposeL n post B)).flatMap f)

/-- In-place application of the line map `f` along the middle axis of a `(pre, n, post)` array. -/
def axisL (n post : ℕ) (f : List α → List α) (L : List α) : List α :=
  (IntMul.HvdH.Ref.chunkL (n * post) L).flatMap (blkImg n post f)

/-- The in-place sweep: axes `0, …, k-1` in order. -/
def sweepL (dims : List ℕ) (F : ℕ → List α → List α) : ℕ → List α → List α
  | 0, L => L
  | k + 1, L => axisL (dims.getD k 1) (dims.drop (k + 1)).prod (F k) (sweepL dims F k L)

end axis

/-! ## The sweep is the tensor product -/

/-- The line maps of `A` (identity beyond `K`). -/
def linesOf (K : ℕ) (dims : List ℕ) (A : Fin K → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) :
    ℕ → List (ℤ × ℤ) → List (ℤ × ℤ) :=
  fun i => if h : i < K then fun X => (List.range (dims.getD i 1)).map
    (A ⟨i, h⟩ fun k => X.getD k default) else id

end J6Seg

end

section
-- Source module: Solutions.J6SegSw2
/-!
# B-line machine, sweep 2: the per-axis passes on line representations

A `(pre, n, post)` array `L` *represents* the lines `φ b c` (`LRep pre n post L φ`) when
`L[b (n·post) + a·post + c] = (φ b c)[a]`. The machine's passes act on representations:

* **`LRep_axisL`**: the in-place axis map applies `f` to every line;
* **`LRep_slabPass`**: a monotone slab pass (output slab `l` = `h l` of input slab `src l`, or
  zeros) applies `slabLine` to every line (selection, `J` gather and scatter, output);
* **`LRep_kerPass`**: expose `(A, m, post) → (A, post, m)` (`blkTg`), apply a kernel to each
  contiguous `m`-row (indexed by its block), expose back;
* **`LRep_split` / `LRep_join`**: `(pre, nc·λ, post)` is `(pre·nc, λ, post)`;
* **`LRep_chunkPass`**: the chunk kernel `chunksG g λ nc` on every line, by one `λ`-exposure.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

section passes
variable {α β : Type*} [Inhabited α] [Inhabited β]

/-- `L` is a `(pre, n, post)` array whose lines are `φ b c`. -/
def LRep (pre n post : ℕ) (L : List α) (φ : ℕ → ℕ → List α) : Prop :=
  L.length = pre * (n * post) ∧ (∀ b < pre, ∀ c < post, (φ b c).length = n) ∧
  ∀ b < pre, ∀ a < n, ∀ c < post,
    L.getD (b * (n * post) + a * post + c) default = (φ b c).getD a default

/-! ## Slab passes -/

/-- One output slab: input slab `k` mapped by `h`, or zeros. -/
def slabOf (B : List α) (post : ℕ) (src : Option ℕ) (h : α → β) : List β :=
  match src with
  | some k => ((B.drop (k * post)).take post).map h
  | none => List.replicate post default

/-- **A slab pass**: in each `(n, post)` block, output slab `l < n'` is `h l` applied to input
slab `src l` (or zeros when `src l = none`). -/
def slabPass (n n' post : ℕ) (src : ℕ → Option ℕ) (h : ℕ → α → β) (L : List α) : List β :=
  (IntMul.HvdH.Ref.chunkL (n * post) L).flatMap fun B => (List.range n').flatMap fun l => slabOf B post (src l) (h l)

/-- The line map of a slab pass. -/
def slabLine (n' : ℕ) (src : ℕ → Option ℕ) (h : ℕ → α → β) (x : List α) : List β :=
  (List.range n').map fun l => match src l with
    | some k => h l (x.getD k default)
    | none => default

/-! ## Exposures and kernels on rows -/

/-- Blockwise transposition (the shape of the fine exposure): `a` blocks `m × k → k × m`. -/
def blkTg (m k a : ℕ) (zs : List α) : List α :=
  (List.range a).flatMap fun i => transposeL m k ((zs.drop (i * (m * k))).take (m * k))

/-- A row-indexed kernel on `R` consecutive rows of length `n`. -/
def rowMap (n R : ℕ) (g : ℕ → List α → List α) (X : List α) : List α :=
  (List.range R).flatMap fun r => g r ((X.drop (r * n)).take n)

/-- **A kernel pass**: expose `(A, m, post) → (A, post, m)`, apply `g b` to every row of block
`b`, expose back. -/
def kerPass (m post A : ℕ) (g : ℕ → List α → List α) (L : List α) : List α :=
  blkTg post m A (rowMap m (A * post) (fun r => g (r / post)) (blkTg m post A L))

/-! ## Reshaping `(pre, nc·λ, post) ↔ (pre·nc, λ, post)` -/

/-- The `nc` chunks of a line, joined. -/
def joinC (nc : ℕ) (ψ : ℕ → List α) : List α := (List.range nc).flatMap ψ

/-- A kernel on consecutive `λ`-chunks (generic `chunksL`). -/
def chunksG (g : ℕ → List α → List α) (lam nc : ℕ) (x : List α) : List α :=
  (List.range nc).flatMap fun q => g q ((x.drop (q * lam)).take lam)

end passes

end J6Seg

end

section
-- Source module: Solutions.J6SegSw3
/-!
# B-line machine, sweep 3: the `B₀` axis map as seven passes

On a `(pre, N, post)` array of Gaussian items (`N = n_c λ`), the in-place `B₀` line map of the
axis (`axisL N post (lineB …)`) is computed by (`axisPipe`):

1. a selection slab pass (row `rowSel l`, scaled by `2^{P-p-1}`, zeros for `l ≥ s`);
2. the chunk kernel `chunkK` on every `λ`-chunk (one `λ`-exposure);
3. a slab gather of the `m` near-boundary rows `LJ` (padded to `G` rows);
4. the `J` kernel (`fwdK`, `bwdK`, coupling window) on every `G`-row (one `G`-exposure);
5. a slab scatter back to the `N` rows;
6. the chunk kernel again;
7. the output slab pass on the pair `(Y, Y₂)`: `outE l (Y - Y₂)`.

Real and imaginary parts are carried together (`liftG`). **`axisPipe_eq`** proves the equality.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Pairs of arrays -/

/-! ## Gaussian lifts -/

/-- A real kernel applied to both parts. -/
def liftG (f : List ℤ → List ℤ) (x : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  List.zip (f (x.map Prod.fst)) (f (x.map Prod.snd))

/-! ## The passes of the `B₀` axis map -/

section pipe
variable (p P R s t lam w α K nc G : ℕ)

/-- Selection source. -/
def selSrc (l : ℕ) : Option ℕ := if l < s then some (rowSel s t l) else none

/-- Selection scaling. -/
def selH (_ : ℕ) (z : ℤ × ℤ) : ℤ × ℤ := (z.1 * 2 ^ (P - p - 1), z.2 * 2 ^ (P - p - 1))

/-- Gather source: the near-boundary rows, then zero padding. -/
def jSrc (r : ℕ) : Option ℕ :=
  if r < (LJ s t lam w).length then some ((LJ s t lam w).getD r 0) else none

/-- Scatter source. -/
def scSrc (u : ℕ) : Option ℕ := if u ∈ LJ s t lam w then some ((LJ s t lam w).idxOf u) else none

/-- The coupling values `W` from the gathered values `v` (capacitance solve + window). -/
def wOf (v : List ℤ) : List ℤ :=
  (List.range (LJ s t lam w).length).map fun r => dotF P (ccL P R s t lam w α K r)
    ((zext K (bwdK P (bsOf P (LJ s t lam w) (lam + w) (s - lam - w)
        (capI P (TT P R s t α) (BB s t lam w)))
      (fwdK P (fsOf P (LJ s t lam w) (lam + w) (s - lam - w)
        (capI P (TT P R s t α) (BB s t lam w))) v []) [] [])).drop r)

/-- The `J` kernel on a padded `G`-row. -/
def jKer (v : List ℤ) : List ℤ :=
  wOf P R s t lam w α K (v.take (LJ s t lam w).length) ++
    List.replicate (G - (LJ s t lam w).length) 0

/-- The output map on `(Y, Y₂)`. -/
def outH (l : ℕ) (z : (ℤ × ℤ) × (ℤ × ℤ)) : ℤ × ℤ :=
  if l < s then (outE p P s t α l (z.1.1 - z.2.1), outE p P s t α l (z.1.2 - z.2.2)) else (0, 0)

/-- **The `B₀` axis map as seven passes** on a `(pre, n_c λ, post)` array. -/
def axisPipe (pre post : ℕ) (L : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  let S := slabPass (nc * lam) (nc * lam) post (selSrc s t) (selH p P) L
  let Y := kerPass lam post (pre * nc) (fun b => liftG (chunkK P R s t lam α (b % nc))) S
  let Jg := slabPass (nc * lam) G post (jSrc s t lam w) (fun _ z => z) Y
  let W := kerPass G post pre (fun _ => liftG (jKer P R s t lam w α K G)) Jg
  let Wp := slabPass G (nc * lam) post (scSrc s t lam w) (fun _ z => z) W
  let Y2 := kerPass lam post (pre * nc) (fun b => liftG (chunkK P R s t lam α (b % nc))) Wp
  slabPass (nc * lam) (nc * lam) post (fun l => some l) (outH p P s t α) (List.zip Y Y2)

variable {p P R s t lam w α K nc G}

/-! ## The line identity -/

variable (P R s t lam w α K nc) in
/-- The scattered coupling values of `segLineC` (the right-hand side of the second solve). -/
def wpOf (x : List ℤ) : List ℤ :=
  (List.range (nc * lam)).map fun u => if u ∈ LJ s t lam w then
    (wOf P R s t lam w α K ((List.range (LJ s t lam w).length).map fun r =>
      (applyL P R s t lam α nc x).getD ((LJ s t lam w).getD r 0) 0)).getD
      ((LJ s t lam w).idxOf u) 0 else 0

end pipe

end J6Seg

end

section
-- Source module: Solutions.J6SegSw4
/-!
# B-line machine, sweep 4: the machine computes `tensorGo mapsLine6`

* **`pipeSweep`**: the machine applies an axis program `Fp k` for `k = 0, 1, …` in place;
* **`pipeSweep_eq`**: if every `Fp k` is the in-place axis map of `F k`, the machine is `sweepL`;
* **`sweepL_tensorGo'`**: `sweepL` of line maps of slice form is `tensorGo`;
* **`r6_maps_eq`**: in the round-six regime `mapsLine6 = mapsBs` and `λ ∣ t_i`, `s_i < t_i`;
* **`r6_machine`**: in the round-six regime, the seven-pass machine (`pipe6`, axes `0..d-1`)
  computes `tensorGo (mapsLine6 P n src D)` on every array of the right length.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

namespace J6Seg

/-! ## The machine sweep -/

/-- The machine: axis programs `Fp 0, …, Fp (k-1)` in order. -/
def pipeSweep {α : Type*} (Fp : ℕ → List α → List α) : ℕ → List α → List α
  | 0, L => L
  | k + 1, L => Fp k (pipeSweep Fp k L)

/-! ## The round-six parameters -/

section r6
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ)

/-- `s_i` and `t_i` as functions of `ℕ`. -/
noncomputable def sI6 (i : ℕ) : ℕ := (List.ofFn (sD6 src D)).getD i 1
noncomputable def tI6 (i : ℕ) : ℕ := (List.ofFn (tD6 P n D)).getD i 1

/-- The padded length of the near-boundary line of axis `i` (a power of two). -/
noncomputable def GJ6 (i : ℕ) : ℕ :=
  2 ^ Nat.clog 2 (LJ (sI6 src D i) (tI6 P n D i) (lamP (dP6 P n)) (wF (dP6 P n))).length

/-- **The machine's program for axis `k`** (the seven passes at the round-six parameters). -/
noncomputable def pipe6 (k : ℕ) : List GI → List GI :=
  axisPipe (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sI6 src D k)) (pP6 P n / 7) (sI6 src D k)
    (tI6 P n D k) (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n) (wF (dP6 P n))
    (tI6 P n D k / lamP (dP6 P n)) (GJ6 P n src D k)
    ((List.ofFn (tD6 P n D)).take k).prod ((List.ofFn (tD6 P n D)).drop (k + 1)).prod

end r6

end J6Seg

end

section
-- Source module: Solutions.J6SegILRow
/-!
# B-line IL: the row-kernel interface (shared by the chunk kernel B3 and the `J` kernel B4)

`RowBody6 Isym tbl e dT tabOf Pre g C`: procedure `e` of the table `tbl` applies the row map
`g q` to the row `x` on top of stack `0`, reading the tables `tabOf q` from stack `dT` (left in
place), in the convention of `FineBody6`: every other managed stack is empty, and the base state
`s` (where the caller keeps its own data) is preserved.

* the chunk kernel (B3): `g q = liftG (chunkK P R s t λ α q)`, `tabOf = chunkTab …`
  (`chunkTab` below), rows of length `λ`;
* the `J` kernel (B4): `g _ = liftG (jKer P R s t λ w α K G)`, rows of length `G`.

`chunkTab ρ b q`: the tables of chunk `q` as one integer list: the header `[λ, P, ρ, b, nb]`
(`2^ρ = 2λ` the Kronecker record length, `b` the Kronecker digit width, `nb` the number of blocks), the four stage
tables `di, gi, gam, dd` (length `λ` each), then per block of the chunk `n :: am ++ ap`
(`descsOf`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFH NLogN.KFM IntMul.OpenAI.RT AModel
open IntMul.Kappa.R6

/-- **A row kernel as a procedure** (the convention of `FineBody6`). -/
def RowBody6 {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (e : Fin Pp) (dT : Fin HS)
    (tabOf : ℕ → List ℤ) (Pre : List GI → Prop) (g : ℕ → List GI → List GI) (C : ℝ) : Prop :=
  ∀ (q : ℕ) (s : IState HS) (F : Fin HS → List ℤ) (x : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dT → F j = []) → F dT = tabOf q → F 0 = gflat x ++ l → Pre x →
    ∃ c : ℕ, IRuns Isym tbl (.call e) (encK s F)
        (encK s (Function.update F 0 (gflat (g q x) ++ l))) c ∧ (c : ℝ) ≤ C

end J6Seg

end

section
-- Source module: Solutions.J6SegKr0
/-!
# B3 (chunk kernel), part 0: one uniform Kronecker record product with general truncation

`KFV10Rec.recU_runs` with the truncation `Δ` free (there `Δ = p + ρ`; the program `recU` reads
`2^Δ` from the parameter stack `kD`): on records `zx, zy` of length `r` (entries `|·| ≤ 2^p`,
digit width `b` with `2 r 2^{2p} < 2^{b-1}`), `recU` leaves the reversed record
`kmulD r Δ zx zy`, entry `j` = the `y^r + 1`-folded numerators truncated by `2^Δ`.
With `Δ = 0` and zero-padded records this is the exact Gaussian polynomial product
(the Toeplitz stages of the chunk kernel).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The folded numerators truncated by `2^Δ`. -/
def _root_.J6Seg.kmulD (r Δ : ℕ) (zx zy : List GI) : List GI :=
  List.zip ((List.range r).map fun j => fdt Δ (hRe r zx zy j) (hRe r zx zy (j + r)))
    ((List.range r).map fun j => fdt Δ (hIm r zx zy j) (hIm r zx zy (j + r)))

end NLogN.KFV

end

section
-- Source module: Solutions.J6SegKr1
/-!
# B3 (chunk kernel), part 1: the Gaussian stages as list maps

The chunk kernel on a Gaussian row is `liftG (chunkK q)`. Here it is rewritten in the form the
IL computes:

* `liftG_comp`, `liftG_append`: `liftG` commutes with composition / concatenation of
  length-preserving maps;
* `dgG c z`: the diagonal stage on pairs (`liftG (dgL P c) = dgG P c`);
* **`kmulD_toep`**: the zero-padded Kronecker record product with `Δ = 0` gives the exact
  lower-triangular Toeplitz sums `convL` of both parts (`2 n ≤ r + 1`);
* `lwG`, `upG`: the Toeplitz stages on pairs from `kmulD` (`liftG (lwL P c) = lwG`, …);
* `blkG`, `chunkG`: the block solve and the chunk kernel on pairs (`liftG (chunkL …) = chunkG …`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg

open IntMul NLogN NLogN.KFV

/-! ## `liftG` algebra -/

/-- Output length depends only on input length. -/
def LPres (f : List ℤ → List ℤ) : Prop := ∀ y y' : List ℤ, y.length = y'.length → (f y).length = (f y').length

/-! ## The diagonal stage -/

section stages
variable (P : ℕ)

/-- The diagonal stage on pairs. -/
def dgG (c : List ℤ) (z : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  List.zipWith (fun a w => (fmul P a w.1, fmul P a w.2)) c z

/-! ## Toeplitz sums by one record product -/

/-- A Gaussian row padded with zeros to length `r`. -/
def padG (r : ℕ) (z : List (ℤ × ℤ)) : List (ℤ × ℤ) := z ++ List.replicate (r - z.length) (0, 0)

/-- The first `n` entries of a real table as a padded Gaussian record. -/
def realG (r n : ℕ) (c : List ℤ) : List (ℤ × ℤ) :=
  ((c.take n).map fun a => (a, 0)) ++ List.replicate (r - n) (0, 0)

/-! ## Toeplitz stages on pairs -/

/-- The lower Toeplitz stage on pairs, from one record product. -/
def lwG (r : ℕ) (c : List ℤ) (z : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  ((kmulD r 0 (padG r z) (realG r z.length c)).take z.length).map fun w => (rs P w.1, rs P w.2)

/-- The upper Toeplitz stage on pairs. -/
def upG (r : ℕ) (c : List ℤ) (z : List (ℤ × ℤ)) : List (ℤ × ℤ) := (lwG P r c z.reverse).reverse

/-! ## The block solve and the chunk kernel on pairs -/

/-- The block solve on pairs. -/
def blkG (r : ℕ) (di gi gam dd am ap : List ℤ) (z : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  dgG P dd (dgG P gi (upG P r ap (dgG P gam (lwG P r am (dgG P gi (dgG P di z))))))

end stages

end J6Seg

end

section
-- Source module: Solutions.J6AIL1
/-!
# A lines, IL side 1: the per-block kernel as a list function

`aKerL w2 bk win Q aTab rTab cTab x` (row `x` of length `win`, the gathered window):

All three stages use the one rounding exponent `Q` (the IL kernel has one `rP` register); the
tables `aTab`, `rTab` are stored scaled by `2^Q`, so the first two stages are exact:

1. scale: `y = dgG Q aTab (x.take w2)` (`aTab_i = 2^Q a_i`: exact products `a_i x_i`);
2. correlate: `z = lwG Q (2n) rTab (padG n y)` with `n = w2 + bk` (`rTab_e = 2^Q r_e`: exact lower
   Toeplitz sums, one record product);
3. extract `z[w2 .. w2 + bk)` and rescale: `dgG Q cTab` (one rounding `rs Q` per entry);
4. pad with zeros to `win`.

* `aKerL_getD`: the entries of `aKerL` as fixed-point products of the explicit window sums.
* The tables of block `b` of an `A` line: `aTabA`, `rTabA`, `cTabA`.
* **`aKer_chirp`**: on the gathered window of block `b`, `aKerL` with these tables gives the
  `chirpC` outputs `k = b·bk + κ`, `κ < bk`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace J6A

open IntMul.HvdH J6Seg Finset

/-- **The per-block `A` kernel.** -/
def aKerL (w2 bk win Q : ℕ) (aTab rTab cTab : List ℤ) (x : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  dgG Q cTab (((lwG Q (2 * (w2 + bk)) rTab (padG (w2 + bk) (dgG Q aTab (x.take w2)))).drop w2).take bk)
    ++ List.replicate (win - bk) (0, 0)

/-- The window sums of the kernel (unscaled table entries `a`, `r`). -/
def kSum (w2 : ℕ) (a r : ℕ → ℤ) (xs : ℕ → ℤ) (κ : ℕ) : ℤ :=
  ∑ i ∈ range w2, a i * xs i * r (w2 + κ - i)

/-! ## The tables of an `A` line and the kernel on a gathered window -/

section tabs
variable (p s t α H b : ℕ)

/-- `W = H + m + 3`. -/
def WA : ℕ := H + sWidth p α + 3

/-- The rounding exponent `Q = 3P - σ` (`P = 2p`, `σ = p/2`). -/
def QA : ℕ := 3 * (2 * p) - p / 2

/-- The first output of block `b`. -/
def kkA : ℕ := b * (2 * H)

/-- The input scaling of block `b` (unscaled). -/
def aFA (i : ℕ) : ℤ := aT (2 * p) s t α H (kkA H b) (jcB s t H (kkA H b) - WA p α H + i)

/-- The correlation kernel of block `b` (unscaled, read backwards). -/
def rFA (e : ℕ) : ℤ :=
  expNeg (2 * p) (t ^ 3 * α ^ 2) (s * ((t : ℤ) * (jcB s t H (kkA H b) - WA p α H +
    ((2 * WA p α H + H : ℕ) : ℤ) - (e : ℤ)) - s * kcB H (kkA H b)).natAbs ^ 2)

/-- The input scaling table of block `b` (`2W` entries, scaled by `2^Q`). -/
def aTabA : List ℤ := (List.range (2 * WA p α H)).map fun (i : ℕ) => 2 ^ QA p * aFA p s t α H b i

/-- The correlation table of block `b` (`2W + 2H` entries, scaled by `2^Q`). -/
def rTabA : List ℤ :=
  (List.range (2 * WA p α H + 2 * H)).map fun (e : ℕ) => 2 ^ QA p * rFA p s t α H b e

/-- The output scaling table (`2H` entries). -/
def cTabA : List ℤ := (List.range (2 * H)).map fun (κ : ℕ) => cT (2 * p) (p / 2) s t α H (kkA H b + κ)

end tabs

end J6A

end

section
-- Source module: Solutions.J6AIL2
/-!
# A lines, IL side 2: copies and regrouping of line representations

* `dupL K L`: `K` copies of `L` concatenated (what the IL duplication leaves on stack `0`);
* **`LRep_cpy`**: `K = 2^f` copies of a `(pre, n, post)` array, followed by the two fine
  exposures `(1, K, N) → (1, N, K)` and `(pre, n·post, K) → (pre, K, n·post)`, are the
  `(pre, K·n, post)` array whose lines are `K` copies of the old lines;
* **`LRep_rgp`**: a `(pre, K·M·w, post)` array (`K = 2^f` classes of `M` windows of length `w`),
  after the exposures `(pre, K, M·w·post) → (pre, M·w·post, K)` and
  `(pre·M, w·post, K) → (pre·M, K, w·post)`, is the `(pre·(M·K), w, post)` array whose row
  `b·(M K) + j K + r` is window `j` of class `r` of line `b`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open IntMul.HvdH IntMul.HvdH.Ref

namespace J6A

open J6Seg

section lists
variable {α : Type*} [Inhabited α]

/-- `K` copies of `L`. -/
def dupL (K : ℕ) (L : List α) : List α := (List.replicate K L).flatten

/-- Copies followed by the two exposures. -/
def cpy (K n post pre : ℕ) (L : List α) : List α :=
  blkTg (n * post) K pre (blkTg K (pre * (n * post)) 1 (dupL K L))

/-- Regrouping the classes of windows into rows. -/
def rgp (K M w post pre : ℕ) (L : List α) : List α :=
  blkTg (w * post) K (pre * M) (blkTg K (M * w * post) pre L)

end lists

end J6A

end

section
-- Source module: Solutions.J6SegILSlab1
/-!
# B-line IL, B1 (streaming slab pass) §1: the list level

The IL slab pass streams a `(pre, n, m)` array of *units* (an integer, or a pair of integers
for the zipped output pass) block by block. A block is driven by a **command list**
`cs : List (ℤ × ℤ)` of pairs `(op, arg)`:

* `op < 0`: drop the current input slab (`m` units);
* `op = 0`: emit a zero slab (`m` zeros);
* `op > 0`: emit the current input slab mapped unit-wise by `g arg` (the slab is kept).

`runC m g cs B` is the output of one block. For a monotone source `src` (`MonoSrc`),
`ctlOf n n' src argOf` is the command list (drops to the next source slab, then an emit;
a zero emit for `none`; final drops), and **`runC_ctlOf`**: the block output is the block of
`slabPass n n' m src (fun l => g (argOf l))`. **`slabPass_blocks`**: the whole pass is the
concatenation of the block outputs.

**`flat_slabPass`**: for a flattening `φ : α → List γ` with two entries per item and a map `h`
acting entry-wise (`φ (h l x) = (φ x).map (h' l)`), `flatMap φ` commutes with slab passes
(`post ↦ 2 post`). Instances: `gflat` (passes 1, 3, 5) and `pflat` on `zip Y Y₂` (pass 7,
`pflat (zip Y Y₂) = zip (gflat Y) (gflat Y₂)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Commands -/

section cmd
variable {U : Type*}

/-- The output of one block driven by the commands `cs`. -/
def runC (m : ℕ) (g : ℤ → U → ℤ) : List (ℤ × ℤ) → List U → List ℤ
  | [], _ => []
  | (op, a) :: cs, inp =>
    if op < 0 then runC m g cs (inp.drop m)
    else if op = 0 then List.replicate m 0 ++ runC m g cs inp
    else (inp.take m).map (g a) ++ runC m g cs inp

/-- The drop command. -/
def dropC : ℤ × ℤ := (-1, 0)

/-- The commands of the output slabs `ls` from the input position `cur`, and the final position. -/
def ctlAux (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) : List ℕ → ℕ → List (ℤ × ℤ) × ℕ
  | [], cur => ([], cur)
  | l :: ls, cur =>
    match src l with
    | none => ((0, 0) :: (ctlAux src argOf ls cur).1, (ctlAux src argOf ls cur).2)
    | some k => (List.replicate (k - cur) dropC ++ (1, argOf l) :: (ctlAux src argOf ls k).1,
        (ctlAux src argOf ls k).2)

/-- **The command list of a block.** -/
def ctlOf (n n' : ℕ) (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) : List (ℤ × ℤ) :=
  (ctlAux src argOf (List.range n') 0).1 ++
    List.replicate (n - (ctlAux src argOf (List.range n') 0).2) dropC

/-- A monotone source below `n` on the first `n'` output slabs. -/
def MonoSrc (n n' : ℕ) (src : ℕ → Option ℕ) : Prop :=
  (∀ l < n', ∀ k, src l = some k → k < n) ∧
  ∀ l₁ l₂ k₁ k₂, l₁ < l₂ → l₂ < n' → src l₁ = some k₁ → src l₂ = some k₂ → k₁ ≤ k₂

/-- The source slabs at or after `cur` along `ls`, in order. -/
def SrcFrom (src : ℕ → Option ℕ) (n : ℕ) : List ℕ → ℕ → Prop
  | [], _ => True
  | l :: ls, cur => match src l with
    | none => SrcFrom src n ls cur
    | some k => cur ≤ k ∧ k < n ∧ SrcFrom src n ls k

variable [Inhabited U]

/-- One output slab of a block (integer outputs, zeros for `none`). -/
def slabZ (B : List U) (m : ℕ) (src : Option ℕ) (h : U → ℤ) : List ℤ :=
  match src with
  | some k => ((B.drop (k * m)).take m).map h
  | none => List.replicate m 0

@[simp] theorem slabZ_none (B : List U) (m : ℕ) (h : U → ℤ) :
    slabZ B m none h = List.replicate m 0 := rfl

@[simp] theorem slabZ_some (B : List U) (m k : ℕ) (h : U → ℤ) :
    slabZ B m (some k) h = ((B.drop (k * m)).take m).map h := rfl

/-- The number of drop commands of a block. -/
def nDrop : List (ℤ × ℤ) → ℕ
  | [] => 0
  | (op, _) :: cs => (if op < 0 then 1 else 0) + nDrop cs

end cmd

/-! ## Slab passes as block outputs -/

/-! ## Flattening -/

section flat
variable {α β γ δ : Type*} [Inhabited α] [Inhabited β] [Inhabited γ] [Inhabited δ]

/-- The pair flattening of the zipped output pass. -/
def pflat (zs : List ((ℤ × ℤ) × (ℤ × ℤ))) : List (ℤ × ℤ) :=
  zs.flatMap fun z => [(z.1.1, z.2.1), (z.1.2, z.2.2)]

end flat

/-! ## Splitting a command list; validity -/

section valid
variable {U : Type*}

/-- Each emitting or dropping command finds its slab: the drops so far are below `n`. -/
def VC (n : ℕ) : List (ℤ × ℤ) → ℕ → Prop
  | [], _ => True
  | (op, _) :: cs, d => (op ≠ 0 → d < n) ∧ VC n cs (d + if op < 0 then 1 else 0)

end valid

end J6Seg

end

section
-- Source module: Solutions.J6AIL6
/-!
# A lines, IL side 6: the per-axis pipeline at the list level

On a `(pre, t, post)` array the `A` line map of an axis is computed by six list passes, each of
which has an IL counterpart:

1. `cpy 32 t post pre`: the lines `X` become `dupL 32 X` (32 copies);
2. the **gather** slab pass `slabPass (32 t) (8 (M win)) post (srcG …)`: output slab
   `l = (r M + j) win + e` (`r < 8`, `j < M`, `e < win`) is, for `e < 2W`, the input
   `X[(jc_b - W + e) mod s]` of block `b = 8 j + r`, read from copy `4 r + c` (`c ∈ {0,1,2}` handles
   the wrap-around, `posE`), and `0` otherwise; inside a class `r` the windows of the blocks
   `r, r + 8, …` are disjoint and increasing, so the source is monotone;
3. `rgp 8 M win`: the windows become rows; row `b'` holds the window of block `b' % (8M)`;
4. the kernel pass `kerPass win post (pre·8M) (fun b => gK (b % 8M))` (`gK q` the per-block kernel
   `aKerL` with the tables of block `q`);
5. the **compress** slab pass `slabPass (8M win) t post srcC`: output `k` is entry `k % 2H` of
   row `k / 2H`.

**`pipeAL_rep`**: the result represents the lines `(range t).map (chirpC p s t α H U_X)`;
**`pipeAL_eq`**: the pipeline is `axisL t post` of that line map.
**`monoSrc_G`**, **`monoSrc_C`**: the two sources are monotone (the IL slab passes need this).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace J6A

open IntMul.HvdH J6Seg

/-! ## The sources -/

/-- The position of the extended index `j ∈ [-W, s + W)` in three consecutive copies of a line
of length `t`: `j < 0` in copy `0`, `0 ≤ j < s` in copy `1`, `s ≤ j` in copy `2`. -/
def posE (s t : ℕ) (j : ℤ) : ℕ :=
  if j < 0 then ((s : ℤ) + j).toNat else if j < s then t + j.toNat else 2 * t + (j - s).toNat

/-- The block of window `Q' = r M + j` (`r < 8`, `j < M`): `8 j + r`. -/
def blkW (M Q' : ℕ) : ℕ := 8 * (Q' % M) + Q' / M

/-- **The gather source.** -/
def srcG (s t H W M win : ℕ) (l : ℕ) : Option ℕ :=
  if l % win < 2 * W then
    some (l / win / M * (4 * t) +
      posE s t (jcB s t H (kkA H (blkW M (l / win))) - W + ((l % win : ℕ) : ℤ)))
  else none

/-- **The compress source.** -/
def srcC (H win : ℕ) (l : ℕ) : Option ℕ := some (l / (2 * H) * win + l % (2 * H))

/-- The kernel of block `q`. -/
def gK (p s t α H win q : ℕ) : List (ℤ × ℤ) → List (ℤ × ℤ) :=
  aKerL (2 * WA p α H) (2 * H) win (QA p) (aTabA p s t α H q) (rTabA p s t α H q)
    (cTabA p s t α H q)

/-- **The per-axis pipeline** (`M = t / 16H`, `win = 8H`). -/
def pipeAL (p s t α H pre post : ℕ) (L : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  slabPass (t / (16 * H) * 8 * (8 * H)) t post (srcC H (8 * H)) (fun _ z => z)
    (kerPass (8 * H) post (pre * (t / (16 * H) * 8))
      (fun b => gK p s t α H (8 * H) (b % (t / (16 * H) * 8)))
      (rgp 8 (t / (16 * H)) (8 * H) post pre
        (slabPass (32 * t) (8 * (t / (16 * H) * (8 * H))) post
          (srcG s t H (WA p α H) (t / (16 * H)) (8 * H)) (fun _ z => z) (cpy 32 t post pre L))))

