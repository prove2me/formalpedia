theorem sqrt_M_eq (L m : ℕ) (hmL : m ≤ L) :
    Real.sqrt (ThreeSumApsp.M L m : ℝ) = sqrtKN0 L m := by
  rw [← sqrtKN0_sq, Real.sqrt_sq (ThreeSumApsp.sqrtKN0_pos hmL).le]

/-- `9^L ≤ ∑_{d ≤ m} β_d`. -/
theorem nine_pow_le_retained {L m : ℕ} (hmL : m ≤ L) : 9 ^ L ≤ retained L m :=
