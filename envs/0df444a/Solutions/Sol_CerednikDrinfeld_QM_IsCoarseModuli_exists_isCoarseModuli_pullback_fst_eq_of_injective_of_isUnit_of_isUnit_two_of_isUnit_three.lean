    (liftPt i πX pt S' s' E').1 = Spec.map (CommRingCat.ofHom φ) ≫ (liftPt i πX pt S s E).1 := by
  have := hX.pt_pullback S S' φ (s ≫ Spec.map (CommRingCat.ofHom i)) (s' ≫ Spec.map (CommRingCat.ofHom i))
