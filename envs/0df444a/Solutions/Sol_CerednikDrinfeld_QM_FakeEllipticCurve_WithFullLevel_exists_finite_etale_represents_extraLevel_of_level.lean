section Factor

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S T : Type} [CommRing S] [CommRing T]
  (E : FakeEllipticCurve Λ N₀ S)
  {Z₀ : Scheme.{0}} (ζ₀ : Z₀ ⟶ Spec (CommRingCat.of S)) [IsAffine Z₀]
  (φ : S →+* T) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
  (hg : FakeEllipticCurve.IsPullbackVia φ E E' g)
  (θ : C ζ₀ →+* T) (hθ : θ.comp (algebraMap S (C ζ₀)) = φ)

omit [IsAffine Z₀] in
include hθ in
theorem specθ_comp : Spec.map (CommRingCat.ofHom θ) ≫ Spec.map (CommRingCat.ofHom (algebraMap S (C ζ₀))) =
    Spec.map (CommRingCat.ofHom φ) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hθ]

def kA : E'.A ⟶ (EC E ζ₀).A :=
  (via_isPullback _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀)).lift g (E'.f ≫ Spec.map (CommRingCat.ofHom θ))
    (by rw [(via_isPullback φ E E' g hg).w, Category.assoc, specθ_comp ζ₀ φ θ hθ])

theorem kA_gC : kA E ζ₀ φ E' g hg θ hθ ≫ gC E ζ₀ = g := IsPullback.lift_fst _ _ _ _
theorem kA_f : kA E ζ₀ φ E' g hg θ hθ ≫ (EC E ζ₀).f = E'.f ≫ Spec.map (CommRingCat.ofHom θ) :=
  IsPullback.lift_snd _ _ _ _

theorem kA_isPullback : IsPullback (kA E ζ₀ φ E' g hg θ hθ) E'.f (EC E ζ₀).f (Spec.map (CommRingCat.ofHom θ)) := by
  refine IsPullback.of_right ?_ (kA_f E ζ₀ φ E' g hg θ hθ) (via_isPullback _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀))
  rw [kA_gC, specθ_comp ζ₀ φ θ hθ]
  exact via_isPullback φ E E' g hg

theorem kA_isHom : Transfer.IsHom θ (EC E ζ₀).L E'.L (kA E ζ₀ φ E' g hg θ hθ) (kA_isPullback E ζ₀ φ E' g hg θ hθ) := by
  intro TT t P Q
  apply Subtype.ext
  apply (via_isPullback _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀)).hom_ext
  · rw [Transfer.push_coe, Category.assoc, kA_gC]
    have h1 := congrArg Subtype.val ((via_isHom φ E E' g hg) t P Q)
    rw [Transfer.push_coe] at h1
    rw [h1]
    have h2 := congrArg Subtype.val ((via_isHom _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀)) _
      (Transfer.push θ (kA E ζ₀ φ E' g hg θ hθ) (kA_isPullback E ζ₀ φ E' g hg θ hθ) P)
      (Transfer.push θ (kA E ζ₀ φ E' g hg θ hθ) (kA_isPullback E ζ₀ φ E' g hg θ hθ) Q))
    rw [Transfer.push_coe] at h2
    rw [h2]
    apply KerOps.mul_coe_congr E.L
    · rw [Category.assoc, specθ_comp ζ₀ φ θ hθ]
    · simp only [Transfer.push_coe, Category.assoc, kA_gC]
    · simp only [Transfer.push_coe, Category.assoc, kA_gC]
  · rw [(Transfer.push θ _ _ (E'.L.mul t P Q)).2, ((EC E ζ₀).L.mul _ _ _).2]

theorem kA_act (x : ↥Λ) : E'.act x ≫ kA E ζ₀ φ E' g hg θ hθ = kA E ζ₀ φ E' g hg θ hθ ≫ (EC E ζ₀).act x := by
  apply (via_isPullback _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀)).hom_ext
  · rw [Category.assoc, kA_gC, Category.assoc, via_act _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀),
      ← Category.assoc, kA_gC, via_act φ E E' g hg]
  · rw [Category.assoc, kA_f, Category.assoc, (EC E ζ₀).act_over, kA_f, ← Category.assoc, E'.act_over]

theorem kA_via : FakeEllipticCurve.IsPullbackVia θ (EC E ζ₀) E' (kA E ζ₀ φ E' g hg θ hθ) := by
  refine ⟨kA_isPullback E ζ₀ φ E' g hg θ hθ, ?_, kA_act E ζ₀ φ E' g hg θ hθ, ?_⟩
  · intro TT t P Q
    exact congrArg Subtype.val (kA_isHom E ζ₀ φ E' g hg θ hθ t P Q)
  · intro TT t P hP

    obtain ⟨P₀, hP₀⟩ := hg.choose_spec.2.2 t P hP
    exact gC_lev' E ζ₀ (t ≫ Spec.map (CommRingCat.ofHom θ))
      ⟨P.1 ≫ kA E ζ₀ φ E' g hg θ hθ, by rw [Category.assoc, kA_f, ← Category.assoc, P.2]⟩
      ⟨P₀, by rw [hP₀, Category.assoc, kA_gC]⟩

theorem kN_factor (N : ℕ) :
    kN θ (EC E ζ₀) E' (kA E ζ₀ φ E' g hg θ hθ) (kA_via E ζ₀ φ E' g hg θ hθ) N ≫
      kN (algebraMap S (C ζ₀)) E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀) N = kN φ E E' g hg N := by
  apply kN_unique
  · rw [Category.assoc, (kN_isPullback _ E (EC E ζ₀) (gC E ζ₀) (gC_via E ζ₀) N).w, ← Category.assoc,
      (kN_isPullback θ (EC E ζ₀) E' _ (kA_via E ζ₀ φ E' g hg θ hθ) N).w, Category.assoc, specθ_comp ζ₀ φ θ hθ]
  · rw [Category.assoc, kN_ι, ← Category.assoc, kN_ι, Category.assoc, kA_gC]

end Factor
