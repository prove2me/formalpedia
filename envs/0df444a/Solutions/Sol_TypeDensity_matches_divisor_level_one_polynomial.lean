theorem solution (O R : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R]
    (S : TypeDensity.SurfaceData O R) (beta : TypeDensity.BlowupRestriction R S.t S.x)
    (D : TypeDensity.TwoChartCurveData R S.t S.x beta) (Dv : TypeDensity.ExceptionalDivisor (IsLocalRing.ResidueField R))
    (e : (TypeDensity.BlowupChart R S.t S.x ⧸ TypeDensity.chartExceptional R S.t S.x) ≃+*
      Polynomial (IsLocalRing.ResidueField R))
    (he : ∀ r : R, e (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (TypeDensity.chartBase R S.t S.x r)) =
      Polynomial.C (IsLocalRing.residue R r))
    (heZ : e (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (TypeDensity.chartSlope R S.t S.x)) = Polynomial.X)
    (hm : TypeDensity.MatchesDivisor e D Dv) [IsNoetherianRing (TypeDensity.BlowupChart R S.t S.x)] :
    ((TypeDensity.leftKernel D 1).map (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x))).map e =
      Ideal.span {TypeDensity.divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv} := by
  classical
  have hmax : (Ideal.span ({S.t, S.x} : Set R)).IsMaximal := by
    rw [S.parameters]; exact IsLocalRing.maximalIdeal.isMaximal R
  set k := IsLocalRing.ResidueField R
  set q := Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x)
  have hdp := TypeDensity.direction_point_maximal O R S e he heZ
  have hQ {i : D.ι} {ψ : TypeDensity.AffineDirection k} (hψ : ψ ≠ TypeDensity.zeroAffine k)
      (h : D.Q i = (TypeDensity.directionPoint R S.t S.x e ψ).map
        (algebraMap (TypeDensity.BlowupChart R S.t S.x) (TypeDensity.BlowupOverlap R S.t S.x))) :
      TypeDensity.leftPoint D (Sum.inl i) = TypeDensity.directionPoint R S.t S.x e ψ := by
    change (D.Q i).comap _ = _
    rw [h]; exact (TypeDensity.direction_point_overlap_maximal O R S e he heZ ψ hψ).2.2
  choose φ hφne hφQ hφDv using hm.common
  -- the direction of each left point
  let dir : D.ι ⊕ D.ι0 → TypeDensity.AffineDirection k := Sum.elim φ (fun _ ↦ TypeDensity.zeroAffine k)
  have hdirP : ∀ s, TypeDensity.leftPoint D s = TypeDensity.directionPoint R S.t S.x e (dir s) := by
    rintro (i | j)
    exacts [hQ (hφne i) (hφQ i), (hm.zero j).1]
  have hdirM : ∀ s, Dv (some (dir s)) = TypeDensity.leftMultiplicity D s := by
    rintro (i | j)
    exacts [(hφDv i).trans (TypeDensity.two_chart_common_multiplicity_eq R S.t S.x beta D i).1.symm,
      (hm.zero j).2]
  have hdirDeg (s) : (dir s).val.natDegree = TypeDensity.leftResidueDegree D s := by
    rw [TypeDensity.leftResidueDegree, hdirP, (hdp (dir s)).2.2.2.2.1, ENat.toNat_natCast]
  have hdirInj : Function.Injective dir := fun s s' h ↦
    (TypeDensity.two_chart_left_points_maximal R S.t S.x beta D).2.1 (by rw [hdirP, hdirP, h])
  have hmonic_eq {p p' : TypeDensity.AffineDirection k} (h : p.val ∣ p'.val) : p.val = p'.val :=
    Polynomial.eq_of_monic_of_associated p.2.1 p'.2.1 (p.2.2.associated_of_dvd p'.2.2 h)
  have hC (s₀) : ((TypeDensity.leftKernel D 1).map q).map e ≤
      Ideal.span {(dir s₀).val ^ TypeDensity.leftMultiplicity D s₀} :=
    TypeDensity.left_kernel_map_le_span_direction_pow O R S beta D e he heZ s₀ _ (hdirP s₀)
  have : Fintype (D.ι ⊕ D.ι0) := Fintype.ofFinite _
  obtain ⟨ψ, hψ, hψdeg, hK⟩ := TypeDensity.left_kernel_polynomial_residueField O R S beta D e he heZ
  rw [finprod_eq_prod_of_fintype] at hK
  -- `∏ dir s ^ mult s ∣ ∏ ψ s ^ mult s`, and both are monic of the same degree
  have hdvd : (∏ s, (dir s).val ^ TypeDensity.leftMultiplicity D s) ∣ ∏ s, ψ s ^ TypeDensity.leftMultiplicity D s := by
    refine Finset.prod_dvd_of_coprime (fun s _ s' _ hne ↦ IsCoprime.pow ?_) fun s _ ↦
      Ideal.mem_span_singleton.1 (hC s (by rw [hK]; exact Ideal.subset_span rfl))
    rw [Irreducible.coprime_iff_not_dvd (dir s).2.2]
    exact fun hd ↦ hne (hdirInj (Subtype.ext (hmonic_eq hd)))
  have hGP := Polynomial.eq_of_monic_of_dvd_of_natDegree_le
    (Polynomial.monic_prod_of_monic _ _ fun s _ ↦ (dir s).2.1.pow _)
    (Polynomial.monic_prod_of_monic _ _ fun s _ ↦ (hψ s).1.pow _) hdvd <| by
      rw [Polynomial.natDegree_prod_of_monic _ _ fun s _ ↦ (hψ s).1.pow _,
        Polynomial.natDegree_prod_of_monic _ _ fun s _ ↦ (dir s).2.1.pow _]
      refine le_of_eq (Finset.sum_congr rfl fun s _ ↦ ?_)
      rw [Polynomial.natDegree_pow, Polynomial.natDegree_pow, hψdeg, hdirDeg]
  rw [hK, hGP]
  refine congrArg (fun p ↦ Ideal.span {p}) ?_
  unfold TypeDensity.divisorAffinePolynomial
  -- finally, the support of `Dv` consists of `∞` and the directions of the left points
  have hsub : Dv.support ⊆ insert none (Finset.univ.image (fun s ↦ some (dir s))) := by
    rintro (_ | ψ0) hP
    · exact Finset.mem_insert_self _ _
    rw [Finsupp.mem_support_iff] at hP
    refine Finset.mem_insert_of_mem (Finset.mem_image.2 ?_)
    by_cases hz : ψ0 = TypeDensity.zeroAffine k
    · subst hz
      obtain ⟨j⟩ := hm.zero_surj (Nat.pos_of_ne_zero hP)
      exact ⟨Sum.inr j, Finset.mem_univ _, rfl⟩
    · obtain ⟨i, hi⟩ := hm.common_surj ψ0 hz (Nat.pos_of_ne_zero hP)
      exact ⟨Sum.inl i, Finset.mem_univ _,
        congrArg some ((hdp ψ0).2.2.2.2.2 ((hdirP _).symm.trans (hQ hz hi)))⟩
  symm
  rw [Finsupp.prod_of_support_subset Dv hsub _ (by rintro (_ | ψ0) _ <;> simp),
    Finset.prod_insert (by simp),
    Finset.prod_image (fun a _ b _ h ↦ hdirInj (Option.some_injective _ h))]
  simp only [one_mul]
  exact Finset.prod_congr rfl fun s _ ↦ by rw [hdirM]
