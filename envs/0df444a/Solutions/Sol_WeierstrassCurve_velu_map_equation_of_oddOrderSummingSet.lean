    simp only [eval_add, eval_one, eval_prod, eval_sub, eval_X, eval_C]
    rw [Finset.prod_eq_zero (Finset.mem_univ x) (sub_self x), add_zero]
  rw [Polynomial.IsRoot, heval] at hx
  exact one_ne_zero hx

