/-!
# Compact source-ordered configuration catalogue

Literal data: rocq-community/fourcolor commit
c1d6b1cd5288bea4b067aac13cdde3c18dffe018, theories/proof/configurations.v.
Copyright 2006–2018 Microsoft Corporation and Inria; CeCILL-B.
See missions/four-color-theorem/data/LICENSE.fourcolor.

Source: Gonthier (2005), Section 3, PDF p. 9 (633 configurations), and
Section 5.2, PDF pp. 26–32 (configuration maps and finite validation).
This representation avoids importing large evaluated table-validity proofs.
The generic decoder returns only validated tables. Exact equality to the
original validated catalogue, including every entry and its order, is proved
separately in lean/CompactCatalogueEquivalence.lean; that heavyweight comparison
is not a dependency of the compact definition or the mission target statements.
This provides no proof of geometric embeddability, reducibility, or coverage.
-/

set_option maxRecDepth 65536
set_option maxHeartbeats 0

namespace FourColor.CompactCatalogue


def checkedTable (T : ConfigurationTable) : Option {T : ConfigurationTable // T.Valid} :=
  if h : T.validB = true then
    some ⟨T, (ConfigurationTable.validB_iff T).mp h⟩
  else
    none

theorem checkedTable_of_valid (T : ConfigurationTable) (h : T.Valid) :
    checkedTable T = some ⟨T, h⟩ := by
  simp only [checkedTable, (ConfigurationTable.validB_iff T).mpr h, dif_pos]

theorem filterMap_checkedTable_map (xs : List {T : ConfigurationTable // T.Valid}) :
    (xs.map Subtype.val).filterMap checkedTable = xs := by
  induction xs with
  | nil => rfl
  | cons T xs ih =>
    simp only [List.map_cons, List.filterMap_cons,
      checkedTable_of_valid T.val T.property, ih]

theorem checked_tables_eq_of_raw_eq
    (raw : List ConfigurationTable) (xs : List {T : ConfigurationTable // T.Valid})
    (h : raw = xs.map Subtype.val) : raw.filterMap checkedTable = xs := by
  rw [h, filterMap_checkedTable_map]

theorem checked_configurations_eq_of_raw_eq
    (raw : List ConfigurationTable) (xs : List {T : ConfigurationTable // T.Valid})
    (h : raw = xs.map Subtype.val) :
    ((raw.filterMap checkedTable).map fun entry ↦
      entry.val.toConfiguration entry.property) =
    (xs.map fun entry ↦ entry.val.toConfiguration entry.property) := by
  rw [checked_tables_eq_of_raw_eq raw xs h]


