-- statement:
--   # Opp-bank aux-slot retained dimensions
--
--   For Jain's round-seven witness 2 joint-frame schedule, each aux slot $s<R=27794$ carries a retained-frame dimension $f[s]\in\{0,\ldots,22\}$. The round-eight opposite-bank compile treats the aux edge at slot $s$ as a single child of width $m-(h-f[s])$ with $h=23$ and $m=529$ (see `independent/round8-oppbank/bit_hist.py`).
--
--   This module packs the frozen list $f[\cdot]$ as 8-bit fields in 65536-bit `packL` limbs (R6 BitNB convention) and exposes `auxF` / `auxCorner`. It is **schedule data**, not a QHNet Gen/Loc pack.
-- source:
--   Swapnil Jain, integer-mult-kappa certificates/round7 witness 2 via certificate_round7.build (S.f); packing discipline as Prove2me IntMul_Kappa_R6_Data_BitNBGenData_*.

import Mathlib.Data.Nat.Basic
import Mathlib.Data.Nat.Bitwise

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000

/-!
# R8 opp-bank aux-slot retained dimensions `f[s]` (packed)

Frozen joint-frame schedule from Jain `certificate_round7` witness 2 (`S.f`),
length `R = 27794`, values in `0..22`. Packed as 8-bit fields LSB-first in
65536-bit limbs (`packL`), matching the R6 BitNB packing discipline.

Opp-bank aux-edge corner width is `h - f[s]` with `h = 23`. Schedule data only.
-/

namespace IntMul.Kappa.R8.Bit.Oppbank

/-- Concatenate 65536-bit pieces, least significant first (R6 `BitNBGenData` convention). -/
def packL (l : List Nat) : Nat :=
  l.foldr (fun p acc => Nat.lor p (Nat.shiftLeft acc 65536)) 0

/-- Packed retained dimensions: field `s` (8 bits) is `f[s]` for `s < 27794`. -/
def auxFPack : Nat :=
  packL [
  ,
  ,
  ,
  
  ]

/-- Read 8-bit field `i` of a packed `Nat`. -/
def field8 (S i : Nat) : Nat :=
  (S >>> (8 * i)) &&& 255

/-- Retained dimension `f[s]` (returns `0` for out-of-range `s`). -/
def auxF (s : Nat) : Nat := field8 auxFPack s

/-- Corner rank `r_u(s) = 23 - f[s]`. -/
def auxCorner (s : Nat) : Nat := 23 - auxF s

end IntMul.Kappa.R8.Bit.Oppbank


