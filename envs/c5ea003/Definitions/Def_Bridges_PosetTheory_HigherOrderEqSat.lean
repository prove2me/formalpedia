- `extraction_agrees_with_quotient_nf_semantically` →
  `ho_extraction_agrees_with_quotient_nf_semantically`
-/

/-! ## Section 1: Simple Types and Contexts -/

/-- Simple types: a base type and arrow types. -/
inductive HOType : Type where
  | base : HOType
  | arrow : HOType → HOType → HOType
  deriving DecidableEq, Repr

namespace HOType

infixr:25 " ⟶ₕ " => HOType.arrow

end HOType

open HOType

/-- A typing context is a list of types (de Bruijn: head = most recently bound). -/
abbrev Ctx := List HOType

/-! ## Section 2: Variables and Terms (Intrinsically Typed de Bruijn) -/

/-- A variable is a typed index into a context. -/
inductive Var : Ctx → HOType → Type where
  | vz : ∀ {Γ : Ctx} {τ : HOType}, Var (τ :: Γ) τ
  | vs : ∀ {Γ : Ctx} {σ τ : HOType}, Var Γ τ → Var (σ :: Γ) τ

/-- Intrinsically typed λ-terms with de Bruijn indices. -/
inductive HOTerm : Ctx → HOType → Type where
  | var : ∀ {Γ : Ctx} {τ : HOType}, Var Γ τ → HOTerm Γ τ
  | lam : ∀ {Γ : Ctx} {σ τ : HOType}, HOTerm (σ :: Γ) τ → HOTerm Γ (σ ⟶ₕ τ)
  | app : ∀ {Γ : Ctx} {σ τ : HOType}, HOTerm Γ (σ ⟶ₕ τ) → HOTerm Γ σ → HOTerm Γ τ

open HOTerm Var

/-! ## Section 3: Denotational Semantics -/

/-- Interpret a simple type as a Lean type. Base type → `Nat`.
    We choose `Nat` (not `Unit`) so the semantics is non-degenerate:
    different terms can have genuinely different denotations. -/
noncomputable def TyDenote : HOType → Type
  | .base => Nat
  | .arrow σ τ => TyDenote σ → TyDenote τ

/-- An environment maps each variable in a context to a value. -/
noncomputable def Env : Ctx → Type
  | [] => Unit
  | τ :: Γ => Env Γ × TyDenote τ

/-- Look up a variable in an environment. -/
noncomputable def lookupVar : ∀ {Γ : Ctx} {τ : HOType}, Var Γ τ → Env Γ → TyDenote τ
  | _, _, .vz, (_, v) => v
  | _, _, .vs x, (ρ, _) => lookupVar x ρ

/-- Denotational semantics of a term in an environment. -/
noncomputable def denote : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → Env Γ → TyDenote τ
  | _, _, .var x, ρ => lookupVar x ρ
  | _, _, .lam body, ρ => fun a => denote body (ρ, a)
  | _, _, .app f arg, ρ => denote f ρ (denote arg ρ)

/-! ## Section 4: Renamings -/

/-- A renaming maps variables from one context to another. -/
def Renaming (Γ Δ : Ctx) : Type := ∀ {τ : HOType}, Var Γ τ → Var Δ τ

/-- Extend a renaming under a binder. -/
def Renaming.ext {Γ Δ : Ctx} {σ : HOType} (ρ : Renaming Γ Δ) :
    Renaming (σ :: Γ) (σ :: Δ)
  | _, .vz => .vz
  | _, .vs x => .vs (ρ x)

/-- Apply a renaming to a term. -/
def renameTerm {Γ Δ : Ctx} {τ : HOType} (ρ : Renaming Γ Δ) :
    HOTerm Γ τ → HOTerm Δ τ
  | .var x => .var (ρ x)
  | .lam body => .lam (renameTerm ρ.ext body)
  | .app f arg => .app (renameTerm ρ f) (renameTerm ρ arg)

/-- Weakening: embed a term into an extended context. -/
def weaken {Γ : Ctx} {σ τ : HOType} (t : HOTerm Γ τ) : HOTerm (σ :: Γ) τ :=
  renameTerm (fun x => .vs x) t

/-! ## Section 5: Substitutions -/

/-- A substitution maps variables to terms. -/
def Subst (Γ Δ : Ctx) : Type := ∀ {τ : HOType}, Var Γ τ → HOTerm Δ τ

/-- Extend a substitution under a binder. -/
def Subst.ext {Γ Δ : Ctx} {σ : HOType} (s : Subst Γ Δ) :
    Subst (σ :: Γ) (σ :: Δ)
  | _, .vz => .var .vz
  | _, .vs x => weaken (s x)

/-- Apply a substitution to a term. -/
def substTerm {Γ Δ : Ctx} {τ : HOType} (s : Subst Γ Δ) :
    HOTerm Γ τ → HOTerm Δ τ
  | .var x => s x
  | .lam body => .lam (substTerm s.ext body)
  | .app f arg => .app (substTerm s f) (substTerm s arg)

/-- Single substitution: replace variable 0, keep others. -/
def substSingle {Γ : Ctx} {σ : HOType} (arg : HOTerm Γ σ) :
    Subst (σ :: Γ) Γ
  | _, .vz => arg
  | _, .vs x => .var x

/-- β-reduction substitution: substitute `arg` for variable 0 in `body`. -/
def subst0 {Γ : Ctx} {σ τ : HOType}
    (arg : HOTerm Γ σ) (body : HOTerm (σ :: Γ) τ) : HOTerm Γ τ :=
  substTerm (substSingle arg) body

