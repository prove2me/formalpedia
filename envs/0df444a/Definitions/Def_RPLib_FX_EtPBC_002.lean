-- ===== S4.Def_RP_EtPBC_A_Z3Clo =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 1: idempotent sections and clopen subsets of a scheme

* `basicOpen_inf_one_sub`, `basicOpen_sup_one_sub`: for an idempotent `e ∈ Γ(X, U)`, `D(e)` and `D(1 - e)` partition
  `U`; **`isClopen_basicOpen`**: `D(e)` is clopen for an idempotent `e ∈ Γ(X, ⊤)`.
* `exists_idem_of_disjoint`: for disjoint opens `U`, `V` the section of `Γ(X, U ⊔ V)` that is `1` on `U` and `0` on
  `V` (sheaf gluing `objSupIsoProdEqLocus`) is idempotent.
* **`exists_idem_basicOpen_eq`**: every clopen open `U` is `D(e)` for an idempotent `e ∈ Γ(X, ⊤)`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

variable {X : Scheme.{u}}

theorem basicOpen_inf_one_sub {U : X.Opens} {e : Γ(X, U)} (he : IsIdempotentElem e) :
    X.basicOpen e ⊓ X.basicOpen (1 - e) = ⊥ := by
  rw [← Scheme.basicOpen_mul, mul_sub, mul_one, he.eq, sub_self, Scheme.basicOpen_zero]

theorem basicOpen_sup_one_sub {U : X.Opens} (e : Γ(X, U)) :
    X.basicOpen e ⊔ X.basicOpen (1 - e) = U := by
  refine le_antisymm (sup_le (X.basicOpen_le e) (X.basicOpen_le _)) ?_
  calc U = X.basicOpen (e + (1 - e)) := by rw [add_sub_cancel, Scheme.basicOpen_one]
    _ ≤ _ := Scheme.basicOpen_add_le X e (1 - e)

/-- For disjoint opens `U`, `V`: the idempotent of `Γ(X, U ⊔ V)` that is `1` on `U` and `0` on `V`. -/
theorem exists_idem_of_disjoint (U V : X.Opens) (hUV : U ⊓ V = ⊥) :
    ∃ c : Γ(X, U ⊔ V), IsIdempotentElem c ∧ X.presheaf.map (homOfLE le_sup_left).op c = 1 ∧
      X.presheaf.map (homOfLE le_sup_right).op c = 0 := by
  have hsub : Subsingleton ↑(X.sheaf.obj.obj (op (U ⊓ V))) := by
    rw [hUV]; exact (inferInstance : Subsingleton Γ(X, ⊥))
  let ι := (X.sheaf.objSupIsoProdEqLocus U V).inv
  let x : (CommRingCat.of (RingHom.eqLocus
      (RingHom.comp (X.sheaf.obj.map (homOfLE inf_le_left : U ⊓ V ⟶ U).op).hom
        (RingHom.fst (X.sheaf.obj.obj <| op U) (X.sheaf.obj.obj <| op V)))
      (RingHom.comp (X.sheaf.obj.map (homOfLE inf_le_right : U ⊓ V ⟶ V).op).hom
        (RingHom.snd (X.sheaf.obj.obj <| op U) (X.sheaf.obj.obj <| op V))))) :=
    ⟨(1, 0), @Subsingleton.elim _ hsub _ _⟩
  refine ⟨ι x, ?_, X.sheaf.objSupIsoProdEqLocus_inv_fst U V x, X.sheaf.objSupIsoProdEqLocus_inv_snd U V x⟩
  have hx : x * x = x := Subtype.ext (Prod.ext (mul_one _) (mul_zero _))
  show ι x * ι x = ι x
  rw [← map_mul, hx]

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3P1a =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 3 (G-a): the two affine charts of `P¹_K = Proj K[X₀, X₁]` and their coordinates

* `gr K`: the grading of `K[X₀, X₁]`, `x_mem`; `ch K i : Spec K[X₀,X₁]_(Xᵢ) ⟶ P¹` (Mathlib `Proj.awayι`),
  `chU K i := ch K i ''ᵁ ⊤` (`= D₊(Xᵢ)`, affine: `isAffineOpen_chU`).
* `coord K i j ∈ Γ(P¹, chU K i)`: the coordinate `Xⱼ/Xᵢ` (transported by `appIso`).
* **`basicOpen_coord`**: `D(coord K i j) = chU K i ⊓ D₊(Xⱼ)` (Mathlib `Proj.awayι_preimage_basicOpen`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace MvPolynomial HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

variable (K : Type u) [Field K]

/-- The grading of `K[X₀, X₁]`. -/
abbrev gr : ℕ → Submodule K (MvPolynomial (Fin 2) K) := homogeneousSubmodule (Fin 2) K

theorem x_mem (i : Fin 2) : (X i : MvPolynomial (Fin 2) K) ∈ gr K 1 :=
  (mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X K i)

/-- The chart `Spec K[X₀,X₁]_(Xᵢ) ⟶ P¹`. -/
abbrev ch (i : Fin 2) :
    Spec (CommRingCat.of (Away (gr K) (X i : MvPolynomial (Fin 2) K))) ⟶ Proj (gr K) :=
  Proj.awayι (gr K) (X i) (x_mem K i) one_pos

/-- The chart open (`= D₊(Xᵢ)`). -/
abbrev chU (i : Fin 2) : (Proj (gr K)).Opens := (ch K i) ''ᵁ ⊤

theorem chU_eq (i : Fin 2) : chU K i = Proj.basicOpen (gr K) (X i) :=
  ((ch K i).image_top_eq_opensRange).trans (Proj.opensRange_awayι _ _ _ _)

/-- The coordinate `Xⱼ/Xᵢ` on the chart `chU K i`. -/
def coord (i j : Fin 2) : Γ(Proj (gr K), chU K i) :=
  ((ch K i).appIso ⊤).inv ((Scheme.ΓSpecIso _).inv (Away.isLocalizationElem (x_mem K i) (x_mem K j)))

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3P1b =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 4 (G-a): the transition `t s = 1` on the overlap of the two charts of `P¹_K`

* `x01 = X₀ X₁`, `tr0`, `tr1`: the restrictions `K[X₀,X₁]_(Xᵢ) → K[X₀,X₁]_(X₀X₁)` (Mathlib `awayMap`);
  `tr_mul`: `tr0 (X₁/X₀) * tr1 (X₀/X₁) = 1`.
* `c0 = Spec tr0 ≫ ch 0`, `c1 = Spec tr1 ≫ ch 1`, `c0_eq_c1` (both are `Proj.awayι (X₀X₁)`), `top_le_c0`.
* `appLE_injective_of_eq`: for an open immersion `f` with image `W`, `f.appLE W ⊤` is injective.
* **`coord_mul_coord`**: `coord 0 1 |_W * coord 1 0 |_W = 1` on `W = chU 0 ⊓ chU 1`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace MvPolynomial HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

theorem appLE_injective_of_eq {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] {W : Y.Opens}
    (hW : f ''ᵁ ⊤ = W) (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ W) : Function.Injective (f.appLE W ⊤ e) := by
  subst hW
  have h : f.appLE (f ''ᵁ ⊤) ⊤ e = (f.appIso ⊤).hom := by
    rw [← Category.comp_id (f.appIso ⊤).hom, ← Iso.inv_comp_eq, Scheme.Hom.appIso_inv_appLE]
    convert X.presheaf.map_id (op ⊤)
    rfl
  rw [h]
  exact (ConcreteCategory.bijective_of_isIso _).1

variable (K : Type u) [Field K]

/-- `X₀ X₁`. -/
abbrev x01 : MvPolynomial (Fin 2) K := X 0 * X 1

/-- Restriction `K[X₀,X₁]_(X₀) → K[X₀,X₁]_(X₀X₁)`. -/
abbrev tr0 : Away (gr K) (X 0 : MvPolynomial (Fin 2) K) →+* Away (gr K) (x01 K) :=
  awayMap (gr K) (x_mem K 1) (rfl : x01 K = X 0 * X 1)

/-- Restriction `K[X₀,X₁]_(X₁) → K[X₀,X₁]_(X₀X₁)`. -/
abbrev tr1 : Away (gr K) (X 1 : MvPolynomial (Fin 2) K) →+* Away (gr K) (x01 K) :=
  awayMap (gr K) (x_mem K 0) (mul_comm _ _ : x01 K = X 1 * X 0)

theorem tr_mul : tr0 K (Away.isLocalizationElem (x_mem K 0) (x_mem K 1)) *
    tr1 K (Away.isLocalizationElem (x_mem K 1) (x_mem K 0)) = 1 := by
  rw [awayMap_mk, awayMap_mk]
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one, Away.val_mk, Away.val_mk,
    Localization.mk_mul]
  convert Localization.mk_self (⟨x01 K ^ 1, 1, rfl⟩ * ⟨x01 K ^ 1, 1, rfl⟩ : Submonoid.powers (x01 K)) using 2
  simp only [Submonoid.coe_mul, x01]
  ring

/-- The overlap chart through chart `0`. -/
abbrev c0 : Spec (CommRingCat.of (Away (gr K) (x01 K))) ⟶ Proj (gr K) :=
  Spec.map (CommRingCat.ofHom (tr0 K)) ≫ ch K 0

/-- The overlap chart through chart `1`. -/
abbrev c1 : Spec (CommRingCat.of (Away (gr K) (x01 K))) ⟶ Proj (gr K) :=
  Spec.map (CommRingCat.ofHom (tr1 K)) ≫ ch K 1

theorem c0_eq_awayι : c0 K = Proj.awayι (gr K) (x01 K) (SetLike.mul_mem_graded (x_mem K 0) (x_mem K 1))
    (by norm_num) :=
  Proj.SpecMap_awayMap_awayι (gr K) (x_mem K 0) one_pos (x_mem K 1) (rfl : x01 K = X 0 * X 1)

instance isOpenImmersion_c0 : IsOpenImmersion (c0 K) := by
  rw [c0_eq_awayι]
  infer_instance

theorem opensRange_congr {X Y : Scheme.{u}} {f g : X ⟶ Y} [IsOpenImmersion f] [IsOpenImmersion g]
    (h : f = g) : f.opensRange = g.opensRange := by
  subst h
  rfl

theorem map_eqToHom_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (hU : U = ⊤)
    (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ U) : Y.presheaf.map (eqToHom hU).op ≫ f.appLE U ⊤ e = f.appTop := by
  subst hU
  rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id, Category.id_comp, Scheme.Hom.appTop,
    Scheme.Hom.app_eq_appLE]
  rfl

/-- Restriction of a chart section along a factorisation `c = Spec φ ≫ g`. -/
theorem res_aux {R S : CommRingCat.{u}} {P : Scheme.{u}} (g : Spec R ⟶ P) [IsOpenImmersion g] (φ : R ⟶ S)
    (c : Spec S ⟶ P) (hc : c = Spec.map φ ≫ g) (W : P.Opens) (hW : W ≤ g ''ᵁ ⊤) (e : ⊤ ≤ c ⁻¹ᵁ W) :
    (Scheme.ΓSpecIso R).inv ≫ (g.appIso ⊤).inv ≫ P.presheaf.map (homOfLE hW).op ≫ c.appLE W ⊤ e =
      φ ≫ (Scheme.ΓSpecIso S).inv := by
  subst hc
  rw [Scheme.Hom.map_appLE, Scheme.Hom.comp_appLE, ← Category.assoc (g.appIso ⊤).inv,
    Scheme.Hom.appIso_inv_app, Scheme.ΓSpecIso_inv_naturality]
  exact congrArg ((Scheme.ΓSpecIso R).inv ≫ ·) (map_eqToHom_appLE _ _ _ _)

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3Gen =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 5 (G-b algebra): one generator for a chart of `P¹`, and pushouts

* `adjoin_X_zero`, **`away_adjoin`**: `K[X₀,X₁]_(Xᵢ)` is generated over the degree-`0` part by `Xⱼ/Xᵢ`;
  `away_surj_eval`: `K[X] → K[X₀,X₁]_(Xᵢ)`, `X ↦ Xⱼ/Xᵢ`, is surjective.
* `surj_eval₂_comp`, `surj_eval₂_map`: transport of "generated by one element" along surjections.
* **`pushout_surj`**: in a pushout square of commutative rings `B ⊗_R C`, if `B` is generated over `R` by `e`,
  then the pushout is generated over `C` by the image of `e`.
-/

set_option autoImplicit false

open CategoryTheory Limits MvPolynomial HomogeneousLocalization

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

section Poly

variable {R' R B B' : Type*} [CommRing R'] [CommRing R] [CommRing B] [CommRing B']

theorem surj_eval₂_comp (α : R' →+* R) (hα : Function.Surjective α) (f : R →+* B) (e : B)
    (h : Function.Surjective (Polynomial.eval₂RingHom f e)) :
    Function.Surjective (Polynomial.eval₂RingHom (f.comp α) e) := by
  intro y
  obtain ⟨p, rfl⟩ := h y
  obtain ⟨q, rfl⟩ := Polynomial.map_surjective α hα p
  exact ⟨q, by simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]⟩

theorem surj_eval₂_map (f : R →+* B) (e : B) (β : B →+* B') (hβ : Function.Surjective β)
    (h : Function.Surjective (Polynomial.eval₂RingHom f e)) :
    Function.Surjective (Polynomial.eval₂RingHom (β.comp f) (β e)) := by
  intro y
  obtain ⟨b, rfl⟩ := hβ y
  obtain ⟨p, rfl⟩ := h b
  exact ⟨p, by simp only [Polynomial.coe_eval₂RingHom, Polynomial.hom_eval₂]⟩

end Poly

/-- **Pushouts preserve one-generator algebras.** -/
theorem pushout_surj {R B C D : CommRingCat.{u}} {f : R ⟶ B} {g : R ⟶ C} {inl : B ⟶ D} {inr : C ⟶ D}
    (h : IsPushout f g inl inr) (e : B) (he : Function.Surjective (Polynomial.eval₂RingHom f.hom e)) :
    Function.Surjective (Polynomial.eval₂RingHom inr.hom (inl.hom e)) := by
  let T := (Polynomial.eval₂RingHom inr.hom (inl.hom e)).range
  have hw : inl.hom.comp f.hom = inr.hom.comp g.hom := by
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, h.w]
  have hl : ∀ b, inl.hom b ∈ T := by
    intro b
    obtain ⟨p, rfl⟩ := he b
    refine ⟨p.map g.hom, ?_⟩
    simp only [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map, Polynomial.hom_eval₂, hw]
  have hr : ∀ c, inr.hom c ∈ T := fun c => ⟨Polynomial.C c, Polynomial.eval₂_C _ _⟩
  let inl' : B ⟶ CommRingCat.of T := CommRingCat.ofHom (inl.hom.codRestrict T hl)
  let inr' : C ⟶ CommRingCat.of T := CommRingCat.ofHom (inr.hom.codRestrict T hr)
  have w : f ≫ inl' = g ≫ inr' := by
    ext x
    exact ConcreteCategory.congr_hom h.w x
  have hd : h.desc inl' inr' w ≫ CommRingCat.ofHom T.subtype = 𝟙 D := by
    apply h.hom_ext
    · rw [← Category.assoc, h.inl_desc, Category.comp_id]
      ext x
      rfl
    · rw [← Category.assoc, h.inr_desc, Category.comp_id]
      ext x
      rfl
  intro y
  have hy := ConcreteCategory.congr_hom hd y
  rw [CategoryTheory.comp_apply, CategoryTheory.id_apply] at hy
  rw [← hy]
  exact RingHom.mem_range.mp ((h.desc inl' inr' w) y).2

variable (K : Type u) [Field K]

theorem adjoin_X_zero :
    Algebra.adjoin (gr K 0) (Set.range (X : Fin 2 → MvPolynomial (Fin 2) K)) = ⊤ := by
  rw [eq_top_iff]
  intro p _
  refine MvPolynomial.induction_on p (fun c => ?_) (fun p q hp hq => add_mem hp hq)
    (fun p k hp => mul_mem hp (Algebra.subset_adjoin ⟨k, rfl⟩))
  exact Subalgebra.algebraMap_mem _
    (⟨C c, (mem_homogeneousSubmodule 0 _).mpr (isHomogeneous_C _ c)⟩ : gr K 0)

theorem algebraMap_zero_surj : Function.Surjective (algebraMap K (gr K 0)) := by
  rintro ⟨y, hy⟩
  change y ∈ homogeneousSubmodule (Fin 2) K 0 at hy
  rw [homogeneousSubmodule_zero, Submodule.mem_one] at hy
  obtain ⟨r, rfl⟩ := hy
  exact ⟨r, rfl⟩

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3Chart =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 6 (G-b): the charts of `P¹_V = P¹_K ×_K V` are generated by one coordinate

* `PV K gV = P¹_K ×_K V`, `pr`, `qV`; charts `Qc i = pr⁻¹ D₊(Xᵢ)`, coordinates `tc i j = pr^* (Xⱼ/Xᵢ)`,
  structure maps `ac i : Γ(V) → Γ(P_V, Qᵢ)`.
* `Wc i = P_V ×_{P¹} Spec K[X₀,X₁]_(Xᵢ)`, `jW i` (open immersion with image `Qᵢ`: `image_jW`), `isPullback_W`,
  `isPushout_W` (`V` affine: `Γ(Wᵢ) = K[X₀,X₁]_(Xᵢ) ⊗_K Γ(V)` as a pushout).
* **`surj_chart`**: `Γ(V)[X] → Γ(P_V, Qᵢ)`, `X ↦ tc i j`, is surjective (`V` affine, `i ≠ j`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace MvPolynomial HomogeneousLocalization
open RamanujanPetersson.EtCompact

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

theorem appLE_eq_of_eq {X Y : Scheme.{u}} {f f' : X ⟶ Y} (hf : f = f') (U : Y.Opens) (V : X.Opens)
    (e : V ≤ f ⁻¹ᵁ U) : f.appLE U V e = f'.appLE U V (hf ▸ e) := by
  subst hf
  rfl

theorem appLE_top_top {X Y : Scheme.{u}} (f : X ⟶ Y) (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) :
    f.appLE ⊤ ⊤ e = f.appTop := by
  rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
  rfl

theorem appTop_Spec_map {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    (Spec.map φ).appTop = (Scheme.ΓSpecIso R).hom ≫ φ ≫ (Scheme.ΓSpecIso S).inv := by
  rw [Scheme.ΓSpecIso_inv_naturality, Iso.hom_inv_id_assoc]

/-- Pulling a chart section back along a map that factors through the chart. -/
theorem chart_pull {R : CommRingCat.{u}} {P Z T : Scheme.{u}} (g : Spec R ⟶ P) [IsOpenImmersion g]
    (pr : Z ⟶ P) (h : T ⟶ Z) (k : T ⟶ Spec R) (hc : h ≫ pr = k ≫ g)
    (e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ (pr ⁻¹ᵁ (g ''ᵁ ⊤))) :
    (g.appIso ⊤).inv ≫ pr.app (g ''ᵁ ⊤) ≫ h.appLE _ ⊤ e = k.appTop := by
  rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, appLE_eq_of_eq hc, Scheme.Hom.comp_appLE,
    ← Category.assoc, Scheme.Hom.appIso_inv_app]
  exact map_eqToHom_appLE _ _ _ _

theorem surj_of_comp {R S S' : Type*} [CommRing R] [CommRing S] [CommRing S'] (a : R →+* S) (t : S)
    (ρ : S →+* S') (hρ : Function.Injective ρ)
    (hs : Function.Surjective (Polynomial.eval₂RingHom (ρ.comp a) (ρ t))) :
    Function.Surjective (Polynomial.eval₂RingHom a t) := by
  intro y
  obtain ⟨p, hp⟩ := hs (ρ y)
  refine ⟨p, hρ ?_⟩
  rw [← hp]
  simp only [Polynomial.coe_eval₂RingHom, Polynomial.hom_eval₂]

section Bundle

end Bundle

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z2H1 =====
section

/-!
# S4-EtPBC-A, (Z2a-c): `H¹` over the two charts, Artin-Rees, lifting mod `I^n`

Two-chart data as in `Z1.twoChart_fg`: `φ₀ : M₀ →ₗ[A[X]] N`, `φ₁ : M₁ →ₗ[A] N` with `X • φ₁ (X • m) = φ₁ m`.
`W := φ₀(M₀) + φ₁(M₁)` (`chartIm`), so that `H¹ = N / W`.

* **`h1_span`**: if `M₁` is finite over `A[X]`, every `y ∈ N` is `X^k • φ₁ b` and every `φ₁ m` is moved into the
  image of `φ₀` by a power of `X`, then `N = U + W` with `U` finite over `A` (`H¹` is finite over `A`).
* **`artinRees_sup`**: `N = U + W` with `U` finite, `A` noetherian: `∃ c, ∀ n, I^(n+c) N ∩ W ≤ I^n W`.
* **`lift_twoChart`**: `∃ c, ∀ n a b, φ₀ a - φ₁ b ∈ I^(n+c) N → ∃ a' b', φ₀ a' = φ₁ b'` with `a' ≡ a`, `b' ≡ b`
  mod `I^n`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Z2

universe u v w w'

variable {A : Type u} [CommRing A]

section Span

variable {M₀ : Type v} {M₁ : Type w} {N : Type w'}
  [AddCommGroup M₀] [Module A[X] M₀] [Module A M₀] [IsScalarTower A A[X] M₀]
  [AddCommGroup M₁] [Module A[X] M₁] [Module A M₁] [IsScalarTower A A[X] M₁]
  [AddCommGroup N] [Module A[X] N] [Module A N] [IsScalarTower A A[X] N]

/-- The images of the two charts, `W = φ₀(M₀) + φ₁(M₁)` (so `H¹ = N / W`). -/
def chartIm (φ₀ : M₀ →ₗ[A[X]] N) (φ₁ : M₁ →ₗ[A] N) : Submodule A N :=
  LinearMap.range (φ₀.restrictScalars A) ⊔ LinearMap.range φ₁

end Span

section ArtinRees

variable {N : Type w'} [AddCommGroup N] [Module A N]

/-- **Artin-Rees for `W` with `N = U + W`, `U` finite**: `I^(n+c) N ∩ W ≤ I^n W`. -/
theorem artinRees_sup [IsNoetherianRing A] (I : Ideal A) (U W : Submodule A N) (hU : U.FG) (hUW : U ⊔ W = ⊤) :
    ∃ c : ℕ, ∀ n : ℕ, (I ^ (n + c) • ⊤ : Submodule A N) ⊓ W ≤ I ^ n • W := by
  have : Module.Finite A U := Module.Finite.iff_fg.2 hU
  obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul I (W.comap U.subtype)
  refine ⟨c, fun n x ⟨hx, hxW⟩ => ?_⟩
  rw [← hUW, Submodule.smul_sup] at hx
  obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.1 hx
  have hwW : w ∈ W := Submodule.smul_le_right hw
  have huW : u ∈ W := by simpa using W.sub_mem hxW hwW
  have hU' : I ^ (n + c) • U = (I ^ (n + c) • (⊤ : Submodule A U)).map U.subtype := by
    rw [Submodule.map_smul'', Submodule.map_subtype_top]
  rw [hU'] at hu
  obtain ⟨u', hu', rfl⟩ := hu
  have h1 : u' ∈ I ^ (n + c) • (⊤ : Submodule A U) ⊓ W.comap U.subtype := ⟨hu', huW⟩
  rw [hc (n + c) (Nat.le_add_left c n), Nat.add_sub_cancel] at h1
  have h2 : u' ∈ I ^ n • W.comap U.subtype :=
    SetLike.le_def.1 (smul_mono_right _ inf_le_right) h1
  have h3 : U.subtype u' ∈ I ^ n • W := by
    have := Submodule.mem_map_of_mem (f := U.subtype) h2
    rw [Submodule.map_smul''] at this
    exact SetLike.le_def.1 (smul_mono_right _ (Submodule.map_comap_le _ _)) this
  have h4 : w ∈ I ^ n • W :=
    Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_add_right n c)) hw
  exact Submodule.add_mem _ h3 h4

end ArtinRees

section Lift

end Lift
end RamanujanPetersson.EtPBC.Z2
end

end

-- ===== S4.Def_RP_EtPBC_A_Z2Lift =====
section

/-!
# S4-EtPBC-A, (Z2d): idempotents on the two charts lift to approximate global idempotents

`A` noetherian, `I ⊆ A`, chart algebras `B₀` (over `A[t]`), `B₁` (over `A[s]`, both written over `A[X]`) and the
overlap algebra `N`, with `φ₀ : B₀ →ₐ[A[X]] N`, `φ₁ : B₁ →ₐ[A] N`, `X • φ₁ (X • m) = φ₁ m`.

* `idem_lift`: an idempotent mod `K` lifts to an idempotent mod `K^m` (nilpotent kernel, Mathlib 00J9 form).
* `idem_unique`: idempotents mod `L^m` congruent mod `L` are congruent mod `L^m`.
* `mem_smul_top_pow`: `x ∈ I^k • ⊤ ↔ x ∈ (I B)^k`.
* **`idem_twoChart`**: a pair of idempotents mod `I` on the two charts agreeing mod `I` on the overlap is congruent
  mod `I` to a pair `(a, b)` with `φ₀ a = φ₁ b` (a global section) that is idempotent mod `I^(n+1)`, for any `n`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Z2

universe u v w w'

variable {A : Type u} [CommRing A]

section Idem

variable {B : Type v} [CommRing B]

/-- Idempotents mod `K` lift to idempotents mod `K^m`. -/
theorem idem_lift (K : Ideal B) (m : ℕ) (x : B) (hx : x * x - x ∈ K) :
    ∃ y : B, y * y - y ∈ K ^ m ∧ y - x ∈ K := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · exact ⟨x, by simp, by simp⟩
  let f : B ⧸ K ^ m →+* B ⧸ K := Ideal.Quotient.factor (Ideal.pow_le_self hm.ne')
  have hnil : ∀ z ∈ RingHom.ker f, IsNilpotent z := by
    intro z hz
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hzK : z ∈ K := by
      rwa [RingHom.mem_ker, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem] at hz
    exact ⟨m, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.pow_mem_pow hzK m⟩
  have hidem : IsIdempotentElem (Ideal.Quotient.mk K x) := by
    rw [IsIdempotentElem, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hx
  obtain ⟨e', he', hfe'⟩ := exists_isIdempotentElem_eq_of_ker_isNilpotent f hnil _
    ⟨Ideal.Quotient.mk _ x, Ideal.Quotient.factor_mk _ x⟩ hidem
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective e'
  refine ⟨y, ?_, ?_⟩
  · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, he'.eq, sub_self]
  · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
    exact (Ideal.Quotient.factor_mk _ y).symm.trans hfe'

/-- Idempotents mod `L^m` that agree mod `L` agree mod `L^m`. -/
theorem idem_unique (L : Ideal B) (m : ℕ) {e f : B} (he : e * e - e ∈ L ^ m) (hf : f * f - f ∈ L ^ m)
    (hef : e - f ∈ L) : e - f ∈ L ^ m := by
  have h1 : IsIdempotentElem (Ideal.Quotient.mk (L ^ m) e) := by
    rw [IsIdempotentElem, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact he
  have h2 : IsIdempotentElem (Ideal.Quotient.mk (L ^ m) f) := by
    rw [IsIdempotentElem, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hf
  have h3 : IsNilpotent (Ideal.Quotient.mk (L ^ m) e - Ideal.Quotient.mk (L ^ m) f) :=
    ⟨m, by rw [← map_sub, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.pow_mem_pow hef m⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, eq_of_isNilpotent_sub_of_isIdempotentElem h1 h2 h3, sub_self]

end Idem

/-- `x ∈ I^k • ⊤ ↔ x ∈ (I B)^k`. -/
theorem mem_smul_top_pow {B : Type v} [CommRing B] [Algebra A B] (I : Ideal A) (k : ℕ) (x : B) :
    x ∈ (I ^ k • ⊤ : Submodule A B) ↔ x ∈ I.map (algebraMap A B) ^ k := by
  rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Ideal.map_pow]

