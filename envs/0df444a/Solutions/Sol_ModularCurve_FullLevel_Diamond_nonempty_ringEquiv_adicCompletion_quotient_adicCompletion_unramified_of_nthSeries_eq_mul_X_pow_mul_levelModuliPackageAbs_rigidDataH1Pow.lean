    rw [map_sub, map_one, hr1, sub_self]
  have h𝔫W : (IsLocalRing.maximalIdeal Z₀).map (algebraMap Z₀ (Pz.B₀ ⧸ 𝔭z)) ≤ 𝔫 := by
    rw [hZ₀q, Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff, map_natCast, SetLike.mem_coe,
