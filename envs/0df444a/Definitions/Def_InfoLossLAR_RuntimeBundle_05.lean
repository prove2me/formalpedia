      · intro h
        rcases List.mem_flatMap.mp h with ⟨a,ha,ht⟩
        rcases List.mem_map.mp ht with ⟨t,hmember,he⟩
        rcases List.cons.inj he with ⟨rfl,rfl⟩
        rcases (ih t).mp hmember with ⟨hlen,hmem⟩
