-- title:
--   Pauli-rotation and open-chain brickwork probability laws (Definition 1.2; Remark 1.18)
-- statement:
--   For a nonidentity Pauli string $P$, put $R_P(\theta)=\cos\theta\,I+i\sin\theta\,P=e^{i\theta P}$. Let $\Theta_{\mathrm{circ}}=\mathbb R/2\pi\mathbb Z$ and $\Theta_8=(\pi/4)\mathbb Z/(2\pi\mathbb Z)$. The rotation subgroup is the least closed subgroup generated by these matrices; for a discrete angle subgroup the full centre is included. Each subgroup carries its actual Haar probability measure.
--
--   The random Pauli rotation and random Pauli Clifford rotation laws are
--   $$\nu_{\mathrm{RPR}}=\frac1{4^n-1}\sum_{P\in\mathcal P_n}\mu_{\{R_P(\theta):\theta\in\Theta_{\mathrm{circ}}\}},\qquad
--   \nu_{\mathrm{RPCR}}=\frac1{4^n-1}\sum_{P\in\mathcal P_n}\mu_{Z\cdot\{R_P(\theta):\theta\in\Theta_8\}},$$
--   where $Z$ is the full centre of the special Clifford group. The second measure is on $\mathrm{Cl}(n)$ itself.
--
--   For the open chain, edge $j$ connects zero-based qubits $j,j+1$. Independently Haar-random gates on even edges form the first product layer, followed by gates on odd edges. Using local unitary groups gives $\nu_{\mathrm{BRUC}}$; using local Clifford groups gives $\nu_{\mathrm{BRCC}}$. Product order follows (1.20), and its reversal has the same gap. The file also defines the chain and all-pairs projector averages with exactly the weights $1/(n-1)$ and $2/(n(n-1))$.
--
--   These are the paper's four laws, without periodic edges or a quotient by phase. Pauli mixtures are used only for $n\ge1$, and brickwork bounds only for $n\ge2$.
-- source:
--   Baer, Haah, Random unitary circuits with constant spectral gap, STOC 2027 submission #15 (preprint), p. 3, 7–8, Definition 1.2; Remark 1.18, (1.20)–(1.22)

import Definitions.Def_ConstGapCircuits_quantumGroups
import Definitions.Def_ConstGapCircuits_spectralGap

noncomputable section

namespace ConstGapCircuits
open MeasureTheory
open scoped BigOperators ENNReal
attribute [local instance] Classical.propDecidable Classical.decEq

/-- The least closed subgroup containing the indicated elements. -/
def closedGenerated {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (S : Set G) : ClosedSubgroup G :=
  ⟨(Subgroup.closure S).topologicalClosure, (Subgroup.closure S).isClosed_topologicalClosure⟩

/-- e^(i theta P), using P²=1. -/
def rotation {n : ℕ} (p : Fin n → Fin 4) (θ : ℝ) : Mat n :=
  (Real.cos θ : ℂ) • (1 : Mat n) + (Complex.I * (Real.sin θ : ℂ)) • pauli p

abbrev AngleGroup := AddCircle (2 * Real.pi)
abbrev Angles := ClosedAddSubgroup AngleGroup

def circleAngles : Angles := ⟨⊤, isClosed_univ⟩
def cliffordAngles : Angles :=
  ⟨(AddSubgroup.zmultiples ((Real.pi / 4 : ℝ) : AngleGroup)).topologicalClosure,
    AddSubgroup.isClosed_topologicalClosure _⟩

/-- Angle subgroup inside a given quantum group; for discrete angles the centre is also averaged. -/
def thetaSubgroup {n : ℕ} {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (π : G →* SU n) (Θ : Angles) (p : Fin n → Fin 4) : ClosedSubgroup G :=
  closedGenerated {U | (∃ θ : ℝ, (θ : AngleGroup) ∈ Θ ∧ (π U : Mat n) = rotation p θ) ∨
    (DiscreteTopology Θ ∧ π U ∈ Subgroup.center (SU n))}

/-- Average of an indexed finite family of measures, with multiplicity. -/
def measureAverage {G : Type} [MeasurableSpace G] {L : ℕ} (ν : Fin L → Measure G) : Measure G :=
  (L : ℝ≥0∞)⁻¹ • ∑ j, ν j

/-- Product order agrees with (1.16) and (1.20). -/
def measureProduct {G : Type} [Group G] [MeasurableSpace G]
    (ν : List (Measure G)) : Measure G := ν.foldl Measure.mconv (Measure.dirac 1)

/-- Definition 1.2, equivalently (1.22): uniform mixture over nonidentity Pauli circles. -/
def rpr (n : ℕ) : Measure (SU n) :=
  (Fintype.card (PauliIndex n) : ℝ≥0∞)⁻¹ •
    ∑ p : PauliIndex n, haarOn (thetaSubgroup (MonoidHom.id _) circleAngles p.val)

/-- Haar on the group of the eight Pauli angles and the full centre. -/
def rpcr (n : ℕ) : Measure (Cl n) :=
  (Fintype.card (PauliIndex n) : ℝ≥0∞)⁻¹ •
    ∑ p : PauliIndex n, haarOn (thetaSubgroup (G := Cl n) (cliffordInclusion n) cliffordAngles p.val)

/-- Edge j in zero-based indexing is supported on qubits j,j+1. -/
def edgeSupport (n : ℕ) (j : Fin (n - 1)) : Finset (Fin n) :=
  {⟨j.val, by omega⟩, ⟨j.val + 1, by omega⟩}

def brickwork {G : Type} [Group G] [MeasurableSpace G] (n : ℕ)
    (gate : Fin (n - 1) → Measure G) : Measure G :=
  measureProduct (((List.finRange (n - 1)).filter (fun j => j.val % 2 = 0)).map gate ++
    ((List.finRange (n - 1)).filter (fun j => j.val % 2 = 1)).map gate)

def bruc (n : ℕ) : Measure (SU n) := brickwork n (fun j => haarOn (localUnitary (edgeSupport n j)))
def brcc (n : ℕ) : Measure (Cl n) := brickwork n (fun j => haarOn (localClifford (edgeSupport n j)))

/-- Both averages in (2.8),(2.9) and (4.2),(4.3), preserving the paper's weights. -/
def chainProjector {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
    (n : ℕ) (H : Finset (Fin n) → ClosedSubgroup G) (ρ : UnitaryRep G) :=
  ((n - 1 : ℕ) : ℂ)⁻¹ • ∑ j : Fin (n - 1), subgroupProjector (H (edgeSupport n j)) ρ

def allPairsProjector {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [CompactSpace G] [T2Space G] [MeasurableSpace G] [BorelSpace G]
    (n : ℕ) (H : Finset (Fin n) → ClosedSubgroup G) (ρ : UnitaryRep G) :=
  (2 / ((n : ℂ) * (n - 1 : ℕ))) •
    ∑ i : Fin n, ∑ j : Fin n, if i < j then subgroupProjector (H {i,j}) ρ else 0

end ConstGapCircuits


