theorem LLLState.ofBasis_valid (b : Hex.Matrix Int n m) :
    (Hex.Internal.LLLState.ofBasis b).Valid := by
  let gs := Hex.GramSchmidt.Int.data b
  constructor
  · intro i j hi hj hji
