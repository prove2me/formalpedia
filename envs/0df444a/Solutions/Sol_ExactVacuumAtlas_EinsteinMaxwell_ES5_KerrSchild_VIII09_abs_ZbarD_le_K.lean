theorem abs_sum4_le {a b c d : ℝ} : |a + b + c + d| ≤ |a| + |b| + |c| + |d| := by
  have h1 := abs_add_le (a + b + c) d
  have h2 := abs_add_three_le (a := a) (b := b) (c := c)
  linarith

theorem abs_sum5_le {a b c d e : ℝ} :
    |a + b + c + d + e| ≤ |a| + |b| + |c| + |d| + |e| := by
  have h1 := abs_add_le (a + b + c + d) e
  have h2 := abs_sum4_le (a := a) (b := b) (c := c) (d := d)
