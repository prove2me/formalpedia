set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

/-- The clog loop. -/
theorem clL_sol_aux {W : ℕ} {c : Cs} {vb : Vr} {m : ℕ} (hvb : BV W vb) (h5 : vb 5 = 1) (h6 : vb 6 = 0)
    (h24 : vb 24 = m) (hm : 2 * m + 2 < 2 ^ W) (hc : c cLC = []) :
    Rn (.rep cLC (.reg 24) (PJ.asgs [(6, eCf), (5, eCg)])) vb c
      (fun v => v = update (update vb 6 (Nat.clog 2 m : ℤ)) 5 ((2 ^ Nat.clog 2 m : ℕ) : ℤ) ∧ BV W v)
      c (cLoop W m (cA W [(6, eCf), (5, eCg)])) := by
  have hW : 2 ≤ 2 ^ W := by omega
  have hcl : Nat.clog 2 m ≤ m := by
    rcases Nat.lt_or_ge m 2 with h | h
    · rw [Nat.clog_of_right_le_one (by omega)]; omega
    · exact (Nat.clog_le_iff_le_pow (by norm_num)).mpr (le_of_lt Nat.lt_two_pow_self)
  have hp : 2 ^ Nat.clog 2 m ≤ 2 * m + 1 := by
    rcases Nat.lt_or_ge m 2 with h | h
    · rw [Nat.clog_of_right_le_one (by omega)]; omega
    · have hlt := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (show 1 < m by omega)
      rw [Nat.pred_eq_sub_one] at hlt
      have hpos : 0 < Nat.clog 2 m := Nat.clog_pos (by norm_num) (by omega)
      have : 2 ^ Nat.clog 2 m = 2 * 2 ^ (Nat.clog 2 m - 1) := by
        rw [← pow_succ']; congr 1; omega
      omega
  have h := Rn.loopA (c := c) (C := cLC) (rN := 24) (l := [(6, eCf), (5, eCg)]) nrg48 (by decide)
    (by decide) (by decide) (W := W) (by simp [lbA, eCf, eCg, E.lb]; omega) (N := m) (by omega)
    (Iv := fun k v => v = update (update vb 6 ((min k (Nat.clog 2 m) : ℕ) : ℤ)) 5
      ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ))
    (fun k hk v hI hB => by
      subst hI
      obtain ⟨s1, s2⟩ := clS_step m k
      have e1 : eCf.den (update (update vb 6 ((min k (Nat.clog 2 m) : ℕ) : ℤ)) 5
          ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ)) = ((min (k + 1) (Nat.clog 2 m) : ℕ) : ℤ) := by
        rw [← s2]; simp [eCf, E.den, update_apply, h24]
      have e2 : ∀ a : ℤ, eCg.den (update (update (update vb 6 ((min k (Nat.clog 2 m) : ℕ) : ℤ)) 5
          ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ)) 6 a) = ((2 ^ min (k + 1) (Nat.clog 2 m) : ℕ) : ℤ) := by
        intro a; rw [← s1]; simp [eCg, E.den, update_apply, h24]
      have hmin : min (k + 1) (Nat.clog 2 m) ≤ Nat.clog 2 m := min_le_right _ _
      have hpw : 2 ^ min (k + 1) (Nat.clog 2 m) ≤ 2 ^ Nat.clog 2 m :=
        Nat.pow_le_pow_right (by norm_num) hmin
      refine ⟨⟨?_, ?_, trivial⟩, ?_⟩
      · rw [e1, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)
      · rw [e1, e2, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)
      · simp only [runA]; rw [e1, e2]
        funext q; simp only [update_apply]; split_ifs <;> simp_all)
    hc (by funext q; simp only [update_apply]; split_ifs <;> simp_all) hvb h24
  refine h.mono (fun v ⟨hv, hB⟩ => ⟨?_, hB⟩) le_rfl
  rw [hv, min_eq_right hcl]

end J6Seg.PJ

