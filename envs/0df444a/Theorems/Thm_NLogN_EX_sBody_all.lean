theorem NLogN.EX.sBody_all (M : MulSpec) (q : Params) (kb mm Φ Bacc Q Bq Bx : ℕ) (BS : ℕ → ℕ)
    (hM : MulBnd M mm Φ) (hsl : q.s.length = q.K) (hst : ∀ i < q.K, sK q i ≤ tK q i)
    (hBx : Vx q kb < 2 ^ Bx) (k : ℕ) (hk : k < q.K) (H : SAx q kb mm Bacc Q Bq BS k)
    (U : List (ℤ × ℤ)) (w : IState HS) (R LS LM LC : List Item) (hg : Glob q kb w)
    (hD : w.G gD = gints (XS q U k) ++ R) (hL : (XS q U k).length = NS q k)
    (hLB : GB (BS k) (XS q U k))
    (hS : w.G xS = .int (sK q k : ℤ) :: LS) (hMx : w.G xM = .int (NS q k : ℤ) :: LM)
    (hc : w.G cL = .int ((q.K : ℤ) - k) :: LC) :
    NLogN.EX.sBody.run w = (((w.upd gD (gints (XS q U (k + 1)) ++ R)).upd xM
        (.int (NS q (k + 1) : ℤ) :: LM)).upd xU (.int (sK q k : ℤ) :: w.G xU)).upd xS LS ∧
      NLogN.EX.sBody.ok M w ∧
      NLogN.EX.sBody.cost M w ≤
        sapAxCost q.p (sK q k) (tK q k) q.α (mS q k) kb (BS k) mm Φ Bacc Q Bq + sOver Bx ∧
      (XS q U (k + 1)).length = NS q (k + 1) ∧ GB (BS (k + 1)) (XS q U (k + 1)) := by sorry
