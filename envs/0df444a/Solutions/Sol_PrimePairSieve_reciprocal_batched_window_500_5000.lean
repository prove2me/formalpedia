theorem solution (z : ℝ) (hz : 500 ≤ z) (hupper : z ≤ 5000) :
    Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant) /
      (1-((z+1)*(Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant))/(16*z^2))) ≤
      ∑ n ∈ Finset.Icc 1 ⌊z⌋₊,
        (if Squarefree n then ∏ p ∈ n.primeFactors, if p = 2 then (1:ℝ) else 2/((p:ℝ)-2) else 0)/(1+(n:ℝ)/z) := by

  by_cases h667 : z ≤ 667
  · exact BatchedWindow500_5000.cell_500 z (by linarith) h667

  by_cases h892 : z ≤ 892
  · exact BatchedWindow500_5000.cell_667 z (by linarith) h892

  by_cases h1181 : z ≤ 1181
  · exact BatchedWindow500_5000.cell_892 z (by linarith) h1181

  by_cases h1535 : z ≤ 1535
  · exact BatchedWindow500_5000.cell_1181 z (by linarith) h1535

  by_cases h1955 : z ≤ 1955
  · exact BatchedWindow500_5000.cell_1535 z (by linarith) h1955

  by_cases h2415 : z ≤ 2415
  · exact BatchedWindow500_5000.cell_1955 z (by linarith) h2415

  by_cases h2929 : z ≤ 2929
  · exact BatchedWindow500_5000.cell_2415 z (by linarith) h2929

  by_cases h3402 : z ≤ 3402
  · exact BatchedWindow500_5000.cell_2929 z (by linarith) h3402

  by_cases h3820 : z ≤ 3820
  · exact BatchedWindow500_5000.cell_3402 z (by linarith) h3820

  by_cases h4189 : z ≤ 4189
  · exact BatchedWindow500_5000.cell_3820 z (by linarith) h4189

  by_cases h4493 : z ≤ 4493
  · exact BatchedWindow500_5000.cell_4189 z (by linarith) h4493

  by_cases h4731 : z ≤ 4731
  · exact BatchedWindow500_5000.cell_4493 z (by linarith) h4731

  by_cases h4918 : z ≤ 4918
  · exact BatchedWindow500_5000.cell_4731 z (by linarith) h4918

  exact BatchedWindow500_5000.cell_4918 z (by linarith) hupper

example : ∀ z : ℝ, 500 ≤ z → z ≤ 5000 →
      (Real.log (4 * z)) ^ 2 / (2 * TaoFivePrimes.twinPrimeConstant) /
          (1 - ((z + 1) * ((Real.log (4 * z)) ^ 2 /
            (2 * TaoFivePrimes.twinPrimeConstant)) / (16 * z ^ 2)))
        ≤ ∑ q ∈ Finset.Icc 1 ⌊z⌋₊,
          (if Squarefree q then
            ∏ p ∈ q.primeFactors, if p = 2 then (1 : ℝ) else 2 / ((p : ℝ) - 2)
          else 0) / (1 + (q : ℝ) / z) := solution

