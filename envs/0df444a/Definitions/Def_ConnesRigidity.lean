theorem invariantDual_boxDetection_bound
    (μ : ProbabilityMeasure (X × Y))
    (hμ : IsInvariantDualProbability μ)
    (N : ℕ) (hN : 0 < N) :
    (μ : Measure (X × Y)).real (boxDetectionSet N) ≤
