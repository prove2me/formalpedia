theorem GlobalTheory.CompanionTheory.FinGL.card_same_block :
    Fintype.card {p : ι × ι // b p.1 = b p.2} =
      ∑ c, Fintype.card {i // b i = c} * Fintype.card {i // b i = c} := by sorry
