variable {p : ℕ} [Fact p.Prime] {σ : Type*}

theorem PI.JetsPhW.W.coeff_expMv (f : MvPowerSeries σ ℂ_[p]) (α : σ →₀ ℕ) :
    coeff α (expMv f) =
      ∑ n ∈ Finset.range (Finsupp.degree α + 1), coeff α (f ^ n) / (n.factorial : ℂ_[p]) := by sorry
