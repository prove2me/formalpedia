theorem wxClass
    (q : ℕ) [Fact q.Prime] (hq3 : q = 3) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (π : AlgebraicClosure ℚ) (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) (hπP : π ∈ A)
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (OSS : ↥W → ValuationSubring (fieldBar q M'))

    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (hIg_inj : Function.Injective OIg)
    (hIg_perm : ∀ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      ∃ σ : Equiv.Perm (CuspidalType.ProjLine q),
        ∀ ℓ, (OIg ℓ).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OIg (σ ℓ))

    (hSS_A : ∀ s (x : AlgebraicClosure ℚ), algebraMap (AlgebraicClosure ℚ) (fieldBar q M') x ∈ OSS s ↔ x ∈ A)
    (hSS_over : ∀ (s : ↥W) (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
        (IntermediateField.inclusion hle f : fieldBar q M') ∈ OSS s ∧
        ∀ a : A, residue A a =
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
          ∃ h : (IntermediateField.inclusion hle f : fieldBar q M')
              - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s,
            (⟨_, h⟩ : OSS s) ∈ maximalIdeal (OSS s))
    (hSS_fix : ∀ (s : ↥W) (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      (OSS s).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OSS s)

    (hSS_tr : ∀ s : ↥W, ∃ t : fieldBar q M', t ∈ OSS s ∧ ∀ a : A,
      ∃ h : t - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s, IsUnit (⟨_, h⟩ : OSS s))

    (K₀ : Subfield (AlgebraicClosure ℚ)) [Algebra.IsAlgebraic ↥K₀ (AlgebraicClosure ℚ)] (hπK₀ : π ∈ K₀)
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] [HenselianLocalRing A₀]
    (ι : A₀ →+* ↥A) [IsLocalHom ι] (hι : Function.Injective ι)
    (hιK₀ : Set.range (fun a : A₀ => ((ι a : ↥A) : AlgebraicClosure ℚ)) =
      (A : Set (AlgebraicClosure ℚ)) ∩ (K₀ : Set (AlgebraicClosure ℚ)))
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι))
    (ϖ₀ : A₀) (hϖ₀ : maximalIdeal A₀ = Ideal.span {ϖ₀})

    (hϖ₀π : ((ι ϖ₀ : ↥A) : AlgebraicClosure ℚ) = π)

    (F₀ : Subfield ↥(fieldBar q M'))
    (hF₀ : ∀ f : ↥(fieldBar q M'), f ∈ F₀ ↔ ∀ n : ℤ, ((f : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)).coeff n ∈ K₀)

    (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀)

    [Algebra A₀ ↥F₀]
    (hj₀ : ∀ a : A₀, ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') ((ι a : ↥A) : AlgebraicClosure ℚ))
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (hk₀ : ∀ x : AlgebraicClosure ℚ, x ∈ k₀ ↔ x ∈ K₀)
    (π₀ : ↥k₀) (hπ₀π : (π₀ : AlgebraicClosure ℚ) = π) (s : ↥W) :
    letI : Algebra ↥k₀ ↥(fieldBar q M') :=
      ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).comp (algebraMap ↥k₀ (AlgebraicClosure ℚ))).toAlgebra
    ∀ (F₀' : IntermediateField ↥k₀ ↥(fieldBar q M')) (hF₀' : ∀ f : ↥(fieldBar q M'), f ∈ F₀' ↔ f ∈ F₀)
      (O : Subring ↥F₀') (Wx : ValuationSubring ↥F₀')
      (hWxA : ∀ x : ↥k₀, (x : (AlgebraicClosure ℚ)) ∈ A ↔ algebraMap ↥k₀ ↥F₀' x ∈ Wx)
      (hWxunif : ∃ hπW : algebraMap ↥k₀ ↥F₀' π₀ ∈ Wx, maximalIdeal ↥Wx = Ideal.span {(⟨_, hπW⟩ : ↥Wx)})
      (hN3law : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
        (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
        (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
            ↥(modularFunctionFieldBar M'))) →
        ∃ hF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ F₀',
          (⟨_, hF⟩ : ↥F₀') ∈ Wx ∧
          (∀ hW : (⟨_, hF⟩ : ↥F₀') ∈ Wx, (⟨_, hW⟩ : ↥Wx) ∈ maximalIdeal ↥Wx ↔
            (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = 0) ∧
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
            (⟨_, hF⟩ : ↥F₀') ∈ O ∧
            ∀ (hO : (⟨_, hF⟩ : ↥F₀') ∈ O) (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A) (hcO : algebraMap ↥k₀ ↥F₀' c ∈ O),
              residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
              ¬ IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, hcO⟩))),
    ∃ ℓ' : CuspidalType.ProjLine q, ∀ f : ↥F₀', f ∈ Wx ↔ (f : ↥(fieldBar q M')) ∈ OIg ℓ' := by
  intro F₀' hF₀' O Wx hWxA hWxunif hN3law
  classical
  set JF : ↥(fieldBar q M') := (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) with hJF
  have hconstk₀ : ∀ c : ↥k₀, ((algebraMap ↥k₀ ↥F₀' c : ↥F₀') : ↥(fieldBar q M')) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) := fun c => rfl

  let eF : ↥F₀ ≃+* ↥F₀' :=
    { toFun := fun x => ⟨x.1, (hF₀' x.1).mpr x.2⟩
      invFun := fun x => ⟨x.1, (hF₀' x.1).mp x.2⟩
      left_inv := fun x => rfl
      right_inv := fun x => rfl
      map_mul' := fun x y => Subtype.ext (by simp only [MulMemClass.coe_mul])
      map_add' := fun x y => Subtype.ext (by simp only [AddMemClass.coe_add]) }
  have heF : ∀ x : ↥F₀, ((eF x : ↥F₀') : ↥(fieldBar q M')) = (x : ↥(fieldBar q M')) := fun x => rfl
  let V : ValuationSubring ↥F₀ := Wx.comap eF.toRingHom
  have hV : ∀ x : ↥F₀, x ∈ V ↔ eF x ∈ Wx := fun x => ValuationSubring.mem_comap

  have hιk₀ : ∀ a : A₀, ((ι a : ↥A) : AlgebraicClosure ℚ) ∈ k₀ :=
    fun a => (hk₀ _).mpr ((hιK₀.subset (Set.mem_range_self a)).2)
  have heconst : ∀ a : A₀, eF (algebraMap A₀ ↥F₀ a) =
      algebraMap ↥k₀ ↥F₀' ⟨((ι a : ↥A) : AlgebraicClosure ℚ), hιk₀ a⟩ := by
    intro a; apply Subtype.ext; rw [heF, hj₀ a]; rfl
  have hconstV : ∀ a : A₀, algebraMap A₀ ↥F₀ a ∈ V := by
    intro a; rw [hV, heconst]; exact (hWxA _).mp (ι a).2

  have hunitV : ∀ (x : ↥F₀) (hx : x ∈ V), IsUnit (⟨x, hx⟩ : ↥V) ↔ IsUnit (⟨eF x, (hV x).mp hx⟩ : ↥Wx) := by
    intro x hx
    rw [vs_isUnit_iff V x hx, vs_isUnit_iff Wx (eF x) ((hV x).mp hx), hV, map_inv₀, map_ne_zero_iff _ eF.injective]

  obtain ⟨hπW, hWxmax⟩ := hWxunif
  have hπmax : (⟨_, hπW⟩ : ↥Wx) ∈ maximalIdeal ↥Wx := by rw [hWxmax]; exact Ideal.mem_span_singleton_self _
  have heϖ : eF (algebraMap A₀ ↥F₀ ϖ₀) = algebraMap ↥k₀ ↥F₀' π₀ := by
    apply Subtype.ext; rw [heF, hj₀, hconstk₀, hϖ₀π, hπ₀π]
  have hϖV : (⟨algebraMap A₀ ↥F₀ ϖ₀, hconstV ϖ₀⟩ : ↥V) ∈ maximalIdeal ↥V := by
    apply (IsLocalRing.mem_maximalIdeal _).mpr
    intro hu
    have hu'' := (hunitV _ _).mp hu
    have heq : (⟨eF (algebraMap A₀ ↥F₀ ϖ₀), (hV _).mp (hconstV ϖ₀)⟩ : ↥Wx) = ⟨_, hπW⟩ := Subtype.ext heϖ
    rw [heq] at hu''
    exact (IsLocalRing.mem_maximalIdeal _).mp hπmax hu''
  have hloc : ∀ m ∈ maximalIdeal A₀, (⟨algebraMap A₀ ↥F₀ m, hconstV m⟩ : ↥V) ∈ maximalIdeal ↥V := by
    intro m hm
    rw [hϖ₀] at hm
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hm
    have : (⟨algebraMap A₀ ↥F₀ (r * ϖ₀), hconstV _⟩ : ↥V) =
        ⟨algebraMap A₀ ↥F₀ r, hconstV r⟩ * ⟨algebraMap A₀ ↥F₀ ϖ₀, hconstV ϖ₀⟩ :=
      Subtype.ext (by simp only [MulMemClass.coe_mul, map_mul])
    rw [this]; exact Ideal.mul_mem_left _ _ hϖV

  let Wset : Set ↥(fieldBar q M') := {f | ∃ hf : f ∈ F₀', (⟨f, hf⟩ : ↥F₀') ∈ Wx}
  have hWlaw : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
      (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
          ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ≠ 0 →
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ Wset ∧
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M'))⁻¹ ∈ Wset := by
    intro g hg hgi hcusp hne
    obtain ⟨hF, hgW, hgmax, -⟩ := hN3law g hg hgi hcusp
    have hu : IsUnit (⟨_, hgW⟩ : ↥Wx) := by
      by_contra hnu
      exact hne ((hgmax hgW).mp ((IsLocalRing.mem_maximalIdeal _).mpr hnu))
    obtain ⟨hinv, -⟩ := (vs_isUnit_iff Wx _ hgW).mp hu
    exact ⟨⟨hF, hgW⟩, ⟨((⟨_, hF⟩ : ↥F₀')⁻¹).2, hinv⟩⟩
  have hA_int := intPoly_mem_and_inv_mem_of_rational_law q M' A hle R₀ hR₀ Wset hWlaw

  have hXbar : (Polynomial.X : Polynomial ℤ).map (Int.castRingHom (ResidueField ↥A)) ≠ 0 := by
    rw [Polynomial.map_X]; exact Polynomial.X_ne_zero
  obtain ⟨hJ0, ⟨hfJ, hJW⟩, -⟩ := hA_int Polynomial.X hXbar
  simp only [Polynomial.eval₂_X] at hJ0 hJW
  have hĵV : (⟨JF, hjF₀⟩ : ↥F₀) ∈ V := (hV _).mpr hJW

  have hA_V : ∀ M : Polynomial ℤ, M.map (Int.castRingHom (ResidueField ↥A)) ≠ 0 →
      IsUnit (M.eval₂ (Int.castRingHom ↥V) ⟨(⟨JF, hjF₀⟩ : ↥F₀), hĵV⟩) := by
    intro M hM
    obtain ⟨hne, -, ⟨hfM', hMW'⟩⟩ := hA_int M hM
    have hval : (((M.eval₂ (Int.castRingHom ↥V) ⟨(⟨JF, hjF₀⟩ : ↥F₀), hĵV⟩ : ↥V) : ↥F₀) : ↥(fieldBar q M')) =
        M.eval₂ (Int.castRingHom ↥(fieldBar q M')) JF :=
      map_eval₂_intCast M (F₀.subtype.comp V.subtype) _
    apply (vs_isUnit_iff V _ (M.eval₂ (Int.castRingHom ↥V) _).2).mpr
    constructor
    · rw [hV]
      have heq : eF (((M.eval₂ (Int.castRingHom ↥V) ⟨(⟨JF, hjF₀⟩ : ↥F₀), hĵV⟩ : ↥V) : ↥F₀))⁻¹ = ⟨_, hfM'⟩ := by
        apply Subtype.ext; rw [map_inv₀]
        show ((eF _ : ↥F₀') : ↥(fieldBar q M'))⁻¹ = _
        rw [heF, hval]
      rw [heq]; exact hMW'
    · intro h0; apply hne; rw [← hval, h0]; rfl

  have hGauss := gauss_of_intPoly_units q M' A hA hle A₀ ι hι hres ϖ₀ hϖ₀ F₀ hjF₀ V hconstV hϖV hĵV hA_V

  haveI hjfact : Fact ((⟨_, hjF₀⟩ : ↥F₀) ≠ 0) := ⟨fun h0 => hJ0 (by
    have h1 := congrArg Subtype.val h0
    rw [ZeroMemClass.coe_zero] at h1
    exact h1)⟩
  obtain ⟨𝔮, hLOC, -, -, hSURJ⟩ :=
    ModularCurve.FullLevel.exists_primes_chartAlg_localization_eq_igusaRing_minimal_injective_descent_of_eq_three q hq3 M' hqM' A hA
      W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀
      hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀ {(⟨_, hjF₀⟩ : ↥F₀)} (Or.inl rfl)
  set C : Subalgebra A₀ ↥F₀ := TwoChartIntegralModel.chartAlg A₀ ↥F₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀) with hCdef
  have hjC : (⟨_, hjF₀⟩ : ↥F₀) ∈ C := TwoChartIntegralModel.subset_chartAlg A₀ ↥F₀ _ rfl

  have hDV : ∀ x : ↥F₀, x ∈ Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀) → x ∈ V := by
    let VA : Subalgebra A₀ ↥F₀ := { V.toSubring with algebraMap_mem' := hconstV }
    have h : Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀) ≤ VA :=
      Algebra.adjoin_le (Set.singleton_subset_iff.mpr hĵV)
    exact fun x hx => h hx
  have hCV : ∀ b : ↥C, (b : ↥F₀) ∈ V := by
    intro b
    let incl : ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) →+* ↥V :=
      { toFun := fun x => ⟨x.1, hDV x.1 x.2⟩
        map_one' := Subtype.ext (by simp only [OneMemClass.coe_one])
        map_mul' := fun x y => Subtype.ext (by simp only [MulMemClass.coe_mul])
        map_zero' := Subtype.ext (by simp only [ZeroMemClass.coe_zero])
        map_add' := fun x y => Subtype.ext (by simp only [AddMemClass.coe_add]) }
    have hb : IsIntegral ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) (b : ↥F₀) := b.2
    have hint : IsIntegral ↥V (b : ↥F₀) := hb.map_of_comp_eq incl (RingHom.id ↥F₀) (RingHom.ext fun x => rfl)
    obtain ⟨y, hy⟩ := (IsIntegrallyClosedIn.isIntegral_iff (R := ↥V) (A := ↥F₀)).mp hint
    rw [← hy]; exact y.2

  let inclCV : ↥C →+* ↥V :=
    { toFun := fun b => ⟨b.1, hCV b⟩
      map_one' := Subtype.ext (by simp only [OneMemClass.coe_one])
      map_mul' := fun x y => Subtype.ext (by simp only [MulMemClass.coe_mul])
      map_zero' := Subtype.ext (by simp only [ZeroMemClass.coe_zero])
      map_add' := fun x y => Subtype.ext (by simp only [AddMemClass.coe_add]) }
  have hinclCV : ∀ b : ↥C, inclCV b = ⟨b.1, hCV b⟩ := fun b => rfl
  set 𝔓 : Ideal ↥C := (maximalIdeal ↥V).comap inclCV with h𝔓def
  have h𝔓 : ∀ b : ↥C, b ∈ 𝔓 ↔ ¬ IsUnit (⟨(b : ↥F₀), hCV b⟩ : ↥V) := fun b => by
    rw [h𝔓def, Ideal.mem_comap, hinclCV]; exact IsLocalRing.mem_maximalIdeal _
  have h𝔓prime : 𝔓.IsPrime := Ideal.comap_isPrime inclCV (maximalIdeal ↥V)
  have hI𝔓 : Ideal.map (algebraMap A₀ ↥C) (maximalIdeal A₀) ≤ 𝔓 := by
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    rw [Ideal.mem_comap, h𝔓]
    have : (⟨((algebraMap A₀ ↥C m : ↥C) : ↥F₀), hCV _⟩ : ↥V) = ⟨algebraMap A₀ ↥F₀ m, hconstV m⟩ :=
      Subtype.ext rfl
    rw [this]
    exact (IsLocalRing.mem_maximalIdeal _).mp (hloc m hm)

  have hmin : 𝔓 ∈ (Ideal.map (algebraMap A₀ ↥C) (maximalIdeal A₀)).minimalPrimes := by
    refine ⟨⟨h𝔓prime, hI𝔓⟩, ?_⟩
    rintro 𝔮' ⟨h𝔮'prime, hI𝔮'⟩ h𝔮'le
    by_contra hnot
    obtain ⟨x, hx𝔓, hx𝔮'⟩ := SetLike.not_le_iff_exists.mp hnot
    have hDC : Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀) ≤ C := TwoChartIntegralModel.adjoin_le_chartAlg A₀ ↥F₀ _
    letI algDC : Algebra ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ↥C :=
      (Subalgebra.inclusion hDC).toRingHom.toAlgebra
    have hDCmap : ∀ d : ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)),
        algebraMap _ ↥C d = Subalgebra.inclusion hDC d := fun d => rfl
    have hintC : ∀ y : ↥C, IsIntegral ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) y := by
      intro y
      obtain ⟨p, hpm, hpy⟩ := (y.2 : IsIntegral ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) (y : ↥F₀))
      refine ⟨p, hpm, ?_⟩
      apply Subtype.ext
      have h := Polynomial.hom_eval₂ p (algebraMap _ ↥C) (algebraMap ↥C ↥F₀) y
      have hcomp : (algebraMap ↥C ↥F₀).comp (algebraMap ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ↥C) =
          algebraMap _ ↥F₀ := RingHom.ext fun d => rfl
      rw [hcomp] at h
      change algebraMap ↥C ↥F₀ _ = ((0 : ↥C) : ↥F₀)
      rw [h, ZeroMemClass.coe_zero]
      exact hpy
    have hlt := Ideal.comap_lt_comap_of_integral_mem_sdiff (I := 𝔮') (J := 𝔓) h𝔮'le ⟨hx𝔓, hx𝔮'⟩ (hintC x)
    apply hlt.2
    intro d hd'
    have hd : algebraMap ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ↥C d ∈ 𝔓 := hd'
    show algebraMap ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) ↥C d ∈ 𝔮'
    obtain ⟨P, hP⟩ : ∃ P : Polynomial A₀, Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀) P = (d : ↥F₀) :=
      (AlgHom.mem_range _).mp ((Algebra.adjoin_singleton_eq_range_aeval A₀ (⟨_, hjF₀⟩ : ↥F₀)).le d.2)
    by_cases hPbar : P.map (IsLocalRing.residue A₀) = 0
    ·
      apply hI𝔮'
      have hPmem : P ∈ Ideal.map Polynomial.C (maximalIdeal A₀) := by
        rw [Ideal.mem_map_C_iff]; intro n
        rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.coeff_map, hPbar, Polynomial.coeff_zero]
      have heq : algebraMap _ ↥C d = Polynomial.aeval (⟨(⟨_, hjF₀⟩ : ↥F₀), hjC⟩ : ↥C) P := by
        apply Subtype.ext
        change (d : ↥F₀) = C.val (Polynomial.aeval (⟨(⟨_, hjF₀⟩ : ↥F₀), hjC⟩ : ↥C) P)
        rw [← Polynomial.aeval_algHom_apply]
        exact hP.symm
      rw [heq]
      have h1 : Polynomial.aeval (⟨(⟨_, hjF₀⟩ : ↥F₀), hjC⟩ : ↥C) P ∈
          Ideal.map ((Polynomial.aeval (⟨(⟨_, hjF₀⟩ : ↥F₀), hjC⟩ : ↥C)).toRingHom.comp Polynomial.C) (maximalIdeal A₀) := by
        rw [← Ideal.map_map]; exact Ideal.mem_map_of_mem _ hPmem
      have h2 : (Polynomial.aeval (⟨(⟨_, hjF₀⟩ : ↥F₀), hjC⟩ : ↥C)).toRingHom.comp Polynomial.C = algebraMap A₀ ↥C :=
        RingHom.ext fun a => by simp
      rwa [h2] at h1
    ·
      exfalso
      obtain ⟨hmemV, hu⟩ := hGauss P hPbar
      rw [h𝔓] at hd
      apply hd
      have heqV : (⟨((algebraMap _ ↥C d : ↥C) : ↥F₀), hCV _⟩ : ↥V) = ⟨_, hmemV⟩ := by
        apply Subtype.ext
        change (d : ↥F₀) = _
        exact hP.symm
      rw [heqV]; exact hu

  obtain ⟨ℓ', hℓ'⟩ := hSURJ 𝔓 hmin
  refine ⟨ℓ', ?_⟩

  have key : ∀ x : ↥F₀, x ∈ V ↔ (x : ↥(fieldBar q M')) ∈ OIg ℓ' := by
    let V' : ValuationSubring ↥F₀ := (OIg ℓ').comap F₀.subtype
    have hV' : ∀ x : ↥F₀, x ∈ V' ↔ ∃ b c : ↥C, c ∉ 𝔓 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
      intro x; rw [ValuationSubring.mem_comap, hℓ']; exact hLOC ℓ' x
    have hle' : ∀ x : ↥F₀, x ∈ V' → x ∈ V := by
      intro x hx
      obtain ⟨b, c, hc, hbc⟩ := (hV' x).mp hx
      rw [h𝔓, not_not] at hc
      obtain ⟨hcinv, hc0⟩ := (vs_isUnit_iff V _ (hCV c)).mp hc
      have : x = (b : ↥F₀) * ((c : ↥F₀))⁻¹ := by rw [← hbc, mul_inv_cancel_right₀ hc0]
      rw [this]; exact mul_mem (hCV b) hcinv
    have hdom : ∀ (x : ↥F₀) (hx : x ∈ V'), ¬ IsUnit (⟨x, hx⟩ : ↥V') → ∀ hxV : x ∈ V, ¬ IsUnit (⟨x, hxV⟩ : ↥V) := by
      intro x hx hnu hxV
      obtain ⟨b, c, hc, hbc⟩ := (hV' x).mp hx
      by_cases hb : b ∈ 𝔓
      · intro hux
        rw [h𝔓, not_not] at hc
        rw [h𝔓] at hb
        apply hb
        have : (⟨(b : ↥F₀), hCV b⟩ : ↥V) = ⟨x, hxV⟩ * ⟨(c : ↥F₀), hCV c⟩ :=
          Subtype.ext (by simp only [MulMemClass.coe_mul]; exact hbc.symm)
        rw [this]; exact hux.mul hc
      · exfalso
        apply hnu
        have hx0 : x ≠ 0 := by
          rintro rfl
          apply hb
          have : b = 0 := Subtype.ext (by rw [← hbc, zero_mul]; rfl)
          rw [this]; exact 𝔓.zero_mem
        apply (vs_isUnit_iff V' x hx).mpr
        refine ⟨(hV' _).mpr ⟨c, b, hb, ?_⟩, hx0⟩
        rw [← hbc, ← mul_assoc, inv_mul_cancel₀ hx0, one_mul]
    have hge := valuationSubring_le_of_le_of_nonunits V' V hle' hdom
    intro x
    exact ⟨fun h => ValuationSubring.mem_comap.mp (hge x h), fun h => hle' x (ValuationSubring.mem_comap.mpr h)⟩
  intro f
  have := key (eF.symm f)
  rw [hV, RingEquiv.apply_symm_apply] at this
  exact this

