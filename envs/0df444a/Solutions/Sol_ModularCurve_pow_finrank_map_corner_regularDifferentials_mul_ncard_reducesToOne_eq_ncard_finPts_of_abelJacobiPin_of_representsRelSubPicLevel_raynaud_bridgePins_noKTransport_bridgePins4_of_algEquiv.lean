theorem span_image_eq_map {K V A : Type*} [Field K] [AddCommGroup V] [Module K V]
    (E : V →ₗ[K] V) (hE : E ∘ₗ E = E) (Wl : V ≃ₗ[K] V) (Rss : Submodule K V)
    (Θ Θ₀ : A → V) (hΘW : ∀ x, Θ x = Wl (Θ₀ x)) (X Fin S : Set A) (Log : Set V) (Rel : V → V → Prop)
