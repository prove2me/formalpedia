    have h := inv_keeps_gram hdet ha
    rw [hJ] at h
    rw [hm, ← hx τ, ← h, GlobalTheory.UnitaryFrames.gram_eq_mul, GlobalTheory.UnitaryFrames.gram_eq_mul,
