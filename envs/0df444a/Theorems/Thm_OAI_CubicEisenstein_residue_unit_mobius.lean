theorem OAI.CubicEisenstein.residue_unit_mobius (I : Ideal O) (hI : I ≠ 0) (r : O ⧸ I) :
    (if IsUnit r then (1:ℂ) else 0) =
      ∑ J ∈ idealDivisors I, if Quotient.out r ∈ J then (moebius J:ℂ) else 0 := by sorry
