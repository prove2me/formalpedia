  rw [frameSum_eq_chain]
  have cX := NetProp7.chain_X ind hcard
  have cY := NetProp7.chain_Y ind hcard
  have cS := NetProp7.chain_S ind hcard
  have cC := NetProp7.chain_C ind hcard
  simp only [NetScalar.wX, NetScalar.wY, NetScalar.wS, NetScalar.wC] at cX cY cS cC
  simp only [Fintype.sum_sum_type, cX, cY, Fintype.sum_prod_type, cS, cC, Finset.sum_const,
    Finset.card_univ, Fintype.card_prod, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  ring

/-- **The rank-sum identity (9)**: `s = W m − N + 2L` with `N = v³`, `L = I h · h`,
`I = 3v²` invocations and `h` central wires each losing `h`. -/
theorem frameSum_gatesL_eq :
    frameSum rk (gatesL ind) (MinL ind) (MoutL ind) =
      (Fintype.card (NetScalar.Wr ind) : ℚ) * (h : ℚ) ^ 3 - (Fintype.card T : ℚ) ^ 3 +
        2 * (3 * (Fintype.card T : ℚ) ^ 2 * h * h) := by
  rw [frameSum_gatesL ind hcard, card_Wr ind]
  ring

