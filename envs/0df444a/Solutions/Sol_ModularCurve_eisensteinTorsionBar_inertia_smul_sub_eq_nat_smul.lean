theorem core (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqp : q ≠ p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (m : ℕ) (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ)
    (hn : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσ : σ ∈ A.inertiaSubgroupIn ℚ)
    (x : JZero p) (hx : x ∈ eisensteinTorsionBar p q m)
    (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hτ : τ ∈ A.inertiaSubgroupIn ℚ) :
    τ • (σ • x - x) = n τ • (σ • x - x) := by
  classical
  letI := heckeModuleBar p
  have hp : p.Prime := Fact.out
  have hq : q.Prime := Fact.out

  rcases Nat.eq_zero_or_pos m with hm0 | hm
  · subst hm0
    have hx0 : x = 0 := by
      have h1 : (1 : HeckeAlg) ∈ (↑((eisensteinMaximalIdeal p q) ^ 0) : Set HeckeAlg) := by
        rw [pow_zero, Ideal.one_eq_top]; trivial
      have := (Submodule.mem_torsionBySet_iff _ _).mp hx ⟨1, h1⟩
      simpa using this
    subst hx0
    have hz : ∀ g : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, g • (0 : JZero p) = 0 := fun g =>
      map_zero (DistribSMul.toAddMonoidHom (JZero p) g)
    rw [hz, sub_zero, hz, smul_zero]

  have hqp' : ¬ q ∣ p := fun h => hqp ((Nat.prime_dvd_prime_iff_eq hq hp).mp h)
  obtain ⟨H, instCR, instHopf, hfin, hflat, hcocomm, e, he_add, he_act⟩ :=
    exists_finiteFlat_model_jZero_torsion p q hqp' m
  haveI := hfin
  haveI := hflat
  haveI := hcocomm
  let M : AddSubgroup (JZero p) := (Submodule.torsionBy ℤ (JZero p) ((q : ℤ) ^ m)).toAddSubgroup
  have he_act' : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) f g,
      (∀ h : H, g h = σ (f h)) → ((e g : ↥M) : JZero p) = σ • ((e f : ↥M) : JZero p) := he_act

  obtain ⟨K, hKM, hK, hdisp, -⟩ :=
    GaloisRep.exists_addSubgroup_natCard_quotient_eq_natCard_ringHom_algClosure_of_finiteFlatHopf
      q H M e he_add he_act' A hA

  obtain ⟨Φ, hΦ, ⟨ch⟩⟩ := eisensteinPrimaryTorsion_isMazurAdmissible_heckeModuleBar p (heckeOperatorsCommuteBar p) q hq m

  let ι : ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg)) →+ JZero p :=
    (Submodule.torsionBySet HeckeAlg (JZero p) (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg)).toAddSubgroup.subtype
  have hι : Function.Injective ι := Subtype.val_injective
  have hιapp : ∀ z, ι z = (z : JZero p) := fun z => rfl
  let M' : AddSubgroup (JZero p) := eisensteinTorsionBar p q m
  have hM'T : M' = (Submodule.torsionBySet HeckeAlg (JZero p)
      (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg)).toAddSubgroup := rfl
  let step : Fin (ch.n + 1) → AddSubgroup (JZero p) := fun i => (ch.step i).map ι
  have hstep0 : step 0 = ⊥ := by
    show (ch.step 0).map ι = ⊥
    rw [ch.hbot, AddSubgroup.map_bot]
  have hstepr : step (Fin.last ch.n) = M' := by
    show (ch.step (Fin.last ch.n)).map ι = M'
    rw [ch.htop, hM'T, ← AddMonoidHom.range_eq_map, AddSubgroup.range_subtype]
  have hmono : ∀ i : Fin ch.n, step i.castSucc ≤ step i.succ := fun i => AddSubgroup.map_mono (ch.hmono i)

  haveI : NeZero q := ⟨hq.ne_zero⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) q
  have hζ₀n : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, σ ζ₀ = ζ₀ ^ n σ := by
    intro σ
    apply hn
    obtain ⟨k, hk⟩ : ∃ k, m = k + 1 := Nat.exists_eq_succ_of_ne_zero hm.ne'
    rw [hk, pow_succ, pow_mul', hζ₀.pow_eq_one, one_pow]

  have hact' : ∀ i : Fin ch.n,
      (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ y ∈ step i.succ, σ • y - y ∈ step i.castSucc) ∨
      (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ y ∈ step i.succ, σ • y - n σ • y ∈ step i.castSucc) := by
    intro i
    have hi := ch.hact i
    by_cases htag : ch.tag i = true
    · rw [if_pos htag] at hi
      left
      intro σ y hy
      obtain ⟨z, hz, rfl⟩ := AddSubgroup.mem_map.mp hy
      refine AddSubgroup.mem_map.mpr ⟨Φ.φ σ z - z, hi σ z hz, ?_⟩
      rw [map_sub, hιapp, hιapp]
      exact congrArg (fun w => w - (z : JZero p)) (hΦ σ z)
    · rw [if_neg htag] at hi
      right
      intro σ y hy
      obtain ⟨z, hz, rfl⟩ := AddSubgroup.mem_map.mp hy
      refine AddSubgroup.mem_map.mpr ⟨Φ.φ σ z - n σ • z, hi σ ζ₀ hζ₀ (n σ) (hζ₀n σ) z hz, ?_⟩
      rw [map_sub, map_nsmul, hιapp, hιapp]
      exact congrArg (fun w => w - n σ • (z : JZero p)) (hΦ σ z)
  have hstab : ∀ i : Fin (ch.n + 1), ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
      ∀ y ∈ step i, σ • y ∈ step i := by
    intro i
    induction i using Fin.induction with
    | zero =>
      intro σ y hy
      rw [hstep0] at hy ⊢
      rw [(AddSubgroup.mem_bot).mp hy]
      have hz : σ • (0 : JZero p) = 0 := map_zero (DistribSMul.toAddMonoidHom (JZero p) σ)
      rw [hz]; exact AddSubgroup.zero_mem _
    | succ j _ =>
      intro σ y hy
      rcases hact' j with h | h
      · have h1 := h σ y hy
        have : σ • y = (σ • y - y) + y := by abel
        rw [this]
        exact AddSubgroup.add_mem _ (hmono j h1) hy
      · have h1 := h σ y hy
        have : σ • y = (σ • y - n σ • y) + n σ • y := by abel
        rw [this]
        exact AddSubgroup.add_mem _ (hmono j h1) (AddSubgroup.nsmul_mem _ hy _)
  have hcard : ∀ i : Fin ch.n,
      Nat.card (↥(step i.succ) ⧸ (step i.castSucc).addSubgroupOf (step i.succ)) = q := by
    intro i
    refine Eq.trans ?_ (ch.hcard i)

    let φ : ↥(ch.step i.succ) ≃+ ↥(step i.succ) := (ch.step i.succ).equivMapOfInjective ι hι
    symm
    refine Nat.card_congr (QuotientAddGroup.congr ((ch.step i.castSucc).addSubgroupOf (ch.step i.succ))
      ((step i.castSucc).addSubgroupOf (step i.succ)) φ ?_).toEquiv
    ext ⟨y, hy⟩
    simp only [AddSubgroup.mem_map, AddSubgroup.mem_addSubgroupOf]
    constructor
    · rintro ⟨⟨z, hz⟩, hz', hzy⟩
      have h1 : ((φ ⟨z, hz⟩ : ↥(step i.succ)) : JZero p) = y := congrArg Subtype.val hzy
      have hyz : y = ι z := h1.symm
      show y ∈ (ch.step i.castSucc).map ι
      rw [hyz]; exact AddSubgroup.mem_map_of_mem _ hz'
    · intro hy'
      change y ∈ (ch.step i.castSucc).map ι at hy'
      obtain ⟨z, hz', hzy⟩ := AddSubgroup.mem_map.mp hy'
