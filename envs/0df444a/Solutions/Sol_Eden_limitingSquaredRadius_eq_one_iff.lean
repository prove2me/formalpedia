set_option autoImplicit true
noncomputable section
open Eden
namespace Eden
theorem _root_.solution (s : ℝ) : limitingSquaredRadius s = 1 ↔ s = 1 := by
  by_cases h : s < 1
  · simp [limitingSquaredRadius, h, ne_of_lt h]
  · by_cases he : s = 1 <;> simp [limitingSquaredRadius, h, he]
end Eden
