theorem exists_pow_eq_of_isUnit_of_henselian {R : Type*} [CommRing R] [IsLocalRing R] [HenselianLocalRing R]
    [IsAlgClosed (ResidueField R)] (n : ℕ) (hn : IsUnit (n : R)) (u : R) (hu : IsUnit u) :
    ∃ v : R, v ^ n = u := by
  classical
  have hn0 : n ≠ 0 := by
    rintro rfl
    simp at hn

  obtain ⟨b, hb⟩ : ∃ b : ResidueField R, b ^ n = residue R u := by
    have := IsAlgClosed.exists_pow_nat_eq (residue R u) (Nat.pos_of_ne_zero hn0)
    exact this
  obtain ⟨a₀, rfl⟩ := residue_surjective b

  let f : Polynomial R := Polynomial.X ^ n - Polynomial.C u
  have hf : f.Monic := Polynomial.monic_X_pow_sub_C u hn0
  have h1 : Polynomial.eval a₀ f ∈ maximalIdeal R := by
    rw [← residue_eq_zero_iff]
    simp [f, hb, map_sub, map_pow]
  have ha₀ : IsUnit a₀ := by

    by_contra h
    have hm : a₀ ∈ maximalIdeal R := (mem_maximalIdeal _).mpr h
    have h0 : residue R a₀ = 0 := (residue_eq_zero_iff _).mpr hm
    have : residue R u = 0 := by rw [← hb, h0, zero_pow hn0]
    exact (hu.map (residue R)).ne_zero this
  have h2 : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) := by
    simp only [f, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C, sub_zero,
      Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C, map_natCast, Polynomial.eval_natCast]
    exact (hn.mul (ha₀.pow _))
  obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian f hf a₀ h1 h2
  refine ⟨a, ?_⟩
  have : Polynomial.eval a f = a ^ n - u := by simp [f]
  rw [Polynomial.IsRoot, this] at ha
  exact sub_eq_zero.mp ha

theorem exists_honest_root {R : Type*} [CommRing R] [IsLocalRing R] [HenselianLocalRing R]
    [IsAlgClosed (ResidueField R)] (q : ℕ) (hq0 : q ≠ 0) (hq : (q : R) ∈ nonunits R)
    (ϖ u : R) (hu : IsUnit u) (h : ϖ ^ (q ^ 2 - 1) = (q : R) * u) :
    ∃ π : R, π ^ (q ^ 2 - 1) = (q : R) := by
  have hn : IsUnit (((q ^ 2 - 1 : ℕ)) : R) := by
    have hq2 : (q : R) ^ 2 ∈ nonunits R := by
      rw [pow_two]; exact mul_mem_nonunits_right hq
    have h1 : IsUnit (1 - (q : R) ^ 2) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hq2
    have hq1 : 1 ≤ q ^ 2 := Nat.one_le_pow _ _ (Nat.pos_of_ne_zero hq0)
    have : (((q ^ 2 - 1 : ℕ)) : R) = -(1 - (q : R) ^ 2) := by push_cast [hq1]; ring
    rw [this]; exact h1.neg
  obtain ⟨v, hv⟩ := exists_pow_eq_of_isUnit_of_henselian (q ^ 2 - 1) hn u hu
  have hvU : IsUnit v := by
    have hn0 : q ^ 2 - 1 ≠ 0 := by
      intro h0
      have : IsUnit (((q ^ 2 - 1 : ℕ)) : R) := hn
      rw [h0] at this; simp at this
    exact (isUnit_pow_iff hn0).mp (hv ▸ hu)
  obtain ⟨w, hw⟩ := hvU.exists_right_inv
  refine ⟨ϖ * w, ?_⟩
  rw [mul_pow, h, mul_assoc, ← hv, ← mul_pow, hw, one_pow, mul_one]

theorem exists_ringEquiv_coeffwise (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (X : IntermediateField ℚ (LaurentSeries ℚ))
    (K : IntermediateField ↥k₀ (LaurentSeries ↥k₀)) (hK : K = ModularCurve.laurentBaseChange ↥k₀ X) (σL : ↥k₀ ≃+* ↥k₀) :
    ∃ τ : ↥K ≃+* ↥K, ∀ x : ↥K, ((τ x : ↥K) : LaurentSeries ↥k₀) = ModularCurve.coeffMap σL.toRingHom ((x : ↥K) : LaurentSeries ↥k₀) := by
  subst hK
  have hσ : ∀ r : ℚ, σL (algebraMap ℚ ↥k₀ r) = algebraMap ℚ ↥k₀ r := by
    intro r
    rw [eq_ratCast (algebraMap ℚ ↥k₀) r]
    exact map_ratCast σL.toRingHom r
  let σ : ↥k₀ ≃ₐ[ℚ] ↥k₀ := AlgEquiv.ofRingEquiv (f := σL) hσ
  exact ⟨ModularCurve.arithmeticRingAut X σ, fun x => rfl⟩

theorem coe_phi_coeffwise_eq_coeffMap
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (ℓ' : ℕ) [NeZero ℓ']
    (Kℓ : IntermediateField ↥k₀ (LaurentSeries ↥k₀)) (K₀ : IntermediateField ↥k₀ ↥Kℓ)
    (Fbar : IntermediateField (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)))
    [Algebra ↥k₀ ↥Fbar] (F₀ : IntermediateField ↥k₀ ↥Fbar) (φ : ↥K₀ ≃ₐ[↥k₀] ↥F₀)
    (hφ1 : ∀ x : ↥K₀, coeffMap (algebraMap ↥k₀ (AlgebraicClosure ℚ)) (((x : ↥Kℓ)) : LaurentSeries ↥k₀) =
      qExpand (AlgebraicClosure ℚ) ℓ' (((φ x : ↥F₀) : ↥Fbar) : LaurentSeries (AlgebraicClosure ℚ)))
    (σL : ↥k₀ ≃+* ↥k₀) (τ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ)
    (hτσ : ∀ c : ↥k₀, τ (c : AlgebraicClosure ℚ) = ((σL c : ↥k₀) : AlgebraicClosure ℚ))
    (τK : ↥Kℓ ≃+* ↥Kℓ) (hτK : ∀ x : ↥Kℓ, ((τK x : ↥Kℓ) : LaurentSeries ↥k₀) = coeffMap σL.toRingHom ((x : ↥Kℓ) : LaurentSeries ↥k₀))
    (x : ↥K₀) (hx : τK (x : ↥Kℓ) ∈ K₀) :
    (((φ ⟨τK (x : ↥Kℓ), hx⟩ : ↥F₀) : ↥Fbar) : LaurentSeries (AlgebraicClosure ℚ)) =
      coeffMap τ (((φ x : ↥F₀) : ↥Fbar) : LaurentSeries (AlgebraicClosure ℚ)) := by
  apply (qExpand_injective ℓ' : Function.Injective (qExpand (AlgebraicClosure ℚ) ℓ'))
  rw [← hφ1 ⟨_, hx⟩, ← coeffMap_qExpand, ← hφ1 x, coeffMap_coeffMap]
  show coeffMap (algebraMap ↥k₀ (AlgebraicClosure ℚ)) ((τK (x : ↥Kℓ) : ↥Kℓ) : LaurentSeries ↥k₀) = _
  rw [hτK, coeffMap_coeffMap]
  exact coeffMap_congr (RingHom.ext fun c => (hτσ c).symm) _

theorem inertia_unpack (A : ValuationSubring (AlgebraicClosure ℚ))
    (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hτ : τ ∈ A.inertiaSubgroupIn ℚ) :
    (∀ x : AlgebraicClosure ℚ, x ∈ A ↔ τ x ∈ A) ∧
    (∀ a : ↥A, ∃ h : τ (a : AlgebraicClosure ℚ) ∈ A, IsLocalRing.residue ↥A ⟨τ a, h⟩ = IsLocalRing.residue ↥A a) := by
  obtain ⟨σ, hσ, rfl⟩ := Subgroup.mem_map.mp hτ
  have hstab : (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) • A = A := σ.2
  have hmem : ∀ x : AlgebraicClosure ℚ, x ∈ A ↔ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) x ∈ A := by
    intro x
    have h1 := ValuationSubring.smul_mem_pointwise_smul_iff (g := (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)) (S := A) (x := x)
    rw [hstab] at h1
    exact h1.symm
  refine ⟨hmem, ?_⟩
  intro a
  refine ⟨(hmem a).mp a.2, ?_⟩
  have hker : MulSemiringAction.toRingAut (↥(A.decompositionSubgroup ℚ)) (IsLocalRing.ResidueField ↥A) σ = 1 := hσ
  have h1 := RingEquiv.congr_fun hker (IsLocalRing.residue ↥A a)
  rw [MulSemiringAction.toRingAut_apply] at h1
