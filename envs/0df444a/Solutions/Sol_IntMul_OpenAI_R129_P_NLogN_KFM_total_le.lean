theorem wU_le : IntMul.OpenAI.R129.P.NLogN.KFM.wU n D ≤ 2 * pP n := by
  have h := gam_le hn
  rw [hD] at h
  have hb := (setup_facts hn).1
  unfold IntMul.OpenAI.R129.P.NLogN.KFM.wU pP; nlinarith

theorem sBD_lt_tBD (i : Fin (D + 1)) : sBD n D i < tBD n D i := by
  obtain ⟨w1, w2, -⟩ := IntMul.OpenAI.R129.P.NLogN.KFQ.win hn hD i
  have hd := (setup_facts hn).2.1
  have ht : 0 < tBD n D i := by obtain ⟨e, -, he⟩ := IntMul.OpenAI.R129.P.NLogN.KFQ.tBD_pow hn hD i; rw [he]; positivity
  by_contra h
  push Not at h
  have : 4 * IntMul.OpenAI.R129.dP n * tBD n D i ≤ 4 * IntMul.OpenAI.R129.dP n * sBD n D i := Nat.mul_le_mul_left _ h
  have e : (4 * IntMul.OpenAI.R129.dP n - 1) * tBD n D i + tBD n D i = 4 * IntMul.OpenAI.R129.dP n * tBD n D i := by
    rw [← Nat.succ_mul]; congr 1; omega
  omega

theorem sCmp_le_T : sCmp n ≤ IntMul.OpenAI.Glue.TP n := by
  rw [sCmp_eq hn hD (sBD_lt_tBD hn hD), ← IntMul.OpenAI.R129.P.NLogN.KFQ.prod_tBD hn hD]
  exact Finset.prod_le_prod (fun i _ => Nat.zero_le _) (fun i _ => (sBD_lt_tBD hn hD i).le)

