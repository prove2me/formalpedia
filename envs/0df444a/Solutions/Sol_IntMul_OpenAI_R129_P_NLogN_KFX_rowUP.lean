  have h' : zsz ((vol (binShape Pre G Suf (2 ^ u)) : ℕ) : ℤ) ≤ u := by omega
  rw [zsz_le_iff] at h'
  have := two_pow_le_vol (u := u) Pre G Suf hPre hG hS
  simp only [Int.natAbs_natCast] at h'
