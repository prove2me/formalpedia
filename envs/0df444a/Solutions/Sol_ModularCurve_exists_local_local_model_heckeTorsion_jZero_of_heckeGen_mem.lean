theorem isLocalRing_of_injective_of_finite {A B : Type*} [CommRing A] [CommRing B] (f : A →+* B)
    (hf : Function.Injective f) (hfin : f.Finite) (hB : IsLocalRing B) : IsLocalRing A := by
  letI := f.toAlgebra
  haveI : Module.Finite A B := hfin
  haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  haveI : Nontrivial A := f.domain_nontrivial
  refine IsLocalRing.of_unique_max_ideal ?_
  obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal A
  refine ⟨M₀, hM₀, fun M hM => ?_⟩
  have key : ∀ M : Ideal A, M.IsMaximal → M = Ideal.comap (algebraMap A B) (IsLocalRing.maximalIdeal B) := by
    intro M hM
    have hker : RingHom.ker (algebraMap A B) ≤ M := by
      rw [(RingHom.injective_iff_ker_eq_bot (algebraMap A B)).mp hf]; exact bot_le
    obtain ⟨Q, hQmax, hQ⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral M hker
    rw [← hQ, IsLocalRing.eq_maximalIdeal hQmax]
  rw [key M hM, key M₀ hM₀]

end UNILLBody

