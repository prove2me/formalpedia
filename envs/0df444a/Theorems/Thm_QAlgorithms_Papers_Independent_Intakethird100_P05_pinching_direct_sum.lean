attribute [local instance] Classical.propDecidable Classical.decEq

variable {X I : Type} [Fintype X] [DecidableEq X] [Fintype I] [DecidableEq I]

/-- PDF p.8, Lemma 3, (44): direct-sum compatibility of the projection (41).
The literal arbitrary A,B,C,D domain uses the commutant of the generated
*-algebra, so non-Hermitian references do not collapse to zero. -/
theorem pinching_direct_sum (A B C D : Mat I) :
    algebraPinch (directSum C D) (directSum A B) =
      directSum (algebraPinch C A) (algebraPinch D B) := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P05

