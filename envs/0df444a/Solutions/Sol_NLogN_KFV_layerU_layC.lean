/-- **The top round, uniform.** -/
theorem layerU_top (hK : 0 < K) (hℓ : 1 ≤ ℓ) {p W B : ℕ} (hW : p + 1 ≤ W)
    (hB : bL D ℓ K long ≤ B) :
    LayerU (r := 2 ^ ℓ) I iprog (RCtx (pLP D ℓ K long) (flOf D long) (ℓ - 1)) NLogN.KFV.topC
      (layerQc p (paperSel D ℓ K long hK hℓ (ℓ - 1))) (2 ^ NLogN.KFV.nB D ℓ K long) p W
      (cTopC D ℓ K long ((Ex.lit 0 : Ex HS).size + (Ex.reg gNL : Ex HS).size +
        (Ex.add (.reg gNn) (.neg (.reg gNL)) : Ex HS).size) W B) := by
  intro s hs zs l xs hx hl hb hd
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hLst := length_lstL_le_tgt D ℓ K long
  rw [length_lstL] at hLst
  unfold bL at hB
  have hbD : bb ℓ K ≤ bb ℓ K * D := Nat.le_mul_of_pos_right _ hD1
  have hbl : bb ℓ K ≤ ℓ := by unfold bb; exact le_trans (Nat.mod_le _ _) (by omega)
  obtain ⟨vD, vL, vB, vN, vn, vH⟩ := hs.ev (gflat zs ++ l) (B := B) (by omega) (by simp [pLP]; omega)
    (by simp [pLP]; omega) (by simp [pLP]; omega) (by simp [pLP]; omega) (by simp [pLP]; omega)
    (by omega)
  simp only [pLP] at vD vL vB vN vn vH
  have z : ∀ x : ℤ, -1 ≤ x → x ≤ B → zsz x ≤ B := fun x => NLogN.KFV.zsz_small (by omega)
  have Et := vN.add (EV.lit (c := -1) (z _ le_rfl (by omega))) (z _ (by omega) (by omega))
  have hcI : cIte (Ex.add (.reg gNL) (.lit (-1))) (encK s (o0 (gflat zs ++ l))) ≤ cIteB 3 B :=
    cIte_le Et
  unfold cTopC
  by_cases hm : nLong D long = 0
  · obtain ⟨R1, R2, R3⟩ := truncTop_runs (I := I) (iprog := iprog) s zs l vn vL (by omega) hx hl hb
    have hT := qp_layer_top D ℓ K long hK hℓ hm p xs hl
    refine ⟨_, hT ▸ R1, R2, ?_, ?_, ?_⟩
    · rw [← hT]; simp [QpArr, hl]
    · rw [← hT]
      intro j hj
      simp only [QpArr, List.getElem_map]
      refine (pi_norm_le_iff_of_nonneg zero_le_one).2 fun c => (norm_Qp_le p _).trans ?_
      have := hd j (by simpa [QpArr] using hj)
      exact (norm_le_pi_norm _ c).trans this
    · have R := iteI_runsT (b := fcode topLeaf) (clean_gIn (RG.add (RG.reg (by decide)) (RG.lit _)))
        Et.1 (by rw [Et.2.1, hm]; norm_num) R3
      refine R.mono' rfl ?_
      omega
  · have hcard := card_part_top D ℓ long hℓ
    have hnD : nLong D long ≤ D := by
      unfold nLong; exact (List.length_filter_le _ _).trans (by simp)
    have vD' : EV (encK s (o0 (gflat zs ++ l))) B (.reg gNL)
        ((partAxes (al D ℓ long) (ℓ - 1)).card : ℤ) := by rw [hcard]; exact vN
    have vS := (vn.add vN.neg (z _ (by omega) (by omega))).cast
      (v' := (((tgtL D ℓ K long).length - (partAxes (al D ℓ long) (ℓ - 1)).card : ℕ) : ℤ))
      (by rw [hcard]; push_cast [show nLong D long ≤ (tgtL D ℓ K long).length by omega]; ring)
    have hl' : xs.length = vol (layerShape (2 ^ 0) 1 (partAxes (al D ℓ long) (ℓ - 1)).card
        (2 ^ ((tgtL D ℓ K long).length - (partAxes (al D ℓ long) (ℓ - 1)).card))) := by
      rw [pow_zero, vol_top D ℓ K long hK hℓ]; exact hl
    have hnL : nLong D long ≤ (tgtL D ℓ K long).length := by omega
    have hB2 : 0 + 2 * (partAxes (al D ℓ long) (ℓ - 1)).card +
        ((tgtL D ℓ K long).length - (partAxes (al D ℓ long) (ℓ - 1)).card) + ℓ + 3 ≤ B := by
      rw [hcard]; omega
    obtain ⟨zs', h1, h2, h3⟩ := leafR_runs (I := I) (iprog := iprog) s zs l (RG.lit _)
      (RG.reg (by decide)) (RG.add (RG.reg (by decide)) (RG.neg (RG.reg (by decide))))
      (EV.lit (c := 0) (z _ (by omega) (by omega))) vD' vS vL (by omega)
      hB2 hx hl' hb hd
    have e1 := top_layerQc D ℓ K long p hK hℓ xs
    refine ⟨zs', by rw [e1]; exact h1, h2.mono hW, ?_, ?_, ?_⟩
    · rw [e1, length_prop14Proc, vol_top D ℓ K long hK hℓ]
    · rw [e1]; exact disk_prop14 _ p hd
    · rw [hcard] at h3
      have R := iteI_runsF (a := fcode truncTop) (clean_gIn (RG.add (RG.reg (by decide)) (RG.lit _)))
        Et.1 (by rw [Et.2.1]; omega) h3
      refine R.mono' rfl ((Nat.add_le_add hcI le_rfl).trans ?_)
      exact Nat.add_le_add_right (Nat.le_add_right _ _) _

