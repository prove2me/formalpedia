lemma length_flatten_uniform {K : ℕ} : ∀ (A : List (List ℕ)), (∀ c ∈ A, c.length = K) →
    A.flatten.length = A.length * K
  | [], _ => by simp
  | c :: A, h => by
    simp only [List.flatten_cons, List.length_append, List.length_cons]
    rw [h c (by simp), length_flatten_uniform A (fun c' hc' => h c' (by simp [hc']))]; ring

end Synth

end

