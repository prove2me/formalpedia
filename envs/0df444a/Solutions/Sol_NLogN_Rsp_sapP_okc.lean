section
-- Source module: NLogN.HRspSap
set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

theorem zip_fst_snd (L : List (ℤ × ℤ)) : (L.map Prod.fst).zip (L.map Prod.snd) = L := by
  induction L with
  | nil => rfl
  | cons z L ih => simp [ih]

theorem gresL_sap (p s t α : ℕ) (U : List (ℤ × ℤ)) (hs : 0 < s) (ht : 0 < t) (hU : U.length = s) :
    gresL (2 ^ (2 * p)) (sDel s t) (sTab p s t α) U (sOff s (HvdH.sWidth p α)) t =
      HvdH.Ref.sapL p s t α U := by
  rw [gresL, resL_sap_fst p s t α U hs ht hU, resL_sap_snd p s t α U hs ht hU, zip_fst_snd]

theorem sOff_lt (s m : ℕ) (hs : 0 < s) : sOff s m < s := Nat.mod_lt _ hs

theorem pre_sDel_le (s t : ℕ) (ht : 0 < t) : NLogN.Rsp.pre (sDel s t) t ≤ s := by
  obtain ⟨k, rfl⟩ : ∃ k, t = k + 1 := ⟨t - 1, by omega⟩
  rw [pre_sDel s (k + 1) ht k (by omega)]; exact cS_le _ _ _ (by omega)

end NLogN.Rsp

end

