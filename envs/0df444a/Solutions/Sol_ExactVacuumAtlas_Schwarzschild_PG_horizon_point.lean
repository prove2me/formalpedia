/-! # Elementary facts about the Schwarzschild coordinate domains -/

open Real

namespace ExactVacuumAtlas.Schwarzschild

theorem equatorPt_mem_domEF {ρ : ℝ} (hρ : 0 < ρ) : equatorPt ρ ∈ domEF := by
  refine ⟨by simpa [equatorPt] using hρ, ?_, ?_⟩ <;> simp [equatorPt, pi_pos]

/-- For `M > 0` the EF domain contains points with `r = 2M`. -/
theorem horizon_mem_domEF {M : ℝ} (hM : 0 < M) : equatorPt (2 * M) ∈ domEF ∧
    equatorPt (2 * M) 1 = 2 * M :=
  ⟨equatorPt_mem_domEF (by linarith), by simp [equatorPt]⟩

end ExactVacuumAtlas.Schwarzschild

