theorem clG_sp_sol_aux (s : IState HS) (w : Fin HS → ℤ) (cc : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hw : VB w A) {P sN tN aN k : ℕ} (h20 : w 20 = P) (h22 : w 22 = sN) (h23 : w 23 = tN)
    (h25 : w 25 = aN) (h12 : w 12 = k) (h9 : w 9 = 2 ^ P) (h10 : w 10 = 2 ^ (P + 1))
    {eF : Ex HS} (hiF : InRg eF) (hpF : Poly eF = true) (hdF : dg eF ≤ 40)
    (hoF : ∀ (u : Fin HS → ℤ) (cu : Fin HS → List ℤ), eF.ok (encK s (RF u cu)))
    {Fk : ℤ} (hF : ∀ (u : Fin HS → ℤ) (cu : Fin HS → List ℤ), u 4 = w 4 → u 9 = 2 ^ P →
      eF.eval (encK s (RF u cu)) = Fk)
    (hq : |expNeg P sN (2 * aN ^ 2 * tN * (k + 1))| ≤ 2 ^ A) (hFk : |Fk| ≤ 2 ^ A)
    (hG : |J6Seg.fmul P (w 4) (2 ^ P - max (expNeg P sN (2 * aN ^ 2 * tN * (k + 1))) 0)| ≤ 2 ^ A) :
    Sp (clG eF) (encK s (RF w cc))
      (encK s (RF (Function.update (Function.update (Function.update w 5
        (expNeg P sN (2 * aN ^ 2 * tN * (k + 1)))) 11 Fk) 4
        (J6Seg.fmul P (w 4) (2 ^ P - max (expNeg P sN (2 * aN ^ 2 * tN * (k + 1))) 0))) cc))
      (cCall (.reg 20) (.reg 22) jQE (.lit 0) (BW A) (expNegCost P (BW A) (BW A)) +
