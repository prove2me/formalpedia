/-- `NetIL` gives the ideal hypotheses `C.OK (q^f)` at every power of every large prime
(`idealOK_of_formal`). -/
theorem NetIL.okAt {W T m : ℕ} {C : Bit.QHNet (ZMod 2) W T m} (hC : NetIL C) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f, C.OK (q ^ f) := by
  obtain ⟨q₀, h⟩ := hC.ok
  refine ⟨q₀, fun q hq hlt f => ?_⟩
  have : NeZero (q ^ f) := ⟨pow_ne_zero _ hq.ne_zero⟩
  exact ⟨hC.runs, C.idealOK_of_formal (h q hq hlt f).1 (h q hq hlt f).2⟩

end

