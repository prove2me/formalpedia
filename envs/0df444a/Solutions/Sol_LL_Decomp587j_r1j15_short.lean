def getV (k : Nat) : Nat :=
  match Nat.ble 1024 k with
  | true => V_last
  | false => V_tree.getAux 512 k

def getU (k : Nat) : Nat :=
  U_tree.getAux 512 k

def allPow2 : Nat → Nat → (Nat → Bool) → Bool
  | 0, base, p => p base
  | d + 1, base, p => allPow2 d base p && allPow2 d (base + 2 ^ d) p

theorem allPow2_spec {d base : Nat} {p : Nat → Bool} (h : allPow2 d base p = true)
    {k : Nat} (hlo : base ≤ k) (hhi : k < base + 2 ^ d) : p k = true := by
  induction d generalizing base with
  | zero =>
    have hk : k = base := by omega
    subst hk
    exact h
  | succ d ih =>
    simp only [allPow2, Bool.and_eq_true] at h
    have hpow : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
    by_cases hlt : k < base + 2 ^ d
    · exact ih h.1 hlo hlt
    · exact ih h.2 (by omega) (by omega)

def checkBuchstabStepWith (gV gU : Nat → Nat) (k : Nat) : Bool :=
  if k < 256 then
    decide (S_scale ≤ gV k) &&
    decide (S_scale * K_grid ≤ gU k * (K_grid + k))
  else if k < 512 then
    decide (gV k ≤ gV (k + 1)) &&
    decide (S_scale * (2 * k + 1) ≤ 2 * k * (k + 1) * (gV (k + 1) - gV k)) &&
    decide (K_grid * gV k ≤ gU k * (K_grid + k)) &&
    decide (K_grid * (k * gV k + S_scale) ≤ k * (K_grid + k + 1) * gU k)
  else
    decide (gV k ≤ gV (k + 1)) &&
    decide (gU (k - 256) ≤ K_grid * (gV (k + 1) - gV k)) &&
    decide (K_grid * gV k ≤ gU k * (K_grid + k)) &&
    decide (K_grid * gV (k + 1) ≤ gU k * (K_grid + k + 1)) &&
    (if 768 ≤ k then decide (gU k ≤ M4_val) else decide (gU k ≤ M3_val))

theorem ble_false_iff {a b : Nat} : Nat.ble a b = false ↔ b < a := by
  rw [Bool.eq_false_iff, ne_eq, Nat.ble_eq]; omega

def max2 (a b : Nat) : Nat := match Nat.ble a b with | true => b | false => a
def min2 (a b : Nat) : Nat := match Nat.ble a b with | true => a | false => b

theorem le_max2_left (a b : Nat) : a ≤ max2 a b := by
  unfold max2; cases h : Nat.ble a b <;> dsimp only
  · exact le_refl a
  · rw [Nat.ble_eq] at h; exact h

theorem le_max2_right (a b : Nat) : b ≤ max2 a b := by
  unfold max2; cases h : Nat.ble a b <;> dsimp only
  · rw [ble_false_iff] at h; omega
  · exact le_refl b

theorem mono_dec_le {f : Nat → Nat} {a b : Nat}
    (h : ∀ k, a ≤ k → k < b → f (k + 1) ≤ f k)
    {i j : Nat} (ha : a ≤ i) (hij : i ≤ j) (hb : j ≤ b) : f j ≤ f i := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hij
  induction d with
  | zero => simp
  | succ d ih =>
    have h1 := ih (by omega) (by omega)
    have h2 := h (i + d) (by omega) (by omega)
    exact le_trans h2 h1

theorem mono_inc_le {f : Nat → Nat} {a b : Nat}
    (h : ∀ k, a ≤ k → k < b → f k ≤ f (k + 1))
    {i j : Nat} (ha : a ≤ i) (hij : i ≤ j) (hb : j ≤ b) : f i ≤ f j := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hij
  induction d with
  | zero => simp
  | succ d ih =>
    have h1 := ih (by omega) (by omega)
    have h2 := h (i + d) (by omega) (by omega)
    exact le_trans h1 h2

def buchstabUB_fallback (k0 k1 : Nat) : Nat :=
  let a := match Nat.ble k0 255 with | true => getU k0 | false => 0
  let b := match Nat.ble k0 450, Nat.ble 256 k1 with | true, true => getU (min2 k1 450) | _, _ => 0
  let c := match Nat.ble k0 631, Nat.ble 450 k1 with | true, true => getU (max2 k0 450) | _, _ => 0
  let d := match Nat.ble k0 767, Nat.ble 631 k1 with | true, true => getU (min2 k1 767) | _, _ => 0
  let e := match Nat.ble 768 k1 with | true => M4_val | false => 0
  max2 a (max2 b (max2 c (max2 d e)))

def buchstabUB (k0 k1 : Nat) : Nat :=
  match Nat.ble 768 k0 with
  | true => M4_val
  | false =>
    match Nat.ble k1 255 with
    | true => getU k0
    | false =>
      match Nat.ble 256 k0, Nat.ble k1 450 with
      | true, true => getU k1
      | _, _ =>
        match Nat.ble 450 k0, Nat.ble k1 631 with
        | true, true => getU k0
        | _, _ =>
          match Nat.ble 631 k0, Nat.ble k1 767 with
          | true, true => getU k1
          | _, _ => buchstabUB_fallback k0 k1

theorem getU_le_buchstabUB_fallback
    (hm0 : ∀ i j, i ≤ j → j ≤ 255 → getU j ≤ getU i)
    (hm1 : ∀ i j, 256 ≤ i → i ≤ j → j ≤ 450 → getU i ≤ getU j)
    (hm2 : ∀ i j, 450 ≤ i → i ≤ j → j ≤ 631 → getU j ≤ getU i)
    (hm3 : ∀ i j, 631 ≤ i → i ≤ j → j ≤ 767 → getU i ≤ getU j)
    {k0 k1 k : Nat} (h0 : k0 ≤ k) (h1 : k ≤ k1) (hk : k < 768) :
    getU k ≤ buchstabUB_fallback k0 k1 := by
  unfold buchstabUB_fallback; dsimp only
  by_cases c1 : k ≤ 255
  · have hb : Nat.ble k0 255 = true := by rw [Nat.ble_eq]; omega
    rw [hb]; dsimp only
    exact le_trans (hm0 k0 k h0 c1) (le_max2_left _ _)
  · by_cases c2 : k ≤ 450
    · have hb1 : Nat.ble k0 450 = true := by rw [Nat.ble_eq]; omega
      have hb2 : Nat.ble 256 k1 = true := by rw [Nat.ble_eq]; omega
      rw [hb1, hb2]; dsimp only
      have hmin : k ≤ min2 k1 450 ∧ min2 k1 450 ≤ 450 := by
        unfold min2; cases h : Nat.ble k1 450 <;> dsimp only
        · rw [ble_false_iff] at h; omega
        · rw [Nat.ble_eq] at h; omega
      exact le_trans (hm1 k (min2 k1 450) (by omega) hmin.1 hmin.2)
        (le_trans (le_max2_left _ _) (le_max2_right _ _))
    · by_cases c3 : k ≤ 631
      · have hb1 : Nat.ble k0 631 = true := by rw [Nat.ble_eq]; omega
        have hb2 : Nat.ble 450 k1 = true := by rw [Nat.ble_eq]; omega
        rw [hb1, hb2]; dsimp only
        have hmax : 450 ≤ max2 k0 450 ∧ max2 k0 450 ≤ k := by
          unfold max2; cases h : Nat.ble k0 450 <;> dsimp only
          · rw [ble_false_iff] at h; omega
          · rw [Nat.ble_eq] at h; omega
        exact le_trans (hm2 (max2 k0 450) k hmax.1 hmax.2 c3)
          (le_trans (le_trans (le_max2_left _ _) (le_max2_right _ _)) (le_max2_right _ _))
      · have hb1 : Nat.ble k0 767 = true := by rw [Nat.ble_eq]; omega
        have hb2 : Nat.ble 631 k1 = true := by rw [Nat.ble_eq]; omega
        rw [hb1, hb2]; dsimp only
        have hmin : k ≤ min2 k1 767 ∧ min2 k1 767 ≤ 767 := by
          unfold min2; cases h : Nat.ble k1 767 <;> dsimp only
          · rw [ble_false_iff] at h; omega
          · rw [Nat.ble_eq] at h; omega
        exact le_trans (hm3 k (min2 k1 767) (by omega) hmin.1 hmin.2)
          (le_trans (le_trans (le_trans (le_max2_left _ _) (le_max2_right _ _)) (le_max2_right _ _)) (le_max2_right _ _))

theorem validBuchstab_V256 : S_scale ≤ getV 256 := by decide +kernel +kernel
theorem validBuchstab_p0 : allPow2 9 0 (checkBuchstabStepWith getV getU) = true := by decide +kernel +kernel
theorem validBuchstab_p1 : allPow2 9 512 (checkBuchstabStepWith getV getU) = true := by decide +kernel +kernel
theorem getU1023_le_M4 : getU 1023 ≤ M4_val := by decide +kernel +kernel
theorem getU767_le_M3 : getU 767 ≤ M3_val := by decide +kernel +kernel

theorem monoU_0 : allPow2 8 0 (fun k => match Nat.ble k 254 with | true => Nat.ble (getU (k + 1)) (getU k) | false => true) = true := by decide +kernel +kernel
theorem monoU_1 : allPow2 8 256 (fun k => match Nat.ble k 449 with | true => Nat.ble (getU k) (getU (k + 1)) | false => true) = true := by decide +kernel +kernel
theorem monoU_2 : allPow2 8 448 (fun k => match Nat.ble 450 k, Nat.ble k 630 with | true, true => Nat.ble (getU (k + 1)) (getU k) | _, _ => true) = true := by decide +kernel +kernel
theorem monoU_3 : allPow2 8 512 (fun k => match Nat.ble 631 k, Nat.ble k 766 with | true, true => Nat.ble (getU k) (getU (k + 1)) | _, _ => true) = true := by decide +kernel +kernel

theorem monoU_0_spec {k : Nat} (hk : k < 255) : getU (k + 1) ≤ getU k := by
  have h := allPow2_spec monoU_0 (by omega) (by omega : k < 0 + 2 ^ 8)
  have hb : Nat.ble k 254 = true := by rw [Nat.ble_eq]; omega
  rw [hb] at h; exact Nat.ble_eq.mp h

theorem monoU_1_spec {k : Nat} (hlo : 256 ≤ k) (hhi : k < 450) : getU k ≤ getU (k + 1) := by
  have h := allPow2_spec monoU_1 hlo (by omega : k < 256 + 2 ^ 8)
  have hb : Nat.ble k 449 = true := by rw [Nat.ble_eq]; omega
  rw [hb] at h; exact Nat.ble_eq.mp h

theorem monoU_2_spec {k : Nat} (hlo : 450 ≤ k) (hhi : k < 631) : getU (k + 1) ≤ getU k := by
  have h := allPow2_spec monoU_2 (by omega) (by omega : k < 448 + 2 ^ 8)
  have hb1 : Nat.ble 450 k = true := by rw [Nat.ble_eq]; omega
  have hb2 : Nat.ble k 630 = true := by rw [Nat.ble_eq]; omega
  rw [hb1, hb2] at h; exact Nat.ble_eq.mp h

theorem monoU_3_spec {k : Nat} (hlo : 631 ≤ k) (hhi : k < 767) : getU k ≤ getU (k + 1) := by
  have h := allPow2_spec monoU_3 (by omega) (by omega : k < 512 + 2 ^ 8)
  have hb1 : Nat.ble 631 k = true := by rw [Nat.ble_eq]; omega
  have hb2 : Nat.ble k 766 = true := by rw [Nat.ble_eq]; omega
  rw [hb1, hb2] at h; exact Nat.ble_eq.mp h

theorem validBuchstab_all {k : Nat} (hk : k < 1024) : checkBuchstabStepWith getV getU k = true := by
  by_cases h512 : k < 512
  · exact allPow2_spec validBuchstab_p0 (by omega) (by omega)
  · exact allPow2_spec validBuchstab_p1 (by omega) (by omega)

