theorem div_sOf_lt {n c : ℕ} (hc : c < n) : c / Light.Filter2.sOf n < Light.Filter2.mOf n := by
  have hs := sOf_pos n
  unfold Light.Filter2.mOf
  rw [← Nat.add_one_le_iff, Nat.le_div_iff_mul_le hs, Nat.add_mul, Nat.one_mul]
  have := Nat.div_mul_le_self c (Light.Filter2.sOf n)
  omega

theorem mem_poolL {n q : ℕ} : q ∈ Light.Filter2.poolL n ↔ q ∈ Light.Filter2.pool n := by
  simp only [Light.Filter2.poolL, Sieve.primesBelow, List.mem_filter, List.mem_range, decide_eq_true_eq, Light.Filter2.pool,
    Finset.mem_filter, Finset.mem_range]
  tauto

theorem nodup_poolL (n : ℕ) : (Light.Filter2.poolL n).Nodup :=
  (List.nodup_range.filter _).filter _

theorem length_poolL (n : ℕ) : (Light.Filter2.poolL n).length = Light.Filter2.QOf n := by
  rw [Light.Filter2.QOf, ← List.toFinset_card_of_nodup (nodup_poolL n)]
  congr 1
  ext q
  simp [mem_poolL]

theorem poolL_get_mem {n t : ℕ} (ht : t < Light.Filter2.QOf n) :
    (Light.Filter2.poolL n)[t]'(by rw [length_poolL]; exact ht) ∈ Light.Filter2.pool n :=
  mem_poolL.1 (List.getElem_mem _)

theorem pool_bounds {n q : ℕ} (hq : q ∈ Light.Filter2.pool n) : Light.Filter2.RR n ≤ q ∧ q < 2 * Light.Filter2.RR n ∧ q.Prime := by
  simp only [Light.Filter2.pool, Finset.mem_filter, Finset.mem_range] at hq
  exact ⟨hq.2.1, hq.1, hq.2.2⟩

theorem poolAt_mem {n t : ℕ} (ht : t < Light.Filter2.QOf n) : Light.Filter2.poolAt n t ∈ Light.Filter2.pool n := by
  unfold Light.Filter2.poolAt
  rw [List.getD_eq_getElem _ _ (by rw [length_poolL]; exact ht)]
  exact poolL_get_mem ht

theorem exists_poolAt {n q : ℕ} (hq : q ∈ Light.Filter2.pool n) : ∃ t < Light.Filter2.QOf n, Light.Filter2.poolAt n t = q := by
  obtain ⟨t, ht, he⟩ := List.getElem_of_mem (mem_poolL.2 hq)
  refine ⟨t, by rw [← length_poolL]; exact ht, ?_⟩
  unfold Light.Filter2.poolAt
  rw [List.getD_eq_getElem _ _ ht, he]

theorem QOf_lt (n : ℕ) : Light.Filter2.QOf n ≤ 2 * Light.Filter2.RR n := by
  unfold Light.Filter2.QOf Light.Filter2.pool
  exact (Finset.card_filter_le _ _).trans (by simp)

theorem sum_filter_mod_eq (m N g : ℕ) (hg : g < N) (P : ℕ → Bool) (f : ℕ → ℕ) :
    ∑ i ∈ (Finset.range (m * N)).filter (fun i => P i = true ∧ i % N = g), f i =
      ∑ j ∈ Finset.range m, if P (j * N + g) then f (j * N + g) else 0 := by
  rw [Finset.sum_filter]
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.succ_mul, Finset.sum_range_add, ih, Finset.sum_range_succ]
    congr 1
    rw [Finset.sum_eq_single g]
    · have : (m * N + g) % N = g := by
        rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hg]
      by_cases hP : P (m * N + g) <;> simp [this, hP]
    · intro x hx hxg
      have : (m * N + x) % N = x := by
        rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (Finset.mem_range.1 hx)]
      simp [this, hxg]
    · intro h
      exact absurd (Finset.mem_range.2 hg) h

variable {n s U : ℕ} {AB BC AC : List ℤ}

/-- The mass of a group, block by block. -/
theorem mass_eq_sum (A : ℕ → Bool) (M : ℕ) {g : ℕ} (hg : g < n * n) :
    Light.Filter2.mass n s AB BC AC A M g = ∑ j ∈ Finset.range ((n + s - 1) / s),
      if A (j * (n * n) + g) then Light.Filter2.cntOf n s M AB BC AC (j * (n * n) + g) else 0 :=
  sum_filter_mod_eq _ _ g hg A _

theorem mod_block {N j g : ℕ} (hg : g < N) : (j * N + g) % N = g := by
  rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hg]

theorem div_block {N j g : ℕ} (hg : g < N) : (j * N + g) / N = j := by
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hg, Nat.zero_add]

theorem mass_eff {act D : ℕ → Bool} (M : ℕ) {g : ℕ} (hg : g < n * n) :
    Light.Filter2.mass n s AB BC AC (Light.Filter2.eff (n * n) act D) M g =
      if D g then 0 else Light.Filter2.mass n s AB BC AC act M g := by
  rw [mass_eq_sum _ _ hg, mass_eq_sum _ _ hg]
  by_cases hD : D g
  · simp [Light.Filter2.eff, mod_block hg, hD]
  · simp [Light.Filter2.eff, mod_block hg, hD]

theorem tot_le_s (A : ℕ → Bool) (M : ℕ) : Light.Filter2.tot n s AB BC AC A M ≤ s * Light.Filter2.cardA n s A := by
  unfold Light.Filter2.tot Light.Filter2.cardA
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun g hg => ?_
  rw [mass_eq_sum _ _ (Finset.mem_range.1 hg), Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  split_ifs
  · simpa using cntOf_le_s M _
  · simp

theorem card_filter_le_tot (A : ℕ → Bool) (M : ℕ) :
    Light.Filter2.cardA n s (fun i => A i && decide (0 < Light.Filter2.cntOf n s M AB BC AC i)) ≤ Light.Filter2.tot n s AB BC AC A M := by
  unfold Light.Filter2.tot Light.Filter2.cardA
  refine Finset.sum_le_sum fun g hg => ?_
  rw [mass_eq_sum _ _ (Finset.mem_range.1 hg)]
  refine Finset.sum_le_sum fun j _ => ?_
  by_cases hA : A (j * (n * n) + g) <;> by_cases hc : 0 < Light.Filter2.cntOf n s M AB BC AC (j * (n * n) + g) <;>
    simp [hA, hc] <;> omega

theorem cardA_true : Light.Filter2.cardA n s (fun _ => true) = n * n * ((n + s - 1) / s) := by
  simp [Light.Filter2.cardA]

theorem cardA_mono {A A' : ℕ → Bool} (h : ∀ i, A i = true → A' i = true) :
    Light.Filter2.cardA n s A ≤ Light.Filter2.cardA n s A' := by
  unfold Light.Filter2.cardA
  refine Finset.sum_le_sum fun g _ => Finset.sum_le_sum fun j _ => ?_
  by_cases hA : A (j * (n * n) + g)
  · simp [hA, h _ hA]
  · simp [hA]

theorem witness_of_cnt0 {i : ℕ} (h : 0 < Light.Filter2.cntOf n s 0 AB BC AC i) :
    ∃ c < n, Light.Filter2.triSum n AB BC AC (i % (n * n)) c = 0 := by
  unfold Light.Filter2.cntOf at h
  obtain ⟨c, hc⟩ := Finset.card_pos.1 h
  simp only [Finset.mem_filter, Finset.mem_range, Nat.cast_zero, zero_dvd_iff] at hc
  exact ⟨c, hc.1, hc.2.2⟩

theorem witness_of_mass0 {A : ℕ → Bool} {g : ℕ} (h : 0 < Light.Filter2.mass n s AB BC AC A 0 g) :
    ∃ c < n, Light.Filter2.triSum n AB BC AC g c = 0 := by
  unfold Light.Filter2.mass at h
  obtain ⟨i, hi, hpos⟩ := Finset.exists_ne_zero_of_sum_ne_zero h.ne'
  simp only [Finset.mem_filter] at hi
  obtain ⟨c, hc, he⟩ := witness_of_cnt0 (Nat.pos_of_ne_zero hpos)
  rw [hi.2.2] at he
  exact ⟨c, hc, he⟩

theorem cnt0_of_witness {g c : ℕ} (hs : 1 ≤ s) (hg : g < n * n) (hc : c < n)
    (h : Light.Filter2.triSum n AB BC AC g c = 0) :
    0 < Light.Filter2.cntOf n s 0 AB BC AC ((c / s) * (n * n) + g) := by
  unfold Light.Filter2.cntOf
  refine Finset.card_pos.2 ⟨c, ?_⟩
  simp only [Finset.mem_filter, Finset.mem_range, Nat.cast_zero, zero_dvd_iff, div_block hg,
    mod_block hg]
  refine ⟨hc, ⟨Nat.div_mul_le_self c s, ?_, hc⟩, h⟩
  rw [Nat.add_mul, Nat.one_mul]
  have := Nat.lt_div_mul_add (a := c) hs
  omega

/-- **Soundness of the certificate**: a certified group has an exact witness. -/
theorem witness_of_certOf (hAB : AbsLe AB U) (hBC : AbsLe BC U) (hAC : AbsLe AC U)
    {act : ℕ → Bool} {M g : ℕ} (h : Light.Filter2.certOf n s U AB BC AC act M g) :
    ∃ c < n, Light.Filter2.triSum n AB BC AC g c = 0 := by
  refine witness_of_mass0 (s := s) (A := act)
    (exists_witness_of_certified (s := s) (M := M) hAB hBC hAC (QOf_pos n) ?_)
  intro q hq
  obtain ⟨t, ht, rfl⟩ := exists_poolAt hq
  exact h t ht

/-- **The contraction of a step**: after the certification (`D'`) and the choice of the prime
`poolAt n ts`, which minimizes the remaining mass, the total mass shrinks by `2h/Q`. -/
theorem step_contract (hAB : AbsLe AB U) (hBC : AbsLe BC U) (hAC : AbsLe AC U)
    {act D D' : ℕ → Bool} {M ts : ℕ}
    (hD' : ∀ g < n * n, D' g = true ↔ (D g = true ∨ Light.Filter2.certOf n s U AB BC AC act M g))
    (hts : ts < Light.Filter2.QOf n)
    (hmin : ∀ t < Light.Filter2.QOf n,
      (∑ g ∈ Finset.range (n * n), if D' g then 0 else Light.Filter2.mass n s AB BC AC act (M * Light.Filter2.poolAt n ts) g) ≤
        ∑ g ∈ Finset.range (n * n), if D' g then 0 else Light.Filter2.mass n s AB BC AC act (M * Light.Filter2.poolAt n t) g) :
    Light.Filter2.QOf n * Light.Filter2.tot n s AB BC AC (Light.Filter2.eff (n * n) act D') (M * Light.Filter2.poolAt n ts) ≤
      2 * Light.Filter2.hOf n U * Light.Filter2.tot n s AB BC AC (Light.Filter2.eff (n * n) act D) M := by
  set Rem := (Finset.range (n * n)).filter fun g => D' g = false with hRem
  have hsum : ∀ (X : ℕ) (f : ℕ → ℕ), (∑ g ∈ Finset.range (n * n), if D' g then 0 else f g) =
      ∑ g ∈ Rem, f g := by
    intro X f
    rw [hRem, Finset.sum_filter]
    refine Finset.sum_congr rfl fun g _ => ?_
    cases D' g <;> simp
  have htot : ∀ (E : ℕ → Bool) (X : ℕ), Light.Filter2.tot n s AB BC AC (Light.Filter2.eff (n * n) act E) X =
      ∑ g ∈ Finset.range (n * n), if E g then 0 else Light.Filter2.mass n s AB BC AC act X g := by
    intro E X
    unfold Light.Filter2.tot
    exact Finset.sum_congr rfl fun g hg => mass_eff X (Finset.mem_range.1 hg)
  have hcon := contract (A := act) (M := M) (Rem := Rem) (qs := Light.Filter2.poolAt n ts) hAB hBC hAC
    (fun g hg => by
      simp only [hRem, Finset.mem_filter, Finset.mem_range] at hg
      have hnot : ¬ Light.Filter2.certOf n s U AB BC AC act M g := fun hc => by
        have := (hD' g hg.1).2 (Or.inr hc)
        rw [hg.2] at this
        exact Bool.false_ne_true this
      unfold Light.Filter2.certOf at hnot
      push Not at hnot
      obtain ⟨t, ht, hle⟩ := hnot
      exact ⟨Light.Filter2.poolAt n t, poolAt_mem ht, hle⟩)
    (poolAt_mem hts)
    (fun q hq => by
      obtain ⟨t, ht, rfl⟩ := exists_poolAt hq
      have := hmin t ht
      rwa [hsum 0, hsum 0] at this)
  rw [htot, htot, hsum 0]
  refine hcon.trans (Nat.mul_le_mul_left _ ?_)
  rw [hRem, Finset.sum_filter]
  refine Finset.sum_le_sum fun g hg => ?_
  have hg' := Finset.mem_range.1 hg
  by_cases hD : D g
  · have : D' g = true := (hD' g hg').2 (Or.inl hD)
    simp [hD, this]
  · cases D' g <;> simp [hD]

theorem pow_step {Q h t a b c : ℕ} (h1 : Q * b ≤ 2 * h * a) (h2 : Q ^ t * a ≤ (2 * h) ^ t * c) :
    Q ^ (t + 1) * b ≤ (2 * h) ^ (t + 1) * c :=
  calc Q ^ (t + 1) * b = Q ^ t * (Q * b) := by ring
    _ ≤ Q ^ t * (2 * h * a) := Nat.mul_le_mul_left _ h1
    _ = 2 * h * (Q ^ t * a) := by ring
    _ ≤ 2 * h * ((2 * h) ^ t * c) := Nat.mul_le_mul_left _ h2
    _ = (2 * h) ^ (t + 1) * c := by ring

/-- With the guard, a round shrinks the number of active candidates by `2^d`. -/
theorem guard_step {Q h s r d a0 a1 : ℕ} (hQ : 0 < Q) (hG : s * (2 * h) ^ r * 2 ^ d ≤ Q ^ r)
    (ha : Q ^ r * a1 ≤ (2 * h) ^ r * (s * a0)) : 2 ^ d * a1 ≤ a0 := by
  have hpos : 0 < Q ^ r := Nat.pow_pos hQ
  refine Nat.le_of_mul_le_mul_left ?_ hpos
  calc Q ^ r * (2 ^ d * a1) = 2 ^ d * (Q ^ r * a1) := by ring
    _ ≤ 2 ^ d * ((2 * h) ^ r * (s * a0)) := Nat.mul_le_mul_left _ ha
    _ = s * (2 * h) ^ r * 2 ^ d * a0 := by ring
    _ ≤ Q ^ r * a0 := Nat.mul_le_mul_right _ hG

/-- There are fewer candidates than `2^{d · rounds}`. -/
theorem card_lt_two_pow (n : ℕ) : n * n * Light.Filter2.mOf n < 2 ^ (Light.Filter2.dOf n * Light.Filter2.roundsOf n) := by
  have hd := dOf_pos n
  have hn : n < 2 ^ Light.Filter2.kOf n := Nat.lt_size_self n
  have h3 : n * n * Light.Filter2.mOf n ≤ n * n * n := Nat.mul_le_mul_left _ (mOf_le n)
  have hcube : n * n * n < 2 ^ Light.Filter2.kOf n * 2 ^ Light.Filter2.kOf n * 2 ^ Light.Filter2.kOf n := by
    have h1 : n * n < 2 ^ Light.Filter2.kOf n * 2 ^ Light.Filter2.kOf n := Nat.mul_lt_mul'' hn hn
    exact Nat.mul_lt_mul'' h1 hn
  have hpow : 2 ^ Light.Filter2.kOf n * 2 ^ Light.Filter2.kOf n * 2 ^ Light.Filter2.kOf n ≤ 2 ^ (Light.Filter2.dOf n * Light.Filter2.roundsOf n) := by
    rw [← pow_add, ← pow_add]
    refine Nat.pow_le_pow_right (by norm_num) ?_
    have := Nat.lt_mul_div_succ (3 * Light.Filter2.kOf n) (show 0 < Light.Filter2.dOf n by omega)
    unfold Light.Filter2.roundsOf
    omega
  omega

end Light.Filter2
end
end

