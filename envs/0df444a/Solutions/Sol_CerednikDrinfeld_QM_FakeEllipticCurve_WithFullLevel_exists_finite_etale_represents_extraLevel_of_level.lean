variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n : ℕ) [NeZero n]
  [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)]
  (U : (L.schemeKer n).Opens) (hU : IsClosed (U : Set ↥(L.schemeKer n)))
  (k : Type) [Field k] [IsAlgClosed k] (sk : R →+* k)

theorem nsmul_eq_one_of_factorsThrough {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (hP : CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P) : L.nsmul t n P = L.one t := by
  obtain ⟨x, hx, -⟩ := (Bridge.factorsThrough_iff L n U P).mp hP
  have : P = KerOps.toPt L n x (KerOps.comp_str_of_comp_ι L n P x hx) := Subtype.ext hx.symm
  rw [this]; exact KerOps.nsmul_toPt L n x _

include hU in

theorem fibre_of_ranks
    (hsub : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P →
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) Q →
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.mul t P Q) ∧
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.inv t P))
    (hone : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.one t))
    (hrk : ∀ d ∈ n.divisors, ((U ⊓ Td L hc n d).ι ≫ L.schemeKerStr n).finrank
      (Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k)) = d ^ 2) :
    ∃ e : ZMod n × ZMod n ≃
        {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f //
          CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P},
      ∀ x y : ZMod n × ZMod n, (e (x + y) : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f) =
        L.mul (CerednikDrinfeld.QM.geomPoint k sk) (e x) (e y) := by
  let t₀ := CerednikDrinfeld.QM.geomPoint k sk
  let H : Set (SchemeHomOver t₀ f) := {P | CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P}
  have hcard : ∀ d : ℕ, d ∣ n → Nat.card {P : ↥H // L.nsmul t₀ d P.1 = L.one t₀} = d ^ 2 := by
    intro d hd
    have h1 : Nat.card {P : ↥H // L.nsmul t₀ d P.1 = L.one t₀} =
        Nat.card {P : SchemeHomOver t₀ f // CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P ∧
          L.nsmul t₀ d P = L.one t₀} :=
      Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter
        (fun P => CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P) (fun P => L.nsmul t₀ d P = L.one t₀))
    rw [h1, natCard_torsion_eq_finrank L hc n U k sk hU d]
    exact hrk d (Nat.mem_divisors.mpr ⟨hd, NeZero.ne n⟩)
  have hfinH : H.Finite := by
    have h1 : Nat.card {P : ↥H // L.nsmul t₀ n P.1 = L.one t₀} = Nat.card ↥H :=
      Nat.card_congr (Equiv.subtypeUnivEquiv (fun P => nsmul_eq_one_of_factorsThrough L n U P.1 P.2))
    have h2 : Nat.card ↥H ≠ 0 := by rw [← h1, hcard n dvd_rfl]; exact pow_ne_zero 2 (NeZero.ne n)
    exact Nat.finite_of_card_ne_zero h2
  exact RelativeGroupLaw.exists_zmod_prod_equiv_of_natCard_nsmul_eq_one_eq_sq L hc t₀ H hfinH (hone t₀)
    (fun P Q hP hQ => (hsub t₀ P Q hP hQ).1) (fun P hP => (hsub t₀ P P hP hP).2) n
    (fun P hP => nsmul_eq_one_of_factorsThrough L n U P hP) hcard

include hU in

theorem ranks_of_fibre
    (e : ZMod n × ZMod n ≃
        {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f //
          CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P})
    (he : ∀ x y : ZMod n × ZMod n, (e (x + y) : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f) =
        L.mul (CerednikDrinfeld.QM.geomPoint k sk) (e x) (e y))
    (d : ℕ) (hd : d ∣ n) :
    ((U ⊓ Td L hc n d).ι ≫ L.schemeKerStr n).finrank
      (Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k)) = d ^ 2 := by
  have e0 : (e 0).1 = L.one (CerednikDrinfeld.QM.geomPoint k sk) := by
    apply KerOps.eq_one_of_mul_self L
    have := he 0 0; rwa [add_zero] at this
  have esmul : ∀ (m : ℕ) (x : ZMod n × ZMod n),
      (e (m • x)).1 = L.nsmul (CerednikDrinfeld.QM.geomPoint k sk) m (e x).1 := by
    intro m; induction m with
    | zero => intro x; rw [zero_smul, e0, RelativeGroupLaw.nsmul_zero]
    | succ m ih => intro x; rw [add_smul, one_smul, he, ih, RelativeGroupLaw.nsmul_succ]
  rw [← natCard_torsion_eq_finrank L hc n U k sk hU d, ← natCard_nsmul_eq_zero_zmod_prod n d hd]
  symm
  apply Nat.card_congr
  refine (e.subtypeEquiv ?_).trans (Equiv.subtypeSubtypeEquivSubtypeInter _ _)
  intro x
  show d • x = 0 ↔ L.nsmul _ d (e x).1 = L.one _
  rw [← esmul, ← e0]
  constructor
  · intro h; rw [h]
  · intro h; exact e.injective (Subtype.ext h)

end FibreType
