/-- Complex combinations commute with frame derivatives of `C^∞` real-tangent variations. -/
theorem fdir_cplx {E : Fin 4 → Fin 4 → Pt 4 → ℂ} {V : Set (Pt 4)} (hV : IsOpen V) {x : Pt 4} (hx : x ∈ V)
