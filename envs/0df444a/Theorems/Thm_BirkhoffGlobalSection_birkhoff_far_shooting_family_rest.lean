-- title:
--   The far shooting family in the shooting rectangle, allowing an end at a state of rest
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. Write $(x_1,x_2)$ for the physical position relative to the primary $J$ and $(v_1,v_2)$ for the physical (Jacobi) velocity. Let $F(r)$ be the perpendicular far start at $z=(0,r)$, and let the shooting coordinates of a state on the line $x_1=0$ be $(\sin\tau, -x_2)=(v_2/|v|, -x_2)$.
--
--   **The far shooting family in the rectangle (rest allowed).** There is a curve $\Gamma:[-1,1)\to\mathbb R^2$ with $\Gamma(-1)=(-\sqrt2/2,0)$, $\Gamma([-1,1))\subset[-1,1]\times[0,1]$, and every $\Gamma(t)$, $-1<t<1$, has positive depth and is the shooting coordinate of the crossing state of a far arc (start on the far half-axis with $w_1=0$, below the axis, $x_1$ strictly increasing, crossing $x_1=0$ with $v_1>0$), such that either
--
--   1. $\Gamma$ extends continuously to $[-1,1]$ with $\Gamma(1)$ in the rectangle and ($\Gamma_1(1)=\pm1$, $\Gamma_2(1)>0$) or ($\Gamma_2(1)=0$, $\Gamma_1(1)>\sqrt2/2$); or
--   2. $\Gamma$ is continuous on $[-1,1)$, and there is $d>0$ bounding the depth of every moving state ($v_1>0$) of $\Sigma_{\mu,c}$ on the line $x_1=0$ below the axis, with $\Gamma_2(t)\to d$ as $t\to1^-$.
--
--   In case 2 the far curve climbs to the top edge $y_0=d$ of Birkhoff's rectangle (1915, §18), which the near family cannot reach.
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18, pp. 731–742 (Rend. Circ. Mat. Palermo 39)

import Definitions.Def_BirkhoffShootingArcs
import Mathlib.Order.Filter.Basic
import Mathlib.Topology.Order.Basic

namespace BirkhoffGlobalSection

theorem birkhoff_far_shooting_family_rest (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ) :
    ∃ Γ : ℝ → ℝ × ℝ,
      Γ (-1) = (-(Real.sqrt 2 / 2), 0) ∧
      (∀ t ∈ Set.Ico (-1 : ℝ) 1,
        -1 ≤ (Γ t).1 ∧ (Γ t).1 ≤ 1 ∧ 0 ≤ (Γ t).2 ∧ (Γ t).2 ≤ 1) ∧
      (∀ t ∈ Set.Ioo (-1 : ℝ) 1, 0 < (Γ t).2 ∧
        ∃ x : LeftEnergyState μ c, ∃ τ : ℝ, 0 < τ ∧
          (x : Phase) 0 = 0 ∧ (x : Phase) 3 = 0 ∧ (x : Phase) 1 ≠ 0 ∧
          (∀ u ∈ Set.Ioo 0 τ,
            relativePosition μ ((φ u x : LeftEnergyState μ c) : Phase) 1 < 0) ∧
          StrictMonoOn
            (fun u : ℝ => relativePosition μ ((φ u x : LeftEnergyState μ c) : Phase) 0)
            (Set.Icc 0 τ) ∧
          relativePosition μ ((φ τ x : LeftEnergyState μ c) : Phase) 0 = 0 ∧
          0 < jacobiVelocity
            (leviCivitaToJacobi μ ((φ τ x : LeftEnergyState μ c) : Phase)) 0 ∧
          shootingCoordinates μ ((φ τ x : LeftEnergyState μ c) : Phase) = Γ t) ∧
      ((ContinuousOn Γ (Set.Icc (-1) 1) ∧
        ((((Γ 1).1 = -1 ∨ (Γ 1).1 = 1) ∧ 0 < (Γ 1).2) ∨
          ((Γ 1).2 = 0 ∧ Real.sqrt 2 / 2 < (Γ 1).1)) ∧
        -1 ≤ (Γ 1).1 ∧ (Γ 1).1 ≤ 1 ∧ 0 ≤ (Γ 1).2 ∧ (Γ 1).2 ≤ 1) ∨
       (ContinuousOn Γ (Set.Ico (-1) 1) ∧ ∃ d : ℝ, 0 < d ∧
        (∀ s : LeftEnergyState μ c, relativePosition μ (s : Phase) 0 = 0 →
          relativePosition μ (s : Phase) 1 < 0 →
          0 < jacobiVelocity (leviCivitaToJacobi μ (s : Phase)) 0 →
          -relativePosition μ (s : Phase) 1 < d) ∧
        Filter.Tendsto (fun t : ℝ => (Γ t).2) (nhdsWithin 1 (Set.Iio 1)) (nhds d))) := by sorry

end BirkhoffGlobalSection
