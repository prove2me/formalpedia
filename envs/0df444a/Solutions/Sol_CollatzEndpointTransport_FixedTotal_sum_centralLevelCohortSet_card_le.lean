namespace CollatzEndpointTransport.FixedTotal
theorem _root_.solution
    {M s : ℕ} {theta eta : ℝ} (hs : 0 < s) :
    ∑ u : Fin M, ((centralLevelCohortSet M s theta eta u).card : ℝ) ≤
      ((sourceOddLevel M s).card : ℝ) := by
  have hsumNat :
      ∑ u : Fin M, (centralLevelCohortSet M s theta eta u).card ≤
        ∑ u : Fin M, (levelCohortSet M s u).card := by
    apply Finset.sum_le_sum
    intro u hu
    exact Finset.card_le_card
      (centralLevelCohortSet_subset_levelCohortSet u)
  have hsumReal :
      ∑ u : Fin M, ((centralLevelCohortSet M s theta eta u).card : ℝ) ≤
        (levelSourceCard M s : ℝ) := by
    exact_mod_cast hsumNat
  simpa [levelSourceCard_eq_card_sourceOddLevel hs] using hsumReal
end CollatzEndpointTransport.FixedTotal
