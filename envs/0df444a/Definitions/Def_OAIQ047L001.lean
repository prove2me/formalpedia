namespace OAI

namespace Laughlin
open scoped BigOperators Topology
open Filter
noncomputable section

def deltaTerm (Q m : ℕ) : ℝ :=
  if 17+2*m ≤ Q then tailWeight Q (17+2*m) else 0

def deltaFormula (Q : ℕ) : ℝ := ∑' m, deltaTerm Q m

end
