theorem outP_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {iP iS iT iA iN : Fin HS} (fP : Free7 iP)
    (fS : Free7 iS) (fT : Free7 iT) (fA : Free7 iA) (fN : Free iN) (h55 : F 55 = [])
    {p s t α n' A : ℕ} {LP LS LT LA LN : List ℤ}
    (hGP : F iP = (p : ℤ) :: LP) (hGS : F iS = (s : ℤ) :: LS) (hGT : F iT = (t : ℤ) :: LT)
    (hGA : F iA = (α : ℤ) :: LA) (hGN : F iN = (n' : ℤ) :: LN) (hs : 0 < s) (ha : 1 ≤ α)
    (hpA : p ≤ 2 ^ A) (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A) (haA : α ≤ 2 ^ A) (hnA : n' ≤ 2 ^ A)
    (hA : 2 ≤ A) (hdA : ∀ l < s, |dTilde p s t α l| ≤ 2 ^ A) :
    Sp (outP iP iS iT iA iN) (encK s0 F)
      (encK s0 (update F 44 (srcTab (fun l => some l) (argO p s t α) n' ++ F 44)))
      ((n' + 1) * (c7 A p α + 4 * uC A DD + uC A DD)) := by
  rw [enc_base s0 F, enc_base44]
  have hw : (55 : Fin HS) ∉ expPosP.writes := by decide
  refine tab_loop55 _ F fN h55 hGN hnA (by simp [outB, callB, RS.writes, hw]) _ _ (fun j hj => ?_)
  rw [tbS_upd55, tbS_upd55]
  generalize b43 s0 F = s1
  set G' := update F 55 [(j : ℤ) + 1] with hG'
  have n55 : ∀ {i : Fin HS}, Free7 i → G' i = F i := fun h => by rw [hG', update_of_ne h.2.2.2.2.2.2]
  have e44 : F 44 = G' 44 := by rw [hG', update_of_ne (by decide)]
  rw [e44]
  have q55 : tbS G' [] (tlT (fun l => some l) (argO p s t α) n' (j + 1) ++ G' 44) 55 =
      ((j : ℤ) + 1) :: [] := by
