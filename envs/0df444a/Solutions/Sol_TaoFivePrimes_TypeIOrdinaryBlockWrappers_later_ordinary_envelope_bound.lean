  have hconst :
      (∑ d ∈ laterOddDivisors q k,
        safeCap A (ordinaryReciprocalBudget x)
          (Real.pi * gamma * (d : ℝ))) ≤
      2 * A + (2 / Real.pi) * ordinaryReciprocalBudget x *
        (q : ℝ) * Real.log (4 * (q : ℝ)) := by
    rw [laterOddDivisors_eq_realOddInterval]
    simpa only [add_zero] using hshort
  have hnoise :
      2 * ordinaryReciprocalBudget x +
          (2 / Real.pi) * ordinaryReciprocalBudget x * (q : ℝ) *
            Real.log (4 * (q : ℝ)) ≤
        ordinaryReciprocalBudget x * oddVinogradovBlockConstant q := by
    have htwo : (2 : ℝ) ≤ 4 * (q : ℝ) := by
      exact_mod_cast (show 2 ≤ 4 * q by omega)
    have hscaled := mul_le_mul_of_nonneg_left htwo hB
    unfold oddVinogradovBlockConstant
    nlinarith
  have hmain :
      2 * ((1 / 2 : ℝ) * (x / laterBlockLower q k) * Real.log x) =
        (x * Real.log x) / (2 * (q : ℝ)) *
          (1 / ((k : ℝ) + 5 / 4)) := by
    unfold laterBlockLower
    field_simp
    ring
  calc
    (∑ d ∈ laterOddDivisors q k,
      safeCap (ordinaryDivisorCap x (d : ℝ))
        (ordinaryReciprocalBudget x)
        (Real.pi * gamma * (d : ℝ))) ≤
        ∑ d ∈ laterOddDivisors q k,
          safeCap A (ordinaryReciprocalBudget x)
            (Real.pi * gamma * (d : ℝ)) := hvarConst
    _ ≤ 2 * A + (2 / Real.pi) * ordinaryReciprocalBudget x *
        (q : ℝ) * Real.log (4 * (q : ℝ)) := hconst
    _ ≤ (x * Real.log x) / (2 * (q : ℝ)) *
          (1 / ((k : ℝ) + 5 / 4)) +
        ordinaryReciprocalBudget x * oddVinogradovBlockConstant q := by
      dsimp [A]
      rw [show
