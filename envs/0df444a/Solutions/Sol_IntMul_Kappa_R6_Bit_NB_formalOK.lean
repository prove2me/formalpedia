theorem Φ₁_sq {b c : ℕ} (hb : b < 1771) (hc : c < 38286) : Φ₁ S Si b c * Φ₁ S Si b c = 1 := by
  rw [Φ₁, pswQ_mul, K_mul hSi, Pc_idem hc, Pl_idem hb, two_mul, sub_self, pswQ_zero]

end K

section Good

variable {S : Matrix (Fin 529) (Pr 23) ℚ} {Si : Matrix (Pr 23) (Fin 529) ℚ} {N : ℕ}

theorem goodK (hS : GoodM N S) (hSi : GoodM N Si) {A B : M23} (hA : GoodM N A) (hB : GoodM N B) :
    GoodM N (K S Si A B) := goodM_mul (goodM_mul hS (goodM_kron hA hB)) hSi

theorem goodΦ₁ (hS : GoodM N S) (hSi : GoodM N Si) {b c : ℕ} (hc : GoodM N (Pc c)) (hb : GoodM N (Pl b)) :
    GoodM N (Φ₁ S Si b c) := goodM_pswQ (goodK hS hSi hc hb)

theorem goodΦ₂ (hS : GoodM N S) (hSi : GoodM N Si) {a c : ℕ} (hc : GoodM N (Pc c)) (ha : GoodM N (Pl a)) :
    GoodM N (Φ₂ S Si a c) := goodM_pswQ (goodM_sub (goodM_one N) (goodK hS hSi ha hc))

theorem goodDm {o c : ℕ} (ho : GoodM N (Pc o)) (hc : GoodM N (Pc c)) : GoodM N (Dm o c) := by
  unfold Dm; split_ifs
  · exact goodM_sub hc ho
  · exact goodM_sub ho hc

