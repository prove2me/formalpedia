      simp only [NLogN.Ex.size, hlS, hlM, List.length_reverse]
      have h6 : d * (B + 2) ≤ d * (B + 2) ^ 2 := Nat.mul_le_mul_left _ hX
      nlinarith
    have hcI' : cI ≤ 10 ^ 5 * (d + 1) * (B + 2) + NLogN.KFUU.cClean d B := by
      refine le_trans hcI ?_
      simp only [NLogN.Ex.size, List.length_reverse, hlS]
      nlinarith
    simp only [NLogN.KFUU.cBwd, hSK, hTK, hSR, hTR]
    linarith
end
