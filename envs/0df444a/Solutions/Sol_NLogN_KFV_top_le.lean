theorem cLeafU_le (D N Z w : ℕ) (hDZ : zsz (D : ℤ) ≤ Z) :
    cLeafU D N Z w ≤ 10 ^ 9 * (D + 1) * ((w + 8 * D + 8) * N + Z + 2) := by
  set A := (w + 8 * D + 8) * N
  have ck1 : ∀ w', w' ≤ w + 8 * D → ck N Z w' ≤ 100000 * A + 30000 * (Z + 2) := by
    intro w' hw; unfold ck; simp only [A]
    have : (w' + 3) * N ≤ (w + 8 * D + 8) * N := Nat.mul_le_mul_right _ (by omega)
    nlinarith
  have hs : dScale D ≤ 2 * D := by unfold dScale; omega
  have hk : ∀ w', w' ≤ w + 4 * D → kcU D N Z w' ≤
      1000 * (Z + 2) + 1100 * D + 1300 + D * (400 * (100000 * A + 30000 * (Z + 2)) + 40000 * (Z + 2)) +
        24000 * (Z + 2) := by
    intro w' hw
    have := ck1 (w' + 2 * D) (by omega)
    unfold kcU cKers cRep
    have h4 := Nat.mul_le_mul_left D (Nat.add_le_add_right (Nat.mul_le_mul_left 400 this) (40000 * (Z + 2)))
    omega
  have hd : kdU N Z (w + (2 * D + 2 * D + 2 * D)) ≤ 24000 * (Z + 2) + 8 * (8000 * (Z + 2) + 2 * Z + 27) +
      400 * (100000 * A + 30000 * (Z + 2)) + 4 * (2 * Z + 2) := by
    have := ck1 (w + (2 * D + 2 * D + 2 * D)) (by omega)
    unfold kdU cSel; omega
  have ht : cTrunc (w + 6 * D + 2) (dScale D) (2 * N) Z ≤ 20000 * A + 4000 * (Z + 2) + 2 * Z + 4006 := by
    unfold cTrunc; simp only [A]
    have e1 : (w + 6 * D + 2 + dScale D + 3) * N ≤ (w + 8 * D + 8) * N := Nat.mul_le_mul_right _ (by omega)
    have e2 : (w + 6 * D + 2) * N ≤ (w + 8 * D + 8) * N := Nat.mul_le_mul_right _ (by omega)
    nlinarith
  have k1 := hk w (by omega)
  have k2 := hk (w + 2 * D) (by omega)
  have k3 := hk (w + (2 * D + 2 * D)) (by omega)
  unfold cLeafU
  have eA : 10 ^ 9 * (D + 1) * (A + Z + 2) = 10 ^ 9 * (D * A) + 10 ^ 9 * A + 10 ^ 9 * (D * (Z + 2)) +
      10 ^ 9 * (Z + 2) := by ring
  rw [eA]
  have eD : D * (400 * (100000 * A + 30000 * (Z + 2)) + 40000 * (Z + 2)) =
      40000000 * (D * A) + 12040000 * (D * (Z + 2)) := by ring
  rw [eD] at k1 k2 k3
