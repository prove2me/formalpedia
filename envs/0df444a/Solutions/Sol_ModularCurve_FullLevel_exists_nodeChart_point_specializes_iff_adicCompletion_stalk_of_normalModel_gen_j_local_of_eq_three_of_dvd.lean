  refine ⟨êR.trans (ι.trans q), fun a => ?_⟩
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, hêR, hjR, hι]
  change q (Ideal.Quotient.mk _ (MvPowerSeries.C (algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) (e₁ a)))) = _
  rw [← hê₁, hq3]

theorem not_formallySmooth_localization_atPrime
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] (ϖ₀ : A₀)
    (hϖ₀ : maximalIdeal A₀ = Ideal.span {ϖ₀})
    (A₁ : Type) [CommRing A₁] [IsLocalRing A₁] (e₁ : A₀ ≃+* A₁) (π₁ : A₁) (hπ₁ : e₁ ϖ₀ = π₁)
    {F : Type} [Field F] [Algebra A₀ F]
    (O : Subring F) [IsLocalRing ↥O] [IsNoetherianRing ↥O]
    (cO : A₀ →+* ↥O) (hcO : ∀ a : A₀, ((cO a : ↥O) : F) = algebraMap A₀ F a) (E₀ : ℕ) (hE₀ : 1 ≤ E₀)
    (ι : AdicCompletion (maximalIdeal ↥O) ↥O ≃+*
      ModularCurve.UVCrossingModel (AdicCompletion (maximalIdeal A₁) A₁)
        ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀))
    (hι : ∀ a : A₀, ι (algebraMap ↥O (AdicCompletion (maximalIdeal ↥O) ↥O) (cO a)) =
      ModularCurve.UVCrossingModel.const ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀)
        (algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) (e₁ a)))
    (B : Subalgebra A₀ F) (𝔪 : Ideal ↥B) [𝔪.IsPrime]
    (hBloc : ∀ f : F, f ∈ O ↔ ∃ b c : ↥B, c ∉ 𝔪 ∧ f * (c : F) = (b : F)) :
    ¬ (algebraMap A₀ (Localization.AtPrime 𝔪)).FormallySmooth := by
  classical

  have h1 : (1 : ↥B) ∉ 𝔪 := fun h => (inferInstance : 𝔪.IsPrime).ne_top ((Ideal.eq_top_iff_one 𝔪).mpr h)
  have hBO : ∀ b : ↥B, (b : F) ∈ O := fun b => (hBloc (b : F)).mpr ⟨b, 1, h1, by simp⟩
  let g : ↥B →+* ↥O :=
    { toFun := fun b => ⟨(b : F), hBO b⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun b b' => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun b b' => Subtype.ext (by simp) }
  have hg : ∀ b : ↥B, ((g b : ↥O) : F) = (b : F) := fun b => rfl
  have hne : ∀ c : ↥B, c ∉ 𝔪 → (c : F) ≠ 0 := by
    intro c hc h0
    apply hc
    have hc0 : c = 0 := Subtype.ext (by simpa using h0)
    rw [hc0]
    exact 𝔪.zero_mem
  have hinvO : ∀ c : ↥B, c ∉ 𝔪 → (c : F)⁻¹ ∈ O := fun c hc =>
    (hBloc _).mpr ⟨1, c, hc, by rw [inv_mul_cancel₀ (hne c hc)]; simp⟩
  have hunit : ∀ y : ↥(𝔪.primeCompl), IsUnit (g (y : ↥B)) := by
    intro y
    have hy : (y : ↥B) ∉ 𝔪 := Ideal.mem_primeCompl_iff.mp y.2
    refine isUnit_iff_exists_inv.mpr ⟨⟨((y : ↥B) : F)⁻¹, hinvO _ hy⟩, Subtype.ext ?_⟩
    change ((y : ↥B) : F) * ((y : ↥B) : F)⁻¹ = 1
    exact mul_inv_cancel₀ (hne _ hy)

  let L := Localization.AtPrime 𝔪
  let lift : L →+* ↥O := IsLocalization.lift (M := 𝔪.primeCompl) (S := L) hunit
  have hinj : Function.Injective lift := by
    rw [IsLocalization.lift_injective_iff]
    intro b b'
    constructor
    · intro hbb'
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl L).mp hbb'
      have hc' := congrArg g hc
      rw [map_mul, map_mul] at hc'
      exact (hunit c).mul_left_cancel hc'
    · intro hbb'
      have hval : b = b' := Subtype.ext (by rw [← hg b, ← hg b', hbb'])
      rw [hval]
  have hsurj : Function.Surjective lift := by
    intro f
    obtain ⟨b, c, hc, hbc⟩ := (hBloc (f : F)).mp f.2
    refine ⟨IsLocalization.mk' L b ⟨c, Ideal.mem_primeCompl_iff.mpr hc⟩, ?_⟩
    rw [IsLocalization.lift_mk'_spec]
    apply Subtype.ext
    change (b : F) = (c : F) * (f : F)
    rw [mul_comm]
    exact hbc.symm
  let eR : L ≃+* ↥O := RingEquiv.ofBijective lift ⟨hinj, hsurj⟩
  have hjR : ∀ a : A₀, eR (algebraMap A₀ L a) = cO a := by
    intro a
    apply Subtype.ext
    rw [hcO a]
    change ((lift (algebraMap A₀ L a) : ↥O) : F) = algebraMap A₀ F a
    rw [IsScalarTower.algebraMap_apply A₀ ↥B L a, IsLocalization.lift_eq, hg]
    exact (IsScalarTower.algebraMap_apply A₀ ↥B F a).symm
  obtain ⟨hN, e, he⟩ :=
    crossing_transport A₀ ϖ₀ A₁ e₁ π₁ hπ₁ O cO E₀ ι hι L eR (algebraMap A₀ L) hjR
  haveI : IsNoetherianRing L := hN
  exact RingHom.not_formallySmooth_of_ringEquiv_adicCompletion_crossingModel A₀ ϖ₀ hϖ₀ L (algebraMap A₀ L)
    E₀ hE₀ e he

private theorem algebraMap_stalk_functionField_germ (X : Scheme.{0}) [IsIntegral X] (x : X)
    (s : X.presheaf.obj (Opposite.op ⊤)) :
    algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ ⊤ x trivial).hom s) =
      (X.presheaf.germ ⊤ (genericPoint X) trivial).hom s := by
  rw [RingHom.algebraMap_toAlgebra]
  change (X.presheaf.germ ⊤ x trivial ≫ X.presheaf.stalkSpecializes _).hom s = _
  rw [TopCat.Presheaf.germ_stalkSpecializes]

private theorem _root_.AlgebraicGeometry.UVCrossingNode.stalk_isNoetherianRing_and_crossing
    (A₀ : Type) [CommRing A₀] [IsLocalRing A₀] (ϖ₀ : A₀)
    (A₁ : Type) [CommRing A₁] [IsLocalRing A₁] (e₁ : A₀ ≃+* A₁) (π₁ : A₁) (hπ₁ : e₁ ϖ₀ = π₁)
    {F : Type} [Field F] [Algebra A₀ F]
    (O : Subring F) [IsLocalRing ↥O] [IsNoetherianRing ↥O]
    (cO : A₀ →+* ↥O) (hcO : ∀ a : A₀, ((cO a : ↥O) : F) = algebraMap A₀ F a) (E₀ : ℕ)
    (ι : AdicCompletion (maximalIdeal ↥O) ↥O ≃+*
      ModularCurve.UVCrossingModel (AdicCompletion (maximalIdeal A₁) A₁)
        ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀))
    (hι : ∀ a : A₀, ι (algebraMap ↥O (AdicCompletion (maximalIdeal ↥O) ↥O) (cO a)) =
      ModularCurve.UVCrossingModel.const ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀)
        (algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) (e₁ a)))
    (X : Scheme.{0}) (toBase : X ⟶ Spec (CommRingCat.of A₀)) [IsIntegral X]
    (φ : F ≃+* X.functionField)
    (hφ : ∀ a : A₀, φ (algebraMap A₀ F a) = AlgebraicCurve.SemistableModel.baseToFunctionField toBase a)
    (x : X) (hx : ∀ f : F, f ∈ AlgebraicCurve.SemistableModel.localRing X φ x ↔ f ∈ O) :
    IsNoetherianRing (X.presheaf.stalk x) ∧
    ∃ e : AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+*
        (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal A₀) A₀) ⧸
          Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal A₀) A₀)) * MvPowerSeries.X 1 -
            MvPowerSeries.C ((algebraMap A₀ (AdicCompletion (maximalIdeal A₀) A₀) ϖ₀) ^ E₀)}),
      ∀ a : A₀,
        e (algebraMap (X.presheaf.stalk x) _
            ((X.presheaf.germ ⊤ x trivial).hom
              (toBase.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom a)))) =
          Ideal.Quotient.mk _ (MvPowerSeries.C (algebraMap A₀ (AdicCompletion (maximalIdeal A₀) A₀) a)) := by
  classical
  have hLO : AlgebraicCurve.SemistableModel.localRing X φ x = O := Subring.ext hx
  subst hLO
  obtain ⟨es, hes⟩ := AlgebraicGeometry.exists_ringEquiv_stalk_localRing_coe_eq X φ x
  let jR : A₀ →+* X.presheaf.stalk x :=
    (X.presheaf.germ ⊤ x trivial).hom.comp (toBase.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom)
  have hjR : ∀ a : A₀, es (jR a) = cO a := by
    intro a
    apply Subtype.ext
    rw [hes, hcO a, RingEquiv.symm_apply_eq, hφ]
    exact algebraMap_stalk_functionField_germ X x _
  obtain ⟨hN, e, he⟩ :=
    crossing_transport A₀ ϖ₀ A₁ e₁ π₁ hπ₁ (AlgebraicCurve.SemistableModel.localRing X φ x) cO E₀ ι hι
      (X.presheaf.stalk x) es jR hjR
  exact ⟨hN, e, he⟩

