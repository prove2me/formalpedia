-- Source module: NLogNP.Io
/-!
# Reading the input, writing the output, fixed-length copies
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def St.setIp (σ : St S) (n : ℕ) : St S := { σ with ip := n }
def St.setOut (σ : St S) (o : List Bool) : St S := { σ with out := o }

@[simp] theorem St.setIp_stk (σ : St S) (n : ℕ) : (σ.setIp n).stk = σ.stk := rfl
@[simp] theorem St.setIp_ip (σ : St S) (n : ℕ) : (σ.setIp n).ip = n := rfl
@[simp] theorem St.setIp_out (σ : St S) (n : ℕ) : (σ.setIp n).out = σ.out := rfl
@[simp] theorem St.setOut_stk (σ : St S) (o) : (σ.setOut o).stk = σ.stk := rfl
@[simp] theorem St.setOut_ip (σ : St S) (o) : (σ.setOut o).ip = σ.ip := rfl
@[simp] theorem St.setOut_out (σ : St S) (o) : (σ.setOut o).out = o := rfl
@[simp] theorem St.adv_setIp (σ : St S) (n : ℕ) : (σ.setIp n).adv = σ.setIp (n + 1) := rfl
@[simp] theorem St.outB_setOut (σ : St S) (o) (b : Bool) :
    (σ.setOut o).outB b = σ.setOut (o ++ [b]) := rfl
@[simp] theorem St.set_ip' (σ : St S) (i : Fin S) (l) : (σ.set i l).ip = σ.ip := rfl
@[simp] theorem St.setIp_self (σ : St S) : σ.setIp σ.ip = σ := rfl
@[simp] theorem St.setOut_self (σ : St S) : σ.setOut σ.out = σ := rfl
@[simp] theorem St.top_setIp (σ : St S) (n : ℕ) (i : Fin S) : (σ.setIp n).top i = σ.top i := rfl
@[simp] theorem St.top_setOut (σ : St S) (o) (i : Fin S) : (σ.setOut o).top i = σ.top i := rfl

attribute [simp] St.adv_set St.outB_set

/-! ## Reading the input up to a stop symbol -/

def readδ (q x : Fin S) (stop : Sym) : List (Option Sym) → List (Op S)
  | [some s, t] =>
    if s = 0 then [.inRd x, .pop q, .push q 1]
    else if t = some stop then [.pop x, .pop q, .push q hlt] else [.inRd x]
  | _ => [.pop q, .push q hlt]

/-- Read input codes onto `x` up to (and consuming) the first `stop`. -/
def readUntil (q x : Fin S) (stop : Sym) : Stmt S P := machine q [x] 0 (readδ q x stop)

def readCost (m : ℕ) : ℕ := (m + 2) * 39 + 3

section read
variable {q x : Fin S} (hqx : q ≠ x) (stop : Sym) (Q : List Sym)

/-- State `1` of `readUntil`: input position `p`, stack `x` holds `X`. -/
def readCfg (σ : St S) (s : Sym) (X : List Sym) (p : ℕ) : St S :=
  (((σ.setIp p).set x X).set q (s :: Q))

end read

/-! ## Writing a word to the output -/

def outδ (q x : Fin S) : List (Option Sym) → List (Op S)
  | [_, t] =>
    match bitOf t with
    | some b => [.pop x, .out b]
    | none => [.pop q, .push q hlt]
  | _ => [.pop q, .push q hlt]

/-- Output the bits on top of `x` (top first), popping them. -/
def outWord (q x : Fin S) : Stmt S P := machine q [x] 0 (outδ q x)

def outCost (m : ℕ) : ℕ := (m + 1) * 38 + 3

section out
variable {q x : Fin S} (hqx : q ≠ x) (r Q : List Sym) (hr : bitOf r.head? = none)

def outCfg (σ : St S) (s : Sym) (A : List Bool) (O : List Bool) : St S :=
  (((σ.setOut O).set x (A.map codeBit ++ r)).set q (s :: Q))

end out

/-! ## Copying a fixed number of bits -/

/-- The first `n` bits of `A`, padded with zeros. -/
def fitL : ℕ → List Bool → List Bool
  | 0, _ => []
  | n + 1, [] => false :: fitL n []
  | n + 1, b :: A => b :: fitL n A

/-- One bit of `src` (or `0` if it shows no bit) per bit popped from `cnt`, pushed onto `dst`. -/
def padδ (q src cnt dst : Fin S) : List (Option Sym) → List (Op S)
  | [_, ts, tc] =>
    match bitOf tc with
    | some _ =>
      match bitOf ts with
      | some b => [.pop cnt, .pop src, .push dst (codeBit b)]
      | none => [.pop cnt, .push dst 0]
    | none => [.pop q, .push q hlt]
  | _ => [.pop q, .push q hlt]

def padMove (q src cnt dst : Fin S) : Stmt S P := machine q [src, cnt] 0 (padδ q src cnt dst)

def padCost (m : ℕ) : ℕ := (m + 1) * 56 + 3

section pad
variable {q a c d : Fin S} (hqa : q ≠ a) (hqc : q ≠ c) (hqd : q ≠ d) (hac : a ≠ c) (had : a ≠ d)
  (hcd : c ≠ d) (ra rc Q : List Sym) (hra : bitOf ra.head? = none) (hrc : bitOf rc.head? = none)

def padCfg (σ : St S) (s : Sym) (A C : List Bool) (D : List Sym) : St S :=
  (((σ.set a (A.map codeBit ++ ra)).set c (C.map codeBit ++ rc)).set d D).set q (s :: Q)

end pad

