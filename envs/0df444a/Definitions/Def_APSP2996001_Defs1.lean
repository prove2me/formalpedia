/-- The numbers of the two new procedures. -/
abbrev Proc.allInstancesF : ℕ := 74
@[inherit_doc Proc.allInstancesF] abbrev Proc.regimeTestF : ℕ := 75

/-- allInstancesF(N, D, w, U, x, y, wi, wj, out, fr). Local 10 is the result of the test. -/
