namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

/-- The entry bounds from one volume bound. -/
theorem entB_of_sol_aux {q e P L M : ℕ} {A B Cs : Shape} (hm : 2 ≤ m) (hq : 2 ≤ q)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hA : ∀ x ∈ A, 1 ≤ x) (hB : ∀ x ∈ B, 1 ≤ x) (hC : ∀ x ∈ Cs, 1 ≤ x)
    (hKM : (m + q + T + W + 16) * (vol (P :: L :: hdShape A B Cs e q) + 1) ≤ M) :
    EntB m q W T e P L (vol A) (vol B) (vol Cs) M ∧ (q ^ (e / m) + 1) ^ 3 ≤ M ∧
      vol (P :: L :: hdShape A B Cs e q) ≤ M := by
  set V := vol (P :: L :: hdShape A B Cs e q) with hV
  set a := vol A
  set b := vol B
  set c := vol Cs
  have ha1 : 1 ≤ a := vol_pos_of hA
  have hb1 : 1 ≤ b := vol_pos_of hB
  have hc1 : 1 ≤ c := vol_pos_of hC
  have hW1 : 1 ≤ W := NeZero.pos W
  have hVe : V = P * L * a * q ^ e * b * q ^ e * c := vol_hd_cons P L A B Cs e q
  have hX1 : 1 ≤ q ^ e := Nat.one_le_pow _ _ (by omega)
  have hV0 : 0 < V := by
    rw [hVe]
    exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL) ha1)
      hX1) hb1) hX1) hc1
  have dP : P ≤ V := Nat.le_of_dvd hV0 ⟨L * a * q ^ e * b * q ^ e * c, by rw [hVe]; ring⟩
  have dL : L ≤ V := Nat.le_of_dvd hV0 ⟨P * a * q ^ e * b * q ^ e * c, by rw [hVe]; ring⟩
  have dA : a ≤ V := Nat.le_of_dvd hV0 ⟨P * L * q ^ e * b * q ^ e * c, by rw [hVe]; ring⟩
  have dB : q ^ e * b ≤ V := Nat.le_of_dvd hV0 ⟨P * L * a * q ^ e * c, by rw [hVe]; ring⟩
  have dC : q ^ e * c ≤ V := Nat.le_of_dvd hV0 ⟨P * L * a * q ^ e * b, by rw [hVe]; ring⟩
  have dXX : q ^ e * q ^ e ≤ V := Nat.le_of_dvd hV0 ⟨P * L * a * b * c, by rw [hVe]; ring⟩
  have hbB : b ≤ q ^ e * b := Nat.le_mul_of_pos_left _ hX1
  have hcC : c ≤ q ^ e * c := Nat.le_mul_of_pos_left _ hX1
  have he : e < q ^ e := Nat.lt_pow_self (by omega)
  have hXX : q ^ e ≤ q ^ e * q ^ e := Nat.le_mul_of_pos_left _ hX1
  have hK : (T + W) * V + 16 * V + (m + q + T + W) ≤ M := by
    have h1 : (m + q + T + W + 16) * (V + 1) = (T + W) * V + 16 * V + (m + q + T + W) +
        ((m + q) * V + 16) := by ring
    omega
  have hfm : m * (e / m) ≤ e := Nat.mul_div_le e m
  have hr : e % m ≤ e := Nat.mod_le e m
  have hNm : (q ^ (e / m)) ^ m ≤ q ^ e := by
    rw [← pow_mul, mul_comm]; exact Nat.pow_le_pow_right (by omega) hfm
  have hqr : q ^ (e % m) * b ≤ q ^ e * b :=
    Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by omega) hr)
  have hqr' : q ^ (e % m) * c ≤ q ^ e * c :=
    Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by omega) hr)
  have hX : (q ^ (e / m)) ^ m * q ^ (e % m) = q ^ e := by
    rw [← pow_mul, ← pow_add, mul_comm (e / m) m, Nat.div_add_mod]
  have hvE : volE m q W e P L a b c = L / W * (P * a * q ^ e * b * q ^ e * c) := by
    unfold volE; rw [← hX]; ring
  have hvE' : volE m q W e P L a b c ≤ V := by
    rw [hvE, hVe]
    calc L / W * (P * a * q ^ e * b * q ^ e * c) ≤ L * (P * a * q ^ e * b * q ^ e * c) :=
          Nat.mul_le_mul_right _ (Nat.div_le_self _ _)
      _ = _ := by ring
  have hTW : (T + W) * volE m q W e P L a b c ≤ (T + W) * V := Nat.mul_le_mul_left _ hvE'
  have h3 : (q ^ (e / m) + 1) ^ 3 ≤ 8 * V := by
    have h1 : q ^ (e / m) + 1 ≤ 2 * q ^ (e / m) := by
      have := Nat.one_le_pow (e / m) q (by omega); omega
    have h2 : (q ^ (e / m) + 1) ^ 3 ≤ (2 * q ^ (e / m)) ^ 3 := Nat.pow_le_pow_left h1 3
    have h4 : (2 * q ^ (e / m)) ^ 3 = 8 * q ^ (3 * (e / m)) := by
      rw [mul_pow, ← pow_mul, mul_comm (e / m) 3]; norm_num
    have h5 : 2 * (e / m) ≤ m * (e / m) := Nat.mul_le_mul_right _ hm
    have h6 : q ^ (3 * (e / m)) ≤ q ^ e * q ^ e := by
      rw [← pow_add]; exact Nat.pow_le_pow_right (by omega) (by omega)
    omega
  refine ⟨⟨by omega, hW1, by omega, by omega, by omega, ha1, hb1, hc1, by omega, by omega, by omega,
    by omega⟩, by omega, by omega⟩

end

end IntMul.Kappa.R6.IL

