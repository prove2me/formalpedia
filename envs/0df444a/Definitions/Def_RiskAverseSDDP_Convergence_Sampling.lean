-- title:
--   Assumption (H3), p. 10 — the samples of Algorithm 1 have the law of $\xi_t$ and are sequentially independent
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb P)$ be a probability space. For iterations $k\ge1$ and stages $t=2,\dots,T$, let $\xi^k_t$ be the random index of the realization sampled for stage $t$ at iteration $k$ (so $\xi^k_t=j$ means that the sampled value is $\xi_{t,j}$). **Assumption (H3)** requires:
--   1. each $\xi^k_t$ is a random variable;
--   2. $\mathbb P(\xi^k_t=\xi_{t,j})=\Phi_{t,j}$ for every $j=1,\dots,M$, every $t=2,\dots,T$ and every $k\ge1$;
--   3. for every $t=2,\dots,T$ and $k\ge1$, $\xi^k_t$ is independent of
--   $$
--   \sigma\big(\xi^1_2,\dots,\xi^1_T,\ \dots,\ \xi^{k-1}_2,\dots,\xi^{k-1}_T,\ \xi^k_2,\dots,\xi^k_{t-1}\big).
--   $$
--
--   The positivity $\Phi_{t,j}>0$ and the normalization $\sum_j\Phi_{t,j}=1$, which (H3) also restates, are part of the standing assumptions of the model.
--
--   **Formalization Note** The sample is a family `ξ k ω t : Fin M`; entries with $k=0$ or $t\notin\{2,\dots,T\}$ are never read. The σ-algebra is the supremum of the σ-algebras generated by the listed variables, and independence is `ProbabilityTheory.Indep` of σ-algebras under $\mathbb P$, stated literally as in (H3) rather than as joint independence of the whole family.
-- source:
--   Guigues, Convergence Analysis of Sampling-Based Decomposition Methods for Risk-Averse Multistage Stochastic Convex Programs, arXiv:1408.4439v4, p. 10, Assumption (H3)

import Mathlib
import Definitions.Def_RiskAverseSDDP_Convergence_Model

namespace RiskAverseSDDP.Convergence

open MeasureTheory ProbabilityTheory

namespace Model

variable {T n M q p : ℕ}

/-- Assumption (H3), p. 10, on the samples of Algorithm 1: on the probability space `(Ω, ℙ)`,
`ξ k · t : Ω → Fin M` is the index `j` of the realization `ξ^k_t = ξ_{t,j}` sampled for stage
`t` at iteration `k` (`k ≥ 1`, `t = 2, …, T`), and
* each `ξ^k_t` is a random variable (measurable);
* `ℙ(ξ^k_t = ξ_{t,j}) = Φ_{t,j}` for every `j`, `t = 2, …, T` and `k ≥ 1`;
* for every `t = 2, …, T` and `k ≥ 1`, `ξ^k_t` is independent of
  `σ(ξ^1_2, …, ξ^1_T, …, ξ^{k-1}_2, …, ξ^{k-1}_T, ξ^k_2, …, ξ^k_{t-1})`.
(`Φ_{t,j} > 0` and `Σ_j Φ_{t,j} = 1`, also restated in (H3), are part of `Model.Standing`.) -/
def H3 (D : Model T n M q p) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (ξ : ℕ → Ω → ℕ → Fin M) : Prop :=
  (∀ k t, 1 ≤ k → 2 ≤ t → t ≤ T → Measurable (fun ω => ξ k ω t)) ∧
  (∀ k t (j : Fin M), 1 ≤ k → 2 ≤ t → t ≤ T →
    P {ω | ξ k ω t = j} = ENNReal.ofReal (D.Φ t j)) ∧
  (∀ k t, 1 ≤ k → 2 ≤ t → t ≤ T →
    Indep (MeasurableSpace.comap (fun ω => ξ k ω t) inferInstance)
      (⨆ k', ⨆ t', ⨆ (_ : 1 ≤ k' ∧ 2 ≤ t' ∧ t' ≤ T ∧ (k' < k ∨ (k' = k ∧ t' < t))),
        MeasurableSpace.comap (fun ω => ξ k' ω t') inferInstance) P)

end Model

end RiskAverseSDDP.Convergence


