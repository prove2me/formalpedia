    [Algebra.FiniteType A₀ P₀.B₀]
    (x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Raw P₀.B₀)
    (hx : (Quot.mk _ x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Pt P₀.B₀) = P₀.univ)
    (𝔪 : Ideal P₀.B₀) [𝔪.IsMaximal] (hq𝔪 : algebraMap A₀ P₀.B₀ (q : A₀) ∈ 𝔪)
    (F₀ : FormalGroup (P₀.B₀ ⧸ 𝔪))
    (hF₀W : F₀.toPowerSeries = (x.curve.map (Ideal.Quotient.mk 𝔪)).formalGroupLawFixed)
    (hF₀ : ∃ u : PowerSeries (P₀.B₀ ⧸ 𝔪), IsUnit u ∧ F₀.nthSeries q = u * PowerSeries.X ^ (q * q)) :
    IsDomain (AdicCompletion 𝔪 P₀.B₀) ∧ IsIntegrallyClosed (AdicCompletion 𝔪 P₀.B₀) ∧
      algebraMap P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) (algebraMap A₀ P₀.B₀ (q : A₀)) ≠ 0 := by
  classical
  letI instF : Field (P₀.B₀ ⧸ 𝔪) := Ideal.Quotient.field 𝔪

  obtain ⟨instLoc, instNoeth, instCompl, instTower, resR, hresR, hkerR, hresRmk, W₀, instW₀, instDomW₀, instDVRW₀,
      instComplW₀, hW₀, res₀, hres₀, hker₀, instAlgW₀R, instAlgA₀W₀, instTowerA₀W₀R, hresR₀, hchar, hfac⟩ :=
    ModularCurve.LevelModuliPackageAbs.exists_coefficientRing_factorsThrough_adicCompletion_of_levelModuliDatum q A₀ hA₀q P₀ 𝔪 hq𝔪

  have hℓk : ((ℓ : ℕ) : P₀.B₀ ⧸ 𝔪) ≠ 0 := by
    haveI := hchar
    intro h
    have hdvd : q ∣ ℓ := (CharP.cast_eq_zero_iff (P₀.B₀ ⧸ 𝔪) q ℓ).mp h
    exact hℓq ((Nat.prime_dvd_prime_iff_eq (Fact.out : q.Prime) (Fact.out : ℓ.Prime)).mp hdvd).symm
  have hM'k : ((M' : ℕ) : P₀.B₀ ⧸ 𝔪) ≠ 0 := by
    haveI := hchar
    intro h
    exact hM'q ((CharP.cast_eq_zero_iff (P₀.B₀ ⧸ 𝔪) q M').mp h)
  haveI := instLoc; haveI := instNoeth; haveI := instCompl; haveI := instTower
  letI := instW₀; haveI := instDomW₀; haveI := instDVRW₀; haveI := instComplW₀
  letI := instAlgW₀R; letI := instAlgA₀W₀; haveI := instTowerA₀W₀R; haveI := hchar
  have hq2 : q ≠ 2 := by omega

  haveI hE₀ell : (x.curve.map (Ideal.Quotient.mk 𝔪)).IsElliptic := ⟨x.curve.isUnit_Δ_map _ x.isUnit_Δ⟩
  have hF₀eq : F₀ = (x.curve.map (Ideal.Quotient.mk 𝔪)).formalGroup := FormalGroup.ext hF₀W
  subst hF₀eq
  haveI : IsAdicComplete (⊥ : Ideal (P₀.B₀ ⧸ 𝔪)) (P₀.B₀ ⧸ 𝔪) :=
    IsAdicComplete.of_isNilpotent ⟨1, by rw [pow_one, Ideal.zero_eq_bot]⟩
  have hss : (x.curve.map (Ideal.Quotient.mk 𝔪)).formalGroup.IsDrinfeldBasisAdic ⊥ q 0 0 :=
    (FormalGroup.isDrinfeldBasisAdic_zero_zero_iff ⊥ _ q).mpr hF₀

  let ι : P₀.B₀ →ₐ[A₀] AdicCompletion 𝔪 P₀.B₀ := IsScalarTower.toAlgHom A₀ P₀.B₀ (AdicCompletion 𝔪 P₀.B₀)
  obtain ⟨F, instFc, hFW⟩ :=
    WeierstrassCurve.exists_formalGroup_isComm_toPowerSeries_eq (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve)
  haveI := instFc
  have hxc : ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve = ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).curve := ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).isLevel.2.2.1
  have hE₀R : (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve).map resR = x.curve.map (Ideal.Quotient.mk 𝔪) := by
    rw [hxc]
    show (x.curve.map ι.toRingHom).map resR = x.curve.map (Ideal.Quotient.mk 𝔪)
    rw [WeierstrassCurve.map_map, ← hresRmk]
    rfl
  have hF₀W' : (x.curve.map (Ideal.Quotient.mk 𝔪)).formalGroup.toPowerSeries =
      ((((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve).map resR).formalGroupLawFixed := by
    rw [hE₀R]; rfl

  obtain ⟨χP, χQ, hP, hQ, hFbc, hD, huniv⟩ :=
    ModularCurve.LevelModuliPackageAbs.exists_reducesToOrigin_isDrinfeldBasisAdic_universal_of_factorsThrough_of_ne_two_gamma0Pow
      q hq2 ℓ M' hℓ3 A₀ hℓ hM 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 P₀ x hx (AdicCompletion 𝔪 P₀.B₀) ι (P₀.B₀ ⧸ 𝔪) hℓk hM'k
      resR hresR hkerR W₀ hW₀ res₀ hres₀ hker₀ hresR₀ hfac F hFW _ hF₀W' hss

  obtain ⟨Fu, instFu, hFu, hγ⟩ :=
    WeierstrassCurve.exists_isComm_lift_powerSeries_formalGroup_coeff_nthSeries_of_ne_two q hq2 (P₀.B₀ ⧸ 𝔪)
      (x.curve.map (Ideal.Quotient.mk 𝔪)) hss W₀ hW₀ res₀ hres₀ hker₀
  haveI := instFu

  obtain ⟨hreg, hdim⟩ :=
    FormalGroup.IsDrinfeldBasisAdic.isRegularLocalRing_and_ringKrullDim_eq_two_of_universal_of_isComm_of_lift
      q (P₀.B₀ ⧸ 𝔪) W₀ hW₀ res₀ hres₀ hker₀ _ hss Fu hFu hγ (AdicCompletion 𝔪 P₀.B₀) resR hresR hkerR hresR₀
