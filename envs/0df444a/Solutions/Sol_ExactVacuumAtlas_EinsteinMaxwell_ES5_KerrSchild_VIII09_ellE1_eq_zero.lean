theorem vstar_anchor_eq {j R : ℝ} : vstar 3 1 j R = j / R ^ 2 - 3 * j / (4 * R ^ 3) := by
  unfold vstar n0 n1
  norm_num
  ring

theorem hasDerivAt_vstar_anchor (j : ℝ) {R : ℝ} (hR : R ≠ 0) :
    HasDerivAt (vstar 3 1 j) (-(2 * j / R ^ 3) + 9 * j / (4 * R ^ 4)) R := by
  have h1 : HasDerivAt (fun s : ℝ => s ^ 2) (2 * R) R := by
    simpa using hasDerivAt_pow 2 R
  have h2 : HasDerivAt (fun s : ℝ => j / s ^ 2) (-(2 * j / R ^ 3)) R := by
    have hh := (hasDerivAt_const (x := R) j).div h1 (by positivity)
    have hsum : HasDerivAt (fun s : ℝ => j / s ^ 2) ((0 * R ^ 2 - j * (2 * R)) / (R ^ 2) ^ 2) R := by
      convert hh using 1 <;> first | rfl | (funext y; simp [Pi.div_apply])
    refine hsum.congr_deriv ?_
    field_simp
    ring
  have h3 : HasDerivAt (fun s : ℝ => s ^ 3) (3 * R ^ 2) R := by
    simpa using hasDerivAt_pow 3 R
  have h4 : HasDerivAt (fun s : ℝ => 3 * j / (4 * s ^ 3)) (-(9 * j / (4 * R ^ 4))) R := by
    have h5 : HasDerivAt (fun s : ℝ => 4 * s ^ 3) (4 * (3 * R ^ 2)) R := h3.const_mul 4
    have hh := (hasDerivAt_const (x := R) (3 * j)).div h5 (by positivity)
    have hsum : HasDerivAt (fun s : ℝ => 3 * j / (4 * s ^ 3))
        ((0 * (4 * R ^ 3) - 3 * j * (4 * (3 * R ^ 2))) / (4 * R ^ 3) ^ 2) R := by
      convert hh using 1 <;> first | rfl | (funext y; simp [Pi.div_apply])
    refine hsum.congr_deriv ?_
    field_simp
    ring
  have hh := h2.sub h4
  have hsum : HasDerivAt (fun s : ℝ => j / s ^ 2 - 3 * j / (4 * s ^ 3))
      (-(2 * j / R ^ 3) - -(9 * j / (4 * R ^ 4))) R := by
    refine hh.congr_of_eventuallyEq ?_
    filter_upwards with s
    simp only [Pi.sub_apply]
  have hval : (-(2 * j / R ^ 3) - -(9 * j / (4 * R ^ 4)))
      = -(2 * j / R ^ 3) + 9 * j / (4 * R ^ 4) := by ring
  rw [hval] at hsum
  refine hsum.congr_of_eventuallyEq ?_
  filter_upwards with s
  exact vstar_anchor_eq

theorem deriv_vstar (j : ℝ) {R : ℝ} (hR : 3 < R) :
    deriv (vstar 3 1 j) R = -(2 * j / R ^ 3) + 9 * j / (4 * R ^ 4) :=
