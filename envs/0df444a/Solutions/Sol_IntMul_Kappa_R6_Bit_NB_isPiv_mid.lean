lemma isPiv_mid_sol_aux {m k : ℕ} (hk : 2 * k ≤ m) (p : Matrix (Fin m) (Fin m) K) (hp : p * p = p)
    (hrank : p.rank = m - k)
    (hC : (p.submatrix (fun l : Fin k => (⟨l.val, by omega⟩ : Fin m))
        (fun r : Fin k => (⟨m - k + r.val, by omega⟩ : Fin m))).det ≠ 0)
    {i : ℕ} (hi1 : k ≤ i) (hi2 : i < m - k) : IsPiv p i i := by
  have F := CornerLib.solution hk p hp hrank hC
  unfold IsPiv rk
  rw [F, F, F, F]
  set Cp := p.submatrix (fun l : Fin k => (⟨l.val, by omega⟩ : Fin m))
        (fun r : Fin k => (⟨m - k + r.val, by omega⟩ : Fin m)) with hCp
  have hc : ∀ X Y X' Y' : ℕ, k ≤ X → Y ≤ m - k → k ≤ X' → Y' ≤ m - k →
      (Cp.submatrix (fun l : {l : Fin k // l.val < X} => l.1)
        (fun r : {r : Fin k // Y ≤ m - k + r.val} => r.1)).rank =
      (Cp.submatrix (fun l : {l : Fin k // l.val < X'} => l.1)
        (fun r : {r : Fin k // Y' ≤ m - k + r.val} => r.1)).rank := by
    intro X Y X' Y' h1 h2 h3 h4
    apply RunsLib.RunsAux.rank_submatrix_range
    · ext x; simp only [Set.mem_range, Subtype.exists, exists_prop, exists_eq_right]
      have := x.isLt; omega
    · ext x; simp only [Set.mem_range, Subtype.exists, exists_prop, exists_eq_right]
      omega
  rw [hc (i + 1) (i + 1) i i (by omega) (by omega) (by omega) (by omega),
    hc i (i + 1) i i (by omega) (by omega) (by omega) (by omega),
    hc (i + 1) i i i (by omega) (by omega) (by omega) (by omega)]
  have z : ∀ X Y : ℕ, X ≤ Y →
      (Finset.univ.filter fun x : Fin m => k ≤ x.val ∧ x.val < m - k ∧ Y ≤ x.val ∧ x.val < X).card
        = 0 := by
    intro X Y hXY
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro x _ hx; omega
  have o : (Finset.univ.filter fun x : Fin m =>
      k ≤ x.val ∧ x.val < m - k ∧ i ≤ x.val ∧ x.val < i + 1).card = 1 := by
    rw [Finset.card_eq_one]
    refine ⟨⟨i, by omega⟩, ?_⟩
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · intro hx; ext; simp only; omega
    · rintro rfl; simp only; omega
  rw [o, z i (i + 1) (by omega), z i i le_rfl, z (i + 1) (i + 1) le_rfl]
  omega

