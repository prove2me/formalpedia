variable {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

private theorem summable_iteratedDeriv_apply_of_local_bound (f : ι → ℝ → E) (k : ℕ)
    (hM : ∀ R : ℝ, 0 ≤ R → ∃ M : ι → ℝ, Summable M ∧
      ∀ (i : ι) (y : ℝ), |y| ≤ R → ‖iteratedDeriv k (f i) y‖ ≤ M i)
    (y : ℝ) : Summable fun i => iteratedDeriv k (f i) y := by
  obtain ⟨M, hMs, hb⟩ := hM |y| (abs_nonneg y)
  exact Summable.of_norm_bounded hMs fun i => hb i y le_rfl

private theorem summableLocallyUniformlyOn_iteratedDerivWithin_univ (f : ι → ℝ → E) (k : ℕ)
    (hM : ∀ R : ℝ, 0 ≤ R → ∃ M : ι → ℝ, Summable M ∧
      ∀ (i : ι) (y : ℝ), |y| ≤ R → ‖iteratedDeriv k (f i) y‖ ≤ M i) :
    SummableLocallyUniformlyOn (fun i => iteratedDerivWithin k (f i) Set.univ) Set.univ := by
  refine SummableLocallyUniformlyOn_of_locally_bounded isOpen_univ fun K _ hK => ?_
  obtain ⟨r, hr⟩ := hK.isBounded.subset_closedBall 0
  obtain ⟨M, hMs, hb⟩ := hM (max r 0) (le_max_right _ _)
  refine ⟨M, hMs, fun i y hy => ?_⟩
  rw [iteratedDerivWithin_univ]
  refine hb i y ?_
  have h := hr hy
  rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs] at h
  exact h.trans (le_max_left _ _)

private theorem iteratedDeriv_tsum_of_local_bound (f : ι → ℝ → E) (hf : ∀ i, ContDiff ℝ ∞ (f i))
    (hM : ∀ (k : ℕ) (R : ℝ), 0 ≤ R → ∃ M : ι → ℝ, Summable M ∧
      ∀ (i : ι) (y : ℝ), |y| ≤ R → ‖iteratedDeriv k (f i) y‖ ≤ M i)
    (m : ℕ) (y : ℝ) :
    iteratedDeriv m (fun y => ∑' i, f i y) y = ∑' i, iteratedDeriv m (f i) y := by
  have h := iteratedDerivWithin_tsum (f := f) m isOpen_univ (Set.mem_univ y)
    (fun t _ => by
      simpa only [iteratedDeriv_zero] using summable_iteratedDeriv_apply_of_local_bound f 0 (hM 0) t)
