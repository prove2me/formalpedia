/-!
# Painlevé–Gullstrand ↔ Eddington–Finkelstein (same `ε`): the actual coordinate map on all of `domEF`

For `M ≥ 0`, `ε = ±1`, on the **whole** PG/EF domain `domEF = {r > 0, 0 < θ < π}` — the points
`r = 2M` (for `M > 0`) are *not* excluded — we prove:

* `pgToEF M ε : (T, r, θ, φ) ↦ (T + ε H_M(r), r, θ, φ)` and `pgFromEF M ε` are mutually inverse
  (globally), map `domEF` onto itself (`bijOn`), and are `C^∞` on `domEF`;
* `H_M' = 1/(1 + q)` with `q = √(2M/r)` (`hasDerivAt_HPG`), so the Jacobian of `pgToEF` is the
  explicit matrix `jac` with radial mixed entry `ε/(1 + q)` and `det jac = 1`; every entry is a
  genuine `HasDerivAt` (`hasDerivAt_pd_pgToEF`);
* pull-back identity `jacᵀ · (gEF ∘ pgToEF) · jac = gPG` on `domEF` (`pullback`);
* the same in the other direction (`pgFromEF`, `jacInv`, `pullback_inv`).

Bundled as `relation_toEF : CoordRelation (gPG M ε) (gEF M ε) domEF domEF …` and `relation_fromEF`.
At `r = 2M` (`M > 0`): `q = 1`, `H' = 1/2`, `jac 0 1 = ε/2`, `det = 1` — nothing degenerates
(`PGSpecial.horizon_data`). The primitive `H_M` is one choice; the literature's `T = t + …` differs
from `w − ε H_M` by an additive constant that depends on the normalisation of the EF time (with the
source convention `Schwarzschild.toEF` the constant is `0`; `mission/PHYSICS_BOUNDARY.md` E4), which
does not affect the relation.
No statement is made through the standard chart (where `r ≠ 2M` would be forced).
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.PG

variable (M ε : ℝ)

@[simp] theorem pgToEF_0 (x : Pt 4) : pgToEF M ε x 0 = x 0 + ε * HPG M (x 1) := rfl
@[simp] theorem pgToEF_1 (x : Pt 4) : pgToEF M ε x 1 = x 1 := rfl
@[simp] theorem pgToEF_2 (x : Pt 4) : pgToEF M ε x 2 = x 2 := rfl
@[simp] theorem pgToEF_3 (x : Pt 4) : pgToEF M ε x 3 = x 3 := rfl
@[simp] theorem pgFromEF_0 (y : Pt 4) : pgFromEF M ε y 0 = y 0 - ε * HPG M (y 1) := rfl
@[simp] theorem pgFromEF_1 (y : Pt 4) : pgFromEF M ε y 1 = y 1 := rfl
@[simp] theorem pgFromEF_2 (y : Pt 4) : pgFromEF M ε y 2 = y 2 := rfl
@[simp] theorem pgFromEF_3 (y : Pt 4) : pgFromEF M ε y 3 = y 3 := rfl

theorem pgFromEF_pgToEF (x : Pt 4) : pgFromEF M ε (pgToEF M ε x) = x := by
  funext i; fin_cases i <;> simp

theorem pgToEF_pgFromEF (y : Pt 4) : pgToEF M ε (pgFromEF M ε y) = y := by
  funext i; fin_cases i <;> simp

theorem pgToEF_mem {x : Pt 4} (hx : x ∈ domEF) : pgToEF M ε x ∈ domEF := by
  simpa [domEF] using hx

theorem pgFromEF_mem {y : Pt 4} (hy : y ∈ domEF) : pgFromEF M ε y ∈ domEF := by
  simpa [domEF] using hy

theorem bijOn_pgFromEF : Set.BijOn (pgFromEF M ε) domEF domEF :=
  Set.InvOn.bijOn ⟨fun y _ => pgToEF_pgFromEF M ε y, fun x _ => pgFromEF_pgToEF M ε x⟩
    (fun _ hy => pgFromEF_mem M ε hy) (fun _ hx => pgToEF_mem M ε hx)

/-! ### The primitive `H_M` -/

theorem contDiffOn_pgToEF (hM : 0 ≤ M) : ContDiffOn ℝ ∞ (pgToEF M ε) domEF := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, pgToEF_0,
    pgToEF_1, pgToEF_2, pgToEF_3, HPG] <;>
    fun_prop (disch := (intro x hx; have := domEF_r_pos hx; positivity))

theorem contDiffOn_pgFromEF (hM : 0 ≤ M) : ContDiffOn ℝ ∞ (pgFromEF M ε) domEF := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, pgFromEF_0,
    pgFromEF_1, pgFromEF_2, pgFromEF_3, HPG] <;>
    fun_prop (disch := (intro x hx; have := domEF_r_pos hx; positivity))

/-! ### Jacobians -/

theorem hasDerivAt_pgFromEF_0_r (hM : 0 ≤ M) {y : Pt 4} (hy : y ∈ domEF) :
    HasDerivAt (fun u => pgFromEF M ε (Function.update y 1 u) 0) (-ε / (1 + qf M (y 1))) (y 1) := by
  have h := ((hasDerivAt_HPG hM (domEF_r_pos hy)).const_mul ε).const_sub (y 0)
  have e : (fun u => pgFromEF M ε (Function.update y 1 u) 0) = fun u => y 0 - ε * HPG M u := by
    funext u; simp [Function.update_apply]
  rw [e]; exact h.congr_deriv (by ring)

theorem pd_pgFromEF (hM : 0 ≤ M) {y : Pt 4} (hy : y ∈ domEF) (k i : Fin 4) :
    pd i (fun z => pgFromEF M ε z k) y = jacInv M ε y k i := by
  fin_cases k <;> fin_cases i <;>
    first
    | exact (hasDerivAt_pgFromEF_0_r M ε hM hy).deriv.trans (by simp [jacInv])
    | simp [pd, jacInv, Function.update_apply]

theorem hasDerivAt_pd_pgFromEF (hM : 0 ≤ M) {y : Pt 4} (hy : y ∈ domEF) (k i : Fin 4) :
    HasDerivAt (fun u => pgFromEF M ε (Function.update y i u) k) (jacInv M ε y k i) (y i) := by
  rw [← pd_pgFromEF M ε hM hy k i]
  have hc : ContDiffOn ℝ ∞ (fun z => pgFromEF M ε z k) domEF :=
    (contDiffOn_pi.mp (contDiffOn_pgFromEF M ε hM)) k
  exact hasDerivAt_pd isOpen_domEF hc hy i

/-! ### Pull-back identities (on all of `domEF`, `r = 2M` included) -/

theorem pullback_inv (hM : 0 ≤ M) (hε : ε ^ 2 = 1) {y : Pt 4} (hy : y ∈ domEF) :
    (jacInv M ε y).transpose * metricMatrix (gPG M ε) (pgFromEF M ε y) * jacInv M ε y =
      metricMatrix (gEF M ε) y := by
  have hr := domEF_r hy
  have hrp := domEF_r_pos hy
  have hε' : ε * ε = 1 := by rw [← sq]; exact hε
  have hq := qf_sq hM hrp
  have hQ0 := qf_nonneg M (y 1)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, jacInv, metricMatrix, gEF, gPG] <;>
    (generalize qf M (y 1) = Q at hq hQ0 ⊢
     have h1Q : 1 + Q ≠ 0 := by positivity
     have hM' : M = Q ^ 2 * y 1 / 2 := by field_simp at hq; linarith
     subst hM'
     rcases mul_self_eq_one_iff.mp hε' with rfl | rfl <;>
       first | ring1 | (field_simp; ring1) | norm_num)

/-! ### Bundles -/

end ExactVacuumAtlas.Schwarzschild.PG

