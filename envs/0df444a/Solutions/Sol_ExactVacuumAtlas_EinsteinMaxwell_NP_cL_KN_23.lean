`[e_A, e_B]` for `(A, B) = (l, n), (l, m), (n, m), (m, m̄)` and the lowered commutator coefficients
`cL C A B = g(e_C, [e_A, e_B])` for these pairs (the remaining pairs follow from antisymmetry and the reality
relation `cL_swap`). Everything holds on IV's `domReg` for every real `M, a, Q`.

Notation in statements: `q = qK a x = r + i a cos θ`, `q̄ = qbarK a x`, `√2` is `((Real.sqrt 2 : ℝ) : ℂ)`.
-/

open Real Complex
open scoped ComplexConjugate
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN domReg domReg_S domReg_D domReg_s)

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

theorem qK_qrt (a : ℝ) (y : Pt 4) : qK a y = qrt a (y 1) (y 2) := qK_eq a y

/-! ### One-variable derivatives -/

section deriv

variable (M a Q : ℝ)

theorem hd_Del (u : ℝ) : HasDerivAt (fun u => Del M a Q u) (2 * u - 2 * M) u :=
  ((((hasDerivAt_pow 2 u).sub ((hasDerivAt_id' u).const_mul (2 * M))).add_const (a ^ 2)).add_const
    (Q ^ 2)).congr_deriv (by norm_num)

theorem hd_Sig_r (θ u : ℝ) : HasDerivAt (fun u => Sig a u θ) (2 * u) u :=
  ((hasDerivAt_pow 2 u).add_const (a ^ 2 * Real.cos θ ^ 2)).congr_deriv (by norm_num)

theorem hd_Sig_th (r t : ℝ) :
    HasDerivAt (fun t => Sig a r t) (-(2 * a ^ 2 * Real.cos t * Real.sin t)) t :=
  ((((Real.hasDerivAt_cos t).pow 2).const_mul (a ^ 2)).const_add (r ^ 2)).congr_deriv (by norm_num; ring)

theorem hd_q_r (θ u : ℝ) : HasDerivAt (fun u => qrt a u θ) 1 u :=
  ((hasDerivAt_id' u).ofReal_comp.add_const (I * ((a * Real.cos θ : ℝ) : ℂ))).congr_deriv (by simp)

theorem hd_q_th (r t : ℝ) : HasDerivAt (fun t => qrt a r t) (I * ((-(a * Real.sin t) : ℝ) : ℂ)) t :=
  (((((Real.hasDerivAt_cos t).const_mul a).ofReal_comp).const_mul I).const_add ((r : ℝ) : ℂ)).congr_deriv
    (by push_cast; ring)

variable {M a Q}

theorem hd_L0 {u : ℝ} (hD : Del M a Q u ≠ 0) :
    HasDerivAt (fun u : ℝ => (u ^ 2 + a ^ 2) / Del M a Q u)
      ((2 * u * Del M a Q u - (u ^ 2 + a ^ 2) * (2 * u - 2 * M)) / Del M a Q u ^ 2) u :=
  (((hasDerivAt_pow 2 u).add_const (a ^ 2)).div (hd_Del M a Q u) hD).congr_deriv (by norm_num)

theorem hd_L3 {u : ℝ} (hD : Del M a Q u ≠ 0) :
    HasDerivAt (fun u : ℝ => a / Del M a Q u) (-(a * (2 * u - 2 * M)) / Del M a Q u ^ 2) u :=
  ((hasDerivAt_const u a).div (hd_Del M a Q u) hD).congr_deriv (by ring)

theorem hd_N0_r {θ u : ℝ} (hS : Sig a u θ ≠ 0) :
    HasDerivAt (fun u : ℝ => (u ^ 2 + a ^ 2) / (2 * Sig a u θ))
      ((2 * u * (2 * Sig a u θ) - (u ^ 2 + a ^ 2) * (2 * (2 * u))) / (2 * Sig a u θ) ^ 2) u :=
  (((hasDerivAt_pow 2 u).add_const (a ^ 2)).div ((hd_Sig_r a θ u).const_mul 2)
    (mul_ne_zero two_ne_zero hS)).congr_deriv (by norm_num)

theorem hd_N1_r {θ u : ℝ} (hS : Sig a u θ ≠ 0) :
    HasDerivAt (fun u : ℝ => -Del M a Q u / (2 * Sig a u θ))
      ((-(2 * u - 2 * M) * (2 * Sig a u θ) - (-Del M a Q u) * (2 * (2 * u))) / (2 * Sig a u θ) ^ 2) u :=
  ((hd_Del M a Q u).neg.div ((hd_Sig_r a θ u).const_mul 2) (mul_ne_zero two_ne_zero hS)).congr_deriv rfl

theorem hd_N3_r {θ u : ℝ} (hS : Sig a u θ ≠ 0) :
    HasDerivAt (fun u : ℝ => a / (2 * Sig a u θ)) (-(a * (2 * (2 * u))) / (2 * Sig a u θ) ^ 2) u :=
  ((hasDerivAt_const u a).div ((hd_Sig_r a θ u).const_mul 2) (mul_ne_zero two_ne_zero hS)).congr_deriv
    (by ring)

theorem hd_N0_th {r t : ℝ} (hS : Sig a r t ≠ 0) :
    HasDerivAt (fun t : ℝ => (r ^ 2 + a ^ 2) / (2 * Sig a r t))
      (-((r ^ 2 + a ^ 2) * (2 * -(2 * a ^ 2 * Real.cos t * Real.sin t))) / (2 * Sig a r t) ^ 2) t :=
  ((hasDerivAt_const t (r ^ 2 + a ^ 2)).div ((hd_Sig_th a r t).const_mul 2)
    (mul_ne_zero two_ne_zero hS)).congr_deriv (by ring)

theorem hd_N1_th {r t : ℝ} (hS : Sig a r t ≠ 0) :
    HasDerivAt (fun t : ℝ => -Del M a Q r / (2 * Sig a r t))
      (-((-Del M a Q r) * (2 * -(2 * a ^ 2 * Real.cos t * Real.sin t))) / (2 * Sig a r t) ^ 2) t :=
  ((hasDerivAt_const t (-Del M a Q r)).div ((hd_Sig_th a r t).const_mul 2)
    (mul_ne_zero two_ne_zero hS)).congr_deriv (by ring)

theorem hd_N3_th {r t : ℝ} (hS : Sig a r t ≠ 0) :
    HasDerivAt (fun t : ℝ => a / (2 * Sig a r t))
      (-(a * (2 * -(2 * a ^ 2 * Real.cos t * Real.sin t))) / (2 * Sig a r t) ^ 2) t :=
  ((hasDerivAt_const t a).div ((hd_Sig_th a r t).const_mul 2) (mul_ne_zero two_ne_zero hS)).congr_deriv
    (by ring)

theorem hd_cm_r {θ u : ℝ} (k : ℂ) (hq : qrt a u θ ≠ 0) :
    HasDerivAt (fun u => k / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a u θ))
      (-(k * ((Real.sqrt 2 : ℝ) : ℂ)) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a u θ) ^ 2) u :=
  ((hasDerivAt_const u k).div ((hd_q_r a θ u).const_mul _) (mul_ne_zero sqrt2C_ne_zero hq)).congr_deriv
    (by ring)

theorem hd_M0_th {r t : ℝ} (hq : qrt a r t ≠ 0) :
    HasDerivAt (fun t => I * ((a * Real.sin t : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t))
      ((I * ((a * Real.cos t : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t)
        - I * ((a * Real.sin t : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin t) : ℝ) : ℂ))))
        / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t) ^ 2) t :=
  (((((Real.hasDerivAt_sin t).const_mul a).ofReal_comp).const_mul I).div ((hd_q_th a r t).const_mul _)
    (mul_ne_zero sqrt2C_ne_zero hq)).congr_deriv (by push_cast; ring)

theorem hd_M2_th {r t : ℝ} (hq : qrt a r t ≠ 0) :
    HasDerivAt (fun t => (1 : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t))
      (-(((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin t) : ℝ) : ℂ))) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t) ^ 2) t :=
  ((hasDerivAt_const t (1 : ℂ)).div ((hd_q_th a r t).const_mul _) (mul_ne_zero sqrt2C_ne_zero hq)).congr_deriv
    (by ring)

theorem hd_M3_th {r t : ℝ} (hq : qrt a r t ≠ 0) (hs : Real.sin t ≠ 0) :
    HasDerivAt (fun t => I * ((1 / Real.sin t : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t))
      ((I * ((-Real.cos t / Real.sin t ^ 2 : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t)
        - I * ((1 / Real.sin t : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin t) : ℝ) : ℂ))))
        / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r t) ^ 2) t := by
  have hsin : HasDerivAt (fun t => 1 / Real.sin t) (-Real.cos t / Real.sin t ^ 2) t := by
    have := (Real.hasDerivAt_sin t).inv hs
    simp only [one_div]
    exact this.congr_deriv (by ring)
  exact ((hsin.ofReal_comp.const_mul I).div ((hd_q_th a r t).const_mul _)
    (mul_ne_zero sqrt2C_ne_zero hq)).congr_deriv rfl

end deriv

/-! ### Frame components as functions of `(r, θ)` and their derivatives -/

section comps

variable {M a Q : ℝ} {x : Pt 4}

theorem knE_0_1 (M a Q : ℝ) (y : Pt 4) : knE M a Q 0 1 y = 1 := rfl
theorem knE_0_2 (M a Q : ℝ) (y : Pt 4) : knE M a Q 0 2 y = 0 := rfl
theorem knE_1_2 (M a Q : ℝ) (y : Pt 4) : knE M a Q 1 2 y = 0 := rfl
theorem knE_2_1 (M a Q : ℝ) (y : Pt 4) : knE M a Q 2 1 y = 0 := by
  simp [knE, knFrame, knM]
theorem knE_3_1 (M a Q : ℝ) (y : Pt 4) : knE M a Q 3 1 y = 0 := by
  simp [knE, knFrame, knMbar]

theorem knE_2_2 (M a Q : ℝ) (y : Pt 4) :
    knE M a Q 2 2 y = 1 / (((Real.sqrt 2 : ℝ) : ℂ) * qK a y) := by
  simp [knE, knFrame, knM]
theorem knE_3_2 (M a Q : ℝ) (y : Pt 4) :
    knE M a Q 3 2 y = 1 / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a y) := by
  simp [knE, knFrame, knMbar]

theorem knE_rt (M a Q : ℝ) (A μ : Fin 4) (y : Pt 4) :
    knE M a Q A μ y = knE M a Q A μ ![0, y 1, y 2, 0] := by
  fin_cases A <;> fin_cases μ <;> simp [knE, knFrame, knL, knN, knM, knMbar, qK, qbarK]

/-- Frame derivative of a field of `(r, θ)`: `D_A f = e_A^r ∂_r f + e_A^θ ∂_θ f`. -/
theorem fdir_KN_rt {F : ℝ → ℝ → ℂ} {f : Pt 4 → ℂ} (hf : ∀ y, f y = F (y 1) (y 2)) (A : Fin 4) (x : Pt 4) :
    fdir (knE M a Q) A f x = knE M a Q A 1 x * cpdC 1 f x + knE M a Q A 2 x * cpdC 2 f x := by
  simp only [fdir, Fin.sum_univ_four, cpdC_t hf, cpdC_ph hf]
  ring

theorem knE_hf (M a Q : ℝ) (A μ : Fin 4) :
    ∀ y, knE M a Q A μ y = (fun r θ => knE M a Q A μ ![0, r, θ, 0]) (y 1) (y 2) :=
  fun y => knE_rt M a Q A μ y

theorem fdir_KN (A B μ : Fin 4) (x : Pt 4) :
    fdir (knE M a Q) A (knE M a Q B μ) x
      = knE M a Q A 1 x * cpdC 1 (knE M a Q B μ) x + knE M a Q A 2 x * cpdC 2 (knE M a Q B μ) x :=
  fdir_KN_rt (F := fun r θ => knE M a Q B μ ![0, r, θ, 0]) (knE_hf M a Q B μ) A x

end comps

/-! ### Algebraic facts used by the closed-form computations -/

theorem kn_hq (a : ℝ) (x : Pt 4) : qK a x = ((x 1 : ℝ) : ℂ) + I * ((a : ℂ) * Complex.cos ((x 2 : ℝ) : ℂ)) := by
  rw [qK_eq]; push_cast; ring
theorem kn_hqb (a : ℝ) (x : Pt 4) : qbarK a x = ((x 1 : ℝ) : ℂ) - I * ((a : ℂ) * Complex.cos ((x 2 : ℝ) : ℂ)) := by
  rw [qbarK_eq]; push_cast; ring
theorem kn_hSg (a : ℝ) (x : Pt 4) : ((Sig a (x 1) (x 2) : ℝ) : ℂ)
    = ((x 1 : ℝ) : ℂ) ^ 2 + (a : ℂ) ^ 2 * Complex.cos ((x 2 : ℝ) : ℂ) ^ 2 := by
  simp only [Sig]; push_cast; ring
theorem kn_hDl (M a Q : ℝ) (x : Pt 4) : ((Del M a Q (x 1) : ℝ) : ℂ)
    = ((x 1 : ℝ) : ℂ) ^ 2 - 2 * (M : ℂ) * ((x 1 : ℝ) : ℂ) + (a : ℂ) ^ 2 + (Q : ℂ) ^ 2 := by
  simp only [Del]; push_cast; ring
theorem kn_hsc (x : Pt 4) : Complex.sin ((x 2 : ℝ) : ℂ) ^ 2 + Complex.cos ((x 2 : ℝ) : ℂ) ^ 2 = 1 :=
  Complex.sin_sq_add_cos_sq _
theorem kn_hr2 : ((Real.sqrt 2 : ℝ) : ℂ) ^ 2 = 2 := by
  rw [sq]; exact sqrt2C_mul_self
theorem kn_hs0 {M a Q : ℝ} {x : Pt 4} (hx : x ∈ domReg M a Q) : Complex.sin ((x 2 : ℝ) : ℂ) ≠ 0 := by
  rw [← Complex.ofReal_sin]; exact Complex.ofReal_ne_zero.mpr (domReg_s hx)



/-! ### Lowered frame covectors in closed form -/

section cov

variable {M a Q : ℝ} {x : Pt 4}

theorem knCov_swap (M a Q : ℝ) (C μ : Fin 4) (x : Pt 4) :
    knCov M a Q (swap23 C) μ x = conj (knCov M a Q C μ x) := by
  simp only [knCov, knE_swap, map_sum, map_mul, Complex.conj_ofReal]

theorem knCov_0 (hx : x ∈ domReg M a Q) : (knCov M a Q 0 0 x = -1) ∧
    (knCov M a Q 0 1 x = ((Sig a (x 1) (x 2) / Del M a Q (x 1) : ℝ) : ℂ)) ∧ (knCov M a Q 0 2 x = 0) ∧
    (knCov M a Q 0 3 x = ((a * Real.sin (x 2) ^ 2 : ℝ) : ℂ)) := by
  ( (
  have hq := kn_hq a x; have hqb := kn_hqb a x; have hSg := kn_hSg a x; have hDl := kn_hDl M a Q x
  have hsc := kn_hsc x; have hr2 := kn_hr2
  have hq0 : qK a x ≠ 0 := qK_ne_zero (domReg_S hx)
  have hqb0 : qbarK a x ≠ 0 := qbarK_ne_zero (domReg_S hx)
  have hs0 := kn_hs0 hx
  have hSg0 : ((Sig a (x 1) (x 2) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_S hx)
  have hDl0 : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_D hx)
  have hr0 : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := sqrt2C_ne_zero
  have hI := Complex.I_sq))
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · simp only [knCov, Fin.sum_univ_four, knE, knFrame, knL, gKN] <;> ( ((try simp) <;> (try push_cast) <;> (try field_simp) <;> (
  generalize Complex.cos ((x 2 : ℝ) : ℂ) = cc at *
  generalize Complex.sin ((x 2 : ℝ) : ℂ) = ss at *
  generalize ((Sig a (x 1) (x 2) : ℝ) : ℂ) = SS at *
  generalize ((Del M a Q (x 1) : ℝ) : ℂ) = DD at *
  generalize qK a x = qq at *
  generalize qbarK a x = qb at *
  generalize ((x 1 : ℝ) : ℂ) = rr at *
  generalize ((Real.sqrt 2 : ℝ) : ℂ) = s2_r05 at *
  generalize (a : ℂ) = aa at *
  generalize (M : ℂ) = mm at *
  generalize (Q : ℂ) = QQ at *
  grind (ringSteps := 2000000))))

theorem knCov_1 (hx : x ∈ domReg M a Q) :
    (knCov M a Q 1 0 x = ((-Del M a Q (x 1) / (2 * Sig a (x 1) (x 2)) : ℝ) : ℂ)) ∧
    (knCov M a Q 1 1 x = -1 / 2) ∧ (knCov M a Q 1 2 x = 0) ∧
    (knCov M a Q 1 3 x = ((a * Del M a Q (x 1) * Real.sin (x 2) ^ 2 / (2 * Sig a (x 1) (x 2)) : ℝ) : ℂ)) := by
  ( (
  have hq := kn_hq a x; have hqb := kn_hqb a x; have hSg := kn_hSg a x; have hDl := kn_hDl M a Q x
  have hsc := kn_hsc x; have hr2 := kn_hr2
  have hq0 : qK a x ≠ 0 := qK_ne_zero (domReg_S hx)
  have hqb0 : qbarK a x ≠ 0 := qbarK_ne_zero (domReg_S hx)
  have hs0 := kn_hs0 hx
  have hSg0 : ((Sig a (x 1) (x 2) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_S hx)
  have hDl0 : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_D hx)
  have hr0 : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := sqrt2C_ne_zero
  have hI := Complex.I_sq))
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · simp only [knCov, Fin.sum_univ_four, knE, knFrame, knN, gKN] <;> ( ((try simp) <;> (try push_cast) <;> (try field_simp) <;> (
  generalize Complex.cos ((x 2 : ℝ) : ℂ) = cc at *
  generalize Complex.sin ((x 2 : ℝ) : ℂ) = ss at *
  generalize ((Sig a (x 1) (x 2) : ℝ) : ℂ) = SS at *
  generalize ((Del M a Q (x 1) : ℝ) : ℂ) = DD at *
  generalize qK a x = qq at *
  generalize qbarK a x = qb at *
  generalize ((x 1 : ℝ) : ℂ) = rr at *
  generalize ((Real.sqrt 2 : ℝ) : ℂ) = s2_r05 at *
  generalize (a : ℂ) = aa at *
  generalize (M : ℂ) = mm at *
  generalize (Q : ℂ) = QQ at *
  grind (ringSteps := 2000000))))

theorem knCov_2 (hx : x ∈ domReg M a Q) :
    (knCov M a Q 2 0 x = -(I * ((a * Real.sin (x 2) : ℝ) : ℂ)) / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)) ∧
    (knCov M a Q 2 1 x = 0) ∧ (knCov M a Q 2 2 x = qbarK a x / ((Real.sqrt 2 : ℝ) : ℂ)) ∧
    (knCov M a Q 2 3 x = I * ((Real.sin (x 2) * (x 1 ^ 2 + a ^ 2) : ℝ) : ℂ)
      / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)) := by
  ( (
  have hq := kn_hq a x; have hqb := kn_hqb a x; have hSg := kn_hSg a x; have hDl := kn_hDl M a Q x
  have hsc := kn_hsc x; have hr2 := kn_hr2
  have hq0 : qK a x ≠ 0 := qK_ne_zero (domReg_S hx)
  have hqb0 : qbarK a x ≠ 0 := qbarK_ne_zero (domReg_S hx)
  have hs0 := kn_hs0 hx
  have hSg0 : ((Sig a (x 1) (x 2) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_S hx)
  have hDl0 : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_D hx)
  have hr0 : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := sqrt2C_ne_zero
  have hI := Complex.I_sq))
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · simp [knCov, Fin.sum_univ_four, knE, knFrame, knM, gKN] <;> ( ((try simp) <;> (try push_cast) <;> (try field_simp) <;> (
  generalize Complex.cos ((x 2 : ℝ) : ℂ) = cc at *
  generalize Complex.sin ((x 2 : ℝ) : ℂ) = ss at *
  generalize ((Sig a (x 1) (x 2) : ℝ) : ℂ) = SS at *
  generalize ((Del M a Q (x 1) : ℝ) : ℂ) = DD at *
  generalize qK a x = qq at *
  generalize qbarK a x = qb at *
  generalize ((x 1 : ℝ) : ℂ) = rr at *
  generalize ((Real.sqrt 2 : ℝ) : ℂ) = s2_r05 at *
  generalize (a : ℂ) = aa at *
  generalize (M : ℂ) = mm at *
  generalize (Q : ℂ) = QQ at *
  grind (ringSteps := 2000000))))

theorem knCov_3 (hx : x ∈ domReg M a Q) :
    (knCov M a Q 3 0 x = I * ((a * Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x)) ∧
    (knCov M a Q 3 1 x = 0) ∧ (knCov M a Q 3 2 x = qK a x / ((Real.sqrt 2 : ℝ) : ℂ)) ∧
    (knCov M a Q 3 3 x = -(I * ((Real.sin (x 2) * (x 1 ^ 2 + a ^ 2) : ℝ) : ℂ))
      / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x)) := by
  obtain ⟨h0, h1, h2, h3⟩ := knCov_2 hx
  have e : ∀ μ, knCov M a Q 3 μ x = conj (knCov M a Q 2 μ x) := fun μ => knCov_swap M a Q 2 μ x
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [e, h0]; simp [map_div₀, qK_conj]
  · rw [e, h1, map_zero]
  · rw [e, h2]; simp [map_div₀, qbarK_conj]
  · rw [e, h3]; simp [map_div₀, qK_conj]

end cov

/-! ### Derivatives of the frame components -/

section dcomp

variable {M a Q : ℝ} {x : Pt 4}

theorem qrt_ne_zero (hx : x ∈ domReg M a Q) : qrt a (x 1) (x 2) ≠ 0 := by
  rw [← qK_qrt]; exact qK_ne_zero (domReg_S hx)

theorem dE_const (M a Q : ℝ) (A μ i : Fin 4) (c : ℂ) (hc : ∀ y, knE M a Q A μ y = c) (x : Pt 4) :
    cpdC i (knE M a Q A μ) x = 0 := by
  have e : knE M a Q A μ = fun _ => c := funext hc
  rw [e]; exact cpdC_const c i x

theorem dE_0_0 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 0 0) x = (((2 * x 1 * Del M a Q (x 1) - (x 1 ^ 2 + a ^ 2) * (2 * x 1 - 2 * M))
      / Del M a Q (x 1) ^ 2 : ℝ) : ℂ) ∧ cpdC 2 (knE M a Q 0 0) x = 0 :=
  ⟨cpdC_r (F := fun r _ => (((r ^ 2 + a ^ 2) / Del M a Q r : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_L0 (domReg_D hx)).ofReal_comp,
   cpdC_th (F := fun r _ => (((r ^ 2 + a ^ 2) / Del M a Q r : ℝ) : ℂ)) (fun _ => rfl) x
    (hasDerivAt_const (x 2) _)⟩

theorem dE_0_3 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 0 3) x = ((-(a * (2 * x 1 - 2 * M)) / Del M a Q (x 1) ^ 2 : ℝ) : ℂ) ∧
      cpdC 2 (knE M a Q 0 3) x = 0 :=
  ⟨cpdC_r (F := fun r _ => ((a / Del M a Q r : ℝ) : ℂ)) (fun _ => rfl) x (hd_L3 (domReg_D hx)).ofReal_comp,
   cpdC_th (F := fun r _ => ((a / Del M a Q r : ℝ) : ℂ)) (fun _ => rfl) x (hasDerivAt_const (x 2) _)⟩

theorem dE_1_0 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 1 0) x = (((2 * x 1 * (2 * Sig a (x 1) (x 2)) - (x 1 ^ 2 + a ^ 2) * (2 * (2 * x 1)))
      / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) ∧
    cpdC 2 (knE M a Q 1 0) x = ((-((x 1 ^ 2 + a ^ 2) * (2 * -(2 * a ^ 2 * Real.cos (x 2) * Real.sin (x 2))))
      / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) :=
  ⟨cpdC_r (F := fun r θ => (((r ^ 2 + a ^ 2) / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N0_r (domReg_S hx)).ofReal_comp,
   cpdC_th (F := fun r θ => (((r ^ 2 + a ^ 2) / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N0_th (domReg_S hx)).ofReal_comp⟩

theorem dE_1_1 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 1 1) x = (((-(2 * x 1 - 2 * M) * (2 * Sig a (x 1) (x 2))
      - (-Del M a Q (x 1)) * (2 * (2 * x 1))) / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) ∧
    cpdC 2 (knE M a Q 1 1) x = ((-((-Del M a Q (x 1)) * (2 * -(2 * a ^ 2 * Real.cos (x 2) * Real.sin (x 2))))
      / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) :=
  ⟨cpdC_r (F := fun r θ => ((-Del M a Q r / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N1_r (domReg_S hx)).ofReal_comp,
   cpdC_th (F := fun r θ => ((-Del M a Q r / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N1_th (domReg_S hx)).ofReal_comp⟩

theorem dE_1_3 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 1 3) x = ((-(a * (2 * (2 * x 1))) / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) ∧
    cpdC 2 (knE M a Q 1 3) x = ((-(a * (2 * -(2 * a ^ 2 * Real.cos (x 2) * Real.sin (x 2))))
      / (2 * Sig a (x 1) (x 2)) ^ 2 : ℝ) : ℂ) :=
  ⟨cpdC_r (F := fun r θ => ((a / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N3_r (domReg_S hx)).ofReal_comp,
   cpdC_th (F := fun r θ => ((a / (2 * Sig a r θ) : ℝ) : ℂ)) (fun _ => rfl) x
    (hd_N3_th (domReg_S hx)).ofReal_comp⟩

theorem dE_2_0 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 2 0) x = -(I * ((a * Real.sin (x 2) : ℝ) : ℂ) * ((Real.sqrt 2 : ℝ) : ℂ))
      / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 ∧
    cpdC 2 (knE M a Q 2 0) x = (I * ((a * Real.cos (x 2) : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)
        - I * ((a * Real.sin (x 2) : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin (x 2)) : ℝ) : ℂ))))
        / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 := by
  have hf : ∀ y, knE M a Q 2 0 y = (fun r θ => I * ((a * Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ))
      (y 1) (y 2) := fun y => by simp [knE, knFrame, knM, qK_qrt]
  rw [qK_qrt]
  exact ⟨cpdC_r (F := fun r θ => I * ((a * Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_cm_r _ (qrt_ne_zero hx)), cpdC_th (F := fun r θ => I * ((a * Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_M0_th (qrt_ne_zero hx))⟩

theorem dE_2_2 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 2 2) x = -(1 * ((Real.sqrt 2 : ℝ) : ℂ)) / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 ∧
    cpdC 2 (knE M a Q 2 2) x = -(((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin (x 2)) : ℝ) : ℂ)))
      / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 := by
  have hf : ∀ y, knE M a Q 2 2 y = (fun r θ => (1 : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ))
      (y 1) (y 2) := fun y => by simp [knE, knFrame, knM, qK_qrt]
  rw [qK_qrt]
  exact ⟨cpdC_r (F := fun r θ => (1 : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_cm_r _ (qrt_ne_zero hx)), cpdC_th (F := fun r θ => (1 : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_M2_th (qrt_ne_zero hx))⟩

theorem dE_2_3 (hx : x ∈ domReg M a Q) :
    cpdC 1 (knE M a Q 2 3) x = -(I * ((1 / Real.sin (x 2) : ℝ) : ℂ) * ((Real.sqrt 2 : ℝ) : ℂ))
      / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 ∧
    cpdC 2 (knE M a Q 2 3) x = (I * ((-Real.cos (x 2) / Real.sin (x 2) ^ 2 : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * qK a x)
        - I * ((1 / Real.sin (x 2) : ℝ) : ℂ) * (((Real.sqrt 2 : ℝ) : ℂ) * (I * ((-(a * Real.sin (x 2)) : ℝ) : ℂ))))
        / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ^ 2 := by
  have hf : ∀ y, knE M a Q 2 3 y = (fun r θ => I * ((1 / Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ))
      (y 1) (y 2) := fun y => by simp [knE, knFrame, knM, qK_qrt]
  rw [qK_qrt]
  exact ⟨cpdC_r (F := fun r θ => I * ((1 / Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_cm_r _ (qrt_ne_zero hx)), cpdC_th (F := fun r θ => I * ((1 / Real.sin θ : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ)) hf x (hd_M3_th (qrt_ne_zero hx) (domReg_s hx))⟩

theorem dE_3 (M a Q : ℝ) (i μ : Fin 4) (x : Pt 4) :
    cpdC i (knE M a Q 3 μ) x = conj (cpdC i (knE M a Q 2 μ) x) := by
  have e : knE M a Q 3 μ = fun y => conj (knE M a Q 2 μ y) := funext fun y => knE_swap M a Q 2 μ y
  rw [e, cpdC_conj]

end dcomp

