    (g : A'.A ⟶ A.A) (hg : CategoryTheory.IsPullback g A'.f A.f (Spec.map (CommRingCat.ofHom φ)))
    (g_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P Q : SchemeHomOver t' A'.f),
      (A'.L.mul t' P Q).1 ≫ g =
        (A.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)

def gPt {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' A'.f) :
    SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) A.f :=
  ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩

include g_mul in
theorem gPt_mul {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P Q : SchemeHomOver t' A'.f) :
    gPt φ A A' g hg t' (A'.L.mul t' P Q) = A.L.mul _ (gPt φ A A' g hg t' P) (gPt φ A A' g hg t' Q) :=
  Subtype.ext (g_mul t' P Q)

include g_mul in
theorem gPt_one {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) :
    gPt φ A A' g hg t' (A'.L.one t') = A.L.one _ := by
  letI := A.L.pointGroup (t' ≫ Spec.map (CommRingCat.ofHom φ))
  have h : gPt φ A A' g hg t' (A'.L.one t') * gPt φ A A' g hg t' (A'.L.one t') = gPt φ A A' g hg t' (A'.L.one t') := by
    show A.L.mul _ _ _ = _
    rw [← gPt_mul φ A A' g hg g_mul, A'.L.one_mul]
  exact mul_eq_right.mp h

include g_mul in
theorem gPt_nsmulPt {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (n : ℕ) (P : SchemeHomOver t' A'.f) :
    gPt φ A A' g hg t' (nsmulPt A'.L t' n P) = nsmulPt A.L _ n (gPt φ A A' g hg t' P) := by
  induction n with
  | zero => exact gPt_one φ A A' g hg g_mul t'
  | succ n ih =>
    show gPt φ A A' g hg t' (A'.L.mul t' (nsmulPt A'.L t' n P) P) = A.L.mul _ (nsmulPt A.L _ n _) _
    rw [gPt_mul φ A A' g hg g_mul, ih]

end Push
