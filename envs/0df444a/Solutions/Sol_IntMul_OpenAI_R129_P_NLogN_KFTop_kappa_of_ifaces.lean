theorem bigSpec_of {E : ℕ} (ix : Ix (7 + E)) (extM : Fin E → IStmt HS (7 + E)) (bigE : Fin (7 + E))
    (hbig : kTable extM bigE = bigP ix) (N₁ : ℕ) (Tb : ℕ → ℕ)
    (H : ∀ n, N₁ ≤ n → ∃ (D : ℕ) (iS : ∀ i, NeZero (sBD n D i)) (iT : ∀ i, NeZero (tBD n D i)),
      ∀ Isym, ∃ C : BigCtx ix Isym extM n D, ∀ x y : List Bool, x.length = n →
        (IntMul.OpenAI.R129.P.NLogN.KFM.setC x y : ℝ) + kMul C + kFin C + 2 ≤ Tb n) :
    BigSpec (kTable extM) bigE N₁ Tb := by
  intro x y hxy hN
  obtain ⟨D, iS, iT, HC⟩ := H _ hN
  obtain ⟨C, hT⟩ := HC (inputCodes x y)
  obtain ⟨s', c, r, ho, hc⟩ := big_run C x y rfl hxy.symm
  refine ⟨s', c + 2, IRuns.call (by rw [hbig]; exact r), ho, ?_⟩
  have := hT x y rfl
  have h2 : ((c + 2 : ℕ) : ℝ) ≤ (Tb x.length : ℝ) := by push_cast; linarith
  exact_mod_cast h2

