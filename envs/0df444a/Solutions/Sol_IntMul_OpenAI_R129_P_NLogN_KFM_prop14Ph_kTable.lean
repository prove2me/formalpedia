variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
/-- `prop14Ph_complex_closed` for a given gate-class constant `A` (same proof). -/
theorem prop14Ph_closedA {A : ℕ} (hA : GClass P8Lift.complexIface A) :
    ∀ {K r Z : ℕ} {Ψ : ℕ → ℕ} {CR : ℝ},
    RowHyp Isym iprog K (100 ^ 3) r Z Ψ CR τ50 → 0 ≤ CR → 1 ≤ r → Monotone Ψ →
    (∀ v, Z + 2 ≤ Ψ v) → ∀ {P D S ρ : ℕ} (hρ : ρ < K), 1 ≤ S → 1 ≤ P → 1 ≤ D →
    zsz ((32 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z →
    ∃ (Cc : ℕ → IStmt HS Pp) (E dC : ℕ) (kC : ℕ → ℕ),
      E ≤ D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * ((Nat.log (100 ^ 3) D + 1) *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ Nat.log (100 ^ 3) D) ∧
      dC ≤ 2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2)) ∧
      (∀ w, (kC w : ℝ) ≤ (2 * ((((Nat.log (100 ^ 3) D + 1) * 100 ^ 3 : ℕ) : ℝ) *
          ((100000 + (Nat.log (100 ^ 3) D : ℝ) *
            (((P8Lift.sc + P8Lift.complexIface.net.length) * alN P8Lift.Wc A + 1 : ℕ) : ℝ) +
            (Nat.log (100 ^ 3) D : ℝ) *
              (2 * (((P8Lift.sc + P8Lift.complexIface.net.length : ℕ) : ℝ) * CR))) *
            (D : ℝ) ^ (Real.logb ((100 ^ 3 : ℕ) : ℝ) (Rb P8Lift.sc P8Lift.Wc (100 ^ 3) τ50))) + 1) + 1000000 * (((Nat.log (100 ^ 3) D * 71 : ℕ) : ℝ) + 2)) *
        ((vol (Butterfly.layerShape P K D S) : ℕ) : ℝ) *
        (Xf r Ψ (w + 2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 *
          (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
            NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2)) +
          20 * (Nat.log (100 ^ 3) D + 1) ^ 3 *
            NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2) +
          2) : ℝ)) ∧
      ∀ (st : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
        (xs : List (Fin r → ℂ)) (p w : ℕ), RecRep r p zs xs →
        xs.length = vol (Butterfly.layerShape P K D S) → f 0 = gflat zs ++ l → ClN f →
        NLogN.KFB.GB w zs → (∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) →
        ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
            (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) ∧
          NLogN.KFB.GB (p + 1) zs' ∧
          (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p
              (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs).length)
            (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
            ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p
              (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)[j] c -
              (Butterfly.layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
          IRuns Isym iprog (p14Ph P K D S ρ r E dC Cc w) (encK st f)
            (encK st (Function.update f 0 (gflat zs' ++ l)))
            (kC w + cWrapPh P K D S r E
              (zsz ((16 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w dC) := by
  intro K r Z Ψ CR hrow hCR hr hΨm hZΨ P D S ρ hρ hS hP hD hZ
  obtain ⟨Cc, E, dC, kC, H, hE, hdC, hk⟩ := cLayerT P8Lift.complexIface hA hrow hCR τ50_nonneg
    (by norm_num) (by norm_num) (by norm_num) hr hΨm hZΨ 71 (by norm_num) hρ hS hP hD hZ
  set L := P8Lift.complexIface.net.length
  set k := Nat.log (100 ^ 3) D
  set M : ℕ := 100 ^ 3
  set G := NLogN.KFN.Gb L P8Lift.sc P8Lift.Wc A
  have hEb := Eb_le L P8Lift.sc P8Lift.Wc A k
  have hDW := DWb_le L P8Lift.sc P8Lift.Wc A k
  have hWh := Whb_le L P8Lift.sc P8Lift.Wc A k
  refine ⟨Cc, E, dC, kC, ?_, ?_, fun w => ?_,
    fun st f zs l xs p w hx hl h0 hC hb hdisk =>
      p14Ph_iruns hρ hD hr hS hP H st f zs l xs hx hl h0 hC hb hdisk⟩
  · exact hE.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ hEb) _)
  · exact hdC.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ hDW) _)
  · refine (hk w).trans ?_
    have hcb := cb_le L P8Lift.sc P8Lift.Wc A M CR τ50 (by norm_num) hCR τ50_nonneg
      (by unfold τ50; have : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ 42 := by positivity
          linarith) k
    have hpow := pow_log_le M (by norm_num) (one_le_Rb P8Lift.sc P8Lift.Wc M τ50) D hD
    set lam := Real.logb (M : ℝ) (Rb P8Lift.sc P8Lift.Wc M τ50)
    set c0 : ℝ := 100000 + (k : ℝ) * (((P8Lift.sc + L) * alN P8Lift.Wc A + 1 : ℕ) : ℝ) +
      (k : ℝ) * (2 * (((P8Lift.sc + L : ℕ) : ℝ) * CR))
    have hc0 : 0 ≤ c0 := by positivity
    have hcb' : cb L P8Lift.sc P8Lift.Wc A M CR τ50 k ≤ c0 * (D : ℝ) ^ lam :=
      hcb.trans (mul_le_mul_of_nonneg_left hpow hc0)
    have hcoef : (2 * ((((k + 1) * M : ℕ) : ℝ) * cb L P8Lift.sc P8Lift.Wc A M CR τ50 k + 1) +
        1000000 * (((k * 71 : ℕ) : ℝ) + 2)) ≤
        (2 * ((((k + 1) * M : ℕ) : ℝ) * (c0 * (D : ℝ) ^ lam) + 1) +
          1000000 * (((k * 71 : ℕ) : ℝ) + 2)) := by
      have : (((k + 1) * M : ℕ) : ℝ) * cb L P8Lift.sc P8Lift.Wc A M CR τ50 k ≤
          (((k + 1) * M : ℕ) : ℝ) * (c0 * (D : ℝ) ^ lam) :=
        mul_le_mul_of_nonneg_left hcb' (by positivity)
      linarith
    have harg : w + 2 * D + (k + 1) * M * DWb L P8Lift.sc P8Lift.Wc A k +
        Whb L P8Lift.sc P8Lift.Wc A k + 2 ≤
        w + 2 * D + (k + 1) * M * (4 * (k + 1) ^ 2 * G ^ (k + 2)) +
          20 * (k + 1) ^ 3 * G ^ (k + 2) + 2 := by
      have := Nat.mul_le_mul_left ((k + 1) * M) hDW
      exact Nat.add_le_add_right (Nat.add_le_add (Nat.add_le_add_left this (w + 2 * D)) hWh) 2
    have hX : (Xf r Ψ (w + 2 * D + (k + 1) * M * DWb L P8Lift.sc P8Lift.Wc A k +
        Whb L P8Lift.sc P8Lift.Wc A k + 2) : ℝ) ≤
        (Xf r Ψ (w + 2 * D + (k + 1) * M * (4 * (k + 1) ^ 2 * G ^ (k + 2)) +
          20 * (k + 1) ^ 3 * G ^ (k + 2) + 2) : ℝ) := by
      exact_mod_cast Xf_mono hΨm harg
    have hcb0 := cb_nonneg (L := L) (s := P8Lift.sc) (W := P8Lift.Wc) (A := A) (m := M)
      (τ := τ50) hCR k
    apply mul_le_mul (mul_le_mul_of_nonneg_right hcoef (by positivity)) hX (by positivity)
      (by positivity)

end Closed

