  · simp

section read
variable {q x : Fin S} (hqx : q ≠ x) (stop : Sym) (Q : List Sym)

include hqx in
theorem read_reaches (σ : St S) : ∀ (W : List Sym) (t : Sym) (X : List Sym) (p : ℕ),
    t ≠ stop → stop ∉ W → (∀ k (hk : k < W.length), I.getD (p + k) codeEnd = W[k]) →
    I.getD (p + W.length) codeEnd = stop →
    Reaches I q [x] (readδ q x stop) (readCfg (q := q) (x := x) Q σ 1 (t :: X) p)
      (readCfg (q := q) (x := x) Q σ hlt (W.reverse ++ t :: X) (p + W.length + 1))
