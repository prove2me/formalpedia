-- Source module: Solutions.AModelL12Basic
/-!
# Lemma 12 (arbitrary-width interchange), generic array-model lemmas

1. `decode_append`, `encode_append_len`; `pull_prefix` (a pull acting only after a prefix does
   not see how the prefix is split into fields), `pull_blockSwap_prefix`.
2. Embedding a small shape into a pointwise larger one (`embed`, zero/default filled) and
   extracting back (`pull T S id`): `extract_pull_embed` — for every address map preserving
   the small-shape validity, embed → pull → extract = pull on the original.
   This is both the row padding `R → R'` and the binary padding `[2^u] → [q^e]`.
3. Adjacent block swaps compose (`blockSwap_blockSwap_adj`); a list of aligned pieces
   (`runPieces`) composes to the swap of the whole chunks (`runPieces_eq`).
4. Block rotation `rotIdx` (the joining moves) on lists, validity, inverse.
-/

namespace AModelL12

open AModel

/-! ## 1. Prefix transport -/

section Prefix

end Prefix

/-! ## 2. Embedding into a larger shape (padding) and extraction -/

section Embed

variable {α : Type*}

/-- `S` is pointwise at most `T` (same number of fields). -/
def ShapeLE (S T : Shape) : Prop :=
  S.length = T.length ∧ ∀ k (h₁ : k < S.length) (h₂ : k < T.length), S[k] ≤ T[k]

open Classical in
/-- Embed an array on `S` into the larger shape `T`: an entry at a `T`-address that is a valid
`S`-address is copied, every other entry is the default `d` (zero padding). -/
noncomputable def embed (S T : Shape) (d : α) (xs : List α) : List α :=
  (List.range (vol T)).map fun j =>
    if Valid S (decode T j) then xs.getD (encode S (decode T j)) d else d

/-- Extraction (scanning away the padding): the pull `T → S` by the identity address map. -/
def extract (S T : Shape) (d : α) (ys : List α) : List α := pull T S id d ys

end Embed

/-! ## 3. Pieces: adjacent block swaps compose -/

section Pieces

/-- Run piece operations: piece `t` has offset `o` (sum of the earlier widths) and width `w t`. -/
def runPieces {α β : Type*} (step : ℕ → β → List α → List α) (w : β → ℕ) :
    ℕ → List β → List α → List α
  | _, [], xs => xs
  | o, t :: ts, xs => runPieces step w (o + w t) ts (step o t xs)

end Pieces

/-! ## 4. Block rotation (the joining moves) -/

section Rotation

/-- Index map of the rotation `A ++ B ++ C ++ D ↦ A ++ C ++ B ++ D` with `|A| = s`, `|B| = b`,
`|C| = c` (digit `k` of the result is digit `rotIdx s b c k` of the input). -/
def rotIdx (s b c k : ℕ) : ℕ :=
  if s ≤ k ∧ k < s + c then k + b else if s + c ≤ k ∧ k < s + c + b then k - c else k

end Rotation

end AModelL12

end

