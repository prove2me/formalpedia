lemma Sapprox_congr (p s t α : ℕ) (hs : 0 < s) (U U' : ℕ → ℤ × ℤ) (h : ∀ j < s, U j = U' j) :
    Sapprox p s t α U = Sapprox p s t α U' := by
  funext k
  have e : ∀ j : ℤ, sTerm p s t α k U j = sTerm p s t α k U' j := by
    intro j
    have h1 : (j % (s : ℤ)).toNat < s := by
      have := Int.emod_lt_of_pos j (by exact_mod_cast hs : (0 : ℤ) < s)
      have := Int.emod_nonneg j (by exact_mod_cast hs.ne' : (s : ℤ) ≠ 0)
      omega
    simp only [sTerm, h _ h1]
  simp only [Sapprox, e]

/-- `B0P` reads its input only on `[0, t)`. -/
lemma B0P_congr (p s t α : ℕ) (ht : 0 < t) (U U' : ℕ → ℤ × ℤ) (h : ∀ j < t, U j = U' j) :
    B0P p s t α U = B0P p s t α U' := by
  have : NeZero t := ⟨by omega⟩
  have hc : IntMul.HvdH.cSel s t U = IntMul.HvdH.cSel s t U' := by
    funext l; simp only [IntMul.HvdH.cSel]; exact h _ (ZMod.val_lt _)
  funext l; simp only [B0P, B0approx, hc]

