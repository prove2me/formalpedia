-- title:
--   Eq. (4.6) — $\|y^k - y^\star\|^2 \le \|y^{k-1} - y^\star\|^2 - \beta\|X^k - X^\star\|_F^2$
-- statement:
--   Let $\tau>0$ and let $f_1,\dots,f_m$ be convex functions on $\mathbb R^{n_1\times n_2}$ such that $\mathcal F = (f_1,\dots,f_m)$ is Lipschitz in the sense of (4.2),
--   $$\|\mathcal F(X) - \mathcal F(Y)\| \le L\,\|X - Y\|_F\quad\text{for all } X, Y,$$
--   for a constant $L\ge 0$. Let $\beta>0$ and let the step sizes satisfy $2\delta_k - \delta_k^2L^2\ge\beta$ for all $k\ge 1$. Let $(X^k, y^k)$ be generated by iteration (3.5) from $y^0 = 0$, and let $(X^\star, y^\star)$ be a primal-dual optimal pair for (3.4). Then for every $k\ge 1$,
--   $$\|y^k - y^\star\|^2 \le \|y^{k-1} - y^\star\|^2 - \beta\,\|X^k - X^\star\|_F^2 .$$
--
--   This Fejér-type inequality shows that the dual iterates approach $y^\star$ monotonically and that the primal errors $\|X^k - X^\star\|_F^2$ are summable, which yields Theorem 4.4.
--
--   **Formalization Note** The paper's step $k$ is the Lean index `k + 1`. The paper derives the existence of such a $\beta$ from $0<\inf\delta_k\le\sup\delta_k<2/L^2$; here $\beta$ and the bound $2\delta_k - \delta_k^2L^2\ge\beta$ are hypotheses, and the bound implies $\delta_k>0$.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1970, proof of Theorem 4.4, Eq. (4.6); p. 1968, Eq. (4.2)

import Mathlib
import Definitions.Def_CaiCandesShen_GeneralConvex_Problem

namespace CaiCandesShen.GeneralConvex

/-- Eq. (4.6), proof of Theorem 4.4, p. 1970: let `𝓕` obey the Lipschitz bound (4.2) with
constant `L ≥ 0`, and let `β > 0` with `2δ_k - δ_k² L² ≥ β` for all `k ≥ 1`. Along a run of (3.5)
and for a primal-dual optimal pair `(X⋆, y⋆)` of (3.4), for every `k ≥ 1`,
`‖y^k - y⋆‖² ≤ ‖y^{k−1} - y⋆‖² - β ‖X^k - X⋆‖_F²`. Paper index `k` is `k + 1` here. -/
theorem fejer_inequality {n₁ n₂ m : ℕ} (τ : ℝ) (hτ : 0 < τ)
    (f : Fin m → Mat n₁ n₂ → ℝ) (hconv : ∀ i, ConvexOn ℝ Set.univ (f i))
    (L : ℝ) (hL0 : 0 ≤ L)
    (hL : ∀ X Y : Mat n₁ n₂, eucNorm (constraintMap f X - constraintMap f Y) ≤ L * frobNorm (X - Y))
    (δ : ℕ → ℝ) (β : ℝ) (hβ : 0 < β) (hδβ : ∀ k : ℕ, 1 ≤ k → β ≤ 2 * δ k - δ k ^ 2 * L ^ 2)
    (X : ℕ → Mat n₁ n₂) (y : ℕ → Fin m → ℝ) (hseq : IsGeneralSVTSeq τ f δ X y)
    (Xs : Mat n₁ n₂) (ys : Fin m → ℝ) (hopt : IsPrimalDualOptimal τ f Xs ys) :
    ∀ k : ℕ, eucNorm (y (k + 1) - ys) ^ 2 ≤
      eucNorm (y k - ys) ^ 2 - β * frobNorm (X (k + 1) - Xs) ^ 2 := by sorry

end CaiCandesShen.GeneralConvex
