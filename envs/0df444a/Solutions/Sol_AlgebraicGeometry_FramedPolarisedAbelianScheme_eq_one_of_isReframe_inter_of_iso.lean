theorem schrodMat_map {g : ℕ} (δ : Fin g → ℕ) (d : ℕ) {B S : Type} [CommRing B] [CommRing S] (φ : B →+* S) (ω : B)
    {n : ℕ} (e : Fin n ≃ ThetaLevel.HH δ) (z : ThetaLevel.Heis δ d) :
    (ThetaLevel.schrodMat δ d B ω e z).map φ = ThetaLevel.schrodMat δ d S (φ ω) e z := by
  ext i j
  simp only [Matrix.map_apply, ThetaLevel.schrodMat_apply, ThetaLevel.omegaPow]
  split_ifs
  · rw [map_pow]
  · rw [map_zero]

end FreeCL6

