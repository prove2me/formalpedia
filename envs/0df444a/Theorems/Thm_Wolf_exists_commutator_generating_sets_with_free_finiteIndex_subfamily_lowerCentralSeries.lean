-- url     : https://prove2.me/theorems/5e44bd3f-bdf4-46fa-a22e-92a6a7b20ab5
-- title:
--   Lemma 3.7, corrected: commutator generating sets adapted to the lower central series, with a free subfamily of finite index
-- statement:
--   Let $\Gamma$ be a group whose lower central series vanishes at step $s+1$,
--   $\Gamma_{s+1} = \{1\}$, and suppose $\Gamma/\Gamma_1$ is finitely generated. Then there are finite
--   families $T_k = (\tau_{k,1}, \ldots, \tau_{k,r_k})$ in $\Gamma_k$, one for every $k \ge 0$, such that:
--
--   (i) each quotient $\Gamma_k/\Gamma_{k+1}$ is finitely generated and abelian, the images of the
--   $\tau_{k,i}$ generate it, and some subfamily of those images is independent, consists of elements of
--   infinite order, and generates a subgroup of finite index — that is, it generates a free abelian
--   subgroup of full rank;
--
--   (ii) every $\tau_{k+1,l}$ is, as an element of $\Gamma$, the commutator
--   $\tau_{0,i}\,\tau_{k,j}\,\tau_{0,i}^{-1}\,\tau_{k,j}^{-1}$ of some $\tau_{0,i}$ and some $\tau_{k,j}$;
--
--   (iii) the $\tau_{0,i}$ generate $\Gamma$.
--
--   This differs from Wolf's Lemma 3.7 only in (i). Wolf asks that the images of **all** of $T_k$ be an
--   independent set of generators, i.e. that $\Gamma_k/\Gamma_{k+1}$ be the internal direct sum of the
--   cyclic subgroups they generate; together with (ii) that is false in general, and Wolf's version
--   is [Disproved on this platform](https://prove2.me/theorems/580e3dd9-5572-4766-9e32-b56f17f59c90).
--   Here the images are
--   only required to generate, and independence is asked of a subfamily, with its span of finite index.
--   That is the form the proof of Theorem 3.2 uses on p. 429, where $T_k$ is ordered so that its first
--   $n_k$ members generate a free abelian subgroup of rank $n_k$, of finite index $l_k$.
--
--   Independence of the subfamily $J$ is independence of the cyclic subgroups it generates, indexed by
--   $J$: each meets the subgroup generated by the others trivially. The commutator is written out as
--   $aba^{-1}b^{-1}$, the convention of the lower central series in the published bundle, with the
--   level-$0$ element on the left. The conclusions are required at every level $k$, including
--   $k > s$, where the factors are trivial. The group $\Gamma$ itself is not assumed finitely
--   generated; that follows from (iii).
-- source:
--   Wolf, J. A., Growth of finitely generated solvable groups and curvature of Riemannian manifolds, Journal of Differential Geometry 2 (1968) 421–446, https://doi.org/10.4310/jdg/1214428658, Lemma 3.7, p. 428, with condition (i) weakened to the form used in the proof of Theorem 3.2 on p. 429 (“Suppose $T_k$ to be ordered so that $\{\varphi_k(\tau_{k,1}), \ldots, \varphi_k(\tau_{k,n_k})\}$ generates a free abelian subgroup of rank $n_k$ in $\Gamma_k/\Gamma_{k+1}$”; “Then that free abelian group has some finite index $l_k$ in $\Gamma_k/\Gamma_{k+1}$”). Lemma 3.7 as printed is false when a factor $\Gamma_k/\Gamma_{k+1}$ has torsion

import Definitions.Def_MilnorWolf_Growth
import Mathlib

namespace Wolf

theorem exists_commutator_generating_sets_with_free_finiteIndex_subfamily_lowerCentralSeries
    {Γ : Type*} [Group Γ] (s : ℕ)
    (hs : MilnorWolf.lcs Γ (s + 1) = ⊥)
    (hfg : Group.FG (↥(MilnorWolf.lcs Γ 0) ⧸
      (MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0))) :
    ∃ (r : ℕ → ℕ) (τ : ∀ k, Fin (r k) → ↥(MilnorWolf.lcs Γ k)),
      (∀ k : ℕ,
        letI Q := ↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
          (MilnorWolf.lcs Γ k))
        Group.FG Q ∧ (∀ x y : Q, x * y = y * x) ∧
          (⨆ i : Fin (r k), Subgroup.zpowers
            (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
              (MilnorWolf.lcs Γ k)) (τ k i))) = ⊤ ∧
          ∃ J : Finset (Fin (r k)),
            iSupIndep (fun j : J => Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (∀ j ∈ J, ¬ IsOfFinOrder
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (⨆ j : J, Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))).FiniteIndex) ∧
      (∀ k : ℕ, ∀ l : Fin (r (k + 1)), ∃ (i : Fin (r 0)) (j : Fin (r k)),
        ((τ (k + 1) l : Γ)) =
          (τ 0 i : Γ) * (τ k j : Γ) * (τ 0 i : Γ)⁻¹ * (τ k j : Γ)⁻¹) ∧
      Subgroup.closure (Set.range fun i : Fin (r 0) => ((τ 0 i : Γ))) = ⊤ := by
  sorry

end Wolf
