theorem kMachine_at {P : ℕ} (F : Fin P → IStmt HS P) (pM bigE : Fin P) (N₁ n : ℕ) (T : ℝ)
    (h : ∀ x y : List Bool, x.length = n → y.length = n → ∃ s' c,
      IRuns (inputCodes x y) (topTable F (kmain pM bigE N₁)) (kmain pM bigE N₁)
        ⟨fun _ => [], 0, []⟩ s' c ∧ s'.out = bin (2 * n) (IntMul.val x * IntMul.val y) ∧ (2 * c + 1 : ℝ) ≤ T) :
    MultipliesAt (kMachine F pM bigE N₁) n T := by
  apply multipliesAt_of_iexec
  intro x y hx hy
  obtain ⟨s', c, ⟨c', hc', hE⟩, hout, hT⟩ := h x y hx hy
  refine ⟨s', c', hE, hout, ?_⟩
  have : (c' : ℝ) ≤ c := by exact_mod_cast hc'
  linarith

