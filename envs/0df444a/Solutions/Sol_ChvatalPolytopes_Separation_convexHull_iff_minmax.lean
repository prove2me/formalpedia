      have e : ∑ u, c u * x u = ∑ u, c u * x0 u - r * ∑ u, c u * y u := by
        simp only [x, Finset.mul_sum, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl; intro u _; ring
      rw [e] at h1
      have : r * (-(∑ u, c u * y u)) = M - ∑ u, c u * x0 u + 1 := by
        rw [hr, div_mul_cancel₀]; linarith
      change _ ≤ M at h1
      linarith

theorem chm_core {V : Type*} [Fintype V] {J : Type*} [Fintype J]
    (a : J → V → ℝ) (b : J → ℝ) (S : Finset (V → ℝ)) (hS : S.Nonempty)
    (hSsol : ∀ x ∈ S, (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i) :
    {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = convexHull ℝ (S : Set (V → ℝ)) ↔
      ∀ c : V → ℤ,
        (∀ lam : J → ℝ, (∀ i, 0 ≤ lam i) → (∀ u, (c u : ℝ) ≤ ∑ i, lam i * a i u) →
          S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u) ≤ ∑ i, lam i * b i) ∧
        (∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, (c u : ℝ) ≤ ∑ i, lam i * a i u) ∧
          ∑ i, lam i * b i = S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u)) := by
  classical
  constructor
  · intro hP c
    refine ⟨fun lam hl0 hl => ?_, ?_⟩
    · apply Finset.sup'_le
      intro x hx
      exact chm_weak a b _ x (hSsol x hx).1 (hSsol x hx).2 lam hl0 hl
    · obtain ⟨lam, h0, h1, h2⟩ := chm_dual a b S hS hP (fun u => (c u : ℝ))
      refine ⟨lam, h0, h1, le_antisymm h2 ?_⟩
      apply Finset.sup'_le
      intro x hx
      exact chm_weak a b _ x (hSsol x hx).1 (hSsol x hx).2 lam h0 h1
  · intro H
    apply Set.Subset.antisymm
    · intro z hz
      by_contra hzn
      have hclosed : IsClosed (convexHull ℝ (S : Set (V → ℝ))) :=
        (S.finite_toSet.isCompact_convexHull (𝕜 := ℝ)).isClosed
      obtain ⟨f, u0, hfS, hfz⟩ :=
        geometric_hahn_banach_closed_point (convex_convexHull ℝ _) hclosed hzn
      set d : V → ℝ := fun u => f (fun j => if u = j then 1 else 0) with hd
      have hf : ∀ w, f w = ∑ u, w u * d u := by
        intro w
        have := f.toLinearMap.pi_apply_eq_sum_univ w
        simpa [smul_eq_mul] using this
      set B := ∑ x ∈ S, ∑ u, |z u - x u| with hB
      have hgap : 0 < f z - u0 := by linarith
      obtain ⟨N, hN⟩ := exists_nat_gt (B / (f z - u0))
      rw [div_lt_iff₀ hgap] at hN
      set c : V → ℤ := fun u => ⌊(N : ℝ) * d u⌋ with hc
      have key : ∀ x ∈ S, ∑ u, (c u : ℝ) * x u < ∑ u, (c u : ℝ) * z u := by
        intro x hx
        have hfx : f x < u0 := hfS x (subset_convexHull ℝ _ (Finset.mem_coe.2 hx))
        have hcoord : ∀ u, (N : ℝ) * d u * (z u - x u) - |z u - x u| ≤
            (c u : ℝ) * (z u - x u) := by
          intro u
          have h1 := Int.floor_le ((N : ℝ) * d u)
          have h2 := Int.lt_floor_add_one ((N : ℝ) * d u)
          have hcu : (c u : ℝ) = (⌊(N : ℝ) * d u⌋ : ℝ) := rfl
          rcases le_or_gt 0 (z u - x u) with hw | hw
          · rw [abs_of_nonneg hw]; rw [hcu]; nlinarith
          · rw [abs_of_neg hw]; rw [hcu]; nlinarith
        have hsum := Finset.sum_le_sum (fun u (_ : u ∈ Finset.univ) => hcoord u)
        rw [Finset.sum_sub_distrib] at hsum
        have hBx : ∑ u, |z u - x u| ≤ B :=
          Finset.single_le_sum (f := fun x => ∑ u, |z u - x u|)
            (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) hx
        have e1 : ∑ u, (N : ℝ) * d u * (z u - x u) = (N : ℝ) * (f z - f x) := by
          rw [hf z, hf x, ← Finset.sum_sub_distrib, Finset.mul_sum]
          apply Finset.sum_congr rfl; intro u _; ring
        have e2 : ∑ u, (c u : ℝ) * (z u - x u) = ∑ u, (c u : ℝ) * z u - ∑ u, (c u : ℝ) * x u := by
          rw [← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl; intro u _; ring
        rw [e1] at hsum
        rw [e2] at hsum
        have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg N
        have : (N : ℝ) * (f z - u0) ≤ (N : ℝ) * (f z - f x) :=
          mul_le_mul_of_nonneg_left (by linarith) hN0
        linarith
      obtain ⟨_, lam, hl0, hl, heq⟩ := H c
      have hw := chm_weak a b _ z hz.1 hz.2 lam hl0 hl
      have hlt : S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u) < ∑ u, (c u : ℝ) * z u :=
        (Finset.sup'_lt_iff hS).2 key
      linarith
    · apply convexHull_min
      · intro x hx
        exact hSsol x (Finset.mem_coe.1 hx)
      · rintro y ⟨hy0, hy1⟩ z ⟨hz0, hz1⟩ p q hp hq hpq
        refine ⟨fun u => ?_, fun i => ?_⟩
        · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          have := hy0 u; have := hz0 u; positivity
        · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
          have e1 : ∑ u, a i u * (p * y u) = p * ∑ u, a i u * y u := by
            rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
          have e2 : ∑ u, a i u * (q * z u) = q * ∑ u, a i u * z u := by
            rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
          rw [e1, e2]
          have := mul_le_mul_of_nonneg_left (hy1 i) hp
          have := mul_le_mul_of_nonneg_left (hz1 i) hq
          have : b i = p * b i + q * b i := by rw [← add_mul, hpq, one_mul]
          linarith

end ChvatalPolytopes.Separation

open ChvatalPolytopes.Separation
open ChvatalPolytopes ChvatalPolytopes.Separation

theorem solution {V : Type*} [Fintype V] {J : Type*} [Fintype J]
    (a : J → V → ℝ) (b : J → ℝ) (S : Finset (V → ℝ)) (hS : S.Nonempty)
    (hSsol : ∀ x ∈ S, (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i) :
    {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = convexHull ℝ (S : Set (V → ℝ)) ↔
      ∀ c : V → ℤ,
        (∀ lam : J → ℝ, (∀ i, 0 ≤ lam i) → (∀ u, (c u : ℝ) ≤ ∑ i, lam i * a i u) →
          S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u) ≤ ∑ i, lam i * b i) ∧
        (∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, (c u : ℝ) ≤ ∑ i, lam i * a i u) ∧
          ∑ i, lam i * b i = S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u)) := by
  exact chm_core a b S hS hSsol
