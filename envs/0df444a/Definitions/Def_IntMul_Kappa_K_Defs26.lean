-- Source module: Solutions.KFY7Pro
/-!
# KFY 7: the prologue of the line passes

The line-map descriptor `[p, α, h, d, b_0..b_{d−1}, s_0..s_{d−1}]` (top first) lies on the
descriptor stack `dS = 26`. The prologue `proP` takes `p, α, ℓ = h + 1, d` into registers
(`yP = 11`, `yA = 12`, KFM's `zEl = 29`, `zD = 25`), counts the zero bits into `d'` (KFM's
`zDp = 31`, the bits are `[d' ≤ j]`), and pushes `L = dℓ − d'` (`yL = 13`, the base-2 logarithm
of the array length). The sources stay on `dS` (**`proP_all`**).

All registers are pushed above the unknown contents of their stacks.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN

abbrev dS : Fin HS := 26
abbrev yP : Fin HS := 11
abbrev yA : Fin HS := 12
abbrev yL : Fin HS := 13
abbrev yW : Fin HS := 14
abbrev yS : Fin HS := 15

/-! ## Generic facts -/

/-- `run`, `ok` and a cost bound of an `RS` program. -/
def RSAll (P : RS) (s t : IState HS) (C : ℕ) : Prop := P.ok s ∧ P.run s = t ∧ P.cost s ≤ C

/-! ## Taking a descriptor entry -/

/-- Push `e` on `r`, pop the descriptor stack. -/
def takeD (r : Fin HS) (e : Ex HS) : RS := .seq (.push r e) (.pop NLogN.KFY.dS)

/-! ## Counting the zero bits -/

/-- The bits `[d' ≤ j]`, `j < d`. -/
def bitL (d d' : ℕ) : List ℤ := (List.range d).map fun j => if d' ≤ j then 1 else 0

/-- One bit: `d' += 1 − b`, drop `b`. -/
def dpB : RS :=
  .seq (.asg KFM.zDp (.add (.reg KFM.zDp) (.add (.lit 1) (.neg (.reg NLogN.KFY.dS))))) (.pop NLogN.KFY.dS)

def dpLoop : RS := .rep KFM.mOc (.reg KFM.zD) dpB

/-- The state of the bit loop after `k` bits. -/
def dpSt (t : IState HS) (d d' : ℕ) (srcs : List ℤ) (R LZ : List Item) (k : ℕ) : IState HS :=
  (t.upd NLogN.KFY.dS (ints ((bitL d d').drop k ++ srcs) ++ R)).upd KFM.zDp (.int (min k d' : ℕ) :: LZ)

/-! ## The prologue -/

/-- `L = dℓ − d'`. -/
def lE : Ex HS := .add (.mul (.reg KFM.zD) (.reg KFM.zEl)) (.neg (.reg KFM.zDp))

def proP : RS :=
  .seq (takeD NLogN.KFY.yP (.reg NLogN.KFY.dS)) (.seq (takeD yA (.reg NLogN.KFY.dS)) (.seq (takeD KFM.zEl (.add (.reg NLogN.KFY.dS) (.lit 1)))
    (.seq (takeD KFM.zD (.reg NLogN.KFY.dS)) (.seq (.push KFM.zDp (.lit 0)) (.seq dpLoop (.push yL lE))))))

/-- The state after the prologue. -/
def proSt (t : IState HS) (p α h d d' : ℕ) (srcs : List ℤ) (R : List Item) : IState HS :=
  ((((((t.upd NLogN.KFY.dS (ints srcs ++ R)).upd NLogN.KFY.yP (.int p :: t.G NLogN.KFY.yP)).upd yA (.int α :: t.G yA)).upd
    KFM.zEl (.int ((h + 1 : ℕ) : ℤ) :: t.G KFM.zEl)).upd KFM.zD (.int d :: t.G KFM.zD)).upd
    KFM.zDp (.int d' :: t.G KFM.zDp)).upd yL (.int ((d * (h + 1) - d' : ℕ) : ℤ) :: t.G yL)

/-- The cost bound of the prologue. -/
def proC (d B : ℕ) : ℕ := (d + 20) * (20 * 10 ^ 7 * (B + 2) ^ 2)

end NLogN.KFY

end

section
-- Source module: Solutions.KFY8Wid
/-!
# KFY 8: the widths `sWidth p α = ⌈√p⌉ α` and `eWidth p α = ⌈(⌈√p⌉ + α − 1)/α⌉ + 1`

`⌈√p⌉ = #{x ∈ [1, p] : (x − 1)² < p}` (KFMS2's counting loop `cntP`, counter `sI = 20`),
then one assignment. The result is pushed on `yW = 14` (**`wA_all`**, **`wB_all`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN
open IntMul.HvdH (ceilSqrt)

/-- The test `(x − 1)² − p` for `x` on `sI`. -/
def sqT : Ex HS :=
  .add (.mul (.add (.reg KFM.sI) (.lit (-1))) (.add (.reg KFM.sI) (.lit (-1)))) (.neg (.reg NLogN.KFY.yP))

/-- `⌈√p⌉` on `yW`. -/
def csP : RS := KFM.cntP (.reg NLogN.KFY.yP) sqT NLogN.KFY.yW

/-- `sWidth`: `⌈√p⌉ α`. -/
def wA : RS := .seq csP (.asg NLogN.KFY.yW (.mul (.reg NLogN.KFY.yW) (.reg yA)))

/-- `eWidth`: `(⌈√p⌉ + α − 1)/α + 1`. -/
def wB : RS :=
  .seq csP (.asg NLogN.KFY.yW (.add (.ndiv (.add (.reg NLogN.KFY.yW) (.add (.reg yA) (.lit (-1)))) (.reg yA)) (.lit 1)))

end NLogN.KFY

end

section
-- Source module: Solutions.KFY9Epi
/-!
# KFY 9: the epilogue of the line passes

After the axis loop the sources lie reversed on `yS`; the epilogue moves them back to `dS`,
pushes the bits `[d' ≤ j]` (KFMSB `bitP`), `d`, `h = ℓ − 1`, `α`, `p` on `dS` (restoring the
line-map descriptor) and pops the registers `yW, yL, zDp, zD, zEl, yA, yP` (**`epiP_all`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN

/-- The registers of the passes (popped by the epilogue). -/
def regsP : List (Fin HS) := [NLogN.KFY.yW, yL, KFM.zDp, KFM.zD, KFM.zEl, yA, NLogN.KFY.yP]

def epiP : RS :=
  .seq (mvList yS NLogN.KFY.dS KFM.mOc (.reg KFM.zD)) (.seq (KFM.bitP NLogN.KFY.dS) (.seq (.push NLogN.KFY.dS (.reg KFM.zD))
    (.seq (.push NLogN.KFY.dS KFM.hE) (.seq (.push NLogN.KFY.dS (.reg yA)) (.seq (.push NLogN.KFY.dS (.reg NLogN.KFY.yP))
      (popL regsP))))))

/-- The descriptor `[p, α, h, d, bits, sources]`. -/
def descL (p α h d d' : ℕ) (srcs : List ℤ) : List ℤ :=
  (p : ℤ) :: (α : ℤ) :: (h : ℤ) :: (d : ℤ) :: (bitL d d' ++ srcs)

/-- The state after the epilogue. -/
def epiSt (v : IState HS) (LS : List Item) (D : List ℤ) (R : List Item) : IState HS :=
  { v with G := fun j => if j ∈ regsP then (v.G j).tail else if j = yS then LS else
      if j = NLogN.KFY.dS then ints D ++ R else v.G j }

/-- The cost bound of the epilogue. -/
def epiC (d B : ℕ) : ℕ := (d + 10) * (30 * 10 ^ 7 * (B + 2) ^ 2)

end NLogN.KFY

end

section
-- Source module: Solutions.KFY4Sap
/-!
# KFY 4: the `A` line pass on one axis (`sapAxQ`)

nlogn's `sapAxP` (`HAx4`) with two changes:

* no transposition prelude (`coreQ` instead of `GL.axisP`): the slices are the consecutive
  slices of the array on `gD` (the rotation is done before, by `TransNeed`);
* padded slices: every slice has length `t` (the padded axis) and only its first `s` entries
  are read (`padIn`, through stack `41`, counter `47`); the slice map is
  `x ↦ sapL p s t α (x.take s)` (length `t`).

**`sapAxQ_all`**: on `gD = gints L ++ R`, `L.length = m t`, it computes
`gints ((chunkL t L).flatMap (sapL p s t α ∘ take s)) ++ R`; every other stack is restored.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- The axis core, written out. -/
def sapCoreQ : RM :=
  .seq (.rep gCC (.reg aM) (RM.seqL [.rs (mvList NLogN.GL.gD gZT gCV (cnt2 aT)),
      .rs (mvList gZT aI gCV (cnt2 aT)), padInP aI 41 47 NLogN.AX.aS aT sapSlP,
      .rs (mvList aO gZB gCV (cnt2 aT))]))
    (.rs (mvList gZB NLogN.GL.gD gCV (cnt2 aTot)))

/-- **The padded `S̃` axis program.** -/
def sapAxQ : RM :=
  RM.seqL [.rs sTabR, .rs dTabR, sapCoreQ, .rs (popK aW gCC (.reg aNW)),
    .rs (popK NLogN.AX.aD gCC (.reg aT))]

/-- The scalar registers read by `sapAxQ`. -/
structure SapRegsQ (p s t α m : ℕ) (st : IState HS) : Prop where
  tab : STabRegs p s t α st
  rKa : ∃ L, st.G aKa = .int (sOff s (HvdH.sWidth p α) : ℤ) :: L
  rKN : ∃ L, st.G aKN = .int ((s + (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: L
  rR : ∃ L, st.G aR = .int (2 ^ (2 * p)) :: L
  rNW : ∃ L, st.G aNW = .int ((t * (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: L
  rM : ∃ L, st.G aM = .int (m : ℤ) :: L
  rTot : ∃ L, st.G aTot = .int ((m * t : ℕ) : ℤ) :: L

/-- Cost bound of `sapAxQ`. -/
def sapAxCostQ (p s t α m mm Φ Bacc Q Bq : ℕ) : ℕ :=
  tabCost (2 * HvdH.sWidth p α + 1) t (sWCost p Bq) +
    (tabCost 1 t (40 * 10 ^ 7 * (Bq + 2) ^ 2) + 10 ^ 9) +
    (m * (sapSlC p s t α mm Φ Bacc Q + 100000 * (t + 1) * (Q + 2) +
      100000 * (t + t + 1) * (Q + 2)) + 100000 * (m * t + 1) * (Q + 2)) +
    (2 * 2000 * (Bq + 2) + t * (2 * HvdH.sWidth p α + 1) * (12000 * (Bq + 2)) + 32) +
    (2 * 2000 * (Bq + 2) + t * (12000 * (Bq + 2)) + 32)

/-- The output of the padded `S̃` axis. -/
def sapOutQ (p s t α : ℕ) (L : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (chunkL t L).flatMap fun x => sapL p s t α (x.take s)

end NLogN.KFY

end

section
-- Source module: Solutions.KFY10Iter
/-!
# KFY 10: `tensorGo` as an iteration over rotated shapes

`stepL R f L`: transpose the head axis of the shape `R` to the end (`transposeL`), apply `f` to
the consecutive lines. `iterL dims fs k` applies the steps for the rotations `dims.rotate j`,
`j < k`. **`tensorGo_iterL`**: `tensorGo` of the list `(dims_i, fs i)_i` is `iterL dims fs d`.

Also the rotated padded shapes: **`shPad_bsN`**: `shPad (ℓ − 1) (bsN n k)` is the box
`tB n` rotated by `k` (the shape `TransNeed` sees at step `k`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFY

open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP
open KFB (GI gflat)

/-- One step of the pass over the shape `R`. -/
def stepL (R : List ℕ) (f : List GI → List GI) (L : List GI) : List GI :=
  (chunkL (R.headD 1) (transposeL (R.headD 1) R.tail.prod L)).flatMap f

/-- The first `k` steps over the rotations of `dims`. -/
def iterL (dims : List ℕ) (fs : ℕ → List GI → List GI) : ℕ → List GI → List GI
  | 0, L => L
  | k + 1, L => stepL (dims.rotate k) (fs k) (iterL dims fs k L)

/-- The map list of a pass. -/
def mapsL (dims : List ℕ) (fs : ℕ → List GI → List GI) : List (ℕ × (List GI → List GI)) :=
  (List.range dims.length).map fun i => (dims.getD i 1, fs i)

/-! ## Lengths and bounds along the iteration -/

/-! ## The rotated padded shapes -/

end NLogN.KFY

end

section
-- Source module: Solutions.KFY11Facts
/-!
# KFY 11: size facts of the padded box

* `2 ≤ ℓ`, `d' < d`, `dℓ − d' = L`;
* **`prod_tB`**: `∏ t_i = 2^L` (`= TP n`);
* the head and the tail product of the rotated box (`t_k`, `2^{L − log t_k}`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFY

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP NLogN.KFM

/-- The bit of axis `j`. -/
noncomputable def bN (n j : ℕ) : ℕ := if dpN n ≤ j then 1 else 0

end NLogN.KFY

end

section
-- Source module: Solutions.KFY12AxA
/-!
# KFY 12: one axis of the `A` pass

`axA X Kc` (one iteration of the axis loop, counter `cX = 55` holding `d − k`):

1. `takeD yS (reg dS)`: move `s_k` from the descriptor stack to `yS`;
2. push `b_k = [d' ≤ k]` (`yB`), then `t_k = 2^{ℓ−1+b_k}` (`yT`), `m_k = 2^{L−ℓ+1−b_k}` (`yM`);
3. push `w = p + 2` (`zw`) and `k` (`zm`), rotate (`trBlk`: `TransNeed`'s axis rotation of the
   box `t` rotated by `k`), pop;
4. push the registers of `sapAxQ` (`regsA`), run `sapAxQ` (the padded `S̃` on the `m_k`
   consecutive lines of length `t_k`), pop.

**`axA_all`**: the array `X` on stack `0` becomes `stepL R_k (sapL p s_k t_k α) X` with
`R_k = (ofFn t).rotate k`; `s_k` moves from `dS` to `yS`; nothing else changes.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
open NLogN.KFM (shPad bsN)

abbrev yB : Fin HS := 16
abbrev yT : Fin HS := 18
abbrev yM : Fin HS := 19
abbrev zw : Fin HS := 22
abbrev zm : Fin HS := 23
/-- The axis counter. -/
abbrev cX : Fin HS := 55

/-- `k = d − (d − k)`. -/
def kE : Ex HS := .add (.reg KFM.zD) (.neg (.reg cX))
/-- `b_k = [d' ≤ k]`. -/
def bitE : Ex HS := .sel (.add kE (.neg (.reg KFM.zDp))) (.lit 0) (.lit 1)
/-- `t_k = 2^{ℓ − 1 + b_k}`. -/
def tE : Ex HS := .pow2 (.add (.add (.reg KFM.zEl) (.lit (-1))) (.reg NLogN.KFY.yB))
/-- `m_k = 2^{L − ℓ + 1 − b_k}`. -/
def mE : Ex HS :=
  .pow2 (.add (.add (.reg yL) (.neg (.reg KFM.zEl))) (.add (.lit 1) (.neg (.reg NLogN.KFY.yB))))
/-- `w = p + 2`. -/
def wE : Ex HS := .add (.reg NLogN.KFY.yP) (.lit 2)

/-- `2 W + 1` from `yW`. -/
def nrE : Ex HS := .add (.add (.reg NLogN.KFY.yW) (.reg NLogN.KFY.yW)) (.lit 1)

/-- The registers of `sapAxQ`. -/
def regsA : List (Fin HS × Ex HS) :=
  [(aP, .reg NLogN.KFY.yP), (NLogN.AX.aS, .reg yS), (aT, .reg yT), (aWd, .reg NLogN.KFY.yW),
    (aBe, .ndiv (.pow2 (.reg NLogN.KFY.yP)) (.add (.reg yA) (.reg yA))),
    (aK2, .mul (.mul (.reg yA) (.reg yA)) (.mul (.reg yT) (.reg yT))),
    (aNR, nrE),
    (aKa, .nmod (.add (.reg yS) (.neg (.nmod (.reg NLogN.KFY.yW) (.reg yS)))) (.reg yS)),
    (aKN, .add (.reg yS) nrE),
    (aR, .pow2 (.add (.reg NLogN.KFY.yP) (.reg NLogN.KFY.yP))),
    (aNW, .mul (.reg yT) nrE),
    (aM, .reg NLogN.KFY.yM), (aTot, .mul (.reg NLogN.KFY.yM) (.reg yT))]

/-- **One axis of the `A` pass.** -/
noncomputable def axA (X : Fin HS) (Kc : ℝ) : RM :=
  .seq (.rs (takeD yS (.reg NLogN.KFY.dS))) (brk [(NLogN.KFY.yB, bitE)] (brk [(yT, NLogN.KFY.tE), (NLogN.KFY.yM, mE)]
    (.seq (brk [(zw, wE), (zm, kE)] (trBlk X Kc zw zm)) (brk regsA sapAxQ))))

/-! ## Small facts -/

/-- The cost bound of one `A` axis. -/
noncomputable def axAC (Kc : ℝ) (n k B K Ctr Csap : ℕ) : ℕ :=
  (2 * 10 ^ 7 * (B + 2) ^ 2 + (2 * B + 2)) +
    brkC 1 K B (brkC 2 K B (brkC 2 K B (1 + (10 ^ 12 * (IntMul.OpenAI.Glue.bP n + 1) ^ 3 + Ctr)) +
      brkC 13 K B Csap))

/-- Size bounds for one axis (`A` pass). -/
structure AxBnd (n A B : ℕ) : Prop where
  env : KFM.CostEnv A B
  pA : 2 ^ (2 * IntMul.OpenAI.Glue.pP n) ≤ A
  αA : IntMul.OpenAI.Glue.αP n ^ 2 * IntMul.OpenAI.Glue.rP n ^ 2 ≤ A
  wA : IntMul.OpenAI.Glue.rP n * (2 * HvdH.sWidth (IntMul.OpenAI.Glue.pP n) (IntMul.OpenAI.Glue.αP n) + 1) + IntMul.OpenAI.Glue.rP n ≤ A
  LA : 2 ^ IntMul.OpenAI.Glue.LP n ≤ A
  dA : IntMul.OpenAI.Glue.dP n ≤ A
  pB : 2 * IntMul.OpenAI.Glue.pP n + 1 ≤ B
  LB : IntMul.OpenAI.Glue.LP n + 2 ≤ B

end NLogN.KFY

end

section
-- Source module: Solutions.KFY14Loop
/-!
# KFY 14: the axis loop

`RM.rep cX (reg zD) ax`: `d` iterations of an axis body `ax`. **`loop_all`**: if every iteration
`k` moves `s_k` from `dS` to `yS` and replaces the array `X` on stack `0` by
`stepL (dims.rotate k) (fs k) X` (for arrays satisfying an invariant `P` that the steps keep),
the loop ends in `loopSt … d`: the array is `iterL dims fs d zs`, the sources lie reversed on
`yS`, nothing else changed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref

/-- The loop state after `k` axes. -/
def loopSt (u0 : IState HS) (srcs : List ℤ) (R R0 : List Item) (dims : List ℕ)
    (fs : ℕ → List KFB.GI → List KFB.GI) (zs : List KFB.GI) (k : ℕ) : IState HS :=
  ((u0.upd yS (ints (srcs.take k).reverse ++ u0.G yS)).upd NLogN.KFY.dS (ints (srcs.drop k) ++ R)).upd 0
    (ints (KFB.gflat (NLogN.KFY.iterL dims fs k zs)) ++ R0)

end NLogN.KFY

end

section
-- Source module: Solutions.KFY15Pass
/-!
# KFY 15: a whole line pass (generic in the width program and the axis body)

`passP wP ax = rs (proP; wP) ; rep cX (reg zD) ax ; rs epiP`.

**`pass_all`**: on the descriptor `[p, α, ℓ − 1, d, bits, s_0..s_{d−1}]` on `dS` and the array
`zs` on stack `0`, if `wP` pushes the width `w` on `yW` and the axis body `ax` performs axis
step `k` (in the register layout of the prologue), the pass leaves everything unchanged except
stack `0`, which holds `iterL (ofFn t) fs d zs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-- A line pass. -/
def passP (wP : RS) (ax : RM) : RM :=
  .seq (.rs (.seq proP wP)) (.seq (.rep cX (.reg KFM.zD) ax) (.rs epiP))

/-- The sources `s_0..s_{d−1}`. -/
noncomputable def srcsN (n : ℕ) : List ℤ := (List.range (IntMul.OpenAI.Glue.dP n)).map fun j => (KFM.srcN n j : ℤ)

/-- The cost bound of a pass. -/
def passC (d B Cw C : ℕ) : ℕ :=
  (proC d B + Cw) + ((2 * 10 ^ 7 * (B + 2) ^ 2 + d * (C + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) + 32) +
    epiC d B)

end NLogN.KFY

end

section
-- Source module: Solutions.KFY5Bap
/-!
# KFY 5: the `B₀` line pass on one axis (`bap0AxQ`)

`KFMBap0Ax.bap0AxP` with two changes:

* no transposition prelude (`coreQ` instead of `GL.axisP`): the slices are the consecutive
  slices of the array on `gD` (the rotation is done before, by `TransNeed`);
* padded output: every output slice has length `t`: the `s` values of `b0L` followed by `t − s`
  zeros (`padOut`, counter `10`). The slice map is `x ↦ b0L p s t α x ++ replicate (t − s) 0`.

**`bap0AxQ_all`**: on `gD = gints L ++ R`, `L.length = m t`, it computes
`gints (b0OutQ p s t α L) ++ R`; every other stack is restored. The proof is
`bap0AxP_all` with the axis lemma replaced by `coreQ_all`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp NLogN.KFM

/-- The axis core, written out. -/
def bap0CoreQ : RM :=
  .seq (.rep gCC (.reg bM) (RM.seqL [.rs (mvList NLogN.GL.gD gZT gCV (cnt2 NLogN.AX.bT)),
      .rs (mvList gZT bI gCV (cnt2 NLogN.AX.bT)), padOutP bO 10 bS NLogN.AX.bT bap0SlP,
      .rs (mvList bO gZB gCV (cnt2 NLogN.AX.bT))]))
    (.rs (mvList gZB NLogN.GL.gD gCV (cnt2 bTot)))

/-- **The padded `B̃₀` axis program.** -/
def bap0AxQ : RM :=
  RM.seqL [.rs tmpP, .rs eTabR, .rs eDelR, .rs cTabR, .rs cDelR, .rs dTabR', .rs ptKR, .rs psKR,
    .rs tmpQ, bap0CoreQ, .rs (popK bW gCC (.reg bNW)), .rs (popK bD gCC (.reg bS)),
    .rs (popK bW1 gCC (.reg bS)), .rs (popK bD1 gCC (.reg bS)), .rs (popK bW3 gCC (.reg bS)),
    .rs (popK bK3 gCC (.reg NLogN.AX.bT)), .rs (popK bKS gCC (.reg bS))]

/-- The scalar registers read by `bap0AxQ` (`BapRegs` with the output size `m t`). -/
structure BapRegsQ (p s t α m kb : ℕ) (st : IState HS) : Prop where
  t1 : ∃ L, st.G NLogN.AX.bT = .int (t : ℤ) :: L
  kb2 : ∃ L, st.G bKB = .int (kb : ℤ) :: L
  ps : ∃ L, st.G bS = .int (s : ℤ) :: L
  pr : ∃ L, st.G bPR = .int (2 ^ p) :: L
  ks : ∃ L, st.G bKs = .int (s : ℤ) :: L
  ka : ∃ L, st.G bKa = .int (sOff s (HvdH.eWidth p α) : ℤ) :: L
  kn : ∃ L, st.G bKN = .int ((s + (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) :: L
  br : ∃ L, st.G NLogN.AX.bR = .int (2 ^ p) :: L
  bn : ∃ L, st.G NLogN.AX.bN = .int (s : ℤ) :: L
  bnr : ∃ L, st.G bNR = .int ((2 * HvdH.eWidth p α + 1 : ℕ) : ℤ) :: L
  bnw : ∃ L, st.G bNW = .int ((s * (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) :: L
  jl : ∃ L, st.G bJL = .int ((2 * s : ℕ) : ℤ) :: L
  jn : ∃ L, st.G bJN = .int (HvdH.jIter p s t α : ℤ) :: L
  rp : ∃ L, st.G bO = .int (p : ℤ) :: L
  ra : ∃ L, st.G bI = .int ((α ^ 2 : ℕ) : ℤ) :: L
  ru : ∃ L, st.G bKS = .int (((s : ZMod t)⁻¹).val : ℤ) :: L
  rm : ∃ L, st.G bM = .int (m : ℤ) :: L
  rtot : ∃ L, st.G bTot = .int ((m * t : ℕ) : ℤ) :: L

/-- Cost bound of `bap0AxQ`. -/
def bap0AxCostQ (p s t α m mm Φ Bacc Q Bq : ℕ) : ℕ :=
  16 * 10 ^ 7 * (Bq + 2) ^ 2 +
  (tabCost (2 * HvdH.eWidth p α + 1) s (eWCost p Bq) +
  ((tabCost 1 s ((eDelE.size + 1) * 10 ^ 7 * (s + 4) ^ 2) + 10 ^ 9) +
