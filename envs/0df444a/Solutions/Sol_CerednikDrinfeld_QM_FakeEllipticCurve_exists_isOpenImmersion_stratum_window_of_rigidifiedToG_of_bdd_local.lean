theorem isIsogenyPair_one_of_comparison {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    {S' S : Type} [CommRing S'] [CommRing S] (φ : S' →+* S)
    (E : FakeEllipticCurve Λ N S')
    (E₁ : FakeEllipticCurve Λ N S) (g₁ : E₁.A ⟶ E.A) (h₁ : FakeEllipticCurve.IsPullbackVia φ E E₁ g₁)
    (E₂ : FakeEllipticCurve Λ N S) (g₂ : E₂.A ⟶ E.A) (h₂ : FakeEllipticCurve.IsPullbackVia φ E E₂ g₂)
    (u : E₂.A ⟶ E₁.A) (hug : u ≫ g₁ = g₂) (huf : u ≫ E₁.f = E₂.f) (hu : FakeEllipticCurve.IsPullbackVia (RingHom.id S) E₁ E₂ u) :
    ∃ u' : E₁.A ⟶ E₂.A, u' ≫ g₂ = g₁ ∧ u' ≫ E₂.f = E₁.f ∧ u ≫ u' = 𝟙 _ ∧ u' ≫ u = 𝟙 _ ∧
      FakeEllipticCurve.IsIsogenyPair 1 E₂ E₁ u u' := by
  obtain ⟨u', hu'g, hu'f, hu'⟩ := exists_comparison φ E E₂ g₂ h₂ E₁ g₁ h₁
  obtain ⟨sq₁, -, -, -⟩ := h₁
  obtain ⟨sq₂, -, -, -⟩ := h₂
  have hid := specMap_ofHom_id S
  have huu' : u ≫ u' = 𝟙 _ := by
    apply sq₂.hom_ext
    · rw [Category.assoc, hu'g, hug, Category.id_comp]
    · rw [Category.assoc, hu'f, huf, Category.id_comp]
  have hu'u : u' ≫ u = 𝟙 _ := by
    apply sq₁.hom_ext
    · rw [Category.assoc, hug, hu'g, Category.id_comp]
    · rw [Category.assoc, huf, hu'f, Category.id_comp]
  obtain ⟨squ, hmulu, hactu, -⟩ := hu
  obtain ⟨squ', hmulu', hactu', -⟩ := hu'
  refine ⟨u', hu'g, hu'f, huu', hu'u, huf, hu'f, ?_, ?_, hactu, hactu', ?_⟩
  · intro T t P Q
    apply Subtype.ext
    show (E₂.L.mul t P Q).1 ≫ u = (E₁.L.mul t (mapPt u huf P) (mapPt u huf Q)).1
    rw [hmulu t P Q]
    exact mul_val_congr E₁.L (by rw [hid, Category.comp_id]) _ _ _ _ rfl rfl
  · intro T t P Q
    apply Subtype.ext
    show (E₁.L.mul t P Q).1 ≫ u' = (E₂.L.mul t (mapPt u' hu'f P) (mapPt u' hu'f Q)).1
    rw [hmulu' t P Q]
    exact mul_val_congr E₂.L (by rw [hid, Category.comp_id]) _ _ _ _ rfl rfl
  · intro hd
    have h1 : (⟨(((1 : ℕ) : ℚ) : ℍ[ℚ, a, b]), hd⟩ : ↥Λ) = ⟨1, by simpa using hd⟩ := Subtype.ext (by push_cast; rfl)
    rw [h1, E₂.act_one, E₁.act_one]
    exact ⟨huu', hu'u⟩

theorem ker_quotientMap_sq_eq_bot {𝒪 B B₀ : Type} [CommRing 𝒪] [CommRing B] [CommRing B₀] [Algebra 𝒪 B] [Algebra 𝒪 B₀]
    (π : 𝒪) (p : B →ₐ[𝒪] B₀) (hp : Function.Surjective p) (hp2 : RingHom.ker (p : B →+* B₀) ^ 2 = ⊥)
    (hle : Ideal.span {algebraMap 𝒪 B π} ≤ (Ideal.span {algebraMap 𝒪 B₀ π}).comap (p : B →+* B₀)) :
    RingHom.ker (Ideal.quotientMap (Ideal.span {algebraMap 𝒪 B₀ π}) (p : B →+* B₀) hle) ^ 2 = ⊥ := by
  rw [pow_two, eq_bot_iff, Ideal.mul_le]
  intro x hx y hy
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [RingHom.mem_ker, Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hx hy
  obtain ⟨cx₀, hcx⟩ := hx
  obtain ⟨cy₀, hcy⟩ := hy
  obtain ⟨cx, rfl⟩ := hp cx₀
  obtain ⟨cy, rfl⟩ := hp cy₀
  have hπ : algebraMap 𝒪 B₀ π = p (algebraMap 𝒪 B π) := (p.commutes π).symm
  have hkx : x - cx * algebraMap 𝒪 B π ∈ RingHom.ker (p : B →+* B₀) := by
    rw [RingHom.mem_ker, map_sub, map_mul]; show p x - p cx * p (algebraMap 𝒪 B π) = 0
    rw [← hπ, hcx]; exact sub_self (p x)
  have hky : y - cy * algebraMap 𝒪 B π ∈ RingHom.ker (p : B →+* B₀) := by
    rw [RingHom.mem_ker, map_sub, map_mul]; show p y - p cy * p (algebraMap 𝒪 B π) = 0
    rw [← hπ, hcy]; exact sub_self (p y)
  have hprod : (x - cx * algebraMap 𝒪 B π) * (y - cy * algebraMap 𝒪 B π) = 0 := by
    have := Ideal.mul_mem_mul hkx hky
    rw [← pow_two, hp2] at this
    exact (Submodule.mem_bot _).mp this
  rw [Ideal.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  have hxy : x * y = (x - cx * algebraMap 𝒪 B π) * (y - cy * algebraMap 𝒪 B π) +
      algebraMap 𝒪 B π * (cx * y + x * cy - cx * cy * algebraMap 𝒪 B π) := by ring
  rw [hxy, hprod, zero_add]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

end H2Aux
