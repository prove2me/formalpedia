attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Remark 3.21, PDF p. 16. The translated criteria are conditional on pointedness. -/
theorem projection_and_translated_central_criteria (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (hf : FaithfulAction P) :
    (∀ x : G, Pointed (orbitHull x) → Pointed (orbitHull ((P.coordinates x).2.2))) ∧
    (∀ x : G, vPart P x = 0 →
      centralHull P x = translatedSubset (zPart P x) (centralQuadraticCone P x) ∧
      (Pointed (centralHull P x) ↔ Pointed (centralQuadraticCone P x)) ∧
      (Pointed (centralQuadraticCone P x) →
        (InPointedCone (centralHull P x) ↔ translatedSubset (zPart P x) (centralQuadraticCone P x) ∩
          (Neg.neg '' centralQuadraticCone P x) ⊆ ({0} : Set G)) ∧
        (InPointedCone (centralHull P x) ↔
          translatedSubset (zPart P x) (centralQuadraticCone P x) ∩ (Neg.neg '' centralQuadraticCone P x) = ∅ ∨
            zPart P x = 0))) := by sorry

end Presentations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
