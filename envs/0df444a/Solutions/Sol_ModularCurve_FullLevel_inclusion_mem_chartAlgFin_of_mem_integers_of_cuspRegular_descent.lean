    exact ModularCurve.coeffMap_congr (Subsingleton.elim _ _) _
  have hgK : coeffEmb ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) g ∈ laurentBaseChange ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (xHFunctionField (q ^ 2 * M') (levelH q M')) := by
    rw [← hfcoe]; exact (e.symm (Φ ⟨_, hF⟩)).2
  have hfeq : (⟨coeffEmb ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) g, hgK⟩ : ↥(laurentBaseChange ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (xHFunctionField (q ^ 2 * M') (levelH q M')))) = e.symm (Φ ⟨_, hF⟩) := Subtype.ext hfcoe.symm

