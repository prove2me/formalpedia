/-- PDF p.13, Theorem 6 (announced p.1): all positive tensor-copy testing
problems characterize intrinsic CPTP sufficiency, in BOTH directions. -/
theorem tensorCopySufficiency (A : Alg I) (rho0 rho1 : Mat I)
    (h0 : IsDensityMatrix rho0) (h1 : IsDensityMatrix rho1)
    (hf0 : rho0.PosDef) (hf1 : rho1.PosDef) :
    (∀ n : ℕ, 0 < n → TwoNSufficient A rho0 rho1 n) ↔
      Sufficient A rho0 rho1 := by sorry

end QAlgorithms.Papers.Independent.Intake100.P71

