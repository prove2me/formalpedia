-- title:
--   Proof of Proposition 5.1, pp. 487–488, (21) — f₀(z) + f_k(z_k) ≤ f₀(z₁,…,x_k,…,z_N) + f_k(x_k) for all x_k and k
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3 and either C1 or C2, and let $\{x^r\}$ be generated by the BCD method (2)–(3) from $x^0\in\operatorname{dom}f$ using the essentially cyclic rule with bound $T\ge N$, with values $\{f(x^r)\}$ that do not decrease to $-\infty$. Then every cluster point $z$ of $\{x^r\}$ satisfies
--   $$f_0(z)+f_k(z_k)\le f_0(z_1,\dots,z_{k-1},x_k,z_{k+1},\dots,z_N)+f_k(x_k),\tag{21}$$
--   for all $x_k\in\mathbb R^{n_k}$ and all $k\in\{1,\dots,N\}$.
--
--   Together with form (1) this gives that $z$ is a coordinatewise minimum point of $f$; Assumption C1 or C2 is what lets the limit pass through $f_0$.
--
--   **Formalization Note.** The page derives (21) from (20) for a subsequence converging to $z$; since every cluster point is such a limit, the claim is stated for cluster points. Block $k$ is 0-based in Lean; $(z_1,\dots,x_k,\dots,z_N)$ is $z$ with block $k$ replaced by $x_k$.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), pp. 487–488, proof of Proposition 5.1, (21)

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem claim_21 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (s : ℕ → Fin N) (x : ℕ → TsengBCD.Stationary.X n) (hrun : TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x)
    (T : ℕ) (hT : N ≤ T) (hcyc : ∀ (r : ℕ) (k : Fin N), ∃ j < T, s (r + j) = k)
    (hfin : ¬ Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 ⊥))
    (z : TsengBCD.Stationary.X n) (hz : MapClusterPt z atTop x) :
    ∀ (k : Fin N) (xk : EuclideanSpace ℝ (Fin (n k))),
      f0 z + fk k (z k) ≤ f0 (Function.update z k xk) + fk k xk := by sorry

end TsengBCD.Hemivariate
