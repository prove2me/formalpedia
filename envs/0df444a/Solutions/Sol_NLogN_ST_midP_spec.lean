  rw [e]
  have h1 : N * ((a + 6) * 10 ^ 7 * X + 4 * 10 ^ 7 * X + 30) ≤ N * (a + 10) * 10 ^ 7 * X + N * 30 := by
    ring_nf; omega
  have h2 : N * 30 ≤ N * 3 * 10 ^ 7 * X := by
    have : 30 ≤ 3 * 10 ^ 7 * X := by omega
    calc N * 30 ≤ N * (3 * 10 ^ 7 * X) := Nat.mul_le_mul_left _ this
      _ = N * 3 * 10 ^ 7 * X := by ring
  have h3 : 2 * 10 ^ 7 * X + (b + 1) * 10 ^ 7 * X + 32 ≤ (a + b + 13) * 10 ^ 7 * X := by
    have : (a + b + 13) * 10 ^ 7 * X = 2 * 10 ^ 7 * X + (b + 1) * 10 ^ 7 * X + (a + 10) * 10 ^ 7 * X := by ring
    rw [this]
    have : 32 ≤ (a + 10) * 10 ^ 7 * X := by nlinarith
    omega
  have h4 := Nat.zero_le (N * b * 10 ^ 7 * X)
  omega

