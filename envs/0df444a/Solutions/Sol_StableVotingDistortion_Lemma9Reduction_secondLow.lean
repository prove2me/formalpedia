open PaperMiddle
private def pairPass : List (PaperMiddle.Knot × PaperMiddle.Knot) → List MassCell → Bool
  | [], _ => true
  | z :: zs, ms =>
    let a := qRank z.1
    let b := min (qRank z.2) lamQ
    let mid := (a+b)/2
    if b<a then pairPass zs ms else
      match ms with
      | m::n::rest => decide (link z.1 z.2 a mid m) && decide (link z.1 z.2 mid b n) && pairPass zs rest
      | _ => false

private theorem pairPass_sound {xs : List (PaperMiddle.Knot × PaperMiddle.Knot)} {ms all : List MassCell}
    (inc : ∀ m∈ms,m∈all) (ok : pairPass xs ms=true) : xs.all (cellsMatch all)=true := by
  induction xs generalizing ms with
  | nil => rfl
  | cons z zs ih =>
    let a := qRank z.1
    let b := min (qRank z.2) lamQ
    let mid := (a+b)/2
    change (if b<a then _ else _) = true at ok
    rw [List.all_cons,Bool.and_eq_true_iff]
    by_cases bad : b<a
    · rw [if_pos bad] at ok
      exact ⟨by change (if b<a then true else _) = true; rw [if_pos bad],ih inc ok⟩
    · rw [if_neg bad] at ok
      cases ms with
      | nil => contradiction
      | cons m tail =>
        cases tail with
        | nil => contradiction
        | cons n rest =>
          change (_ && _ && pairPass zs rest) = true at ok
          obtain ⟨⟨hl,hr⟩,ht⟩ := (Bool.and_eq_true_iff.mp ok).imp_left Bool.and_eq_true_iff.mp
          constructor
          · change (if b<a then true else _ && _) = true
            rw [if_neg bad,Bool.and_eq_true_iff]
            exact ⟨List.any_eq_true.mpr ⟨m,inc m (by simp),hl⟩,
              List.any_eq_true.mpr ⟨n,inc n (by simp),hr⟩⟩
          · exact ih (fun s hs => inc s (by simp [hs])) ht

theorem mass_match : PaperMiddle.adjacentCells.all (cellsMatch masses) = true := by
  apply pairPass_sound (ms:=masses) (fun m hm => hm)
  set_option maxRecDepth 200000 in
  set_option maxHeartbeats 0 in
  decide +kernel

