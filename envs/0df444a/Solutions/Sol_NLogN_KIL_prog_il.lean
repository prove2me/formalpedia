section Main

variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W)

theorem one_le_zsz_of {V Bb : ℕ} (hV1 : 1 ≤ V) (h : zsz ((V : ℕ) : ℤ) ≤ Bb) : 1 ≤ Bb := by
  have := NLogN.KIL.zsz_nat_le hV1
  simp only [Nat.cast_one, zsz_one] at this
  omega

theorem vol_swShape_pos {P L : ℕ} {A B Cs : Shape} {F : ℕ} (hP : 1 ≤ P) (hL : 1 ≤ L)
    (hA : ∀ a ∈ A, 1 ≤ a) (hB : ∀ a ∈ B, 1 ≤ a) (hC : ∀ a ∈ Cs, 1 ≤ a) (hF : 1 ≤ F) :
    ∀ a ∈ P :: L :: swShape A B Cs F, 1 ≤ a := by
  intro a ha
  simp only [swShape, List.mem_cons, List.mem_append] at ha
  rcases ha with rfl | rfl | ha | rfl | ha | rfl | ha
  all_goals first | assumption | exact hA _ ‹_› | exact hB _ ‹_› | exact hC _ ‹_›

theorem sq_le_vol_swShape {P L : ℕ} {A B Cs : Shape} {F : ℕ}
    (h : ∀ a ∈ P :: L :: swShape A B Cs F, 1 ≤ a) :
    F * F ≤ vol (P :: L :: swShape A B Cs F) := by
  have hP := h P (by simp)
  have hL := h L (by simp)
  have hA : 1 ≤ vol A := vol_pos_of (fun a ha => h a (by simp [swShape, ha]))
  have hB : 1 ≤ vol B := vol_pos_of (fun a ha => h a (by simp [swShape, ha]))
  have hC : 1 ≤ vol Cs := vol_pos_of (fun a ha => h a (by simp [swShape, ha]))
  have e : vol (P :: L :: swShape A B Cs F) = (P * L * vol A * vol B * vol Cs) * (F * F) := by
    simp only [swShape, vol_cons, vol_append]; ring
  rw [e]
  have : 1 ≤ P * L * vol A * vol B * vol Cs :=
    Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL) hA) hB) hC
  exact Nat.le_mul_of_pos_left _ this

/-- **The recursion as IL procedures (all configurations of the table).** -/
theorem prog_il_cfg (D q : ℕ) (hq : 2 ≤ q) (hm : 1 ≤ m)
    (hfr : ∀ j, FramesOK (FrOK C (q ^ m ^ j) (ShFrac (q ^ m ^ j) D)) C.gates C.Min C.Mout)
    (P k : ℕ) (root : Cfg) (hroot : root.1 = k) (hP : 1 ≤ P) (Bb : ℕ) (I : List Sym) :
    ∀ j L A B Cs, (j, L, A, B, Cs) ∈ allCfg m W q k root → W ^ j ∣ L → 1 ≤ L →
      (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
      zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ j)) : ℕ) : ℤ) ≤ Bb →
      ∀ (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
        xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ j)) →
        IRuns I (progTbl C D q P k root)
          (progTbl C D q P k root (cfgIdx q k root (j, L, A, B, Cs)))
          (t.upd 0 (ints (enc2 xs) ++ R))
          (t.upd 0 (ints (enc2 (AModel.prog C q j P L A B Cs xs)) ++ R))
          (ilCost C D q Bb j (vol (P :: L :: swShape A B Cs (q ^ m ^ j)))
            (A.length + B.length + Cs.length)) := by
  intro j
  induction j with
  | zero =>
    intro L A B Cs hmem hL hL1 hA hB hC hV t R xs hxs
    rw [progTbl_idx C D q P k root hmem]
    simp only [cfgCode, if_pos rfl]
    have hq0 : q ^ m ^ 0 = q := by simp
    rw [hq0] at hV hxs ⊢
    have hpos := vol_swShape_pos hP hL1 hA hB hC (show 1 ≤ q by omega)
    have hV1 : 1 ≤ vol (P :: L :: swShape A B Cs q) := vol_pos_of hpos
    have hBb := one_le_zsz_of hV1 hV
    have S := swapB_sp (P :: L :: A) B Cs q Bb t (enc2 xs) R
      (by rw [length_enc2, hxs]; rfl) (bnd_enc2 xs hBb)
      (vol_pos_of (fun a ha => hpos a (by
        simp only [List.mem_cons] at ha
        rcases ha with rfl | rfl | ha
        · simp
        · simp
        · simp [swShape, ha])))
      (by omega) (vol_pos_of hB) (vol_pos_of hC) hV
    rw [pull_enc2] at S
    have e : AModel.prog C q 0 P L A B Cs xs = AModel.pull ((P :: L :: A) ++ q :: (B ++ q :: Cs))
        ((P :: L :: A) ++ q :: (B ++ q :: Cs))
        (swapPos (P :: L :: A).length ((P :: L :: A).length + 1 + B.length)) 0 xs := by
      simp only [AModel.prog, swShape, List.cons_append, List.length_cons]
      congr 2; omega
    rw [e]
    refine S.toIRuns.mono (le_of_eq ?_)
    rw [cSwapB_le]
    rfl
  | succ j ih =>
    intro L A B Cs hmem hL hL1 hA hB hC hV t R xs hxs
    set N := q ^ m ^ j with hNdef
    have hN : 1 < N := Nat.one_lt_pow (pow_ne_zero _ (by omega)) (by omega)
    have : NeZero N := ⟨by omega⟩
    have hWL : W ∣ L := (dvd_pow_self W (Nat.succ_ne_zero j)).trans hL
    set L' := L / W with hL'def
    have hLW : W * L' = L := Nat.mul_div_cancel' hWL
    have hW1 : 1 ≤ W := NeZero.pos W
    have hL1' : 1 ≤ L' := by
      rcases Nat.eq_zero_or_pos L' with h | h
      · rw [h, Nat.mul_zero] at hLW; omega
      · exact h
    have hL' : W ^ j ∣ L' := by
      rw [← hLW, pow_succ'] at hL
      exact Nat.dvd_of_mul_dvd_mul_left (NeZero.pos W) hL
    have hpow : N ^ m = q ^ m ^ (j + 1) := by rw [hNdef, ← pow_mul, ← pow_succ]
    have hvolB : vol (P :: W * L' :: hdShape A B Cs m N) =
        vol (P :: L :: swShape A B Cs (q ^ m ^ (j + 1))) := by
      rw [hLW]; simp only [vol_cons, vol_hdShape, hpow]
    have hvbig : vol (P :: W * L' :: hdShape A B Cs m N) =
        W * vol (P :: L' :: hdShape A B Cs m N) := vol_big N P L' A B Cs
    -- positivity
    have hposH : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a := by
      intro a ha
      simp only [hdShape, List.mem_cons, List.mem_append, List.mem_replicate] at ha
      rcases ha with rfl | rfl | ha | ⟨-, rfl⟩ | ha | ⟨-, rfl⟩ | ha
      all_goals first | omega | exact hA _ ‹_› | exact hB _ ‹_› | exact hC _ ‹_›
    have hposS := vol_swShape_pos hP hL1 hA hB hC (show 1 ≤ q ^ m ^ (j + 1) by
      rw [← hpow]; exact Nat.one_le_pow _ _ (by omega))
    -- the code
    rw [progTbl_idx C D q P k root hmem]
    simp only [cfgCode, if_neg (Nat.succ_ne_zero j)]
    -- the child calls
    set child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2) := fun a b =>
      AModel.prog C q j P L' (A ++ List.replicate a N)
        (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
        (List.replicate (m + m - 1 - b) N ++ Cs) with hchild
    have hprog : AModel.prog C q (j + 1) P L A B Cs xs = levelR C N P L' A B Cs child xs := rfl
    rw [hprog]
    set n := A.length + B.length + Cs.length
    set c0 := ilCost C D q Bb j (vol (P :: L' :: hdShape A B Cs m N)) (n + 2 * (m - 1))
    have hVle : vol (P :: L' :: hdShape A B Cs m N) ≤
        vol (P :: L :: swShape A B Cs (q ^ m ^ (j + 1))) := by
      rw [← hvolB, hvbig]; exact Nat.le_mul_of_pos_left _ hW1
    have hcall : ∀ (i j' : Fin m) (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
        ys.length = vol (P :: L' :: hdShape A B Cs m N) →
        IRuns I (progTbl C D q P k root)
          (progTbl C D q P k root (cfgIdx q k root
            (childCfg m W q (j + 1, L, A, B, Cs) (Fin.castAdd m i) (Fin.natAdd m j'))))
          (t.upd 0 (ints (enc2 ys) ++ R))
          (t.upd 0 (ints (enc2 (child (Fin.castAdd m i) (Fin.natAdd m j') ys)) ++ R)) c0 ∧
        (child (Fin.castAdd m i) (Fin.natAdd m j') ys).length =
          vol (P :: L' :: hdShape A B Cs m N) := by
      intro i j' t R ys hys
      have e1 : ((Fin.natAdd m j' : Fin (m + m)) : ℕ) - m = j' := by simp
      have e2 : m + m - 1 - ((Fin.natAdd m j' : Fin (m + m)) : ℕ) = m - 1 - j' := by
        simp; omega
      have e3 : ((Fin.castAdd m i : Fin (m + m)) : ℕ) = i := by simp
      have hc' : childCfg m W q (j + 1, L, A, B, Cs) (Fin.castAdd m i) (Fin.natAdd m j') =
          (j, L', A ++ List.replicate i N,
            List.replicate (m - 1 - i) N ++ (B ++ List.replicate j' N),
            List.replicate (m - 1 - j') N ++ Cs) := by
        simp only [childCfg, Nat.add_sub_cancel, e1, e2, e3]
        rfl
      have hmem' := child_mem_allCfg m W q k root hroot _ hmem (by simp) (Fin.castAdd m i)
        (Fin.natAdd m j')
      rw [hc'] at hmem' ⊢
      have hsw := swShape_child A B Cs (N := N) i j'
      have hchild' : child (Fin.castAdd m i) (Fin.natAdd m j') = AModel.prog C q j P L'
          (A ++ List.replicate i N) (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j' N))
          (List.replicate (m - 1 - j') N ++ Cs) := by
        simp only [hchild, e1, e2, e3]
      rw [hchild']
      have hlen' : (A ++ List.replicate i N).length +
          (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j' N)).length +
          (List.replicate (m - 1 - j') N ++ Cs).length = n + 2 * (m - 1) := by
        simp only [List.length_append, List.length_replicate, n]; omega
      have hvc : vol (P :: L' :: swShape (A ++ List.replicate i N)
          (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j' N))
          (List.replicate (m - 1 - j') N ++ Cs) (q ^ m ^ j)) = vol (P :: L' :: hdShape A B Cs m N) := by
        rw [← hNdef, hsw]
      have IH := ih L' _ _ _ hmem' hL' hL1'
        (fun a ha => by
          simp only [List.mem_append, List.mem_replicate] at ha
          rcases ha with ha | ⟨-, rfl⟩
          · exact hA a ha
          · omega)
        (fun a ha => by
          simp only [List.mem_append, List.mem_replicate] at ha
          rcases ha with ⟨-, rfl⟩ | ha | ⟨-, rfl⟩
          · omega
          · exact hB a ha
          · omega)
        (fun a ha => by
          simp only [List.mem_append, List.mem_replicate] at ha
          rcases ha with ⟨-, rfl⟩ | ha
          · omega
          · exact hC a ha)
        (by rw [hvc]; exact le_trans (NLogN.KIL.zsz_nat_le hVle) hV) t R ys (by rw [hvc]; exact hys)
      rw [hvc, hlen'] at IH
      refine ⟨IH, ?_⟩
      rw [length_prog C q P _ _ _ ys j L' hL', ← hNdef, hsw]
    have hV' : zsz ((vol (P :: W * L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb := by
      rw [hvolB]; exact hV
    have hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hV
      have h1 := sq_le_vol_swShape hposS
      have h2 : N ≤ q ^ m ^ (j + 1) := by
        rw [← hpow]; exact Nat.le_self_pow (by omega) _
      have h3 : 2 ≤ q ^ m ^ (j + 1) := by omega
      nlinarith
    have H := levelF_run C N A B Cs D hN (hfr j) P L' hposH I (progTbl C D q P k root)
      (fun a b => cfgIdx q k root (childCfg m W q (j + 1, L, A, B, Cs) a b)) child c0 Bb
      hcall hV' hQ2 t R xs (by rw [hvolB]; exact hxs)
    refine H.mono (le_of_eq ?_)
    have hlenH : (hdShape A B Cs m N).length + 2 = n + 2 * m + 2 := by
      rw [length_hdShape]; simp only [n]; omega
    have hdivV : vol (P :: L :: swShape A B Cs (q ^ m ^ (j + 1))) / W =
        vol (P :: L' :: hdShape A B Cs m N) := by
      rw [← hvolB, hvbig, Nat.mul_div_cancel_left _ (NeZero.pos W)]
    simp only [ilCost, hlenH, hvolB, hdivV, c0]

end Main

end NLogN.KIL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12 AModelFac
variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W)
theorem solution (D q : ℕ) (hq : 2 ≤ q) (hm : 1 ≤ m)
    (hfr : ∀ j, AModel.FramesOK (NLogN.KIL.FrOK C (q ^ m ^ j) (NLogN.KIL.ShFrac (q ^ m ^ j) D)) C.gates C.Min C.Mout)
    (k P L : ℕ) (A B Cs : AModel.Shape) (hP : 1 ≤ P) (hL : W ^ k ∣ L) (hL1 : 1 ≤ L)
    (hA : ∀ a ∈ A, 1 ≤ a) (hB : ∀ a ∈ B, 1 ≤ a) (hC : ∀ a ∈ Cs, 1 ≤ a) (Bb : ℕ)
    (hV : NLogN.zsz ((AModel.vol (P :: L :: AModel.swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb)
    (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (xs : List (ZMod 2))
    (hxs : xs.length = AModel.vol (P :: L :: AModel.swShape A B Cs (q ^ m ^ k))) :
    NLogN.IRuns I (NLogN.KIL.progTbl C D q P k (NLogN.KIL.rootCfg k L A B Cs))
      (NLogN.KIL.progTbl C D q P k (NLogN.KIL.rootCfg k L A B Cs) (NLogN.KIL.cfgIdx q k (NLogN.KIL.rootCfg k L A B Cs) (NLogN.KIL.rootCfg k L A B Cs)))
      (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs) ++ R))
      (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (AModel.prog C q k P L A B Cs xs)) ++ R))
      (NLogN.KIL.ilCost C D q Bb k (AModel.vol (P :: L :: AModel.swShape A B Cs (q ^ m ^ k)))
        (A.length + B.length + Cs.length)) :=
  NLogN.KIL.prog_il_cfg C D q hq hm hfr P k (NLogN.KIL.rootCfg k L A B Cs) rfl hP Bb I k L A B Cs
    (NLogN.KIL.self_mem_allCfg m W q k _) hL hL1 hA hB hC hV t R xs hxs
end
