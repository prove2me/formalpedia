variable {K : Type} [Field K] [NumberField K]

private def d071 (S L : Finset (HeightOneSpectrum (𝓞 K))) :
    {i : {v : HeightOneSpectrum (𝓞 K) // v ∉ S} // i ∈ (↑(L.subtype fun v => v ∉ S) : Set _)ᶜ} ≃
      {v : HeightOneSpectrum (𝓞 K) // v ∉ S ∪ L} where
  toFun i := ⟨i.1.1, fun h => (Finset.mem_union.1 h).elim i.1.2 fun hL =>
    (Set.mem_compl_iff _ _).1 i.2 (by simpa [Finset.mem_subtype] using hL)⟩
  invFun w := ⟨⟨w.1, fun h => w.2 (Finset.mem_union_left _ h)⟩, (Set.mem_compl_iff _ _).2 fun h =>
    w.2 (Finset.mem_union_right _ (by simpa [Finset.mem_subtype] using h))⟩
  left_inv _ := rfl
  right_inv _ := rfl

private theorem t0682 (S L : Finset (HeightOneSpectrum (𝓞 K))) (hLS : ∀ v ∈ L, v ∉ S)
    (G : HeightOneSpectrum (𝓞 K) → ℂ) {Lf : ℂ}
    (hT : HasProd (fun w : {v : HeightOneSpectrum (𝓞 K) // v ∉ S ∪ L} => G w.1) Lf) :
    ∏' i : {v : HeightOneSpectrum (𝓞 K) // v ∉ S}, G i.1 = (∏ v ∈ L, G v) * Lf := by
  have h := (L.subtype fun v => v ∉ S).hasProd fun i : {v : HeightOneSpectrum (𝓞 K) // v ∉ S} => G i.1
  have hprod : ∏ i ∈ L.subtype (fun v => v ∉ S), G i.1 = ∏ v ∈ L, G v :=
    calc ∏ i ∈ L.subtype (fun v => v ∉ S), G i.1
        = ∏ w ∈ (L.subtype fun v => v ∉ S).map (Function.Embedding.subtype _), G w :=
          (Finset.prod_map (L.subtype fun v => v ∉ S) (Function.Embedding.subtype fun v => v ∉ S) G).symm
      _ = ∏ w ∈ L.filter (fun v => v ∉ S), G w := by rw [Finset.subtype_map]
      _ = ∏ v ∈ L, G v := by rw [Finset.filter_true_of_mem hLS]
  rw [hprod] at h
  have hc : HasProd ((fun i : {v : HeightOneSpectrum (𝓞 K) // v ∉ S} => G i.1) ∘
      ((↑) : ↥(↑(L.subtype fun v => v ∉ S) : Set {v : HeightOneSpectrum (𝓞 K) // v ∉ S})ᶜ → _)) Lf :=
    (d071 S L).hasProd_iff.2 hT
  have hall := h.mul_isCompl isCompl_compl hc
  exact hall.tprod_eq

end EulerSplit
