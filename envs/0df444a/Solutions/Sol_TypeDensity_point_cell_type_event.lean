      simpa [Fin.val_ne_iff.mp, j.2.ne] using this
    · intro h j
      by_cases hj : j < r
      · have := h ⟨j, hj⟩
        have e := hco ⟨j, hj⟩
        rw [e, Polynomial.coeff_X_pow, if_neg hj.ne]
        simpa using this
      · rcases (not_lt.1 hj).eq_or_lt with hr | hr
        · subst hr
