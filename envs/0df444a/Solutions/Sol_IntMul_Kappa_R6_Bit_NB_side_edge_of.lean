namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset
open scoped Kronecker

section Class

variable {h : ℕ}

/-! ## Side edges: factorization through `Fin n` -/

section Side

lemma qM_eq (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ) : qM M = Te (h := h) * M * Te' (h := h) := by
  unfold qM Te Te'
  rw [Matrix.submatrix_mul _ _ flagEquiv id flagEquiv Function.bijective_id,
    Matrix.submatrix_mul _ _ flagEquiv id id Function.bijective_id, submatrix_id_id]

lemma qM_fac (C : Matrix (Pr (h + 4)) (Fin (h + 4)) ℚ) (A : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ)
    (R : Matrix (Fin (h + 4)) (Pr (h + 4)) ℚ) :
    qM (C * A * R) = (Te (h := h) * C) * A * (R * Te' (h := h)) := by
  rw [qM_eq]; simp only [Matrix.mul_assoc]

variable (x y : Fin (h + 4) → ℚ)

end Side

end Class

