        rw [← Real.rpow_mul (by norm_num), show (2 : ℝ) ^ 132 * IntMul.OpenAI.RCost.ε = (2 : ℝ) ^ 57 by
          unfold IntMul.OpenAI.RCost.ε; norm_num]
