-- ===== S4.Def_RP_EtPBC_A_Z3Chart =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 6 (G-b): the charts of `P¹_V = P¹_K ×_K V` are generated by one coordinate

* `PV K gV = P¹_K ×_K V`, `pr`, `qV`; charts `Qc i = pr⁻¹ D₊(Xᵢ)`, coordinates `tc i j = pr^* (Xⱼ/Xᵢ)`,
  structure maps `ac i : Γ(V) → Γ(P_V, Qᵢ)`.
* `Wc i = P_V ×_{P¹} Spec K[X₀,X₁]_(Xᵢ)`, `jW i` (open immersion with image `Qᵢ`: `image_jW`), `isPullback_W`,
  `isPushout_W` (`V` affine: `Γ(Wᵢ) = K[X₀,X₁]_(Xᵢ) ⊗_K Γ(V)` as a pushout).
* **`surj_chart`**: `Γ(V)[X] → Γ(P_V, Qᵢ)`, `X ↦ tc i j`, is surjective (`V` affine, `i ≠ j`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace MvPolynomial HomogeneousLocalization
open RamanujanPetersson.EtCompact

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

section Bundle

variable (K : Type u) [Field K] {V : Scheme.{u}} (gV : V ⟶ Spec (CommRingCat.of K))

/-- **`Γ(V)[X] ↠ Γ(P_V, Qᵢ)`, `X ↦ Xⱼ/Xᵢ`** (`V` affine). -/
theorem surj_chart [IsAffine V] (i j : Fin 2) (hij : i ≠ j) :
    Function.Surjective (Polynomial.eval₂RingHom (ac K gV i).hom (tc K gV i j)) := by
  have hinj := appLE_injective_of_eq (jW K gV i) (image_jW K gV i) (top_le_jW K gV i)
  have hP := isPushout_W K gV i
  rw [ch_toSpecK, appTop_Spec_map] at hP
  have hα := (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of K)).hom).2
  have hβ := (ConcreteCategory.bijective_of_isIso
    (Scheme.ΓSpecIso (CommRingCat.of (Away (gr K) (X i : MvPolynomial (Fin 2) K)))).inv).2
  have he := surj_eval₂_comp _ hα _ _ (surj_eval₂_map _ _ _ hβ (away_surj_eval K i j hij))
  have hs := pushout_surj hP _ he
  have h1 : ac K gV i ≫ (jW K gV i).appLE (Qc K gV i) ⊤ (top_le_jW K gV i) = (jW K gV i ≫ qV K gV).appTop := by
    exact (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans (appLE_top_top _ _)
  have h2 := chart_pull (ch K i) (pr K gV) (jW K gV i) (pullback.snd _ _) pullback.condition (top_le_jW K gV i)
  have h2' : ((jW K gV i).appLE (Qc K gV i) ⊤ (top_le_jW K gV i)).hom (tc K gV i j) =
      (pullback.snd (pr K gV) (ch K i)).appTop.hom
        ((Scheme.ΓSpecIso _).inv (Away.isLocalizationElem (x_mem K i) (x_mem K j))) :=
    congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso _).inv (Away.isLocalizationElem (x_mem K i) (x_mem K j)))) h2
  apply surj_of_comp _ _ ((jW K gV i).appLE (Qc K gV i) ⊤ (top_le_jW K gV i)).hom hinj
  rw [← CommRingCat.hom_comp, h1, h2']
  exact hs

end Bundle

end RamanujanPetersson.EtPBC.Z3

end

end

-- ===== S4.Def_RP_EtPBC_A_Z2Et =====
section

/-!
# S4-EtPBC-A, (Z2e): an idempotent on the fibre becomes a global idempotent after an etale neighbourhood

* `fibre_idem`: let `ρ : T →+* F`, `e : Fin (n+1) → T` complete orthogonal idempotents and primes `P' i` such that
  every prime of `F` pulls back to a prime containing `e (last n)` and equal to `P' i` whenever it misses
  `e i.castSucc`. If `ρ y` is idempotent, then `ρ y = ρ e'` for an idempotent `e'` (a sum of some `e i`).
* **`exists_etale_idem`** (with Mathlib's 00UL): `E` finite over `R`, `p` prime, `ρ : E →ₐ[R] F`, `F` a
  `κ(p)`-algebra, `ρ y` idempotent. Then there are an etale `R → R'` and a prime `P` over `p` with `κ(p) ≅ κ(P)`
  and an idempotent `e' ∈ R' ⊗ E` with `(R' → κ(P) ≅ κ(p) → F) ⊗ ρ` sending `e'` to `ρ y`.
-/

set_option autoImplicit false

open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Z2

universe u v w

section Fibre

end Fibre

section Etale

variable {R : Type u} {E : Type v} {F : Type w} [CommRing R] [CommRing E] [CommRing F] [Algebra R E]
  [Algebra R F]

/-- **Idempotents of the fibre spread to an etale neighbourhood** (with Mathlib's 00UL). -/
theorem exists_etale_idem [Module.Finite R E] (p : Ideal R) [p.IsPrime] (κF : p.ResidueField →ₐ[R] F)
    (ρ : E →ₐ[R] F) (y : E) (hy : IsIdempotentElem (ρ y)) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (P : Ideal R')
      (_ : P.IsPrime) (_ : P.LiesOver p)
      (hbij : Function.Bijective (Ideal.ResidueField.mapₐ p P (Algebra.ofId _ _) (P.over_def p)))
      (e' : R' ⊗[R] E), IsIdempotentElem e' ∧
        Algebra.TensorProduct.lift
          ((κF.comp (AlgEquiv.ofBijective _ hbij).symm.toAlgHom).comp
            (IsScalarTower.toAlgHom R R' P.ResidueField)) ρ (fun _ _ => Commute.all _ _) e' = ρ y := by
  obtain ⟨R', iR, iA, iE, P, iP, iL, n, e, he, P', _, _, hbij, -, H⟩ :=
    Algebra.exists_etale_completeOrthogonalIdempotents_forall_liesOver_eq (S := E) p
  set fP : R' →ₐ[R] F := (κF.comp (AlgEquiv.ofBijective _ hbij).symm.toAlgHom).comp
    (IsScalarTower.toAlgHom R R' P.ResidueField) with hfP
  set ρ' := Algebra.TensorProduct.lift fP ρ (fun _ _ => Commute.all _ _) with hρ'
  have hfPmem : ∀ (Q : Ideal F), Q.IsPrime → ∀ x : R', fP x ∈ Q ↔ x ∈ P := by
    intro Q hQ x
    constructor
    · intro hx
      by_contra hxP
      have hu : IsUnit (algebraMap R' P.ResidueField x) :=
        isUnit_iff_ne_zero.2 fun h0 => hxP (Ideal.algebraMap_residueField_eq_zero.1 h0)
      have hu' : IsUnit (fP x) := (hu.map (AlgEquiv.ofBijective _ hbij).symm).map κF
      exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu')
    · intro hx
      have h0 : algebraMap R' P.ResidueField x = 0 := Ideal.algebraMap_residueField_eq_zero.2 hx
      have : fP x = 0 := by
        simp only [hfP, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom', h0, map_zero]
      rw [this]; exact Q.zero_mem
  have hH : ∀ Q : Ideal F, Q.IsPrime → e (Fin.last n) ∈ Q.comap (ρ' : R' ⊗[R] E →+* F) ∧
      ∀ i, e i.castSucc ∉ Q.comap (ρ' : R' ⊗[R] E →+* F) → Q.comap (ρ' : R' ⊗[R] E →+* F) = P' i := by
    intro Q hQ
    have hpr : (Q.comap (ρ' : R' ⊗[R] E →+* F)).IsPrime := Ideal.comap_isPrime _ _
    have hlo : (Q.comap (ρ' : R' ⊗[R] E →+* F)).LiesOver P := by
      constructor
      ext x
      rw [Ideal.under, Ideal.mem_comap, Ideal.mem_comap, ← hfPmem Q hQ x]
      have : (ρ' : R' ⊗[R] E →+* F) (algebraMap R' (R' ⊗[R] E) x) = fP x := by
        simp [hρ', Algebra.TensorProduct.algebraMap_apply]
      rw [this]
    exact H _ hpr hlo
  have hy' : IsIdempotentElem ((ρ' : R' ⊗[R] E →+* F) (1 ⊗ₜ y)) := by
    simpa [hρ'] using hy
  obtain ⟨e', he', hρe'⟩ := fibre_idem (ρ' : R' ⊗[R] E →+* F) e he P' hH (1 ⊗ₜ y) hy'
  refine ⟨R', iR, iA, iE, P, iP, iL, hbij, e', he', ?_⟩
  have h1 : (ρ' : R' ⊗[R] E →+* F) (1 ⊗ₜ y) = ρ y := by simp [hρ']
  have h2 := hρe'.trans h1
  rw [RingHom.coe_coe] at h2
  exact h2

end Etale

end RamanujanPetersson.EtPBC.Z2

end

