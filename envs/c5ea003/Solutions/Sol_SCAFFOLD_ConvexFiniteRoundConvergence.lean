section SCAFFOLDBundleModule22
/-!
Server first-moment identities and descent, derived from SCAFFOLD Appendix E,
PDF pp. 25-26 equations (18)-(22), Lemma 15 p.30 and Lemma 19 pp.34-35.
Sampling is conditioned on completed virtual paths; oracle means are then
conditioned on the round-start filtration.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD
variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def meanSignal (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (N : ℝ)⁻¹ • ∑ i, averageSignal A r i ω

theorem Run.meanSignal_memLp (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) : MemLp (meanSignal A r) 2 ν :=
  (memLp_finsetSum Finset.univ (fun i _ ↦ A.averageSignal_memLp hr i)).const_smul (N : ℝ)⁻¹

theorem Run.server_inner_integral (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (v : Ω → Space d) (hv : MemLp v 2 ν)
    (hm : AEStronglyMeasurable[A.history (roundTime K r)] v ν) :
    (∫ ω, ⟪v ω, serverDisplacement A r ω⟫_ℝ ∂ν) =
      -effectiveStep K ηl ηg * (∫ ω, ⟪v ω, meanSignal A r ω⟫_ℝ ∂ν) := by
  let b (i : Fin N) (ω : Ω) := averageOracle A r i ω - A.c r i ω + meanControl A r ω
  have hb (i : Fin N) : MemLp (b i) 2 ν :=
    ((A.averageOracle_memLp hr i).sub (A.c_memLp r hr.le i)).add
      (A.meanControl_memLp hr.le)
  have hbm (i : Fin N) :
      AEStronglyMeasurable[A.history (roundTime K r + K)] (b i) ν :=
    (((A.averageOracle_adapted hr i).sub ((A.c_adapted r hr.le i).mono
      (A.history.mono (Nat.le_add_right _ _)))).add
      ((A.meanControl_adapted hr.le).mono
        (A.history.mono (Nat.le_add_right _ _)))).aestronglyMeasurable
  have hiv (i : Fin N) : Integrable (fun ω ↦ ⟪v ω, b i ω⟫_ℝ) ν :=
    FedAvg.inner_integrable_of_memLp hv (hb i)
  have hs := A.sample_sum_integral hr (fun i ω ↦ ⟪v ω, b i ω⟫_ℝ) hiv
    (fun i ↦ (hm.mono (A.history.mono (Nat.le_add_right _ _))).inner (hbm i))
  have heq : (fun ω ↦ ⟪v ω, serverDisplacement A r ω⟫_ℝ) =ᵐ[ν]
      fun ω ↦ -(effectiveStep K ηl ηg / S) * ∑ i ∈ A.sample r ω, ⟪v ω, b i ω⟫_ℝ := by
    filter_upwards [A.server_displacement hr] with ω hω
    simp only [serverDisplacement, hω, sub_sub_cancel_left, inner_neg_right,
      inner_smul_right, inner_sum, neg_mul, b]
  rw [integral_congr_ae heq, integral_const_mul, hs]
  have hbpoint (ω : Ω) : ∑ i, b i ω = ∑ i, averageOracle A r i ω := by
    have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
    simp only [b, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, ← Nat.cast_smul_eq_nsmul ℝ,
      meanControl, smul_smul, mul_inv_cancel₀ hN, one_smul]
    abel
  have hi (i : Fin N) :
      (∫ ω, ⟪v ω, averageOracle A r i ω⟫_ℝ ∂ν) =
        ∫ ω, ⟪v ω, averageSignal A r i ω⟫_ℝ ∂ν := by
    have hz := integral_congr_ae (FedAvg.condExp_inner_zero hv
      (A.averageNoise_memLp hr i) hm (A.averageNoise_roundStart_zero hr i))
    rw [integral_condExp (A.history.le _)] at hz
    have he (ω : Ω) : averageOracle A r i ω =
        averageSignal A r i ω + averageNoise A r i ω := by
      have h := A.averageOracle_sub_signal_eq_noise r i ω
      rw [sub_eq_iff_eq_add] at h
      simpa only [add_comm] using h
    simp_rw [he, inner_add_right]
    rw [integral_add (FedAvg.inner_integrable_of_memLp hv (A.averageSignal_memLp hr i))
      (FedAvg.inner_integrable_of_memLp hv (A.averageNoise_memLp hr i))]
    simpa using hz
  have hsum : ∑ i, ∫ ω, ⟪v ω, b i ω⟫_ℝ ∂ν =
      ∑ i, ∫ ω, ⟪v ω, averageSignal A r i ω⟫_ℝ ∂ν := by
    rw [← integral_finsetSum Finset.univ (fun i _ ↦ hiv i)]
    simp_rw [← inner_sum, hbpoint, inner_sum]
    rw [integral_finsetSum Finset.univ (fun i _ ↦
      FedAvg.inner_integrable_of_memLp hv (A.averageOracle_memLp hr i))]
    simp_rw [hi]
  rw [hsum]
  simp only [meanSignal, inner_smul_right, inner_sum, integral_const_mul,
    integral_finsetSum Finset.univ (fun i _ ↦
      FedAvg.inner_integrable_of_memLp hv (A.averageSignal_memLp hr i)), smul_eq_mul]
  have hS : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
  field_simp

theorem Run.meanSignal_bias_pointwise (A : Run P ν S K T ηl ηg init)
    (r : ℕ) (ω : Ω) :
    ‖meanSignal A r ω - gradient (objective P.f) (A.x r ω)‖ ^ 2 ≤
      P.β ^ 2 * (((N : ℝ) * (K : ℝ))⁻¹ *
        ∑ i, ∑ k : Fin K, ‖A.y r k i ω - A.x r ω‖ ^ 2) := by
  have heq : meanSignal A r ω - gradient (objective P.f) (A.x r ω) =
      (N : ℝ)⁻¹ • ∑ i, (K : ℝ)⁻¹ • ∑ k : Fin K,
        (gradient (P.f i) (A.y r k i ω) - gradient (P.f i) (A.x r ω)) := by
    rw [P.gradient_objective]
    dsimp [meanSignal]
    rw [← smul_sub, ← Finset.sum_sub_distrib]
    congr 1
    apply Finset.sum_congr rfl
    intro i _
    rw [average_sub_const A.steps_pos]
    dsimp [averageSignal, clientGradient]
    rw [Fin.sum_univ_eq_sum_range (fun k ↦ gradient (P.f i) (A.y r k i ω))]
  rw [heq]
  apply (norm_average_sq_le P.clients_pos _).trans
  calc
    _ ≤ (N : ℝ)⁻¹ * ∑ i, (K : ℝ)⁻¹ * ∑ k : Fin K,
        ‖gradient (P.f i) (A.y r k i ω) - gradient (P.f i) (A.x r ω)‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact Finset.sum_le_sum (fun i _ ↦ norm_average_sq_le A.steps_pos _)
    _ ≤ (N : ℝ)⁻¹ * ∑ i, (K : ℝ)⁻¹ * ∑ k : Fin K,
        P.β ^ 2 * ‖A.y r k i ω - A.x r ω‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply Finset.sum_le_sum
      intro k _
      simpa only [mul_pow] using pow_le_pow_left₀ (norm_nonneg _)
        (P.smooth i (A.y r k i ω) (A.x r ω)) 2
    _ = _ := by simp only [← Finset.mul_sum, mul_inv_rev]; ring

theorem Run.meanSignal_bias_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    (∫ ω, ‖meanSignal A r ω - gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) ≤
      P.β ^ 2 * driftEnergy A r := by
  have hd (i : Fin N) (k : Fin K) : Integrable (fun ω ↦
      ‖A.y r k i ω - A.x r ω‖ ^ 2) ν :=
    ((A.y_memLp r hr k k.isLt.le i).sub (A.x_memLp r hr.le)).norm.integrable_sq
  have hi := integral_mono
    (((A.meanSignal_memLp hr).sub (P.objectiveGradient_memLp_comp
      (A.x_memLp r hr.le))).norm.integrable_sq)
    (((integrable_finsetSum Finset.univ (fun i _ ↦
      integrable_finsetSum Finset.univ (fun k _ ↦ hd i k))).const_mul
      (((N : ℝ) * (K : ℝ))⁻¹)).const_mul (P.β ^ 2))
    (A.meanSignal_bias_pointwise r)
  simpa only [driftEnergy, integral_const_mul,
    integral_finsetSum Finset.univ (fun i _ ↦
      integrable_finsetSum Finset.univ (fun k _ ↦ hd i k)),
    integral_finsetSum Finset.univ (fun k _ ↦ hd _ k)] using hi

theorem Run.meanServerSecondMoment_signal_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) : meanServerSecondMoment A r ≤
      (effectiveStep K ηl ηg) ^ 2 * (∫ ω, ‖meanSignal A r ω‖ ^ 2 ∂ν) := by
  let v := ν[serverDisplacement A r | A.history (roundTime K r)]
  have hv : MemLp v 2 ν := (A.serverDisplacement_memLp hr).condExp
  have hm : AEStronglyMeasurable[A.history (roundTime K r)] v ν :=
    stronglyMeasurable_condExp.aestronglyMeasurable
  have hi := A.server_inner_integral hr v hv hm
  have hc := integral_inner_condExp_right (A.history.le _) hv
    (A.serverDisplacement_memLp hr) hm
  have hvv : (∫ ω, ⟪v ω, serverDisplacement A r ω⟫_ℝ ∂ν) =
      meanServerSecondMoment A r := by
    rw [hc]
    simp only [v, real_inner_self_eq_norm_sq, meanServerSecondMoment]
  rw [hvv] at hi
  have hp : 0 ≤ ∫ ω, ‖v ω + effectiveStep K ηl ηg • meanSignal A r ω‖ ^ 2 ∂ν :=
    integral_nonneg (fun _ ↦ sq_nonneg _)
  have hn := (A.meanSignal_memLp hr).const_smul (effectiveStep K ηl ηg)
  have hcross : Integrable (fun ω ↦
      ⟪v ω, effectiveStep K ηl ηg • meanSignal A r ω⟫_ℝ) ν :=
    FedAvg.inner_integrable_of_memLp hv hn
  have hfirst : Integrable (fun ω ↦ ‖v ω‖ ^ 2 +
      2 * ⟪v ω, effectiveStep K ηl ηg • meanSignal A r ω⟫_ℝ) ν :=
    hv.norm.integrable_sq.add (hcross.const_mul 2)
  have hlast : Integrable (fun ω ↦
      ‖effectiveStep K ηl ηg • meanSignal A r ω‖ ^ 2) ν := hn.norm.integrable_sq
  simp_rw [norm_add_sq_real] at hp
  rw [integral_add hfirst hlast,
    integral_add hv.norm.integrable_sq (hcross.const_mul 2), integral_const_mul] at hp
  simp only [inner_smul_right, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs,
    integral_const_mul] at hp
  change 0 ≤ meanServerSecondMoment A r +
    2 * (effectiveStep K ηl ηg * (∫ ω, ⟪v ω, meanSignal A r ω⟫_ℝ ∂ν)) +
      (effectiveStep K ηl ηg) ^ 2 * (∫ ω, ‖meanSignal A r ω‖ ^ 2 ∂ν) at hp
  linarith

theorem Run.meanServerSecondMoment_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) : meanServerSecondMoment A r ≤
      2 * (effectiveStep K ηl ηg) ^ 2 *
        ((∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
          P.β ^ 2 * driftEnergy A r) := by
  have hg := P.objectiveGradient_memLp_comp (A.x_memLp r hr.le)
  have he := (A.meanSignal_memLp hr).sub hg
  have hi := integral_mono (A.meanSignal_memLp hr).norm.integrable_sq
    ((hg.norm.integrable_sq.const_mul 2).add (he.norm.integrable_sq.const_mul 2))
    (fun ω ↦ show ‖meanSignal A r ω‖ ^ 2 ≤
        2 * ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 +
          2 * ‖meanSignal A r ω - gradient (objective P.f) (A.x r ω)‖ ^ 2 by
      simpa only [add_sub_cancel] using norm_add_sq_le_two
        (gradient (objective P.f) (A.x r ω))
        (meanSignal A r ω - gradient (objective P.f) (A.x r ω)))
  simp only [Pi.add_apply] at hi
  rw [integral_add (hg.norm.integrable_sq.const_mul 2)
    (he.norm.integrable_sq.const_mul 2), integral_const_mul, integral_const_mul] at hi
  simp only [Pi.sub_apply] at hi
  have hb := A.meanSignal_bias_bound hr
  have hs := A.meanServerSecondMoment_signal_le hr
  have hh := mul_le_mul_of_nonneg_left (show
      (∫ ω, ‖meanSignal A r ω‖ ^ 2 ∂ν) ≤
        2 * ((∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
          P.β ^ 2 * driftEnergy A r) by linarith) (sq_nonneg (effectiveStep K ηl ηg))
  nlinarith

theorem negative_inner_signal_le (g s : Space d) :
    -⟪g, s⟫_ℝ ≤ -(3 / 4 : ℝ) * ‖g‖ ^ 2 + ‖s - g‖ ^ 2 := by
  have h := neg_two_inner_le g (s - g) (by norm_num : (0 : ℝ) < 1 / 2)
  rw [inner_sub_right, real_inner_self_eq_norm_sq] at h
  norm_num at h
  linarith

theorem Run.objective_descent_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (hh : 0 ≤ effectiveStep K ηl ηg) :
    (∫ ω, objective P.f (A.x (r + 1) ω) ∂ν) ≤
      (∫ ω, objective P.f (A.x r ω) ∂ν) -
        (3 / 4 : ℝ) * effectiveStep K ηl ηg *
          (∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
        effectiveStep K ηl ηg * P.β ^ 2 * driftEnergy A r +
        P.β / 2 * serverSecondMoment A r := by
  let g (ω : Ω) := gradient (objective P.f) (A.x r ω)
  have hg : MemLp g 2 ν := P.objectiveGradient_memLp_comp (A.x_memLp r hr.le)
  have hm : AEStronglyMeasurable[A.history (roundTime K r)] g ν := by
    have hl : LipschitzWith ⟨P.β, P.smoothness_pos.le⟩ (gradient (objective P.f)) :=
      lipschitzWith_iff_norm_sub_le.mpr P.smooth_objective
    exact (hl.continuous.comp_stronglyMeasurable (A.x_adapted r hr.le)).aestronglyMeasurable
  have hD := A.serverDisplacement_memLp hr
  have hf := P.objective_integrable_comp (A.x_memLp r hr.le)
  have hI := FedAvg.inner_integrable_of_memLp hg hD
  have hM := hD.norm.integrable_sq
  have hFI : Integrable (fun ω ↦ objective P.f (A.x r ω) +
      ⟪g ω, serverDisplacement A r ω⟫_ℝ) ν := hf.add hI
  have hi := integral_mono (P.objective_integrable_comp
    (A.x_memLp (r + 1) (Nat.succ_le_of_lt hr)))
    ((hf.add hI).add (hM.const_mul (P.β / 2)))
    (fun ω ↦ P.objective_descent (A.x r ω) (A.x (r + 1) ω))
  simp only [Pi.add_apply] at hi
  rw [integral_add hFI (hM.const_mul (P.β / 2)),
    integral_add hf hI, integral_const_mul, A.server_inner_integral hr g hg hm] at hi
  have he := (A.meanSignal_memLp hr).sub hg
  have hj := integral_mono
    ((FedAvg.inner_integrable_of_memLp hg (A.meanSignal_memLp hr)).neg)
    ((hg.norm.integrable_sq.const_mul (-(3 / 4 : ℝ))).add he.norm.integrable_sq)
    (fun ω ↦ negative_inner_signal_le (g ω) (meanSignal A r ω))
  simp only [Pi.add_apply, Pi.neg_apply] at hj
  rw [integral_neg, integral_add (hg.norm.integrable_sq.const_mul (-(3 / 4 : ℝ)))
    he.norm.integrable_sq, integral_const_mul] at hj
  simp only [Pi.sub_apply] at hj
  have heB := A.meanSignal_bias_bound hr
  have hmul := mul_le_mul_of_nonneg_left (hj.trans (add_le_add_right heB _)) hh
  change _ ≤ _ + _ + P.β / 2 * serverSecondMoment A r at hi
  dsimp [g] at hi hj hmul
  nlinarith

theorem Run.meanSignal_convex_inner_pointwise (A : Run P ν S K T ηl ηg init)
    {μ : ℝ} (hc : Convexity P μ) (xstar : Space d) (r : ℕ) (ω : Ω) :
    objective P.f (A.x r ω) - objective P.f xstar + μ / 4 * ‖A.x r ω - xstar‖ ^ 2 -
      P.β * (((N : ℝ) * (K : ℝ))⁻¹ *
        ∑ i, ∑ k : Fin K, ‖A.y r k i ω - A.x r ω‖ ^ 2) ≤
      ⟪A.x r ω - xstar, meanSignal A r ω⟫_ℝ := by
  have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
  have hi (i : Fin N) :
      P.f i (A.x r ω) - P.f i xstar + μ / 4 * ‖A.x r ω - xstar‖ ^ 2 -
        P.β * ((K : ℝ)⁻¹ * ∑ k : Fin K, ‖A.y r k i ω - A.x r ω‖ ^ 2) ≤
          ⟪A.x r ω - xstar, averageSignal A r i ω⟫_ℝ := by
    have hp (k : Fin K) := SCAFFOLD.PerturbedStrongConvexity d N P μ hc i
      (A.y r k i ω) xstar (A.x r ω)
    have hs := mul_le_mul_of_nonneg_left
      (Finset.sum_le_sum (s := Finset.univ) (fun k _ ↦ hp k))
      (inv_nonneg.mpr (Nat.cast_nonneg K : (0 : ℝ) ≤ K))
    simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← Finset.mul_sum] at hs
    have he : averageSignal A r i ω = (K : ℝ)⁻¹ • ∑ k : Fin K,
        gradient (P.f i) (A.y r k i ω) := by
      dsimp [averageSignal, clientGradient]
      rw [Fin.sum_univ_eq_sum_range (fun k ↦ gradient (P.f i) (A.y r k i ω))]
    rw [he, inner_smul_right, inner_sum]
    convert hs using 1 <;> simp only [norm_sub_rev, real_inner_comm] <;> field_simp
  have hs := mul_le_mul_of_nonneg_left
    (Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ hi i))
    (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
  simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← Finset.mul_sum] at hs
  simp only [meanSignal, inner_smul_right, inner_sum]
  convert hs using 1
  dsimp [objective]
  field_simp

theorem Run.meanSignal_convex_inner_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {μ : ℝ} (hc : Convexity P μ) (xstar : Space d) :
    expectedGap A xstar r + μ / 4 * distanceEnergy A xstar r - P.β * driftEnergy A r ≤
      ∫ ω, ⟪A.x r ω - xstar, meanSignal A r ω⟫_ℝ ∂ν := by
  have hx : MemLp (fun ω ↦ A.x r ω - xstar) 2 ν :=
    (A.x_memLp r hr.le).sub (memLp_const xstar)
  have hd (i : Fin N) (k : Fin K) : Integrable (fun ω ↦
      ‖A.y r k i ω - A.x r ω‖ ^ 2) ν :=
    ((A.y_memLp r hr k k.isLt.le i).sub (A.x_memLp r hr.le)).norm.integrable_sq
  have hD : Integrable (fun ω ↦ ((N : ℝ) * (K : ℝ))⁻¹ *
      ∑ i, ∑ k : Fin K, ‖A.y r k i ω - A.x r ω‖ ^ 2) ν :=
    (integrable_finsetSum Finset.univ (fun i _ ↦
      integrable_finsetSum Finset.univ (fun k _ ↦ hd i k))).const_mul _
  have hsum : Integrable (fun ω ↦ objective P.f (A.x r ω) - objective P.f xstar +
      μ / 4 * ‖A.x r ω - xstar‖ ^ 2) ν :=
    (A.gap_integrable xstar hr.le).add (hx.norm.integrable_sq.const_mul (μ / 4))
  have hi := integral_mono (hsum.sub (hD.const_mul P.β))
    (FedAvg.inner_integrable_of_memLp hx (A.meanSignal_memLp hr))
    (A.meanSignal_convex_inner_pointwise hc xstar r)
  simp only [Pi.sub_apply] at hi
  rw [integral_sub hsum (hD.const_mul P.β),
    integral_add (A.gap_integrable xstar hr.le) (hx.norm.integrable_sq.const_mul (μ / 4)),
    integral_const_mul, integral_const_mul, integral_const_mul,
    integral_finsetSum Finset.univ (fun i _ ↦
      integrable_finsetSum Finset.univ (fun k _ ↦ hd i k))] at hi
  simp only [integral_finsetSum Finset.univ (fun k _ ↦ hd _ k)] at hi
  exact hi

theorem Run.distance_descent_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (hh : 0 ≤ effectiveStep K ηl ηg)
    {μ : ℝ} (hc : Convexity P μ) (xstar : Space d) :
    distanceEnergy A xstar (r + 1) ≤
      (1 - μ * effectiveStep K ηl ηg / 2) * distanceEnergy A xstar r -
        2 * effectiveStep K ηl ηg * expectedGap A xstar r +
        2 * P.β * effectiveStep K ηl ηg * driftEnergy A r + serverSecondMoment A r := by
  let v (ω : Ω) := A.x r ω - xstar
  have hv : MemLp v 2 ν := (A.x_memLp r hr.le).sub (memLp_const xstar)
  have hm : AEStronglyMeasurable[A.history (roundTime K r)] v ν :=
    ((A.x_adapted r hr.le).sub stronglyMeasurable_const).aestronglyMeasurable
  have hD := A.serverDisplacement_memLp hr
  have hI := FedAvg.inner_integrable_of_memLp hv hD
  have hsum : Integrable (fun ω ↦ ‖v ω‖ ^ 2 +
      2 * ⟪v ω, serverDisplacement A r ω⟫_ℝ) ν :=
    hv.norm.integrable_sq.add (hI.const_mul 2)
  have he (ω : Ω) : ‖A.x (r + 1) ω - xstar‖ ^ 2 =
      ‖v ω‖ ^ 2 + 2 * ⟪v ω, serverDisplacement A r ω⟫_ℝ +
        ‖serverDisplacement A r ω‖ ^ 2 := by
    rw [← norm_add_sq_real]
    congr 2
    dsimp [v, serverDisplacement]
    abel
  have hi : distanceEnergy A xstar (r + 1) = distanceEnergy A xstar r +
      2 * (∫ ω, ⟪v ω, serverDisplacement A r ω⟫_ℝ ∂ν) + serverSecondMoment A r := by
    simp only [distanceEnergy, he]
    rw [integral_add hsum hD.norm.integrable_sq,
      integral_add hv.norm.integrable_sq (hI.const_mul 2), integral_const_mul]
    rfl
  rw [A.server_inner_integral hr v hv hm] at hi
  have hlo := mul_le_mul_of_nonneg_left (A.meanSignal_convex_inner_bound hr hc xstar)
    (show 0 ≤ 2 * effectiveStep K ηl ηg by positivity)
  dsimp [v] at hi
  nlinarith

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule22
/- END Definitions.SCAFFOLD.ServerProgress -/

/- BEGIN Definitions.SCAFFOLD.ConvexRecurrence -/
section SCAFFOLDBundleModule23
/-!
Actual SCAFFOLD convex Lyapunov decrease, derived from the Run laws.
Source: Karimireddy et al., arXiv:1910.06378v4, Section 5, PDF p. 5,
Theorem III; Appendix E.1, PDF pp. 26-31, Lemmas 12-15.
The control energy uses retained noiseless signals; retained oracle errors
are bounded separately. The Lyapunov recurrence follows from the published Run laws.
-/

noncomputable section
open MeasureTheory
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

theorem Run.convexPotential_recurrence (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (hg : 1 ≤ ηg) (hh : 0 ≤ effectiveStep K ηl ηg)
    {μ : ℝ} (hc : Convexity P μ) {xstar : Space d} (hx : IsMinimizer P xstar)
    (ht : P.β * effectiveStep K ηl ηg ≤ 1 / 81)
    (hm : μ * effectiveStep K ηl ηg ≤ ((S : ℝ) / (N : ℝ)) / 15) :
    convexPotential A xstar (r + 1) ≤
      (1 - μ * effectiveStep K ηl ηg / 2) * convexPotential A xstar r -
      effectiveStep K ηl ηg * expectedGap A xstar r +
      12 * (effectiveStep K ηl ηg) ^ 2 * P.σ ^ 2 / ((K : ℝ) * (S : ℝ)) *
        (1 + (S : ℝ) / ηg ^ 2) := by
  let h := effectiveStep K ηl ηg
  let p := (S : ℝ) / (N : ℝ)
  let t := P.β * h
  let z := 1 / ηg ^ 2
  let L := 9 * h ^ 2 / p
  let C := controlEnergy A xstar r
  let F := expectedGap A xstar r
  let D := driftEnergy A r
  let X := distanceEnergy A xstar r
  let B := h ^ 2 * P.σ ^ 2 / ((K : ℝ) * (S : ℝ))
  let Q := h ^ 2 * P.σ ^ 2 / ((K : ℝ) * ηg ^ 2)
  have hβ := P.smoothness_pos
  have hN : (0 : ℝ) < N := by exact_mod_cast P.clients_pos
  have hS : (0 : ℝ) < S := by exact_mod_cast A.sample_pos
  have hK : (0 : ℝ) < K := by exact_mod_cast A.steps_pos
  have hp : 0 < p := div_pos hS hN
  have hs1 : (1 : ℝ) ≤ S := by exact_mod_cast A.sample_pos
  have hg0 : 0 < ηg := by linarith
  have hz0 : 0 ≤ z := by dsimp [z]; positivity
  have hz1 : z ≤ 1 := by
    apply (div_le_one (sq_pos_of_pos hg0)).2
    nlinarith
  have ht0 : 0 ≤ t := mul_nonneg hβ.le hh
  have hL : 0 ≤ L := by dsimp [L]; positivity
  have hC : 0 ≤ C := controlEnergy_nonneg A xstar r
  have hF : 0 ≤ F := A.expectedGap_nonneg hx r
  have hD : 0 ≤ D := A.driftEnergy_nonneg r
  have hQ : 0 ≤ Q := by dsimp [Q]; positivity
  have hnoise : 0 ≤ P.σ ^ 2 / ((K : ℝ) * (S : ℝ)) := by positivity
  have hcs : 4 * C / (S : ℝ) ≤ 8 * C := by
    apply (div_le_iff₀ hS).2
    nlinarith only [mul_le_mul_of_nonneg_left hs1 hC, hC]
  have hM := A.serverSecondMoment_convex hr hc.zero hx
  change serverSecondMoment A r ≤ h ^ 2 *
    (8 * P.β * F + 4 * C / S + 4 * P.β ^ 2 * D +
      8 * P.σ ^ 2 / ((K : ℝ) * S)) at hM
  have hM' : serverSecondMoment A r ≤ h ^ 2 *
      (8 * P.β * F + 8 * C + 4 * P.β ^ 2 * D +
        12 * P.σ ^ 2 / ((K : ℝ) * S)) := by
    apply hM.trans
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg h)
    simp only [mul_div_assoc] at hcs ⊢
    linarith only [hcs, hnoise]
  have hd := A.distance_descent_bound hr hh hc xstar
  change distanceEnergy A xstar (r + 1) ≤ (1 - μ * h / 2) * X -
    2 * h * F + 2 * P.β * h * D + serverSecondMoment A r at hd
  have hcontrol := A.controlEnergy_recurrence hr hc hx
  change controlEnergy A xstar (r + 1) ≤ (1 - p) * C +
    p * (4 * P.β * F + 2 * P.β ^ 2 * D) at hcontrol
  have hcl := mul_le_mul_of_nonneg_left hcontrol hL
  have hraw : distanceEnergy A xstar (r + 1) + L * controlEnergy A xstar (r + 1) ≤
      (1 - μ * h / 2) * X - 2 * h * F + 2 * P.β * h * D +
      h ^ 2 * (8 * P.β * F + 8 * C + 4 * P.β ^ 2 * D +
        12 * P.σ ^ 2 / ((K : ℝ) * S)) +
      L * ((1 - p) * C + p * (4 * P.β * F + 2 * P.β ^ 2 * D)) := by
    linarith only [hd, hM', hcl]
  have hpre : distanceEnergy A xstar (r + 1) + L * controlEnergy A xstar (r + 1) ≤
      (1 - μ * h / 2) * (X + L * C) + (44 * t - 2) * (h * F) +
      (-1 + 9 * (μ * h) / (2 * p)) * (h ^ 2 * C) +
      (2 + 22 * t) * (P.β * h * D) + 12 * B := by
    convert hraw using 1
    dsimp only [L, t, B]
    field_simp
    <;> ring
  have hdr := A.convex_drift_bound hr hg ht ht0 hc.zero hx
  change D ≤ h ^ 2 / ηg ^ 2 * (24 * P.β * F + 12 * C + 9 * P.σ ^ 2 / K) at hdr
  have hdrs := mul_le_mul_of_nonneg_left hdr
    (show 0 ≤ 3 * P.β * h by positivity)
  have hdr' : 3 * (P.β * h * D) ≤
      72 * t ^ 2 * (h * F * z) + 36 * t * (h ^ 2 * C * z) + 27 * t * Q := by
    convert hdrs using 1 <;> dsimp only [t, z, Q] <;> ring
  obtain ⟨h72, h36, h27⟩ := convex_drift_coefficients ht0 ht
  have h72' := mul_le_mul_of_nonneg_right h72 (show 0 ≤ h * F * z by positivity)
  have h36' := mul_le_mul_of_nonneg_right h36
    (show 0 ≤ h ^ 2 * C * z by positivity)
  have h27' := mul_le_mul_of_nonneg_right h27 hQ
  have hcz : h ^ 2 * C * z ≤ h ^ 2 * C :=
    mul_le_of_le_one_right (by positivity) hz1
  have hdrift : 3 * (P.β * h * D) ≤ (2 / 3) * (h ^ 2 * C) + (h * F) * z / 25 + Q := by
    nlinarith only [hdr', h72', h36', h27', hcz]
  have hout := convex_recurrence_combine ht hp hm hz1
    (show 0 ≤ h * F by positivity) (show 0 ≤ h ^ 2 * C by positivity)
    (show 0 ≤ P.β * h * D by positivity) hQ hdrift hpre
  have he (r : ℕ) : distanceEnergy A xstar r + L * controlEnergy A xstar r =
      convexPotential A xstar r := by
    dsimp only [convexPotential, L, p, h]
    field_simp
  change distanceEnergy A xstar (r + 1) + L * controlEnergy A xstar (r + 1) ≤
    (1 - μ * h / 2) * (distanceEnergy A xstar r + L * controlEnergy A xstar r) -
    h * F + 12 * (B + Q) at hout
  rw [he (r + 1), he r] at hout
  convert hout using 1
  dsimp only [B, Q, h, F]
  field_simp
  <;> ring

theorem Run.convex_finiteRound_bound {c0 : Fin N → Space d}
    (A : Run P ν S K T ηl ηg (some c0)) {μ : ℝ}
    (hc : Convexity P μ) {xstar : Space d} (hx : IsMinimizer P xstar)
    (hη : 0 < ηl) (hg : 1 ≤ ηg)
    (hstep : effectiveStep K ηl ηg ≤ 1 / (81 * P.β))
    (hμ : μ * effectiveStep K ηl ηg ≤ (S : ℝ) / (15 * (N : ℝ))) :
    weightedGap A xstar μ ≤ convexRHS P S K T ηl ηg μ c0 xstar := by
  have hh := A.effectiveStep_pos hη hg
  have hsmall : P.β * effectiveStep K ηl ηg ≤ 1 / 81 := by
    calc
      _ ≤ P.β * (1 / (81 * P.β)) :=
        mul_le_mul_of_nonneg_left hstep P.smoothness_pos.le
      _ = _ := by have := P.smoothness_pos.ne'; field_simp
  have hm : μ * effectiveStep K ηl ηg ≤ ((S : ℝ) / (N : ℝ)) / 15 := by
    convert hμ using 1 <;> ring
  exact A.convex_finiteRound_of_recurrence xstar μ hh (A.convex_weight_base_pos hμ)
    (fun _ hr ↦ A.convexPotential_recurrence hr hg hh.le hc hx hsmall hm)

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule23
/- END Definitions.SCAFFOLD.ConvexRecurrence -/

/- BEGIN Theorems.Thm_SCAFFOLD_ConvexFiniteRoundConvergence -/
section SCAFFOLDBundleModule24
open MeasureTheory SCAFFOLD
universe u

/-! Karimireddy et al., SCAFFOLD, arXiv:1910.06378v4, Section 5, PDF p. 5,
Theorem III; Appendix E.1, PDF pp. 26-31, Lemmas 12-15 and the convex
finite-round display on PDF p. 31. -/

theorem solution :
  ∀ (d N : ℕ) (P : Problem d N) (Ω : Type u) [MeasurableSpace Ω]
    [StandardBorelSpace Ω] (ν : Measure Ω) [IsProbabilityMeasure ν]
    (S K T : ℕ) (ηl ηg μ : ℝ) (c0 : Fin N → Space d) (xstar : Space d),
    Convexity P μ → IsMinimizer P xstar → 0 < ηl → 1 ≤ ηg →
    effectiveStep K ηl ηg ≤ 1 / (81 * P.β) →
    μ * effectiveStep K ηl ηg ≤ (S : ℝ) / (15 * (N : ℝ)) →
    ∀ A : Run P ν S K T ηl ηg (some c0),
      weightedGap A xstar μ ≤ convexRHS P S K T ηl ηg μ c0 xstar := by
  intro d N P Ω _ _ ν _ S K T ηl ηg μ c0 xstar hc hx hη hg hstep hμ A
  exact A.convex_finiteRound_bound hc hx hη hg hstep hμ

end SCAFFOLDBundleModule24
/- END Theorems.Thm_SCAFFOLD_ConvexFiniteRoundConvergence -/
