section
-- Source module: Solutions.KFMSm
/-!
# KFM Sm: bit bounds for register expressions from bounds on their atoms

`exSm A s e`: every register, literal and `2^a` that `e` reads is at most `A` in absolute value,
and every divisor is positive. `exDg e` is a degree (sums add one, products add). Then
`|e.eval s| ≤ A^{exDg e}` (**`exSm_abs`**), and `A^{exDg e} < 2^B` gives `e.Bnd s B`
(**`exSm_bnd`**), which is the hypothesis of the RS cost lemmas.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul RS

theorem zsz_of_abs {z : ℤ} {A B k : ℕ} (h : |z| ≤ (A : ℤ) ^ k) (hB : A ^ k < 2 ^ B) : zsz z ≤ B :=
  zsz_le_of_natAbs_le (M := A ^ k) (by rw [Int.abs_eq_natAbs] at h; exact_mod_cast h) hB

end NLogN.KFM

end

section
-- Source module: Solutions.R6SLib
/-!
# Round-six setup, part 2: register-program lemmas on managed states

All setup states are `encK s f` (`KIL`): the lists `f j` of integers pushed over the state `s`
after the reads. A step is a `Sp p s t c` (ok, run, cost). Every cost is a multiple of the unit
`kU Bb = 10^7 (Bb+2)^2` for a uniform bit bound `Bb`.

* `sp_push`, `sp_asg`, `sp_pop`: single steps.
* `sp_rep`: a counted loop `rep C (reg R) b` through a family of managed states.
* **`sp_cnt`** (`cntR`): `#{x ∈ [1, N] : Pr x}` by a test expression.
* **`sp_sum`** (`sumR`): `Σ_{y=1}^{c} y · [y g ≡ 1 (mod c)]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

theorem kU_ge (Bb : ℕ) : 20000 * (Bb + 2) + 100 ≤ kU Bb := by
  unfold kU; nlinarith

theorem isInt_encK_iff' (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) :
    (encK s f).IsInt i ↔ (f i ≠ [] ∨ s.IsInt i) := by
  rcases h : f i with _ | ⟨a, l⟩
  · simp only [ne_eq, not_true_eq_false, false_or]
    unfold IState.IsInt
    have e1 : (encK s f).G i = s.G i := by simp [h, ints]
    have e2 : (encK s f).top i = s.top i := by unfold IState.top; rw [e1]
    rw [e1, e2]
  · simp only [ne_eq, reduceCtorEq, not_false_eq_true, true_or, iff_true]
    exact isInt_encK h

/-! ## Single steps -/

section Steps

variable {s : IState HS} {f : Fin HS → List ℤ} {Bb : ℕ}

theorem sp_push {i : Fin HS} {e : Ex HS} {v : ℤ} (hi : i.val < 56) (hc : e.Clean)
    (hok : e.ok (encK s f)) (hv : e.eval (encK s f) = v) (hB : e.Bnd (encK s f) Bb) :
    Sp (.push i e) (encK s f) (encK s (update f i (v :: f i))) ((e.size + 1) * kU Bb) := by
  have h := Sp.pushQ s f hi hc hok hB
  rw [hv] at h
  exact h.mono (le_of_eq (by unfold kU; ring))

end Steps

/-! ## Counted loops -/

theorem sp_rep {C R : Fin HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ} {N c Bb : ℕ}
    {lR : List ℤ} (hC5 : C.val < 56) (hR5 : R.val < 56) (hC : ∀ k, F k C = [])
    (hw : C ∉ b.writes) (hR : F 0 R = (N : ℤ) :: lR) (hz : zsz (N : ℤ) ≤ Bb)
    (hb : ∀ k < N, Sp b (encK s (update (F k) C [(N : ℤ) - k]))
      (encK s (update (F (k + 1)) C [(N : ℤ) - k])) (c * kU Bb)) :
    Sp (.rep C (.reg R) b) (encK s (F 0)) (encK s (F N)) ((N * (c + 1) + 1) * kU Bb) := by
  have H := Sp.rep (n := .reg R) (B := Bb) (c := c * kU Bb) hC5 hC hw (clean_of_lt hR5)
    (isInt_encK hR) trivial (by simp only [Ex.Bnd, top_encK hR]; exact hz)
    (by simp only [Ex.eval, top_encK hR]) hb
  refine H.mono ?_
  have h1 := kU_ge Bb
  simp only [Ex.size]
  generalize kU Bb = K at h1 ⊢
  have h4 : 8000 * (Bb + 2) + 30 ≤ K := by omega
  have h5 : c * K + 8000 * (Bb + 2) + 30 ≤ (c + 1) * K := by
    have : (c + 1) * K = c * K + K := by ring
    linarith
  have h2 : N * (c * K + 8000 * (Bb + 2) + 30) ≤ N * ((c + 1) * K) := Nat.mul_le_mul_left _ h5
  have h3 : (N * (c + 1) + 1) * K = N * ((c + 1) * K) + K := by ring
  rw [h3]; linarith

/-! ## Counting -/

/-! ## The inverse sum -/

end IntMul.Kappa.R6

