  rw [Module.End.mul_eq_comp, LinearMap.baseChange_comp, Module.End.mul_eq_comp]

theorem exists_pow_smul_eq_baseChange :
    ∀ τ ∈ rationalHeckeAlgebra 2 J, ∃ e : ℕ, ∃ α ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 J t),
