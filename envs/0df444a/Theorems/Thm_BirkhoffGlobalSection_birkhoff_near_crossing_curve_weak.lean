-- title:
--   Crossing curve of Birkhoff's near family (weak endpoint)
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. A state is $s=(z_1,z_2,w_1,w_2)$; its physical position relative to the primary is $(x_1,x_2)=(2(z_1^2-z_2^2),\,4z_1z_2)$, and $(v_1,v_2)$ denotes the physical (Jacobi) velocity. A collision state has $z=0$; on $K=0$ it has $|w|^2=1-\mu$. $N(r)$ and $F(r)$ are the perpendicular near and far starts at $z=(r,0)$ and $z=(0,r)$, and $(\sigma,\eta)$ are the shooting coordinates (velocity sine and depth $-x_2$).
--
--   **Near crossing curve, weak endpoint.** This is identical to `birkhoff_near_crossing_curve` except that the collision endpoint satisfies $-1\le\alpha<-\sqrt2/2$ instead of $-1<\alpha$.
--
--   There are $b>0$, $\alpha$ in this range, starts $S(r)$ on the near axis ($z_2=w_1=0$, $z_1\ne0$) and times $T(r)>0$ for $0<r<b$ such that:
--
--   - the crossing coordinates $r\mapsto(\sigma,\eta)(\varphi_{-T(r)}S(r))$ are continuous on $(0,b)$;
--   - they tend to $(\sqrt2/2,0)$ as $r\to0^+$ and to $(\alpha,0)$ as $r\to b^-$;
--   - each backward arc stays in $\{x_1>0,x_2<0\}$ and crosses $x_1=0$ at time $-T(r)$ with $x_2<0$.
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18 (Collected Mathematical Papers Vol. 1, pp. 731–741); Liu–Salomão, arXiv 2506.17867v2, §5, pp. 30–31

import Definitions.Def_BirkhoffShootingCoordinates
import Mathlib.Order.Filter.Basic
import Mathlib.Topology.Order.Basic

namespace BirkhoffGlobalSection

theorem birkhoff_near_crossing_curve_weak (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ) :
    ∃ b : ℝ, 0 < b ∧ ∃ α : ℝ, -1 ≤ α ∧ α < -(Real.sqrt 2 / 2) ∧
      ∃ S : ℝ → LeftEnergyState μ c, ∃ T : ℝ → ℝ,
        ContinuousOn (fun r : ℝ =>
          shootingCoordinates μ ((φ (-T r) (S r) : LeftEnergyState μ c) : Phase)) (Set.Ioo 0 b) ∧
        Filter.Tendsto (fun r : ℝ =>
          shootingCoordinates μ ((φ (-T r) (S r) : LeftEnergyState μ c) : Phase))
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (Real.sqrt 2 / 2, 0)) ∧
        Filter.Tendsto (fun r : ℝ =>
          shootingCoordinates μ ((φ (-T r) (S r) : LeftEnergyState μ c) : Phase))
          (nhdsWithin b (Set.Iio b)) (nhds (α, 0)) ∧
        ∀ r ∈ Set.Ioo 0 b,
          ((S r : LeftEnergyState μ c) : Phase) 1 = 0 ∧
          ((S r : LeftEnergyState μ c) : Phase) 2 = 0 ∧
          ((S r : LeftEnergyState μ c) : Phase) 0 ≠ 0 ∧
          0 < T r ∧
          (∀ t ∈ Set.Ioo (-T r) 0,
            0 < relativePosition μ ((φ t (S r) : LeftEnergyState μ c) : Phase) 0 ∧
            relativePosition μ ((φ t (S r) : LeftEnergyState μ c) : Phase) 1 < 0) ∧
          relativePosition μ ((φ (-T r) (S r) : LeftEnergyState μ c) : Phase) 1 < 0 ∧
          relativePosition μ ((φ (-T r) (S r) : LeftEnergyState μ c) : Phase) 0 = 0 := by sorry

end BirkhoffGlobalSection
