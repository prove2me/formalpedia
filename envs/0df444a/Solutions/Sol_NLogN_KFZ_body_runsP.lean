-- Source module: Solutions.KFHRec
/-!
# KFH: fixed-point record arrays and the `Q_p` truncation pass

**Record format.**  The array of Proposition 14 is a list `xs` of records, each record `r`
complex coefficients (`Fin r → ℂ`).  On the item stacks it is a Gaussian list `zs` (two integer
items per coefficient, `gflat`), records consecutive, coefficients in order, with one common
scale: `RecRep r F zs xs` says coefficient `c` of record `j` is `toC zs[j r + c] / 2^F`.
The scale `F` (number of fractional bits) is bookkeeping, not data: every halving of §5.4 is
`F ↦ F + 1` and costs nothing; the numerators stay exact (this is the guarded format of §5.4
with the reserved fractional zeros left implicit).  Bit widths are tracked by `GB w zs`.

**Truncation.** `truncP Δ N` replaces each of the `N` integer items `a` on top of stack `0` by
`a.tdiv 2^Δ` (truncation toward zero, `Ex.quo`, linear cost).  On numerators at scale
`p + Δ` this is exactly `Q_p` (`truncNum_tdiv`): `truncP_rep` gives
`RecRep r p zs' (QpArr p xs)` from `RecRep r (p + Δ) zs xs`.  Cost `O(N (w + Δ)) + O(Z)`
(`truncP_fsp`), no `Bb` factor.  The same pass with an exact divisor is the renormalisation step.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

/-! ## The record format -/

/-! ## Truncation toward zero of a dyadic numerator -/

theorem truncNum_tdiv (p Δ : ℕ) (a : ℤ) :
    Butterfly.truncNum p ((a : ℝ) / 2 ^ (p + Δ)) = a.tdiv (2 ^ Δ) := by
  have h2 : (0 : ℝ) < 2 ^ p := by positivity
  have hx : (a : ℝ) / 2 ^ (p + Δ) * 2 ^ p = (a : ℝ) / ((2 ^ Δ : ℕ) : ℝ) := by
    rw [pow_add]; push_cast; field_simp
  unfold Butterfly.truncNum
  rw [hx]
  have hD : (0 : ℤ) < 2 ^ Δ := by positivity
  split_ifs with h
  · have ha : 0 ≤ a := by
      by_contra h'; push Not at h'
      have : (a : ℝ) < 0 := by exact_mod_cast h'
      have : (a : ℝ) / 2 ^ (p + Δ) < 0 := div_neg_of_neg_of_pos this (by positivity)
      linarith
    rw [Int.floor_div_natCast, Int.floor_intCast, Int.tdiv_eq_ediv_of_nonneg ha]; push_cast; rfl
  · push Not at h
    have ha : a < 0 := by
      by_contra h'; push Not at h'
      have : (0 : ℝ) ≤ a := by exact_mod_cast h'
      have : (0 : ℝ) ≤ (a : ℝ) / 2 ^ (p + Δ) := div_nonneg this (by positivity)
      linarith
    have e : (a : ℝ) / ((2 ^ Δ : ℕ) : ℝ) = -(((-a : ℤ) : ℝ) / ((2 ^ Δ : ℕ) : ℝ)) := by
      push_cast; ring
    rw [e, Int.ceil_neg, Int.floor_div_natCast, Int.floor_intCast,
      show a.tdiv (2 ^ Δ) = -((-a).tdiv (2 ^ Δ)) by rw [Int.neg_tdiv, neg_neg],
      Int.tdiv_eq_ediv_of_nonneg (by omega)]
    push_cast; rfl

theorem Qp_toC (p Δ : ℕ) (z : GI) :
    Butterfly.Qp p (toC z / 2 ^ (p + Δ)) = toC (gtr Δ z) / 2 ^ p := by
  apply Complex.ext
  · simp only [Butterfly.Qp, Butterfly.truncR, toC, gtr]
    rw [Butterfly.re_dy, truncNum_tdiv, Butterfly.re_dy]
  · simp only [Butterfly.Qp, Butterfly.truncR, toC, gtr]
    rw [Butterfly.im_dy, truncNum_tdiv, Butterfly.im_dy]

/-! ## The truncation pass -/

end NLogN.KFH

end

