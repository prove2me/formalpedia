-- title:
--   The disclosed-prefix simulator, stage births and the pre-birth σ-algebra
-- statement:
--   At stage $k$ the simulator knows $u_1,\dots,u_k$ and $v_1,\dots,v_{k-1}$ have been disclosed, computes the chain coordinates of each query and sets future activations to zero. The stage-$k$ gate is $|w_k|\ge1/2$ and $\|x-a_k\|<\sqrt2\beta$ with $a_k=A\sum_{i\le k}g_iv_i$. A failed query is answered by
--   $$P+\sum_{i\le k}b_i(w)-\sum_{i\le k}[1-\chi(x-a_{<i})]c_i(w)+h(x-a_{<k}-Ag_kv_k)\qquad(131)$$
--   and a crossing by
--   $$P+\sum_{i\le k}b_i(w)+h(x-a_k)+\chi(x-a_k)b_{k+1}(w)\qquad(132)$$
--   (last term absent at $k=T$), each plus the prefix noise $N_j^{(k)}$ (42). A crossing reveals $v_k$ and $u_{k+1}$ and starts stage $k+1$; at $k=T$ the run is complete. The final output is one more gate test. Also defined: the event that stage $k$ is born and completes within $\ell_0$ tests, the σ-algebra $\mathcal G_{<k}$ generated by the seed, $U$, $v_{<k}$ and all earlier-stage tensors (133), and the uniform law on the residual sphere orthogonal to $v_{<k}$.
--
--   **Formalization Note.** Stages are 0-based. The simulated algorithm sees replies, gate bits and disclosed frames; replies after completion are $0$; after the output the run is padded with the point $(0,0)$, which never passes a gate.
-- source:
--   Xia, Yuan, On Global Joint Lower Bounds in Zeroth-Order Nonconvex Optimization, arXiv:2610.19652, (40)–(42), pp.22–23; Lemma E.2, (130)–(135), pp.67–69; Lemma E.3, p.71

import Mathlib
import Definitions.Def_ZOGlobalLB_NoiseField

open MeasureTheory ProbabilityTheory
open scoped RealInnerProductSpace

namespace ZOGlobalLB

/-! # The disclosed-prefix simulator

Xia, Yuan, arXiv:2610.19652, Section 3.4, (40)–(42), pp.22–23; Lemma E.2, pp.67–69, (130)–(135);
Lemma E.3, pp.69–71, (137)–(142).

The simulator works in normalized coordinates `(z, x)` with hidden frames `U`, `V` and the
tensors `G` of an ideal independent-label experiment (every label `j ∈ J` has its own
independent stage tensors, p.68). It keeps a current stage `k`. At stage `k` the prefix
`u_1, …, u_k`, `v_1, …, v_{k-1}` is disclosed; for every query it computes the disclosed chain
coordinates and sets the future activations to zero. The gate `G_k` (130) is
`|w_k| ≥ 1/2` and `‖x - a_k‖ < √2 β`, `a_k = A Σ_{i≤k} g_i v_i`. A failed query is answered by the
mean (131) plus the prefix noise (42); a crossing by the mean (132) plus the prefix noise, after
which `v_k` and (if `k < T`) `u_{k+1}` are revealed and the stage advances; at `k = T` the run is
marked complete. At most one gate is processed per paid query. The final output is one more
gate test (it receives no value and opens no label); after the output the run is padded with the
point `(0, 0)`, which never passes a gate (p.71).

**Formalization Note.**
* Stages are 0-based: stage index `k : Fin T` is the paper's stage `k + 1`; the stage counter
  `k = T` means completion.
* `SimObs r m = ℝ × Bool × E m × E r` is what the simulated algorithm receives after a paid query:
  the reply, the gate bit, and the disclosed `v_k` and `u_{k+1}` (zero vectors when nothing is
  disclosed). Initially `u_1` is disclosed. Past-stage tensors are not part of the record; the
  analysis conditions on the larger σ-algebra `Gless` (133), which contains them (`reading`).
* Replies after completion are `0` (the paper does not use them).
* The tensors of all labels form one array `G : J × (Fin T × Idx m) → ℝ`; label `j` uses
  `G (j, ·)`. -/

open Classical

/-- One observation of the simulated algorithm: reply, gate bit, disclosed `v_k`, disclosed
`u_{k+1}`. -/
abbrev SimObs (r m : ℕ) := ℝ × Bool × E m × E r

/-- **An algorithm interacting with the simulator** (p.68: "The algorithm … sees replies, gate
bits and disclosed frames"). At round `t`, from its seed, the initially disclosed `u_1` and the
`t` earlier observations, it outputs a point `(z, x)` (`Sum.inl`) or queries label `j` at `(z, x)`
(`Sum.inr`). Measurable in all its arguments. -/
structure SimAlg (r m : ℕ) (J S₀ : Type*) [MeasurableSpace J] [MeasurableSpace S₀] where
  /-- The query/stopping rule. -/
  next : (t : ℕ) → S₀ → E r → (Fin t → SimObs r m) → (E r × E m) ⊕ (J × E r × E m)
  /-- Joint measurability. -/
  measurable_next : ∀ t,
    Measurable (fun p : S₀ × E r × (Fin t → SimObs r m) => next t p.1 p.2.1 p.2.2)

/-- Activations with the future set to zero at stage `k`: `g_i` for `i ≤ k`, `0` for `i > k`. -/
noncomputable def gS {T : ℕ} (k : Fin T) (w : E T) (i : Fin T) : ℝ :=
  if i ≤ k then gAct w i else 0

/-- `‖g_{≥i}‖` with future activations zero. -/
noncomputable def sufGeS {T : ℕ} (k : Fin T) (w : E T) (i : Fin T) : ℝ :=
  Real.sqrt (∑ j ∈ Finset.univ.filter (fun j => i ≤ j), gS k w j ^ 2)

/-- `‖g_{>i}‖` with future activations zero; for `i < k` this is `‖(g_{i+1}, …, g_k)‖` of (42). -/
noncomputable def sufGtS {T : ℕ} (k : Fin T) (w : E T) (i : Fin T) : ℝ :=
  Real.sqrt (∑ j ∈ Finset.univ.filter (fun j => i < j), gS k w j ^ 2)

/-- The past center `a_{<i}` with future activations zero. -/
noncomputable def aBeforeS {m T : ℕ} (V : Fin T → E m) (k : Fin T) (w : E T) (i : Fin T) : E m :=
  Acst • ∑ j ∈ Finset.univ.filter (fun j => j < i), gS k w j • V j

/-- The center through stage `k`, `a_k = A Σ_{i≤k} g_i v_i` (130). -/
noncomputable def aUpto {m T : ℕ} (V : Fin T → E m) (k : Fin T) (w : E T) : E m :=
  Acst • ∑ i ∈ Finset.univ.filter (fun i => i ≤ k), gAct w i • V i

/-- The stage-`k` gate (130): `|w_k| ≥ 1/2` and `‖x - a_k‖ < √2 β`, with `w = Uᵀ y(z)`. -/
def gateS {r m T : ℕ} (U : Fin T → E r) (V : Fin T → E m) (k : Fin T) (z : E r) (x : E m) :
    Prop :=
  1 / 2 ≤ |wcoord U z k| ∧ ‖x - aUpto V k (wcoord U z)‖ < Real.sqrt 2 * betaC

/-- The failed-gate mean (131), p.67:
`P + Σ_{i≤k} b_i(w) - Σ_{i≤k} [1 - χ(x - a_{<i})] c_i(w) + h(x - a_{<k} - A g_k v_k)`, with
future activations zero. -/
noncomputable def failMean {r m T : ℕ} (U : Fin T → E r) (V : Fin T → E m) (k : Fin T)
    (z : E r) (x : E m) : ℝ :=
  Pconf T z + ∑ i ∈ Finset.univ.filter (fun i => i ≤ k), chainB (wcoord U z) i -
    ∑ i ∈ Finset.univ.filter (fun i => i ≤ k),
      (1 - chiC (x - aBeforeS V k (wcoord U z) i)) *
        (chainB (wcoord U z) i * tauC (sufGeS k (wcoord U z) i)) +
    wellH (x - aBeforeS V k (wcoord U z) k - (Acst * gAct (wcoord U z) k) • V k)

/-- The crossing mean (132), p.68: `P + Σ_{i≤k} b_i(w) + h(x - a_k) + χ(x - a_k) b_{k+1}(w)`, the
last term omitted at the last stage. -/
noncomputable def crossMean {r m T : ℕ} (U : Fin T → E r) (V : Fin T → E m) (k : Fin T)
    (z : E r) (x : E m) : ℝ :=
  Pconf T z + ∑ i ∈ Finset.univ.filter (fun i => i ≤ k), chainB (wcoord U z) i +
    wellH (x - aUpto V k (wcoord U z)) +
    (if h : k.val + 1 < T then
      chiC (x - aUpto V k (wcoord U z)) * chainB (wcoord U z) ⟨k.val + 1, h⟩ else 0)

/-- The prefix noise (42), p.23:
`N_j^{(k)}(w, x) = Σ_{i<k} τ(‖(g_{i+1}, …, g_k)‖) Q_{j,i}(x - a_{<i}, g_i) + Q_{j,k}(x - a_{<k}, g_k)`,
for the stage tensors `G (i, ·)` of one label. -/
noncomputable def prefixNoise {m T : ℕ} (σ : ℝ) (V : Fin T → E m) (k : Fin T)
    (G : Fin T × Idx m → ℝ) (w : E T) (x : E m) : ℝ :=
  ∑ i ∈ Finset.univ.filter (fun i => i ≤ k),
    tauC (sufGtS k w i) * Qfield σ (fun l => G (i, l)) (x - aBeforeS V k w i) (gS k w i)

/-- The initially disclosed `u_1`. -/
def firstU {r T : ℕ} (U : Fin T → E r) : E r := if h : 0 < T then U ⟨0, h⟩ else 0

/-- **The simulator run.** `simState … t = (k, running, obs)` after `t` gate tests: the stage
counter `k`, whether the algorithm is still running, and the `t` observations so far (zeros after
the output). A paid query or the output is one test; after the output the run is padded with the
point `(0, 0)`. -/
noncomputable def simState {r m T : ℕ} {J S₀ : Type*} [MeasurableSpace J] [MeasurableSpace S₀]
    (B : SimAlg r m J S₀) (σ : ℝ) (U : Fin T → E r) (V : Fin T → E m)
    (G : J × (Fin T × Idx m) → ℝ) (s : S₀) : (t : ℕ) → ℕ × Bool × (Fin t → SimObs r m)
  | 0 => (0, true, Fin.elim0)
  | t + 1 =>
    let st := simState B σ U V G s t
    if st.2.1 then
      match B.next t s (firstU U) st.2.2 with
      | Sum.inl zx =>
          (if h : st.1 < T then (if gateS U V ⟨st.1, h⟩ zx.1 zx.2 then st.1 + 1 else st.1)
            else st.1,
           false, Fin.snoc (α := fun _ => SimObs r m) st.2.2 0)
      | Sum.inr q =>
          if h : st.1 < T then
            if gateS U V ⟨st.1, h⟩ q.2.1 q.2.2 then
              (st.1 + 1, true, Fin.snoc (α := fun _ => SimObs r m) st.2.2
                (crossMean U V ⟨st.1, h⟩ q.2.1 q.2.2 +
                    prefixNoise σ V ⟨st.1, h⟩ (fun p => G (q.1, p)) (wcoord U q.2.1) q.2.2,
                  true, V ⟨st.1, h⟩, if h' : st.1 + 1 < T then U ⟨st.1 + 1, h'⟩ else 0))
            else
              (st.1, true, Fin.snoc (α := fun _ => SimObs r m) st.2.2
                (failMean U V ⟨st.1, h⟩ q.2.1 q.2.2 +
                    prefixNoise σ V ⟨st.1, h⟩ (fun p => G (q.1, p)) (wcoord U q.2.1) q.2.2,
                  false, 0, 0))
          else (st.1, true, Fin.snoc (α := fun _ => SimObs r m) st.2.2 0)
    else (st.1, false, Fin.snoc (α := fun _ => SimObs r m) st.2.2 0)

/-- Stage `k` is **born and fast** (p.71): it is born at some test count `t₀` (the stage counter
first equals `k` after `t₀` tests) and is completed within its first `ℓ₀` tests. -/
def StageFast {r m T : ℕ} {J S₀ : Type*} [MeasurableSpace J] [MeasurableSpace S₀]
    (B : SimAlg r m J S₀) (σ : ℝ) (U : Fin T → E r) (V : Fin T → E m)
    (G : J × (Fin T × Idx m) → ℝ) (s : S₀) (ℓ₀ : ℕ) (k : Fin T) : Prop :=
  ∃ t₀ : ℕ, (simState B σ U V G s t₀).1 = k ∧ (∀ t < t₀, (simState B σ U V G s t).1 < k) ∧
    k.val + 1 ≤ (simState B σ U V G s (t₀ + ℓ₀)).1

/-- The enlarged pre-birth σ-algebra `G_{<k}` (133), p.68: generated by the seed, the whole frame
`U`, the directions `v_i` of earlier stages, and the tensors of earlier stages of every label. -/
@[instance_reducible]
def Gless {Ω : Type*} {r m T : ℕ} {J S₀ : Type*} [MeasurableSpace S₀]
    (X₀ : Ω → S₀) (U : Ω → Fin T → E r) (V : Ω → Fin T → E m)
    (G : Ω → J × (Fin T × Idx m) → ℝ) (k : Fin T) : MeasurableSpace Ω :=
  MeasurableSpace.comap
    (fun ω => (X₀ ω, U ω, (fun i : Fin T => if i < k then V ω i else 0),
      (fun p : J × (Fin T × Idx m) => if p.2.1 < k then G ω p else 0)))
    inferInstance

/-- The uniform probability measure on the residual unit sphere
`S^{m-k-1} ∩ span(v_1, …, v_k)⊥` (0-based: orthogonal to `V i` for `i < k`), realized as the law
of the normalized orthogonal projection of a standard Gaussian vector (135). -/
noncomputable def residualUnif {m T : ℕ} (V : Fin T → E m) (k : Fin T) : Measure (E m) :=
  (stdGaussian (E m)).map (fun u =>
    ‖(Submodule.span ℝ (V '' {i | i < k}))ᗮ.starProjection u‖⁻¹ •
      (Submodule.span ℝ (V '' {i | i < k}))ᗮ.starProjection u)

end ZOGlobalLB


