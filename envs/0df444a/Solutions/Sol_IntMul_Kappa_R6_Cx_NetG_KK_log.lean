variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

lemma progOps_nil' : progOps ([] : List (GChunk Rl 576)) = [] := rfl
lemma runOps_nil' (Λ : Rl → Vt) : runOps ([] : List (GOp Rl)) Λ = Λ := rfl

/-! ## Stage one -/

variable (Λ0 : Rl → Vt) (htemp : ∀ n, Λ0 (Sum.inr n) = 0)
include htemp

/-! ## Stage two -/

/-! ## Corrections -/

omit htemp in
theorem K_log {a b : ℕ} (ha : a < NV) (hb : b < NV) (Λ : Rl → Vt) (hτ : Λ (τr a b) = 0) :
    runOps (progOps (K (a, b))) Λ (Xr a b) = -Λ (Xr a b) ∧
    runOps (progOps (K (a, b))) Λ (Yr a b) = Λ (Yr a b) + Λ (Xr a b) ∧
    ∀ r, r ≠ Xr a b → r ≠ Yr a b → r ≠ τr a b → runOps (progOps (K (a, b))) Λ r = Λ r := by
  have e : progOps (K (a, b)) = [⟨τr a b, Xr a b, 1⟩, ⟨Yr a b, τr a b, 1⟩, ⟨Xr a b, Xr a b, -2⟩] := rfl
  have hXτ : Xr a b ≠ τr a b := X_ne_τ
  have hYτ : Yr a b ≠ τr a b := Y_ne_τ
  rw [e]
  simp only [runOps, List.foldl_cons, List.foldl_nil, runOp]
  refine ⟨?_, ?_, fun r h1 h2 h3 => ?_⟩
  · have hXY : Xr a b ≠ Yr a b := X_ne_Y ha hb ha hb
    rw [Function.update_self, Function.update_of_ne hXY, Function.update_of_ne hXτ]
    module
  · have hXY : Yr a b ≠ Xr a b := fun e' => X_ne_Y ha hb ha hb e'.symm
    rw [Function.update_of_ne hXY, Function.update_self, Function.update_self, Function.update_of_ne hYτ, hτ]
    module
  · rw [Function.update_of_ne h1, Function.update_of_ne h2, Function.update_of_ne h3]

omit htemp in
theorem KK_log_sol_aux : ∀ (P : List (ℕ × ℕ)), P.Nodup → (∀ p ∈ P, p.1 < NV ∧ p.2 < NV) →
    ∀ Λ : Rl → Vt, (∀ p ∈ P, Λ (τr p.1 p.2) = 0) →
      (∀ p ∈ P, runOps (progOps (P.flatMap K)) Λ (Xr p.1 p.2) = -Λ (Xr p.1 p.2)) ∧
      (∀ p ∈ P, runOps (progOps (P.flatMap K)) Λ (Yr p.1 p.2) = Λ (Yr p.1 p.2) + Λ (Xr p.1 p.2)) ∧
      (∀ r, (∀ p ∈ P, r ≠ Xr p.1 p.2 ∧ r ≠ Yr p.1 p.2 ∧ r ≠ τr p.1 p.2) →
        runOps (progOps (P.flatMap K)) Λ r = Λ r)
  | [], _, _, Λ, _ => by
    rw [List.flatMap_nil, progOps_nil', runOps_nil']
    exact ⟨fun p hp => absurd hp List.not_mem_nil, fun p hp => absurd hp List.not_mem_nil, fun _ _ => rfl⟩
  | p :: P, hn, hP, Λ, h => by
    rw [List.nodup_cons] at hn
    obtain ⟨ha, hb⟩ := hP p List.mem_cons_self
    obtain ⟨k1, k2, k3⟩ := K_log ha hb Λ (h p List.mem_cons_self)
    -- the other pairs' roles are untouched by `K p`
    have dis : ∀ q ∈ P, ∀ r ∈ [Xr q.1 q.2, Yr q.1 q.2, τr q.1 q.2],
        r ≠ Xr p.1 p.2 ∧ r ≠ Yr p.1 p.2 ∧ r ≠ τr p.1 p.2 := by
      intro q hq r hr
      obtain ⟨ha', hb'⟩ := hP q (List.mem_cons_of_mem _ hq)
      have hqp : q ≠ p := fun e => hn.1 (e ▸ hq)
      have hne : ¬ (q.1 = p.1 ∧ q.2 = p.2) := fun ⟨e1, e2⟩ => hqp (Prod.ext e1 e2)
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl
      · exact ⟨fun e => hne (X_inj ha' hb' ha hb e), X_ne_Y ha' hb' ha hb, X_ne_τ⟩
      · exact ⟨fun e => X_ne_Y ha hb ha' hb' e.symm, fun e => hne (Y_inj ha' hb' ha hb e), Y_ne_τ⟩
      · exact ⟨fun e => X_ne_τ e.symm, fun e => Y_ne_τ e.symm, fun e => hne (τ_inj ha' hb' ha hb e)⟩
    have ih := KK_log_sol_aux P hn.2 (fun q hq => hP q (List.mem_cons_of_mem _ hq))
      (runOps (progOps (K p)) Λ) (fun q hq => by
        obtain ⟨d1, d2, d3⟩ := dis q hq (τr q.1 q.2) (by simp)
        rw [k3 _ d1 d2 d3]; exact h q (List.mem_cons_of_mem _ hq))
    have pnot : ∀ r ∈ [Xr p.1 p.2, Yr p.1 p.2, τr p.1 p.2], ∀ q ∈ P,
        r ≠ Xr q.1 q.2 ∧ r ≠ Yr q.1 q.2 ∧ r ≠ τr q.1 q.2 := by
      intro r hr q hq
      obtain ⟨ha', hb'⟩ := hP q (List.mem_cons_of_mem _ hq)
      have hqp : q ≠ p := fun e => hn.1 (e ▸ hq)
      have hne : ¬ (p.1 = q.1 ∧ p.2 = q.2) := fun ⟨e1, e2⟩ => hqp (Prod.ext e1.symm e2.symm)
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl
      · exact ⟨fun e => hne (X_inj ha hb ha' hb' e), X_ne_Y ha hb ha' hb', X_ne_τ⟩
      · exact ⟨fun e => X_ne_Y ha' hb' ha hb e.symm, fun e => hne (Y_inj ha hb ha' hb' e), Y_ne_τ⟩
      · exact ⟨fun e => X_ne_τ e.symm, fun e => Y_ne_τ e.symm, fun e => hne (τ_inj ha hb ha' hb' e)⟩
    rw [List.flatMap_cons, progOps_append, runOps_append]
    refine ⟨fun q hq => ?_, fun q hq => ?_, fun r hr => ?_⟩
    · rcases List.mem_cons.1 hq with rfl | hq
      · rw [ih.2.2 _ (pnot (Xr q.1 q.2) (by simp)), k1]
      · obtain ⟨d1, d2, d3⟩ := dis q hq (Xr q.1 q.2) (by simp)
        rw [ih.1 q hq, k3 _ d1 d2 d3]
    · rcases List.mem_cons.1 hq with rfl | hq
      · rw [ih.2.2 _ (pnot (Yr q.1 q.2) (by simp)), k2]
      · obtain ⟨d1, d2, d3⟩ := dis q hq (Yr q.1 q.2) (by simp)
        obtain ⟨e1, e2, e3⟩ := dis q hq _ (show Xr q.1 q.2 ∈ [Xr q.1 q.2, Yr q.1 q.2, τr q.1 q.2] by simp)
        rw [ih.2.1 q hq, k3 _ d1 d2 d3, k3 _ e1 e2 e3]
    · obtain ⟨r1, r2, r3⟩ := hr p List.mem_cons_self
      rw [ih.2.2 r (fun q hq => hr q (List.mem_cons_of_mem _ hq)), k3 r r1 r2 r3]

/-! ## The final logical state on the data roles -/

