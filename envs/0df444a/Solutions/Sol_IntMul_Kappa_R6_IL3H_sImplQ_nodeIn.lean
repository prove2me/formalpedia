/-- The strides of a level on `E` bits. -/
theorem slaws_levH {K e E t S0 B : ℕ} (hK : 1 ≤ K) (hKe : K * (E - 1) ≤ e) (het : e - e % K + K ≤ t) :
    SLaws (fun i : Fin E => 2 ^ (e - K * i.val) * S0) (nN B t S0) := by
  have hinj : Function.Injective (fun i : Fin E => e - K * i.val) := by
    intro i j h
    simp only at h
    have hi : K * i.val ≤ K * (E - 1) := Nat.mul_le_mul_left _ (by have := i.isLt; omega)
    have hj : K * j.val ≤ K * (E - 1) := Nat.mul_le_mul_left _ (by have := j.isLt; omega)
    have : K * i.val = K * j.val := by omega
    exact Fin.ext (Nat.eq_of_mul_eq_mul_left (by omega) this)
  have hlt : ∀ i : Fin E, e - K * i.val < t := by
    intro i
    have := Nat.mod_lt e (by omega : 0 < K)
    have := Nat.mod_le e K
    omega
  exact slaws_pow (fun i : Fin E => e - K * i.val) hinj t S0 B hlt

theorem nN_W {W B t S0 : ℕ} (h : W ∣ B) : W * nN (B / W) t S0 = nN B t S0 := by
  unfold nN
  have : W * (B / W) = B := Nat.mul_div_cancel' h
  calc W * (B / W * 2 ^ t * S0) = (W * (B / W)) * 2 ^ t * S0 := by ring
    _ = B * 2 ^ t * S0 := by rw [this]

section Node

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

/-- **The interior of a node.** -/
theorem sImplQ_nodeIn_sol_aux {rowC : IStmt HS Pp} {jL : Fin Pp} (hj : tbl jL = levCH c jL rowC)
    (hN : NodeRH c σ K t S0 r H E e B) (hok : NetOK c) (hm : 1 ≤ c.m) (hE2 : 2 * c.m ≤ E)
    (hW1 : 1 ≤ c.W) (hWB : c.W ∣ B) (hB1 : 1 ≤ B) (hK : 1 ≤ K) (hS : 1 ≤ S0) (hr : 1 ≤ r)
    (hKe : K * (E - 1) ≤ e) (het : e - e % K + K ≤ t) (Zr : ℕ)
    (hzA : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) + 4 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Zr)
    (hZr : Zr + 2 ≤ r)
    (M : ℕ) (hM : E + e + K * E + K + c.m + 1 ≤ M) (hMZ : zsz (M : ℤ) ≤ Zr)
    (dwf cf : HStep (Fin c.Wr) c.m → ℕ)
    (hP : ∀ a ∈ c.net, RImplQ Isym tbl (fun s => Agree σ s) 0 H r (nN (B / c.W) t S0)
      (stH c.m K e (E / c.m) S0) (a.den (chEx (κ := Fin (E / c.m)))) (stepH c jL rowC a)
      (eStH c (E / c.m) a) (dwf a) (fun _ => cf a))
    (DWR cR : ℕ)
    (IHR : SImplQ Isym tbl (fun s => Agree (σPush σ (frV σ (leftFr c))) s) 0 H r
      (fun j : Fin (E % c.m) => 2 ^ ((e - K * (c.m * (E / c.m))) - K * j.val) * S0) (nN B t S0)
      (tens Cm) (levCH c jL rowC) (c.G (E % c.m)) DWR (fun _ => cR)) :
    ∃ cost : ℕ → ℕ, SImplQ Isym tbl (fun s => Agree σ s) 0 H r
      (fun i : Fin E => 2 ^ (e - K * i.val) * S0) (nN B t S0) (tens Cm)
      (.seq (padCU 23 21 (seqLQ (stepH c jL rowC) c.net))
        (.seq (withPushI (fr (leftFr c)) (.call jL)) (scaleQ 23 23 25 26)))
      ((c.net.map (eStH c (E / c.m))).sum + (c.G (E % c.m) + δv c E))
      ((c.net.map dwf).sum + (DWR + (δv c E + 2) * 2)) cost ∧
      ∀ w, w + ((c.net.map dwf).sum + (DWR + (δv c E + 2) * 2)) ≤ H →
        cost w ≤ (c.net.map cf).sum + cR + 10 ^ 17 * (c.Wr * nN (B / c.W) t S0 * Yu r Zr H) := by
  set F := E / c.m with hFd
  set Bn := B / c.W with hBnd
  have hF : 1 ≤ F := by
    rw [hFd, Nat.le_div_iff_mul_le (by omega)]; omega
  have hmF : c.m * F ≤ E := Nat.mul_div_le E c.m
  have hmFR : c.m * F + E % c.m = E := Nat.div_add_mod E c.m
  have hBn : 1 ≤ Bn := by
    rw [hBnd]; exact (Nat.le_div_iff_mul_le (by omega)).2 (by
      have := Nat.le_of_dvd (by omega) hWB; omega)
  have hσ0 : σ 0 = none := hN.lev.off 0 (by decide)
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hWn : c.W * nN Bn t S0 = nN B t S0 := nN_W hWB
  have hN1 : 1 ≤ nN B t S0 := one_le_nN hB1 hS
  have zb : ∀ x : ℕ, x ≤ 2 * (c.Wr * (nN Bn t S0 * r)) + 4 * (B * 2 ^ t * S0 * r) →
      zsz (x : ℤ) ≤ Zr := fun x hx => le_trans (zsz_natCast_le hx) hzA
  have hNB : nN B t S0 * r = B * 2 ^ t * S0 * r := rfl
  -- the steps
  have hKe' : K * (F * c.m - 1) ≤ e := by
    have : F * c.m - 1 ≤ E - 1 := by rw [mul_comm]; omega
    exact le_trans (Nat.mul_le_mul_left _ this) hKe
  have hsl := slaws_nodeH (m := c.m) (S0 := S0) (Bn := Bn) hK hKe' hF het
  have RL := rImplQ_listH hsl (stepH c jL rowC) (eStH c F) dwf (fun a _ => cf a) c.net
    (fun a ha => hP a ha)
  have hT : c.T * nN Bn t S0 * r ≤ c.Wr * (nN Bn t S0 * r) := by
    rw [mul_assoc]; exact Nat.mul_le_mul_right _ (by show c.T ≤ c.W + c.T; omega)
  have hWr : c.W * nN Bn t S0 * r ≤ c.Wr * (nN Bn t S0 * r) := by
    rw [mul_assoc]; exact Nat.mul_le_mul_right _ (by show c.W ≤ c.W + c.T; omega)
  have h23 : σ 23 = some ((2 * (c.W * nN Bn t S0 * r) : ℕ) : ℤ) := by
    rw [hWn]; exact hN.g23
  have h21 : σ 21 = some ((2 * (c.T * nN Bn t S0 * r) : ℕ) : ℤ) := by
    rw [mul_assoc c.T]; exact hN.g21
  have SP := sImplQ_padRole (Pp := Pp) (I := Isym) (iprog := tbl) hsl
    (fun p => dvd_pow_lay (IL3F.posR c.m K e F) t S0 Bn (posRH_lt hK het) p)
    (hok.data (Fin F)) hN.lev.lt hN.lev.off h23 h21 RL Zr (zb _ (by omega))
  rw [hWn] at SP
  have SP1 := sImplQ_subOp (st := fun i : Fin E => 2 ^ (e - K * i.val) * S0) (gN1_inj hmF)
    (by rw [st_gN1 hmF]; exact SP)
  -- the leftover
  have SL0 := sImplQ_call hj IHR
  have hM' : E + e + K * E + K + c.m + 1 ≤ M := hM
  have SL1 := sImplQ_fr (I := Isym) (iprog := tbl) (lo := 0) (hi := H) hσ0 (leftFr c) M Zr 20 hMZ
    (frOK_leftFr hN hm M hM)
    (noRdN_of_B _ _ (by simp (config := {decide := true}) [noRdB, leftFr, NE.regs]))
    (by intro x hx; simp only [leftFr, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl | rfl <;> (simp only []; decide)) SL0
  have SL2 := sImplQ_subOp (st := fun i : Fin E => 2 ^ (e - K * i.val) * S0) (gN2_inj hmFR)
    (by rw [st_gN2 hmFR]; exact SL1)
  -- the scale
  have hWR : WReg σ 25 26 (nN B t S0 * r) (δv c E) :=
    ⟨sclean_of_lt hN.lev.lt, hN.lev.off, hN.g25, hN.g26⟩
  have SS := sImplQ_scale (Isym := Isym) (iprog := tbl) (lo := 0) (hi := H)
    (st := fun i : Fin E => 2 ^ (e - K * i.val) * S0) (by omega) hN1 hN.lev.lt hN.lev.off
    (xL := 23) (xQ := 23) hN.g23 hN.g23 hWR Zr (zb _ (by rw [hNB]; omega))
    (zb _ (by rw [hNB]; omega))
  -- composition
  have hslE := slaws_levH (B := B) (S0 := S0) hK hKe het
  have C1 := SL2.comp hslE SS
  have C2 := SP1.comp hslE C1
  rw [one_mul, tens_node (by omega) hmF hmFR] at C2
  refine ⟨_, C2, fun w hw => ?_⟩
  -- the cost
  rw [KFW.costL_const]
  simp only [frV_length, leftFr, List.length_cons, List.length_nil]
  set Y := Yu r Zr H with hY
  set Nn := c.Wr * nN Bn t S0 with hNn
  have hNn1 : 1 ≤ Nn := by
    rw [hNn]
    have h1 : 1 ≤ c.Wr := by show 1 ≤ c.W + c.T; omega
    have := Nat.mul_le_mul h1 hn; simpa using this
  have hNr : Nn * r = c.Wr * (nN Bn t S0 * r) := by rw [hNn]; ring
  have hWnr : nN B t S0 * r = c.W * nN Bn t S0 * r := by rw [hWn]
  have hcP := cost_padH (L0 := 2 * (nN B t S0 * r)) (Q := 2 * (c.T * nN Bn t S0 * r)) (Z := Zr)
    (w := w) (dw := (c.net.map dwf).sum) (r := r) (H := H) (Nn := Nn)
    (by omega) (by omega) (by omega) (zb _ (by omega)) hNn1
  have hcS := cost_scaleH (N := nN B t S0) (r := r) (Z := Zr) (H := H) (δ := δv c E)
    (w := w + (c.net.map dwf).sum + DWR) hN1 (by omega) (zb _ (by rw [hNB]; omega))
  have hcF := cFrame_Y 3 20 r Zr H
  have hY8 := yu_8 r Zr H
  have hYz := yu_z1 r Zr H
  have hNY : nN B t S0 * Y ≤ Nn * Y := by
    apply Nat.mul_le_mul_right; rw [hNn, ← hWn]; exact Nat.mul_le_mul_right _ (by show c.W ≤ c.W + c.T; omega)
  have hY1 : Y ≤ Nn * Y := Nat.le_mul_of_pos_left _ hNn1
  have e1 : w + (c.net.map dwf).sum + DWR = w + (c.net.map dwf).sum + DWR := rfl
  generalize 400 * (cPadC (2 * (nN B t S0 * r)) (2 * (c.T * nN Bn t S0 * r)) Zr w
    (c.net.map dwf).sum (fun _ => 0) + 0) = cp at hcP ⊢
  generalize 400 * (cPadC (2 * (nN B t S0 * r)) (2 * (nN B t S0 * r)) Zr
    (w + (c.net.map dwf).sum + DWR) ((δv c E + 2) * 2)
