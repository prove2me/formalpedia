  intro he
  have ha : a ∈ S \ T := by rw [hU]; simp [fibre]
  have hah : a+h ∈ S \ T := by rw [hU]; simp [fibre]
  have himg : a+h ∈ S.image (fun x => x+h) :=
    Finset.mem_image.mpr ⟨a,(Finset.mem_sdiff.mp ha).1,rfl⟩
  rw [he] at himg
  exact (Finset.mem_sdiff.mp hah).2 himg

