-- title:
--   Pure fermionic Gaussian states $G_f$
-- statement:
--   A **fermionic Gaussian unitary** is a unitary generated by Hamiltonians quadratic in the creation and annihilation operators: a finite product
--
--   $$
--   U=\exp(A_1)\cdots\exp(A_L),\qquad A_l=\tfrac14\sum_{p,q=1}^{2n}h^{(l)}_{pq}\gamma_p\gamma_q,
--   $$
--
--   with each $h^{(l)}$ a real antisymmetric $2n\times2n$ matrix. The **pure fermionic Gaussian states** are the union of the orbits of $|0^n\rangle$ and $|1,0^{n-1}\rangle$ under all such $U$, up to a global phase:
--
--   $$
--   G_f=\{e^{i\theta}U|x_0\rangle:\ \theta\in\mathbb R,\ U \text{ Gaussian},\ x_0\in\{0^n,\,1\,0^{n-1}\}\}.
--   $$
--
--   A Hermitian quadratic Hamiltonian is $\tfrac i4\sum h_{pq}\gamma_p\gamma_q+c\,I$ with $h$ real antisymmetric, so $e^{-iH}$ is $e^{-ic}\exp(A)$; the constant part of the Hamiltonian is the global phase.
--
--   **Formalization Note** States are rays, so the class is closed under global phase. Majoranas are $0$-based; mode $0$ is the paper's mode $1$. For $n=0$ both reference states are the vacuum.
-- source:
--   Iyer, O'Gorman, Parekh, Thompson, Zhao, Optimal testing of fermionic and bosonic Gaussian states, arXiv:2609.39113 (sha256 6683e57b…), §2.2, pp.17–18

import Definitions.Def_GaussTesting_annihilator

namespace GaussTesting

/-- The quadratic Majorana form `¼ ∑_{p,q} h_{pq} γ_p γ_q`; for a real antisymmetric `h` it is
anti-Hermitian, `−i` times the general traceless quadratic Hamiltonian `(i/4) ∑ h_{pq} γ_p γ_q`. -/
noncomputable def quadGen (n : ℕ) (h : Matrix (Fin (2 * n)) (Fin (2 * n)) ℝ) :
    FermiCap.Gaussian.Op n :=
  (1 / 4 : ℂ) • ∑ p, ∑ q, (h p q : ℂ) • (FermiCap.Gaussian.majorana n p * FermiCap.Gaussian.majorana n q)

/-- The two reference configurations: `refState n 0 = 0ⁿ` (vacuum) and `refState n 1 = 1,0ⁿ⁻¹`
(mode `0` occupied); for `n = 0` both are the empty configuration. -/
def refState (n : ℕ) (b : Fin 2) : FermiCap.Gaussian.Qubits n := fun j => if j.val = 0 then b else 0

/-- The pure fermionic Gaussian states `G_f` on `n` modes: the union of the orbits of `|0ⁿ⟩` and
`|1,0ⁿ⁻¹⟩` under all fermionic Gaussian unitaries, up to a global phase. A Gaussian unitary is a finite
product `exp(A₁)⋯exp(A_L)` with `A_l = ¼ ∑_{p,q} h^{(l)}_{pq} γ_p γ_q`, `h^{(l)}` real antisymmetric.

Source: Iyer, O'Gorman, Parekh, Thompson, Zhao, *Optimal testing of fermionic and bosonic Gaussian states*, arXiv:2609.39113 (sha256 6683e57b…), §2.2, pp.17–18 ("Fermionic Gaussian unitaries are unitary operators generated
by Hamiltonians that are quadratic in the creation and annihilation operators"; "they are the union of
the orbits of `|0ⁿ⟩` and `|1,0ⁿ⁻¹⟩` under all fermionic Gaussian unitaries. We denote the set of pure
fermionic Gaussian states by `G_f`").

**Formalization Note.**
* "Generated by quadratic Hamiltonians" is read literally as the group generated by the `e^{−iHt}`:
  a Hermitian Hamiltonian quadratic in `c, c†` is `(i/4) ∑ h_{pq} γ_p γ_q + c·I` with `h` real
  antisymmetric, so `e^{−iH}` is `e^{−ic}·exp(A)`; the constant gives the global phase `e^{iθ}`.
* States are rays; the class is closed under global phase, as `dist(·, 𝒞)` and the test projectors are.
* Majoranas are 0-based (`FermiCap.Gaussian.majorana n p`, `p < 2n`); mode `0` is the paper's mode `1`. -/
noncomputable def Gf (n : ℕ) : Set (Ell2 (FermiCap.Gaussian.Qubits n)) :=
  {ψ | ∃ θ : ℝ, ∃ hs : List (Matrix (Fin (2 * n)) (Fin (2 * n)) ℝ), (∀ h ∈ hs, h.transpose = -h) ∧
    ∃ b : Fin 2, ∀ x, ψ x = Complex.exp (θ * Complex.I) *
      ((hs.map (fun h => NormedSpace.exp (quadGen n h))).prod.mulVec
        (Pi.single (refState n b) 1)) x}

end GaussTesting


