namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## Frames -/

theorem encK_split (s : IState HS) {K H G : Fin HS → List ℤ} (h : ∀ j, K j = H j ++ G j) :
    encK s K = encK (encK s G) H := by
  refine IState.ext' (fun j => ?_) rfl rfl
  simp [h j, NLogN.ints_append]

/-- A `FineBody6` call on any managed state with the descriptor pushed on top of `dF`. -/
theorem fine_call {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eF eB : Fin Pp}
    {dF : Fin HS} {C₀ : ℝ} (hF : FineBody6 Isym tbl eF eB dF C₀) (hF0 : dF ≠ 0)
    (w f a y : ℕ) (s : IState HS) (G : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (h0 : G 0 = gflat zs ++ l) (hy : 1 ≤ y) (hlen : zs.length = a * (2 ^ f * y))
    (hgb : GB w zs) :
    (∃ c : ℕ, IRuns Isym tbl (.call eF) (encK s (update G dF (descFine w f a y ++ G dF)))
        (encK s (update (update G dF (descFine w f a y ++ G dF)) 0
          (gflat (blkT (2 ^ f) y a zs) ++ l))) c ∧ (c : ℝ) ≤ C₀ * cFine w f a y) ∧
    (∃ c : ℕ, IRuns Isym tbl (.call eB) (encK s (update G dF (descFine w f a y ++ G dF)))
        (encK s (update (update G dF (descFine w f a y ++ G dF)) 0
          (gflat (blkT y (2 ^ f) a zs) ++ l))) c ∧ (c : ℝ) ≤ C₀ * cFine w f a y) := by
  set H : Fin HS → List ℤ := fun j => if j = 0 then G 0 else if j = dF then descFine w f a y
    else [] with hH
  set Gb : Fin HS → List ℤ := fun j => if j = 0 then [] else G j with hGb
  have hs : ∀ v : List ℤ, ∀ j, update (update G dF (descFine w f a y ++ G dF)) 0 v j =
      update H 0 v j ++ Gb j := by
    intro v j
    by_cases h1 : j = 0
    · subst h1; simp [hGb]
    by_cases h2 : j = dF
    · subst h2; simp [hH, hGb, h1]
    · simp [hH, hGb, h1, h2]
  have hk : ∀ j, update G dF (descFine w f a y ++ G dF) j = H j ++ Gb j := by
    intro j
    by_cases h1 : j = 0
    · subst h1; simp [hH, hGb, Ne.symm hF0]
    by_cases h2 : j = dF
    · subst h2; simp [hH, hGb, h1]
    · simp [hH, hGb, h1, h2]
  obtain ⟨⟨c1, r1, k1⟩, ⟨c2, r2, k2⟩⟩ := hF w f a y (encK s Gb) H zs l
    (fun j hj0 hjF => by simp [hH, hj0, hjF]) (by simp [hH, hF0]) (by simp [hH, h0]) hy hlen hgb
  rw [encK_split s hk, encK_split s (hs (gflat (blkT (2 ^ f) y a zs) ++ l)),
    encK_split s (hs (gflat (blkT y (2 ^ f) a zs) ++ l))]
  exact ⟨⟨c1, r1, k1⟩, ⟨c2, r2, k2⟩⟩

/-! ## `dup` / `drop` on managed states (any stack) -/

section dupdrop
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem IRuns.dupK (s : IState HS) {G : Fin HS → List ℤ} {i j : Fin HS} (hij : i ≠ j) {a : ℤ}
    {l : List ℤ} (hi : G i = a :: l) :
    IRuns I iprog (.op (.dup i j)) (encK s G) (encK s (update G j (a :: G j)))
      (dupCost (zsz a) + 17) := by
  have h := IRuns.dup (I := I) (iprog := iprog) (s := encK s G) (i := i) (j := j) hij
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [← encK_upd]; simp [ints]

theorem IRuns.dropK (s : IState HS) {G : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (hi : G i = a :: l) :
    IRuns I iprog (.op (.drop i)) (encK s G) (encK s (update G i l)) (2 * zsz a + 2) := by
  have h := IRuns.drop (I := I) (iprog := iprog) (s := encK s G) (i := i)
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [← encK_upd]

end dupdrop

