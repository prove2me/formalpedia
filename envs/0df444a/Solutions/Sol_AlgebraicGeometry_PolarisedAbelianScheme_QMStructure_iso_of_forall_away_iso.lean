theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {star : ↥Λ → ↥Λ} {β : Fin (2 * 2) → ↥Λ}
    {d m : ℕ} (hm : 3 ≤ m) {S : Type} [CommRing S] (hm' : IsUnit ((m : ℕ) : S))
    {X X' : PolarisedAbelianScheme 2 d m S} (t : QMStructure Λ star β X) (t' : QMStructure Λ star β X')
    {k : ℕ} (r : Fin k → S) (hr : Ideal.span (Set.range r) = ⊤)
    (Xl : ∀ i, PolarisedAbelianScheme 2 d m (Localization.Away (r i)))
    (tl : ∀ i, QMStructure Λ star β (Xl i))
    (Xl' : ∀ i, PolarisedAbelianScheme 2 d m (Localization.Away (r i)))
    (tl' : ∀ i, QMStructure Λ star β (Xl' i))
    (ht : ∀ i, QMStructure.IsPullback (algebraMap S (Localization.Away (r i))) t (tl i))
    (ht' : ∀ i, QMStructure.IsPullback (algebraMap S (Localization.Away (r i))) t' (tl' i))
    (hloc : ∀ i, QMStructure.Iso (tl i) (tl' i)) :
    QMStructure.Iso t t' := by
  have hXl : ∀ i, PolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r i))) X (Xl i) := fun i => by
    obtain ⟨gA, hg, h1, h2, h3, -, -⟩ := ht i; exact ⟨gA, hg, h1, h2, h3⟩
  have hXl' : ∀ i, PolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r i))) X' (Xl' i) := fun i => by
    obtain ⟨gA, hg, h1, h2, h3, -, -⟩ := ht' i; exact ⟨gA, hg, h1, h2, h3⟩
  have hlocP : ∀ i, PolarisedAbelianScheme.Iso (Xl i) (Xl' i) := fun i => by
    obtain ⟨e, he, h1, h2, h3, -, -⟩ := hloc i; exact ⟨e, he, h1, h2, h3⟩
  have RST := fun (T : Type) (_ : CommRing T) =>
    AlgebraicGeometry.PolarisedAbelianScheme.Iso.refl_symm_trans (g := 2) (d := d) (n := m) (S := T)
  have hsep : ∀ (i : Fin k) (v v' : PolarisedAbelianScheme 2 d m (Localization.Away (r i))),
      PolarisedAbelianScheme.IsPullback (algebraMap S _) X v → PolarisedAbelianScheme.IsPullback (algebraMap S _) X' v' →
      PolarisedAbelianScheme.Iso v v' := fun i v v' hv hv' =>
    (RST _ _).2.2 _ _ _ (AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange _ X X v (Xl i) ((RST _ _).1 X) hv (hXl i))
      ((RST _ _).2.2 _ _ _ (hlocP i) (AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange _ X' X' (Xl' i) v' ((RST _ _).1 X') (hXl' i) hv'))
