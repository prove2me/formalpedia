theorem succ_le_two_pow (n : ℕ) : n + 1 ≤ 2 ^ n := by
  induction n with
  | zero => norm_num
  | succ n ih =>
      rw [pow_succ]
      omega

/-- The deliberately loose Gram-adjugate certificate bound fits the exact Frank--Tardos
bound. This comparison does not assert that the certificate has already been constructed. -/
theorem gram_budget_le_published (n N : ℕ) (hn : 1 ≤ n) (hN : 1 ≤ N) :
    (n + 1) ^ (2 * n + 2) * N ^ (2 * n + 1) ≤
      2 ^ (4 * n ^ 3) * N ^ (n * (n + 2)) := by
  have hexp : n * (2 * n + 2) ≤ 4 * n ^ 3 := by
    have h₁ := Nat.mul_le_mul_left n hn
    have h₂ := Nat.mul_le_mul_left (n * n) hn
    nlinarith
  have hexpN : 2 * n + 1 ≤ n * (n + 2) := by nlinarith
  have htwo : (n + 1) ^ (2 * n + 2) ≤ 2 ^ (4 * n ^ 3) := by
    calc
      (n + 1) ^ (2 * n + 2) ≤ (2 ^ n) ^ (2 * n + 2) := by
        gcongr
        exact succ_le_two_pow n
      _ = 2 ^ (n * (2 * n + 2)) := by rw [pow_mul]
      _ ≤ 2 ^ (4 * n ^ 3) := Nat.pow_le_pow_right (by norm_num) hexp
  exact Nat.mul_le_mul htwo (Nat.pow_le_pow_right hN hexpN)

theorem raw_gram_budget_le (r n N : ℕ) (hr : r ≤ n) (hn : 1 ≤ n) (hN : 1 ≤ N) :
    r ^ 2 * N * r.factorial * (n * N ^ 2) ^ r ≤
      (n + 1) ^ (2 * n + 2) * N ^ (2 * n + 1) := by
  have hbase : 1 ≤ n * N ^ 2 := by nlinarith
  have hfac : r.factorial ≤ (n + 1) ^ n :=
    (Nat.factorial_le hr).trans ((Nat.factorial_le_pow n).trans (by gcongr; omega))
  calc
    r ^ 2 * N * r.factorial * (n * N ^ 2) ^ r ≤
        (n + 1) ^ 2 * N * (n + 1) ^ n * ((n + 1) * N ^ 2) ^ n := by
      apply Nat.mul_le_mul
      · exact Nat.mul_le_mul (Nat.mul_le_mul_right N (Nat.pow_le_pow_left (by omega) 2)) hfac
      · exact (Nat.pow_le_pow_right hbase hr).trans (by gcongr; omega)
    _ = (n + 1) ^ (2 * n + 2) * N ^ (2 * n + 1) := by
      rw [mul_pow, ← pow_mul]
      simp only [pow_add, pow_mul']
      ring

end ObjectiveCompression
