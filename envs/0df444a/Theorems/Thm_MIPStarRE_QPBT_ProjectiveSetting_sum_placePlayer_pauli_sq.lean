variable {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {epsilon deltaG : ℝ}
variable (S : _root_.MIPStarRE.QPBT.ProjectiveSetting P epsilon)

theorem MIPStarRE.QPBT.ProjectiveSetting.sum_placePlayer_pauli_sq (side : _root_.MIPStarRE.QPBT.PlayerSide) (W : _root_.MIPStarRE.QPBT.PauliKind) :
    ∑ h, (S.placePlayer side ((S.pauliMeas side W).effect h))ᴴ *
      S.placePlayer side ((S.pauliMeas side W).effect h) = 1 := by sorry
