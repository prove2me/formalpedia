lemma scaled_monomial {σ τ : Type} (f : σ → τ) (c : σ → ℤ) (μ : σ →₀ ℕ) (a : ℤ) :
    aeval (fun i => C (c i) * X (f i)) (monomial μ a) =
      monomial (μ.mapDomain f) (a * μ.prod (fun i k => c i ^ k)) := by
  classical
  rw [aeval_monomial]
  simp only [MvPolynomial.algebraMap_eq,Finsupp.prod,mul_pow,Finset.prod_mul_distrib,
    ← map_pow,← map_prod]
  rw [← mul_assoc,← map_mul]
  have hrename : (∏ i ∈ μ.support,(X (f i) : MvPolynomial τ ℤ) ^ μ i) =
      monomial (μ.mapDomain f) 1 := by
    rw [← rename_monomial]
    simp only [monomial_eq,Finsupp.prod,map_mul,map_prod,map_pow,rename_C,rename_X,C_1,one_mul]
  rw [hrename,C_mul_monomial,mul_one]

lemma scaled_coeff {σ τ : Type} (f : σ → τ) (c : σ → ℤ)
    (P : MvPolynomial σ ℤ) (δ : τ →₀ ℕ) :
    (aeval (fun i => C (c i) * X (f i)) P).coeff δ =
      ∑ μ ∈ P.support,if μ.mapDomain f = δ then P.coeff μ * μ.prod (fun i k => c i ^ k) else 0 := by
  classical
  conv_lhs => rw [P.as_sum]
  simp only [map_sum,coeff_sum,scaled_monomial,coeff_monomial]

theorem negative_coefficient {σ τ : Type} (f : σ → τ) (c : σ → ℤ) (hc : ∀ i,0 < c i)
    (P : MvPolynomial σ ℤ) (δ : τ →₀ ℕ)
    (hneg : ∀ μ,μ ∈ P.support → μ.mapDomain f = δ → P.coeff μ < 0)
    (hex : ∃ μ,μ ∈ P.support ∧ μ.mapDomain f = δ) :
    (aeval (fun i => C (c i) * X (f i)) P).coeff δ < 0 := by
  classical
  rw [scaled_coeff]
  have hprod (μ : σ →₀ ℕ) : 0 < μ.prod (fun i k => c i ^ k) := by
    exact Finset.prod_pos (fun i _ => pow_pos (hc i) _)
  apply Finset.sum_neg'
  · intro μ hμ
    split_ifs with hm
    · exact (mul_neg_of_neg_of_pos (hneg μ hμ hm) (hprod μ)).le
    · exact le_rfl
  · obtain ⟨μ,hμ,hm⟩ := hex
    refine ⟨μ,hμ,?_⟩
    rw [if_pos hm]
    exact mul_neg_of_neg_of_pos (hneg μ hμ hm) (hprod μ)

end PositiveSpecialization

