theorem NLogN.expNegFix_bnds (n M : ℕ) (X : ℤ) :
    zsz (M : ℤ) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (n : ℤ) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz ((n : ℤ) + 1) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz ((M : ℤ) + -((n : ℤ) + 1)) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz X ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (log2Bits M) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (-X / log2Bits M) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (-X / log2Bits M * log2Bits M) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (X + -X / log2Bits M * log2Bits M) ≤ 3 * M + 14 ∧
    zsz ((((M : ℤ) + -((n : ℤ) + 1)).toNat : ℤ) + ((-X / log2Bits M).toNat : ℤ)) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (((((M : ℤ) + -((n : ℤ) + 1)).toNat : ℤ) + ((-X / log2Bits M).toNat : ℤ)) + 1) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    ((((M : ℤ) + -((n : ℤ) + 1)).toNat : ℤ) + ((-X / log2Bits M).toNat : ℤ)).toNat + 3 ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (expBits M (X + -X / log2Bits M * log2Bits M) 0).1 ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz (expBits M (X + -X / log2Bits M * log2Bits M) 0).2 ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat ∧
    zsz ((expBits M (X + -X / log2Bits M * log2Bits M) 0).1 + 2 ^ ((((M : ℤ) + -((n : ℤ) + 1)).toNat : ℤ) + ((-X / log2Bits M).toNat : ℤ)).toNat) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat + 1 := by sorry
