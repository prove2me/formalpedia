import Mathlib
import Theorems.Thm_Transcendence_exp_monomials_deriv_lattice
import Theorems.Thm_Transcendence_liouville_house

/-!
# Liouville's lower bound (4.14) for exponential monomials at lattice points

Waldschmidt's §4.6, step 2. The number field `K ⊂ ℂ` generated by the `x_{iν}`, the `e^{⟨xᵢ, y_j⟩}` and
(if `d₀ = 1`) the `y_{j k₀}` is built here, with a common denominator `δ` and a common bound `H` for the
houses. A non-zero derivative of `F` at a lattice point is `φK γ` (`exp_monomials_deriv_lattice`), and
Liouville's inequality (`liouville_house`) gives `1 ≤ δ^{ΔD} |φK γ| P^{D-1}`, `D = [K : ℚ]`, where `P` bounds
`house γ`. Taking logarithms gives (4.14) with `C = D (2 + 2(1 + d₁n)(log δ + log H) + log (d₁+1) + d + log n)`.
-/

open NumberField

namespace ExpMonomialsLiouvilleLower

/-- Finitely many algebraic numbers lie in a number field `K`, embedded in `ℂ`. -/
lemma exists_numberField (S : Finset ℂ) (hS : ∀ z ∈ S, IsAlgebraic ℚ z) :
    ∃ (K : Type) (_ : Field K) (_ : NumberField K) (φK : K →+* ℂ), ∀ z ∈ S, ∃ w : K, φK w = z := by
  let K := IntermediateField.adjoin ℚ (S : Set ℂ)
  have hfd : FiniteDimensional ℚ K := IntermediateField.finiteDimensional_adjoin
    (fun z hz => (hS z (Finset.mem_coe.mp hz)).isIntegral)
  have hnf : NumberField K :=
    { to_charZero := charZero_of_injective_algebraMap (algebraMap ℚ K).injective
      to_finiteDimensional := hfd }
  exact ⟨K, inferInstance, hnf, K.val.toRingHom, fun z hz =>
    ⟨⟨z, IntermediateField.subset_adjoin ℚ (S : Set ℂ) (Finset.mem_coe.mpr hz)⟩, rfl⟩⟩

/-- A common denominator `δ ≥ 1` for three finite families of elements of a number field. -/
lemma exists_denominator {K : Type*} [Field K] [NumberField K] {α β γ : Type*} [Fintype α]
    [Fintype β] [Fintype γ] (f : α → K) (g : β → K) (h : γ → K) :
    ∃ δ : ℤ, 1 ≤ δ ∧ (∀ i, IsIntegral ℤ ((δ : K) * f i)) ∧ (∀ j, IsIntegral ℤ ((δ : K) * g j)) ∧
      ∀ k, IsIntegral ℤ ((δ : K) * h k) := by
  classical
  obtain ⟨c, hc0, hc⟩ := exists_integral_multiples ℤ ℚ (L := K)
    (Finset.univ.image f ∪ Finset.univ.image g ∪ Finset.univ.image h)
  have hc' : ∀ z, z ∈ Finset.univ.image f ∪ Finset.univ.image g ∪ Finset.univ.image h →
      IsIntegral ℤ (((|c| : ℤ) : K) * z) := by
    intro z hz
    have h1 := hc z hz
    rw [zsmul_eq_mul] at h1
    rcases abs_choice c with h' | h'
    · rw [h']; exact h1
    · rw [h', Int.cast_neg, neg_mul]; exact h1.neg
  refine ⟨|c|, Int.one_le_abs hc0, fun i => hc' _ ?_, fun j => hc' _ ?_, fun k => hc' _ ?_⟩ <;>
    simp

/-- A common bound `H ≥ 1` for the houses of three finite families. -/
lemma exists_house_bound {K : Type*} [Field K] [NumberField K] {α β γ : Type*} [Fintype α]
    [Fintype β] [Fintype γ] (f : α → K) (g : β → K) (h : γ → K) :
    ∃ H : ℝ, 1 ≤ H ∧ (∀ i, house (f i) ≤ H) ∧ (∀ j, house (g j) ≤ H) ∧ ∀ k, house (h k) ≤ H := by
  have h1 : 0 ≤ ∑ i, house (f i) := Finset.sum_nonneg fun i _ => house_nonneg _
  have h2 : 0 ≤ ∑ j, house (g j) := Finset.sum_nonneg fun j _ => house_nonneg _
  have h3 : 0 ≤ ∑ k, house (h k) := Finset.sum_nonneg fun k _ => house_nonneg _
  refine ⟨1 + ∑ i, house (f i) + ∑ j, house (g j) + ∑ k, house (h k), by linarith,
    fun i => ?_, fun j => ?_, fun k => ?_⟩
  · have := Finset.single_le_sum (f := fun i => house (f i)) (fun _ _ => house_nonneg _)
      (Finset.mem_univ i)
    linarith
  · have := Finset.single_le_sum (f := fun j => house (g j)) (fun _ _ => house_nonneg _)
      (Finset.mem_univ j)
    linarith
  · have := Finset.single_le_sum (f := fun k => house (h k)) (fun _ _ => house_nonneg _)
      (Finset.mem_univ k)
    linarith

/-! ## The arithmetic of (4.14) -/

/-- `log (n S₁ H + k) ≤ log n + log H + S₁ + log (1 + k)`. -/
lemma log_nSH_add_le {n S₁ k : ℕ} (hn : 1 ≤ n) (hS₁ : 1 ≤ S₁) {H : ℝ} (hH : 1 ≤ H) :
    Real.log ((n : ℝ) * S₁ * H + k) ≤ Real.log n + Real.log H + S₁ + Real.log (1 + k) := by
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hS₁' : (1 : ℝ) ≤ S₁ := by exact_mod_cast hS₁
  have hm : (1 : ℝ) ≤ n * H * S₁ :=
    one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hn' hH) hS₁'
  have e1 : (n : ℝ) * S₁ * H + k ≤ n * H * S₁ * (1 + k) := by
    have : (k : ℝ) ≤ n * H * S₁ * k := le_mul_of_one_le_left (by positivity) hm
    linarith
  have e2 : Real.log (n * H * S₁ * (1 + k)) =
      Real.log n + Real.log H + Real.log S₁ + Real.log (1 + k) := by
    rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity)]
  have e3 : Real.log S₁ ≤ S₁ := by
    have := Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < S₁); linarith
  have := Real.log_le_log (by positivity) e1
  linarith

/-- The logarithm of `P = (T+1)^d e^N A^k (B+k)^{T₀} H^{d₁nTS₁}`, `A = (d₁+1)TH`, `B = nS₁H`, the bound
for the house in (4.14). -/
lemma log_bound_le {n d₁ d k T₀ T S₁ : ℕ} (hn : 1 ≤ n) (hT : 1 ≤ T) (hS₁ : 1 ≤ S₁) (hT₀T : T₀ ≤ T)
    {H N : ℝ} (hH : 1 ≤ H) (hN : 0 ≤ N) :
    0 ≤ Real.log (((T : ℝ) + 1) ^ d * Real.exp N * ((((d₁ : ℝ) + 1) * T * H) ^ k *
        ((n : ℝ) * S₁ * H + k) ^ T₀ * H ^ (d₁ * n * T * S₁))) ∧
    Real.log (((T : ℝ) + 1) ^ d * Real.exp N * ((((d₁ : ℝ) + 1) * T * H) ^ k *
        ((n : ℝ) * S₁ * H + k) ^ T₀ * H ^ (d₁ * n * T * S₁))) ≤
      d * T + N + k * (Real.log (d₁ + 1) + Real.log T + Real.log H) +
        T * (Real.log n + Real.log H + S₁ + Real.log (1 + k)) + d₁ * n * T * S₁ * Real.log H := by
  have hT' : (1 : ℝ) ≤ T := by exact_mod_cast hT
  have hB : 1 ≤ (n : ℝ) * S₁ * H + k := by
    have : (1 : ℝ) ≤ n * S₁ * H := one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (by exact_mod_cast hn) (by exact_mod_cast hS₁)) hH
    linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]
  have hd1 : (1 : ℝ) ≤ (d₁ : ℝ) + 1 := by linarith [(Nat.cast_nonneg d₁ : (0 : ℝ) ≤ d₁)]
  rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
    Real.log_pow, Real.log_exp, Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity), Real.log_pow, Real.log_pow, Real.log_pow,
    Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity)]
  have l1 : Real.log ((T : ℝ) + 1) ≤ T := by
    have := Real.log_le_log (by positivity) (Real.add_one_le_exp (T : ℝ))
    rwa [Real.log_exp] at this
  have l0 : 0 ≤ Real.log ((T : ℝ) + 1) := Real.log_nonneg (by linarith)
  have l2 := Real.log_nonneg hB
  have l3 := Real.log_nonneg hH
  have l4 := Real.log_nonneg hd1
  have l5 := Real.log_nonneg hT'
  have e1 : (d : ℝ) * Real.log ((T : ℝ) + 1) ≤ d * T := mul_le_mul_of_nonneg_left l1 (by positivity)
  have e2 : (T₀ : ℝ) * Real.log ((n : ℝ) * S₁ * H + k) ≤
      T * (Real.log n + Real.log H + S₁ + Real.log (1 + k)) :=
    mul_le_mul (by exact_mod_cast hT₀T) (log_nSH_add_le hn hS₁ hH) l2 (by positivity)
  push_cast
  exact ⟨by positivity, by linarith⟩

/-- The terms of (4.14) with a factor `T` are at most `G · T S₁`. -/
lemma bracket_TS_le {n d₁ d T₀ T S₁ : ℕ} (hT₀T : T₀ ≤ T) (hS₁ : 1 ≤ S₁) {lδ lH ln G : ℝ}
    (hlδ : 0 ≤ lδ) (hlH : 0 ≤ lH) (hln : 0 ≤ ln)
    (hG : (1 + (d₁ : ℝ) * n) * (lδ + lH) + d + ln + 1 ≤ G) :
    (T₀ : ℝ) * lδ + d₁ * n * T * S₁ * lδ + d * T + T * ln + T * lH + T * S₁ +
      d₁ * n * T * S₁ * lH ≤ G * (T * S₁) := by
  have hTS : (T : ℝ) ≤ T * S₁ := le_mul_of_one_le_right (by positivity) (by exact_mod_cast hS₁)
  have f0 : (T₀ : ℝ) * lδ ≤ T * lδ := mul_le_mul_of_nonneg_right (by exact_mod_cast hT₀T) hlδ
  have f1 : (T : ℝ) * lδ ≤ T * S₁ * lδ := mul_le_mul_of_nonneg_right hTS hlδ
  have f2 : (d : ℝ) * T ≤ d * (T * S₁) := mul_le_mul_of_nonneg_left hTS (by positivity)
  have f3 : (T : ℝ) * ln ≤ T * S₁ * ln := mul_le_mul_of_nonneg_right hTS hln
  have f4 : (T : ℝ) * lH ≤ T * S₁ * lH := mul_le_mul_of_nonneg_right hTS hlH
  have f5 := mul_le_mul_of_nonneg_right hG (by positivity : (0 : ℝ) ≤ T * S₁)
  linarith

/-- The bracket of (4.14) is at most `G (N + k (1 + log T) + T (S₁ + log (1 + k)))`. -/
lemma bracket_le {n d₁ d k T₀ T S₁ : ℕ} (hn : 1 ≤ n) (hT : 1 ≤ T) (hS₁ : 1 ≤ S₁) (hT₀T : T₀ ≤ T)
    {lδ lH N : ℝ} (hlδ : 0 ≤ lδ) (hlH : 0 ≤ lH) (hN : 0 ≤ N) :
    ((k : ℝ) + T₀ + d₁ * n * T * S₁) * lδ + (d * T + N +
        k * (Real.log (d₁ + 1) + Real.log T + lH) +
        T * (Real.log n + lH + S₁ + Real.log (1 + k)) + d₁ * n * T * S₁ * lH) ≤
      (2 + 2 * (1 + d₁ * n) * (lδ + lH) + Real.log (d₁ + 1) + d + Real.log n) *
        (N + k * (1 + Real.log T) + T * (S₁ + Real.log (1 + k))) := by
  have hld : 0 ≤ Real.log ((d₁ : ℝ) + 1) :=
    Real.log_nonneg (by linarith [(Nat.cast_nonneg d₁ : (0 : ℝ) ≤ d₁)])
  have hlT : 0 ≤ Real.log T := Real.log_nonneg (by exact_mod_cast hT)
  have hln : 0 ≤ Real.log n := Real.log_nonneg (by exact_mod_cast hn)
  have hlk : 0 ≤ Real.log (1 + k) :=
    Real.log_nonneg (by linarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)])
  have hd0 : (0 : ℝ) ≤ d := by positivity
  have hX : 0 ≤ (1 + (d₁ : ℝ) * n) * (lδ + lH) := by positivity
  have hX' : lδ + lH ≤ (1 + (d₁ : ℝ) * n) * (lδ + lH) :=
    le_mul_of_one_le_left (by positivity) (le_add_of_nonneg_right (by positivity))
  set G := 2 + 2 * (1 + (d₁ : ℝ) * n) * (lδ + lH) + Real.log (d₁ + 1) + d + Real.log n with hG
  have hG1 : 1 ≤ G := by rw [hG]; linarith
  have c1 : N ≤ G * N := le_mul_of_one_le_left hN hG1
  have c2 : (k : ℝ) * (lδ + Real.log (d₁ + 1) + lH) ≤ G * k := by
    have := mul_le_mul_of_nonneg_left (show lδ + Real.log (d₁ + 1) + lH ≤ G by rw [hG]; linarith)
      (Nat.cast_nonneg k : (0 : ℝ) ≤ k)
    linarith
  have c3 : (k : ℝ) * Real.log T ≤ G * (k * Real.log T) := le_mul_of_one_le_left (by positivity) hG1
  have c4 := bracket_TS_le (n := n) (d₁ := d₁) (d := d) hT₀T hS₁ hlδ hlH hln (G := G)
    (by rw [hG]; linarith)
  have c5 : (T : ℝ) * Real.log (1 + k) ≤ G * (T * Real.log (1 + k)) :=
    le_mul_of_one_le_left (by positivity) hG1
  linarith

/-- The arithmetic of (4.14): from Liouville's inequality to a lower bound for `log z`. -/
lemma liouville_log_bound {D n d₁ d k T₀ T S₁ : ℕ} (hD : 1 ≤ D) (hn : 1 ≤ n) (hT : 1 ≤ T)
    (hS₁ : 1 ≤ S₁) (hT₀T : T₀ ≤ T) {δ H N z : ℝ} (hδ : 1 ≤ δ) (hH : 1 ≤ H) (hN : 0 ≤ N)
    (hz : 0 < z)
    (hL : 1 ≤ δ ^ ((k + T₀ + d₁ * n * T * S₁) * D) * z *
      (((T : ℝ) + 1) ^ d * Real.exp N * ((((d₁ : ℝ) + 1) * T * H) ^ k *
        ((n : ℝ) * S₁ * H + k) ^ T₀ * H ^ (d₁ * n * T * S₁))) ^ (D - 1)) :
    -(D * (2 + 2 * (1 + d₁ * n) * (Real.log δ + Real.log H) + Real.log (d₁ + 1) + d +
        Real.log n) * (N + k * (1 + Real.log T) + T * (S₁ + Real.log (1 + k)))) ≤ Real.log z := by
  obtain ⟨hP0, hP⟩ := log_bound_le (d := d) (d₁ := d₁) (k := k) hn hT hS₁ hT₀T hH hN
  have hB := bracket_le (d := d) (d₁ := d₁) (k := k) hn hT hS₁ hT₀T (Real.log_nonneg hδ)
    (Real.log_nonneg hH) hN
  have hHpos : 0 < H := by linarith
  have h0 := Real.log_le_log (by norm_num) hL
  rw [Real.log_one, Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by positivity) hz.ne', Real.log_pow, Real.log_pow, Nat.cast_sub hD] at h0
  set lP := Real.log (((T : ℝ) + 1) ^ d * Real.exp N * ((((d₁ : ℝ) + 1) * T * H) ^ k *
    ((n : ℝ) * S₁ * H + k) ^ T₀ * H ^ (d₁ * n * T * S₁))) with hlP
  push_cast at h0
  have hD' : (1 : ℝ) ≤ D := by exact_mod_cast hD
  have e1 : ((D : ℝ) - 1) * lP ≤ D * lP := mul_le_mul_of_nonneg_right (by linarith) hP0
  have e2 := mul_le_mul_of_nonneg_left hB (by positivity : (0 : ℝ) ≤ D)
  have e3 := mul_le_mul_of_nonneg_left hP (by positivity : (0 : ℝ) ≤ D)
  linarith

end ExpMonomialsLiouvilleLower

open NumberField ExpMonomialsLiouvilleLower in
/-- **Liouville's lower bound (4.14) for exponential monomials at lattice points** (DALAG §4.6). -/
theorem solution {ι : Type*} [Fintype ι] [DecidableEq ι] {d₁ : ℕ}
    (x : Fin d₁ → ι → ℂ) (hxalg : ∀ i ν, IsAlgebraic ℚ (x i ν)) (y : ι → ι → ℂ)
    (hexp : ∀ i j, IsAlgebraic ℚ (Complex.exp (∑ ν, x i ν * y j ν))) (k₀ : ι) {d₀ : ℕ}
    (hd₀ : d₀ ≤ 1) (hy₀ : d₀ = 1 → ∀ j, IsAlgebraic ℚ (y j k₀)) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (T S₁ : ℕ) (p : Fin (d₀ * T + 1) × (Fin d₁ → Fin (T + 1)) → ℤ) (N : ℝ)
      (s : ι → Fin S₁) (k : ℕ) (L : Fin k → ι),
      1 ≤ T → 0 ≤ N → (∀ l, |(p l : ℝ)| ≤ Real.exp N) →
      iteratedFDeriv ℂ k (fun z : ι → ℂ => ∑ l, (p l : ℂ) * (z k₀ ^ (l.1 : ℕ) *
        Complex.exp (∑ ν, (∑ i, ((l.2 i : ℕ) : ℂ) * x i ν) * z ν))) (∑ j, ((s j : ℕ) : ℂ) • y j)
        (fun l => Pi.single (L l) 1) ≠ 0 →
      -(C * (N + k * (1 + Real.log T) + T * (S₁ + Real.log (1 + k)))) ≤
        Real.log ‖iteratedFDeriv ℂ k (fun z : ι → ℂ => ∑ l, (p l : ℂ) * (z k₀ ^ (l.1 : ℕ) *
          Complex.exp (∑ ν, (∑ i, ((l.2 i : ℕ) : ℂ) * x i ν) * z ν))) (∑ j, ((s j : ℕ) : ℂ) • y j)
          (fun l => Pi.single (L l) 1)‖ := by
  classical
  set n := Fintype.card ι with hn_def
  have hn : 1 ≤ n := Fintype.card_pos_iff.mpr ⟨k₀⟩
  /- Step 1: a number field `K ⊂ ℂ` containing the `x_{iν}`, the `e^{⟨xᵢ, y_j⟩}` and, if `d₀ = 1`,
  the `y_{j k₀}`. -/
  set S : Finset ℂ := (Finset.univ.image fun q : Fin d₁ × ι => x q.1 q.2) ∪
    (Finset.univ.image fun q : Fin d₁ × ι => Complex.exp (∑ ν, x q.1 ν * y q.2 ν)) ∪
    (Finset.univ.filter fun _ : ι => d₀ = 1).image (fun j => y j k₀) with hS
  have halg : ∀ z ∈ S, IsAlgebraic ℚ z := by
    intro z hz
    rcases Finset.mem_union.mp hz with h | h
    · rcases Finset.mem_union.mp h with h | h
      · obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp h; exact hxalg _ _
      · obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp h; exact hexp _ _
    · obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp h
      exact hy₀ (Finset.mem_filter.mp hj).2 j
  obtain ⟨K, _, _, φK, hK⟩ := exists_numberField S halg
  have hξ' : ∀ i ν, ∃ w : K, φK w = x i ν := fun i ν => hK _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_image.mpr ⟨(i, ν), Finset.mem_univ _, rfl⟩)))
  have ha' : ∀ i j, ∃ w : K, φK w = Complex.exp (∑ ν, x i ν * y j ν) := fun i j =>
    hK _ (Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨(i, j), Finset.mem_univ _, rfl⟩)))
  have hη' : ∀ j, ∃ w : K, d₀ = 1 → φK w = y j k₀ := by
    intro j
    by_cases h : d₀ = 1
    · obtain ⟨w, hw⟩ := hK (y j k₀) (Finset.mem_union_right _ (Finset.mem_image.mpr
        ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩, rfl⟩))
      exact ⟨w, fun _ => hw⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose ξ hξ using hξ'
  choose a ha using ha'
  choose η hη using hη'
  /- Step 2: a common denominator `δ` and a common bound `H` for the houses. -/
  obtain ⟨δ, hδ1, hδξ, hδη, hδa⟩ := exists_denominator (fun q : Fin d₁ × ι => ξ q.1 q.2) η
    (fun q : Fin d₁ × ι => a q.1 q.2)
  obtain ⟨H, hH, hξH, hηH, haH⟩ := exists_house_bound (fun q : Fin d₁ × ι => ξ q.1 q.2) η
    (fun q : Fin d₁ × ι => a q.1 q.2)
  have hδ1' : (1 : ℝ) ≤ δ := by exact_mod_cast hδ1
  have hD : 1 ≤ Module.finrank ℚ K := Module.finrank_pos
  /- Step 3: the constant. -/
  refine ⟨Module.finrank ℚ K * (2 + 2 * (1 + d₁ * n) * (Real.log δ + Real.log H) +
    Real.log (d₁ + 1) + (d₀ + d₁ : ℕ) + Real.log n), ?_, ?_⟩
  · have h1 : (1 : ℝ) ≤ Module.finrank ℚ K := by exact_mod_cast hD
    have h2 : (1 : ℝ) ≤ 2 + 2 * (1 + d₁ * n) * (Real.log δ + Real.log H) +
        Real.log (d₁ + 1) + (d₀ + d₁ : ℕ) + Real.log n := by
      have := Real.log_nonneg hδ1'
      have := Real.log_nonneg hH
      have : 0 ≤ Real.log ((d₁ : ℝ) + 1) :=
        Real.log_nonneg (by linarith [(Nat.cast_nonneg d₁ : (0 : ℝ) ≤ d₁)])
      have : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg (by exact_mod_cast hn)
      have : (0 : ℝ) ≤ 2 * (1 + d₁ * n) * (Real.log δ + Real.log H) := by positivity
      have : (0 : ℝ) ≤ ((d₀ + d₁ : ℕ) : ℝ) := by positivity
      linarith
    exact one_le_mul_of_one_le_of_one_le h1 h2
  /- Step 4: Liouville's inequality for the `γ` with `D^L F(sy) = φK γ`. -/
  intro T S₁ p N s k L hT hN hp hne
  have hS₁ : 1 ≤ S₁ := lt_of_le_of_lt (Nat.zero_le _) (s k₀).2
  have hd₀T : 0 < d₀ * T → d₀ = 1 := by
    intro h
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hd₀ with h0 | h1
    · rw [h0, zero_mul] at h; exact absurd h (lt_irrefl 0)
    · exact h1
  obtain ⟨γ, hγ, hγh, hγi⟩ := Transcendence.exp_monomials_deriv_lattice φK x y k₀ ξ hξ η a ha δ
    (fun i ν => hδξ (i, ν)) hδη (fun i j => hδa (i, j)) hH (fun i ν => hξH (i, ν)) hηH
    (fun i j => haH (i, j)) (fun h j => hη j (hd₀T h)) hT p hp s k L
  rw [hγ] at hne ⊢
  have hγ0 : γ ≠ 0 := by rintro rfl; exact hne (map_zero φK)
  have hδ0 : δ ^ (k + d₀ * T + d₁ * n * T * S₁) ≠ 0 := pow_ne_zero _ (by omega)
  have hL := Transcendence.liouville_house hγ0 hδ0 (by push_cast; exact hγi) φK
  have hcard : (((d₀ * T : ℕ) : ℝ) + 1) * ((T : ℝ) + 1) ^ d₁ = ((T : ℝ) + 1) ^ (d₀ + d₁) := by
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hd₀ with h | h <;> subst h <;> push_cast <;> ring
  rw [hcard] at hγh
  have hL' : 1 ≤ (δ : ℝ) ^ ((k + d₀ * T + d₁ * n * T * S₁) * Module.finrank ℚ K) * ‖φK γ‖ *
      (((T : ℝ) + 1) ^ (d₀ + d₁) * Real.exp N * ((((d₁ : ℝ) + 1) * T * H) ^ k *
        ((n : ℝ) * S₁ * H + k) ^ (d₀ * T) * H ^ (d₁ * n * T * S₁))) ^ (Module.finrank ℚ K - 1) := by
    calc (1 : ℝ) ≤ _ := hL
      _ ≤ _ := by
        rw [Int.cast_pow, abs_pow, abs_of_pos (by positivity : (0 : ℝ) < δ), ← pow_mul]
        gcongr
        exact house_nonneg _
  have hT₀T : d₀ * T ≤ T := by
    calc d₀ * T ≤ 1 * T := Nat.mul_le_mul_right _ hd₀
      _ = T := one_mul T
  have h := liouville_log_bound hD hn hT hS₁ hT₀T hδ1' hH hN (norm_pos_iff.mpr hne) hL'
  push_cast at h ⊢
  exact h
