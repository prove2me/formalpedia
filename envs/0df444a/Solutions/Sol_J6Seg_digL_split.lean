/-!
# B-line machine, sweep 1: in-place axis maps

The machine keeps the array in its row-major layout and applies the line map of axis `i` in
place (no axis rotation). For a box `dims` and an axis `i`, the array is `(pre, n, post)`
(`pre = ∏_{j<i}`, `n = dims_i`, `post = ∏_{j>i}`), and

* `axisL n post f L`: every `(n, post)` block is transposed, `f` is applied to each of its `post`
  lines, and the block is transposed back;
* **`axisL_getD`**: entry `b (n·post) + a·post + c` of `axisL n post f L` is entry `a` of `f`
  applied to the line `k ↦ L[b (n·post) + k·post + c]`;
* **`digL_split`**: the row-major digits of `b (n·post) + a·post + c`;
* **`axisL_listOf`**: on `listOf dims g`, `axisL` is the slice map `j ↦ A (k ↦ g (j[i ↦ k])) (j i)`.
-/

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Products of a list around a position -/

theorem prod_split3 : ∀ (l : List ℕ) (i : ℕ), i < l.length →
    l.prod = (l.take i).prod * (l.getD i 1 * (l.drop (i + 1)).prod)
  | [], _, h => by simp at h
  | a :: l, 0, _ => by simp
  | a :: l, i + 1, h => by
    simp only [List.length_cons] at h
    simp only [List.prod_cons, List.take_succ_cons, List.getD_cons_succ, List.drop_succ_cons]
    rw [prod_split3 l i (by omega)]; ring

/-! ## Row-major digits of a split index -/

theorem digL_split_sol_aux : ∀ (i : ℕ) (dims : List ℕ), (∀ u ∈ dims, 0 < u) → i < dims.length →
    ∀ b a c, b < (dims.take i).prod → a < dims.getD i 1 → c < (dims.drop (i + 1)).prod →
    ∀ m, digL dims (b * (dims.getD i 1 * (dims.drop (i + 1)).prod) +
        a * (dims.drop (i + 1)).prod + c) m =
      if m < i then digL (dims.take i) b m else if m = i then a
      else digL (dims.drop (i + 1)) c (m - i - 1)
  | 0, [], _, h, _, _, _, _, _, _, _ => by simp at h
  | 0, t :: ts, _, _, b, a, c, hb, ha, hc, m => by
    simp only [List.take_zero, List.prod_nil] at hb
    have hb0 : b = 0 := by omega
    subst hb0
    simp only [List.getD_cons_zero, List.drop_succ_cons, List.drop_zero] at ha hc ⊢
    rcases m with _ | m
    · simp only [digL, zero_mul, zero_add, Nat.lt_irrefl, if_false, if_true]
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < ts.prod), Nat.div_eq_of_lt hc,
        zero_add, Nat.mod_eq_of_lt ha]
    · simp only [digL, zero_mul, zero_add, Nat.not_lt_zero, if_false,
        show m + 1 ≠ 0 from by omega]
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
      congr 1
  | i + 1, [], _, h, _, _, _, _, _, _, _ => by simp at h
  | i + 1, t :: ts, hpos, h, b, a, c, hb, ha, hc, m => by
    simp only [List.length_cons] at h
    simp only [List.take_succ_cons, List.prod_cons, List.getD_cons_succ,
      List.drop_succ_cons] at hb ha hc ⊢
    have hts : ∀ u ∈ ts, 0 < u := fun u hu => hpos u (List.mem_cons_of_mem _ hu)
    have ht : 0 < t := hpos t (List.mem_cons_self ..)
    set pre := (ts.take i).prod with hpre
    set post := (ts.drop (i + 1)).prod with hpost
    set n := ts.getD i 1 with hn
    have hpre0 : 0 < pre := List.prod_pos (fun u hu => hts u (List.mem_of_mem_take hu))
    have hprod : ts.prod = pre * (n * post) := prod_split3 ts i (by omega)
    have hpost0 : 0 < post := by omega
    have hn0 : 0 < n := by
      rcases Nat.eq_zero_or_pos n with h0 | h0
      · rw [h0] at ha; omega
      · exact h0
    obtain ⟨b0, b1, rfl, hb1⟩ : ∃ b0 b1, b = b0 * pre + b1 ∧ b1 < pre :=
      ⟨b / pre, b % pre, (Nat.div_add_mod' b pre).symm, Nat.mod_lt _ hpre0⟩
    have hb0 : b0 < t := by
      by_contra hcon; push Not at hcon
      have : t * pre ≤ b0 * pre := Nat.mul_le_mul_right _ hcon
      omega
    have hin : b1 * (n * post) + a * post + c < pre * (n * post) := by
      have h1 : a * post + c < n * post := by
        have : (a + 1) * post ≤ n * post := Nat.mul_le_mul_right _ (by omega)
        rw [Nat.succ_mul] at this; omega
      have : (b1 + 1) * (n * post) ≤ pre * (n * post) := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.succ_mul] at this; omega
    have hx : (b0 * pre + b1) * (n * post) + a * post + c =
        b0 * ts.prod + (b1 * (n * post) + a * post + c) := by rw [hprod]; ring
    rw [hx]
    rcases m with _ | m
    · simp only [digL, Nat.zero_lt_succ, if_true]
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < ts.prod),
        Nat.div_eq_of_lt (by rw [hprod]; exact hin), zero_add, Nat.mod_eq_of_lt hb0]
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hpre0, Nat.div_eq_of_lt hb1, zero_add,
        Nat.mod_eq_of_lt hb0]
    · simp only [digL]
      rw [Nat.add_comm (b0 * ts.prod), Nat.add_mul_mod_self_right,
        Nat.mod_eq_of_lt (by rw [hprod]; exact hin)]
      rw [digL_split_sol_aux i ts hts (by omega) b1 a c hb1 ha hc m]
      by_cases h1 : m < i
      · rw [if_pos h1, if_pos (by omega), ← hpre, Nat.add_comm, Nat.add_mul_mod_self_right,
          Nat.mod_eq_of_lt hb1]
      · by_cases h2 : m = i
        · subst h2; simp
        · have h3 : ¬ m + 1 < i + 1 := by omega
          have h4 : ¬ m + 1 = i + 1 := by omega
          rw [if_neg h1, if_neg h2, if_neg h3, if_neg h4]
          congr 1; omega

