theorem validRun_iff_steps (h : Hidden N R anchor) (T : ℕ) (p : Population N)
    (out : ℕ → RoundResult N) :
    ValidRun candidates trial h T p (fun i => out i.val) ↔
      ∀ t < T, Computation.Reaches h (trial (replay candidates p out t)) (out t) := by sorry
