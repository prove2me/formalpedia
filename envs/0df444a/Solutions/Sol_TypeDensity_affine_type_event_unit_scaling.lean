    rw [← h1]
    exact Fin.insertNth_self_removeNth μ _
  rw [hins]
  unfold TypeDensity.normalizeAt
  apply key a
  obtain ⟨v, hv⟩ := hunit
  rw [← hv, Ring.inverse_unit]
  exact Units.isUnit _
