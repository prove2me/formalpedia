namespace OrdConnFit

open Submodule

section Intertwine

variable {M₁ M₂ : Type} [AddCommGroup M₁] [AddCommGroup M₂]

private def unitPart {M : Type} [AddCommGroup M] (f : M →ₗ[ℤ] M) : Submodule ℤ M :=
  ⨅ n, LinearMap.range (f ^ n)

private def nilPart {M : Type} [AddCommGroup M] (f : M →ₗ[ℤ] M) : Submodule ℤ M :=
  ⨆ n, LinearMap.ker (f ^ n)

private theorem mem_unitPart_iff {M : Type} [AddCommGroup M] (f : M →ₗ[ℤ] M) (x : M) :
    x ∈ unitPart f ↔ ∀ n, ∃ y, (f ^ n) y = x := by
  simp [unitPart, Submodule.mem_iInf, LinearMap.mem_range]

private theorem mem_nilPart_iff {M : Type} [AddCommGroup M] (f : M →ₗ[ℤ] M) (x : M) :
    x ∈ nilPart f ↔ ∃ n, (f ^ n) x = 0 := by
  unfold nilPart
  rw [Submodule.mem_iSup_of_directed _
    (Monotone.directed_le fun m n h => by simpa using f.iterateKer.monotone h)]
  simp [LinearMap.mem_ker]

private theorem isCompl_unitPart_nilPart {M : Type} [AddCommGroup M] [Finite M]
    (f : M →ₗ[ℤ] M) : IsCompl (unitPart f) (nilPart f) :=
  haveI : IsArtinian ℤ M := isArtinian_of_finite
  (LinearMap.isCompl_iSup_ker_pow_iInf_range_pow f).symm

private noncomputable def fitProj {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M) : M →ₗ[ℤ] M :=
  (unitPart f).projection (nilPart f) (isCompl_unitPart_nilPart f)

private theorem fitProj_mem_unitPart {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M) (x : M) :
    fitProj f x ∈ unitPart f :=
  Submodule.projection_apply_mem _ x

private theorem fitProj_eq_zero_iff {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M) (x : M) :
    fitProj f x = 0 ↔ x ∈ nilPart f :=
  Submodule.projection_apply_eq_zero_iff _

private theorem fitProj_apply_of_mem_nilPart {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M)
    {x : M} (hx : x ∈ nilPart f) : fitProj f x = 0 :=
  (fitProj_eq_zero_iff f x).mpr hx

private theorem fitProj_apply_of_mem_unitPart {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M)
    {x : M} (hx : x ∈ unitPart f) : fitProj f x = x :=
  (Submodule.projection_eq_self_iff _ _).mpr hx

private theorem sub_fitProj_mem_nilPart {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M) (x : M) :
    x - fitProj f x ∈ nilPart f :=
  Submodule.sub_projection_mem _ x

private theorem fitProj_fitProj {M : Type} [AddCommGroup M] [Finite M] (f : M →ₗ[ℤ] M) (x : M) :
    fitProj f (fitProj f x) = fitProj f x :=
  fitProj_apply_of_mem_unitPart f (fitProj_mem_unitPart f x)

private theorem pow_comp_eq_of_comp_eq (f₁ : M₁ →ₗ[ℤ] M₁) (f₂ : M₂ →ₗ[ℤ] M₂) (g : M₁ →ₗ[ℤ] M₂)
    (hg : ∀ x, g (f₁ x) = f₂ (g x)) (n : ℕ) (x : M₁) : g ((f₁ ^ n) x) = (f₂ ^ n) (g x) := by
  induction n generalizing x with
  | zero => simp
  | succ n ih => rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih, hg]

private theorem fitProj_intertwine [Finite M₁] [Finite M₂] (f₁ : M₁ →ₗ[ℤ] M₁) (f₂ : M₂ →ₗ[ℤ] M₂)
    (g : M₁ →ₗ[ℤ] M₂) (hg : ∀ x, g (f₁ x) = f₂ (g x)) (x : M₁) :
    g (fitProj f₁ x) = fitProj f₂ (g x) := by
  have ha : g (fitProj f₁ x) ∈ unitPart f₂ := by
    rw [mem_unitPart_iff]
    intro n
    obtain ⟨y, hy⟩ := (mem_unitPart_iff f₁ _).mp (fitProj_mem_unitPart f₁ x) n
    exact ⟨g y, by rw [← pow_comp_eq_of_comp_eq f₁ f₂ g hg, hy]⟩
  have hb : g (x - fitProj f₁ x) ∈ nilPart f₂ := by
    obtain ⟨n, hn⟩ := (mem_nilPart_iff f₁ _).mp (sub_fitProj_mem_nilPart f₁ x)
    rw [mem_nilPart_iff]
    exact ⟨n, by rw [← pow_comp_eq_of_comp_eq f₁ f₂ g hg, hn, map_zero]⟩
  have hsplit : g x = g (fitProj f₁ x) + g (x - fitProj f₁ x) := by rw [← map_add, add_sub_cancel]
  rw [hsplit, map_add, fitProj_apply_of_mem_nilPart f₂ hb, add_zero, fitProj_apply_of_mem_unitPart f₂ ha]

private theorem fitProj_mem_of_mem [Finite M₂] (f : M₂ →ₗ[ℤ] M₂) (S : AddSubgroup M₂)
    (hS : ∀ y ∈ S, f y ∈ S) {x : M₂} (hx : x ∈ S) : fitProj f x ∈ S := by
  haveI : Finite S := Finite.of_injective _ Subtype.coe_injective
  let fS : S →ₗ[ℤ] S :=
    { toFun := fun y => ⟨f y, hS _ y.2⟩
      map_add' := fun y z => Subtype.ext (by simp)
      map_smul' := fun c y => Subtype.ext (by simp) }
  let g : S →ₗ[ℤ] M₂ :=
    { toFun := fun y => (y : M₂)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have h := fitProj_intertwine fS f g (fun _ => rfl) ⟨x, hx⟩
  change ((fitProj fS ⟨x, hx⟩ : S) : M₂) = fitProj f x at h
  rw [← h]
  exact SetLike.coe_mem _

end Intertwine

section Levels

variable (J : Type) [AddCommGroup J] (p : ℕ) (f : J →ₗ[ℤ] J)

private def lvl (k : ℕ) : AddSubgroup J where
  carrier := {x | ((p : ℤ) ^ k) • x = 0}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [smul_add, hx, hy, add_zero]
  zero_mem' := by simp
  neg_mem' := by
    intro x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [smul_neg, hx, neg_zero]

variable {J}

private theorem mem_lvl_iff (k : ℕ) (x : J) : x ∈ lvl J p k ↔ ((p : ℤ) ^ k) • x = 0 := Iff.rfl

private theorem map_mem_lvl {k : ℕ} {x : J} (hx : x ∈ lvl J p k) : f x ∈ lvl J p k := by
  rw [mem_lvl_iff] at hx ⊢
  rw [← map_zsmul, hx, map_zero]

private def flvl (k : ℕ) : lvl J p k →ₗ[ℤ] lvl J p k where
  toFun x := ⟨f x, map_mem_lvl p f x.2⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' c x := Subtype.ext (by simp)

@[scoped simp] private theorem coe_flvl (k : ℕ) (x : lvl J p k) : ((flvl p f k x : lvl J p k) : J) = f x := rfl

private theorem coe_flvl_pow (k n : ℕ) (x : lvl J p k) : (((flvl p f k) ^ n) x : J) = (f ^ n) x := by
  induction n generalizing x with
  | zero => simp
  | succ n ih => rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih, coe_flvl]

private def _root_.OrdConnFit.trans (k : ℕ) : lvl J p (k + 1) →ₗ[ℤ] lvl J p k where
  toFun x := ⟨(p : ℤ) • (x : J), by
    rw [mem_lvl_iff, smul_smul, ← pow_succ, (mem_lvl_iff p (k + 1) _).mp x.2]⟩
  map_add' x y := by ext; simp [smul_add]
  map_smul' c x := by ext; simp [smul_comm c]

