-- title:
--   §1.3, proof of Theorem 3, p. 5 — lim_{k→∞} ‖z_k − x*‖ exists
-- statement:
--   Let $\mathcal H$, $\Psi$, $\Phi$, $L$, $s$, $\alpha>3$ and the sequence $(x_k)$ generated by algorithm (2) be as in Theorem 3, and let $x^*\in\operatorname{argmin}(\Psi+\Phi)$. Let
--   $$z_k = x_k + \frac{k-1}{\alpha-1}(x_k - x_{k-1})$$
--   be the auxiliary sequence (6). Then the limit
--
--   $$\lim_{k\to\infty}\|z_k - x^*\|$$
--
--   exists (as a real number).
--
--   The sequence $(z_k)$ carries the Lyapunov energy of the method; the convergence of its distance to every minimizer is transferred to $(x_k)$ in the next step of the proof of Theorem 3.
--
--   **Formalization Note** "The limit exists" is the existence of a real $l$ with $\|z_k-x^*\|\to l$. Conventions as in the other items: $L\ge0$, $0<s$, $sL<1$, the proximal map as a map $P$, the run from $k=1$.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 5, §1.3, proof of Theorem 3, last paragraph ("It follows that lim ‖z_k − x*‖ exists")

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Weak_Algorithm
open Filter Topology NNReal

namespace NesterovFB.Weak

theorem zSeq_dist_converges
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : ℝ≥0) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hα : 3 < α)
    (hrun : NesterovFB.Rates.IsAccelFBRun Φ P α s x)
    (xstar : H) (hxstar : ∀ y, NesterovFB.Rates.theta Ψ Φ xstar ≤ NesterovFB.Rates.theta Ψ Φ y) :
    ∃ l : ℝ, Tendsto (fun k => ‖NesterovFB.Rates.zSeq α x k - xstar‖) atTop (𝓝 l) := by sorry

end NesterovFB.Weak
