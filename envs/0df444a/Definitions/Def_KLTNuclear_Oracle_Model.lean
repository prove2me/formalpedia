-- title:
--   Trace regression model (1.1), the $L_2(\Pi)$ geometry, the matrix $\mathbf M$ of (2.2), the estimator (1.5)–(1.6) and Assumption 1
-- statement:
--   This module fixes the objects of the trace regression setting of Koltchinskii, Lounici and Tsybakov.
--
--   Let $(\Omega,\mathcal F,\mathbb P)$ be a probability space and $n\ge 1$. A sample is a family of random pairs $(X_i,Y_i)$, $i=1,\dots,n$, where each $X_i$ is a random real $m_1\times m_2$ matrix and each $Y_i$ a real random variable. Write $\langle A,B\rangle=\operatorname{tr}(A^\top B)$ for the Frobenius inner product, $\|A\|_1$ for the nuclear norm and $\|A\|_\infty$ for the operator norm (largest singular value). Expectations of random matrices are taken entrywise.
--
--   1. **Sample regularity.** Every entry of every $X_i$ is measurable and square integrable, every $Y_i$ is measurable and integrable, and every product $Y_i(X_i)_{jk}$ is integrable.
--   2. **Trace regression model (1.1).** For a matrix $A_0$, $\mathbb E(Y_i\mid X_i)=\langle A_0,X_i\rangle$ almost surely for every $i$, the conditioning being on the $\sigma$-algebra generated by the entries of $X_i$.
--   3. **The $L_2(\Pi)$ geometry (p. 2).** With $\Pi=\frac1n\sum_i\Pi_i$, $\Pi_i$ the law of $X_i$,
--   $$\langle A,B\rangle_{L_2(\Pi)}=\frac1n\sum_{i=1}^n\mathbb E\big(\langle A,X_i\rangle\langle B,X_i\rangle\big),\qquad \|A\|_{L_2(\Pi)}^2=\langle A,A\rangle_{L_2(\Pi)},$$
--   and $\|A\|_{L_2(\Pi)}=\sqrt{\|A\|^2_{L_2(\Pi)}}$. This is only a semi-norm.
--   4. **The random matrix (2.2).** At a realization $\omega$ of the sample,
--   $$\mathbf M=\frac1n\sum_{i=1}^n\big(Y_iX_i-\mathbb E(Y_iX_i)\big).$$
--   5. **The estimator (1.5)–(1.6).** For a set $\mathbb A$ of $m_1\times m_2$ matrices and $\lambda>0$,
--   $$L_n(A)=\|A\|^2_{L_2(\Pi)}-\Big\langle\frac2n\sum_{i=1}^nY_iX_i,\,A\Big\rangle+\lambda\|A\|_1,$$
--   and $\hat A$ is an estimator $\hat A^\lambda\in\operatorname{argmin}_{A\in\mathbb A}L_n(A)$ when $\hat A\in\mathbb A$ and $L_n(\hat A)\le L_n(A)$ for every $A\in\mathbb A$.
--   6. **Subgradients of the nuclear norm.** $V$ is a subgradient of $\|\cdot\|_1$ at $A$ when $\|A\|_1+\langle V,B-A\rangle\le\|B\|_1$ for every matrix $B$.
--   7. **Assumption 1 (p. 6).** For a constant $\mu>0$, $\|A\|^2_{L_2(\Pi)}\ge\mu^{-2}\|A\|_2^2$ for every $A\in\mathbb A-\mathbb A=\{A_1-A_2:A_1,A_2\in\mathbb A\}$, where $\|\cdot\|_2$ is the Frobenius norm.
--
--   These are the objects in which Theorem 1, the paper's general sharp oracle inequality, and every step of its proof are stated.
--
--   **Formalization Note** The matrix layer (`RealMatrix`, `matrixInner`, `nuclearNorm`, `spectralNorm`, `frobeniusNormSq`, SVD data and the projections $P_{S_1}\cdot P_{S_2}$, $\mathcal P_A$, $P_{S_1^\perp}\cdot P_{S_2^\perp}$) is imported from the published `MatrixCompletion` definitions. The integrability conditions of item 1 are not printed in the paper; they are what makes the expectations in items 2–4 meaningful (a Bochner integral of a non-integrable function is $0$ in Lean). The estimator is any minimizer; its existence is not asserted. Independence of the pairs, assumed on p. 1, is not part of these objects.
-- source:
--   Koltchinskii, Lounici, Tsybakov, Nuclear-Norm Penalization and Optimal Rates for Noisy Low-Rank Matrix Completion, arXiv:1011.6256v4, pp. 1–2 (1.1), p. 4 (1.5)–(1.6), p. 6 (2.1), (2.2), Assumption 1

import Mathlib
import Definitions.Def_matrix_completion_tangent

open MeasureTheory MatrixCompletion

namespace KLTNuclear.Oracle

/-!
Trace regression model of Koltchinskii, Lounici and Tsybakov (arXiv:1011.6256v4, pp. 1–6):
the `L₂(Π)` inner product and semi-norm, the random matrix `𝐌` of (2.2), the penalized
empirical risk `L_n` of (1.6), the estimator `Â^λ` of (1.5) (any minimizer over `𝔸`),
subgradients of the nuclear norm, and Assumption 1.

A sample of size `n` is `X : Fin n → Ω → RealMatrix m₁ m₂`, `Y : Fin n → Ω → ℝ` on a
probability space `(Ω, P)`; `Π_i` is the law of `X i`. Expectations of matrices are
entrywise.
-/

/-- `⟨A, B⟩_{L₂(Π)} = (1/n) Σᵢ E(⟨A, Xᵢ⟩⟨B, Xᵢ⟩)` (p. 2). -/
noncomputable def l2Inner {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (A B : RealMatrix m₁ m₂) : ℝ :=
  (1 / (n : ℝ)) * ∑ i, ∫ ω, matrixInner A (X i ω) * matrixInner B (X i ω) ∂P

/-- `‖A‖²_{L₂(Π)} = (1/n) Σᵢ E(⟨A, Xᵢ⟩²)` (p. 2), kept as a square. -/
noncomputable def l2NormSq {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (A : RealMatrix m₁ m₂) : ℝ :=
  l2Inner P X A A

/-- `‖A‖_{L₂(Π)} = √(‖A‖²_{L₂(Π)})`, used in (2.17). -/
noncomputable def l2Norm {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (A : RealMatrix m₁ m₂) : ℝ :=
  Real.sqrt (l2NormSq P X A)

/-- The matrix `E(Yᵢ Xᵢ)`, computed entrywise. -/
noncomputable def expectYX {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (i : Fin n) : RealMatrix m₁ m₂ :=
  fun j k => ∫ ω, Y i ω * X i ω j k ∂P

/-- The random matrix (2.2): `𝐌 = (1/n) Σᵢ (Yᵢ Xᵢ − E(Yᵢ Xᵢ))`, at the realization `ω`. -/
noncomputable def noiseMatrix {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (ω : Ω) : RealMatrix m₁ m₂ :=
  (1 / (n : ℝ)) • ∑ i, (Y i ω • X i ω - expectYX P X Y i)

/-- The matrix `(2/n) Σᵢ Yᵢ Xᵢ` at the realization `ω`. -/
noncomputable def empiricalYX {Ω : Type*} {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (ω : Ω) : RealMatrix m₁ m₂ :=
  (2 / (n : ℝ)) • ∑ i, Y i ω • X i ω

/-- The penalized empirical risk (1.6) at the realization `ω`:
`L_n(A) = ‖A‖²_{L₂(Π)} − ⟨(2/n) Σᵢ Yᵢ Xᵢ, A⟩ + λ‖A‖₁`. -/
noncomputable def Ln {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (lam : ℝ) (ω : Ω)
    (A : RealMatrix m₁ m₂) : ℝ :=
  l2NormSq P X A - matrixInner (empiricalYX X Y ω) A + lam * nuclearNorm A

/-- (1.5): `Â` is an estimator `Â^λ ∈ argmin_{A ∈ 𝔸} L_n(A)` at the realization `ω`,
i.e. `Â ∈ 𝔸` and `L_n(Â) ≤ L_n(A)` for every `A ∈ 𝔸`. -/
def IsEstimator {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (lam : ℝ) (ω : Ω)
    (𝔸 : Set (RealMatrix m₁ m₂)) (Ahat : RealMatrix m₁ m₂) : Prop :=
  Ahat ∈ 𝔸 ∧ ∀ A ∈ 𝔸, Ln P X Y lam ω Ahat ≤ Ln P X Y lam ω A

/-- Standing measurability and integrability of the sample: every entry of every `Xᵢ` is
square integrable, every `Yᵢ` is integrable, and every `Yᵢ (Xᵢ)_{jk}` is integrable. -/
def SampleRegularity {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) : Prop :=
  (∀ i j k, Measurable fun ω => X i ω j k) ∧ (∀ i, Measurable (Y i)) ∧
    (∀ i j k, MemLp (fun ω => X i ω j k) 2 P) ∧ (∀ i, Integrable (Y i) P) ∧
    (∀ i j k, Integrable (fun ω => Y i ω * X i ω j k) P)

/-- The trace regression model (1.1): `E(Yᵢ | Xᵢ) = ⟨A₀, Xᵢ⟩` almost surely, for every `i`,
the conditional expectation being taken given the σ-algebra generated by the entries of `Xᵢ`. -/
def TraceRegressionModel {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (A₀ : RealMatrix m₁ m₂) : Prop :=
  ∀ i, P[Y i | MeasurableSpace.comap (fun ω (j : Fin m₁) (k : Fin m₂) => X i ω j k)
      inferInstance] =ᵐ[P] fun ω => matrixInner A₀ (X i ω)

/-- `V` is a subgradient of the nuclear norm `‖·‖₁` at `A`: `‖A‖₁ + ⟨V, B − A⟩ ≤ ‖B‖₁`
for every matrix `B`. -/
def IsNuclearSubgradient {m₁ m₂ : ℕ} (A V : RealMatrix m₁ m₂) : Prop :=
  ∀ B : RealMatrix m₁ m₂, nuclearNorm A + matrixInner V (B - A) ≤ nuclearNorm B

/-- Assumption 1 with constant `μ`: `μ > 0` and `‖A‖²_{L₂(Π)} ≥ μ⁻² ‖A‖₂²` for every
`A ∈ 𝔸 − 𝔸 = {A₁ − A₂ : A₁, A₂ ∈ 𝔸}`. -/
def Assumption1 {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (𝔸 : Set (RealMatrix m₁ m₂)) (μ : ℝ) : Prop :=
  0 < μ ∧ ∀ D ∈ {D : RealMatrix m₁ m₂ | ∃ A₁ ∈ 𝔸, ∃ A₂ ∈ 𝔸, D = A₁ - A₂},
    (μ ^ 2)⁻¹ * frobeniusNormSq D ≤ l2NormSq P X D

end KLTNuclear.Oracle


