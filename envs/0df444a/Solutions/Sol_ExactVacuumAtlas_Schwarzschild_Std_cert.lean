  nonempty := domStd_nonempty M
  symm x _ i j := by
    fin_cases i <;> fin_cases j <;> first | exact symm_0_0 M x | exact symm_0_1 M x | exact symm_0_2 M x | exact symm_0_3 M x | exact symm_1_0 M x | exact symm_1_1 M x | exact symm_1_2 M x | exact symm_1_3 M x | exact symm_2_0 M x | exact symm_2_1 M x | exact symm_2_2 M x | exact symm_2_3 M x | exact symm_3_0 M x | exact symm_3_1 M x | exact symm_3_2 M x | exact symm_3_3 M x
  inv x hx := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      first | (refine (inv_0_0 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_0_1 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_0_2 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_0_3 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_1_0 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_1_1 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_1_2 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_1_3 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_2_0 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_2_1 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_2_2 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_2_3 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_3_0 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_3_1 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_3_2 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply]) | (refine (inv_3_3 M x (domStd_r hx) (domStd_s hx) (domStd_D hx) (domStd_f hx)).trans ?_; simp [Matrix.one_apply])
  smooth i j := by
    fin_cases i <;> fin_cases j <;> first | exact smooth_0_0 M | exact smooth_0_1 M | exact smooth_0_2 M | exact smooth_0_3 M | exact smooth_1_0 M | exact smooth_1_1 M | exact smooth_1_2 M | exact smooth_1_3 M | exact smooth_2_0 M | exact smooth_2_1 M | exact smooth_2_2 M | exact smooth_2_3 M | exact smooth_3_0 M | exact smooth_3_1 M | exact smooth_3_2 M | exact smooth_3_3 M
  smooth_inv i j := by
    fin_cases i <;> fin_cases j <;> first | exact smoothi_0_0 M | exact smoothi_0_1 M | exact smoothi_0_2 M | exact smoothi_0_3 M | exact smoothi_1_0 M | exact smoothi_1_1 M | exact smoothi_1_2 M | exact smoothi_1_3 M | exact smoothi_2_0 M | exact smoothi_2_1 M | exact smoothi_2_2 M | exact smoothi_2_3 M | exact smoothi_3_0 M | exact smoothi_3_1 M | exact smoothi_3_2 M | exact smoothi_3_3 M
  lorentz := lorentz M
  ricci_flat := ricci_flat M
