private def cUnit (j : Fin 2) : ℂ := if j = 0 then 1 else Complex.I

@[scoped simp] private theorem cUnit_zero : cUnit 0 = 1 := rfl

@[scoped simp] private theorem cUnit_one : cUnit 1 = Complex.I := rfl

