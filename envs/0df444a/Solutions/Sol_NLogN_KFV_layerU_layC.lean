      (phaseLayer (layerSel P K D S ρ hρ) (cLayer (layerSel P K D S ρ hρ)
        (phaseLayer (layerSel P K D S ρ hρ) xs))).map (((-Complex.I / 2) ^ (D / 2) * Butterfly.cb ^ (D % 2)) • ·) := by
