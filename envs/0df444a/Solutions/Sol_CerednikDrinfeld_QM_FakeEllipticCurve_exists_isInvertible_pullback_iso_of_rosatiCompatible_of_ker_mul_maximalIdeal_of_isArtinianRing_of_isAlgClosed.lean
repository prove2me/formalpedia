theorem tmul_sub_tmul_two {k M : Type*} [CommRing k] [AddCommGroup M] [Module k M]
    (e₀ e₁ : M) (a0 a1 b0 b1 : k) :
    (a0 • e₀ + a1 • e₁) ⊗ₜ[k] (b0 • e₀ + b1 • e₁) - (b0 • e₀ + b1 • e₁) ⊗ₜ[k] (a0 • e₀ + a1 • e₁) =
      (a0 * b1 - a1 * b0) • (e₀ ⊗ₜ[k] e₁ - e₁ ⊗ₜ[k] e₀) := by
  simp only [TensorProduct.add_tmul, TensorProduct.tmul_add, TensorProduct.smul_tmul, TensorProduct.tmul_smul,
    smul_add, smul_smul, smul_sub, sub_smul]
  rw [mul_comm b0 a0, mul_comm b0 a1, mul_comm b1 a0, mul_comm b1 a1]
  abel

