open AlgebraicCurve ModularCurve

theorem ModularCurve.placeWidth_dvd_div_two_iff_dvd_add_div_two_of_mem_ssPlaces (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p) (K : Type) [Field K] [CharP K p] [IsAlgClosed K] [DecidableEq K] (N : ℕ) [NeZero N]
    (hN : (N : K) ≠ 0)
    (x : Place K ↥(modularFunctionFieldC K N)) (hx : x ∈ ssPlaces p N K) (k : ℤ) (hk : 2 ≤ k) (hk2 : 2 ∣ k) :
    ((placeWidth N x : ℤ) ∣ k / 2) ↔ ((placeWidth N x : ℤ) ∣ (k + ((p : ℤ) + 1)) / 2) := by sorry
