theorem _root_.solution
    {theta transport : ℝ}
    (htheta : 0 < theta)
    (htransport0 : 0 < transport)
    (htransport : transport < centralRenyiAsymptoticRate theta) :
    0 < refinedCentralRenyiInverseRateFactor theta transport := by
  have hB := holderScaleExponent_pos htheta
  have hz0 := centralRenyiAbsorption_pos htheta htransport0
  have hz1 := centralRenyiAbsorption_lt_one htheta htransport
  unfold refinedCentralRenyiInverseRateFactor
  dsimp only
  exact Real.rpow_pos_of_pos (mul_pos
    (div_pos hB (sub_pos.mpr hz1))
    (div_pos hz0 (mul_pos htransport0 (Real.log_pos (by norm_num))))) _
end CollatzEndpointTransport.FixedTotal
