private theorem localLFactorAt_eq_one_of_hasConductorExponentAt (K : Type) [Field K] [NumberField K]
    (v : HeightOneSpectrum (𝓞 K)) (χ : (v.adicCompletion K)ˣ →* ℂˣ) {a : ℕ} (ha : 1 ≤ a)
    (hχ : TateLocal.HasConductorExponentAt K v χ a) (s : ℂ) : TateLocal.localLFactorAt K v χ s = 1 := by
  refine TateLocal.localLFactorAt_of_not_hasConductorExponentAt_zero (K := K) (v := v) (s := s) (hχ := fun h0 => ?_)
  have h1 := TateLocal.conductorExponentAt_eq_of_hasConductorExponentAt (K := K) (v := v) hχ
  have h2 := TateLocal.conductorExponentAt_eq_of_hasConductorExponentAt (K := K) (v := v) h0
  omega

private theorem prod_localLFactorAt_eq_one {K : Type} [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))
    {n : ℕ} (ν : Fin n → ((v.adicCompletion K)ˣ →* ℂˣ)) (a : Fin n → ℕ)
    (ha : ∀ i, 1 ≤ a i ∧ TateLocal.HasConductorExponentAt K v (ν i) (a i)) (s : ℂ) :
    (∏ i, TateLocal.localLFactorAt K v (ν i) s) = 1 :=
  Finset.prod_eq_one fun i _ =>
    localLFactorAt_eq_one_of_hasConductorExponentAt K v (ν i) (ha i).1 (ha i).2 s

private theorem prod_localLFactorAt_mul_eq_one {K : Type} [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))
    {n : ℕ} (ν : Fin n → ((v.adicCompletion K)ˣ →* ℂˣ)) (a : Fin n → ℕ)
    (ha : ∀ i, 1 ≤ a i ∧ TateLocal.HasConductorExponentAt K v (ν i) (a i))
    (χv : (v.adicCompletion K)ˣ →* ℂˣ) (hχ : TateLocal.HasConductorExponentAt K v χv 0) (s : ℂ) :
    (∏ i, TateLocal.localLFactorAt K v (ν i * χv) s) = 1 :=
  Finset.prod_eq_one fun i _ =>
    localLFactorAt_eq_one_of_hasConductorExponentAt K v (ν i * χv) (ha i).1
      (TateLocal.hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K v (ν i) χv (a i) (ha i).2 hχ) s

end

