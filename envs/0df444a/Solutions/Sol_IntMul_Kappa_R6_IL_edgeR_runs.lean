variable {m : ℕ}

theorem tplE_eval {N : ℕ} (E : Bit.QMat2 m) (h : ∀ i j, Nat.Coprime (E i j).den N) :
    (tplE E).map (fun T => T.eval N) = shiftSteps (Bit.redM N E) := by
  simp only [tplE, shiftSteps, List.map_map]
  refine List.map_congr_left fun i _ => ?_
  simp only [Function.comp_apply]
  rw [rsh_eval i (E i i) (fun j => E i j) (h i i) (fun j _ => h i j)]
  rfl

lemma upd0_G {t : IState HS} {X : List Item} {r : Fin HS} (h : r ≠ 0) :
    (t.upd 0 X).G r = t.G r := by
  simp [IState.upd_G, h]

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The child calls of the runs of an edge. -/
theorem runsR_runs (j0 : Fin Pp) (m : ℕ) (child : ℕ × ℕ × ℕ → List (ZMod 2) → List (ZMod 2))
    (cC : ℕ × ℕ × ℕ → ℕ) (V : ℕ) (t : IState HS) :
    ∀ runs : List (ℕ × ℕ × ℕ),
      (∀ ρ ∈ runs, ∀ (R : List Item) (ys : List (ZMod 2)), ys.length = V →
        IRuns I iprog (callR j0 m ρ) (t.upd 0 (ints (enc2 ys) ++ R))
          (t.upd 0 (ints (enc2 (child ρ ys)) ++ R)) (cC ρ) ∧ (child ρ ys).length = V) →
      ∀ (R : List Item) (ys : List (ZMod 2)), ys.length = V →
        IRuns I iprog (KIL.seqL (runs.map (callR j0 m))) (t.upd 0 (ints (enc2 ys) ++ R))
          (t.upd 0 (ints (enc2 (runs.foldl (fun ys ρ => child ρ ys) ys)) ++ R))
          ((runs.map cC).sum + 1) ∧ (runs.foldl (fun ys ρ => child ρ ys) ys).length = V
  | [], _, R, ys, hys => by
    refine ⟨?_, hys⟩
    have hsk := IRuns.skip (I := I) (iprog := iprog) (t.upd 0 (ints (enc2 ys) ++ R))
    simpa [KIL.seqL] using hsk
  | ρ :: rs, h, R, ys, hys => by
    obtain ⟨h1, hl1⟩ := h ρ List.mem_cons_self R ys hys
    obtain ⟨h2, hl2⟩ := runsR_runs j0 m child cC V t rs (fun ρ' hρ' => h ρ' (List.mem_cons_of_mem _ hρ'))
      R (child ρ ys) hl1
    refine ⟨(h1.seq h2).mono' rfl ?_, hl2⟩
    simp only [List.map_cons, List.sum_cons]; omega

/-- **The edge code computes the implemented edge `realEdge`.** -/
theorem edgeR_runs_sol_aux {N : ℕ} [NeZero N] (j0 : Fin Pp) (A B Cs : Shape) (P L : ℕ)
    (hpos : ∀ a ∈ P :: L :: hdShape A B Cs m N, 1 ≤ a) (e : Bit.Edge m) (Bb : ℕ)
    (hT : ∀ T ∈ tplE e.E₁ ++ tplE e.E₂, TOK T N Bb)
    (hcop : ∀ i j, Nat.Coprime (e.E₁ i j).den N ∧ Nat.Coprime (e.E₂ i j).den N)
    (hV : zsz ((vol (P :: L :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    (child : ℕ × ℕ × ℕ → List (ZMod 2) → List (ZMod 2)) (cC : ℕ × ℕ × ℕ → ℕ)
    (t : IState HS) {LN LQ LX LB LC : List Item} (hNQ : t.G sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rXs = .int ((vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G rVB = .int ((vol B : ℕ) : ℤ) :: LB)
    (hC : t.G rVC = .int ((vol Cs : ℕ) : ℤ) :: LC)
    (hrun : ∀ ρ ∈ e.runs, ∀ (R : List Item) (ys : List (ZMod 2)),
      ys.length = vol (P :: L :: hdShape A B Cs m N) →
      IRuns I iprog (callR j0 m ρ) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child ρ ys)) ++ R)) (cC ρ) ∧
      (child ρ ys).length = vol (P :: L :: hdShape A B Cs m N))
    (R : List Item) (ys : List (ZMod 2)) (hys : ys.length = vol (P :: L :: hdShape A B Cs m N)) :
    IRuns I iprog (edgeR j0 m e) (t.upd 0 (ints (enc2 ys) ++ R))
      (t.upd 0 (ints (enc2 (Bit.realEdge ((hdLayout A B Cs m N).cons2 P L) child e ys)) ++ R))
      (cEdgeR m e (vol (P :: L :: hdShape A B Cs m N)) Bb cC) ∧
    (Bit.realEdge ((hdLayout A B Cs m N).cons2 P L) child e ys).length =
      vol (P :: L :: hdShape A B Cs m N) := by
  set Λ := (hdLayout A B Cs m N).cons2 P L
  set V := vol (P :: L :: hdShape A B Cs m N)
  have regs : ∀ X : List Item, (t.upd 0 X).G sNQ = .int (-(N : ℤ)) :: LN ∧
      (t.upd 0 X).G sQQ = .int (N : ℤ) :: LQ ∧
      (t.upd 0 X).G rXs = .int ((vol (P :: L :: A) : ℕ) : ℤ) :: LX ∧
      (t.upd 0 X).G rVB = .int ((vol B : ℕ) : ℤ) :: LB ∧
      (t.upd 0 X).G rVC = .int ((vol Cs : ℕ) : ℤ) :: LC := fun X =>
    ⟨by rw [upd0_G (by decide)]; exact hNQ, by rw [upd0_G (by decide)]; exact hQQ,
      by rw [upd0_G (by decide)]; exact hX, by rw [upd0_G (by decide)]; exact hB,
      by rw [upd0_G (by decide)]; exact hC⟩
  -- shifts of `E₂`
  obtain ⟨r1, r2, r3, r4, r5⟩ := regs (ints (enc2 ys) ++ R)
  have S1 := stepsU_fspec A B Cs P L rXs ⟨by decide, by decide⟩ hpos 1 Bb R hV hQ2 _ r1 r2 r3 r4 r5
    (tplE e.E₂) (enc2 ys) (fun T hT' => hT T (List.mem_append_right _ hT'))
    (by rw [length_enc2]; exact hys) (bnd_enc2 ys le_rfl) (by simp)
  rw [IState.upd_upd_same, runArr_enc2, tplE_eval e.E₂ (fun i j => (hcop i j).2)] at S1
  set ys1 := runArr Λ 0 (shiftSteps (Bit.redM N e.E₂)) ys with hys1
  have hl1 : ys1.length = V := length_runArr Λ 0 _ hys
  -- the runs
  obtain ⟨H2, hl2⟩ := runsR_runs j0 m child cC V t e.runs hrun R ys1 hl1
  set ys2 := e.runs.foldl (fun ys ρ => child ρ ys) ys1
  -- shifts of `E₁`
  obtain ⟨p1, p2, p3, p4, p5⟩ := regs (ints (enc2 ys2) ++ R)
  have S3 := stepsU_fspec A B Cs P L rXs ⟨by decide, by decide⟩ hpos 1 Bb R hV hQ2 _ p1 p2 p3 p4 p5
    (tplE e.E₁) (enc2 ys2) (fun T hT' => hT T (List.mem_append_left _ hT'))
    (by rw [length_enc2]; exact hl2) (bnd_enc2 ys2 le_rfl) (by simp)
  rw [IState.upd_upd_same, runArr_enc2, tplE_eval e.E₁ (fun i j => (hcop i j).1)] at S3
  refine ⟨((S1.irun (fok_stepsU _ _ _)).seq (H2.seq (S3.irun (fok_stepsU _ _ _)))).mono' rfl le_rfl,
    length_runArr Λ 0 _ hl2⟩

end Edge

end

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.edgeR_runs_sol_aux := @IntMul.Kappa.R6.IL.edgeR_runs_sol_aux
