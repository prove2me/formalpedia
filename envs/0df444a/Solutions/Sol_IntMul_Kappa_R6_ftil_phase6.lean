  refine ⟨h1, h2, fun u => ?_⟩
  rw [h3, ← pow_mul, show 2 * α ^ 2 * (D + 1) = 2 * (D + 1) * α ^ 2 by ring]

theorem w_small6 (p α : ℕ) (s t : Fin (D + 1) → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]
