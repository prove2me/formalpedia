    Set.MapsTo (TypeDensity.projectiveNormalize O n G μ) (TypeDensity.projectiveCell O n G) (TypeDensity.reducedFormCell O n μ G) ∧
    Set.SurjOn (TypeDensity.projectiveNormalize O n G μ) (TypeDensity.projectiveCell O n G) (TypeDensity.reducedFormCell O n μ G) ∧
    (∀ a ∈ TypeDensity.projectiveCell O n G, ∀ a' ∈ TypeDensity.projectiveCell O n G,
      TypeDensity.projectiveNormalize O n G μ a = TypeDensity.projectiveNormalize O n G μ a' ↔
