theorem liftR_comp (ρ τ : Nat → Nat) :
    liftRenaming (fun n => ρ (τ n)) = fun n => liftRenaming ρ (liftRenaming τ n) := by
  funext n; cases n <;> rfl

theorem rename_rename (e : Expr) : ∀ (ρ τ : Nat → Nat),
    rename ρ (rename τ e) = rename (fun n => ρ (τ n)) e := by
  induction e with
  | var n => intro ρ τ; rfl
  | _ => intro ρ τ; simp [rename, liftR_comp, *]

theorem liftS_liftR (σ : Nat → Expr) (ρ : Nat → Nat) :
    (fun n => liftSubstitution σ (liftRenaming ρ n)) = liftSubstitution (fun n => σ (ρ n)) := by
  funext n; cases n <;> rfl

theorem subst_rename (e : Expr) : ∀ (σ : Nat → Expr) (ρ : Nat → Nat),
    substitute σ (rename ρ e) = substitute (fun n => σ (ρ n)) e := by
  induction e with
  | var n => intro σ ρ; rfl
  | _ => intro σ ρ; simp [rename, substitute, ← liftS_liftR, *]

theorem liftR_liftS (σ : Nat → Expr) (ρ : Nat → Nat) :
    (fun n => rename (liftRenaming ρ) (liftSubstitution σ n)) =
      liftSubstitution (fun n => rename ρ (σ n)) := by
  funext n; cases n with
  | zero => rfl
  | succ n => simp only [liftSubstitution, weaken, rename_rename]; rfl

theorem rename_subst (e : Expr) : ∀ (σ : Nat → Expr) (ρ : Nat → Nat),
    rename ρ (substitute σ e) = substitute (fun n => rename ρ (σ n)) e := by
  induction e with
  | var n => intro σ ρ; rfl
  | _ => intro σ ρ; simp [rename, substitute, ← liftR_liftS, *]

theorem liftS_liftS (σ τ : Nat → Expr) :
    (fun n => substitute (liftSubstitution σ) (liftSubstitution τ n)) =
      liftSubstitution (fun n => substitute σ (τ n)) := by
  funext n; cases n with
  | zero => rfl
  | succ n => simp only [liftSubstitution, weaken, rename_subst, subst_rename]

theorem subst_subst (e : Expr) : ∀ (σ τ : Nat → Expr),
    substitute σ (substitute τ e) = substitute (fun n => substitute σ (τ n)) e := by
  induction e with
  | var n => intro σ τ; rfl
  | _ => intro σ τ; simp [substitute, ← liftS_liftS, *]

theorem liftS_var (ρ : Nat → Nat) :
    liftSubstitution (fun n => Expr.var (ρ n)) = fun n => Expr.var (liftRenaming ρ n) := by
  funext n; cases n <;> rfl

theorem rename_eq_subst (e : Expr) : ∀ (ρ : Nat → Nat),
    rename ρ e = substitute (fun n => Expr.var (ρ n)) e := by
  induction e with
  | var n => intro ρ; rfl
  | _ => intro ρ; simp [rename, substitute, liftS_var, *]

theorem weaken_eq_subst (e : Expr) : weaken e = substitute (fun n => Expr.var (n+1)) e :=
  rename_eq_subst e _


theorem tyc {Γ X Y} (h : TypeWf Γ X) (e : X = Y) : TypeWf Γ Y := e ▸ h
theorem tmc {Γ t X Y} (h : TermWf Γ t X) (e : X = Y) : TermWf Γ t Y := e ▸ h

theorem tyA {A} (hA : TypeWf [] A) {Δ} (hΔ : ContextWf Δ) (ρ : Nat → Nat) :
    TypeWf Δ (rename ρ A) := by
  rw [rename_eq_subst]
  exact TypeWf.subst hA (SubstitutionWf.mk ContextWf.nil hΔ (by intro n B h; simp at h))

theorem tvar {Γ B T} (n : Nat) (hΓ : ContextWf Γ) (h : Γ[n]? = some B)
    (e : rename (fun k => k + n + 1) B = T) : TermWf Γ (.var n) T :=
  e ▸ TermWf.var hΓ h

