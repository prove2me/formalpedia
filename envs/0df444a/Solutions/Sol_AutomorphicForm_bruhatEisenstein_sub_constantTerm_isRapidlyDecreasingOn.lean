section Descent

variable {A : Type*} [AddCommGroup A] {ι : Type*}
variable (Θ : A →+ UnitAddTorus ι)

private def IsKerPeriodic (H : A → ℂ) : Prop :=
  ∀ v : A, Θ v = 0 → ∀ x : A, H (x + v) = H x

private def torusLift (hΘ : Surjective Θ) (H : A → ℂ) : UnitAddTorus ι → ℂ :=
  fun θ => H (surjInv hΘ θ)

variable {Θ}

private theorem eq_iff_sub_mem_ker (x y : A) : Θ x = Θ y ↔ Θ (x - y) = 0 := by
  rw [map_sub, sub_eq_zero]

private theorem torusLift_apply (hΘ : Surjective Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (x : A) :
    torusLift Θ hΘ H (Θ x) = H x := by
  unfold torusLift
  have hy : Θ (surjInv hΘ (Θ x)) = Θ x := surjInv_eq _ _
  rw [eq_iff_sub_mem_ker] at hy
  have := hH _ hy x
  rwa [add_sub_cancel] at this

private theorem torusLift_comp (hΘ : Surjective Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) : torusLift Θ hΘ H ∘ Θ = H :=
  funext (torusLift_apply hΘ hH)

variable [TopologicalSpace A]

private theorem continuous_torusLift (hΘ : IsOpenQuotientMap Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (hc : Continuous H) :
    Continuous (torusLift Θ hΘ.surjective H) := by
  rw [← hΘ.continuous_comp_iff, torusLift_comp hΘ.surjective hH]
  exact hc

private def torusLiftCM (hΘ : IsOpenQuotientMap Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (hc : Continuous H) :
    C(UnitAddTorus ι, ℂ) :=
  ⟨torusLift Θ hΘ.surjective H, continuous_torusLift hΘ hH hc⟩

private theorem torusLiftCM_apply (hΘ : IsOpenQuotientMap Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (hc : Continuous H)
    (θ : UnitAddTorus ι) : torusLiftCM hΘ hH hc θ = torusLift Θ hΘ.surjective H θ := rfl

variable [Fintype ι]

end Descent

