theorem aeHit_iff {n : ℕ} {AB BC AC : List ℤ} {q : ℕ} (hq : q < n * n) :
    aeHit n AB BC AC q = true ↔
      ∃ c < n, AB.getD q 0 + BC.getD (q % n * n + c) 0 + AC.getD (q / n * n + c) 0 = 0 := by
  have hq' : q / n * n + q % n = q := Nat.div_add_mod' q n
