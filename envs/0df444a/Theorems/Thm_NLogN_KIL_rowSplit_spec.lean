theorem NLogN.KIL.rowSplit_spec (t : IState HS) (xs : List ℤ) (P W L : ℕ) (rest : Shape) (Bb : ℕ)
    (R L1 L2 L3 L4 : List Item)
    (hlen : xs.length = AModel.vol (P :: W * L :: rest)) (hb : Bnd Bb xs)
    (hB1 : 1 ≤ AModel.vol rest) (hPL : 1 ≤ P * L) (hW : 1 ≤ W)
    (hV : zsz ((1 * (W * (P * L * AModel.vol rest)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int ((1 : ℕ) : ℤ) :: L1)
    (h2 : t.G 2 = .int (W : ℤ) :: L2) (h3 : t.G 3 = .int ((P * L : ℕ) : ℤ) :: L3)
    (h4 : t.G 4 = .int (AModel.vol rest : ℤ) :: L4) :
    bwdP.ok t ∧ bwdP.run t = t.upd 0 (ints ((List.finRange W).flatMap
        (fun w => rowSplit P W L rest w 0 xs)) ++ R) ∧
      bwdP.cost t ≤ cMove 1 W (P * L) (AModel.vol rest) Bb := by sorry
