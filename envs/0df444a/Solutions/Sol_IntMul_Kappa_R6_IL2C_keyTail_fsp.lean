  hV.zl (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast h)
theorem L2M : 2 ^ L ≤ M := by rw [← hV.ql]; exact hV.qlM
theorem RM : 2 ^ G ≤ M := le_trans hV.hRL hV.L2M

