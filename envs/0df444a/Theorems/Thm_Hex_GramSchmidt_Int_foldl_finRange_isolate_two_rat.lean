theorem foldl_finRange_isolate_two_rat :
    ∀ (i : Nat) (j₁ j₂ : Nat) (hj₁ : j₁ < i) (hj₂ : j₂ < i) (_hne : j₁ ≠ j₂)
      (f : Fin i → Rat),
      (∀ q : Fin i, q.val ≠ j₁ → q.val ≠ j₂ → f q = 0) →
      (List.finRange i).foldl (fun acc q => acc + f q) 0 =
        f ⟨j₁, hj₁⟩ + f ⟨j₂, hj₂⟩ := by sorry
