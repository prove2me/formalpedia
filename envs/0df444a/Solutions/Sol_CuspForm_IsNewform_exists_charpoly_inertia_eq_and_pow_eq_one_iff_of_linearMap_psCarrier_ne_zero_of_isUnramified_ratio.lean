theorem CuspForm.PSQ.quadratic_eq_X_sub_C_sq {R : Type} [CommRing R] (e : R) (he : e ^ 2 = 1) :
    X ^ 2 - C (2 * e) * X + C 1 = ((X : R[X]) - C e) ^ 2 := by
  have h1 : C e ^ 2 = (1 : R[X]) := by rw [← map_pow, he, map_one]
  rw [sub_sq, h1, map_mul, map_ofNat, map_one]; ring

