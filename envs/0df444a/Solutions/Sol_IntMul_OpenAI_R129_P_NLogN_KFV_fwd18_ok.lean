/-- **The uniform exponent table**: on a state whose term columns hold `T`, with `Q`, `N`, `|T|`
on top of `tbQ`, `tbN`, `tbM` and the work registers free, `tabU` pushes the table of `tabP`. -/
theorem tabU_fsp (s : IState HS) (f : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) {Q N U : ℕ}
    {LQ LN LM : List Item}
    (hsQ : (NLogN.KIL.encK s f).G tbQ = .int (Q : ℤ) :: LQ) (hsN : (NLogN.KIL.encK s f).G tbN = .int (N : ℤ) :: LN)
    (hsM : (NLogN.KIL.encK s f).G tbM = .int (T.length : ℤ) :: LM)
    (hC : f tbC = T.map fun t => (t.1 : ℤ)) (hK : f tbK = T.map fun t => (t.2.1 : ℤ))
    (hL : f tbL = T.map fun t => (t.2.2 : ℤ)) (hW : ∀ x ∈ tbWork, f x = [])
    (hQ : 0 < Q) (hNU : N + 1 ≤ U) (h2U : 2 ≤ U) (hQU : Q ≤ U) (hmU : T.length ≤ U)
    (hT : ∀ t ∈ T, t.1 + Q ≤ U ∧ 2 ^ t.2.1 ≤ U ∧ 2 ^ t.2.2 ≤ U) :
    FSp NLogN.KFV.tabU (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 14 ((List.range N).map (svv Q T) ++ f 14)))
      (cTabU N T.length (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have zU : ∀ x : ℕ, x ≤ U → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zB (by simpa using hx)
  have w : ∀ x ∈ tbWork, f x = [] := hW
  simp only [tbWork, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at w
  obtain ⟨wC2, wK2, wL2, wA, wT, wI, wV, wJ, wR⟩ := w
  set Lt := (List.range N).map (svv Q T) with hLt
  have hLlen : Lt.length = N := by simp [Lt]
  have tN := IState.top_eq hsN
  -- push the record counter
  have p1 := Sp.push s f (i := tbJ) (e := .reg tbN) (B := B) (by decide) (clean_reg (by decide))
    (IState.isInt_of hsN) trivial (by simp only [Ex.Bnd, tN]; exact zU _ (by omega))
  rw [show Ex.eval (NLogN.KIL.encK s f) (.reg tbN) :: f tbJ = [(N : ℤ)] by simp [Ex.eval, tN, wJ]] at p1
  set f1 := Function.update f tbJ [(N : ℤ)]
  let F : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update f 14 (Lt.drop (N - k) ++ f 14)) tbJ [(N : ℤ) - k]
  have F0 : F 0 = f1 := by
    funext x
    simp only [F, f1, Function.update_apply, Nat.sub_zero, List.drop_eq_nil_of_le hLlen.le,
      List.nil_append, CharP.cast_eq_zero, sub_zero]
    split_ifs with e1 e2 <;> (try subst e1) <;> (try subst e2) <;> simp_all
  have hG : ∀ k (x : Fin HS), x ≠ 14 → x ≠ tbJ → F k x = f x := fun k x h1 h2 => by
    simp [F, Function.update_apply, h1, h2]
  have hN0 : (NLogN.KIL.encK s (F 0)).G tbN = .int (N : ℤ) :: LN := by
    rw [encK_G] at hsN ⊢; rw [hG 0 tbN (by decide) (by decide)]; exact hsN
  have L := FSp.rep (C := tbR) (n := .reg tbN) (b := NLogN.KFV.recB) (s := s) (F := F) (N := N)
    (c := cRecB T.length B) (by decide) (fun k => by rw [hG k tbR (by decide) (by decide)]; exact wR)
    (by decide) (clean_reg (by decide)) (IState.isInt_of hN0)
    (by simp only [Ex.eval]; rw [IState.top_eq hN0])
    (by
      intro k hk
      set j := N - k - 1 with hjdef
      set h := Function.update (F k) tbR [(N : ℤ) - k]
      have hh : ∀ x : Fin HS, x ≠ 14 → x ≠ tbJ → x ≠ tbR → h x = f x := fun x a b c => by
        simp [h, Function.update_apply, c, hG k x a b]
      have hsG : ∀ x : Fin HS, x ≠ 14 → x ≠ tbJ → x ≠ tbR → (NLogN.KIL.encK s h).G x = (NLogN.KIL.encK s f).G x :=
        fun x a b c => by rw [encK_G, encK_G, hh x a b c]
      have R := recB_fsp s h T (j := j) (U := U) (hsG tbQ (by decide) (by decide) (by decide) ▸ hsQ)
        (hsG tbM (by decide) (by decide) (by decide) ▸ hsM)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact hC)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact hK)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact hL)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wC2)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wK2)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wL2)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wA)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wT)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wI)
        (by rw [hh _ (by decide) (by decide) (by decide)]; exact wV)
        (by simp only [h, F]; simp +decide; rw [hjdef]; push_cast [Nat.sub_sub, show k + 1 ≤ N by omega]; ring)
        hQ (by omega) h2U hQU hmU hT
      refine R.congr ?_
      congr 1
      funext x
      by_cases x14 : x = 14
      · subst x14
        have hd : Lt.drop (N - (k + 1)) = Lt[j]'(by omega) :: Lt.drop (N - k) := by
          rw [show N - (k + 1) = j by omega, List.drop_eq_getElem_cons (by omega)]
          congr 2; omega
        simp +decide [h, F, hd, Lt]
      by_cases xJ : x = tbJ
      · subst xJ; simp +decide [F]; rw [hjdef]; push_cast [Nat.sub_sub, show k + 1 ≤ N by omega]; ring
      by_cases xR : x = tbR
      · subst xR; simp +decide [h, F]
      simp [h, F, Function.update_apply, x14, xJ, xR])
  rw [F0] at L
  set f2 := F N
  have f2J : f2 tbJ = [(N : ℤ) - N] := by simp [f2, F]
  have o1 := Sp.pop s f2 (i := tbJ) (a := (N : ℤ) - N) (l := []) (B := B) (by decide) f2J
    (NLogN.KFV.zB (by simp))
  refine ((FSp.of_norep rfl p1).seq (L.seq (FSp.of_norep rfl o1))).mono ?_ |>.congr ?_
  · have hB : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    have hcr := cost_reg_le (NLogN.KIL.encK s f1) tbN
    rw [show (NLogN.KIL.encK s f1).top tbN = (N : ℤ) by rw [← F0]; exact IState.top_eq hN0] at hcr
    have hzN : zsz (N : ℤ) ≤ B := zU _ (by omega)
    set A := (T.length + 1) * (B + 2) ^ 2 with hA
    have hm : N * cRecB T.length B = 5 * 10 ^ 8 * (N * A) := by unfold cRecB; rw [hA]; ring
    have hBA : B + 2 ≤ A := le_trans hB (Nat.le_mul_of_pos_left _ (by omega))
    have hNA : N ≤ N * A := Nat.le_mul_of_pos_right _ (by omega)
    have hR : 10 ^ 9 * (N + 1) * (T.length + 1) * (B + 2) ^ 2 = 10 ^ 9 * (N * A) + 10 ^ 9 * A := by
      rw [hA]; ring
    simp only [Ex.size, cTabU, cRep]
    rw [hR, hm]
    omega
  · congr 1; funext x
    simp only [f2, F, Function.update_apply, Nat.sub_self, List.drop_zero]
    by_cases e1 : x = tbJ
    · subst e1; simp +decide [wJ]
    simp [e1]

theorem fok_tabU : NLogN.KFD.fok NLogN.KFV.tabU = true := by
  simp only [NLogN.KFV.tabU, NLogN.KFV.recB, NLogN.KFD.fok, fok_mvK_eq]
  decide

end NLogN.KFV

end

