lemma aplus_sum (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
    (N : ℕ) : ∑ h ∈ range N, |aplus α σ b h| ≤ 1.05 :=
  (sum_le_sum fun h _ => aplus_abs hα hσ hb h).trans (env_sum hα hx N)

lemma aminus_sum (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
    (N : ℕ) : ∑ h ∈ range N, |aminus α σ b h| ≤ 1.05 :=
  (sum_le_sum fun h _ => aminus_abs hα hσ hb h).trans (env_sum hα hx N)

/-- Row sums of the lower Toeplitz factor. -/
lemma lw_rowsum (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
