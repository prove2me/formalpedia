variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

theorem signed_grid_value (D e n : ℕ) (hD : D ≠ 0) (P : Prop) [Decidable P] :
    ((n : K)/D + e) * (if P then -1 else 1) =
      ((if P then -((D*e+n : ℕ) : ℤ) else ((D*e+n : ℕ) : ℤ) : ℤ) : K) / D := by sorry
