variable {d : ℕ}

theorem IntMul.OpenAI.RF.pipeline_exact (s t : Fin d → ℕ) [∀ i, NeZero (s i)]
    (hcop : ∀ i, Nat.Coprime (s i) (t i)) (b : ℕ) (ubar vbar : ((i : Fin d) → ZMod (s i)) → ℂ) :
    let S : ℂ := ∏ i, (s i : ℂ)
    let u := fun k => (2 : ℂ)⁻¹ ^ (b + 2) * ubar k
    let v := fun k => (2 : ℂ)⁻¹ ^ (b + 2) * vbar k
    (fun j => (2 : ℂ) ^ (2 * b + 4) * S * (S * Rperm s t (dftP s (fun k =>
        Rperm s t (dftM s u) k * Rperm s t (dftM s v) k)) j)) = cconv s ubar vbar := by sorry
