/-- **Swapping the state exchanges the two arguments of the cross-party deviation.** -/
theorem xSqNorm_swapVec (ψ : dA × dB → ℂ) (X : Matrix dB dB ℂ) (Y : Matrix dA dA ℂ) :
    xSqNorm (swapVec ψ) X Y = xSqNorm ψ Y X := by
