  obtain ⟨d, -, hv⟩ := hv
  exact InR_shT _ hQ v hv

theorem length_stg (a c : ℕ) (T : List ℤ) : (stg Q a c T).length = a * T.length := by
  rw [stg, length_fm_const _ _ T.length (fun d _ => by simp [shT])]; simp

theorem gStage_sp (K : KS) (T W : List ℤ) (a c : ℕ) (hc : c < Q) (hT : InR Q T)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) (ha : zsz (a : ℤ) ≤ Bb)
    (haM : zsz ((a * T.length : ℕ) : ℤ) ≤ Bb) :
    Sp (gStage Q a c T.length)
      (encK s (toF {K with w := T ++ W, a := [], c := [], k0 := [], k1 := []}))
      (encK s (toF {K with w := stg Q a c T ++ W, a := [], c := [], k0 := [], k1 := []}))
      (cStage a T.length Bb) := by
  have hQ0 : 0 < Q := by omega
  set K0 : KS := {K with w := T ++ W, a := [], c := [], k0 := [], k1 := []}
  have L1 := Sp.push s (toF K0) (i := 12) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial
    trivial (by simp [Ex.Bnd, zsz_zero])
  rw [upd_o] at L1
  have L2 := gOuter_sp s K T W K.o a c hc hT hQ hM ha
  have h0 : 0 ≤ ((c : ℤ) * a) % Q := Int.emod_nonneg _ (by omega)
  have h1 : ((c : ℤ) * a) % Q < Q := Int.emod_lt_of_pos _ (by omega)
  set K2 : KS := {K with w := T ++ W, a := [], c := (stg Q a c T).reverse, o := (((c : ℤ) * a) % Q) :: K.o, k0 := [], k1 := []}
  have L3 := Sp.pop (i := 12) s (toF K2) (a := ((c : ℤ) * a) % Q) (l := K.o) (B := Bb) (by decide)
    rfl (zsz_lt_Q h0 h1 hQ)
  rw [upd_o] at L3
  have L4 := popL_sp s {K2 with o := K.o} T W (bnd_InR hT hQ) hM
  set K4 : KS := {K2 with o := K.o, w := W, k1 := []}
  have L5 := Sp.mvK (X := 11) (Y := 14) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF K4) (.lit ((a * T.length : ℕ) : ℤ)) (clean_lit _) trivial
    (stg Q a c T).reverse [] (by simp [K4, K2]) (by simp [Ex.eval, length_stg]) Bb
    (bnd_reverse (bnd_InR (InR_stg a c T hQ0) hQ)) trivial haM
  rw [upd_c, upd_w, List.reverse_reverse] at L5
  refine (L1.seq (L2.seq (L3.seq (L4.seq L5)))).mono ?_
  simp only [cStage, Ex.size, List.length_reverse, length_stg]
  omega

end Proofs

/-! ## Stack form -/

theorem toF_empty : toF ({} : KS) = fun _ => [] := by
  funext j; fin_cases j <;> rfl

theorem encK_empty (s : IState HS) : encK s (toF ({} : KS)) = s := by
  rw [toF_empty, encK_nil]

theorem encK_w (s : IState HS) (L : List ℤ) :
    encK s (toF ({ w := L } : KS)) = s.upd 14 (ints L ++ s.G 14) := by
  rw [show ({ w := L } : KS) = { ({} : KS) with w := L } from rfl, ← upd_w, ← encK_upd,
    encK_empty]

/-! ## Denotation of the table -/

end NLogN.KIL

