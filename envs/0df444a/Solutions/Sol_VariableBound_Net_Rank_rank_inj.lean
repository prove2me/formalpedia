open VariableBound VariableBound.Net
open Groundwork Groundwork.Prog
open VariableBound.Net.Rank
namespace VariableBound.Net.Rank
theorem _root_.solution (x x' : List Bool) (hl : x.length = x'.length) (hc : x.count true = x'.count true) (hr : rank x = rank x') : x = x' := by
  induction x generalizing x' with
  | nil => exact (List.eq_nil_of_length_eq_zero hl.symm).symm
  | cons b x ih =>
    cases x' with
    | nil => simp at hl
    | cons b' x' =>
      have hl' : x.length = x'.length := by simpa using hl
      have h1 := rank_lt x
      have h2 := rank_lt x'
      cases b <;> cases b' <;> simp only [rank, cond_false, cond_true, zero_add, List.count_cons_self, count_false_cons] at hc hr
      · rw [ih x' hl' hc hr]
      · -- x' begins with 1 and x with 0: the position of x' is at least C(t − 1, μ), that of x is below it
        rw [hl', hc] at h1
        omega
      · rw [← hl', ← hc] at h2
        omega
      · have hc' : x.count true = x'.count true := by omega
        rw [hl', hc'] at hr
        rw [ih x' hl' hc' (by omega)]
end VariableBound.Net.Rank
