-- Source module: Solutions.KFV7Need
/-!
# KFV §11: the shape of the uniform Proposition 14 that Prop 18 (KFV) needs

Uniform conventions (`UNIFORM.md`): one fixed procedure `e14` in the table; every
`n`-dependent parameter is run-time data on a descriptor stack `dS14`.

**`desc14 P K D S ρ r p w Z`** is the descriptor `[P, K, D, S, ρ, r, p, w, Z]` (the layer shape
`layerShape P K D S`, the root exponent `ρ < K`, the record length `r`, the scale `p`, the
input width `w`, the counter size `Z`).

**`P14Need Isym tbl e14 dS14 A C₀`**: for every parameter set satisfying the side conditions of
`KFM.prop14Ph_kTable` and `KFM.round_cost_closed`, a call of `e14` with `desc14` on `dS14` and
the array on stack `0`

* computes `prop14Proc … (tens Cm)` exactly as `P14Run` (`KFV4Lay`) does (same `RecRep`,
  `GB (p+1)`, and the `√2·2^{-p}` distance to `layerH`);
* leaves every other stack unchanged (the descriptor stays on `dS14`);
* needs empty only stacks `1 … 49` and `55 … 62` (other than `dS14`); stacks `50 … 54` and `63`
  hold the caller's (KFV's) data and are **arbitrary and preserved**;
* costs `≤ C₀ · vol · r · (w + 1) · D^{1 - 2^{-54}}` (the closed bound of
  `KFM.round_cost_closed`; any per-call descriptor overhead is absorbed using
  `2 (2Z+4)^3 + 2 ≤ r`).

`p14Run_of_need` checks that this is enough for KFV: on states whose free stacks are empty it
gives a `P14Run` (the hypothesis of `layerOK_p14`) with a constant code, after the descriptor is in
place.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KFC KFT KFU KFB KFH KFD KIL AModel Butterfly

/-- The descriptor of a uniform Proposition 14 call. -/
def desc14 (P K D S ρ r p w Z : ℕ) : List ℤ :=
  [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ), (Z : ℤ)]

/-- The stacks a uniform Proposition 14 call may require to be empty (all but `0`, the
descriptor stack, and KFV's live stacks `50 … 54`, `63`). -/
def p14Free (dS14 j : Fin HS) : Prop :=
  j ≠ 0 ∧ j ≠ dS14 ∧ (j.val < 50 ∨ (55 ≤ j.val ∧ j.val ≤ 62))

/-- **The uniform Proposition 14 KFV needs** (to be supplied by the KFW worker as `P14U`). -/
def P14Need {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (e14 : Fin Pp)
    (dS14 : Fin HS) (A : ℕ) (C₀ : ℝ) : Prop :=
  ∀ {K r Z P D S ρ p w : ℕ} (hρ : ρ < K),
    6 ≤ K → 1 ≤ r → 80 * Z * (Z + 2) ≤ 2 ^ K → 1 ≤ S → 1 ≤ P → 1 ≤ D →
    zsz ((32 * (vol (layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z → zsz (p : ℤ) ≤ Z →
    (K : ℝ) ≤ 2 * (D : ℝ) ^ ((2 : ℝ)⁻¹ ^ 56) → KFM.EwB A D ≤ w + 1 → w + KFM.EwB A D + 2 < 2 ^ Z →
    2 * (2 * Z + 4) ^ 3 + 2 ≤ r → (K * D + P + 10) * (Z + 2) ≤ vol (layerShape P K D S) * r →
    ∀ (st : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
      (xs : List (Fin r → ℂ)), RecRep r p zs xs →
      xs.length = vol (layerShape P K D S) → f 0 = gflat zs ++ l →
      f dS14 = desc14 P K D S ρ r p w Z → (∀ j, p14Free dS14 j → f j = []) →
      NLogN.KFB.GB w zs → (∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) →
      ∃ (zs' : List GI) (c : ℕ),
        RecRep r p zs' (prop14Proc (P := P) (S := S) hρ p (Butterfly.tens Cm : Butterfly.Op (Fin D)) xs) ∧
        NLogN.KFB.GB (p + 1) zs' ∧
        (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p (Butterfly.tens Cm : Butterfly.Op (Fin D)) xs).length)
          (h' : j < (layerH P K D S ρ hρ xs).length), ∀ c,
          ‖(prop14Proc (P := P) (S := S) hρ p (Butterfly.tens Cm : Butterfly.Op (Fin D)) xs)[j] c -
            (layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
        IRuns Isym tbl (.call e14) (NLogN.KIL.encK st f) (NLogN.KIL.encK st (Function.update f 0 (gflat zs' ++ l))) c ∧
        (c : ℝ) ≤ C₀ * ((vol (layerShape P K D S) * r : ℕ) : ℝ) * (w + 1) *
          (D : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 54)

end NLogN.KFV

end

section
-- Source module: Solutions.KFV9Gen
/-!
# KFV §13: generalized literal substitution and the write analysis

* `wl c` (stacks written, calls ignored) and `nc c` (no calls): `NW_of` gives `NW π c` when no
  parameter stack is written. `wl_ecode`: compiled expressions write only the scratch `56…63`;
  `wl_fcode`: compiled register programs write `p.writes`, the scratch, and the `toUL` stacks.
* `EG π e e'`: `e'` is `e` with literals `v` replaced by any clean expression over the parameters
  that evaluates to `v` at cost `≤ 2000 (zsz v + 2)` (e.g. `2r = r + r`, `-K`, `B / 2`).
  `GSim` is the register-program version. **`ISim.fcodeG`**: `GSim π p p'` gives
  `ISim π (fcode p) (fcode p')`. **`ISim.pushE`**: a literal push `const j v` on any stack
  `j ≠ 56` may be replaced by `e.code; mv 56 j`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Write analysis -/

def allHi (L : List (Fin HS)) : Bool := L.all fun j => decide (56 ≤ j.val)

def gW (W : List (Fin HS)) (i : Fin HS) : Bool :=
  decide (i ∈ W) || decide (56 ≤ i.val) || decide (i.val = 26 ∨ i.val = 27 ∨ i.val = 28 ∨ i.val = 29)

/-- The `toUL` scratch. -/
def ulS (i : Fin HS) : Prop := i.val = 26 ∨ i.val = 27 ∨ i.val = 28 ∨ i.val = 29

/-! ## Generalized substitution -/

/-- `e'` evaluates to `v` at a cost comparable to the literal. -/
def LitOK (π : PMap) (v : ℤ) (e' : Ex HS) : Prop :=
  e'.Clean ∧ ∀ s : IState HS, PV π s → e'.ok s ∧ e'.eval s = v ∧
    e'.cost s + (2 * moveCost (zsz v) + 19) ≤ 2000 * (zsz v + 2)

/-- `e'` is `e` with some literals replaced by expressions over the parameters. -/
inductive EG (π : PMap) : Ex HS → Ex HS → Prop
  | refl (e : Ex HS) : EG π e e
  | lit {v : ℤ} {e' : Ex HS} : LitOK π v e' → EG π (.lit v) e'
  | add {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.add a b) (.add a' b')
  | neg {a a' : Ex HS} : EG π a a' → EG π (.neg a) (.neg a')
  | mul {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.mul a b) (.mul a' b')
  | shl {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.shl a b) (.shl a' b')
  | quo {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.quo a b) (.quo a' b')
  | rem {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.rem a b) (.rem a' b')
  | pow2 {a a' : Ex HS} : EG π a a' → EG π (.pow2 a) (.pow2 a')
  | sel {c c' a a' b b' : Ex HS} : EG π c c' → EG π a a' → EG π b b' →
      EG π (.sel c a b) (.sel c' a' b')
  | ndiv {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.ndiv a b) (.ndiv a' b')
  | nmod {a a' b b' : Ex HS} : EG π a a' → EG π b b' → EG π (.nmod a b) (.nmod a' b')

/-- Register programs with generalized literal substitution. -/
inductive GSim (π : PMap) : RS → RS → Prop
  | skip : GSim π .skip .skip
  | asg (i : Fin HS) {e e' : Ex HS} : EG π e e' → GSim π (.asg i e) (.asg i e')
  | push (i : Fin HS) {e e' : Ex HS} : EG π e e' → GSim π (.push i e) (.push i e')
  | pop (i : Fin HS) : GSim π (.pop i) (.pop i)
  | seq {a a' b b' : RS} : GSim π a a' → GSim π b b' → GSim π (.seq a b) (.seq a' b')
  | ite {c c' : Ex HS} {a a' b b' : RS} : EG π c c' → GSim π a a' → GSim π b b' →
      GSim π (.ite c a b) (.ite c' a' b')
  | rep (i : Fin HS) {n n' : Ex HS} {b b' : RS} : EG π n n' → GSim π b b' →
      GSim π (.rep i n b) (.rep i n' b')

/-- Push the value of an expression on any stack `j ≠ 56`. -/
def pushE (e : Ex HS) (j : Fin HS) : IStmt HS Pp := .seq (e.code NLogN.zX) (.op (.mv 56 j))

end NLogN.KFV

end

