-- title:
--   The protected adiabatic path of Theorem 3.5 (construction record)
-- statement:
--   A **protected adiabatic path** for an $n$-qubit computation (§1.4 and (3.44)) consists of:
--
--   1. a stabilizer code $C$ on $b$ qubits with encoder $V$ and $k\ge1$, and a Pauli decoder $\{R_s\}$ with $R_0=I$;
--   2. a number $N$ of code blocks, a penalty strength $J>0$ and a duration $T'>0$;
--   3. two time-independent logical Hamiltonians $K_0=\sum_AK_{0,A}$ and $K_1=\sum_AK_{1,A}$ on the $Nk$ logical qubits, with Hermitian terms, such that $|0\cdots0\rangle$ is a ground state of $K_0$;
--   4. an injection of the $n$ circuit qubits into the logical qubits (the output qubits).
--
--   From these data the logical path is $K(t)=(1-t/T')K_0+(t/T')K_1$ (p. 9), the physical path is
--   $$H(t)=\sum_{i=1}^NH_0^{(i)}+\hat K(t),\qquad \hat K(t)=W^{\otimes N}\big(K(t)\otimes I_S\big)(W^{\otimes N})^\dagger\qquad(3.44),$$
--   and its interaction terms are the penalties $J(I-P_a^{(i)})$ for every block and generator together with the dressed terms $\hat K_{0,A}$ and $\hat K_{1,A}$ (3.48). The number of physical qubits is $Nb$. The noisy evolution is generated by $\mathcal L_\beta(t)$ of (1.30)/(3.3) along $H(t)$; the initial state is the thermal encoding $\mathrm{Enc}_{\beta'}^{\otimes N}(|0\cdots0\rangle\langle0\cdots0|)$ (1.31) or the code-space encoding of $|0\cdots0\rangle$; the output of a final state $\rho$ is obtained by decoding block-wise with $\mathrm{Dec}^{\otimes N}$ and tracing out every logical qubit except the output qubits (p. 11).
--
--   This is the object that the goal theorem asserts to exist.
--
--   **Formalization Note** The record holds only data and structural validity. The Hamiltonian, the terms, the encodings, the decoder and the generator are computed from the data, so the decoder cannot output the answer and the initial state cannot be chosen freely; no field states an error, rarity or barrier bound.
-- source:
--   Arsalan Motamedi, Peter Love, Fault Tolerant Adiabatic Quantum Computation from Passive Error Correcting Codes, STOC 2027 submission #1144 (October 2026), source.pdf SHA-256 96d4a748a9114e6a9ed0c5252e84434a63b2a1ef07b286134f01f6761c2503b8, §1.4 (pp. 8–9, (1.28)–(1.31), third bullet on p. 9), §3.1 (3.1), proof of Theorem 3.5 (3.41)–(3.44), (3.48) (pp. 25–26)

import Mathlib
import Definitions.Def_PassiveAdiabaticFT_Thermal_Blocks

/-!
# The protected adiabatic path of Theorem 3.5 (construction record)

Arsalan Motamedi, Peter Love, *Fault Tolerant Adiabatic Quantum Computation from Passive Error
Correcting Codes*, STOC 2027 submission #1144 (October 2026): the construction of §1.4 (pp. 8–9,
(1.28)–(1.31) and the third bullet on p. 9), §3.1 (3.1), and the proof of Theorem 3.5,
(3.41)–(3.44), (3.48) (pp. 25–26).

The record holds data and structural validity only: a stabilizer code with encoder, a Pauli
decoder with `R_0 = I`, a number `N` of blocks, a penalty `J > 0`, a duration `T' > 0`, the two
time-independent logical Hamiltonians `K_0 = Σ_A K_{0,A}`, `K_1 = Σ_A K_{1,A}` (Hermitian terms)
with `|0…0⟩` a ground state of `K_0`, and the logical qubits that carry the circuit's `n` output
qubits. The physical Hamiltonian, its terms, the noisy generator, the encodings and the decoder
are all computed from these data.
-/

set_option backward.isDefEq.respectTransparency.types false

noncomputable section

open scoped Matrix

namespace PassiveAdiabaticFT.Thermal

/-- A protected adiabatic path for an `n`-qubit computation (§1.4, (3.44)). -/
structure Construction (n : ℕ) where
  b : ℕ
  code : StabCode b
  dec : PauliDecoder code
  N : ℕ
  J : ℝ
  J_pos : 0 < J
  T' : ℝ
  T'_pos : 0 < T'
  r0 : ℕ
  r1 : ℕ
  K0 : Fin r0 → Op (Fin N × Fin code.k)
  K1 : Fin r1 → Op (Fin N × Fin code.k)
  K0_herm : ∀ A, (K0 A)ᴴ = K0 A
  K1_herm : ∀ A, (K1 A)ᴴ = K1 A
  ground : IsGroundState (∑ A, K0 A) ketZero
  out : Fin n ↪ Fin N × Fin code.k

namespace Construction

variable {n : ℕ} (X : Construction n)

/-- The logical adiabatic path `K(t) = (1 − t/T') K_0 + (t/T') K_1` (p. 9). -/
def Kpath (t : ℝ) : Op (Fin X.N × Fin X.code.k) :=
  (((1 - t / X.T' : ℝ)) : ℂ) • ∑ A, X.K0 A + (((t / X.T' : ℝ)) : ℂ) • ∑ A, X.K1 A

/-- The physical Hamiltonian path (3.44): `H(t) = Σ_i H_0^{(i)} + K̂(t)`. -/
def H (t : ℝ) : Op (Fin X.N × Fin X.b) := X.dec.Hphys X.N X.J (X.Kpath t)

/-- The interaction terms of the physical path: the penalties `J (I − P_a^{(i)})` for every block
`i` and generator `a`, and the dressed terms `K̂_{0,A}`, `K̂_{1,A}` (3.48); `H(t)` is
`Σ penalties + (1 − t/T') Σ_A K̂_{0,A} + (t/T') Σ_A K̂_{1,A}`. -/
def term : (Fin X.N × Fin X.code.m) ⊕ (Fin X.r0 ⊕ Fin X.r1) → Op (Fin X.N × Fin X.b)
  | Sum.inl ia => onBlock ia.1 ((X.J : ℂ) • (1 - X.code.P ia.2))
  | Sum.inr (Sum.inl A) => X.dec.dressedN X.N (X.K0 A)
  | Sum.inr (Sum.inr A) => X.dec.dressedN X.N (X.K1 A)

/-- The number of physical qubits, `N b`. -/
def numQubits : ℕ := X.N * X.b

/-- The noisy generator `L_β(t)` of (1.30)/(3.3) along the path, for rates `γ_α^{(i)}(ω)` and
Lamb coefficients `κ_α^{(i)}(ω)` of all physical single-qubit Paulis. -/
def gen (γr κr : Fin X.N × (Fin X.b × Fin 3) → ℝ → ℝ) (t : ℝ)
    (ρ : Op (Fin X.N × Fin X.b)) : Op (Fin X.N × Fin X.b) :=
  X.dec.noisyGen X.N X.J γr κr (X.Kpath t) ρ

/-- The thermally encoded initial state `Enc_{β'}^{⊗N}(|0…0⟩⟨0…0|)` (1.31). -/
def initTh (β' : ℝ) : Op (Fin X.N × Fin X.b) := X.dec.encThN X.N X.J β' ketbraZero

/-- The code-space (ground-space) initial state `Enc^{⊗N}(|0…0⟩⟨0…0|)`. -/
def initCode : Op (Fin X.N × Fin X.b) := X.code.encCodeN X.N ketbraZero

/-- The computation's output from a final physical state: decode block-wise with
`Dec^{⊗N}`, then trace out all logical qubits except the `n` output qubits (p. 11). -/
def output (ρ : Op (Fin X.N × Fin X.b)) : Op (Fin n) :=
  reduceTo X.out (X.dec.decN X.N ρ)

end Construction

end PassiveAdiabaticFT.Thermal


