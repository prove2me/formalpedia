theorem red_surjOn_torsion (O : ValuationSubring (AlgebraicClosure ℚ)) (ℓ : ℕ) [Fact ℓ.Prime] (hO : O.LiesOverPrime ℓ)
    (𝒜 : FakeEllipticCurve Λ N ↥O) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gE : E.A ⟶ 𝒜.A) (hgE : CategoryTheory.IsPullback gE E.f 𝒜.f (Spec.map (CommRingCat.ofHom O.subtype)))
    (hgE_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P Q : SchemeHomOver t' E.f),
      (E.L.mul t' P Q).1 ≫ gE =
        (𝒜.L.mul (t' ≫ Spec.map (CommRingCat.ofHom O.subtype))
          ⟨P.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, Q.2]⟩).1)
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))
    (hgbar_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O))) (P Q : SchemeHomOver t' Abar.f),
      (Abar.L.mul t' P Q).1 ≫ gbar =
        (𝒜.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)))
          ⟨P.1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, Q.2]⟩).1)

    [IsFinite (𝒜.L.schemeNsmul ℓ)] [Flat (𝒜.L.schemeNsmul ℓ)] [LocallyOfFinitePresentation (𝒜.L.schemeNsmul ℓ)]
    (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O)))) Abar.f)
    (hP : nsmulPt Abar.L (𝟙 _) ℓ P = Abar.L.one (𝟙 _)) :
    ∃ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f,
      nsmulPt E.L (𝟙 _) ℓ x = E.L.one (𝟙 _) ∧ red O 𝒜 E Abar gE hgE gbar hgbar x = P := by

  set Φ : 𝒜.A ⟶ 𝒜.A := 𝒜.L.schemeNsmul ℓ with hΦdef
  have hΦ : Φ ≫ 𝒜.f = 𝒜.f := 𝒜.L.schemeNsmul_over ℓ
  have hmapΦ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (Q : SchemeHomOver t 𝒜.f),
      mapPt Φ hΦ Q = nsmulPt 𝒜.L t ℓ Q := fun t Q =>
    Subtype.ext (nsmulPt_coe_eq_comp_schemeNsmul 𝒜.L t ℓ Q).symm
  obtain ⟨Kk, ι, -, hιfin, hιflat, -, hιpts, -⟩ := exists_kernel_of_isFinite_of_flat 𝒜 𝒜 Φ hΦ
  haveI := hιfin
  haveI := hιflat

  have hPtors : mapPt Φ hΦ (gPt (IsLocalRing.residue ↥O) 𝒜 Abar gbar hgbar (𝟙 _) P) = 𝒜.L.one _ := by
    rw [hmapΦ, ← gPt_nsmulPt (IsLocalRing.residue ↥O) 𝒜 Abar gbar hgbar hgbar_mul, hP,
      gPt_one (IsLocalRing.residue ↥O) 𝒜 Abar gbar hgbar hgbar_mul]
  obtain ⟨z₀, hz₀⟩ := (hιpts _ _).mpr hPtors
  have hz₀' : z₀ ≫ ι ≫ 𝒜.f = Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) := by
    rw [← Category.assoc, hz₀]
    show (P.1 ≫ gbar) ≫ 𝒜.f = _
    rw [Category.assoc, hgbar.w, ← Category.assoc, P.2, Category.id_comp]

  obtain ⟨z, hz1, hz2⟩ := AlgebraicGeometry.exists_section_comp_eq_of_finite_flat_valuationSubring O (ι ≫ 𝒜.f) z₀ hz₀'
  let xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f := ⟨z ≫ ι, by rw [Category.assoc, hz1]⟩
  have hxt_tors : nsmulPt 𝒜.L (𝟙 _) ℓ xt = 𝒜.L.one _ := by
    rw [← hmapΦ]
    exact (hιpts _ xt).mp ⟨z, rfl⟩

  have w : (Spec.map (CommRingCat.ofHom O.subtype) ≫ xt.1) ≫ 𝒜.f =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom O.subtype) := by
    rw [Category.assoc, xt.2, Category.comp_id, Category.id_comp]
  let x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f := ⟨hgE.lift _ _ w, hgE.lift_snd _ _ w⟩
  have hxlift : xt = lift O 𝒜 E gE hgE x := lift_unique O 𝒜 E gE hgE x xt (hgE.lift_fst _ _ w).symm
  refine ⟨x, ?_, ?_⟩
  ·
    have hlift_one : lift O 𝒜 E gE hgE (E.L.one (𝟙 _)) = 𝒜.L.one (𝟙 _) := by
      symm; apply lift_unique
      have h1 := congrArg Subtype.val (gPt_one O.subtype 𝒜 E gE hgE hgE_mul (𝟙 _))
      have h2 := congrArg Subtype.val (𝒜.L.one_natural (𝟙 _) (𝟙 _ ≫ Spec.map (CommRingCat.ofHom O.subtype))
        (Spec.map (CommRingCat.ofHom O.subtype)) (by rw [Category.comp_id, Category.id_comp]))
      exact h2.trans h1.symm
    have hlift_nsmul : ∀ (n : ℕ) (y : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f),
        lift O 𝒜 E gE hgE (nsmulPt E.L (𝟙 _) n y) = nsmulPt 𝒜.L (𝟙 _) n (lift O 𝒜 E gE hgE y) := by
      intro n y
      induction n with
      | zero => exact hlift_one
      | succ n ih =>
        show lift O 𝒜 E gE hgE (E.L.mul (𝟙 _) (nsmulPt E.L (𝟙 _) n y) y) = 𝒜.L.mul (𝟙 _) (nsmulPt 𝒜.L (𝟙 _) n _) _
        rw [lift_mul O 𝒜 E gE hgE hgE_mul, ih]
    have hinj : ∀ x₁ x₂ : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f,
        lift O 𝒜 E gE hgE x₁ = lift O 𝒜 E gE hgE x₂ → x₁ = x₂ := by
      intro x₁ x₂ h
      apply Subtype.ext
      apply hgE.hom_ext
      · rw [← lift_spec O 𝒜 E gE hgE x₁, ← lift_spec O 𝒜 E gE hgE x₂, h]
      · rw [x₁.2, x₂.2]
    apply hinj
    rw [hlift_nsmul, ← hxlift, hxt_tors, hlift_one]
  · apply eq_of_comp_gbar_eq O 𝒜 Abar gbar hgbar
    rw [red, redOf_comp, ← hxlift]
    show Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ z ≫ ι =
      (gPt (IsLocalRing.residue ↥O) 𝒜 Abar gbar hgbar (𝟙 _) P).1
    rw [← hz₀, ← Category.assoc, hz2]

end RedKer
