-- Source module: Solutions.SynthNorm
/-!
# §6 The coefficient norm on `R_r = ℂ[y]/(y^r+1)`, monomials, and truncation

A *coefficient model* of `R` is a `ℂ`-linear injective coefficient map `co : R → (Fin r → ℂ)`
with `co 1 = e₀` and `co (y z) = cyc (co z)`, where `cyc` is the negacyclic shift
(`(y z)_0 = -z_{r-1}`, `(y z)_j = z_{j-1}`). The norm of `z` is the sup norm `‖co z‖`.
(`SynthModel.lean` constructs the model on `AdjoinRoot (X^r + 1)`.)

* `norm_co_yp`: every power `y^e` (`e : ℤ`) is an isometry.
* `co_pow_mul` (**monomial split-and-merge**): for `0 ≤ s ≤ r`,
  `(y^s z)_j = z_{j-s}` for `j ≥ s` and `-z_{j+r-s}` otherwise (the tail moved in front and
  negated); with `y^{er+s} = (-1)^e y^s` this is the paper's implementation of `J_E`.
* `eq_sum_co`: `z = ∑_k z_k y^k`; `norm_co_mul_le`: `‖uv‖ ≤ r ‖u‖ ‖v‖`.
* `norm_co_Fm_le`, `norm_co_Fp_le`: the transforms are contractions.
* `QpR`: coefficientwise truncation; (26) `norm_co_QpR_sub_lt`, `norm_co_QpR_le`;
  `QpR_yp`: `Q_p (y^E z) = y^E Q_p z` (truncation toward zero is odd, `J_E` a signed permutation).
-/

set_option linter.unusedSectionVars false

namespace Synth

open Finset Butterfly

variable {R : Type*} [CommRing R] [Algebra ℂ R]

/-! ## 1. The negacyclic shift -/

/-- Coefficients of `y z` from those of `z`. -/
def cyc {r : ℕ} (v : Fin r → ℂ) (j : Fin r) : ℂ :=
  if h : (j : ℕ) = 0 then -v ⟨r - 1, by have := j.isLt; omega⟩
  else v ⟨j - 1, by have := j.isLt; omega⟩

/-- A coefficient model of `R` for the unit `y`, with `r` coefficients. -/
structure CoeffModel (y : Rˣ) (r : ℕ) where
  pos : 0 < r
  co : R →ₗ[ℂ] (Fin r → ℂ)
  inj : Function.Injective co
  co_one : co 1 = Pi.single (⟨0, pos⟩ : Fin r) 1
  co_y : ∀ z, co ((y : R) * z) = cyc (co z)

variable {y : Rˣ} {r : ℕ} (C : CoeffModel y r)

/-! ## 2. Isometries -/

/-! ## 3. Expansion and products -/

/-! ## 4. The transforms are contractions -/

variable {D : ℕ}

/-! ## 5. Truncation `Q_p` on records -/

/-- `Q_p` on a record: truncate every real and imaginary coefficient part toward zero. -/
noncomputable def QpR (p : ℕ) (z : R) : R := ∑ k : Fin r, Qp p (C.co z k) • (y : R) ^ (k : ℕ)

end Synth

end

