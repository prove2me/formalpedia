namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}

/-! ### Smoothness of frame curvature, Weyl and Ricci components -/

theorem contDiffOn_weylF (hF : FrameData g gi E Θ U) (I J A B : Fin 4) :
    ContDiffOn ℝ ∞ (weylF g gi E I J A B) U := by
  have e : weylF g gi E I J A B = fun z => ∑ a, ∑ b, ∑ c, ∑ d,
      (weyl g gi a b c d z : ℂ) * E I a z * E J b z * E A c z * E B d z := by
    funext z; simp only [weylF, ccontr4, fvec]
  rw [e]
  exact ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ => ContDiffOn.sum fun c _ => ContDiffOn.sum fun d _ =>
    (((((contDiffOn_ofReal (contDiffOn_weyl hF.metric a b c d)).mul (hF.smooth_E I a)).mul
      (hF.smooth_E J b)).mul (hF.smooth_E A c)).mul (hF.smooth_E B d))

theorem contDiffOn_ricF (hF : FrameData g gi E Θ U) (A B : Fin 4) : ContDiffOn ℝ ∞ (ricF g gi E A B) U := by
  have e : ricF g gi E A B = fun z => ∑ a, ∑ b, (ricciOf g gi a b z : ℂ) * E A a z * E B b z := by
    funext z; simp only [ricF, ccontr, fvec]
