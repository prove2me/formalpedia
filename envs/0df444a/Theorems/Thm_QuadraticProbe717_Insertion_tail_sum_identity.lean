-- title:
--   Section 7 — finite tail-sum identity
-- statement:
--   For every $n>0$, every nonnegative integer $m$ and every fixed completion order, the cost $T_m$ generated by the uniform hash experiment satisfies
--   $$\mathbb E[T_m]=\sum_{k=0}^{2n-1}\Pr[T_m>k].$$
--   The formula includes full tables, where $T_m=2n$, and counts repeated probes. It is supporting development for the expectation target and has no invented source number.
--
--   Differences from the source:
--   - encoding: distinct keys with independent uniform hashes and arbitrary fixed offset completion → insertion-time indices, ZMod n slots, every fixed completion permutation, and exact finite averages; reason: key labels do not affect insertion; repeated quadratic probes and the first empty slot are retained
-- source:
--   Yang S. Hu, William Kuszmaul, Jingxun Liang, Stefan Walzer, Huacheng Yu, Renfei Zhou, STOC 2027 submission #717 (October 2026), Section 7, displayed expectation identity preceding equation (12), p. 15 (PDF p. 15)

import Definitions.Def_QuadraticProbe717_Insertion_laws

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal

namespace QuadraticProbe717.Insertion

theorem tail_sum_identity (n m : ℕ) [NeZero n] (π : Equiv.Perm (ZMod n)) :
    expectedCost n m π = ∑ k ∈ Finset.range (2 * n), fixedTail n m π k := by sorry

end QuadraticProbe717.Insertion
