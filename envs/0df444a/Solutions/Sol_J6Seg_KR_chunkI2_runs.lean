lemma gflat_len (x : List GI) : (gflat x).length = 2 * x.length := by
  induction x with
  | nil => rfl
  | cons w x ih => simp [gflat_cons, ih]; ring

lemma length_blkG (P : ℕ) {n : ℕ} {di gi gam dd am ap : List ℤ} {z : List GI}
    (hz : z.length ≤ n) (hdi : n ≤ di.length) (hgi : n ≤ gi.length) (hga : n ≤ gam.length)
    (hdd : n ≤ dd.length) : (blkG P (2 * n) di gi gam dd am ap z).length = z.length := by
  have l1 : (dgG P di z).length = z.length := length_dgG P (by omega)
  have l2 : (dgG P gi (dgG P di z)).length = z.length := by rw [length_dgG P (by omega), l1]
  have l3 : (lwG P (2 * n) am (dgG P gi (dgG P di z))).length = z.length := by
    rw [length_lwG P (by omega), l2]
  have l4 : (dgG P gam (lwG P (2 * n) am (dgG P gi (dgG P di z)))).length = z.length := by
    rw [length_dgG P (by omega), l3]
  have l5 : (upG P (2 * n) ap (dgG P gam (lwG P (2 * n) am (dgG P gi (dgG P di z))))).length =
      z.length := by
    simp only [upG, List.length_reverse]; rw [length_lwG P (by simp; omega)]; simp [l4]
  have l6 : (dgG P gi (upG P (2 * n) ap (dgG P gam (lwG P (2 * n) am
      (dgG P gi (dgG P di z)))))).length = z.length := by rw [length_dgG P (by omega), l5]
  unfold blkG; rw [length_dgG P (by omega), l6]

lemma length_chunkB (P : ℕ) {di gi gam dd : List ℤ} :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI), sumN ds ≤ z.length →
      (∀ d ∈ ds, d.1 ≤ di.length ∧ d.1 ≤ gi.length ∧ d.1 ≤ gam.length ∧ d.1 ≤ dd.length) →
      (chunkB P di gi gam dd ds z).length = sumN ds
  | [], z, _, _ => rfl
  | (n, am, ap) :: ds, z, hs, hd => by
    obtain ⟨h1, h2, h3, h4⟩ := hd (n, am, ap) (List.mem_cons_self ..)
    simp only [sumN] at hs ⊢
    simp only [chunkB, List.length_append]
    rw [length_blkG P (by simp) h1 h2 h3 h4,
      length_chunkB P ds (z.drop n) (by simp; omega) (fun d h => hd d (List.mem_cons_of_mem _ h))]
    simp; omega

lemma AB_chunkB (P : ℕ) {A : ℤ} {di gi gam dd : List ℤ} :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI), chunkOK P A di gi gam dd ds z →
      AB A (chunkB P di gi gam dd ds z)
  | [], z, _ => by intro w hw; simp [chunkB] at hw
  | (n, am, ap) :: ds, z, ⟨h1, h2⟩ => by
    intro w hw
    simp only [chunkB, List.mem_append] at hw
    rcases hw with hw | hw
    · exact h1.2.2.2.2.2.2.2 w hw
    · exact AB_chunkB P ds (z.drop n) h2 w hw

end J6Seg.KR

