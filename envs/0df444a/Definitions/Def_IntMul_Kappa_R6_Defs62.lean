def funF (p : ℕ) (t : Fin d → ℕ) (zs : List GI) (K : (i : Fin d) → ZMod (t i)) : ℂ :=
  toC (zs.getD (encode (List.ofFn t) (kL K)) 0) / 2 ^ p

