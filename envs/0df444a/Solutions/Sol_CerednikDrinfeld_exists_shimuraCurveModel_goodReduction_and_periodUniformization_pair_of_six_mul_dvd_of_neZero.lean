      hgal₁ hhecke₁
      (CerednikDrinfeld.heckeKernelMap_classSetHeckeData_apply_eq_neg_comp_classSetShift N q' q hqq'.symm hq'N hqN
        hdef₂ Λ₂ R₂ hΛ₂ hR₂ hRΛ₂ n₂ hS₂ hn₂ hnorm₂ hsq₂ hlaws₂)
