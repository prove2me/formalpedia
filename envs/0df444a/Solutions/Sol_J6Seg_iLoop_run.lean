section loops
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e : Fin Pp}
  {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} (hR : RegOK ρ dT dF)
  {tabOf : ℕ → List ℤ} {Pre : List GI → Prop} {g : ℕ → List GI → List GI} {Ck : ℝ}
  (hRow : RowBody6 Isym tbl e dT tabOf Pre g Ck)
include hR hRow

theorem iLoop_run_sol_aux (m post nc pre B Lmax : ℕ) (hB : 1 ≤ B)
    (s : IState HS) (F : Fin HS → List ℤ) (R0 : List ℤ) (zA aA : ℕ → List ℤ)
    (xr : ℕ → List GI)
    (hS : RowStream Pre g B m post nc (pre * nc * post) zA aA xr)
    (hm2 : F (ρ 7) = [((2 * m : ℕ) : ℤ)]) (hmB : zsz ((2 * m : ℕ) : ℤ) ≤ B)
    (hp : F (ρ 4) = [(post : ℤ)]) (hpB : zsz (post : ℤ) ≤ B)
    (hn : F (ρ 6) = [(nc : ℤ)]) (hnB : zsz (nc : ℤ) ≤ B)
    (hpr : F (ρ 5) = [(pre : ℤ)]) (hprB : zsz (pre : ℤ) ≤ B)
    (hTot : F (ρ 9) = [((tabsT tabOf nc).length : ℤ)])
    (hTotB : zsz ((tabsT tabOf nc).length : ℤ) ≤ B)
    (hTB : ∀ q < nc, Bnd B (tabOf q)) (hTL : ∀ q < nc, (tabOf q).length ≤ Lmax)
    (hLB : zsz (Lmax : ℤ) ≤ B) :
    IRuns Isym tbl (iLoop ρ dT e)
      (encK s (KS ρ dT F (zA 0) [] (tabsT tabOf nc ++ R0) [] [] [] (aA 0) [] [] []))
      (encK s (KS ρ dT F (zA (pre * nc * post)) [] (tabsT tabOf nc ++ R0) [] [] []
        (aA (pre * nc * post)) [] [] []))
      (cIL ⌊Ck⌋₊ B m post Lmax nc (tabsT tabOf nc).length pre) := by
  have hBt : Bnd B (tabsT tabOf nc) := by
    unfold tabsT
    intro a ha
    obtain ⟨q, hq, ha⟩ := List.mem_flatMap.1 ha
    rw [List.mem_range] at hq
    simp only [segT, List.mem_cons] at ha
    rcases ha with rfl | ha
    · exact le_trans (zsz_nat_le (hTL q hq)) hLB
    · exact hTB q hq a ha
  have hpr' : KS ρ dT F (zA (0 * nc * post)) [] (tabsT tabOf nc ++ R0) [] [] []
      (aA (0 * nc * post)) [] [] [] (ρ 5) = [(pre : ℤ)] := by
    rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 5 (by decide), hpr]
  have H := IRuns.irep (I := Isym) (iprog := tbl) (C := ρ 11) (n := .reg (ρ 5))
    (body := iBody ρ dT e) (s := s)
    (F := fun k => KS ρ dT F (zA (k * nc * post)) [] (tabsT tabOf nc ++ R0) [] [] []
      (aA (k * nc * post)) [] [] [])
    (N := pre) (B := B) (c := cIb ⌊Ck⌋₊ B m post Lmax nc (tabsT tabOf nc).length) hB (hR.lt 11)
    (fun k => KS_atCi hR ..) (clean_reg (hR.lt 5)) (ok_reg hpr') trivial (bnd_reg hpr' hprB)
    (eval_reg hpr') (by
      intro k hk
      simp only [KS_ci hR]
      have S1 := qLoop_run hR hRow k m post nc pre B Lmax hB hk s F R0 [(pre : ℤ) - k] zA aA xr
        hS hm2 hmB hp hpB hn hnB hTB hTL hLB
      have h9 : KS ρ dT F (zA ((k + 1) * nc * post)) [] R0 (tabsT tabOf nc).reverse [] []
          (aA ((k + 1) * nc * post)) [(pre : ℤ) - k] [] [] (ρ 9) = [((tabsT tabOf nc).length : ℤ)] := by
        rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 9 (by decide), hTot]
      have S2 := Sp.mvK (hR.ne (by decide : (15 : Fin 19) ≠ 10)) (hR.ne (by decide))
        (hR.ne (by decide)) (hR.lt 15) (hR.lt 10) (hR.lt 18) s
        (KS ρ dT F (zA ((k + 1) * nc * post)) [] R0 (tabsT tabOf nc).reverse [] []
          (aA ((k + 1) * nc * post)) [(pre : ℤ) - k] [] []) (.reg (ρ 9)) (clean_reg (hR.lt 9))
        (ok_reg h9) (tabsT tabOf nc).reverse [] (by rw [KS_atU hR, List.append_nil])
        (by rw [eval_reg h9, List.length_reverse]) B (KIL.bnd_reverse hBt) trivial (bnd_reg h9 hTotB)
      rw [KS_atTq hR, KS_u hR, KS_tq hR, List.reverse_reverse, List.length_reverse] at S2
      refine (S1.seq S2.toIRuns).mono ?_
      have h30 : nc * 30 ≤ nc * (2000 * (B + 2)) := Nat.mul_le_mul_left _ (by omega)
      simp only [cIb, Ex.size]
      ring_nf at h30 ⊢; omega)
  simp only [Nat.zero_mul] at H
  refine H.mono ?_
  have h30 : pre * 30 ≤ pre * (2000 * (B + 2)) := Nat.mul_le_mul_left _ (by omega)
  simp only [cIL, Ex.size]
  ring_nf at h30 ⊢; omega

end loops

