variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
  (hdeg : Module.finrank ℚ K = 3) {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hμu : IsUnitaryChar (𝓞 K) K μ)
  {S : Finset (HeightOneSpectrum (𝓞 ℚ))} (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v)
  {T : Finset (HeightOneSpectrum (𝓞 ℚ))} (hvS : ∀ v, v ∉ T → v ∉ S)
  {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ} (hψ : IsGlobalAddChar ℚ ψ)
  (hψS : ∀ v : HeightOneSpectrum (𝓞 ℚ), LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ v) = 0)
  {Wfin : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ}
  (hfin : ∀ v, v ∉ S →
    IsGL3PsiWhittakerFn (psiLoc ψ v) (Wfin v) ∧
    IsInducedSphericalAt (inducedCoeff K μ) v (localMaximalCompact3 (𝓞 ℚ) ℚ v) (Wfin v) ∧
    (Wfin v) 1 = 1 ∧ HasSphericalTorusValuesAt (inducedCoeff K μ) v (Wfin v))
  {Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ} (hWlocN : ∀ v, v ∉ S → Wloc v = Wfin v)
  (hone : ∀ v, v ∉ S → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)
  {g : AdelicGL 3 (𝓞 ℚ) ℚ} (hgT : ∀ w ∉ T, componentAt3 (𝓞 ℚ) ℚ w g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ w)

include hvS hψ hψS hfin hWlocN hone in

private theorem dual_local_inputs {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ T) :
    IsGL3PsiWhittakerFn (psiLoc ψ v)⁻¹ (dualWhittakerFn3 (Wloc v)) ∧
      IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)) ∧
      dualWhittakerFn3 (Wloc v) 1 = 1 ∧
      ∀ y₀ ∉ v.adicCompletionIntegers ℚ,
        ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ (psiLoc ψ v)⁻¹ y ≠ 1 := by
  have hvS' := hvS v hv
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact isGL3PsiWhittakerFn_dualWhittakerFn3 (psiLoc ψ v) (Wloc v) (by rw [hWlocN v hvS']; exact (hfin v hvS').1)
  · refine TorusTransport.isRightInvariant_dualWhittakerFn3
      (fun u hu => DualProduct.transposeInv3_mem_localMaximalCompact3 hu) ?_
    rw [hWlocN v hvS']
    exact (hfin v hvS').2.1.1
  · exact hone v hvS' _ (DualProduct.longWeyl3_mul_transposeInv3_mem_localMaximalCompact3 (one_mem _))
  · intro y₀ hy₀
    obtain ⟨hne, hball⟩ := TorusDilation.psiLoc_ne_one_and_exists_ball hψ v
    obtain ⟨y, hy, hψy⟩ :=
      TwistUnits.exists_ne_one_of_addCharLevel_eq_zero (psiLoc ψ v) hball hne (hψS v) y₀ hy₀
    refine ⟨y, hy, ?_⟩
    rw [AddChar.inv_apply']
    exact inv_ne_one.mpr hψy

include hdeg hμu hS hvS hψ hψS hfin hWlocN hone hgT in

private theorem xLineAt_eq_dualValue {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ T) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
        ∫ y : v.adicCompletion ℚ, LineIntegral.xLineAt Wloc a g v y ∂(selfDualHaarAt ℚ v) =
      dualValue (inducedCoeff K μ) v (Idele.ord ℚ v a) := by
  have hvS' := hvS v hv
  have hbad : ¬ IsBadPlace K μ v := fun h => hvS' ((hS v).mpr h)
  obtain ⟨hwhit, hinv, -, hψloc⟩ := dual_local_inputs hvS hψ hψS hfin hWlocN hone hv
  have hE3 : inducedE3 ℚ (inducedCoeff K μ) v ≠ 0 := by
    intro h
    have := InducedE3Unitary.norm_inducedE3_inducedCoeff_eq_one_of_not_isBadPlace K μ hdeg hμu v hbad
    rw [h, norm_zero] at this
    exact zero_ne_one this
  have hWv : HasSphericalTorusValuesAt (inducedCoeff K μ) v (Wloc v) := by
    rw [hWlocN v hvS']; exact (hfin v hvS').2.2.2
  have hWz : ∀ h : LocalGL3 v, Wloc v (centralGen v * h) = inducedE3 ℚ (inducedCoeff K μ) v * Wloc v h := by
    rw [hWlocN v hvS']; exact (hfin v hvS').2.1.2.2.2
  obtain ⟨hpos, hneg⟩ :=
    DualPassage.xLineAt_uniformizer_pow_eq_shellCoeff_inv_triple (inducedCoeff K μ) v Wloc hWv hE3 hWz
      (ψloc := fun w => (psiLoc ψ w)⁻¹) hwhit hinv hψloc g (hgT v hv)
  by_cases hlt : Idele.ord ℚ v a < 0
  · rw [hneg a hlt, dualValue_of_neg _ _ hlt]
  · have h0 : 0 ≤ Idele.ord ℚ v a := not_lt.mp hlt
    have hn : Idele.ord ℚ v a = ((Idele.ord ℚ v a).toNat : ℤ) := (Int.toNat_of_nonneg h0).symm
    rw [hpos a _ hn, hn, dualValue_natCast, Int.toNat_natCast]

end
