variable {d : ℕ}

theorem NLogN.KFM.tensor_of_lines_expl (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)] (c : ℂ)
    (A : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ))
    (B : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ))
    (hA : ∀ i, ‖A i‖ ≤ 1) (hB : ∀ i, ‖B i‖ ≤ 1)
    (h : ∀ i u, IntMul.OpenAI.RH.permS (s i) (t i) ((s i : ℂ)⁻¹ • ZMod.dft u) =
      c • B i (IntMul.OpenAI.RH.permT (s i) (t i) ((t i : ℂ)⁻¹ • ZMod.dft (A i u)))) :
    ‖tensCLM (kerA A)‖ ≤ 1 ∧ ‖tensCLM (kerB B)‖ ≤ 1 ∧
      ∀ u, Rperm s t (dftM s u) =
        c ^ d • tensCLM (kerB B) (Qperm s t (dftM t (tensCLM (kerA A) u))) := by sorry
