open J6Seg J6Seg.Side
open Finset
open IntMul NLogN IntMul.Kappa.R6 J6Seg
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxJ P n src D k)
include h

theorem J6Seg.Side.jcost_ax (u B : ℕ) :
    dP6 P n * kerC (JK.jC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
        (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n) (axw6 P n)) u + 2)
      B (2 ^ axfJ6 P n src k) (axpost6 P n D k) (axTJ6 P n src k ap).length 1
      (tabsT (fun _ => axTJ6 P n src k ap) 1).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * 1 * axpost6 P n D k * 2 ^ axfJ6 P n src k)) ≤
    TP6 P n * (400000 * (axw6 P n + 1) * u + 40000000000 * (B + 2) * (axw6 P n + 1)) := by sorry
