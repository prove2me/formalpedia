private def integrand (Φ : (AdeleRing (𝓞 ℚ) ℚ)ˣ → ℂ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (s : ℂ)
    (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : ℂ :=
  Φ a * ((χ a : ℂˣ) : ℂ) * ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)

private theorem globalZeta30_eq_integral (W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (s : ℂ)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    globalZeta30 W χ s g =
      ∫ a, integrand (fun a => W (iotaGL (diagUnitGL2 a) * g)) χ s a ∂(NumberField.Idele.idelicHaar ℚ) := rfl

