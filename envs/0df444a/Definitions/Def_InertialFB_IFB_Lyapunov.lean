-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-09-27T17:46:24.295407+00:00
-- url     : https://prove2.me/theorems/6312da14-9819-4a9b-a326-ce57fa763f22
-- title:
--   Energy $E_k$, velocities $\xi_k,\zeta_k$, $z_k$ and the Liapunov-type sequences $G_k(q)$, $F_k(q)$
-- statement:
--   Fix parameters $a, b, \lambda$ and sequences $(u_k), (y_k)$ in $H$ (typically generated by (IFB)). Define the constants
--   $$\gamma = \frac{1-a\lambda}{2b\lambda^2}, \qquad \alpha = \frac{1+b\lambda}{2\lambda^2}, \qquad \delta = \frac{2+(b-a)\lambda}{2\lambda^2},$$
--   and, for $k \ge 1$,
--
--   1. the velocity $\xi_k = u_k - u_{k-1}$ and $\zeta_k = y_k - y_{k-1}$;
--   2. $z_k = \dfrac{\xi_k}{\lambda} + a u_{k-1} - b y_{k-1}$ (by (IFB), $-z_k \in \partial\Phi(u_k)$);
--   3. the mechanical energy $E_k = \Theta(u_k) + \gamma\|\xi_k\|^2$.
--
--   For $q \in H$ and $k \ge 2$,
--   $$G_k(q) = \langle z_k, u_k - q\rangle - \sum_{i=2}^{k}\langle z_i, \xi_i\rangle,$$
--   and for $k \ge 1$
--   $$F_k(q) = \frac{a+b}{2\lambda}\|u_k - q\|^2 - \left(\frac1\lambda + b\right)G_{k+1}(q) - \delta\sum_{i=2}^{k}\|\xi_i\|^2 + 2\alpha\langle \xi_{k+1}, u_k - q\rangle.$$
--
--   The energy $E_k$ is the dissipated quantity of Section 2.1 of the paper, and $F_k(q)$ is the Liapunov-type sequence of Section 2.2, nonincreasing whenever $q$ minimizes $\Theta$.
--
--   **Formalization Note** All objects are defined for every natural index $k$, but only the indices stated above are meaningful: at $k = 0$ the natural-number subtraction gives $u_{0-1} = u_0$, so $\xi_0 = 0$. Every theorem of the mission quantifies $k \ge 1$ (or $k \ge 2$ for $G$) exactly where the paper does. $E_k$ is `EReal`-valued (it equals $+\infty$ when $u_k \notin \operatorname{dom}\Phi$); it is never converted to a real number. Sums $\sum_{i=2}^k$ run over `Finset.Icc 2 k`.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 4 (eq. (7), ξ_k, eq. (8)), p. 5 (eqs. (9), (10)), p. 6 (eqs. (17), (18), α, δ)

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_InertialFB_IFB_Algorithm

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The constant `γ = (1 - aλ)/(2bλ²)` of (7). -/
noncomputable def gammaC (a b lam : ℝ) : ℝ := (1 - a * lam) / (2 * b * lam ^ 2)

/-- The constant `α = (1 + bλ)/(2λ²)` introduced after (18). -/
noncomputable def alphaC (b lam : ℝ) : ℝ := (1 + b * lam) / (2 * lam ^ 2)

/-- The constant `δ = (2 + (b - a)λ)/(2λ²)` introduced after (18). -/
noncomputable def deltaC (a b lam : ℝ) : ℝ := (2 + (b - a) * lam) / (2 * lam ^ 2)

/-- The velocity `ξ_k = u_k - u_{k-1}` (meaningful for `k ≥ 1`). -/
noncomputable def xi (u : ℕ → H) (k : ℕ) : H := u k - u (k - 1)

/-- `ζ_k = y_k - y_{k-1}` of (9) (meaningful for `k ≥ 1`). -/
noncomputable def zeta (y : ℕ → H) (k : ℕ) : H := y k - y (k - 1)

/-- `z_k = ξ_k/λ + a u_{k-1} - b y_{k-1}` of (10) (meaningful for `k ≥ 1`). -/
noncomputable def zSeq (a b lam : ℝ) (u y : ℕ → H) (k : ℕ) : H :=
  (1 / lam) • xi u k + a • u (k - 1) - b • y (k - 1)

/-- The mechanical energy `E_k = Θ(u_k) + γ‖ξ_k‖²` of (8), with values in `ℝ ∪ {±∞}`. -/
noncomputable def energy (Φ : H → EReal) (Ψ : H → ℝ) (a b lam : ℝ) (u : ℕ → H) (k : ℕ) : EReal :=
  theta Φ Ψ (u k) + ((gammaC a b lam * ‖xi u k‖ ^ 2 : ℝ) : EReal)

/-- `G_k(q) = ⟪z_k, u_k - q⟫ - ∑_{i=2}^{k} ⟪z_i, ξ_i⟫` of (17) (meaningful for `k ≥ 2`). -/
noncomputable def auxG (a b lam : ℝ) (u y : ℕ → H) (k : ℕ) (q : H) : ℝ :=
  inner ℝ (zSeq a b lam u y k) (u k - q) -
    ∑ i ∈ Finset.Icc 2 k, inner ℝ (zSeq a b lam u y i) (xi u i)

/-- `F_k(q) = (a+b)/(2λ) ‖u_k - q‖² - (1/λ + b) G_{k+1}(q) - δ ∑_{i=2}^{k} ‖ξ_i‖²
+ 2α ⟪ξ_{k+1}, u_k - q⟫` of (18) (meaningful for `k ≥ 1`). -/
noncomputable def auxF (a b lam : ℝ) (u y : ℕ → H) (k : ℕ) (q : H) : ℝ :=
  (a + b) / (2 * lam) * ‖u k - q‖ ^ 2 - (1 / lam + b) * auxG a b lam u y (k + 1) q -
    deltaC a b lam * ∑ i ∈ Finset.Icc 2 k, ‖xi u i‖ ^ 2 +
    2 * alphaC b lam * inner ℝ (xi u (k + 1)) (u k - q)

end InertialFB.IFB


