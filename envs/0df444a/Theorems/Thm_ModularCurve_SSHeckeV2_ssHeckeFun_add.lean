open AlgebraicCurve ModularCurve

theorem ModularCurve.SSHeckeV2.ssHeckeFun_add (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p) (K : Type) [Field K] [CharP K p] [IsAlgClosed K] [DecidableEq K] (N : ℕ) [NeZero N]
    (hN : (N : K) ≠ 0) (ℓ : ℕ) [Fact ℓ.Prime] (hℓN : ¬ ℓ ∣ N) (hℓp : ℓ ≠ p)
    (k : ℤ) (v w : ModularCurve.SSCarrier p N K hp5 k) :
    ModularCurve.ssHeckeFun p N K hp5 k ℓ (v + w) = ModularCurve.ssHeckeFun p N K hp5 k ℓ v + ModularCurve.ssHeckeFun p N K hp5 k ℓ w := by sorry
