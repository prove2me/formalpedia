-- title:
--   atomic-open-quasipoints
-- statement:
--   For a Hausdorff space $M$, a quasipoint of $T(M)$ is isolated exactly when it is generated by a unique open atom, equivalently by a unique isolated point $x\in M$:
--
--   $$\mathfrak B=\{U\in T(M):x\in U\}.$$
--
--   This extends Proposition 3.6 to open-set lattices without assuming orthomodularity of $T(M)$.
-- source:
--   Observables I: Stone Spectra, arXiv:math-ph/0509020v1, PDF p. 44, atomic-open-quasipoints

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P20

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakethird100.P20

open Set TopologicalSpace

open QAlgorithms.Papers.Independent.Next46.P33 (Projection)

open scoped Topology

universe u v

/-- atomic-open-quasipoints; de Groote, Observables I, PDF p./pp. 44, 45.
-/
theorem isolated_open_quasipoints {M : Type u} [TopologicalSpace M] [T2Space M] (B : StoneSpectrum (Opens M)) :
    (IsOpen ({B} : Set (StoneSpectrum (Opens M))) ↔
      ∃! U : Opens M, IsAtom U ∧ B.val = principalQuasipoint U) ∧
    (IsOpen ({B} : Set (StoneSpectrum (Opens M))) ↔
      ∃! x : M, IsOpen ({x} : Set M) ∧ B.val = {U : Opens M | x ∈ (U : Set M)}) := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P20

end
