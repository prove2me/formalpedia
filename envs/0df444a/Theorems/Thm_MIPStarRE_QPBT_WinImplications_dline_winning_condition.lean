attribute [local instance] _root_.MIPStarRE.QPBT.WinImplications.instDecidableRel_qPBT
attribute [local instance] _root_.MIPStarRE.QPBT.WinImplications.linePointFintypeCanonical

theorem MIPStarRE.QPBT.WinImplications.dline_winning_condition (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (W : _root_.MIPStarRE.QPBT.PauliKind)
    (z : _root_.MIPStarRE.QPBT.PauliSpace P) (f : Fin (P.m * P.d + 1) → _root_.MIPStarRE.QPBT.PauliScalar P)
    (a : _root_.MIPStarRE.QPBT.PauliScalar P)
    (hwin : _root_.MIPStarRE.QPBT.pauliWinPredicate P
      ((.dline W), _root_.MIPStarRE.QPBT.pauliCL P (.dline W) z)
      ((.point W), _root_.MIPStarRE.QPBT.pauliCL P (.point W) z)
      (.dlinePoly f) (.value a) = true) :
    ∀ t : _root_.MIPStarRE.QPBT.ScalarQ P.toLdParams,
      (_root_.MIPStarRE.QPBT.pauliToLd P W z).point =
          (_root_.MIPStarRE.QPBT.dLineDescOf P.toLdParams
            (_root_.MIPStarRE.QPBT.ldDLineCL P.toLdParams (_root_.MIPStarRE.QPBT.pauliToLd P W z))).base +
            t • (_root_.MIPStarRE.QPBT.dLineDescOf P.toLdParams
              (_root_.MIPStarRE.QPBT.ldDLineCL P.toLdParams (_root_.MIPStarRE.QPBT.pauliToLd P W z))).direction →
        _root_.MIPStarRE.QPBT.evalCoefficient f t = a := by sorry
