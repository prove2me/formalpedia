theorem solution
    (p M : ℕ) [Fact p.Prime] [NeZero M] (H : Subgroup (ZMod M)ˣ) (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (hj : jqModC ℚ ∈ qExpFunctionFieldC ℚ (⊤ : Subgroup SL(2, ℤ)))
    (𝔛 : XHDRModelAtP p M H hpM hj)

    (D : RelativePic0Designation (R p) (toBase p (ΓM M H) hj))
    (hD : RepresentsRelSubPic (toBase p (ΓM M H) hj) 𝔛.εinf (algEquivZeroCut (toBase p (ΓM M H) hj) 𝔛.εinf) D)
    [Smooth D.toBase]
    (s : Spec (CommRingCat.of (R p))) (n : ℕ) (hn : 0 < n) (hs : ¬ IsUnit ((n : GoodReductionJacobian.RelativeGroupLaw.baseResidueField s))) :
    LocallyQuasiFinite
      (((RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut (toBase p (ΓM M H) hj) 𝔛.εinf) hD).fibre s).schemeNsmul n) := by
  classical

  obtain ⟨A, hA⟩ := ValuationSubring.exists_liesOverPrime_algebraicClosure_rat ⟨p, Fact.out⟩
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  obtain ⟨ρ, hρ⟩ := ValuationSubring.exists_ratLocalizedAt_ringHom_of_liesOverPrime p A hA

  letI : Algebra (R p) (ResidueField ↥A) := ((residue ↥A).comp ρ).toAlgebra
  haveI : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField_algebraicClosure_rat A
  haveI : CharP (ResidueField ↥A) p := ValuationSubring.residueField_charP_of_liesOverPrime A Fact.out hA

  obtain ⟨φ, hφ⟩ := Ws49.LQFH.exists_ringHom_baseResidueField_of_not_isUnit hA ρ s n hn hs
  letI : Algebra (baseResidueField s) (ResidueField ↥A) := φ.toAlgebra

  have hcs : ((RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut (toBase p (ΓM M H) hj) 𝔛.εinf) hD).fibre s).IsCommutative := by
    rw [fibre_eq_baseChange]
    exact RelativeGroupLaw.IsCommutative.baseChange _
      (RepresentsRelSubPic.relativeGroupLaw_isCommutative (P := algEquivZeroGroupCut (toBase p (ΓM M H) hj) 𝔛.εinf) hD)
  refine locallyQuasiFinite_schemeNsmul_of_finite_torsionSubset _ (fun t x y => hcs t x y) (ResidueField ↥A) n ?_

  apply Ws49.LQFH.finite_torsionSubset_fibre_of_finite _ s φ (Spec.map (CommRingCat.ofHom ((residue ↥A).comp ρ))) hφ n

  rw [Ws49.LQFH.finite_torsionSubset_iff_baseChange]

  obtain ⟨D₀, ⟨hD₀⟩, hsm₀, hpr₀, hgc₀⟩ :=
    ModularCurve.XHDRModelAtP.exists_representsRelSubPic_levelN_comp_epsInf_pi p M H hpM hpM2 hj 𝔛

  obtain ⟨ε₀κ, hε₀κ₁, hε₀κ₂, hε₁⟩ := Ws49.LQFH.exists_epsZero_fibre 𝔛 A hA ρ hρ

  obtain ⟨-, -, hDκ, -, hD₀κ, -, hε₁', τ, abq, -, -, hτci, hτmul, habq, -, -, hker⟩ :=
    ModularCurve.XHDRModelAtP.exists_representsRelSubPic_torus_abq_specialFibre p M H hpM hpM2 hj 𝔛 A hA ρ hρ
      D hD (NeronModelInfra.schemeHomOverComp 𝔛.εinf 𝔛.π) D₀ hD₀ ε₀κ hε₀κ₁ hε₀κ₂ hε₁
  refine Ws49.LQFH.finite_torsionSubset_of_torus_abq _ _ (RelativeGroupLaw.IsCommutative.baseChange _
      (RepresentsRelSubPic.relativeGroupLaw_isCommutative (P := algEquivZeroGroupCut (toBase p (ΓM M H) hj) 𝔛.εinf) hD)) _
      τ hτci hτmul abq habq hker n hn
    (AddMonoidAlgebra.finite_setOf_withConv_algHom_pow_eq_one _ _ n hn) ?_

  haveI : IsProper (toBase p (ΓN p M H hpM) hj) := 𝔛.isProper0
  obtain ⟨ptsSp₀, hadd, -⟩ :=
    ModularCurve.XHDRModelAtP.exists_ptsSp_levelN_pic0_equiv_of_representsRelSubPic p M H hpM hpM2 hj 𝔛 A hA ρ hρ
      D₀ hD₀ hsm₀ hpr₀ hgc₀
  have key := Ws49.LQFH.finite_torsionSubset_baseChange_id_of_equiv
    (RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut (toBase p (ΓN p M H hpM) hj)
      (NeronModelInfra.schemeHomOverComp 𝔛.εinf 𝔛.π)) hD₀) _ ptsSp₀ hadd n
    (Ws49.LQFH.finite_subtype_nsmul_eq_zero_of_finite_torsion n
      (Ws49.LQFH.finite_pic0_torsion_fbar p M H hpM (ResidueField ↥A) n hn))

  rw [← Ws49.LQFH.finite_torsionSubset_iff_baseChange, ← Ws49.LQFH.specMap_residue_comp A ρ] at key
  rw [← Ws49.LQFH.finite_torsionSubset_iff_baseChange]
  exact key

end head

