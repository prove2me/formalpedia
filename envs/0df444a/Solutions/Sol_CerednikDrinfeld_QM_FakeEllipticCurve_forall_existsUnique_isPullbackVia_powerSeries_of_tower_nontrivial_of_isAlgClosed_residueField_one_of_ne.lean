    have he : e.toRingHom.comp ((algebraMap (ResidueField O) (DualNumber (ResidueField O))).comp ψk) = ψ₀ O := by
      apply RingHom.ext
      intro o
      show twistHom σ ((algebraMap (ResidueField O) (DualNumber (ResidueField O))) (ψk o)) =
        (algebraMap (ResidueField O) (DualNumber (ResidueField O))) (residue O o)
      apply TrivSqZeroExt.ext
      · rw [fst_twistHom, fst_algebraMap_dual, fst_algebraMap_dual, ← RingHom.comp_apply, hσ]
      · rw [snd_twistHom, snd_algebraMap_dual, snd_algebraMap_dual, map_zero]
