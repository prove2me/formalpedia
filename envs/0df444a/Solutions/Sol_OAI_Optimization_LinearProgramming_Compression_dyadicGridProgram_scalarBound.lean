theorem runExactly_add_series (p : Program) (s : State K) (i j : ℕ) :
    runExactly p s (i + j) = (runExactly p s i).bind (fun a => runExactly p a j) := by
  induction j with
  | zero => simp [runExactly]
  | succ j ih => simp [runExactly, ih, Option.bind_assoc]

