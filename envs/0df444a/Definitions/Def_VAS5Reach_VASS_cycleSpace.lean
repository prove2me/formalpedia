-- title:
--   Simple cycles, cycle space $\mathrm{CYC}(V)$, $\dim_{\mathrm{cyc}}$, cones and wideness
-- statement:
--   Let $V$ be a $d$-VASS. A **cycle** is a nonempty path from a state back to itself, and a **simple cycle** repeats no state except its initial and final state (`IsSimpleCycle`). Let $E(V)$ be the set of effects of simple cycles of $V$ (`cycleEffects`). Then
--   $$
--   \mathrm{CYC}(V) := \operatorname{span}_{\mathbb Q} E(V) \subseteq \mathbb Q^d, \qquad \dim_{\mathrm{cyc}}(V) := \dim \mathrm{CYC}(V)
--   $$
--   (`cycleSpace`, `dimcyc`). For $X \subseteq \mathbb Q^d$, $\mathrm{cone}(X)$ is the set of nonnegative rational combinations of finitely many elements of $X$ (`cone`). Following Definition 6.6, $\mathrm{cone}(V) := \mathrm{cone}(E(V))$, and $V$ is **wide** if $\mathrm{cone}(V) = \mathbb Q^d$ (`IsWide`).
-- source:
--   Chen, Fu, Fu, Reachability in Five-Dimensional Vector Addition Systems Is PSPACE-Complete, arXiv:2610.40012 (held version, sha256 a74d76f9…), §3 'Cone and Cycle-Dimension', p.13 (cone) and p.15 (PDF pp.15, 17); Definition 6.6, p.27 (PDF p.29)

import Mathlib
import Definitions.Def_VAS5Reach_VASS_IsRun

namespace VAS5Reach

namespace VASS

variable {S ι : Type}

/-- `π` is a simple cycle of `V`: a nonempty path of `V` from a state back to itself that repeats
no state except its initial and final state (the source states of its transitions are pairwise
distinct). -/
def IsSimpleCycle (V : VASS S ι) (π : List (S × (ι → ℤ) × S)) : Prop :=
  π ≠ [] ∧ (∃ p, IsPath V p π p) ∧ (π.map fun τ => τ.1).Nodup

/-- `E(V)`: the set of effects of simple cycles of `V`. -/
def cycleEffects (V : VASS S ι) : Set (ι → ℤ) :=
  {e | ∃ π, IsSimpleCycle V π ∧ eff π = e}

/-- The cycle space `CYC(V) := span_ℚ {EFF(π) : π is a simple cycle in V} ⊆ ℚ^d`.

Source: W. Chen, B. Fu, Y. Fu, *Reachability in Five-Dimensional Vector Addition Systems Is
PSPACE-Complete*, arXiv:2610.40012 (held version, sha256 a74d76f9…), §3 "Cone and
Cycle-Dimension", printed p. 15 (PDF p. 17): "Its cycle space CYC(V) ⊆ Q^d is the span of the
effects of simple cycles in the VASS V, i.e., CYC(V) := span{EFF(π) : π is a simple cycle in V}.
Its cycle-dimension dimcyc(V) := dim(CYC(V)) is the dimension of its cycle space."; and p. 13:
"[a path] is a cycle if it is nonempty and qk = p1, and a simple cycle if it repeats no state except
its initial and final state." -/
def cycleSpace (V : VASS S ι) : Submodule ℚ (ι → ℚ) :=
  Submodule.span ℚ ((fun e : ι → ℤ => fun i => (e i : ℚ)) '' cycleEffects V)

/-- The cycle-dimension `dimcyc(V) := dim(CYC(V))`. -/
noncomputable def dimcyc (V : VASS S ι) : ℕ :=
  Module.finrank ℚ (cycleSpace V)

end VASS

/-- `cone(X) := {λ₁·x₁ + ⋯ + λₙ·xₙ : xᵢ ∈ X, λᵢ ∈ ℚ≥0}`, the set of nonnegative rational
combinations of finitely many elements of `X` (containing `0`, the empty combination).

Source: arXiv:2610.40012 (held version, sha256 a74d76f9…), §3, printed p. 13 (PDF p. 15): "For a
finite set X ⊆ Q^d of vectors where X = {x1, . . . , xn}, the cone generated by X is
cone(X) := {λ1 · x1 + · · · + λn · xn : λ1, . . . , λn ∈ Q≥0}." -/
def cone {ι : Type} (X : Set (ι → ℚ)) : Set (ι → ℚ) :=
  {v | ∃ l : List ((ι → ℚ) × ℚ), (∀ e ∈ l, e.1 ∈ X ∧ 0 ≤ e.2) ∧
    v = (l.map fun e => e.2 • e.1).sum}

namespace VASS

variable {S ι : Type}

/-- Wideness (Definition 6.6): with `E(U)` the set of effects of simple cycles of `U` and
`cone(U) := cone(E(U))`, the `d`-VASS `U` is wide if `cone(U) = ℚ^d`.

Source: arXiv:2610.40012 (held version, sha256 a74d76f9…), Definition 6.6, printed p. 27
(PDF p. 29): "Definition 6.6 (Wideness). Let U be a d-VASS. Let E(U) be the set of effects of simple
cycles in U, and let cone(U) := cone(E(U)). A d-VASS U is called wide if cone(U) = Q^d." -/
def IsWide (U : VASS S ι) : Prop :=
  cone ((fun e : ι → ℤ => fun i => (e i : ℚ)) '' cycleEffects U) = Set.univ

end VASS

end VAS5Reach


