  · have heven_a := he
    obtain ⟨t, ht⟩ := he
    have hodd : Odd (5 * a - 1) := by
      refine ⟨5 * t - 1, ?_⟩
      omega
    rw [Even.neg_one_pow heven_a, Odd.neg_one_pow hodd]
  · have hodd_a := ho
    obtain ⟨t, ht⟩ := ho
    have heven : Even (5 * a - 1) := by
      refine ⟨5 * t + 2, ?_⟩
      omega
    rw [Odd.neg_one_pow hodd_a, Even.neg_one_pow heven]
    norm_num

