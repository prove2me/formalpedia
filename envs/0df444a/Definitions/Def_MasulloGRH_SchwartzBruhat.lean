-- title:
--   The Schwartz–Bruhat space $\mathcal S(G)$ of a locally compact abelian group
-- statement:
--   This is Bruhat's space of Schwartz functions on a Hausdorff locally compact abelian group, with its locally convex topology.
--
--   **Elementary groups.** An **elementary abelian Lie group** is $A=\mathbb R^m\times\mathbb T^n\times\mathbb Z^r\times F$ with $\mathbb T=\mathbb R/\mathbb Z$ and $F$ a finite abelian group, with coordinates $(x,z,a,b)$. A function $g$ on $A$ is **smooth of rapid decay** if it is smooth in $(x,z)$ and for all $i,j,k\ge0$
--   $$\sup_{(x,z,a,b)\in A}|a|^j\,|x|^i\,\big\|D^k_{(x,z)}g(x,z,a,b)\big\|<\infty .$$
--   $\mathcal S(A)$ is the space of these functions, with the locally convex topology of these seminorms.
--
--   **Structural pairs.** Let $G$ be a Hausdorff locally compact abelian group with dual group $\widehat G$.
--
--   1. A subgroup is **compactly generated** if it is generated by a compact neighbourhood of its identity.
--   2. The **annihilator** of a subgroup $k$ is $k^\perp=\{\chi\in\widehat G:\chi(k)=1\}$.
--   3. A closed subgroup $k$ is **good** if $k^\perp$ is open and compactly generated.
--   4. A pair $(\Gamma,k)$ is **structural** if $\Gamma$ is an open compactly generated subgroup, $k$ is good and $k\subset\Gamma$. Then $\Gamma/k$ is an elementary abelian Lie group.
--
--   **Schwartz–Bruhat functions.** For a structural pair $(\Gamma,k)$, $\mathcal S(k,\Gamma)$ is the space of functions on $G$ that are supported in $\Gamma$, invariant under $k$, and whose induced function on $\Gamma/k\cong\mathbb R^m\times\mathbb T^n\times\mathbb Z^r\times F$ is smooth of rapid decay; it carries the topology of $\mathcal S(\Gamma/k)$. The **Schwartz–Bruhat space** is
--   $$\mathcal S(G)=\bigcup_{(\Gamma,k)}\mathcal S(k,\Gamma),$$
--   with the locally convex inductive limit topology: the finest locally convex topology for which all inclusions $\mathcal S(k,\Gamma)\to\mathcal S(G)$ are continuous.
--
--   For $G=\mathbb R^m$ this is the Schwartz space; for a totally disconnected $G$ it is the space of locally constant functions with compact support. The spaces $\mathcal S(\mathbb A_F)$, $\mathcal S(\mathbb A_{F,S})$ and $\mathcal S(C_F)$ of the draft are instances.
--
--   **Formalization Note** Groups are written multiplicatively; for an additive group $A$ one uses the multiplicative copy of $A$. The finite group $F$ is $\prod_{i<s}\mathbb Z/d_i$. An isomorphism $\Gamma/k\cong\mathbb R^m\times\mathbb T^n\times\mathbb Z^r\times F$ is given by a continuous open surjective homomorphism from $\Gamma$ with kernel $k$. The seminorms $\sup|a|^j|x|^i\|D^kg\|$ replace the seminorms $\sup|a^\delta x^\alpha\partial_x^\beta\partial_z^\gamma g|$ of (D.1.3.7); the two families define the same space and the same topology. $\mathcal S(G)$ is defined as the linear span of the spaces $\mathcal S(k,\Gamma)$, which form a directed system.
-- source:
--   A. M. Masullo, The Music of the Primes, draft of 20 November 2026, https://math216.wordpress.com/wp-content/uploads/2026/11/the-music-of-the-primes.pdf, Appendix D, §D.1: §D.1.3 and Definition D.1.3.1 (pp. 749–750); Definition D.1.4.1 (p. 757); Definition D.1.4.5 (p. 758); Definition D.1.5.1 (p. 760); Definition D.1.5.3 and eq. (D.1.5.4) (pp. 762–763)

import Definitions.Def_MasulloGRH_LocallyConvex

/-!
# The Schwartz–Bruhat space of a Hausdorff locally compact abelian group

Source: A. M. Masullo, *The Music of the Primes* (draft of 20 November 2026), Appendix D, §D.1:
§D.1.3 and Definition D.1.3.1 (pp. 749–750), Definition D.1.4.1 (p. 757), Definition D.1.4.5
(p. 758), Definition D.1.5.1 (p. 760), Definition D.1.5.3 and eq. (D.1.5.4) (pp. 762–763).

Groups are written multiplicatively.  For an additive group `A` the space is
`SchwartzBruhat (Multiplicative A)`.
-/

set_option warn.classDefReducibility false

namespace MasulloGRH

open Topology

noncomputable section

universe u

/-! ### Elementary abelian Lie groups -/

/-- The elementary abelian Lie group `ℝ^m × 𝕋^n × ℤ^r × F` (D.1.3.1), with `𝕋 = ℝ/ℤ` and the
finite abelian group `F = ∏_{i < s} ℤ/d_i`. -/
abbrev ElemGroup (m n r s : ℕ) (d : Fin s → ℕ) : Type :=
  (Fin m → ℝ) × (Fin n → UnitAddCircle) × (Fin r → ℤ) × ((i : Fin s) → ZMod (d i))

/-- The pull-back of a function on `ℝ^m × 𝕋^n × ℤ^r × F` to `ℝ^m × ℝ^n × ℤ^r × F` along the
quotient map `ℝ^n → 𝕋^n` (D.1.3.2). -/
def elemLift {m n r s : ℕ} {d : Fin s → ℕ} (g : ElemGroup m n r s d → ℂ)
    (a : Fin r → ℤ) (b : (i : Fin s) → ZMod (d i)) (xt : (Fin m → ℝ) × (Fin n → ℝ)) : ℂ :=
  g (xt.1, fun j => ((xt.2 j : ℝ) : UnitAddCircle), a, b)

/-- Definition D.1.3.1: `g` is smooth and of rapid decay on `ℝ^m × 𝕋^n × ℤ^r × F`: it is smooth in
the variables `(x, z) ∈ ℝ^m × 𝕋^n` and, for all `i, j, k`, the function
`|a|^j |x|^i ‖D^k_{(x,z)} g(x, z, a, b)‖` is bounded.  (This family of seminorms is equivalent to
the family `sup |a^δ x^α ∂_x^β ∂_z^γ g|` of (D.1.3.7).) -/
def IsRapidDecay {m n r s : ℕ} {d : Fin s → ℕ} (g : ElemGroup m n r s d → ℂ) : Prop :=
  (∀ a b, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (elemLift g a b)) ∧
  ∀ i j k : ℕ, ∃ C : ℝ, ∀ a b xt,
    ‖a‖ ^ j * ‖xt.1‖ ^ i * ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖ ≤ C

/-- The Schwartz–Bruhat space `S(ℝ^m × 𝕋^n × ℤ^r × F)` of an elementary abelian Lie group, as a
space of functions. -/
def elemSchwartzSubmodule (m n r s : ℕ) (d : Fin s → ℕ) :
    Submodule ℂ (ElemGroup m n r s d → ℂ) :=
  Submodule.span ℂ {g | IsRapidDecay g}

/-- The Schwartz–Bruhat space `S(ℝ^m × 𝕋^n × ℤ^r × F)` (Definition D.1.3.1). -/
def ElemSchwartz (m n r s : ℕ) (d : Fin s → ℕ) : Type := ↥(elemSchwartzSubmodule m n r s d)

instance (m n r s : ℕ) (d : Fin s → ℕ) : AddCommGroup (ElemSchwartz m n r s d) :=
  inferInstanceAs (AddCommGroup ↥(elemSchwartzSubmodule m n r s d))

instance (m n r s : ℕ) (d : Fin s → ℕ) : Module ℂ (ElemSchwartz m n r s d) :=
  inferInstanceAs (Module ℂ ↥(elemSchwartzSubmodule m n r s d))

/-- The underlying function of an element of `S(ℝ^m × 𝕋^n × ℤ^r × F)`. -/
def ElemSchwartz.toFun {m n r s : ℕ} {d : Fin s → ℕ} (g : ElemSchwartz m n r s d) :
    ElemGroup m n r s d → ℂ := g.1

/-- The topology of `S(ℝ^m × 𝕋^n × ℤ^r × F)` (Definition D.1.3.1): the locally convex topology of
the seminorms `sup |a|^j |x|^i ‖D^k g‖`, i.e. uniform convergence of all the weighted
derivatives. -/
instance (m n r s : ℕ) (d : Fin s → ℕ) : TopologicalSpace (ElemSchwartz m n r s d) :=
  TopologicalSpace.induced
    (fun (g : ElemSchwartz m n r s d) (p : ℕ × ℕ × ℕ) =>
      UniformFun.ofFun
        (fun q : (Fin r → ℤ) × ((i : Fin s) → ZMod (d i)) × ((Fin m → ℝ) × (Fin n → ℝ)) =>
          (‖q.1‖ ^ p.2.1 * ‖q.2.2.1‖ ^ p.1) •
            iteratedFDeriv ℝ p.2.2 (elemLift g.toFun q.1 q.2.1) q.2.2))
    inferInstance

/-! ### Structural pairs -/

section group

variable {G : Type u} [CommGroup G] [TopologicalSpace G]

/-- Definition D.1.4.1, for a subgroup `H` of `G` with the induced topology: `H` is compactly
generated if it is generated by a compact neighbourhood of the identity of `H`. -/
def IsCompactlyGeneratedSubgroup (H : Subgroup G) : Prop :=
  ∃ U : Set G, IsCompact U ∧ U ⊆ H ∧ (∃ V ∈ 𝓝 (1 : G), V ∩ H ⊆ U) ∧ Subgroup.closure U = H

/-- Definition D.1.4.5: the annihilator `k^⊥ = {χ ∈ Ĝ : χ(k) = 1}` of a subgroup `k` in the
Pontryagin dual of `G`. -/
def annihilator (k : Subgroup G) : Set (PontryaginDual G) := {χ | ∀ x ∈ k, χ x = 1}

/-- Definition D.1.5.1(1): a closed subgroup `k` of `G` is *good* if its annihilator `k^⊥` in the
dual group is open and compactly generated. -/
def IsGoodSubgroup [IsTopologicalGroup G] (k : Subgroup G) : Prop :=
  IsClosed (k : Set G) ∧ IsOpen (annihilator k) ∧
    ∃ A : Subgroup (PontryaginDual G), (A : Set (PontryaginDual G)) = annihilator k ∧
      IsCompactlyGeneratedSubgroup A

/-- Definition D.1.5.1(2): the pair `(Γ, k)` is *structural* if `Γ` is an open compactly generated
subgroup of `G`, `k` is a good subgroup of `G`, and `k ⊆ Γ`. -/
def IsStructuralPair [IsTopologicalGroup G] (Γ k : Subgroup G) : Prop :=
  IsOpen (Γ : Set G) ∧ IsCompactlyGeneratedSubgroup Γ ∧ IsGoodSubgroup k ∧ k ≤ Γ

/-- A presentation of `Γ/k` as an elementary abelian Lie group (D.1.5.3): a continuous open
surjective homomorphism `π : Γ → ℝ^m × 𝕋^n × ℤ^r × F` with kernel `k`; it induces an isomorphism
`ϕ₀ : Γ/k → ℝ^m × 𝕋^n × ℤ^r × F` of topological groups. -/
def IsElemPresentation {m n r s : ℕ} {d : Fin s → ℕ} (Γ k : Subgroup G)
    (π : Γ →* Multiplicative (ElemGroup m n r s d)) : Prop :=
  (∀ i, d i ≠ 0) ∧ Continuous π ∧ IsOpenMap π ∧ Function.Surjective π ∧
    ∀ x : Γ, π x = 1 ↔ (x : G) ∈ k

open Classical in
/-- The function on `G` supported in `Γ` that is the pull-back of `g` along `π : Γ → Γ/k`. -/
def extendPullback {m n r s : ℕ} {d : Fin s → ℕ} (Γ : Subgroup G)
    (π : Γ →* Multiplicative (ElemGroup m n r s d)) (g : ElemGroup m n r s d → ℂ) : G → ℂ :=
  fun x => if h : x ∈ Γ then g (Multiplicative.toAdd (π ⟨x, h⟩)) else 0

variable (G) [IsTopologicalGroup G]

/-- The space of Schwartz–Bruhat functions on `G` (Definition D.1.5.3(2)): the functions
supported in `Γ` and `k`-invariant, for some structural pair `(Γ, k)`, whose induced function on
the elementary abelian Lie group `Γ/k` is smooth of rapid decay; `S(G) = ⋃ S(k, Γ)`. -/
def schwartzBruhatSubmodule : Submodule ℂ (G → ℂ) :=
  Submodule.span ℂ {f | ∃ (Γ k : Subgroup G) (m n r s : ℕ) (d : Fin s → ℕ)
    (π : Γ →* Multiplicative (ElemGroup m n r s d)) (g : ElemSchwartz m n r s d),
    IsStructuralPair Γ k ∧ IsElemPresentation Γ k π ∧ f = extendPullback Γ π g.toFun}

/-- The Schwartz–Bruhat space `S(G)` of a Hausdorff locally compact abelian group `G`. -/
def SchwartzBruhat : Type u := ↥(schwartzBruhatSubmodule G)

instance : AddCommGroup (SchwartzBruhat G) :=
  inferInstanceAs (AddCommGroup ↥(schwartzBruhatSubmodule G))

instance : Module ℂ (SchwartzBruhat G) :=
  inferInstanceAs (Module ℂ ↥(schwartzBruhatSubmodule G))

variable {G}

/-- The underlying function of a Schwartz–Bruhat function. -/
def SchwartzBruhat.toFun (f : SchwartzBruhat G) : G → ℂ := f.1

instance : CoeFun (SchwartzBruhat G) (fun _ => G → ℂ) := ⟨SchwartzBruhat.toFun⟩

/-- The inclusion `S(k, Γ) = S(Γ/k) → S(G)` attached to a structural pair `(Γ, k)` and a
presentation `π` of `Γ/k`. -/
def SchwartzBruhat.ofElem {m n r s : ℕ} {d : Fin s → ℕ} (Γ k : Subgroup G)
    (π : Γ →* Multiplicative (ElemGroup m n r s d)) (hs : IsStructuralPair Γ k)
    (hπ : IsElemPresentation Γ k π) (g : ElemSchwartz m n r s d) : SchwartzBruhat G :=
  ⟨extendPullback Γ π g.toFun, Submodule.subset_span ⟨Γ, k, m, n, r, s, d, π, g, hs, hπ, rfl⟩⟩

variable (G)

/-- The topology of `S(G)` (D.1.5.4): the locally convex inductive limit topology of the spaces
`S(k, Γ)`, i.e. the finest locally convex topology for which all the inclusions
`S(Γ/k) → S(G)` are continuous. -/
instance : TopologicalSpace (SchwartzBruhat G) :=
  sInf {t | IsLocallyConvexTopology (SchwartzBruhat G) t ∧
    ∀ (Γ k : Subgroup G) (m n r s : ℕ) (d : Fin s → ℕ)
      (π : Γ →* Multiplicative (ElemGroup m n r s d)) (hs : IsStructuralPair Γ k)
      (hπ : IsElemPresentation Γ k π),
      @Continuous (ElemSchwartz m n r s d) (SchwartzBruhat G) _ t
        (SchwartzBruhat.ofElem Γ k π hs hπ)}

end group

end

end MasulloGRH


