-- Source module: Solutions.J6SegILSrc5
/-!
# B-line IL, source-table producers, part 5: `ljP` assembled

`ljP iS iT iL iW` is a plain `RS` program (no `mulC` calls).

**Inputs** (tops of the named stacks, which must be `Free`, i.e. `< 56` and not one of
`13, 14, 15, 30, 31, 32, 33, 43, 44`): `s` on `iS`, `t` on `iT`, `λ` on `iL`, `w` on `iW`;
`0 < s`, `0 < λ`, and `s, t, λ, w ≤ 2^A` with `2 ≤ A`.

**Outputs** (prepended, head = index 0):
* `30`: `LJ = Jlist (mkBlocks s t λ w)` (`= J6Seg.LJ s t λ w`), increasing;
* `31`: `|LJ|`;
* `32`: `STL = (range s).map (stF s t λ)`;
* `33`: `LNL = (range s).map (fun i => 1 + enF s t λ (stF s t λ i))`.

Scratch `14, 15, 43` is pushed and popped; every other stack is unchanged; nothing `≥ 56`
other than expression scratch is touched. Theorem `ljP_sp`, cost `ljCost s A`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT J6Seg

theorem ljL_zero {s t lam w : ℕ} : ljL s t lam w 0 = Jlist (mkBlocks s t lam w) := by
  simp only [ljL, drp_zero, Jlist, mkBlocks]

theorem lnD_zero {s t lam : ℕ} : lnD s t lam 0 = LNL s t lam := by
  simp only [lnD, drp_zero, LNL, eB, Nat.add_sub_cancel_left]

theorem stD_zero {s t lam : ℕ} : stD s t lam 0 = STL s t lam := by
  simp only [stD, drp_zero, STL]

/-- **`ljP`**, on any state. -/
theorem ljP_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {iS iT iL iW : Fin HS} (fS : Free iS)
    (fT : Free iT) (fL : Free iL) (fW : Free iW) {s t lam w A : ℕ} {LS LT LL LW : List ℤ}
    (hGS : F iS = (s : ℤ) :: LS) (hGT : F iT = (t : ℤ) :: LT) (hGL : F iL = (lam : ℤ) :: LL)
    (hGW : F iW = (w : ℤ) :: LW) (hs : 0 < s) (hl : 0 < lam)
    (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A) (hlA : lam ≤ 2 ^ A) (hwA : w ≤ 2 ^ A) (hA : 2 ≤ A) :
    Sp (ljP iS iT iL iW) (encK s0 F) (encK s0 (ljOut F s t lam w)) (ljCost s A) := by
  have n43 : ∀ {i : Fin HS}, Free i → i ≠ 43 := fun h => h.2.2.2.2.2.2.2.2.1
  rw [encK_rebase s0 F 43, encK_rebase s0 (ljOut F s t lam w) 43]
  have h43 : ljOut F s t lam w 43 = F 43 := by simp [ljOut, update_apply]
  rw [h43]
  set G' := update F 43 [] with hG'
  have H := ljP_sp0 (encK s0 (update (fun _ => []) 43 (F 43))) G' fS fT fL fW
    (by rw [hG', update_of_ne (n43 fS)]; exact hGS) (by rw [hG', update_of_ne (n43 fT)]; exact hGT)
    (by rw [hG', update_of_ne (n43 fL)]; exact hGL) (by rw [hG', update_of_ne (n43 fW)]; exact hGW)
    (by simp [hG']) hs hl hsA htA hlA hwA hA
  simp only [ljD, ljL_zero, stD_zero, lnD_zero] at H
  have E : update (ljOut F s t lam w) 43 [] = bS G' (G' 13) (G' 14) (G' 15)
      ((Jlist (mkBlocks s t lam w)).map (fun j => (j : ℤ)) ++ G' 30)
      (((Jlist (mkBlocks s t lam w)).length : ℤ) :: G' 31) (STL s t lam ++ G' 32)
      (LNL s t lam ++ G' 33) [] (G' 44) := by
    funext x
    by_cases h30 : x = 30
    · subst h30; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h31 : x = 31
    · subst h31; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h32 : x = 32
    · subst h32; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h33 : x = 33
    · subst h33; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h43 : x = 43
    · subst h43; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h13 : x = 13
    · subst h13; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h14 : x = 14
    · subst h14; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h15 : x = 15
    · subst h15; simp +decide [hG', bS, ljOut, update_apply]
    by_cases h44 : x = 44
    · subst h44; simp +decide [hG', bS, ljOut, update_apply]
    simp [hG', bS, ljOut, update_apply, h30, h31, h32, h33, h43, h13, h14, h15, h44]
  rw [E]; exact H

end J6Seg.Src

end

theorem solution : type_of% @J6Seg.Src.ljP_sp_sol_aux := @J6Seg.Src.ljP_sp_sol_aux
