section Chart

variable {k : Type u} [Field k]

variable {P : Scheme.{u}} (c : A1 k ⟶ P) [IsOpenImmersion c]

theorem exists_g_chart [Infinite k] (a : k) (U₀ : P.Opens) (hU₀ : ((U₀ : Set P)ᶜ).Finite) :
    ∃ g₀ : k[X], g₀.eval a ≠ 0 ∧ ∀ v : (chEt c (locF (B := CommRingCat.of k[X]) g₀)).left,
      (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v ∈ U₀ ∨
        (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v = c (A1pt k a) := by
  let F : Set (A1 k) := {y | c y ∉ U₀ ∧ c y ≠ c (A1pt k a)}
  have hpre : (c ⁻¹' (U₀ : Set P)ᶜ).Finite := hU₀.preimage c.isOpenEmbedding.injective.injOn
  have hFfin : F.Finite := hpre.subset fun y hy => hy.1
  have hbot : ∀ y ∈ F, y.asIdeal ≠ ⊥ := by
    intro y hy hy0
    have hall : ∀ v : A1 k, c v ∉ U₀ := fun v => by
      have hsp : y ⤳ v := (PrimeSpectrum.le_iff_specializes y v).mp (by
        show y.asIdeal ≤ v.asIdeal
        rw [hy0]; exact bot_le)
      exact (hsp.map c.continuous).mem_closed U₀.isOpen.isClosed_compl hy.1
    have hfin : (Set.univ : Set (A1 k)).Finite := hpre.subset fun v _ => hall v
    have : Infinite (A1 k) := Infinite.of_injective (A1pt k) A1pt_injective
    exact Set.infinite_univ hfin
  have ha : ∀ y ∈ F, y.asIdeal ≠ Ideal.span {X - C a} := fun y hy h =>
    hy.2 (congrArg c (PrimeSpectrum.ext h : y = A1pt k a))
  obtain ⟨g₀, hg₀a, hg₀⟩ := exists_g_of_finite a F hFfin hbot ha
  refine ⟨g₀, hg₀a, fun v => ?_⟩
  have hgw : g₀ ∉ (Spec.map (locF (B := CommRingCat.of k[X]) g₀) v).asIdeal := by
    have h : Spec.map (locF (B := CommRingCat.of k[X]) g₀) v ∈
        Set.range (PrimeSpectrum.comap (algebraMap (CommRingCat.of k[X]) (Localization.Away g₀))) := ⟨v, rfl⟩
    rw [PrimeSpectrum.localization_away_comap_range (Localization.Away g₀) g₀] at h
    exact h
  by_cases h1 : (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v ∈ U₀
  · exact Or.inl h1
  by_cases h2 : (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v = c (A1pt k a)
  · exact Or.inr h2
  exact absurd (hg₀ (Spec.map (locF (B := CommRingCat.of k[X]) g₀) v) ⟨h1, h2⟩) hgw

end Chart

