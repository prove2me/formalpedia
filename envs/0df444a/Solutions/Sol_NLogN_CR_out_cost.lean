    (rep kC2 (.reg kKR) NLogN.CR.axBody).run t1 = innerSt t1 s k Rst (t1.G kRB) LP s.length := by
  have H := NLogN.CR.inner_states t1 s hs k Rst LK LP hK hA hP
  have e : (Ex.reg (S := HS) kKR).eval t1 = s.length := by simp [Ex.eval, IState.top_eq hK]
  refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of hK) ?_, ?_⟩
  · intro m hm
    rw [e, Int.toNat_natCast] at hm ⊢
    exact (inner_step t1 s hs k Rst _ _ _ m hm).1
  · rw [H.run, e, Int.toNat_natCast]

end NLogN.CR

