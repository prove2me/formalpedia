theorem solution :
    ∃ Kc : ℝ, 0 < Kc ∧
      ∀ (K ρ f : ℕ), 6 ≤ K → ρ < K → 1 ≤ f →
      ∀ (g : NLogN.KFL.Geo), g.Pos → g.Q = 2 ^ (f * K) →
      ∀ (I : List NLogN.Sym) (iprog : Fin 1 → NLogN.IStmt NLogN.HS 1) (t : NLogN.IState NLogN.HS) (zs : List ℤ) (R : List NLogN.Item),
      NLogN.KFL.Bits zs → t.G 0 = NLogN.ints zs ++ R → zs.length = g.V →
      ∃ c : ℕ, NLogN.IRuns I iprog (NLogN.KFL.corrI K ρ f g) t
          (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.corrc K ρ f) zs) ++ R)) c ∧
        (c : ℝ) ≤ Kc * (((g.V / g.B : ℕ) : ℝ) * ((NLogN.zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
          min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * ((g.V / g.B : ℕ) : ℝ) *
            ((NLogN.zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (NLogN.zsz (g.V : ℤ) : ℝ) + 1)) := by
  refine ⟨10 ^ 13 * 125, by norm_num, ?_⟩
  intro K ρ f hK hρK hf g hg hQe I iprog t zs R hz h0 hl
  set M := g.recG.V with hMdef
  set A := NLogN.zsz (g.V : ℤ) with hAdef
  set nB := NLogN.KFL.nMv (NLogN.KFL.keyR K ρ f g) M with hnB
  have hl' : zs.length = M * g.B := by rw [hl, NLogN.KFL.Geo.V_rec]
  have hlen := NLogN.KFL.length_chunk hl'
  have hfl := NLogN.KFL.flR_chunk hg.b hl'
  have S := NLogN.KFL.corrRS_fsp (by omega) hρK hf hg hQe (NLogN.KFL.chunk g.B M zs) hlen (NLogN.KFL.bnd_chunk hz) (t.upd 0 R)
  rw [hfl] at S
  have e0 : NLogN.KIL.encK (t.upd 0 R) (Function.update (fun _ => []) 0 zs) = t := by
    rw [← NLogN.KIL.encK_upd, NLogN.KIL.encK_nil, NLogN.IState.upd_G, if_pos rfl, NLogN.IState.upd_upd_same, ← h0,
      NLogN.IState.upd_self]
  have e1 : NLogN.KFL.flR (fun d => NLogN.KFL.chunk g.B M zs (NLogN.KFL.corrR K ρ f g d)) M = NLogN.KFL.rixT g (NLogN.KFL.corrc K ρ f) zs := by
    conv_rhs => rw [← hfl]
    rw [NLogN.KFL.rixT_flR hg (NLogN.KFL.TV_corrc' hg hQe) hlen]; rfl
  have e2 : NLogN.KIL.encK (t.upd 0 R) (Function.update (fun _ => []) 0
      (NLogN.KFL.flR (fun d => NLogN.KFL.chunk g.B M zs (NLogN.KFL.corrR K ρ f g d)) M)) =
      t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.corrc K ρ f) zs) ++ R) := by
    rw [e1, ← NLogN.KIL.encK_upd, NLogN.KIL.encK_nil, NLogN.IState.upd_G, if_pos rfl, NLogN.IState.upd_upd_same]
  rw [e0, e2] at S
  refine ⟨_, NLogN.KFD.FSp.irun (NLogN.KFL.fok_corrRS K ρ f g _) S, ?_⟩
  -- the cost
  have hM1 : 1 ≤ M := hg.recG.v
  have hfA := NLogN.KFL.f_lt_zsz (by omega) hg hQe
  have hc := NLogN.KFL.cCorr_le K f g A nB (A + 3) (by omega) (by omega) hM1
  have hcount := NLogN.KFL.card_moved hK hρK hf hg hQe
  have hnBM : nB ≤ M := NLogN.KFL.nMv_le _ _
  rw [NLogN.KFL.V_div_B hg]
  have hV : (g.V : ℝ) = (M : ℝ) * g.B := by rw [NLogN.KFL.Geo.V_rec]; push_cast; ring
  rw [hV]
  have hcR : (NLogN.KFL.cCorr K f g A nB (A + 3) : ℝ) ≤ 10 ^ 13 * ((M : ℝ) * ((A : ℝ) + 5) ^ 3 +
      (M : ℝ) * g.B + (A : ℝ) * nB * (g.B + A + 5)) := by
    have := (Nat.cast_le (α := ℝ)).2 hc
    push_cast at this
    refine this.trans (le_of_eq ?_); ring
  -- `nB ≤ δ M`
  set δ := min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K)
  have hδ : (nB : ℝ) ≤ δ * M := by
    rw [min_mul_of_nonneg _ _ (Nat.cast_nonneg _)]
    refine le_min (by rw [one_mul]; exact_mod_cast hnBM) ?_
    have h := (Nat.cast_le (α := ℝ)).2 hcount
    push_cast [Nat.cast_sub hf] at h
    have h2 : (0 : ℝ) < 2 ^ K := by positivity
    rw [inv_pow, show 80 * ((f : ℝ) - 1) * ((2 : ℝ) ^ K)⁻¹ * M = 80 * ((f : ℝ) - 1) * M / 2 ^ K
      by ring, le_div_iff₀ h2]
    exact h
  have hA0 : (0 : ℝ) ≤ A := Nat.cast_nonneg _
  have hB0 : (0 : ℝ) ≤ g.B := Nat.cast_nonneg _
  have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg _
  have hnB0 : (0 : ℝ) ≤ nB := Nat.cast_nonneg _
  have hδ0 : 0 ≤ δ * M := hnB0.trans hδ
  have k1 : ((A : ℝ) + 5) ^ 3 ≤ 125 * ((A : ℝ) + 1) ^ 3 := by nlinarith [sq_nonneg ((A : ℝ) + 1)]
  have k2 : (A : ℝ) * nB * (g.B + A + 5) ≤ 5 * (δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by
    have : (A : ℝ) * (g.B + A + 5) ≤ 5 * (((A : ℝ) + 1) * (g.B + A + 1)) := by nlinarith
    calc (A : ℝ) * nB * (g.B + A + 5) = nB * ((A : ℝ) * (g.B + A + 5)) := by ring
      _ ≤ (δ * M) * (5 * (((A : ℝ) + 1) * (g.B + A + 1))) :=
          mul_le_mul hδ this (by positivity) hδ0
      _ = 5 * (δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by ring
  have k3 : (M : ℝ) * ((A : ℝ) + 5) ^ 3 ≤ 125 * ((M : ℝ) * ((A : ℝ) + 1) ^ 3) := by
    nlinarith [mul_le_mul_of_nonneg_left k1 hM0]
  have hMB : (0 : ℝ) ≤ M * g.B := by positivity
  have hX : (0 : ℝ) ≤ (M : ℝ) * ((A : ℝ) + 1) ^ 3 := by positivity
  have hY : (0 : ℝ) ≤ δ * M * ((A : ℝ) + 1) * (g.B + A + 1) := by
    have : (0:ℝ) ≤ ((A : ℝ) + 1) * (g.B + A + 1) := by positivity
    nlinarith
  calc (NLogN.KFL.cCorr K f g A nB (A + 3) : ℝ) ≤ _ := hcR
    _ ≤ 10 ^ 13 * 125 * ((M : ℝ) * ((A : ℝ) + 1) ^ 3 + M * g.B +
          δ * M * ((A : ℝ) + 1) * (g.B + A + 1)) := by nlinarith
end
