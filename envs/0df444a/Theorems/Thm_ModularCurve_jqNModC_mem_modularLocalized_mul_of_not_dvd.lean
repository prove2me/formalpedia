theorem ModularCurve.jqNModC_mem_modularLocalized_mul_of_not_dvd
    {q : ℕ} [Fact q.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)} (hA : A.LiesOverPrime q)
    {N : ℕ} [NeZero N] (hqN : ¬ q ∣ N) :
    jqNModC (AlgebraicClosure ℚ) N
      ∈ CharPReduction.modularLocalized (N * q) A.toSubring (IsLocalRing.residue A) := by sorry
