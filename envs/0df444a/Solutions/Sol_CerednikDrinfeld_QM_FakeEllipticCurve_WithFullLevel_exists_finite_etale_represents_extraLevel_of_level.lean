variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {N : ℕ} [NeZero N]
  {T : Type} [CommRing T] (E' : FakeEllipticCurve Λ N₀ T) (hNT : IsUnit ((N : ℕ) : T))
  [IsFinite (E'.L.schemeKerStr N)] [Etale (E'.L.schemeKerStr N)]

theorem pushPt_eq_mapPt (x : ↥Λ) {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f) :
    CerednikDrinfeld.QM.pushPt (E'.act x) (E'.act_over x) P = CerednikDrinfeld.QM.mapPt (E'.act x) (E'.act_over x) P :=
  Subtype.ext rfl

include hNT in
theorem natCast_ne_zero_of_field (k : Type) [Field k] (sk : T →+* k) : ((N : ℕ) : k) ≠ 0 := by
  have := hNT.map sk
  rw [map_natCast] at this
  exact this.ne_zero

include hNT in

theorem adm_of_extraLevel (s : Finset ↥Λ) (hM : IsUnit ((N * N₀ : ℕ) : T)) (K : E'.ExtraLevel N) (U' : (E'.L.schemeKer N).Opens)
    (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N)))
    (hrank : ∀ t : ↥(Spec (CommRingCat.of T)), (U'.ι ≫ E'.L.schemeKerStr N).finrank t = N ^ 2)
    (hpts : ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough K.levK P ↔ CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P)
    (t : ↥(Spec (CommRingCat.of T))) : t ∈ admOf (N := N) E' s U' (VC (N := N) E' hM) := by
  have hsub : ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P Q : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P →
      CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) Q →
        CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) (E'.L.mul t P Q) ∧
        CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) (E'.L.inv t P) := by
    intro TT t P Q hP hQ
    have h := K.levK_sub t P Q ((hpts t P).mpr hP) ((hpts t Q).mpr hQ)
    exact ⟨(hpts t _).mp h.1, (hpts t _).mp h.2⟩
  have hone : ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)),
      CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) (E'.L.one t) :=
    fun t => (hpts t _).mp (K.levK_one t)
  obtain ⟨h1, h2, h3⟩ := Bridge.loci_of_sub E'.L E'.comm N U' hsub hone
  rw [mem_admOf]
  refine ⟨h1 t, h2 t, h3 t, ?_, hrank t, ?_, ?_⟩
  · intro x _
    refine (Bridge.locEnd_iff E'.L N U' (E'.act x) (E'.act_over x) (isHomPt_act E' x)).mpr ?_ t
    intro TT t P hP
    rw [← pushPt_eq_mapPt]
    exact (hpts t _).mp (K.levK_stable x t P ((hpts t P).mpr hP))
  · intro d hd
    obtain ⟨k, _, _, sk, hsk⟩ := exists_geomPoint (S := T) t
    obtain ⟨e, he⟩ := K.levK_fibre k sk (natCast_ne_zero_of_field (N := N) hNT k sk)
    let e' : ZMod N × ZMod N ≃ {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) E'.f //
        CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P} :=
      e.trans (Equiv.subtypeEquivRight (fun P => hpts _ P))
    have he' : ∀ x y : ZMod N × ZMod N, (e' (x + y)).1 = E'.L.mul _ (e' x).1 (e' y).1 := fun x y => he x y
    show ((U' ⊓ Td E'.L E'.comm N d).ι ≫ E'.L.schemeKerStr N).finrank t = d ^ 2
    rw [← hsk]
    exact ranks_of_fibre E'.L E'.comm N U' hU' k sk e' he' d (Nat.dvd_of_mem_divisors hd)
  ·
    exact locDisj_of_disj (N := N) E' hM U' (fun t P hP hC => K.levK_disjoint t P ((hpts t P).mpr hP) hC) t

include hNT in

theorem extraLevel_of_adm (s : Finset ↥Λ) (hM : IsUnit ((N * N₀ : ℕ) : T)) (hs : Submodule.span ℤ (s : Set ↥Λ) = ⊤)
    (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N)))
    (hadm : ∀ t : ↥(Spec (CommRingCat.of T)), t ∈ admOf (N := N) E' s U' (VC (N := N) E' hM)) :
    ∃ K : E'.ExtraLevel N, ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough K.levK P ↔ CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P := by
  have H := fun t => (mem_admOf (N := N) E' s U' _ t).mp (hadm t)

  have hdisj : ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P →
        CerednikDrinfeld.QM.FactorsThrough E'.lev P → P = E'.L.one t :=
    fun t P hP hC => disj_of_locDisj (N := N) E' hM U' (fun t => (H t).2.2.2.2.2.2) t P hP hC
  obtain ⟨hsub, hone⟩ := Bridge.sub_of_loci E'.L E'.comm N U' (fun t => (H t).1) (fun t => (H t).2.1)
    (fun t => (H t).2.2.1)
  have hstab_gen : ∀ x ∈ (s : Set ↥Λ), ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P →
        CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N)
          (CerednikDrinfeld.QM.pushPt (E'.act x) (E'.act_over x) P) := by
    intro x hx TT t P hP
    rw [pushPt_eq_mapPt]
    exact (Bridge.locEnd_iff E'.L N U' (E'.act x) (E'.act_over x) (isHomPt_act E' x)).mp
      (fun t => (H t).2.2.2.1 x hx) t P hP
  have hstab := act_stable_of_span E' (fun t P => CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P)
    (fun t P Q hP hQ => (hsub t P Q hP hQ).1) (fun t P hP => (hsub t P P hP hP).2) hone (s : Set ↥Λ) hs hstab_gen
  have hrank : ∀ t : ↥(Spec (CommRingCat.of T)), (U'.ι ≫ E'.L.schemeKerStr N).finrank t = N ^ 2 :=
    fun t => (H t).2.2.2.2.1
  have hfib : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : T →+* k), ((N : ℕ) : k) ≠ 0 →
      ∃ e : ZMod N × ZMod N ≃
          {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) E'.f //
            CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P},
        ∀ x y : ZMod N × ZMod N, (e (x + y) : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) E'.f) =
          E'.L.mul (CerednikDrinfeld.QM.geomPoint k sk) (e x) (e y) := by
    intro k _ _ sk _
    exact fibre_of_ranks E'.L E'.comm N U' hU' k sk hsub hone
      (fun d hd => (H (Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k))).2.2.2.2.2.1 d hd)
  exact CerednikDrinfeld.QM.FakeEllipticCurve.exists_extraLevel_forall_factorsThrough_iff_of_opens_schemeKer_of_level E' N hNT U' hU'
    hsub hone hstab hdisj hrank hfib

end AdmIff
