-- title:
--   Support reduction, prefix moments and guarded quadratic scan
-- statement:
--   One fixed program accepts $n$, arrays of real coordinates $q,v$ indexed by $\{0,\ldots,n-1\}$, and a real radius $t$. Its charged execution reads the coordinates, retains positive weights and original indices, sorts the retained value-weight pairs by comparisons, and computes every prefix first and second moment and remaining mass in one pass.
--
--   Each distinct adjacent-value interval is scanned using its stored three moments. Every endpoint is evaluated. Quadratic and linear coefficients are computed by scalar operations, roots are generated by guarded explicit formulas, and only roots strictly inside the interval are considered. Identically zero and nonzero constant polynomials generate no interior candidates; endpoint evaluation remains in force. Equal endpoints, singleton support, zero radius and the final zero-suffix-mass cell have explicit branches. The best actual score is retained, including the threshold attaining it.
--
--   Finally the program writes all $n$ coordinates of $\mu(s)=\max(v(s)-\alpha,0)$ in the original input order. The output and the count come from the same recursive execution. Candidate scores never rescan the input vector. The default for an empty scan is raw-input totalization only: a normalized nonnegative centre has nonempty positive support.
--
--   This operational layer is the concrete algorithm whose correctness and uniform sorting-time bound are the full goal. It contains no optimum selector, infinite search, root oracle, or supplied correctness assumption.
-- source:
--   G. Iyengar, Robust dynamic programming, CORC Tech Report TR-2002-07, revised May 4, 2004, p. 19, Section 4.2, (53), corrected (54), and sorting-time conclusion

import Mathlib
import Definitions.Def_RobustDP_ChiSquareAudit_Model
import Definitions.Def_RobustDP_ChiSquareAudit_Machine

namespace RobustDP.ChiSquareAudit

/-- Input coordinates are read exactly once by this pass. Indices are zero-based.
The original index is retained with each pair throughout sorting. -/
noncomputable def supportPass {n : ℕ} (q v : Fin n → ℝ) :
    (m : ℕ) → m ≤ n → Run (List Row)
  | 0, _ => ⟨[], 2⟩
  | m + 1, h => do
    overhead 10
    let rows ← supportPass q v m (by omega)
    let w ← inputRead q ⟨m, by omega⟩
    let x ← inputRead v ⟨m, by omega⟩
    let positive ← rlt 0 w
    if positive then pure (⟨x, w, m⟩ :: rows) else pure rows

/-- Prefix first/second moments and the remaining mass, in one forward pass.
Initial mass 1 is the simplex normalization, not an estimated quantity. -/
noncomputable def prefixPass : List Row → ℝ → ℝ → ℝ → Run (List Cell)
  | [], _, _, _ => ⟨[], 2⟩
  | x :: xs, a, b, c => do
    overhead 14
    let qv ← rmul x.q x.v
    let a' ← radd a qv
    let b' ← rsub b x.q
    let vv ← rmul x.v x.v
    let qvv ← rmul x.q vv
    let c' ← radd c qvv
    let tail ← prefixPass xs a' b' c'
    let high := match xs with | [] => none | y :: _ => some y.v
    pure (⟨x.v, high, a', b', c'⟩ :: tail)

/-- Evaluation uses only the stored three scalars, never a vector rescan. -/
noncomputable def score (t : ℝ) (cell : Cell) (α : ℝ) : Run ℝ := do
  overhead 8
  let bx ← rmul cell.b α
  let mean ← radd cell.a bx
  let xx ← rmul α α
  let bxx ← rmul cell.b xx
  let second ← radd cell.c bxx
  let mm ← rmul mean mean
  let variance ← rsub second mm
  let tv ← rmul t variance
  let penalty ← rsqrt tv
  rsub mean penalty

/-- Coefficients of b² Q(x) - t b² ((1-b)x-a)², with multiplication
used for every square. No polynomial root oracle occurs. -/
noncomputable def coefficients (t : ℝ) (cell : Cell) : Run (ℝ × ℝ × ℝ) := do
  overhead 8
  let z ← rsub 1 cell.b
  let bb ← rmul cell.b cell.b
  let aa ← rmul cell.a cell.a
  let zz ← rmul z z
  let tzz ← rmul t zz
  let u ← rsub cell.b bb
  let u ← rsub u tzz
  let A ← rmul bb u
  let ab ← rmul cell.a cell.b
  let twoab ← rmul 2 ab
  let za ← rmul z cell.a
  let tza ← rmul t za
  let twotza ← rmul 2 tza
  let u ← rsub twotza twoab
  let B ← rmul bb u
  let taa ← rmul t aa
  let u ← rsub cell.c aa
  let u ← rsub u taa
  let D ← rmul bb u
  pure (A, B, D)

/-- Guarded quadratic and linear formulas; constant polynomials return no roots.
An identically zero polynomial is handled by the separately tested endpoints. -/
noncomputable def quadraticRoots (A B D : ℝ) : Run (List ℝ) := do
  overhead 8
  let az ← req A 0
  if az then
    let bz ← req B 0
    if bz then pure []
    else
      let minusD ← rsub 0 D
      let x ← rdiv minusD B
      pure [x]
  else
    let bb ← rmul B B
    let ad ← rmul A D
    let fourad ← rmul 4 ad
    let disc ← rsub bb fourad
    let negative ← rlt disc 0
    if negative then pure []
    else
      let root ← rsqrt disc
      let denom ← rmul 2 A
      let minusB ← rsub 0 B
      let plus ← radd minusB root
      let minus ← rsub minusB root
      let x ← rdiv plus denom
      let y ← rdiv minus denom
      pure [x, y]

noncomputable def consider (t : ℝ) (cell : Cell) (α : ℝ)
    (best : Option Best) : Run (Option Best) := do
  overhead 6
  let val ← score t cell α
  match best with
  | none => pure (some ⟨α, val⟩)
  | some old =>
    let better ← rlt old.val val
    pure (if better then some ⟨α, val⟩ else best)

/-- The list has at most two elements when called by `scanCell`. -/
noncomputable def considerRoots (t : ℝ) (cell : Cell) (high : ℝ) :
    List ℝ → Option Best → Run (Option Best)
  | [], best => ⟨best, 2⟩
  | x :: xs, best => do
    overhead 8
    let above ← rlt cell.low x
    let below ← rlt x high
    let best ← if above && below then consider t cell x best else pure best
    considerRoots t cell high xs best

noncomputable def scanCell (t : ℝ) (cell : Cell) (best : Option Best) :
    Run (Option Best) := do
  overhead 6
  let best ← consider t cell cell.low best
  match cell.high with
  | none => pure best
  | some high =>
    let nonempty ← rlt cell.low high
    if nonempty then
      let p ← coefficients t cell
      let roots ← quadraticRoots p.1 p.2.1 p.2.2
      considerRoots t cell high roots best
    else pure best

noncomputable def scanPass (t : ℝ) : List Cell → Option Best → Run (Option Best)
  | [], best => ⟨best, 2⟩
  | c :: cs, best => do
    overhead 4
    let best ← scanCell t c best
    scanPass t cs best

/-- Output multipliers are explicitly materialized in original input order.
Array append is charged as a write; the abstract machine uses growable arrays. -/
noncomputable def outputPass {n : ℕ} (v : Fin n → ℝ) (α : ℝ) :
    (m : ℕ) → m ≤ n → Run (Array ℝ)
  | 0, _ => ⟨#[], 2⟩
  | m + 1, h => do
    overhead 10
    let out ← outputPass v α m (by omega)
    let x ← inputRead v ⟨m, by omega⟩
    let d ← rsub x α
    let positive ← rlt 0 d
    pure (out.push (if positive then d else 0))

/-- A single fixed exact-arithmetic program, defined for all raw inputs.
Fuel is the dimension, not a caller-supplied optimization witness. -/
noncomputable def solve (n : ℕ) (q : Fin n → ℝ) (t : ℝ) (v : Fin n → ℝ) :
    Run Answer := do
  overhead 10
  let rows ← supportPass q v n (by omega)
  let rows ← sortRows n rows
  let cells ← prefixPass rows 0 1 0
  let best ← scanPass t cells none
  let best := best.getD default
  let multiplier ← outputPass v best.alpha n (by omega)
  pure ⟨best, multiplier⟩

/-- Semantic interpretation of the already constructed output array. -/
def answerMultiplier {n : ℕ} (out : Answer) : Fin n → ℝ :=
  fun i => out.multiplier[i.val]?.getD 0

end RobustDP.ChiSquareAudit


