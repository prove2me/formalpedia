-- title:
--   Proposition 6.4.2 — the Farkas lemma geometrically
-- statement:
--   Let $a_1,\dots,a_n,b$ be vectors in $\mathbb{R}^m$ and let $C=\{t_1a_1+\dots+t_na_n: t_1,\dots,t_n\ge 0\}$ be the convex cone they generate. Then exactly one of the following occurs:
--
--   1. (F1') $b\in C$;
--   2. (F2') there is $y\in\mathbb{R}^m$ with
--   $$y^{T}a_i\ge 0 \ \text{ for all } i=1,\dots,n \qquad\text{and}\qquad y^{T}b<0,$$
--   that is, the hyperplane $h=\{x\in\mathbb{R}^m: y^{T}x=0\}$ through the origin has all of $a_1,\dots,a_n$ (and hence $C$) on one side and $b$ strictly on the other.
--
--   This is the separation-theorem reading of the Farkas lemma: a point outside a finitely generated cone can be separated from it by a hyperplane through the origin.
--
--   **Formalization Note** Points are elements of `EuclideanSpace ℝ (Fin m)` and $y^{T}x$ is the inner product `inner ℝ y x`. "Exactly one" is Lean's exclusive or `Xor`.
-- source:
--   Matoušek & Gärtner, Understanding and Using Linear Programming, Springer 2007, pp. 89–90, Proposition 6.4.2

import Mathlib
import Definitions.Def_MatousekLP_Duality_Cones

namespace MatousekLP.Duality

/-- Matoušek & Gärtner, Proposition 6.4.2 (pp. 89–90), the Farkas lemma geometrically: for
`a₁, …, aₙ, b ∈ ℝ^m` exactly one of (F1') `b` lies in the convex cone `C` generated by
`a₁, …, aₙ`, and (F2') there is `y ∈ ℝ^m` with `yᵀaᵢ ≥ 0` for all `i` and `yᵀb < 0` (the
hyperplane `{x : yᵀx = 0}` through `0` has `C` on one side and `b` strictly on the other). -/
theorem farkas_geometric {m n : ℕ} (a : Fin n → EuclideanSpace ℝ (Fin m))
    (b : EuclideanSpace ℝ (Fin m)) :
    Xor (b ∈ coneGen a)
      (∃ y : EuclideanSpace ℝ (Fin m), (∀ i, 0 ≤ inner ℝ y (a i)) ∧ inner ℝ y b < 0) := by sorry

end MatousekLP.Duality
