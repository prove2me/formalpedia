theorem NLogN.KFM.mc_err (p : ℕ) {Mr Mrt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} (hMr : BilC Mr) (Er : ℝ)
    (hMrt : ∀ a b, Grid p a → Grid p b → ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖Mrt a b - Mr a b‖ ≤ Er * hp p)
    {θ θt θi θit : ι → ℂ} (hθ : Phases p θ θt) (hθi : Phases p θi θit)
    {f g : ι → ℂ} (hf : ‖f‖ ≤ 1) (hg : ‖g‖ ≤ 7 / 10) (hE : Er * hp p ≤ 3 / 10) :
    ‖mcT p Mrt θt θit f g - θi * Mr (θ * f) (θ * g)‖ ≤ (Er + 12) * hp p ∧
      ‖mcT p Mrt θt θit f g‖ ≤ 7 / 10 + Er * hp p := by sorry
