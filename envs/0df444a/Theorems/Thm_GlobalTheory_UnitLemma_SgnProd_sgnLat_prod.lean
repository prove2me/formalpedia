theorem GlobalTheory.UnitLemma.SgnProd.sgnLat_prod : ∀ (K : UQ) (B₁ B₂ : InvAlg K), (B₁.P * B₂.P).Separable → ∀ M ∈ (B₁.prod B₂).Lin,
    (B₁.prod B₂).sgnLat M = K.eta (resultant B₁.P B₂.P) *
      B₁.sgnLat (M.comap (LinearMap.inl K.O B₁.A B₂.A)) * B₂.sgnLat (M.map (LinearMap.snd K.O B₁.A B₂.A)) := by sorry
