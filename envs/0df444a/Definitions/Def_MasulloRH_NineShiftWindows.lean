def thetaRow (j : ℤ) : Row :=
  if -48 ≤ j ∧ j < 24 then thetaData[(j+48).toNat]! else ⟨0,0,1⟩
def pulseRow (j : ℤ) : Row := pulseData[(j+96).toNat]!
def weightQ (j : ℤ) : ℚ := (weightData[(j+96).toNat]! : ℚ)/1000000
def weightCheck (j : ℤ) : Bool :=
  let u := grid (j+1)
  decide ((expPoint (max u (2*u))).2 ≤ weightQ j)
def net (j : ℤ) (v : Row → ℤ) : ℚ :=
  value (v (pulseRow j)) - ∑ i : Fin 9, coeff i * value (v (thetaRow (j-offset i)))
def rad (j : ℤ) : ℚ :=
  value (pulseRow j).e + ∑ i : Fin 9, coeff i * value (thetaRow (j-offset i)).e
def capQ (j : ℤ) : ℚ := max |net j Row.l| |net j Row.r| + rad j
def cellCost (j : ℤ) : ℚ := weightQ j*(capQ j)^2/16


