theorem reset_limit {safe : RAM.Memory K → Prop} {p : BitProgram} {m : RAM.Memory K}
    (h : safe m) (h' : safe (m.putIndex limitReg p.states)) :
    Block.Eval safe (.op (.addrConst limitReg p.states)) m 1 (m.putIndex limitReg p.states) :=
  .op h h' (fun _ => rfl)

