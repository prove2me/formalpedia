  induction h₁ with
  | refl => simpa using h₂
  | step h _ ih => rw [Nat.add_right_comm]; exact Steps.step h (ih h₂)

theorem Steps.one {I : List Sym} {code : ℕ → Instr S} {c c' : Cfg S}
