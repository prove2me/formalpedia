/-! ## Derivatives along the family -/

/-! ## The charge-drift combination `q₂` and `anchor_q` -/

/-- The `p'`-part of the charge drift: `e₂ = p₂' + v₁ b₁'`. -/
noncomputable def e2A (j : ℝ) (R : ℝ) : ℝ :=
  deriv (pA j) R + v1f j R * deriv (b1f j) R

/-- The next `p'`-part: `e₄ = v₁ c' + d b₁'`. -/
noncomputable def e4A (j : ℝ) (R : ℝ) : ℝ :=
  v1f j R * deriv (c3f j) R + d3f j R * deriv (b1f j) R

/-- The last `p'`-part: `e₆ = d c'`. -/
noncomputable def e6A (j : ℝ) (R : ℝ) : ℝ :=
  d3f j R * deriv (c3f j) R

/-- The physical charge-drift combination `q₂ = Q u + R² e₂`. -/
noncomputable def q2A (j : ℝ) (R : ℝ) : ℝ :=
  (3 / 2) * uA j R + R ^ 2 * e2A j R

/-! ## The `ε`-coefficients of the corrected, denominator-cleared `ell` expression -/

/-- The `ε`-linear coefficient of the corrected, denominator-cleared `ell` expression: `R³v₁' + 4Q b₁ + 2j`. -/
noncomputable def ellE1 (j : ℝ) (R : ℝ) : ℝ :=
  R ^ 3 * deriv (v1f j) R + 4 * (3 / 2) * b1f j R + 2 * j

/-- The `ε³` coefficient of the corrected, denominator-cleared `ell` expression, before eliminating `q₂`. -/
noncomputable def ellE3 (j : ℝ) (R : ℝ) : ℝ :=
  R ^ 3 * deriv (d3f j) R + 4 * (3 / 2) * c3f j R
    - 4 * R ^ 2 * e2A j R * b1f j R + 4 * (3 / 2) * zA j R * b1f j R
    + 2 * j * (uA j R + zA j R)

/-- The `ε⁵` coefficient of the corrected, denominator-cleared `ell` expression. -/
noncomputable def ellE5 (j : ℝ) (R : ℝ) : ℝ :=
  - 4 * R ^ 2 * ((e2A j R - (3 / 2) * zA j R / R ^ 2) * c3f j R
      + (e4A j R + zA j R * e2A j R) * b1f j R)
    + 2 * j * uA j R * zA j R

/-- The `ε⁷` coefficient of the corrected, denominator-cleared `ell` expression. -/
noncomputable def ellE7 (j : ℝ) (R : ℝ) : ℝ :=
  - 4 * R ^ 2 * ((e4A j R + zA j R * e2A j R) * c3f j R
      + (e6A j R + zA j R * e4A j R) * b1f j R)

/-- The `ε⁹` coefficient of the corrected, denominator-cleared `ell` expression. -/
noncomputable def ellE9 (j : ℝ) (R : ℝ) : ℝ :=
  - 4 * R ^ 2 * ((e6A j R + zA j R * e4A j R) * c3f j R
      + zA j R * e6A j R * b1f j R)

/-- The `ε¹¹` coefficient of the corrected, denominator-cleared `ell` expression. -/
noncomputable def ellE11 (j : ℝ) (R : ℝ) : ℝ :=
  - 4 * R ^ 2 * (zA j R * e6A j R * c3f j R)

/-- The `ε`-polynomial of `ellFun + 2 * ε * j` after clearing the genuine denominators. -/
noncomputable def ellP (j : ℝ) (ε : ℝ) (R : ℝ) : ℝ :=
  ε * ellE1 j R + ε ^ 3 * ellE3 j R + ε ^ 5 * ellE5 j R + ε ^ 7 * ellE7 j R
    + ε ^ 9 * ellE9 j R + ε ^ 11 * ellE11 j R

