theorem mul_val_congr {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (e : t₁ = t₂)
    (P Q : SchemeHomOver t₁ f) (P' Q' : SchemeHomOver t₂ f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t₁ P Q).1 = (L.mul t₂ P' Q').1 := by
  subst e
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem isPullbackVia_id {T : Type} [CommRing T] (F : FakeEllipticCurve Λ N T) :
    FakeEllipticCurve.IsPullbackVia (RingHom.id T) F F (𝟙 F.A) := by
  have hid : Spec.map (CommRingCat.ofHom (RingHom.id T)) = 𝟙 _ := by rw [CommRingCat.ofHom_id, Spec.map_id]
  have sq : IsPullback (𝟙 F.A) F.f F.f (Spec.map (CommRingCat.ofHom (RingHom.id T))) := by
    rw [hid]; exact IsPullback.of_horiz_isIso ⟨by simp⟩
  refine ⟨sq, ?_, ?_, ?_⟩
  · intro T' t' P Q
    rw [Category.comp_id]
    exact mul_val_congr F.L (by rw [hid, Category.comp_id]) _ _ _ _ (by simp) (by simp)
  · intro x; simp
  · intro T' t' P hP; obtain ⟨P₀, h⟩ := hP; exact ⟨P₀, by rw [h, Category.comp_id]⟩

theorem equiv_pad (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) :
    FakeEllipticCurve.Rigidification.Equiv hΛℤ ρ (pad hΛℤ ρ i j) := by
