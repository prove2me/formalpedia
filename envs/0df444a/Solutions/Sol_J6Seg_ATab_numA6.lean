noncomputable section

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH IntMul.Kappa.R6 Function

/-- The loop-count bounds at `W = Wd`. -/
theorem cb_of {p s t α d k pre post pkA pkC bA bC : ℕ} (h : AxF p s t α d k pre post) :
    CB (Wd pkA pkC bA bC p t) p t α pkA pkC bA bC := by
  have hW := le_Wd pkA pkC bA bC p t
  have hX : Xa p t = p + t + 100 := rfl
  have hWA := WA_le h
  have hH := H_le h
  have hsw := sw_le h.αp
  have hnc := nc_le (s := s) h
  have e1 : pkA * p ≤ pkA * Xa p t := Nat.mul_le_mul_left _ (by omega)
  have e2 : pkC ≤ pkC * Xa p t := Nat.le_mul_of_pos_right _ (by omega)
  have e3 : bA * p ≤ bA * Xa p t := Nat.mul_le_mul_left _ (by omega)
  have e4 : bC ≤ bC * Xa p t := Nat.le_mul_of_pos_right _ (by omega)
  exact ⟨by omega, by omega, by omega, by omega, by omega⟩

/-- `W + 40 ≤ 103 Kw · p t`. -/
theorem w40_le {p t pkA pkC bA bC : ℕ} (hp : 1 ≤ p) (ht : 1 ≤ t) :
    Wd pkA pkC bA bC p t + 40 ≤ (103 * (40 + pkA + pkC + bA + bC)) * (p * t) := by
  unfold Wd Xa
  set K := 40 + pkA + pkC + bA + bC
  have hK : 40 ≤ K := by omega
  have h1 : p + t + 101 ≤ 103 * (p * t) := by nlinarith
  calc K * (p + t + 100) + 40 ≤ K * (p + t + 101) := by nlinarith
    _ ≤ K * (103 * (p * t)) := Nat.mul_le_mul_left _ h1
    _ = 103 * K * (p * t) := by ring

/-- The cost against `budget_ev`'s monomial. -/
theorem cost_mono {c W p t b K0 : ℕ} (hc : c ≤ 10 ^ 45 * (W + 40) ^ 12)
    (hw : W + 40 ≤ K0 * (p * t)) (hb : 1 ≤ b) :
    c ≤ 10 ^ 45 * K0 ^ 12 * b ^ 12 * t ^ 12 * p ^ 12 := by
  have h1 : (W + 40) ^ 12 ≤ (K0 * (p * t)) ^ 12 := Nat.pow_le_pow_left hw 12
  have h2 : 1 ≤ b ^ 12 := Nat.one_le_pow _ _ hb
  calc c ≤ 10 ^ 45 * (K0 * (p * t)) ^ 12 := le_trans hc (Nat.mul_le_mul_left _ h1)
    _ = 10 ^ 45 * K0 ^ 12 * 1 * t ^ 12 * p ^ 12 := by ring
    _ ≤ 10 ^ 45 * K0 ^ 12 * b ^ 12 * t ^ 12 * p ^ 12 := by gcongr

/-- **The numeric side of `PreA6` holds in round six.** -/
theorem numA6_sol_aux (P : Prm) (hP : P.Ok) (pkA pkC bA bC : ℕ) : NumA6 P pkA pkC bA bC := by
  set K0 := 103 * (40 + pkA + pkC + bA + bC)
  obtain ⟨n₁, hQ⟩ := qok_of P hP
  obtain ⟨n₂, hN⟩ := r6_axis_nat P hP
  obtain ⟨n₃, hBu⟩ := budget_ev P hP (10 ^ 45 * K0 ^ 12) 12
  refine ⟨1, 0, max n₁ (max n₂ n₃), zero_le_one, fun n hn src hsrc D hD k hk => ?_⟩
  have hn1 : n₁ ≤ n := le_trans (le_max_left _ _) hn
  have hn2 : n₂ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
  have hn3 : n₃ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
  have hq := hQ n hn1 src hsrc
  obtain ⟨hs0, hst, hα2, -, -, hdα, hαp, -, hb', hd1⟩ := hN n hn2 src hsrc k (by omega)
  have hLb : LP6 P n + 2 ≤ b'P6 P n := hq.hLb
  have hl2 : 2 ≤ ℓP6 P n := hq.hℓ2
  have hpe : pP6 P n = 6 * b'P6 P n := rfl
  have hprod : (List.ofFn (tD6 P n D)).prod = 2 ^ LP6 P n := TW_eq P n D hD (by omega)
  have htot := pre_t_post P n D k hk
  rw [hprod] at htot
  have hLp : 2 ^ LP6 P n ≤ 2 ^ pP6 P n := pow_mono (by omega)
  have hT1 : 1 ≤ 2 ^ LP6 P n := Nat.one_le_two_pow
  have ht1 : 1 ≤ tF6 P n k := by omega
  have hpre1 : 1 ≤ preT P n D k := Nat.pos_of_ne_zero (fun h => by rw [h] at htot; omega)
  have hpost1 : 1 ≤ postT P n D k := Nat.pos_of_ne_zero (fun h => by rw [h] at htot; omega)
  have hpreT : preT P n D k ≤ 2 ^ LP6 P n := by
    rw [← htot]
    calc preT P n D k = preT P n D k * 1 * 1 := by ring
      _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_left _ ht1) hpost1
  have hpostT : postT P n D k ≤ 2 ^ LP6 P n := by
    rw [← htot]
    calc postT P n D k = 1 * 1 * postT P n D k := by ring
      _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul hpre1 ht1) le_rfl
  have hdd : dP6 P n ≤ dP6 P n ^ 2 := by nlinarith
  have hAx : AxF (pP6 P n) (src k) (tF6 P n k) (αN6 P n) (dP6 P n) k (preT P n D k)
      (postT P n D k) :=
    { s0 := hs0, st := hst, α1 := by omega, αp := hαp, p1 := by omega, kd := by omega,
      dp := by omega, hpre := le_trans hpreT hLp, hpost := le_trans hpostT hLp,
      T := by rw [htot]; exact hLp }
  have hb1 : 1 ≤ bP6 n := by
    by_contra h0
    have : bP6 n = 0 := by omega
    have : b'P6 P n = 0 := by unfold b'P6; rw [this]; exact zero_pow (by omega)
    omega
  have hw := w40_le (pkA := pkA) (pkC := pkC) (bA := bA) (bC := bC) (by omega : 1 ≤ pP6 P n) ht1
  have hcb := cb_of (pkA := pkA) (pkC := pkC) (bA := bA) (bC := bC) hAx
  have hbud := hBu n hn3 src hsrc D hD k hk 0
  refine ⟨Wd pkA pkC bA bC (pP6 P n) (tF6 P n k), Wd pkA pkC bA bC (pP6 P n) (tF6 P n k) + 1,
    axOK_of hAx, ?_, ?_⟩
  · rw [one_mul]
    refine le_trans ?_ hbud
    exact_mod_cast cost_mono (cNat_le (s := src k) hcb) hw hb1
  · rw [one_mul]
    refine le_trans ?_ hbud
    exact_mod_cast cost_mono (cTear_le (s := src k) hcb) hw hb1

end J6Seg.ATab

end

