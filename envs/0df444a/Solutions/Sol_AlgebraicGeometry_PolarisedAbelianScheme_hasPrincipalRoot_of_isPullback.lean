theorem specMap_comp' {A B C : Type} [CommRing A] [CommRing B] [CommRing C] (a : B →+* C) (b : A →+* B) :
    Spec.map (CommRingCat.ofHom a) ≫ Spec.map (CommRingCat.ofHom b) = Spec.map (CommRingCat.ofHom (a.comp b)) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]

noncomputable def tpowPullbackIso {Y Y' : Scheme.{0}} (p : Y' ⟶ Y) (M : Y.Modules) :
    ∀ n : ℕ, (Scheme.Modules.pullback p).obj (Scheme.Modules.tpow M n) ≅ Scheme.Modules.tpow ((Scheme.Modules.pullback p).obj M) n
  | 0 => Scheme.Modules.pullbackTensorUnitObjIso p
  | n + 1 => Scheme.Modules.pullbackTensorObjIso p _ _ ≪≫ (tpowPullbackIso p M n ⊗ᵢ Iso.refl _)

noncomputable def tpowCongr {Y : Scheme.{0}} {M M' : Y.Modules} (e : M ≅ M') :
    ∀ n : ℕ, Scheme.Modules.tpow M n ≅ Scheme.Modules.tpow M' n
  | 0 => Iso.refl _
  | n + 1 => tpowCongr e n ⊗ᵢ e

end RTBC
