    haveI _i5 : IsScalarTower (AlgebraicClosure ℚ) A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact CerednikDrinfeld.LevelUp.closure_range_union_eq_top A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) (s₂ ℓ) (AlgebraicClosure ℚ)
      (𝕋.φ ((ℓ, 1) : HeckeTower.Arr q q')) (ιM₂ none) (ιM₂ (some ℓ)) (I3a ℓ) (I3b ℓ) I0b_N (G2 ℓ).1
      (by rw [(G2 ℓ).2, hidx ℓ]; exact (hdeg' ℓ).le)

  have I0a_ℓ : ∀ (ℓ : HeckeTower.AwayPrime q q') (z : AlgebraicClosure ℚ),
      ιM₂ (some ℓ) (algebraMap (AlgebraicClosure ℚ) (𝕋.objField (some ℓ)) z)
        = algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂))
            ((z : AlgebraicClosure ℚ) : A₂.valuation.Completion) := by
    intro ℓ z
    have h1 : algebraMap (AlgebraicClosure ℚ) (𝕋.objField (some ℓ)) z =
        𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q') (algebraMap (AlgebraicClosure ℚ) FN z) :=
      ((𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q')).commutes z).symm
    rw [h1, I3a]
    exact I0a_N z

  have I0b_ℓ : ∀ ℓ : HeckeTower.AwayPrime q q',
      Subfield.closure (Set.range (algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) ∪ Set.range (ιM₂ (some ℓ)))
        = Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ (some ℓ)) := by
    intro ℓ
    rw [hΓ₂ℓ ℓ]
    exact CerednikDrinfeld.LevelUp.closure_range_level_eq A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) (s₂ ℓ)
      (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q')) (𝕋.φ ((ℓ, 1) : HeckeTower.Arr q q')) (ιM₂ none) (ιM₂ (some ℓ))
      (G3 ℓ) (I3a ℓ) (I3b ℓ) I0b_N (G2 ℓ).1

  have I0c_ℓ : ∀ (ℓ : HeckeTower.AwayPrime q q') (t : Finset (𝕋.objField (some ℓ))),
      LinearIndependent (AlgebraicClosure ℚ) (fun x : t => (x : 𝕋.objField (some ℓ))) →
      LinearIndependent A₂.valuation.Completion (fun x : t => ιM₂ (some ℓ) (x : 𝕋.objField (some ℓ))) := by
    intro ℓ
    letI _i1 : Algebra FN (𝕋.F ℓ) := algebraAlong (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q'))
    haveI _i2 : IsScalarTower (AlgebraicClosure ℚ) FN (𝕋.F ℓ) := isScalarTower_along (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q'))
    haveI _i3 : Module.Finite FN (𝕋.F ℓ) := 𝕋.finite (ℓ, 0)
    letI _i4 : Algebra (AlgebraicClosure ℚ) (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) :=
      ((algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂))).comp (algebraMap (AlgebraicClosure ℚ) A₂.valuation.Completion)).toAlgebra
    haveI _i5 : IsScalarTower (AlgebraicClosure ℚ) A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    refine LinearIndependent.map_of_finrank_le_relfinrank_closure (AlgebraicClosure ℚ) FN (𝕋.F ℓ) A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂))
      (ιM₂ none) (ιM₂ (some ℓ)) ?_ ?_ I0c_N ?_
    ·
      intro z; exact I0a_N z
    · intro x; exact I3a ℓ x
    ·
      rw [I0b_N, I0b_ℓ ℓ, hΓ₂ℓ ℓ, (G2 ℓ).2, hidx ℓ]
      exact (hdeg' ℓ).le

  have hAL := CerednikDrinfeld.CosetGraph.atkinLehner_relations_levelGroups_place hN hqN hq'N hqq' hq5 hq'5
    q q' hqN hq'N hqq' hdef₁ Λ₁ R₁ hΛ₁ hR₁ hRΛ₁ n₁ hn₁ v₂ hv₂ s₂ sf₂ hs₂ Γ₂ hΓ₂0 hΓ₂ℓ w₂ wbar₂ hw₂ hwbar₂
  have hιN_mem : ∀ x : FN, ιM₂ none x ∈ Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) :=
    fun x => I0b_N ▸ Subfield.subset_closure (Or.inr ⟨x, rfl⟩)

  have hnorm : ∀ u : (ℍ[ℚ, a₁, b₁])ˣ, (Γ₂ none).map (MulAut.conj u).toMonoidHom = Γ₂ none →
      ∀ γ ∈ Γ₂ none, u⁻¹ * γ * u ∈ Γ₂ none := by
    intro u hu γ hγ
    rw [← hu] at hγ
    obtain ⟨γ₀, hγ₀, rfl⟩ := hγ
    simpa [MulAut.conj_apply, mul_assoc] using hγ₀

  have I1_ℓ : ∀ (ℓ : HeckeTower.AwayPrime q q') (τ : ↥(A₂.decompositionSubgroup ℚ)) (x : 𝕋.F ℓ),
      ιM₂ (some ℓ) (galT ℓ τ • x)
        = (if χ₂ τ = 1 then (1 : (ℍ[ℚ, a₁, b₁])ˣ) else w₂ (some ℓ))
            • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ (dIso₂ τ)) (ιM₂ (some ℓ) x) := by
    intro ℓ τ
    refine CerednikDrinfeld.LevelUp.ringHom_level_intertwining A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) (s₂ ℓ)
      (if χ₂ τ = 1 then (1 : (ℍ[ℚ, a₁, b₁])ˣ) else w₂ none) (if χ₂ τ = 1 then (1 : (ℍ[ℚ, a₁, b₁])ˣ) else w₂ (some ℓ))
      (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q')) (𝕋.φ ((ℓ, 1) : HeckeTower.Arr q q')) (ιM₂ none) (ιM₂ (some ℓ))
      (G3 ℓ) (I3a ℓ) (I3b ℓ) hιN_mem
      (fun x => galN τ • x) (MulSemiringAction.toRingHom _ _ (galT ℓ τ)) (hgalφ (ℓ, 0) τ) (hgalφ (ℓ, 1) τ)
      (Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ (dIso₂ τ))).toRingHom
      (fun g y => Mumford.AmbientSemilinearAut.fracMap_smul _ g y)
      (I1_N τ) ?_ ?_ ?_
    · split_ifs with h
      · intro γ hγ; rwa [inv_one, one_mul, mul_one]
      · exact hnorm _ (hAL none).1
    · split_ifs with h
      · rw [inv_one, mul_one]; exact one_mem _
      · exact ((hAL none).2.2.2.2.2 ℓ).1
    · split_ifs with h
      · rw [inv_one, mul_one, mul_one, inv_mul_cancel]; exact one_mem _
      · exact ((hAL none).2.2.2.2.2 ℓ).2.1

  have I2a_ℓ : ∀ (ℓ : HeckeTower.AwayPrime q q') (x : 𝕋.F ℓ), ιM₂ (some ℓ) (WT ℓ (0 : Fin 2) • x) = w₂ (some ℓ) • ιM₂ (some ℓ) x := by
    intro ℓ
    exact CerednikDrinfeld.LevelUp.ringHom_level_intertwining A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) (s₂ ℓ) (w₂ none) (w₂ (some ℓ))
      (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q')) (𝕋.φ ((ℓ, 1) : HeckeTower.Arr q q')) (ιM₂ none) (ιM₂ (some ℓ))
      (G3 ℓ) (I3a ℓ) (I3b ℓ) hιN_mem
      (fun x => W 0 • x) (MulSemiringAction.toRingHom _ _ (WT ℓ 0)) (hWφ (ℓ, 0) 0) (hWφ (ℓ, 1) 0)
      (RingHom.id _) (fun _ _ => rfl) I2a_N
      (hnorm _ (hAL none).1) ((hAL none).2.2.2.2.2 ℓ).1 ((hAL none).2.2.2.2.2 ℓ).2.1
  have I2b_ℓ : ∀ (ℓ : HeckeTower.AwayPrime q q') (x : 𝕋.F ℓ), ιM₂ (some ℓ) (WT ℓ (1 : Fin 2) • x) = wbar₂ (some ℓ) • ιM₂ (some ℓ) x := by
    intro ℓ
    exact CerednikDrinfeld.LevelUp.ringHom_level_intertwining A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ none) (s₂ ℓ) (wbar₂ none) (wbar₂ (some ℓ))
      (𝕋.φ ((ℓ, 0) : HeckeTower.Arr q q')) (𝕋.φ ((ℓ, 1) : HeckeTower.Arr q q')) (ιM₂ none) (ιM₂ (some ℓ))
      (G3 ℓ) (I3a ℓ) (I3b ℓ) hιN_mem
      (fun x => W 1 • x) (MulSemiringAction.toRingHom _ _ (WT ℓ 1)) (hWφ (ℓ, 0) 1) (hWφ (ℓ, 1) 1)
      (RingHom.id _) (fun _ _ => rfl) I2b_N
      (hnorm _ (hAL none).2.1) ((hAL none).2.2.2.2.2 ℓ).2.2.1 ((hAL none).2.2.2.2.2 ℓ).2.2.2

  unfold CerednikDrinfeld.DescentIntertwining
  refine ⟨par₁, par₂, par₃, ?_, ?_, ?_, I1_N, I1_ℓ, I2a_N, I2b_N, I2a_ℓ, I2b_ℓ, I3a, I3b⟩
  · rintro (_ | ℓ) z
    · exact I0a_N z
    · exact I0a_ℓ ℓ z
  · rintro (_ | ℓ)
    · exact I0b_N
    · exact I0b_ℓ ℓ
  · rintro (_ | ℓ) t ht
    · exact I0c_N t ht
    · exact I0c_ℓ ℓ t ht

