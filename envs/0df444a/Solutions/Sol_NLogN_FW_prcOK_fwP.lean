theorem dcomX_snoc (F : ℤ) (n E : ℕ) : ∀ (i : ℕ) (A B : List ℤ) (a b : ℤ), A.length = B.length →
    dcomX F n E i (A ++ [a]) (B ++ [b]) =
      dcomX F n E i A B ++ [((a + -((b * 2 ^ (n - (i + A.length) * E)) % F)) % F)]
  | i, [], [], a, b, _ => by simp [dcomX]
  | i, u :: A, v :: B, a, b, h => by
    simp only [List.cons_append, dcomX, List.length_cons, add_left_inj] at h ⊢
    rw [dcomX_snoc F n E (i + 1) A B a b h]
    simp only [List.cons.injEq, true_and]
    congr 6; ring_nf
  | _, [], _ :: _, _, _, h => by simp at h
  | _, _ :: _, [], _, _, h => by simp at h

