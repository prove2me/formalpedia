theorem NLogN.KFUU.p3L_runs {pM : Fin P} (hM : MulOK I iprog pM MS) {pS : Fin HS} (hpS : LS pS)
    (u cz : ℕ) (bs : List Bool) (hcz : 1 ≤ cz) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0) (Z : ℕ)
    (hVZ : zsz ((vol (shP u bs) * cz : ℕ) : ℤ) ≤ Z) (hZ2 : 2 ≤ Z) (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
      (lay3 (bgB bs) bs.length 0) xs0 0) ++ R)
    {RV RtS RS LX LM LZ LU LN : List Item}
    (hV : t.G pV = ints (sufV (shP u bs).reverse 1) ++ RV)
    (htS : t.G tS = ints (zl (shP u bs).reverse) ++ RtS) (hpS0 : t.G pS = RS)
    (hX : t.G pXr = .int 1 :: LX) (hMr : t.G rM = .int (((2 ^ u) ^ bs.length : ℕ) : ℤ) :: LM)
    (hZ : t.G rCZ = .int (cz : ℤ) :: LZ) (hU : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: LU)
    (hN : t.G nR = .int (bs.length : ℤ) :: LN) :
    IRuns I iprog (p3L pM pS) t
      (((((t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (lay3 (bgB bs) bs.length bs.length) xs0 0) ++ R)).upd pV RV).upd pXr
        (.int (vol (shP u bs) : ℤ) :: LX)).upd rM (.int (((2 ^ u) ^ 0 : ℕ) : ℤ) :: LM)).upd tS RtS
        |>.upd pS (ints (zl (shP u bs)) ++ RS))
      ((bs.length + 1) * (KFU.cMv (vol (shP u bs) * cz) w + 60 * cU Z + 76 * Z + 3000)) := by sorry
