-- Source module: Solutions.KFV55Table
/-!
# KFV §55: the fixed table of the uniform Proposition 18

`ext18 nU U e su td q : Fin (nU + 2) → IStmt HS (7 + (nU + 2))` extends `KFM.kTable` by

* the `nU` procedures of the uniform Proposition 14 (`P14U`) at `idx18 i = 7 + i`;
* the uniform Gaussian swap `KFW.swGU q` (descriptor on stack `7`) at `eSw18 = 7 + nU`;
* the body of Proposition 18 at `ent18 = 8 + nU`.

**`kT_idx`**, **`kT_sw`**, **`kT_ent`**: the table entries; **`swOK18`**: `SwOK` for the swap entry.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

/-- Positions of the Proposition 14 procedures. -/
def idx18 (nU : ℕ) : Fin nU → Fin (7 + (nU + 2)) := fun i => ⟨i.val + 7, by omega⟩

/-- Position of the swap. -/
def eSw18 (nU : ℕ) : Fin (7 + (nU + 2)) := ⟨nU + 7, by omega⟩

/-- Position of the Proposition 18 body. -/
def ent18 (nU : ℕ) : Fin (7 + (nU + 2)) := ⟨(nU + 1) + 7, by omega⟩

/-- The extension of the table. -/
noncomputable def ext18 (nU : ℕ)
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E)) (e : Fin nU)
    (su td : (Pp : ℕ) → IStmt HS Pp) (q : ℕ) : Fin (nU + 2) → IStmt HS (7 + (nU + 2)) :=
  fun k =>
    if h : k.val < nU then U (nU + 2) (idx18 nU) ⟨k.val, h⟩
    else if k.val = nU then (KFW.swGU q).ren id (KFM.gL (nU + 2))
    else body18 (su _) (td _) (idx18 nU e) (eSw18 nU) (KFM.pMul (nU + 2))

section
variable {nU : ℕ} {U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E)} {e : Fin nU}
  {su td : (Pp : ℕ) → IStmt HS Pp} {q : ℕ}

end

end NLogN.KFV

end

