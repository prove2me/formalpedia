theorem CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.isTwist_of_P_eq
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N n : ℕ} {S : Type} [CommRing S]
    (E : FakeEllipticCurve Λ N S) (c : ↥Λ) (Pn Pn' : E.FullLevel n)
    (h : Pn'.P = pushPt (E.act c) (E.act_over c) Pn.P) :
    FakeEllipticCurve.WithFullLevel.IsTwist c (⟨E, Pn⟩ : FakeEllipticCurve.WithFullLevel Λ N n S) ⟨E, Pn'⟩ := by
  have hid : ∀ {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)} (P : SchemeHomOver t E.f),
      mapPt (𝟙 E.A) (Category.id_comp E.f) P = P := fun P => Subtype.ext (Category.comp_id _)
  refine ⟨Iso.refl E.A, Category.id_comp E.f, ?_, ?_, ?_, ?_⟩
  · intro T t P Q
    show mapPt (𝟙 E.A) _ (E.L.mul t P Q) = E.L.mul t (mapPt (𝟙 E.A) _ P) (mapPt (𝟙 E.A) _ Q)
    rw [hid, hid, hid]
  · intro x
    show E.act x ≫ 𝟙 E.A = 𝟙 E.A ≫ E.act x
    rw [Category.comp_id, Category.id_comp]
  · intro T t P
    show FactorsThrough E.lev P ↔ FactorsThrough E.lev (mapPt (𝟙 E.A) _ P)
    rw [hid]
  · show mapPt (𝟙 E.A) _ (pushPt (E.act c) (E.act_over c) Pn.P) = Pn'.P
    rw [hid, h]

