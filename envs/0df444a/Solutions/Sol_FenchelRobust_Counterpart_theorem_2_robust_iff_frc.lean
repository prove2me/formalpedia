theorem solution {m n L : ℕ} (a0 : Fin m → ℝ)
    (A : Matrix (Fin m) (Fin L) ℝ) (Z : Set (Fin L → ℝ))
    (D : (Fin n → ℝ) → Set (Fin m → ℝ))
    (f : (Fin m → ℝ) → (Fin n → ℝ) → ℝ)
    (hZnonempty : Z.Nonempty) (hZconvex : Convex ℝ Z) (hZcompact : IsCompact Z)
    (hZzero : (0 : Fin L → ℝ) ∈ intrinsicInterior ℝ Z)
    (hconcave : ∀ x, ConcaveOn ℝ (D x) (fun a => f a x))
    (hregular : Regular a0 D) :
    ∀ x : Fin n → ℝ,
      RobustFeasible a0 A Z D f x ↔
        ∃ v : Fin m → ℝ, frcValue a0 A Z D f x v ≤ 0 := by
  intro x
  constructor
  · intro hR
    let P : Set ((Fin m → ℝ) × ℝ) :=
      {p | ∃ a ∈ D x, ∃ ζ ∈ Z, p.1 = a - (a0 + A.mulVec ζ) ∧ p.2 ≤ f a x}
    have hP : Convex ℝ P := by
      rintro p ⟨a1, ha1, ζ1, hζ1, hp1, hp2⟩ q ⟨a2, ha2, ζ2, hζ2, hq1, hq2⟩ α β hα hβ hab
      refine ⟨α • a1 + β • a2, (hconcave x).1 ha1 ha2 hα hβ hab, α • ζ1 + β • ζ2,
        hZconvex hζ1 hζ2 hα hβ hab, ?_, ?_⟩
      · rw [Prod.fst_add, Prod.smul_fst, Prod.smul_fst, hp1, hq1, Matrix.mulVec_add,
          Matrix.mulVec_smul, Matrix.mulVec_smul]
        obtain rfl : β = 1 - α := by linarith
        module
      · rw [Prod.snd_add, Prod.smul_snd, Prod.smul_snd, smul_eq_mul, smul_eq_mul]
        have hc := (hconcave x).2 ha1 ha2 hα hβ hab
        simp only [smul_eq_mul] at hc
        have := mul_le_mul_of_nonneg_left hp2 hα
        have := mul_le_mul_of_nonneg_left hq2 hβ
        linarith
    have h0 : ∀ t, ((0 : Fin m → ℝ), t) ∈ P → t ≤ 0 := by
      rintro t ⟨a, ha, ζ, hζ, h1, h2⟩
      have hae : a = a0 + A.mulVec ζ := (sub_eq_zero.mp h1.symm)
      have := hR a ⟨ζ, hζ, hae⟩ ha
      exact h2.trans this
    have ha0D : a0 ∈ D x := intrinsicInterior_subset (hregular x)
    have h0Z : (0 : Fin L → ℝ) ∈ Z := intrinsicInterior_subset hZzero
    have hne : ∃ s, ((0 : Fin m → ℝ), s) ∈ P :=
      ⟨f a0 x, a0, ha0D, 0, h0Z, by simp, le_rfl⟩
    have hri : ∀ p ∈ P, ∃ ε > (0 : ℝ), ∃ s, (-ε • p.1, s) ∈ P := by
      rintro p ⟨a, ha, ζ, hζ, hp1, -⟩
      have e1 := FRCHelpEd52.ri_line (hregular x) ha
      have e2 := FRCHelpEd52.ri_line hZzero hζ
      obtain ⟨δ, ⟨hδ1, hδ2⟩, hδpos⟩ :=
        (((e1.and e2).filter_mono nhdsWithin_le_nhds).and
          (self_mem_nhdsWithin : Set.Ioi (0 : ℝ) ∈ nhdsWithin 0 (Set.Ioi 0))).exists
      refine ⟨δ, hδpos, f (AffineMap.lineMap a0 a (-δ)) x, AffineMap.lineMap a0 a (-δ), hδ1,
        AffineMap.lineMap 0 ζ (-δ), hδ2, ?_, le_rfl⟩
      simp only [hp1, AffineMap.lineMap_apply_module, smul_zero, zero_add, Matrix.mulVec_smul]
      module
    obtain ⟨G, hG⟩ := FRCHelpEd52.exists_linear_majorant P hP h0 hne hri
    obtain ⟨v, hv⟩ := FRCHelpEd52.dot_rep G
    refine ⟨v, ?_⟩
    have hk : ∀ a ∈ D x, ∀ ζ ∈ Z, f a x ≤ (a - (a0 + A.mulVec ζ)) ⬝ᵥ v := by
      intro a ha ζ hζ
      have := hG (a - (a0 + A.mulVec ζ), f a x) ⟨a, ha, ζ, hζ, rfl, le_rfl⟩
      rw [hv] at this
      exact this
    have hσ : ∀ a ∈ D x, ((a0 ⬝ᵥ v : ℝ) : EReal) + supportFun Z (A.transpose.mulVec v)
        ≤ ((a ⬝ᵥ v - f a x : ℝ) : EReal) := by
      intro a ha
      have hs : supportFun Z (A.transpose.mulVec v) ≤ ((a ⬝ᵥ v - f a x - a0 ⬝ᵥ v : ℝ) : EReal) := by
        unfold supportFun
        refine iSup₂_le fun ζ hζ => ?_
        have hk' := hk a ha ζ hζ
        have e : (A.transpose.mulVec v) ⬝ᵥ ζ = (A.mulVec ζ) ⬝ᵥ v := by
          rw [Matrix.mulVec_transpose, ← Matrix.dotProduct_mulVec, dotProduct_comm]
        rw [sub_dotProduct, add_dotProduct] at hk'
        exact_mod_cast (by linarith : (A.transpose.mulVec v) ⬝ᵥ ζ ≤ a ⬝ᵥ v - f a x - a0 ⬝ᵥ v)
      calc ((a0 ⬝ᵥ v : ℝ) : EReal) + supportFun Z (A.transpose.mulVec v)
          ≤ ((a0 ⬝ᵥ v : ℝ) : EReal) + ((a ⬝ᵥ v - f a x - a0 ⬝ᵥ v : ℝ) : EReal) :=
            add_le_add le_rfl hs
        _ = ((a ⬝ᵥ v - f a x : ℝ) : EReal) := by
            rw [← EReal.coe_add]; congr 1; ring
    have hκ : ((a0 ⬝ᵥ v : ℝ) : EReal) + supportFun Z (A.transpose.mulVec v)
        ≤ concaveConj (D x) (fun a => f a x) v := by
      unfold concaveConj
      exact le_iInf₂ hσ
    unfold frcValue
    exact (EReal.sub_le_sub hκ le_rfl).trans EReal.sub_self_le_zero
  · rintro ⟨v, h0⟩
    have key : ∀ a ∈ uncertaintySet a0 A Z ∩ D x,
        ((f a x : ℝ) : EReal) ≤ frcValue a0 A Z D f x v := by
      rintro a ⟨⟨ζ, hζ, rfl⟩, haD⟩
      have hs : ((Matrix.mulVec A.transpose v ⬝ᵥ ζ : ℝ) : EReal)
          ≤ supportFun Z (Matrix.mulVec A.transpose v) := by
        unfold supportFun
        exact le_iSup₂ (f := fun ζ (_ : ζ ∈ Z) =>
          ((Matrix.mulVec A.transpose v ⬝ᵥ ζ : ℝ) : EReal)) ζ hζ
      have hc : concaveConj (D x) (fun a => f a x) v
          ≤ (((a0 + A.mulVec ζ) ⬝ᵥ v - f (a0 + A.mulVec ζ) x : ℝ) : EReal) := by
        unfold concaveConj
        exact iInf₂_le (f := fun a (_ : a ∈ D x) =>
          ((a ⬝ᵥ v - f a x : ℝ) : EReal)) _ haD
      have h1 : ((a0 ⬝ᵥ v : ℝ) : EReal) + ((Matrix.mulVec A.transpose v ⬝ᵥ ζ : ℝ) : EReal)
          ≤ ((a0 ⬝ᵥ v : ℝ) : EReal) + supportFun Z (Matrix.mulVec A.transpose v) :=
        add_le_add le_rfl hs
      have h2 := EReal.sub_le_sub h1 hc
      unfold frcValue
      refine le_trans (le_of_eq ?_) h2
      rw [← EReal.coe_add, ← EReal.coe_sub]
      congr 1
      rw [Matrix.mulVec_transpose, ← Matrix.dotProduct_mulVec, add_dotProduct,
        dotProduct_comm (A.mulVec ζ) v]
      ring
    intro a ha haD
    have := le_trans (key a ⟨ha, haD⟩) h0
    exact_mod_cast this
