      (fun k' _ _ i' => hgood.2 k' (Spec.map (CommRingCat.ofHom (i'.comp i))))
      O₀ j hj hu₀ hjloc (pullback.snd w.πX (Spec.map (CommRingCat.ofHom j₀))) ε₀
