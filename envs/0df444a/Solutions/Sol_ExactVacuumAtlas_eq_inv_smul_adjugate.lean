/-! ### Smoothness of Jacobians and of their inverses -/

theorem det_ne_zero_of_mul_eq_one {J K : Matrix (Fin n) (Fin n) ℝ} (h : J * K = 1) : J.det ≠ 0 := by
  intro h0
  have := congrArg Matrix.det h
  rw [Matrix.det_mul, h0, zero_mul, Matrix.det_one] at this
  exact zero_ne_one this

