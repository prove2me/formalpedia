theorem TypeDensity.curve_ideal_lattice_le_sections (R : Type) [CommRing R] (t x : R)
    (beta : BlowupRestriction R t x) (d : ℕ) (G : GluedGenerators R t x beta d) (j : ℕ) :
    curveIdealLattice R t x beta G j ≤ curveSections R t x beta G j := by sorry
