    (hbN : F bN = (n : ℤ) :: ln) (hbN2 : F bN2 = ((2 * n : ℕ) : ℤ) :: ln2)
    (hX : F vX = []) (hY : F vY = []) (hO : F vO = []) (hT : Tmp F)
    (hpc : F kc = [2 ^ pk]) (hpr : F kr = [((2 * n : ℕ) : ℤ)]) (hpK : F kK = [NLogN.KFV.kG b (2 * n) (2 ^ pk)])
