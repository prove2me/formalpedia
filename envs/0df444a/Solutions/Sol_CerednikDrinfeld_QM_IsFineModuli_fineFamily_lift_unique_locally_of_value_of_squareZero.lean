theorem isPullbackVia_comp_inv_of_isoVia
    {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (E E' : FakeEllipticCurve Λ N S) (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hiso : FakeEllipticCurve.IsoVia E E' i hi)
    (Eb : FakeEllipticCurve Λ N S') (gb : Eb.A ⟶ E'.A) (hgb : FakeEllipticCurve.IsPullbackVia φ E' Eb gb) :
    FakeEllipticCurve.IsPullbackVia φ E Eb (gb ≫ i.inv) := by
  obtain ⟨hsq, hmul, hact, hlev⟩ := hgb
  have hi' : i.inv ≫ E.f = E'.f := by rw [← hi, Iso.inv_hom_id_assoc]
  have s₂ : IsPullback i.inv E'.f E.f (𝟙 _) := IsPullback.of_horiz_isIso ⟨by rw [hi', Category.comp_id]⟩
  have hsq' : IsPullback (gb ≫ i.inv) Eb.f E.f (Spec.map (CommRingCat.ofHom φ)) := by
    simpa using hsq.paste_horiz s₂
  refine ⟨hsq', ?_, ?_, ?_⟩
  · intro T t' P Q
    have wP : ∀ R : SchemeHomOver t' Eb.f, (R.1 ≫ gb ≫ i.inv) ≫ E.f = t' ≫ Spec.map (CommRingCat.ofHom φ) := by
      intro R; rw [Category.assoc, Category.assoc, hi', hsq.w, ← Category.assoc, R.2]
    have wP' : ∀ R : SchemeHomOver t' Eb.f, (R.1 ≫ gb) ≫ E'.f = t' ≫ Spec.map (CommRingCat.ofHom φ) := by
      intro R; rw [Category.assoc, hsq.w, ← Category.assoc, R.2]
    have key := hiso.1 (t' ≫ Spec.map (CommRingCat.ofHom φ)) ⟨P.1 ≫ gb ≫ i.inv, wP P⟩ ⟨Q.1 ≫ gb ≫ i.inv, wP Q⟩
    have hPA : mapPt i.hom hi (⟨P.1 ≫ gb ≫ i.inv, wP P⟩ : SchemeHomOver _ E.f) = ⟨P.1 ≫ gb, wP' P⟩ :=
      Subtype.ext (by simp)
    have hQA : mapPt i.hom hi (⟨Q.1 ≫ gb ≫ i.inv, wP Q⟩ : SchemeHomOver _ E.f) = ⟨Q.1 ≫ gb, wP' Q⟩ :=
      Subtype.ext (by simp)
    have h1 := congrArg Subtype.val key
    rw [hPA, hQA] at h1
    have h2 := hmul t' P Q
    simp only [mapPt_coe] at h1
    rw [← h2] at h1
    rw [← Category.assoc, ← h1, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  · intro x
    rw [← Category.assoc, hact x, Category.assoc, Category.assoc]
    congr 1
    rw [eq_comm, Iso.inv_comp_eq, ← Category.assoc, ← hiso.2.1 x, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  · intro T t' P hP
    obtain ⟨P₁, hP₁⟩ := hlev t' P hP
    have wP : (P.1 ≫ gb ≫ i.inv) ≫ E.f = t' ≫ Spec.map (CommRingCat.ofHom φ) := by
      rw [Category.assoc, Category.assoc, hi', hsq.w, ← Category.assoc, P.2]
    have wP' : (P.1 ≫ gb) ≫ E'.f = t' ≫ Spec.map (CommRingCat.ofHom φ) := by
      rw [Category.assoc, hsq.w, ← Category.assoc, P.2]
    have hPA : mapPt i.hom hi (⟨P.1 ≫ gb ≫ i.inv, wP⟩ : SchemeHomOver _ E.f) = ⟨P.1 ≫ gb, wP'⟩ :=
      Subtype.ext (by simp)
    have : FactorsThrough E.lev (⟨P.1 ≫ gb ≫ i.inv, wP⟩ : SchemeHomOver _ E.f) := by
      rw [hiso.2.2 _ _, hPA]; exact ⟨P₁, hP₁⟩
    exact this

theorem isoVia_symm {S : Type} [CommRing S]
    (E E' : FakeEllipticCurve Λ N S) (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hiso : FakeEllipticCurve.IsoVia E E' i hi) (hi' : i.symm.hom ≫ E.f = E'.f) :
    FakeEllipticCurve.IsoVia E' E i.symm hi' := by
  have hback : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E'.f),
      mapPt i.hom hi (mapPt i.symm.hom hi' P) = P := by
    intro T t P; apply Subtype.ext; simp
  refine ⟨?_, ?_, ?_⟩
  · intro T t P Q
    have key := hiso.1 t (mapPt i.symm.hom hi' P) (mapPt i.symm.hom hi' Q)
    rw [hback, hback] at key
    rw [← key]; apply Subtype.ext; simp
  · intro x
    show E'.act x ≫ i.inv = i.inv ≫ E.act x
    rw [eq_comm, Iso.inv_comp_eq, ← Category.assoc, ← hiso.2.1 x, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  · intro T t P
    rw [hiso.2.2 t (mapPt i.symm.hom hi' P), hback]

end ETULocAux

theorem ETULocAux.conn_quotient {C : Type} [CommRing C] (I : Ideal C) (hI : I * I = ⊥)
    (hconn : ∀ e : C, IsIdempotentElem e → e = 0 ∨ e = 1) :
    ∀ e : C ⧸ I, IsIdempotentElem e → e = 0 ∨ e = 1 :=
  ETULocAux.conn_of_squareZero (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    (fun s t hs ht => by
      rw [Ideal.Quotient.eq_zero_iff_mem] at hs ht
      have : s * t ∈ I * I := Ideal.mul_mem_mul hs ht
      rwa [hI, Ideal.mem_bot] at this) hconn

