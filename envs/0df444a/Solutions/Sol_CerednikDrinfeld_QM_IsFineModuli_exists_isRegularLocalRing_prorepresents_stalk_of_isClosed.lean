  exact Ideal.subset_span rfl

theorem isAdicComplete_maximalIdeal_of_frame
    (Onr : Type) [CommRing Onr] [IsDomain Onr] [IsDiscreteValuationRing Onr] [Algebra ℤ_[q] Onr]
    (hOnr_complete : IsAdicComplete (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}) Onr)
    (hOnr_max : (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}).IsMaximal) :
    IsAdicComplete (maximalIdeal Onr) Onr := by
  rw [← IsLocalRing.eq_maximalIdeal hOnr_max]; exact hOnr_complete

