open CategoryTheory CategoryTheory.Limits AlgebraicGeometry ModularCurve

theorem ModularCurve.DRModelPackage.exists_eq_baseChangeMap_crossing_of_mem_closure_of_mem_closure
    (p : ℕ) [Fact p.Prime] (𝔛 : DRModelPackage p) (O : Type) [CommRing O] [IsLocalRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    (x : ↥(pullback (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))))
    (hx₁ : x ∈ closure (Set.range ⇑(𝔛.compInf κ ≫ DRModel.baseChangeMap toκ).base))
    (hx₂ : x ∈ closure (Set.range ⇑(𝔛.compZero κ ≫ DRModel.baseChangeMap toκ).base)) :
    ∃ n : ↥(pullback (𝔛.compInf κ) (𝔛.compZero κ)),
      x = (pullback.fst (𝔛.compInf κ) (𝔛.compZero κ) ≫ 𝔛.compInf κ ≫ DRModel.baseChangeMap toκ).base n := by sorry
