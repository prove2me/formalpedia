  have htail : R.res ((algebraMap K (RatFunc K) a * v.uniformizer ^ (k - 1)
      * ((-(algebraMap K (RatFunc K) a * v.uniformizer ^ k)) ^ q
          * ((1 : RatFunc K)
              + algebraMap K (RatFunc K) a * v.uniformizer ^ k)⁻¹))
      * (v.uniformizer ^ q)⁻¹) = 0 := by
    apply R.res_of_mem
