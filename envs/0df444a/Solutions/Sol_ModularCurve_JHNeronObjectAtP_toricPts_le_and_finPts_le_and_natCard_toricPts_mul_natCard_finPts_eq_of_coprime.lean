theorem GENUS_ID (O : JHNeronObjectAtP p M H hpM A hA Λ) (hpM2 : ¬ p ^ 2 ∣ M)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H) :
    genusFF (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) + 1 =
      2 * genusFF (ResidueField ↥A) (Fbar p M H hpM (ResidueField ↥A)) + O.ssFinset.card := by
  have h := ModularCurve.genusFF_xHFunctionFieldBar_add_one_eq_two_mul_genusFF_residueField_add_natCard_ssNodePairsQExp
    p M H hpM hpM2 hHp A hA
