theorem posF_lt {L : NLogN.KFV.LP} (hL : L.OK) {i t : ℕ} (hi : i < L.D) (ht : t + 2 ≤ L.ℓ) :
    posF L i t < L.n := by
  obtain ⟨hD, hK, hLst, hn, hl⟩ := hL
  unfold posF NLogN.KFV.eF
  split_ifs with h
  · have : (L.b - 1 - t) * L.D + i < L.b * L.D := by
      have : (L.b - 1 - t + 1) * L.D ≤ L.b * L.D := Nat.mul_le_mul_right _ (by omega)
      nlinarith
    have : L.D * L.q * L.K ≥ 0 := Nat.zero_le _
    omega
  · set e := L.q * L.K - 1 - (t - L.b)
    have he : e < L.q * L.K := by omega
    have hj : e / L.K < L.q := by rw [Nat.div_lt_iff_lt_mul (by omega)]; exact he
    have hm : e % L.K < L.K := Nat.mod_lt _ (by omega)
    have h1 : (e / L.K * L.D + i) * L.K + L.K ≤ L.D * L.q * L.K := by
      have : e / L.K * L.D + i + 1 ≤ L.D * L.q := by
        have : (e / L.K + 1) * L.D ≤ L.q * L.D := Nat.mul_le_mul_right _ hj
        nlinarith
      calc (e / L.K * L.D + i) * L.K + L.K = (e / L.K * L.D + i + 1) * L.K := by ring
        _ ≤ L.D * L.q * L.K := Nat.mul_le_mul_right _ this
    omega

theorem RV.top {s : IState HS} {g : Fin HS → List ℤ} {r : Fin HS} {v : ℤ} (h : RV s g r v) :
    (NLogN.KIL.encK s g).top r = v := by obtain ⟨L, hL⟩ := h; exact IState.top_eq hL

theorem RV.isInt {s : IState HS} {g : Fin HS → List ℤ} {r : Fin HS} {v : ℤ} (h : RV s g r v) :
    (NLogN.KIL.encK s g).IsInt r := by obtain ⟨L, hL⟩ := h; exact IState.isInt_of hL

theorem RV.congr {s : IState HS} {g g' : Fin HS → List ℤ} {r : Fin HS} {v : ℤ} (h : RV s g r v)
    (e : g' r = g r) : RV s g' r v := by
  obtain ⟨L, hL⟩ := h; exact ⟨L, by rw [encK_G] at hL ⊢; rw [e]; exact hL⟩

theorem RV.of_list {s : IState HS} {g : Fin HS → List ℤ} {r : Fin HS} {v : ℤ} {l : List ℤ}
    (h : g r = v :: l) : RV s g r v := ⟨ints l ++ s.G r, by simp [h, ints]⟩

theorem GRegs.congr {s : IState HS} {g g' : Fin HS → List ℤ} {L : NLogN.KFV.LP} {h : ℕ} (H : GRegs s g L h)
    (e : ∀ r ∈ NLogN.KFV.gIn, g' r = g r) : GRegs s g' L h :=
  ⟨H.d.congr (e _ (by decide)), H.l.congr (e _ (by decide)), H.k.congr (e _ (by decide)),
    H.b.congr (e _ (by decide)), H.q.congr (e _ (by decide)), H.nl.congr (e _ (by decide)),
    H.st.congr (e _ (by decide)), H.n.congr (e _ (by decide)), H.h.congr (e _ (by decide))⟩

theorem GRegs.upd {s : IState HS} {g : Fin HS → List ℤ} {L : NLogN.KFV.LP} {h : ℕ} (H : GRegs s g L h)
    (x : Fin HS) (hx : x ∉ NLogN.KFV.gIn) (v : List ℤ) : GRegs s (Function.update g x v) L h :=
  H.congr fun r hr => by
    have : r ≠ x := fun e => hx (e ▸ hr)
    simp [Function.update_apply, this]

theorem clean_posE (iR tR : Fin HS) (hi : iR.val < 56) (ht : tR.val < 56) : (posE iR tR).Clean := by
  apply clean_lo
  intro j hj
  have hg : ∀ x ∈ NLogN.KFV.gIn, x.val < 56 := by decide
  have : j = iR ∨ j = tR ∨ j ∈ gIn := by
    simp only [posE, preE, chkE, NLogN.KFV.eE, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil,
      or_false, List.nil_append, List.append_nil] at hj
    simp only [NLogN.KFV.gIn, List.mem_cons, List.not_mem_nil, or_false]
    tauto
  rcases this with rfl | rfl | h
  · exact hi
  · exact ht
  · exact hg j h

section PosE

variable {s : IState HS} {g : Fin HS → List ℤ} {L : LP} {h : ℕ} (H : GRegs s g L h) (hL : L.OK)
  {iR tR : Fin HS} {i t : ℕ} (hiR : RV s g iR i) (htR : RV s g tR t)
  (hi : i < L.D) (ht : t + 2 ≤ L.ℓ)
include H hL hiR htR hi ht

theorem eE_val (hb : L.b ≤ t) :
    (L.q : ℤ) * L.K + -1 + -((t : ℤ) + -(L.b : ℤ)) = ((NLogN.KFV.eF L t : ℕ) : ℤ) := by
  obtain ⟨hD, hK, hLst, hn, hl⟩ := hL
  unfold NLogN.KFV.eF
  have : t - L.b + 1 ≤ L.q * L.K := by omega
  push_cast [Nat.cast_sub (show t - L.b ≤ L.q * L.K - 1 by omega),
    Nat.cast_sub (show 1 ≤ L.q * L.K by omega), Nat.cast_sub hb]
  ring

theorem posE_eval : (posE iR tR).eval (NLogN.KIL.encK s g) = (posF L i t : ℤ) := by
  have tb := H.b.top; have td := H.d.top; have tk := H.k.top; have tq := H.q.top
  have tnl := H.nl.top; have tst := H.st.top
  simp only [posE, preE, chkE, NLogN.KFV.eE, Ex.eval, hiR.top, htR.top, tb, td, tk, tq, tnl, tst]
  unfold posF
  split_ifs with h1 h2 h2
  · have e1 : ((L.b - 1 - t : ℕ) : ℤ) = (L.b : ℤ) + -1 + -(t : ℤ) := by omega
    push_cast; rw [e1]; ring
  · exfalso; push_cast at h2; omega
  · exfalso; push_cast at h2; omega
  · rw [eE_val H hL hiR htR hi ht (by omega), ← Int.natCast_div, ← Int.natCast_mod]
    push_cast; ring

theorem posE_ok : (posE iR tR).ok (NLogN.KIL.encK s g) := by
  have tb := H.b.top; have tk := H.k.top; have tq := H.q.top
  refine ⟨⟨htR.isInt, H.b.isInt⟩, ?_⟩
  simp only [Ex.eval, htR.top, tb]
  split_ifs with h1
  · exact ⟨H.nl.isInt, ⟨⟨⟨H.b.isInt, trivial⟩, htR.isInt⟩, H.d.isInt⟩, hiR.isInt⟩
  · have hb : L.b ≤ t := by omega
    have e := eE_val H hL hiR htR hi ht hb
    have hK := hL.hK
    have eok : (NLogN.KFV.eE tR).ok (NLogN.KIL.encK s g) := ⟨⟨⟨H.q.isInt, H.k.isInt⟩, trivial⟩, htR.isInt, H.b.isInt⟩
    have ev : (NLogN.KFV.eE tR).eval (NLogN.KIL.encK s g) = ((NLogN.KFV.eF L t : ℕ) : ℤ) := by
      simp only [NLogN.KFV.eE, Ex.eval, htR.top, tb, tk, tq]; exact e
    refine ⟨H.st.isInt, ⟨⟨⟨⟨⟨eok, H.k.isInt, ?_, ?_⟩, H.d.isInt⟩, hiR.isInt⟩, H.k.isInt⟩,
      ⟨eok, H.k.isInt, ?_, ?_⟩⟩⟩
    all_goals first | (rw [ev]; positivity) | (simp only [Ex.eval, tk]; exact_mod_cast hK)

theorem posE_bnd {U : ℕ} (hnU : L.n ≤ U) : (posE iR tR).Bnd (NLogN.KIL.encK s g) (zsz (U : ℤ)) := by
  have tb := H.b.top; have td := H.d.top; have tk := H.k.top; have tq := H.q.top
  have tnl := H.nl.top; have tst := H.st.top; have ti := hiR.top; have tt := htR.top
  obtain ⟨hD, hK, hLst, hn, hl⟩ := hL
  have hqk : L.q * L.K ≤ L.D * L.q * L.K := by
    rw [mul_assoc]; exact Nat.le_mul_of_pos_left _ (by omega)
  have hbD : L.b ≤ L.b * L.D := Nat.le_mul_of_pos_right _ (by omega)
  have z : ∀ x : ℤ, -(U : ℤ) ≤ x → x ≤ U → zsz x ≤ zsz (U : ℤ) := fun x h1 h2 => NLogN.KFV.zB (by omega)
  refine ⟨⟨by simp only [Ex.Bnd, tt]; exact z _ (by omega) (by omega),
    by simp only [Ex.Bnd, tb]; exact z _ (by omega) (by omega),
    by simp only [Ex.eval, tt, tb]; exact z _ (by omega) (by omega)⟩, ?_⟩
  simp only [Ex.eval, tt, tb]
  split_ifs with h1
  · have hbt : t < L.b := by omega
    have e1 : ((L.b : ℤ) + -1 + -(t : ℤ)) * L.D = (((L.b - 1 - t) * L.D : ℕ) : ℤ) := by
      push_cast [Nat.cast_sub (show 1 ≤ L.b by omega), Nat.cast_sub (show t ≤ L.b - 1 by omega)]; ring
    have p1 : (L.b - 1 - t) * L.D + L.D ≤ L.b * L.D := by
      have : (L.b - 1 - t + 1) * L.D ≤ L.b * L.D := Nat.mul_le_mul_right _ (by omega)
      nlinarith
    have hDb : L.D ≤ L.b * L.D := Nat.le_mul_of_pos_left _ (by omega)
    simp only [preE, Ex.Bnd, Ex.eval, ti, tt, tb, td, tk, tq, tnl, tst, e1]
    refine ⟨?_, ⟨⟨⟨⟨?_, ?_, ?_⟩, ?_, ?_⟩, ?_, ?_⟩, ?_, ?_⟩, ?_⟩
    all_goals exact z _ (by omega) (by omega)
  · have hbt : L.b ≤ t := by omega
    have e := eE_val H ⟨hD, hK, hLst, hn, hl⟩ hiR htR hi ht hbt
    set ee := NLogN.KFV.eF L t
    have hee : ee + 1 ≤ L.q * L.K := by simp only [ee, NLogN.KFV.eF]; omega
    have hq1 : 1 ≤ L.q := by
      rcases Nat.eq_zero_or_pos L.q with hq | hq
      · rw [hq] at hee; omega
      · exact hq
    have hj : ee / L.K < L.q := by rw [Nat.div_lt_iff_lt_mul (by omega)]; omega
    have hm : ee % L.K < L.K := Nat.mod_lt _ (by omega)
    have h1' : (ee / L.K * L.D + i) * L.K + L.K ≤ L.D * L.q * L.K := by
      have : ee / L.K * L.D + i + 1 ≤ L.D * L.q := by
        have : (ee / L.K + 1) * L.D ≤ L.q * L.D := Nat.mul_le_mul_right _ hj
        nlinarith
      calc (ee / L.K * L.D + i) * L.K + L.K = (ee / L.K * L.D + i + 1) * L.K := by ring
        _ ≤ L.D * L.q * L.K := Nat.mul_le_mul_right _ this
    have hDq : L.D ≤ L.D * L.q * L.K := by
      rw [mul_assoc]; exact Nat.le_mul_of_pos_right _ (Nat.mul_pos hq1 (by omega))
    have hKq : L.K ≤ L.D * L.q * L.K := Nat.le_mul_of_pos_left _ (Nat.mul_pos (by omega) hq1)
    have f1 : ((L.q : ℤ) * L.K) = ((L.q * L.K : ℕ) : ℤ) := by push_cast; ring
    have f2 : ((ee : ℤ) / L.K) = ((ee / L.K : ℕ) : ℤ) := by rw [Int.natCast_div]
    have f3 : ((ee : ℤ) % L.K) = ((ee % L.K : ℕ) : ℤ) := by rw [Int.natCast_mod]
    have f4 : ((ee / L.K : ℕ) : ℤ) * L.D = ((ee / L.K * L.D : ℕ) : ℤ) := by push_cast; ring
    have f5 : (((ee / L.K * L.D : ℕ) : ℤ) + i) * L.K = (((ee / L.K * L.D + i) * L.K : ℕ) : ℤ) := by
      push_cast; ring
    have hj2 : ee / L.K * L.D ≤ (ee / L.K * L.D + i) * L.K :=
      le_trans (Nat.le_add_right _ _) (Nat.le_mul_of_pos_right _ (by omega))
    have heK : ee / L.K ≤ ee := Nat.div_le_self _ _
    simp only [chkE, NLogN.KFV.eE, Ex.Bnd, Ex.eval, ti, tt, tb, td, tk, tq, tnl, tst, e, f2, f3, f4, f5]
    have hqq : L.q ≤ L.q * L.K := Nat.le_mul_of_pos_right _ (by omega)
    generalize ee / L.K = dq at *
    generalize ee % L.K = dm at *
    have hj3 : dq * L.D + i ≤ (dq * L.D + i) * L.K := Nat.le_mul_of_pos_right _ (by omega)
    constructorm* _ ∧ _
    all_goals first | exact z _ (by omega) (by omega) | (rw [f1]; exact z _ (by omega) (by omega))

end PosE

theorem pushT_nil (g : Fin HS → List ℤ) : pushT g [] = g := by
  funext x; simp only [pushT, List.reverse_nil, List.map_nil, List.nil_append, Function.update_apply]
  split_ifs <;> subst_vars <;> rfl

theorem pushT_other (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (x : Fin HS) (h1 : x ≠ tbC)
    (h2 : x ≠ tbK) (h3 : x ≠ tbL) : pushT g T x = g x := by
  simp [pushT, Function.update_apply, h1, h2, h3]

theorem pushT_upd (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (x : Fin HS) (v : List ℤ)
    (h1 : x ≠ tbC) (h2 : x ≠ tbK) (h3 : x ≠ tbL) :
    Function.update (pushT g T) x v = pushT (Function.update g x v) T := by
  funext y
  simp only [pushT, Function.update_apply]
  split_ifs <;> subst_vars <;> simp_all

theorem gIn_ne {x : Fin HS} (hx : x ∈ NLogN.KFV.gIn) : x ≠ gT2 ∧ x ≠ tbC ∧ x ≠ tbK ∧ x ≠ tbL ∧ x ≠ NLogN.KFV.gT ∧
    x ≠ NLogN.KFV.gV ∧ x ≠ tbQ := by
  revert hx; revert x; decide

set_option maxHeartbeats 1000000 in
theorem termB_fsp (s : IState HS) (g : Fin HS → List ℤ) {L : NLogN.KFV.LP} {h i tp t U : ℕ}
    (H : GRegs s g L h) (hL : L.OK) (hiR : RV s g NLogN.KFV.gI i) (hpR : RV s g NLogN.KFV.gP tp)
    {l2 : List ℤ} (ht2 : g gT2 = (t : ℤ) :: l2) {op : Bool} {Q : ℕ}
    (hoR : RV s g NLogN.KFV.gV (opV op)) (hqR : RV s g tbQ Q) (hQU : Q ≤ U) (hQl : 2 ^ L.ℓ ≤ 2 * Q)
    (hi : i < L.D) (htp : tp < L.n)
    (hth : t < h) (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 2 ^ L.ℓ ≤ U) :
    FSp termB (NLogN.KIL.encK s g)
      (NLogN.KIL.encK s (Function.update (pushT g [(NLogN.KFV.tF op Q (L.ℓ - h + t), L.n - 1 - tp, L.n - 1 - posF L i t)])
        gT2 (((t + 1 : ℕ) : ℤ) :: l2)))
      (cTermB (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have z : ∀ x : ℤ, -(U : ℤ) ≤ x → x ≤ U → zsz x ≤ B := fun x h1 h2 => NLogN.KFV.zB (by omega)
  have hlU : L.ℓ ≤ U := le_trans (Nat.lt_two_pow_self).le h2l
  have hlB : L.ℓ + 1 ≤ B := by
    have := NLogN.KFV.zB (U := U) (x := ((2 : ℤ) ^ L.ℓ)) (by rw [Int.natAbs_pow]; simpa using h2l)
    rwa [NLogN.zsz_two_pow] at this
  have tH := H.h.top; have tl := H.l.top; have tn := H.n.top
  have t1 : RV s g gT2 t := RV.of_list ht2
  -- 2. the weight
  have hX : 2 ^ (L.ℓ - h + t) ≤ Q := by
    have : 2 ^ (L.ℓ - h + t) * 2 ≤ 2 ^ L.ℓ := by
      rw [← pow_succ]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hXU : 2 ^ (L.ℓ - h + t) ≤ U := le_trans hX hQU
  have v2 : Ex.eval (NLogN.KIL.encK s g) NLogN.KFV.tE = ((2 ^ (L.ℓ - h + t) : ℕ) : ℤ) := by
    simp only [NLogN.KFV.tE, Ex.eval, H.l.top, H.h.top, t1.top]
    rw [show (L.ℓ : ℤ) + -(h : ℤ) + t = ((L.ℓ - h + t : ℕ) : ℤ) by omega, Int.toNat_natCast]
    push_cast; rfl
  have okE : NLogN.KFV.tE.ok (NLogN.KIL.encK s g) :=
    ⟨⟨⟨H.l.isInt, H.h.isInt⟩, t1.isInt⟩, by simp only [Ex.eval, H.l.top, H.h.top, t1.top]; omega⟩
  have bE : NLogN.KFV.tE.Bnd (NLogN.KIL.encK s g) B :=
    ⟨⟨⟨by simp only [Ex.Bnd, H.l.top]; exact z _ (by omega) (by omega),
        by simp only [Ex.Bnd, H.h.top]; exact z _ (by omega) (by omega),
        by simp only [Ex.eval, H.l.top, H.h.top]; exact z _ (by omega) (by omega)⟩,
      by simp only [Ex.Bnd, t1.top]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, H.l.top, H.h.top, t1.top]; exact z _ (by omega) (by omega)⟩,
      by simp only [Ex.eval, H.l.top, H.h.top, t1.top]; omega⟩
  have hXe : (((2 ^ (L.ℓ - h + t) : ℕ) : ℤ)) ≤ Q := by exact_mod_cast hX
  have hXe' : (((2 ^ (L.ℓ - h + t) : ℕ) : ℤ)) ≤ U := by exact_mod_cast hXU
  have S2 := Sp.pushQ s g (i := tbC) (e := .sel (.reg NLogN.KFV.gV) NLogN.KFV.tE (.add (.reg tbQ) (.neg NLogN.KFV.tE)))
    (B := B) (by decide) (clean_lo (by decide))
    ⟨hoR.isInt, by
      cases op <;> simp only [Ex.eval, hoR.top, opV] <;> simp only [Bool.false_eq_true, if_false,
          if_true, show (-1 : ℤ) < 0 by norm_num, show ¬ ((0 : ℤ) < 0) by norm_num]
      · exact okE
      · exact ⟨hqR.isInt, okE⟩⟩
    ⟨by
      have := Nat.one_le_two_pow (n := L.ℓ)
      simp only [Ex.Bnd, hoR.top]; exact z _ (by cases op <;> simp [opV] <;> omega) (by cases op <;> simp [opV] <;> omega),
      by
        cases op <;> simp only [Ex.eval, hoR.top, opV] <;> simp only [Bool.false_eq_true, if_false,
          if_true, show (-1 : ℤ) < 0 by norm_num, show ¬ ((0 : ℤ) < 0) by norm_num]
        · exact bE
        · refine ⟨by simp only [Ex.Bnd, hqR.top]; exact z _ (by omega) (by omega), bE, ?_⟩
          have hq : (Q : ℤ) ≤ U := by exact_mod_cast hQU
          have hx0 : (0 : ℤ) ≤ ((2 ^ (L.ℓ - h + t) : ℕ) : ℤ) := by positivity
          simp only [Ex.eval, hqR.top, v2]; exact z _ (by linarith) (by linarith)⟩
  rw [show Ex.eval (NLogN.KIL.encK s g) (.sel (.reg NLogN.KFV.gV) NLogN.KFV.tE (.add (.reg tbQ) (.neg NLogN.KFV.tE))) =
      ((NLogN.KFV.tF op Q (L.ℓ - h + t) : ℕ) : ℤ) by
    cases op
    · simp [Ex.eval, hoR.top, opV, v2, NLogN.KFV.tF]
    · simp only [Ex.eval, hoR.top, opV, hqR.top, v2, NLogN.KFV.tF]; simp; push_cast [hX]; ring] at S2
  set g2 := Function.update g tbC (((NLogN.KFV.tF op Q (L.ℓ - h + t) : ℕ) : ℤ) :: g tbC)
  have H2 : GRegs s g2 L h := H.upd tbC (by decide) _
  have p2 : RV s g2 NLogN.KFV.gP tp := hpR.congr (by simp +decide [g2])
  -- 3. n-1-tp
  have S3 := Sp.push s g2 (i := tbK) (e := .add (.add (.reg gNn) (.lit (-1))) (.neg (.reg NLogN.KFV.gP))) (B := B)
    (by decide) (clean_lo (by decide)) ⟨⟨H2.n.isInt, trivial⟩, p2.isInt⟩ ⟨⟨trivial, trivial⟩, trivial⟩
    ⟨⟨by simp only [Ex.Bnd, H2.n.top]; exact z _ (by omega) (by omega),
        by simp only [Ex.Bnd]; exact z _ (by omega) (by omega),
        by simp only [Ex.eval, H2.n.top]; exact z _ (by omega) (by omega)⟩,
      by simp only [Ex.Bnd, p2.top]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, H2.n.top, p2.top]; exact z _ (by omega) (by omega)⟩
  rw [show Ex.eval (NLogN.KIL.encK s g2) (.add (.add (.reg gNn) (.lit (-1))) (.neg (.reg NLogN.KFV.gP))) =
    ((L.n - 1 - tp : ℕ) : ℤ) by simp only [Ex.eval, H2.n.top, p2.top]; omega] at S3
  set g3 := Function.update g2 tbK (((L.n - 1 - tp : ℕ) : ℤ) :: g2 tbK)
  have H3 : GRegs s g3 L h := H2.upd tbK (by decide) _
  have t3 : RV s g3 gT2 t := t1.congr (by simp +decide [g3, g2])
  have i3 : RV s g3 NLogN.KFV.gI i := hiR.congr (by simp +decide [g3, g2])
  -- 4. n-1-pos(i,t)
  have hpos := posF_lt hL hi (show t + 2 ≤ L.ℓ by omega)
  have pv := posE_eval H3 hL i3 t3 hi (by omega)
  have S4 := Sp.pushQ s g3 (i := tbL) (e := .add (.add (.reg gNn) (.lit (-1))) (.neg (posE NLogN.KFV.gI gT2)))
    (B := B) (by decide)
    (clean_add (clean_add (clean_reg (by decide)) (clean_lit _)) (fun j hj => clean_posE NLogN.KFV.gI gT2
      (by decide) (by decide) j (by simpa [Ex.regs] using hj)))
    ⟨⟨H3.n.isInt, trivial⟩, posE_ok H3 hL i3 t3 hi (by omega)⟩
    ⟨⟨by simp only [Ex.Bnd, H3.n.top]; exact z _ (by omega) (by omega),
        by simp only [Ex.Bnd]; exact z _ (by omega) (by omega),
        by simp only [Ex.eval, H3.n.top]; exact z _ (by omega) (by omega)⟩,
      posE_bnd H3 hL i3 t3 hi (by omega) hnU,
      by simp only [Ex.eval, H3.n.top, pv]; exact z _ (by omega) (by omega)⟩
  rw [show Ex.eval (NLogN.KIL.encK s g3) (.add (.add (.reg gNn) (.lit (-1))) (.neg (posE NLogN.KFV.gI gT2))) =
    ((L.n - 1 - posF L i t : ℕ) : ℤ) by simp only [Ex.eval, H3.n.top, pv]; omega] at S4
  set g4 := Function.update g3 tbL (((L.n - 1 - posF L i t : ℕ) : ℤ) :: g3 tbL)
  have hT4 : g4 gT2 = (t : ℤ) :: l2 := by simp +decide [g4, g3, g2, ht2]
  have tT4 := top_encK (s := s) hT4
  have S5 := Sp.asg s g4 (i := gT2) (e := .add (.reg gT2) (.lit 1)) (B := B) (by decide) hT4
    (z _ (by omega) (by omega)) (clean_lo (by decide)) ⟨isInt_encK hT4, trivial⟩ (by simp [Ex.Lin])
    ⟨by simp only [Ex.Bnd, tT4]; exact z _ (by omega) (by omega),
      by simp only [Ex.Bnd]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, tT4]; exact z _ (by omega) (by omega)⟩
  rw [show Ex.eval (NLogN.KIL.encK s g4) (.add (.reg gT2) (.lit 1)) = ((t + 1 : ℕ) : ℤ) by
    simp only [Ex.eval, tT4]; push_cast; ring] at S5
  have S := FSp.of_norep (p := termB) rfl (S2.seq (S3.seq (S4.seq S5)))
  refine (S.congr ?_).mono ?_
  · congr 1
  · have hB : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    simp only [cTermB, Ex.size, posE, preE, chkE, NLogN.KFV.eE, NLogN.KFV.tE]
    omega

theorem axTr_take_succ (L : NLogN.KFV.LP) (op : Bool) (Q h i tp k : ℕ) (hk : k < h) :
    (axTr L op Q h i tp).take (k + 1) =
      (axTr L op Q h i tp).take k ++ [(NLogN.KFV.tF op Q (L.ℓ - h + k), L.n - 1 - tp, L.n - 1 - posF L i k)] := by
  rw [List.take_succ]
  congr 1
  simp [axTr, List.getElem?_range hk]

theorem axTr_length (L : NLogN.KFV.LP) (op : Bool) (Q h i tp : ℕ) : (axTr L op Q h i tp).length = h := by simp [axTr]

theorem termB_writes : NLogN.KFV.gT ∉ termB.writes := by decide

theorem tLoop_fsp (s : IState HS) (g : Fin HS → List ℤ) {L : NLogN.KFV.LP} {h i tp U : ℕ}
    (H : GRegs s g L h) (hL : L.OK) (hiR : RV s g NLogN.KFV.gI i) (hpR : RV s g NLogN.KFV.gP tp)
    (hgT : g NLogN.KFV.gT = []) (hg2 : g gT2 = []) {op : Bool} {Q : ℕ}
    (hoR : RV s g NLogN.KFV.gV (opV op)) (hqR : RV s g tbQ Q) (hQU : Q ≤ U) (hQl : 2 ^ L.ℓ ≤ 2 * Q)
    (hi : i < L.D) (htp : tp < L.n)
    (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 2 ^ L.ℓ ≤ U) :
    FSp NLogN.KFV.tLoop (NLogN.KIL.encK s g) (NLogN.KIL.encK s (pushT g (axTr L op Q h i tp))) (cTLoop h (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have hlU : L.ℓ ≤ U := le_trans (Nat.lt_two_pow_self).le h2l
  have S0 := Sp.push s g (i := gT2) (e := .lit 0) (B := B) (by decide) (clean_lit _) trivial trivial
    (by simp only [Ex.Bnd]; exact NLogN.KFV.zB (by simp))
  rw [show Ex.eval (NLogN.KIL.encK s g) (.lit 0) :: g gT2 = [((0 : ℕ) : ℤ)] by simp [Ex.eval, hg2]] at S0
  set F : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (pushT g ((axTr L op Q h i tp).take k)) gT2 [(k : ℤ)]
  have hF0 : F 0 = Function.update g gT2 [((0 : ℕ) : ℤ)] := by simp [F, pushT_nil]
  have hFh : F h = Function.update (pushT g (axTr L op Q h i tp)) gT2 [(h : ℤ)] := by
    simp only [F]; rw [List.take_of_length_le (by rw [axTr_length])]
  have e1 : ∀ k (x : Fin HS), x ≠ tbC → x ≠ tbK → x ≠ tbL → x ≠ gT2 → F k x = g x :=
    fun k x a b c d => by simp only [F, Function.update_apply, d, if_false]; exact pushT_other _ _ _ a b c
  have L0 := FSp.repReg (C := NLogN.KFV.gT) (r := gH) (b := termB) (s := s) (F := F) (N := h)
    (c := cTermB B) (Bb := B) (by decide) (by decide)
    (fun k => by rw [e1 k NLogN.KFV.gT (by decide) (by decide) (by decide) (by decide), hgT])
    termB_writes (L := (H.h.choose))
    (by rw [encK_G, e1 0 gH (by decide) (by decide) (by decide) (by decide), ← encK_G];
        exact H.h.choose_spec)
    (NLogN.KFV.zB (by simp; omega)) ?_
  · rw [hF0] at L0
    rw [hFh] at L0
    have hP : (Function.update (pushT g (axTr L op Q h i tp)) gT2 [(h : ℤ)]) gT2 = (h : ℤ) :: [] := by
      simp
    have S2 := Sp.pop s _ (i := gT2) (B := B) (by decide) hP (NLogN.KFV.zB (by simp; omega))
    have S := (FSp.of_norep rfl S0).seq (L0.seq (FSp.of_norep rfl S2))
    refine (S.congr ?_).mono ?_
    · congr 1
      rw [Function.update_idem, Function.update_eq_self_iff.2]
      rw [pushT_other _ _ _ (by decide) (by decide) (by decide), hg2]
    · simp only [cTLoop, Ex.size]; omega
  intro k hk
  set gk := Function.update (F k) NLogN.KFV.gT [(h : ℤ) - k]
  have ek : ∀ x : Fin HS, x ≠ tbC → x ≠ tbK → x ≠ tbL → x ≠ gT2 → x ≠ NLogN.KFV.gT → gk x = g x :=
    fun x a b c d e => by simp only [gk, Function.update_apply, e, if_false]; exact e1 k x a b c d
  have Hk : GRegs s gk L h := H.congr fun r hr => by
    obtain ⟨d, a, b, c, e, _⟩ := gIn_ne hr; exact ek r a b c d e
  have T := termB_fsp s gk (t := k) (l2 := []) Hk hL (hiR.congr (ek _ (by decide) (by decide)
    (by decide) (by decide) (by decide))) (hpR.congr (ek _ (by decide) (by decide)
    (by decide) (by decide) (by decide))) (by simp +decide [gk, F, Function.update_apply])
    (hoR.congr (ek _ (by decide) (by decide) (by decide) (by decide) (by decide)))
    (hqR.congr (ek _ (by decide) (by decide) (by decide) (by decide) (by decide))) hQU hQl hi htp hk
    hhl hnU h2l
  refine T.congr ?_
  congr 1
  simp only [gk, F]
  rw [axTr_take_succ L op Q h i tp k hk]
  funext x
  by_cases xC : x = tbC
  · subst xC; simp +decide [pushT, Function.update_apply]
  by_cases xK : x = tbK
  · subst xK; simp +decide [pushT, Function.update_apply]
  by_cases xL : x = tbL
  · subst xL; simp +decide [pushT, Function.update_apply]
  by_cases x2 : x = gT2
  · subst x2; simp +decide [pushT, Function.update_apply]
  simp [pushT, Function.update_apply, xC, xK, xL, x2]

theorem AX_fsp (s : IState HS) (g : Fin HS → List ℤ) {L : NLogN.KFV.LP} {h i tp U : ℕ} (e : Ex HS)
    (hc : e.Clean) (hok : e.ok (NLogN.KIL.encK s g)) (hB : e.Bnd (NLogN.KIL.encK s g) (zsz (U : ℤ)))
    (hev : e.eval (NLogN.KIL.encK s g) = tp)
    (H : GRegs s g L h) (hL : L.OK) (hiR : RV s g NLogN.KFV.gI i)
    (hgT : g NLogN.KFV.gT = []) (hg2 : g gT2 = []) {op : Bool} {Q : ℕ}
    (hoR : RV s g NLogN.KFV.gV (opV op)) (hqR : RV s g tbQ Q) (hQU : Q ≤ U) (hQl : 2 ^ L.ℓ ≤ 2 * Q)
    (hi : i < L.D) (htp : tp < L.n)
    (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 2 ^ L.ℓ ≤ U) {m : ℕ} {lm : List ℤ}
    (hM : g tbM = (m : ℤ) :: lm) (hmU : m + h ≤ U) :
    FSp (AX e) (NLogN.KIL.encK s g)
      (NLogN.KIL.encK s (Function.update (pushT g (axTr L op Q h i tp)) tbM (((m + h : ℕ) : ℤ) :: lm)))
      (cAX e.size h (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have z : ∀ x : ℤ, -(U : ℤ) ≤ x → x ≤ U → zsz x ≤ B := fun x h1 h2 => NLogN.KFV.zB (by omega)
  have S1 := Sp.pushQ s g (i := NLogN.KFV.gP) (e := e) (B := B) (by decide) hc hok hB
  rw [hev] at S1
  set g1 := Function.update g NLogN.KFV.gP ((tp : ℤ) :: g NLogN.KFV.gP)
  have H1 : GRegs s g1 L h := H.upd NLogN.KFV.gP (by decide) _
  have S2 := tLoop_fsp s g1 (op := op) (Q := Q) H1 hL (hiR.congr (by simp +decide [g1]))
    (RV.of_list (l := g NLogN.KFV.gP) (by simp [g1])) (by simp +decide [g1, hgT]) (by simp +decide [g1, hg2])
    (hoR.congr (by simp +decide [g1])) (hqR.congr (by simp +decide [g1])) hQU hQl hi htp hhl hnU h2l
  set g2 := pushT g1 (axTr L op Q h i tp)
  have H2 : GRegs s g2 L h := H1.congr fun r hr => by
    obtain ⟨_, a, b, c, _⟩ := gIn_ne hr; exact pushT_other _ _ _ a b c
  have hM2 : g2 tbM = (m : ℤ) :: lm := by
    simp only [g2]; rw [pushT_other _ _ _ (by decide) (by decide) (by decide)]; simp +decide [g1, hM]
  have tM := top_encK (s := s) hM2
  have S3 := Sp.asg s g2 (i := tbM) (e := .add (.reg tbM) (.reg gH)) (B := B) (by decide) hM2
    (z _ (by omega) (by omega)) (clean_lo (by decide)) ⟨isInt_encK hM2, H2.h.isInt⟩ (by simp [Ex.Lin])
    ⟨by simp only [Ex.Bnd, tM]; exact z _ (by omega) (by omega),
      by simp only [Ex.Bnd, H2.h.top]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, tM, H2.h.top]; exact z _ (by omega) (by omega)⟩
  rw [show Ex.eval (NLogN.KIL.encK s g2) (.add (.reg tbM) (.reg gH)) = ((m + h : ℕ) : ℤ) by
    simp only [Ex.eval, tM, H2.h.top]; push_cast; ring] at S3
  set g3 := Function.update g2 tbM (((m + h : ℕ) : ℤ) :: lm)
  have hP3 : g3 NLogN.KFV.gP = (tp : ℤ) :: g gP := by
    simp only [g3, g2]; rw [Function.update_of_ne (by decide),
      pushT_other _ _ _ (by decide) (by decide) (by decide)]; simp [g1]
  have S4 := Sp.pop s g3 (i := NLogN.KFV.gP) (B := B) (by decide) hP3 (z _ (by omega) (by omega))
  have S := (FSp.of_norep rfl S1).seq (S2.seq ((FSp.of_norep rfl S3).seq (FSp.of_norep rfl S4)))
  refine (S.congr ?_).mono ?_
  · congr 1
    simp only [g3, g2, g1]
    rw [← pushT_upd _ _ _ _ (by decide) (by decide) (by decide), Function.update_comm (by decide),
      Function.update_idem, show Function.update (pushT g (axTr L op Q h i tp)) NLogN.KFV.gP (g NLogN.KFV.gP) =
        pushT g (axTr L op Q h i tp) from
        Function.update_eq_self_iff.2 (pushT_other _ _ _ (by decide) (by decide) (by decide)).symm]
  · simp only [cAX, Ex.size, B]
    omega

theorem axG_length_le (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h i : ℕ) :
    (NLogN.KFV.axG L fl op Q h i).length ≤ h := by
  unfold NLogN.KFV.axG; split_ifs <;> simp [axTr_length]

theorem posE_size : (posE NLogN.KFV.gI gH).size ≤ 100 := by decide

theorem rk_lt_count {fl : List Bool} {k : ℕ} (hk : fl.getD k false = true) :
    rk fl k < fl.count true := by
  unfold rk
  have hk' : k < fl.length := by
    by_contra h; rw [List.getD_eq_default _ _ (by omega)] at hk; exact absurd hk (by decide)
  conv_rhs => rw [← List.take_append_drop k fl]
  rw [List.count_append]
  have : fl.drop k = true :: fl.drop (k + 1) := by
    rw [List.drop_eq_getElem_cons hk']; congr 1
    rw [List.getD_eq_getElem _ _ hk'] at hk; exact hk
  rw [this, List.count_cons_self]; omega

theorem gIn_ne2 {x : Fin HS} (hx : x ∈ NLogN.KFV.gIn) : x ≠ gLG ∧ x ≠ gLG2 ∧ x ≠ gRk ∧ x ≠ NLogN.KFV.gA ∧ x ≠ NLogN.KFV.gI ∧
    x ≠ tbM ∧ x ≠ gP := by
  revert hx; revert x; decide

