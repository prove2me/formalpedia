theorem abelianSchemePropertyBundle_snd
    (L : GoodReductionJacobian.RelativeGroupLaw K (pullback.snd (projModelStrCR V) ιK)) :
    GoodReductionJacobian.AbelianSchemePropertyBundle K (pullback.snd (projModelStrCR V) ιK) where
  smooth := SmoothOfRelativeDimension.smooth 1 _
  proper := inferInstance
  connectedFibres s := by
