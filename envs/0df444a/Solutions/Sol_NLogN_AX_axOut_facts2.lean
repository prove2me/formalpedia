namespace NLogN.GL

open IntMul NLogN IntMul.HvdH.Ref

theorem chunkL_eq {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n) :
    chunkL n L = (List.range m).map fun i => (L.drop (i * n)).take n := by
  have : (L.length + n - 1) / n = m := by
    rw [hL]
    have : m * n + n - 1 = m * n + (n - 1) := by omega
    rw [this, Nat.add_comm, Nat.add_mul_div_right _ _ hn, Nat.div_eq_of_lt (by omega)]; simp
  simp only [chunkL, this]

theorem chunkL_length {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n) :
    (chunkL n L).length = m := by
  rw [chunkL_eq n m L hn hL]; simp

theorem chunkL_mem {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n)
    (x : List α) (hx : x ∈ chunkL n L) : x.length = n ∧ ∀ z ∈ x, z ∈ L := by
  rw [chunkL_eq n m L hn hL] at hx
  simp only [List.mem_map, List.mem_range] at hx
  obtain ⟨i, hi, rfl⟩ := hx
  refine ⟨?_, fun z hz => List.mem_of_mem_drop (List.mem_of_mem_take hz)⟩
  simp only [List.length_take, List.length_drop, hL]
  have : n ≤ m * n - i * n := by
    have : (i + 1) * n ≤ m * n := Nat.mul_le_mul_right _ hi
    rw [Nat.succ_mul] at this; omega
  omega

theorem transposeL_length {α : Type*} [Inhabited α] (n m : ℕ) (L : List α) :
    (transposeL n m L).length = m * n := by simp [transposeL]

theorem transposeL_mem {α : Type*} [Inhabited α] (n m : ℕ) (L : List α) (z : α)
    (hz : z ∈ transposeL n m L) : z ∈ L ∨ z = default := by
  simp only [transposeL, List.mem_map, List.mem_range] at hz
  obtain ⟨q, _, rfl⟩ := hz
  rw [List.getD_eq_getElem?_getD]
  cases h : L[q % n * m + q / n]? with
  | none => right; rfl
  | some w => left; simp only [Option.getD_some]; exact List.mem_of_getElem? h

theorem GB_transposeL (B n m : ℕ) (L : List (ℤ × ℤ)) (h : GB B L) : GB B (transposeL n m L) := by
  intro z hz
  rcases transposeL_mem n m L z hz with h1 | h1
  · exact h z h1
  · subst h1; simp [default, zsz_zero]

end NLogN.GL

