  have hB1' : ((NLogN.KFU.cMv VT (p + 2) : ℕ) : ℝ) + 1 ≤ 10 ^ 6 * ((T : ℝ) * p) := by exact_mod_cast hB1
  have hVT' : ((VT : ℕ) : ℝ) + 1 ≤ 3 * T := by
