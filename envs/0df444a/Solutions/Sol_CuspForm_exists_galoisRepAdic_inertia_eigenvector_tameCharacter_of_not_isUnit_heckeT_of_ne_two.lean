        (_ : f ^ q = 1)
        (_ : ∀ σ ∈ P.inertiaSubgroupIn ℚ,
          ∀ g : WithConv (H →ₐ[GaloisRep.ratLocalizedAt q] AlgebraicClosure ℚ),
            (∀ h : H, g h = σ (f h)) → g = f ^ n σ),
        f = 1)
