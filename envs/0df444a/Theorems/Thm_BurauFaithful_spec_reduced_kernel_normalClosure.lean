-- title:
--   Kernel of the $t=-1$ specialization lies in the normal closure of $\Delta^4$
-- statement:
--   **The kernel of the specialization at $t=-1$ lies in the normal closure of the full twist.**
--
--   Let $\rho_3^{\mathrm{red}}$ be the reduced Burau representation of the three-strand braid group $B_3$ and let $\varphi$ be its specialization at $t=-1$, a homomorphism
--   $$\varphi : B_3 \longrightarrow \mathrm{SL}(2,\mathbb Z),\qquad \sigma_1\mapsto\begin{pmatrix}1&-1\\0&1\end{pmatrix},\quad \sigma_2\mapsto\begin{pmatrix}2&-1\\1&0\end{pmatrix}.$$
--   Then every braid killed by $\varphi$ lies in the **normal closure** of the full twist
--   $$\Delta^4=(\sigma_1\sigma_2)^6 ,$$
--   i.e.
--   $$\varphi(\beta)=1\ \Longrightarrow\ \beta\in\bigl\langle\!\bigl\langle(\sigma_1\sigma_2)^6\bigr\rangle\!\bigr\rangle .$$
--
--   Equivalently, $\varphi$ induces a *section* of $B_3$ over its image — the amalgam/Coxeter–Moser structure of $\mathrm{SL}(2,\mathbb Z)$: the kernel of the specialization is generated by the single central element $\Delta^4$, the only relation of the modular group that is not already a braid relation (Birman, *Braids, Links, and Mapping Class Groups*, Ann. of Math. Studies 82, §3.3, pp. 129–130, citing Moser–Coxeter 1964, p. 85). Combined with the fact that the normal closure of the central element $(\sigma_1\sigma_2)^6$ is its cyclic subgroup, this yields immediately the classical statement that the kernel consists exactly of the powers $(\sigma_1\sigma_2)^{6k}$.
-- source:
--   J. S. Birman, *Braids, Links, and Mapping Class Groups*, Ann. of Math. Studies 82, Princeton Univ. Press, 1974, §3.3, pp. 129-130; C. Moser, H. S. M. Coxeter, *Generators and relations for discrete groups*, 2nd ed., Springer 1964, p. 85.

import Definitions.Def_BurauFaithful_UnreducedBurau

set_option autoImplicit false

open Matrix BraidsLinksMCG

/-- The images of the two Artin generators under the `t = -1` specialization of the reduced
Burau representation (the two integral matrices of `BurauFaithful.burau_three_spec_reduction`). -/
noncomputable def BurauFaithful.redGen : Fin 2 → Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  fun i => if (i : ℕ) = 0 then ⟨!![1, -1; 0, 1], by decide⟩ else ⟨!![2, -1; 1, 0], by decide⟩

lemma BurauFaithful.redGen_braid :
    ∀ r ∈ braidRels 3, FreeGroup.lift BurauFaithful.redGen r = 1 := by
  intro r hr
  simp only [braidRels, Set.mem_union] at hr
  rcases hr with ⟨i, j, h, rfl⟩ | ⟨i, j, h, rfl⟩
  · exfalso
    fin_cases i <;> fin_cases j <;> norm_num at h
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of]
    rw [mul_inv_eq_one]
    fin_cases i <;> fin_cases j <;>
      first
        | (exfalso; omega)
        | (ext a b; fin_cases a <;> fin_cases b <;> decide)

/-- The `t = -1` specialization of the reduced Burau representation of `B₃`, as a homomorphism
sending the generators to `!![1, -1; 0, 1]` and `!![2, -1; 1, 0]`. -/
noncomputable def BurauFaithful.redHom3 :
    BraidsLinksMCG.ArtinBraidGroup 3 →* Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  PresentedGroup.toGroup BurauFaithful.redGen_braid

theorem BurauFaithful.spec_reduced_kernel_normalClosure (β : BraidsLinksMCG.ArtinBraidGroup 3) :
    BurauFaithful.redHom3 β = 1 →
      β ∈ Subgroup.normalClosure
        ({(BraidsLinksMCG.sigma ⟨0, by decide⟩ * BraidsLinksMCG.sigma ⟨1, by decide⟩) ^ 6} :
          Set (BraidsLinksMCG.ArtinBraidGroup 3)) := by sorry
