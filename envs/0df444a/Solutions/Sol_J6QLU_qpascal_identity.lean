-- Source module: Solutions.J6QLUBasic
/-!
# q-Pochhammer symbols and Gaussian binomials (algebraic core of the segmented-inverse q-LU)

Over an arbitrary field `K`:
* `qpoch q n = (q;q)_n = ∏_{i<n} (1 - q^(i+1))`,
* `qbin q n k` = Gaussian binomial `[n k]_q`, defined by the q-Pascal recurrence
  `[n+1, k+1] = [n, k] + q^(k+1) [n, k+1]`,
* `qbin_mul_qpoch` : `[n k] (q;q)_k (q;q)_{n-k} = (q;q)_n`,
* `qbin_rothe` (q-binomial theorem / Rothe):
  `∑_{j ≤ h} (-1)^j q^(j choose 2) [h j] y^j = ∏_{i<h} (1 - y q^i)`,
* `qbin_alt_sum` : `∑_{j ≤ h} (-1)^j q^(j choose 2) [h j] = δ_{h0}`,
* `qpascal_identity` (q-Newton type identity behind the LU factor):
  `∑_{k ≤ u} [u k] (q^(v-k+1);q)_k q^((u-k)(v-k)) = 1`.
-/

open Finset

namespace J6QLU

variable {K : Type*} [Field K]

@[simp] lemma qbin_zero_right (q : K) (n : ℕ) : qbin q n 0 = 1 := by
  cases n <;> simp [qbin]

@[simp] lemma qbin_zero_succ (q : K) (k : ℕ) : qbin q 0 (k + 1) = 0 := by simp [qbin]

lemma qbin_succ_succ (q : K) (n k : ℕ) :
    qbin q (n + 1) (k + 1) = qbin q n k + q ^ (k + 1) * qbin q n (k + 1) := by simp [qbin]

lemma qbin_eq_zero_of_lt (q : K) : ∀ {n k : ℕ}, n < k → qbin q n k = 0
  | 0, k + 1, _ => by simp
  | n + 1, k + 1, h => by
    rw [qbin_succ_succ, qbin_eq_zero_of_lt q (by omega : n < k),
      qbin_eq_zero_of_lt q (by omega : n < k + 1)]
    ring

lemma qfall_zero (q : K) (v : ℕ) : qfall q v 0 = 1 := by simp [qfall]

lemma qfall_succ (q : K) (v k : ℕ) :
    qfall q (v + 1) (k + 1) = (1 - q ^ (v + 1)) * qfall q v k := by
  rw [qfall, prod_range_succ', mul_comm]
  congr 1
  refine prod_congr rfl fun i _ => ?_
  congr 2; omega

lemma qfall_eq_zero (q : K) {v k : ℕ} (h : v < k) : qfall q v k = 0 :=
  prod_eq_zero (mem_range.2 h) (by simp)

/-- q-Newton / q-Vandermonde-type identity behind `T = Γ L Γ⁻¹ U Γ`:
`∑_{k ≤ u} [u k] (q^(v-k+1);q)_k q^((u-k)(v-k)) = 1` for all `u v`. -/
lemma qpascal_identity_sol_aux (q : K) : ∀ (u v : ℕ),
    ∑ k ∈ range (u + 1), qbin q u k * qfall q v k * q ^ ((u - k) * (v - k)) = 1
  | 0, v => by simp [qfall_zero]
  | u + 1, 0 => by
    rw [sum_range_succ']
    simp only [qbin_zero_right, qfall_zero, Nat.sub_zero, mul_zero, pow_zero, mul_one]
    rw [sum_eq_zero fun i _ => by rw [qfall_eq_zero q (by omega : 0 < i + 1)]; ring]
    simp
  | u + 1, w + 1 => by
    have ih1 := qpascal_identity_sol_aux q u w
    have ih2 := qpascal_identity_sol_aux q u (w + 1)
    rw [sum_range_succ']
    simp only [qbin_succ_succ, add_mul, sum_add_distrib, Nat.add_sub_add_right]
    have hX : ∑ i ∈ range (u + 1), qbin q u i * qfall q (w + 1) (i + 1) *
        q ^ ((u - i) * (w - i)) = 1 - q ^ (w + 1) := by
      calc _ = (1 - q ^ (w + 1)) *
            ∑ k ∈ range (u + 1), qbin q u k * qfall q w k * q ^ ((u - k) * (w - k)) := by
            rw [mul_sum]; refine sum_congr rfl fun i _ => ?_; rw [qfall_succ]; ring
        _ = _ := by rw [ih1, mul_one]
    have hL : ∑ i ∈ range (u + 1), q ^ (i + 1) * qbin q u (i + 1) * qfall q (w + 1) (i + 1) *
        q ^ ((u - i) * (w - i)) = ∑ i ∈ range u, q ^ (i + 1) * qbin q u (i + 1) *
        qfall q (w + 1) (i + 1) * q ^ ((u - i) * (w - i)) := by
      rw [sum_range_succ, qbin_eq_zero_of_lt q (by omega : u < u + 1)]; simp
    have hR : ∑ k ∈ range (u + 1), qbin q u k * qfall q (w + 1) k * q ^ ((u - k) * (w + 1 - k)) =
        ∑ i ∈ range u, qbin q u (i + 1) * qfall q (w + 1) (i + 1) *
          q ^ ((u - (i + 1)) * (w + 1 - (i + 1))) +
        qbin q u 0 * qfall q (w + 1) 0 * q ^ ((u - 0) * (w + 1 - 0)) := sum_range_succ' _ _
    have hY : ∑ i ∈ range (u + 1), q ^ (i + 1) * qbin q u (i + 1) * qfall q (w + 1) (i + 1) *
        q ^ ((u - i) * (w - i)) +
        qbin q (u + 1) 0 * qfall q (w + 1) 0 * q ^ ((u + 1 - 0) * (w + 1 - 0)) = q ^ (w + 1) := by
      calc _ = q ^ (w + 1) * ∑ k ∈ range (u + 1), qbin q u k * qfall q (w + 1) k *
            q ^ ((u - k) * (w + 1 - k)) := by
            rw [hL, hR, mul_add, mul_sum]
            congr 1
            · refine sum_congr rfl fun i hi => ?_
              rw [mem_range] at hi
              rcases Nat.lt_or_ge w i with hwi | hwi
              · rw [qfall_eq_zero q (by omega : w + 1 < i + 1)]; ring
              · obtain ⟨a, rfl⟩ := Nat.exists_eq_add_of_lt hi
                obtain ⟨b, rfl⟩ := Nat.exists_eq_add_of_le hwi
                have e1 : i + a + 1 - i = a + 1 := by omega
                have e2 : i + b - i = b := by omega
                have e3 : i + a + 1 - (i + 1) = a := by omega
                have e4 : i + b + 1 - (i + 1) = b := by omega
                rw [e1, e2, e3, e4]
                have : q ^ (i + 1) * q ^ ((a + 1) * b) = q ^ (i + b + 1) * q ^ (a * b) := by
                  rw [← pow_add, ← pow_add]; congr 1; ring
                linear_combination (qbin q (i + a + 1) (i + 1) * qfall q (i + b + 1) (i + 1)) * this
            · simp [qfall_zero]; ring
        _ = _ := by rw [ih2, mul_one]
    linear_combination hX + hY

end J6QLU

end

theorem solution.{u_1} : type_of% @J6QLU.qpascal_identity_sol_aux.{u_1} := @J6QLU.qpascal_identity_sol_aux.{u_1}
