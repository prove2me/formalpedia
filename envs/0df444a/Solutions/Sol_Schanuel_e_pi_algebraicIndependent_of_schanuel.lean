import Mathlib

/-!
# Schanuel's conjecture implies that `e` and `π` are algebraically independent

This file derives, from Schanuel's conjecture, the algebraic independence of `e` and `π`
over `ℚ`.

The argument: apply Schanuel's conjecture to the `ℚ`-linearly independent pair `z = (1, iπ)`.
Since `exp 1 = e` and `exp (iπ) = -1`, the field generated by `z` and `exp z` is `ℚ(iπ, e)`,
so Schanuel gives `trdeg_ℚ ℚ(iπ, e) ≥ 2`; a field generated by two elements whose transcendence
degree is at least two is generated by an algebraically independent pair, hence `iπ` and `e`
are algebraically independent.  Finally, `π = (-i) · (iπ)` and `-i` is algebraic over `ℚ`,
so `π` and `e` are algebraically independent as well.
-/

open Cardinal Set Polynomial

namespace SchanuelEPi

open scoped IntermediateField.algebraAdjoinAdjoin

universe u v

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]

/-- Inside the field `F⟮range x⟯`, adjoining the (lifted) elements of `range x` gives everything. -/
theorem adjoin_range_lift_eq_top {ι : Type v} (x : ι → E) :
    IntermediateField.adjoin F
      (Set.range fun i : ι => (⟨x i, IntermediateField.subset_adjoin F _ ⟨i, rfl⟩⟩ :
        IntermediateField.adjoin F (Set.range x))) = ⊤ := by
  have htop : IntermediateField.map (IntermediateField.adjoin F (Set.range x)).val ⊤
      = IntermediateField.adjoin F (Set.range x) := by
    apply le_antisymm
    · rintro e ⟨y, -, rfl⟩
      exact y.2
    · intro e he
      exact ⟨⟨e, he⟩, IntermediateField.mem_top, rfl⟩
  apply IntermediateField.map_injective (IntermediateField.adjoin F (Set.range x)).val
  rw [IntermediateField.adjoin_map, htop]
  congr 1
  ext e
  simp [Set.mem_image, Set.mem_range]

/-- Every element of a field is algebraic over the top intermediate field. -/
instance isAlgebraic_top : Algebra.IsAlgebraic (⊤ : IntermediateField F E) E := by
  constructor
  intro x
  exact ⟨X - C ⟨x, IntermediateField.mem_top⟩, X_sub_C_ne_zero _, by simp⟩

/-- If the field generated over `F` by a finite family `x` has transcendence degree at least
the cardinality of the index type, then the family is algebraically independent. -/
theorem algebraicIndependent_of_le_trdeg_adjoin {ι : Type v} [Finite ι] (x : ι → E)
    (h : #ι ≤ Algebra.trdeg F (IntermediateField.adjoin F (Set.range x))) :
    AlgebraicIndependent F x := by
  set K := IntermediateField.adjoin F (Set.range x) with hK
  set y : ι → K := fun i => ⟨x i, IntermediateField.subset_adjoin F _ ⟨i, rfl⟩⟩ with hy
  have halg : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range y)) K := by
    rw [← IntermediateField.isAlgebraic_adjoin_iff_top, adjoin_range_lift_eq_top x]
    infer_instance
  have hbasis : IsTranscendenceBasis F y :=
    Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite F y h
  have hmapped := hbasis.1.map' (f := K.val) Subtype.val_injective
  have hcomp : (K.val ∘ y) = x := by funext i; rfl
  rwa [hcomp] at hmapped

/-- The pair `(1, iπ)` is linearly independent over `ℚ`. -/
theorem linearIndependent_one_I_mul_pi :
    LinearIndependent ℚ ![(1 : ℂ), Complex.I * (Real.pi : ℂ)] := by
  rw [LinearIndependent.pair_iff]
  intro s t hst
  have h1 : (s : ℂ) * 1 + (t : ℂ) * (Complex.I * (Real.pi : ℂ)) = 0 := by
    simpa [Rat.smul_def] using hst
  have him : (t : ℝ) * Real.pi = 0 := by
    have := congrArg Complex.im h1
    simpa using this
  have ht : t = 0 := by
    rcases mul_eq_zero.mp him with h | h
    · exact_mod_cast h
    · exact absurd h Real.pi_ne_zero
  subst ht
  have hs : (s : ℂ) = 0 := by simpa using h1
  exact ⟨by exact_mod_cast hs, rfl⟩

/-- The field generated by `1, iπ` and their exponentials is `ℚ(iπ, e)`. -/
theorem adjoin_schanuel_data_eq :
    IntermediateField.adjoin ℚ (Set.range ![(1 : ℂ), Complex.I * (Real.pi : ℂ)] ∪
        Set.range (Complex.exp ∘ ![(1 : ℂ), Complex.I * (Real.pi : ℂ)]))
      = IntermediateField.adjoin ℚ (Set.range ![Complex.I * (Real.pi : ℂ), Complex.exp 1]) := by
  have hexp : Complex.exp (Complex.I * (Real.pi : ℂ)) = -1 := by
    rw [mul_comm]
    simp [Complex.exp_pi_mul_I]
  apply le_antisymm
  · rw [IntermediateField.adjoin_le_iff]
    rintro w (⟨i, rfl⟩ | ⟨i, rfl⟩) <;> fin_cases i
    · exact one_mem _
    · exact IntermediateField.subset_adjoin _ _ ⟨0, rfl⟩
    · exact IntermediateField.subset_adjoin _ _ ⟨1, rfl⟩
    · show Complex.exp (![(1 : ℂ), Complex.I * (Real.pi : ℂ)] 1) ∈ _
      rw [show ![(1 : ℂ), Complex.I * (Real.pi : ℂ)] 1 = Complex.I * (Real.pi : ℂ) from rfl, hexp]
      exact neg_mem (one_mem _)
  · rw [IntermediateField.adjoin_le_iff]
    rintro w ⟨i, rfl⟩
    fin_cases i
    · exact IntermediateField.subset_adjoin _ _ (Or.inl ⟨1, rfl⟩)
    · exact IntermediateField.subset_adjoin _ _ (Or.inr ⟨0, rfl⟩)

/-- Removing the factor `i`: if `iπ` and `e` are algebraically independent over `ℚ`, then so
are `π` and `e`. -/
theorem algebraicIndependent_pi_exp_of_I_mul_pi
    (h : AlgebraicIndependent ℚ ![Complex.I * (Real.pi : ℂ), Complex.exp 1]) :
    AlgebraicIndependent ℚ ![(Real.pi : ℂ), Complex.exp 1] := by
  have hmem : -Complex.I ∈ algebraicClosure ℚ ℂ := by
    refine ⟨X ^ 2 + C 1, ?_, ?_⟩
    · exact monic_X_pow_add (by simp)
    · simp [Complex.I_sq]
  set c : algebraicClosure ℚ ℂ := ⟨-Complex.I, hmem⟩ with hc
  have hcne : c ≠ 0 := by simp [hc, Subtype.ext_iff, Complex.I_ne_zero]
  haveI : Algebra.IsAlgebraic ℚ (algebraicClosure ℚ ℂ) := algebraicClosure.isAlgebraic ℚ ℂ
  have h2 : AlgebraicIndependent (algebraicClosure ℚ ℂ)
      ![Complex.I * (Real.pi : ℂ), Complex.exp 1] := h.extendScalars _
  have hf : ∀ i : Fin 2, Transcendental (algebraicClosure ℚ ℂ) (![C c * X, X] i) := by
    intro i
    fin_cases i
    · show Transcendental (algebraicClosure ℚ ℂ) (C c * X)
      refine Polynomial.transcendental _ ?_ ?_
      · simp [natDegree_C_mul_X _ hcne]
      · rw [leadingCoeff_C_mul_X]
        exact mem_nonZeroDivisors_of_ne_zero hcne
    · show Transcendental (algebraicClosure ℚ ℂ) X
      exact Polynomial.transcendental_X _
  have h3 := h2.polynomial_aeval_of_transcendental (f := ![C c * X, X]) hf
  have heq :
      (fun i => Polynomial.aeval (![Complex.I * (Real.pi : ℂ), Complex.exp 1] i) (![C c * X, X] i))
        = ![(Real.pi : ℂ), Complex.exp 1] := by
    funext i
    fin_cases i
    · show Polynomial.aeval (Complex.I * (Real.pi : ℂ)) (C c * X) = _
      simp [hc]
      ring_nf
      simp [Complex.I_sq]
    · show Polynomial.aeval (Complex.exp 1) X = _
      simp
  rw [heq] at h3
  exact h3.restrictScalars (algebraMap ℚ (algebraicClosure ℚ ℂ)).injective

end SchanuelEPi

/-- **Schanuel's conjecture implies that `e` and `π` are algebraically independent over `ℚ`.** -/
theorem solution
    (schanuel : ∀ (n : ℕ) (z : Fin n → ℂ), LinearIndependent ℚ z →
      (n : Cardinal) ≤ Algebra.trdeg ℚ
        (IntermediateField.adjoin ℚ (Set.range z ∪ Set.range (Complex.exp ∘ z)))) :
    AlgebraicIndependent ℚ ![Complex.exp 1, (Real.pi : ℂ)] := by
  have hz := schanuel 2 ![(1 : ℂ), Complex.I * (Real.pi : ℂ)]
    SchanuelEPi.linearIndependent_one_I_mul_pi
  rw [SchanuelEPi.adjoin_schanuel_data_eq] at hz
  have hcard : #(Fin 2) ≤ Algebra.trdeg ℚ
      (IntermediateField.adjoin ℚ (Set.range ![Complex.I * (Real.pi : ℂ), Complex.exp 1])) := by
    simpa using hz
  have hindep : AlgebraicIndependent ℚ ![Complex.I * (Real.pi : ℂ), Complex.exp 1] :=
    SchanuelEPi.algebraicIndependent_of_le_trdeg_adjoin _ hcard
  have hpi := SchanuelEPi.algebraicIndependent_pi_exp_of_I_mul_pi hindep
  have hswap := hpi.comp (Equiv.swap (0 : Fin 2) 1) (Equiv.injective _)
  have : (![(Real.pi : ℂ), Complex.exp 1] ∘ (Equiv.swap (0 : Fin 2) 1))
      = ![Complex.exp 1, (Real.pi : ℂ)] := by
    funext i
    fin_cases i <;> simp [Equiv.swap_apply_left, Equiv.swap_apply_right]
  rwa [this] at hswap

