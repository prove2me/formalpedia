    exact contDiffOn_bstar Rh Ri Q j 1 (fun x hx => by have := hx.1; intro h; rw [h] at this; linarith)
  · refine ⟨|kc Rh Ri Q j|, abs_nonneg _, Rh + 1, by linarith, fun R hR => ?_⟩
    have hR0 : 0 < R := by linarith
    rw [(hasDerivAt_bstar Rh Ri Q j hR0.ne').deriv, bstar_eq]
    refine ⟨le_of_eq ?_, le_of_eq ?_⟩
    · rw [abs_div, abs_of_pos hR0]
    · rw [abs_div, abs_neg, abs_of_pos (by positivity : (0 : ℝ) < R ^ 2)]

