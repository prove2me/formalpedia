-- title:
--   (4.16) — one inexact step decreases $J$ by $\frac{\beta}{L}\|\nabla J(w_k)\|^2$
-- statement:
--   Let $J : \mathbb{R}^m \to \mathbb{R}$ be twice continuously differentiable with Hessian bounds $\lambda\|d\|^2 \le d^T\nabla^2J(w)d \le L\|d\|^2$ for all $w, d$, where $0<\lambda<L$ (assumption (4.2)). Let $\theta \in (0,1)$, let $(g_k)_{k\ge0}$ be arbitrary vectors of $\mathbb{R}^m$, and let $(w_k)$ be generated by the fixed-step iteration (4.1) with steplength (4.7),
--
--   $$
--   w_{k+1} = w_k - \frac{1-\theta}{L}\, g_k .
--   $$
--
--   If at iteration $k$ the approximate gradient satisfies (4.8), $\|g_k - \nabla J(w_k)\| \le \theta\|g_k\|$, then
--
--   $$
--   J(w_{k+1}) \;\le\; J(w_k) - \frac{\beta}{L}\,\|\nabla J(w_k)\|^2, \qquad \beta = \frac{(1-\theta)^2}{2(1+\theta)^2}.
--   $$
--
--   This is the sufficient-decrease estimate that summarizes the chain (4.15). Combined with (4.5) it yields the contraction (4.9).
--
--   **Formalization Note** Only (4.8) at the single index $k$ is assumed. The iterates are any sequence satisfying the recursion for every $k$; $\beta$ is `beta θ`.
-- source:
--   Byrd, Chin, Nocedal, Wu, Sample size selection in optimization methods for machine learning, Math. Program. (2012), doi:10.1007/s10107-012-0572-5 — authors' version of 18 Oct 2011, p. 9, (4.15)–(4.16)

import Mathlib
import Definitions.Def_DynSampleSize_Det_Setting

open Filter Topology

namespace DynSampleSize.Det

theorem eq_4_16 {m : ℕ} (J : EuclideanSpace ℝ (Fin m) → ℝ) (lam L : ℝ)
    (hJ : HessianBounds J lam L) (θ : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1)
    (g w : ℕ → EuclideanSpace ℝ (Fin m))
    (hw : ∀ k, w (k + 1) = w k - ((1 - θ) / L) • g k) (k : ℕ)
    (h48 : ‖g k - gradient J (w k)‖ ≤ θ * ‖g k‖) :
    J (w (k + 1)) ≤ J (w k) - beta θ / L * ‖gradient J (w k)‖ ^ 2 := by sorry

end DynSampleSize.Det
