  set Hs : ↥SS → Divisor (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) := fun s => Dh.filter (· ∈ (An s).dom) with hHs
  have hHs_apply : ∀ (s : ↥SS), ∀ P ∈ (An s).dom, Hs s P = P.ord h := fun s P hP => by
