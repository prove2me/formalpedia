-- url     : https://prove2.me/theorems/f6e09dbb-9901-447d-8e03-4c4778aa2562
-- title:
--   $\mathcal R$-trivial monoid
-- statement:
--   For an element $x$ of a monoid $M$, the **right ideal** generated by $x$ is $xM=\{xs : s\in M\}$. Green's relation $\mathcal R$ relates $x$ and $y$ when $xM=yM$. The monoid is **$\mathcal R$-trivial** if this relation is the identity:
--
--   $$xM=yM\ \Longrightarrow\ x=y\qquad(x,y\in M).$$
--
--   This is one of the three Green-triviality conditions used in the structure theory of aperiodic monoids; Proposition 19 shows that finite commutative aperiodic monoids satisfy all three.
-- source:
--   Lee–Santha, The quantum query complexity of the semigroup product problem, arXiv:2609.39974 (held version, sha256 9eec405d…ffb6), §3, Ideals and Green's preorders, pp.22–23

import Mathlib

namespace MonoidProdQ

/-- Lee–Santha, *The quantum query complexity of the semigroup product problem*,
arXiv:2609.39974 (held version, sha256 9eec405d…ffb6), §3, "Ideals and Green's preorders", pp.22–23: the right ideal generated by `m` is
`mM = {ms : s ∈ M}`, `x R y ⟺ xM = yM`, and "A monoid is R-trivial if xM = yM implies x = y".
The right ideal `xM` is written `Set.range (fun s => x * s)`. -/
def IsRTrivial (M : Type*) [Monoid M] : Prop :=
  ∀ x y : M, Set.range (fun s : M => x * s) = Set.range (fun s : M => y * s) → x = y

end MonoidProdQ


