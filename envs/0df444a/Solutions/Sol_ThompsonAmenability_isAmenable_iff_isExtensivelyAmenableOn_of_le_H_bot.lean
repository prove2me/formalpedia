/-!
# The jump function of `H(ℤ)`: germs, logarithmic derivatives, translation germ

For `f ∈ H(ℤ)` and a real `t`, the one-sided germs of `f` at `t` are Möbius maps `mob γ₋`,
`mob γ₊`, and `log f'₊(t) - log f'₋(t) = log (mu γ₋ t)² - log (mu γ₊ t)²` (`jumpFun`, real
valued: the lamps are `(ℝ, +)`). At `∞` we record instead the translation amount `tau f` of the
germ of `f` at `+∞` (an element of `SL(2, ℤ)` fixing `∞` acts as `x ↦ x + n`). Since `∞` is fixed
by `H(ℤ)`, `g ↦ jumpFun g` is a cocycle: `jumpFun (g h) x = jumpFun g (h x) + jumpFun h x`.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

/-- `H(ℤ)`. -/
abbrev HZ := H (⊥ : Subring ℝ)

lemma H_smul (g : H (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    g • x = (g : OnePoint ℝ ≃ₜ OnePoint ℝ) x := rfl

/-! ### Basic facts on `H(ℤ)` -/

lemma exists_real_of_fix {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∞ = ∞) (t : ℝ) :
    ∃ s : ℝ, f t = s := by
  have : f t ≠ ∞ := by
    intro h
    rw [← hf] at h
    exact coe_ne_infty t (f.injective h)
  exact OnePoint.ne_infty_iff_exists.1 this |>.imp fun s hs => hs.symm

/-- `H(ℤ)` preserves `P_ℤ`. -/
lemma smul_mem_P (g : HZ) {p : OnePoint ℝ} (hp : p ∈ P (⊥ : Subring ℝ)) :
    g • p ∈ P (⊥ : Subring ℝ) := by
  obtain ⟨γ, hγ⟩ := orbit_of_mem_G g.2.1 p
  rw [H_smul, hγ]
  exact mob_mem_P' hp γ

/-! ### Chosen germs -/

/-! ### Logarithmic derivatives -/

/-! ### The translation germ at `+∞` -/

lemma upper_of_fix {k : SLZ} (h : mob k ∞ = ∞) :
    ent k 1 0 = 0 ∧ ent k 0 0 = ent k 1 1 ∧ ent k 1 1 * ent k 1 1 = 1 := by
  have hc : ent k 1 0 = 0 := by
    by_contra hc
    rw [mob_infty, if_neg hc] at h
    exact coe_ne_infty _ h
  have hdet := det_ent k
  rw [hc, mul_zero, sub_zero] at hdet
  obtain ⟨a, ha⟩ := ent_int k 0 0
  obtain ⟨d, hd⟩ := ent_int k 1 1
  rw [ha, hd] at hdet ⊢
  have hadZ : a * d = 1 := by exact_mod_cast hdet
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hadZ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    norm_num [hc]

