    have S1 := Sp.pushE t (i := i) (e := e) hi hc hok hB
    set t1 := t.upd i (.int (e.eval t) :: t.G i)
    have hcong : ∀ p ∈ l, ∀ r ∈ p.2.regs, t1.G r = t.G r := fun p hp r hrr => by
      have := (h p (List.mem_cons_of_mem _ hp)).2.2.1 r hrr
      simp only [List.map_cons, List.mem_cons, not_or] at this
      simp [t1, this.1]
    have h' : PushOK t1 Bb l := fun p hp => by
      obtain ⟨a1, a2, a3, a4, a5⟩ := h p (List.mem_cons_of_mem _ hp)
      have hc := Ex.congrG p.2 (hcong p hp)
      refine ⟨a1, a2, fun r hrr hm => a3 r hrr (List.mem_cons_of_mem _ hm), hc.2.1.2 a4,
        (hc.2.2.1 Bb).2 a5⟩
    have S2 := Sp.pushes Bb l t1 h'
    have e2 : l.map (fun p => (p.1, p.2.eval t1)) = l.map (fun p => (p.1, p.2.eval t)) :=
      List.map_congr_left fun p hp => by rw [(Ex.congrG p.2 (hcong p hp)).1]
    rw [e2] at S2
    refine (S1.seq S2).mono (le_of_eq ?_)
    simp only [pushCost, List.map_cons, List.sum_cons]; ring

theorem Sp.popsR (Bb : ℕ) : ∀ (l : List (Fin HS × ℤ)) (t : IState HS),
    (∀ p ∈ l, p.1.val < 56 ∧ zsz p.2 ≤ Bb) →
    Sp (popsR (l.map Prod.fst)) (pushSt t l) t (l.length * (2 * Bb + 2) + 1)
  | [], t, _ => (Sp.skip t).mono (by simp)
  | (i, v) :: l, t, h => by
    have IH := Sp.popsR Bb l (t.upd i (.int v :: t.G i))
      (fun p hp => h p (List.mem_cons_of_mem _ hp))
    obtain ⟨hi, hv⟩ := h (i, v) List.mem_cons_self
    have S2 := Sp.popI (t.upd i (.int v :: t.G i)) hi (a := v) (L := t.G i) (by simp) hv
    rw [IState.upd_upd_same, IState.upd_self] at S2
    refine (IH.seq S2).mono (le_of_eq ?_)
    simp only [List.length_cons]; ring

theorem pushSt_G (t : IState HS) (r : Fin HS) : ∀ l : List (Fin HS × ℤ),
    (pushSt t l).G r = ints ((l.filter (fun p => p.1 = r)).map Prod.snd).reverse ++ t.G r
  | [] => by simp [pushSt]
  | (i, v) :: l => by
    simp only [pushSt]
    rw [pushSt_G _ r l]
    by_cases h : i = r
    · subst h; simp [List.filter_cons, ints_append, ints]
    · simp [List.filter_cons, h, Ne.symm h]

@[simp] theorem pushSt_ip (t : IState HS) : ∀ l, (pushSt t l).ip = t.ip
  | [] => rfl
  | (i, v) :: l => by simp only [pushSt]; rw [pushSt_ip _ l]; rfl

@[simp] theorem pushSt_out (t : IState HS) : ∀ l, (pushSt t l).out = t.out
  | [] => rfl
  | (i, v) :: l => by simp only [pushSt]; rw [pushSt_out _ l]; rfl

theorem pushSt_append (t : IState HS) (l l' : List (Fin HS × ℤ)) :
    pushSt t (l ++ l') = pushSt (pushSt t l) l' := by
  induction l generalizing t with
  | nil => rfl
  | cons p l ih => obtain ⟨i, v⟩ := p; simp only [List.cons_append, pushSt]; exact ih _

theorem pushSt_upd_comm (t : IState HS) (j : Fin HS) (L : List Item) :
    ∀ l : List (Fin HS × ℤ), j ∉ l.map Prod.fst → pushSt (t.upd j L) l = (pushSt t l).upd j L
  | [], _ => rfl
  | (i, v) :: l, h => by
    simp only [List.map_cons, List.mem_cons, not_or] at h
    simp only [pushSt]
    rw [← pushSt_upd_comm _ j L l h.2]
    congr 1
    refine IState.ext' (fun x => ?_) rfl rfl
    simp only [IState.upd_G]
    by_cases h1 : x = i
    · subst h1; simp [Ne.symm h.1]
    · simp [h1]

theorem PosE.facts {s : IState HS} : ∀ (e : Ex HS), PosE s e →
    1 ≤ e.eval s ∧ e.ok s ∧ ∀ B, zsz (e.eval s) ≤ B → e.Bnd s B
  | .reg i, h => ⟨h.2, h.1, fun B hB => hB⟩
  | .lit c, h => ⟨h, trivial, fun B hB => hB⟩
  | .mul a b, h => by
    obtain ⟨a1, a2, a3⟩ := PosE.facts a h.1
    obtain ⟨b1, b2, b3⟩ := PosE.facts b h.2
    have ha : (a.eval s).natAbs ≤ (a.eval s * b.eval s).natAbs := by
      rw [Int.natAbs_mul]; exact Nat.le_mul_of_pos_right _ (by omega)
    have hb : (b.eval s).natAbs ≤ (a.eval s * b.eval s).natAbs := by
      rw [Int.natAbs_mul]; exact Nat.le_mul_of_pos_left _ (by omega)
    refine ⟨by simp only [Ex.eval]; nlinarith, ⟨a2, b2⟩, fun B hB => ⟨a3 B ?_, b3 B ?_, hB⟩⟩
    · simp only [Ex.eval] at hB; exact le_trans (zsz_mono ha) hB
    · simp only [Ex.eval] at hB; exact le_trans (zsz_mono hb) hB
  | .add _ _, h | .neg _, h | .shl _ _, h | .quo _ _, h | .rem _ _, h | .pow2 _, h
  | .sel _ _ _, h | .ndiv _ _, h | .nmod _ _, h => h.elim

theorem prodE_eval (s : IState HS) : ∀ l : List (Ex HS), (prodE l).eval s = (l.map (·.eval s)).prod
  | [] => rfl
  | e :: l => by simp only [prodE, Ex.eval, prodE_eval s l, List.map_cons, List.prod_cons]

theorem prodE_pos {s : IState HS} : ∀ l : List (Ex HS), (∀ e ∈ l, PosE s e) → PosE s (prodE l)
  | [], _ => by simp [prodE, PosE]
  | e :: l, h => ⟨h e List.mem_cons_self, prodE_pos l fun e' he' => h e' (List.mem_cons_of_mem _ he')⟩

theorem prodE_regs : ∀ (l : List (Ex HS)) (r : Fin HS), r ∈ (prodE l).regs → ∃ e ∈ l, r ∈ e.regs
  | [], r, h => by simp [prodE, Ex.regs] at h
  | e :: l, r, h => by
    simp only [prodE, Ex.regs, List.mem_append] at h
    rcases h with h | h
    · exact ⟨e, List.mem_cons_self, h⟩
    · obtain ⟨e', he', h'⟩ := prodE_regs l r h
      exact ⟨e', List.mem_cons_of_mem _ he', h'⟩

theorem stgM_snoc : ∀ (rv : List (ℕ × ℕ)) (x : ℕ × ℕ) (suf : List (ℕ × ℕ)),
    stgM (rv ++ [x]) suf = stgM rv suf ++ [(vol ((rv.reverse ++ suf).map Prod.fst) : ℤ)]
  | [], x, suf => by simp [stgM]
  | y :: rv, x, suf => by
    simp only [List.cons_append, stgM, stgM_snoc rv x (y :: suf), List.reverse_cons,
      List.append_assoc, List.singleton_append, List.nil_append]

theorem stgAM_snoc : ∀ (rv : List (ℕ × ℕ)) (x : ℕ × ℕ) (suf : List (ℕ × ℕ)),
    stgAM (rv ++ [x]) suf = stgAM rv suf ++ [((x.1 * vol ((rv.reverse ++ suf).map Prod.fst) : ℕ) : ℤ)]
  | [], x, suf => by simp [stgAM]
  | y :: rv, x, suf => by
    simp only [List.cons_append, stgAM, stgAM_snoc rv x (y :: suf), List.reverse_cons,
      List.append_assoc, List.singleton_append, List.nil_append]

theorem stgM_rev (suf : List (ℕ × ℕ)) : ∀ ac : List (ℕ × ℕ),
    stgM ac.reverse suf = (sufV suf ac).reverse
  | [] => rfl
  | x :: ac => by
    rw [List.reverse_cons, stgM_snoc, stgM_rev suf ac, List.reverse_reverse]
    simp [sufV]

theorem stgAM_rev (suf : List (ℕ × ℕ)) : ∀ ac : List (ℕ × ℕ),
    stgAM ac.reverse suf = (sufAV suf ac).reverse
  | [] => rfl
  | x :: ac => by
    rw [List.reverse_cons, stgAM_snoc, stgAM_rev suf ac, List.reverse_reverse]
    simp [sufAV]

theorem stgOK_of_pushSt (t : IState HS) (Q : ℕ) (L : List (Fin HS × ℤ)) (ac : List (ℕ × ℕ))
    (hA : (L.filter (fun p => p.1 = sSA)).map Prod.snd = ac.map fun p => (p.1 : ℤ))
    (hC : (L.filter (fun p => p.1 = sSC)).map Prod.snd = ac.map fun p => (p.2 : ℤ))
    (hM : (L.filter (fun p => p.1 = sSM)).map Prod.snd = sufV [] ac)
    (hAM : (L.filter (fun p => p.1 = sSAM)).map Prod.snd = sufAV [] ac) :
    StgOK (pushSt t L) Q ac (t.G sSA) (t.G sSC) (t.G sSM) (t.G sSAM) :=
  ⟨by rw [pushSt_G, hA, List.map_reverse], by rw [pushSt_G, hC, List.map_reverse],
    by rw [pushSt_G, hM, stgM_rev], by rw [pushSt_G, hAM, stgAM_rev]⟩

theorem evalP_stg_cons (t : IState HS) (a c : Ex HS) (l : List (Ex HS × Ex HS)) :
    evalP t (stgPush ((a, c) :: l)) = (sSA, a.eval t) :: (sSC, c.eval t) ::
      (sSM, (prodE (l.map Prod.fst)).eval t) ::
      (sSAM, (Ex.mul a (prodE (l.map Prod.fst))).eval t) :: evalP t (stgPush l) := rfl

theorem filterA_stg (t : IState HS) : ∀ l : List (Ex HS × Ex HS),
    ((evalP t (stgPush l)).filter (fun p => p.1 = sSA)).map Prod.snd = l.map (·.1.eval t)
  | [] => rfl
  | (a, c) :: l => by
    rw [evalP_stg_cons, List.filter_cons_of_pos (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})),
      List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})), List.map_cons,
      filterA_stg t l, List.map_cons]

theorem filterC_stg (t : IState HS) : ∀ l : List (Ex HS × Ex HS),
    ((evalP t (stgPush l)).filter (fun p => p.1 = sSC)).map Prod.snd = l.map (·.2.eval t)
  | [] => rfl
  | (a, c) :: l => by
    rw [evalP_stg_cons, List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_pos (by simp (config := {decide := true})),
      List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})), List.map_cons,
      filterC_stg t l, List.map_cons]

theorem prodE_vol {t : IState HS} : ∀ {l : List (Ex HS × Ex HS)} {ac : List (ℕ × ℕ)},
    l.map (·.1.eval t) = ac.map (fun p => (p.1 : ℤ)) →
    (prodE (l.map Prod.fst)).eval t = (vol (ac.map Prod.fst) : ℤ)
  | [], [], _ => by simp [prodE, Ex.eval, vol]
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | (a, c) :: l, (x, y) :: ac, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    simp only [List.map_cons, prodE, Ex.eval, prodE_vol h.2, vol_cons, h.1]
    push_cast; ring

theorem filterM_stg (t : IState HS) : ∀ (l : List (Ex HS × Ex HS)) (ac : List (ℕ × ℕ)),
    l.map (·.1.eval t) = ac.map (fun p => (p.1 : ℤ)) →
    ((evalP t (stgPush l)).filter (fun p => p.1 = sSM)).map Prod.snd = sufV [] ac
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | (a, c) :: l, (x, y) :: ac, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    rw [evalP_stg_cons, List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})),
      List.filter_cons_of_pos (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})), List.map_cons,
      filterM_stg t l ac h.2, prodE_vol h.2]
    simp [sufV]

theorem filterAM_stg (t : IState HS) : ∀ (l : List (Ex HS × Ex HS)) (ac : List (ℕ × ℕ)),
    l.map (·.1.eval t) = ac.map (fun p => (p.1 : ℤ)) →
    ((evalP t (stgPush l)).filter (fun p => p.1 = sSAM)).map Prod.snd = sufAV [] ac
  | [], [], _ => rfl
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h
  | (a, c) :: l, (x, y) :: ac, h => by
    simp only [List.map_cons, List.cons.injEq] at h
    rw [evalP_stg_cons, List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_neg (by simp (config := {decide := true})),
      List.filter_cons_of_neg (by simp (config := {decide := true})), List.filter_cons_of_pos (by simp (config := {decide := true})), List.map_cons,
      filterAM_stg t l ac h.2]
    simp only [Ex.eval, prodE_vol h.2, h.1, sufAV, List.append_nil]
    push_cast; ring_nf

end NLogN.KIL

