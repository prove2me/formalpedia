  have hI1 : ∀ σ ∈ P.inertiaSubgroupIn ℚ, (ρ.ρ σ).baseChange Kb w₁ = algebraMap O' Kb 1 • w₁ := by
    intro σ hσ
    have h1 : ρg.ρ σ v₁' = (1 : O'') • v₁' := by rw [one_smul]; exact (hI' σ hσ).2
    rw [map_one, hw₁, htrans σ h1, map_one]

  have hmatch : ∀ (σ : Gal) (u : ℕ), (u : ZMod q) = ((cyc σ : (ZMod q)ˣ) : ZMod q) →
