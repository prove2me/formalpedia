-- Source module: Solutions.R6BitNBNetA
/-!
# Round six, bit network: the network (definitions, wires, generic fold lemmas)

Global roles (`v = 1771`, `N = v² = 3136441`, `R = 40077`): `X(a₁, a₂) = a₁ v + a₂`,
`Y(a₁, a₂) = N + a₁ v + a₂`, `A₁(b, q) = 2N + b R + q`, `A₂(a, q) = 2N + v R + a R + q`
(`W = 2N + 2vR = 148225616`). Temporaries: `tmp₁(b, c) = 23 b + c`, `tmp₂(a, c) = 23 v + 23 a + c`,
`τ(a₁, a₂) = 46 v + a₁ v + a₂` (`T = 46 v + N = 3217907`).

Stage-one invocation `b` maps the local wires `x_t ↦ X(t, b)`, `y_T ↦ Y(T, b)`, `s_q ↦ A₁(b, q)`,
`tmp_c ↦ tmp₁(b, c)`; stage-two invocation `a` maps `x_t ↦ Y(a, t)`, `y_S ↦ X(a, S)`,
`s_q ↦ A₂(a, q)`, `tmp_c ↦ tmp₂(a, c)`, `u_S ↦ τ(a, S)` (local `u_S = 43642 + S`).

Program: for each `b`, the stage-one chunks then the aux exits on its slots; then for each `a`, the
entrance edges on its `x`, `y` and slot wires, the stage-two chunks and the copy corrections.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-! ## Generic fold lemmas -/

/-! ## Wires -/

abbrev Wr := Fin 148225616 ⊕ Fin 3217907

def gw (g : ℕ) : Wr :=
  if h : g < 148225616 then .inl ⟨g, h⟩ else .inr ⟨(g - 148225616) % 3217907, Nat.mod_lt _ (by norm_num)⟩

/-- Stage-one local-to-global map. -/
def g1 (b w : ℕ) : ℕ :=
  if w < 1771 then w * 1771 + b
  else if w < 3542 then 3136441 + (w - 1771) * 1771 + b
  else if w < 43619 then 6272882 + b * 40077 + (w - 3542)
  else 148225616 + 23 * b + (w - 43619)

/-- Stage-two local-to-global map. -/
def g2 (a w : ℕ) : ℕ :=
  if w < 1771 then 3136441 + a * 1771 + w
  else if w < 3542 then a * 1771 + (w - 1771)
  else if w < 43619 then 77249249 + a * 40077 + (w - 3542)
  else if w < 43642 then 148225616 + 40733 + 23 * a + (w - 43619)
  else 148225616 + 81466 + a * 1771 + (w - 43642)

def ι1 (b w : ℕ) : Wr := gw (g1 b w)
def ι2 (a w : ℕ) : Wr := gw (g2 a w)

/-- Local `u` wires (correction temporaries). -/
def wU (s : ℕ) : ℕ := 43642 + s

/-! ## The network -/

/-- The stage chunk lists. -/
@[irreducible] def cs1 : List LChunk := (genF (codeOf SG1_0) W1F).2
@[irreducible] def cs2 : List LChunk := (genF (codeOf SG2_0) W2F).2

/-- The chosen edges and the flag basis. -/
structure Ch where
  S : Matrix (Fin 529) (Pr 23) ℚ
  Si : Matrix (Pr 23) (Fin 529) ℚ
  e1 : ℕ → ℕ → ℕ → Edge 529
  e2 : ℕ → ℕ → ℕ → Edge 529
  ex : ℕ → Edge 529
  en : ℕ → ℕ → Edge 529
  ei : ℕ → Edge 529
  ec : ℕ → ℕ → Edge 529

abbrev NI := Instr Wr (ZMod 2) 529

/-- Entrance edges of stage-two invocation `a` on its local wire `w < 43619`. -/
def entE (ch : Ch) (a w : ℕ) : Edge 529 :=
  if w < 1771 then ch.en a w else if w < 3542 then ch.en a (w - 1771) else ch.ei a

def blk1 (ch : Ch) (b : ℕ) : List NI :=
  chunkProg (ι1 b) (ch.e1 b) cs1 ++ (List.range' 3542 40077).map fun w => Instr.edge (ι1 b w) (ch.ex b)

def corrI (ch : Ch) (a s : ℕ) : List NI :=
  [xorG (ι2 a (wU s)) (ι2 a (wY s)), Instr.edge (ι2 a (wU s)) (ch.ec a s), xorG (ι2 a (wX s)) (ι2 a (wU s))]

def entI (ch : Ch) (a : ℕ) : List NI := (List.range 43619).map fun w => Instr.edge (ι2 a w) (entE ch a w)

def blk2 (ch : Ch) (a : ℕ) : List NI :=
  entI ch a ++ (chunkProg (ι2 a) (ch.e2 a) cs2 ++ (List.range 1771).flatMap (corrI ch a))

def prog (ch : Ch) : List NI := (List.range 1771).flatMap (blk1 ch) ++ (List.range 1771).flatMap (blk2 ch)

def ρn (g : ℕ) : ℕ := if g < 3136441 then g + 3136441 else if g < 6272882 then g - 3136441 else g

def ρ (w : Fin 148225616) : Fin 148225616 := ⟨ρn w.val, by unfold ρn; split_ifs <;> omega⟩

/-- **The round-six bit network.** -/
def net (ch : Ch) : QHNet (ZMod 2) 148225616 3217907 529 := ⟨prog ch, ρ⟩

end IntMul.Kappa.R6.Bit.NB

end

