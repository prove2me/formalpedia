theorem r6_good_of (P : Prm) (hP : P.Ok) {n : ℕ} (hb : 4 ≤ bP6 n)
    (hb' : 8 * b'P6 P n ≤ 2 ^ (bP6 n / 2)) : Good P n := by
  have hcl : bP6 n = Nat.clog 2 n := by
    unfold bP6 IntMul.lg at *
    rcases le_total (Nat.clog 2 n) 1 with h | h
    · rw [max_eq_right h] at hb; omega
    · exact max_eq_left h
  have hn2 : 2 ^ (bP6 n - 1) < n := by
    rw [hcl]; exact Nat.pow_lt_of_lt_clog (by rw [← hcl]; omega)
  have h2n := n_le_two_pow_b n
  have hLs : 4 * n ≤ 2 ^ LP6 P n * b'P6 P n := Nat.find_spec (LP6_exists P n)
  have hb'1 := b'P6_pos P n
  have hhalf : 2 ^ (bP6 n / 2) ≤ 2 ^ (bP6 n - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hLpos : 1 ≤ LP6 P n := by
    by_contra hcon
    have h0 : LP6 P n = 0 := by omega
    rw [h0, pow_zero, one_mul] at hLs
    omega
  have hThi : TP6 P n * b'P6 P n < 8 * n := by
    obtain ⟨L', hL'⟩ : ∃ L', LP6 P n = L' + 1 := ⟨LP6 P n - 1, by omega⟩
    have hmin : ¬ 4 * n ≤ 2 ^ L' * b'P6 P n :=
      Nat.find_min (LP6_exists P n) (show L' < LP6 P n by omega)
    unfold TP6; rw [hL', pow_succ]
    push_neg at hmin
    nlinarith
  have hTlo : 4 * n ≤ TP6 P n * b'P6 P n := hLs
  have hLle : LP6 P n ≤ bP6 n := L_le_b P hP (by omega)
  have hLge : bP6 n ≤ 2 * LP6 P n := by
    have h1 : 2 ^ (bP6 n + 4) < 2 ^ (LP6 P n + bP6 n / 2) := by
      have e1 : 2 ^ (bP6 n + 4) = 32 * 2 ^ (bP6 n - 1) := by
        rw [show bP6 n + 4 = (bP6 n - 1) + 5 by omega, pow_add]; ring
      have e2 : 2 ^ (LP6 P n + bP6 n / 2) = 2 ^ LP6 P n * 2 ^ (bP6 n / 2) := pow_add _ _ _
      rw [e1, e2]
      have : 8 * (2 ^ LP6 P n * b'P6 P n) ≤ 2 ^ LP6 P n * 2 ^ (bP6 n / 2) := by
        calc 8 * (2 ^ LP6 P n * b'P6 P n) = 2 ^ LP6 P n * (8 * b'P6 P n) := by ring
          _ ≤ _ := Nat.mul_le_mul_left _ hb'
      nlinarith
    have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).mp h1
    omega
  have hdpos := d_pos P hP hb
  have hdℓ := dℓ_spec P hP hb
  have hℓpos : 1 ≤ ℓP6 P n := by
    by_contra hcon
    have : ℓP6 P n = 0 := by omega
    rw [this, mul_zero] at hdℓ
    omega
  have hVeq : VP6 P n = 6 * ((TP6 P n * b'P6 P n : ℕ) : ℝ) := by
    unfold VP6 pP6; push_cast; ring
  refine
    { b_ge := hb, b'_le := hb', T_lo := hTlo, T_hi := hThi, L_pos := hLpos, L_le := hLle,
      L_ge := hLge, V_lo := ?_, V_hi := ?_, d_pos := hdpos, d_le_b := d_le_b P hP n,
      d_le := d_le_beps P n, d_ge := d_half P hP hb, dℓ_ge := hdℓ.1, dℓ_le := hdℓ.2,
      ell_pos := hℓpos, ell_le := ell_le P hP hb, ell_ge := ?_,
      ell_le_rpow := ell_le_rpow P hP hb, gamma_le := gamma_le P n }
  · rw [hVeq]
    have : ((4 * n : ℕ) : ℝ) ≤ ((TP6 P n * b'P6 P n : ℕ) : ℝ) := by exact_mod_cast hTlo
    push_cast at this ⊢; linarith
  · rw [hVeq]
    have : ((TP6 P n * b'P6 P n : ℕ) : ℝ) ≤ ((8 * n : ℕ) : ℝ) := by exact_mod_cast hThi.le
    push_cast at this ⊢; linarith
  · have hd : (0:ℝ) < dP6 P n := by exact_mod_cast hdpos
    rw [div_le_iff₀ (by positivity)]
    have : bP6 n ≤ 2 * (dP6 P n * ℓP6 P n) := by omega
    have : ((bP6 n : ℕ) : ℝ) ≤ ((2 * (dP6 P n * ℓP6 P n) : ℕ) : ℝ) := by exact_mod_cast this
    push_cast at this; linarith

theorem solution (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → Good P n := by 
  set k := 1 + P.x with hk
  have ht := tendsto_pow_const_div_const_pow_of_one_lt k (by norm_num : (1:ℝ) < 2)
  have hev := ht.eventually (gt_mem_nhds (show (0:ℝ) < 1 / (8 * 3 ^ k) by positivity))
  obtain ⟨C0, hC0⟩ := Filter.eventually_atTop.mp hev
  have hbig : ∀ b : ℕ, 2 * (C0 + 1) ≤ b → 8 * b ^ k ≤ 2 ^ (b / 2) := by
    intro b hb
    set c := b / 2 with hc
    have hc1 : C0 + 1 ≤ c := by omega
    have h1 := hC0 c (by omega)
    have h2c : (0:ℝ) < 2 ^ c := by positivity
    rw [div_lt_div_iff₀ h2c (by positivity), one_mul] at h1
    have hb3 : b ≤ 3 * c := by omega
    have h3 : b ^ k ≤ 3 ^ k * c ^ k := by
      rw [← mul_pow]; exact Nat.pow_le_pow_left hb3 k
    have h4 : ((8 * 3 ^ k * c ^ k : ℕ) : ℝ) < ((2 ^ c : ℕ) : ℝ) := by
      push_cast; nlinarith
    have h5 : 8 * 3 ^ k * c ^ k < 2 ^ c := by exact_mod_cast h4
    calc 8 * b ^ k ≤ 8 * (3 ^ k * c ^ k) := Nat.mul_le_mul_left 8 h3
      _ = 8 * 3 ^ k * c ^ k := by ring
      _ ≤ 2 ^ c := h5.le
  set N := 2 * (C0 + 1) + 4 with hN
  refine ⟨2 ^ N + 1, fun n hn => ?_⟩
  have hcl : N < Nat.clog 2 n := (Nat.lt_clog_iff_pow_lt (by norm_num)).mpr (by omega)
  have hbN : N ≤ bP6 n := by unfold bP6 IntMul.lg; omega
  exact r6_good_of P hP (by omega) (by unfold b'P6; exact hbig _ (by omega))
