open QAlgorithms QAlgorithms.Papers.Independent.ZW in
/-- PDF p.7, §4.1: the printed symbolic generator assertion.
Source discrepancy: the following “namely” display prints exp(i*pi/8) I;
the word (H P^3)^3 actually equals exp(-i*pi/4) I. We retain the symbolic
word and exact phases; independent moderation of the correction is required. -/
theorem gen_eq :
    (generatedCT : Set (Matrix.unitaryGroup Bool ℂ)) = {u : Matrix.unitaryGroup Bool ℂ | (u : Mat) ∈ ctSet} := by
  have hgen : ∀ i, gU i ∈ generatedCT := by
    intro i
    apply Subgroup.subset_closure
    fin_cases i
    · left; show φM S8 = _; exact φS
    · right; left
      show φM (((H8.mul S8).mul S8).mul H8) = _
      simp only [φM_mul, φH, φS, pow_two, mul_assoc]
    · right; right
      show φM ((((((H8.mul S8).mul S8).mul S8)).mul (((H8.mul S8).mul S8).mul S8)).mul
        (((H8.mul S8).mul S8).mul S8)) = _
      simp only [φM_mul, φH, φS, pow_succ, pow_zero, one_mul, mul_assoc]
  ext u
  simp only [SetLike.mem_coe, Set.mem_setOf_eq]
  rw [ct_eq]
  constructor
  · intro hu
    have hg : ∀ x : Matrix.unitaryGroup Bool ℂ, ((x : Matrix Bool Bool ℂ) = phaseS ∨
        (x : Matrix Bool Bool ℂ) = hadamard * phaseS ^ 2 * hadamard ∨
        (x : Matrix Bool Bool ℂ) = (hadamard * phaseS ^ 3) ^ 3) →
        ∃ i : Fin 3, (x : Matrix Bool Bool ℂ) = cc ^ 5 • φE (keyN 5 (G8 i)) := by
      rintro x (hv | hv | hv)
      · refine ⟨0, ?_⟩; rw [hv, ← key_spec 5 _ (c_gin 0).1]; exact φS.symm
      · refine ⟨1, ?_⟩; rw [hv, ← key_spec 5 _ (c_gin 1).1]
        show _ = φM (((H8.mul S8).mul S8).mul H8)
        simp only [φM_mul, φH, φS, pow_two, mul_assoc]
      · refine ⟨2, ?_⟩; rw [hv, ← key_spec 5 _ (c_gin 2).1]
        show _ = φM ((((((H8.mul S8).mul S8).mul S8)).mul (((H8.mul S8).mul S8).mul S8)).mul
          (((H8.mul S8).mul S8).mul S8))
        simp only [φM_mul, φH, φS, pow_succ, pow_zero, one_mul, mul_assoc]
    refine Subgroup.closure_induction_left (G := Matrix.unitaryGroup Bool ℂ)
      (p := fun (x : Matrix.unitaryGroup Bool ℂ) _ => (x : Matrix Bool Bool ℂ) ∈ img 5 CTLit)
      ?_ ?_ ?_ (show u ∈ Subgroup.closure _ from hu)
    · refine ⟨_, c_one, ?_⟩
      show (1 : Matrix Bool Bool ℂ) = _
      rw [φE_scale, φE_one, smul_smul, ← mul_pow, cc_sq, one_pow, one_smul]
    · rintro x hx y _ ⟨e, he, hy⟩
      obtain ⟨i, hi⟩ := hg x hx
      show (x : Matrix Bool Bool ℂ) * y ∈ _
      rw [hi, hy]; exact prod_form _ _ (c_left i e he).1
    · rintro x hx y _ ⟨e, he, hy⟩
      obtain ⟨i, hi⟩ := hg x hx
      show star (x : Matrix Bool Bool ℂ) * y ∈ _
      rw [hi, hy, star_lvl]; exact prod_form _ _ (c_left i e he).2
  · rintro ⟨e, he, hue⟩
    rw [← c_pw1, List.mem_map] at he
    obtain ⟨p, hp, rfl⟩ := he
    obtain ⟨h1, h2⟩ := c_pw2 p hp
    have : u = (p.2.map gU).prod := by
      apply Subtype.ext
      rw [hue, ← evG_spec, key_spec 16 _ h1, h2, show 16 = 5 + 11 by rfl, lvl_up]
    rw [this]
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨i, _, rfl⟩ := List.mem_map.1 hx
    exact hgen i

namespace QAlgorithms.Papers.Independent.ZW
open QAlgorithms Gap48.P12 Complex

def iZ : Z8 := ⟨0, 0, 1, 0⟩
def mZ : Z8 := ⟨-1, 0, 0, 0⟩

def clsZ (x : E8) : DihedralGroup 4 :=
  if x.p = z0 then
    (if x.r = z1.mul x.q then .sr 0 else if x.r = iZ.mul x.q then .sr 1
      else if x.r = mZ.mul x.q then .sr 2 else .sr 3)
  else
    (if x.s = z1.mul x.p then .r 0 else if x.s = iZ.mul x.p then .r 3
      else if x.s = mZ.mul x.p then .r 2 else .r 1)

noncomputable def clsC (u : Matrix Bool Bool ℂ) : DihedralGroup 4 :=
  if u false false = 0 then
    (if u true false = 1 * u false true then .sr 0 else if u true false = I * u false true then .sr 1
      else if u true false = -1 * u false true then .sr 2 else .sr 3)
  else
    (if u true true = 1 * u false false then .r 0 else if u true true = I * u false false then .r 3
      else if u true true = -1 * u false false then .r 2 else .r 1)

lemma φZ_iZ : φZ iZ = I := by simp [φZ, iZ, ω2]
lemma φZ_mZ : φZ mZ = -1 := by simp [φZ, mZ]

lemma eqC (c : Z8) (cφ : ℂ) (hc : φZ c = cφ) (a b : Z8) : (φZ a = cφ * φZ b) ↔ a = c.mul b := by
  constructor
  · intro h; apply φZ_inj; rw [φZ_mul, hc, h]
  · rintro rfl; rw [φZ_mul, hc]

lemma clsC_φE (x : E8) : clsC (φE x) = clsZ x := by
  have h0 : ∀ z : Z8, φZ z = 0 ↔ z = z0 := fun z =>
    ⟨fun h => φZ_inj _ _ (by rw [h, φZ_z0]), fun h => by rw [h, φZ_z0]⟩
  simp only [clsC, clsZ, φE, Matrix.of_apply, h0, eqC z1 1 φZ_z1, eqC iZ I φZ_iZ,
    eqC mZ (-1) φZ_mZ]

lemma clsC_smul (c : ℂ) (hc : c ≠ 0) (M : Matrix Bool Bool ℂ) : clsC (c • M) = clsC M := by
  have e1 : ∀ a b k : ℂ, (c * a = k * (c * b)) ↔ (a = k * b) := fun a b k => by
    rw [mul_left_comm, mul_right_inj' hc]
  simp only [clsC, Matrix.smul_apply, smul_eq_mul, mul_eq_zero, hc, false_or, e1]

lemma c_hom : ∀ e ∈ CTLit, ∀ f ∈ CTLit, clsZ (e.mul f) = clsZ e * clsZ f := by decide +kernel
lemma c_unit : ∀ e ∈ CTLit, e.mul (ctE e) = E8.scale 10 E8.one := by decide +kernel
lemma c_surj : ∀ d : DihedralGroup 4, ∃ e ∈ CTLit, clsZ e = d := by decide +kernel

def wpow : ℕ → Z8
  | 0 => z1
  | n + 1 => (⟨0, 1, 0, 0⟩ : Z8).mul (wpow n)
def scK (k : Fin 8) : E8 := E8.scale 5 ⟨wpow k, z0, z0, wpow k⟩
lemma c_ker : ∀ e ∈ CTLit, clsZ e = .r 0 → ∃ k : Fin 8, e = scK k := by decide +kernel

lemma φZ_wpow (n : ℕ) : φZ (wpow n) = ω ^ n := by
  induction n with
  | zero => simp [wpow, φZ_z1]
  | succ n ih => rw [wpow, φZ_mul, ih, pow_succ, mul_comm]; congr 1; simp [φZ]

lemma scK_val (k : Fin 8) : cc ^ 5 • φE (scK k) = ω ^ (k : ℕ) • (1 : Matrix Bool Bool ℂ) := by
  rw [scK, φE_scale, smul_smul, ← mul_pow, cc_sq, one_pow, one_smul]
  ext i j; cases i <;> cases j <;> simp [φE, φZ_wpow, φZ_z0]

lemma root_eq (k : Fin 8) : scalarRoot k = ω ^ (k : ℕ) • (1 : Matrix Bool Bool ℂ) := by
  rw [scalarRoot, ω, ← Complex.exp_nat_mul]; congr 2; ring

lemma ω8 : ω ^ 8 = 1 := by rw [show ω ^ 8 = (ω ^ 4) ^ 2 by ring, ω4]; norm_num
lemma ω_pow_mod (n : ℕ) : ω ^ n = ω ^ (n % 8) := by
  conv_lhs => rw [← Nat.mod_add_div n 8, pow_add, pow_mul, ω8, one_pow, mul_one]
lemma ω_ne : ω ≠ 0 := Complex.exp_ne_zero _

lemma mem_img_unit (e : E8) (he : e ∈ CTLit) :
    cc ^ 5 • φE e ∈ Matrix.unitaryGroup Bool ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, star_lvl, Matrix.smul_mul, Matrix.mul_smul, smul_smul,
    ← φE_mul, c_unit e he, ← pow_add, show 5 + 5 = 0 + 10 by rfl, φE_scale, smul_smul,
    pow_add, mul_assoc, ← mul_pow, cc_sq, one_pow, mul_one, pow_zero, one_smul, φE_one]

end QAlgorithms.Papers.Independent.ZW

open QAlgorithms QAlgorithms.Papers.Independent.ZW in
/-- PDF p.7, §4.1: quotient by the scalar subgroup is D₄ (order eight).
Printed: K={exp(i*pi*k/8) I : k=0,...,7}; changed: denominator 4.
Why: the printed set omits the eighth power -I of its generator and is not
a subgroup. The corrected roots agree with (H P^3)^3=exp(-i*pi/4) I and
the stated orders 64 and 8. Carrier equalities are conclusions, so neither
subgroup closure nor the scalar correction is smuggled in as a hypothesis.
Independent moderation of this source correction is required. -/
theorem solution :
    (ctGroup : Set (Matrix.unitaryGroup Bool ℂ)) = {u : Matrix.unitaryGroup Bool ℂ | (u : Mat) ∈ ctSet} ∧
    (∀ g : ctGroup, g ∈ scalarKernel ↔ ∃ k : Fin 8,
      (((g : ctGroup) : Matrix.unitaryGroup Bool ℂ) : Mat) = scalarRoot k) ∧
    Nonempty ((ctGroup ⧸ scalarKernel) ≃* DihedralGroup 4) := by
  have hcar : (ctGroup : Set (Matrix.unitaryGroup Bool ℂ)) =
      {u : Matrix.unitaryGroup Bool ℂ | (u : Matrix Bool Bool ℂ) ∈ ctSet} := by
    apply Set.Subset.antisymm
    · have : ctGroup ≤ generatedCT := by
        apply (Subgroup.closure_le _).2
        intro u hu; rw [SetLike.mem_coe, ← SetLike.mem_coe, gen_eq]; exact hu
      intro u hu; have := this hu; rw [← SetLike.mem_coe, gen_eq] at this; exact this
    · intro u hu; exact Subgroup.subset_closure hu
  have hmem : ∀ g : ctGroup, (((g : Matrix.unitaryGroup Bool ℂ)) : Matrix Bool Bool ℂ) ∈ img 5 CTLit := by
    intro g
    have : (g : Matrix.unitaryGroup Bool ℂ) ∈ (ctGroup : Set (Matrix.unitaryGroup Bool ℂ)) := g.2
    rw [hcar] at this; rw [← ct_eq]; exact this
  -- scalar subgroup
  let Ksc : Subgroup ctGroup :=
    { carrier := {g | ∃ k : Fin 8, (((g : ctGroup) : Matrix.unitaryGroup Bool ℂ) :
          Matrix Bool Bool ℂ) = scalarRoot k}
      one_mem' := ⟨0, by rw [root_eq]; simp⟩
      mul_mem' := by
        rintro a b ⟨i, hi⟩ ⟨j, hj⟩
        refine ⟨⟨((i : ℕ) + j) % 8, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
        show ((a : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) * _ = _
        rw [hi, hj, root_eq, root_eq, root_eq, smul_mul_smul_comm, mul_one, ← pow_add,
          ω_pow_mod (i + j)]
      inv_mem' := by
        rintro a ⟨i, hi⟩
        refine ⟨⟨(7 * (i : ℕ)) % 8, Nat.mod_lt _ (by norm_num)⟩, ?_⟩
        show star ((a : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) = _
        rw [hi, root_eq, root_eq, star_smul, star_one, star_pow, ← ω_pow_mod]
        congr 1
        show (starRingEnd ℂ) ω ^ (i : ℕ) = _
        rw [ω_conj, pow_mul, show -ω ^ 3 = ω ^ 7 by linear_combination (-(ω ^ 3)) * ω4] }
  have hKsc : ∀ g : ctGroup, g ∈ Ksc ↔ ∃ k : Fin 8,
      (((g : ctGroup) : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) = scalarRoot k :=
    fun g => Iff.rfl
  have hnorm : Ksc.Normal := ⟨by
    rintro a ⟨k, hk⟩ g
    refine ⟨k, ?_⟩
    show ((g : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) * _ *
      star ((g : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) = _
    rw [hk, root_eq, Matrix.mul_smul, mul_one, Matrix.smul_mul,
      (Matrix.mem_unitaryGroup_iff.1 (g : Matrix.unitaryGroup Bool ℂ).2)]⟩
  have hsk : scalarKernel = Ksc := by
    apply le_antisymm
    · exact Subgroup.normalClosure_le_normal (fun g hg => hg)
    · intro g hg; exact Subgroup.subset_normalClosure hg
  -- the homomorphism
  let φ : ctGroup →* DihedralGroup 4 :=
    { toFun := fun g => clsC (((g : Matrix.unitaryGroup Bool ℂ)) : Matrix Bool Bool ℂ)
      map_one' := by
        show clsC 1 = 1
        simp [clsC]
      map_mul' := by
        intro a b
        obtain ⟨e, he, ha⟩ := hmem a
        obtain ⟨f, hf, hb⟩ := hmem b
        show clsC (((a : Matrix.unitaryGroup Bool ℂ) : Matrix Bool Bool ℂ) * _) = clsC _ * clsC _
        rw [ha, hb, Matrix.smul_mul, Matrix.mul_smul, smul_smul, ← φE_mul,
          clsC_smul _ (mul_ne_zero (ccpow_ne 5) (ccpow_ne 5)), clsC_smul _ (ccpow_ne 5),
          clsC_smul _ (ccpow_ne 5), clsC_φE, clsC_φE, clsC_φE, c_hom e he f hf] }
  have hsurj : Function.Surjective φ := by
    intro d
    obtain ⟨e, he, hed⟩ := c_surj d
    have hu := mem_img_unit e he
    have hin : (⟨_, hu⟩ : Matrix.unitaryGroup Bool ℂ) ∈ ctGroup := by
      have : (⟨_, hu⟩ : Matrix.unitaryGroup Bool ℂ) ∈
          (ctGroup : Set (Matrix.unitaryGroup Bool ℂ)) := by
        rw [hcar]; show _ ∈ ctSet; rw [ct_eq]; exact ⟨e, he, rfl⟩
      exact this
    refine ⟨⟨_, hin⟩, ?_⟩
    show clsC (cc ^ 5 • φE e) = d
    rw [clsC_smul _ (ccpow_ne 5), clsC_φE, hed]
  have hker : φ.ker = Ksc := by
    ext g
    rw [MonoidHom.mem_ker]
    constructor
    · intro h
      obtain ⟨e, he, hg⟩ := hmem g
      have h' : clsZ e = .r 0 := by
        have : clsC (((g : Matrix.unitaryGroup Bool ℂ)) : Matrix Bool Bool ℂ) = 1 := h
        rwa [hg, clsC_smul _ (ccpow_ne 5), clsC_φE] at this
      obtain ⟨k, rfl⟩ := c_ker e he h'
      exact ⟨k, by rw [hg, scK_val, root_eq]⟩
    · rintro ⟨k, hk⟩
      show clsC (((g : Matrix.unitaryGroup Bool ℂ)) : Matrix Bool Bool ℂ) = 1
      rw [hk, root_eq, clsC_smul _ (pow_ne_zero _ ω_ne)]
      simp [clsC]
  refine ⟨hcar, fun g => by rw [hsk]; exact hKsc g, ?_⟩
  exact ⟨(QuotientGroup.quotientMulEquivOfEq (hsk.trans hker.symm)).trans
    (QuotientGroup.quotientKerEquivOfSurjective φ hsurj)⟩



