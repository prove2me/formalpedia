theorem stFix_eval {σ : Equiv.Perm (Fin HS)} {A : SArgs} (hf : StFix σ A) (s0 : IState HS)
    (e : Ex HS) (he : e ∈ A.l) : ∀ i ∈ e.regs, (s0.rn σ⁻¹).G i = s0.G i := by
  intro i hi; rw [rn_inv_G, hf.2.2 e he i hi]

theorem fine_rn {σ : Equiv.Perm (Fin HS)} {A : SArgs} (hf : StFix σ A) (s0 : IState HS) (B : ℕ)
    (hF : A.Fine s0 B) : A.Fine (s0.rn σ⁻¹) B := by
  intro e he
  obtain ⟨c1, c2, c3, c4, c5⟩ := hF e he
  have h := stFix_eval hf s0 e he
  exact ⟨c1, c2, (ex_ok_congr e h).2 c3, (ex_bnd_congr B e h).2 c4, c5⟩

theorem stageR_okc (M : MulSpec) (m Φ B sh dmax : ℕ) (hM : MulBnd M m Φ)
    (σ : Equiv.Perm (Fin HS)) (hσ : FixHi σ) (A : SArgs) (hA : A.Good) (hf : StFix σ A)
    (s0 : IState HS) (hF : A.Fine s0 B) (R : ℤ) (U : List (ℤ × ℤ))
    (Dl : List ℕ) (Ws : List (List ℤ)) (a NR n : ℕ) (RU RW RD : List Item)
    (hs : 0 < U.length) (ha : a < U.length) (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n)
    (hDl : Dl.length = n) (hpre : NLogN.Rsp.pre Dl n ≤ U.length)
    (hU : s0.G CU = gints U ++ RU) (hW : s0.G (σ NLogN.Rsp.BW) = ints Ws.flatten ++ RW)
    (hD : s0.G (σ BD) = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD)
    (v1 : A.eKs.eval s0 = U.length) (v2 : A.eKa.eval s0 = a)
    (v3 : A.eKN.eval s0 = ((U.length + NR : ℕ) : ℤ)) (v4 : A.eBR.eval s0 = R)
    (v5 : A.eBN.eval s0 = n) (v6 : A.eBNR.eval s0 = NR) (v7 : A.eBNW.eval s0 = ((n * NR : ℕ) : ℤ))
    (hRsh : R = 2 ^ sh) (hu : ∀ z ∈ U, zsz z.1 ≤ m ∧ zsz z.2 ≤ m)
    (hWB : ∀ W ∈ Ws, ∀ y ∈ W, zsz y ≤ m)
    (hAcc : (NR + 1) * 2 ^ (2 * m) ≤ 2 ^ B) (hmB : 2 * m ≤ B)
    (hLB : zsz ((U.length + NR : ℕ) : ℤ) ≤ B) (hsh : sh + 1 ≤ B)
    (hnB : zsz ((n * NR : ℕ) : ℤ) ≤ B) (hn1 : zsz (n : ℤ) ≤ B) (hdm : ∀ d ∈ Dl, d ≤ dmax) :
    ((stageP A).ren σ).ok M s0 ∧
      ((stageP A).ren σ).cost M s0 ≤ 7 * (4 * 2000 * (B + 2)) + gresCost U.length NR n m Φ B dmax +
        7 * (2 * B + 2) ∧
      ∀ z ∈ gresL R Dl Ws U a n, zsz z.1 ≤ B ∧ zsz z.2 ≤ B := by
  have ev : ∀ e ∈ A.l, e.eval (s0.rn σ⁻¹) = e.eval s0 := fun e he =>
    ex_eval_congr e (stFix_eval hf s0 e he)
  have h := stageP_okc M m Φ B sh dmax hM A hA (s0.rn σ⁻¹) (fine_rn hf s0 B hF) R U Dl Ws a NR n
    RU RW RD hs ha hWs hWr hDl hpre
    (by rw [rn_inv_G, hf.1, hU]) (by rw [rn_inv_G, hW]) (by rw [rn_inv_G, hD])
    (by rw [ev _ (by simp [SArgs.l]), v1]) (by rw [ev _ (by simp [SArgs.l]), v2])
    (by rw [ev _ (by simp [SArgs.l]), v3]) (by rw [ev _ (by simp [SArgs.l]), v4])
    (by rw [ev _ (by simp [SArgs.l]), v5]) (by rw [ev _ (by simp [SArgs.l]), v6])
    (by rw [ev _ (by simp [SArgs.l]), v7]) hRsh hu hWB hAcc hmB hLB hsh hnB hn1 hdm
  rw [RM.ok_ren_any M hσ, RM.cost_ren_any]
  exact h

theorem σc_fix : FixHi σc := swapsPerm_fixHi _ rfl

theorem σc_vals : σc NLogN.Rsp.BW = W1 ∧ σc BD = D1 := by decide +kernel

theorem Ac_good : Ac.Good := by unfold SArgs.Good; decide

theorem Ac_fix : StFix σc Ac := by unfold StFix; decide +kernel

theorem Ac_fine (τ : IState HS) (s t B : ℕ) (h1 : ∃ L, τ.G 1 = .int (t : ℤ) :: L)
    (hps : ∃ L, τ.G PS = .int (s : ℤ) :: L) (hst : s ≤ t) (hB : zsz ((t + 1 : ℕ) : ℤ) ≤ B) :
    Ac.Fine τ B := by
  obtain ⟨L1, h1⟩ := h1; obtain ⟨L2, h2⟩ := hps
  have zt : zsz (t : ℤ) ≤ B := le_trans (zsz_natCast_le' (by omega)) hB
  have zs : zsz (s : ℤ) ≤ B := le_trans (zsz_natCast_le' (by omega)) hB
  have z1 : zsz (1 : ℤ) ≤ B := le_trans (by simpa using zsz_natCast_le' (show 1 ≤ t + 1 by omega)) hB
  have zt1 : zsz ((t : ℤ) + 1) ≤ B := by simpa using hB
  intro e he
  simp only [SArgs.l, Ac, List.mem_cons, List.not_mem_nil, or_false] at he
  rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    refine ⟨by decide, by simp [Ex.Lin], ?_, ?_, by simp [Ex.size]⟩ <;>
    simp [Ex.ok, Ex.Bnd, Ex.eval, IState.top, h1, h2, IState.isInt_of h1, IState.isInt_of h2, zt, zs, z1, zt1,
      zsz_zero]

