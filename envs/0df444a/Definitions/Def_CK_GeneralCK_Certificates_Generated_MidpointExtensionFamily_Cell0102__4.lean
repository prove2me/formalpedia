theorem center_inputs {a z : ℝ} (ha : Bounds (433/2500) (217/1250) a)
    (hz : Bounds (1/20) (81/1000) z) :
    RegistersContain centerInitial (inputJets a ((biasE a+biasE (a*z))/2)) (a/2) := by
