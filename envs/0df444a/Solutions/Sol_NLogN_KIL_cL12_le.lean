    set c := coeffSeq S W C j
    have hWj : (1 : ℝ) ≤ (W : ℝ) ^ (j + 1) := one_le_pow₀ (by exact_mod_cast hW)
    -- the recursive part
    have hrec : (S : ℝ) * (ilCostU5 W K Kd S q Bb j (V / W) : ℝ) ≤
        X * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((S : ℝ) / W * c) := by
