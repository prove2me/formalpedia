    apply IState.ext' <;> intros <;> simp [ss, schoolSt, s2, s1, sg_natAbs, sg_zero, Nat.mod_one] <;>
      split_ifs <;> simp_all
  rw [e0] at h4
  have hloop := IRuns.loop' (I := I) (iprog := iprog) (i := Y) (f := fun c => c != .zero)
