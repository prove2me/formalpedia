    (hS : ∀ χ : PolynomialRankTwoCharacter,
      polynomialCharacterCoefficientPair (polynomialDualShearS χ) =
        polynomialShearS (polynomialCharacterCoefficientPair χ))
    (hN : ∀ χ : PolynomialRankTwoCharacter,
