section
-- Source module: Solutions.KFMS5
/-!
# KFM S5: a loop lemma with an arbitrary invariant state

`loopI_run` / `loopI_cost`: `rep i n body` with `n = N`. The body, started in
`(St k).upd i (N−k :: s.G i)`, ends in `(St (k+1)).upd i (N−k :: s.G i)`. Then the loop ends in
`St N`. The states `St k` may differ from `s` anywhere except on the counter stack `i`. This
covers nested loops and loops that push onto lists (descriptors).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul RS

theorem lI_step (St : ℕ → IState HS) (s : IState HS) (i : Fin HS) (N k : ℕ) :
    decSt i ((St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i)) = lI St s i N (k + 1) := by
  apply IState.ext' _ (by simp [decSt, lI]) (by simp [decSt, lI])
  intro j
  simp only [decSt_G, lI]
  by_cases hj : j = i
  · subst hj
    have : ((St (k + 1)).upd j (.int ((N : ℤ) - k) :: s.G j)).top j = (N : ℤ) - k :=
      IState.top_eq (L := s.G j) (by simp)
    rw [this]; simp; push_cast; ring
  · simp [IState.upd_G, hj]

theorem loopI_inv (i : Fin HS) (n : Ex HS) (body : RS) (s : IState HS) (N : ℕ)
    (St : ℕ → IState HS) (hN : n.eval s = N) (h0 : St 0 = s)
    (hb : ∀ k < N, body.ok (lI St s i N k) ∧
      body.run (lI St s i N k) = (St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i)) :
    ∀ k ≤ N, repSt i n body s k = lI St s i N k := by
  have := repSt_inv i n body s (fun k t => t = lI St s i N k)
    (by rw [hN, lI, h0]; simp)
    (by
      intro k hk ht
      rw [hN, Int.toNat_natCast] at hk
      rw [ht, (hb k hk).2, lI_step])
  rw [hN, Int.toNat_natCast] at this
  exact this

/-- **The invariant loop.** -/
theorem loopI_run (i : Fin HS) (n : Ex HS) (body : RS) (s : IState HS) (N : ℕ)
    (St : ℕ → IState HS) (hi56 : i.val < 56) (hn : n.Clean) (hnok : n.ok s) (hN : n.eval s = N)
    (hw : i ∉ body.writes) (h0 : St 0 = s) (hSi : (St N).G i = s.G i)
    (hb : ∀ k < N, body.ok (lI St s i N k) ∧
      body.run (lI St s i N k) = (St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i)) :
    (rep i n body).ok s ∧ (rep i n body).run s = St N := by
  have hinv := loopI_inv i n body s N St hN h0 hb
  refine ⟨⟨hi56, hn, hnok, by rw [hN]; positivity, hw, fun k hk => ?_⟩, ?_⟩
  · rw [hN, Int.toNat_natCast] at hk
    rw [hinv k hk.le]; exact (hb k hk).1
  · rw [run_rep i n body s hw (by rw [hN]; positivity), hN, Int.toNat_natCast, hinv N le_rfl, lI,
      IState.upd_upd_same, ← hSi, IState.upd_self]

end NLogN.KFM

end

