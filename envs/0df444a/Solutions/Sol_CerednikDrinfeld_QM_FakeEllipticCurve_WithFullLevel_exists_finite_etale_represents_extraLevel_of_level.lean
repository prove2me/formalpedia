      · rw [hκ, Category.assoc, incl_ι]; rfl
      · rw [KerOps.comp_str_of_comp_ι E'.L (N * N₀) (KerOps.toPt E'.L N x hx) κ hκ, Category.assoc, incl_str, hx]
