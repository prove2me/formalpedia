    (∀ j < ((KFV.ts18 D ℓ long)).prod, ∀ k : Fin (2 ^ ℓ), ‖(mrL (2 ^ ℓ) (KFV.ts18 D ℓ long) xf xg).getD j 0 k‖ ≤ 1) ∧
    ∀ j < ((KFV.ts18 D ℓ long)).prod, ∀ k : Fin (2 ^ ℓ),
      ‖(KFV.pipe18c D ℓ K long hK hℓ p xf xg).getD j 0 k - (mrL (2 ^ ℓ) (KFV.ts18 D ℓ long) xf xg).getD j 0 k‖ ≤
        2 * ((KFV.ts18 D ℓ long)).prod * (3 * ℓ + 1) * (2 : ℝ)⁻¹ ^ p := by
  have : NeZero (2 ^ ℓ) := ⟨by positivity⟩
  have hvol : vol (binSh (tgtL D ℓ K long).length) = ((KFV.ts18 D ℓ long)).prod := e18_lengths D ℓ K long hK hℓ
  obtain ⟨lift, hlift⟩ : ∃ lift : (Fin (2 ^ ℓ) → ℂ) → R, ∀ u, C.co (lift u) = u :=
    ⟨Function.surjInv hs, Function.surjInv_eq hs⟩
