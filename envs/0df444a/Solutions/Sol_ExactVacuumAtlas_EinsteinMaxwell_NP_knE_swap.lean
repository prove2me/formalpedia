open Real Complex
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN faradayKN domReg)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
theorem solution (M a Q : ℝ) (A μ : Fin 4) (x : Pt 4) :
    knE M a Q (swap23 A) μ x = conj (knE M a Q A μ x) := by
  fin_cases A
  · exact (knL_conj M a Q x μ).symm
  · exact (knN_conj M a Q x μ).symm
  · show knMbar a x μ = conj (knM a x μ)
    rw [knMbar_eq_conj]
  · show knM a x μ = conj (knMbar a x μ)
    rw [knMbar_eq_conj, Complex.conj_conj]
