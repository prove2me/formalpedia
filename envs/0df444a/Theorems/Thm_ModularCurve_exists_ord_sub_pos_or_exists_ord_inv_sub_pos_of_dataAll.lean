-- title:
--   Chart dichotomy for ̄ j in terms of ord_w
-- statement:
--   Let $A$ be a valuation subring of $\overline{\mathbb{Q}}$ (realised as `AlgebraicClosure ℚ`), let $M$ be a positive natural number, and suppose that for every positive divisor $d$ of $M$ a datum `ModularPolynomialData d` is given, that is, a polynomial $\Phi \in (\mathbb{Z}[x])[y]$ which is monic, of degree $\psi(d) = \sum_{e \mid d,\ e \text{ squarefree}} d/e$ in $y$, and which vanishes when $y$ is specialised at the $q$-expansion $j(q^d)$ and the coefficients in $\mathbb{Z}[x]$ are evaluated at $j(q) = q^{-1}\cdot(\text{integral power series } j_{\mathrm{Num}})$. Let $F$ be the subfield of $\overline{\mathbb{Q}}((q))$ generated over $\overline{\mathbb{Q}}$ by the coefficientwise images of the elements of the $\mathbb{Q}$-subfield of $\mathbb{Q}((q))$ generated by the expansions $j(q^{d})$, $d \mid M$, and let $w$ be a place of $F$ over $\overline{\mathbb{Q}}$, i.e. a proper valuation subring of $F$ containing $\overline{\mathbb{Q}}$ whose ring is a principal ideal ring. Write $\bar j \in F$ for the image of $j(q)$. Then either there is $a \in A$ with $\operatorname{ord}_w(\bar j - a) > 0$, or there is $a \in A$ with $\operatorname{ord}_w(\bar j^{-1} - a) > 0$, where $\operatorname{ord}_w$ is the normalised integer valuation attached to $w$.
--
--   This is the statement that every place of the level-$M$ modular function field over $\overline{\mathbb{Q}}$ specialises $\bar j$ to a point of one of the two standard affine charts of the $j$-line, with centre a constant in the chosen valuation subring $A$, here expressed through strict positivity of the normalised valuation $\operatorname{ord}_w$ rather than through membership in the maximal ideal. It is used in the analysis of places of the characteristic-$p$ fibre models, in particular for the Frobenius and inertia statements at cusp charts.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_ord_sub_pos_or_exists_ord_inv_sub_pos_of_dataAll.lean

import Definitions.Def_ModularCurve_FibreModel
import Definitions.Def_ModularCurve_CharPReduction

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open AlgebraicCurve ModularCurve.CharPModel ModularCurve.CharPReduction in

theorem ModularCurve.exists_ord_sub_pos_or_exists_ord_inv_sub_pos_of_dataAll
    (A : ValuationSubring (AlgebraicClosure ℚ)) (M : ℕ) [NeZero M]
    (dataAll : ∀ (d : ℕ) [NeZero d], d ∣ M → ModularPolynomialData d)
    (w : Place (AlgebraicClosure ℚ)
      (laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionFieldFull M))) :
    (∃ a : A, 0 < w.ord (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ)
          (modularFunctionField_le_full M (jq_mem M))⟩
      - algebraMap (AlgebraicClosure ℚ)
        (laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionFieldFull M))
        (a : AlgebraicClosure ℚ)))
    ∨ (∃ a : A, 0 < w.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ)
          (modularFunctionField_le_full M (jq_mem M))⟩ :
        laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionFieldFull M))⁻¹
      - algebraMap (AlgebraicClosure ℚ)
        (laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionFieldFull M))
        (a : AlgebraicClosure ℚ))) := by sorry
