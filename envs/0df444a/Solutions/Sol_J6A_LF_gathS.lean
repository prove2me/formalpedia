theorem dA_cases {dA : Fin HS} (h1 : 30 ≤ dA.val) (h2 : dA.val ≤ 31) : dA = 30 ∨ dA = 31 := by
  rcases dA with ⟨v, hv⟩
  have : v = 30 ∨ v = 31 := by simp only at h1 h2; omega
  rcases this with rfl | rfl
  · left; rfl
  · right; rfl

theorem dA_facts {dA : Fin HS} (h1 : 30 ≤ dA.val) (h2 : dA.val ≤ 31) :
    dA ∉ rg ∧ dA.val < 56 ∧ dA ≠ sTmp ∧ dA ≠ cRdC ∧ dA ≠ 0 ∧ dA ≠ J6A.DP.T1 ∧
    dA ≠ J6A.DP.T2 ∧ dA ≠ J6A.DP.CC ∧ dA ≠ sZ ∧ dA ≠ cL ∧ dA ≠ 43 ∧ dA ≠ 44 ∧ dA ≠ 34 ∧
    dA ≠ 35 ∧ dA ≠ 36 := by
  rcases dA_cases h1 h2 with rfl | rfl <;> decide

/-- The frame of a slab set-up. -/
theorem frameS {F : Fin HS → List ℤ} {dA : Fin HS}
    (hF : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → F j = [])
    (hρ : ∀ i, F (ρS i) = []) : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → F j = [] := by
  intro j a b c
  by_cases h : ∃ i, ρS i = j
  · obtain ⟨i, rfl⟩ := h; exact hρ i
  · exact hF j a b c (fun i e => h ⟨i, e⟩)

theorem rg_ne {j : Fin HS} (hj : j ∈ rg) : j ≠ 0 ∧ j ≠ sZ := by
  refine ⟨?_, ?_⟩ <;> (rintro rfl; revert hj; decide)

theorem tri_le {pre t post : ℕ} (h1 : 0 < pre) (h2 : 0 < t) (h3 : 0 < post) :
    pre ≤ pre * (t * post) ∧ t ≤ pre * (t * post) ∧ post ≤ pre * (t * post) := by
  have a : 1 ≤ t * post := Nat.mul_pos h2 h3
  refine ⟨?_, ?_, ?_⟩
  · calc pre = pre * 1 := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul_left _ a
  · calc t = 1 * (t * 1) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul h1 (Nat.mul_le_mul_left _ h3)
  · calc post = 1 * (1 * post) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul h1 (Nat.mul_le_mul_right _ h2)

