theorem locIso_of_iso {S' : Type} [CommRing S'] {X : Scheme.{0}} (p : X ⟶ Spec (CommRingCat.of S'))
    {M M' : X.Modules} (e : M ≅ M') : LocIsoOnBase p M M' :=
  fun _ => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso e⟩⟩

theorem val_mul_self_eq_one {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    {L : RelativeGroupLaw S f} {R : Type} [CommRing R] {ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)}
    (χ : L.TorsionCharacter 2 ι) (T : Type) [CommRing T] (κ : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of R))
    (x : SchemeHomOver (κ ≫ ι) f) (hx : L.IsTorsionPoint (κ ≫ ι) 2 x) :
    χ.val T κ x hx * χ.val T κ x hx = 1 := by

  have hxx : L.mul (κ ≫ ι) x x = L.one (κ ≫ ι) := by
    have h : L.mul (κ ≫ ι) (L.mul (κ ≫ ι) (L.one (κ ≫ ι)) x) x = L.one (κ ≫ ι) := hx
    rwa [L.one_mul] at h

  have hone : ∀ (y : SchemeHomOver (κ ≫ ι) f) (hy : L.IsTorsionPoint (κ ≫ ι) 2 y), y = L.one (κ ≫ ι) →
      χ.val T κ y hy = 1 := by
    intro y hy h
    subst h
    have hprod : L.IsTorsionPoint (κ ≫ ι) 2 (L.mul (κ ≫ ι) (L.one (κ ≫ ι)) (L.one (κ ≫ ι))) := by
      rw [L.one_mul]; exact hy
    have h11 := χ.val_mul T κ (L.one _) (L.one _) hy hy hprod
    have k : ∀ (z : SchemeHomOver (κ ≫ ι) f) (hz : L.IsTorsionPoint (κ ≫ ι) 2 z), z = L.one (κ ≫ ι) →
        χ.val T κ z hz = χ.val T κ (L.one _) hy := by
      intro z hz h; subst h; rfl
    rw [k _ hprod (L.one_mul _ _)] at h11
    exact mul_left_cancel (h11.symm.trans (mul_one _).symm)
  have hmulT : L.IsTorsionPoint (κ ≫ ι) 2 (L.mul (κ ≫ ι) x x) := by rw [hxx]; exact L.isTorsionPoint_unit _ 2
  rw [← χ.val_mul T κ x x hx hx hmulT]
  exact hone _ hmulT hxx

end Ws23K3

