/-!
# Atlas V-02 (D, general): second Bianchi identity in a general complex frame

For any `FrameData` (no curvature, NP or field equation):

* `gauge_bianchi`: the curvature `Fom` of the coordinate-direction connection `ω_μ` satisfies
  `Σ_cyc(μνλ) (∂_μ F_{νλ} + [ω_μ, F_{νλ}]) = 0` (symmetry of mixed partials + Jacobi identity);
* **`frame_bianchi`**: `Σ_cyc(E,A,B) (D_E R_{AB} + [Ω_E, R_{AB}] − Σ_K c^K_{EA} R_{KB}) = 0` for the frame curvature
  `R_{AB} = Rfr A B` — the non-coordinate term `−c R` is kept;
* `frame_bianchi_cov`: the same in covariant form, `Σ_cyc (∇_E R)_{AB} = 0` with
  `(∇_E R)_{AB} = D_E R_{AB} + [Ω_E, R_{AB}] − Σ_K Ω_E^K_A R_{KB} − Σ_K Ω_E^K_B R_{AK}` (torsion-free).
-/

open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

section bianchi

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

/-- The frame Bianchi expression `D_C R_{AB} + [Ω_C, R_{AB}] − Σ_K c^K_{CA} R_{KB}`. -/
noncomputable def bianchiX (g gi : Metric n) (E Θ : Fin n → Fin n → Pt n → ℂ) (C A B : Fin n) (x : Pt n) :
    Matrix (Fin n) (Fin n) ℂ :=
  Dmat E C (Rfr g gi E Θ A B) x + Omega g gi E Θ C x * Rfr g gi E Θ A B x
    - Rfr g gi E Θ A B x * Omega g gi E Θ C x - ∑ K, cfr E Θ K C A x • Rfr g gi E Θ K B x

/-- Covariant frame derivative of the curvature, `(∇_C R)_{AB}` (matrix in the remaining two indices). -/
noncomputable def covX (g gi : Metric n) (E Θ : Fin n → Fin n → Pt n → ℂ) (C A B : Fin n) (x : Pt n) :
    Matrix (Fin n) (Fin n) ℂ :=
  Dmat E C (Rfr g gi E Θ A B) x + Omega g gi E Θ C x * Rfr g gi E Θ A B x
    - Rfr g gi E Θ A B x * Omega g gi E Θ C x
    - ∑ K, Omega g gi E Θ C x K A • Rfr g gi E Θ K B x - ∑ K, Omega g gi E Θ C x K B • Rfr g gi E Θ A K x

end bianchi

end ExactVacuumAtlas.EinsteinMaxwell.NP


