-- Source module: Solutions.KFMS1
/-!
# KFM S1: integer roots by counting (setup of `d = ⌊b^{2^{-75}}⌋` and `K = ⌊d^{2^{-56}}⌋`)

`rootP m rv rd` pushes onto `rd` the number of `x ∈ [1, v]` with `x^{2^m} ≤ v`, where `v ≥ 1` is
the top of `rv`. Each test makes `m` saturated squarings `y ↦ min(y², v+1)` (`m` is a literal, a
true constant: `75` or `56`), so every value has `O(log v)` bits. The predicate is downward closed,
so the count is the largest such `x` (**`count_eq_findGreatest`**), i.e. the integer
`2^m`-th root of `v`.

* **`rootP_run`**: the run (`RS`), all stacks but `rd` restored.
* **`count_root_spec`**: `c^{2^m} ≤ v < (c+1)^{2^m}`.
Scratch: `sI = 20` (outer counter), `sY = 21`, `sJ = 22` (inner counter).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS

/-! ## Counting a downward-closed predicate -/

theorem filter_Icc_eq (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    (Finset.Icc 1 N).filter P = Finset.Icc 1 (Nat.findGreatest P N) := by
  ext x
  simp only [Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    exact ⟨h1, Nat.le_findGreatest h2 h3⟩
  · rintro ⟨h1, h2⟩
    have hle : Nat.findGreatest P N ≤ N := Nat.findGreatest_le N
    have hpos : 0 < Nat.findGreatest P N := by omega
    have hP : P (Nat.findGreatest P N) := Nat.findGreatest_of_ne_zero rfl (by omega)
    exact ⟨⟨h1, by omega⟩, hdc x _ h1 h2 hP⟩

theorem count_eq_findGreatest (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    ∑ x ∈ Finset.Icc 1 N, (if P x then (1 : ℤ) else 0) = (Nat.findGreatest P N : ℤ) := by
  rw [← Finset.sum_filter, filter_Icc_eq P N hdc]
  simp

