def cWrapE (D E N Z w dC : ℕ) : ℕ :=
  (D * ck N Z (w + 2 * D) + 1) + (D * ck N Z (w + (2 * D + dC) + 2 * D) + 1) +
    ck N Z (w + (2 * D + dC + 2 * D)) +
    cTrunc (w + 4 * D + dC + 2) (E + (D / 2 + D % 2)) (2 * N) Z

