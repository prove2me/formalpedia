  intro ℓ hℓ
  rw [mem_P0Levels] at hℓ
  rw [mem_union, Cube.mem_P0Levels, Cube.mem_starLevels, ← hℓ]
  exact (Cube.mem_leaves.1 hτ ℓ).symm

