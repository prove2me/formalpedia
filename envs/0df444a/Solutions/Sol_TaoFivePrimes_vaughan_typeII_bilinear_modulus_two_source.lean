    (((j : ℝ) * (a : ℝ) / (q : ℝ) : ℝ) : AddCircle (1 : ℝ))
  let E : AddCircle (1 : ℝ) :=
    (((j : ℝ) * beta : ℝ) : AddCircle (1 : ℝ))
