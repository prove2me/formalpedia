open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.EFRelation
set_option maxHeartbeats 4000000
variable (M ε : ℝ)
theorem solution {x : Pt 4} (hx : x ∈ domStd M) :
    HasDerivAt (fun u => toEF M ε (Function.update x 1 u) 0)
      (ε * (1 + 2 * M / (x 1 - 2 * M))) (x 1) := by
  have hD := domStd_D hx
  have h : HasDerivAt (fun u => x 0 + ε * (u + 2 * M * log (u - 2 * M)))
      (ε * (1 + 2 * M * (1 / (x 1 - 2 * M)))) (x 1) := by
    have hl : HasDerivAt (fun u => log (u - 2 * M)) (1 / (x 1 - 2 * M)) (x 1) := by
      have := ((hasDerivAt_id' (x 1)).sub_const (2 * M)).log hD
      simpa using this
    exact (((hasDerivAt_id' (x 1)).add (hl.const_mul (2 * M))).const_mul ε).const_add (x 0)
  have e : (fun u => toEF M ε (Function.update x 1 u) 0)
      = fun u => x 0 + ε * (u + 2 * M * log (u - 2 * M)) := by
    funext u; simp [Function.update_apply]
  rw [e]; exact h.congr_deriv (by ring)
