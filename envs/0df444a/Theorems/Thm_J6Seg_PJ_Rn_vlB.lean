variable {Q W N : ℕ} {T : Tables} {B : Blocks} {u : Vr} {D : Cs} {a c n y s t α : ℕ}

theorem J6Seg.PJ.Rn.vlB (hN : N ≤ 2 ^ W) (hW2 : 2 ≤ W) (hu : BV W u)
    (h1 : u 1 = c) (h2 : u 2 = n) (h3 : u 3 = y) (h20 : u 20 = Q) (h22 : u 22 = s) (h23 : u 23 = t)
    (h25 : u 25 = α) (h26 : u 26 = B.w) (h9 : u 9 = 2 ^ Q) (h10 : u 10 = 2 ^ (Q + 1))
    (hBs : B.s = s) (hs : 0 < s) (hBa : B.st a = c)
    (hBl : B.st (c + y / (2 * B.w + 1)) = c) (hBn : B.len (c + y / (2 * B.w + 1)) = n)
    (hy : y < n * (2 * B.w + 1)) (hnN : n ≤ N) (hQW : Q ≤ W + 1)
    (hcpl : ∀ i h, T.cpl i h = HvdH.expNeg Q (s ^ 2) (α ^ 2 * (HvdH.eKz s t i h).toNat))
    (hMI : D SMI = ((List.range n).map (miV Q T B a)).reverse)
    (bMI : ∀ i < n, |miV Q T B a i| ≤ 2 ^ W)
    (bss : s * s ≤ 2 ^ W)
    (bX : α ^ 2 * (HvdH.eKz s t ((c + y / (2 * B.w + 1) : ℕ) : ℤ)
      (((y % (2 * B.w + 1) : ℕ) : ℤ) - B.w)).toNat ≤ 2 ^ W)
    (bC : |T.cpl (c + y / (2 * B.w + 1)) (((y % (2 * B.w + 1) : ℕ) : ℤ) - B.w)| ≤ 2 ^ W)
    (bV : |gV Q T B a y| ≤ 2 ^ W) :
    Rn (progL PJ.vlB) u D (fun v' => Fxk [4, 5, 8, 29] u v' ∧ BV W v')
      (update (update D SV (gV Q T B a y :: D SV)) SC (gC B c y :: D SC)) (costL W N PJ.vlB) := by sorry
