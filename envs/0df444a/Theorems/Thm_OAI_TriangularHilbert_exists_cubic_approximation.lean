open OAI OAI.TriangularHilbert
universe uα
open MeasureTheory Filter
open scoped Topology ENNReal NNReal

theorem OAI.TriangularHilbert.exists_cubic_approximation (f : ℝ×ℝ → ℂ) (hf : MemLp f 3 volume) :
    ∃ g : ℕ → ℝ×ℝ → ℂ, (∀ n, Continuous (g n) ∧ HasCompactSupport (g n) ∧ MemLp (g n) 3 volume) ∧
      ∃ D : ℝ×ℝ → ℝ, Integrable D ∧ (∀ z, 0 ≤ D z) ∧
        (∀ᵐ z : ℝ×ℝ, (∀ n, ‖g n z‖^3 ≤ D z) ∧ Tendsto (fun n => g n z) atTop (𝓝 (f z))) := by sorry
