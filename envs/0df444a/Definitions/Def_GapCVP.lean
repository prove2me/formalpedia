    have hmetric :
        dist I.targetPoint (I.latticePoint z) ≤ (I.radius : ℝ) := by
      change I.latticeDistance ≤ (I.radius : ℝ) at hyes
      rw [hnearest] at hyes
      exact hyes
    have hradius : 0 ≤ (I.radius : ℝ) := by
      exact_mod_cast (le_of_lt I.radius_pos)
    nlinarith [dist_nonneg (x := I.targetPoint)
