  calc
    (∑ p ∈ Finset.Ioc A Y,
      ∑ q ∈ Finset.Ioc A Y,
        ∑ r ∈ Finset.Ioc A Y,
          fourFiveLogLogLebesgueCellAtom p *
            (fourFiveLogLogLebesgueCellAtom q *
              (fourFiveLogLogLebesgueCellAtom r *
                fourFiveMovingSimplexKernelThree A y u p q r))) =
      ∑ p ∈ Finset.Ioc A Y,
        ∑ r ∈ Finset.Ioc A Y,
          ∑ q ∈ Finset.Ioc A Y,
            fourFiveLogLogLebesgueCellAtom p *
