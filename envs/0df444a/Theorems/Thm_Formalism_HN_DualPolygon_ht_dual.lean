theorem Formalism.HN.DualPolygon.ht_dual (b : Basis ι K V) (X : InfinitePlace K → Matrix ι ι ℂ)
    (hX : ∀ v, IsUnit (X v).det) (A : Submodule (𝓞 K) V) (hA : A.FG)
    (hsp : Submodule.span K (A : Set V) = ⊤) :
    ht b.dualBasis (dualFrame X) (dualLat A) * ht b X A = 1 := by sorry
