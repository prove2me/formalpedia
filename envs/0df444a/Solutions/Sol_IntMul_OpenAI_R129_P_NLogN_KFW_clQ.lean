    simp only [NLogN.RS.run]; rw [run_G_of_not_mem b _ j h.2, run_G_of_not_mem a _ j h.1]
  | ite c a b, s, j, h => by
    simp only [NLogN.RS.writes, List.mem_append, not_or] at h
    simp only [NLogN.RS.run]; split_ifs
    · exact run_G_of_not_mem a _ j h.1
