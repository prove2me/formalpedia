open J6Seg J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxNum P n src D k)
include h

theorem J6Seg.ChB.chunk_cost_nat :
    kerC (cCk P n src k ap) (cBk P n src k ap) (2 ^ axfC6 P n) (axpost6 P n D k) (cLc P n)
      (axnc6 P n k) (tabsT (axTC6 P n src k ap) (axnc6 P n k)).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * axnc6 P n k * axpost6 P n D k * 2 ^ axfC6 P n)) ≤
    TP6 P n * cY P n src k ap := by sorry
