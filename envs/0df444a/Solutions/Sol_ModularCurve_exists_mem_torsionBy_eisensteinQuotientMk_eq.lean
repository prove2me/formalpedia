namespace Qproof

variable (p : ℕ) [NeZero p]

theorem exists_mem_eisensteinKernelSubmodule_zsmul_eq (iJ : Module HeckeAlg (JZero p))
    (m : ℤ) (hm : m ≠ 0) (w : JZero p) (hw : w ∈ eisensteinKernelSubmodule p iJ) :
    ∃ y ∈ eisensteinKernelSubmodule p iJ, m • y = w := by
  letI := iJ
  unfold eisensteinKernelSubmodule at hw ⊢
  refine Submodule.smul_induction_on
    (p := fun w => ∃ y ∈ eisensteinKernel (JZero p) (eisensteinIdeal p) • (⊤ : Submodule HeckeAlg (JZero p)),
      m • y = w) hw ?_ ?_
  · intro t ht v _hv
    obtain ⟨v', hv'⟩ := jZero_zsmul_surjective p m hm v
    refine ⟨t • v', Submodule.smul_mem_smul ht Submodule.mem_top, ?_⟩
    rw [← hv']
    exact (map_zsmul (DistribSMul.toAddMonoidHom (JZero p) t) m v').symm
  · intro a b ha hb
    obtain ⟨ya, hya, rfl⟩ := ha
    obtain ⟨yb, hyb, rfl⟩ := hb
    exact ⟨ya + yb, Submodule.add_mem _ hya hyb, smul_add m ya yb⟩

end Qproof

theorem solution
    (p : ℕ) [NeZero p] (iJ : Module ModularCurve.HeckeAlg (ModularCurve.JZero p))
    (m : ℤ) (hm : m ≠ 0)
    (z : ModularCurve.EisensteinQuotient p iJ)
    (hz : z ∈ Submodule.torsionBy ℤ (ModularCurve.EisensteinQuotient p iJ) m) :
    ∃ x : ModularCurve.JZero p, x ∈ Submodule.torsionBy ℤ (ModularCurve.JZero p) m ∧
      ModularCurve.eisensteinQuotientMk p iJ x = z := by
  letI := iJ
  obtain ⟨x₀, rfl⟩ : ∃ x₀ : JZero p, eisensteinQuotientMk p iJ x₀ = z :=
    Submodule.mkQ_surjective _ z
  have hmx : m • x₀ ∈ eisensteinKernelSubmodule p iJ := by
    rw [Submodule.mem_torsionBy_iff] at hz
    have : eisensteinQuotientMk p iJ (m • x₀) = 0 := by
      rw [map_zsmul]; exact hz
    exact (Submodule.Quotient.mk_eq_zero _).mp this
  obtain ⟨y, hy, hmy⟩ := Qproof.exists_mem_eisensteinKernelSubmodule_zsmul_eq p iJ m hm (m • x₀) hmx
  refine ⟨x₀ - y, ?_, ?_⟩
  · rw [Submodule.mem_torsionBy_iff, smul_sub, hmy, sub_self]
  · rw [map_sub, sub_eq_self]
    exact (Submodule.Quotient.mk_eq_zero _).mpr hy

end S_ModularCurve_exists_mem_torsionBy_eisensteinQuotientMk_eq
