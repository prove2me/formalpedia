-- title:
--   Observational studies, unconfoundedness and overlap, the class $\mathcal D(\mathcal P,\mathcal M,c)$, observed law and ATE (§3, Definition 8)
-- statement:
--   Let $(\mathcal X,\mathcal A)$ be an arbitrary measurable space of covariates (no condition on the $\sigma$-algebra). An **observational study** is a probability law $D$ of the full data $(X,T,Y(0),Y(1))$ on $\mathcal X\times\{0,1\}\times\mathbb R\times\mathbb R$, where $X$ are the covariates, $T\in\{0,1\}$ the treatment (encoded as a boolean, `true` = treated) and $Y(0),Y(1)$ the potential outcomes; the potential outcomes lie in $[0,1]$ almost surely. The **observed outcome** is $Y=Y(T)$ and the **observed law** $C_D$ is the law of $(X,T,Y)$.
--
--   Write $\sigma(X)$ and $\sigma(X,T)$ for the $\sigma$-algebras generated by the covariates and by covariates and treatment. The **propensity score** at the covariates is $p_D(X)=\Pr_D(T=1\mid X)=E_D[\mathbf 1\{T=1\}\mid\sigma(X)]$ and the **outcome regression** at $(X,T)$ is $m_{D,T}(X)=E_D[Y\mid\sigma(X,T)]$.
--
--   **Definition 8.** $D$ satisfies **unconfoundedness** if $T\perp (Y(0),Y(1))\mid X$, i.e. for every set $A$ of treatment values and every measurable $B\subseteq\mathbb R^2$,
--   $$E_D\big[\mathbf 1\{T\in A\}\mathbf 1\{(Y(0),Y(1))\in B\}\mid X\big]=E_D[\mathbf 1\{T\in A\}\mid X]\;E_D[\mathbf 1\{(Y(0),Y(1))\in B\}\mid X]\quad\text{a.s.},$$
--   and **$c$-overlap** if $c\le p_D(X)\le 1-c$ almost surely.
--
--   Functions $p,m_0,m_1:\mathcal X\to\mathbb R$ **realize** $D$ if $p(X)=p_D(X)$ a.s. and $m_T(X)=E_D[Y\mid X,T]$ a.s. For classes $\mathcal P,\mathcal M$ of real functions on $\mathcal X$ and $c\in(0,1/2)$,
--   $$\mathcal D(\mathcal P,\mathcal M,c)=\{D:\ D\text{ satisfies Definition 8 with }c\text{-overlap},\ p_D\in\mathcal P,\ m_{D,0},m_{D,1}\in\mathcal M\},$$
--   where "$p_D\in\mathcal P$, $m_{D,t}\in\mathcal M$" means that some $p\in\mathcal P$ and $m_0,m_1\in\mathcal M$ realize $D$. The **average treatment effect** is $\tau_D=E_D[Y(1)-Y(0)]$.
--
--   **Formalization Note.** `Study X` is `ProbabilityMeasure (X × Bool × ℝ × ℝ)`. Conditional expectations are Mathlib's `condExp` with respect to the comap σ-algebras `sigmaX`, `sigmaXT`; the propensity and the outcome regression are only defined almost everywhere, so realizability is an almost-sure identity between the class member evaluated at the covariates and the conditional expectation. Members of $\mathcal P$, $\mathcal M$ need not be measurable. $p_D$ and $m_{D,t}$ are the paper's notation; footnote 5 (under unconfoundedness $m_{D,t}(X)=E_D[Y(t)\mid X]$) is a consequence, not part of the definition.
-- source:
--   Cai, Kalavasis, Mamali, Mehrotra, Zampetakis, Minimax Rates for Estimation of Average Treatment Effects in Observational Studies, STOC 2027 submission (manuscript sha256 89998c39…), p. 18 (PDF 20), §3: observational study, Definition 8, D(P, M, c), C_D, τ_D; p. 2, footnote 1

import Mathlib

open MeasureTheory

namespace MinimaxATE.Learnability

/-- Full data `(X, T, Y(0), Y(1))` of one unit: covariates in `X`, treatment `T ∈ {0, 1}` encoded as
`Bool` (`true` = treated), and the two potential outcomes `Y(0), Y(1)` (Cai et al., §3, p. 18). -/
abbrev FullData (X : Type*) := X × Bool × ℝ × ℝ

/-- Observed data `(X, T, Y)` of one unit (§3, p. 18). -/
abbrev Obs (X : Type*) := X × Bool × ℝ

/-- An observational study: a probability law `D` of `(X, T, Y(0), Y(1))` (§3, p. 18). -/
abbrev Study (X : Type*) [MeasurableSpace X] := ProbabilityMeasure (FullData X)

/-- The treatment indicator `T` as a real number (`1` if treated, `0` otherwise). -/
def tInd {X : Type*} (ω : FullData X) : ℝ := if ω.2.1 then 1 else 0

/-- The observed outcome `Y = Y(T)`. -/
def yObs {X : Type*} (ω : FullData X) : ℝ := if ω.2.1 then ω.2.2.2 else ω.2.2.1

/-- The observed triple `(X, T, Y(T))` of a unit. -/
def observe {X : Type*} (ω : FullData X) : Obs X := (ω.1, ω.2.1, yObs ω)

/-- `σ(X)`: the σ-algebra on the full data generated by the covariates. -/
abbrev sigmaX (X : Type*) [MeasurableSpace X] : MeasurableSpace (FullData X) :=
  MeasurableSpace.comap (fun ω : FullData X => ω.1) inferInstance

/-- `σ(X, T)`: the σ-algebra on the full data generated by covariates and treatment. -/
abbrev sigmaXT (X : Type*) [MeasurableSpace X] : MeasurableSpace (FullData X) :=
  MeasurableSpace.comap (fun ω : FullData X => (ω.1, ω.2.1)) inferInstance

/-- The potential outcomes lie in `[0, 1]` (footnote 1, p. 2), almost surely under `D`. -/
def OutcomesInUnit {X : Type*} [MeasurableSpace X] (D : Study X) : Prop :=
  ∀ᵐ ω ∂(D : Measure (FullData X)), ω.2.2.1 ∈ Set.Icc (0 : ℝ) 1 ∧ ω.2.2.2 ∈ Set.Icc (0 : ℝ) 1

/-- Unconfoundedness `T ⊥ (Y(0), Y(1)) | X` (Definition 8, p. 18), as conditional independence
given `σ(X)`: for every set `A` of treatment values and every measurable set `B` of outcome pairs,
`E[1{T ∈ A} 1{(Y(0), Y(1)) ∈ B} | X] = E[1{T ∈ A} | X] · E[1{(Y(0), Y(1)) ∈ B} | X]` a.s. -/
def Unconfounded {X : Type*} [MeasurableSpace X] (D : Study X) : Prop :=
  ∀ (A : Set Bool) (B : Set (ℝ × ℝ)), MeasurableSet B →
    condExp (sigmaX X) (D : Measure (FullData X))
        (fun ω => ({ω' : FullData X | ω'.2.1 ∈ A}.indicator (fun _ => (1 : ℝ)) ω) *
          ({ω' : FullData X | (ω'.2.2.1, ω'.2.2.2) ∈ B}.indicator (fun _ => (1 : ℝ)) ω))
      =ᵐ[(D : Measure (FullData X))]
    fun ω => condExp (sigmaX X) (D : Measure (FullData X))
          ({ω' : FullData X | ω'.2.1 ∈ A}.indicator (fun _ => (1 : ℝ))) ω *
        condExp (sigmaX X) (D : Measure (FullData X))
          ({ω' : FullData X | (ω'.2.2.1, ω'.2.2.2) ∈ B}.indicator (fun _ => (1 : ℝ))) ω

/-- The propensity score evaluated at the covariates, `p_D(X) = Pr_D(T = 1 | X)`, as the
conditional expectation of the treatment indicator given `σ(X)` (§3, p. 18). -/
noncomputable def propensityAtX {X : Type*} [MeasurableSpace X] (D : Study X) : FullData X → ℝ :=
  condExp (sigmaX X) (D : Measure (FullData X)) tInd

/-- The outcome regression evaluated at `(X, T)`, `m_{D,T}(X) = E_D[Y | X, T]` (§3, p. 18). -/
noncomputable def outcomeRegAtXT {X : Type*} [MeasurableSpace X] (D : Study X) :
    FullData X → ℝ :=
  condExp (sigmaXT X) (D : Measure (FullData X)) yObs

/-- `c`-overlap (Definition 8, p. 18): `c ≤ p_D(X) ≤ 1 − c` almost surely. -/
def Overlap {X : Type*} [MeasurableSpace X] (c : ℝ) (D : Study X) : Prop :=
  ∀ᵐ ω ∂(D : Measure (FullData X)), c ≤ propensityAtX D ω ∧ propensityAtX D ω ≤ 1 - c

/-- The functions `p, m₀, m₁ : X → ℝ` are versions of the propensity score and of the outcome
regressions of `D`: `p(X) = p_D(X)` a.s. and `m_T(X) = E_D[Y | X, T]` a.s., i.e.
`m_t = m_{D,t}` on the arm `T = t`. The functions themselves need not be measurable. -/
def Realizes {X : Type*} [MeasurableSpace X] (D : Study X) (p m₀ m₁ : X → ℝ) : Prop :=
  (∀ᵐ ω ∂(D : Measure (FullData X)), p ω.1 = propensityAtX D ω) ∧
  (∀ᵐ ω ∂(D : Measure (FullData X)),
    (if ω.2.1 then m₁ ω.1 else m₀ ω.1) = outcomeRegAtXT D ω)

/-- The class `D(P, M, c)` (§3, p. 18): studies with outcomes in `[0, 1]` that satisfy
unconfoundedness and `c`-overlap (Definition 8) and are realizable: `p_D ∈ P` and
`m_{D,0}, m_{D,1} ∈ M`, read as "some member of the class is a version of the nuisance". -/
def DClass {X : Type*} [MeasurableSpace X] (P M : Set (X → ℝ)) (c : ℝ) : Set (Study X) :=
  {D | OutcomesInUnit D ∧ Unconfounded D ∧ Overlap c D ∧
    ∃ p ∈ P, ∃ m₀ ∈ M, ∃ m₁ ∈ M, Realizes D p m₀ m₁}

/-- The observed law `C_D`, the law of `(X, T, Y(T))` under `D` (§3, p. 18). -/
noncomputable def observedLaw {X : Type*} [MeasurableSpace X] (D : Study X) : Measure (Obs X) :=
  (D : Measure (FullData X)).map observe

/-- The average treatment effect `τ_D = E_D[Y(1) − Y(0)]` (§3, p. 18). -/
noncomputable def ate {X : Type*} [MeasurableSpace X] (D : Study X) : ℝ :=
  ∫ ω, (ω.2.2.2 - ω.2.2.1) ∂(D : Measure (FullData X))

end MinimaxATE.Learnability


