variable {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {epsilon : Real}

theorem MIPStarRE.QPBT.ExtendedLineGame.reindexState_abBbRegrouping_psiHat (setting : _root_.MIPStarRE.QPBT.ProjectiveSetting P epsilon) :
    _root_.MIPStarRE.QPBT.reindexState (_root_.MIPStarRE.QPBT.ExtendedLineGame.abBbRegrouping setting) setting.psiHat =
      _root_.MIPStarRE.QPBT.vecTensor (_root_.MIPStarRE.QPBT.ExtendedLineGame.pairState setting) (_root_.MIPStarRE.QPBT.eprState (_root_.MIPStarRE.QPBT.PauliRegister P)) := by sorry
