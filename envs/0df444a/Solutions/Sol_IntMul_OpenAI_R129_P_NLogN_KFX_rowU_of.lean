    have ha := Ex.congrG a (fun r hr => h r (by simp [Ex.regs, hr]))
    have hb := Ex.congrG b (fun r hr => h r (by simp [Ex.regs, hr]))
    refine ⟨by simp only [Ex.eval, ha.1, hb.1], ?_, fun B => ?_, ?_⟩
    · simp only [Ex.ok, ha.1, hb.1, ha.2.1, hb.2.1]
