      ((((r ^ (m + n) : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) := by
    rw [← QuaternionAlgebra.coe_mul]; congr 1; push_cast; ring
  have hmem : ((((r ^ n : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) * ((((r ^ m : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := e ▸ hΛℤ _
  rw [← E.act_mul ⟨(((r ^ n : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ⟨(((r ^ m : ℕ) : ℤ) : ℚ), hΛℤ _⟩ hmem]
