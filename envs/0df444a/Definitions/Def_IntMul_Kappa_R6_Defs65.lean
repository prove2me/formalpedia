-- Source module: Solutions.J6SegILCtl4
/-!
# B-line IL, B1 follow-up: building the control list, §4 the main loop and the final drops

* `mainLoop_runs`: `rptX bN' entP` over the whole table: the reversed control prefix
  `(ctlAux src argOf (range n') 0).1` on `bT`, the position `pos n'` on `bCur`, the table moved
  (reversed) to `bSv`; cost `n' (21 cU Z + 4000) + 4000 n + 3000 (n' + 1)` (the drops telescope).
* `finB_runs`: the final `n - pos n'` drops, `bCur` popped: `bT` holds `(flatC (ctlOf …)).reverse`.
* `lenB_runs`: `n + n'` pushed on `rNC`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

section main
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The main loop's state after `j` entries. -/
def mS (G : Fin HS → List ℤ) (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n' : ℕ) (LX : List ℤ)
    (j : ℕ) : Fin HS → List ℤ :=
  cS G ((srcTab src argOf n').drop (2 * j) ++ LX) ((srcTab src argOf j).reverse ++ G bSv)
    ((pos src argOf j : ℤ) :: G bCur)
    ((flatC (J6Seg.ctlAux src argOf (List.range j) 0).1).reverse ++ G bT) (G bCd) (G bA) (G bD)
    (G bW)

end main

section fin
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The final drops: `n - cur` drop commands, then the position popped. -/
def finB : IStmt HS P :=
  .seq (.op (.dup bN bW)) (.seq (.op (.dup bCur bD)) (.seq (.op (.neg bD)) (.seq
    (.op (.add bW bD bD)) (.seq (rptX bD lA lC lD dropE) (.seq (.op (.drop bD))
    (.op (.drop bCur)))))))

/-- The length `n + n'` pushed on `rNC`. -/
def lenB : IStmt HS P :=
  .seq (.op (.dup bN bW)) (.seq (.op (.dup bN' bD)) (.op (.add bW bD rNC)))

end fin

end J6Seg.Slab

end

