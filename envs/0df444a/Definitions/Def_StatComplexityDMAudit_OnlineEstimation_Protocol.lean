-- title:
--   History-dependent density predictions and realizability
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb P)$ carry measurable observations $(x_t,y_t)$ for a finite horizon $T$. Write $H_{<t}=((x_s,y_s))_{s<t}$. The past sigma-field is $\sigma(H_{<t})$, and the current sigma-field is $\sigma(H_{<t},x_t)$. Learner and expert predictions are normalized jointly measurable densities depending on $H_{<t}$ and a prospective context and outcome. An arbitrary set $I$ indexes experts, with fixed true index $i^\star$.
--
--   Realizability means, for every round and every nonnegative jointly measurable test function $f$ of the past, context and outcome,
--   $$\mathbb E[f(H_{<t},x_t,y_t)\mid H_{<t},x_t]=\int_Y f(H_{<t},x_t,y)g_{i^\star,t}(y\mid x_t;H_{<t})\,\nu(dy\mid x_t)\quad\text{almost surely}.$$
--
--   This integral formulation expresses the actual conditional outcome law without imposing a context distribution or requesting a disintegration on an arbitrary measurable space. It assumes no conditional-affinity identity or concentration conclusion. The finite tuples use zero-based indices; no alphabet or expert-class finiteness is imposed.
-- source:
--   Foster, Kakade, Qian and Rakhlin, The Statistical Complexity of Interactive Decision Making, arXiv:2112.13487v3 (11 July 2023), https://arxiv.org/abs/2112.13487v3, §A.3 and §A.3.1, printed/PDF pp. 75–76, Assumption A.1; §2 probability-space conventions, p. 9.

import Mathlib
import Definitions.Def_StatComplexityDMAudit_OnlineEstimation_Densities

set_option autoImplicit false
open scoped ENNReal NNReal

namespace StatComplexityDMAudit.OnlineEstimation

open MeasureTheory ProbabilityTheory

/-- A history is a finite tuple; the context and outcome carriers are arbitrary. -/
abbrev History (X Y : Type*) (n : ℕ) := Fin n → X × Y

/-- Observations carried by a given probability space, with no restriction on context laws. -/
structure Observations (Ω X Y : Type*) [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] (T : ℕ) where
  obs : Fin T → Ω → X × Y
  measurable_obs : ∀ t, Measurable (obs t)

/-- Past observations, excluding round `t` (round 0 is the source's round 1). -/
def Observations.history {Ω X Y : Type*} [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] {T : ℕ}
    (o : Observations Ω X Y T) (t : Fin T) (ω : Ω) : History X Y t.val :=
  fun s => o.obs ⟨s.val, Nat.lt_trans s.isLt t.isLt⟩ ω

/-- Exactly the sigma-field generated by the preceding history. -/
abbrev Observations.past {Ω X Y : Type*} [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] {T : ℕ}
    (o : Observations Ω X Y T) (t : Fin T) : MeasurableSpace Ω :=
  MeasurableSpace.comap (o.history t) inferInstance

/-- The past together with the current context, used only for the conditional outcome law. -/
abbrev Observations.current {Ω X Y : Type*} [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] {T : ℕ}
    (o : Observations Ω X Y T) (t : Fin T) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (o.history t ω, (o.obs t ω).1)) inferInstance

/-- Each prediction is chosen from the history, before the current context and outcome. -/
abbrev Predictor {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Kernel X Y) (T : ℕ) :=
  (t : Fin T) → ConditionalDensity (History X Y t.val) X Y ν

/-- Evaluate a history-dependent density at this round's history and context. -/
def densityAt {Ω X Y : Type*} [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] {T : ℕ} {ν : Kernel X Y}
    (o : Observations Ω X Y T) (q : Predictor ν T) (t : Fin T) (ω : Ω) (y : Y) : ℝ≥0 :=
  (q t).value (o.history t ω, ((o.obs t ω).1, y))

/-- Assumption A.1 in conditional integral form for every nonnegative measurable test
function of the history, current context and outcome. This does not assume an affinity
formula or any estimation guarantee. It requires no regular disintegration of X. -/
def IsRealizable {Ω I X Y : Type*} [MeasurableSpace Ω]
    [MeasurableSpace X] [MeasurableSpace Y] {T : ℕ} {ν : Kernel X Y}
    (μ : Measure Ω) (o : Observations Ω X Y T) (g : I → Predictor ν T) (istar : I) : Prop :=
  ∀ (t : Fin T) (f : (History X Y t.val × X) × Y → ℝ≥0∞), Measurable f →
    condLExp (o.current t) μ
        (fun ω => f ((o.history t ω, (o.obs t ω).1), (o.obs t ω).2)) =ᵐ[μ]
      fun ω => ∫⁻ y, f ((o.history t ω, (o.obs t ω).1), y) *
        (densityAt o (g istar) t ω y : ℝ≥0∞) ∂ν ((o.obs t ω).1)

end StatComplexityDMAudit.OnlineEstimation


