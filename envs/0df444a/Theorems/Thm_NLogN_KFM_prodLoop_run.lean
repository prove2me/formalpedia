    (LS LP : List Item) (hS : u.G mS = .int (s : ℤ) :: LS) (hP : u.G mP = .int 1 :: LP)
    (hs : 2 ≤ s) (hIx : ixO.eval u = i) (hIok : ixO.ok u)
    (hj : ∀ j < i, (j < d' → j ≤ Mh) ∧ (d' ≤ j → j - d' ≤ Mf)) :
