/-!
# The marked predictable σ-algebra

The compensated Poisson integral is defined for marked processes that are progressively
measurable, and it is the `L²` limit of left-endpoint approximants; the identification of that
limit with a pathwise integral against the random measure needs the strictly smaller predictable
class. On `Ω × ℝ × E` the marked predictable σ-algebra is generated by the rectangles
`F × (r, q] × B` with `0 ≤ r`, `F` measurable for `ℱ r` and `B` measurable with `ν B < ∞`. These
rectangles are a π-system, and a real-valued predictable marked process is progressively
measurable.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace LevyStochCalc.Probability

universe u v w

variable {Ω : Type u} {mΩ : MeasurableSpace Ω} {E : Type v} [MeasurableSpace E]

section Deterministic

variable {ℱ : Filtration ℝ mΩ} {ν : Measure E}


theorem _root_.Prove2MeSourceProof.h_fdeeab164202d120da06e07d {F : Type w} [MeasurableSpace F] [Zero F] {r q : ℝ}
    (hr : 0 ≤ r) {A : Set E} (hA : MeasurableSet A) (hAν : ν A ≠ ⊤) {c : Ω → F}
    (hc : Measurable[ℱ r] c) :
    MarkedPredictable ℱ ν fun (ω : Ω) (s : ℝ) (e : E) =>
      (Set.Ioc r q ×ˢ A).indicator (fun _ : ℝ × E => c ω) (s, e) := by
  intro U hU
  have hcU : MeasurableSet[ℱ r] (c ⁻¹' U) := hc hU
  have hbig : MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν]
      ((c ⁻¹' U) ×ˢ (Set.Ioc r q ×ˢ A)) :=
    MeasurableSpace.measurableSet_generateFrom ⟨r, q, _, _, hr, hcU, hA, hAν, rfl⟩
  have huniv : MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν]
      ((Set.univ : Set Ω) ×ˢ (Set.Ioc r q ×ˢ A)) :=
    MeasurableSpace.measurableSet_generateFrom ⟨r, q, _, _, hr, MeasurableSet.univ, hA, hAν, rfl⟩
  change MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν]
    ((fun p : Ω × ℝ × E => (Set.Ioc r q ×ˢ A).indicator (fun _ : ℝ × E => c p.1) p.2) ⁻¹' U)
  by_cases h0 : (0 : F) ∈ U
  · have hset : (fun p : Ω × ℝ × E =>
        (Set.Ioc r q ×ˢ A).indicator (fun _ : ℝ × E => c p.1) p.2) ⁻¹' U
        = ((c ⁻¹' U) ×ˢ (Set.Ioc r q ×ˢ A))
          ∪ ((Set.univ : Set Ω) ×ˢ (Set.Ioc r q ×ˢ A))ᶜ := by
      ext p
      by_cases hp : p.2 ∈ Set.Ioc r q ×ˢ A
      · have hL := Set.indicator_of_mem hp fun _ : ℝ × E => c p.1
        constructor
        · intro hmem
          rw [Set.mem_preimage, hL] at hmem
          exact Or.inl ⟨hmem, hp⟩
        · rintro (hmem | hmem)
          · rw [Set.mem_preimage, hL]
            exact hmem.1
          · exact absurd (⟨Set.mem_univ p.1, hp⟩ : p ∈ (Set.univ : Set Ω) ×ˢ
              (Set.Ioc r q ×ˢ A)) hmem
      · have hL := Set.indicator_of_notMem hp fun _ : ℝ × E => c p.1
        constructor
        · intro _
          exact Or.inr fun hmem => hp hmem.2
        · intro _
          rw [Set.mem_preimage, hL]
          exact h0
    rw [hset]
    exact hbig.union huniv.compl
  · have hset : (fun p : Ω × ℝ × E =>
        (Set.Ioc r q ×ˢ A).indicator (fun _ : ℝ × E => c p.1) p.2) ⁻¹' U
        = (c ⁻¹' U) ×ˢ (Set.Ioc r q ×ˢ A) := by
      ext p
      by_cases hp : p.2 ∈ Set.Ioc r q ×ˢ A
      · have hL := Set.indicator_of_mem hp fun _ : ℝ × E => c p.1
        constructor
        · intro hmem
          rw [Set.mem_preimage, hL] at hmem
          exact ⟨hmem, hp⟩
        · intro hmem
          rw [Set.mem_preimage, hL]
          exact hmem.1
      · have hL := Set.indicator_of_notMem hp fun _ : ℝ × E => c p.1
        constructor
        · intro hmem
          rw [Set.mem_preimage, hL] at hmem
          exact absurd hmem h0
        · intro hmem
          exact absurd hmem.2 hp
    rw [hset]
    exact hbig
end Deterministic

