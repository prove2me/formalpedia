namespace Hex

universe u

namespace Matrix

/-- Adding `s` times a distinct source row to a destination row and then
adding `-s` times that source row restores the original matrix. -/
theorem p2m_solution_aux [Lean.Grind.Ring R]
    (M : Matrix R n m) {src dst : Fin n} (s : R) (hsrcdst : src ≠ dst) :
    rowAdd (rowAdd M src dst s) src dst (-s) = M := by
  apply ext_getElem
  intro rr kk
  rw [getElem_rowAdd]
  by_cases hrd : rr = dst
  · rw [ite_eq_left hrd]
    rw [getElem_rowAdd, ite_eq_left rfl]
    have hsrc_ne_dst : src ≠ dst := hsrcdst
    rw [getElem_rowAdd, ite_eq_right hsrc_ne_dst]
    grind
  · rw [ite_eq_right hrd]
    rw [getElem_rowAdd, ite_eq_right hrd]

end Matrix
