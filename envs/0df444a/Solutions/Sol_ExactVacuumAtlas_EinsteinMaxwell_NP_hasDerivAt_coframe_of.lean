open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
theorem solution {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}
    {W : Set (ℝ × Pt 4)} (hW : IsOpen W) (hΘs : ∀ C ν, ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => Θ p.1 C ν p.2) W)
    (hdual : ∀ p ∈ W, coMat (Θ p.1) p.2 * frMat (E p.1) p.2 = 1) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
    (hB : ∀ A μ, HasDerivAt (fun ε => E ε A μ x) (B A μ x) 0) (C ν : Fin 4) :
    HasDerivAt (fun ε => Θ ε C ν x) (coVar (Θ 0) B C ν x) 0 := by
  have hΘd : ∀ C ν, HasDerivAt (fun ε => Θ ε C ν x) (deriv (fun ε => Θ ε C ν x) 0) 0 := fun C ν =>
    hasDerivAt_param_of_jointC (Φ := fun ε y => Θ ε C ν y) hW (hΘs C ν) hx
  have dual_apply : ∀ ε, (ε, x) ∈ W → ∀ C A, ∑ μ, Θ ε C μ x * E ε A μ x = (1 : Matrix (Fin 4) (Fin 4) ℂ) C A := by
    intro ε hε C A
    have := congrFun (congrFun (hdual (ε, x) hε) C) A
    simpa [Matrix.mul_apply, coMat, frMat] using this
  have compl_apply : ∀ ν ρ, ∑ C, E 0 C ν x * Θ 0 C ρ x = (1 : Matrix (Fin 4) (Fin 4) ℂ) ν ρ := by
    intro ν ρ
    have h1 := mul_eq_one_comm.mp (hdual ((0 : ℝ), x) hx)
    have := congrFun (congrFun h1 ν) ρ
    simpa [Matrix.mul_apply, coMat, frMat] using this
  set θ' : Fin 4 → Fin 4 → ℂ := fun C ν => deriv (fun ε => Θ ε C ν x) 0 with hθ'
  have hdual' : ∀ C A, ∑ μ, (θ' C μ * E 0 A μ x + Θ 0 C μ x * B A μ x) = 0 := by
    intro C A
    have hd := HasDerivAt.fun_sum (u := Finset.univ) fun μ _ => (hΘd C μ).mul (hB A μ)
    exact eq_of_hasDerivAt_slice hW hx hd
      (hasDerivAt_const (0 : ℝ) ((1 : Matrix (Fin 4) (Fin 4) ℂ) C A)) fun ε hε => dual_apply ε hε C A
  have key : θ' C ν = coVar (Θ 0) B C ν x := by
    have e1 : θ' C ν = ∑ μ, θ' C μ * (1 : Matrix (Fin 4) (Fin 4) ℂ) μ ν := by
      simp [Matrix.one_apply]
    rw [e1]
    simp only [← compl_apply, Finset.mul_sum]
    rw [Finset.sum_comm]
    have e2 : ∀ A, ∑ μ, θ' C μ * (E 0 A μ x * Θ 0 A ν x) = -∑ μ, Θ 0 C μ x * B A μ x * Θ 0 A ν x := by
      intro A
      have := hdual' C A
      have e3 : ∑ μ, θ' C μ * (E 0 A μ x * Θ 0 A ν x) = (∑ μ, θ' C μ * E 0 A μ x) * Θ 0 A ν x := by
        rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun μ _ => by ring
      have e4 : ∑ μ, Θ 0 C μ x * B A μ x * Θ 0 A ν x = (∑ μ, Θ 0 C μ x * B A μ x) * Θ 0 A ν x := by
        rw [Finset.sum_mul]
      rw [e3, e4, Finset.sum_add_distrib] at *
      linear_combination Θ 0 A ν x * this
    simp only [e2, coVar, Finset.sum_neg_distrib]
  rw [← key]
  exact hΘd C ν
