      ((gc F S2 m : ℤ) - gc F S1 m) * S1 := by
  unfold swP
  rw [sc_int, sc_int, gc_sc_hi hS2 hk0 (by rw [hk]; ring) (gc_lt hF _) m]

/-! ## Nested fields -/

/-- Reading an upper field after setting a lower one. -/
theorem gc_up {Q1 S1 Q2 S2 k : ℕ} (hS2 : 0 < S2) (hk : 0 < k) (h : S1 = S2 * Q2 * k) {v : ℕ}
    (hv : v < Q2) (m : ℕ) : gc Q1 S1 (sc Q2 S2 v m) = gc Q1 S1 m :=
  gc_sc_hi hS2 hk (by rw [h]; ring) hv m

/-- Reading a lower field after setting an upper one. -/
theorem gc_dn {Q1 S1 Q2 S2 k : ℕ} (hS2 : 0 < S2) (h : S1 = S2 * Q2 * k) (v m : ℕ) :
    gc Q2 S2 (sc Q1 S1 v m) = gc Q2 S2 m := gc_sc_lo hS2 h v m

theorem sc_comm {Q1 S1 Q2 S2 k : ℕ} (hS2 : 0 < S2) (hk : 0 < k) (h : S1 = S2 * Q2 * k) {a b : ℕ}
    (hb : b < Q2) (m : ℕ) : sc Q1 S1 a (sc Q2 S2 b m) = sc Q2 S2 b (sc Q1 S1 a m) := by
  have e : (sc Q1 S1 a (sc Q2 S2 b m) : ℤ) = sc Q2 S2 b (sc Q1 S1 a m) := by
    rw [sc_int, sc_int, sc_int Q2 S2 b (sc Q1 S1 a m), sc_int, gc_up hS2 hk h hb, gc_dn hS2 h]
    ring
  exact_mod_cast e

theorem nest_trans {S1 S2 S3 Q2 Q3 k k' : ℕ} (hk : 0 < k) (hk' : 0 < k') (h1 : S1 = S2 * Q2 * k)
    (h2 : S2 = S3 * Q3 * k') (hQ2 : 0 < Q2) : ∃ k'', 0 < k'' ∧ S1 = S3 * Q3 * k'' :=
  ⟨k' * Q2 * k, by positivity, by rw [h1, h2]; ring⟩

/-- `gc` of a value set in the same field. -/
theorem gc_sc_same {Q S : ℕ} (hS : 0 < S) {v : ℕ} (hv : v < Q) (m : ℕ) : gc Q S (sc Q S v m) = v :=
  gc_sc_self hS hv m

/-! ## The layout of a record index -/

namespace Lay

variable {l : Lay}

theorem OK.pY (h : l.OK) : 0 < l.sY := by
  obtain ⟨k, hk, e⟩ := h.kYB; rw [e]; exact Nat.mul_pos (Nat.mul_pos h.pB h.qc) hk
theorem OK.pX (h : l.OK) : 0 < l.sX := by
  obtain ⟨k, hk, e⟩ := h.kXB; rw [e]; exact Nat.mul_pos (Nat.mul_pos h.pB h.qc) hk
theorem OK.pU (h : l.OK) : 0 < l.sU := by
  obtain ⟨k, hk, e⟩ := h.kUY; rw [e]; exact Nat.mul_pos (Nat.mul_pos h.pY h.ql) hk
theorem OK.pT (h : l.OK) : 0 < l.sT := by
  obtain ⟨k, hk, e⟩ := h.kTU; rw [e]; exact Nat.mul_pos (Nat.mul_pos h.pU h.qc) hk
theorem OK.pM (h : l.OK) : 0 < l.M := by
  obtain ⟨k, hk, e⟩ := h.kM; rw [e]; exact Nat.mul_pos (Nat.mul_pos h.pT h.qc) hk

theorem OK.kTY (h : l.OK) : ∃ k, 0 < k ∧ l.sT = l.sY * l.QL * k := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb, eb⟩ := h.kUY
  exact nest_trans ha hb ea eb h.qc
theorem OK.kTX (h : l.OK) : ∃ k, 0 < k ∧ l.sT = l.sX * l.QL * k := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb, eb⟩ := h.kUX
  exact nest_trans ha hb ea eb h.qc
theorem OK.kUB (h : l.OK) : ∃ k, 0 < k ∧ l.sU = l.sB * l.QC * k := by
  obtain ⟨a, ha, ea⟩ := h.kUY; obtain ⟨b, hb, eb⟩ := h.kYB
  exact nest_trans ha hb ea eb h.ql
theorem OK.kTB (h : l.OK) : ∃ k, 0 < k ∧ l.sT = l.sB * l.QC * k := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb, eb⟩ := h.kUB
  exact nest_trans ha hb ea eb h.qc
theorem OK.kMT (h : l.OK) : ∃ k, 0 < k ∧ l.M = l.QC * l.sT * k := by
  obtain ⟨k, hk, e⟩ := h.kM; exact ⟨k, hk, by rw [e]; ring⟩

theorem box_cs (h : l.OK) (m : ℕ) : l.BoxL (l.cs m) :=
  ⟨gc_lt h.qc _, gc_lt h.qc _, gc_lt h.ql _⟩

/-- `X` is untouched by setting `Y`. -/
theorem gcX_scY (h : l.OK) {v : ℕ} (hv : v < l.QL) (m : ℕ) :
    gc l.QL l.sX (sc l.QL l.sY v m) = gc l.QL l.sX m := by
  rcases h.kXY with ⟨k, hk, e⟩ | ⟨k, hk, e⟩
  · exact gc_up h.pY hk e hv m
  · exact gc_dn h.pX e v m

theorem cs_set (h : l.OK) {c : CS} (hb : l.BoxL c) (m : ℕ) : l.cs (l.set c m) = c := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb', eb⟩ := h.kTY; obtain ⟨d, hd, ed⟩ := h.kUY
  obtain ⟨t, u, y⟩ := c
  obtain ⟨h1, h2, h3⟩ := hb
  simp only [cs, set] at *
  congr 1
  · exact gc_sc_same h.pT h1 _
  · rw [gc_dn h.pU ea, gc_sc_same h.pU h2]
  · rw [gc_dn h.pY eb, gc_dn h.pY ed, gc_sc_same h.pY h3]

theorem xv_set (h : l.OK) {c : CS} (hb : l.BoxL c) (m : ℕ) : l.xv (l.set c m) = l.xv m := by
  obtain ⟨a, ha, ea⟩ := h.kTX; obtain ⟨b, hb', eb⟩ := h.kUX
  simp only [xv, set]
  rw [gc_dn h.pX ea, gc_dn h.pX eb, gcX_scY h hb.2.2]

theorem set_int (h : l.OK) {c : CS} (hb : l.BoxL c) (m : ℕ) :
    (l.set c m : ℤ) = m + ((c.t : ℤ) - gc l.QC l.sT m) * l.sT + ((c.u : ℤ) - gc l.QC l.sU m) * l.sU +
      ((c.y : ℤ) - gc l.QL l.sY m) * l.sY := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb2, eb⟩ := h.kTY; obtain ⟨d, hd, ed⟩ := h.kUY
  simp only [set]
  rw [sc_int, sc_int, sc_int, gc_up h.pU ha ea hb.2.1, gc_up h.pY hb2 eb hb.2.2,
    gc_up h.pY hd ed hb.2.2]
  ring

theorem set_set (h : l.OK) {c c' : CS} (hb : l.BoxL c) (hb' : l.BoxL c') (m : ℕ) :
    l.set c (l.set c' m) = l.set c m := by
  have e : (l.set c (l.set c' m) : ℤ) = l.set c m := by
    rw [set_int h hb, set_int h hb, set_int h hb' m]
    have := cs_set h hb' m
    have e1 : gc l.QC l.sT (l.set c' m) = c'.t := congrArg CS.t this
    have e2 : gc l.QC l.sU (l.set c' m) = c'.u := congrArg CS.u this
    have e3 : gc l.QL l.sY (l.set c' m) = c'.y := congrArg CS.y this
    rw [e1, e2, e3]
    ring
  exact_mod_cast e

theorem stepP_stepP (h : l.OK) {F F' : ℕ → CS → CS} (hF : ∀ x c, l.BoxL c → l.BoxL (F x c))
    (hF' : ∀ x c, l.BoxL c → l.BoxL (F' x c)) (m : ℕ) :
    l.stepP F (l.stepP F' m) = l.stepP (fun x c => F x (F' x c)) m := by
  have hb := hF' (l.xv m) _ (box_cs h m)
  simp only [stepP]
  rw [cs_set h hb, xv_set h hb, set_set h (hF _ _ hb) hb]

/-! ### Single fields as states -/

theorem sc_gc_of {Q S n n' : ℕ} (h : gc Q S n' = gc Q S n) : sc Q S (gc Q S n) n' = n' := by
  rw [← h, sc_gc]

theorem scY_eq (h : l.OK) {v : ℕ} (hv : v < l.QL) (m : ℕ) :
    sc l.QL l.sY v m = l.set ⟨(l.cs m).t, (l.cs m).u, v⟩ m := by
  obtain ⟨b, hb2, eb⟩ := h.kTY; obtain ⟨d, hd, ed⟩ := h.kUY
  simp only [set, cs]
  rw [sc_gc_of (gc_up h.pY hd ed hv m), sc_gc_of (gc_up h.pY hb2 eb hv m)]

theorem scU_eq (h : l.OK) {v : ℕ} (hv : v < l.QC) (m : ℕ) :
    sc l.QC l.sU v m = l.set ⟨(l.cs m).t, v, (l.cs m).y⟩ m := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨d, hd, ed⟩ := h.kUY
  simp only [set, cs]
  rw [sc_gc, sc_gc_of (gc_up h.pU ha ea hv m)]

theorem scT_eq (h : l.OK) {v : ℕ} (hv : v < l.QC) (m : ℕ) :
    sc l.QC l.sT v m = l.set ⟨v, (l.cs m).u, (l.cs m).y⟩ m := by
  simp only [set, cs]
  rw [sc_gc, sc_gc]

/-! ### Rotations as steps -/

/-- The rotation amount of a table entry `(o mod Q)`. -/
theorem rot_subM {Q a : ℕ} (hQ : 0 < Q) (ha : a < Q) (o : ℤ) :
    (a + Q - (o % (Q : ℤ)).toNat) % Q = subM Q a o := by
  have h0 : 0 ≤ o % (Q : ℤ) := Int.emod_nonneg _ (by omega)
  have h1 : o % (Q : ℤ) < Q := Int.emod_lt_of_pos _ (by omega)
  have hr : ((o % (Q : ℤ)).toNat : ℤ) = o % (Q : ℤ) := Int.toNat_of_nonneg h0
  have hle : (o % (Q : ℤ)).toNat ≤ a + Q := by omega
  have e : (((a + Q - (o % (Q : ℤ)).toNat) % Q : ℕ) : ℤ) = ((a : ℤ) - o) % (Q : ℤ) := by
    push_cast [Nat.cast_sub hle]
    rw [hr]
    have : (a : ℤ) + Q - o % Q = ((a : ℤ) - o) + Q * (1 + o / Q) := by
      linear_combination (-1 : ℤ) * Int.emod_add_mul_ediv o (Q : ℤ)
    rw [this, Int.add_mul_emod_self_left]
  unfold subM
  rw [← e, Int.toNat_natCast]

/-- **Rotation of `Y`** by a table whose entry at the prefix of `m` is `o (xv m) (cs m) mod QL`. -/
theorem rotY_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (m / (l.QL * l.sY)) = ((o (l.xv m) (l.cs m)) % (l.QL : ℤ)).toNat) :
    rotP l.QL l.sY as m = l.stepP (fun x c => ⟨c.t, c.u, subM l.QL c.y (o x c)⟩) m := by
  unfold rotP stepP
  rw [has, rot_subM h.ql (gc_lt h.ql _), scY_eq h (subM_lt h.ql _ _)]
  rfl

/-- **Rotation of an upper compact field `(QC, S)` through `Bk`** (swap, rotate `Bk`, swap). -/
theorem rotUp_eq (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sB * l.QC * k) (as : ℕ → ℕ)
    {m : ℕ} {a : ℤ}
    (has : as (swP l.QC S l.sB m / (l.QC * l.sB)) = (a % (l.QC : ℤ)).toNat) :
    swP l.QC S l.sB (rotP l.QC l.sB as (swP l.QC S l.sB m)) = sc l.QC S (subM l.QC (gc l.QC S m) a) m := by
  have hB := h.pB; have hQ := h.qc
  set m1 := swP l.QC S l.sB m with hm1
  have g1 : gc l.QC l.sB m1 = gc l.QC S m := by
    rw [hm1, swP, gc_dn hB hS, gc_sc_same hB (gc_lt hQ _)]
  have g1' : gc l.QC S m1 = gc l.QC l.sB m := by
    rw [hm1, swP, gc_sc_same (by rw [hS]; positivity) (gc_lt hQ _)]
  set w := subM l.QC (gc l.QC S m) a with hw
  have hwl : w < l.QC := subM_lt hQ _ _
  have e2 : rotP l.QC l.sB as m1 = sc l.QC l.sB w m1 := by
    unfold rotP
    rw [has, g1, rot_subM hQ (gc_lt hQ _)]
  rw [e2]
  set m2 := sc l.QC l.sB w m1 with hm2
  have g2 : gc l.QC l.sB m2 = w := gc_sc_same hB hwl m1
  have g2' : gc l.QC S m2 = gc l.QC l.sB m := by
    rw [hm2, gc_up hB hk hS hwl, g1']
  unfold swP
  rw [g2, g2', hm2, sc_sc hB hwl, hm1, swP, ← sc_comm hB hk hS (gc_lt hQ _), sc_sc hB (gc_lt hQ _),
    sc_gc, sc_sc (by rw [hS]; positivity) (gc_lt hQ _)]

theorem rotT_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (swP l.QC l.sT l.sB m / (l.QC * l.sB)) = ((o (l.xv m) (l.cs m)) % (l.QC : ℤ)).toNat) :
    swP l.QC l.sT l.sB (rotP l.QC l.sB as (swP l.QC l.sT l.sB m)) =
      l.stepP (fun x c => ⟨subM l.QC c.t (o x c), c.u, c.y⟩) m := by
  obtain ⟨k, hk, e⟩ := h.kTB
  rw [rotUp_eq h hk e as has, scT_eq h (subM_lt h.qc _ _)]
  rfl

theorem rotU_eq (h : l.OK) (as : ℕ → ℕ) (o : ℕ → CS → ℤ) {m : ℕ}
    (has : as (swP l.QC l.sU l.sB m / (l.QC * l.sB)) = ((o (l.xv m) (l.cs m)) % (l.QC : ℤ)).toNat) :
    swP l.QC l.sU l.sB (rotP l.QC l.sB as (swP l.QC l.sU l.sB m)) =
      l.stepP (fun x c => ⟨c.t, subM l.QC c.u (o x c), c.y⟩) m := by
  obtain ⟨k, hk, e⟩ := h.kUB
  rw [rotUp_eq h hk e as has, scU_eq h (subM_lt h.qc _ _)]
  rfl

/-! ### Fields read through the swaps -/

theorem gcY_swP (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sY * l.QL * k) (m : ℕ) :
    gc l.QL l.sY (swP l.QC S l.sB m) = gc l.QL l.sY m := by
  obtain ⟨a, ha, ea⟩ := h.kYB
  unfold swP
  rw [gc_dn h.pY hS, gc_up h.pB ha ea (gc_lt h.qc _)]

theorem gcX_swP (h : l.OK) {S k : ℕ} (hk : 0 < k) (hS : S = l.sX * l.QL * k) (m : ℕ) :
    gc l.QL l.sX (swP l.QC S l.sB m) = gc l.QL l.sX m := by
  obtain ⟨a, ha, ea⟩ := h.kXB
  unfold swP
  rw [gc_dn h.pX hS, gc_up h.pB ha ea (gc_lt h.qc _)]

/-- `U` read through the `T`/`Bk` swap. -/
theorem gcU_swPT (h : l.OK) (m : ℕ) : gc l.QC l.sU (swP l.QC l.sT l.sB m) = gc l.QC l.sU m := by
  obtain ⟨a, ha, ea⟩ := h.kTU; obtain ⟨b, hb, eb⟩ := h.kUB
  unfold swP
  rw [gc_dn h.pU ea, gc_up h.pB hb eb (gc_lt h.qc _)]

end Lay

/-! ## Digits of unreduced field values -/

theorem dgt_mod_dvd {W N : ℕ} (hW : 0 < W) {s : ℕ} (h : W ^ (s + 1) ∣ N) (b : ℕ) :
    dgt W s (b % N) = dgt W s b := by
  unfold dgt
  obtain ⟨c, hc⟩ := h
  have hb : b = b % N + N * (b / N) := (Nat.mod_add_div b N).symm
  conv_rhs => rw [hb]
  have hWs : 0 < W ^ s := pow_pos hW s
  rw [show N * (b / N) = W ^ s * (W * (c * (b / N))) by rw [hc]; ring,
    Nat.add_mul_div_left _ _ hWs, Nat.add_mul_mod_self_left]

theorem cdg_mod {G n s : ℕ} (hs : s < n) (a : ℕ) : cdg G s (a % Qc G n) = cdg G s a := by
  unfold cdg Qc
  refine dgt_mod_dvd (by positivity) ?_ a
  exact Nat.pow_dvd_pow _ (by omega)

theorem seg_mod {K ρ L s : ℕ} (hL : ρ + (s + 1) * K ≤ L) (a : ℕ) :
    seg K ρ s (a % 2 ^ L) = seg K ρ s a := by
  unfold seg
  have e : a % 2 ^ L / 2 ^ ρ = a / 2 ^ ρ % 2 ^ (L - ρ) := by
    rw [← Nat.mod_mul_right_div_self, ← pow_add]; congr 3; omega
  rw [e]
  refine dgt_mod_dvd (by positivity) ?_ _
  rw [← pow_mul]; exact Nat.pow_dvd_pow _ (by rw [mul_comm]; omega)

theorem ybit_mod {K ρ L s : ℕ} (hL : ρ + (s + 1) * K ≤ L) (a : ℕ) :
    ybit K ρ s (a % 2 ^ L) = ybit K ρ s a := by
  unfold ybit; rw [seg_mod hL]

end IntMul.Kappa.R6.IL2C

end

