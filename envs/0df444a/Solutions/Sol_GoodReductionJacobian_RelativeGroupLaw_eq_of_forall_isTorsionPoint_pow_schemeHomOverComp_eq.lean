noncomputable section

universe u

namespace P2mKcDenseTorsion

section Maps

variable {k : Type u} [Field k] {N : Scheme.{u}} {gN : N ⟶ Spec (CommRingCat.of k)}
  (LN : RelativeGroupLaw k gN)

local notation "pt" => 𝟙 (Spec (CommRingCat.of k))

abbrev cg (hc : LN.IsCommutative) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) :
    CommGroup (SchemeHomOver t gN) :=
  { LN.pointGroup t with mul_comm := hc t }

theorem nsmul_eq_pow {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (n : ℕ)
    (x : SchemeHomOver t gN) :
    LN.nsmul t n x = (letI := LN.pointGroup t; x ^ n) := by
  letI := LN.pointGroup t
  induction n with
  | zero => rfl
  | succ n ih => rw [LN.nsmul_succ, ih, pow_succ]; rfl

theorem isTorsionPoint_iff_pow {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (n : ℕ)
    (x : SchemeHomOver t gN) :
    LN.IsTorsionPoint t n x ↔ (letI := LN.pointGroup t; x ^ n = 1) := by
  rw [RelativeGroupLaw.isTorsionPoint_def, nsmul_eq_pow]
  rfl

def const {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (s : SchemeHomOver pt gN) :
    SchemeHomOver t gN :=
  GoodReductionJacobian.schemeHomOverComp t (Category.comp_id t) s

@[scoped simp]
theorem const_coe {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (s : SchemeHomOver pt gN) :
    (const t s).1 = t ≫ s.1 := rfl

theorem const_pt (s : SchemeHomOver pt gN) : const pt s = s :=
  Subtype.ext (Category.id_comp _)

theorem const_transition {T T' : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (t' : T' ⟶ Spec (CommRingCat.of k)) (ψ : T' ⟶ T) (hψ : ψ ≫ t = t')
    (s : SchemeHomOver pt gN) :
    GoodReductionJacobian.schemeHomOverComp ψ hψ (const t s) = const t' s :=
  Subtype.ext (by simp [← hψ])

theorem const_mul {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (s s' : SchemeHomOver pt gN) :
    const t (LN.mul pt s s') = LN.mul t (const t s) (const t s') :=
  LN.mul_natural pt t t (Category.comp_id t) s s'

theorem const_one {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) :
    const t (LN.one pt) = LN.one t :=
  LN.one_natural pt t t (Category.comp_id t)

theorem inv_natural {T T' : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (t' : T' ⟶ Spec (CommRingCat.of k)) (ψ : T' ⟶ T) (hψ : ψ ≫ t = t')
    (x : SchemeHomOver t gN) :
    GoodReductionJacobian.schemeHomOverComp ψ hψ (LN.inv t x) =
      LN.inv t' (GoodReductionJacobian.schemeHomOverComp ψ hψ x) := by
  letI := LN.pointGroup t'
  have h : GoodReductionJacobian.schemeHomOverComp ψ hψ (LN.inv t x) *
      GoodReductionJacobian.schemeHomOverComp ψ hψ x = 1 := by
    show LN.mul t' _ _ = LN.one t'
    rw [← LN.mul_natural t t' ψ hψ, LN.inv_mul_cancel, LN.one_natural]
  exact eq_inv_of_mul_eq_one_left h

def transl (s : SchemeHomOver pt gN) : N ⟶ N :=
  (LN.mul gN (const gN s) RelativeGroupLaw.idPoint).1

theorem transl_over (s : SchemeHomOver pt gN) : transl LN s ≫ gN = gN :=
  (LN.mul gN (const gN s) RelativeGroupLaw.idPoint).2

theorem comp_transl {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t gN)
    (s : SchemeHomOver pt gN) : x.1 ≫ transl LN s = (LN.mul t (const t s) x).1 := by
  have h := LN.mul_natural gN t x.1 x.2 (const gN s) RelativeGroupLaw.idPoint
  have h1 : GoodReductionJacobian.schemeHomOverComp x.1 x.2 (const gN s) = const t s :=
    const_transition gN t x.1 x.2 s
  have h2 : GoodReductionJacobian.schemeHomOverComp x.1 x.2
      (RelativeGroupLaw.idPoint : SchemeHomOver gN gN) = x :=
    Subtype.ext (Category.comp_id _)
  rw [h1, h2] at h
  exact congrArg Subtype.val h

theorem transl_one : transl LN (LN.one pt) = 𝟙 N := by
  have h := comp_transl LN (RelativeGroupLaw.idPoint : SchemeHomOver gN gN) (LN.one pt)
  rw [const_one, LN.one_mul] at h
  simpa using h

theorem transl_comp (s s' : SchemeHomOver pt gN) :
    transl LN s ≫ transl LN s' = transl LN (LN.mul pt s' s) := by
  have h := comp_transl LN (LN.mul gN (const gN s) RelativeGroupLaw.idPoint) s'
  rw [← LN.mul_assoc, ← const_mul] at h
  exact h

scoped instance isIso_transl (s : SchemeHomOver pt gN) : IsIso (transl LN s) := by
  letI := LN.pointGroup pt
  refine ⟨⟨transl LN (LN.inv pt s), ?_, ?_⟩⟩
  · rw [transl_comp, show LN.mul pt (LN.inv pt s) s = LN.one pt from LN.inv_mul_cancel pt s,
      transl_one]
  · rw [transl_comp, show LN.mul pt s (LN.inv pt s) = LN.one pt from LN.mul_inv_cancel pt s,
      transl_one]

abbrev clpt (x : SchemeHomOver pt gN) : N := x.1 (IsLocalRing.closedPoint k)

theorem transl_clpt (x s : SchemeHomOver pt gN) :
    transl LN s (clpt x) = clpt (LN.mul pt s x) := by
  have h := comp_transl LN x s
  rw [const_pt] at h
  show (x.1 ≫ transl LN s) (IsLocalRing.closedPoint k) = _
  rw [h]

def invN : N ⟶ N := (LN.inv gN RelativeGroupLaw.idPoint).1

theorem invN_over : invN LN ≫ gN = gN := (LN.inv gN RelativeGroupLaw.idPoint).2

theorem comp_invN {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t gN) :
    x.1 ≫ invN LN = (LN.inv t x).1 := by
  have h := inv_natural LN gN t x.1 x.2 RelativeGroupLaw.idPoint
  have h2 : GoodReductionJacobian.schemeHomOverComp x.1 x.2
      (RelativeGroupLaw.idPoint : SchemeHomOver gN gN) = x :=
    Subtype.ext (Category.comp_id _)
  rw [h2] at h
  exact congrArg Subtype.val h

theorem invN_invN : invN LN ≫ invN LN = 𝟙 N := by
  letI := LN.pointGroup gN
  have h := comp_invN LN (LN.inv gN RelativeGroupLaw.idPoint)
  rw [show LN.inv gN (LN.inv gN RelativeGroupLaw.idPoint) = RelativeGroupLaw.idPoint from
    inv_inv (RelativeGroupLaw.idPoint : SchemeHomOver gN gN)] at h
  exact h

scoped instance isIso_invN : IsIso (invN LN) := ⟨⟨invN LN, invN_invN LN, invN_invN LN⟩⟩

theorem invN_clpt (x : SchemeHomOver pt gN) : invN LN (clpt x) = clpt (LN.inv pt x) := by
  show (x.1 ≫ invN LN) (IsLocalRing.closedPoint k) = _
  rw [comp_invN]

end Maps

section Closure

variable {k : Type u} [Field k] {N : Scheme.{u}} {gN : N ⟶ Spec (CommRingCat.of k)}
  (LN : RelativeGroupLaw k gN)

local notation "pt" => 𝟙 (Spec (CommRingCat.of k))

def clS (H : Set (SchemeHomOver pt gN)) : Set N := (fun x => clpt x) '' H

def Zcl (H : Set (SchemeHomOver pt gN)) : Closeds N := ⟨closure (clS H), isClosed_closure⟩

theorem coe_Zcl (H : Set (SchemeHomOver pt gN)) : (Zcl H : Set N) = closure (clS H) := rfl

def Zpts (H : Set (SchemeHomOver pt gN)) : Set (SchemeHomOver pt gN) := {x | clpt x ∈ (Zcl H : Set N)}

theorem mem_Zpts_iff (H : Set (SchemeHomOver pt gN)) (x : SchemeHomOver pt gN) :
    x ∈ Zpts H ↔ clpt x ∈ (Zcl H : Set N) := Iff.rfl

theorem subset_Zpts (H : Set (SchemeHomOver pt gN)) : H ⊆ Zpts H :=
  fun x hx => subset_closure ⟨x, hx, rfl⟩

variable (H : Set (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) gN))
  (one_mem : LN.one (𝟙 (Spec (CommRingCat.of k))) ∈ H)
  (mul_mem : ∀ x y, x ∈ H → y ∈ H → LN.mul (𝟙 (Spec (CommRingCat.of k))) x y ∈ H)
  (inv_mem : ∀ x, x ∈ H → LN.inv (𝟙 (Spec (CommRingCat.of k))) x ∈ H)

include mul_mem inv_mem in

theorem transl_image_clS {h : SchemeHomOver pt gN} (hh : h ∈ H) :
    (transl LN h) '' clS H = clS H := by
  letI := LN.pointGroup pt
  apply Set.Subset.antisymm
  · rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    rw [transl_clpt]
    exact ⟨_, mul_mem h x hh hx, rfl⟩
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨clpt (LN.mul pt (LN.inv pt h) x), ⟨_, mul_mem _ _ (inv_mem h hh) hx, rfl⟩, ?_⟩
    rw [transl_clpt]
    show clpt (h * (h⁻¹ * x)) = clpt x
    rw [mul_inv_cancel_left]

include mul_mem inv_mem in

theorem transl_image_Zcl {h : SchemeHomOver pt gN} (hh : h ∈ H) :
    (transl LN h) '' (Zcl H : Set N) = Zcl H := by
  let e : N ≃ₜ N := (transl LN h).homeomorph
  show e '' closure (clS H) = closure (clS H)
  rw [e.image_closure]
  congr 1
  exact transl_image_clS LN H mul_mem inv_mem hh

include inv_mem in

theorem invN_image_clS : (invN LN) '' clS H = clS H := by
  letI := LN.pointGroup pt
  apply Set.Subset.antisymm
  · rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    rw [invN_clpt]
    exact ⟨_, inv_mem x hx, rfl⟩
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨clpt (LN.inv pt x), ⟨_, inv_mem x hx, rfl⟩, ?_⟩
    rw [invN_clpt]
    show clpt (x⁻¹⁻¹) = clpt x
    rw [inv_inv]

include inv_mem in

theorem invN_image_Zcl : (invN LN) '' (Zcl H : Set N) = Zcl H := by
  let e : N ≃ₜ N := (invN LN).homeomorph
  show e '' closure (clS H) = closure (clS H)
  rw [e.image_closure]
  congr 1
  exact invN_image_clS LN H inv_mem

include mul_mem inv_mem in

theorem transl_image_Zcl_subset (hc : LN.IsCommutative) {x : SchemeHomOver pt gN} (hx : x ∈ Zpts H) :
    (transl LN x) '' (Zcl H : Set N) ⊆ Zcl H := by
  have h1 : (transl LN x) '' clS H ⊆ Zcl H := by
    rintro _ ⟨_, ⟨h, hh, rfl⟩, rfl⟩
    rw [transl_clpt, hc.mul_comm pt x h, ← transl_clpt, ← transl_image_Zcl LN H mul_mem inv_mem hh]
    exact ⟨clpt x, hx, rfl⟩
  show (transl LN x) '' closure (clS H) ⊆ Zcl H
  refine (image_closure_subset_closure_image (transl LN x).continuous).trans ?_
  exact closure_minimal h1 (Zcl H).2

include one_mem in
theorem one_mem_Zpts : LN.one pt ∈ Zpts H := subset_Zpts H one_mem

include mul_mem inv_mem in
theorem mul_mem_Zpts (hc : LN.IsCommutative) {x y : SchemeHomOver pt gN} (hx : x ∈ Zpts H)
    (hy : y ∈ Zpts H) : LN.mul pt x y ∈ Zpts H := by
  show clpt (LN.mul pt x y) ∈ (Zcl H : Set N)
  rw [← transl_clpt]
  exact transl_image_Zcl_subset LN H mul_mem inv_mem hc hx ⟨clpt y, hy, rfl⟩

include inv_mem in
theorem inv_mem_Zpts {x : SchemeHomOver pt gN} (hx : x ∈ Zpts H) : LN.inv pt x ∈ Zpts H := by
  show clpt (LN.inv pt x) ∈ (Zcl H : Set N)
  rw [← invN_clpt, ← invN_image_Zcl LN H inv_mem]
  exact ⟨clpt x, hx, rfl⟩

end Closure

section Reduced

variable {k : Type u} [Field k] {N : Scheme.{u}} {gN : N ⟶ Spec (CommRingCat.of k)}
  (LN : RelativeGroupLaw k gN)

local notation "pt" => 𝟙 (Spec (CommRingCat.of k))

open AlgebraicGeometry.Scheme.IdealSheafData

abbrev redSub (Z : Closeds N) : Scheme.{u} := (vanishingIdeal Z).subscheme

abbrev redι (Z : Closeds N) : redSub Z ⟶ N := (vanishingIdeal Z).subschemeι

scoped instance isReduced_redSub (Z : Closeds N) : IsReduced (redSub Z) :=
  (AlgebraicGeometry.Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal_and_le_ker Z).1

theorem range_redι (Z : Closeds N) : Set.range (redι Z) = (Z : Set N) := by
  rw [range_subschemeι]
  rfl

theorem redι_apply_mem (Z : Closeds N) (a : redSub Z) : redι Z a ∈ (Z : Set N) := by
  rw [← range_redι Z]
  exact ⟨a, rfl⟩

def redLift (Z : Closeds N) {T : Scheme.{u}} [IsReduced T] (φ : T ⟶ N)
    (hφ : Set.range φ ⊆ Z) : T ⟶ redSub Z :=
  IsClosedImmersion.lift (redι Z) φ (by
    rw [ker_subschemeι]
    exact (AlgebraicGeometry.Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal_and_le_ker
      Z).2 φ hφ)

@[reassoc (attr := simp)]
theorem redLift_ι (Z : Closeds N) {T : Scheme.{u}} [IsReduced T] (φ : T ⟶ N)
    (hφ : Set.range φ ⊆ Z) : redLift Z φ hφ ≫ redι Z = φ :=
  IsClosedImmersion.lift_fac _ _ _

def ratLift (Z : Closeds N) (s : SchemeHomOver pt gN) (hs : clpt s ∈ (Z : Set N)) :
    Spec (CommRingCat.of k) ⟶ redSub Z :=
  redLift Z s.1 (by
    rintro _ ⟨q, rfl⟩
    have : q = IsLocalRing.closedPoint k := Subsingleton.elim _ _
    rw [this]; exact hs)

@[reassoc (attr := simp)]
theorem ratLift_ι (Z : Closeds N) (s : SchemeHomOver pt gN) (hs : clpt s ∈ (Z : Set N)) :
    ratLift Z s hs ≫ redι Z = s.1 :=
  redLift_ι _ _ _

theorem ratLift_over (Z : Closeds N) (s : SchemeHomOver pt gN) (hs : clpt s ∈ (Z : Set N)) :
    ratLift Z s hs ≫ redι Z ≫ gN = 𝟙 _ := by
  rw [ratLift_ι_assoc, s.2]

def mulMap (Z : Closeds N) : pullback (redι Z ≫ gN) (redι Z ≫ gN) ⟶ N :=
  (LN.mul (pullback.fst (redι Z ≫ gN) (redι Z ≫ gN) ≫ redι Z ≫ gN)
    ⟨pullback.fst _ _ ≫ redι Z, by simp⟩
    ⟨pullback.snd _ _ ≫ redι Z, by simpa using pullback.condition.symm⟩).1

theorem lift_mulMap (Z : Closeds N) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (a b : T ⟶ redSub Z) (ha : a ≫ redι Z ≫ gN = t) (hb : b ≫ redι Z ≫ gN = t) :
    pullback.lift a b (ha.trans hb.symm) ≫ mulMap LN Z =
      (LN.mul t ⟨a ≫ redι Z, by simpa using ha⟩ ⟨b ≫ redι Z, by simpa using hb⟩).1 := by
  have hψ : pullback.lift a b (ha.trans hb.symm) ≫
      (pullback.fst (redι Z ≫ gN) (redι Z ≫ gN) ≫ redι Z ≫ gN) = t := by
    rw [pullback.lift_fst_assoc, ha]
  have hnat := LN.mul_natural _ t (pullback.lift a b (ha.trans hb.symm)) hψ
    ⟨pullback.fst _ _ ≫ redι Z, by simp⟩
    ⟨pullback.snd _ _ ≫ redι Z, by simpa using pullback.condition.symm⟩
  have h1 : GoodReductionJacobian.schemeHomOverComp (pullback.lift a b (ha.trans hb.symm)) hψ
      (⟨pullback.fst _ _ ≫ redι Z, by simp⟩ : SchemeHomOver _ gN) =
      ⟨a ≫ redι Z, by simpa using ha⟩ :=
    Subtype.ext (by rw [GoodReductionJacobian.schemeHomOverComp_coe, ← Category.assoc,
      pullback.lift_fst])
  have h2 : GoodReductionJacobian.schemeHomOverComp (pullback.lift a b (ha.trans hb.symm)) hψ
      (⟨pullback.snd _ _ ≫ redι Z, by simpa using pullback.condition.symm⟩ :
        SchemeHomOver _ gN) =
      ⟨b ≫ redι Z, by simpa using hb⟩ :=
    Subtype.ext (by rw [GoodReductionJacobian.schemeHomOverComp_coe, ← Category.assoc,
      pullback.lift_snd])
  rw [h1, h2] at hnat
  exact congrArg Subtype.val hnat

end Reduced

section SubgroupScheme

variable {k : Type u} [Field k] [IsAlgClosed k] {N : Scheme.{u}} {gN : N ⟶ Spec (CommRingCat.of k)}
  [LocallyOfFiniteType gN] (LN : RelativeGroupLaw k gN) (hc : LN.IsCommutative)
  (H : Set (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) gN))
  (one_mem : LN.one (𝟙 (Spec (CommRingCat.of k))) ∈ H)
  (mul_mem : ∀ x y, x ∈ H → y ∈ H → LN.mul (𝟙 (Spec (CommRingCat.of k))) x y ∈ H)
  (inv_mem : ∀ x, x ∈ H → LN.inv (𝟙 (Spec (CommRingCat.of k))) x ∈ H)

local notation "pt" => 𝟙 (Spec (CommRingCat.of k))

theorem eq_univ_of_closedPoints_subset {X : Type*} [TopologicalSpace X] [JacobsonSpace X]
    {C : Set X} (hC : IsClosed C) (h : closedPoints X ⊆ C) : C = Set.univ := by
  have h1 : closure (Set.univ ∩ closedPoints X) = Set.univ :=
    (jacobsonSpace_iff X).mp inferInstance isClosed_univ
  rw [Set.univ_inter] at h1
  apply Set.eq_univ_of_univ_subset
  rw [← h1]
  exact closure_minimal h hC

include hc one_mem mul_mem inv_mem in

theorem range_mulMap_subset :
    Set.range (mulMap LN (Zcl H)) ⊆ (Zcl H : Set N) := by
  set Z := Zcl H with hZ
  let P : Scheme.{u} := pullback (redι Z ≫ gN) (redι Z ≫ gN)
  let gP : P ⟶ Spec (CommRingCat.of k) := pullback.fst (redι Z ≫ gN) (redι Z ≫ gN) ≫ redι Z ≫ gN
  haveI : JacobsonSpace P := LocallyOfFiniteType.jacobsonSpace gP
  let M : P ⟶ N := mulMap LN Z

  have hcl : closedPoints P ⊆ M ⁻¹' (Z : Set N) := by
    intro c hc0
    let q : Spec (CommRingCat.of k) ⟶ P := pointOfClosedPoint gP c hc0
    have hq : q ≫ gP = 𝟙 _ := pointOfClosedPoint_comp gP c hc0
    let a : Spec (CommRingCat.of k) ⟶ redSub Z := q ≫ pullback.fst _ _
    let b : Spec (CommRingCat.of k) ⟶ redSub Z := q ≫ pullback.snd _ _
    have ha : a ≫ redι Z ≫ gN = pt := by
      simp only [a, Category.assoc]; exact hq
    have hb : b ≫ redι Z ≫ gN = pt := by
      simp only [b, Category.assoc]
      rw [← pullback.condition]
      exact hq
    have hqab : pullback.lift a b (ha.trans hb.symm) = q := by
      apply pullback.hom_ext
      · exact pullback.lift_fst _ _ _
      · exact pullback.lift_snd _ _ _
    have hM : q ≫ M = (LN.mul pt ⟨a ≫ redι Z, by simpa using ha⟩ ⟨b ≫ redι Z, by simpa using hb⟩).1 := by
      rw [← hqab]; exact lift_mulMap LN Z pt a b ha hb
    have hxa : (⟨a ≫ redι Z, by simpa using ha⟩ : SchemeHomOver pt gN) ∈ Zpts H := by
      show (a ≫ redι Z) (IsLocalRing.closedPoint k) ∈ (Z : Set N)
      rw [Scheme.Hom.comp_apply]; exact redι_apply_mem Z _
    have hxb : (⟨b ≫ redι Z, by simpa using hb⟩ : SchemeHomOver pt gN) ∈ Zpts H := by
      show (b ≫ redι Z) (IsLocalRing.closedPoint k) ∈ (Z : Set N)
      rw [Scheme.Hom.comp_apply]; exact redι_apply_mem Z _
    have hmul := mul_mem_Zpts LN H mul_mem inv_mem hc hxa hxb
    rw [mem_Zpts_iff] at hmul
    show M c ∈ (Z : Set N)
    have hc1 : c = q (IsLocalRing.closedPoint k) := (pointOfClosedPoint_apply gP c hc0 _).symm
    rw [hc1, ← Scheme.Hom.comp_apply, hM]
    exact hmul
  have huniv : M ⁻¹' (Z : Set N) = Set.univ :=
    eq_univ_of_closedPoints_subset (Z.2.preimage M.continuous) hcl
  rintro _ ⟨c, rfl⟩
  have : c ∈ M ⁻¹' (Z : Set N) := by rw [huniv]; trivial
  exact this

scoped instance isReduced_pullback (Z : Closeds N) : IsReduced (pullback (redι Z ≫ gN) (redι Z ≫ gN) : Scheme.{u}) := by
  haveI : GeometricallyReduced (redι Z ≫ gN) :=
    AlgebraicGeometry.GeometricallyReduced.of_isReduced_of_perfectField _
  haveI : IsLocallyNoetherian (redSub Z) := LocallyOfFiniteType.isLocallyNoetherian (redι Z ≫ gN)
  infer_instance

abbrev Zs : Scheme.{u} := redSub (Zcl H)

abbrev ιZ : Zs H ⟶ N := redι (Zcl H)

abbrev gZ : Zs H ⟶ Spec (CommRingCat.of k) := ιZ H ≫ gN

def mulZ : pullback (gZ H) (gZ H) ⟶ Zs H :=
  redLift (Zcl H) (mulMap LN (Zcl H)) (range_mulMap_subset LN hc H one_mem mul_mem inv_mem)

@[reassoc (attr := simp)]
theorem mulZ_ι : mulZ LN hc H one_mem mul_mem inv_mem ≫ ιZ H = mulMap LN (Zcl H) := redLift_ι _ _ _

def oneZ : Spec (CommRingCat.of k) ⟶ Zs H :=
  ratLift (Zcl H) (LN.one pt) (one_mem_Zpts LN H one_mem)

@[reassoc (attr := simp)]
theorem oneZ_ι : oneZ LN H one_mem ≫ ιZ H = (LN.one pt).1 := ratLift_ι _ _ _

include inv_mem in
theorem range_ι_invN_subset : Set.range (ιZ H ≫ invN LN) ⊆ (Zcl H : Set N) := by
  rintro _ ⟨a, rfl⟩
  rw [← invN_image_Zcl LN H inv_mem, Scheme.Hom.comp_apply]
  exact ⟨ιZ H a, redι_apply_mem _ a, rfl⟩

def invZ : Zs H ⟶ Zs H := redLift (Zcl H) (ιZ H ≫ invN LN) (range_ι_invN_subset LN H inv_mem)

@[reassoc (attr := simp)]
theorem invZ_ι : invZ LN H inv_mem ≫ ιZ H = ιZ H ≫ invN LN := redLift_ι _ _ _

def toN {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t (gZ H)) :
    SchemeHomOver t gN :=
  ⟨x.1 ≫ ιZ H, by rw [Category.assoc]; exact x.2⟩

@[scoped simp]
theorem toN_coe {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t (gZ H)) :
    (toN H x).1 = x.1 ≫ ιZ H := rfl

theorem toN_injective {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} :
    Function.Injective (toN H (T := T) (t := t)) := by
  intro x y h
  exact Subtype.ext ((cancel_mono (ιZ H)).mp (congrArg Subtype.val h))

theorem toN_transition {T T' : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (t' : T' ⟶ Spec (CommRingCat.of k)) (ψ : T' ⟶ T) (hψ : ψ ≫ t = t')
    (x : SchemeHomOver t (gZ H)) :
    toN H (GoodReductionJacobian.schemeHomOverComp ψ hψ x) =
      GoodReductionJacobian.schemeHomOverComp ψ hψ (toN H x) :=
  Subtype.ext (Category.assoc _ _ _)

def mulPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x y : SchemeHomOver t (gZ H)) :
    SchemeHomOver t (gZ H) :=
  ⟨pullback.lift x.1 y.1 (x.2.trans y.2.symm) ≫ mulZ LN hc H one_mem mul_mem inv_mem, by
    show pullback.lift x.1 y.1 _ ≫ mulZ LN hc H one_mem mul_mem inv_mem ≫ ιZ H ≫ gN = t
    rw [mulZ_ι_assoc, ← Category.assoc, lift_mulMap LN _ t x.1 y.1 x.2 y.2]
    exact (LN.mul t _ _).2⟩

theorem toN_mulPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (x y : SchemeHomOver t (gZ H)) :
    toN H (mulPt LN hc H one_mem mul_mem inv_mem t x y) = LN.mul t (toN H x) (toN H y) := by
  apply Subtype.ext
  rw [toN_coe]
  show (pullback.lift x.1 y.1 _ ≫ mulZ LN hc H one_mem mul_mem inv_mem) ≫ ιZ H = _
  rw [Category.assoc, mulZ_ι, lift_mulMap LN _ t x.1 y.1 x.2 y.2]
  rfl

def onePt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) : SchemeHomOver t (gZ H) :=
  ⟨t ≫ oneZ LN H one_mem, by
    show t ≫ oneZ LN H one_mem ≫ ιZ H ≫ gN = t
    rw [oneZ_ι_assoc, (LN.one pt).2, Category.comp_id]⟩

theorem toN_onePt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) :
    toN H (onePt LN H one_mem t) = LN.one t := by
  apply Subtype.ext
  rw [toN_coe, ← const_one LN t, const_coe]
  show (t ≫ oneZ LN H one_mem) ≫ ιZ H = _
  rw [Category.assoc, oneZ_ι]

def invPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t (gZ H)) :
    SchemeHomOver t (gZ H) :=
  ⟨x.1 ≫ invZ LN H inv_mem, by
    show x.1 ≫ invZ LN H inv_mem ≫ ιZ H ≫ gN = t
    rw [invZ_ι_assoc, invN_over]
    exact x.2⟩

theorem toN_invPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (x : SchemeHomOver t (gZ H)) : toN H (invPt LN H inv_mem t x) = LN.inv t (toN H x) := by
  apply Subtype.ext
  rw [toN_coe]
  show (x.1 ≫ invZ LN H inv_mem) ≫ ιZ H = _
  rw [Category.assoc, invZ_ι, ← Category.assoc]
  exact comp_invN LN (toN H x)

def lawZ : RelativeGroupLaw k (gZ H) where
  mul t x y := mulPt LN hc H one_mem mul_mem inv_mem t x y
  one t := onePt LN H one_mem t
  inv t x := invPt LN H inv_mem t x
  mul_assoc t x y z := by
    apply toN_injective H
    simp only [toN_mulPt]
    exact LN.mul_assoc t _ _ _
  one_mul t x := by
    apply toN_injective H
    simp only [toN_mulPt, toN_onePt]
    exact LN.one_mul t _
  mul_one t x := by
    apply toN_injective H
    simp only [toN_mulPt, toN_onePt]
    exact LN.mul_one t _
  inv_mul_cancel t x := by
    apply toN_injective H
    simp only [toN_mulPt, toN_invPt, toN_onePt]
    exact LN.inv_mul_cancel t _
  mul_natural t t' ψ hψ x y := by
    apply toN_injective H
    rw [toN_transition]
    simp only [toN_mulPt]
    rw [LN.mul_natural t t' ψ hψ, toN_transition, toN_transition]

def ιZ' : SchemeHomOver (gZ H) gN := ⟨ιZ H, rfl⟩

theorem comp_ιZ'_eq_toN {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (x : SchemeHomOver t (gZ H)) :
    NeronModelInfra.schemeHomOverComp x (ιZ' H) = toN H x := rfl

theorem toN_lawZ_mul {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k))
    (x y : SchemeHomOver t (gZ H)) :
    toN H ((lawZ LN hc H one_mem mul_mem inv_mem).mul t x y) = LN.mul t (toN H x) (toN H y) :=
  toN_mulPt LN hc H one_mem mul_mem inv_mem t x y

theorem exists_toN_eq {x : SchemeHomOver pt gN} (hx : x ∈ Zpts H) :
    ∃ z : SchemeHomOver pt (gZ H), toN H z = x :=
  ⟨⟨ratLift (Zcl H) x hx, ratLift_over (Zcl H) x hx⟩, Subtype.ext (ratLift_ι (Zcl H) x hx)⟩

theorem toN_mem_Zpts (z : SchemeHomOver pt (gZ H)) : toN H z ∈ Zpts H := by
  show (z.1 ≫ ιZ H) (IsLocalRing.closedPoint k) ∈ (Zcl H : Set N)
  rw [Scheme.Hom.comp_apply]
  exact redι_apply_mem _ _

end SubgroupScheme

section Counting

theorem natCard_torsion_le {G M : Type*} [CommGroup G] [Group M] (κ : M →* G)
    (hκ : Function.Injective κ) (S₁ : Set G) (hS₁ : S₁.Finite) (n : ℕ)
    [Finite {b : M // b ^ n = 1}]
    (hcov : ∀ x : G, x ^ n = 1 → ∃ s ∈ S₁, ∃ b : M, x = s * κ b) :
    Nat.card {x : G // x ^ n = 1} ≤ Nat.card S₁ * Nat.card {b : M // b ^ n = 1} := by
  classical
  haveI : Finite S₁ := hS₁.to_subtype

  have hch : ∀ x : {x : G // x ^ n = 1}, ∃ s : S₁, ∃ b : M, (x : G) = s * κ b := by
    intro x
    obtain ⟨s, hs, b, hb⟩ := hcov x.1 x.2
    exact ⟨⟨s, hs⟩, b, hb⟩
  choose sc bc hsb using hch

  let base : S₁ → {x : G // x ^ n = 1} → {x : G // x ^ n = 1} := fun σ x =>
    if h : ∃ y : {x : G // x ^ n = 1}, sc y = σ then Classical.choose h else x
  have hbase : ∀ x : {x : G // x ^ n = 1}, sc (base (sc x) x) = sc x := by
    intro x
    have h : ∃ y : {x : G // x ^ n = 1}, sc y = sc x := ⟨x, rfl⟩
    simp only [base, dif_pos h]
    exact Classical.choose_spec h
  have hbase' : ∀ x x' : {x : G // x ^ n = 1}, sc x = sc x' → base (sc x) x = base (sc x') x' := by
    intro x x' hxx
    have h : ∃ y : {x : G // x ^ n = 1}, sc y = sc x := ⟨x, rfl⟩
    have h' : ∃ y : {x : G // x ^ n = 1}, sc y = sc x' := ⟨x', rfl⟩
    simp only [base, dif_pos h, dif_pos h']
    congr 1
    rw [hxx]

  have htors : ∀ x : {x : G // x ^ n = 1}, (bc x * (bc (base (sc x) x))⁻¹) ^ n = 1 := by
    intro x
    set x₀ := base (sc x) x with hx₀
    apply hκ
    rw [map_pow, map_mul, map_inv, map_one]
    have e1 : κ (bc x) = ((sc x : S₁) : G)⁻¹ * (x : G) := by
      rw [hsb x, inv_mul_cancel_left]
    have e2 : κ (bc x₀) = ((sc x₀ : S₁) : G)⁻¹ * (x₀ : G) := by
      conv_rhs => rw [hsb x₀]
      rw [inv_mul_cancel_left]
    rw [e1, e2, hbase x, mul_inv_rev, inv_inv]
    calc (((sc x : S₁) : G)⁻¹ * (x : G) * ((x₀ : G)⁻¹ * ((sc x : S₁) : G))) ^ n
        = ((x : G) * (x₀ : G)⁻¹) ^ n := by
          congr 1
          simp only [mul_comm, mul_left_comm, mul_assoc, mul_inv_cancel_left]
      _ = 1 := by rw [mul_pow, inv_pow, x.2, x₀.2, inv_one, mul_one]
  let ρ : {x : G // x ^ n = 1} → S₁ × {b : M // b ^ n = 1} := fun x =>
    (sc x, ⟨bc x * (bc (base (sc x) x))⁻¹, htors x⟩)
  have hρ : Function.Injective ρ := by
    intro x x' hxx
    simp only [ρ, Prod.mk.injEq, Subtype.mk.injEq] at hxx
    obtain ⟨h1, h2⟩ := hxx
    rw [hbase' x x' h1] at h2
    have h3 : bc x = bc x' := mul_right_cancel h2
    apply Subtype.ext
    rw [hsb x, hsb x', h1, h3]
  calc Nat.card {x : G // x ^ n = 1}
      ≤ Nat.card (S₁ × {b : M // b ^ n = 1}) := Nat.card_le_card_of_injective ρ hρ
    _ = Nat.card S₁ * Nat.card {b : M // b ^ n = 1} := Nat.card_prod _ _

theorem le_of_forall_pow_le {p c g d : ℕ} (hp : 2 ≤ p)
    (h : ∀ j : ℕ, (p ^ j) ^ (2 * g) ≤ c * (p ^ j) ^ (2 * d)) : g ≤ d := by
  by_contra hgd
  have hgd : d < g := not_le.mp hgd

  have hj : c < p ^ c := lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_left hp c)
  have hq : 1 ≤ p ^ c := Nat.one_le_pow _ _ (by omega)
  have key := h c
  have h1 : 2 * d + 1 ≤ 2 * g := by omega
  have h2 : (p ^ c) ^ (2 * d) * (p ^ c) ≤ (p ^ c) ^ (2 * g) := by
    rw [← pow_succ]
    exact Nat.pow_le_pow_right hq h1
  have h3 : c * (p ^ c) ^ (2 * d) < (p ^ c) ^ (2 * d) * (p ^ c) := by
    rw [mul_comm]
    exact Nat.mul_lt_mul_of_pos_left hj (pow_pos hq _)
  omega

end Counting

section Density

variable {K : Type u} [Field K] [IsAlgClosed K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}
  (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
  (p : ℕ) (hp : p.Prime) (hpK : (p : K) ≠ 0)

local notation "pt" => 𝟙 (Spec (CommRingCat.of K))

def torH : Set (SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f) :=
  {x | ∃ j : ℕ, L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) (p ^ j) x}

theorem mem_torH_iff (x : SchemeHomOver pt f) :
    x ∈ torH L p ↔ ∃ j : ℕ, (letI := L.pointGroup pt; x ^ (p ^ j) = 1) := by
  simp only [torH, Set.mem_setOf_eq, isTorsionPoint_iff_pow]

theorem one_mem_torH : L.one pt ∈ torH L p :=
  ⟨0, L.isTorsionPoint_unit pt _⟩

include hc in
theorem mul_mem_torH (x y : SchemeHomOver pt f) (hx : x ∈ torH L p) (hy : y ∈ torH L p) :
    L.mul pt x y ∈ torH L p := by
  letI := cg L hc pt
  rw [mem_torH_iff] at hx hy ⊢
  obtain ⟨j, hj⟩ := hx
  obtain ⟨i, hi⟩ := hy
  refine ⟨j + i, ?_⟩
  show (x * y) ^ (p ^ (j + i)) = 1
  have hj' : x ^ (p ^ j) = 1 := hj
  have hi' : y ^ (p ^ i) = 1 := hi
  rw [mul_pow, pow_add, pow_mul, hj', one_pow, mul_comm (p ^ j) (p ^ i), pow_mul, hi', one_pow,
    one_mul]

theorem inv_mem_torH (x : SchemeHomOver pt f) (hx : x ∈ torH L p) : L.inv pt x ∈ torH L p := by
  letI := L.pointGroup pt
  rw [mem_torH_iff] at hx ⊢
  obtain ⟨j, hj⟩ := hx
  refine ⟨j, ?_⟩
  show x⁻¹ ^ (p ^ j) = 1
  have hj' : x ^ (p ^ j) = 1 := hj
  rw [inv_pow, hj', inv_one]

include hA in
theorem preconnectedSpace_A : PreconnectedSpace A := by
  have h := hA.connectedFibres (IsLocalRing.closedPoint K)
  have h' : _root_.IsConnected (Set.univ : Set A) := by
    convert h using 1
    exact (Set.eq_univ_of_forall fun a => (Subsingleton.elim _ _ :
      f.base a = IsLocalRing.closedPoint K)).symm
  exact ⟨h'.isPreconnected⟩

include hA in
theorem nonempty_A : Nonempty A := by
  have h := hA.connectedFibres (IsLocalRing.closedPoint K)
  obtain ⟨a, -⟩ := h.nonempty
  exact ⟨a⟩

include L hA in

theorem isIrreducible_univ_A : IsIrreducible (Set.univ : Set A) := by
  haveI := hA.proper
  haveI := preconnectedSpace_A hA
  obtain ⟨G₀, i, L₀, hopen, hclosed, hirr, hrange, -, -, -⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_isOpenImmersion_irreducibleSpace_range_eq_connectedComponent_finiteIndex
      K L
  rw [PreconnectedSpace.connectedComponent_eq_univ, ← Set.image_univ] at hrange
  rw [← hrange]
  exact (IrreducibleSpace.isIrreducible_univ G₀).image _ i.continuous.continuousOn

include hc hA hp hpK in

theorem closure_torsion_eq_univ : (Zcl (torH L p) : Set A) = Set.univ := by
  classical
  haveI := hA.proper
  haveI := hA.smooth
  haveI := preconnectedSpace_A hA
  set H := torH L p with hH
  have one_mem : L.one pt ∈ H := one_mem_torH L p
  have mul_mem : ∀ x y, x ∈ H → y ∈ H → L.mul pt x y ∈ H := mul_mem_torH L hc p
  have inv_mem : ∀ x, x ∈ H → L.inv pt x ∈ H := inv_mem_torH L p

  let LZ := lawZ L hc H one_mem mul_mem inv_mem
  haveI : IsProper (gZ H) := inferInstance
  obtain ⟨B, fB, LB, d, ιB, hcB, hbB, hsmB, hciB, hhomB, S₀, hS₀, hcov⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_abelianSchemePropertyBundle_isClosedImmersion_finiteIndex_of_isProper
      K LZ
  haveI := hsmB
  haveI := hciB

  obtain ⟨g, hg⟩ := AlgebraicGeometry.Smooth.exists_smoothOfRelativeDimension_of_preconnectedSpace f
  haveI := hg

  let κ : SchemeHomOver fB f := NeronModelInfra.schemeHomOverComp ιB (ιZ' H)
  have hκ1 : κ.1 = ιB.1 ≫ ιZ H := rfl
  haveI : IsClosedImmersion κ.1 := by rw [hκ1]; infer_instance
  let κpt : SchemeHomOver pt fB → SchemeHomOver pt f := fun b => NeronModelInfra.schemeHomOverComp b κ
  have hκpt : ∀ b, κpt b = toN H (NeronModelInfra.schemeHomOverComp b ιB) := fun b =>
    (NeronModelInfra.schemeHomOverComp_assoc b ιB (ιZ' H)).symm
  have hκmul : ∀ b b' : SchemeHomOver pt fB, κpt (LB.mul pt b b') = L.mul pt (κpt b) (κpt b') := by
    intro b b'
    rw [hκpt, hκpt, hκpt, hhomB]
    exact toN_lawZ_mul L hc H one_mem mul_mem inv_mem pt _ _
  have hκinj : Function.Injective κpt := by
    intro b b' hbb
    have := congrArg Subtype.val hbb
    exact Subtype.ext ((cancel_mono κ.1).mp this)
  letI iG : CommGroup (SchemeHomOver pt f) := cg L hc pt
  letI iM : CommGroup (SchemeHomOver pt fB) := cg LB hcB pt
  let κh : SchemeHomOver pt fB →* SchemeHomOver pt f := MonoidHom.mk' κpt hκmul

  let S₁ : Set (SchemeHomOver pt f) := (fun s => toN H s) '' S₀
  have hS₁ : S₁.Finite := hS₀.image _
  have hcov' : ∀ x : SchemeHomOver pt f, x ∈ Zpts H → ∃ s ∈ S₁, ∃ b, x = s * κh b := by
    intro x hx
    obtain ⟨z, rfl⟩ := exists_toN_eq H hx
    obtain ⟨s, hs, a, rfl⟩ := hcov z
    refine ⟨toN H s, ⟨s, hs, rfl⟩, a, ?_⟩
    show toN H (LZ.mul pt s _) = L.mul pt (toN H s) (κpt a)
    rw [hκpt]
    exact toN_lawZ_mul L hc H one_mem mul_mem inv_mem pt _ _

  have hcount : ∀ j : ℕ, (p ^ j) ^ (2 * g) ≤ Nat.card S₁ * (p ^ j) ^ (2 * d) := by
    intro j
    have hn : ((p ^ j : ℕ) : K) ≠ 0 := by rw [Nat.cast_pow]; exact pow_ne_zero j hpK
    have hA' := GoodReductionJacobian.RelativeGroupLaw.natCard_isTorsionPoint_eq_pow_of_natCast_ne_zero
      K f L hc hA g (p ^ j) hn
    have hB' := GoodReductionJacobian.RelativeGroupLaw.natCard_isTorsionPoint_eq_pow_of_natCast_ne_zero
      K fB LB hcB hbB d (p ^ j) hn
    have eA : Nat.card {x : SchemeHomOver pt f // L.IsTorsionPoint pt (p ^ j) x} =
        Nat.card {x : SchemeHomOver pt f // x ^ (p ^ j) = 1} :=
      Nat.card_congr (Equiv.subtypeEquivRight (fun x => isTorsionPoint_iff_pow L pt (p ^ j) x))
    have eB : Nat.card {x : SchemeHomOver pt fB // LB.IsTorsionPoint pt (p ^ j) x} =
        Nat.card {x : SchemeHomOver pt fB // x ^ (p ^ j) = 1} :=
      Nat.card_congr (Equiv.subtypeEquivRight (fun x => isTorsionPoint_iff_pow LB pt (p ^ j) x))
    haveI : Finite {x : SchemeHomOver pt fB // x ^ (p ^ j) = 1} := by
      apply Nat.finite_of_card_ne_zero
      rw [← eB, hB']
      exact pow_ne_zero _ (pow_ne_zero _ hp.ne_zero)
    have hle := natCard_torsion_le κh hκinj S₁ hS₁ (p ^ j) (fun x hx => hcov' x
      (subset_Zpts H ⟨j, (isTorsionPoint_iff_pow L pt (p ^ j) x).mpr hx⟩))
    rw [← eA, ← eB, hA', hB'] at hle
    exact hle
  have hgd : g ≤ d := le_of_forall_pow_le hp.two_le hcount

  have hZuniv : Set.range κ.1 = Set.univ := by
    by_contra hne
    haveI : Nonempty B := nonempty_A hbB
    have hclosed : IsClosed (Set.range κ.1) := κ.1.isClosedEmbedding.isClosed_range
    have h1 := IsIrreducible.topologicalKrullDim_add_one_le_of_isClosed_of_ne (isIrreducible_univ_A L hA)
      hclosed (Set.subset_univ _) hne
    have h2 : topologicalKrullDim (Set.univ : Set A) = topologicalKrullDim A :=
      IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ A).isHomeomorph
    have h3 : topologicalKrullDim B = topologicalKrullDim (Set.range κ.1) :=
      IsHomeomorph.topologicalKrullDim_eq _ κ.1.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph
    have h4 : (d : WithBot ℕ∞) ≤ topologicalKrullDim B :=
      AlgebraicGeometry.SmoothOfRelativeDimension.le_topologicalKrullDim fB d
    have h5 : topologicalKrullDim A ≤ g :=
      AlgebraicGeometry.SmoothOfRelativeDimension.topologicalKrullDim_le f g
    rw [h2, ← h3] at h1
    have h45 : (d : WithBot ℕ∞) + 1 ≤ topologicalKrullDim B + 1 := by gcongr
    have h6 : (d : WithBot ℕ∞) + 1 ≤ (g : WithBot ℕ∞) := le_trans (le_trans h45 h1) h5
    have h7 : (g : WithBot ℕ∞) ≤ (d : WithBot ℕ∞) := by exact_mod_cast hgd
    have h8 : (d : WithBot ℕ∞) + 1 ≤ (d : WithBot ℕ∞) := h6.trans h7
    have h9 : ((d + 1 : ℕ) : WithBot ℕ∞) ≤ ((d : ℕ) : WithBot ℕ∞) := by push_cast; exact h8
    have h10 : d + 1 ≤ d := by exact_mod_cast h9
    omega

  apply Set.eq_univ_of_univ_subset
  rw [← hZuniv, hκ1]
  rintro _ ⟨b, rfl⟩
  rw [Scheme.Hom.comp_apply]
  exact redι_apply_mem _ _

include hc hA hp hpK in

theorem dense_torsion : Dense (clS (torH L p) : Set A) := by
  rw [dense_iff_closure_eq]
  exact closure_torsion_eq_univ L hc hA p hp hpK

end Density

end P2mKcDenseTorsion
