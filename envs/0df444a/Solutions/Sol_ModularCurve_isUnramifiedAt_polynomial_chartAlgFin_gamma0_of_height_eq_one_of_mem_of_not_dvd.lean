    have hϖ0 : algebraMap A ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K₀) j₀) ϖ ≠ 0 := by
      intro h0
      have h1 : algebraMap A ↥K₀ ϖ = 0 := by
