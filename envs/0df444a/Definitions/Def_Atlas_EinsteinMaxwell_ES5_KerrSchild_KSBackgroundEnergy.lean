/-! ## Nonpositive and Einstein-form backgrounds -/

/-- Same-chart nonzero smooth background-null pregeodesic KS representation of the actual tail
`U_T` whose background Ricci contraction **along its own `K`** is `≤ 0` throughout `U_T`. -/
def NonposBackgroundKSTail (I : Set ℝ) (f m N w : ℝ → ℝ) (T : ℝ) : Prop :=
  ∃ gb gbi : Metric 5, ∃ v : Pt 5 → ℝ, ∃ K : Pt 5 → Fin 5 → ℝ,
    KSData gb gbi v K (esDomain I ∩ {x : Pt 5 | T < x 1}) ∧
    (∀ i j, Set.EqOn (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w i j) (ksMetric gb v K i j)
      (esDomain I ∩ {x : Pt 5 | T < x 1})) ∧
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, K x ≠ 0) ∧
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, PregeodesicAt gb gbi K x) ∧
    ∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, contract2 (ricciOf gb gbi) x (K x) ≤ 0

/-- Same representation data with a background whose actual Ricci tensor has pointwise
Einstein form `ricciOf gb gbi i j x = Λ x * gb i j x` on `U_T` (`Λ` an arbitrary function; no
constancy, sign or Bianchi argument is used). The candidate itself keeps `Λ = 0`. -/
def EinsteinBackgroundKSTail (I : Set ℝ) (f m N w : ℝ → ℝ) (T : ℝ) : Prop :=
  ∃ gb gbi : Metric 5, ∃ v : Pt 5 → ℝ, ∃ K : Pt 5 → Fin 5 → ℝ, ∃ Λ : Pt 5 → ℝ,
    KSData gb gbi v K (esDomain I ∩ {x : Pt 5 | T < x 1}) ∧
    (∀ i j, Set.EqOn (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w i j) (ksMetric gb v K i j)
      (esDomain I ∩ {x : Pt 5 | T < x 1})) ∧
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, K x ≠ 0) ∧
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, PregeodesicAt gb gbi K x) ∧
    ∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, ∀ i j, ricciOf gb gbi i j x = Λ x * gb i j x

