open QFS

variable {d : ℕ}

/-- The Euclidean norm is dominated by `√d` times the maximum norm:
`|v| ≤ √d |v|_∞`. This is the right half of equation (9). -/
lemma solution (x : EuclideanSpace ℝ (Fin d)) :
    ‖x‖ ≤ Real.sqrt d * QFS.infNorm x := by
  rw [EuclideanSpace.norm_eq]
  have hsum : ∑ i, ‖x i‖ ^ 2 ≤ (d : ℝ) * QFS.infNorm x ^ 2 := by
    calc ∑ i, ‖x i‖ ^ 2 ≤ ∑ _i : Fin d, QFS.infNorm x ^ 2 := by
          refine Finset.sum_le_sum (fun i _ => ?_)
          have h1 : ‖x i‖ ≤ QFS.infNorm x := by simpa [Real.norm_eq_abs] using QFS.le_infNorm x i
          exact pow_le_pow_left₀ (norm_nonneg _) h1 2
      _ = (d : ℝ) * QFS.infNorm x ^ 2 := by simp [Finset.sum_const, nsmul_eq_mul]
  calc Real.sqrt (∑ i, ‖x i‖ ^ 2) ≤ Real.sqrt ((d : ℝ) * QFS.infNorm x ^ 2) :=
        Real.sqrt_le_sqrt hsum
    _ = Real.sqrt d * QFS.infNorm x := by
        rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (QFS.infNorm_nonneg x)]
