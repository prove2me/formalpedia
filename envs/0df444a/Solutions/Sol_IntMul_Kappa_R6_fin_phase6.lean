* `shK f = ((range d).reverse ++ [d]).map f` (k-order, `x_0` innermost: flat index `2k + c`),
* `shR f = (range d ++ [d]).map f` (reversed order, `x_0` outermost).

`phiC`: pad `S_k → T_k` (one scan per axis), reverse the axes (`revC`: Lemma 12 swaps of the
`2^h`-atoms + single-bit moves), delete the padding `T_r → S_r`, run the `d` prefix-controlled
shifts `i = d-1, …, 0` (`rotStep`: offset table `Σ_{j<i} (μ_i P_j mod s_i) x_j mod s_i`), pad
`S_r → T_r`.  `phi_spec`: the result is `PhiD xs`.

`phiInvC`: the inverse (delete padding, inverse shifts `i = 0, …, d-1`, pad, reverse back,
delete padding).  `phiInv_spec`: the result is `PhiInvD ys`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Generic shape lemmas -/

theorem valid_revH {P Q : Shape} {a : List ℕ} (h : Valid (P ++ Q) a) :
    Valid (P.reverse ++ Q) (revH P.length a) := by
  have hl : (a.take P.length).length = P.length := by
    have := h.length_eq; simp at this ⊢; omega
  rw [← List.take_append_drop P.length a] at h
  obtain ⟨h1, h2⟩ := (KIL.valid_append_iff hl).1 h
  exact valid_append (List.forall₂_reverse_iff.2 h1) h2

theorem forall₂_map_le {L : List ℕ} {f g : ℕ → ℕ} (h : ∀ j ∈ L, f j ≤ g j) :
    List.Forall₂ (· ≤ ·) (L.map f) (L.map g) := by
  induction L with
  | nil => exact .nil
  | cons a L ih =>
    exact .cons (h a (by simp)) (ih (fun j hj => h j (by simp [hj])))

theorem vol_rangeMap (f : ℕ → ℕ) : ∀ i, vol ((List.range i).map f) = ∏ j ∈ Finset.range i, f j
  | 0 => by simp [vol]
  | i + 1 => by
    rw [List.range_succ, List.map_append, vol_append, vol_rangeMap f i, Finset.prod_range_succ]
    simp [vol]

/-! ## Parameters and shapes -/

theorem tP_eq (d h : ℕ) (bL : ℕ → Bool) (j : ℕ) :
    tP d h bL j = if j < d then (if bL j then 2 ^ h * 2 else 2 ^ h) else 2 := by
  unfold tP tz mzP bgP; by_cases hj : j < d <;> simp [hj]

theorem shR_split (d : ℕ) (sF : ℕ → ℕ) {i : ℕ} (hi : i < d) :
    shR d (sP d sF) = (List.range i).map sF ++ sF i ::
      (((List.range d).drop (i + 1) ++ [d]).map (sP d sF)) := by
  have e : List.range d = List.range i ++ i :: (List.range d).drop (i + 1) := by
    conv_lhs => rw [← List.take_append_drop i (List.range d)]
    rw [List.take_range, min_eq_left hi.le, List.drop_eq_getElem_cons (by simpa using hi),
      List.getElem_range]
  unfold shR
  conv_lhs => rw [e]
  simp only [List.append_assoc, List.cons_append, List.map_append, List.map_cons]
  congr 1
  · apply List.map_congr_left; intro j hj; simp at hj; simp [sP, show j < d by omega]
  · simp [sP, hi]

/-! ## The shifts -/

theorem valid_rotG {A C : Shape} {Q : ℕ} (hQ : 1 ≤ Q) (f : List ℕ → ℕ) {b : List ℕ}
    (hb : Valid (A ++ Q :: C) b) : Valid (A ++ Q :: C) (rotG A.length Q f b) := by
  have hl : (b.take A.length).length = A.length := by
    have := hb.length_eq; simp at this ⊢; omega
  rw [← List.take_append_drop A.length b] at hb
  obtain ⟨h1, h2⟩ := (KIL.valid_append_iff hl).1 hb
  obtain ⟨y, rest, hd⟩ : ∃ y rest, b.drop A.length = y :: rest := by
    cases e : b.drop A.length with
    | nil => rw [e] at h2; cases h2
    | cons y rest => exact ⟨y, rest, rfl⟩
  rw [hd] at h2
  have hr : b.drop (A.length + 1) = rest := by
    rw [← List.drop_drop, hd]; rfl
  unfold rotG
  rw [hr]
  exact valid_append h1 (.cons (Nat.mod_lt _ (by omega)) (by cases h2; assumption))

theorem valid_gRot (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ) {i : ℕ}
    (hi : i < d) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b) :
    Valid (shR d (sP d sF)) (gRot sF cs i b) := by
  rw [shR_split d sF hi] at hb ⊢
  have := valid_rotG (A := (List.range i).map sF) (hs i hi) (fun a => KIL.lf (cs i) a % sF i) hb
  simpa [gRot] using this

theorem valid_Gb (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ) :
    ∀ k ≤ d, ∀ b, Valid (shR d (sP d sF)) b → Valid (shR d (sP d sF)) (Gb sF cs k b)
  | 0, _, b, hb => hb
  | k + 1, hk, b, hb => valid_Gb d sF hs cs k (by omega) _ (valid_gRot d sF hs cs (by omega) hb)

