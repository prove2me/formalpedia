-- Source module: Solutions.J6SegKr3
/-!
# B3 (chunk kernel), part 3: the diagonal stage

`dgI pM X T U Y CN CC N`: with `n` on `N`, the row `gflat z ++ lx` on `X` (`|z| = n`) and the
table `c ++ lt` on `T` (`n ≤ |c|`), it pushes `gflat (dgG P c z).reverse` onto `Y`, consumes the
row and leaves the table in place (the used entries go through `U` and back). Each item costs two
calls of the multiplication procedure (`KFM.mulC`) and two roundings `rs P` (`rsE`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem cl_encK {s : IState HS} {G : Fin HS → List ℤ} {i : Fin HS} {v : ℤ} {l : List ℤ}
    (h : G i = v :: l) : (encK s G).cl i = cls (some (.int v)) := by
  simp [IState.cl, h]

theorem isPos_cls (v : ℤ) : isPos (cls (some (.int v))) = decide (0 < v) := by
  unfold isPos cls
  by_cases h0 : v = 0
  · simp [h0]
  · by_cases h1 : v < 0
    · simp [h0, h1]; omega
    · simp [h0, h1]; omega

end J6Seg.KR

end

