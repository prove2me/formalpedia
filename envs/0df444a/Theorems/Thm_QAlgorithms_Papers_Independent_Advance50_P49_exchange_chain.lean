local notation "WireSupported" => QAlgorithms.Papers.Independent.Information100.P69.Supported

/-- PDF p.31, I1–I5: adjacent and all-pairs exchanges generate the same algebra
and finite-exponential group, both with and without the scalar generator. -/
theorem exchange_chain (N : ℕ) (hN : 2 ≤ N) :
    exchangeLie N false false = exchangeLie N true false ∧
    exchangeLie N false true = exchangeLie N true true ∧
    exchangeGroup N false false = exchangeGroup N true false ∧
    exchangeGroup N false true = exchangeGroup N true true := by sorry

end QAlgorithms.Papers.Independent.Advance50.P49

