/-- Without the guard, the final scans cost `m n² (24 s + 35)`; with it, nothing. -/
theorem cFin_tScan (n U : ℕ) :
    cFin n U * tScan (sOf n) = if Guard n U then 0 else Light.Filter.LL n * (24 * sOf n + 35) := by
