    unfold sieveTime
    have := Nat.mul_le_mul hm (Nat.add_le_add_right hlogm 5)
    have e : 15 * (2 * Light.Filter2.RR n - 1) * (Nat.log 2 (2 * Light.Filter2.RR n - 1) + 5) =
        15 * ((2 * Light.Filter2.RR n - 1) * (Nat.log 2 (2 * Light.Filter2.RR n - 1) + 5)) := by ring
    have e' : 15 * (2 * Light.Filter2.RR n) * (2 * Light.Filter2.RR n + 5) = 15 * (2 * Light.Filter2.RR n * (2 * Light.Filter2.RR n + 5)) := by ring
    omega
  have e1 : 15 * (2 * Light.Filter2.RR n) * (2 * Light.Filter2.RR n + 5) = 60 * (Light.Filter2.RR n * Light.Filter2.RR n) + 150 * Light.Filter2.RR n := by ring
