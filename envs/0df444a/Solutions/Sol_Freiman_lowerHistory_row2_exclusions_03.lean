namespace H5Generic
private abbrev MetaRow := ℕ × ℕ × ℕ
private def project (w : CertWitness) : CertBound × CertBound × CertRectangle :=
  (w.lowerBound,w.upperBound,w.rectangle)
private def decode (B : ℕ → CertBound) (R : ℕ → CertRectangle) (a : MetaRow) :
    CertBound × CertBound × CertRectangle := (B a.1,B a.2.1,R a.2.2)

private theorem lookup (B : ℕ → CertBound) (R : ℕ → CertRectangle)
    (ws : List CertWitness) (fallback : CertWitness) (table : List MetaRow)
    (hm : ws.map project = table.map (decode B R))
    (wid : ℕ) (hp : 0 < wid) (hl : wid ≤ table.length) :
    project ((ws[wid-1]?).getD fallback) =
      decode B R ((table[wid-1]?).getD (0,0,0)) := by
  have hi : wid-1 < table.length := by omega
  have hc : table[wid-1]? = some table[wid-1] := List.getElem?_eq_getElem hi
  have hh := congrArg (fun (xs : List (CertBound × CertBound × CertRectangle)) => xs[wid-1]?) hm
  rw [List.getElem?_map, List.getElem?_map, hc] at hh
  cases he : ws[wid-1]? with
  | none =>
    simp only [he, Option.map_none, Option.map_some] at hh
    cases hh
  | some w =>
    rw [hc]
    change project w = decode B R table[wid-1]
    exact Option.some.inj (by simpa only [he, Option.map_some] using hh)

private def fits (table : List MetaRow) (ri : ℕ) (bs : List ℕ) (wid : ℕ) : Prop :=
  0 < wid ∧ wid ≤ table.length ∧
  let a := (table[wid-1]?).getD (0,0,0)
  a.1 ∈ bs ∧ a.2.1 ∈ bs ∧ a.2.2 = ri
private instance (table : List MetaRow) (ri : ℕ) (bs : List ℕ) (wid : ℕ) :
    Decidable (fits table ri bs wid) := by unfold fits; infer_instance

private theorem excludes (B : ℕ → CertBound) (R : ℕ → CertRectangle)
    (ws : List CertWitness) (fallback : CertWitness) (table : List MetaRow)
    (hm : ws.map project = table.map (decode B R))
    (hw : ∀ i : ℕ, 0 < i → i ≤ ws.length →
      certWitnessValid ((ws[i-1]?).getD fallback))
    (hex : ∀ (w : CertWitness), certWitnessValid w → ∀ r s q : ℝ,
      certRectangleMem w.rectangle r s →
      ¬ (certBoundHolds w.lowerBound r s q ∧ certBoundHolds w.upperBound r s q))
    (ri : ℕ) (bs : List ℕ) (wid : ℕ) (hf : fits table ri bs wid)
    (r s q : ℝ) (hr : certRectangleMem (R ri) r s)
    (hs : ∀ i ∈ bs, certBoundHolds (B i) r s q) : False := by
  obtain ⟨hp, hl, hb, hu, hR⟩ := hf
  have hlen : ws.length = table.length := by
    have hh := congrArg List.length hm
    simpa only [List.length_map] using hh
  have hproj := lookup B R ws fallback table hm wid hp hl
  have hlow : ((ws[wid-1]?).getD fallback).lowerBound =
      B ((table[wid-1]?).getD (0,0,0)).1 := congrArg Prod.fst hproj
  have hupp : ((ws[wid-1]?).getD fallback).upperBound =
      B ((table[wid-1]?).getD (0,0,0)).2.1 := congrArg (fun z => z.2.1) hproj
  have hrect : ((ws[wid-1]?).getD fallback).rectangle =
      R ((table[wid-1]?).getD (0,0,0)).2.2 := congrArg (fun z => z.2.2) hproj
  have hv := hw wid hp (by simpa only [hlen] using hl)
  apply hex ((ws[wid-1]?).getD fallback) hv r s q
  · rw [hrect, hR]
    exact hr
  · constructor
    · rw [hlow]
      exact hs _ hb
    · rw [hupp]
      exact hs _ hu
private theorem excludes_mapped (B : ℕ → CertBound) (R : ℕ → CertRectangle)
    (ws : List CertWitness) (fallback : CertWitness) (table : List MetaRow)
    (hm : ws.map project = table.map (decode B R))
    (hw : ∀ i : ℕ, 0 < i → i ≤ ws.length → certWitnessValid ((ws[i-1]?).getD fallback))
    (hex : ∀ (w : CertWitness), certWitnessValid w → ∀ r s q : ℝ,
      certRectangleMem w.rectangle r s →
      ¬ (certBoundHolds w.lowerBound r s q ∧ certBoundHolds w.upperBound r s q))
    (ri : ℕ) (bs : List ℕ) (wid : ℕ) (hf : fits table ri bs wid)
    (r s q : ℝ) (hr : certRectangleMem (R ri) r s)
    (hs : lowerHistoryConditions (bs.map B) r s q) : False := by
  exact excludes B R ws fallback table hm hw hex ri bs wid hf r s q hr
    (fun i hi => hs (B i) (List.mem_map.mpr ⟨i,hi,rfl⟩))
private theorem excludes_pairs (B : ℕ → CertBound) (R : ℕ → CertRectangle)
    (ws : List CertWitness) (fallback : CertWitness) (table : List MetaRow)
    (hm : ws.map project = table.map (decode B R))
    (hw : ∀ i : ℕ, 0 < i → i ≤ ws.length → certWitnessValid ((ws[i-1]?).getD fallback))
    (hex : ∀ (w : CertWitness), certWitnessValid w → ∀ r s q : ℝ,
      certRectangleMem w.rectangle r s →
      ¬ (certBoundHolds w.lowerBound r s q ∧ certBoundHolds w.upperBound r s q))
    (entries : List (MetaRow × ℕ))
    (hf : ∀ e ∈ entries, fits table e.1.1 [e.1.2.1,e.1.2.2] e.2) :
    ∀ a ∈ entries.map Prod.fst, ∀ r s q : ℝ, certRectangleMem (R a.1) r s →
      ¬ (certBoundHolds (B a.2.1) r s q ∧ certBoundHolds (B a.2.2) r s q) := by
  intro a ha r s q hr hbounds
  obtain ⟨e,he,rfl⟩ := List.mem_map.mp ha
  apply excludes B R ws fallback table hm hw hex e.1.1 [e.1.2.1,e.1.2.2]
    e.2 (hf e he) r s q hr
  intro i hi
  simp only [List.mem_cons,List.mem_nil_iff,or_false] at hi
  rcases hi with rfl | rfl
  · exact hbounds.1
  · exact hbounds.2
