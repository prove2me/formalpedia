theorem binShape_split (sh : Shape) {p q : ℕ} (hpq : p < q) (hq : q < sh.length) {F : ℕ}
    (hpF : sh.getD p 0 = F) (hqF : sh.getD q 0 = F) :
    binShape (preS sh p) (midS sh p q) (sufS sh q) F = sh := by
  have hp : p < sh.length := by omega
  rw [List.getD_eq_getElem _ _ hp] at hpF
  rw [List.getD_eq_getElem _ _ hq] at hqF
  unfold binShape preS midS sufS
  have e1 : sh.drop q = F :: sh.drop (q + 1) := by rw [List.drop_eq_getElem_cons hq, hqF]
  have e2 : (sh.drop (p + 1)).drop (q - p - 1) = sh.drop q := by
    rw [List.drop_drop]; congr 1; omega
  have e3 : sh.drop p = F :: sh.drop (p + 1) := by rw [List.drop_eq_getElem_cons hp, hpF]
  conv_rhs => rw [← List.take_append_drop p sh, e3,
    ← List.take_append_drop (q - p - 1) (sh.drop (p + 1)), e2, e1]

theorem len_preS (sh : Shape) {p : ℕ} (hp : p < sh.length) : (preS sh p).length = p := by
  simp [preS]; omega

theorem len_midS (sh : Shape) {p q : ℕ} (hpq : p < q) (hq : q < sh.length) :
    (preS sh p).length + 1 + (midS sh p q).length = q := by
  simp [preS, midS]; omega

theorem pos_sub {sh : Shape} (h : ∀ a ∈ sh, 1 ≤ a) (p q : ℕ) :
    (∀ a ∈ preS sh p, 1 ≤ a) ∧ (∀ a ∈ midS sh p q, 1 ≤ a) ∧ (∀ a ∈ sufS sh q, 1 ≤ a) :=
  ⟨fun a ha => h a (List.mem_of_mem_take ha),
    fun a ha => h a (List.mem_of_mem_drop (List.mem_of_mem_take ha)),
    fun a ha => h a (List.mem_of_mem_drop ha)⟩

