def get5 {α : Type} (t : α × α × α × α × α) (i : Nat) : α :=
  cond (Nat.beq i 0) t.1 (cond (Nat.beq i 1) t.2.1 (cond (Nat.beq i 2) t.2.2.1
    (cond (Nat.beq i 3) t.2.2.2.1 t.2.2.2.2)))
def set5 {α : Type} (t : α × α × α × α × α) (i : Nat) (v : α) : α × α × α × α × α :=
  (cond (Nat.beq i 0) v t.1, cond (Nat.beq i 1) v t.2.1, cond (Nat.beq i 2) v t.2.2.1,
   cond (Nat.beq i 3) v t.2.2.2.1, cond (Nat.beq i 4) v t.2.2.2.2)

