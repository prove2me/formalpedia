    centerALowerYBox.Contains (Y (lower E8TAxisProd0159PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0159PaddedInputs.centerAInput.alpha = ((4115470352964345628383522602588716836376840310 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
