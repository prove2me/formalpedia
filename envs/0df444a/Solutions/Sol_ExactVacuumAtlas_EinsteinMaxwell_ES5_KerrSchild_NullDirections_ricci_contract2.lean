-- ==== solution ====
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.SmoothExt
open ExactVacuumAtlas.EinsteinMaxwell.D (einsteinMaxwellD ricciOf_of_einstein_zero EMCertificateD)
open scoped Matrix
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections
variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ}
theorem solution (hE : ESData R B D A H W Φ Ψ) {x : Pt 5} (hx : x ∈ esDomain R)
    (hEin : ∀ i j, einsteinMaxwellD (esMetric B D A H W) (esInverse B D A H W)
      (esFaraday Φ Ψ) i j x = 0) (k : Fin 5 → ℝ) :
    contract2 (ricciOf (esMetric B D A H W) (esInverse B D A H W)) x k =
      2 * frameQ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2)
        (frameZ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2)
          (deriv Φ (x 1) + W (x 1) * deriv Ψ (x 1)) (deriv Ψ (x 1)) (Ψ (x 1)) (frameInv W x k)) -
      contract2 (esMetric B D A H W) x k * fieldSq (esInverse B D A H W) (esFaraday Φ Ψ) x / 3 := by
  obtain ⟨hB, hD, hA, hH, hu, hv⟩ := hE.nz hx
  have hinv := esInverse_mul B D A H W x hB hD hA hH hu hv
  have hR := fun a b => ricciOf_of_einstein_zero hinv (esMetric_symm B D A H W x) hEin
    (by norm_num) a b
  rw [← faradayQuad_frame hE hx k]
  have e : ∀ a b, ricciOf (esMetric B D A H W) (esInverse B D A H W) a b x * k a * k b =
      2 * ((∑ c, ∑ d, esFaraday Φ Ψ a c x * esInverse B D A H W c d x *
        esFaraday Φ Ψ b d x) * k a * k b) -
        fieldSq (esInverse B D A H W) (esFaraday Φ Ψ) x / 3 * (esMetric B D A H W a b x * k a * k b) := by
    intro a b
    rw [hR a b]
    norm_num
    ring
  simp only [contract2, e, Finset.sum_sub_distrib, ← Finset.mul_sum]
  ring
