  have saI : sa.G ax.sl.I = t.G ax.sl.I := by simp [hsa, hI.1, hI.2.2.2.2.2.2.1]
  -- step 3
  have sbI : sb.G ax.sl.I = gints x ++ t.G ax.sl.I := by simp [hsb, saI]
  have sbC : Ctx sb := hr.stab s0 sb hC (by
    intro j hj
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
    have h1 : j ≠ gD := fun h => hj.1 (by subst h; decide)
    have h2 : j ≠ gZT := fun h => hj.1 (by subst h; decide)
    simp [hsb, hsa, h1, h2, hj.2.1, hfr j hj.1])
