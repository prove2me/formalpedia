local notation "Qbar" => AlgebraicClosure ℚ
local notation "Gal" => (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)

theorem nsmul_eq_nsmul_of_modEq {J : Type*} [AddCommGroup J] {x : J} {k a b : ℕ}
    (hx : 2 ^ k • x = 0) (hab : a ≡ b [MOD 2 ^ k]) : a • x = b • x := by
  have key : ∀ c : ℕ, c • x = (c % 2 ^ k) • x := by
    intro c
    conv_lhs => rw [← Nat.mod_add_div c (2 ^ k)]
    rw [add_nsmul, mul_comm, mul_nsmul', hx, nsmul_zero, add_zero]
  rw [key a, key b, hab]

theorem exists_cyclotomicExponent (m : ℕ) :
    ∃ n' : Gal → ℕ,
      (∀ σ : Gal, ∀ ζ : Qbar, ζ ^ (2 ^ m) = 1 → σ ζ = ζ ^ n' σ) ∧
      ∀ k : ℕ, k ≤ m → ∀ n : Gal → ℕ,
        (∀ σ : Gal, ∀ ζ : Qbar, ζ ^ (2 ^ k) = 1 → σ ζ = ζ ^ n σ) →
        ∀ σ : Gal, n σ ≡ n' σ [MOD 2 ^ k] := by
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot Qbar (2 ^ m)
  have hpos : 0 < 2 ^ m := Nat.pos_of_ne_zero (NeZero.ne _)
  have hex : ∀ σ : Gal, ∃ a : ℕ, σ ζ = ζ ^ a := by
    intro σ
    have h1 : (σ ζ) ^ (2 ^ m) = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
    obtain ⟨a, -, ha⟩ := hζ.eq_pow_of_pow_eq_one h1
    exact ⟨a, ha.symm⟩
  choose n' hn' using hex
  refine ⟨n', ?_, ?_⟩
  · intro σ ξ hξ
    obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hξ
    rw [map_pow, hn', ← pow_mul, ← pow_mul, mul_comm]
  · intro k hk n hn σ
    set η : Qbar := ζ ^ (2 ^ (m - k)) with hη
    have hηprim : IsPrimitiveRoot η (2 ^ k) :=
      hζ.pow hpos (by rw [← pow_add, Nat.sub_add_cancel hk])
    have hη1 : η ^ (2 ^ k) = 1 := hηprim.pow_eq_one
    have h1 : σ η = η ^ n σ := hn σ η hη1
    have h2 : σ η = η ^ n' σ := by
      rw [hη, map_pow, hn', ← pow_mul, ← pow_mul, mul_comm]
