      = (uA j R - 2 * zA j R) * b1f j R / R - P R * deriv (zA j) R * deriv (b1f j) R
        + 3 * uA j R * (j + 3 * b1f j R) / R ^ 3 := by
    rw [← S3_eq j hR, S3_anchor j hR]
  have hD1 := D1f_eq j R
  have hD3 := D3f_eq j hR
  have hC := C_eq hR
  have hf0 := f0_eq_PR R
  have hLb := Lmag_b1f j hR
  unfold MA3
  rw [hD3, hD1, hLb, hC, hf0, hqS]
  unfold Vfun c3f m0 P N0
  field_simp
  ring
