-- title:
--   Eq. (52) (as derived): the interface operators of the two-layer generalized Debye representation
-- statement:
--   Let $\omega>0$, $\varepsilon_0,\mu_0,\varepsilon_1,\mu_1>0$, $k_j=\omega\sqrt{\varepsilon_j\mu_j}$, $(\xi,\eta)\ne(0,0)$, $\beta_j=\sqrt{\xi^2+\eta^2-k_j^2}\ne0$, and write $\widehat g_k=\widehat g_k(\xi,\eta,0)$, $e=e^{i(\xi x+\eta y)}$. Let $(\mathbf E_j,\mathbf H_j)$ be the two-layer generalized Debye fields (45) generated by the sources $\widehat r_je$, $\widehat q_je$ with currents (48), evaluated on $z=0$ from layer $j$. Then
--
--   1. $\mathcal S_0\nabla\cdot\mathbf E_0=\sqrt{\mu_0}\,\widehat g_0\widehat g_{k_0}\big((\xi^2+\eta^2-k_0^2)\widehat r_0+i\omega\mu_1\sqrt{\varepsilon_1/\mu_0}\,\beta_0\widehat q_1\big)e$,
--   2. $\mathcal S_0\nabla\cdot\mathbf E_1=\sqrt{\mu_1}\,\widehat g_0\widehat g_{k_1}\big((\xi^2+\eta^2-k_1^2)\widehat r_1+i\omega\mu_0\sqrt{\varepsilon_0/\mu_1}\,\beta_1\widehat q_0\big)e$,
--   3. $\mathcal S_0\nabla\cdot\mathbf H_0=\sqrt{\varepsilon_0}\,\widehat g_0\widehat g_{k_0}\big((\xi^2+\eta^2-k_0^2)\widehat q_0-i\omega\varepsilon_1\sqrt{\mu_1/\varepsilon_0}\,\beta_0\widehat r_1\big)e$,
--   4. $\mathcal S_0\nabla\cdot\mathbf H_1=\sqrt{\varepsilon_1}\,\widehat g_0\widehat g_{k_1}\big((\xi^2+\eta^2-k_1^2)\widehat q_1-i\omega\varepsilon_0\sqrt{\mu_0/\varepsilon_1}\,\beta_1\widehat r_0\big)e$,
--   5. $\mathbf n\cdot\varepsilon_0\mathbf E_0=\varepsilon_0\sqrt{\mu_0}\,\widehat g_{k_0}\big(\beta_0\widehat r_0+i\omega\mu_1\sqrt{\varepsilon_1/\mu_0}\,\widehat q_1\big)e$,
--   6. $\mathbf n\cdot\varepsilon_1\mathbf E_1=-\varepsilon_1\sqrt{\mu_1}\,\widehat g_{k_1}\big(\beta_1\widehat r_1+i\omega\mu_0\sqrt{\varepsilon_0/\mu_1}\,\widehat q_0\big)e$,
--   7. $\mathbf n\cdot\mu_0\mathbf H_0=\mu_0\sqrt{\varepsilon_0}\,\widehat g_{k_0}\big(\beta_0\widehat q_0-i\omega\varepsilon_1\sqrt{\mu_1/\varepsilon_0}\,\widehat r_1\big)e$,
--   8. $\mathbf n\cdot\mu_1\mathbf H_1=-\mu_1\sqrt{\varepsilon_1}\,\widehat g_{k_1}\big(\beta_1\widehat q_1-i\omega\varepsilon_0\sqrt{\mu_0/\varepsilon_1}\,\widehat r_0\big)e$.
--
--   **Formalization Note** These are the eight lines of eq. (52) as they follow from (45)-(48). Lines 2, 3 and 5-8 agree with the printed (52). In lines 1 and 4 the $\omega$-proportional cross terms have the opposite sign to the printed ones: the printed line 1 has $-i\omega\mu_1\sqrt{\varepsilon_1/\mu_0}\beta_0\widehat q_1$ and the printed line 4 has $+i\omega\varepsilon_0\sqrt{\mu_0/\varepsilon_1}\beta_1\widehat r_0$. One Fourier mode, with $\mathcal S_k$ as in eq. (40); material constants are positive reals.
-- source:
--   M. O'Neil, A generalized Debye source approach to electromagnetic scattering in layered media, arXiv:1310.4241v1 (2013), claim c018; Section V.B, eq. (52), PDF p. 12; eqs. (45)-(48), PDF pp. 11-12

import Mathlib
import Definitions.Def_Arxiv1310_4241_Basic

open MeasureTheory Filter Topology

namespace Arxiv1310_4241

theorem two_layer_boundary_operators (ω ε0 μ0 ε1 μ1 : ℝ) (hω : 0 < ω) (hε0 : 0 < ε0)
    (hμ0 : 0 < μ0) (hε1 : 0 < ε1) (hμ1 : 0 < μ1) (k0 k1 β0 β1 : ℂ)
    (hk0 : k0 = wavenumber ω ε0 μ0) (hk1 : k1 = wavenumber ω ε1 μ1) (ξ η : ℝ)
    (hξη : (ξ, η) ≠ (0, 0)) (hβ0def : β0 = sommerfeldRoot k0 ξ η)
    (hβ1def : β1 = sommerfeldRoot k1 ξ η) (hβ0 : β0 ≠ 0) (hβ1 : β1 ≠ 0)
    (r0 r1 q0 q1 : ℂ) (x y : ℝ) :
    laplaceSingleLayerOnMode ξ η
        (tangentialDivergence (twoLayerE0 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1)) (pt x y 0) =
      (Real.sqrt μ0 : ℂ) * ghat 0 ξ η 0 * ghat k0 ξ η 0 *
        (((ξ : ℂ) ^ 2 + (η : ℂ) ^ 2 - k0 ^ 2) * r0 +
          Complex.I * ω * μ1 * (Real.sqrt (ε1 / μ0) : ℂ) * β0 * q1) * planeWave ξ η x y ∧
    laplaceSingleLayerOnMode ξ η
        (tangentialDivergence (twoLayerE1 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1)) (pt x y 0) =
      (Real.sqrt μ1 : ℂ) * ghat 0 ξ η 0 * ghat k1 ξ η 0 *
        (((ξ : ℂ) ^ 2 + (η : ℂ) ^ 2 - k1 ^ 2) * r1 +
          Complex.I * ω * μ0 * (Real.sqrt (ε0 / μ1) : ℂ) * β1 * q0) * planeWave ξ η x y ∧
    laplaceSingleLayerOnMode ξ η
        (tangentialDivergence (twoLayerH0 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1)) (pt x y 0) =
      (Real.sqrt ε0 : ℂ) * ghat 0 ξ η 0 * ghat k0 ξ η 0 *
        (((ξ : ℂ) ^ 2 + (η : ℂ) ^ 2 - k0 ^ 2) * q0 -
          Complex.I * ω * ε1 * (Real.sqrt (μ1 / ε0) : ℂ) * β0 * r1) * planeWave ξ η x y ∧
    laplaceSingleLayerOnMode ξ η
        (tangentialDivergence (twoLayerH1 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1)) (pt x y 0) =
      (Real.sqrt ε1 : ℂ) * ghat 0 ξ η 0 * ghat k1 ξ η 0 *
        (((ξ : ℂ) ^ 2 + (η : ℂ) ^ 2 - k1 ^ 2) * q1 -
          Complex.I * ω * ε0 * (Real.sqrt (μ0 / ε1) : ℂ) * β1 * r0) * planeWave ξ η x y ∧
    (ε0 : ℂ) * twoLayerE0 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1 (pt x y 0) 2 =
      ε0 * (Real.sqrt μ0 : ℂ) * ghat k0 ξ η 0 *
        (β0 * r0 + Complex.I * ω * μ1 * (Real.sqrt (ε1 / μ0) : ℂ) * q1) * planeWave ξ η x y ∧
    (ε1 : ℂ) * twoLayerE1 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1 (pt x y 0) 2 =
      -(ε1 * (Real.sqrt μ1 : ℂ) * ghat k1 ξ η 0 *
        (β1 * r1 + Complex.I * ω * μ0 * (Real.sqrt (ε0 / μ1) : ℂ) * q0)) * planeWave ξ η x y ∧
    (μ0 : ℂ) * twoLayerH0 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1 (pt x y 0) 2 =
      μ0 * (Real.sqrt ε0 : ℂ) * ghat k0 ξ η 0 *
        (β0 * q0 - Complex.I * ω * ε1 * (Real.sqrt (μ1 / ε0) : ℂ) * r1) * planeWave ξ η x y ∧
    (μ1 : ℂ) * twoLayerH1 ω ε0 μ0 ε1 μ1 ξ η r0 r1 q0 q1 (pt x y 0) 2 =
      -(μ1 * (Real.sqrt ε1 : ℂ) * ghat k1 ξ η 0 *
        (β1 * q1 - Complex.I * ω * ε0 * (Real.sqrt (μ0 / ε1) : ℂ) * r0)) * planeWave ξ η x y := by sorry

end Arxiv1310_4241
