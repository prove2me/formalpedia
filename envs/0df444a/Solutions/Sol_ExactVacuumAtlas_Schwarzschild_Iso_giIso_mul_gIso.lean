theorem solution (hM : 0 ≤ M) {x : Pt 4} (hx : x ∈ domIso M) :
    metricMatrix (giIso M) x * metricMatrix (gIso M) x = 1 := by
  have hρ : 0 < x 1 := hx.1
  have hne : x 1 ≠ M / 2 := hx.2.1
  have h1 : 2 * x 1 - M ≠ 0 := fun h0 => hne (by linarith)
  have h2 : 2 * x 1 + M ≠ 0 := by positivity
  have hr : x 1 ≠ 0 := hρ.ne'
  have hs : sin (x 2) ≠ 0 := (domEF_sin_pos ⟨hx.1, hx.2.2⟩).ne'
  have hA : Af M (x 1) ≠ 0 := by rw [Af_eq M (x 1) hr h2]; exact div_ne_zero h1 h2
  have hB : Bf M (x 1) ≠ 0 := by rw [Bf_eq M (x 1) hr]; exact div_ne_zero h2 (by positivity)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, metricMatrix, gIso, giIso, Matrix.one_apply] <;>
