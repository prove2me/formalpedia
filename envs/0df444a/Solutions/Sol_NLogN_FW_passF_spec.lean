    (hk : k < D.length) : lvls G (D.take (k + 1)) A = lvl G D[k] (lvls G (D.take k) A) := by
  rw [take_succ_get D k hk, lvls_append]; rfl

theorem canon_lvl' (G : ℕ → ℕ → List ℤ → List ℤ) (n : ℕ) (d : Desc)
    (hg : GOK (G d.2.2.1 d.2.1) n d.2.1) (A : List ℤ) (hA : A.length = d.1 * (2 ^ d.2.1 * d.2.2.2))
    (hB : 0 < d.2.2.2) (hc : Canon (2 ^ n + 1) A) : Canon (2 ^ n + 1) (lvl G d A) := by
  have hc0 : 0 < 2 ^ d.2.1 * d.2.2.2 := by positivity
  apply canon_flatMap'
  intro X hX
  apply canon_colMap' _ n _ _ hg X (chunkL_mem_length _ d.1 hc0 A hA X hX)
  intro x hx
  exact hc x (flatten_chunkL _ hc0 A ▸ List.mem_flatten.2 ⟨X, hX, hx⟩)

theorem lvls_facts (M : MulSpec) (T : RM) (G : ℕ → ℕ → List ℤ → List ℤ) (cT : ℕ → ℕ)
    (n kb W N J : ℕ) (D : List Desc) (hD : PassOK M T G cT n kb W N J D) (A : List ℤ)
    (hAl : A.length = N) (hAc : Canon (2 ^ n + 1) A) :
    ∀ k ≤ D.length, (lvls G (D.take k) A).length = N ∧ Canon (2 ^ n + 1) (lvls G (D.take k) A) := by
  intro k
  induction k with
  | zero => intro _; simpa [lvls] using ⟨hAl, hAc⟩
  | succ k ih =>
    intro hk
    obtain ⟨i1, i2⟩ := ih (by omega)
    have hk' : k < D.length := by omega
    obtain ⟨⟨o1, o2, o3, -⟩, -, hg, -⟩ := hD D[k] (List.getElem_mem hk')
    rw [lvls_take_succ G D A k hk']
    exact ⟨by rw [length_lvl G _ _ (by rw [i1, o1]) (by omega), i1],
      canon_lvl' G n _ hg _ (by rw [i1, o1]) (by omega) i2⟩

theorem passP_spec (M : MulSpec) (src dst : Fin HS) (h1 : src ≠ dst) (hs : src.val < 55)
    (hd : dst.val < 55) (hs1 : src ≠ PR) (hs2 : src ≠ XL) (hs3 : src ≠ XE) (hs4 : src ≠ BS)
    (hd1 : dst ≠ PR) (hd2 : dst ≠ XL) (hd3 : dst ≠ XE) (hd4 : dst ≠ BS)
    (hs5 : src ≠ XD) (hd5 : dst ≠ XD) (hs6 : src ≠ NLogN.FW.ZB) (hd6 : dst ≠ NLogN.FW.ZB) (hs7 : src ≠ YC)
    (hd7 : dst ≠ YC) (hs8 : src ≠ KBR) (hd8 : dst ≠ KBR) (hs9 : src ≠ NN) (hd9 : dst ≠ NN)
    (hs10 : src ≠ NLogN.FW.XN) (hd10 : dst ≠ NLogN.FW.XN) (hs11 : src ≠ XF) (hd11 : dst ≠ XF)
    (hs12 : src ≠ CAX) (hd12 : dst ≠ CAX)
    (T : RM) (G : ℕ → ℕ → List ℤ → List ℤ) (cT : ℕ → ℕ) (n kb W N J : ℕ) (D : List Desc)
    (hD : PassOK M T G cT n kb W N J D) (hTw : C1 ∉ T.writes) (hTw0 : C0 ∉ T.writes)
    (hTwA : CAX ∉ T.writes)
    (hcT : ∀ j ≤ J, cT j ≤ 500000 * (n + 3) * (j + 1) * 2 ^ j) (hmW : zsz (D.length : ℤ) ≤ W)
    (s : IState HS) (A : List ℤ) (RD Rs LK LN LXN LXF LM : List Item)
    (hAl : A.length = N) (hAc : Canon (2 ^ n + 1) A) (hX : s.G XD = ints A ++ RD)
    (hsrc : s.G src = ints (D.flatMap enc8) ++ Rs) (hK : s.G KBR = .int kb :: LK)
    (hN : s.G NN = .int (N : ℤ) :: LN) (hXN : s.G NLogN.FW.XN = .int (2 ^ n) :: LXN)
    (hXF : s.G XF = .int (2 ^ n + 1) :: LXF) (hM : s.G NAX = .int (D.length : ℤ) :: LM) :
    Spec M (passP src dst T) s
      (((s.upd XD (ints (lvls G D A) ++ RD)).upd src Rs).upd dst
        (ints (D.flatMap enc8).reverse ++ s.G dst))
      (passCost D.length n kb W N J) := by
  have hF := lvls_facts M T G cT n kb W N J D hD A hAl hAc
  have H := rep_spec_reg (M := M) (i := CAX) (r := NAX) (b := axBody src dst T) (s := s)
    (pSt G src dst s D A RD Rs) D.length LM hM
    (by simp (config := {decide := true}) [axBody, RM.seqL, RM.writes, rd8, rd, mv1, RS.writes,
      lvlP, blkBody, trWith, trP, RM.ren, colLoop, colBody, mvList, mvBody, RS.writes_ren, transP,
      hTwA, Ne.symm hs12, Ne.symm hd12])
    (by simp only [pSt, List.drop_zero, List.take_zero, List.flatMap_nil, List.reverse_nil,
      ints_nil, List.nil_append, lvls, List.foldl_nil]; rw [← hX, ← hsrc]; simp)
    (fun k => by simp (config := {decide := true}) [pSt, IState.upd_G, hs12, hd12, Ne.symm hs12,
      Ne.symm hd12])
    (by decide) (by decide) W hmW
    (10 ^ 7 * (kb + 1) * N * (W + kb + 5) + 500000 * (n + 3) * (J + 1) * N + 90000 * (W + 2)) ?_
  · have e : pSt G src dst s D A RD Rs D.length = (((s.upd XD (ints (lvls G D A) ++ RD)).upd src
        Rs).upd dst (ints (D.flatMap enc8).reverse ++ s.G dst)) := by
      simp [pSt]
    rw [e] at H
    refine H.mono ?_
    simp only [passCost]; nlinarith
  intro k hk
  have hk' : k < D.length := hk
  obtain ⟨hdo, hT, hg, hJ⟩ := hD D[k] (List.getElem_mem hk')
  obtain ⟨fl, fc⟩ := hF k (by omega)
  set t := withCtr CAX s D.length k (pSt G src dst s D A RD Rs k) with ht
  have tsrc : t.G src = ints (enc8 D[k]) ++ (ints ((D.drop (k + 1)).flatMap enc8) ++ Rs) := by
    simp only [ht, withCtr, pSt, IState.upd_G, if_neg hs12, if_neg h1, if_true]
    rw [List.drop_eq_getElem_cons hk', List.flatMap_cons, ints_append, List.append_assoc]
  have e := axBody_spec M src dst h1 hs hd hs1 hs2 hs3 hs4 hd1 hd2 hd3 hd4 hs5 hd5 hs6 hd6 hs7 hd7
    hs8 hd8 hs9 hd9 hs10 hd10 hs11 hd11 T G n kb W N (cT D[k].2.1) D[k] hT hg hTw hTw0 hdo t
    (lvls G (D.take k) A) RD _ LK LN LXN LXF fl fc
    (by simp (config := {decide := true}) [ht, withCtr, pSt, IState.upd_G, Ne.symm hs5,
      Ne.symm hd5])
    tsrc
    (by simp (config := {decide := true}) [ht, withCtr, pSt, IState.upd_G, Ne.symm hs8,
      Ne.symm hd8, hK])
    (by simp (config := {decide := true}) [ht, withCtr, pSt, IState.upd_G, Ne.symm hs9,
      Ne.symm hd9, hN])
    (by simp (config := {decide := true}) [ht, withCtr, pSt, IState.upd_G, Ne.symm hs10,
      Ne.symm hd10, hXN])
    (by simp (config := {decide := true}) [ht, withCtr, pSt, IState.upd_G, Ne.symm hs11,
      Ne.symm hd11, hXF])
  refine e.congr ?_ |>.mono ?_
  · simp only [ht, pSt, withCtr]
    rw [lvls_take_succ G D A k hk', flatMap_take_succ enc8 D k hk', List.reverse_append,
      enc8_reverse, ints_append]
    refine IState.ext' (fun x => ?_) (by simp) (by simp)
    simp only [IState.upd_G]
    by_cases a1 : x = src
    · subst a1; simp [h1, hs5, hs12]
    by_cases a2 : x = dst
    · subst a2; simp [a1, hd5, hd12]
    by_cases a3 : x = XD
    · subst a3; simp (config := {decide := true}) [a1, a2]
    simp [a1, a2, a3]
  · obtain ⟨o1, o2, o3, -⟩ := hdo
    have := lvlCost_le D[k].1 D[k].2.1 D[k].2.2.2 kb W (cT D[k].2.1) N o1 o2 o3
    have h2 := hcT _ hJ
    have h3 : D[k].1 * D[k].2.2.2 * cT D[k].2.1 ≤ 500000 * (n + 3) * (J + 1) * N := by
      calc D[k].1 * D[k].2.2.2 * cT D[k].2.1
          ≤ D[k].1 * D[k].2.2.2 * (500000 * (n + 3) * (D[k].2.1 + 1) * 2 ^ D[k].2.1) :=
            Nat.mul_le_mul_left _ h2
        _ = 500000 * (n + 3) * (D[k].2.1 + 1) * (D[k].1 * (2 ^ D[k].2.1 * D[k].2.2.2)) := by ring
        _ ≤ 500000 * (n + 3) * (J + 1) * N := by
            rw [o1]; exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
    omega

end NLogN.FW

