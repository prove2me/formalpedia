theorem _root_.solution {pMain : ℕ} (C : Procs P pMain) {μ : ℕ → ℤ}
    {srcL headL srcR headR shiftCell base NL NR g p m U D : ℕ} {shift : ℤ} (fL fR : ℕ → ℤ)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d + 6 < lim.depth) (hg : 0 < g) (hp : 0 < p) (hm : 0 < m)
    (hsrcL : srcL + NL ≤ base) (hsrcR : srcR + NR ≤ base) (hheadL : headL + 2 ≤ base) (hheadR : headR + 2 ≤ base)
    (hshiftCell : shiftCell < base) (hspace : space base NL NR g p m U D ≤ lim.space)
    (hword : (word NL NR g p m U D : ℤ) ≤ lim.word) (hshift : |shift| ≤ (D : ℤ)) (hlenL : μ headL = (NL : ℤ))
    (hlenR : μ headR = (NR : ℤ)) (hcountL : μ (headL + 1) = (size NL g : ℤ)) (hcountR : μ (headR + 1) = (size NR g : ℤ))
    (hshiftRead : μ shiftCell = shift) (hreadL : ∀ j < NL, μ (srcL + j) = fL j) (hreadR : ∀ j < NR, μ (srcR + j) = fR j)
    (hvaluesL : ∀ j < NL, |fL j| ≤ (U : ℤ)) (hvaluesR : ∀ j < NR, |fR j| ≤ (U : ℤ)) :
    Meets lim P pMain d [srcL, headL, srcR, headR, g, p, m, shiftCell, base] μ (time NL NR g p m U D)
      (fun r ν => r = (next base NL NR g m : ℤ) ∧ Stored ν fL fR base NL NR g p m shift ∧ Kept μ ν base) :=
  by
  have ho := ordered base NL NR g m
  have hs : next base NL NR g m ≤ lim.space :=
    by
    unfold space LightSourceResidues.space at hspace
    omega
  have hwl : (LightSourceBandStep.word NL g p m U D : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr ((le_max_left _ _).trans (Nat.le_add_right _ 16))).trans hword
  have hwr : (LightSourceBandStep.word NR g p m U D : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr ((le_max_right _ _).trans (Nat.le_add_right _ 16))).trans hword
  have hnL : (NL : ℤ) ≤ lim.word := (Int.ofNat_le.mpr (by unfold LightSourceBandStep.word; omega)).trans hwl
  have hnR : (NR : ℤ) ≤ lim.word := (Int.ofNat_le.mpr (by unfold LightSourceBandStep.word; omega)).trans hwr
  have hcL := (Int.ofNat_le.mpr (size_le NL g)).trans hnL
  have hcR := (Int.ofNat_le.mpr (size_le NR g)).trans hnR
  have hD : (D : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr (by unfold LightSourceBandStep.word LightSourceResidues.word; omega)).trans hwl
  have hshiftW : |shift| ≤ lim.word := hshift.trans hD
  have h8 : (8 : ℤ) ≤ lim.word := by unfold word at hword; omega
  have hleftAddr : base + 8 ≤ lim.space := by change leftBase base ≤ lim.space; omega
