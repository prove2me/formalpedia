theorem exists_rig (hcoord : IsOrderCoord Λ q coord)
    (hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O)
    (hX₀ : u₀.1.IsFormalModuleVia coord X₀.toFormalODModule θ₀)
    (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g) :
    ∃ (X : FormalODModule q A) (θ : RelativeGroupLaw.FormalCoordinates E.f 2)
      (w : (X.map resA).Hom X₀.toFormalODModule), Rig coord θ₀ resA E g X θ w := by
  letI : Algebra A (ResidueField O) := resA.toAlgebra
  have hqA := isNilpotent_natCast hqO resA hs hc
  obtain ⟨X, θ, hXθ⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleOf_of_isLocalRing coord hcoord A hqA E
  obtain ⟨θbar, hθbar, hred⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq
      coord A (ResidueField O) E u₀.1 g hg X θ hXθ
  obtain ⟨w, hwiso, hwrel, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_hom_isIso_forall_apply_eq_apply_nilEval_of_isFormalModuleVia
      coord hcoord (ResidueField O) (isNilpotent_natCast_residueField hqO) u₀.1
      (X.map resA) X₀.toFormalODModule θbar θ₀ hθbar hX₀
  refine ⟨X, θ, w, hXθ, hwiso, ?_⟩
  intro B'' _ _ _ _ J n hJ s hs'
  rw [← hwrel B'' J n hJ s hs']
  exact hred B'' s fun i => isNilpotent_of_mem (isNilpotent_of_pow_succ_eq_bot hJ) (hs' i)

end
