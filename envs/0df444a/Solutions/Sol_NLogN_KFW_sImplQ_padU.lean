section
-- Source module: Solutions.KFWSub
/-!
# KFW: literals read from registers (the uniformity meta-theorem for register programs)

A uniform register program `U` reads its run-time parameters from registers (tops of stacks).
`RS.sub σ U` replaces each register `i` with `σ i = some v` by the literal `v`; the result is
the (non-uniform) program with baked-in literals, for which a spec is usually already proved.

**`FSp.of_sub`**: if `FSp (U.sub σ) s t c`, the registers of `σ` hold their values in `s`
(`Agree σ s`) and `U` never writes them, then `FSp U s t (400 c)`.  Also `fok_of_sub`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD

theorem fok_of_sub (σ : Fin HS → Option ℤ) : ∀ (p : RS), NoW σ p →
    fok (RS.sub σ p) = true → fok p = true
  | .skip, _, _ => rfl
  | .asg _ _, _, _ | .push _ _, _, _ | .pop _, _, _ => rfl
  | .seq a b, hw, h => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, fok, Bool.and_eq_true] at h ⊢
    exact ⟨fok_of_sub σ a ha h.1, fok_of_sub σ b hb h.2⟩
  | .ite c a b, hw, h => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, fok, Bool.and_eq_true] at h ⊢
    exact ⟨fok_of_sub σ a ha h.1, fok_of_sub σ b hb h.2⟩
  | .rep i n b, hw, h => by
    have hbw : NoW σ b := fun j h => hw j (by simp [RS.writes, h])
    have hi : σ i = none := hw i (by simp [RS.writes])
    simp only [RS.sub, fok, Bool.and_eq_true, Bool.not_eq_true'] at h ⊢
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    refine ⟨⟨?_, h2⟩, fok_of_sub σ b hbw h3⟩
    rcases hc : (touch b).contains i with _ | _
    · rfl
    · exfalso
      have hm : i ∈ touch b := by simpa using hc
      rcases RS.touch_sub σ b i hm with h' | h'
      · have : (touch (RS.sub σ b)).contains i = true := by simpa using h'
        rw [this] at h1; exact absurd h1 (by simp)
      · rw [hi] at h'; simp at h'

end NLogN.KFW

end

section
-- Source module: Solutions.KFWBase
/-!
# KFW: header refinement, uniform leaves, parameters in the background

* `HRef p p' X`: `p'` is `p` with some (non-loop) pushes of literals `v` replaced by closed
  expressions of value `v`; `HRef.fsp`: `FSp p s t c → FSp p' s t (c + X)`.
* `RS.sub_id`: substituting registers a program never touches changes nothing.
* `FSp.uni`: `FSp O s t c`, `HRef O (U.sub σ) X`, the registers of `σ` hold their values and are
  not written ⇒ `FSp U s t (400 (c + X))` (and `fok U` from `fok O`).
* `encK_pushSt`, `agree_pushSt`, **`leafPush`**: a uniform leaf `withPushI pl (fcode U)` from the
  non-uniform spec of `O` on the background with the pushed parameters.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD KIL

/-! ## Header refinement -/

theorem HRef.fok {p p' : RS} {X : ℕ} (h : HRef p p' X) : KFD.fok p = true → KFD.fok p' = true := by
  induction h with
  | refl => exact id
  | seq _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | ite _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | push => intro _; rfl
  | mono _ _ ih => exact ih

/-! ## Substitution of untouched registers -/

/-! ## Uniform register programs -/

theorem fok_uni {σ : Fin HS → Option ℤ} {U O : RS} (hw : NoW σ U) {X : ℕ}
    (hO : HRef O (RS.sub σ U) X) (hf : KFD.fok O = true) : KFD.fok U = true :=
  fok_of_sub σ U hw (hO.fok hf)

/-! ## Pushed parameters in the background -/

