          (↥(heckeLatticeAlgebra p ∅) ⧸
            Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}),
        (∀ (t : HeckeAlg)
            (x : ↥((Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
              {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x' ∈ eisensteinTorsionBar p 2 M, y = σ • x' - x'}))
            (htx : t • (x : JZero p) ∈ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
              {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
