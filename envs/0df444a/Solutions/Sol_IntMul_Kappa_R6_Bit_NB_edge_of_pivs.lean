-- Source module: Solutions.R6BitNBPiv
/-!
# Round six, bit network: pivots from ranks, and edges from pivots

* `rk q X Y`: rank of the rows `< X`, columns `≥ Y` of `q`; `IsPiv q i j`: the
  inclusion–exclusion of `rk` at `(i, j)` is one.
* `isPiv_iff`: for a Bruhat factorization `E₁ P E₂`, `IsPiv` is exactly `P i j = 1`.
* `edge_of_pivs`: for an idempotent `q` over `ℚ` and runs whose positions are pivots of `q`, there
  is an edge (lower triangular `E₁, E₂`, nonzero diagonals) with runs `rs ++ rs'`, `rs'` singletons,
  `|rs| + |rs'| = rank q`, and frame `E₁ σ E₂ = pswQ q` (the partial swap of `q`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section Piv

variable {K : Type*} [Field K] {n a b : ℕ}

lemma rk_congr (q : Matrix (Fin a) (Fin b) K) {X X' Y Y' : ℕ}
    (hX : ∀ r : Fin a, r.val < X ↔ r.val < X') (hY : ∀ c : Fin b, Y ≤ c.val ↔ Y' ≤ c.val) :
    rk q X Y = rk q X' Y' := by
  unfold rk
  apply RunsLib.RunsAux.rank_submatrix_range
  · ext r; simp [hX]
  · ext c; simp [hY]

lemma not_isPiv_of_le_row (q : Matrix (Fin a) (Fin b) K) {i : ℕ} (hi : a ≤ i) (j : ℕ) :
    ¬ IsPiv q i j := by
  unfold IsPiv
  have h1 : ∀ Y, rk q (i + 1) Y = rk q i Y := fun Y =>
    rk_congr q (fun r => by have := r.isLt; omega) (fun _ => Iff.rfl)
  rw [h1, h1]; omega

lemma rk_zero_of_le_col (q : Matrix (Fin a) (Fin b) K) (X : ℕ) {Y : ℕ} (hY : b ≤ Y) :
    rk q X Y = 0 := by
  unfold rk
  apply Nat.eq_zero_of_le_zero
  refine (Matrix.rank_le_card_width _).trans ?_
  rw [Nat.le_zero, Fintype.card_eq_zero_iff]
  exact ⟨fun c => by have := c.1.isLt; have := c.2; omega⟩

lemma not_isPiv_of_le_col (q : Matrix (Fin a) (Fin b) K) (i : ℕ) {j : ℕ} (hj : b ≤ j) :
    ¬ IsPiv q i j := by
  unfold IsPiv
  rw [rk_zero_of_le_col q _ hj, rk_zero_of_le_col q _ hj, rk_zero_of_le_col q _ (by omega),
    rk_zero_of_le_col q _ (by omega)]
  omega

lemma isPiv_lt {q : Matrix (Fin a) (Fin b) K} {i j : ℕ} (h : IsPiv q i j) : i < a ∧ j < b := by
  by_contra hc
  rcases not_and_or.1 hc with h' | h'
  · exact not_isPiv_of_le_row q (by omega) j h
  · exact not_isPiv_of_le_col q i (by omega) h

open RunsLib.PPUniqAux in
/-- For a Bruhat factorization, the pivots are the ones of `P`. -/
lemma isPiv_iff [DecidableEq K] (E₁ P E₂ : Matrix (Fin n) (Fin n) K)
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hd₁ : ∀ i, E₁ i i ≠ 0)
    (hE₂ : ∀ i j, i < j → E₂ i j = 0) (hd₂ : ∀ i, E₂ i i ≠ 0)
    (h01 : ∀ i j, P i j = 0 ∨ P i j = 1)
    (hrow : ∀ i j j', P i j = 1 → P i j' = 1 → j = j')
    (hcol : ∀ i i' j, P i j = 1 → P i' j = 1 → i = i') (i j : Fin n) :
    IsPiv (E₁ * P * E₂) i.val j.val ↔ P i j = 1 := by
  have h := fun X Y => RunsLib.RunsAux.bruhat_rank_nat E₁ P E₂ hE₁ hd₁ hE₂ hd₂ h01 hrow hcol X Y
  unfold IsPiv rk
  rw [h, h, h, h]
  have e1 := cnt_succ_row P i.val j.val
  have e3 := row_succ_col P i.val j.val
  have e5 := cnt_succ_row P i.val (j.val + 1)
  have hs := single_cnt P i j
  unfold cnt at e1 e5
  split_ifs at hs with hP
  · simp only [hP, iff_true]; omega
  · simp only [hP, iff_false]; omega

end Piv

/-! ## Products of disjoint transpositions -/

section Swaps

variable {α : Type*} [DecidableEq α]

lemma swaps_apply : ∀ (L : List (α × α)), L.Pairwise PDisj → (∀ p ∈ L, p.1 ≠ p.2) →
    (∀ p ∈ L, (L.map fun p => Equiv.swap p.1 p.2).prod p.1 = p.2) ∧
    (∀ p ∈ L, (L.map fun p => Equiv.swap p.1 p.2).prod p.2 = p.1) ∧
    (∀ x, (∀ p ∈ L, x ≠ p.1 ∧ x ≠ p.2) → (L.map fun p => Equiv.swap p.1 p.2).prod x = x)
  | [], _, _ => by simp
  | p :: L, hL, hne => by
    rw [List.pairwise_cons] at hL
    obtain ⟨ih1, ih2, ih3⟩ := swaps_apply L hL.2 (fun q hq => hne q (List.mem_cons_of_mem _ hq))
    have hp := hne p (List.mem_cons_self ..)
    simp only [List.map_cons, List.prod_cons, Equiv.Perm.mul_apply, List.mem_cons,
      forall_eq_or_imp]
    have hfix : ∀ y, (∀ q ∈ L, y ≠ q.1 ∧ y ≠ q.2) → y = p.1 ∨ y = p.2 →
        (L.map fun p => Equiv.swap p.1 p.2).prod y = y := fun y hy _ => ih3 y hy
    have hp1 : (L.map fun p => Equiv.swap p.1 p.2).prod p.1 = p.1 :=
      ih3 _ fun q hq => ⟨(hL.1 q hq).1, (hL.1 q hq).2.1⟩
    have hp2 : (L.map fun p => Equiv.swap p.1 p.2).prod p.2 = p.2 :=
      ih3 _ fun q hq => ⟨(hL.1 q hq).2.2.1, (hL.1 q hq).2.2.2⟩
    refine ⟨⟨by rw [hp1, Equiv.swap_apply_left], fun q hq => ?_⟩,
      ⟨by rw [hp2, Equiv.swap_apply_right], fun q hq => ?_⟩, fun x hx => ?_⟩
    · rw [ih1 q hq, Equiv.swap_apply_of_ne_of_ne (hL.1 q hq).2.1.symm (hL.1 q hq).2.2.2.symm]
    · rw [ih2 q hq, Equiv.swap_apply_of_ne_of_ne (hL.1 q hq).1.symm (hL.1 q hq).2.2.1.symm]
    · rw [ih3 x hx.2, Equiv.swap_apply_of_ne_of_ne hx.1.1 hx.1.2]

end Swaps

/-! ## Edges from pivots -/

section Edge

variable {m : ℕ}

lemma flatMap_runPiv (rs : List (ℕ × ℕ × ℕ)) :
    rs.flatMap (runPiv m) = (runPairs rs).filterMap (finPair m) := by
  induction rs with
  | nil => rfl
  | cons ρ rs ih =>
    rw [List.flatMap_cons, runPairs, List.flatMap_cons, List.filterMap_append, ← runPairs, ← ih,
      List.filterMap_map]
    rfl

lemma runPairs_append (rs rs' : List (ℕ × ℕ × ℕ)) :
    runPairs (rs ++ rs') = runPairs rs ++ runPairs rs' := by
  simp [runPairs, List.flatMap_append]

lemma runPairs_singles (l : List (ℕ × ℕ)) :
    runPairs (l.map fun x => (x.1, x.2, 1)) = l := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    rw [List.map_cons, runPairs, List.flatMap_cons, ← runPairs, ih]
    simp

open RunsLib in
theorem edge_of_pivs_sol_aux (hm : 1 < m) (q : Matrix (Fin m) (Fin m) ℚ) (hq : q * q = q)
    (rs : List (ℕ × ℕ × ℕ)) (hok : ∀ ρ ∈ rs, RunOK m ρ) (hnd : (runPairs rs).Nodup)
    (hp : ∀ x ∈ runPairs rs, IsPiv q x.1 x.2) :
    ∃ e : Edge m, (∃ rs', e.runs = rs ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
        (runPairs rs).length + rs'.length = q.rank) ∧
      (∀ ρ ∈ e.runs, RunOK m ρ) ∧
      (∀ i j, i < j → e.E₁ i j = 0) ∧ (∀ i, e.E₁ i i ≠ 0) ∧
      (∀ i j, i < j → e.E₂ i j = 0) ∧ (∀ i, e.E₂ i i ≠ 0) ∧
      e.E₁ * ((e.runs.flatMap (runPiv m)).map fun p => Equiv.swap p.1 p.2).prod.permMatrix ℚ *
        e.E₂ = pswQ q := by
  classical
  obtain ⟨F₁, P, F₂, h1, h2, h3, h4, h01, hrow, hcol, hcard, hfac⟩ := bruhat_exists q
  have hpiv : ∀ i j : Fin m, IsPiv q i.val j.val ↔ P i j = 1 := by
    intro i j; rw [hfac]; exact isPiv_iff F₁ P F₂ h1 h2 h3 h4 h01 hrow hcol i j
  obtain ⟨E₁, E₂, g1, g2, g3, g4, hS⟩ := solution q F₁ P F₂ hq h1 h2 h3 h4 h01 hrow hcol hfac
  -- the pivot set and the remaining singletons
  set Ps : Finset (Fin m × Fin m) := univ.filter fun x => P x.1 x.2 = 1 with hPs
  set vp : Fin m × Fin m → ℕ × ℕ := fun x => (x.1.val, x.2.val) with hvp
  have vp_inj : Function.Injective vp := by
    intro x y h
    simp only [hvp, Prod.mk.injEq] at h
    exact Prod.ext (Fin.ext h.1) (Fin.ext h.2)
  set Rest := Ps.filter fun x => vp x ∉ runPairs rs with hRest
  set rs' : List (ℕ × ℕ × ℕ) := (Rest.toList.map vp).map fun x => (x.1, x.2, 1) with hrs'
  -- membership in runPairs
  have hmemR : ∀ x ∈ runPairs rs, ∃ y : Fin m × Fin m, P y.1 y.2 = 1 ∧ vp y = x := by
    intro x hx
    obtain ⟨hi, hj⟩ := isPiv_lt (hp x hx)
    exact ⟨(⟨x.1, hi⟩, ⟨x.2, hj⟩), (hpiv ⟨x.1, hi⟩ ⟨x.2, hj⟩).1 (hp x hx), rfl⟩
  have hall : runPairs (rs ++ rs') = runPairs rs ++ Rest.toList.map vp := by
    rw [runPairs_append, hrs', runPairs_singles]
  have hmem : ∀ x, x ∈ runPairs (rs ++ rs') ↔ ∃ y : Fin m × Fin m, P y.1 y.2 = 1 ∧ vp y = x := by
    intro x
    rw [hall, List.mem_append, List.mem_map]
    constructor
    · rintro (hx | ⟨y, hy, rfl⟩)
      · exact hmemR x hx
      · rw [Finset.mem_toList, hRest, Finset.mem_filter, hPs, Finset.mem_filter] at hy
        exact ⟨y, hy.1.2, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      by_cases h : vp y ∈ runPairs rs
      · exact Or.inl h
      · right
        refine ⟨y, ?_, rfl⟩
        rw [Finset.mem_toList, hRest, Finset.mem_filter, hPs, Finset.mem_filter]
        exact ⟨⟨Finset.mem_univ _, hy⟩, h⟩
  have hndall : (runPairs (rs ++ rs')).Nodup := by
    rw [hall, List.nodup_append]
    refine ⟨hnd, (Finset.nodup_toList _).map vp_inj, ?_⟩
    intro a ha b hb hab
    subst hab
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hb
    rw [Finset.mem_toList, hRest, Finset.mem_filter] at hy
    exact hy.2 ha
  -- the edge
  refine ⟨⟨E₁, rs ++ rs', E₂⟩, ⟨rs', rfl, ?_, ?_⟩, ?_, g1, g2, g3, g4, ?_⟩
  · intro ρ hρ
    rw [hrs', List.map_map] at hρ
    obtain ⟨y, -, rfl⟩ := List.mem_map.1 hρ
    rfl
  · -- counting
    have hlen : rs'.length = Rest.card := by simp [hrs']
    have hR : (runPairs rs).length = (Ps.filter fun x => vp x ∈ runPairs rs).card := by
      rw [← List.toFinset_card_of_nodup hnd]
      symm
      apply Finset.card_bij (fun x _ => vp x)
      · intro x hx
        rw [Finset.mem_filter] at hx
        exact List.mem_toFinset.2 hx.2
      · intro x _ y _ h; exact vp_inj h
      · intro b hb
        obtain ⟨y, hy, rfl⟩ := hmemR b (List.mem_toFinset.1 hb)
        exact ⟨y, Finset.mem_filter.2 ⟨Finset.mem_filter.2 ⟨Finset.mem_univ _, hy⟩,
          List.mem_toFinset.1 hb⟩, rfl⟩
    rw [hlen, hR, hRest, Finset.card_filter_add_card_filter_not, hPs]
    exact hcard
  · intro ρ hρ
    rcases List.mem_append.1 hρ with h | h
    · exact hok ρ h
    · rw [hrs', List.map_map] at h
      obtain ⟨y, -, rfl⟩ := List.mem_map.1 h
      refine ⟨Nat.one_pos, hm, ?_, ?_⟩
      · show y.1.val + 1 ≤ m; have := y.1.isLt; omega
      · show y.2.val + 1 ≤ m; have := y.2.isLt; omega
  · -- the permutation matrix is `Wmat P`
    rw [pswQ, hS]
    congr 2
    set L := (rs ++ rs').flatMap (runPiv m) with hL
    have hLmem : ∀ z, z ∈ L ↔ ∃ y : Fin m × Fin m, P y.1 y.2 = 1 ∧
        z = (Fin.castAdd m y.1, Fin.natAdd m y.2) := by
      intro z
      rw [hL, flatMap_runPiv, List.mem_filterMap]
      constructor
      · rintro ⟨x, hx, hz⟩
        obtain ⟨y, hy, rfl⟩ := (hmem x).1 hx
        refine ⟨y, hy, ?_⟩
        simp only [finPair, hvp, Fin.is_lt, and_self, dite_true, Option.some.injEq] at hz
        rw [← hz]
      · rintro ⟨y, hy, rfl⟩
        refine ⟨vp y, (hmem _).2 ⟨y, hy, rfl⟩, ?_⟩
        simp [finPair, hvp]
    have hLnd : L.Nodup := by
      rw [hL, flatMap_runPiv]
      refine List.Nodup.filterMap ?_ hndall
      intro a a' b hb hb'
      unfold finPair at hb hb'
      by_cases ha : a.1 < m ∧ a.2 < m
      · by_cases ha' : a'.1 < m ∧ a'.2 < m
        · rw [dif_pos ha] at hb; rw [dif_pos ha'] at hb'
          simp only [Option.mem_def, Option.some.injEq] at hb hb'
          rw [← hb'] at hb
          have e1 := congrArg (fun z => z.1.val) hb
          have e2 := congrArg (fun z => z.2.val) hb
          simp at e1 e2
          exact Prod.ext e1 e2
        · rw [dif_neg ha'] at hb'; simp at hb'
      · rw [dif_neg ha] at hb; simp at hb
    have cinj : ∀ a b : Fin m, Fin.castAdd m a = Fin.castAdd m b → a = b := fun a b h =>
      Fin.ext (by simpa using congrArg Fin.val h)
    have ninj : ∀ a b : Fin m, Fin.natAdd m a = Fin.natAdd m b → a = b := fun a b h =>
      Fin.ext (by simpa using congrArg Fin.val h)
    have nc : ∀ a b : Fin m, Fin.natAdd m a ≠ Fin.castAdd m b := fun a b h =>
      AModel.castAdd_ne_natAdd _ _ h.symm
    have hpair : L.Pairwise PDisj := by
      refine hLnd.pairwise_of_forall_ne fun a ha b hb hab => ?_
      obtain ⟨y, hy, rfl⟩ := (hLmem a).1 ha
      obtain ⟨y', hy', rfl⟩ := (hLmem b).1 hb
      have hyy : y ≠ y' := fun h => hab (by rw [h])
      refine ⟨fun h => hyy ?_, fun h => ?_, fun h => ?_, fun h => hyy ?_⟩
      · have e1 : y.1 = y'.1 := cinj _ _ h
        have e2 := hrow y.1 y.2 y'.2 hy (e1 ▸ hy')
        exact Prod.ext e1 e2
      · exact AModel.castAdd_ne_natAdd _ _ h
      · exact AModel.castAdd_ne_natAdd _ _ h.symm
      · have e2 : y.2 = y'.2 := ninj _ _ h
        have e1 := hcol y.1 y'.1 y.2 hy (e2 ▸ hy')
        exact Prod.ext e1 e2
    have hne : ∀ p ∈ L, p.1 ≠ p.2 := by
      intro p hp
      obtain ⟨y, -, rfl⟩ := (hLmem p).1 hp
      exact AModel.castAdd_ne_natAdd _ _
    obtain ⟨s1, s2, s3⟩ := swaps_apply L hpair hne
    set σ := (L.map fun p => Equiv.swap p.1 p.2).prod with hσ
    have hH : ∀ i : Fin m, (∃ j, P i j = 1) → ∀ j, P i j = 1 →
        σ (Fin.castAdd m i) = Fin.natAdd m j := fun i _ j hj =>
      s1 _ ((hLmem _).2 ⟨(i, j), hj, rfl⟩)
    have hD : ∀ j : Fin m, ∀ i, P i j = 1 → σ (Fin.natAdd m j) = Fin.castAdd m i := fun j i hj =>
      s2 _ ((hLmem _).2 ⟨(i, j), hj, rfl⟩)
    have hHf : ∀ i : Fin m, (¬ ∃ j, P i j = 1) → σ (Fin.castAdd m i) = Fin.castAdd m i := by
      intro i hi
      refine s3 _ fun p hp => ?_
      obtain ⟨y, hy, rfl⟩ := (hLmem p).1 hp
      refine ⟨fun h => hi ⟨y.2, ?_⟩, fun h => AModel.castAdd_ne_natAdd _ _ h⟩
      rw [cinj _ _ h]; exact hy
    have hDf : ∀ j : Fin m, (¬ ∃ i, P i j = 1) → σ (Fin.natAdd m j) = Fin.natAdd m j := by
      intro j hj
      refine s3 _ fun p hp => ?_
      obtain ⟨y, hy, rfl⟩ := (hLmem p).1 hp
      refine ⟨fun h => AModel.castAdd_ne_natAdd _ _ h.symm, fun h => hj ⟨y.1, ?_⟩⟩
      rw [ninj _ _ h]; exact hy
    ext a b
    obtain ⟨a, rfl⟩ := finSumFinEquiv.surjective a
    obtain ⟨b, rfl⟩ := finSumFinEquiv.surjective b
    simp only [Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply,
      Option.mem_def, Option.some.injEq, submatrix_apply, Equiv.symm_apply_apply]
    rcases a with i | i <;> rcases b with j | j <;>
      simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, fromBlocks_apply₁₁,
        fromBlocks_apply₁₂, fromBlocks_apply₂₁, fromBlocks_apply₂₂, diagonal_apply,
        transpose_apply]
    · by_cases hi : ∃ j, P i j = 1
      · obtain ⟨j', hj'⟩ := hi
        simp only [hH i ⟨j', hj'⟩ j' hj', nc,
          if_false, show ∃ j, P i j = 1 from ⟨j', hj'⟩, if_true, ite_self]
      · simp only [hHf i hi, hi, if_false]
        by_cases hij : i = j
        · subst hij; simp
        · simp only [hij, if_false, ite_eq_right_iff, one_ne_zero, imp_false]
          exact fun h => hij (cinj _ _ h)
    · by_cases hij : P i j = 1
      · simp only [hH i ⟨j, hij⟩ j hij, hij, if_true]
      · rcases h01 i j with h0 | h0
        · rw [h0]
          by_cases hi : ∃ j, P i j = 1
          · obtain ⟨j', hj'⟩ := hi
            simp only [hH i ⟨j', hj'⟩ j' hj', ite_eq_right_iff, one_ne_zero, imp_false]
            intro h
            rw [ninj _ _ h] at hj'
            exact hij hj'
          · simp only [hHf i hi, AModel.castAdd_ne_natAdd, if_false]
        · exact absurd h0 hij
    · by_cases hij : P j i = 1
      · simp only [hD i j hij, hij, if_true]
      · rcases h01 j i with h0 | h0
        · rw [h0]
          by_cases hi : ∃ i', P i' i = 1
          · obtain ⟨i', hi'⟩ := hi
            simp only [hD i i' hi', ite_eq_right_iff, one_ne_zero, imp_false]
            intro h
            rw [cinj _ _ h] at hi'
            exact hij hi'
          · simp only [hDf i hi, nc, if_false]
        · exact absurd h0 hij
    · by_cases hi : ∃ i', P i' i = 1
      · obtain ⟨i', hi'⟩ := hi
        simp only [hD i i' hi', AModel.castAdd_ne_natAdd, if_false,
          show ∃ i', P i' i = 1 from ⟨i', hi'⟩, if_true, ite_self]
      · simp only [hDf i hi, hi, if_false]
        by_cases hij : i = j
        · subst hij; simp
        · simp only [hij, if_false, ite_eq_right_iff, one_ne_zero, imp_false]
          exact fun h => hij (ninj _ _ h)

end Edge

end IntMul.Kappa.R6.Bit.NB

