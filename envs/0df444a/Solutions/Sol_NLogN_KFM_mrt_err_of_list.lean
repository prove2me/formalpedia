variable {D : ℕ}
theorem solution (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {xh : List (Fin (t (Fin.last D)) → ℂ)} {E : ℝ}
    (hE : 0 ≤ E) (hl : xh.length = (NLogN.KFM.tsOf t).prod)
    (h : ∀ j < (NLogN.KFM.tsOf t).prod, ∀ k : Fin (t (Fin.last D)),
      ‖xh.getD j 0 k - (NLogN.KFM.mrL (t (Fin.last D)) (NLogN.KFM.tsOf t) (NLogN.KFM.recL t f) (NLogN.KFM.recL t g)).getD j 0 k‖ ≤ E) :
    ‖NLogN.KFM.boxOf t xh - NLogN.KFM.mrX t f g‖ ≤ E := by
  refine NLogN.KFM.pi_le hE fun K => ?_
  have e := NLogN.KFM.boxOf_recL t (NLogN.KFM.mrX t f g)
  rw [Pi.sub_apply, ← e]
  simp only [NLogN.KFM.boxOf]
  set x := (Equiv.ofBijective _ (NLogN.KFM.phiB_bij t)).symm K
  have := h x.1 x.1.2 x.2
  rwa [NLogN.KFM.mrL_box] at this
end
