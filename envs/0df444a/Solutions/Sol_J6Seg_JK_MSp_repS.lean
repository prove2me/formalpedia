theorem MSp.repS_sol_aux {M : MulSpec} {C : Fin HS} {n : Ex HS} {b : RM} {s : IState HS}
    {F : ℕ → Fin HS → List ℤ} {N B : ℕ} {c : ℕ → ℕ} (hC5 : C.val < 56) (hC : ∀ k, F k C = [])
    (hw : C ∉ b.writes) (hnc : n.Clean) (hno : n.ok (encK s (F 0)))
    (hnb : n.Bnd (encK s (F 0)) B) (hn : n.eval (encK s (F 0)) = N)
    (hb : ∀ k < N, MSp M b (encK s (update (F k) C [(N : ℤ) - k]))
      (encK s (update (F (k + 1)) C [(N : ℤ) - k])) (c k)) :
    MSp M (.rep C n b) (encK s (F 0)) (encK s (F N))
      ((n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
        ∑ k ∈ range N, (c k + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) + 32) := by
  have hN : (n.eval (encK s (F 0))).toNat = N := by rw [hn]; simp
  have H : RM.RepStates C n b (encK s (F 0)) (fun k => encK s (F k)) :=
    { nonneg := by rw [hn]; positivity
      hw := hw
      h0 := rfl
      hG := fun k => by simp [hC]
      step := by
        intro k hk
        rw [hN] at hk ⊢
        rw [withCtr_encK C s _ _ (hC 0) (hC k), withCtr_encK C s _ _ (hC 0) (hC (k + 1))]
        exact (hb k hk).2.1 }
  refine ⟨?_, ?_, ?_⟩
  · refine H.ok hC5 hnc hno ?_
    intro k hk
    rw [hN] at hk ⊢
    rw [withCtr_encK C s _ _ (hC 0) (hC k)]
    exact (hb k hk).1
  · rw [H.run, hN]
  · have hB := Ex.zsz_eval_le _ B n hnb
    have h1 := RS.pushCost_le n (encK s (F 0)) B hnb
    have h2 : ∑ k ∈ range (n.eval (encK s (F 0))).toNat,
        (b.cost M (RM.repSt C n b (encK s (F 0)) k) +
          RS.asgCost C (RS.decE C) (b.run (RM.repSt C n b (encK s (F 0)) k)) + 30) ≤
        ∑ k ∈ range N, (c k + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) := by
      rw [hN]
      apply Finset.sum_le_sum
      intro k hk
      rw [Finset.mem_range] at hk
      have hk' : k < (n.eval (encK s (F 0))).toNat := by rw [hN]; exact hk
      rw [H.repSt' k hk'.le, H.step k hk']
      have hc : b.cost M (withCtr C (encK s (F 0)) (n.eval (encK s (F 0))).toNat k
          (encK s (F k))) ≤ c k := by
        rw [hN, withCtr_encK C s _ _ (hC 0) (hC k)]; exact (hb k hk).2.2
      have hd := RS.asgCost_le C (RS.decE C) (withCtr C (encK s (F 0))
        (n.eval (encK s (F 0))).toNat k (encK s (F (k + 1)))) B ?_ ?_
      · have : (RS.decE C).size = 3 := rfl
        rw [this] at hd
        omega
      · have hv : zsz (((n.eval (encK s (F 0))).toNat : ℤ) - k) ≤ B :=
          le_trans (zsz_mono (by omega)) hB
        have hv' : zsz (((n.eval (encK s (F 0))).toNat : ℤ) - k + -1) ≤ B :=
          le_trans (zsz_mono (by omega)) hB
        simp only [RS.decE, Ex.Bnd, Ex.eval, IState.top, withCtr, IState.upd_G, if_true]
        refine ⟨hv, ?_, hv'⟩
        rw [zsz_neg, zsz_one]
        have : 1 ≤ zsz (n.eval (encK s (F 0))) := by
          by_contra hc'
          have := (zsz_le_iff (z := n.eval (encK s (F 0))) (m := 0)).1 (by omega)
          simp at this; omega
        omega
      · simp only [IState.top, withCtr, IState.upd_G, if_true]
        exact le_trans (zsz_mono (by omega)) hB
    simp only [RM.cost]
    omega

