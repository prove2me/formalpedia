theorem _root_.solution {X : ShiftSpace A}
    (hX : X.carrier = ∅) : languageEntropy (language X) = ⊥ := by
  have hz : wordCount (language X) 0 = 0 := by
    apply Finset.card_eq_zero.mpr
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro w hw
    obtain ⟨⟨x, hx, _, _⟩, _⟩ := mem_wordFinset.mp hw
    simp only [hX, Set.notMem_empty] at hx
  exact languageEntropy_eq_bot_of_missing_length (language_factorial X) hz
