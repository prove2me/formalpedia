theorem monoSrc_some (N : ℕ) : MonoSrc N N (fun l => some l) :=
  ⟨fun l hl k hk => by cases hk; exact hl, fun l₁ l₂ k₁ k₂ h12 _ h1 h2 => by
    cases h1; cases h2; exact h12.le⟩

