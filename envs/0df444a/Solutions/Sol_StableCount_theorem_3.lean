/-! ## Soundness -/

theorem listSum_range (f : ℕ → ℕ) (n : ℕ) :
    ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]
    simp

theorem K_cast (p q : ℕ) (hq : 0 < q) :
    (K p q : ℝ) = (q : ℝ) ^ 19 * (Nat.factorial 19 : ℝ) *
      ∑ i ∈ Finset.range 20, ((p : ℝ) / q) ^ i / (Nat.factorial i : ℝ) := by
  unfold K
  rw [listSum_range, Nat.cast_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hi' : i ≤ 19 := by simp at hi; omega
  have hqR : (q : ℝ) ≠ 0 := by positivity
  rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_pow, Nat.cast_pow,
    Nat.cast_div (Nat.factorial_dvd_factorial hi') (by positivity)]
  have e : (q : ℝ) ^ 19 = (q : ℝ) ^ (19 - i) * (q : ℝ) ^ i := by
    rw [← pow_add]; congr 1; omega
  rw [e, div_pow]
  have : (Nat.factorial i : ℝ) ≠ 0 := by positivity
  field_simp

theorem expOK_sound {p q B A : ℕ} (h : expOK p q B A = true) :
    Real.exp (-((p : ℝ) / q)) * B ≤ A := by
  simp only [expOK, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨hq, hK⟩ := h
  have x0 : 0 ≤ (p : ℝ) / q := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hSle := Real.sum_le_exp_of_nonneg x0 20
  have hc : ((B * q ^ 19 * Nat.factorial 19 : ℕ) : ℝ) ≤ ((A * K p q : ℕ) : ℝ) := by
    exact_mod_cast hK
  rw [Nat.cast_mul A, K_cast p q hq] at hc
  rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_pow] at hc
  generalize (∑ i ∈ Finset.range 20, ((p : ℝ) / q) ^ i / (Nat.factorial i : ℝ)) = S at hc hSle
  have hF0 : (0 : ℝ) < ((Nat.factorial 19 : ℕ) : ℝ) := by exact_mod_cast Nat.factorial_pos 19
  clear hK
  generalize ((Nat.factorial 19 : ℕ) : ℝ) = F at hc hF0
  have hF : 0 < F := hF0
  generalize (p : ℝ) / q = x at hSle
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hpos : (0 : ℝ) < (q : ℝ) ^ 19 * F := mul_pos (pow_pos hq' 19) hF
  have hBS : (B : ℝ) ≤ A * S := by
    have : (B : ℝ) * ((q : ℝ) ^ 19 * F) ≤ (A * S) * ((q : ℝ) ^ 19 * F) := by
      calc (B : ℝ) * ((q : ℝ) ^ 19 * F) = B * q ^ 19 * F := by ring
        _ ≤ A * (q ^ 19 * F * S) := hc
        _ = (A * S) * ((q : ℝ) ^ 19 * F) := by ring
    exact le_of_mul_le_mul_right this hpos
  have hA : (0 : ℝ) ≤ A := Nat.cast_nonneg _
  calc Real.exp (-x) * B ≤ Real.exp (-x) * (A * S) :=
        mul_le_mul_of_nonneg_left hBS (Real.exp_pos _).le
    _ ≤ Real.exp (-x) * (A * Real.exp x) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hSle hA) (Real.exp_pos _).le
    _ = A := by rw [mul_left_comm, ← Real.exp_add]; simp

theorem getD_some {l : List ℕ} {d : ℕ} (h : d < l.length) : l[d]? = some (l.getD d 0) := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]; rfl

theorem zip_some {α β : Type} {l1 : List α} {l2 : List β} {i : ℕ} {a : α} {b : β}
    (h1 : l1[i]? = some a) (h2 : l2[i]? = some b) : (List.zip l1 l2)[i]? = some (a, b) := by
  rw [List.zip_eq_zipWith, List.getElem?_zipWith, h1, h2]

theorem mem_of_all {α : Type} {l : List α} {f : α → Bool} (h : l.all f = true) {i : ℕ} {a : α}
    (hi : l[i]? = some a) : f a = true :=
  List.all_eq_true.mp h a (List.mem_of_getElem? hi)

