  have P1 := NLogN.KFV.pushV (i := qX) S (o0 v) (by decide) (cl sA) (hA.pow2 ha) (o0_ne _ (by decide))
  have P2 := NLogN.KFV.pushV (i := NLogN.KFV.qB) S (Function.update (o0 v) qX [((2 ^ a : ℕ) : ℤ)]) (by decide) (cl sF)
    ((hF.pow2 hb).encK fun x hx => by
      have := (sF.2 x hx); simp [Function.update_apply, this.1])
    (by simp [Function.update_apply, o0_ne _ (show NLogN.KFV.qB ≠ 0 by decide), show ¬ NLogN.KFV.qB = qX by decide])
