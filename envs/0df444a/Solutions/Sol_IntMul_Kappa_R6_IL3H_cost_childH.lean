/-- **The child wrapper** overhead (constant child cost `cI`). -/
theorem cost_childH_sol_aux {c : Cfg} {W A m Bn t S0 r Z Zr H G DWc x cI : ℕ} (hW : 1 ≤ W)
    (hZZ : Z ≤ Zr) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (hsz : gsSz c + 6 ≤ A) (hGH : G ≤ H)
    (hGZ : zsz (G : ℤ) ≤ Zr) (hZr : Zr + 2 ≤ r) (hx : x + (DWc + (G + 2) * W) ≤ H) :
    cChF c Zr G + cWrapQ W (nN Bn t S0 * r) Z G DWc (fun _ => cI + 2) x +
      (4 * (2 * (Zr + G + 1) + 2) + 1) ≤ cI + MlocH W A m * ((W * nN Bn t S0) * Yu r Zr H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hEW : G ≤ (G + 2) * W := by nlinarith
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := G) (dw := DWc) (x := x) hW hn
    (fun _ => cI + 2) (by omega)
  have hF := cFrame_Y 3 (gsSz c + 1) r Zr H
  have hYm : Yu r Z H ≤ Yu r Zr H := yu_monoZ hZZ
  have hp2 := pow2Cost_Y hGH hGZ hZr
  have hm1 := moveCost_Y Zr r H
  have hz2 := yu_z2 r Zr H
  have hz1 := yu_z1 r Zr H
  have hyr := yu_r r Zr H
  have hH : 2 * H + 21 ≤ r * (2 * H + 21) := Nat.le_mul_of_pos_left _ (by omega)
  unfold cChF MlocH
  unfold moveCost at hm1 ⊢
  generalize gsSz c = sz at hsz hF ⊢
  set n := nN Bn t S0
  set Y := Yu r Zr H
  have hY8 := yu_8 r Zr H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  have hYP : Y ≤ W * n * Y := Nat.le_mul_of_pos_left _ (by omega)
  have hPm : W * n * Yu r Z H ≤ W * n * Y := Nat.mul_le_mul_left _ hYm
  set P := W * n * Y with hP
  have hPm' : 10 ^ 12 * (W + 2) * (W * n * Yu r Z H) ≤ 10 ^ 12 * (W + 2) * P :=
    Nat.mul_le_mul_left _ hPm
  have hP1 : 1 ≤ P := le_trans (by omega) hYP
  -- the frame part
  have a1 : sz * 10 ^ 7 * (Zr + 2) ^ 2 ≤ sz * 10 ^ 7 * Y := Nat.mul_le_mul_left _ hz2
  have a2 : 3 * (sz + 1 + 1) * 10 ^ 8 * Y ≤ 3 * 10 ^ 8 * ((sz + 2) * Y) := le_of_eq (by ring)
  have a3 : sz * 10 ^ 7 * Y ≤ 10 ^ 7 * ((sz + 2) * Y) :=
    calc sz * 10 ^ 7 * Y = 10 ^ 7 * (sz * Y) := by ring
      _ ≤ 10 ^ 7 * ((sz + 2) * Y) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (Nat.le_add_right _ _))
  have a4 : Y ≤ (sz + 2) * Y := Nat.le_mul_of_pos_left _ (by omega)
  have a5 : (sz + 2) * Y ≤ (sz + 2) * P := Nat.mul_le_mul_left _ hYP
  -- the bound
  have a : (W + 2) + 1 + (sz + 2) ≤ (W + A + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
  have b : 10 ^ 12 * ((W + 2) + 1 + (sz + 2)) * P ≤
      10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 * P := by
    apply Nat.mul_le_mul_right
    have : 10 ^ 12 * ((W + 2) + 1 + (sz + 2)) ≤ 10 ^ 12 * (W + A + 10) ^ 2 :=
      Nat.mul_le_mul_left _ a
    have : 10 ^ 12 * (W + A + 10) ^ 2 ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 :=
      Nat.mul_le_mul_right _ (by omega)
    omega
  have e : 10 ^ 12 * ((W + 2) + 1 + (sz + 2)) * P =
      10 ^ 12 * (W + 2) * P + 10 ^ 12 * P + 10 ^ 12 * ((sz + 2) * P) := by ring
  linarith

