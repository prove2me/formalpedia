      refine ⟨⟨oa, ob⟩, ⟨ba, bb, ?_⟩, ?_⟩
      · rw [ea, eb]; exact le_trans (NLogN.KIL.zsz_nat_le (by exact_mod_cast hok.2.2)) hM
