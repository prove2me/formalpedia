namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

theorem localizedCechVariableMap_transport (rank : V ↪ ℕ) (K : Complex V)
    (T : Finset V) (a b a' b' : V → ℤ) (j : V) (ha : a = a') (hb : b = b')
    (hab : ∀ v, b v = a v + if v = j then 1 else 0)
    (hab' : ∀ v, b' v = a' v + if v = j then 1 else 0) :
    localizedCechVariableMap k rank K T a b j hab ≫
        (eqToIso (congrArg (localizedCechComplex k rank K T) hb)).hom =
      (eqToIso (congrArg (localizedCechComplex k rank K T) ha)).hom ≫
        localizedCechVariableMap k rank K T a' b' j hab' := by
  subst a'
  subst b'
  simp









end LPCA


