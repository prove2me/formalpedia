section
set_option autoImplicit true
namespace StableVotingDistortion
open PctDistortion Set MeasureTheory

variable {V C : Type} [Fintype V] [Nonempty V] [Fintype C] [Nonempty C]

omit [Fintype V] [Nonempty V] [Nonempty C] in
private theorem block_mem (E : Election V C) {D : C → ℝ} (hD : D ∈ stdSimplex ℝ C)
    (v : V) (a : C) : 0 ≤ leftRank E D v a ∧ leftRank E D v a + D a ≤ 1 := by
  obtain ⟨e,he⟩ := exists_ballot E v
  rw [leftRank_eq_rankCut E D v e he]
  let w := fun i => D (e i)
  have htot : ∑ i, w i=1 := (e.sum_comp D).trans hD.2
  have hm (i : ℕ) := OptimalG.rankCut_mem_Icc w (fun i => hD.1 _) htot i
  have hr := (hm ((e.symm a).val+1)).2
  rw [OptimalG.rankCut_succ] at hr
  exact ⟨(hm _).1, by simpa [w] using hr⟩

theorem eq_30_31 (E : Election V C) {lam : ℝ} {ϕ : ℝ → ℝ} (hϕ : IsScoreFunction lam ϕ)
    {D : C → ℝ} (hD : IsGStable (gPhi ϕ) E D) :
    (∀ S : Finset C, voterMean (fun v => blockScore E D ϕ v S) = 0) ∧
      ∀ a : C, 0 ≤ voterMean (fun v => ϕ (sv E D a v)) := by
  classical
  obtain ⟨_,_,hg,_,_,hcenter⟩ := gPhi_properties hϕ
  let g := gPhi ϕ
  let M := 1+ϕ 0
  let T := ∫ r in (0:ℝ)..1, g r
  have hM : 0 < M := by dsimp [M]; linarith [hϕ.pos 0 ⟨le_rfl,hϕ.lam_mem.1⟩]
  let L := fun v a => leftRank E D v a
  have hmem (v : V) (a : C) : Icc (L v a) (L v a + D a) ⊆ Icc 0 1 :=
    Icc_subset_Icc (block_mem E hD.1 v a).1 (block_mem E hD.1 v a).2
  have hle (v : V) (a : C) : L v a ≤ L v a + D a := le_add_of_nonneg_right (hD.1.1 a)
  have hgi (v : V) (a : C) := (hg.continuousOn.mono (hmem v a)).intervalIntegrable_of_Icc (μ := volume) (hle v a)
  let B := fun v a => ∫ r in (L v a)..(L v a+D a), g r
  have hc (v : V) (a : C) : (∫ r in (L v a)..(L v a+D a), -ϕ r) = M*(B v a-D a*T) := by
    calc
      _ = ∫ r in (L v a)..(L v a+D a), M*(g r-T) := by
        apply intervalIntegral.integral_congr
        intro x hx
        rw [uIcc_of_le (hle v a)] at hx
        change -ϕ x = M*(g x-T)
        rw [hcenter x (hmem v a hx)]
        dsimp [M,T,g];ring
      _ = _ := by
        rw [intervalIntegral.integral_const_mul,intervalIntegral.integral_sub (hgi v a)
          (intervalIntegrable_const (c := T)),intervalIntegral.integral_const]
        simp [B,g,smul_eq_mul]
  let w := fun _ : V => (Fintype.card V : ℝ)⁻¹
  have wsum : ∑ v, w v=1 := by simp [w,Fintype.card_ne_zero]
  have wnon (v : V) : 0 ≤ w v := by dsimp [w]; positivity
  have mean (f : V → ℝ) : voterMean f = OptimalG.expectation w f := by simp [voterMean,OptimalG.expectation,w,Finset.mul_sum]
  have hstat (a : C) : OptimalG.expectation w (fun v => B v a) = D a*T := by
    rw [← mean]; simpa [B,L,T,g,mul_comm] using (proposition_3 hg E hD a).symm
  have bmean (a : C) : OptimalG.expectation w (fun v => M*(B v a-D a*T)) = 0 := by
    rw [OptimalG.expectation_smul]
    have sub (v : V) : B v a-D a*T = B v a + -(D a*T) := sub_eq_add_neg _ _
    simp_rw [sub]; rw [OptimalG.expectation_add,hstat,OptimalG.expectation_const wsum]
    ring
  constructor
  · intro S
    unfold blockScore
    change voterMean (fun v => ∑ a ∈ S, ∫ r in (L v a)..(L v a+D a), -ϕ r) = 0
    simp_rw [hc]
    rw [mean]
    unfold OptimalG.expectation
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_eq_zero (fun a _ => bmean a)
  · intro a
    have hgleft (v : V) : g (L v a) ≤ activation g E D v a := by
      unfold activation
      by_cases hd : D a=0
      · rw [if_pos hd]
      rw [if_neg hd]
      have hpos := lt_of_le_of_ne (hD.1.1 a) (Ne.symm hd)
      apply (le_inv_mul_iff₀ hpos).mpr
      have hi := intervalIntegral.integral_mono_on (hle v a)
        (intervalIntegrable_const (c := g (L v a))) (hgi v a) (fun x hx =>
          hg.monotoneOn (hmem v a ⟨le_rfl,hle v a⟩) (hmem v a hx) hx.1)
      simpa [intervalIntegral.integral_const,smul_eq_mul,L,g] using hi
    have hmean := (OptimalG.expectation_mono wnon (hgleft)).trans ((mean _).symm.trans_le (theorem_4 hg E hD a))
    have he (v : V) : ϕ (sv E D a v) = M*(T+(-1)*g (L v a)) := by
      have h := hcenter (L v a) (hmem v a ⟨le_rfl,hle v a⟩)
      simpa [sv,M,T,L,g,sub_eq_add_neg] using h
    simp_rw [he]; rw [mean,OptimalG.expectation_smul,OptimalG.expectation_add,
      OptimalG.expectation_const wsum,OptimalG.expectation_smul]
    exact mul_nonneg hM.le (by linarith)

end StableVotingDistortion
end

open PctDistortion
open StableVotingDistortion

theorem solution :
    ∀ {V C : Type} [Fintype V] [Nonempty V] [Fintype C] [Nonempty C] (E : Election V C)
    {lam : ℝ} {ϕ : ℝ → ℝ} (hϕ : IsScoreFunction lam ϕ) {D : C → ℝ} (hD : IsGStable (gPhi ϕ) E D),
    (∀ S : Finset C, voterMean (fun v => blockScore E D ϕ v S) = 0) ∧
      ∀ a : C, 0 ≤ voterMean (fun v => ϕ (sv E D a v)) :=
  @StableVotingDistortion.eq_30_31
