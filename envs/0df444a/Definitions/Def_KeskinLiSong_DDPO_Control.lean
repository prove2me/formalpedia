-- title:
--   History recursion, FIA, FINA and signed regret
-- statement:
--   Two independent infinite primitive sequences drive recursively generated observations and controls. Each policy has its own inventory trajectory. Feasible controls lie in the continuous boxes and satisfy y >= x. The expected reward includes ordering cost and terminal salvage. FIA means an admissible global expected-reward maximizer with interior decisions, as explicitly assumed on p. 9. FINA maximizes current true profit subject to its own stock constraint. Regret is the expected signed sum of Q differences, not their positive parts. Equation (6) is read with the link g from equations (1)–(2).
-- source:
--   Keskin, Li and Song (2022), Data-Driven Dynamic Pricing and Ordering with Perishable Inventory in a Changing Environment, Management Science, doi:10.1287/mnsc.2021.4011, supplied source.pdf (internally dated January 3, 2021; SSRN 3401188 footers), pp. 8–9 and 20, equations (3), (6), (7), (21)

import Definitions.Def_KeskinLiSong_DDPO_Model

open MeasureTheory ProbabilityTheory
open scoped ENNReal
noncomputable section

namespace KeskinLiSong.DDPO

abbrev Observation := ℝ × ℝ
abbrev Action := ℝ × ℝ
abbrev Policy := HistoryPolicy Observation Action
abbrev Paths (_T : ℕ) := (ℕ → ℝ) × (ℕ → ℝ)

def noiseSequenceLaw (noise : LocalMGF) : Measure (ℕ → ℝ) :=
  letI := noise.probability
  Measure.infinitePi (fun _ => noise.law)

def perishSequenceLaw (A : Model) {T : ℕ} (E : Environment A T) : Measure (ℕ → ℝ) :=
  letI : IsProbabilityMeasure (perishLaw E.xi) :=
    isProbabilityMeasureBeta
      (lt_of_lt_of_le A.perish_bounds.1 E.xi_mem.1.1)
      (lt_of_lt_of_le A.perish_bounds.2.2.1 E.xi_mem.2.1)
  Measure.infinitePi (fun _ => perishLaw E.xi)

def primitiveLaw (A : Model) {T : ℕ} (E : Environment A T) : Measure (Paths T) :=
  (noiseSequenceLaw A.noise).prod (perishSequenceLaw A E)

def innovation (z : (ℕ → ℝ) × (ℕ → ℝ)) (t : ℕ) : ℝ × ℝ := (z.1 t, z.2 t)

/-- Histories are generated by the actual policy, with periods numbered from one. -/
def history (A : Model) {T : ℕ} (E : Environment A T) (π : Policy)
    (z : Paths T) : ℕ → List (Observation × Action)
  | 0 => []
  | k + 1 =>
    let past := history A E π z k
    let a := π.action past.length past.get
    let shock := innovation z (k + 1)
    past ++ [((meanDemand A (E.theta (k + 1)) a.1 + shock.1, shock.2), a)]

def observed (A : Model) {T : ℕ} (E : Environment A T) (π : Policy)
    (z : Paths T) (t : ℕ) : Observation × Action :=
  ((history A E π z t)[t - 1]?).getD ((0, 0), (0, 0))

def actionAt (A : Model) {T : ℕ} (E : Environment A T) (π : Policy)
    (z : Paths T) (t : ℕ) : Action := (observed A E π z t).2

def stockAt (A : Model) {T : ℕ} (E : Environment A T) (π : Policy)
    (z : Paths T) (t : ℕ) : ℝ :=
  if t ≤ 1 then E.xinitial else
    let o := observed A E π z (t - 1)
    max ((1 - o.1.2) * o.2.2 - o.1.1) 0

def Feasible (A : Model) {T : ℕ} (E : Environment A T) (π : Policy) : Prop :=
  ∀ᵐ z ∂primitiveLaw A E, ∀ t ∈ Finset.Icc 1 T,
    actionAt A E π z t ∈ A.P ×ˢ A.Y ∧
      stockAt A E π z t ≤ (actionAt A E π z t).2

/-- Equation (3), including all ordering costs and terminal salvage. -/
def reward (A : Model) {T : ℕ} (E : Environment A T) (π : Policy)
    (z : Paths T) : ℝ :=
  (∑ t ∈ Finset.Icc 1 T,
    let o := observed A E π z t
    o.2.1 * min o.1.1 ((1 - o.1.2) * o.2.2) -
      A.h * max ((1 - o.1.2) * o.2.2 - o.1.1) 0 - A.w * o.1.2 * o.2.2 -
      A.b * max (o.1.1 - (1 - o.1.2) * o.2.2) 0 -
      A.c * (o.2.2 - stockAt A E π z t)) + A.c * stockAt A E π z (T + 1)

def Admissible (A : Model) {T : ℕ} (E : Environment A T) (π : Policy) : Prop :=
  Feasible A E π ∧ Integrable (reward A E π) (primitiveLaw A E)

def value (A : Model) {T : ℕ} (E : Environment A T) (π : Policy) : ℝ :=
  ∫ z, reward A E π z ∂primitiveLaw A E

/-- The source's explicit interior global optimum premise. The optimizing policy
may depend on the whole deterministic parameter sequence, never on future shocks. -/
def FIA (A : Model) {T : ℕ} (E : Environment A T) (π : Policy) : Prop :=
  Admissible A E π ∧
  (∀ other, Admissible A E other → value A E other ≤ value A E π) ∧
  ∀ᵐ z ∂primitiveLaw A E, ∀ t ∈ Finset.Icc 1 T,
    actionAt A E π z t ∈ Set.Ioo A.pmin A.pmax ×ˢ Set.Ioo A.ymin A.ymax

def HasFIA (A : Model) {T : ℕ} (E : Environment A T) : Prop := ∃ π, FIA A E π

/-- FINA uses its own stock trajectory, with the true current parameters. -/
def FINA (A : Model) {T : ℕ} (E : Environment A T) (π : Policy) : Prop :=
  Admissible A E π ∧ ∀ᵐ z ∂primitiveLaw A E, ∀ t ∈ Finset.Icc 1 T,
    Maximizes {a ∈ A.P ×ˢ A.Y | stockAt A E π z t ≤ a.2}
      (fun a => Q A A.noise.law (E.theta t) E.xi a.1 a.2) (actionAt A E π z t)

def regretSample (A : Model) {T : ℕ} (E : Environment A T)
    (benchmark learner : Policy) (z : Paths T) : ℝ :=
  ∑ t ∈ Finset.Icc 1 T,
    let a := actionAt A E benchmark z t
    let b := actionAt A E learner z t
    Q A A.noise.law (E.theta t) E.xi a.1 a.2 -
      Q A A.noise.law (E.theta t) E.xi b.1 b.2

def regret (A : Model) {T : ℕ} (E : Environment A T)
    (benchmark learner : Policy) : ℝ :=
  ∫ z, regretSample A E benchmark learner z ∂primitiveLaw A E

end KeskinLiSong.DDPO


