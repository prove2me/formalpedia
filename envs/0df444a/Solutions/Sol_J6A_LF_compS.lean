    bS (update G 44 v) a13 a14 a15 a30 a31 a32 a33 a43 a44 = bS G a13 a14 a15 a30 a31 a32 a33 a43 a44 := by
  funext x; by_cases hx : x = 44
  · subst hx; simp +decide [bS]
  · simp [bS, update_apply, hx]

theorem enc_base44 (s0 : IState HS) (F : Fin HS → List ℤ) (X : List ℤ) :
    encK s0 (update F 44 X) =
