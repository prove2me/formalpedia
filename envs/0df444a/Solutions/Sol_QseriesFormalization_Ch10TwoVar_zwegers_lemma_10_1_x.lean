/-- Congruence for `monom` in all four arguments. -/
theorem monom_eq_monom {a i j : ℤ} {c : ℚ} {a' i' j' : ℤ} {c' : ℚ}
    (ha : a = a') (hi : i = i') (hj : j = j') (hc : c = c') :
    monom a i j c = monom a' i' j' c' := by
  rw [ha, hi, hj, hc]

