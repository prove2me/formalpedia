    rw [kS_ne (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide), bCR]
  have kT : ∀ a b c d e f g h, kS B1 a b c d e f g h dTJ = body ++ [] := fun a b c d e f g h => by
