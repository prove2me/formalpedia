-- title:
--   Theorem 2.1, p. 8 — if D(P‖Q)/α = o(log n/n) with α bounded below, every algorithm has ℙ[β(π̂, π*) < α] → 1
-- statement:
--   For every $n$ let $G_A,G_B$ be generated by the correlated Erdős–Rényi model $(n,q_n,s_n)$ with $0\le q_n<s_n\le1$ and with $\pi^*$ drawn uniformly from the $n!$ permutations. Let $\alpha_n\in(0,1)$, possibly depending on $n$ but bounded below: there is $c>0$ with $\alpha_n\ge c$ for all large $n$. If
--   $$
--   \frac{D(P\|Q)}{\alpha_n}=o\Big(\frac{\log n}{n}\Big)\qquad(n\to\infty),
--   $$
--   with $P,Q$ the edge-pair laws (3)–(4) at $(q_n,s_n)$, then for any sequence of algorithms inferring $\hat\pi$ from $G_A$ and $G_B$,
--   $$
--   \mathbb P\big[\beta(\hat\pi,\pi^*)<\alpha_n\big]\;\longrightarrow\;1\qquad(n\to\infty).
--   $$
--   In other words, no learning algorithm can infer a permutation that overlaps with $\pi^*$ on more than a fraction $\alpha_n$ of the vertices with probability bounded away from zero.
--
--   This is the paper's impossibility result: it identifies a regime of the correlated Erdős–Rényi model in which even partial recovery of the planted alignment is information-theoretically impossible.
--
--   **Formalization Note** The page allows any $\alpha\in(0,1)$ "possibly dependent on $n$"; as printed the statement fails for $\alpha_n\to0$ fast (with $\alpha_n=1/n$, $q_n=n^{-3}$, $s=1/2$ the hypothesis holds but the identity algorithm succeeds with probability tending to $1-e^{-1}$). The hypothesis that $\alpha_n$ is eventually bounded below by a constant $c>0$ is added; a constant $\alpha$ is the special case. Algorithms are arbitrary stochastic kernels from the observed pair $(A,B)$ to permutations, one for each $n$, and see neither $\pi^*$ nor the hidden graph $G_{B'}$. The little-$o$ hypothesis is the convergence of $\big(D(P\|Q)/\alpha_n\big)/(\log n/n)$ to $0$; natural logarithm.
-- source:
--   Hall, Massoulié, Partial Recovery in the Graph Alignment Problem, arXiv:2007.00533v5, p. 8, Theorem 2.1 (proof pp. 10–13, §3)

import Mathlib
import Definitions.Def_GraphAlignment_Impossible_Setting

namespace GraphAlignment.Impossible

open Filter Topology

theorem theorem_2_1 (q s α : ℕ → ℝ)
    (hq : ∀ n, 0 ≤ q n) (hqs : ∀ n, q n < s n) (hs : ∀ n, s n ≤ 1)
    (hα : ∀ n, 0 < α n ∧ α n < 1) (hαc : ∃ c : ℝ, 0 < c ∧ ∀ᶠ n in atTop, c ≤ α n)
    (hD : Tendsto (fun n : ℕ => klPQ (q n) (s n) / α n / (Real.log n / n)) atTop (𝓝 0))
    (alg : ∀ n, Alg n) :
    Tendsto (fun n => failProb (q n) (s n) (α n) (alg n)) atTop (𝓝 1) := by sorry

end GraphAlignment.Impossible
