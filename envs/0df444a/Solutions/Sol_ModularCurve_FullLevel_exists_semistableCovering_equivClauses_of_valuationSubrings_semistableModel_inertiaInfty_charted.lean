private theorem _root_.AlgebraicCurve.ComponentChart.pointwiseOn_comap {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} (h : R.PointwiseOn Q D) :
    (C.comapRP σ).PointwiseOn Q (RegularProlongation.smulDisc σ⁻¹ D) := by
  intro P hP hPr f hf hreg
  have hmemD : ∀ P, P ∈ RegularProlongation.smulDisc σ⁻¹ D ↔ σ • P ∈ D := fun P => by
    rw [RegularProlongation.mem_smulDisc_iff, inv_inv]
  have h1 := (hmemD P).mp hP
  have hPr' : (σ • P).IsRational := (Place.Transport.isRational_smul_iff σ P).mpr hPr
  have hf' : σ f ∈ R.integers := (C.mem_comapRP_integers_iff R hint σ f).mp hf
  have hreg' : ∀ w ∈ D, σ f ∈ w.toValuationSubring := by
    intro w hw
    have hwσ : σ • (σ⁻¹ • w) ∈ D := by rw [smul_inv_smul]; exact hw
    exact (Place.Transport.mem_inv_smul_iff σ w f).mp (hreg (σ⁻¹ • w) ((hmemD _).mpr hwσ))
  obtain ⟨hm₀, h₀, e₀⟩ := h _ h1 hPr' (σ f) hf' hreg'
  have hresq : (C.comapRP σ).residue ⟨f, hf⟩ = R.residue ⟨σ f, hf'⟩ := C.comapRP_residue_eq R hint hres σ f hf
  have hev : (σ • P).evalAt (σ f) = P.evalAt f := Place.Transport.evalAt_smul σ P hPr f
  refine ⟨hresq ▸ hm₀, hev ▸ h₀, ?_⟩
  have hsub : (⟨P.evalAt f, hev ▸ h₀⟩ : A) = ⟨(σ • P).evalAt (σ f), h₀⟩ := Subtype.ext hev.symm
  rw [hsub, e₀]
  congr 1
  exact Subtype.ext hresq.symm

