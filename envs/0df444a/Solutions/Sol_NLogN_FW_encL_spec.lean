theorem gints_append (A B : List (ℤ × ℤ)) : gints (A ++ B) = gints A ++ gints B := by
  simp [gints, List.flatMap_append]

theorem gints_flatten_drop (Bl : List (List (ℤ × ℤ))) (k : ℕ) (hk : k < Bl.length) :
    gints (Bl.drop k).flatten = gints Bl[k] ++ gints (Bl.drop (k + 1)).flatten := by
  rw [flatten_drop_get Bl k hk, gints_append]

theorem encRes_canon (P r : ℕ) (blk : List (ℤ × ℤ)) :
    0 ≤ encRes P r blk ∧ encRes P r blk < 2 ^ (4 * r * P) + 1 := by
  have : (0 : ℤ) < 2 ^ (4 * r * P) + 1 := by positivity
  exact ⟨Int.emod_nonneg _ this.ne', Int.emod_lt_of_pos _ this⟩

theorem canon_zsz' {n : ℕ} {x : ℤ} (h0 : 0 ≤ x) (h1 : x < 2 ^ n + 1) : zsz x ≤ n + 1 :=
  canon_zsz (A := [x]) (fun y hy => by simp at hy; subst hy; exact ⟨h0, h1⟩) x (by simp)

end NLogN.FW

