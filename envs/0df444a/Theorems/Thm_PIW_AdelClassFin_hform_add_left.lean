open Formalism.UG
open scoped Matrix
variable {E : Type} [Field E] [StarRing E]

theorem PIW.AdelClassFin.hform_add_left {n : Type} [Fintype n] (J : Matrix n n E) (x x' y : n → E) :
    hform (starRingEnd E) J (x + x') y = hform (starRingEnd E) J x y + hform (starRingEnd E) J x' y := by sorry
