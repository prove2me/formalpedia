-- Source module: Solutions.ButterflyProp14
/-!
# §5.1/§5.3/Proposition 14, conditional on the Proposition 8 interface

The phase-frame network of Proposition 8 is taken as an explicit hypothesis `Prop8Iface W m s`:
for every column index type `κ`, a list of network steps acting on `W` roles, each role
holding a complex function of the `m·|κ|` selected bits of one group (`Fin m × κ`: slot `h`,
column `j`). A step is either a non-recursive linear step (binary row additions `P_M`, scalar
gates, source/sink/bank corrections — any matrix) or a child call on slot `h` of role `w`,
forward (`(C)^{⊗κ}`) or inverse (implemented by (17) as `(-i)^{|κ|} Z C^{⊗κ} Z`, one forward call).
The interface asserts: exactly `s` child steps, and with exact children the composite is
`C^{⊗(Fin m × κ)}` on every role (the "exact recursive contract" of §5.1).

From it we prove:
* `recOp_eq`: the recursive program (leaves = individual kernels (25)) computes `C^{⊗}` on
  `u·m^k` selected bits at every depth `k`, on every role including scratch roles.
* `recCost_le`: its cost obeys the §5.3 recurrence and is `≤ K₁ V ((u m^k)^λ + (u m^k)^σ u^{1-σ})`.
* `tens_blocks`, `embed_tens`: pieces on disjoint blocks of selected bits multiply to `C^{⊗D}`.
* `prop14_output`: the layer procedure `Q_p(b^D S_D C^{⊗D} S_D z)` equals `Q_p(H0^{⊗D} z)`, stays
  in the unit disk and is within `√2·2^{-p}` of `H0^{⊗D} z` in every coefficient.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open Matrix Finset Complex AModel

/-! ## The recursion -/

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

/-! ## Pieces on disjoint blocks of selected bits -/

/-! ## Proposition 14: the normalized layer from the C-layer -/

section Prop14

variable {P K D S ρ r : ℕ}

/-- **Proposition 14, output (conditional on the C-layer).** Let `Cimpl` be any implementation
of `C^{⊗D}` on the selected bits (by `recOp_eq` and `tens_blocks`/`embed_tens`, the recursive
program on the pieces is one). The procedure returns exactly `Q_p(H0^{⊗D} z)`; for disk inputs
every returned coefficient lies in the disk and differs from the exact layer by less than
`√2 · 2^{-p}`. -/
theorem prop14_output (hρ : ρ < K) (p : ℕ) (Cimpl : Op (Fin D)) (hC : Cimpl = tens Cm)
    (xs : List (Fin r → ℂ)) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c‖ ≤ 1) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length)
      (h' : j < (layerH P K D S ρ hρ xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c - (layerH P K D S ρ hρ xs)[j] c‖
        < Real.sqrt 2 * 2⁻¹ ^ p) := by
  have hout : prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) := by
    unfold prop14Proc; rw [hC, layerH_eq]; simp only [phaseLayer, cLayer]
  refine ⟨hout, ?_, ?_⟩
  · intro j h c
    rw [List.getElem_of_eq hout h]
    have hj : j < (layerH P K D S ρ hρ xs).length := by rw [hout] at h; simpa [QpArr] using h
    have hd := butterflyLayer_norm_le (layerSel P K D S ρ hρ) xs hxs j hj
    unfold QpArr; rw [List.getElem_map]
    exact (norm_Qp_le p _).trans ((norm_le_pi_norm _ c).trans hd)
  · intro j h h' c
    rw [List.getElem_of_eq hout h]
    unfold QpArr; rw [List.getElem_map]
    exact norm_Qp_sub_lt p _

end Prop14

end Butterfly

