theorem omL_rev {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
    (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) {C A B : Fin 4} {v : ℂ}
    (h : omL g gi E Θ C A B x = v) : omL g gi E Θ B A C x = -v := by
  rw [hN.omL_antisymm hx, h]

theorem omL_diag {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
    (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (C A : Fin 4) : omL g gi E Θ C A C x = 0 := by
  have h := hN.omL_antisymm hx C A C
  linear_combination h / 2

/-- `c^C_{AB} = Σ_K η_{CK} cL K A B` (`η⁻¹ = η`). -/
theorem cfr_eq_cL (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (C A B : Fin 4) (x : Pt 4) :
    cfr E Θ C A B x = ∑ K, etaNull C K * cL E Θ K A B x := by
  simp only [cL, Finset.mul_sum, ← mul_assoc]
  rw [Finset.sum_comm]
  simp only [← Finset.sum_mul, sum_etaNull_mul, Matrix.one_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq, Finset.mem_univ, if_true]

