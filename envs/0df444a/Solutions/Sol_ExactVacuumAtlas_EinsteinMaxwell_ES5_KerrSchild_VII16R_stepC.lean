/-- K0: value bound ⇒ value limit and slope limit. -/
theorem k0_slope {g : ℝ → ℝ} {c₀ c₁ C ε : ℝ} (hε : 0 < ε)
    (hb : ∀ x ∈ Ioo (0:ℝ) ε, |g x - (c₀ + c₁ * x)| ≤ C * x ^ 2) :
    Tendsto (fun x => (g x - c₀) / x) (𝓝[>] 0) (𝓝 c₁) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have hx : Tendsto (fun x : ℝ => C * x) (𝓝[>] 0) (𝓝 0) := by
    have := ((continuous_const_mul C).tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi 0))
    simpa using this
  refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_ hx
  filter_upwards [Ioo_mem_nhdsGT hε] with x hx
  have hx0 : 0 < x := hx.1
  have e : (g x - c₀) / x - c₁ = (g x - (c₀ + c₁ * x)) / x := by field_simp; ring
  rw [Real.norm_eq_abs, e, abs_div, abs_of_pos hx0, div_le_iff₀ hx0]
  nlinarith [hb x hx]

theorem k0_value {g : ℝ → ℝ} {c₀ c₁ C ε : ℝ} (hε : 0 < ε)
    (hb : ∀ x ∈ Ioo (0:ℝ) ε, |g x - (c₀ + c₁ * x)| ≤ C * x ^ 2) :
    Tendsto g (𝓝[>] 0) (𝓝 c₀) := by
  have hs := k0_slope hε hb
  have hid : Tendsto (fun x : ℝ => x) (𝓝[>] 0) (𝓝 0) := tendsto_id.mono_left nhdsWithin_le_nhds
  have h := tendsto_const_nhds (x := c₀) |>.add (hid.mul hs)
  rw [zero_mul, add_zero] at h
  refine h.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with x hx
  field_simp [hx.1.ne']; ring

/-- K2: if the derivative converges, value bound identifies the limit with the slope. -/
theorem k2_ident {g g' : ℝ → ℝ} {c₀ c₁ C ε L : ℝ} (hε : 0 < ε)
    (hd : ∀ x ∈ Ioo (0:ℝ) ε, HasDerivAt g (g' x) x)
    (hb : ∀ x ∈ Ioo (0:ℝ) ε, |g x - (c₀ + c₁ * x)| ≤ C * x ^ 2)
    (hl : Tendsto g' (𝓝[>] 0) (𝓝 L)) : L = c₁ := by
  have hv := k0_value hε hb
  have hnum : Tendsto (fun x => g x - c₀) (𝓝[>] 0) (𝓝 0) := by
    simpa using hv.sub_const c₀
  have hden : Tendsto (fun x : ℝ => x) (𝓝[>] 0) (𝓝 0) := tendsto_id.mono_left nhdsWithin_le_nhds
  have hL := HasDerivAt.lhopital_zero_right_on_Ioo hε
    (fun x hx => (hd x hx).sub_const c₀) (fun x _ => hasDerivAt_id x)
    (fun _ _ => one_ne_zero) hnum hden (by simpa using hl)
  exact tendsto_nhds_unique hL (k0_slope hε hb)

/-- K4: a continuous `q` on `(0, δ)` that never equals `−1` stays on one side of `−1`. -/
theorem k4_branch {q : ℝ → ℝ} {δ : ℝ} (hc : ContinuousOn q (Ioo 0 δ))
    (hne : ∀ x ∈ Ioo (0:ℝ) δ, q x ≠ -1) :
    (∀ x ∈ Ioo (0:ℝ) δ, -1 < q x) ∨ (∀ x ∈ Ioo (0:ℝ) δ, q x < -1) := by
  by_contra h
  push Not at h
  obtain ⟨⟨a, ha, hqa⟩, ⟨b, hb, hqb⟩⟩ := h
  have hqa' : q a < -1 := lt_of_le_of_ne hqa (hne a ha)
  have hqb' : -1 < q b := lt_of_le_of_ne hqb (fun e => hne b hb e.symm)
  obtain ⟨y, hy, hqy⟩ := isPreconnected_Ioo.intermediate_value ha hb hc ⟨hqa'.le, hqb'.le⟩
  exact hne y hy hqy

