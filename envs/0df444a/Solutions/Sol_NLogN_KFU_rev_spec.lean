theorem layA_cons (j : ℕ) (L : List ℕ) : layA bg (j :: L) = atm bg j ++ layA bg L := by
  simp [layA]

theorem layA_append (L M : List ℕ) : layA bg (L ++ M) = layA bg L ++ layA bg M := by
  simp [layA]

theorem mem_atm {j x : ℕ} : x ∈ atm bg j → x / 2 = j := by
  unfold atm; intro h; simp only [List.mem_cons] at h
  rcases h with rfl | h
  · omega
  · split_ifs at h <;> simp at h; omega

theorem mem_layA {L : List ℕ} {x : ℕ} (h : x ∈ layA bg L) : x / 2 ∈ L := by
  simp only [layA, List.mem_flatMap] at h
  obtain ⟨j, hj, hx⟩ := h
  rw [mem_atm bg hx]; exact hj

theorem nodup_layA : ∀ (L : List ℕ), L.Nodup → (layA bg L).Nodup
  | [], _ => by simp [layA]
  | j :: L, h => by
    rw [layA_cons, List.nodup_append]
    obtain ⟨hj, hL⟩ := List.nodup_cons.1 h
    refine ⟨?_, nodup_layA L hL, ?_⟩
    · unfold atm; split_ifs <;> simp
    · intro x hx y hy hxy; subst hxy
      have := mem_layA bg hy
      rw [mem_atm bg hx] at this
      exact hj this

theorem full_layA (L : List ℕ) : Full bg L (layA bg L) := by
  intro j hj
  simp only [layA, List.mem_flatMap]
  refine ⟨⟨j, hj, by simp [atm]⟩, fun hb => ⟨j, hj, by simp [atm, hb]⟩⟩

theorem vol_atm (j : ℕ) : AModel.vol ((atm bg j).map (asz mz)) = tz mz bg j := by
  unfold atm tz asz; split_ifs <;> simp [AModel.vol] <;> omega

theorem vol_layA : ∀ (L : List ℕ), AModel.vol ((layA bg L).map (asz mz)) = AModel.vol (L.map (tz mz bg))
  | [] => by simp [layA, AModel.vol]
  | j :: L => by
    rw [layA_cons, List.map_append, vol_append, vol_atm, vol_layA L]; simp

/-- **The merged digits of the standard layout.** -/
theorem enc_layA : ∀ (ax : List ℕ), ax.Nodup → (∀ j ∈ ax, 1 ≤ mz j) → ∀ b : List ℕ,
    AModel.Valid ((layA bg ax).map (asz mz)) b →
    AModel.Valid (ax.map (tz mz bg)) (ax.map (dig bg (layA bg ax) b)) ∧
      encode (ax.map (tz mz bg)) (ax.map (dig bg (layA bg ax) b)) =
        encode ((layA bg ax).map (asz mz)) b
  | [], _, _, b, hb => by
    have : b = [] := by have := hb.length_eq; simp [layA] at this; exact this
    subst this; simp [AModel.Valid, encode, layA]
  | j :: ax, hnd, hmz, b, hb => by
    obtain ⟨hj, hax⟩ := List.nodup_cons.1 hnd
    set k := (atm bg j).length
    rw [layA_cons, List.map_append] at hb
    have hlk : ((atm bg j).map (asz mz)).length = k := by simp [k]
    obtain ⟨hb1, hb2⟩ := (KIL.valid_append_iff (A := (atm bg j).map (asz mz))
      (C := (layA bg ax).map (asz mz)) (a := b.take k) (c := b.drop k)
      (by have := hb.length_eq; simp [k] at this ⊢; omega)).1 (by rw [List.take_append_drop]; exact hb)
    have IH := enc_layA ax hax (fun j' hj' => hmz j' (by simp [hj'])) (b.drop k) hb2
    -- the other digits
    have hrest : ax.map (dig bg (layA bg (j :: ax)) b) = ax.map (dig bg (layA bg ax) (b.drop k)) := by
      apply List.map_congr_left
      intro j' hj'
      have hne : j' ≠ j := fun h => hj (h ▸ hj')
      have n1 : 2 * j' ∉ atm bg j := fun h => hne (by have := mem_atm bg h; omega)
      have n2 : 2 * j' + 1 ∉ atm bg j := fun h => hne (by have := mem_atm bg h; omega)
      unfold dig
      rw [layA_cons, idxOf_append_of_notMem n1, idxOf_append_of_notMem n2, NLogN.KFU.getD_drop', NLogN.KFU.getD_drop']
    -- the first digit
    have hm : 1 ≤ mz j := hmz j (by simp)
    have hbl : b.length = k + (layA bg ax).length := by
      have := hb.length_eq; simp [k] at this ⊢; omega
    obtain ⟨-, hlt⟩ := (valid_iff _ _).1 hb1
    simp only [List.map_cons]
    rw [hrest, layA_cons]
    unfold AModel.Valid at IH ⊢
    have eb : encode ((atm bg j ++ layA bg ax).map (asz mz)) b =
        encode ((atm bg j).map (asz mz)) (b.take k) * AModel.vol ((layA bg ax).map (asz mz)) +
          encode ((layA bg ax).map (asz mz)) (b.drop k) := by
      conv_lhs => rw [List.map_append, ← List.take_append_drop k b]
      exact encode_append_len _ _ (by simp [k]; omega)
    rw [eb]
    simp only [encode, List.headD_cons, List.tail_cons]
    rw [IH.2, vol_layA]
    by_cases hbj : bg j = true
    · have hk : k = 2 := by simp [k, atm, hbj]
      have h0 := hlt 0 (by simp; omega) (by simp [atm, hbj])
      have h1 := hlt 1 (by simp; omega) (by simp [atm, hbj])
      simp only [List.getElem_take, List.getElem_map, atm, hbj, if_true, List.getElem_cons_zero,
        List.getElem_cons_succ, asz] at h0 h1
      have e0 : (2 * j) % 2 = 0 := by omega
      have e1 : (2 * j + 1) % 2 = 1 := by omega
      simp only [e0, if_true, show (2 * j) / 2 = j by omega, e1, show (1 : ℕ) ≠ 0 by omega,
        if_false] at h0 h1
      have d0 : dig bg (atm bg j ++ layA bg ax) b j = b[0]'(by omega) * 2 + b[1]'(by omega) := by
        unfold dig
        rw [if_pos hbj]
        have i0 : (atm bg j ++ layA bg ax).idxOf (2 * j) = 0 := by simp [atm]
        have i1 : (atm bg j ++ layA bg ax).idxOf (2 * j + 1) = 1 := by
          simp [atm, hbj, List.idxOf_cons_ne]
        rw [i0, i1, List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)]
      rw [d0]
      refine ⟨List.Forall₂.cons ?_ IH.1, ?_⟩
      · simp only [tz, hbj, if_true]; omega
      · have et : encode ((atm bg j).map (asz mz)) (b.take k) = b[0]'(by omega) * 2 + b[1]'(by omega) := by
          have : b.take k = [b[0]'(by omega), b[1]'(by omega)] := by
            rw [hk]; apply List.ext_getElem (by simp; omega)
            intro i h1 h2; simp at h2; interval_cases i <;> simp
          rw [this]
          simp [atm, hbj, encode, asz, AModel.vol, e1]
        rw [et]
    · have hbj' : bg j = false := by simpa using hbj
      have hk : k = 1 := by simp [k, atm, hbj']
      have h0 := hlt 0 (by simp; omega) (by simp [atm, hbj'])
      simp only [List.getElem_take, List.getElem_map, atm, hbj', List.getElem_cons_zero, asz] at h0
      have e0 : (2 * j) % 2 = 0 := by omega
      simp only [e0, if_true, show (2 * j) / 2 = j by omega] at h0
      have d0 : dig bg (atm bg j ++ layA bg ax) b j = b[0]'(by omega) := by
        unfold dig
        rw [if_neg hbj]
        have i0 : (atm bg j ++ layA bg ax).idxOf (2 * j) = 0 := by simp [atm]
        rw [i0, List.getD_eq_getElem _ _ (by omega)]
      rw [d0]
      refine ⟨List.Forall₂.cons ?_ IH.1, ?_⟩
      · simp only [tz, hbj']; simpa using h0
      · have et : encode ((atm bg j).map (asz mz)) (b.take k) = b[0]'(by omega) := by
          have : b.take k = [b[0]'(by omega)] := by
            rw [hk]; apply List.ext_getElem (by simp; omega)
            intro i h1 h2
            obtain rfl : i = 0 := by simp at h2; omega
            simp
          rw [this]
          simp [atm, hbj', encode, asz, AModel.vol]
        rw [et]

/-- **`Dl` in a standard layout is an ordinary pull.** -/
theorem Dl_layA {α : Type*} (ax0 ax : List ℕ) (hnd : ax.Nodup) (hmz : ∀ j ∈ ax, 1 ≤ mz j)
    (F : List ℕ → List ℕ) (hF : ∀ b, srcF bg ax0 (layA bg ax) b = F (ax.map (dig bg (layA bg ax) b)))
    (xs : List α) (d : α) :
    Dl mz bg ax0 (layA bg ax) xs d = AModel.pull (ax0.map (tz mz bg)) (ax.map (tz mz bg)) F d xs := by
  unfold Dl
  apply List.ext_getElem (by simp [vol_layA])
  intro j h1 h2
  simp only [length_pull] at h1
  have hv := valid_decode h1
  obtain ⟨hv1, he⟩ := enc_layA mz bg ax hnd hmz _ hv
  rw [encode_decode h1] at he
  have hd : decode (ax.map (tz mz bg)) j =
      ax.map (dig bg (layA bg ax) (decode ((layA bg ax).map (asz mz)) j)) := by
    conv_lhs => rw [← he]
    exact decode_encode hv1
  rw [getElem_pull, getElem_pull, hF, hd]

theorem Dl_rev {α : Type*} (L : List ℕ) (cid : ℕ) (hnd : (L ++ [cid]).Nodup)
    (hmz : ∀ j ∈ L ++ [cid], 1 ≤ mz j) (xs : List α) (d : α) :
    Dl mz bg (L ++ [cid]) (layA bg (L.reverse ++ [cid])) xs d =
      AModel.pull ((L ++ [cid]).map (tz mz bg)) ((L.reverse ++ [cid]).map (tz mz bg)) (revH L.length) d xs := by
  apply Dl_layA mz bg _ _ ?_ (fun j hj => hmz j (by simp at hj ⊢; tauto))
  · intro b
    simp only [srcF, List.map_append, List.map_reverse, revH, List.map_cons, List.map_nil]
    rw [List.take_append_of_le_length (by simp), List.take_of_length_le (by simp),
      List.drop_append_of_le_length (by simp), List.drop_of_length_le (by simp)]
    simp
  · rw [List.nodup_append] at hnd ⊢
    exact ⟨List.nodup_reverse.2 hnd.1, hnd.2.1, fun a ha b hb => hnd.2.2 a (List.mem_reverse.1 ha) b hb⟩

theorem Dl_self {α : Type*} (ax : List ℕ) (hnd : ax.Nodup) (hmz : ∀ j ∈ ax, 1 ≤ mz j) (xs : List α)
    (d : α) (hxs : xs.length = AModel.vol (ax.map (tz mz bg))) : Dl mz bg ax (layA bg ax) xs d = xs := by
  rw [Dl_layA mz bg ax ax hnd hmz id (fun b => rfl)]
  exact pull_id d hxs

end Std

