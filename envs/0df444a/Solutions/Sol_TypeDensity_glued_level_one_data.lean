    exact Finset.prod_congr rfl fun Q _ ↦ by cases Q <;> rfl
  have hterm (Q : TypeDensity.ClosedDirection k) (r : ℕ) : (g Q r).Monic ∧
      TypeDensity.directionDegree k Q * r = (g Q r).natDegree + (if Q = none then r else 0) := by
    cases Q with
    | none => simp [g, TypeDensity.directionDegree]
    | some phi =>
