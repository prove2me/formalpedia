    IRuns I iprog fromBitsU t (t.upd 0 (ints xs ++ R)) (2000 * cFrom xs.length w) :=
  (isim_fromBits xs.length w).runs (nw_fromBitsI _ _) (PV_πNW h1 h2) (fromBitsI_spec t xs w hxs R h0)

