-- ===== S4.Def_RP_EtPBC_A_CovAs5a =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As5a): lifting polynomials and memberships to a f.g. subalgebra

For a flat `A`-algebra `S` and an `A`-algebra `B`, with `tvC B C : C ⊗ B → S ⊗ B` and, for `C ≤ D`,
`tiC B h : C ⊗ B → D ⊗ B`:
* `exists_lift_polys`: finitely many polynomials over `S ⊗ B` come from one f.g. `C`;
* `exists_lift_monic`: a monic polynomial over `S ⊗ B` comes from a monic one over `C ⊗ B`;
* **`desc_mem`**: finitely many ideal memberships `x_k ∈ (g)` over `S ⊗ B` already hold over `C ⊗ B` for a f.g.
  `C ≥ C₀` (cofactors lifted by `exists_lift_polys`, the identities descended by `desc_mvPoly`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section Lift

variable {A : Type u} [CommRing A] {S : Type u} [CommRing S] [Algebra A S]

variable {B : Type u} [CommRing B] [Algebra A B]

theorem map_tvC_tiC {σ : Type*} {C D : Subalgebra A S} (h : C ≤ D) (y : MvPolynomial σ (C ⊗[A] B)) :
    MvPolynomial.map (tvC B D) (MvPolynomial.map (tiC B h) y) = MvPolynomial.map (tvC B C) y := by
  rw [MvPolynomial.map_map, show (tvC B D).comp (tiC B h) = tvC B C from RingHom.ext fun x => tvC_tiC h x]

end Lift

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs5b =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As5b): monic families and base change along `φ` at the level of `C`

* `exists_lift_monics`: finitely many monic polynomials over `S ⊗ B` come from monic ones over `C ⊗ B`, `C` f.g.
* `bcC φ C = id_C ⊗ φ : C ⊗ B → C ⊗ N`; `tvC_bcC`, `tiC_bcC` and their polynomial forms `map_tvC_bcC`,
  `map_tiC_bcC`: `bcC` commutes with `tvC` (to `S`) and with `tiC` (to a larger `D`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section LiftB

end LiftB

section BC

variable {A : Type u} [CommRing A] {S : Type u} [CommRing S] [Algebra A S]
  {B N : Type u} [CommRing B] [Algebra A B] [CommRing N] [Algebra A N] (φ : B →ₐ[A] N)

theorem map_tvC_bcC {σ : Type*} (C : Subalgebra A S) (y : MvPolynomial σ (C ⊗[A] B)) :
    MvPolynomial.map (tvC N C) (MvPolynomial.map (bcC φ C) y) =
      MvPolynomial.map (Algebra.TensorProduct.map (AlgHom.id A S) φ : S ⊗[A] B →+* S ⊗[A] N)
        (MvPolynomial.map (tvC B C) y) := by
  rw [MvPolynomial.map_map, MvPolynomial.map_map,
    show (tvC N C).comp (bcC φ C) = (Algebra.TensorProduct.map (AlgHom.id A S) φ : S ⊗[A] B →+* S ⊗[A] N).comp
      (tvC B C) from RingHom.ext fun x => tvC_bcC φ C x]

end BC

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs5c =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As5c): one chart descends to a f.g. subalgebra

**`desc_chart`**: if a square system `gC` over `C₀ ⊗ B` becomes etale-and-finite presented over `S ⊗ B` (witnesses
`hJ`, `hF` for `gmap (tvC B C₀) gC`), then the witnesses already exist over `C ⊗ B` for a f.g. `C ≥ C₀` (for the
system `gmap (tiC B h) gC`). Helpers `gmap_tvC_tiC`, `gmap_tiC_tiC`, `polymap_tvC_tiC`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section Chart

variable {A : Type u} [CommRing A] {S : Type u} [CommRing S] [Algebra A S]
  {B : Type u} [CommRing B] [Algebra A B]

theorem polymap_tvC_tiC {C D : Subalgebra A S} (h : C ≤ D) (q : Polynomial (C ⊗[A] B)) :
    (q.map (tiC B h)).map (tvC B D) = q.map (tvC B C) := by
  rw [Polynomial.map_map, show (tvC B D).comp (tiC B h) = tvC B C from RingHom.ext fun x => tvC_tiC h x]

end Chart

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs6a =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As6a): pushing the descended package along `σ : C →ₐ[A] R'`

`tsC σ B = σ ⊗ id_B : C ⊗ B → R' ⊗ B`; `tsC_bcC`, `map_tsC_bcC`, `gmap_tsC_bcC`: `tsC` commutes with base change
along `φ` (`bcC φ C` over `C`, `bcS R' φ` over `R'`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section TsC

end TsC

section TsCBC

variable {A : Type u} [CommRing A] {S : Type u} [CommRing S] [Algebra A S] {R' : Type u} [CommRing R']
  [Algebra A R'] {B N : Type u} [CommRing B] [Algebra A B] [CommRing N] [Algebra A N] (φ : B →ₐ[A] N)

theorem map_tsC_bcC {ι : Type*} {C : Subalgebra A S} (σ : C →ₐ[A] R') (y : MvPolynomial ι (C ⊗[A] B)) :
    MvPolynomial.map (tsC σ N) (MvPolynomial.map (bcC φ C) y) =
      MvPolynomial.map (bcS R' φ) (MvPolynomial.map (tsC σ B) y) := by
  rw [MvPolynomial.map_map, MvPolynomial.map_map,
    show (tsC σ N).comp (bcC φ C) = (bcS R' φ).comp (tsC σ B) from RingHom.ext fun x => tsC_bcC φ σ x]

end TsCBC

end RamanujanPetersson.EtPBC.Cov

end

