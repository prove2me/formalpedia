  rw [hx] at Hc
  have e3 : swapPos ([P] : Shape).length (([P] : Shape).length + 1 + ([Mid] : Shape).length) =
      swapPos 1 3 := rfl
  rw [e3, sw_flR hP hMid hS (by positivity : 0 < 2 ^ u) hB hlen] at Hc
  exact Hc

