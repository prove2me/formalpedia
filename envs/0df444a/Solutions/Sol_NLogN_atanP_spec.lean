    simp (config := {decide := true}) [RS.ok, Ex.ok, Ex.Clean, Ex.regs, IState.IsInt, IState.top, this]
  · refine ⟨by decide, by decide, ?_, ?_, hw, ?_⟩
    · show t0.IsInt 1
