-- Source module: Solutions.R6IL3Lev1
/-!
# Round six, item language (I3): the level claim and its side conditions

* `VbH`: the size budget of a level (monotone, `VbH_mono`);
* `CfgOK c`: the configuration conditions (network shape, the `p`-moment of the child widths,
  the scale constant `Aw` large against the local scale `cLH` and the local widths);
* `CBRec`: the cost recursion the coefficients `CB E` must satisfy;
* **`LvH`**: the level claim on `E` bits (scale `Gs E`, width `(W' + 4) Gs E`, cost
  `⌊CB E · n Y⌋`);
* side lemmas: `het_sub`, `dvd_child`, `Gs_node_split`, **`width_node`** (the width recursion),
  `tens_fin0`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The size budget of a level. -/
noncomputable def VbH (c : Cfg) (K t S0 r H E e B : ℕ) : ℕ :=
  c.Aw * (E + 1) ^ c.p + (E + 1) ^ c.p + 8 * E + 4 * c.m + cLH c + B + c.W + S0 + r + K +
    S0 * r + K * E + e + t + H + 18 * (c.Wr * (B * 2 ^ t * S0 * r)) + 16

/-- **The configuration conditions.** -/
structure CfgOK (c : Cfg) : Prop where
  net : NetOK c
  m1 : 1 ≤ c.m
  W1 : 1 ≤ c.W
  Aw1 : 1 ≤ c.Aw
  p1 : 1 ≤ c.p
  mom : 2 * ((chWs c).map fun s => (2 * s + 1) ^ c.p).sum ≤ (2 * c.m) ^ c.p
  Ac : 2 * cLH c + 1 ≤ c.Aw
  Aw : c.net.length * dwloc c.Wr c.A + 2 * c.Wr * (chWs c).length + 4 ≤ 2 * c.Aw

/-- **The cost recursion.** -/
structure CBRec (c : Cfg) (aK : ℕ → ℝ) (τ : ℝ) (K : ℕ) (CB : ℕ → ℝ) : Prop where
  nonneg : ∀ E, 0 ≤ CB E
  zero : 4 ≤ CB 0
  chain : ∀ E, 1 ≤ E → E < 2 * c.m → CB (E - 1) + 10 ^ 14 ≤ CB E
  node : ∀ E, 2 * c.m ≤ E →
    ((chWs c).map fun s => CB (s * (E / c.m))).sum + (c.W : ℝ) * CB (E % c.m) +
      (c.Wr : ℝ) * ((c.net.length : ℝ) * ((MH c : ℝ) + 18 * aK K *
        (((E / c.m : ℕ) : ℝ) + 1) ^ τ) + (CnN c : ℝ) + 10 ^ 12) ≤ (c.W : ℝ) * CB E

/-- **The level claim.** -/
def LvH (c : Cfg) {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (jL : Fin Pp)
    (rowC : IStmt HS Pp) (K r Z Zr H G : ℕ) (CB : ℕ → ℝ) (E : ℕ) : Prop :=
  ∀ (σ : Fin HS → Option ℤ) (t S0 e B : ℕ), LevRH c σ K t S0 r H E e B → σ vG = some (G : ℤ) →
    1 ≤ S0 → 1 ≤ B →
    c.W ^ dep c.m E * 2 ^ (2 * ((E / c.m - 1) * G)) ∣ B → 2 ^ ((E / c.m - 1) * G) ∣ S0 →
    K * (E - 1) ≤ e → e - e % K + K ≤ t →
    zsz ((16 * (c.Wr * (B * 2 ^ t * S0 * r)) : ℕ) : ℤ) ≤ Z →
    zsz ((VbH c K t S0 r H E e B : ℕ) : ℤ) ≤ Zr → c.G E ≤ H →
    SImplQ Isym tbl (fun s => Agree σ s) 0 H r (fun i : Fin E => 2 ^ (e - K * i.val) * S0)
      (nN B t S0) (tens Cm) (levCH c jL rowC) (c.G E) ((c.Wr + 4) * c.G E)
      (fun _ => ⌊CB E * ((nN B t S0 * Yu r Zr H : ℕ) : ℝ)⌋₊)

/-! ## Side lemmas -/

end IntMul.Kappa.R6.IL3H

end

