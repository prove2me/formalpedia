namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

instance decLS_F (i : Fin HS) : Decidable (LS i) := by unfold LS; infer_instance

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The uniform `Φ`. -/
def phiFU (pM eSw : Fin P) (sdS Dsc : Fin HS) : IStmt HS P :=
  .seq (RS.seq (readD oSP oML) mkL).code
  (.seq (padAllU pM pSK pTK)
  (.seq (RS.pop nR).code
  (.seq (revU pM pTR eSw sdS Dsc)
  (.seq (RS.seq (.push pTR (.lit 2)) (.push nR nD1)).code
  (.seq (unpadAllU pM pSR pTR)
  (.seq rotsFU
  (.seq (padAllU pM pSR pTR) cleanF.code)))))))

/-- The cost of `phiFU`. -/
noncomputable def cFwd (K : ℝ) (w h d : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (B Z Br Bb : ℕ) : ℕ :=
  cRead d B + cMk d B + 3 * ((d + 2) * (2000 * cScan (vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL))) w + 25 * cU Z)) +
    (2 * B + 2) + cRevU K h w 2 1 d Z (vol (shP h (bsL d bL).reverse)) + 6 * 10 ^ 7 * (B + 2) ^ 2 +
    (d + 1) * (cStepU d (vol ((List.range (d - 1)).map sF)) (vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF))) w Br Bb + 3000) +
    cClean d B

end Gen

end NLogN.KFUU

