    (acL neg sF μ Q i).reverse.map (fun p => (p.2 : ℤ)) =
      ((List.range i).map fun j => (cF neg sF μ Q j : ℤ)).reverse := by
  rw [List.map_reverse]
  congr 1
  have := congrArg (List.map (fun n : ℕ => (n : ℤ))) (acL_snd neg sF μ Q i)
  simpa [List.map_map, Function.comp_def] using this

theorem acL_map_fst (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) :
    (acL neg sF μ Q i).map (fun p => (p.1 : ℤ)) = (List.range i).map fun j => (sF j : ℤ) := by
  have := congrArg (List.map (fun n : ℕ => (n : ℤ))) (acL_fst neg sF μ Q i)
  simpa [List.map_map, Function.comp_def] using this

theorem acL_map_snd (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) :
    (acL neg sF μ Q i).map (fun p => (p.2 : ℤ)) = (List.range i).map fun j => (cF neg sF μ Q j : ℤ) := by
  have := congrArg (List.map (fun n : ℕ => (n : ℤ))) (acL_snd neg sF μ Q i)
  simpa [List.map_map, Function.comp_def] using this

theorem acL_drop_fst (neg : Bool) (sF : ℕ → ℕ) (μ Q i m : ℕ) :
    ((acL neg sF μ Q i).drop m).map Prod.fst = ((List.range i).map sF).drop m := by
  rw [List.map_drop, acL_fst]

theorem acL_stgM (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) (hs : ∀ j < i, 1 ≤ sF j) :
    stgM (acL neg sF μ Q i).reverse [] =
      ((List.range i).map fun j => ((Pv sF i / Pv sF (j + 1) : ℕ) : ℤ)).reverse := by
  rw [stgM_rev, length_acL]
  congr 1
  refine List.map_congr_left fun j hj => ?_
  rw [List.append_nil, acL_drop_fst, vol_drop_range sF hs _ (by simp at hj; omega)]

theorem acL_stgAM (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) (hs : ∀ j < i, 1 ≤ sF j) :
    stgAM (acL neg sF μ Q i).reverse [] =
      ((List.range i).map fun j => ((Pv sF i / Pv sF j : ℕ) : ℤ)).reverse := by
  rw [stgAM_rev, length_acL]
  congr 1
  refine List.map_congr_left fun j hj => ?_
  rw [List.append_nil, acL_drop_fst, vol_drop_range sF hs _ (by simp at hj; omega)]

theorem vol_acL (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) :
    vol ((acL neg sF μ Q i).reverse.map Prod.fst) = Pv sF i := by
  rw [List.map_reverse, vol_reverse, acL_fst]; rfl

end NLogN.KFUU

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KFUU
open IntMul KIL AModel
set_option maxHeartbeats 8000000
theorem solution (neg : Bool) (sF : ℕ → ℕ) (μ Q i Bv : ℕ)
    (hs : ∀ j < i, 1 ≤ sF j) (hQ1 : 1 ≤ Q) (hμ : μ < Q) (B Bb : ℕ)
    (hB : NLogN.zsz ((Q * NLogN.KFUU.Pv sF i : ℕ) : ℤ) ≤ B) (hiB : NLogN.zsz (i : ℤ) ≤ B) (hBvB : NLogN.zsz (Bv : ℤ) ≤ B)
    (hBb : NLogN.zsz ((2 * (Q * NLogN.KFUU.Pv sF i)) : ℕ) ≤ Bb)
    (s : NLogN.IState NLogN.HS) {LQ LM LP LI LB : List NLogN.Item}
    (hQ : s.G NLogN.KFUU.oQ = .int Q :: LQ) (hMu : s.G NLogN.KFUU.oMu = .int μ :: LM)
    (hPi : s.G NLogN.KFUU.oPi = .int (NLogN.KFUU.Pv sF i) :: LP) (hI : s.G NLogN.KFUU.oI = .int i :: LI)
    (hBv : s.G NLogN.KFUU.oBv = .int Bv :: LB) :
    NLogN.KIL.Sp (NLogN.KFUU.tabU neg)
      (NLogN.KIL.encK s (Function.update (fun _ => []) NLogN.KFUU.oSP ((List.range i).map fun j => (sF j : ℤ)).reverse))
      (NLogN.KIL.encK s (NLogN.KFUU.tabEnd neg sF μ Q i (NLogN.KFUU.Pv sF i) Bv)) (NLogN.KFUU.cTab i (NLogN.KFUU.Pv sF i) B Bb) := by
  set aL := (List.range i).map fun j => (sF j : ℤ) with haL
  set f0 : Fin NLogN.HS → List ℤ := Function.update (fun _ => []) NLogN.KFUU.oSP aL.reverse with hf0
  have hPi1 := NLogN.KFUU.Pv_pos sF hs i le_rfl
  have hPiQ : NLogN.KFUU.Pv sF i ≤ Q * NLogN.KFUU.Pv sF i := Nat.le_mul_of_pos_left _ hQ1
  have hQQ : Q ≤ Q * NLogN.KFUU.Pv sF i := Nat.le_mul_of_pos_right _ hPi1
  have zPi : NLogN.zsz ((NLogN.KFUU.Pv sF i : ℕ) : ℤ) ≤ B := NLogN.KFUU.zB hPiQ hB
  have zQ : NLogN.zsz ((Q : ℕ) : ℤ) ≤ B := NLogN.KFUU.zB hQQ hB
  have hB1 : 1 ≤ B := by
    have h := NLogN.zsz_natCast_le' hQ1; rw [Nat.cast_one, NLogN.zsz_one] at h; omega
  -- 1. P := 1
  have S1 := NLogN.KIL.Sp.pushQ s f0 (i := NLogN.KFUU.oPr) (e := .lit 1) (B := B) (by decide) (NLogN.KIL.clean_lit _) trivial
    (by simp only [NLogN.Ex.Bnd]; rw [NLogN.zsz_one]; exact hB1)
  simp only [NLogN.Ex.eval] at S1
  set f1 := Function.update f0 NLogN.KFUU.oPr ((1 : ℤ) :: f0 NLogN.KFUU.oPr) with hf1
  -- 2. reverse the sizes onto oSQ
  have hf1I : f1 NLogN.KFUU.oI = [] := by simp +decide [f1, f0, Function.update_apply]
  have hbL : NLogN.Bnd B aL.reverse := by
    intro a ha
    simp only [aL, List.mem_reverse, List.mem_map, List.mem_range] at ha
    obtain ⟨j, hj, rfl⟩ := ha
    exact NLogN.KFUU.zB (le_trans (NLogN.KFUU.sF_le_Pv sF hs hj) hPiQ) hB
  have S2 := NLogN.KIL.Sp.mvK (X := NLogN.KFUU.oSP) (Y := NLogN.KFUU.oSQ) (C := NLogN.KFUU.oCM) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s f1 (.reg NLogN.KFUU.oI) (NLogN.KIL.clean_reg (by decide)) (NLogN.KFUU.ok_regS hf1I hI) aL.reverse []
    (by simp +decide [f1, f0, Function.update_apply]) (by rw [NLogN.KFUU.eval_regS hf1I hI]; simp [aL]) B hbL
    trivial (by simp only [NLogN.Ex.Bnd, NLogN.KFUU.top_regS hf1I hI]; exact hiB)
  -- 3. coefficients
  have e3 : Function.update (Function.update f1 NLogN.KFUU.oSP []) NLogN.KFUU.oSQ (aL.reverse.reverse ++ f1 NLogN.KFUU.oSQ) =
      NLogN.KFUU.cfF (fun _ => []) neg sF μ Q i 0 := by
    funext j
    by_cases j1 : j = NLogN.KFUU.oSQ
    · subst j1; simp +decide [f1, f0, NLogN.KFUU.cfF, Function.update_apply, aL]
    by_cases j2 : j = NLogN.KFUU.oSP
    · subst j2; simp +decide [f1, f0, NLogN.KFUU.cfF, Function.update_apply]
    by_cases j3 : j = NLogN.KFUU.oPr
    · subst j3; simp +decide [f1, f0, NLogN.KFUU.cfF, Function.update_apply, NLogN.KFUU.Pv, AModel.vol]
    simp [f1, f0, NLogN.KFUU.cfF, Function.update_apply, j1, j2, j3]
  rw [e3] at S2
  have S3 := NLogN.KFUU.coefL_sp neg sF μ Q i hs hQ1 hμ B hB hiB s (fun _ => []) rfl rfl rfl rfl rfl hQ hMu hPi hI
  -- 4. drop P
  have S4 := NLogN.KIL.Sp.pop s (NLogN.KFUU.cfF (fun _ => []) neg sF μ Q i i) (i := NLogN.KFUU.oPr) (a := (NLogN.KFUU.Pv sF i : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [NLogN.KFUU.cfF, Function.update_apply]) zPi
  set f4 := Function.update (NLogN.KFUU.cfF (fun _ => []) neg sF μ Q i i) NLogN.KFUU.oPr [] with hf4
  have hf4Q : f4 NLogN.KFUU.oQ = [] := by simp +decide [f4, NLogN.KFUU.cfF, Function.update_apply]
  -- 5. -Q
  have S5 := NLogN.KIL.Sp.pushQ s f4 (i := NLogN.KIL.sNQ) (e := .neg (.reg NLogN.KFUU.oQ)) (B := B) (by decide)
    (NLogN.KIL.clean_neg (NLogN.KIL.clean_reg (by decide))) (NLogN.KFUU.ok_regS hf4Q hQ)
    (by simp only [NLogN.Ex.Bnd, NLogN.KFUU.top_regS hf4Q hQ]; exact zQ)
  simp only [NLogN.Ex.eval, NLogN.KFUU.top_regS hf4Q hQ] at S5
  set f5 := Function.update f4 NLogN.KIL.sNQ (-(Q : ℤ) :: f4 NLogN.KIL.sNQ) with hf5
  -- 6. table seed
  have S6 := NLogN.KIL.Sp.pushQ s f5 (i := 14) (e := .lit 0) (B := B) (by decide) (NLogN.KIL.clean_lit _) trivial
    (by simp only [NLogN.Ex.Bnd, NLogN.zsz_zero]; omega)
  simp only [NLogN.Ex.eval] at S6
  set f6 := Function.update f5 14 ((0 : ℤ) :: f5 14) with hf6
  -- 7. stages
  set rv := (NLogN.KFUU.acL neg sF μ Q i).reverse with hrv
  set g := Function.update (Function.update (fun _ => []) NLogN.KFUU.oSP aL.reverse) NLogN.KIL.sNQ [-(Q : ℤ)] with hg
  have e7 : f6 = NLogN.KFUU.stF g rv Q 0 := by
    funext j
    by_cases j1 : j = 14
    · subst j1; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, NLogN.KIL.tbl]
    by_cases j2 : j = NLogN.KIL.sSA
    · subst j2; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, rv, NLogN.KFUU.acL_rev_fst, aL, NLogN.KFUU.acL_map_fst]
    by_cases j3 : j = NLogN.KIL.sSC
    · subst j3; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, rv, NLogN.KFUU.acL_rev_snd, NLogN.KFUU.acL_map_snd]
    by_cases j4 : j = NLogN.KIL.sSM
    · subst j4; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, rv, NLogN.KFUU.acL_stgM neg sF μ Q i hs]
    by_cases j5 : j = NLogN.KIL.sSAM
    · subst j5; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, rv, NLogN.KFUU.acL_stgAM neg sF μ Q i hs]
    by_cases j6 : j = NLogN.KIL.sNQ
    · subst j6; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, g]
    by_cases j7 : j = NLogN.KFUU.oSP
    · subst j7; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, g, aL]
    by_cases j8 : j = NLogN.KFUU.oPr
    · subst j8; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, g]
    by_cases j9 : j = NLogN.KFUU.oSQ
    · subst j9; simp +decide [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, g, aL]
    simp [f6, f5, f4, NLogN.KFUU.stF, NLogN.KFUU.cfF, Function.update_apply, g, j1, j2, j3, j4, j5, j6, j7, j8, j9]
  rw [e7] at S6
  have hrvp : ∀ p ∈ rv, 1 ≤ p.1 ∧ p.2 < Q := by
    intro p hp
    have hp' : p ∈ NLogN.KFUU.acL neg sF μ Q i := List.mem_reverse.1 hp
    have h1 : p.1 ∈ (List.range i).map sF := NLogN.KFUU.acL_fst neg sF μ Q i ▸ List.mem_map_of_mem hp'
    have h2 : p.2 ∈ (List.range i).map (NLogN.KFUU.cF neg sF μ Q) := NLogN.KFUU.acL_snd neg sF μ Q i ▸ List.mem_map_of_mem hp'
    simp only [List.mem_map, List.mem_range] at h1 h2
    obtain ⟨j, hj, e⟩ := h1
    obtain ⟨j', hj', e'⟩ := h2
    exact ⟨e ▸ hs j hj, e' ▸ NLogN.KFUU.cF_lt neg sF hQ1 j'⟩
  have hrvl : rv.length = i := by simp [rv, NLogN.KFUU.length_acL]
  have S7 := NLogN.KFUU.stgL_sp Q Bb hQ1 rv hrvp (by rw [NLogN.KFUU.vol_acL]; exact hBb) B (by rw [hrvl]; exact hiB) s g
    (by simp +decide [g, Function.update_apply]) (by simp +decide [g, Function.update_apply])
    (by simp +decide [g, Function.update_apply]) (LI := LI) (by rw [hrvl]; exact hI)
  rw [hrvl, NLogN.KFUU.vol_acL] at S7
  set f7 := NLogN.KFUU.stF g rv Q i with hf7
  have h7P : f7 NLogN.KFUU.oPi = [] := by simp +decide [f7, g, NLogN.KFUU.stF, Function.update_apply]
  have h7Q : f7 NLogN.KFUU.oQ = [] := by simp +decide [f7, g, NLogN.KFUU.stF, Function.update_apply]
  have h7B : f7 NLogN.KFUU.oBv = [] := by simp +decide [f7, g, NLogN.KFUU.stF, Function.update_apply]
  -- 8–10. parameters
  have S8 := NLogN.KIL.Sp.pushQ s f7 (i := 1) (e := .reg NLogN.KFUU.oPi) (B := B) (by decide) (NLogN.KIL.clean_reg (by decide))
    (NLogN.KFUU.ok_regS h7P hPi) (by simp only [NLogN.Ex.Bnd, NLogN.KFUU.top_regS h7P hPi]; exact zPi)
  simp only [NLogN.Ex.eval, NLogN.KFUU.top_regS h7P hPi] at S8
  set f8 := Function.update f7 1 ((NLogN.KFUU.Pv sF i : ℤ) :: f7 1) with hf8
  have h8Q : f8 NLogN.KFUU.oQ = [] := by simp +decide [f8, h7Q, Function.update_apply]
  have S9 := NLogN.KIL.Sp.pushQ s f8 (i := 2) (e := .reg NLogN.KFUU.oQ) (B := B) (by decide) (NLogN.KIL.clean_reg (by decide))
    (NLogN.KFUU.ok_regS h8Q hQ) (by simp only [NLogN.Ex.Bnd, NLogN.KFUU.top_regS h8Q hQ]; exact zQ)
  simp only [NLogN.Ex.eval, NLogN.KFUU.top_regS h8Q hQ] at S9
  set f9 := Function.update f8 2 ((Q : ℤ) :: f8 2) with hf9
  have h9B : f9 NLogN.KFUU.oBv = [] := by simp +decide [f9, f8, h7B, Function.update_apply]
  have S10 := NLogN.KIL.Sp.pushQ s f9 (i := 4) (e := .reg NLogN.KFUU.oBv) (B := B) (by decide) (NLogN.KIL.clean_reg (by decide))
    (NLogN.KFUU.ok_regS h9B hBv) (by simp only [NLogN.Ex.Bnd, NLogN.KFUU.top_regS h9B hBv]; exact hBvB)
  simp only [NLogN.Ex.eval, NLogN.KFUU.top_regS h9B hBv] at S10
  refine ((S1.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (S7.seq (S8.seq (S9.seq S10)))))))))).mono
    ?_ |>.congr ?_
  · simp only [NLogN.Ex.size, NLogN.KFUU.cTab]
    clear S1 S2 S3 S4 S5 S6 S7 S8 S9 S10 e3 e7
    have hX : B + 2 ≤ (B + 2) ^ 2 := by nlinarith
    have hY : 1 ≤ (NLogN.KFUU.Pv sF i + 1) * (Bb + 2) := Nat.one_le_iff_ne_zero.2 (by positivity)
    have hl : aL.reverse.length = i := by simp [aL]
    rw [hl]
    have e1 : 10 ^ 8 * (NLogN.KFUU.Pv sF i + 1) * (Bb + 2) = 10 ^ 8 * ((NLogN.KFUU.Pv sF i + 1) * (Bb + 2)) := by ring
    have e2 : 10 ^ 10 * (i + 1) * ((B + 2) ^ 2 + (NLogN.KFUU.Pv sF i + 1) * (Bb + 2)) =
        10 ^ 10 * ((B + 2) ^ 2 + (NLogN.KFUU.Pv sF i + 1) * (Bb + 2)) +
        10 ^ 10 * (i * (B + 2) ^ 2) + 10 ^ 10 * (i * ((NLogN.KFUU.Pv sF i + 1) * (Bb + 2))) := by ring
    have e3 : i * (10 ^ 9 * (B + 2) ^ 2 + 8000 * (B + 2) + 30) =
        10 ^ 9 * (i * (B + 2) ^ 2) + 8000 * (i * (B + 2)) + 30 * i := by ring
    have e4 : i * (10 ^ 8 * ((NLogN.KFUU.Pv sF i + 1) * (Bb + 2)) + 8000 * (B + 2) + 30) =
        10 ^ 8 * (i * ((NLogN.KFUU.Pv sF i + 1) * (Bb + 2))) + 8000 * (i * (B + 2)) + 30 * i := by ring
    have e5 : i * (14000 * (B + 2)) = 14000 * (i * (B + 2)) := by ring
    have h6 : i * (B + 2) ≤ i * (B + 2) ^ 2 := Nat.mul_le_mul_left _ hX
    have h7 : i ≤ i * (B + 2) := Nat.le_mul_of_pos_right _ (by omega)
    rw [e1, e4] at *
    rw [e2, e3, e5]
    generalize (B + 2) ^ 2 = X at *
    generalize (NLogN.KFUU.Pv sF i + 1) * (Bb + 2) = Y at *
    generalize i * X = iX at *
    generalize i * Y = iY at *
    generalize i * (B + 2) = iB at *
    omega
  · congr 1
    funext j
    have hT : NLogN.KIL.tbl Q (rv.take i).reverse = NLogN.KIL.tbl Q (NLogN.KFUU.acL neg sF μ Q i) := by
      rw [List.take_of_length_le (by omega), hrv, List.reverse_reverse]
    by_cases j1 : j = 14
    · subst j1; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, hT, g]
    by_cases j2 : j = NLogN.KIL.sSA
    · subst j2; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, ← hrvl, g]
    by_cases j3 : j = NLogN.KIL.sSC
    · subst j3; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, ← hrvl, g]
    by_cases j4 : j = NLogN.KIL.sSM
    · subst j4; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, ← hrvl, g, NLogN.KIL.stgM]
    by_cases j5 : j = NLogN.KIL.sSAM
    · subst j5; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, ← hrvl, g, NLogN.KIL.stgAM]
    by_cases j6 : j = 1
    · subst j6; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g]
    by_cases j7 : j = 2
    · subst j7; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g]
    by_cases j8 : j = 4
    · subst j8; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g]
    by_cases j9 : j = NLogN.KIL.sNQ
    · subst j9; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g]
    by_cases j10 : j = NLogN.KFUU.oSP
    · subst j10; simp +decide [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g, aL]
    simp [f9, f8, f7, NLogN.KFUU.stF, NLogN.KFUU.tabEnd, Function.update_apply, g, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10]
end
