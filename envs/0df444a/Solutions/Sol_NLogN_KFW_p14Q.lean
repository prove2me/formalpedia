    DescR (σPush σ vl) P K D S ρ r w := by
  have hne : ∀ i : Fin HS, i ∉ scr → σPush σ vl i = σ i :=
    fun i hi => σPush_ne vl σ i (fun q hq e => hi (e ▸ hv q hq))
  exact ⟨h.base.push vl (fun q hq => scr_ok q.1 (hv q hq)),
    by rw [hne _ (by (try dsimp only); decide)]; exact h.hP, by rw [hne _ (by (try dsimp only); decide)]; exact h.hK,
    by rw [hne _ (by (try dsimp only); decide)]; exact h.hD, by rw [hne _ (by (try dsimp only); decide)]; exact h.hS,
    by rw [hne _ (by (try dsimp only); decide)]; exact h.hρ, by rw [hne _ (by (try dsimp only); decide)]; exact h.hr,
    by rw [hne _ (by (try dsimp only); decide)]; exact h.hw⟩

theorem DescR.nat {σ : Fin HS → Option ℤ} {P K D S ρ r w : ℕ}
    (h : DescR σ P K D S ρ r w) : ∀ i ∈ NLogN.KFW.descL, ∃ n : ℕ, σ i = some (n : ℤ) := by
  intro i hi
  simp only [NLogN.KFW.descL, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [⟨_, h.hP⟩, ⟨_, h.hK⟩, ⟨_, h.hD⟩, ⟨_, h.hS⟩, ⟨_, h.hρ⟩, ⟨_, h.hr⟩, ⟨_, h.hw⟩]

/-- The parts of `Gb` (symbolic, so that no kernel evaluation of `Lc` is triggered). -/
theorem Gb_parts (L s W A : ℕ) :
    s ≤ NLogN.KFN.Gb L s W A ∧ W ≤ NLogN.KFN.Gb L s W A ∧ L ≤ NLogN.KFN.Gb L s W A ∧ 1 ≤ NLogN.KFN.Gb L s W A := by
  unfold NLogN.KFN.Gb; omega

theorem Gc_pos : 1 ≤ Gc := (Gb_parts _ _ _ _).2.2.2

theorem ES_pos : ∀ k, 1 ≤ ES k
  | 0 => le_rfl
  | k + 1 => by
