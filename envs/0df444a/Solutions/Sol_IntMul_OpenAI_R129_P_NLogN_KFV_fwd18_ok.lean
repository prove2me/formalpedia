    (sv : ℕ → ℕ) (hsv : ∀ j < N, sv j = sOf r (Ex j)) :
    RecRep r F (twZ r N sv zs) (twLc r sh Ex xs) := by
  refine ⟨by rw [length_twZ]; simp [twLc, hsh], fun j c hj => ?_⟩
  simp only [twLc, List.length_map, List.length_range, hsh] at hj
  have hc := c.isLt
  have hJ : j * r + r ≤ N * r := by
    have h := Nat.mul_le_mul_right r (show j + 1 ≤ N by omega)
    rw [Nat.add_mul, one_mul] at h; exact h
