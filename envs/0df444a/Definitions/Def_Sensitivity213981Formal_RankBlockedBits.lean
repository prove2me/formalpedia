  | k::ks => (if mask.getD k.val false then 0 else 2^(4*k.val)) ||| deniedFrom mask ks



def denied (mask : Array Bool) : ℕ := deniedFrom mask (List.finRange 11)

def blockedFast (deny bits : ℕ) : Bool := decide (bits &&& deny≠0)



