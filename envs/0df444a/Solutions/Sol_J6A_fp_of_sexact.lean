/-!
# A lines (PR #5 block chirp), part 3: per-axis `FPApprox`

* `Sexact_resS`: `S'(u)_k = ½ · resS(u)_k`.
* `Sexact_norm`: `‖S'(u)_k‖ ≤ 0.55 · sup ‖u‖` (from `resS_norm_le_tight`, `α ≥ 2`).
* `fp_of_sexact`: any fixed-point map `Aa` within `E₁` of `2^p S'` is an `FPApprox` of the lifted
  line map `liftL L`, for every `L` fitted to `Sapprox` within `6m+4` (the `FitSpec6` clause),
  with error `E₁ + 12m + 8`, provided `0.55·2^p + E₁ ≤ 2^p`.
* `chirpA_fp`: the instance `Aa = chirpA`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open Complex

namespace J6A

open IntMul.HvdH

lemma Sexact_resS (s t α : ℕ) [NeZero s] [NeZero t] (hα : 0 < α) (u : ℕ → ℂ) (k : ZMod t) :
    Sexact s t α u k.val = (1 / 2 : ℂ) * Res.resS s t α (fun j : ZMod s => u j.val) k := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  have ht : 0 < t := Nat.pos_of_ne_zero (NeZero.ne t)
  simp only [Res.resS, Sexact]
  rw [← mul_assoc, ← tsum_mul_left]
  congr 1; funext j
  have hj : ((j : ZMod s).val) = (j % s).toNat := by
    have h0 : 0 ≤ j % s := Int.emod_nonneg _ (by exact_mod_cast hs.ne')
    have := ZMod.val_intCast (n := s) j
    omega
  rw [hj]
  have hexp : -(Real.pi * ((j : ℝ) - (s * k.val : ℝ) / t) ^ 2 / α ^ 2) =
      -Real.pi * (α : ℝ)⁻¹ ^ 2 * (s : ℝ) ^ 2 * ((k.val : ℝ) / t - j / s) ^ 2 := by
    have htR : (0 : ℝ) < t := by exact_mod_cast ht
    have hsR : (0 : ℝ) < s := by exact_mod_cast hs
    have hαR : (0 : ℝ) < α := by exact_mod_cast hα
    field_simp; ring
  rw [hexp]; push_cast; ring

lemma Sexact_norm (s t α : ℕ) [NeZero s] [NeZero t] (hα : 2 ≤ α) (u : ℕ → ℂ) (B : ℝ)
    (hB0 : 0 ≤ B) (hu : ∀ j, ‖u j‖ ≤ B) (k : ℕ) : ‖Sexact s t α u k‖ ≤ 0.55 * B := by
  have ht : 0 < t := Nat.pos_of_ne_zero (NeZero.ne t)
  rw [P47.Sexact_mod s t α ht u k]
  have hk : k % t = ((k : ZMod t)).val := (ZMod.val_natCast (n := t) k).symm
  rw [hk, Sexact_resS s t α (by omega) u _]
  have h1 := P47.resS_norm_le_tight (s := s) (t := t) (α : ℝ) (by exact_mod_cast hα)
    (fun j : ZMod s => u j.val) (k : ZMod t)
  have h2 : ‖(fun j : ZMod s => u j.val)‖ ≤ B := (pi_norm_le_iff_of_nonneg hB0).2 fun j => hu _
  rw [norm_mul, show ‖(1 / 2 : ℂ)‖ = 1 / 2 by norm_num]
  linarith

/-- An `E₁`-approximation of `2^p S'` is an `FPApprox` of any line map fitted to `Sapprox`. -/
theorem fp_of_sexact_sol_aux (p s t α : ℕ) [NeZero s] [NeZero t] (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p)
    (Aa : (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) (E₁ : ℝ)
    (hAa : ∀ U, InDisc p U → ∀ k,
      ‖gC (Aa U k) - 2 ^ p * Sexact s t α (fun i => gC (U i) / 2 ^ p) k‖ ≤ E₁)
    (L : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ))
    (hL : ∀ U, InDisc p U → ∀ k : ZMod t,
      ‖gC (Sapprox p s t α U k.val) - 2 ^ p * L (fun j => gC (U j.val) / 2 ^ p) k‖
        ≤ 6 * sWidth p α + 4)
    (hE : 0.55 * 2 ^ p + E₁ ≤ 2 ^ p) :
    FPApprox p Aa (NLogN.KFM.liftL L) (E₁ + 12 * sWidth p α + 8) := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  have ht : 0 < t := Nat.pos_of_ne_zero (NeZero.ne t)
  have hpR : (0 : ℝ) < 2 ^ p := by positivity
  intro U hU
  set v : ℕ → ℂ := fun i => gC (U i) / 2 ^ p with hv
  have hv1 : ∀ i, ‖v i‖ ≤ 1 := by
    intro i; simp only [hv]; rw [norm_div, norm_pow, Complex.norm_two, div_le_one hpR]; exact hU _
  have hSn : ∀ k, ‖(2 : ℂ) ^ p * Sexact s t α v k‖ ≤ 0.55 * 2 ^ p := by
    intro k
    rw [norm_mul, norm_pow, Complex.norm_two]
    have := Sexact_norm s t α hα v 1 zero_le_one hv1 k
    nlinarith
  refine ⟨fun k => ?_, fun k => ?_⟩
  · have h1 := hAa U hU k
    have h2 := norm_le_insert' (gC (Aa U k)) ((2 : ℂ) ^ p * Sexact s t α v k)
    linarith [hSn k]
  · set k' : ZMod t := (k : ZMod t)
    have hk : Sexact s t α v k = Sexact s t α v k'.val := by
      rw [P47.Sexact_mod s t α ht v k, ZMod.val_natCast]
    have h1 := hAa U hU k
    have h2 : ‖gC (Sapprox p s t α U k'.val) - 2 ^ p * Sexact s t α v k'.val‖
        ≤ 6 * sWidth p α + 4 := Sapprox_bound p s t α k'.val hs ht hα hαp U hU
    have h3 := hL U hU k'
    have e : gC (Aa U k) - 2 ^ p * NLogN.KFM.liftL L v k =
        (gC (Aa U k) - 2 ^ p * Sexact s t α v k) -
          (gC (Sapprox p s t α U k'.val) - 2 ^ p * Sexact s t α v k'.val) +
          (gC (Sapprox p s t α U k'.val) - 2 ^ p * L (fun j => gC (U j.val) / 2 ^ p) k') := by
      rw [hk]; simp only [NLogN.KFM.liftL, hv, k']; ring
    rw [e]
    refine (norm_add_le _ _).trans ?_
    have := norm_sub_le (gC (Aa U k) - 2 ^ p * Sexact s t α v k)
      (gC (Sapprox p s t α U k'.val) - 2 ^ p * Sexact s t α v k'.val)
    push_cast
    linarith

end J6A

end

theorem solution : type_of% @J6A.fp_of_sexact_sol_aux := @J6A.fp_of_sexact_sol_aux
