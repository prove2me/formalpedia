theorem exists_root_quotient {Onr : Type} [CommRing Onr] (I : Ideal Onr) [Nontrivial (Onr ⧸ I)]
    (hclosed : ∀ p : Polynomial Onr, p.Monic → 0 < p.natDegree → ∃ x : Onr, Polynomial.eval x p ∈ I)
    (p : Polynomial (Onr ⧸ I)) (hp : p.Monic) (hdeg : 0 < p.natDegree) :
    ∃ x : Onr ⧸ I, Polynomial.IsRoot p x := by
  classical
  have hlifts : p ∈ Polynomial.lifts (Ideal.Quotient.mk I) := by
    rw [Polynomial.mem_lifts]
    exact Polynomial.map_surjective _ Ideal.Quotient.mk_surjective p
  obtain ⟨P, hPmap, hPdeg, hPmonic⟩ := Polynomial.lifts_and_degree_eq_and_monic hlifts hp
  have hPnat : P.natDegree = p.natDegree := Polynomial.natDegree_eq_of_degree_eq hPdeg
  obtain ⟨x, hx⟩ := hclosed P hPmonic (hPnat ▸ hdeg)
  refine ⟨Ideal.Quotient.mk I x, ?_⟩
  rw [Polynomial.IsRoot, ← hPmap, Polynomial.eval_map, Polynomial.eval₂_at_apply]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx

theorem idem_field {k : Type} [Field k] (x : k) (hx : IsIdempotentElem x) : x = 0 ∨ x = 1 := by
  have h : x * (x - 1) = 0 := by rw [mul_sub, mul_one, hx.eq, sub_self]
  rcases mul_eq_zero.mp h with h | h
  · exact Or.inl h
  · exact Or.inr (sub_eq_zero.mp h)

