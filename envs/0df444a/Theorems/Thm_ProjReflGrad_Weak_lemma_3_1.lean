-- title:
--   Lemma 3.1, p. 4 — the energy inequality (3.1) for z ∈ S, n ≥ 2
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ closed and convex, and $F:H\to H$ monotone and Lipschitz continuous with constant $L>0$. Let $\lambda>0$, let $(x_n),(y_n)$ be generated by Algorithm 3.1 ($x_0=y_0\in H$, $x_{n+1}=P_C(x_n-\lambda F(y_n))$, $y_{n+1}=2x_{n+1}-x_n$), and let $z\in S$ be a solution of the variational inequality (1.1). Then for every $n\ge2$
--   $$\|x_{n+1}-z\|^2\le\|x_n-z\|^2-\big(1-\lambda L(1+\sqrt2)\big)\|x_n-x_{n-1}\|^2+\lambda L\|x_n-y_{n-1}\|^2-\big(1-\sqrt2\lambda L\big)\|x_{n+1}-y_n\|^2-2\lambda\langle F(z),y_n-z\rangle .$$
--
--   This is the central estimate of the convergence proof.
--
--   **Formalization Note.** The paper states (3.1) without a range of $n$; its proof uses $x_{n-1}\in C$, which needs $n\ge2$ because $x_0$ may lie outside $C$, and the proof of Theorem 3.2 uses (3.1) only for $n\ge2$. The step bound $\lambda<(\sqrt2-1)/L$ is not needed for this inequality and is not assumed; nonemptiness of $S$ is given by $z$.
-- source:
--   Malitsky, Projected Reflected Gradient Methods for Monotone Variational Inequalities, arXiv:1502.04968v1, p. 4, Lemma 3.1, (3.1)

import Mathlib
import Definitions.Def_ProjReflGrad_Weak_Setting

namespace ProjReflGrad.Weak

/-- Lemma 3.1, inequality (3.1) (Malitsky 2015, p. 4), for `n ≥ 2`: along a run of Algorithm 3.1
and for `z ∈ S`,
`‖x_{n+1} - z‖² ≤ ‖x_n - z‖² - (1 - λL(1 + √2))‖x_n - x_{n-1}‖² + λL‖x_n - y_{n-1}‖²
  - (1 - √2λL)‖x_{n+1} - y_n‖² - 2λ⟨F(z), y_n - z⟩`. -/
theorem lemma_3_1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (C : Set H) (hCcl : IsClosed C) (hCcv : Convex ℝ C) (F : H → H) (L lam : ℝ)
    (hC2 : IsMonotoneMap F) (hL : 0 < L) (hC3 : IsLipschitzMap F L) (hlam0 : 0 < lam)
    (x y : ℕ → H) (hrun : IsPRGRun C F lam x y) (z : H) (hz : z ∈ solSet C F) :
    ∀ n : ℕ, 2 ≤ n →
      ‖x (n + 1) - z‖ ^ 2 ≤ ‖x n - z‖ ^ 2
        - (1 - lam * L * (1 + Real.sqrt 2)) * ‖x n - x (n - 1)‖ ^ 2
        + lam * L * ‖x n - y (n - 1)‖ ^ 2
        - (1 - Real.sqrt 2 * lam * L) * ‖x (n + 1) - y n‖ ^ 2
        - 2 * lam * inner ℝ (F z) (y n - z) := by sorry

end ProjReflGrad.Weak
