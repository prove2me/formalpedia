theorem inTubeJ_smul_iff (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) (hs : s ∈ ssPlaces q M' (ResidueField A))
    {τ : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M')} (hτ : τ ∈ LevelAuts q M') :
    ∀ P : Place (AlgebraicClosure ℚ) (fieldBar q M'), (InTubeJ q M' A hle s (τ • P) ↔ InTubeJ q M' A hle s P) := by
  refine Subgroup.closure_induction (fun σ hσ => ?_) (fun P => by rw [one_smul]) (fun σ σ' _ _ h h' P => ?_)
    (fun σ _ h P => ?_) hτ
  · obtain ⟨ζ, γ, hγ, rfl⟩ := hσ
    exact fun P => inTubeJ_levelAutBar_smul_iff q M' hqM' A hA hle s hs ζ γ hγ P
  · rw [mul_smul, h, h']
  · have e := h (σ⁻¹ • P)
    rw [smul_inv_smul] at e
    exact e.symm

