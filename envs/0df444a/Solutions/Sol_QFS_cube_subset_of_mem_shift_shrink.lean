/-- The content of the proof of Lemma 3.2: if `y ∈ V_{√d}[x]`, then
`B̄_{√d/2}(y) ⊆ V_{√d/2}[x]`, and hence the whole unit cube `A_1(y)` lies in
`V_{√d/2}[x]`. -/
lemma solution {S : Set (EuclideanSpace ℝ (Fin d))}
    {x y : EuclideanSpace ℝ (Fin d)} (hy : y ∈ QFS.shift (QFS.shrink S (Real.sqrt d)) x) :
    QFS.cube 1 y ⊆ QFS.shift (QFS.shrink S (Real.sqrt d / 2)) x := by
  rw [← QFS.shrink_shift] at hy ⊢
  have h2 : (Real.sqrt d : ℝ) = 2 * (Real.sqrt d / 2) := by ring
  rw [h2] at hy
  refine (QFS.cube_subset_closedBall y).trans ?_
  have hball := QFS.closedBall_subset_shrink hy
  have he : (1 : ℝ) / 2 * Real.sqrt d = Real.sqrt d / 2 := by ring
  rwa [he]
