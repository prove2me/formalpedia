  let i₃ : 𝒪₃ →ₐ[𝒪'] F := IsAlgClosed.lift
  have hi₃ : ∀ x : 𝒪', i₃ (ι₃ (ι₂ x)) = ιF x := fun x => i₃.commutes x
  set χFN : CuspForm.heckeAlgebra N 2 (↑S : Set ℕ) →+* F := (i₃ : 𝒪₃ →+* F).comp χ₃ with hχFNdef

  have hχFNT : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ (↑S : Set ℕ)) (hℓr : ℓ ≠ r),
