    (hlast : j < MetricCodes.johnsonLastDegree n w p q) :
    0 <
      ((MetricCodes.johnsonJ n j ^ 2 - MetricCodes.johnsonM n w ^ 2) *
        (MetricCodes.johnsonJ n j ^ 2 -
