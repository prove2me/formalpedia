theorem c3_deg0 (v : V → ℤ) : (degeneracyMatrix Q.D.a).mulVec (Q.padj 0 v) = (((Q.s : ℕ) : ℤ) + 1) • v := by
  simpa using Q.c3_deg 0 v
theorem c3_deg1 (v : V → ℤ) : (degeneracyMatrix Q.D.b).mulVec (Q.padj 1 v) = (((Q.s : ℕ) : ℤ) + 1) • v := by
