  have hE := hP.toESData
  obtain ⟨hB, hD, hA, hH, hu, hv⟩ := hE.nz hx
  have hl' : lam ^ 2 = alphaSqFrame (f (x 1)) (Dfun f m N (x 1)) (Hfun m N (x 1))
