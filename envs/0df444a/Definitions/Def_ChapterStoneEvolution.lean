import Definitions.Def_ChapterStoneGroup
import Mathlib

import Mathlib

/-!
# The general Stone theorem, part III: the unitary group `e^{-itA}`

Using the Yosida approximations `A_n` of `BookProof.ChapterStoneGroup`, we form the
bounded unitary groups `e^{-itA_n}` and prepare the convergence estimate that produces
the unitary group generated by an unbounded self-adjoint `A`.
-/

open scoped InnerProductSpace
open Filter Topology NormedSpace

namespace BookProof.ChapterStoneResolvent

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The algebra of bounded operators is a `ℚ`-algebra; this is the instance under which
`NormedSpace.exp` is available. -/
noncomputable local instance ratNormedAlgebra : NormedAlgebra ℚ (H →L[ℂ] H) :=
  NormedAlgebra.restrictScalars ℚ ℂ (H →L[ℂ] H)



namespace UnboundedSelfAdjoint

variable (T : UnboundedSelfAdjoint H)

/-- Evaluating a differentiable curve of bounded operators at a fixed vector. -/
theorem hasDerivAt_apply {f : ℝ → (H →L[ℂ] H)} {f' : H →L[ℂ] H} {t : ℝ} (x : H)
    (h : HasDerivAt f f' t) : HasDerivAt (fun s => f s x) (f' x) t :=
  ((ContinuousLinearMap.apply ℂ H x).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt t h

/-! ## The bounded approximating groups -/

/-- The skew-adjoint generator `-i A_n` of the approximating group. -/
noncomputable def yosidaGen (n : ℝ) : H →L[ℂ] H := (-Complex.I) • T.yosida n

/-- The approximating unitary group `e^{-i t A_n}`. -/
noncomputable def approxU (n t : ℝ) : H →L[ℂ] H := exp (t • T.yosidaGen n)

theorem yosidaGen_mem_skewAdjoint (n : ℝ) : T.yosidaGen n ∈ skewAdjoint (H →L[ℂ] H) := by
  rw [skewAdjoint.mem_iff, yosidaGen, star_smul, (T.yosida_isSelfAdjoint n)]
  simp

theorem smul_yosidaGen_mem_skewAdjoint (n t : ℝ) :
    t • T.yosidaGen n ∈ skewAdjoint (H →L[ℂ] H) := by
  have h := T.yosidaGen_mem_skewAdjoint n
  rw [skewAdjoint.mem_iff] at h ⊢
  rw [star_smul, star_trivial, h, smul_neg]

theorem approxU_mem_unitary (n t : ℝ) : T.approxU n t ∈ unitary (H →L[ℂ] H) :=
  exp_mem_unitary_of_mem_skewAdjoint (T.smul_yosidaGen_mem_skewAdjoint n t)

@[simp] theorem approxU_zero (n : ℝ) : T.approxU n 0 = 1 := by
  simp [approxU]

theorem approxU_add (n s t : ℝ) : T.approxU n (s + t) = T.approxU n s * T.approxU n t := by
  rw [approxU, approxU, approxU, add_smul]
  exact exp_add_of_commute (((Commute.refl (T.yosidaGen n)).smul_left s).smul_right t)

theorem norm_approxU_apply (n t : ℝ) (x : H) : ‖T.approxU n t x‖ = ‖x‖ := by
  have hu : (star (T.approxU n t)) * T.approxU n t = 1 :=
    (Unitary.mem_iff.mp (T.approxU_mem_unitary n t)).1
  have hadj : ContinuousLinearMap.adjoint (T.approxU n t) (T.approxU n t x) = x := by
    have := congrArg (fun (S : H →L[ℂ] H) => S x) hu
    simpa [ContinuousLinearMap.star_eq_adjoint] using this
  have hinner : ⟪T.approxU n t x, T.approxU n t x⟫_ℂ = ⟪x, x⟫_ℂ := by
    rw [← ContinuousLinearMap.adjoint_inner_left, hadj]
  have h3 : (⟪T.approxU n t x, T.approxU n t x⟫_ℂ).re = (⟪x, x⟫_ℂ).re := by rw [hinner]
  simpa [inner_self_eq_norm_sq, ← Complex.ofReal_pow] using h3

theorem approxU_gen_commute (n m : ℝ) : Commute (T.yosidaGen n) (T.yosidaGen m) := by
  unfold yosidaGen
  exact ((T.yosida_commute n m).smul_left _).smul_right _

theorem approxU_commute_gen (n m s : ℝ) : Commute (T.yosidaGen n) (T.approxU m s) :=
  (((T.approxU_gen_commute n m).smul_right s)).exp_right

theorem approxU_commute (n m s t : ℝ) : Commute (T.approxU n s) (T.approxU m t) :=
  (((T.approxU_gen_commute n m).smul_left s).smul_right t).exp

/-- The differential equation satisfied by the approximating group. -/
theorem hasDerivAt_approxU (n t : ℝ) :
    HasDerivAt (fun s : ℝ => T.approxU n s) (T.approxU n t * T.yosidaGen n) t :=
  hasDerivAt_exp_smul_const (𝕂 := ℝ) (T.yosidaGen n) t

theorem hasDerivAt_approxU_apply (n t : ℝ) (x : H) :
    HasDerivAt (fun s : ℝ => T.approxU n s x) ((T.approxU n t * T.yosidaGen n) x) t :=
  hasDerivAt_apply x (T.hasDerivAt_approxU n t)

/-! ## The basic convergence estimate -/

/-- The fundamental estimate `‖(e^{-itA_n} - e^{-itA_m}) x‖ ≤ |t| ‖(A_n - A_m) x‖`. -/
theorem norm_approxU_sub_apply_le (n m t : ℝ) (x : H) :
    ‖T.approxU n t x - T.approxU m t x‖ ≤ |t| * ‖T.yosida n x - T.yosida m x‖ := by
  set C : ℝ := ‖T.yosida n x - T.yosida m x‖ with hC
  set P : ℝ → (H →L[ℂ] H) := fun s => T.approxU n (t - s) * T.approxU m s with hP
  set D : ℝ → (H →L[ℂ] H) :=
    fun s => (T.approxU n (t - s) * T.approxU m s) * (T.yosidaGen m - T.yosidaGen n) with hD
  have hderiv : ∀ s : ℝ, HasDerivAt (fun s => P s x) (D s x) s := by
    intro s
    have hc : HasDerivAt (fun s : ℝ => T.approxU n (t - s))
        (-(T.approxU n (t - s) * T.yosidaGen n)) s := by
      have h1 := T.hasDerivAt_approxU n (t - s)
      have h2 : HasDerivAt (fun s : ℝ => t - s) (-1 : ℝ) s := by
        simpa using (hasDerivAt_id s).const_sub t
      simpa [Function.comp_def] using h1.scomp s h2
    have hd : HasDerivAt (fun s : ℝ => T.approxU m s) (T.approxU m s * T.yosidaGen m) s :=
      T.hasDerivAt_approxU m s
    have hmul := hc.mul hd
    have hcomm : T.yosidaGen n * T.approxU m s = T.approxU m s * T.yosidaGen n :=
      (T.approxU_commute_gen n m s).eq
    have hEq : -(T.approxU n (t - s) * T.yosidaGen n) * T.approxU m s
        + T.approxU n (t - s) * (T.approxU m s * T.yosidaGen m) = D s := by
      calc -(T.approxU n (t - s) * T.yosidaGen n) * T.approxU m s
            + T.approxU n (t - s) * (T.approxU m s * T.yosidaGen m)
          = -(T.approxU n (t - s) * (T.yosidaGen n * T.approxU m s))
            + T.approxU n (t - s) * (T.approxU m s * T.yosidaGen m) := by noncomm_ring
        _ = -(T.approxU n (t - s) * (T.approxU m s * T.yosidaGen n))
            + T.approxU n (t - s) * (T.approxU m s * T.yosidaGen m) := by rw [hcomm]
        _ = D s := by rw [hD]; noncomm_ring
    rw [hP]
    exact hasDerivAt_apply x (hEq ▸ hmul)
  have hnorm : ∀ s : ℝ, ‖D s x‖ = C := by
    intro s
    have h1 : D s x = T.approxU n (t - s) (T.approxU m s ((T.yosidaGen m - T.yosidaGen n) x)) :=
      rfl
    rw [h1, T.norm_approxU_apply, T.norm_approxU_apply]
    have h2 : (T.yosidaGen m - T.yosidaGen n) x = (-Complex.I) • (T.yosida m x - T.yosida n x) := by
      simp [yosidaGen, smul_sub]
    rw [h2, norm_smul, hC]
    simp [norm_sub_rev]
  have hmvt : ‖P t x - P 0 x‖ ≤ C * ‖t - 0‖ := by
    refine Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (f := fun s => P s x) (f' := fun s => D s x) (C := C) (s := Set.univ)
      (fun s _ => (hderiv s).hasDerivWithinAt) (fun s _ => le_of_eq (hnorm s)) convex_univ
      (Set.mem_univ 0) (Set.mem_univ t)
  have hPt : P t x = T.approxU m t x := by
    simp [hP]
  have hP0 : P 0 x = T.approxU n t x := by
    simp [hP]
  rw [hPt, hP0] at hmvt
  calc ‖T.approxU n t x - T.approxU m t x‖
      = ‖T.approxU m t x - T.approxU n t x‖ := norm_sub_rev _ _
    _ ≤ C * ‖t - 0‖ := hmvt
    _ = |t| * C := by rw [sub_zero, Real.norm_eq_abs]; ring























/-! ## The basic convergence estimate -/



end UnboundedSelfAdjoint

end BookProof.ChapterStoneResolvent


