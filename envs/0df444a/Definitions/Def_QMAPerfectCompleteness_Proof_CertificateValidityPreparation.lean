/-! The actual arithmetic-plus-validity prefix and its certificate-dependent workspace fiber. -/
open Matrix
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2000000
namespace QMAPerfectCompleteness.Main.CertificatePreparation
open BlockCircuit BlockCoordinates CertificateCoordinates CertificateMasterLayout ThresholdPreparation
open ComparisonCircuits CertificateValidityCircuit
variable (V : Verifier gatesG2)





























noncomputable def prefixEncoding (p : Logical V) : Physical V :=
  Function.update ((CertificateValidityCircuit.layout V).action (prepState V (rawEncoding V p)))
    (validity V 5) (decide (IsValidCertificate V p.2.2.1.val p.2.2.2.val))







noncomputable def prefixWorkspace (c : CertificateMixture.Claim V) : Basis (work V) :=
  (coords V (prefixEncoding V (dummyBody V,c))).2



noncomputable def prefixGates : List (Instr gatesG2 (total V)) := prepGates V ++ CertificateValidityCircuit.gates V



end QMAPerfectCompleteness.Main.CertificatePreparation


