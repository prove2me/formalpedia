-- title:
--   Lemma 4 — local triviality: a positive-measure set contains a positive-measure set whose K-sections are pairwise disjoint
-- statement:
--   Throughout, $X$ is a standard Borel space, $\mu$ a $\sigma$-finite measure on $X$, and $R \subseteq X \times X$ a discrete measured equivalence relation for $\mu$ (`IsDiscreteMeasured`): a Borel equivalence relation whose classes are countable and for which $\mu$ is quasi-invariant (the saturation of a null Borel set is null).
--
--   Let $K$ be a bounded subset of $R$ (`IsBoundedSubset`) and $\Omega$ a Borel set with $\mu(\Omega) > 0$. Then there is a Borel set $\Omega' \subseteq \Omega$ with $\mu(\Omega') > 0$ such that for distinct $x, y \in \Omega'$ the sections $\{z \mid (x, z) \in K\}$ and $\{z \mid (y, z) \in K\}$ are disjoint.
--
--   In the paper's groupoid notation, $x \cdot K$ is the set of elements of $K$ with range $x$, so $s(x \cdot K) = \{z \mid (x, z) \in K\}$. The sets $\Omega$ and $\Omega'$ are taken Borel.
-- source:
--   Connes, A., Feldman, J., Weiss, B., An amenable equivalence relation is generated by a single transformation, Ergodic Theory Dynam. Systems 1 (1981) 431–450, https://doi.org/10.1017/S014338570000136X, p. 436, Lemma 4

import Mathlib
import Definitions.Def_ConnesFeldmanWeiss

namespace ConnesFeldmanWeiss

theorem exists_subset_pairwise_disjoint_sections {X : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] (μ : MeasureTheory.Measure X) [MeasureTheory.SigmaFinite μ]
    (R K : Set (X × X)) (hR : IsDiscreteMeasured μ R) (hK : IsBoundedSubset μ R K)
    (Ω : Set X) (hΩ : MeasurableSet Ω) (hΩpos : 0 < μ Ω) :
    ∃ Ω₁ ⊆ Ω, MeasurableSet Ω₁ ∧ 0 < μ Ω₁ ∧ ∀ x ∈ Ω₁, ∀ y ∈ Ω₁, x ≠ y →
      Disjoint {z | (x, z) ∈ K} {z | (y, z) ∈ K} := by
  sorry

end ConnesFeldmanWeiss
