/-- **A node level.** -/
theorem sImplQ_nodeC_sol_aux {rowC : IStmt HS Pp} {aK : ℕ → ℝ} {τ : ℝ} {G : ℕ}
    (hRow : RowUCG c.m τ Isym tbl rowC aK G)
    (haK : ∀ K, 0 ≤ aK K) (hτ : 0 ≤ τ) {jL : Fin Pp} (hj : tbl jL = levCH c jL rowC) (hok : NetOK c)
    (hL : LevRH c σ K t S0 r H E e B) (hG24 : σ vG = some (G : ℤ))
    (hA : 1 ≤ c.Aw) (hp : 1 ≤ c.p) (hm : 1 ≤ c.m) (hE2 : 2 * c.m ≤ E) (hW1 : 1 ≤ c.W)
    (hWB : c.W ∣ B) (hB1 : 1 ≤ B)
    (hK6 : 6 ≤ K) (hr : 1 ≤ r) {Z : ℕ} (hZG : 4 * Z * (Z + 2) ≤ 2 ^ G)
    (hGK : 16 * Z * (Z + 2) * 2 ^ G ≤ 2 ^ K) (Zr : ℕ) (hZZ : Z ≤ Zr)
    (hZr : Zr + 2 ≤ r) (hHZ : H + 1 < 2 ^ Z) (hS : 1 ≤ S0)
    (hdB : 2 ^ (2 * ((E / c.m - 1) * G)) ∣ B / c.W) (hdS : 2 ^ ((E / c.m - 1) * G) ∣ S0)
    (hGz : zsz (G : ℤ) ≤ Zr)
    (hKe : K * (E - 1) ≤ e) (het : e - e % K + K ≤ t)
    (hz16 : zsz ((16 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Z)
    (hze : zsz ((e + t + K + c.m * (E / c.m) + E / c.m : ℕ) : ℤ) ≤ Zr)
    (hzu : zsz ((6 * (E / c.m) + 6 : ℕ) : ℤ) ≤ Zr)
    (hzrow : zsz ((E / c.m + K + e + t + S0 + B / c.W + r + H + c.m : ℕ) : ℤ) ≤ Zr)
    (hz3 : 3 ≤ Zr) (M : ℕ)
    (hM : c.Aw * (E + 1) ^ c.p + (E + 1) ^ c.p + E + 2 * c.m + cLH c + B + c.W + S0 + r + K +
      S0 * r + K * E + e + 1 ≤ M)
    (hMZ : zsz (M : ℤ) ≤ Zr)
    (hzA : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) + 16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Zr)
    (hGH : c.G E ≤ H)
    (hδ : cLH c + ((chWs c).map fun s => c.G (s * (E / c.m))).sum + E % c.m ≤ c.G E)
    (DWc cI : ℕ → ℕ)
    (IHc : ∀ s, s < c.m →
      SImplQ Isym tbl (fun s' => Agree (σChildH (σNodeH σ c K t S0 r E B) c s (E / c.m) (B / c.W)) s')
      0 H r (fun i : Fin (s * (E / c.m)) => 2 ^ (e - K * i.val) * S0) (nN (B / c.W) t S0)
      (tens Cm) (levCH c jL rowC) (c.G (s * (E / c.m))) (DWc s) (fun _ => cI s))
    (DWR cR : ℕ)
    (IHR : SImplQ Isym tbl (fun s => Agree (σPush (σNodeH σ c K t S0 r E B)
        (frV (σNodeH σ c K t S0 r E B) (leftFr c))) s) 0 H r
      (fun j : Fin (E % c.m) => 2 ^ ((e - K * (c.m * (E / c.m))) - K * j.val) * S0) (nN B t S0)
      (tens Cm) (levCH c jL rowC) (c.G (E % c.m)) DWR (fun _ => cR)) :
    ∃ cost : ℕ → ℕ, SImplQ Isym tbl (fun s => Agree σ s) 0 H r
      (fun i : Fin E => 2 ^ (e - K * i.val) * S0) (nN B t S0) (tens Cm) (nodeC c jL rowC)
      (c.G E) ((c.net.map (dwStH c DWc (E / c.m))).sum + (DWR + (δv c E + 2) * 2)) cost ∧
      ∀ w, w + ((c.net.map (dwStH c DWc (E / c.m))).sum + (DWR + (δv c E + 2) * 2)) ≤ H →
        (cost w : ℝ) ≤ (((chWs c).map cI).sum : ℝ) + (cR : ℝ) +
          ((c.net.length : ℝ) * ((MH c : ℝ) + 18 * aK K *
            (((E / c.m : ℕ) : ℝ) + 1) ^ τ) + (CnN c : ℝ)) *
          ((c.Wr * nN (B / c.W) t S0 * Yu r Zr H : ℕ) : ℝ) := by
  set F := E / c.m with hFd
  set Bn := B / c.W with hBnd
  set σN := σNodeH σ c K t S0 r E B with hσN
  have hN : NodeRH c σN K t S0 r H E e B := nodeRH_of hL
  have hF : 1 ≤ F := by rw [hFd, Nat.le_div_iff_mul_le (by omega)]; omega
  have hmF : c.m * F ≤ E := Nat.mul_div_le E c.m
  have hBn : 1 ≤ Bn := by
    rw [hBnd]; exact (Nat.le_div_iff_mul_le (by omega)).2 (by
      have := Nat.le_of_dvd (by omega) hWB; omega)
  have hW : 1 ≤ c.Wr := by show 1 ≤ c.W + c.T; omega
  have hKe' : K * (c.m * F - 1) ≤ e := le_trans (Nat.mul_le_mul_left _ (by omega)) hKe
  have hM1 : c.Aw * (E + 1) ^ c.p + (E + 1) ^ c.p + E + 2 * c.m + B + 1 ≤ M := by omega
  have hGN : σN vG = some (G : ℤ) := by rw [hσN, σNodeH_ne (by decide)]; exact hG24
  have hstep := fun a ha => step_anyH (Isym := Isym) (tbl := tbl) hRow haK hτ hj hok hN hGN hA hp hm
    hF hW hK6 hr hZG hGK Zr hZZ hZr hHZ hS hBn hdB hdS hGz hKe' het hz16 hze hzu hzrow hz3 M hM1 hMZ
    hGH DWc cI IHc a ha
  choose! dwf cf hP using hstep
  have hzA4 : zsz ((2 * (c.Wr * (nN Bn t S0 * r)) + 4 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Zr :=
    le_trans (zsz_natCast_le (by omega)) hzA
  obtain ⟨cost1, S1, hc1⟩ := sImplQ_nodeIn hj hN hok hm hE2 hW1 hWB hB1 (by omega) hS hr hKe het Zr
    hzA4 hZr M (by omega) hMZ dwf cf (fun a ha => (hP a ha).1) DWR cR IHR
  have hdw : (c.net.map dwf).sum ≤ (c.net.map (dwStH c DWc F)).sum :=
    List.sum_le_sum (fun a ha => (hP a ha).2.1)
  have S2 := S1.mono_dw (Nat.add_le_add_right hdw _)
  have S3 := sImplQ_nodeFr (I := Isym) (iprog := tbl) hL hm hW1 hA hp hS hr hB1 hBn hδ (chWs_lt hok)
    M Zr (by omega) hMZ hzA S2
  have hsum : (c.net.map (eStH c F)).sum + (c.G (E % c.m) + δv c E) = c.G E := by
    rw [sum_eStH_net c F]
    have hG : c.G (E % c.m) = E % c.m :=
      Gs_lt (by have := Nat.mod_lt E (show c.m > 0 by omega); omega)
    rw [hG]
    unfold δv
    rw [← hFd]
    omega
  refine ⟨_, (S3.congrE hsum rfl).congrC rfl, fun w hw => ?_⟩
  -- the cost
  have hδH : δv c E ≤ H := by unfold δv; omega
  have hGM : c.G E ≤ M := by
    have : c.G E ≤ c.Aw * (E + 1) ^ c.p := Gs_le_pow hA hp
    omega
  have hδZ : zsz ((δv c E : ℕ) : ℤ) ≤ Zr :=
    le_trans (zsz_natCast_le (show δv c E ≤ M by unfold δv; omega)) hMZ
  have hOV := cost_nodeFrH c (x := cost1 w) hδH hδZ hZr
  have hc1w := hc1 w (by omega)
  set Y := Yu r Zr H with hY
  set P := c.Wr * nN Bn t S0 * Y with hPd
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hYP : Y ≤ P := by
    rw [hPd]; exact Nat.le_mul_of_pos_left _ (Nat.mul_le_mul hW hn)
  have hOV2 : 10 ^ 9 * ((δNE c).size + 100) * Y + 10 ^ 17 * P ≤ CnN c * P := by
    unfold CnN
    have hs0 : 1 ≤ (δNE c).size + 100 := by omega
    generalize (δNE c).size + 100 = s0 at hs0 ⊢
    have a1 : 10 ^ 9 * s0 * Y ≤ 10 ^ 9 * s0 * P := Nat.mul_le_mul_left _ hYP
    have a2 : P ≤ s0 * P := Nat.le_mul_of_pos_left _ hs0
    have a3 : 10 ^ 9 * s0 * P = 10 ^ 9 * (s0 * P) := by ring
    have a4 : 10 ^ 18 * s0 * P = 10 ^ 18 * (s0 * P) := by ring
    rw [a4]
    generalize s0 * P = Q at *
    generalize 10 ^ 9 * s0 * Y = X at *
    linarith
  -- the steps in `ℝ`
  set Γ : ℝ := 18 * aK K * (((F : ℕ) : ℝ) + 1) ^ τ with hΓ
  have hcf := sum_le_aff cf (chCostH cI) (((MH c : ℝ) + Γ) * (P : ℝ)) c.net
    (fun a ha => (hP a ha).2.2)
  rw [sum_chCostH cI c.net] at hcf
  have hnat : cFrame 6 5 Zr + (cNF2 c Zr (δv c E) + cost1 w +
      (6 * (2 * (Zr + δv c E + 1) + 2) + 1)) + (6 * (2 * Zr + 2) + 1) ≤
      (c.net.map cf).sum + cR + CnN c * P := by omega
  have hnatR : ((cFrame 6 5 Zr + (cNF2 c Zr (δv c E) + cost1 w +
      (6 * (2 * (Zr + δv c E + 1) + 2) + 1)) + (6 * (2 * Zr + 2) + 1) : ℕ) : ℝ) ≤
      (((c.net.map cf).sum : ℕ) : ℝ) + (cR : ℝ) + (CnN c : ℝ) * (P : ℝ) := by
    exact_mod_cast hnat
  refine hnatR.trans ?_
  have hch : ((chWs c).map cI).sum = ((c.net.filterMap HStep.width).map cI).sum := rfl
  rw [hch]
  nlinarith

end Node

