-- title:
--   Lexicographic initial forms and initial submodules
-- statement:
--   In a finite shifted free module with first and second gradings, write a first-homogeneous relation $h$ as the sum of its second-degree components. Define
--   $$\operatorname{in}(h)=\text{the component of largest lexicographic second degree},\qquad\operatorname{in}(0)=0.$$
--   The initial module is the $S$-span of these initial forms for every first-homogeneous relation. Projections and degree supports are computed from actual monomial coefficients; first-graded submodules are closed under these projections. Matrix images are actual ranges of matrix multiplication.
--
--   The maximum is over a finite support, and the definition imposes neither preservation of dimensions nor preservation of an annihilator. Those are separate theorem conclusions.
-- source:
--   Neil Krishnan, Guy Moshkovitz, Optimal partition rank bounds for the determinant and other multilinear polynomials, STOC 2027 submission #631 (October 2026), §5.6, pp.22–23, p. 22; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/631.pdf

import Definitions.Def_DetSupportRank_DeterminantSupport_KPolynomials

noncomputable section
open scoped BigOperators
universe uDSInitialModules

namespace DetSupportRank.DeterminantSupport

/-- Projection to a degree in a shifted free module, computed monomial by monomial. -/
def freeComponent {K : Type uDSInitialModules} [Field K] {V D : Type} {k : ℕ}
    (p : V → D → ℤ) (s : Fin k → D → ℤ) (u : D → ℤ)
    (h : Fin k → MvPolynomial V K) : Fin k → MvPolynomial V K := by
  classical
  exact fun i => (AddMonoidAlgebra.coeff (h i)).sum (fun e c =>
    if monomialDegree p e + s i = u then MvPolynomial.monomial e c else 0)

/-- Actual finite support of shifted degrees of a vector. -/
def freeDegreeSupport {K : Type uDSInitialModules} [Field K] {V D : Type} {k : ℕ}
    (p : V → D → ℤ) (s : Fin k → D → ℤ)
    (h : Fin k → MvPolynomial V K) : Finset (D → ℤ) := by
  classical
  exact Finset.univ.biUnion fun i => (h i).support.image fun e => monomialDegree p e + s i

/-- Lexicographic order on the finite degree vectors; explicit least differing coordinate. -/
def DegreeLexLT {d : ℕ} (a b : Fin d → ℤ) : Prop :=
  ∃ i, (∀ j, j < i → a j = b j) ∧ a i < b i

/-- Lexicographically largest second-degree component; in(0) = 0 (§5.6, pp.22–23). -/
def initialForm {K : Type uDSInitialModules} [Field K] {V : Type} {d k : ℕ}
    (q : V → Fin d → ℤ) (t : Fin k → Fin d → ℤ)
    (h : Fin k → MvPolynomial V K) : Fin k → MvPolynomial V K := by
  classical
  exact if hx : ∃ w ∈ freeDegreeSupport q t h,
      ∀ v ∈ freeDegreeSupport q t h, ¬ DegreeLexLT w v then
    freeComponent q t (Classical.choose hx) h else 0

/-- The submodule generated by initials of all first-homogeneous relations. No dimension
preservation or annihilator property is imposed. -/
def initialModule {K : Type uDSInitialModules} [Field K] {V : Type} {d k : ℕ}
    (p q : V → Fin d → ℤ) (s t : Fin k → Fin d → ℤ)
    (N : Submodule (MvPolynomial V K) (Fin k → MvPolynomial V K)) :
    Submodule (MvPolynomial V K) (Fin k → MvPolynomial V K) :=
  Submodule.span (MvPolynomial V K) {v | ∃ h ∈ N,
    (∃ u, h ∈ freePiece p s u) ∧ v = initialForm q t h}

/-- Component-closure is the source's first-homogeneity condition on N. -/
def IsGradedSubmodule {K : Type uDSInitialModules} [Field K] {V D : Type} {k : ℕ}
    (p : V → D → ℤ) (s : Fin k → D → ℤ)
    (N : Submodule (MvPolynomial V K) (Fin k → MvPolynomial V K)) : Prop :=
  ∀ h ∈ N, ∀ u, freeComponent p s u h ∈ N

/-- Actual image of the polynomial matrix, using its standard linear map. -/
def matrixImage {K V : Type*} [Field K] {N : ℕ}
    (A : Matrix (Fin N) (Fin N) (MvPolynomial V K)) :
    Submodule (MvPolynomial V K) (Fin N → MvPolynomial V K) :=
  LinearMap.range A.mulVecLin

/-- Pair two degree functions without identifying their coordinates. -/
def pairDegrees {V D : Type} (p q : V → D → ℤ) : V → (D ⊕ D) → ℤ :=
  fun v => Sum.elim (p v) (q v)

end DetSupportRank.DeterminantSupport


