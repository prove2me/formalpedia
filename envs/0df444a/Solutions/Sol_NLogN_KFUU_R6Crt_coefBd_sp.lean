-- Source module: Solutions.KFUURot1
/-!
# KFUU §7a: register programs for the uniform shifts — helpers and the stage lists

The uniform prefix-controlled shift of target `i` (sizes `s_j = sF j`, coefficient list
`cs = cF neg sF μ Q`) computes the stage data of KIL4's uniform table generator at run time:

* `Pv sF j = ∏_{k<j} s_k`;
* `stgM_rev` / `stgAM_rev`: closed forms of the stage stacks `stgM`, `stgAM` of the
  stage list `(A.zip cs).reverse` (`A = [s_0, …, s_{i-1}]`): `P_i / P_{j+1}` and `P_i / P_j`;
* `encK_lift`: a stack prefix of the unmanaged part becomes managed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-! ## Managed-state helpers -/

/-! ## Prefix products and the stage lists -/

theorem Pv_succ (sF : ℕ → ℕ) (j : ℕ) : Pv sF (j + 1) = Pv sF j * sF j := by
  simp [Pv, List.range_succ, vol_append, vol]

theorem Pv_pos (sF : ℕ → ℕ) {i : ℕ} (hs : ∀ j < i, 1 ≤ sF j) : ∀ j ≤ i, 1 ≤ Pv sF j
  | 0, _ => by simp [Pv, vol]
  | j + 1, hj => by
    rw [Pv_succ]; exact Nat.mul_pos (Pv_pos sF hs j (by omega)) (hs j (by omega))

theorem Pv_dvd (sF : ℕ → ℕ) {j i : ℕ} (h : j ≤ i) : Pv sF j ∣ Pv sF i := by
  induction i with
  | zero => obtain rfl : j = 0 := by omega
            exact dvd_rfl
  | succ i ih =>
    rcases Nat.eq_or_lt_of_le h with rfl | h
    · exact dvd_rfl
    · rw [Pv_succ]; exact Dvd.dvd.mul_right (ih (by omega)) _

theorem Pv_mono (sF : ℕ → ℕ) {i : ℕ} (hs : ∀ j < i, 1 ≤ sF j) {j : ℕ} (h : j ≤ i) :
    Pv sF j ≤ Pv sF i :=
  Nat.le_of_dvd (Pv_pos sF hs i le_rfl) (Pv_dvd sF h)

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUURot2
/-!
# KFUU §7b: the coefficient loop of a uniform shift

Registers of a shift of target `i` (all values natural numbers):
`oI = i`, `oQ = Q = s_i`, `oMu = μ_i`, `oPi = P_i`, `oBv = B` (volume behind the target),
`oSP`: the sizes `s_{i-1}, …, s_0` (top first).

`coefB neg` is one step `j` of the coefficient loop: it pushes the stage data of field `j`
(`c_j`, `P_i / P_j`, `P_i / P_{j+1}`, `s_j`) on the stage stacks of KIL4 and advances
`oPr = P_j` to `P_{j+1}`, moving `s_j` from `oSQ` to `oSP`.  `c_j = μ P_j mod Q`
(forward, `neg = false`) or `(Q - μ P_j mod Q) mod Q` (backward).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

theorem encK_G_upd_ne (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) (j : Fin HS)
    (h : j ≠ i) : (encK s (Function.update f i l)).G j = (encK s f).G j := by
  simp [h]

theorem drop_range_map (sF : ℕ → ℕ) {i k : ℕ} (hk : k < i) :
    ((List.range i).map fun j => (sF j : ℤ)).drop k =
      (sF k : ℤ) :: ((List.range i).map fun j => (sF j : ℤ)).drop (k + 1) := by
  rw [List.drop_eq_getElem_cons (by simpa using hk)]
  simp

theorem rev_range_succ {α : Type*} (g : ℕ → α) (k : ℕ) :
    ((List.range (k + 1)).map g).reverse = g k :: ((List.range k).map g).reverse := by
  simp [List.range_succ]

end NLogN.KFUU

end

