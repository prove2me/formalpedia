/-- **Lemma 5.5**, the discrete counterpart of Lemma 4.6 ("über Bande"). If a
lattice point `z` of type `Γ(y)` lies in `B_r(x) ∩ Γ(y)[x]`, then `y` and `x` are
joined by an edge path inside `B_R(x)`, for `R > r + (2r + √d)/sin ϑ`. -/
theorem solution (hϑ : 0 < ϑ) (hb : ∀ w, ϑ ≤ (Γ w).apex)
    {r R : ℝ} {x y z : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ QFS.lattice d) (hy : y ∈ QFS.lattice d) (hz : z ∈ QFS.lattice d)
    (hxy : ‖x - y‖ < r) (hzx : ‖z - x‖ < r) (hzV : z ∈ QFS.shift (Γ y).carrier x)
    (htype : (Γ z).carrier = (Γ y).carrier)
    (hR : r + (2 * r + Real.sqrt d) / Real.sin ϑ < R) :
    QFS.ConnWithin Γ (ball x R ∩ QFS.lattice d) y x := by
  have hr : 0 < r := lt_of_le_of_lt (norm_nonneg _) hxy
  have hs0 : 0 < Real.sin ϑ :=
    Real.sin_pos_of_pos_of_lt_pi hϑ (by linarith [pi_pos, (Γ y).apex_le, hb y])
  have hpos : 0 < (2 * r + Real.sqrt d) / Real.sin ϑ := by positivity
  have hrR : r < R := by linarith
  -- `z` and `y` have the same type and are at distance less than `2r`.
  have hzy : ‖z - y‖ < 2 * r := by
    calc ‖z - y‖ = ‖(z - x) + (x - y)‖ := by rw [sub_add_sub_cancel]
      _ ≤ ‖z - x‖ + ‖x - y‖ := norm_add_le _ _
      _ < 2 * r := by linarith
  obtain ⟨w, hwlat, hwz, hwc, hwball⟩ :=
    QFS.exists_lattice_mem_cone (v := (Γ y).axis) (Γ y).norm_axis hϑ (hb y) (Γ y).apex_le
      (by linarith : (0:ℝ) < 2 * r) (by linarith : (2 * r + Real.sqrt d) / Real.sin ϑ < R - r) z
  -- `w` also lies in the cone based at `y`.
  have hwy : w ∈ QFS.shift (QFS.cone (Γ y).axis (Γ y).apex) y := by
    have hmem : w + (z - y) ∈ QFS.shift (QFS.cone (Γ y).axis (Γ y).apex) z := by
      refine hwball ?_
      rw [Metric.mem_closedBall, dist_eq_norm]
      have he : w + (z - y) - w = z - y := by abel
      rw [he]; linarith
    rw [QFS.mem_shift] at hmem ⊢
    have he : w + (z - y) - z = w - y := by abel
    rwa [he] at hmem
  -- All four vertices lie in `B_R(x)`.
  have hxb : x ∈ ball x R ∩ QFS.lattice d := ⟨mem_ball_self (by linarith), hx⟩
  have hyb : y ∈ ball x R ∩ QFS.lattice d := by
    refine ⟨?_, hy⟩
    rw [mem_ball, dist_eq_norm, norm_sub_rev]; linarith
  have hzb : z ∈ ball x R ∩ QFS.lattice d := by
    refine ⟨?_, hz⟩
    rw [mem_ball, dist_eq_norm]; linarith
  have hwb : w ∈ ball x R ∩ QFS.lattice d := by
    refine ⟨?_, hwlat⟩
    rw [mem_ball, dist_eq_norm]
    calc ‖w - x‖ = ‖(w - z) + (z - x)‖ := by rw [sub_add_sub_cancel]
      _ ≤ ‖w - z‖ + ‖z - x‖ := norm_add_le _ _
      _ < (R - r) + r := by linarith
      _ = R := by ring
  -- `y → w ← z → x`.
  refine QFS.ConnWithin.trans (QFS.ConnWithin.of_edge hyb hwb ?_)
    (QFS.ConnWithin.trans (QFS.ConnWithin.of_edge hzb hwb ?_).symm (QFS.ConnWithin.of_edge hzb hxb ?_))
  · rw [QFS.mem_coneAt]; exact QFS.cone_subset_carrier _ hwy
  · rw [QFS.mem_coneAt, htype]; exact QFS.cone_subset_carrier _ hwc
  · rw [QFS.mem_coneAt, htype]
    have h1 : z - x ∈ (Γ y).carrier := hzV
    have h2 : x - z = -(z - x) := by abel
    rw [h2]
    exact QFS.neg_mem_doubleCone_iff.mpr h1
