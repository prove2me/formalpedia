  have hwf := ops1_wf D ℓ long hℓ (op1 D ℓ long k) (by
    rw [ops1_flat]; exact List.mem_flatMap.2 ⟨k, List.mem_range.2 hk, List.mem_singleton_self _⟩)
  simp only [op1, LOp.WF] at hwf
  rw [← hn] at hwf
  unfold cBody1
  have := cMvB_le (W := W) (B := B) sz_mv1 (c := rkS D long k) (δ := fbk D long k * (k * (ℓ - 1)))
    (E := n - (rkS D long k + fbk D long k * (k * (ℓ - 1))) + ℓ) (m := n + ℓ) (by omega)
    (by omega) (by omega) (by omega) (by omega)
