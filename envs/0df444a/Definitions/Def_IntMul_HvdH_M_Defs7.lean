/-! ## Magnitudes of the intermediate lists -/

/-- Arithmetic side conditions of the `B̃` slice (input bound `Bi`, output bound `Bo`,
multiplication operand bound `mm`, accumulator bound `Bacc`, list-move bound `Q`). -/
structure BapHyp (p s t α kb Bi Bo mm Bacc Q : ℕ) : Prop where
  hs : 0 < s
  hst : s ≤ t
  hco : Nat.Coprime s t
  hkb : t ≤ 2 ^ kb
  hBi : Bi ≤ mm
  hmm : 1 ≤ mm
  hW : (4 * p + 35) * 2 ^ (2 * p) < 2 ^ mm
  hJc : (HvdH.jIter p s t α + 1) * BD.cE1 p α ^ HvdH.jIter p s t α * 2 ^ Bi ≤ 2 ^ mm
  hmB : 2 * mm ≤ Bacc
  hAcc : (2 * HvdH.eWidth p α + 2) * 2 ^ (2 * mm) ≤ 2 ^ Bacc
  hpB : p + 1 ≤ Bacc
  hT : zsz ((t + 1 : ℕ) : ℤ) ≤ Bacc
  hSW : zsz (((s + 1) * (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) ≤ Bacc
  hJ : zsz (HvdH.jIter p s t α : ℤ) ≤ Bacc
  hc : BD.cB1 p α (HvdH.jIter p s t α) * 2 ^ Bi ≤ 2 ^ Bo
  hBo : Bo ≤ Q
  hsQ : zsz ((2 * s : ℕ) : ℤ) ≤ Q

/-! ## The slice program as a `GL.LProg` -/

