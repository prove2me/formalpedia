theorem two_affine_parameter_controls (m : ℕ) (S T : Finset (ZMod (2*m)))
    (hS : S.card=4) (h8 : 8 ∣ 2*m) (h : TwoAffineForm m S T) : TwoControlledForm m S T := by
  obtain ⟨q,hq,hN,u,v,x,heS,heT⟩ := h
  have heven : Even q := by
    obtain ⟨k,hk⟩ := h8
    exact ⟨k,by omega⟩
  have hc : ({0,(q : ZMod (2*m)),x,x+2 • (q : ZMod (2*m))} : Finset (ZMod (2*m))).card=4 := by
    rw [← heS,affine_image_card]
    exact hS
  exact ⟨q,hq,hN,heven,u,v,x,two_pattern_parameter_separation (2*m) q hN x hc,heS,heT⟩

theorem p2m_local_collision_controlled_affine_forms (m : ℕ) (hm : 0 < m)
    (S T : Finset (ZMod (2*m))) (hS : S.card=4) (hT : T.card=4)
    (hsq : ∀ z, orderedSquare S z=orderedSquare T z)
    (hnaff : ¬ Couret.InterIA.NormalForm.AffineEquivalent S T) :
    ∃ t : ZMod (2*m), (t=0 ∨ t=m) ∧
      (TwoControlledForm m S (T.image (fun x => x+t)) ∨ FourAffineForm m S (T.image (fun x => x+t))) := by
  have h8 := Couret.InterIA.Catalogue.Lifts.even_collision_eight_divides m hm S T hS hT hsq hnaff
  obtain ⟨t,ht,ho⟩ := collision_affine_forms m hm S T hS hT hsq hnaff
  refine ⟨t,ht,?_⟩
  rcases ho with h|h
  · exact Or.inl (two_affine_parameter_controls m S (T.image (fun x => x+t)) hS h8 h)
  · exact Or.inr h

