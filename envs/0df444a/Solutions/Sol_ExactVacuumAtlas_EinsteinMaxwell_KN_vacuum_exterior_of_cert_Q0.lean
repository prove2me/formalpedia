/-- `Q = 0`: the metric equals Kerr BL componentwise on the common regular set. -/
theorem gQ0 (M a : ℝ) (i j : Fin 4) : Set.EqOn (gKN M a 0 i j) (KerrBL.gKerr M a i j) (domReg M a 0) := by
  intro x hx
  fin_cases i <;> fin_cases j
  exacts [gQ0_0_0 M a hx, gQ0_0_1 M a hx, gQ0_0_2 M a hx, gQ0_0_3 M a hx, gQ0_1_0 M a hx, gQ0_1_1 M a hx, gQ0_1_2 M a hx, gQ0_1_3 M a hx, gQ0_2_0 M a hx, gQ0_2_1 M a hx, gQ0_2_2 M a hx, gQ0_2_3 M a hx, gQ0_3_0 M a hx, gQ0_3_1 M a hx, gQ0_3_2 M a hx, gQ0_3_3 M a hx]
/-- `Q = 0`: the inverse equals the Kerr BL inverse componentwise on the common regular set. -/
theorem giQ0 (M a : ℝ) (i j : Fin 4) : Set.EqOn (giKN M a 0 i j) (KerrBL.giKerr M a i j) (domReg M a 0) := by
  intro x hx
  fin_cases i <;> fin_cases j
  exacts [giQ0_0_0 M a hx, giQ0_0_1 M a hx, giQ0_0_2 M a hx, giQ0_0_3 M a hx, giQ0_1_0 M a hx, giQ0_1_1 M a hx, giQ0_1_2 M a hx, giQ0_1_3 M a hx, giQ0_2_0 M a hx, giQ0_2_1 M a hx, giQ0_2_2 M a hx, giQ0_2_3 M a hx, giQ0_3_0 M a hx, giQ0_3_1 M a hx, giQ0_3_2 M a hx, giQ0_3_3 M a hx]

/-! ## `Q = 0`: Kerr -/

theorem faradayKN_Q0 (a : ℝ) : faradayKN a 0 = 0 := by
  funext i j x; fin_cases i <;> fin_cases j <;> simp [faradayKN]

/-- KN certificate at `Q = 0` on the BL exterior (`0 < M`). -/
theorem cert_Q0_exterior (M a : ℝ) (hM : 0 < M) :
    EinsteinMaxwellCertificate (gKN M a 0) (giKN M a 0) 0 (domKN M a 0) := by
  have h := cert M a 0 hM; rwa [faradayKN_Q0 a] at h

