theorem Φ_eq (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g)
    {X : FormalODModule q A} {θ : RelativeGroupLaw.FormalCoordinates E.f 2} {w : (X.map resA).Hom X₀.toFormalODModule}
    (hrig : Rig coord θ₀ resA E g X θ w) {χ : R →ₐ[O] A} (hP : P resR Xu wu resA X w χ) :
    Φ coord θ₀ resR Xu wu resA H hs hc E g hg = χ := by
  obtain ⟨X₁, θ₁, w₁, hrig₁, hP₁⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E g hg
  obtain ⟨t, ht, htw⟩ := hrig₁.transfer H.hcoord H.hqO H.hX₀ hs hc hg hrig
  exact (hrig₁.existsUnique_P H.hPRO hs hc).unique hP₁ (P.of_transfer t ht htw hP)

theorem Rig.P_Φ (H : GHyp coord θ₀ resR Xu wu) (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g)
    {X : FormalODModule q A} {θ : RelativeGroupLaw.FormalCoordinates E.f 2} {w : (X.map resA).Hom X₀.toFormalODModule}
