variable {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [VectorLattice X]
open VectorSublattice
variable (Y : VectorSublattice X)

theorem VectorSublattice.generated_eq_span_of_pairwise_vlDisjoint {A : Set X}
    (hA : A.Pairwise IsVLDisjoint) (hA_nn : ∀ a ∈ A, 0 ≤ a) :
    (generated A).toSubmodule = Submodule.span ℝ A := by sorry
