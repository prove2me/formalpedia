/-! ## The wrapper -/

section Wrap

theorem swapsF_swL (w v : ℕ) : swapsF (swL w) v = nsw 0 w v := by
  unfold swL
  split_ifs with h
  · subst h; simp [swapsF, nsw]; split_ifs <;> omega
  · simp [swapsF]

