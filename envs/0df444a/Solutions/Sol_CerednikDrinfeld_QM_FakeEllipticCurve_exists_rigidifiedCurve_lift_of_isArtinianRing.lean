namespace M7pB21

theorem exists_isUnit_of_span_range_eq_top {A : Type} [CommRing A] [IsLocalRing A] {n : ℕ} (f : Fin n → A)
    (h : Ideal.span (Set.range f) = ⊤) : ∃ i, IsUnit (f i) := by
  by_contra hne
  push Not at hne
  have hle : Ideal.span (Set.range f) ≤ IsLocalRing.maximalIdeal A := by
    rw [Ideal.span_le]
    rintro x ⟨i, rfl⟩
    exact (IsLocalRing.mem_maximalIdeal _).mpr (hne i)
  exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top (top_le_iff.mp (h ▸ hle))

theorem exists_rigidified_isAdmissible_eta_eq_of_isLocalRing
    {r : ℕ} [Fact r.Prime] {Onr : Type} [CommRing Onr] (ι : Zp2 r →+* Onr)
    {Φ : FormalODModule r (Onr ⧸ pIdeal r Onr)}
    (M : ModuliPackage.{0, 0} r Onr)
    (η : ∀ (B : Type) [CommRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B)), Rigidified r Φ B → M.obj B ψ hB)
    (hη3 : ∀ (B : Type) [CommRing B] [IsNoetherianRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B)) (m : M.obj B ψ hB),
          ∃ (n : ℕ) (f : Fin n → B), Ideal.span (Set.range f) = ⊤ ∧
            ∀ (i : Fin n) (L : Type) [CommRing L] [IsNoetherianRing L] [Algebra B L] [IsLocalization.Away (f i) L]
              (hL : IsNilpotent (r : L)),
              ∃ t : Rigidified r Φ L, t.IsAdmissible ι ((algebraMap B L).comp ψ) ∧
                η L ((algebraMap B L).comp ψ) hL t =
                  M.map (ψ' := (algebraMap B L).comp ψ) hB hL (algebraMap B L) rfl m)
    (A : Type) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ψ : Onr →+* A) (hA : IsNilpotent (r : A))
    (m : M.obj A ψ hA) :
    ∃ t : Rigidified r Φ A, t.IsAdmissible ι ψ ∧ η A ψ hA t = m := by
  obtain ⟨n, f, hspan, hloc⟩ := hη3 A ψ hA m
  obtain ⟨i, hi⟩ := exists_isUnit_of_span_range_eq_top f hspan
  haveI : IsLocalization.Away (f i) A := IsLocalization.away_of_isUnit_of_bijective A hi Function.bijective_id
  obtain ⟨t, hadm, hη⟩ := hloc i A hA
  refine ⟨t, ?_, ?_⟩
  · exact hadm
  · exact hη.trans (M.map_id hA m)

end M7pB21

