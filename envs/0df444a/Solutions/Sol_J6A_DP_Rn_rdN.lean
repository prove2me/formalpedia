      ((J6A.PA.dL k pre post s t p α d)[1]'(by simp [J6A.PA.dL]))) rIx ((2 : ℕ) : ℤ)) 2
      ((J6A.PA.dL k pre post s t p α d)[2]'(by simp [J6A.PA.dL]))) rIx ((4 : ℕ) : ℤ)) 4
