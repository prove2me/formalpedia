open ModularCurve

theorem ModularCurve.jqNModC_self_mem_adjoin_unconditional (K : Type*) [Field K] {ℓ : ℕ} [Fact ℓ.Prime] [CharP K ℓ] :
    jqNModC K ℓ ∈ IntermediateField.adjoin K {jqModC K} := by sorry
