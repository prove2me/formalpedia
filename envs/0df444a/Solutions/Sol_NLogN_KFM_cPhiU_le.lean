  have hA' : (3 * (((d + 1) * NLogN.KFU.cScan VT (p + 2) + 1 : ℕ) : ℝ)) ≤ 10 ^ 7 * (d * ((T : ℝ) * p)) := by
    exact_mod_cast hA
  have hC' : (((d * NLogN.KFU.cRb d (p + 2) VS PM Bb + 1 : ℕ)) : ℝ) ≤ 2 * 10 ^ 8 * (d * (d * ((T : ℝ) * p))) := by
