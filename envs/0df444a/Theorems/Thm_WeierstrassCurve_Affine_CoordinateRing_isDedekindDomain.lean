theorem WeierstrassCurve.Affine.CoordinateRing.isDedekindDomain {K : Type*} [Field K] [IsAlgClosed K] (W : WeierstrassCurve K) [W.IsElliptic] : IsDedekindDomain W.toAffine.CoordinateRing := by sorry
