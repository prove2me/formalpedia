theorem OAI.InitialMeanSquare.initial_two_windows_bounded (V₁ V₂ : ℝ → ℂ)
    (hc₁ : HasCompactSupport V₁) (hc₂ : HasCompactSupport V₂)
    (hs₁ : Continuous V₁) (hs₂ : Continuous V₂) :
    ∃ A Vmax : ℝ,0 ≤ A ∧ 0 ≤ Vmax ∧
      (∀ t,‖V₁ t‖ ≤ Vmax) ∧ (∀ t,‖V₂ t‖ ≤ Vmax) ∧
      (∀ t,V₁ t ≠ 0 → |t| ≤ A) ∧ (∀ t,V₂ t ≠ 0 → |t| ≤ A) := by sorry
