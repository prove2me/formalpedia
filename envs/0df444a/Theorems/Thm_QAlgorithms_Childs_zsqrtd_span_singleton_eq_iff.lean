-- title:
--   Principal ideals of Z[√d] coincide iff the generators differ by a unit
-- statement:
--   Let $d$ be a squarefree integer with $d \ge 2$, and let $\mathbb Z[\sqrt d] = \{x + y\sqrt d : x, y \in \mathbb Z\}$. For $\xi \in \mathbb Z[\sqrt d]$ write $\xi\mathbb Z[\sqrt d]$ for the principal ideal generated by $\xi$.
--
--   For all $\xi, \zeta \in \mathbb Z[\sqrt d]$,
--
--   $$
--   \xi\,\mathbb Z[\sqrt d] = \zeta\,\mathbb Z[\sqrt d] \iff \xi = \zeta\epsilon \text{ for some unit } \epsilon \text{ of } \mathbb Z[\sqrt d].
--   $$
--
--   Thus the map $\xi \mapsto \xi\mathbb Z[\sqrt d]$ is multiplicatively periodic, with the units as its periods; this periodicity, with period the fundamental unit, underlies the periodic function used in Hallgren's algorithm for Pell's equation.
--
--   **Formalization Note** $\mathbb Z[\sqrt d]$ is Mathlib's `ℤ√d`, the principal ideal $\xi\mathbb Z[\sqrt d]$ is `Ideal.span {ξ}`, and a unit is `IsUnit`. The statement holds also for $\xi = 0$ (both sides then force $\zeta = 0$), so no nonzero hypothesis is added.
-- source:
--   Andrew Childs, Lecture Notes on Quantum Algorithms, 17 April 2025, PDF p. 43, Proposition 8.2. https://www.cs.umd.edu/~amchilds/qa/qa.pdf

import Definitions.Def_QAlgorithms_Defs_Basic
set_option autoImplicit false

namespace QAlgorithms.Childs


/-- Childs, Proposition 8.2, PDF p. 43. Let `d` be a squarefree integer with `d ≥ 2`. For
`ξ, ζ ∈ Z[√d]`, the principal ideals coincide, `ξ Z[√d] = ζ Z[√d]`, if and only if `ξ = ζ ϵ`
for some unit `ϵ` of `Z[√d]`. -/
theorem zsqrtd_span_singleton_eq_iff (d : ℤ) (hd_sqfree : Squarefree d) (hd : 2 ≤ d)
    (ξ ζ : ℤ√d) :
    Ideal.span {ξ} = Ideal.span {ζ} ↔ ∃ ϵ : ℤ√d, IsUnit ϵ ∧ ξ = ζ * ϵ := by
  sorry

end QAlgorithms.Childs
