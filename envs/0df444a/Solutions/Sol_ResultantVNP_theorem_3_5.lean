  congr 2
  funext v
  change eval t ((binomialForm f g v.1).coeff v.2.1) = _
  rw [← coeff_map,binomialForm_map]

lemma binomial_homogeneous {n : ℕ} (f g : Fin n → Fin n) (t : Fin n → ℂ) (i) :
    (X i ^ 2 - C (t i) * X (f i) * X (g i) : MvPolynomial (Fin n) ℂ).IsHomogeneous 2 :=
  (isHomogeneous_X_pow i 2).sub
    (((isHomogeneous_C (Fin n) (t i)).mul (isHomogeneous_X ℂ (f i))).mul (isHomogeneous_X ℂ (g i)))

lemma binomial_zero_iff (𝓡 : ResultantSystem) {n : ℕ} (hn : 1 ≤ n)
    (f g : Fin n → Fin n) (t : Fin n → ℂ) :
    eval t (binomialResultant 𝓡 f g) = 0 ↔
      ∃ x : Fin n → ℂ,x ≠ 0 ∧ ∀ i,x i ^ 2 = t i * x (f i) * x (g i) := by
  rw [eval_binomialResultant]
  unfold resOf
  rw [(𝓡.spec (fun _ : Fin n => 2) hn (by omega)).1]
  simp_rw [form_coeff (fun _ : Fin n => 2) _ (binomial_homogeneous f g t)]
  simp only [map_sub,map_mul,map_pow,eval_X,eval_C,sub_eq_zero]

lemma binomial_at_zero (𝓡 : ResultantSystem) {n : ℕ} (hn : 1 ≤ n)
    (f g : Fin n → Fin n) : eval (fun _ => 0) (binomialResultant 𝓡 f g) = 1 := by
  rw [eval_binomialResultant]
  have h := congrArg (Int.castRingHom ℂ) ((𝓡.spec (fun _ : Fin n => 2) hn (by omega)).2.1)
  rw [map_eval] at h
  simpa [resOf,X_pow_eq_monomial,coeff_monomial,eq_comm,Function.comp_def] using h

theorem binomial_power (𝓡 : ResultantSystem) {n : ℕ} (hn : 1 ≤ n)
    (f g : Fin n → Fin n)
    (hb : ∀ v,(Finset.univ.filter (fun u => f u = v)).card +
      (Finset.univ.filter (fun u => g u = v)).card = 2)
    (hc : ∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v) :
    ∃ c : ℕ, 1 ≤ c ∧ binomialResultant 𝓡 f g =
      (1 - ∏ i : Fin n,(X i : MvPolynomial (Fin n) ℂ)) ^ c := by
  let i₀ : Fin n := ⟨0,by omega⟩
  letI : Nonempty (Fin n) := ⟨i₀⟩
  have hzero : ∀ t : Fin n → ℂ,eval t (binomialResultant 𝓡 f g) = 0 →
      eval t (1 - ∏ i : Fin n,(X i : MvPolynomial (Fin n) ℂ)) = 0 := by
    intro t ht
    obtain ⟨x,hx,he⟩ := (binomial_zero_iff 𝓡 hn f g t).mp ht
    simp only [map_sub,map_one,map_prod,eval_X,product_parameters f g hb hc t x hx he,sub_self]
  obtain ⟨c,hc'⟩ := normalized_power binomial_irreducible hzero (fun _ => 0)
    (by simp [show n ≠ 0 by omega]) (binomial_at_zero 𝓡 hn f g)
  have hones : eval (fun _ => 1) (binomialResultant 𝓡 f g) = 0 := by
    apply (binomial_zero_iff 𝓡 hn f g _).mpr
    refine ⟨fun _ => 1,?_,?_⟩
    · intro h
      have hi := congrFun h i₀
      simp at hi
    · intro; simp
  refine ⟨c,?_,hc'⟩
  by_contra h
  have hc0 : c = 0 := by omega
  simp [hc',hc0] at hones

noncomputable def fullExponent (ι : Type) [Fintype ι] [DecidableEq ι] : ι →₀ ℕ :=
  Finsupp.indicator Finset.univ (fun _ _ => 1)

lemma fullExponent_apply {ι : Type} [Fintype ι] [DecidableEq ι] (i : ι) :
    fullExponent ι i = 1 := by simp [fullExponent]

lemma fullExponent_ne_zero {ι : Type} [Fintype ι] [DecidableEq ι] [Nonempty ι] :
    fullExponent ι ≠ 0 := by
  intro h
  let i := Classical.choice (inferInstance : Nonempty ι)
  have hh := congrArg (fun e : ι →₀ ℕ => e i) h
  simp [fullExponent_apply] at hh

lemma coeff_binomial_power {ι : Type} [Fintype ι] [DecidableEq ι] [Nonempty ι] (c : ℕ) :
    ((1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) ^ c).coeff (fullExponent ι) = -(c : ℂ) := by
  classical
  have hprod : (∏ i : ι,(X i : MvPolynomial ι ℂ)) = monomial (fullExponent ι) 1 := by
    simpa only [pow_one,fullExponent] using prod_X_pow (R := ℂ) (fun _ : ι => 1) Finset.univ
  have hconst (k : ℕ) : ((1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) ^ k).coeff 0 = 1 := by
    change constantCoeff ((1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) ^ k) = 1
    simp
  induction c with
  | zero =>
    simp only [pow_zero,Nat.cast_zero,neg_zero]
    change (C (1 : ℂ)).coeff (fullExponent ι) = 0
    exact coeff_C_of_ne_zero fullExponent_ne_zero 1
  | succ c ih =>
    rw [pow_succ,mul_sub,mul_one,coeff_sub,ih]
    have hh := coeff_mul_monomial (0 : ι →₀ ℕ) (fullExponent ι) (1 : ℂ)
      ((1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) ^ c)
    simp only [zero_add,mul_one] at hh
    rw [← hprod] at hh
    rw [hh,hconst,Nat.cast_add,Nat.cast_one]
    ring

theorem negative_squarefree_coefficient (𝓡 : ResultantSystem) {n : ℕ} (hn : 1 ≤ n)
    (f g : Fin n → Fin n)
    (hb : ∀ v,(Finset.univ.filter (fun u => f u = v)).card +
      (Finset.univ.filter (fun u => g u = v)).card = 2)
    (hc : ∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v) :
    ∃ c : ℕ, 1 ≤ c ∧ (binomialResultant 𝓡 f g).coeff (fullExponent (Fin n)) = -(c : ℂ) := by
  letI : Nonempty (Fin n) := ⟨⟨0,by omega⟩⟩
  obtain ⟨c,hc,hP⟩ := binomial_power 𝓡 hn f g hb hc
  exact ⟨c,hc,by rw [hP,coeff_binomial_power]⟩

end BinomialResultants

-- Helpers from Solutions/AssignmentContributions.lean
open Finset ResultantVNP

namespace AssignmentContributions

noncomputable def quadraticPair {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) : Sym (Fin n) 2 :=
  ⟨v.2.1.toMultiset,by
    rw [Finsupp.card_toMultiset]
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
    exact v.2.2⟩

noncomputable def coefficientTriple {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) : Sym (Fin n) 3 :=
  v.1 ::ₛ quadraticPair v

lemma coefficientTriple_count {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) (i : Fin n) :
    Multiset.count i (coefficientTriple v : Multiset (Fin n)) =
      v.2.1 i + if v.1 = i then 1 else 0 := by
  simp only [coefficientTriple,Sym.coe_cons,Multiset.count_cons]
  change (v.2.1.toMultiset).count i + _ = _
  simp [Finsupp.count_toMultiset,eq_comm]

noncomputable def occurrence {ι : Type} [DecidableEq ι] (μ : Sym ι 3 →₀ ℕ) (i : ι) : ℕ :=
  μ.sum (fun T k => k * Multiset.count i (T : Multiset ι))

lemma occurrence_mapped {n : ℕ} (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ) (i : Fin n) :
    occurrence (μ.mapDomain coefficientTriple) i =
      Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ +
      Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ := by
  classical
  rw [occurrence,Finsupp.sum_mapDomain_index]
  · simp only [coefficientTriple_count,mul_add,Finsupp.sum_add,Finsupp.weight_apply,nsmul_eq_mul,
      Nat.cast_id]
  · intro; simp
  · intros; exact add_mul _ _ _

lemma balanced_occurrence {n : ℕ} (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (i : Fin n) :
    occurrence (μ.mapDomain coefficientTriple) i =
      3 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ := by
  rw [occurrence_mapped,hb]
  omega

lemma assignment_occurrence {m : ℕ} [NeZero m] {ι : Type} [DecidableEq ι]
    (cls : ι → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) (a : ι) :
    occurrence (assignMonomial cls ν) a =
      3 * ∑ p : ZMod m × ZMod m,if a = (ν p).val then 1 else 0 := by
  classical
  have hR : (∑ p : ZMod m × ZMod m,if a = (ν (gridRight p)).val then 1 else 0) =
      ∑ p : ZMod m × ZMod m,if a = (ν p).val then 1 else 0 := by
    exact Equiv.sum_comp ((Equiv.addRight (1 : ZMod m)).prodCongr (Equiv.refl (ZMod m)))
      (fun p => if a = (ν p).val then (1 : ℕ) else 0)
  have hD : (∑ p : ZMod m × ZMod m,if a = (ν (gridDown p)).val then 1 else 0) =
      ∑ p : ZMod m × ZMod m,if a = (ν p).val then 1 else 0 := by
    exact Equiv.sum_comp ((Equiv.refl (ZMod m)).prodCongr (Equiv.addRight (1 : ZMod m)))
      (fun p => if a = (ν p).val then (1 : ℕ) else 0)
  rw [occurrence,assignMonomial,← Finsupp.sum_finsetSum_index (by intros; simp)
    (by intros; exact add_mul _ _ _)]
  simp only [Finsupp.sum_single_index,zero_mul,one_mul,assignTriple,Sym.coe_cons,Sym.coe_nil,
    Multiset.count_cons,Multiset.count_zero,zero_add,Finset.sum_add_distrib,hR,hD]
  omega

lemma assignment_occurrence_at {m : ℕ} [NeZero m] {ι : Type} [DecidableEq ι]
    (cls : ι → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) (p) :
    occurrence (assignMonomial cls ν) (ν p).val = 3 := by
  rw [assignment_occurrence]
  have hinj : Function.Injective (fun p => (ν p).val) := by
    intro p q h
    have hh := congrArg cls h
    simpa only [(ν p).property,(ν q).property] using hh
  simp only [hinj.eq_iff,Finset.sum_ite_eq,Finset.mem_univ,ite_true,mul_one]

lemma assignment_occurrence_outside {m : ℕ} [NeZero m] {ι : Type} [DecidableEq ι]
    (cls : ι → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) (a : ι)
    (ha : ∀ p,a ≠ (ν p).val) : occurrence (assignMonomial cls ν) a = 0 := by
  rw [assignment_occurrence]
  simp only [if_neg (ha _),Finset.sum_const_zero,mul_zero]

theorem equation_count_one {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν) (p) :
    Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = (ν p).val then 1 else 0) μ = 1 := by
  have h := balanced_occurrence μ hb (ν p).val
  rw [hm,assignment_occurrence_at] at h
  omega

lemma row_filter_sum {n : ℕ} (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ) (i : Fin n) :
    (μ.filter (fun v => v.1 = i)).sum (fun _ k => k) =
      Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ := by
  classical
  rw [Finsupp.sum_filter_index]
  simp only [Finsupp.weight_apply,Finsupp.sum,nsmul_eq_mul,Nat.cast_id,
    mul_ite,mul_one,mul_zero,Finsupp.support_filter,Finset.sum_filter]

lemma supported_row {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν)
    (v : CoeffVar (fun _ : Fin n => 2)) (hv : μ v ≠ 0) :
    v.1 = (ν (cls v.1)).val := by
  classical
  by_contra h
  have hout : ∀ p,v.1 ≠ (ν p).val := by
    intro p hp
    have hc := congrArg cls hp
    rw [(ν p).property] at hc
    exact h (hc.symm ▸ hp)
  have ho := balanced_occurrence μ hb v.1
  rw [hm,assignment_occurrence_outside cls ν v.1 hout] at ho
  have hw : Finsupp.weight (fun w : CoeffVar (fun _ : Fin n => 2) => if w.1 = v.1 then 1 else 0) μ = 0 := by
    omega
  have hle := Finsupp.le_weight
    (fun w : CoeffVar (fun _ : Fin n => 2) => if w.1 = v.1 then 1 else 0)
    (s := v) (by simp) μ
  rw [hw] at hle
  exact hv (Nat.eq_zero_of_le_zero hle)

theorem one_coefficient_per_equation {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν) :
    ∃ q : ZMod m × ZMod m → CoeffVar (fun _ : Fin n => 2),
      (∀ p,(q p).1 = (ν p).val) ∧ μ = ∑ p,Finsupp.single (q p) 1 := by
  classical
  have hex (p) : ∃ v : CoeffVar (fun _ : Fin n => 2),
      v.1 = (ν p).val ∧ μ.filter (fun w => w.1 = (ν p).val) = Finsupp.single v 1 := by
    have hs : (μ.filter (fun v => v.1 = (ν p).val)).sum (fun _ k => k) = 1 := by
      rw [row_filter_sum]
      exact equation_count_one cls ν μ hb hm p
    obtain ⟨v,hv⟩ := (Finsupp.sum_eq_one_iff _).mp hs
    have hval := congrArg (fun b : CoeffVar (fun _ : Fin n => 2) →₀ ℕ => b v) hv
    simp only [Finsupp.filter_apply,Finsupp.single_eq_same] at hval
    have hrow : v.1 = (ν p).val := by
      by_contra h
      simp [h] at hval
    exact ⟨v,hrow,hv⟩
  choose q hrow hq using hex
  refine ⟨q,hrow,?_⟩
  ext v
  rw [Finsupp.finsetSum_apply]
  have hsingle (p) : Finsupp.single (q p) 1 v = if v.1 = (ν p).val then μ v else 0 := by
    have h := congrArg (fun b : CoeffVar (fun _ : Fin n => 2) →₀ ℕ => b v) (hq p)
    exact h.symm
  simp_rw [hsingle]
  by_cases hv : μ v = 0
  · simp [hv]
  · have hr := supported_row cls ν μ hb hm v hv
    rw [Finset.sum_eq_single (cls v.1)]
    · simp [hr]
    · intro p _ hp
      have hne : v.1 ≠ (ν p).val := by
        intro he
        have hh := congrArg cls he
        rw [(ν p).property] at hh
        exact hp hh.symm
      simp [hne]
    · simp

lemma supported_quadratic_index {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν)
    (v : CoeffVar (fun _ : Fin n => 2)) (hv : μ v ≠ 0) (i : Fin n) (hi : v.2.1 i ≠ 0) :
    i = (ν (cls i)).val := by
  classical
  by_contra h
  have hout : ∀ p,i ≠ (ν p).val := by
    intro p hp
    have hc := congrArg cls hp
    rw [(ν p).property] at hc
    exact h (hc.symm ▸ hp)
  have ho := balanced_occurrence μ hb i
  rw [hm,assignment_occurrence_outside cls ν i hout] at ho
  have hw : Finsupp.weight (fun w : CoeffVar (fun _ : Fin n => 2) => if w.1 = i then 1 else 0) μ = 0 := by
    omega
  have hle := Finsupp.le_weight
    (fun w : CoeffVar (fun _ : Fin n => 2) => w.2.1 i) (s := v) hi μ
  rw [hb,hw,mul_zero] at hle
  exact hv (Nat.eq_zero_of_le_zero hle)

lemma quadratic_pair_exists {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) :
    ∃ a b : Fin n,v.2.1 = Finsupp.single a 1 + Finsupp.single b 1 := by
  classical
  obtain ⟨a,t,ht⟩ := Sym.exists_eq_cons_of_succ (quadraticPair v)
  obtain ⟨b,u,hu⟩ := Sym.exists_eq_cons_of_succ t
  rw [hu,Sym.eq_nil_of_card_zero u] at ht
  refine ⟨a,b,?_⟩
  ext i
  have h := congrArg (fun s : Sym (Fin n) 2 => Multiset.count i (s : Multiset (Fin n))) ht
  simpa [quadraticPair,Sym.coe_cons,Sym.coe_nil,Finsupp.single_apply,
    Multiset.count_cons,Multiset.count_singleton,eq_comm,add_comm] using h

lemma chosen_coefficient_nonzero {ι : Type} [Fintype ι] [DecidableEq ι] {n : ℕ}
    (q : ι → CoeffVar (fun _ : Fin n => 2)) (hq : Function.Injective q) (p : ι) :
    (∑ u,Finsupp.single (q u) 1) (q p) ≠ 0 := by
  classical
  simp [Finsupp.finsetSum_apply,Finsupp.single_apply,hq.eq_iff]

theorem contribution_pairs {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν)
    (q : ZMod m × ZMod m → CoeffVar (fun _ : Fin n => 2))
    (hrow : ∀ p,(q p).1 = (ν p).val) (hq : μ = ∑ p,Finsupp.single (q p) 1) :
    ∃ f g : (ZMod m × ZMod m) → (ZMod m × ZMod m),
      ∀ p,(q p).2.1 = Finsupp.single (ν (f p)).val 1 + Finsupp.single (ν (g p)).val 1 := by
  classical
  have hinj : Function.Injective q := by
    intro p r h
    have hh := congrArg (fun v : CoeffVar (fun _ : Fin n => 2) => cls v.1) h
    simpa only [hrow,(ν p).property,(ν r).property] using hh
  have hne (p) : μ (q p) ≠ 0 := by
    rw [hq]
    exact chosen_coefficient_nonzero q hinj p
  choose a b hab using fun p => quadratic_pair_exists (q p)
  refine ⟨fun p => cls (a p),fun p => cls (b p),?_⟩
  intro p
  have ha : a p = (ν (cls (a p))).val := by
    apply supported_quadratic_index cls ν μ hb hm (q p) (hne p)
    rw [hab]
    simp [Finsupp.single_apply]
  have hb' : b p = (ν (cls (b p))).val := by
    apply supported_quadratic_index cls ν μ hb hm (q p) (hne p)
    rw [hab]
    simp [Finsupp.single_apply]
  rw [hab,ha,hb']

lemma coefficientTriple_pair {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) (a b : Fin n)
    (he : v.2.1 = Finsupp.single a 1 + Finsupp.single b 1) :
    coefficientTriple v = v.1 ::ₛ a ::ₛ b ::ₛ Sym.nil := by
  apply Subtype.ext
  change v.1 ::ₘ v.2.1.toMultiset = v.1 ::ₘ a ::ₘ b ::ₘ 0
  simp [he,Finsupp.toMultiset_add]

end AssignmentContributions

-- Helpers from Solutions/PartialBinomialResultants.lean
set_option maxHeartbeats 400000
open MvPolynomial ResultantVNP Finset BinomialResultants

namespace PartialBinomialResultants

variable {ι : Type} [Fintype ι] [DecidableEq ι] {n : ℕ}

noncomputable def partialForm (e : ι ↪ Fin n) (f g : ι → ι) (i : Fin n) :
    MvPolynomial (Fin n) (MvPolynomial ι ℂ) :=
  X i ^ 2 - ∑ p : ι,C (if e p = i then X p else 0) * X (e (f p)) * X (e (g p))

lemma partialForm_active (e : ι ↪ Fin n) (f g : ι → ι) (p : ι) :
    partialForm e f g (e p) = X (e p) ^ 2 - C (X p) * X (e (f p)) * X (e (g p)) := by
  classical
  simp [partialForm,e.injective.eq_iff,apply_ite,ite_mul]

lemma partialForm_inactive (e : ι ↪ Fin n) (f g : ι → ι) (i : Fin n)
    (hi : ∀ p,e p ≠ i) : partialForm e f g i = X i ^ 2 := by
  classical
  simp [partialForm,hi]

noncomputable def partialResultant (𝓡 : ResultantSystem) (e : ι ↪ Fin n) (f g : ι → ι) :
    MvPolynomial ι ℂ :=
  aeval (fun v : CoeffVar (fun _ : Fin n => 2) => (partialForm e f g v.1).coeff v.2.1)
    (map (Int.castRingHom ℂ) (𝓡.res (fun _ => 2)))

lemma eval_partialResultant (𝓡 : ResultantSystem) (e : ι ↪ Fin n) (f g : ι → ι) (t : ι → ℂ) :
    eval t (partialResultant 𝓡 e f g) =
      resOf 𝓡 (fun _ : Fin n => 2) (fun i => map (eval t) (partialForm e f g i)) := by
  unfold partialResultant resOf
  change aeval t (aeval _ _) = aeval _ _
  rw [comp_aeval_apply]
  congr 2

lemma partialForm_homogeneous (e : ι ↪ Fin n) (f g : ι → ι) (t : ι → ℂ) (i : Fin n) :
    (map (eval t) (partialForm e f g i)).IsHomogeneous 2 := by
  classical
  by_cases hi : ∃ p,e p = i
  · obtain ⟨p,rfl⟩ := hi
    rw [partialForm_active]
    simp only [map_sub,map_mul,map_pow,map_X,map_C,eval_X]
    exact (isHomogeneous_X_pow (e p) 2).sub
      (((isHomogeneous_C (Fin n) (t p)).mul (isHomogeneous_X ℂ (e (f p)))).mul
        (isHomogeneous_X ℂ (e (g p))))
  · push_neg at hi
    rw [partialForm_inactive e f g i hi,map_pow,map_X]
    exact isHomogeneous_X_pow i 2

lemma partial_zero_iff (𝓡 : ResultantSystem) (hn : 1 ≤ n)
    (e : ι ↪ Fin n) (f g : ι → ι) (t : ι → ℂ) :
    eval t (partialResultant 𝓡 e f g) = 0 ↔
      ∃ x : Fin n → ℂ,x ≠ 0 ∧
        (∀ p,x (e p) ^ 2 = t p * x (e (f p)) * x (e (g p))) ∧
        (∀ i,(∀ p,e p ≠ i) → x i = 0) := by
  classical
  rw [eval_partialResultant]
  unfold resOf
  rw [(𝓡.spec (fun _ : Fin n => 2) hn (by omega)).1]
  simp_rw [form_coeff (fun _ : Fin n => 2) _ (partialForm_homogeneous e f g t)]
  constructor
  · rintro ⟨x,hx,h⟩
    refine ⟨x,hx,?_,?_⟩
    · intro p
      have hp := h (e p)
      rw [partialForm_active] at hp
      simpa [sub_eq_zero] using hp
    · intro i hi
      have hp := h i
      rw [partialForm_inactive e f g i hi] at hp
      simpa using hp
  · rintro ⟨x,hx,ha,hi⟩
    refine ⟨x,hx,?_⟩
    intro i
    by_cases hp : ∃ p,e p = i
    · obtain ⟨p,rfl⟩ := hp
      rw [partialForm_active]
      simpa [sub_eq_zero] using ha p
    · push_neg at hp
      rw [partialForm_inactive e f g i hp]
      simp [hi i hp]

lemma partial_at_zero (𝓡 : ResultantSystem) (hn : 1 ≤ n)
    (e : ι ↪ Fin n) (f g : ι → ι) :
    eval (fun _ => 0) (partialResultant 𝓡 e f g) = 1 := by
  rw [eval_partialResultant]
  have h := congrArg (Int.castRingHom ℂ) ((𝓡.spec (fun _ : Fin n => 2) hn (by omega)).2.1)
  rw [map_eval] at h
  have hz (i : Fin n) : map (eval (fun _ : ι => (0 : ℂ))) (partialForm e f g i) = X i ^ 2 := by
    classical
    simp [partialForm,apply_ite]
  simp_rw [hz]
  simpa [resOf,X_pow_eq_monomial,coeff_monomial,eq_comm,Function.comp_def] using h

theorem partial_power [Nonempty ι] (𝓡 : ResultantSystem)
    (e : ι ↪ Fin n) (f g : ι → ι)
    (hb : ∀ v,(Finset.univ.filter (fun u => f u = v)).card +
      (Finset.univ.filter (fun u => g u = v)).card = 2)
    (hc : ∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v) :
    ∃ c : ℕ, 1 ≤ c ∧ partialResultant 𝓡 e f g =
      (1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) ^ c := by
  classical
  let p₀ : ι := Classical.choice (inferInstance : Nonempty ι)
  have hn : 1 ≤ n := by have := (e p₀).isLt; omega
  have hzero : ∀ t : ι → ℂ,eval t (partialResultant 𝓡 e f g) = 0 →
      eval t (1 - ∏ i : ι,(X i : MvPolynomial ι ℂ)) = 0 := by
    intro t ht
    obtain ⟨x,hx,ha,hi⟩ := (partial_zero_iff 𝓡 hn e f g t).mp ht
    have hx' : (fun p => x (e p)) ≠ 0 := by
      intro hz
      apply hx
      funext i
      by_cases hp : ∃ p,e p = i
      · obtain ⟨p,rfl⟩ := hp
        exact congrFun hz p
      · push_neg at hp
        exact hi i hp
    have ht1 := product_parameters f g hb hc t (fun p => x (e p)) hx' ha
    simp only [map_sub,map_one,map_prod,eval_X,ht1,sub_self]
  obtain ⟨c,hc'⟩ := normalized_power binomial_irreducible hzero (fun _ => 0)
    (by simp) (partial_at_zero 𝓡 hn e f g)
  have hones : eval (fun _ => 1) (partialResultant 𝓡 e f g) = 0 := by
    apply (partial_zero_iff 𝓡 hn e f g _).mpr
    let x : Fin n → ℂ := fun i => if ∃ p,e p = i then 1 else 0
    have hxe (p : ι) : x (e p) = 1 := by simp [x]
    refine ⟨x,?_,?_,?_⟩
    · intro hz
      have hp := congrFun hz (e p₀)
      simp [hxe] at hp
    · intro p
      simp [hxe]
    · intro i hi
      simp [x,not_exists.mpr hi]
  refine ⟨c,?_,hc'⟩
  by_contra h
  have hc0 : c = 0 := by omega
  simp [hc',hc0] at hones

theorem partial_negative_coefficient [Nonempty ι] (𝓡 : ResultantSystem)
    (e : ι ↪ Fin n) (f g : ι → ι)
    (hb : ∀ v,(Finset.univ.filter (fun u => f u = v)).card +
      (Finset.univ.filter (fun u => g u = v)).card = 2)
    (hc : ∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v) :
    ∃ c : ℕ, 1 ≤ c ∧ (partialResultant 𝓡 e f g).coeff (fullExponent ι) = -(c : ℂ) := by
  obtain ⟨c,hc,hP⟩ := partial_power 𝓡 e f g hb hc
  exact ⟨c,hc,by rw [hP,coeff_binomial_power]⟩

end PartialBinomialResultants

