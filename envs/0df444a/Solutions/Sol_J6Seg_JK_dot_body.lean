  have hs1 := Ne.symm h1; have hs2 := Ne.symm h2; have hs3 := Ne.symm h3; have hs4 := Ne.symm h4
  have hs5 := Ne.symm h5; have hs6 := Ne.symm h6
  have hk' : k < acc.length := by omega
  set G := update (dSt P F X cs acc R T0 S0 Ls k) CD [(N : ℤ) - k] with hG
  set a := acc[k]'hk' with hav
  set c := cs[k] with hcv
