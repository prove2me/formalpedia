    centerALowerYBox.Contains (Y (lower E8TAxisProd0148PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0148PaddedInputs.centerAInput.alpha = ((949721161203312387564849132921065893757532294 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
