  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

theorem BigCtx.hst (C : BigCtx ix Isym extM n D) : ∀ i, sBD n D i ≤ tBD n D i :=
  fun i => (C.hlt i).le

