namespace MIPRE.CL
section
open Finset Module Submodule LinearMap
variable {F : Type*} [Field F] {n : ℕ}
theorem dotForm_comm (x y : Fin n → F) : dotForm F n x y = dotForm F n y x := by
  simp only [dotForm_apply]
  exact Finset.sum_congr rfl fun i _ => mul_comm _ _
end
end MIPRE.CL

namespace MIPRE.CL
section
open Finset Module Submodule LinearMap
variable {F : Type*} [Field F] {n : ℕ}
theorem mem_perp {S : Submodule F (Fin n → F)} {x : Fin n → F} :
    x ∈ perp S ↔ ∀ y ∈ S, ∑ i, y i * x i = 0 := by
  simp [perp, LinearMap.BilinForm.mem_orthogonal_iff]
end
end MIPRE.CL

/-! The uploaded declaration as `solution` (a root name declared inside the source's
namespace, so that names resolve as they do in the source). -/
namespace MIPRE.Introspection.AuxiliaryDual
open Cost Cost.PolyTimeFun LowDegree.BinaryLinear
set_option backward.isDefEq.respectTransparency false
variable {F : Type*} [Field F] {m n : ℕ}
theorem _root_.solution (A : Matrix (Fin m) (Fin n) F) :
    CL.perp (Submodule.span F (Set.range A)) = A.mulVecLin.ker := by
  ext x
  rw [CL.mem_perp, LinearMap.mem_ker]
  constructor
  · intro h
    funext i
    exact h (A i) (Submodule.subset_span ⟨i, rfl⟩)
  · intro hx y hy
    have hs : Submodule.span F (Set.range A) ≤ (CL.dotForm F n x).ker := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change CL.dotForm F n x (A i) = 0
      rw [CL.dotForm_comm]
      exact congrFun hx i
    have h := hs hy
    rw [LinearMap.mem_ker, CL.dotForm_comm] at h
    exact h
end MIPRE.Introspection.AuxiliaryDual
