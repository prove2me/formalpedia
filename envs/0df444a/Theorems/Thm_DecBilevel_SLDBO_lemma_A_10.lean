-- title:
--   Lemma A.10, (50), p. 20 — contraction of the linear-system error ‖v̄ − v*(x̄)‖
-- statement:
--   Under Assumptions 2.1 and 2.2, let $y^*(x)$ minimize $f(x,\cdot)$ for every $x$, and let the sequences be generated by Algorithm 1 from BOX 1 with $\alpha,\beta>0$ and $0<\eta<1/L_{f,1}$. For every $k\ge0$,
--   $$\begin{aligned}\|\bar v^{k+1}-v^*(\bar x^k)\|^2\le{}&(1-\eta\sigma/2)\|\bar v^k-v^*(\bar x^k)\|^2+\frac{3\eta(L_{F,1}+L_{f,2}r_v)^2}\sigma\|\bar y^k-y^*(\bar x^k)\|^2\\&+\frac{9\eta(L_{F,1}+L_{f,2}r_v)^2}{n\sigma}\sum_{i=1}^n\big(\|x^k_i-\bar x^k\|^2+\|y^k_i-\bar y^k\|^2\big)+\frac{2\eta^2\rho^2}n\sum_{i=1}^n\|t^k_{v,i}-\bar t^k_v\|^2\\&+\big(9\eta L_{f,1}^2/\sigma+2\rho^2\big)\frac1n\sum_{i=1}^n\|v^k_i-\bar v^k\|^2.\end{aligned}$$
--
--   The averaged linear-system iterate approaches $v^*(\bar x^k)$ at a linear rate, up to the lower-level error and consensus errors.
--
--   **Formalization Note.** The step-size bound $\eta<1/L_{f,1}$ is one of the bounds of (62), p. 24; the proof uses it as "$\eta\le\bar\eta\le1/L_{f,1}$" and through $\eta\sigma\le1$. It is written $\eta L_{f,1}<1$.
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 20, Lemma A.10, (50); η < 1/Lf,1 from (62), p. 24

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_10 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0)
    (ystar : E p → E q) (hystar : ∀ x, IsMinOn (avgf f x) Set.univ (ystar x)) (hηL : η * Lf1 < 1) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    ‖avg (s (k + 1)).v - vstar F f ystar (avg (s k).x)‖ ^ 2 ≤
      (1 - η * σ / 2) * ‖avg (s k).v - vstar F f ystar (avg (s k).x)‖ ^ 2 +
      3 * η * (LF1 + Lf2 * rv σ LF0) ^ 2 / σ * ‖avg (s k).y - ystar (avg (s k).x)‖ ^ 2 +
      9 * η * (LF1 + Lf2 * rv σ LF0) ^ 2 / (n * σ) * ∑ i, (‖(s k).x i - avg (s k).x‖ ^ 2 + ‖(s k).y i - avg (s k).y‖ ^ 2) +
      2 * η ^ 2 * ρ ^ 2 / n * ∑ i, ‖trV s k i - avg (trV s k)‖ ^ 2 +
      (9 * η * Lf1 ^ 2 / σ + 2 * ρ ^ 2) * (1 / n) * ∑ i, ‖(s k).v i - avg (s k).v‖ ^ 2 := by sorry

end DecBilevel.SLDBO
