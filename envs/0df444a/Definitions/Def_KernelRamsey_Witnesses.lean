-- title:
--   Witness graphs for small Ramsey lower bounds as bit-mask rows
-- statement:
--   Eight graphs as bit-mask rows: the 5-cycle, the Möbius ladder on 8 vertices, the circulant graph on $\mathbb{Z}/13\mathbb{Z}$ with differences $\{1,5,8,12\}$, the Paley graph on $\mathbb{Z}/17\mathbb{Z}$, the Paley graph on $\mathbb{Z}/101\mathbb{Z}$, and three edge-list graphs on 17, 24 and 42 vertices whose external sources have not been established.
-- source:
--   B. W. Daugherty, G. Ward and S. Ryan, Kernel-Evaluated Ramsey Bounds in Lean 4, version 1.0.0, 2026, doi:10.5281/zenodo.24505785.

import Mathlib.Tactic

namespace KernelRamsey

/-- the 5-cycle; 5 vertices, 5 edges. -/
def rows_r33 : List Nat :=
  [18, 5, 10, 20, 9]

