-- title:
--   Parabolic cohomology rank of Γ(N), denominator-free form
-- statement:
--   Let $N$ be a natural number with $2 \le N$, let $\Gamma(N) \le \mathrm{SL}_2(\mathbb{Z})$ be the principal congruence subgroup of level $N$, and let $\mu_N$ denote the index in $\mathrm{SL}_2(\mathbb{Z})$ of the subgroup $\Gamma(N) \sqcup \langle -1 \rangle$ generated by $\Gamma(N)$ together with $-1$. Let $\mathrm{Hom}_{\mathrm{par}}(\Gamma(N), \mathbb{Z})$ be the $\mathbb{Z}$-submodule of the additive group of homomorphisms from the additivisation of $\Gamma(N)$ to $\mathbb{Z}$ consisting of those $\varphi$ that vanish on every $\gamma \in \Gamma(N)$ whose matrix trace satisfies $\mathrm{tr}(\gamma)^2 = 4$, i.e. on all elements of trace $\pm 2$; this is the group-theoretic parabolic cohomology of $\Gamma(N)$ with $\mathbb{Z}$-coefficients. The assertion is the identity of natural numbers
--   $$6N \cdot \mathrm{rank}_{\mathbb{Z}} \, \mathrm{Hom}_{\mathrm{par}}(\Gamma(N), \mathbb{Z}) + 6\mu_N = 12N + N\mu_N,$$
--   where the rank is the $\mathbb{Z}$-module rank (`Module.finrank`). Written with denominators, this says that the rank equals $2\bigl(1 + \mu_N (N-6)/(12N)\bigr)$, twice the genus of $X(N)$; the form above avoids division and subtraction.
--
--   This is the group-cohomological half of the classical computation $\mathrm{rank}\, H^1_{\mathrm{par}}(\Gamma(N), \mathbb{Z}) = 2\,g(X(N))$, obtained from the freeness of the image of $\Gamma(N)$ in $\mathrm{PSL}_2(\mathbb{Z})$ (no nontrivial torsion for $N \ge 2$) together with the count of cusps, i.e. of orbits of $\langle T \rangle$ on $\mathrm{SL}_2(\mathbb{Z})/\Gamma(N)$. It is used to bound the rank of parabolic cohomology of $\Gamma(N)$ by twice the dimension of the space of cusp forms of weight $2$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_six_mul_level_mul_finrank_parabolicHoms_Gamma_add_eq.lean

import Mathlib
import Definitions.Def_ModularCurve_PeriodMap

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open scoped MatrixGroups

theorem ModularCurve.six_mul_level_mul_finrank_parabolicHoms_Gamma_add_eq (N : ℕ) (hN : 2 ≤ N) :
    6 * N * Module.finrank ℤ (ModularCurve.Period.parabolicHoms ℤ (CongruenceSubgroup.Gamma N) ℤ) +
        6 * (CongruenceSubgroup.Gamma N ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))).index =
      12 * N + N * (CongruenceSubgroup.Gamma N ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))).index := by sorry
