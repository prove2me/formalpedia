  have h := Sp.pushQ s F hi (clean_of_regs' hc) hok (bnd_P hR hA hp hd)
  rw [hv] at h
  refine h.mono (le_of_eq ?_)
  unfold uC; ring

theorem asgP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {e : Ex HS} {v a : ℤ}
    {l : List ℤ} {A D : ℕ} (hi : i.val < 56) (hf : F i = a :: l) (ha : |a| ≤ 2 ^ A)
    (hc : ∀ j ∈ e.regs, j.val < 56) (hok : e.ok (encK s F)) (hl : e.Lin)
    (hv : e.eval (encK s F) = v) (hR : RB (encK s F) A e) (hA : 2 ≤ A) (hp : Poly e = true)
    (hd : J6Seg.PreT.dg e ≤ D) (hD : 1 ≤ D) :
    Sp (.asg i e) (encK s F) (encK s (update F i (v :: l))) ((e.size + 1) * uC A D) := by
  have h := Sp.asg s F hi hf (zsz_le_AD ha hD) (clean_of_regs' hc) hok hl (bnd_P hR hA hp hd)
  rw [hv] at h
  refine h.mono ?_
