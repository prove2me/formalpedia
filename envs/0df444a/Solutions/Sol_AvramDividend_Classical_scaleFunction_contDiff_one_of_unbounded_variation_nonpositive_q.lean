    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕)
    (q : ℝ) (hq0 : q ≤ 0) (W : ℝ → ℝ) (hW : IsScaleFunction X q W)
    (hnbv : ¬ X.BoundedVariation) :
    ContDiffOn ℝ 1 W (Ioi 0) := by
  rcases lt_or_eq_of_le hq0 with hneg | hzero
  · exact False.elim
      (unbounded_scaleFunction_negative_q_impossible X q hneg W hW hnbv)
  · subst q
    exact unbounded_scale_C1_zero_discount_core X W hW hnbv
