-- Source module: Solutions.KIL6NE
/-!
# KIL6: natural-number expressions

`NE` is a small language of natural-number expressions over registers (`+`, `-` (truncation
excluded by hypothesis), `*`, `/`, `%`, `if a < b then x else y`), compiled to `Ex HS`.
`NE.good`: on a state whose registers hold the naturals `v i`, if every intermediate value is
`≤ M` and `zsz M ≤ B`, then the compiled expression is clean, well defined, `B`-bounded and
evaluates to the natural value.  This turns every descriptor computation into arithmetic.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

namespace NE

theorem le_of_OK {v : Fin HS → ℕ} {M : ℕ} : ∀ e : NE, e.OK v M → e.val v ≤ M
  | reg _, h | lit _, h => h
  | add a b, h | mul a b, h => h.2.2
  | sub a b, h => le_trans (Nat.sub_le _ _) (le_of_OK a h.1)
  | div a b, h => le_trans (Nat.div_le_self _ _) (le_of_OK a h.1)
  | mod a b, h => le_trans (Nat.mod_le _ _) (le_of_OK a h.1)
  | lt a b x y, h => by
      simp only [OK] at h; simp only [val]
      split_ifs at h ⊢ with hc
      · exact le_of_OK x h.2.2
      · exact le_of_OK y h.2.2

/-- **Compilation is correct.** -/
theorem good_sol_aux {t : IState HS} {v : Fin HS → ℕ} {M B : ℕ} (hM : zsz (M : ℤ) ≤ B) :
    ∀ e : NE, Holds t v e → e.OK v M →
      e.toEx.ok t ∧ e.toEx.Bnd t B ∧ e.toEx.eval t = (e.val v : ℤ)
  | reg i, hh, hok => by
      obtain ⟨L, hL⟩ := hh i (by simp [regs])
      refine ⟨IState.isInt_of hL, ?_, ?_⟩
      · simp only [toEx, Ex.Bnd, IState.top_eq hL]; exact le_trans (zsz_nat_le hok) hM
      · simp only [toEx, Ex.eval, IState.top_eq hL, val]
  | lit c, _, hok => ⟨trivial, le_trans (zsz_nat_le hok) hM, rfl⟩
  | add a b, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      refine ⟨⟨oa, ob⟩, ⟨ba, bb, ?_⟩, ?_⟩
      · rw [ea, eb]; exact le_trans (zsz_nat_le (by exact_mod_cast hok.2.2)) hM
      · simp only [toEx, Ex.eval, ea, eb, val]; push_cast; rfl
  | sub a b, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      have hle := hok.2.2
      have hav := le_of_OK a hok.1
      refine ⟨⟨oa, ob⟩, ⟨ba, bb, ?_⟩, ?_⟩
      · simp only [Ex.eval, ea, eb]
        rw [show (a.val v : ℤ) + -(b.val v : ℤ) = ((a.val v - b.val v : ℕ) : ℤ) by
          push_cast [Nat.cast_sub hle]; ring]
        exact le_trans (zsz_nat_le (le_trans (Nat.sub_le _ _) hav)) hM
      · simp only [toEx, Ex.eval, ea, eb, val]; push_cast [Nat.cast_sub hle]; ring
  | mul a b, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      refine ⟨⟨oa, ob⟩, ⟨ba, bb, ?_⟩, ?_⟩
      · rw [ea, eb]; exact le_trans (zsz_nat_le (by exact_mod_cast hok.2.2)) hM
      · simp only [toEx, Ex.eval, ea, eb, val]; push_cast; rfl
  | div a b, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      have hav := le_of_OK a hok.1
      refine ⟨⟨oa, ob, by rw [ea]; positivity, by rw [eb]; exact_mod_cast hok.2.2⟩,
        ⟨ba, bb, ?_⟩, ?_⟩
      · rw [ea, eb, ← Int.natCast_div]
        exact le_trans (zsz_nat_le (le_trans (Nat.div_le_self _ _) hav)) hM
      · simp only [toEx, Ex.eval, ea, eb, val]; push_cast; rfl
  | mod a b, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      have hav := le_of_OK a hok.1
      refine ⟨⟨oa, ob, by rw [ea]; positivity, by rw [eb]; exact_mod_cast hok.2.2⟩,
        ⟨ba, bb, ?_⟩, ?_⟩
      · rw [ea, eb, ← Int.natCast_mod]
        exact le_trans (zsz_nat_le (le_trans (Nat.mod_le _ _) hav)) hM
      · simp only [toEx, Ex.eval, ea, eb, val]; push_cast; rfl
  | lt a b x y, hh, hok => by
      obtain ⟨oa, ba, ea⟩ := good_sol_aux hM a (fun i hi => hh i (by simp [regs, hi])) hok.1
      obtain ⟨ob, bb, eb⟩ := good_sol_aux hM b (fun i hi => hh i (by simp [regs, hi])) hok.2.1
      have hav := le_of_OK a hok.1
      have hbv := le_of_OK b hok.2.1
      have hc : (Ex.add a.toEx (.neg b.toEx)).eval t < 0 ↔ a.val v < b.val v := by
        simp only [Ex.eval, ea, eb]; omega
      have hcB : (Ex.add a.toEx (.neg b.toEx)).Bnd t B := by
        refine ⟨ba, bb, ?_⟩
        simp only [Ex.eval, ea, eb]
        refine le_trans (zsz_mono ?_) hM
        simp only [Int.natAbs_natCast]; omega
      have hok3 := hok.2.2
      by_cases h : a.val v < b.val v
      · rw [if_pos h] at hok3
        obtain ⟨ox, bx, ex⟩ := good_sol_aux hM x (fun i hi => hh i (by simp [regs, hi])) hok3
        refine ⟨⟨⟨oa, ob⟩, by rw [if_pos (hc.2 h)]; exact ox⟩, ⟨hcB, by rw [if_pos (hc.2 h)]; exact bx⟩,
          ?_⟩
        show (if (Ex.add a.toEx (.neg b.toEx)).eval t < 0 then x.toEx.eval t else y.toEx.eval t) = _
        rw [if_pos (hc.2 h), ex]; simp [val, h]
      · rw [if_neg h] at hok3
        obtain ⟨oy, by', ey⟩ := good_sol_aux hM y (fun i hi => hh i (by simp [regs, hi])) hok3
        have hn : ¬ (Ex.add a.toEx (.neg b.toEx)).eval t < 0 := fun h' => h (hc.1 h')
        refine ⟨⟨⟨oa, ob⟩, by rw [if_neg hn]; exact oy⟩, ⟨hcB, by rw [if_neg hn]; exact by'⟩, ?_⟩
        show (if (Ex.add a.toEx (.neg b.toEx)).eval t < 0 then x.toEx.eval t else y.toEx.eval t) = _
        rw [if_neg hn, ey]; simp [val, h]

end NE

