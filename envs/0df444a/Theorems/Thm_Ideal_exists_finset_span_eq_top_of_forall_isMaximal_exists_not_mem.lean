theorem Ideal.exists_finset_span_eq_top_of_forall_isMaximal_exists_not_mem
    {S : Type} [CommRing S] (P : S → Prop)
    (h : ∀ 𝔭 : PrimeSpectrum S, 𝔭.asIdeal.IsMaximal → ∃ g : S, g ∉ 𝔭.asIdeal ∧ P g) :
    ∃ (k : ℕ) (g : Fin k → S), Ideal.span (Set.range g) = ⊤ ∧ ∀ i, P (g i) := by sorry
