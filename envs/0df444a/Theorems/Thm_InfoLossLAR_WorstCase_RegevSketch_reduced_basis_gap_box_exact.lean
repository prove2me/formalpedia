-- title:
--   An exact coefficient cube for the shortest-vector threshold after LLL
-- statement:
--   Let $n>0$, let $B$ be a nonsingular $n\times n$ integer matrix, and let $\delta\ge 0$ be rational. Write $B_{\mathrm{LLL}}$ for the native LLL output basis of the lattice generated by the columns of $B$.
--
--   The shortest nonzero vector length $\lambda_1(B)$ satisfies $\lambda_1(B)\le\delta$ if and only if there is an integer vector $z$ such that
--   $$
--   \max_i |z_i|\le n\,2^{n-1}(n+1)^n
--   \qquad\text{and}\qquad
--   0<\|B_{\mathrm{LLL}}z\|_2^2\le\delta^2.
--   $$
--   The search cube depends only on dimension. It provides the correctness criterion for a finite exact scan using the reduced basis.
-- source:
--   A.K. Lenstra, H.W. Lenstra Jr. and L. Lovász, Factoring Polynomials with Rational Coefficients, Math. Ann. 261 (1982), §1, https://doi.org/10.1007/BF01457454, reduced-basis inequalities (1.4)–(1.7). The displayed coefficient bound is derived from these inequalities by back substitution for the concrete native basis.

import Definitions.Def_InfoLossLAR_WorstCase_LatticeProblems
import Definitions.Def_LARLLL_CurrentData

set_option autoImplicit false
open InfoLossLAR.WorstCase
open scoped BigOperators

namespace InfoLossLAR.WorstCase.RegevSketch

theorem reduced_basis_gap_box_exact {n : ℕ} (hn : 0 < n)
    (B : Matrix (Fin n) (Fin n) ℤ) (hB : B.det ≠ 0) (δ : ℚ) (hδ : 0 ≤ δ) :
    let normSq (z : Fin n → ℤ) : ℚ :=
      ((∑ i : Fin n, (((NativeLLL.basis B).mulVec z) i)^2 : ℤ) : ℚ)
    lam1 B ≤ (δ : ℝ) ↔ ∃ z : Fin n → ℤ,
      (∀ i, (z i).natAbs ≤ n * 2^(n-1) * (n+1)^n) ∧
        0 < normSq z ∧ normSq z ≤ δ^2 := by sorry

end InfoLossLAR.WorstCase.RegevSketch
