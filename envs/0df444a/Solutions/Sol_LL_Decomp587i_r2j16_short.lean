def integrand4 (ω : ℝ → ℝ) (φ : ℝ) (x : R4) : ℝ :=
  ω ((φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1) /
    (x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2)

def f_smooth (φ : ℝ) (x : R4) : ℝ :=
  1 / (x.1 * x.2.1 * x.2.2.1 * x.2.2.2 * (φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2))

def prod_inv4 (x : R4) : ℝ :=
