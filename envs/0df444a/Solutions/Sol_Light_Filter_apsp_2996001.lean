theorem Ends.callTo (hp : Meets lim P p (d + 1) vals μ T' R)
    (h : ∀ r μ', R r μ' → Q ⟨Light.frame (setLocal l x r), μ'⟩)
    (ha : (∀ e ∈ args, e.Safe lim ⟨Light.frame l, μ⟩) ∧ args.map (·.val ⟨Light.frame l, μ⟩) = vals := by
      (( (try have := Light.Std.space_le (by assumption))
