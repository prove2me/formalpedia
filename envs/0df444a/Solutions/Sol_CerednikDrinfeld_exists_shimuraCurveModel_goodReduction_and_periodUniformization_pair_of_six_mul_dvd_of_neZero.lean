  obtain ⟨n, hn, hn0⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp
    ((EquivariantUniformization.eFull_restrict_U_torsion_and_equiv 𝒰).2.1 u)
  refine isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, hn, hinj ?_⟩
  rw [map_nsmul, map_zero, he]
  exact hn0

