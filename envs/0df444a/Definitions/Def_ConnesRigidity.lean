    (spectralTorusWindow_measureReal_pos μ a b hsmall hε ha hb)
    (spectralTorusWindow_measurable a b) hε hsmall
    (spectralTorusWindow_compl_measureReal_le_sq μ a b ha hb)
    f s hs hvariation
end
