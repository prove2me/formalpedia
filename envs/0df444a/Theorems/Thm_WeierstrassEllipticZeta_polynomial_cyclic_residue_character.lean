-- title:
--   Canonical residue character of a cyclic algebra
-- statement:
--   Let $K$ be a field, let $A$ be a commutative $K$-algebra, and fix $x\in A$ and $z\in K$. Suppose every element of $A$ is a polynomial in $x$ with coefficients in $K$, and suppose that for every $q\in K[t]$,
--
--   $$
--   q(x)\text{ is nilpotent}\quad\Longleftrightarrow\quad q(z)=0.
--   $$
--
--   There is a unique $K$-algebra homomorphism $\chi:A\to K$ compatible with polynomial evaluation. It satisfies
--
--   $$
--   \chi(q(x))=q(z),\qquad
--   \chi(a)=0\ \Longleftrightarrow\ a\text{ is nilpotent},\qquad
--   \chi(A)=K.
--   $$
--
--   Thus scalar evaluation is well defined on $A$ and identifies its nilpotent elements as the kernel of a concrete surjective algebra homomorphism. No finite-dimensionality hypothesis or restriction on the characteristic of $K$ is required.
-- source:
--   Derived supporting algebra for the Senthil Kumar mission. In a commutative K-algebra generated by x, assume q(x) is nilpotent exactly when q(z)=0 for every polynomial q. There is a unique evaluation-compatible K-algebra homomorphism to K; it is surjective and its kernel consists exactly of nilpotent elements. No finite-dimensionality or characteristic-zero assumption is needed. This is inferred supporting algebra, not a separately quoted theorem from the article. Pinned Mathlib revision 0df444a360eaa60ab8c11dca51a86af692955474: RingTheory/Ideal/Quotient/Operations.lean, AlgHom.liftOfSurjective and AlgHom.liftOfSurjective_apply (lines 555-587); Algebra/Polynomial/AlgebraMap.lean, Polynomial.aeval. Primary documentation: https://leanprover-community.github.io/mathlib4_docs/Mathlib/RingTheory/Ideal/Quotient/Operations.html . No new definitions or platform dependencies.

import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Nilpotent.Defs

open Polynomial

theorem WeierstrassEllipticZeta.polynomial_cyclic_residue_character
    (K A : Type*) [Field K] [CommRing A] [Algebra K A]
    (x : A) (z : K)
    (hsurj : Function.Surjective (fun q : Polynomial K =>
      q.eval₂ (algebraMap K A) x))
    (hnil : ∀ q : Polynomial K,
      IsNilpotent (q.eval₂ (algebraMap K A) x) ↔ q.eval z = 0) :
    ∃! χ : A →ₐ[K] K,
      (∀ q : Polynomial K, χ (q.eval₂ (algebraMap K A) x) = q.eval z) ∧
      (∀ a : A, χ a = 0 ↔ IsNilpotent a) ∧ Function.Surjective χ := by sorry
