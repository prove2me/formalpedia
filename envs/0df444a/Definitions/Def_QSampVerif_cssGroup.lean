-- title:
--   Positive-sign CSS stabilizer groups, the distance set, transversal operators, encoded states and strict decoders
-- statement:
--   For binary subspaces $S_X,S_Z\subseteq\mathbb F_2^N$, the **positive-sign CSS stabilizer group** is the group of $N$-qubit unitaries generated by the phase-$+1$ Pauli operators $X^u$ ($u\in S_X$) and $Z^w$ ($w\in S_Z$). With the published stabilizer layer:
--
--   1. the **codespace** (Definition 3.7) is the common $+1$ eigenspace;
--   2. the **distance set** (Definition 3.8, (32)) is the set of weights $\mathrm{wt}(P)$ of Pauli operators $P$ that commute with the whole group but are not in it up to a phase; the code distance is its least element;
--   3. $X^{\otimes N}$, $Z^{\otimes N}$ are the transversal Paulis, and $\mathrm{CNOT}^{\otimes N}$ acts on two blocks by $|p,q\rangle\mapsto|p,q\oplus p\rangle$;
--   4. an **encoder** is a layered Clifford+T circuit on $N$ wires; its encoded state $|b_L\rangle$ is its output on $|b\rangle$ in a designated input wire and $|0\rangle$ elsewhere;
--   5. the **strict decoders** (Definition 3.10, with the strict check of Lemma 3.13): a computational-basis outcome $c$ is rejected unless $w\cdot c=0$ for every $w\in S_Z$, and otherwise decoded to the parity $\mathbf 1\cdot c$ (the eigenvalue of logical $Z^{\otimes N}$); a Hadamard-basis outcome is rejected unless $u\cdot c=0$ for every $u\in S_X$, and otherwise decoded to $\mathbf 1\cdot c$ ($0$ is $+$, $1$ is $-$).
-- source:
--   Chung, Cojocaru, Lee, Lin, Classical Verification of Quantum Sampling with Negligible Error, STOC 2027 submission (held version, sha256 dbc19d8f…7ee7), Definitions 3.7, 3.8, 3.10, pp.19–20 (PDF 20–21); Lemma 3.13, p.21 (PDF 22)

import Definitions.Def_QAlgorithms_Defs_QECC
import Definitions.Def_QSampVerif_tup

set_option autoImplicit false

namespace QSampVerif

open QAlgorithms QAlgorithms.Complexity QAlgorithms.Stabilizer

/-- The Pauli factors of `X^u`: `X` on the wires where `u` is `1`, `I` elsewhere. -/
def xOps {N : ℕ} (u : Fin N → ZMod 2) : Fin N → Pauli := fun q => if u q = 1 then Pauli.X else Pauli.I

/-- The Pauli factors of `Z^w`. -/
def zOps {N : ℕ} (w : Fin N → ZMod 2) : Fin N → Pauli := fun q => if w q = 1 then Pauli.Z else Pauli.I

/-- Chung, Cojocaru, Lee, Lin, STOC 2027 submission (held version, sha256 dbc19d8f…7ee7),
Lemma 3.13, p.21 (PDF 22): the stabilizer group of the positive-sign CSS code with `X`-check space
`Sx` and `Z`-check space `Sz` (binary subspaces of `F₂^N`): the group generated by the phase-`+1`
Pauli matrices `X^u` (`u ∈ Sx`) and `Z^w` (`w ∈ Sz`), as a subgroup of the unitary group (the
setting of the published `IsStabilizerGroup`, `stabilizedSpace`, `pauliCentralizer`,
`phaseMultiples`). -/
noncomputable def cssGroup {N : ℕ} (Sx Sz : Submodule (ZMod 2) (Fin N → ZMod 2)) :
    Subgroup (Matrix.unitaryGroup (Qubits N) ℂ) :=
  Subgroup.closure
    ({U | ∃ u ∈ Sx, (U : Matrix (Qubits N) (Qubits N) ℂ) = pauliOps (xOps u)} ∪
      {U | ∃ w ∈ Sz, (U : Matrix (Qubits N) (Qubits N) ℂ) = pauliOps (zOps w)})

/-- Definition 3.8, (32), p.19 (PDF 20): the weights `wt(P)` of the Pauli operators `P` in the
phase-free normalizer `N(S̄)` (commuting with every element of `S`) that are not in `S̄`, the
stabilizer group with phases discarded. The code distance is the least element of this set. -/
def codeDistanceSet {N : ℕ} (S : Subgroup (Matrix.unitaryGroup (Qubits N) ℂ)) : Set ℕ :=
  {d | ∃ P : PauliString N,
    (∃ U ∈ pauliCentralizer S, (U : Matrix (Qubits N) (Qubits N) ℂ) = P.toMatrix) ∧
    (∀ U ∈ phaseMultiples S, (U : Matrix (Qubits N) (Qubits N) ℂ) ≠ P.toMatrix) ∧
    P.weight = d}

/-- The transversal operator `P^{⊗N}` with `P` on every wire. -/
noncomputable def allPauli (N : ℕ) (P : Pauli) : Matrix (Qubits N) (Qubits N) ℂ :=
  pauliOps (fun _ => P)

/-- Coordinatewise CNOT between two blocks of `N` qubits (`CNOT^{⊗N}`, control block first):
`|p, q⟩ ↦ |p, q ⊕ p⟩`. -/
def transversalCNOT (N : ℕ) : Matrix (Qubits N × Qubits N) (Qubits N × Qubits N) ℂ :=
  Matrix.of fun p q => if p.1 = q.1 ∧ p.2 = (fun i => xor (q.2 i) (q.1 i)) then 1 else 0

/-- The state produced by the encoder circuit `enc` from `|b⟩` on the input wire `i` and `|0⟩` on
every other wire. -/
noncomputable def encodedState {N : ℕ} (enc : Layered N) (i : Fin N) (b : Bool) :
    EuclideanSpace ℂ (Qubits N) :=
  WithLp.toLp 2 (runLayered enc (fun y => if y = Function.update (fun _ => false) i b then 1 else 0))

/-- Definition 3.10, p.20 (PDF 21), with the strict check of Lemma 3.13 ("The measurement check
rejects every nonzero syndrome"): the strict `Z`-basis decoder of the CSS code with `Z`-check
space `Sz`. A computational-basis outcome `c` is rejected (`none`, `⊥`) unless every `Z`-check is
satisfied (`w · c = 0` for all `w ∈ Sz`); otherwise the logical outcome is the eigenvalue of the
logical `Z^{⊗N}`, i.e. the parity `1 · c` (`false` is `0`, `true` is `1`). -/
noncomputable def strictDecZ {N : ℕ} (Sz : Submodule (ZMod 2) (Fin N → ZMod 2))
    (c : Fin N → ZMod 2) : Option Bool :=
  open Classical in
  if ∀ w ∈ Sz, w ⬝ᵥ c = 0 then some (decide ((fun _ => (1 : ZMod 2)) ⬝ᵥ c = 1)) else none

/-- The strict `X`-basis decoder: a Hadamard-basis outcome `c` is rejected unless every `X`-check
is satisfied (`u · c = 0` for all `u ∈ Sx`); otherwise the logical outcome is the parity `1 · c`
of the logical `X^{⊗N}` (`false` is `+`, `true` is `−`). -/
noncomputable def strictDecX {N : ℕ} (Sx : Submodule (ZMod 2) (Fin N → ZMod 2))
    (c : Fin N → ZMod 2) : Option Bool :=
  open Classical in
  if ∀ u ∈ Sx, u ⬝ᵥ c = 0 then some (decide ((fun _ => (1 : ZMod 2)) ⬝ᵥ c = 1)) else none

/-- A measured word as a binary string. -/
def wordStr {N : ℕ} (c : Fin N → ZMod 2) : Str := List.ofFn fun i => decide (c i = 1)

/-- A decoder output as a binary string: `⊥ ↦ 0`, `b ↦ 1 b`. -/
def encOptBool : Option Bool → Str
  | none => [false]
  | some b => [true, b]

end QSampVerif


