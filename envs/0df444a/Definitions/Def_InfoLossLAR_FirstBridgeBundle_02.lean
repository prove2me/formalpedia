/-! Real integer coordinate inversion for the affine emitter. Integer sums
use actual rational accumulation followed by exact integer extraction;
prefix sums implement the actual integral path inverse. Division truncates
towards zero, preserving the native exactQuotient behavior on signed loads. -/
namespace Integration9_9.TM2NativeEmitterCoordinates
open AFT AFT.RationalNumerics AFT.BinaryArithmetic
open OAI.MetricKMedian.Binary OAI.MetricKMedian.Binary.Automatic
open TM2NativeSliceProbability
open scoped BigOperators


@[fun_prop] theorem sum_poly : Poly (List.sum : List ℤ→ℤ) := ⟨_root_.Integration9_9.TM2NativeEmitterCoordinates.sumProgram⟩
@[fun_prop] theorem natAbs_poly : Poly Int.natAbs := ⟨PolyProgram.intAbs⟩
@[fun_prop] theorem natDiv_poly : Poly (fun x : ℕ×ℕ=>x.1/x.2) := ⟨PolyProgram.natDiv⟩


@[fun_prop] theorem truncQuot_poly : Poly _root_.Integration9_9.TM2NativeEmitterCoordinates.truncQuot := by unfold _root_.Integration9_9.TM2NativeEmitterCoordinates.truncQuot;fun_prop


@[fun_prop] theorem path_poly : Poly _root_.Integration9_9.TM2NativeEmitterCoordinates.path := by
  have hi : Poly (fun xs : List ℤ=>List.range (xs.length-1)) := by
    have h : Poly (fun xs : List ℤ=>List.range xs.tail.length) :=
      Poly.comp (f := fun ys : List ℤ=>List.range ys.length) (g := fun xs : List ℤ=>xs.tail)
        (Poly.list_indices (α := ℤ)) Poly.list_tail
    simpa only [List.length_tail] using h
  have ht : Poly (fun x : List ℤ×ℕ=>x.1.take (x.2+1)) :=
    Poly.comp (f := fun x : List ℤ×ℕ=>x.1.take x.2) (g := fun x : List ℤ×ℕ=>(x.1,x.2+1))
      (_root_.Integration9_9.TM2NativeFiniteDraw.take_poly (α := ℤ)) (by fun_prop)
  have hv : Poly (fun x : List ℤ×ℕ=>(x.1.take (x.2+1)).sum) := Poly.comp _root_.Integration9_9.TM2NativeEmitterCoordinates.sum_poly ht
  unfold _root_.Integration9_9.TM2NativeEmitterCoordinates.path
  exact Poly.list_map hv hi











@[fun_prop] theorem charge_poly : Poly _root_.Integration9_9.TM2NativeEmitterCoordinates.charge := by unfold _root_.Integration9_9.TM2NativeEmitterCoordinates.charge;fun_prop


@[fun_prop] theorem shifted_poly : Poly _root_.Integration9_9.TM2NativeEmitterCoordinates.shifted := by
  have hi : Poly (fun x : ℕ×(List ℤ×List ℤ)=>List.range x.2.2.length) :=
    Poly.comp (f := fun xs : List ℤ=>List.range xs.length) (g := fun x : ℕ×(List ℤ×List ℤ)=>x.2.2)
      (Poly.list_indices (α := ℤ)) (by fun_prop)
  unfold _root_.Integration9_9.TM2NativeEmitterCoordinates.shifted
  fun_prop


@[fun_prop] theorem current_poly : Poly _root_.Integration9_9.TM2NativeEmitterCoordinates.current := by unfold _root_.Integration9_9.TM2NativeEmitterCoordinates.current;fun_prop
















