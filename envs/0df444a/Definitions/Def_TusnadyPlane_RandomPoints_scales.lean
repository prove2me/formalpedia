-- title:
--   Actual digit information, potential, gains, and good transitions
-- statement:
--   Fix integers $n\ge1$, $b\ge3$, $h\ge1$, and put $M=b^{h-1}$. At stage $j\le h$, horizontal intervals have width $b^{-j}$ and vertical intervals have height $b^{j-h}$. With the endpoint average $a^I$, define
--   $$Z_j=\frac1{bM}\sum_{\text{stage-}j\ I\times B}\operatorname{osc}_B a^I.$$
--   The information $\mathcal F_j$ is the sigma-algebra generated by all heights and the first $j$ horizontal digits. Digit $k$ is $\lfloor b^{k+1}U\rfloor\bmod b$ for $U<1$; at $U=1$ use all digits $b-1$. This selects terminating expansions at internal grid points and agrees with the source's unique digits off a countable null set.
--   For transition $j<h$, a comparison rectangle uses an old horizontal interval and a new vertical interval. Its inner region deletes the bottom and top old cells; $m_R$ is its point count. Put
--   $$\delta_j=\frac1{4bM}\sum_R\sqrt{m_R},\qquad\delta_*=\frac1{8b^{3/2}}\sqrt{n/M}.$$
--   A region is heavy exactly when $m_R>bn/M$. The event $G_j$ says that non-heavy inner regions contain at least $n/2$ points in total; $G=\bigcap_{j<h}G_j$. These events depend only on the sample. Finally,
--   $$T=\sum_{j<h}(Z_{j+1}-\mathbb E[Z_{j+1}\mid\mathcal F_j]).$$
--   Every quantity is computed from the actual points. Conditional gain or concentration is never assumed in a definition. Real powers, divisions and square roots are real; stage indices run only through their stated valid ranges.
-- source:
--   Zhewei Wei, Tight Bounds for Tusnády’s Problem in the Plane, STOC 2027 submission #313 (October 2026), printed p. 8–11 (PDF p. 9–12), §2.4, (1), (9)–(13)

import Mathlib
import Definitions.Def_TusnadyPlane_RandomPoints_oscillation
import Definitions.Def_TusnadyPlane_RandomPoints_sample

noncomputable section

namespace TusnadyPlane.RandomPoints

/-- Stage intervals have endpoints k / b^s. §§2.4. -/
def gridLo (b s k : ℕ) : ℝ := (k : ℝ) / (b : ℝ)^s

def gridHi (b s k : ℕ) : ℝ := ((k : ℝ)+1) / (b : ℝ)^s

def comparisonCount (b h : ℕ) : ℕ := b^(h-1)

/-- (1), with b^h = bM; horizontal endpoints closed, vertical cells half-open. -/
def potential {n : ℕ} (b h j : ℕ) (χ : Coloring n) (P : Sample n) : ℝ :=
  (1 / ((b : ℝ) * comparisonCount b h)) *
    ∑ k : Fin (b^j), ∑ l : Fin (b^(h-j)),
      oscillation (Set.Ico (gridLo b (h-j) l.val) (gridHi b (h-j) l.val))
        (endpointAverage P χ (gridLo b j k.val) (gridHi b j k.val))

/-- The k-th digit (zero based). Use the terminating expansion on b-adic
rationals below 1, and the all-(b-1) expansion at 1. Off the countable
b-adic boundary set these are the unique base-b digits, hence agree a.e.
with the source's digits under the square law. -/
def horizontalDigit (b k : ℕ) (u : ℝ) : ℕ :=
  if u = 1 then b-1 else ⌊(b : ℝ)^(k+1) * u⌋₊ % b

/-- Actual heights and first j horizontal digits; no free filtration. §2.4. -/
def digitData {n : ℕ} (b j : ℕ) (P : Sample n) :
    Fin n → ℝ × (Fin j → ℕ) :=
  fun i => ((P i).2, fun k => horizontalDigit b k.val (P i).1)

@[instance_reducible]
def digitSigma (n b j : ℕ) : MeasurableSpace (Sample n) :=
  MeasurableSpace.comap (digitData (n := n) b j) inferInstance

/-- Half-open comparison rectangle, stripped of its bottom and top old cells. -/
def innerRegion (b h j k l : ℕ) : Set (ℝ × ℝ) :=
  Set.prod (Set.Ico (gridLo b j k) (gridHi b j k))
    (Set.Ico (gridLo b (h-j-1) l + 1/(b : ℝ)^(h-j))
      (gridHi b (h-j-1) l - 1/(b : ℝ)^(h-j)))

open scoped Classical in
def innerCount {n : ℕ} (b h j k l : ℕ) (P : Sample n) : ℕ :=
  (Finset.univ.filter (fun i => P i ∈ innerRegion b h j k l)).card

/-- Conditional gain target (11), independent of colors. -/
def delta {n : ℕ} (b h j : ℕ) (P : Sample n) : ℝ :=
  (1 / (4 * (b : ℝ) * comparisonCount b h)) *
    ∑ k : Fin (b^j), ∑ l : Fin (b^(h-j-1)), Real.sqrt (innerCount b h j k.val l.val P)

def deltaStar (n b h : ℕ) : ℝ :=
  (1 / (8 * (b : ℝ) ^ (3/2 : ℝ))) * Real.sqrt ((n : ℝ) / comparisonCount b h)

/-- Non-heavy means m_R ≤ bn/M, and goodness counts ≥ n/2 points. -/
def GoodTransition (n b h j : ℕ) : Set (Sample n) :=
  {P | (n : ℝ)/2 ≤ ∑ k : Fin (b^j), ∑ l : Fin (b^(h-j-1)),
    let m := innerCount b h j k.val l.val P
    if (m : ℝ) ≤ (b : ℝ)*n/comparisonCount b h then (m : ℝ) else 0}

def AllGood (n b h : ℕ) : Set (Sample n) := {P | ∀ j < h, P ∈ GoodTransition n b h j}

/-- Fluctuation term of (10), using the actual conditional expectations. -/
def fluctuation {n : ℕ} (b h : ℕ) (χ : Coloring n) (P : Sample n) : ℝ :=
  ∑ j ∈ Finset.range h, (potential b h (j+1) χ P -
    (MeasureTheory.condExp (digitSigma n b j) (sampleLaw n) (potential b h (j+1) χ)) P)

end TusnadyPlane.RandomPoints


