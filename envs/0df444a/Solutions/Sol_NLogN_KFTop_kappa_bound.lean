/-- **The entry procedure under the side conditions of `P14Need`.** -/
theorem mainRun (jG jE jT jL jW : Fin Pp) (rowC : IStmt HS Pp)
    (hG : tbl jG = logC jG (coreC jE)) (hEc : tbl jE = eaccC jE (NLogN.KFW.bodyC jT jW))
    (hT : tbl jT = NLogN.KFW.topC jT jL) (hW : tbl jW = lowC jW jL) (hL : tbl jL = levC jL rowC)
    {Kc : ℝ} (hKc : 0 ≤ Kc) (hRow : RowU Isym tbl rowC Kc)
    {K r Z P D S ρ p w : ℕ} (hρ : ρ < K) (hK6 : 6 ≤ K) (hr : 1 ≤ r)
    (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (hS : 1 ≤ S) (hP : 1 ≤ P) (hD : 1 ≤ D)
    (hZ32 : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z) (hp : zsz (p : ℤ) ≤ Z)
    (hwZ : w + KFM.EwB NLogN.KFW.A0 D + 2 < 2 ^ Z) (hrZ : 2 * (2 * Z + 4) ^ 3 + 2 ≤ r)
    (st : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (xs : List (Fin r → ℂ)) (hx : RecRep r p zs xs)
    (hl : xs.length = AModel.vol (Butterfly.layerShape P K D S)) (h0 : f 0 = gflat zs ++ l)
    (h36 : f 36 = [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ), (Z : ℤ)])
    (hfree : ∀ j : Fin HS, j ≠ 0 → j ≠ 36 → j.val < 50 → f j = [])
    (hb : NLogN.KFB.GB w zs) (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1)
    (hex : ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)) :
    ∃ c : ℕ, IRuns Isym tbl (p14C jG) (NLogN.KIL.encK st f)
        (NLogN.KIL.encK st (Function.update f 0 (gflat (Classical.choose hex) ++ l))) c ∧
      (c : ℝ) ≤ Mb0 * (coefF (18 * Kc + 18) K D * ((P * 2 ^ (K * D) * S : ℕ) : ℝ) *
        (Xf r (KFR.PsiR r Z) (w + KFM.EwB NLogN.KFW.A0 D) : ℝ)) := by
  have hK : 1 ≤ K := by omega
  have hZr : Z + 32 ≤ r := by
    have h1 : 4 ^ 2 ≤ (2 * Z + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h2 : (2 * Z + 4) ^ 3 = (2 * Z + 4) ^ 2 * (2 * Z + 4) := pow_succ _ _
    have h3 : 4 ^ 2 * (2 * Z + 4) ≤ (2 * Z + 4) ^ 2 * (2 * Z + 4) := Nat.mul_le_mul_right _ h1
    omega
  set k := Nat.log mC D with hk
  set q0 := q0f D k with hq
  set Bp := padB (P * 2 ^ (K * q0)) (P8Lift.Wc ^ k) with hBp
  set H := w + KFM.EwB NLogN.KFW.A0 D with hH
  have hHZ : H + 1 < 2 ^ Z := by omega
  have LV := lvQ_all (Isym := Isym) (tbl := tbl) (jL := jL) (rowC := rowC) (K := K) (r := r)
    (Z := Z) (Zr := Z + 30) (H := H) hRow hKc hL hK6 hr hKZ (by omega) (by omega) hHZ
  have hVt : zsz ((Vb K (K * D) S r H 0 P : ℕ) : ℤ) ≤ Z + 30 :=
    zszN_lt (Vb_top_lt hK hP hS hr hD hZ32 hwZ)
  have hVl : ∀ j ≤ k, zsz ((Vb K (K * (D - q0)) S r H j Bp : ℕ) : ℤ) ≤ Z + 30 :=
    fun j hj => zszN_lt (Vb_low_lt hK hP hS hr hD hk hq hBp hZ32 hwZ j hj)
  have hMb : zsz ((MbB K P D w k q0 Bp : ℕ) : ℤ) ≤ Z + 5 :=
    zszN_lt (Mb_lt hK hP hS hr hD hk hq hBp hZ32 hwZ)
  have hE : q0 + lowF ES k (D - q0) + (D / 2 + D % 2) ≤ KFM.EwB NLogN.KFW.A0 D := E_le_ewb D hD
  have hEZ : zsz (((q0 + lowF ES k (D - q0) + (D / 2 + D % 2)) : ℕ) : ℤ) ≤ Z := zszN_lt (by omega)
  have hwZ' : w < 2 ^ Z := by omega
  have R := p14Q jG jE jT jL jW rowC hG hEc hT hW hL hk hq hBp hH LV hρ hK hS hP hr hD hZ32 hVt hVl
    hMb le_rfl hEZ hp hwZ' st f zs l xs hx hl h0 h36 hfree hb hdisk hex
  refine ⟨_, R, ?_⟩
  exact ctot_real hKc hS hP hD hr hZr hwZ hK

