lemma pow_cube : ∀ k, 64 ≤ k → 2 ^ 20 * k ^ 3 ≤ 2 ^ k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base => norm_num
  | succ k hk ih =>
    rw [pow_succ 2 k]
    have h1 : 4 * k ^ 2 ≤ k * k ^ 2 := Nat.mul_le_mul_right _ (by omega)
    have h2 : 4 * k ≤ k * k := Nat.mul_le_mul_right _ (by omega)
    have : (k + 1) ^ 3 ≤ 2 * k ^ 3 := by ring_nf; ring_nf at h1 h2; nlinarith
    nlinarith

lemma poly_le (b : ℕ) (hb : 256 ≤ b) : 2 ^ 13 * b ^ 3 ≤ 2 ^ (b / 4) := by
  have hk : 64 ≤ b / 4 := by omega
  have h1 := pow_cube (b / 4) hk
  have h2 : b ≤ 5 * (b / 4) := by omega
  have h3 : b ^ 3 ≤ (5 * (b / 4)) ^ 3 := Nat.pow_le_pow_left h2 3
  have h4 : (5 * (b / 4)) ^ 3 = 125 * (b / 4) ^ 3 := by ring
  calc 2 ^ 13 * b ^ 3 ≤ 2 ^ 13 * (125 * (b / 4) ^ 3) := by rw [← h4]; exact Nat.mul_le_mul_left _ h3
    _ ≤ 2 ^ 20 * (b / 4) ^ 3 := by rw [← mul_assoc]; exact Nat.mul_le_mul_right _ (by norm_num)
    _ ≤ 2 ^ (b / 4) := h1

lemma ceilSqrt_le (p : ℕ) : ceilSqrt p ≤ p + 1 := by
  unfold ceilSqrt
  have := Nat.sqrt_le_self p
  split_ifs <;> omega

lemma sWidth_le (p α : ℕ) (hα : α ≤ p) : sWidth p α ≤ (p + 1) * p := by
  unfold sWidth
  exact Nat.mul_le_mul (ceilSqrt_le p) hα

lemma eWidth_le (p α : ℕ) (hα : α ≤ p) : eWidth p α ≤ 2 * p + 2 := by
  unfold eWidth
  have := Nat.div_le_self (ceilSqrt p + α - 1) α
  have := ceilSqrt_le p
  omega

lemma jIter_le (p s t α : ℕ) (hq : 0 < α ^ 2 * (t - s)) (hs : s ≤ α ^ 2 * (t - s)) :
    jIter p s t α ≤ p + 1 := by
  unfold jIter
  apply Nat.div_le_of_le_mul
  have h1 : p * s ≤ p * (α ^ 2 * (t - s)) := Nat.mul_le_mul_left p hs
  have h2 : α ^ 2 * (t - s) * (p + 1) = p * (α ^ 2 * (t - s)) + α ^ 2 * (t - s) := by ring
  omega

/-- Per-axis consequences of the source window. -/
lemma axis_facts (d s t α : ℕ) (hd : 1 ≤ d) (h1 : (4 * d - 2) * t < 4 * d * s)
    (h2 : 4 * d * s ≤ (4 * d - 1) * t) (hα : 4 * d ≤ α ^ 2) :
    s < t ∧ 0 < α ^ 2 * (t - s) ∧ s ≤ α ^ 2 * (t - s) := by
  obtain ⟨e, he⟩ : ∃ e, 4 * d = e + 2 := ⟨4 * d - 2, by omega⟩
  rw [he] at h1 h2 hα
  have h1' : e * t < (e + 2) * s := by simpa using h1
  have h2' : (e + 2) * s ≤ (e + 1) * t := by
    simpa [show e + 2 - 1 = e + 1 by omega] using h2
  have hst : s < t := by
    by_contra h; push Not at h
    have : (e + 1) * t < (e + 2) * s := by nlinarith
    omega
  obtain ⟨u, rfl⟩ : ∃ u, t = s + u := ⟨t - s, by omega⟩
  have hu : s + u - s = u := by omega
  rw [hu]
  have hu1 : 1 ≤ u := by omega
  -- (e+2) s ≤ (e+1)(s+u) ⇒ s ≤ (e+1) u ≤ α² u
  have h3 : s ≤ (e + 1) * u := by nlinarith
  have h4 : (e + 1) * u ≤ α ^ 2 * u := Nat.mul_le_mul_right u (by omega)
  refine ⟨by omega, ?_, by omega⟩
  have : 1 ≤ α ^ 2 := by omega
  positivity

/-- Third-order Bernoulli lower bound. -/
lemma bern3 (x : ℝ) (_hx0 : 0 ≤ x) (hx1 : x ≤ 1) : ∀ d : ℕ,
    1 - (d : ℝ) * x + (d : ℝ) * (d - 1) / 2 * x ^ 2 - (d : ℝ) * (d - 1) * (d - 2) / 6 * x ^ 3 ≤
      (1 - x) ^ d := by
  intro d
  induction d with
  | zero => simp
  | succ d ih =>
    have hc : 0 ≤ (d : ℝ) * (d - 1) * (d - 2) := by
      rcases Nat.lt_or_ge d 2 with h | h
      · interval_cases d <;> norm_num
      · have : (2 : ℝ) ≤ d := by exact_mod_cast h
        have h1 : 0 ≤ (d : ℝ) - 1 := by linarith
        have h2 : 0 ≤ (d : ℝ) - 2 := by linarith
        positivity
    have h1x : 0 ≤ 1 - x := by linarith
    have key : (1 - (d : ℝ) * x + (d : ℝ) * (d - 1) / 2 * x ^ 2 -
        (d : ℝ) * (d - 1) * (d - 2) / 6 * x ^ 3) * (1 - x) =
        (1 - ((d + 1 : ℕ) : ℝ) * x + ((d + 1 : ℕ) : ℝ) * ((d + 1 : ℕ) - 1) / 2 * x ^ 2 -
          ((d + 1 : ℕ) : ℝ) * ((d + 1 : ℕ) - 1) * ((d + 1 : ℕ) - 2) / 6 * x ^ 3) +
        (d : ℝ) * (d - 1) * (d - 2) / 6 * x ^ 4 := by
      push_cast; ring
    have hx4 : 0 ≤ (d : ℝ) * (d - 1) * (d - 2) / 6 * x ^ 4 := by positivity
    rw [pow_succ (1 - x) d]
    have := mul_le_mul_of_nonneg_right ih h1x
    linarith

/-- `(1 − 1/(2d))^d ≥ 13/24` for `d ≥ 2`. -/
lemma half_plus (d : ℕ) (hd : 2 ≤ d) : (13 : ℝ) / 24 ≤ (1 - 1 / (2 * (d : ℝ))) ^ d := by
  have hy : (2 : ℝ) ≤ d := by exact_mod_cast hd
  have hx0 : 0 ≤ 1 / (2 * (d : ℝ)) := by positivity
  have hx1 : 1 / (2 * (d : ℝ)) ≤ 1 := by rw [div_le_one (by positivity)]; linarith
  have h := bern3 (1 / (2 * (d : ℝ))) hx0 hx1 d
  refine le_trans ?_ h
  have hy0 : (0 : ℝ) < d := by linarith
  have e : 1 - (d : ℝ) * (1 / (2 * (d : ℝ))) + (d : ℝ) * ((d : ℝ) - 1) / 2 * (1 / (2 * (d : ℝ))) ^ 2 -
      (d : ℝ) * ((d : ℝ) - 1) * ((d : ℝ) - 2) / 6 * (1 / (2 * (d : ℝ))) ^ 3 =
      (29 * (d : ℝ) ^ 2 - 3 * (d : ℝ) - 2) / (48 * (d : ℝ) ^ 2) := by
    field_simp; ring
  rw [e, le_div_iff₀ (by positivity)]
  nlinarith

/-- The `hB2`-type bound with `X ≤ 2^{b+k}`, `g ≤ k`, `4k ≤ b`. -/
lemma fin13 (b k g : ℕ) (X : ℝ) (hX0 : 0 ≤ X) (hX : X ≤ 2 ^ (b + k)) (hg : g ≤ k)
    (hk : 4 * k ≤ b) (hb : 64 ≤ b) :
    (2 : ℝ) ^ g * (X * (2 : ℝ)⁻¹ ^ (6 * b)) ≤ 1 / 100 := by
  have h1 : (2 : ℝ) ^ g * X ≤ 2 ^ (b + 2 * k) := by
    calc (2 : ℝ) ^ g * X ≤ 2 ^ k * 2 ^ (b + k) :=
          mul_le_mul (pow_le_pow_right₀ (by norm_num) hg) hX hX0 (by positivity)
      _ = 2 ^ (b + 2 * k) := by rw [← pow_add]; ring_nf
  have h2 : (2 : ℝ) ^ (b + 2 * k) * 2 ^ 7 ≤ 2 ^ (6 * b) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by omega)
  have hP : (0 : ℝ) < 2 ^ (6 * b) := by positivity
  rw [inv_pow, ← mul_assoc, ← div_eq_mul_inv, div_le_iff₀ hP]
  nlinarith

lemma fin14 (b k g : ℕ) (X S : ℝ) (hX0 : 0 ≤ X) (hX : X ≤ 2 ^ (b + k)) (hg : g ≤ k)
    (hk : 4 * k ≤ b) (hb : 64 ≤ b) (hS0 : 0 ≤ S) (hS : S ≤ 2 ^ b) :
    2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * (3 * ((2 : ℝ) ^ g * X) + 2) * (2 : ℝ)⁻¹ ^ (6 * b) < 1 := by
  have h1 : (2 : ℝ) ^ g * X ≤ 2 ^ (b + 2 * k) := by
    calc (2 : ℝ) ^ g * X ≤ 2 ^ k * 2 ^ (b + k) :=
          mul_le_mul (pow_le_pow_right₀ (by norm_num) hg) hX hX0 (by positivity)
      _ = 2 ^ (b + 2 * k) := by rw [← pow_add]; ring_nf
  have h1' : 3 * ((2 : ℝ) ^ g * X) + 2 ≤ 2 ^ (b + 2 * k + 2) := by
    have : (2 : ℝ) ≤ 2 ^ (b + 2 * k) := by
      calc (2 : ℝ) = 2 ^ 1 := (pow_one 2).symm
        _ ≤ 2 ^ (b + 2 * k) := pow_le_pow_right₀ (by norm_num) (by omega)
    have e : (2 : ℝ) ^ (b + 2 * k + 2) = 4 * 2 ^ (b + 2 * k) := by rw [pow_add]; ring
    rw [e]
    have h3 : 3 * ((2 : ℝ) ^ g * X) ≤ 3 * 2 ^ (b + 2 * k) :=
      mul_le_mul_of_nonneg_left h1 (by norm_num)
    linarith
  have hS2 : S ^ 2 ≤ 2 ^ (2 * b) := by
    rw [pow_mul']; exact pow_le_pow_left₀ hS0 hS 2
  have h3 : 2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * (3 * ((2 : ℝ) ^ g * X) + 2) ≤
      2 * 2 ^ (2 * b + 4) * 2 ^ (2 * b) * 2 ^ (b + 2 * k + 2) := by
    have : 0 ≤ 3 * ((2 : ℝ) ^ g * X) + 2 := by positivity
    gcongr
  have h4 : 2 * (2 : ℝ) ^ (2 * b + 4) * 2 ^ (2 * b) * 2 ^ (b + 2 * k + 2) < 2 ^ (6 * b) := by
    rw [show (2 : ℝ) * 2 ^ (2 * b + 4) * 2 ^ (2 * b) * 2 ^ (b + 2 * k + 2) =
      2 ^ (1 + (2 * b + 4) + 2 * b + (b + 2 * k + 2)) by rw [pow_add, pow_add, pow_add]; ring]
    exact pow_lt_pow_right₀ (by norm_num) (by omega)
  have hP : (0 : ℝ) < 2 ^ (6 * b) := by positivity
  rw [inv_pow, ← div_eq_mul_inv, div_lt_one hP]
  linarith

/-- Conjunct `jIter`: `100 (J (10 E + 12) + 1) ≤ 2^p`. -/
lemma c9 (p J E : ℕ) (hp : 256 ≤ p) (hJ : J ≤ p + 1) (hE : E ≤ 2 * p + 2) :
    100 * (J * (10 * E + 12) + 1) ≤ 2 ^ p := by
  have h1 : J * (10 * E + 12) ≤ (p + 1) * (20 * p + 32) := Nat.mul_le_mul hJ (by omega)
  have h2 := poly_le p hp
  have h3 : 2 ^ (p / 4) ≤ 2 ^ p := Nat.pow_le_pow_right (by norm_num) (Nat.div_le_self _ _)
  have h4 : 100 * ((p + 1) * (20 * p + 32) + 1) ≤ 2 ^ 13 * p ^ 3 := by
    have : 256 * p ^ 2 ≤ p * p ^ 2 := Nat.mul_le_mul_right _ hp
    have : 256 * p ≤ p * p := Nat.mul_le_mul_right _ hp
    ring_nf; ring_nf at this; nlinarith
  omega

/-- Conjunct `sWidth`: `4 (6 W + 4) ≤ 2^p`. -/
lemma c10 (p W : ℕ) (hp : 256 ≤ p) (hW : W ≤ (p + 1) * p) : 4 * (6 * W + 4) ≤ 2 ^ p := by
  have h2 := poly_le p hp
  have h3 : 2 ^ (p / 4) ≤ 2 ^ p := Nat.pow_le_pow_right (by norm_num) (Nat.div_le_self _ _)
  have h4 : 4 * (6 * ((p + 1) * p) + 4) ≤ 2 ^ 13 * p ^ 3 := by
    have : 256 * p ^ 2 ≤ p * p ^ 2 := Nat.mul_le_mul_right _ hp
    have : 256 * p ≤ p * p := Nat.mul_le_mul_right _ hp
    ring_nf; ring_nf at this; nlinarith
  omega

lemma epsA_le (b d W : ℕ) (hb : 8 ≤ b) (hd : d ≤ b) (hW : W ≤ (6 * b + 1) * (6 * b)) :
    d * (6 * W + 4) ≤ 252 * b ^ 3 := by
  have h1 : d * (6 * W + 4) ≤ b * (6 * ((6 * b + 1) * (6 * b)) + 4) := Nat.mul_le_mul hd (by omega)
  have : 8 * b ≤ b * b := Nat.mul_le_mul_right _ hb
  have : 8 * b ^ 2 ≤ b * b ^ 2 := Nat.mul_le_mul_right _ hb
  ring_nf at h1 ⊢; ring_nf at this; nlinarith

lemma epsB_le (b d Y : ℕ) (hb : 8 ≤ b) (hd : d ≤ b)
    (hY : Y ≤ d * ((6 * b + 1) * (20 * (6 * b) + 32) + 4)) : Y ≤ 800 * b ^ 3 := by
  have h1 : Y ≤ b * ((6 * b + 1) * (20 * (6 * b) + 32) + 4) :=
    hY.trans (Nat.mul_le_mul_right _ hd)
  have : 8 * b ≤ b * b := Nat.mul_le_mul_right _ hb
  have : 8 * b ^ 2 ≤ b * b ^ 2 := Nat.mul_le_mul_right _ hb
  ring_nf at h1 ⊢; ring_nf at this; nlinarith

/-- The total error numerator `X = εA + (Er + 22) + εB ≤ 2^{b+k}`. -/
lemma xbound (b k A B P l : ℕ) (hb : 256 ≤ b) (hA : A ≤ 252 * b ^ 3) (hB : B ≤ 800 * b ^ 3)
    (hP : P ≤ 2 ^ b) (hl : l ≤ b) (hk : 2 ^ 13 * b ^ 3 ≤ 2 ^ k) :
    A + (2 * P * (3 * l + 1) + 22) + B ≤ 2 ^ (b + k) := by
  have h1 : 2 * P * (3 * l + 1) ≤ 2 ^ b * (6 * b + 2) := by
    calc 2 * P * (3 * l + 1) = P * (6 * l + 2) := by ring
      _ ≤ 2 ^ b * (6 * b + 2) := Nat.mul_le_mul hP (by omega)
  have h2 : 1 ≤ 2 ^ b := Nat.one_le_two_pow
  have h3 : 1100 * b ^ 3 ≤ 2 ^ b * (1100 * b ^ 3) := Nat.le_mul_of_pos_left _ h2
  have h4 : 6 * b + 2 + 1100 * b ^ 3 ≤ 2 ^ 13 * b ^ 3 := by
    have : 256 * b ≤ b * b := Nat.mul_le_mul_right _ hb
    have : 256 * b ^ 2 ≤ b * b ^ 2 := Nat.mul_le_mul_right _ hb
    ring_nf; ring_nf at this; nlinarith
  have h5 : 2 ^ b * (6 * b + 2 + 1100 * b ^ 3) ≤ 2 ^ b * 2 ^ k :=
    Nat.mul_le_mul_left _ (h4.trans hk)
  rw [pow_add]
  have e : 2 ^ b * (6 * b + 2 + 1100 * b ^ 3) = 2 ^ b * (6 * b + 2) + 2 ^ b * (1100 * b ^ 3) := by
    ring
  omega

end NLogN.KFQ

