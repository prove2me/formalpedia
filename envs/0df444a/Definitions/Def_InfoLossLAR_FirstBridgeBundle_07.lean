/-- Polynomial-time threading for the original platform stock machine
model, without any finiteness assumption on internal alphabet types. -/
theorem thread_polynomial {α β γ : Type} {ea : α → List Bool} {eb : β → List Bool}
    (ec : γ → List Bool) {f : α → β} (callee : TM2ComputableInPolyTime ea eb f) :
    Nonempty (TM2ComputableInPolyTime (OAI.MetricKMedian.Binary.encodePair ea ec)
      (OAI.MetricKMedian.Binary.encodePair eb ec) (fun pair : α × γ => (f pair.1,pair.2))) := by
  classical
  let wrapper := _root_.Integration9_9.TM2StockThread.threadedMachine callee.tm callee.inputAlphabet callee.outputAlphabet
  let growth := _root_.Integration9_9.TM2OutputLength.programPushBound callee.tm.m
  let cost : Polynomial ℕ := (1+3*Polynomial.C growth)*callee.time+5*Polynomial.X+6
  have hout (pair : α × γ) : Nonempty (TM2OutputsInTime wrapper
      (OAI.MetricKMedian.Binary.encodePair ea ec pair)
      (some (OAI.MetricKMedian.Binary.encodePair eb ec (f pair.1,pair.2)))
      (cost.eval (OAI.MetricKMedian.Binary.encodePair ea ec pair).length)) := by
    have hrun := _root_.Integration9_9.TM2StockThread.outputsInTime callee.tm callee.inputAlphabet callee.outputAlphabet
      (ea pair.1) (ec pair.2) ((eb (f pair.1)).map callee.outputAlphabet.invFun)
      (callee.time.eval (ea pair.1).length) (callee.outputsFun pair.1)
    have hraw : Nonempty (TM2OutputsInTime wrapper
        (OAI.MetricKMedian.Binary.encodePair ea ec pair)
        (some (OAI.MetricKMedian.Binary.encodePair eb ec (f pair.1,pair.2)))
        (callee.time.eval (ea pair.1).length+2*(ea pair.1).length+2*(ec pair.2).length+
          3*(eb (f pair.1)).length+6)) := by
      simpa only [OAI.MetricKMedian.Binary.encodePair,List.map_map,Function.comp_def,
        Equiv.invFun_as_coe,Equiv.apply_symm_apply,List.map_id_fun,List.map_id_fun',id_eq,List.length_map] using hrun
    obtain ⟨hr⟩ := hraw
    let size := (OAI.MetricKMedian.Binary.encodePair ea ec pair).length
    have hs : size=2*(ea pair.1).length+1+(ec pair.2).length := OAI.MetricKMedian.Binary.encodePair_length _ _ _
