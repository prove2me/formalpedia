  have hx : 0 ≤ quadraticCoordinate u := by
    unfold quadraticCoordinate
    positivity
  have hrad : 0 ≤ 1 + 4 * c * quadraticCoordinate u := by positivity
  have hsquare := Real.sq_sqrt hrad
  unfold scaleCoordinate quadraticCoordinate at *
