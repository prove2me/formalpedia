-- name    : HessianDamping.IPAHDSC.theorem_9
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:10:59.233975+00:00
-- url     : https://prove2.me/theorems/f0f4e15a-bc3a-44e9-b9c9-f431e772ee39
-- title:
--   Theorem 9, p. 23 — for µ-strongly convex f, (IPAHD-SC) gives (µ/2)‖x_k − x⋆‖² ≤ f(x_k) − min f ≤ E₁q^{k−1} and θ^k Σ θ^{−j}‖∇f(x_j)‖² = O(q^k)
-- statement:
--   Let $H$ be a real Hilbert space and $f:H\to\mathbb R$ a convex function of class $C^1$ which is $\mu$-strongly convex for some $\mu>0$, i.e. $f-\frac\mu2\|\cdot\|^2$ is convex, and let $x^\star$ be its minimizer. Let $s>0$ and suppose
--   $$0\le\beta\le\frac{1}{2\sqrt\mu}\qquad\text{and}\qquad\sqrt s\le\beta.$$
--   Set $q=\frac{1}{1+\frac12\sqrt{\mu s}}$ and $\theta=\frac{1}{1+\sqrt{\mu s}}$; both lie in $]0,1[$. Let $(x_k)_{k\in\mathbb N}$ be generated by the inertial proximal algorithm (IPAHD-SC) from arbitrary $x_0,x_1$:
--   $$y_k=x_k+\Big(1-\tfrac{2\sqrt{\mu s}}{1+2\sqrt{\mu s}}\Big)(x_k-x_{k-1})+\beta\sqrt s\Big(1-\tfrac{2\sqrt{\mu s}}{1+2\sqrt{\mu s}}\Big)\nabla f(x_k),\qquad x_{k+1}=\operatorname{prox}_{\frac{\beta\sqrt s+s}{1+2\sqrt{\mu s}}f}(y_k).$$
--   Then:
--
--   1. for every $k\ge1$,
--   $$\frac\mu2\|x_k-x^\star\|^2\le f(x_k)-\min_H f\le E_1q^{k-1},$$
--   where $E_1=f(x_1)-f(x^\star)+\frac12\big\|\sqrt\mu(x_1-x^\star)+\frac{1}{\sqrt s}(x_1-x_0)+\beta\nabla f(x_1)\big\|^2$;
--   2. the gradients converge to zero exponentially fast:
--   $$\theta^k\sum_{j=0}^{k-2}\theta^{-j}\|\nabla f(x_j)\|^2=\mathcal O(q^k)\qquad\text{as }k\to+\infty.$$
--
--   This is the linear convergence of the implicit discretization of the strongly convex inertial dynamic with Hessian driven damping; the proximal step makes the result hold without any Lipschitz assumption on $\nabla f$.
--
--   **Formalization Note** The minimizer is given as a point $x^\star$ with $f(x^\star)\le f(y)$ for all $y$, so $\min_H f=f(x^\star)$. The proximal step is the minimizing property `IsProxPoint`. $s>0$ is the page's implicit positive step size ($s=h^2$). The paper's side claims $0<q<1$ and $\theta\in]0,1[$ are included as a first conjunct. $\theta^{-j}$ is the integer power `thetaRate μ s ^ (-(j : ℤ))`. The sum over $j=0,\dots,k-2$ is `Finset.range (k - 1)`, empty for $k\le1$, which does not affect the asymptotic statement. The big-O constant may depend on all data ($f$, parameters, $x_0$, $x_1$).
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, p. 23, Theorem 9

import Mathlib
import Definitions.Def_HessianDamping_IPAHDSC_Setting

namespace HessianDamping.IPAHDSC

/-- Theorem 9, p. 23. Let `f` be convex, `C¹` and `μ`-strongly convex, `μ > 0`, with
`0 ≤ β ≤ 1/(2√μ)` and `√s ≤ β`. Then `0 < q < 1`, `0 < θ < 1`, every run of (IPAHD-SC)
satisfies `(μ/2)‖x_k - x⋆‖² ≤ f(x_k) - min f ≤ E₁ q^(k-1)` for `k ≥ 1`, and
`θ^k Σ_{j=0}^{k-2} θ^(-j) ‖∇f(x_j)‖² = O(q^k)` as `k → +∞`. -/
theorem theorem_9 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f : H → ℝ) (hfconv : ConvexOn ℝ Set.univ f) (hfC1 : ContDiff ℝ 1 f)
    (μ : ℝ) (hμ : 0 < μ) (hsc : HessianDamping.DINSC.IsStronglyConvex f μ)
    (xstar : H) (hxstar : ∀ y, f xstar ≤ f y)
    (β s : ℝ) (hs : 0 < s) (hβ0 : 0 ≤ β) (hβ : β ≤ 1 / (2 * Real.sqrt μ))
    (hsβ : Real.sqrt s ≤ β)
    (x : ℕ → H) (hrun : IsIPAHDSCRun f μ β s x) :
    (0 < qRate μ s ∧ qRate μ s < 1 ∧ 0 < thetaRate μ s ∧ thetaRate μ s < 1) ∧
    (∀ k : ℕ, 1 ≤ k →
      μ / 2 * ‖x k - xstar‖ ^ 2 ≤ f (x k) - f xstar ∧
        f (x k) - f xstar ≤ E1 f μ β s x xstar * qRate μ s ^ (k - 1)) ∧
    (fun k : ℕ => thetaRate μ s ^ k *
        ∑ j ∈ Finset.range (k - 1), thetaRate μ s ^ (-(j : ℤ)) * ‖gradient f (x j)‖ ^ 2)
      =O[Filter.atTop] (fun k : ℕ => qRate μ s ^ k) := by sorry

end HessianDamping.IPAHDSC
