open AlgebraicCurve

theorem ModularCurve.nodeUnit_eq_zero_iff_modularFunctionFieldC_of_perfectField
    (K : Type*) [Field K] [PerfectField K] (N : ℕ) [NeZero N]
    (S : Finset (Place K (modularFunctionFieldC K N) × Place K (modularFunctionFieldC K N)))
    (w : ↥S → Additive Kˣ) :
    GluedPic0.nodeUnit S w = 0 ↔ ∃ c : Kˣ, w = fun _ => Additive.ofMul c := by sorry
