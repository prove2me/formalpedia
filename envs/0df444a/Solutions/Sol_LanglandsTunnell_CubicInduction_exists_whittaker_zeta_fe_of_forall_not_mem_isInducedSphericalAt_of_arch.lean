      HasConductorExponentAt K 𝔓 (localChar μ 𝔓) (conductorExponentAt K 𝔓 (localChar μ 𝔓)))
    (hμu : ∀ 𝔓 ∈ primeFibre ℚ K v, ‖(localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂ)‖ = 1)
