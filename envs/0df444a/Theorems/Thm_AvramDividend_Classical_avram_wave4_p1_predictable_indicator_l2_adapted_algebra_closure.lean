-- title:
--   Lp² closure of actual-filtration predictable indicators by adapted Boolean rectangles
-- statement:
--   For the actual predictable sigma-algebra of any filtration and any finite measure on its time-history space, every measurable indicator weighted by a real constant lies in the norm closure in L² of finite Boolean adapted-rectangle indicators. This uses independently proved measure-density of the algebra generated by the filtration's own past-measurable future-half-line rectangles and the pinned Mathlib Lp indicator-closure theorem. It imposes no stochastic compensation or martingale premise.
-- source:
--   P1 measure-density  d1cdf93e-bb12-45f4-a758-8a3fcc710a03 when canonical Proved; pinned Measure.MeasureDense.indicatorConstLp_subset_closure in Mathlib.MeasureTheory.Measure.SeparableMeasure.

import Mathlib
import Theorems.Thm_AvramDividend_Classical_avram_wave4_p1_predictable_generator_set_algebra_measure_dense

open MeasureTheory Set TopologicalSpace AvramDividend.Classical
open scoped ENNReal NNReal

theorem AvramDividend.Classical.avram_wave4_p1_predictable_indicator_l2_adapted_algebra_closure
    {Ω ι : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι]
    (𝓕 : Filtration ι mΩ)
    [mProd : MeasurableSpace (ι × Ω)]
    (hProd : mProd = 𝓕.predictable)
    (μ : Measure (ι × Ω)) [IsFiniteMeasure μ]
    (s : Set (ι × Ω)) (hs : MeasurableSet s)
    (hμs : μ s ≠ ⊤) (c : ℝ) :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    ∃ (hG : μ.MeasureDense (generateSetAlgebra G)),
      indicatorConstLp (2 : ℝ≥0∞) hs hμs c ∈
        closure {indicatorConstLp (2 : ℝ≥0∞) (hG.measurable t ht) hμt c |
          (t : Set (ι × Ω)) (ht : t ∈ generateSetAlgebra G) (hμt : μ t ≠ ⊤)} := by sorry
