theorem OAI.PiExponent.FormalInterpolation.finite_module_of_power_relations {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : ℝ)) (D : Nat) (hD : 0 < D) (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ) (hrelations : ∀ i : Fin d, ∃ n : Nat, 0 < n ∧ ∃ q : Fin m → MvPolynomial (Fin d) ℂ, (MvPolynomial.X i : MvPolynomial (Fin d) ℂ) ^ n = ∑ j, q j * p j ∧ ∀ j, MvPolynomial.IsWeightedHomogeneous w (q j) ((n : ℚ) * w i - (D : ℚ))) : Module.Finite (Algebra.adjoin ℂ (Set.range p)) (MvPolynomial (Fin d) ℂ) := by sorry
