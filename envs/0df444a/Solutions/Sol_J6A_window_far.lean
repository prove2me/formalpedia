lemma kcB_bounds (H k : ℕ) (hH : 1 ≤ H) : -(H : ℤ) ≤ kapB H k ∧ kapB H k < H := by
  unfold kapB kcB
  have h2 : 0 < 2 * H := by omega
  have a1 := Nat.div_add_mod k (2 * H)
  have a2 := Nat.mod_lt k h2
  have e : k / (2 * H) * (2 * H) = 2 * H * (k / (2 * H)) := Nat.mul_comm _ _
  generalize k / (2 * H) * (2 * H) = X at e ⊢
  generalize k % (2 * H) = R at a1 a2
  rw [← e] at a1
  constructor <;> omega

/-- `|j_c - s k_c / t| ≤ 1/2`. -/
lemma jcB_near (s t H k : ℕ) (ht : 0 < t) :
    |((jcB s t H k : ℤ) : ℝ) - (s * kcB H k : ℝ) / t| ≤ 1 / 2 := by
  unfold jcB
  set q := (2 * s * kcB H k + t) / (2 * t)
  have h2t : 0 < 2 * t := by omega
  have h1 : q * (2 * t) ≤ 2 * s * kcB H k + t := Nat.div_mul_le_self _ _
  have h2 : 2 * s * kcB H k + t < (q + 1) * (2 * t) := by
    have hd : 2 * t * q + (2 * s * kcB H k + t) % (2 * t) = 2 * s * kcB H k + t :=
      Nat.div_add_mod (2 * s * kcB H k + t) (2 * t)
    have hm := Nat.mod_lt (2 * s * kcB H k + t) h2t
    have hc : 2 * t * q = q * (2 * t) := Nat.mul_comm _ _
    rw [add_mul, one_mul]; first | omega | linarith
  have htR : (0 : ℝ) < t := by exact_mod_cast ht
  have h1R : (q : ℝ) * (2 * t) ≤ 2 * s * kcB H k + t := by exact_mod_cast h1
  have h2R : (2 * s * kcB H k + t : ℝ) < (q + 1) * (2 * t) := by exact_mod_cast h2
  rw [Int.cast_natCast, abs_le]
  have e1 : (q : ℝ) - (s * kcB H k : ℝ) / t + 1 / 2 = ((q + 1) * (2 * t) - (2 * s * kcB H k + t)) / (2 * t) := by
    field_simp <;> ring
  have e2 : (s * kcB H k : ℝ) / t + 1 / 2 - q = (2 * s * kcB H k + t - q * (2 * t)) / (2 * t) := by
    field_simp <;> ring
  have p1 : 0 ≤ (q : ℝ) - (s * kcB H k : ℝ) / t + 1 / 2 := by
    rw [e1]; apply div_nonneg <;> nlinarith
  have p2 : 0 ≤ (s * kcB H k : ℝ) / t + 1 / 2 - q := by
    rw [e2]; apply div_nonneg <;> nlinarith
  constructor <;> linarith

/-- Outside the chirp window the `Sapprox` window distance is `≥ m + 1`. -/
lemma window_far_sol_aux (s t H k m W : ℕ) (ht : 0 < t) (hst : s ≤ t) (hH : 1 ≤ H) (hW : H + m + 3 ≤ W)
    (j : ℤ) (hj : W ≤ (j - jcB s t H k).natAbs ∨ j - jcB s t H k = -W) :
    m + 1 ≤ (j - (((s * k + t - 1) / t : ℕ) : ℤ)).natAbs := by
  -- reals: |j - c| ≥ |j - jc| - |jc - s kc/t| - |s kc/t - s k/t| - |s k/t - c|
  obtain ⟨hc1, hc2⟩ := ceil_bounds s t k ht
  have hjc := jcB_near s t H k ht
  obtain ⟨hk1, hk2⟩ := kcB_bounds H k hH
  have htR : (0 : ℝ) < t := by exact_mod_cast ht
  have hsR : (s : ℝ) ≤ t := by exact_mod_cast hst
  have hkap : (kapB H k : ℝ) = (k : ℝ) - kcB H k := by unfold kapB; push_cast; ring
  have hkapR1 : -(H : ℝ) ≤ kapB H k := by exact_mod_cast hk1
  have hkapR2 : (kapB H k : ℝ) < H := by exact_mod_cast hk2
  -- |s kc/t - s k/t| ≤ H
  have hd : |(s * kcB H k : ℝ) / t - (s * k : ℝ) / t| ≤ H := by
    have e : (s * kcB H k : ℝ) / t - (s * k : ℝ) / t = -((s : ℝ) / t * kapB H k) := by
      rw [hkap]; field_simp; ring
    rw [e, abs_neg, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ s / t)]
    have h1 : (s : ℝ) / t ≤ 1 := by rw [div_le_one htR]; exact hsR
    have h2 : |(kapB H k : ℝ)| ≤ H := by rw [abs_le]; constructor <;> linarith
    calc (s : ℝ) / t * |(kapB H k : ℝ)| ≤ 1 * H :=
          mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
      _ = H := one_mul _
  set c : ℤ := (((s * k + t - 1) / t : ℕ) : ℤ)
  have hjjc : (W : ℝ) ≤ |(j : ℝ) - jcB s t H k| := by
    rcases hj with hj | hj
    · have : ((j - jcB s t H k).natAbs : ℝ) = |(j : ℝ) - jcB s t H k| := by
        rw [Nat.cast_natAbs, Int.cast_abs]; push_cast; rfl
      rw [← this]; exact_mod_cast hj
    · have : (j : ℝ) - jcB s t H k = -W := by exact_mod_cast hj
      rw [this, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]
  have hWR : (H : ℝ) + m + 3 ≤ W := by exact_mod_cast hW
  have hfar : (m : ℝ) + 1 ≤ |(j : ℝ) - c| := by
    by_contra hcon
    push_neg at hcon
    rw [abs_lt] at hcon
    rw [abs_le] at hd hjc
    have : |(j : ℝ) - jcB s t H k| < W := by
      rw [abs_lt]; constructor <;> linarith
    linarith
  have : ((j - c).natAbs : ℝ) = |(j : ℝ) - c| := by rw [Nat.cast_natAbs, Int.cast_abs]; push_cast; rfl
  rw [← this] at hfar; exact_mod_cast hfar

