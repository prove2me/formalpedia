-- title:
--   Proposition 3.5: Gauge sensitivity of independently actuated specifications
-- statement:
--   Let $L$ be a jump matrix and $H$ a Hermitian Hamiltonian on a complex space of dimension $d>0$. For $c\in\mathbb C$, put $H_c=\frac{i}{2}(\overline c L-cL^\dagger)$. Then $H_c$ is Hermitian and, for every matrix $\rho$,
--
--   $$-i[H,\rho]+D_L(\rho)=-i[H-H_c,\rho]+D_{L+cI}(\rho).$$
--
--   If $L$ is traceless and $c\ne0$, the shifted jump is not traceless. In affine Bloch coordinates let $Z=(J_z,0)$, $D=(\operatorname{diag}(-1/2,-1/2,-1),-e_z)$ and $Y_c=D+c(J_y,0)$. The real Lie algebras generated by $\{Z,D\}$ and $\{Z,Y_{3/5}\}$ have dimensions $2$ and $12$, respectively.
--
--   Thus the compensating gauge transformation preserves the combined autonomous generator, whereas retaining the shifted dissipator as a separately actuated ray changes the control specification.
-- source:
--   Lie-Wedge Stratification and Pure-State Stabilizability in Single- Channel Qubit Control, arXiv:2610.00046v1, PDF p. 11, Proposition 3.5

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P59

noncomputable section

open scoped Matrix ComplexOrder

namespace QAlgorithms.Papers.Independent.Information100.P59

attribute [local instance 100] LieRing.ofAssociativeRing

/-- arXiv:2610.00046v1 PDF p.11, Proposition 3.5. The gauge identity concerns the
combined autonomous generator; the dimension witness concerns a separated actuation list. -/
theorem gaugeSensitivity :
    (∀ {d : ℕ}, 0 < d → ∀ (L H : Matrix (Fin d) (Fin d) ℂ) (c : ℂ),
      H.IsHermitian →
      (gaugeHamiltonian L c).IsHermitian ∧
      (∀ X, coherent H X + dissipator L X =
        coherent (H - gaugeHamiltonian L c) X + dissipator (L + c • 1) X) ∧
      (L.trace = 0 → c ≠ 0 → (L + c • 1).trace ≠ 0)) ∧
    Module.finrank ℝ (LieSubalgebra.lieSpan ℝ Block
      {controlBlock ![0,0,1], dampingBlock}) = 2 ∧
    Module.finrank ℝ (LieSubalgebra.lieSpan ℝ Block
      {controlBlock ![0,0,1], shiftedDamping (3/5)}) = 12 := by sorry

end QAlgorithms.Papers.Independent.Information100.P59

end
