  {hcHom : ∀ j, IsHom L (c j)}

theorem mem_commSubgroup {β : EndPt L hc} :
    β ∈ commSubgroup L hc c hcHom ↔ IsHom L (β : SchemeHomOver f f) ∧ ∀ j, (c j) ⊚ (β : SchemeHomOver f f) = (β : SchemeHomOver f f) ⊚ (c j) :=
  Iff.rfl

abbrev EndAdd (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (c : ι → SchemeHomOver f f)
    (hcHom : ∀ j, IsHom L (c j)) : Type u := Additive (commSubgroup L hc c hcHom)

def toEnd (x : EndAdd L hc c hcHom) : SchemeHomOver f f :=
  (show EndPt L hc from ((Additive.toMul x : commSubgroup L hc c hcHom) : EndPt L hc))

theorem toEnd_isHom (x : EndAdd L hc c hcHom) : IsHom L (toEnd x) :=
  (Additive.toMul x).2.1

theorem toEnd_comm (x : EndAdd L hc c hcHom) (j : ι) : (c j) ⊚ (toEnd x) = (toEnd x) ⊚ (c j) :=
  (Additive.toMul x).2.2 j

theorem toEnd_injective : Function.Injective (toEnd (L := L) (hc := hc) (c := c) (hcHom := hcHom)) := by
  intro x y h
  exact Additive.toMul.injective (Subtype.ext h)

theorem toEnd_zero : toEnd (0 : EndAdd L hc c hcHom) = L.one f :=
  rfl

theorem toEnd_sum_zsmul {κ : Type*} [Fintype κ] (n : κ → ℤ) (a : κ → EndAdd L hc c hcHom) :
    toEnd (∑ i, n i • a i) = (letI := L.pointCommGroup hc f; ∏ i, (toEnd (a i)) ^ n i) := by
  unfold toEnd
  rw [toMul_sum]
  simp only [toMul_zsmul]
  rw [Subgroup.val_finsetProd]
  simp only [SubgroupClass.coe_zpow]
  rfl

theorem toEnd_nsmul (n : ℕ) (a : EndAdd L hc c hcHom) :
    toEnd (n • a) = (letI := L.pointCommGroup hc f; (toEnd a) ^ n) := by
  unfold toEnd
  rw [toMul_nsmul, SubgroupClass.coe_pow]
  rfl

end Comm

theorem eval_smul_of_isHomogeneous {σ : Type*} [Fintype σ] {P : MvPolynomial σ ℚ} {D : ℕ}
    (hP : P.IsHomogeneous D) (k : ℚ) (v : σ → ℚ) :
    MvPolynomial.eval (k • v) P = k ^ D * MvPolynomial.eval v P := by
  classical
  rw [MvPolynomial.eval_eq', MvPolynomial.eval_eq', Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg : ∑ i, d i = D := by
    rw [← Finsupp.degree_eq_sum, Finsupp.degree_apply]
    exact (hP.degree_eq_sum_deg_support hd).symm
  simp only [Pi.smul_apply, smul_eq_mul, mul_pow, Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum, hdeg]
  ring

theorem isAddTorsionFree_of_degree {R : Type*} [AddCommGroup R] (deg : R → ℤ) (D : ℕ) (hD : D ≠ 0)
    (hpoly : ∀ (m : ℕ) (α : Fin m → R), ∃ P : MvPolynomial (Fin m) ℚ, P.IsHomogeneous D ∧
      ∀ n : Fin m → ℤ, (deg (∑ i, n i • α i) : ℚ) = MvPolynomial.eval (fun i => (n i : ℚ)) P)
    (hsep : ∀ x : R, x ≠ 0 → deg x ≠ 0) : IsAddTorsionFree R := by
  have deg_smul : ∀ (x : R) (k : ℤ), (deg (k • x) : ℚ) = (k : ℚ) ^ D * deg x := by
    intro x k
    obtain ⟨P, hP, hev⟩ := hpoly 1 (fun _ => x)
    have h1 := hev (fun _ => k)
    have h2 := hev (fun _ => 1)
    simp only [Fin.sum_univ_one, one_smul] at h1 h2
    rw [h1, h2]
    have : (fun _ : Fin 1 => ((k : ℤ) : ℚ)) = (k : ℚ) • (fun _ : Fin 1 => ((1 : ℤ) : ℚ)) := by
      funext i; simp
    rw [this, eval_smul_of_isHomogeneous hP]
  have deg_zero : deg 0 = 0 := by
    have h := deg_smul (0 : R) 0
    rw [zero_smul, Int.cast_zero, zero_pow hD, zero_mul] at h
    exact_mod_cast h
  refine ⟨fun n hn x y hxy => ?_⟩
  simp only at hxy
  have h0 : (n : ℤ) • (x - y) = 0 := by
    rw [natCast_zsmul, smul_sub, hxy, sub_self]
  by_contra hne
  have h1 := deg_smul (x - y) n
  rw [h0, deg_zero, Int.cast_zero] at h1
  have h2 : ((n : ℤ) : ℚ) ^ D ≠ 0 := pow_ne_zero _ (by exact_mod_cast hn)
  have h3 : (deg (x - y) : ℚ) = 0 := by
    rcases mul_eq_zero.mp h1.symm with h | h
    · exact absurd h h2
    · exact h
  exact hsep _ (sub_ne_zero.mpr hne) (by exact_mod_cast h3)

section Torsion

variable (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (ℓ : ℕ) {ι : Type v} (c : ι → SchemeHomOver f f)
  (hcHom : ∀ j, IsHom L (c j))

def ofEndPt {L : RelativeGroupLaw K f} {hc : L.IsCommutative} (β : EndPt L hc) : SchemeHomOver f f := β

def ofKPt {L : RelativeGroupLaw K f} {hc : L.IsCommutative} (x : KPt L hc) :
    SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f := x

def tors : Subgroup (KPt L hc) := (powMonoidHom ℓ : KPt L hc →* KPt L hc).ker

theorem mem_tors {x : KPt L hc} : x ∈ tors L hc ℓ ↔ x ^ ℓ = 1 := by
  rw [tors, MonoidHom.mem_ker]; rfl

theorem mem_tors_iff_isTorsionPoint {x : KPt L hc} :
    x ∈ tors L hc ℓ ↔ L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) ℓ (ofKPt x) := by
  rw [mem_tors, RelativeGroupLaw.isTorsionPoint_def, nsmul_eq_pow L hc]
  rfl

variable {L hc ℓ c hcHom}

theorem comp_mem_tors (β : commSubgroup L hc c hcHom) (x : tors L hc ℓ) :
    (show KPt L hc from (ofKPt (x : KPt L hc) ⊚ ofEndPt (β : EndPt L hc) : SchemeHomOver _ f)) ∈ tors L hc ℓ := by
  refine (mem_tors L hc ℓ).mpr ?_
  change (letI := L.pointCommGroup hc (𝟙 (Spec (CommRingCat.of K)));
    (ofKPt (x : KPt L hc) ⊚ ofEndPt (β : EndPt L hc)) ^ ℓ) = L.one _
  have hx : (x : KPt L hc) ^ ℓ = 1 := (mem_tors L hc ℓ).mp x.2
  have h := IsHom.comp_pow hc β.2.1 (𝟙 (Spec (CommRingCat.of K))) ℓ (ofKPt (x : KPt L hc))
  have e1 : (letI := L.pointCommGroup hc (𝟙 (Spec (CommRingCat.of K))); ofKPt (x : KPt L hc) ^ ℓ) =
      ofKPt ((x : KPt L hc) ^ ℓ) := rfl
  rw [e1, hx] at h
  have e2 : ofKPt (1 : KPt L hc) = L.one _ := rfl
  rw [e2, IsHom.comp_one β.2.1] at h
  exact h.symm

def actTors (β : commSubgroup L hc c hcHom) : tors L hc ℓ →* tors L hc ℓ where
  toFun x := ⟨(ofKPt (x : KPt L hc) ⊚ ofEndPt (β : EndPt L hc) : SchemeHomOver _ f), comp_mem_tors β x⟩
  map_one' := by
    apply Subtype.ext
    exact IsHom.comp_one β.2.1 _
  map_mul' x y := by
    apply Subtype.ext
    exact β.2.1 _ _ _

theorem coe_actTors_apply (β : commSubgroup L hc c hcHom) (x : tors L hc ℓ) :
    ofKPt ((actTors β x : tors L hc ℓ) : KPt L hc) = ofKPt (x : KPt L hc) ⊚ ofEndPt (β : EndPt L hc) :=
  rfl

def actHom : commSubgroup L hc c hcHom →* (tors L hc ℓ →* tors L hc ℓ) where
  toFun := actTors
  map_one' := by
    refine MonoidHom.ext fun x => Subtype.ext ?_
    change ofKPt (x : KPt L hc) ⊚ (L.one f) = L.one _
    exact comp_one L _
  map_mul' β γ := by
    refine MonoidHom.ext fun x => Subtype.ext ?_
    change ofKPt (x : KPt L hc) ⊚ (L.mul f (ofEndPt (β : EndPt L hc)) (ofEndPt (γ : EndPt L hc))) =
      L.mul _ (ofKPt (x : KPt L hc) ⊚ ofEndPt (β : EndPt L hc)) (ofKPt (x : KPt L hc) ⊚ ofEndPt (γ : EndPt L hc))
    exact comp_mul L _ _ _

theorem actHom_apply (β : commSubgroup L hc c hcHom) : actHom (ℓ := ℓ) β = actTors β := rfl

def rho : EndAdd L hc c hcHom →+ Additive (tors L hc ℓ →* tors L hc ℓ) :=
  MonoidHom.toAdditive (actHom (ℓ := ℓ))

theorem rho_eq_zero_iff (x : EndAdd L hc c hcHom) :
    rho (ℓ := ℓ) x = 0 ↔ ∀ y : tors L hc ℓ, ofKPt (y : KPt L hc) ⊚ (toEnd x) = L.one _ := by
  have key : rho (ℓ := ℓ) x = 0 ↔ actTors (ℓ := ℓ) (Additive.toMul x) = 1 := by
    constructor
    · intro h; exact congrArg Additive.toMul h
    · intro h; exact congrArg Additive.ofMul h
  rw [key]
  constructor
  · intro h y
    have h1 : actTors (ℓ := ℓ) (Additive.toMul x) y = 1 := by rw [h]; rfl
    have h2 := congrArg (fun z : tors L hc ℓ => ofKPt (z : KPt L hc)) h1
    exact h2
  · intro h
    refine MonoidHom.ext fun y => Subtype.ext ?_
    exact h y

end Torsion

section TorsionFinite

variable {K : Type u} [Field K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}

theorem comp_nsmul_idPoint (L : RelativeGroupLaw K f) (ℓ : ℕ)
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f) :
    x ⊚ (L.nsmul f ℓ RelativeGroupLaw.idPoint) = L.nsmul (𝟙 (Spec (CommRingCat.of K))) ℓ x := by
  have h := L.nsmul_natural f (𝟙 (Spec (CommRingCat.of K))) x.1 x.2 ℓ RelativeGroupLaw.idPoint
  have e1 : GoodReductionJacobian.schemeHomOverComp x.1 x.2 (L.nsmul f ℓ RelativeGroupLaw.idPoint) =
      x ⊚ (L.nsmul f ℓ RelativeGroupLaw.idPoint) := Subtype.ext rfl
  have e2 : GoodReductionJacobian.schemeHomOverComp x.1 x.2 (RelativeGroupLaw.idPoint (f := f)) = x :=
    Subtype.ext (Category.comp_id x.1)
  rw [e1, e2] at h
  exact h

theorem connectedSpace (hA : AbelianSchemePropertyBundle K f) : ConnectedSpace A := by
  rw [connectedSpace_iff_univ]
  have h := hA.connectedFibres (IsLocalRing.closedPoint K)
  convert h using 1
  exact (Set.eq_univ_of_forall fun a => Subsingleton.elim _ _).symm

theorem etale_schemeNsmul (L : RelativeGroupLaw K f) (hc : L.IsCommutative)
    (hA : AbelianSchemePropertyBundle K f) (ℓ : ℕ) (hℓ : (ℓ : K) ≠ 0) : Etale (L.schemeNsmul ℓ) := by
  have hcomm : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      L.mul t x y = L.mul t y x := fun t x y => hc t x y
  have hℓ' : IsUnit (ℓ : K) := isUnit_iff_ne_zero.mpr hℓ
  obtain ⟨hfinN, hflatN⟩ := L.isFinite_and_flat_schemeNsmul_of_isUnit hA hcomm ℓ hℓ'
  haveI := hfinN
  haveI := hflatN
  haveI : FormallyUnramified (L.schemeNsmul ℓ) :=
    L.formallyUnramified_schemeNsmul_of_isUnit_of_isLocalRing hcomm ℓ hℓ'
  haveI : Smooth f := hA.smooth
  haveI : IsLocallyNoetherian A := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : LocallyOfFinitePresentation (L.schemeNsmul ℓ) := inferInstance
  exact Etale.of_formallyUnramified_of_flat _

theorem finite_torsionPoints [IsAlgClosed K] (L : RelativeGroupLaw K f) (hc : L.IsCommutative)
    (hA : AbelianSchemePropertyBundle K f) (ℓ : ℕ) (hℓ : (ℓ : K) ≠ 0) :
    {x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f |
      L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) ℓ x}.Finite := by
  set β : SchemeHomOver f f := L.nsmul f ℓ RelativeGroupLaw.idPoint with hβ
  haveI : IsProper f := hA.proper
  haveI : Etale (L.schemeNsmul ℓ) := etale_schemeNsmul L hc hA ℓ hℓ
  haveI : Etale (L.endKerStr β) := by
    change Etale (pullback.snd (L.schemeNsmul ℓ) (L.one (𝟙 (Spec (CommRingCat.of K)))).1)
    exact MorphismProperty.pullback_snd (P := @Etale) _ _ inferInstance
  obtain ⟨-, hfin, -⟩ := L.isFinite_endKerStr_and_natCard_eq_endDegree_of_etale K f β
  have hset : {x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f |
      L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) ℓ x} =
      {x | x ⊚ β = L.one (𝟙 (Spec (CommRingCat.of K)))} := by
    ext x
    simp only [Set.mem_setOf_eq, RelativeGroupLaw.isTorsionPoint_def, hβ, comp_nsmul_idPoint]
  rw [hset]
  exact Set.finite_coe_iff.mp hfin

end TorsionFinite

section Saturation

variable {K : Type u} [Field K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}

theorem eq_one_of_pow_eq_one [IsAlgClosed K] (L : RelativeGroupLaw K f) (hc : L.IsCommutative)
    (hA : AbelianSchemePropertyBundle K f) (ℓ : ℕ) (hℓK : (ℓ : K) ≠ 0)
    (δ : SchemeHomOver f f) (hδ : IsHom L δ) (hpow : (letI := L.pointCommGroup hc f; δ ^ ℓ) = L.one f) :
    δ = L.one f := by
  haveI : Smooth f := hA.smooth
  haveI : ConnectedSpace A := connectedSpace hA
  haveI : IsReduced A :=
    AlgebraicGeometry.Smooth.isReduced_of_isReduced_of_isLocallyNoetherian f
  have hcomm : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      L.mul t x y = L.mul t y x := fun t x y => hc t x y
  have hsurj := L.nsmul_surjective_of_isAlgClosed_of_connectedSpace hcomm ℓ (isUnit_iff_ne_zero.mpr hℓK)
  apply AlgebraicGeometry.SchemeHomOver.ext_of_forall_point_of_isReduced_of_locallyOfFiniteType K δ (L.one f)
  intro P
  obtain ⟨Q, hQ⟩ := hsurj P
  letI instE := L.pointCommGroup hc f
  letI instP := L.pointCommGroup hc (𝟙 (Spec (CommRingCat.of K)))
  have h1 : P ⊚ δ = L.one _ := by
    rw [← hQ, nsmul_eq_pow L hc, IsHom.comp_pow hc hδ, ← comp_pow_right L hc, hpow, comp_one]
  have h2 : P ⊚ (L.one f) = L.one _ := comp_one L P
  exact (congrArg Subtype.val h1).trans (congrArg Subtype.val h2).symm

end Saturation

theorem main (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f] (hg : 0 < g)
    {ι : Type v} (c : ι → SchemeHomOver f f) (hcHom : ∀ j, IsHom L (c j))
    (hsimple : ∀ β : SchemeHomOver f f, IsHom L β → (∀ j, (c j) ⊚ β = β ⊚ (c j)) →
      β ≠ L.one f → L.endDegree β ≠ 0) :
    ∃ (r : ℕ) (b : Fin r → SchemeHomOver f f),
      (∀ i : Fin r, IsHom L (b i) ∧ ∀ j, (c j) ⊚ (b i) = (b i) ⊚ (c j)) ∧
      ∀ β : SchemeHomOver f f, IsHom L β → (∀ j, (c j) ⊚ β = β ⊚ (c j)) →
        ∃! n : Fin r → ℤ, β = (letI := L.pointCommGroup hc f; ∏ i, b i ^ n i) := by
  classical

  obtain ⟨ℓ, hℓ, hℓK⟩ : ∃ ℓ : ℕ, 1 < ℓ ∧ (ℓ : K) ≠ 0 := by
    by_cases h2 : ((2 : ℕ) : K) = 0
    · refine ⟨3, by norm_num, fun h3 => ?_⟩
      have : ((3 : ℕ) : K) - ((2 : ℕ) : K) = 0 := by rw [h2, h3, sub_zero]
      norm_num at this
    · exact ⟨2, by norm_num, h2⟩
  have hfin := finite_torsionPoints L hc hA ℓ hℓK

  let R := EndAdd L hc c hcHom
  let deg : R → ℤ := fun x => (L.endDegree (toEnd x) : ℤ)

  have hpoly : ∀ (m : ℕ) (α : Fin m → R), ∃ P : MvPolynomial (Fin m) ℚ, P.IsHomogeneous (2 * g) ∧
      ∀ n : Fin m → ℤ, (deg (∑ i, n i • α i) : ℚ) = MvPolynomial.eval (fun i => (n i : ℚ)) P := by
    intro m α
    obtain ⟨P, hP, hev⟩ :=
      GoodReductionJacobian.RelativeGroupLaw.exists_isHomogeneous_eval_eq_endDegree_of_abelianSchemePropertyBundle
        K f L hc hA g (fun i => toEnd (α i)) (fun i _ t x y => toEnd_isHom (α i) t x y)
    refine ⟨P, hP, fun n => ?_⟩
    rw [← hev n]
    change (((L.endDegree (toEnd (∑ i, n i • α i)) : ℕ) : ℤ) : ℚ) = _
    rw [toEnd_sum_zsmul, Int.cast_natCast]

  have hsep : ∀ x : R, x ≠ 0 → deg x ≠ 0 := by
    intro x hx
    have hne : toEnd x ≠ L.one f := by
      intro h
      exact hx (toEnd_injective (h.trans toEnd_zero.symm))
    have h := hsimple (toEnd x) (toEnd_isHom x) (toEnd_comm x) hne
    change ((L.endDegree (toEnd x) : ℕ) : ℤ) ≠ 0
    exact_mod_cast h
  have hD : 2 * g ≠ 0 := by omega

  haveI : IsAddTorsionFree R := isAddTorsionFree_of_degree deg (2 * g) hD hpoly hsep

  have hsat : ∀ M : AddSubgroup R, M.FG →
      ∃ M' : AddSubgroup R, M'.FG ∧ ∀ x : R, x ∈ M' ↔ ∃ k : ℤ, k ≠ 0 ∧ k • x ∈ M :=
    fun M hM => AddCommGroup.exists_fg_saturation_of_isHomogeneous_degree deg (2 * g) hD hpoly hsep M hM

  haveI : Finite (tors L hc ℓ) := by
    have hfin' : {x : KPt L hc | x ∈ tors L hc ℓ}.Finite := by
      refine (hfin.preimage (Function.Injective.injOn (fun a b h => h))).subset ?_
      intro x hx
      exact (mem_tors_iff_isTorsionPoint L hc ℓ).mp hx
    exact hfin'.to_subtype
  haveI : Finite (tors L hc ℓ →* tors L hc ℓ) :=
    Finite.of_injective (fun φ : tors L hc ℓ →* tors L hc ℓ => (φ : tors L hc ℓ → tors L hc ℓ))
      DFunLike.coe_injective
  haveI : Finite (Additive (tors L hc ℓ →* tors L hc ℓ)) := Finite.of_equiv _ Additive.ofMul

  have hρ : ∀ x : R, rho (ℓ := ℓ) x = 0 → ∃ y : R, x = ℓ • y := by
    intro x hx
    have hker : ∀ z : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f,
        L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) ℓ z → z ⊚ (toEnd x) = L.one _ := by
      intro z hz
      have hz' : (show KPt L hc from z) ∈ tors L hc ℓ := (mem_tors_iff_isTorsionPoint L hc ℓ).mpr hz
      exact (rho_eq_zero_iff x).mp hx ⟨_, hz'⟩
    obtain ⟨γ, hγ, hxγ⟩ :=
      GoodReductionJacobian.RelativeGroupLaw.exists_eq_pow_of_forall_isTorsionPoint_schemeHomOverComp_eq_one
        K f L hc hA ℓ hℓK (toEnd x) (fun t a b => toEnd_isHom x t a b) hker
    have hγ' : IsHom L γ := fun T t a b => hγ t a b

    letI instE : CommGroup (SchemeHomOver f f) := L.pointCommGroup hc f
    have hγc : ∀ j, (c j) ⊚ γ = γ ⊚ (c j) := by
      intro j
      set δ : SchemeHomOver f f := (γ ⊚ (c j)) * ((c j) ⊚ γ)⁻¹ with hδdef
      have hδhom : IsHom L δ := by
        let S₀ : Subgroup (EndPt L hc) :=
          commSubgroup L hc (ι := PEmpty.{v + 1}) (fun e => e.elim) (fun e => e.elim)
        have m1 : (show EndPt L hc from (γ ⊚ (c j))) ∈ S₀ := ⟨hγ'.comp (hcHom j), fun e => e.elim⟩
        have m2 : (show EndPt L hc from ((c j) ⊚ γ)) ∈ S₀ := ⟨(hcHom j).comp hγ', fun e => e.elim⟩
        have m3 := S₀.mul_mem m1 (S₀.inv_mem m2)
        exact m3.1
      have hδpow : δ ^ ℓ = L.one f := by
        rw [hδdef, mul_pow, inv_pow, ← IsHom.comp_pow hc (hcHom j) f ℓ γ, ← comp_pow_right L hc (c j) γ ℓ]
        have hx' : γ ^ ℓ = toEnd x := hxγ.symm
        rw [hx', ← toEnd_comm x j, mul_inv_cancel]
        rfl
      have hδ1 : δ = L.one f := eq_one_of_pow_eq_one L hc hA ℓ hℓK δ hδhom hδpow
      have h1 : δ = 1 := hδ1
      rw [hδdef, mul_inv_eq_one] at h1
      exact h1.symm
    let y : R := Additive.ofMul ⟨γ, hγ', hγc⟩
    refine ⟨y, toEnd_injective ?_⟩
    rw [toEnd_nsmul]
    exact hxγ

  obtain ⟨hfinR, hfreeR⟩ :=
    AddCommGroup.moduleFinite_and_free_of_fg_saturation_of_ker_le_nsmul hsat (rho (ℓ := ℓ)) ℓ hℓ hρ

  let bR := Module.finBasis ℤ R
  refine ⟨Module.finrank ℤ R, fun i => toEnd (bR i), fun i => ⟨toEnd_isHom (bR i), toEnd_comm (bR i)⟩, ?_⟩
  intro β hβ hβc
  let x : R := Additive.ofMul ⟨β, hβ, hβc⟩
  have hxβ : toEnd x = β := rfl
  refine ⟨fun i => bR.repr x i, ?_, ?_⟩
  ·
    have h := bR.sum_repr x
    have h' := congrArg toEnd h
    rw [toEnd_sum_zsmul, hxβ] at h'
    exact h'.symm
  ·
    intro n hn'
    have h1 : toEnd (∑ i, n i • bR i) = toEnd x := by
