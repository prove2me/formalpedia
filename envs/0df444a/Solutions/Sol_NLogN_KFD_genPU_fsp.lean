      (by rw [eval_reg h12]; exact hs0) (by rw [eval_reg h12]; exact hs1) hQ)
  have ev : (mAdd Q (.reg 14) (.reg 12)).eval (NLogN.KIL.encK s (toF R)) = (v + sv) % Q := by
    rw [mAdd_eval, eval_reg h14, eval_reg h12]; exact mod_of_sel hv0 hv1 hs0 hs1
  rw [ev, upd_c] at p1
  set R1 : KS := {R with c := (v + sv) % Q :: toF R 11}
  have h14' : toF R1 14 = v :: rest := rfl
  have p2 := Sp.push s (toF R1) (i := 10) (e := .reg 14) (B := Bb) (by decide)
    (clean_reg (by decide)) (ok_reg h14') trivial (bnd_reg h14' (zsz_lt_Q hv0 hv1 hQ))
