-- title:
--   Warm-up objects — Algorithm 1, average rule, independent rounding, $n^{9/5}$ scale
-- statement:
--   Objects of the warm-up implementation (§3.2.1), built on the mission's published graphs, orientation rules and imbalances. Throughout, $H$ is a simple graph on the labelled vertex set $\{0,\dots,n-1\}$, an orientation rule $D$ assigns a direction to every pair $u<v$, and $b_D$ is the imbalance (out-degree minus in-degree) of the orientation $D$ induces on $H$.
--
--   1. **Warm-up scale.** $n\mapsto n^{9/5}$, the query scale of Theorem 1.1.
--   2. **Algorithm 1.** Given a target $b^*\in\mathbb Z^n$ and an integer $T$, put $\eta=1/(2n\sqrt{2T})$ and $y_1=0$. In iteration $t$, the rule $z_t$ directs every pair $u<v$ from $u$ to $v$ if $y_t(u)\le y_t(v)$ and from $v$ to $u$ otherwise; then $\ell_t=b^*-b_{z_t}$ and $y_{t+1}=y_t-\eta\ell_t=y_t+\eta(b_{z_t}-b^*)$, with the exact integer imbalance $b_{z_t}$.
--   3. **Average rule.** With $\pm1$ encoding of integral rules (Definition 3.6: $+1$ for $u\to v$, $-1$ for $v\to u$, on pairs $u<v$), the fractional rule $\bar z=\frac1T\sum_{t=1}^T z_t$. Its imbalance $b_{\bar z}$ is formula (3).
--   4. **Output layout.** A program returning $T$ rules writes rule $t$ (0-based) in memory cells $t\,n^2+u\,n+v$, a nonzero cell meaning $u\to v$ for $u<v$.
--   5. **Independent rounding.** A choice function $I$ assigning an iteration $I(u,v)\in\{1,\dots,T\}$ to every pair $u<v$ defines the rule giving that pair its direction in $z_{I(u,v)}$. The probability of an event under independent uniform choices is the fraction of choice functions satisfying it.
--
--   These objects let Lemmas 3.7 and 3.8 and Theorem 1.1 be stated against the exact algorithm of the source.
--
--   **Formalization Note** Rounds are 0-based: `warmPotential H b T t` is $y_{t+1}$ and `warmRule H b T t` is $z_{t+1}$. Rule cells with $u\ge v$ are ignored by the published `directs`. The product of independent uniform laws on $\{1,\dots,T\}$ over the pairs is the uniform law on choice functions, so probability is a counting ratio.
-- source:
--   Henry Fleischmann, Sagnik Mukhopadhyay, Swagato Sanyal, STOC 2027 submission #503 (October 2026), p. 2 Theorem 1.1, p. 8 Definition 3.6 and (3), p. 9 Algorithm 1 and independent rounding (PDF pp. 4, 10, 11)

import Definitions.Def_SubquadCutReach_Faster_Protocol

set_option autoImplicit false
open scoped BigOperators

namespace SubquadCutReach.Faster.Supplement

open SubquadCutReach.Faster

/-- Theorem 1.1, p. 2 (PDF 4): the warm-up query scale `n^(9/5)`. -/
noncomputable def warmScale (n : ℕ) : ℝ := (n : ℝ) ^ ((9 : ℝ) / 5)

/-- Algorithm 1, step 1 (p. 9, PDF 11): for `u < v`, direct `u → v` iff `y(u) ≤ y(v)`
(ties from the smaller label to the larger). Cells with `u ≥ v` are ignored by `directs`. -/
noncomputable def ruleOf {n : ℕ} (y : Fin n → ℝ) : Rule n := by
  classical
  exact fun u v => decide (y u ≤ y v)

/-- Algorithm 1, line 1.3: `η = 1/(2n√(2T))`. -/
noncomputable def warmEta (n T : ℕ) : ℝ := 1 / (2 * (n : ℝ) * Real.sqrt (2 * (T : ℝ)))

/-- Algorithm 1, steps 2–3: `ℓ_t = b* - b_{z_t}`, `y_(t+1) = y_t - η ℓ_t = y_t + η (b_{z_t} - b*)`,
with the exact integer imbalance `b_{z_t}` of the orientation that `z_t` induces on `H`.
`warmPotential H b T t` is the source's `y_(t+1)` (0-based rounds), started at `0`. -/
noncomputable def warmPotential {n : ℕ} (H : SimpleGraph (Fin n)) (b : Fin n → ℤ) (T : ℕ) :
    ℕ → Fin n → ℝ
  | 0 => fun _ => 0
  | t+1 => fun v => warmPotential H b T t v + warmEta n T *
      ((imbalance (induced H (ruleOf (warmPotential H b T t))) v : ℝ) - (b v : ℝ))

/-- The rule `z_(t+1)` of Algorithm 1 (0-based round `t`). -/
noncomputable def warmRule {n : ℕ} (H : SimpleGraph (Fin n)) (b : Fin n → ℤ) (T t : ℕ) : Rule n :=
  ruleOf (warmPotential H b T t)

/-- Definition 3.6 (p. 8, PDF 10): the `±1` encoding of an integral rule on pairs `u < v`,
`+1` for `u → v` and `-1` for `v → u`. -/
noncomputable def signEncode {n : ℕ} (D : Rule n) : Fractional n :=
  fun u v => if D u v then 1 else -1

/-- The average fractional rule `z̄ = (1/T) Σ_t z_t` of a list of `T` integral rules. -/
noncomputable def avgRules {n T : ℕ} (z : Fin T → Rule n) : Fractional n :=
  fun u v => (∑ t : Fin T, signEncode (z t) u v) / (T : ℝ)

/-- The average `z̄` of the `T` rules generated by Algorithm 1. -/
noncomputable def warmAverage {n : ℕ} (H : SimpleGraph (Fin n)) (b : Fin n → ℤ) (T : ℕ) :
    Fractional n :=
  avgRules fun t : Fin T => warmRule H b T t

/-- Output layout of a program returning `T` rules: rule `t` (0-based) is read, as in
`outputRule`, from the nonnegative cells `t·n·n + u·n + v`, nonzero meaning `u → v` for `u < v`. -/
noncomputable def outputRules (n T : ℕ) (m : Memory) : Fin T → Rule n :=
  fun t u v => decide (m (t.val * n * n + u.val * n + v.val : ℕ) ≠ 0)

/-- Unordered pairs `{u, v}`, written with `u < v`. -/
abbrev Pairs (n : ℕ) := {p : Fin n × Fin n // p.1 < p.2}

/-- Independent rounding (p. 9, PDF 11): a choice `I` of an iteration for every pair
`u < v` gives each pair the direction it has in `z_(I(u,v))`. -/
def roundRule {n T : ℕ} (z : Fin T → Rule n) (I : Pairs n → Fin T) : Rule n :=
  fun u v => if h : u < v then z (I ⟨(u, v), h⟩) u v else false

/-- The probability of an event `E` about the rounded rule when the choices `I(u,v)` are
independent and uniform on the `T` iterations, i.e. `I` is uniform on all choice functions. -/
noncomputable def roundingProb {n T : ℕ} (z : Fin T → Rule n) (E : Rule n → Prop) : ℝ := by
  classical
  exact ((Finset.univ.filter fun I : Pairs n → Fin T => E (roundRule z I)).card : ℝ) /
    (Fintype.card (Pairs n → Fin T) : ℝ)

end SubquadCutReach.Faster.Supplement


