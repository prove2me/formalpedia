    have hq : m / AModel.vol sh < q := (Nat.div_lt_iff_lt_mul hV).2 h
    simp only [decode, encode, List.headD_cons, List.tail_cons, Nat.mod_eq_of_lt hq,
      ih (Nat.mod_lt m hV)]
    exact Nat.div_add_mod' m (AModel.vol sh)

