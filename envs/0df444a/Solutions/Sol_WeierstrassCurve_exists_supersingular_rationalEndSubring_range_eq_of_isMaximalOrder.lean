theorem DES3.congruenceLevel_self {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) :
    congruenceLevel Λ Λ = Submodule.finiteIdeleStabilizer Λ := by
  refine le_antisymm (congruenceLevel_le Λ Λ) fun u hu => ⟨hu, hu, fun x hx => sub_mem ?_ hx⟩
  have hmem : (u : ℍ[ℚ, a, b] ⊗[ℚ] IsDedekindDomain.FiniteAdeleRing (𝓞 ℚ) ℚ) * x ∈
      u • ((Submodule.finiteAdeleBox Λ : AddSubgroup _) : Set (ℍ[ℚ, a, b] ⊗[ℚ] IsDedekindDomain.FiniteAdeleRing (𝓞 ℚ) ℚ)) :=
    Set.smul_mem_smul_set hx
  rwa [(Submodule.mem_finiteIdeleStabilizer_iff Λ u).mp hu] at hmem

