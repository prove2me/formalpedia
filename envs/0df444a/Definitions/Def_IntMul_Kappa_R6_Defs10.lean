namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

@[simp] theorem St.set_stk (σ : St S) (i j : Fin S) (l : List Sym) :
    (σ.set i l).stk j = if j = i then l else σ.stk j := by
  simp [St.set, Function.update_apply]

/-! ### Normalising chains of `set` -/

@[simp] theorem St.push_set_same (σ : St S) (i : Fin S) (l : List Sym) (a : Sym) :
    (σ.set i l).push i a = σ.set i (a :: l) := by
  simp [St.push, St.set]

theorem St.push_set_ne (σ : St S) {i j : Fin S} (l : List Sym) (a : Sym) (h : j ≠ i) :
    (σ.set i l).push j a = (σ.push j a).set i l := by
  simp only [St.push, St.set, St.mk.injEq, and_true]
  funext k; simp only [Function.update_apply]; split_ifs <;> simp_all

@[simp] theorem St.pop_set_same (σ : St S) (i : Fin S) (l : List Sym) :
    (σ.set i l).pop i = σ.set i l.tail := by
  simp [St.pop, St.set]

theorem St.pop_set_ne (σ : St S) {i j : Fin S} (l : List Sym) (h : j ≠ i) :
    (σ.set i l).pop j = (σ.pop j).set i l := by
  simp only [St.pop, St.set, St.mk.injEq, and_true]
  funext k; simp only [Function.update_apply]; split_ifs <;> simp_all

theorem St.top_set (σ : St S) (i j : Fin S) (l : List Sym) :
    (σ.set i l).top j = if j = i then l.head? else σ.top j := by
  simp [St.top, St.set, Function.update_apply]; split_ifs <;> rfl

@[simp] theorem St.top_set_same (σ : St S) (i : Fin S) (l : List Sym) :
    (σ.set i l).top i = l.head? := by simp [St.top_set]

/-- Simp set for stepping transducers; add the needed `≠` facts. -/
theorem St.push_eq_set (σ : St S) (i : Fin S) (a : Sym) : σ.push i a = σ.set i (a :: σ.stk i) :=
  rfl

theorem St.set_of_eq (σ : St S) (i : Fin S) (l : List Sym) (h : σ.stk i = l) : σ.set i l = σ := by
  subst h; simp [St.set]

@[simp] theorem St.set_self (σ : St S) (i : Fin S) : σ.set i (σ.stk i) = σ := St.set_of_eq _ _ _ rfl

