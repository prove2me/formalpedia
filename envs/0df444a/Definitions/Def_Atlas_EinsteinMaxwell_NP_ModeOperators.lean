/-! ### Definitions -/

/-- `(r, θ)` of `x = (t, r, θ, φ)`, in III's coordinate order. -/
def toRT (x : Pt 4) : Fin 2 → ℝ := ![x 1, x 2]

/-- Mode phase `P(t, φ) = exp(−iωt + imφ)`. -/
noncomputable def phaseP (om mm : ℝ) (x : Pt 4) : ℂ :=
  Complex.exp (-(Complex.I * om * x 0) + Complex.I * mm * x 3)

/-- Single-mode field `P(t, φ) u(r, θ)`. -/
noncomputable def modeField (om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4) : ℂ :=
  phaseP om mm x * u (toRT x)

