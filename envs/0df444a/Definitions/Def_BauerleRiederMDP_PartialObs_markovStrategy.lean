-- title:
--   The strategy $f_n(h_n):=f'_n(x_n,\mu_n(\cdot\mid h_n))$
-- statement:
--   A Markov policy $(f'_0,f'_1,\dots)$ of the filtered model induces a portfolio strategy of the partially observed problem:
--   $$
--   f_n(h_n):=f'_n\big(x_n,\mu_n(\cdot\mid h_n)\big),
--   $$
--   where $x_n$ is the wealth generated by the rules and $\mu_n$ the filter, both computed from the initial wealth, the initial belief and the observed returns $(z_1,\dots,z_n)$. The book uses it with the prior $Q_0$ as initial belief; in Theorem 6.1.1 d) with $f'_n=f^*_{N-n}$, in Theorem 6.2.3 with $f'_n=f^*_n$.
-- source:
--   Bäuerle & Rieder (2011), §5.3, p.158 (PDF 171); Theorem 6.1.1 d), p.177 (PDF 190); Theorem 6.2.3 b), p.188 (PDF 201)

import Mathlib
import Definitions.Def_BauerleRiederMDP_PartialObs_markovWealth

open MeasureTheory ProbabilityTheory
open scoped ENNReal Matrix

namespace BauerleRiederMDP.PartialObs

/-- **The portfolio strategy generated by decision rules of the filtered model.**
Bäuerle & Rieder (2011), §5.3, p.158 (PDF 171), and Theorem 6.1.1 d), p.177 (PDF 190):
`f_n(h_n) := f'_n(x_n, μ_n(·|h_n))`.

`markovStrategy M i x ρ f n r = f n (x_n, μ_n)`, where `x_n = markovWealth M i x ρ f n r` and
`μ_n = M.filter ρ n r` along the observed return path `r = (z_1, …, z_n)`; this is a portfolio
strategy in the sense of `wealth` (a function of the observed returns), and the book's strategies
take `ρ = Q_0`. -/
noncomputable def markovStrategy {EY : Type*} [MeasurableSpace EY] {d : ℕ} (M : Market EY d)
    (i : ℕ → ℝ) (x : ℝ) (ρ : ProbabilityMeasure EY)
    (f : ℕ → ℝ × ProbabilityMeasure EY → Fin d → ℝ) :
    (n : ℕ) → (Fin n → Fin d → ℝ) → Fin d → ℝ :=
  fun n r => f n (markovWealth M i x ρ f n r, M.filter ρ n r)

end BauerleRiederMDP.PartialObs


