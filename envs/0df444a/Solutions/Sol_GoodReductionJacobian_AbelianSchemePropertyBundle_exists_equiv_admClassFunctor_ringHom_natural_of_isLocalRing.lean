variable {R₀ : Type} [CommRing R₀] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R₀)} (L : RelativeGroupLaw R₀ f)

abbrev κ₀ (B : Under (CommRingCat.of R₀)) : Spec (CommRingCat.of B.right) ⟶ Spec (CommRingCat.of R₀) :=
  letI := algS R₀ R₀ B
  Spec.map (CommRingCat.ofHom (algebraMap R₀ B.right)) ≫ 𝟙 _

theorem ι_eq_κ₀ (B : Under (CommRingCat.of R₀)) : SymmRoot.ι R₀ R₀ B = κ₀ B := (Category.comp_id _).symm

theorem algebraMap_algS (B : Under (CommRingCat.of R₀)) :
    letI := algS R₀ R₀ B; (algebraMap R₀ B.right : R₀ →+* B.right) = B.hom.hom := by
  ext x; rfl

def algHomOfHom {B B' : Under (CommRingCat.of R₀)} (φ : B ⟶ B') :
    letI := algS R₀ R₀ B; letI := algS R₀ R₀ B'; B.right →ₐ[R₀] B'.right :=
  letI := algS R₀ R₀ B; letI := algS R₀ R₀ B'
  AlgHom.mk φ.right.hom fun r => by
    change φ.right.hom (B.hom.hom r) = B'.hom.hom r
    rw [← Under.w φ]; rfl

theorem algHomOfHom_toRingHom {B B' : Under (CommRingCat.of R₀)} (φ : B ⟶ B') :
    letI := algS R₀ R₀ B; letI := algS R₀ R₀ B'; (algHomOfHom (R₀ := R₀) φ).toRingHom = φ.right.hom := rfl

theorem spec_map_algHomOfHom {B B' : Under (CommRingCat.of R₀)} (φ : B ⟶ B') :
    letI := algS R₀ R₀ B; letI := algS R₀ R₀ B'
    Spec.map (CommRingCat.ofHom (algHomOfHom (R₀ := R₀) φ).toRingHom) = (SymmRoot.ψ R₀ R₀ φ).1 := by
  rw [algHomOfHom_toRingHom, CommRingCat.ofHom_hom, ψ_val]

variable (Φ : ∀ (R : Type) [CommRing R] (ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of R₀)),
    RigidifiedLineBundle f (L.one (𝟙 _)) ι → L.TorsionCharacter 2 ι)
  {D : Type} [CommRing D] [Algebra R₀ D]
  (Ψ : ∀ (R' : Type) [CommRing R'] [Algebra R₀ R'],
    L.TorsionCharacter 2 (Spec.map (CommRingCat.ofHom (algebraMap R₀ R')) ≫ 𝟙 _) ≃ (D →ₐ[R₀] R'))

def charOf (B : Under (CommRingCat.of R₀)) (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)) :
    L.TorsionCharacter 2 (κ₀ B) :=
  tcCast L 2 (ι_eq_κ₀ B) (Φ B.right (SymmRoot.ι R₀ R₀ B) N)

def homOf (B : Under (CommRingCat.of R₀)) (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)) :
    {φ : D →+* B.right // φ.comp (algebraMap R₀ D) = B.hom.hom} :=
  letI := algS R₀ R₀ B
  ⟨(Ψ B.right (charOf L Φ B N)).toRingHom, (AlgHom.comp_algebraMap _).trans (algebraMap_algS B)⟩

variable (P : StablePred f (L.one (𝟙 _)) R₀)
  (hΦi : ∀ (B : Under (CommRingCat.of R₀)) (N N' : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
    Nonempty (N.L ≅ N'.L) → Φ B.right (SymmRoot.ι R₀ R₀ B) N = Φ B.right (SymmRoot.ι R₀ R₀ B) N')

def eFun (B : Under (CommRingCat.of R₀)) :
    (classFunctor f (L.one (𝟙 _)) R₀ P).obj B → {φ : D →+* B.right // φ.comp (algebraMap R₀ D) = B.hom.hom} :=
  Quotient.lift (fun x : Elem f (L.one (𝟙 _)) R₀ P B => homOf L Φ Ψ B x.M) fun x y h => by
    simp only [homOf, charOf, hΦi B x.M y.M h]

theorem eFun_mk (B : Under (CommRingCat.of R₀)) (x : Elem f (L.one (𝟙 _)) R₀ P B) :
    eFun L Φ Ψ P hΦi B (SymmRoot.mk f (L.one (𝟙 _)) R₀ P x) = homOf L Φ Ψ B x.M := rfl

end main

section adm
variable {R₀ : Type} [CommRing R₀] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R₀)} (L : RelativeGroupLaw R₀ f)
  (Φ : ∀ (R : Type) [CommRing R] (ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of R₀)),
    RigidifiedLineBundle f (L.one (𝟙 _)) ι → L.TorsionCharacter 2 ι)
  {D : Type} [CommRing D] [Algebra R₀ D]
  (Ψ : ∀ (R' : Type) [CommRing R'] [Algebra R₀ R'],
    L.TorsionCharacter 2 (Spec.map (CommRingCat.ofHom (algebraMap R₀ R')) ≫ 𝟙 _) ≃ (D →ₐ[R₀] R'))
  (hadm : ∀ {B B' : Under (CommRingCat.of R₀)} (φ : B ⟶ B')
      (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
      admPred L R₀ B N.L → admPred L R₀ B' (N.pullbackAlong (SymmRoot.ψ R₀ R₀ φ)).L)
  (hΦi : ∀ (B : Under (CommRingCat.of R₀)) (N N' : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
    Nonempty (N.L ≅ N'.L) → Φ B.right (SymmRoot.ι R₀ R₀ B) N = Φ B.right (SymmRoot.ι R₀ R₀ B) N')

theorem eFun_injective
    (hΦiv : ∀ (B : Under (CommRingCat.of R₀)) (N N' : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
      admPred L R₀ B N.L → admPred L R₀ B N'.L →
        Φ B.right (SymmRoot.ι R₀ R₀ B) N = Φ B.right (SymmRoot.ι R₀ R₀ B) N' → Nonempty (N.L ≅ N'.L))
    (B : Under (CommRingCat.of R₀)) :
    Function.Injective (eFun L Φ Ψ (admStablePred L R₀ hadm) hΦi B) := by
  letI := algS R₀ R₀ B
  intro x y hxy
  obtain ⟨x, rfl⟩ := SymmRoot.mk_surjective f (L.one (𝟙 _)) R₀ _ B x
  obtain ⟨y, rfl⟩ := SymmRoot.mk_surjective f (L.one (𝟙 _)) R₀ _ B y
  rw [eFun_mk, eFun_mk] at hxy
  have h1 : ((Ψ B.right (charOf L Φ B x.M) : D →ₐ[R₀] B.right) : D →+* B.right) = (Ψ B.right (charOf L Φ B y.M) : D →+* B.right) :=
    congrArg Subtype.val hxy
  have h2 : Ψ B.right (charOf L Φ B x.M) = Ψ B.right (charOf L Φ B y.M) := AlgHom.coe_ringHom_injective h1
  have h3 : charOf L Φ B x.M = charOf L Φ B y.M := (Ψ B.right).injective h2
  have h4 : Φ B.right (SymmRoot.ι R₀ R₀ B) x.M = Φ B.right (SymmRoot.ι R₀ R₀ B) y.M := tcCast_injective L 2 _ h3
  obtain ⟨i⟩ := hΦiv B x.M y.M x.prop y.prop h4
  exact Quotient.sound ⟨i⟩

theorem eFun_surjective
    (hΦiii : ∀ (B : Under (CommRingCat.of R₀)) (χ : L.TorsionCharacter 2 (SymmRoot.ι R₀ R₀ B)),
      ∃ N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B), admPred L R₀ B N.L ∧ Φ B.right (SymmRoot.ι R₀ R₀ B) N = χ)
    (B : Under (CommRingCat.of R₀)) :
    Function.Surjective (eFun L Φ Ψ (admStablePred L R₀ hadm) hΦi B) := by
  letI := algS R₀ R₀ B
  intro φ
  let a : D →ₐ[R₀] B.right := AlgHom.mk φ.1 fun r => (RingHom.congr_fun φ.2 r).trans rfl
  obtain ⟨N, hN, hΦN⟩ := hΦiii B (tcCast L 2 (ι_eq_κ₀ B).symm ((Ψ B.right).symm a))
  refine ⟨SymmRoot.mk f (L.one (𝟙 _)) R₀ _ ⟨N, hN⟩, ?_⟩
  rw [eFun_mk]
  apply Subtype.ext
  change ((Ψ B.right (charOf L Φ B N) : D →ₐ[R₀] B.right) : D →+* B.right) = φ.1
  rw [charOf, hΦN, tcCast_apply_symm, Equiv.apply_symm_apply]
  rfl

theorem eFun_natural
    (hΦii : ∀ (B B' : Under (CommRingCat.of R₀)) (φ : B ⟶ B') (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B))
      (T : Type) [CommRing T] (κ' : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of B'.right))
      (x' : SchemeHomOver (κ' ≫ SymmRoot.ι R₀ R₀ B') f) (hx' : L.IsTorsionPoint (κ' ≫ SymmRoot.ι R₀ R₀ B') 2 x')
      (x : SchemeHomOver ((κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) ≫ SymmRoot.ι R₀ R₀ B) f)
      (hx : L.IsTorsionPoint ((κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) ≫ SymmRoot.ι R₀ R₀ B) 2 x),
      admPred L R₀ B N.L → x'.1 = x.1 →
        (Φ B'.right (SymmRoot.ι R₀ R₀ B') (N.pullbackAlong (SymmRoot.ψ R₀ R₀ φ))).val T κ' x' hx' =
          (Φ B.right (SymmRoot.ι R₀ R₀ B) N).val T (κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) x hx)
    (hΨnat : ∀ (R' R'' : Type) [CommRing R'] [Algebra R₀ R'] [CommRing R''] [Algebra R₀ R''] (g : R' →ₐ[R₀] R'')
      (χ' : L.TorsionCharacter 2 (Spec.map (CommRingCat.ofHom (algebraMap R₀ R')) ≫ 𝟙 _))
      (χ'' : L.TorsionCharacter 2 (Spec.map (CommRingCat.ofHom (algebraMap R₀ R'')) ≫ 𝟙 _)),
      (∀ (T : Type) [CommRing T] (κ'' : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of R''))
          (x'' : SchemeHomOver (κ'' ≫ (Spec.map (CommRingCat.ofHom (algebraMap R₀ R'')) ≫ 𝟙 _)) f)
          (hx'' : L.IsTorsionPoint _ 2 x'')
          (x' : SchemeHomOver ((κ'' ≫ Spec.map (CommRingCat.ofHom g.toRingHom)) ≫
            (Spec.map (CommRingCat.ofHom (algebraMap R₀ R')) ≫ 𝟙 _)) f)
          (hx' : L.IsTorsionPoint _ 2 x'),
          x''.1 = x'.1 →
            χ''.val T κ'' x'' hx'' = χ'.val T (κ'' ≫ Spec.map (CommRingCat.ofHom g.toRingHom)) x' hx') →
      Ψ R'' χ'' = g.comp (Ψ R' χ'))
    (B B' : Under (CommRingCat.of R₀)) (ψ : B ⟶ B')
    (x : (classFunctor f (L.one (𝟙 _)) R₀ (admStablePred L R₀ hadm)).obj B) :
    ((eFun L Φ Ψ (admStablePred L R₀ hadm) hΦi B')
        ((classFunctor f (L.one (𝟙 _)) R₀ (admStablePred L R₀ hadm)).map ψ x)).1 =
      ψ.right.hom.comp ((eFun L Φ Ψ (admStablePred L R₀ hadm) hΦi B) x).1 := by
  letI := algS R₀ R₀ B; letI := algS R₀ R₀ B'
  obtain ⟨x, rfl⟩ := SymmRoot.mk_surjective f (L.one (𝟙 _)) R₀ _ B x
  rw [map_mk, eFun_mk, eFun_mk]
  change ((Ψ B'.right (charOf L Φ B' (x.M.pullbackAlong (SymmRoot.ψ R₀ R₀ ψ))) : D →ₐ[R₀] B'.right) : D →+* B'.right) =
    ψ.right.hom.comp (Ψ B.right (charOf L Φ B x.M) : D →+* B.right)
  have key : Ψ B'.right (charOf L Φ B' (x.M.pullbackAlong (SymmRoot.ψ R₀ R₀ ψ))) =
      (algHomOfHom ψ).comp (Ψ B.right (charOf L Φ B x.M)) := by
    apply hΨnat B.right B'.right (algHomOfHom ψ)
    intro T _ κ'' x'' hx'' x' hx' hxx
    have hb : (κ'' ≫ (SymmRoot.ψ R₀ R₀ ψ).1) ≫ SymmRoot.ι R₀ R₀ B =
        (κ'' ≫ Spec.map (CommRingCat.ofHom (algHomOfHom ψ).toRingHom)) ≫ κ₀ B := by
      rw [spec_map_algHomOfHom]
      exact congrArg (fun t => (κ'' ≫ (SymmRoot.ψ R₀ R₀ ψ).1) ≫ t) (ι_eq_κ₀ B)
    have hk : κ'' ≫ (SymmRoot.ψ R₀ R₀ ψ).1 = κ'' ≫ Spec.map (CommRingCat.ofHom (algHomOfHom ψ).toRingHom) := by
      rw [spec_map_algHomOfHom]
    let X'' : SchemeHomOver (κ'' ≫ SymmRoot.ι R₀ R₀ B') f := ⟨x''.1, by rw [ι_eq_κ₀]; exact x''.2⟩
    let X : SchemeHomOver ((κ'' ≫ (SymmRoot.ψ R₀ R₀ ψ).1) ≫ SymmRoot.ι R₀ R₀ B) f := ⟨x'.1, by rw [hb]; exact x'.2⟩
    let X₁ : SchemeHomOver ((κ'' ≫ Spec.map (CommRingCat.ofHom (algHomOfHom ψ).toRingHom)) ≫ SymmRoot.ι R₀ R₀ B) f :=
      ⟨x'.1, by rw [ι_eq_κ₀]; exact x'.2⟩
    have HX'' : L.IsTorsionPoint _ 2 X'' := (isTorsionPoint_congr L 2 (by rw [ι_eq_κ₀]) x'' X'' rfl).1 hx''
    have HX : L.IsTorsionPoint _ 2 X := (isTorsionPoint_congr L 2 hb.symm x' X rfl).1 hx'
    have HX₁ : L.IsTorsionPoint _ 2 X₁ := (isTorsionPoint_congr L 2 (by rw [ι_eq_κ₀]) x' X₁ rfl).1 hx'
    calc (charOf L Φ B' (x.M.pullbackAlong (SymmRoot.ψ R₀ R₀ ψ))).val T κ'' x'' hx''
        = (Φ B'.right (SymmRoot.ι R₀ R₀ B') (x.M.pullbackAlong (SymmRoot.ψ R₀ R₀ ψ))).val T κ'' X'' HX'' :=
          tcCast_val L 2 _ _ T κ'' x'' hx'' X'' HX'' rfl
      _ = (Φ B.right (SymmRoot.ι R₀ R₀ B) x.M).val T (κ'' ≫ (SymmRoot.ψ R₀ R₀ ψ).1) X HX :=
          hΦii B B' ψ x.M T κ'' X'' HX'' X HX x.prop hxx
      _ = (Φ B.right (SymmRoot.ι R₀ R₀ B) x.M).val T (κ'' ≫ Spec.map (CommRingCat.ofHom (algHomOfHom ψ).toRingHom)) X₁ HX₁ :=
          val_congr L 2 _ T hk X HX X₁ HX₁ rfl
      _ = (charOf L Φ B x.M).val T (κ'' ≫ Spec.map (CommRingCat.ofHom (algHomOfHom ψ).toRingHom)) x' hx' :=
          (tcCast_val L 2 _ _ T _ x' hx' X₁ HX₁ rfl).symm
  rw [key]
  ext d
  rfl

end adm

end C4bS23

open C4bS23 in
theorem solution
    {R₀ : Type} [CommRing R₀] [IsNoetherianRing R₀] [IsLocalRing R₀] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R₀)}
    (L : RelativeGroupLaw R₀ f) (hA : AbelianSchemePropertyBundle R₀ f)
    (hadm : ∀ {B B' : Under (CommRingCat.of R₀)} (φ : B ⟶ B')
      (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
      admPred L R₀ B N.L → admPred L R₀ B' (N.pullbackAlong (SymmRoot.ψ R₀ R₀ φ)).L) :
    ∃ (D : Type) (_ : CommRing D) (_ : Algebra R₀ D) (_ : Module.Finite R₀ D) (_ : Module.Free R₀ D) (_ : Nontrivial D),
      ∃ e : ∀ B' : Under (CommRingCat.of R₀),
          (classFunctor f (L.one (𝟙 _)) R₀ (admStablePred L R₀ hadm)).obj B' ≃
            {φ : D →+* B'.right // φ.comp (algebraMap R₀ D) = B'.hom.hom},
        ∀ (B' B'' : Under (CommRingCat.of R₀)) (ψ : B' ⟶ B'')
          (x : (classFunctor f (L.one (𝟙 _)) R₀ (admStablePred L R₀ hadm)).obj B'),
          ((e B'') ((classFunctor f (L.one (𝟙 _)) R₀ (admStablePred L R₀ hadm)).map ψ x)).1 =
            ψ.right.hom.comp ((e B') x).1 := by

  haveI := hA.smooth
  obtain ⟨g, hg⟩ := RelativeGroupLaw.exists_smoothOfRelativeDimension_of_smooth_of_isLocalRing L
  haveI := hg
  obtain ⟨hk1, hk2, hk3, -⟩ :=
    L.isFinite_flat_schemeKerStr_and_schemeNsmul_of_abelianSchemePropertyBundle (hA.isCommutative L) hA g 2 two_ne_zero

  obtain ⟨Φ, hΦi, hΦii, hΦiii, hΦiv, -, -⟩ :=
    AlgebraicGeometry.Polarisation.exists_torsionCharacter_two_bijOn_symmetric_tensor_self_rigidifiedLineBundle
      L (hA.isCommutative L) hA ⟨hk1, hk2, hk3⟩

  obtain ⟨H, _, _, _, _, _, eH, heH_mul, heH_nat⟩ :=
    L.exists_hopfAlgebra_equiv_torsionSubset_of_isLocalRing_of_isNoetherianRing hA 2 two_ne_zero (R := R₀) (𝟙 _)
  obtain ⟨Ψ, hΨnat, -, -⟩ :=
    RelativeGroupLaw.TorsionCharacter.exists_equiv_algHom_cartierDual_of_torsionSubset_equiv L 2 (𝟙 _) H eH heH_mul heH_nat

  have hnt : Nontrivial (CartierDual R₀ H) :=
    (Ψ R₀ (Φ R₀ _ (RigidifiedLineBundle.unit _)) : CartierDual R₀ H →ₐ[R₀] R₀).toRingHom.domain_nontrivial
  refine ⟨CartierDual R₀ H, inferInstance, inferInstance, inferInstance, inferInstance, hnt, ?_⟩
  have hΦi' : ∀ (B : Under (CommRingCat.of R₀)) (N N' : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
      Nonempty (N.L ≅ N'.L) → Φ B.right (SymmRoot.ι R₀ R₀ B) N = Φ B.right (SymmRoot.ι R₀ R₀ B) N' :=
    fun B N N' h => hΦi B.right (SymmRoot.ι R₀ R₀ B) N N' h
  have hΦiii' : ∀ (B : Under (CommRingCat.of R₀)) (χ : L.TorsionCharacter 2 (SymmRoot.ι R₀ R₀ B)),
      ∃ N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B), admPred L R₀ B N.L ∧ Φ B.right (SymmRoot.ι R₀ R₀ B) N = χ :=
    fun B χ => hΦiii B.right (SymmRoot.ι R₀ R₀ B) χ
  have hΦiv' : ∀ (B : Under (CommRingCat.of R₀)) (N N' : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B)),
      admPred L R₀ B N.L → admPred L R₀ B N'.L →
        Φ B.right (SymmRoot.ι R₀ R₀ B) N = Φ B.right (SymmRoot.ι R₀ R₀ B) N' → Nonempty (N.L ≅ N'.L) :=
    fun B N N' hN hN' h => hΦiv B.right (SymmRoot.ι R₀ R₀ B) N N' hN hN' h
  have hΦii' : ∀ (B B' : Under (CommRingCat.of R₀)) (φ : B ⟶ B') (N : RigidifiedLineBundle f (L.one (𝟙 _)) (SymmRoot.ι R₀ R₀ B))
      (T : Type) [CommRing T] (κ' : Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of B'.right))
      (x' : SchemeHomOver (κ' ≫ SymmRoot.ι R₀ R₀ B') f) (hx' : L.IsTorsionPoint (κ' ≫ SymmRoot.ι R₀ R₀ B') 2 x')
      (x : SchemeHomOver ((κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) ≫ SymmRoot.ι R₀ R₀ B) f)
      (hx : L.IsTorsionPoint ((κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) ≫ SymmRoot.ι R₀ R₀ B) 2 x),
      admPred L R₀ B N.L → x'.1 = x.1 →
        (Φ B'.right (SymmRoot.ι R₀ R₀ B') (N.pullbackAlong (SymmRoot.ψ R₀ R₀ φ))).val T κ' x' hx' =
          (Φ B.right (SymmRoot.ι R₀ R₀ B) N).val T (κ' ≫ (SymmRoot.ψ R₀ R₀ φ).1) x hx :=
    fun B B' φ N T _ κ' x' hx' x hx hN hxx =>
      hΦii B.right B'.right (SymmRoot.ι R₀ R₀ B) (SymmRoot.ι R₀ R₀ B') (SymmRoot.ψ R₀ R₀ φ) N T κ' x' hx' x hx hN hxx
  exact ⟨fun B => Equiv.ofBijective _ ⟨eFun_injective L Φ Ψ hadm hΦi' hΦiv' B, eFun_surjective L Φ Ψ hadm hΦi' hΦiii' B⟩,
    fun B' B'' ψ x => eFun_natural L Φ Ψ hadm hΦi' hΦii' hΨnat B' B'' ψ x⟩

end
