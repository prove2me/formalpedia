theorem solution {l : List (Fin NLogN.HS × ℤ)} {s : NLogN.IState NLogN.HS}
    (h : ∀ p ∈ l, ∃ L, s.G p.1 = .int p.2 :: L) : NLogN.KIL.PV (NLogN.KIL.pmOf l) s :=
  fun _ _ hv => h _ (NLogN.KIL.pmOf_some hv)
