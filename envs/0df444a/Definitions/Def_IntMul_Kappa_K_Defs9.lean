-- Source module: Solutions.SynthConv
/-!
# §7.1 The normalized convolution interface (Proposition 18)

* `conv`: multidimensional cyclic convolution on the box `∏ ℤ/2^{a_i}` with values in `R`.
* `Fm_conv` (**convolution theorem**): `F^-(f ∗ g) = M (F^- f)(F^- g)`.
* `normalization`: `M F^+((F^- f)(F^- g)/r) = (f ∗ g)/(rM) = M_r(f, g)` on the box.
* `norm_Mr_le`: `M_r` is a bilinear contraction, `‖M_r(f,g)‖_∞ ≤ ‖f‖_∞ ‖g‖_∞`;
  `Mr_sub_left` (bilinearity) and `norm_Mr_sub_left`.
* `pointwise_pull`: a pointwise product commutes with any record permutation (`LB`).
* `prop18_error`: from the forward errors `< δ`, the product-truncation error `< η` and the
  opposite procedure's error `< δ`, the opposite output is within `3δ + η` of `T₊ z*`;
  `prop18_scaled` multiplies by `M`, `prop18_constant` is `M(3δ+η) = √2 M (3ℓ+1) 2^{-p}`, and
  `prop18_disk` is the closing disk argument.
  (The forward and opposite error bounds are hypotheses: they are Lemma 16's outputs, which rest
  on Proposition 14 and hence on the Proposition 8 interface `Prop8Iface`.)
-/

set_option linter.unusedSectionVars false

namespace Synth

open Finset Butterfly

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

/-! ## 1. Cyclic convolution and the convolution theorem -/

/-- Cyclic sum of addresses `(k + m) mod t`. -/
def wrap (a : Fin D → ℕ) (k m : Fin D → ℕ) : Fin D → ℕ := fun i => (k i + m i) % 2 ^ a i

/-- Cyclic convolution in the displayed axes. -/
noncomputable def conv (a : Fin D → ℕ) (f g : (Fin D → ℕ) → R) (x : Fin D → ℕ) : R :=
  ∑ k ∈ box a, ∑ m ∈ box a, if wrap a k m = x then f k * g m else 0

variable {y}

/-- `M_r(f, g) = (f ∗ g)/(rM)`. -/
noncomputable def Mr (r : ℕ) (a : Fin D → ℕ) (f g : (Fin D → ℕ) → R) (x : Fin D → ℕ) : R :=
  ((r * Mv a : ℕ) : ℂ)⁻¹ • conv a f g x

/-! ## 2. `M_r` is a bilinear contraction -/

