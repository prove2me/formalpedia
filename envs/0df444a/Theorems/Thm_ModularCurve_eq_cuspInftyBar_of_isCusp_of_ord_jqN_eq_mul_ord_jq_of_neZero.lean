-- title:
--   Cusp with ord j(q^N)=Nord j is ∞
-- statement:
--   Fix a natural number $N \neq 0$ and work inside the field $F_N$ denoted `modularFunctionFieldBar N`: the intermediate field of $\overline{\mathbf Q}((q))$ over $\overline{\mathbf Q}$ generated by the coefficientwise image, under the ring map `coeffEmb` induced by $\mathbf Q \to \overline{\mathbf Q}$, of the field `modularFunctionFieldFull N`, which is itself $\mathbf Q$ adjoined to the set `divisorExpansions N` inside $\mathbf Q((q))$. Let $w$ be a place of $F_N$ over $\overline{\mathbf Q}$, that is, a valuation subring of $F_N$ containing the image of $\overline{\mathbf Q}$, different from the whole field, and a principal ideal ring; write $w.\mathrm{ord}$ for the associated integer-valued order function, the negative of the logarithm of the associated adic valuation. Let $j \in F_N$ be the element $\mathrm{coeffEmb}(jq)$, where $jq = q^{-1}\cdot \mathrm{jNumQ}(q)$ is the $q$-expansion of the modular invariant, and let $j_N \in F_N$ be $\mathrm{coeffEmb}$ of $\mathrm{qExpand}\,N\,(jq)$, the Laurent series obtained from $jq$ by scaling exponents by $N$ (substituting $q \mapsto q^N$). Assume that $j$ is a cusp for $w$, i.e. $j$ does not lie in the valuation subring of $w$, and that $w.\mathrm{ord}(j_N) = N \cdot w.\mathrm{ord}(j)$. Then $w$ equals `cuspInftyBar N`, the place whose valuation subring is `qIntegersBar`, attached to the fact that the $q$-series of $j$ has order $-1$.
--
--   This identifies the cusp $\infty$ of $X_0(N)$ over $\overline{\mathbf Q}$ among all cusps by the numerical relation $\operatorname{ord} j(q^N) = N \cdot \operatorname{ord} j$, the other cusps $a/c$ with $c \mid N$ giving the ratio $c^2/N < N$. It is the level-$N$ form of the corresponding statement for prime level, and is used in the analysis of places reducing modulo $\ell$, where the cusp $\infty$ must be recognised from order data alone.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_eq_cuspInftyBar_of_isCusp_of_ord_jqN_eq_mul_ord_jq_of_neZero.lean

import Definitions.Def_ModularCurve_CuspidalClass

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open ModularCurve AlgebraicCurve

theorem ModularCurve.eq_cuspInftyBar_of_isCusp_of_ord_jqN_eq_mul_ord_jq_of_neZero
    (N : ℕ) [NeZero N]
    (w : Place (AlgebraicClosure ℚ) (modularFunctionFieldBar N))
    (hc : IsCusp (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (jq_mem_full N)⟩ : modularFunctionFieldBar N) w)
    (hord : w.ord (⟨coeffEmb (AlgebraicClosure ℚ) (qExpand ℚ N jq),
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (jqd_mem_full N (dvd_refl N))⟩ : modularFunctionFieldBar N)
        = (N : ℤ) * w.ord (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (jq_mem_full N)⟩ : modularFunctionFieldBar N)) :
    w = cuspInftyBar N := by sorry
