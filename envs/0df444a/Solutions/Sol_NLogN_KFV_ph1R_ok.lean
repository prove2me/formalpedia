theorem extA_mvIdx {nA nF nG n : ℕ} (h : nA + nF + nG ≤ n) {a : List ℕ} (ha : n ≤ a.length) :
    extA n (permIdx (KFU.mvIdx nA nF nG)) a = KIL.swapMid nA nF nG a := by
  apply List.ext_getElem?
  intro i
  rw [KFU.swapMid_getElem? nA nF nG a (by omega)]
  unfold extA
  by_cases hi : i < n
  · rw [List.getElem?_append_left (by simp; omega)]
