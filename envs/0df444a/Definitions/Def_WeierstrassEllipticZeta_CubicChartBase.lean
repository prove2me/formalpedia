-- title:
--   Explicit cubic bases in both Weierstrass charts
-- statement:
--   For each of the two affine chart labels, define the base ideal in the four-variable complex polynomial ring by
--
--   $$I_c=(F_c)+(Q_c).$$
--
--   Here $Q_c$ is the previously defined normalization of the auxiliary polynomial. The cubic generators, in chart coordinates $(t,x,y,u)$ and $(t,a,b,h)$ respectively, are
--
--   $$F_0=y^2-4x^3+g_2x+g_3,\qquad F_1=a-4b^3+g_2a^2b+g_3a^3.$$
--
--   `extensionCubicChartBaseIdeal` depends only on the period pair, auxiliary polynomial and chart label. The entire coordinate functions are no longer needed to define either base ideal.
--
--   `CubicChartBaseBudget` retains those functions to describe an available chart point in the specified finite set. It retains the previous bound on every prime through that point which is minimal over the differential prolongations at both stages $iT$ and $(i+1)T$, for $i\in\{0,1,2\}$. The quotient of the localization at that prime by the earlier mapped ideal must have length at most the given natural integer $e$.
--
--   Equality with the analytic-orbit bases is a theorem obligation. This definition contains no degree estimate, existence assertion or global geometric gluing.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 5, pp. 380-382: ambient defining ideals in the global zero-estimate argument. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. Building on the Proved first-chart relation ideal, the new argument identifies the second chart kernel by rational coordinate transition, denominator clearing and exact saturation of its cubic ideal. Both bases are now generated by the explicit cubic and normalized auxiliary polynomial. The budget conditions and all localized lengths are preserved. Full geometric gluing, locus and coset/component selection, and the uniform total-degree estimate remain outside this result.

import Definitions.Def_WeierstrassEllipticZeta_FirstCubicChartBase

noncomputable section
namespace WeierstrassEllipticZeta
open TranscendenceTheory

/-- The explicit two-generator base in either affine chart. -/
def extensionCubicChartBaseIdeal (L : PeriodPair)
    (Q : MvPolynomial (Fin 7) ℂ) (c : Fin 2) : Ideal (MvPolynomial (Fin 4) ℂ) :=
  Ideal.span {extensionChartCubic L.g₂ L.g₃ c} ⊔ Ideal.span {extensionChartNormalize c Q}

structure CubicChartBaseBudget (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T e : ℕ) (Z : Finset ℂ) where
  chart : Fin 2
  z : ℂ
  z_mem : z ∈ Z
  chart_ne : S (extensionChartDenominator chart) z ≠ 0
  length_le : ∀ (i : Fin 3) (p : Ideal (MvPolynomial (Fin 4) ℂ)) [p.IsPrime],
    p ≤ RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S chart z)) →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionCubicChartBaseIdeal L Q chart) (i.val * T)).minimalPrimes →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionCubicChartBaseIdeal L Q chart) ((i.val + 1) * T)).minimalPrimes →
    Module.length (Localization.AtPrime p)
      ((Localization.AtPrime p) ⧸ (differentialProlongation
        (extensionChartDerivation L.g₂ L.g₃ chart)
        (extensionCubicChartBaseIdeal L Q chart) (i.val * T)).map
        (algebraMap (MvPolynomial (Fin 4) ℂ) (Localization.AtPrime p))) ≤ (e : ℕ∞)

end WeierstrassEllipticZeta


