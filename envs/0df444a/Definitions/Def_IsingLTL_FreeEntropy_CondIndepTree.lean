-- title:
--   Conditionally independent trees with average offspring numbers bounded by $\Delta$ (Definition 2.5)
-- statement:
--   A random rooted tree is given by the law $\mu$ of its offspring function $\omega$ in Ulam–Harris form. A word $w=[i_1,\dots,i_n]$ is a vertex if $i_{m+1}<\omega([i_1,\dots,i_m])$ for every $m<n$; its offspring number is $\Delta_w=\omega(w)$ if $w$ is a vertex and $\Delta_w=0$ otherwise. For $k\ge0$ let $\mathcal F_k=\sigma(\Delta_w:|w|<k)$, the $\sigma$-algebra of the first $k$ generations $T(k)$. The tree is **conditionally independent with average offspring numbers bounded by $\Delta$** if for every $k\ge0$:
--
--   1. conditional on $\mathcal F_k$, the offspring numbers $\Delta_w$, $|w|=k$, are independent;
--   2. each $\Delta_w$ is integrable and $\mathbb E[\Delta_w\mid\mathcal F_k]\le\Delta$ almost surely, for $|w|=k$.
--
--   Galton–Watson trees $T(\rho,\infty)$ with $\bar\rho\le\Delta$ and deterministic trees with offspring numbers at most $\Delta$ are examples. Lemma 4.3 and Corollary 4.5 are stated for such trees.
--
--   **Formalization Note** The offspring numbers are masked off the tree, so the condition depends only on the law of the tree, not on the values of $\omega$ at words that are not vertices. The conditions are imposed on all words of length $k$, not only on the vertices of $\partial T(k)$; this is equivalent, since membership in $\partial T(k)$ is $\mathcal F_k$-measurable and the offspring numbers of non-vertices are $0$. Integrability is required so that the conditional expectation is not a junk value.
-- source:
--   Dembo & Montanari, Ising Models on Locally Tree-Like Graphs, arXiv:0804.4726v3, p. 6, Definition 2.5

import Mathlib
import Definitions.Def_IsingLTL_FreeEntropy_UlamHarrisTree

namespace IsingLTL.FreeEntropy

open MeasureTheory ProbabilityTheory

/-- The σ-algebra `σ(ω w : |w| < k)` on offspring functions `ω : List ℕ → ℕ` generated by
the offspring numbers of all words of length `< k`, whether or not they are vertices of the tree.
It is finer than `σ(T(k))` (see `treeSigma`); kept as an auxiliary object. -/
@[reducible] noncomputable def genSigma (k : ℕ) : MeasurableSpace (List ℕ → ℕ) :=
  MeasurableSpace.comap (fun (ω : List ℕ → ℕ) (w : {w : List ℕ // w.length < k}) => ω w.1)
    inferInstance

theorem genSigma_le (k : ℕ) :
    genSigma k ≤ (inferInstance : MeasurableSpace (List ℕ → ℕ)) :=
  Measurable.comap_le (measurable_pi_lambda _ (fun w => measurable_pi_apply w.1))

/-- The word `w = [i₁, …, i_n]` is a vertex of the tree with offspring function `ω` in
Ulam–Harris form: `i_{m+1} < ω [i₁, …, i_m]` for every `m < n` (arXiv:0804.4726v3, §2.1). This
is membership of `w` in `gen ω w.length`. -/
def IsVertex (ω : List ℕ → ℕ) (w : List ℕ) : Prop :=
  ∀ (m : ℕ) (h : m < w.length), w[m] < ω (w.take m)

/-- The offspring number `Δ_w` of the word `w` in the tree `ω`: `ω w` if `w` is a vertex,
`0` otherwise. It depends only on the tree, not on the coordinates of non-vertex words. -/
noncomputable def offspring (ω : List ℕ → ℕ) (w : List ℕ) : ℕ := by
  classical
  exact if IsVertex ω w then ω w else 0

theorem measurableSet_isVertex (w : List ℕ) :
    MeasurableSet {ω : List ℕ → ℕ | IsVertex ω w} := by
  have : {ω : List ℕ → ℕ | IsVertex ω w} =
      ⋂ (m : Fin w.length), (fun ω : List ℕ → ℕ => ω (w.take m)) ⁻¹' {n | w[m] < n} := by
    ext ω; simp [IsVertex, Fin.forall_iff]
  rw [this]
  exact MeasurableSet.iInter fun m =>
    (measurable_pi_apply _) (MeasurableSet.of_discrete)

theorem measurable_offspring (w : List ℕ) :
    Measurable (fun ω : List ℕ → ℕ => offspring ω w) := by
  classical
  unfold offspring
  exact Measurable.ite (measurableSet_isVertex w) (measurable_pi_apply w) measurable_const

/-- The σ-algebra `𝓕_k = σ(T(k))` of the first `k` generations of the tree (arXiv:0804.4726v3,
Definition 2.5, p. 6): generated by the offspring numbers `Δ_w = offspring ω w` of the words of
length `< k`, which are `0` off the tree. These numbers determine `T(k)` and are determined by it
(for a vertex `w` with `|w| < k`, `Δ_w` is its number of children in `T(k)`). -/
@[reducible] noncomputable def treeSigma (k : ℕ) : MeasurableSpace (List ℕ → ℕ) :=
  MeasurableSpace.comap
    (fun (ω : List ℕ → ℕ) (w : {w : List ℕ // w.length < k}) => offspring ω w.1) inferInstance

theorem treeSigma_le (k : ℕ) :
    treeSigma k ≤ (inferInstance : MeasurableSpace (List ℕ → ℕ)) :=
  Measurable.comap_le (measurable_pi_lambda _ (fun w => measurable_offspring w.1))

/-- A random rooted tree, given as the law `μ` of its offspring function `ω : List ℕ → ℕ`
(Ulam–Harris form, product σ-algebra), is **conditionally independent with average offspring
numbers bounded by `Δ`** (Dembo–Montanari, arXiv:0804.4726v3, Definition 2.5, p. 6) if for every
generation `k ≥ 0`:
1. conditional on `T(k)` (the σ-algebra `treeSigma k`), the offspring numbers `Δ_w` of the words
   `|w| = k` are independent;
2. the conditional first moments satisfy `E[Δ_w | T(k)] ≤ Δ` almost surely for `|w| = k`
   (each `Δ_w` being integrable).

Formalization Note: `Δ_w = offspring ω w` is `ω w` on vertices and `0` off the tree, so the
definition depends on the law of the tree only, never on the coordinates of words that are not
vertices. The family is indexed by all words of length `k`, not only by the vertices of `∂T(k)`:
this is equivalent, since membership in `∂T(k)` is `T(k)`-measurable and the off-tree members are
`0`. Integrability of `Δ_w` is part of the definition so that the conditional expectation is not
the junk value `0`. Trees may be finite (offspring number `0`): "infinite tree" in the paper means
the whole tree, all generations. -/
structure IsCondIndepTree (μ : Measure (List ℕ → ℕ)) [IsProbabilityMeasure μ] (Δ : ℝ) :
    Prop where
  condIndep : ∀ k : ℕ, iCondIndepFun (treeSigma k) (treeSigma_le k)
    (fun (w : {w : List ℕ // w.length = k}) (ω : List ℕ → ℕ) => offspring ω w.1) μ
  integrable : ∀ w : List ℕ, Integrable (fun ω : List ℕ → ℕ => (offspring ω w : ℝ)) μ
  condMean_le : ∀ w : List ℕ,
    μ[fun ω : List ℕ → ℕ => (offspring ω w : ℝ) | treeSigma w.length] ≤ᵐ[μ] fun _ => Δ

end IsingLTL.FreeEntropy


