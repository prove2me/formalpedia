theorem PowerSeries.exists_norm_coeff_le_mul_pow_of_isAlgebraic_complex
    (φ : PowerSeries ℂ) (hφ : IsAlgebraic (Polynomial ℂ) φ) :
    ∃ C R : ℝ, ∀ n : ℕ, ‖PowerSeries.coeff n φ‖ ≤ C * R ^ n := by sorry
