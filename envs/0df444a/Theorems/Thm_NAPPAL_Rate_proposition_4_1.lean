-- title:
--   Proposition 4.1, p. 18 — the best stationarity residual of NAPP-AL is o(1/√k)
-- statement:
--   Let Assumptions 1 and 2 hold, set $\delta_k$ as in (8), and let $\{w^k\}=\{(u^k,v^k,p^k)\}$ be generated by NAPP-AL, the nonconvex auxiliary problem principle with augmented Lagrangian, applied to problem (P). Then the best stationarity residual over the first $k$ iterates decays faster than $1/\sqrt k$:
--   $$\min_{1\le j\le k}\operatorname{dist}\big(0,\partial\mathcal L_\gamma(w^j)\big)=o\big(1/\sqrt k\big),\qquad\text{i.e.}\qquad \lim_{k\to\infty}\sqrt k\,\min_{1\le j\le k}\operatorname{dist}\big(0,\partial\mathcal L_\gamma(w^j)\big)=0 .$$
--   Here $\partial\mathcal L_\gamma(w)$ is the stationarity set of the KKT display on p. 6 (gradient of the smooth part, limiting subdifferential of $J$, normal cone of $U$, multiplier terms), and $\operatorname{dist}(0,\emptyset)=+\infty$.
--
--   In particular an $\varepsilon$-stationary point is reached within $O(1/\varepsilon^2)$ iterations, the iteration complexity of Remark 4.1.
--
--   **Formalization Note** The statement is posed in $[0,+\infty]$: the function $k\mapsto\sqrt k\cdot\inf_{1\le j\le k}\operatorname{dist}(0,\partial\mathcal L_\gamma(w^j))$ tends to $0$. At $k=0$ the infimum over the empty index set is $+\infty$ and $\sqrt0\cdot(+\infty)=0$, which does not affect the limit. Because $\operatorname{dist}$ is $+\infty$ on an empty residual set, an empty $\partial\mathcal L_\gamma(w^j)$ does not make the statement easier.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 18, Proposition 4.1

import Mathlib
import Definitions.Def_NAPPAL_Rate_Setting
open Filter Topology
open scoped InnerProductSpace

namespace NAPPAL.Rate

theorem proposition_4_1 {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 LK β γ σ : ℝ) (LOmj : Fin m → ℝ)
    (K : NAPPAL.KL.E n → ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : RunHyp P LG LH L0 LOmj K β LK γ σ δ ε u v p) :
    Tendsto
      (fun k : ℕ => ENNReal.ofReal (Real.sqrt k) *
        ⨅ j ∈ Finset.Icc 1 k, NAPPAL.KL.distZero (NAPPAL.KL.dAugLag P γ (u j, v j, p j)))
      atTop (𝓝 0) := by sorry

end NAPPAL.Rate
