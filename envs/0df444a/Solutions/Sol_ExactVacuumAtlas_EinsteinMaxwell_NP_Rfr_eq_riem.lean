theorem cpdC_const (c : ℂ) (i : Fin n) (x : Pt n) : cpdC i (fun _ => c) x = 0 := by
  simp [cpdC]

/-- `cpdC` is local. -/
theorem cpdC_congr_of_eqOn {f h : Pt n → ℂ} {V : Set (Pt n)} (hV : IsOpen V) {x : Pt n}
