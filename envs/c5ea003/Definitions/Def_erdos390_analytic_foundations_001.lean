def primePowerModuli (P : Finset ℕ) (M : ℕ) : Finset ℕ :=
  (P ×ˢ positiveExponents M).image (fun pk ↦ pk.1 ^ pk.2)





/-- The actual valuation score appearing in a compact tilt. -/
