-- title:
--   Algorithms 1–4, (85), (107)–(110) — schedules, seed listing, sumset, extension, certification, representatives, sign recovery, Clifford shadows, measurement programs
-- statement:
--   The numerical schedules are $k_1=\lceil\ln(100/\tau^2)/\ln(4/3)\rceil$, $k_2=\lceil2\log_2(1/\tau)/\eta\rceil$, $k=k_1+k_2$, $m_0=\lceil\ln100/\tau^2\rceil$, $m_1=\lceil2(k_1+\ln100)/\tau^2\rceil$, $m_2=\lceil(k_2\ln2+\ln100)/(\kappa\tau^2)\rceil$, $m_3=\lceil((n+1)\ln2+\ln(8/\delta))/(\kappa\tau^2)\rceil$, $v_4=\lceil800\ln(16\max\{1,|\mathcal L|\}\max\{1,|U|\}/\delta)\rceil$, $m_4=\lceil8(v_4+\ln(8/\delta))/\tau^2\rceil$, $m_5=\lceil(128/\tau^2)\ln(16\max\{1,|\mathcal L_{\rm full}|\}/\delta)\rceil$, $t=\lceil\log_2(8/\tau^4)\rceil$, $m_6=\lceil\tau^{-1}\ln(8/\delta)\rceil$, $a=\lceil\ln(8/\delta)/\ln4\rceil$, $B_{\max}=a\,m_0(1+m_1+m_2)^k$ and $M_{\max}=B_{\max}m_6\,2^t$.
--
--   1. Algorithm 1 (seed listing): for each anchor $a\in B_0$ and each subset $R\subseteq B_1\cup B_2$ with $|R|\le k$ (the empty subset included), form $L=\operatorname{span}\{m+a:m\in R\}$ and keep it exactly when it is isotropic.
--   2. The Bell sumsets $\{m_i+m_j:i<j\}$ (Lemma 7.1) and $B_3+B_3$ (Algorithm 5, which also contains $0$).
--   3. Algorithm 2 (extension): for each seed $L$ with $N_L=|B_4\cap A_L|\ge v_4$, keep the labels $u\in U\cap L^\perp$ with empirical score $\tilde\gamma_L(u)=N_L^{-1}\sum_{m\in B_4\cap A_L}(-1)^{Q(u)+\langle m,u\rangle}\ge3/5$, and add $T_L=\operatorname{span}(L\cup V_L)$ when it is isotropic of dimension $n$.
--   4. Algorithm 3 (certification): keep $T'$ exactly when $|B_5\cap A_{T'}|/m_5\ge3\tau^2/4$.
--   5. Representatives: scan the certified list and add $T'$ when $\dim(T'\cap T_i)<n-t$ (integer subtraction) for all current representatives; each candidate is assigned to the first representative with $\dim(T'\cap T_i)\ge n-t$.
--   6. Algorithm 4 (signs): each representative is measured in its stabilizer basis on $m_6$ fresh copies; every outcome sector $\Pi$ and every candidate $T'$ assigned to it contribute the signed stabilizer states with label space $T'$ whose eigenvalue on each check $W_t$, $t\in T'\cap T_i$, agrees with its eigenvalue on $\Pi$.
--   7. Global-Clifford shadows: a record $(U,b)$ has $U$ uniform on the Clifford group generated by $H$, $S$ and CNOT (with its phases) and $b$ a computational-basis outcome of $U\rho U^\dagger$; $X_P=(2^n+1)\langle b|UPU^\dagger|b\rangle-1$, and the estimate $\tilde f(P)$ is the median of $G=2\lceil4\ln(8M/\delta)\rceil+1$ group means of $K=\lceil48/\varepsilon^2\rceil$ records. A candidate maximizing $\tilde f$ is selected, ties going to the earliest.
--
--   A measurement program is an adaptive learner whose quantum steps are batches of two-copy Bell measurements, single-copy measurements of commuting checks, or single-copy shadow measurements; each later step depends only on earlier classical records. Its Born semantics gives the expectation and probability of output events, and its worst case quantifies over every transcript, counting two copies per Bell record and one per single-copy record.
--
--   **Formalization Note** The source's sufficiently large absolute constant in the shadow sample size is fixed explicitly as $K=\lceil48/\varepsilon^2\rceil$ and $G=2\lceil4\ln(8M/\delta)\rceil+1$; enumeration orders of subsets and sign vectors are fixed but arbitrary.
-- source:
--   Ching-Yi Lai, STOC 2027 submission #1629 (October 2026), p. 8, 22–38 (PDF p. 9, 23–39), Algorithms 1–4, equations (85), (96), (107)–(110), Lemma 8.2, §2.7, §8.4

import Mathlib
import Definitions.Def_BatchStabilizer_Learning_Target

set_option autoImplicit false
open scoped ComplexOrder BigOperators Matrix Kronecker
noncomputable section

namespace BatchStabilizer.Learning

open LindbladTolerant.Testing

/-! Algorithms 1–4, the Bell sumset, the greedy representatives, global-Clifford shadows,
and a measurement-program semantics in which every quantum measurement acts on one or two
fresh copies of the unknown state (Ching-Yi Lai, STOC 2027 submission #1629 (October 2026),
Algorithms 1–4 and §§6–8, printed pp. 22–37 (PDF pp. 23–38), §2.7, printed p. 8). -/

abbrev Sub (n : ℕ) := Submodule (ZMod 2) (Label n)

/-! ### Numerical schedules (Algorithms 1–5, Lemma 7.1, Lemma 8.2, (107)–(110)) -/

/-- `k₁ = ⌈ln(100/τ²)/ln(4/3)⌉`. -/
def k1 (τ : ℝ) : ℕ := ⌈Real.log (100 / τ ^ 2) / Real.log (4 / 3)⌉₊
/-- `k₂ = ⌈2 log₂(1/τ)/η⌉`. -/
def k2 (τ : ℝ) : ℕ := ⌈2 * Real.logb 2 (1 / τ) / eta⌉₊
/-- `k = k₁ + k₂`. -/
def kk (τ : ℝ) : ℕ := k1 τ + k2 τ
/-- `m₀ = ⌈ln 100/τ²⌉`. -/
def m0 (τ : ℝ) : ℕ := ⌈Real.log 100 / τ ^ 2⌉₊
/-- `m₁ = ⌈2(k₁ + ln 100)/τ²⌉`. -/
def m1 (τ : ℝ) : ℕ := ⌈2 * ((k1 τ : ℝ) + Real.log 100) / τ ^ 2⌉₊
/-- `m₂ = ⌈(k₂ ln 2 + ln 100)/(κτ²)⌉`. -/
def m2 (τ : ℝ) : ℕ := ⌈((k2 τ : ℝ) * Real.log 2 + Real.log 100) / (kappa * τ ^ 2)⌉₊
/-- `m₃ = ⌈((n+1) ln 2 + ln(8/δ))/(κτ²)⌉` (equation (85)). -/
def m3 (n : ℕ) (τ δ : ℝ) : ℕ :=
  ⌈(((n : ℝ) + 1) * Real.log 2 + Real.log (8 / δ)) / (kappa * τ ^ 2)⌉₊
/-- `v₄ = ⌈800 ln(16 max{1,|ℒ|} max{1,|U|}/δ)⌉` (Algorithm 2, line 1). -/
def v4 (δ : ℝ) (seeds sums : ℕ) : ℕ :=
  ⌈800 * Real.log (16 * (max 1 seeds : ℕ) * (max 1 sums : ℕ) / δ)⌉₊
/-- `m₄ = ⌈8(v₄ + ln(8/δ))/τ²⌉` (Algorithm 2, line 2). -/
def m4 (τ δ : ℝ) (seeds sums : ℕ) : ℕ :=
  ⌈8 * ((v4 δ seeds sums : ℝ) + Real.log (8 / δ)) / τ ^ 2⌉₊
/-- `m₅ = ⌈(128/τ²) ln(16 max{1,|ℒ_full|}/δ)⌉` (Algorithm 3, line 1). -/
def m5 (τ δ : ℝ) (full : ℕ) : ℕ := ⌈128 / τ ^ 2 * Real.log (16 * (max 1 full : ℕ) / δ)⌉₊
/-- `t = ⌈log₂(8/τ⁴)⌉` (Lemma 8.2, (108)). -/
def tt (τ : ℝ) : ℕ := ⌈Real.logb 2 (8 / τ ^ 4)⌉₊
/-- `m₆ = ⌈τ⁻¹ ln(8/δ)⌉` (Algorithm 4, line 1). -/
def m6 (τ δ : ℝ) : ℕ := ⌈τ⁻¹ * Real.log (8 / δ)⌉₊
/-- `a = ⌈ln(8/δ)/ln 4⌉` (equation (107)). -/
def aa (δ : ℝ) : ℕ := ⌈Real.log (8 / δ) / Real.log 4⌉₊
/-- `B_max = a m₀ (1 + m₁ + m₂)^k` (equation (109)). -/
def Bmax (τ δ : ℝ) : ℕ := aa δ * m0 τ * (1 + m1 τ + m2 τ) ^ kk τ
/-- `M_max = B_max m₆ 2^t` (equation (110)). -/
def Mmax (τ δ : ℝ) : ℕ := Bmax τ δ * m6 τ δ * 2 ^ tt τ
/-- Shadow group size `⌈48/ε²⌉` (explicit choice of the source's absolute constant in (111)). -/
def shadowGroupSize (ε : ℝ) : ℕ := ⌈48 / ε ^ 2⌉₊
/-- Odd number `2⌈4 ln(8M/δ)⌉ + 1` of shadow groups for a candidate-list bound `M`. -/
def shadowGroups (δ : ℝ) (M : ℕ) : ℕ := 2 * ⌈4 * Real.log (8 * (M : ℝ) / δ)⌉₊ + 1

/-! ### Algorithm 1 (seed listing), printed p. 22 -/

/-- The merged batch `B₁ ∪ B₂`, indexed by `Fin m₁ ⊕ Fin m₂` (repeated outcomes remain
distinct records). -/
def mergeBatches {n p q : ℕ} (B1 : Fin p → Label n) (B2 : Fin q → Label n) :
    Fin p ⊕ Fin q → Label n := Sum.elim B1 B2

open Classical in
/-- The subsets `R ⊆ B₁ ∪ B₂` with `|R| ≤ k` (including the empty subset), in a fixed order. -/
def smallSubsets (p q k : ℕ) : List (Finset (Fin p ⊕ Fin q)) :=
  ((Finset.univ : Finset (Finset (Fin p ⊕ Fin q))).filter (fun R => R.card ≤ k)).toList

open Classical in
/-- Algorithm 1: for each anchor `a ∈ B₀` and each subset `R ⊆ B₁ ∪ B₂` with `|R| ≤ k`, form
`L = span{m + a : m ∈ R}` and retain it exactly when it is isotropic. -/
def seedList {n : ℕ} (τ : ℝ) (B0 : Fin (m0 τ) → Label n) (B1 : Fin (m1 τ) → Label n)
    (B2 : Fin (m2 τ) → Label n) : List (Sub n) :=
  (List.finRange (m0 τ)).flatMap fun i =>
    (smallSubsets (m1 τ) (m2 τ) (kk τ)).filterMap fun R =>
      if IsIsotropic (Submodule.span (ZMod 2) ((fun j => mergeBatches B1 B2 j + B0 i) '' ↑R))
      then some (Submodule.span (ZMod 2) ((fun j => mergeBatches B1 B2 j + B0 i) '' ↑R))
      else none

/-! ### The shared Bell sumset (§7.1, Lemma 7.1 and Algorithm 5 line 4) -/

open Classical in
/-- The Bell sumset of Lemma 7.1, `U = {m_i + m_j : 1 ≤ i < j ≤ m₃}`. -/
def sumsetPairs {n m : ℕ} (B : Fin m → Label n) : Finset (Label n) :=
  ((Finset.univ : Finset (Fin m × Fin m)).filter (fun p => p.1 < p.2)).image
    (fun p => B p.1 + B p.2)

open Classical in
/-- The Bell sumset `U = B₃ + B₃` of Algorithm 5 (line 4), which also contains `0`. -/
def sumsetAll {n m : ℕ} (B : Fin m → Label n) : Finset (Label n) :=
  (Finset.univ : Finset (Fin m × Fin m)).image (fun p => B p.1 + B p.2)

/-! ### Algorithm 2 (batchwise extension), printed p. 31 -/

open Classical in
/-- The indices of the records of a batch accepted by the filter `A_L`. -/
def accepted {n m : ℕ} (L : Sub n) (B : Fin m → Label n) : List (Fin m) :=
  (List.finRange m).filter (fun i => decide (B i ∈ affineFilter L))

/-- The empirical conditional score `γ̃_L(u) = N_L⁻¹ Σ_{m ∈ B₄ ∩ A_L} (-1)^{Q(u)+⟨m,u⟩}`
(equation (96)), with multiplicities. -/
def empScore {n m : ℕ} (L : Sub n) (u : Label n) (B : Fin m → Label n) : ℝ :=
  ((accepted L B).map fun i => signZ (Q u + symp (B i) u)).sum / ((accepted L B).length : ℝ)

open Classical in
/-- `T_L = span(L ∪ V_L)` with `V_L = {u ∈ U ∩ L^⊥ : γ̃_L(u) ≥ 3/5}`. -/
def extendedSpace {n m : ℕ} (L : Sub n) (U : Finset (Label n)) (B4 : Fin m → Label n) : Sub n :=
  L ⊔ Submodule.span (ZMod 2)
    (↑(U.filter fun u => u ∈ perp L ∧ (3 / 5 : ℝ) ≤ empScore L u B4) : Set (Label n))

open Classical in
/-- Algorithm 2: for each seed `L` with `N_L ≥ v₄`, retain the labels `u ∈ U ∩ L^⊥` with
`γ̃_L(u) ≥ 3/5`, and keep `T_L = span(L ∪ V_L)` when it is isotropic of dimension `n`. -/
def extend {n : ℕ} (τ δ : ℝ) (seeds : List (Sub n)) (U : Finset (Label n))
    (B4 : Fin (m4 τ δ seeds.length U.card) → Label n) : List (Sub n) :=
  seeds.filterMap fun L =>
    if v4 δ seeds.length U.card ≤ (accepted L B4).length ∧
        Module.finrank (ZMod 2) ↥(extendedSpace L U B4) = n ∧
        IsIsotropic (extendedSpace L U B4)
    then some (extendedSpace L U B4) else none

/-! ### Algorithm 3 (certification), printed p. 33 -/

open Classical in
/-- Algorithm 3: keep `T'` exactly when its empirical acceptance `|B₅ ∩ A_{T'}|/m₅` is at
least `3τ²/4`. -/
def certify {n : ℕ} (τ δ : ℝ) (full : List (Sub n)) (B5 : Fin (m5 τ δ full.length) → Label n) :
    List (Sub n) :=
  full.filter fun T' =>
    decide (3 * τ ^ 2 / 4 ≤ ((accepted T' B5).length : ℝ) / (m5 τ δ full.length : ℝ))

/-! ### Representatives (Lemma 8.2) and sign recovery (Algorithm 4) -/

open Classical in
/-- Greedy maximal representative family: scan the certified list in order and add `T'`
when every current representative `T_i` has `dim(T' ∩ T_i) < n - t` (integer subtraction). -/
def greedyReps (n t : ℕ) (cert : List (Sub n)) : List (Sub n) :=
  cert.foldl (fun R T' =>
    if ∀ Ti ∈ R, (Module.finrank (ZMod 2) ↥(T' ⊓ Ti) : ℤ) < (n : ℤ) - t then R ++ [T'] else R) []

/-- A fixed (deterministic) basis of a label subspace. -/
def stdBasis {n : ℕ} (T : Sub n) : Fin (Module.finrank (ZMod 2) T) → Label n :=
  fun j => (Module.finBasis (ZMod 2) T j : Label n)

/-- The signed stabilizer projector with label space `T` and generator signs `c` relative to
the fixed basis of `T`: `∏_j (I + (-1)^{c_j} W_{b_j})/2`. -/
def signedState {n : ℕ} (T : Sub n) (c : Fin (Module.finrank (ZMod 2) T) → ZMod 2) :
    Op (Qubits n) :=
  syndromeProj (stdBasis T) 0 c

open Classical in
/-- The signed states with label space `T'` whose eigenvalue on every check `W_t`,
`t ∈ J = T' ∩ T_i`, agrees with its eigenvalue on the observed `T_i`-basis outcome sector `Π` (`Pi`). -/
def signCandidates {n : ℕ} (T' Ti : Sub n) (Pi : Op (Qubits n)) : List (Op (Qubits n)) :=
  (((Finset.univ : Finset (Fin (Module.finrank (ZMod 2) T') → ZMod 2)).filter fun c =>
      ∀ t ∈ T' ⊓ Ti, (W t * signedState T' c = signedState T' c ↔ W t * Pi = Pi)).toList).map
    (signedState T')

open Classical in
/-- Algorithm 4 post-processing: each certified `T'` is assigned to the first representative
`T_i` (in order) with `dim(T' ∩ T_i) ≥ n - t`, and every observed `T_i`-basis outcome sector
contributes the consistent signed states with label space `T'`. -/
def signCandidateList {n : ℕ} (t : ℕ) (cert : List (Sub n))
    (measured : List (Sub n × List (Op (Qubits n)))) : List (Op (Qubits n)) :=
  cert.flatMap fun T' =>
    match measured.find? (fun (p : Sub n × List (Op (Qubits n))) =>
        decide ((n : ℤ) - t ≤ (Module.finrank (ZMod 2) ↥(T' ⊓ p.1) : ℤ))) with
    | none => []
    | some p => p.2.flatMap fun Pi => signCandidates T' p.1 Pi

/-! ### Global-Clifford shadows (§2.7, §8.4) -/

/-- The Hadamard gate on qubit `j`. -/
def hadamard {n : ℕ} (j : Fin n) : Op (Qubits n) := fun x y =>
  if ∀ i, i ≠ j → x i = y i then
    ((if x j && y j then (-1 : ℂ) else 1) / (Real.sqrt 2 : ℂ)) else 0

/-- The phase gate `S = diag(1, i)` on qubit `j`. -/
def phaseGate {n : ℕ} (j : Fin n) : Op (Qubits n) := fun x y =>
  if x = y then (if x j then Complex.I else 1) else 0

/-- The CNOT gate with control `j` and target `k`. -/
def cnot {n : ℕ} (j k : Fin n) : Op (Qubits n) := fun x y =>
  if x = Function.update y k (xor (y k) (y j)) then 1 else 0

/-- The gate set `{H_j, S_j, CNOT_{jk} (j ≠ k)}`. -/
def gateSet (n : ℕ) : Set (Op (Qubits n)) :=
  {g | (∃ j, g = hadamard j) ∨ (∃ j, g = phaseGate j) ∨ (∃ j k, j ≠ k ∧ g = cnot j k)}

/-- The (finite) n-qubit Clifford group generated by `H`, `S` and `CNOT`, including its
global phases. -/
def cliffordGroup (n : ℕ) : Set (Op (Qubits n)) := ↑(Submonoid.closure (gateSet n))

/-- The Born probability of a global-Clifford shadow record `(U, b)`: `U` uniform on the
Clifford group and `b` a computational-basis outcome of `UρU†`. -/
def shadowRecordProb {n : ℕ} (ρ : Op (Qubits n)) (r : Op (Qubits n) × Qubits n) : ℝ :=
  ((cliffordGroup n).ncard : ℝ)⁻¹ *
    (ArbLindbladLearn.quadForm (ArbLindbladLearn.basisVec r.2) (r.1 * ρ * r.1ᴴ)).re

/-- The single-record fidelity estimator `X_P = (2ⁿ + 1)⟨b|UPU†|b⟩ - 1` (equation (23)). -/
def shadowValue {n : ℕ} (P : Op (Qubits n)) (r : Op (Qubits n) × Qubits n) : ℝ :=
  ((2 : ℝ) ^ n + 1) *
    (ArbLindbladLearn.quadForm (ArbLindbladLearn.basisVec r.2) (r.1 * P * r.1ᴴ)).re - 1

/-- The median `l_{(⌊|l|/2⌋)}` of a list (the middle element for odd length). -/
def median (l : List ℝ) : ℝ := (l.mergeSort (fun a b => decide (a ≤ b))).getD (l.length / 2) 0

/-- Median of `G` group means of `K` records each: the shadow estimate `f̃(P)`. -/
def shadowEstimate {n : ℕ} (K G : ℕ) (R : Fin (G * K) → Op (Qubits n) × Qubits n)
    (P : Op (Qubits n)) : ℝ :=
  median (List.ofFn fun g : Fin G =>
    (∑ j : Fin K, shadowValue P (R (finProdFinEquiv (g, j)))) / (K : ℝ))

/-- Select the first candidate maximizing an estimate (ties: earliest in the list); `|0ⁿ⟩` on
an empty list. -/
def selectBest {n : ℕ} (cands : List (Op (Qubits n))) (est : Op (Qubits n) → ℝ) :
    Op (Qubits n) :=
  match cands with
  | [] => ArbLindbladLearn.zeroProj n
  | c :: cs => cs.foldl (fun best x => if est best < est x then x else best) c

/-! ### Measurement programs: Born semantics and copy accounting -/

/-- An adaptive learner acting on independent copies of an unknown `n`-qubit state.  Every
quantum step is one of: a batch of `m` two-copy Bell measurements; `m` single-copy measurements
of the commuting checks `W_{b_1},…,W_{b_r}`; or `N` single-copy global-Clifford shadow
measurements.  Each next step is a function of the classical records only. -/
inductive Prog (n : ℕ) (α : Type) : Type where
  | ret : α → Prog n α
  | bell (m : ℕ) : ((Fin m → Label n) → Prog n α) → Prog n α
  | stabBasis (r : ℕ) (b : Fin r → Label n) (m : ℕ) :
      ((Fin m → Fin r → ZMod 2) → Prog n α) → Prog n α
  | shadow (N : ℕ) : ((Fin N → Op (Qubits n) × Qubits n) → Prog n α) → Prog n α

namespace Prog

variable {n : ℕ} {α β : Type}

/-- Sequential composition. -/
def bind : Prog n α → (α → Prog n β) → Prog n β
  | ret a, f => f a
  | bell m k, f => bell m fun B => bind (k B) f
  | stabBasis r b m k, f => stabBasis r b m fun S => bind (k S) f
  | shadow N k, f => shadow N fun R => bind (k R) f

/-- The expectation `E[g(output)]` when the program runs on independent copies of `ρ`, with
Born laws `∏ β_ρ(B_i)`, `∏ tr(ρ Π_{S_i})`, and `∏ |Cl_n|⁻¹ ⟨b_i|U_i ρ U_i†|b_i⟩`. -/
def expect (ρ : Op (Qubits n)) : Prog n α → (α → ℝ) → ℝ
  | ret a, g => g a
  | bell m k, g => ∑ B : Fin m → Label n, bellBatchWeight ρ B * expect ρ (k B) g
  | stabBasis r b m k, g =>
      ∑ S : Fin m → Fin r → ZMod 2, (∏ i, syndromeProb ρ b 0 (S i)) * expect ρ (k S) g
  | shadow N k, g =>
      ∑ᶠ R : Fin N → ↥(cliffordGroup n) × Qubits n,
        (∏ i, shadowRecordProb ρ ((R i).1.1, (R i).2)) *
          expect ρ (k fun i => ((R i).1.1, (R i).2)) g

open Classical in
/-- The probability that the output satisfies `E`. -/
def prob (ρ : Op (Qubits n)) (p : Prog n α) (E : α → Prop) : ℝ :=
  expect ρ p fun a => if E a then 1 else 0

/-- `P copies output` holds on every transcript (every record value and every branch), where
`copies` counts the original copies consumed: two per Bell record, one per single-copy record. -/
def allRuns : Prog n α → (ℕ → α → Prop) → Prop
  | ret a, P => P 0 a
  | bell m k, P => ∀ B, allRuns (k B) fun c a => P (2 * m + c) a
  | stabBasis _ _ m k, P => ∀ S, allRuns (k S) fun c a => P (m + c) a
  | shadow N k, P => ∀ R, allRuns (k R) fun c a => P (N + c) a

end Prog

/-- One run of Algorithm 1: three fresh Bell batches `B₀, B₁, B₂`, then seed listing. -/
def alg1Prog (n : ℕ) (τ : ℝ) : Prog n (List (Sub n)) :=
  .bell (m0 τ) fun B0 => .bell (m1 τ) fun B1 => .bell (m2 τ) fun B2 =>
    .ret (seedList τ B0 B1 B2)

/-- Measure `m` fresh copies in the stabilizer basis of each representative, in order; record
the observed outcome sectors `Π_s` of each representative. -/
def measureReps {n : ℕ} (m : ℕ) : List (Sub n) → Prog n (List (Sub n × List (Op (Qubits n))))
  | [] => .ret []
  | Ti :: rest =>
      .stabBasis (Module.finrank (ZMod 2) Ti) (stdBasis Ti) m fun S =>
        (measureReps m rest).bind fun out =>
          .ret ((Ti, List.ofFn fun i => syndromeProj (stdBasis Ti) 0 (S i)) :: out)

/-- Algorithm 4: representative-basis measurements (`m₆` copies each), then sign enumeration. -/
def alg4Prog (n : ℕ) (τ δ : ℝ) (cert reps : List (Sub n)) : Prog n (List (Op (Qubits n))) :=
  (measureReps (m6 τ δ) reps).bind fun meas => .ret (signCandidateList (tt τ) cert meas)

end BatchStabilizer.Learning


