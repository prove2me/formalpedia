  let P₁ : ℚ⟦X⟧ := ∏ n ∈ Finset.range L₁, apFactorPS ℚ (b * s) b n
  let P₂ : ℚ⟦X⟧ := ∏ n ∈ Finset.range L₂, apFactorPS ℚ (b * t) b n
