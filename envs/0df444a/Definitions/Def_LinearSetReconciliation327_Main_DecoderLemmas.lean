    (m : ℕ → ℕ) (r : Fin 16 → ℕ) :
    ({ runBlock scanCond.code E (scanState b pc B L p m r L) with pc := pc + 17 } : RAMState) =
      { scanState b pc B L p m r L with pc := pc + 17 } := by
