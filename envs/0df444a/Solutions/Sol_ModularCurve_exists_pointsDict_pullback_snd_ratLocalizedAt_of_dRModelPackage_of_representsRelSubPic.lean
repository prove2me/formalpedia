theorem theta_hom
    (hbundle : AbelianSchemePropertyBundle ↥(GaloisRep.ratLocalizedAt ℓ) (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (L' : RelativeGroupLaw ↥(GaloisRep.ratLocalizedAt ℓ) (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (hL' : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)))
      (x y : SchemeHomOver t (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
      (X Y : SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) D.toBase),
      X.1 = x.1 ≫ pullback.fst _ _ → Y.1 = y.1 ≫ pullback.fst _ _ →
      (L'.mul t x y).1 ≫ pullback.fst _ _ =
        ((RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut (DRModel.toBase p) 𝔛.εinf) hD).mul _ X Y).1)
    (eQ : pullback P.c (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≅ pullback (DRModel.toBase p) (specMap ℤ ℚ))
    (heQ' : eQ.inv ≫ pullback.snd _ _ = pullback.snd _ _)
    (hQ : RepresentsRelSubPic (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)
      (algEquivZeroCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) (P.D.baseChange ℚ))
    (hPQ : Nonempty (hQ.poincare.L ≅ (BaseChange.ofR P.c P.ε ℚ
        (P.hD.poincare.pullbackAlong ⟨pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ), pullback.condition⟩)).L))
    (θQ : SchemeHomOver (P.D.baseChange ℚ).toBase (D.baseChange ℚ).toBase)
    (hθQ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ℚ))
        (M : RigidifiedLineBundle (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε) t) (hM : FibrewiseAlgEquivZero M)
        (N : RigidifiedLineBundle (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf) t) (hN : FibrewiseAlgEquivZero N)
        (Q : T.Modules), Scheme.Modules.IsInvertible Q →
        Nonempty (N.L ≅ (Scheme.Modules.pullback (curveChange (c := baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ)
            (c' := baseChange ℤ (DRModel.toBase p) ℚ) eQ.inv heQ' t)).obj M.L ⊗
          (Scheme.Modules.pullback (pullback.snd (baseChange ℤ (DRModel.toBase p) ℚ) t)).obj Q) →
        postComp θQ (hQ.classify t M hM) = h'.classify t N hN)
    (θ : SchemeHomOver P.D.toBase (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (hθK : (genericFibreRestrict ↥(GaloisRep.ratLocalizedAt ℓ) ℚ (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))
          P.D.toBase θ).1 = θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv) :
    ∀ {S : Scheme.{0}} (s : S ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))) (x y : SchemeHomOver s P.D.toBase),
      ((RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut P.c P.ε) P.hD).mul s x y).1 ≫ θ.1 =
        (L'.mul s ⟨x.1 ≫ θ.1, by rw [Category.assoc, θ.2, x.2]⟩ ⟨y.1 ≫ θ.1, by rw [Category.assoc, θ.2, y.2]⟩).1 := by
  haveI : IsDiscreteValuationRing ↥(GaloisRep.ratLocalizedAt ℓ) := GaloisRep.isDiscreteValuationRing_ratLocalizedAt ℓ Fact.out
  haveI : IsFractionRing ↥(GaloisRep.ratLocalizedAt ℓ) ℚ := GaloisRep.isFractionRing_ratLocalizedAt ℓ
  haveI := hbundle.proper
  haveI := P.bundle.smooth

  have homQ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ℚ)) (x y : SchemeHomOver t (P.D.baseChange ℚ).toBase),
      postComp θQ ((RepresentsRelSubPic.relativeGroupLaw
        (P := algEquivZeroGroupCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) hQ).mul t x y) =
      (RepresentsRelSubPic.relativeGroupLaw
        (P := algEquivZeroGroupCut (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf)) h').mul t
        (postComp θQ x) (postComp θQ y) :=
    AlgebraicGeometry.RelPicard.RepresentsRelSubPic.postComp_mul_of_classify_rel
    (P := algEquivZeroGroupCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε))
    (P' := algEquivZeroGroupCut (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf))
    hQ h' θQ
    (fun t M N => ∃ Q : _, Scheme.Modules.IsInvertible Q ∧
      Nonempty (N.L ≅ (Scheme.Modules.pullback (curveChange (c := baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ)
          (c' := baseChange ℤ (DRModel.toBase p) ℚ) eQ.inv heQ' t)).obj M.L ⊗
        (Scheme.Modules.pullback (pullback.snd (baseChange ℤ (DRModel.toBase p) ℚ) t)).obj Q))
    (fun t M hM N hN ⟨Q, hQi, hNQ⟩ => hθQ t M hM N hN Q hQi hNQ)
    (fun t M hM => rel_total (sectionBaseChange ℚ 𝔛.εinf) eQ heQ' t M hM)
    (fun t M₁ M₂ N₁ N₂ r₁ r₂ => rel_tensor (sectionBaseChange ℚ 𝔛.εinf) eQ heQ' t M₁ M₂ N₁ N₂ r₁ r₂)

  have hkey : pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))
      = θQ.1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by
    have h1 : (genericFibreRestrict ↥(GaloisRep.ratLocalizedAt ℓ) ℚ (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))
        P.D.toBase θ).1 ≫ pullback.fst _ _ = pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 := by
      simp only [genericFibreRestrict, pullback.lift_fst]
      rfl
    have h2 : pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 =
        θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv ≫
          pullback.fst (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) := by
      rw [← h1, hθK]
      exact Category.assoc _ _ _
    calc pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))
        = (pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1) ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) :=
          (Category.assoc _ _ _).symm
      _ = (θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv ≫
          pullback.fst (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)) ≫
            pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) := by rw [h2]
      _ = θQ.1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by
          simp only [Category.assoc, pasteIso_inv_fst_fst]

  apply GoodReductionJacobian.RelativeGroupLaw.comp_mul_eq_mul_comp_of_genericFibre ↥(GaloisRep.ratLocalizedAt ℓ) ℚ
  intro S s x y

  let xQ : SchemeHomOver s (P.D.baseChange ℚ).toBase := ⟨pullback.lift x.1 s x.2, pullback.lift_snd _ _ _⟩
  let yQ : SchemeHomOver s (P.D.baseChange ℚ).toBase := ⟨pullback.lift y.1 s y.2, pullback.lift_snd _ _ _⟩
  have hxQ : x.1 = xQ.1 ≫ pullback.fst _ _ := (pullback.lift_fst _ _ _).symm
  have hyQ : y.1 = yQ.1 ≫ pullback.fst _ _ := (pullback.lift_fst _ _ _).symm

  have EP := AlgebraicGeometry.RelPicard.baseChange_relativeGroupLaw_mul_compat ↥(GaloisRep.ratLocalizedAt ℓ) P.c P.ε P.D P.hD ℚ hQ hPQ s xQ yQ x y hxQ hyQ

  have ED := AlgebraicGeometry.RelPicard.baseChange_relativeGroupLaw_mul_compat ℤ (DRModel.toBase p) 𝔛.εinf D hD ℚ h' hP s
    (postComp θQ xQ) (postComp θQ yQ)
    ⟨(postComp θQ xQ).1 ≫ pullback.fst D.toBase (specMap ℤ ℚ), by rw [Category.assoc, pullback.condition, ← Category.assoc, (postComp θQ xQ).2]⟩
    ⟨(postComp θQ yQ).1 ≫ pullback.fst D.toBase (specMap ℤ ℚ), by rw [Category.assoc, pullback.condition, ← Category.assoc, (postComp θQ yQ).2]⟩
    rfl rfl

  set Pmul := (RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut P.c P.ε) P.hD).mul with hPmul
  have X2w : (x.1 ≫ θ.1) ≫ pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) =
      s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ := by rw [Category.assoc, θ.2]; exact x.2
  have Y2w : (y.1 ≫ θ.1) ≫ pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) =
      s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ := by rw [Category.assoc, θ.2]; exact y.2
  let X₂ : SchemeHomOver ((s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) D.toBase :=
    ⟨(x.1 ≫ θ.1) ≫ pullback.fst _ _, by rw [Category.assoc, pullback.condition, ← Category.assoc, X2w]⟩
  let Y₂ : SchemeHomOver ((s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) D.toBase :=
    ⟨(y.1 ≫ θ.1) ≫ pullback.fst _ _, by rw [Category.assoc, pullback.condition, ← Category.assoc, Y2w]⟩
  have R1 := hL' (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ⟨x.1 ≫ θ.1, X2w⟩ ⟨y.1 ≫ θ.1, Y2w⟩ X₂ Y₂ rfl rfl
  have e1 : ((RepresentsRelSubPic.relativeGroupLaw
      (P := algEquivZeroGroupCut (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf)) h').mul s
        (postComp θQ xQ) (postComp θQ yQ)).1 = ((RepresentsRelSubPic.relativeGroupLaw
      (P := algEquivZeroGroupCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) hQ).mul s xQ yQ).1 ≫ θQ.1 :=
    congrArg Subtype.val (homQ s xQ yQ).symm
  have hX : ((postComp θQ xQ).1 ≫ pullback.fst D.toBase (specMap ℤ ℚ)) = (x.1 ≫ θ.1) ≫ pullback.fst _ _ := by
    show (xQ.1 ≫ θQ.1) ≫ _ = _
    conv_rhs => rw [hxQ]
    simp only [Category.assoc]
    rw [hkey]
  have hY : ((postComp θQ yQ).1 ≫ pullback.fst D.toBase (specMap ℤ ℚ)) = (y.1 ≫ θ.1) ≫ pullback.fst _ _ := by
    show (yQ.1 ≫ θQ.1) ≫ _ = _
    conv_rhs => rw [hyQ]
    simp only [Category.assoc]
    rw [hkey]
  have GOAL1 : (Pmul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) x y).1 ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) =
      (L'.mul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ⟨x.1 ≫ θ.1, X2w⟩ ⟨y.1 ≫ θ.1, Y2w⟩).1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) := by
    calc (Pmul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) x y).1 ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))
        = (((RepresentsRelSubPic.relativeGroupLaw
            (P := algEquivZeroGroupCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) hQ).mul s xQ yQ).1 ≫
            pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)) ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) := by
          rw [EP]
      _ = ((RepresentsRelSubPic.relativeGroupLaw
            (P := algEquivZeroGroupCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) hQ).mul s xQ yQ).1 ≫
            θQ.1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by rw [Category.assoc, hkey]
      _ = ((RepresentsRelSubPic.relativeGroupLaw
            (P := algEquivZeroGroupCut (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf)) h').mul s
              (postComp θQ xQ) (postComp θQ yQ)).1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by rw [e1, Category.assoc]
      _ = _ := ED
      _ = ((RepresentsRelSubPic.relativeGroupLaw (P := algEquivZeroGroupCut (DRModel.toBase p) 𝔛.εinf) hD).mul
            ((s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) X₂ Y₂).1 :=
          mul_congr_base D _ (by rw [Category.assoc, specMap_comp_specMap]) _ _ _ _ hX hY
      _ = _ := R1.symm
  have GOAL2 : (Pmul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) x y).1 ≫ θ.1 ≫ pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) =
      (L'.mul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ⟨x.1 ≫ θ.1, X2w⟩ ⟨y.1 ≫ θ.1, Y2w⟩).1 ≫
        pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) := by
    rw [θ.2, (Pmul (s ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) x y).2, (L'.mul _ _ _).2]
  apply pullback.hom_ext
  · exact (Category.assoc _ _ _).trans GOAL1
  · exact (Category.assoc _ _ _).trans GOAL2

end Hom

