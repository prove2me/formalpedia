theorem mul_val_congr {S : Type} [CommRing S] (E : FakeEllipticCurve Λ N S) {T : Scheme.{0}}
    {t t' : T ⟶ Spec (CommRingCat.of S)} (e : t = t') (P Q : SchemeHomOver t E.f) (P' Q' : SchemeHomOver t' E.f)
    (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) : (E.L.mul t P Q).1 = (E.L.mul t' P' Q').1 := by
  subst e
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem isPullbackVia_comp_iso
    {S S₀ : Type} [CommRing S] [CommRing S₀] (ρ : S →+* S₀)
    (E E' : FakeEllipticCurve Λ N S) (E₀ : FakeEllipticCurve Λ N S₀)
    (g : E₀.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia ρ E E₀ g)
    (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f) (hiso : FakeEllipticCurve.IsoVia E E' i hi) :
    FakeEllipticCurve.IsPullbackVia ρ E' E₀ (g ≫ i.hom) := by
  obtain ⟨hpb, hmul, hact, hlev⟩ := hg
  obtain ⟨imul, iact, ilev⟩ := hiso
  have hpb' : IsPullback (g ≫ i.hom) E₀.f E'.f (Spec.map (CommRingCat.ofHom ρ)) :=
    hpb.of_iso (Iso.refl _) i (Iso.refl _) (Iso.refl _) (by simp) (by simp) (by simp [hi]) (by simp)
  refine ⟨hpb', ?_, ?_, ?_⟩
  · intro T t' P Q
    have h1 := hmul t' P Q
    have h2 := congrArg Subtype.val (imul (t' ≫ Spec.map (CommRingCat.ofHom ρ))
      ⟨P.1 ≫ g, by rw [Category.assoc, hpb.w, ← Category.assoc, P.2]⟩
      ⟨Q.1 ≫ g, by rw [Category.assoc, hpb.w, ← Category.assoc, Q.2]⟩)
    simp only [mapPt_coe] at h2
    rw [← Category.assoc, h1, h2]
    exact mul_val_congr E' rfl _ _ _ _ (by simp [mapPt_coe]) (by simp [mapPt_coe])
  · intro x
    rw [← Category.assoc, hact, Category.assoc, iact, Category.assoc]
  · intro T t' P hP
    obtain ⟨P₁, hP₁⟩ := hlev t' P hP
    have hfac : FactorsThrough E'.lev (mapPt i.hom hi (⟨E.lev, rfl⟩ : SchemeHomOver (E.lev ≫ E.f) E.f)) :=
      (ilev (E.lev ≫ E.f) ⟨E.lev, rfl⟩).1 ⟨𝟙 _, Category.id_comp _⟩
    obtain ⟨c, hc⟩ := hfac
    refine ⟨P₁ ≫ c, ?_⟩
    rw [Category.assoc, hc, mapPt_coe, ← Category.assoc, hP₁, Category.assoc]

theorem isPullbackVia_iso_comp
    {S S₀ : Type} [CommRing S] [CommRing S₀] (ρ : S →+* S₀)
    (E' : FakeEllipticCurve Λ N S) (E₀ E₀' : FakeEllipticCurve Λ N S₀)
    (g' : E₀'.A ⟶ E'.A) (hg' : FakeEllipticCurve.IsPullbackVia ρ E' E₀' g')
    (i₀ : E₀.A ≅ E₀'.A) (hi₀ : i₀.hom ≫ E₀'.f = E₀.f) (hiso₀ : FakeEllipticCurve.IsoVia E₀ E₀' i₀ hi₀) :
    FakeEllipticCurve.IsPullbackVia ρ E' E₀ (i₀.hom ≫ g') := by
  obtain ⟨hpb, hmul, hact, hlev⟩ := hg'
  obtain ⟨imul, iact, ilev⟩ := hiso₀
  have hpb' : IsPullback (i₀.hom ≫ g') E₀.f E'.f (Spec.map (CommRingCat.ofHom ρ)) :=
    hpb.of_iso i₀.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp) (by simp [← hi₀]) (by simp) (by simp)
  refine ⟨hpb', ?_, ?_, ?_⟩
  · intro T t' P Q
    have h2 := congrArg Subtype.val (imul t' P Q)
    simp only [mapPt_coe] at h2
    have h1 := hmul t' (mapPt i₀.hom hi₀ P) (mapPt i₀.hom hi₀ Q)
    rw [← Category.assoc, h2, h1]
    exact mul_val_congr E' rfl _ _ _ _ (by simp [mapPt_coe]) (by simp [mapPt_coe])
  · intro x
    rw [← Category.assoc, iact, Category.assoc, hact, Category.assoc]
  · intro T t' P hP
    obtain ⟨P₀, hP₀⟩ := hlev t' (mapPt i₀.hom hi₀ P) ((ilev t' P).1 hP)
    exact ⟨P₀, by rw [hP₀, mapPt_coe, Category.assoc]⟩

theorem comp_hom_eq_hom_comp_of_isoVia_of_isPullbackVia_of_three_le
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N m : ℕ} (hm : 3 ≤ m)
    {S S₀ : Type} [CommRing S] [CommRing S₀] (ρ : S →+* S₀)
    (hmS₀ : IsUnit ((m : ℕ) : S₀)) (hNS₀ : IsUnit ((N : ℕ) : S₀))
    (E E' : FakeEllipticCurve Λ N S) (Pn : E.FullLevel m) (Pn' : E'.FullLevel m)
    (E₀ E₀' : FakeEllipticCurve Λ N S₀)
    (g : E₀.A ⟶ E.A) (hg : FakeEllipticCurve.IsPullbackVia ρ E E₀ g)
    (g' : E₀'.A ⟶ E'.A) (hg' : FakeEllipticCurve.IsPullbackVia ρ E' E₀' g')
    (Pn₀ : E₀.FullLevel m) (hPn₀ : (Pn₀.P).1 ≫ g = Spec.map (CommRingCat.ofHom ρ) ≫ (Pn.P).1)
    (Pn₀' : E₀'.FullLevel m) (hPn₀' : (Pn₀'.P).1 ≫ g' = Spec.map (CommRingCat.ofHom ρ) ≫ (Pn'.P).1)
    (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f) (hiso : FakeEllipticCurve.IsoVia E E' i hi)
    (hiP : mapPt i.hom hi Pn.P = Pn'.P)
    (i₀ : E₀.A ≅ E₀'.A) (hi₀ : i₀.hom ≫ E₀'.f = E₀.f) (hiso₀ : FakeEllipticCurve.IsoVia E₀ E₀' i₀ hi₀)
    (hi₀P : mapPt i₀.hom hi₀ Pn₀.P = Pn₀'.P) :
    g ≫ i.hom = i₀.hom ≫ g' := by
  have hA : FakeEllipticCurve.IsPullbackVia ρ E' E₀ (g ≫ i.hom) :=
    isPullbackVia_comp_iso ρ E E' E₀ g hg i hi hiso
  have hA' : FakeEllipticCurve.IsPullbackVia ρ E' E₀ (i₀.hom ≫ g') :=
    isPullbackVia_iso_comp ρ E' E₀ E₀' g' hg' i₀ hi₀ hiso₀
  obtain ⟨h, hh1, hh2, hh⟩ :=
    FakeEllipticCurve.exists_isPullbackVia_id_comp_eq_of_isPullbackVia_of_isPullbackVia_of_isUnit
      ρ hNS₀ E' E₀ (g ≫ i.hom) hA E₀ (i₀.hom ≫ g') hA'
  obtain ⟨hApb, -, -, -⟩ := hA
  obtain ⟨hpb, hmul, hact, -⟩ := hh
  haveI : IsIso h := hpb.isIso_fst_of_isIso
    (inst := by rw [CommRingCat.ofHom_id, Spec.map_id]; infer_instance)
  have key := FakeEllipticCurve.WithFullLevel.eq_refl_of_mapPt_eq_of_three_le hqq' hB Λ hΛ hm hmS₀
    ⟨E₀, Pn₀⟩ (asIso h) hh2 ?_ ?_ ?_
  · have h1 : h = 𝟙 _ := by
      have := congrArg Iso.hom key
      simpa using this
    simpa [h1] using hh1
  · intro T t P Q
    apply Subtype.ext
    simp only [mapPt_coe, asIso_hom]
    rw [hmul t P Q]
    have ht : t ≫ Spec.map (CommRingCat.ofHom (RingHom.id S₀)) = t := by
      rw [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
    exact mul_val_congr E₀ ht _ _ _ _ rfl rfl
  · intro x
    simpa using hact x
  · apply Subtype.ext
    simp only [mapPt_coe, asIso_hom]
    apply hApb.hom_ext
    · have e1 : ((Pn₀.P).1 ≫ h) ≫ (g ≫ i.hom) = (Pn₀.P).1 ≫ (i₀.hom ≫ g') := by rw [Category.assoc, hh1]
      have e2 : (Pn₀.P).1 ≫ i₀.hom = (Pn₀'.P).1 := by
        have := congrArg Subtype.val hi₀P; simpa [mapPt_coe] using this
      have e3 : (Pn.P).1 ≫ i.hom = (Pn'.P).1 := by
        have := congrArg Subtype.val hiP; simpa [mapPt_coe] using this
      rw [e1, ← Category.assoc, e2, hPn₀', ← e3, ← Category.assoc, ← hPn₀, Category.assoc]
    · rw [Category.assoc, hh2]

theorem isoVia_refl {S : Type} [CommRing S] (E : FakeEllipticCurve Λ N S) :
    FakeEllipticCurve.IsoVia E E (Iso.refl E.A) (Category.id_comp E.f) := by
  have hid : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      mapPt (Iso.refl E.A).hom (Category.id_comp E.f) P = P := fun t P => Subtype.ext (by simp [mapPt_coe])
  refine ⟨?_, ?_, ?_⟩
  · intro T t P Q; rw [hid, hid, hid]
  · intro x; simp
  · intro T t P; rw [hid]

theorem mapPt_inv_mapPt_hom {S : Type} [CommRing S] {E E' : FakeEllipticCurve Λ N S} (i : E.A ≅ E'.A)
    (hi : i.hom ≫ E'.f = E.f) (hi' : i.inv ≫ E.f = E'.f) {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)}
    (P : SchemeHomOver t E.f) : mapPt i.inv hi' (mapPt i.hom hi P) = P :=
  Subtype.ext (by simp [mapPt_coe])

theorem mapPt_hom_mapPt_inv {S : Type} [CommRing S] {E E' : FakeEllipticCurve Λ N S} (i : E.A ≅ E'.A)
    (hi : i.hom ≫ E'.f = E.f) (hi' : i.inv ≫ E.f = E'.f) {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)}
    (P : SchemeHomOver t E'.f) : mapPt i.hom hi (mapPt i.inv hi' P) = P :=
  Subtype.ext (by simp [mapPt_coe])

theorem isoVia_symm {S : Type} [CommRing S] {E E' : FakeEllipticCurve Λ N S} {i : E.A ≅ E'.A}
    {hi : i.hom ≫ E'.f = E.f} (hiso : FakeEllipticCurve.IsoVia E E' i hi) :
    FakeEllipticCurve.IsoVia E' E i.symm (by simp [← hi]) := by
  have hi' : i.inv ≫ E.f = E'.f := by simp [← hi]
  obtain ⟨imul, iact, ilev⟩ := hiso
  refine ⟨?_, ?_, ?_⟩
  · intro T t P Q
    have h := imul t (mapPt i.inv hi' P) (mapPt i.inv hi' Q)
    rw [mapPt_hom_mapPt_inv, mapPt_hom_mapPt_inv] at h
    have h' := congrArg (mapPt i.inv hi') h
    rw [mapPt_inv_mapPt_hom] at h'
    exact h'.symm
  · intro x
    rw [Iso.symm_hom, Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp, iact]
  · intro T t P
    have h := ilev t (mapPt i.inv hi' P)
    rw [mapPt_hom_mapPt_inv] at h
    exact h.symm

theorem isUnit_natCast_of_isNilpotent_of_coprime {R : Type} [CommRing R] {r k : ℕ}
    (hr : IsNilpotent ((r : ℕ) : R)) (hk : Nat.Coprime k r) : IsUnit ((k : ℕ) : R) := by
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hk
  have h1 : ((u : ℤ) : R) * (k : R) = 1 - (v : R) * (r : R) := by
    have := congrArg (Int.cast : ℤ → R) huv
    push_cast at this
    linear_combination this
  have h2 : IsUnit (1 - ((v : ℤ) : R) * (r : R)) :=
    (Commute.isNilpotent_mul_left (Commute.all _ _) hr).isUnit_one_sub
  rw [← h1] at h2
  exact isUnit_of_mul_isUnit_right h2

