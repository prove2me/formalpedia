theorem GCAux.isFinite_dH
    (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (hMlft : LocallyOfFiniteType πM)
    (G : Type) [Group G] [Finite G] (ρ : G →* Aut M)
    (Xq : Scheme.{0}) (πXq : Xq ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (πq : M ⟶ Xq) (hπqX : πq ≫ πXq = πM)
    (hintq : IsIntegralHom πq) (haffq : IsAffineHom πq)
    (XH : Scheme.{0}) (πXH : XH ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (πH : M ⟶ XH)
    (hsurjH : Function.Surjective πH.base)
    (hsecH : ∀ V : XH.Opens, Function.Injective (πH.app V))
    (H : Subgroup G)
    (hopenH : ∀ W : M.Opens, IsAffineOpen W → (∀ h : H, (ρ h).hom ⁻¹ᵁ W = W) → ∃ V : XH.Opens, IsAffineOpen V ∧ πH ⁻¹ᵁ V = W)
    (hπq : ∀ g : G, (ρ g).hom ≫ πq = πq)
    (dH : XH ⟶ Xq) (hdH : πH ≫ dH = πq)
    {D : ℕ} {Fbar : Type} [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
    {X : Scheme.{0}} {πX : X ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))}
    {sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))}
    (gX : Xq ⟶ CategoryTheory.Limits.pullback πX sbar) (hgXiso : IsIso gX)
    (hgXπ : gX ≫ CategoryTheory.Limits.pullback.snd πX sbar = πXq)
    (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) Fbar)
    (e𝔐 : 𝔐.C ⟶ CategoryTheory.Limits.pullback πX sbar) [CategoryTheory.IsIso e𝔐]
    (he𝔐 : e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar = 𝔐.toBase) :
    IsFinite dH := by
  classical
  subst hdH
  haveI := hgXiso

  have hsnd : CategoryTheory.Limits.pullback.snd πX sbar = inv e𝔐 ≫ 𝔐.toBase := by
    rw [← he𝔐, IsIso.inv_hom_id_assoc]
  haveI : Smooth 𝔐.toBase := SmoothOfRelativeDimension.smooth (n := 1) (f := 𝔐.toBase)
  haveI hXqlft : LocallyOfFiniteType πXq := by rw [← hgXπ, hsnd]; infer_instance
  haveI : IsLocallyNoetherian Xq := LocallyOfFiniteType.isLocallyNoetherian πXq

  haveI : LocallyOfFiniteType ((πH ≫ dH) ≫ πXq) := by rw [hπqX]; exact hMlft
  haveI : LocallyOfFiniteType (πH ≫ dH) := locallyOfFiniteType_of_comp (πH ≫ dH) πXq
  haveI hqfin : IsFinite (πH ≫ dH) := by
    rw [IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]; exact ⟨hintq, inferInstance⟩

  have hpre_inj : ∀ V V' : XH.Opens, πH ⁻¹ᵁ V = πH ⁻¹ᵁ V' → V = V' := by
    intro V V' h
    ext x
    obtain ⟨y, rfl⟩ := hsurjH x
    have := congrArg (fun W : M.Opens => y ∈ W) h
    simpa using this
  haveI haffd : IsAffineHom dH := by
    refine ⟨fun V hV => ?_⟩
    have hW : IsAffineOpen ((πH ≫ dH) ⁻¹ᵁ V) := hV.preimage (πH ≫ dH)
    have hWst : ∀ h : H, (ρ h).hom ⁻¹ᵁ ((πH ≫ dH) ⁻¹ᵁ V) = (πH ≫ dH) ⁻¹ᵁ V := by
      intro h
      rw [← Scheme.Hom.comp_preimage, hπq (h : G)]
    obtain ⟨V', hV', hV'eq⟩ := hopenH _ hW hWst
    have : V' = dH ⁻¹ᵁ V := hpre_inj _ _ (by rw [hV'eq]; rfl)
    rw [← this]; exact hV'

  refine ⟨fun V hV => ?_⟩
  haveI : IsNoetherianRing Γ(Xq, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have hfq : ((πH ≫ dH).app V).hom.Finite := (πH ≫ dH).finite_app V hV

  letI algB : Algebra Γ(Xq, V) Γ(XH, dH ⁻¹ᵁ V) := (dH.app V).hom.toAlgebra
  letI algC : Algebra Γ(Xq, V) Γ(M, (πH ≫ dH) ⁻¹ᵁ V) := ((πH ≫ dH).app V).hom.toAlgebra
  haveI : Module.Finite Γ(Xq, V) Γ(M, (πH ≫ dH) ⁻¹ᵁ V) := hfq
  haveI : IsNoetherian Γ(Xq, V) Γ(M, (πH ≫ dH) ⁻¹ᵁ V) := isNoetherian_of_isNoetherianRing_of_finite _ _
  let φ : Γ(XH, dH ⁻¹ᵁ V) →ₗ[Γ(Xq, V)] Γ(M, (πH ≫ dH) ⁻¹ᵁ V) :=
    { toFun := fun s => (πH.app (dH ⁻¹ᵁ V)).hom s
      map_add' := fun s t => map_add _ s t
      map_smul' := fun a s => by
        simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra, RingHom.id_apply, map_mul]
        rfl }
  have hφ : Function.Injective φ := hsecH (dH ⁻¹ᵁ V)
  exact Module.Finite.of_injective φ hφ

theorem GCAux.surjective_U_dH
    (Xq : Scheme.{0}) (πXq : Xq ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
    (XH : Scheme.{0}) (πXH : XH ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (dH : XH ⟶ Xq) [IsFinite dH]
    (hdHπ : dH ≫ πXq = πXH)
    (U : XH.Opens) (hUclosed : IsClosed (U : Set XH)) [IsIntegral (U : Scheme.{0})]
    [SmoothOfRelativeDimension 1 (U.ι ≫ πXH)]
    {D : ℕ} {Fbar : Type} [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
    {X : Scheme.{0}} {πX : X ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))}
    {sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))}
    (gX : Xq ⟶ CategoryTheory.Limits.pullback πX sbar) (hgXiso : IsIso gX)
    (hgXπ : gX ≫ CategoryTheory.Limits.pullback.snd πX sbar = πXq)
    (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) Fbar)
    (e𝔐 : 𝔐.C ⟶ CategoryTheory.Limits.pullback πX sbar) [CategoryTheory.IsIso e𝔐]
    (he𝔐 : e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar = 𝔐.toBase) :
    Function.Surjective (U.ι ≫ dH).base := by

  haveI := hgXiso
  haveI : Nonempty (U : Scheme.{0}) := inferInstance
  obtain ⟨u₀⟩ := ‹Nonempty (U : Scheme.{0})›
  haveI : Nonempty Xq := ⟨(U.ι ≫ dH).base u₀⟩
  haveI : IsIntegral Xq := isIntegral_of_isOpenImmersion (gX ≫ inv e𝔐)
  have hπXq : πXq = (gX ≫ inv e𝔐) ≫ 𝔐.toBase := by
    rw [← hgXπ, ← he𝔐, Category.assoc, IsIso.inv_hom_id_assoc]
  haveI : SmoothOfRelativeDimension 1 ((gX ≫ inv e𝔐) ≫ 𝔐.toBase) :=
    inferInstanceAs (SmoothOfRelativeDimension (0 + 1) ((gX ≫ inv e𝔐) ≫ 𝔐.toBase))
  haveI : SmoothOfRelativeDimension 1 πXq := by rw [hπXq]; infer_instance

  haveI : IsClosedImmersion U.ι := IsClosedImmersion.of_isPreimmersion U.ι (by rw [Scheme.Opens.range_ι]; exact hUclosed)
  haveI : IsFinite (U.ι ≫ dH) := inferInstance
  exact AlgebraicGeometry.surjective_of_isFinite_of_smoothOfRelativeDimension_one (U.ι ≫ πXH) πXq (U.ι ≫ dH)
    (by rw [Category.assoc, hdHπ])

theorem GCAux.germ_congr {X Y : Scheme.{0}} [IsIntegral X] (m₁ m₂ : X ⟶ Y) (h : m₁ = m₂) (V : Y.Opens) (s : Γ(Y, V))
    [Nonempty ((m₁ ⁻¹ᵁ V : X.Opens) : Scheme.{0})] [Nonempty ((m₂ ⁻¹ᵁ V : X.Opens) : Scheme.{0})] :
    X.germToFunctionField (m₁ ⁻¹ᵁ V) (m₁.app V s) = X.germToFunctionField (m₂ ⁻¹ᵁ V) (m₂.app V s) := by
  subst h; rfl

theorem GCAux.germ_id {X : Scheme.{0}} [IsIntegral X] (m : X ⟶ X) (h : m = 𝟙 X) (V : X.Opens) (s : Γ(X, V))
    [Nonempty ((m ⁻¹ᵁ V : X.Opens) : Scheme.{0})] [Nonempty (V : Scheme.{0})] :
    X.germToFunctionField (m ⁻¹ᵁ V) (m.app V s) = X.germToFunctionField V s := by
  subst h; rfl

