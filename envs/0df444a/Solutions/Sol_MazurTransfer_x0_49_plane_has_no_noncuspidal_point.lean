/-- The affine level-seven modular correspondence has no rational point
away from the singular cusp image: `G(s,B) = 0` with `s·B ≠ 0` is
impossible over `ℚ`. -/
theorem no_noncuspidal_correspondence_point
    {s B : ℚ} (hs : s ≠ 0) (hB : B ≠ 0)
    (hG : orderSevenG7F s B = 0) :
    False := by
  have hGB := mGB_ne_zero hs hB hG
  have hOn := transfer_on_curve hGB hG
  have hns : curve.toAffine.Nonsingular
      (mNX s B / mGB s B) (mNY s B / mGB s B) := by
    apply curve.toAffine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]
    norm_num [curve]
    linear_combination hOn
  have hclass := point_eq_zero_or_T
    (WeierstrassCurve.Affine.Point.some _ _ hns)
  rcases hclass with h | h
  · exact WeierstrassCurve.Affine.Point.some_ne_zero hns h
  · have hx :=
      (WeierstrassCurve.Affine.Point.some.injEq _ _ _ _ _ _).mp
        (h.trans (by rw [T])) |>.1
    have hx0 : mNX s B = 0 := by
      have := div_eq_zero_iff.mp hx
      rcases this with h' | h'
      · exact h'
      · exact absurd h' hGB
    exact mNX_ne_zero hs hB hG hx0

end MazurTorsion.XZeroFortyNine

end

theorem solution :
  ∀ s B : ℚ, s ≠ 0 → B ≠ 0 →
    MazurTorsion.Kubert.orderSevenG7F s B = 0 → False := by
  intro s B hs hB hG
  exact MazurTorsion.XZeroFortyNine.no_noncuspidal_correspondence_point hs hB hG

