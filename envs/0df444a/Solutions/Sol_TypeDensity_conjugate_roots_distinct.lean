theorem solution (O : Type) [CommRing O] [IsLocalRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) :
    (∀ c : O, TypeDensity.residueEmbed O Φ (IsLocalRing.residue O c) = TypeDensity.baseReduce O Φ
        (algebraMap O (AdjoinRoot Φ) c)) ∧ Function.Injective (TypeDensity.residueEmbed O Φ) ∧
      (∀ i : ℕ, ((TypeDensity.residuePoly O Φ).map (TypeDensity.residueEmbed O Φ)).IsRoot (TypeDensity.rootBar O Φ ^ TypeDensity.residueCard O ^ i))
      ∧ (∀ i j : ℕ, i < Φ.natDegree → j < Φ.natDegree → TypeDensity.rootBar O Φ ^ TypeDensity.residueCard O ^ i =
        TypeDensity.rootBar O Φ ^ TypeDensity.residueCard O ^ j → i = j) ∧ (TypeDensity.residuePoly O Φ).map (TypeDensity.residueEmbed O Φ) = ∏ i :
      Fin Φ.natDegree, TypeDensity.conjugateFactor O Φ i ∧
      (∀ i j : Fin Φ.natDegree, i ≠ j → IsCoprime (TypeDensity.conjugateFactor O Φ i) (TypeDensity.conjugateFactor O Φ j)) := by
  obtain ⟨hKf, hKfin, hKcard⟩ := TypeDensity.residue_extension_field O Φ hΦ
  set K := TypeDensity.residueExtension O Φ
  set q := TypeDensity.residueCard O
  set δ := Φ.natDegree
  set ρ := TypeDensity.residueEmbed O Φ
  set θ := TypeDensity.rootBar O Φ
  -- compatibility
  have hcomp : ∀ c : O, ρ (IsLocalRing.residue O c) = TypeDensity.baseReduce O Φ
      (algebraMap O (AdjoinRoot Φ) c) :=
    fun c => rfl
  have hcompR : ρ.comp (IsLocalRing.residue O) = (TypeDensity.baseReduce O Φ).comp (AdjoinRoot.of Φ) :=
    RingHom.ext hcomp
  -- iterated Frobenius
  have hiter : ∀ (P : Polynomial (IsLocalRing.ResidueField O)) (y : K) (n : ℕ),
      P.eval₂ ρ (y ^ q ^ n) = (P.eval₂ ρ y) ^ q ^ n := by
    intro P y n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, pow_mul, pow_mul, TypeDensity.eval_at_pow_card, ih]
  -- every element is a polynomial expression in θ
  have hsurj : ∀ x : K, ∃ P : Polynomial (IsLocalRing.ResidueField O), x = P.eval₂ ρ θ := by
    intro x
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    induction a using AdjoinRoot.induction_on with
    | ih p =>
      refine ⟨p.map (IsLocalRing.residue O), ?_⟩
      rw [Polynomial.eval₂_map, hcompR, ← AdjoinRoot.aeval_eq, Polynomial.aeval_def,
        Polynomial.hom_eval₂]
      rfl
  have hq : 1 < q := Finite.one_lt_card
  have hroot : ∀ i : ℕ, ((TypeDensity.residuePoly O Φ).map ρ).IsRoot (θ ^ q ^ i) := by
    intro i
    rw [Polynomial.IsRoot.def, Polynomial.eval_map, hiter]
    have : (TypeDensity.residuePoly O Φ).eval₂ ρ θ = 0 := by
      rw [Polynomial.eval₂_map, hcompR, ← Polynomial.hom_eval₂, AdjoinRoot.eval₂_root, map_zero]
    rw [this, zero_pow (pow_ne_zero _ (by omega))]
  have hθδ : θ ^ q ^ δ = θ := by rw [← hKcard]; exact TypeDensity.pow_natCard_eq_self K hKf θ
  have hdist : ∀ i j : ℕ, i < δ → j < δ → θ ^ q ^ i = θ ^ q ^ j → i = j := by
    have key : ∀ i j : ℕ, i < j → j < δ → θ ^ q ^ i = θ ^ q ^ j → False := by
      intro i j hij hj h
      set m := i + (δ - j) with hm
      have h1 : θ ^ q ^ m = θ := by
        have := congrArg (· ^ q ^ (δ - j)) h
        simp only [← pow_mul, ← pow_add] at this
        rw [hm, this, show j + (δ - j) = δ by omega, hθδ]
      have hall : ∀ x : K, x ^ q ^ m = x := by
        intro x
        obtain ⟨P, rfl⟩ := hsurj x
        rw [← hiter, h1]
      have hm1 : 1 < q ^ m := Nat.one_lt_pow (by omega) hq
      have := TypeDensity.natCard_le_of_pow_eq_self K hKf _ hm1 hall
      rw [hKcard] at this
      have := (Nat.pow_le_pow_iff_right hq).1 this
      omega
    intro i j hi hj h
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with hij | hij
    exacts [key i j hij hj h, key j i hij hi h.symm]
  have hnt : Nontrivial K := ⟨hKf.exists_pair_ne⟩
  have hmon : ((TypeDensity.residuePoly O Φ).map ρ).Monic := (hΦ.1.map _).map _
  have hdeg : ((TypeDensity.residuePoly O Φ).map ρ).natDegree = δ := by
    rw [(hΦ.1.map _).natDegree_map, hΦ.1.natDegree_map]
  have hinj : Function.Injective (fun i : Fin δ => θ ^ q ^ (i : ℕ)) :=
    fun i j h => Fin.ext (hdist i j i.2 j.2 h)
  obtain ⟨hfac, hcop⟩ := TypeDensity.monic_eq_prod_X_sub_C K hKf _ hmon δ hdeg _ hinj (fun i => hroot i)
  exact ⟨hcomp, ρ.injective, hroot, hdist, hfac, hcop⟩
