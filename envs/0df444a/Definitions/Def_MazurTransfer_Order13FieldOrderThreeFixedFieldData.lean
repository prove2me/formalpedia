import Definitions.Def_MazurTransfer_Order13FieldConicFieldCubicExtensionData
import Theorems.Thm_MazurTransfer_FiniteAutomorphismSubgroupFixedFieldDegree_finrank_fixedField

noncomputable section
universe w
namespace MazurTransfer.Order13FieldOrderThreeFixedField
open GoodCharacteristicGeometryPublicProof.MazurTransfer.Order13GoodCharacteristicCurveModel
open Order13FieldDiamondFunctionFieldAutomorphism Order13FieldDiamondExactOrder
open Order13PellActualOrdinaryChart Order13FieldOrdinaryPolynomialTranscendence
open Order13FieldConicFunctionParameter Order13FieldConicFieldCubicExtension
variable (K : Type w) [Field K] [CharZero K]
local instance : Fact ((104 : K) ≠ 0) := ⟨by norm_num⟩
local instance : Algebra K (actualCurveFunctionField K) := actualCurveFunctionFieldAlgebra K
local instance : CharZero (actualCurveFunctionField K) := Algebra.charZero_of_charZero K _

def orderThreeGroup : Subgroup (actualCurveFunctionField K ≃ₐ[K] actualCurveFunctionField K) :=
  Subgroup.zpowers ((diamondAlgEquiv K) ^ 2)

theorem orderThreeGroup_card : Nat.card (orderThreeGroup K) = 3 := by
  rw [orderThreeGroup, Nat.card_zpowers, orderOf_pow' (x := (diamondAlgEquiv K)) (n := 2) (by decide), (diamondAlgEquiv_order K)]
  norm_num

instance : Finite (orderThreeGroup K) := Nat.finite_of_card_ne_zero (by rw [(orderThreeGroup_card K)]; decide)

def quotientFixedField : IntermediateField K (actualCurveFunctionField K) :=
  IntermediateField.fixedField (orderThreeGroup K)

theorem fixedField_degree : Module.finrank (quotientFixedField K) (actualCurveFunctionField K) = 3 := by
  rw [quotientFixedField, FiniteAutomorphismSubgroupFixedFieldDegree.finrank_fixedField,
    (orderThreeGroup_card K)]

theorem parameter_fixedField_mem : (t K) ∈ (quotientFixedField K) := by
  apply (IntermediateField.mem_fixedField_iff _ _).mpr
  intro f hf
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hf
  have H : (t K) ∈ MulAction.fixedBy (actualCurveFunctionField K) ((diamondAlgEquiv K) ^ 2) := by
    change (diamondSecond K) (t K) = (t K)
    exact (square_fixes_parameter K)
  exact MulAction.mem_fixedBy_zpow H n

theorem conicField_le_fixedField : (conicField K) ≤ (quotientFixedField K) := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro z hz
  exact Set.mem_singleton_iff.mp hz ▸ (parameter_fixedField_mem K)

theorem actual_order_three_fixed_field : (conicField K) = (quotientFixedField K) := by
  letI := (curveField_finite K)
  apply IntermediateField.eq_of_le_of_finrank_le' (conicField_le_fixedField K)
  rw [(fixedField_degree K)]
  exact (curveField_degree_le_three K)

theorem curveField_degree_three : Module.finrank (conicField K) (actualCurveFunctionField K) = 3 := by
  rw [(actual_order_three_fixed_field K)]
  exact (fixedField_degree K)

local instance : Algebra K (conicField K) := IntermediateField.algebra' (conicField K)
local instance : Algebra K (RatFunc K) := RatFunc.instAlgebraOfPolynomial K K

theorem parameter_transcendental : Transcendental K (t K) := by
  intro Ht
  haveI : Algebra.IsAlgebraic K (conicField K) :=
    IntermediateField.isAlgebraic_adjoin_simple (isAlgebraic_iff_isIntegral.mp Ht)
  exact (xImage_transcendental K) (IsIntegral.trans_isAlgebraic (R := K) (x_integral K))

def rationalQuotientFieldEquiv : RatFunc K ≃ₐ[K] (conicField K) :=
  RatFunc.algEquivOfTranscendental (t K) (parameter_transcendental K)

theorem curveField_galois : IsGalois (conicField K) (actualCurveFunctionField K) := by
  rw [(actual_order_three_fixed_field K)]
  exact IsGalois.of_fixed_field (actualCurveFunctionField K) (orderThreeGroup K)

def cyclicGaloisGroupEquiv : (orderThreeGroup K) ≃*
    (actualCurveFunctionField K ≃ₐ[(conicField K)] actualCurveFunctionField K) := by
  rw [(actual_order_three_fixed_field K)]
  exact FixedPoints.toAlgAutMulEquiv (orderThreeGroup K) (actualCurveFunctionField K)

end MazurTransfer.Order13FieldOrderThreeFixedField
