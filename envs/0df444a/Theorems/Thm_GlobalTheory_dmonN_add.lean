variable {R : Type} [CommRing R] {d n : ℕ}
variable {ι : Type} [Fintype ι]

theorem GlobalTheory.dmonN_add (F : Fin d → PS R 2 d) (cp : ι → Fin n) (u : ι → Fin d → R) (m : ι →₀ ℕ)
    (f g : PS R n d) :
    DmonN F cp u m (f + g) = DmonN F cp u m f + DmonN F cp u m g := by sorry
