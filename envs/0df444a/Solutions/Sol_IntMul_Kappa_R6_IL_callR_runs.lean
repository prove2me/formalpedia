    refine ⟨⟨t0.G dJ, ?_⟩, ⟨t0.G dT, ?_⟩, ⟨L7, ?_⟩, ⟨t0.G dL, ?_⟩, ⟨t0.G dA, ?_⟩,
      ⟨t0.G dB, ?_⟩, ⟨t0.G dC, ?_⟩⟩ <;>
      simp +decide [t1, evl, pushSt, IState.upd_G, t0, hP]
  have h0t1 : t1.G 0 = ints (enc2 ys) ++ R := by
    rw [ht1, pushSt_G_of_not_mem _ _ _ h0n]; simp [t0]
  have h2 := hrec t1 R ys hD hys
  rw [show t1.upd 0 (ints (enc2 ys) ++ R) = t1 by rw [← h0t1, IState.upd_self]] at h2
  have e2 : t1.upd 0 (ints (enc2 (ch ys)) ++ R) =
      pushSt (t.upd 0 (ints (enc2 (ch ys)) ++ R)) evl := by
    rw [ht1, ht0, pushSt_upd_comm _ _ _ _ h0n, pushSt_upd_comm _ _ _ _ h0n, IState.upd_upd_same]
  rw [e2] at h2
  have hz : ∀ x : ℕ, x ≤ M → zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (zsz_natCast_le' hx) hM
  have S3 := Sp.popsR Bb evl (t.upd 0 (ints (enc2 (ch ys)) ++ R)) (by
    intro p hp
