-- Source module: Solutions.J6SegB0
/-!
# Segmented inverse (S2): Proposition 4.7 and Lemma 19 with the segmented `J̃`

The base `Bapprox = P̃_s⁻¹ D̃' J̃' C̃ P̃_t` (HvdH Proposition 4.7) solves the resampling system
`(I + E) w = y/2` by the Neumann iteration `Japprox`. Here the solver is the segmented inverse
`segInvFullS` (sparse banded elimination, tables and blocks computed from the parameters):

* `segJ p P R λ w s t α Y`: scale `Y` (precision `p`) to precision `P` (exact shift by
  `P - p - 1`, which also halves), run `segInvFullS`, shift back by `P - p` (floor), and read
  `0` outside `[0, s)`.
* `Bseg = P̃_s⁻¹ D̃' segJ C̃ P̃_t` and the permutation-free `B0seg = D̃' segJ C̃` (`B0segP`: read
  mod `s`).
* `prop_4_7_seg`: the maps `A`, `B` of Proposition 4.7 (built exactly as in the base proof), with
  `‖toC (Bseg V)_j - 2^p (B v)_j‖ ≤ 2 segE + 3`, where
  `segE = 2^p (60 G/2^P + 18 e^{-πα² w(w+1)}) + 1`, `G = fullG λ w s t α (1/2)`.
  Hypotheses: `α²θ ≥ 3` (`3 s ≤ α² (t - s)`), `α² ≤ p`, `1 ≤ λ`, `w ≤ s`, `D_{λ-1} ≤ 2^R`,
  `p + 1 ≤ P`, `1000 G ≤ 2^P`, `200 segE ≤ 2^p` (no `jIter` hypothesis).
* `lemma19_seg`: the same in the `B₀ = B0of s t B` form with the `permS`/`permT` identity of
  `AxisMaps6.hid` / `KFM.AxisMaps.hid`.
-/

open Complex Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.Res IntMul.HvdH.P47

/-- `‖B0of s t B‖ ≤ c` from `‖B‖ ≤ c`. -/
lemma norm_B0of_le' (s t : ℕ) [NeZero s] [NeZero t] (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ))
    {c : ℝ} (hB : ‖B‖ ≤ c) : ‖NLogN.KFM.B0of s t B‖ ≤ c := by
  unfold NLogN.KFM.B0of
  refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
  have h1 := NLogN.KFM.norm_reidx_le (fun l : ZMod s => (t : ZMod s) * l)
  have hc : 0 ≤ c := (norm_nonneg _).trans hB
  have h2 : ‖B.comp (NLogN.KFM.reidx (NLogN.KFM.tauT s t))‖ ≤ c :=
    (ContinuousLinearMap.opNorm_comp_le _ _).trans
      (by nlinarith [NLogN.KFM.norm_reidx_le (NLogN.KFM.tauT s t), norm_nonneg B])
  nlinarith [norm_nonneg (NLogN.KFM.reidx (fun l : ZMod s => (t : ZMod s) * l)),
    norm_nonneg (B.comp (NLogN.KFM.reidx (NLogN.KFM.tauT s t)))]

/-! ### Lemma 19 form (`B₀ = P_s B P_t⁻¹`) -/

lemma B0seg_unPt (p P R lam w s t α : ℕ) [NeZero t] (hcop : Nat.Coprime s t)
    (W : ℕ → ℤ × ℤ) :
    B0seg p P R lam w s t α (ptPerm s t (NLogN.KFM.unPt s t W)) = B0seg p P R lam w s t α W := by
  have hpt : ∀ x : ZMod t, ptPerm s t (NLogN.KFM.unPt s t W) x.val = W x.val := by
    intro x
    simp only [ptPerm, NLogN.KFM.unPt, NLogN.KFM.tauT, ZMod.natCast_zmod_val]
    congr 2
    rw [mul_neg, neg_neg, ← mul_assoc, mul_comm ((s : ZMod t)⁻¹),
      ZMod.coe_mul_inv_eq_one s hcop, one_mul]
  have hsel : cSel s t (ptPerm s t (NLogN.KFM.unPt s t W)) = cSel s t W := by
    funext m; simp only [cSel]; exact hpt _
  simp only [B0seg, hsel]

lemma Bseg_unPt (p P R lam w s t α : ℕ) [NeZero s] [NeZero t] (hcop : Nat.Coprime s t)
    (W : ℕ → ℤ × ℤ) (l : ℕ) :
    Bseg p P R lam w s t α (NLogN.KFM.unPt s t W) ((t : ZMod s) * (l : ZMod s)).val =
      B0seg p P R lam w s t α W (l % s) := by
  have e : Bseg p P R lam w s t α (NLogN.KFM.unPt s t W) =
      psInvPerm s t (B0seg p P R lam w s t α (ptPerm s t (NLogN.KFM.unPt s t W))) := rfl
  rw [e]
  simp only [psInvPerm]
  rw [ZMod.natCast_zmod_val, ← mul_assoc, mul_comm ((t : ZMod s)⁻¹),
    ZMod.coe_mul_inv_eq_one t hcop.symm, one_mul, ZMod.val_natCast, B0seg_unPt p P R lam w s t α hcop W]

/-- **Lemma 19 with the segmented `B̃₀`.** The identity of `AxisMaps6.hid` holds for
`B₀ = B0of s t B`, and the permutation-free segmented procedure `B0seg` approximates `2^p B₀`. -/
theorem lemma19_seg (p P R lam w s t α : ℕ) [NeZero s] [NeZero t] (hst : s < t)
    (hcop : Nat.Coprime s t) (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx3 : 3 * s ≤ α ^ 2 * (t - s))
    (hl : 1 ≤ lam) (hw : w ≤ s) (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R)
    (hpP : p + 1 ≤ P) (hP : 1000 * fullG lam w s t α (1 / 2) ≤ 2 ^ P)
    (hE : 200 * segE p P lam w s t α ≤ 2 ^ p) :
    ∃ (A : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ)) (B₀ : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 / 2 ∧
      (∀ u, IntMul.OpenAI.RH.permS s t ((s : ℂ)⁻¹ • ZMod.dft u) =
        (2 : ℂ) ^ (2 * α ^ 2) • B₀ (IntMul.OpenAI.RH.permT s t ((t : ℂ)⁻¹ • ZMod.dft (A u)))) ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ i, ‖toC (U i)‖ ≤ 2 ^ p) → ∀ k : ZMod t,
        ‖toC (Sapprox p s t α U k.val) - 2 ^ p * A (fun j => toC (U j.val) / 2 ^ p) k‖
          ≤ 6 * sWidth p α + 4) ∧
      (∀ W : ℕ → ℤ × ℤ, (∀ i, ‖toC (W i)‖ ≤ 2 ^ p) → ∀ l : ZMod s,
        ‖toC (B0seg p P R lam w s t α W l.val) -
          2 ^ p * B₀ (fun k => toC (W k.val) / 2 ^ p) l‖ ≤ 2 * segE p P lam w s t α + 3) := by
  obtain ⟨A, B, hA, hB, hid, hS, hBa⟩ :=
    prop_4_7_seg p P R lam w s t α hst hcop hα hαp hx3 hl hw hR hpP hP hE
  refine ⟨A, NLogN.KFM.B0of s t B, hA, norm_B0of_le' s t B hB, fun u => ?_, hS,
    fun W hW l => ?_⟩
  · rw [hid u, NLogN.KFM.permS_B0of s t hcop]
  · have h := hBa (NLogN.KFM.unPt s t W) (fun i => hW _) ((t : ZMod s) * ((l.val : ℕ) : ZMod s))
    rw [Bseg_unPt p P R lam w s t α hcop W l.val, Nat.mod_eq_of_lt (ZMod.val_lt l),
      ZMod.natCast_zmod_val] at h
    have e2 := NLogN.KFM.B_unPt s t B (fun i => toC (W i) / 2 ^ p) l
    beta_reduce at e2
    rw [← e2]; exact h

end J6Seg

end

