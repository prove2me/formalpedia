variable {A : Type*} [TopologicalSpace A] [Fintype A] {Y : ShiftSpace A}
variable (M : ℕ)
  (hM : ∀ u ∈ language Y, ∀ v ∈ language Y,
    ∃ b ∈ language Y, b.length = M ∧ u ++ b ++ v ∈ language Y)
  (x : Y.carrier) (s : ℕ → ℕ)
namespace BalanceSpecification.MarkerExtension
theorem _root_.solution (n : ℕ) :
    (sourceCodeFinsetAt M hM x s n).card ≤ wordCount (language Y) n := by
  classical
  exact (Finset.card_image_le).trans
    (by simpa only [Finset.card_attach, wordCount] using
      Finset.card_le_card (Finset.filter_subset (fun u : Word A => 0 < u.length)
        (wordFinset (language Y) n)))
end BalanceSpecification.MarkerExtension
