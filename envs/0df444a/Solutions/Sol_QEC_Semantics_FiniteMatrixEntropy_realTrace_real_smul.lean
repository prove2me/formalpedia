noncomputable section
open QEC.Semantics.FiniteMatrixEntropy
namespace QEC.Semantics.FiniteMatrixEntropy
theorem _root_.solution {n : Type v} [Fintype n]
    (s : Real) (A : Matrix n n Complex) :
    realTrace (s • A) = s * realTrace A := by
  unfold realTrace
  rw [Matrix.trace_smul]
  change ((s : Complex) * A.trace).re = s * A.trace.re
  rw [Complex.mul_re]
  simp
end QEC.Semantics.FiniteMatrixEntropy
