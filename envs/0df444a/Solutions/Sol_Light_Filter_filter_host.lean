theorem cardA_true : cardA n s (fun _ => true) = n * n * ((n + s - 1) / s) := by
  simp [cardA]

theorem cardA_mono {A A' : ℕ → Bool} (h : ∀ i, A i = true → A' i = true) :
    cardA n s A ≤ cardA n s A' := by
