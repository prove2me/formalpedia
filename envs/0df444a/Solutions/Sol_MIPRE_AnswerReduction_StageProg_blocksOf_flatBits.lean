open Cost Pcp SAT Introspection.SeededLineProgram Introspection.LineProgram Introspection.SeedProgram MIPRE.LIDT MIPRE.LIDT.CL MIPRE.CL
variable {k : ℕ} (hk : 1 ≤ k)
variable (o sz jw : ℕ) (c : Fin 6)
variable [NeZero sz] {hsz : sz ∣ Fintype.card (shoupBinField k hk).carrier}
  (S : Sel (shoupBinField k hk).carrier sz hsz) (hjw : jw ≤ k)
  (hχ : ∀ a, (S.χ a : ℕ) = (selector (shoupBinField k hk) jw hjw a : ℕ))
variable (P : PcpParams)
theorem _root_.solution (v : Coord P → ((shoupBinField k hk)).carrier) :
    blocksOf (unary k) (unary P.m') (flatBits P hk v) =
      (((shoupBinField k hk)).vecBits (ptOf6 P v), ((shoupBinField k hk)).vecBits (dirOf6 P v), ((shoupBinField k hk)).vecBits (seedsOf P v)) := by
  have hL : (((shoupBinField k hk)).vecBits (ptOf6 P v) ++ ((shoupBinField k hk)).vecBits (dirOf6 P v) ++
      ((shoupBinField k hk)).vecBits (seedsOf P v)).length = P.m' + (P.m' + 6) := by
    simp only [List.length_append, BinField.length_vecBits]; ring
  have hw : ∀ b ∈ ((shoupBinField k hk)).vecBits (ptOf6 P v) ++ ((shoupBinField k hk)).vecBits (dirOf6 P v) ++
      ((shoupBinField k hk)).vecBits (seedsOf P v), b.length = k := by
    intro b hb
    simp only [List.mem_append] at hb
    rcases hb with (hb | hb) | hb <;> exact ((shoupBinField k hk)).width_vecBits _ hb
  have hs := Introspection.BinaryBlock.splitBlocks_flatten k _ hw
  rw [hL] at hs
  simp only [blocksOf, length_unary, flatBits_eq_bitsOf, bitsOf]
  rw [hs, List.append_assoc]
  simp only [List.take_left' (BinField.length_vecBits _ _), List.drop_left'
    (BinField.length_vecBits _ _)]
end MIPRE.AnswerReduction.StageProg
