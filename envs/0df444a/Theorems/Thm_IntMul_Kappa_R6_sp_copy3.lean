theorem IntMul.Kappa.R6.sp_copy3 (s : IState HS) (f : Fin HS → List ℤ) (Lz l37 l25 : List ℤ) (Aa Bb : ℕ)
    (h51 : f 51 = []) (h25 : f 25 = (Lz.length : ℤ) :: l25) (h37 : f 37 = Lz ++ l37)
    (hb : ∀ z ∈ Lz, |z| ≤ (Aa : ℤ)) (hNA : Lz.length ≤ Aa) (hAa : 2 ≤ Aa)
    (hB : Aa ^ 6 < 2 ^ Bb) :
    Sp cpR (encK s f) (encK s (update (update (update (update f 37 l37) 26 (Lz.reverse ++ f 26))
      27 (Lz.reverse ++ f 27)) 28 (Lz.reverse ++ f 28))) ((Lz.length * 8 + 1) * kU Bb) := by sorry
