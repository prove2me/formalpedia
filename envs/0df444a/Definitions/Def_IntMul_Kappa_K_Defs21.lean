-- Source module: Solutions.KFRLay
/-!
# KFR: the packed layout of three rows and the row addition as an address map

For a stride-`K` row family (`pos (r, c) + K (c + f r) = e`, `f = m^k`, `AffK2`), the rows
`a < b < c` (`σ : Fin 3 → Fin m` strictly monotone) are the three chunk slots of the rectangle
`rect N0 N1 N2 N3 (fK)` (`rectN`), with offset `ρ' = e mod K`: row `r` occupies the address bits
`[sR r, sR r + fK)` of the record index divided by `S₀`, its bit `f-1-u` at `sR r + ρ' + uK`
(`pos_eq_sR`).

* `fsetZ_rowAddr`: the record moved by `rowAddr i j` as a sum over the bits of row `j`.
* **`encode_rowAddAddr`**: `encode (rowAddAddr K ρ' f px py (decode q)) = fset q (rowAddr i j …)`
  for `σ px = i`, `σ py = j`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFR

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly KFN

/-! ## The moved record as a sum over the bits of row `j` -/

section Sum

variable {m f : ℕ}

/-- The contribution of bit `c` of row `j`. -/
def rowTerm (st : Fin m × Fin f → ℕ) (q : ℕ) (i j : Fin m) (c : ℕ) : ℤ :=
  if h : c < f then
    ((((q / st (j, ⟨c, h⟩) % 2 + q / st (i, ⟨c, h⟩) % 2) % 2 : ℕ) : ℤ) -
      ((q / st (j, ⟨c, h⟩) % 2 : ℕ) : ℤ)) * (st (j, ⟨c, h⟩) : ℤ)
  else 0

end Sum

/-! ## Rows of a stride-`K` family -/

section Rows

/-- Start of the field of row `r`. -/
def sR (K f e r : ℕ) : ℕ := e - K * (f * (r + 1) - 1) - e % K

variable {K m k e : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ}

end Rows

end NLogN.KFR

end

