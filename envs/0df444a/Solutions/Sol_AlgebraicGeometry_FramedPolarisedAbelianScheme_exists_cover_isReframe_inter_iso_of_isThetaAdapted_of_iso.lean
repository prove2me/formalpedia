theorem H12_iso_of_isReframe_smul
    {g N n : ℕ} {S : Type} [CommRing S] (X X₁ X₂ : FramedPolarisedAbelianScheme g N n S)
    (M : Matrix (Fin (N + 1)) (Fin (N + 1)) S) (u : S) (hu : IsUnit u)
    (h₁ : X.IsReframe M X₁) (h₂ : X.IsReframe (u • M) X₂) :
    FramedPolarisedAbelianScheme.Iso X₂ X₁ := by
  obtain ⟨P₁, h₁₁, h₁₂, rfl, hσ₁⟩ := h₁
  obtain ⟨P₂, h₂₁, h₂₂, rfl, hσ₂⟩ := h₂
  have hσ : ∀ i, P₂.σ i =
      ((X.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of S)).inv.hom u)) • P₁.σ i := by
    intro i
    rw [hσ₂ i, hσ₁ i, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Matrix.smul_apply, smul_eq_mul, map_mul, map_mul, smul_smul]
  exact AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_mk_of_iso_of_forall_sigma_eq_smul
    (⟨X.toPolarisedAbelianScheme, P₁, h₁₁, h₁₂⟩ : FramedPolarisedAbelianScheme g N n S)
    ⟨X.toPolarisedAbelianScheme, P₁, h₁₁, h₁₂⟩
    (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_refl _) P₂ h₂₁ h₂₂ _ ((hu.map _).map _) hσ

end K79CL7

