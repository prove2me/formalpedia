  | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.cost, cost_congr a (fun i hi => h i (Or.inl hi)),
      cost_congr b (fun i hi => h i (Or.inr hi)), eval_congr a (fun i hi => h i (Or.inl hi)),
