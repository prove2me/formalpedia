    I.he₁_nat I.H₂ I.e₂ I.he₂_mul I.he₂_nat q₀ hq₀'.2).elim fun j₀ hj₀ => ?_
  have hjq₀ := hj₀.1
  have hquad := TorsionTowerGlue.hquad_of_heads M p hpM I.L I.hJ I.pts I.hpts_gal I.uH I.A I.hA I.hred I.σA
    I.ptsA I.ptsSp I.hptsA I.hSp I.hagree I.σ I.hσ I.huH_pts I.H₁ I.H₂ I.e₂ I.he₂_mul I.he₂_nat I.t₂ I.ht₂
    q₀ j₀ hjq₀
  refine ⟨H, _iH, _iHH, hHfin, hHflat, hHfree, hHcocomm, e', he'_add, ?_, ?_, φ', hφ'_aug, ?_, Tc, hTc, ?_⟩
  · intro σ f g hfg
    exact (congrArg Subtype.val (he'_gal σ f g hfg)).trans (RK2DAssembly.coe_galois_smul_vnil M p σ (e' f))
