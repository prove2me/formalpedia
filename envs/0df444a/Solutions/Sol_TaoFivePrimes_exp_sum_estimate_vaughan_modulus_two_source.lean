theorem two_unit_distance_le_abs_sin_pi (beta : ℝ) :
    2 * ‖((beta : ℝ) : AddCircle (1 : ℝ))‖ ≤
      |Real.sin (Real.pi * beta)| := by
  let k : ℤ := round beta
  let t : ℝ := beta - (k : ℝ)
  have ht : |t| ≤ 1 / 2 := by
    simpa [t, k] using (abs_sub_round beta)
  have harg : |Real.pi * t| ≤ Real.pi / 2 := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    exact (mul_le_mul_of_nonneg_left ht Real.pi_pos.le).trans_eq (by ring)
  have hJordan := Real.mul_abs_le_abs_sin harg
  have hJordan' : 2 * |t| ≤ |Real.sin (Real.pi * t)| := by
    calc
      2 * |t| = 2 / Real.pi * (Real.pi * |t|) := by
        field_simp
      _ = 2 / Real.pi * |Real.pi * t| := by
        rw [abs_mul, abs_of_pos Real.pi_pos]
      _ ≤ |Real.sin (Real.pi * t)| := hJordan
  have hperiod :
      |Real.sin (Real.pi * beta)| = |Real.sin (Real.pi * t)| := by
    have hbeta : beta = t + (k : ℝ) := by simp [t]
    have hrewrite : Real.pi * beta =
        Real.pi * t + k * Real.pi := by
      rw [hbeta]
      push_cast
      ring
    rw [hrewrite, Real.sin_add_int_mul_pi, abs_mul, abs_zpow,
      abs_neg, abs_one, one_zpow, one_mul]
  rw [AddCircle.norm_eq]
  norm_num
  change 2 * |beta - (round beta : ℝ)| ≤ _
  change 2 * |t| ≤ _
  rw [hperiod]
  exact hJordan'
