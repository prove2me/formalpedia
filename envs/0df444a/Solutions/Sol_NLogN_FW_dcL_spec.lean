    intro W x c hc hdvd
    simp only [kunpack, stdDigits, balConv]
    have hB0 : 0 < B := by omega
    have hx0 := Int.emod_nonneg x hB0.ne'
    have hxB := Int.emod_lt_of_pos x hB0
    have hxd := Int.emod_add_mul_ediv x B
    set e := x % B + c with he
    have hd1 : B ∣ W - e := by
      have h1 : B ∣ W - (x + c) := dvd_trans (dvd_pow_self B (by omega)) hdvd
      have h3 : B ∣ B * (x / B) := dvd_mul_right _ _
      have := dvd_add h1 h3
      rw [show W - (x + c) + B * (x / B) = W - e by linear_combination he + hxd] at this
