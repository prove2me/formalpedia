variable {K : Type} [Field K] [CharZero K] {G : Type} [Group G] [Fintype G]

theorem PI.Dv.Tr.eS_eps_eS (T : GoodSet K G) (P : Pair K G) (s t : T.S) :
    eS T t * (eps P * eS T s) = if s = t then eps P * eS T s else 0 := by sorry
