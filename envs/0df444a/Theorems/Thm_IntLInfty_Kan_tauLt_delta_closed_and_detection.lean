-- title:
--   Postnikov piece tau<n is a sub-DGA, and generators are detected modulo lower generators
-- statement:
--   Let $L$ be a non-negatively graded real vector space with an $L_\infty$-structure given by its Chevalley-Eilenberg differential $\delta$ on $C^*(L)$. Then: (1) for every $n$ the subalgebra $A_{\tau_{<n}L}$ generated by the generator system of $\tau_{<n}L$ is $\delta$-closed; (2) for any generator system $S$, if $\delta$ maps every generator of $S$ into $A_S$ then $\delta(A_S)\subseteq A_S$; (3) $C^*(L)^{p+2}\subseteq \mathrm{alg}(L^*_{\le p}) + L^*_{p+1}$; (4) $$\xi\in L^*_{p+1},\ \xi\in \mathrm{alg}(L^*_{\le p})\ \Rightarrow\ \xi=0;$$ (5) the product map $L^*_0\otimes L^*_{p+1}\to C^*(L)$, $a\otimes c\mapsto a\,c$, is injective modulo $\mathrm{alg}(L^*_{\le p})$.
--
--   Role: the sub-DGA property of the Postnikov pieces $\tau_{<n}L$ and the freeness (detection) facts that the $\tau_{\le n}L$ half of Lemma 5.7 uses.
-- source:
--   Henriques, Integrating L∞-algebras, arXiv:math/0603563v2, https://arxiv.org/abs/math/0603563, Definition 5.6 and proof of Theorem 5.10, p. 16 (sub-DGA property of the Postnikov pieces)

import Mathlib
import Definitions.Def_IntLInfty_Kan_CE

set_option autoImplicit false

open scoped TensorProduct

namespace IntLInfty.Kan

theorem tauLt_delta_closed_and_detection {L : ℕ → Type} [∀ i, AddCommGroup (L i)]
    [∀ i, Module ℝ (L i)] :
    (∀ (δ : LInfty L) (n : ℕ), ∀ x ∈ genAlg L (tauLt δ n), δ.δ x ∈ genAlg L (tauLt δ n)) ∧
    (∀ (δ : LInfty L) (S : GenSys L),
      (∀ (k : ℕ) (ξ : Module.Dual ℝ (L k)), ξ ∈ S k → δ.δ (gen L k ξ) ∈ genAlg L S) →
      ∀ x ∈ genAlg L S, δ.δ x ∈ genAlg L S) ∧
    (∀ p : ℕ, ceDeg L (p + 2) ≤
      Subalgebra.toSubmodule (lowAlg L p) ⊔ LinearMap.range (gen L (p + 1))) ∧
    (∀ (p : ℕ) (c : Module.Dual ℝ (L (p + 1))), gen L (p + 1) c ∈ lowAlg L p → c = 0) ∧
    (∀ (p : ℕ) (t : Module.Dual ℝ (L 0) ⊗[ℝ] Module.Dual ℝ (L (p + 1))),
      TensorProduct.lift (((LinearMap.mul ℝ (CE L)).compl₂ (gen L (p + 1))) ∘ₗ gen L 0) t ∈
        lowAlg L p → t = 0) := by sorry

end IntLInfty.Kan
