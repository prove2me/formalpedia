theorem emodNatural_eq (z : ℤ) (q : ℕ) : _root_.Integration9_9.TM2NativeBodyKernel.emodNatural (z,q)=(z%(q : ℤ)).toNat := by
  by_cases hz : z<0
  · simp only [_root_.Integration9_9.TM2NativeBodyKernel.emodNatural,hz,ite_true]
    conv_rhs => rw [Int.eq_neg_natAbs_of_nonpos hz.le,Int.neg_emod]
    simp only [Int.natAbs_natCast,←Int.natCast_mod]
    by_cases hd : q∣z.natAbs
    · have hi : (q : ℤ)∣(z.natAbs : ℤ) := by exact_mod_cast hd
      simp only [hi,ite_true,Int.toNat_zero,Nat.mod_eq_zero_of_dvd hd]
    · have hi : ¬(q : ℤ)∣(z.natAbs : ℤ) := by exact_mod_cast hd
      have hr : z.natAbs%q≠0 := fun h => hd (Nat.dvd_of_mod_eq_zero h)
      simp only [hi,ite_false,hr,Int.toNat_sub]
  · simp only [_root_.Integration9_9.TM2NativeBodyKernel.emodNatural,hz,ite_false]
    conv_rhs => rw [←Int.natAbs_of_nonneg (le_of_not_gt hz),←Int.natCast_mod]
    rfl



