theorem sum_rot3 (f : Fin n → Fin n → Fin n → ℝ) :
    ∑ x, ∑ y, ∑ z, f x y z = ∑ x, ∑ y, ∑ z, f y z x := by
  symm
  rw [Finset.sum_comm]
