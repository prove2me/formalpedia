abbrev Z := {c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5) // ∃ j, (c.2.val j).val = 0}

def md (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) : Fin 3 :=
  if (c.2.val 0).val = 0 then 1 else if (c.2.val 1).val = 0 then 2 else 0

def Mc (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) : ℕ :=
  m3 5 c.1 c.2 + m3 5 c.1 (complement (htotal3 5 c.1) c.2)

def dv (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) (w : CompleteSplit.CompleteWord 2) : ℕ :=
  (cellDist 5 (md c) c.1 c.2).getD (3 * (w 0).val + (w 1).val) 0

theorem D_dvd (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) : D ∣ Mc c := by
  unfold Mc m3
  exact dvd_add (Dvd.dvd.mul_left (dvd_pow_self D two_ne_zero) _)
    (Dvd.dvd.mul_left (dvd_pow_self D two_ne_zero) _)

theorem mu3_eq (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) (w : CompleteSplit.CompleteWord 2) :
    mu3 5 (md c) c w = Mc c / D * dv c w := by
  show Mc c * dv c w / D = _
  rw [Nat.div_mul_right_comm (D_dvd c)]

def pq (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 5)) (w : CompleteSplit.CompleteWord 2) : ℚ :=
  (dv c w : ℚ) / 10 ^ 12

