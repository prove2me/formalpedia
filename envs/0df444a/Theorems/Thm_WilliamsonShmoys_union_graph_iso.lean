-- title:
--   Solver graph of the union instance is isomorphic to the union of masked copies
-- statement:
--   The graph that the solver sees on $\{0,\dots,kn-1\}$ is isomorphic to the disjoint union of the $k$ masked copies of $G$, via the standard bijection $(c,v)\mapsto cn+v$ (`finProdFinEquiv`).
--
--   Let $n\ge1$, let $G$ be the graph of an edge table $\mathrm{edge}$ on $\{0,\dots,n-1\}$, and let $\ell$ be a level function. Let $m$ and $E$ be numeric encodings with $m(v)=\ell(v)\bmod k$ and $E(v,w)\ge1\iff\mathrm{edge}(v,w)$. Let $G'$ be the graph on $\{0,\dots,kn-1\}$ generated by
--
--   $$x\to y\iff x/n=y/n,\ m(x\bmod n)\ne x/n,\ m(y\bmod n)\ne x/n,\ E(x\bmod n,y\bmod n)\ge1 .$$
--
--   Let $U$ be the graph on $\{0,\dots,k-1\}\times\{0,\dots,n-1\}$ with $(c,v)\sim(c',w)$ iff $c=c'$, $vw\in E(G)$ and $\ell(v)\bmod k\ne c\ne\ell(w)\bmod k$. Then for all $a,b$
--
--   $$G'.\mathrm{Adj}\,(e(a))\,(e(b))\iff U.\mathrm{Adj}\,a\,b,\qquad e=\texttt{finProdFinEquiv}.$$
--
--   With `treewidth_of_equiv_hom` this transfers the tree-width bound for $U$ (Baker's hypothesis) to the solver's input graph. It also transfers independence and optimality of the solver's output back to $U$.
--
--   **Formalization Note.** `finProdFinEquiv (c, v) = v + n * c`; $G$ and $G'$ are built with `SimpleGraph.fromRel`.
-- source:
--   Williamson–Shmoys, The Design of Approximation Algorithms, Sect. 10.2 (shifting technique)

import Mathlib

set_option autoImplicit false
open Classical

theorem WilliamsonShmoys.union_graph_iso {n k : ℕ} (hn : 0 < n) (edge : Fin n → Fin n → Bool) (lvl : Fin n → ℕ)
    (mk : ℕ → ℕ) (eb : ℕ → ℕ → ℕ) (hmk : ∀ v : Fin n, mk v.val = lvl v % k)
    (heb : ∀ v w : Fin n, (1 ≤ eb v.val w.val ↔ edge v w = true)) :
    ∀ a b : Fin k × Fin n,
      (SimpleGraph.fromRel (fun x y : Fin (k * n) => decide (x.val / n = y.val / n ∧ mk (x.val % n) ≠ x.val / n ∧
          mk (y.val % n) ≠ x.val / n ∧ 1 ≤ eb (x.val % n) (y.val % n)) = true)).Adj
        (finProdFinEquiv a) (finProdFinEquiv b) ↔
      (SimpleGraph.fromRel (fun (x y : Fin k × Fin n) => x.1 = y.1 ∧
        (SimpleGraph.fromRel (fun u v => edge u v = true)).Adj x.2 y.2 ∧
        lvl x.2 % k ≠ x.1.val ∧ lvl y.2 % k ≠ x.1.val)).Adj a b := by sorry
