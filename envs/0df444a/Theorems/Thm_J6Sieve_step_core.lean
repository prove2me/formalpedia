theorem J6Sieve.step_core (z Ω k m H A : ℕ) (Q : Finset ℕ) (hzΩn : z = 4 * (Ω + 1))
    (hk : z < 2 ^ k) (hmk : m = 4 * k + 3) (hQp : ∀ q ∈ Q, q.Prime)
    (hQz : ∀ q ∈ Q, q ∉ P z) (hQc : Q.card ≤ Ω + 1)
    (hH : 2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1) < H) :
    ∃ n, A < n ∧ n ≤ A + H ∧ rough z n ∧ ∀ q ∈ Q, ¬ q ∣ n := by sorry
