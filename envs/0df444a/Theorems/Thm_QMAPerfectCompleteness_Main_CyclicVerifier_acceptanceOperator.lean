theorem QMAPerfectCompleteness.Main.CyclicVerifier.acceptanceOperator (V : Verifier gatesG2) :
    (compileVerifier V).acceptanceOperator =
      (1-Matrix.blockDiagonal (CertificateMixture.claimRejection V)).submatrix (proofEquiv V) (proofEquiv V) := by sorry
