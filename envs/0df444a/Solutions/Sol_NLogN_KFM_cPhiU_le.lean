    rw [NLogN.KFM.vol_shR]
    have e : ∏ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n), NLogN.KFU.sP (IntMul.OpenAI.Glue.dP n) (NLogN.KFM.srcN n) j = NLogN.KFM.sCmp n := by
      rw [← eS]; exact Finset.prod_congr rfl fun j hj => by simp [NLogN.KFU.sP, Finset.mem_range.1 hj]
    rw [e]; simp [NLogN.KFU.sP]; omega
  have hPM : AModel.vol ((List.range (IntMul.OpenAI.Glue.dP n - 1)).map (NLogN.KFM.srcN n)) ≤ IntMul.OpenAI.Glue.TP n := by
    rw [AModel.vol, NLogN.KFM.prod_map_range]
    have hs : ∀ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n), 1 ≤ NLogN.KFM.srcN n j := fun j hj => by
      have := (NLogN.KFM.src_facts hn j (Finset.mem_range.1 hj)).2.2.1; omega
    have : ∏ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n - 1), NLogN.KFM.srcN n j ≤ ∏ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n), NLogN.KFM.srcN n j := by
      obtain ⟨k, hk⟩ : ∃ k, IntMul.OpenAI.Glue.dP n = k + 1 := ⟨D, hD⟩
