    intro i u hu yκ hy₁ hy₂
    have h := hSW (W i) u hu yκ hy₁ hy₂
    by_cases hF : Psp.IsStrictFst α (θ.toAlgHom.comp α) hα hβ δ (W i)
    · rw [hc0 i hF]; exact h.1 hF
    · rw [hc1 i ((hstrict i).resolve_left hF)]; exact h.2 ((hstrict i).resolve_left hF)

  let m : Fin n → ℤ := fun i => DgD (W i)
  have hsumW : ∀ {γ : Type} [AddCommMonoid γ] (g : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) → γ),
      (∑ i, g (W i)) = ∑ v ∈ DgD.support, g v := by
    intro γ _ g
    rw [← Finset.sum_coe_sort DgD.support g]
    exact Equiv.sum_comp e (fun v : ↥DgD.support => g v.1)

  have hdegκ : ∀ v : Place (ResidueField ↥A) (JHNeronObjectAtP.Fbar p M H hpM (ResidueField ↥A)), v.deg = 1 := fun v =>
    (Place.deg_eq_one_iff_surjective_algebraMap_residueField v).mpr
      ((ModularCurve.JHNeronObjectAtP.hasPrincipalDivisors_and_constantsAreBase_and_surjective_residueField_fbar p M H hpM hpM2 (ResidueField ↥A)).2.2 v)
  have hdegC : ∀ E : Divisor (ResidueField ↥A) (JHNeronObjectAtP.Fbar p M H hpM (ResidueField ↥A)),
