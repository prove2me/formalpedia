-- Source module: NLogNP.School
namespace NLogN

open IntMul

theorem val_append_bit (l : List Bool) (b : Bool) : val (l ++ [b]) = 2 * val l + b.toNat := by
  simp [val, List.foldl_append]

theorem val_eq_wval (l : List Bool) : val l = wval l.reverse := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l b ih => rw [val_append_bit, ih]; simp [wval]; ring

