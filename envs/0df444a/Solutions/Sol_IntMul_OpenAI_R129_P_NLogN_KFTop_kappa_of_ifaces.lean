theorem tBox_eq {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) :
    tBox (D + 1) (ℓP n - 1) (bLn n) = tBD n D := by
