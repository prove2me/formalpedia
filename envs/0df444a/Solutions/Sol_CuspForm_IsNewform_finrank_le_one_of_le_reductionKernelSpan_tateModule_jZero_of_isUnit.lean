private theorem seqπ_mem_of_mem (S : ℕ → AddSubgroup J) (hS : ∀ k, ∀ y ∈ S k, f y ∈ S k)
    (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (hxS : ∀ k, x k ∈ S k) (k : ℕ) :
