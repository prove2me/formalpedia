    intro f hf
    have hc : PowerSeries.constantCoeff f ∈ maximalIdeal O := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hf ⊢
      exact fun h => hf (PowerSeries.isUnit_iff_constantCoeff.mpr h)
    rw [Ideal.mem_comap, ← hker, RingHom.mem_ker, PowerSeries.eq_shift_mul_X_add_const f, map_add, map_mul, map_add, map_mul,
      Adm.apply_eq_zero_of_isNilpotent ρ χ.2.2, mul_zero, zero_add]
    have h1 : χ.1 (PowerSeries.C (PowerSeries.constantCoeff f)) = ψ (PowerSeries.constantCoeff f) := by
      rw [← PowerSeries.algebraMap_eq, ← RingHom.comp_apply, χ.2.1]
    rw [h1, ← RingHom.comp_apply, ρ.2, IsLocalRing.residue_eq_zero_iff]
