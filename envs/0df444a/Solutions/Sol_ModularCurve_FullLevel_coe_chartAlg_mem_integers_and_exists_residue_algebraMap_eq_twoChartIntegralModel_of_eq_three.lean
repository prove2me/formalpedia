theorem j_mem_and_inv_mem (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (O : ValuationSubring ↥(fieldBar q M'))
    (hO : ∀ f : ↥(fieldBar q M'), f ∈ O ↔
      ∃ x y : LaurentSeries ↥A, coeffMap (IsLocalRing.residue ↥A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (j : ↥(fieldBar q M'))
    (hj : j = IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M'))) :
    j ∈ O ∧ j⁻¹ ∈ O := by
  have hjA := coeffMap_subtype_laurentMap_jqInt A
  have hjcoe : (j : LaurentSeries (AlgebraicClosure ℚ)) = coeffEmb (AlgebraicClosure ℚ) jq := by
    rw [hj, IntermediateField.coe_inclusion]
  have hj0 : (j : LaurentSeries (AlgebraicClosure ℚ)) ≠ 0 := by
    rw [hjcoe, ← hjA]
    intro h0
    apply coeffMap_residue_laurentMap_jqInt_ne_zero A
    have h1 := congrArg (fun s : LaurentSeries (AlgebraicClosure ℚ) => s.coeff (-1)) h0
    simp only [coeffMap_coeff, laurentMap_coeff, coeff_jqInt_neg_one, map_one] at h1
    exact absurd (h1.trans (by simp)) one_ne_zero
  refine ⟨(hO _).mpr ⟨laurentMap (Int.castRingHom ↥A) jqInt, 1, by rw [map_one]; exact one_ne_zero,
      by rw [map_one, mul_one, hjA, hjcoe]⟩,
    (hO _).mpr ⟨1, laurentMap (Int.castRingHom ↥A) jqInt, coeffMap_residue_laurentMap_jqInt_ne_zero A, ?_⟩⟩
  rw [map_one, hjA, ← hjcoe]
  push_cast
  exact inv_mul_cancel₀ hj0

theorem exists_layer_const (A : ValuationSubring (AlgebraicClosure ℚ))
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ))
    (hκ : ∀ a : (AlgebraicClosure ℚ), a ∈ A → ∃ c : ↥k₀, (c : (AlgebraicClosure ℚ)) ∈ A ∧ ∃ h : a - c ∈ A, (⟨_, h⟩ : A) ∈ maximalIdeal A)
    (K₁ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))
    (A₁ : ValuationSubring ↥K₁) (hA₁ : ∀ x : ↥K₁, x ∈ A₁ ↔ (x : AlgebraicClosure ℚ) ∈ A)
    (a₀ : ↥A) :
    ∃ i : ↥A₁, ∃ hi : ((i : ↥K₁) : AlgebraicClosure ℚ) ∈ A,
      IsLocalRing.residue ↥A ⟨((i : ↥K₁) : AlgebraicClosure ℚ), hi⟩ = IsLocalRing.residue ↥A a₀ := by
  obtain ⟨c₀, hc₀A, hsub, hmax⟩ := hκ (a₀ : AlgebraicClosure ℚ) a₀.2
  have hcoe : ((algebraMap ↥k₀ ↥K₁ c₀ : ↥K₁) : AlgebraicClosure ℚ) = (c₀ : AlgebraicClosure ℚ) := rfl
  refine ⟨⟨algebraMap ↥k₀ ↥K₁ c₀, (hA₁ _).mpr (hcoe ▸ hc₀A)⟩, hcoe ▸ hc₀A, ?_⟩
  rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
  convert hmax using 2
  all_goals try rfl

end E140CR

