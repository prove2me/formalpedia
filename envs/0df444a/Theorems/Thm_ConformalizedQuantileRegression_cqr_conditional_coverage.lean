-- title:
--   Theorem 1 (proof), eqs. (12)-(14): coverage conditionally on the proper training set
-- statement:
--   Let $(X_i,Y_i)\in\mathbb{R}^p\times\mathbb{R}$, $i=1,\dots,n+1$, be exchangeable. Partition $\{1,\dots,n\}$ into disjoint sets $\mathcal I_1,\mathcal I_2$ with $\mathcal I_1\cup\mathcal I_2=\{1,\dots,n\}$ and $\mathcal I_2\neq\emptyset$, fit $\hat q_{\mathrm{lo}},\hat q_{\mathrm{hi}}$ with a measurable quantile regression algorithm $\mathcal A$ on $\{(X_i,Y_i):i\in\mathcal I_1\}$, let $\alpha\in(0,1)$ and let $C$ be the CQR interval (10)-(11). Then, almost surely,
--
--   $$\mathbb{P}\{Y_{n+1}\in C(X_{n+1})\mid(X_i,Y_i):i\in\mathcal I_1\}\ge1-\alpha.$$
--
--   If moreover the conformity scores $E_i$, $i\in\mathcal I_2\cup\{n+1\}$, are almost surely distinct, then, almost surely,
--
--   $$\mathbb{P}\{Y_{n+1}\in C(X_{n+1})\mid(X_i,Y_i):i\in\mathcal I_1\}\le1-\alpha+\frac{1}{|\mathcal I_2|+1}.$$
--
--   This is the conditional form of Theorem 1 that the paper proves; Theorem 1 follows by taking expectations.
--
--   **Formalization Note** The conditional probability is the conditional expectation of the indicator of the coverage event given the σ-algebra generated by the proper training samples. The split is fixed (deterministic); a random split drawn independently of the data is covered by conditioning on it. The paper's "the conformity scores $E_i$ are almost surely distinct" is read as the scores of the calibration points and the test point, the variables to which Lemma 2 is applied.
-- source:
--   Romano, Patterson and Candès, Conformalized Quantile Regression, arXiv:1905.03222v1 (2019), Section 4, proof of Theorem 1, eqs. (12)-(14), p. 6

import Mathlib
import Definitions.Def_ConformalizedQuantileRegression_Basic

open MeasureTheory ProbabilityTheory

namespace ConformalizedQuantileRegression

theorem cqr_conditional_coverage {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] {p n : ℕ} (Z : Fin (n + 1) → Ω → Sample p) (hZ : IsExchangeable P Z)
    (I₁ I₂ : Finset (Fin n)) (hdisj : Disjoint I₁ I₂) (hsplit : I₁ ∪ I₂ = Finset.univ)
    (hI₂ : I₂.Nonempty) (A : QRAlgorithm p I₁) (hA : IsMeasurableAlgorithm A)
    (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) :
    (∀ᵐ ω ∂P, 1 - α ≤
      (P[Set.indicator {ω' | (Z (Fin.last n) ω').2 ∈
          cqrInterval A I₂ α (fun i => Z i.castSucc ω') (Z (Fin.last n) ω').1} (fun _ => (1 : ℝ)) |
        MeasurableSpace.comap (fun ω' (i : ↥I₁) => Z (Fin.castSucc i.1) ω') inferInstance]) ω) ∧
    ((∀ᵐ ω ∂P, Set.InjOn
        (fun j => conformityScore (fitQR A (fun i => Z i.castSucc ω)).1
          (fitQR A (fun i => Z i.castSucc ω)).2 (Z j ω))
        (↑(I₂.map Fin.castSuccEmb ∪ {Fin.last n}) : Set (Fin (n + 1)))) →
      ∀ᵐ ω ∂P,
        (P[Set.indicator {ω' | (Z (Fin.last n) ω').2 ∈
            cqrInterval A I₂ α (fun i => Z i.castSucc ω') (Z (Fin.last n) ω').1} (fun _ => (1 : ℝ)) |
          MeasurableSpace.comap (fun ω' (i : ↥I₁) => Z (Fin.castSucc i.1) ω') inferInstance]) ω ≤
          1 - α + 1 / ((I₂.card : ℝ) + 1)) := by sorry

end ConformalizedQuantileRegression
