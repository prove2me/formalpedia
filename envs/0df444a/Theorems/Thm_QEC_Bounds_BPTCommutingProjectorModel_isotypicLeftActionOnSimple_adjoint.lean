theorem QEC.Bounds.BPTCommutingProjectorModel.isotypicLeftActionOnSimple_adjoint
    {B : Type u}
    [NormedAddCommGroup B] [InnerProductSpace Complex B] [Semantics.FiniteQuantumSystem B]
    (S : StarSubalgebra Complex (Semantics.Operator B))
    (W : Submodule S B) (operator : S) :
    LinearMap.adjoint (isotypicLeftActionOnSimple S W operator) =
      isotypicLeftActionOnSimple S W (star operator) := by sorry
