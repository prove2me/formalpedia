    (hpu : sh.getD p 0 = 2 ^ u) (hqu : sh.getD q 0 = 2 ^ u)
    (hfD : f NLogN.KFW.dS = (w : ℤ) :: (u : ℤ) :: (p : ℤ) :: (q : ℤ) :: (sh.length : ℤ) ::
