namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

lemma histMS_cons (p : ℕ × ℕ) (h : List (ℕ × ℕ)) :
    histMS (p :: h) = Multiset.replicate p.2 p.1 + histMS h := by
  simp [histMS]

/-- Sum of `g` over the multiset `histMS h` is `∑ n_w g(w)`. -/
lemma histMS_sum_map {M : Type*} [AddCommMonoid M] (h : List (ℕ × ℕ)) (g : ℕ → M) :
    ((histMS h).map g).sum = (h.map fun p => p.2 • g p.1).sum := by
  induction h with
  | nil => simp
  | cons p h ih =>
    rw [histMS_cons, Multiset.map_add, Multiset.sum_add, ih, List.map_cons, List.sum_cons,
      Multiset.map_replicate, Multiset.sum_replicate]

