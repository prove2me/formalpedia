    {L1 L2 L3 : List NLogN.Item} (h1 : t.G NLogN.KFUU.qX = .int (N : ℤ) :: L1)
    (h2 : t.G NLogN.KFUU.qB = .int ((2 * r : ℕ) : ℤ) :: L2) (h3 : t.G NLogN.KFUU.qZ = .int ((2 * r : ℕ) : ℤ) :: L3) :
    NLogN.IRuns I iprog NLogN.KFV.twCU t ((t.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFV.twZ r N sv zs)) ++ R)).upd 14 L14)
      (2000 * NLogN.KFV.cTw N r w) :=
  NLogN.KFV.ISim.runs (NLogN.KFV.sim_tw N r) (NLogN.KFV.nw_twC N r)
    (NLogN.KFUU.pv3 h1 h2 (by rw [show 4 * r - 2 * r = 2 * r by omega]; exact h3))
    (NLogN.KFV.twC_spec N r w hr sv hsv zs hzs hb t R L14 h0 h14)
end
