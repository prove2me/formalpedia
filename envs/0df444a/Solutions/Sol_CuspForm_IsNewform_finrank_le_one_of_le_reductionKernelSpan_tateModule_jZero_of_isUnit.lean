open TensorProduct

namespace OrdConnFit

section Denominators

variable {O : Type} [CommRing O] [IsDomain O] {K : Type} [Field K] [Algebra O K] [IsFractionRing O K]
variable {L : Type} [AddCommGroup L] [Module O L]

omit [IsDomain O] [IsFractionRing O K] in
private theorem algebraMap_smul_one_tmul (d : O) (l : L) :
    algebraMap O K d • ((1 : K) ⊗ₜ[O] l) = (1 : K) ⊗ₜ[O] (d • l) := by
  rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one, Algebra.algebraMap_eq_smul_one,
    TensorProduct.smul_tmul]

private theorem exists_smul_eq_one_tmul (v : K ⊗[O] L) :
    ∃ d : O, d ≠ 0 ∧ ∃ l : L, algebraMap O K d • v = (1 : K) ⊗ₜ[O] l := by
  induction v using TensorProduct.induction_on with
  | zero => exact ⟨1, one_ne_zero, 0, by simp⟩
  | tmul k l =>
    obtain ⟨⟨a, d⟩, h⟩ := IsLocalization.surj (nonZeroDivisors O) k
    refine ⟨d, nonZeroDivisors.ne_zero d.2, a • l, ?_⟩
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_comm, h, Algebra.algebraMap_eq_smul_one,
      TensorProduct.smul_tmul]
  | add v₁ v₂ h₁ h₂ =>
    obtain ⟨d₁, hd₁, l₁, hl₁⟩ := h₁
    obtain ⟨d₂, hd₂, l₂, hl₂⟩ := h₂
    refine ⟨d₁ * d₂, mul_ne_zero hd₁ hd₂, d₂ • l₁ + d₁ • l₂, ?_⟩
    rw [smul_add, map_mul, mul_smul, mul_smul, smul_comm (algebraMap O K d₁) (algebraMap O K d₂) v₁,
      hl₁, hl₂, algebraMap_smul_one_tmul, algebraMap_smul_one_tmul, ← TensorProduct.tmul_add]

omit [IsDomain O] in

private theorem one_tmul_injective [Module.Flat O L] :
    Function.Injective (fun l : L => (1 : K) ⊗ₜ[O] l) := by
  have h : (fun l : L => (1 : K) ⊗ₜ[O] l) =
      (Algebra.linearMap O K).rTensor L ∘ (TensorProduct.lid O L).symm := by
    funext l
    simp [LinearMap.rTensor_tmul]
  rw [h]
  exact (Module.Flat.rTensor_preserves_injective_linearMap _ (IsFractionRing.injective O K)).comp
    (TensorProduct.lid O L).symm.injective

end Denominators

section BaseChangeMap

variable {R : Type} [CommRing R] {A : Type} [CommRing A] [Algebra R A]
variable {M : Type} [AddCommMonoid M] [Module R M]

private theorem map_baseChange_le (f : M →ₗ[R] M) (C : Submodule R M) :
    (C.baseChange A).map (f.baseChange A) ≤ (C.map f).baseChange A := by
  rw [Submodule.map_le_iff_le_comap, Submodule.baseChange_eq_span, Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  simp only [SetLike.mem_coe, Submodule.mem_comap, TensorProduct.mk_apply, LinearMap.baseChange_tmul]
  exact Submodule.tmul_mem_baseChange_of_mem 1 (Submodule.mem_map_of_mem hx)

private theorem baseChange_mem_map_baseChange (f : M →ₗ[R] M) (C : Submodule R M) {v : A ⊗[R] M}
    (hv : v ∈ C.baseChange A) : f.baseChange A v ∈ (C.map f).baseChange A :=
  map_baseChange_le f C (Submodule.mem_map_of_mem hv)

end BaseChangeMap

section MainV

variable {O : Type} [CommRing O] [IsDomain O] [IsNoetherianRing O] [IsLocalRing O]
variable {K : Type} [Field K] [Algebra O K] [IsFractionRing O K]
variable {V : Type} [AddCommGroup V] [Module O V] [Module.Finite O V] [Module.Free O V]

private theorem eq_zero_of_eigen_of_ker (π φ : V →ₗ[O] V)
    (m : ℕ) (r : O) (hr : r ∈ IsLocalRing.maximalIdeal O) (hr0 : r ≠ 0)
    (hnil : ∀ x, π x = 0 → ∃ y, π y = 0 ∧ (φ ^ m) x = r • y) (u : O) (hu : IsUnit u)
    (y : K ⊗[O] V) (hyπ : π.baseChange K y = 0) (hyφ : φ.baseChange K y = algebraMap O K u • y) :
    y = 0 := by
  obtain ⟨d, hd, l, hl⟩ := exists_smul_eq_one_tmul (O := O) (K := K) y
  have hinj := one_tmul_injective (O := O) (K := K) (L := V)

  have hlπ : π l = 0 := by
    apply hinj
    change (1 : K) ⊗ₜ[O] π l = (1 : K) ⊗ₜ[O] (0 : V)
    rw [← LinearMap.baseChange_tmul, ← hl, map_smul, hyπ, smul_zero, TensorProduct.tmul_zero]
  have hlφ : φ l = u • l := by
    apply hinj
    change (1 : K) ⊗ₜ[O] φ l = (1 : K) ⊗ₜ[O] (u • l)
    rw [← LinearMap.baseChange_tmul, ← hl, map_smul, hyφ, smul_comm, hl, algebraMap_smul_one_tmul]
  have hpow : ∀ (n : ℕ) (w : V), φ w = u • w → (φ ^ n) w = u ^ n • w := by
    intro n w hw
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ', Module.End.mul_apply, ih, map_smul, hw, smul_smul, ← pow_succ]
  have hstep : ∀ w : V, π w = 0 → φ w = u • w → ∃ w' : V, π w' = 0 ∧ φ w' = u • w' ∧ w = r • w' := by
    intro w hw hwφ
    obtain ⟨w₁, hw₁, e₁⟩ := hnil w hw
    obtain ⟨v, hv⟩ := hu.pow m
    have e₂ : u ^ m • w = r • w₁ := by rw [← hpow m w hwφ]; exact e₁
    refine ⟨((v⁻¹ : Oˣ) : O) • w₁, by rw [map_smul, hw₁, smul_zero], ?_, ?_⟩
    · have e₃ : r • φ w₁ = r • (u • w₁) := by
        rw [← map_smul, ← e₂, map_smul, hwφ, smul_smul, ← pow_succ, smul_comm, ← e₂, smul_smul,
          ← pow_succ']
      have e₄ : φ w₁ = u • w₁ := smul_right_injective _ hr0 e₃
      rw [map_smul, e₄, smul_comm]
    · rw [smul_comm, ← e₂, smul_smul, ← hv, Units.inv_mul, one_smul]

  have hmem : ∀ j : ℕ, l ∈ ((Ideal.span {r}) ^ j • ⊤ : Submodule O V) := by
    suffices h : ∀ j : ℕ, ∀ w : V, π w = 0 → φ w = u • w →
        w ∈ ((Ideal.span {r}) ^ j • ⊤ : Submodule O V) from
      fun j => h j l hlπ hlφ
    intro j
    induction j with
    | zero =>
      intro w _ _
      rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]
      exact Submodule.mem_top
    | succ j ih =>
      intro w hw hwφ
      obtain ⟨w', hw', hw'φ, rfl⟩ := hstep w hw hwφ
      rw [pow_succ', Submodule.mul_smul]
      exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self _) (ih w' hw' hw'φ)
  have hI : Ideal.span {r} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact fun h => (IsLocalRing.mem_maximalIdeal _).mp hr h
  have hl0 : l = 0 := by
    have : l ∈ (⨅ j : ℕ, (Ideal.span {r}) ^ j • ⊤ : Submodule O V) := (Submodule.mem_iInf _).mpr hmem
    rwa [Ideal.iInf_pow_smul_eq_bot_of_isLocalRing _ hI, Submodule.mem_bot] at this
  have hdy : algebraMap O K d • y = 0 := by rw [hl, hl0, TensorProduct.tmul_zero]
  exact (smul_eq_zero.mp hdy).resolve_left ((map_ne_zero_iff _ (IsFractionRing.injective O K)).mpr hd)

private theorem le_map_baseChange (π φ : V →ₗ[O] V) (hπ : ∀ x, π (π x) = π x)
    (hc : ∀ x, φ (π x) = π (φ x)) (m : ℕ) (r : O) (hr : r ∈ IsLocalRing.maximalIdeal O) (hr0 : r ≠ 0)
    (hnil : ∀ x, π x = 0 → ∃ y, π y = 0 ∧ (φ ^ m) x = r • y) (u : O) (hu : IsUnit u)
    (C : Submodule O V) (E : Submodule K (K ⊗[O] V))
    (hEφ : ∀ e ∈ E, φ.baseChange K e = algebraMap O K u • e) (hEC : E ≤ C.baseChange K) :
    E ≤ (C.map π).baseChange K := by
  intro e he
  have hPP : ∀ v, π.baseChange K (π.baseChange K v) = π.baseChange K v := by
    intro v
    induction v using TensorProduct.induction_on with
    | zero => simp
    | tmul k w => simp only [LinearMap.baseChange_tmul, hπ]
    | add v₁ v₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
  have hFP : ∀ v, φ.baseChange K (π.baseChange K v) = π.baseChange K (φ.baseChange K v) := by
    intro v
    induction v using TensorProduct.induction_on with
    | zero => simp
    | tmul k w => simp only [LinearMap.baseChange_tmul, hc]
    | add v₁ v₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]

  have hy0 : e - π.baseChange K e = 0 := by
    refine eq_zero_of_eigen_of_ker (K := K) π φ m r hr hr0 hnil u hu (e - π.baseChange K e) ?_ ?_
    · rw [map_sub, hPP, sub_self]
    · rw [map_sub, hFP, hEφ e he, map_smul, smul_sub]
  rw [(sub_eq_zero.mp hy0 : e = π.baseChange K e)]
  exact baseChange_mem_map_baseChange (A := K) π C (hEC he)

end MainV

