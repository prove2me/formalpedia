theorem requestRealRow_zsum {d n : ℕ} (r : Fin d → Fin n → ℚ) (a : Fin d → ℤ) :
    requestRealRow (∑ i, a i • r i) = ∑ i, (a i : ℝ) • requestRealRow (r i) := by
  ext j
  change ((∑ i, a i • r i) j : ℝ) = (∑ i, (a i : ℝ) • requestRealRow (r i)).ofLp j
