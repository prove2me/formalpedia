theorem ModularCurve.IgusaScheme.finite_minimalPrimes_tensor_chartAlgInf_mul_and_ncard_eq_two_of_not_dvd
    (N p : ℕ) [NeZero N] [Fact p.Prime] (hpN : ¬ p ∣ N)
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] [Algebra ↥(GaloisRep.ratLocalizedAt p) κ] :
    (minimalPrimes (κ ⊗[↥(GaloisRep.ratLocalizedAt p)] ↥(chartAlgInf (N * p) p))).Finite ∧
    (minimalPrimes (κ ⊗[↥(GaloisRep.ratLocalizedAt p)] ↥(chartAlgInf (N * p) p))).ncard = 2 := by sorry
