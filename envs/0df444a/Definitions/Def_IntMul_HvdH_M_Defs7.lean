namespace NLogN.AX

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp

abbrev bKa : Fin HS := 31
abbrev bKN : Fin HS := 32
abbrev bW3 : Fin HS := 33
