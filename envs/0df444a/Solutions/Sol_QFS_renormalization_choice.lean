/-! ## Step 1 for the choice graph, and the scheme's walks -/

/-! ## Selecting the scale and the centre

The path for a pair `(x, y)` of distinct lattice points is built at the scale `m`
with `Δ^m ≤ ‖x − y‖ < Δ^{m+1}` — which exists because distinct lattice points are
at distance at least `1 = Δ^0` — and around a centre of the index lattice near
`x`. -/

end QFS

open QFS

variable {d : ℕ}

/-- **Proposition 5.14, refined.** The connectivity holds in the graph relative to
a single choice of favored cones, which is what Step 2 needs. -/
theorem solution {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2) {r : ℝ}
    (hr : 0 < r) :
    ∃ R : ℝ, r ≤ R ∧
      ∀ Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d)), QFS.IsBounded Γ ϑ →
      ∀ h ℓ : ℝ, 0 < h → 1 ≤ ℓ → QFS.SparselyPopulated d ϑ h ℓ →
      ∃ W : QFS.ConeChoice d,
        (∀ B, B.Finite → QFS.FavoredIn Γ B (W B)) ∧
        ∀ z ∈ QFS.lattice d, ∀ x ∈ QFS.lattice d, ∀ y ∈ QFS.lattice d,
          ‖x - z‖ ≤ r → ‖y - z‖ ≤ r →
          QFS.ChoiceConn Γ W (QFS.townBall h ℓ z R) (QFS.townIndex h ℓ x) (QFS.townIndex h ℓ y) := by
  classical
  have hϑ2 : (0:ℝ) < ϑ / 2 := by positivity
  have hϑ2' : ϑ / 2 ≤ π / 2 := by linarith [pi_pos]
  obtain ⟨R, hRr, hRprop⟩ :=
    QFS.discrete_template (d := d) (ϑ := ϑ / 2) hϑ2 hϑ2' (show (0:ℝ) < r + 1 by linarith)
  refine ⟨R, by linarith, ?_⟩
  intro Γ hΓ h ℓ hh hℓ hsp
  have hℓ0 : (0:ℝ) < ℓ := by linarith
  -- one favored cone per block, chosen once and for all
  have hex : ∀ B : Set (EuclideanSpace ℝ (Fin d)), ∃ V : QFS.DCone (EuclideanSpace ℝ (Fin d)),
      (B.Finite → QFS.FavoredIn Γ B V) ∧ (B.Finite → ∀ x ∈ B, ∃ p ∈ B, V = Γ p) := by
    intro B
    by_cases hB : B.Finite
    · obtain ⟨V, hV, hmem⟩ := QFS.exists_favoredIn Γ hB
      exact ⟨V, fun _ => hV, fun _ x hx => hmem ⟨x, hx⟩⟩
    · exact ⟨Γ 0, fun hc => absurd hc hB, fun hc => absurd hc hB⟩
  choose W hWfav hWmem using hex
  refine ⟨W, hWfav, ?_⟩
  intro z hz x hx y hy hxz hyz
  have hblkfin : ∀ p : EuclideanSpace ℝ (Fin d), (QFS.townIndex h ℓ p).Finite :=
    fun p => QFS.block_finite hℓ0.le (h • p)
  -- the induced `ϑ/2`-configuration on the index lattice
  set Γ' : QFS.Configuration (EuclideanSpace ℝ (Fin d)) :=
    fun p => ⟨(W (QFS.townIndex h ℓ p)).axis, (W (QFS.townIndex h ℓ p)).norm_axis, ϑ / 2, hϑ2, hϑ2'⟩
    with hΓ'
  have hΓ'b : QFS.IsBounded Γ' (ϑ / 2) := ⟨hϑ2, fun p => le_refl _⟩
  -- each edge of `Γ'` becomes an edge of the choice graph
  have hedge : ∀ p q : EuclideanSpace ℝ (Fin d), p ∈ QFS.lattice d → q ∈ QFS.lattice d →
      q ∈ QFS.coneAt Γ' p → QFS.choiceAdj Γ W (QFS.townIndex h ℓ p) (QFS.townIndex h ℓ q) := by
    intro p q hp hq hpq
    have hne : q ≠ p := by
      intro hc
      rw [hc, QFS.mem_coneAt, sub_self] at hpq
      exact (Γ' p).zero_notMem hpq
    refine ⟨QFS.townIndex_ne hϑ hϑ' hh hℓ hsp hp hq (fun hc => hne hc.symm), Or.inl ?_⟩
    intro x' hx' y' hy'
    obtain ⟨p0, hp0Q, hWp⟩ := hWmem _ (hblkfin p) x' hx'
    have hapex : ϑ ≤ (W (QFS.townIndex h ℓ p)).apex := by rw [hWp]; exact hΓ.2 p0
    have hax : ‖(W (QFS.townIndex h ℓ p)).axis‖ = 1 := (W (QFS.townIndex h ℓ p)).norm_axis
    obtain ⟨v, hv1, hvsub, hqp⟩ : ∃ v : EuclideanSpace ℝ (Fin d), ‖v‖ = 1 ∧
        QFS.cone v ϑ ⊆ (W (QFS.townIndex h ℓ p)).carrier ∧ q - p ∈ QFS.cone v (ϑ / 2) := by
      have hmem : q - p ∈ QFS.doubleCone (W (QFS.townIndex h ℓ p)).axis (ϑ / 2) := hpq
      rcases QFS.mem_doubleCone_iff.mp hmem with hc | hc
      · refine ⟨_, hax, fun u hu => ?_, hc⟩
        exact QFS.doubleCone_mono (le_of_lt hϑ) (W (QFS.townIndex h ℓ p)).apex_le_pi hapex
          (Set.mem_union_left _ hu)
      · refine ⟨-(W (QFS.townIndex h ℓ p)).axis, by simp [hax], fun u hu => ?_, ?_⟩
        · have h1 : u ∈ QFS.doubleCone (-(W (QFS.townIndex h ℓ p)).axis) ϑ := Set.mem_union_left _ hu
          rw [QFS.doubleCone_neg] at h1
          exact QFS.doubleCone_mono (le_of_lt hϑ) (W (QFS.townIndex h ℓ p)).apex_le_pi hapex h1
        · rw [QFS.cone_neg]; exact hc
    have hdist : QFS.apexShrinkConst d ϑ * ℓ ≤ ‖h • p - h • q‖ := by
      have h1 : ‖h • p - h • q‖ = h * ‖p - q‖ := by
        rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hh]
      have h2 : 1 ≤ ‖p - q‖ := QFS.one_le_norm_sub_of_lattice hp hq (fun hc => hne hc.symm)
      have h3 : QFS.apexShrinkConst d ϑ * ℓ < h := by
        rw [QFS.SparselyPopulated, lt_div_iff₀ hℓ0] at hsp
        linarith
      have h4 : h ≤ h * ‖p - q‖ := by nlinarith
      linarith
    have hincone : h • q ∈ QFS.shift (QFS.cone v (ϑ / 2)) (h • p) := by
      rw [QFS.mem_shift, ← smul_sub]
      exact QFS.smul_mem_cone hv1 hϑ2 hϑ2' hh hqp
    have hcube := QFS.renormalization_apex_shrink hϑ hϑ' hv1 hℓ0 hdist hincone
    have := Set.mem_iInter₂.mp (hcube hy'.2) x' hx'.2
    rw [QFS.mem_shift] at this ⊢
    exact hvsub this
  -- transfer the paths
  have htrans : ∀ a b : EuclideanSpace ℝ (Fin d),
      QFS.ConnWithin Γ' (ball z R ∩ QFS.lattice d) a b →
      QFS.ChoiceConn Γ W (QFS.townBall h ℓ z R) (QFS.townIndex h ℓ a) (QFS.townIndex h ℓ b) := by
    intro a b hab
    induction hab with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hstep ih =>
        have hmemT : ∀ w ∈ ball z R ∩ QFS.lattice d, QFS.townIndex h ℓ w ∈ QFS.townBall h ℓ z R := by
          rintro w ⟨hwb, hwlat⟩
          refine ⟨w, ⟨hwlat, ?_⟩, rfl⟩
          rw [mem_ball, dist_eq_norm] at hwb
          exact hwb
        refine Relation.ReflTransGen.trans ih (Relation.ReflTransGen.single
          ⟨hmemT _ hstep.1, hmemT _ hstep.2.1, ?_⟩)
        rcases hstep.2.2 with he | he
        · exact hedge _ _ hstep.1.2 hstep.2.1.2 he
        · exact (QFS.choiceAdj_symm Γ W).symm _ _ (hedge _ _ hstep.2.1.2 hstep.1.2 he)
  have hconn := hRprop Γ' hΓ'b z hz
  have hzx := hconn x (by rw [mem_ball, dist_eq_norm]; linarith) hx
  have hzy := hconn y (by rw [mem_ball, dist_eq_norm]; linarith) hy
  refine Relation.ReflTransGen.trans ?_ (htrans _ _ hzy)
  -- symmetry of `ChoiceConn`
  have hsymm : ∀ {A B : Set (EuclideanSpace ℝ (Fin d))},
      QFS.ChoiceConn Γ W (QFS.townBall h ℓ z R) A B → QFS.ChoiceConn Γ W (QFS.townBall h ℓ z R) B A := by
    intro A B hAB
    induction hAB with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hstep ih =>
        exact Relation.ReflTransGen.trans
          (Relation.ReflTransGen.single ⟨hstep.2.1, hstep.1,
            (QFS.choiceAdj_symm Γ W).symm _ _ hstep.2.2⟩) ih
  exact hsymm (htrans _ _ hzx)
