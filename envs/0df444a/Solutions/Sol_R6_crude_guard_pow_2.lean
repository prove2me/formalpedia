/-!
# Round six: the crude depth guard (PR15 REPORT part B, ARCH G1)

`A e` is the coefficient-dependency depth of a `C`-layer of width `e` (OpenAI §5.4).  At width
`e ≥ T` a node is a sequence of at most `s` child invocations, each of width `≤ (m-1)e/m`
(stated as `m * c ≤ (m-1) * e`), plus `E` arithmetic of its own:
`A e ≤ E + Σ_{c ∈ cs} A c`.  Below the threshold `T` the depth is at most `L`.

* `R6.guard_gen`: `A e ≤ (E+L) (2 s^{max 0 (m (log e - log T) + 1)} - 1)` (any `s ≥ 2`).
* `R6.crude_guard`: with `T = d^β`, `L = 8 d^β`, for `e ≤ d`:
  `A e ≤ 2 (E + 8 d^β) s^{1 + m (1-β) log d}`.
* `R6.crude_guard_single`: the same for the one-child form `A e ≤ E + s A ((m-1) e / m)`.
* `R6.crude_guard_pow`: `A e ≤ C₀ d^{β + m(1-β) log s}`, `C₀ = 2 s (E+8)`.
* `R6.crude_guard_C1`, `R6.crude_guard_nat`: `A e ≤ C₀ d^{C1}` for `C1 ≥ 2 + m log s`
  (natural-number form for a guard width `Δ = C₀ d^{C1}`).
* `R6.level_unroll`: the level-indexed form `D (k+1) ≤ E + s D k` (the shape of `KFN.Eb L s`):
  `D k ≤ (E + D 0) (2 s^k - 1)`.

`s ≥ 2` is needed (for `s = 1` the depth is `≈ k E`, not `O(E)`).
-/

namespace R6

open Real

/-- `s^{1 + m(1-β) log d} = s · d^{m(1-β) log s}`. -/
lemma pow_swap (s d X : ℝ) (hs : 0 < s) (hd : 0 < d) :
    s ^ (1 + X * Real.log d) = s * d ^ (X * Real.log s) := by
  rw [Real.rpow_add hs, Real.rpow_one, Real.rpow_def_of_pos hs, Real.rpow_def_of_pos hd]
  congr 2; ring

/-- **Power form**: `A e ≤ C₀ d^{β + m(1-β) log s}`, `C₀ = 2 s (E + 8)`. -/
theorem crude_guard_pow_sol_aux (E : ℝ) (s m : ℕ) (d β : ℝ) (A : ℕ → ℝ) (hm : 2 ≤ m) (hs : 2 ≤ s)
    (hβ : 0 ≤ β ∧ β ≤ 1) (hd : 1 ≤ d) (hE : 0 ≤ E)
    (hrec : ∀ e : ℕ, d ^ β ≤ e → ∃ cs : List ℕ, cs.length ≤ s ∧
      (∀ c ∈ cs, m * c ≤ (m - 1) * e) ∧ A e ≤ E + (cs.map A).sum)
    (hleaf : ∀ e : ℕ, (e : ℝ) < d ^ β → A e ≤ 8 * d ^ β) :
    ∀ e : ℕ, (e : ℝ) ≤ d →
      A e ≤ 2 * s * (E + 8) * d ^ (β + m * (1 - β) * Real.log s) := by
  intro e he
  have hd0 : 0 < d := by linarith
  have hs0 : (0 : ℝ) < s := by exact_mod_cast (by omega : 0 < s)
  have h := crude_guard E s m d β A hm hs hβ hd hE hrec hleaf e he
  rw [pow_swap s d (m * (1 - β)) hs0 hd0] at h
  have hdb : 1 ≤ d ^ β := Real.one_le_rpow hd hβ.1
  have hX : 0 ≤ d ^ ((m : ℝ) * (1 - β) * Real.log s) := (Real.rpow_pos_of_pos hd0 _).le
  rw [Real.rpow_add hd0]
  have hE8 : E + 8 * d ^ β ≤ (E + 8) * d ^ β := by nlinarith
  calc A e ≤ _ := h
    _ = 2 * s * (E + 8 * d ^ β) * d ^ ((m : ℝ) * (1 - β) * Real.log s) := by ring
    _ ≤ 2 * s * ((E + 8) * d ^ β) * d ^ ((m : ℝ) * (1 - β) * Real.log s) := by gcongr
    _ = _ := by ring

end R6

end

theorem solution : type_of% @R6.crude_guard_pow_sol_aux := @R6.crude_guard_pow_sol_aux
