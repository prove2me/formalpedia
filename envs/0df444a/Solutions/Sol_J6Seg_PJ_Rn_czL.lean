namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem frm_trans {A B C : List (Fin HS)} {u w w' : Vr} (h1 : ∀ i ∉ A, w i = u i)
    (h2 : ∀ i ∉ B, w' i = w i) (hA : ∀ i ∈ A, i ∈ C) (hB : ∀ i ∈ B, i ∈ C) :
    ∀ i ∉ C, w' i = u i := fun i hi => by
  rw [h2 i (fun h => hi (hB i h)), h1 i (fun h => hi (hA i h))]

theorem frm_upd {A : List (Fin HS)} {u w : Vr} (h : ∀ i ∉ A, w i = u i) {j : Fin HS} (hj : j ∈ A)
    (a : ℤ) : ∀ i ∉ A, update w j a i = u i := fun i hi => by
  rw [update_of_ne (by rintro rfl; exact hi hj)]; exact h i hi

theorem Fx.frm {Q kk m mw cB : ℕ} {A : List (Fin HS)} {u w : Vr} (h : Fx Q kk m mw cB u)
    (hf : ∀ i ∉ A, w i = u i) (hA : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), j ∉ A) :
    Fx Q kk m mw cB w := h.of (fun j hj => hf j (hA j hj))

theorem StS.upd {m : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {c : Cs} (h : StS m L Mf c) {j : Fin HS}
    (hj : j ≠ 14 ∧ j ≠ 30) (l : List ℤ) : StS m L Mf (update c j l) :=
  ⟨by rw [update_of_ne (Ne.symm hj.1)]; exact h.1, by rw [update_of_ne (Ne.symm hj.2)]; exact h.2⟩

section loops
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **The border scan** of row `r`. -/
theorem Rn.czL_sol_aux {u : Vr} {D : Cs} (hF : Fx Q kk m mw cB u) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W u) {r : ℕ} (h1 : u 1 = r) (hr : r < m)
    (h4 : u 4 = Lg L r) (h3 : u 3 = 0) (hD51 : D 51 = []) (hmW : m + 1 ≤ 2 ^ W) :
    Rn (PJ.forL 51 28 2 czB) u D (fun u' => u' 3 = ((czP m mw cB L Mf r).length : ℤ) ∧
      (∀ i ∉ ([2, 3, 6, 7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update D 41 ((czP m mw cB L Mf r).reverse ++ D 41)) (cFor W m (cCz W m)) := by
  set czk : ℕ → List ℤ := fun k => (List.range k).filterMap (czF m mw cB L Mf r) with hczk
  have hczs : ∀ k, czk (k + 1) = czk k ++ (czF m mw cB L Mf r k).toList := by
    intro k; simp only [hczk, List.range_succ, List.filterMap_append, List.filterMap_cons,
      List.filterMap_nil]
    cases czF m mw cB L Mf r k <;> simp
  have hczl : ∀ k, (czk k).length ≤ k := fun k => by
    simp only [hczk]
    exact (List.length_filterMap_le _ _).trans (by simp)
  have f28 : u 28 = m := hF.2.2.2.2.2
  set Iv : ℕ → Vr → Prop := fun k w =>
    (∀ i ∉ ([2, 3, 6, 7, 8, 29] : List (Fin HS)), w i = u i) ∧ w 3 = ((czk k).length : ℤ) with hIv
  have hmlt : m < 2 ^ W := by omega
  have H := Rn.forL (C := 51) (rN := 28) (ix := 2) (b := czB) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (N := m) (W := W) (Iv := Iv)
    (cf := fun k => update D 41 ((czk k).reverse ++ D 41)) (cb := cCz W m)
    (fun k => by simp [hD51]) hmlt
    (fun k hk w ⟨hfw, hw3⟩ hw2 hbw => by
      set c' := update (update D 41 ((czk k).reverse ++ D 41)) 51 [(m : ℤ) - k]
      have hFw : Fx Q kk m mw cB w := hF.frm hfw (by decide)
      have hS' : StS m L Mf c' := (hS.upd (by decide) _).upd (by decide) _
      have hw1 : w 1 = r := by rw [hfw 1 (by decide), h1]
      have hw4 : w 4 = Lg L r := by rw [hfw 4 (by decide), h4]
      have H1 := Rn.czIs (c := c') hFw hS' hB hLm hbw hw1 hw2 hr hk
      refine Rn.seq H1 (fun w1 ⟨h7, h8, h6, hf1, hb1⟩ => ?_)
      have hw13 : w1 3 = ((czk k).length : ℤ) := by rw [hf1 3 (by decide), hw3]
      have hw12 : w1 2 = k := by rw [hf1 2 (by decide), hw2]
      have hcz : czF m mw cB L Mf r k = if r < m - 1 - k ∧ cB ≤ Lg L (m - 1 - k) then
          some (if bandS mw cB (Lg L r) (Lg L (m - 1 - k)) then Mf r (m - 1 - k) else 0)
          else none := rfl
      refine Rn.iteE (e := E.sub (.r 6) (.k 1)) rfl
        (by simp [E.lb]; exact Nat.one_le_two_pow) hb1 (fun hneg => ?_) (fun hpos => ?_)
      · -- condition false: nothing pushed
        have hc : ¬ (r < m - 1 - k ∧ cB ≤ Lg L (m - 1 - k)) := by
          intro hc; simp only [E.den, h6, if_pos hc] at hneg; omega
        have hk1 : czk (k + 1) = czk k := by rw [hczs, hcz, if_neg hc]; simp
        refine ((Rn.skip w1 c').mono (fun w' e => ?_) le_rfl).congr (by simp only [c', hk1])
        subst e
        refine ⟨⟨frm_upd (frm_trans (C := [2, 3, 6, 7, 8, 29]) hfw hf1 (by decide) (by decide)) (by decide) _, ?_⟩, hw12, hb1⟩
        rw [update_of_ne (by decide), hw13, hk1]
      · -- condition true: push
        have hc : r < m - 1 - k ∧ cB ≤ Lg L (m - 1 - k) := by
          by_contra hc; simp only [E.den, h6, if_neg hc] at hpos; omega
        have hk1 : czk (k + 1) = czk k ++ [if bandS mw cB (Lg L r) (Lg L (m - 1 - k)) then
            Mf r (m - 1 - k) else 0] := by rw [hczs, hcz, if_pos hc]; simp
        have H2 := Rn.czTs (c := c') (Q := Q) (kk := kk) (hF.frm (frm_trans (C := [2, 3, 6, 7, 8, 29]) hfw hf1 (by decide) (by decide)) (by decide))
          hB hb1 (r := r) (q := m - 1 - k) (by rw [hf1 4 (by decide), hw4]) h7 h8 hw13
          (by have := hczl k; omega)
        have hst : update c' 41 ((if bandS mw cB (Lg L r) (Lg L (m - 1 - k)) then
            Mf r (m - 1 - k) else 0) :: c' 41) =
            update (update D 41 ((czk (k + 1)).reverse ++ D 41)) 51 [(m : ℤ) - k] := by
          rw [hk1]; funext j; simp only [c', update_apply]; split_ifs <;> simp_all
        refine (H2.mono (fun w' hw' => ?_) le_rfl).congr hst
        obtain ⟨h3', hf2, hb2⟩ := hw'
        refine ⟨⟨?_, ?_⟩, ?_, hb2⟩
        · exact frm_upd (frm_trans (C := [2, 3, 6, 7, 8, 29])
            (frm_trans (C := [2, 3, 6, 7, 8, 29]) hfw hf1 (by decide) (by decide)) hf2 (by decide)
            (by decide)) (by decide) _
        · rw [update_of_ne (by decide), h3', hk1]; simp
        · rw [hf2 2 (by decide), hw12])
    hv f28 ⟨frm_upd (fun i _ => rfl) (by decide) _, by rw [update_of_ne (by decide), h3]; simp [hczk]⟩
  have e0 : update D 41 ((czk 0).reverse ++ D 41) = D := by
    simp only [hczk, List.range_zero, List.filterMap_nil, List.reverse_nil, List.nil_append]
    exact update_eq_self _ _
  rw [e0] at H
  refine H.mono (fun u' ⟨⟨hf, h3'⟩, _, hb⟩ => ⟨h3', hf, hb⟩) le_rfl

end loops

end J6Seg.PJ

