theorem mem_jZeroTorsion_iff {M : ℕ} [NeZero M] {m : ℕ} {x : JZero M} :
    x ∈ jZeroTorsion M m ↔ m • x = 0 := by
  change x ∈ Submodule.torsionBy ℤ (JZero M) (m : ℤ) ↔ _
  rw [Submodule.mem_torsionBy_iff, natCast_zsmul]

theorem jZeroTorsion_mono {M : ℕ} [NeZero M] {m m' : ℕ} (h : m ∣ m') :
    jZeroTorsion M m ≤ jZeroTorsion M m' := by
  intro x hx
  obtain ⟨k, rfl⟩ := h
  rw [mem_jZeroTorsion_iff] at hx ⊢
  rw [mul_comm, mul_nsmul, smul_comm, hx, smul_zero]

theorem jZeroTorsion_zero {M : ℕ} [NeZero M] : jZeroTorsion M 0 = ⊤ := by
  ext x; simp

