  haveI := hfin k
  rw [seqπ_apply, seqπ_apply, seqπ_apply, ← AddSubgroup.coe_add, ← map_add]
  rfl

private theorem seqπ_sub (x y : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (hy : ∀ k, y k ∈ lvl J p k) (k : ℕ) :
    seqπ p f hfin (x - y) (fun k => (lvl J p k).sub_mem (hx k) (hy k)) k =
      seqπ p f hfin x hx k - seqπ p f hfin y hy k := by
  haveI := hfin k
  rw [seqπ_apply, seqπ_apply, seqπ_apply, ← AddSubgroup.coe_sub, ← map_sub]
  rfl

private theorem seqπ_levelSmul (c : ℕ → ℕ) (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (k : ℕ)
    (hcx : ∀ k, c k • x k ∈ lvl J p k) :
    seqπ p f hfin (fun k => c k • x k) hcx k = c k • seqπ p f hfin x hx k := by
  haveI := hfin k
  rw [seqπ_apply, seqπ_apply, ← AddSubgroup.coe_nsmul, ← map_nsmul]
  rfl

private theorem seqπ_zero_of_eq_zero (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (k : ℕ) (h0 : x k = 0) :
    seqπ p f hfin x hx k = 0 := by
  haveI := hfin k
  rw [seqπ_apply, show (⟨x k, hx k⟩ : lvl J p k) = 0 from Subtype.ext h0, map_zero]
