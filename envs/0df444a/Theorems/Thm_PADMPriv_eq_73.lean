-- Prove2me | Theorems.Thm_PADMPriv_eq_73
-- name    : PADMPriv.eq_73
-- status  : Open
-- author  : @iris
-- created : 2026-11-06T03:10:51.614316+00:00
-- url     : https://prove2.me/theorems/46174e5d-cfc8-4600-b48d-bc5b4411344a
-- title:
--   Eq. (73) — $\mathbb E\|\tilde u_{(K)}-u_\star\|_2^2\le 4\|\tilde u_{(0)}-u_\star\|_2^2/(en)^2+8L^2/(\varrho_g\beta\omega_A)+2\beta\delta^2/\varrho_g$
-- statement:
--   Assume: $A$, $B$ have full row rank and $m\ge1$; $(R,P_R)$ is a probability space and $f:\mathbb R^p\times R\to\mathbb R$ is such that each $f(\cdot,d)$ is convex, differentiable and $L$-Lipschitz (Proposition 4.1), each $f(x,\cdot)$ is measurable and integrable, and $F(x)=\mathbb E_d f(x,d)$; the samplewise recovery condition $f(VAx,d)\le f(x,d)$ for all $x$ and $P_R$-a.e. $d$ (25) holds; $g$ is convex and $B$-induced $\varrho_g$-strongly convex.
--   Let $n\ge 8\ln(en)$, $\beta=\varrho_g n/(8\ln(en))$, let the noise vectors be i.i.d. with a law $P_z$ on $\mathbb R^m$ of mean zero and $\mathbb E\|z\|_2^2=\delta^2$, independent of the i.i.d. records, and let $K$ be uniform on $\{\lfloor n/2\rfloor+1,\dots,n\}$, independent of both. Let $u_\star$ be the fixed point of $T_F$ and $\tilde u_{(0)}=A\tilde x_{(0)}$. Then $\|\tilde u_{(K)}-u_\star\|_2^2$ is integrable and
--   $$
--   \mathbb E\big(\|\tilde u_{(K)}-u_\star\|_2^2\,\big|\,\Gamma_0\big)\le\frac{4\|\tilde u_{(0)}-u_\star\|_2^2}{(en)^2}+\frac{8L^2}{\varrho_g\beta\omega_A}+\frac{2\beta\delta^2}{\varrho_g}. \tag{73}
--   $$
--
--   This is the core utility estimate of the paper: initial error, sample variation and privacy noise, each made explicit.
--
--   **Formalization Note** The expectation is over the joint law of data, noise and $K$. $\ln(en)$ is the natural logarithm of $e\cdot n$. The proximal problems (13) for every $f(\cdot,d)$ and for $g$ are assumed to have minimizers.
--
--   Differences from the source:
--   - encoding: E[· | Γ₀] → plain expectation over the joint law of data, noise and K; reason: Γ₀ is generated by the deterministic ũ₍₀₎ = A x̃₍₀₎, so it is trivial
--   - generalization: the bound on the conditional expectation → also concludes that ‖ũ₍K₎ − u⋆‖₂² is integrable; reason: the proof establishes it; it rules out a junk integral
--   - encoding: u⋆ the unique fixed point of T_F → any u⋆ with T_F(u⋆) = u⋆; reason: T_F is a contraction (Proposition 5.1), so the fixed point is unique; same instances
--   - encoding: F(x) := E_{d∼P_R}[f(x, d)] → f(x, ·) measurable and P_R-integrable for every x; reason: needed for the expectation to be defined; excludes only undefined cases
--   - encoding: ω_A > 0 the smallest eigenvalue of AAᵀ → hypothesis 0 < m; reason: ω_A is undefined for m = 0
--   - encoding: sample horizon n with n ≥ 8 ln(en) → n ≥ 1 together with n ≥ 8 ln(en); reason: at n = 0 Lean's ln(0) is 0 and the window is empty; n ≥ 1 is implicit
--   - encoding: the sample proximal operators P_{β,f(·,d),A} used as everywhere defined → hypothesis that (13) for f(·,d) has a minimizer for every record d and input u; reason: Algorithm 1 is undefined otherwise; excludes only undefined cases
--   - encoding: P_{β,g,B} used as everywhere defined → hypothesis that (13) for g has a minimizer at every input; reason: T_{f_k} is undefined otherwise; excludes only undefined cases
-- source:
--   Li–Lai–Weng, Exact Feasibility and Privacy Amplification for Linearly Constrained Optimization, STOC 2027 submission (manuscript sha256 d58edbe0…0f3d), A.14, Eq. (73), p.33 (proof of Theorem 5.2)

import Mathlib
import Definitions.Def_PADMPriv_padmIter
import Definitions.Def_PADMPriv_jointLaw
import Definitions.Def_PADMPriv_popLoss
import Definitions.Def_PADMPriv_pinvRight
import Definitions.Def_PADMPriv_omegaA
import Definitions.Def_PADMPriv_IsInducedStronglyConvex

namespace PADMPriv

open MeasureTheory

/-- A.14, Eq. (73) of Li–Lai–Weng, *Exact Feasibility and Privacy Amplification for Linearly Constrained Optimization*, STOC 2027 submission manuscript (sha256 d58edbe0…0f3d), p.33 (proof of Theorem 5.2): under the hypotheses of
Theorem 5.2 other than the privacy parameters, with independent mean-zero noise
`E‖z₍ₖ₎‖₂² = δ²`, `n ≥ 8 ln(en)`, `β = ϱ_g n/(8 ln(en))` and `K` uniform on `{⌊n/2⌋ + 1, …, n}`,
`E‖ũ₍K₎ − u⋆‖₂² ≤ 4‖ũ₍₀₎ − u⋆‖₂²/(en)² + 8L²/(ϱ_g β ω_A) + 2βδ²/ϱ_g`, where `u⋆` is the fixed point of
`T_F` and `ũ₍₀₎ = A x̃₍₀₎`.

**Formalization Note** The expectation is over the joint law `jointLaw`: records i.i.d. `P_R`,
noise i.i.d. `P_z` (a probability measure on `ℝᵐ` with `∫ z dP_z = 0`, `‖z‖²` integrable,
`∫ ‖z‖² dP_z = δ²`), `K` uniform, all independent. The paper's `E[· | Γ₀]` is a plain expectation:
`Γ₀` is generated by the deterministic `ũ₍₀₎ = A x̃₍₀₎`. The integrand is shown integrable. `n ≥ 1`
(`ln(e·0)` would be the junk `0`); `ln(en)` is `Real.log (Real.exp 1 * n)`. Other conventions as in
`eq_71`. -/
theorem eq_73 {m p l : ℕ} {R : Type*} [MeasurableSpace R]
    (hm : 0 < m) (A : Matrix (Fin m) (Fin p) ℝ) (B : Matrix (Fin m) (Fin l) ℝ)
    (c : EuclideanSpace ℝ (Fin m)) (hA : A.rank = m) (hB : B.rank = m)
    (PR : Measure R) [IsProbabilityMeasure PR]
    (f : EuclideanSpace ℝ (Fin p) → R → ℝ) (L : NNReal)
    (hfconv : ∀ d, ConvexOn ℝ Set.univ (fun x => f x d))
    (hfdiff : ∀ d, Differentiable ℝ (fun x => f x d))
    (hfLip : ∀ d, LipschitzWith L (fun x => f x d))
    (hfmeas : ∀ x, Measurable (fun d => f x d)) (hfint : ∀ x, Integrable (fun d => f x d) PR)
    (hrec : ∀ x, ∀ᵐ d ∂PR,
      f (Matrix.toEuclideanLin (pinvRight A) (Matrix.toEuclideanLin A x)) d ≤ f x d)
    (g : EuclideanSpace ℝ (Fin l) → ℝ) (hg : ConvexOn ℝ Set.univ g) (ϱg : ℝ)
    (hgsc : IsInducedStronglyConvex B ϱg g)
    (n : ℕ) (hn : 1 ≤ n) (hnlog : 8 * Real.log (Real.exp 1 * n) ≤ n) (β : ℝ)
    (hβdef : β = ϱg * n / (8 * Real.log (Real.exp 1 * n)))
    (hfprox : ∀ d u, ∃ x, IsProxMin β (fun x => f x d) A u x)
    (hgprox : ∀ v, ∃ y, IsProxMin β g B v y)
    (Pz : Measure (EuclideanSpace ℝ (Fin m))) [IsProbabilityMeasure Pz]
    (hz2 : Integrable (fun z => ‖z‖ ^ 2) Pz) (hzmean : ∫ z, z ∂Pz = 0) (δ : ℝ)
    (hδ : ∫ z, ‖z‖ ^ 2 ∂Pz = δ ^ 2) (x₀ : EuclideanSpace ℝ (Fin p))
    (ustar : EuclideanSpace ℝ (Fin m)) (hustar : padmOp β (popLoss f PR) g A B c ustar = ustar) :
    Integrable (fun ω : ((Fin n → R) × (Fin n → EuclideanSpace ℝ (Fin m))) × ℕ =>
        ‖padmIter β f g A B c x₀ ω.1.1 ω.1.2 ω.2 - ustar‖ ^ 2) (jointLaw n PR Pz) ∧
      ∫ ω, ‖padmIter β f g A B c x₀ ω.1.1 ω.1.2 ω.2 - ustar‖ ^ 2 ∂(jointLaw n PR Pz) ≤
        4 * ‖Matrix.toEuclideanLin A x₀ - ustar‖ ^ 2 / (Real.exp 1 * n) ^ 2 +
          8 * (L : ℝ) ^ 2 / (ϱg * β * omegaA A) + 2 * β * δ ^ 2 / ϱg := by sorry

end PADMPriv
