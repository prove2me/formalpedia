  {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of K)} (L₀ : RelativeGroupLaw K f₀)
  (g : A ⟶ A₀) (hg : IsPullback g fA f₀ (Spec.map (CommRingCat.ofHom ι)))

def rebase (f : A₀ ⟶ Spec (CommRingCat.of K)) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of K)} (h : t₁ = t₂)
    (P : SchemeHomOver t₁ f) : SchemeHomOver t₂ f := ⟨P.1, P.2.trans h⟩

theorem rebase_mul {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of K)} (h : t₁ = t₂)
    (P Q : SchemeHomOver t₁ f₀) : rebase f₀ h (L₀.mul t₁ P Q) = L₀.mul t₂ (rebase f₀ h P) (rebase f₀ h Q) := by
  subst h; rfl

def push {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (Q : SchemeHomOver t' fA) : SchemeHomOver t₀ f₀ :=
  ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2, ht]⟩

@[scoped simp] theorem push_coe {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (Q : SchemeHomOver t' fA) : (push ι g hg ht Q).1 = Q.1 ≫ g := rfl

private noncomputable def _root_.QMValExtDVR.lift {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (P : SchemeHomOver t₀ f₀) : SchemeHomOver t' fA :=
  ⟨hg.lift P.1 t' (by rw [P.2, ht]), hg.lift_snd _ _ _⟩

p2m_export "QMValExtDVR" "lift"
theorem lift_coe_g {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (P : SchemeHomOver t₀ f₀) : (lift ι g hg ht P).1 ≫ g = P.1 :=
  hg.lift_fst _ _ _

theorem push_lift {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (P : SchemeHomOver t₀ f₀) :
    push ι g hg ht (lift ι g hg ht P) = P :=
  Subtype.ext (lift_coe_g ι g hg ht P)

theorem lift_push {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (Q : SchemeHomOver t' fA) :
    lift ι g hg ht (push ι g hg ht Q) = Q := by
  apply Subtype.ext
  apply hg.hom_ext
  · rw [lift_coe_g]; rfl
  · rw [(lift ι g hg ht (push ι g hg ht Q)).2, Q.2]

theorem lift_injective {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) : Function.Injective (lift ι g hg ht (fA := fA) (f₀ := f₀)) :=
  fun P Q h => by rw [← push_lift ι g hg ht P, ← push_lift ι g hg ht Q, h]

variable
  (hg_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of Ω)) (P Q : SchemeHomOver t' fA),
      (LA.mul t' P Q).1 ≫ g =
        (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom ι))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)

include hg_mul in
theorem push_mul {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (P Q : SchemeHomOver t' fA) :
    push ι g hg ht (LA.mul t' P Q) = L₀.mul t₀ (push ι g hg ht P) (push ι g hg ht Q) := by
  apply Subtype.ext
  change (LA.mul t' P Q).1 ≫ g = _
  rw [hg_mul]
  exact congrArg Subtype.val (rebase_mul L₀ ht _ _)

include hg_mul in
theorem lift_mul {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) (P Q : SchemeHomOver t₀ f₀) :
    lift ι g hg ht (L₀.mul t₀ P Q) = LA.mul t' (lift ι g hg ht P) (lift ι g hg ht Q) := by
  conv_lhs => rw [← push_lift ι g hg ht P, ← push_lift ι g hg ht Q]
  rw [← push_mul ι LA L₀ g hg hg_mul ht, lift_push]

include hg_mul in
theorem push_one {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) :
    push ι g hg ht (LA.one t') = L₀.one t₀ := by
  have hx : L₀.mul t₀ (push ι g hg ht (LA.one t')) (push ι g hg ht (LA.one t')) = push ι g hg ht (LA.one t') := by
    rw [← push_mul ι LA L₀ g hg hg_mul ht, LA.one_mul]
  calc push ι g hg ht (LA.one t')
      = L₀.mul t₀ (L₀.one t₀) (push ι g hg ht (LA.one t')) := (L₀.one_mul _ _).symm
    _ = L₀.mul t₀ (L₀.mul t₀ (L₀.inv t₀ (push ι g hg ht (LA.one t'))) (push ι g hg ht (LA.one t')))
          (push ι g hg ht (LA.one t')) := by rw [L₀.inv_mul_cancel]
    _ = L₀.mul t₀ (L₀.inv t₀ (push ι g hg ht (LA.one t')))
          (L₀.mul t₀ (push ι g hg ht (LA.one t')) (push ι g hg ht (LA.one t'))) := L₀.mul_assoc _ _ _ _
    _ = L₀.mul t₀ (L₀.inv t₀ (push ι g hg ht (LA.one t'))) (push ι g hg ht (LA.one t')) := by rw [hx]
    _ = L₀.one t₀ := L₀.inv_mul_cancel _ _

include hg_mul in
theorem one_coe_g {T : Scheme.{0}} {t' : T ⟶ Spec (CommRingCat.of Ω)} {t₀ : T ⟶ Spec (CommRingCat.of K)}
    (ht : t' ≫ Spec.map (CommRingCat.ofHom ι) = t₀) : (LA.one t').1 ≫ g = (L₀.one t₀).1 :=
  congrArg Subtype.val (push_one ι LA L₀ g hg hg_mul ht)

end Transport

section Bases

variable {K Ω : Type} [CommRing K] [CommRing Ω] (ι : K →+* Ω)

theorem geomPoint_comp (k : Type) [Field k] (s : Ω →+* k) :
    geomPoint k s ≫ Spec.map (CommRingCat.ofHom ι) = geomPoint k (s.comp ι) := by
  rw [geomPoint, geomPoint, ← Spec.map_comp]; rfl

theorem tangentBase_comp (k : Type) [Field k] (s : Ω →+* k) :
    tangentBase k s ≫ Spec.map (CommRingCat.ofHom ι) = tangentBase k (s.comp ι) := by
  rw [tangentBase, tangentBase, ← Spec.map_comp]; rfl

theorem tangentZero_tangentBase (k : Type) [Field k] (s : Ω →+* k) :
    tangentZero k ≫ tangentBase k s = geomPoint k s := by
  have h : CommRingCat.ofHom ((algebraMap k (DualNumber k)).comp s) ≫
      CommRingCat.ofHom (TrivSqZeroExt.fstHom k k k).toRingHom = CommRingCat.ofHom s := by
    ext r; first | rfl | simp
  rw [tangentZero, tangentBase, geomPoint, ← Spec.map_comp, h]

theorem tangentScale_tangentBase (k : Type) [Field k] (s : Ω →+* k) (c : k) :
    tangentScale k c ≫ tangentBase k s = tangentBase k s := by
  have h : CommRingCat.ofHom ((algebraMap k (DualNumber k)).comp s) ≫
      CommRingCat.ofHom (TrivSqZeroExt.map (R' := k) (c • (LinearMap.id : k →ₗ[k] k))).toRingHom =
      CommRingCat.ofHom ((algebraMap k (DualNumber k)).comp s) := by
    apply CommRingCat.hom_ext
    refine RingHom.ext fun r => ?_
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp, Function.comp_apply,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    exact AlgHom.commutes _ _
  rw [tangentScale, tangentBase, ← Spec.map_comp, h]

end Bases

section TraceTransport

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}

theorem trace_of_square
    {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of S')} (L' : RelativeGroupLaw S' f')
    (act' : ↥Λ → (A' ⟶ A')) (act'_over : ∀ x : ↥Λ, act' x ≫ f' = f')
    (act'_trace : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S' →+* k)
      (V : Type) [AddCommGroup V] [Module k V] [Module.Finite k V] (τ : V → SchemeHomOver (tangentBase k sk) f'),
      Function.Injective τ →
      (∀ P : SchemeHomOver (tangentBase k sk) f', P ∈ Set.range τ ↔ IsTangentVector L' k sk P) →
      (∀ v w : V, τ (v + w) = L'.mul (tangentBase k sk) (τ v) (τ w)) →
      (∀ (c : k) (v : V), (τ (c • v)).1 = tangentScale k c ≫ (τ v).1) →
      ∀ (x : ↥Λ) (Φ : V →ₗ[k] V), (∀ v : V, τ (Φ v) = pushPt (act' x) (act'_over x) (τ v)) →
      ∀ n : ℤ, (x : ℍ[ℚ, a, b]) + Star.star (x : ℍ[ℚ, a, b]) = ((n : ℚ) : ℍ[ℚ, a, b]) →
        LinearMap.trace k V Φ = (n : k))
    {𝒜 : Scheme.{0}} {f : 𝒜 ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    (act : ↥Λ → (𝒜 ⟶ 𝒜)) (act_over : ∀ x : ↥Λ, act x ≫ f = f)
    (g : A' ⟶ 𝒜) (hg : CategoryTheory.IsPullback g f' f (Spec.map (CommRingCat.ofHom φ)))
    (hg_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (x y : SchemeHomOver t' f'),
      (L'.mul t' x y).1 ≫ g =
        (L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨x.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, y.2]⟩).1)
    (hg_act : ∀ x : ↥Λ, act' x ≫ g = g ≫ act x)
    (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k) (s : S' →+* k) (hs : s.comp φ = sk) :
      ∀ (V : Type) [AddCommGroup V] [Module k V] [Module.Finite k V] (τ : V → SchemeHomOver (tangentBase k sk) f),
        Function.Injective τ →
        (∀ P : SchemeHomOver (tangentBase k sk) f, P ∈ Set.range τ ↔ IsTangentVector L k sk P) →
        (∀ v w : V, τ (v + w) = L.mul (tangentBase k sk) (τ v) (τ w)) →
        (∀ (c : k) (v : V), (τ (c • v)).1 = tangentScale k c ≫ (τ v).1) →
        ∀ (m : ↥Λ) (Φ : V →ₗ[k] V), (∀ v : V, τ (Φ v) = pushPt (act m) (act_over m) (τ v)) →
        ∀ n : ℤ, (m : ℍ[ℚ, a, b]) + Star.star (m : ℍ[ℚ, a, b]) = ((n : ℚ) : ℍ[ℚ, a, b]) →
          LinearMap.trace k V Φ = (n : k) := by
  intro V _ _ _ τ hinj hrange hadd hscale m Φ hΦ n hn
  have htb : tangentBase k s ≫ Spec.map (CommRingCat.ofHom φ) = tangentBase k sk := by
    rw [tangentBase_comp, hs]
  have hgp : geomPoint k s ≫ Spec.map (CommRingCat.ofHom φ) = geomPoint k sk := by
    rw [geomPoint_comp, hs]

  let τ' : V → SchemeHomOver (tangentBase k s) f' := fun v => lift φ g hg htb (τ v)
  have hτ'g : ∀ v, (τ' v).1 ≫ g = (τ v).1 := fun v => lift_coe_g φ g hg htb (τ v)
  have hone : (L'.one (geomPoint k s)).1 ≫ g = (L.one (geomPoint k sk)).1 :=
    one_coe_g φ L' L g hg hg_mul hgp
  refine act'_trace k s V τ' ?_ ?_ ?_ ?_ m Φ ?_ n hn
  · exact (lift_injective φ g hg htb).comp hinj
  · intro P
    constructor
    · rintro ⟨v, rfl⟩
      have hv : IsTangentVector L k sk (τ v) := (hrange (τ v)).mp ⟨v, rfl⟩
      change tangentZero k ≫ (τ' v).1 = (L'.one (geomPoint k s)).1
      apply hg.hom_ext
      · rw [Category.assoc, hτ'g, hone]; exact hv
      · rw [Category.assoc, (τ' v).2, (L'.one (geomPoint k s)).2, tangentZero_tangentBase]
    · intro hP
      have hP' : IsTangentVector L k sk (push φ g hg htb P) := by
        change tangentZero k ≫ (P.1 ≫ g) = (L.one (geomPoint k sk)).1
        rw [← Category.assoc, show tangentZero k ≫ P.1 = _ from hP, hone]
      obtain ⟨v, hv⟩ := (hrange _).mpr hP'
      exact ⟨v, by change lift φ g hg htb (τ v) = P; rw [hv, lift_push]⟩
  · intro v w
    change lift φ g hg htb (τ (v + w)) =
      L'.mul _ (lift φ g hg htb (τ v)) (lift φ g hg htb (τ w))
    rw [hadd, lift_mul φ L' L g hg hg_mul htb]
  · intro c v
    apply hg.hom_ext
    · rw [Category.assoc, hτ'g, hτ'g, hscale]
    · rw [Category.assoc, (τ' (c • v)).2, (τ' v).2, tangentScale_tangentBase]
  · intro v
    apply Subtype.ext
    apply hg.hom_ext
    · change (τ' (Φ v)).1 ≫ g = ((τ' v).1 ≫ act' m) ≫ g
      rw [hτ'g, hΦ, Category.assoc, hg_act, ← Category.assoc, hτ'g]; rfl
    · rw [(τ' (Φ v)).2, (pushPt (act' m) (act'_over m) (τ' v)).2]

end TraceTransport

section Main

theorem main
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (β : Fin (2 * 2) → ↥Λ) (hβ : ∀ x : ↥Λ, ∃! c : Fin (2 * 2) → ℤ, x = ∑ j, c j • β j)
    (d m : ℕ) (hm : 3 ≤ m)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪] (K : Type) [Field K] [Algebra 𝒪 K] [IsFractionRing 𝒪 K]
    (hm' : IsUnit ((m : ℕ) : 𝒪))
    (X𝒪 : PolarisedAbelianScheme 2 d m 𝒪) (XK : PolarisedAbelianScheme 2 d m K)
    (hbc : PolarisedAbelianScheme.IsPullback (algebraMap 𝒪 K) X𝒪 XK)
    (sK : QMStructure Λ star β XK) :
    ∃ s𝒪 : QMStructure Λ star β X𝒪, QMStructure.IsPullback (algebraMap 𝒪 K) s𝒪 sK := by
  classical
  obtain ⟨gA, hg, hmul, hP, hpol⟩ := hbc

  obtain ⟨act', act'_over, hcompat, -, act'_hom, act'_one, act'_mul, act'_add⟩ :=
    CerednikDrinfeld.QM.exists_action_comp_eq_comp_of_isPullback_of_abelianSchemePropertyBundle
      (Λ := Λ) X𝒪.L X𝒪.bundle XK.L gA hg hmul sK.act sK.act_over sK.act_hom sK.act_one sK.act_mul sK.act_add

  have act'_trace : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : 𝒪 →+* k)
      (V : Type) [AddCommGroup V] [Module k V] [Module.Finite k V] (τ : V → SchemeHomOver (tangentBase k sk) X𝒪.f),
      Function.Injective τ →
      (∀ P : SchemeHomOver (tangentBase k sk) X𝒪.f, P ∈ Set.range τ ↔ IsTangentVector X𝒪.L k sk P) →
      (∀ v w : V, τ (v + w) = X𝒪.L.mul (tangentBase k sk) (τ v) (τ w)) →
      (∀ (c : k) (v : V), (τ (c • v)).1 = tangentScale k c ≫ (τ v).1) →
      ∀ (x : ↥Λ) (Φ : V →ₗ[k] V), (∀ v : V, τ (Φ v) = pushPt (act' x) (act'_over x) (τ v)) →
      ∀ n : ℤ, (x : ℍ[ℚ, a, b]) + Star.star (x : ℍ[ℚ, a, b]) = ((n : ℚ) : ℍ[ℚ, a, b]) →
        LinearMap.trace k V Φ = (n : k) := by
    refine CerednikDrinfeld.QM.trace_eq_of_smooth_of_isCommutative_of_forall_injective_trace_eq
      X𝒪.L X𝒪.comm X𝒪.bundle.smooth act' act'_over act'_hom ?_
    intro k _ _ sk hsk
    have hs : (IsFractionRing.lift (K := K) hsk).comp (algebraMap 𝒪 K) = sk :=
      RingHom.ext fun x => IsFractionRing.lift_algebraMap hsk x
    exact trace_of_square (algebraMap 𝒪 K) XK.L sK.act sK.act_over sK.act_trace X𝒪.L act' act'_over gA hg hmul
      hcompat k sk (IsFractionRing.lift (K := K) hsk) hs

  have hprop : IsProper X𝒪.f := X𝒪.bundle.proper
  have hE : ValuativeCriterion.Existence X𝒪.f := by
    have h : UniversallyClosed X𝒪.f := inferInstance
    rw [UniversallyClosed.eq_valuativeCriterion] at h
    exact h.1
  have hU : ValuativeCriterion.Uniqueness X𝒪.f := IsSeparated.valuativeCriterion _
  have hsq : CommSq (sK.P.1 ≫ gA) (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K))) X𝒪.f (𝟙 _) :=
    ⟨by rw [Category.assoc, hg.w, ← Category.assoc, sK.P.2, Category.id_comp, Category.comp_id]⟩
  let sq : ValuativeCommSq X𝒪.f :=
    { R := 𝒪, K := K, i₁ := sK.P.1 ≫ gA, i₂ := 𝟙 _, commSq := hsq }
  obtain ⟨l⟩ := (hE sq).exists_lift
  let P𝒪 : SchemeHomOver (𝟙 (Spec (CommRingCat.of 𝒪))) X𝒪.f := ⟨l.l, l.fac_right⟩
  have hP𝒪 : Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ P𝒪.1 = sK.P.1 ≫ gA := l.fac_left

  have level : ∀ j : Fin (2 * 2), pushPt (act' (β j)) (act'_over (β j)) P𝒪 = X𝒪.P j := by
    intro j
    have hsqj : CommSq (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ (X𝒪.P j).1)
        (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K))) X𝒪.f (𝟙 _) :=
      ⟨by rw [Category.assoc, (X𝒪.P j).2]⟩
    let sqj : ValuativeCommSq X𝒪.f :=
      { R := 𝒪, K := K, i₁ := Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ (X𝒪.P j).1, i₂ := 𝟙 _, commSq := hsqj }
    have hfac : Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ (pushPt (act' (β j)) (act'_over (β j)) P𝒪).1 =
        Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ (X𝒪.P j).1 := by
      rw [← hP j, ← sK.level_match j]
      change Spec.map (CommRingCat.ofHom (algebraMap 𝒪 K)) ≫ (P𝒪.1 ≫ act' (β j)) = (sK.P.1 ≫ sK.act (β j)) ≫ gA
      rw [← Category.assoc, hP𝒪, Category.assoc, Category.assoc, hcompat]
    let L₁ : sqj.commSq.LiftStruct :=
      { l := (pushPt (act' (β j)) (act'_over (β j)) P𝒪).1
        fac_left := hfac
        fac_right := (pushPt (act' (β j)) (act'_over (β j)) P𝒪).2 }
    let L₂ : sqj.commSq.LiftStruct :=
      { l := (X𝒪.P j).1
        fac_left := rfl
        fac_right := (X𝒪.P j).2 }
    have hL : L₁ = L₂ := (hU sqj).elim L₁ L₂
    exact Subtype.ext (congrArg CommSq.LiftStruct.l hL)

  obtain ⟨polE, hpolE, hcube⟩ :=
    CerednikDrinfeld.QM.exists_isCanonicalPolData_and_locIsoOnBase_of_isPullback_of_isDiscreteValuationRing hqq' hB Λ hΛ μ hμ star hstar 𝒪 K
      X𝒪.f X𝒪.L X𝒪.comm X𝒪.bundle X𝒪.dim_fibre X𝒪.pol X𝒪.pol_isInvertible
      XK.f XK.L XK.comm XK.bundle XK.dim_fibre XK.pol XK.pol_isInvertible gA hg hmul hpol
      act' act'_over act'_hom act'_one act'_mul act'_add act'_trace
