section
-- Source module: Solutions.KFCPass
/-!
# KFC passes over a mark-delimited accumulator

Stack roles (all below 56, disjoint from the size parameters on `1 … 4`):
`sA` accumulator, `sT` temporary, `sO` output, `(sCB,sDB)` unary counter `B`,
`(sCM,sDM)` counter `M`, `(sCQ,sDQ)` counter `q`, `(sCP,sDP)` counter `P`, `sK, sK2` scratch.

The accumulator holds `encF g 0 n = g 0 ++ ▮ ++ g 1 ++ ▮ ++ …` (groups terminated by marks).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Group lists given by functions -/

theorem encF_succ (f : ℕ → List ℤ) (a n : ℕ) :
    encF f a (n + 1) = ints (f a) ++ .mark :: encF f (a + 1) n := by
  simp [encF, List.range'_succ, enc_cons]

theorem encF_snoc (f : ℕ → List ℤ) (a n : ℕ) :
    encF f a (n + 1) = encF f a n ++ (ints (f (a + n)) ++ [.mark]) := by
  simp [encF, List.range'_concat, enc_append, enc]

theorem encF_snoc_rev (f : ℕ → List ℤ) (n : ℕ) (L : List Item) :
    (encF f 0 (n + 1)).reverse ++ L = .mark :: ints (f n).reverse ++ ((encF f 0 n).reverse ++ L) := by
  rw [encF_snoc]; simp [ints_reverse]

theorem flF_succ (f : ℕ → List ℤ) (a n : ℕ) : flF f a (n + 1) = f a ++ flF f (a + 1) n := by
  simp [flF, List.range'_succ]

theorem flF_snoc (f : ℕ → List ℤ) (a n : ℕ) : flF f a (n + 1) = flF f a n ++ f (a + n) := by
  simp [flF, List.range'_concat]

theorem encF_const_nil (a n : ℕ) : encF (fun _ => []) a n = marks n := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => rw [encF_succ, ih]; rfl

theorem NI_rev_encF (f : ℕ → List ℤ) (n : ℕ) (L : List Item) (hL : NI L) :
    NI ((encF f 0 n).reverse ++ L) := by
  rcases n with _ | n
  · simpa using hL
  · rw [encF_snoc_rev]; exact NI_mark _

theorem bnd_flF {w : ℕ} {f : ℕ → List ℤ} (h : ∀ i, Bnd w (f i)) (a n : ℕ) : Bnd w (flF f a n) := by
  intro x hx
  simp only [flF, List.mem_flatMap] at hx
  obtain ⟨i, -, hi⟩ := hx; exact h i x hi

theorem length_flF {f : ℕ → List ℤ} {G : ℕ} (h : ∀ i, (f i).length = G) (a n : ℕ) :
    (flF f a n).length = n * G := by
  induction n generalizing a with
  | zero => simp
  | succ n ih => rw [flF_succ, List.length_append, h, ih]; ring

/-! ## Forward zip column: `mvW A T; unmark A; mvB X T CB DB; mark T` -/

/-! ## Moving the groups back: `unmark T; mark A; mvW T A` -/

theorem bcol_runs (s : IState HS) (h : List ℤ) (LT : List Item) (w : ℕ)
    (hT : s.G sT = .mark :: ints h.reverse ++ LT) (hLT : NI LT) (hb : Bnd w h) :
    IRuns I iprog bcol s ((s.upd sT LT).upd sA (ints h ++ .mark :: s.G sA)) (h.length * kap w + 32) := by
  have h1 := IRuns.unmark (I := I) (iprog := iprog) (s := s) (i := sT) (L := ints h.reverse ++ LT) hT
  have h2 := IRuns.mark (I := I) (iprog := iprog) (s := s.upd sT (ints h.reverse ++ LT)) sA
  have h3 := mvW_runs (I := I) (iprog := iprog) (X := sT) (Y := sA) (by decide)
    (((s.upd sT (ints h.reverse ++ LT)).upd sA (.mark :: (s.upd sT (ints h.reverse ++ LT)).G sA)))
    h.reverse LT w (by simp +decide) hLT (fun x hx => hb x (by simpa using hx))
  refine (h1.seq (h2.seq h3)).mono' ?_ ?_
  · ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  · simp only [List.length_reverse]; omega

theorem backB_runs (s : IState HS) (n H w : ℕ) (h : ℕ → List ℤ) (LT LCM LDM : List Item)
    (hT : s.G sT = (encF h 0 n).reverse ++ LT) (hLT : NI LT)
    (hCM : s.G sCM = marks n ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hH : ∀ i, (h i).length ≤ H) (hb : ∀ i, Bnd w (h i)) :
    IRuns I iprog backB s ((s.upd sT LT).upd sA (encF h 0 n ++ s.G sA)) (n * (H * kap w + 96) + 60) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd sT ((encF h 0 (n - k)).reverse ++ LT)).upd sA (encF h (n - k) k ++ s.G sA)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCM) (D := sDM) (by decide) n T LCM LDM
    hLCM hLDM (H * kap w + 32) bcol (by
      intro k hk LC' LD'
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      have hj' : n - (k + 1) = j := by omega
      have HH := bcol_runs (I := I) (iprog := iprog) (cf (T k) sCM sDM LC' LD') (h j)
        ((encF h 0 j).reverse ++ LT) w
        (by simp only [T, cf, IState.upd_G]; simp +decide [hj, encF_snoc_rev, ints_reverse])
        (NI_rev_encF h j LT hLT) (hb j)
      refine HH.mono' ?_ ?_
      · simp only [T, hj', hj]
        ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
        rw [encF_succ]; simp
      · have := hH j; simp only [kap] at *; nlinarith)
  have e0 : cf (T 0) sCM sDM (marks n ++ LCM) LDM = s := by
    simp only [T, Nat.sub_zero, encF_zero, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T n) sCM sDM (marks n ++ LCM) LDM = (s.upd sT LT).upd sA (encF h 0 n ++ s.G sA) := by
    simp only [T, Nat.sub_self, encF_zero, List.reverse_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

