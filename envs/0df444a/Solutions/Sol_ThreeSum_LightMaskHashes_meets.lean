/-!
# Evaluating a whole list of one-hot mask hashes

This wrapper builds the powers table itself, hashes each stored mask, and
writes the raw nonnegative values. It is shared by the local-cover matrix
construction and input-source encoding. The cost is linear in the number
of masks times their width; no evaluation oracle is assumed.
-/

namespace ThreeSum.LightMaskHashes

open Light LightSubsetAddress

set_option maxHeartbeats 1000000



















variable {lim : Limits} {P : Program} {d : ℕ}

theorem meets_sourceProof {pMain pPowers pHash : ℕ}
    (hmain : P[pMain]? = some (body pPowers pHash))
    (hpowers : P[pPowers]? = some powTableBody)
    (hhash : P[pHash]? = some (LightOneHot.body pHash))
    {μ : ℕ → ℤ} {L masks dst n src0 src1 work U : ℕ}
    (mask w0 w1 : ℕ → ℕ)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+L+1 ≤ lim.depth)
    (hspace : work+(L+1) ≤ lim.space)
    (hmasks : masks+n ≤ dst) (hsrc0 : src0+L ≤ dst) (hsrc1 : src1+L ≤ dst)
    (hdst : dst+n ≤ work)
    (hword : (LightOneHot.word L U : ℤ) ≤ lim.word)
    (hmaskRead : ∀ i < n, μ (masks+i) = (mask i : ℤ))
    (hmaskLt : ∀ i < n, mask i < 2^L)
    (hread0 : ∀ i < L, μ (src0+i) = (w0 i : ℤ))
    (hread1 : ∀ i < L, μ (src1+i) = (w1 i : ℤ))
    (hbound0 : ∀ i < L, w0 i ≤ U) (hbound1 : ∀ i < L, w1 i ≤ U) :
    Meets lim P pMain d [L,masks,dst,n,src0,src1,work] μ (time L n)
      (fun _ μ' => (∀ i < n, μ' (dst+i) = (OneHotMask.eval w0 w1 L (mask i) : ℤ)) ∧
        Powers μ' work L ∧ KeptBut μ μ' work dst n) := by
  have hpWord : ((2^(L+1) : ℕ) : ℤ) ≤ lim.word := by
    have hh : 2^(L+1) ≤ LightOneHot.word L U := by unfold LightOneHot.word; omega
    exact (Int.ofNat_le.mpr hh).trans hword
  have htwo : (2 : ℤ) ≤ lim.word := by
    have hh : (2^1 : ℕ) ≤ 2^(L+1) := Nat.pow_le_pow_right (by decide) (by omega)
    exact (by exact_mod_cast hh : (2 : ℤ) ≤ ((2^(L+1) : ℕ) : ℤ)).trans hpWord
  have hvalWord : ((L*U : ℕ) : ℤ) ≤ lim.word := by
    have hh : L*U ≤ LightOneHot.word L U := by
      unfold LightOneHot.word
      exact (Nat.mul_le_mul_right U (Nat.le_succ L)).trans (Nat.le_add_left _ _)
    exact (Int.ofNat_le.mpr hh).trans hword
  apply Meets.of_body hmain
  unfold body time
  have hp := powTable_meets (d := d+1) (μ := μ) (dst := work) (L := L+1) (b := 2)
    hpowers hw hspace (by
      intro j hj
      exact (Int.ofNat_le.mpr (Nat.pow_le_pow_right (by decide) (by omega))).trans hpWord)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (hp _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen hp ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightOneHot.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightOneHot.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightOneHot.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro r μ₁ ⟨hpow, hkept⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  have hpow' : Powers μ₁ work L := powers_of_segment hpow
  unfold loopBody
  refine Ends.for (Inv μ mask w0 w1 L masks dst n src0 src1 work) n (LightOneHot.time L+62)
    ?_ ?_ ?_ ?_
  · refine ⟨r,μ₁,?_,?_,hpow',?_⟩
    · simp [update_frame_setLocal]
    · intro i hi
      omega
    · intro a ⟨ha,hout⟩
      exact hkept a (Or.inl ha)
  · rintro i _ hi _ ⟨r,μ',rfl,written,pows,kept⟩
    have hmr : μ' (masks+i) = (mask i : ℤ) :=
      (kept _ ⟨by omega,Or.inl (by omega)⟩).trans (hmaskRead i hi)
    have h0 : ∀ j < L, μ' (src0+j) = (w0 j : ℤ) := by
      intro j hj
      exact (kept _ ⟨by omega,Or.inl (by omega)⟩).trans (hread0 j hj)
    have h1 : ∀ j < L, μ' (src1+j) = (w1 j : ℤ) := by
      intro j hj
      exact (kept _ ⟨by omega,Or.inl (by omega)⟩).trans (hread1 j hj)
    have he := OneHotMask.eval_le (m := mask i) hbound0 hbound1
    have heWord : (OneHotMask.eval w0 w1 L (mask i) : ℤ) ≤ lim.word :=
      (Int.ofNat_le.mpr he).trans hvalWord
    have hh := LightOneHot.meets (W := L) (powers := work) (src0 := src0) (src1 := src1)
      (U := U) hhash μ' w0 w1 hw hspace (by omega) (by omega) hword pows h0 h1 hbound0 hbound1
      L (mask i) le_rfl (hmaskLt i hi) (d+1) (by omega)
    focus
      ((((first
              | refine Light.Ends.seqSelf ?_
              | refine Light.Ends.skipLast ?_));
          (repeat
              with_unfolding_none
                first
                | refine Light.Ends.seqAssoc ?_
                | refine Light.Ends.skipThen ?_)));
      (first
        | refine Light.Ends.callToThen (hh _ (by omega)) ?_ ?_ ?_ ?_
        | refine Light.Ends.callToThen hh ?_ ?_ ?_ ?_);
      (on_goal -1 =>
          first
          |
            ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                  List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hmr,
                  LightOneHot.time]);
              (first
                | omega
                | ((ring_nf); (omega))))
          | omega
          |
            (simp [hmr, LightOneHot.time] <;>
                first
                | omega
                | ((ring_nf); (omega))));
      (on_goal -1 => omega);
      (on_goal -1 =>
          (((try have := Light.Std.space_le (by assumption)));
            ((try have := Light.Std.const_le (by assumption)));
            (simp [Light.Limits.Addr, abs_le, -abs_mul, hmr, LightOneHot.time] <;>
                omega)));
      (on_goal -1 =>
          ((rintro v μ₂ ⟨hv, hmem⟩);
            (try with_unfolding_none refine Light.Ends.skip ?_)))
    subst μ₂
    focus
      ((((first
              | refine Light.Ends.seqSelf ?_
              | refine Light.Ends.skipLast ?_));
          (repeat
              with_unfolding_none
                first
                | refine Light.Ends.seqAssoc ?_
                | refine Light.Ends.skipThen ?_)));
      (refine
          Light.Ends.storeToThen (dst + i) (OneHotMask.eval w0 w1 L (mask i) : ℕ) ?_
            ?_ ?_);
      (on_goal -1 =>
          first
          |
            ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                  List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hv,
                  LightOneHot.time]);
              (first
                | omega
                | ((ring_nf); (omega))))
          | omega
          |
            (simp [hv, LightOneHot.time] <;>
                first
                | omega
                | ((ring_nf); (omega))));
      (on_goal -1 =>
          (((try have := Light.Std.space_le (by assumption)));
            ((try have := Light.Std.const_le (by assumption)));
            (simp [Light.Limits.Addr, abs_le, -abs_mul, hv, LightOneHot.time] <;>
                omega)));
      (try with_unfolding_none refine Light.Ends.skip ?_)
    refine ⟨by simp,v,Function.update μ' (dst+i) (OneHotMask.eval w0 w1 L (mask i) : ℤ),
      by simp [update_frame_setLocal],?_,?_,?_⟩
    · intro j hj
      rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
      · rw [Function.update_of_ne (by omega)]
        exact written j hj
      · simp
    · intro j hj
      rw [Function.update_of_ne (by omega)]
      exact pows j hj
    · intro a ⟨ha,hout⟩
      rw [Function.update_of_ne (by omega)]
      exact kept a ⟨ha,hout⟩
  · rintro _ _ ⟨r,μ',rfl,written,pows,kept⟩
    exact ⟨written,pows,kept⟩
  · rintro i _ _ _ ⟨r,μ',rfl,_,_,_⟩
    simp


























end ThreeSum.LightMaskHashes

end


theorem solution : ∀ {lim : Light.Limits} {P : Light.Program} {d pMain pPowers pHash : Nat},
  @Eq.{1} (Option.{0} Light.Stmt)
      (@GetElem?.getElem?.{0, 0, 0} Light.Program Nat Light.Stmt
        (fun (as : List.{0} Light.Stmt) (i : Nat) => @LT.lt.{0} Nat instLTNat i (@List.length.{0} Light.Stmt as))
        (@List.instGetElem?NatLtLength.{0} Light.Stmt) P pMain)
      (@Option.some.{0} Light.Stmt (ThreeSum.LightMaskHashes.body pPowers pHash)) →
    @Eq.{1} (Option.{0} Light.Stmt)
        (@GetElem?.getElem?.{0, 0, 0} Light.Program Nat Light.Stmt
          (fun (as : List.{0} Light.Stmt) (i : Nat) => @LT.lt.{0} Nat instLTNat i (@List.length.{0} Light.Stmt as))
          (@List.instGetElem?NatLtLength.{0} Light.Stmt) P pPowers)
        (@Option.some.{0} Light.Stmt Light.powTableBody) →
      @Eq.{1} (Option.{0} Light.Stmt)
          (@GetElem?.getElem?.{0, 0, 0} Light.Program Nat Light.Stmt
            (fun (as : List.{0} Light.Stmt) (i : Nat) => @LT.lt.{0} Nat instLTNat i (@List.length.{0} Light.Stmt as))
            (@List.instGetElem?NatLtLength.{0} Light.Stmt) P pHash)
          (@Option.some.{0} Light.Stmt (ThreeSum.LightOneHot.body pHash)) →
        ∀ {μ : Nat → Int} {L masks dst n src0 src1 work U : Nat} (mask w0 w1 : Nat → Nat),
          @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt lim.space) lim.word →
            @LE.le.{0} Nat instLENat
                (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat)
                  (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) d L)
                  (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
                lim.depth →
              @LE.le.{0} Nat instLENat
                  (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) work
                    (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) L
                      (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
                  lim.space →
                @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) masks n) dst →
                  @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src0 L)
                      dst →
                    @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src1 L)
                        dst →
                      @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) dst n)
                          work →
                        @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LightOneHot.word L U))
                            lim.word →
                          (∀ (i : Nat),
                              @LT.lt.{0} Nat instLTNat i n →
                                @Eq.{1} Int
                                  (μ (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) masks i))
                                  (@Nat.cast.{0} Int instNatCastInt (mask i))) →
                            (∀ (i : Nat),
                                @LT.lt.{0} Nat instLTNat i n →
                                  @LT.lt.{0} Nat instLTNat (mask i)
                                    (@HPow.hPow.{0, 0, 0} Nat Nat Nat
                                      (@instHPow.{0, 0} Nat Nat
                                        (@NPow.toPow.{0} Nat (@Monoid.toNPow.{0} Nat Nat.instMonoid)))
                                      (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) L)) →
                              (∀ (i : Nat),
                                  @LT.lt.{0} Nat instLTNat i L →
                                    @Eq.{1} Int
                                      (μ (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src0 i))
                                      (@Nat.cast.{0} Int instNatCastInt (w0 i))) →
                                (∀ (i : Nat),
                                    @LT.lt.{0} Nat instLTNat i L →
                                      @Eq.{1} Int
                                        (μ (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src1 i))
                                        (@Nat.cast.{0} Int instNatCastInt (w1 i))) →
                                  (∀ (i : Nat), @LT.lt.{0} Nat instLTNat i L → @LE.le.{0} Nat instLENat (w0 i) U) →
                                    (∀ (i : Nat), @LT.lt.{0} Nat instLTNat i L → @LE.le.{0} Nat instLENat (w1 i) U) →
                                      Light.Meets lim P pMain d
                                        (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt L)
                                          (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt masks)
                                            (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt dst)
                                              (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt n)
                                                (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt src0)
                                                  (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt src1)
                                                    (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt work)
                                                      (@List.nil.{0} Int))))))))
                                        μ (ThreeSum.LightMaskHashes.time L n) fun (x : Int) (μ' : Nat → Int) =>
                                        And
                                          (∀ (i : Nat),
                                            @LT.lt.{0} Nat instLTNat i n →
                                              @Eq.{1} Int
                                                (μ'
                                                  (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) dst
                                                    i))
                                                (@Nat.cast.{0} Int instNatCastInt
                                                  (ThreeSum.OneHotMask.eval w0 w1 L (mask i))))
                                          (And (ThreeSum.LightSubsetAddress.Powers μ' work L)
                                            (Light.KeptBut μ μ' work dst n)) := by
  exact @ThreeSum.LightMaskHashes.meets_sourceProof

