  have hi : i < 2 * r := Nat.mod_lt _ (by omega)
  unfold dblGI dbl
  by_cases hir : i < r
  · rw [if_pos hir, dif_pos hir]
    exact h.2 j ⟨i, hir⟩ (by omega)
  · rw [if_neg hir, dif_neg hir, dif_pos hi, toC_neg, h.2 j ⟨i - r, by omega⟩ (by omega)]
