section Moduli

variable (F : Type) [Field F] [NumberField F]

local notation "𝔸" => AdeleRing (𝓞 F) F
local notation "ι" => algebraMap F (AdeleRing (𝓞 F) F)

private def bruhatSum (φ : AdelicGL2 (𝓞 F) F → ℂ) (g : AdelicGL2 (𝓞 F) F) : ℂ :=
  ∑' ξ : F, φ (adelicWeyl (𝓞 F) F * unipotentGL2 (ι ξ) * g)

variable {F}

private theorem bruhatSum_unipotentGL2_add_algebraMap (φ : AdelicGL2 (𝓞 F) F → ℂ) (y : 𝔸) (k₀ : F)
    (g : AdelicGL2 (𝓞 F) F) :
    bruhatSum F φ (unipotentGL2 (ι k₀ + y) * g) = bruhatSum F φ (unipotentGL2 y * g) := by
  unfold bruhatSum
  conv_rhs => rw [← Equiv.tsum_eq (Equiv.addRight k₀)]
  refine tsum_congr fun ξ => ?_
  simp only [Equiv.coe_addRight]
  rw [map_add, unipotentGL2_add (ι ξ), unipotentGL2_add (ι k₀)]
  simp only [mul_assoc]

private theorem apply_unipotentGL2_mul {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (t : 𝔸) (g : AdelicGL2 (𝓞 F) F) :
    φ (unipotentGL2 t * g) = φ g :=
  isInducedSection_unipotent_mul hφ t g

end Moduli
