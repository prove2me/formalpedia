    ∃ j : Fin 7968, codeBox (codeFunctionP9 j.val) d := by
  have hc : fragmentObligations 7968 codeFunctionP9 fragmentContextP9_1043 fragmentTreeP9_1043 := by
    unfold fragmentTreeP9_1043
    apply fragmentComputed_sound
