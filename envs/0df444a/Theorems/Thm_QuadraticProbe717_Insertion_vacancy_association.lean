-- title:
--   Lemma 3.2 — vacancy means and positive association
-- statement:
--   Let $n>0$, $0<\varepsilon<1$, and insert a Poisson number of keys of mean $(1-\varepsilon)n$ using independent uniform hashes and a fixed completion order. For the vacancy indicators $F_i$,
--   $$\forall i\in[n],\quad\mathbb E[F_i]\ge\varepsilon,\qquad (F_i)_{i\in[n]}\text{ is positively associated}.$$
--   Both clauses concern the law generated by the insertion process, rather than a free vector postulated to satisfy the desired properties.
--
--   Differences from the source:
--   - encoding: distinct keys with independent uniform hashes and arbitrary fixed offset completion → insertion-time indices, ZMod n slots, every fixed completion permutation, and exact finite averages; reason: key labels do not affect insertion; repeated quadratic probes and the first empty slot are retained
--   - encoding: Poisson((1−ε)n) insertions including N≥n → the discrete mixture of algorithm-generated occupied-set laws with Poisson rate ((1−ε)n).toNNReal; reason: 0<ε<1 makes the rate exact; full tables remain full and subsequent costs are 2n
-- source:
--   Yang S. Hu, William Kuszmaul, Jingxun Liang, Stefan Walzer, Huacheng Yu, Renfei Zhou, STOC 2027 submission #717 (October 2026), Lemma 3.2, p. 6 (PDF p. 6)

import Definitions.Def_QuadraticProbe717_Insertion_laws

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal

namespace QuadraticProbe717.Insertion

theorem vacancy_association (n : ℕ) [NeZero n] (π : Equiv.Perm (ZMod n))
    (ε : ℝ) (hε : 0 < ε) (hε1 : ε < 1) :
    (∀ i : ZMod n, ε ≤ ∫ A, vacancy n i A ∂poissonState n π (poissonRate n ε)) ∧
    PositivelyAssociated (poissonState n π (poissonRate n ε)) (vacancy n) := by sorry

end QuadraticProbe717.Insertion
