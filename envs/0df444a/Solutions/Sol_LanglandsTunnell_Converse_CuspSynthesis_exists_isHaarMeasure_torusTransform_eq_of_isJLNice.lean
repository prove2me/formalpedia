private theorem t0611 (v : HeightOneSpectrum (𝓞 K)) :
    Continuous (localUnit (𝓞 K) K v : (v.adicCompletion K)ˣ → (FiniteAdeleRing (𝓞 K) K)ˣ) := by
  have hval : ∀ t : (v.adicCompletion K)ˣ,
      ((localUnit (𝓞 K) K v t : (FiniteAdeleRing (𝓞 K) K)ˣ) : FiniteAdeleRing (𝓞 K) K) =
        1 + NumberField.StandardAddChar.finAdeleSingleAt K v ((t : v.adicCompletion K) - 1) := by
    intro t
    refine Subtype.ext (funext fun w => ?_)
    show ((localUnit (𝓞 K) K v t : (FiniteAdeleRing (𝓞 K) K)ˣ) : FiniteAdeleRing (𝓞 K) K) w =
      1 + NumberField.StandardAddChar.finAdeleSingleAt K v ((t : v.adicCompletion K) - 1) w
    by_cases hw : w = v
    · subst hw
      rw [localUnit_apply_self, NumberField.StandardAddChar.finAdeleSingleAt_apply_self]
      ring
    · rw [localUnit_apply_of_ne (hw := hw) .., NumberField.StandardAddChar.finAdeleSingleAt_apply_of_ne K v _ hw,
        add_zero]
  have hsingle : Continuous fun x : v.adicCompletion K =>
      (1 : FiniteAdeleRing (𝓞 K) K) + NumberField.StandardAddChar.finAdeleSingleAt K v (x - 1) :=
    continuous_const.add ((NumberField.StandardAddChar.continuous_finAdeleSingleAt K v).comp
      (continuous_id.sub continuous_const))
  rw [Units.continuous_iff]
  constructor
  · have h : (fun t : (v.adicCompletion K)ˣ =>
          ((localUnit (𝓞 K) K v t : (FiniteAdeleRing (𝓞 K) K)ˣ) : FiniteAdeleRing (𝓞 K) K)) =
        fun t : (v.adicCompletion K)ˣ =>
          1 + NumberField.StandardAddChar.finAdeleSingleAt K v ((t : v.adicCompletion K) - 1) :=
      funext hval
    show Continuous fun t : (v.adicCompletion K)ˣ =>
      ((localUnit (𝓞 K) K v t : (FiniteAdeleRing (𝓞 K) K)ˣ) : FiniteAdeleRing (𝓞 K) K)
    rw [h]
    exact hsingle.comp Units.continuous_val
  · have h : (fun t : (v.adicCompletion K)ˣ =>
          (((localUnit (𝓞 K) K v t)⁻¹ : (FiniteAdeleRing (𝓞 K) K)ˣ) : FiniteAdeleRing (𝓞 K) K)) =
        fun t : (v.adicCompletion K)ˣ =>
          1 + NumberField.StandardAddChar.finAdeleSingleAt K v
            (((t⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) - 1) := by
      funext t
      rw [← map_inv]
      exact hval t⁻¹
    rw [h]
    exact hsingle.comp (Units.continuous_val.comp continuous_inv)

