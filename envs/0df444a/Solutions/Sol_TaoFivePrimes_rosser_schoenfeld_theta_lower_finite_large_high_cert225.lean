  | nil =>
    intro m c e h hP
    simp only [walk, Bool.and_eq_true] at h
    obtain ⟨⟨⟨hm, hcN⟩, hs⟩, hf⟩ := h
    have hm' := Nat.le_of_ble_eq_true hm
    have hcN' := Nat.le_of_ble_eq_true hcN
    refine ⟨cover_sound C c _ N lo hs (log_lb C Y c m e hY hY0 hm' hP), ?_⟩
    exact finOK_sound C Cb m e j bb Y N hf hY hY0 hm' (le_trans hP (primorial_mono hcN'))
  | cons st l ih =>
    obtain ⟨de, G⟩ := st
    intro m c e h hP
    simp only [walk, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨hm, hs⟩, hg⟩, hr⟩, hw⟩ := h
    have hm' := Nat.le_of_ble_eq_true hm
    have hg' := Nat.eq_of_beq_eq_true hg
    have hr' := Nat.le_of_ble_eq_true hr
    have hθ := log_lb C Y c m e hY hY0 hm' hP
    have hcov := cover_sound C c _ _ lo hs hθ
    have hd := dec_le (m * 2 ^ e * Y) 100000 1 c G (by rw [one_mul]; exact hP)
      (pool_prime _ _ hg' hr')
    have hd' : Nat.mul m (dec 1 c G 100000).1 * 2 ^ e * Y ≤ primorial (dec 1 c G 100000).2 := by
      show m * (dec 1 c G 100000).1 * 2 ^ e * Y ≤ _
      calc m * (dec 1 c G 100000).1 * 2 ^ e * Y = (dec 1 c G 100000).1 * (m * 2 ^ e * Y) := by ring
        _ ≤ _ := hd
    have hs'' := shift_leY (Nat.mul m (dec 1 c G 100000).1) e de Y _ hd'
    have hmono := dec_mono 100000 1 c G
    obtain ⟨ih1, ih2⟩ := ih _ _ _ hw hs''
    refine ⟨fun n hn1 hlo hn2 => ?_, ih2⟩
    by_cases hn : n < (dec 1 c G 100000).2
    · exact hcov n hn1 hlo hn
    · exact ih1 n (by omega) hlo hn2

/-- the leaf form: from `C / 2 ^ 40 ≤ θ a` and `m₀ * a# ≤ c₀#`, a passing walk from `(m₀, c₀, 0)`
gives the bound on `[max c₀ lo, N)` and the constant at `N` -/
theorem leaf (C Cb a c₀ N j bb lo m₀ : ℕ) (l : List (ℕ × ℕ))
    (h : walk C N Cb j bb lo m₀ c₀ 0 l = true)
    (hc₀ : m₀ * primorial a ≤ primorial c₀) (hbase : (C : ℝ) / 2 ^ 40 ≤ Chebyshev.theta (a : ℝ)) :
    (∀ n : ℕ, c₀ ≤ n → lo ≤ n → n < N →
      ((n : ℝ) + 1) - 2 * √((n : ℝ) + 1) ≤ Chebyshev.theta (n : ℝ)) ∧
      (Cb : ℝ) / 2 ^ 40 ≤ Chebyshev.theta (N : ℝ) := by
  have hY : (C : ℝ) / 2 ^ 40 ≤ Real.log (primorial a : ℕ) := by
    rw [Chebyshev.theta_eq_log_primorial, Nat.floor_natCast] at hbase
    exact hbase
  exact walk_sound C N Cb j bb lo (primorial a) hY (primorial_pos a) l m₀ c₀ 0 h
    (by rw [pow_zero, mul_one]; exact hc₀)

/-- an even start `n + 1` has the same primorial as `n` -/
theorem primorial_even (n a : ℕ) (ha : a = n + 1) (h1 : n ≠ 1) (hn : n % 2 = 1) :
    1 * primorial a ≤ primorial n := by
  rw [one_mul, ha]
  exact le_of_eq (primorial_succ h1 (Nat.odd_iff.mpr hn))

theorem primorial_three : primorial 3 = 6 := by
  rw [show (3 : ℕ) = 2 + 1 by rfl, primorial_succ_prime 2 Nat.prime_three, primorial_two]

/-- the from-scratch start: `6 * 0# ≤ 3#` -/
theorem start_three : 6 * primorial 0 ≤ primorial 3 := by
  rw [primorial_three, primorial_zero]


