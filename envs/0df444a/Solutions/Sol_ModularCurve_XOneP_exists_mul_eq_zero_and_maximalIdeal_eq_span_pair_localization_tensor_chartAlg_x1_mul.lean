      exact @exists_pair_of_isRegularLocalRing_of_ringKrullDim_le_one (Localization.AtPrime 𝔐) _ hreg hdim
    ·
      obtain ⟨u, v, huv, hmx⟩ := exists_pair_stalk_of_not_subsingleton p M hM hpM L ζ hζ K hK A hAp hζA j hj k hk ↥S ι hι
        ϖ hϖ hϖk x (hx ▸ Set.mem_range_self _) hz hone
      refine ⟨E u, E v, by rw [← map_mul, huv, map_zero], ?_⟩
