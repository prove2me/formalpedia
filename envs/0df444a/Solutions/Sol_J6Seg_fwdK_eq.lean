-- Source module: Solutions.J6SegLn3
/-!
# Segmented inverse (S2), machine side 3: the sparse elimination in closed form

For the elimination `geSolveS P S L A b` along `L = [l₀, l₁, …]` (no repetitions), with the
matrices `Aseq L A r` and right-hand sides `bseq L A b r` after `r` pivots:

* **`bseq_closed`**: `bseq r i = b i − ∑_{q < r, S i l_q} fmul (F_q i) (bt q)` where
  `F_q i = fdiv (A_q i l_q) (A_q l_q l_q)` and `bt q = bseq q l_q` (forward substitution: every
  pivot step subtracts one rounded term);
* **`geSolveS_closed`**: `z l_r = fdiv (bt r − ∑_{k ∈ tail, S l_r k} fmul (A_r l_r k) (z k)) (A_r l_r l_r)`
  (back substitution with the final values `z`);
* `geSolveS_off`: `z k = 0` off `L`.

Everything data-independent (`A_q`, hence all multipliers and pivots) can be precomputed; the
data enter only through `bt` and `z`.
-/

open Finset

namespace J6Seg

section closed
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

lemma Aseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) : Aseq P S (j :: L) A 0 = A := rfl
lemma Aseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (q : ℕ) :
    Aseq P S (j :: L) A (q + 1) = Aseq P S L (stepA P S j A) q := rfl
lemma bseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) : bseq P S (j :: L) A b 0 = b := rfl
lemma bseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (q : ℕ) :
    bseq P S (j :: L) A b (q + 1) = bseq P S L (stepA P S j A) (stepB P S j A b) q := rfl

/-- **Forward substitution in closed form.** -/
theorem bseq_closed : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (r : ℕ), r ≤ L.length →
    ∀ i, bseq P S L A b r i = b i - ∑ q ∈ (range r).filter (fun q => S i (L.getD q 0)),
      fmul P (fdiv P (Aseq P S L A q i (L.getD q 0)) (Aseq P S L A q (L.getD q 0) (L.getD q 0)))
        (bseq P S L A b q (L.getD q 0))
  | [], A, b, r, hr, i => by
    simp at hr; subst hr; simp [bseq]
  | j :: L, A, b, 0, _, i => by simp [bseq]
  | j :: L, A, b, r + 1, hr, i => by
    simp only [List.length_cons] at hr
    have ih := bseq_closed L (stepA P S j A) (stepB P S j A b) r (by omega) i
    rw [bseq_succ, ih, Finset.sum_filter, Finset.sum_filter, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, Aseq_succ, bseq_succ, Aseq_zero,
      bseq_zero, stepB]
    split_ifs <;> ring

end closed

end J6Seg

end

