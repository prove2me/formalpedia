private theorem neg_one_mem_rootsOfUnity (q : ℕ) [Fact q.Prime] :
    (-1 : (GaloisField q 2)ˣ) ∈ rootsOfUnity (q + 1) (GaloisField q 2) := by
  rw [mem_rootsOfUnity]
