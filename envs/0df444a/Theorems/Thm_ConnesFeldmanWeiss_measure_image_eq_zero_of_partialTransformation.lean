-- title:
--   §1, p. 434 — a partial transformation inside R maps Borel null sets to null sets
-- statement:
--   Here $X$ is a standard Borel space, $\mu$ a measure on $X$ (not necessarily $\sigma$-finite), and $R \subseteq X \times X$ a discrete measured equivalence relation for $\mu$ (`IsDiscreteMeasured`): a Borel equivalence relation whose classes are countable and for which $\mu$ is quasi-invariant (the saturation of a null Borel set is null).
--
--   Let $\phi$ be a partial transformation of $X$ with $\phi \subset R$ (`Monod.PartialTransformation R`): Borel sets $\operatorname{Dom}\phi$ and $\operatorname{Im}\phi$ and a Borel bijection $\phi : \operatorname{Dom}\phi \to \operatorname{Im}\phi$ whose graph $\{(x, \phi(x)) \mid x \in \operatorname{Dom}\phi\}$ lies in $R$. If $A \subseteq X$ is a Borel $\mu$-null set, then its image $\phi(A \cap \operatorname{Dom}\phi)$ is $\mu$-null.
--
--   In the paper's words, $\phi$ is non-singular. The image is measured as a set; it is in fact Borel, by the Lusin–Souslin theorem, but the statement does not depend on that.
-- source:
--   Connes, A., Feldman, J., Weiss, B., An amenable equivalence relation is generated by a single transformation, Ergodic Theory Dynam. Systems 1 (1981) 431–450, https://doi.org/10.1017/S014338570000136X, p. 434, §1

import Mathlib
import Definitions.Def_Monod_PiecewiseProjective
import Definitions.Def_ConnesFeldmanWeiss

namespace ConnesFeldmanWeiss

theorem measure_image_eq_zero_of_partialTransformation {X : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] (μ : MeasureTheory.Measure X)
    (R : Set (X × X)) (hR : IsDiscreteMeasured μ R) (φ : Monod.PartialTransformation R)
    (A : Set X) (hA : MeasurableSet A) (hA0 : μ A = 0) :
    μ ((fun a : φ.dom => ((φ.e a : φ.cod) : X)) '' ((↑) ⁻¹' A)) = 0 := by
  sorry

end ConnesFeldmanWeiss
