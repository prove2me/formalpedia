section
/-!
# L2B_Sum: summability of `q^{-k}` over the index types of (7.9)–(7.11)
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField

variable {F : Type*} [Field F] [NumberField F]

/-- `q_I = N(I)` as a real number. -/
noncomputable abbrev qn (I : Ideal (𝓞 F)) : ℝ := (Ideal.absNorm I : ℝ)

theorem qn_pos {𝔪 I : Ideal (𝓞 F)} (h : IsExterior 𝔪 I) : 0 < qn I := by
  unfold qn
  exact_mod_cast Nat.pos_of_ne_zero (fun h0 => h.1 (Ideal.absNorm_eq_zero_iff.1 h0))

theorem summable_inv_pow_ideal {k : ℕ} (hk : 2 ≤ k) :
    Summable (fun I : Ideal (𝓞 F) => ((qn I) ^ k)⁻¹) := by
  have h := T12B.summable_absNorm_rpow (F := F) (σ := k) (by exact_mod_cast hk)
  refine h.congr fun I => ?_
  rw [Real.rpow_neg (Nat.cast_nonneg _), Real.rpow_natCast]

theorem summable_inv_pow_subtype (P : Ideal (𝓞 F) → Prop) {k : ℕ} (hk : 2 ≤ k) :
    Summable (fun I : {I : Ideal (𝓞 F) // P I} => ((qn I.1) ^ k)⁻¹) :=
  (summable_inv_pow_ideal hk).comp_injective Subtype.val_injective

theorem summable_inv_pow_prod_finite (P : Ideal (𝓞 F) → Prop) (β : Type*) [Finite β]
    {k : ℕ} (hk : 2 ≤ k) :
    Summable (fun I : {I : Ideal (𝓞 F) // P I} × β => ((qn I.1.1) ^ k)⁻¹) := by
  have h := Summable.mul_of_nonneg (summable_inv_pow_subtype P hk)
    (Summable.of_finite (f := fun _ : β => (1 : ℝ)))
    (fun _ => by positivity) (fun _ => zero_le_one)
  simpa using h

end ArtinPrimitiveRoots.L2B
end

section
/-! # C3B_Norm: the additive character on `R`, the unit ideal, and `a(1,1,1,1) = 1` -/

open NumberField IsDedekindDomain UniqueFactorizationMonoid

namespace ArtinPrimitiveRoots

namespace C3B

variable {F : Type*} [Field F] [NumberField F]

lemma sAddChar_congr {𝔪 : Ideal (𝓞 F)} (x x' : F)
    (H : ∀ y : F, (x - y ∈ (placesOf 𝔪).integer F) ↔ (x' - y ∈ (placesOf 𝔪).integer F)) :
    sAddChar 𝔪 x = sAddChar 𝔪 x' := by
  classical
  let G : (F → Prop) → ℂ := fun p => if h : ∃ y, p y then
    Complex.exp (-(2 * Real.pi * Complex.I) * ((Algebra.trace ℚ F h.choose : ℚ) : ℂ)) else 0
  have e1 : sAddChar 𝔪 x = G (fun y => x - y ∈ (placesOf 𝔪).integer F ∧
      ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1) := by
    unfold sAddChar; rfl
  have e2 : sAddChar 𝔪 x' = G (fun y => x' - y ∈ (placesOf 𝔪).integer F ∧
      ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1) := by
    unfold sAddChar; rfl
  rw [e1, e2]
  congr 1
  funext y
  exact propext (and_congr_left' (H y))

/-- `e` is invariant under translation by `R`. -/
lemma sAddChar_add_mem {𝔪 : Ideal (𝓞 F)} (x r : F) (hr : r ∈ (placesOf 𝔪).integer F) :
    sAddChar 𝔪 (x + r) = sAddChar 𝔪 x := by
  have key : ∀ y : F, (x + r - y ∈ (placesOf 𝔪).integer F) ↔ (x - y ∈ (placesOf 𝔪).integer F) := by
    intro y
    constructor
    · intro h
      have := sub_mem h hr
      rwa [show x + r - y - r = x - y by ring] at this
    · intro h
      have := add_mem h hr
      rwa [show x - y + r = x + r - y by ring] at this
  exact sAddChar_congr _ _ key

/-- `e` is trivial on `R`. -/
lemma sAddChar_of_mem {𝔪 : Ideal (𝓞 F)} (x : F) (hx : x ∈ (placesOf 𝔪).integer F) :
    sAddChar 𝔪 x = 1 := by
  have hex : ∃ y : F, x - y ∈ (placesOf 𝔪).integer F ∧
      ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1 :=
    ⟨0, by simpa using hx, fun v _ => by simp⟩
  rw [sAddChar, dif_pos hex]
  obtain ⟨h1, h2⟩ := hex.choose_spec
  set y := hex.choose
  have hy : y ∈ (placesOf 𝔪).integer F := by
    have := sub_mem hx h1
    rwa [sub_sub_cancel] at this
  have hall : ∀ v : HeightOneSpectrum (𝓞 F), v.valuation F y ≤ 1 := by
    intro v
    by_cases hv : v ∈ placesOf 𝔪
    · exact h2 v hv
    · exact hy v hv
  obtain ⟨z, hz⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one (R := 𝓞 F) F y hall
  have htr : Algebra.trace ℚ F y = ((Algebra.trace ℤ (𝓞 F) z : ℤ) : ℚ) := by
    rw [← hz, Algebra.coe_trace_int]
  rw [htr]
  have := Complex.exp_int_mul_two_pi_mul_I (-(Algebra.trace ℤ (𝓞 F) z))
  rw [← this]
  congr 1
  push_cast
  ring

end C3B

end ArtinPrimitiveRoots
end

section
/-! # C3B_Unit: `U_S⁶`-invariance of `poissonFactor`, and `u = 1` for the principal class

* `exists_sub_mem_map`: `𝓞/P → R/PR` is onto for `P ∉ S`; hence Fermat in `R/PR`.
* `sexticResidueSymbol_unit_pow_six`: `χ_P(μ⁶ x) = χ_P(x)` when `6 ∣ N P − 1`.
* `poissonFactor_unit_pow_six`: `F(𝔰, 𝔄, μ⁶ h) = F(𝔰, 𝔄, h)` for exterior `𝔰, 𝔄` whose prime
  factors all have `6 ∣ N P − 1`.
* `freqElt_principalFreq`: the principal frequency element is `μ⁶` for an `S`-unit `μ`.
-/

open NumberField IsDedekindDomain UniqueFactorizationMonoid

namespace ArtinPrimitiveRoots

namespace C3B

variable {F : Type*} [Field F] [NumberField F]

/-- The primes at which the sextic symbol behaves: exterior primes with `6 ∣ N P − 1`. -/
def GoodP (𝔪 P : Ideal (𝓞 F)) : Prop :=
  P.IsPrime ∧ P ≠ ⊥ ∧ ¬ 𝔪 ≤ P ∧ 6 ∣ Ideal.absNorm P - 1

section residue

variable {𝔪 : Ideal (𝓞 F)}

lemma coe_algebraMap_SInt (x : 𝓞 F) :
    ((algebraMap (𝓞 F) (SInt 𝔪) x : SInt 𝔪) : F) = (x : F) := rfl

lemma exists_sub_mem_map (P : Ideal (𝓞 F)) (hP : P.IsPrime) (hP0 : P ≠ ⊥) (h𝔪 : ¬ 𝔪 ≤ P)
    (r : SInt 𝔪) :
    ∃ a : 𝓞 F, r - algebraMap (𝓞 F) (SInt 𝔪) a ∈ P.map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  let v : HeightOneSpectrum (𝓞 F) := ⟨P, hP, hP0⟩
  have hvS : v ∉ placesOf 𝔪 := h𝔪
  have hv : v.valuation F (r : F) ≤ 1 := r.2 v hvS
  obtain ⟨n, ⟨d, hd⟩, hnd⟩ := v.exists_primeCompl_mul_eq_of_integer (K := F) (r : F) hv
  have : P.IsMaximal := hP.isMaximal hP0
  let _ := Ideal.Quotient.field P
  have hd' : Ideal.Quotient.mk P d ≠ 0 := by
    rw [Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hd
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk P d)⁻¹
  refine ⟨c * n, ?_⟩
  have h1 : 1 - c * d ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, hc, inv_mul_cancel₀ hd',
      sub_self]
  have h2 : r - algebraMap (𝓞 F) (SInt 𝔪) (c * n) =
      r * algebraMap (𝓞 F) (SInt 𝔪) (1 - c * d) := by
    apply Subtype.ext
    have hnd' := hnd
    simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, coe_algebraMap_SInt]
    push_cast at hnd' ⊢
    linear_combination ((c : 𝓞 F) : F) * hnd'
  rw [h2]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ h1)

lemma card_quot (P : Ideal (𝓞 F)) (hP0 : P ≠ ⊥) [Fintype (𝓞 F ⧸ P)] :
    Fintype.card (𝓞 F ⧸ P) = Ideal.absNorm P := by
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]

/-- Fermat in `R/PR`. -/
lemma pow_absNorm_eq (P : Ideal (𝓞 F)) (hP : P.IsPrime) (hP0 : P ≠ ⊥) (h𝔪 : ¬ 𝔪 ≤ P)
    (y : SInt 𝔪 ⧸ P.map (algebraMap (𝓞 F) (SInt 𝔪))) : y ^ Ideal.absNorm P = y := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨a, ha⟩ := exists_sub_mem_map P hP hP0 h𝔪 r
  have hra : Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪))) r =
      Ideal.Quotient.mk _ (algebraMap (𝓞 F) (SInt 𝔪) a) := Ideal.Quotient.eq.mpr ha
  rw [hra, ← map_pow, Ideal.Quotient.eq, ← map_pow, ← map_sub]
  apply Ideal.mem_map_of_mem
  have : P.IsMaximal := hP.isMaximal hP0
  let _ := Ideal.Quotient.field P
  have : Finite (𝓞 F ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP0
  let _ : Fintype (𝓞 F ⧸ P) := Fintype.ofFinite _
  rw [← Ideal.Quotient.eq, map_pow, ← card_quot P hP0]
  exact FiniteField.pow_card _

lemma unit_pow_sub_one (P : Ideal (𝓞 F)) (hP : P.IsPrime) (hP0 : P ≠ ⊥) (h𝔪 : ¬ 𝔪 ≤ P)
    (μ : (SInt 𝔪)ˣ) :
    Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪))) (μ : SInt 𝔪) ^
      (Ideal.absNorm P - 1) = 1 := by
  set z := Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪))) (μ : SInt 𝔪)
  have hu : IsUnit z := μ.isUnit.map _
  have hN : 1 ≤ Ideal.absNorm P := by
    rw [Nat.one_le_iff_ne_zero, Ne, Ideal.absNorm_eq_zero_iff]; exact hP0
  have h := pow_absNorm_eq P hP hP0 h𝔪 z
  rw [← Nat.sub_add_cancel hN, pow_succ] at h
  exact (hu.mul_eq_right).mp h

lemma sexticResidueSymbol_eq_of_mk_eq (ι : F →+* ℂ) (P : Ideal (𝓞 F)) (x y : SInt 𝔪)
    (h : Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪))) x =
      Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪))) y) :
    sexticResidueSymbol ι 𝔪 P x = sexticResidueSymbol ι 𝔪 P y := by
  unfold sexticResidueSymbol
  rw [h]

lemma sexticResidueSymbol_unit_pow_six (ι : F →+* ℂ) (P : Ideal (𝓞 F)) (hP : GoodP 𝔪 P)
    (μ : (SInt 𝔪)ˣ) (x : SInt 𝔪) :
    sexticResidueSymbol ι 𝔪 P ((μ : SInt 𝔪) ^ 6 * x) = sexticResidueSymbol ι 𝔪 P x := by
  classical
  obtain ⟨hPp, hP0, h𝔪, h6⟩ := hP
  set mk := Ideal.Quotient.mk (P.map (algebraMap (𝓞 F) (SInt 𝔪)))
  let Φ : (SInt 𝔪 ⧸ P.map (algebraMap (𝓞 F) (SInt 𝔪))) →
      (SInt 𝔪 ⧸ P.map (algebraMap (𝓞 F) (SInt 𝔪))) → ℂ := fun z w =>
    if z = 0 then 0 else
      if h : ∃ ζ : 𝓞 F, ζ ^ 6 = 1 ∧ mk (algebraMap (𝓞 F) (SInt 𝔪) ζ) = w
      then ι (h.choose : F) else 0
  have e : ∀ t, sexticResidueSymbol ι 𝔪 P t = Φ (mk t) (mk t ^ ((Ideal.absNorm P - 1) / 6)) :=
    fun t => rfl
  rw [e, e]
  have hu : IsUnit (mk (μ : SInt 𝔪)) := μ.isUnit.map _
  have h1 : mk ((μ : SInt 𝔪) ^ 6 * x) = mk (μ : SInt 𝔪) ^ 6 * mk x := by
    rw [map_mul, map_pow]
  have h2 : mk ((μ : SInt 𝔪) ^ 6 * x) ^ ((Ideal.absNorm P - 1) / 6) =
      mk x ^ ((Ideal.absNorm P - 1) / 6) := by
    rw [h1, mul_pow, ← pow_mul, Nat.mul_div_cancel' h6,
      unit_pow_sub_one P hPp hP0 h𝔪 μ, one_mul]
  have h3 : (mk ((μ : SInt 𝔪) ^ 6 * x) = 0) ↔ (mk x = 0) := by
    rw [h1]
    exact (hu.pow 6).mul_right_eq_zero
  simp only [Φ, h2, h3]

lemma residueSymbol_unit_pow_six (ι : F →+* ℂ) (𝔞 : Ideal (𝓞 F))
    (h𝔞 : ∀ P ∈ normalizedFactors 𝔞, GoodP 𝔪 P) (μ : (SInt 𝔪)ˣ) (x : SInt 𝔪) :
    residueSymbol ι 𝔪 𝔞 ((μ : SInt 𝔪) ^ 6 * x) = residueSymbol ι 𝔪 𝔞 x := by
  unfold residueSymbol
  congr 1
  exact Multiset.map_congr rfl fun P hP => sexticResidueSymbol_unit_pow_six ι P (h𝔞 P hP) μ x

lemma residueSymbol_congr (ι : F →+* ℂ) (𝔞 : Ideal (𝓞 F)) (x y : SInt 𝔪)
    (h : x - y ∈ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    residueSymbol ι 𝔪 𝔞 x = residueSymbol ι 𝔪 𝔞 y := by
  unfold residueSymbol
  congr 1
  refine Multiset.map_congr rfl fun P hP => ?_
  apply sexticResidueSymbol_eq_of_mk_eq
  rw [Ideal.Quotient.eq]
  exact Ideal.map_mono (Ideal.le_of_dvd (dvd_of_mem_normalizedFactors hP)) h

end residue

section gen

variable {ι : F →+* ℂ} {𝔪 : Ideal (𝓞 F)}

lemma gen_ne_zero (g : AllowedGen ι 𝔪) (I : Ideal (𝓞 F)) (hI : IsExterior 𝔪 I) :
    ((g.gen I : SInt 𝔪) : F) ≠ 0 := by
  intro h0
  have h0' : g.gen I = 0 := Subtype.ext h0
  have hs := g.span_gen I hI
  rw [h0', Ideal.span_singleton_eq_bot.mpr rfl] at hs
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI.1
  have : algebraMap (𝓞 F) (SInt 𝔪) a ∈ I.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
    Ideal.mem_map_of_mem _ ha
  rw [← hs, Ideal.mem_bot] at this
  apply ha0
  have := congrArg (fun z : SInt 𝔪 => (z : F)) this
  simp only [coe_algebraMap_SInt, ZeroMemClass.coe_zero] at this
  exact_mod_cast this

lemma mem_map_iff (g : AllowedGen ι 𝔪) (I : Ideal (𝓞 F)) (hI : IsExterior 𝔪 I) (x : SInt 𝔪) :
    x ∈ I.map (algebraMap (𝓞 F) (SInt 𝔪)) ↔ ∃ r : SInt 𝔪, x = g.gen I * r := by
  rw [← g.span_gen I hI, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨r, hr⟩; exact ⟨r, by rw [← hr, mul_comm]⟩
  · rintro ⟨r, hr⟩; exact ⟨r, by rw [hr, mul_comm]⟩

lemma div_gen_mem (g : AllowedGen ι 𝔪) (I : Ideal (𝓞 F)) (hI : IsExterior 𝔪 I) (x : SInt 𝔪)
    (hx : x ∈ I.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    (x : F) / (g.gen I : F) ∈ (placesOf 𝔪).integer F := by
  obtain ⟨r, rfl⟩ := (mem_map_iff g I hI x).mp hx
  have h0 := gen_ne_zero g I hI
  rw [Subalgebra.coe_mul, mul_div_cancel_left₀ _ h0]
  exact r.2

lemma gaussSumAt_add_mem (g : AllowedGen ι 𝔪) (𝔄 : Ideal (𝓞 F)) (h𝔄 : IsExterior 𝔪 𝔄) (k : F)
    (a : SInt 𝔪) (ha : a ∈ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    gaussSumAt g 𝔄 (k + a) = gaussSumAt g 𝔄 k := by
  unfold gaussSumAt
  refine finsum_congr fun v => ?_
  congr 1
  have hmem : (a : F) / (g.gen 𝔄 : F) * (quotLift v : F) ∈ (placesOf 𝔪).integer F :=
    mul_mem (div_gen_mem g 𝔄 h𝔄 a ha) (quotLift v).2
  rw [show (k + a) * (quotLift v : F) / (g.gen 𝔄 : F) =
      k * (quotLift v : F) / (g.gen 𝔄 : F) + (a : F) / (g.gen 𝔄 : F) * (quotLift v : F) by ring]
  exact sAddChar_add_mem _ _ hmem

lemma coe_unit_pow_mul_inv (μ : (SInt 𝔪)ˣ) :
    (((μ : SInt 𝔪) : F)) ^ 6 * (((μ⁻¹ : (SInt 𝔪)ˣ) : SInt 𝔪) : F) ^ 6 = 1 := by
  rw [← mul_pow]
  have : ((μ : SInt 𝔪) : F) * (((μ⁻¹ : (SInt 𝔪)ˣ) : SInt 𝔪) : F) = 1 := by
    rw [← Subalgebra.coe_mul, Units.mul_inv]; rfl
  rw [this, one_pow]

lemma gaussSumAt_unit_pow_six (g : AllowedGen ι 𝔪) (𝔄 : Ideal (𝓞 F)) (h𝔄 : IsExterior 𝔪 𝔄)
    (h𝔄g : ∀ P ∈ normalizedFactors 𝔄, GoodP 𝔪 P) (μ : (SInt 𝔪)ˣ) (k : F)
    (hk : k ∈ (placesOf 𝔪).integer F) :
    gaussSumAt g 𝔄 (((μ : SInt 𝔪) : F) ^ 6 * k) = gaussSumAt g 𝔄 k := by
  set I := 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪))
  set c : (SInt 𝔪 ⧸ I)ˣ := Units.map (Ideal.Quotient.mk I).toMonoidHom (μ⁻¹ ^ 6)
  unfold gaussSumAt
  rw [← finsum_comp_equiv (Units.mulLeft c)]
  refine finsum_congr fun v => ?_
  simp only [Units.mulLeft_apply]
  set q := (quotLift v : SInt 𝔪)
  set q' := (quotLift ((c : SInt 𝔪 ⧸ I) * v) : SInt 𝔪)
  set ν : SInt 𝔪 := ((μ⁻¹ : (SInt 𝔪)ˣ) : SInt 𝔪)
  have hq' : q' - ν ^ 6 * q ∈ I := by
    rw [← Ideal.Quotient.eq]
    simp only [q', q, quotLift, Function.surjInv_eq Ideal.Quotient.mk_surjective, map_mul,
      map_pow, c, Units.coe_map, MonoidHom.coe_coe, Units.val_pow_eq_pow_val, ν]
    rfl
  congr 1
  · rw [residueSymbol_congr ι 𝔄 q' (ν ^ 6 * q) hq']
    exact residueSymbol_unit_pow_six ι 𝔄 h𝔄g μ⁻¹ q
  · set δ := q' - ν ^ 6 * q
    have hq'eq : (q' : F) = (ν : F) ^ 6 * (q : F) + (δ : F) := by
      simp only [δ, Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow]; ring
    have hmem : ((μ : SInt 𝔪) : F) ^ 6 * k * ((δ : F) / (g.gen 𝔄 : F)) ∈
        (placesOf 𝔪).integer F :=
      mul_mem (mul_mem (pow_mem (μ : SInt 𝔪).2 6) hk) (div_gen_mem g 𝔄 h𝔄 δ hq')
    have hμν := coe_unit_pow_mul_inv μ
    rw [show ((μ : SInt 𝔪) : F) ^ 6 * k * (q' : F) / (g.gen 𝔄 : F) =
        k * (q : F) / (g.gen 𝔄 : F) + ((μ : SInt 𝔪) : F) ^ 6 * k * ((δ : F) / (g.gen 𝔄 : F)) by
      rw [hq'eq]
      have : ((μ : SInt 𝔪) : F) ^ 6 * (ν : F) ^ 6 = 1 := hμν
      linear_combination (k * (q : F) / (g.gen 𝔄 : F)) * this]
    exact sAddChar_add_mem _ _ hmem

end gen

end C3B

end ArtinPrimitiveRoots
end

section
/-! # C3B_Good: exterior primes satisfy `6 ∣ N P − 1` once `S` contains the primes above `2, 3` -/

open NumberField IsDedekindDomain UniqueFactorizationMonoid

namespace ArtinPrimitiveRoots

namespace C3B

variable {F : Type*} [Field F] [NumberField F]

/-- A prime of norm divisible by the rational prime `p` has norm at most `p^[F:ℚ]`. -/
theorem absNorm_le_of_prime_dvd (p : ℕ) (hp : p.Prime) (P : Ideal (𝓞 F)) (hP0 : P ≠ ⊥)
    [P.IsMaximal] (hpd : p ∣ Ideal.absNorm P) :
    Ideal.absNorm P ≤ p ^ Module.finrank ℤ (𝓞 F) := by
  let _ := Ideal.Quotient.field P
  have : Finite (𝓞 F ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP0
  let _ : Fintype (𝓞 F ⧸ P) := Fintype.ofFinite _
  have hcard := card_quot P hP0
  obtain ⟨f, hq, hpf⟩ := FiniteField.card (𝓞 F ⧸ P) (ringChar (𝓞 F ⧸ P))
  rw [hcard] at hpf
  rw [hpf] at hpd
  have hpq : p = ringChar (𝓞 F ⧸ P) :=
    (Nat.prime_dvd_prime_iff_eq hp hq).mp (hp.dvd_of_dvd_pow hpd)
  have hp0 : ((p : ℕ) : 𝓞 F ⧸ P) = 0 := by rw [hpq]; exact ringChar.Nat.cast_ringChar
  have hmem : (p : 𝓞 F) ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
    exact hp0
  have hle : Ideal.span {(p : 𝓞 F)} ≤ P := (Ideal.span_singleton_le_iff_mem P).mpr hmem
  have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
  rw [Ideal.absNorm_span_singleton] at hdvd
  have hn : Algebra.norm ℤ (p : 𝓞 F) = (p : ℤ) ^ Module.finrank ℤ (𝓞 F) := by
    rw [show (p : 𝓞 F) = algebraMap ℤ (𝓞 F) p by simp, Algebra.norm_algebraMap]
  rw [hn, Int.natAbs_pow, Int.natAbs_natCast] at hdvd
  exact Nat.le_of_dvd (pow_pos hp.pos _) hdvd

/-- In `ℚ(μ_n)` with `6 ∣ n`, a prime of norm `> 3^[F:ℚ]` has `6 ∣ N P − 1`. -/
theorem six_dvd_absNorm_sub_one (n : ℕ) (hn0 : 0 < n) (hn : 6 ∣ n) [IsCyclotomicExtension {n} ℚ F]
    (P : Ideal (𝓞 F)) (hP : P.IsPrime) (hP0 : P ≠ ⊥)
    (hQ : 3 ^ Module.finrank ℤ (𝓞 F) < Ideal.absNorm P) : 6 ∣ Ideal.absNorm P - 1 := by
  have : P.IsMaximal := hP.isMaximal hP0
  let _ := Ideal.Quotient.field P
  have : Finite (𝓞 F ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP0
  let _ : Fintype (𝓞 F ⧸ P) := Fintype.ofFinite _
  set Q := Ideal.absNorm P
  have hd : 0 < Module.finrank ℤ (𝓞 F) := Module.finrank_pos
  have h23 : 2 ^ Module.finrank ℤ (𝓞 F) ≤ 3 ^ Module.finrank ℤ (𝓞 F) :=
    Nat.pow_le_pow_left (by norm_num) _
  have h3le : 3 ≤ 3 ^ Module.finrank ℤ (𝓞 F) := by
    calc 3 = 3 ^ 1 := by norm_num
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hd
  have h2 : ¬ 2 ∣ Q := fun h => by
    have := absNorm_le_of_prime_dvd 2 Nat.prime_two P hP0 h; omega
  have h3 : ¬ 3 ∣ Q := fun h => by
    have := absNorm_le_of_prime_dvd 3 Nat.prime_three P hP0 h; omega
  have hcop : Q.Coprime 6 := by
    have c2 : Q.Coprime 2 := (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h2))
    have c3 : Q.Coprime 3 :=
      (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3))
    have : (6 : ℕ) = 2 * 3 := by norm_num
    rw [this]; exact Nat.Coprime.mul_right c2 c3
  have : NeZero n := ⟨hn0.ne'⟩
  have hζ := IsCyclotomicExtension.zeta_spec n ℚ F
  have hζ6 : IsPrimitiveRoot (IsCyclotomicExtension.zeta n ℚ F ^ (n / 6)) 6 :=
    hζ.pow hn0 (Nat.div_mul_cancel hn).symm
  have hω : IsPrimitiveRoot hζ6.toInteger 6 := hζ6.toInteger_isPrimitiveRoot
  have hωb : IsPrimitiveRoot (Ideal.Quotient.mk P hζ6.toInteger) 6 :=
    hω.idealQuotient_mk (by omega) hcop
  have h1 : Ideal.Quotient.mk P hζ6.toInteger ^ (Q - 1) = 1 := by
    rw [show Q = Fintype.card (𝓞 F ⧸ P) from (card_quot P hP0).symm]
    exact FiniteField.pow_card_sub_one_eq_one _ (hωb.ne_zero (by norm_num))
  exact (hωb.pow_eq_one_iff_dvd _).mp h1

/-- An exterior prime is good. -/
theorem goodP_of_exterior (n : ℕ) (hn0 : 0 < n) (hn : 6 ∣ n) [IsCyclotomicExtension {n} ℚ F]
    {N₀ : ℕ} (hN₀ : 3 ^ Module.finrank ℤ (𝓞 F) ≤ N₀) {𝔪 : Ideal (𝓞 F)}
    (hsm : SmallPrimesDvd N₀ 𝔪) {P : Ideal (𝓞 F)} (hPi : P.IsPrime) (hP : IsExterior 𝔪 P) :
    GoodP 𝔪 P := by
  have h𝔪 : ¬ 𝔪 ≤ P := by
    intro h
    apply hPi.ne_top
    rw [eq_top_iff, ← hP.2]
    exact sup_le le_rfl h
  refine ⟨hPi, hP.1, h𝔪, six_dvd_absNorm_sub_one n hn0 hn P hPi hP.1 ?_⟩
  by_contra hcon
  exact h𝔪 (hsm P hPi hP.1 (by omega))

end C3B

end ArtinPrimitiveRoots
end

section
/-! # C3B_Main: (7.16)–(7.17) at `u = 1` from four arithmetic cuts

With `b(𝔠, 𝔫, 𝔰, 𝔯) = γ₂(𝔠) ϑ(𝔠𝔫³) F(𝔰, 𝔠𝔫³, gen(𝔯)⁶)` (the coefficient at `u = 1`, without the
`S`-unit `u`), the target `exists_cutoff_freqCoeff_principalFreq_eq_one_and_eq_mul` follows from

* `CutMul`: cross-prime multiplicativity `b(P^{e₀}𝔠, P^l𝔫, P^k𝔰, P^m𝔯) = b(P^{e₀},P^l,P^k,P^m) b(𝔠,𝔫,𝔰,𝔯)`
  ((7.14), (7.16): Chinese remainders + reciprocity (3.3));
* `CutF`: the local Poisson factor `F(P^k, P^{e₀}(P^l)³, gen(P^m)⁶)` ((7.15), (7.17));
* `CutHD`: `γ₁(P) γ₂(P) Λ̄(P) Ḡ(P) = −1` (Davenport–Hasse, (3.9)–(3.11));
* `CutG6`: `Ḡ(P)⁶ = 1`.

Proved here: `a(1,1,1,1) = 1` (`C3B_Norm`), the `U_S⁶`-invariance replacing `u` by `1`
(`C3B_Unit`, `C3B_Good`), `ϑ` on prime powers, `Λ⁶ = jacobiPhaseSix`, and the table algebra. -/

open NumberField IsDedekindDomain UniqueFactorizationMonoid

namespace ArtinPrimitiveRoots

namespace C3B

variable {F : Type*} [Field F] [NumberField F]

/-! ### Elementary lemmas -/

lemma smallPrimesDvd_mono {N N' : ℕ} (h : N' ≤ N) {𝔪 : Ideal (𝓞 F)}
    (hs : SmallPrimesDvd N 𝔪) : SmallPrimesDvd N' 𝔪 :=
  fun P hP hP0 hle => hs P hP hP0 (hle.trans h)

end C3B

end ArtinPrimitiveRoots
end

section
/-! # C3I_Res: the residue rings `R / P^j R` at a prime `P ∉ S`

For a height-one prime `v` of `𝓞 F` outside `S = placesOf 𝔪`:
* `mem_map_pow_iff`: `r ∈ v^j R ↔ v(r) ≤ exp(-j)` for `r ∈ R`;
* `quotEquiv`: `𝓞/v^j ≃+* R/v^j R`; `natCard_quot`: `#(R/v^j R) = N(v)^j`;
* `isMaximal_map`: `v R` is maximal;
* `finsum_quot_fibre`: summing a function that only depends on the class mod `v^i R`
  over `R/v^j R` (`i ≤ j`) gives `N(v)^(j-i)` times the sum over `R/v^i R`.
-/

set_option linter.style.haveILetI false

open NumberField IsDedekindDomain UniqueFactorizationMonoid WithZero

namespace ArtinPrimitiveRoots

namespace C3I

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)}

section val

variable {v : HeightOneSpectrum (𝓞 F)}

lemma coe_alg (a : 𝓞 F) : ((algebraMap (𝓞 F) (SInt 𝔪) a : SInt 𝔪) : F) = algebraMap (𝓞 F) F a :=
  rfl

lemma val_le_one (hv : v ∉ placesOf 𝔪) (r : SInt 𝔪) : v.valuation F (r : F) ≤ 1 := r.2 v hv

lemma val_alg (a : 𝓞 F) : v.valuation F (algebraMap (𝓞 F) F a) = v.intValuation a :=
  v.valuation_of_algebraMap a

/-- Elements of `v^j R` have valuation at most `exp(-j)`. -/
lemma val_le_of_mem (hv : v ∉ placesOf 𝔪) (j : ℕ) {r : SInt 𝔪}
    (hr : r ∈ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪))) :
    v.valuation F (r : F) ≤ exp (-(j : ℤ)) := by
  rw [Ideal.map] at hr
  induction hr using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    rw [coe_alg, val_alg]
    exact (v.intValuation_le_pow_iff_mem a j).2 ha
  | zero => simp
  | add x y _ _ hx hy =>
    rw [Subalgebra.coe_add]
    exact (Valuation.map_add _ _ _).trans (max_le hx hy)
  | smul a x _ hx =>
    rw [smul_eq_mul, Subalgebra.coe_mul, map_mul]
    calc v.valuation F (a : F) * v.valuation F (x : F) ≤ 1 * exp (-(j : ℤ)) :=
          mul_le_mul' (val_le_one hv a) hx
      _ = _ := one_mul _

/-- An element of `𝓞` not in `v` has an inverse modulo `v^j`. -/
lemma exists_mul_sub_one_mem (j : ℕ) {d : 𝓞 F} (hd : d ∉ v.asIdeal) :
    ∃ c : 𝓞 F, c * d - 1 ∈ v.asIdeal ^ j := by
  have h1 : IsCoprime v.asIdeal (Ideal.span {d}) := by
    obtain ⟨y, i, hi, hyi⟩ := v.isMaximal.exists_inv hd
    exact Ideal.isCoprime_iff_exists.mpr ⟨i, hi, y * d, Ideal.mul_mem_left _ _
      (Ideal.mem_span_singleton_self d), by rw [add_comm]; exact hyi⟩
  obtain ⟨i, hi, x, hx, hix⟩ := (h1.pow_left (m := j)).exists
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hx
  refine ⟨c, ?_⟩
  have : c * d - 1 = -i := by linear_combination hix
  rw [this]
  exact neg_mem hi

/-- Every `x ∈ F` with `v(x) ≤ 1` is congruent modulo `v^j` (in valuation) to an element of `𝓞`. -/
lemma exists_val_sub_le (j : ℕ) (x : F) (hx : v.valuation F x ≤ 1) :
    ∃ a : 𝓞 F, v.valuation F (x - algebraMap (𝓞 F) F a) ≤ exp (-(j : ℤ)) := by
  obtain ⟨n, ⟨d, hd⟩, hnd⟩ := v.exists_primeCompl_mul_eq_of_integer (K := F) x hx
  obtain ⟨c, hc⟩ := exists_mul_sub_one_mem (v := v) j hd
  refine ⟨c * n, ?_⟩
  have hvd : v.valuation F (algebraMap (𝓞 F) F d) = 1 :=
    (HeightOneSpectrum.valuation_eq_one_iff_notMem v).2 hd
  have heq : x - algebraMap (𝓞 F) F (c * n) =
      -(x * algebraMap (𝓞 F) F (c * d - 1)) := by
    have hnd' : x * algebraMap (𝓞 F) F d = algebraMap (𝓞 F) F n := hnd
    rw [map_mul, ← hnd', map_sub, map_mul, map_one]; ring
  rw [heq, Valuation.map_neg, map_mul, val_alg]
  calc v.valuation F x * v.intValuation (c * d - 1) ≤ 1 * exp (-(j : ℤ)) :=
        mul_le_mul' hx ((v.intValuation_le_pow_iff_mem _ j).2 hc)
    _ = _ := one_mul _

/-- Elements of `R` of valuation at most `exp(-j)` lie in `v^j R`. -/
lemma mem_of_val_le (hv : v ∉ placesOf 𝔪) (j : ℕ) (r : SInt 𝔪)
    (h : v.valuation F (r : F) ≤ exp (-(j : ℤ))) :
    r ∈ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  obtain ⟨n, ⟨d, hd⟩, hnd⟩ := v.exists_primeCompl_mul_eq_of_integer (K := F) (r : F) (r.2 v hv)
  have hnd' : (r : F) * algebraMap (𝓞 F) F d = algebraMap (𝓞 F) F n := hnd
  have hvd : v.valuation F (algebraMap (𝓞 F) F d) = 1 :=
    (HeightOneSpectrum.valuation_eq_one_iff_notMem v).2 hd
  have hn : n ∈ v.asIdeal ^ j := by
    rw [← v.intValuation_le_pow_iff_mem, ← val_alg (v := v), ← hnd', map_mul, hvd, mul_one]
    exact h
  obtain ⟨c, hc⟩ := exists_mul_sub_one_mem (v := v) j hd
  have heq : r = algebraMap (𝓞 F) (SInt 𝔪) (c * n) -
      r * algebraMap (𝓞 F) (SInt 𝔪) (c * d - 1) := by
    apply Subtype.ext
    rw [Subalgebra.coe_sub, Subalgebra.coe_mul, coe_alg, coe_alg, map_mul, map_sub, map_mul,
      map_one, ← hnd']
    ring
  rw [heq]
  exact sub_mem (Ideal.mem_map_of_mem _ (Ideal.mul_mem_left _ _ hn))
    (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hc))

lemma mem_map_pow_iff (hv : v ∉ placesOf 𝔪) (j : ℕ) (r : SInt 𝔪) :
    r ∈ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪)) ↔
      v.valuation F (r : F) ≤ exp (-(j : ℤ)) :=
  ⟨val_le_of_mem hv j, mem_of_val_le hv j r⟩

/-- Discreteness: a valuation strictly above `exp(-(j+1))` is at least `exp(-j)`. -/
lemma exp_le_of_lt {γ : ℤᵐ⁰} {j : ℤ} (h : exp (j - 1) < γ) : exp j ≤ γ := by
  have hγ : γ ≠ 0 := ne_zero_of_lt h
  rw [← exp_log hγ] at h ⊢
  rw [exp_lt_exp] at h
  rw [exp_le_exp]
  omega

lemma exp_le_val_of_not_mem (hv : v ∉ placesOf 𝔪) (j : ℕ) (r : SInt 𝔪)
    (h : r ∉ (v.asIdeal ^ (j + 1)).map (algebraMap (𝓞 F) (SInt 𝔪))) :
    exp (-(j : ℤ)) ≤ v.valuation F (r : F) := by
  rw [mem_map_pow_iff hv, not_le] at h
  apply exp_le_of_lt
  convert h using 2
  push_cast; ring

lemma le_of_mul_le_mul_ne {a b c : ℤᵐ⁰} (h : a * c ≤ b * c) (hc : c ≠ 0) : a ≤ b := by
  have := mul_le_mul_right h c⁻¹
  rwa [mul_comm c⁻¹, mul_comm c⁻¹, mul_inv_cancel_right₀ hc, mul_inv_cancel_right₀ hc] at this

lemma isExterior_mul {I J : Ideal (𝓞 F)} (hI : IsExterior 𝔪 I) (hJ : IsExterior 𝔪 J) :
    IsExterior 𝔪 (I * J) := by
  refine ⟨mul_ne_zero hI.1 hJ.1, ?_⟩
  have h1 : IsCoprime I 𝔪 := Ideal.isCoprime_iff_sup_eq.mpr hI.2
  have h2 : IsCoprime J 𝔪 := Ideal.isCoprime_iff_sup_eq.mpr hJ.2
  exact Ideal.isCoprime_iff_sup_eq.mp (h1.mul_left h2)

lemma isExterior_pow {I : Ideal (𝓞 F)} (hI : IsExterior 𝔪 I) (n : ℕ) :
    IsExterior 𝔪 (I ^ n) := by
  induction n with
  | zero => rw [pow_zero, Ideal.one_eq_top]; exact ⟨top_ne_bot, top_sup_eq _⟩
  | succ k ih => rw [pow_succ]; exact isExterior_mul ih hI

/-- A uniformizer in `𝓞`. -/
lemma exists_uniformizer : ∃ p : 𝓞 F, v.valuation F (algebraMap (𝓞 F) F p) = exp (-1 : ℤ) := by
  obtain ⟨p, hp⟩ := v.intValuation_exists_uniformizer
  exact ⟨p, by rw [val_alg, hp]⟩

end val

section quot

variable {v : HeightOneSpectrum (𝓞 F)}

/-- `𝓞/v^j → R/v^j R`. -/
noncomputable def quotHom (𝔪 : Ideal (𝓞 F)) (I : Ideal (𝓞 F)) :
    𝓞 F ⧸ I →+* SInt 𝔪 ⧸ I.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
  Ideal.quotientMap _ (algebraMap (𝓞 F) (SInt 𝔪)) Ideal.le_comap_map

lemma quotHom_mk (I : Ideal (𝓞 F)) (a : 𝓞 F) :
    quotHom 𝔪 I (Ideal.Quotient.mk I a) =
      Ideal.Quotient.mk (I.map (algebraMap (𝓞 F) (SInt 𝔪))) (algebraMap (𝓞 F) (SInt 𝔪) a) :=
  rfl

end quot

section fibre

variable {v : HeightOneSpectrum (𝓞 F)}

end fibre

end C3I

end ArtinPrimitiveRoots
end

section
/-! # C3I_Add: the additive character `e`

* `HasWit 𝔪 x`: `x` has a witness `y` in the definition of `sAddChar` (`x - y ∈ R`, `y` integral
  at `S`). `hasWit_of_mul_mem`: true when `x I ⊆ R` for an ideal `I` coprime to `𝔪`; in particular
  `hasWit_div_gen`: `a / gen 𝔞` for `a ∈ R`, `𝔞` exterior.
* `sAddChar_eq_of_wit`: `e(x) = exp(-2πi Tr y)` for every witness; `sAddChar_add`: `e` is additive
  on elements with witnesses.
* `exists_trace_not_int`: for `P ∤ 𝔇`, some `z ∈ P⁻¹` has `Tr z ∉ ℤ`; `sAddChar_ne_one_of_dual`.
* `exists_sAddChar_ne_one`: primitivity at every level: for `x ∈ R ∖ P^j R` some `r ∈ R` has
  `e(x r / gen(P^j)) ≠ 1`.
-/

set_option linter.style.haveILetI false

open NumberField IsDedekindDomain UniqueFactorizationMonoid WithZero

namespace ArtinPrimitiveRoots

namespace C3I

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)}

/-- `x` has a witness in the definition of `sAddChar`. -/
def HasWit (𝔪 : Ideal (𝓞 F)) (x : F) : Prop :=
  ∃ y : F, x - y ∈ (placesOf 𝔪).integer F ∧ ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1

/-- The value of `e` through any witness. -/
lemma sAddChar_eq_of_wit {x y : F} (h1 : x - y ∈ (placesOf 𝔪).integer F)
    (h2 : ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1) :
    sAddChar 𝔪 x =
      Complex.exp (-(2 * Real.pi * Complex.I) * ((Algebra.trace ℚ F y : ℚ) : ℂ)) := by
  have hex : ∃ y : F, x - y ∈ (placesOf 𝔪).integer F ∧
      ∀ v ∈ placesOf 𝔪, v.valuation F y ≤ 1 := ⟨y, h1, h2⟩
  rw [sAddChar, dif_pos hex]
  obtain ⟨k1, k2⟩ := hex.choose_spec
  set y' := hex.choose
  have hd : y' - y ∈ (placesOf 𝔪).integer F := by
    have := sub_mem h1 k1
    rwa [show x - y - (x - y') = y' - y by ring] at this
  have hall : ∀ v : HeightOneSpectrum (𝓞 F), v.valuation F (y' - y) ≤ 1 := by
    intro v
    by_cases hv : v ∈ placesOf 𝔪
    · exact (Valuation.map_sub _ _ _).trans (max_le (k2 v hv) (h2 v hv))
    · exact hd v hv
  obtain ⟨z, hz⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one (R := 𝓞 F) F _ hall
  have htr : Algebra.trace ℚ F y' = Algebra.trace ℚ F y + ((Algebra.trace ℤ (𝓞 F) z : ℤ) : ℚ) := by
    rw [Algebra.coe_trace_int, show ((z : 𝓞 F) : F) = algebraMap (𝓞 F) F z from rfl, hz, map_sub]
    ring
  rw [htr]
  push_cast
  rw [mul_add, Complex.exp_add]
  have := Complex.exp_int_mul_two_pi_mul_I (-(Algebra.trace ℤ (𝓞 F) z))
  rw [show -(2 * (Real.pi : ℂ) * Complex.I) * ((Algebra.trace ℤ (𝓞 F) z : ℤ) : ℂ) =
      ((-(Algebra.trace ℤ (𝓞 F) z) : ℤ) : ℂ) * (2 * Real.pi * Complex.I) by push_cast; ring, this,
    mul_one]

/-- `e` is additive on elements with witnesses. -/
lemma sAddChar_add {x x' : F} (h : HasWit 𝔪 x) (h' : HasWit 𝔪 x') :
    sAddChar 𝔪 (x + x') = sAddChar 𝔪 x * sAddChar 𝔪 x' := by
  obtain ⟨y, hy1, hy2⟩ := h
  obtain ⟨y', hy1', hy2'⟩ := h'
  have hs1 : x + x' - (y + y') ∈ (placesOf 𝔪).integer F := by
    rw [show x + x' - (y + y') = (x - y) + (x' - y') by ring]; exact add_mem hy1 hy1'
  have hs2 : ∀ v ∈ placesOf 𝔪, v.valuation F (y + y') ≤ 1 :=
    fun v hv => (Valuation.map_add _ _ _).trans (max_le (hy2 v hv) (hy2' v hv))
  rw [sAddChar_eq_of_wit hs1 hs2, sAddChar_eq_of_wit hy1 hy2, sAddChar_eq_of_wit hy1' hy2',
    ← Complex.exp_add, map_add]
  push_cast
  ring_nf

/-- A witness exists when `x I ⊆ R` for an ideal `I` coprime to `𝔪`. -/
lemma hasWit_of_mul_mem (x : F) (I : Ideal (𝓞 F)) (hI : I ⊔ 𝔪 = ⊤)
    (hx : ∀ i ∈ I, x * algebraMap (𝓞 F) F i ∈ (placesOf 𝔪).integer F) : HasWit 𝔪 x := by
  obtain ⟨b, d, hd, hbd⟩ := IsFractionRing.div_surjective (A := 𝓞 F) x
  have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
  set N := Ideal.absNorm (Ideal.span {d}) with hN
  have hcop : IsCoprime I (𝔪 ^ N) := (Ideal.isCoprime_iff_sup_eq.mpr hI).pow_right
  obtain ⟨i, hi, w, hw, hiw⟩ := hcop.exists
  refine ⟨x * algebraMap (𝓞 F) F w, ?_, fun v hv => ?_⟩
  · have hw' : algebraMap (𝓞 F) F w = 1 - algebraMap (𝓞 F) F i := by
      rw [← map_one (algebraMap (𝓞 F) F), ← hiw, map_add]; ring
    have : x - x * algebraMap (𝓞 F) F w = x * algebraMap (𝓞 F) F i := by
      rw [hw']; ring
    rw [this]; exact hx i hi
  · have hvm : 𝔪 ≤ v.asIdeal := hv
    -- `d ∉ v^N`
    have hdN : d ∉ v.asIdeal ^ N := by
      intro hmem
      have hle : Ideal.span {d} ≤ v.asIdeal ^ N := (Ideal.span_singleton_le_iff_mem _).2 hmem
      have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
      rw [map_pow] at hdvd
      have hN0 : N ≠ 0 := by
        rw [hN, Ne, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot]; exact hd0
      have h2 : 2 ≤ Ideal.absNorm v.asIdeal := by
        have h0 : Ideal.absNorm v.asIdeal ≠ 0 := by
          rw [Ne, Ideal.absNorm_eq_zero_iff]; exact v.ne_bot
        have h1 : Ideal.absNorm v.asIdeal ≠ 1 := by
          rw [Ne, Ideal.absNorm_eq_one_iff]; exact v.isPrime.ne_top
        omega
      have := Nat.le_of_dvd (Nat.pos_of_ne_zero hN0) hdvd
      have h3 : 2 ^ N ≤ Ideal.absNorm v.asIdeal ^ N := Nat.pow_le_pow_left h2 N
      have h4 : N < 2 ^ N := Nat.lt_two_pow_self
      omega
    have hvd : exp (-(N : ℤ)) < v.valuation F (algebraMap (𝓞 F) F d) := by
      rw [val_alg, ← not_le, v.intValuation_le_pow_iff_mem]; exact hdN
    have hvw : v.valuation F (algebraMap (𝓞 F) F w) ≤ exp (-(N : ℤ)) := by
      rw [val_alg, v.intValuation_le_pow_iff_mem]
      exact Ideal.pow_right_mono hvm N hw
    have hdpos : v.valuation F (algebraMap (𝓞 F) F d) ≠ 0 := ne_zero_of_lt hvd
    have hxd : x * algebraMap (𝓞 F) F d = algebraMap (𝓞 F) F b := by
      rw [← hbd, div_mul_cancel₀]
      exact (map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 hd0
    have key : v.valuation F (x * algebraMap (𝓞 F) F w) * v.valuation F (algebraMap (𝓞 F) F d) ≤
        1 * v.valuation F (algebraMap (𝓞 F) F d) := by
      rw [← map_mul, show x * algebraMap (𝓞 F) F w * algebraMap (𝓞 F) F d =
        algebraMap (𝓞 F) F b * algebraMap (𝓞 F) F w by rw [← hxd]; ring, map_mul]
      calc v.valuation F (algebraMap (𝓞 F) F b) * v.valuation F (algebraMap (𝓞 F) F w)
          ≤ 1 * v.valuation F (algebraMap (𝓞 F) F d) :=
            mul_le_mul' (v.valuation_le_one b) (hvw.trans hvd.le)
        _ = _ := rfl
    exact le_of_mul_le_mul_ne key hdpos

variable {ι : F →+* ℂ}

/-- `a / gen 𝔞` has a witness. -/
lemma hasWit_div_gen (g : AllowedGen ι 𝔪) (𝔞 : Ideal (𝓞 F)) (h𝔞 : IsExterior 𝔪 𝔞)
    (a : SInt 𝔪) : HasWit 𝔪 ((a : F) / (g.gen 𝔞 : F)) := by
  apply hasWit_of_mul_mem _ 𝔞 h𝔞.2
  intro i hi
  have hm : algebraMap (𝓞 F) (SInt 𝔪) i ∈ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
    Ideal.mem_map_of_mem _ hi
  have := C3B.div_gen_mem g 𝔞 h𝔞 _ hm
  rw [coe_alg] at this
  rw [show (a : F) / (g.gen 𝔞 : F) * algebraMap (𝓞 F) F i =
    (a : F) * (algebraMap (𝓞 F) F i / (g.gen 𝔞 : F)) by ring]
  exact mul_mem a.2 this

/-! ### The inverse different -/

/-- For `P ∤ 𝔇`, some `z ∈ P⁻¹` has non-integral trace. -/
lemma exists_trace_not_int (P : Ideal (𝓞 F)) (hP0 : P ≠ ⊥)
    (hD : ¬ differentIdeal ℤ (𝓞 F) ≤ P) :
    ∃ z : F, (∀ p ∈ P, ∃ a : 𝓞 F, z * algebraMap (𝓞 F) F p = algebraMap (𝓞 F) F a) ∧
      ∀ n : ℤ, Algebra.trace ℚ F z ≠ n := by
  rw [differentialIdeal_le_iff (K := ℚ) (L := F) hP0, Submodule.map_le_iff_le_comap] at hD
  rw [SetLike.not_le_iff_exists] at hD
  obtain ⟨z, hz, hz'⟩ := hD
  have hP' : (P : FractionalIdeal (nonZeroDivisors (𝓞 F)) F) ≠ 0 := by
    simpa using hP0
  have hz2 : z ∈ ((P : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)⁻¹) := hz
  rw [FractionalIdeal.mem_inv_iff hP'] at hz2
  refine ⟨z, fun p hp => ?_, fun n hn => hz' ?_⟩
  · have := hz2 (algebraMap (𝓞 F) F p) ((FractionalIdeal.mem_coeIdeal _).2 ⟨p, hp, rfl⟩)
    obtain ⟨a, ha⟩ := (FractionalIdeal.mem_one_iff _).1 this
    exact ⟨a, ha.symm⟩
  · simp only [Submodule.mem_comap, LinearMap.coe_restrictScalars, Submodule.mem_one]
    exact ⟨n, by rw [hn]; simp⟩

/-- For `P` exterior and `z ∈ P⁻¹` with non-integral trace, `e(z) ≠ 1`. -/
lemma sAddChar_ne_one_of_dual (P : Ideal (𝓞 F)) (hPS : P ⊔ 𝔪 = ⊤) (z : F)
    (hz : ∀ p ∈ P, ∃ a : 𝓞 F, z * algebraMap (𝓞 F) F p = algebraMap (𝓞 F) F a)
    (htr : ∀ n : ℤ, Algebra.trace ℚ F z ≠ n) : sAddChar 𝔪 z ≠ 1 := by
  have hw : ∀ v ∈ placesOf 𝔪, v.valuation F z ≤ 1 := by
    intro v hv
    have hvm : 𝔪 ≤ v.asIdeal := hv
    have hPv : ¬ P ≤ v.asIdeal := by
      intro h
      apply v.isPrime.ne_top
      rw [eq_top_iff, ← hPS]
      exact sup_le h hvm
    obtain ⟨p, hp, hpv⟩ := SetLike.not_le_iff_exists.mp hPv
    obtain ⟨a, ha⟩ := hz p hp
    have h1 : v.valuation F (algebraMap (𝓞 F) F p) = 1 :=
      (HeightOneSpectrum.valuation_eq_one_iff_notMem v).2 hpv
    have := v.valuation_le_one (K := F) a
    change v.valuation F (algebraMap (𝓞 F) F a) ≤ 1 at this
    rw [← ha, map_mul, h1, mul_one] at this
    exact this
  rw [sAddChar_eq_of_wit (y := z) (by simp) hw]
  intro h
  rw [Complex.exp_eq_one_iff] at h
  obtain ⟨n, hn⟩ := h
  apply htr (-n)
  have h2 : ((Algebra.trace ℚ F z : ℚ) : ℂ) = ((-n : ℤ) : ℂ) := by
    have hpi : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
      simp [Real.pi_ne_zero, Complex.I_ne_zero]
    apply mul_left_cancel₀ hpi
    push_cast
    linear_combination -hn
  exact_mod_cast h2

/-! ### Primitivity at every level -/

section prim

variable {v : HeightOneSpectrum (𝓞 F)}

/-- `z (v R) ⊆ R` for `z ∈ v⁻¹`. -/
lemma mul_mem_of_mem_map (z : F)
    (hz : ∀ p ∈ v.asIdeal, ∃ a : 𝓞 F, z * algebraMap (𝓞 F) F p = algebraMap (𝓞 F) F a)
    {y : SInt 𝔪} (hy : y ∈ v.asIdeal.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    z * (y : F) ∈ (placesOf 𝔪).integer F := by
  rw [Ideal.map] at hy
  induction hy using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨p, hp, rfl⟩ := hx
    obtain ⟨a, ha⟩ := hz p hp
    rw [coe_alg, ha]
    exact (algebraMap (𝓞 F) (SInt 𝔪) a).2
  | zero => simp
  | add x y _ _ hx hy => rw [Subalgebra.coe_add, mul_add]; exact add_mem hx hy
  | smul a x _ hx =>
    rw [smul_eq_mul, Subalgebra.coe_mul, mul_left_comm]
    exact mul_mem a.2 hx

/-- Primitivity of `x ↦ e(x / gen(P^j))` on `R / P^j R`: for `x ∉ P^j R` there is `r ∈ R` with
`e(x r / gen(P^j)) ≠ 1`, when `P ∤ 𝔇`. -/
lemma exists_sAddChar_ne_one (g : AllowedGen ι 𝔪) (hv : v ∉ placesOf 𝔪)
    (hPS : v.asIdeal ⊔ 𝔪 = ⊤) (hD : ¬ differentIdeal ℤ (𝓞 F) ≤ v.asIdeal) {j : ℕ} (hj : 1 ≤ j)
    (x : SInt 𝔪) (hx : x ∉ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪))) :
    ∃ r : SInt 𝔪, sAddChar 𝔪 ((x : F) * (r : F) / (g.gen (v.asIdeal ^ j) : F)) ≠ 1 := by
  obtain ⟨z, hz, htr⟩ := exists_trace_not_int v.asIdeal v.ne_bot hD
  have hez := sAddChar_ne_one_of_dual v.asIdeal hPS z hz htr
  have hext : IsExterior 𝔪 (v.asIdeal ^ j) :=
    isExterior_pow ⟨v.ne_bot, hPS⟩ j
  set B := g.gen (v.asIdeal ^ j)
  have hB0 : (B : F) ≠ 0 := C3B.gen_ne_zero g _ hext
  have hBmem : B ∈ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
    rw [← g.span_gen _ hext]; exact Ideal.mem_span_singleton_self _
  have hB1 : B ∈ v.asIdeal.map (algebraMap (𝓞 F) (SInt 𝔪)) := by
    have : (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪)) ≤
        v.asIdeal.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
      Ideal.map_mono (by simpa using Ideal.pow_le_pow_right (I := v.asIdeal) hj)
    exact this hBmem
  -- `w = z B ∈ R`
  have hwR : z * (B : F) ∈ (placesOf 𝔪).integer F := mul_mem_of_mem_map z hz hB1
  set w : SInt 𝔪 := ⟨z * (B : F), hwR⟩
  -- valuations
  have hvz : v.valuation F z ≤ exp (1 : ℤ) := by
    obtain ⟨p, hp⟩ := exists_uniformizer (v := v)
    have hpm : p ∈ v.asIdeal := by
      rw [← HeightOneSpectrum.valuation_lt_one_iff_mem (K := F), hp]
      exact exp_lt_exp.2 (by norm_num) |>.trans_eq exp_zero
    obtain ⟨a, ha⟩ := hz p hpm
    have h1 := v.valuation_le_one (K := F) a
    change v.valuation F (algebraMap (𝓞 F) F a) ≤ 1 at h1
    rw [← ha, map_mul, hp] at h1
    have : v.valuation F z * exp (-1 : ℤ) * exp 1 ≤ 1 * exp 1 := mul_le_mul_left h1 _
    rwa [mul_assoc, ← exp_add, neg_add_cancel, exp_zero, mul_one, one_mul] at this
  have hvB := val_le_of_mem hv j hBmem
  have hvw : v.valuation F (w : F) ≤ exp (1 - (j : ℤ)) := by
    change v.valuation F (z * (B : F)) ≤ _
    rw [map_mul, show (1 - (j : ℤ)) = 1 + (-(j : ℤ)) by ring, exp_add]
    exact mul_le_mul' hvz hvB
  have hvx : exp (1 - (j : ℤ)) ≤ v.valuation F (x : F) := by
    have := exp_le_val_of_not_mem hv (j - 1) x (by rwa [Nat.sub_add_cancel hj])
    convert this using 2
    push_cast [Nat.cast_sub hj]; ring
  have hx0 : (x : F) ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hvx
    exact exp_ne_zero (le_antisymm hvx bot_le)
  have hvx0 : v.valuation F (x : F) ≠ 0 := by
    rw [Ne, map_eq_zero]; exact hx0
  -- `f = w / x` is `v`-integral
  have hvf : v.valuation F ((w : F) / (x : F)) ≤ 1 := by
    rw [map_div₀, div_le_one₀ (pos_iff_ne_zero.2 hvx0)]
    exact hvw.trans hvx
  obtain ⟨a, ha⟩ := exists_val_sub_le (v := v) j _ hvf
  -- `w - x a ∈ P^j R`
  set δ : SInt 𝔪 := w - x * algebraMap (𝓞 F) (SInt 𝔪) a
  have hδ : δ ∈ (v.asIdeal ^ j).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
    apply mem_of_val_le hv j
    have : (δ : F) = (x : F) * ((w : F) / (x : F) - algebraMap (𝓞 F) F a) := by
      simp only [δ, Subalgebra.coe_sub, Subalgebra.coe_mul, coe_alg]
      field_simp
    rw [this, map_mul]
    calc v.valuation F (x : F) * v.valuation F ((w : F) / (x : F) - algebraMap (𝓞 F) F a)
        ≤ 1 * exp (-(j : ℤ)) := mul_le_mul' (val_le_one hv x) ha
      _ = _ := one_mul _
  refine ⟨algebraMap (𝓞 F) (SInt 𝔪) a, fun h1 => hez ?_⟩
  have hzeq : z = (x : F) * ((algebraMap (𝓞 F) (SInt 𝔪) a : SInt 𝔪) : F) / (B : F) +
      (δ : F) / (B : F) := by
    simp only [δ, Subalgebra.coe_sub, Subalgebra.coe_mul]
    change z = _ + (z * (B : F) - _) / (B : F)
    field_simp
    ring
  rw [hzeq, C3B.sAddChar_add_mem _ _ (C3B.div_gen_mem g _ hext δ hδ), h1]

end prim

end C3I

end ArtinPrimitiveRoots
end

section
/-! # C3M_Base: hypotheses from section A, finite quotients `R/𝔞R`, residue-symbol algebra

* `HypAdd 𝔪`: `e` is additive on `F` (needs the existence of `sAddChar` witnesses).
* `HypChi ι 𝔪`: at every exterior prime `P`, `χ_P` is multiplicative on `R` and `χ_P(x)⁶ = 1`
  for `x ∉ PR`.
-/

open NumberField IsDedekindDomain UniqueFactorizationMonoid

namespace ArtinPrimitiveRoots

namespace C3M

variable {F : Type*} [Field F] [NumberField F]

variable {𝔪 : Ideal (𝓞 F)}

/-! ### Ideals -/

lemma exterior_of_mem_factors {𝔞 Q : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞)
    (hQ : Q ∈ normalizedFactors 𝔞) : Q.IsPrime ∧ IsExterior 𝔪 Q := by
  have hpr : Prime Q := prime_of_normalized_factor Q hQ
  refine ⟨Ideal.isPrime_of_prime hpr, hpr.ne_zero, ?_⟩
  have hle : 𝔞 ≤ Q := Ideal.le_of_dvd (dvd_of_mem_normalizedFactors hQ)
  exact eq_top_iff.mpr (h𝔞.2 ▸ sup_le_sup_right hle 𝔪)

/-- `𝓞 → R/𝔞R` is onto for exterior `𝔞`. -/
lemma exists_sub_mem_map {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) (r : SInt 𝔪) :
    ∃ a : 𝓞 F, r - algebraMap (𝓞 F) (SInt 𝔪) a ∈ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  let O' : Submodule (𝓞 F) (SInt 𝔪) := LinearMap.range (Algebra.linearMap (𝓞 F) (SInt 𝔪))
  let J : Ideal (𝓞 F) := O'.colon {r}
  have hJ : J ⊔ 𝔞 = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal _ hne
    have h𝔞M : 𝔞 ≤ M := le_trans le_sup_right hJM
    have hM0 : M ≠ ⊥ := fun h => h𝔞.1 (eq_bot_iff.mpr (h ▸ h𝔞M))
    let v : HeightOneSpectrum (𝓞 F) := ⟨M, hM.isPrime, hM0⟩
    have hvS : v ∉ placesOf 𝔪 := by
      intro hv
      have : (⊤ : Ideal (𝓞 F)) ≤ M := h𝔞.2 ▸ sup_le h𝔞M hv
      exact hM.ne_top (eq_top_iff.mpr this)
    obtain ⟨n, ⟨d, hd⟩, hnd⟩ := v.exists_primeCompl_mul_eq_of_integer (K := F) (r : F) (r.2 v hvS)
    have hdJ : d ∈ J := by
      rw [Submodule.mem_colon_singleton]
      refine ⟨n, ?_⟩
      apply Subtype.ext
      show ((algebraMap (𝓞 F) (SInt 𝔪) n : SInt 𝔪) : F) = ((d • r : SInt 𝔪) : F)
      rw [C3B.coe_algebraMap_SInt, Algebra.smul_def, Subalgebra.coe_mul, C3B.coe_algebraMap_SInt]
      have h2 : ((n : 𝓞 F) : F) = (d : F) * (r : F) := by rw [mul_comm]; exact hnd.symm
      exact h2
    exact hd (le_trans le_sup_left hJM hdJ)
  obtain ⟨j, hj, a, ha, hja⟩ := Submodule.mem_sup.mp (hJ ▸ Submodule.mem_top : (1 : 𝓞 F) ∈ J ⊔ 𝔞)
  rw [Submodule.mem_colon_singleton] at hj
  obtain ⟨b, hb⟩ := hj
  refine ⟨b, ?_⟩
  have hb' : algebraMap (𝓞 F) (SInt 𝔪) b = algebraMap (𝓞 F) (SInt 𝔪) j * r := by
    rw [← Algebra.smul_def]; exact hb
  have : r - algebraMap (𝓞 F) (SInt 𝔪) b = algebraMap (𝓞 F) (SInt 𝔪) a * r := by
    rw [hb']
    have h1 : (1 : SInt 𝔪) = algebraMap (𝓞 F) (SInt 𝔪) j + algebraMap (𝓞 F) (SInt 𝔪) a := by
      rw [← map_add, hja, map_one]
    linear_combination r * h1
  rw [this]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha)

lemma finite_quot {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) :
    Finite (SInt 𝔪 ⧸ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) := by
  have : Finite (𝓞 F ⧸ 𝔞) := Ring.HasFiniteQuotients.finiteQuotient h𝔞.1
  let f := Ideal.quotientMap (𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) (algebraMap (𝓞 F) (SInt 𝔪))
    Ideal.le_comap_map
  refine Finite.of_surjective f ?_
  intro y
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨a, ha⟩ := exists_sub_mem_map h𝔞 r
  refine ⟨Ideal.Quotient.mk 𝔞 a, ?_⟩
  rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
  rw [← neg_mem_iff, neg_sub]; exact ha

/-! ### Residue symbols -/

variable {ι : F →+* ℂ}

/-! ### Generators -/

end C3M

end ArtinPrimitiveRoots
end

section
/-!
# L2B_Bound: crude norm bounds for the arithmetic factors

`|e| ≤ 1`, `|χ_𝔞| ≤ 1`, `|g_𝔞(k)| ≤ q_𝔞`, `|γ_j(𝔠)| ≤ q_𝔠^{1/2}`, `|F(𝔰,𝔄,h)| ≤ q_𝔰 q_𝔄`,
`|Λ(𝔞)|, |G(𝔞)| ≤ q_𝔞^{1/2}`, `|ϑ(𝔞)| ≤ q_𝔞`.
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField IsDedekindDomain UniqueFactorizationMonoid

variable {F : Type*} [Field F] [NumberField F]

/-! ### Generic lemmas -/

theorem norm_prod_map_le {α : Type*} (s : Multiset α) (f : α → ℂ) (b : α → ℝ)
    (hb : ∀ a ∈ s, 0 ≤ b a) (h : ∀ a ∈ s, ‖f a‖ ≤ b a) :
    ‖(s.map f).prod‖ ≤ (s.map b).prod := by
  induction s using Multiset.induction_on with
  | empty => simp
  | cons a s ih =>
    simp only [Multiset.map_cons, Multiset.prod_cons, norm_mul]
    have hs : ∀ a ∈ s, 0 ≤ b a := fun x hx => hb x (Multiset.mem_cons_of_mem hx)
    exact mul_le_mul (h a (Multiset.mem_cons_self _ _))
      (ih hs fun x hx => h x (Multiset.mem_cons_of_mem hx)) (norm_nonneg _)
      (hb a (Multiset.mem_cons_self _ _))

theorem norm_finsum_le {α : Type*} [Finite α] (f : α → ℂ) (B : ℝ) (h : ∀ a, ‖f a‖ ≤ B) :
    ‖∑ᶠ a, f a‖ ≤ Nat.card α * B := by
  have := Fintype.ofFinite α
  rw [finsum_eq_sum_of_fintype, Nat.card_eq_fintype_card]
  refine (norm_sum_le _ _).trans ?_
  calc ∑ a, ‖f a‖ ≤ ∑ _a : α, B := Finset.sum_le_sum fun a _ => h a
    _ = Fintype.card α * B := by simp

theorem norm_prod_factors_le_sqrt (s : Multiset (Ideal (𝓞 F))) (f : Ideal (𝓞 F) → ℂ)
    (h : ∀ P ∈ s, ‖f P‖ ≤ Real.sqrt (Ideal.absNorm P)) :
    ‖(s.map f).prod‖ ≤ Real.sqrt (Ideal.absNorm s.prod) := by
  induction s using Multiset.induction_on with
  | empty => simp
  | cons a s ih =>
    simp only [Multiset.map_cons, Multiset.prod_cons, norm_mul, map_mul, Nat.cast_mul]
    rw [Real.sqrt_mul (Nat.cast_nonneg _)]
    exact mul_le_mul (h a (Multiset.mem_cons_self _ _))
      (ih fun x hx => h x (Multiset.mem_cons_of_mem hx)) (norm_nonneg _) (Real.sqrt_nonneg _)

/-! ### Characters -/

theorem norm_sAddChar_le (𝔪 : Ideal (𝓞 F)) (x : F) : ‖sAddChar 𝔪 x‖ ≤ 1 := by
  unfold sAddChar
  split_ifs
  · rw [Complex.norm_exp]
    simp
  · simp

theorem norm_sexticResidueSymbol_le (ι : F →+* ℂ) (𝔪 P : Ideal (𝓞 F)) (x : SInt 𝔪) :
    ‖sexticResidueSymbol ι 𝔪 P x‖ ≤ 1 := by
  unfold sexticResidueSymbol
  split_ifs with h0 h
  · simp
  · have h6 : (ι ((h.choose : 𝓞 F) : F)) ^ 6 = 1 := by
      have h' : ((h.choose : 𝓞 F) : F) ^ 6 = 1 := by
        have := congrArg (algebraMap (𝓞 F) F) h.choose_spec.1
        simpa using this
      rw [← map_pow, h', map_one]
    exact (Complex.norm_eq_one_of_pow_eq_one h6 (by norm_num)).le
  · simp

theorem norm_residueSymbol_le (ι : F →+* ℂ) (𝔪 𝔞 : Ideal (𝓞 F)) (x : SInt 𝔪) :
    ‖residueSymbol ι 𝔪 𝔞 x‖ ≤ 1 := by
  unfold residueSymbol
  refine (norm_prod_map_le _ _ (fun _ => 1) (fun _ _ => zero_le_one)
    fun P _ => norm_sexticResidueSymbol_le ι 𝔪 P x).trans ?_
  simp

theorem norm_cubicResidueChar_le (ι : F →+* ℂ) (P : Ideal (𝓞 F)) (x : 𝓞 F ⧸ P) :
    ‖cubicResidueChar ι P x‖ ≤ 1 := by
  unfold cubicResidueChar
  split_ifs with h0 h
  · simp
  · have h3 : (ι ((h.choose : 𝓞 F) : F)) ^ 3 = 1 := by
      have h' : ((h.choose : 𝓞 F) : F) ^ 3 = 1 := by
        have := congrArg (algebraMap (𝓞 F) F) h.choose_spec.1
        simpa using this
      rw [← map_pow, h', map_one]
    exact (Complex.norm_eq_one_of_pow_eq_one h3 (by norm_num)).le
  · simp

/-! ### Quotients -/

variable {𝔪 : Ideal (𝓞 F)}

theorem card_quot_le {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) :
    Nat.card (SInt 𝔪 ⧸ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) ≤ Ideal.absNorm 𝔞 := by
  have : Finite (𝓞 F ⧸ 𝔞) := Ring.HasFiniteQuotients.finiteQuotient h𝔞.1
  let f := Ideal.quotientMap (𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) (algebraMap (𝓞 F) (SInt 𝔪))
    Ideal.le_comap_map
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := C3M.exists_sub_mem_map h𝔞 r
    refine ⟨Ideal.Quotient.mk 𝔞 a, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq]
    rw [← neg_mem_iff, neg_sub]; exact ha
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  exact Nat.card_le_card_of_surjective f hf

variable {ι : F →+* ℂ}

theorem norm_gaussSumAt_le (g : AllowedGen ι 𝔪) {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞)
    (k : F) : ‖gaussSumAt g 𝔞 k‖ ≤ Ideal.absNorm 𝔞 := by
  have := C3M.finite_quot h𝔞
  unfold gaussSumAt
  refine (norm_finsum_le _ 1 fun v => ?_).trans ?_
  · rw [norm_mul]
    exact mul_le_one₀ (norm_residueSymbol_le ι 𝔪 𝔞 _) (norm_nonneg _) (norm_sAddChar_le _ _)
  · rw [mul_one]; exact_mod_cast card_quot_le h𝔞

theorem norm_gaussPhase_le (g : AllowedGen ι 𝔪) (j : ℕ) {𝔠 : Ideal (𝓞 F)}
    (h𝔠 : IsExterior 𝔪 𝔠) : ‖gaussPhase g j 𝔠‖ ≤ Real.sqrt (Ideal.absNorm 𝔠) := by
  have := C3M.finite_quot h𝔠
  unfold gaussPhase
  have hN : (0 : ℝ) < Ideal.absNorm 𝔠 := by
    exact_mod_cast Nat.pos_of_ne_zero (fun h => h𝔠.1 (Ideal.absNorm_eq_zero_iff.1 h))
  have hs : 0 < Real.sqrt (Ideal.absNorm 𝔠) := Real.sqrt_pos.2 hN
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hs.le]
  have hsum : ‖∑ᶠ x : SInt 𝔪 ⧸ 𝔠.map (algebraMap (𝓞 F) (SInt 𝔪)),
      residueSymbol ι 𝔪 𝔠 (quotLift x) ^ j * sAddChar 𝔪 ((quotLift x : F) / (g.gen 𝔠 : F))‖ ≤
      Ideal.absNorm 𝔠 := by
    refine (norm_finsum_le _ 1 fun v => ?_).trans ?_
    · rw [norm_mul, norm_pow]
      exact mul_le_one₀ (pow_le_one₀ (norm_nonneg _) (norm_residueSymbol_le ι 𝔪 𝔠 _))
        (norm_nonneg _) (norm_sAddChar_le _ _)
    · rw [mul_one]; exact_mod_cast card_quot_le h𝔠
  rw [inv_mul_le_iff₀ hs]
  calc _ ≤ (Ideal.absNorm 𝔠 : ℝ) := hsum
    _ = Real.sqrt (Ideal.absNorm 𝔠) * Real.sqrt (Ideal.absNorm 𝔠) :=
      (Real.mul_self_sqrt hN.le).symm

theorem norm_poissonFactor_le (g : AllowedGen ι 𝔪) {𝔰 𝔄 : Ideal (𝓞 F)} (h𝔰 : IsExterior 𝔪 𝔰)
    (h𝔄 : IsExterior 𝔪 𝔄) (h : SInt 𝔪) :
    ‖poissonFactor g 𝔰 𝔄 h‖ ≤ Ideal.absNorm 𝔰 * Ideal.absNorm 𝔄 := by
  have := C3M.finite_quot h𝔰
  unfold poissonFactor
  refine (norm_finsum_le _ (Ideal.absNorm 𝔄) fun d => ?_).trans ?_
  · split_ifs
    · rw [norm_mul]
      calc _ ≤ 1 * (Ideal.absNorm 𝔄 : ℝ) :=
            mul_le_mul (norm_residueSymbol_le ι 𝔪 𝔰 _) (norm_gaussSumAt_le g h𝔄 _)
              (norm_nonneg _) zero_le_one
        _ = _ := one_mul _
    · simp
  · gcongr; exact_mod_cast card_quot_le h𝔰

theorem norm_cubicJacobiSum_le (ι : F →+* ℂ) {P : Ideal (𝓞 F)} (hP : P ≠ ⊥) :
    ‖cubicJacobiSum ι P‖ ≤ Ideal.absNorm P := by
  have : Finite (𝓞 F ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP
  unfold cubicJacobiSum
  refine (norm_finsum_le _ 1 fun x => ?_).trans ?_
  · rw [norm_mul]
    exact mul_le_one₀ (norm_cubicResidueChar_le ι P _) (norm_nonneg _)
      (norm_cubicResidueChar_le ι P _)
  · rw [mul_one, Ideal.absNorm_apply, Submodule.cardQuot_apply]

theorem norm_gaussLambda_le (ι : F →+* ℂ) {𝔞 : Ideal (𝓞 F)} (h𝔞 : 𝔞 ≠ ⊥) :
    ‖gaussLambda ι 𝔞‖ ≤ Real.sqrt (Ideal.absNorm 𝔞) := by
  unfold gaussLambda
  conv_rhs => rw [← Ideal.prod_normalizedFactors_eq_self h𝔞]
  refine norm_prod_factors_le_sqrt _ _ fun P hP => ?_
  have hP0 : P ≠ ⊥ := (prime_of_normalized_factor P hP).ne_zero
  have hN : (0 : ℝ) < Ideal.absNorm P := by
    exact_mod_cast Nat.pos_of_ne_zero (fun h => hP0 (Ideal.absNorm_eq_zero_iff.1 h))
  have hs : 0 < Real.sqrt (Ideal.absNorm P) := Real.sqrt_pos.2 hN
  rw [norm_neg, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hs.le,
    inv_mul_le_iff₀ hs, Real.mul_self_sqrt hN.le]
  exact norm_cubicJacobiSum_le ι hP0

theorem norm_gaussG_le (g : AllowedGen ι 𝔪) {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) :
    ‖gaussG g 𝔞‖ ≤ Real.sqrt (Ideal.absNorm 𝔞) := by
  unfold gaussG
  conv_rhs => rw [← Ideal.prod_normalizedFactors_eq_self h𝔞.1]
  refine norm_prod_factors_le_sqrt _ _ fun P hP => ?_
  have hPe := (C3M.exterior_of_mem_factors h𝔞 hP).2
  rw [norm_mul, Complex.norm_conj]
  calc _ ≤ 1 * Real.sqrt (Ideal.absNorm P) :=
        mul_le_mul (norm_sexticResidueSymbol_le ι 𝔪 P _) (norm_gaussPhase_le g 3 hPe)
          (norm_nonneg _) zero_le_one
    _ = _ := one_mul _

theorem norm_thetaChar_le (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪)
    {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) :
    ‖χ.thetaChar g 𝔞‖ ≤ Ideal.absNorm 𝔞 := by
  unfold HeckeChar.thetaChar
  rw [norm_mul, norm_mul, Complex.norm_conj, Complex.norm_conj]
  have h1 := norm_gaussLambda_le ι h𝔞.1
  have h2 := norm_gaussG_le g h𝔞
  have h3 := T12B.norm_le_one h𝔪 χ 𝔞
  calc _ ≤ Real.sqrt (Ideal.absNorm 𝔞) * Real.sqrt (Ideal.absNorm 𝔞) * 1 := by
        gcongr
    _ = _ := by rw [mul_one, Real.mul_self_sqrt (Nat.cast_nonneg _)]

end ArtinPrimitiveRoots.L2B
end

section
/-! # L92M_Basic: Mellin transforms of smooth functions supported in `[a, b] ⊂ (0, ∞)`

For `g : ℝ → ℝ` continuous with `tsupport g ⊆ Icc a b`, `0 < a`, the Mellin transform of
`(g · : ℂ)` is entire and bounded on vertical strips; for smooth `g`, integration by parts
(`D g t = t g'(t)`, `mellin (D g) s = -s mellin g s`) gives decay faster than any power of `|Im s|`.
-/

namespace ArtinPrimitiveRoots.L92M

open Complex MeasureTheory Set Filter Topology Asymptotics
open scoped Interval ContDiff

section General

variable {g : ℝ → ℝ} {a b : ℝ}

lemma vanish_of_tsupport (ha : 0 < a) (hs : tsupport g ⊆ Icc a b) (t : ℝ)
    (ht : t ∉ Ioo (a / 2) (max a b + 1)) : g t = 0 := by
  refine image_eq_zero_of_notMem_tsupport fun h => ht ?_
  have := hs h
  exact ⟨by linarith [this.1], by linarith [this.2, le_max_right a b]⟩

lemma lt_bounds (ha : 0 < a) : 0 < a / 2 ∧ a / 2 < max a b + 1 :=
  ⟨by linarith, by linarith [le_max_left a b]⟩

lemma cpow_continuousOn (s : ℂ) : ContinuousOn (fun t : ℝ => (t : ℂ) ^ s) (Ioi 0) :=
  fun _ ht => (continuousAt_ofReal_cpow_const _ _ (Or.inr (ne_of_gt ht))).continuousWithinAt

lemma hasCompactSupport_of_tsupport (hs : tsupport g ⊆ Icc a b) : HasCompactSupport g :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport g) hs

lemma mellinConvergent_of_tsupport (hc : Continuous g) (ha : 0 < a) (hs : tsupport g ⊆ Icc a b)
    (s : ℂ) : MellinConvergent (fun t => (g t : ℂ)) s := by
  unfold MellinConvergent
  have h1 : IntegrableOn (fun t : ℝ => (t : ℂ) ^ (s - 1) • (g t : ℂ)) (Icc (a / 2) (max a b + 1)) := by
    refine ContinuousOn.integrableOn_compact isCompact_Icc ?_
    refine ((cpow_continuousOn (s - 1)).mono ?_).smul (continuous_ofReal.comp hc).continuousOn
    intro t ht
    exact lt_of_lt_of_le (lt_bounds (b := b) ha).1 ht.1
  refine h1.of_forall_sdiff_eq_zero measurableSet_Ioi ?_
  intro t ht
  have : t ∉ Ioo (a / 2) (max a b + 1) := fun h' => ht.2 (Ioo_subset_Icc_self h')
  simp [vanish_of_tsupport ha hs t this]

lemma mellin_eq_intervalIntegral (ha : 0 < a) (hs : tsupport g ⊆ Icc a b) (s : ℂ) :
    mellin (fun t => (g t : ℂ)) s =
      ∫ t in (a / 2)..(max a b + 1), (t : ℂ) ^ (s - 1) * (g t : ℂ) := by
  rw [mellin, intervalIntegral.integral_of_le (lt_bounds (b := b) ha).2.le]
  refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi ?_ ?_
  · intro t ht
    exact lt_trans (lt_bounds (b := b) ha).1 ht.1
  · intro t ht
    have : t ∉ Ioo (a / 2) (max a b + 1) := fun h' => ht.2 ⟨h'.1, h'.2.le⟩
    simp [vanish_of_tsupport ha hs t this]

lemma mellin_differentiable_of_tsupport (hc : Continuous g) (ha : 0 < a)
    (hs : tsupport g ⊆ Icc a b) : Differentiable ℂ (mellin (fun t => (g t : ℂ))) := by
  intro s
  have hF : LocallyIntegrableOn (fun t => (g t : ℂ)) (Ioi 0) :=
    (continuous_ofReal.comp hc).locallyIntegrable.locallyIntegrableOn _
  have htop : (fun t => (g t : ℂ)) =ᶠ[atTop] fun _ => 0 := by
    filter_upwards [eventually_gt_atTop (max a b + 1)] with t ht
    simp [vanish_of_tsupport ha hs t fun h => absurd h.2 (not_lt.mpr ht.le)]
  have hbot : (fun t => (g t : ℂ)) =ᶠ[𝓝[>] 0] fun _ => 0 := by
    filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < a / 2 by linarith)] with t ht
    simp [vanish_of_tsupport ha hs t fun h => absurd h.1 (not_lt.mpr ht.2.le)]
  exact mellin_differentiableAt_of_isBigO_rpow (a := s.re + 1) (b := s.re - 1) hF
    ((isBigO_zero _ _).congr' htop.symm EventuallyEq.rfl) (by linarith)
    ((isBigO_zero _ _).congr' hbot.symm EventuallyEq.rfl) (by linarith)

/-- Boundedness of the Mellin transform on vertical strips. -/
lemma mellin_bounded_strip (hc : Continuous g) (ha : 0 < a) (hs : tsupport g ⊆ Icc a b)
    (σ₁ σ₂ : ℝ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ σ₂ →
      ‖mellin (fun t => (g t : ℂ)) s‖ ≤ C := by
  set α := a / 2
  set β := max a b + 1
  have hαβ := lt_bounds (b := b) ha
  obtain ⟨M, hM⟩ := hc.bounded_above_of_compact_support (hasCompactSupport_of_tsupport hs)
  have hcomp : IsCompact (Icc σ₁ σ₂ ×ˢ Icc α β) := isCompact_Icc.prod isCompact_Icc
  have hcont : ContinuousOn (fun p : ℝ × ℝ => p.2 ^ (p.1 - 1)) (Icc σ₁ σ₂ ×ˢ Icc α β) := by
    intro p hp
    refine ContinuousAt.continuousWithinAt ?_
    refine ContinuousAt.rpow continuousAt_snd (continuousAt_fst.sub continuousAt_const) ?_
    left
    have := hp.2.1
    exact ne_of_gt (lt_of_lt_of_le hαβ.1 this)
  obtain ⟨B, hB⟩ := hcomp.exists_bound_of_continuousOn hcont
  refine ⟨max (B * max M 0 * (β - α)) 0, le_max_right _ _, fun s h1 h2 => ?_⟩
  rw [mellin_eq_intervalIntegral ha hs]
  refine le_trans ?_ (le_max_left _ _)
  have : ∀ t ∈ Ι α β, ‖(t : ℂ) ^ (s - 1) * (g t : ℂ)‖ ≤ B * max M 0 := by
    intro t ht
    have ht2 : t ∈ Ioc α β := by rwa [uIoc_of_le hαβ.2.le] at ht
    have ht' : t ∈ Icc α β := ⟨ht2.1.le, ht2.2⟩
    have htpos : 0 < t := lt_of_lt_of_le hαβ.1 ht'.1
    rw [norm_mul, norm_cpow_eq_rpow_re_of_pos htpos, norm_real]
    have hb := hB (s.re, t) ⟨⟨h1, h2⟩, ht'⟩
    simp only [Real.norm_eq_abs] at hb
    rw [abs_of_nonneg (Real.rpow_nonneg htpos.le _)] at hb
    have hgt : ‖g t‖ ≤ max M 0 := le_trans (hM t) (le_max_left _ _)
    exact mul_le_mul hb hgt (norm_nonneg _) (le_trans (Real.rpow_nonneg htpos.le _) hb)
  have := intervalIntegral.norm_integral_le_of_norm_le_const this
  rwa [abs_of_pos (sub_pos.mpr hαβ.2)] at this

end General

section IBP

variable {g : ℝ → ℝ} {a b : ℝ}

/-- `D g t = t g'(t)`. -/
noncomputable def Dop (g : ℝ → ℝ) : ℝ → ℝ := fun t => t * deriv g t

lemma tsupport_Dop_subset (g : ℝ → ℝ) : tsupport (Dop g) ⊆ tsupport g :=
  (tsupport_mul_subset_right (f := fun t => t)).trans tsupport_deriv_subset

lemma contDiff_Dop (hg : ContDiff ℝ ∞ g) : ContDiff ℝ ∞ (Dop g) :=
  contDiff_id.mul (contDiff_infty_iff_deriv.mp hg).2

lemma hasDerivAt_ofReal_cpow (s : ℂ) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (t : ℂ) ^ (s - 1)) t := by
  have h1 : (t : ℂ) ∈ slitPlane := ofReal_mem_slitPlane.mpr ht
  have := ((hasDerivAt_id (t : ℂ)).cpow_const (c := s) h1).comp_ofReal
  simpa using this

/-- Integration by parts: `mellin (t g'(t)) s = -s mellin g s`. -/
lemma mellin_Dop (hg : ContDiff ℝ ∞ g) (ha : 0 < a) (hs : tsupport g ⊆ Icc a b) (s : ℂ) :
    mellin (fun t => (Dop g t : ℂ)) s = -s * mellin (fun t => (g t : ℂ)) s := by
  have hs' : tsupport (Dop g) ⊆ Icc a b := (tsupport_Dop_subset g).trans hs
  rw [mellin_eq_intervalIntegral ha hs', mellin_eq_intervalIntegral ha hs]
  set α := a / 2
  set β := max a b + 1
  have hαβ := lt_bounds (b := b) ha
  have hdiff : Differentiable ℝ g := hg.differentiable (by simp)
  have hcd : Continuous (deriv g) := hg.continuous_deriv (by simp)
  have hpos : ∀ t ∈ uIcc α β, 0 < t := by
    intro t ht
    rw [uIcc_of_le hαβ.2.le] at ht
    exact lt_of_lt_of_le hαβ.1 ht.1
  have h1 : ∫ t in α..β, (t : ℂ) ^ (s - 1) * ((Dop g t : ℝ) : ℂ) =
      ∫ t in α..β, (t : ℂ) ^ s * ((deriv g t : ℝ) : ℂ) := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    have htc : (t : ℂ) ≠ 0 := ofReal_ne_zero.mpr (hpos t ht).ne'
    simp only [Dop, ofReal_mul]
    rw [← mul_assoc]
    congr 1
    conv_rhs => rw [show s = (s - 1) + 1 by ring, cpow_add _ _ htc, cpow_one]
  rw [h1]
  have hu : ∀ t ∈ uIcc α β, HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (t : ℂ) ^ (s - 1)) t :=
    fun t ht => hasDerivAt_ofReal_cpow s (hpos t ht)
  have hv : ∀ t ∈ uIcc α β, HasDerivAt (fun y : ℝ => (g y : ℂ)) ((deriv g t : ℝ) : ℂ) t :=
    fun t _ => (hdiff t).hasDerivAt.ofReal_comp
  have hu' : IntervalIntegrable (fun t : ℝ => s * (t : ℂ) ^ (s - 1)) volume α β := by
    refine ContinuousOn.intervalIntegrable ?_
    exact continuousOn_const.mul ((cpow_continuousOn (s - 1)).mono fun t ht => hpos t ht)
  have hv' : IntervalIntegrable (fun t : ℝ => ((deriv g t : ℝ) : ℂ)) volume α β :=
    (continuous_ofReal.comp hcd).intervalIntegrable _ _
  rw [intervalIntegral.integral_mul_deriv_eq_deriv_mul hu hv hu' hv']
  have hgα : g α = 0 := vanish_of_tsupport ha hs α (fun h => lt_irrefl _ h.1)
  have hgβ : g β = 0 := vanish_of_tsupport ha hs β (fun h => lt_irrefl _ h.2)
  rw [hgα, hgβ]
  simp only [ofReal_zero, mul_zero, sub_zero, zero_sub]
  rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_neg]
  refine intervalIntegral.integral_congr fun t _ => ?_
  ring

lemma mellin_Dop_iterate (hg : ContDiff ℝ ∞ g) (ha : 0 < a) (hs : tsupport g ⊆ Icc a b)
    (N : ℕ) : ContDiff ℝ ∞ (Dop^[N] g) ∧ tsupport (Dop^[N] g) ⊆ Icc a b ∧
      ∀ s : ℂ, mellin (fun t => (Dop^[N] g t : ℂ)) s = (-s) ^ N * mellin (fun t => (g t : ℂ)) s := by
  induction N with
  | zero => exact ⟨hg, hs, fun s => by simp⟩
  | succ N ih =>
    obtain ⟨h1, h2, h3⟩ := ih
    rw [Function.iterate_succ_apply']
    refine ⟨contDiff_Dop h1, (tsupport_Dop_subset _).trans h2, fun s => ?_⟩
    rw [mellin_Dop h1 ha h2, h3, pow_succ]
    ring

lemma one_add_pow_le (u : ℝ) (hu : 0 ≤ u) (N : ℕ) : (1 + u) ^ N ≤ 2 ^ N * (1 + u ^ N) := by
  rcases le_total u 1 with h | h
  · calc (1 + u) ^ N ≤ 2 ^ N := pow_le_pow_left₀ (by linarith) (by linarith) N
      _ ≤ 2 ^ N * (1 + u ^ N) := le_mul_of_one_le_right (by positivity)
          (by linarith [pow_nonneg hu N])
  · calc (1 + u) ^ N ≤ (2 * u) ^ N := pow_le_pow_left₀ (by linarith) (by linarith) N
      _ = 2 ^ N * u ^ N := mul_pow _ _ _
      _ ≤ 2 ^ N * (1 + u ^ N) := by gcongr; linarith

/-- Rapid decay on vertical strips, with a nonnegative constant. -/
lemma mellin_decay_aux (hg : ContDiff ℝ ∞ g) (ha : 0 < a) (hs : tsupport g ⊆ Icc a b)
    (N : ℕ) (σ₁ σ₂ : ℝ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ σ₂ →
      ‖mellin (fun t => (g t : ℂ)) s‖ ≤ C / (1 + |s.im|) ^ N := by
  obtain ⟨h1, h2, h3⟩ := mellin_Dop_iterate hg ha hs N
  obtain ⟨C₀, hC₀, hb₀⟩ := mellin_bounded_strip hg.continuous ha hs σ₁ σ₂
  obtain ⟨C₁, hC₁, hb₁⟩ := mellin_bounded_strip h1.continuous ha h2 σ₁ σ₂
  refine ⟨2 ^ N * (C₀ + C₁), by positivity, fun s hs1 hs2 => ?_⟩
  have hpos : 0 < (1 + |s.im|) ^ N := by positivity
  rw [le_div_iff₀ hpos]
  have e1 : ‖s‖ ^ N * ‖mellin (fun t => (g t : ℂ)) s‖ ≤ C₁ := by
    have := hb₁ s hs1 hs2
    rw [h3 s, norm_mul, norm_pow, norm_neg] at this
    exact this
  have e0 := hb₀ s hs1 hs2
  have him : |s.im| ≤ ‖s‖ := abs_im_le_norm s
  calc ‖mellin (fun t => (g t : ℂ)) s‖ * (1 + |s.im|) ^ N
      ≤ ‖mellin (fun t => (g t : ℂ)) s‖ * (2 ^ N * (1 + |s.im| ^ N)) := by
        gcongr; exact one_add_pow_le _ (abs_nonneg _) N
    _ ≤ ‖mellin (fun t => (g t : ℂ)) s‖ * (2 ^ N * (1 + ‖s‖ ^ N)) := by
        gcongr
    _ = 2 ^ N * (‖mellin (fun t => (g t : ℂ)) s‖ + ‖s‖ ^ N * ‖mellin (fun t => (g t : ℂ)) s‖) := by
        ring
    _ ≤ 2 ^ N * (C₀ + C₁) := by gcongr

end IBP

section Main

variable (f : ℝ → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (a b : ℝ) (ha : 0 < a)
  (hab : tsupport f ⊆ Set.Icc a b)

include hf ha hab

omit hf ha hab in
/-- M0 -/
theorem exists_tsupport_subset_Icc (hfc : HasCompactSupport f)
    (hfs : tsupport f ⊆ Set.Ioi 0) : ∃ a b : ℝ, 0 < a ∧ tsupport f ⊆ Set.Icc a b := by
  rcases (tsupport f).eq_empty_or_nonempty with he | hne
  · exact ⟨1, 1, one_pos, by simp [he]⟩
  · obtain ⟨m, hm, hmin⟩ := hfc.isCompact.exists_isMinOn hne continuousOn_id
    obtain ⟨M, hM⟩ := hfc.isCompact.bddAbove
    exact ⟨m, M, hfs hm, fun t ht => ⟨hmin ht, hM ht⟩⟩

/-- M3a -/
theorem mellin_differentiable : Differentiable ℂ (mellin (fun u : ℝ => (f u : ℂ))) :=
  mellin_differentiable_of_tsupport hf.continuous ha hab

/-- M3b -/
theorem mellin_decay (N : ℕ) (σ₁ σ₂ : ℝ) :
    ∃ C : ℝ, ∀ s : ℂ, σ₁ ≤ s.re → s.re ≤ σ₂ →
      ‖mellin (fun u : ℝ => (f u : ℂ)) s‖ ≤ C / (1 + |s.im|) ^ N := by
  obtain ⟨C, -, hC⟩ := mellin_decay_aux hf ha hab N σ₁ σ₂
  exact ⟨C, hC⟩

/-- M3e -/
theorem mellin_integrable_line (σ : ℝ) :
    Integrable (fun t : ℝ => mellin (fun u : ℝ => (f u : ℂ)) (σ + t * I)) := by
  obtain ⟨C, hC0, hC⟩ := mellin_decay_aux hf ha hab 2 σ σ
  have hcont : Continuous (fun t : ℝ => mellin (fun u : ℝ => (f u : ℂ)) (σ + t * I)) :=
    (mellin_differentiable f hf a b ha hab).continuous.comp (by fun_prop)
  refine Integrable.mono' (integrable_inv_one_add_sq.const_mul C) hcont.aestronglyMeasurable
    (Eventually.of_forall fun t => ?_)
  have h := hC (σ + t * I) (by simp) (by simp)
  simp only [add_im, ofReal_im, mul_im, ofReal_re, I_im, mul_one, I_re, mul_zero, add_zero,
    zero_add] at h
  refine le_trans h ?_
  rw [div_eq_mul_inv]
  gcongr
  rw [add_sq, sq_abs]
  nlinarith [abs_nonneg t]

/-- Mellin inversion for `f` at `σ`. -/
theorem mellinInv_eq (σ : ℝ) {y : ℝ} (hy : 0 < y) :
    mellinInv σ (mellin (fun u : ℝ => (f u : ℂ))) y = (f y : ℂ) :=
  mellinInv_mellin_eq σ _ hy (mellinConvergent_of_tsupport hf.continuous ha hab σ)
    (mellin_integrable_line f hf a b ha hab σ) (continuous_ofReal.comp hf.continuous).continuousAt

end Main

end ArtinPrimitiveRoots.L92M
end

section
/-!
# L2B_Anal: one-variable analysis for (7.9) → (7.10)

* `triple`: `∫_{ℝ³} f(τ₁+τ₃) g(τ₂) h(τ₃) = ∫f ∫g ∫h` (with integrability);
* `iter3`: an integrable function on `ℝ × ℝ × ℝ` has iterated integral equal to its integral;
* the three Mellin inversions on the lines `5` (Gaussian `P_G`), `4` (`W₁`), `2` (`V₀`).
-/

namespace ArtinPrimitiveRoots.L2B

open Complex MeasureTheory Set Filter Topology

/-! ### Fubini -/

theorem triple (f g h : ℝ → ℂ) (hf : Integrable f) (hg : Integrable g) (hh : Integrable h)
    (hfc : Continuous f) (hgc : Continuous g) (hhc : Continuous h) :
    Integrable (fun τ : ℝ × ℝ × ℝ => f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2) ∧
      ∫ τ : ℝ × ℝ × ℝ, f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2 =
        (∫ a, f a) * (∫ b, g b) * (∫ c, h c) := by
  have hmeas : AEStronglyMeasurable (fun τ : ℝ × ℝ × ℝ => f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2)
      (volume.prod volume) :=
    (by fun_prop : Continuous fun τ : ℝ × ℝ × ℝ => f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2)
      |>.aestronglyMeasurable
  have hsec : ∀ y : ℝ × ℝ, Integrable (fun x : ℝ => f (x + y.2) * g y.1 * h y.2) := fun y =>
    ((hf.comp_add_right y.2).mul_const _).mul_const _
  have hnorm : ∀ y : ℝ × ℝ, ∫ x : ℝ, ‖f (x + y.2) * g y.1 * h y.2‖ =
      (∫ a, ‖f a‖) * (‖g y.1‖ * ‖h y.2‖) := by
    intro y
    simp only [norm_mul]
    rw [integral_mul_const, integral_mul_const,
      integral_add_right_eq_self (fun a => ‖f a‖) y.2]
    ring
  have hint : Integrable (fun τ : ℝ × ℝ × ℝ => f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2)
      (volume.prod volume) := by
    rw [integrable_prod_iff' hmeas]
    refine ⟨Eventually.of_forall hsec, ?_⟩
    simp only [hnorm]
    exact (hg.norm.mul_prod hh.norm).const_mul _
  refine ⟨hint, ?_⟩
  change ∫ τ : ℝ × ℝ × ℝ, f (τ.1 + τ.2.2) * g τ.2.1 * h τ.2.2 ∂(volume.prod volume) = _
  rw [integral_prod_symm _ hint]
  have hin : ∀ y : ℝ × ℝ, ∫ x : ℝ, f (x + y.2) * g y.1 * h y.2 =
      (∫ a, f a) * (g y.1 * h y.2) := by
    intro y
    rw [integral_mul_const, integral_mul_const, integral_add_right_eq_self f y.2]
    ring
  simp only [hin]
  rw [integral_const_mul]
  change (∫ a, f a) * ∫ y : ℝ × ℝ, g y.1 * h y.2 ∂(volume.prod volume) = _
  rw [integral_prod_mul]
  ring

theorem iter3 (Φ : ℝ × ℝ × ℝ → ℂ) (hΦ : Integrable Φ) :
    ∫ a : ℝ, ∫ b : ℝ, ∫ c : ℝ, Φ (a, b, c) = ∫ τ, Φ τ := by
  have hΦ' : Integrable Φ (volume.prod volume) := hΦ
  change _ = ∫ τ, Φ τ ∂(volume.prod volume)
  rw [integral_prod _ hΦ']
  refine integral_congr_ae ?_
  filter_upwards [hΦ'.prod_right_ae] with a ha
  have ha' : Integrable (fun bc : ℝ × ℝ => Φ (a, bc)) (volume.prod volume) := ha
  exact (integral_prod _ ha').symm

/-! ### Complex powers of positive reals -/

theorem cpow_eq_exp {x : ℝ} (hx : 0 < x) (s : ℂ) :
    (x : ℂ) ^ s = cexp ((Real.log x : ℂ) * s) := by
  rw [cpow_def_of_ne_zero (by exact_mod_cast hx.ne'), ofReal_log hx.le]

/-! ### The Gaussian on the line `Re t = 5` -/

/-- `e^{t²} x^{-t}` on `t = 5 + i a`. -/
noncomputable def Pl (x : ℝ) (a : ℝ) : ℂ := cexp ((5 + a * I) ^ 2) * (x : ℂ) ^ (-(5 + a * I))

theorem Pl_eq {x : ℝ} (hx : 0 < x) (a : ℝ) :
    Pl x a = cexp (-1 * (a : ℂ) ^ 2 + (I * (10 - Real.log x)) * a + (25 - 5 * Real.log x)) := by
  rw [Pl, cpow_eq_exp hx, ← Complex.exp_add]
  congr 1
  ring_nf
  rw [I_sq]
  ring

theorem norm_Pl {x : ℝ} (hx : 0 < x) (a : ℝ) :
    ‖Pl x a‖ = Real.exp (25 - a ^ 2) * x ^ (-5 : ℝ) := by
  rw [Pl, norm_mul, norm_exp, norm_cpow_eq_rpow_re_of_pos hx]
  congr 2
  · norm_num [sq]
  · simp

theorem continuous_Pl {x : ℝ} (hx : 0 < x) : Continuous (Pl x) := by
  unfold Pl
  refine Continuous.mul (by fun_prop) ?_
  exact Continuous.const_cpow (by fun_prop) (Or.inl (by exact_mod_cast hx.ne'))

theorem integrable_Pl {x : ℝ} (hx : 0 < x) : Integrable (Pl x) := by
  refine Integrable.mono' (g := fun a : ℝ => Real.exp 25 * x ^ (-5 : ℝ) * Real.exp (-1 * a ^ 2))
    ((integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1)).const_mul _)
    (continuous_Pl hx).aestronglyMeasurable (Eventually.of_forall fun a => ?_)
  rw [norm_Pl hx, show (25 : ℝ) - a ^ 2 = 25 + -1 * a ^ 2 by ring, Real.exp_add]
  apply le_of_eq; ring

theorem integral_Pl {x : ℝ} (hx : 0 < x) :
    ∫ a : ℝ, Pl x a = 2 * Real.pi * gaussianPG x := by
  simp only [Pl_eq hx]
  rw [integral_cexp_quadratic (by simp) (I * (10 - Real.log x)) (25 - 5 * Real.log x)]
  have hpi : (Real.pi : ℂ) / -(-1) = ((Real.pi : ℝ) : ℂ) := by simp
  rw [hpi, show (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) by push_cast; ring,
    ← ofReal_cpow Real.pi_pos.le, ← Real.sqrt_eq_rpow]
  have he : (25 - 5 * (Real.log x : ℂ)) - (I * (10 - Real.log x)) ^ 2 / (4 * -1) =
      ((-(Real.log x) ^ 2 / 4 : ℝ) : ℂ) := by
    push_cast
    ring_nf
    rw [I_sq]
    ring
  rw [he, ← ofReal_exp, gaussianPG]
  have hs : 0 < Real.sqrt Real.pi := Real.sqrt_pos.2 Real.pi_pos
  rw [← ofReal_ofNat, ← ofReal_mul, ← ofReal_mul, ← ofReal_mul]
  congr 1
  field_simp
  exact Real.sq_sqrt Real.pi_pos.le

/-! ### `W₁` on the line `Re w = 4` -/

/-- `Ŵ(w) y^{-w}` on `w = 4 + i b`. -/
noncomputable def Wl (W : ℝ → ℝ) (y : ℝ) (b : ℝ) : ℂ :=
  mellin (fun t => (W t : ℂ)) (4 + b * I) * (y : ℂ) ^ (-(4 + b * I))

section W

variable {W : ℝ → ℝ} (hW : IsProbeWeight W)
include hW

theorem exists_Icc : ∃ a b : ℝ, 0 < a ∧ tsupport W ⊆ Icc a b :=
  L92M.exists_tsupport_subset_Icc W hW.2.1 hW.2.2

theorem continuous_mellinW : Continuous (fun b : ℝ => mellin (fun t => (W t : ℂ)) (4 + b * I)) := by
  obtain ⟨a, b, ha, hab⟩ := exists_Icc hW
  exact (L92M.mellin_differentiable W hW.1 a b ha hab).continuous.comp (by fun_prop)

theorem integrable_mellinW : Integrable (fun b : ℝ => mellin (fun t => (W t : ℂ)) (4 + b * I)) := by
  obtain ⟨a, b, ha, hab⟩ := exists_Icc hW
  have := L92M.mellin_integrable_line W hW.1 a b ha hab 4
  simpa using this

theorem bdd_mellinW : ∃ B : ℝ, ∀ b : ℝ, ‖mellin (fun t => (W t : ℂ)) (4 + b * I)‖ ≤ B := by
  obtain ⟨a, b, ha, hab⟩ := exists_Icc hW
  obtain ⟨C, hC⟩ := L92M.mellin_decay W hW.1 a b ha hab 0 4 4
  exact ⟨C, fun t => by simpa using hC (4 + t * I) (by simp) (by simp)⟩

omit hW in
theorem norm_Wl {y : ℝ} (hy : 0 < y) (b : ℝ) :
    ‖Wl W y b‖ = ‖mellin (fun t => (W t : ℂ)) (4 + b * I)‖ * y ^ (-4 : ℝ) := by
  rw [Wl, norm_mul, norm_cpow_eq_rpow_re_of_pos hy]
  simp

theorem continuous_Wl {y : ℝ} (hy : 0 < y) : Continuous (Wl W y) := by
  unfold Wl
  exact (continuous_mellinW hW).mul
    (Continuous.const_cpow (by fun_prop) (Or.inl (by exact_mod_cast hy.ne')))

theorem integrable_Wl {y : ℝ} (hy : 0 < y) : Integrable (Wl W y) := by
  refine Integrable.mono' ((integrable_mellinW hW).norm.mul_const (y ^ (-4 : ℝ)))
    (continuous_Wl hW hy).aestronglyMeasurable (Eventually.of_forall fun b => ?_)
  rw [norm_Wl hy]

theorem integral_Wl {y : ℝ} (hy : 0 < y) : ∫ b : ℝ, Wl W y b = 2 * Real.pi * W y := by
  obtain ⟨a, b, ha, hab⟩ := exists_Icc hW
  have h := L92M.mellinInv_eq W hW.1 a b ha hab 4 hy
  rw [mellinInv] at h
  have h2 : ∫ t : ℝ, (y : ℂ) ^ (-((4 : ℝ) + t * I)) • mellin (fun u => (W u : ℂ)) ((4 : ℝ) + t * I)
      = ∫ t : ℝ, Wl W y t := by
    congr 1; funext t; rw [Wl, smul_eq_mul, mul_comm]; simp
  rw [h2] at h
  have hpi : (2 * Real.pi : ℝ) ≠ 0 := by positivity
  rw [← h, Complex.real_smul]
  push_cast
  field_simp

end W

/-! ### `M` on the line `Re z = 2` -/

/-- `M(z) T^{-z}` on `z = 2 + i c`. -/
noncomputable def Vl (M : ℂ → ℂ) (T : ℝ) (c : ℝ) : ℂ := M (2 + c * I) * (T : ℂ) ^ (-(2 + c * I))

theorem integral_Vl (M : ℂ → ℂ) (T : ℝ) : ∫ c : ℝ, Vl M T c = 2 * Real.pi * mellinInv 2 M T := by
  rw [mellinInv, Complex.real_smul]
  have h2 : ∫ t : ℝ, (T : ℂ) ^ (-((2 : ℝ) + t * I)) • M ((2 : ℝ) + t * I) = ∫ t : ℝ, Vl M T t := by
    congr 1; funext t; rw [Vl, smul_eq_mul, mul_comm]; simp
  rw [h2]
  have hpi : (2 * Real.pi : ℝ) ≠ 0 := by positivity
  push_cast
  field_simp

section M

variable {M : ℂ → ℂ} (hM : IsMellinWeight M)
include hM

theorem continuous_Mline : Continuous (fun c : ℝ => M (2 + c * I)) :=
  hM.1.continuousOn.comp_continuous (by fun_prop) fun c => by simp

theorem bdd_Mline : ∃ B : ℝ, ∀ c : ℝ, ‖M (2 + c * I)‖ ≤ B := by
  obtain ⟨C, hC⟩ := hM.2 2 2 0 (by norm_num)
  exact ⟨C, fun c => by simpa using hC (2 + c * I) (by simp) (by simp)⟩

theorem integrable_Mline : Integrable (fun c : ℝ => M (2 + c * I)) := by
  obtain ⟨C, hC⟩ := hM.2 2 2 2 (by norm_num)
  refine Integrable.mono' ((integrable_one_add_norm (E := ℝ) (r := 2) (by simp)).const_mul C)
    (continuous_Mline hM).aestronglyMeasurable (Eventually.of_forall fun c => ?_)
  have := hC (2 + c * I) (by simp) (by simp)
  simpa [Real.norm_eq_abs] using this

omit hM in
theorem norm_Vl {T : ℝ} (hT : 0 < T) (c : ℝ) :
    ‖Vl M T c‖ = ‖M (2 + c * I)‖ * T ^ (-2 : ℝ) := by
  rw [Vl, norm_mul, norm_cpow_eq_rpow_re_of_pos hT]
  simp

theorem continuous_Vl {T : ℝ} (hT : 0 < T) : Continuous (Vl M T) := by
  unfold Vl
  exact (continuous_Mline hM).mul
    (Continuous.const_cpow (by fun_prop) (Or.inl (by exact_mod_cast hT.ne')))

theorem integrable_Vl {T : ℝ} (hT : 0 < T) : Integrable (Vl M T) := by
  refine Integrable.mono' ((integrable_Mline hM).norm.mul_const (T ^ (-2 : ℝ)))
    (continuous_Vl hM hT).aestronglyMeasurable (Eventually.of_forall fun b => ?_)
  rw [norm_Vl hT]

end M

/-! ### Power bounds -/

theorem gaussianPG_nonneg (x : ℝ) : 0 ≤ gaussianPG x := by
  unfold gaussianPG; positivity

theorem gaussianPG_le (k : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 0 < x → gaussianPG x ≤ C / x ^ k := by
  refine ⟨(2 * Real.sqrt Real.pi)⁻¹ * Real.exp ((k : ℝ) ^ 2), by positivity, fun x hx => ?_⟩
  unfold gaussianPG
  rw [mul_div_assoc]
  gcongr
  rw [le_div_iff₀ (by positivity), ← Real.exp_log (pow_pos hx k), ← Real.exp_add, Real.log_pow]
  apply Real.exp_le_exp.2
  nlinarith [sq_nonneg (Real.log x / 2 - k)]

theorem probeWeight_le {W : ℝ → ℝ} (hW : IsProbeWeight W) (k : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 0 < x → |W x| ≤ C / x ^ k := by
  obtain ⟨a, b, ha, hab⟩ := exists_Icc hW
  obtain ⟨B, hB⟩ := hW.1.continuous.bounded_above_of_compact_support hW.2.1
  have hb : 0 < max b a := lt_max_of_lt_right ha
  refine ⟨max B 0 * (max b a) ^ k, by positivity, fun x hx => ?_⟩
  by_cases hx' : x ≤ max b a
  · rw [le_div_iff₀ (by positivity)]
    apply mul_le_mul _ (pow_le_pow_left₀ hx.le hx' k) (by positivity) (by positivity)
    exact (Real.norm_eq_abs _ ▸ hB x).trans (le_max_left _ _)
  · have : W x = 0 := by
      refine image_eq_zero_of_notMem_tsupport fun h => hx' ?_
      exact (hab h).2.trans (le_max_left _ _)
    rw [this, abs_zero]; positivity

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_Alg: the change of variables `t = ξ + z − 1` as an identity of integrands

`key_alg`: the integrand of (7.10) at one index, on the lines `ξ = 4 + iτ₁`, `w = 4 + iτ₂`,
`z = 2 + iτ₃`, factors as a constant times `Pl (q_𝔄/Z) (τ₁ + τ₃) · Wl (q_𝔰/Y) τ₂ · Vl (X q_h/q_𝔄) τ₃`.
-/

namespace ArtinPrimitiveRoots.L2B

open Complex

theorem key_alg {X Y Z qc qn qs qu qr : ℝ} (hX : 0 < X) (hY : 0 < Y) (hZ : 0 < Z) (hc : 0 < qc)
    (hn : 0 < qn) (hs : 0 < qs) (hu : 0 < qu) (hr : 0 < qr) (τ₁ τ₂ τ₃ : ℝ) (Mz Ww Θ : ℂ) :
    (X : ℂ) ^ ((1 / 2 : ℂ) - (2 + τ₃ * I)) * (Z : ℂ) ^ ((4 + τ₁ * I) + (2 + τ₃ * I) - 1) *
        (Y : ℂ) ^ ((4 + τ₂ * I) - 1) * cexp (((4 + τ₁ * I) + (2 + τ₃ * I) - 1) ^ 2) * Mz * Ww *
        (qu : ℂ) ^ (-(2 + τ₃ * I)) *
        (Θ * (qc : ℂ) ^ (-(1 / 2 + (4 + τ₁ * I))) * (qn : ℂ) ^ (-(1 + 3 * (4 + τ₁ * I))) *
          (qs : ℂ) ^ (-(4 + τ₂ * I)) * (qr : ℂ) ^ (-(6 * (2 + τ₃ * I)))) =
      ((Real.sqrt X / Y / (Real.sqrt qc * qn * (qc * qn ^ 3)) : ℝ) : ℂ) * Θ *
        Pl (qc * qn ^ 3 / Z) (τ₁ + τ₃) *
        (Ww * ((qs / Y : ℝ) : ℂ) ^ (-(4 + τ₂ * I))) *
        (Mz * ((X * (qu * qr ^ 6) / (qc * qn ^ 3) : ℝ) : ℂ) ^ (-(2 + τ₃ * I))) := by
  have hA : 0 < qc * qn ^ 3 := by positivity
  have hK : 0 < Real.sqrt X / Y / (Real.sqrt qc * qn * (qc * qn ^ 3)) := by
    have := Real.sqrt_pos.2 hX; have := Real.sqrt_pos.2 hc; positivity
  have hlK : Real.log (Real.sqrt X / Y / (Real.sqrt qc * qn * (qc * qn ^ 3))) =
      Real.log X / 2 - Real.log Y - 3 / 2 * Real.log qc - 4 * Real.log qn := by
    have h1 := Real.sqrt_pos.2 hX; have h2 := Real.sqrt_pos.2 hc
    rw [Real.log_div (by positivity) (by positivity), Real.log_div h1.ne' hY.ne',
      Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) hn.ne',
      Real.log_mul hc.ne' (by positivity), Real.log_pow, Real.log_sqrt hX.le,
      Real.log_sqrt hc.le]
    push_cast; ring
  have hlA : Real.log (qc * qn ^ 3 / Z) = Real.log qc + 3 * Real.log qn - Real.log Z := by
    rw [Real.log_div (by positivity) hZ.ne', Real.log_mul hc.ne' (by positivity), Real.log_pow]
    push_cast; ring
  have hlS : Real.log (qs / Y) = Real.log qs - Real.log Y := Real.log_div hs.ne' hY.ne'
  have hlH : Real.log (X * (qu * qr ^ 6) / (qc * qn ^ 3)) =
      Real.log X + Real.log qu + 6 * Real.log qr - Real.log qc - 3 * Real.log qn := by
    rw [Real.log_div (by positivity) hA.ne', Real.log_mul hX.ne' (by positivity),
      Real.log_mul hu.ne' (by positivity), Real.log_pow, Real.log_mul hc.ne' (by positivity),
      Real.log_pow]
    push_cast; ring
  have hKe : ((Real.sqrt X / Y / (Real.sqrt qc * qn * (qc * qn ^ 3)) : ℝ) : ℂ) =
      cexp ((Real.log X / 2 - Real.log Y - 3 / 2 * Real.log qc - 4 * Real.log qn : ℝ) : ℂ) := by
    rw [← ofReal_exp, ← hlK, Real.exp_log hK]
  rw [hKe, Pl, cpow_eq_exp hX, cpow_eq_exp hZ, cpow_eq_exp hY, cpow_eq_exp hu, cpow_eq_exp hc,
    cpow_eq_exp hn, cpow_eq_exp hs, cpow_eq_exp hr, cpow_eq_exp (by positivity : 0 < qc * qn ^ 3 / Z),
    cpow_eq_exp (by positivity : 0 < qs / Y),
    cpow_eq_exp (by positivity : 0 < X * (qu * qr ^ 6) / (qc * qn ^ 3)), hlA, hlS, hlH]
  set lX := Real.log X; set lY := Real.log Y; set lZ := Real.log Z; set lc := Real.log qc
  set ln := Real.log qn; set ls := Real.log qs; set lu := Real.log qu; set lr := Real.log qr
  set ξ : ℂ := 4 + τ₁ * I
  set w : ℂ := 4 + τ₂ * I
  set z : ℂ := 2 + τ₃ * I
  have hL : ∀ e1 e2 e3 e4 e5 e6 e7 e8 e9 : ℂ,
      cexp e1 * cexp e2 * cexp e3 * cexp e4 * Mz * Ww * cexp e5 *
        (Θ * cexp e6 * cexp e7 * cexp e8 * cexp e9) =
      Θ * Mz * Ww * cexp (e1 + e2 + e3 + e4 + e5 + e6 + e7 + e8 + e9) := by
    intros; simp only [Complex.exp_add]; ring
  have hR : ∀ e1 e2 e3 e4 e5 : ℂ,
      cexp e1 * Θ * (cexp e2 * cexp e3) * (Ww * cexp e4) * (Mz * cexp e5) =
      Θ * Mz * Ww * cexp (e1 + e2 + e3 + e4 + e5) := by
    intros; simp only [Complex.exp_add]; ring
  rw [hL, hR]
  congr 2
  simp only [ξ, w, z]
  push_cast
  ring

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_Row: each row integral of (7.10) is the sum of its (7.9) terms

`rowIntegral_eq`: `J_u = ∑'_{(𝔠,𝔫,𝔰,𝔯)} T u (𝔠,𝔫,𝔰,𝔯)`, where `T` is the (7.9) term
`X^{1/2} Y⁻¹ q_𝔠^{-1/2} q_𝔫⁻¹ q_𝔄⁻¹ γ₂(𝔠) ϑ(𝔄) F(𝔰,𝔄,u r⁶) P_G(q_𝔄/Z) W₁(q_𝔰/Y) V₀(X q_u q_𝔯⁶/q_𝔄)`
with `V₀ = mellinInv 2 M`: Mellin inversion of the three weights, the change of variables
`t = ξ + z − 1`, Fubini and dominated interchange of the ideal sum with the triple integral.
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField Complex MeasureTheory Filter

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

/-- Exterior ideals. -/
abbrev Ext (𝔪 : Ideal (𝓞 F)) : Type _ := {I : Ideal (𝓞 F) // IsExterior 𝔪 I}
/-- Squarefree exterior ideals. -/
abbrev SqF (𝔪 : Ideal (𝓞 F)) : Type _ := {I : Ideal (𝓞 F) // IsExterior 𝔪 I ∧ Squarefree I}
/-- The index `(𝔠, 𝔫, 𝔰, 𝔯)` of `ℱ_u`. -/
abbrev Idx (𝔪 : Ideal (𝓞 F)) : Type _ := SqF 𝔪 × Ext 𝔪 × Ext 𝔪 × Ext 𝔪

/-- The summand of `ℱ_u` (7.11). -/
noncomputable def fsum (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (u : SInt 𝔪) (ξ w z : ℂ)
    (p : Idx 𝔪) : ℂ :=
  gaussPhase g 2 p.1.1 * χ.thetaChar g (p.1.1 * p.2.1.1 ^ 3) *
    poissonFactor g p.2.2.1.1 (p.1.1 * p.2.1.1 ^ 3) (u * g.gen p.2.2.2.1 ^ 6) *
    (Ideal.absNorm p.1.1 : ℂ) ^ (-(1 / 2 + ξ)) * (Ideal.absNorm p.2.1.1 : ℂ) ^ (-(1 + 3 * ξ)) *
    (Ideal.absNorm p.2.2.1.1 : ℂ) ^ (-w) * (Ideal.absNorm p.2.2.2.1 : ℂ) ^ (-(6 * z))

theorem freqSeries_eq (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (u : SInt 𝔪) (ξ w z : ℂ) :
    χ.freqSeries g u ξ w z = ∑' p, fsum g χ u ξ w z p := rfl

/-- The kernel of the row integral (7.10), without `ℱ_u`. -/
noncomputable def Kf (W₁ : ℝ → ℝ) (M : ℂ → ℂ) (u : FreqClass 𝔪) (X Y Z : ℝ)
    (τ : ℝ × ℝ × ℝ) : ℂ :=
  (X : ℂ) ^ ((1 / 2 : ℂ) - (2 + τ.2.2 * I)) *
    (Z : ℂ) ^ ((4 + τ.1 * I) + (2 + τ.2.2 * I) - 1) *
    (Y : ℂ) ^ ((4 + τ.2.1 * I) - 1) *
    cexp (((4 + τ.1 * I) + (2 + τ.2.2 * I) - 1) ^ 2) *
    M (2 + τ.2.2 * I) * mellin (fun t => (W₁ t : ℂ)) (4 + τ.2.1 * I) *
    (Ideal.absNorm u.1.1 : ℂ) ^ (-(2 + τ.2.2 * I))

/-- One term of the row integrand. -/
noncomputable def Gf (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (W₁ : ℝ → ℝ) (M : ℂ → ℂ)
    (u : FreqClass 𝔪) (X Y Z : ℝ) (p : Idx 𝔪) (τ : ℝ × ℝ × ℝ) : ℂ :=
  Kf W₁ M u X Y Z τ * fsum g χ (freqElt g u) (4 + τ.1 * I) (4 + τ.2.1 * I) (2 + τ.2.2 * I) p

/-- The arithmetic coefficient `γ₂(𝔠) ϑ(𝔄) F(𝔰, 𝔄, u r⁶)`. -/
noncomputable def Ar (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (u : FreqClass 𝔪) (p : Idx 𝔪) :
    ℂ :=
  gaussPhase g 2 p.1.1 * χ.thetaChar g (p.1.1 * p.2.1.1 ^ 3) *
    poissonFactor g p.2.2.1.1 (p.1.1 * p.2.1.1 ^ 3) (freqElt g u * g.gen p.2.2.2.1 ^ 6)

/-- `X^{1/2} Y⁻¹ q_𝔠^{-1/2} q_𝔫⁻¹ q_𝔄⁻¹`. -/
noncomputable def Kc (X Y : ℝ) (p : Idx 𝔪) : ℝ :=
  Real.sqrt X / Y / (Real.sqrt (qn p.1.1) * qn p.2.1.1 * (qn p.1.1 * qn p.2.1.1 ^ 3))

/-- `q_𝔄 / Z`. -/
noncomputable def xA (Z : ℝ) (p : Idx 𝔪) : ℝ := qn p.1.1 * qn p.2.1.1 ^ 3 / Z
/-- `q_𝔰 / Y`. -/
noncomputable def ys (Y : ℝ) (p : Idx 𝔪) : ℝ := qn p.2.2.1.1 / Y
/-- `X q_u q_𝔯⁶ / q_𝔄`. -/
noncomputable def vh (X : ℝ) (u : FreqClass 𝔪) (p : Idx 𝔪) : ℝ :=
  X * (qn u.1.1 * qn p.2.2.2.1 ^ 6) / (qn p.1.1 * qn p.2.1.1 ^ 3)

/-- The (7.9) term. -/
noncomputable def Tm (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (W₁ : ℝ → ℝ) (M : ℂ → ℂ)
    (u : FreqClass 𝔪) (X Y Z : ℝ) (p : Idx 𝔪) : ℂ :=
  (Kc X Y p : ℂ) * Ar g χ u p * (gaussianPG (xA Z p) : ℂ) * (W₁ (ys Y p) : ℂ) *
    mellinInv 2 M (vh X u p)

/-- The `τ`-profile `e^{25−(τ₁+τ₃)²} |Ŵ₁(4+iτ₂)| |M(2+iτ₃)|`. -/
noncomputable def psi (W₁ : ℝ → ℝ) (M : ℂ → ℂ) (τ : ℝ × ℝ × ℝ) : ℝ :=
  ‖Pl 1 (τ.1 + τ.2.2) * mellin (fun t => (W₁ t : ℂ)) (4 + τ.2.1 * I) * M (2 + τ.2.2 * I)‖

/-- The coefficient with `‖Gf‖ = cc · psi`. -/
noncomputable def cc (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (X Y Z : ℝ) (u : FreqClass 𝔪)
    (p : Idx 𝔪) : ℝ :=
  Kc X Y p * ‖Ar g χ u p‖ * xA Z p ^ (-5 : ℝ) * ys Y p ^ (-4 : ℝ) * vh X u p ^ (-2 : ℝ)

/-- The summable majorant `q_u^{-2} q_𝔠^{-2} q_𝔫^{-7} q_𝔰^{-3} q_𝔯^{-12}`. -/
noncomputable def Dm (u : FreqClass 𝔪) (p : Idx 𝔪) : ℝ :=
  (qn u.1.1 ^ 2)⁻¹ * ((qn p.1.1 ^ 2)⁻¹ * ((qn p.2.1.1 ^ 7)⁻¹ *
    ((qn p.2.2.1.1 ^ 3)⁻¹ * (qn p.2.2.2.1 ^ 12)⁻¹)))

section

variable (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (W₁ : ℝ → ℝ) (M : ℂ → ℂ)
  {X Y Z : ℝ} (hX : 0 < X) (hY : 0 < Y) (hZ : 0 < Z)

theorem pos_c (p : Idx 𝔪) : 0 < qn p.1.1 := qn_pos p.1.2.1
theorem pos_n (p : Idx 𝔪) : 0 < qn p.2.1.1 := qn_pos p.2.1.2
theorem pos_s (p : Idx 𝔪) : 0 < qn p.2.2.1.1 := qn_pos p.2.2.1.2
theorem pos_r (p : Idx 𝔪) : 0 < qn p.2.2.2.1 := qn_pos p.2.2.2.2
theorem pos_u (u : FreqClass 𝔪) : 0 < qn u.1.1 := qn_pos u.1.2.1

include hX hY hZ

theorem Gf_eq (u : FreqClass 𝔪) (p : Idx 𝔪) (τ : ℝ × ℝ × ℝ) :
    Gf g χ W₁ M u X Y Z p τ = ((Kc X Y p : ℂ) * Ar g χ u p) * Pl (xA Z p) (τ.1 + τ.2.2) *
      Wl W₁ (ys Y p) τ.2.1 * Vl M (vh X u p) τ.2.2 := by
  have h := key_alg hX hY hZ (pos_c p) (pos_n p) (pos_s p) (pos_u u) (pos_r p) τ.1 τ.2.1 τ.2.2
    (M (2 + τ.2.2 * I)) (mellin (fun t => (W₁ t : ℂ)) (4 + τ.2.1 * I)) (Ar g χ u p)
  simp only [qn, Complex.ofReal_natCast] at h
  rw [Gf, Kf, fsum, Kc, xA, ys, vh, Wl, Vl, ← Ar]
  simp only [qn]
  rw [← h]

omit hZ in
theorem Kc_nonneg (p : Idx 𝔪) : 0 ≤ Kc X Y p := by
  unfold Kc; have := pos_c p; have := pos_n p; positivity

theorem norm_Gf (u : FreqClass 𝔪) (p : Idx 𝔪) (τ : ℝ × ℝ × ℝ) :
    ‖Gf g χ W₁ M u X Y Z p τ‖ = cc g χ X Y Z u p * psi W₁ M τ := by
  have hxA : 0 < xA Z p := by unfold xA; have := pos_c p; have := pos_n p; positivity
  have hys : 0 < ys Y p := by unfold ys; have := pos_s p; positivity
  have hvh : 0 < vh X u p := by
    unfold vh; have := pos_c p; have := pos_n p; have := pos_u u; have := pos_r p; positivity
  rw [Gf_eq g χ W₁ M hX hY hZ, cc, psi]
  simp only [norm_mul]
  rw [norm_Pl hxA, norm_Wl hys, norm_Vl hvh, norm_Pl one_pos, Real.one_rpow,
    Complex.norm_of_nonneg (Kc_nonneg hX hY p)]
  ring

end

section

variable (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {W₁ : ℝ → ℝ} {M : ℂ → ℂ}
  (hW₁ : IsProbeWeight W₁) (hM : IsMellinWeight M)
  {X Y Z : ℝ} (hX : 0 < X) (hY : 0 < Y) (hZ : 0 < Z)

include hW₁ hM hX hY hZ

theorem integral_Gf (u : FreqClass 𝔪) (p : Idx 𝔪) :
    Integrable (Gf g χ W₁ M u X Y Z p) ∧ Continuous (Gf g χ W₁ M u X Y Z p) ∧
      ∫ τ, Gf g χ W₁ M u X Y Z p τ = (2 * Real.pi) ^ 3 * Tm g χ W₁ M u X Y Z p := by
  have hxA : 0 < xA Z p := by unfold xA; have := pos_c p; have := pos_n p; positivity
  have hys : 0 < ys Y p := by unfold ys; have := pos_s p; positivity
  have hvh : 0 < vh X u p := by
    unfold vh; have := pos_c p; have := pos_n p; have := pos_u u; have := pos_r p; positivity
  have hfun : Gf g χ W₁ M u X Y Z p = fun τ => ((Kc X Y p : ℂ) * Ar g χ u p) *
      (Pl (xA Z p) (τ.1 + τ.2.2) * Wl W₁ (ys Y p) τ.2.1 * Vl M (vh X u p) τ.2.2) := by
    funext τ; rw [Gf_eq g χ W₁ M hX hY hZ]; ring
  have ht := triple _ _ _ (integrable_Pl hxA) (integrable_Wl hW₁ hys) (integrable_Vl hM hvh)
    (continuous_Pl hxA) (continuous_Wl hW₁ hys) (continuous_Vl hM hvh)
  refine ⟨?_, ?_, ?_⟩
  · rw [hfun]; exact ht.1.const_mul _
  · rw [hfun]
    exact continuous_const.mul (((continuous_Pl hxA).comp (by fun_prop)).mul
      ((continuous_Wl hW₁ hys).comp (by fun_prop)) |>.mul ((continuous_Vl hM hvh).comp (by fun_prop)))
  · rw [hfun, integral_const_mul, ht.2, integral_Pl hxA, integral_Wl hW₁ hys, integral_Vl, Tm]
    ring

omit hX hY hZ in
theorem integrable_psi : Integrable (psi W₁ M) := by
  have ht := triple _ _ _ (integrable_Pl one_pos) (integrable_mellinW hW₁) (integrable_Mline hM)
    (continuous_Pl one_pos) (continuous_mellinW hW₁) (continuous_Mline hM)
  exact ht.1.norm

omit hX hY hZ in
theorem psi_le : ∃ B : ℝ, ∀ τ, psi W₁ M τ ≤ B := by
  obtain ⟨BW, hBW⟩ := bdd_mellinW hW₁
  obtain ⟨BM, hBM⟩ := bdd_Mline hM
  refine ⟨Real.exp 25 * BW * BM, fun τ => ?_⟩
  rw [psi, norm_mul, norm_mul, norm_Pl one_pos, Real.one_rpow, mul_one]
  have h1 : Real.exp (25 - (τ.1 + τ.2.2) ^ 2) ≤ Real.exp 25 :=
    Real.exp_le_exp.2 (by nlinarith [sq_nonneg (τ.1 + τ.2.2)])
  have hBW0 : 0 ≤ BW := (norm_nonneg _).trans (hBW 0)
  gcongr
  · exact hBW _
  · exact hBM _

end

theorem norm_Ar_le (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (u : FreqClass 𝔪)
    (p : Idx 𝔪) : ‖Ar g χ u p‖ ≤ Real.sqrt (qn p.1.1) * (qn p.1.1 * qn p.2.1.1 ^ 3) *
      (qn p.2.2.1.1 * (qn p.1.1 * qn p.2.1.1 ^ 3)) := by
  have hA : IsExterior 𝔪 (p.1.1 * p.2.1.1 ^ 3) :=
    C3I.isExterior_mul p.1.2.1 (C3I.isExterior_pow p.2.1.2 3)
  have hN : (Ideal.absNorm (p.1.1 * p.2.1.1 ^ 3) : ℝ) = qn p.1.1 * qn p.2.1.1 ^ 3 := by
    simp [qn, map_mul, map_pow]
  rw [Ar, norm_mul, norm_mul]
  have h1 := norm_gaussPhase_le g 2 p.1.2.1
  have h2 := norm_thetaChar_le h𝔪 g χ hA
  have h3 := norm_poissonFactor_le g p.2.2.1.2 hA (freqElt g u * g.gen p.2.2.2.1 ^ 6)
  rw [hN] at h2 h3
  gcongr

theorem cc_le (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {X Y Z : ℝ} (hX : 0 < X)
    (hY : 0 < Y) (hZ : 0 < Z) (u : FreqClass 𝔪) (p : Idx 𝔪) :
    cc g χ X Y Z u p ≤ (Real.sqrt X * Y ^ 3 * Z ^ 5 / X ^ 2) * Dm u p := by
  have hc := pos_c p; have hn := pos_n p; have hs := pos_s p; have hu := pos_u u
  have hr := pos_r p
  have hxA : 0 < xA Z p := by unfold xA; positivity
  have hys : 0 < ys Y p := by unfold ys; positivity
  have hvh : 0 < vh X u p := by unfold vh; positivity
  have hsc := Real.sqrt_pos.2 hc
  calc cc g χ X Y Z u p ≤ Kc X Y p * (Real.sqrt (qn p.1.1) * (qn p.1.1 * qn p.2.1.1 ^ 3) *
        (qn p.2.2.1.1 * (qn p.1.1 * qn p.2.1.1 ^ 3))) * xA Z p ^ (-5 : ℝ) *
        ys Y p ^ (-4 : ℝ) * vh X u p ^ (-2 : ℝ) := by
        unfold cc
        have := Kc_nonneg hX hY p (𝔪 := 𝔪)
        gcongr
        exact norm_Ar_le h𝔪 g χ u p
    _ = (Real.sqrt X * Y ^ 3 * Z ^ 5 / X ^ 2) * Dm u p := by
        rw [Real.rpow_neg hxA.le, Real.rpow_neg hys.le, Real.rpow_neg hvh.le, Real.rpow_ofNat,
          Real.rpow_ofNat, Real.rpow_ofNat]
        unfold Kc xA ys vh Dm
        field_simp

theorem summable_Dm (h𝔪 : 𝔪 ≠ ⊥) : Summable (fun x : FreqClass 𝔪 × Idx 𝔪 => Dm x.1 x.2) := by
  have : Finite (SClass 𝔪) := finite_SClass h𝔪
  have hu := summable_inv_pow_prod_finite (F := F)
    (fun I => IsExterior 𝔪 I ∧ IsSixthPowerFree I) (SClass 𝔪) (k := 2) le_rfl
  have hc := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I ∧ Squarefree I)
    (k := 2) le_rfl
  have hn := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I) (k := 7) (by norm_num)
  have hs := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I) (k := 3) (by norm_num)
  have hr := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I) (k := 12) (by norm_num)
  have h4 := hs.mul_of_nonneg hr (fun _ => by positivity) (fun _ => by positivity)
  have h3 := hn.mul_of_nonneg h4 (fun _ => by positivity) (fun _ => by positivity)
  have h2 := hc.mul_of_nonneg h3 (fun _ => by positivity) (fun _ => by positivity)
  have h1 := hu.mul_of_nonneg h2 (fun _ => by positivity) (fun _ => by positivity)
  exact h1

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_RowEq: `J_u = ∑'_p T u p`, and absolute summability of `T`
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField Complex MeasureTheory Filter

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

theorem cc_nonneg (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {X Y Z : ℝ} (hX : 0 < X) (hY : 0 < Y)
    (hZ : 0 < Z) (u : FreqClass 𝔪) (p : Idx 𝔪) : 0 ≤ cc g χ X Y Z u p := by
  have hc := pos_c p; have hn := pos_n p; have hs := pos_s p; have hu := pos_u u
  have hr := pos_r p
  have hxA : 0 < xA Z p := by unfold xA; positivity
  have hys : 0 < ys Y p := by unfold ys; positivity
  have hvh : 0 < vh X u p := by unfold vh; positivity
  have := Kc_nonneg hX hY p (𝔪 := 𝔪)
  unfold cc
  have := Real.rpow_nonneg hxA.le (-5); have := Real.rpow_nonneg hys.le (-4)
  have := Real.rpow_nonneg hvh.le (-2)
  positivity

section

variable (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {W₁ : ℝ → ℝ} {M : ℂ → ℂ}
  (hW₁ : IsProbeWeight W₁) (hM : IsMellinWeight M)
  {X Y Z : ℝ} (hX : 0 < X) (hY : 0 < Y) (hZ : 0 < Z)

include h𝔪 hW₁ hM hX hY hZ

omit hW₁ hM in
theorem summable_cc : Summable (fun x : FreqClass 𝔪 × Idx 𝔪 => cc g χ X Y Z x.1 x.2) := by
  exact Summable.of_nonneg_of_le (fun x => cc_nonneg g χ hX hY hZ x.1 x.2)
    (fun x => cc_le h𝔪 g χ hX hY hZ x.1 x.2) ((summable_Dm h𝔪).mul_left _)

omit h𝔪 in
theorem norm_Tm_le (u : FreqClass 𝔪) (p : Idx 𝔪) :
    ‖Tm g χ W₁ M u X Y Z p‖ ≤ ((2 * Real.pi) ^ 3)⁻¹ * (cc g χ X Y Z u p * ∫ τ, psi W₁ M τ) := by
  obtain ⟨hi, -, he⟩ := integral_Gf g χ hW₁ hM hX hY hZ u p
  have hpi : (0 : ℝ) < (2 * Real.pi) ^ 3 := by positivity
  have h : Tm g χ W₁ M u X Y Z p = (((2 * Real.pi) ^ 3 : ℝ) : ℂ)⁻¹ * ∫ τ, Gf g χ W₁ M u X Y Z p τ := by
    rw [he]; push_cast; field_simp
  rw [h, norm_mul, norm_inv, norm_real, Real.norm_of_nonneg hpi.le]
  gcongr
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  simp only [norm_Gf g χ W₁ M hX hY hZ]
  rw [integral_const_mul]

theorem summable_Tm : Summable (fun x : FreqClass 𝔪 × Idx 𝔪 => Tm g χ W₁ M x.1 X Y Z x.2) :=
  Summable.of_norm_bounded
    (((summable_cc h𝔪 g χ hX hY hZ).mul_right (∫ τ, psi W₁ M τ)).mul_left
      ((2 * Real.pi) ^ 3)⁻¹)
    (fun x => norm_Tm_le g χ hW₁ hM hX hY hZ x.1 x.2)

theorem rowIntegral_eq (u : FreqClass 𝔪) :
    χ.rowIntegral g W₁ M u X Y Z = ∑' p, Tm g χ W₁ M u X Y Z p := by
  have hcc : Summable (cc g χ X Y Z u) := (summable_cc h𝔪 g χ hX hY hZ).prod_factor u
  obtain ⟨Bψ, hBψ⟩ := psi_le hW₁ hM
  have hgi : ∀ p, Integrable (Gf g χ W₁ M u X Y Z p) := fun p =>
    (integral_Gf g χ hW₁ hM hX hY hZ u p).1
  have hgc : ∀ p, Continuous (Gf g χ W₁ M u X Y Z p) := fun p =>
    (integral_Gf g χ hW₁ hM hX hY hZ u p).2.1
  have hsumτ : ∀ τ, Summable (fun p => ‖Gf g χ W₁ M u X Y Z p τ‖) := fun τ => by
    simp only [norm_Gf g χ W₁ M hX hY hZ]; exact hcc.mul_right _
  have hcont : Continuous (fun τ => ∑' p, Gf g χ W₁ M u X Y Z p τ) :=
    continuous_tsum hgc (hcc.mul_right Bψ) fun p τ => by
      rw [norm_Gf g χ W₁ M hX hY hZ]
      exact mul_le_mul_of_nonneg_left (hBψ τ) (cc_nonneg g χ hX hY hZ u p)
  have hint : Integrable (fun τ => ∑' p, Gf g χ W₁ M u X Y Z p τ) := by
    refine Integrable.mono' ((integrable_psi hW₁ hM).const_mul (∑' p, cc g χ X Y Z u p))
      hcont.aestronglyMeasurable (Eventually.of_forall fun τ => ?_)
    refine (norm_tsum_le_tsum_norm (hsumτ τ)).trans (le_of_eq ?_)
    simp only [norm_Gf g χ W₁ M hX hY hZ]
    rw [tsum_mul_right]
  have hsumI : Summable (fun p => ∫ τ, ‖Gf g χ W₁ M u X Y Z p τ‖) := by
    simp only [norm_Gf g χ W₁ M hX hY hZ, integral_const_mul]
    exact hcc.mul_right _
  have hpt : ∀ a b c : ℝ, Kf W₁ M u X Y Z (a, b, c) *
      χ.freqSeries g (freqElt g u) (4 + a * I) (4 + b * I) (2 + c * I) =
      ∑' p, Gf g χ W₁ M u X Y Z p (a, b, c) := fun a b c => by
    rw [freqSeries_eq, ← tsum_mul_left]; rfl
  show ((2 * Real.pi) ^ 3 : ℂ)⁻¹ * ∫ a : ℝ, ∫ b : ℝ, ∫ c : ℝ,
      Kf W₁ M u X Y Z (a, b, c) *
        χ.freqSeries g (freqElt g u) (4 + a * I) (4 + b * I) (2 + c * I) = _
  simp only [hpt]
  rw [iter3 (fun τ => ∑' p, Gf g χ W₁ M u X Y Z p τ) hint,
    ← (hasSum_integral_of_summable_integral_norm hgi hsumI).tsum_eq]
  simp only [fun p => (integral_Gf g χ hW₁ hM hX hY hZ u p).2.2]
  rw [tsum_mul_left, ← mul_assoc]
  have hpi : (2 * (Real.pi : ℂ)) ^ 3 ≠ 0 := by
    have : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
    exact pow_ne_zero _ (mul_ne_zero two_ne_zero this)
  rw [inv_mul_cancel₀ hpi, one_mul]

end

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_Probe: the probe is the sum of the (7.9) terms

`probe_eq`: from the class-form Poisson identity (the cut), for one pair `(𝔰, 𝔄)` at a time,
`I(X, Y, Z) = ∑'_{(u, (𝔠, 𝔫, 𝔰, 𝔯))} T u (𝔠, 𝔫, 𝔰, 𝔯)`.
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField Complex

/-! ### Real bounds -/

theorem aux_a {X Y qs qρ w v C₁ C₂ : ℝ} (hX : 0 < X) (hY : 0 < Y) (hs : 0 < qs) (hρ : 0 < qρ)
    (hw : |w| ≤ C₁ / (qs / Y) ^ 4) (hv : |v| ≤ C₂ / (qρ / (qs * X)) ^ 2) :
    |Y⁻¹ * w / Real.sqrt (qs * X) / Real.sqrt qs * v| * qs ≤
      (C₁ * C₂ * Y ^ 3 * X ^ 2 / Real.sqrt X) * ((qs ^ 2)⁻¹ * (qρ ^ 2)⁻¹) := by
  obtain ⟨σ, hσ, rfl⟩ : ∃ σ, 0 < σ ∧ qs = σ ^ 2 :=
    ⟨Real.sqrt qs, Real.sqrt_pos.2 hs, (Real.sq_sqrt hs.le).symm⟩
  have hsX : Real.sqrt (σ ^ 2 * X) = σ * Real.sqrt X := by
    rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hσ.le]
  have hxs := Real.sqrt_pos.2 hX
  rw [hsX, Real.sqrt_sq hσ.le]
  have e : |Y⁻¹ * w / (σ * Real.sqrt X) / σ * v| * σ ^ 2 =
      |w| * |v| * (Y⁻¹ / Real.sqrt X) := by
    rw [abs_mul, abs_div, abs_div, abs_mul, abs_inv, abs_of_pos hY, abs_of_pos hσ,
      abs_mul, abs_of_pos hσ, abs_of_pos hxs]
    field_simp
  rw [e]
  have h0 : 0 ≤ Y⁻¹ / Real.sqrt X := by positivity
  calc |w| * |v| * (Y⁻¹ / Real.sqrt X) ≤
        (C₁ / (σ ^ 2 / Y) ^ 4) * (C₂ / (qρ / (σ ^ 2 * X)) ^ 2) * (Y⁻¹ / Real.sqrt X) := by
        gcongr
        exact (abs_nonneg _).trans hw
    _ = _ := by field_simp

theorem aux_b {qc qn Z γ θ P C₃ : ℝ} (hc : 0 < qc) (hn : 0 < qn) (hZ : 0 < Z)
    (hγ : γ ≤ Real.sqrt qc) (hθ : θ ≤ qc * qn ^ 3) (hP : P ≤ C₃ / (qc * qn ^ 3 / Z) ^ 4)
    (hθ0 : 0 ≤ θ) (hP0 : 0 ≤ P) :
    γ / (Real.sqrt qc * qn) * θ * P ≤ (C₃ * Z ^ 4) * ((qc ^ 3)⁻¹ * (qn ^ 10)⁻¹) := by
  have hsc := Real.sqrt_pos.2 hc
  calc γ / (Real.sqrt qc * qn) * θ * P ≤
        Real.sqrt qc / (Real.sqrt qc * qn) * (qc * qn ^ 3) * (C₃ / (qc * qn ^ 3 / Z) ^ 4) := by
        gcongr
    _ = _ := by field_simp

theorem aux_c {X Y qs qA d W : ℝ} (hX : 0 < X) (hY : 0 < Y) (hs : 0 < qs) (hA : 0 < qA)
    (hd : 0 < d) :
    Y⁻¹ * W / Real.sqrt (qs * X) / Real.sqrt qs * (X * qs / qA) / d =
      Real.sqrt X / Y / (d * qA) * W := by
  obtain ⟨σ, hσ, rfl⟩ : ∃ σ, 0 < σ ∧ qs = σ ^ 2 :=
    ⟨Real.sqrt qs, Real.sqrt_pos.2 hs, (Real.sq_sqrt hs.le).symm⟩
  obtain ⟨ξ, hξ, rfl⟩ : ∃ ξ, 0 < ξ ∧ X = ξ ^ 2 :=
    ⟨Real.sqrt X, Real.sqrt_pos.2 hX, (Real.sq_sqrt hX.le).symm⟩
  rw [Real.sqrt_mul (by positivity), Real.sqrt_sq hσ.le, Real.sqrt_sq hξ.le]
  field_simp

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

/-- The row-sum index `(𝔰, (𝔠, 𝔫))`. -/
abbrev Qx (𝔪 : Ideal (𝓞 F)) : Type _ := Ext 𝔪 × (SqF 𝔪 × Ext 𝔪)

/-- The summand of the additive factor. -/
noncomputable def aT (g : AllowedGen ι 𝔪) (W₁ V : ℝ → ℝ) (X Y : ℝ) (r : RowClass 𝔪)
    (𝔰 : Ext 𝔪) : ℂ :=
  ((Y⁻¹ * W₁ (Ideal.absNorm 𝔰.1 / Y) / Real.sqrt (Ideal.absNorm 𝔰.1 * X) /
        Real.sqrt (Ideal.absNorm 𝔰.1) * V (Ideal.absNorm r.1.1 / (Ideal.absNorm 𝔰.1 * X)) : ℝ) :
        ℂ) * gaussSumAt g 𝔰.1 (-((rowElt g r : SInt 𝔪) : F))

/-- The summand of the theta sum. -/
noncomputable def bT (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (Z : ℝ) (r : RowClass 𝔪)
    (p : SqF 𝔪 × Ext 𝔪) : ℂ :=
  gaussPhase g 2 p.1.1 /
        ((Real.sqrt (Ideal.absNorm p.1.1) * Ideal.absNorm p.2.1 : ℝ) : ℂ) *
      χ.thetaChar g (p.1.1 * p.2.1 ^ 3) * residueSymbol ι 𝔪 (p.1.1 * p.2.1 ^ 3) (rowElt g r) *
      ((gaussianPG (Ideal.absNorm (p.1.1 * p.2.1 ^ 3) / Z) : ℝ) : ℂ)

theorem probe_eq_tsum (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) (W₁ V : ℝ → ℝ) (X Y Z : ℝ) :
    χ.probe g W₁ V X Y Z = ∑' r, (∑' 𝔰, aT g W₁ V X Y r 𝔰) * (∑' p, bT g χ Z r p) := rfl

theorem norm_aT_le (g : AllowedGen ι 𝔪) {W₁ V : ℝ → ℝ} {X Y C₁ C₂ : ℝ} (hX : 0 < X) (hY : 0 < Y)
    (hC₁ : ∀ x : ℝ, 0 < x → |W₁ x| ≤ C₁ / x ^ 4) (hC₂ : ∀ x : ℝ, 0 < x → |V x| ≤ C₂ / x ^ 2)
    (r : RowClass 𝔪) (𝔰 : Ext 𝔪) :
    ‖aT g W₁ V X Y r 𝔰‖ ≤ (C₁ * C₂ * Y ^ 3 * X ^ 2 / Real.sqrt X) *
      ((qn 𝔰.1 ^ 2)⁻¹ * (qn r.1.1 ^ 2)⁻¹) := by
  have hs := qn_pos 𝔰.2
  have hρ := qn_pos r.1.2
  rw [aT, norm_mul, norm_real, Real.norm_eq_abs]
  refine le_trans ?_ (aux_a hX hY hs hρ (hC₁ _ (by positivity)) (hC₂ _ (by positivity)))
  exact mul_le_mul_of_nonneg_left (norm_gaussSumAt_le g 𝔰.2 _) (abs_nonneg _)

theorem norm_bT_le (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {Z C₃ : ℝ} (hZ : 0 < Z)
    (hC₃ : ∀ x : ℝ, 0 < x → gaussianPG x ≤ C₃ / x ^ 4) (r : RowClass 𝔪) (p : SqF 𝔪 × Ext 𝔪) :
    ‖bT g χ Z r p‖ ≤ (C₃ * Z ^ 4) * ((qn p.1.1 ^ 3)⁻¹ * (qn p.2.1 ^ 10)⁻¹) := by
  have hc := qn_pos p.1.2.1
  have hn := qn_pos p.2.2
  have hA : IsExterior 𝔪 (p.1.1 * p.2.1 ^ 3) :=
    C3I.isExterior_mul p.1.2.1 (C3I.isExterior_pow p.2.2 3)
  have hN : (Ideal.absNorm (p.1.1 * p.2.1 ^ 3) : ℝ) = qn p.1.1 * qn p.2.1 ^ 3 := by
    simp [qn, map_mul, map_pow]
  have hsc := Real.sqrt_pos.2 hc
  rw [bT, norm_mul, norm_mul, norm_mul, norm_div, norm_real, norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg (gaussianPG_nonneg _)]
  have h1 := norm_gaussPhase_le g 2 p.1.2.1
  have h2 := norm_thetaChar_le h𝔪 g χ hA
  rw [hN] at h2
  have h3 := norm_residueSymbol_le ι 𝔪 (p.1.1 * p.2.1 ^ 3) (rowElt g r)
  have hP := hC₃ (Ideal.absNorm (p.1.1 * p.2.1 ^ 3) / Z) (by rw [hN]; positivity)
  rw [hN] at hP ⊢
  calc ‖gaussPhase g 2 p.1.1‖ / (Real.sqrt (qn p.1.1) * qn p.2.1) *
          ‖χ.thetaChar g (p.1.1 * p.2.1 ^ 3)‖ * ‖residueSymbol ι 𝔪 (p.1.1 * p.2.1 ^ 3) (rowElt g r)‖ *
          gaussianPG (qn p.1.1 * qn p.2.1 ^ 3 / Z)
        ≤ ‖gaussPhase g 2 p.1.1‖ / (Real.sqrt (qn p.1.1) * qn p.2.1) *
          ‖χ.thetaChar g (p.1.1 * p.2.1 ^ 3)‖ * 1 * gaussianPG (qn p.1.1 * qn p.2.1 ^ 3 / Z) := by
        gcongr
        exact gaussianPG_nonneg _
    _ ≤ _ := by
        rw [mul_one]
        exact aux_b hc hn hZ h1 h2 hP (norm_nonneg _) (gaussianPG_nonneg _)

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_ProbeEq: `I(X, Y, Z) = ∑'_{(u, p)} T u p`, given the class-form Poisson identity
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField Complex

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

/-- The reindexing `((𝔰, (𝔠, 𝔫)), (u, 𝔯)) ↦ (u, (𝔠, 𝔫, 𝔰, 𝔯))`. -/
def reidx (𝔪 : Ideal (𝓞 F)) : Qx 𝔪 × (FreqClass 𝔪 × Ext 𝔪) ≃ FreqClass 𝔪 × Idx 𝔪 where
  toFun x := (x.2.1, (x.1.2.1, (x.1.2.2, (x.1.1, x.2.2))))
  invFun y := ((y.2.2.2.1, (y.2.1, y.2.2.1)), (y.1, y.2.2.2.2))
  left_inv _ := rfl
  right_inv _ := rfl

/-- The Poisson identity (the cut) for fixed weights `(V, M)`. -/
def PoissonAt (g : AllowedGen ι 𝔪) (V : ℝ → ℝ) (M : ℂ → ℂ) : Prop :=
  ∀ (𝔰 𝔄 : Ideal (𝓞 F)), IsExterior 𝔪 𝔰 → IsExterior 𝔪 𝔄 →
    ∀ X : ℝ, 0 < X →
      HasSum (fun r : RowClass 𝔪 =>
          gaussSumAt g 𝔰 (-((rowElt g r : SInt 𝔪) : F)) * residueSymbol ι 𝔪 𝔄 (rowElt g r) *
            ((V (Ideal.absNorm r.1.1 / (Ideal.absNorm 𝔰 * X)) : ℝ) : ℂ))
        (((X * Ideal.absNorm 𝔰 / Ideal.absNorm 𝔄 : ℝ) : ℂ) *
          ∑' p : FreqClass 𝔪 × {𝔯 : Ideal (𝓞 F) // IsExterior 𝔪 𝔯},
            poissonFactor g 𝔰 𝔄 (freqElt g p.1 * g.gen p.2.1 ^ 6) *
              mellinInv 2 M (X * (Ideal.absNorm p.1.1.1 * Ideal.absNorm p.2.1 ^ 6) /
                Ideal.absNorm 𝔄))

section

variable (h𝔪 : 𝔪 ≠ ⊥) (g : AllowedGen ι 𝔪) (χ : HeckeChar F 𝔪) {W₁ V : ℝ → ℝ} {M : ℂ → ℂ}
  (hW₁ : IsProbeWeight W₁) (hV : IsProbeWeight V) (hM : IsMellinWeight M)
  (hP : PoissonAt g V M)
  {X Y Z : ℝ} (hX : 0 < X) (hY : 0 < Y) (hZ : 0 < Z)

include h𝔪 hW₁ hV hM hP hX hY hZ

theorem probe_eq : χ.probe g W₁ V X Y Z = ∑' x : FreqClass 𝔪 × Idx 𝔪, Tm g χ W₁ M x.1 X Y Z x.2 := by
  have : Finite (SClass 𝔪) := finite_SClass h𝔪
  obtain ⟨C₁, -, hC₁⟩ := probeWeight_le hW₁ 4
  obtain ⟨C₂, -, hC₂⟩ := probeWeight_le hV 2
  obtain ⟨C₃, -, hC₃⟩ := gaussianPG_le 4
  set Ka := C₁ * C₂ * Y ^ 3 * X ^ 2 / Real.sqrt X
  set Kb := C₃ * Z ^ 4
  have ha := fun r 𝔰 => norm_aT_le (𝔪 := 𝔪) g hX hY hC₁ hC₂ r 𝔰
  have hb := fun r p => norm_bT_le h𝔪 g χ hZ hC₃ r p
  -- summability of the pieces
  have hsρ := summable_inv_pow_prod_finite (F := F) (fun I => IsExterior 𝔪 I) (SClass 𝔪)
    (k := 2) le_rfl
  have hss := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I) (k := 2) le_rfl
  have hsc := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I ∧ Squarefree I)
    (k := 3) (by norm_num)
  have hsn := summable_inv_pow_subtype (F := F) (fun I => IsExterior 𝔪 I) (k := 10) (by norm_num)
  have hcn := hsc.mul_of_nonneg hsn (fun _ => by positivity) (fun _ => by positivity)
  have hsa : ∀ r : RowClass 𝔪, Summable (fun 𝔰 => ‖aT g W₁ V X Y r 𝔰‖) := fun r =>
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun 𝔰 => ha r 𝔰)
      ((hss.mul_right _).mul_left _)
  have hsb : ∀ r : RowClass 𝔪, Summable (fun p => ‖bT g χ Z r p‖) := fun r =>
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun p => hb r p) (hcn.mul_left _)
  have hH : Summable (Function.uncurry fun (r : RowClass 𝔪) (q : Qx 𝔪) =>
      aT g W₁ V X Y r q.1 * bT g χ Z r q.2) := by
    have hq := hss.mul_of_nonneg hcn (fun _ => by positivity) (fun _ => by positivity)
    have hall := hsρ.mul_of_nonneg hq (fun _ => by positivity) (fun _ => by positivity)
    refine Summable.of_norm_bounded ((hall.mul_left (Ka * Kb))) (fun x => ?_)
    simp only [Function.uncurry, norm_mul]
    calc ‖aT g W₁ V X Y x.1 x.2.1‖ * ‖bT g χ Z x.1 x.2.2‖
        ≤ (Ka * ((qn x.2.1.1 ^ 2)⁻¹ * (qn x.1.1.1 ^ 2)⁻¹)) *
          (Kb * ((qn x.2.2.1.1 ^ 3)⁻¹ * (qn x.2.2.2.1 ^ 10)⁻¹)) :=
          mul_le_mul (ha _ _) (hb _ _) (norm_nonneg _) ((norm_nonneg _).trans (ha _ _))
      _ = _ := by ring
  have hsT := summable_Tm h𝔪 g χ hW₁ hM hX hY hZ
  have hsT' : Summable (fun y : Qx 𝔪 × (FreqClass 𝔪 × Ext 𝔪) =>
      (fun x : FreqClass 𝔪 × Idx 𝔪 => Tm g χ W₁ M x.1 X Y Z x.2) (reidx 𝔪 y)) :=
    (reidx 𝔪).summable_iff.2 hsT
  calc χ.probe g W₁ V X Y Z
      = ∑' r, ∑' q : Qx 𝔪, aT g W₁ V X Y r q.1 * bT g χ Z r q.2 := by
        rw [probe_eq_tsum]; congr 1; funext r
        exact tsum_mul_tsum_of_summable_norm (hsa r) (hsb r)
    _ = ∑' q : Qx 𝔪, ∑' r, aT g W₁ V X Y r q.1 * bT g χ Z r q.2 := hH.tsum_comm.symm
    _ = ∑' q : Qx 𝔪, ∑' y : FreqClass 𝔪 × Ext 𝔪,
          (fun x : FreqClass 𝔪 × Idx 𝔪 => Tm g χ W₁ M x.1 X Y Z x.2) (reidx 𝔪 (q, y)) := by
        congr 1; funext q
        obtain ⟨s, c, n⟩ := q
        have hc := qn_pos c.2.1
        have hn := qn_pos n.2
        have hs := qn_pos s.2
        have hA : IsExterior 𝔪 (c.1 * n.1 ^ 3) :=
          C3I.isExterior_mul c.2.1 (C3I.isExterior_pow n.2 3)
        have hN : (Ideal.absNorm (c.1 * n.1 ^ 3) : ℝ) = qn c.1 * qn n.1 ^ 3 := by
          simp [qn, map_mul, map_pow]
        set κ : ℂ := ((Y⁻¹ * W₁ (Ideal.absNorm s.1 / Y) / Real.sqrt (Ideal.absNorm s.1 * X) /
            Real.sqrt (Ideal.absNorm s.1) : ℝ) : ℂ) *
          (gaussPhase g 2 c.1 / ((Real.sqrt (Ideal.absNorm c.1) * Ideal.absNorm n.1 : ℝ) : ℂ) *
            χ.thetaChar g (c.1 * n.1 ^ 3) *
            ((gaussianPG (Ideal.absNorm (c.1 * n.1 ^ 3) / Z) : ℝ) : ℂ)) with hκ
        have hpt : ∀ r : RowClass 𝔪, aT g W₁ V X Y r (s, (c, n)).1 * bT g χ Z r (s, (c, n)).2 =
            κ * (gaussSumAt g s.1 (-((rowElt g r : SInt 𝔪) : F)) *
              residueSymbol ι 𝔪 (c.1 * n.1 ^ 3) (rowElt g r) *
              ((V (Ideal.absNorm r.1.1 / (Ideal.absNorm s.1 * X)) : ℝ) : ℂ)) := by
          intro r
          simp only [aT, bT, hκ, Complex.ofReal_mul]
          ring
        simp_rw [hpt]
        rw [tsum_mul_left, (hP s.1 (c.1 * n.1 ^ 3) s.2 hA X hX).tsum_eq, ← mul_assoc,
          ← tsum_mul_left]
        congr 1; funext y
        have hreal := aux_c (W := W₁ (qn s.1 / Y)) hX hY hs (by positivity : 0 < qn c.1 * qn n.1 ^ 3)
          (by positivity : 0 < Real.sqrt (qn c.1) * qn n.1)
        have hcx : (((Y⁻¹ * W₁ (qn s.1 / Y) / Real.sqrt (qn s.1 * X) / Real.sqrt (qn s.1) : ℝ) : ℂ) *
            ((X * qn s.1 / (qn c.1 * qn n.1 ^ 3) : ℝ) : ℂ) / ((Real.sqrt (qn c.1) * qn n.1 : ℝ) : ℂ)) =
            ((Kc X Y (c, (n, (s, y.2))) : ℝ) : ℂ) * ((W₁ (ys Y (c, (n, (s, y.2)))) : ℝ) : ℂ) := by
          rw [← Complex.ofReal_mul, ← Complex.ofReal_mul, ← Complex.ofReal_div, hreal]
          rfl
        simp only [reidx, Equiv.coe_fn_mk, Tm, Ar, xA, vh, hκ]
        rw [hN]
        simp only [qn] at hcx ⊢
        linear_combination (gaussPhase g 2 c.1 * χ.thetaChar g (c.1 * n.1 ^ 3) *
          ((gaussianPG ((Ideal.absNorm c.1 : ℝ) * (Ideal.absNorm n.1 : ℝ) ^ 3 / Z) : ℝ) : ℂ) *
          poissonFactor g s.1 (c.1 * n.1 ^ 3) (freqElt g y.1 * g.gen y.2.1 ^ 6) *
          mellinInv 2 M (X * ((Ideal.absNorm y.1.1.1 : ℝ) * (Ideal.absNorm y.2.1 : ℝ) ^ 6) /
            ((Ideal.absNorm c.1 : ℝ) * (Ideal.absNorm n.1 : ℝ) ^ 3))) * hcx
    _ = ∑' x : FreqClass 𝔪 × Idx 𝔪, Tm g χ W₁ M x.1 X Y Z x.2 := by
        rw [← hsT'.tsum_prod]
        exact (reidx 𝔪).tsum_eq (fun x : FreqClass 𝔪 × Idx 𝔪 => Tm g χ W₁ M x.1 X Y Z x.2)

end

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_Quot: exterior ideals of `𝓞 F` and of `R` (copied from L2A_FSQuot, prover A, to decouple)

* `exists_pow_mul_mem`: every `r ∈ R` has `𝔪^N r ⊆ 𝓞`.
* `mem_of_map_mem`: `I R ∩ 𝓞 = I` for `I + 𝔪 = 1`.
* `exists_sub_mem_map`: `𝓞 → R / I R` is onto for `I + 𝔪 = 1`; `finite_quot_map`,

-/

open NumberField IsDedekindDomain WithZero

namespace ArtinPrimitiveRoots.L2B

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)}

/-- Every `r ∈ R` has `𝔪^N r ⊆ 𝓞` for some `N`. -/
lemma exists_pow_mul_mem (r : SInt 𝔪) : ∃ N : ℕ, ∀ w ∈ 𝔪 ^ N, ∃ c : 𝓞 F,
    algebraMap (𝓞 F) (SInt 𝔪) w * r = algebraMap (𝓞 F) (SInt 𝔪) c := by
  obtain ⟨b, d, hd, hbd⟩ := IsFractionRing.div_surjective (A := 𝓞 F) (r : F)
  have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
  set N := Ideal.absNorm (Ideal.span {d}) with hN
  refine ⟨N, fun w hw => ?_⟩
  have hint : ∀ v : HeightOneSpectrum (𝓞 F),
      v.valuation F (algebraMap (𝓞 F) F w * (r : F)) ≤ 1 := by
    intro v
    by_cases hv : v ∈ placesOf 𝔪
    · have hvm : 𝔪 ≤ v.asIdeal := hv
      have hdN : d ∉ v.asIdeal ^ N := by
        intro hmem
        have hle : Ideal.span {d} ≤ v.asIdeal ^ N := (Ideal.span_singleton_le_iff_mem _).2 hmem
        have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
        rw [map_pow] at hdvd
        have hN0 : N ≠ 0 := by
          rw [hN, Ne, Ideal.absNorm_eq_zero_iff, Ideal.span_singleton_eq_bot]; exact hd0
        have h2 : 2 ≤ Ideal.absNorm v.asIdeal := by
          have h0 : Ideal.absNorm v.asIdeal ≠ 0 := by
            rw [Ne, Ideal.absNorm_eq_zero_iff]; exact v.ne_bot
          have h1 : Ideal.absNorm v.asIdeal ≠ 1 := by
            rw [Ne, Ideal.absNorm_eq_one_iff]; exact v.isPrime.ne_top
          omega
        have := Nat.le_of_dvd (Nat.pos_of_ne_zero hN0) hdvd
        have h3 : 2 ^ N ≤ Ideal.absNorm v.asIdeal ^ N := Nat.pow_le_pow_left h2 N
        have h4 : N < 2 ^ N := Nat.lt_two_pow_self
        omega
      have hvd : exp (-(N : ℤ)) < v.valuation F (algebraMap (𝓞 F) F d) := by
        rw [C3I.val_alg, ← not_le, v.intValuation_le_pow_iff_mem]; exact hdN
      have hvw : v.valuation F (algebraMap (𝓞 F) F w) ≤ exp (-(N : ℤ)) := by
        rw [C3I.val_alg, v.intValuation_le_pow_iff_mem]
        exact Ideal.pow_right_mono hvm N hw
      have hdpos : v.valuation F (algebraMap (𝓞 F) F d) ≠ 0 := ne_zero_of_lt hvd
      have hxd : (r : F) * algebraMap (𝓞 F) F d = algebraMap (𝓞 F) F b := by
        rw [← hbd, div_mul_cancel₀]
        exact (map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 hd0
      have key : v.valuation F (algebraMap (𝓞 F) F w * (r : F)) *
          v.valuation F (algebraMap (𝓞 F) F d) ≤ 1 * v.valuation F (algebraMap (𝓞 F) F d) := by
        rw [← map_mul, show algebraMap (𝓞 F) F w * (r : F) * algebraMap (𝓞 F) F d =
          algebraMap (𝓞 F) F b * algebraMap (𝓞 F) F w by rw [mul_assoc, hxd]; ring, map_mul]
        exact mul_le_mul' (v.valuation_le_one b) (hvw.trans hvd.le)
      exact C3I.le_of_mul_le_mul_ne key hdpos
    · rw [map_mul]
      exact mul_le_one' (v.valuation_le_one w) (r.2 v hv)
  obtain ⟨c, hc⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one F _ hint
  refine ⟨c, Subtype.ext ?_⟩
  rw [Subalgebra.coe_mul, C3I.coe_alg, C3I.coe_alg, hc]

/-- `I R ∩ 𝓞 = I` for an ideal `I` coprime to `𝔪`. -/
lemma mem_of_map_mem (I : Ideal (𝓞 F)) (hI : I ⊔ 𝔪 = ⊤) (a : 𝓞 F)
    (ha : algebraMap (𝓞 F) (SInt 𝔪) a ∈ I.map (algebraMap (𝓞 F) (SInt 𝔪))) : a ∈ I := by
  set φ := algebraMap (𝓞 F) (SInt 𝔪)
  have hinj : Function.Injective φ := by
    intro x y hxy
    have := congrArg (fun z : SInt 𝔪 => (z : F)) hxy
    simp only [φ, C3I.coe_alg] at this
    exact IsFractionRing.injective (𝓞 F) F this
  -- the predicate
  have hQ : ∀ x ∈ I.map φ, ∃ N : ℕ, ∀ w ∈ 𝔪 ^ N, ∃ i ∈ I, φ w * x = φ i := by
    intro x hx
    rw [Ideal.map] at hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i0, hi0, rfl⟩ := hx
      exact ⟨0, fun w _ => ⟨w * i0, I.mul_mem_left _ hi0, by rw [map_mul]⟩⟩
    | zero => exact ⟨0, fun w _ => ⟨0, I.zero_mem, by simp⟩⟩
    | add x y _ _ hx hy =>
      obtain ⟨N1, h1⟩ := hx
      obtain ⟨N2, h2⟩ := hy
      refine ⟨max N1 N2, fun w hw => ?_⟩
      obtain ⟨i1, hi1, e1⟩ := h1 w (Ideal.pow_le_pow_right (le_max_left _ _) hw)
      obtain ⟨i2, hi2, e2⟩ := h2 w (Ideal.pow_le_pow_right (le_max_right _ _) hw)
      exact ⟨i1 + i2, I.add_mem hi1 hi2, by rw [mul_add, e1, e2, map_add]⟩
    | smul r x _ hx =>
      obtain ⟨Nx, hNx⟩ := hx
      obtain ⟨Nr, hNr⟩ := exists_pow_mul_mem (𝔪 := 𝔪) r
      refine ⟨Nr + Nx, fun w hw => ?_⟩
      rw [pow_add] at hw
      refine Submodule.mul_induction_on hw ?_ ?_
      · intro w1 hw1 w2 hw2
        obtain ⟨c, hc⟩ := hNr w1 hw1
        obtain ⟨i, hi, ei⟩ := hNx w2 hw2
        refine ⟨c * i, I.mul_mem_left _ hi, ?_⟩
        rw [smul_eq_mul, map_mul, map_mul, ← hc, ← ei]; ring
      · rintro w1 w2 ⟨i1, hi1, e1⟩ ⟨i2, hi2, e2⟩
        exact ⟨i1 + i2, I.add_mem hi1 hi2, by rw [map_add, add_mul, e1, e2, map_add]⟩
  obtain ⟨N, hN⟩ := hQ _ ha
  have hcop : IsCoprime I (𝔪 ^ N) := (Ideal.isCoprime_iff_sup_eq.mpr hI).pow_right
  obtain ⟨u, hu, w, hw, huw⟩ := hcop.exists
  obtain ⟨i, hi, ei⟩ := hN w hw
  have : w * a = i := hinj (by rw [map_mul, ei])
  have ha' : a = u * a + w * a := by rw [← add_mul, huw, one_mul]
  rw [ha', this]
  exact I.add_mem (I.mul_mem_right _ hu) hi

/-- `𝓞 → R / I R` is onto for `I` coprime to `𝔪`. -/
lemma exists_sub_mem_map (I : Ideal (𝓞 F)) (hI : I ⊔ 𝔪 = ⊤) (r : SInt 𝔪) :
    ∃ c : 𝓞 F, r - algebraMap (𝓞 F) (SInt 𝔪) c ∈ I.map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  obtain ⟨N, hN⟩ := exists_pow_mul_mem (𝔪 := 𝔪) r
  have hcop : IsCoprime I (𝔪 ^ N) := (Ideal.isCoprime_iff_sup_eq.mpr hI).pow_right
  obtain ⟨u, hu, w, hw, huw⟩ := hcop.exists
  obtain ⟨c, hc⟩ := hN w hw
  refine ⟨c, ?_⟩
  have : r - algebraMap (𝓞 F) (SInt 𝔪) c = algebraMap (𝓞 F) (SInt 𝔪) u * r := by
    rw [← hc]
    have : algebraMap (𝓞 F) (SInt 𝔪) u + algebraMap (𝓞 F) (SInt 𝔪) w = 1 := by
      rw [← map_add, huw, map_one]
    linear_combination (-r) * this
  rw [this]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hu)

lemma quotHom_surjective (I : Ideal (𝓞 F)) (hI : I ⊔ 𝔪 = ⊤) :
    Function.Surjective (C3I.quotHom 𝔪 I) := by
  intro y
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨c, hc⟩ := exists_sub_mem_map I hI r
  exact ⟨Ideal.Quotient.mk _ c, by rw [C3I.quotHom_mk]; exact (Ideal.Quotient.eq.mpr hc).symm⟩

lemma finite_quot_map (I : Ideal (𝓞 F)) (hI0 : I ≠ ⊥) (hI : I ⊔ 𝔪 = ⊤) :
    Finite (SInt 𝔪 ⧸ I.map (algebraMap (𝓞 F) (SInt 𝔪))) := by
  have : Finite (𝓞 F ⧸ I) := Ring.HasFiniteQuotients.finiteQuotient hI0
  exact Finite.of_surjective _ (quotHom_surjective I hI)

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_Orth: `#(R/𝔰R) = q_𝔰`, primitivity and orthogonality of `j ↦ e(j k / s)`

* `natCard_quot_eq`: `#(R/𝔰R) = N 𝔰` for exterior `𝔰`;
* `exists_primePow_not_mem`: `k ∉ 𝔰R` ⇒ `k ∉ P^a R` for a prime power `P^a ∣ 𝔰`;
* `exists_sAddChar_ne_one_gen`: primitivity of `j ↦ e(j k / s)` for `k ∉ 𝔰R`;
* `finsum_sAddChar`: `∑_{j mod 𝔰} e(j k / s) = q_𝔰 [k ∈ 𝔰R]`.
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField IsDedekindDomain UniqueFactorizationMonoid

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

theorem natCard_quot_eq {𝔞 : Ideal (𝓞 F)} (h𝔞 : IsExterior 𝔪 𝔞) :
    Nat.card (SInt 𝔪 ⧸ 𝔞.map (algebraMap (𝓞 F) (SInt 𝔪))) = Ideal.absNorm 𝔞 := by
  have hbij : Function.Bijective (C3I.quotHom 𝔪 𝔞) := by
    refine ⟨?_, quotHom_surjective 𝔞 h𝔞.2⟩
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [C3I.quotHom_mk, Ideal.Quotient.eq_zero_iff_mem] at hy
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact mem_of_map_mem 𝔞 h𝔞.2 a hy
  rw [← Nat.card_congr (Equiv.ofBijective _ hbij), Ideal.absNorm_apply, Submodule.cardQuot_apply]

/-- A residue `k ∉ 𝔰R` already fails modulo a prime power dividing `𝔰`. -/
theorem exists_primePow_not_mem (𝔰 : Ideal (𝓞 F)) (h𝔰 : 𝔰 ≠ ⊥) (k : SInt 𝔪)
    (hk : k ∉ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    ∃ P : Ideal (𝓞 F), ∃ a : ℕ, P.IsPrime ∧ P ≠ ⊥ ∧ 1 ≤ a ∧ 𝔰 ≤ P ^ a ∧
      k ∉ (P ^ a).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  induction 𝔰 using UniqueFactorizationMonoid.induction_on_coprime generalizing k with
  | h0 => exact absurd rfl h𝔰
  | h1 hu =>
    rw [Ideal.isUnit_iff.1 hu, Ideal.map_top] at hk
    exact absurd Submodule.mem_top hk
  | hpr i hp =>
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · rw [pow_zero, Ideal.one_eq_top, Ideal.map_top] at hk
      exact absurd Submodule.mem_top hk
    · exact ⟨_, i, Ideal.isPrime_of_prime hp, hp.ne_zero, hi, le_rfl, hk⟩
  | hcp hxy ihx ihy =>
    rename_i x y
    have hx0 : x ≠ ⊥ := fun h => h𝔰 (by rw [h, Ideal.bot_mul])
    have hy0 : y ≠ ⊥ := fun h => h𝔰 (by rw [h, Ideal.mul_bot])
    have hcop : x ⊔ y = ⊤ := by
      have hd := hxy (Ideal.dvd_iff_le.2 le_sup_left) (Ideal.dvd_iff_le.2 le_sup_right)
      exact Ideal.isUnit_iff.1 hd
    have hcopR : IsCoprime (x.map (algebraMap (𝓞 F) (SInt 𝔪)))
        (y.map (algebraMap (𝓞 F) (SInt 𝔪))) := by
      rw [Ideal.isCoprime_iff_sup_eq, ← Ideal.map_sup, hcop, Ideal.map_top]
    rw [Ideal.map_mul, Ideal.mul_eq_inf_of_isCoprime hcopR, Submodule.mem_inf, not_and_or]
      at hk
    rcases hk with hk | hk
    · obtain ⟨P, a, h1, h2, h3, h4, h5⟩ := ihx hx0 k hk
      exact ⟨P, a, h1, h2, h3, le_trans Ideal.mul_le_left h4, h5⟩
    · obtain ⟨P, a, h1, h2, h3, h4, h5⟩ := ihy hy0 k hk
      exact ⟨P, a, h1, h2, h3, le_trans Ideal.mul_le_right h4, h5⟩

/-- Primitivity of `j ↦ e(j k / gen 𝔰)` for `k ∉ 𝔰R`. -/
theorem exists_sAddChar_ne_one_gen (g : AllowedGen ι 𝔪)
    (hD : ∀ P : Ideal (𝓞 F), P.IsPrime → IsExterior 𝔪 P → ¬ differentIdeal ℤ (𝓞 F) ≤ P)
    {𝔰 : Ideal (𝓞 F)} (h𝔰 : IsExterior 𝔪 𝔰) (k : SInt 𝔪)
    (hk : k ∉ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    ∃ j : SInt 𝔪, sAddChar 𝔪 ((j : F) * (k : F) / (g.gen 𝔰 : F)) ≠ 1 := by
  obtain ⟨P, a, hP, hP0, ha, hle, hkP⟩ := exists_primePow_not_mem 𝔰 h𝔰.1 k hk
  have hPa : 𝔰 ≤ P := le_trans hle (Ideal.pow_le_self (by omega))
  have hPS : P ⊔ 𝔪 = ⊤ := eq_top_iff.2 (h𝔰.2 ▸ sup_le_sup_right hPa 𝔪)
  have hPe : IsExterior 𝔪 P := ⟨hP0, hPS⟩
  let v : HeightOneSpectrum (𝓞 F) := ⟨P, hP, hP0⟩
  have hv : v ∉ placesOf 𝔪 := by
    intro hv
    have : (⊤ : Ideal (𝓞 F)) ≤ P := hPS ▸ sup_le le_rfl hv
    exact hP.ne_top (eq_top_iff.2 this)
  obtain ⟨r, hr⟩ := C3I.exists_sAddChar_ne_one g hv hPS (hD P hP hPe) ha k hkP
  -- `gen 𝔰 = gen (P^a) * w`
  have hext : IsExterior 𝔪 (P ^ a) := C3I.isExterior_pow hPe a
  have hmem : g.gen 𝔰 ∈ (P ^ a).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
    have h1 : g.gen 𝔰 ∈ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)) := by
      rw [← g.span_gen 𝔰 h𝔰]; exact Ideal.mem_span_singleton_self _
    exact Ideal.map_mono hle h1
  obtain ⟨w, hw⟩ := (C3B.mem_map_iff g (P ^ a) hext (g.gen 𝔰)).1 hmem
  have hs0 := C3B.gen_ne_zero g 𝔰 h𝔰
  have hw0 : (w : F) ≠ 0 := by
    intro h0; apply hs0; rw [hw, Subalgebra.coe_mul, h0, mul_zero]
  refine ⟨r * w, ?_⟩
  have hgA0 := C3B.gen_ne_zero g _ hext
  have e : ((r * w : SInt 𝔪) : F) * (k : F) / (g.gen 𝔰 : F) =
      (k : F) * (r : F) / (g.gen (P ^ a) : F) := by
    rw [hw, Subalgebra.coe_mul, Subalgebra.coe_mul]
    field_simp
  rw [e]
  exact hr

theorem finsum_const_one {α : Type*} [Finite α] : ∑ᶠ _ : α, (1 : ℂ) = Nat.card α := by
  have := Fintype.ofFinite α
  rw [finsum_eq_sum_of_fintype, Finset.sum_const, Finset.card_univ, Nat.card_eq_fintype_card]
  simp

open Classical in
/-- Orthogonality: `∑_{j mod 𝔰} e(j k / s) = q_𝔰 [k ∈ 𝔰R]`. -/
theorem finsum_sAddChar (g : AllowedGen ι 𝔪)
    (hD : ∀ P : Ideal (𝓞 F), P.IsPrime → IsExterior 𝔪 P → ¬ differentIdeal ℤ (𝓞 F) ≤ P)
    {𝔰 : Ideal (𝓞 F)} (h𝔰 : IsExterior 𝔪 𝔰) (k : SInt 𝔪) :
    ∑ᶠ j : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)),
        sAddChar 𝔪 ((quotLift j : F) * (k : F) / (g.gen 𝔰 : F)) =
      if k ∈ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)) then (Ideal.absNorm 𝔰 : ℂ) else 0 := by
  have hfin := finite_quot_map 𝔰 h𝔰.1 h𝔰.2
  set I := 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))
  split_ifs with hk
  · have h1 : ∀ j : SInt 𝔪 ⧸ I, sAddChar 𝔪 ((quotLift j : F) * (k : F) / (g.gen 𝔰 : F)) = 1 := by
      intro j
      apply C3B.sAddChar_of_mem
      have := C3B.div_gen_mem g 𝔰 h𝔰 (quotLift j * k) (Ideal.mul_mem_left _ _ hk)
      simpa [Subalgebra.coe_mul] using this
    simp only [h1]
    rw [finsum_const_one, natCard_quot_eq h𝔰]
  · obtain ⟨j₀, hj₀⟩ := exists_sAddChar_ne_one_gen g hD h𝔰 k hk
    set S := ∑ᶠ j : SInt 𝔪 ⧸ I, sAddChar 𝔪 ((quotLift j : F) * (k : F) / (g.gen 𝔰 : F))
    have hshift : S = S * sAddChar 𝔪 ((j₀ : F) * (k : F) / (g.gen 𝔰 : F)) := by
      rw [finsum_mul]
      simp only [S]
      rw [← finsum_comp_equiv (Equiv.addRight (Ideal.Quotient.mk I j₀))]
      refine finsum_congr fun j => ?_
      simp only [Equiv.coe_addRight]
      have hδ : quotLift (j + Ideal.Quotient.mk I j₀) - (quotLift j + j₀) ∈ I := by
        rw [← Ideal.Quotient.eq, map_add]
        simp only [quotLift, Function.surjInv_eq Ideal.Quotient.mk_surjective]
      set δ := quotLift (j + Ideal.Quotient.mk I j₀) - (quotLift j + j₀)
      have hmem : (δ : F) * (k : F) / (g.gen 𝔰 : F) ∈ (placesOf 𝔪).integer F := by
        have := C3B.div_gen_mem g 𝔰 h𝔰 (δ * k) (Ideal.mul_mem_right _ _ hδ)
        simpa [Subalgebra.coe_mul] using this
      have e1 : ((quotLift (j + Ideal.Quotient.mk I j₀) : SInt 𝔪) : F) * (k : F) /
          (g.gen 𝔰 : F) = (((quotLift j * k : SInt 𝔪) : F) / (g.gen 𝔰 : F) +
            ((j₀ * k : SInt 𝔪) : F) / (g.gen 𝔰 : F)) + (δ : F) * (k : F) / (g.gen 𝔰 : F) := by
        simp only [δ, Subalgebra.coe_mul, Subalgebra.coe_sub, Subalgebra.coe_add]
        ring
      rw [e1, C3B.sAddChar_add_mem _ _ hmem, C3I.sAddChar_add (C3I.hasWit_div_gen g 𝔰 h𝔰 _)
        (C3I.hasWit_div_gen g 𝔰 h𝔰 _)]
      simp only [Subalgebra.coe_mul]
    have h1 : S * (1 - sAddChar 𝔪 ((j₀ : F) * (k : F) / (g.gen 𝔰 : F))) = 0 := by
      rw [mul_sub, mul_one, ← hshift, sub_self]
    rcases mul_eq_zero.1 h1 with h | h
    · exact h
    · exact absurd (sub_eq_zero.1 h).symm hj₀

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_F78: the finite Fourier identity (7.8)

`∑_{x mod 𝔰𝔄} g_𝔰(−x) χ_𝔄(x) e(h x / (s A)) = q_𝔰 F(𝔰, 𝔄, h)` (p. 45), with `s, A` the allowed
generators. The proof is the paper's: expand `g_𝔰`, write `x = v + A j`, sum over `j`.
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField IsDedekindDomain UniqueFactorizationMonoid

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)} {ι : F →+* ℂ}

/-- The dual coefficient `ĉ(h) = ∑_{x mod 𝔫} c(x) e(h x / ν)`. -/
noncomputable def dualCoeff (𝔫 : Ideal (𝓞 F)) (ν : SInt 𝔪) (c : SInt 𝔪 → ℂ) (h : SInt 𝔪) : ℂ :=
  ∑ᶠ x : SInt 𝔪 ⧸ 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪)),
    c (quotLift x) * sAddChar 𝔪 ((h : F) * (quotLift x : F) / (ν : F))

theorem quotLift_mk' (I : Ideal (SInt 𝔪)) (y : SInt 𝔪) :
    Ideal.Quotient.mk I (quotLift (Ideal.Quotient.mk I y)) = Ideal.Quotient.mk I y :=
  Function.surjInv_eq Ideal.Quotient.mk_surjective _

theorem mk_quotLift (I : Ideal (SInt 𝔪)) (x : SInt 𝔪 ⧸ I) :
    Ideal.Quotient.mk I (quotLift x) = x :=
  Function.surjInv_eq Ideal.Quotient.mk_surjective _

/-- `a / ν ∈ R` for `a ∈ 𝔫R = νR`. -/
theorem div_mem_of_span {𝔫 : Ideal (𝓞 F)} {ν : SInt 𝔪}
    (hν : Ideal.span {ν} = 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪))) (hν0 : (ν : F) ≠ 0)
    (y : SInt 𝔪) (hy : y ∈ 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪))) :
    (y : F) / (ν : F) ∈ (placesOf 𝔪).integer F := by
  rw [← hν, Ideal.mem_span_singleton'] at hy
  obtain ⟨r, rfl⟩ := hy
  rw [Subalgebra.coe_mul, mul_div_cancel_right₀ _ hν0]
  exact r.2

theorem hasWit_div {𝔫 : Ideal (𝓞 F)} (h𝔫 : IsExterior 𝔪 𝔫) {ν : SInt 𝔪}
    (hν : Ideal.span {ν} = 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪))) (hν0 : (ν : F) ≠ 0)
    (a : SInt 𝔪) : C3I.HasWit 𝔪 ((a : F) / (ν : F)) := by
  apply C3I.hasWit_of_mul_mem _ 𝔫 h𝔫.2
  intro i hi
  have hm : algebraMap (𝓞 F) (SInt 𝔪) i ∈ 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
    Ideal.mem_map_of_mem _ hi
  have := div_mem_of_span hν hν0 _ hm
  rw [C3I.coe_alg] at this
  rw [show (a : F) / (ν : F) * algebraMap (𝓞 F) F i = (a : F) * (algebraMap (𝓞 F) F i / (ν : F)) by
    ring]
  exact mul_mem a.2 this

section

variable (g : AllowedGen ι 𝔪) {𝔰 𝔄 : Ideal (𝓞 F)} (h𝔰 : IsExterior 𝔪 𝔰) (h𝔄 : IsExterior 𝔪 𝔄)
include h𝔰 h𝔄

theorem span_gen_mul :
    Ideal.span {g.gen 𝔰 * g.gen 𝔄} = (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)) := by
  rw [← Ideal.span_singleton_mul_span_singleton, g.span_gen 𝔰 h𝔰, g.span_gen 𝔄 h𝔄,
    Ideal.map_mul]

theorem gen_mul_ne_zero : ((g.gen 𝔰 * g.gen 𝔄 : SInt 𝔪) : F) ≠ 0 := by
  rw [Subalgebra.coe_mul]
  exact mul_ne_zero (C3B.gen_ne_zero g 𝔰 h𝔰) (C3B.gen_ne_zero g 𝔄 h𝔄)

/-- `x = v + A j`: sums over `R/𝔰𝔄R` as double sums over `R/𝔄R × R/𝔰R`. -/
theorem finsum_split (f : SInt 𝔪 → ℂ)
    (hf : ∀ x w, w ∈ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)) → f (x + w) = f x) :
    ∑ᶠ x : SInt 𝔪 ⧸ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)), f (quotLift x) =
      ∑ᶠ v : SInt 𝔪 ⧸ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪)),
        ∑ᶠ j : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)),
          f (quotLift v + g.gen 𝔄 * quotLift j) := by
  set Is := 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))
  set IA := 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪))
  set IN := (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪))
  set A := g.gen 𝔄
  have hA : Ideal.span {A} = IA := g.span_gen 𝔄 h𝔄
  have hN : IN = Is * IA := Ideal.map_mul _ _ _
  have hNA : IN ≤ IA := by rw [hN]; exact Ideal.mul_le_right
  have hA0 : A ≠ 0 := fun h => C3B.gen_ne_zero g 𝔄 h𝔄 (by rw [show g.gen 𝔄 = 0 from h]; rfl)
  let φ : (SInt 𝔪 ⧸ IA) × (SInt 𝔪 ⧸ Is) → SInt 𝔪 ⧸ IN :=
    fun p => Ideal.Quotient.mk IN (quotLift p.1 + A * quotLift p.2)
  have hφ : Function.Bijective φ := by
    constructor
    · rintro ⟨v, j⟩ ⟨v', j'⟩ hvj
      simp only [φ, Ideal.Quotient.eq] at hvj
      have hv : v = v' := by
        rw [← mk_quotLift IA v, ← mk_quotLift IA v', Ideal.Quotient.eq]
        have h1 := hNA hvj
        have h2 : A * (quotLift j - quotLift j') ∈ IA := by
          rw [← hA]
          exact Ideal.mul_mem_right (quotLift j - quotLift j') (Ideal.span {A})
            (Ideal.mem_span_singleton_self A)
        have := sub_mem h1 h2
        rwa [show quotLift v + A * quotLift j - (quotLift v' + A * quotLift j') -
          A * (quotLift j - quotLift j') = quotLift v - quotLift v' by ring] at this
      subst hv
      refine Prod.ext rfl ?_
      rw [← mk_quotLift Is j, ← mk_quotLift Is j', Ideal.Quotient.eq]
      have h1 : A * (quotLift j - quotLift j') ∈ Is * IA := by
        rw [← hN]
        rwa [show quotLift v + A * quotLift j - (quotLift v + A * quotLift j') =
          A * (quotLift j - quotLift j') by ring] at hvj
      rw [← hA, mul_comm Is, Ideal.mem_span_singleton_mul] at h1
      obtain ⟨z, hz, hzA⟩ := h1
      have : z = quotLift j - quotLift j' := mul_left_cancel₀ hA0 hzA
      rw [← this]; exact hz
    · intro x
      set y := quotLift x
      have hy : y - quotLift (Ideal.Quotient.mk IA y) ∈ IA := by
        rw [← Ideal.Quotient.eq, quotLift_mk']
      obtain ⟨z, hz⟩ := (C3B.mem_map_iff g 𝔄 h𝔄 _).1 hy
      change _ = A * z at hz
      refine ⟨(Ideal.Quotient.mk IA y, Ideal.Quotient.mk Is z), ?_⟩
      simp only [φ]
      rw [← mk_quotLift IN x, Ideal.Quotient.eq]
      have hzz : z - quotLift (Ideal.Quotient.mk Is z) ∈ Is := by
        rw [← Ideal.Quotient.eq, quotLift_mk']
      have : quotLift (Ideal.Quotient.mk IA y) + A * quotLift (Ideal.Quotient.mk Is z) - y =
          -((z - quotLift (Ideal.Quotient.mk Is z)) * A) := by
        linear_combination (-1 : SInt 𝔪) * hz
      rw [this, hN]
      refine neg_mem (Ideal.mul_mem_mul hzz ?_)
      rw [← hA]; exact Ideal.mem_span_singleton_self _
  have hfin1 := finite_quot_map 𝔄 h𝔄.1 h𝔄.2
  have hfin2 := finite_quot_map 𝔰 h𝔰.1 h𝔰.2
  rw [← finsum_comp_equiv (Equiv.ofBijective φ hφ), finsum_curry _ (Set.toFinite _)]
  refine finsum_congr fun v => finsum_congr fun j => ?_
  simp only [Equiv.ofBijective_apply, φ]
  have hd : quotLift (Ideal.Quotient.mk IN (quotLift v + A * quotLift j)) -
      (quotLift v + A * quotLift j) ∈ IN := by
    rw [← Ideal.Quotient.eq, quotLift_mk']
  have := hf (quotLift v + A * quotLift j) _ hd
  rwa [add_sub_cancel] at this

open Classical in
/-- The inner sum of (7.8): `∑_{x mod 𝔰𝔄} χ_𝔄(x) e(x k/(sA)) = q_𝔰 [k ∈ 𝔰R] g_𝔄(k/s)`. -/
theorem inner_sum
    (hD : ∀ P : Ideal (𝓞 F), P.IsPrime → IsExterior 𝔪 P → ¬ differentIdeal ℤ (𝓞 F) ≤ P)
    (k : SInt 𝔪) :
    ∑ᶠ x : SInt 𝔪 ⧸ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)),
        residueSymbol ι 𝔪 𝔄 (quotLift x) *
          sAddChar 𝔪 ((quotLift x : F) * (k : F) / ((g.gen 𝔰 * g.gen 𝔄 : SInt 𝔪) : F)) =
      (if k ∈ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)) then (Ideal.absNorm 𝔰 : ℂ) else 0) *
        gaussSumAt g 𝔄 ((k : F) / (g.gen 𝔰 : F)) := by
  classical
  have hsp := span_gen_mul g h𝔰 h𝔄
  have hν0 := gen_mul_ne_zero g h𝔰 h𝔄
  have hs0 := C3B.gen_ne_zero g 𝔰 h𝔰
  have hA0 := C3B.gen_ne_zero g 𝔄 h𝔄
  have hext : IsExterior 𝔪 (𝔰 * 𝔄) := C3I.isExterior_mul h𝔰 h𝔄
  set ν := g.gen 𝔰 * g.gen 𝔄
  have hle : (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)) ≤ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
    Ideal.map_mono Ideal.mul_le_right
  rw [finsum_split g h𝔰 h𝔄 (fun y => residueSymbol ι 𝔪 𝔄 y *
    sAddChar 𝔪 ((y : F) * (k : F) / (ν : F))) (fun y w hw => by
      rw [C3B.residueSymbol_congr ι 𝔄 (y + w) y (by simpa using hle hw)]
      congr 1
      have hm := div_mem_of_span hsp hν0 (w * k) (Ideal.mul_mem_right _ _ hw)
      rw [show ((y + w : SInt 𝔪) : F) * (k : F) / (ν : F) =
        (y : F) * (k : F) / (ν : F) + ((w * k : SInt 𝔪) : F) / (ν : F) by
          simp only [Subalgebra.coe_add, Subalgebra.coe_mul]; ring]
      exact C3B.sAddChar_add_mem _ _ hm)]
  have hfin1 := finite_quot_map 𝔄 h𝔄.1 h𝔄.2
  have hfin2 := finite_quot_map 𝔰 h𝔰.1 h𝔰.2
  have hterm : ∀ (v : SInt 𝔪 ⧸ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪)))
      (j : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))),
      residueSymbol ι 𝔪 𝔄 (quotLift v + g.gen 𝔄 * quotLift j) *
        sAddChar 𝔪 (((quotLift v + g.gen 𝔄 * quotLift j : SInt 𝔪) : F) * (k : F) / (ν : F)) =
      (residueSymbol ι 𝔪 𝔄 (quotLift v) *
        sAddChar 𝔪 ((k : F) / (g.gen 𝔰 : F) * (quotLift v : F) / (g.gen 𝔄 : F))) *
        sAddChar 𝔪 ((quotLift j : F) * (k : F) / (g.gen 𝔰 : F)) := by
    intro v j
    rw [C3B.residueSymbol_congr ι 𝔄 _ (quotLift v)
      (by rw [add_sub_cancel_left]; exact (C3B.mem_map_iff g 𝔄 h𝔄 _).2 ⟨_, rfl⟩)]
    rw [show ((quotLift v + g.gen 𝔄 * quotLift j : SInt 𝔪) : F) * (k : F) / (ν : F) =
        ((quotLift v * k : SInt 𝔪) : F) / (ν : F) +
          ((quotLift j * k : SInt 𝔪) : F) / (g.gen 𝔰 : F) by
      simp only [ν, Subalgebra.coe_add, Subalgebra.coe_mul]; field_simp,
      C3I.sAddChar_add (hasWit_div hext hsp hν0 _) (C3I.hasWit_div_gen g 𝔰 h𝔰 _), mul_assoc]
    congr 3
    simp only [ν, Subalgebra.coe_mul]; field_simp
  simp only [hterm]
  have := Fintype.ofFinite (SInt 𝔪 ⧸ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪)))
  have := Fintype.ofFinite (SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)))
  have horth := finsum_sAddChar g hD h𝔰 k
  simp only [finsum_eq_sum_of_fintype] at horth ⊢
  simp only [← Finset.mul_sum, ← Finset.sum_mul, horth, gaussSumAt, finsum_eq_sum_of_fintype]
  ring

/-- **(7.8)**: `∑_{x mod 𝔰𝔄} g_𝔰(−x) χ_𝔄(x) e(h x/(sA)) = q_𝔰 F(𝔰, 𝔄, h)`. -/
theorem f78
    (hD : ∀ P : Ideal (𝓞 F), P.IsPrime → IsExterior 𝔪 P → ¬ differentIdeal ℤ (𝓞 F) ≤ P)
    (h : SInt 𝔪) :
    dualCoeff (𝔰 * 𝔄) (g.gen 𝔰 * g.gen 𝔄)
        (fun x => gaussSumAt g 𝔰 (-(x : F)) * residueSymbol ι 𝔪 𝔄 x) h =
      (Ideal.absNorm 𝔰 : ℂ) * poissonFactor g 𝔰 𝔄 h := by
  classical
  have hsp := span_gen_mul g h𝔰 h𝔄
  have hν0 := gen_mul_ne_zero g h𝔰 h𝔄
  have hs0 := C3B.gen_ne_zero g 𝔰 h𝔰
  have hA0 := C3B.gen_ne_zero g 𝔄 h𝔄
  have hext : IsExterior 𝔪 (𝔰 * 𝔄) := C3I.isExterior_mul h𝔰 h𝔄
  set ν := g.gen 𝔰 * g.gen 𝔄
  have hfinN := finite_quot_map (𝔰 * 𝔄) hext.1 hext.2
  have hfin2 := finite_quot_map 𝔰 h𝔰.1 h𝔰.2
  -- the summand, expanded
  have hpt : ∀ (x : SInt 𝔪 ⧸ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)))
      (d : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪))),
      residueSymbol ι 𝔪 𝔰 (quotLift d) *
          sAddChar 𝔪 (-((quotLift x : SInt 𝔪) : F) * (quotLift d : F) / (g.gen 𝔰 : F)) *
          residueSymbol ι 𝔪 𝔄 (quotLift x) *
          sAddChar 𝔪 ((h : F) * (quotLift x : F) / (ν : F)) =
        residueSymbol ι 𝔪 𝔰 (quotLift d) * (residueSymbol ι 𝔪 𝔄 (quotLift x) *
          sAddChar 𝔪 ((quotLift x : F) * ((h - g.gen 𝔄 * quotLift d : SInt 𝔪) : F) / (ν : F))) := by
    intro x d
    have e1 : -((quotLift x : SInt 𝔪) : F) * (quotLift d : F) / (g.gen 𝔰 : F) =
        ((-quotLift x * quotLift d : SInt 𝔪) : F) / (g.gen 𝔰 : F) := by
      simp only [Subalgebra.coe_mul, Subalgebra.coe_neg]
    have e2 : (h : F) * (quotLift x : F) / (ν : F) = ((h * quotLift x : SInt 𝔪) : F) / (ν : F) := by
      simp only [Subalgebra.coe_mul]
    have e3 : (quotLift x : F) * ((h - g.gen 𝔄 * quotLift d : SInt 𝔪) : F) / (ν : F) =
        ((-quotLift x * quotLift d : SInt 𝔪) : F) / (g.gen 𝔰 : F) +
          ((h * quotLift x : SInt 𝔪) : F) / (ν : F) := by
      simp only [ν, Subalgebra.coe_mul, Subalgebra.coe_neg, Subalgebra.coe_sub]
      field_simp
      ring
    rw [e1, e2, e3, C3I.sAddChar_add (C3I.hasWit_div_gen g 𝔰 h𝔰 _) (hasWit_div hext hsp hν0 _)]
    ring
  have := Fintype.ofFinite (SInt 𝔪 ⧸ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)))
  have := Fintype.ofFinite (SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)))
  have hin := fun d : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)) =>
    inner_sum g h𝔰 h𝔄 hD (h - g.gen 𝔄 * quotLift d)
  simp only [finsum_eq_sum_of_fintype] at hin
  have hg : ∀ y : SInt 𝔪, gaussSumAt g 𝔰 (-(y : F)) =
      ∑ᶠ d : SInt 𝔪 ⧸ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)),
        residueSymbol ι 𝔪 𝔰 (quotLift d) * sAddChar 𝔪 (-(y : F) * (quotLift d : F) / (g.gen 𝔰 : F)) :=
    fun y => rfl
  unfold dualCoeff poissonFactor
  simp only [hg]
  simp only [finsum_eq_sum_of_fintype, Finset.sum_mul]
  simp only [hpt]
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [← Finset.mul_sum]
  erw [hin d]
  split_ifs <;> ring

end

end ArtinPrimitiveRoots.L2B
end

section
/-!
# L2B_CutP: the classical Poisson cut implies the (𝔰, 𝔄) Poisson cut

Apply `L2B_PoissonCutP` with `𝔫 = 𝔰𝔄`, `ν = sA`, `c(x) = g_𝔰(−x) χ_𝔄(x)`, `T = q_𝔰 X`, and evaluate
the dual coefficients by (7.8).
-/

namespace ArtinPrimitiveRoots.L2B

open NumberField IsDedekindDomain UniqueFactorizationMonoid

variable {F : Type*} [Field F] [NumberField F]

theorem not_different_le {N₀ : ℕ} (hN : Ideal.absNorm (differentIdeal ℤ (𝓞 F)) ≤ N₀)
    {𝔪 : Ideal (𝓞 F)} (hsm : SmallPrimesDvd N₀ 𝔪) :
    ∀ P : Ideal (𝓞 F), P.IsPrime → IsExterior 𝔪 P → ¬ differentIdeal ℤ (𝓞 F) ≤ P := by
  intro P hP hPe hle
  have h𝔪 : ¬ 𝔪 ≤ P := by
    intro h
    apply hP.ne_top
    rw [eq_top_iff, ← hPe.2]
    exact sup_le le_rfl h
  have hdvd := Ideal.absNorm_dvd_absNorm_of_le hle
  have hD0 : Ideal.absNorm (differentIdeal ℤ (𝓞 F)) ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]; exact differentIdeal_ne_bot
  have := Nat.le_of_dvd (Nat.pos_of_ne_zero hD0) hdvd
  exact h𝔪 (hsm P hP hPe.1 (by omega))

theorem cut_of_cutP (n : ℕ) (hn0 : 0 < n) (hn : 12 ∣ n) [IsCyclotomicExtension {n} ℚ F]
    (ι : F →+* ℂ) (hP : L2B_PoissonCutP n hn0 hn F ι) : L2B_PoissonCut n hn0 hn F ι := by
  obtain ⟨N₁, hN₁⟩ := hP
  refine ⟨max N₁ (max (3 ^ Module.finrank ℤ (𝓞 F)) (Ideal.absNorm (differentIdeal ℤ (𝓞 F)))),
    fun 𝔪 h𝔪 hsm => ?_⟩
  have hsm₁ : SmallPrimesDvd N₁ 𝔪 := C3B.smallPrimesDvd_mono (le_max_left _ _) hsm
  have hD := not_different_le (le_trans (le_max_right _ _) (le_max_right _ _)) hsm
  have hgood : ∀ {𝔞 : Ideal (𝓞 F)}, IsExterior 𝔪 𝔞 → ∀ P ∈ normalizedFactors 𝔞, C3B.GoodP 𝔪 P :=
    fun h𝔞 P hP => by
      obtain ⟨hPi, hPe⟩ := C3M.exterior_of_mem_factors h𝔞 hP
      exact C3B.goodP_of_exterior n hn0 (Nat.dvd_trans (by norm_num) hn)
        (le_trans (le_max_left _ _) (le_max_right _ _)) hsm hPi hPe
  obtain ⟨V, M, hV, hM, hM6, hPm⟩ := hN₁ 𝔪 h𝔪 hsm₁
  refine ⟨V, M, hV, hM, hM6, fun g 𝔰 𝔄 h𝔰 h𝔄 X hX => ?_⟩
  have hext : IsExterior 𝔪 (𝔰 * 𝔄) := C3I.isExterior_mul h𝔰 h𝔄
  have hNs := qn_pos h𝔰
  have hNA := qn_pos h𝔄
  set c : SInt 𝔪 → ℂ := fun x => gaussSumAt g 𝔰 (-(x : F)) * residueSymbol ι 𝔪 𝔄 x with hc
  have hper : ∀ x y : SInt 𝔪, y ∈ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)) → c (x + y) = c x := by
    intro x y hy
    have hys : -y ∈ 𝔰.map (algebraMap (𝓞 F) (SInt 𝔪)) :=
      neg_mem (Ideal.map_mono (Ideal.mul_le_left (I := 𝔰) (J := 𝔄)) hy)
    have hyA : y ∈ 𝔄.map (algebraMap (𝓞 F) (SInt 𝔪)) := Ideal.map_mono (Ideal.mul_le_right (I := 𝔰) (J := 𝔄)) hy
    simp only [hc]
    rw [C3B.residueSymbol_congr ι 𝔄 (x + y) x (by simpa using hyA)]
    congr 1
    rw [show -((x + y : SInt 𝔪) : F) = -(x : F) + ((-y : SInt 𝔪) : F) by
      simp only [Subalgebra.coe_add, Subalgebra.coe_neg]; ring]
    exact C3B.gaussSumAt_add_mem g 𝔰 h𝔰 _ _ hys
  have hinv : ∀ (x : SInt 𝔪) (ε : (SInt 𝔪)ˣ), c ((ε : SInt 𝔪) ^ 6 * x) = c x := by
    intro x ε
    simp only [hc]
    rw [C3B.residueSymbol_unit_pow_six ι 𝔄 (hgood h𝔄) ε x]
    congr 1
    rw [show -(((ε : SInt 𝔪) ^ 6 * x : SInt 𝔪) : F) = ((ε : SInt 𝔪) : F) ^ 6 * (-(x : F)) by
      simp only [Subalgebra.coe_mul, Subalgebra.coe_pow]; ring]
    exact C3B.gaussSumAt_unit_pow_six g 𝔰 h𝔰 (hgood h𝔰) ε _ (neg_mem x.2)
  have hT : 0 < (Ideal.absNorm 𝔰 : ℝ) * X := by
    have : (0 : ℝ) < Ideal.absNorm 𝔰 := hNs
    positivity
  have key := hPm g (𝔰 * 𝔄) hext (g.gen 𝔰 * g.gen 𝔄) (span_gen_mul g h𝔰 h𝔄) c hper hinv _ hT
  convert key using 1
  have hf78 : ∀ h : SInt 𝔪,
      (∑ᶠ x : SInt 𝔪 ⧸ (𝔰 * 𝔄).map (algebraMap (𝓞 F) (SInt 𝔪)),
        c (quotLift x) * sAddChar 𝔪 ((h : F) * (quotLift x : F) /
          ((g.gen 𝔰 * g.gen 𝔄 : SInt 𝔪) : F))) =
        (Ideal.absNorm 𝔰 : ℂ) * poissonFactor g 𝔰 𝔄 h := fun h =>
    f78 g h𝔰 h𝔄 hD h
  simp only [hf78]
  have hNmul : (Ideal.absNorm (𝔰 * 𝔄) : ℝ) = Ideal.absNorm 𝔰 * Ideal.absNorm 𝔄 := by
    simp [map_mul]
  rw [hNmul]
  have harg : ∀ q : ℝ, (Ideal.absNorm 𝔰 : ℝ) * X * q / (Ideal.absNorm 𝔰 * Ideal.absNorm 𝔄) =
      X * q / Ideal.absNorm 𝔄 := by
    intro q
