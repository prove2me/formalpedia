    (hB : NLogN.KFB.GB B zs) {W : Fin HS} (hW0 : W ≠ 0) (s : IState HS) (R0 LW : List Item) (m : ℕ)
    (hv : carOut b zs < 2 ^ m) (h0 : s.G 0 = ints (gflat zs) ++ R0)
    (hW : s.G W = .int (2 ^ m) :: LW) :
    IRuns I iprog (carW b zs.length W) s
      { (s.upd 0 R0).upd W LW with out := s.out ++ bin m (carOut b zs) }
      (cCar b B zs.length + outRCost m) := by sorry
