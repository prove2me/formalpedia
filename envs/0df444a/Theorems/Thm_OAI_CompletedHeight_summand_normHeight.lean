theorem OAI.CompletedHeight.summand_normHeight (Ψ : ActualEisensteinCubic.O→*ℂ) (W : ℝ→ℂ) (t X : ℝ) (hX : 0<X)
    (I J : Ideal ActualEisensteinCubic.O) :
    summand (normHeightTwist Ψ t) W X I J =
      logPhase t (Real.log X)*summand Ψ (normTwistedSource W t) X I J := by sorry
