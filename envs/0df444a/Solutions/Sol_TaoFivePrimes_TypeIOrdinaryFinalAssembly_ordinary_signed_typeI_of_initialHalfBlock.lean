def OrdinaryNatTypeIBound : Prop :=
  ∀ (x alpha beta U V : ℝ) (a q : ℕ),
    4 ≤ q → Nat.Coprime a q →
    4 * alpha = (a : ℝ) / (q : ℝ) + beta →
    |beta| ≤ 1 / (q : ℝ) ^ 2 →
    40 ≤ U → 40 ≤ V → U < x → V < x →
    U * V ≤ x / 4 → x ≤ U * V ^ 2 →
    ‖eta0VaughanTypeISum x alpha U V‖ ≤
      0.5 * (x / (q : ℝ)) * Real.log x *
          Real.log (2 * U * V / (q : ℝ) + 4) +
        0.89 * (U * V + (5 / 2 : ℝ) * (q : ℝ)) *
          (8 + Real.log (q : ℝ)) * Real.log (2 * x)
theorem ordinary_signed_of_nat
    (hNat : OrdinaryNatTypeIBound)
    (x alpha beta U V : ℝ) (a : ℤ) (q : ℕ)
