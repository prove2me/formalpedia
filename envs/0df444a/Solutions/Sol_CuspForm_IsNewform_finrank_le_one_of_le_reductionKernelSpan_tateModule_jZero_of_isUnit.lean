private scoped instance (priority := high) instAddMonoidT : AddMonoid (ModularCurve.TateModule lam (JZero M)) :=
  (ModularCurve.TateModule lam (JZero M)).addCommMonoid.toAddMonoid

private scoped instance (priority := high) instAddZeroClassT : AddZeroClass (ModularCurve.TateModule lam (JZero M)) :=
  (ModularCurve.TateModule lam (JZero M)).addCommMonoid.toAddMonoid.toAddZeroClass

variable [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
variable (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
