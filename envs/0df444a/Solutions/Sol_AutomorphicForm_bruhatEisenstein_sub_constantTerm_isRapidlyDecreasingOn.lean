private theorem norm_iteratedFDeriv_coeff_comp_le {c : ℝ → ℂ} (hc : ContDiff ℝ ∞ c) {n : ℕ} {Cc : ℝ}
    (hCc : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc) {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f) {D : ℝ}
    (hD1 : 1 ≤ D) (hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i) {k : ℕ} (hk : k ≤ n) :
    ‖iteratedFDeriv ℝ k (fun t => c (f t)) 0‖ ≤ n ! * Cc * D ^ n := by
  have hcomp : (fun t => c (f t)) = c ∘ f := rfl
  have hC : ∀ j, j ≤ k → ‖iteratedFDeriv ℝ j c (f 0)‖ ≤ Cc := fun j hj => by
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    exact hCc j (hj.trans hk) (f 0)
  have hD' : ∀ i, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i :=
    fun i hi1 hik => hD i hi1 (hik.trans hk)
  have hCc0 : 0 ≤ Cc := (norm_nonneg _).trans (hCc 0 (Nat.zero_le _) 0)
  have hD0 : 0 ≤ D := zero_le_one.trans hD1
  rw [hcomp]
  refine (norm_iteratedFDeriv_comp_le hc hf (by exact_mod_cast le_top) 0 hC hD').trans ?_
  have hfac : (k ! : ℝ) ≤ n ! := by exact_mod_cast Nat.factorial_le hk
  exact mul_le_mul (mul_le_mul_of_nonneg_right hfac hCc0) (pow_le_pow_right₀ hD1 hk) (pow_nonneg hD0 k)
    (mul_nonneg (Nat.cast_nonneg _) hCc0)

private theorem towersPow_of_factorial_bound {f : ℝ → ℝ} {n : ℕ} {Arc H : ℝ} (hArc : 0 ≤ Arc) (hH : 1 ≤ H)
    (h : ∀ k ≤ n, ‖iteratedFDeriv ℝ k f 0‖ ≤ k ! * Arc * H ^ k) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ (n ! * max 1 Arc * H) ^ i := by
  intro i hi1 hin
  refine (h i hin).trans ?_
  rw [mul_pow, mul_pow]
  have hH0 : 0 ≤ H := zero_le_one.trans hH
  have h1 : (i ! : ℝ) ≤ (n ! : ℝ) ^ i :=
    (by exact_mod_cast Nat.factorial_le hin : (i ! : ℝ) ≤ n !).trans
      (le_self_pow₀ (Nat.one_le_cast.2 (Nat.factorial_pos n)) (by omega : i ≠ 0))
  have h2 : Arc ≤ max 1 Arc ^ i :=
    (le_max_right 1 Arc).trans (le_self_pow₀ (le_max_left 1 Arc) (by omega : i ≠ 0))
  exact mul_le_mul_of_nonneg_right (mul_le_mul h1 h2 hArc (pow_nonneg (Nat.cast_nonneg _) i)) (pow_nonneg hH0 i)

private theorem towersPow_of_uniform_bound {f : ℝ → ℝ} {n : ℕ} {M D : ℝ} (hMD : M ≤ D) (hD1 : 1 ≤ D)
    (h : ∀ k, 1 ≤ k → k ≤ n → ‖iteratedFDeriv ℝ k f 0‖ ≤ M) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i :=
  fun i hi1 hin => (h i hi1 hin).trans (hMD.trans (le_self_pow₀ hD1 (by omega : i ≠ 0)))

private theorem towersPow_of_export {f : ℝ → ℝ} {ρ₀ ρ : ℝ} (h0 : 0 ≤ ρ₀) (hρ : ρ₀ ≤ ρ)
    (h : ∀ k : ℕ, |iteratedDeriv (k + 1) f 0| ≤ k ! * ρ₀ ^ (k + 1)) (n : ℕ) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ (n ! * max 1 ρ) ^ i := by
  intro i hi1 hin
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]
  refine (h k).trans ?_
  have hfac : (k ! : ℝ) ≤ (n ! : ℝ) ^ (k + 1) :=
    (by exact_mod_cast Nat.factorial_le (by omega : k ≤ n) : (k ! : ℝ) ≤ n !).trans
      (le_self_pow₀ (Nat.one_le_cast.2 (Nat.factorial_pos n)) (by omega : k + 1 ≠ 0))
  have hpow : ρ₀ ^ (k + 1) ≤ max 1 ρ ^ (k + 1) := pow_le_pow_left₀ h0 (hρ.trans (le_max_right 1 ρ)) _
  calc (k ! : ℝ) * ρ₀ ^ (k + 1) ≤ (n ! : ℝ) ^ (k + 1) * max 1 ρ ^ (k + 1) :=
        mul_le_mul hfac hpow (pow_nonneg h0 _) (pow_nonneg (Nat.cast_nonneg _) _)
    _ = (n ! * max 1 ρ) ^ (k + 1) := (mul_pow _ _ _).symm

private theorem towersPow_mono {f : ℝ → ℝ} {n : ℕ} {B D : ℝ} (hB : 0 ≤ B) (hBD : B ≤ D)
    (h : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ B ^ i) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i :=
  fun i hi1 hin => (h i hi1 hin).trans (pow_le_pow_left₀ hB hBD i)

private theorem towersPow_half {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f) {n : ℕ} {D : ℝ}
    (h : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i (fun t => f t / 2) 0‖ ≤ D ^ i := by
  intro i hi1 hin
  have hfun : (fun t => f t / 2) = fun t => (2 : ℝ)⁻¹ * f t := by
    funext t
    rw [div_eq_inv_mul]
  rw [hfun, norm_iteratedFDeriv_eq_norm_iteratedDeriv,
    iteratedDeriv_const_mul _ ((hf.of_le (by exact_mod_cast le_top)).contDiffAt), norm_mul,
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hi := h i hi1 hin
  have h2 : ‖(2 : ℝ)⁻¹‖ ≤ 1 := by
    rw [Real.norm_eq_abs, abs_of_pos (by norm_num : (0 : ℝ) < 2⁻¹)]
    norm_num
  calc ‖(2 : ℝ)⁻¹‖ * ‖iteratedFDeriv ℝ i f 0‖ ≤ 1 * D ^ i := mul_le_mul h2 hi (norm_nonneg _) zero_le_one
    _ = D ^ i := one_mul _

private theorem towersPow_add_const {f : ℝ → ℝ} (s : ℝ) {n : ℕ} {D : ℝ}
    (h : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i f 0‖ ≤ D ^ i) :
    ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i (fun t => f t + s) 0‖ ≤ D ^ i := by
  intro i hi1 hin
  have hfun : (fun t => f t + s) = fun t => s + f t := by
    funext t
    rw [add_comm]
  rw [hfun, norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_const_add (by omega : 0 < i) s,
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  exact h i hi1 hin

private theorem norm_iteratedFDeriv_coeffWord_le {a b c d e : ℝ → ℂ} (ha : ContDiff ℝ ∞ a) (hb : ContDiff ℝ ∞ b)
    (hc : ContDiff ℝ ∞ c) (hd : ContDiff ℝ ∞ d) (he : ContDiff ℝ ∞ e) {n : ℕ} {Cc : ℝ}
    (hCa : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j a θ‖ ≤ Cc) (hCb : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j b θ‖ ≤ Cc)
    (hCc : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc) (hCd : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j d θ‖ ≤ Cc)
    (hCe : ∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j e θ‖ ≤ Cc)
    {μf ψf δf : ℝ → ℝ} (hμ : ContDiff ℝ ∞ μf) (hψ : ContDiff ℝ ∞ ψf) (hδ : ContDiff ℝ ∞ δf) {D : ℝ} (hD1 : 1 ≤ D)
    (hμD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i μf 0‖ ≤ D ^ i)
    (hψD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i ψf 0‖ ≤ D ^ i)
    (hδD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i δf 0‖ ≤ D ^ i) {k : ℕ} (hk : k ≤ n) :
    ‖iteratedFDeriv ℝ k (fun t => a (μf t / 2) * b (ψf t / 2) * c (δf t) * d (ψf t / 2 + Real.pi / 2)
        * e (μf t / 2)) 0‖
      ≤ 2 ^ (4 * n) * (n ! * Cc * D ^ n) ^ 5 := by
  have hμ2 : ContDiff ℝ ∞ fun t => μf t / 2 := hμ.div_const 2
  have hψ2 : ContDiff ℝ ∞ fun t => ψf t / 2 := hψ.div_const 2
  have hψ2' : ContDiff ℝ ∞ fun t => ψf t / 2 + Real.pi / 2 := hψ2.add contDiff_const
  have hμ2D := towersPow_half hμ hμD
  have hψ2D := towersPow_half hψ hψD
  have hψ2D' := towersPow_add_const (f := fun t => ψf t / 2) (Real.pi / 2) hψ2D

  have hA : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => a (μf t / 2)) 0‖ ≤ n ! * Cc * D ^ n :=
    fun i hi => norm_iteratedFDeriv_coeff_comp_le ha hCa hμ2 hD1 hμ2D hi
  have hB : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => b (ψf t / 2)) 0‖ ≤ n ! * Cc * D ^ n :=
    fun i hi => norm_iteratedFDeriv_coeff_comp_le hb hCb hψ2 hD1 hψ2D hi
  have hC : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => c (δf t)) 0‖ ≤ n ! * Cc * D ^ n :=
    fun i hi => norm_iteratedFDeriv_coeff_comp_le hc hCc hδ hD1 hδD hi
  have hD' : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => d (ψf t / 2 + Real.pi / 2)) 0‖ ≤ n ! * Cc * D ^ n :=
    fun i hi => norm_iteratedFDeriv_coeff_comp_le hd hCd hψ2' hD1 hψ2D' hi
  have hE : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => e (μf t / 2)) 0‖ ≤ n ! * Cc * D ^ n :=
    fun i hi => norm_iteratedFDeriv_coeff_comp_le he hCe hμ2 hD1 hμ2D hi

  have cA : ContDiff ℝ ∞ fun t => a (μf t / 2) := ha.comp hμ2
  have cB : ContDiff ℝ ∞ fun t => b (ψf t / 2) := hb.comp hψ2
  have cC : ContDiff ℝ ∞ fun t => c (δf t) := hc.comp hδ
  have cD : ContDiff ℝ ∞ fun t => d (ψf t / 2 + Real.pi / 2) := hd.comp hψ2'
  have cE : ContDiff ℝ ∞ fun t => e (μf t / 2) := he.comp hμ2
  have cAB : ContDiff ℝ ∞ fun t => a (μf t / 2) * b (ψf t / 2) := cA.mul cB
  have cABC : ContDiff ℝ ∞ fun t => a (μf t / 2) * b (ψf t / 2) * c (δf t) := cAB.mul cC
  have cABCD : ContDiff ℝ ∞ fun t =>
      a (μf t / 2) * b (ψf t / 2) * c (δf t) * d (ψf t / 2 + Real.pi / 2) := cABC.mul cD

  set K : ℝ := n ! * Cc * D ^ n
  have hAB : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => a (μf t / 2) * b (ψf t / 2)) 0‖ ≤ 2 ^ n * (K * K) :=
    fun i hi => norm_iteratedFDeriv_mul_zero_le cA cB hA hB hi
  have hABC : ∀ i ≤ n, ‖iteratedFDeriv ℝ i (fun t => a (μf t / 2) * b (ψf t / 2) * c (δf t)) 0‖
      ≤ 2 ^ n * (2 ^ n * (K * K) * K) :=
    fun i hi => norm_iteratedFDeriv_mul_zero_le cAB cC hAB hC hi
  have hABCD : ∀ i ≤ n, ‖iteratedFDeriv ℝ i
      (fun t => a (μf t / 2) * b (ψf t / 2) * c (δf t) * d (ψf t / 2 + Real.pi / 2)) 0‖
      ≤ 2 ^ n * (2 ^ n * (2 ^ n * (K * K) * K) * K) :=
    fun i hi => norm_iteratedFDeriv_mul_zero_le cABC cD hABC hD' hi
  have hall := norm_iteratedFDeriv_mul_zero_le cABCD cE hABCD hE hk
  refine hall.trans (le_of_eq ?_)
  rw [show 4 * n = n + n + n + n by ring, pow_add, pow_add, pow_add]
  ring

end TowersAtZero
