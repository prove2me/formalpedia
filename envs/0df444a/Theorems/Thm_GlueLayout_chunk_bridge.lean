open GlueLayout
open Finset Butterfly AModel Synth
variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {A K D B ρ : ℕ}

theorem GlueLayout.chunk_bridge (hρ : ρ < K) {n : ℕ} (hn : n = A + D * K + B) {ι : Type*} [Fintype ι]
    [DecidableEq ι] (P : PosData n ι) (e : ι ≃ Fin D)
    (hpos : ∀ i : Fin D, P.pos (e.symm i) = A + i * K + (K - 1 - ρ)) (M : M2)
    {X : Type*} [AddCommMonoid X] [Module ℂ X] (xs : List X) :
    selOp (posSel P) (tens M) xs = selOp (layerSel (2 ^ A) K D (2 ^ B) ρ hρ) (tens M) xs := by sorry
