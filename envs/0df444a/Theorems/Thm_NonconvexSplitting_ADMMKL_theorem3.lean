-- title:
--   Theorem 3 — the ADMM sequence converges and has finite length for semi-algebraic problems
-- statement:
--   Let $h:\mathbb R^n\to\mathbb R$ be twice continuously differentiable with bounded Hessian, $P:\mathbb R^m\to(-\infty,+\infty]$ proper and closed, $\mathcal M:\mathbb R^n\to\mathbb R^m$ linear and $\beta>0$, with augmented Lagrangian $L_\beta(x,y,z)=h(x)+P(y)-\langle z,\mathcal Mx-y\rangle+\frac\beta2\|\mathcal Mx-y\|^2$. Suppose Assumption 1 holds with $\mathcal T_1=0$ (hence $\phi=0$), with witnesses $\sigma,\mathcal Q_1,\mathcal Q_2,\delta,\mathcal Q_3,\gamma$, and let $(x^t,y^t,z^t)_{t\ge0}$ be generated by the ADMM
--   $$
--   y^{t+1}\in\operatorname*{Arg\,min}_y L_\beta(x^t,y,z^t),\qquad x^{t+1}\in\operatorname*{Arg\,min}_x L_\beta(x,y^{t+1},z^t),\qquad z^{t+1}=z^t-\beta(\mathcal Mx^{t+1}-y^{t+1}).
--   $$
--
--   Suppose moreover that $h$ and $P$ are semi-algebraic functions and that $(x^t,y^t,z^t)$ has a cluster point $(x^*,y^*,z^*)$. Then the whole sequence converges, $(x^t,y^t,z^t)\to(x^*,y^*,z^*)$, the point $x^*$ is a stationary point of $\min_x h(x)+P(\mathcal Mx)$, i.e. $0\in\nabla h(x^*)+\mathcal M^*\partial P(\mathcal Mx^*)$, and
--   $$
--   \sum_{t=1}^{\infty}\|x^{t+1}-x^t\|<\infty. \tag{34}
--   $$
--
--   Unlike the subsequential result for the proximal ADMM, this gives convergence of the entire sequence, without convexity of $h$ or $P$ and without boundedness assumptions beyond the existence of a cluster point.
--
--   **Formalization Note** The ADMM is the relation `IsProxADMMSeq` with $\phi = 0$ (the Bregman term vanishes); Assumption 1 is instantiated with $\phi = 0$ and $\mathcal T_1 = 0$, and $\mathcal T_2$ is left as a parameter (Assumption 1 forces $0 \preceq \mathcal T_2 \preceq \mathcal T_1 = 0$). Values of $L_\beta$ and $P$ live in `EReal`; iterates are indexed from $0$, and $y^0$ is not constrained. Semi-algebraicity of $h$ is that of $u\mapsto h(u)$ coerced to `EReal`; that of $P$ uses the graph over its real values. Finite length is `Summable (fun t => ‖x (t+1) - x t‖)`, which does not depend on finitely many terms.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 13, Theorem 3, Eq. (34)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_Assumption1
import Definitions.Def_NonconvexSplitting_Shared_IsProxADMMSeq
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_IsStationary
import Definitions.Def_NonconvexSplitting_ADMMKL_Semialgebraic
open NonconvexSplitting.Shared

open Filter Topology
open scoped InnerProductSpace

namespace NonconvexSplitting.ADMMKL

/-- Theorem 3 of Li–Pong (p. 13): suppose Assumption 1 holds with `T₁ = 0` (hence `φ = 0`) and
that `h` and `P` are semi-algebraic. If the ADMM sequence `(x^t, y^t, z^t)` has a cluster point
`(x*, y*, z*)`, then the whole sequence converges to `(x*, y*, z*)`, `x*` is a stationary point of
`min_x h(x) + P(M x)`, and `∑_t ‖x^{t+1} - x^t‖ < ∞` (34). -/
theorem theorem3 {n m : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ) (P : EuclideanSpace ℝ (Fin m) → EReal)
    (M : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)) (β : ℝ)
    (hstd : StandingAssumptions h P (fun _ => 0) β)
    (σ δ γ : ℝ) (Q1 Q2 T2 Q3 : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (hA : Assumption1 h (fun _ => 0) M β σ Q1 Q2 0 T2 δ Q3 γ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y z : ℕ → EuclideanSpace ℝ (Fin m))
    (hseq : IsProxADMMSeq h P (fun _ => 0) M β x y z)
    (hh : IsSemialgebraicFn (fun u : EuclideanSpace ℝ (Fin n) => ((h u : ℝ) : EReal)))
    (hP : IsSemialgebraicFn P)
    (xs : EuclideanSpace ℝ (Fin n)) (ys zs : EuclideanSpace ℝ (Fin m))
    (hclu : ∃ s : ℕ → ℕ, StrictMono s ∧
      Tendsto (fun i => (x (s i), y (s i), z (s i))) atTop (𝓝 (xs, ys, zs))) :
    Tendsto x atTop (𝓝 xs) ∧ Tendsto y atTop (𝓝 ys) ∧ Tendsto z atTop (𝓝 zs) ∧
      IsStationary h P M xs ∧ Summable (fun t => ‖x (t + 1) - x t‖) := by sorry

end NonconvexSplitting.ADMMKL
