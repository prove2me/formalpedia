    have hψntriv : ¬ ∀ k : ↥K, φ ψ k = k := by
      intro hψtriv
      apply hg₀ne
      have hRKbot : (⁅R, K⁆ : Subgroup G) = ⊥ := by
        rw [eq_bot_iff]
        refine (Subgroup.commutator_le (H₁ := R) (H₂ := K) (H₃ := ⊥)).mpr (fun r hrR k hkK => ?_)
        rw [Subgroup.mem_bot]
        have hψc : (ψ : G) * k * (ψ : G)⁻¹ = k := by
          have hk := congrArg Subtype.val (hψtriv ⟨k, hkK⟩)
          rwa [hφval ψ ⟨k, hkK⟩] at hk
        have hψcomm : Commute (ψ : G) k := mul_inv_eq_iff_eq_mul.mp hψc
        have hrz : (r : G) ∈ Subgroup.zpowers (ψ : G) := by rw [hψgenR]; exact hrR
        rw [Subgroup.mem_zpowers_iff] at hrz
        obtain ⟨j, hj⟩ := hrz
        rw [← hj]
        exact commutatorElement_eq_one_iff_commute.mpr (hψcomm.zpow_left j)
      rw [show g₀ = 1 by rw [hRKbot, Subgroup.mem_bot] at hg₀mem; exact hg₀mem, map_one]
    -- **Gorenstein 5.3.7** applied to `(φ, ψ)`.  Needs `ψ` trivial on proper normal
    -- `A`-inv subgroups.
    have hψ_proper : ∀ N : Subgroup ↥K, N.Normal → IsAInvariant φ N → N ≠ ⊤ →
        ∀ n ∈ N, φ ψ n = n := by
