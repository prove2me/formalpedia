-- Source module: Solutions.R6SSetup
/-!
# Round-six setup, part 8: the whole register program

`setRS a c x` = parameters, sources, descriptors, register file. **`sp_setup`**: from the managed
state with `n` on `23` and `b` on `24` it reaches a managed state whose stacks carry the values
the round-six `BaseOK6` asks for, at cost `cSet · kU Bb`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

noncomputable section

/-- The whole register program. -/
def setRS (a c X : ℕ) : RS :=
  .seq (parP a c X) (.seq jR (.seq (mvK 38 26 51 (.reg 25)) (.seq cpR (.seq btR (.seq hdrP regP)))))

/-- The atom bound. -/
def AaS (P : Prm) (n : ℕ) : ℕ := 2 ^ (pP6 P n + 2 * bP6 n + 8)

/-- The degree allowance. -/
def DgS (P : Prm) (a c : ℕ) : ℕ := a + c + P.x + 10

/-- The bit bound. -/
def BbS (P : Prm) (n a c : ℕ) : ℕ := DgS P a c * (pP6 P n + 2 * bP6 n + 8) + 1

/-- The cost of `setRS` in units `kU`. -/
def cSet (P : Prm) (n a c : ℕ) : ℕ :=
  cPar a c P.x (bP6 n) (b'P6 P n) + dP6 P n * (cJ (2 ^ ℓP6 P n) + 41) + 100

/-- The initial managed stacks. -/
def f0S (n b : ℕ) : Fin HS → List ℤ := update (update (fun _ => []) 23 [(n : ℤ)]) 24 [(b : ℤ)]

/-- What the program leaves. -/
structure SetOK (P : Prm) (n : ℕ) (g : Fin HS → List ℤ) : Prop where
  hS : ∃ L, g 6 = (S6 P n (src6 P n) : ℤ) :: L
  hT : ∃ L, g 7 = (2 : ℤ) ^ LP6 P n :: L
  hT2 : ∃ L, g 8 = (2 : ℤ) ^ (LP6 P n + 1) :: L
  hM : ∃ L, g 9 = (M6 P n : ℤ) :: L
  hP2 : ∃ L, g 10 = (2 : ℤ) ^ pP6 P n :: L
  hG : ∃ L, g 11 = (2 : ℤ) ^ (2 * dP6 P n * αN6 P n ^ 2) :: L
  hE2 : ∃ L, g 12 = (2 : ℤ) ^ (pP6 P n - b'P6 P n - 2) :: L
  hB2 : ∃ L, g 13 = (2 : ℤ) ^ b'P6 P n :: L
  hZ : ∃ L, g 14 = 2 * ((S6 P n (src6 P n) : ℤ) - (M6 P n : ℤ)) :: L
  hH : ∃ L, g 15 = (2 : ℤ) ^ (pP6 P n - 1) :: L
  hF : ∃ L, g 16 = (2 : ℤ) ^ (2 * b'P6 P n + 4) :: L
  hPw : ∃ L, g 18 = ((pP6 P n : ℤ) + 2) :: L
  hOne : ∃ L, g 19 = 1 :: L
  hD : ∃ L, g 25 = (dP6 P n : ℤ) :: L
  hPh : ∃ L, g 26 = descPhi6 P n (src6 P n) ++ L
  hCh : ∃ L, g 27 = descChirp6 P n (src6 P n) ++ L
  hLn : ∃ L, g 28 = descLine6 P n (src6 P n) ++ L
  h0 : g 0 = []
  h17 : g 17 = []
  h20 : g 20 = []
  h43 : g 43 = []
  h55 : g 55 = []

/-- The final register file of a run (to name intermediate states). -/
def postF {a : RS} {s : IState HS} {f g : Fin HS → List ℤ} {c : ℕ}
    (_ : Sp a (encK s f) (encK s g) c) : Fin HS → List ℤ := g

end

end IntMul.Kappa.R6

end

