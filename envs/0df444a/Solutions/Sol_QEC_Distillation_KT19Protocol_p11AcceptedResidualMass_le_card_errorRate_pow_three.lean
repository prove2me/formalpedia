theorem _root_.solution
    (mu : ZMod 11 → ℝ) (hmu_nonneg : ∀ a : ZMod 11, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod 11, mu a = 1) :
    p11AcceptedResidualMass mu ≤
      (Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
        kt19ErrorRate mu ^ 3 := by
  unfold p11AcceptedResidualMass
  calc
    (∑ error : Word (ZMod 11) (KeptPunctureLocation 11 2),
      if kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0 then
        wordProbability 11 mu error
      else 0) ≤
        ∑ _error : Word (ZMod 11) (KeptPunctureLocation 11 2),
          kt19ErrorRate mu ^ 3 := by
      apply Finset.sum_le_sum
      intro error _
      by_cases hresidual : kt19AcceptedWord p11CubicRowFamily error ∧ error ≠ 0
      · rw [if_pos hresidual]
        exact p11AcceptedWordProbability_le_errorRate_pow_three
          mu hmu_nonneg hmu_sum error hresidual.1 hresidual.2
      · simp [hresidual, pow_nonneg (kt19ErrorRate_nonneg mu hmu_nonneg hmu_sum)]
    _ = (Fintype.card (Word (ZMod 11) (KeptPunctureLocation 11 2)) : ℝ) *
        kt19ErrorRate mu ^ 3 := by
      simp
