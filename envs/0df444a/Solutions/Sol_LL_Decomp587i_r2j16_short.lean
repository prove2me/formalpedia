      · rintro (⟨⟨h0, h01, h12, h23, h3⟩, hcut⟩ | ⟨⟨h3a, h3b⟩, ⟨h2a, h2b⟩, ⟨h1a, h1b⟩, ⟨h0a, h0b⟩⟩)
        · exact ⟨⟨by linarith, h3⟩, ⟨by linarith, h23⟩, ⟨by linarith, h12⟩, ⟨by linarith, h01⟩⟩
        · have ha_val : a0 = 100 / 287 := rfl
          have hb_val : b0 = 5 / 12 := rfl
          refine ⟨⟨by linarith, h3b⟩, ⟨by linarith, h2b⟩, ⟨by linarith, h1b⟩, ⟨h0a, by linarith⟩⟩
    have hintT : IntegrableOn (fun x : R4 => (1 / rProd) * tanNum φ x) (T_cone φ) volume :=
      (hL_cont.continuousOn.integrableOn_compact
        (isCompact_Icc.prod (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)))).mono_set (T_cone_sub_K4 hlo)
    have hunion_int : ∫ x in T_cone φ, (1 / rProd) * tanNum φ x =
        (∫ x in Cap_open φ, (1 / rProd) * tanNum φ x) + (∫ x in R_cone φ, (1 / rProd) * tanNum φ x) := by
      rw [hT_union] at hintT ⊢
      exact setIntegral_union hdisj (measurableSet_R_cone φ)
        (hintT.mono_set subset_union_left) (hintT.mono_set subset_union_right)
