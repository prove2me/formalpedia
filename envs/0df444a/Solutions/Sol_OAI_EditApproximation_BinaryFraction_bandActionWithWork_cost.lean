namespace OAI

/-! Literal Boolean construction of the child envelope of a finite band.
It scans the actual child values, compares with `b/M`, and runs the exact
bounded dyadic scan. Table reads are accounted for by the query program. -/

namespace EditApproximation
namespace BinaryFraction



theorem maxWithWork_width (a b : BinaryFraction) :
    (maxWithWork a b).1.width ≤ max a.width b.width := by
  unfold maxWithWork
  dsimp only
  split_ifs
  · exact le_max_right _ _
  · exact le_max_left _ _

theorem maxWithWork_cost (a b : BinaryFraction) (B : ℕ) (ha : a.width ≤ B) (hb : b.width ≤ B) :
    (maxWithWork a b).2 ≤ 1000 * (B + 1) ^ 2 + 1 :=
  Nat.add_le_add_right (ltWithWork_cost a b B ha hb) 1



theorem maximumWithWork_width (fallback : BinaryFraction) (values : List BinaryFraction)
    (B : ℕ) (hf : fallback.width ≤ B) (hvalues : ∀ a ∈ values, a.width ≤ B) :
    (maximumWithWork fallback values).1.width ≤ B := by
  induction values with
  | nil => exact hf
  | cons head rest ih =>
    exact (maxWithWork_width head (maximumWithWork fallback rest).1).trans
      (max_le (hvalues head List.mem_cons_self) (ih (fun a ha => hvalues a (List.mem_cons_of_mem _ ha))))

theorem maximumWithWork_cost (fallback : BinaryFraction) (values : List BinaryFraction)
    (B : ℕ) (hf : fallback.width ≤ B) (hvalues : ∀ a ∈ values, a.width ≤ B) :
    (maximumWithWork fallback values).2 ≤ 1 + values.length * (1000 * (B + 1) ^ 2 + 2) := by
  induction values with
  | nil => simp [maximumWithWork]
  | cons head rest ih =>
    have htail := ih (fun a ha => hvalues a (List.mem_cons_of_mem _ ha))
    have hw := maximumWithWork_width fallback rest B hf (fun a ha => hvalues a (List.mem_cons_of_mem _ ha))
    have hc := maxWithWork_cost head (maximumWithWork fallback rest).1 B
      (hvalues head List.mem_cons_self) hw
    change (maximumWithWork fallback rest).2 + (maxWithWork head (maximumWithWork fallback rest).1).2 + 1 ≤ _
    simp only [List.length_cons]
    rw [Nat.add_mul, Nat.one_mul]
    omega

theorem bandEnvelopeWithWork_width {M ny : ℕ} (b : ℕ)
    (band : List (Fin M → TargetInterval ny))
    (initial : Fin M → TargetInterval ny → BinaryFraction) (i : Fin M)
    (B : ℕ) (hbits : ∀ action ∈ band, (initial i (action i)).width ≤ B) :
    (bandEnvelopeWithWork b band initial i).1.width ≤ 3 * bandEnvelopeWordBudget b M B + 1 := by
  let W := bandEnvelopeWordBudget b M B
  have hfloor := divWithWork_self_width (nat b) (nat M)
  rw [divWithWork_representation, nat_representation, nat_representation] at hfloor
  have hf := UnreducedRational.storageBits_div (UnreducedRational.nat b) (UnreducedRational.nat M)
  simp only [UnreducedRational.storageBits_nat] at hf
  have hfW : (divWithWork (nat b) (nat M)).1.width ≤ W := by
    dsimp only [W, bandEnvelopeWordBudget]
    omega
  have hmW := maximumWithWork_width zero (band.map fun action => initial i (action i)) W
    (by change 1 ≤ W; dsimp only [W, bandEnvelopeWordBudget]; omega)
    (by intro a ha; obtain ⟨action, haction, rfl⟩ := List.mem_map.mp ha
        exact (hbits action haction).trans (by dsimp only [W, bandEnvelopeWordBudget]; omega))
  have hin := (maxWithWork_width (divWithWork (nat b) (nat M)).1
    (maximumWithWork zero (band.map fun action => initial i (action i))).1).trans (max_le hfW hmW)
  have h := dyadicCeilingWithWork_width (maxWithWork (divWithWork (nat b) (nat M)).1
    (maximumWithWork zero (band.map fun action => initial i (action i))).1).1
  change (dyadicCeilingWithWork _).1.width ≤ _
  omega


theorem bandEnvelopeWithWork_cost {M ny : ℕ} (b : ℕ)
    (band : List (Fin M → TargetInterval ny))
    (initial : Fin M → TargetInterval ny → BinaryFraction) (i : Fin M)
    (B : ℕ) (hbits : ∀ action ∈ band, (initial i (action i)).width ≤ B) :
    (bandEnvelopeWithWork b band initial i).2 ≤ bandEnvelopeBitBudget b M band.length B := by
  let W := bandEnvelopeWordBudget b M B
  let floor := (divWithWork (nat b) (nat M)).1
  let maximum := (maximumWithWork zero (band.map fun action => initial i (action i))).1
  let input := (maxWithWork floor maximum).1
  have hfloor := divWithWork_self_width (nat b) (nat M)
  rw [divWithWork_representation, nat_representation, nat_representation] at hfloor
  have hf := UnreducedRational.storageBits_div (UnreducedRational.nat b) (UnreducedRational.nat M)
  simp only [UnreducedRational.storageBits_nat] at hf
  have hfW : floor.width ≤ W := by
    dsimp only [W, bandEnvelopeWordBudget]
    change floor.width ≤ _ at hfloor
    omega
  have hmW : maximum.width ≤ W := maximumWithWork_width zero
    (band.map fun action => initial i (action i)) W
    (by change 1 ≤ W; dsimp only [W, bandEnvelopeWordBudget]; omega)
    (by intro a ha; obtain ⟨action, haction, rfl⟩ := List.mem_map.mp ha
        exact (hbits action haction).trans (by dsimp only [W, bandEnvelopeWordBudget]; omega))
  have hiW : input.width ≤ W := (maxWithWork_width floor maximum).trans (max_le hfW hmW)
  have hfc := divWithWork_cost (nat b) (nat M) (Nat.size b + Nat.size M + 4)
    ((nat_width_le b).trans (by omega)) ((nat_width_le M).trans (by omega))
  rw [show Nat.size b + Nat.size M + 4 + 2 = Nat.size b + Nat.size M + 6 by omega] at hfc
  have hmc := maximumWithWork_cost zero (band.map fun action => initial i (action i)) W
    (by change 1 ≤ W; dsimp only [W, bandEnvelopeWordBudget]; omega)
    (by intro a ha; obtain ⟨action, haction, rfl⟩ := List.mem_map.mp ha
        exact (hbits action haction).trans (by dsimp only [W, bandEnvelopeWordBudget]; omega))
  simp only [List.length_map] at hmc
  have hic := maxWithWork_cost floor maximum W hfW hmW
  have hdc := dyadicCeilingWithWork_cost_le input W hiW
  change (divWithWork (nat b) (nat M)).2 +
    (maximumWithWork zero (band.map fun action => initial i (action i))).2 +
    (maxWithWork floor maximum).2 + (dyadicCeilingWithWork input).2 + band.length + 4 ≤ _
  change _ ≤ 2100 * (Nat.size b + Nat.size M + 6) ^ 2 +
    (1 + band.length * (1000 * (W + 1) ^ 2 + 2)) + (1000 * (W + 1) ^ 2 + 1) +
    (1 + 2 * W * (1000 * (3 * W + 2) ^ 2 + 2) + 3 * W + 5) + band.length + 4
  omega

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryActualBandOptimizer
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! The complete Boolean band optimizer constructs its envelopes from the
stored initial table, then constructs the vertices and history vector. The
normalized history bounds follow from actual band-coordinate membership. -/

namespace EditApproximation
namespace BinaryFraction

open Finset

theorem listedBandCoordinateVector_coverage {M : ℕ} {σ : Type*} [DecidableEq σ]
    (band : List (Fin M → σ)) (i : Fin (listedBandCoordinates band).length) :
    ∃ action ∈ band, action ((listedBandCoordinateVector band).get i).1 =
      ((listedBandCoordinateVector band).get i).2 := by
  have hc : (listedBandCoordinateVector band).get i ∈ listedBandCoordinates band := by
    simp only [listedBandCoordinateVector, vector_get_ofFn]
    exact List.get_mem _ _
  obtain ⟨action, ha, hc⟩ := List.mem_flatMap.mp (List.mem_dedup.mp hc)
  obtain ⟨child, hchild⟩ := List.mem_ofFn.mp hc
  refine ⟨action, ha, ?_⟩
  rw [← hchild]

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryBandAction
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Materialized Boolean vertices retain their band labels. The resulting
selected action, including every tie, is the action used by the online
sampler in the accuracy development. -/

namespace EditApproximation
namespace BinaryFraction

theorem bandActionWithWork_cost_oai {M ny : ℕ} (b : ℕ)
    (initial : Fin M → TargetInterval ny → BinaryFraction)
    (table : ℕ → Fin M × TargetInterval ny → BinaryFraction)
    (eta kappa : BinaryFraction) (band : List (Fin M → TargetInterval ny))
    (G K t Be Bk Bi Bt E : ℕ) (hband : band ≠ []) (hb : 0 < b) (hM : 0 < M)
    (he : eta.width ≤ Be) (hk : kappa.width ≤ Bk)
    (hi : ∀ action ∈ band, ∀ j, (initial j (action j)).width ≤ Bi)
    (ht : ∀ s ≤ t + 1, ∀ i : Fin (listedBandCoordinates band).length,
      (table s ((listedBandCoordinateVector band).get i)).width ≤ Bt)
    (heabs : |eta.value| ≤ E) (hkrange : 0 ≤ kappa.value ∧ kappa.value ≤ 1)
    (htrange : ∀ s ≤ t + 1, ∀ i : Fin (listedBandCoordinates band).length,
      0 ≤ (table s ((listedBandCoordinateVector band).get i)).value ∧
        (table s ((listedBandCoordinateVector band).get i)).value ≤
          (initial ((listedBandCoordinateVector band).get i).1
            ((listedBandCoordinateVector band).get i).2).value) :
    (bandActionWithWork b initial table eta kappa band G K t).2 ≤
      bandActionBitBudget M (listedBandCoordinates band).length b band.length G K t Be Bk Bi Bt E := by
  let coordinates := listedBandCoordinateVector band
  let mass := (envelopeVectorWithWork b band initial).1
  have hmv (j : Fin M) : (mass.get j).value =
      bandChildEnvelope b band (fun k q => (initial k q).value) j :=
    envelopeVectorWithWork_value b band initial hb j
  have hm (j : Fin M) : (mass.get j).width ≤ 3 * bandEnvelopeWordBudget b M Bi + 1 := by
    simp only [mass, envelopeVectorWithWork, vectorMapWithWork_value]
    exact bandEnvelopeWithWork_width b band initial j Bi (fun action ha => hi action ha j)
  have hmpos (j : Fin M) : 0 < (mass.get j).value := by
    rw [hmv]
    exact lt_of_lt_of_le (div_pos (by exact_mod_cast hb) (by exact_mod_cast hM))
      (bandChildEnvelope_lower b band (fun j q => (initial j q).value) j).1
  have hnormalized (s : ℕ) (hs : s ≤ t + 1) (i : Fin (listedBandCoordinates band).length) :
      0 ≤ (table s (coordinates.get i)).value ∧
        (table s (coordinates.get i)).value ≤ (mass.get (coordinates.get i).1).value := by
    refine ⟨(htrange s hs i).1, ?_⟩
    obtain ⟨action, ha, heq⟩ := listedBandCoordinateVector_coverage band i
    have henv := (bandChildEnvelope_lower b band (fun j q => (initial j q).value)
      (coordinates.get i).1).2 action ha
    rw [heq] at henv
    rw [hmv]
    exact (htrange s hs i).2.trans henv
  have hp := preparedBandActionWithWork_cost mass table eta kappa band G K t
    Be Bk (3 * bandEnvelopeWordBudget b M Bi + 1) Bt E hband he hk hm hmpos ht heabs hkrange hnormalized
  have hc := vectorMapWithWork_cost_le M (bandEnvelopeWithWork b band initial)
    (bandEnvelopeBitBudget b M band.length Bi)
    (fun j => bandEnvelopeWithWork_cost b band initial j Bi (fun action ha => hi action ha j))
  change (envelopeVectorWithWork b band initial).2 +
    (preparedBandActionWithWork mass table eta kappa band G K t).2 + 1 ≤ _
  change (envelopeVectorWithWork b band initial).2 ≤ _ at hc
  unfold bandActionBitBudget
  omega

end BinaryFraction
end EditApproximation

end OAI
end

theorem solution : type_of% @OAI.EditApproximation.BinaryFraction.bandActionWithWork_cost_oai := @OAI.EditApproximation.BinaryFraction.bandActionWithWork_cost_oai
