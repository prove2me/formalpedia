-- Source module: Solutions.J6SegILJKer2
/-!
# B-line IL, the `J` kernel (B4), part 2: specifications of multiplying register programs

`MSp M p s t c`: the multiplying register program `p : RM` (products through the
multiplication procedure with specification `M`) is executable from `s`, ends in `t` and costs
at most `c`; the analogue of `KIL.Sp`. Here: composition (`MSp.seq`), plain register programs
(`MSp.rs`), a multiplication on a managed state (`MSp.mul`: `Φm + O(X)` for `X`-bit operands,
given `MulBnd M X Φm`), the branch (`MSp.ite`), the counted loop through managed states
(`MSp.rep`, overhead quadratic only in the bit size of the *count*) and the compilation
(`MSp.irun`). Also `floorDivE` / `rsE`: the rounding `rs P` as linear work.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function

/-! ## Specifications -/

section msp
variable {M : MulSpec}

theorem MSp.congr {p : RM} {s t t' : IState HS} {c : ℕ} (h : MSp M p s t c) (e : t = t') :
    MSp M p s t' c := e ▸ h

theorem MSp.irun {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {pM : Fin Pp}
    {pc : ℕ → Fin Pp} (hM : MulOK I iprog pM M) {p : RM} (hP : RM.PrcOK I iprog pc p)
    {s t : IState HS} {c : ℕ} (h : MSp M p s t c) : IRuns I iprog (p.code pM pc) s t c :=
  (RM.code_runs M pM pc hM p hP s h.1).mono' h.2.1 h.2.2

end msp

/-! ## The rounding as linear work -/

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegILJKer18
/-!
# B-line IL, the `J` kernel (B4), part 18: the `RowBody6` statements

`jK_row`: if procedure `e` of the table is the compiled `jKprog`, it is a `RowBody6` row kernel
for the generic `J` map `jKerG` with the table `jTab` on `dTJ`, at cost `jC + 2`.

`jKer_row`: the same for the `J` kernel of the segmented line (`jKer P R s t λ w α K G`), with
the streams `jFs`, `jBs`, `jCc` of the line.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL NLogN.KFB Function Finset

theorem jKprog_prcOK {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} (pc : ℕ → Fin Pp) :
    RM.PrcOK I iprog pc jKprog := by
  simp [RM.PrcOK, jKprog, partP, fwdP, fwdB, dotP, kD, bwdP, bwdB, divB, recip, flB, cplP, cplB]

/-- **B4, generic form.** -/
theorem jK_row {P k K G Xb Bc : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
    {cc : List (List ℤ)} {Pp : ℕ} {I : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e pM : Fin Pp}
    {pc : ℕ → Fin Pp} {M : MulSpec} {Φm Bx : ℕ} (hM : MulOK I tbl pM M)
    (hMB : MulBnd M (k + 2) Φm) (he : tbl e = jKprog.code pM pc) (hBx : 3 * k + 10 ≤ Bx) :
    RowBody6 I tbl e dTJ (fun _ => jTab P k K G fs bs cc) (JPre P k K G Xb Bc fs bs cc)
      (fun _ => liftG (jKerG P K G fs.length fs bs cc))
      ((jC k K G fs bs cc (uC Φm Bx Bc) + 2 : ℕ) : ℝ) := by
  intro q s F x l hF hT h0 hP
  refine ⟨_, IRuns.call ?_, le_rfl⟩
  rw [he]
  exact MSp.irun hM (jKprog_prcOK pc) (jKprog_spec hMB s hF hT h0 hP hBx)

section line
variable (P R s t lam w α K : ℕ)

theorem jFs_length : (jFs P R s t lam w α).length = (LJ s t lam w).length := by simp [jFs, fsOf]

theorem jKer_eq (G : ℕ) (v : List ℤ) :
    jKer P R s t lam w α K G v =
      jKerG P K G (jFs P R s t lam w α).length (jFs P R s t lam w α) (jBs P R s t lam w α)
        (jCc P R s t lam w α K) v := by
  rw [jFs_length]
  simp only [jKer, jKerG, wOf, List.take_take, min_self]
  congr 1
  apply List.map_congr_left
  intro r hr
  rw [List.mem_range] at hr
  simp only [jFs, jBs, jCc]
  rw [List.getD_eq_getElem _ _ (by simpa using hr), List.getElem_map, List.getElem_range]

/-- **B4.** The `J` kernel of the line as a `RowBody6` row kernel (table `jTab`, any chunk). -/
theorem jKer_row {k G Xb Bc : ℕ} {Pp : ℕ} {I : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {e pM : Fin Pp} {pc : ℕ → Fin Pp} {M : MulSpec} {Φm Bx : ℕ} (hM : MulOK I tbl pM M)
    (hMB : MulBnd M (k + 2) Φm) (he : tbl e = jKprog.code pM pc) (hBx : 3 * k + 10 ≤ Bx) :
    RowBody6 I tbl e dTJ
      (fun _ => jTab P k K G (jFs P R s t lam w α) (jBs P R s t lam w α) (jCc P R s t lam w α K))
      (JPre P k K G Xb Bc (jFs P R s t lam w α) (jBs P R s t lam w α) (jCc P R s t lam w α K))
      (fun _ => liftG (jKer P R s t lam w α K G))
      ((jC k K G (jFs P R s t lam w α) (jBs P R s t lam w α) (jCc P R s t lam w α K)
        (uC Φm Bx Bc) + 2 : ℕ) : ℝ) := by
  have h := jK_row (P := P) (k := k) (K := K) (G := G) (Xb := Xb) (Bc := Bc)
    (fs := jFs P R s t lam w α) (bs := jBs P R s t lam w α) (cc := jCc P R s t lam w α K)
    hM hMB he hBx
  have e : jKer P R s t lam w α K G = jKerG P K G (jFs P R s t lam w α).length
      (jFs P R s t lam w α) (jBs P R s t lam w α) (jCc P R s t lam w α K) :=
    funext (jKer_eq P R s t lam w α K G)
  rw [e]; exact h

end line

