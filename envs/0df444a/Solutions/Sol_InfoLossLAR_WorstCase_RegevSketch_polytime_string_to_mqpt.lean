noncomputable section

namespace InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit

open QAlgorithms.Complexity

open OAI.MetricKMedian.Binary OAI.MetricKMedian.Binary.Automatic

open Integration9_9.TM2PlatformSerialization Integration9_9.TM2PolynomialBudget RPN

open scoped BigOperators Classical

variable {f : Str → Str} (P : PolyProgram id id f)

attribute [local instance] InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit.instDecidableEqLabelMachineListBool_solutions_4

attribute [local instance] InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit.instDecidableEqStateMachineListBool_solutions_4

@[fun_prop] theorem quantumDescription_poly : Poly (quantumDescription P) := by
  unfold quantumDescription
  fun_prop

theorem quantumDescription_code (n : ℕ) : quantumDescription P (unary n)=encFamilyAt (family P) n := by
  unfold quantumDescription
  rw [descriptionGenerator_code,compileBooleanDescription_code,compileReversibleDescription_code]
  rfl

@[fun_prop] theorem multiTotalSlots_poly : Poly (multiTotalSlots P) := by
  have hp : Poly (fun word : Str => List.replicate ((spacePolynomial P).eval word.length) ()) := by
    have h := Poly.comp (f := fun xs : List Unit => List.replicate ((spacePolynomial P).eval xs.length) ())
      (g := fun word : Str => word.map (fun _ => ())) (polynomialSlots_poly (spacePolynomial P)) (by fun_prop)
    simpa only [List.length_map] using h
  unfold multiTotalSlots
  fun_prop

@[fun_prop] theorem multiOutputWords_poly : Poly (multiOutputWords P) := by
  unfold multiOutputWords
  fun_prop

theorem multiOutputWords_code (n : ℕ) : multiOutputWords P (unary n)=
    (List.ofFn (fun i : Fin (capacity P n) => outputWire P n i (some true))).map
      (fun wire => encNat wire.val) := by
  have hslots : (request P (unary n)).2.1.length=capacity P n := by
    rw [request_unary]
    simp
  have hr (index : ℕ) (hi : index < capacity P n) :
      generatedProgramOutputAddress P (unary n) index=
        (outputWire P n ⟨index,hi⟩ (some true)).val :=
    generatedProgramOutputAddress_eq P n ⟨index,hi⟩
  unfold multiOutputWords generatedAddressRange
  rw [hslots]
  apply List.ext_getElem
  · simp only [List.length_map,List.length_range,List.length_ofFn]
  · intro index hleft hright
    have hi : index < capacity P n := by simpa only [List.length_map,List.length_ofFn] using hright
    simp only [List.getElem_map,List.getElem_range,List.getElem_ofFn,Nat.zero_add,hr index hi]
    apply boundedNat_eq
    have ha := ancilla_bound P n
    have ho := (outputWire P n ⟨index,hi⟩ (some true)).isLt
    simp only [multiTotalSlots,List.length_append,List.length_map,List.length_replicate,
      List.length_singleton,unary] 
    omega

/-- Keep the generated circuit and ancilla header, replacing only its output list. -/
def rewriteOutputDescription (input : Str × List Str) : Str :=
  (readUnary input.1).1++serializeWords input.2++(readUnary (readUnary input.1).2).2

@[fun_prop] theorem rewriteOutputDescription_poly : Poly rewriteOutputDescription := by
  have hr : Poly (fun input : Str × List Str => readUnary input.1) := by fun_prop
  have ht : Poly (fun input : Str × List Str => readUnary (readUnary input.1).2) :=
    Poly.comp readUnary_poly (Poly.comp Poly.snd hr)
  unfold rewriteOutputDescription
  exact Poly.comp Poly.list_append (Poly.pair
    (Poly.comp Poly.list_append (Poly.pair (Poly.comp Poly.fst hr)
      (Poly.comp serializeWords_poly Poly.snd))) (Poly.comp Poly.snd ht))

/-- Actual raw native generator of every designated wire and the full circuit. -/
def multiDescription (word : Str) : Str :=
  rewriteOutputDescription (quantumDescription P word,multiOutputWords P word)

@[fun_prop] theorem multiDescription_poly : Poly (multiDescription P) := by
  exact Poly.comp (f := rewriteOutputDescription)
    (g := fun word => (quantumDescription P word,multiOutputWords P word))
    rewriteOutputDescription_poly (Poly.pair (quantumDescription_poly P) (multiOutputWords_poly P))

theorem multiDescription_code (n : ℕ) : multiDescription P (unary n)=(multiFamily P).encAt n := by
  unfold multiDescription rewriteOutputDescription
  rw [quantumDescription_code,multiOutputWords_code]
  simp only [encFamilyAt,List.append_assoc,readUnary_append,serializeWords_eq,MFamily.encAt,multiFamily]
  simp only [bind_pure_comp]
  change _ = encNat ((family P).anc n)++(encStr
    (((List.ofFn (fun i : Fin (capacity P n) => outputWire P n i (some true))).map Fin.val).map encNat)++
      encCirc ((family P).circ n))
  rw [List.map_map]
  rfl

/-- A complete IsMQPT certificate from a real native program, with no extra
uniformity, output-length or generator premise. -/
theorem multiFamily_isMQPT : IsMQPT (multiFamily P) := by
  refine ⟨⟨multiDescription P,polyTime_of_poly (multiDescription_poly P),multiDescription_code P⟩,?_,?_⟩
  · intro n layer hlayer
    exact (family_isQPT P).2.1 n layer hlayer
  · refine ⟨74*spacePolynomial P+spacePolynomial P+capacityPolynomial P,?_⟩
    intro n
    simp only [Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_ofNat,capacityPolynomial_eval]
    have hd := depth_bound P n
    have ha := ancilla_bound P n
    change depth (circuit P n) ≤ _ ∧ (compiled P n).ops.length ≤ _ ∧ capacity P n ≤ _
    simp only [Polynomial.eval_mul,Polynomial.eval_ofNat] at hd
    omega

theorem paddedOutput_eq_append (word : Str) :
    paddedOutput P word=f word++List.replicate (capacity P word.length-(f word).length) false := by
  have hl := actualOutput_length_lt_capacity P word
  apply List.ext_getElem
  · simp only [paddedOutput,List.length_ofFn,List.length_append,List.length_replicate]
    omega
  · intro index hleft hright
    simp only [paddedOutput,List.getElem_ofFn]
    by_cases hi : index < (f word).length
    · simp [List.getElem_append_left hi,List.getElem?_eq_getElem hi]
    · simp [List.getElem_append_right (Nat.le_of_not_gt hi),List.getElem?_eq_none (Nat.le_of_not_gt hi)]

theorem multiFamily_output (word : Str) (event : Str → Prop) :
    outputProb (multiFamily P) word event=if event (paddedOutput P word) then 1 else 0 := by
  unfold outputProb
  change (∑ state : Bits (word.length+((compiled P word.length).ops.length+1)),
    if event (List.ofFn (fun i => state (outputWire P word.length i (some true)))) then
      ‖runLayered ((family P).circ word.length) (basisInput (toBits word)) state‖^2 else 0)=_
  rw [family_basis]
  have hout : (List.ofFn (fun i : Fin (capacity P word.length) =>
      result P word (outputWire P word.length i (some true))))=paddedOutput P word := by
    apply congrArg List.ofFn
    funext i
    rw [output_correct]
    cases hb : (f word)[i.val]? with
    | none => simp [paddedOutput,hb]
    | some bit => cases bit <;> simp [paddedOutput,hb]
  have h := computationalBasis_event (result P word)
    (fun state => decide (event (List.ofFn (fun i => state (outputWire P word.length i (some true))))))
  simpa only [decide_eq_true_eq,hout] using h

end InfoLossLAR.WorstCase.TM2Boolean.PolyProgramCircuit

end

