section s217
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitialDifference
open Structured
lemma eval_code (s : Data) (hz : s.realReg 56 = 0) : ∃ cost, Eval code s cost (result s) ∧ cost ≤ 5 := by
  by_cases ha : s.natReg 626 < s.natReg 72
  · have hne : s.natReg 626 ≠ s.natReg 72 := ne_of_lt ha
    refine ⟨2,?_,by omega⟩
    simpa only [code,ordinary,result,if_neg hne,hz,zero_add] using
      Eval.branchYes (no := .branch (.natLess 72 626) ordinary sourceTail)
        (show (Test.natLess 626 72).holds s from ha) (eval_add s 606 56 56)
  · by_cases hz' : s.natReg 72 < s.natReg 626
    · have hne : s.natReg 626 ≠ s.natReg 72 := ne_of_gt hz'
      refine ⟨4,?_,by omega⟩
      simpa only [code,ordinary,result,if_neg hne,hz,zero_add] using
        Eval.branchNo (yes := ordinary) (show ¬ (Test.natLess 626 72).holds s from ha)
          (Eval.branchYes (no := sourceTail) (show (Test.natLess 72 626).holds s from hz') (eval_add s 606 56 56))
    · have heq : s.natReg 626 = s.natReg 72 := by omega
      refine ⟨5,?_,le_rfl⟩
      simpa only [code,sourceTail,result,if_pos heq,hz,zero_sub] using
        Eval.branchNo (yes := ordinary) (show ¬ (Test.natLess 626 72).holds s from ha)
          (Eval.branchNo (yes := ordinary) (show ¬ (Test.natLess 72 626).holds s from hz') (eval_sub s 606 56 514))
lemma value (b : Core) (e : Fin b.input.k) (s : Data) (ht : s.natReg 626 = (b.input.graph.tail e).val)
    (hs : s.natReg 72 = b.input.source.val) (hi : s.realReg 514 = 1/(2*Q b)) :
    (result s).realReg 606 = initialLabel b (tail b (.inl e))-initialLabel b (head b (.inl e)) := by
  have hn := b.no_incoming_source e
  simp only [result,Function.update_self,ht,hs,hi,initialLabel,tail,head,if_neg hn]
  by_cases he : b.input.graph.tail e = b.input.source
  · simp [he,hn]
  · have hval : (b.input.graph.tail e).val ≠ b.input.source.val := fun hh => he (Fin.ext hh)
    simp [he,hval,hn]
lemma no_memory : NoMemory code := by simp [code,ordinary,sourceTail,NoMemory,add,sub,NoStore]
lemma nat_frame (k : ℕ) : NatFrame code k := by simp [code,ordinary,sourceTail,NatFrame,add,sub,writesNat]
lemma real_frame (k : ℕ) (hk : k ≠ 606) : RealFrame code k := by simp [code,ordinary,sourceTail,RealFrame,add,sub,writesReal,Ne.symm hk]
end DecrAlmostLinearSSSP.Decremental.CoreInitialDifference
