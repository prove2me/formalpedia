theorem OAI.CubicEisenstein.integral_cusp_character (h : O) :
    (∫ z in periodDomain,ShortDraftTrace.breveE (-cuspFrequency h*z))=
      if h=0 then ((9*Real.sqrt 3/2:ℝ):ℂ) else 0 := by sorry
