open Groundwork
open TM
namespace Groundwork
namespace PolyT
theorem _root_.solution {α β α' β' : Type} [Enc α] [Enc β] [Enc α'] [Enc β'] {f : α → β} (hf : PolyT f) {g : α' → β'}
    (φ : α' → α) (hφ : ∀ x, wd (φ x) = wd x) (hg : ∀ x, wd (g x) = wd (f (φ x))) : PolyT g := by
  obtain ⟨P, c, h1, h2⟩ := hf
  refine ⟨P, c, fun x M A B N => ?_, fun x => ?_⟩
  · have := h1 (φ x) M A B N
    simpa only [len, hφ, hg] using this
  · have := h2 (φ x)
    simpa only [len, hφ, hg] using this
end PolyT
end Groundwork
