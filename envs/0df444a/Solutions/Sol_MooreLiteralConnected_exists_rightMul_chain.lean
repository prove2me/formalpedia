namespace MooreLiteralConnected

/-- For a symmetric set `Γ`, the submonoid it generates is closed under inverses. -/
theorem inv_mem_submonoid_closure {G : Type*} [Group G] (Γ : Finset G)
    (hsymm : ∀ γ ∈ Γ, γ⁻¹ ∈ Γ) {g : G} (hg : g ∈ Submonoid.closure (Γ : Set G)) :
    g⁻¹ ∈ Submonoid.closure (Γ : Set G) := by
  induction hg using Submonoid.closure_induction with
  | mem x hx => exact Submonoid.subset_closure (by exact_mod_cast hsymm x (by exact_mod_cast hx))
  | one => simp
  | mul x y _ _ hx hy => rw [mul_inv_rev]; exact mul_mem hy hx

/-- For a symmetric generating set `Γ`, every element lies in the submonoid generated by `Γ`. -/
theorem mem_submonoid_closure {G : Type*} [Group G] (Γ : Finset G) (hsymm : ∀ γ ∈ Γ, γ⁻¹ ∈ Γ)
    (hgen : Subgroup.closure (Γ : Set G) = ⊤) (g : G) :
    g ∈ Submonoid.closure (Γ : Set G) := by
  have hg : g ∈ Subgroup.closure (Γ : Set G) := hgen ▸ Subgroup.mem_top g
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact Submonoid.subset_closure hx
  | one => exact one_mem _
  | mul x y _ _ hx hy => exact mul_mem hx hy
  | inv x _ hx => exact inv_mem_submonoid_closure Γ hsymm hx

end MooreLiteralConnected
