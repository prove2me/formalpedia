-- title:
--   Ideal-span membership has finite support
-- statement:
--   If an element belongs to the ideal generated by the range of a family, then it belongs to the ideal generated by the image of some finite set of indices.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.Ideal.Operations

theorem OAI.PiExponent.FormalInterpolation.mem_ideal_span_range_finite_support
    {R ι : Type} [CommSemiring R]
    (g : ι → R) (x : R)
    (hx : x ∈ Ideal.span (Set.range g)) :
    ∃ s : Finset ι, x ∈ Ideal.span (g '' (s : Set ι)) := by sorry
