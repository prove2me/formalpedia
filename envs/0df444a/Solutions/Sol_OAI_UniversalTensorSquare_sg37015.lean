      saxl_kronecker_pos 4 (by decide) _ (rowDiagram_card [2,2,2,2,2])⟩
  exact Eq.mpr (congrArg (fun α => SquareOccurs α (rowDiagram [2,2,2,2,2])) he) hh

end UniversalTensorSquare
