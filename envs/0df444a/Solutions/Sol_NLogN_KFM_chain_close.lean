variable {ι κ : Type*} [Fintype ι] [Fintype κ]
theorem solution (p b γ : ℕ) (S : ℝ) (hS0 : 0 ≤ S)
    -- exact maps
    {A : (κ → ℂ) → (ι → ℂ)} {QF : (ι → ℂ) → (ι → ℂ)} {B0 : (ι → ℂ) → (κ → ℂ)}
    {Mr : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} {θ θi a ck : ι → ℂ}
    (hA : NLogN.KFM.LinC A) (hQF : NLogN.KFM.LinC QF) (hB : NLogN.KFM.LinC B0) (hMr : NLogN.KFM.BilC Mr)
    (hQFa : ∀ x, a * (θi * Mr (θ * ck) (θ * (a * x))) = QF x)
    (hFc : ∀ w, ‖(2 : ℂ) ^ γ • B0 (QF (A w))‖ ≤ ‖w‖)
    -- computed procedures
    {At : (κ → ℂ) → (ι → ℂ)} {B0t : (ι → ℂ) → (κ → ℂ)} {Mrt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)}
    {θt θit at' bt : ι → ℂ} (εA εB Er : ℝ)
    (hAt : ∀ u, NLogN.KFM.Grid p u → ‖u‖ ≤ 1 / 2 → ‖At u - A u‖ ≤ εA * NLogN.KFM.hp p ∧ NLogN.KFM.Grid p (At u))
    (hBt : ∀ y, NLogN.KFM.Grid p y → ‖y‖ ≤ 1 → ‖B0t y - B0 y‖ ≤ εB * NLogN.KFM.hp p)
    (hMrt : ∀ f g, NLogN.KFM.Grid p f → NLogN.KFM.Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 1 → ‖Mrt f g - Mr f g‖ ≤ Er * NLogN.KFM.hp p)
    (hθ : NLogN.KFM.Phases p θ θt) (hθi : NLogN.KFM.Phases p θi θit) (ha : NLogN.KFM.Phases p a at') (hb' : NLogN.KFM.Phases p ck bt)
    (hbg : NLogN.KFM.Grid p bt)
    (hθg : NLogN.KFM.Grid p θit)
    -- sizes
    (hεA : εA * NLogN.KFM.hp p ≤ 1 / 10) (hEr : Er * NLogN.KFM.hp p ≤ 1 / 10)
    (hEs : (2 : ℝ) ^ γ * ((εA + (Er + 22) + εB) * NLogN.KFM.hp p) ≤ 1 / 100)
    (hB2 : 2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 *
      (3 * ((2 : ℝ) ^ γ * (εA + (Er + 22) + εB)) + 2) * NLogN.KFM.hp p < 1)
    -- data
    {u v : κ → ℂ} (hu : NLogN.KFM.Grid p u) (hv : NLogN.KFM.Grid p v) (hu1 : ‖u‖ ≤ 1 / 4) (hv1 : ‖v‖ ≤ 1 / 4)
    {c : κ → ℂ}
    (hc : ∀ j, (2 : ℂ) ^ (2 * b + 4) * S * (S * NLogN.KFM.cnj ((fun w => (2 : ℂ) ^ γ • B0 (QF (A w)))
      (NLogN.KFM.cnj ((2 : ℂ) ^ γ • B0 (QF (A u)) * (2 : ℂ) ^ γ • B0 (QF (A v))))) j) = c j) :
    let Ft : (κ → ℂ) → (κ → ℂ) := fun w =>
      (2 : ℂ) ^ γ • B0t (NLogN.KFM.chirpT p (NLogN.KFM.mcT p Mrt θt θit) bt at' (At w))
    ∀ j, ‖(2 : ℂ) ^ (2 * b + 4) * S * (S * NLogN.KFM.plusT Ft (NLogN.KFM.QA p (Ft u * Ft v)) j) - c j‖ < 1 / 2 := by
  intro Ft j
  have h0 := NLogN.KFM.hp_pos p
  set F : (κ → ℂ) → (κ → ℂ) := fun w => (2 : ℂ) ^ γ • B0 (QF (A w)) with hFdef
  -- the exact chirp convolution `MC`
  set MC : (ι → ℂ) → (ι → ℂ) → (ι → ℂ) := fun f g => θi * Mr (θ * f) (θ * g) with hMC
  have hMCb : NLogN.KFM.BilC MC := NLogN.KFM.bilC_twist hMr hθ.e hθi.e
  -- M̃C guarantee
  have hMCt : ∀ f g, NLogN.KFM.Grid p f → NLogN.KFM.Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 7 / 10 →
      ‖NLogN.KFM.mcT p Mrt θt θit f g - MC f g‖ ≤ (Er + 12) * NLogN.KFM.hp p ∧ ‖NLogN.KFM.mcT p Mrt θt θit f g‖ ≤ 1 := by
    intro f g _ _ hf hg
    obtain ⟨e1, e2⟩ := NLogN.KFM.mc_err p hMr Er hMrt hθ hθi hf hg (hEr.trans (by norm_num))
    exact ⟨e1, e2.trans (by linarith)⟩
  -- chirp guarantee
  have hCt : ∀ x, NLogN.KFM.Grid p x → ‖x‖ ≤ 6 / 10 → ‖NLogN.KFM.chirpT p (NLogN.KFM.mcT p Mrt θt θit) bt at' x - QF x‖ ≤
      (Er + 22) * NLogN.KFM.hp p ∧ ‖NLogN.KFM.chirpT p (NLogN.KFM.mcT p Mrt θt θit) bt at' x‖ ≤ 1 ∧
      NLogN.KFM.Grid p (NLogN.KFM.chirpT p (NLogN.KFM.mcT p Mrt θt θit) bt at' x) := by
    intro x _ hx
    obtain ⟨e1, e2⟩ := NLogN.KFM.chirp_err p hMCb (Er + 12) hMCt ha hb' hbg hx
    refine ⟨?_, e2, NLogN.KFM.QA_grid _ _⟩
    rw [← hQFa x]
    calc _ ≤ (Er + 12 + 10) * NLogN.KFM.hp p := e1
      _ = _ := by ring
  -- F is a linear contraction with `‖F u‖ ≤ 2^γ ‖u‖`; we only need the error form below
  set Es := (2 : ℝ) ^ γ * (εA + (Er + 22) + εB) with hEsd
  have hFt : ∀ w, NLogN.KFM.Grid p w → ‖w‖ ≤ 1 / 2 → ‖Ft w - F w‖ ≤ Es * NLogN.KFM.hp p := by
    intro w hw hw1
    have := NLogN.KFM.source_err p γ hA hQF hB εA (Er + 22) εB hAt hCt
      (fun y hy hy1 => hBt y hy hy1) hεA hw hw1
    calc _ ≤ _ := this
      _ = Es * NLogN.KFM.hp p := by rw [hEsd]; ring
  have hF : NLogN.KFM.LinC F := ⟨fun x y => by
      simp only [hFdef]; rw [← smul_sub, hB.sub, hQF.sub, hA.sub], hFc⟩
  obtain ⟨-, -, hp3⟩ := NLogN.KFM.pipeline_err p hF Es hFt (by rw [hEsd]; linarith [hEs]) hu hv hu1 hv1
  rw [← hc j]
  set W := NLogN.KFM.plusT Ft (NLogN.KFM.QA p (Ft u * Ft v))
  set G := NLogN.KFM.cnj (F (NLogN.KFM.cnj (F u * F v)))
  have e1 : (2 : ℂ) ^ (2 * b + 4) * S * (S * W j) - (2 : ℂ) ^ (2 * b + 4) * S * (S * G j) =
      ((2 : ℂ) ^ (2 * b + 4) * S * S) * (W - G) j := by
    simp only [Pi.sub_apply]; ring
  rw [e1, norm_mul]
  have n1 : ‖(2 : ℂ) ^ (2 * b + 4) * (S : ℂ) * S‖ = (2 : ℝ) ^ (2 * b + 4) * S ^ 2 := by
    rw [norm_mul, norm_mul, norm_pow, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hS0]; ring
  rw [n1]
  have hj := (norm_le_pi_norm (W - G) j).trans hp3
  have hpos : 0 ≤ (2 : ℝ) ^ (2 * b + 4) * S ^ 2 := by positivity
  calc (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * ‖(W - G) j‖
      ≤ (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * ((3 * Es + 2) * NLogN.KFM.hp p) :=
        mul_le_mul_of_nonneg_left hj hpos
    _ = (2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * (3 * Es + 2) * NLogN.KFM.hp p) / 2 := by ring
    _ < 1 / 2 := by rw [hEsd]; linarith
end
