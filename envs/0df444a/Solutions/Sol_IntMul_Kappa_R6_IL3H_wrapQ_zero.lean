-- Source module: Solutions.R6IL3Pad
/-!
# Round six, item language (I3): the scale pad

`scaleQ xL xQ ρ ρE = padCU xL xQ (wrapQ 2 1 ρ ρE .skip)`: append `n` zero records, swap the zero
half to the front, level the data half by `2^e`, swap back, drop the zeros.

* **`wrapQ_zero`**: the wrapper with `U = skip` on a zero role (zeros sit at every scale);
* **`sImplQ_scale`**: `scaleQ` implements the identity with scale shift `e`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem flatR_two {α : Type*} (X : Fin 2 → List α) : flatR X = X 0 ++ X 1 := by
  simp [flatR, List.finRange_succ]

/-- **The wrapper with `skip` on a zero role.** -/
theorem wrapQ_zero_sol_aux {r n : ℕ} (hr : 0 < r) (hn : 0 < n) {e : ℕ} (Z : ℕ)
    (hZ : zsz ((2 * (2 * (n * r)) : ℕ) : ℤ) ≤ Z)
    {σ : Fin HS → Option ℤ} {ρ ρE : Fin HS} (hR : WReg σ ρ ρE (n * r) e)
    (s : IState HS) (hs : Agree σ s) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (xs : List (Fin r → ℂ)) (F x : ℕ) (hC : Clean0 f) (h0 : f 0 = gflat zs ++ l)
    (hxs : xs.length = n) (hx : RecRep r F zs (xs ++ List.replicate n 0)) (hb : GB x zs) :
    ∃ zs', RecRep r (F + e) zs' (xs ++ List.replicate n 0) ∧ GB (x + (e + 2) * 2) zs' ∧
      IRuns I iprog (wrapQ 2 1 ρ ρE (.skip : IStmt HS Pp)) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l))) (cWrapQ 2 (n * r) Z e 0 (fun _ => 1) x) := by
  have hW : 0 < 2 := by decide
  set X : Fin 2 → List (Fin r → ℂ) := ![xs, List.replicate n 0] with hXdef
  have hX : ∀ v, (X v).length = n := by
    intro v; fin_cases v
    · simpa [X] using hxs
    · simp [X]
  have hxX : RecRep r F zs (flatR X) := by rw [flatR_two]; simpa [X] using hx
  set w : Fin 2 := 1
  set L := n * r with hL
  have hL1 : 1 ≤ L := Nat.mul_pos hn hr
  set o : Fin 2 := ⟨0, hW⟩
  set τ := Equiv.swap o w with hτ
  have hsw : ∀ v : Fin 2, swapsF (swL w.val) v.val = (τ v).val := by
    intro v
    rw [swapsF_swL, hτ, show (0 : ℕ) = o.val from rfl, ← pf_swap]
    simp [pf] <;> (intro h; have := v.isLt; omega)
  have hsl : ∀ p ∈ swL w.val, p.1 < p.2 ∧ p.2 < 2 := by
    intro p hp; unfold swL at hp
    split_ifs at hp with h0
    · simp at hp
    · simp at hp; subst hp; exact ⟨by simp [w], w.isLt⟩
  have hsl1 : (swL w.val).length ≤ 1 := by unfold swL; split_ifs <;> simp
  have hag : ∀ g : Fin HS → List ℤ, Clean0 g → Agree σ (encK s g) :=
    fun g hg => agree_clean0 hR.zero hs hg
  have HSw := swapsG_href hR.off hR.l hL1 hZ (swL w.val) hsl
  have NS : NoW σ (swapsG ρ (swL w.val)) := NoW.of_gT hR.off (swapsG_gT ρ _)
  have fS : fok (KFG.swapsP L (swL w.val)) = true := fok_swapsP _ _
  -- 1. swap the zero role to the front
  have E0 := enc_of_rec hr hX hxX
  obtain ⟨E1, B1, H1⟩ := swaps_fsp s l x Z hZ (swL w.val) hsl (fun _ => F) f zs (yR r X) E0 h0
    hC.clN.p hb
  set zs1 := swapsL L (swL w.val) zs
  set X1 : Fin 2 → List (Fin r → ℂ) := fun v => X (τ v)
  have hX1 : ∀ v, (X1 v).length = n := fun v => hX _
  have R1 : RecRep r F zs1 (flatR X1) := by
    refine rec_of_enc hr hX1 E1 (fun v j hj c => ?_)
    beta_reduce
    rw [hsw v, yR_val hr X (τ v) j c]
  -- 2. the zero role is at every scale
  have hy0 : ∀ p, yR r X1 0 p = 0 := by
    intro p
    have : X1 o = List.replicate n 0 := by
      simp only [X1, hτ, Equiv.swap_apply_left, w, X]; rfl
    simp only [KFN.yR, dif_pos (And.intro hW hr)]
    rw [show (⟨0, _⟩ : Fin 2) = o from rfl, this]
    simp [List.getD_eq_getElem?_getD, List.getElem?_replicate]
    split_ifs <;> simp
  have E1' := enc_of_rec hr hX1 R1
  have E2 : Enc 2 L (Function.update (fun _ => F) 0 (F + e)) zs1 (yR r X1) := by
    refine ⟨E1'.1, fun v hv p hp => ?_⟩
    by_cases hv0 : v = 0
    · subst hv0
      have := E1'.2 0 hv p hp
      rw [Function.update_self, hy0, mul_zero]
      rw [hy0, mul_zero] at this
      exact this
    · rw [Function.update_of_ne hv0]; exact E1'.2 v hv p hp
  -- 3. leveling
  set e2 := Function.update (fun _ : ℕ => F) 0 (F + e)
  have e2eq : e2 = shE F (Function.update (fun _ => 0) 0 e) := by
    funext t; by_cases ht : t = 0 <;> simp [e2, shE, ht, Nat.add_comm]
  have he2 : ∀ t, F ≤ e2 t ∧ e2 t ≤ F + e := fun t => by
    simp only [e2, Function.update_apply]; split_ifs <;> omega
  have hs2 : ∀ a ∈ levA 2 0, e2 a.s + a.h ≤ F + e := fun a ha => by
    rw [(levA_src a ha).1, (levA_src a ha).2.1]; simp [e2]
  have h01 : f 0 = gflat zs1 ++ l ∨ True := Or.inr trivial
  obtain ⟨E3, B3, H3⟩ := gate_fsp s l Z hZ (levA 2 0)
    (fun a ha => (levA_ok hW a ha).1) (levA_nots 2 0) e2
    (Function.update f 0 (gflat zs1 ++ l)) zs1 (yR r X1) (x + 0) E2 (by simp)
    (hC.upd0 _).clN.p (B1.mono (by omega))
  rw [gateY_zero (fun a ha => (levA_src a ha).2.2)] at E3
  have E3' := enc_congr_e E3 (gateE_levA hW e2 (by simp [e2]) (fun t => (he2 t).2))
  set zs3 := gateL (levA 2 0) e2 L zs1
  have w3 := gateW_le2 F (F + e) (levA 2 0) e2 (x + 0) (levA_nots 2 0) hs2 he2
  have hlev := levA_len 2 0
  -- 4. swap back
  obtain ⟨E4, B4, H4⟩ := swaps_fsp s l (gateW (levA 2 0) e2 (x + 0)) Z hZ (swL w.val) hsl
    (fun _ => F + e) (Function.update f 0 (gflat zs3 ++ l)) zs3 (yR r X1) E3' (by simp)
    (hC.upd0 _).clN.p B3
  refine ⟨swapsL L (swL w.val) zs3, ?_, ?_, ?_⟩
  · have R4 := rec_of_enc hr (Y := fun v => X1 (τ v)) (fun v => hX1 _) E4 (fun v j hj c => by
      beta_reduce; rw [hsw v, yR_val hr X1 (τ v) j c])
    have hfam : (fun v => X1 (τ v)) = X := by
      funext v; simp only [X1, Equiv.swap_apply_self, hτ]
    rw [hfam, flatR_two] at R4
    simpa [X] using R4
  · have : (F + e - F + 2) * (levA 2 0).length ≤ (e + 2) * 2 := Nat.mul_le_mul (by omega) hlev
    exact B4.mono (by omega)
  · have F2 : IRuns I iprog (.skip : IStmt HS Pp)
        (encK s (Function.update f 0 (gflat zs1 ++ l)))
        (encK s (Function.update f 0 (gflat zs1 ++ l))) 1 := IRuns.skip _
    rw [Function.update_idem] at H3 H4
    have HG : HRef (gateP (levA 2 0) e2 L) (RS.sub σ (levG 2 ρ ρE)) (2 * Xp Z) := by
      rw [e2eq, gateP_shE]; exact levG_href hR.off hR.l hR.e hL1 hZ
    have NG : NoW σ (levG 2 ρ ρE) := NoW.of_gT hR.off (levG_gT 2 ρ ρE)
    have U1 := (FSp.uni hR.cl NS HSw (hag f hC) H1).irun (I := I) (iprog := iprog) (fok_uni NS HSw fS)
    have U3 := (FSp.uni hR.cl NG HG (hag _ (hC.upd0 _)) H3).irun (I := I) (iprog := iprog)
      (fok_uni NG HG (fok_gateP _ _ _))
    have U4 := (FSp.uni hR.cl NS HSw (hag _ (hC.upd0 _)) H4).irun (I := I) (iprog := iprog)
      (fok_uni NS HSw fS)
    have := U1.seq (F2.seq (U3.seq U4))
    refine this.mono ?_
    have c3 := cGate_le2 F (F + e) L 2 Z (levA 2 0) e2 (x + 0) (levA_nots 2 0) hs2 he2
    have m1 : cAtom x 0 L 2 Z ≤ cAtom (x + 0 + (e + 2) * 2) e L 2 Z :=
      cAtom_mono (by omega) (by omega)
    have m3 : (levA 2 0).length * cAtom (x + 0 + (F + e - F + 2) * (levA 2 0).length)
        (F + e - F) L 2 Z ≤ 2 * cAtom (x + 0 + (e + 2) * 2) e L 2 Z :=
      Nat.mul_le_mul hlev (cAtom_mono (by
        have : (F + e - F + 2) * (levA 2 0).length ≤ (e + 2) * 2 :=
          Nat.mul_le_mul (by omega) hlev
        omega) (by omega))
    have m4 : cAtom (gateW (levA 2 0) e2 (x + 0)) 0 L 2 Z ≤
        cAtom (x + 0 + (e + 2) * 2) e L 2 Z := cAtom_mono (by
          have : (F + e - F + 2) * (levA 2 0).length ≤ (e + 2) * 2 :=
            Nat.mul_le_mul (by omega) hlev
          omega) (by omega)
    have m5 := Nat.mul_le_mul_right (cAtom x 0 L 2 Z) hsl1
    have m6 := Nat.mul_le_mul_right (cAtom (gateW (levA 2 0) e2 (x + 0)) 0 L 2 Z) hsl1
    have m7 := Nat.mul_le_mul_right (Xp Z) hsl1
    have m8 : Xp Z ≤ 2 * Xp Z := Nat.le_mul_of_pos_left _ hW
    unfold cWrapQ
    show _ ≤ 1 + _
    generalize cGate (levA 2 0) e2 (x + 0) L 2 Z = g at *
    generalize cAtom x 0 L 2 Z = a1 at *
    generalize cAtom (gateW (levA 2 0) e2 (x + 0)) 0 L 2 Z = a4 at *
    generalize cAtom (x + 0 + (F + e - F + 2) * (levA 2 0).length) (F + e - F) L 2 Z = a3 at *
    generalize cAtom (x + 0 + (e + 2) * 2) e L 2 Z = A at *
    generalize (levA 2 0).length = k at *
    generalize (swL w.val).length = k' at *
    generalize Xp Z = xz at *
    nlinarith

end IntMul.Kappa.R6.IL3H

