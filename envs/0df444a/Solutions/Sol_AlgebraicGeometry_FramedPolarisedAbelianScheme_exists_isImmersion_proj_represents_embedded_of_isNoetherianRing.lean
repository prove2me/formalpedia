variable {B : Type} [CommRing B] {N g : ℕ} {hf : ℕ → ℕ} (C : KCtx B N g hf)
variable {n : ℕ} (F : C.FramedPt n)

noncomputable def framedSecR {R : Type} [CommRing R] (X : FramedPolarisedAbelianScheme g N n R) (j : Fin (2 * g + 1)) :
    Spec (CommRingCat.of R) ⟶ X.A :=
  if h : j.1 = 0 then (X.L.one (𝟙 _)).1 else (X.P ⟨j.1 - 1, by omega⟩).1

theorem framedSecR_f {R : Type} [CommRing R] (X : FramedPolarisedAbelianScheme g N n R) (j : Fin (2 * g + 1)) :
    framedSecR X j ≫ X.f = 𝟙 _ := by
  unfold framedSecR
  split_ifs with h
  · exact (X.L.one (𝟙 _)).2
  · exact (X.P _).2

theorem framedSec_eq {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) (j : Fin (2 * g + 1)) :
    framedSec (B := B) X j = framedSecR X j ≫ X.frame.toProj ≫ ProjSpace.map B R N := by
  unfold framedSec framedSecR
  split_ifs <;> rfl

theorem framedSec_eq_iff {R : Type} [CommRing R] [Algebra B R] (X X' : FramedPolarisedAbelianScheme g N n R)
    (j : Fin (2 * g + 1)) :
    framedSec (B := B) X j = framedSec (B := B) X' j ↔
      framedSecR X j ≫ X.frame.toProj = framedSecR X' j ≫ X'.frame.toProj := by
  rw [framedSec_eq, framedSec_eq]
  constructor
  · intro h
    apply (AlgebraicGeometry.ProjSpace.isPullback_map B R N).hom_ext
    · simpa only [Category.assoc] using h
    · rw [Category.assoc, X.frame.toProj_π, framedSecR_f, Category.assoc, X'.frame.toProj_π, framedSecR_f]
  · intro h
    simp only [← Category.assoc]
    rw [h]

theorem ptW_eq_iff_embedded {R : Type} [CommRing R] [Algebra B R] (X X' : FramedPolarisedAbelianScheme g N n R) :
    (C.ptW F X).1 = (C.ptW F X').1 ↔
      ∃ (e₀ : X.A ≅ X'.A), e₀.hom ≫ X'.f = X.f ∧ e₀.hom ≫ X'.frame.toProj = X.frame.toProj ∧
        (X.L.one (𝟙 (Spec (CommRingCat.of R)))).1 ≫ X.frame.toProj =
          (X'.L.one (𝟙 (Spec (CommRingCat.of R)))).1 ≫ X'.frame.toProj ∧
        ∀ i, (X.P i).1 ≫ X.frame.toProj = (X'.P i).1 ≫ X'.frame.toProj := by
  rw [ptW_eq_iff]
  constructor
  · rintro ⟨hq, hy⟩

    have key : ∀ (p p' : Point R N hf), p = p' →
        (∃ e : (C.Φ R p).1 ≅ X.A, e.hom ≫ X.frame.toProj = (C.Φ R p).2) →
        (∃ e' : (C.Φ R p').1 ≅ X'.A, e'.hom ≫ X'.frame.toProj = (C.Φ R p').2) →
        ∃ e₀ : X.A ≅ X'.A, e₀.hom ≫ X'.frame.toProj = X.frame.toProj := by
      rintro p p' rfl ⟨e, he⟩ ⟨e', he'⟩
      refine ⟨e.symm ≪≫ e', ?_⟩
      rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, he', ← he, Iso.inv_hom_id_assoc]
    obtain ⟨e₀, he₀⟩ := key _ _ hq (F.iso R X) (F.iso R X')
    refine ⟨e₀, ?_, he₀, ?_, fun i => ?_⟩
    · rw [← X'.frame.toProj_π, ← Category.assoc, he₀, X.frame.toProj_π]
    · have h0 := (framedSec_eq_iff (B := B) X X' ⟨0, by omega⟩).mp (hy _)
      simpa only [framedSecR, dif_pos] using h0
    · have hi := (framedSec_eq_iff (B := B) X X' ⟨i.1 + 1, by omega⟩).mp (hy _)
      simp only [framedSecR, Nat.add_eq_zero_iff, one_ne_zero, and_false, dif_neg, not_false_eq_true,
        Nat.add_sub_cancel, Fin.eta] at hi
      exact hi
  · rintro ⟨e₀, -, he₀, h0, hP⟩
    refine ⟨?_, fun j => ?_⟩
    · obtain ⟨e, he⟩ := F.iso R X
      obtain ⟨e', he'⟩ := F.iso R X'
      apply C.Φ_inj R
      refine ⟨e ≪≫ e₀ ≪≫ e'.symm, ?_⟩
      rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, Category.assoc, Category.assoc, ← he', Iso.inv_hom_id_assoc, he₀, he]
    · apply (framedSec_eq_iff (B := B) X X' j).mpr
      unfold framedSecR
      split_ifs with hj
      · exact h0
      · exact hP _

theorem framedSec_comp {R R' : Type} [CommRing R] [CommRing R'] [Algebra B R] [Algebra B R'] (φ : R →ₐ[B] R')
    (X : FramedPolarisedAbelianScheme g N n R) (X' : FramedPolarisedAbelianScheme g N n R')
    (h : FramedPolarisedAbelianScheme.IsPullback φ.toRingHom X X') (j : Fin (2 * g + 1)) :
    framedSec (B := B) X' j = Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ framedSec (B := B) X j := by
  letI : Algebra R R' := φ.toRingHom.toAlgebra
  haveI : IsScalarTower B R R' := IsScalarTower.of_algebraMap_eq (fun b => (φ.commutes b).symm)
  obtain ⟨gA, hg, hmul, hP, -, hframe⟩ := h

  have hsec : framedSecR X' j ≫ gA = Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ framedSecR X j := by
    unfold framedSecR
    split_ifs with hj
    · rw [one_comp_of_mul_comp (Spec.map (CommRingCat.ofHom φ.toRingHom)) gA hg.w X.L X'.L hmul (𝟙 _),
        one_coe_congr X.L (Category.id_comp _ |>.trans (Category.comp_id _).symm),
        ← congrArg Subtype.val (X.L.one_natural (𝟙 _) (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ 𝟙 _)
          (Spec.map (CommRingCat.ofHom φ.toRingHom)) rfl),
        GoodReductionJacobian.schemeHomOverComp_coe]
    · exact hP _
  rw [framedSec_eq, framedSec_eq, ← map_comp_map B R R' N]
  slice_lhs 2 3 => rw [hframe]
  simp only [Category.assoc]
  rw [← Category.assoc (framedSecR X' j) gA, hsec, Category.assoc]

theorem ptW_nat {R R' : Type} [CommRing R] [CommRing R'] [Algebra B R] [Algebra B R'] (φ : R →ₐ[B] R')
    (X : FramedPolarisedAbelianScheme g N n R) (X' : FramedPolarisedAbelianScheme g N n R')
    (h : FramedPolarisedAbelianScheme.IsPullback φ.toRingHom X X') :
    (C.ptW F X').1 = Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (C.ptW F X).1 := by
  have hφB : Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap B R)) =
      Spec.map (CommRingCat.ofHom (algebraMap B R')) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hc : φ.toRingHom.comp (algebraMap B R) = algebraMap B R' := RingHom.ext fun b => φ.commutes b
    rw [hc]
  let s' : {s : Spec (CommRingCat.of R') ⟶ C.W₀ // s ≫ C.πW = Spec.map (CommRingCat.ofHom (algebraMap B R'))} :=
    ⟨Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (C.ptW F X).1, by rw [Category.assoc, (C.ptW F X).2, hφB]⟩
  suffices hs : C.ptW F X' = s' from congrArg Subtype.val hs
  apply (C.hW R').1
  apply Subtype.ext
  apply Prod.ext
  · show (C.ptW F X').1 ≫ C.prH = (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (C.ptW F X).1) ≫ C.prH
    rw [ptW_prH, Category.assoc, ptW_prH]
    exact (C.ptH_nat R R' φ.toRingHom (F.pt R X) (F.pt R' X')).mp (F.nat R R' φ X X' h)
  · funext j
    show (C.ptW F X').1 ≫ C.prY j = (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (C.ptW F X).1) ≫ C.prY j
    rw [ptW_prY, Category.assoc, ptW_prY]
    exact framedSec_comp (B := B) φ X X' h j

end KCtx
