theorem conj_mem_of_levelLaw {G : Type} [Group G] {q q' : ℕ} (Γ : Obj q q' → Subgroup G) (s : AwayPrime q q' → G)
    (hΓℓ : ∀ ℓ : AwayPrime q q', Γ (some ℓ) = Γ none ⊓ (Γ none).map (MulAut.conj (s ℓ)).toMonoidHom)
    (α : Arr q q') (γ : G) (hγ : γ ∈ Γ (dom α)) :
    (if α.2 = 0 then (1 : G) else s α.1)⁻¹ * γ * (if α.2 = 0 then (1 : G) else s α.1) ∈ Γ (cod α) := by
  obtain ⟨ℓ, i⟩ := α
  have hγ' : γ ∈ Γ none ⊓ (Γ none).map (MulAut.conj (s ℓ)).toMonoidHom := by rw [← hΓℓ]; exact hγ
  show (if i = 0 then (1 : G) else s ℓ)⁻¹ * γ * (if i = 0 then (1 : G) else s ℓ) ∈ Γ none
  by_cases hi : i = 0
  · simp only [if_pos hi, inv_one, one_mul, mul_one]; exact hγ'.1
  · simp only [if_neg hi]
    have h2 := Subgroup.mem_map_equiv.mp hγ'.2
    rwa [MulAut.conj_symm_apply] at h2

theorem smul_ιM_eq_ιM_φ {q q' : ℕ} {Fbase : Type} [Field Fbase] [Algebra (AlgebraicClosure ℚ) Fbase]
    (𝕋 : TowerData q q' Fbase) {G Fr : Type} [Group G] [Field Fr] [MulSemiringAction G Fr]
