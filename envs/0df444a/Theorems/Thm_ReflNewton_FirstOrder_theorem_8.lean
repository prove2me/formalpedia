-- title:
--   Theorem 8, p. 207 — under consistency and constraint compatibility, D_k²g_k → 0 and α_k² min(s_kᵀH_ks_k, 0) → 0
-- statement:
--   Consider the bound-constrained problem $\min f(x)$ subject to $l\le x\le u$, with $l\in(\mathbb R\cup\{-\infty\})^n$, $u\in(\mathbb R\cup\{+\infty\})^n$, $l\le u$, and feasible box $\mathcal F$. Assume the paper's compactness and smoothness assumption: for the initial point $x_1$ the level set $\mathcal L=\{x\in\mathcal F: f(x)\le f(x_1)\}$ is compact, and $f$ is twice continuously differentiable on an open set $D\supseteq\mathcal F$.
--
--   Let $\{x_k\}$ be a sequence generated by the interior-reflective path algorithm of Fig. 9, with line-search parameters $0<\sigma_l<\sigma_u<1$ and threshold $\rho>0$, directions $s_k$ and stepsizes $\alpha_k$, and assume that $\{s_k\}$ satisfies both the consistency condition ($s_k^{T}g_k\to0$ implies $D_kg_k\to0$) and the constraint-compatibility condition ($\{D_k^{-2}s_k\}$ is bounded). Then
--   $$\lim_{k\to\infty}D_k^2g_k=0\qquad\text{and}\qquad\lim_{k\to\infty}\alpha_k^2\min(s_k^{T}H_ks_k,0)=0,$$
--   where $g_k=\nabla f(x_k)$, $H_k=\nabla^2f(x_k)$ and $D_k^2=\operatorname{diag}(|v(x_k)|)$.
--
--   Since $D(x)^2\nabla f(x)=0$ is equivalent to the first-order optimality conditions of the bound-constrained problem, this is the first-order global convergence theorem of the interior-reflective approach: every limit point of the iterates is a first-order point. The second limit is not part of the first-order conditions but is used in the second-order analysis.
--
--   **Formalization Note** The compactness and smoothness assumption is stated once at the beginning of the paper (p. 191) and is carried here as hypotheses. The algorithm, the scaling $D$, the reflective path, and Definitions 3 and 4 are those of the definitions file; `x 0` is the paper's $x_1$.
-- source:
--   Coleman & Li, On the convergence of interior-reflective Newton methods for nonlinear minimization subject to bounds, Math. Programming 67 (1994), p. 207, Theorem 8 (proof pp. 207–208); standing assumption p. 191

import Mathlib
import Definitions.Def_LewisTorczon_BoundPS_Box
import Definitions.Def_ReflNewton_FirstOrder_Setting
open Filter Topology

namespace ReflNewton.FirstOrder

theorem theorem_8
    {n : ℕ} (l u : Fin n → EReal) (hl : ∀ i, l i ≠ ⊤) (hu : ∀ i, u i ≠ ⊥) (hlu : l ≤ u)
    (f : E n → ℝ) (D : Set (E n)) (hDo : IsOpen D)
    (hFD : LewisTorczon.BoundPS.box l u ⊆ D) (hf : ContDiffOn ℝ 2 f D)
    (σl σu ρ : ℝ) (hσl : 0 < σl) (hσlu : σl < σu) (hσu : σu < 1) (hρ : 0 < ρ)
    (x s : ℕ → E n) (α : ℕ → ℝ) (hrun : IsIRRun l u f σl σu ρ x s α)
    (hL : IsCompact (LewisTorczon.BoundPS.levelSet l u f (x 0)))
    (hcons : IsConsistent l u f x s)
    (hcc : IsConstraintCompatible l u f x s) :
    Tendsto (fun k => dSqG l u f (x k)) atTop (𝓝 0) ∧
      Tendsto (fun k => α k ^ 2 * min (hq f (x k) (s k)) 0) atTop (𝓝 0) := by sorry

end ReflNewton.FirstOrder
