theorem calls_le (C : Bit.QHNet (ZMod 2) W T m) (Bb : ℕ) (c0 : ℕ × ℕ × ℕ → ℕ) :
    ((runsL C).map fun ρ => cCallR m ρ Bb (c0 ρ)).sum ≤
      ((runsL C).map c0).sum + KR C * (Bb + 2) ^ 2 := by
  have hX : Bb + 2 ≤ (Bb + 2) ^ 2 := Nat.le_self_pow (n := 2) (by norm_num) _
  have h1 : ∀ ρ, cCallR m ρ Bb (c0 ρ) ≤ c0 ρ + (pushSz (chR m ρ) * 10 ^ 7 + 30) * (Bb + 2) ^ 2 := by
    intro ρ
    unfold cCallR
    rw [pushCost_eq]
    have e1 : (pushSz (chR m ρ) * 10 ^ 7 + 30) * (Bb + 2) ^ 2 =
        pushSz (chR m ρ) * 10 ^ 7 * (Bb + 2) ^ 2 + 30 * (Bb + 2) ^ 2 := by ring
    rw [e1]; omega
  calc ((runsL C).map fun ρ => cCallR m ρ Bb (c0 ρ)).sum
      ≤ ((runsL C).map fun ρ => c0 ρ + (pushSz (chR m ρ) * 10 ^ 7 + 30) * (Bb + 2) ^ 2).sum :=
        List.sum_le_sum (fun ρ _ => h1 ρ)
    _ = ((runsL C).map c0).sum + KR C * (Bb + 2) ^ 2 := by
        rw [List.sum_map_add, KR, List.sum_map_mul_right]

theorem absB (gE gT cs cs0 lv kv v kl kr ke kt cqq r V e B b X : ℕ) (hb : b = B + 2) (hbX : b ≤ X)
    (hX1 : 1 ≤ X)
    (h1 : gE ≤ ke * ((e + 1) * X)) (h2 : gT ≤ cqq * (r + 1) * V + kt * ((r + 1) * X))
    (hr : r ≤ e) (h3 : cs ≤ cs0 + kr * X) (h4 : lv = kv * v + kl * 10 ^ 14 + kl * 10 ^ 11 * X) :
    gE + (3 * 2000 * b + (lv + cs + (2 * B + 2)) + 25 + gT) + 25 ≤
      cqq * (r + 1) * V + kv * v + cs0 + (ke + kt + kr + kl * (10 ^ 14 + 10 ^ 11) + 10 ^ 4) *
        ((e + 1) * X) := by
  have hXZ : X ≤ (e + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have g2 : kt * ((r + 1) * X) ≤ kt * ((e + 1) * X) :=
    Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (by omega))
  have g3 : kr * X ≤ kr * ((e + 1) * X) := Nat.mul_le_mul_left _ hXZ
  have g4 : kl * 10 ^ 11 * X ≤ kl * 10 ^ 11 * ((e + 1) * X) := Nat.mul_le_mul_left _ hXZ
  have g5 : kl * 10 ^ 14 ≤ kl * 10 ^ 14 * ((e + 1) * X) :=
    Nat.le_mul_of_pos_right _ (by have := Nat.mul_le_mul_left (e + 1) hX1; omega)
  have e1 : (ke + kt + kr + kl * (10 ^ 14 + 10 ^ 11) + 10 ^ 4) * ((e + 1) * X) =
      ke * ((e + 1) * X) + kt * ((e + 1) * X) + kr * ((e + 1) * X) +
      kl * 10 ^ 14 * ((e + 1) * X) + kl * 10 ^ 11 * ((e + 1) * X) + 10 ^ 4 * ((e + 1) * X) := by ring
  rw [e1]
  omega

theorem costN_le_big (C : Bit.QHNet (ZMod 2) W T m) (q Bb e V : ℕ) (hm : 1 ≤ m) (hme : m ≤ e) :
    costN C q Bb e V ≤ cq q * (e % m + 1) * V + Kv C * (V / W) +
      ((runsL C).map fun ρ => if h : ρ.2.2 * (e / m) < e then
        costN C q Bb (ρ.2.2 * (e / m)) (V / W) else 0).sum + KA C q * ((e + 1) * (Bb + 2) ^ 2) := by
  rw [costN_eq]
  unfold cGenL KA
  rw [if_pos hme]
  exact absB _ _ _ _ _ _ _ _ _ _ _ _ (e % m) V e Bb (Bb + 2) _ rfl (Nat.le_self_pow (n := 2) (by norm_num) _)
    (Nat.one_le_pow _ _ (by omega))
    (cGenE_le m q W T e Bb hm) (cTail_le q V Bb (e % m)) (Nat.mod_le _ _) (calls_le C Bb _)
    (by unfold levB uU Kv; ring)

theorem costN_le_small (C : Bit.QHNet (ZMod 2) W T m) (q Bb e V : ℕ) (hm : 1 ≤ m) (hme : ¬ m ≤ e) :
    costN C q Bb e V ≤ cq q * (e + 1) * V + KA C q * ((e + 1) * (Bb + 2) ^ 2) := by
  rw [costN_eq]
  unfold cGenL
  rw [if_neg hme]
  have hr : e % m = e := Nat.mod_eq_of_lt (by omega)
  have g1 := cGenE_le m q W T e Bb hm
  have g2 := cTail_le q V Bb (e % m)
  rw [hr] at g2 ⊢
  have hX : 1 ≤ (e + 1) * (Bb + 2) ^ 2 := Nat.mul_pos (by omega) (Nat.one_le_pow _ _ (by omega))
  have e2 : KA C q * ((e + 1) * (Bb + 2) ^ 2) = KE m q W T * ((e + 1) * (Bb + 2) ^ 2) +
      KT q * ((e + 1) * (Bb + 2) ^ 2) + KR C * ((e + 1) * (Bb + 2) ^ 2) +
      KL C * (10 ^ 14 + 10 ^ 11) * ((e + 1) * (Bb + 2) ^ 2) + 10 ^ 4 * ((e + 1) * (Bb + 2) ^ 2) := by
    unfold KA; ring
  rw [e2]
  omega

end

end IntMul.Kappa.R6.IL

