private def ExpTypeOnStrips (P : ℂ → ℂ) : Prop :=
  ∀ a b : ℝ, ∃ C A : ℝ, ∀ s : ℂ, a ≤ s.re → s.re ≤ b → ‖P s‖ ≤ C * Real.exp (A * |s.im|)

variable {f g : ℂ → ℂ}

private theorem expTypeOnStrips_of_boundedOnStrips (hf : BoundedOnStrips f) : ExpTypeOnStrips f := by
  intro a b
  obtain ⟨C, hC⟩ := hf a b
  exact ⟨C, 0, fun s ha hb => by simpa only [zero_mul, Real.exp_zero, mul_one] using hC s ha hb⟩

private theorem expTypeOnStrips_mul (hf : ExpTypeOnStrips f) (hg : ExpTypeOnStrips g) :
    ExpTypeOnStrips fun s => f s * g s := by
  intro a b
  obtain ⟨C, A, hC⟩ := hf a b
  obtain ⟨D, B, hD⟩ := hg a b
  refine ⟨C * D, A + B, fun s ha hb => (norm_mul_le _ _).trans ?_⟩
  rw [add_mul, Real.exp_add, mul_mul_mul_comm]
  exact mul_le_mul (hC s ha hb) (hD s ha hb) (norm_nonneg _) ((norm_nonneg _).trans (hC s ha hb))

private theorem exp_le_exp_mul_exp {A c x : ℝ} (hA : 0 ≤ A) (hc : 0 < c) (_hx : 0 ≤ x) :
    Real.exp (A * x) ≤ Real.exp (A / c * Real.exp (c * x)) := by
  refine Real.exp_le_exp.2 ?_
  have h1 : c * x ≤ Real.exp (c * x) := by
    have := Real.add_one_le_exp (c * x)
    linarith
  calc A * x = A / c * (c * x) := by rw [← mul_assoc, div_mul_cancel₀ A hc.ne']
    _ ≤ A / c * Real.exp (c * x) := mul_le_mul_of_nonneg_left h1 (div_nonneg hA hc.le)

end

section

private theorem prod_mul_tprod_eq_tprod {ι : Type*} (T : Finset ι) {F : ι → ℂ}
    (hF : Multipliable (F ∘ (↑) : ((↑T : Set ι)ᶜ : Set ι) → ℂ)) :
    (∏ i ∈ T, F i) * ∏' i : ((↑T : Set ι)ᶜ : Set ι), F i = ∏' i, F i :=
  ((T.hasProd F).mul_compl hF.hasProd).tprod_eq.symm

private theorem prod_mul_tprod_subtype_eq_tprod {ι : Type*} (T : Finset ι) {F : ι → ℂ}
    (hF : Multipliable fun i : {i // i ∉ T} => F i) :
    (∏ i ∈ T, F i) * ∏' i : {i // i ∉ T}, F i = ∏' i, F i :=
  prod_mul_tprod_eq_tprod T hF

end

