variable (P : PcpParams)
theorem flatBits_eq_bitsOf (v : Coord P → ((shoupBinField k hk)).carrier) :
    flatBits P hk v = bitsOf (((shoupBinField k hk)).vecBits (ptOf6 P v), ((shoupBinField k hk)).vecBits (dirOf6 P v),
