noncomputable def clauseHasDistinctVariables (c : ThreeClause) : Bool :=
  @decide (
  Function.Injective (fun i : Fin 3 => (c i).1)
  ) (Classical.propDecidable _)
noncomputable def literalSatisfied (assignment : ℕ → Bool) (l : Literal) : Bool :=
