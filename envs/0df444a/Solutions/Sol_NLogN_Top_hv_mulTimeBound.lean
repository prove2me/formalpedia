section Sim

variable (code : ℕ → Instr S) (L) (pc0 : Fin L) (inp : ℕ → Γ L)

theorem sim_push (c : Cfg S) (hpc : c.pc < L) (i : Fin S) (x : Sym) (e : ℕ) (he : e < L)
    (hcode : code c.pc = .push i x e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 2 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ.push i x, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨c.pc, hpc⟩, true), wr1 (NLogN.enc inp c).read (tst i) ((NLogN.enc inp c).read (tst i)) Move.right) := by
    simp [progOf, δf, hcode]
  refine Reach.step h1 ?_
  rw [fix_wr1 _ _ _ _ (Or.inl ⟨rfl, by simp⟩), write_wr1]
  simp only [Tapes.read, Function.update_eq_self, moveHead]
  set T1 : Tapes (Γ L) (S + 3) := ⟨(NLogN.enc inp c).cells,
    Function.update (NLogN.enc inp c).head (tst i) ((NLogN.enc inp c).head (tst i) + 1)⟩ with hT1
  have hr : T1.read (tst i) = gbl := by
    simp only [hT1, Tapes.read, Function.update_self, enc_cells_tst, enc_head_tst]
    have := tapeOf_after ((c.σ.stk i).map (gsym (L := L))).reverse
    simpa using this
  have h2 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, true) T1.read =
      some ((⟨e, he⟩, false), wr1 T1.read (tst i) (gsym x) Move.stay) := by
    simp [progOf, δf, hcode, toPc, he]
  refine Reach.step h2 ?_
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp, by rw [hr]; exact gbl_ne_gst, gsym_ne_gst x⟩), write_wr1]
  apply Reach.refl_of_eq
  apply enc_eq_of <;> simp [hT1, St.push, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
  · intro j
    split_ifs with hj
    · subst hj; exact tapeOf_push_stk _ _
    · rfl
  · intro j
    split_ifs with hj
    · subst hj; rfl
    · rfl

theorem fix_stayAll {k : ℕ} (a : Fin k → Γ L) : fix gst a (stayAll a) = stayAll a := by
  apply fix_eq_of; intro l; left; simp [stayAll]

theorem write_stayAll {k : ℕ} (T : Tapes (Γ L) k) : T.write (stayAll T.read) = T := by
  apply Tapes.ext' <;> funext l <;> simp [Tapes.write, stayAll, Tapes.read, moveHead]

