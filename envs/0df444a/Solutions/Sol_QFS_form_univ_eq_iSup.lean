variable {d : ℕ}

/-- The `H_k` form on `ℝ^d` is the supremum of the forms on balls about the
origin. -/
theorem solution (k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞)
    (f : EuclideanSpace ℝ (Fin d) → ℝ) :
    QFS.form Set.univ k f = ⨆ n : ℕ, QFS.form (ball (0 : EuclideanSpace ℝ (Fin d)) ((n : ℝ) + 1)) k f :=
  QFS.lintegral_univ_prod_eq_iSup _
