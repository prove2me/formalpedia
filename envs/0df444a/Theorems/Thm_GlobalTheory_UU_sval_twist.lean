theorem GlobalTheory.UU.sval_twist {W : Type} [CommRing W] [Algebra R W] {k : ℕ} (a : Multiplicative D.X →* Wˣ)
    (f : ∀ α, SecBT D (TA R W) k α) (α : D.X) {Z : Scheme.{0}} (r : Z ⟶ (TA R W ⊗ D.P.A).left) (z : Z) {J}
    (hJ : Good D.P.L z J) :
    sval (twist a f α) r z J =
      gs r z ⊤ (scal (R := W) (fst (TA R W) D.P.A).left (a (Multiplicative.ofAdd α)).val) * sval (f α) r z J := by sorry
