def rootSwapExteriorHodgeSign {r k : ℕ}
    {lam : Fin (r + 1) → ℕ}
    (S : AdmissibleRootWedge lam k)
    (α β : PositiveRoot r) : ℝ :=
  realExteriorRootSign S.val.val α *
    realExteriorRootSign (insert β (S.val.val.erase α)) β
