-- title:
--   Appendix A.1: single-qubit marginal exclusion test
-- statement:
--   Let $\nu$ be any normalized Pauli law on $N$ qubits, and fix one physical qubit $j$. If the full law is generated by independent Bernoulli Pauli events, then its single-qubit marginal $\nu_j$ also has an independent-event representation. Hence
--
--   $$\widehat\nu_j(X)\widehat\nu_j(Y)\widehat\nu_j(Z)<0
--   \quad\Longrightarrow\quad\nu\text{ has no independent-event representation}.$$
--
--   The events may have support on several qubits, and no independence of the physical-qubit marginals is assumed. This provides a local exclusion test for a global event model.
-- source:
--   Hierarchy of Rényi Coherent Information in Stabilizer Codes, arXiv:2609.11930v1, PDF p. 9, Appendix A.1: single-qubit marginal exclusion test

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P39

noncomputable section

namespace QAlgorithms.Papers.Independent.Information100.P39

open scoped Matrix ComplexConjugate

attribute [local instance] Classical.propDecidable

/-- Appendix A.1, PDF p.9: a negative marginal Fourier product excludes all
independent-event representations, including those with multi-qubit events. -/
theorem marginalExclusion {N : ℕ} (nu : PauliLabel N → ℝ)
    (hnu : Learning.IsDistribution nu) (j : Fin N) :
    (HasIndependentEvents nu → HasIndependentEvents (pauliMarginal nu j)) ∧
    (SparsePauliNoise.eigenvalueWHT (pauliMarginal nu j) labelX *
      SparsePauliNoise.eigenvalueWHT (pauliMarginal nu j) labelY *
      SparsePauliNoise.eigenvalueWHT (pauliMarginal nu j) labelZ < 0 →
      ¬ HasIndependentEvents nu) := by sorry

end QAlgorithms.Papers.Independent.Information100.P39

end
