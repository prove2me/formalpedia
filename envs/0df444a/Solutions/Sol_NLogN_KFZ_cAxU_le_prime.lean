theorem fmB_mono {m n : ℕ} (h : m ≤ n) : fmB m ≤ fmB n := by
  have e1 : zsz ((m + 1 : ℕ) : ℤ) ≤ zsz ((n + 1 : ℕ) : ℤ) := zsz_natCast_le (by omega)
  have e2 : zsz (((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) ≤
      zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) :=
    zsz_natCast_le (Nat.pow_le_pow_left (by omega) 4)
  unfold fmB
  gcongr

end NLogN.KFM

