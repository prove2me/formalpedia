    (by decide) (by decide) s1 (bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) [] (F 44))
    (.reg 31) (clean_reg (by decide)) (isInt_encK q31) (zLs (fA q s)) L30 (by rw [bS_30, h30])
