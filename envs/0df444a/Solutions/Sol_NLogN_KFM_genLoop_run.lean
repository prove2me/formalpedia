      · by_cases hj' : j = a
        · subst hj'; simp [NLogN.KFM.lpSt, NLogN.IState.upd_G, hj, NLogN.KFM.accSeq]
        · simp [NLogN.KFM.lpSt, NLogN.IState.upd_G, hj, hj'])
  rw [hN, Int.toNat_natCast] at hinv
  refine ⟨⟨hi56, hn, hnok, by rw [hN]; positivity, hw, fun k hk => ?_⟩, ?_⟩
