theorem solution (htop : IsAdic (IsLocalRing.maximalIdeal O)) (n : ℕ) :
    TypeDensity.coefficientMeasure O n {a | ¬ (TypeDensity.monicPolynomial O a).Separable} = 0 := by
  obtain ⟨a₀, h₀⟩ := TypeDensity.exists_separable_monic O n
  have hdeg := fun a => TypeDensity.monic_polynomial_degree O n a
  refine measure_mono_null (fun a ha => ?_) (TypeDensity.coefficientMeasure_zero_null O htop n
    (MvPolynomial.map (Int.castRingHom O) (TypeDensity.discMonic n)) a₀ ?_)
  · simp only [Set.mem_ofPred_eq] at ha ⊢
    by_contra hne
    apply ha
    refine TypeDensity.separable_of_resultant _ n (hdeg a).2 (hdeg a).1.ne_zero ?_
    rw [TypeDensity.monic_resultant_eq]
    exact fun h => hne ((IsFractionRing.injective O (TypeDensity.BaseField O)) (by rw [h, map_zero]))
  · have := TypeDensity.resultant_ne_zero_of_separable _ n (hdeg a₀).2 (hdeg a₀).1.ne_zero h₀
    rw [TypeDensity.monic_resultant_eq] at this
    exact fun h => this (by rw [h, map_zero])
