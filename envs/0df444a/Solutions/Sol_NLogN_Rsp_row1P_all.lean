set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

theorem push_run_val (i : Fin HS) (e : Ex HS) (s : IState HS) (v : ℤ) (h : e.eval s = v) :
    (push i e).run s = s.upd i (.int v :: s.G i) := by
  show s.upd i (.int (e.eval s) :: s.G i) = _; rw [h]

theorem pop_run_val (i : Fin HS) (s : IState HS) (x : Item) (L : List Item) (h : s.G i = x :: L) :
    (pop i).run s = s.upd i L := by
  show s.upd i (s.G i).tail = _; rw [h]; rfl

end NLogN.Rsp

end

