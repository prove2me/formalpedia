theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (k : Type) [Field k] [IsAlgClosed k] (p : ℕ) [Fact p.Prime] [CharP k p] (hp : p = q ∨ p = q')
    (E : FakeEllipticCurve Λ 1 k) :
    ∃ (R : Type) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (_ : CharZero R) (φ : R →+* k),
      Function.Surjective φ ∧ IsAdicComplete (IsLocalRing.maximalIdeal R) R ∧
      ∃ E_R : FakeEllipticCurve Λ 1 R, FakeEllipticCurve.IsPullback φ E_R E := by
  classical

  have hpk : ((p : ℕ) : k) = 0 := CharP.cast_eq_zero k p
  have hnilk : IsNilpotent ((p : ℕ) : k) := ⟨1, by rw [pow_one, hpk]⟩
  have h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ := hΛ.1.one_mem

  obtain ⟨Onr, _i1, _i2, _i3, _i4, _i5, hOc, hOmax, e, ι, O', _j1, _j2, _j3, _j4, _j5, hO'c, ϖ, hϖ, hϖsq, φ', hφ's, hφ'c⟩ :=
    WittVector.exists_isDiscreteValuationRing_charZero_residueField_ringEquiv_ringHom_and_sq_eq_of_isAlgClosed p k
  haveI : IsAlgClosed (IsLocalRing.ResidueField Onr) := IsAlgClosed.of_ringEquiv k _ e.symm
  have hmOnr : IsLocalRing.maximalIdeal Onr = Ideal.span {algebraMap ℤ_[p] Onr (p : ℤ_[p])} :=
    (IsLocalRing.eq_maximalIdeal hOmax).symm
  haveI hOc' : IsAdicComplete (IsLocalRing.maximalIdeal Onr) Onr := by rw [hmOnr]; exact hOc
  have hkerφ : RingHom.ker φ' = IsLocalRing.maximalIdeal O' :=
    IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective φ' hφ's)
  have hφ'max : ∀ x, x ∈ IsLocalRing.maximalIdeal O' ↔ φ' x = 0 := fun x => by rw [← hkerφ, RingHom.mem_ker]
  have eO' : IsLocalRing.ResidueField O' ≃+* k :=
    RingEquiv.ofBijective (Ideal.Quotient.lift (IsLocalRing.maximalIdeal O') φ' (fun x hx => (hφ'max x).1 hx))
      ⟨by
        intro x y hxy
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        have h' : φ' x = φ' y := hxy
        exact (Ideal.Quotient.eq (I := IsLocalRing.maximalIdeal O')).mpr ((hφ'max _).2 (by rw [map_sub, sub_eq_zero]; exact h')),
       Ideal.Quotient.lift_surjective_of_surjective _ _ hφ's⟩
  haveI : IsAlgClosed (IsLocalRing.ResidueField O') := IsAlgClosed.of_ringEquiv k _ eO'.symm
  have hpO' : ((p : ℕ) : O') ∈ IsLocalRing.maximalIdeal O' := by
    have : ((p : ℕ) : O') = ϖ * ϖ := by rw [hϖsq, map_natCast]
    rw [this]; exact Ideal.mul_mem_left _ _ hϖ

  obtain ⟨coord, hcoord⟩ : ∃ coord : ↥Λ → Zp2 p × Zp2 p, IsOrderCoord Λ p coord := by
    have hB' : IsIndefiniteRamifiedExactlyAt a b q' q := ⟨hB.1, fun v => (hB.2 v).trans or_comm⟩
    rcases hp with h | h <;> subst h
    · exact CerednikDrinfeld.QM.exists_isOrderCoord_of_isMaximalOrder hB Λ hΛ
    · exact CerednikDrinfeld.QM.exists_isOrderCoord_of_isMaximalOrder hB' Λ hΛ

  obtain ⟨XE, θE, hXE⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleOf_of_isLocalRing coord hcoord k hnilk E
  letI algκ : Algebra k (IsLocalRing.ResidueField Onr) := e.symm.toRingHom.toAlgebra
  have hnilκ : IsNilpotent ((p : ℕ) : IsLocalRing.ResidueField Onr) :=
    ⟨1, by rw [pow_one, ← map_natCast (algebraMap k (IsLocalRing.ResidueField Onr)), hpk, map_zero]⟩
  obtain ⟨Eκ, gκ, hgκ, hmulκ, hactκ, hlevκ, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (algebraMap k (IsLocalRing.ResidueField Onr)) E
  obtain ⟨θκ, hθκ, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord k
      (IsLocalRing.ResidueField Onr) E Eκ gκ ⟨hgκ, hmulκ, hactκ, hlevκ⟩ XE θE hXE
  have hspec := CerednikDrinfeld.QM.FakeEllipticCurve.IsFormalModuleOf.isSpecial coord hcoord (IsLocalRing.ResidueField Onr) hnilκ
    ((IsLocalRing.residue Onr).comp ι) Eκ _ ⟨θκ, hθκ⟩
  have hht := CerednikDrinfeld.QM.FakeEllipticCurve.hasHeight_four_of_isFormalModuleVia_of_one_mem coord hcoord h1
    (IsLocalRing.ResidueField Onr) hnilκ Eκ _ θκ hθκ
  let X₀ : SpecialFormalODModule p ((IsLocalRing.residue Onr).comp ι) := ⟨XE.map (algebraMap k (IsLocalRing.ResidueField Onr)), hspec, hht⟩

  obtain ⟨Rh, _r1, _r2, _r3, _r4, hRc, resR, hresR, Xu, wu, hwu, hPRO⟩ :=
    CerednikDrinfeld.SpecialFormalODModule.exists_isProrepresentedBy_deformations Onr ι X₀
  obtain ⟨χ, hχ⟩ :=
    CerednikDrinfeld.SpecialFormalODModule.exists_algHom_map_maximalIdeal_of_mul_self_eq_of_isProrepresentedBy_deformations
      Onr hOc hOmax ι X₀ Rh resR hresR Xu wu hwu hPRO O' ϖ hϖ hϖsq

  let resO : O' →+* IsLocalRing.ResidueField Onr := e.symm.toRingHom.comp φ'
  have hresO_alg : resO.comp (algebraMap Onr O') = IsLocalRing.residue Onr := by
    change e.symm.toRingHom.comp (φ'.comp (algebraMap Onr O')) = _
    rw [hφ'c]; ext x; simp
  have hcompat : resO.comp χ.toRingHom = resR := by
    refine ringHom_eq_of_local (IsLocalRing.residue Onr) Ideal.Quotient.mk_surjective resR _ hresR ?_ ?_
    · ext x
      change resO (χ (algebraMap Onr Rh x)) = _
      rw [χ.commutes]; exact DFunLike.congr_fun hresO_alg x
    · intro x hx
      change e.symm (φ' (χ x)) = 0
      rw [(hφ'max _).1 (hχ x hx), map_zero]

  have hle : ∀ n : ℕ, IsLocalRing.maximalIdeal O' ^ (n + 1 + 1) ≤ IsLocalRing.maximalIdeal O' ^ (n + 1) :=
    fun n => Ideal.pow_le_pow_right (Nat.le_succ _)
  let π : ∀ n : ℕ, (O' ⧸ IsLocalRing.maximalIdeal O' ^ (n + 1 + 1)) →+* (O' ⧸ IsLocalRing.maximalIdeal O' ^ (n + 1)) :=
    fun n => Ideal.Quotient.factor (hle n)
  have hπ : ∀ n, (π n).comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O' ^ (n + 1 + 1))) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal O' ^ (n + 1)) := fun n => Ideal.Quotient.factor_comp_mk (hle n)
  let X : ∀ n : ℕ, FormalODModule p (O' ⧸ IsLocalRing.maximalIdeal O' ^ (n + 1)) :=
    fun n => Xu.map ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal O' ^ (n + 1))).comp χ.toRingHom)
  have hX : ∀ n, (X (n + 1)).map (π n) = X n := fun n => by
    change (Xu.map ((Ideal.Quotient.mk _).comp χ.toRingHom)).map (π n) = Xu.map _
    rw [FormalODModule.map_map, ← RingHom.comp_assoc, hπ]

  have hpow1 : IsLocalRing.maximalIdeal O' ^ (0 + 1) = RingHom.ker φ' := by rw [zero_add, pow_one, hkerφ]
  obtain ⟨ψ₀, hψ₀mk⟩ : ∃ ψ : (O' ⧸ IsLocalRing.maximalIdeal O' ^ (0 + 1)) ≃+* k, ∀ x : O', ψ (Ideal.Quotient.mk _ x) = φ' x :=
    ⟨RingEquiv.ofBijective (Ideal.Quotient.lift (IsLocalRing.maximalIdeal O' ^ (0 + 1)) φ'
        (fun x hx => by rwa [hpow1, RingHom.mem_ker] at hx))
      ⟨by rw [RingHom.injective_iff_ker_eq_bot, Ideal.ker_quotient_lift, ← hpow1, Ideal.map_quotient_self],
       Ideal.Quotient.lift_surjective_of_surjective _ _ hφ's⟩, fun x => rfl⟩
  have hψ₀comp : ψ₀.toRingHom.comp (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O' ^ (0 + 1))) = φ' := RingHom.ext hψ₀mk
  obtain ⟨E₀, g₀, hg₀, hmul₀, hact₀, hlev₀, hlev₀'⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff ψ₀.symm.toRingHom E
  letI algB₀ : Algebra k (O' ⧸ IsLocalRing.maximalIdeal O' ^ (0 + 1)) := ψ₀.symm.toRingHom.toAlgebra
  obtain ⟨θ₀', hθ₀', -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord k
      (O' ⧸ IsLocalRing.maximalIdeal O' ^ (0 + 1)) E E₀ g₀ ⟨hg₀, hmul₀, hact₀, hlev₀⟩ XE θE hXE

  let τ : IsLocalRing.ResidueField Onr →+* (O' ⧸ IsLocalRing.maximalIdeal O' ^ (0 + 1)) :=
    (algebraMap k (O' ⧸ IsLocalRing.maximalIdeal O' ^ (0 + 1))).comp e.toRingHom
  have hmk0χ : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O' ^ (0 + 1))).comp χ.toRingHom = τ.comp resR := by
    rw [← hcompat]; ext x
    change Ideal.Quotient.mk _ (χ x) = ψ₀.symm (e (e.symm (φ' (χ x))))
    rw [RingEquiv.apply_symm_apply, ← hψ₀mk, RingEquiv.symm_apply_apply]
  have hX0 : X 0 = (Xu.map resR).map τ := by
