      (L.length * (110 * (B + 1) + 64) + 60 + cRpt L.length) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd pO (ints (L.drop k) ++ LO)).upd 0 (ints (L.take k).reverse ++ s.G 0)
  have h := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) mvB
    (110 * (B + 1))
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have H := IRuns.mv (I := I) (iprog := iprog) (s := cf3 (T k) pA pC pD LA LC LD) (i := pO)
        (j := 0) (a := L[k]) (L := ints (L.drop (k + 1)) ++ LO) (by decide)
        (by simp +decide only [T, cf3, IState.upd_G, if_true, if_false]; rw [hd]; rfl)
      refine H.mono' ?_ ?_
      · have ht : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have e2 : ints (L.take (k + 1)).reverse = .int L[k] :: ints (L.take k).reverse := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear H e2 ht hd
        ((apply NLogN.IState.ext' <;> intros <;>
                 simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
               split_ifs <;>
             simp_all +decide))
      · have := moveIntCost_le (zsz L[k]); omega)
  have e0 : T 0 = s := by
