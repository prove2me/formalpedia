-- title:
--   Algorithm 1: pinning, adaptive updates, suffix certificates, and stopping
-- statement:
--   A round begins with total weight $Q$, rate $s_r$, and stored profile/multiplier pairs. The weight of an arriving edge is recomputed as $q_e=\prod_{j<r:e\text{ fails }d_j}\mu_j$. With a sampled set $F_r$, the stored local graph is $G_r=H\cup P_{r-1}\cup F_r$. Its local shortest-path computation produces $d_r,T_r$ and retains the tree, discarding other sample edges.
--
--   Pass B computes $B_r$, $W_r=\sum_{e\in B_r}q_e$, $\rho_r=W_r/Q$, and every nonempty suffix certificate
--
--   $$\kappa_S=\max_{e\in E}\frac1{|S|}\sum_{j\in S}J(e;d_j).$$
--
--   The stop test is $W_r=0$ or some suffix having $\kappa_S\le\varepsilon$, evaluated before any update. Otherwise a bulk round has $|B_r|\le s/2$ and stores its violators, sets $\mu_r=1$, leaves $Q$ unchanged, and uses rate $s-|B_r|$ next round. A non-bulk round instead sets
--
--   $$\mu_r=\max\{1+\max(1/r,\varepsilon/(10k))/\rho_r,\,1+n^{1/k}\},\quad c_r=(\mu_r-1)\rho_r,$$
--
--   updates $Q$ to $(1+c_r)Q$, and restores rate $s$. Initially $P_0=\varnothing$, $Q=m$, and the rate is $s$.
--
--   The deterministic virtual recursion retains the pre-update stopping flag, then continues the stated updates for analysis. Its actual execution is the prefix through the first flag; the terminal virtual update and all later rounds are not executed. A reachable prehistory is generated by these transition equations with no earlier stop. It contains no monotonicity, sampling bound, successful termination, failure-count bound or resource bound as a hypothesis. Sample sets recorded in round traces are ghost data: later transitions never consult them. Only profiles, multipliers, trees and committed bulk pins are physical retained data.
-- source:
--   Sarwan Ali, STOC 2027 submission #517 (October 2026), pp. 5–6, §3.2, equation (1), Algorithm 1 lines 1–6; p. 18, Appendix A.5 virtual continuation

import Definitions.Def_PaceSSSP517_Certified_Graph

set_option autoImplicit false
open scoped ENNReal NNReal
open Classical

namespace PaceSSSP517.Certified

/-- A round record. Its profile, multiplier and tree are retained. `bulk`, `c` and
`stopping` are scalar metadata; violators and weights are recomputed, not arrays.
For the virtual continuation only, updates are carried out even if `stopping` holds. -/
structure Round (n : ℕ) where
  /-- Ghost trace of Pass A, freed after that pass; never used by later transitions. -/
  sample : Finset (Edge n)
  d : Fin n → ℝ
  tree : Finset (Edge n)
  bulkPins : Finset (Edge n)
  mu : ℝ
  c : ℝ
  bulk : Bool
  stopping : Bool

structure State (n : ℕ) where
  rounds : List (Round n)
  Q : ℝ
  rate : ℝ

noncomputable def violators {n : ℕ} (G : WeightedGraph n) (d : Fin n → ℝ) : Finset (Edge n) := by
  classical
  exact G.edges.filter (fails G d)

/-- Recomputed from distance vectors, never an m-entry stored table. -/
noncomputable def edgeWeight {n : ℕ} (G : WeightedGraph n) (a : State n) (e : Edge n) : ℝ :=
  (a.rounds.map (fun t => if fails G t.d e then t.mu else 1)).prod

/-- The virtual retained set. Actual execution is its prefix through the first stop;
the terminal round's virtual bulk update is never performed by the implementation. -/
noncomputable def pinned {n : ℕ} (_G : WeightedGraph n) (a : State n) : Finset (Edge n) := by
  classical
  exact a.rounds.foldl (fun P t => P ∪ t.tree ∪ t.bulkPins) ∅

noncomputable def initial {n : ℕ} (G : WeightedGraph n) (k : ℕ) (ε : ℝ) : State n :=
  ⟨[], G.edges.card, budget n k ε⟩

/-- One-based round sets; `getD` is only used with indices proved to be in range. -/
def past (r : ℕ) : Finset ℕ := Finset.Icc 1 r

/-- Default used only outside the theorem's one-based in-range indices. -/
def roundAt {n : ℕ} (ts : List (Round n)) (j : ℕ) : Round n :=
  ts.getD (j - 1) ⟨∅, (fun _ => 0), ∅, ∅, 1, 0, false, false⟩

noncomputable def profile {n : ℕ} (ts : List (Round n)) (j : ℕ) (x : Fin n) : ℝ :=
  ((ts.map Round.d).getD (j - 1) (fun _ => 0)) x

noncomputable def windowAverage {n : ℕ} (ts : List (Round n)) (S : Finset ℕ)
    (x : Fin n) : ℝ := (∑ j ∈ S, profile ts j x) / S.card

/-- Finite maximum, with the value 0 when E is empty. J is nonnegative, so including
0 does not change any nonempty-edge maximum. Empty S has value 0 and is never tested. -/
noncomputable def kappa {n : ℕ} (G : WeightedGraph n) (ts : List (Round n))
    (S : Finset ℕ) : ℝ :=
  let values := G.edges.image (fun e => (∑ j ∈ S, jump G (profile ts j) e) / S.card)
  (insert 0 values).max' (Finset.insert_nonempty _ _)

/-- All nonempty suffixes, not the experimental geometric grid. -/
def suffixes (r : ℕ) : Finset (Finset ℕ) :=
  (Finset.Icc 1 r).image (fun L => Finset.Icc (r - L + 1) r)

noncomputable def stopTest {n : ℕ} (G : WeightedGraph n) (ε : ℝ)
    (ts : List (Round n)) (W : ℝ) : Prop :=
  W = 0 ∨ ∃ S ∈ suffixes ts.length, kappa G ts S ≤ ε

/-- A bounded Pass B buffer. Once full it is discarded for the rest of the pass. -/
noncomputable def bufferStep {n : ℕ} (G : WeightedGraph n) (s : ℝ) (d : Fin n → ℝ)
    (buf : Option (Finset (Edge n))) (e : Edge n) : Option (Finset (Edge n)) :=
  match buf with
  | none => none
  | some B => if fails G d e then
      if ((insert e B).card : ℝ) ≤ s / 2 then some (insert e B) else none
    else some B

/-- Physical streaming accumulator: one count, one weight sum, a bounded buffer,
and one scalar per suffix. It never contains the full set of violators. -/
structure FlagState (n r : ℕ) where
  count : ℕ
  W : ℝ
  buf : Option (Finset (Edge n))
  maxima : Fin r → ℝ

/-- One visit to an arriving edge in Pass B; all weight and jump queries use the
stored profiles. Window sums may be recomputed using scalar scratch. -/
noncomputable def flagStep {n : ℕ} (G : WeightedGraph n) (s : ℝ) (a : State n)
    (ts : List (Round n)) (z : FlagState n ts.length) (e : Edge n) : FlagState n ts.length :=
  let d := (roundAt ts ts.length).d
  let bad := fails G d e
  ⟨z.count + if bad then 1 else 0,
    z.W + if bad then edgeWeight G a e else 0,
    bufferStep G s d z.buf e,
    fun L => max (z.maxima L)
      ((∑ j ∈ Finset.Icc (ts.length - (L.val + 1) + 1) ts.length,
        jump G (profile ts j) e) / (L.val + 1 : ℕ))⟩

noncomputable def scanFlags {n : ℕ} (G : WeightedGraph n) (s : ℝ) (a : State n)
    (ts : List (Round n)) (σ : List (Edge n)) : FlagState n ts.length :=
  σ.foldl (flagStep G s a ts) ⟨0, 0, some ∅, fun _ => 0⟩

/-- Pass A subgraph for a sample; intersecting E is immaterial on the sample law. -/
noncomputable def roundGraph {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n))
    (a : State n) (F : Finset (Edge n)) : Finset (Edge n) :=
  H ∪ pinned G a ∪ (F ∩ G.edges)

noncomputable def freshProfile {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n))
    (s₀ : Fin n) (a : State n) (F : Finset (Edge n)) : Fin n → ℝ :=
  localProfile G (roundGraph G H a F) s₀

noncomputable def violatingWeight {n : ℕ} (G : WeightedGraph n) (a : State n)
    (d : Fin n → ℝ) : ℝ := ∑ e ∈ violators G d, edgeWeight G a e

noncomputable def fraction {n : ℕ} (G : WeightedGraph n) (a : State n)
    (d : Fin n → ℝ) : ℝ := violatingWeight G a d / a.Q

/-- Only called on non-bulk positive violating mass in legal trajectories. -/
noncomputable def multiplier (n k r : ℕ) (ε ρ : ℝ) : ℝ :=
  max (1 + max (1 / (r : ℝ)) (ε / (10 * k)) / ρ) (1 + root n k)

/-- Algorithm 1, including the stop test before its update. A record remembers that
stop decision. The post-test update is the explicit virtual continuation used in A.5;
`execution` below deletes all later rounds and the implementation ignores its terminal update. -/
noncomputable def advance {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n))
    (s₀ : Fin n) (k : ℕ) (ε : ℝ)
    (a : State n) (F : Finset (Edge n)) : State n :=
  let K := roundGraph G H a F
  let d := localProfile G K s₀
  let T := shortestTree G K s₀
  let proto : Round n := ⟨F ∩ G.edges, d, T, ∅, 1, 0, false, false⟩
  let ts := a.rounds ++ [proto]
  let flags := scanFlags G (budget n k ε) a ts G.edges.toList
  let W := flags.W
  let ρ := W / a.Q
  let bulk : Bool := decide ((flags.count : ℝ) ≤ budget n k ε / 2)
  let stopped : Bool := decide (W = 0 ∨ ∃ L : Fin ts.length, flags.maxima L ≤ ε)
  let μ := if bulk then 1 else multiplier n k (a.rounds.length + 1) ε ρ
  let c := if bulk then 0 else (μ - 1) * ρ
  let pins := if bulk then flags.buf.getD ∅ else ∅
  let t := {proto with mu := μ, c := c, bulk := bulk, stopping := stopped, bulkPins := pins}
  ⟨a.rounds ++ [t], (1 + c) * a.Q,
    if bulk then budget n k ε - flags.count else budget n k ε⟩

/-- Deterministic virtual run from a finite sample sequence. No analysis conclusions
are fields of this recursion. It agrees with Algorithm 1 until the first stop test. -/
noncomputable def trajectory {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n))
    (s₀ : Fin n) (k : ℕ) (ε : ℝ)
    (Fs : List (Finset (Edge n))) : State n :=
  Fs.foldl (advance G H s₀ k ε) (initial G k ε)

/-- Absorbing stopped output: the terminal round is retained, later rounds are not
executed. No stop by the horizon means this is the whole unfinished prefix. -/
def execution {n : ℕ} : List (Round n) → List (Round n)
  | [] => []
  | t :: ts => if t.stopping then [t] else t :: execution ts

/-- Support of the conditional Bernoulli choices, expressed without probability
infrastructure: an edge of probability one must occur, and one of probability zero
must not. All intermediate-probability choices are permitted. -/
noncomputable def SampleTrace {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n))
    (s₀ : Fin n) (k : ℕ) (ε : ℝ) (Fs : List (Finset (Edge n))) : Prop :=
  ∀ i < Fs.length,
    let a := trajectory G H s₀ k ε (Fs.take i)
    let F := Fs.getD i ∅
    F ⊆ G.edges ∧ ∀ e ∈ G.edges,
      (1 ≤ a.rate * edgeWeight G a e / a.Q → e ∈ F) ∧
      (a.rate * edgeWeight G a e / a.Q ≤ 0 → e ∉ F)

/-- Past rounds really preceding Pass A, excluding unreachable arbitrary profiles. -/
noncomputable def PreHistory {n : ℕ} (G : WeightedGraph n) (H : Finset (Edge n)) (s₀ : Fin n)
    (k : ℕ) (ε : ℝ) (a : State n) : Prop :=
  ∃ Fs, SampleTrace G H s₀ k ε Fs ∧
    a = trajectory G H s₀ k ε Fs ∧ ∀ t ∈ a.rounds, t.stopping = false

/-- Reconstructed Q and rho at each recorded round; these are ghost queries,
computed from old scalar multipliers and profiles, not persistent edge arrays. -/
noncomputable def Qat {n : ℕ} (G : WeightedGraph n) (ts : List (Round n)) (j : ℕ) : ℝ :=
  G.edges.card * ((ts.take (j - 1)).map (fun t => 1 + t.c)).prod

noncomputable def qat {n : ℕ} (G : WeightedGraph n) (ts : List (Round n))
    (j : ℕ) (e : Edge n) : ℝ :=
  ((ts.take (j - 1)).map (fun t => if fails G t.d e then t.mu else 1)).prod

noncomputable def rhoAt {n : ℕ} (G : WeightedGraph n) (ts : List (Round n)) (j : ℕ) : ℝ :=
  (∑ e ∈ violators G (roundAt ts j).d, qat G ts j e) / Qat G ts j

end PaceSSSP517.Certified


