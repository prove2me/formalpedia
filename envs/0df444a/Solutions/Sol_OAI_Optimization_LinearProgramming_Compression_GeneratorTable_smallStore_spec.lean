    hreg hs hone hv
  have a26 := (ai 26 (by decide)).trans h26
  let b := a.putData (a.index 26) (a.data 0)
  let t := b.putIndex 26 (b.index 26+1)
  have sb : ∀j,P (b.data j) := by
