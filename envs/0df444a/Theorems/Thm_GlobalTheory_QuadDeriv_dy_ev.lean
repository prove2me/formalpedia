theorem GlobalTheory.QuadDeriv.dy_ev {l : ℕ} (v : Fin d → k) (a : Fin l → Pt k 2 d) (ha : ∀ j, GP (a j)) (f : PS k l d) :
    dy v (ev a f) = ∑ j, ∑ i, dy v (a j i) *
      ev (fun j => evP (n := 1) ![pt k d 0, 0] (a j)) (pderiv k (j, i) f) := by sorry
