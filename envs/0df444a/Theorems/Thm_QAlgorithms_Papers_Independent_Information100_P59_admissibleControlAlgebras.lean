-- title:
--   Remark 3.2: admissible control algebras
-- statement:
--   Given a finite list of bidirectional qubit coherent controls with axes in $\mathbb R^3$, form the real Lie algebra generated by $J_n v=n\times v$. It is one of
--
--   $$\{0\},\qquad\mathbb R J_n\text{ for a unit axis }n,\qquad\mathfrak{so}(3).$$
--
--   The zero alternative includes the empty coherent list. The axial alternative is the rotation algebra about one axis; the full alternative is the space spanned by all rotation generators. This excludes an omitted two-dimensional coherent-control case.
-- source:
--   Lie-Wedge Stratification and Pure-State Stabilizability in Single- Channel Qubit Control, arXiv:2610.00046v1, PDF p. 9, Remark 3.2

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P59

noncomputable section

open scoped Matrix ComplexOrder

namespace QAlgorithms.Papers.Independent.Information100.P59

attribute [local instance 100] LieRing.ofAssociativeRing

/-- arXiv:2610.00046v1 PDF p.9, Remark 3.2. The control algebra is computed
from the finite coherent generating list; no menu hypothesis is imposed on that list. -/
theorem admissibleControlAlgebras (axes : Finset Vec) :
    let C := LieSubalgebra.lieSpan ℝ Mat (rotationGenerator '' (axes : Set Vec))
    C.toSubmodule = ⊥ ∨
      (∃ n : Vec, (∑ j, n j^2) = 1 ∧
        C.toSubmodule = Submodule.span ℝ {rotationGenerator n}) ∨
      C.toSubmodule = Submodule.span ℝ (Set.range rotationGenerator) := by sorry

end QAlgorithms.Papers.Independent.Information100.P59

end
