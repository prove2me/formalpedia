-- title:
--   Completed lattices, quaternion ideal classes, and the independent Hecke operator
-- statement:
--   Finite places are the nonzero prime ideals of $O_F$. Their completed fields and integer rings are Mathlib's adic completions. A full lattice is a finitely generated module spanning its quaternion algebra; completion is closure of its diagonal image in the coordinate topology. Orders are multiplicatively closed full lattices containing $1$.
--
--   Right ideals, local principality, left orders, scalar units, and Eichler level are defined independently of graph coordinates. The reduced norm of an ideal is the $O_F$-submodule of $F$ generated by its element norms. Quaternion ideal classes identify $I$ and $xI$ for $x\in D^\times$; $\mathrm{Cl}(A)$ restricts these classes to locally principal right $A$-ideals. Narrow class number one requires every nonzero integral ideal to have a totally positive generator.
--
--   The prime ideals are $Q=(2,\omega)$ and $P=(p,\omega-s_p)$. A $P$-neighbor $J$ of $I$ is locally principal, contained in $I$, unchanged at other finite places, and has $\operatorname{nrd}(J)=P\operatorname{nrd}(I)$. The Hecke operator is the sum over these actual ideals:
--   $$ (T_Ph)([I])=\sum_{J\text{ a }P\text{-neighbor of }I}h([J]). $$
--   It is not defined using the graph transformations. The named coordinate ideal is the intersection of the completed lattices represented by the translation $\left(\begin{smallmatrix}1&2t\\0&1\end{smallmatrix}\right)$ at $Q$ and the identity elsewhere.
--
--   **Formalization Note** Ideal classes use the quotient of the orbit relation on sets, followed by a subtype for locally principal ideals. Norm fractional ideals are represented as submodules in $F$. The unit reduced-discriminant condition is encoded equivalently by the unit trace-discriminant ideal. Finite-neighbor conclusions guard the finite-support sum.
-- source:
--   Olga Kharlampovich, Igor Pak, Alina Vdovina, STOC 2027 submission #136 (October 2026), source.pdf SHA-256 27d691a82d8af863e511e7e6b00cee95779d914645846d2974f876836db8f83b, p.10 (PDF p.11), §3.4–§3.7; §4, definition preceding Proposition 4.2; (3.13). https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/136.pdf

import Definitions.Def_RamanujanLiftTower136_Tower_Construction

noncomputable section

namespace RamanujanLiftTower136.Tower
open scoped Quaternion
open Classical
open IsDedekindDomain

abbrev Place := HeightOneSpectrum OF
abbrev LocalField (R : Place) := R.adicCompletion F
abbrev LocalIntegers (R : Place) := R.adicCompletionIntegers F
abbrev LocalD (R : Place) := ℍ[LocalField R, -1, -3]
instance localTopology (R : Place) : TopologicalSpace (LocalD R) :=
  TopologicalSpace.induced (QuaternionAlgebra.equivTuple (-1 : LocalField R) 0 (-3)).toFun inferInstance
instance localIntegersAlgebra (R : Place) : Algebra (LocalIntegers R) (LocalD R) :=
  Algebra.compHom (LocalD R) (algebraMap (LocalIntegers R) (LocalField R))

def localize (R : Place) (x : D) : LocalD R :=
  ⟨algebraMap F (LocalField R) x.re, algebraMap F (LocalField R) x.imI,
    algebraMap F (LocalField R) x.imJ, algebraMap F (LocalField R) x.imK⟩
def completed (A : Set D) (R : Place) : Set (LocalD R) := closure (localize R '' A)
def fullLattice (A : Set D) : Prop :=
  ∃ L : Submodule OF D, (L : Set D) = A ∧ L.FG ∧ Submodule.span F A = ⊤
def localFullLattice (R : Place) (A : Set (LocalD R)) : Prop :=
  ∃ L : Submodule (LocalIntegers R) (LocalD R), (L : Set (LocalD R)) = A ∧ L.FG ∧
    Submodule.span (LocalField R) A = ⊤
def isOrder (A : Set D) : Prop := fullLattice A ∧ 1 ∈ A ∧ ∀ x ∈ A, ∀ y ∈ A, x*y ∈ A
def maximalOrder (A : Set D) : Prop := isOrder A ∧ ∀ B, isOrder B → A ⊆ B → B = A

def Q : Ideal OF := Ideal.span {x | algebraMap OF F x = 2 ∨ algebraMap OF F x = omega}
def P (p : ℕ) : Ideal OF := Ideal.span {x | algebraMap OF F x = (p : F) ∨
  algebraMap OF F x = omega - (smallerRoot p : F)}
def principalIdeal (x : F) : Submodule OF F := Submodule.span OF {x}
def idealAsModule (I : Ideal OF) : Submodule OF F :=
  Submodule.span OF (algebraMap OF F '' (I : Set OF))
def idealNorm (I : Set D) : Submodule OF F := Submodule.span OF (nrd '' I)
def rightIdeal (A I : Set D) : Prop :=
  fullLattice I ∧ ∀ x ∈ I, ∀ a ∈ A, x*a ∈ I
def localRightIdeal (R : Place) (A I : Set (LocalD R)) : Prop :=
  localFullLattice R I ∧ ∀ x ∈ I, ∀ a ∈ A, x*a ∈ I

def locallyPrincipal (A I : Set D) : Prop := rightIdeal A I ∧
  ∀ R : Place, ∃ x : (LocalD R)ˣ, completed I R = (fun a => (x : LocalD R)*a) '' completed A R

def leftOrder (I : Set D) : Set D := {x | ∀ y ∈ I, x*y ∈ I}
def orderUnit (A : Set D) (x : Dˣ) : Prop := (x : D) ∈ A ∧ ((x⁻¹ : Dˣ) : D) ∈ A
def onlyScalarUnits (A : Set D) : Prop :=
  ∀ x : Dˣ, orderUnit A x ↔ ∃ a : OFˣ, (x : D) = scalar (algebraMap OF F (a : OF))
def narrowClassOne : Prop :=
  ∀ I : Ideal OF, I ≠ ⊥ → ∃ x : F, totallyPositive x ∧ idealAsModule I = principalIdeal x

def idealEquivalent (I J : Set D) : Prop := ∃ x : Dˣ, J = (fun a => (x : D)*a) '' I
abbrev IdealClass := Quot idealEquivalent
def idealClass (I : Set D) : IdealClass := Quot.mk _ I
def classSet (A : Set D) : Set IdealClass := {c | ∃ I, locallyPrincipal A I ∧ idealClass I = c}
abbrev ClassSet (A : Set D) := {c : IdealClass // c ∈ classSet A}

def localConjugate (R : Place) (A B : Set (LocalD R)) : Prop :=
  ∃ x : (LocalD R)ˣ, A = (fun a => (x : LocalD R)*a*((x⁻¹ : (LocalD R)ˣ) : LocalD R)) '' B

def localStandard (R : Place) (m : ℕ) : Set (Matrix (Fin 2) (Fin 2) (LocalField R)) :=
  {a | (∀ i j, a i j ∈ R.adicCompletionIntegers F) ∧
    ∃ c : LocalIntegers R, a 1 0 = (2 : LocalField R)^m*(c : LocalField R)}
def eichlerLevel (A : Set D) (m : ℕ) : Prop := isOrder A ∧
  (∃ M N, maximalOrder M ∧ maximalOrder N ∧ A = M ∩ N) ∧
  (∀ R : Place, R.asIdeal = Q → ∃ e : LocalD R ≃ₐ[LocalField R] Matrix (Fin 2) (Fin 2) (LocalField R),
    e '' completed A R = localStandard R m) ∧
  (∀ R : Place, R.asIdeal ≠ Q → localConjugate R (completed A R) (completed (orderLattice : Set D) R))

/-- Unit trace discriminant is equivalent to unit reduced discriminant for an order. -/
def unitDiscriminant (A : Set D) : Prop :=
  Submodule.span OF {d : F | ∃ b : Fin 4 → D, (∀ i, b i ∈ A) ∧
    d = Matrix.det (fun i j => trd (b i * b j))} = Submodule.span OF {(1 : F)}

/-- The canonical Q-component splitting is selected by its restriction to the dense global algebra. -/
def localSplitting (R : Place) : LocalD R → Matrix (Fin 2) (Fin 2) ℚ_[2] :=
  if h : ∃ e : LocalD R ≃+* Matrix (Fin 2) (Fin 2) ℚ_[2],
    ∀ x, e (localize R x) = psi x then h.choose else fun _ => 0

def dyadicOrder (n : ℕ) : Set (Matrix (Fin 2) (Fin 2) ℚ_[2]) :=
  {a | (∀ i j, ‖a i j‖ ≤ 1) ∧
    (∃ b : ℤ_[2], a 0 1 = (2 : ℚ_[2])^(n+1)*(b : ℚ_[2])) ∧
    ∃ c : ℤ_[2], a 1 0 = 2*(c : ℚ_[2])}
def translation (t : ℕ) : Matrix (Fin 2) (Fin 2) ℚ_[2] := !![1, 2*(t : ℚ_[2]); 0, 1]
def coordinateIdeal (n : ℕ) (t : Vertex n) : Set D :=
  {x | (∀ R : Place, R.asIdeal ≠ Q → localize R x ∈ completed (orderLattice : Set D) R) ∧
    ∃ a ∈ dyadicOrder n, psi x = translation t.val * a}
def vertexClass (n : ℕ) (t : Vertex n) : IdealClass := idealClass (coordinateIdeal n t)

def primeNeighbor (p : ℕ) (A I J : Set D) : Prop :=
  locallyPrincipal A J ∧ J ⊆ I ∧
  (∀ R : Place, R.asIdeal ≠ P p → completed J R = completed I R) ∧
  idealNorm J = idealAsModule (P p) * idealNorm I

/-- Defined by actual ideal neighbors, independently of all graph labels. -/
def hecke (p : ℕ) (A : Set D) (h : IdealClass → ℂ) (c : IdealClass) : ℂ :=
  ∑ᶠ J : {J : Set D // primeNeighbor p A (Quot.out c) J}, h (idealClass J.val)

def localNrd (R : Place) (x : LocalD R) : LocalField R :=
  x.re^2 + x.imI^2 + 3*x.imJ^2 + 3*x.imK^2
def localTrd (R : Place) (x : LocalD R) : LocalField R := 2*x.re

def normSolution (pi : F) := {x : D // x ∈ baseLattice ∧ nrd x = pi}
def signRelation (pi : F) (x y : normSolution pi) : Prop := x.val = y.val ∨ x.val = -y.val
abbrev SignClass (pi : F) := Quot (signRelation pi)
def inverseQuaternion (x : D) : D := (nrd x)⁻¹ • conjugate x

def normalizedGenerators (p : ℕ) : Prop :=
  (labels p).length = p+1 ∧ (labels p).Nodup ∧
  (∀ x : D, x ∈ baseLattice → nrd x = primeGenerator p →
    ∃! j : Label p, x = generator p j ∨ x = -generator p j) ∧
  (∀ j : Label p, conjugate (generator p j) = generator p (reverse p j) ∨
    conjugate (generator p j) = -generator p (reverse p j)) ∧
  Function.Involutive (reverse p) ∧
  (labels p).Pairwise (fun m l => vectorLex m l = true ∧ m ≠ l)

end RamanujanLiftTower136.Tower


