      rw [← cancel_mono e𝔐]
      apply CategoryTheory.Limits.pullback.hom_ext
      · simpa only [Category.assoc] using hQ
      · rw [Category.assoc, Category.assoc, he𝔐_snd, (𝔐.pointEquivPlace.symm P).2, (𝔐.pointEquivPlace.symm Q).2]
    have : 𝔐.pointEquivPlace.symm P = 𝔐.pointEquivPlace.symm Q := Subtype.ext hpt
    exact 𝔐.pointEquivPlace.symm.injective this
  ·
    intro ℓ hℓ hℓq hℓq' P E hE
    haveI : Fact ℓ.Prime := ⟨hℓ⟩

    obtain ⟨Ec, g, hg, hgm, hga, hgl, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff emb E
    have hEc : FakeEllipticCurve.IsPullback emb E Ec := ⟨g, hg, hgm, hga, hgl⟩

    obtain ⟨n, Kc, dc, hpdC, hexC, hisoC, hMc⟩ := hPc ℓ hℓ hℓq hℓq' Ec

    obtain ⟨hG1, hG2, hG3⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.ExtraLevel.forall_exists_factorsThrough_iff_comp_of_isPullback_of_isAlgClosed
        Qb ℂ emb E Ec g hg hgm hga hgl ℓ hℓ
    choose K hK using fun i => hG2 (Kc i)

    have hℓQ : (ℓ : Qb) ≠ 0 := by exact_mod_cast hℓ.ne_zero
    have hNQ : ((1 : ℕ) : Qb) ≠ 0 := by simp
    have hdex : ∀ i : Fin n, ∃ d : FakeEllipticCurve Λ 1 Qb,
        FakeEllipticCurve.IsLevelIsogeny ℓ (⟨E, K i⟩ : FakeEllipticCurve.WithExtraLevel Λ 1 ℓ Qb) d := fun i =>
      CerednikDrinfeld.QM.FakeEllipticCurve.WithExtraLevel.exists_isLevelIsogeny hqq' hB Λ hΛ ℓ hℓq hℓq' Qb hℓQ hNQ ⟨E, K i⟩
    choose d hd using hdex

    have hlift : ∀ i : Fin n, (pt _ sbar (d i)).1 ≫ πX = 𝟙 _ ≫ sbar := fun i => by rw [Category.id_comp]; exact (pt _ sbar (d i)).2
    haveI := he𝔐
    let pC : Fin n → {p : Spec (CommRingCat.of Qb) ⟶ 𝔐.C // p ≫ 𝔐.toBase = 𝟙 _} := fun i =>
      ⟨CategoryTheory.Limits.pullback.lift (pt _ sbar (d i)).1 (𝟙 _) (hlift i) ≫ inv e𝔐, by
        rw [Category.assoc, ← he𝔐_snd, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_snd]⟩
