  gen : (genusFF (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) : ℤ) + 1 ≤ 2 * (genusFF (ResidueField ↥A) (JHNeronObjectAtP.Fbar p M H hpM (ResidueField ↥A)) : ℤ) + (SS.image Prod.fst).card
  Lat : ∀ E : Divisor (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H),
    ∃ (u : Fin (Module.finrank (AlgebraicClosure ℚ) ↥(riemannRochSpace E)) → ↥(xHFunctionFieldBar M H))
