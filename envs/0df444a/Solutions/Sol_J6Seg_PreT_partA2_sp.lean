section desc
variable {s t lam : ℕ}

theorem blFrom_bnd (hl : 1 ≤ lam) (c : ℕ) : ∀ (f st : ℕ), c * lam ≤ st →
    (∀ b ∈ blFrom s t lam (min s (c * lam + lam)) f st, 1 ≤ b.2 ∧ b.2 ≤ lam) ∧
    ((blFrom s t lam (min s (c * lam + lam)) f st).map Prod.snd).sum + st ≤
      max st (c * lam + lam)
  | 0, st, _ => by simp [blFrom]
  | f + 1, st, hst => by
    unfold blFrom
    split_ifs with h
    · have he := en_le_chunk (s := s) (t := t) hl hst (lt_of_lt_of_le h (min_le_right _ _))
      obtain ⟨ih1, ih2⟩ := blFrom_bnd hl c f (st + 1 + enF s t lam st) (by omega)
      refine ⟨fun b hb => ?_, ?_⟩
      · rcases List.mem_cons.1 hb with rfl | hb
        · simp only; omega
        · exact ih1 b hb
      · simp only [List.map_cons, List.sum_cons]
        have : max (st + 1 + enF s t lam st) (c * lam + lam) = c * lam + lam := by omega
        rw [this] at ih2
        omega
    · simp

theorem sumN_map (l : List (ℕ × ℕ)) (F G : ℕ → ℕ → ℤ) :
    sumN (l.map fun b => (b.2, (List.range b.2).map (F b.1), (List.range b.2).map (G b.1))) =
      (l.map Prod.snd).sum := by
  induction l with
  | nil => rfl
  | cons b l ih => simp only [List.map_cons, sumN, List.sum_cons]; rw [ih]

theorem sumN_descsOf (hl : 1 ≤ lam) (T : Tables) (c : ℕ) : sumN (descsOf s t lam T c) ≤ lam := by
  unfold descsOf chunkBl
  rw [sumN_map]
  have := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).2
  omega

theorem descsOf_ok (hl : 1 ≤ lam) (T : Tables) (c : ℕ) :
    ∀ d ∈ descsOf s t lam T c, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
      (∀ v ∈ d.2.1, ∃ h < d.1, ∃ c', v = T.am c' h) ∧ (∀ v ∈ d.2.2, ∃ h < d.1, ∃ c', v = T.ap c' h) := by
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  obtain ⟨h1, h2⟩ := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).1 b hb
  refine ⟨h1, by simp, by simp, h2, ?_, ?_⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩

end desc

