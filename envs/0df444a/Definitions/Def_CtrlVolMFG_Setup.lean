-- title:
--   Probabilistic setup: initial states, common and idiosyncratic Brownian motions, filtrations, conditional laws and conditionally independent copies
-- statement:
--   The games live on a probability space $(\Omega,\mathcal F,\mathbb P)$ carrying i.i.d. initial states $\xi^1,\xi^2,\dots$ with law $m_0\in\mathcal P_2(\mathbb R^n)$, a common $d$-dimensional Brownian motion $W^0$ and idiosyncratic $d$-dimensional Brownian motions $W^1,W^2,\dots$, all mutually independent (§2.2).
--
--   1. $\mathbb F^N=(\mathcal F^N_t)$ is the filtration generated by $\xi^1,\dots,\xi^N$ and $W^0,W^1,\dots,W^N$; $\mathbb F=\mathbb F^1$ is the filtration of the mean field game, with $\xi=\xi^1$, $W=W^1$; $\mathbb F^0$ is the filtration of $W^0$.
--   2. An Itô process on $[0,T]$ is $X_t=X_0+\int_0^t\beta_sds+\sum_\kappa\int_0^t\gamma^\kappa_sdB^\kappa_s$ with progressive, a.s. continuous $X$ (the published `Peng1990.SMP.IsItoProcess`).
--   3. $m_t$ is a version of the conditional law $\mathcal L(X_t\mid\mathcal F^0_t)$ when $m_t(\omega)(A)=\mathbb P[X_t\in A\mid\mathcal F^0_t](\omega)$ a.s. for every Borel $A$.
--   4. A functional representation of a process $X$ of the mean field game consists of measurable maps $\widetilde X_t$ on $\mathbb R^n\times\mathcal C_t\times\mathcal C_t$ with $X_t=\widetilde X_t(\xi,W^0_{[0,t]},W_{[0,t]})$ a.s. (Lemma 2.1); the conditionally independent copies (Definition 2.2) are
--   $$X^i_t:=\widetilde X_t(\xi^i,W^0_{[0,t]},W^i_{[0,t]}),\qquad i=1,\dots,N.$$
--   5. The copies are conditionally i.i.d. given $\mathcal F^0_t$ when $\mathbb P[X^i_t\in A_i\ \forall i\mid\mathcal F^0_t]=\prod_i\mathbb P[X^i_t\in A_i\mid\mathcal F^0_t]$ and $\mathbb P[X^i_t\in A\mid\mathcal F^0_t]=\mathbb P[X^1_t\in A\mid\mathcal F^0_t]$ a.s.
--
--   The copies share the common noise $W^0$, so they are conditionally, not unconditionally, independent; they couple the mean field equilibrium to the $N$-player game.
--
--   **Formalization Note** One space carries every number of players (the paper's canonical spaces $\Omega^N$ embed into one another, p.10; the canonical product space is an instance). Player $i$ of the paper is index $i-1$. Filtrations are raw (not augmented). The path $W_{[0,t]}$ is the stopped path $s\mapsto W_{s\wedge t}$.
-- source:
--   Jackson & Tangpi, Quantitative Convergence for Displacement Monotone Mean Field Games with Controlled Volatility, arXiv:2304.04543v2, §2.2 pp.9–10; Lemma 2.1 and Definition 2.2 p.11; (2.9) p.13

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_CtrlVolMFG_IsC1

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace CtrlVolMFG

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The probabilistic setup of §2.2 (Jackson & Tangpi, arXiv:2304.04543v2, pp.9–10), on one
probability space for all numbers of players: i.i.d. initial states `ξⁱ` with law `m₀ ∈ 𝒫₂(ℝⁿ)`,
a common `d`-dimensional Brownian motion `W⁰` and idiosyncratic `d`-dimensional Brownian motions
`Wⁱ`, all mutually independent.

**Formalization Note**
1. The paper builds a canonical space `Ωᴺ = (ℝⁿ)ᴺ × 𝒞ᴺ⁺¹` for each `N` and identifies objects on
   `Ωᴺ` with their extensions to `Ωᴹ`, `M > N` (p.10). Here one space carries the whole sequence;
   the canonical product space is an instance. Player `i ∈ {1, 2, …}` of the paper is index
   `i - 1` here, so `ξ 0`, `W 0` are the paper's `ξ¹ = ξ`, `W¹ = W` of the mean field game.
2. Brownian motions are `Peng1990.SMP.IsStdBrownian` (time `ℝ≥0`; only `[0, T]` matters); their
   paths are continuous for every `ω`, as on the canonical space `𝒞 = C([0, T]; ℝᵈ)`.
3. Independence is that of the σ-algebras generated by `W⁰`, by each `ξⁱ` and by each path `Wⁱ`. -/
structure Setup (n d : ℕ) (Ω : Type*) [MeasurableSpace Ω] where
  /-- The probability measure `ℙ`. -/
  P : Measure Ω
  isProb : IsProbabilityMeasure P
  /-- The initial distribution `m₀ ∈ 𝒫₂(ℝⁿ)`. -/
  m0 : P2 n
  /-- The initial states `ξ¹, ξ², …` (index `i - 1`). -/
  ξ : ℕ → Ω → Rn n
  /-- The common noise `W⁰`. -/
  W0 : ℝ≥0 → Ω → Fin d → ℝ
  /-- The idiosyncratic noises `W¹, W², …` (index `i - 1`). -/
  W : ℕ → ℝ≥0 → Ω → Fin d → ℝ
  meas_ξ : ∀ i, Measurable (ξ i)
  law_ξ : ∀ i, P.map (ξ i) = m0.1
  bm0 : Peng1990.SMP.IsStdBrownian P W0
  bm : ∀ i, Peng1990.SMP.IsStdBrownian P (W i)
  cont0 : ∀ ω, Continuous fun t => W0 t ω
  cont : ∀ i ω, Continuous fun t => W i t ω
  /-- `W⁰`, `ξ¹, ξ², …` and `W¹, W², …` are mutually independent. -/
  indep : iIndep (fun k : Option (ℕ ⊕ ℕ) => k.elim
      (MeasurableSpace.comap (fun ω t => W0 t ω) inferInstance)
      (Sum.elim (fun i => MeasurableSpace.comap (ξ i) inferInstance)
        (fun i => MeasurableSpace.comap (fun ω t => W i t ω) inferInstance))) P

attribute [instance] Setup.isProb

namespace Setup

variable {n d : ℕ}

/-- The filtration `𝔽ᴺ = (ℱᴺ_t)` generated by `ξ¹, …, ξᴺ` and `W⁰, W¹, …, Wᴺ`
(arXiv:2304.04543v2, p.9): `ℱᴺ_t = σ(ξⁱ, W⁰_s, Wⁱ_s : i ≤ N, s ≤ t)`. `filtN S 1` is the
filtration `𝔽 = 𝔽¹` of the mean field game (p.10).

**Formalization Note** The paper augments the filtration by the null sets. The raw filtration
is used here: every process that is progressive for the augmented filtration has a version that
is progressive for the raw one ([41, Prop. 1.2.1], cited p.10), and controls and states enter
every statement only up to such versions. -/
def filtN (S : Setup n d Ω) (N : ℕ) : MeasureTheory.Filtration ℝ≥0 mΩ where
  seq t := (⨆ i < N, MeasurableSpace.comap (S.ξ i) inferInstance) ⊔
    ⨆ s ≤ t, (MeasurableSpace.comap (S.W0 s) inferInstance ⊔
      ⨆ i < N, MeasurableSpace.comap (S.W i s) inferInstance)
  mono' _ _ hst := sup_le_sup_left (biSup_mono fun _ h => h.trans hst) _
  le' _ := sup_le (iSup₂_le fun i _ => (S.meas_ξ i).comap_le)
    (iSup₂_le fun s _ => sup_le (S.bm0.meas s).comap_le
      (iSup₂_le fun i _ => ((S.bm i).meas s).comap_le))

/-- The filtration `𝔽⁰ = (ℱ⁰_t)` of the common noise `W⁰` (arXiv:2304.04543v2, p.9), the
published natural Brownian filtration `Peng1990.SMP.brownianFiltration` (raw, see `filtN`). -/
noncomputable def F0 (S : Setup n d Ω) : MeasureTheory.Filtration ℝ≥0 mΩ :=
  Peng1990.SMP.brownianFiltration S.bm0

/-- The scalar noises driving player `i` (index `i - 1`): the coordinates `W^{i,j}` (`inl j`) and
`W^{0,j}` (`inr j`), `j < d`. -/
def noise (S : Setup n d Ω) (i : ℕ) : Fin d ⊕ Fin d → ℝ≥0 → Ω → ℝ :=
  Sum.elim (fun j t ω => S.W i t ω j) (fun j t ω => S.W0 t ω j)

/-- All scalar noises of the `N`-player game: `W^{0,j}` (`(none, j)`) and `W^{l,j}`
(`(some l, j)`), `l < N`, `j < d`. -/
def noiseAll (S : Setup n d Ω) (N : ℕ) : Option (Fin N) × Fin d → ℝ≥0 → Ω → ℝ :=
  fun q t ω => q.1.elim (S.W0 t ω q.2) (fun l => S.W l t ω q.2)

end Setup

/-- `X` is an Itô process on `[0, T]` with initial value `X₀`, drift `β` and integrands `γ`
against the scalar noises `B`:
`X_t = X₀ + ∫₀ᵗ β_s ds + ∑_κ ∫₀ᵗ γ^κ_s dB^κ_s`, `t ∈ [0, T]`, with `X` progressive and with
almost surely continuous paths on `[0, T]`.

**Formalization Note** The Itô integral and the integral equation are the published
`Peng1990.SMP.IsItoProcess`, applied to `X − X₀` (Peng's initial value is deterministic; here it
is `0`), with the noises enumerated by `Fintype.equivFin` (the predicate does not depend on the
enumeration). `IsItoProcess` also asks `sup_{t ≤ T} 𝔼|X_t − X₀|² < ∞` and that the integrands are
in `L²_𝔽`; both hold for the paper's solutions, which satisfy (3.3), (3.7). Path continuity is
added because the paper's processes are continuous. -/
def IsItoProc {n : ℕ} {κ : Type*} [Fintype κ] (𝓕 : MeasureTheory.Filtration ℝ≥0 mΩ)
    (P : Measure Ω) (T : ℝ≥0) (B : κ → ℝ≥0 → Ω → ℝ) (X₀ : Ω → Rn n) (β : ℝ≥0 → Ω → Rn n)
    (γ : κ → ℝ≥0 → Ω → Rn n) (X : ℝ≥0 → Ω → Rn n) : Prop :=
  IsStronglyProgressive 𝓕 X ∧
    (∀ᵐ ω ∂P, ContinuousOn (fun t => X t ω) (Set.Icc 0 T)) ∧
    Peng1990.SMP.IsItoProcess 𝓕 P T
      (fun t ω j => B ((Fintype.equivFin κ).symm j) t ω) 0
      (fun t ω => ⇑(β t ω)) (fun j t ω => ⇑(γ ((Fintype.equivFin κ).symm j) t ω))
      (fun t ω => ⇑(X t ω - X₀ ω))

/-- Equality `dt × dℙ`-almost everywhere on `[0, T] × Ω` of two processes. -/
def EqDtDP {E : Type*} (P : Measure Ω) (T : ℝ≥0) (φ ψ : ℝ≥0 → Ω → E) : Prop :=
  ∀ᵐ p ∂((volume.restrict (Set.Icc (0 : ℝ) T)).prod P), φ p.1.toNNReal p.2 = ψ p.1.toNNReal p.2

/-- `m_t(ω)` is a version of the conditional law `ℒ(X_t | ℱ⁰_t)`: for every Borel set `A`,
`ω ↦ m_t(ω)(A)` is almost surely equal to `ℙ[X_t ∈ A | ℱ⁰_t]` (arXiv:2304.04543v2, (2.9), p.13). -/
def IsCondLaw {n d : ℕ} (S : Setup n d Ω) (X : ℝ≥0 → Ω → Rn n) (m : ℝ≥0 → Ω → P2 n)
    (t : ℝ≥0) : Prop :=
  ∀ A : Set (Rn n), MeasurableSet A →
    (fun ω => ((m t ω).1 A).toReal) =ᵐ[S.P]
      condExp (S.F0 t) S.P ((X t ⁻¹' A).indicator (fun _ => (1 : ℝ)))

/-- A path stopped at time `t`, `s ↦ w(s ∧ t)`: the paper's restriction `w_{[0,t]} ∈ 𝒞_t`. -/
def stopPath {d : ℕ} (t : ℝ≥0) (w : ℝ≥0 → Fin d → ℝ) : ℝ≥0 → Fin d → ℝ :=
  fun s => w (min s t)

/-- The inputs `(x, w⁰, w) ∈ ℝⁿ × 𝒞_t × 𝒞_t` of a functional representation (Lemma 2.1, p.11). -/
abbrev PathInput (n d : ℕ) := Rn n × (ℝ≥0 → Fin d → ℝ) × (ℝ≥0 → Fin d → ℝ)

/-- The input of player `i` (index `i - 1`) at time `t`: `(ξⁱ, W⁰_{[0,t]}, Wⁱ_{[0,t]})`. -/
def Setup.input {n d : ℕ} (S : Setup n d Ω) (i : ℕ) (t : ℝ≥0) (ω : Ω) : PathInput n d :=
  (S.ξ i ω, stopPath t (fun s => S.W0 s ω), stopPath t (fun s => S.W i s ω))

/-- A functional representation of a process `X` of the mean field game on `[0, T]`
(Lemma 2.1, p.11): measurable maps `X̃_t` on `ℝⁿ × 𝒞_t × 𝒞_t` with
`X_t = X̃_t(ξ, W⁰_{[0,t]}, W_{[0,t]})` almost surely, for each `t ∈ [0, T]`. -/
structure Rep {n d : ℕ} (S : Setup n d Ω) (T : ℝ≥0) {E : Type*} [MeasurableSpace E]
    (X : ℝ≥0 → Ω → E) where
  /-- The maps `X̃_t`. -/
  F : ℝ≥0 → PathInput n d → E
  meas : ∀ t, Measurable (F t)
  rep : ∀ t ≤ T, ∀ᵐ ω ∂S.P, X t ω = F t (S.input 0 t ω)

/-- The conditionally independent copies `Xⁱ_t := X̃_t(ξⁱ, W⁰_{[0,t]}, Wⁱ_{[0,t]})` of
Definition 2.2, p.11 (index `i - 1`). Copy `0` is the modification `X̃_t(ξ, W⁰, W)` of `X`. -/
def Rep.copy {n d : ℕ} {S : Setup n d Ω} {T : ℝ≥0} {E : Type*} [MeasurableSpace E]
    {X : ℝ≥0 → Ω → E} (R : Rep S T X) (i : ℕ) : ℝ≥0 → Ω → E :=
  fun t ω => R.F t (S.input i t ω)

/-- For each `N` and each `t ∈ [0, T]`, the copies `(Xⁱ_t)_{i=1,…,N}` are i.i.d. conditionally on
`ℱ⁰_t` (Lemma 2.1, p.11): for Borel sets `A₁, …, A_N`,
`ℙ[Xⁱ_t ∈ Aᵢ ∀ i | ℱ⁰_t] = ∏ᵢ ℙ[Xⁱ_t ∈ Aᵢ | ℱ⁰_t]` almost surely, and
`ℙ[Xⁱ_t ∈ A | ℱ⁰_t] = ℙ[X¹_t ∈ A | ℱ⁰_t]` almost surely for each `i` and each Borel `A`. -/
def Rep.CondIID {n d : ℕ} {S : Setup n d Ω} {T : ℝ≥0} {E : Type*} [MeasurableSpace E]
    {X : ℝ≥0 → Ω → E} (R : Rep S T X) : Prop :=
  ∀ (N : ℕ), ∀ t ≤ T,
    (∀ A : Fin N → Set E, (∀ i, MeasurableSet (A i)) →
      condExp (S.F0 t) S.P ((⋂ i : Fin N, R.copy i t ⁻¹' A i).indicator (fun _ => (1 : ℝ)))
        =ᵐ[S.P] fun ω => ∏ i : Fin N,
          condExp (S.F0 t) S.P ((R.copy i t ⁻¹' A i).indicator (fun _ => (1 : ℝ))) ω) ∧
    ∀ A : Set E, MeasurableSet A → ∀ i : Fin N,
      condExp (S.F0 t) S.P ((R.copy i t ⁻¹' A).indicator (fun _ => (1 : ℝ))) =ᵐ[S.P]
        condExp (S.F0 t) S.P ((R.copy 0 t ⁻¹' A).indicator (fun _ => (1 : ℝ)))

/-- A representation of a progressive process whose copies are progressive: for every `N`, the
copies `X¹, …, Xᴺ` are `𝔽ᴺ`-progressive (Lemma 2.1, progressive case). -/
structure ProgRep {n d : ℕ} (S : Setup n d Ω) (T : ℝ≥0) {E : Type*} [TopologicalSpace E]
    [MeasurableSpace E] (X : ℝ≥0 → Ω → E) extends Rep S T X where
  prog : ∀ N i, i < N → IsStronglyProgressive (S.filtN N) (toRep.copy i)

/-- A representation of a continuous adapted process whose copies are continuous and adapted:
for every `N`, the copies `X¹, …, Xᴺ` are `𝔽ᴺ`-adapted with almost surely continuous paths on
`[0, T]` (Lemma 2.1, continuous case). -/
structure ContRep {n d : ℕ} (S : Setup n d Ω) (T : ℝ≥0) {E : Type*} [TopologicalSpace E]
    [MeasurableSpace E] (X : ℝ≥0 → Ω → E) extends Rep S T X where
  adapted : ∀ N i, i < N → StronglyAdapted (S.filtN N) (toRep.copy i)
  cont : ∀ i, ∀ᵐ ω ∂S.P, ContinuousOn (fun t => toRep.copy i t ω) (Set.Icc 0 T)

end CtrlVolMFG


