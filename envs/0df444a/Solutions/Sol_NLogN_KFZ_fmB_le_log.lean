attribute [local irreducible] fmA Cfm

theorem zsz_le_log (x : ℕ) : zsz (x : ℤ) ≤ Nat.log 2 x + 1 := by
  apply zsz_le_of_lt
  simpa using Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) x

theorem log_bound (p m : ℕ) (hp : 1 ≤ p) (hm : m ≤ 64 * p) :
    ((zsz ((m + 1 : ℕ) : ℤ) : ℕ) : ℝ) + 2 ≤ 10 * (Real.log p + 1) := by
  have h1 := zsz_le_log (m + 1)
  have h2 : ((Nat.log 2 (m + 1) : ℕ) : ℝ) ≤ Real.logb 2 ((m + 1 : ℕ) : ℝ) :=
    Real.natLog_le_logb (m + 1) 2
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp
  have hm1 : (0 : ℝ) < ((m + 1 : ℕ) : ℝ) := by positivity
  have h3 : Real.log ((m + 1 : ℕ) : ℝ) ≤ Real.log (128 * (p : ℝ)) := by
    apply Real.log_le_log hm1
    have : (m + 1 : ℕ) ≤ 128 * p := by omega
    exact_mod_cast this
  have h4 : Real.log (128 * (p : ℝ)) = 7 * Real.log 2 + Real.log p := by
    rw [Real.log_mul (by norm_num) hp0.ne', show (128 : ℝ) = 2 ^ 7 by norm_num, Real.log_pow]
    push_cast; ring
  have hl2 : 0.6931471803 < Real.log 2 := Real.log_two_gt_d9
  have hlp : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast hp)
  have h5 : Real.logb 2 ((m + 1 : ℕ) : ℝ) ≤ 7 + 1.5 * Real.log p := by
    rw [Real.logb, div_le_iff₀ (by linarith)]
    nlinarith
  have h6 : ((zsz ((m + 1 : ℕ) : ℤ) : ℕ) : ℝ) ≤ ((Nat.log 2 (m + 1) : ℕ) : ℝ) + 1 := by
    exact_mod_cast h1
  linarith

theorem zsz_pow4 (a : ℕ) : zsz (((a ^ 4 : ℕ)) : ℤ) ≤ 4 * a := by
  apply zsz_le_of_lt
  simp only [Int.natAbs_natCast]
  calc a ^ 4 < (2 ^ a) ^ 4 := Nat.pow_lt_pow_left Nat.lt_two_pow_self (by norm_num)
    _ = 2 ^ (4 * a) := by rw [← pow_mul]; ring_nf

theorem fmB_le_log_sol_aux (p m : ℕ) (hp : 1 ≤ p) (hm : m ≤ 64 * p) :
    (KFM.fmB m : ℝ) ≤ 32500 * (Cfm : ℝ) * p * (Real.log p + 1) ^ 2 := by
  set a := zsz ((m + 1 : ℕ) : ℤ) with ha
  have hb : zsz ((((a + 2) ^ 4 : ℕ)) : ℤ) + 1 ≤ 5 * (a + 2) := by
    have := zsz_pow4 (a + 2); omega
  have hA := log_bound p m hp hm
  rw [← ha] at hA
  have e : (KFM.fmB m : ℝ) = (Cfm : ℝ) * ((m + 1 : ℕ) : ℝ) * ((a : ℝ) + 2) *
      ((zsz ((((a + 2) ^ 4 : ℕ)) : ℤ) : ℕ) + 1 : ℝ) := by
    unfold KFM.fmB Cfm; rw [← ha]; push_cast; ring
  have hb' : ((zsz ((((a + 2) ^ 4 : ℕ)) : ℤ) : ℕ) + 1 : ℝ) ≤ 5 * ((a : ℝ) + 2) := by
    exact_mod_cast hb
  have hm' : ((m + 1 : ℕ) : ℝ) ≤ 65 * p := by
    have : m + 1 ≤ 65 * p := by omega
    exact_mod_cast this
  have hC : (0 : ℝ) ≤ Cfm := Nat.cast_nonneg _
  have ha0 : (0 : ℝ) ≤ (a : ℝ) + 2 := by have := Nat.cast_nonneg (α := ℝ) a; linarith
  have hz0 : (0 : ℝ) ≤ ((zsz ((((a + 2) ^ 4 : ℕ)) : ℤ) : ℕ) + 1 : ℝ) := by
    have := Nat.cast_nonneg (α := ℝ) (zsz ((((a + 2) ^ 4 : ℕ)) : ℤ)); linarith
  rw [e]
  clear e
  generalize (Cfm : ℝ) = c at hC ⊢
  generalize ((zsz ((((a + 2) ^ 4 : ℕ)) : ℤ) : ℕ) + 1 : ℝ) = z at hb' hz0 ⊢
  generalize ((m + 1 : ℕ) : ℝ) = M at hm' ⊢
  generalize ((a : ℕ) : ℝ) = A at hA ha0 hb' ⊢
  generalize Real.log (p : ℝ) = L at hA ⊢
  have hp0 : (0 : ℝ) ≤ p := Nat.cast_nonneg _
  generalize (p : ℝ) = P at hm' hp0 ⊢
  have h1 : c * M * (A + 2) * z ≤ c * (65 * P) * (A + 2) * (5 * (A + 2)) := by
    have := mul_le_mul hm' hb' hz0 (by linarith)
    have h2 : M * z ≤ (65 * P) * (5 * (A + 2)) := this
    calc c * M * (A + 2) * z = (c * (A + 2)) * (M * z) := by ring
      _ ≤ (c * (A + 2)) * ((65 * P) * (5 * (A + 2))) :=
          mul_le_mul_of_nonneg_left h2 (mul_nonneg hC ha0)
      _ = _ := by ring
  have h3 : (A + 2) ^ 2 ≤ (10 * (L + 1)) ^ 2 := pow_le_pow_left₀ ha0 hA 2
  have h4 : 0 ≤ 325 * c * P := by positivity
  calc c * M * (A + 2) * z ≤ c * (65 * P) * (A + 2) * (5 * (A + 2)) := h1
    _ = 325 * c * P * (A + 2) ^ 2 := by ring
    _ ≤ 325 * c * P * (10 * (L + 1)) ^ 2 := mul_le_mul_of_nonneg_left h3 h4
    _ = 32500 * c * P * (L + 1) ^ 2 := by ring

