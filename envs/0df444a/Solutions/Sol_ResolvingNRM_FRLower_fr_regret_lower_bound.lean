  · unfold stepExp
    simp_rw [hinner1]
    have hs := ((hasSum_poissonPMFReal_mul_nat 2).mul_right ((1 : ℝ) / 2)).sub (hasSum_poissonPMFReal 2)
    exact (hs.congr_fun fun N => by ring).tsum_eq.trans (by norm_num)
