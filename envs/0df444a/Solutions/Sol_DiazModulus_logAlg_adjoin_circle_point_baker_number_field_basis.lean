open Complex ComplexConjugate

/-! # Baker's theorem over a number-field basis, for `ℒ_u = ℒ + ℚu + ℚū`

Let `u` have algebraic `ρ = u ū` and be transcendental over `F`, the field generated by `ℒ̃`. Let `(β_k)` be a
`ℚ`-basis of a number field `K ⊂ ℂ` and `ℓ_k ∈ ℒ_u` with `a = Σ β_k ℓ_k` algebraic. Write `ℓ_k = c_k + p_k u + q_k ū`
with `c_k ∈ ℒ` and `p_k, q_k ∈ ℚ` (`mem_logAlg_adjoin_circle_point_iff`). Then
`(Σ β_k c_k − a) + (Σ β_k p_k) u + (Σ β_k q_k) ū = 0`, and every coefficient lies in `F`, because `F` contains the
algebraic numbers and `ℒ`. If `Σ β_k p_k` or `Σ β_k q_k` were non-zero, `transcendental_add_mul_add_mul_conj` would
make this `0` transcendental over `F`. So both sums vanish; the `p_k, q_k` are rational and `β` is `ℚ`-independent, so
every `p_k` and `q_k` is `0`. Hence `ℓ_k = c_k ∈ ℒ`, and Baker's theorem over a number-field basis
(`Transcendence.baker_number_field_basis`; Waldschmidt, Diophantine Approximation on Linear Algebraic Groups, Th. 4.5) gives `ℓ_k = 0`. -/

namespace R19_B1
open DiazModulus

/-- Algebraic numbers lie in the field generated by `ℒ̃`. -/
theorem mem_closure_of_isAlgebraic {x : ℂ} (hx : IsAlgebraic ℚ x) :
    x ∈ Subfield.closure (LogAlgTilde : Set ℂ) := by
  apply Subfield.subset_closure
  have h1 : (1 : ℂ) ∈ LogAlgTilde := Submodule.subset_span (Set.mem_insert 1 _)
  have h2 := LogAlgTilde.smul_mem (⟨x, mem_Qbar_iff.2 hx⟩ : Qbar) h1
  simpa [Subfield.smul_def] using h2

/-- `ℒ` lies in the field generated by `ℒ̃`. -/
theorem mem_closure_of_mem_logAlg {x : ℂ} (hx : x ∈ LogAlg) :
    x ∈ Subfield.closure (LogAlgTilde : Set ℂ) :=
  Subfield.subset_closure (Submodule.subset_span (Set.mem_insert_of_mem 1 hx))

/-- The coordinates of a vanishing rational combination of a basis of `K`, read in `ℂ`, vanish. -/
theorem coeffs_eq_zero (K : IntermediateField ℚ ℂ) {ι : Type*} [Fintype ι] (β : Module.Basis ι ℚ K)
    (p : ι → ℚ) (h : ∑ k, (β k : ℂ) * (p k : ℂ) = 0) : ∀ k, p k = 0 := by
  refine Fintype.linearIndependent_iff.1 β.linearIndependent p ?_
  apply Subtype.ext
  simpa [IntermediateField.coe_sum, Rat.smul_def, mul_comm] using h

end R19_B1

open DiazModulus R19_B1 in
theorem solution
    (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u)
    (K : IntermediateField ℚ ℂ) {ι : Type*} [Fintype ι] (β : Module.Basis ι ℚ K) (ℓ : ι → ℂ)
    (hℓ : ∀ k, ℓ k ∈ (Submodule.span ℚ LogAlg ⊔ Submodule.span ℚ ({u, conj u} : Set ℂ)))
    (hsum : IsAlgebraic ℚ (∑ k, (β k : ℂ) * ℓ k)) :
    ∀ k, ℓ k = 0 := by
  have hdec := fun k => ((DiazModulus.mem_logAlg_adjoin_circle_point_iff u).1 (ℓ k)).1 (hℓ k)
  choose c hc p q hpq using hdec
  have : FiniteDimensional ℚ K := Module.Finite.of_basis β
  have hβF : ∀ k, (β k : ℂ) ∈ Subfield.closure (LogAlgTilde : Set ℂ) := fun k =>
    mem_closure_of_isAlgebraic (IntermediateField.isAlgebraic_iff.1 (Algebra.IsAlgebraic.isAlgebraic (β k)))
  -- the decomposition of the sum
  set a := ∑ k, (β k : ℂ) * ℓ k with ha
  have hrel : (∑ k, (β k : ℂ) * c k - a) + (∑ k, (β k : ℂ) * (p k : ℂ)) * u
      + (∑ k, (β k : ℂ) * (q k : ℂ)) * conj u = 0 := by
    rw [ha, Finset.sum_mul, Finset.sum_mul, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [hpq k]
    ring
  -- F1 kills both rational sums
  have hpq0 : (∑ k, (β k : ℂ) * (p k : ℂ)) = 0 ∧ (∑ k, (β k : ℂ) * (q k : ℂ)) = 0 := by
    by_contra hne
    rw [not_and_or] at hne
    have hF := DiazModulus.transcendental_add_mul_add_mul_conj _ u hu (mem_closure_of_isAlgebraic hρ)
      (∑ k, (β k : ℂ) * c k - a) (∑ k, (β k : ℂ) * (p k : ℂ)) (∑ k, (β k : ℂ) * (q k : ℂ))
      (sub_mem (sum_mem fun k _ => mul_mem (hβF k) (mem_closure_of_mem_logAlg (hc k)))
        (mem_closure_of_isAlgebraic hsum))
      (sum_mem fun k _ => mul_mem (hβF k) (mem_closure_of_isAlgebraic (isAlgebraic_algebraMap (p k))))
      (sum_mem fun k _ => mul_mem (hβF k) (mem_closure_of_isAlgebraic (isAlgebraic_algebraMap (q k))))
      hne
    rw [hrel] at hF
    exact hF isAlgebraic_zero
  have hp := coeffs_eq_zero K β p hpq0.1
  have hq := coeffs_eq_zero K β q hpq0.2
  have hℓc : ∀ k, ℓ k = c k := fun k => by simp [hpq k, hp k, hq k]
  refine Transcendence.baker_number_field_basis K β ℓ (fun k => ?_) hsum
  rw [hℓc k]
  exact hc k
