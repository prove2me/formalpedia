theorem ok_tcopy : WFw tcopy :=
  (mk_ok (List.range 23) (fun c => cND (retN c)) (fun c => [(wT c, wS (retS c))]) (fun _ => True)
    (fun _ => True) (fun c hc => ⟨cND_lt (retN_lt (List.mem_range.1 hc)), trivial⟩) fun c hc p hp => by
