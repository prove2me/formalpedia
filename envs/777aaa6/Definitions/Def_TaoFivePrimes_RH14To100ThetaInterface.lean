structure Entry where
  lo : ℕ
  hi : ℕ
  g : ℤ
  r : ℕ
  f : ℤ
  s : ℕ
  deriving DecidableEq, Repr

def zeroEntry : Entry := ⟨0,0,0,0,0,0⟩

def offset (D p j : ℕ) : ℕ :=
  if j=0 then D*(6*p+3)/64 else if j=1 then D*3/64 else 0

def entryCondition (D p limit j : ℕ) (e : Entry) : Prop :=
  e.lo≤ e.hi ∧ e.g=(offset D p j:ℤ)-(e.lo:ℤ) ∧ e.hi-e.lo+1≤ e.r ∧ e.s≤ limit
instance (D p limit j : ℕ) (e : Entry) : Decidable (entryCondition D p limit j e) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

def nextCondition (j : ℕ) (a b : Entry) : Prop :=
  b.lo*(16*(j+1))≤ 3*a.lo ∧ 3*a.hi≤ b.hi*(16*(j+1))
instance (j : ℕ) (a b : Entry) : Decidable (nextCondition j a b) :=
  inferInstanceAs (Decidable (_ ∧ _))

def checkInputs (D p limit : ℕ) : ℕ → List Entry → Bool
  | _, [] => true
  | j, e::es =>
    decide (entryCondition D p limit j e) &&
      (match es with | [] => true | f::_ => decide (nextCondition j e f)) &&
      checkInputs D p limit (j+1) es

structure Record where
  entries : List Entry
  pp : ℕ
  pm : ℕ
  pe : ℕ
  pr : ℕ
  deriving Repr

def bits : ℕ := 2176
def precision : ℕ := 184

def Record.gs (d : Record) : List ℤ := d.entries.map Entry.g
def Record.rs (d : Record) : List ℕ := d.entries.map Entry.r
def Record.fs (d : Record) : List ℤ := d.entries.map Entry.f
def Record.ss (d : Record) : List ℕ := d.entries.map Entry.s

def Record.ad (d : Record) : List ℕ := absDerivativeList d.gs
def Record.rd (d : Record) : List ℕ := radiusDerivativeList d.rs
def Record.fp (d : Record) : List ℕ := positiveList d.fs
def Record.fm (d : Record) : List ℕ := negativeList d.fs
def Record.fr (d : Record) : List ℕ := radiusFactorList d.fs d.ss

def lowProduct (a b : List ℕ) : ℕ :=
  (encode bits a*encode bits b) % (Nat.shiftLeft 1 (bits*(precision-1)))

def initialCondition (i : Fin 16) (n : Fin 8) (d : Record) : Prop :=
  d.entries.length=184 ∧
  (d.entries.headD zeroEntry).lo≤ (lambdaBox i n).lo ∧
  (lambdaBox i n).hi≤ (d.entries.headD zeroEntry).hi ∧
  (d.entries.headD zeroEntry).f=((cachedInitial i n).lo:ℤ) ∧
  (cachedInitial i n).hi-(cachedInitial i n).lo≤ (d.entries.headD zeroEntry).s
instance (i : Fin 16) (n : Fin 8) (d : Record) : Decidable (initialCondition i n d) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _))

def productCondition (d : Record) : Prop :=
  d.pp=lowProduct d.ad d.fp ∧ d.pm=lowProduct d.ad d.fm ∧
  d.pe=lowProduct d.ad d.ss ∧ d.pr=lowProduct d.rd d.fr
instance (d : Record) : Decidable (productCondition d) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

def carryCondition (d : Record) : Prop :=
  d.ad.sum*d.fp.sum<2^bits ∧ d.ad.sum*d.fm.sum<2^bits ∧
  d.ad.sum*d.ss.sum<2^bits ∧ d.rd.sum*d.fr.sum<2^bits
instance (d : Record) : Decidable (carryCondition d) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

def checkRecord (i : Fin 16) (n : Fin 8) (d : Record) : Bool :=
  decide (initialCondition i n d) &&
  checkInputs scale310 i.val (10^75) 0 d.entries &&
  d.gs.tail.all (fun g => decide (g≤ 0)) &&
  decide (carryCondition d) && decide (productCondition d) &&
  checkSteps bits scale310 0 (precision-1) d.fs.tail d.ss.tail d.pp d.pm d.pe d.pr

end CertifiedJetRecords

