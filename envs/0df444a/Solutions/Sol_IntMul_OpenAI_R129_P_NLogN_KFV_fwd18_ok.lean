theorem runDown_iterL {α : Type*} (F : ℕ → α → α) (n : ℕ) :
    ∀ m ≤ n, ∀ x, GlueError.runDown F n x =
      GlueError.runDown F (n - m) (NLogN.KFV.iterL (fun k => F (n - 1 - k)) m x)
  | 0, _, x => by simp [NLogN.KFV.iterL]
  | m + 1, hm, x => by
    rw [runDown_iterL F n m (by omega) x]
    have e : n - m = (n - (m + 1)) + 1 := by omega
    rw [e]
    simp only [GlueError.runDown, NLogN.KFV.iterL]
    congr 2; omega

theorem runDown_eq_iterL {α : Type*} (F : ℕ → α → α) (n : ℕ) (x : α) :
    GlueError.runDown F n x = NLogN.KFV.iterL (fun k => F (n - 1 - k)) n x := by
  rw [runDown_iterL F n n le_rfl x, Nat.sub_self]; rfl

theorem cf3_encK_o0 {S : IState HS} {A C D : Fin HS} (hA : A ≠ 0) (hC : C ≠ 0) (hD : D ≠ 0)
