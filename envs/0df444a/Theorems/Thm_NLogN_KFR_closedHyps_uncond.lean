theorem NLogN.KFR.closedHyps_uncond :
    ∃ Kc : ℝ, 0 < Kc ∧ ∀ (Isym : List Sym) {K r Z : ℕ}, 6 ≤ K → 1 ≤ r →
      80 * Z * (Z + 2) ≤ 2 ^ K →
      RowHyp Isym KFL.l12prog K (100 ^ 3) r Z (PsiR r Z) (Kc * (K + 2) + 1) τ50 ∧
        0 ≤ Kc * (K + 2) + 1 ∧ Monotone (PsiR r Z) ∧ ∀ v, Z + 2 ≤ PsiR r Z v := by sorry
