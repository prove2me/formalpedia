  have hchar : ∀ (ℓ : CuspidalType.ProjLine q) (c : ↥(TwoChartIntegralModel.chartAlg A₀ ↥F₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀))),
