section RealPlace

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

local notation "𝔸" => AdeleRing (𝓞 F) F

omit [NumberField F] in

private theorem torusGL_mem_borelSubgroup (r₁ r₂ : ℝˣ) : ofRealGL hw (torusGL r₁ r₂) ∈ borelSubgroup w.Completion := by
  show ((ofRealGL hw (torusGL r₁ r₂) : GL (Fin 2) w.Completion) : Matrix (Fin 2) (Fin 2) w.Completion) 1 0 = 0
  rw [ofRealGL_apply]
  show (ringEquivRealOfIsReal hw).symm (0 : ℝ) = 0
  exact map_zero _

private theorem borelDiagFst_incl_torusGL (r₁ r₂ : ℝˣ) :
    borelDiagFst ⟨adelicArchGLInclAt F w (ofRealGL hw (torusGL r₁ r₂)),
        incl_mem_adelicBorel F w (torusGL_mem_borelSubgroup hw r₁ r₂)⟩
      = realIdeleAt hw r₁ := by
  rw [borelDiagFst_incl F w (torusGL_mem_borelSubgroup hw r₁ r₂), realIdeleAt_apply]
  congr 1

private theorem borelDiagSnd_incl_torusGL (r₁ r₂ : ℝˣ) :
    borelDiagSnd ⟨adelicArchGLInclAt F w (ofRealGL hw (torusGL r₁ r₂)),
        incl_mem_adelicBorel F w (torusGL_mem_borelSubgroup hw r₁ r₂)⟩
      = realIdeleAt hw r₂ := by
  rw [borelDiagSnd_incl F w (torusGL_mem_borelSubgroup hw r₁ r₂), realIdeleAt_apply]
  congr 1

private theorem apply_incl_torusGL_mul {χ₁ χ₂ : (𝔸)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (r₁ r₂ : ℝˣ) (g : AdelicGL2 (𝓞 F) F) :
    φ (adelicArchGLInclAt F w (ofRealGL hw (torusGL r₁ r₂)) * g)
      = ((χ₁ (realIdeleAt hw r₁) : ℂˣ) : ℂ) * ((χ₂ (realIdeleAt hw r₂) : ℂˣ) : ℂ) * φ g := by
  rw [hφ _ (incl_mem_adelicBorel F w (torusGL_mem_borelSubgroup hw r₁ r₂)) g,
    borelDiagFst_incl_torusGL hw r₁ r₂, borelDiagSnd_incl_torusGL hw r₁ r₂]

private theorem continuous_chi_realIdeleAt_of_apply_ne_zero {χ₁ χ₂ : (𝔸)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ) {g₀ : AdelicGL2 (𝓞 F) F} (h0 : φ g₀ ≠ 0) :
    (Continuous fun r : ℝˣ => ((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ)) ∧
      (Continuous fun r : ℝˣ => ((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ)) := by
  have hb : ∀ r₁ r₂ : ℝˣ, ((χ₁ (realIdeleAt hw r₁) : ℂˣ) : ℂ) * ((χ₂ (realIdeleAt hw r₂) : ℂˣ) : ℂ)
      = φ (adelicArchGLInclAt F w (ofRealGL hw (torusGL r₁ r₂)) * g₀) * (φ g₀)⁻¹ := fun r₁ r₂ => by
    rw [apply_incl_torusGL_mul hw hφ, mul_inv_cancel_right₀ h0]
  have h1 : (fun r : ℝˣ => ((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ))
      = fun r => φ (adelicArchGLInclAt F w (ofRealGL hw (torusGL r (1 : ℝˣ))) * g₀) * (φ g₀)⁻¹ := by
    funext r
    rw [← hb r 1, map_one, map_one, Units.val_one, mul_one]
  have h2 : (fun r : ℝˣ => ((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ))
      = fun r => φ (adelicArchGLInclAt F w (ofRealGL hw (torusGL (1 : ℝˣ) r)) * g₀) * (φ g₀)⁻¹ := by
    funext r
    rw [← hb 1 r, map_one, map_one, Units.val_one, one_mul]
  refine ⟨?_, ?_⟩
  · rw [h1]
    exact (hφc.comp (((continuous_adelicArchGLInclAt F w).comp
      ((continuous_ofRealGL hw).comp continuous_torusGL_fst)).mul continuous_const)).mul continuous_const
  · rw [h2]
    exact (hφc.comp (((continuous_adelicArchGLInclAt F w).comp
      ((continuous_ofRealGL hw).comp continuous_torusGL_snd)).mul continuous_const)).mul continuous_const

private theorem distribHaarChar_realIdeleAt (r : ℝˣ) :
    ((distribHaarChar 𝔸 (realIdeleAt hw r) : ℝ≥0) : ℝ) = |(r : ℝ)| := by
  have hmult : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
  rw [NumberField.AdeleRing.distribHaarChar_eq_prod_norm_pow_mult_of_snd_eq_one F (realIdeleAt hw r)
      (realIdeleAt_snd hw r),
    Finset.prod_eq_single w (fun v _ hvw => by rw [realIdeleAt_fst_of_ne hw r hvw, norm_one, one_pow])
      (fun h => absurd (Finset.mem_univ w) h),
    norm_realIdeleAt_fst_self hw, hmult, pow_one, Real.norm_eq_abs]

private theorem norm_etaFst_realIdeleAt (α : (𝔸)ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ))
    (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    {μ : (𝔸)ˣ →* ℂˣ} (hμ : IsUnitaryChar (𝓞 F) F μ) (s : ℂ) (r : ℝˣ) :
    ‖((etaFst μ α hα s (realIdeleAt hw r) : ℂˣ) : ℂ)‖ = |(r : ℝ)| ^ (s.re + 1 / 2) := by
  rw [norm_etaFst_apply_of_unitary hμ α hα s, hαΔ, distribHaarChar_realIdeleAt hw]

private theorem norm_etaSnd_realIdeleAt (α : (𝔸)ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ))
    (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    {ν : (𝔸)ˣ →* ℂˣ} (hν : IsUnitaryChar (𝓞 F) F ν) (s : ℂ) (r : ℝˣ) :
    ‖((etaSnd ν α hα s (realIdeleAt hw r) : ℂˣ) : ℂ)‖ = |(r : ℝ)| ^ (-(s.re + 1 / 2)) := by
  rw [etaSnd_apply, Units.val_mul, norm_mul, hν, one_mul, norm_cpowChar_apply, hαΔ, distribHaarChar_realIdeleAt hw,
    Complex.neg_re, re_add_half]

private theorem contDiff_slice {χ₁ χ₂ : (𝔸)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    (hc₁ : Continuous fun r : ℝˣ => ((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℝˣ => ((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ))
    (E : ℝ → 𝔸) (hE1 : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y)
    (hE2 : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE3 : ∀ y, (E y).2 = 0)
    (x : AdelicGL2 (𝓞 F) F) (a : 𝔸) :
    ContDiff ℝ ∞ (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)) := by
  obtain ⟨m, kv, c, -, hcs, -, -, hexp⟩ := exists_expansion (archRowIsometrySubgroup F w) φ hφc hK
    (rhoW hw) (rhoW_mem hw) (rhoW_zero hw) (rhoW_add hw) (continuous_rhoW hw) Real.two_pi_pos (rhoW_periodic hw)
  have hΨg : IsOneParamGroup (psiW hw χ₁ χ₂) := isOneParamGroup_psiW hw hc₁ hc₂
  have hg : (gOf hw x).det ≠ 0 := gOf_det_ne_zero hw x
  have hsh : ∀ i, ContDiff ℝ ∞ (fun y =>
      psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w) + y)))
        * c i (angle (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w) + y))) :=
    fun i => (contDiff_mul_comp hg hΨg.contDiff (hcs i)).comp (contDiff_const.add contDiff_id)
  have hfun := funext fun y => slice_translate_eq hw hφ hexp x a hE1 hE2 hE3 y
  rw [hfun]
  exact ContDiff.sum fun i _ => contDiff_const.mul (hsh i)

