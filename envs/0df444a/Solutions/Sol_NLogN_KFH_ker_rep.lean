  obtain ⟨hb, h0⟩ := NLogN.KFH.layer_partner (P := P) (S := S) hρ i hj 0
  obtain ⟨-, h1⟩ := NLogN.KFH.layer_partner (P := P) (S := S) hρ i hj 1
