  rw [List.map_append, vol_append]
  exact Nat.le_mul_of_pos_left _ (vol_pos mz hmz L)

/-- Volumes of the four blocks are at most the total. -/
theorem vol4_le (hmz : ∀ j, 1 ≤ mz j) (A F G C : List ℕ) :
    AModel.vol (A.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (F.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (G.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (C.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [List.append_assoc]; exact vol_le_app mz hmz _ _
  · refine le_trans ?_ (vol_le_app mz hmz (A ++ F ++ G) C)
    refine le_trans ?_ (vol_le_app mz hmz (A ++ F) G)
    exact vol_le_app' mz hmz A F
  · refine le_trans ?_ (vol_le_app mz hmz (A ++ F ++ G) C)
    exact vol_le_app' mz hmz (A ++ F) G
  · exact vol_le_app' mz hmz _ C

end Lay

/-- A move moving a single bit (`vol LF = 2` forward, resp. `vol LG = 2` backward) costs at
most `cMv V w`. -/
theorem mvF_cost (mz : ℕ → ℕ) (hmz : ∀ j, 1 ≤ mz j) (w : ℕ) (LA LG LC : List ℕ) (b : ℕ)
    (hb : asz mz b = 2) :
    cFwdF (AModel.vol (LA.map (asz mz))) (AModel.vol ([b].map (asz mz))) (AModel.vol (LG.map (asz mz)))
        (AModel.vol (LC.map (asz mz))) w +
      cK4 (AModel.vol (LA.map (asz mz))) (AModel.vol ([b].map (asz mz))) (AModel.vol (LG.map (asz mz)))
        (AModel.vol (LC.map (asz mz))) ≤ NLogN.KFU.cMv (AModel.vol ((LA ++ [b] ++ LG ++ LC).map (asz mz))) w := by
  obtain ⟨a1, a2, a3, a4⟩ := vol4_le mz hmz LA [b] LG LC
  have h2 : AModel.vol ([b].map (asz mz)) = 2 := by simp [AModel.vol, hb]
  have e : AModel.vol ((LA ++ [b] ++ LG ++ LC).map (asz mz)) =
      AModel.vol (LA.map (asz mz)) * 2 * AModel.vol (LG.map (asz mz)) * AModel.vol (LC.map (asz mz)) := by
    simp only [List.map_append, vol_append, h2]
  have p1 := vol_pos mz hmz LA; have p3 := vol_pos mz hmz LG; have p4 := vol_pos mz hmz LC
  rw [h2] at a2 ⊢
  set V := AModel.vol ((LA ++ [b] ++ LG ++ LC).map (asz mz))
  have hc := cFwdF_le (AModel.vol (LA.map (asz mz))) 2 (AModel.vol (LG.map (asz mz)))
    (AModel.vol (LC.map (asz mz))) w p4 p3 (by omega) p1
  rw [← e] at hc
  have hk := cK4_le a1 a2 a3 a4
  have hkap : 200 ≤ kap w := by simp [kap]
  unfold NLogN.KFU.cMv
  nlinarith

end NLogN.KFU

