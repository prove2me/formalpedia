-- title:
--   Theorem 2.2: every accumulation point of SPG1 is a constrained stationary point
-- statement:
--   Let $\Omega\subseteq\mathbb R^n$ be closed and convex, let $f$ have continuous partial derivatives on an open set $U\supseteq\Omega$, with gradient $g=\nabla f$, and let $P$ be the orthogonal projection onto $\Omega$. Fix parameters $M\ge1$, $0<\alpha_{\min}<\alpha_{\max}$, $\gamma\in(0,1)$ and $0<\sigma_1<\sigma_2<1$.
--
--   Let $(x_k,\alpha_k)_{k\ge0}$ be an infinite run of the nonmonotone spectral projected gradient method SPG1 (Algorithm 2.1): $x_0\in\Omega$, $\alpha_0\in[\alpha_{\min},\alpha_{\max}]$, Step 1 never stops, each $x_{k+1}=P(x_k-\lambda_k g(x_k))$ is the first trial point accepted by the nonmonotone Armijo test (1) in a backtracking that starts at $\lambda=\alpha_k$ and follows rule (2), and $\alpha_{k+1}$ is the safeguarded spectral step. Then every accumulation point $\bar x$ of $(x_k)$ satisfies
--
--   $$
--   \langle g(\bar x),x-\bar x\rangle\ge0\qquad\text{for all } x\in\Omega .
--   $$
--
--   This is the global convergence result for SPG1: whatever the starting point and whatever admissible choices are made during backtracking, the method cannot accumulate at a nonstationary point.
--
--   **Formalization Note** "Accumulation point" is `MapClusterPt x̄ atTop x`. The statement is as printed: no bounded level set, no Lipschitz gradient and no convexity of $f$ is assumed. The run predicate is `IsSPG1Run`; it requires Step 1 never to fire, since only then is there an infinite sequence.
-- source:
--   Birgin, Martínez & Raydan, Nonmonotone Spectral Projected Gradient Methods on Convex Sets, authors' updated version (July 2004) of SIAM J. Optim. 10(4) (2000), https://www.ime.unicamp.br/~martinez/bmr.pdf, p. 5, Theorem 2.2 (second clause)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_SpectralProjGrad_Shared_IsConstrainedStationary
import Definitions.Def_SpectralProjGrad_SPG1_IsSPG1Run

namespace SpectralProjGrad.SPG1

/-- Theorem 2.2, second clause: every accumulation point `x̄` of the sequence `{x_k}` generated by
Algorithm SPG1 (when Step 1 never stops) is a constrained stationary point:
`⟨g(x̄), x - x̄⟩ ≥ 0` for all `x ∈ Ω`. -/
theorem accumulation_point_stationary {n : ℕ}
    {Ω U : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → ℝ}
    {P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)}
    {M : ℕ} {αmin αmax γ σ₁ σ₂ : ℝ}
    (hΩ_closed : IsClosed Ω) (hΩ_convex : Convex ℝ Ω)
    (hU_open : IsOpen U) (hΩU : Ω ⊆ U) (hf : ContDiffOn ℝ 1 f U)
    (hP : SpectralProjGrad.Shared.IsProjOnto Ω P)
    (hM : 1 ≤ M) (hαmin : 0 < αmin) (hαmin_lt : αmin < αmax)
    (hγ : γ ∈ Set.Ioo 0 1) (hσ₁ : 0 < σ₁) (hσ₁₂ : σ₁ < σ₂) (hσ₂ : σ₂ < 1)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {α : ℕ → ℝ}
    (hrun : IsSPG1Run Ω f P M αmin αmax γ σ₁ σ₂ x α)
    (xbar : EuclideanSpace ℝ (Fin n)) (hxbar : MapClusterPt xbar Filter.atTop x) :
    SpectralProjGrad.Shared.IsConstrainedStationary Ω f xbar := by sorry

end SpectralProjGrad.SPG1
