    (E : ℕ) (hE : 1 ≤ E) (w : Oˣ) (a : O) (ha : a = (w : O) * ϖ ^ E)
    (m : ↥(CrossingQuotient.crossingScheme a))
    (hm : CrossingQuotient.U a ∈ m.asIdeal ∧ CrossingQuotient.V a ∈ m.asIdeal) :
