attribute [local instance] Classical.propDecidable Classical.decEq

variable {d : ℕ} [NeZero d]

/-- Section 2, PDF p.10 and Figure p.14: closed triangle implies a channel;
the real modulus ordering is exactly a(a+2b)>=0. Denominators require d>=2. -/
theorem channelTriangleRegion (hd : 2 ≤ d) (G : AddSubgroup (WeylLabel d))
    (hcard : (G : Set (WeylLabel d)).ncard = d) (a b : ℝ) :
    ((a,b) ∈ channelTriangle d →
      (∀ g, (fourier (twoSymbol G (a : ℂ) (b : ℂ)) g).im = 0 ∧
        0 ≤ (fourier (twoSymbol G (a : ℂ) (b : ℂ)) g).re) ∧
      (∑ g, fourier (twoSymbol G (a : ℂ) (b : ℂ)) g) = 1 ∧
      IsChannel (twoMap G (a : ℂ) (b : ℂ))) ∧
    (‖(b : ℂ)‖ ≤ ‖(a : ℂ) + (b : ℂ)‖ ↔ 0 ≤ a * (a + 2*b)) ∧
    ((a,b) ∈ channelTriangle d → MaximalDegenerate G → 0 ≤ a * (a + 2*b) →
      UniversalMultiplicative 2 (twoMap G (a : ℂ) (b : ℂ))) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

end
