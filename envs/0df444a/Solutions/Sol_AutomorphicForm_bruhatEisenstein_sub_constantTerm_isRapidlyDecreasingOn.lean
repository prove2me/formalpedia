  (levelBasis F 𝔫 h𝔫).repr (stdBasis F i) j

private theorem dirCoordSig_inl {w : InfinitePlace F} (hw : w.IsReal) :
    dirCoordSig F 𝔫 h𝔫 (Sum.inl ⟨w, hw⟩) = archDirCoord hw 𝔫 h𝔫 := by
  funext j
  rw [dirCoordSig, stdBasis_inl]
  rfl

