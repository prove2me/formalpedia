-- title:
--   Suppressing a two-valent vertex preserves planarity
-- statement:
--   For a permutation $\sigma$ of a finite set $D$ of darts, $c(\sigma)$ is its number of cycles. A pair $(\sigma,\theta)$ is planar if $c(\sigma)+c(\theta)+c(\sigma\theta)=|D|+2k$, where $k$ is the number of components of the relation generated by both permutations. Let $(\sigma,\theta)$ be planar with $\theta$ an involution, and let $\{x,y\}$ be a two-valent vertex: $\sigma x=y$, $\sigma y=x$, $x\ne y$, with $\theta x\ne x$, $\theta x\ne y$, $\theta y\ne y$. Then
--   $$
--   \bigl((x\ y)\sigma,\ \mathrm{supp}(\theta,x,y)\bigr)\text{ is planar}.
--   $$
--
--   Repeated suppression removes degree-two vertices created by capping without leaving genus zero.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/Suppression.lean#L321-L337

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

theorem OAI.KervaireRibbon.planar_suppress (σ θ : Equiv.Perm D) (hθ : ∀ d, θ (θ d) = d)
    {x y : D} (hxy : x ≠ y) (hsx : σ x = y) (hsy : σ y = x)
    (hx : θ x ≠ x) (hxy' : θ x ≠ y) (hy : θ y ≠ y) (hp : planar σ θ) :
    planar (swap x y * σ) (suppress θ x y) := by sorry
