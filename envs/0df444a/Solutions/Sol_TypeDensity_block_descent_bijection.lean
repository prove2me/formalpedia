      rw [hmp, TypeDensity.conjugateProduct, ← hBp]
      exact Finset.prod_congr rfl (fun i _ => (hconj i).symm)
    funext j
    unfold TypeDensity.descendBlock
    rw [hcp, Polynomial.coeff_map, (TypeDensity.monic_poly_reconstruct O _ a).2.2.1 j,
