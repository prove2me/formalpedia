        (youngHomogeneousEmbedding lam q)).mpr
        ((mem_harmonicYoungSubmodule lam
          (q : PolynomialSpace r n)).mp q.property).2.2.1⟩
  exact simultaneousHarmonicProjection_polynomialInner p.val q'
end
