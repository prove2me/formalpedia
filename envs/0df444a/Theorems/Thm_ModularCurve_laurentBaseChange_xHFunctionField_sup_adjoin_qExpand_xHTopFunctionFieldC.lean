theorem ModularCurve.laurentBaseChange_xHFunctionField_sup_adjoin_qExpand_xHTopFunctionFieldC
    (L : Type*) [Field L] [Algebra ℚ L] (N p : ℕ) [NeZero N] [NeZero p] (M : ℕ) [NeZero M]
    (hM : M = N * p) (H' : Subgroup (ZMod N)ˣ) (H : Subgroup (ZMod M)ˣ)
    (hle : CohCarrier.GammaH M H ≤ CohCarrier.GammaH N H') :
    ModularCurve.laurentBaseChange L (ModularCurve.xHFunctionField M H) ⊔
        IntermediateField.adjoin L (ModularCurve.qExpand L p ''
          (ModularCurve.laurentBaseChange L (ModularCurve.xHTopFunctionFieldC ℚ N H' (N * p)) :
            Set (LaurentSeries L)))
      = ModularCurve.laurentBaseChange L (ModularCurve.xHTopFunctionFieldC ℚ M H (M * p)) := by sorry
