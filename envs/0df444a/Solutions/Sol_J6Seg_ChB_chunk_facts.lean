  have hbig : 4 * lam * 2 ^ (2 * pk) < 2 ^ (b - 1) := by
    have h4 : 4 * lam < 2 ^ (Q + 2) := by
      have : 2 ^ (Q + 2) = 4 * 2 ^ Q := by rw [pow_add]; ring
