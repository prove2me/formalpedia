section Generic

variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem inv_val_congr (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (x₁ : SchemeHomOver t₁ f) (x₂ : SchemeHomOver t₂ f) (hx : x₁.1 = x₂.1) : (L.inv t₁ x₁).1 = (L.inv t₂ x₂).1 := by
  subst h
  rw [Subtype.ext hx]

theorem comp_inv_val (L : RelativeGroupLaw R f) {T T' : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (ψ : T' ⟶ T)
    (x : SchemeHomOver t f) :
    ψ ≫ (L.inv t x).1 = (L.inv (ψ ≫ t) ⟨ψ ≫ x.1, by rw [Category.assoc, x.2]⟩).1 := by
  letI i1 : Group (SchemeHomOver t f) := L.pointGroup t
  letI i2 : Group (SchemeHomOver (ψ ≫ t) f) := L.pointGroup (ψ ≫ t)
  let F : SchemeHomOver t f →* SchemeHomOver (ψ ≫ t) f :=
    MonoidHom.mk' (GoodReductionJacobian.schemeHomOverComp ψ rfl) (fun a b => L.mul_natural t _ ψ rfl a b)
  have h := map_inv F x
  exact congrArg Subtype.val h

end Generic

section Compat

variable {S S' : Type u} [CommRing S] [CommRing S'] (φ : S →+* S')
  {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of S)} {f' : A' ⟶ Spec (CommRingCat.of S')} {g : A' ⟶ A}

theorem inv_comp_g (hg : IsPullback g f' f (Spec.map (CommRingCat.ofHom φ)))
    (L : RelativeGroupLaw S f) (L' : RelativeGroupLaw S' f')
    (hmul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S')) (P Q : SchemeHomOver t' f'),
      (L'.mul t' P Q).1 ≫ g =
        (L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)
    {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' f') :
    (L'.inv t' P).1 ≫ g =
      (L.inv (t' ≫ Spec.map (CommRingCat.ofHom φ)) ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩).1 := by
  letI i1 : Group (SchemeHomOver t' f') := L'.pointGroup t'
  letI i2 : Group (SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) f) := L.pointGroup _
  let F : SchemeHomOver t' f' →* SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) f :=
    MonoidHom.mk' (fun P => ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩) (fun a b => Subtype.ext (hmul t' a b))
  have h := map_inv F P
  exact congrArg Subtype.val h

theorem negMor_comp (hg : IsPullback g f' f (Spec.map (CommRingCat.ofHom φ)))
    (L : RelativeGroupLaw S f) (L' : RelativeGroupLaw S' f')
    (hmul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S')) (P Q : SchemeHomOver t' f'),
      (L'.mul t' P Q).1 ≫ g =
        (L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) :
    negMor f' L' ≫ g = g ≫ negMor f L := by
  show (L'.inv f' (idPt f')).1 ≫ g = g ≫ (L.inv f (idPt f)).1
  rw [inv_comp_g φ hg L L' hmul, comp_inv_val]
  exact inv_val_congr L hg.w.symm _ _ (by simp [idPt])

end Compat

section LevelIso

variable {X Y : Scheme.{u}} (jk : Y ⟶ X) (negR : X ⟶ X) (negk : Y ⟶ Y) (h : jk ≫ negR = negk ≫ jk)
  (𝓛₀ : X.Modules) (𝓜 : Y.Modules) (e : (Scheme.Modules.pullback jk).obj 𝓛₀ ≅ 𝓜)

noncomputable def negIso :
    (Scheme.Modules.pullback jk).obj ((Scheme.Modules.pullback negR).obj 𝓛₀) ≅ (Scheme.Modules.pullback negk).obj 𝓜 :=
  (Scheme.Modules.pullbackComp jk negR).app 𝓛₀ ≪≫ (Scheme.Modules.pullbackCongr h).app 𝓛₀ ≪≫
    ((Scheme.Modules.pullbackComp negk jk).app 𝓛₀).symm ≪≫ (Scheme.Modules.pullback negk).mapIso e

noncomputable def levelIso :
    (Scheme.Modules.pullback jk).obj (𝓛₀ ⊗ (Scheme.Modules.pullback negR).obj 𝓛₀) ≅
      𝓜 ⊗ (Scheme.Modules.pullback negk).obj 𝓜 :=
  Scheme.Modules.pullbackTensorObjIso jk 𝓛₀ _ ≪≫ tensorIso e (negIso jk negR negk h 𝓛₀ 𝓜 e)

noncomputable def levelSymIso (σ : (Scheme.Modules.pullback negk).obj 𝓜 ≅ 𝓜) :
    (Scheme.Modules.pullback jk).obj ((Scheme.Modules.pullback negR).obj 𝓛₀) ≅ (Scheme.Modules.pullback jk).obj 𝓛₀ :=
  negIso jk negR negk h 𝓛₀ 𝓜 e ≪≫ σ ≪≫ e.symm

end LevelIso

