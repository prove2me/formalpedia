-- title:
--   (6.5) — pathwise bound $\frac{1}{k+1}\tilde\delta_k(D) \le \frac{\hat\beta_{k+1}}{k+1}(\gamma D + L^2/(2\sigma\gamma))$
-- statement:
--   Under the standing assumptions of §6 (prox-function $d$ with $\sigma > 0$, argmin map $\pi_\beta$, Assumptions 1–2 with constant $L$), fix $\gamma > 0$ and any realization $\tilde\xi_0, \tilde\xi_1, \dots \in \Xi$ of the samples, and let $\tilde x_0, \tilde x_1, \dots$ be the points generated by the method of stochastic simple averages (6.3) on it. For $D \ge 0$ let
--   $$\tilde\delta_k(D) = \max_x\Big\{ \sum_{i=0}^k \langle f'(\tilde x_i, \tilde\xi_i), \tilde x_i - x\rangle : x \in \mathcal F_D\Big\} \qquad (6.4).$$
--   Then for every $k \ge 0$ and $D \ge 0$,
--   $$\frac{1}{k+1}\,\tilde\delta_k(D) \le \frac{\hat\beta_{k+1}}{k+1}\Big(\gamma D + \frac{L^2}{2\sigma\gamma}\Big).$$
--
--   This is the uniform, sample-by-sample bound on the gap of a stochastic run; it is the first step of the proof of Theorem 7.
--
--   **Formalization Note** $S_k = k+1$ is written as $k+1$. The sample path is an arbitrary sequence in $\Xi$; no probability is involved in this statement.
-- source:
--   Nesterov, Primal-dual subgradient methods for convex problems, Math. Program. 120 (2009), §6, (6.5), p. 26

import Mathlib
import Definitions.Def_PrimalDualSubgrad_Stoch_ProxSetting
import Definitions.Def_PrimalDualSubgrad_Stoch_SSA

namespace PrimalDualSubgrad.Stoch

open Finset MeasureTheory

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
variable {Ξ : Type*} [MeasurableSpace Ξ]

/-- Nesterov 2009, §6, (6.5), p. 26: along every sample path `ω`, the gap (6.4) of the SSA run
satisfies `(1/S_k) δ̃_k(D) ≤ β̂_{k+1}/(k+1) · (γD + L²/(2σγ))`, `S_k = k + 1`, for `D ≥ 0`. -/
theorem eq_6_5 (Q : Set E) (d : E → ℝ) (σ : ℝ) (x0 : E) (hd : ProxFunction Q d σ x0)
    (π : ℝ → StrongDual ℝ E → E) (hπ : IsArgminMap Q d π)
    (μ : Measure Ξ) [IsProbabilityMeasure μ] (f : E → Ξ → ℝ) (f' : E → Ξ → StrongDual ℝ E)
    (L : ℝ) (hf : StochOracle Q μ f f' L)
    (γ : ℝ) (hγ : 0 < γ) (ω : ℕ → Ξ) (k : ℕ) (D : ℝ) (hD : 0 ≤ D) :
    1 / ((k : ℝ) + 1) * gap Q d (fun i => f' (ssaRun π γ x0 f' ω i) (ω i)) (ssaRun π γ x0 f' ω) k D
      ≤ betaHat (k + 1) / ((k : ℝ) + 1) * (γ * D + L ^ 2 / (2 * σ * γ)) := by sorry

end PrimalDualSubgrad.Stoch
