  rw [qK]
  calc 2 * max (2 ^ p) (BW q) * cSq q ^ K ≤ 2 * 2 ^ (p + 19 + 2 * (K * Z)) * (2 ^ (3 * B + 10)) ^ K :=
        Nat.mul_le_mul (Nat.mul_le_mul_left _ hmax) (Nat.pow_le_pow_left hcS K)
    _ = 2 ^ (p + Xq q B) := by
        unfold Xq
        rw [qK, ← pow_succ', ← pow_mul, ← pow_add]
        congr 1
        ring

theorem Xq_small (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    Xq (mkParams K N) (Nat.size (mkParams K N).b) + 1 ≤ (mkParams K N).p / 8 := by
  have h := pf_of_large K hK N hN
  have hp := h.p_eq
  have hX := h.X64
  have hB64 := h.B64
  have hEb := h.Eb
  have hB8 := h.B8
  have hbB' := h.bB'
  set q := mkParams K N with hq
  have qK : q.K = K := rfl
  have qα : q.α = K * (ceilSqrt (ceilSqrt q.b) + 2) := rfl
  set b := q.b
  set B := Nat.size b
  set p := q.p
  set α := q.α
  set c := ceilSqrt (ceilSqrt b)
  have hp5 : p ≤ 5 * b := by omega
  have hp2 : 2 * b ≤ p := by omega
  -- `c² ≥ R`
  set R := 320 * (4 * B + 22)
  have hR : R ^ 2 ≤ b := by
    have := pow_big (B - 1) (by omega)
    have e : R ^ 2 = 102400 * (4 * (B - 1) + 26) ^ 2 := by
      simp only [R]; rw [show 4 * B + 22 = 4 * (B - 1) + 26 by omega]; ring
    omega
  have hc4 : b ≤ (c ^ 2) ^ 2 := by
    have h1 := le_ceilSqrt_sq b
    have h2 := le_ceilSqrt_sq (ceilSqrt b)
    exact h1.trans (Nat.pow_le_pow_left h2 2)
  have hRc : R ≤ c ^ 2 := (Nat.pow_le_pow_iff_left (by norm_num)).1 (hR.trans hc4)
  -- `K (J - 1) c² ≤ 4p`
  set J := Jm q
  have hJ1 : (J - 1) * α ^ 2 ≤ 4 * K * p := by
    simp only [J, Jm, qK, Nat.add_sub_cancel]; exact Nat.div_mul_le_self _ _
  have hαc : K * c ≤ α := by rw [qα]; exact Nat.mul_le_mul_left _ (by omega)
  have hKJ : K * (J - 1) * c ^ 2 ≤ 4 * p := by
    have h1 : K * (K * (J - 1) * c ^ 2) ≤ K * (4 * p) := by
      calc K * (K * (J - 1) * c ^ 2) = (J - 1) * (K * c) ^ 2 := by ring
        _ ≤ (J - 1) * α ^ 2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hαc 2)
        _ ≤ 4 * K * p := hJ1
        _ = K * (4 * p) := by ring
    exact Nat.le_of_mul_le_mul_left h1 (by omega)
  have hmain : K * (J - 1) * (4 * B + 22) * 320 ≤ 20 * b := by
    calc K * (J - 1) * (4 * B + 22) * 320 = K * (J - 1) * R := by simp only [R]; ring
      _ ≤ K * (J - 1) * c ^ 2 := Nat.mul_le_mul_left _ hRc
      _ ≤ 4 * p := hKJ
      _ ≤ 4 * (5 * b) := Nat.mul_le_mul_left 4 hp5
      _ = 20 * b := by ring
  have hsplit : K * J * (4 * B + 22) = K * (J - 1) * (4 * B + 22) + K * (4 * B + 22) := by
    have : J = (J - 1) + 1 := by simp only [J, Jm, Nat.add_sub_cancel]
    conv_lhs => rw [this]
    ring
  have hKB : K * (9 * B + 44) ≤ B * (9 * B + 44) := Nat.mul_le_mul_right _ (by omega)
  have hBb : 16 * (21 + B * (9 * B + 44)) ≤ b := by
    have : 16 * (21 + B * (9 * B + 44)) ≤ R ^ 2 := by simp only [R]; nlinarith
    omega
  unfold Xq
  rw [qK, hsplit]
  have e : 2 * K * (B + 6) + K * (3 * B + 10) + K * (4 * B + 22) = K * (9 * B + 44) := by ring
  omega

/-- The size statement: `log₂ Bq ≤ (1 + 1/8) p`. -/
theorem Bq_size (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    Nat.size (Bq (mkParams K N)) ≤ (mkParams K N).p + (mkParams K N).p / 8 := by
  have h1 := Bq_le_pow K N hK hN
  have h2 := Xq_small K N hK hN
  apply Nat.size_le.2
  calc Bq (mkParams K N) < 2 ^ ((mkParams K N).p + Xq (mkParams K N) (Nat.size (mkParams K N).b) + 1) :=
        lt_of_le_of_lt h1 (Nat.pow_lt_pow_right (by norm_num) (by omega))
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)

/-- The Fermat encoder condition: `Bq < 2^P`. -/
theorem Bq_lt (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    Bq (mkParams K N) < 2 ^ (mkParams K N).P := by
  have h := pf_of_large K hK N hN
  have hs := Bq_size K N hK hN
  have := Nat.size_le.1 hs
  refine lt_of_lt_of_le this (Nat.pow_le_pow_right (by norm_num) ?_)
  rw [h.P_eq]; omega

theorem BC_le_BF (q : Params) : BC q ≤ BF q := by
  unfold BF; exact Nat.le_mul_of_pos_left _ (Nat.one_le_pow _ _ (cBq_pos q))

theorem BW_le_Bq (q : Params) : BW q ≤ Bq q := by
  unfold Bq
  have := Nat.one_le_pow q.K _ (cSq_pos q)
  calc BW q ≤ max (2 ^ q.p) (BW q) := le_max_right _ _
    _ ≤ 2 * max (2 ^ q.p) (BW q) * 1 := by omega
    _ ≤ 2 * max (2 ^ q.p) (BW q) * cSq q ^ q.K := Nat.mul_le_mul_left _ this

theorem pow_p_le_Bq (q : Params) : 2 ^ q.p ≤ Bq q := by
  unfold Bq
  have := Nat.one_le_pow q.K _ (cSq_pos q)
  calc 2 ^ q.p ≤ max (2 ^ q.p) (BW q) := le_max_left _ _
    _ ≤ 2 * max (2 ^ q.p) (BW q) * 1 := by omega
    _ ≤ 2 * max (2 ^ q.p) (BW q) * cSq q ^ q.K := Nat.mul_le_mul_left _ this

/-- `BF ≤ BW` when `2^(p+9) ≤ BC` (true for `mkParams`). -/
theorem BF_le_BW (q : Params) (h : 2 ^ (q.p + 9) ≤ BC q) : 2 * BF q + 2 ≤ BW q := by
  unfold BW
  have hBF : 2 ^ (q.p + 9) ≤ BF q := h.trans (BC_le_BF q)
  apply (Nat.le_div_iff_mul_le (by positivity)).2
  have e : 2 ^ (q.p + 9) = 2 ^ q.p * 512 := by rw [pow_add]; norm_num
  rw [e] at hBF
  have h1 : 1 ≤ 2 ^ q.p := Nat.one_le_two_pow
  nlinarith

theorem stageS_le_Bq (q : Params) {k : ℕ} (hk : k ≤ q.K) {B : ℕ} (hB : B ≤ max (2 ^ q.p) (BW q)) :
    cSq q ^ k * B ≤ Bq q := by
  unfold Bq
  have := Nat.pow_le_pow_right (cSq_pos q) hk
  calc cSq q ^ k * B ≤ cSq q ^ q.K * max (2 ^ q.p) (BW q) := Nat.mul_le_mul this hB
    _ ≤ 2 * max (2 ^ q.p) (BW q) * cSq q ^ q.K := by
        rw [mul_comm (cSq q ^ q.K)]; exact Nat.mul_le_mul_right _ (by omega)

theorem stageB_le_BF (q : Params) {k : ℕ} (hk : k ≤ q.K) : cBq q ^ k * BC q ≤ BF q := by
  unfold BF; exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (cBq_pos q) hk)

/-- The stage after `k` axes is bounded with the exponent `min k K`. -/
theorem tensorGo_take_LB' (c : ℕ) (hc : 1 ≤ c) (As : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ))))
    (hA : ∀ a ∈ As, ∀ X B, LB X B → LB (a.2 X) (c * B)) (dims : List ℕ)
    {L : List (ℤ × ℤ)} {B : ℕ} (hL : LB L B) (k : ℕ) :
    LB (tensorGo (As.take k) dims L) (c ^ min k As.length * B) := by
  have h := tensorGo_LB_mul c hc (As.take k) (fun a ha => hA a (List.mem_of_mem_take ha)) dims hL
  simpa using h

