section s215
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreDegree
attribute [local instance] Classical.propDecidable
lemma heads_count (b : Core) (t : ℕ) (v : Fin b.input.n) :
    (heads b t).count v = (Exact.adjacency (reverseGraph b) t v).length := by
  induction t with
  | zero => simp [heads,Exact.adjacency]
  | succ t ih =>
    by_cases ht : t < b.input.k
    · by_cases hv : b.input.graph.head ⟨t,ht⟩ = v
      · simp [heads,Exact.adjacency,reverseGraph,ht,hv,ih,List.count_cons]
      · simp [heads,Exact.adjacency,reverseGraph,ht,hv,ih,List.count_cons]
    · simp [heads,Exact.adjacency,ht,ih]
lemma heads_final (b : Core) (v : Fin b.input.n) : (heads b b.input.k).count v = indegree b v := by
  have heq : (Exact.adjacency (reverseGraph b) b.input.k v).toFinset =
      Finset.univ.filter (fun e => b.input.graph.head e = v) := by
    ext e
    simp only [List.mem_toFinset,Exact.adjacency_mem,Finset.mem_filter,Finset.mem_univ,true_and,reverseGraph]
    exact and_iff_right e.isLt
  rw [heads_count,← List.toFinset_card_of_nodup (Exact.adjacency_nodup (reverseGraph b) b.input.k v),heq]
  unfold indegree
  by_cases hv : v = b.input.source
  · rw [if_pos hv]
    have hempty : Finset.univ.filter (fun e => b.input.graph.head e = v) = ∅ := by
      apply Finset.filter_eq_empty_iff.mpr
      intro e he hhead
      exact b.no_incoming_source e (hhead.trans hv)
    rw [hempty]
    rfl
  · rw [if_neg hv]
lemma Image.final (b : Core) (base : ℕ) (s : Structured.Data) (h : Image base (heads b b.input.k) s) :
    ∀ v, s.natMem (base+2*v.val) = indegree b v := fun v => (h.entries v).trans (heads_final b v)
end DecrAlmostLinearSSSP.Decremental.CoreDegree
end s215
