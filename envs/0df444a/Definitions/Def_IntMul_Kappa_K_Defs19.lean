-- Source module: Solutions.KFNWrap
/-!
# KFN: running a stream program on one role

`wrapC W L w e code`: swap role `w` to the front (one pair pass), run `code` on the first
segment (the other roles stay below it on the data stack), bring the other roles to the new
scale `F + e` (leveling atoms `0 · role 0`), and swap back.

**`rImpl_onRole`**: if `code` implements a selected-bit operator `Tw` on single streams
(`SImpl`), the wrapper implements every network operator `A` that acts as `Tw` on role `w` and
as the identity on the other roles (`roleOpF_phase`, `roleOpF_rowAdd`, `roleOpF_child`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

/-! ## Widths and costs with a general scale window -/

section Bounds2

end Bounds2

/-! ## Segments of the encoding -/

section Seg

end Seg

/-! ## The wrapper -/

section Wrap

/-- The swap bringing role `w` to the front (none for `w = 0`). -/
def swL (w : ℕ) : List (ℕ × ℕ) := if w = 0 then [] else [(0, w)]

/-- Run `code` (scale `+e`) on role `w`. -/
def wrapC (W L w e : ℕ) (code : RS) : RS :=
  .seq (swapsP L (NLogN.KFN.swL w)) (.seq code
    (.seq (gateP (levA W 0) (Function.update (fun _ => 0) 0 e) L) (swapsP L (NLogN.KFN.swL w))))

/-- Cost of the wrapper around a program of cost `cost`. -/
def cWrapR (W L Z e dw : ℕ) (cost : ℕ → ℕ) (w : ℕ) : ℕ :=
  cost w + (W + 2) * cAtom (w + dw + (e + 2) * W) e L W Z + 3

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

end Wrap

end NLogN.KFN

end

