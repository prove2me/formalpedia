namespace M1Glue

theorem mem_span_closure_of_mem_ringClosure
    {L E : Type} [Field L] [Field E] [Algebra L E] (S : Set E) {x : E}
    (hx : x ∈ Subring.closure (Set.range (algebraMap L E) ∪ S)) :
    ∃ (n : ℕ) (c : Fin n → L) (v : Fin n → ↥(Submonoid.closure S)), ∑ i, c i • (v i : E) = x := by
  have hle : Subring.closure (Set.range (algebraMap L E) ∪ S) ≤ (Algebra.adjoin L S).toSubring := by
    refine Subring.closure_le.mpr ?_
    rintro y (⟨c, rfl⟩ | hy)
    · exact Subalgebra.algebraMap_mem _ c
    · exact Algebra.subset_adjoin hy
  have hx' : x ∈ (Algebra.adjoin L S).toSubmodule := hle hx
  rw [Algebra.adjoin_eq_span] at hx'
  exact Submodule.mem_span_set'.mp hx'

theorem exists_quot_span_of_mem_laurentBaseChange
    (L : Type) [Field L] [Algebra ℚ L] (F₁ : IntermediateField ℚ (LaurentSeries ℚ))
    (F₀ : Subfield ↥(laurentBaseChange L F₁))
    (hF₀ : ∀ (x : LaurentSeries ℚ) (hx : x ∈ F₁),
      (⟨coeffEmb L x, coeffEmb_mem_laurentBaseChange L hx⟩ : ↥(laurentBaseChange L F₁)) ∈ F₀)
    {K : Type} [Field K] (j₀ : K →+* ↥(laurentBaseChange L F₁))
    (hj₀ : ∀ s : ↥(laurentBaseChange L F₁), s ∈ F₀ → ∃ g : K, j₀ g = s)
    (f : ↥(laurentBaseChange L F₁)) :
    ∃ (n : ℕ) (c : Fin n → L) (g : Fin n → K) (d : Fin n → L) (g' : Fin n → K),
      (∑ i, d i • j₀ (g' i)) ≠ 0 ∧ f * (∑ i, d i • j₀ (g' i)) = ∑ i, c i • j₀ (g i) := by
  classical
  set S : Set (LaurentSeries L) := ⇑(coeffEmb L) '' (F₁ : Set (LaurentSeries ℚ)) with hS

  have hmon : ∀ s ∈ Submonoid.closure S,
      ∃ hs : s ∈ laurentBaseChange L F₁, (⟨s, hs⟩ : ↥(laurentBaseChange L F₁)) ∈ F₀ := by
    intro s hs
    induction hs using Submonoid.closure_induction with
    | mem y hy =>
        obtain ⟨x, hx, rfl⟩ := hy
        exact ⟨coeffEmb_mem_laurentBaseChange L hx, hF₀ x hx⟩
    | one =>
        refine ⟨one_mem _, ?_⟩
        have h1 : (⟨(1 : LaurentSeries L), one_mem _⟩ : ↥(laurentBaseChange L F₁)) = 1 := rfl
        rw [h1]; exact one_mem F₀
    | mul a b _ _ iha ihb =>
        obtain ⟨ha, haF⟩ := iha
        obtain ⟨hb, hbF⟩ := ihb
        refine ⟨mul_mem ha hb, ?_⟩
        have hm : (⟨a * b, mul_mem ha hb⟩ : ↥(laurentBaseChange L F₁)) = ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
        rw [hm]; exact mul_mem haF hbF

  have hspanF : ∀ y ∈ Subring.closure (Set.range (algebraMap L (LaurentSeries L)) ∪ S),
      ∃ (n : ℕ) (c : Fin n → L) (g : Fin n → K),
        ((∑ i, c i • j₀ (g i) : ↥(laurentBaseChange L F₁)) : LaurentSeries L) = y := by
    intro y hy0
    obtain ⟨n, c, v, hv⟩ := mem_span_closure_of_mem_ringClosure S hy0
    have hvF : ∀ i, ∃ g : K, ((j₀ g : ↥(laurentBaseChange L F₁)) : LaurentSeries L) = (v i : LaurentSeries L) := by
      intro i
      obtain ⟨hs, hsF⟩ := hmon (v i) (v i).2
      obtain ⟨g, hg⟩ := hj₀ _ hsF
      exact ⟨g, by rw [hg]⟩
    choose g hg using hvF
    refine ⟨n, c, g, ?_⟩
    rw [← hv]
    push_cast
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hg i]

  have hf : (f : LaurentSeries L) ∈ Subfield.closure (Set.range (algebraMap L (LaurentSeries L)) ∪ S) :=
    mem_laurentBaseChange_iff.mp f.2
  obtain ⟨y, hy, z, hz, hyz⟩ := Subfield.mem_closure_iff.mp hf
  obtain ⟨n₁, c, g, hcg⟩ := hspanF y hy
  obtain ⟨n₂, d, g', hdg⟩ := hspanF z hz
  by_cases hz0 : z = 0
  ·
    have hf0 : f = 0 := by
      apply Subtype.ext
      have : (f : LaurentSeries L) = y / z := hyz.symm
      rw [this, hz0, div_zero]
      rfl
    refine ⟨1, fun _ => 0, fun _ => 1, fun _ => 1, fun _ => 1, ?_, ?_⟩
    · rw [Fin.sum_univ_one]
      show (1 : L) • j₀ 1 ≠ 0
      rw [one_smul, map_one]; exact one_ne_zero
    · rw [hf0, zero_mul, Fin.sum_univ_one]
      show (0 : ↥(laurentBaseChange L F₁)) = (0 : L) • j₀ 1
      rw [zero_smul]
  · refine ⟨n₁ + n₂, Fin.append c (fun _ => 0), Fin.append g (fun _ => 1),
      Fin.append (fun _ => (0 : L)) d, Fin.append (fun _ => (1 : K)) g', ?_, ?_⟩
    · have h1 : (∑ i, Fin.append (fun _ : Fin n₁ => (0 : L)) d i • j₀ (Fin.append (fun _ : Fin n₁ => (1 : K)) g' i)) =
          ∑ i, d i • j₀ (g' i) := by
        simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, zero_smul, Finset.sum_const_zero, zero_add]
      rw [h1]
      intro h0
      apply hz0
      rw [← hdg, h0]
      rfl
    · apply Subtype.ext
      have h1 : (∑ i, Fin.append (fun _ : Fin n₁ => (0 : L)) d i • j₀ (Fin.append (fun _ : Fin n₁ => (1 : K)) g' i)) =
          ∑ i, d i • j₀ (g' i) := by
        simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, zero_smul, Finset.sum_const_zero, zero_add]
      have h2 : (∑ i, Fin.append c (fun _ : Fin n₂ => (0 : L)) i • j₀ (Fin.append g (fun _ : Fin n₂ => (1 : K)) i)) =
          ∑ i, c i • j₀ (g i) := by
        simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, zero_smul, Finset.sum_const_zero, add_zero]
      rw [h1, h2, MulMemClass.coe_mul, hcg, hdg, ← hyz]
      have hz' : (z : LaurentSeries L) ≠ 0 := hz0
      field_simp

theorem coeff_algebraMap_mem
    (L : Type) [Field L] (F : IntermediateField L (LaurentSeries L)) (K₀ : Subfield L)
    (c : L) (hc : c ∈ K₀) (n : ℤ) :
    ((algebraMap L ↥F c : ↥F) : LaurentSeries L).coeff n ∈ K₀ := by
  have h1 : ((algebraMap L ↥F c : ↥F) : LaurentSeries L) = algebraMap L (LaurentSeries L) c := rfl
  rw [h1, algebraMap_laurentSeries_eq_single]
  by_cases hn : n = 0
  · subst hn; rw [HahnSeries.coeff_single_same]; exact hc
  · rw [HahnSeries.coeff_single_of_ne hn]; exact zero_mem K₀

theorem algebraMap_mem_igusaRing
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ)) (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (ℓ : CuspidalType.ProjLine q) (a : ↥A) :
    algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OIg ℓ := by
  have hinf : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OIg (lineInfty q) := by
    refine (hIg_inf _).mpr ⟨HahnSeries.single 0 a, 1, ?_, ?_⟩
    · rw [map_one]; exact one_ne_zero
    · rw [map_one, mul_one, coeffMap_single]
      show algebraMap (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) (a : AlgebraicClosure ℚ) = _
      rw [algebraMap_laurentSeries_eq_single]
      rfl
  obtain ⟨γ, -, -, hℓ⟩ := hIg ℓ
  rw [hℓ, ValuationSubring.mem_comap]
  have hfix : (levelAutBar q M' ζ γ).toAlgHom.toRingHom
      (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ)) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) :=
    (levelAutBar q M' ζ γ).toAlgHom.commutes _
  rw [hfix]
  exact hinf

end M1Glue

namespace M10R

theorem coeffMap_ofPowerSeries {R S : Type} [CommRing R] [CommRing S] (f : R →+* S) (p : PowerSeries R) :
    coeffMap f (HahnSeries.ofPowerSeries ℤ R p) = HahnSeries.ofPowerSeries ℤ S (p.map f) := by
  ext k
  rw [coeffMap_coeff]
  rcases le_or_gt 0 k with hk | hk
  · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
    rw [HahnSeries.ofPowerSeries_apply_coeff, HahnSeries.ofPowerSeries_apply_coeff, PowerSeries.coeff_map]
  · rw [ModularCurve.ofPowerSeries_coeff_of_neg _ hk, ModularCurve.ofPowerSeries_coeff_of_neg _ hk, map_zero]

noncomputable def yZ : LaurentSeries ℤ := HahnSeries.single (-1 : ℤ) 1 * HahnSeries.ofPowerSeries ℤ ℤ jNum

theorem coeffMap_yZ_rat : coeffMap (Int.castRingHom ℚ) yZ = jq := by
  rw [yZ, map_mul, coeffMap_single, map_one, coeffMap_ofPowerSeries, jq, jNumQ]

theorem coeffMap_yZ {S : Type} [Field S] [Algebra ℚ S] (f : ℤ →+* S) :
    coeffMap f yZ = coeffEmb S jq := by
  rw [← coeffMap_yZ_rat, show coeffEmb S = coeffMap (algebraMap ℚ S) from rfl, coeffMap_coeffMap]
  exact coeffMap_congr (RingHom.ext_int _ _) _

theorem yZ_coeff_neg_one : yZ.coeff (-1 : ℤ) = 1 := by
  rw [yZ, HahnSeries.coeff_single_mul, one_mul, sub_self,
    show (0 : ℤ) = ((0 : ℕ) : ℤ) from rfl, HahnSeries.ofPowerSeries_apply_coeff,
    PowerSeries.coeff_zero_eq_constantCoeff, constantCoeff_jNum]

theorem coeffMap_single_zero (A : ValuationSubring (AlgebraicClosure ℚ)) (a : ↥A) :
    coeffMap A.subtype (HahnSeries.single (0 : ℤ) a) =
      algebraMap (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) (a : AlgebraicClosure ℚ) := by
  rw [coeffMap_single, algebraMap_laurentSeries_eq_single]; rfl

theorem igusa_typeII
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (ℓ : CuspidalType.ProjLine q) :
    ∃ t : ↥(fieldBar q M'), t ∈ OIg ℓ ∧ ∀ a : ↥A,
      ∃ h : t - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OIg ℓ,
        IsUnit (⟨_, h⟩ : ↥(OIg ℓ)) := by
  classical

  have hJmem : coeffEmb (AlgebraicClosure ℚ) jq ∈ modularFunctionFieldBar M' :=
    coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))
  let yA : LaurentSeries ↥A := coeffMap (Int.castRingHom ↥A) yZ
  have hyA : coeffMap A.subtype yA = coeffEmb (AlgebraicClosure ℚ) jq := by
    rw [show coeffMap A.subtype yA = coeffMap (A.subtype.comp (Int.castRingHom ↥A)) yZ from coeffMap_coeffMap _ _ _]
    exact coeffMap_yZ _
  have key : ∀ a : ↥A, ∃ h : coeffEmb (AlgebraicClosure ℚ) jq -
        algebraMap (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) (a : AlgebraicClosure ℚ) ∈ modularFunctionFieldBar M',
      (⟨_, h⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers ∧
      ∀ hg : (⟨_, h⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers, R₀.residue ⟨_, hg⟩ ≠ 0 := by
    intro a
    let y : LaurentSeries ↥A := yA - HahnSeries.single (0 : ℤ) a
    have hy : coeffMap A.subtype y = coeffEmb (AlgebraicClosure ℚ) jq -
        algebraMap (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) (a : AlgebraicClosure ℚ) := by
      rw [map_sub, hyA, coeffMap_single_zero]
    have hmem : coeffMap A.subtype y ∈ modularFunctionFieldBar M' := by
      rw [hy]; exact sub_mem hJmem (IntermediateField.algebraMap_mem _ _)
    obtain ⟨hg, hres⟩ := hR₀ y hmem
    refine ⟨hy ▸ hmem, ?_, ?_⟩
    · convert hg using 2 <;> simp [hy]
    · intro hg' h0
      have hcoe : ((R₀.residue ⟨_, hg'⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) = 0 := by
        rw [h0]; rfl
      have hres' : ((R₀.residue ⟨_, hg'⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y := by
        convert hres using 3 <;> simp [hy]
      have h1 : (coeffMap (IsLocalRing.residue ↥A) y).coeff (-1) = 1 := by
        rw [coeffMap_coeff, show y = yA - HahnSeries.single (0 : ℤ) a from rfl, HahnSeries.coeff_sub',
          Pi.sub_apply, HahnSeries.coeff_single_of_ne (by norm_num), sub_zero,
          show yA = coeffMap (Int.castRingHom ↥A) yZ from rfl, coeffMap_coeff, yZ_coeff_neg_one, map_one, map_one]
      rw [← hres', hcoe] at h1
      simp at h1

  have hval_ne : ∀ a : ↥A, coeffEmb (AlgebraicClosure ℚ) jq -
      algebraMap (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) (a : AlgebraicClosure ℚ) ≠ 0 := by
    intro a h0
    have := congrArg (fun x : LaurentSeries (AlgebraicClosure ℚ) => x.coeff (-1)) h0
    simp only [HahnSeries.coeff_sub', Pi.sub_apply, coeffEmb_coeff, coeff_jq_neg_one, map_one,
      algebraMap_laurentSeries_eq_single, HahnSeries.coeff_single_of_ne (show (-1 : ℤ) ≠ 0 by norm_num), sub_zero,
      HahnSeries.coeff_zero'] at this
    exact one_ne_zero this

  refine ⟨IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩, ?_, ?_⟩
  · obtain ⟨h0, hg0, hgne0⟩ := key 0
    have hm := (inclusion_mem_igusaRing_and_inv_mem_of_residue_ne_zero q M' hqM' A hA hle R₀ hR₀ ζ OIg hIg_inf hIg
      _ hg0 (hgne0 hg0) ℓ).1
    convert hm using 2
    apply Subtype.ext
    simp
  · intro a
    obtain ⟨h, hg, hgne⟩ := key a
    have hm := inclusion_mem_igusaRing_and_inv_mem_of_residue_ne_zero q M' hqM' A hA hle R₀ hR₀ ζ OIg hIg_inf hIg
      _ hg (hgne hg) ℓ
    have e : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(fieldBar q M')) -
        algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) =
        IntermediateField.inclusion hle ⟨_, h⟩ := by
      apply Subtype.ext
      simp
    rw [e]
    have hne : (IntermediateField.inclusion hle ⟨_, h⟩ : ↥(fieldBar q M')) ≠ 0 := by
      intro h0
      apply hval_ne a
      have := congrArg (fun x : ↥(fieldBar q M') => (x : LaurentSeries (AlgebraicClosure ℚ))) h0
      simpa using this
    refine ⟨hm.1, ⟨⟨⟨_, hm.1⟩, ⟨_, hm.2⟩, Subtype.ext (mul_inv_cancel₀ hne), Subtype.ext (inv_mul_cancel₀ hne)⟩, rfl⟩⟩
end M10R

