theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (D : TypeDensity.TwoChartCurveData R t x beta) (i : D.ι) (d : ℕ)
    (J : Ideal R) :
    (TypeDensity.strictTransformAt R t x (TypeDensity.leftPoint D (Sum.inl i)) d J).map
      ((D.rightIso i).toRingHom.comp (D.leftIso i).symm.toRingHom) = TypeDensity.strictTransformAt R x t
      (TypeDensity.rightPoint D (Sum.inl i)) d J := by
  have key : ∀ a : TypeDensity.BlowupChart R t x, ((D.leftIso i).symm.trans (D.rightIso i))
      (TypeDensity.completedPointMap _ ((D.Q i).comap (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x))) a)
          =
      D.rightIso i
          (TypeDensity.completedPointMap _ (D.Q i)
              (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) a)) := by
    intro a
    rw [RingEquiv.trans_apply, ← D.leftIso_compat i a, RingEquiv.symm_apply_apply]
  have hR : ∀ r : R, algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartBase R t x r) =
      beta.right (TypeDensity.chartBase R x t r) := by
    intro r
    have h1 : TypeDensity.chartBase R x t r = algebraMap R (TypeDensity.BlowupChart R x t) r := rfl
    have h2 : TypeDensity.chartBase R t x r = algebraMap R (TypeDensity.BlowupChart R t x) r := rfl
    rw [h1, h2, beta.right.commutes, ← IsScalarTower.algebraMap_apply]
  have hbase : ∀ r : R, ((D.leftIso i).symm.trans (D.rightIso i))
      (TypeDensity.completedPointMap _ ((D.Q i).comap (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)))
          (TypeDensity.chartBase R t x r)) =
      TypeDensity.completedPointMap _ ((D.Q i).comap beta.right.toRingHom) (TypeDensity.chartBase R x t r) := by
    intro r
    rw [key, hR]
    exact D.rightIso_compat i _
  have hrel : TypeDensity.chartBase R t x t * TypeDensity.chartSlope R t x = TypeDensity.chartBase R t x x := by
    unfold TypeDensity.chartBase TypeDensity.chartSlope
    rw [RingHom.comp_apply, RingHom.comp_apply, ← map_mul, Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  have hx : TypeDensity.completedPointMap _ ((D.Q i).comap beta.right.toRingHom) (TypeDensity.chartBase R x t x) =
      ((D.leftIso i).symm.trans (D.rightIso i))
        (TypeDensity.completedPointMap _ ((D.Q i).comap (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)))
            (TypeDensity.chartBase R t x t)) *
      D.rightIso i
          (TypeDensity.completedPointMap _ (D.Q i)
          (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartSlope R t x))) := by
    rw [← hbase, ← hrel, key, key, map_mul, map_mul, map_mul]
  have hunit : IsUnit
      (D.rightIso i
      (TypeDensity.completedPointMap _ (D.Q i)
      (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) (TypeDensity.chartSlope R t x)))) := by
    exact ((IsLocalization.Away.algebraMap_isUnit (TypeDensity.chartSlope R t x)).map _).map _
  exact TypeDensity.strictTransformAt_map_of_compat R t x _ _ ((D.leftIso i).symm.trans (D.rightIso i)) _ hunit
      hbase hx d J
