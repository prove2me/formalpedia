theorem GlobalTheory.CompanionTheory.HodgeLow.d2_apply (z : C2 F) {T T' T'' T''' : C} (φ : T ⟶ T') (ψ : T' ⟶ T'') (χ : T'' ⟶ T''') :
    d2 F z T T' T'' T''' φ ψ χ = z T' T'' T''' ψ χ - z T T'' T''' (φ ≫ ψ) χ +
      z T T' T''' φ (ψ ≫ χ) - mp F χ (z T T' T'' φ ψ) := by sorry
