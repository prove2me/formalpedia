        ((pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base y = (pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base (i₁.base (genericPoint ↥C₁)) → x ∈ Set.range i₁.base) ∧
