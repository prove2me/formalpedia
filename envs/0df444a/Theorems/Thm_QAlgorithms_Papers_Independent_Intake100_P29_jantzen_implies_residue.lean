-- title:
--   Jantzen equivalence preserves residue multiplicities
-- statement:
--   Let $F$ be a field, let $n,r\ge1$, let $q\in F^\times$ with $q\ne1$, and fix integer charges $c_1,\ldots,c_r$, with $Q_a=q^{c_a}$. Let $e$ be the least $k\ge2$ with $1+q+\cdots+q^{k-1}=0$, or $\infty$ if there is none. For an $r$-multipartition $\lambda$ of $n$, each node $(i,j,a)$ has charged residue $j-i+c_a$ modulo $e$, interpreted as an integer when $e=\infty$. Residue multiplicities count nodes individually. The relation $\sim_J$ is the equivalence relation generated by nonzero coefficients $J_{\alpha\beta}$ in Definition 2.5, with intermediate multipartitions of the same size.
--
--   For multipartitions $\lambda,\mu$ of $n$,
--
--   $$
--   \lambda\sim_J\mu\quad\Longrightarrow\quad
--   C_f(\lambda)=C_f(\mu)\quad\text{for every }f\in\mathbb Z/e\mathbb Z,
--   $$
--
--   where $C_f$ is the number of diagram nodes of residue $f$. This is the implication from Jantzen connectivity to equality of concrete residue multisets.
-- source:
--   Blocks of cyclotomic Hecke algebras, arXiv:math/0607451v4, PDF p. 12, Corollary 3.5

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P29

namespace QAlgorithms.Papers.Independent.Intake100.P29

noncomputable section

open scoped BigOperators Classical

variable {F : Type} [Field F]

/-- Corollary 3.5, PDF p. 12, with section 3's single-orbit charged residues. -/
theorem jantzen_implies_residue {r n : ℕ} (hr : 0 < r) (hn : 0 < n)
    (q : F) (hq : q ≠ 0) (hqOne : q ≠ 1) (c : Fin r → ℤ)
    (L M : Multipartition r) (hL : size L = n) (hM : size M = n)
    (hJ : JantzenEquivalent q (fun a => q ^ c a) L M) :
    ChargedResidueEquivalent (quantumCharacteristic q) c L M := by sorry

end

end QAlgorithms.Papers.Independent.Intake100.P29
