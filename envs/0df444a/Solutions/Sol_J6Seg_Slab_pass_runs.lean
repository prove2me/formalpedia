      (cs[j].2 :: cs[j].1 :: ((flatC (cs.take j)).reverse ++ CU)) OP ARG ACC) inp tmp
      skel_mem_CU skel_mem_C (by decide) (skS_CU _ _ _ _ _ _)
    rw [skS_C, skS_upd_CU, skS_upd_C] at h1
    have h2 := mvL (I := I) (iprog := iprog) hL s' (skS G (cs[j].2 :: (flatC (cs.drop (j + 1)) ++ RC))
      (cs[j].1 :: ((flatC (cs.take j)).reverse ++ CU)) OP ARG ACC) inp tmp
      skel_mem_CU skel_mem_C (by decide) (skS_CU _ _ _ _ _ _)
    rw [skS_C, skS_upd_CU, skS_upd_C] at h2
    refine (h1.seq h2).mono ?_
    have := moveCost_mono hc.1
    have := moveCost_mono hc.2
    omega

/-- **One block.** -/
theorem block_runs (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) (cs : List (ℤ × ℤ)) {LN : List ℤ}
    (hN : G rNC = (cs.length : ℤ) :: LN) {Ba : ℕ} (hcs : CmdsOK OkA Ba cs) (n : ℕ)
    (hV : VC n cs 0) (RC CU OP ARG ACC : List ℤ) (inp tmp : List U) (hlen : n * m ≤ inp.length)
    (hok : ∀ u ∈ inp, OkU u) :
    IRuns I iprog (blockP dr rd it bk)
      (encK s (lin inp tmp (skS G (flatC cs ++ RC) CU OP ARG ACC)))
      (encK s (lin (inp.drop (nDrop cs * m)) tmp
        (skS G (flatC cs ++ RC) CU OP ARG ((runC m g cs inp).reverse ++ ACC))))
      (blockC cs.length m Ba (cdr + crd + cit + cbk)) :=
  (cmdLoop_runs H s G hK hA hC hD hM cs hN hcs n hV RC CU OP ARG ACC inp tmp hlen hok).seq
    (restLoop_runs H.hL s G hA hC hD cs hN (fun c hc => ⟨(hcs c hc).1, (hcs c hc).2.1⟩) RC CU OP
      ARG _ _ tmp)

end loop

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILSlab4
/-!
# B-line IL, B1 (streaming slab pass) §4: the whole pass (generic lanes)

`passP = rptX rNB blockP; rptX rTOT (mv rACC 0)`: the blocks, then the output (collected
reversed on `rACC`) is moved onto stack `0`. **`pass_runs`**: from the lane state with the input
`xs` (`pre` blocks of `n` slabs of `m` units) the output `passOut … ++ G 0` lands on stack `0`; all
skeleton registers are restored (`rACC` empty again). **`passOut_eq`**: for the control list
`ctlOf n n' src argOf` of a monotone source, `passOut` is `slabPass` (block form).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD rptXU_runs)
open NLogN.KFT (cf3 rptX)

section pass
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

/-- **The pass.** -/
theorem pass_runs_sol_aux (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) (cs : List (ℤ × ℤ)) {LN : List ℤ}
    (hN : G rNC = (cs.length : ℤ) :: LN) {Ba : ℕ} (hcs : CmdsOK OkA Ba cs) (n : ℕ)
    (hV : VC n cs 0) (hND : nDrop cs = n) (pre : ℕ) {LB : List ℤ}
    (hB : G rNB = (pre : ℤ) :: LB) (xs : List U) (hxs : xs.length = pre * (n * m))
    (hok : ∀ u ∈ xs, OkU u) {LT : List ℤ}
    (hT : G rTOT = ((passOut m g cs n pre xs).length : ℤ) :: LT) {Bo : ℕ}
    (hBo : ∀ y ∈ passOut m g cs n pre xs, zsz y ≤ Bo) (RC CU OP ARG : List ℤ) :
    IRuns I iprog (passP dr rd it bk)
      (encK s (lin xs [] (skS G (flatC cs ++ RC) CU OP ARG [])))
      (encK s (skS (update G 0 (passOut m g cs n pre xs ++ G 0)) (flatC cs ++ RC) CU OP ARG []))
      (passC pre cs.length m Ba (cdr + crd + cit + cbk) (passOut m g cs n pre xs).length Bo) := by
  have hL := H.hL
  have Hl := laneLoopX (I := I) (iprog := iprog) hL (X := rNB) (by decide) (by decide)
    (blockP dr rd it bk) (blockC cs.length m Ba (cdr + crd + cit + cbk)) pre s
    (fun i => xs.drop (i * (n * m))) (fun _ => [])
    (fun i => skS G (flatC cs ++ RC) CU OP ARG (passOut m g cs n i xs).reverse)
    (fun k => by simp [hA]) (fun k => by simp [hC]) (fun k => by simp [hD]) (LM := LB) (by simp [hB]) ?_
  · have h2 := outLoop_runs (I := I) (iprog := iprog) s G hA hC hD (flatC cs ++ RC) CU OP ARG
      (passOut m g cs n pre xs) hT hBo
    try simp only [] at Hl
    have e0 : xs.drop (pre * (n * m)) = [] := List.drop_of_length_le (by omega)
    rw [e0, hL.nil] at Hl
    try simp only [] at Hl
    have e1 : passOut m g cs n 0 xs = [] := by simp [passOut]
    rw [zero_mul, List.drop_zero, e1, List.reverse_nil] at Hl
    exact Hl.seq h2
  · intro i hi s'
    have hlen : n * m ≤ (xs.drop (i * (n * m))).length := by
      rw [List.length_drop, hxs]
      have : (i + 1) * (n * m) ≤ pre * (n * m) := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.add_mul, one_mul] at this
      omega
    have h := block_runs H s' G hK hA hC hD hM cs hN hcs n hV RC CU OP ARG
      (passOut m g cs n i xs).reverse (xs.drop (i * (n * m))) [] hlen
      (fun u hu => hok u (List.mem_of_mem_drop hu))
    refine h.mono' ?_ le_rfl
    rw [hND, List.drop_drop, ← List.reverse_append]
    unfold passOut
    rw [List.range_succ, List.flatMap_append, List.flatMap_singleton]
    congr 4
    ring

end pass

/-! ## The pass output is the slab pass -/

end J6Seg.Slab

end

theorem solution.{u_1} : type_of% @J6Seg.Slab.pass_runs_sol_aux.{u_1} := @J6Seg.Slab.pass_runs_sol_aux.{u_1}
