theorem solution
    (K : Type*) [CommGroup K] [TopologicalSpace K] [IsTopologicalGroup K] [CompactSpace K]
    [T2Space K]
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (π : K →* (H →L[ℂ] H)) (hπ_unitary : ∀ k, π k ∈ unitary (H →L[ℂ] H))
    (hπ_cont : ∀ v : H, Continuous fun k => π k v) :
    IsHilbertSum ℂ (fun ω : PontryaginDual K => ↥(isotypicSubspace π fun k => (ω k : ℂ)))
      (fun ω => (isotypicSubspace π fun k => (ω k : ℂ)).subtypeₗᵢ) := by
  have : ∀ ω : PontryaginDual K, CompleteSpace ↥(isotypicSubspace π fun k => (ω k : ℂ)) :=
    fun ω => (isClosed_isotypic π _).completeSpace_coe
  refine IsHilbertSum.mkInternal _ (orthogonalFamily_isotypic π hπ_unitary) ?_
  refine (Submodule.topologicalClosure_eq_top_iff.mpr ?_).ge
  rw [Submodule.eq_bot_iff]
  intro v hv
  refine eq_zero_of_mem_orthogonal_isotypic π hπ_cont v fun ω => ?_
  exact Submodule.orthogonal_le
    (le_iSup (fun ω : PontryaginDual K => isotypicSubspace π fun k => (ω k : ℂ)) ω) hv
