      have hvr : cellValid .box m x0b x1a x1b x2a x2b := ⟨hmp, hm_le, h1p, h1le, h2p, h2le, by simp, by simp, by simp⟩
      have hsub : cellSet .box ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) ⊆
          cellSet .box ((x0a : ℝ) / D_den) ((m : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) ∪
          cellSet .box ((m : ℝ) / D_den) ((x0b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) := by
