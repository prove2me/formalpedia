    (h1 : T.cells tout = tapeOf (syms L) (c.σ.out.map (bitSym (syms L))))
    (h1' : T.head tout = c.σ.out.length)
    (h2 : T.cells tctl = tapeOf (syms L) (c.ctl.map retSym).reverse) (h2' : T.head tctl = c.ctl.length)
