-- title:
--   General predictable vector integration and stochastic calculus
-- statement:
--   Time runs over $[0,T]$ with $T\ge0$, and processes are extended by stopping at $T$. A semimartingale is the published càdlàg adapted local-martingale-plus-finite-variation notion, allowing indistinguishable versions. For a bounded elementary predictable row integrand $\theta=\sum_jh_j1_{(s_j,t_j]}$, define
--   $$(\theta\mathbin\bullet S)_t=\sum_jh_j\bigl(S_{t\wedge t_j}-S_{t\wedge s_j}\bigr).$$
--   The bounded integration graph is generated by elementary sums, bounded pointwise limits of predictable integrands with Emery limits of their integrals, and indistinguishability. General predictable vector integration uses Emery convergence of the jointly truncated integrands $\theta1_{\{\|\theta\|\le n\}}$. The scalar testing integrals defining Emery convergence are themselves explicit elementary sums. Joint truncation permits cancellation between coordinates; coordinatewise integrability is not imposed.
--
--   Quadratic covariation is a càdlàg adapted version of the published probability limit of increment products. The stochastic logarithm is $X_-^{-1}\mathbin\bullet X$; the stochastic exponential solves $E=1+E_-\mathbin\bullet N$. Chosen versions default to zero only when their defining existence relation fails. None of the calculus rules or mission conclusions is assumed as an axiom. The usual filtration conditions mean right continuity and inclusion of every $P$-null set at time zero.
--
--   LogDefined records existence of the stochastic integral defining a logarithm. Integrand predictability is tested on the stopped extension to preserve exactly the finite-horizon domain.
-- source:
--   Černý, Czichowsky & Kallsen, Numeraire-invariant quadratic hedging and mean–variance portfolio allocation, arXiv:2110.09416v4, pp. 5–6, stochastic-calculus notation; [22, III.6.17]

import Mathlib
import Definitions.Def_KurtzProtter91_Integrals_Semimartingale

open MeasureTheory ProbabilityTheory Filter Topology Matrix
open scoped NNReal ENNReal

namespace NumInvQH.Oblique.Supplement

attribute [local instance] Classical.propDecidable Classical.decEq

abbrev Process (Ω E : Type*) := ℝ≥0 → Ω → E

/-- Usual conditions: right continuity and inclusion of all P-null sets at time zero. -/
def Usual {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) : Prop :=
  ℱ.IsRightContinuous ∧ ∀ N : Set Ω, P N = 0 → MeasurableSet[ℱ 0] N

def stop {Ω E : Type*} (T : ℝ≥0) (X : Process Ω E) : Process Ω E :=
  fun t => X (min t T)

/-- Equality up to indistinguishability on the finite horizon. -/
def Same {Ω E : Type*} [MeasurableSpace Ω] (P : Measure Ω) (T : ℝ≥0)
    (X Y : Process Ω E) : Prop := ∀ᵐ ω ∂P, ∀ t ≤ T, X t ω = Y t ω

noncomputable def left {Ω E : Type*} [TopologicalSpace E] (X : Process Ω E) : Process Ω E :=
  fun t ω => Function.leftLim (fun s => X s ω) t

abbrev Semi {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (S : Process Ω (Fin d → ℝ)) : Prop :=
  ∃ Y, KurtzProtter91.Integrals.IsSemimartingale ℱ P (stop T Y) ∧ Same P T S Y

abbrev ScalarSemi {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (X : Process Ω ℝ) : Prop := Semi P ℱ T (fun t ω (_ : Fin 1) => X t ω)

/-- Elementary predictable integrands with bounded coefficients and deterministic times.
The algebra generated by these processes generates the predictable sigma algebra. -/
structure Elementary {Ω : Type*} [MeasurableSpace Ω] (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›)
    (d : ℕ) where
  count : ℕ
  start : Fin count → ℝ≥0
  finish : Fin count → ℝ≥0
  ordered : ∀ i, start i ≤ finish i
  coefficient : Fin count → Ω → Fin d → ℝ
  measurable : ∀ i, StronglyMeasurable[ℱ (start i)] (coefficient i)
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  bounded : ∀ i ω, ‖coefficient i ω‖ ≤ bound

noncomputable def elementaryValue {Ω : Type*} [MeasurableSpace Ω]
    {ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›} {d : ℕ} (e : Elementary ℱ d) :
    Process Ω (Fin d → ℝ) := fun t ω =>
  ∑ i, if e.start i < t ∧ t ≤ e.finish i then e.coefficient i ω else 0

/-- A finite sum of stopped increments; no stochastic integral is presumed here. -/
noncomputable def elementaryIntegral {Ω : Type*} [MeasurableSpace Ω]
    {ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›} {d : ℕ} (e : Elementary ℱ d)
    (T : ℝ≥0) (S : Process Ω (Fin d → ℝ)) : Process Ω ℝ := fun t ω =>
  ∑ i, e.coefficient i ω ⬝ᵥ
    (S (min (min t T) (e.finish i)) ω - S (min (min t T) (e.start i)) ω)

/-- Emery convergence of zero-initial scalar semimartingales on [0,T], tested by
all elementary predictable scalar integrands of absolute value at most one.
The event's supremum is expressed existentially to avoid real-supremum defaults. -/
def EmeryTendsto {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (I : ℕ → Process Ω ℝ) (J : Process Ω ℝ) : Prop :=
  ∀ ε δ : ℝ, 0 < ε → 0 < δ → ∃ N : ℕ, ∀ n ≥ N,
    ∀ e : Elementary ℱ 1,
      (∀ t ω, ‖elementaryValue e t ω‖ ≤ 1) →
      P {ω | ∃ t ≤ T, ε < |elementaryIntegral e T
        (fun s w (_ : Fin 1) => I n s w - J s w) t ω|} < ENNReal.ofReal δ

/-- The bounded stochastic integral graph, constructed from elementary sums by
bounded pointwise convergence of predictable integrands and Emery convergence of
integrals, and saturated under indistinguishability. This is a construction of
integration, not a freely chosen integration operator or a list of calculus axioms. -/
inductive BoundedIntegral {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (S : Process Ω (Fin d → ℝ)) :
    Process Ω (Fin d → ℝ) → Process Ω ℝ → Prop
  | elementary (e : Elementary ℱ d) :
      BoundedIntegral P ℱ T S (elementaryValue e) (elementaryIntegral e T S)
  | limit (θs : ℕ → Process Ω (Fin d → ℝ)) (Is : ℕ → Process Ω ℝ)
      (θ : Process Ω (Fin d → ℝ)) (I : Process Ω ℝ)
      (hseq : ∀ n, BoundedIntegral P ℱ T S (θs n) (Is n))
      (hbound : ∃ K : ℝ, ∀ n t ω, t ≤ T → ‖θs n t ω‖ ≤ K)
      (hlim : ∀ ω t, 0 < t → t ≤ T → Tendsto (fun n => θs n t ω) atTop (𝓝 (θ t ω)))
      (hpred : IsStronglyPredictable ℱ (stop T θ))
      (hsemi : ScalarSemi P ℱ T I)
      (hzero : ∀ᵐ ω ∂P, I 0 ω = 0)
      (hconv : EmeryTendsto P ℱ T Is I) : BoundedIntegral P ℱ T S θ I
  | equivalent (θ η : Process Ω (Fin d → ℝ)) (I J : Process Ω ℝ)
      (h : BoundedIntegral P ℱ T S θ I)
      (hθ : Same P T θ η) (hI : Same P T I J) : BoundedIntegral P ℱ T S η J

noncomputable def cutoff {Ω : Type*} {d : ℕ} (n : ℕ)
    (θ : Process Ω (Fin d → ℝ)) : Process Ω (Fin d → ℝ) :=
  fun t ω => if ‖θ t ω‖ ≤ (n : ℝ) then θ t ω else 0

/-- General predictable vector integration by Emery convergence of bounded
radial truncations. Truncation is joint: cancellation between assets is retained. -/
def HasIntegral {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (θ S : Process Ω (Fin d → ℝ)) (I : Process Ω ℝ) : Prop :=
  Semi P ℱ T S ∧ IsStronglyPredictable ℱ (stop T θ) ∧ ScalarSemi P ℱ T I ∧
  (∀ᵐ ω ∂P, I 0 ω = 0) ∧
  ∃ Is : ℕ → Process Ω ℝ,
    (∀ n, BoundedIntegral P ℱ T S (cutoff n θ) (Is n)) ∧ EmeryTendsto P ℱ T Is I

/-- A chosen version of the genuine stochastic integral; default zero only outside L(S). -/
noncomputable def integral {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (θ S : Process Ω (Fin d → ℝ)) : Process Ω ℝ :=
  if h : ∃ I, HasIntegral P ℱ T θ S I then Classical.choose h else 0

/-- Scalar integral is a one-coordinate instance of vector integration. -/
noncomputable def scalarIntegral {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (f X : Process Ω ℝ) : Process Ω ℝ :=
  integral P ℱ T (fun t ω (_ : Fin 1) => f t ω) (fun t ω (_ : Fin 1) => X t ω)

/-- A cadlag version of quadratic covariation, using published increment-product limits. -/
def HasCovariation {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0) (X Y Q : Process Ω ℝ) : Prop :=
  StronglyAdapted ℱ (stop T Q) ∧
  (∀ ω, KurtzProtter91.Integrals.IsCadlag (fun t => stop T Q t ω)) ∧
  EthierKurtz.HasCrossVariation P (stop T X) (stop T Y) (stop T Q)

noncomputable def covariation {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0) (X Y : Process Ω ℝ) : Process Ω ℝ :=
  if h : ∃ Q, HasCovariation P ℱ T X Y Q then Classical.choose h else 0

/-- Stochastic logarithm, integral of 1/X_- against X, including jump-to-zero cases. -/
noncomputable def stochasticLog {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (X : Process Ω ℝ) : Process Ω ℝ :=
  scalarIntegral P ℱ T (fun t ω => (left X t ω)⁻¹) X

/-- The stochastic logarithm is defined only when its defining integral exists.
This guard is essential when only X_- > 0 is assumed: X may hit zero and recover. -/
def LogDefined {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (X : Process Ω ℝ) : Prop :=
  ∃ I, HasIntegral P ℱ T
    (fun t ω (_ : Fin 1) => (left X t ω)⁻¹)
    (fun t ω (_ : Fin 1) => X t ω) I

/-- Doléans exponential is the solution of E = 1 + E_- • N, starting at one. -/
def IsExponential {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (N E : Process Ω ℝ) : Prop :=
  ScalarSemi P ℱ T E ∧ HasIntegral P ℱ T
    (fun t ω (_ : Fin 1) => left E t ω)
    (fun t ω (_ : Fin 1) => N t ω) (fun t ω => E t ω - 1)

noncomputable def exponential {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (ℱ : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (T : ℝ≥0)
    (N : Process Ω ℝ) : Process Ω ℝ :=
  if h : ∃ E, IsExponential P ℱ T N E then Classical.choose h else 0

end NumInvQH.Oblique.Supplement


