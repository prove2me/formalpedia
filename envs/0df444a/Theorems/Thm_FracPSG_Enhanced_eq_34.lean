-- title:
--   (34), proof of Theorem 6.1(iii) — every active gradient gives a subgradient of f + ι_S
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 under Assumptions 1 and 2′ with $S_0$ bounded, and suppose $\liminf_{n\to+\infty}\tau_n>0$. Then every cluster point $\bar x$ of $(x_n)$ satisfies $\bar x\in S\cap\operatorname{dom}f$ and
--   $$\bigcup_{i\in I_0(\bar x)}\frac{f(\bar x)}{g(\bar x)}\,\nabla g_i(\bar x)\ \subseteq\ \partial_L(f+\iota_S)(\bar x).\qquad(34)$$
--
--   This is inclusion (28) of Theorem 6.1(iii): each active piece of the denominator yields a lifted stationarity certificate at $\bar x$.
--
--   **Formalization Note** $\partial_L$ is the limiting subdifferential `NonconvexSplitting.Shared.LimitingSubdiff`; $I_0(\bar x)=\{i: g_i(\bar x)=g(\bar x)\}$.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 24, (34) (proof of Theorem 6.1(iii))

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Inclusion (34) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 24, proof of Theorem 6.1(iii)): under the
hypotheses of Theorem 6.1 and `liminf τₙ > 0`, every cluster point `x̄` of the iterates satisfies
`x̄ ∈ S ∩ dom f` and `⋃_{i ∈ I₀(x̄)} (f(x̄)/g(x̄)) ∇gᵢ(x̄) ⊆ ∂_L(f + ι_S)(x̄)`. -/
theorem eq_34
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0)))
    (hτ : 0 < Filter.liminf τ atTop) :
    ∀ xbar : EuclideanSpace ℝ (Fin N), MapClusterPt xbar atTop x →
      xbar ∈ S ∧ FracPSG.Subseq.objF fs fn xbar ≠ ⊤ ∧
      ∀ i ∈ activeSet 0 gi xbar,
        FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) xbar • gradient (gi i) xbar ∈
          LimitingSubdiff (FracPSG.Subseq.addInd (FracPSG.Subseq.objF fs fn) S) xbar := by sorry

end FracPSG.Enhanced
