    unfold bP6 IntMul.lg
    have : 3 < Nat.clog 2 n := (Nat.lt_clog_iff_pow_lt (by norm_num)).mpr (by norm_num; omega)
    omega
  have hB : (1:ℝ) ≤ (bP6 n : ℝ) := by exact_mod_cast (by omega : 1 ≤ bP6 n)
  have hb'1 := b'P6_pos P n
  have h := r6_nc6r P hP (bP6 n) (pP6 P n) (dP6 P n) (ℓP6 P n) hB
    (by unfold pP6; push_cast; have : (1:ℝ) ≤ b'P6 P n := by exact_mod_cast hb'1
        linarith)
