theorem solution (m : TypeDensity.ConcreteMember) :
    (∀ P : TypeDensity.TangentPattern m.s.degree,
        Finite (TypeDensity.patternDivisors (IsLocalRing.ResidueField m.R) m.s P)) ∧
    (m.s.terminal = false → ∀ P : TypeDensity.TangentPattern m.s.degree, TypeDensity.Allowed m.s P →
        ((Nat.card (TypeDensity.patternDivisors (IsLocalRing.ResidueField m.R) m.s P) : ℕ) : ℚ) =
        (TypeDensity.tangentCount m.s P).eval (m.toMeasured.q : ℚ)) := by
  have hfin : Finite (IsLocalRing.ResidueField m.R) :=
    Finite.of_equiv _ m.S.residueEquiv.toEquiv
  refine ⟨fun P ↦ TypeDensity.pattern_divisors_finite _ m.s P, fun _ P hP ↦ ?_⟩
  rw [(TypeDensity.pattern_divisor_count _ m.s P hP).2]
  congr 2
  exact Nat.card_congr m.S.residueEquiv.toEquiv.symm
