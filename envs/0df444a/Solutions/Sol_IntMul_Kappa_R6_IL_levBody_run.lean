    List.replicate (n * v) 0
  | 0, a => by simp [tabR]
  | n + 1, a => by
    rw [tabR_succ, tabR_zeros v n (a + 1), ← List.replicate_add]
    congr 1; ring

theorem srcR_ok {W : ℕ} (T : ℕ) (ρ : Fin W → Fin W) (hW : 1 ≤ W) : SrcOK (T + W) (srcR T ρ) := by
  intro n hn
