-- title:
--   Proposition 3 — regret of composite mirror descent with time-varying quadratic proximal functions, (11)
-- statement:
--   Let $\mathcal X\subseteq\mathbb R^d$ be closed and convex, $f_t$ and $\varphi$ convex, $\eta>0$, $T\ge1$, and let $x_1,\dots,x_{T+1}$ be generated by the composite mirror descent update (4) with $\psi_t(x)=\tfrac12\langle x,H_tx\rangle$, where for $t=1,\dots,T$ the matrix $H_t$ is positive semidefinite and $g_t$ lies in its range. Assume $x_1\in\mathcal X$ minimizes $\varphi$ over $\mathcal X$. Then for every $x^*\in\mathcal X$,
--   $$\sum_{t=1}^T f_t(x_t)+\varphi(x_t)-f_t(x^*)-\varphi(x^*)\le\frac1\eta B_{\psi_1}(x^*,x_1)+\frac1\eta\sum_{t=1}^{T-1}\big[B_{\psi_{t+1}}(x^*,x_{t+1})-B_{\psi_t}(x^*,x_{t+1})\big]+\frac\eta2\sum_{t=1}^T\|g_t\|_{\psi_t^*}^2,$$
--   with $\|g\|_{\psi_t^*}^2=\langle g,H_t^\dagger g\rangle$.
--
--   This reduces the regret of every adaptive mirror-descent method to the growth of its proximal terms and a sum of dual norms.
--
--   **Formalization Note** Specialised to quadratic proximal functions, with the range condition as in Lemma 16. The paper's "assume w.l.o.g. that $\varphi(x_1)=0$" (with $x_1=\arg\min_{\mathcal X}\varphi$, p. 2123) is stated as: $x_1\in\mathcal X$ minimizes $\varphi$ over $\mathcal X$. No monotonicity of $H_t$ is assumed (the proof does not use it). The number of rounds is $T\ge1$ (at $T=0$ nothing would constrain $H_1$ in the term $B_{\psi_1}$).
-- source:
--   Duchi, Hazan, Singer, Adaptive Subgradient Methods for Online Learning and Stochastic Optimization, JMLR 12 (2011), p. 2129, Proposition 3, (11)

import Mathlib
import Definitions.Def_AdaGrad_Full_Algorithm2
open scoped MatrixOrder InnerProductSpace

namespace AdaGrad.Full

/-- Proposition 3, inequality (11) (p. 2129), specialised to quadratic proximal functions
`ψ_t(x) = ½⟨x, H_t x⟩` with `H_t` positive semidefinite and `g_t` in the range of `H_t`, over `T ≥ 1` rounds. -/
theorem proposition_3 {d : ℕ} (η : ℝ) (hη : 0 < η) (X : Set (EuclideanSpace ℝ (Fin d)))
    (hXc : Convex ℝ X) (hXcl : IsClosed X)
    (f : ℕ → EuclideanSpace ℝ (Fin d) → ℝ) (hf : ∀ t, ConvexOn ℝ Set.univ (f t))
    (ϕ : EuclideanSpace ℝ (Fin d) → ℝ) (hϕ : ConvexOn ℝ Set.univ ϕ)
    (H : ℕ → Matrix (Fin d) (Fin d) ℝ) (x g : ℕ → EuclideanSpace ℝ (Fin d)) (T : ℕ) (hT : 1 ≤ T)
    (hH : ∀ t ∈ Finset.Icc 1 T, (H t).PosSemidef)
    (hrange : ∀ t ∈ Finset.Icc 1 T, g t ∈ LinearMap.range (Matrix.toEuclideanLin (H t)))
    (hrun : IsQuadMirrorDescentRun η X ϕ f H x g T)
    (hx1 : x 1 ∈ X) (hϕx1 : ∀ y ∈ X, ϕ (x 1) ≤ ϕ y)
    (xstar : EuclideanSpace ℝ (Fin d)) (hstar : xstar ∈ X) :
    AdaGrad.Diag.regret f ϕ x xstar T ≤
      1 / η * bregman (H 1) xstar (x 1)
        + 1 / η * ∑ t ∈ Finset.Ico 1 T,
            (bregman (H (t + 1)) xstar (x (t + 1)) - bregman (H t) xstar (x (t + 1)))
        + η / 2 * ∑ t ∈ Finset.Icc 1 T, dualNormSq (H t) (g t) := by sorry

end AdaGrad.Full
