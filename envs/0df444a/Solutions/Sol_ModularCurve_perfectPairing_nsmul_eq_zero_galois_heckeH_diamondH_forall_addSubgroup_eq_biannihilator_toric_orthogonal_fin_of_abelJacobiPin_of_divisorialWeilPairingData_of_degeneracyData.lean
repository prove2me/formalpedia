theorem finiteDimensional_ratFunc : FiniteDimensional (RatFunc Qb) (xHFunctionFieldBar M H) := by

  obtain ⟨s, hs⟩ := Module.finite_def.mp (finiteDimensional_adjoin_jGen M H)
