/-! ### Lambda-form derivative combinators and an automatic builder -/

section comb
variable {f₁ f₂ : ℝ → ℂ} {d₁ d₂ : ℂ}
theorem hd_add (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε + f₂ ε) (d₁ + d₂) 0 := h₁.add h₂
theorem hd_sub (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε - f₂ ε) (d₁ - d₂) 0 := h₁.sub h₂
theorem hd_mul (h₁ : HasDerivAt f₁ d₁ 0) (h₂ : HasDerivAt f₂ d₂ 0) :
    HasDerivAt (fun ε => f₁ ε * f₂ ε) (d₁ * f₂ 0 + f₁ 0 * d₂) 0 := h₁.mul h₂
theorem hd_neg (h₁ : HasDerivAt f₁ d₁ 0) : HasDerivAt (fun ε => -f₁ ε) (-d₁) 0 := h₁.neg
theorem hd_div_const (h₁ : HasDerivAt f₁ d₁ 0) (c : ℂ) : HasDerivAt (fun ε => f₁ ε / c) (d₁ / c) 0 :=
  h₁.div_const c
theorem hd_const (c : ℂ) : HasDerivAt (fun _ : ℝ => c) 0 0 := hasDerivAt_const 0 c
end comb



/-- `δΨ₂` bridge (genuine derivative of `Ψ₂ = C(l,m,m̄,n)`). -/
theorem NPFamily.hasDerivAt_psi2' {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
    {W : Set (ℝ × Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}
    (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W) :
    HasDerivAt (fun ε => psi2 (g ε) (gi ε) (E ε) x) (weylFVar (g 0) (gi 0) h (E 0) B 0 2 3 1 x) 0 := by
  simp only [psi2_eq]; exact NPFamily.hasDerivAt_weylF hF ht hx 0 2 3 1

namespace NPFamily

variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}

theorem j_psi0 (hF : NPFamily g gi F E Θ W) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => psi0 (g p.1) (gi p.1) (E p.1) p.2) W :=
  (hF.j_weylF 0 2 0 2).congr fun p _ => psi0_eq _ _ _ _
theorem j_psi1 (hF : NPFamily g gi F E Θ W) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => psi1 (g p.1) (gi p.1) (E p.1) p.2) W :=
  (hF.j_weylF 0 1 0 2).congr fun p _ => psi1_eq _ _ _ _

end NPFamily

section knvals

variable {M a Q : ℝ} {x : Pt 4}

theorem ricF_KN_zero (hx : x ∈ domReg M a Q) :
    ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 0 0 x = 0 ∧ ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 0 2 x = 0 ∧
    ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 0 3 x = 0 ∧ ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 2 2 x = 0 ∧
    ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 1 1 x = 0 ∧ ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 1 3 x = 0 ∧
    ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 3 3 x = 0 ∧ ricF (gKN M a Q) (giKN M a Q) (knE M a Q) 1 2 x = 0 := by
  simp only [ricF_KN hx]
  simp

end knvals

