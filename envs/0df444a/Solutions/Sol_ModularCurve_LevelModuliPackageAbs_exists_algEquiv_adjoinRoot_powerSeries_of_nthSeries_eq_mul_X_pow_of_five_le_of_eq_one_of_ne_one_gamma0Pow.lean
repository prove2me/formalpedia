    𝒯.isLevel_act Cb⁻¹ xk.curve xk.level.2.2 xk.isLevel.2.2
  generalize hp : 𝒯.act Cb⁻¹ xk.level.2.2 = p' at hcurve' hΔ' hPone hQne hlev
  obtain ⟨c, P', Qk⟩ := p'
  obtain rfl : c = xet.curve.map ψet.toRingHom := hcurve'
  have hP' : P' = (𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k))) := hPone
  subst hP'
  have hQk : Qk ≠ (𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k))) := hQne
  have hyk : RawDrinfeldPair.IsLevel 𝒢 q (xet.curve.map ψet.toRingHom)
