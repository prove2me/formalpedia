-- title:
--   §2.3, (8) — lim inf (Txⁿ⁺¹, x − xⁿ⁺¹) ≥ 0 for every x ∈ C
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ convex, closed and bounded, $T:H\to H'$ monotone and hemicontinuous on $C$, and let $(x^n)$ be a sequence generated by the regularization algorithm (2) from $x^0\in C$. Then for every $y\in C$
--   $$
--   \liminf_{n\to\infty}\,(Tx^{n+1},\, y-x^{n+1})\ge 0 .
--   $$
--
--   So each iterate satisfies the variational inequality (1) up to an error that vanishes as $n\to\infty$.
--
--   **Formalization Note.** The lim inf is stated in $\varepsilon$-form: for every $\varepsilon>0$, eventually $(Tx^{n+1}, y-x^{n+1})\ge-\varepsilon$. This avoids `Filter.liminf` on $\mathbb R$, whose value is a junk default when the sequence is unbounded below ($T$ need not be bounded on $C$). The paper names the arbitrary point of $C$ by $x$; Lean names it $y$ and the sequence $x$.
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 156, §2.3, proof of Lemme 2, (8)

import Mathlib
import Definitions.Def_MartinetReg_VI_Setting

namespace MartinetReg.VI

open Filter Topology

/-- §2.3, (8), p. 156: `lim inf_{n→∞} (Txⁿ⁺¹, y − xⁿ⁺¹) ≥ 0` for every `y ∈ C`,
stated in ε-form. -/
theorem eq8 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : H → StrongDual ℝ H) (C : Set H) (hS : Standing T C)
    (x : ℕ → H) (hx : IsRegSeq T C x) :
    ∀ y ∈ C, ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, -ε ≤ T (x (n + 1)) (y - x (n + 1)) := by sorry

end MartinetReg.VI
