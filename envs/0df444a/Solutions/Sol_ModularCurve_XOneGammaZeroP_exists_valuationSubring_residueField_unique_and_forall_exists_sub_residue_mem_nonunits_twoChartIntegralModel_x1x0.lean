  let R : Subring (IsLocalRing.ResidueField ↥W₀) :=
    { carrier := {e | ∃ s t : ↥(chartAlgFin A (↥K₁) j), t ∉ y.asIdeal ∧ e * ρ t = ρ s}
      one_mem' := ⟨1, 1, h1, by rw [ρ.map_one, one_mul]⟩
      mul_mem' := by
        rintro a b ⟨s₁, t₁, ht₁, ha⟩ ⟨s₂, t₂, ht₂, hb⟩
        refine ⟨s₁ * s₂, t₁ * t₂, fun h => (hprime.mem_or_mem h).elim ht₁ ht₂, ?_⟩
        rw [ρ.map_mul, ρ.map_mul, ← ha, ← hb]; ring
      zero_mem' := ⟨0, 1, h1, by rw [ρ.map_zero, zero_mul]⟩
      add_mem' := by
        rintro a b ⟨s₁, t₁, ht₁, ha⟩ ⟨s₂, t₂, ht₂, hb⟩
        refine ⟨s₁ * t₂ + s₂ * t₁, t₁ * t₂, fun h => (hprime.mem_or_mem h).elim ht₁ ht₂, ?_⟩
        rw [ρ.map_add, ρ.map_mul, ρ.map_mul, ρ.map_mul, ← ha, ← hb]; ring
      neg_mem' := by
        rintro a ⟨s, t, ht, ha⟩
        exact ⟨-s, t, ht, by rw [ρ.map_neg, ← ha]; ring⟩ }
  have hRmem : ∀ e : IsLocalRing.ResidueField ↥W₀, e ∈ R ↔
      ∃ s t : ↥(chartAlgFin A (↥K₁) j), t ∉ y.asIdeal ∧
        e * IsLocalRing.residue ↥W₀ ⟨(t : ↥K₁), hSW₀ t⟩ = IsLocalRing.residue ↥W₀ ⟨(s : ↥K₁), hSW₀ s⟩ :=
    fun e => Iff.rfl
  have hK₁' : K₁ = ModularCurve.laurentBaseChange L
      (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M ⊓ CongruenceSubgroup.Gamma0 p)) := by
