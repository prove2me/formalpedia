theorem solution (k : Type) [Field k] (n : ℕ) (D : TypeDensity.ExceptionalDivisor k)
    (hD : TypeDensity.exceptionalDegree k D = n) :
    (∃ m : TypeDensity.Pattern n, TypeDensity.HasArray k n D m ∧ m ∈ TypeDensity.residuePatterns n) ∧ ∀ m m' : TypeDensity.Pattern n,
      TypeDensity.HasArray k n D m → TypeDensity.HasArray k n D m' → m = m' := by
  have hdeg := TypeDensity.directionDegree_pos k
  have hsum : TypeDensity.exceptionalDegree k D = ∑ Q ∈ D.support, TypeDensity.directionDegree k Q * D Q := rfl
  set S : Fin n × Fin n → Finset (TypeDensity.ClosedDirection k) := fun ij =>
    D.support.filter (fun Q => TypeDensity.directionDegree k Q = ij.1.val + 1 ∧ D Q = ij.2.val + 1) with hS
  have hcard : ∀ ij : Fin n × Fin n,
      Nat.card {Q : TypeDensity.ClosedDirection k // TypeDensity.directionDegree k Q = ij.1.val + 1 ∧ D Q = ij.2.val + 1}
        = (S ij).card := by
    intro ij
    rw [← Nat.card_eq_finsetCard]
    apply Nat.card_congr
    apply Equiv.subtypeEquivRight
    intro Q
    simp only [hS, Finset.mem_filter, Finsupp.mem_support_iff]
    constructor
    · intro h; exact ⟨by omega, h⟩
    · intro h; exact h.2
  have hconst : ∀ ij : Fin n × Fin n,
      ∑ Q ∈ S ij, TypeDensity.directionDegree k Q * D Q = (S ij).card * ((ij.1.val + 1) * (ij.2.val + 1)) := by
    intro ij
    rw [Finset.sum_congr rfl (g := fun _ => (ij.1.val + 1) * (ij.2.val + 1))]
    · simp
    · intro Q hQ
      simp only [hS, Finset.mem_filter] at hQ
      rw [hQ.2.1, hQ.2.2]
  have hbound : ∀ ij : Fin n × Fin n, (S ij).card ≤ n := by
    intro ij
    have h1 : ∑ Q ∈ S ij, TypeDensity.directionDegree k Q * D Q ≤ n := by
      rw [← hD, hsum]
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (by intros; positivity)
    rw [hconst] at h1
    have : 1 ≤ (ij.1.val + 1) * (ij.2.val + 1) := Nat.one_le_iff_ne_zero.mpr (by positivity)
    nlinarith
  refine ⟨⟨fun ij => ⟨(S ij).card, Nat.lt_succ_of_le (hbound ij)⟩, fun ij => hcard ij, ?_⟩, ?_⟩
  · rw [TypeDensity.residuePatterns, Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    unfold TypeDensity.patternWeight
    have step1 : ∀ ij : Fin n × Fin n, (ij.1.val + 1) * (ij.2.val + 1) * (S ij).card
        = ∑ Q ∈ D.support, if (TypeDensity.directionDegree k Q = ij.1.val + 1 ∧ D Q = ij.2.val + 1)
            then TypeDensity.directionDegree k Q * D Q else 0 := by
      intro ij
      rw [← Finset.sum_filter, hconst, mul_comm]
    simp only [step1]
    rw [Finset.sum_comm, ← hD, hsum]
    apply Finset.sum_congr rfl
    intro Q hQ
    have hle : TypeDensity.directionDegree k Q * D Q ≤ n := hD ▸ TypeDensity.directionDegree_mul_le_exceptionalDegree k D Q
    have hD1 : 1 ≤ D Q := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hQ)
    have hd1 := hdeg Q
    have hA : TypeDensity.directionDegree k Q ≤ n := by nlinarith
    have hB : D Q ≤ n := by nlinarith
    rw [Finset.sum_eq_single_of_mem (⟨TypeDensity.directionDegree k Q - 1, by omega⟩, ⟨D Q - 1, by omega⟩)
      (Finset.mem_univ _)]
    · rw [if_pos]; simp only; constructor <;> omega
    · intro ij _ hne
      rw [if_neg]
      rintro ⟨h1, h2⟩
      apply hne
      ext <;> simp <;> omega
  · intro m m' hm hm'
    funext ij
    exact Fin.ext ((hm ij).symm.trans (hm' ij))
