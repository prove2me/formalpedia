-- title:
--   Uniform families of oracle quantum circuits
-- statement:
--   A **family of oracle quantum circuits** gives, at each input length $n$, a number of ancilla wires, an oracle circuit on the $n$ input wires and the ancillas, and an output wire. On input $x$ the circuit runs from $|x,0\cdots0\rangle$, and its acceptance probability is the probability that measuring the output wire gives $1$.
--
--   The family is **uniform** if a deterministic polynomial-time computable map, with no oracle access, sends $1^n$ to its description at length $n$. It is **polynomially bounded** if one polynomial bounds the number of instructions and the number of ancillas.
-- source:
--   Goldin, Lombardi, Morimae, Quantum Advantage has Few Complexity Implications, arXiv:2611.05303v1, §3.2.1, p. 12 (PDF p. 14); Definition 3.6, p. 13 (PDF p. 15)

import Mathlib
import Definitions.Def_QAdvFew_PoQOracle_OInstr

open QAlgorithms.Complexity

namespace QAdvFew.PoQOracle

/-- A family of oracle quantum circuits deciding a language (Goldin, Lombardi, Morimae, *Quantum
Advantage has Few Complexity Implications*, arXiv:2611.05303v1, §3.2.1, p. 12 (PDF p. 14), and
Definition 3.6, p. 13 (PDF p. 15)): at input length `n`, `anc n` ancilla wires beyond a mandatory
one, an oracle circuit on `n + anc n + 1` wires, and an output wire. Modelled on
`QAlgorithms.Complexity.Family`, with oracle gates added. -/
structure OQFamily where
  /-- number of ancilla wires at input length `n`, beyond a mandatory one -/
  anc : ℕ → ℕ
  /-- the circuit at input length `n` -/
  circ : (n : ℕ) → OCirc (n + anc n + 1)
  /-- the output wire at input length `n` -/
  out : (n : ℕ) → Fin (n + anc n + 1)

namespace OQFamily

/-- The input state `|x, 0…0⟩`: the bits of `x` on the first `|x|` wires, ancillas `|0⟩`. -/
def inputState (Q : OQFamily) (x : Str) : QState (x.length + Q.anc x.length + 1) :=
  basisState fun i => if h : (i : ℕ) < x.length then x.get ⟨i, h⟩ else false

/-- The acceptance probability of `Q^O(x)`: the probability that measuring the output wire in the
computational basis gives `1`. -/
noncomputable def accept (Q : OQFamily) (O : Oracle) (x : Str) : ℝ :=
  ∑ y : Bits (x.length + Q.anc x.length + 1),
    if y (Q.out x.length) then ‖(Q.circ x.length).run O (Q.inputState x) y‖ ^ 2 else 0

/-- Uniformity (p. 12: "Uniform circuit families have descriptions generated by a deterministic
polynomial-time algorithm"): a polynomial-time computable map, with no oracle access, sends `1^n`
to the ancilla count, the output wire and the circuit at length `n` (as
`QAlgorithms.Complexity.Uniform`, with the oracle gate encoded by `OInstr.enc`). -/
def Uniform (Q : OQFamily) : Prop :=
  ∃ f : Str → Str, PolyTimeComputable f ∧
    ∀ n : ℕ, f (unary n) = encNat (Q.anc n) ++ encNat (Q.out n : ℕ) ++ (Q.circ n).enc

/-- One polynomial bounds the number of instructions and the number of ancillas. -/
def PolyBounded (Q : OQFamily) : Prop :=
  ∃ q : Polynomial ℕ, ∀ n : ℕ, (Q.circ n).length ≤ q.eval n ∧ Q.anc n ≤ q.eval n

end OQFamily

end QAdvFew.PoQOracle


