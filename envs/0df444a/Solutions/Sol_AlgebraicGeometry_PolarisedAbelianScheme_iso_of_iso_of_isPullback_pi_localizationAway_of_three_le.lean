section MulTransport

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem mul_val_congr (L : RelativeGroupLaw R f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (x y : SchemeHomOver t₁ f) (x' y' : SchemeHomOver t₂ f) (hx : x.1 = x'.1) (hy : y.1 = y'.1) :
    (L.mul t₁ x y).1 = (L.mul t₂ x' y').1 := by
  subst h
  obtain rfl : x = x' := Subtype.ext hx
  obtain rfl : y = y' := Subtype.ext hy
  rfl

end MulTransport

section Cmp

variable {g d n : ℕ}

structure Cmp {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S') (gA : u'.A ⟶ u.A) : Prop where
  sq : CategoryTheory.IsPullback gA u'.f u.f (Spec.map (CommRingCat.ofHom φ))
  mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (x y : SchemeHomOver t' u'.f),
      (u'.L.mul t' x y).1 ≫ gA =
        (u.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨x.1 ≫ gA, by rw [Category.assoc, sq.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA, by rw [Category.assoc, sq.w, ← Category.assoc, y.2]⟩).1
  lev : ∀ i, (u'.P i).1 ≫ gA = Spec.map (CommRingCat.ofHom φ) ≫ (u.P i).1

theorem Cmp.of_isPullback {S S' : Type} [CommRing S] [CommRing S'] {φ : S →+* S'}
    {u : PolarisedAbelianScheme g d n S} {u' : PolarisedAbelianScheme g d n S'}
    (h : PolarisedAbelianScheme.IsPullback φ u u') :
    ∃ gA : u'.A ⟶ u.A, Cmp φ u u' gA ∧ Nonempty ((Scheme.Modules.pullback gA).obj u.pol ≅ u'.pol) := by
  obtain ⟨gA, hg, hmul, hP, hpol⟩ := h
  exact ⟨gA, ⟨hg, hmul, hP⟩, hpol⟩

theorem specMap_comp {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] (φ : S →+* S') (ψ : S' →+* S'') :
    Spec.map (CommRingCat.ofHom (ψ.comp φ)) = Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
  rw [CommRingCat.ofHom_comp, Spec.map_comp]

theorem Cmp.congr {S S' : Type} [CommRing S] [CommRing S'] {φ φ' : S →+* S'}
    {u : PolarisedAbelianScheme g d n S} {u' : PolarisedAbelianScheme g d n S'} {gA : u'.A ⟶ u.A}
    (h : Cmp φ u u' gA) (e : φ = φ') : Cmp φ' u u' gA := by
  subst e; exact h

theorem Cmp.comp {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] {φ : S →+* S'} {ψ : S' →+* S''}
    {u : PolarisedAbelianScheme g d n S} {u' : PolarisedAbelianScheme g d n S'} {u'' : PolarisedAbelianScheme g d n S''}
    {a : u'.A ⟶ u.A} {b : u''.A ⟶ u'.A} (ha : Cmp φ u u' a) (hb : Cmp ψ u' u'' b) :
    Cmp (ψ.comp φ) u u'' (b ≫ a) := by
  have hsq : CategoryTheory.IsPullback (b ≫ a) u''.f u.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))) := by
    rw [specMap_comp]; exact hb.sq.paste_horiz ha.sq
  refine ⟨hsq, ?_, ?_⟩
  · intro T t x y
    rw [← Category.assoc, hb.mul, ha.mul]
    exact mul_val_congr u.L (by rw [specMap_comp, Category.assoc]) _ _ _ _ (Category.assoc _ _ _) (Category.assoc _ _ _)
  · intro i
    rw [← Category.assoc, hb.lev, Category.assoc, ha.lev, ← Category.assoc, specMap_comp]

theorem Cmp.of_iso {S S' : Type} [CommRing S] [CommRing S'] {φ : S →+* S'}
    {u : PolarisedAbelianScheme g d n S} {u' w : PolarisedAbelianScheme g d n S'}
    {a : u'.A ⟶ u.A} (ha : Cmp φ u u' a) (e : w.A ≅ u'.A) (he : e.hom ≫ u'.f = w.f)
    (hemul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S')) (x y : SchemeHomOver t w.f),
      (w.L.mul t x y).1 ≫ e.hom =
        (u'.L.mul t ⟨x.1 ≫ e.hom, by rw [Category.assoc, he]; exact x.2⟩
          ⟨y.1 ≫ e.hom, by rw [Category.assoc, he]; exact y.2⟩).1)
    (heP : ∀ i, (w.P i).1 ≫ e.hom = (u'.P i).1) :
    Cmp φ u w (e.hom ≫ a) := by
  have h1 : CategoryTheory.IsPullback e.hom w.f u'.f (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
  have hsq : CategoryTheory.IsPullback (e.hom ≫ a) w.f u.f (Spec.map (CommRingCat.ofHom φ)) := by
    have := h1.paste_horiz ha.sq
    rwa [Category.id_comp] at this
  refine ⟨hsq, ?_, ?_⟩
  · intro T t x y
    rw [← Category.assoc, hemul, ha.mul]
    exact mul_val_congr u.L rfl _ _ _ _ (Category.assoc _ _ _) (Category.assoc _ _ _)
  · intro i
    rw [← Category.assoc, heP, ha.lev]

theorem Cmp.lift {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] {φ : S →+* S'} {ψ : S' →+* S''} {χ : S →+* S''}
    (hχ : χ = ψ.comp φ)
    {u : PolarisedAbelianScheme g d n S} {u' : PolarisedAbelianScheme g d n S'} {w : PolarisedAbelianScheme g d n S''}
    {a : u'.A ⟶ u.A} (ha : Cmp φ u u' a) {m : w.A ⟶ u.A} (hm : Cmp χ u w m) :
    ∃ b : w.A ⟶ u'.A, b ≫ a = m ∧ Cmp ψ u' w b := by
  subst hχ
  have hw : m ≫ u.f = (w.f ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [hm.sq.w, specMap_comp, Category.assoc]
  let b : w.A ⟶ u'.A := ha.sq.lift m (w.f ≫ Spec.map (CommRingCat.ofHom ψ)) hw
  have hb₁ : b ≫ a = m := ha.sq.lift_fst _ _ _
  have hb₂ : b ≫ u'.f = w.f ≫ Spec.map (CommRingCat.ofHom ψ) := ha.sq.lift_snd _ _ _
  have hsq : CategoryTheory.IsPullback b w.f u'.f (Spec.map (CommRingCat.ofHom ψ)) := by
    refine IsPullback.of_right ?_ hb₂ ha.sq
    rw [hb₁, ← specMap_comp]
    exact hm.sq
  refine ⟨b, hb₁, hsq, ?_, ?_⟩
  · intro T t x y
    apply ha.sq.hom_ext
    · rw [Category.assoc, hb₁, hm.mul, ha.mul]
      exact mul_val_congr u.L (by rw [specMap_comp, Category.assoc]) _ _ _ _
        (show x.1 ≫ m = (x.1 ≫ b) ≫ a by rw [Category.assoc, hb₁])
        (show y.1 ≫ m = (y.1 ≫ b) ≫ a by rw [Category.assoc, hb₁])
    · simp only [Category.assoc, hb₂, reassoc_of% (w.L.mul t x y).2]
      exact ((u'.L.mul _ _ _).2).symm
  · intro i
    apply ha.sq.hom_ext
    · rw [Category.assoc, hb₁, hm.lev, Category.assoc, ha.lev, ← Category.assoc, specMap_comp]
    · rw [Category.assoc, hb₂, ← Category.assoc, (w.P i).2, Category.assoc, (u'.P i).2, Category.id_comp,
        Category.comp_id]

end Cmp

section LocIso

def LocIso {R : Type} [CommRing R] {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of R)) (M N : X.Modules) : Prop :=
  ∀ s : ↥(Spec (CommRingCat.of R)), ∃ U : (Spec (CommRingCat.of R)).Opens, s ∈ U ∧
    Nonempty ((Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj M ≅ (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj N)

variable {R : Type} [CommRing R] {X : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of R)}

theorem LocIso.of_iso {M N : X.Modules} (e : M ≅ N) : LocIso f M N :=
  fun s => ⟨⊤, TopologicalSpace.Opens.mem_top s, ⟨(Scheme.Modules.pullback _).mapIso e⟩⟩

theorem LocIso.rfl (M : X.Modules) : LocIso f M M := LocIso.of_iso (Iso.refl M)

theorem LocIso.symm {M N : X.Modules} (h : LocIso f M N) : LocIso f N M := fun s => by
  obtain ⟨U, hs, ⟨e⟩⟩ := h s
  exact ⟨U, hs, ⟨e.symm⟩⟩

def restrictIso {M N : X.Modules} {U V : (Spec (CommRingCat.of R)).Opens} (hVU : V ≤ U)
    (e : (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj M ≅ (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj N) :
    (Scheme.Modules.pullback (f ⁻¹ᵁ V).ι).obj M ≅ (Scheme.Modules.pullback (f ⁻¹ᵁ V).ι).obj N :=
  have hle : f ⁻¹ᵁ V ≤ f ⁻¹ᵁ U := f.preimage_mono hVU
  have hι : (f ⁻¹ᵁ V).ι = X.homOfLE hle ≫ (f ⁻¹ᵁ U).ι := (X.homOfLE_ι hle).symm
  (Scheme.Modules.pullbackCongr hι).app M ≪≫ ((Scheme.Modules.pullbackComp (X.homOfLE hle) (f ⁻¹ᵁ U).ι).app M).symm ≪≫
    (Scheme.Modules.pullback (X.homOfLE hle)).mapIso e ≪≫
    (Scheme.Modules.pullbackComp (X.homOfLE hle) (f ⁻¹ᵁ U).ι).app N ≪≫ (Scheme.Modules.pullbackCongr hι.symm).app N

theorem LocIso.trans {M N P : X.Modules} (h₁ : LocIso f M N) (h₂ : LocIso f N P) : LocIso f M P := fun s => by
  obtain ⟨U, hsU, ⟨e₁⟩⟩ := h₁ s
  obtain ⟨V, hsV, ⟨e₂⟩⟩ := h₂ s
  exact ⟨U ⊓ V, ⟨hsU, hsV⟩, ⟨restrictIso inf_le_left e₁ ≪≫ restrictIso inf_le_right e₂⟩⟩

theorem LocIso.pullback {R' : Type} [CommRing R'] {Y : Scheme.{0}} {f' : Y ⟶ Spec (CommRingCat.of R')}
    (ψ : R →+* R') (k : Y ⟶ X) (hk : k ≫ f = f' ≫ Spec.map (CommRingCat.ofHom ψ))
    {M N : X.Modules} (h : LocIso f M N) :
    LocIso f' ((Scheme.Modules.pullback k).obj M) ((Scheme.Modules.pullback k).obj N) := fun s' => by
  obtain ⟨U, hsU, ⟨e⟩⟩ := h ((Spec.map (CommRingCat.ofHom ψ)).base s')
  refine ⟨Spec.map (CommRingCat.ofHom ψ) ⁻¹ᵁ U, hsU, ?_⟩
  have hle : f' ⁻¹ᵁ (Spec.map (CommRingCat.ofHom ψ) ⁻¹ᵁ U) ≤ k ⁻¹ᵁ (f ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, ← hk, Scheme.Hom.comp_preimage]
  let r := k.resLE (f ⁻¹ᵁ U) (f' ⁻¹ᵁ (Spec.map (CommRingCat.ofHom ψ) ⁻¹ᵁ U)) hle
  have hr : (f' ⁻¹ᵁ (Spec.map (CommRingCat.ofHom ψ) ⁻¹ᵁ U)).ι ≫ k = r ≫ (f ⁻¹ᵁ U).ι :=
    (Scheme.Hom.resLE_comp_ι k hle).symm
  exact ⟨(Scheme.Modules.pullbackComp _ k).app M ≪≫ (Scheme.Modules.pullbackCongr hr).app M ≪≫
    ((Scheme.Modules.pullbackComp r _).app M).symm ≪≫ (Scheme.Modules.pullback r).mapIso e ≪≫
    (Scheme.Modules.pullbackComp r _).app N ≪≫ (Scheme.Modules.pullbackCongr hr.symm).app N ≪≫
    ((Scheme.Modules.pullbackComp _ k).app N).symm⟩

end LocIso

def pullbackCompIso {X Y Z : Scheme.{0}} (k : X ⟶ Y) (l : Y ⟶ Z) (M : Z.Modules) :
    (Scheme.Modules.pullback (k ≫ l)).obj M ≅ (Scheme.Modules.pullback k).obj ((Scheme.Modules.pullback l).obj M) :=
  ((Scheme.Modules.pullbackComp k l).app M).symm

end ED2Aux

end

noncomputable section

namespace ED2Aux

section Points

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)

theorem nsmul_val' {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (P : SchemeHomOver t f) :
    (L.nsmul t n P).1 = P.1 ≫ L.schemeNsmul n := by
  have h := L.nsmul_natural f t P.1 P.2 n RelativeGroupLaw.idPoint
  have hP : schemeHomOverComp P.1 P.2 (RelativeGroupLaw.idPoint (f := f)) = P := by
    apply Subtype.ext
    rw [GoodReductionJacobian.schemeHomOverComp_coe]
    exact Category.comp_id _
  rw [hP] at h
  rw [← h, GoodReductionJacobian.schemeHomOverComp_coe]
  rfl

theorem one_val' {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) :
    (L.one t).1 = t ≫ (L.one (𝟙 (Spec (CommRingCat.of R)))).1 := by
  have h := L.one_natural (𝟙 (Spec (CommRingCat.of R))) t t (Category.comp_id t)
  rw [← h, GoodReductionJacobian.schemeHomOverComp_coe]

theorem fst_comp_f' (n : ℕ) : pullback.fst (L.schemeNsmul n) (L.one (𝟙 _)).1 ≫ f = L.schemeKerStr n := by
  have h1 : pullback.fst (L.schemeNsmul n) (L.one (𝟙 _)).1 ≫ f =
      pullback.fst (L.schemeNsmul n) (L.one (𝟙 _)).1 ≫ (L.schemeNsmul n ≫ f) := by rw [L.schemeNsmul_over]
  rw [h1, ← Category.assoc, pullback.condition, Category.assoc, (L.one (𝟙 _)).2]
  exact Category.comp_id _

end Points

section Cartesian

variable {R R' : Type} [CommRing R] [CommRing R'] {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
  {f' : A' ⟶ Spec (CommRingCat.of R')} (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R' f')
  (ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)) (g : A' ⟶ A) (hg : IsPullback g f' f ι)
  (hmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) (P Q : SchemeHomOver t' f'),
    (L'.mul t' P Q).1 ≫ g =
      (L.mul (t' ≫ ι) ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
        ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)

def pushAlong {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) (P : SchemeHomOver t' f') :
    SchemeHomOver (t' ≫ ι) f :=
  ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩

include hmul in
theorem one_g {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) :
    (L'.one t').1 ≫ g = (L.one (t' ≫ ι)).1 := by
  letI := L.pointGroup (t' ≫ ι)
  let x : SchemeHomOver (t' ≫ ι) f := pushAlong ι g hg t' (L'.one t')
  have h := hmul t' (L'.one t') (L'.one t')
  rw [L'.one_mul] at h
  have hx : x = x * x := Subtype.ext h
  have : x = 1 := by
    have h2 : x * x = x * 1 := by rw [mul_one]; exact hx.symm
    exact mul_left_cancel h2
  exact congrArg Subtype.val this

include hmul in
theorem nsmul_g {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R')) (n : ℕ) (P : SchemeHomOver t' f') :
    (L'.nsmul t' n P).1 ≫ g = (L.nsmul (t' ≫ ι) n (pushAlong ι g hg t' P)).1 := by
  induction n with
  | zero => exact one_g L L' ι g hg hmul t'
  | succ n ih =>
      rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hmul]
      congr 2
      exact Subtype.ext ih

include hmul in
theorem schemeNsmul_g (n : ℕ) : L'.schemeNsmul n ≫ g = g ≫ L.schemeNsmul n := by
  have h := nsmul_g L L' ι g hg hmul f' n RelativeGroupLaw.idPoint
  rw [nsmul_val', nsmul_val'] at h
  change (𝟙 A' ≫ L'.schemeNsmul n) ≫ g = (𝟙 A' ≫ g) ≫ L.schemeNsmul n at h
  rw [Category.id_comp, Category.id_comp] at h
  exact h

include hmul in
theorem unit_g : (L'.one (𝟙 _)).1 ≫ g = ι ≫ (L.one (𝟙 _)).1 := by
  rw [one_g L L' ι g hg hmul, one_val', Category.id_comp]

include hmul in

theorem exists_isPullback_schemeKerStr (n : ℕ) :
    ∃ π : L'.schemeKer n ⟶ L.schemeKer n, IsPullback π (L'.schemeKerStr n) (L.schemeKerStr n) ι := by

  let e : Spec (CommRingCat.of R) ⟶ A := (L.one (𝟙 _)).1
  let e' : Spec (CommRingCat.of R') ⟶ A' := (L'.one (𝟙 _)).1
  have hN := schemeNsmul_g L L' ι g hg hmul n
  have hU : e' ≫ g = ι ≫ e := unit_g L L' ι g hg hmul
  have w : (pullback.fst (L'.schemeNsmul n) e' ≫ g) ≫ L.schemeNsmul n = (pullback.snd (L'.schemeNsmul n) e' ≫ ι) ≫ e := by
    rw [Category.assoc, ← hN, ← Category.assoc, pullback.condition, Category.assoc, hU, Category.assoc]
  let π : L'.schemeKer n ⟶ L.schemeKer n := pullback.lift _ _ w
  have hπ1 : π ≫ pullback.fst _ _ = pullback.fst _ _ ≫ g := pullback.lift_fst _ _ _
  have hπ2 : π ≫ pullback.snd _ _ = pullback.snd _ _ ≫ ι := pullback.lift_snd _ _ _
  refine ⟨π, IsPullback.of_isLimit' ⟨hπ2⟩ ?_⟩
  refine PullbackCone.IsLimit.mk _ (fun c => ?_) (fun c => ?_) (fun c => ?_) (fun c m hm1 hm2 => ?_)
  ·
    refine pullback.lift (hg.lift (c.fst ≫ pullback.fst _ _) c.snd ?_) c.snd ?_
    · rw [Category.assoc, fst_comp_f']; exact c.condition
    · apply hg.hom_ext
      · rw [Category.assoc, hN, ← Category.assoc, IsPullback.lift_fst, Category.assoc, pullback.condition,
          ← Category.assoc, Category.assoc c.snd, hU, ← Category.assoc]
        congr 1
        exact c.condition
      · rw [Category.assoc, L'.schemeNsmul_over, IsPullback.lift_snd, Category.assoc, (L'.one (𝟙 _)).2]
        exact (Category.comp_id _).symm
  ·
    apply pullback.hom_ext
    · rw [Category.assoc, hπ1, ← Category.assoc, pullback.lift_fst, IsPullback.lift_fst]
    · rw [Category.assoc, hπ2, ← Category.assoc, pullback.lift_snd]
      exact c.condition.symm
  ·
    exact pullback.lift_snd _ _ _
  ·
    apply pullback.hom_ext
    · rw [pullback.lift_fst]
      apply hg.hom_ext
      · rw [IsPullback.lift_fst, Category.assoc, ← hπ1, ← Category.assoc, hm1]
      · rw [IsPullback.lift_snd, Category.assoc, fst_comp_f']
        exact hm2
    · rw [pullback.lift_snd]; exact hm2

end Cartesian

section Descent

variable {g d n : ℕ} {S S' : Type} [CommRing S] [CommRing S'] [Algebra S S'] [Module.FaithfullyFlat S S']

theorem includeLeftRingHom_comp_algebraMap :
    (Algebra.TensorProduct.includeLeftRingHom : S' →+* S' ⊗[S] S').comp (algebraMap S S') =
      (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom.comp (algebraMap S S') := by
  ext r
  have h1 := (Algebra.TensorProduct.includeLeft : S' →ₐ[S] S' ⊗[S] S').commutes r
  have h2 := (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').commutes r
  first
    | exact h1.trans h2.symm
    | (simp only [RingHom.coe_comp, Function.comp_apply]; exact h1.trans h2.symm)
    | simp [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.includeRight_apply,
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
        Algebra.TensorProduct.one_def]

theorem specMap_epi {Y : Scheme.{0}} (a b : Spec (CommRingCat.of S) ⟶ Y)
    (h : Spec.map (CommRingCat.ofHom (algebraMap S S')) ≫ a = Spec.map (CommRingCat.ofHom (algebraMap S S')) ≫ b) : a = b := by
  have hc : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : S' →+* S' ⊗[S] S')) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap S S')) ≫ a) =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap S S')) ≫ a) := by
    rw [← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, includeLeftRingHom_comp_algebraMap]
  obtain ⟨φ, -, huniq⟩ := AlgebraicGeometry.existsUnique_specMap_comp_eq_of_faithfullyFlat
    (Spec.map (CommRingCat.ofHom (algebraMap S S')) ≫ a) hc
  exact (huniq a rfl).trans (huniq b h.symm).symm

theorem descend (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S))
    (u u' : PolarisedAbelianScheme g d n S) (v : PolarisedAbelianScheme g d n S') (c : v.A ⟶ u.A)
    (hc : Cmp (algebraMap S S') u v c) (κ : (Scheme.Modules.pullback c).obj u.pol ≅ v.pol)
    (ψ : v.A ⟶ u'.A) (hψ : Cmp (algebraMap S S') u' v ψ)
    (hψpol : LocIso v.f ((Scheme.Modules.pullback ψ).obj u'.pol) v.pol) :
    (∃ E : u.A ⟶ u'.A, c ≫ E = ψ) ∧ (∀ {Y : Scheme.{0}} (a b : u.A ⟶ Y), c ≫ a = c ≫ b → a = b) := by
  classical
  set alg := algebraMap S S' with halg
  set i₁ := (Algebra.TensorProduct.includeLeftRingHom : S' →+* S' ⊗[S] S') with hi₁
  set i₂ := (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom with hi₂
  have E12 : i₁.comp alg = i₂.comp alg := by rw [hi₁, hi₂, halg]; exact includeLeftRingHom_comp_algebraMap
  have hn'' : IsUnit ((n : ℕ) : S' ⊗[S] S') := by
    simpa only [map_natCast] using hn'.map (algebraMap S (S' ⊗[S] S'))

  obtain ⟨w, hw⟩ := PolarisedAbelianScheme.exists_isPullback i₁ v
  obtain ⟨p, hp, ⟨κp⟩⟩ := Cmp.of_isPullback hw
  obtain ⟨q, hqc, hq⟩ := Cmp.lift (ψ := i₂) (χ := i₂.comp alg) rfl hc ((hc.comp hp).congr E12)

  have huniq : ∀ {Y : Scheme.{0}} (a b : u.A ⟶ Y), c ≫ a = c ≫ b → a = b := by
    intro Y a b hab
    have hcoc : p ≫ (c ≫ a) = q ≫ (c ≫ a) := by rw [← Category.assoc, ← Category.assoc, hqc]
    obtain ⟨φ, -, hu⟩ := AlgebraicGeometry.existsUnique_comp_eq_of_isPullback_of_faithfullyFlat u.f v.f c hc.sq w.f p q
      hp.sq hq.sq hqc.symm (c ≫ a) hcoc
    exact (hu a rfl).trans (hu b hab.symm).symm
  refine ⟨?_, huniq⟩

  have hg₁ : Cmp (i₁.comp alg) u' w (p ≫ ψ) := hψ.comp hp
  have hg₂ : Cmp (i₁.comp alg) u' w (q ≫ ψ) := (hψ.comp hq).congr E12.symm
  have hpol₁ : LocIso w.f ((Scheme.Modules.pullback (p ≫ ψ)).obj u'.pol) w.pol :=
    (LocIso.of_iso (pullbackCompIso p ψ u'.pol)).trans
      ((LocIso.pullback _ p hp.sq.w hψpol).trans (LocIso.of_iso κp))
  have G : (Scheme.Modules.pullback q).obj v.pol ≅ w.pol :=
    (Scheme.Modules.pullback q).mapIso κ.symm ≪≫ (pullbackCompIso q c u.pol).symm ≪≫
      (Scheme.Modules.pullbackCongr hqc).app u.pol ≪≫ pullbackCompIso p c u.pol ≪≫
      (Scheme.Modules.pullback p).mapIso κ ≪≫ κp
  have hpol₂ : LocIso w.f ((Scheme.Modules.pullback (q ≫ ψ)).obj u'.pol) w.pol :=
    (LocIso.of_iso (pullbackCompIso q ψ u'.pol)).trans
      ((LocIso.pullback _ q hq.sq.w hψpol).trans (LocIso.of_iso G))
  have hcyc : p ≫ ψ = q ≫ ψ :=
    AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hn (i₁.comp alg) hn''
      u' w _ _ hg₁.sq hg₁.mul hg₁.lev hpol₁ hg₂.sq hg₂.mul hg₂.lev hpol₂
  obtain ⟨E, hE, -⟩ := AlgebraicGeometry.existsUnique_comp_eq_of_isPullback_of_faithfullyFlat u.f v.f c hc.sq w.f p q
    hp.sq hq.sq hqc.symm ψ hcyc
  exact ⟨E, hE⟩

theorem baseChange_epi {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) {Y : Scheme.{0}} (a b : T ⟶ Y)
    (h : pullback.fst t (Spec.map (CommRingCat.ofHom (algebraMap S S'))) ≫ a =
      pullback.fst t (Spec.map (CommRingCat.ofHom (algebraMap S S'))) ≫ b) : a = b := by
  classical
  set alg := algebraMap S S' with halg
  set i₁ := (Algebra.TensorProduct.includeLeftRingHom : S' →+* S' ⊗[S] S') with hi₁
  set i₂ := (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom with hi₂
  have E12 : i₁.comp alg = i₂.comp alg := by rw [hi₁, hi₂, halg]; exact includeLeftRingHom_comp_algebraMap
  have hS : Spec.map (CommRingCat.ofHom i₁) ≫ Spec.map (CommRingCat.ofHom alg) =
      Spec.map (CommRingCat.ofHom i₂) ≫ Spec.map (CommRingCat.ofHom alg) := by
    rw [← specMap_comp, ← specMap_comp, E12]
  let p := pullback.fst t (Spec.map (CommRingCat.ofHom alg))
  let t' := pullback.snd t (Spec.map (CommRingCat.ofHom alg))
  have hp : IsPullback p t' t (Spec.map (CommRingCat.ofHom alg)) := IsPullback.of_hasPullback _ _
  let q₁ := pullback.fst t' (Spec.map (CommRingCat.ofHom i₁))
  let t'' := pullback.snd t' (Spec.map (CommRingCat.ofHom i₁))
  have hq₁ : IsPullback q₁ t'' t' (Spec.map (CommRingCat.ofHom i₁)) := IsPullback.of_hasPullback _ _
  have w : (q₁ ≫ p) ≫ t = (t'' ≫ Spec.map (CommRingCat.ofHom i₂)) ≫ Spec.map (CommRingCat.ofHom alg) := by
    rw [Category.assoc, hp.w, ← Category.assoc, hq₁.w, Category.assoc, Category.assoc, hS]
  let q₂ := hp.lift (q₁ ≫ p) (t'' ≫ Spec.map (CommRingCat.ofHom i₂)) w
  have hq₂₁ : q₂ ≫ p = q₁ ≫ p := hp.lift_fst _ _ _
  have hq₂₂ : q₂ ≫ t' = t'' ≫ Spec.map (CommRingCat.ofHom i₂) := hp.lift_snd _ _ _
  have hq₂ : IsPullback q₂ t'' t' (Spec.map (CommRingCat.ofHom i₂)) := by
    refine IsPullback.of_right ?_ hq₂₂ hp
    rw [hq₂₁, ← hS]
    exact hq₁.paste_horiz hp
  have hcoc : q₁ ≫ (p ≫ a) = q₂ ≫ (p ≫ a) := by rw [← Category.assoc, ← Category.assoc, hq₂₁]
  obtain ⟨φ, -, hu⟩ := AlgebraicGeometry.existsUnique_comp_eq_of_isPullback_of_faithfullyFlat t t' p hp t'' q₁ q₂
    hq₁ hq₂ hq₂₁.symm (p ≫ a) hcoc
  exact (hu a rfl).trans (hu b h.symm).symm

end Descent

