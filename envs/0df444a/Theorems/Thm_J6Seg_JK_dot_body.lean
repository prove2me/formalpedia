open J6Seg J6Seg.JK
open IntMul NLogN NLogN.KIL Function
variable (P : ℕ) (F : Fin HS → List ℤ) (X : Fin HS) (cs acc R T0 : List ℤ) (S0 : ℤ) (Ls : List ℤ)
variable {P F X cs acc R T0 S0 Ls}

theorem J6Seg.JK.dot_body {M : MulSpec} {Xb Φm Bx : ℕ} (hMB : MulBnd M Xb Φm) (hX : XOK X)
    (s : IState HS) {lp lp1 : List ℤ} (hPX : F PX = []) (hrP : F rP = 2 ^ P :: lp)
    (hrP1 : F rP1 = 2 ^ (P + 1) :: lp1) (N k : ℕ) (hk : k < cs.length)
    (hca : cs.length ≤ acc.length) (hc : zsz cs[k] ≤ Xb) (ha : zsz (acc[k]'(by omega)) ≤ Xb)
    (hXB : 2 * Xb + 3 ≤ Bx) (hPB : P + 3 ≤ Bx) (hS0 : zsz (S0 + dotF P (cs.take k) acc) ≤ Bx)
    (hS1 : zsz (S0 + dotF P (cs.take (k + 1)) acc) ≤ Bx) :
    MSp M (kD X) (encK s (update (J6Seg.JK.dSt P F X cs acc R T0 S0 Ls k) CD [(N : ℤ) - k]))
      (encK s (update (J6Seg.JK.dSt P F X cs acc R T0 S0 Ls (k + 1)) CD [(N : ℤ) - k]))
      (Φm + 10 ^ 5 * (Bx + 2)) := by sorry
