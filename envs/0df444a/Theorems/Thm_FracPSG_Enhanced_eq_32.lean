-- title:
--   (32), proof of Theorem 6.1 — per-candidate inequality of the enhanced e-PSG step
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 (enhanced extrapolated proximal subgradient algorithm) under Assumptions 1 and 2′, with Step 1 parameters as in the algorithm and bounded sublevel set $S_0$. Write $\theta_n=f(x_n)/g(x_n)$, $u_n,v_n$ for the extrapolated points and $w_n^{i}$ for the candidates. Then for all $n\in\mathbb N$, every $i_n\in I_\varepsilon(x_n)$ and every $x\in S$,
--   $$\begin{aligned}
--   &f(x_{n+1})-\theta_n g(x_{n+1})+\tfrac12\Big(\tfrac{1-\sqrt\beta\zeta}{\tau_n}-\tfrac{M\mu_n}{\sqrt{mM}\tau_n}\Big)\|x_{n+1}-x_n\|^2\\
--   &\quad\le f(w_n^{i_n})-\theta_n g(w_n^{i_n})+\tfrac12\Big(\tfrac{1-\sqrt\beta\zeta}{\tau_n}-\tfrac{M\mu_n}{\sqrt{mM}\tau_n}\Big)\|w_n^{i_n}-x_n\|^2\\
--   &\quad\le f(x)-\theta_n g_{i_n}(x_n)+\tfrac1{2\tau_n}\|x-v_n\|^2-\tfrac1{2\tau_n}\|x_n-v_n\|^2-\theta_n\langle\nabla g_{i_n}(x_n),x-x_n\rangle+\tfrac\ell2\|x-u_n\|^2+\tfrac{m\mu_n}{2\sqrt{mM}\tau_n}\|x_n-x_{n-1}\|^2 .
--   \end{aligned}$$
--
--   The first inequality is the selection rule of Step 3; the second compares each candidate with an arbitrary feasible point. Taking $x=x_n$ and $i_n\in I_0(x_n)$ gives the one-step decrease of the algorithm.
--
--   **Formalization Note** Both inequalities are stated in $(-\infty,+\infty]$: $f$ may be $+\infty$ at a candidate or at $x$.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 23, (32) (proof of Theorem 6.1(i)&(ii))

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Inequality (32) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 23, proof of Theorem 6.1(i)&(ii)): for a run
of Algorithm 2 under the hypotheses of Theorem 6.1, for all `n`, every `iₙ ∈ I_ε(xₙ)` and every
`x ∈ S`,
`f(xₙ₊₁) − θₙg(xₙ₊₁) + ½((1 − √βζ)/τₙ − Mμₙ/(√(mM)τₙ))‖xₙ₊₁ − xₙ‖²
  ≤ f(wₙ^{iₙ}) − θₙg(wₙ^{iₙ}) + ½((1 − √βζ)/τₙ − Mμₙ/(√(mM)τₙ))‖wₙ^{iₙ} − xₙ‖²
  ≤ f(x) − θₙg_{iₙ}(xₙ) + (1/(2τₙ))‖x − vₙ‖² − (1/(2τₙ))‖xₙ − vₙ‖² − θₙ⟨∇g_{iₙ}(xₙ), x − xₙ⟩
    + (ℓ/2)‖x − uₙ‖² + (mμₙ/(2√(mM)τₙ))‖xₙ − xₙ₋₁‖²`
(inequalities in `(−∞, +∞]`). -/
theorem eq_32
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0))) :
    ∀ n, ∀ i ∈ activeSet ε gi (x n), ∀ y ∈ S,
      selObj (FracPSG.Subseq.objF fs fn) (maxFn gi) β ζ m M (τ n) (μ n) (FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n))
          (x n) (x (n + 1)) ≤
        selObj (FracPSG.Subseq.objF fs fn) (maxFn gi) β ζ m M (τ n) (μ n) (FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n))
          (x n) (w n i) ∧
      selObj (FracPSG.Subseq.objF fs fn) (maxFn gi) β ζ m M (τ n) (μ n) (FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n))
          (x n) (w n i) ≤
        FracPSG.Subseq.objF fs fn y + ((-(FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n) * gi i (x n))
          + 1 / (2 * τ n) * ‖y - FracPSG.Subseq.extrap x μ n‖ ^ 2 - 1 / (2 * τ n) * ‖x n - FracPSG.Subseq.extrap x μ n‖ ^ 2
          - FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n) * ⟪gradient (gi i) (x n), y - x n⟫_ℝ
          + ℓ / 2 * ‖y - FracPSG.Subseq.extrap x κ n‖ ^ 2
          + m * μ n / (2 * Real.sqrt (m * M) * τ n) * ‖x n - FracPSG.Subseq.xPrev x n‖ ^ 2 : ℝ) : EReal) := by sorry

end FracPSG.Enhanced
