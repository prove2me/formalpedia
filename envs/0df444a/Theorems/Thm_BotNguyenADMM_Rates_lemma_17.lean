-- title:
--   Lemma 17 — recurrence $\mathcal E_{k-1} - \mathcal E_{k+1} \ge C_{19}\mathcal E_{k+1}^{2\theta}$
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is a bounded sequence generated by Algorithm 1 or Algorithm 2, converging to $(\hat x,\hat z,\hat y)$, such that $\mathcal F_r$ satisfies the Łojasiewicz property (70) at $(\hat x,\hat z,\hat y,\hat x,\hat y)$ with constant $C_L>0$ and exponent $\theta\in[0,1)$. Then there is $k_0\ge2$ such that for every $k\ge k_0$
--   $$\mathcal E_{k-1} - \mathcal E_{k+1} \ge C_{19}\,\mathcal E_{k+1}^{2\theta},\qquad C_{19} = \frac{\min\{C_1/4,\,1/(\rho r)\}}{3C_L^2\max\{C_{14},C_{15}\}^2}. \qquad (86)$$
--
--   Fed into Lemma 15 (with $l_0 = 2$), this recurrence gives the convergence rates of $\mathcal F_k$ in Theorem 18.
--
--   **Formalization Note** The paper writes "there exists $k_0\ge1$"; at $k_0=1$ the term $\mathcal E_0$ would involve the undefined $x^{-1}$, so the statement asks for $k_0\ge2$ (a stronger existential). $\mathcal E_{k+1}^{2\theta}$ is read with $0^0 = 0$ (`powLoj`). $C_{14}$ and $C_{15}$ are the recomputed constants of the subgradient estimate (see the definition item). The Łojasiewicz hypothesis is `LojAt`: the convergence of the run plus (70) with $\operatorname{dist}(0,\emptyset) = +\infty$ and $0^0 = 0$; the paper's hypothesis implies it.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 26, Lemma 17, (86)

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **Lemma 17** (Boţ–Nguyen, arXiv:1801.01994v2, p. 26, (86)). Under Assumption 2, for a
bounded sequence generated by Algorithm 1 or Algorithm 2 such that `F_r` has the
Łojasiewicz property (70) at its limit with constant `C_L` and exponent `θ`, there is
`k₀ ≥ 2` with `E_{k−1} − E_{k+1} ≥ C₁₉ E_{k+1}^{2θ}` for every `k ≥ k₀`, where
`C₁₉ = min{C₁/4, 1/(ρr)} / (3C_L² max{C₁₄, C₁₅}²)` and `0^{2θ} := 0`. -/
theorem lemma_17
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (hbx : Bornology.IsBounded (Set.range x)) (hbz : Bornology.IsBounded (Set.range z))
    (hby : Bornology.IsBounded (Set.range y))
    (xh : BotNguyenADMM.KL.E n) (zh yh : BotNguyenADMM.KL.E m) (CL θ : ℝ)
    (hloj : LojAt v g h A L r ρ lam μ₁ x z y xh zh yh CL θ) :
    ∃ k₀ : ℕ, 2 ≤ k₀ ∧ ∀ k ≥ k₀,
      C19 v A L μ₁ μ₂ lam ρ r CL *
          powLoj (Ek v g h A L r ρ lam μ₁ x z y xh zh yh (k + 1)) θ ≤
        Ek v g h A L r ρ lam μ₁ x z y xh zh yh (k - 1) -
          Ek v g h A L r ρ lam μ₁ x z y xh zh yh (k + 1) := by sorry

end BotNguyenADMM.Rates
