  nlinarith [abs_nonneg (truncR p z.re), abs_nonneg (truncR p z.im), sq_abs (truncR p z.re),
    sq_abs z.re, sq_abs (truncR p z.im), sq_abs z.im, abs_nonneg z.re, abs_nonneg z.im,
