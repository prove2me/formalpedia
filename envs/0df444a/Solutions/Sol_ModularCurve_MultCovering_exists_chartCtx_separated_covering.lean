theorem ModularCurve.MultCovering.exists_modularUnit_coe_eq (p : ℕ) [Fact p.Prime] :
    ∃ u : ↥(modularFunctionFieldBar (1 * p)),
      (u : LaurentSeries (AlgebraicClosure ℚ)) = coeffEmb (AlgebraicClosure ℚ) (modularUnitSeries p) := by
  have key : ∀ (n : ℕ) [NeZero n], n = p → modularUnitSeries n = modularUnitSeries p := by
    intro n _ hn
    subst hn
    rfl
  refine ⟨⟨coeffEmb (AlgebraicClosure ℚ) (modularUnitSeries (1 * p)),
    coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ)
      (modularFunctionField_le_full (1 * p) (modularUnitSeries_mem_modularFunctionField_all (1 * p)))⟩, ?_⟩
  show coeffEmb (AlgebraicClosure ℚ) (modularUnitSeries (1 * p)) = coeffEmb (AlgebraicClosure ℚ) (modularUnitSeries p)
  rw [key (1 * p) (one_mul p)]

theorem solution (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    [DecidableEq (IsLocalRing.ResidueField ↥A)] [CharP (IsLocalRing.ResidueField ↥A) p] :
    ∃ Γ : ChartCtx p A,
      (∀ W : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (1 * p)),
        W ∈ Γ.S₁ → frickeInvolutionBar (1 * p) • W ∉ Γ.S₁) ∧
      (∀ W : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (1 * p)),
        frobOnPlacesGeomLevel (ResidueField ↥A) 1 Γ.data Γ.hKr
            (frobOnPlacesGeomLevel (ResidueField ↥A) 1 Γ.data Γ.hKr (Γ.P.redFst W)) = Γ.P.redFst W →
        IsAffineGeomPlace (ResidueField ↥A) 1 (Γ.P.redFst W) → Γ.P.redFst W ∉ ssPlaces p 1 (ResidueField ↥A) →
        W ∈ Γ.S₁ ∨ frickeInvolutionBar (1 * p) • W ∈ Γ.S₁) := by
  classical
  obtain ⟨data⟩ := nonempty_modularPolynomialData p
  have hKr : KroneckerCongruence p data := kroneckerCongruence_of_prime p data
  obtain ⟨hα, hβ, _, _, _⟩ := heckeInputsAllTranspose 1 ⟨p, Fact.out⟩
  obtain ⟨P⟩ := placeSpecialization_exists_level_one_of_surjective p data hKr A (ResidueField ↥A)
    (IsLocalRing.residue ↥A) IsLocalRing.residue_surjective hα hβ
  obtain ⟨R, hR⟩ := LevelOneProlongationPair.exists_isModel P
  have hfin : (ssJSet p (ResidueField ↥A)).Finite := ssJSet_finite p (ResidueField ↥A)
  have hWn : ∀ w, w ∈ hfin.toFinset.map ⟨charLGeomPlaceOfPoint (ResidueField ↥A), charLGeomPlaceOfPoint_injective _⟩ ↔
      w ∈ ssPlaces p 1 (ResidueField ↥A) := by
    intro w
    rw [mem_ssPlaces_one_iff_exists_charLGeomPlaceOfPoint_eq, Finset.mem_map]
    simp only [Set.Finite.mem_toFinset, Function.Embedding.coeFn_mk]
  have hcard : hfin.toFinset.card = mAnnuli p :=
    card_eq_of_ssJSet p hp5 (ResidueField ↥A) hfin.toFinset (fun j => hfin.mem_toFinset)
  obtain ⟨u, hu⟩ := exists_modularUnit_coe_eq p
  have hPD := hasPrincipalDivisors_modularFunctionFieldBar_unconditional (1 * p)
  have hS := LevelOneProlongationPair.chartFstLaws_sheetOne_of_isModel R hR u hu
  have hsc := sheetOne_frickeInvolutionBar_separated_and_covering P u hu
  exact ⟨{ data := data, hKr := hKr, hα := hα, hβ := hβ, P := P, R := R, S₁ := _,
           Wn := _, hWn := hWn, hfin := hfin, hcard := hcard,
           supply := LevelOneProlongationPair.chartFstSupply_of_isModel R hR hPD _ hS }, hsc.1, hsc.2⟩

