theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛) (hfs : 𝓛.FiniteBySections f) :
    (kernelPts f L 𝓛).Finite ∧
      ∀ (k' : Type) [Field k'] [IsAlgClosed k'] (sk : k →+* k'), 0 < Scheme.Modules.geomFibreH0Finrank f 𝓛 k' sk := by
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  haveI : SmoothOfRelativeDimension g f := L.smoothOfRelativeDimension_of_forall_topologicalKrullDim_eq g hdim

  let e0 : Spec (CommRingCat.of k) ⟶ A := (L.one (𝟙 _)).1
  haveI : Nonempty A := ⟨e0.base (⊥ : PrimeSpectrum k)⟩
  haveI : GeometricallyIntegral f := hA.geometricallyIntegral
  haveI : IsIntegral A := GeometricallyIntegral.isIntegral_of_subsingleton f
  have hd : topologicalKrullDim A = g :=
    le_antisymm (SmoothOfRelativeDimension.topologicalKrullDim_le f g) (SmoothOfRelativeDimension.le_topologicalKrullDim f g)

  obtain ⟨N, 𝔓, h𝔓⟩ := hfs
  refine ⟨?_, ?_⟩
  ·
    obtain ⟨𝒦, -⟩ := AbelianSchemePropertyBundle.exists_orderedAffineCover_card_eq k f hA g
    obtain ⟨q, hq, hχ⟩ :=
      Scheme.Modules.FiniteBySections.exists_polynomial_coeff_pos_forall_eulerChar_tensorPow_eq_monoidalV2
        f g hd 𝓛 h𝓛 ⟨N, 𝔓, h𝔓⟩ 𝒦
    have hq0 : q ≠ 0 := by intro h; rw [h, Polynomial.coeff_zero] at hq; exact lt_irrefl _ hq
    obtain ⟨m, hqm⟩ : ∃ m : ℕ, q.eval ((m : ℕ) : ℚ) ≠ 0 := by
      by_contra hcon
      push Not at hcon
      apply hq0
      apply Polynomial.eq_zero_of_infinite_isRoot
      have hinf : Set.Infinite (Set.range (fun n : ℕ => (n : ℚ))) :=
        Set.infinite_range_of_injective Nat.cast_injective
      exact hinf.mono (by rintro _ ⟨n, rfl⟩; exact hcon n)
    have h𝓛m : Scheme.Modules.IsInvertible (𝓛.tensorPow m) := isInvertible_tensorPow h𝓛 m
    have hχm : (OModulePresheaf.ofModules f (𝓛.tensorPow m)).eulerChar 𝒦 ≠ 0 := by
      intro h; apply hqm; rw [← hχ m, h]; simp
    obtain ⟨KL, ι, _, hιf, hK⟩ :=
      RelativeGroupLaw.exists_isClosedImmersion_isFinite_forall_iff_isInStabilizer_of_eulerChar_ne_zero
        k L hA (𝓛.tensorPow m) h𝓛m 𝒦 hχm
    haveI : IsFinite (ι ≫ f) := hιf
    have hS := finite_setOf_comp_eq_id (ι ≫ f)
    have hKm : (kernelPts f L (𝓛.tensorPow m)).Finite := by
      refine Set.Finite.of_injOn (f := fun x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f => x.1)
        (t := (fun κ => κ ≫ ι) '' {κ : Spec (CommRingCat.of k) ⟶ KL | κ ≫ (ι ≫ f) = 𝟙 _}) ?_
        (Subtype.val_injective.injOn) (hS.image _)
      intro x hx
      obtain ⟨κ, hκ⟩ := (hK (𝟙 _) x).mpr hx
      refine ⟨κ, ?_, hκ⟩
      show κ ≫ (ι ≫ f) = 𝟙 _
      rw [← Category.assoc, hκ, x.2]
    exact hKm.subset (kernelPts_subset_kernelPts_tensorPow k f L 𝓛 m)
  ·
    intro k' _ _ sk
    obtain ⟨i, hi⟩ := exists_σ_ne_zero 𝔓
    obtain ⟨s, hs⟩ := exists_unit_hom_ne_zero_of_section 𝓛 (𝔓.σ i) hi
    have hred := Scheme.Modules.geomFibreH0Finrank_comp_eq f 𝓛 h𝓛 k k' (RingHom.id k) sk
    rw [RingHom.comp_id] at hred
    rw [hred]
    exact geomFibreH0Finrank_id_pos k f hA 𝓛 h𝓛 s hs

