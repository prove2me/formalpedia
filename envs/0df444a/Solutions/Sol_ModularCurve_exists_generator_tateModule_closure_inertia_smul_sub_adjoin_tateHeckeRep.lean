theorem Submodule.exists_mem_forall_exists_pow_smul_eq_of_span_image_eq_span_singleton
    {R K : Type*} [CommRing R] [CommRing K] [Algebra R K] (π : R)
    {T : Type*} [AddCommGroup T] [Module R T]
    (𝒜 : Subalgebra R (Module.End R T)) (T' : Subalgebra K (Module.End K (TensorProduct R K T)))
    (hP : ∀ τ ∈ T', ∃ e : ℕ, ∃ α ∈ 𝒜,
      (algebraMap R K π ^ e) • (τ : Module.End K (TensorProduct R K T)) = (α : Module.End R T).baseChange K)
    (hι : Function.Injective (TensorProduct.mk R K T 1))
    (Λ : Submodule R T) (hΛ : ∀ α ∈ 𝒜, ∀ s ∈ Λ, α s ∈ Λ)
    (g : TensorProduct R K T)
    (hg : Submodule.span T' ((TensorProduct.mk R K T 1) '' (Λ : Set T)) = Submodule.span T' {g}) :
    ∃ s₀ ∈ Λ, ∀ s ∈ Λ, ∃ c : ℕ, ∃ α ∈ 𝒜, (π ^ c) • s = α s₀ := by
  classical
  set ι : T →ₗ[R] TensorProduct R K T := TensorProduct.mk R K T 1 with hιdef
  have hιs : ∀ (r : R) (s : T), ι (r • s) = algebraMap R K r • ι s := fun r s => by
    rw [map_smul, algebraMap_smul]
  have hbc : ∀ (α : Module.End R T) (s : T), (α.baseChange K) (ι s) = ι (α s) := fun α s => rfl

  have stepA : ∀ τ : T', ∀ s ∈ Λ, ∃ e : ℕ, ∃ s₁ ∈ Λ, (algebraMap R K π ^ e) • (τ • ι s) = ι s₁ ∧
      ∃ α ∈ 𝒜, s₁ = α s := by
    intro τ s hs
    obtain ⟨e, α, hα, he⟩ := hP τ τ.2
    refine ⟨e, α s, hΛ α hα s hs, ?_, α, hα, rfl⟩
    change (algebraMap R K π ^ e) • ((τ : Module.End K (TensorProduct R K T)) (ι s)) = ι (α s)
    rw [← LinearMap.smul_apply, he, hbc]

  have stepB : ∀ v ∈ Submodule.span T' (ι '' (Λ : Set T)), ∃ e : ℕ, ∃ s₁ ∈ Λ, (algebraMap R K π ^ e) • v = ι s₁ := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨s, hs, rfl⟩ := hx
      exact ⟨0, s, hs, by rw [pow_zero, one_smul]⟩
    | zero => exact ⟨0, 0, Λ.zero_mem, by rw [smul_zero, map_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨e, s₁, hs₁, h₁⟩ := hx
      obtain ⟨f, s₂, hs₂, h₂⟩ := hy
      refine ⟨e + f, π ^ f • s₁ + π ^ e • s₂, Λ.add_mem (Λ.smul_mem _ hs₁) (Λ.smul_mem _ hs₂), ?_⟩
      rw [smul_add, map_add, hιs, hιs, map_pow, map_pow, ← h₁, ← h₂, smul_smul, smul_smul, ← pow_add, ← pow_add,
        add_comm f e]
    | smul τ x _ hx =>
      obtain ⟨e, s₁, hs₁, h₁⟩ := hx
      obtain ⟨f, s₂, hs₂, h₂, -⟩ := stepA τ s₁ hs₁
      refine ⟨f + e, s₂, hs₂, ?_⟩
      rw [pow_add, mul_smul, ← h₂, ← h₁]

      congr 1
      exact (LinearMap.map_smul (τ : Module.End K (TensorProduct R K T)) _ x).symm

  have hgmem : g ∈ Submodule.span T' (ι '' (Λ : Set T)) := by
    rw [hg]; exact Submodule.mem_span_singleton_self g
  obtain ⟨d, s₀, hs₀, hd⟩ := stepB g hgmem
  refine ⟨s₀, hs₀, fun s hs => ?_⟩

  have hsmem : ι s ∈ Submodule.span T' {g} := by
    rw [← hg]; exact Submodule.subset_span ⟨s, hs, rfl⟩
  obtain ⟨τ, hτ⟩ := Submodule.mem_span_singleton.mp hsmem
  obtain ⟨e, α, hα, he⟩ := hP τ τ.2
  refine ⟨e + d, α, hα, hι ?_⟩
  change ι ((π ^ (e + d)) • s) = ι (α s₀)
  rw [hιs, map_pow, add_comm, pow_add, mul_smul, ← hτ]
  change (algebraMap R K π ^ d) • (((algebraMap R K π ^ e) • (τ : Module.End K (TensorProduct R K T))) g) = _
  rw [he, ← LinearMap.map_smul, hd, hbc]

