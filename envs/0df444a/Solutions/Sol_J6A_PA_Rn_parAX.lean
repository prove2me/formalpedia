/-- **The square-root loop.** -/
theorem Rn.sqL {v : Vr} {c : Cs} (hc : c cL = []) (hv : BV W v) {p : ℕ} (hv5 : v 5 = p)
    (hv20 : v 20 = 0) (hv21 : v 21 = 0) (hpW : p < 2 ^ W) :
