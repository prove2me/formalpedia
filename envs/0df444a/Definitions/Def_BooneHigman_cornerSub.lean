-- title:
--   The subgroup of root words with coefficients in a two-sided ring corner ERE
-- statement:
--   For $E \in R$, the subgroup $\mathrm{cornerSub}(E) \le \mathrm{St}_n(R)$ generated by the roots $x_{ij}(a)$ ($i \ne j$ arbitrary) whose coefficient $a$ lies in the two-sided corner $ERE = \{EsE : s \in R\}$.
--
--   This is the preprint's phrase "a root word whose coefficients lie in $ERE$" (Lemma 4.3, p. 11), made precise as the subgroup generated by such single-coefficient roots.
-- source:
--   OpenAI, *Finite algebraic envelopes and the Boone-Higman conjecture*, OpenAI Math Release preprint, September 23, 2026, https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Finite-algebraic-envelopes-and-the-Boone-Higman-conjecture-September-23-2026/paper.pdf, Lemma 4.3, p. 11.

import Mathlib
import Definitions.Def_BooneHigman_Steinberg

namespace OAI
namespace FiniteAlgebraicEnvelopes

universe u

variable {n : ℕ} {R : Type u} [Ring R]

/-- The subgroup of `St_n(R)` generated by roots `x_ij(a)` with `a` in the two-sided corner
`E·R·E`: "root words whose coefficients lie in `ERE`" (Lemma 4.3, p. 11). -/
noncomputable def cornerSub (E : R) : Subgroup (SteinbergGroup n R) :=
  Subgroup.closure
    {w | ∃ (i j : Fin n) (hij : i ≠ j) (s : R), w = SteinbergGroup.x i j hij (E * s * E)}

end FiniteAlgebraicEnvelopes
end OAI


