    simp only [swSh, encode, vol_cons, vol_nil, mul_one, List.headD_cons, List.tail_cons, e2]
    generalize k / 2 ^ (Q + 1) = d0 at *
    generalize k / 2 ^ Q % 2 = d1 at *
    generalize k / (2 * 2 ^ P) % 2 ^ (Q - P - 1) = d2 at *
    generalize k / 2 ^ P % 2 = d3 at *
    generalize k % 2 ^ P = r at *
    generalize 2 ^ (Q - P - 1) = B at *
    generalize 2 ^ P = a at *
