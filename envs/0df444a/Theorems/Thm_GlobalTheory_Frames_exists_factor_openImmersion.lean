theorem GlobalTheory.Frames.exists_factor_openImmersion {X : Scheme.{0}} {R S : Type} [CommRing R] [CommRing S] (j : Sp R ⟶ X)
    [IsOpenImmersion j] (x : Sp S ⟶ X) (p : Sp S) (hp : x p ∈ Set.range j) :
    ∃ g : S, g ∉ p.asIdeal ∧ ∀ (T : Type) [CommRing T] (lam : S →+* T), IsUnit (lam g) →
      ∃ ψ : R →+* T, spMap lam ≫ x = spMap ψ ≫ j := by sorry
