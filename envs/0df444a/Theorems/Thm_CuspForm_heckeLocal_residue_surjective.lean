theorem CuspForm.heckeLocal.residue_surjective (N : ℕ) [NeZero N] (S : Set ℕ) (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪] [IsAdicComplete (IsLocalRing.maximalIdeal 𝒪) 𝒪] (θ : ↥(CuspForm.heckeAlgebra N 2 S) →+* IsLocalRing.ResidueField 𝒪) [Fact (CuspForm.HasIntegralStructure N 2)] : Function.Surjective (IsLocalRing.residue (CuspForm.heckeLocal N S 𝒪 θ) ∘ algebraMap 𝒪 (CuspForm.heckeLocal N S 𝒪 θ)) := by sorry
