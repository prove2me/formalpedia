/-- **The native set-up program.** -/
def natUp (pkA pkC bA bC : ℕ) (Zn : Fin HS) (oN : Fin 19 → Fin HS) : RS :=
  .seq (mvK Zn 54 cM (.lit 8)) (.seq (mvK 54 31 cM (.lit 8)) (.seq (coreUp pkA pkC bA bC)
    (.seq (mvK 43 41 cM (.reg 42)) (.seq (distAll oN)
    (.seq (mvK 31 54 cM (.lit 8)) (mvK 54 Zn cM (.lit 8)))))))

/-- The cost of a move of `n` entries. -/
def cMvA (e : Ex HS) (B n : ℕ) : ℕ := (e.size + 1) * 2000 * (B + 2) + n * (14000 * (B + 2)) + 32

def cNat (W p t α pkA pkC bA bC B n : ℕ) : ℕ :=
  cMvA (.lit 8) B 8 + (cMvA (.lit 8) B 8 + (cCore W p t α pkA pkC bA bC +
    (cMvA (.reg 42) B n + (cDistAll B n + (cMvA (.lit 8) B 8 + cMvA (.lit 8) B 8)))))

end J6Seg.ATab

end

