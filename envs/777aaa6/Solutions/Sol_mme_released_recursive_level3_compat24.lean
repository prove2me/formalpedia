      ∑ c : Split (2 * 2 ^ (2 - 1)) (parent3 1 rr),
        if ¬ ((c.val 2).val = 0) ∧ (c.val 1).val = jj.val then mu3 1 1 ⟨rr, c⟩ w else 0 := by
