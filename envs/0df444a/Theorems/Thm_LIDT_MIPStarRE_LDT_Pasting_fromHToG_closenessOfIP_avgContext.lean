        _root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 (fun q => ∑ a : OutcomeA, ∑ b : OutcomeB, _root_.LIDT.MIPStarRE.LDT.ev ψ (C q a b * B q a))| ≤
