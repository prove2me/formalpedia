      (∀ i j, ∃ C, ∀ θ, ‖iteratedDeriv j (c i) θ‖ ≤ C) ∧
      ∀ θ x, φ (x * ρ θ) = ∑ i, c i θ * φ (x * kv i) := by
  haveI := finiteDimensional_V K φ hfin
  obtain ⟨n, kv, b, hb⟩ := exists_basis_of_translates K φ
  refine ⟨n, fun i => (kv i : G), coef K φ ρ hρK b, fun i => (kv i).2,
    contDiff_coef K φ ρ hρK b hφ hρ0 hρadd hρc, coef_periodic K φ ρ hρK b hper,
    norm_iteratedDeriv_coef_le K φ ρ hρK b hφ hρ0 hρadd hρc hp hper, ?_⟩
  intro θ x
  exact expansion K φ ρ hρK b kv hb θ x

end M4aP3B.SpanRep
