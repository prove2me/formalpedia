theorem τ50_le_one : τ50 ≤ 1 := by
  unfold τ50; have : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ 50 := by positivity
  linarith

/-- **The Lemma 13 cost in the `RowHyp` form.** -/
theorem ceil_bnd_le_sol_aux {Kc : ℝ} (hKc : 0 < Kc) {K f n r Z : ℕ} (hK : 1 ≤ K) (hf : 1 ≤ f)
    (hfZ : f ≤ Z) (hKZ : 80 * Z * (Z + 2) ≤ 2 ^ K) (hn : 1 ≤ n)
    (hZ : zsz ((16 * (n * r) : ℕ) : ℤ) ≤ Z) (w : ℕ) :
    (⌈bnd Kc K f n r w⌉₊ : ℝ) ≤ (Kc * (K + 2) + 1) * n *
      ((r : ℝ) * (w + 1) * ((f : ℝ) + 1) ^ τ50 + (PsiR r Z w : ℝ)) := by
  have hZw : zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) ≤ Z + zsz ((w : ℤ) + 1) := by
    have h1 := zsz_mul_le (2 * ((n * r : ℕ) : ℤ)) ((w : ℤ) + 1)
    have h2 : zsz (2 * ((n * r : ℕ) : ℤ)) ≤ Z := le_trans (zsz_mono (by
      rw [show (2 : ℤ) * ((n * r : ℕ) : ℤ) = ((2 * (n * r) : ℕ) : ℤ) by push_cast; ring,
        Int.natAbs_natCast, Int.natAbs_natCast]; omega)) hZ
    omega
  have hτ0 := τ50_nonneg
  have hτ1 := τ50_le_one
  have hZwR : (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) ≤ Z + zsz ((w : ℤ) + 1) := by
    exact_mod_cast hZw
  have hZw0 : (0 : ℝ) ≤ zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) := Nat.cast_nonneg _
  -- the floor in `PsiR`
  set D := r * (w + 1) * zsz ((w : ℤ) + 1) / (Z + 2) with hD
  have hdiv : ((r * (w + 1) * zsz ((w : ℤ) + 1) : ℕ) : ℝ) / ((Z : ℝ) + 2) ≤ D + 1 := by
    have h1 := Nat.div_add_mod (r * (w + 1) * zsz ((w : ℤ) + 1)) (Z + 2)
    have h2 := Nat.mod_lt (r * (w + 1) * zsz ((w : ℤ) + 1)) (show 0 < Z + 2 by omega)
    have h3 : r * (w + 1) * zsz ((w : ℤ) + 1) ≤ (Z + 2) * (D + 1) := by rw [hD]; nlinarith
    rw [div_le_iff₀ (by positivity)]
    have : ((r * (w + 1) * zsz ((w : ℤ) + 1) : ℕ) : ℝ) ≤ ((Z + 2) * (D + 1) : ℕ) := by
      exact_mod_cast h3
    push_cast at this ⊢; linarith
  have hPsi : (PsiR r Z w : ℝ) = 2 * ((Z : ℝ) + zsz ((w : ℤ) + 1) + 2) ^ 3 + D + 2 := by
    unfold PsiR; rw [← hD]; push_cast; ring
  rw [hPsi]
  unfold bnd
  rw [show (1 - (2 : ℝ)⁻¹ ^ 50) = τ50 from rfl]
  generalize (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) = Zw at hZwR hZw0 ⊢
  push_cast at hdiv ⊢
  generalize hzw : (zsz ((w : ℤ) + 1) : ℝ) = zw at hdiv hZwR ⊢
  have hzw0 : 0 ≤ zw := by rw [← hzw]; exact Nat.cast_nonneg _
  -- the guard factor
  set δ := min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) with hδd
  have hf' : (1 : ℝ) ≤ f := by exact_mod_cast hf
  have hfZ' : (f : ℝ) ≤ Z := by exact_mod_cast hfZ
  have h2K : (80 * Z * (Z + 2) : ℝ) ≤ 2 ^ K := by exact_mod_cast hKZ
  have hf1 : (0 : ℝ) ≤ (f : ℝ) - 1 := by linarith
  have hδ0 : 0 ≤ δ := le_min zero_le_one (by positivity)
  have hδ1 : δ ≤ 1 := min_le_left _ _
  have hδZ : δ * ((Z : ℝ) + 2) ≤ 1 := by
    have h1 : δ ≤ 80 * ((f : ℝ) - 1) * 2⁻¹ ^ K := min_le_right _ _
    have h2 : (2 : ℝ)⁻¹ ^ K * 2 ^ K = 1 := by rw [← mul_pow]; norm_num
    have h3 : (0 : ℝ) ≤ 2⁻¹ ^ K := by positivity
    have h4 : 80 * ((f : ℝ) - 1) * ((Z : ℝ) + 2) ≤ 2 ^ K := by nlinarith
    calc δ * ((Z : ℝ) + 2) ≤ 80 * ((f : ℝ) - 1) * 2⁻¹ ^ K * ((Z : ℝ) + 2) :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = 2⁻¹ ^ K * (80 * ((f : ℝ) - 1) * ((Z : ℝ) + 2)) := by ring
      _ ≤ 2⁻¹ ^ K * 2 ^ K := mul_le_mul_of_nonneg_left h4 h3
      _ = 1 := h2
  clear_value δ
  -- the sublinear factor
  set F := ((f : ℝ) + 1) ^ τ50 with hF
  have hF1 : 1 ≤ F := Real.one_le_rpow (by linarith) hτ0
  have hX1 : ((f : ℝ) * K) ^ τ50 + 1 ≤ (K + 1) * F := by
    have hK' : (1 : ℝ) ≤ K := by exact_mod_cast hK
    rw [Real.mul_rpow (by positivity) (by positivity)]
    have a1 : (f : ℝ) ^ τ50 ≤ F := Real.rpow_le_rpow (by positivity) (by linarith) hτ0
    have a2 : (K : ℝ) ^ τ50 ≤ K := by
      calc (K : ℝ) ^ τ50 ≤ (K : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hK' hτ1
        _ = K := Real.rpow_one _
    have a3 : (0 : ℝ) ≤ (f : ℝ) ^ τ50 := by positivity
    have a4 : (0 : ℝ) ≤ (K : ℝ) ^ τ50 := by positivity
    nlinarith
  clear_value F
  -- the main estimate, per record
  set y : ℝ := (r : ℝ) * ((w : ℝ) + 1) with hy
  have hy0 : 0 ≤ y := by positivity
  clear_value y
  set A : ℝ := Zw + 1 with hA
  have hA1 : 1 ≤ A := by linarith
  clear_value A
  have hAZ : A ≤ (Z : ℝ) + zw + 2 := by linarith
  have hA3 : A ^ 3 ≤ ((Z : ℝ) + zw + 2) ^ 3 := pow_le_pow_left₀ (by linarith) hAZ 3
  have hA2 : A ^ 2 ≤ A ^ 3 := pow_le_pow_right₀ hA1 (by norm_num)
  have hδ' : δ * zw * y ≤ zw * y / ((Z : ℝ) + 2) := by
    rw [le_div_iff₀ (by positivity)]
    have : 0 ≤ zw * y := by positivity
    calc δ * zw * y * ((Z : ℝ) + 2) = (δ * ((Z : ℝ) + 2)) * (zw * y) := by ring
      _ ≤ 1 * (zw * y) := mul_le_mul_of_nonneg_right hδZ this
      _ = zw * y := one_mul _
  have hA0 : 0 ≤ A := by linarith
  have hδA : δ * A * (y + A) ≤ y + zw * y / ((Z : ℝ) + 2) + A ^ 3 := by
    have b1 : δ * A * y ≤ δ * ((Z : ℝ) + 2) * y + δ * zw * y := by
      have : δ * A ≤ δ * ((Z : ℝ) + 2 + zw) := mul_le_mul_of_nonneg_left (by linarith) hδ0
      calc δ * A * y ≤ δ * ((Z : ℝ) + 2 + zw) * y := mul_le_mul_of_nonneg_right this hy0
        _ = δ * ((Z : ℝ) + 2) * y + δ * zw * y := by ring
    have b2 : δ * ((Z : ℝ) + 2) * y ≤ 1 * y := mul_le_mul_of_nonneg_right hδZ hy0
    have b3 : δ * A * A ≤ 1 * A * A :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hδ1 hA0) hA0
    have b4 : δ * A * (y + A) = δ * A * y + δ * A * A := by ring
    have b5 : (1 : ℝ) * A * A = A ^ 2 := by ring
    linarith
  have hdiv' : zw * y / ((Z : ℝ) + 2) ≤ D + 1 := by
    rw [mul_comm]; exact hdiv
  have hinner : y * (((f : ℝ) * K) ^ τ50 + 1) + A ^ 3 + δ * A * (y + A) ≤
      (K + 2) * y * F + (2 * ((Z : ℝ) + zw + 2) ^ 3 + D + 2 - 1) := by
    have c1 : y * (((f : ℝ) * K) ^ τ50 + 1) ≤ y * ((K + 1) * F) := mul_le_mul_of_nonneg_left hX1 hy0
    have c2 : y ≤ y * F := le_mul_of_one_le_right hy0 hF1
    nlinarith
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  rw [show Kc * ((n : ℝ) * r * (w + 1) * (((f : ℝ) * K) ^ τ50 + 1) + n * A ^ 3 +
      δ * n * A * (y + Zw + 1)) = Kc * n * (y * (((f : ℝ) * K) ^ τ50 + 1) + A ^ 3 +
        δ * A * (y + A)) by rw [hy, hA]; ring]
  set Q := y * (((f : ℝ) * K) ^ τ50 + 1) + A ^ 3 + δ * A * (y + A)
  have hQ0 : 0 ≤ Q := by
    have : 0 ≤ ((f : ℝ) * K) ^ τ50 := by positivity
    have : 0 ≤ δ * A * (y + A) := by
      have := mul_nonneg hδ0 (by linarith : (0 : ℝ) ≤ A); positivity
    have : 0 ≤ A ^ 3 := by positivity
    positivity
  have hc := Nat.ceil_lt_add_one (show 0 ≤ Kc * n * Q by positivity)
  have hP : (1 : ℝ) ≤ 2 * ((Z : ℝ) + zw + 2) ^ 3 + D + 2 := by
    have : (0 : ℝ) ≤ 2 * ((Z : ℝ) + zw + 2) ^ 3 := by positivity
    have : (0 : ℝ) ≤ D := Nat.cast_nonneg _
    linarith
  have hKc' : Kc * n * Q ≤ Kc * n * ((K + 2) * y * F + (2 * ((Z : ℝ) + zw + 2) ^ 3 + D + 2 - 1)) :=
    mul_le_mul_of_nonneg_left hinner (by positivity)
  set P := 2 * ((Z : ℝ) + zw + 2) ^ 3 + (D : ℝ) + 2
  clear_value P
  have hyF : 0 ≤ y * F := by positivity
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg _
  have hn0 : (0 : ℝ) ≤ n := by linarith
  have h1 : 0 ≤ (n : ℝ) * (y * F) := mul_nonneg hn0 hyF
  have h2 : 0 ≤ Kc * n * P * (K + 1) := by
    have : 0 ≤ P := by linarith
    positivity
  have h3 : (1 : ℝ) ≤ n * P := one_le_mul_of_one_le_of_one_le hn' hP
  have h4 : 0 ≤ Kc * n := by positivity
  have e1 : (Kc * (K + 2) + 1) * n * (y * F + P) - (Kc * n * ((K + 2) * y * F + (P - 1)) + 1) =
      n * (y * F) + Kc * n * P * (K + 1) + n * P + Kc * n - 1 := by ring
  linarith

