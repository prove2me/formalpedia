theorem pickA_le (A Q N : ℕ) : ∀ k, pickA A Q N k ≤ A + N
  | 0 => by simp [pickA]
  | k + 1 => by
    simp only [pickA]; split_ifs
    · omega
    · exact pickA_le A Q N k

theorem coprime_of_sumT {Q c y : ℕ} (hc : 2 ≤ c)
    (h : ((y : ℤ) * ((Q % c : ℕ) : ℤ)) % (c : ℤ) = 1) : Nat.Coprime Q c := by
  have h' : (((y * (Q % c)) % c : ℕ) : ℤ) = 1 := by push_cast; exact h
  have h2 : (y * (Q % c)) % c = 1 := by exact_mod_cast h'
  have e : (Q * y) % c = (y * (Q % c)) % c := by
    rw [Nat.mul_mod, Nat.mul_mod y, Nat.mod_mod, mul_comm (Q % c)]
  have h3 : (Q * y) % c = 1 % c := by
    rw [e, h2, Nat.mod_eq_of_lt (show 1 < c by omega)]
  exact Nat.coprime_of_mul_modEq_one y h3

theorem sumT_eq (Q c : ℕ) (hc : 2 ≤ c) :
    ∑ y ∈ Icc 1 c, sumT c (Q % c) y = if Nat.Coprime Q c then (muInv Q c : ℤ) else 0 := by
  split_ifs with hcop
  · simp only [sumT]; exact sum_mu Q c hc hcop
  · refine sum_eq_zero fun y _ => ?_
    simp only [sumT]
    rw [if_neg (fun h => hcop (coprime_of_sumT hc h)), mul_zero]

theorem muInv_pos (Q c : ℕ) (hc : 2 ≤ c) (hcop : Nat.Coprime Q c) : 1 ≤ muInv Q c ∧ muInv Q c < c := by
  obtain ⟨h1, h2⟩ := mu_spec Q c (by omega) hcop
  refine ⟨Nat.one_le_iff_ne_zero.2 fun h0 => ?_, h1⟩
  rw [h0, zero_mul, Nat.zero_mod, Nat.mod_eq_of_lt (show 1 < c by omega)] at h2
  exact absurd h2 (by norm_num)

/-- `zsz` from an atom bound. -/
theorem zszA {z : ℤ} {Aa Bb : ℕ} (hAa : 2 ≤ Aa) (hB : Aa ^ 6 < 2 ^ Bb) (h : |z| ≤ (Aa : ℤ)) :
    zsz z ≤ Bb :=
