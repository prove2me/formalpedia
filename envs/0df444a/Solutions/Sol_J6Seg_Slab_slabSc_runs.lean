/-! ## The pass output is the slab pass -/

section out
variable {U : Type*} [Inhabited U]

theorem slabZ_drop_take (xs : List U) (m n k : ℕ) (hk : k < n) (h : U → ℤ) :
    slabZ xs m (some k) h = slabZ (xs.take (n * m)) m (some k) h := by
  simp only [slabZ_some]
  congr 1
  rw [List.drop_take]
  rw [List.take_take]
  congr 1
  have : (k + 1) * m ≤ n * m := Nat.mul_le_mul_right _ hk
  rw [Nat.add_mul, one_mul] at this
  omega

/-- **The pass output is the slab pass.** -/
theorem passOut_eq (m : ℕ) (g : ℤ → U → ℤ) {n n' : ℕ} {src : ℕ → Option ℕ}
    (hs : MonoSrc n n' src) (argOf : ℕ → ℤ) (pre : ℕ) (hnm : 0 < n * m) (xs : List U)
    (hxs : xs.length = pre * (n * m)) :
    passOut m g (ctlOf n n' src argOf) n pre xs =
      slabPass n n' m src (fun l => g (argOf l)) xs := by
  rw [slabPass_blocks n n' m pre hnm src g argOf xs hxs]
  unfold passOut
  apply List.flatMap_congr
  intro i _
  rw [runC_ctlOf m g hs argOf]
  apply List.flatMap_congr
  intro l hl
  rw [List.mem_range] at hl
  cases hsl : src l with
  | none => rfl
  | some k => exact slabZ_drop_take _ m n k (hs.1 l hl k hsl) _

end out

