  inferInstanceAs (DecidableEq (Sigma BaseFiber))

@[instance_reducible] def componentMetric (S : Finset ArithmeticGroup) (t : ℤ_[2]ˣ)
    (j : ℕ) : MetricSpace (FiberVertex j) :=
  graphMetricOrDiscrete (fiberedGraph S t j)

@[instance_reducible] def componentUnionMetric (S : Finset ArithmeticGroup) (t : ℤ_[2]ˣ) :
    MetricSpace ((j : ℕ) × FiberVertex j) := by
  letI := componentMetric S t
  exact separatedMetric fiberBoundaryBase

@[instance_reducible] def vertexUnionMetric (S : Finset ArithmeticGroup) (t : ℤ_[2]ˣ) :
    MetricSpace VertexUnion := by
  letI := componentUnionMetric S t
  exact (Equiv.sigmaAssoc (fun j u => Quotient (discDepth j u))).metricSpace

end CoarseAssembly

