  refine IState.ext' (fun j => ?_) h.2.1 h.2.2
  simp only [ovr_G, IState.upd_G]
  by_cases hj : j = i
  · subst hj; simp [hi]
  · simp only [hj, if_false]
    split_ifs with hg
    · rfl
    · exact h.1 j hg

