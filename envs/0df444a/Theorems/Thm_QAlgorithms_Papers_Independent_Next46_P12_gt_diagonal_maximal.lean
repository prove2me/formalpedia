-- title:
--   Proposition 1.5: diagonal characterization and maximal commutativity
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. For every $a\in A_n$,
--
--   $$a\in X_n\quad\Longleftrightarrow\quad a|_{V_T}\text{ is a scalar for every simple }V^\lambda\text{ and every }T\mapsto\lambda.$$
--
--   Furthermore $X_n$ is commutative, and any commutative subalgebra of $A_n$ containing $X_n$ equals $X_n$.
--
--   Thus the GT algebra is precisely the algebra diagonal on every GT basis and is maximal commutative.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 4, Proposition 1.5: diagonal characterization and maximal commutativity

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 1.5, source PDF pp. 4–5. Diagonality ranges over every simple
module. There is no Hermitian or inner-product requirement. -/
theorem gt_diagonal_maximal (D : Tower k AA) (n : ℕ) :
    (∀ a : AA n, a ∈ towerGTAlgebra D n ↔
      ∀ lam : (D.split n).Label, ∀ t : TowerPathsTo D n lam, ∃ c : k,
        ∀ v ∈ gtLine D lam t.val, simpleAction (D.split n) lam a v = c • v) ∧
    (∀ x y : towerGTAlgebra D n, x * y = y * x) ∧
    (∀ S : Subalgebra k (AA n), towerGTAlgebra D n ≤ S →
      (∀ x y : S, x * y = y * x) → S = towerGTAlgebra D n) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
