-- title:
--   A quantized charge spectrum is closed under composition
-- statement:
--   If every charge in a collection $S$ is an integer multiple of a quantum $q_0$, then so is every charge obtainable from $S$ by addition and negation — that is, the additive subgroup of $\mathbb{R}$ generated by $S$ is contained in $q_0\mathbb{Z}$. This is the algebraic content of the source's observation that although quarks carry charges in multiples of $e/3$, every stable grouping of them carries an integer multiple of that same quantum.
-- source:
--   "Elementary charge", Wikipedia, https://en.wikipedia.org/wiki/Elementary_charge (uploaded PDF revision). Sections: "As a unit"; "Quantization"; "Lack of fractional charges"; "In terms of the Avogadro constant and Faraday constant"; "From the Josephson and von Klitzing constants"; "CODATA method".

import Mathlib
import Definitions.Def_elementary_charge_si_constants

namespace ElementaryCharge

theorem charge_quantization_closure (S : Set ℝ) (q0 : ℝ)
    (hS : ∀ s ∈ S, ∃ n : ℤ, s = n * q0) :
    (AddSubgroup.closure S : Set ℝ) ⊆ (AddSubgroup.zmultiples q0 : Set ℝ) := by sorry

end ElementaryCharge
