  rw [LanglandsTunnell.CubicInduction.ShellToSeries.tsum_shellTerm_eq_inv_eval_inducedEulerPoly hdeg.le
      (hsphW v hv) (χ (AutomorphicForm.uniformizerIdele ℚ v)) s hsumv,
    LanglandsTunnell.CubicInduction.ShellToSeries.seriesVariable_eq_absNorm, hχTdef,
    LanglandsTunnell.CubicInduction.TwistEuler.eval_inducedEulerPoly_twist_of_not_isBadPlace μ χ v
      (fun hb => hvS v hv ((hS v).2 hb)) (hχT v hv)]

private theorem lside
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    {uR : ∀ w : InfinitePlace K, w.IsReal → ℂ} {aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2}
    {uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ} {kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ}
    (D : LDatum (HeightOneSpectrum (𝓞 K))) (hDdef : D = LanglandsTunnell.HeckeTate.heckeDatum K χT uR aR uC kC)
    (hconv : D.Converges) (Λ : ℂ → ℂ)
    (hEul : ∀ s : ℂ, D.abscissa < s.re → Λ s = 1 * D.archFactor s * D.LFun s) :
    ∀ s : ℂ, (1 : ℝ) < s.re →
    HasProd (fun v : HeightOneSpectrum (𝓞 ℚ) =>
      ((inducedEulerPoly ℚ (inducedCoeff K χT) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹) (D.LFun s) ∧
    Λ s = D.archFactor s * D.LFun s := by
  intro s hs
  have hs' : D.abscissa < s.re := by
    rw [hDdef]
    exact hs
  refine ⟨?_, by simpa only [one_mul] using hEul s hs'⟩
  have hfun : (fun 𝔓 : HeightOneSpectrum (𝓞 K) => ((D.euler 𝔓).eval ((D.norm 𝔓 : ℂ) ^ (-s)))⁻¹) =
      fun 𝔓 : HeightOneSpectrum (𝓞 K) =>
        (1 - inducedCoeff K χT 𝔓 * ((Ideal.absNorm 𝔓.asIdeal : ℕ) : ℂ) ^ (-s))⁻¹ := by
    funext 𝔓
    rw [hDdef]
    by_cases h𝔓 : IsUnramifiedCharAt χT 𝔓
    · simp [LanglandsTunnell.HeckeTate.heckeDatum, inducedCoeff, h𝔓]
    · simp [LanglandsTunnell.HeckeTate.heckeDatum, inducedCoeff, h𝔓]
  have hK := EulerHasProd.hasProd_inv_eval_euler_lFun D hconv hs'
  rw [hfun] at hK
  exact RankinSelberg.hasProd_inv_eval_inducedEulerPoly_of_hasProd ℚ K (inducedCoeff K χT) s (D.LFun s) hK

private theorem colS_dual (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (ν : (v : HeightOneSpectrum (𝓞 ℚ)) → Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ))
    (aex : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ)
    (hcond : ∀ v ∈ S, ∀ i, 1 ≤ aex v i ∧ LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i) (aex v i))
    (hL : ∀ v ∈ S, ∀ s : ℂ, (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i) s) =
      ((inducedEulerPoly ℚ (inducedCoeff K μ) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∈ S) {Z P : ℂ → ℂ} {σ₁ : ℝ}
    {c₀ c₁ cε : ℂ} {a : Fin 3 → ℕ}
    (haν : ∀ i, LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i * localChar χ v) (a i))
    (hzd : ∀ s : ℂ, σ₁ < (1 - s).re → Z s =
      c₀ * (c₁ * ((∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i * localChar χ v)⁻¹ (1 - s)) *
        (cε * (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (a i : ℂ)) * (1 / 2 - s))) * P s))) :
    ∀ s : ℂ, σ₁ < (1 - s).re → Z s =
      ((inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) v).eval
          ((Ideal.absNorm v.asIdeal : ℂ) ^ (-(1 - s))))⁻¹ *
        (cε * (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (aex v i : ℂ)) * (1 / 2 - s)) * (c₀ * c₁)) * P s := by
  intro s hs
  have h0 : LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (localChar χ v) 0 :=
    LanglandsTunnell.CubicInduction.NormUnramified.hasConductorExponentAt_zero_of_isUnramifiedCharAt (hχS v hv)

  have haex : ∀ i, LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i * localChar χ v) (aex v i) :=
    fun i => LanglandsTunnell.TateLocal.hasConductorExponentAt_mul_of_hasConductorExponentAt_zero ℚ v (ν v i)
      (localChar χ v) (aex v i) (hcond v hv i).2 h0
  have ha : a = aex v := funext fun i => LanglandsTunnell.TateLocal.hasConductorExponentAt_unique ℚ v (haν i) (haex i)
  subst ha

  have hLinv : (∏ i, LanglandsTunnell.TateLocal.localLFactorAt ℚ v (ν v i * localChar χ v)⁻¹ (1 - s)) = 1 :=
    LanglandsTunnell.CubicInduction.EulerMatch.prod_localLFactorAt_eq_one v (fun i => (ν v i * localChar χ v)⁻¹)
      (aex v) (fun i => ⟨(hcond v hv i).1,
        LanglandsTunnell.CubicInduction.DualEulerMatch.hasConductorExponentAt_inv ℚ v (haν i)⟩) (1 - s)

  have hμv :=
    LanglandsTunnell.CubicInduction.EulerMatch.forall_not_isUnramifiedCharAt_of_prod_localLFactorAt_eq K μ v (ν v)
      (aex v) (hcond v hv) (hL v hv)
  have hχv :=
    LanglandsTunnell.CubicInduction.NormUnramified.forall_mem_primeFibre_isUnramifiedCharAt_comp_idelicNorm K χ v
      (hχS v hv)
  have hone : inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) v = 1 :=
    LanglandsTunnell.CubicInduction.DualEulerMatch.inducedEulerPoly_eq_one_of_forall_eq_zero K _ v fun 𝔓 h𝔓 => by
      rw [LanglandsTunnell.CubicInduction.DualEulerMatch.inducedCoeff_eq_zero_of_not_isUnramifiedCharAt K χT 𝔓
          (fun hun => hμv 𝔓 h𝔓
            (LanglandsTunnell.CubicInduction.EulerMatch.isUnramifiedCharAt_of_mul K (hχTdef ▸ hun) (hχv 𝔓 h𝔓))),
        inv_zero]
  rw [hzd s hs, hLinv, hone, Polynomial.eval_one, inv_one]
  ring

private theorem colN_dual (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K = 3) (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) (hχc : Continuous χ)
    (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) {v : HeightOneSpectrum (𝓞 ℚ)}
    (hbad : ¬ IsBadPlace K μ v) (hωv : IsUnramifiedCharAt ω v) (α : (v.adicCompletion ℚ)ˣ)
    (hα : Valued.v ((α : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1) {n : ℕ}
    (hn : LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (localChar χ v) n) {Z P : ℂ → ℂ} {σ₁ : ℝ}
    (hzd0 : n = 0 → ∀ s : ℂ, σ₁ < (1 - s).re →
      (letI := localBorel ℚ v;
        ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ * Z s =
        ((localChar ω v α : ℂˣ) : ℂ) * (((localChar χ v α : ℂˣ) : ℂ) ^ 3 *
          (((gl3LFactorPoly
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ *
                    (inducedE2 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v))
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ ^ 2 *
                    (inducedE1 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v))
                  ((((localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ))⁻¹ ^ 3 *
                    (inducedE3 ℚ (inducedCoeff K μ) v)⁻¹)).eval
              ((Ideal.absNorm v.asIdeal : ℂ) ^ (-(1 - s))))⁻¹ * P s))))
    (hzd1 : 1 ≤ n → ∀ s : ℂ, σ₁ < (1 - s).re →
      (letI := localBorel ℚ v;
        ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ * Z s =
        ((localChar ω v α : ℂˣ) : ℂ) * (((localChar χ v α : ℂˣ) : ℂ) ^ 3 *
          ((inducedE3 ℚ (inducedCoeff K μ) v ^ n *
                LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (localChar χ v) ^ 3 *
              (Ideal.absNorm v.asIdeal : ℂ) ^ (((3 * n : ℕ) : ℂ) * (1 / 2 - s))) * P s)))) :
    ∀ s : ℂ, σ₁ < (1 - s).re → Z s =
      ((inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) v).eval
          ((Ideal.absNorm v.asIdeal : ℂ) ^ (-(1 - s))))⁻¹ *
        (inducedE3 ℚ (inducedCoeff K μ) v ^ n * LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (localChar χ v) ^ 3 *
            (Ideal.absNorm v.asIdeal : ℂ) ^ ((3 * n : ℂ) * (1 / 2 - s)) *
          ((localChar χ v α : ℂˣ) : ℂ) ^ 3) * P s := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  intro s hs

  have hV := LanglandsTunnell.CubicInduction.DualEulerMatch.selfDualHaarAt_real_adicCompletionIntegers_eq_one ℚ v
    (LanglandsTunnell.TateLocal.addCharLevel_psiLocal_rat v)

