    {c : ℕ} (n : ℕ) {r : IState S × ℕ} (h : IStmt.run iprog n p s = some r) (ht : r.1 = t)
    (hc : r.2 ≤ c) : IRuns I iprog p s t c :=
  ⟨r.2, hc, ht ▸ IStmt.run_exec n p s r.1 r.2 (by rw [h])⟩

