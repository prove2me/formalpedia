theorem NLogN.GL.ftlP_all (fw : LProg2 M Ctx PreW (fermatW q) CW) (hfw : FwOK fw) {m Φm : ℕ}
    (hM : MulBnd M m Φm) (s : IState HS) (hC : Ctx s) (U : List (ℤ × ℤ))
    (R RC LN LT LP : List Item) (T Q : ℕ)
    (hU : s.G gD = gints U ++ R) (hCH : s.G gCH = gints (chirpL q) ++ RC) (hUl : U.length = T)
