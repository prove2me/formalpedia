/-! ## The recursion -/

theorem leafOp_eq (u : ℕ) : leafOp u = tens Cm := by
  rw [leafOp, tens_eq_prod_kerAt Cm (List.finRange u) (List.nodup_finRange u)
    (List.mem_finRange), List.map_map]; rfl

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

/-! ## Pieces on disjoint blocks of selected bits -/

section Blocks

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Embedding the tensor power on a piece gives the block tensor. -/
theorem embed_tens {κ : Type} [Fintype κ] [DecidableEq κ] (S : Finset ι) (e : κ ≃ S) (A : M2) :
    embed S e (tens A) = tensF (blockFam S A) := by
  ext x y
  have h1 : ∀ i ∈ S, blockFam S A i (x i) (y i) = A (x i) (y i) := fun i hi => by
    show (if i ∈ S then A else 1) (x i) (y i) = _
    rw [if_pos hi]
  have h2 : ∀ i ∈ Sᶜ, blockFam S A i (x i) (y i) = if x i = y i then 1 else 0 := fun i hi => by
    rw [Finset.mem_compl] at hi
    show (if i ∈ S then A else 1) (x i) (y i) = _
    rw [if_neg hi, Matrix.one_apply]
  simp only [embed, tens, tensF]
  rw [← Finset.prod_mul_prod_compl S, Finset.prod_congr rfl h1, Finset.prod_congr rfl h2,
    Finset.prod_boole]
  congr 1
  · rw [← Finset.prod_coe_sort S (fun i => A (x i) (y i))]
    exact Fintype.prod_equiv e _ _ (fun j => rfl)
  · simp only [Finset.mem_compl]

end Blocks

