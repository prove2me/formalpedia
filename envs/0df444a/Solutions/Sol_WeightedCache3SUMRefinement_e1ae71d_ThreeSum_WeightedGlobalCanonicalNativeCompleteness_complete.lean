    (native true maps) wordCode mapCode p (4^(fixedLength m)) F
  have hwordL : Radix.positionalHash ((4^(fixedLength m) : ℕ) : ℤ) wordCode
      (List.ofFn fun i => leftRecord (occ i) (e i))=
