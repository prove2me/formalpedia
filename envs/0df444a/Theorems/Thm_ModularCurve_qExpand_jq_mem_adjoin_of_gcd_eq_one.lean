-- title:
--   Generation of ℚ(j(qᵈ):d∣ M) by a coprime divisor family
-- statement:
--   Let $M$ be a nonzero natural number and let $S$ be a finite set of natural numbers such that every $s \in S$ divides $M$, such that $M \in S$, and such that the greatest common divisor of the elements of $S$ (formed with `Finset.gcd id`) equals $1$. Let $d$ be a nonzero natural number dividing $M$. Here [`ModularCurve.jq`](def/ModularCurve_X0.html#L157) is the Laurent series over $\mathbb{Q}$ obtained by multiplying the monomial $q^{-1}$ by the power series `jNumQ`, the image under $\mathbb{Z} \to \mathbb{Q}$ of the integral power series `jNum`; thus `jq` is the $q$-expansion $j(q) = q^{-1} + 744 + 196884q + \cdots$. For a nonzero $N$, [`ModularCurve.qExpand ℚ N`](def/ModularCurve_X0.html#L25) is the ring homomorphism of $\mathbb{Q}((q))$ given by the domain embedding along multiplication by $N$ on the exponent group $\mathbb{Z}$, i.e. the substitution $q \mapsto q^{N}$. The assertion is that $j(q^{d}) =$ `qExpand ℚ d jq` belongs to the intermediate field of $\mathbb{Q}((q))$ generated over $\mathbb{Q}$ by the set of those Laurent series of the form `qExpand ℚ s jq` for some nonzero $s \in S$; that is, $j(q^{d}) \in \mathbb{Q}\bigl(j(q^{s}) : s \in S\bigr)$.
--
--   This is the statement that the function field $\mathbb{Q}(j(q^{d}) : d \mid M)$ of all divisor-level $q$-expansions of the modular invariant is already generated by the subfamily indexed by $S$, the two hypotheses $M \in S$ and $\gcd S = 1$ being exactly what is needed (compare the classical description of $\mathbb{C}(X_0(N)) = \mathbb{C}(j, j_N)$ and the Galois correspondence for the level-$M$ modular function field). It is used in the proof of [`ModularCurve.degeneracyPushforwardPair_heckeOperatorBar_of_not_dvd`](thm.html#ModularCurve.degeneracyPushforwardPair_heckeOperatorBar_of_not_dvd), where it supplies the generation hypothesis for a compositum of two degeneracy-map images inside a modular function field.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_qExpand_jq_mem_adjoin_of_gcd_eq_one.lean

import Mathlib
import Definitions.Def_ModularCurve_X0

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

theorem ModularCurve.qExpand_jq_mem_adjoin_of_gcd_eq_one (M : ℕ) [NeZero M] (S : Finset ℕ)
    (hSM : ∀ s ∈ S, s ∣ M) (hM : M ∈ S) (hgcd : S.gcd id = 1) (d : ℕ) [NeZero d] (hd : d ∣ M) :
    ModularCurve.qExpand ℚ d ModularCurve.jq ∈ IntermediateField.adjoin ℚ
      {x : LaurentSeries ℚ | ∃ (s : ℕ) (_ : NeZero s), s ∈ S ∧ x = ModularCurve.qExpand ℚ s ModularCurve.jq} := by sorry
