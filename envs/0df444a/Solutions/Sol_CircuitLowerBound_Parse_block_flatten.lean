open CircuitLowerBound
open ENP Groundwork
open CircuitLowerBound.Parse
namespace CircuitLowerBound.Parse
theorem _root_.solution {ℓ : ℕ} : ∀ (L : List (List Bool)) (j : ℕ) (hj : j < L.length), (∀ w ∈ L, w.length = ℓ) → block ℓ j L.flatten = L[j]
  | [], j, hj, _ => by simp at hj
  | a :: L, 0, _, h => by
    have ha : a.length = ℓ := h a List.mem_cons_self
    simp [block, ha]
  | a :: L, j + 1, hj, h => by
    have ha : a.length = ℓ := h a List.mem_cons_self
    have ih := solution L j (by simpa using hj) fun w hw => h w (List.mem_cons_of_mem _ hw)
    have e : (j + 1) * ℓ = a.length + j * ℓ := by rw [ha]; ring
    unfold block at ih ⊢
    rw [List.flatten_cons, e, ← List.drop_drop, List.drop_left, ih]
    simp
end CircuitLowerBound.Parse
