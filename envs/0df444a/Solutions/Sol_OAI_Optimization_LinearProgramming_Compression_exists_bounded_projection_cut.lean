/-- Every nonnegative multiplier annihilating the hidden columns is valid on their projection. -/
theorem projected_inequality_of_witness (H : Matrix ι ν K) (r : ι → K) (y : ν → K)
    (hy : H *ᵥ y ≤ r) (w : ι → K) (hw : 0 ≤ w) (hH : Hᵀ *ᵥ w = 0) :
