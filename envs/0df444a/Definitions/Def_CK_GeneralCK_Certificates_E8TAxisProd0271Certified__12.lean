  rcases h with ⟨hsl, hsu, htl, htu⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · obtain ⟨a, ha, hpos, hy⟩ := E8TAxisProd0271EndpointWitnesses.wholeA_covers_slope
      (s := t) ⟨htl, htu⟩
