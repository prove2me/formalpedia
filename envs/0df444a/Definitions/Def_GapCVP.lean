      Nat.le_of_not_gt hnot
    have hbound : target ≤ current ^ a :=
      (finitePCeilingRoot_spec a target ha).trans
        (Nat.pow_le_pow_left hroot a)
    exact (Nat.not_le_of_gt hpower) hbound
