variable {I J : Type} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]

/-- PDF p.14, Remark 2: the proof's computed expectation/isomorphism recovery
and its state-dual adjoint give CPTP maps with the two simultaneous identities. -/
theorem remark2 [Nonempty I] [Nonempty J] (A : Alg I) (B : Alg J) (T : MatrixMap I J)
    (S : Set (Mat I)) (rho : Mat I) (h : Conditions A B T S rho)
    (hrev : FamilyReversible A B T S) :
    let C : Set (Mat I) := recoveryAlgebra rho S
    let D := algebraMultiplicativeDomain B (channelAdjoint T)
    let E := traceConditionalExpectation A C
    let F := traceConditionalExpectation B D
    let R := inverseRestriction (channelAdjoint T) D (channelAdjoint T '' D)
    ConditionalExpectation A C E ∧ ConditionalExpectation B D F ∧
    ConditionalExpectation A C (Classical.epsilon (fun U : MatrixMap I I =>
      ∀ a, U a = stateDual E rho a)) ∧
    StarIsoOn D (channelAdjoint T '' D) (channelAdjoint T) R ∧
    ∃ Snew : MatrixMap J I, ∃ Tnew : MatrixMap I J,
      AlgebraChannel B A Snew ∧ AlgebraChannel A B Tnew ∧
      (∀ b ∈ B, Snew b = structuralRecovery A B T S rho b) ∧
      (∀ a ∈ A, Tnew a = petz (T rho) Snew a) ∧
      (∀ sigma ∈ S, Tnew sigma = T sigma ∧ Snew (T sigma) = sigma) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P31

