def verificationWindow (q : ℕ) [NeZero q] : Finset (ZMod q) :=
  (Finset.range (q / 4 + 1)).image (fun n : ℕ => (n : ZMod q)) ∪
    (Finset.Ico (q - q / 4) q).image (fun n : ℕ => (n : ZMod q))
def verificationResidual {q N : ℕ} (a secret candidate : Fin N → ZMod q) (error : ZMod q) : ZMod q :=
  (a ⬝ᵥ secret + error) - a ⬝ᵥ candidate
noncomputable def candidateVerificationProbability {q N : ℕ} [NeZero q]
    (m : ℕ) (secret candidate : Fin N → ZMod q) (χ : ZMod q → ℝ) : ℝ :=
  ∑ error : Fin m → ZMod q, (∏ i, χ (error i)) *
    _root_.InfoLossLAR.WorstCase.avg (fun rows : Fin m → Fin N → ZMod q =>
      ∏ i, if _root_.InfoLossLAR.WorstCase.verificationResidual (rows i) secret candidate (error i) ∈ _root_.InfoLossLAR.WorstCase.verificationWindow q
        then (1 : ℝ) else 0)
end InfoLossLAR.WorstCase
