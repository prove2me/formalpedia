    a + (b + (M * (cZ Bb + 30) + 30) + (d1 + d2)) + (13 * (2 * Bb + 2) + 1) ≤ cHd Bb := by
  unfold cHd cZ
  have h1 : M * (2 * (4 * 10 ^ 7 * (Bb + 2) ^ 2) + 30) ≤ (Bb + 2) * (2 * (4 * 10 ^ 7 * (Bb + 2) ^ 2) + 30) :=
