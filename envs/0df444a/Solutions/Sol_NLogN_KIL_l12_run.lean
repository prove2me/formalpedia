  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_pull] at h₁
  have hv := hg' _ (valid_decode h₁)
  have hlt := encode_lt hv
  rw [getElem_pull, getElem_pull, List.getD_eq_getElem _ _ (by simpa using hlt), getElem_pull,
