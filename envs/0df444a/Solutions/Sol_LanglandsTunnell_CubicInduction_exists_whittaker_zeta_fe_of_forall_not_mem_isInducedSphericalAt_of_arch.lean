namespace NormPowCharAdmissible
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open MeasureTheory NumberField NumberField.TateGlobal

variable (F : Type) [Field F] [NumberField F]

private theorem ideleNorm_principal (q : Fˣ) :
    ideleNorm F (Units.map (algebraMap F (AdeleRing (𝓞 F) F)) q) = 1 := by

  letI : MeasurableSpace (AdeleRing (𝓞 F) F) := borel _
  haveI : BorelSpace (AdeleRing (𝓞 F) F) := ⟨rfl⟩
  have h := NumberField.AdeleRing.distribHaarChar_algebraMap F q

  have hq : Units.map (algebraMap F (AdeleRing (𝓞 F) F)).toMonoidHom q =
      Units.map (algebraMap F (AdeleRing (𝓞 F) F)) q := Units.ext rfl
  rw [hq] at h
  unfold ideleNorm
  rw [h, NNReal.coe_one]

private theorem isIdeleClassChar_normPowChar (t : ℝ) :
    AutomorphicForm.IsIdeleClassChar (𝓞 F) F (normPowChar F t) := fun q =>
  normPowChar_eq_one_of_ideleNorm_eq_one t (ideleNorm_principal F q)

private theorem isAdmissibleTwist_normPowChar (t : ℝ) : Converse.IsAdmissibleTwist F (normPowChar F t) :=
  ⟨isIdeleClassChar_normPowChar F t, NormPowCharLegs.continuous_normPowChar F t,
    NormPowCharLegs.isUnitaryChar_normPowChar F t⟩

end LanglandsTunnell.CubicInduction.NormPowCharAdmissible
