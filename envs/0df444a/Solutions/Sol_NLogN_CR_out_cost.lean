    have := pushCost_le_lin e s B hl hb
    simp only [RS.cost, lsz]; nlinarith
  | .pop i, s, h => by
    simp only [LinB] at h
    simp only [RS.cost, lsz]; nlinarith
  | .seq a b, s, ⟨ha, hb⟩ => by
