  | nil => simp at h; subst h; rfl
  | cons q sh ih =>
    simp only [vol_cons] at h
    have hV : 0 < vol sh := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    have hq : m / vol sh < q := (Nat.div_lt_iff_lt_mul hV).2 h
