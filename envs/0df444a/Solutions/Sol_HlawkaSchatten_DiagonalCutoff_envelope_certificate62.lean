theorem envelope_identity (x : ℝ) : cutoff65Nlo x*(2*cutoff65Glo x)-(1-3643/10000)*cutoff65Dup x = envelopeBernstein x := by
  dsimp [cutoff65Nlo, cutoff65Dup, cutoff65Glo, envelopeBernstein]
  ring

theorem envelope_certificate {x : ℝ} (hlo : 1/63 ≤ x) (hhi : x ≤ 1/62) :
    0 < cutoff65Nlo x*(2*cutoff65Glo x)-(1-3643/10000)*cutoff65Dup x := by
  rw [envelope_identity]
  unfold envelopeBernstein
  by_cases ht : x < 1/62
  · have hl : 0 ≤ x-1/63 := by linarith
    have hr : 0 < 1/62-x := by linarith
    positivity
  · have he : x = 1/62 := by linarith
    rw [he]
    norm_num

theorem solution (x : ℝ) (hlo : 1 / 63 ≤ x) (hhi : x ≤ 1 / 62) :
    0 < cutoff65Nlo x * (2 * cutoff65Glo x) - (1 - 3643 / 10000) * cutoff65Dup x :=
  envelope_certificate hlo hhi
