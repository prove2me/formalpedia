theorem sgnStep_runs (s : IState HS) (z : ℤ) (LW : List Item) (hW : s.G cW = .int z :: LW) :
    IRuns I iprog sgnStep s
      ((s.upd cW (.int (z.natAbs : ℤ) :: LW)).upd cO (.int (sgnB z) :: s.G cO)) 48 := by
  unfold sgnStep
  by_cases hz : z < 0
  · have hc : isNg (s.cl cW) = true := by
      rw [cl_int s cW z LW hW]; simp [isNg, hz, show z ≠ 0 by omega]
    have h1 := IRuns.neg (I := I) (iprog := iprog) hW
    have h2 := IRuns.const (I := I) (iprog := iprog) (s := s.upd cW (.int (-z) :: LW)) cO 1
    refine (IRuns.iteT hc (h1.seq h2)).mono' ?_ (by simp [zsz_one])
    have : (-z) = (z.natAbs : ℤ) := by omega
    rw [this]; clear this; simp only [sgnB, if_pos hz]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  · have hc : isNg (s.cl cW) = false := by
      rw [cl_int s cW z LW hW]; simp only [isNg, hz, if_false]; split_ifs <;> decide
    have h2 := IRuns.const (I := I) (iprog := iprog) (s := s) cO 0
    refine (IRuns.iteF hc h2).mono' ?_ (by simp [zsz_zero])
    have : z = (z.natAbs : ℤ) := by omega
    simp only [sgnB, if_neg hz]
    rw [← this]; clear this; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))

theorem body1_runs (s : IState HS) (z : ℤ) (w : ℕ) (hz : zsz z ≤ w) (L0 L2 LC LD : List Item)
    (h0 : s.G 0 = .int z :: L0) (h2 : s.G cR2 = .int 2 :: L2)
    (hC : s.G cCw = marks w ++ LC) (hD : s.G cDw = LD) (hLC : NM LC) (hLD : NM LD) :
    IRuns I iprog body1 s ((s.upd 0 L0).upd cO (ints (encW w z).reverse ++ s.G cO)) (cBody1 w) := by
  have h1 := IRuns.mv (I := I) (iprog := iprog) (i := 0) (j := cW) (by decide) h0
  set s1 := (s.upd 0 L0).upd cW (.int z :: s.G cW)
  have h2' := sgnStep_runs (I := I) (iprog := iprog) s1 z (s.G cW) (by simp +decide [s1])
  set s2 := (s1.upd cW (.int (z.natAbs : ℤ) :: s.G cW)).upd cO (.int (sgnB z) :: s1.G cO)
  have h3 := peel_runs (I := I) (iprog := iprog) s2 z.natAbs w (s.G cW) L2 LC LD
    (by simp +decide [s2]) (by simp +decide [s2, s1, h2]) (by simp +decide [s2, s1, hC])
    (by simp +decide [s2, s1, hD]) hLC hLD
  have hlt : z.natAbs / 2 ^ w = 0 := Nat.div_eq_of_lt (zsz_le_iff.1 hz)
  rw [hlt] at h3
  set s3 := (s2.upd cW (.int ((0 : ℕ) : ℤ) :: s.G cW)).upd cO
    (ints ((List.range w).map (bitN z.natAbs)).reverse ++ s2.G cO)
  have h4 := IRuns.drop (I := I) (iprog := iprog) (s := s3) (i := cW) (a := ((0 : ℕ) : ℤ))
    (L := s.G cW) (by simp +decide [s3])
  refine (h1.seq (h2'.seq (h3.seq h4))).mono' ?_ ?_
  · clear h1 h2' h3 h4
    have e : ints (encW w z).reverse =
        ints ((List.range w).map (bitN z.natAbs)).reverse ++ [.int (sgnB z)] := by
      simp [encW, ints]
