theorem chunkL_length {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n) :
    (chunkL n L).length = m := by
  rw [chunkL_eq n m L hn hL]; simp

theorem chunkL_mem {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n)
