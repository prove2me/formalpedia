    (hc : w.G cL = .int ((q.K : ℤ) - k) :: LC) :
    PushOK Bx w sPush (sVals q kb k) ∧
      EA w Bx (.mul (NLogN.EX.mE xM xS) NLogN.EX.tE) ((NS q (k + 1) : ℕ) : ℤ) := by
  obtain ⟨F1, F2, F3, F4, F5, F6, F7, F8, F9⟩ := Gx_facts q kb
  have GV := G_le_V q kb
  obtain ⟨hG1, hG2, hG3⟩ := G3 (Gx q kb) F9
  set G := Gx q kb
  set V := Vx q kb
  have zb := zbV hBx
  have htT := tK_le_T q k hk
  have hsT := hst k hk
  have hNT := NS_le q hsl hst k
  have hN1T := NS_le q hsl hst (k + 1)
  have hNe := NS_eq q hsl k hk
  have hN1 := NS_succ q k hk
  have hmN : mS q k ≤ NS q k := by rw [hNe]; exact Nat.le_mul_of_pos_left _ hs0
  have hw : sWidth q.p q.α ≤ G := F5
  have hG2V : G * G * 4 ≤ V := by nlinarith
  have hG3V : G * G * G * 4 ≤ V := by
    have : G ^ 3 = G * G * G := by ring
    rw [← this]; omega
  obtain ⟨Lp, hp⟩ := hg.p
  obtain ⟨La, ha⟩ := hg.a2
  obtain ⟨Lw, hww⟩ := hg.w
  obtain ⟨Lw1, hw1⟩ := hg.w1
  obtain ⟨Lb, hb⟩ := hg.be
  obtain ⟨Lp2, hp2⟩ := hg.p2
  obtain ⟨Lkb, hkb⟩ := hg.kb
  have T := tE_all q kb Bx w k hk LC hg hc hBx
  have hp2V : 2 ^ (2 * q.p) ≤ V := Nat.le_add_right _ _
  have e1 : EA w Bx (sOffE xS gw) ((sOff (sK q k) (sWidth q.p q.α) : ℕ) : ℤ) :=
    sOffE_all _ _ V Bx hBx (by omega) xS gw (by decide) (by decide) w LS Lw hs0 hS hww
  have e2 : EA w Bx (.add (.reg xS) (.reg gw1)) ((sK q k + (2 * sWidth q.p q.α + 1) : ℕ) : ℤ) := by
    refine EA_eq (EA_add (EA_reg xS hS (by decide) (zb _ (by simp; omega)))
      (EA_reg gw1 hw1 (by decide) (zb _ (by simp; omega))) (zb _ ?_)) (by push_cast; ring)
    have : ((sK q k : ℤ) + ((2 * sWidth q.p q.α + 1 : ℕ) : ℤ)).natAbs =
        sK q k + (2 * sWidth q.p q.α + 1) := by push_cast; omega
    rw [this]; nlinarith
  have e3 : zsz ((2 : ℤ) ^ (2 * q.p)) ≤ Bx := zb _ (by simp only [Int.natAbs_pow]; simpa using hp2V)
  have e4 : EA w Bx (.mul NLogN.EX.tE (.reg gw1)) ((tK q k * (2 * sWidth q.p q.α + 1) : ℕ) : ℤ) := by
    refine EA_eq (EA_mul T (EA_reg gw1 hw1 (by decide) (zb _ (by simp; omega))) (zb _ ?_))
      (by push_cast; ring)
    rw [← Nat.cast_mul, Int.natAbs_natCast]
    have : tK q k * (2 * sWidth q.p q.α + 1) ≤ G * (3 * G) := Nat.mul_le_mul (by omega) (by omega)
    nlinarith
  have e5 : EA w Bx (NLogN.EX.mE xM xS) ((mS q k : ℕ) : ℤ) :=
    mE_all (NS q k) (sK q k) (mS q k) V Bx hBx (by omega) xM xS (by decide)
      (by decide) w LM LS hs0 hNe hMx hS
  have e6 : EA w Bx (.mul (.reg ga2) (.mul NLogN.EX.tE NLogN.EX.tE)) ((q.α ^ 2 * tK q k ^ 2 : ℕ) : ℤ) := by
    have T2 := EA_mul T T (zb _ (by
      rw [← Nat.cast_mul, Int.natAbs_natCast]
      have : tK q k * tK q k ≤ G * G := Nat.mul_le_mul (by omega) (by omega)
      nlinarith))
    refine EA_eq (EA_mul (EA_reg ga2 ha (by decide) (zb _ (by simp; omega))) T2 (zb _ ?_))
      (by push_cast; ring)
    rw [← Nat.cast_mul, ← Nat.cast_mul, Int.natAbs_natCast]
    have : q.α ^ 2 * (tK q k * tK q k) ≤ G * (G * G) :=
      Nat.mul_le_mul (by omega) (Nat.mul_le_mul (by omega) (by omega))
    nlinarith
  have e7 : EA w Bx (.mul (NLogN.EX.mE xM xS) NLogN.EX.tE) ((mS q k * tK q k : ℕ) : ℤ) := by
    refine EA_eq (EA_mul e5 T (zb _ ?_)) (by push_cast; ring)
    rw [← Nat.cast_mul, Int.natAbs_natCast, ← hN1]; omega
  refine ⟨pushOK_EA Bx w sPush (sVals q kb k) (by decide) ?_, EA_eq e7 (by rw [hN1])⟩
  exact .cons ⟨rfl, by decide, EA_reg xS hS (by decide) (zb _ (by simp; omega))⟩ <|
    .cons ⟨rfl, by decide, T⟩ <| .cons ⟨rfl, by decide, e1⟩ <| .cons ⟨rfl, by decide, e2⟩ <|
    .cons ⟨rfl, by decide, EA_reg g2p2 hp2 (by decide) e3⟩ <|
    .cons ⟨rfl, by decide, EA_reg gw1 hw1 (by decide) (zb _ (by simp; omega))⟩ <|
    .cons ⟨rfl, by decide, e4⟩ <| .cons ⟨rfl, by decide, e5⟩ <|
    .cons ⟨rfl, by decide, EA_reg gkb hkb (by decide) (zb _ (by simp; omega))⟩ <|
    .cons ⟨rfl, by decide, e6⟩ <|
    .cons ⟨rfl, by decide, EA_reg gp hp (by decide) (zb _ (by simp; omega))⟩ <|
    .cons ⟨rfl, by decide, EA_reg gw hww (by decide) (zb _ (by simp; omega))⟩ <|
    .cons ⟨rfl, by decide, EA_reg gbe hb (by decide) (zb _ ((betaT_le _ _).trans hp2V))⟩ <|
    .cons ⟨rfl, by decide, e7⟩ .nil

end NLogN.EX

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.EX
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
set_option maxHeartbeats 8000000
theorem solution (M : NLogN.MulSpec) (q : Params) (kb mm Φ Bacc Q Bq Bx : ℕ) (BS : ℕ → ℕ)
    (hM : NLogN.MulBnd M mm Φ) (hsl : q.s.length = q.K) (hst : ∀ i < q.K, NLogN.EX.sK q i ≤ NLogN.EX.tK q i)
    (hBx : NLogN.EX.Vx q kb < 2 ^ Bx) (k : ℕ) (hk : k < q.K) (H : NLogN.EX.SAx q kb mm Bacc Q Bq BS k)
    (U : List (ℤ × ℤ)) (w : NLogN.IState NLogN.HS) (R LS LM LC : List NLogN.Item) (hg : NLogN.EX.Glob q kb w)
    (hD : w.G NLogN.GL.gD = NLogN.gints (NLogN.EX.XS q U k) ++ R) (hL : (NLogN.EX.XS q U k).length = NLogN.EX.NS q k)
    (hLB : NLogN.GL.GB (BS k) (NLogN.EX.XS q U k))
    (hS : w.G NLogN.EX.xS = .int (NLogN.EX.sK q k : ℤ) :: LS) (hMx : w.G NLogN.EX.xM = .int (NLogN.EX.NS q k : ℤ) :: LM)
    (hc : w.G NLogN.EX.cL = .int ((q.K : ℤ) - k) :: LC) :
    NLogN.EX.sBody.run w = (((w.upd NLogN.GL.gD (NLogN.gints (NLogN.EX.XS q U (k + 1)) ++ R)).upd NLogN.EX.xM
        (.int (NLogN.EX.NS q (k + 1) : ℤ) :: LM)).upd NLogN.EX.xU (.int (NLogN.EX.sK q k : ℤ) :: w.G NLogN.EX.xU)).upd NLogN.EX.xS LS ∧
      NLogN.EX.sBody.ok M w ∧
      NLogN.EX.sBody.cost M w ≤
        NLogN.AX.sapAxCost q.p (NLogN.EX.sK q k) (NLogN.EX.tK q k) q.α (NLogN.EX.mS q k) kb (BS k) mm Φ Bacc Q Bq + NLogN.EX.sOver Bx ∧
      (NLogN.EX.XS q U (k + 1)).length = NLogN.EX.NS q (k + 1) ∧ NLogN.GL.GB (BS (k + 1)) (NLogN.EX.XS q U (k + 1)) := by
  have hs0 := H.sap.hs
  obtain ⟨P, E7⟩ := NLogN.EX.sPush_ok q kb Bx hBx k hk hsl hst hs0 w LS LM LC hg hS hMx hc
  obtain ⟨r1, o1, c1⟩ := NLogN.EX.pushes_all Bx NLogN.EX.sPush (NLogN.EX.sVals q kb k) w P
  have PB := NLogN.EX.PushOK.bounds Bx w NLogN.EX.sPush (NLogN.EX.sVals q kb k) P
  set st := NLogN.EX.pushV w (NLogN.EX.sVals q kb k) with hst_def
  have nd : ((NLogN.EX.sVals q kb k).map Prod.fst).Nodup := by
    simp only [NLogN.EX.sVals, List.map_cons, List.map_nil]; decide
  have gv : ∀ r v, (r, v) ∈ NLogN.EX.sVals q kb k → st.G r = .int v :: w.G r := NLogN.EX.pushV_G_mem w _ nd
  have hR : NLogN.AX.SapRegs q.p (NLogN.EX.sK q k) (NLogN.EX.tK q k) q.α (NLogN.EX.mS q k) kb st :=
    { tab := ⟨⟨_, gv NLogN.AX.aP _ (by simp [NLogN.EX.sVals])⟩, ⟨_, gv NLogN.AX.aS _ (by simp [NLogN.EX.sVals])⟩,
        ⟨_, gv NLogN.AX.aT _ (by simp [NLogN.EX.sVals])⟩, ⟨_, gv NLogN.AX.aWd _ (by simp [NLogN.EX.sVals])⟩,
        ⟨_, gv NLogN.AX.aBe _ (by simp [NLogN.EX.sVals])⟩, ⟨_, gv NLogN.AX.aK2 _ (by simp [NLogN.EX.sVals])⟩,
        ⟨_, gv NLogN.AX.aNR _ (by simp [NLogN.EX.sVals])⟩⟩
      rKa := ⟨_, gv NLogN.AX.aKa _ (by simp [NLogN.EX.sVals])⟩
      rKN := ⟨_, gv NLogN.AX.aKN _ (by simp [NLogN.EX.sVals])⟩
      rR := ⟨_, gv NLogN.AX.aR _ (by simp [NLogN.EX.sVals])⟩
      rNW := ⟨_, gv NLogN.AX.aNW _ (by simp [NLogN.EX.sVals])⟩
      rM := ⟨_, gv NLogN.AX.aM _ (by simp [NLogN.EX.sVals])⟩
      rKB := ⟨_, gv NLogN.AX.aKB _ (by simp [NLogN.EX.sVals])⟩
      rTot := ⟨_, gv NLogN.AX.aTot _ (by simp [NLogN.EX.sVals])⟩ }
  have ngD : NLogN.GL.gD ∉ (NLogN.EX.sVals q kb k).map Prod.fst := by
    simp only [NLogN.EX.sVals, List.map_cons, List.map_nil]; decide
  have hD' : st.G NLogN.GL.gD = NLogN.gints (NLogN.EX.XS q U k) ++ R := by rw [NLogN.EX.pushV_G_not w NLogN.GL.gD _ ngD]; exact hD
  obtain ⟨r2, o2, c2, l2, b2⟩ := NLogN.AX.sapAxP_all M q.p (NLogN.EX.sK q k) (NLogN.EX.tK q k) q.α (NLogN.EX.mS q k) kb (BS k)
    (BS (k + 1)) mm Φ Bacc Q Bq (q.s.drop (k + 1) ++ q.tdims.take k) hM H.sap H.tab H.axq rfl st
    (NLogN.EX.XS q U k) R hR hD' (by rw [hL, NLogN.EX.NS_eq q hsl k hk]) hLB
  rw [← NLogN.EX.XS_succ q hsl U k hk] at r2 l2 b2
  set X := NLogN.gints (NLogN.EX.XS q U (k + 1)) ++ R with hX
  have hmap : NLogN.EX.sPush.map Prod.fst = (NLogN.EX.sVals q kb k).map Prod.fst := rfl
  have r3 := NLogN.EX.pops_pushV NLogN.GL.gD X (NLogN.EX.sVals q kb k) w ngD
  obtain ⟨o3, c3⟩ := NLogN.EX.pops_okc Bx NLogN.GL.gD X (NLogN.EX.sVals q kb k) w ngD PB
  rw [← hmap] at r3 o3 c3
  set w1 := w.upd NLogN.GL.gD X with hw1
  have w1M : w1.G NLogN.EX.xM = .int (NLogN.EX.NS q k : ℤ) :: LM := by simp (config := {decide := true}) [hw1, hMx]
  have w1S : w1.G NLogN.EX.xS = .int (NLogN.EX.sK q k : ℤ) :: LS := by simp (config := {decide := true}) [hw1, hS]
  obtain ⟨F1, -, -, -, -, -, -, -, F9⟩ := NLogN.EX.Gx_facts q kb
  have GV := NLogN.EX.G_le_V q kb
  obtain ⟨hG1, -, -⟩ := NLogN.EX.G3 (NLogN.EX.Gx q kb) F9
  have hNT := NLogN.EX.NS_le q hsl hst k
  have hNk : NLogN.zsz (NLogN.EX.NS q k : ℤ) ≤ Bx := NLogN.EX.zbV hBx _ (by simp; omega)
  have hsk : NLogN.zsz (NLogN.EX.sK q k : ℤ) ≤ Bx :=
    NLogN.EX.zbV hBx _ (by simp; have := hst k hk; have := NLogN.EX.tK_le_T q k hk; omega)
  have E7' : NLogN.EX.EA w1 Bx (.mul (NLogN.EX.mE NLogN.EX.xM NLogN.EX.xS) NLogN.EX.tE) ((NLogN.EX.NS q (k + 1) : ℕ) : ℤ) := NLogN.EX.EA_upd E7 NLogN.GL.gD X (by decide)
  obtain ⟨r4, o4, c4⟩ := NLogN.EX.updP_all (.mul (NLogN.EX.mE NLogN.EX.xM NLogN.EX.xS) NLogN.EX.tE) w1 Bx _ _ _ LM LS w1M w1S E7' hNk hsk
  have A := NLogN.GL.seq_all (M := M) (.rs (NLogN.EX.pushes NLogN.EX.sPush)) _ w st _ _ _ ⟨r1, o1, c1⟩
    (NLogN.GL.seq_all (M := M) NLogN.AX.sapAxP _ st (st.upd NLogN.GL.gD X) _ _ _ ⟨r2, o2, c2⟩
      (NLogN.GL.seq_all (M := M) (.rs (NLogN.EX.pops (NLogN.EX.sPush.map Prod.fst))) (.rs NLogN.EX.sUpd) (st.upd NLogN.GL.gD X) w1 _ _ _
        ⟨r3, o3, c3⟩ ⟨r4, o4, c4⟩))
  have w1U : w1.G NLogN.EX.xU = w.G xU := by simp (config := {decide := true}) [hw1]
  rw [w1U] at A
  refine ⟨A.1, A.2.1, ?_, by rw [l2, NLogN.EX.NS_succ q k hk], b2⟩
  have hc := A.2.2
  have hsz : (NLogN.Ex.mul (NLogN.EX.mE NLogN.EX.xM NLogN.EX.xS) NLogN.EX.tE).size = 11 := rfl
  have hl : (NLogN.EX.sVals q kb k).length = 14 := rfl
  rw [hsz, hl, NLogN.EX.sPush_size] at hc
  unfold NLogN.EX.sOver
  refine le_trans hc ?_
  have : 4 ≤ (Bx + 2) ^ 2 := by nlinarith
  nlinarith
end
