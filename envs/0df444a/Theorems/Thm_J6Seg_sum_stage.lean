variable (P : ℕ)

theorem J6Seg.sum_stage {I : Finset ℕ} {ct xt : ℕ → ℤ} {c x : ℕ → ℝ} {ec δ X C : ℝ}
    (hc : ∀ k ∈ I, |(ct k : ℝ) / 2 ^ P - c k| ≤ ec) (hC : ∑ k ∈ I, |c k| ≤ C)
    (hx : ∀ k ∈ I, |(xt k : ℝ) / 2 ^ P - x k| ≤ δ) (hX : ∀ k ∈ I, |(xt k : ℝ) / 2 ^ P| ≤ X)
    (hec : 0 ≤ ec) (hδ : 0 ≤ δ) :
    |(rs P (∑ k ∈ I, ct k * xt k) : ℝ) / 2 ^ P - ∑ k ∈ I, c k * x k| ≤
      1 / (2 * 2 ^ P) + I.card * ec * X + C * δ := by sorry
