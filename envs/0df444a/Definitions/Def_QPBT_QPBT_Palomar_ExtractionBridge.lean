/-!
# Exact bridges for compact extraction errors

This module converts the existing qudit and qubit soundness witnesses to the
compact extraction witness.  It specializes the generic errors to the raw
prescribed-answer effects and proves exact equality with the established
soundness quantities.  No soundness existence or numerical estimate is added.

The legacy import form is required because the existing soundness modules have
not yet been converted to Lean's module system.

## References

`references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:1431-1491`;
`references/qpbt-paper/04_preliminaries.tex:1180-1228`.
-/

@[expose] public section

open scoped BigOperators Matrix

namespace MIPStarRE.QPBT

open LIDT.MIPStarRE.Quantum

noncomputable section

namespace PauliSoundnessWitness

/-- Convert a qudit soundness witness to the compact extraction witness. -/
def toPalomar {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)}
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.ExtractionWitness (R := _root_.MIPStarRE.QPBT.PauliRegister P) (_root_.MIPStarRE.QPBT.Palomar.Strategy.ofStrategy S) where
  ιA' := w.ιA'
  ιB' := w.ιB'
  φA := w.φA
  φB := w.φB
  aux := w.aux
  aux_norm := w.aux_norm

/-- The compact ideal state is exactly the existing qudit ideal state. -/
@[simp] theorem idealExtractionState_toPalomar
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.idealExtractionState w.toPalomar = _root_.MIPStarRE.QPBT.idealState P w.aux := rfl

/-- The compact unsquared state error is exactly the existing qudit state error. -/
@[simp] theorem stateError_toPalomar
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.stateError w.toPalomar =
      ‖_root_.MIPStarRE.QPBT.isometryTensor w.φA w.φB S.ψ - _root_.MIPStarRE.QPBT.idealState P w.aux‖ := rfl

end PauliSoundnessWitness

namespace QubitSoundnessWitness

/-- Convert a qubit soundness witness to the compact extraction witness. -/
def toPalomar {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)}
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.ExtractionWitness (R := _root_.MIPStarRE.QPBT.QubitRegister P) (_root_.MIPStarRE.QPBT.Palomar.Strategy.ofStrategy S) where
  ιA' := w.ιA'
  ιB' := w.ιB'
  φA := w.φA
  φB := w.φB
  aux := w.aux
  aux_norm := w.aux_norm

/-- The compact ideal state is exactly the existing qubit ideal state. -/
@[simp] theorem idealExtractionState_toPalomar
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.idealExtractionState w.toPalomar = _root_.MIPStarRE.QPBT.idealQubitState P w.aux := rfl

/-- The compact unsquared state error is exactly the existing qubit state error. -/
@[simp] theorem stateError_toPalomar
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) :
    _root_.MIPStarRE.QPBT.Palomar.stateError w.toPalomar =
      ‖_root_.MIPStarRE.QPBT.isometryTensor w.φA w.φB S.ψ - _root_.MIPStarRE.QPBT.idealQubitState P w.aux‖ := rfl

end QubitSoundnessWitness

namespace Palomar

/-- Alice's compact qudit error specialized to raw prescribed-answer effects. -/
def pauliAliceOperatorError (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  _root_.MIPStarRE.QPBT.Palomar.aliceOperatorError w.toPalomar
    (fun u => _root_.MIPStarRE.QPBT.liftedAEffect S w.φA
      ((S.A (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)))
    (fun u => _root_.MIPStarRE.QPBT.pauliProjOnA'' P W u)

/-- Bob's compact qudit error specialized to raw prescribed-answer effects. -/
def pauliBobOperatorError (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  _root_.MIPStarRE.QPBT.Palomar.bobOperatorError w.toPalomar
    (fun u => _root_.MIPStarRE.QPBT.liftedBEffect S w.φB
      ((S.B (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)))
    (fun u => _root_.MIPStarRE.QPBT.pauliProjOnB'' P W u)

/-- Alice's compact qubit error, still summed over the original field outcomes. -/
def qubitAliceOperatorError (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  _root_.MIPStarRE.QPBT.Palomar.aliceOperatorError w.toPalomar
    (fun u => _root_.MIPStarRE.QPBT.liftedQubitAEffect S w.φA
      ((S.A (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)))
    (fun u => _root_.MIPStarRE.QPBT.qubitProjOnA'' P W u)

/-- Bob's compact qubit error, still summed over the original field outcomes. -/
def qubitBobOperatorError (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  _root_.MIPStarRE.QPBT.Palomar.bobOperatorError w.toPalomar
    (fun u => _root_.MIPStarRE.QPBT.liftedQubitBEffect S w.φB
      ((S.B (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)))
    (fun u => _root_.MIPStarRE.QPBT.qubitProjOnB'' P W u)

/-- The compact Alice qudit sum equals the source-facing raw Pauli distance. -/
@[simp] theorem pauliAliceOperatorError_eq
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) :
    _root_.MIPStarRE.QPBT.Palomar.pauliAliceOperatorError P S w W = _root_.MIPStarRE.QPBT.rawPauliOperatorDistanceA P S w W := rfl

/-- The compact Bob qudit sum equals the source-facing raw Pauli distance. -/
@[simp] theorem pauliBobOperatorError_eq
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) :
    _root_.MIPStarRE.QPBT.Palomar.pauliBobOperatorError P S w W = _root_.MIPStarRE.QPBT.rawPauliOperatorDistanceB P S w W := rfl

/-- The compact Alice qubit sum equals the established qubit distance. -/
@[simp] theorem qubitAliceOperatorError_eq
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) :
    _root_.MIPStarRE.QPBT.Palomar.qubitAliceOperatorError P S w W = _root_.MIPStarRE.QPBT.qubitOperatorDistanceA P S w W := rfl

/-- The compact Bob qubit sum equals the established qubit distance. -/
@[simp] theorem qubitBobOperatorError_eq
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) :
    _root_.MIPStarRE.QPBT.Palomar.qubitBobOperatorError P S w W = _root_.MIPStarRE.QPBT.qubitOperatorDistanceB P S w W := rfl







