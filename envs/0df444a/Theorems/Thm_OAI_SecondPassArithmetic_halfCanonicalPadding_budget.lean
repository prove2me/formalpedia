theorem OAI.SecondPassArithmetic.halfCanonicalPadding_budget (ε C : ℝ) (hε : 0<ε) (hC : 0≤C) :
    0<canonicalPadding ε C/2 ∧ canonicalPadding ε C/2≤(1:ℝ)/1000 ∧
    3000*(canonicalPadding ε C/2)≤(1:ℝ)/80 ∧
    3001*C*(canonicalPadding ε C/2)≤ε/2 := by sorry
