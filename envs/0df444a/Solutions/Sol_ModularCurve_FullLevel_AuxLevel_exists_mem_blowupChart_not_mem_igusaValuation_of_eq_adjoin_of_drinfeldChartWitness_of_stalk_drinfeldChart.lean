    ModularCurve.coe_mem_valuationSubring_of_forall_aeval_mem_chartAlgFin L K A j V hAV (fun P _ =>
      show Polynomial.aeval (j : ↥K) P ∈ V' from
        (Algebra.adjoin_le (Set.singleton_subset_iff.mpr hjV) : Algebra.adjoin A {j} ≤ V')
          (Polynomial.aeval_mem_adjoin_singleton A j))

  let v := V.valuation
  have hv_le : ∀ x : ↥K, x ∈ V → v x ≤ 1 := fun x hx => (V.valuation_le_one_iff x).mpr hx
  have hv_lt : ∀ (x : ↥K) (hx : x ∈ V), (⟨x, hx⟩ : ↥V) ∈ maximalIdeal ↥V → v x < 1 := fun x hx hm =>
    (V.valuation_lt_one_iff ⟨x, hx⟩).mp hm
  have hv_ge : ∀ (x : ↥K) (hx : x ∈ V), (⟨x, hx⟩ : ↥V) ∉ maximalIdeal ↥V → ¬ v x < 1 := fun x hx hm hlt =>
    hm ((V.valuation_lt_one_iff ⟨x, hx⟩).mpr hlt)
