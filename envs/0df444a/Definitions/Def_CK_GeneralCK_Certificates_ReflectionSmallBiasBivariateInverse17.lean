  have h2 := ((lossPower2_approximates hk hklog).scale (153 : ℚ)).addAppend h3
  have h1 := ((lossPower1_approximates hk hklog).scale (17 : ℚ)).addAppend h2
  have h0 := ((lossPower0_approximates hk hklog).scale (1 : ℚ)).addAppend h1
  have hraw := h0.replacePolynomial (inverseSum17_eval k)
  have ht : Approximates 24 k (fun z => eval k seed17 (lossFunction k z,0)) inverseSum17 := by
    convert hraw using 1
    funext z
    norm_num [seed17,eval,evalTerm]
    <;> ring
  have hu := (loss_approximates hk hklog).comp_finite (Approximates.const 24 k 0)
    (loss_zero hk hklog) (by simp) (seed17_approximates hk) ht
  have hh := ((Approximates.parameter 24 k (-17)).mul hk hu).replacePolynomial
    (inversePower17_eval k)
  convert hh using 1
  funext z
  rw [mean_inverse_eq hk, mul_pow]
  simp only [Rat.cast_zero,zpow_neg,zpow_natCast,inv_pow] <;> rfl

