theorem ModularCurve.JZeroNeronObjectAtP.exists_nsmul_mem_toricPts_of_mem_finPts
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) :
    ∃ c : ℕ, 0 < c ∧ ∀ (m : ℕ), 0 < m → ∀ x ∈ O.finPts m,
      degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 →
        c • x ∈ O.toricPts m := by sorry
