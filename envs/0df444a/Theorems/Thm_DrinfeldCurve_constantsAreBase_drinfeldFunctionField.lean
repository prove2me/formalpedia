namespace DrinfeldCurve

theorem constantsAreBase_drinfeldFunctionField (q : ℕ) [Fact q.Prime] (k : Type) [Field k]
    [Algebra (GaloisField q 2) k] [IsDomain (CoordRing q k)] :
    AlgebraicCurve.ConstantsAreBase k (drinfeldFunctionField q k) ∧
      ∀ y : drinfeldFunctionField q k, IsAlgebraic k y → y ∈ (algebraMap k (drinfeldFunctionField q k)).range := by sorry
