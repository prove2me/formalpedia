  have hHp : Metric.infDist p P ≤ κ * ∑ k, max 0 (⟪A k, p⟫ - c k) := hH c p hPne
  have hδP : δ ≤ Metric.infDist p P := DualAux.infDist_fst' hPne hPS w _
  have hκρ : κ * N * ρ ≤ 1 / 2 := by
