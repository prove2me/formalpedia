open OAI OAI.BalancedTransport OAI.BalancedTransport.Recorder OAI.BalancedTransport.Recorder.Checkpoint
variable {Q Γ : Type*}
open Stream' Letter Control

theorem OAI.BalancedTransport.Recorder.Checkpoint.next_exec (M : Machine Q Γ) (c : Checkpoint Q Γ) (hc : c.state ≠ M.halt) :
    Exec M (2 * (c.right.length + 1) + 2) (c.expand M) ((c.next M).expand M) := by sorry
