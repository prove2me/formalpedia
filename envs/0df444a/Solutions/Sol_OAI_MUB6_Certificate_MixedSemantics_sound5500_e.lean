theorem sound5500_e_oai (B : Fin 7 → Basis) (_hB : IsMUBFamily B)
    (_hF : AllTransitionsFourierZero B) :
    mixedMoment B node5500 node5500Labels = Sparse.eval nodeValue5500 (mixedVector B) := by
