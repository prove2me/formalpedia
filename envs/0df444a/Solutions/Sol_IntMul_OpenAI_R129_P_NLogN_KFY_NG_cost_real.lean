  -- the rows of `Ncost`
  set N := IntMul.OpenAI.R129.Ncost (6 * (IntMul.lg n : ℝ)) (IntMul.OpenAI.R129.dP n) (IntMul.OpenAI.R129.KP n) (IntMul.OpenAI.R129.ℓP n) (IntMul.OpenAI.R129.αP n) with hN
  have hp6 : (6 * (IntMul.lg n : ℝ)) = (IntMul.OpenAI.Glue.pP n : ℝ) := by unfold IntMul.OpenAI.Glue.pP IntMul.OpenAI.Glue.bP; push_cast; ring
  rw [hp6] at hN
  have hlog : 0 ≤ Real.log (IntMul.OpenAI.Glue.pP n) := Real.log_nonneg hp1
