/-!
# Atlas V-03 (block D, part 1): scaled fields, single-mode conditions, amplitude regularity

* Scaled four-dimensional fields from the complexified variations (V-03 dictionary; `q = qK = r + i a cos θ`,
  `q̄ = qbarK`): positive `ψ₂ = δΨ₀`, `ψ₁ = √2 q̄ δΨ₁`, `k = δκ/(√2 q̄²)`, `s = q δσ/q̄²`; negative
  `ψ₋₂ = q̄⁴ δΨ₄`, `ψ₋₁ = q̄³ δΨ₃/√2`, `n = q q̄ δν/√2`, `ℓ = q̄ δλ/2`. (`posPsi2F` is III's `PosFields.psi2`, the
  scaled `δΨ₀`; it is **not** the background `Ψ₂ = psi2`.)
* `PosMode` / `NegMode`: each scaled field equals `phaseP ω m · (amplitude ∘ toRT)` on `domKN` (class B; the
  amplitudes are arbitrary functions, never defined through `res1`).
* The amplitudes are then `C^∞` on III's `U p` (`PosMode.smooth`, `NegMode.smooth`): III's `PosSmooth`/`NegSmooth`
  are derived, not assumed. -/

open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN domReg domKN faradayKN)

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

/-! ### Embedding of `(r, θ)` -/

/-- `(r, θ) ↦ (t, r, θ, φ) = (0, r, θ, 0)` (class B). -/
def embRT (z : Fin 2 → ℝ) : Pt 4 := ![0, z 0, z 1, 0]

/-! ### 2D product rule with a differentiable prefactor -/

/-! ### Scaled fields and the single-mode conditions -/

section defs

variable (p : Hintz2026.SubextremalKN) (τ : CTan)

/-- III's `PosFields.psi2` as a 4D field: `ψ₂ = δΨ₀^ℂ` (not the background `Ψ₂`). -/
noncomputable def posPsi2F (y : Pt 4) : ℂ := cPsi0 p.M p.a p.Q τ y
/-- `ψ₁ = √2 q̄ δΨ₁^ℂ`. -/
noncomputable def posPsi1F (y : Pt 4) : ℂ := ((Real.sqrt 2 : ℝ) : ℂ) * qbarK p.a y * cPsi1 p.M p.a p.Q τ y
/-- `k = δκ^ℂ / (√2 q̄²)`. -/
noncomputable def posKF (y : Pt 4) : ℂ := cKappa p.M p.a p.Q τ y / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK p.a y ^ 2)
/-- `s = q δσ^ℂ / q̄²`. -/
noncomputable def posSF (y : Pt 4) : ℂ := qK p.a y * cSigma p.M p.a p.Q τ y / qbarK p.a y ^ 2
/-- `ψ₋₂ = q̄⁴ δΨ₄^ℂ`. -/
noncomputable def negPsim2F (y : Pt 4) : ℂ := qbarK p.a y ^ 4 * cPsi4 p.M p.a p.Q τ y
/-- `ψ₋₁ = q̄³ δΨ₃^ℂ / √2`. -/
noncomputable def negPsim1F (y : Pt 4) : ℂ := qbarK p.a y ^ 3 * cPsi3 p.M p.a p.Q τ y / ((Real.sqrt 2 : ℝ) : ℂ)
/-- `n = q q̄ δν^ℂ / √2`. -/
noncomputable def negNF (y : Pt 4) : ℂ := qK p.a y * qbarK p.a y * cNu p.M p.a p.Q τ y / ((Real.sqrt 2 : ℝ) : ℂ)
/-- `ℓ = q̄ δλ^ℂ / 2`. -/
noncomputable def negLF (y : Pt 4) : ℂ := qbarK p.a y * cLambda p.M p.a p.Q τ y / 2

/-- **Single-mode condition, positive branch** (class B): every scaled field is `phaseP ω m · (amplitude ∘ toRT)`
on `domKN`. -/
structure PosMode (om mm : ℝ) (F : Hintz2026.PosFields) : Prop where
  psi2 : ∀ y ∈ domKN p.M p.a p.Q, posPsi2F p τ y = phaseP om mm y * F.psi2 (toRT y)
  psi1 : ∀ y ∈ domKN p.M p.a p.Q, posPsi1F p τ y = phaseP om mm y * F.psi1 (toRT y)
  k : ∀ y ∈ domKN p.M p.a p.Q, posKF p τ y = phaseP om mm y * F.k (toRT y)
  s : ∀ y ∈ domKN p.M p.a p.Q, posSF p τ y = phaseP om mm y * F.s (toRT y)

/-- **Single-mode condition, negative branch** (class B). -/
structure NegMode (om mm : ℝ) (G : Hintz2026.NegFields) : Prop where
  psim2 : ∀ y ∈ domKN p.M p.a p.Q, negPsim2F p τ y = phaseP om mm y * G.psim2 (toRT y)
  psim1 : ∀ y ∈ domKN p.M p.a p.Q, negPsim1F p τ y = phaseP om mm y * G.psim1 (toRT y)
  n : ∀ y ∈ domKN p.M p.a p.Q, negNF p τ y = phaseP om mm y * G.n (toRT y)
  l : ∀ y ∈ domKN p.M p.a p.Q, negLF p τ y = phaseP om mm y * G.l (toRT y)

end defs

/-! ### Prefactors of the amplitudes and their `(r, θ)` derivatives (class B) -/

section pref

variable (p : Hintz2026.SubextremalKN)

local notation "rb" => Hintz2026.rhoBar p
local notation "rbs" => Hintz2026.rhoBarStar p
local notation "s2" => ((Real.sqrt 2 : ℝ) : ℂ)

/-- `δΨ₁ = P · (√2 ρ̄*)⁻¹ ψ₁`. -/ noncomputable def prefPsi1 (w : Fin 2 → ℝ) : ℂ := (s2 * rbs w)⁻¹
/-- `δκ = P · √2 ρ̄*² k`. -/ noncomputable def prefK (w : Fin 2 → ℝ) : ℂ := s2 * rbs w ^ 2
/-- `δσ = P · ρ̄*² ρ̄⁻¹ s`. -/ noncomputable def prefS (w : Fin 2 → ℝ) : ℂ := rbs w ^ 2 * (rb w)⁻¹
/-- `δΨ₄ = P · ρ̄*⁻⁴ ψ₋₂`. -/ noncomputable def prefPsim2 (w : Fin 2 → ℝ) : ℂ := (rbs w ^ 4)⁻¹
/-- `δΨ₃ = P · √2 ρ̄*⁻³ ψ₋₁`. -/ noncomputable def prefPsim1 (w : Fin 2 → ℝ) : ℂ := s2 * (rbs w ^ 3)⁻¹
/-- `δν = P · √2 (ρ̄ ρ̄*)⁻¹ n`. -/ noncomputable def prefN (w : Fin 2 → ℝ) : ℂ := s2 * (rb w * rbs w)⁻¹
/-- `δλ = P · 2 ρ̄*⁻¹ ℓ`. -/ noncomputable def prefL (w : Fin 2 → ℝ) : ℂ := 2 * (rbs w)⁻¹

variable {z : Fin 2 → ℝ} (hz : z ∈ Hintz2026.U p)
include hz

local notation "ds" => (I * ((p.a * Real.sin (z 1) : ℝ) : ℂ))

end pref

