-- title:
--   Non-vanishing of z dj in the modular function field
-- statement:
--   Let $K$ be a perfect field and $\ell$ a nonzero natural number, and let $F =$ [`ModularCurve.modularFunctionFieldC K ℓ`](def/ModularCurve_JqCoeff.html#L61) be the intermediate field of the field $\mathrm{LaurentSeries}\,K$ of formal Laurent series over $K$ generated over $K$ by the two elements `jqModC K` and `jqNModC K ℓ`; here `jqModC K` is the Laurent series $q^{-1}$ times the image under $\mathbb{Z}\to K$ of the power series `jNum` $=E_4^3\cdot$`dedekindEtaUnitInv`, i.e. the $q$-expansion of the modular $j$-invariant read over $K$, and `jqNModC K ℓ` is its image under the substitution operator `qExpand K ℓ`. Assume given an element $x_{0}\in F$ such that $F$ is finite-dimensional over the intermediate field $K(x_{0})$ generated by $x_{0}$, and let $z\in F$ be nonzero. Write $\bar{j}\in F$ for `jqModC K` together with its membership in $F$. Then the element $z\cdot D_{K/F}(\bar{j})$ of the module of Kähler differentials $\Omega_{F/K}$ is nonzero, where $D$ is the universal derivation.
--
--   This is the statement that the $q$-expansion of $j$ is a separating variable for the modular function field of level $\ell$ over a perfect field, so that its differential, and every nonzero multiple of it, is a nonzero element of $\Omega_{F/K}$. It underlies the later constructions of regular differentials and Riemann–Roch spaces on the modular curve, and is used in the identification of differentials with eigenvalue conditions for Hecke operators.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_smul_D_jqModC_ne_zero.lean

import Definitions.Def_ModularCurve_JqCoeff
import Definitions.Def_AlgebraicCurve_Differentials

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem ModularCurve.smul_D_jqModC_ne_zero {K : Type*} [Field K] {ℓ : ℕ} [NeZero ℓ]
    [PerfectField K] (x₀ : ModularCurve.modularFunctionFieldC K ℓ)
    [FiniteDimensional (IntermediateField.adjoin K ({x₀} : Set (ModularCurve.modularFunctionFieldC K ℓ)))
      (ModularCurve.modularFunctionFieldC K ℓ)]
    {z : ModularCurve.modularFunctionFieldC K ℓ} (hz : z ≠ 0) :
    z • KaehlerDifferential.D K (ModularCurve.modularFunctionFieldC K ℓ)
      ⟨ModularCurve.jqModC K, ModularCurve.jqModC_mem K ℓ⟩ ≠ 0 := by sorry
