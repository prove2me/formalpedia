theorem J6Sieve.exists_coprime_in_windows (d X H : ℕ) (A : Fin d → ℕ) (hA : ∀ i, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∃ s : Fin d → ℕ, (∀ i, Odd (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      Pairwise (fun i j => Nat.Coprime (s i) (s j)) := by sorry
