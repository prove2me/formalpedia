section L3bot
variable {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀)
  (h₁ : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j)
  (h₂ : C.U₂ s = Set.univ)

theorem I₃_eq_bot_iff (n : ℕ) :
    C.I₃ s h₁ h₂ n = ⊥ ↔ ∀ i : Fin (2 * g), (C.law s h₁ h₂).nsmul (𝟙 _) n (C.Psec s h₁ i) = (C.law s h₁ h₂).one (𝟙 _) := by
  rw [I₃, iSup_eq_bot]
  refine forall_congr' fun i => ?_
  have hid : Spec.map (CommRingCat.ofHom (RingHom.id R)) = 𝟙 (Spec (CommRingCat.of R)) := by
    rw [CommRingCat.ofHom_id]; exact Spec.map_id _
  have hker : RingHom.ker (RingHom.id R) = ⊥ := (RingHom.injective_iff_ker_eq_bot _).mp Function.injective_id
  rw [← le_bot_iff, ← hker, ← C.Tsec_spec s h₁ h₂ n i R (RingHom.id R)]
  have hP : (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (RingHom.id R))) (Category.comp_id _)
      (C.zsec s h₁ ⟨i.1 + 1, by omega⟩)).1 = (C.Psec s h₁ i).1 := by
    rw [GoodReductionJacobian.schemeHomOverComp_coe, hid, Category.id_comp]; rfl
  constructor
  · intro h
    apply Subtype.ext
    have h' := congrArg Subtype.val h
    rw [nsmul_coe_congr (C.law s h₁ h₂) hid n _ (C.Psec s h₁ i) hP, one_coe_congr (C.law s h₁ h₂) hid] at h'
    exact h'
  · intro h
    apply Subtype.ext
    rw [nsmul_coe_congr (C.law s h₁ h₂) hid n _ (C.Psec s h₁ i) hP, one_coe_congr (C.law s h₁ h₂) hid]
    exact congrArg Subtype.val h

end L3bot

theorem lifts_of_iSup_eq_bot {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀)
    (h : (⨆ j, C.Jsec s j) = ⊥) : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z s, z ≫ C.ι s = C.ysec s j :=
  fun j => (C.Jsec_eq_bot_iff s j).mp ((iSup_eq_bot.mp h) j)

def Mem (n : ℕ) {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) : Prop :=
  ∃ (h₁ : (⨆ j, C.Jsec s j) = ⊥) (h₂ : C.U₂ s = Set.univ) (_ : C.I₃ s (C.lifts_of_iSup_eq_bot s h₁) h₂ n = ⊥),
    C.U₄ s (C.lifts_of_iSup_eq_bot s h₁) h₂ n = Set.univ

noncomputable def framedSec {n : ℕ} {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R)
    (j : Fin (2 * g + 1)) : Spec (CommRingCat.of R) ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B) :=
  (if h : j.1 = 0 then (X.L.one (𝟙 _)).1 else (X.P ⟨j.1 - 1, by omega⟩).1) ≫ X.frame.toProj ≫ ProjSpace.map B R N

theorem framedSec_π {n : ℕ} {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R)
    (j : Fin (2 * g + 1)) : framedSec (B := B) X j ≫ ProjSpace.π B N = Spec.map (CommRingCat.ofHom (algebraMap B R)) := by
  unfold framedSec
  rw [Category.assoc, Category.assoc, (AlgebraicGeometry.ProjSpace.isPullback_map B R N).w, ← Category.assoc (X.frame.toProj),
    X.frame.toProj_π]
  split_ifs with h
  · rw [← Category.assoc, (X.L.one (𝟙 _)).2, Category.id_comp]
  · rw [← Category.assoc, (X.P _).2, Category.id_comp]

