-- title:
--   Lemma 4, p.15 — the weighted telescoping inequality (46)
-- statement:
--   Assume the standing assumptions of §2: $\gamma_0>0$, $\delta\in(0,1)$, $0<\nu\le1/2$, $\eta\in[0,\nu/(1+\nu))$, $\epsilon>0$, $x^0\in\mathrm{dom}\,B$, Assumption 1 with $\mu>0$, and let $x^*$ be the solution of (1). Let $\theta_t=\prod_{i=1}^{t-1}(1+2\mu\gamma_i/(1-\eta))$, with $\theta_1=1$, and $\tilde\gamma_t,\tilde\Delta^t$ be as in Lemma 3. Then for every $k\ge1$ such that $x^{k+1}$ has been generated,
--   $$
--   \tfrac12\theta_1\|x^0-x^*\|^2-\tfrac12(1+2\mu\tilde\gamma_k)\theta_k\|x^{k+1}-x^*\|^2\ge-\tilde\gamma_k\theta_k\langle\tilde\Delta^{k+1},x^{k+1}-x^*\rangle+R_k,
--   $$
--   where
--   $$
--   R_k=\sum_{t=1}^k\Bigl(\tilde\gamma_t\beta_t\theta_t\langle\tilde\Delta^t,x^{t+1}-x^t\rangle+\tfrac12\theta_t\|x^{t+1}-x^t\|^2\Bigr).
--   $$
--
--   This is the potential inequality behind the iterate bound of Lemma 5.
--
--   Differences from the source:
--   - encoding: $F$ is a point-valued operator on $\mathrm{cl}(\mathrm{dom}\,B)$ → a total map on $\mathbb R^n$, constrained only on $\mathrm{cl}(\mathrm{dom}\,B)$; reason: values of $F$ elsewhere never enter $F+B$ or a run, since iterates lie in $\mathrm{dom}\,B$
--   - encoding: Assumption 1(d), the resolvent of $\gamma B$ can be exactly evaluated → a family $J$ with $J_\gamma=(I+\gamma B)^{-1}$ for every $\gamma>0$; reason: the assumption has no mathematical content; the family exists and is unique on $\gamma>0$
--   - encoding: iterates generated by Algorithm 1, $1\le t\in\mathbb T-1$ → the prefix predicate `Alg1.IsPrefix` at index $t\ge1$; reason: $t\in\mathbb T-1$ says exactly that $x^{t+1}$ has been generated; nothing is said past it
-- source:
--   Lu & Mei, Primal-dual extrapolation methods for monotone inclusions under local Lipschitz continuity, arXiv:2206.00973v3, Lemma 4, p.15

import Mathlib
import Definitions.Def_ThreeOpSplitting_Convergence_MonotoneOperators
import Definitions.Def_MonoIncExtrap_Setting
import Definitions.Def_MonoIncExtrap_Algorithm1

open InnerProductSpace ThreeOpSplitting.Convergence

namespace MonoIncExtrap

/-- **Lemma 4.** arXiv:2206.00973v3, Lemma 4, p.15, inequality (46), with `R_k` of (47): for a run
of Algorithm 1 and `k ≥ 1` such that `x^{k+1}` has been generated,
`½θ_1‖x⁰ − x∗‖² − ½(1 + 2μγ̃_k)θ_k‖x^{k+1} − x∗‖² ≥ −γ̃_kθ_k⟨Δ̃^{k+1}, x^{k+1} − x∗⟩ + R_k`. -/
theorem lemma_4 {n : ℕ}
    {B : EuclideanSpace ℝ (Fin n) → Set (EuclideanSpace ℝ (Fin n))}
    {I : Alg1.Input (EuclideanSpace ℝ (Fin n))} {xstar : EuclideanSpace ℝ (Fin n)}
    (hI : Alg1.Standing B I xstar)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {γ : ℕ → ℝ} {n' : ℕ → ℕ} {k : ℕ}
    (hx : Alg1.IsPrefix I x γ n' k) (hk : 1 ≤ k) :
    1 / 2 * Alg1.theta I γ 1 * ‖x 0 - xstar‖ ^ 2
        - 1 / 2 * (1 + 2 * I.μ * Alg1.gammaTilde I γ k) * Alg1.theta I γ k *
          ‖x (k + 1) - xstar‖ ^ 2 ≥
      -(Alg1.gammaTilde I γ k * Alg1.theta I γ k *
          ⟪Alg1.DeltaTilde I x γ (k + 1), x (k + 1) - xstar⟫_ℝ)
        + Alg1.Rk I x γ k := by sorry

end MonoIncExtrap
