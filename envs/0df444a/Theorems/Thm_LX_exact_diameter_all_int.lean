theorem LX.exact_diameter_all_int (n : ℕ) [NeZero n] (hn : 5 ≤ n) :
    4*(diameter n : ℤ)=3*(n : ℤ)^2-8*n+12-3*((n%2 : ℕ) : ℤ) := by sorry
