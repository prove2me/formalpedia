  refine ⟨σ, hσ, ((-1 : (ZMod p)ˣ) : ZMod p).val, h, fun hmod => ?_⟩
  have h1 : (((-1 : (ZMod p)ˣ) : ZMod p).val : ZMod p) = ((1 : ℕ) : ZMod p) :=
    (ZMod.natCast_eq_natCast_iff _ _ _).mpr hmod
