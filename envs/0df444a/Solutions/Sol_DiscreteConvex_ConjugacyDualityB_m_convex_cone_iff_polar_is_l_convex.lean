lemma P_convex (R : V → V → Prop) : Convex ℝ (P R) := by
  intro p hp q hq a b ha hb hab i j h
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  nlinarith [hp i j h, hq i j h]

/-- distinct nonzero fractional parts -/
noncomputable def fr (p : V → ℝ) : Finset ℝ :=
  (univ.filter (fun v => Int.fract (p v) ≠ 0)).image (fun v => Int.fract (p v))

lemma mem_fr {p : V → ℝ} {v : V} (h : Int.fract (p v) ≠ 0) : Int.fract (p v) ∈ fr p :=
  Finset.mem_image.2 ⟨v, by simp [h], rfl⟩

lemma round_aux (R : V → V → Prop) :
    ∀ n, ∀ p ∈ P R, (fr p).card = n → p ∈ convexHull ℝ (IntPts ∩ P R) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro p hp hn
  by_cases hne : (fr p).Nonempty
  swap
  · apply subset_convexHull
    refine ⟨fun v => ⟨⌊p v⌋, ?_⟩, hp⟩
    have : Int.fract (p v) = 0 := by
      by_contra h; exact hne ⟨_, mem_fr h⟩
    have := Int.floor_add_fract (p v)
    linarith
  set fm := (fr p).max' hne with hfm_def
  have hfm_mem : fm ∈ fr p := Finset.max'_mem _ _
  have hle_fm : ∀ v, Int.fract (p v) ≤ fm := by
    intro v
    by_cases h : Int.fract (p v) = 0
    · rw [h]
      obtain ⟨w, _, hw⟩ := Finset.mem_image.1 hfm_mem
      rw [← hw]; exact Int.fract_nonneg _
    · exact Finset.le_max' _ _ (mem_fr h)
  obtain ⟨v0, hv0, hv0'⟩ := Finset.mem_image.1 hfm_mem
  have hfm_pos : 0 < fm := by
    rw [← hv0']; simp at hv0
    exact lt_of_le_of_ne (Int.fract_nonneg _) (Ne.symm hv0)
  have hfm_lt : fm < 1 := by rw [← hv0']; exact Int.fract_lt_one _
  set T : Finset V := univ.filter (fun v => Int.fract (p v) = fm) with hT
  set S : Finset ℝ := insert 0 ((fr p).filter (· < fm)) with hS
  have hSne : S.Nonempty := Finset.insert_nonempty _ _
  set fs := S.max' hSne with hfs_def
  have hfs_mem : fs ∈ S := Finset.max'_mem _ _
  have hfs_nonneg : 0 ≤ fs := Finset.le_max' _ _ (Finset.mem_insert_self _ _)
  have hfs_lt : fs < fm := by
    rcases Finset.mem_insert.1 hfs_mem with h | h
    · rw [h]; exact hfm_pos
    · exact (Finset.mem_filter.1 h).2
  have hfs_cases : fs = 0 ∨ fs ∈ fr p := by
    rcases Finset.mem_insert.1 hfs_mem with h | h
    · exact Or.inl h
    · exact Or.inr (Finset.mem_filter.1 h).1
  have hle_fs : ∀ v, Int.fract (p v) < fm → Int.fract (p v) ≤ fs := by
    intro v hv
    by_cases h : Int.fract (p v) = 0
    · rw [h]; exact hfs_nonneg
    · exact Finset.le_max' _ _ (Finset.mem_insert_of_mem (Finset.mem_filter.2 ⟨mem_fr h, hv⟩))
  set a := 1 - fm with ha
  set b := fm - fs with hb
  have ha0 : 0 < a := by linarith
  have hb0 : 0 < b := by linarith
  let ind : V → ℝ := fun v => if v ∈ T then 1 else 0
  set pp : V → ℝ := fun v => p v + a * ind v with hpp
  set pm : V → ℝ := fun v => p v - b * ind v with hpm
  have hmemT : ∀ v, v ∈ T ↔ Int.fract (p v) = fm := by intro v; simp [hT]
  have hfl : ∀ v, p v = ⌊p v⌋ + Int.fract (p v) := fun v => (Int.floor_add_fract (p v)).symm
  -- fractional parts of pp, pm
  have fr_pp : ∀ v, Int.fract (pp v) = if v ∈ T then 0 else Int.fract (p v) := by
    intro v
    by_cases h : v ∈ T
    · have hv := (hmemT v).1 h
      have : pp v = ((⌊p v⌋ + 1 : ℤ) : ℝ) := by
        simp only [hpp, ind, if_pos h]; push_cast; rw [ha]; linarith [hfl v]
      rw [this, Int.fract_intCast, if_pos h]
    · simp only [hpp, ind, if_neg h, mul_zero, add_zero]
  have fr_pm : ∀ v, Int.fract (pm v) = if v ∈ T then fs else Int.fract (p v) := by
    intro v
    by_cases h : v ∈ T
    · have hv := (hmemT v).1 h
      have : pm v = ((⌊p v⌋ : ℤ) : ℝ) + fs := by
        simp only [hpm, ind, if_pos h]; rw [hb]; linarith [hfl v]
      rw [this, Int.fract_intCast_add, if_pos h, Int.fract_eq_self]
      exact ⟨hfs_nonneg, by linarith⟩
    · simp only [hpm, ind, if_neg h, mul_zero, sub_zero]
  have hsub_pp : fr pp ⊆ (fr p).erase fm := by
    intro t ht
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.1 ht
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv
    rw [fr_pp] at hv ⊢
    by_cases h : v ∈ T
    · rw [if_pos h] at hv; exact absurd rfl hv
    · rw [if_neg h] at hv ⊢
      exact Finset.mem_erase.2 ⟨fun e => h ((hmemT v).2 e), mem_fr hv⟩
  have hsub_pm : fr pm ⊆ (fr p).erase fm := by
    intro t ht
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.1 ht
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hv
    rw [fr_pm] at hv ⊢
    by_cases h : v ∈ T
    · rw [if_pos h] at hv ⊢
      rcases hfs_cases with h0 | h0
      · exact absurd h0 hv
      · exact Finset.mem_erase.2 ⟨ne_of_lt hfs_lt, h0⟩
    · rw [if_neg h] at hv ⊢
      exact Finset.mem_erase.2 ⟨fun e => h ((hmemT v).2 e), mem_fr hv⟩
  have hcard_lt : ((fr p).erase fm).card < n := by
    rw [← hn]; exact Finset.card_erase_lt_of_mem hfm_mem
  -- membership in P
  have hpp_P : pp ∈ P R := by
    intro i j hij
    have hji := hp i j hij
    simp only [hpp, ind]
    by_cases hj : j ∈ T
    · by_cases hi : i ∈ T
      · simp only [if_pos hj, if_pos hi]; linarith
      · simp only [if_pos hj, if_neg hi, mul_zero, add_zero, mul_one]
        have hjv := (hmemT j).1 hj
        by_contra hcon
        push Not at hcon
        have h1 : p i < (⌊p j⌋ : ℝ) + 1 := by rw [ha] at hcon; linarith [hfl j]
        have h2 : ⌊p i⌋ ≤ ⌊p j⌋ := by
          have : (⌊p i⌋ : ℝ) < ⌊p j⌋ + 1 := lt_of_le_of_lt (Int.floor_le _) h1
          exact_mod_cast Int.lt_add_one_iff.1 (by exact_mod_cast this)
        have h3 : ⌊p j⌋ ≤ ⌊p i⌋ := Int.floor_mono hji
        have h4 : fm ≤ Int.fract (p i) := by
          rw [← hjv]; unfold Int.fract; rw [le_antisymm h2 h3]; linarith
        have h5 : Int.fract (p i) = fm := le_antisymm (hle_fm i) h4
        exact hi ((hmemT i).2 h5)
    · simp only [if_neg hj, mul_zero, add_zero]
      split_ifs <;> linarith
  have hpm_P : pm ∈ P R := by
    intro i j hij
    have hji := hp i j hij
    simp only [hpm, ind]
    by_cases hi : i ∈ T
    · by_cases hj : j ∈ T
      · simp only [if_pos hj, if_pos hi]; linarith
      · simp only [if_pos hi, if_neg hj, mul_zero, sub_zero, mul_one]
        have hiv := (hmemT i).1 hi
        have h3 : ⌊p j⌋ ≤ ⌊p i⌋ := Int.floor_mono hji
        rcases lt_or_eq_of_le h3 with h4 | h4
        · have h5 : (⌊p j⌋ : ℝ) + 1 ≤ ⌊p i⌋ := by exact_mod_cast h4
          have h6 := Int.lt_floor_add_one (p j)
          rw [hb]; linarith [hfl i]
        · have h7 : Int.fract (p j) ≤ fm := hle_fm j
          have h8 : Int.fract (p j) ≠ fm := fun e => hj ((hmemT j).2 e)
          have h9 := hle_fs j (lt_of_le_of_ne h7 h8)
          have h10 : p j = ⌊p i⌋ + Int.fract (p j) := by rw [← h4]; exact hfl j
          rw [hb]; linarith [hfl i]
    · simp only [if_neg hi, mul_zero, sub_zero]
      split_ifs <;> linarith
  have h1 : pp ∈ convexHull ℝ (IntPts ∩ P R) :=
    ih _ (lt_of_le_of_lt (Finset.card_le_card hsub_pp) hcard_lt) pp hpp_P rfl
  have h2 : pm ∈ convexHull ℝ (IntPts ∩ P R) :=
    ih _ (lt_of_le_of_lt (Finset.card_le_card hsub_pm) hcard_lt) pm hpm_P rfl
  have hab : a + b ≠ 0 := by linarith
  have hcomb : p = (b / (a + b)) • pp + (a / (a + b)) • pm := by
    funext v; simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hpp, hpm]
    field_simp; ring
  rw [hcomb]
  exact convex_convexHull ℝ _ h1 h2 (by positivity) (by positivity) (by field_simp; ring)

theorem P_eq_hull (R : V → V → Prop) : P R = convexHull ℝ (IntPts ∩ P R) := by
  apply le_antisymm
  · intro p hp; exact round_aux R _ p hp rfl
  · exact convexHull_min Set.inter_subset_right (P_convex R)

end MCAux


