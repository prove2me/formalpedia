theorem zr_VB {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) : VB (zr v) A := by
  intro j hj; unfold zr; split_ifs
  · simp
  · exact h j hj

theorem clr_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hv : VB v A) : Sp clr (encK s (RF v c)) (encK s (RF (zr v) c)) (cClr A) := by
  have st : ∀ (w : Fin HS → ℤ) (i : Fin HS), i ∈ rg → VB w A →
      Sp (.asg i (.lit 0)) (encK s (RF w c)) (encK s (RF (Function.update w i 0) c))
        (cE (.lit 0) (BW A)) := by
    intro w i hi hw
    have := spA s w c (i := i) hi (e := .lit 0) (inRg_of (by decide)) trivial
      (V := fun _ => 2 ^ A) (B := BW A) (by intro j hj; simp [Ex.regs] at hj)
      (hw i hi) (mgB hA (by decide) (by decide))
      (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
    simpa [Ex.eval] using this
  have z : ∀ (w : Fin HS → ℤ) (i : Fin HS), VB w A → VB (Function.update w i 0) A :=
    fun w i hw => VB_upd hw i (by simp)
  have T := (st v 2 (by decide) hv).seq ((st _ 3 (by decide) (z _ _ hv)).seq
    ((st _ 4 (by decide) (z _ _ (z _ _ hv))).seq ((st _ 5 (by decide) (z _ _ (z _ _ (z _ _ hv)))).seq
    ((st _ 11 (by decide) (z _ _ (z _ _ (z _ _ (z _ _ hv))))).seq
    (st _ 12 (by decide) (z _ _ (z _ _ (z _ _ (z _ _ (z _ _ hv))))))))))
  refine (T.congr ?_).mono (le_of_eq (by unfold cClr; ring))
  congr 2
  funext j
  simp only [zr, Function.update_apply]
  split_ifs <;> simp_all

