import Mathlib
import Definitions.Def_EML_NeuralCoding_EMLStoneWeierstrassHausdorff
/-
# EML Stone–Weierstrass Theorem for Compact Hausdorff Spaces

This file proves the generalized EML Stone–Weierstrass theorem: for any compact
Hausdorff space X equipped with a continuous point-separating family Φ : Fin n → C(X, ℝ),
the ℝ-subalgebra of C(X, ℝ) generated by the EML exponential and logistic generators
is dense in C(X, ℝ) (i.e., its topological closure is ⊤).

This removes the assumption that the ambient space is Euclidean (Fin n → ℝ) and works
with arbitrary compact Hausdorff topological spaces.
-/

noncomputable section

open Real Finset

variable {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
variable {n : ℕ} (Φ : Fin n → C(X, ℝ))







omit [CompactSpace X] [T2Space X] in

theorem emlSubalgebraHausdorff_separatesPoints    (_hn : 1 ≤ n)
    (hΦ : ∀ x y : X, x ≠ y → ∃ i : Fin n, Φ i x ≠ Φ i y) :
    (emlSubalgebraHausdorff Φ).SeparatesPoints := by sorry
