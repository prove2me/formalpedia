open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

/-! ## Facts on the sources -/

theorem tF6_bit (P : Prm) (n j : ℕ) :
    tF6 P n j = 2 ^ (hN6 P n + if dpN6 P n ≤ j then 1 else 0) := by
  unfold tF6 bL6; simp only [decide_eq_true_eq]
  split_ifs <;> simp [pow_succ]

theorem src6_le (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) (hW : WinOK6 P n)
    (i : ℕ) (hi : i < dP6 P n) : src6 P n i ≤ 2 ^ ℓP6 P n := by
  have H := src6_facts P n hd hl hW (dP6 P n) le_rfl i hi
  have h3 := wnd6_le P n i hd
  have h4 := tF6_le P n i hl
  unfold wA6 at H; omega

theorem PP6_le (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) (hW : WinOK6 P n) :
    ∀ j ≤ dP6 P n, PP6 P n j ≤ 2 ^ (ℓP6 P n * j)
  | 0, _ => by simp [PP6]
  | j + 1, hj => by
    rw [PP6_succ, mul_add, mul_one, pow_add]
    exact Nat.mul_le_mul (PP6_le P n hd hl hW j (by omega)) (src6_le P n hd hl hW j (by omega))

