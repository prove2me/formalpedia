theorem GlobalTheory.WeightScale.addXYZ_triple (u : A) (V : WeierstrassCurve A) (P Q : Fin 3 → A) :
    (curve u V).toProjective.addXYZ (triple u P) (triple u Q) =
      u ^ 6 • triple u (V.toProjective.addXYZ P Q) := by sorry
