  have h1 : n0K K ≤ N := le_trans (le_max_left _ _) hN
  have h2 : 2 ^ (2 ^ (8 * K) + 1) ≤ N := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hN
  have h3 : 2 ^ 2 ^ B0 ≤ N := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hN
  exact ⟨NK.kf K N (by omega) h2, h1, hP_of K N B0 hB0 h3⟩

theorem final_of (K : ℕ) (hK : 10 ^ 4 ≤ K) : MulTimeBound fun n => (n : ℝ) * Real.log n := by
  obtain ⟨B0, hB0⟩ := ev_pow (2 ^ 21 * 10 ^ 60 * (K + 1) ^ 12)
  have hst := ST.stepOK K (nF K B0) (by omega) (le_max_left _ _)
    (fun N hN => NK.numOK_large K hK N (le_trans (le_max_left _ _) hN))
  refine Top.hv_mulTimeBound hst (10 ^ 66 * (K + 1) ^ 2 + 10 ^ 10 + (10 ^ 7 + 20000 * zsz ((nF K B0 : ℕ) : ℤ)))
    2 (by norm_num) ?_ ?_
  · intro N hN
    have hp := PB_of hK hB0 hN
    have a1 := lin_le hp
    have a2 := top_le (nF K B0) N _ hp.kf.pf.zN
    rw [add_mul]
    omega
  · intro N hN
    have hp := PB_of hK hB0 hN
    have h2 : 2 ^ (2 ^ (8 * K) + 1) ≤ N := by
      unfold nF at hN; exact le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hN
    exact hR_of hK hp h2

end NLogN.FIN

end

section
set_option linter.unusedSimpArgs false
