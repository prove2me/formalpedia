-- title:
--   Faces of the complex generated by a set of top faces
-- statement:
--   For a finite set $X(d)$ of top faces, a set $\sigma$ of vertices is a **face** of the downward closure $X$ if $\sigma\subseteq\tau$ for some $\tau\in X(d)$. The empty set is a face whenever $X(d)\neq\emptyset$.
-- source:
--   Songtao Mao, Abelian Cayley High-Dimensional Expanders with Polylogarithmic Degree, arXiv:2609.08937 (held version, sha256 6f5b0daa…75ba), Section 2.2, p.8

import Mathlib
import Definitions.Def_ReplParity_Vec
open ReplParity (Vec)

namespace AbelianCayleyHDX.Supplement

/-- **A face of the complex generated by `tops`** (Mao, *Abelian Cayley High-Dimensional Expanders with Polylogarithmic Degree*, arXiv:2609.08937 (held version, sha256 6f5b0daa…75ba), Section 2.2, p.8: a finite pure
simplicial complex is downward closed and every face is contained in a top face): `σ` is a face
iff it is contained in some top face. The empty set is a face whenever `tops` is nonempty
(`X(-1) = {∅}`). -/
def IsFace {n : ℕ} (tops : Finset (Finset (Vec n))) (σ : Finset (Vec n)) : Prop :=
  ∃ τ ∈ tops, σ ⊆ τ

end AbelianCayleyHDX.Supplement


