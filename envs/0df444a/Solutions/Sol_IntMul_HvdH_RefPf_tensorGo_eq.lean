theorem solution (K : ℕ) (ns ns' : List ℕ) (hns : ns.length = K) (hns' : ns'.length = K)
    (hpos : ∀ i < K, 0 < ns.getD i 1)
    (A : ℕ → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ))
    (hloc : ∀ i < K, ∀ U U' : ℕ → ℤ × ℤ, (∀ j < ns.getD i 1, U j = U' j) → A i U = A i U')
    (g : (Fin K → ℕ) → ℤ × ℤ) :
    IntMul.HvdH.Ref.tensorGo ((List.range K).map fun i => (ns'.getD i 1, fun X : List (ℤ × ℤ) =>
        (List.range (ns'.getD i 1)).map (A i fun j => X.getD j (0, 0))))
      ns (IntMul.HvdH.Ref.listOf ns fun j => g fun i => j i) =
    IntMul.HvdH.Ref.listOf ns' fun j => IntMul.HvdH.tensorMapZ (fun i : Fin K => A i) g fun i => j i := by
  have := IntMul.HvdH.RefPf.tensorGo_stage K ns ns' hns hns' hpos A hloc K 0 (by omega) g
  simp only [List.drop_zero, List.take_zero, List.append_nil, Nat.sub_zero] at this
  have e : (fun j : ℕ → ℕ => g fun i : Fin K => j ((i.val + K) % K)) = fun j => g fun i => j i := by
    funext j; congr 1; funext i; rw [Nat.add_mod_right, Nat.mod_eq_of_lt i.2]
  rw [e] at this
  exact this
