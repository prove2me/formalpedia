theorem NLogN.KIL.tok_edgeTpl {R : Type*} [CommRing R] {W : ℕ} (Qc : QCircuit R m W) (X : IMat m)
    {q e Bb : ℕ} (hq : q.Prime) (he : 1 ≤ e)
    (hg : GoodAtQ q ((Qc.den : ℚ)⁻¹ • ratM X)) (hlt : tokBnd ((Qc.den : ℚ)⁻¹ • ratM X) < q)
    (hBb : zsz ((tokBnd ((Qc.den : ℚ)⁻¹ • ratM X) * (q ^ e + 1) ^ 2 : ℕ) : ℤ) ≤ Bb) :
    ∀ T, TStep.sh T ∈ edgeTplQ Qc X → TOK T (q ^ e) Bb := by sorry
