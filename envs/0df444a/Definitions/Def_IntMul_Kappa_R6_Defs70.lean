section
-- Source module: Solutions.J6SegAxBud4
/-!
# B-line axis budget 4: the chunk half of `AxBudgetAt` (statement, witnesses, size facts)

* `ChunkPlanB ap`: `2 pkA + 1 ≤ bA`, `2 pkC + 3 ≤ bC` (so `b ≥ 2 pk + Q + 3`; `ap6` satisfies it);
* `ChunkFacts … BI BH Bk Lc Ck`: the chunk conjuncts of `AxBudgetAt` (same order, no cost);
* `ChunkBudgetAt`, `ChunkBudget6`: `ChunkFacts ∧ kerC … ≤ Cc`;
* the witnesses `cBI … cCk` and **`chunk_facts`**: `ChunkFacts` at the witnesses on every axis
  with `AxNum`, `TabAt`, `ChunkPlan6`, `ChunkPlanB`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

/-- The extra plan condition of the chunk kernel: `b ≥ 2 pk + Q + 3`. -/
def ChunkPlanB (ap : AxPlan6) : Prop := 2 * ap.pl.pkA + 1 ≤ ap.pl.bA ∧ 2 * ap.pl.pkC + 3 ≤ ap.pl.bC

/-- The chunk conjuncts of `AxBudgetAt` (without the cost). -/
def ChunkFacts (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)
    (BI BH Bk Lc Ck : ℕ) : Prop :=
  let Q := axQ6 P n src k; let R := axR6 P n; let lam := axl6 P n
  let pk := axpk6 P n src k ap; let b := axb6 P n src k ap; let wd := axwd6 P n src k ap
  let nc := axnc6 P n k
  let pre := axpre6 P n D k; let post := axpost6 P n D k
  let fC := axfC6 P n
  let NC := 2 * (pre * nc * post * 2 ^ fC)
  let TC := tabsT (axTC6 P n src k ap) nc
  1 ≤ b ∧ b + 4 ≤ BI ∧ 2 * pk + 4 ≤ BI ∧ Q + 3 ≤ BI ∧ zsz ((2 * lam : ℕ) : ℤ) ≤ BI ∧ BI ≤ BH ∧
    (2 : ℤ) ^ Q * 2 ^ (R + 2) ≤ 2 ^ pk ∧
    KR.Xs (((lam : ℤ) + 1) * 2 ^ (R + 2) + 1) (axX6 P n src k ap) 7 ≤ 2 ^ pk ∧
    4 * lam * 2 ^ (2 * pk) < 2 ^ (b - 1) ∧ pk + 1 ≤ wd ∧
    (∀ m, 1 ≤ m → m ≤ lam → ∀ v ∈ KR.blkHdr2 m b, zsz v ≤ BH) ∧
    (∀ q, ∀ v ∈ axTC6 P n src k ap q, zsz v ≤ BH) ∧
    (∀ q, KR.cKer2 pk b lam (mulSup (2 * BI)) (fun m => mulSup (2 * (b * (2 * m) + 2))) BI BH
      (descsOf (axs6 src k) (axt6 P n k) lam (TT Q R (axs6 src k) (axt6 P n k) (axα6 P n)) q) + 2
      ≤ Ck) ∧
    1 ≤ Bk ∧ wd ≤ Bk ∧ zsz (wd : ℤ) ≤ Bk ∧ zsz (fC : ℤ) ≤ Bk ∧ zsz ((pre * nc : ℕ) : ℤ) ≤ Bk ∧
    zsz (post : ℤ) ≤ Bk ∧ zsz (pre : ℤ) ≤ Bk ∧ zsz (nc : ℤ) ≤ Bk ∧
    zsz ((2 * 2 ^ fC : ℕ) : ℤ) ≤ Bk ∧ zsz (NC : ℤ) ≤ Bk ∧ zsz (TC.length : ℤ) ≤ Bk ∧
    zsz (Lc : ℤ) ≤ Bk ∧
    (∀ q < nc, Bnd Bk (axTC6 P n src k ap q) ∧ (axTC6 P n src k ap q).length ≤ Lc)

/-- **The chunk half of the budget** on axis `k`. -/
def ChunkBudgetAt (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (Cc : ℝ) : Prop :=
  ∃ (BI BH Bk Lc Ck : ℕ), ChunkFacts P ap n src D k BI BH Bk Lc Ck ∧
    (kerC Ck Bk (2 ^ axfC6 P n) (axpost6 P n D k) Lc (axnc6 P n k)
      (tabsT (axTC6 P n src k ap) (axnc6 P n k)).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * axnc6 P n k * axpost6 P n D k * 2 ^ axfC6 P n)) : ℝ) ≤ Cc

/-- **`ChunkBudget6 P ap`**. -/
def ChunkBudget6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ (C : ℝ) (A n₁ : ℕ), 0 ≤ C ∧ ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
    ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, ChunkBudgetAt P ap n src D k (C * cU6 P n A / (D + 1))

/-! ## The witnesses -/

section wit
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) (ap : AxPlan6)

def cBI : ℕ := axb6 P n src k ap + 2 * axpk6 P n src k ap + 2 * axQ6 P n src k + 6
def cBH : ℕ := cBI P n src k ap + axb6 P n src k ap + axQ6 P n src k + axR6 P n + 8
def cBk : ℕ := axwd6 P n src k ap + cBH P n src k ap + pP6 P n + 10
def cLc : ℕ := 8 + 10 * axl6 P n
def cJ : ℕ := zsz (((2 * axl6 P n + 1 : ℕ)) : ℤ)
def cZ : ℕ := zsz (((axb6 P n src k ap * (2 * axl6 P n) + 1 : ℕ)) : ℤ)
def cZl : ℕ := zsz (((4 * axb6 P n src k ap * axl6 P n + 4 + 1 : ℕ)) : ℤ)
def cPhi : ℕ := NLogN.KFZ.Cfm * (5 * axb6 P n src k ap) * (cZl P n src k ap + 2) *
  (zsz (((cZl P n src k ap + 2) ^ 4 : ℕ) : ℤ) + 1)
def cφD : ℕ := mulSup (2 * cBI P n src k ap)
def cYb : ℕ := Yb (axpk6 P n src k ap) (axb6 P n src k ap) (cφD P n src k ap) (cPhi P n src k ap)
  (cBI P n src k ap) (cBH P n src k ap) (cJ P n) (cZ P n src k ap)
def cCk : ℕ := 10 ^ 9 * (axl6 P n + 1) * (cBI P n src k ap + cBH P n src k ap + 2) +
  2 * axl6 P n * cYb P n src k ap + 10 ^ 4 + 2

end wit

/-! ## The per-block multiplication bound -/

/-! ## The size facts on one axis -/

end J6Seg.ChB
end

