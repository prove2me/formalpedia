    (b := .seq (.push O (mAdd 2 (.reg A) (.reg Z))) (.seq (.pop A) (.pop Z))) hC5
    (fun k => by simp [zipSt, Function.update_apply, hAC.symm, hZC.symm, hOC.symm, hfC])
