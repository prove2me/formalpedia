/-!
# Homologie des sphères (A2 ; Hatcher, Corollaire 2.14)

On note `H̃₀(X) = ker (H₀(X) → H₀(pt))` l'homologie réduite en degré `0`.

* **Outils de Mathlib** : l'invariance par homotopie (`congr_homologyMap_singularChainComplexFunctor`),
  l'augmentation `ε : H₀(X) → R` (un isomorphisme si `X` est connexe par arcs), et l'annulation de
  `H_k` pour `k ≠ 0` sur un espace totalement discontinu.
* **Naturalité de `ε`** (absente de Mathlib) : `f_* ≫ ε_Y = ε_X`.
* **Pas de récurrence** (`shift`) : pour `E` euclidien, `u` unitaire et `V = u^⊥`, on recouvre
  `S(E)` par `A = S(E) ∖ {u}` et `B = S(E) ∖ {-u}`, contractiles par projection stéréographique.
  `A ∩ B` se rétracte par déformation sur l'équateur `S(V)`. Mayer–Vietoris donne
  `H_{k+1}(S(E)) ≅ H_k(S(V))` pour `k ≥ 1` et `H_1(S(E)) ≅ H̃₀(S(V))`.
* **Base** : `S⁰` est discret à deux points, d'où `H_k(S⁰) = 0` pour `k ≥ 1` et `H̃₀(S⁰) ≅ R`.
-/

open CategoryTheory Limits AlgebraicTopology

namespace Hatcher.Singular

variable {R : Type} [Ring R]

section General

variable {X Y Z : Type} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]

theorem map_comp (n : ℕ) (f : C(X, Y)) (g : C(Y, Z)) :
    map R n (g.comp f) = map R n f ≫ map R n g := by
  rw [← Functor.map_comp]
  rfl

theorem map_id (n : ℕ) : map R n (ContinuousMap.id X) = 𝟙 _ :=
  CategoryTheory.Functor.map_id _ (TopCat.of X)

/-- **Invariance par homotopie.** -/
theorem map_congr (n : ℕ) {f g : C(X, Y)} (h : f.Homotopic g) : map R n f = map R n g := by
  obtain ⟨F⟩ := h
  exact TopCat.Homotopy.congr_homologyMap_singularChainComplexFunctor
    (f := TopCat.ofHom f) (g := TopCat.ofHom g) F (ModuleCat.of R R) n

/-- Une équivalence d'homotopie induit un isomorphisme en homologie. -/
theorem isIso_map_of_homotopyEquiv (n : ℕ) (e : ContinuousMap.HomotopyEquiv X Y) : IsIso (map R n e.toFun) :=
  ⟨map R n e.invFun, by rw [← map_comp, map_congr n e.left_inv, map_id],
    by rw [← map_comp, map_congr n e.right_inv, map_id]⟩

/-- L'application constante vers le point. -/
def toPt (X : Type) [TopologicalSpace X] : C(X, Unit) := ContinuousMap.const X ()

theorem toPt_comp (f : C(X, Y)) : (toPt Y).comp f = toPt X := rfl

/-- L'augmentation `ε : H₀(X) → R`. -/
noncomputable abbrev eps (X : Type) [TopologicalSpace X] : H R 0 X ⟶ ModuleCat.of R R :=
  (TopCat.of X).singularHomology₀ε (ModuleCat.of R R)

/-- **Naturalité de l'augmentation** pour les ensembles simpliciaux. -/
theorem sset_homologyMap_homology₀ε {S T : SSet.{0}} (f : S ⟶ T) (M : ModuleCat.{0} R) :
    SSet.homologyMap f M 0 ≫ T.homology₀ε M = S.homology₀ε M := by
  have hi : IsIso ((S.chainComplex M).iCycles 0) :=
    HomologicalComplex.isIso_iCycles _ 0 0 (by simp) (by simp)
  rw [← cancel_epi ((S.chainComplex M).homologyπ 0), ← cancel_epi (inv ((S.chainComplex M).iCycles 0))]
  refine SSet.chainComplex_hom_ext (fun x ↦ ?_)
  have h : S.ιChainComplex x ≫ inv ((S.chainComplex M).iCycles 0) =
      (S.chainComplex M).liftCycles (S.ιChainComplex x) 0 (by simp) (by simp) := by
    rw [← cancel_mono ((S.chainComplex M).iCycles 0)]
    simp
  simp only [← Category.assoc, h]
  simp only [Category.assoc, SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε]
  rw [HomologicalComplex.homologyπ_naturality_assoc, HomologicalComplex.liftCycles_comp_cyclesMap_assoc]
  simp

theorem map_eps (f : C(X, Y)) : map R 0 f ≫ eps Y = eps X :=
  sset_homologyMap_homology₀ε (TopCat.toSSet.map (TopCat.ofHom f)) (ModuleCat.of R R)

theorem subsingleton_of_totallyDisconnected [TotallyDisconnectedSpace X] {k : ℕ} (hk : k ≠ 0) :
    Subsingleton (H R k X) :=
  (ModuleCat.isZero_iff_subsingleton).mp
    (isZero_singularHomologyFunctor_of_totallyDisconnectedSpace (ModuleCat.{0} R) k
      (ModuleCat.of R R) (TopCat.of X) hk)

/-- Pour `X` contractile, `X → pt` induit des isomorphismes en homologie. -/
theorem isIso_map_toPt [ContractibleSpace X] (k : ℕ) : IsIso (map R k (toPt X)) := by
  obtain ⟨e⟩ := ContractibleSpace.hequiv_unit X
  have he : e.toFun = toPt X := ContinuousMap.ext fun _ ↦ rfl
  rw [← he]
  exact isIso_map_of_homotopyEquiv k e

theorem bijective_map_toPt [ContractibleSpace X] (k : ℕ) :
    Function.Bijective (map R k (toPt X)).hom := by
  have := isIso_map_toPt (R := R) (X := X) k
  exact ConcreteCategory.bijective_of_isIso (map R k (toPt X))

theorem subsingleton_of_contractible [ContractibleSpace X] {k : ℕ} (hk : k ≠ 0) :
    Subsingleton (H R k X) :=
  have := subsingleton_of_totallyDisconnected (R := R) (X := Unit) hk
  (bijective_map_toPt (R := R) (X := X) k).injective.subsingleton

/-- Pour `X` connexe par arcs, `H₀(X) → H₀(pt)` est injective : `H̃₀(X) = 0`. -/
theorem injective_map_toPt [PathConnectedSpace X] : Function.Injective (map R 0 (toPt X)).hom := by
  have h := map_eps (R := R) (toPt X)
  have : Mono (map R 0 (toPt X) ≫ eps Unit) := by rw [h]; infer_instance
  exact (ModuleCat.mono_iff_injective _).mp (mono_of_mono _ (eps (R := R) Unit))

end General

section Geometry

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {u : E} (hu : ‖u‖ = 1)

/-- La sphère unité de `E`, comme type. -/
abbrev Sph (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] : Type :=
  Metric.sphere (0 : E) 1

/-- La composante de `x` orthogonale à `u`. -/
noncomputable def perp (u x : E) : E := x - inner ℝ u x • u

include hu in
theorem inner_self_u : inner ℝ u u = 1 := by
  rw [real_inner_self_eq_norm_sq, hu, one_pow]

include hu in
theorem perp_mem (x : E) : perp u x ∈ (ℝ ∙ u)ᗮ := by
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right, perp, inner_sub_right, inner_smul_right,
    inner_self_u hu, mul_one, sub_self]

include hu in
theorem perp_add_smul (x : E) (c : ℝ) : perp u (x + c • u) = perp u x := by
  simp only [perp, inner_add_right, inner_smul_right, inner_self_u hu, mul_one, add_smul]
  abel

theorem perp_smul (c : ℝ) (x : E) : perp u (c • x) = c • perp u x := by
  simp only [perp, inner_smul_right, smul_sub, mul_smul]

theorem perp_of_mem {y : E} (hy : y ∈ (ℝ ∙ u)ᗮ) : perp u y = y := by
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right] at hy
  simp [perp, hy]

include hu in
theorem perp_self : perp u u = 0 := by
  simp [perp, hu]

include hu in
theorem perp_neg_self : perp u (-u) = 0 := by
  simp [perp, hu]

theorem perp_continuous : Continuous (perp u) := by
  unfold perp
  fun_prop

include hu in
/-- Un point de la sphère qui n'est pas un pôle a une composante orthogonale non nulle. -/
theorem perp_ne_zero {x : E} (hx : ‖x‖ = 1) (h1 : x ≠ u) (h2 : x ≠ -u) : perp u x ≠ 0 := by
  intro h
  have hx' : x = inner ℝ u x • u := sub_eq_zero.mp h
  have hn : |inner ℝ u x| = 1 := by
    have := congrArg norm hx'
    rwa [norm_smul, hu, mul_one, hx, Real.norm_eq_abs, eq_comm] at this
  rcases abs_eq (zero_le_one) |>.mp hn with h' | h'
  · exact h1 (by rw [hx', h', one_smul])
  · exact h2 (by rw [hx', h', neg_one_smul])

/-- Le pôle nord `u`. -/
def pole : Sph E := ⟨u, by simp [hu]⟩

/-- Le pôle sud `-u`. -/
def antipole : Sph E := ⟨-u, by simp [hu]⟩

/-- `A = S(E) ∖ {u}`. -/
def capA : Set (Sph E) := {pole hu}ᶜ

/-- `B = S(E) ∖ {-u}`. -/
def capB : Set (Sph E) := {antipole hu}ᶜ

theorem isOpen_capA : IsOpen (capA hu) := isOpen_compl_singleton

theorem isOpen_capB : IsOpen (capB hu) := isOpen_compl_singleton

theorem interior_cover : interior (capA hu) ∪ interior (capB hu) = Set.univ := by
  rw [(isOpen_capA hu).interior_eq, (isOpen_capB hu).interior_eq]
  refine Set.eq_univ_of_forall fun x ↦ ?_
  by_cases hx : x = pole hu
  · refine Or.inr fun h2 ↦ ?_
    have h : u = -u := congrArg Subtype.val (hx.symm.trans h2)
    have hu0 : u ≠ 0 := by rintro rfl; simp at hu
    have h2u : (2 : ℝ) • u = 0 := by
      rw [two_smul]
      nth_rewrite 2 [h]
      exact add_neg_cancel u
    exact hu0 ((smul_eq_zero.mp h2u).resolve_left two_ne_zero)
  · exact Or.inl hx

/-- Calotte contractile, par projection stéréographique depuis `v`. -/
theorem contractible_compl {v : E} (hv : ‖v‖ = 1) :
    ContractibleSpace ↥(({⟨v, by simp [hv]⟩} : Set (Sph E))ᶜ) := by
  have e : ↥(({⟨v, by simp [hv]⟩} : Set (Sph E))ᶜ) ≃ₜ (ℝ ∙ v)ᗮ :=
    (Homeomorph.setCongr (stereographic_source hv).symm).trans
      ((stereographic hv).toHomeomorphSourceTarget.trans
        ((Homeomorph.setCongr (stereographic_target hv)).trans (Homeomorph.Set.univ _)))
  exact e.contractibleSpace

instance : ContractibleSpace (capA hu) := contractible_compl hu

instance : ContractibleSpace (capB hu) := contractible_compl (v := -u) (by rwa [norm_neg])

/-- L'intersection `A ∩ B = S(E) ∖ {u, -u}`. -/
abbrev Inter : Type := ↥(capA hu ∩ capB hu)

/-- Construction d'un point de `A ∩ B` à partir d'un vecteur unitaire non colinéaire à `u`. -/
def mkInter (y : E) (hy : ‖y‖ = 1) (hp : perp u y ≠ 0) : Inter hu :=
  ⟨⟨y, by simp [hy]⟩,
    fun h ↦ hp (by rw [show y = u from congrArg Subtype.val (Set.mem_singleton_iff.mp h),
      perp_self hu]),
    fun h ↦ hp (by rw [show y = -u from congrArg Subtype.val (Set.mem_singleton_iff.mp h),
      perp_neg_self hu])⟩

@[simp] theorem mkInter_val (y : E) (hy : ‖y‖ = 1) (hp : perp u y ≠ 0) :
    ((mkInter hu y hy hp : Sph E) : E) = y := rfl

theorem continuous_mkInter {Z : Type} [TopologicalSpace Z] {g : Z → E} (hg : Continuous g)
    (hy : ∀ z, ‖g z‖ = 1) (hp : ∀ z, perp u (g z) ≠ 0) :
    Continuous fun z ↦ mkInter hu (g z) (hy z) (hp z) :=
  (hg.subtype_mk _).subtype_mk _

theorem norm_inter (x : Inter hu) : ‖((x : Sph E) : E)‖ = 1 :=
  norm_eq_of_mem_sphere (x : Sph E)

theorem perp_inter_ne_zero (x : Inter hu) : perp u ((x : Sph E) : E) ≠ 0 :=
  perp_ne_zero hu (norm_inter hu x)
    (fun h ↦ x.2.1 (Set.mem_singleton_iff.mpr (Subtype.ext h)))
    (fun h ↦ x.2.2 (Set.mem_singleton_iff.mpr (Subtype.ext h)))

theorem norm_normalize {w : E} (hw : w ≠ 0) : ‖‖w‖⁻¹ • w‖ = 1 := by
  rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hw)]

theorem perp_zero : perp u (0 : E) = 0 := by simp [perp]

theorem norm_equator (y : Sph (ℝ ∙ u)ᗮ) : ‖((y : (ℝ ∙ u)ᗮ) : E)‖ = 1 := by
  rw [Submodule.norm_coe]
  exact norm_eq_of_mem_sphere y

theorem perp_equator_ne_zero (y : Sph (ℝ ∙ u)ᗮ) : perp u ((y : (ℝ ∙ u)ᗮ) : E) ≠ 0 := by
  rw [perp_of_mem (y : (ℝ ∙ u)ᗮ).2]
  intro h
  have := norm_equator y
  rw [h, norm_zero] at this
  exact zero_ne_one this

/-- L'inclusion de l'équateur `S(u^⊥) → A ∩ B`. -/
noncomputable def eqIncl : C(Sph (ℝ ∙ u)ᗮ, Inter hu) where
  toFun y := mkInter hu ((y : (ℝ ∙ u)ᗮ) : E) (norm_equator y) (perp_equator_ne_zero y)
  continuous_toFun := continuous_mkInter hu
    (continuous_subtype_val.comp continuous_subtype_val) norm_equator perp_equator_ne_zero

/-- La rétraction `A ∩ B → S(u^⊥)`, `x ↦ perp x / ‖perp x‖`. -/
noncomputable def eqRetr : C(Inter hu, Sph (ℝ ∙ u)ᗮ) where
  toFun x := ⟨⟨‖perp u ((x : Sph E) : E)‖⁻¹ • perp u ((x : Sph E) : E),
      Submodule.smul_mem _ _ (perp_mem hu _)⟩, by
    rw [mem_sphere_zero_iff_norm, Submodule.coe_norm]
    exact norm_normalize (perp_inter_ne_zero hu x)⟩
  continuous_toFun := by
    have hc : Continuous fun x : Inter hu ↦ perp u ((x : Sph E) : E) :=
      perp_continuous.comp (continuous_subtype_val.comp continuous_subtype_val)
    refine ((Continuous.smul (hc.norm.inv₀ fun x ↦ ?_) hc).subtype_mk _).subtype_mk _
    exact norm_ne_zero_iff.mpr (perp_inter_ne_zero hu x)

theorem eqRetr_comp_eqIncl : (eqRetr hu).comp (eqIncl hu) = ContinuousMap.id _ := by
  ext y
  change ‖perp u ((y : (ℝ ∙ u)ᗮ) : E)‖⁻¹ • perp u ((y : (ℝ ∙ u)ᗮ) : E) = ((y : (ℝ ∙ u)ᗮ) : E)
  rw [perp_of_mem (y : (ℝ ∙ u)ᗮ).2, Submodule.norm_coe, norm_eq_of_mem_sphere y, inv_one, one_smul]

/-- Le vecteur `x - (1 - s)⟨u, x⟩u` de la déformation. -/
noncomputable def defVec (s : ℝ) (x : E) : E := x + (-((1 - s) * inner ℝ u x)) • u

include hu in
theorem perp_defVec (s : ℝ) (x : E) : perp u (defVec (u := u) s x) = perp u x :=
  perp_add_smul hu x _

theorem defVec_ne_zero (s : ℝ) (x : Inter hu) : defVec (u := u) s ((x : Sph E) : E) ≠ 0 := by
  intro h
  have := perp_defVec hu s ((x : Sph E) : E)
  rw [h, perp_zero] at this
  exact perp_inter_ne_zero hu x this.symm

theorem perp_normalize_defVec (s : ℝ) (x : Inter hu) :
    perp u (‖defVec (u := u) s ((x : Sph E) : E)‖⁻¹ • defVec (u := u) s ((x : Sph E) : E)) ≠ 0 := by
  rw [perp_smul, perp_defVec hu]
  exact smul_ne_zero (inv_ne_zero (norm_ne_zero_iff.mpr (defVec_ne_zero hu s x)))
    (perp_inter_ne_zero hu x)

/-- La déformation de `A ∩ B` sur l'équateur. -/
noncomputable def eqHomotopy :
    ContinuousMap.Homotopy ((eqIncl hu).comp (eqRetr hu)) (ContinuousMap.id (Inter hu)) where
  toFun p := mkInter hu (‖defVec (u := u) p.1 ((p.2 : Sph E) : E)‖⁻¹ •
      defVec (u := u) p.1 ((p.2 : Sph E) : E))
    (norm_normalize (defVec_ne_zero hu _ p.2)) (perp_normalize_defVec hu _ p.2)
  continuous_toFun := by
    have hx : Continuous fun p : unitInterval × Inter hu ↦ ((p.2 : Sph E) : E) :=
      continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd)
    have hs : Continuous fun p : unitInterval × Inter hu ↦ (p.1 : ℝ) :=
      continuous_subtype_val.comp continuous_fst
    have hw : Continuous fun p : unitInterval × Inter hu ↦ defVec (u := u) p.1 ((p.2 : Sph E) : E) := by
      unfold defVec
      fun_prop
    refine continuous_mkInter hu ((hw.norm.inv₀ fun p ↦ ?_).smul hw) _ _
    exact norm_ne_zero_iff.mpr (defVec_ne_zero hu _ p.2)
  map_zero_left x := by
    refine Subtype.ext (Subtype.ext ?_)
    change ‖defVec (u := u) 0 ((x : Sph E) : E)‖⁻¹ • defVec (u := u) 0 ((x : Sph E) : E) =
      ‖perp u ((x : Sph E) : E)‖⁻¹ • perp u ((x : Sph E) : E)
    simp [defVec, perp, sub_eq_add_neg]
  map_one_left x := by
    refine Subtype.ext (Subtype.ext ?_)
    change ‖defVec (u := u) 1 ((x : Sph E) : E)‖⁻¹ • defVec (u := u) 1 ((x : Sph E) : E) =
      ((x : Sph E) : E)
    simp [defVec, norm_inter hu x]

/-- `A ∩ B` a le type d'homotopie de l'équateur `S(u^⊥)`. -/
noncomputable def eqHomotopyEquiv : ContinuousMap.HomotopyEquiv (Sph (ℝ ∙ u)ᗮ) (Inter hu) where
  toFun := eqIncl hu
  invFun := eqRetr hu
  left_inv := by rw [eqRetr_comp_eqIncl]
  right_inv := ⟨eqHomotopy hu⟩

end Geometry

section Shift

variable (R)

/-- L'homologie réduite en degré `0` : `H̃₀(X) = ker (H₀(X) → H₀(pt))`. -/
noncomputable abbrev Hred0 (X : Type) [TopologicalSpace X] : Submodule R (H R 0 X) :=
  LinearMap.ker (map R 0 (toPt X)).hom

variable {R}

/-- `ker (g ∘ e) ≃ ker g` pour une équivalence `e`. -/
noncomputable def kerCompEquiv {M N P : Type} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
    [Module R M] [Module R N] [Module R P] (e : M ≃ₗ[R] N) (g : N →ₗ[R] P) :
    LinearMap.ker (g ∘ₗ (e : M →ₗ[R] N)) ≃ₗ[R] LinearMap.ker g :=
  e.ofSubmodules _ _ (by rw [LinearMap.ker_comp, Submodule.map_comap_eq_of_surjective e.surjective])

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {u : E} (hu : ‖u‖ = 1)

/-- `H_k(S(u^⊥)) ≅ H_k(A ∩ B)`. -/
noncomputable def interEquiv (k : ℕ) : H R k (Sph (ℝ ∙ u)ᗮ) ≃ₗ[R] H R k (Inter hu) :=
  have : IsIso (map R k (eqIncl hu)) := isIso_map_of_homotopyEquiv k (eqHomotopyEquiv hu)
  (asIso (map R k (eqIncl hu))).toLinearEquiv

/-- `H̃₀(S(u^⊥)) ≅ H̃₀(A ∩ B)`. -/
noncomputable def interRedEquiv : Hred0 R (Sph (ℝ ∙ u)ᗮ) ≃ₗ[R] Hred0 R (Inter hu) :=
  (LinearEquiv.ofEq _ _ (by
    change LinearMap.ker (map R 0 ((toPt (Inter hu)).comp (eqIncl hu))).hom = _
    rw [map_comp]
    rfl)).trans (kerCompEquiv (interEquiv hu 0) (map R 0 (toPt (Inter hu))).hom)

theorem exists_mv : ∃ δ : ∀ n : ℕ, H R (n + 1) (Sph E) ⟶ H R n (Inter hu), ∀ n : ℕ,
      Function.Exact
        (LinearMap.prod
          (map R n (⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ :
            C(Inter hu, capA hu))).hom
          (-(map R n (⟨Set.inclusion Set.inter_subset_right, continuous_inclusion _⟩ :
            C(Inter hu, capB hu))).hom))
        (LinearMap.coprod (map R n (incl (capA hu))).hom (map R n (incl (capB hu))).hom) ∧
      Function.Exact
        (LinearMap.coprod (map R (n + 1) (incl (capA hu))).hom (map R (n + 1) (incl (capB hu))).hom)
        (δ n).hom ∧
      Function.Exact (δ n).hom
        (LinearMap.prod
          (map R n (⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ :
            C(Inter hu, capA hu))).hom
          (-(map R n (⟨Set.inclusion Set.inter_subset_right, continuous_inclusion _⟩ :
            C(Inter hu, capB hu))).hom)) :=
  Hatcher.Singular.mayerVietoris R (Sph E) (capA hu) (capB hu) (interior_cover hu)

include hu in
/-- **Pas de récurrence, `k ≥ 1`** : `H_{k+1}(S(E)) ≅ H_k(S(u^⊥))`. -/
theorem shift_succ {k : ℕ} (hk : k ≠ 0) :
    Nonempty (H R (k + 1) (Sph E) ≃ₗ[R] H R k (Sph (ℝ ∙ u)ᗮ)) := by
  obtain ⟨δ, hδ⟩ := exists_mv (R := R) hu
  have : Subsingleton (H R (k + 1) (capA hu)) := subsingleton_of_contractible k.succ_ne_zero
  have : Subsingleton (H R (k + 1) (capB hu)) := subsingleton_of_contractible k.succ_ne_zero
  have : Subsingleton (H R k (capA hu)) := subsingleton_of_contractible hk
  have : Subsingleton (H R k (capB hu)) := subsingleton_of_contractible hk
  have inj : Function.Injective (δ k).hom := by
    refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
    obtain ⟨p, rfl⟩ := ((hδ k).2.1 x).mp hx
    rw [Subsingleton.elim p 0, map_zero]
  have surj : Function.Surjective (δ k).hom := fun y ↦ ((hδ k).2.2 y).mp (Subsingleton.elim _ _)
  exact ⟨(LinearEquiv.ofBijective (δ k).hom ⟨inj, surj⟩).trans (interEquiv hu k).symm⟩

include hu in
/-- **Pas de récurrence, `k = 0`** : `H_1(S(E)) ≅ H̃₀(S(u^⊥))`. -/
theorem shift_zero : Nonempty (H R 1 (Sph E) ≃ₗ[R] Hred0 R (Sph (ℝ ∙ u)ᗮ)) := by
  obtain ⟨δ, hδ⟩ := exists_mv (R := R) hu
  have : Subsingleton (H R 1 (capA hu)) := subsingleton_of_contractible one_ne_zero
  have : Subsingleton (H R 1 (capB hu)) := subsingleton_of_contractible one_ne_zero
  have inj : Function.Injective (δ 0).hom := by
    refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
    obtain ⟨p, rfl⟩ := ((hδ 0).2.1 x).mp hx
    rw [Subsingleton.elim p 0, map_zero]
  have hA := (bijective_map_toPt (R := R) (X := capA hu) 0).injective
  have hB := (bijective_map_toPt (R := R) (X := capB hu) 0).injective
  have ea : ∀ y, (map R 0 (toPt (Inter hu))).hom y = (map R 0 (toPt (capA hu))).hom
      ((map R 0 (⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ :
        C(Inter hu, capA hu))).hom y) := fun y ↦ by
    rw [show toPt (Inter hu) = (toPt (capA hu)).comp
      ⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ from rfl, map_comp]
    rfl
  have eb : ∀ y, (map R 0 (toPt (Inter hu))).hom y = (map R 0 (toPt (capB hu))).hom
      ((map R 0 (⟨Set.inclusion Set.inter_subset_right, continuous_inclusion _⟩ :
        C(Inter hu, capB hu))).hom y) := fun y ↦ by
    rw [show toPt (Inter hu) = (toPt (capB hu)).comp
      ⟨Set.inclusion Set.inter_subset_right, continuous_inclusion _⟩ from rfl, map_comp]
    rfl
  have hrange : LinearMap.range (δ 0).hom = Hred0 R (Inter hu) := by
    ext y
    rw [LinearMap.mem_range, LinearMap.mem_ker, ← Set.mem_range, ← (hδ 0).2.2 y]
    rw [LinearMap.prod_apply, Prod.ext_iff]
    simp only [Function.prod, Prod.fst_zero, Prod.snd_zero, LinearMap.neg_apply, neg_eq_zero]
    constructor
    · rintro ⟨h, -⟩
      rw [ea, h, map_zero]
    · intro h
      refine ⟨hA ?_, hB ?_⟩
      · rw [← ea, h, map_zero]
      · rw [← eb, h, map_zero]
  exact ⟨((LinearEquiv.ofInjective _ inj).trans (LinearEquiv.ofEq _ _ hrange)).trans
    (interRedEquiv hu).symm⟩

end Shift

section Base

/-- **`ker (∐_{p, q} R → R) ≅ R`** pour un ensemble d'indices à deux éléments. -/
noncomputable def kerSigmaEquiv {Z : Type} [DecidableEq Z] (p q : Z) (hpq : p ≠ q)
    (hZ : ∀ z, z = p ∨ z = q) :
    LinearMap.ker (Sigma.desc (fun _ : Z ↦ 𝟙 (ModuleCat.of R R))).hom ≃ₗ[R] R := by
  let ι := fun z ↦ Sigma.ι (fun _ : Z ↦ ModuleCat.of R R) z
  let σ := Sigma.desc (fun _ : Z ↦ 𝟙 (ModuleCat.of R R))
  let π := fun w ↦ Sigma.desc (fun z : Z ↦ if z = w then 𝟙 (ModuleCat.of R R) else 0)
  have hιπ : ∀ z w, ι z ≫ π w = if z = w then 𝟙 _ else 0 := fun z w ↦ Sigma.ι_desc _ _
  have hισ : ∀ z, ι z ≫ σ = 𝟙 _ := fun z ↦ Sigma.ι_desc _ _
  have hid : π p ≫ ι p + π q ≫ ι q = 𝟙 _ := by
    refine Sigma.hom_ext _ _ fun z ↦ ?_
    rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc, hιπ, hιπ, Category.comp_id]
    rcases hZ z with rfl | rfl
    · rw [if_pos rfl, if_neg hpq, Category.id_comp, zero_comp, add_zero]
    · rw [if_neg hpq.symm, if_pos rfl, Category.id_comp, zero_comp, zero_add]
  have hx : ∀ x, x = (ι p).hom ((π p).hom x) + (ι q).hom ((π q).hom x) := fun x ↦ by
    have := congrArg (fun f ↦ f.hom x) hid
    simpa using this.symm
  have hσι : ∀ z r, σ.hom ((ι z).hom r) = r := fun z r ↦ by
    have := congrArg (fun f ↦ f.hom r) (hισ z)
    simpa using this
  have hπι : ∀ z w r, (π w).hom ((ι z).hom r) = if z = w then r else 0 := fun z w r ↦ by
    have := congrArg (fun f ↦ f.hom r) (hιπ z w)
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
    rw [this]
    split_ifs <;> simp
  exact
    { toFun := fun x ↦ (π p).hom x.1
      map_add' := fun x y ↦ map_add _ _ _
      map_smul' := fun c x ↦ map_smul _ _ _
      invFun := fun r ↦ ⟨(ι p).hom r - (ι q).hom r, by
        rw [LinearMap.mem_ker, map_sub, hσι, hσι, sub_self]⟩
      left_inv := fun x ↦ by
        have h0 : σ.hom x.1 = 0 := x.2
        rw [hx x.1, map_add, hσι, hσι] at h0
        refine Subtype.ext ?_
        change (ι p).hom ((π p).hom x.1) - (ι q).hom ((π p).hom x.1) = x.1
        conv_rhs => rw [hx x.1]
        rw [eq_neg_of_add_eq_zero_right h0, map_neg, sub_eq_add_neg]
      right_inv := fun r ↦ by
        change (π p).hom ((ι p).hom r - (ι q).hom r) = r
        rw [map_sub, hπι, hπι, if_pos rfl, if_neg hpq.symm, sub_zero] }

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {u : E} (hu : ‖u‖ = 1)

include hu in
/-- En dimension `1`, la sphère est `{u, -u}`. -/
theorem sph_eq_or (h1 : Module.finrank ℝ E = 1) (x : Sph E) : x = pole hu ∨ x = antipole hu := by
  have hu0 : u ≠ 0 := by rintro rfl; simp at hu
  have : FiniteDimensional ℝ E := Module.finite_of_finrank_eq_succ h1
  have htop : (ℝ ∙ u) = ⊤ := Submodule.eq_top_of_finrank_eq (by rw [finrank_span_singleton hu0, h1])
  have : (x : E) ∈ (ℝ ∙ u) := htop ▸ Submodule.mem_top
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp this
  have hn : |c| = 1 := by
    have := congrArg norm hc
    rwa [norm_smul, hu, mul_one, norm_eq_of_mem_sphere x, Real.norm_eq_abs] at this
  rcases (abs_eq zero_le_one).mp hn with rfl | rfl
  · exact Or.inl (Subtype.ext (by rw [← hc, one_smul]; rfl))
  · exact Or.inr (Subtype.ext (by rw [← hc, neg_one_smul]; rfl))

theorem pole_ne_antipole : pole hu ≠ antipole hu := by
  intro h
  have h' : u = -u := congrArg Subtype.val h
  have hu0 : u ≠ 0 := by rintro rfl; simp at hu
  have h2u : (2 : ℝ) • u = 0 := by
    rw [two_smul]
    nth_rewrite 2 [h']
    exact add_neg_cancel u
  exact hu0 ((smul_eq_zero.mp h2u).resolve_left two_ne_zero)

include hu in
theorem finite_sph (h1 : Module.finrank ℝ E = 1) : Finite (Sph E) :=
  Finite.of_surjective (fun b : Bool ↦ if b then pole hu else antipole hu) fun x ↦ by
    rcases sph_eq_or hu h1 x with rfl | rfl
    · exact ⟨true, rfl⟩
    · exact ⟨false, rfl⟩

include hu in
theorem totallyDisconnected_sph (h1 : Module.finrank ℝ E = 1) : TotallyDisconnectedSpace (Sph E) :=
  have := finite_sph hu h1
  inferInstance

include hu in
/-- **Base de la récurrence** : `H̃₀(S⁰) ≅ R`. -/
theorem hred0_base (h1 : Module.finrank ℝ E = 1) : Nonempty (Hred0 R (Sph E) ≃ₗ[R] R) := by
  classical
  have := totallyDisconnected_sph hu h1
  let X := TopCat.of (Sph E)
  -- `H̃₀ = ker ε`
  have hε : Hred0 R (Sph E) = LinearMap.ker (eps (R := R) (Sph E)).hom := by
    have hU : Function.Injective (eps (R := R) Unit).hom :=
      ConcreteCategory.injective_of_mono_of_preservesPullback (eps (R := R) Unit)
    ext x
    rw [LinearMap.mem_ker, LinearMap.mem_ker, ← map_eps (R := R) (toPt (Sph E)), ModuleCat.hom_comp,
      LinearMap.comp_apply, ← map_zero (eps (R := R) Unit).hom, hU.eq_iff]
  -- `ε = (H₀ ≅ ∐_{π₀} R) ≫ Σ`
  let e : H R 0 (Sph E) ≃ₗ[R] ↑(∐ fun _ : ZerothHomotopy X ↦ ModuleCat.of R R) :=
    (X.singularHomology₀Iso (ModuleCat.of R R)).toLinearEquiv
  have hε' : (eps (R := R) (Sph E)).hom =
      (Limits.Sigma.desc (fun _ : ZerothHomotopy X ↦ 𝟙 (ModuleCat.of R R))).hom ∘ₗ e.toLinearMap := by
    show (X.singularHomology₀ε (ModuleCat.of R R)).hom = _
    rw [← TopCat.singularHomology₀Iso_sigma_desc_id]
    rfl
  -- les deux composantes par arcs
  let p : ZerothHomotopy X := .mk (pole hu)
  let q : ZerothHomotopy X := .mk (antipole hu)
  have hpq : p ≠ q := by
    intro h
    have h' := congrArg ZerothHomotopy.toConnectedComponents h
    simp only [p, q, ZerothHomotopy.toConnectedComponents_apply] at h'
    have h'' : connectedComponent (pole hu) = connectedComponent (antipole hu) := Quotient.exact h'
    rw [connectedComponent_eq_singleton, connectedComponent_eq_singleton,
      Set.singleton_eq_singleton_iff] at h''
    exact pole_ne_antipole hu h''
  have hZ : ∀ z : ZerothHomotopy X, z = p ∨ z = q := by
    intro z
    induction z with
    | mk x => rcases sph_eq_or hu h1 x with rfl | rfl
              · exact Or.inl rfl
              · exact Or.inr rfl
  exact ⟨((LinearEquiv.ofEq _ _ (hε.trans (by rw [hε']))).trans (kerCompEquiv _ _)).trans
    (kerSigmaEquiv p q hpq hZ)⟩

end Base

section Induction

variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem pathConnected_sph {m : ℕ} (h : Module.finrank ℝ E = m + 2) : PathConnectedSpace (Sph E) := by
  have : FiniteDimensional ℝ E := Module.finite_of_finrank_eq_succ h
  refine isPathConnected_iff_pathConnectedSpace.mp (isPathConnected_sphere ?_ 0 zero_le_one)
  rw [← Module.finrank_eq_rank, h]
  exact_mod_cast (by omega : 1 < m + 2)

theorem hred0_subsingleton {m : ℕ} (h : Module.finrank ℝ E = m + 2) :
    Subsingleton (Hred0 R (Sph E)) := by
  have := pathConnected_sph h
  have inj := injective_map_toPt (R := R) (X := Sph E)
  exact ⟨fun a b ↦ Subtype.ext (inj ((LinearMap.mem_ker.mp a.2).trans (LinearMap.mem_ker.mp b.2).symm))⟩

theorem exists_unit (h : 0 < Module.finrank ℝ E) : ∃ u : E, ‖u‖ = 1 := by
  have := Module.nontrivial_of_finrank_pos h
  obtain ⟨v, hv⟩ := exists_ne (0 : E)
  exact ⟨‖v‖⁻¹ • v, norm_normalize hv⟩

variable (R) in
/-- **Récurrence** sur la dimension `m` de la sphère `S(E)`, `dim E = m + 1`. -/
theorem sphere_claim (m : ℕ) : ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E],
    Module.finrank ℝ E = m + 1 →
      (∀ k, k ≠ 0 → k ≠ m → Subsingleton (H R k (Sph E))) ∧
      (m ≠ 0 → Nonempty (H R m (Sph E) ≃ₗ[R] R)) ∧
      (m = 0 → Nonempty (Hred0 R (Sph E) ≃ₗ[R] R)) ∧
      (m ≠ 0 → Subsingleton (Hred0 R (Sph E))) := by
  induction m with
  | zero =>
    intro E _ _ h1
    obtain ⟨u, hu⟩ := exists_unit (E := E) (by omega)
    have := totallyDisconnected_sph hu h1
    exact ⟨fun k hk _ ↦ subsingleton_of_totallyDisconnected hk, fun h ↦ absurd rfl h,
      fun _ ↦ hred0_base hu h1, fun h ↦ absurd rfl h⟩
  | succ m ih =>
    intro E _ _ h2
    obtain ⟨u, hu⟩ := exists_unit (E := E) (by omega)
    have hu0 : u ≠ 0 := by rintro rfl; simp at hu
    have : Fact (Module.finrank ℝ E = (m + 1) + 1) := ⟨h2⟩
    have : FiniteDimensional ℝ E := Module.finite_of_finrank_eq_succ h2
    have hV : Module.finrank ℝ (ℝ ∙ u)ᗮ = m + 1 := Submodule.finrank_orthogonal_span_singleton hu0
    obtain ⟨ihZ, ihT, ihB, ihP⟩ := ih (ℝ ∙ u)ᗮ hV
    refine ⟨fun k hk hkm ↦ ?_, fun _ ↦ ?_, fun h ↦ absurd h (Nat.succ_ne_zero m),
      fun _ ↦ hred0_subsingleton (m := m) h2⟩
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk
      rcases Nat.eq_zero_or_pos j with rfl | hj
      · have := ihP (by omega)
        obtain ⟨e⟩ := shift_zero (R := R) hu
        exact e.toEquiv.subsingleton
      · have := ihZ j (by omega) (by omega)
        obtain ⟨e⟩ := shift_succ (R := R) hu (k := j) (by omega)
        exact e.toEquiv.subsingleton
    · rcases Nat.eq_zero_or_pos m with rfl | hm
      · obtain ⟨e⟩ := shift_zero (R := R) hu
        obtain ⟨e'⟩ := ihB rfl
        exact ⟨e.trans e'⟩
      · obtain ⟨e⟩ := shift_succ (R := R) hu (k := m) (by omega)
        obtain ⟨e'⟩ := ihT (by omega)
        exact ⟨e.trans e'⟩

end Induction

/-- **Homologie des sphères** (Hatcher, Corollaire 2.14). -/
theorem sphere_homology_proof (R : Type) [Ring R] (n : ℕ) :
    (∀ k : ℕ, k ≠ 0 → k ≠ n →
      IsZero (H R k (Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1))) ∧
    (n ≠ 0 → Nonempty
      (H R n (Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1) ≅ ModuleCat.of R R)) ∧
    (n ≠ 0 → Nonempty
      (H R 0 (Metric.sphere (0 : EuclideanSpace ℝ (Fin (n + 1))) 1) ≅ ModuleCat.of R R)) := by
  have hE : Module.finrank ℝ (EuclideanSpace ℝ (Fin (n + 1))) = n + 1 := finrank_euclideanSpace_fin
  obtain ⟨hZ, hT, -, -⟩ := sphere_claim R n (EuclideanSpace ℝ (Fin (n + 1))) hE
  refine ⟨fun k hk hkn ↦ ?_, fun hn ↦ ?_, fun hn ↦ ?_⟩
  · have := hZ k hk hkn
    exact ModuleCat.isZero_of_subsingleton _
  · obtain ⟨e⟩ := hT hn
    exact ⟨e.toModuleIso⟩
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
    have := pathConnected_sph (E := EuclideanSpace ℝ (Fin (m + 1 + 1))) (m := m) hE
    exact ⟨asIso (eps (R := R) (Sph (EuclideanSpace ℝ (Fin (m + 1 + 1)))))⟩


end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/CPTopology.lean` -/

section

/-!
# Topologie quotient de `ℂPⁿ` (A3, A5b)

Extrait de `ComplexProjective.lean`, sans homologie, pour servir aussi à A5b
(`Bridge/Betti/ComplexPointsProj.lean`) :
* `q : ℂⁿ⁺¹ ∖ {0} → ℂPⁿ` est une application quotient ouverte ; ses restrictions aux ouverts, et
  leurs produits avec un espace quelconque, sont des applications quotient. Une application définie
  sur un ouvert de `ℂPⁿ` (ou sur `Z × ouvert`) est continue dès que son relèvement l'est.
* Coordonnées `init'`, `last'`, `snoc'` de `ℂⁿ⁺²` et représentants (`rep_mk`).
-/

open scoped LinearAlgebra.Projectivization

namespace Hatcher.Singular

section Quot

/-- `ℂⁿ⁺¹`. -/
abbrev Vec (n : ℕ) : Type := Fin (n + 1) → ℂ

/-- `ℂⁿ⁺¹ ∖ {0}`. -/
abbrev NZ (n : ℕ) : Type := {v : Vec n // v ≠ 0}

variable {n : ℕ}

/-- La projection `ℂⁿ⁺¹ ∖ {0} → ℂPⁿ`. -/
noncomputable def q (v : NZ n) : CP n := Projectivization.mk ℂ v.1 v.2

theorem isQuotientMap_q : Topology.IsQuotientMap (q (n := n)) := isQuotientMap_quotient_mk'

theorem continuous_q : Continuous (q (n := n)) := isQuotientMap_q.continuous

theorem surjective_q : Function.Surjective (q (n := n)) := isQuotientMap_q.surjective

/-- L'action de `c ∈ ℂ^×` sur `ℂⁿ⁺¹ ∖ {0}`. -/
def smulNZ (c : ℂˣ) (v : NZ n) : NZ n := ⟨c • v.1, (smul_ne_zero_iff_ne c).mpr v.2⟩

theorem continuous_smulNZ (c : ℂˣ) : Continuous (smulNZ (n := n) c) :=
  ((continuous_const_smul c).comp continuous_subtype_val).subtype_mk _

/-- `ℂⁿ⁺¹ ∖ {0} → ℂPⁿ` est ouverte. -/
theorem isOpenMap_q : IsOpenMap (q (n := n)) := by
  intro O hO
  rw [← isQuotientMap_q.isOpen_preimage]
  have : q ⁻¹' (q '' O) = ⋃ c : ℂˣ, smulNZ c ⁻¹' O := by
    ext w
    simp only [Set.mem_preimage, Set.mem_image, Set.mem_iUnion]
    constructor
    · rintro ⟨v, hv, hvw⟩
      obtain ⟨c, hc⟩ := (Projectivization.mk_eq_mk_iff ℂ _ _ v.2 w.2).mp hvw
      exact ⟨c, by rwa [show smulNZ c w = v from Subtype.ext hc]⟩
    · rintro ⟨c, hc⟩
      exact ⟨_, hc, (Projectivization.mk_eq_mk_iff ℂ _ _ _ w.2).mpr ⟨c, rfl⟩⟩
  rw [this]
  exact isOpen_iUnion fun c ↦ hO.preimage (continuous_smulNZ c)

/-- **Continuité par relèvement** sur `Z × Ω`, `Ω ⊆ ℂPⁿ` (l'ouverture de `q` suffit). -/
theorem continuous_of_lift {Ω : Set (CP n)} {Z Y : Type} [TopologicalSpace Z]
    [TopologicalSpace Y] (F : Z × Ω → Y)
    (hF : Continuous fun p : Z × (q ⁻¹' Ω) ↦ F (p.1, ⟨q p.2, p.2.2⟩)) : Continuous F := by
  have hφ : Topology.IsQuotientMap (Prod.map id (Ω.restrictPreimage (q (n := n))) :
      Z × (q ⁻¹' Ω) → Z × Ω) :=
    (IsOpenMap.id.prodMap (isOpenMap_q.restrictPreimage Ω)).isQuotientMap
      (continuous_id.prodMap continuous_q.restrictPreimage)
      (Function.surjective_id.prodMap (Set.restrictPreimage_surjective _ surjective_q))
  exact hφ.continuous_iff.mpr hF

theorem isOpen_of_preimage {Ω : Set (CP n)} (h : IsOpen (q ⁻¹' Ω)) : IsOpen Ω :=
  isQuotientMap_q.isOpen_preimage.mp h

/-- Un point de référence de `ℂPⁿ`. -/
noncomputable def basePt (n : ℕ) : CP n :=
  Projectivization.mk ℂ (Pi.single 0 1) (by simp)

/-- `mkD w = [w]` si `w ≠ 0`, et un point fixé sinon. -/
noncomputable def mkD (w : Vec n) : CP n :=
  if h : w ≠ 0 then Projectivization.mk ℂ w h else basePt n

theorem mkD_of_ne {w : Vec n} (h : w ≠ 0) : mkD w = Projectivization.mk ℂ w h := dif_pos h

theorem mkD_smul (c : ℂˣ) (w : Vec n) : mkD (c • w) = mkD w := by
  by_cases h : w = 0
  · rw [h, smul_zero]
  · rw [mkD_of_ne h, mkD_of_ne ((smul_ne_zero_iff_ne c).mpr h)]
    exact (Projectivization.mk_eq_mk_iff ℂ _ _ _ h).mpr ⟨c, rfl⟩

theorem q_eq_mkD (v : NZ n) : q v = mkD v.1 := (mkD_of_ne v.2).symm

/-- Une fonction de `p ∈ ℂPⁿ` définie par un représentant. -/
noncomputable def liftInv {Z Y : Type} (G : Z → Vec n → Y) (p : Z × CP n) : Y :=
  G p.1 p.2.rep

theorem liftInv_mk {Z Y : Type} {G : Z → Vec n → Y} (hG : ∀ z (c : ℂˣ) v, G z (c • v) = G z v)
    (z : Z) (v : Vec n) (hv : v ≠ 0) : liftInv G (z, Projectivization.mk ℂ v hv) = G z v := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep ℂ v hv
  rw [liftInv, ← hc, hG]

theorem continuous_liftInv {Ω : Set (CP n)} {Z Y : Type} [TopologicalSpace Z]
    [TopologicalSpace Y] {G : Z → Vec n → Y} (hG : ∀ z (c : ℂˣ) v, G z (c • v) = G z v)
    (hc : Continuous fun p : Z × (q ⁻¹' Ω) ↦ G p.1 p.2.1.1) :
    Continuous fun p : Z × Ω ↦ liftInv G (p.1, (p.2 : CP n)) := by
  refine continuous_of_lift _ ?_
  convert hc using 2 with p
  exact liftInv_mk hG _ _ _

/-- `mkD ∘ f` est continue là où `f` ne s'annule pas. -/
theorem continuous_mkD_comp {Z : Type} [TopologicalSpace Z] {f : Z → Vec n} (hf : Continuous f)
    (hne : ∀ z, f z ≠ 0) : Continuous fun z ↦ mkD (f z) := by
  have : (fun z ↦ mkD (f z)) = fun z ↦ q ⟨f z, hne z⟩ := funext fun z ↦ (q_eq_mkD ⟨f z, hne z⟩).symm
  rw [this]
  exact continuous_q.comp (hf.subtype_mk _)

end Quot

section Coords

variable {m : ℕ}

/-- `(z_0, …, z_m)`. -/
def init' (z : Vec (m + 1)) : Vec m := Fin.init z

/-- `z_{m+1}`. -/
def last' (z : Vec (m + 1)) : ℂ := z (Fin.last (m + 1))

/-- `(w, c)`. -/
def snoc' (w : Vec m) (c : ℂ) : Vec (m + 1) := Fin.snoc (α := fun _ ↦ ℂ) w c

@[simp] theorem init'_snoc' (w : Vec m) (c : ℂ) : init' (snoc' w c) = w := Fin.init_snoc _ _

@[simp] theorem last'_snoc' (w : Vec m) (c : ℂ) : last' (snoc' w c) = c := by
  simp [last', snoc']

@[simp] theorem snoc'_init'_last' (z : Vec (m + 1)) : snoc' (init' z) (last' z) = z :=
  Fin.snoc_init_self _

@[simp] theorem init'_smul (c : ℂ) (z : Vec (m + 1)) : init' (c • z) = c • init' z := rfl

@[simp] theorem last'_smul (c : ℂ) (z : Vec (m + 1)) : last' (c • z) = c * last' z := rfl

theorem snoc'_smul (c : ℂ) (w : Vec m) (a : ℂ) : snoc' (c • w) (c * a) = c • snoc' w a := by
  funext i
  refine Fin.lastCases ?_ (fun j ↦ ?_) i <;> simp [snoc']

theorem snoc'_eq_zero {w : Vec m} {c : ℂ} : snoc' w c = 0 ↔ w = 0 ∧ c = 0 := by
  constructor
  · intro h
    exact ⟨by rw [← init'_snoc' w c, h]; rfl, by rw [← last'_snoc' w c, h]; rfl⟩
  · rintro ⟨rfl, rfl⟩
    funext i
    refine Fin.lastCases ?_ (fun j ↦ ?_) i <;> simp [snoc']

theorem continuous_init' : Continuous (init' (m := m)) :=
  continuous_pi fun _ ↦ continuous_apply _

theorem continuous_last' : Continuous (last' (m := m)) := continuous_apply _

theorem continuous_snoc' {Z : Type} [TopologicalSpace Z] {f : Z → Vec m} {g : Z → ℂ}
    (hf : Continuous f) (hg : Continuous g) : Continuous fun z ↦ snoc' (f z) (g z) :=
  Continuous.finSnoc hf hg

theorem rep_mk (v : Vec m) (hv : v ≠ 0) :
    ∃ c : ℂˣ, (Projectivization.mk ℂ v hv).rep = c • v := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep ℂ v hv
  exact ⟨c, hc.symm⟩

end Coords

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/ComplexProjective.lean` -/

section

/-!
# Homologie de `ℂPⁿ` (A3 ; Hatcher, §2.2, Théorème 2.35 et application (iii), p. 140)

* **Corollaires de Mayer–Vietoris** pour un recouvrement `X = A ∪ B` avec `A` contractile :
  `H_{j+1}(X) ≅ H_{j+1}(B)` (`mv_equiv_B`) et `H_{j+1}(X) ≅ H_j(A ∩ B)` (`mv_equiv_I`), sous des
  hypothèses d'annulation.
* **Topologie quotient** : `ℂⁿ⁺¹ ∖ {0} → ℂPⁿ` est ouverte, donc ses restrictions aux ouverts, et
  leurs produits avec un espace quelconque, sont des applications quotient. Les applications
  définies sur un ouvert de `ℂPⁿ` (ou sur `I × ouvert`) sont continues dès que leur relèvement
  l'est.
* **Géométrie de `ℂPⁿ⁺¹`** : `U = {z_{n+1} ≠ 0}` est contractile ; `V = {(z_0, …, z_n) ≠ 0}` se
  rétracte par déformation sur `ℂPⁿ` ; `U ∩ V` a le type d'homotopie de la sphère `S^{2n+1}` de
  `ℂⁿ⁺¹`.
* **Récurrence** sur `n` par Mayer–Vietoris, avec A2 pour `S^{2n+1}`.
-/

open CategoryTheory Limits AlgebraicTopology
open scoped LinearAlgebra.Projectivization

namespace Hatcher.Singular

variable {R : Type} [Ring R]

section MV

variable {X : Type} [TopologicalSpace X] {A B : Set X}

/-- `M × N ≃ N` si `M` est trivial. -/
def prodSubsingletonEquiv {M N : Type} [AddCommGroup M] [AddCommGroup N] [Module R M] [Module R N]
    [Subsingleton M] : (M × N) ≃ₗ[R] N where
  toFun p := p.2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  invFun n := (0, n)
  left_inv _ := Prod.ext (Subsingleton.elim _ _) rfl
  right_inv _ := rfl

/-- **Mayer–Vietoris, `A` contractible** : `H_{j+1}(X) ≅ H_{j+1}(B)` si `H_{j+1}(A ∩ B) → H_{j+1}(B)`
est nulle et si le bord `H_{j+1}(X) → H_j(A ∩ B)` est nul. -/
theorem mv_equiv_B [ContractibleSpace A] (hAB : interior A ∪ interior B = Set.univ) (j : ℕ)
    (hprod : Subsingleton (H R (j + 1) ↥(A ∩ B)) ∨ Subsingleton (H R (j + 1) B))
    (hinj : Subsingleton (H R j ↥(A ∩ B)) ∨ (j = 0 ∧ Subsingleton (Hred0 R ↥(A ∩ B)))) :
    Nonempty (H R (j + 1) X ≃ₗ[R] H R (j + 1) B) := by
  obtain ⟨δ, hδ⟩ := Hatcher.Singular.mayerVietoris R X A B hAB
  have : Subsingleton (H R (j + 1) A) := subsingleton_of_contractible j.succ_ne_zero
  have inj : Function.Injective
      (LinearMap.coprod (map R (j + 1) (incl A)).hom (map R (j + 1) (incl B)).hom) := by
    refine (injective_iff_map_eq_zero _).mpr fun p hp ↦ ?_
    obtain ⟨y, rfl⟩ := ((hδ (j + 1)).1 p).mp hp
    rcases hprod with h | h
    · rw [Subsingleton.elim y 0, map_zero]
    · exact Subsingleton.elim _ _
  have surj : Function.Surjective
      (LinearMap.coprod (map R (j + 1) (incl A)).hom (map R (j + 1) (incl B)).hom) := by
    intro x
    refine ((hδ j).2.1 x).mp ?_
    rcases hinj with h | ⟨rfl, h⟩
    · exact Subsingleton.elim _ _
    · have hy : (δ 0).hom x ∈ Hred0 R ↥(A ∩ B) := by
        have h0 := ((hδ 0).2.2 ((δ 0).hom x)).mpr ⟨x, rfl⟩
        rw [LinearMap.prod_apply, Prod.ext_iff] at h0
        have h1 : (map R 0 (⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ :
            C(↥(A ∩ B), A))).hom ((δ 0).hom x) = 0 := h0.1
        rw [LinearMap.mem_ker, show toPt ↥(A ∩ B) = (toPt A).comp
          ⟨Set.inclusion Set.inter_subset_left, continuous_inclusion _⟩ from rfl, map_comp,
          ModuleCat.hom_comp, LinearMap.comp_apply, h1, map_zero]
      exact congrArg Subtype.val (Subsingleton.elim (⟨_, hy⟩ : Hred0 R ↥(A ∩ B)) 0)
  exact ⟨(LinearEquiv.ofBijective _ ⟨inj, surj⟩).symm.trans prodSubsingletonEquiv⟩

/-- **Mayer–Vietoris, `A` contractible** : `H_{j+1}(X) ≅ H_j(A ∩ B)` si `j ≥ 1` et
`H_{j+1}(B) = H_j(B) = 0`. -/
theorem mv_equiv_I [ContractibleSpace A] (hAB : interior A ∪ interior B = Set.univ) {j : ℕ}
    (hj : j ≠ 0) (hB1 : Subsingleton (H R (j + 1) B)) (hBj : Subsingleton (H R j B)) :
    Nonempty (H R (j + 1) X ≃ₗ[R] H R j ↥(A ∩ B)) := by
  obtain ⟨δ, hδ⟩ := Hatcher.Singular.mayerVietoris R X A B hAB
  have : Subsingleton (H R (j + 1) A) := subsingleton_of_contractible j.succ_ne_zero
  have : Subsingleton (H R j A) := subsingleton_of_contractible hj
  have inj : Function.Injective (δ j).hom := by
    refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
    obtain ⟨p, rfl⟩ := ((hδ j).2.1 x).mp hx
    rw [Subsingleton.elim p 0, map_zero]
  have surj : Function.Surjective (δ j).hom := fun y ↦ ((hδ j).2.2 y).mp (Subsingleton.elim _ _)
  exact ⟨LinearEquiv.ofBijective (δ j).hom ⟨inj, surj⟩⟩

end MV

section Charts

variable {m : ℕ}

/-- `U = {z_{m+1} ≠ 0} ⊆ ℂP^{m+1}`. -/
def setU (m : ℕ) : Set (CP (m + 1)) := {p | last' p.rep ≠ 0}

/-- `V = {(z_0, …, z_m) ≠ 0} ⊆ ℂP^{m+1}`. -/
def setV (m : ℕ) : Set (CP (m + 1)) := {p | init' p.rep ≠ 0}

theorem mk_mem_setU (v : Vec (m + 1)) (hv : v ≠ 0) :
    Projectivization.mk ℂ v hv ∈ setU m ↔ last' v ≠ 0 := by
  obtain ⟨c, hc⟩ := rep_mk v hv
  simp only [setU, Set.mem_ofPred_eq, hc, Units.smul_def, last'_smul, ne_eq, mul_eq_zero,
    c.ne_zero, false_or]

theorem mk_mem_setV (v : Vec (m + 1)) (hv : v ≠ 0) :
    Projectivization.mk ℂ v hv ∈ setV m ↔ init' v ≠ 0 := by
  obtain ⟨c, hc⟩ := rep_mk v hv
  simp only [setV, Set.mem_ofPred_eq, hc, Units.smul_def, init'_smul, ne_eq,
    smul_eq_zero, c.ne_zero, false_or]

theorem isOpen_setU : IsOpen (setU m) := by
  refine isOpen_of_preimage ?_
  have : q ⁻¹' setU m = {v : NZ (m + 1) | last' v.1 ≠ 0} := by
    ext v; exact mk_mem_setU v.1 v.2
  rw [this]
  exact isOpen_compl_singleton.preimage (continuous_last'.comp continuous_subtype_val)

theorem isOpen_setV : IsOpen (setV m) := by
  refine isOpen_of_preimage ?_
  have : q ⁻¹' setV m = {v : NZ (m + 1) | init' v.1 ≠ 0} := by
    ext v; exact mk_mem_setV v.1 v.2
  rw [this]
  exact isOpen_compl_singleton.preimage (continuous_init'.comp continuous_subtype_val)

theorem cover_UV : interior (setU m) ∪ interior (setV m) = Set.univ := by
  rw [isOpen_setU.interior_eq, isOpen_setV.interior_eq]
  refine Set.eq_univ_of_forall fun p ↦ ?_
  induction p using Projectivization.ind with
  | h v hv =>
    by_cases hl : last' v = 0
    · refine Or.inr ((mk_mem_setV v hv).mpr fun hi ↦ hv ?_)
      rw [← snoc'_init'_last' v, hi, hl]
      exact snoc'_eq_zero.mpr ⟨rfl, rfl⟩
    · exact Or.inl ((mk_mem_setU v hv).mpr hl)

theorem last'_ne_of_mem {v : NZ (m + 1)} (h : q v ∈ setU m) : last' v.1 ≠ 0 :=
  (mk_mem_setU v.1 v.2).mp h

theorem init'_ne_of_mem {v : NZ (m + 1)} (h : q v ∈ setV m) : init' v.1 ≠ 0 :=
  (mk_mem_setV v.1 v.2).mp h

/-! ### `U` est contractile -/

/-- `(t, z) ↦ [(1 - t)(z_0, …, z_m), z_{m+1}]`. -/
noncomputable def contrU (t : unitInterval) (z : Vec (m + 1)) : CP (m + 1) :=
  mkD (snoc' (((1 : ℂ) - (t : ℝ)) • init' z) (last' z))

theorem contrU_smul (t : unitInterval) (c : ℂˣ) (z : Vec (m + 1)) :
    contrU t (c • z) = contrU t z := by
  rw [contrU, contrU, Units.smul_def, init'_smul, last'_smul, smul_comm, snoc'_smul, ← Units.smul_def,
    mkD_smul]

theorem contrU_mk (t : unitInterval) (v : Vec (m + 1)) (hv : last' v ≠ 0) :
    contrU t v = Projectivization.mk ℂ (snoc' (((1 : ℂ) - (t : ℝ)) • init' v) (last' v))
      (fun h ↦ hv (snoc'_eq_zero.mp h).2) :=
  mkD_of_ne _

theorem contrU_mem (t : unitInterval) (p : setU m) : liftInv contrU (t, (p : CP (m + 1))) ∈ setU m := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    have hl := (mk_mem_setU v hv).mp hp
    rw [liftInv_mk contrU_smul, contrU_mk t v hl, mk_mem_setU, last'_snoc']
    exact hl

/-- La contraction de `U` sur le point `[0 : … : 0 : 1]`. -/
noncomputable def contrHomotopy : ContinuousMap.Homotopy (ContinuousMap.id (setU m))
    (ContinuousMap.const (setU m) ⟨Projectivization.mk ℂ (snoc' 0 1)
      (fun h ↦ one_ne_zero (snoc'_eq_zero.mp h).2), (mk_mem_setU _ _).mpr (by simp)⟩) where
  toFun p := ⟨liftInv contrU (p.1, (p.2 : CP (m + 1))), contrU_mem p.1 p.2⟩
  continuous_toFun := by
    refine (continuous_liftInv contrU_smul ?_).subtype_mk _
    refine continuous_mkD_comp (continuous_snoc' ?_ ?_) fun p ↦ ?_
    · exact ((continuous_const.sub (Complex.continuous_ofReal.comp
        (continuous_subtype_val.comp continuous_fst))).smul
        (continuous_init'.comp (continuous_subtype_val.comp (continuous_subtype_val.comp
          continuous_snd))))
    · exact continuous_last'.comp (continuous_subtype_val.comp (continuous_subtype_val.comp
        continuous_snd))
    · exact fun h ↦ last'_ne_of_mem p.2.2 (snoc'_eq_zero.mp h).2
  map_zero_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      have hl := (mk_mem_setU v hv).mp hp
      change liftInv contrU ((0 : unitInterval), Projectivization.mk ℂ v hv) = _
      rw [liftInv_mk contrU_smul, contrU_mk 0 v hl]
      simp
  map_one_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      have hl := (mk_mem_setU v hv).mp hp
      change liftInv contrU ((1 : unitInterval), Projectivization.mk ℂ v hv) = _
      rw [liftInv_mk contrU_smul, contrU_mk 1 v hl]
      refine (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr ⟨last' v, ?_⟩
      rw [← snoc'_smul, smul_zero, mul_one]
      simp

instance contractible_setU : ContractibleSpace (setU m) := by
  have : Nonempty (setU m) := ⟨⟨Projectivization.mk ℂ (snoc' 0 1)
      (fun h ↦ one_ne_zero (snoc'_eq_zero.mp h).2), (mk_mem_setU _ _).mpr (by simp)⟩⟩
  exact (contractible_iff_id_nullhomotopic _).mpr ⟨_, ⟨contrHomotopy⟩⟩

/-! ### `V` se rétracte sur `ℂPᵐ` -/

theorem continuous_liftInv_univ {n : ℕ} {Y : Type} [TopologicalSpace Y] {G : Unit → Vec n → Y}
    (hG : ∀ z (c : ℂˣ) v, G z (c • v) = G z v) (hc : Continuous fun v : NZ n ↦ G () v.1) :
    Continuous fun p : CP n ↦ liftInv G ((), p) := by
  refine isQuotientMap_q.continuous_iff.mpr ?_
  convert hc using 1
  funext v
  exact liftInv_mk hG () v.1 v.2

/-- `w ↦ (w, 0)`. -/
noncomputable def inclG (_ : Unit) (w : Vec m) : CP (m + 1) := mkD (snoc' w 0)

theorem inclG_smul (z : Unit) (c : ℂˣ) (w : Vec m) : inclG z (c • w) = inclG z w := by
  rw [inclG, inclG, Units.smul_def,
    show snoc' ((c : ℂ) • w) 0 = (c : ℂ) • snoc' w 0 by rw [← snoc'_smul, mul_zero],
    ← Units.smul_def, mkD_smul]

theorem inclG_mem (p : CP m) : liftInv inclG ((), p) ∈ setV m := by
  induction p using Projectivization.ind with
  | h w hw =>
    rw [liftInv_mk inclG_smul, inclG, mkD_of_ne (fun h ↦ hw (snoc'_eq_zero.mp h).1), mk_mem_setV,
      init'_snoc']
    exact hw

/-- L'inclusion `ℂPᵐ → V`, `[w] ↦ [w : 0]`. -/
noncomputable def inclV : C(CP m, setV m) where
  toFun p := ⟨liftInv inclG ((), p), inclG_mem p⟩
  continuous_toFun := by
    refine (continuous_liftInv_univ inclG_smul ?_).subtype_mk _
    exact continuous_mkD_comp (continuous_snoc' continuous_subtype_val continuous_const)
      fun v h ↦ v.2 (snoc'_eq_zero.mp h).1

/-- `z ↦ (z_0, …, z_m)`. -/
noncomputable def retrG (_ : Unit) (z : Vec (m + 1)) : CP m := mkD (init' z)

theorem retrG_smul (z : Unit) (c : ℂˣ) (v : Vec (m + 1)) : retrG z (c • v) = retrG z v := by
  rw [retrG, retrG, Units.smul_def, init'_smul, ← Units.smul_def, mkD_smul]

/-- La rétraction `V → ℂPᵐ`, `[z] ↦ [z_0 : … : z_m]`. -/
noncomputable def retrV : C(setV m, CP m) where
  toFun p := liftInv retrG ((), (p : CP (m + 1)))
  continuous_toFun := by
    have h := continuous_liftInv (Ω := setV m) retrG_smul
      (continuous_mkD_comp (continuous_init'.comp (continuous_subtype_val.comp
        (continuous_subtype_val.comp continuous_snd))) fun p ↦ init'_ne_of_mem p.2.2)
    exact h.comp (continuous_const.prodMk continuous_id)

theorem retrV_inclV : retrV.comp inclV = ContinuousMap.id (CP m) := by
  ext p
  induction p using Projectivization.ind with
  | h w hw =>
    change liftInv retrG ((), liftInv inclG ((), Projectivization.mk ℂ w hw)) = _
    rw [liftInv_mk inclG_smul, inclG, mkD_of_ne (fun h ↦ hw (snoc'_eq_zero.mp h).1),
      liftInv_mk retrG_smul, retrG, init'_snoc', mkD_of_ne hw]
    rfl

/-- `(t, z) ↦ [z_0 : … : z_m : t z_{m+1}]`. -/
noncomputable def defV (t : unitInterval) (z : Vec (m + 1)) : CP (m + 1) :=
  mkD (snoc' (init' z) (((t : ℝ) : ℂ) * last' z))

theorem defV_smul (t : unitInterval) (c : ℂˣ) (z : Vec (m + 1)) : defV t (c • z) = defV t z := by
  rw [defV, defV, Units.smul_def, init'_smul, last'_smul, mul_left_comm, snoc'_smul,
    ← Units.smul_def, mkD_smul]

theorem defV_mk (t : unitInterval) (v : Vec (m + 1)) (hv : init' v ≠ 0) :
    defV t v = Projectivization.mk ℂ (snoc' (init' v) (((t : ℝ) : ℂ) * last' v))
      (fun h ↦ hv (snoc'_eq_zero.mp h).1) :=
  mkD_of_ne _

theorem defV_mem (t : unitInterval) (p : setV m) : liftInv defV (t, (p : CP (m + 1))) ∈ setV m := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    have hi := (mk_mem_setV v hv).mp hp
    rw [liftInv_mk defV_smul, defV_mk t v hi, mk_mem_setV, init'_snoc']
    exact hi

/-- La déformation de `V` sur `ℂPᵐ`. -/
noncomputable def defVHomotopy :
    ContinuousMap.Homotopy ((inclV (m := m)).comp retrV) (ContinuousMap.id (setV m)) where
  toFun p := ⟨liftInv defV (p.1, (p.2 : CP (m + 1))), defV_mem p.1 p.2⟩
  continuous_toFun := by
    refine (continuous_liftInv defV_smul ?_).subtype_mk _
    have hz : Continuous fun p : unitInterval × (q ⁻¹' setV m) ↦ p.2.1.1 :=
      continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd)
    refine continuous_mkD_comp (continuous_snoc' (continuous_init'.comp hz) ?_) fun p h ↦
      init'_ne_of_mem p.2.2 (snoc'_eq_zero.mp h).1
    exact (Complex.continuous_ofReal.comp (continuous_subtype_val.comp continuous_fst)).mul
      (continuous_last'.comp hz)
  map_zero_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      have hi := (mk_mem_setV v hv).mp hp
      change liftInv defV ((0 : unitInterval), Projectivization.mk ℂ v hv) =
        liftInv inclG ((), liftInv retrG ((), Projectivization.mk ℂ v hv))
      rw [liftInv_mk defV_smul, liftInv_mk retrG_smul, retrG, mkD_of_ne hi, liftInv_mk inclG_smul,
        inclG, defV_mk 0 v hi]
      simp [mkD_of_ne (fun h ↦ hi (snoc'_eq_zero.mp h).1)]
  map_one_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      have hi := (mk_mem_setV v hv).mp hp
      change liftInv defV ((1 : unitInterval), Projectivization.mk ℂ v hv) = _
      rw [liftInv_mk defV_smul, defV_mk 1 v hi]
      simp

/-- `V` a le type d'homotopie de `ℂPᵐ`. -/
noncomputable def setVHomotopyEquiv : ContinuousMap.HomotopyEquiv (CP m) (setV m) where
  toFun := inclV
  invFun := retrV
  left_inv := by rw [retrV_inclV]
  right_inv := ⟨defVHomotopy⟩

/-! ### `U ∩ V` a le type d'homotopie de `S^{2m+1}` -/

attribute [local instance] InnerProductSpace.complexToReal

/-- `ℂ^{m+1}` euclidien, dont la sphère unité est `S^{2m+1}`. -/
abbrev ES (m : ℕ) : Type := EuclideanSpace ℂ (Fin (m + 1))

/-- `U ∩ V`. -/
abbrev UV (m : ℕ) : Type := ↥(setU m ∩ setV m)

/-- La carte affine `z ↦ (z_0, …, z_m) / z_{m+1}`. -/
noncomputable def affC (z : Vec (m + 1)) : ES m := WithLp.toLp 2 ((last' z)⁻¹ • init' z)

theorem affC_smul (c : ℂˣ) (z : Vec (m + 1)) : affC (c • z) = affC z := by
  rw [affC, affC, Units.smul_def, init'_smul, last'_smul, smul_smul, mul_inv_rev, mul_assoc,
    inv_mul_cancel₀ c.ne_zero, mul_one]

theorem affC_ne_zero {z : Vec (m + 1)} (hl : last' z ≠ 0) (hi : init' z ≠ 0) : affC z ≠ 0 := by
  rw [affC, Ne, WithLp.toLp_eq_zero, smul_eq_zero, not_or]
  exact ⟨inv_ne_zero hl, hi⟩

/-- La normalisation `x ↦ x / ‖x‖` dans `ℂ^{m+1}`. -/
noncomputable def nrm (x : ES m) : ES m := (((‖x‖⁻¹ : ℝ) : ℂ)) • x

theorem norm_nrm {x : ES m} (hx : x ≠ 0) : ‖nrm x‖ = 1 := by
  rw [nrm, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_norm,
    inv_mul_cancel₀ (norm_ne_zero_iff.mpr hx)]

/-- `ρ : U ∩ V → S^{2m+1}` sur les représentants. -/
noncomputable def rhoG (_ : Unit) (z : Vec (m + 1)) : ES m := nrm (affC z)

theorem rhoG_smul (u : Unit) (c : ℂˣ) (z : Vec (m + 1)) : rhoG u (c • z) = rhoG u z := by
  rw [rhoG, rhoG, affC_smul]

theorem mem_UV_mk {v : Vec (m + 1)} {hv : v ≠ 0} (h : Projectivization.mk ℂ v hv ∈ setU m ∩ setV m) :
    last' v ≠ 0 ∧ init' v ≠ 0 :=
  ⟨(mk_mem_setU v hv).mp h.1, (mk_mem_setV v hv).mp h.2⟩

theorem rhoG_mem (p : UV m) : liftInv rhoG ((), (p : CP (m + 1))) ∈ Metric.sphere (0 : ES m) 1 := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    obtain ⟨hl, hi⟩ := mem_UV_mk hp
    rw [liftInv_mk rhoG_smul, mem_sphere_zero_iff_norm, rhoG]
    exact norm_nrm (affC_ne_zero hl hi)

theorem continuous_affC_on {Z : Type} [TopologicalSpace Z] {f : Z → Vec (m + 1)} (hf : Continuous f)
    (hl : ∀ z, last' (f z) ≠ 0) : Continuous fun z ↦ affC (f z) :=
  (PiLp.continuous_toLp 2 _).comp
    (((continuous_last'.comp hf).inv₀ hl).smul (continuous_init'.comp hf))

theorem continuous_nrm_on {Z : Type} [TopologicalSpace Z] {f : Z → ES m} (hf : Continuous f)
    (hne : ∀ z, f z ≠ 0) : Continuous fun z ↦ nrm (f z) :=
  (Complex.continuous_ofReal.comp (hf.norm.inv₀ fun z ↦ norm_ne_zero_iff.mpr (hne z))).smul hf

/-- La rétraction `ρ : U ∩ V → S^{2m+1}`. -/
noncomputable def rhoUV : C(UV m, Sph (ES m)) where
  toFun p := ⟨liftInv rhoG ((), (p : CP (m + 1))), rhoG_mem p⟩
  continuous_toFun := by
    have hz : Continuous fun p : Unit × (q ⁻¹' (setU m ∩ setV m)) ↦ p.2.1.1 :=
      continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd)
    have h := continuous_liftInv (Ω := setU m ∩ setV m) rhoG_smul
      (continuous_nrm_on (continuous_affC_on hz fun p ↦ last'_ne_of_mem p.2.2.1)
        fun p ↦ affC_ne_zero (last'_ne_of_mem p.2.2.1) (init'_ne_of_mem p.2.2.2))
    exact (h.comp (continuous_const.prodMk continuous_id)).subtype_mk _

theorem ofLp_ne_zero_of_sph (s : Sph (ES m)) : WithLp.ofLp (s : ES m) ≠ 0 := by
  rw [Ne, WithLp.ofLp_eq_zero]
  intro h
  have := norm_eq_of_mem_sphere s
  rw [h, norm_zero] at this
  exact zero_ne_one this

theorem snoc'_one_ne_zero (w : Vec m) : snoc' w 1 ≠ 0 := fun h ↦ one_ne_zero (snoc'_eq_zero.mp h).2

/-- L'inclusion `σ : S^{2m+1} → U ∩ V`, `s ↦ [s : 1]`. -/
noncomputable def sigmaUV : C(Sph (ES m), UV m) where
  toFun s := ⟨Projectivization.mk ℂ (snoc' (WithLp.ofLp (s : ES m)) 1) (snoc'_one_ne_zero _),
    (mk_mem_setU _ _).mpr (by simp), (mk_mem_setV _ _).mpr (by simpa using ofLp_ne_zero_of_sph s)⟩
  continuous_toFun := by
    refine (continuous_q.comp (Continuous.subtype_mk (continuous_snoc'
      ((PiLp.continuous_ofLp 2 _).comp continuous_subtype_val) continuous_const)
      fun s ↦ snoc'_one_ne_zero _)).subtype_mk _

theorem rhoUV_sigmaUV : rhoUV.comp sigmaUV = ContinuousMap.id (Sph (ES m)) := by
  refine ContinuousMap.ext fun s ↦ Subtype.ext ?_
  change liftInv rhoG ((), Projectivization.mk ℂ (snoc' (WithLp.ofLp (s : ES m)) 1) _) = (s : ES m)
  rw [liftInv_mk rhoG_smul, rhoG, affC, last'_snoc', init'_snoc', inv_one, one_smul,
    WithLp.toLp_ofLp, nrm, norm_eq_of_mem_sphere s, inv_one, Complex.ofReal_one, one_smul]

/-- Le facteur `t + (1 - t)/‖affC z‖` de la déformation. -/
noncomputable def lamC (t : unitInterval) (z : Vec (m + 1)) : ℂ :=
  (((t : ℝ) + (1 - (t : ℝ)) * ‖affC z‖⁻¹ : ℝ) : ℂ)

theorem lamC_smul (t : unitInterval) (c : ℂˣ) (z : Vec (m + 1)) : lamC t (c • z) = lamC t z := by
  rw [lamC, lamC, affC_smul]

theorem lamC_ne_zero (t : unitInterval) {z : Vec (m + 1)} (hz : affC z ≠ 0) : lamC t z ≠ 0 := by
  rw [lamC, Ne, Complex.ofReal_eq_zero]
  have ha : 0 < ‖affC z‖⁻¹ := inv_pos.mpr (norm_pos_iff.mpr hz)
  have h0 : 0 ≤ (t : ℝ) := t.2.1
  have h1 : 0 ≤ 1 - (t : ℝ) := sub_nonneg.mpr t.2.2
  rcases h0.lt_or_eq with ht | ht
  · exact (add_pos_of_pos_of_nonneg ht (mul_nonneg h1 ha.le)).ne'
  · rw [← ht, zero_add, sub_zero, one_mul]
    exact ha.ne'

/-- `(t, z) ↦ [λ_t (z_0, …, z_m) : z_{m+1}]`. -/
noncomputable def defK (t : unitInterval) (z : Vec (m + 1)) : CP (m + 1) :=
  mkD (snoc' (lamC t z • init' z) (last' z))

theorem defK_smul (t : unitInterval) (c : ℂˣ) (z : Vec (m + 1)) : defK t (c • z) = defK t z := by
  rw [defK, defK, lamC_smul, Units.smul_def, init'_smul, last'_smul, smul_comm (lamC t z),
    snoc'_smul, ← Units.smul_def, mkD_smul]

theorem defK_mk (t : unitInterval) (v : Vec (m + 1)) (hl : last' v ≠ 0) :
    defK t v = Projectivization.mk ℂ (snoc' (lamC t v • init' v) (last' v))
      (fun h ↦ hl (snoc'_eq_zero.mp h).2) :=
  mkD_of_ne _

theorem defK_mem (t : unitInterval) (p : UV m) :
    liftInv defK (t, (p : CP (m + 1))) ∈ setU m ∩ setV m := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    obtain ⟨hl, hi⟩ := mem_UV_mk hp
    rw [liftInv_mk defK_smul, defK_mk t v hl]
    refine ⟨(mk_mem_setU _ _).mpr (by simpa using hl), (mk_mem_setV _ _).mpr ?_⟩
    rw [init'_snoc']
    exact smul_ne_zero (lamC_ne_zero t (affC_ne_zero hl hi)) hi

/-- La déformation de `U ∩ V` sur la sphère. -/
noncomputable def defKHomotopy :
    ContinuousMap.Homotopy ((sigmaUV (m := m)).comp rhoUV) (ContinuousMap.id (UV m)) where
  toFun p := ⟨liftInv defK (p.1, (p.2 : CP (m + 1))), defK_mem p.1 p.2⟩
  continuous_toFun := by
    refine (continuous_liftInv defK_smul ?_).subtype_mk _
    have hz : Continuous fun p : unitInterval × (q ⁻¹' (setU m ∩ setV m)) ↦ p.2.1.1 :=
      continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd)
    have hl : ∀ p : unitInterval × (q ⁻¹' (setU m ∩ setV m)), last' p.2.1.1 ≠ 0 :=
      fun p ↦ last'_ne_of_mem p.2.2.1
    have ha := continuous_affC_on hz hl
    have hlam : Continuous fun p : unitInterval × (q ⁻¹' (setU m ∩ setV m)) ↦ lamC p.1 p.2.1.1 := by
      have ht : Continuous fun p : unitInterval × (q ⁻¹' (setU m ∩ setV m)) ↦ ((p.1 : ℝ)) :=
        continuous_subtype_val.comp continuous_fst
      refine Complex.continuous_ofReal.comp (ht.add ((continuous_const.sub ht).mul
        (ha.norm.inv₀ fun p ↦ ?_)))
      exact norm_ne_zero_iff.mpr (affC_ne_zero (hl p) (init'_ne_of_mem p.2.2.2))
    exact continuous_mkD_comp (continuous_snoc' (hlam.smul (continuous_init'.comp hz))
      (continuous_last'.comp hz)) fun p h ↦ hl p (snoc'_eq_zero.mp h).2
  map_zero_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      obtain ⟨hl, hi⟩ := mem_UV_mk hp
      change liftInv defK ((0 : unitInterval), Projectivization.mk ℂ v hv) =
        Projectivization.mk ℂ (snoc' (WithLp.ofLp (liftInv rhoG ((), Projectivization.mk ℂ v hv))) 1)
          (snoc'_one_ne_zero _)
      rw [liftInv_mk defK_smul, defK_mk 0 v hl]
      refine (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr ⟨last' v, ?_⟩
      have hlam0 : lamC 0 v = ((‖affC v‖⁻¹ : ℝ) : ℂ) := by simp [lamC]
      have hof : WithLp.ofLp (affC v) = (last' v)⁻¹ • init' v := rfl
      rw [liftInv_mk rhoG_smul, rhoG, nrm, ← snoc'_smul, mul_one, WithLp.ofLp_smul, hof, hlam0,
        smul_smul, smul_smul, mul_comm (last' v), mul_assoc, mul_inv_cancel₀ hl, mul_one]
  map_one_left p := by
    obtain ⟨p, hp⟩ := p
    refine Subtype.ext ?_
    induction p using Projectivization.ind with
    | h v hv =>
      obtain ⟨hl, -⟩ := mem_UV_mk hp
      change liftInv defK ((1 : unitInterval), Projectivization.mk ℂ v hv) = _
      rw [liftInv_mk defK_smul, defK_mk 1 v hl]
      simp [lamC]

/-- `U ∩ V` a le type d'homotopie de `S^{2m+1}`. -/
noncomputable def uvHomotopyEquiv : ContinuousMap.HomotopyEquiv (Sph (ES m)) (UV m) where
  toFun := sigmaUV
  invFun := rhoUV
  left_inv := by rw [rhoUV_sigmaUV]
  right_inv := ⟨defKHomotopy⟩

end Charts

section Transfer

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

/-- Une équivalence d'homotopie induit `H_k(X) ≅ H_k(Y)`. -/
noncomputable def homologyEquiv (e : ContinuousMap.HomotopyEquiv X Y) (k : ℕ) :
    H R k X ≃ₗ[R] H R k Y :=
  have : IsIso (map R k e.toFun) := isIso_map_of_homotopyEquiv k e
  (asIso (map R k e.toFun)).toLinearEquiv

/-- Une équivalence d'homotopie induit `H̃₀(X) ≅ H̃₀(Y)`. -/
noncomputable def hred0Equiv (e : ContinuousMap.HomotopyEquiv X Y) : Hred0 R X ≃ₗ[R] Hred0 R Y :=
  (LinearEquiv.ofEq _ _ (by
    change LinearMap.ker (map R 0 ((toPt Y).comp e.toFun)).hom = _
    rw [map_comp]
    rfl)).trans (kerCompEquiv (homologyEquiv e 0) (map R 0 (toPt Y)).hom)

end Transfer

section Induction

attribute [local instance] InnerProductSpace.complexToReal

theorem subsingleton_CP0 : Subsingleton (CP 0) := by
  refine ⟨fun p p' ↦ ?_⟩
  induction p using Projectivization.ind with
  | h v hv =>
  induction p' using Projectivization.ind with
  | h w hw =>
    have h0 : ∀ u : Vec 0, u ≠ 0 → u 0 ≠ 0 := fun u hu h ↦
      hu (funext fun i ↦ by rw [Fin.fin_one_eq_zero i, h]; rfl)
    refine (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr ⟨v 0 / w 0, funext fun i ↦ ?_⟩
    rw [Fin.fin_one_eq_zero i, Pi.smul_apply, smul_eq_mul, div_mul_cancel₀ _ (h0 w hw)]

instance : ContractibleSpace (CP 0) := by
  have := subsingleton_CP0
  infer_instance

theorem finrank_vec (n : ℕ) : Module.finrank ℝ (Vec n) = (n + 1) * 2 := by
  rw [Module.finrank_pi_fintype]
  simp [Complex.finrank_real_complex]

instance pathConnected_CP (n : ℕ) : PathConnectedSpace (CP n) := by
  have h : 1 < Module.rank ℝ (Vec n) := by
    rw [← Module.finrank_eq_rank, finrank_vec]
    exact_mod_cast (by omega : 1 < (n + 1) * 2)
  have := isPathConnected_iff_pathConnectedSpace.mp (isPathConnected_compl_singleton_of_one_lt_rank h 0)
  refine Function.Surjective.pathConnectedSpace (f := fun v : ↥({0}ᶜ : Set (Vec n)) ↦ q ⟨v.1, v.2⟩)
    (fun p ↦ ?_) (continuous_q.comp (continuous_subtype_val.subtype_mk _))
  obtain ⟨v, rfl⟩ := surjective_q p
  exact ⟨⟨v.1, v.2⟩, rfl⟩

theorem finrank_ES (m : ℕ) : Module.finrank ℝ (ES m) = (2 * m + 1) + 1 := by
  rw [finrank_real_of_complex, finrank_euclideanSpace_fin]
  ring

variable (R) in
/-- **Récurrence** sur `n`. -/
theorem cp_claim (n : ℕ) :
    (∀ k, (Odd k ∨ 2 * n < k) → Subsingleton (H R k (CP n))) ∧
    (∀ i, 1 ≤ i → i ≤ n → Nonempty (H R (2 * i) (CP n) ≃ₗ[R] R)) := by
  induction n with
  | zero =>
    refine ⟨fun k hk ↦ subsingleton_of_contractible ?_, fun i h1 h2 ↦ absurd h2 (by omega)⟩
    rintro rfl
    rcases hk with h | h
    · exact Nat.not_odd_zero h
    · omega
  | succ m ih =>
    obtain ⟨ihZ, ihT⟩ := ih
    obtain ⟨sZ, sT, -, sP⟩ := sphere_claim R (2 * m + 1) (ES m) (finrank_ES m)
    have eV : ∀ k, H R k (setV m) ≃ₗ[R] H R k (CP m) :=
      fun k ↦ (homologyEquiv setVHomotopyEquiv k).symm
    have eI : ∀ k, H R k (UV m) ≃ₗ[R] H R k (Sph (ES m)) :=
      fun k ↦ (homologyEquiv uvHomotopyEquiv k).symm
    have hredI : Subsingleton (Hred0 R (UV m)) :=
      have := sP (by omega)
      (hred0Equiv (R := R) uvHomotopyEquiv).symm.toEquiv.subsingleton
    have hI : ∀ k, k ≠ 0 → k ≠ 2 * m + 1 → Subsingleton (H R k (UV m)) := fun k h1 h2 ↦
      have := sZ k h1 h2
      (eI k).toEquiv.subsingleton
    have hV : ∀ k, (Odd k ∨ 2 * m < k) → Subsingleton (H R k (setV m)) := fun k hk ↦
      have := ihZ k hk
      (eV k).toEquiv.subsingleton
    -- degrés `1 ≤ k ≤ 2m + 1` et `k > 2m + 2` : `H_k(ℂP^{m+1}) ≅ H_k(ℂPᵐ)`
    have low : ∀ j, j + 1 ≠ 2 * m + 2 →
        Nonempty (H R (j + 1) (CP (m + 1)) ≃ₗ[R] H R (j + 1) (CP m)) := by
      intro j hj
      have hprod : Subsingleton (H R (j + 1) (UV m)) ∨ Subsingleton (H R (j + 1) (setV m)) := by
        by_cases h : j + 1 = 2 * m + 1
        · exact Or.inr (hV _ (Or.inl ⟨m, h⟩))
        · exact Or.inl (hI _ (by omega) h)
      have hinj : Subsingleton (H R j (UV m)) ∨ (j = 0 ∧ Subsingleton (Hred0 R (UV m))) := by
        by_cases h : j = 0
        · exact Or.inr ⟨h, hredI⟩
        · exact Or.inl (hI _ h (by omega))
      obtain ⟨e⟩ := mv_equiv_B (A := setU m) (B := setV m) cover_UV j hprod hinj
      exact ⟨e.trans (eV _)⟩
    have top : Nonempty (H R (2 * (m + 1)) (CP (m + 1)) ≃ₗ[R] R) := by
      have hB1 : Subsingleton (H R (2 * m + 1 + 1) (setV m)) := hV _ (Or.inr (by omega))
      have hBj : Subsingleton (H R (2 * m + 1) (setV m)) := hV _ (Or.inl ⟨m, rfl⟩)
      obtain ⟨e⟩ := mv_equiv_I (A := setU m) (B := setV m) cover_UV (j := 2 * m + 1) (by omega) hB1 hBj
      obtain ⟨e'⟩ := sT (by omega)
      exact ⟨((e.trans (eI _)).trans e')⟩
    refine ⟨fun k hk ↦ ?_, fun i h1 h2 ↦ ?_⟩
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by rcases hk with ⟨r, hr⟩ | h <;> omega⟩
      have hj : j + 1 ≠ 2 * m + 2 := by
        rintro h
        rcases hk with ⟨r, hr⟩ | h' <;> omega
      obtain ⟨e⟩ := low j hj
      have := ihZ (j + 1) (by rcases hk with h' | h' <;> [exact Or.inl h'; exact Or.inr (by omega)])
      exact e.toEquiv.subsingleton
    · rcases Nat.lt_or_ge i (m + 1) with h | h
      · obtain ⟨e⟩ := low (2 * i - 1) (by omega)
        obtain ⟨e'⟩ := ihT i h1 (by omega)
        have hi : 2 * i - 1 + 1 = 2 * i := by omega
        rw [hi] at e
        exact ⟨e.trans e'⟩
      · obtain rfl : i = m + 1 := by omega
        exact top

end Induction

/-- **Homologie de `ℂPⁿ`** (Hatcher, §2.2, p. 140). -/
theorem complexProjectiveSpace_homology_proof (R : Type) [Ring R] (n : ℕ) :
    (∀ k : ℕ, (Odd k ∨ 2 * n < k) → IsZero (H R k (CP n))) ∧
    (∀ i : ℕ, i ≤ n → Nonempty (H R (2 * i) (CP n) ≅ ModuleCat.of R R)) := by
  obtain ⟨hZ, hT⟩ := cp_claim R n
  refine ⟨fun k hk ↦ ?_, fun i hi ↦ ?_⟩
  · have := hZ k hk
    exact ModuleCat.isZero_of_subsingleton _
  · rcases Nat.eq_zero_or_pos i with rfl | h
    · exact ⟨asIso (eps (R := R) (CP n))⟩
    · obtain ⟨e⟩ := hT i h hi
      exact ⟨e.toModuleIso⟩


end Hatcher.Singular

end

/-! ## Solution (statement copied verbatim) -/

open CategoryTheory Limits

namespace Hatcher.Singular

theorem _root_.solution (R : Type) [Ring R] (n : ℕ) :
    (∀ k : ℕ, (Odd k ∨ 2 * n < k) → IsZero (H R k (CP n))) ∧
    (∀ i : ℕ, i ≤ n → Nonempty (H R (2 * i) (CP n) ≅ ModuleCat.of R R)) :=
  complexProjectiveSpace_homology_proof R n

end Hatcher.Singular
