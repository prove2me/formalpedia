-- Source module: Solutions.J6SegLn6
/-!
# Segmented inverse (S2), machine side 6: the coupling as a cyclic window

On a sorted line `L = [j₀ < … < j_{m-1}]` of positions `< s` (the near-boundary positions), with
`z` vanishing off `L`, the coupling `W = U z` at `j_r` only reads `z` at the line indices
`q` within cyclic index distance `K ≥ w` of `r` (positions within cyclic distance `w`, and the
line is strictly increasing). With the cyclically extended list
`zext = (last K of zl) ++ zl ++ (first K of zl)`, `zl = [z_{j_0}, …, z_{j_{m-1}}]`:

* **`couple_window`**: `W_{j_r} = ∑_{i ≤ 2K} fmul (cc_r)_i zext_{r+i}` (`2K+1 ≤ m`, `2w < s`);
* **`couple_off`**: `W_i = 0` at positions that are not near a block boundary.
-/

open Finset

namespace J6Seg

section cpl
variable (P : ℕ) (T : Tables) (B : Blocks) (L : List ℕ) (K : ℕ)

variable {P T B L K}

lemma getD_drop' (l : List ℤ) (a i : ℕ) : (l.drop a).getD i 0 = l.getD (a + i) 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]

lemma getD_take' (l : List ℤ) (a i : ℕ) (h : i < a) : (l.take a).getD i 0 = l.getD i 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_take, if_pos h]

lemma zext_getD (zf : ℕ → ℤ) (hKm : K ≤ L.length) {e : ℕ} (he : e < L.length + 2 * K) :
    (zext K (zlOf L zf)).getD e 0 = zf (L.getD (qOf L K e 0) 0) := by
  have hlen : (zlOf L zf).length = L.length := by simp [zlOf]
  have hg : ∀ q < L.length, (zlOf L zf).getD q 0 = zf (L.getD q 0) := by
    intro q hq; unfold zlOf; rw [List.getD_eq_getElem _ _ (by simp; omega)]; simp
  have hm0 : 0 < L.length := by omega
  unfold zext qOf
  rw [hlen, add_zero]
  have hdl : ((zlOf L zf).drop (L.length - K)).length = K := by
    rw [List.length_drop, hlen]; omega
  rcases Nat.lt_or_ge e K with h1 | h1
  · rw [List.getD_append _ _ _ _ (by rw [hdl]; exact h1), getD_drop', hg _ (by omega)]
    rw [show e + L.length - K = L.length - K + e by omega, Nat.mod_eq_of_lt (by omega)]
  · rw [List.getD_append_right _ _ _ _ (by rw [hdl]; exact h1), hdl]
    rcases Nat.lt_or_ge (e - K) L.length with h2 | h2
    · rw [List.getD_append _ _ _ _ (by rw [hlen]; exact h2), hg _ h2]
      rw [show e + L.length - K = (e - K) + L.length * 1 by omega, Nat.add_mul_mod_self_left,
        Nat.mod_eq_of_lt h2]
    · rw [List.getD_append_right _ _ _ _ (by rw [hlen]; exact h2), hlen,
        getD_take' _ _ _ (by omega), hg _ (by omega)]
      rw [show e + L.length - K = (e - K - L.length) + L.length * 2 by omega,
        Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (by omega)]

lemma qOf_add (r i : ℕ) : qOf L K (r + i) 0 = qOf L K r i := by
  unfold qOf; rw [add_zero]

lemma qOf_inj {r i i' : ℕ} (hKm : 2 * K + 1 ≤ L.length) (hi : i < 2 * K + 1) (hi' : i' < 2 * K + 1)
    (he : qOf L K r i = qOf L K r i') : i = i' := by
  unfold qOf at he
  set m := L.length
  rcases Nat.lt_or_ge i i' with h | h
  · have := Nat.sub_mod_eq_zero_of_mod_eq he.symm
    rw [show r + i' + m - K - (r + i + m - K) = i' - i by omega,
      Nat.mod_eq_of_lt (by omega)] at this
    omega
  · rcases Nat.lt_or_ge i' i with h' | h'
    · have := Nat.sub_mod_eq_zero_of_mod_eq he
      rw [show r + i + m - K - (r + i' + m - K) = i - i' by omega,
        Nat.mod_eq_of_lt (by omega)] at this
      omega
    · omega

/-- Strictly increasing positions advance by at least the index distance. -/
lemma mono_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i ≤ j) (hj : j < L.length) :
    L.getD i 0 + (j - i) ≤ L.getD j 0 := by
  induction j with
  | zero =>
    have : i = 0 := by omega
    subst this; simp
  | succ j ih =>
    rcases Nat.lt_or_ge j i with h | h
    · have : i = j + 1 := by omega
      subst this; simp
    · have hlt : L.getD j 0 < L.getD (j + 1) 0 := by
        rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ hj]
        exact (List.pairwise_iff_getElem.1 hsort) j (j + 1) (by omega) hj (by omega)
      have := ih h (by omega)
      omega

lemma ge_index (hsort : L.Pairwise (· < ·)) {j : ℕ} (hj : j < L.length) : j ≤ L.getD j 0 := by
  have := mono_getD hsort (Nat.zero_le j) hj; omega

lemma lt_s_getD (hL : ∀ x ∈ L, x < B.s) {j : ℕ} (hj : j < L.length) : L.getD j 0 < B.s := by
  rw [List.getD_eq_getElem _ _ hj]; exact hL _ (List.getElem_mem _)

/-- The coupling target of `(j_r, h)`, if on the line, is read by a window slot. -/
theorem slot_exists (hsort : L.Pairwise (· < ·)) (hL : ∀ x ∈ L, x < B.s) (hwK : B.w ≤ K)
    (hKm : 2 * K + 1 ≤ L.length) (hws : 2 * B.w < B.s) {r q : ℕ} (hr : r < L.length)
    (hq : q < L.length) {h : ℤ} (hh : h ∈ Hset B (L.getD r 0))
    (hc : col B.s (L.getD r 0) h = L.getD q 0) : ∃ i < 2 * K + 1, qOf L K r i = q := by
  obtain ⟨hw1, hw2, _, _⟩ := mem_Hset hh
  have hs0 : 0 < B.s := by omega
  have hjr := lt_s_getD hL hr
  have hjq := lt_s_getD hL hq
  have hlast := lt_s_getD hL (show L.length - 1 < L.length by omega)
  unfold col at hc
  have hv : ((L.getD q 0 : ℕ) : ℤ) = ((L.getD r 0 : ℕ) + h) % B.s := by
    rw [← hc]; exact Int.toNat_of_nonneg (Int.emod_nonneg _ (by omega))
  clear hc
  rcases emod_cases (s := B.s) hs0 (a := ((L.getD r 0 : ℕ) : ℤ) + h) (by omega) (by omega) with
    ⟨c1, c2, c3⟩ | ⟨c1, c3⟩ | ⟨c1, c3⟩
  · rw [c3] at hv
    rcases Nat.lt_or_ge q r with hqr | hqr
    · have := mono_getD hsort hqr.le hr
      refine ⟨K - (r - q), by omega, ?_⟩
      unfold qOf; rw [show r + (K - (r - q)) + L.length - K = q + L.length * 1 by omega,
        Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hq]
    · have := mono_getD hsort hqr hq
      refine ⟨K + (q - r), by omega, ?_⟩
      unfold qOf; rw [show r + (K + (q - r)) + L.length - K = q + L.length * 1 by omega,
        Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hq]
  · rw [c3] at hv
    have h1 := mono_getD hsort (show r ≤ L.length - 1 by omega) (show L.length - 1 < L.length by omega)
    have h2 := ge_index hsort hq
    refine ⟨K + (q + L.length - r), by omega, ?_⟩
    unfold qOf; rw [show r + (K + (q + L.length - r)) + L.length - K = q + L.length * 2 by omega,
      Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hq]
  · rw [c3] at hv
    have h1 := mono_getD hsort (show q ≤ L.length - 1 by omega) (show L.length - 1 < L.length by omega)
    have h2 := ge_index hsort hr
    refine ⟨K - (r + L.length - q), by omega, ?_⟩
    unfold qOf; rw [show r + (K - (r + L.length - q)) + L.length - K = q by omega,
      Nat.mod_eq_of_lt hq]

/-- Distinct offsets give distinct columns (`2w < s`). -/
lemma col_inj (hws : 2 * B.w < B.s) {i : ℕ} {h h' : ℤ} (hh : h ∈ Hset B i) (hh' : h' ∈ Hset B i)
    (he : col B.s i h = col B.s i h') : h = h' := by
  obtain ⟨a1, a2, _, _⟩ := mem_Hset hh
  obtain ⟨b1, b2, _, _⟩ := mem_Hset hh'
  unfold col at he
  have hs : (0 : ℤ) < B.s := by omega
  have e1 := Int.toNat_of_nonneg (Int.emod_nonneg ((i : ℤ) + h) hs.ne')
  have e2 := Int.toNat_of_nonneg (Int.emod_nonneg ((i : ℤ) + h') hs.ne')
  have he' : ((i : ℤ) + h) % B.s = ((i : ℤ) + h') % B.s := by rw [← e1, ← e2, he]
  have := Int.ModEq.dvd he'.symm
  have h0 := Int.eq_zero_of_abs_lt_dvd this (by rw [abs_lt]; constructor <;> omega)
  omega

/-- `fmul` of a sum with at most one nonzero term. -/
lemma fmul_sum_single {ι : Type*} [DecidableEq ι] (S : Finset ι) (c : ι → Prop) [DecidablePred c]
    (a : ι → ℤ) (Z : ℤ) (huniq : ∀ x ∈ S, ∀ y ∈ S, c x → c y → x = y) :
    fmul P (∑ x ∈ S, if c x then a x else 0) Z = ∑ x ∈ S, if c x then fmul P (a x) Z else 0 := by
  by_cases hex : ∃ x ∈ S, c x
  · obtain ⟨x0, hx0, hc0⟩ := hex
    rw [Finset.sum_eq_single x0 (fun y hy hne => by rw [if_neg (fun hc => hne (huniq y hy x0 hx0 hc hc0))])
      (fun h => absurd hx0 h), Finset.sum_eq_single x0
      (fun y hy hne => by rw [if_neg (fun hc => hne (huniq y hy x0 hx0 hc hc0))])
      (fun h => absurd hx0 h), if_pos hc0, if_pos hc0]
  · push Not at hex
    rw [Finset.sum_eq_zero (fun x hx => if_neg (hex x hx)),
      Finset.sum_eq_zero (fun x hx => if_neg (hex x hx)), fmul_zero_left]

lemma fmul_ccOf (hws : 2 * B.w < B.s) (r i : ℕ) (Z : ℤ) :
    fmul P (ccOf T B L K r i) Z = ∑ h ∈ Hset B (L.getD r 0),
      if col B.s (L.getD r 0) h = L.getD (qOf L K r i) 0 then fmul P (T.cpl (L.getD r 0) h) Z
      else 0 := by
  unfold ccOf
  exact fmul_sum_single (P := P) (Hset B (L.getD r 0))
    (fun h => col B.s (L.getD r 0) h = L.getD (qOf L K r i) 0) (fun h => T.cpl (L.getD r 0) h) Z
    (fun x hx y hy cx cy => col_inj hws hx hy (cx.trans cy.symm))

/-- **The coupling at a line position is the window sum.** -/
theorem couple_window_sol_aux (hsort : L.Pairwise (· < ·)) (hL : ∀ x ∈ L, x < B.s) (hwK : B.w ≤ K)
    (hKm : 2 * K + 1 ≤ L.length) (hws : 2 * B.w < B.s) (zf : ℕ → ℤ)
    (hz : ∀ k, k ∉ L → zf k = 0) {r : ℕ} (hr : r < L.length) :
    coupleI P T B zf (L.getD r 0) = ∑ i ∈ range (2 * K + 1),
      fmul P (ccOf T B L K r i) ((zext K (zlOf L zf)).getD (r + i) 0) := by
  -- the window entries
  have hzx : ∀ i < 2 * K + 1, (zext K (zlOf L zf)).getD (r + i) 0 =
      zf (L.getD (qOf L K r i) 0) := by
    intro i hi
    rw [zext_getD zf (by omega) (by omega), qOf_add]
  have hqlt : ∀ i, qOf L K r i < L.length := fun i => Nat.mod_lt _ (by omega)
  -- expand the coefficients
  have e1 : ∑ i ∈ range (2 * K + 1), fmul P (ccOf T B L K r i) ((zext K (zlOf L zf)).getD (r + i) 0)
      = ∑ i ∈ range (2 * K + 1), ∑ h ∈ Hset B (L.getD r 0),
        if col B.s (L.getD r 0) h = L.getD (qOf L K r i) 0 then fmul P (T.cpl (L.getD r 0) h) (zf (col B.s (L.getD r 0) h))
        else 0 := by
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [Finset.mem_range] at hi
    rw [hzx i hi, fmul_ccOf hws]
    refine Finset.sum_congr rfl (fun h _ => ?_)
    split_ifs with hc
    · rw [hc]
    · rfl
  rw [e1, Finset.sum_comm]
  unfold coupleI
  refine Finset.sum_congr rfl (fun h hh => ?_)
  by_cases hcl : col B.s (L.getD r 0) h ∈ L
  · obtain ⟨q, hq, hqe⟩ : ∃ q, q < L.length ∧ L.getD q 0 = col B.s (L.getD r 0) h := by
      obtain ⟨q, hq, e⟩ := List.mem_iff_getElem.1 hcl
      exact ⟨q, hq, by rw [List.getD_eq_getElem _ _ hq, e]⟩
    obtain ⟨i0, hi0, hq0⟩ := slot_exists hsort hL hwK hKm hws hr hq hh hqe.symm
    rw [Finset.sum_eq_single i0]
    · rw [if_pos (by rw [hq0, hqe])]
    · intro i hi hne
      rw [if_neg]
      intro hc
      apply hne
      rw [Finset.mem_range] at hi
      apply qOf_inj hKm hi hi0
      rw [hq0]
      have hgi := hqlt i
      have heq : L.getD (qOf L K r i) 0 = L.getD q 0 := by rw [← hc, hqe]
      rw [List.getD_eq_getElem _ _ hgi, List.getD_eq_getElem _ _ hq] at heq
      by_contra hneq
      have hlt := (List.pairwise_iff_getElem.1 hsort)
      rcases Nat.lt_or_gt_of_ne hneq with h1 | h1
      · have := hlt _ _ hgi hq h1
        omega
      · have := hlt _ _ hq hgi h1
        omega
    · intro h0; exact absurd (Finset.mem_range.2 hi0) h0
  · rw [hz _ hcl, fmul_zero_right]
    refine (Finset.sum_eq_zero (fun i _ => ?_)).symm
    rw [if_neg]
    intro hc
    apply hcl
    rw [hc, List.getD_eq_getElem _ _ (hqlt i)]
    exact List.getElem_mem _

end cpl

end J6Seg

end

theorem solution : type_of% @J6Seg.couple_window_sol_aux := @J6Seg.couple_window_sol_aux
