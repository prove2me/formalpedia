section
-- Source module: Solutions.KFUURot2
/-!
# KFUU §7b: the coefficient loop of a uniform shift

Registers of a shift of target `i` (all values natural numbers):
`oI = i`, `oQ = Q = s_i`, `oMu = μ_i`, `oPi = P_i`, `oBv = B` (volume behind the target),
`oSP`: the sizes `s_{i-1}, …, s_0` (top first).

`coefB neg` is one step `j` of the coefficient loop: it pushes the stage data of field `j`
(`c_j`, `P_i / P_j`, `P_i / P_{j+1}`, `s_j`) on the stage stacks of KIL4 and advances
`oPr = P_j` to `P_{j+1}`, moving `s_j` from `oSQ` to `oSP`.  `c_j = μ P_j mod Q`
(forward, `neg = false`) or `(Q - μ P_j mod Q) mod Q` (backward).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

abbrev oI : Fin HS := 13
abbrev oQ : Fin HS := 18
abbrev oMu : Fin HS := 19
abbrev oPi : Fin HS := 20
abbrev oPr : Fin HS := 22
abbrev oBv : Fin HS := 24
abbrev oSP : Fin HS := 25
abbrev oSQ : Fin HS := 26
abbrev oCC : Fin HS := 27
abbrev oCS : Fin HS := 28
abbrev oCM : Fin HS := 29

/-- `μ · P_j mod Q`. -/
def cMx : Ex HS := .nmod (.mul (.reg oMu) (.reg oPr)) (.reg oQ)

/-- The control of the current field. -/
def cE : Bool → Ex HS
  | false => cMx
  | true => .nmod (.add (.reg oQ) (.neg cMx)) (.reg oQ)

/-- Its value. -/
def cF (neg : Bool) (sF : ℕ → ℕ) (μ Q j : ℕ) : ℕ :=
  if neg then (Q - μ * Pv sF j % Q) % Q else μ * Pv sF j % Q

/-- One step of the coefficient loop. -/
def coefB (neg : Bool) : RS :=
  .seq (.push sSC (NLogN.KFUU.cE neg)) (.seq (.push sSAM (.ndiv (.reg oPi) (.reg oPr)))
    (.seq (.push sSM (.ndiv (.reg oPi) (.mul (.reg oPr) (.reg oSQ))))
      (.seq (.push NLogN.KIL.sSA (.reg oSQ)) (.seq (.asg oPr (.mul (.reg oPr) (.reg oSQ)))
        (.seq (.push oSP (.reg oSQ)) (.pop oSQ))))))

/-- The managed lists after `k` steps. -/
def cfF (f0 : Fin HS → List ℤ) (neg : Bool) (sF : ℕ → ℕ) (μ Q i k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update f0
      oSQ (((List.range i).map fun j => (sF j : ℤ)).drop k))
      oSP (((List.range k).map fun j => (sF j : ℤ)).reverse))
      oPr [(Pv sF k : ℤ)])
      sSC (((List.range k).map fun j => (cF neg sF μ Q j : ℤ)).reverse))
      sSAM (((List.range k).map fun j => ((Pv sF i / Pv sF j : ℕ) : ℤ)).reverse))
      sSM (((List.range k).map fun j => ((Pv sF i / Pv sF (j + 1) : ℕ) : ℤ)).reverse))
      NLogN.KIL.sSA (((List.range k).map fun j => (sF j : ℤ)).reverse)

end NLogN.KFUU

end

