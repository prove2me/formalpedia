open AlgebraicCurve

theorem AlgebraicCurve.Place.mul_diffCoeff_D_div_mem_and_evalAt_eq_intCast_ord
    {K F : Type*} [Field K] [Field F] [Algebra K F] [PerfectField K] (x : F)
    [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F]
    (v : Place K F) {t : F} (ht : v.ord t = 1) {f : F} (hf : f ≠ 0) :
    t * Place.diffCoeff t (KaehlerDifferential.D K F f) / f ∈ v.toValuationSubring ∧
      v.evalAt (t * Place.diffCoeff t (KaehlerDifferential.D K F f) / f) = ((v.ord f : ℤ) : K) := by sorry
