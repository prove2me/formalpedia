theorem solution (M : NLogN.MulSpec) (X : Fin NLogN.HS) (Kc : ℝ) (rw rm : Fin NLogN.HS) (hd : NLogN.KFM.TrOk X rw rm)
    (hX0 : X ≠ 0) {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (w m : ℕ) (t : NLogN.IState NLogN.HS) (h : IntMul.OpenAI.R129.P.NLogN.KFM.TrRegs t n w m rw rm)
    (zs : List NLogN.KFB.GI) (l : List NLogN.Item) (h0 : t.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ l)
    (hz : zs.length = AModel.vol (NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m))) (hB : NLogN.KFB.GB w zs)
    (hh : 1 ≤ IntMul.OpenAI.R129.ℓP n - 1) (hbs : IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m ≠ []) :
    (IntMul.OpenAI.R129.P.NLogN.KFY.trBlk X Kc rw rm).run t = t.upd 0 (NLogN.ints (NLogN.KFB.gflat (IntMul.HvdH.Ref.transposeL
        ((NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).headD 1) (AModel.vol (NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).tail) zs))
        ++ l) ∧
      (IntMul.OpenAI.R129.P.NLogN.KFY.trBlk X Kc rw rm).ok M t ∧
      (IntMul.OpenAI.R129.P.NLogN.KFY.trBlk X Kc rw rm).cost M t = 1 + ((NLogN.KFM.descTrP X rw rm).cost (t.upd X (.mark :: t.G X)) +
        (⌈IntMul.OpenAI.R129.P.NLogN.KFY.trBound Kc w (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m).length
          (AModel.vol (NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)))⌉₊ + NLogN.KFY.trOver w (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m).length)) := by
  set t1 := t.upd X (.mark :: t.G X) with ht1
  have hm : (NLogN.IOp.mark X : NLogN.IOp NLogN.HS).run t = some (t1, 1) := rfl
  have h1 : IntMul.OpenAI.R129.P.NLogN.KFM.TrRegs t1 n w m rw rm := h.upd hd _
  obtain ⟨k2, r2⟩ := IntMul.OpenAI.R129.P.NLogN.KFM.descTrP_run_n X rw rm hd hn w m t1 h1
  set D := NLogN.KFM.descTr w (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)
