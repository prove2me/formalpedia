      ∀ w, (cost w : ℝ) ≤ (2 * ((((Nat.log m D + 1) * m : ℕ) : ℝ) *
          NLogN.KFN.cb J.net.length s W A m CR τ (Nat.log m D) + 1) + 1000000 * ((D : ℝ) + 2)) *
        ((AModel.vol (Butterfly.layerShape P K D S) : ℕ) : ℝ) *
        (NLogN.KFN.Xf r Ψ (w + 2 * D + (Nat.log m D + 1) * m * NLogN.KFN.DWb J.net.length s W A (Nat.log m D) +
          NLogN.KFN.Whb J.net.length s W A (Nat.log m D) + 2) : ℝ) := by
  set L := J.net.length
  set k := Nat.log m D
  set n := AModel.vol (Butterfly.layerShape P K D S) with hndef
  have hnv : n = P * (2 ^ K) ^ D * S := NLogN.KFH.vol_layer P K D S
  have hn1 : 1 ≤ n := by
    rw [hnv]; have := Nat.one_le_two_pow (n := K * D)
    rw [← pow_mul]; nlinarith [Nat.mul_le_mul hP hS]
  have hZ12 : NLogN.zsz ((12 * (n * r)) : ℕ) ≤ Z := le_trans (NLogN.KIL.zsz_nat_le (by omega)) hZ
  have hZ2 : NLogN.zsz ((2 * (n * r)) : ℕ) ≤ Z := le_trans (NLogN.KIL.zsz_nat_le (by omega)) hZ
  have hk : D < m ^ (k + 1) := Nat.lt_pow_succ_log_self (by omega) D
  -- common constants
  have hcb0 : 0 ≤ NLogN.KFN.cb L s W A m CR τ k := NLogN.KFN.cb_nonneg hCR k
  have hXge : ∀ v, (1 : ℝ) ≤ (NLogN.KFN.Xf r Ψ v : ℝ) := fun v => by
    have : 1 ≤ NLogN.KFN.Xf r Ψ v := by unfold NLogN.KFN.Xf; have := hZΨ v; omega
    exact_mod_cast this
  have hXm : ∀ a b, a ≤ b → (NLogN.KFN.Xf r Ψ a : ℝ) ≤ (NLogN.KFN.Xf r Ψ b : ℝ) := fun a b h => by
    exact_mod_cast NLogN.KFN.Xf_mono hΨm h
  by_cases hq : D ≤ k * L2
  · -- all kernels
    have LT := NLogN.KFH.limpl_tens (P := P) (S := S) (D := D) hρ hr hS hP NLogN.KFH.MC_ok NLogN.KFH.kerOk_MC Z hZ12
    have H := (NLogN.KFN.sImpl_of_limpl hρ LT).toI (I := Isym) (iprog := iprog) (NLogN.KFH.fok_kersP _ _ _ _ _ _ _ _)
    refine ⟨_, _, _, _, H, by rw [one_mul]; exact Nat.le_add_right _ _,
      Nat.le_add_right _ _, fun w => ?_⟩
    have c1 := NLogN.KFN.ck_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + 2 * D) hn1 hZΨ
    have q : D * NLogN.KFH.ck (n * r) Z (w + 2 * D) + 1 ≤ 100000 * (D + 1) * n *
        NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2) := by
      have x1 : NLogN.KFN.Xf r Ψ (w + 2 * D + 2) ≤ NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2) :=
        NLogN.KFN.Xf_mono hΨm (by omega)
      have := Nat.mul_le_mul_left D (c1.trans (Nat.mul_le_mul_left _ x1))
      have h1 : 1 ≤ NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2) := by
        unfold NLogN.KFN.Xf; have := hZΨ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2); omega
      have : 1 ≤ n * NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2) := Nat.mul_le_mul hn1 h1
      nlinarith
    have q' : ((D * NLogN.KFH.ck (n * r) Z (w + 2 * D) + 1 : ℕ) : ℝ) ≤ 100000 * ((D : ℝ) + 1) * (n : ℝ) *
        (NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2) : ℝ) := by exact_mod_cast q
    refine q'.trans ?_
    have hX0 := hXge (w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2)
    have hn0 : (0 : ℝ) ≤ n := by positivity
    have : 100000 * ((D : ℝ) + 1) ≤ 2 * (((((k + 1) * m : ℕ)) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) +
        1000000 * ((D : ℝ) + 2) := by
      have : (0 : ℝ) ≤ ((((k + 1) * m : ℕ)) : ℝ) * NLogN.KFN.cb L s W A m CR τ k := by positivity
      nlinarith
    apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right this hn0) (by linarith)
  · -- top kernels, then digit pieces on the padded low part
    push Not at hq
    set q0 := k * L2 with hq0def
    have hq0 : q0 ≤ D := by omega
    set D' := D - q0 with hD'def
    have hD'1 : 1 ≤ D' := by omega
    have hK : 1 ≤ K := by omega
    set t' := K * D'
    set B := P * 2 ^ (K * q0) with hBdef
    have hnB : n = B * 2 ^ t' * S := by
      rw [hnv, ← pow_mul, hBdef]
      have : K * D = K * q0 + K * D' := by rw [← Nat.mul_add]; congr 1; omega
      rw [this, pow_add]; ring
    -- B ≥ W^k
    have hWkB : W ^ k ≤ B := by
      calc W ^ k ≤ (2 ^ L2) ^ k := Nat.pow_le_pow_left hL2 k
        _ = 2 ^ q0 := by rw [← pow_mul, hq0def, mul_comm]
        _ ≤ 2 ^ (K * q0) := Nat.pow_le_pow_right (by norm_num) (Nat.le_mul_of_pos_left _ hK)
        _ ≤ B := Nat.le_mul_of_pos_left _ hP
    set Wk := W ^ k
    have hWk1 : 1 ≤ Wk := Nat.one_le_pow _ _ (by omega)
    set B' := Wk * ((B + Wk - 1) / Wk) with hB'def
    have hB'ge : B ≤ B' := by
      have h1 := Nat.div_add_mod (B + Wk - 1) Wk
      have h2 := Nat.mod_lt (B + Wk - 1) (by omega : 0 < Wk)
      rw [hB'def]; omega
    have hB'le : B' ≤ 2 * B := by
      have h1 := Nat.div_mul_le_self (B + Wk - 1) Wk
      rw [hB'def, mul_comm]; omega
    have hB1 : 1 ≤ B := le_trans hWk1 hWkB
    -- the low positions
    set pos' : Fin D' → ℕ := fun i => ρ + K * (D' - 1 - i) with hpos'def
    have hinj' : Function.Injective pos' := by
      intro a b e
      simp only [hpos'def] at e
      have h1 : K * (D' - 1 - a) = K * (D' - 1 - b) := by omega
      have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
      exact Fin.ext (by have := a.isLt; have := b.isLt; omega)
    have hpos' : ∀ i, pos' i < t' := by
      intro i
      simp only [hpos'def, t']
      have := i.isLt
      have : K * (D' - 1 - i) + K ≤ K * D' := by
        rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
      omega
    have hnp : B * 2 ^ t' * S ≤ B' * 2 ^ t' * S :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hB'ge)
    have hnp2 : B' * 2 ^ t' * S ≤ 2 * n := by
      rw [hnB]
      calc B' * 2 ^ t' * S ≤ (2 * B) * 2 ^ t' * S :=
            Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hB'le)
        _ = 2 * (B * 2 ^ t' * S) := by ring
    have hZlow : NLogN.zsz ((16 * (B' * 2 ^ t' * S * r) : ℕ) : ℤ) ≤ Z := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hZ
      have h1 := Nat.mul_le_mul_left 16 (Nat.mul_le_mul_right r hnp2)
      have e : 32 * (n * r) = 16 * (2 * n * r) := by ring
      rw [e]; exact h1
    have haff' : NLogN.KFN.AffK K t' pos' := by
      refine ⟨ρ + K * (D' - 1), fun i => ?_, ?_⟩
      · simp only [hpos'def]
        have := i.isLt
        rw [add_assoc, ← Nat.mul_add]
        congr 2; omega
      · have hm : (ρ + K * (D' - 1)) % K = ρ := by
          rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hρ]
        rw [hm]
        simp only [t']
        have : K * (D' - 1) + K = K * D' := by
          rw [← Nat.mul_succ]; congr 1; omega
        omega
    obtain ⟨cl, el, dl, kl, Hl, hel, hdl, hkl⟩ := NLogN.KFN.cLow J hGc hrow hCR hτ hW hsW
      (le_trans (by norm_num) hm) hr hΨm hZΨ k D' (lt_of_le_of_lt (Nat.sub_le D q0) hk) pos' hinj' t' S B' hpos' haff' hS
      (le_trans hB1 hB'ge) (dvd_mul_right _ _) hZlow
    have hs' : NLogN.KFN.SLaws (fun i => 2 ^ pos' i * S) (B * 2 ^ t' * S) := NLogN.KFN.slaws_pow pos' hinj' t' S B hpos'
    have hZpad : NLogN.zsz ((2 * ((B' * 2 ^ t' * S - B * 2 ^ t' * S) * r) : ℕ) : ℤ) ≤ Z := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hZ
      have h1 : (B' * 2 ^ t' * S - B * 2 ^ t' * S) * r ≤ B' * 2 ^ t' * S * r :=
        Nat.mul_le_mul_right _ (Nat.sub_le _ _)
      have h2 := Nat.mul_le_mul_right r hnp2
      have e : 32 * (n * r) = 2 * (16 * n * r) := by ring
      rw [e]
      apply Nat.mul_le_mul_left
      calc (B' * 2 ^ t' * S - B * 2 ^ t' * S) * r ≤ 2 * n * r := h1.trans h2
        _ ≤ 16 * n * r := by
          apply Nat.mul_le_mul_right; omega
    have HP := NLogN.KFN.sImpl_pad hs' hnp Hl Z hZpad
    have hst : (fun i : Fin D' => 2 ^ pos' i * S) = (fun i : Fin D => NLogN.KFH.stT K D S ρ i) ∘ NLogN.KFN.lowE hq0 := by
      funext i
      simp only [Function.comp_apply, hpos'def]
      rw [NLogN.KFN.stT_low hq0 i]
    rw [hst, ← hnB] at HP
    have HL := NLogN.KFN.sImpl_subOp (NLogN.KFN.lowE_inj hq0) HP
    rw [NLogN.KFN.subOp_tens (NLogN.KFN.lowE_inj hq0)] at HL
    -- the top kernels
    have LT := NLogN.KFH.limpl_kers (P := P) (S := S) (D := D) hρ hr hS hP NLogN.KFH.MC_ok NLogN.KFH.kerOk_MC Z hZ12 (NLogN.KFN.topL D q0 hq0)
    have HT := (NLogN.KFN.sImpl_of_limpl hρ LT).toI (I := Isym) (iprog := iprog) (NLogN.KFH.fok_kersP _ _ _ _ _ _ _ _)
    rw [← hndef] at HT
    have hTT : (((NLogN.KFN.topL D q0 hq0).map fun i => Butterfly.kerAt i Butterfly.Cm).map Butterfly.tensF).prod =
        Butterfly.tensF (fun i : Fin D => if i ∈ NLogN.KFN.topL D q0 hq0 then Butterfly.Cm else 1) := by
      rw [← Butterfly.tensF_list_prod]
      congr 1; funext i
      rw [List.map_map]
      have := Butterfly.list_prod_kerAt Butterfly.Cm i (NLogN.KFN.topL D q0 hq0) (NLogN.KFN.nodup_topL hq0)
      rw [List.map_map] at this
      exact this
    have HT' := HT.congrT hTT
    have hsL : NLogN.KFN.SLaws (fun i : Fin D => NLogN.KFH.stT K D S ρ i) n := by
      have := NLogN.KFN.slaws_layer (P := P) (D := D) (S := S) hρ
      rw [hnv]; exact this
    have HC := HT'.comp hsL HL
    rw [← Butterfly.tensF_mul] at HC
    have HC' := HC.congrT (show Butterfly.tensF _ = (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) by
      unfold Butterfly.tens; congr 1; funext i
      by_cases hi : i.val < q0
      · have h1 : ¬ ∃ q, NLogN.KFN.lowE hq0 q = i := by
          rintro ⟨q, hq⟩
          have := congrArg Fin.val hq
          simp only [NLogN.KFN.lowE] at this
          omega
        have h2 : i ∈ NLogN.KFN.topL D q0 hq0 := (NLogN.KFN.mem_topL hq0 i).2 hi
        simp [h1, h2]
      · have h1 : ∃ q, NLogN.KFN.lowE hq0 q = i :=
          ⟨⟨i.val - q0, by omega⟩, Fin.ext (by simp only [NLogN.KFN.lowE]; omega)⟩
        have h2 : i ∉ NLogN.KFN.topL D q0 hq0 := fun h => hi ((NLogN.KFN.mem_topL hq0 i).1 h)
        simp [h1, h2])
    rw [NLogN.KFN.length_topL] at HC'
    refine ⟨_, _, _, _, HC', ?_, ?_, fun w => ?_⟩
    · have := hel
      linarith
    · have := hdl
      linarith
    · -- cost
      set Wf := w + 2 * D + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k + 2
      have c1 := NLogN.KFN.ck_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + 2 * q0) hn1 hZΨ
      have x1 : NLogN.KFN.Xf r Ψ (w + 2 * q0 + 2) ≤ NLogN.KFN.Xf r Ψ Wf := NLogN.KFN.Xf_mono hΨm (by omega)
      have cT : q0 * NLogN.KFH.ck (n * r) Z (w + 2 * q0) + 1 ≤ 100000 * (q0 + 1) * n * NLogN.KFN.Xf r Ψ Wf := by
        have h0 := Nat.mul_le_mul_left q0 (c1.trans (Nat.mul_le_mul_left _ x1))
        have h1 : 1 ≤ NLogN.KFN.Xf r Ψ Wf := by unfold NLogN.KFN.Xf; have := hZΨ Wf; omega
        have h2 : 1 ≤ n * NLogN.KFN.Xf r Ψ Wf := Nat.mul_le_mul hn1 h1
        have e : 100000 * (q0 + 1) * n * NLogN.KFN.Xf r Ψ Wf = q0 * (100000 * n * NLogN.KFN.Xf r Ψ Wf) +
            100000 * (n * NLogN.KFN.Xf r Ψ Wf) := by ring
        rw [e]
        linarith
      have cP := NLogN.KFN.cPadC_X (r := r) (Ψ := Ψ) (Z := Z) (n := n) (np := B' * 2 ^ t' * S)
        (w := w + 2 * q0) (dw := dl) kl hn1 hr hnp2 hΨm hZΨ hZ2
      have x2 : NLogN.KFN.Xf r Ψ (w + 2 * q0 + dl) ≤ NLogN.KFN.Xf r Ψ Wf := NLogN.KFN.Xf_mono hΨm (by
        have h1 := hdl; have h2 := hq0
        have h3 : dl ≤ (k + 1) * m * NLogN.KFN.DWb L s W A k := h1
        simp only [Wf]; omega)
      have cP' : NLogN.KFN.cPadC (2 * (n * r)) (2 * ((B' * 2 ^ t' * S - n) * r)) Z
          (w + 2 * q0) dl kl ≤ kl (w + 2 * q0) + 100000 * n * NLogN.KFN.Xf r Ψ Wf :=
        cP.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ x2) _)
      have hkl' := hkl (w + 2 * q0)
      have x3 : (NLogN.KFN.Xf r Ψ (w + 2 * q0 + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) : ℝ) ≤
          (NLogN.KFN.Xf r Ψ Wf : ℝ) := hXm _ _ (by omega)
      have hnp' : ((B' * 2 ^ t' * S : ℕ) : ℝ) ≤ 2 * (n : ℝ) := by exact_mod_cast hnp2
      have hX0 : (0 : ℝ) ≤ (NLogN.KFN.Xf r Ψ Wf : ℝ) := by have := hXge Wf; linarith
      have hc0 : (0 : ℝ) ≤ ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) := by positivity
      have k1 : (kl (w + 2 * q0) : ℝ) ≤ 2 * ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) *
          (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) := by
        refine hkl'.trans ?_
        calc ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) * ((B' * 2 ^ t' * S : ℕ) : ℝ) *
              (NLogN.KFN.Xf r Ψ (w + 2 * q0 + (k + 1) * m * NLogN.KFN.DWb L s W A k + NLogN.KFN.Whb L s W A k) : ℝ)
            ≤ ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) * (2 * (n : ℝ)) *
              (NLogN.KFN.Xf r Ψ Wf : ℝ) := by
              apply mul_le_mul (mul_le_mul_of_nonneg_left hnp' hc0) x3 (by positivity)
                (by positivity)
          _ = _ := by ring
      have cT' : ((q0 * NLogN.KFH.ck (n * r) Z (w + 2 * q0) + 1 : ℕ) : ℝ) ≤
          100000 * ((q0 : ℝ) + 1) * (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) := by exact_mod_cast cT
      have cP'' : (NLogN.KFN.cPadC (2 * (n * r)) (2 * ((B' * 2 ^ t' * S - n) * r)) Z
          (w + 2 * q0) dl kl : ℝ) ≤ (kl (w + 2 * q0) : ℝ) + 100000 * (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) := by
        exact_mod_cast cP'
      have hq0D : (q0 : ℝ) ≤ D := by exact_mod_cast hq0
      have hnX : (0 : ℝ) ≤ (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) := by positivity
      show ((q0 * NLogN.KFH.ck (n * r) Z (w + 2 * q0) + 1 +
        NLogN.KFN.cPadC (2 * (n * r)) (2 * ((B' * 2 ^ t' * S - n) * r)) Z (w + 2 * q0) dl kl : ℕ) : ℝ) ≤ _
      rw [Nat.cast_add]
      have hfin : 100000 * ((q0 : ℝ) + 1) + 100000 ≤ 1000000 * ((D : ℝ) + 2) := by linarith
      have e1 : (2 * ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) + 1000000 * ((D : ℝ) + 2)) *
          (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) = 2 * ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) *
          (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) + 1000000 * ((D : ℝ) + 2) * ((n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ)) := by ring
      have e2 : 100000 * ((q0 : ℝ) + 1) * (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ) + 100000 * (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ)
          = (100000 * ((q0 : ℝ) + 1) + 100000) * ((n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ)) := by ring
      have e3 := mul_le_mul_of_nonneg_right hfin hnX
      show _ ≤ (2 * ((((k + 1) * m : ℕ) : ℝ) * NLogN.KFN.cb L s W A m CR τ k + 1) + 1000000 * ((D : ℝ) + 2)) *
          (n : ℝ) * (NLogN.KFN.Xf r Ψ Wf : ℝ)
      rw [e1]
      linarith
end
