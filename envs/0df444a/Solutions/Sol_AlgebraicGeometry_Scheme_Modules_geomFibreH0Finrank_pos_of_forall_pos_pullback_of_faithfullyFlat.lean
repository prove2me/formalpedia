theorem solution
    {S S' : Type u} [CommRing S] [CommRing S'] [Algebra S S'] [Module.FaithfullyFlat S S']
    {A A' : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of S)) [IsProper f] (f' : A' ⟶ Spec (CommRingCat.of S'))
    (g : A' ⟶ A) (hg : IsPullback g f' f (Spec.map (CommRingCat.ofHom (algebraMap S S'))))
    (M : A.Modules) (hM : Scheme.Modules.IsInvertible M)
    (h : ∀ (k' : Type u) [Field k'] [IsAlgClosed k'] (sk' : S' →+* k'),
      0 < Scheme.Modules.geomFibreH0Finrank f' ((Scheme.Modules.pullback g).obj M) k' sk')
    (k : Type u) [Field k] [IsAlgClosed k] (sk : S →+* k) :
    0 < Scheme.Modules.geomFibreH0Finrank f M k sk := by
  classical

  letI : Algebra S k := sk.toAlgebra

  haveI : Nontrivial (S' ⊗[S] k) := Module.FaithfullyFlat.lTensor_nontrivial S S' k
  obtain ⟨m, hm⟩ := Ideal.exists_maximal (S' ⊗[S] k)
  let κ : Type u := (S' ⊗[S] k) ⧸ m
  letI : Field κ := Ideal.Quotient.field m
  let k' : Type u := AlgebraicClosure κ
  let q : S' ⊗[S] k →+* k' := (algebraMap κ k').comp (Ideal.Quotient.mk m)
  let j : k →+* k' := q.comp (Algebra.TensorProduct.includeRight (R := S) (A := S') (B := k)).toRingHom
  let sk' : S' →+* k' := q.comp (Algebra.TensorProduct.includeLeftRingHom (R := S) (A := S') (B := k))

  have hcomp : sk'.comp (algebraMap S S') = j.comp sk := by
    ext s
    simp only [sk', j, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    congr 1
    change (algebraMap S S' s) ⊗ₜ[S] (1 : k) = (1 : S') ⊗ₜ[S] (sk s)
    rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
    rfl

  have h1 := Scheme.Modules.geomFibreH0Finrank_comp_eq f M hM k k' sk j
  have h2 := Scheme.Modules.geomFibreH0Finrank_eq_of_isPullback (algebraMap S S') f f' g hg M
    ((Scheme.Modules.pullback g).obj M) (Iso.refl _) k' sk'
  rw [← h1, ← hcomp, ← h2]
  exact h k' sk'

