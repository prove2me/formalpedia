      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(243/50000:ℝ)^2/24 < 2*(97/200:ℝ)/(1-(97/200:ℝ)^2)^2)
