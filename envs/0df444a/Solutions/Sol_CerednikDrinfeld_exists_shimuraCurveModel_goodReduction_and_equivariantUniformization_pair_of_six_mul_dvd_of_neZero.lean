    {ad bd : ℚ} (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
