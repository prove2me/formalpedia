    (by rw [k2 _ (by decide), k1 _ (by decide), vQN])
    (by rw [k2 _ (by decide), k1 _ (by decide), vP])
    (by rw [k2 _ (by decide), v1R])
    (by rw [k2 _ (by decide), k1 _ (by decide), vGR, hgr])
    (by rw [k2 _ (by decide), k1 _ (by decide), vS])
    ⟨LP, by rw [F2n _ (by decide), FP]⟩ ⟨LS, by rw [F2n _ (by decide), FS]⟩
    (by rw [F2n _ (by decide), F23]) (by rw [F2n _ (by decide), F8])
    (by rw [F2n _ (by decide), F9]) (by rw [F2n _ (by decide), F10])
    (by rw [F2n _ (by decide), F11]) (by rw [hF2, Function.update_self, NLogN.KIL.padL_enc2])
    hn1 hys'l hV'M hmM hB1
  set zs := AModelL12.runPieces (AModelL12.pieceStep child P R' G' Suf q m n) (fun j => m ^ j) 0 (AModelL12.pieceLevels m n) ys'
    with hzs
  have hzsl : zs.length = V' := NLogN.KIL.runPieces_length hlenP _ _ _ hys'l
  -- 4. removing the row padding
  have k3 : ∀ i, i ∉ [NLogN.KIL.aJ, NLogN.KIL.aNN, NLogN.KIL.aQO, NLogN.KIL.aQM, NLogN.KIL.aTw, NLogN.KIL.aY, NLogN.KIL.aL, NLogN.KIL.aDg] → v3 i = v2 i := fr3
  set F3 := Function.update F2 0 (NLogN.KIL.enc2 zs) with hF3
  have F3n : ∀ i, i ≠ 0 → F3 i = F i := fun i hi => by
    rw [hF3, Function.update_of_ne hi, F2n i hi]
  have kk : ∀ i, i ∈ [NLogN.KIL.kP, NLogN.KIL.kS, NLogN.KIL.aQR, NLogN.KIL.aRp, NLogN.KIL.aQN, NLogN.KIL.aGR] → v3 i = v1 i := by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;>
      rw [k3 _ (by decide), k2 _ (by decide)]
  obtain ⟨d1, d2, d3, -, d5⟩ := NLogN.KIL.padE_row (F := F3) (v := v3) (M := M)
    (by rw [F3n _ (by decide)]; exact FP) (by rw [F3n _ (by decide)]; exact FS)
    (by rw [kk _ (by decide), k1 _ (by decide), vP]) (by rw [kk _ (by decide), k1 _ (by decide), vS])
    (by rw [kk _ (by decide), k1 _ (by decide), vQR]) (by rw [kk _ (by decide), v1R])
    (by rw [kk _ (by decide), k1 _ (by decide), vQN]) (by rw [kk _ (by decide), k1 _ (by decide), vGR])
    hP1 hQr1 hRge hQn1 hgr1 hS1 (by rw [← hY, ← hV']; exact hV'M)
  have S4 := NLogN.KIL.unpadS_sp s F3 v3 hM hv3 (.reg NLogN.KIL.kP) NLogN.KIL.bR NLogN.KIL.zR NLogN.KIL.tUR d1 d2 d3 d5 (X := P) (Fa := q ^ r)
    (Fb := R') (Y := Y)
    (by simp [NLogN.KIL.NE.val, kk NLogN.KIL.kP (by decide), k1 NLogN.KIL.kP (by decide), vP])
    (by simp [NLogN.KIL.bR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide), kk NLogN.KIL.aGR (by decide),
      kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide),
      k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.zR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.aRp (by decide), v1R, kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide),
      kk NLogN.KIL.aGR (by decide), kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.aQR (by decide), k1 NLogN.KIL.aQN (by decide),
      k1 NLogN.KIL.aGR (by decide), k1 NLogN.KIL.kS (by decide), vQR, vQN, vGR, vS, hY])
    (by simp [NLogN.KIL.tUR, NLogN.KIL.yR, NLogN.KIL.NE.val, kk NLogN.KIL.kP (by decide), kk NLogN.KIL.aQR (by decide), kk NLogN.KIL.aQN (by decide),
      kk NLogN.KIL.aGR (by decide), kk NLogN.KIL.kS (by decide), k1 NLogN.KIL.kP (by decide), k1 NLogN.KIL.aQR (by decide),
      k1 NLogN.KIL.aQN (by decide), k1 NLogN.KIL.aGR (by decide), k1 NLogN.KIL.kS (by decide), vP, vQR, vQN, vGR, vS, hY])
    hRge (by omega) hY1 (by rw [← hV']; exact hV'M) (NLogN.KIL.enc2 zs) (by rw [hF3, Function.update_self])
    (by rw [F3n _ (by decide), F15]) (by rw [F3n _ (by decide), F20])
    (by rw [F3n _ (by decide), F21]) (by rw [NLogN.KIL.length_enc2, hzsl, hV'])
    (NLogN.KIL.bnd_enc2 zs hB1)
  refine ⟨NLogN.KIL.padV v3 P (q ^ r * Y) ((R' - q ^ r) * Y) (P * (q ^ r * Y)),
    NLogN.KIL.padV_bound hv3 (by omega) (by omega) (by omega) (by omega), ?_, ?_⟩
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    rw [NLogN.KIL.padV_frame _ _ _ _ _ i hi.2.2.2.2.2.2.2.2.2.2.1 hi.2.2.2.2.2.2.2.2.2.2.2.1
      hi.2.2.2.2.2.2.2.2.2.2.2.2.1 hi.2.2.2.2.2.2.2.2.2.2.2.2.2,
      k3 i (by simp [hi]), k2 i (by simp [hi]), k1 i (by simp [hi])]
  · have HA := (S1.seq S2).toIRuns (I := I) (iprog := iprog)
    have HB := HA.seq (H3.seq (S4.toIRuns (I := I) (iprog := iprog)))
    refine HB.mono' ?_ ?_
    · congr 2
      rw [hF3, hF2, Function.update_idem, Function.update_idem, NLogN.KIL.unpadL_enc2]
      congr 2
      have hysr : ys.length = AModel.vol (AModelL12.rowShape P (q ^ r) G' Suf q n) := by
        rw [hys, hVq, AModelL12.vol_rowShape]; ring
      have hzr : zs.length = AModel.vol (AModelL12.rowShape P R' G' Suf q n) := hzsl
      rw [← NLogN.KIL.extract_rowShape P G' Suf q n hRge 0 hzr]
      unfold NLogN.KIL.l12mid
      rw [NLogN.KIL.embed_rowShape P G' Suf q n hRge 0 hysr]
    · unfold NLogN.KIL.cMid
      have hc : NLogN.KIL.cPad (P * (R' * Y)) B = NLogN.KIL.cPad V' B := by rw [hV']
      simp only [NLogN.KIL.bR, NLogN.KIL.zR, NLogN.KIL.tR, NLogN.KIL.tUR, NLogN.KIL.yR, NLogN.KIL.NE.size, hc]
      have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
      generalize (B + 2) ^ 2 = X at hX ⊢
      generalize NLogN.KIL.cPad V' B = CP
      generalize NLogN.KIL.cPcs m n cO B = CC
      nlinarith
