  have hj : i / r < xs.length := by
    have h1 := h1; rw [ha.1] at h1
    exact (Nat.div_lt_iff_lt_mul hr).2 h1
  have e1 := ha.2 (i / r) ⟨i % r, Nat.mod_lt _ hr⟩ hj
  have e2 := hb.2 (i / r) ⟨i % r, Nat.mod_lt _ hr⟩ hj
