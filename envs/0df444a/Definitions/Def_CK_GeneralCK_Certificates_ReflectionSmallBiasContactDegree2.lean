  norm_num [phiGroup2,coefficient2,evalContact,evalContactTerm,eval,evalTerm]
  <;> ring

theorem group2_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => evalContact k phiGroup2 (halfSum z) (meanFunction z)) group2 := by
  have hb := ((halfPower2_approximates hk).mul hk (inversePower1_approximates hk hklog)).replacePolynomial
    (body2_eval k)
  have hh := ((coefficient2_approximates k).mul hk hb).replacePolynomial
    (group2_eval k)
  simpa only [evalContact_group2] using hh

