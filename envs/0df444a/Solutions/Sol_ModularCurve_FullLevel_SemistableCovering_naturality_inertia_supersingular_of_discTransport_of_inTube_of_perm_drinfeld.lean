variable {K F : Type*} [Field K] [Field F] [Algebra K F] (g : SemilinearAut K F) (v : Place K F)

theorem mem_smul_iff (f : F) : f ∈ (g • v).toValuationSubring ↔ g⁻¹ • f ∈ v.toValuationSubring := by
  rw [SemilinearAut.smul_toValuationSubring, ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem]

private theorem _root_.AlgebraicCurve.SemilinearAut.PlaceTransport.mem_smul_iff' (f : F) : g • f ∈ (g • v).toValuationSubring ↔ f ∈ v.toValuationSubring := by
  rw [mem_smul_iff, inv_smul_smul]

p2m_export "AlgebraicCurve.SemilinearAut.PlaceTransport" "mem_smul_iff'"
theorem ord_smul' (f : F) : (g • v).ord f = v.ord (g⁻¹ • f) := by
  conv_lhs => rw [← smul_inv_smul g f]
  exact SemilinearAut.ord_smul g v (g⁻¹ • f)

private theorem _root_.AlgebraicCurve.SemilinearAut.PlaceTransport.residue_smul {f : F} (hf : f ∈ v.toValuationSubring) (hf' : g • f ∈ (g • v).toValuationSubring) :
    IsLocalRing.residue (g • v).toValuationSubring ⟨g • f, hf'⟩
      = SemilinearAut.smulResidueRingEquiv g v (IsLocalRing.residue v.toValuationSubring ⟨f, hf⟩) := by
  have h1 : (⟨g • f, hf'⟩ : (g • v).toValuationSubring)
      = SemilinearAut.smulValuationSubringEquiv g v.toValuationSubring ⟨f, hf⟩ := Subtype.ext rfl
  rw [h1]
  show _ = IsLocalRing.ResidueField.mapEquiv (SemilinearAut.smulValuationSubringEquiv g v.toValuationSubring) _
  rw [IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue]
  rfl

p2m_export "AlgebraicCurve.SemilinearAut.PlaceTransport" "residue_smul"
theorem isRational_smul_iff : (g • v).IsRational ↔ v.IsRational := by
  unfold Place.IsRational
  have h : ∀ a, algebraMap K (g • v).ResidueField (SemilinearAut.baseAut g a) =
      SemilinearAut.smulResidueRingEquiv g v (algebraMap K v.ResidueField a) :=
    fun a => (SemilinearAut.smulResidueRingEquiv_algebraMap g v a).symm
  constructor
  · intro hs x
    obtain ⟨b, hb⟩ := hs (SemilinearAut.smulResidueRingEquiv g v x)
    refine ⟨(SemilinearAut.baseAut g).symm b, ?_⟩
    apply (SemilinearAut.smulResidueRingEquiv g v).injective
    rw [← h, RingEquiv.apply_symm_apply, hb]
  · intro hs y
    obtain ⟨x, rfl⟩ := (SemilinearAut.smulResidueRingEquiv g v).surjective y
    obtain ⟨a, ha⟩ := hs x
    exact ⟨SemilinearAut.baseAut g a, by rw [h, ha]⟩

theorem evalAt_smul (hv : v.IsRational) (f : F) :
    (g • v).evalAt (g • f) = SemilinearAut.baseAut g (v.evalAt f) := by
  by_cases hf : f ∈ v.toValuationSubring
  · have hf' : g • f ∈ (g • v).toValuationSubring := (mem_smul_iff' g v f).mpr hf
    have hv' : (g • v).IsRational := (isRational_smul_iff g v).mpr hv
    apply Place.algebraMap_residueField_injective (g • v)
    rw [(g • v).algebraMap_evalAt hv' hf', residue_smul g v hf hf', ← v.algebraMap_evalAt hv hf,
      SemilinearAut.smulResidueRingEquiv_algebraMap]
  · have hf' : g • f ∉ (g • v).toValuationSubring := fun h => hf ((mem_smul_iff' g v f).mp h)
    rw [Place.evalAt, Place.evalAt, dif_neg hf, dif_neg hf', map_zero]

end SemilinearAut.PlaceTransport

