/- BEGIN Definitions.SCAFFOLD.ServerUpdate -/
section SCAFFOLDBundleModule21
/-!
Second moments of the actual SCAFFOLD update. Karimireddy et al.,
arXiv:1910.06378v4, Section 5, PDF p. 5; Appendix E.1, PDF pp. 26-27,
Lemma 12; Appendix E.2, PDF pp. 31-32, Lemma 16.
The update separates round-start true-gradient controls, local drift, and the
centered server oracle noise proved in ServerNoise.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def currentGradient (A : Run P ν S K T ηl ηg init) (r : ℕ) (i : Fin N)
    (ω : Ω) : Space d := gradient (P.f i) (A.x r ω)

def meanStoredSignal (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (N : ℝ)⁻¹ • ∑ i, storedSignal A r i ω

def gradientChange (A : Run P ν S K T ηl ηg init) (r : ℕ) (i : Fin N)
    (ω : Ω) : Space d := averageSignal A r i ω - currentGradient A r i ω

def sampledGradientChange (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, gradientChange A r i ω

def serverBaseSignal (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω,
    (currentGradient A r i ω - storedSignal A r i ω) + meanStoredSignal A r ω

theorem Run.currentGradient_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) : MemLp (currentGradient A r i) 2 ν :=
  P.gradient_memLp_comp i (A.x_memLp r hr)

theorem Run.currentGradient_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r)] (currentGradient A r i) :=
  (P.gradient_lipschitz i).continuous.comp_stronglyMeasurable (A.x_adapted r hr)

theorem Run.gradientChange_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) : MemLp (gradientChange A r i) 2 ν :=
  (A.averageSignal_memLp hr i).sub (A.currentGradient_memLp hr.le i)

theorem Run.gradientChange_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r + K)] (gradientChange A r i) :=
  (A.averageSignal_adapted hr i).sub
    ((A.currentGradient_adapted hr.le i).mono (A.history.mono (Nat.le_add_right _ _)))

theorem Run.sampledGradientChange_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : MemLp (sampledGradientChange A r) 2 ν :=
  A.sample_mean_memLp hr (gradientChange A r) (A.gradientChange_memLp hr)

theorem Run.serverBaseSignal_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : MemLp (serverBaseSignal A r) 2 ν :=
  (A.sample_mean_memLp hr (fun i ω ↦ currentGradient A r i ω - storedSignal A r i ω)
    (fun i ↦ (A.currentGradient_memLp hr.le i).sub (A.storedSignal_memLp hr.le i))).add
    ((memLp_finsetSum Finset.univ (fun i _ ↦ A.storedSignal_memLp hr.le i)).const_smul (N : ℝ)⁻¹)

theorem Run.server_update_decomposed (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : serverDisplacement A r =ᵐ[ν] fun ω ↦
      -(effectiveStep K ηl ηg) • (serverBaseSignal A r ω +
        sampledGradientChange A r ω + serverNoise A r ω) := by
  have hS : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
  filter_upwards [A.server_displacement hr, A.sample_card r hr] with ω hupdate hcard
  have hsum : (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω,
      (averageOracle A r i ω - A.c r i ω + meanControl A r ω) =
      serverBaseSignal A r ω + sampledGradientChange A r ω + serverNoise A r ω := by
    dsimp [serverBaseSignal, sampledGradientChange, gradientChange, serverNoise,
      sampledFreshNoise, fixedFreshNoise, centeredStoredNoise, fixedStoredNoise,
      meanStoredSignal, meanStoredError, storedError]
    simp_rw [← A.averageOracle_sub_signal_eq_noise]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, smul_add, smul_sub,
      Finset.sum_const, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hcard,
      inv_mul_cancel₀ hS, one_smul, meanControl]
    match_scalars <;> field_simp <;> ring
  change A.x (r + 1) ω - A.x r ω = _
  rw [hupdate, sub_sub_cancel_left, div_eq_mul_inv, mul_smul, hsum, neg_smul]

theorem Run.gradientChange_eq_prefix (A : Run P ν S K T ηl ηg init)
    (r : ℕ) (i : Fin N) (ω : Ω) :
    gradientChange A r i ω = (K : ℝ)⁻¹ • prefixGradientChange A r K i ω := by
  dsimp [gradientChange, averageSignal, currentGradient]
  rw [← Fin.sum_univ_eq_sum_range (fun k ↦ clientGradient A r k i ω),
    ← average_sub_const A.steps_pos]
  rfl

theorem Run.gradientChange_second_moment (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (i : Fin N) :
    (∫ ω, ‖gradientChange A r i ω‖ ^ 2 ∂ν) ≤
      P.β ^ 2 * (K : ℝ)⁻¹ * ∑ k : Fin K,
        ∫ ω, ‖A.y r k i ω - A.x r ω‖ ^ 2 ∂ν := by
  simp_rw [A.gradientChange_eq_prefix, norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
  rw [integral_const_mul]
  have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
  calc
    _ ≤ (K : ℝ)⁻¹ ^ 2 * ((K : ℝ) * P.β ^ 2 * ∑ k : Fin K,
        ∫ ω, ‖A.y r k i ω - A.x r ω‖ ^ 2 ∂ν) :=
      mul_le_mul_of_nonneg_left (A.prefixGradientChange_second_moment hr le_rfl i)
        (sq_nonneg _)
    _ = _ := by field_simp

theorem Run.sampledGradientChange_second_moment_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ∫ ω, ‖sampledGradientChange A r ω‖ ^ 2 ∂ν ≤ P.β ^ 2 * driftEnergy A r := by
  have h := A.sample_mean_sq_integral_le hr (gradientChange A r) (A.gradientChange_memLp hr)
    (fun i ↦ (A.gradientChange_adapted hr i).aestronglyMeasurable)
  apply h.trans
  have hs := mul_le_mul_of_nonneg_left
    (Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ A.gradientChange_second_moment hr i))
    (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
  simpa only [driftEnergy, ← Finset.mul_sum, mul_inv_rev, mul_assoc, mul_left_comm,
    mul_comm] using hs

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
theorem integral_norm_add_sq_le_two {X Y : Ω → Space d} (hX : MemLp X 2 ν)
    (hY : MemLp Y 2 ν) :
    (∫ ω, ‖X ω + Y ω‖ ^ 2 ∂ν) ≤
      2 * (∫ ω, ‖X ω‖ ^ 2 ∂ν) + 2 * (∫ ω, ‖Y ω‖ ^ 2 ∂ν) := by
  have hb : Integrable (fun ω ↦ 2 * ‖X ω‖ ^ 2 + 2 * ‖Y ω‖ ^ 2) ν :=
    (hX.norm.integrable_sq.const_mul 2).add (hY.norm.integrable_sq.const_mul 2)
  have h := integral_mono (hX.add hY).norm.integrable_sq hb
    (fun ω ↦ norm_add_sq_le_two (X ω) (Y ω))
  rw [integral_add (hX.norm.integrable_sq.const_mul 2) (hY.norm.integrable_sq.const_mul 2),
    integral_const_mul, integral_const_mul] at h
  exact h

theorem Run.serverSecondMoment_le_base (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    serverSecondMoment A r ≤ effectiveStep K ηl ηg ^ 2 *
      (2 * (∫ ω, ‖serverBaseSignal A r ω‖ ^ 2 ∂ν) +
        4 * P.β ^ 2 * driftEnergy A r + 8 * P.σ ^ 2 / ((K : ℝ) * S)) := by
  have heq := integral_congr_ae ((A.server_update_decomposed hr).fun_comp
    (fun x : Space d ↦ ‖x‖ ^ 2))
  simp only [Function.comp_apply, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs,
    neg_sq, integral_const_mul] at heq
  change serverSecondMoment A r = _ at heq
  rw [heq]
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
  have hsplit := integral_norm_add_sq_le_two (A.serverBaseSignal_memLp hr)
    ((A.sampledGradientChange_memLp hr).add (A.serverNoise_memLp hr))
  have hrest := integral_norm_add_sq_le_two (A.sampledGradientChange_memLp hr)
    (A.serverNoise_memLp hr)
  simp only [Pi.add_apply, ← add_assoc] at hsplit
  have hD := A.sampledGradientChange_second_moment_le hr
  have hW := A.serverNoise_second_moment_le hr
  have hW' : 4 * (∫ ω, ‖serverNoise A r ω‖ ^ 2 ∂ν) ≤
      8 * P.σ ^ 2 / ((K : ℝ) * S) := by
    have h := mul_le_mul_of_nonneg_left hW (by norm_num : (0 : ℝ) ≤ 4)
    convert h using 1 <;> ring
  linarith

theorem Run.currentGradient_gap_energy_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r ≤ T) {xstar : Space d} (hc : Convexity P 0)
    (hx : IsMinimizer P xstar) :
    (N : ℝ)⁻¹ * ∑ i, (∫ ω,
      ‖currentGradient A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) ≤
        2 * P.β * expectedGap A xstar r := by
  have hu (i : Fin N) := ((A.currentGradient_memLp hr i).sub (memLp_const
    (gradient (P.f i) xstar))).norm.integrable_sq
  have h := integral_mono
    ((integrable_finsetSum Finset.univ (fun i _ ↦ hu i)).const_mul (N : ℝ)⁻¹)
    ((A.gap_integrable xstar hr).const_mul (2 * P.β))
    (fun ω ↦ SCAFFOLD.GradientGrowth d N P xstar hc hx (A.x r ω))
  rw [integral_const_mul, integral_finsetSum Finset.univ (fun i _ ↦ hu i),
    integral_const_mul] at h
  exact h

theorem Run.serverBaseSignal_convex (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {xstar : Space d} (hc : Convexity P 0)
    (hx : IsMinimizer P xstar) :
    (∫ ω, ‖serverBaseSignal A r ω‖ ^ 2 ∂ν) ≤
      4 * P.β * expectedGap A xstar r + 2 * controlEnergy A xstar r / S := by
  have hmin : IsLocalMin (objective P.f) xstar := Filter.Eventually.of_forall hx
  have hstar : (N : ℝ)⁻¹ • ∑ i, gradient (P.f i) xstar = 0 := by
    rw [← P.gradient_objective, gradient, hmin.fderiv_eq_zero, map_zero]
  let u (i : Fin N) (ω : Ω) := currentGradient A r i ω - gradient (P.f i) xstar
  let a (i : Fin N) (ω : Ω) := storedSignal A r i ω - gradient (P.f i) xstar
  let U (ω : Ω) := (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, u i ω
  let C (ω : Ω) := (N : ℝ)⁻¹ • ∑ i, a i ω - (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, a i ω
  have hu (i : Fin N) : MemLp (u i) 2 ν :=
    (A.currentGradient_memLp hr.le i).sub (memLp_const _)
  have ha (i : Fin N) : MemLp (a i) 2 ν :=
    (A.storedSignal_memLp hr.le i).sub (memLp_const _)
  have hum (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)] (u i) ν :=
    (((A.currentGradient_adapted hr.le i).mono (A.history.mono (Nat.le_add_right _ _))).sub
      stronglyMeasurable_const).aestronglyMeasurable
  have ham (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)] (a i) ν :=
    (((A.storedSignal_adapted hr.le i).mono (A.history.mono (Nat.le_add_right _ _))).sub
      stronglyMeasurable_const).aestronglyMeasurable
  have hU : MemLp U 2 ν := A.sample_mean_memLp hr u hu
  have hC : MemLp C 2 ν :=
    ((memLp_finsetSum Finset.univ (fun i _ ↦ ha i)).const_smul (N : ℝ)⁻¹).sub
      (A.sample_mean_memLp hr a ha)
  have heq : serverBaseSignal A r = fun ω ↦ U ω + C ω := by
    funext ω
    dsimp [serverBaseSignal, meanStoredSignal, U, C, u, a]
    simp only [Finset.sum_sub_distrib, smul_sub, hstar]
    abel
  have hUb := (A.sample_mean_sq_integral_le hr u hu hum).trans
    (A.currentGradient_gap_energy_le hr.le hc hx)
  have hCb : (∫ ω, ‖C ω‖ ^ 2 ∂ν) ≤ (S : ℝ)⁻¹ * controlEnergy A xstar r := by
    simpa only [C, controlEnergy, a, norm_sub_rev] using
      A.sample_mean_variance_integral_le hr a ha ham
  have hb := integral_norm_add_sq_le_two hU hC
  rw [heq]
  change (∫ ω, ‖U ω‖ ^ 2 ∂ν) ≤ _ at hUb
  calc
    _ ≤ 2 * (∫ ω, ‖U ω‖ ^ 2 ∂ν) + 2 * (∫ ω, ‖C ω‖ ^ 2 ∂ν) := hb
    _ ≤ 2 * (2 * P.β * expectedGap A xstar r) +
        2 * ((S : ℝ)⁻¹ * controlEnergy A xstar r) := by linarith
    _ = _ := by ring

theorem Run.serverBaseSignal_nonconvex (A : Run P ν S K T ηl ηg none)
    {r : ℕ} (hr : r < T) :
    (∫ ω, ‖serverBaseSignal A r ω‖ ^ 2 ∂ν) ≤
      (∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
        P.β ^ 2 * lagEnergy A r / S := by
  let v (i : Fin N) (ω : Ω) := currentGradient A r i ω - storedSignal A r i ω
  let m (ω : Ω) := (N : ℝ)⁻¹ • ∑ i, v i ω
  let Z (ω : Ω) := (S : ℝ)⁻¹ • ∑ i ∈ A.sample r ω, v i ω - m ω
  let G (ω : Ω) := gradient (objective P.f) (A.x r ω)
  have hv (i : Fin N) : MemLp (v i) 2 ν :=
    (A.currentGradient_memLp hr.le i).sub (A.storedSignal_memLp hr.le i)
  have hvm (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)] (v i) ν :=
    (((A.currentGradient_adapted hr.le i).sub (A.storedSignal_adapted hr.le i)).mono
      (A.history.mono (Nat.le_add_right _ _))).aestronglyMeasurable
  have hm : MemLp m 2 ν :=
    (memLp_finsetSum Finset.univ (fun i _ ↦ hv i)).const_smul (N : ℝ)⁻¹
  have hmm : AEStronglyMeasurable[A.history (roundTime K r + K)] m ν :=
    (aestronglyMeasurable_subalgebra_sum hvm Finset.univ).const_smul (N : ℝ)⁻¹
  have hsamp := A.sample_mean_memLp hr v hv
  have hZ : MemLp Z 2 ν := hsamp.sub hm
  have hG : MemLp G 2 ν := P.objectiveGradient_memLp_comp (A.x_memLp r hr.le)
  have hGm : AEStronglyMeasurable[A.history (roundTime K r + K)] G ν := by
    have hLip : LipschitzWith ⟨P.β, P.smoothness_pos.le⟩ (gradient (objective P.f)) :=
      lipschitzWith_iff_norm_sub_le.mpr P.smooth_objective
    exact (hLip.continuous.comp_stronglyMeasurable
      ((A.x_adapted r hr.le).mono (A.history.mono (Nat.le_add_right _ _)))).aestronglyMeasurable
  have hZ0 : ν[Z | A.history (roundTime K r + K)] =ᵐ[ν] 0 := by
    have hmean := A.sample_mean_condExp hr v (fun i ↦ (hv i).integrable (by norm_num)) hvm
    have hself := condExp_of_aestronglyMeasurable' (A.history.le _)
      hmm (hm.integrable (by norm_num))
    have hsub := condExp_sub (hsamp.integrable (by norm_num))
      (hm.integrable (by norm_num)) (A.history (roundTime K r + K))
    filter_upwards [hmean, hself, hsub] with ω hmean hself hsub
    change ν[Z | A.history (roundTime K r + K)] ω = 0
    change ν[Z | A.history (roundTime K r + K)] ω = _ at hsub
    simp only [Pi.sub_apply] at hsub
    rw [hsub, hmean, hself]
    exact sub_self _
  have heq : serverBaseSignal A r = fun ω ↦ G ω + Z ω := by
    funext ω
    dsimp [serverBaseSignal, meanStoredSignal, G, Z, m, v, currentGradient]
    rw [P.gradient_objective]
    simp only [Finset.sum_sub_distrib, smul_sub]
    abel
  have horth := integral_congr_ae
    (FedAvg.condExp_norm_sq_add_centered (A.history.le _) hG hZ hGm hZ0 1)
  simp only [one_smul, one_pow, one_mul] at horth
  rw [integral_condExp (A.history.le _), integral_add hG.norm.integrable_sq integrable_condExp,
    integral_condExp (A.history.le _)] at horth
  have hvar := A.sample_mean_variance_integral_le hr v hv hvm
  have hlag := mul_le_mul_of_nonneg_left (A.signal_current_gradient_energy_le hr.le)
    (inv_nonneg.mpr (Nat.cast_nonneg S : (0 : ℝ) ≤ S))
  have hvar' : (∫ ω, ‖Z ω‖ ^ 2 ∂ν) ≤ P.β ^ 2 * lagEnergy A r / S := by
    exact hvar.trans (by simpa only [div_eq_mul_inv, mul_comm] using hlag)
  rw [heq, horth]
  exact add_le_add le_rfl hvar'

theorem Run.serverSecondMoment_convex (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {xstar : Space d} (hc : Convexity P 0)
    (hx : IsMinimizer P xstar) :
    serverSecondMoment A r ≤ effectiveStep K ηl ηg ^ 2 *
      (8 * P.β * expectedGap A xstar r + 4 * controlEnergy A xstar r / S +
        4 * P.β ^ 2 * driftEnergy A r + 8 * P.σ ^ 2 / ((K : ℝ) * S)) := by
  apply (A.serverSecondMoment_le_base hr).trans
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
  have h := A.serverBaseSignal_convex hr hc hx
  calc
    _ ≤ 2 * (4 * P.β * expectedGap A xstar r + 2 * controlEnergy A xstar r / S) +
        4 * P.β ^ 2 * driftEnergy A r + 8 * P.σ ^ 2 / ((K : ℝ) * S) := by linarith
    _ = _ := by ring

theorem Run.serverSecondMoment_nonconvex (A : Run P ν S K T ηl ηg none)
    {r : ℕ} (hr : r < T) :
    serverSecondMoment A r ≤ effectiveStep K ηl ηg ^ 2 *
      (2 * (∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
        2 * P.β ^ 2 * lagEnergy A r / S + 4 * P.β ^ 2 * driftEnergy A r +
        8 * P.σ ^ 2 / ((K : ℝ) * S)) := by
  apply (A.serverSecondMoment_le_base hr).trans
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
  have h := A.serverBaseSignal_nonconvex hr
  calc
    _ ≤ 2 * ((∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
        P.β ^ 2 * lagEnergy A r / S) + 4 * P.β ^ 2 * driftEnergy A r +
        8 * P.σ ^ 2 / ((K : ℝ) * S) := by linarith
    _ = _ := by ring

end SCAFFOLD
