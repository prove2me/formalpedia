theorem h50i_vol_pos {sh : Shape} {j : ℕ} (h : j < vol sh) : 0 < vol sh := by omega

theorem h50i_encode_decode : ∀ (sh : Shape) (j : ℕ), j < vol sh → encode sh (decode sh j) = j
  | [], j, h => by simp [vol] at h; simp [encode, h]
  | q :: sh, j, h => by
    rw [vol_cons] at h
    have hV : 0 < vol sh := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    have h1 : j / vol sh < q := (Nat.div_lt_iff_lt_mul hV).mpr (by linarith [mul_comm q (vol sh)])
    simp only [decode, encode, List.headD_cons, List.tail_cons]
    rw [h50i_encode_decode sh _ (Nat.mod_lt _ hV), Nat.mod_eq_of_lt h1]
    exact Nat.div_add_mod' j (vol sh)

theorem h50i_decode_encode {sh : Shape} {a : List ℕ} (h : Valid sh a) : decode sh (encode sh a) = a := by
  induction h with
  | nil => simp [decode]
  | @cons x q as sh hx hr ih =>
    have he := encode_lt hr
    have hV : 0 < vol sh := by omega
    simp only [decode, encode, List.headD_cons, List.tail_cons]
    have e1 : (x * vol sh + encode sh as) / vol sh = x := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hV, Nat.div_eq_of_lt he, zero_add]
    have e2 : (x * vol sh + encode sh as) % vol sh = encode sh as := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt he]
    rw [e1, e2, Nat.mod_eq_of_lt hx, ih]

