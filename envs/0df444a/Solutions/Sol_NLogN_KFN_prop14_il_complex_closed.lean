theorem one_le_Rb : 1 ≤ Rb s W m τ := le_max_right _ _

theorem gam_le (hm : 1 ≤ m) (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) (k : ℕ) :
    ((m : ℝ) ^ k + 1) ^ τ ≤ 2 * Rb s W m τ ^ k := by
