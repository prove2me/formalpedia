-- title:
--   Decay of g(E₄²E₆)^m against hΔ^m at the cusps
-- statement:
--   Fix $N \in \mathbb{N}$, a weight $k \in \mathbb{Z}$ and $m \in \mathbb{N}$ with $1 \le m$, and let $g, h$ be modular forms of weight $k$ for $\Gamma_0(N)$ with $h \neq 0$. Let $X$ be a Laurent series over $\mathbb{C}$ satisfying $X \cdot \tilde h = \tilde g$, where $\tilde g, \tilde h$ denote the $q$-expansions of $g$ and $h$ at period $1$, regarded as power series and then as Laurent series. Write $j_q$ for the Laurent series $\mathrm{coeffEmb}\ \mathbb{C}\ \mathrm{jq}$, that is, the coefficientwise image under $\mathbb{Q} \to \mathbb{C}$ of $q^{-1}$ times the power series $\mathrm{jNumQ}$ (the numerator series of the $j$-invariant with rational coefficients). Let $M \in \mathbb{N}$ and assume that $X^{2M} \, j_q^{\,mM+1} \, (j_q - 1728)^{mM}$ is integral over the $\mathbb{C}$-subalgebra of $\mathbb{C}((q))$ generated by $j_q^{-1}$. Then for every $A \in \mathrm{SL}_2(\mathbb{Z})$ and every real $\varepsilon > 0$, one has, for $\tau$ eventually in the filter $\mathrm{atImInfty}$ on the upper half-plane,
--   $$\bigl\| \bigl((z \mapsto g(z)\,(E_4(z)^2 E_6(z))^m)\bigr|_{k+14m} A\bigr)(\tau) \bigr\| \le \varepsilon \, \bigl\| \bigl((z \mapsto h(z)\,\Delta(z)^m)\bigr|_{k+12m} A\bigr)(\tau) \bigr\|,$$
--   the slash being the weight-$(k+14m)$, resp. weight-$(k+12m)$, action of the image of $A$ in $\mathrm{GL}_2(\mathbb{R})$.
--
--   This is the analytic half of the criterion that turns integrality of $X^{2M} j^{mM+1}(j-1728)^{mM}$ over $\mathbb{C}[1/j]$ into vanishing at the cusps: the order of $X$ in the local parameter at the cusp $A\infty$ exceeds the pole order of the relevant power of $j$, so the quotient $g(E_4^2E_6)^m/(h\Delta^m)$ tends to $0$ there. It is used by [`ModularCurve.exists_cuspForm_qExpansion_eq_mul_thetaL_pow_of_isIntegral`](thm.html#ModularCurve.exists_cuspForm_qExpansion_eq_mul_thetaL_pow_of_isIntegral) to produce a cusp form with prescribed $q$-expansion.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_eventually_norm_slash_le_of_isIntegral_adjoin_coeffEmb_jq_inv_pow.lean

import Mathlib
import Definitions.Def_ModularCurve_X0
import Definitions.Def_ModularCurve_LaurentCoeff

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve
open scoped MatrixGroups ModularForm

theorem ModularCurve.eventually_norm_slash_le_of_isIntegral_adjoin_coeffEmb_jq_inv_pow (N : ℕ) {k : ℤ} (m : ℕ) (hm : 1 ≤ m)
    (g h : ModularForm (CongruenceSubgroup.Gamma0 N) k) (hh : h ≠ 0) (X : LaurentSeries ℂ)
    (hX : X * ((UpperHalfPlane.qExpansion 1 (h : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ) = ((UpperHalfPlane.qExpansion 1 (g : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ)) (M : ℕ)
    (h₂ : IsIntegral (Algebra.adjoin ℂ ({(ModularCurve.coeffEmb ℂ ModularCurve.jq)⁻¹} : Set (LaurentSeries ℂ)))
      (X ^ (2 * M) * ModularCurve.coeffEmb ℂ ModularCurve.jq ^ (m * M + 1) * (ModularCurve.coeffEmb ℂ ModularCurve.jq - algebraMap ℂ (LaurentSeries ℂ) 1728) ^ (m * M)))
    (A : Matrix.SpecialLinearGroup (Fin 2) ℤ) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ τ : UpperHalfPlane in UpperHalfPlane.atImInfty,
      ‖((fun z : UpperHalfPlane => g z * (ModularForm.E₄ z ^ 2 * ModularForm.E₆ z) ^ m) ∣[k + 14 * (m : ℤ)] (A : GL (Fin 2) ℝ)) τ‖ ≤
        ε * ‖((fun z : UpperHalfPlane => h z * ModularForm.discriminant z ^ m) ∣[k + 12 * (m : ℤ)] (A : GL (Fin 2) ℝ)) τ‖ := by sorry
