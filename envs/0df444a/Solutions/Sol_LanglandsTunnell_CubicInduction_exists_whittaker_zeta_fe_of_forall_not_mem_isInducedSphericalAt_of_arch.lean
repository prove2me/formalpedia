open IsDedekindDomain NumberField

private theorem coe_eq_mk_of_infPart_eq_of_finPart_eq_one (x : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (u : (InfiniteAdeleRing ℚ)ˣ)
    (h₁ : M4aHerbrand.infPart x = u) (h₂ : RatIdele.finPart x = 1) :
    ((x : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ) = ((u : InfiniteAdeleRing ℚ), 1) := by
  refine Prod.ext ?_ ?_
  · exact congrArg Units.val h₁
  · exact congrArg Units.val h₂

private theorem coe_apply_eq_of_forall_infPart_eq_and_finPart_eq_one
    (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hE : ∀ u : (InfiniteAdeleRing ℚ)ˣ,
    M4aHerbrand.infPart (E u) = u ∧ RatIdele.finPart (E u) = 1)
    (u : (InfiniteAdeleRing ℚ)ˣ) :
    ((E u : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ) = ((u : InfiniteAdeleRing ℚ), 1) :=
  coe_eq_mk_of_infPart_eq_of_finPart_eq_one (E u) u (hE u).1 (hE u).2

end LanglandsTunnell.CubicInduction.ArchIdeleCoe

