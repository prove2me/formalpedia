/-! ## Derivatives along the family -/

/-! ## The charge-drift combination `q₂` and `anchor_q` -/

/-- The accepted physical anchor identity sends `q₂` to `0` — it is **not** assumed. -/
theorem q2A_eq_zero (j : ℝ) {R : ℝ} (hR : 3 < R) : q2A j R = 0 := by
  have hR0 : (R:ℝ) ≠ 0 := by linarith
  have h := anchor_q j (R := R) (by linarith)
  unfold q2A e2A
  rw [h]
  simp only [v1f, b1f]
  field_simp
  ring

/-! ## The `ε`-coefficients of the corrected, denominator-cleared `ell` expression -/

/-! ## The `ε`-linear coefficient vanishes -/

/-! ## The `ε³` coefficient is the source defect -/

/-- `r3_j(1/R)/R = R³(u+z) v₁'` — the real source read back on the exterior. -/
theorem r3j_div_eq (j : ℝ) {R : ℝ} (hR : 3 < R) :
    r3j j (1 / R) / R = R ^ 3 * (uA j R + zA j R) * deriv (v1f j) R := by
  have hR0 : (R:ℝ) ≠ 0 := by linarith
  have hr := r3phys_eq j hR
  have hU : Utilde j R = uA j R := (uA_eq_Utilde j hR).symm
  have hZ : Ztilde j R = zA j R := (zA_eq_Ztilde j hR).symm
  unfold r3phys at hr
  rw [hU, hZ] at hr
  rw [← hr]
  simp only [v1f]
  field_simp

