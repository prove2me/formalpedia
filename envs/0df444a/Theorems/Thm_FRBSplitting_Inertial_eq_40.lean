-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-09T13:43:51.332986+00:00
-- url     : https://prove2.me/theorems/80e9969c-53f9-455a-a28c-6b30773a6273
-- title:
--   (40), proof of Lemma 4.2, p. 13 — the energy inequality with (1 − β)b_k
-- statement:
--   In the setting of Lemma 4.2 (without the Lipschitz hypothesis on $B'$): $A$ monotone with resolvents $J_{\gamma A}$, $B$ monotone, $\alpha\ge0$, $\beta,\lambda>0$, $B'=B-\frac\alpha\lambda I$, $x\in(A+B)^{-1}(0)$, $(x_k),(z_k)$ generated by (34), and $b_k=2\lambda\langle B(x)-B(x_k),x-x_k\rangle$. Then for every $k\in\mathbb N$
--
--   $$\begin{aligned}(1-\alpha)\|x_{k+1}-x\|^2&+2\lambda\langle B'(x_{k+1})-B'(x_k),x-x_{k+1}\rangle+b_{k+1}\\ &\le(1-\alpha)\|x_k-x\|^2+2\lambda\langle B'(x_k)-B'(x_{k-1}),x-x_k\rangle+(1-\beta)b_k\\ &\quad+2\lambda\langle B'(x_k)-B'(x_{k-1}),x_k-z_{k+1}\rangle-\Big(\frac{2-\beta}{\beta}-\alpha\Big)\|x_{k+1}-x_k\|^2.\end{aligned}$$
--
--   Lemma 4.2 follows by estimating the second-last term with the Lipschitz constant of $B'$ and dropping the factor $1-\beta$. The coefficient $1-\beta$ in front of $b_k$ is what makes $\sum_k\beta b_k<\infty$ available in the final step of the proof of Theorem 4.3.
--
--   **Formalization Note.** Index shift as in Lemma 4.2: paper $z_{k+1}$ is `z (k+2)`. $A$ is only assumed monotone and $H$ need not be complete.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 13, (40), proof of Lemma 4.2

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_Inertial_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.Inertial

theorem eq_40 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B : H → H) (J : ℝ → H → H) (α β lam : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B)
    (hα : 0 ≤ α) (hβ : 0 < β) (hlam : 0 < lam)
    (x z : ℕ → H) (hrun : IsRelaxedInertialRun J B α β lam x z)
    (xs : H) (hxs : xs ∈ FRBSplitting.Weak.zeroSet A B) :
    ∀ k : ℕ,
      (1 - α) * ‖x (k + 2) - xs‖ ^ 2
          + 2 * lam * ⟪shiftOp B (α / lam) (x (k + 2)) - shiftOp B (α / lam) (x (k + 1)),
              xs - x (k + 2)⟫_ℝ
          + 2 * lam * ⟪B xs - B (x (k + 2)), xs - x (k + 2)⟫_ℝ ≤
        (1 - α) * ‖x (k + 1) - xs‖ ^ 2
          + 2 * lam * ⟪shiftOp B (α / lam) (x (k + 1)) - shiftOp B (α / lam) (x k),
              xs - x (k + 1)⟫_ℝ
          + (1 - β) * (2 * lam * ⟪B xs - B (x (k + 1)), xs - x (k + 1)⟫_ℝ)
          + 2 * lam * ⟪shiftOp B (α / lam) (x (k + 1)) - shiftOp B (α / lam) (x k),
              x (k + 1) - z (k + 2)⟫_ℝ
          - ((2 - β) / β - α) * ‖x (k + 2) - x (k + 1)‖ ^ 2 := by sorry

end FRBSplitting.Inertial
