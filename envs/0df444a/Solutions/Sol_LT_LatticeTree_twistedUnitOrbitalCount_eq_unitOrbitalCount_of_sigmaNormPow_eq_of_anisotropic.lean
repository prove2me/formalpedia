    exists_isUnit_quadNorm_and_mul_pow_eq hprime (Y.map ι.toBase) h₁ h₂ hne hw hwu x m u hN xF hxF

  have hδ₁ : IsUnit (QExt.toMat (Y.map ι.toBase) y) := by
