-- title:
--   Projections of $K$ blocks
-- statement:
--   A **projection of $K$ blocks** is a product of $K$ independent random projections, one per block. Each fixes every leaf except one free leaf carrying the block's free variable, and it is sampled independently of all free values. Here, block $i$ has a finite leaf type and a distribution on pairs (free leaf, values of the leaves), and the value given at the free leaf is ignored. `prodInput` is the input at given free values, and `prodProb` is the probability of an event under the product distribution.
-- source:
--   Mantri, Classical Verification of Quantum Computation Beyond the Polynomial Hierarchy, arXiv:2610.37635 (PDF sha256 d1fab777…1d0b33), §6.3, p. 29 (PDF p. 31)

import Mathlib

namespace MantriCVQ

/-- The input `X` generated by an outcome `ω` of a projection of `K` blocks and free values `z`
(Mantri, arXiv:2610.37635 (PDF sha256 d1fab777…1d0b33), §6.3, p. 29 (PDF p. 31)). The outcome of block
`i` is a free leaf and values for the other leaves (the value given at the free leaf is ignored); a
leaf is a block and a leaf of that block. -/
def prodInput {K : ℕ} {Λ : Fin K → Type} [∀ i, DecidableEq (Λ i)]
    (ω : ∀ i, Λ i × (Λ i → Bool)) (z : Fin K → Bool) : (Σ i, Λ i) → Bool :=
  fun p => if p.2 = (ω p.1).1 then z p.1 else (ω p.1).2 p.2

open Classical in
/-- The probability of an event under a projection of `K` blocks (§6.3, p. 29: "a projection `ρ` of
`K` blocks is a product of `K` independent random projections, one per block. Each fixes every leaf
except one free leaf carrying the block's free variable, and is sampled independently of all free
values"): block `i` has its own distribution `π i`, and the blocks are independent. -/
noncomputable def prodProb {K : ℕ} {Λ : Fin K → Type} [∀ i, Fintype (Λ i)] [∀ i, DecidableEq (Λ i)]
    (π : ∀ i, PMF (Λ i × (Λ i → Bool))) (E : (∀ i, Λ i × (Λ i → Bool)) → Prop) : ℝ :=
  ∑ ω : ∀ i, Λ i × (Λ i → Bool), if E ω then ∏ i, (π i (ω i)).toReal else 0

end MantriCVQ


