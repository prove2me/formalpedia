-- title:
--   Theorem 3.8: recursive canonical-idempotent interpolation
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Let $(J_i)$ be separating, with content scalars $c_T(i)$. For a positive-length path $T\in\operatorname{Tab}(n)$ define
--
--   $$P_T(x)=\prod_{S\in\operatorname{Tab}(n),\ \bar S=\bar T,\ S\ne T}\frac{x-c_S(n)}{c_T(n)-c_S(n)}.$$
--
--   Writing $T[i]$ for the prefix of length $i$, one has
--
--   $$\epsilon_T=\epsilon_{\bar T}P_T(J_n),\qquad\epsilon_T=\prod_{i=1}^n P_{T[i]}(J_i).$$
--
--   The first equality is for $n\ge1$; the full product includes $n=0$ by the empty-product convention. All inclusions are the tower inclusions.
--
--   These formulas recursively construct canonical path idempotents using only separation.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 14, Theorem 3.8: recursive canonical-idempotent interpolation

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Theorem 3.8, source PDF pp. 13–14. Separation suffices without additive
centrality. Prefix length k means k edges, and the product embeds from each own level. -/
theorem recursive_path_interpolation (D : Tower k AA) (J : (i : ℕ) → AA (i + 1))
    (hJ : IsSeparating D J) :
    (∀ n (t : TowerPath D (n + 1)), pathIdempotent D t =
      D.inc n (n + 1) (by omega) (pathIdempotent D (towerPrefix D t n (by omega))) *
        Polynomial.aeval (J n) (siblingPolynomial D J t)) ∧
    (∀ n (t : TowerPath D n), pathIdempotent D t =
      (List.ofFn fun i : Fin n => D.inc (i.val + 1) n (by omega)
        (Polynomial.aeval (J i.val)
          (siblingPolynomial D J (towerPrefix D t (i.val + 1) (by omega))))).prod) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
