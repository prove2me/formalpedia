/- Begin Solutions.CappedPolicyCesaro (SHA-256 bab92d25b6b1b597ef9ae2a4b95c2235c98c36482e70745f073c0a55a9614f4a). -/
section CappedPolicyUploadModule6
noncomputable section
open Filter Finset CappedEndpointSubsequence
open scoped BigOperators Topology

namespace CappedPolicyCesaro

/-- Arithmetic mean over periods zero through T-1, with Lean's zero-denominator convention. -/
def mean (f : ℕ → ℝ) (T : ℕ) : ℝ :=
  (∑ t ∈ range T, f t) / (T : ℝ)

/-- An initially empty delivery line with a fixed delay. -/
def delayed (v : ℕ → ℝ) (lag t : ℕ) : ℝ :=
  if lag ≤ t then v (t - lag) else 0

def delayedMean (v : ℕ → ℝ) (lag T : ℕ) : ℝ := mean (delayed v lag) T

lemma sum_delayed (v : ℕ → ℝ) (lag T : ℕ) :
    (∑ t ∈ range T, delayed v lag t) = ∑ t ∈ range (T - lag), v t := by
  induction T with
  | zero => simp
  | succ T ih =>
    rw [sum_range_succ, ih]
    by_cases ht : lag ≤ T
    · have hsub : T + 1 - lag = T - lag + 1 := by omega
      rw [hsub, sum_range_succ]
      simp [delayed, ht]
    · have hzero : T - lag = 0 := by omega
      have hzero' : T + 1 - lag = 0 := by omega
      simp [delayed, ht, hzero, hzero']

lemma mean_nonneg (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n) (T : ℕ) : 0 ≤ mean f T :=
  div_nonneg (sum_nonneg (fun _ _ => hf _)) (Nat.cast_nonneg _)

lemma sum_nonneg_shift_le (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n)
    (a b n : ℕ) (hab : a + b ≤ n) :
    (∑ k ∈ range b, f (a + k)) ≤ ∑ k ∈ range n, f k := by
  have hadd := sum_range_add f a b
  have hfirst : 0 ≤ ∑ k ∈ range a, f k := sum_nonneg (fun _ _ => hf _)
  have hpart : (∑ k ∈ range b, f (a + k)) ≤ ∑ k ∈ range (a + b), f k := by
    linarith
  exact hpart.trans (sum_le_sum_of_subset_of_nonneg (range_mono hab) (fun _ _ _ => hf _))

lemma mean_sub_delayedMean (v : ℕ → ℝ) (lag T : ℕ) (hT : lag ≤ T) :
    mean v T - delayedMean v lag T =
      (∑ k ∈ range lag, v (T - lag + k)) / (T : ℝ) := by
  have hadd := sum_range_add v (T - lag) lag
  rw [Nat.sub_add_cancel hT] at hadd
  unfold delayedMean mean
  rw [sum_delayed, ← sub_div]
  congr 1
  linarith

/-- Delayed pipeline averages differ from the order average only through a bounded endpoint. -/
lemma mean_sub_delayedMean_bound (u v : ℕ → ℝ)
    (hu : ∀ n, 0 ≤ u n) (hv : ∀ n, 0 ≤ v n)
    (μ : ℝ) (hμ : 0 ≤ μ) (L : ℕ)
    (horder : ∀ t, v t ≤ u (t + L + 1) + μ)
    (lag T : ℕ) (hlag : lag ≤ L) (hT : L + 1 ≤ T) :
    0 ≤ mean v T - delayedMean v lag T ∧
      mean v T - delayedMean v lag T ≤
        (block u L T + (L : ℝ) * μ) / (T : ℝ) := by
  have hlagT : lag ≤ T := by omega
  rw [mean_sub_delayedMean v lag T hlagT]
  constructor
  · exact div_nonneg (sum_nonneg (fun _ _ => hv _)) (Nat.cast_nonneg _)
  · apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    calc
      _ ≤ ∑ k ∈ range lag, (u (T + (L + 1 - lag + k)) + μ) := by
        apply sum_le_sum
        intro k hk
        have heq : T - lag + k + L + 1 = T + (L + 1 - lag + k) := by omega
        simpa only [heq] using horder (T - lag + k)
      _ = (∑ k ∈ range lag, u (T + (L + 1 - lag + k))) + (lag : ℝ) * μ := by
        simp [sum_add_distrib]
      _ ≤ block u L T + (L : ℝ) * μ := by
        apply add_le_add
        · exact sum_nonneg_shift_le (fun k => u (T + k)) (fun _ => hu _)
            (L + 1 - lag) lag (L + 1) (by omega)
        · exact mul_le_mul_of_nonneg_right (by exact_mod_cast hlag) hμ

/-- The inventory-sum shift, using an empty initial inventory. -/
lemma sum_inventory_next (u : ℕ → ℝ) (hzero : u 0 = 0) (T : ℕ) :
    (∑ t ∈ range T, u (t + 1)) = (∑ t ∈ range T, u t) + u T := by
  have h := sum_shift_sub_sum u T 1
  simp only [sum_range_one, Nat.add_zero, hzero, sub_zero] at h
  linarith

/-- Summing conservation of inventory determines total expected sales. -/
lemma sum_sales_eq (u v s : ℕ → ℝ) (L : ℕ) (hzero : u 0 = 0)
    (hflow : ∀ t, u (t + 1) + s t = u t + delayed v L t) (T : ℕ) :
    (∑ t ∈ range T, s t) = (∑ t ∈ range T, delayed v L t) - u T := by
  have hsum : (∑ t ∈ range T, (u (t + 1) + s t)) =
      ∑ t ∈ range T, (u t + delayed v L t) := sum_congr rfl (fun t _ => hflow t)
  rw [sum_add_distrib, sum_add_distrib, sum_inventory_next u hzero T] at hsum
  linarith

lemma sales_mean_eq (u v s : ℕ → ℝ) (L : ℕ) (hzero : u 0 = 0)
    (hflow : ∀ t, u (t + 1) + s t = u t + delayed v L t) (T : ℕ) :
    mean s T = delayedMean v L T - u T / (T : ℝ) := by
  unfold delayedMean mean
  rw [sum_sales_eq u v s L hzero hflow T, sub_div]

lemma mean_le_const (f : ℕ → ℝ) (C : ℝ) (hf : ∀ t, f t ≤ C)
    (T : ℕ) (hT : 0 < T) : mean f T ≤ C := by
  have hTr : 0 < (T : ℝ) := by exact_mod_cast hT
  unfold mean
  apply (div_le_iff₀ hTr).mpr
  calc
    _ ≤ ∑ t ∈ range T, C := sum_le_sum (fun t _ => hf t)
    _ = C * (T : ℝ) := by simp; ring

/-- The order-rate mean is at most the demand mean plus a vanishing endpoint error. -/
lemma order_mean_upper (u v s : ℕ → ℝ)
    (hu : ∀ n, 0 ≤ u n) (hv : ∀ n, 0 ≤ v n)
    (μ : ℝ) (hμ : 0 ≤ μ) (L : ℕ)
    (horder : ∀ t, v t ≤ u (t + L + 1) + μ)
    (hzero : u 0 = 0) (hsales : ∀ t, s t ≤ μ)
    (hflow : ∀ t, u (t + 1) + s t = u t + delayed v L t)
    (T : ℕ) (hT : L + 1 ≤ T) :
    mean v T ≤ μ + (2 * block u L T + (L : ℝ) * μ) / (T : ℝ) := by
  have hgap := (mean_sub_delayedMean_bound u v hu hv μ hμ L horder L T le_rfl hT).2
  have hmean := mean_le_const s μ hsales T (by omega)
  rw [sales_mean_eq u v s L hzero hflow T] at hmean
  have hend : u T / (T : ℝ) ≤ block u L T / (T : ℝ) := by
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    simpa only [Nat.add_zero, block] using
      (single_le_sum (fun k (_ : k ∈ range (L + 1)) => hu (T + k))
        (show 0 ∈ range (L + 1) by simp) : u (T + 0) ≤ block u L T)
  have hcombine : (block u L T + (L : ℝ) * μ) / (T : ℝ) + block u L T / (T : ℝ) =
      (2 * block u L T + (L : ℝ) * μ) / (T : ℝ) := by ring
  linarith

/-- Exact finite-horizon cost algebra, retaining the terminal-inventory correction. -/
lemma average_cost_identity (u v s : ℕ → ℝ) (h p μ : ℝ)
    (L : ℕ) (hzero : u 0 = 0)
    (hflow : ∀ t, u (t + 1) + s t = u t + delayed v L t)
    (T : ℕ) (hT : 0 < T) :
    mean (fun t => h * u (t + 1) + p * (μ - s t)) T =
      h * mean u T + p * (μ - delayedMean v L T) +
        (h + p) * u T / (T : ℝ) := by
  have hTr : (T : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hT)
  unfold delayedMean mean
  rw [sum_add_distrib, ← mul_sum, ← mul_sum, sum_sub_distrib,
    sum_inventory_next u hzero T, sum_sales_eq u v s L hzero hflow T]
  simp only [sum_const, card_range, nsmul_eq_mul]
  field_simp
  ring

end CappedPolicyCesaro
end
