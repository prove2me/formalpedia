theorem CuspForm.IsEigenformWith.OperatorAlgebra.finite_adjoin_qCoeff
    {M : ℕ} [NeZero M] {ε : DirichletCharacter ℂ M}
    {h : CuspForm (CongruenceSubgroup.Gamma1 M) 2} (hh : CuspForm.IsEigenformWith ε h) :
    Module.Finite ℤ ↥(Algebra.adjoin ℤ ((Set.range fun n : ℕ => ModularFormClass.qCoeff h n) ∪
      Set.range fun u : (ZMod M)ˣ => ε (u : ZMod M))) := by sorry
