    have h1 : 40 * b ^ 2 ≤ b * b ^ 2 := Nat.mul_le_mul_right _ hb
    have h2 : 40 * b ≤ b * b := Nat.mul_le_mul_right _ hb
    have : (b + 1) ^ 3 ≤ 2 * b ^ 3 := by ring_nf; ring_nf at h1 h2; nlinarith
    nlinarith

lemma lin_lt_pow_half (b : ℕ) (hb : 16 ≤ b) : b < 2 ^ (b / 2) := by
  have := two_mul_succ_lt_pow (b / 2) (by omega)
  omega

/-- `64 x² (256 x²)! ≤ 2^{2^{17} x⁴}`. -/
lemma fact_bound (x : ℕ) : 64 * x ^ 2 * (256 * x ^ 2).factorial ≤ 2 ^ (2 ^ 17 * x ^ 4) := by
  set m := 256 * x ^ 2 with hm
  have h1 : m.factorial ≤ m ^ m := Nat.factorial_le_pow m
  have h2 : m ^ m ≤ (2 ^ m) ^ m := Nat.pow_le_pow_left (Nat.lt_two_pow_self).le m
  have h3 : 64 * x ^ 2 ≤ 2 ^ (64 * x ^ 2) := (Nat.lt_two_pow_self).le
  have h4 : 64 * x ^ 2 * m.factorial ≤ 2 ^ (64 * x ^ 2) * (2 ^ m) ^ m :=
    Nat.mul_le_mul h3 (h1.trans h2)
  rw [← pow_mul, ← pow_add] at h4
  refine h4.trans (Nat.pow_le_pow_right (by norm_num) ?_)
  rw [hm]
  nlinarith [sq_nonneg (x ^ 2), Nat.zero_le (x ^ 2), Nat.zero_le (x ^ 4)]

lemma b0_real_ge : (2 : ℝ) ^ ((2 : ℝ) ^ 132) ≤ (b0 : ℝ) := Nat.le_ceil _

lemma b0_ge (k : ℕ) (hk : k ≤ 2 ^ 132) : 2 ^ k ≤ b0 := by
  have hk' : (k : ℝ) ≤ (2 : ℝ) ^ 132 := by exact_mod_cast hk
  have : (2 : ℝ) ^ k ≤ (b0 : ℝ) := by
    rw [← Real.rpow_natCast]
    exact (Real.rpow_le_rpow_of_exponent_le (by norm_num) hk').trans b0_real_ge
  exact_mod_cast this

lemma b_ge {n : ℕ} (hn : n0 ≤ n) : b0 ≤ bP n := by
  have h := Nat.clog_mono_right 2 hn
  rw [n0, Nat.clog_pow 2 b0 (by norm_num)] at h
  exact h.trans (le_max_left _ _)

lemma bP_eq {n : ℕ} (hn : n0 ≤ n) : bP n = Nat.clog 2 n := by
  have h := Nat.clog_mono_right 2 hn
  rw [n0, Nat.clog_pow 2 b0 (by norm_num)] at h
  have : 1 ≤ b0 := b0_ge 0 (by norm_num)
  exact max_eq_left (by omega)

lemma n_le {n : ℕ} (hn : n0 ≤ n) : n ≤ 2 ^ bP n := by
  rw [bP_eq hn]; exact Nat.le_pow_clog (by norm_num) n

lemma n_gt {n : ℕ} (hn : n0 ≤ n) : 2 ^ (bP n - 1) < n := by
  have h2 : 2 ≤ n0 := by
    have : 2 ^ 1 ≤ 2 ^ b0 := Nat.pow_le_pow_right (by norm_num) (b0_ge 0 (by norm_num))
    simpa [n0] using this
  rw [bP_eq hn]
  have := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (show 1 < n by omega)
  simpa [Nat.pred_eq_sub_one] using this

/-- Facts about `L` and `T` (`b ≥ 16`). -/
lemma L_facts {n : ℕ} (hn : n0 ≤ n) :
    4 * n ≤ TP n * bP n ∧ TP n * bP n < 8 * n ∧ LP n < bP n ∧ bP n ≤ 2 * LP n := by
  have hb : 2 ^ 4 ≤ bP n := (b0_ge 4 (by norm_num)).trans (b_ge hn)
  have hb' : 16 ≤ bP n := by simpa using hb
  have hle := n_le hn
  have hgt := n_gt hn
  set b := bP n with hbdef
  have hpow : 2 ^ b = 2 * 2 ^ (b - 1) := by
    rw [← pow_succ']; congr 1; omega
  have spec : 4 * n ≤ 2 ^ LP n * b := Nat.find_spec (LP_exists n)
  -- `L < b`
  have hLb : LP n ≤ b - 1 := by
    apply Nat.find_min' (LP_exists n)
    show 4 * n ≤ 2 ^ (b - 1) * b
    have : 4 * n ≤ 8 * 2 ^ (b - 1) := by omega
    nlinarith
  -- `b ≤ 2L`
  have h2L : b ≤ 2 * LP n := by
    by_contra hcon
    push Not at hcon
    have hhalf : LP n + b / 2 ≤ b := by omega
    have h1 : b < 2 ^ (b / 2) := lin_lt_pow_half b hb'
    have h3 : 2 ^ LP n * b < 2 ^ LP n * 2 ^ (b / 2) := Nat.mul_lt_mul_of_pos_left h1 (by positivity)
    have h4 : 2 ^ LP n * 2 ^ (b / 2) ≤ 2 ^ b := by
      rw [← pow_add]; exact Nat.pow_le_pow_right (by norm_num) hhalf
    omega
  -- `T b < 8n`
  have hTb : TP n * b < 8 * n := by
    have hL1 : 1 ≤ LP n := by omega
    have hmin : ¬ 4 * n ≤ 2 ^ (LP n - 1) * b := Nat.find_min (LP_exists n) (m := LP n - 1)
      (by show LP n - 1 < LP n; omega)
    have : TP n = 2 * 2 ^ (LP n - 1) := by
      rw [TP, ← pow_succ']; congr 1; omega
    rw [this]; push Not at hmin; nlinarith
  exact ⟨spec, hTb, by omega, h2L⟩

lemma beps_big {n : ℕ} (hn : n0 ≤ n) : (2 : ℝ) ^ ((2 : ℝ) ^ 57) ≤ (bP n : ℝ) ^ ε := by
  have hB : (2 : ℝ) ^ ((2 : ℝ) ^ 132) ≤ (bP n : ℝ) := by
    exact b0_real_ge.trans (by exact_mod_cast b_ge hn)
  have h0 : 0 ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 132) := by positivity
  calc (2 : ℝ) ^ ((2 : ℝ) ^ 57) = ((2 : ℝ) ^ ((2 : ℝ) ^ 132)) ^ ε := by
        rw [← Real.rpow_mul (by norm_num), show (2 : ℝ) ^ 132 * IntMul.OpenAI.RCost.ε = (2 : ℝ) ^ 57 by
          unfold IntMul.OpenAI.RCost.ε; norm_num]
    _ ≤ (bP n : ℝ) ^ ε := Real.rpow_le_rpow h0 hB (by unfold IntMul.OpenAI.RCost.ε; norm_num)

lemma two_le_beps {n : ℕ} (hn : n0 ≤ n) : 2 ≤ (bP n : ℝ) ^ ε := by
  refine le_trans ?_ (beps_big hn)
  calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
    _ ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 57) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)

lemma d_half {n : ℕ} (hn : n0 ≤ n) : (bP n : ℝ) ^ IntMul.OpenAI.RCost.ε / 2 ≤ (dP n : ℝ) :=
  RCost.floor_half (two_le_beps hn)

lemma d_le_beps (n : ℕ) : (dP n : ℝ) ≤ (bP n : ℝ) ^ ε :=
  Nat.floor_le (Real.rpow_nonneg (Nat.cast_nonneg _) _)

lemma two_le_dc {n : ℕ} (hn : n0 ≤ n) : 2 ≤ (dP n : ℝ) ^ c := by
  have hY : (2 : ℝ) ^ ((2 : ℝ) ^ 57 - 1) ≤ (dP n : ℝ) := by
    rw [Real.rpow_sub_one (by norm_num)]
    exact le_trans (div_le_div_of_nonneg_right (beps_big hn) (by norm_num)) (d_half hn)
  have h0 : 0 ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 57 - 1) := by positivity
  calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
    _ ≤ (2 : ℝ) ^ (((2 : ℝ) ^ 57 - 1) * c) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by unfold c; norm_num)
    _ = ((2 : ℝ) ^ ((2 : ℝ) ^ 57 - 1)) ^ c := by rw [Real.rpow_mul (by norm_num)]
    _ ≤ (dP n : ℝ) ^ c := Real.rpow_le_rpow h0 hY (by unfold c; norm_num)

lemma d_pos {n : ℕ} (hn : n0 ≤ n) : 1 ≤ dP n := by
  have h1 := d_half hn
  have h2 := two_le_beps hn
  have : (1 : ℝ) ≤ dP n := by linarith
  exact_mod_cast this

/-- `B ≥ 2^{36}`-type bounds from `b ≥ b₀`. -/
lemma b_ge_real {n : ℕ} (hn : n0 ≤ n) (k : ℕ) (hk : k ≤ 2 ^ 132) : (2 : ℝ) ^ k ≤ (bP n : ℝ) := by
  have := (b0_ge k hk).trans (b_ge hn)
  exact_mod_cast this

lemma d_le_b {n : ℕ} (hn : n0 ≤ n) : dP n ≤ bP n := by
  have hb1 : (1 : ℝ) ≤ bP n := by exact_mod_cast bP_pos n
  have : (dP n : ℝ) ≤ bP n := (d_le_beps n).trans (by
    calc (bP n : ℝ) ^ IntMul.OpenAI.RCost.ε ≤ (bP n : ℝ) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hb1 (by unfold IntMul.OpenAI.RCost.ε; norm_num)
      _ = bP n := Real.rpow_one _)
  exact_mod_cast this

/-- `x^e ≥ 2^{k e}` style: `(2^k)^{1/2} = 2^{k/2}`. -/
lemma sqrt_pow_two (k : ℕ) : ((2 : ℝ) ^ (2 * k)) ^ ((1 : ℝ) / 2) = 2 ^ k := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast]
  congr 1; push_cast; ring

/-- `b ≥ 2^{18} d^5`. -/
lemma b_ge_d5 {n : ℕ} (hn : n0 ≤ n) : (2 : ℝ) ^ 18 * (dP n : ℝ) ^ 5 ≤ bP n := by
  set B : ℝ := (bP n : ℝ)
  have hB : (2 : ℝ) ^ 36 ≤ B := b_ge_real hn 36 (by norm_num)
  have hB1 : 1 ≤ B := le_trans (by norm_num) hB
  have hB0 : 0 ≤ B := by linarith
  have hd5 : (dP n : ℝ) ^ 5 ≤ B ^ (5 * IntMul.OpenAI.RCost.ε) := by
    calc (dP n : ℝ) ^ 5 ≤ (B ^ IntMul.OpenAI.RCost.ε) ^ 5 := by
          gcongr; exact d_le_beps n
      _ = B ^ (5 * IntMul.OpenAI.RCost.ε) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hB0]; congr 1; push_cast; ring
  have hsq : (2 : ℝ) ^ 18 ≤ B ^ ((1 : ℝ) / 2) := by
    rw [← sqrt_pow_two 18]
    exact Real.rpow_le_rpow (by positivity) (by simpa using hB) (by norm_num)
  have hhalf : B ^ ((1 : ℝ) / 2) ≤ B ^ (1 - 5 * IntMul.OpenAI.RCost.ε) :=
    Real.rpow_le_rpow_of_exponent_le hB1 (by unfold IntMul.OpenAI.RCost.ε; norm_num)
  have hsplit : B = B ^ (1 - 5 * IntMul.OpenAI.RCost.ε) * B ^ (5 * IntMul.OpenAI.RCost.ε) := by
    rw [← Real.rpow_add (by linarith)]; simp
  have hpos : 0 ≤ (dP n : ℝ) ^ 5 := by positivity
  calc (2 : ℝ) ^ 18 * (dP n : ℝ) ^ 5 ≤ B ^ (1 - 5 * IntMul.OpenAI.RCost.ε) * B ^ (5 * IntMul.OpenAI.RCost.ε) := by
        apply mul_le_mul (hsq.trans hhalf) hd5 hpos (Real.rpow_nonneg hB0 _)
    _ = B := hsplit.symm

/-- `28 d² √b ≤ b/4`. -/
lemma gamma_room {n : ℕ} (hn : n0 ≤ n) : 28 * (dP n : ℝ) ^ 2 * Real.sqrt (bP n) ≤ (bP n : ℝ) / 4 := by
  set B : ℝ := (bP n : ℝ)
  have hB : (2 : ℝ) ^ 36 ≤ B := b_ge_real hn 36 (by norm_num)
  have hB1 : 1 ≤ B := le_trans (by norm_num) hB
  have hB0 : 0 ≤ B := by linarith
  have hd2 : (dP n : ℝ) ^ 2 ≤ B ^ (2 * IntMul.OpenAI.RCost.ε) := by
    calc (dP n : ℝ) ^ 2 ≤ (B ^ IntMul.OpenAI.RCost.ε) ^ 2 := by gcongr; exact d_le_beps n
      _ = B ^ (2 * IntMul.OpenAI.RCost.ε) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hB0]; congr 1; push_cast; ring
  -- `112 B^{2ε} √B ≤ B`
  have hq : (2 : ℝ) ^ 9 ≤ B ^ ((1 : ℝ) / 4) := by
    have : ((2 : ℝ) ^ 36) ^ ((1 : ℝ) / 4) = 2 ^ 9 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast]
      congr 1; norm_num
    rw [← this]; exact Real.rpow_le_rpow (by positivity) hB (by norm_num)
  have hq2 : B ^ ((1 : ℝ) / 4) ≤ B ^ (1 / 2 - 2 * IntMul.OpenAI.RCost.ε) :=
    Real.rpow_le_rpow_of_exponent_le hB1 (by unfold IntMul.OpenAI.RCost.ε; norm_num)
  have hsplit : B = B ^ (2 * IntMul.OpenAI.RCost.ε) * B ^ ((1 : ℝ) / 2) * B ^ (1 / 2 - 2 * IntMul.OpenAI.RCost.ε) := by
    rw [← Real.rpow_add (by linarith), ← Real.rpow_add (by linarith)]
    rw [show 2 * IntMul.OpenAI.RCost.ε + 1 / 2 + (1 / 2 - 2 * IntMul.OpenAI.RCost.ε) = (1 : ℝ) by ring, Real.rpow_one]
  have hsqrt : Real.sqrt B = B ^ ((1 : ℝ) / 2) := Real.sqrt_eq_rpow B
  rw [hsqrt]
  have h1 : 0 ≤ B ^ ((1 : ℝ) / 2) := Real.rpow_nonneg hB0 _
  have h2 : 0 ≤ B ^ (2 * IntMul.OpenAI.RCost.ε) := Real.rpow_nonneg hB0 _
  have h112 : (112 : ℝ) ≤ B ^ (1 / 2 - 2 * IntMul.OpenAI.RCost.ε) := le_trans (by norm_num) (hq.trans hq2)
  calc 28 * (dP n : ℝ) ^ 2 * B ^ ((1 : ℝ) / 2) ≤ 28 * B ^ (2 * IntMul.OpenAI.RCost.ε) * B ^ ((1 : ℝ) / 2) := by
        gcongr
    _ = (B ^ (2 * IntMul.OpenAI.RCost.ε) * B ^ ((1 : ℝ) / 2) * 112) / 4 := by ring
    _ ≤ (B ^ (2 * IntMul.OpenAI.RCost.ε) * B ^ ((1 : ℝ) / 2) * B ^ (1 / 2 - 2 * IntMul.OpenAI.RCost.ε)) / 4 := by gcongr
    _ = B / 4 := by rw [← hsplit]

/-- **The pointwise parameter conditions of §8–9 hold for `n ≥ n₀`.** -/
theorem params_ok {n : ℕ} (hn : n0 ≤ n) :
    -- thresholds
    2 ≤ (bP n : ℝ) ^ IntMul.OpenAI.RCost.ε ∧ 2 ≤ (dP n : ℝ) ^ c ∧ 8192 ≤ bP n ∧ 1 ≤ dP n ∧ dP n ≤ bP n ∧
    -- box exponent and volume
    bP n ≤ 2 * LP n ∧ LP n < bP n ∧ TP n < 2 ^ bP n ∧
    24 * (n : ℝ) ≤ VP n ∧ VP n ≤ 48 * n ∧
    -- axis exponent, factorial bound, source lengths
    (pP n : ℝ) / (12 * dP n) ≤ ℓP n ∧ (ℓP n : ℝ) ≤ (pP n : ℝ) / (3 * dP n) ∧
    64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ rP n ∧ 2 ∣ rP n ∧
    -- resampling / error budget
    2 * dP n * pP n ^ 2 < TP n * LP n ∧ 12 * (dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 ∧
    γP n ≤ (bP n : ℝ) / 4 ∧
    -- the hypotheses of `kappaBound_of_table`
    (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε / 12 ≤ dP n ∧ (dP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε ∧
    (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c) / 24 ≤ KP n ∧ (KP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c) ∧
    (ℓP n : ℝ) ≤ 6 * (IntMul.lg n : ℝ) / (3 * dP n) ∧
    (αP n : ℝ) ≤ 4 * (6 * (IntMul.lg n : ℝ)) ^ (1 / 4 + IntMul.OpenAI.RCost.ε / 2) := by
  obtain ⟨hT1, hT2, hLb, h2L⟩ := L_facts hn
  have hbe := two_le_beps hn
  have hdc := two_le_dc hn
  have hd1 := d_pos hn
  have hdb := d_le_b hn
  have hb8 : 8192 ≤ bP n := le_trans (by norm_num) ((b0_ge 13 (by norm_num)).trans (b_ge hn))
  have hb1 : (1 : ℝ) ≤ bP n := by exact_mod_cast bP_pos n
  -- d and K bounds
  obtain ⟨hD1, hD2⟩ := concrete_d_bounds (bP n : ℝ) hb1 hbe
  have hp1 : (1 : ℝ) ≤ 6 * bP n := by linarith
  obtain ⟨hK1, hK2⟩ := concrete_K_bounds (6 * bP n) (dP n) hp1 hD1 hD2 hdc
  -- ℓ bounds
  obtain ⟨hl1, hl2⟩ := RP.ell_bounds (LP n) (dP n) (bP n) (by omega) hdb h2L hLb.le
  -- α
  have hX1 : (1 : ℝ) ≤ (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
    apply Real.one_le_rpow _ (by norm_num)
    have : (1 : ℝ) ≤ dP n := by exact_mod_cast hd1
    nlinarith
  have hα := concrete_alpha_bound (bP n) (dP n) hb1 (Nat.cast_nonneg _) hD2 hX1
  have hα4 : 12 * (dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 := by
    have h0 : 0 ≤ 12 * (dP n : ℝ) ^ 2 * bP n := by positivity
    have hc : (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) ≤ αP n := Nat.le_ceil _
    have : ((12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4)) ^ 4 = 12 * (dP n : ℝ) ^ 2 * bP n := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul h0]; norm_num
    rw [← this]; gcongr
  -- γ
  have hγ : γP n ≤ (bP n : ℝ) / 4 := by
    have hαle : (αP n : ℝ) ≤ 2 * (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
      have := Nat.ceil_lt_add_one (show 0 ≤ (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) by
        positivity)
      unfold αP; linarith
    have hd0 : (0 : ℝ) < dP n := by exact_mod_cast hd1
    have := RP.gamma_bound (dP n) (bP n) (αP n) hd0 (by linarith) (Nat.cast_nonneg _) hαle
    unfold γP; linarith [gamma_room hn]
  -- factorial bound
  have hfact : 64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ rP n := by
    refine (fact_bound (dP n)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    have h5 := b_ge_d5 hn
    have hd0 : (0 : ℝ) < dP n := by exact_mod_cast hd1
    have : ((2 ^ 17 * dP n ^ 4 : ℕ) : ℝ) ≤ ℓP n := by
      refine le_trans ?_ hl1
      push_cast
      rw [le_div_iff₀ (by positivity)]
      nlinarith
    exact_mod_cast this
  have hr2 : 2 ∣ rP n := by
    have hℓ1 : 1 ≤ ℓP n := by
      have : (1 : ℝ) ≤ ℓP n := by
        refine le_trans ?_ hl1
        rw [le_div_iff₀ (by positivity)]
        have h5 := b_ge_d5 hn
        have hd' : (1 : ℝ) ≤ dP n := by exact_mod_cast hd1
        have : (dP n : ℝ) ≤ (dP n : ℝ) ^ 5 := le_self_pow₀ hd' (by norm_num)
        nlinarith
      exact_mod_cast this
    exact dvd_pow_self 2 (by omega)
  -- 2 d p² < T L
  have hdp : 2 * dP n * pP n ^ 2 < TP n * LP n := by
    have hcube := cube_lt_pow (bP n) (by omega)
    have h1 : 2 * dP n * pP n ^ 2 ≤ 72 * bP n ^ 3 := by
      unfold pP; nlinarith
    have hgt := n_gt hn
    have hpow : 2 ^ bP n = 2 * 2 ^ (bP n - 1) := by rw [← pow_succ']; congr 1; omega
    have h2 : 2 ^ bP n < TP n * LP n * 2 := by nlinarith
    have h3 : 2 ^ bP n ≤ TP n * LP n := by
      have : TP n * bP n ≤ TP n * (2 * LP n) := Nat.mul_le_mul_left _ h2L
      nlinarith
    omega
  -- volume
  have hV1 : 24 * (n : ℝ) ≤ VP n := by
    unfold VP pP; push_cast
    have : ((4 * n : ℕ) : ℝ) ≤ ((TP n * bP n : ℕ) : ℝ) := by exact_mod_cast hT1
    push_cast at this; nlinarith
  have hV2 : VP n ≤ 48 * n := by
    unfold VP pP; push_cast
    have : ((TP n * bP n : ℕ) : ℝ) ≤ ((8 * n : ℕ) : ℝ) := by exact_mod_cast hT2.le
    push_cast at this; nlinarith
  have hTlt : TP n < 2 ^ bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  refine ⟨hbe, hdc, hb8, hd1, hdb, h2L, hLb, hTlt, hV1, hV2, ?_, ?_, hfact, hr2, hdp, hα4, hγ,
    hD1, hD2, ?_, ?_, ?_, hα⟩
  · unfold pP; push_cast; exact hl1
  · unfold pP; push_cast; exact hl2
  · exact hK1
  · exact hK2
  · exact hl2

end

