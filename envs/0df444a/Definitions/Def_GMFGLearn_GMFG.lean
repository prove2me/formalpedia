-- title:
--   The GMFG model, policies $\Pi$, the value $V(s,\pi,\mathcal L)$, stationary NE (Definition 1), $\Gamma_2$ (15), $D$ (14), Assumptions 1–2
-- statement:
--   The state space $(\mathcal S,d_{\mathcal S})$ and the action space $(\mathcal A,d_{\mathcal A})$ are compact metric spaces with their Borel $\sigma$-fields. A **general mean-field game (GMFG)** consists of a measurable transition law $P:\mathcal S\times\mathcal A\times\mathcal P(\mathcal S\times\mathcal A)\to\mathcal P(\mathcal S)$, a measurable mean reward $\bar r:\mathcal S\times\mathcal A\times\mathcal P(\mathcal S\times\mathcal A)\to[0,R_{\max}]$ with $R_{\max}>0$, and a discount factor $\gamma\in(0,1)$. Here $\mathcal L\in\mathcal P(\mathcal S\times\mathcal A)$ is the population state-action distribution, and $\mu$ denotes its state marginal.
--
--   1. **Policies.** $\Pi$ is the set of measurable maps $\pi:\mathcal S\to\mathcal P(\mathcal A)$.
--   2. **Value.** For fixed $\mathcal L$ and $\pi\in\Pi$, $V(s,\pi,\mathcal L)=\mathbb E\big[\sum_{t\ge0}\gamma^t r(s_t,a_t,\mathcal L)\,\big|\,s_0=s\big]$, where $a_t\sim\pi(s_t)$ and $s_{t+1}\sim P(\cdot\mid s_t,a_t,\mathcal L)$.
--   3. **Stationary NE (Definition 1).** $(\pi^\star,\mathcal L^\star)$ is a stationary Nash equilibrium if $V(s,\pi^\star,\mathcal L^\star)\ge V(s,\pi,\mathcal L^\star)$ for every $\pi\in\Pi$ and $s\in\mathcal S$, and the law of $(s_t,a_t)$ equals $\mathcal L^\star$ for every $t\ge0$ when $s_0\sim\mu^\star$, $a_t\sim\pi^\star(s_t)$, $s_{t+1}\sim P(\cdot\mid s_t,a_t,\mathcal L^\star)$.
--   4. **Population update (15).** $\Gamma_2(\pi,\mathcal L)$ is the law of $(s_1,a_1)$ when $s_0\sim\mu$, $a_0\sim\pi(s_0)$, $s_1\sim P(\cdot\mid s_0,a_0,\mathcal L)$, $a_1\sim\pi(s_1)$.
--   5. **Optimal selection.** $\Gamma_1:\mathcal P(\mathcal S\times\mathcal A)\to\Pi$ is an optimal-policy selection if $V(s,\pi,\mathcal L)\le V(s,\Gamma_1(\mathcal L),\mathcal L)$ for all $\mathcal L,\pi,s$ (12); then $\Gamma(\mathcal L)=\Gamma_2(\Gamma_1(\mathcal L),\mathcal L)$.
--   6. **Policy distance (14).** $D(\pi,\pi')=\sup_{s\in\mathcal S}W_1(\pi(s),\pi'(s))$.
--   7. **Assumption 1.** $D(\Gamma_1(\mathcal L),\Gamma_1(\mathcal L'))\le d_1W_1(\mathcal L,\mathcal L')$ for all $\mathcal L,\mathcal L'$, with $d_1\ge0$.
--   8. **Assumption 2.** $W_1(\Gamma_2(\pi_1,\mathcal L),\Gamma_2(\pi_2,\mathcal L))\le d_2D(\pi_1,\pi_2)$ and $W_1(\Gamma_2(\pi,\mathcal L_1),\Gamma_2(\pi,\mathcal L_2))\le d_3W_1(\mathcal L_1,\mathcal L_2)$, with $d_2,d_3\ge0$.
--
--   These are the objects of Theorem 1 and of the learning theorem.
--
--   **Formalization Note** The model stores the mean reward $\bar r=\mathbb E[r]$ instead of the reward law $R$; every quantity of the paper depends on $R$ only through it. $V$ is $\sum_t\gamma^t\int\bar r\,d(\text{law of }(s_t,a_t))$, the law of $s_t$ being built by kernel composition. $W_1$ on $\mathcal P(\mathcal S\times\mathcal A)$ uses the $\ell_2$ product cost, on $\mathcal P(\mathcal A)$ the distance of $\mathcal A$.
-- source:
--   Guo, Hu, Xu, Zhang, A General Framework for Learning Mean-Field Games, arXiv:2003.06069v3, §2.2 and (GMFG), p.4; Definition 1, p.5; §3 Step A, (12)–(15), p.8; Assumption 2, (16)–(17), p.9

import Mathlib
import Definitions.Def_GMFGLearn_Distances

open MeasureTheory ProbabilityTheory

namespace GMFGLearn

/-- **Admissible (stationary) policies `Π`.** Guo–Hu–Xu–Zhang, *A General Framework for Learning
Mean-Field Games*, arXiv:2003.06069v3, §3 Step A, p.8: `Π := {π | π : S → P(A)}`, with `π`
measurable (§2.2, p.4: "some measurable policy"; Notations, p.3: a measure-valued map is measurable
if every `µ ↦ µ(C)` composed with it is).

**Formalization Note** `P(A)` is `ProbabilityMeasure A` with Mathlib's Giry σ-algebra, which is the
σ-algebra generated by the evaluations `µ ↦ µ(C)` (p.3). -/
structure Policy (S A : Type*) [MeasurableSpace S] [MeasurableSpace A] where
  /-- The randomized action `π(s) ∈ P(A)` at each state. -/
  toFun : S → ProbabilityMeasure A
  /-- Measurability of the policy. -/
  measurable' : Measurable toFun

instance {S A : Type*} [MeasurableSpace S] [MeasurableSpace A] :
    CoeFun (Policy S A) (fun _ => S → ProbabilityMeasure A) :=
  ⟨Policy.toFun⟩

/-- **The general mean-field game (GMFG) model.** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, §2.2,
p.4: "P : S × A × P(S × A) → P(S) and R : S × A × P(S × A) → P([0,Rmax]) are measurable functions
with some constant Rmax > 0", and "γ ∈ (0,1) is the discount factor" (p.4).

**Formalization Note** The model carries the **mean reward** `rbar(s,a,L) = E[r]`, `r ∼ R(s,a,L)`,
measurable with values in `[0,Rmax]`, instead of the reward law `R`: every object of the paper
(the value `V`, the Q-functions, the equilibrium) depends on `R` only through this mean, and every
measurable `rbar` with values in `[0,Rmax]` is the mean of `R = δ_{rbar}`. -/
structure GMFG (S A : Type*) [MeasurableSpace S] [MeasurableSpace A] where
  /-- The transition law `P(·|s,a,L)`. -/
  P : S × A × ProbabilityMeasure (S × A) → ProbabilityMeasure S
  /-- `P` is measurable. -/
  P_measurable : Measurable P
  /-- The mean reward `rbar(s,a,L) = E[r(s,a,L)]`. -/
  rbar : S × A × ProbabilityMeasure (S × A) → ℝ
  /-- `rbar` is measurable. -/
  rbar_measurable : Measurable rbar
  /-- The reward bound `Rmax`. -/
  Rmax : ℝ
  Rmax_pos : 0 < Rmax
  rbar_nonneg : ∀ x, 0 ≤ rbar x
  rbar_le : ∀ x, rbar x ≤ Rmax
  /-- The discount factor `γ`. -/
  γ : ℝ
  γ_pos : 0 < γ
  γ_lt_one : γ < 1

variable {S A : Type*} [MeasurableSpace S] [MeasurableSpace A]

/-- The policy `π` as a Markov kernel from `S` to `A`. -/
noncomputable def Policy.kernel (π : Policy S A) : Kernel S A :=
  ⟨fun s => ((π s : ProbabilityMeasure A) : Measure A),
    measurable_subtype_coe.comp π.measurable'⟩

instance (π : Policy S A) : IsMarkovKernel π.kernel :=
  ⟨fun s => (π s).prop⟩

/-- The transition `(s,a) ↦ P(·|s,a,L)` for a fixed population state-action law `L`, as a Markov
kernel. -/
noncomputable def GMFG.transKernel (M : GMFG S A) (L : ProbabilityMeasure (S × A)) :
    Kernel (S × A) S :=
  ⟨fun x => ((M.P (x.1, x.2, L) : ProbabilityMeasure S) : Measure S),
    measurable_subtype_coe.comp
      (M.P_measurable.comp (measurable_fst.prodMk (measurable_snd.prodMk measurable_const)))⟩

instance (M : GMFG S A) (L : ProbabilityMeasure (S × A)) : IsMarkovKernel (M.transKernel L) :=
  ⟨fun x => (M.P (x.1, x.2, L)).prop⟩

/-- **Joint law of `(s, a)` with `s ∼ µ`, `a ∼ π(s)`**, i.e. `µ(ds) π(s)(da)`. -/
noncomputable def jointLaw (μ : ProbabilityMeasure S) (π : Policy S A) :
    ProbabilityMeasure (S × A) :=
  ⟨(Kernel.id ×ₖ π.kernel) ∘ₘ (μ : Measure S), inferInstance⟩

/-- **The population state marginal `µ` of `L`** (§2.2, p.4; Definition 1, p.5). -/
noncomputable def stateMarginal (L : ProbabilityMeasure (S × A)) : ProbabilityMeasure S :=
  L.map measurable_fst.aemeasurable

/-- **Law of the state `s_t`** of the representative player who starts from `s₀ ∼ µ₀`, plays the
stationary policy `π`, `a_t ∼ π(s_t)`, and moves by `s_{t+1} ∼ P(·|s_t,a_t,L)` against the fixed
population state-action law `L` (§2.2, p.4; §3 Step A, p.8). -/
noncomputable def GMFG.stateLaw (M : GMFG S A) (π : Policy S A) (L : ProbabilityMeasure (S × A))
    (μ₀ : ProbabilityMeasure S) : ℕ → ProbabilityMeasure S
  | 0 => μ₀
  | t + 1 => ⟨M.transKernel L ∘ₘ (jointLaw (M.stateLaw π L μ₀ t) π : Measure (S × A)),
      inferInstance⟩

/-- **The value `V(s, π, L)`.** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, (GMFG), p.4, and §3 Step A,
p.8: `V(s,π,L) := E[Σ_{t=0}^∞ γ^t r(s_t,a_t,L) | s₀ = s]` with `s_{t+1} ∼ P(s_t,a_t,L)`,
`a_t ∼ π(s_t)`, for a fixed `L` and a stationary policy `π`.

**Formalization Note** By linearity, `E[r(s_t,a_t,L)] = ∫ rbar(x,L) d(law of (s_t,a_t))`, and the law
of `(s_t,a_t)` is `jointLaw (stateLaw … (δ_s) t) π`. The summands lie in `[0, γ^t Rmax]`, so the
`tsum` is a genuine sum. -/
noncomputable def GMFG.value (M : GMFG S A) (s : S) (π : Policy S A)
    (L : ProbabilityMeasure (S × A)) : ℝ :=
  ∑' t : ℕ, M.γ ^ t *
    ∫ x, M.rbar (x.1, x.2, L)
      ∂(jointLaw (M.stateLaw π L ⟨Measure.dirac s, inferInstance⟩ t) π : Measure (S × A))

/-- **Stationary Nash equilibrium (Definition 1).** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3,
Definition 1, p.5: `(π⋆, L⋆)` is a stationary NE if (1) for any policy `π` and any initial state
`s`, `V(s,π⋆,L⋆) ≥ V(s,π,L⋆)`; and (2) `P_{s_t,a_t} = L⋆` for all `t ≥ 0`, where `{s_t,a_t}` is the
dynamics under `π⋆` starting from `s₀ ∼ µ⋆`, with `a_t ∼ π⋆(s_t)`, `s_{t+1} ∼ P(·|s_t,a_t,L⋆)`, and
`µ⋆` the population state marginal of `L⋆`.

**Formalization Note** "Any policy" ranges over the admissible policies `Π` (measurable maps
`S → P(A)`), the class Step A optimizes over ((12), p.8). -/
def IsStationaryNE (M : GMFG S A) (πs : Policy S A) (Ls : ProbabilityMeasure (S × A)) : Prop :=
  (∀ (π : Policy S A) (s : S), M.value s π Ls ≤ M.value s πs Ls) ∧
    ∀ t : ℕ, jointLaw (M.stateLaw πs Ls (stateMarginal Ls) t) πs = Ls

/-- **`Γ₂`, the population update (15).** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, (15), p.8:
`Γ₂(π,L) := L̂ = P_{s₁,a₁}`, where `a₁ ∼ π(s₁)`, `s₁ ∼ µP(·|·,a₀,L)`, `a₀ ∼ π(s₀)`, `s₀ ∼ µ`, and `µ`
is the population state marginal of `L`. -/
noncomputable def GMFG.Gamma2 (M : GMFG S A) (π : Policy S A) (L : ProbabilityMeasure (S × A)) :
    ProbabilityMeasure (S × A) :=
  jointLaw (M.stateLaw π L (stateMarginal L) 1) π

/-- **`Γ₁` is an optimal-policy selection.** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, §3 Step A,
p.8: `Γ₁ : P(S × A) → Π` selects a single optimal policy `π⋆_L = Γ₁(L)`, which satisfies (12):
`V(s,π⋆_L,L) ≥ V(s,π,L)` for any policy `π` and any initial state `s`. -/
def IsOptimalSelection (M : GMFG S A) (Γ₁ : ProbabilityMeasure (S × A) → Policy S A) : Prop :=
  ∀ (L : ProbabilityMeasure (S × A)) (π : Policy S A) (s : S), M.value s π L ≤ M.value s (Γ₁ L) L

/-- **`Γ(L) := Γ₂(Γ₁(L), L)`** (§3 Step C, p.9). -/
noncomputable def GMFG.Gamma (M : GMFG S A) (Γ₁ : ProbabilityMeasure (S × A) → Policy S A)
    (L : ProbabilityMeasure (S × A)) : ProbabilityMeasure (S × A) :=
  M.Gamma2 (Γ₁ L) L

variable [PseudoMetricSpace S] [PseudoMetricSpace A]

/-- **The policy distance `D` (14).** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, (14), p.8:
`D(π,π′) := sup_{s∈S} W₁(π(s),π′(s))`.

**Formalization Note** `W₁` on `P(A)` with cost `dist`. For compact `A` every `W₁(π(s),π′(s))` lies
in `[0, diam(A)]`, so the real `⨆` is a genuine supremum. -/
noncomputable def D (π π' : Policy S A) : ℝ :=
  ⨆ s : S, W1 (dist : A → A → ℝ) (π s) (π' s)

/-- **Assumption 1.** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, Assumption 1, p.8: there exists a
constant `d₁ ≥ 0` such that for any `L, L′ ∈ P(S × A)`, `D(Γ₁(L),Γ₁(L′)) ≤ d₁ W₁(L,L′)` (13).

**Formalization Note** `W₁` on `P(S × A)` uses the ℓ₂ product cost `dSA`. -/
def Assumption1 (Γ₁ : ProbabilityMeasure (S × A) → Policy S A) (d₁ : ℝ) : Prop :=
  0 ≤ d₁ ∧ ∀ L L' : ProbabilityMeasure (S × A), D (Γ₁ L) (Γ₁ L') ≤ d₁ * W1 dSA L L'

/-- **Assumption 2.** Guo–Hu–Xu–Zhang, arXiv:2003.06069v3, Assumption 2, p.9: there exist constants
`d₂, d₃ ≥ 0` such that for any admissible policies `π, π₁, π₂` and joint distributions
`L, L₁, L₂`, `W₁(Γ₂(π₁,L),Γ₂(π₂,L)) ≤ d₂ D(π₁,π₂)` (16) and
`W₁(Γ₂(π,L₁),Γ₂(π,L₂)) ≤ d₃ W₁(L₁,L₂)` (17). -/
def Assumption2 (M : GMFG S A) (d₂ d₃ : ℝ) : Prop :=
  0 ≤ d₂ ∧ 0 ≤ d₃ ∧
    (∀ (π₁ π₂ : Policy S A) (L : ProbabilityMeasure (S × A)),
      W1 dSA (M.Gamma2 π₁ L) (M.Gamma2 π₂ L) ≤ d₂ * D π₁ π₂) ∧
    ∀ (π : Policy S A) (L₁ L₂ : ProbabilityMeasure (S × A)),
      W1 dSA (M.Gamma2 π L₁) (M.Gamma2 π L₂) ≤ d₃ * W1 dSA L₁ L₂

end GMFGLearn


