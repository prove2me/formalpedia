        exact isUnit_iff_exists_inv.mpr ⟨⟨π⁻¹, h⟩, Subtype.ext (mul_inv_cancel₀ hπ0)⟩
      have hϖ₀B : ((algebraMap A₀ ↥B ϖ₀ : ↥B) : ↥F₀).1 = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
        show ((algebraMap A₀ ↥F₀ ϖ₀ : ↥F₀) : ↥(fieldBar q M')) = _
        rw [hj₀, hϖ₀π]
      have hϖB0 : algebraMap A₀ ↥B ϖ₀ ≠ 0 := by
