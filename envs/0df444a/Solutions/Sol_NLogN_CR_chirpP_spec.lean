  obtain ⟨k0, a, b, hr, hk0⟩ := hZ _ (List.getElem_mem hk)
  have hd := List.drop_eq_getElem_cons hk
  have ht := List.take_succ_eq_append_getElem hk
  rw [hr] at hd ht
  set c := curF cur0 (Z.take k) with hc
  set E := scanF cur0 (Z.take k) with hE
  obtain ⟨o, r⟩ := scanBody_spec (withCtr hQ s N k (NLogN.CR.scSt s Z Rst cur0 LA LB k)) k0 a b c.1 c.2 hk0
    (ints (Z.drop (k + 1)).flatten ++ Rst) LA LB
    (by simp +decide [withCtr, NLogN.CR.scSt, hd]) (by simp +decide [withCtr, NLogN.CR.scSt, hc])
    (by simp +decide [withCtr, NLogN.CR.scSt, hc])
  refine ⟨o, ?_⟩
  rw [r]
  have eC : curF cur0 (Z.take (k + 1)) = if k0 % 2 = 1 then c else (a, b) := by
    rw [ht, curF_append, ← hc]; simp [curF]
  have eS : scanF cur0 (Z.take (k + 1)) = E ++ (if k0 % 2 = 1 then [(a, c)] else []) := by
    rw [ht, scanF_append, ← hc, ← hE, scanF_single]; simp
  split_ifs with hodd
  · rw [if_pos hodd] at eC eS
    apply IState.ext' _ (by simp [withCtr, NLogN.CR.scSt]) (by simp [withCtr, NLogN.CR.scSt])
    intro y
    simp only [withCtr, NLogN.CR.scSt, IState.upd_G, eC, eS, outRev, keysRev, List.map_append,
      List.flatten_append, List.reverse_append, List.map_cons, List.map_nil, List.flatten_cons,
      List.flatten_nil, List.append_nil, List.reverse_cons, List.reverse_nil, List.nil_append,
      ints_append, ints_cons, ints_nil, List.cons_append, List.singleton_append]
    rw [← hc, ← hE]
    clear * -
    split_ifs <;> (try subst_vars) <;> simp_all +decide
  · rw [if_neg hodd] at eC eS
    apply IState.ext' _ (by simp [withCtr, NLogN.CR.scSt]) (by simp [withCtr, NLogN.CR.scSt])
    intro y
    simp only [withCtr, NLogN.CR.scSt, IState.upd_G, eC, eS, List.append_nil]
    rw [← hE]
    clear * -
    split_ifs <;> (try subst_vars) <;> simp_all +decide

theorem scan_states (s : IState HS) (Z : List (List ℤ)) (hZ : ∀ r ∈ Z, Rec3 r) (Rst : List Item)
    (cur0 : ℤ × ℤ) (LA LB L1 : List Item) (h0 : s.G 0 = ints Z.flatten ++ Rst)
    (hA : s.G hCa = .int cur0.1 :: LA) (hB : s.G hCb = .int cur0.2 :: LB)
    (h1 : s.G 1 = .int Z.length :: L1) :
    RepStates hQ (.reg 1) scanBody s (NLogN.CR.scSt s Z Rst cur0 LA LB) := by
  have e : (Ex.reg (S := HS) 1).eval s = Z.length := by simp [Ex.eval, IState.top_eq h1]
  exact {
    nonneg := by rw [e]; omega
    hw := by decide
    h0 := by
      apply IState.ext' _ (by simp [NLogN.CR.scSt]) (by simp [NLogN.CR.scSt])
      intro y
      simp only [NLogN.CR.scSt, IState.upd_G, List.drop_zero, List.take_zero, curF, scanF, outRev, keysRev,
        List.map_nil, List.flatten_nil, List.reverse_nil, ints_nil, List.nil_append]
      clear * - h0 hA hB
      split_ifs <;> (try subst_vars) <;> simp_all
    hG := fun k => by simp +decide [NLogN.CR.scSt, IState.upd_G]
    step := fun k hk => by
      rw [e, Int.toNat_natCast] at hk ⊢; exact (scan_step s Z hZ Rst cur0 LA LB _ k hk).2 }

theorem scanLoop_spec (s : IState HS) (Z : List (List ℤ)) (hZ : ∀ r ∈ Z, Rec3 r) (Rst : List Item)
    (cur0 : ℤ × ℤ) (LA LB L1 : List Item) (h0 : s.G 0 = ints Z.flatten ++ Rst)
    (hA : s.G hCa = .int cur0.1 :: LA) (hB : s.G hCb = .int cur0.2 :: LB)
    (h1 : s.G 1 = .int Z.length :: L1) :
    scanLoop.ok s ∧ scanLoop.run s =
      ((((s.upd 0 Rst).upd hCa (.int (curF cur0 Z).1 :: LA)).upd hCb (.int (curF cur0 Z).2 :: LB)).upd
        hOut (ints (outRev (scanF cur0 Z)) ++ s.G hOut)).upd hKs
        (ints (keysRev (scanF cur0 Z)) ++ s.G hKs) := by
  have e : (Ex.reg (S := HS) 1).eval s = Z.length := by simp [Ex.eval, IState.top_eq h1]
  have H := scan_states s Z hZ Rst cur0 LA LB L1 h0 hA hB h1
  refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of h1) ?_, ?_⟩
  · intro k hk; rw [e, Int.toNat_natCast] at hk ⊢; exact (scan_step s Z hZ Rst cur0 LA LB _ k hk).1
  · rw [scanLoop, H.run, e, Int.toNat_natCast]
    simp only [NLogN.CR.scSt, List.drop_length, List.take_length, List.flatten_nil, ints_nil, List.nil_append]

end NLogN.CR

