public import Mathlib.Order.Sublattice
public import Mathlib.Order.SupClosed
public import Definitions.Def_LeanPool_OrderClosures_BanLat_Substructures_Sublattice
set_option autoImplicit true
@[expose] public section
public section
variable {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [VectorLattice X]
open VectorSublattice
variable (Y : VectorSublattice X)
open scoped Pointwise

theorem VectorSublattice.generated_pointedCone_eq_sub_supClosure (C : PointedCone ℝ X) :
    (generated (C : Set X) : Set X)
      = supClosure (C : Set X) - supClosure (C : Set X) := by sorry
