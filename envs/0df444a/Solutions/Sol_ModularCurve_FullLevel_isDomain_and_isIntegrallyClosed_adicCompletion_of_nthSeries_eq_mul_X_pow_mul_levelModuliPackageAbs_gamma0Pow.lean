    q (P₀.B₀ ⧸ 𝔪) W₀ hW₀ res₀ hres₀ hker₀ _ hss (AdicCompletion 𝔪 P₀.B₀) resR hresR hkerR hresR₀ F hFbc
    (originParam χP) (originParam χQ) hP.2.1 hQ.2.1 hD huniv Fu hFu hLT φ hφres F' hbc ψ hψ
  intro h0
  have h1 : algebraMap W₀ (AdicCompletion 𝔪 P₀.B₀) (q : W₀) = 0 := by
    have h := h0
    rw [← IsScalarTower.algebraMap_apply A₀ P₀.B₀ (AdicCompletion 𝔪 P₀.B₀),
      IsScalarTower.algebraMap_apply A₀ W₀ (AdicCompletion 𝔪 P₀.B₀), map_natCast] at h
    exact h
  have h2 : φ (algebraMap W₀ (PowerSeries W₀) (q : W₀)) = φ 0 := by rw [φ.commutes, h1, map_zero]
  have h3 := hinj h2
