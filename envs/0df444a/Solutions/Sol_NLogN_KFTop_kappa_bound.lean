theorem UU_row (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (E : ℕ)
    (idx : Fin (6 + nR) → Fin (7 + E)) (q : Fin nR) :
    UU nR UR rowC E idx ⟨q.val + 6, by omega⟩ = UR E (iR idx) q := by
  unfold UU
  simp only [show q.val + 6 ≠ 0 by omega, show q.val + 6 ≠ 1 by omega, show q.val + 6 ≠ 2 by omega,
    show q.val + 6 ≠ 3 by omega, show q.val + 6 ≠ 4 by omega, show q.val + 6 ≠ 5 by omega,
    dite_false]
  congr 1

/-- **`RowUP → P14U`, at the constant `A₀`.** -/
theorem p14UA0_of_rowUP (hrow : RowUP) :
    ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
      (entry : Fin nU) (dS14 : Fin HS) (C₀ : ℝ),
      dS14 = 36 ∧ 0 ≤ C₀ ∧
      ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
        (∀ i, KFM.kTable ext (idx i) = U E idx i) →
        ∀ Isym : List Sym, KFV.P14Need Isym (KFM.kTable ext) (idx entry) dS14 NLogN.KFW.A0 C₀ := by
  obtain ⟨nR, UR, rowC, Kc, hKc, HR⟩ := hrow
  obtain ⟨C₀, hC₀, HC⟩ := KFM.round_cost_closed2 NLogN.KFW.A0 (18 * Kc + 18) (by linarith)
  refine ⟨6 + nR, UU nR UR rowC, ⟨5, by omega⟩, 36, (2 * Mb0 + 2) * C₀, rfl,
    mul_nonneg (by linarith [Mb0_nonneg]) hC₀.le, ?_⟩
  intro E ext idx hidx Isym
  set tbl := KFM.kTable ext
  set jL := idx ⟨0, by omega⟩
  set jT := idx ⟨1, by omega⟩
  set jW := idx ⟨2, by omega⟩
  set jE := idx ⟨3, by omega⟩
  set jG := idx ⟨4, by omega⟩
  have hL : tbl jL = levC jL (rowC E (iR idx)) := by rw [hidx]; rfl
  have hT : tbl jT = NLogN.KFW.topC jT jL := by rw [hidx]; rfl
  have hW : tbl jW = lowC jW jL := by rw [hidx]; rfl
  have hEc : tbl jE = eaccC jE (NLogN.KFW.bodyC jT jW) := by rw [hidx]; rfl
  have hG : tbl jG = logC jG (coreC jE) := by rw [hidx]; rfl
  have hM : tbl (idx ⟨5, by omega⟩) = p14C jG := by rw [hidx]; rfl
  have hRow : RowU Isym tbl (rowC E (iR idx)) Kc :=
    HR E ext (iR idx) (fun q => by
      show tbl (idx ⟨q.val + 6, by omega⟩) = UR E (iR idx) q
      rw [hidx]; exact UU_row nR UR rowC E idx q) Isym
  obtain ⟨A', Kc', hKc', HP⟩ := KFM.prop14Ph_kTable ext
  intro K r Z P D S ρ p w hρ hK6 hr hKZ hS hP hD hZ32 hp hKD hEw hwZ hrZ hNZ st f zs l xs hx hl h0
    hdesc hfree hb hdisk
  have hvol : AModel.vol (Butterfly.layerShape P K D S) = P * 2 ^ (K * D) * S := KFM.vol_layer_eq P K D S
  have hZ32' : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z := by rw [← hvol]; exact hZ32
  -- the representation and error guarantees (KFM)
  obtain ⟨Cc, E', dC, kC, -, -, -, HPr⟩ := HP Isym hK6 hr hKZ hρ hS hP hD hZ32
  set f0 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (f 0)
  have hf0 : Clean0 f0 := fun j hj => by simp [f0, hj]
  obtain ⟨zs', hzs', hgb, herr, -⟩ := HPr st f0 zs l xs p w hx hl (by simp [f0, h0]) hf0.clN hb hdisk
  have hex : ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
      (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) := ⟨zs', hzs'⟩
  have hch : Classical.choose hex = zs' := recRep_uniq (Classical.choose_spec hex) hzs'
  -- the run
  have h36 : f 36 = [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ), (Z : ℤ)] :=
    hdesc
  have hfree' : ∀ j : Fin HS, j ≠ 0 → j ≠ 36 → j.val < 50 → f j = [] :=
    fun j h1 h2 h3 => hfree j ⟨h1, h2, Or.inl h3⟩
  obtain ⟨c, Rc, hc⟩ := mainRun jG jE jT jL jW (rowC E (iR idx)) hG hEc hT hW hL hKc hRow hρ hK6 hr
    hKZ hS hP hD hZ32' hp hwZ hrZ st f zs l xs hx hl h0 h36 hfree' hb hdisk hex
  rw [hch] at Rc
  refine ⟨zs', c + 2, hzs', hgb, herr, IRuns.call (by rw [hM]; exact Rc), ?_⟩
  -- the cost
  set F : ℝ := coefF (18 * Kc + 18) K D * ((P * 2 ^ (K * D) * S : ℕ) : ℝ) *
    (Xf r (KFR.PsiR r Z) (w + KFM.EwB NLogN.KFW.A0 D) : ℝ) with hF
  have hF1 : (1 : ℝ) ≤ F := by
    have a : (2 : ℝ) ≤ coefF (18 * Kc + 18) K D := coefF_ge (by linarith) K D hD
    have b : (1 : ℝ) ≤ ((P * 2 ^ (K * D) * S : ℕ) : ℝ) := by
      have := Nat.mul_le_mul (Nat.mul_le_mul hP (Nat.one_le_two_pow (n := K * D))) hS
      exact_mod_cast (by simpa using this)
    have c' : (1 : ℝ) ≤ (Xf r (KFR.PsiR r Z) (w + KFM.EwB NLogN.KFW.A0 D) : ℝ) := by
      have : 1 ≤ Xf r (KFR.PsiR r Z) (w + KFM.EwB NLogN.KFW.A0 D) := by
        unfold Xf; have : 1 ≤ r * (w + KFM.EwB NLogN.KFW.A0 D + 1) := Nat.mul_pos hr (Nat.succ_pos _); omega
      exact_mod_cast this
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le (by linarith) b) c'
  set kCw := ⌊F⌋₊ with hkCw
  have hk1 : F ≤ 2 * (kCw : ℝ) := by
    have h1 := Nat.lt_floor_add_one F
    have h2 : (1 : ℝ) ≤ kCw := by
      have : 1 ≤ kCw := Nat.le_floor (by exact_mod_cast hF1)
      exact_mod_cast this
    linarith
  have hkF : (kCw : ℝ) ≤ F := Nat.floor_le (by linarith)
  have hEwB : w + KFM.EwB NLogN.KFW.A0 D = w + 2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 *
      (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc NLogN.KFW.A0 ^ (Nat.log (100 ^ 3) D + 2)) +
      20 * (Nat.log (100 ^ 3) D + 1) ^ 3 *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc NLogN.KFW.A0 ^ (Nat.log (100 ^ 3) D + 2) + 2 := by
    unfold KFM.EwB
    generalize NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc NLogN.KFW.A0 ^ (Nat.log (100 ^ 3) D + 2) = G
    generalize Nat.log (100 ^ 3) D = L
    ring
  have HCc := HC (K := K) (r := r) (Z := Z) (P := P) (D := D) (S := S) 0 0 w kCw hD (Nat.zero_le _)
    (Nat.zero_le _) (by
      refine hkF.trans (le_of_eq ?_)
      rw [hF, hvol, hEwB]
      rfl) hKD hEw hwZ hrZ hNZ (le_trans (zsz_natCast_le (by omega)) hZ32)
  have hW0 : (0 : ℝ) ≤ ((KFM.cWrapPh P K D S r 0
      (zsz ((16 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w 0 : ℕ) : ℝ) := Nat.cast_nonneg _
  push_cast at HCc ⊢
  have hM0 := Mb0_nonneg
  have hkk : (1 : ℝ) ≤ kCw := by
    have : 1 ≤ kCw := Nat.le_floor (by exact_mod_cast hF1)
    exact_mod_cast this
  have hMF : Mb0 * F ≤ Mb0 * (2 * kCw) := mul_le_mul_of_nonneg_left hk1 hM0
  calc (c : ℝ) + 2 ≤ Mb0 * F + 2 := by linarith
    _ ≤ Mb0 * (2 * kCw) + 2 * kCw := by linarith
    _ = (2 * Mb0 + 2) * kCw := by ring
    _ ≤ (2 * Mb0 + 2) * (kCw + (KFM.cWrapPh P K D S r 0
          (zsz ((16 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w 0 : ℝ)) := by
        apply mul_le_mul_of_nonneg_left _ (by linarith)
        linarith
    _ ≤ (2 * Mb0 + 2) * (C₀ * ((AModel.vol (Butterfly.layerShape P K D S) : ℝ) * (r : ℝ)) * (w + 1) *
          (D : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 54)) := by
        apply mul_le_mul_of_nonneg_left _ (by linarith)
        exact_mod_cast HCc
    _ = (2 * Mb0 + 2) * C₀ * ((AModel.vol (Butterfly.layerShape P K D S) : ℝ) * (r : ℝ)) * (w + 1) *
          (D : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 54) := by ring

