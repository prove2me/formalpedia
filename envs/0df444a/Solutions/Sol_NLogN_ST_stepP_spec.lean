theorem map_range_mul {α : Type*} (n P : ℕ) (g : ℕ → α) :
    (List.range (n * P)).map g = (List.range n).flatMap (fun i => (List.range P).map (fun q => g (i * P + q))) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.succ_mul, List.range_add, List.map_append, ih, List.range_succ, List.flatMap_append]
    simp [List.map_map, Function.comp_def]

/-- `listOf` as a map over row-major positions. -/
theorem listOf_eq : ∀ {α : Type*} (s : List ℕ) (f : (ℕ → ℕ) → α),
    listOf s f = (List.range s.prod).map (fun q => f (unrk s q))
  | _, [], f => by
    simp only [listOf, boxIdxs, List.prod_nil, List.range_one, List.map_cons, List.map_nil]
    congr 2
  | _, n :: ns, f => by
    have hb : listOf (n :: ns) f = (List.range n).flatMap
        (fun i => listOf ns (fun g => f (fun k => if k = 0 then i else g (k - 1)))) := by
      simp only [listOf, boxIdxs, List.map_flatMap, List.map_map]
      congr 1; funext i; congr 1; funext l
      simp only [Function.comp_apply]
      congr 1; funext k
      rcases k with _ | k <;> simp
    rw [hb, List.prod_cons, map_range_mul]
    congr 1; funext i
    rw [listOf_eq ns]
    rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
    · simp only [h0, List.range_zero, List.map_nil]
    apply List.map_congr_left
    intro q hq
    rw [List.mem_range] at hq
    congr 1; funext k
    simp only [unrk]
    have e1 : (i * ns.prod + q) / ns.prod = i := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ h0, Nat.div_eq_of_lt hq, zero_add]
    have e2 : (i * ns.prod + q) % ns.prod = q := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hq]
    rcases k with _ | k
    · simp [e1]
    · simp [e2]

