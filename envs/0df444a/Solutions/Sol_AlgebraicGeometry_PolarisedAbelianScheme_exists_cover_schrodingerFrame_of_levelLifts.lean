theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

theorem lifts_transport
    {g d n : ℕ} (δ : Fin g → ℕ) [∀ i, NeZero (δ i)]
    {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    (S₁ : Type) [CommRing S₁] [Algebra S S₁] (ζ : S₁ˣ)
    (lift : ((i : Fin g) → ZMod (δ i)) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))
    (dualLift : (((i : Fin g) → ZMod (δ i)) →+ ZMod d) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))
    (hl0 : lift 0 = 1) (hlmul : ∀ h h' : ((i : Fin g) → ZMod (δ i)), lift (h + h') = lift h * lift h')
    (hd0 : dualLift 0 = 1) (hdmul : ∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d, dualLift (c + c') = dualLift c * dualLift c')
    (hHeis : ∀ (c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d) (h : ((i : Fin g) → ZMod (δ i))),
      dualLift c * lift h = ThetaPt.ofScalar (ζ ^ (c h).val) * (lift h * dualLift c))
    (R : Type) [CommRing R] (ψ : S₁ →+* R) :
    ∃ (lift' : ((i : Fin g) → ZMod (δ i)) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))))
      (dualLift' : (((i : Fin g) → ZMod (δ i)) →+ ZMod d) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁))))),
      lift' 0 = 1 ∧ (∀ h h' : ((i : Fin g) → ZMod (δ i)), lift' (h + h') = lift' h * lift' h') ∧
      dualLift' 0 = 1 ∧ (∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d, dualLift' (c + c') = dualLift' c * dualLift' c') ∧
      (∀ (c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d) (h : ((i : Fin g) → ZMod (δ i))),
        dualLift' c * lift' h = ThetaPt.ofScalar ((Units.map (ψ : S₁ →* R) ζ) ^ (c h).val) * (lift' h * dualLift' c)) := by
  have htt : Spec.map (CommRingCat.ofHom ψ) ≫ (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) = (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hid : Spec.map (CommRingCat.ofHom (RingHom.id S)) = 𝟙 (Spec (CommRingCat.of S)) := by
    rw [show CommRingCat.ofHom (RingHom.id S) = 𝟙 _ from rfl, Spec.map_id]
  have hg : IsPullback (𝟙 u.A) u.f u.f (Spec.map (CommRingCat.ofHom (RingHom.id S))) := by
    rw [hid]; exact IsPullback.of_horiz_isIso ⟨by simp⟩
  have hmul : ∀ {T : Scheme.{0}} (t'' : T ⟶ Spec (CommRingCat.of S)) (x y : SchemeHomOver t'' u.f),
      (u.L.mul t'' x y).1 ≫ 𝟙 u.A =
        (u.L.mul (t'' ≫ Spec.map (CommRingCat.ofHom (RingHom.id S)))
          ⟨x.1 ≫ 𝟙 u.A, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ 𝟙 u.A, by rw [Category.assoc, hg.w, ← Category.assoc, y.2]⟩).1 := by
    intro T t'' x y
    rw [Category.comp_id]
    exact mul_val_congr u.L (by rw [hid, Category.comp_id]) _ _ _ _ (Category.comp_id _).symm (Category.comp_id _).symm

  let b : pullback u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ⟶ pullback u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) :=
    pullback.lift (pullback.fst u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁))))) (pullback.snd u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ≫ Spec.map (CommRingCat.ofHom ψ))
      (by rw [Category.assoc, htt]; exact pullback.condition)
  have hb₁' : b ≫ pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) = pullback.fst u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) := pullback.lift_fst _ _ _
  have hb₁ : b ≫ pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) = pullback.fst u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ≫ 𝟙 u.A := by rw [Category.comp_id]; exact hb₁'
  have hb₂ : b ≫ pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) = pullback.snd u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ≫ Spec.map (CommRingCat.ofHom ψ) := pullback.lift_snd _ _ _
  let c : (Scheme.Modules.pullback b).obj ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))).obj u.pol) ≅
      (Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))))).obj u.pol :=
    (Scheme.Modules.pullbackComp b (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))).app u.pol ≪≫ (Scheme.Modules.pullbackCongr hb₁').app u.pol
  have hr : Spec.map (CommRingCat.ofHom ψ) ≫ (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) = (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ≫ Spec.map (CommRingCat.ofHom (RingHom.id S)) := by
    rw [htt, hid, Category.comp_id]
  obtain ⟨β, -, -, hβsc, -⟩ :=
    AlgebraicGeometry.Polarisation.ThetaPt.exists_monoidHom_pt_comp_eq_act_eq_of_isPullback (RingHom.id S) u.L u.L (𝟙 u.A) hg hmul
      u.pol u.pol (Spec.map (CommRingCat.ofHom (algebraMap S S₁))) (Spec.map (CommRingCat.ofHom (ψ.comp (algebraMap S S₁)))) ψ hr b hb₁ hb₂ c
  refine ⟨fun h => β (lift h), fun c' => β (dualLift c'), ?_, ?_, ?_, ?_, ?_⟩
  · show β (lift 0) = 1
    rw [hl0, map_one]
  · intro h h'; show β (lift (h + h')) = β (lift h) * β (lift h'); rw [hlmul, map_mul]
  · show β (dualLift 0) = 1
    rw [hd0, map_one]
  · intro c₁ c₂; show β (dualLift (c₁ + c₂)) = β (dualLift c₁) * β (dualLift c₂); rw [hdmul, map_mul]
  · intro c' h
    show β (dualLift c') * β (lift h) = ThetaPt.ofScalar ((Units.map (ψ : S₁ →* R) ζ) ^ (c' h).val) * (β (lift h) * β (dualLift c'))
    rw [← map_mul, hHeis, map_mul, map_mul, hβsc, ← map_pow]

theorem spec_comp3 {A B C D : Type} [CommRing A] [CommRing B] [CommRing C] [CommRing D]
    (f : A →+* B) (g : B →+* C) (h : C →+* D) :
    Spec.map (CommRingCat.ofHom h) ≫ (Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f)) =
      Spec.map (CommRingCat.ofHom ((h.comp g).comp f)) := by
  simp only [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]

end FFLAux

theorem solution
    {g d n : ℕ} (δ : Fin g → ℕ) [∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = d)
    {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    (S₁ : Type) [CommRing S₁] [Algebra S S₁] (hd₁ : IsUnit ((d : ℕ) : S₁))
    (ζ : S₁ˣ) (hζ : (ζ : S₁) ^ d = 1) (hζu : ∀ j : ℕ, 0 < j → j < d → IsUnit (1 - (ζ : S₁) ^ j))
    (lift : ((i : Fin g) → ZMod (δ i)) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))
    (dualLift : (((i : Fin g) → ZMod (δ i)) →+ ZMod d) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S S₁))))
    (hl0 : lift 0 = 1) (hlmul : ∀ h h' : ((i : Fin g) → ZMod (δ i)), lift (h + h') = lift h * lift h')
    (hd0 : dualLift 0 = 1) (hdmul : ∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d, dualLift (c + c') = dualLift c * dualLift c')
    (hHeis : ∀ (c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d) (h : ((i : Fin g) → ZMod (δ i))),
      dualLift c * lift h = ThetaPt.ofScalar (ζ ^ (c h).val) * (lift h * dualLift c)) :
    ∃ (m : ℕ) (r : Fin m → S₁), Ideal.span (Set.range r) = ⊤ ∧
      ∀ j : Fin m, Nonempty (SchrodingerFrame u.f u.L u.pol (Spec.map (CommRingCat.ofHom ((algebraMap S₁ (Localization.Away (r j))).comp (algebraMap S S₁)))) δ) := by
  classical

  obtain ⟨k, r₀, hr₀span, hr₀⟩ := Ideal.exists_finset_span_eq_top_of_forall_prime_exists_not_mem
    (fun r : S₁ => ∀ (R : Type) [CommRing R] [Algebra S₁ R] [IsLocalization.Away r R],
        ∃ σ : Fin d → Γ((Scheme.Modules.pullback
            (pullback.fst u.f (Spec.map (CommRingCat.ofHom ((algebraMap S₁ R).comp (algebraMap S S₁)))))).obj u.pol, ⊤),
          Scheme.Modules.IsSectionBasis (pullback.snd u.f (Spec.map (CommRingCat.ofHom ((algebraMap S₁ R).comp (algebraMap S S₁)))))
            ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom ((algebraMap S₁ R).comp (algebraMap S S₁)))))).obj u.pol) σ)
    (fun 𝔭 => AlgebraicGeometry.PolarisedAbelianScheme.exists_not_mem_forall_exists_isSectionBasis_sections_pullback_of_algebra u S₁ 𝔭)

  have step : ∀ j : Fin k, ∃ (m : ℕ) (r' : Fin m → Localization.Away (r₀ j)), Ideal.span (Set.range r') = ⊤ ∧
      ∀ i : Fin m, Nonempty (SchrodingerFrame u.f u.L u.pol
        (Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away (r₀ j)) (Localization.Away (r' i)))) ≫
          Spec.map (CommRingCat.ofHom ((algebraMap S₁ (Localization.Away (r₀ j))).comp (algebraMap S S₁)))) δ) := by
    intro j
    obtain ⟨σ₀, hσ₀⟩ := hr₀ j (Localization.Away (r₀ j))
    obtain ⟨lift', dualLift', hl0', hlmul', hd0', hdmul', hHeis'⟩ :=
      FFLAux.lifts_transport δ u S₁ ζ lift dualLift hl0 hlmul hd0 hdmul hHeis (Localization.Away (r₀ j))
        (algebraMap S₁ (Localization.Away (r₀ j)))
    have hdR : IsUnit ((d : ℕ) : Localization.Away (r₀ j)) := by
      simpa using hd₁.map (algebraMap S₁ (Localization.Away (r₀ j)))
    let ζj : (Localization.Away (r₀ j))ˣ := Units.map (algebraMap S₁ (Localization.Away (r₀ j)) : S₁ →* Localization.Away (r₀ j)) ζ
    have hζj : (ζj : Localization.Away (r₀ j)) = algebraMap S₁ (Localization.Away (r₀ j)) ζ := rfl
    have hζ' : (ζj : Localization.Away (r₀ j)) ^ d = 1 := by
      rw [hζj, ← map_pow, hζ, map_one]
    have hζu' : ∀ j' : ℕ, 0 < j' → j' < d → IsUnit (1 - (ζj : Localization.Away (r₀ j)) ^ j') := by
      intro j' h1 h2
      rw [hζj, ← map_pow, ← map_one (algebraMap S₁ (Localization.Away (r₀ j))), ← map_sub]
      exact (hζu j' h1 h2).map _
    exact AlgebraicGeometry.PolarisedAbelianScheme.exists_cover_schrodingerFrame_of_levelLifts_of_isSectionBasis δ hδd u _ hdR
      ζj hζ' hζu' σ₀ hσ₀ lift' dualLift' hl0' hlmul' hd0' hdmul' hHeis'
  choose m r' hspan hframe using step

  have hnum : ∀ (j : Fin k) (i : Fin (m j)), ∃ (x : S₁) (a : ℕ),
      r' j i * algebraMap S₁ (Localization.Away (r₀ j)) (r₀ j ^ a) = algebraMap S₁ (Localization.Away (r₀ j)) x := by
    intro j i
    obtain ⟨⟨x, y⟩, hy⟩ := IsLocalization.surj (Submonoid.powers (r₀ j)) (r' j i)
    obtain ⟨a, ha⟩ := (Submonoid.mem_powers_iff _ _).mp y.2
    exact ⟨x, a, by rw [ha]; exact hy⟩
  choose x a hx using hnum

  let s : (Σ j : Fin k, Fin (m j)) → S₁ := fun p => r₀ p.1 * x p.1 p.2
  have hsspan : Ideal.span (Set.range s) = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal _ hne

    have hj : ∃ j, r₀ j ∉ 𝔪 := by
      by_contra hall
      push Not at hall
      have : Ideal.span (Set.range r₀) ≤ 𝔪 := Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hall j)
      rw [hr₀span, top_le_iff] at this
      exact h𝔪.ne_top this
    obtain ⟨j, hj⟩ := hj

    have hdisj : Disjoint (↑(Submonoid.powers (r₀ j)) : Set S₁) ↑𝔪 := by
      rw [Set.disjoint_left]
      rintro y ⟨nn, rfl⟩ hy
      exact hj (h𝔪.isPrime.mem_of_pow_mem nn hy)
    have h𝔮 : (Ideal.map (algebraMap S₁ (Localization.Away (r₀ j))) 𝔪).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (r₀ j)) _ 𝔪 h𝔪.isPrime hdisj
    have hcomap : Ideal.comap (algebraMap S₁ (Localization.Away (r₀ j))) (Ideal.map (algebraMap S₁ (Localization.Away (r₀ j))) 𝔪) = 𝔪 :=
      IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers (r₀ j)) _ h𝔪.isPrime hdisj

    have hi : ∃ i, r' j i ∉ Ideal.map (algebraMap S₁ (Localization.Away (r₀ j))) 𝔪 := by
      by_contra hall
      push Not at hall
      have : Ideal.span (Set.range (r' j)) ≤ Ideal.map (algebraMap S₁ (Localization.Away (r₀ j))) 𝔪 :=
        Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hall i)
      rw [hspan j, top_le_iff] at this
      exact h𝔮.ne_top this
    obtain ⟨i, hi⟩ := hi

    have hxi : x j i ∉ 𝔪 := by
      intro hxm
      have h1 : algebraMap S₁ (Localization.Away (r₀ j)) (x j i) ∈ Ideal.map (algebraMap S₁ (Localization.Away (r₀ j))) 𝔪 :=
        Ideal.mem_map_of_mem _ hxm
      rw [← hx j i] at h1
      rcases h𝔮.mem_or_mem h1 with h2 | h2
      · exact hi h2
      · have : r₀ j ^ a j i ∈ 𝔪 := by rw [← hcomap]; exact h2
        exact hj (h𝔪.isPrime.mem_of_pow_mem _ this)
    have hsmem : s ⟨j, i⟩ ∈ 𝔪 := hle (Ideal.subset_span ⟨⟨j, i⟩, rfl⟩)
    rcases h𝔪.isPrime.mem_or_mem hsmem with h3 | h3
    · exact hj h3
    · exact hxi h3

  have hframes : ∀ p : Σ j : Fin k, Fin (m j), Nonempty (SchrodingerFrame u.f u.L u.pol
      (Spec.map (CommRingCat.ofHom ((algebraMap S₁ (Localization.Away (s p))).comp (algebraMap S S₁)))) δ) := by
    rintro ⟨j, i⟩

    have hunit : IsUnit (algebraMap S₁ (Localization.Away (s ⟨j, i⟩)) (s ⟨j, i⟩)) := IsLocalization.Away.algebraMap_isUnit _
    have hu₀ : IsUnit (algebraMap S₁ (Localization.Away (s ⟨j, i⟩)) (r₀ j)) := by
      rw [show s ⟨j, i⟩ = r₀ j * x j i from rfl, map_mul] at hunit; exact isUnit_of_mul_isUnit_left hunit
    have hux : IsUnit (algebraMap S₁ (Localization.Away (s ⟨j, i⟩)) (x j i)) := by
      rw [show s ⟨j, i⟩ = r₀ j * x j i from rfl, map_mul] at hunit; exact isUnit_of_mul_isUnit_right hunit
    let ρ₁ : Localization.Away (r₀ j) →+* Localization.Away (s ⟨j, i⟩) := IsLocalization.Away.lift (r₀ j) hu₀
    have hρ₁ : ρ₁.comp (algebraMap S₁ (Localization.Away (r₀ j))) = algebraMap S₁ (Localization.Away (s ⟨j, i⟩)) :=
      IsLocalization.Away.lift_comp (r₀ j) hu₀
    have hρ₁r : IsUnit (ρ₁ (r' j i)) := by
      have h1 := congrArg ρ₁ (hx j i)
      rw [map_mul, ← RingHom.comp_apply, ← RingHom.comp_apply, hρ₁, map_pow] at h1
      exact isUnit_of_mul_isUnit_left (h1.symm ▸ hux)
    let ρ : Localization.Away (r' j i) →+* Localization.Away (s ⟨j, i⟩) := IsLocalization.Away.lift (r' j i) hρ₁r
    have hρ : ρ.comp (algebraMap (Localization.Away (r₀ j)) (Localization.Away (r' j i))) = ρ₁ := IsLocalization.Away.lift_comp _ hρ₁r
    have htri : (ρ.comp (algebraMap (Localization.Away (r₀ j)) (Localization.Away (r' j i)))).comp
        ((algebraMap S₁ (Localization.Away (r₀ j))).comp (algebraMap S S₁)) =
        (algebraMap S₁ (Localization.Away (s ⟨j, i⟩))).comp (algebraMap S S₁) := by
      rw [hρ, ← RingHom.comp_assoc, hρ₁]

    let φ2 : S₁ →+* Localization.Away (r' j i) := (algebraMap (Localization.Away (r₀ j)) (Localization.Away (r' j i))).comp
        (algebraMap S₁ (Localization.Away (r₀ j)))
    let ζ2 : (Localization.Away (r' j i))ˣ := Units.map (φ2 : S₁ →* Localization.Away (r' j i)) ζ
    have hζ2e : (ζ2 : Localization.Away (r' j i)) = φ2 ζ := rfl
    have hζ2 : (ζ2 : Localization.Away (r' j i)) ^ d = 1 := by rw [hζ2e, ← map_pow, hζ, map_one]
    have hζu2 : ∀ j' : ℕ, 0 < j' → j' < d → IsUnit (1 - (ζ2 : Localization.Away (r' j i)) ^ j') := by
      intro j' h1 h2
      rw [hζ2e, ← map_pow, ← map_one φ2, ← map_sub]
      exact (hζu j' h1 h2).map _
    obtain ⟨F⟩ := hframe j i
    have hF' := AlgebraicGeometry.PolarisedAbelianScheme.nonempty_schrodingerFrame_comp_of_schrodingerFrame δ hδd u _ ζ2 hζ2 hζu2 ρ F
    have heq : Spec.map (CommRingCat.ofHom ρ) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap (Localization.Away (r₀ j)) (Localization.Away (r' j i)))) ≫
          Spec.map (CommRingCat.ofHom ((algebraMap S₁ (Localization.Away (r₀ j))).comp (algebraMap S S₁)))) =
        Spec.map (CommRingCat.ofHom ((algebraMap S₁ (Localization.Away (s ⟨j, i⟩))).comp (algebraMap S S₁))) := by
      rw [FFLAux.spec_comp3, htri]
    rw [heq] at hF'
    exact hF'

  let e := Fintype.equivFin (Σ j : Fin k, Fin (m j))
  refine ⟨Fintype.card (Σ j : Fin k, Fin (m j)), s ∘ e.symm, ?_, fun J => hframes (e.symm J)⟩
  rw [← hsspan]
  congr 1
  ext y
  simp only [Set.mem_range, Function.comp_apply]
  exact ⟨fun ⟨J, hJ⟩ => ⟨e.symm J, hJ⟩, fun ⟨p, hp⟩ => ⟨e p, by rw [Equiv.symm_apply_apply]; exact hp⟩⟩

end S_AlgebraicGeometry_PolarisedAbelianScheme_exists_cover_schrodingerFrame_of_levelLifts
end P2MW
export P2MW.S_AlgebraicGeometry_PolarisedAbelianScheme_exists_cover_schrodingerFrame_of_levelLifts (solution)
