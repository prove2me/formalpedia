/-- `((m:ℝ)^k)^τ = (m^τ)^k`. -/
lemma pow_rpow_eq (m : ℕ) (k : ℕ) (τ : ℝ) :
    (((m : ℝ) ^ k) ^ τ) = ((m : ℝ) ^ τ) ^ k :=
  (Real.rpow_pow_comm (Nat.cast_nonneg m) τ k).symm

lemma one_lt_base_rpow {m : ℕ} (hm : 2 ≤ m) {τ : ℝ} (hτ : 0 < τ) :
    1 < (m : ℝ) ^ τ :=
  Real.one_lt_rpow (by exact_mod_cast (by omega : 1 < m)) hτ

/-- Geometric sum bound `Σ_{j<n} b^j ≤ b^n / (b-1)` for `b > 1`. -/
lemma geom_sum_le_div {b : ℝ} (hb : 1 < b) (n : ℕ) :
    ∑ j ∈ range n, b ^ j ≤ b ^ n / (b - 1) := by
  have hb1 : 0 < b - 1 := by linarith
  induction n with
  | zero => simp only [range_zero, sum_empty, pow_zero]; positivity
  | succ n ih =>
    rw [sum_range_succ]
    have : b ^ n / (b - 1) + b ^ n = b ^ (n + 1) / (b - 1) := by
      field_simp; ring
    linarith

lemma digit_le (m e j : ℕ) (hm : 2 ≤ m) : AModel.digit m e j ≤ m - 1 := by
  unfold AModel.digit
  by_cases hj : j < (Nat.digits m e).length
  · rw [List.getD_eq_getElem _ _ hj]
    have := Nat.digits_lt_base (by omega) (List.getElem_mem hj)
    omega
  · rw [List.getD_eq_default _ _ (by omega)]
    omega

/-- **Lemma 12** (digit decomposition): `Σ_j a_j (m^j)^τ ≤ K' e^τ`,
with `K' = (m-1) m^τ / (m^τ - 1)` depending only on `m, τ`. -/
theorem arbitrary_width_sum (m : ℕ) (τ : ℝ) (hm : 2 ≤ m) (hτ : 0 < τ) :
    ∃ K' : ℝ, 0 ≤ K' ∧ ∀ e : ℕ, 1 ≤ e →
      ∑ j ∈ range (Nat.digits m e).length, (AModel.digit m e j : ℝ) * ((m : ℝ) ^ j) ^ τ
        ≤ K' * (e : ℝ) ^ τ := by
  set b : ℝ := (m : ℝ) ^ τ
  have hb : 1 < b := one_lt_base_rpow hm hτ
  have hb1 : 0 < b - 1 := by linarith
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hm1 : (1 : ℝ) ≤ (m : ℝ) - 1 := by
    have : (2 : ℝ) ≤ m := by exact_mod_cast hm
    linarith
  refine ⟨((m : ℝ) - 1) * b / (b - 1), by positivity, ?_⟩
  intro e he
  set L := (Nat.digits m e).length
  have hdig : ∀ j, (AModel.digit m e j : ℝ) ≤ (m : ℝ) - 1 := by
    intro j
    have h := digit_le m e j hm
    have : ((m - 1 : ℕ) : ℝ) = (m : ℝ) - 1 := by
      rw [Nat.cast_sub (by omega)]; simp
    rw [← this]; exact_mod_cast h
  have hlen : (m : ℝ) ^ L ≤ m * e := by
    exact_mod_cast Nat.base_pow_length_digits_le m e (by omega) (by omega)
  have hlenτ : b ^ L ≤ b * (e : ℝ) ^ τ := by
    rw [← pow_rpow_eq, ← Real.mul_rpow hm0 (Nat.cast_nonneg e)]
    exact Real.rpow_le_rpow (by positivity) hlen hτ.le
  calc ∑ j ∈ range L, (AModel.digit m e j : ℝ) * ((m : ℝ) ^ j) ^ τ
      ≤ ∑ j ∈ range L, ((m : ℝ) - 1) * b ^ j := by
        apply sum_le_sum
        intro j _
        rw [pow_rpow_eq]
        exact mul_le_mul_of_nonneg_right (hdig j) (by positivity)
    _ = ((m : ℝ) - 1) * ∑ j ∈ range L, b ^ j := by rw [mul_sum]
    _ ≤ ((m : ℝ) - 1) * (b ^ L / (b - 1)) :=
        mul_le_mul_of_nonneg_left (geom_sum_le_div hb L) (by linarith)
    _ ≤ ((m : ℝ) - 1) * (b * (e : ℝ) ^ τ / (b - 1)) := by
        gcongr
    _ = ((m : ℝ) - 1) * b / (b - 1) * (e : ℝ) ^ τ := by ring

