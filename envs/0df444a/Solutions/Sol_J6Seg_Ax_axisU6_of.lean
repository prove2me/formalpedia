-- Source module: Solutions.J6SegTabBnd2
/-!
# Chunk-table sizes 2: `ChunkTabBnd6` in the round-six regime, and `ValNeed6` without it

* `gam_le`: `|gamI P s t α k| ≤ 2^(P+R+2)` for every `k ≤ λ` (one past the table);
* `expNeg_le`: `|expNeg P s j| ≤ 2^(P+R+2)` for every `j` (`s > 0`);
* `lam_P_le`: `200 (3λ + 1) < 2^Q` at `Q = segPF p d s`, `λ = lamP d`;
* **`chunkTabBnd6_all`**: `∀ P, P.Ok → ChunkTabBnd6 P`;
* **`valNeed6_all'`**: `P.Ok → ∀ ap, ValCond6 ap → ValNeed6 P ap`.
-/

open Finset Real

namespace J6Seg.TabBnd
open IntMul IntMul.HvdH IntMul.HvdH.JPf J6QLU J6Seg IntMul.Kappa.R6

variable {P R s t α lam : ℕ}

theorem lam_P_le (p d s : ℕ) : 200 * (3 * lamP d + 1) < 2 ^ segPF p d s := by
  have hl : lamP d ≤ lamF d + 1 := by
    unfold lamP
    by_cases h0 : lamF d = 0
    · rw [h0]; simp
    · have := Nat.pow_log_le_self 2 h0; omega
  have hN : 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) ≤ NF d s := by
    unfold NF
    have a1 : 0 < lamF d + 1 := by omega
    have a2 : 0 < 2 * wF d + 1 := by omega
    have a3 : 0 < (s + 1) ^ 2 := by positivity
    calc 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1)
        ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) :=
          Nat.le_mul_of_pos_right _ a1
      _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) :=
          Nat.le_mul_of_pos_right _ a2
      _ ≤ _ := Nat.le_mul_of_pos_right _ a3
  have h3 : 3 * lamF d + 3 ≤ (lamF d + 1) * (3 * lamF d + 3) :=
    Nat.le_mul_of_pos_left _ (by omega)
  have := Val.NF_lt_Q p d s
  omega

/-- **The chunk-table entries of every round-six axis are `≤ 2^(Q+R+2)`.** -/
theorem chunkTabBnd6_all (P : Prm) (hP : P.Ok) : ChunkTabBnd6 P := by
  obtain ⟨n₁, hR⟩ := r6_segReg P hP
  refine ⟨n₁, fun n hn src hsrc D hD k hk => ?_⟩
  have h := hR n hn src hsrc k (by omega)
  have hQ1 : 1 ≤ Q6 (pP6 P n) (dP6 P n) (src k) := by unfold Q6 segPF; omega
  have hPl : 200 * (3 * (lamP (dP6 P n) : ℝ) + 1) ≤ 2 ^ Q6 (pP6 P n) (dP6 P n) (src k) := by
    have := lam_P_le (pP6 P n) (dP6 P n) (src k)
    have h' : ((200 * (3 * lamP (dP6 P n) + 1) : ℕ) : ℝ) ≤ ((2 ^ segPF (pP6 P n) (dP6 P n) (src k) : ℕ) : ℝ) := by
      exact_mod_cast this.le
    push_cast at h'; exact h'
  exact tab_bnd h.hs h.hst h.hα hQ1 h.hl hPl h.hR

end J6Seg.TabBnd

namespace J6Seg.Val
open IntMul.Kappa.R6

/-- **`ValNeed6` in the round-six regime** (no remaining hypotheses besides the plan conditions). -/
theorem valNeed6_all' (P : Prm) (hP : P.Ok) : ∀ ap, ValCond6 ap → ValNeed6 P ap :=
  valNeed6_all P hP (TabBnd.chunkTabBnd6_all P hP)

end J6Seg.Val

end

