-- Source module: Solutions.R6CxNetBT
/-!
# A kernel-friendly finite map `ℕ → ℕ` (packed-leaf binary tree)

Depth-8 binary tree, 256 slots of 40 bits per leaf: capacity 65536 keys, values `< 2^40`.
`gget_gset`: reading back a write; `wf_gset`: writes keep the shape.
-/

namespace IntMul.Kappa.R6.Cx.NetBT

lemma SM_eq : SM = 2 ^ 40 := rfl

lemma testBit_lget (v j i : ℕ) : (lget v j).testBit i = (decide (i < 40) && v.testBit (40 * j + i)) := by
  rw [lget, SM_eq, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]

lemma testBit_ge_of_lt {x i : ℕ} (hx : x < 2 ^ 40) (hi : 40 ≤ i) : x.testBit i = false :=
  Nat.testBit_lt_two_pow (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) hi))

theorem lget_lset (v j x j' : ℕ) (hx : x < SM) :
    lget (lset v j x) j' = if j = j' then x else lget v j' := by
  rw [SM_eq] at hx
  apply Nat.eq_of_testBit_eq
  intro i
  rw [testBit_lget]
  by_cases hi : i < 40
  · simp only [hi, decide_true, Bool.true_and, lset, Nat.testBit_xor, Nat.testBit_shiftLeft,
      testBit_lget]
    split_ifs with hj
    · subst hj
      have h1 : 40 * j ≤ 40 * j + i := Nat.le_add_right _ _
      have h2 : 40 * j + i - 40 * j = i := by omega
      simp only [h1, decide_true, Bool.true_and, h2, hi]
      cases v.testBit (40 * j + i) <;> cases x.testBit i <;> rfl
    · rw [testBit_lget]
      have : (decide (40 * j ≤ 40 * j' + i) && ((decide (40 * j' + i - 40 * j < 40) &&
          v.testBit (40 * j + (40 * j' + i - 40 * j))) ^^ x.testBit (40 * j' + i - 40 * j))) = false := by
        by_cases hle : 40 * j ≤ 40 * j' + i
        · have hge : 40 ≤ 40 * j' + i - 40 * j := by
            rcases Nat.lt_or_gt_of_ne hj with h | h <;> omega
          simp [hle, Nat.not_lt.2 hge, testBit_ge_of_lt hx hge]
        · simp [hle]
      rw [this, Bool.xor_false]; simp [hi]
  · simp only [hi, decide_false, Bool.false_and]
    split_ifs
    · exact (testBit_ge_of_lt hx (Nat.not_lt.1 hi)).symm
    · rw [testBit_lget]; simp [hi]

theorem get_set : ∀ (d : ℕ) (t : BT), t.wf d = true → ∀ p p', p < 2 ^ d → p' < 2 ^ d →
    ∀ j j' x, x < SM → (t.set p j x).get p' j' = if p = p' ∧ j = j' then x else t.get p' j'
  | 0, .leaf v, _, p, p', hp, hp', j, j', x, hx => by
    have : p = 0 := by simpa using hp
    have : p' = 0 := by simpa using hp'
    subst_vars
    simp only [BT.set, BT.get, lget_lset _ _ _ _ hx, true_and]
  | d + 1, .node l r, hw, p, p', hp, hp', j, j', x, hx => by
    simp only [BT.wf, Bool.and_eq_true] at hw
    have hp2 : p / 2 < 2 ^ d := by rw [pow_succ] at hp; omega
    have hp2' : p' / 2 < 2 ^ d := by rw [pow_succ] at hp'; omega
    have key : p = p' ↔ (p % 2 = p' % 2 ∧ p / 2 = p' / 2) := by omega
    rcases Nat.mod_two_eq_zero_or_one p with h0 | h0 <;>
      rcases Nat.mod_two_eq_zero_or_one p' with h1 | h1
    · simp only [BT.set, BT.get, h0, h1, Nat.beq_refl, cond_true]
      rw [get_set d l hw.1 _ _ hp2 hp2' j j' x hx]
      simp only [key, h0, h1, true_and]
    · simp only [BT.set, BT.get, h0, h1, Nat.beq_refl, cond_true, show Nat.beq 1 0 = false from rfl,
        cond_false]
      rw [if_neg (by omega)]
    · simp only [BT.set, BT.get, h0, h1, Nat.beq_refl, cond_true, show Nat.beq 1 0 = false from rfl,
        cond_false]
      rw [if_neg (by omega)]
    · simp only [BT.set, BT.get, h0, h1, show Nat.beq 1 0 = false from rfl, cond_false]
      rw [get_set d r hw.2 _ _ hp2 hp2' j j' x hx]
      simp only [key, h0, h1, true_and]
  | 0, .node _ _, hw, _, _, _, _, _, _, _, _ => by simp [BT.wf] at hw
  | _ + 1, .leaf _, hw, _, _, _, _, _, _, _, _ => by simp [BT.wf] at hw

theorem wf_set : ∀ (d : ℕ) (t : BT), t.wf d = true → ∀ p j x, (t.set p j x).wf d = true
  | 0, .leaf v, _, _, _, _ => rfl
  | d + 1, .node l r, hw, p, j, x => by
    simp only [BT.wf, Bool.and_eq_true] at hw
    simp only [BT.set]
    cases Nat.beq (p % 2) 0 <;> simp [BT.wf, wf_set d l hw.1, wf_set d r hw.2, hw.1, hw.2]
  | 0, .node _ _, hw, _, _, _ => by simp [BT.wf] at hw
  | _ + 1, .leaf _, hw, _, _, _ => by simp [BT.wf] at hw

theorem gget_gset (t : BT) (ht : t.wf 8 = true) {i i' x : ℕ} (hi : i < CAP) (hi' : i' < CAP)
    (hx : x < SM) : gget (gset t i x) i' = if i = i' then x else gget t i' := by
  unfold gget gset CAP at *
  rw [get_set 8 t ht _ _ (by norm_num; omega) (by norm_num; omega) _ _ _ hx]
  congr 1
  apply propext
  constructor
  · rintro ⟨h1, h2⟩; omega
  · rintro rfl; exact ⟨rfl, rfl⟩

theorem wf_gset (t : BT) (ht : t.wf 8 = true) (i x : ℕ) : (gset t i x).wf 8 = true :=
  wf_set 8 t ht _ _ _

theorem BT.eq_of_beq : ∀ a b : BT, BT.beq a b = true → a = b
  | .leaf a, .leaf b, h => by simp only [BT.beq, Nat.beq_eq] at h; rw [h]
  | .node l r, .node l' r', h => by
    simp only [BT.beq, Bool.and_eq_true] at h
    rw [BT.eq_of_beq l l' h.1, BT.eq_of_beq r r' h.2]
  | .leaf _, .node _ _, h => by simp [BT.beq] at h
  | .node _ _, .leaf _, h => by simp [BT.beq] at h

end IntMul.Kappa.R6.Cx.NetBT

end

