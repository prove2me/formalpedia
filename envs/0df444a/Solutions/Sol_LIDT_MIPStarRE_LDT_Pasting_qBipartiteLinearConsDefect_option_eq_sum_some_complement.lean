variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    {α ιA ιB : Type*}
    [Fintype α] [Fintype ιA] [DecidableEq ιA] [Fintype ιB] [DecidableEq ιB]
    (ψ : _root_.LIDT.MIPStarRE.LDT.QuantumState (ιA × ιB))
    (A : _root_.LIDT.MIPStarRE.LDT.SubMeas (Option α) ιA) (B : _root_.LIDT.MIPStarRE.LDT.SubMeas (Option α) ιB)
    (hBtotal : B.total = 1)
    (hAnone : A.outcome none = 0) (hBnone : B.outcome none = 0) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.qBipartiteLinearConsDefect ψ A B =
      ∑ a : α, _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor (A.outcome (some a)) (1 - B.outcome (some a))) := by
  classical
  have htotal_sum :
      _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor A.total B.total) =
        ∑ o : Option α, _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor (A.outcome o) (1 : _root_.LIDT.MIPStarRE.Quantum.Op ιB)) := by
    calc
      _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor A.total B.total)
          = _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor A.total (1 : _root_.LIDT.MIPStarRE.Quantum.Op ιB)) := by
            rw [hBtotal]
      _ = _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor (∑ o : Option α, A.outcome o)
            (1 : _root_.LIDT.MIPStarRE.Quantum.Op ιB)) := by
            rw [A.sum_eq_total]
      _ = _root_.LIDT.MIPStarRE.LDT.ev ψ (∑ o : Option α,
            _root_.LIDT.MIPStarRE.LDT.opTensor (A.outcome o) (1 : _root_.LIDT.MIPStarRE.Quantum.Op ιB)) := by
            rw [_root_.LIDT.MIPStarRE.LDT.opTensor_sum_left_univ]
      _ = ∑ o : Option α, _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor (A.outcome o)
            (1 : _root_.LIDT.MIPStarRE.Quantum.Op ιB)) := by
            rw [_root_.LIDT.MIPStarRE.LDT.ev_sum]
  have hdiff_sum :
      _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor A.total B.total) - _root_.LIDT.MIPStarRE.LDT.qBipartiteMatchMass ψ A B =
        ∑ o : Option α, _root_.LIDT.MIPStarRE.LDT.ev ψ (_root_.LIDT.MIPStarRE.LDT.opTensor (A.outcome o) (1 - B.outcome o)) := by
