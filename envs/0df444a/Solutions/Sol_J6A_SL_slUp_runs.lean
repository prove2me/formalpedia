theorem zszW1 {a : ℤ} {W : ℕ} (h : |a| ≤ 2 ^ W) : zsz a ≤ W + 1 :=
  zsz_of_le (M := 2 ^ W) (by exact_mod_cast h) (by
    have := Nat.pow_lt_pow_right (a := 2) (by norm_num) (Nat.lt_succ_self W); exact this)

theorem natW {W : ℕ} {v : Vr} (hv : BV W v) {j : Fin HS} (hj : j ∈ rg) {a : ℕ}
    (ha : v j = (a : ℤ)) : a ≤ 2 ^ W := by
  have h := hv j hj
  rw [ha, abs_of_nonneg (by positivity)] at h
  exact_mod_cast h

/-! ## The frame -/

theorem ctl_state (v : Vr) (F : Fin HS → List ℤ) (cs : List (ℤ × ℤ)) (pre post n' N : ℕ)
    (hN : cs.length = N) (tab : List ℤ) (h44 : F 44 = []) (hρ : ∀ i, F (ρS i) = []) :
    cntOut (update (update (update (RF v (update F 44 tab)) 44 []) 38
      ((N : ℤ) :: RF v (update F 44 tab) 38)) 45 (flatC cs ++ RF v (update F 44 tab) 45)) pre post n' =
    RF v (extend ρS (slabV cs pre post n' [] []) F) := by
  rw [← regOut_RF v F cs pre post n' [] [] hρ]
  have e44 : update (RF v (update F 44 tab)) 44 [] = RF v F := by
    rw [upd_RF_out (show (44 : Fin HS) ∉ rg by decide), update_idem, ← h44, update_eq_self]
  have r38 : RF v (update F 44 tab) 38 = RF v F 38 := by
    rw [RF_out (show (38 : Fin HS) ∉ rg by decide), RF_out (show (38 : Fin HS) ∉ rg by decide),
      update_of_ne (by decide)]
  have r45 : RF v (update F 44 tab) 45 = RF v F 45 := by
    rw [RF_out (show (45 : Fin HS) ∉ rg by decide), RF_out (show (45 : Fin HS) ∉ rg by decide),
      update_of_ne (by decide)]
  rw [e44, r38, r45, ← hN]
  funext j
  simp only [cntOut, regOut, update_apply, List.nil_append]
  by_cases h45 : j = 45
  · subst h45; simp (config := { decide := true })
  by_cases h38 : j = 38
  · subst h38; simp (config := { decide := true })
  by_cases h37 : j = 37
  · subst h37; simp (config := { decide := true })
  by_cases h39 : j = 39
  · subst h39; simp (config := { decide := true })
  by_cases h40 : j = 40
  · subst h40; simp (config := { decide := true })
  simp [h45, h38, h37, h39, h40]
  split_ifs <;> simp_all

section frame
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem slUp_runs_sol_aux {P1 : RS} {Rn Rn' : Fin HS} (hRn : Rn ∈ rg) (hRn' : Rn' ∈ rg)
    (dR : Rn ≠ 20 ∧ Rn ≠ 21) (dR' : Rn' ≠ 20 ∧ Rn' ≠ 21 ∧ Rn' ≠ 38 ∧ Rn' ≠ 44 ∧ Rn' ≠ 45)
    (d3 : Rn' ≠ 37 ∧ Rn' ≠ 39)
    (s : IState HS) (F : Fin HS → List ℤ) (h44 : F 44 = []) (h43 : F 43 = []) (h34 : F 34 = [])
    (h35 : F 35 = []) (h36 : F 36 = []) (hρ : ∀ i, F (ρS i) = []) (hrg : ∀ j ∈ rg, F j = [])
    {n n' pre post W C1 : ℕ} {src : ℕ → Option ℕ} (hs : J6Seg.MonoSrc n n' src) (hW : 2 ≤ W)
    (h1 : ∃ v, BV W v ∧ v 1 = pre ∧ v 2 = post ∧ v Rn = n ∧ v Rn' = n' ∧
      ∀ s, Sp P1 (encK s F) (encK s (RF v (update F 44 (srcTab src (fun _ => 0) n')))) C1)
    (hT : pre * (n' * (2 * post)) ≤ 2 ^ W) (hp2 : 2 * post ≤ 2 ^ W) :
    IRuns I iprog (slUp P1 Rn Rn') (encK s F)
      (encK s (extend ρS (slabV (J6Seg.ctlOf n n' src (fun _ => 0)) pre post n' [] []) F))
      (C1 + ctlPhC W n n' + cTail W) := by
  obtain ⟨v, hB, h1v, h2v, hnv, hn'v, hP⟩ := h1
  set F1 := update F 44 (srcTab src (fun _ => 0) n') with hF1
  have a := J6Seg.KR.Sp.ir (I := I) (iprog := iprog) (hP s)
  have hFN : RF v F1 Rn = (n : ℤ) :: [] := by rw [RF_in hRn, hnv]
  have hFN' : RF v F1 Rn' = (n' : ℤ) :: [] := by rw [RF_in hRn', hn'v]
  have r5 : ∀ j ∈ rg, j.val < 56 := fun j hj => by revert hj; revert j; decide
  have b := ctlPh_runs (I := I) (iprog := iprog) s (RF v F1) (r5 _ hRn) (r5 _ hRn') dR dR' hs
    hFN hFN' (by rw [RF_out (by decide), hF1, update_self])
    (by rw [RF_out (by decide), hF1, update_of_ne (by decide), h43])
    (by rw [RF_out (by decide), hF1, update_of_ne (by decide), h34])
    (by rw [RF_out (by decide), hF1, update_of_ne (by decide), h35])
    (by rw [RF_out (by decide), hF1, update_of_ne (by decide), h36])
    (natW hB hRn hnv) (natW hB hRn' hn'v) (fun l _ => by simp) hW
  have hlen := J6Seg.Slab.length_ctlOf (argOf := fun _ => (0 : ℤ)) hs
  set G2 := update (update (update (RF v F1) 44 []) 38 (((n + n' : ℕ) : ℤ) :: RF v F1 38)) 45
    (flatC (J6Seg.ctlOf n n' src (fun _ => 0)) ++ RF v F1 45) with hG2
  have g1 : G2 1 = (pre : ℤ) :: [] := by
    rw [hG2, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide),
      RF_in (by decide), h1v]
  have g2 : G2 2 = (post : ℤ) :: [] := by
    rw [hG2, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide),
      RF_in (by decide), h2v]
  have g3 : G2 Rn' = (n' : ℤ) :: [] := by
    rw [hG2, update_of_ne dR'.2.2.2.2, update_of_ne dR'.2.2.1, update_of_ne dR'.2.2.2.1, hFN']
  have c := cntP_sp s G2 (iPre := 1) (iPost := 2) (iN := Rn') (by decide) (by decide) (r5 _ hRn')
    (by decide) (by decide) d3 g1 g2 g3 (natW hB (by decide) h1v) (natW hB (by decide) h2v)
    (natW hB hRn' hn'v) hW
  rw [hG2, ctl_state v F _ pre post n' (n + n') hlen _ h44 hρ] at c
  have f := fini_sp s (extend ρS (slabV (J6Seg.ctlOf n n' src (fun _ => 0)) pre post n' [] []) F)
    (fun j hj => by
      have hj' : ∀ i, ρS i ≠ j := fun i e => by subst e; revert hj; revert i; decide
      rw [J6Seg.Ax.extS_out hj']; exact hrg j hj) v (W := W + 1) (fun j hj => zszW1 (hB j hj))
  refine (a.seq (b.seq (J6Seg.KR.Sp.ir (I := I) (iprog := iprog) (c.seq f)))).mono ?_
  unfold cTail; omega

end frame

