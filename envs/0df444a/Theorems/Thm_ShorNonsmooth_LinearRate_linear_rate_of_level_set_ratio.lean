-- title:
--   Theorem 2.8 — level surfaces with ratio $\sigma \ge \sqrt2$ give $\|x_k - x^*\| \le h_{k+1}\sigma$ with $h_{k+1} = h_k\sqrt{\sigma^2-1}/\sigma$
-- statement:
--   Let $f$ be a convex function on $E_n$ with a unique minimum point $x^*$, and let $g_f(x)$ be any subgradient of $f$ at $x$. For a starting point $x_0$ choose numbers $\sigma$ and $h_1$ with
--   $$
--   \sigma \ge \sqrt2, \qquad h_1 \ge \|x_0 - x^*\|/\sigma .
--   $$
--   Let $Y = \{y : \|y - x^*\| \le \sigma h_1\}$ and assume that every pair of points $x, z \in Y$ with $f(x) = f(z) \ne f(x^*)$ satisfies
--   $$
--   \|x - x^*\| \le \sigma\,\|z - x^*\|. \tag{2.20}
--   $$
--   Then the sequence generated by
--   $$
--   x_{k+1} = x_k - h_{k+1}\frac{g_f(x_k)}{\|g_f(x_k)\|}, \qquad h_{k+1} = h_k\frac{\sqrt{\sigma^2 - 1}}{\sigma},
--   $$
--   converges to $x^*$ at a linear rate:
--   $$
--   \|x_k - x^*\| \le h_{k+1}\,\sigma, \qquad k = 0, 1, 2, \dots \tag{2.21}
--   $$
--
--   The theorem replaces the angle condition of Theorem 2.7 by a condition on the shape of the level surfaces of $f$ near the minimum: if they are not too oblong, the subgradient method with geometrically decreasing steps converges geometrically with ratio $\sqrt{\sigma^2-1}/\sigma$.
--
--   **Formalization Note** The book writes the stepsize rule for "$k = 0, 1, 2, \dots$", which would define $h_1$ from an undefined $h_0$ although $h_1$ is chosen; the rule is required for $k \ge 1$. The book's exception "$g_f(x_{\bar k}) = 0$ for some $\bar k$, i.e. $x_{\bar k} = x^*$" is the stop of the method: the sequence then stays at $x^*$, where (2.21) holds, so the bound is asserted for all $k$.
-- source:
--   Shor, Minimization Methods for Non-Differentiable Functions, Springer 1985, p. 32, Theorem 2.8, (2.20)–(2.21)

import Mathlib
import Definitions.Def_ShorNonsmooth_LinearRate_SubgradientMethod

namespace ShorNonsmooth.LinearRate

/-- Shor (1985), p. 32, **Theorem 2.8**. Let `f` be convex on `E_n` with unique minimum point
`x*`. For a starting point `x₀` let `σ ≥ √2` and `h₁ ≥ ‖x₀ - x*‖/σ`, let
`Y = {y : ‖y - x*‖ ≤ σ h₁}`, and assume (2.20): `‖x - x*‖ ≤ σ ‖z - x*‖` for every pair
`x, z ∈ Y` with `f(x) = f(z) ≠ f(x*)`. Then the normalized subgradient iterates with stepsizes
`h_{k+1} = h_k √(σ² - 1)/σ` (`k ≥ 1`) satisfy (2.21): `‖x_k - x*‖ ≤ h_{k+1} σ` for all `k`.
The book's exception "`g_f(x_k̄) = 0`, i.e. `x_k̄ = x*`" is the stop of the method; the stopped
sequence stays at `x*`, where the bound holds trivially. -/
theorem linear_rate_of_level_set_ratio {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (hf : ConvexOn ℝ Set.univ f) (xs : EuclideanSpace ℝ (Fin n)) (hxs : ShorNonsmooth.SubgradMethod.MinSet f = {xs})
    (x₀ : EuclideanSpace ℝ (Fin n)) (σ : ℝ) (h : ℕ → ℝ)
    (hσ : Real.sqrt 2 ≤ σ) (hh₁ : ‖x₀ - xs‖ / σ ≤ h 1)
    (hY : ∀ x ∈ Metric.closedBall xs (σ * h 1), ∀ z ∈ Metric.closedBall xs (σ * h 1),
      f x = f z → f x ≠ f xs → ‖x - xs‖ ≤ σ * ‖z - xs‖)
    (hrec : ∀ k, 1 ≤ k → h (k + 1) = h k * (Real.sqrt (σ ^ 2 - 1) / σ))
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hg : ∀ x, ShorNonsmooth.AlmostDiff.IsSubgradient f x (g x)) :
    ∀ k, ‖ShorNonsmooth.SubgradMethod.normalizedIter g h x₀ k - xs‖ ≤ h (k + 1) * σ := by sorry

end ShorNonsmooth.LinearRate
