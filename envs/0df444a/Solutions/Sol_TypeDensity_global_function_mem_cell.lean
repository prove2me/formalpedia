private theorem span_sup_eq_top_of_isUnit_coeff {R B C : Type} [CommRing R] [CommRing B]
    [CommRing C] [Algebra R B] (φ : B →+* C) (w : B)
    (d : ℕ) (c : Fin (d + 1) → R) (n : Fin (d + 1) → ℕ) (j : Fin (d + 1)) (hj : IsUnit (c j))
        (hnj : n j = 0)
    (hn : ∀ i, i ≠ j → n i ≠ 0) :
    Ideal.span {φ (∑ i : Fin (d+1), algebraMap R B (c i) * w^(n i))} ⊔ Ideal.span {φ w} = ⊤ := by
  set J := Ideal.span {φ (∑ i : Fin (d+1), algebraMap R B (c i) * w^(n i))} ⊔ Ideal.span {φ w}
  have hw : Ideal.Quotient.mk J (φ w) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_right (Ideal.subset_span rfl))
  have hF : Ideal.Quotient.mk J (φ (∑ i : Fin (d+1), algebraMap R B (c i) * w^(n i))) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_sup_left (Ideal.subset_span rfl))
  have hF' : Ideal.Quotient.mk J (φ (∑ i : Fin (d+1), algebraMap R B (c i) * w^(n i))) =
      Ideal.Quotient.mk J (φ (algebraMap R B (c j))) := by
    simp only [map_sum, map_mul, map_pow, hw]
    rw [Finset.sum_eq_single j]
    · rw [hnj, pow_zero, mul_one]
    · intro i _ hi
      rw [zero_pow (hn i hi), mul_zero]
    · intro h; exact absurd (Finset.mem_univ j) h
  rw [hF] at hF'
  have hmem : φ (algebraMap R B (c j)) ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp hF'.symm
  exact Ideal.eq_top_of_isUnit_mem _ hmem ((hj.map (algebraMap R B)).map φ)

/-- If the residues of `c₀, …, c_n` are the coefficients of `P · κ` (`κ ≠ 0`), where `P` is the
monic affine polynomial of `Dv` and `deg P + Dv ∞ = n`, then `c_n` is a unit when `Dv` avoids
`∞`, and `c₀` is a unit when `Dv` avoids the zero direction. -/
private theorem isUnit_coeffs_of_residue_eq {R : Type} [CommRing R] [IsLocalRing R]
    (Dv : ExceptionalDivisor (IsLocalRing.ResidueField R)) {n : ℕ} (c : Fin (n + 1) → R)
    (κ : IsLocalRing.ResidueField R) (hκ : κ ≠ 0)
    (hPmon : (divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv).Monic)
    (hPdeg : (divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv).natDegree + Dv none = n)
    (hcoeff : ∀ i : Fin (n + 1), (divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv *
      Polynomial.C κ).coeff i.val = IsLocalRing.residue R (c i)) :
    (Dv none = 0 → IsUnit (c (Fin.last n))) ∧
      (Dv (zeroDirection (IsLocalRing.ResidueField R)) = 0 → IsUnit (c 0)) := by
  refine ⟨fun h0 ↦ ?_, fun h0 ↦ ?_⟩ <;>
    rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff, ← hcoeff,
      Polynomial.coeff_mul_C]
  · rw [Fin.val_last, ← hPdeg, h0, add_zero, ← Polynomial.leadingCoeff, hPmon.leadingCoeff,
      one_mul]
    exact hκ
  · refine mul_ne_zero (fun hP ↦ ?_) hκ
    rw [Fin.val_zero, ← Polynomial.X_dvd_iff] at hP
    exact (Nat.pos_iff_ne_zero.mp ((count_normalizedFactors_divisorAffinePolynomial _ Dv 1
      one_ne_zero (zeroAffine _)).2.mp hP)) h0

