section DinhSharpnessBundleModule1
/-!
Calculus bridges for Dinh et al., arXiv:1703.04933v2, Section 4.2,
PDF p. 5, Theorem 3 and its unnumbered derivative transformation displays.
These lemmas express the chain rule for an invariant loss under a linear equivalence.
-/

noncomputable section

open scoped Topology

namespace DinhSharpness

section Equiv

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem fderiv_covariance (e : E ≃L[ℝ] E) (f : E → ℝ) (hi : f ∘ e = f)
    (x v : E) : fderiv ℝ f (e x) (e v) = fderiv ℝ f x v := by
  have h := e.comp_right_fderiv (f := f) (x := x)
  rw [hi] at h
  exact (congrArg (fun k : E →L[ℝ] ℝ ↦ k v) h).symm

theorem fderiv_equiv (e : E ≃L[ℝ] E) (f : E → ℝ) (hi : f ∘ e = f) :
    (fderiv ℝ f) ∘ e =
      (e.arrowCongr (ContinuousLinearEquiv.refl ℝ ℝ)) ∘ (fderiv ℝ f) := by
  ext y z
  have h := e.comp_right_fderiv (f := f) (x := y)
  rw [hi] at h
  have heq := congrArg (fun k : E →L[ℝ] ℝ ↦ k (e.symm z)) h
  simpa using heq.symm

theorem sndFDeriv_covariance (e : E ≃L[ℝ] E) (f : E → ℝ) (hi : f ∘ e = f)
    (x v w : E) :
    fderiv ℝ (fderiv ℝ f) (e x) (e v) (e w) = fderiv ℝ (fderiv ℝ f) x v w := by
  let A : (E →L[ℝ] ℝ) ≃L[ℝ] (E →L[ℝ] ℝ) :=
    e.arrowCongr (ContinuousLinearEquiv.refl ℝ ℝ)
  have hd : (fderiv ℝ f) ∘ e = A ∘ (fderiv ℝ f) := fderiv_equiv e f hi
  have h := congrArg (fun g : E → (E →L[ℝ] ℝ) ↦ fderiv ℝ g x) hd
  dsimp only at h
  rw [e.comp_right_fderiv, A.comp_fderiv] at h
  have heq := congrArg (fun k : E →L[ℝ] (E →L[ℝ] ℝ) ↦ k v (e w)) h
  simpa [A] using heq

end Equiv

theorem TwiceDifferentiableAt.equiv {d h : ℕ} {L : Parameter d h → ℝ}
    {θ : Parameter d h} (hf : TwiceDifferentiableAt L θ)
    (e : Parameter d h ≃L[ℝ] Parameter d h) (hi : L ∘ e = L) :
    TwiceDifferentiableAt L (e θ) := by
  refine ⟨?_, ?_⟩
  · rw [← e.map_nhds_eq θ]
    change ∀ᶠ z in 𝓝 θ, DifferentiableAt ℝ L (e z)
    filter_upwards [hf.1] with z hz
    apply e.comp_right_differentiableAt_iff.mp
    simpa only [hi] using hz
  · apply e.comp_right_differentiableAt_iff.mp
    rw [fderiv_equiv e L hi]
    exact (e.arrowCongr (ContinuousLinearEquiv.refl ℝ ℝ)).differentiableAt.comp θ hf.2

theorem TwiceDifferentiableAt.hessian_symm {d h : ℕ} {L : Parameter d h → ℝ}
    {θ : Parameter d h} (hf : TwiceDifferentiableAt L θ) (u v : Parameter d h) :
    hessian L θ u v = hessian L θ v u := by
  exact second_derivative_symmetric_of_eventually
    (hf.1.mono fun _ hz ↦ hz.hasFDerivAt) hf.2.hasFDerivAt u v

theorem loss_comp_scaleEquiv {d h : ℕ} (ℓ : (Input d → ℝ) → ℝ)
    {α : ℝ} (ha : 0 < α) :
    parameterLoss (h := h) ℓ ∘ scaleEquiv α ha.ne' = parameterLoss ℓ := by
  funext θ
  exact loss_scale ℓ θ ha

theorem TwiceDifferentiableAt.scale {d h : ℕ} {ℓ : (Input d → ℝ) → ℝ}
    {θ : Parameter d h} (hf : TwiceDifferentiableAt (parameterLoss ℓ) θ)
    {α : ℝ} (ha : 0 < α) : TwiceDifferentiableAt (parameterLoss ℓ) (scale α θ) :=
  hf.equiv (scaleEquiv α ha.ne') (loss_comp_scaleEquiv ℓ ha)

theorem fderiv_scale {d h : ℕ} (ℓ : (Input d → ℝ) → ℝ) (θ : Parameter d h)
    {α : ℝ} (ha : 0 < α) (u : Parameter d h) :
    fderiv ℝ (parameterLoss ℓ) (scale α θ) u =
      fderiv ℝ (parameterLoss ℓ) θ (scale α⁻¹ u) := by
  have hc := fderiv_covariance (scaleEquiv α ha.ne') (parameterLoss ℓ)
    (loss_comp_scaleEquiv ℓ ha) θ ((scaleEquiv α ha.ne').symm u)
  simpa only [ContinuousLinearEquiv.apply_symm_apply, scaleEquiv_apply,
    scaleEquiv_symm_apply, scale_scale_inv α ha.ne'] using hc

theorem hessian_scale {d h : ℕ} (ℓ : (Input d → ℝ) → ℝ) (θ : Parameter d h)
    {α : ℝ} (ha : 0 < α) (u v : Parameter d h) :
    hessian (parameterLoss ℓ) (scale α θ) u v =
      hessian (parameterLoss ℓ) θ (scale α⁻¹ u) (scale α⁻¹ v) := by
  have hc := sndFDeriv_covariance (scaleEquiv α ha.ne') (parameterLoss ℓ)
    (loss_comp_scaleEquiv ℓ ha) θ ((scaleEquiv α ha.ne').symm u)
    ((scaleEquiv α ha.ne').symm v)
  simpa only [hessian, ContinuousLinearEquiv.apply_symm_apply, scaleEquiv_apply,
    scaleEquiv_symm_apply, scale_scale_inv α ha.ne'] using hc

/-- The exact derivative-transformation milestone from Theorem 3. -/
theorem derivativeTransformation :
    ∀ (d h : ℕ), 0 < d → 0 < h →
      ∀ (ℓ : (Input d → ℝ) → ℝ), Continuous (parameterLoss (h := h) ℓ) →
        ∀ (θ : Parameter d h), TwiceDifferentiableAt (parameterLoss ℓ) θ →
          ∀ (α : ℝ), 0 < α →
            TwiceDifferentiableAt (parameterLoss ℓ) (scale α θ) ∧
            (∀ u : Parameter d h,
              fderiv ℝ (parameterLoss ℓ) (scale α θ) u =
                fderiv ℝ (parameterLoss ℓ) θ (scale α⁻¹ u)) ∧
            (∀ u v : Parameter d h,
              hessian (parameterLoss ℓ) (scale α θ) u v =
                hessian (parameterLoss ℓ) θ (scale α⁻¹ u) (scale α⁻¹ v)) := by
  intro d h _ _ ℓ _ θ hθ α ha
  exact ⟨hθ.scale ha, fderiv_scale ℓ θ ha, hessian_scale ℓ θ ha⟩

end DinhSharpness
end -- original EOF-open anonymous section
