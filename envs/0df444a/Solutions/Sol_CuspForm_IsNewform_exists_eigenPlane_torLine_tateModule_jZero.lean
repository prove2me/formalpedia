    [Module.Finite ℤ_[lam] O''] [Module.Free ℤ_[lam] O'']
    (𝒟 : SemistableToricDatum.ToricDatum N q hqN A hA) (hlq : lam ≠ q)
    (g : CuspForm (CongruenceSubgroup.Gamma0 (N * q)) 2) (hg : g.IsNewform)
