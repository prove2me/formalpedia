-- ===== S4.Def_RP_EtPBC_A_CovAs6c =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As6c): residue maps of the approximated overlap, generic identities

* `resid_mk_map`: `resid` on the class of `map f' w` is `θh` on the class of `map fh w`.
* `comp_presMap_X`: from `θ' ∘ presMap f' = θh ∘ presMap fh`, the values on the variables agree.
* `kap_comp_tsC`: the coefficient hypothesis of `resid` for `fh = tvC B C`, `f' = tsC σ B`, `κ' = kap`.
* `phib_K`, `fib_coeff`: the fibre gluing maps are `K`-linear, and the coefficient identity of `ctheta0`/`ctheta1`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section ResidMap

end ResidMap

section CompX

variable {Cc S S' : Type u} [CommRing Cc] [CommRing S] [CommRing S'] {r : ℕ} {Q : Type u} [CommRing Q]

theorem comp_presMap_X (fh : Cc →+* S) (f' : Cc →+* S') (gC : Fin r → MvPolynomial (Fin r) Cc)
    (θ' : Pres (gmap f' gC) →+* Q) (θh : Pres (gmap fh gC) →+* Q)
    (h : θ'.comp (presMap f' gC) = θh.comp (presMap fh gC)) (j : Fin r) :
    θ' (Ideal.Quotient.mk _ (MvPolynomial.X j)) = θh (Ideal.Quotient.mk _ (MvPolynomial.X j)) := by
  have e := RingHom.congr_fun h (Ideal.Quotient.mk _ (MvPolynomial.X j))
  rw [RingHom.comp_apply, RingHom.comp_apply, presMap_X, presMap_X] at e
  exact e

end CompX

section Kap

end Kap

section Fib

variable {K A R' B N : Type u} [Field K] [CommRing A] [CommRing R'] [Algebra A R'] [CommRing B] [Algebra A B]
  [CommRing N] [Algebra A N] {F F' : Type u} [CommRing F] [CommRing F'] [Algebra K F] [Algebra K F']

theorem phib_K (χ : A →+* K) (hχ : Function.Surjective χ) (φ : B →ₐ[A] N) (β : B →+* F) (β' : N →+* F')
    (φb : F →+* F') (hβ : ∀ a, β (algebraMap A B a) = algebraMap K F (χ a))
    (hβ' : ∀ a, β' (algebraMap A N a) = algebraMap K F' (χ a)) (hρ : ∀ b, φb (β b) = β' (φ b)) (k : K) :
    φb (algebraMap K F k) = algebraMap K F' k := by
  obtain ⟨a, rfl⟩ := hχ k
  rw [← hβ a, hρ, AlgHom.commutes, hβ']

end Fib

