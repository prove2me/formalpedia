-- Source module: Solutions.KFUURev5
/-!
# KFUU §2e: the `SwapNeed` entry inside a table, and one swap step of phase 2

* `SwOKU`: the conclusion of `KFM.SwapNeed` for a table `iprog` and an entry `eSw`.
* `swOKU_run`: the same with the frame written as a plain state (`t.G 0`, `t.G dS`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The cost bound of one `SwapNeed` call. -/
noncomputable def cSwN (K : ℝ) (w u : ℕ) (sh : Shape) : ℝ :=
  K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
    (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ))

/-- What `KFM.SwapNeed` provides, in the table `iprog` at the entry `eSw`. -/
def SwOKU (I : List Sym) (iprog : Fin P → IStmt HS P) (eSw : Fin P) (dS : Fin HS) (K : ℝ) : Prop :=
  ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) →
    p < q → q < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = KFM.descSw w u p q sh →
    f 0 = gflat zs ++ l → zs.length = vol sh → NLogN.KFB.GB w zs →
    ∃ c : ℕ, IRuns I iprog (.call eSw) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
      (c : ℝ) ≤ cSwN K w u sh

/-! ## Moving and dropping a fixed number of items -/

def mvK (X Y : Fin HS) : ℕ → IStmt HS P
  | 0 => .skip
  | k + 1 => .seq (.op (.mv X Y)) (mvK X Y k)

def dropK (X : Fin HS) : ℕ → IStmt HS P
  | 0 => .skip
  | k + 1 => .seq (.op (.drop X)) (dropK X k)

/-! ## Pushing a list of register values and constants -/

def pushOp (D : Fin HS) : Fin HS ⊕ ℤ → IStmt HS P
  | .inl X => .op (.dup X D)
  | .inr c => .op (.const D c)

def pushL (D : Fin HS) : List (Fin HS ⊕ ℤ) → IStmt HS P
  | [] => .skip
  | o :: os => .seq (pushOp D o) (pushL D os)

/-- The source `o` provides the value `v` in the state `t` (pushing onto `D`). -/
def PushOK (t : IState HS) (D : Fin HS) : Fin HS ⊕ ℤ → ℤ → Prop
  | .inl X, v => X ≠ D ∧ ∃ L, t.G X = .int v :: L
  | .inr c, v => c = v

/-! ## One swap through the entry -/

abbrev rA : Fin HS := 41
abbrev rB : Fin HS := 15
abbrev rM : Fin HS := 16
abbrev rH : Fin HS := 17

/-- The sources of the swap descriptor `[w, u, 1, 3, 5, A, 2^u, M, 2^u, C]`. -/
def descSrc : List (Fin HS ⊕ ℤ) :=
  [.inl rW, .inl NLogN.KFUU.rU, .inr 1, .inr 3, .inr 5, .inl rA, .inl rU2, .inl NLogN.KFUU.rM, .inl rU2, .inl NLogN.KFUU.rB]

/-- Build the descriptor on `Dsc`, move it to `dS`, call the swap entry, drop the descriptor. -/
def swS (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (NLogN.KFUU.pushL Dsc descSrc) (.seq (mvK Dsc dS 10) (.seq (.call eSw) (dropK dS 10)))

end Gen

end NLogN.KFUU

end

