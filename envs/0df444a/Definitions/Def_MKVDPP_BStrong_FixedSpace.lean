-- title:
--   Fixed canonical probability space and strong formulation
-- statement:
--   For each initial time $t$, the fixed canonical space consists of an initial state path and two noise paths on $[t,T]$. Its two natural filtrations observe either both noises and the initial state, or common noise alone. The canonical law has initial state law $\nu(t)$ and independent standard Brownian increments.
--
--   Common noise predictable controls of finite quadratic energy form $\mathcal A_2^{\mathbb B}(t,\nu)$. A strong solution is continuous and adapted, equals its prescribed initial path, has finite second supremum moment, and solves the conditional McKean–Vlasov equation. The fixed space value is
--
--   $$V_S^{\mathbb B}(t,\nu)=\sup_{\alpha\in\mathcal A_2^{\mathbb B}(t,\nu)}J(t,\nu,\alpha).$$
--
--   This is the formulation used in the target dynamic programming identity.
--
--   **Formalization Note** A canonical law is a family satisfying the paper's prescribed properties. The supremum ranges over all solutions and conditional law versions; Theorem A.3(i) gives uniqueness under Assumption 2.8.
-- source:
--   Djete, Possamaï, Tan, McKean–Vlasov optimal control: the dynamic programming principle, arXiv:1907.08860v2, pp. 8–9, equations (2.10)–(2.12); p. 27, equation (A.1), Definition A.2

import Definitions.Def_MKVDPP_BStrong_WeakControl

open MeasureTheory ProbabilityTheory Filter Classical
open scoped ENNReal NNReal Topology BigOperators

namespace MKVDPP.BStrong

variable {T : ℝ≥0} {n d ell : ℕ} {U : Type*}
variable [MetricSpace U] [CompleteSpace U] [TopologicalSpace.SeparableSpace U]
variable [Nonempty U] [MeasurableSpace U] [BorelSpace U]

/-- Continuous paths on an interval [a,b]. -/
abbrev Csegment (a b : ℝ≥0) (k : ℕ) :=
  C(Set.Icc (a : ℝ) (b : ℝ), EuclideanSpace ℝ (Fin k))

instance (a b : ℝ≥0) (k : ℕ) : MeasurableSpace (Csegment a b k) := borel _
instance (a b : ℝ≥0) (k : ℕ) : BorelSpace (Csegment a b k) := ⟨rfl⟩

/-- The fixed canonical probability space Ωᵗ of (2.10). -/
abbrev OmegaT (T : ℝ≥0) (n d ell : ℕ) (t : ℝ≥0) :=
  Csegment 0 t n × Csegment t T d × Csegment t T ell

/-- Extend the initial path ζ on [0,t] constantly to [0,T]. -/
noncomputable def initialPath (t : ℝ≥0) (ω : OmegaT T n d ell t) : Cpath T n :=
  ω.1.comp ⟨(fun s : Set.Icc (0 : ℝ) (T : ℝ) =>
    (⟨min (s : ℝ) (t : ℝ),
      ⟨le_min s.property.1 t.property, min_le_right _ _⟩⟩ :
      Set.Icc (0 : ℝ) (t : ℝ))), by fun_prop⟩

/-- Evaluate a noise path on [t,T] at s∨t, with s clamped to T. -/
noncomputable def segmentAt {k : ℕ} (t : ℝ≥0) (ht : t ≤ T)
    (x : Csegment t T k) (s : ℝ≥0) : EuclideanSpace ℝ (Fin k) :=
  x ⟨max (t : ℝ) (min (s : ℝ) (T : ℝ)),
    ⟨le_max_left _ _, max_le (by exact_mod_cast ht) (min_le_right _ _)⟩⟩

/-- Extend a noise path on [t,T] constantly to times before t. -/
noncomputable def extendNoise {k : ℕ} (t : ℝ≥0) (ht : t ≤ T)
    (x : Csegment t T k) : Cpath T k :=
  x.comp ⟨(fun s : Set.Icc (0 : ℝ) (T : ℝ) =>
    (⟨max (t : ℝ) (s : ℝ),
      ⟨le_max_left _ _, max_le (by exact_mod_cast ht) s.property.2⟩⟩ :
      Set.Icc (t : ℝ) (T : ℝ))), by fun_prop⟩

/-- Idiosyncratic and common Brownian increments on Ωᵗ. -/
noncomputable def Wt (t : ℝ≥0) (ht : t ≤ T) (s : ℝ≥0)
    (ω : OmegaT T n d ell t) : EuclideanSpace ℝ (Fin d) :=
  segmentAt t ht ω.2.1 s - segmentAt t ht ω.2.1 t

noncomputable def Bt (t : ℝ≥0) (ht : t ≤ T) (s : ℝ≥0)
    (ω : OmegaT T n d ell t) : EuclideanSpace ℝ (Fin ell) :=
  segmentAt t ht ω.2.2 s - segmentAt t ht ω.2.2 t

/-- The raw common-noise filtration on Ωᵗ, equation (2.10). -/
noncomputable def rawGt (t : ℝ≥0) (ht : t ≤ T) (s : ℝ≥0) :
    MeasurableSpace (OmegaT T n d ell t) :=
  if s < t then ⊥ else
    ⨆ r : ℝ≥0, ⨆ _ : t ≤ r ∧ r ≤ s,
      MeasurableSpace.comap (Bt t ht r) inferInstance

/-- The raw full filtration on Ωᵗ. -/
noncomputable def rawFt (t : ℝ≥0) (ht : t ≤ T) (s : ℝ≥0) :
    MeasurableSpace (OmegaT T n d ell t) :=
  if s < t then MeasurableSpace.comap (stopPath s ∘ initialPath t) inferInstance else
    MeasurableSpace.comap (stopPath t ∘ initialPath t) inferInstance ⊔
      (⨆ r : ℝ≥0, ⨆ _ : t ≤ r ∧ r ≤ s,
        MeasurableSpace.comap (fun ω => (Wt t ht r ω, Bt t ht r ω)) inferInstance)

/-- The predictable σ-algebra generated by a time-indexed family of past σ-algebras. -/
def predictableOf {Ω : Type*} [MeasurableSpace Ω]
    (H : ℝ≥0 → MeasurableSpace Ω) : MeasurableSpace (ℝ≥0 × Ω) :=
  MeasurableSpace.generateFrom <|
    {S | ∃ A, MeasurableSet[H 0] A ∧ S = {0} ×ˢ A} ∪
    {S | ∃ s A, MeasurableSet[H s] A ∧ S = Set.Ioi s ×ˢ A}

/-- The P-augmented fixed-space filtrations. -/
noncomputable def Gt (t : ℝ≥0) (ht : t ≤ T)
    (P : Measure (OmegaT T n d ell t)) (s : ℝ≥0) :
    MeasurableSpace (OmegaT T n d ell t) := augmented P (rawGt t ht s)

noncomputable def Ft (t : ℝ≥0) (ht : t ≤ T)
    (P : Measure (OmegaT T n d ell t)) (s : ℝ≥0) :
    MeasurableSpace (OmegaT T n d ell t) := augmented P (rawFt t ht s)

/-- A Brownian motion relative to a time-indexed family of σ-algebras. -/
def IsBrownianFor {Ω : Type*} [MeasurableSpace Ω] {k : ℕ}
    (H : ℝ≥0 → MeasurableSpace Ω) (P : Measure Ω)
    (t T : ℝ≥0) (W : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k)) : Prop :=
  (∀ ω, ContinuousOn (fun s : ℝ≥0 => W s ω) (Set.Icc 0 T)) ∧
  (∀ s, t ≤ s → s ≤ T → Measurable[H s] (W s)) ∧
  ∀ s u, t ≤ s → s ≤ u → u ≤ T →
    Indep (MeasurableSpace.comap (fun ω => W u ω - W s ω) inferInstance) (H s) P ∧
    Measure.map (fun ω => W u ω - W s ω) P =
      (Measure.pi (fun _ : Fin k => gaussianReal 0 ⟨(u - s : ℝ≥0), by positivity⟩)).map
        (fun v : Fin k → ℝ => (WithLp.toLp 2 v : EuclideanSpace ℝ (Fin k)))

/-- The defining properties of the fixed law Pᵗ_ν. The Brownian pair is
independent of the initial path ζ. -/
def IsCanonicalLaw (t : ℝ≥0) (ht : t ≤ T)
    (ν : ProbabilityMeasure (Cpath T n))
    (P : Measure (OmegaT T n d ell t)) : Prop :=
  IsProbabilityMeasure P ∧
  Measure.map (stopPath t ∘ initialPath t) P =
    Measure.map (stopPath t) (ν : Measure (Cpath T n)) ∧
  IsBrownianFor (rawFt t ht) P t T (Wt t ht) ∧
  IsBrownianFor (rawFt t ht) P t T (Bt t ht) ∧
  Indep (MeasurableSpace.comap
      (fun ω : OmegaT T n d ell t => shiftedPath t (extendNoise t ht ω.2.1)) inferInstance)
    (MeasurableSpace.comap
      (fun ω : OmegaT T n d ell t => shiftedPath t (extendNoise t ht ω.2.2)) inferInstance) P ∧
  Indep (MeasurableSpace.comap (fun ω : OmegaT T n d ell t => ω.1) inferInstance)
    (MeasurableSpace.comap (fun ω : OmegaT T n d ell t =>
      (shiftedPath t (extendNoise t ht ω.2.1),
        shiftedPath t (extendNoise t ht ω.2.2))) inferInstance) P

/-- Common-noise-predictable square-integrable controls A₂ᴮ(t,ν). -/
def AB2 (M : Model T n d ell U) (Pt : (t : ℝ≥0) →
    ProbabilityMeasure (Cpath T n) → Measure (OmegaT T n d ell t))
    (t : ℝ≥0) (ht : t ≤ T) (ν : ProbabilityMeasure (Cpath T n)) :
    Set (ℝ≥0 → OmegaT T n d ell t → U) :=
  {α | Measurable[predictableOf (Gt t ht (Pt t ν))]
      (fun z : ℝ≥0 × OmegaT T n d ell t => α z.1 z.2) ∧
    ∫⁻ ω, ∫⁻ s in Set.Icc (t : ℝ) (T : ℝ),
      edist (α s.toNNReal ω) M.u₀ ^ (2 : ℝ) ∂volume ∂(Pt t ν) < ⊤}

/-- Definition A.2, with the conditional-law process and equation (A.1). -/
def IsStrongSolution (M : Model T n d ell U) {Ω : Type*}
    [MeasurableSpace Ω] (P : Measure Ω)
    (F G : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (t : ℝ≥0)
    (ξ X : Ω → Cpath T n) (W : Ω → Cpath T d) (B : Ω → Cpath T ell)
    (α : ℝ≥0 → Ω → U)
    (μbar : ℝ≥0 → Ω → ProbabilityMeasure (Cpath T n × U)) : Prop :=
  (∀ s, s ≤ T → Measurable[F s] (fun ω => pathAt (X ω) s)) ∧
  (∀ s, s ≤ t → ∀ᵐ ω ∂P, pathAt (X ω) s = pathAt (ξ ω) s) ∧
  (∫⁻ ω, ENNReal.ofReal (‖X ω‖ ^ 2) ∂P) < ⊤ ∧
  IsProgressive G μbar ∧
  (∀ᵐ s ∂volume.restrict (Set.Icc (t : ℝ) (T : ℝ)),
    ∃ m : Ω → ProbabilityMeasure (Cpath T n × U),
      IsCondLaw (G s.toNNReal) P
        (fun ω => (stopPath s.toNNReal (X ω), α s.toNNReal ω)) m ∧
      μbar s.toNNReal =ᵐ[P] m) ∧
  SDEEquation M t P F X W B α μbar

/-- Reward J(t,ν,α) of (2.12), for a chosen strong solution and terminal
conditional-law version. -/
noncomputable def Jfix (M : Model T n d ell U) (t : ℝ≥0)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (X : Ω → Cpath T n) (α : ℝ≥0 → Ω → U)
    (μbar : ℝ≥0 → Ω → ProbabilityMeasure (Cpath T n × U))
    (mT : Ω → ProbabilityMeasure (Cpath T n)) : EReal :=
  eExp P (fun ω =>
    timeInt t T (fun s => (M.L s (stopPath s (X ω)) (μbar s ω) (α s ω) : EReal)) +
      (M.g (X ω) (mT ω) : EReal))

/-- A solution of (2.11) on the fixed space with its augmented filtrations. -/
def IsFixedSolution (M : Model T n d ell U)
    (Pt : (t : ℝ≥0) → ProbabilityMeasure (Cpath T n) →
      Measure (OmegaT T n d ell t))
    (t : ℝ≥0) (ht : t ≤ T) (ν : ProbabilityMeasure (Cpath T n))
    (α : ℝ≥0 → OmegaT T n d ell t → U)
    (X : OmegaT T n d ell t → Cpath T n)
    (μbar : ℝ≥0 → OmegaT T n d ell t → ProbabilityMeasure (Cpath T n × U)) : Prop :=
  ∃ F G : Filtration ℝ≥0 (inferInstance : MeasurableSpace (OmegaT T n d ell t)),
    (∀ s, F s = Ft t ht (Pt t ν) s) ∧
    (∀ s, G s = Gt t ht (Pt t ν) s) ∧
    IsStrongSolution M (Pt t ν) F G t (initialPath t) X
      (fun ω => extendNoise t ht ω.2.1)
      (fun ω => extendNoise t ht ω.2.2) α μbar

/-- The fixed-space value in the B-strong formulation. The sup ranges over
all solutions and conditional-law versions; uniqueness makes this the paper's
single-solution notation. -/
noncomputable def VSB (M : Model T n d ell U)
    (Pt : (t : ℝ≥0) → ProbabilityMeasure (Cpath T n) →
      Measure (OmegaT T n d ell t))
    (t : ℝ≥0) (ht : t ≤ T) (ν : ProbabilityMeasure (Cpath T n)) : EReal :=
  ⨆ (α : ℝ≥0 → OmegaT T n d ell t → U), ⨆ (_ : α ∈ AB2 M Pt t ht ν),
    ⨆ (X : OmegaT T n d ell t → Cpath T n),
      ⨆ (μbar : ℝ≥0 → OmegaT T n d ell t → ProbabilityMeasure (Cpath T n × U)),
        ⨆ (_ : IsFixedSolution M Pt t ht ν α X μbar),
          ⨆ (mT : OmegaT T n d ell t → ProbabilityMeasure (Cpath T n)),
            ⨆ (_ : IsCondLaw (Gt t ht (Pt t ν) T) (Pt t ν)
              (fun ω => stopPath T (X ω)) mT),
              Jfix M t (Pt t ν) X α μbar mT

end MKVDPP.BStrong


