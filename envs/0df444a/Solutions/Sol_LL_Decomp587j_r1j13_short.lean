        exact_mod_cast (by omega : B ≤ A + (N - 1) * hh + hh)
    · have hxlt : x < (B : ℝ) / D_den := lt_of_le_of_ne hxhi htop
      set i : ℕ := Nat.floor ((x * D_den - A) / hh)
      have hhh_r : (0 : ℝ) < hh := by exact_mod_cast hhh
      have hnonneg : 0 ≤ (x * D_den - A) / hh := by
        apply div_nonneg _ (le_of_lt hhh_r)
        have := (div_le_iff₀ hDpos).mp hxlo; linarith
      have hi_lt : i < N := by
        apply (Nat.floor_lt hnonneg).mpr
        rw [div_lt_iff₀ hhh_r]
        have h1 : x * D_den < B := (lt_div_iff₀ hDpos).mp hxlt
        have h2 : (N : ℝ) * hh = (B : ℝ) - A := by
          rw [← Nat.cast_sub hAB]; exact_mod_cast hNh
        linarith
      refine ⟨i, hi_lt, ?_, ?_⟩
      · have hfl := Nat.floor_le hnonneg
