/-- The sieve window condition holds for large `n`. -/
theorem winOK_eventually_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → WinOK6 P n := by
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  obtain ⟨n₂, hE⟩ := ell_big P hP 300
  refine ⟨max n₀ n₂, fun n hn j hj => ?_⟩
  have G := hG n (le_trans (le_max_left _ _) hn)
  have E := hE n (le_trans (le_max_right _ _) hn)
  set b := bP6 n with hb
  set d := dP6 P n with hd
  set ℓ := ℓP6 P n with hℓ
  set m := Nat.log 2 b with hm
  have hb1 : 1 ≤ b := bP6_pos n
  have hbm : b < 2 ^ (m + 1) := Nat.lt_pow_succ_log_self (by norm_num) b
  have hdb : d ≤ b := G.d_le_b
  have hℓb : ℓ ≤ 2 * b := by
    have a1 : d * ℓ ≤ LP6 P n + d - 1 := G.dℓ_le
    have a2 : 1 ≤ d := G.d_pos
    have a3 : LP6 P n ≤ b := G.L_le
    have a4 : ℓ ≤ d * ℓ := Nat.le_mul_of_pos_left _ (by omega)
    omega
  -- the bound
  have hS := J6Sieve.sieveBound_lt d (2 ^ ℓ)
  rw [Nat.log_pow (by norm_num)] at hS
  set E := 4 * (Nat.log 2 (4 * (d * (ℓ + 1) + 1)) + 2) ^ 2 with hEd
  have hin : 4 * (d * (ℓ + 1) + 1) < 2 ^ (2 * m + 6) := by
    have a1 : d * (ℓ + 1) + 1 ≤ 4 * b ^ 2 := by
      have a0 : d * (ℓ + 1) ≤ b * (2 * b + 1) := Nat.mul_le_mul hdb (by omega)
      nlinarith
    have a2 : b ^ 2 < (2 ^ (m + 1)) ^ 2 := Nat.pow_lt_pow_left hbm (by norm_num)
    have a3 : (2 ^ (m + 1)) ^ 2 * 16 = 2 ^ (2 * m + 6) := by
      rw [← pow_mul, show 2 * m + 6 = (m + 1) * 2 + 4 by ring, pow_add]; norm_num
    omega
  have hlog : Nat.log 2 (4 * (d * (ℓ + 1) + 1)) ≤ 2 * m + 5 := by
    have := Nat.log_lt_of_lt_pow (by omega) hin; omega
  have hE7 : E ≤ 4 * (2 * m + 7) ^ 2 := by
    rw [hEd]; apply Nat.mul_le_mul_left; apply Nat.pow_le_pow_left; omega
  have hd8 : 8 * d ^ 2 < 2 ^ (2 * m + 5) := by
    have a2 : d ^ 2 < (2 ^ (m + 1)) ^ 2 := Nat.pow_lt_pow_left (by omega) (by norm_num)
    have a3 : (2 ^ (m + 1)) ^ 2 * 8 = 2 ^ (2 * m + 5) := by
      rw [← pow_mul, show 2 * m + 5 = (m + 1) * 2 + 3 by ring, pow_add]; norm_num
    omega
  have hexp : 4 * (2 * m + 7) ^ 2 + (2 * m + 5) ≤ hN6 P n := by
    have a1 : 4 * (2 * m + 7) ^ 2 + (2 * m + 5) + 1 ≤ 300 * (m + 1) ^ 2 := by nlinarith
    have a2 : hN6 P n = ℓ - 1 := rfl
    omega
  have hpow : 2 ^ E * (8 * d ^ 2) ≤ 2 ^ hN6 P n := by
    calc 2 ^ E * (8 * d ^ 2) ≤ 2 ^ (4 * (2 * m + 7) ^ 2) * 2 ^ (2 * m + 5) :=
          Nat.mul_le_mul (Nat.pow_le_pow_right (by norm_num) hE7) hd8.le
      _ = 2 ^ (4 * (2 * m + 7) ^ 2 + (2 * m + 5)) := (pow_add _ _ _).symm
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hexp
  have ht : 2 ^ hN6 P n ≤ tF6 P n j := by
    unfold tF6; split_ifs
    · exact Nat.le_mul_of_pos_right _ (by norm_num)
    · exact le_rfl
  have hw : 2 ^ E ≤ wnd6 P n j := by
    have h8 : 0 < 8 * d ^ 2 := Nat.mul_pos (by norm_num) (pow_pos G.d_pos 2)
    exact (Nat.le_div_iff_mul_le h8).2 (hpow.trans ht)
  exact lt_of_lt_of_le hS hw

