/-!
# B-line IL, the `J` kernel (B4), part 1: list model and arithmetic

The `J` kernel `jKer` (J6SegSw3) of a padded `G`-row `v` is

  `jKer v = W ++ 0^{G-m}`, `W_r = dotF (cc_r) ((zext K z).drop r)`,
  `z = bwdK bs (fwdK fs (v.take m) []) [] []`

for the coefficient streams `fs = fsOf …`, `bs = bsOf …`, `cc_r = ccL … r`. This file gives

* the generic kernel `jKerG P K G m fs bs cc v` (any streams) and the step forms of `fwdK`
  (`fA_succ`), `bwdK` (`bwdS_succ`) and `dotF` on prefixes (`dotF_take_succ`);
* the arithmetic of the IL: `ediv_of_tdiv` (floor division from `tdiv`/`tmod`), `rs_eq`
  (`rs P x = ⌊(2x + 2^P) / 2^{P+1}⌋`) and **`fdiv_recip`**: with `|2 a 2^P + pv| < 2^k` and
  `pv > 0`, `fdiv P a pv` is `q₀ + δ` where `q₀ = ⌊N iv / 2^k⌋` (`iv = ivOf k pv = ⌊2^k / 2pv⌋`)
  and the correction `δ ∈ {-1,0,1}` is read off the signs of `N - q₀ D` and `N - q₀ D - D`
  (`N = 2 a 2^P + pv`, `D = 2 pv`): two multiplications instead of a long division.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.JK

open Finset

/-! ## Arithmetic -/

theorem ediv_of_tdiv (a r : ℤ) (hr : 0 < r) :
    a.tdiv r + (if a.tmod r < 0 then -1 else 0) = a / r := by
  have h1 := Int.tmod_add_tdiv_mul a r
  have h2 := Int.tmod_lt_of_pos a hr
  have h3 := Int.lt_tmod_of_pos a hr
  split_ifs with h
  · have := ((Int.ediv_emod_unique (a := a) (q := a.tdiv r - 1) (r := a.tmod r + r) hr).2
      ⟨by linarith, by linarith, by linarith⟩).1
    rw [this]; ring
  · have := ((Int.ediv_emod_unique (a := a) (q := a.tdiv r) (r := a.tmod r) hr).2
      ⟨by linarith, by linarith, by linarith⟩).1
    rw [this]; ring

theorem rs_eq (P : ℕ) (x : ℤ) : J6Seg.rs P x = (2 * x + 2 ^ P) / 2 ^ (P + 1) := by
  simp only [J6Seg.rs, J6Seg.rq, pow_succ]; ring_nf

/-! ## `dotF` on prefixes -/

theorem dotF_take_succ (P : ℕ) (cs acc : List ℤ) {i : ℕ} (hi : i < cs.length) :
    dotF P (cs.take (i + 1)) acc = dotF P (cs.take i) acc + fmul P cs[i] (acc.getD i 0) := by
  have hl1 : (cs.take (i + 1)).length = i + 1 := by simp; omega
  have hl0 : (cs.take i).length = i := by simp; omega
  simp only [dotF, hl1, hl0, sum_range_succ]
  congr 1
  · apply sum_congr rfl
    intro j hj
    rw [mem_range] at hj
    have hj' : j < i + 1 := by omega
    simp [List.getD_eq_getElem?_getD, List.getElem?_take, hj, hj']
  · simp [List.getD_eq_getElem?_getD, List.getElem?_take, hi]

