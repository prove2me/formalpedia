  let g₁ : Matrix.GeneralLinearGroup (Fin 2) K₀ := diagFst K₀ (Units.mk0 (algebraMap 𝒪 K₀ π) hπK)
  have hg₁ : (g₁ : Matrix (Fin 2) (Fin 2) K₀) = Matrix.diagonal ![algebraMap 𝒪 K₀ π, 1] := by
