theorem NLogN.KFUU.p3B_runs {pM : Fin P} (hM : MulOK I iprog pM NLogN.KFUU.MS) (u cz : ℕ) (bs : List Bool) {i j : ℕ}
    (hij : i + j + 1 = bs.length) (hcz : 1 ≤ cz) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0) (Z : ℕ)
    (hVZ : zsz ((vol (shP u bs) * cz : ℕ) : ℤ) ≤ Z) (hZ2 : 2 ≤ Z) (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
      (lay3 (bgB bs) bs.length i) xs0 0) ++ R)
    {LV LtS LX LM LZ LU : List Item}
    (hV : t.G pV = .int (vol ((shP u bs).take j) : ℤ) :: LV)
    (hS : t.G tS = .int ((shP u bs)[j]'(by rw [len_shP]; omega) : ℤ) :: LtS)
    (hX : t.G pXr = .int (vol ((shP u bs).drop (j + 1)) : ℤ) :: LX)
    (hMr : t.G NLogN.KFUU.rM = .int (((2 ^ u) ^ (j + 1) : ℕ) : ℤ) :: LM)
    (hZ : t.G rCZ = .int (cz : ℤ) :: LZ) (hU : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: LU) :
    IRuns I iprog (p3B pM) t
      ((((t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (lay3 (bgB bs) bs.length (i + 1)) xs0 0) ++ R)).upd pV LV).upd pXr
        (.int (vol ((shP u bs).drop j) : ℤ) :: LX)).upd NLogN.KFUU.rM (.int (((2 ^ u) ^ j : ℕ) : ℤ) :: LM))
      (KFU.cMv (vol (shP u bs) * cz) w + 60 * cU Z) := by sorry
