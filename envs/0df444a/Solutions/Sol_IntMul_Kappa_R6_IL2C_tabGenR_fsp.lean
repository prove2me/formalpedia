theorem tabL_succ (as : ℕ → ℕ) (P k : ℕ) (hk : k < P) :
    tabL as P (k + 1) = (as (P - k - 1) : ℤ) :: tabL as P k := by
  simp only [tabL, List.range_succ_eq_map, List.map_cons, List.map_map]
  refine congrArg₂ _ (by first | rfl | (congr 2; omega) | congr 2) (List.map_congr_left fun i hi => ?_)
  simp only [Function.comp_apply]; congr 2; omega

theorem tabL_full (as : ℕ → ℕ) (P : ℕ) : tabL as P P = (List.range P).map fun p => (as p : ℤ) := by
  simp [tabL]
