-- url     : https://prove2.me/theorems/9e58dca9-5e62-44d2-9dd4-df8a8ccd180b
-- title:
--   Canonical radial frame and transverse block of a Hamiltonian orbit
-- statement:
--   Identify the coordinates $(q_0,q_1,p_0,p_1)$ with $(q_0,-p_0,q_1,-p_1)$ to match the positive symplectic convention used by the graph-angle library. For a Hamiltonian $G$, a curve $x(t)$, and a variational path $Y(t)$, let $F(t)$ be the radial contact frame with columns $x$, $X_G/r$, and the two projected quaternionic position vectors, where $r=dG(x)x$. Define its transverse path by
--
--   $$\varphi(\tau)=\left[F(\tau T)^{-1}Y(\tau T)F(0)\right]_{\{2,3\}\times\{2,3\}}.$$
--
--   The formula uses the transformed matrix of $Y$. The last two rows discard the radial and Hamiltonian directions, so the same block is obtained after removing the Hamiltonian shear.
--
--   The predicate $\mathrm{IsPositiveMovingFrame}(F,\varphi,T)$ records that $F$ is symplectic and periodic with $\operatorname{Re}(i\,d(F))>0$, that $\varphi$ is continuous and determinant one with initial identity, and that $F(0)^{-1}F(t)\operatorname{diag}(I,\varphi(t/T))$ is generated by a continuous symmetric positive definite matrix. These are hypotheses to be established, not assertions built into the definitions.
-- source:
--   Coordinate-explicit local adaptation of HryniewiczCriterion.homogFrame and the lower block in homogeneous_frame_flow_split, https://prove2.me/theorems/6eddbaa1-2e75-45c3-8798-b233d355f366, following HWZ Ann.Math.148(1998), equations(3.35)-(3.39), https://doi.org/10.2307/120994. Quaternionic gradient conventions: Joung-van Koert Section2.3, https://arxiv.org/html/2407.19159v3. The local transverse-block interface is a derived definition.

import Definitions.Def_BirkhoffGlobalSection_DynamicalConvexity
import Definitions.Def_BirkhoffGlobalSection_MovingFrameAlgebra

namespace BirkhoffGlobalSection
noncomputable section

/-- Symplectic coordinate identification from (q0,q1,p0,p1) to
(q0,-p0,q1,-p1), matching the HryniewiczCriterion convention. -/
def toHryn (v : Phase) : HryniewiczCriterion.R4 := ![v 0, -v 2, v 1, -v 3]

def fromHryn (v : HryniewiczCriterion.R4) : Phase := ![v 0, v 2, -v 1, -v 3]

/-- The radial contact frame: x, X/r, and the projected quaternionic
position frame, in the HryniewiczCriterion coordinates. -/
def canonicalRadialFrame (G : Phase → ℝ) (x : ℝ → Phase) (t : ℝ) :
    Matrix (Fin 4) (Fin 4) ℝ :=
  HryniewiczCriterion.homogFrame (fun y => G (fromHryn y)) (toHryn (x t))

/-- Matrix of the original variational flow in the fixed symplectic
coordinate convention. -/
def hrynFlowMatrix (Y : ℝ → (Phase →L[ℝ] Phase)) (t : ℝ) :
    Matrix (Fin 4) (Fin 4) ℝ :=
  fun i j => toHryn (Y t (fromHryn (Pi.single j 1))) i

/-- Transverse block of the original variational flow in the radial contact
frames, with time rescaled to [0,1]. The discarded rows are radial and flow
directions; removing the Hamiltonian shear does not change this block. -/
def canonicalTransversePath (G : Phase → ℝ) (x : ℝ → Phase) (T : ℝ)
    (Y : ℝ → (Phase →L[ℝ] Phase)) (τ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  fun i j => ((canonicalRadialFrame G x (τ * T))⁻¹ * hrynFlowMatrix Y (τ * T) *
    canonicalRadialFrame G x 0) i.succ.succ j.succ.succ

/-- The analytic hypotheses of the positive-path estimate, expressed in a
periodic moving symplectic frame. -/
structure IsPositiveMovingFrame
    (F : ℝ → Matrix (Fin 4) (Fin 4) ℝ)
    (φ : ℝ → Matrix (Fin 2) (Fin 2) ℝ) (T : ℝ) : Prop where
  symplectic : ∀ t, (F t).transpose * HryniewiczCriterion.omegaMat * F t =
    HryniewiczCriterion.omegaMat
  halfPlane : ∀ t, 0 < (Complex.I * HryniewiczCriterion.cdet (F t)).re
  continuous : ∀ i j, Continuous fun t => F t i j
  endpoint : F T = F 0
  transverse_continuous : ∀ i j, ContinuousOn (fun t => φ t i j) (Set.Icc 0 1)
  transverse_det : ∀ t ∈ Set.Icc (0 : ℝ) 1, (φ t).det = 1
  transverse_zero : φ 0 = 1
  positive_generator : ∃ S : ℝ → Matrix (Fin 4) (Fin 4) ℝ,
    (∀ i j : Fin 4, Continuous fun t => S t i j) ∧
    (∀ t, (S t).PosDef) ∧
    (∀ t : ℝ, ∀ i j : Fin 4,
      HasDerivAt (fun s => ((F 0)⁻¹ * F s * HryniewiczCriterion.blockOne (φ (s / T))) i j)
        ((HryniewiczCriterion.symplJ4 * S t *
          ((F 0)⁻¹ * F t * HryniewiczCriterion.blockOne (φ (t / T)))) i j) t)

end
end BirkhoffGlobalSection


