-- url     : https://prove2.me/theorems/17535949-9d6a-4a40-aeea-91c7ee6811d2
-- title:
--   The polynomial encoding $\langle g_D(x), h_R(s)\rangle$ of a CSP instance
-- statement:
--   Let $D\subseteq\mathbb Q$ be finite. For a formal variable $z$ and $a\in D$ put
--   $$
--   \ell_a(z)=\prod_{b\in D\setminus\{a\}}\frac{z-b}{a-b},\qquad g_D(z)=\prod_{a\in D}(z-a).
--   $$
--   For a constraint $R(s)$ with scope $s=(x_{i_1},\dots,x_{i_r})$ the **constraint polynomial** is
--   $$
--   h_R(s)=\sum_{a\in D^r\setminus R}\ \prod_{j=1}^r \ell_{a_j}(x_{i_j}),
--   $$
--   and the ideal generated by the polynomial encoding of $P$ is
--   $$
--   \bigl\langle g_D(x)\ (x\in X),\ h_R(s)\ (\langle s,R\rangle\in C)\bigr\rangle .
--   $$
--
--   This is the ideal of the finite-domain Nullstellensatz (Lemma 2.1).
--
--   **Formalization Note** $\ell_a$ is written with the scalars $1/(a-b)$ and is applied to the variables of the scope.
-- source:
--   Rafiey–Soleymani–Jaillet, A Dichotomy Theorem for CSP-Based Ideal Membership, STOC 2027 submission manuscript (held version, sha256 c7140009133170c893c7b31cf2279f3dda0264d867825a8beb7cc6963f50f109), §2.1, p.11 (PDF 11)

import Mathlib
import Definitions.Def_CSPIdealMem_ConstraintLanguage

namespace CSPIdealMem

/-! # The polynomial encoding of a CSP instance and the ideal it generates

Rafiey–Soleymani–Jaillet, *A Dichotomy Theorem for CSP-Based Ideal Membership*, STOC 2027
submission manuscript (held version, sha256 c7140009…f50f109), §2.1, p.11 (PDF 11).

**Formalization Note.** The domain is `D : Finset ℚ` with values in `↥D`. The interpolation
polynomial `ℓ_a(z) = ∏_{b ∈ D∖{a}} (z − b)/(a − b)` is written with the scalar `1/(a − b)`; it is
applied to the variables of a scope. -/

open Classical

variable {D : Finset ℚ}

/-- The domain polynomial `g_D(x) := ∏_{a ∈ D} (x − a)` of the variable `x` (p.11). -/
noncomputable def gD (D : Finset ℚ) {n : ℕ} (x : Fin n) : MvPolynomial (Fin n) ℚ :=
  ∏ a ∈ D, (MvPolynomial.X x - MvPolynomial.C a)

/-- The interpolation polynomial `ℓ_a(z) := ∏_{b ∈ D∖{a}} (z − b)/(a − b)` evaluated at the
polynomial `z` (p.11). -/
noncomputable def ell {n : ℕ} (a : D) (z : MvPolynomial (Fin n) ℚ) : MvPolynomial (Fin n) ℚ :=
  ∏ b ∈ D.erase a, MvPolynomial.C (1 / ((a : ℚ) - b)) * (z - MvPolynomial.C b)

/-- The constraint polynomial `h_R(s) := ∑_{a ∈ D^r ∖ R} ∏_{j=1}^r ℓ_{a_j}(x_{i_j})` of a constraint
`⟨s, R⟩` with scope `s = (x_{i_1}, …, x_{i_r})` (p.11). -/
noncomputable def hR {Γ : ConstraintLanguage D} {n : ℕ}
    (c : Σ i : Γ.ι, Fin (Γ.arity i) → Fin n) : MvPolynomial (Fin n) ℚ :=
  ∑ a ∈ (Finset.univ.filter fun a : Fin (Γ.arity c.1) → D => a ∉ Γ.rel c.1),
    ∏ j, ell (a j) (MvPolynomial.X (c.2 j))

/-- The ideal `⟨g_D(x) (x ∈ X), h_R(s) (⟨s, R⟩ ∈ C)⟩` generated by the domain polynomials of all
variables and the constraint polynomials of all constraints of `P` (p.11). -/
noncomputable def genIdeal {Γ : ConstraintLanguage D} (P : Instance Γ) :
    Ideal (MvPolynomial (Fin P.n) ℚ) :=
  Ideal.span (Set.range (gD D) ∪ {h | ∃ c ∈ P.cons, h = hR c})

end CSPIdealMem


