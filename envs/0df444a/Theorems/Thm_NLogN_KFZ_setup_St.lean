theorem NLogN.KFZ.setup_St (s : IState HS) (f : Fin HS → List ℤ) (hf : EmptyEx f) (K p α h d : ℕ)
    (bs ss : List ℕ) (hbl : bs.length = d) (hsl : ss.length = d) (hb1 : ∀ b ∈ bs, b ≤ 1)
    (hst : ∀ (i : ℕ) (hi : i < d), ss[i]'(by omega) ≤ 2 ^ (h + bs[i]'(by omega)))
    (hc : f NLogN.KFZ.cS = (K : ℤ) :: (p : ℤ) :: (α : ℤ) :: (h : ℤ) :: (d : ℤ) :: (NLogN.KFZ.zl bs ++ NLogN.KFZ.zl ss))
    (B : ℕ) (hB : NLogN.KFZ.eS h bs d + h + 6 ≤ B) (hdB : d + 2 ≤ B) (hK : zsz (K : ℤ) ≤ B)
    (hp : zsz (p : ℤ) ≤ B) (hα : zsz (α : ℤ) ≤ B) (td : List ℤ)
    (hdesc : descA 1 (axD h bs ss) ++ [(2 * 2 ^ NLogN.KFZ.eS h bs d : ℤ)] = td) :
