/-- `f (2^c) = true` for every bit `c` of `S`. -/
def bitsGo (f : Nat → Bool) (fuel : Nat) : Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Bool) (fun _ => false)
    (fun _ ih S => Nat.rec true (fun p _ =>
      Bool.rec false (ih (Nat.land (Nat.succ p) p))
        (f (Nat.sub (Nat.succ p) (Nat.land (Nat.succ p) p)))) S) fuel

/-- Hitting-set search. `T` holds the cell masks of the nogoods (25-bit fields). In the state `Y`, bit `25 i`
is set iff nogood `i` is not hit by the empty cells chosen so far; `d` more empty cells may be chosen. -/
def zphGo (T d : Nat) : Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Bool)
    (fun Y => Nat.ble 1 Y)
    (fun _ ih Y => Bool.rec false
      (bitsGo (fun q => ih (Nat.xor Y (Nat.land Y (Nat.div T q)))) 26
        (Nat.land (Nat.div T (Nat.sub Y (Nat.land Y (Nat.sub Y 1)))) 33554431))
      (Nat.ble 1 Y))
    d

/-- Reads the entries of `lst` (13-bit indices of fields of `GT`, lowest first); for each accepted pattern
word `(a, b)` prepends the cells of `a` outside `msk` to `T`, with a mark in `Y`. -/
def bldGo (GT : Nat) (chk : Nat → Nat → Bool) (msk : Nat) (κ : Nat → Nat → Bool) (fuel : Nat) :
    Nat → Nat → Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Bool) (fun _ T Y => κ T Y)
    (fun _ ih lst T Y => nz lst (κ T Y) (fun lst =>
      nz (Nat.land (Nat.shiftRight GT (Nat.mul 50 (Nat.land lst 8191))) 1125899906842623) false (fun w =>
        Bool.rec false
          (ih (Nat.shiftRight lst 13)
            (Nat.add (Nat.mul T 33554432) (Nat.xor (Nat.land w 33554431)
              (Nat.land (Nat.land w 33554431) msk)))
            (Nat.add (Nat.mul Y 33554432) 1))
          (chk (Nat.land w 33554431) (Nat.shiftRight w 25)))))
    fuel

/-- Test of the fundamental domain: each 20-bit field of `E` is at least `1024 k`. -/
def domT (E k : Nat) : Bool :=
  force (Nat.sub (Nat.add 0x800008000080000 E) (Nat.mul 0x4000040000400 k)) (fun R =>
    Bool.rec false (Bool.rec false (Nat.ble 0x800000000000000 R)
      (Nat.ble 0x8000000000 (Nat.mod R 0x10000000000))) (Nat.ble 0x80000 (Nat.mod R 0x100000)))

/-- Leaf of the search over double sets: `B` has `k` cells and weights `E`. -/
def leafZ (GT B k E _PY : Nat) (L : List Nat) (κ : List Nat → Bool) : Bool :=
  nz k (κ L)
    (fun k => Bool.rec (κ L)
      (List.rec (motive := fun _ => Bool) false (fun item L' _ =>
        bldGo GT (fun _ b => Nat.beq (Nat.land b B) b) B
          (fun T Y => Bool.rec false (κ L') (zphGo T k Y)) 1000 item 0 0) L)
      (domT E k))

/-- Search over double sets, cells in increasing order; level `n + off` decides the cell `24 - (n + off)`.
`PT`, `PY`: table and state (as in `zphGo`) of the nogoods made of doubles only, hit by the cells decided not
to be double. -/
def dfsGo (leaf : Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool) (PT off n : Nat) :
    Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool)
    (fun B k E PY L κ => leaf B k E PY L κ)
    (fun n ih B k E PY L κ =>
      Bool.rec
        (ih (Nat.add B (Nat.shiftRight 16777216 (Nat.add n off))) (Nat.succ k)
          (Nat.add E (Nat.land (Nat.shiftRight WTR (Nat.mul 60 (Nat.add n off))) 0xfffffffffffffff))
          PY L (fun L' => ih B k E
            (Nat.xor PY (Nat.land PY (Nat.div PT (Nat.shiftRight 16777216 (Nat.add n off))))) L' κ))
        (ih B k E (Nat.xor PY (Nat.land PY (Nat.div PT (Nat.shiftRight 16777216 (Nat.add n off))))) L κ)
        (Bool.rec
          (Nat.ble (Nat.succ (Nat.sub
              (Nat.land (Nat.div PT (Nat.sub PY (Nat.land PY (Nat.sub PY 1)))) 33554431) 1))
            (Nat.land (Nat.land (Nat.div PT (Nat.sub PY (Nat.land PY (Nat.sub PY 1)))) 33554431)
              (Nat.add B (Nat.shiftRight 16777216 (Nat.add n off)))))
          true (Nat.ble 12 k)))
    n

/-- The part of the search with `lo ≤ B % 64 < hi`; `pidx` lists the nogoods made of doubles only. -/
def runChunk (GT pidx lo hi : Nat) (L : List Nat) : Bool :=
  force GT (fun gt => bldGo gt (fun a b => Nat.beq a b) 0
    (fun pt py => dfsGo (fun B k E PY L κ => Bool.rec (κ L)
          (Bool.rec (κ L) (dfsGo (leafZ gt) pt 0 19 B k E PY L κ) (Nat.ble (Nat.succ B) hi))
          (Nat.ble lo B))
        pt 19 6 0 0 0 py L (fun L => List.rec (motive := fun _ => Bool) true (fun _ _ _ => false) L))
    1000 pidx 0 0)

