-- title:
--   §3.2, pp. 6–7 — generalized network flow, cycles and good augmented forests
-- statement:
--   A generalized network has a finite vertex set and a finite set of identifiable directed arcs. Each arc has a tail, a head, a multiplier and an optional upper capacity; each vertex has a supply. A flow satisfies node balance and the lower and upper bounds:
--
--   $$\sum_{a:\,\operatorname{tail}(a)=v}f_a-\sum_{a:\,\operatorname{head}(a)=v}\mu_a f_a=b_v,\qquad 0\le f_a\le u_a$$
--   when $u_a$ is present. A basis partitions the arcs into basic, lower-bound and upper-bound sets and has one linearly independent basic column per vertex.
--
--   An oriented undirected cycle records its forward and backward arcs. Its multiplier is the ratio of the two corresponding products; it is balanced when the two arc counts agree. A good augmented forest spans the vertices, has one cycle per connected component, and none of those cycles has multiplier one. These definitions support both the general GNF basis theorem and the split-graph model.
--
--   **Formalization Note** Arc identities allow loops and parallel or antiparallel arcs. Optional upper capacity `none` means unbounded. Positive multipliers are required in the GNF theorem.
-- source:
--   Kalinowski, Mohammadian, Feasible Bases for a Polytope Related to the Hamilton Cycle Problem, arXiv:1907.12691v1, pp. 6–8, §3.2, Definitions 4–6

import Mathlib

namespace FeasibleBasesHC.Structure

/-- A generalized network with distinguishable arcs, allowing antiparallel arcs and loops. -/
structure GNF (V A : Type*) where
  arcs : Finset A
  tail : A → V
  head : A → V
  mu : A → ℝ
  supply : V → ℝ
  cap : A → Option ℝ

variable {V A : Type*} [Fintype V] [Fintype A] [DecidableEq V] [DecidableEq A]

/-- The generalized flow equations and lower and optional upper arc capacities. -/
def GNF.IsFlow (N : GNF V A) (f : A → ℝ) : Prop :=
  (∀ a ∉ N.arcs, f a = 0) ∧
  (∀ v, (∑ a ∈ N.arcs.filter (fun a => N.tail a = v), f a) -
    ∑ a ∈ N.arcs.filter (fun a => N.head a = v), N.mu a * f a = N.supply v) ∧
  (∀ a ∈ N.arcs, 0 ≤ f a ∧ ∀ u, N.cap a = some u → f a ≤ u)

/-- Column of the generalized network-flow equality matrix. -/
def GNF.column (N : GNF V A) (a : A) : V → ℝ :=
  fun v => (if N.tail a = v then 1 else 0) - (if N.head a = v then N.mu a else 0)

/-- A partition into basic, lower-bound, and upper-bound arcs, with a square independent basic matrix. -/
def GNF.IsBasis (N : GNF V A) (B L U : Finset A) : Prop :=
  B ∪ L ∪ U = N.arcs ∧
  Disjoint B L ∧ Disjoint B U ∧ Disjoint L U ∧
  (∀ a ∈ U, ∃ u, N.cap a = some u) ∧
  B.card = Fintype.card V ∧
  LinearIndependent ℝ (fun a : B => N.column a.1)

/-- Undirected adjacency generated by the selected arcs, retaining arc identities for cycle counting. -/
def GNF.Adj (N : GNF V A) (B : Finset A) (v w : V) : Prop :=
  ∃ a ∈ B, (N.tail a = v ∧ N.head a = w) ∨ (N.tail a = w ∧ N.head a = v)

/-- The vertex set of the connected component of `v` in the selected arc set. -/
noncomputable def GNF.comp (N : GNF V A) (B : Finset A) (v : V) : Finset V := by
  classical
  exact Finset.univ.filter (fun w => Relation.ReflTransGen (N.Adj B) v w)

/-- An oriented undirected cycle, with distinct vertex and arc occurrences. In particular,
    a pair of antiparallel arcs can form a two-edge cycle. -/
structure GNF.Cycle (N : GNF V A) where
  length : ℕ
  length_pos : 0 < length
  vertex : Fin length → V
  edge : Fin length → A
  forward : Fin length → Bool
  vertex_inj : Function.Injective vertex
  edge_inj : Function.Injective edge
  edge_mem : ∀ i, edge i ∈ N.arcs
  endpoints : ∀ i, let j : Fin length := ⟨(i.val + 1) % length, Nat.mod_lt _ length_pos⟩
    if forward i then N.tail (edge i) = vertex i ∧ N.head (edge i) = vertex j
    else N.head (edge i) = vertex i ∧ N.tail (edge i) = vertex j

/-- Product of multipliers on forward arcs divided by that on backward arcs. -/
noncomputable def GNF.Cycle.multiplier (N : GNF V A) (C : N.Cycle) : ℝ :=
  (∏ i : Fin C.length, if C.forward i then N.mu (C.edge i) else 1) /
  (∏ i : Fin C.length, if C.forward i then 1 else N.mu (C.edge i))

/-- The oriented cycle has the same number of forward and backward arcs. -/
def GNF.Cycle.Balanced (N : GNF V A) (C : N.Cycle) : Prop :=
  (Finset.univ.filter (fun i : Fin C.length => C.forward i)).card =
  (Finset.univ.filter (fun i : Fin C.length => !C.forward i)).card

/-- Every connected component has one more arc than a tree, and no cycle has multiplier one.
    For a finite multigraph the cardinality equation says that each component has exactly one cycle. -/
def GNF.IsGoodAugForest (N : GNF V A) (B : Finset A) : Prop :=
  B ⊆ N.arcs ∧
  (∀ v, (B.filter (fun a => N.tail a ∈ N.comp B v)).card = (N.comp B v).card) ∧
  (∀ C : N.Cycle, (∀ i, C.edge i ∈ B) → C.multiplier ≠ 1)

/-- A good augmented tree spans the whole vertex type. -/
def GNF.IsGoodAugTree (N : GNF V A) (B : Finset A) : Prop :=
  N.IsGoodAugForest B ∧ ∀ v w : V, Relation.ReflTransGen (N.Adj B) v w

end FeasibleBasesHC.Structure


