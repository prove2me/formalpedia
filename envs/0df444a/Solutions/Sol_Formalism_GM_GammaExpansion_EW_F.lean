theorem _root_.solution (hw : Function.Injective w) (hwe : ∀ c d, w c ≠ e d) (α : k) (g : MvPolynomial σ k)
    (h : EW w g = α • g) : EW w (tieF w e g) = (α - 1) • tieF w e g := by
