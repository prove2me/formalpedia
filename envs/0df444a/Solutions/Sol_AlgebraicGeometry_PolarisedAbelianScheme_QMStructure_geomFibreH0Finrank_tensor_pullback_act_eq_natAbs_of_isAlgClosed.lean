theorem c_ne_zero
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (b0 c : ↥Λ) (hc : (c : ℍ[ℚ, a, b]) = (6 : ℚ) • (1 + (star b0 : ℍ[ℚ, a, b]) * (b0 : ℍ[ℚ, a, b]))) :
    (c : ℍ[ℚ, a, b]) ≠ 0 := by
  intro h0
  rw [h0] at hc
  have h1 : (1 : ℍ[ℚ, a, b]) + (star b0 : ℍ[ℚ, a, b]) * (b0 : ℍ[ℚ, a, b]) = 0 := by
    rcases smul_eq_zero.mp hc.symm with h | h
    · norm_num at h
    · exact h
  have hN : (0 : ℚ) < ((q * q' : ℕ) : ℚ) := by
    have hq : 0 < q := (Fact.out : q.Prime).pos
    have hq' : 0 < q' := (Fact.out : q'.Prime).pos
    exact_mod_cast Nat.mul_pos hq hq'
  exact NrdNeZero.core a b hB.1 _ hN (μ : ℍ[ℚ, a, b]) (b0 : ℍ[ℚ, a, b]) (star b0 : ℍ[ℚ, a, b]) hμ (hstar b0) h1

theorem locIsoOnBase_tensorPow_three
    {K : Type} [CommRing K] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of K)) (pol polE : A.Modules)
    (h : LocIsoOnBase f pol (polE ⊗ polE ⊗ polE)) :
    LocIsoOnBase f pol (Scheme.Modules.tensorPow polE 3) := by

  let e : polE ⊗ polE ⊗ polE ≅ Scheme.Modules.tensorPow polE 3 :=
    (α_ polE polE polE).symm ≪≫ (whiskerRightIso (whiskerRightIso (λ_ polE).symm polE) polE)
  intro s
  obtain ⟨U, hsU, ⟨i⟩⟩ := h s
  exact ⟨U, hsU, ⟨i ≪≫ (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).mapIso e⟩⟩

