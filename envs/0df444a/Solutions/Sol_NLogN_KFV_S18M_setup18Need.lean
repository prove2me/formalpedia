theorem n18_bound (p ℓ K : ℕ) (ts : List ℕ) (hK : 1 ≤ K) (hℓ : 1 ≤ ℓ) :
    n18 ℓ K ts + ℓ + 8 ≤ 2 ^ (ts.length + ℓ + K + 4) := by
  have hnL : nL18 ℓ ts ≤ ts.length := by
    unfold nL18 fl18; exact le_trans List.count_le_length (by simp +decide)
  have hbb : bb ℓ K ≤ K := by unfold Synth.bb; exact (Nat.mod_lt _ (by omega)).le
  have hqq : qq ℓ K ≤ ℓ := by unfold Synth.qq; exact le_trans (Nat.div_le_self _ _) (by omega)
  have hn1 : n18 ℓ K ts ≤ ts.length + K * ts.length + ts.length * ℓ * K := by
    unfold n18 lst18
    have h1 := Nat.mul_le_mul_right ts.length hbb
    have h2 := Nat.mul_le_mul_right K (Nat.mul_le_mul_left ts.length hqq)
    omega
  have hP := lt2 ts.length
  have hQ := lt2 ℓ
  have hR := lt2 K
  have hPp : 0 < 2 ^ ts.length := by positivity
  have hQp : 0 < 2 ^ ℓ := by positivity
  have hRp : 0 < 2 ^ K := by positivity
  have e1 : ts.length * ℓ * K ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K :=
    Nat.mul_le_mul (Nat.mul_le_mul hP.le hQ.le) hR.le
  have e2 : K * ts.length ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K := by
    calc K * ts.length ≤ 2 ^ K * 2 ^ ts.length := Nat.mul_le_mul hR.le hP.le
      _ = 2 ^ ts.length * 2 ^ K := by ring
      _ ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K :=
        Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ hQp)
  have e3 : 2 ^ ts.length ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K :=
    le_trans (Nat.le_mul_of_pos_right _ hQp) (Nat.le_mul_of_pos_right _ hRp)
  have e4 : 2 ^ ℓ ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K :=
    le_trans (Nat.le_mul_of_pos_left _ hPp) (Nat.le_mul_of_pos_right _ hRp)
  have e5 : 2 ^ (ts.length + ℓ + K + 4) = 2 ^ ts.length * 2 ^ ℓ * 2 ^ K * 16 := by
    rw [pow_add, pow_add, pow_add]; norm_num
  have e6 : 1 ≤ 2 ^ ts.length * 2 ^ ℓ * 2 ^ K := Nat.one_le_iff_ne_zero.mpr (by positivity)
  omega

end NLogN.KFV.S18M

