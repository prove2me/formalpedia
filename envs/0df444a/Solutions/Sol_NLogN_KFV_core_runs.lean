  induction zs with
  | nil => rfl
  | cons z zs ih => simp [gflat, scG] at ih ⊢; exact ih

set_option maxHeartbeats 4000000 in
/-- **The scaling pass.** -/
theorem scaleS_runs {n ℓ w B : ℕ} (sB : IState HS) (hn : RT sB gNn n) (hl : RT sB gLl ℓ)
    (hB : w + n + ℓ + 4 ≤ B) {L : List ℤ} (l : List ℤ) (hL : L.length = 2 * (2 ^ n * 2 ^ ℓ))
    (hLw : Bnd w L) :
    IRuns I iprog scaleS (encK sB (o0 (L ++ l))) (encK sB (o0 (L.map (· * 2 ^ n) ++ l)))
      (cScale (2 * (2 ^ n * 2 ^ ℓ)) B) := by
  set M := 2 * (2 ^ n * 2 ^ ℓ) with hM
  set v := L ++ l with hv
  have zB : ∀ x : ℕ, x ≤ B → zsz (x : ℤ) ≤ B := fun x h => zsz_nat_le h
  have hnB : 2 ^ n < 2 ^ B := Nat.pow_lt_pow_right (by norm_num) (by omega)
  have hMB : M < 2 ^ B := by
    have : M = 2 ^ (n + ℓ + 1) := by rw [hM]; ring
    rw [this]; exact Nat.pow_lt_pow_right (by norm_num) (by omega)
  -- pushes
  have E1 := (rt_ev (f := o0 v) hn (o0_ne _ (by decide)) (zB n (by omega))).pow2 (B := B) (by omega)
  have P1 := NLogN.KFV.pushV (i := vRH) sB (o0 v) (by decide) (clean3 (by simp [Ex.regs])) E1
    (o0_ne _ (by decide))
  set f1 := Function.update (o0 v) vRH [((2 ^ n : ℕ) : ℤ)] with hf1
  have E2 : EV (encK sB f1) B eKT ((M : ℕ) : ℤ) := by
    have a := ((rt_ev (f := f1) hn (by simp +decide [hf1, o0]) (zB n (by omega))).add
      (rt_ev (f := f1) hl (by simp +decide [hf1, o0]) (zB ℓ (by omega)))
      (by rw [← Nat.cast_add]; exact zB _ (by omega))).add
      (EV.lit (c := 1) (by exact_mod_cast zB 1 (by omega))) (by exact_mod_cast zB (n + ℓ + 1) (by omega))
    have a' := a.cast (v' := ((n + ℓ + 1 : ℕ) : ℤ)) (by push_cast; ring)
    exact (a'.pow2 (by omega)).cast (by rw [hM]; push_cast; ring)
  have P2 := NLogN.KFV.pushV (i := NLogN.KFV.vT) sB f1 (by decide) (clean3 (by simp [Ex.regs, eKT] <;> tauto)) E2
    (by simp +decide [hf1, o0])
  set f2 := Function.update f1 NLogN.KFV.vT [((M : ℕ) : ℤ)] with hf2
  -- the loop
  set F : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update f2 0 (L.drop k ++ l)) NLogN.KFV.sT ((L.take k).map (· * 2 ^ n)).reverse
    with hF
  have hF0 : F 0 = f2 := by
    funext j; simp only [hF, hf2, hf1, o0, Function.update_apply, List.drop_zero, List.take_zero,
      List.map_nil, List.reverse_nil]
    split_ifs <;> simp_all +decide
