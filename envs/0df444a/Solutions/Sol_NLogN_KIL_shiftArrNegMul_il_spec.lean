  have E5 : Function.update (toF s4) 14 wr = toF (nSt r P Q B as (p + 1) [(P : ℤ) - p]) := by
    rw [upd_w]
    congr 1
    simp only [s4, k0', nSt, o0, List.range_succ, List.flatMap_append, List.flatMap_singleton,
