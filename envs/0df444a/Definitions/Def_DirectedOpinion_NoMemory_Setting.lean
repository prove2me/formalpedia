-- title:
--   pp. 3, 9–11 — delayed marked Galton–Watson tree, Section 5.1 signals, tree operator Δ and root opinion 𝓡*
-- statement:
--   This file fixes the probabilistic model of Sections 2 and 5 of Fraiman, Lin and Olvera-Cravioto on which the no-memory moment formulas are stated.
--
--   **Labels and marks.** Nodes of the limit tree carry Ulam–Harris labels: the root is $\emptyset$, and the children of a node $\mathbf i$ are $(\mathbf i,1),(\mathbf i,2),\dots$. Every node $\mathbf i$ has a mark $\boldsymbol{\mathcal X}_{\mathbf i}$ from which the recursion reads three things: the in-degree $\mathcal N_{\mathbf i}\in\{0,1,2,\dots\}$, the weights $\mathcal C_{(\mathbf i,1)},\mathcal C_{(\mathbf i,2)},\dots$ placed on the children, and the internal opinion $\mathcal Q_{\mathbf i}$.
--
--   **Standing assumptions (delayed marked Galton–Watson tree).** The parameters satisfy $c\in[0,1)$, $d\in(0,1]$ and $c+d\le 1$. Every weight lies in $[0,1]$; when $\mathcal N_{\mathbf i}\ge 1$ the weights of the children sum to $c$:
--   $$\sum_{j=1}^{\mathcal N_{\mathbf i}}\mathcal C_{(\mathbf i,j)}=c .$$
--   Internal opinions and media signals take values in $[-1,1]$. The marks $\{\boldsymbol{\mathcal X}_{\mathbf i}\}$ are independent, and the marks of all non-root nodes are identically distributed (the root's mark may have a different law, which is what "delayed" means). Each node has a sequence of media signals
--   $$\mathcal Z_{\mathbf i}^{(k)}=\zeta\big(\boldsymbol{\mathcal X}_{\mathbf i},U_{\mathbf i}^{(k)}\big),\qquad k\ge 0,$$
--   where the $U_{\mathbf i}^{(k)}$ are i.i.d. uniform on $[0,1]$ and independent of the marks, and $\zeta$ is measurable with values in $[-1,1]$.
--
--   **Signals, operator and opinions.** The external signal of Section 5.1 is
--   $$\mathcal W_{\mathbf i}^{(k)}=d\,\mathcal Z_{\mathbf i}^{(k)}+\mathcal Q_{\mathbf i}\Big(c-\sum_{j=1}^{\mathcal N_{\mathbf i}}\mathcal C_{(\mathbf i,j)}\Big).$$
--   The tree operator (10) acts on functions $f$ of the labels by
--   $$\Delta f(\mathbf i)=\sum_{j=1}^{\mathcal N_{\mathbf i}}\mathcal C_{(\mathbf i,j)}f((\mathbf i,j))+(1-c-d)f(\mathbf i),$$
--   and the root opinion is $\mathcal R^*=\sum_{s\ge0}(\Delta^s\mathcal W^{(s)})(\emptyset)$. The file also defines the coefficients $a_{l,s}=\binom{s}{l}(1-c-d)^{s-l}$, the relative path weight $\Pi_{(\mathbf i,\mathbf j)}/\Pi_{\mathbf i}$ (the product of the weights along the path from $\mathbf i$ to $(\mathbf i,\mathbf j)$, defined without division), the generations of a subtree, the no-memory subtree opinions
--   $$\sum_{s\ge0}\sum_{|\mathbf t|=s}\frac{\Pi_{(\mathbf b,\mathbf t)}}{\Pi_{\mathbf b}}\,\mathcal W_{(\mathbf b,\mathbf t)}^{(t_0+s)}$$
--   (so that $\mathcal R_j$ of (7) is the case $\mathbf b=j$, $t_0=1$), the second moments $\rho_2=E\big[\sum_{i=1}^{\mathcal N_1}\mathcal C_{(1,i)}^2\big]$ and $\rho_2^*=E\big[\sum_{i=1}^{\mathcal N_\emptyset}\mathcal C_i^2\big]$, and the σ-algebra generated by one node's mark.
--
--   These are the objects of Propositions 3–5 and Remark 6, shared by every statement of the mission.
--
--   **Formalization Note.** Labels are lists of natural numbers with **0-based** child indices: the paper's $j$-th child of $\mathbf i$ is `i ++ [j-1]`, and the paper's node $1$ is `[0]`. Marks live in an arbitrary measurable space and are seen through measurable maps `N`, `C`, `Q`. The paper assumes the signals $\{\mathcal Z_{\mathbf i}^{(k)}:k\ge0\}$ conditionally i.i.d. given $\boldsymbol{\mathcal X}_{\mathbf i}$ and conditionally independent across nodes; writing them as $\zeta(\boldsymbol{\mathcal X}_{\mathbf i},U_{\mathbf i}^{(k)})$ with $\zeta(x,\cdot)$ the quantile function of the media law at $x$ produces the same joint law (the paper itself uses this representation, p. 25), and every conclusion is about laws. All labels carry marks and signals, but only children $j<\mathcal N_{\mathbf i}$ are ever followed, so nodes outside the tree play no role. Under the standing assumptions every series here is absolutely summable for every outcome ($|\Delta^s f|\le(1-d)^s\sup|f|$ and $|\mathcal W|\le1$), so Lean's convention that a non-summable `tsum` is 0 never applies. The natural subtraction $s-l$ in $a_{l,s}$ is only used for $l\le s$.
-- source:
--   Fraiman, Lin and Olvera-Cravioto, Opinion dynamics on directed complex networks, arXiv:2209.00969v2, pp. 3, 9–11, §§2, 5, 5.1; operator (10), p. 22

import Mathlib

namespace DirectedOpinion.NoMemory
open MeasureTheory ProbabilityTheory Set

variable {Ω M : Type*}

/-- Ulam–Harris label; `[]` is the root ∅ and `i ++ [j]` is the (j+1)-th child of `i` (0-based). -/
abbrev Label := List ℕ

/-- What the recursion reads off a full mark 𝓧 = (𝓐, 𝓠, 𝓢, 𝓝, 𝓒_(·,1)1(𝓝 ≥ 1), …) (p. 9):
in-degree 𝓝, weights 𝓒_(·, j+1) (0-based), internal opinion 𝓠. -/
structure MarkFns (M : Type*) [MeasurableSpace M] where
  N : M → ℕ
  C : M → ℕ → ℝ
  Q : M → ℝ
  measurable_N : Measurable N
  measurable_C : ∀ j, Measurable fun x => C x j
  measurable_Q : Measurable Q

/-- Section 5 standing assumptions (pp. 3, 9–11): a delayed marked Galton–Watson tree with
quantile-represented media signals 𝓩_i^(k) = ζ(𝓧_i, U_i^(k)). -/
structure GWModel {Ω M : Type*} [MeasurableSpace Ω] [MeasurableSpace M] (P : Measure Ω)
    (mk : MarkFns M) (X : Label → Ω → M) (U : Label → ℕ → Ω → ℝ) (ζ : M → ℝ → ℝ) (c d : ℝ) :
    Prop where
  c_nonneg : 0 ≤ c
  c_lt_one : c < 1
  d_pos : 0 < d
  d_le_one : d ≤ 1
  cd_le_one : c + d ≤ 1
  weights_nonneg : ∀ x j, 0 ≤ mk.C x j
  weights_le_one : ∀ x j, mk.C x j ≤ 1
  weights_sum : ∀ x, 0 < mk.N x → ∑ j ∈ Finset.range (mk.N x), mk.C x j = c
  Q_mem : ∀ x, mk.Q x ∈ Icc (-1 : ℝ) 1
  ζ_mem : ∀ x u, ζ x u ∈ Icc (-1 : ℝ) 1
  measurable_ζ : Measurable (Function.uncurry ζ)
  measurable_X : ∀ i, Measurable (X i)
  measurable_U : ∀ i k, Measurable (U i k)
  indep_marks : iIndepFun X P
  ident_marks : ∀ i, i ≠ [] → IdentDistrib (X i) (X [0]) P P
  indep_unif : iIndepFun (fun p : Label × ℕ => U p.1 p.2) P
  unif : ∀ i k, HasLaw (U i k) (volume.restrict (Icc (0 : ℝ) 1)) P
  indep_marks_unif : IndepFun (fun ω i => X i ω) (fun ω (p : Label × ℕ) => U p.1 p.2 ω) P

/-- Media signal 𝓩_i^(k) = ζ(𝓧_i, U_i^(k)) ∈ [−1, 1]. -/
def Z (X : Label → Ω → M) (U : Label → ℕ → Ω → ℝ) (ζ : M → ℝ → ℝ) (i : Label) (k : ℕ)
    (ω : Ω) : ℝ :=
  ζ (X i ω) (U i k ω)

/-- External signal of Section 5.1: 𝓦_i^(k) = d𝓩_i^(k) + 𝓠_i (c − Σ_{j ≤ 𝓝_i} 𝓒_(i,j)). -/
noncomputable def W [MeasurableSpace M] (mk : MarkFns M) (X : Label → Ω → M)
    (U : Label → ℕ → Ω → ℝ) (ζ : M → ℝ → ℝ) (c d : ℝ) (i : Label) (k : ℕ) (ω : Ω) : ℝ :=
  d * Z X U ζ i k ω + mk.Q (X i ω) * (c - ∑ j ∈ Finset.range (mk.N (X i ω)), mk.C (X i ω) j)

/-- The tree operator (10) for weights `w`, degrees `n` and self-weight `lam`:
Δf(i) = Σ_{j < n i} w i j · f(i ++ [j]) + lam · f(i). -/
noncomputable def treeOp (n : Label → ℕ) (w : Label → ℕ → ℝ) (lam : ℝ) (f : Label → ℝ)
    (i : Label) : ℝ :=
  ∑ j ∈ Finset.range (n i), w i j * f (i ++ [j]) + lam * f i

/-- Root opinion Σ_{s ≥ 0} (Δ^s 𝓦^(s))(∅) — the paper's 𝓡* = lim_k B_∅^(k) (proof of Theorem 2,
p. 27; equal to series (5) by Proposition 3). -/
noncomputable def rootOpinion (n : Label → ℕ) (w : Label → ℕ → ℝ) (lam : ℝ)
    (sig : ℕ → Label → ℝ) : ℝ :=
  ∑' s : ℕ, ((treeOp n w lam)^[s] (sig s)) []

/-- Relative path weight Π_(i,t)/Π_i, without division: the product of the weights along the
path `t` below `i` (each factor `w (i ++ prefix) j` if the step `j` is a child, `0` otherwise). -/
noncomputable def pathW (n : Label → ℕ) (w : Label → ℕ → ℝ) : Label → Label → ℝ
  | _, [] => 1
  | i, j :: t => (if j < n i then w i j else 0) * pathW n w (i ++ [j]) t

/-- Generation `l` of the subtree below `i`, as suffixes `t` relative to `i`
(the node itself is `i ++ t`). -/
def level (n : Label → ℕ) (i : Label) : ℕ → Finset Label
  | 0 => {[]}
  | l + 1 => (level n i l).biUnion
      (fun t => (Finset.range (n (i ++ t))).image (fun j => t ++ [j]))

/-- a_{l,s} = (s choose l)(1 − c − d)^{s−l} (p. 10). Only `l ≤ s` is ever used, so the truncated
natural subtraction `s - l` never truncates. -/
noncomputable def aCoef (c d : ℝ) (l s : ℕ) : ℝ :=
  (s.choose l : ℝ) * (1 - c - d) ^ (s - l)

/-- No-memory opinion of the subtree below `b`, with time offset `t0`:
Σ_{s ≥ 0} Σ_{|t| = s} (Π_(b,t)/Π_b) sig^(t0+s)((b, t)). -/
noncomputable def subtreeOpinion (n : Label → ℕ) (w : Label → ℕ → ℝ) (sig : ℕ → Label → ℝ)
    (b : Label) (t0 : ℕ) : ℝ :=
  ∑' s : ℕ, ∑ t ∈ level n b s, pathW n w b t * sig (t0 + s) (b ++ t)

/-- The limit opinion 𝓡* of the root at the outcome `ω`: `rootOpinion` on the tree read off the
marks, with `lam = 1 − c − d` and signals 𝓦_i^(s). -/
noncomputable def Rstar [MeasurableSpace M] (mk : MarkFns M) (X : Label → Ω → M)
    (U : Label → ℕ → Ω → ℝ) (ζ : M → ℝ → ℝ) (c d : ℝ) (ω : Ω) : ℝ :=
  rootOpinion (fun i => mk.N (X i ω)) (fun i j => mk.C (X i ω) j) (1 - c - d)
    (fun s i => W mk X U ζ c d i s ω)

/-- The no-memory subtree opinion below `b` at time offset `t0`, at the outcome `ω`. The paper's
𝓡_j of (7) is `Rsub … [j] 1` (0-based `j`), and its 𝓡 of (14) is `Rsub … [0] 1`. -/
noncomputable def Rsub [MeasurableSpace M] (mk : MarkFns M) (X : Label → Ω → M)
    (U : Label → ℕ → Ω → ℝ) (ζ : M → ℝ → ℝ) (c d : ℝ) (b : Label) (t0 : ℕ) (ω : Ω) : ℝ :=
  subtreeOpinion (fun i => mk.N (X i ω)) (fun i j => mk.C (X i ω) j)
    (fun s i => W mk X U ζ c d i s ω) b t0

/-- ρ₂ = E[Σ_{j=1}^{𝓝₁} 𝓒_(1,j)²], at the paper's node 1 (Lean `[0]`). -/
noncomputable def rho2 [MeasurableSpace Ω] [MeasurableSpace M] (P : Measure Ω) (mk : MarkFns M)
    (X : Label → Ω → M) : ℝ :=
  ∫ ω, ∑ j ∈ Finset.range (mk.N (X [0] ω)), mk.C (X [0] ω) j ^ 2 ∂P

/-- ρ*₂ = E[Σ_{j=1}^{𝓝_∅} 𝓒_j²], at the root. -/
noncomputable def rho2Star [MeasurableSpace Ω] [MeasurableSpace M] (P : Measure Ω)
    (mk : MarkFns M) (X : Label → Ω → M) : ℝ :=
  ∫ ω, ∑ j ∈ Finset.range (mk.N (X [] ω)), mk.C (X [] ω) j ^ 2 ∂P

/-- The σ-algebra σ(𝓧_i) generated by the mark of node `i`; conditioning on it gives E[· | 𝓧_i]
and Var(· | 𝓧_i). (A `def`, not an instance: the ambient σ-algebra of Ω is unchanged.) -/
abbrev markSigma [MeasurableSpace M] (X : Label → Ω → M) (i : Label) : MeasurableSpace Ω :=
  MeasurableSpace.comap (X i) inferInstance

end DirectedOpinion.NoMemory


