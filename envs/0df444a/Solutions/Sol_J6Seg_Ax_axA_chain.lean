-- Source module: Solutions.J6SegAxis5
/-!
# B-line axis program (`AxisU6`), part 5: the regime of one axis, array lengths, row facts

* `AxReg P n src D k`: `1 ≤ λ`, `0 < n_c`, `s ≤ t`, `n_c λ = t`, `0 < post` (from `r6_maps_eq`
  and the positivity of the box);
* `arr_lens`: the lengths of the six intermediate arrays (as `LRep` blocks);
* `AB_lineAt`: a bound on all entries passes to the rows;
* `bnd_of_GB`: `GB w` bounds the integers of `gflat`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem bnd_of_GB {w : ℕ} {L : List GI} (h : GB w L) : ∀ u ∈ gflat L, zsz u ≤ w :=
  GB.bnd h

end J6Seg.Ax

