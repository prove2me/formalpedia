theorem ModularCurve.isSeparable_adjoin_jq_extendScalars_full (L : Type*) [Field L] [Algebra ℚ L] (N M : ℕ) [NeZero N] [NeZero M] (hle : laurentBaseChange L (modularFunctionFieldFull N) ≤ laurentBaseChange L (modularFunctionFieldFull M)) : Algebra.IsSeparable (IntermediateField.adjoin L ({algebraMap (laurentBaseChange L (modularFunctionFieldFull N)) (IntermediateField.extendScalars hle) ⟨coeffEmb L jq, coeffEmb_mem_laurentBaseChange L (jq_mem_full N)⟩} : Set (IntermediateField.extendScalars hle))) (IntermediateField.extendScalars hle) := by sorry
