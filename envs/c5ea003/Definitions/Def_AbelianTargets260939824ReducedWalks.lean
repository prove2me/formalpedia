-- title:
--   Reduced walks and odd torsion
-- statement:
--   Let $H$ be a simple graph. On graph walks with fixed endpoints, reduced homotopy is the equivalence relation generated by deleting a spur $(a,b,a)$ and deleting a closed walk of length four, with these relations compatible with concatenation. Repeated vertices and edges are allowed. A closed walk $\gamma$ based at $b$ has power $\gamma^0$ equal to the constant walk, and $\gamma^{n+1}$ equal to $\gamma$ concatenated with $\gamma^n$.
--
--   The odd-involution condition means that an odd closed walk $\gamma$ exists with $\gamma^2$ reduced-homotopic to the constant walk. The odd-torsion condition means that an odd closed walk $\gamma$ and an integer $N>0$ exist with $\gamma^N$ reduced-homotopic to the constant walk. These express the respective hypotheses of Theorem 1.4 and Proposition 7.1 without introducing a quotient-group axiom.
-- source:
--   Ruijun Wang, Continuous graph homomorphisms of higher dimensional abelian group actions, arXiv:2609.39824v1 (30 September 2026), Section 2.2, Theorem 1.4 and Proposition 7.1; https://arxiv.org/html/2609.39824v1#S2.SS2

import Mathlib.Combinatorics.SimpleGraph.Walk.Maps
import Mathlib.Algebra.Ring.Parity

/-!
The reduced walk presentation used by arXiv:2609.39824v1, Section 2.2.
Spurs and closed walks of length four are trivial. Closure under
equivalence and concatenation gives the reduced homotopy relation.
The target hypotheses are expressed using genuine graph walks, without
postulating any quotient-group theorem or any result from the target paper.
-/

set_option autoImplicit false

namespace AbelianTargets

universe v

variable {V : Type v} (H : SimpleGraph V)

/-- Reduced homotopy generated by spur deletion, four-walk deletion,
equivalence, and concatenation. -/
inductive ReducedHomotopic : {a b : V} → H.Walk a b → H.Walk a b → Prop
  | refl {a b : V} (p : H.Walk a b) : ReducedHomotopic p p
  | symm {a b : V} {p q : H.Walk a b} :
      ReducedHomotopic p q → ReducedHomotopic q p
  | trans {a b : V} {p q r : H.Walk a b} :
      ReducedHomotopic p q → ReducedHomotopic q r → ReducedHomotopic p r
  | append {a b c : V} {p q : H.Walk a b} {r s : H.Walk b c} :
      ReducedHomotopic p q → ReducedHomotopic r s →
        ReducedHomotopic (p.append r) (q.append s)
  | spur {a b : V} (h : H.Adj a b) :
      ReducedHomotopic (.cons h (.cons h.symm .nil)) .nil
  | four {a : V} (p : H.Walk a a) (hp : p.length = 4) :
      ReducedHomotopic p .nil

/-- Concatenation of `n` copies of a based closed walk. -/
def loopPower {b : V} (γ : H.Walk b b) : ℕ → H.Walk b b
  | 0 => .nil
  | n + 1 => γ.append (loopPower γ n)

/-- The odd order-two hypothesis of Theorem 1.4. The walk is closed and
has odd length, and its square represents the reduced identity. -/
def HasOddInvolution (H : SimpleGraph V) : Prop :=
  ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
    ReducedHomotopic H (loopPower H γ 2) .nil

/-- The odd finite-order hypothesis of Proposition 7.1. Positivity of
the trivializing exponent excludes the vacuous zero-th power. -/
def HasOddTorsion (H : SimpleGraph V) : Prop :=
  ∃ b : V, ∃ γ : H.Walk b b, Odd γ.length ∧
    ∃ N : ℕ, 0 < N ∧ ReducedHomotopic H (loopPower H γ N) .nil

end AbelianTargets


