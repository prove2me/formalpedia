theorem ModularCurve.intCoeffs_minpoly_lambdaNModC_coeff (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (k : ℕ) :
    IntCoeffs (((minpoly (↥(IntermediateField.adjoin ℚ ({lambdaModC ℚ} : Set (LaurentSeries ℚ)))) (lambdaNModC ℚ q)).coeff k
        : LaurentSeries ℚ)) := by sorry
