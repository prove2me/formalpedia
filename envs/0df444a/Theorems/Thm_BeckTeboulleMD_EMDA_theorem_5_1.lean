-- title:
--   Theorem 5.1, p. 174 — EMDA from n⁻¹e with step √(2 ln n)/(L_f√k): min_{1≤s≤k} f(x^s) − min_Δ f ≤ √(2 ln n)·L_f/√k
-- statement:
--   This is the efficiency estimate of the entropic mirror descent algorithm (EMDA) on the unit simplex.
--
--   Let $\Delta = \{x \in \mathbb R^n : x \ge 0,\ \sum_j x_j = 1\}$. Let $f : \mathbb R^n \to \mathbb R$ be convex on $\Delta$ and Lipschitz there with constant $L_f > 0$ for the $\ell_1$ norm, $|f(x) - f(y)| \le L_f \|x - y\|_1$, and let $x^* \in \Delta$ minimise $f$ over $\Delta$. Let $f'$ be a subgradient oracle on $\Delta$, $f(x) + \langle y - x, f'(x)\rangle \le f(y)$ for $x, y \in \Delta$, with $\|f'(x)\|_\infty \le L_f$. Fix a horizon $k \ge 1$, and let $(x^s)_{s \ge 1}$ be generated by the EDA from $x^1 = n^{-1}e$ with the step size $t = \sqrt{2\ln n}/(L_f\sqrt k)$:
--   $$x^{s+1}_j = \frac{x^s_j\, e^{-t f'_j(x^s)}}{\sum_{i=1}^n x^s_i\, e^{-t f'_i(x^s)}}.$$
--   Then
--   $$\min_{1 \le s \le k} f(x^s) - \min_{x \in \Delta} f(x) \le \frac{\sqrt{2 \ln n}\; L_f}{\sqrt k}.$$
--
--   The bound depends on the dimension only through $\sqrt{\ln n}$, compared with $\sqrt n$ for the Euclidean projected subgradient method on $\Delta$, and the algorithm is fully explicit.
--
--   **Formalization Note** The page's display (5.28) has $\|f'(x^s)\|_\infty$ on the right with $s$ not bound there; the proof applies Theorem 4.2 with the EDA's step $\sqrt{2\ln n}/(L_f\sqrt k)$, which yields $L_f$, so the bound is stated with $L_f$. The bound $\|f'(x)\|_\infty \le L_f$ on the oracle is an added hypothesis (the proof uses it; it is not implied by the Lipschitz condition for subgradients relative to $\Delta$). The step is constant over the horizon $1, \dots, k$, which is how the proof chooses it; the page's "$t_k = \frac{\sqrt{2\ln n}}{L_f}\frac{1}{\sqrt k}$" is not an anytime schedule. "$\min_{1\le s\le k}$" is stated as "there is $s \in \{1, \dots, k\}$ with $f(x^s) - f(x^*) \le \dots$". Vectors are functions $\{1,\dots,n\} \to \mathbb R$ with explicit $\ell_1$ and $\ell_\infty$ expressions. For $n = 0$ the simplex is empty and for $n = 1$ the bound is $0$ on a one-point simplex; no restriction on $n$ is added.
-- source:
--   Beck & Teboulle, Mirror descent and nonlinear projected subgradient methods for convex optimization, Oper. Res. Lett. 31 (2003), p. 174, Theorem 5.1 and (5.28); EDA p. 174; Assumption A p. 167

import Mathlib
import Definitions.Def_BeckTeboulleMD_EMDA_Setting

namespace BeckTeboulleMD.EMDA

/-- Theorem 5.1, p. 174, (5.28): the entropic mirror descent algorithm on the unit simplex `Δ`,
started at `x¹ = n⁻¹e` with the constant step `t = √(2 ln n) / (L_f √k)` for the horizon `k ≥ 1`,
satisfies `min_{1≤s≤k} f(x^s) − min_Δ f ≤ √(2 ln n) L_f / √k`, where `f` is convex and
`L_f`-Lipschitz on `Δ` for `‖·‖₁` and the subgradients satisfy `‖f′(x)‖_∞ ≤ L_f`. -/
theorem theorem_5_1 {n : ℕ} (f : (Fin n → ℝ) → ℝ) (hf : ConvexOn ℝ (stdSimplex ℝ (Fin n)) f)
    (Lf : ℝ) (hLf : 0 < Lf)
    (hLip : ∀ x ∈ stdSimplex ℝ (Fin n), ∀ y ∈ stdSimplex ℝ (Fin n),
      |f x - f y| ≤ Lf * ∑ j, |x j - y j|)
    (g : (Fin n → ℝ) → (Fin n → ℝ))
    (hg : ∀ x ∈ stdSimplex ℝ (Fin n), ∀ y ∈ stdSimplex ℝ (Fin n),
      f x + ∑ j, g x j * (y j - x j) ≤ f y)
    (hgb : ∀ x ∈ stdSimplex ℝ (Fin n), ∀ j, |g x j| ≤ Lf)
    (xstar : Fin n → ℝ) (hxstar : xstar ∈ stdSimplex ℝ (Fin n))
    (hmin : ∀ y ∈ stdSimplex ℝ (Fin n), f xstar ≤ f y)
    (k : ℕ) (hk : 1 ≤ k)
    (x : ℕ → Fin n → ℝ) (hx1 : x 1 = fun _ => 1 / (n : ℝ))
    (hrun : IsEDARun g (Real.sqrt (2 * Real.log n) / (Lf * Real.sqrt k)) x) :
    ∃ s ∈ Finset.Icc 1 k,
      f (x s) - f xstar ≤ Real.sqrt (2 * Real.log n) * Lf / Real.sqrt k := by sorry

end BeckTeboulleMD.EMDA
