          ⟨y.1 ≫ gA', by rw [Category.assoc, hgA'.w, ← Category.assoc, y.2]⟩).1)
    (hPA' : ∀ i, (v'.P i).1 ≫ gA' = Spec.map (CommRingCat.ofHom φ) ≫ (u.P i).1)
    (hpolA' : Nonempty ((Scheme.Modules.pullback gA').obj u.pol ≅ v'.pol))

    (e : v.A ≅ v'.A) (he : e.hom ≫ v'.f = v.f)
