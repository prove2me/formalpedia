theorem cK3_le {a g c Z : ℕ} (ha : zsz (a : ℤ) ≤ Z) (hg : zsz (g : ℤ) ≤ Z) (hc : zsz (c : ℤ) ≤ Z)
    (h2 : 2 ≤ Z) : cK3 a g c ≤ 8 * cU Z := by
  have e2 : zsz (2 : ℤ) ≤ Z := le_trans (by have := zsz_two_pow 1; simp at this; omega) h2
  have := dup_le_cU ha; have := dup_le_cU hg; have := dup_le_cU hc
  have := const_le_cU e2; have := drop_le_cU ha; have := drop_le_cU hg; have := drop_le_cU hc
  have := drop_le_cU e2
  unfold cK3; omega

