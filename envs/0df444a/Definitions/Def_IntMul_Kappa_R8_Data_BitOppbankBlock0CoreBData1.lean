/-! Block-0 gates after the 1771 leaves. Compact prefix pack only; not segsR / W1F. -/

theorem isND_cND {t : ℕ} (ht : t < 62478) : isND (cND t) = true := by
  have hle : 1773 ≤ 1773 + t := Nat.le_add_right 1773 t
  have hlt : 1773 + t < 64251 := by omega
  unfold isND
  rw [cND_eq]
  have hcb : SupG.codeBound = 64251 := SupG.codeBound_eq
  -- isND unfolds to ble && blt on codeBound, which is SupG.codeBound
  simpa [hcb, Nat.ble, Nat.blt, hle, decide_eq_true_eq] using (Nat.lt_succ_iff.mp hlt)

theorem nestOK_of_argRel_ND {t n : ℕ}
    (ht : isND (cND t) = true) (hn : isND (cND n) = true)
    (h : argRel t n = true) : nestOK (cND t) (cND n) = true := by
  have hto : (cND t).sub 1773 = t := by rw [cND_eq]; exact Nat.add_sub_cancel_left 1773 t
  have hno : (cND n).sub 1773 = n := by rw [cND_eq]; exact Nat.add_sub_cancel_left 1773 n
  unfold nestOK
  rw [hto, hno, ht, hn, h]
  simp

theorem cND_lt_bound_of_le {t : ℕ} (ht : t ≤ 20278) :
    cND t < SupG.codeBound := by
  rw [cND_eq]
  have : SupG.codeBound = 64251 := SupG.codeBound_eq
  omega

def gateN (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.1
def gatePiv (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.2.1
def gateBp (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.2.2.1
def gateNf (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.2.2.2.1
def gateTp (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.2.2.2.2.1
def gateTb (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) : ℕ := g.2.2.2.2.2

def gateFreshStart : List (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) → ℕ → ℕ
  | [], start => start
  | g :: gs, start => gateFreshStart gs (start + gateNf g)

def gateExtras (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) (start : ℕ) : List ℕ :=
  (gateBp g - 1) :: List.range' start (gateNf g)

def gateAtOf (g : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) (start : ℕ) : LInstr :=
  mk (cND (gateN g)) (recEl (gateN g, gatePiv g, gateBp g, gateExtras g start))

def gateMixOf : List (ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) → ℕ → List LInstr
  | [], _ => []
  | g :: gs, start => gateAtOf g start :: gateMixOf gs (start + gateNf g)

def gateMix : List LInstr := gateMixOf gatePack leafSlotBound

theorem gatePack_len : gatePack.length = 1301 := rfl
theorem gateLows_len : gateLowsSorted.length = 2602 := rfl


