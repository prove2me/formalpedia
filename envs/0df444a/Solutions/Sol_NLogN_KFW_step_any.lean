theorem RImplQ.mono {A : ROp (Fin W) m κ} {U : IStmt HS Pp} {e dw : ℕ} {c c' : ℕ → ℕ}
    (h : RImplQ I iprog Q lo hi r n st A U e dw c)
    (hc : ∀ w, lo ≤ w → w + dw ≤ hi → c w ≤ c' w) :
    RImplQ I iprog Q lo hi r n st A U e dw c' := by
  intro s f zs l X F w hQ hC h0 hx hX hb h1 h2
  obtain ⟨zs', r1, b1, f1⟩ := h s f zs l X F w hQ hC h0 hx hX hb h1 h2
  exact ⟨zs', r1, b1, f1.mono (hc w h1 h2)⟩

theorem RImplQ.comp (hs : SLaws st n) {A B : ROp (Fin W) m κ} {c1 c2 : IStmt HS Pp}
    {e1 e2 d1 d2 : ℕ} {k1 k2 : ℕ → ℕ} (h1 : RImplQ I iprog Q lo hi r n st A c1 e1 d1 k1)
    (h2 : RImplQ I iprog Q lo hi r n st B c2 e2 d2 k2) :
    RImplQ I iprog Q lo hi r n st (B * A) (.seq c1 c2) (e1 + e2) (d1 + d2)
      (fun w => k1 w + k2 (w + d1)) := by
  intro s f zs l X F w hQ hC h0 hx hX hb hlo hhi
  obtain ⟨zs1, r1, b1, f1⟩ := h1 s f zs l X F w hQ hC h0 hx hX hb hlo (by omega)
  obtain ⟨zs2, r2, b2, f2⟩ := h2 s (Function.update f 0 (gflat zs1 ++ l)) zs1 l _ (F + e1)
    (w + d1) hQ (hC.upd0 _) (by simp) r1 (fun v => length_roleOpF _ _ _ _ _) b1 (by omega)
    (by omega)
  refine ⟨zs2, ?_, ?_, ?_⟩
  · rw [← roleOpF_mul hs, ← add_assoc]; exact r2
  · rw [← add_assoc]; exact b2
  · have := f1.seq f2
    rwa [Function.update_idem] at this

theorem rImplQ_skip :
    RImplQ (W := W) I iprog Q lo hi r n st 1 (.skip : IStmt HS Pp) 0 0 (fun _ => 1) := by
  intro s f zs l X F w hQ hC h0 hx hX hb _ _
  refine ⟨zs, ?_, hb, ?_⟩
  · rw [roleOpF_one hX]; exact hx
  · have e : Function.update f 0 (gflat zs ++ l) = f := by
      rw [← h0]; exact Function.update_eq_self 0 f
    rw [e]; exact IRuns.skip _

/-- **A list of implemented steps implements the network.** -/
theorem rImplQ_list (hs : SLaws st n) (T : Butterfly.Op κ) (code : RStep (Fin W) m → IStmt HS Pp)
    (e dw : RStep (Fin W) m → ℕ) (cost : RStep (Fin W) m → ℕ → ℕ) :
    ∀ l : List (RStep (Fin W) m),
      (∀ a ∈ l, RImplQ I iprog Q lo hi r n st (a.den T) (code a) (e a) (dw a) (cost a)) →
      RImplQ I iprog Q lo hi r n st (denListR T l) (seqLQ code l) (l.map e).sum (l.map dw).sum
        (costL cost dw l)
  | [], _ => by
    simp only [denListR_nil, List.map_nil, seqLQ, List.sum_nil]
    exact rImplQ_skip
  | a :: l, h => by
    have H := (h a List.mem_cons_self).comp hs
      (rImplQ_list hs T code e dw cost l fun b hb => h b (List.mem_cons_of_mem _ hb))
    rw [← KFN.denListR_cons] at H
    simpa [seqLQ, costL] using H

/-- A register-program leaf for a network operator. -/
theorem rImplQ_leaf {A : ROp (Fin W) m κ} {O U : RS} {e dw X : ℕ}
    {c : ℕ → ℕ} {σ : Fin HS → Option ℤ} (H : RImpl r n st A O e dw c) (hσ : SClean σ)
    (hw : NoW σ U) (hO : HRef O (RS.sub σ U) X) (hf : fok O = true)
    (hQ : ∀ s, Q s → Agree σ s) (h0σ : σ 0 = none) :
    RImplQ I iprog Q lo hi r n st A (fcode U) e dw (fun w => 400 * (c w + X)) := by
  intro s f zs l Xs F w hq hC h0 hx hX hb _ _
  obtain ⟨zs', r1, b1, f1⟩ := H s f zs l Xs F w hC.clN h0 hx hX hb
  refine ⟨zs', r1, b1, ?_⟩
  have hag : Agree σ (NLogN.KIL.encK s f) := agree_encK (hQ s hq) (fun j hj => by
    have : j ≠ 0 := by rintro rfl; simp [h0σ] at hj
    exact hC j this)
  exact (FSp.uni hσ hw hO hag f1).irun (fok_uni hw hO hf)

