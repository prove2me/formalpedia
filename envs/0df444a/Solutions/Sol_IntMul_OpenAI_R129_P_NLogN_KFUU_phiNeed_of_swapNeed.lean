  have z3 : NLogN.zsz ((3 + 3 * d : ℕ) : ℤ) ≤ 3 + 3 * d := NLogN.KFUU.zsz_le_self _
  have z2h : NLogN.zsz ((2 ^ h * 2 : ℕ) : ℤ) ≤ h + 2 := NLogN.zsz_le_of_lt (by
    simp only [Int.natAbs_natCast]; rw [pow_add]; have := Nat.one_le_two_pow (n := h); omega)
  have zh : NLogN.zsz ((2 ^ h : ℕ) : ℤ) ≤ h + 1 := NLogN.zsz_le_of_lt (by
    simp only [Int.natAbs_natCast]; rw [pow_succ]; have := Nat.one_le_two_pow (n := h); omega)
  have zSS : NLogN.zsz (VS : ℤ) ≤ NLogN.zsz ((2 * VS : ℕ) : ℤ) := NLogN.zsz_natCast_le' (by omega)
  have eS : NLogN.zsz ((AModel.vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) : ℕ) : ℤ) = NLogN.zsz (VS : ℤ) := rfl
  have eT : NLogN.zsz ((AModel.vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) : ℕ) : ℤ) = NLogN.zsz (VT : ℤ) := rfl
  have hown0 : NLogN.KFM.kTable ext (NLogN.KFM.gO E₁ 0 0 2 0) =
      NLogN.KFUU.phiFU (NLogN.KFM.pMul _) eSw sdS (NLogN.KFUU.dscOf sdS) := by
    show NLogN.KFM.mTable ext₁ NLogN.KFUU.ext0 NLogN.KFUU.ext0 (NLogN.KFUU.ownPhi E₁ entry sdS) (NLogN.KFM.gO E₁ 0 0 2 0) = _
    rw [NLogN.KFM.mTable_own]; rfl
  have hown1 : NLogN.KFM.kTable ext (NLogN.KFM.gO E₁ 0 0 2 1) =
      NLogN.KFUU.phiBU (NLogN.KFM.pMul _) eSw sdS (NLogN.KFUU.dscOf sdS) := by
    show NLogN.KFM.mTable ext₁ NLogN.KFUU.ext0 NLogN.KFUU.ext0 (NLogN.KFUU.ownPhi E₁ entry sdS) (NLogN.KFM.gO E₁ 0 0 2 1) = _
