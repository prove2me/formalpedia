namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFT Synth

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem getD_mem_bnd {zs : List GI} {P : GI → Prop} (h : ∀ z ∈ zs, P z) (h0 : P 0) (i : ℕ) :
    P (zs.getD i 0) := by
  rcases lt_or_ge i zs.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ hi]; exact h0

end NLogN.KFV

