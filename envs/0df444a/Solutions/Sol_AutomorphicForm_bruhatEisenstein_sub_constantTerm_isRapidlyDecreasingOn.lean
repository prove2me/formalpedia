section Combination

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

local notation "𝔸" => AdeleRing (𝓞 F) F

private theorem exists_iteratedDeriv_slice_le_rpow_Dy
    (α : (𝔸)ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : (𝔸)ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    (E : ℝ → 𝔸) (hE1 : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y)
    (hE2 : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE3 : ∀ y, (E y).2 = 0) :
    ∀ S : Set (AdelicGL2 (𝓞 F) F), IsCompact S → ∀ n : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ x ∈ S, ∀ (a : 𝔸) (y : ℝ),
        ‖iteratedDeriv n (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)) y‖
          ≤ C * Dy F (a + E y) ^ (-(2 * s.re + 1)) := by
  by_cases h0 : φ = 0
  · subst h0
    exact fun S _ n => ⟨0, le_rfl, fun x _ a y => by simp⟩
  obtain ⟨g₀, hg₀⟩ := Function.ne_iff.1 h0
  have hc := continuous_chi_realIdeleAt_of_apply_ne_zero hw hφ hφc hg₀
  obtain ⟨m, kv, -, hD3⟩ := exists_slice_iteratedDeriv_bound hw hφ hφc hK hσ hc.1 hc.2
    (fun r => (norm_etaFst_realIdeleAt hw α hα hαΔ hμ s r).le)
    (fun r => (norm_etaSnd_realIdeleAt hw α hα hαΔ hν s r).le) E hE1 hE2 hE3
  intro S hS n
  obtain ⟨C₃, hC₃, hle⟩ := hD3 S hS n

  have hKc : IsCompact (⋃ i : Fin m, (fun x => reshapeAt F w x * kv i) '' S) :=
    isCompact_iUnion fun i => hS.image ((continuous_reshapeAt F w).mul continuous_const)
  obtain ⟨B, hB0, hB⟩ := norm_apply_weyl_unipotent_le_uniform F α hα μ ν s φ hμ hν hφ hφc hKc
  rw [adelicWeyl_inv' F] at hB
  refine ⟨C₃ * ((m : ℝ) * B), mul_nonneg hC₃ (mul_nonneg (Nat.cast_nonneg _) hB0), fun x hx a y => ?_⟩
  have hmult : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩

  have hi : ∀ i : Fin m, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖
      ≤ B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)) := fun i => by
    have hmem : reshapeAt F w x * kv i ∈ ⋃ i : Fin m, (fun x => reshapeAt F w x * kv i) '' S :=
      Set.mem_iUnion.2 ⟨i, Set.mem_image_of_mem (fun x => reshapeAt F w x * kv i) hx⟩
    have h := hB _ hmem (zeroAt F w a)
    rw [hαΔ] at h
    change _ ≤ B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)) at h
    rw [awayFrom_weyl_unipotent_eq_reshapeAt F w x a]
    simpa only [mul_assoc] using h
  have hsum : ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖
      ≤ (m : ℝ) * (B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1))) := by
    have h := Finset.sum_le_card_nsmul (Finset.univ : Finset (Fin m))
      (fun i => ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖) _ fun i _ => hi i
    rwa [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h

  have h1' : ∀ v, v ≠ w → (zeroAt F w a).1 v = (a + E y).1 v := fun v hvw => by
    rw [zeroAt_fst_of_ne F a hvw]
    show a.1 v = a.1 v + (E y).1 v
    rw [hE2 y v hvw, add_zero]
  have h3' : (zeroAt F w a).2 = (a + E y).2 := by
    show a.2 = a.2 + (E y).2
    rw [hE3 y, add_zero]
  have hsplit : Dy F (a + E y) = max 1 ‖(a + E y).1 w‖ * Dy F (zeroAt F w a) := by
    rw [Dy_eq_max_mul_Dy_of_agree F w h1' (zeroAt_fst_self F w a) h3', hmult, pow_one]
  have hM0 : (0 : ℝ) ≤ max 1 ‖(a + E y).1 w‖ := zero_le_one.trans (le_max_left _ _)
  have hD0 : (0 : ℝ) ≤ Dy F (zeroAt F w a) := (Dy_pos F _).le
  have hD := hle x hx a y
  have h2τ : (2 : ℝ) * (s.re + 1 / 2) = 2 * s.re + 1 := by ring
  rw [h2τ] at hD
  calc ‖iteratedDeriv n (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)) y‖
      ≤ C₃ * max 1 ‖(a + E y).1 w‖ ^ (-(2 * s.re + 1))
          * ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖ := hD
    _ ≤ C₃ * max 1 ‖(a + E y).1 w‖ ^ (-(2 * s.re + 1)) * ((m : ℝ) * (B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)))) :=
        mul_le_mul_of_nonneg_left hsum (mul_nonneg hC₃ (Real.rpow_nonneg hM0 _))
    _ = C₃ * ((m : ℝ) * B) * ((max 1 ‖(a + E y).1 w‖ * Dy F (zeroAt F w a)) ^ (-(2 * s.re + 1))) := by
        rw [Real.mul_rpow hM0 hD0]; ring
    _ = C₃ * ((m : ℝ) * B) * Dy F (a + E y) ^ (-(2 * s.re + 1)) := by rw [hsplit]

private theorem exists_summable_slice_majorant
    (α : (𝔸)ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : (𝔸)ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    (E : ℝ → 𝔸) (hE1 : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y)
    (hE2 : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE3 : ∀ y, (E y).2 = 0)
    (z : F → 𝔸) (hz : Summable fun ξ : F => Dy F (z ξ) ^ (-(2 * s.re + 1))) :
    ∀ S : Set (AdelicGL2 (𝓞 F) F), IsCompact S → ∀ (n : ℕ) (R : ℝ), 0 ≤ R →
      ∃ M : F → ℝ, Summable M ∧ ∀ x ∈ S, ∀ (ξ : F) (y : ℝ), |y| ≤ R →
        ‖iteratedDeriv n (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (z ξ + E y) * x)) y‖ ≤ M ξ := by
  intro S hS n R hR
  obtain ⟨C, hC, hle⟩ :=
    exists_iteratedDeriv_slice_le_rpow_Dy hw α hα hαΔ μ ν hμ hν s hσ φ hφ hφc hK E hE1 hE2 hE3 S hS n
  have he : (0 : ℝ) ≤ 2 * s.re + 1 := by linarith
  refine ⟨fun ξ => C * (((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ^ (2 * s.re + 1) * Dy F (z ξ) ^ (-(2 * s.re + 1))),
    (hz.mul_left _).mul_left C, fun x hx ξ y hy => (hle x hx (z ξ) y).trans (mul_le_mul_of_nonneg_left ?_ hC)⟩
  have hu1 : ∀ v, ‖(-(E y)).1 v‖ ≤ R := fun v => by
    show ‖-((E y).1 v)‖ ≤ R
    rw [norm_neg]
    by_cases hvw : v = w
    · rw [hvw, hE1, norm_ringEquiv_symm hw, Real.norm_eq_abs]
      exact hy
    · rw [hE2 y v hvw, norm_zero]
      exact hR
  have hu2 : (-(E y)).2 ∈ AdelicBox.integralFiniteAdeles (𝓞 F) F := by
    show -((E y).2) ∈ AdelicBox.integralFiniteAdeles (𝓞 F) F
    rw [hE3 y, neg_zero]
    exact fun v => (v.adicCompletionIntegers F).zero_mem
  have h := rpow_Dy_le_translate_of_le F (z ξ + E y) (-(E y)) hu1 hu2 he
  rwa [add_neg_cancel_right] at h

end Combination
