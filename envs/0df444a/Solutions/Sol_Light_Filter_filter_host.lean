  have hro : roundsOf n ≤ 3 * kOf n + 1 := by
    unfold roundsOf; have := Nat.div_le_self (3 * kOf n) (dOf n); omega
  rw [filterWord_eq]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> omega

