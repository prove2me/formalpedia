theorem POp.getElem {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ} (hP : POp g σ n) {b : List ℕ}
    (hb : b.length = n) {i : ℕ} (hi : i < (g b).length) :
    (g b)[i] = b[σ i]'(by rw [hb]; exact hP.lt i (by rw [hP.length hb] at hi; exact hi)) := by
  have hi' : i < n := by rw [hP.length hb] at hi; exact hi
  simp only [hP.eq b hb, getElem_permIdx]
  rw [List.getD_eq_getElem _ _ (by rw [hb]; exact hP.lt i hi')]

theorem POp.nodup {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ} (hP : POp g σ n) {l : List ℕ}
    (hl : l.length = n) (hnd : (g l).Nodup) : l.Nodup := by
  rw [List.nodup_iff_injective_get]
  intro ⟨j1, h1⟩ ⟨j2, h2⟩ he
  simp only [List.get_eq_getElem] at he
  obtain ⟨i1, hi1, rfl⟩ := hP.surj j1 (by omega)
  obtain ⟨i2, hi2, rfl⟩ := hP.surj j2 (by omega)
  have g1 := hP.getElem hl (i := i1) (by rw [hP.length hl]; exact hi1)
  have g2 := hP.getElem hl (i := i2) (by rw [hP.length hl]; exact hi2)
  have : (g l)[i1]'(by rw [hP.length hl]; exact hi1) = (g l)[i2]'(by rw [hP.length hl]; exact hi2) := by
    rw [g1, g2]; exact he
  have := (List.Nodup.getElem_inj_iff hnd).1 this
  subst this; rfl

theorem swapMid_getElem? (nA nF nG : ℕ) (a : List ℕ) (h : nA + nF + nG ≤ a.length) (i : ℕ) :
    (KIL.swapMid nA nF nG a)[i]? = a[mvIdx nA nF nG i]? := by
  unfold KIL.swapMid mvIdx
  simp only [List.getElem?_append, List.length_append, List.length_take, List.length_drop,
    List.getElem?_take, List.getElem?_drop]
  split_ifs <;> first
    | rfl
    | (congr 1; omega)
    | (exfalso; omega)
    | (rw [List.getElem?_eq_none (by omega), List.getElem?_eq_none (by omega)])
    | skip

theorem pop_swapMid {nA nF nG n : ℕ} (h : nA + nF + nG ≤ n) :
    POp (KIL.swapMid nA nF nG) (mvIdx nA nF nG) n where
  eq b hb := by
    apply List.ext_getElem?
    intro i
    rw [swapMid_getElem? nA nF nG b (by omega)]
    by_cases hi : i < n
    · have hl : mvIdx nA nF nG i < b.length := by rw [hb]; unfold mvIdx; split_ifs <;> omega
      rw [List.getElem?_eq_getElem (l := permIdx (mvIdx nA nF nG) b) (i := i) (by simp; omega),
