    (NLogN.EX.exactLP fw).run s = (s.upd NLogN.GL.gV RV).upd NLogN.GL.gD (NLogN.ints (exactConvL q u v) ++ R) ∧
    (NLogN.EX.exactLP fw).ok M s ∧
    (NLogN.EX.exactLP fw).cost M s ≤
      3 * NLogN.EX.fwdLCost q CS CB Bx CW Q Φm + 5 * q.S * Φm + 1000000 * (q.S + 1) * (Q + 2) := by
  have hBQ' : BB q.K ≤ Q := by have := hcfg.Bm; have := hcfg.mQ; omega
  obtain ⟨LP, hPP⟩ := hE.pp
  -- 1: scale u
  have S1 := NLogN.GL.scaleP_all M NLogN.GL.gPM (Or.inr rfl) (q.p - q.b) mu Q q.S s u R LM LS hu hul hPM hPS hub
    hmu hSQ
  set U := NLogN.GL.exU q u with hU
  have e1 : u.map (NLogN.GL.scaleF (q.p - q.b)) = U := rfl
  rw [e1] at S1
  set s1 := s.upd NLogN.GL.gD (NLogN.gints U ++ R) with hs1
  -- 2: fwd
  obtain ⟨r2, o2, c2, l2, b2⟩ := NLogN.EX.fwdLP_all fw hfw hM hcfg s1
    (hE.updW fw hfw NLogN.GL.gD (Or.inl rfl) _) U R (by simp [hs1]) inU
  rw [hs1, NLogN.IState.upd_upd_same] at r2
  set Ua := fwdL q U with hUa
  set s2 := s.upd NLogN.GL.gD (NLogN.gints Ua ++ R) with hs2
  -- 3: park `Ua` on `gSA`
  obtain ⟨r3, o3, c3⟩ := NLogN.GL.xferG M NLogN.GL.gD NLogN.GL.gSA NLogN.GL.gPM s2 Ua R LM Q q.S (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by simp [hs2]) l2 (by simp (config := {decide := true}) [hs2, hPM]) hSQ (b2.mono hBQ')
  set s3 := (s.upd NLogN.GL.gD R).upd NLogN.GL.gSA (NLogN.gints Ua ++ s.G NLogN.GL.gSA) with hs3
  have r3' : (NLogN.GL.xferP NLogN.GL.gD NLogN.GL.gSA (NLogN.GL.cnt2 NLogN.GL.gPM)).run s2 = s3 := by
    rw [r3, hs3, hs2]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  -- 4: bring `v` to `gD`
  have s3M : s3.G NLogN.GL.gPM = .int q.S :: LM := by simp (config := {decide := true}) [hs3, hPM]
  obtain ⟨g1, g2, g3, g4, g5, g6, g7, g8⟩ := NLogN.GL.cnt2_facts' NLogN.GL.gPM (by decide) s3 q.S LM Q s3M hSQ
  obtain ⟨r4, o4, c4⟩ := NLogN.GL.xferP_all M NLogN.GL.gV NLogN.GL.gD (.reg NLogN.GL.gPM) s3 v RV Q (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide)
    (by simp (config := {decide := true}) [hs3, hv]) (by rw [g5, hvl]) g6 g7 (by simp [NLogN.Ex.Lin]) g8
    (fun x hx => le_trans (hvb x hx) (by omega))
    (fun t ht => by
      have e : t.G NLogN.GL.gPM = s3.G gPM := ht NLogN.GL.gPM (by decide) (by decide)
      have e2 : t.top NLogN.GL.gPM = s3.top gPM := by simp [NLogN.IState.top, e]
      refine ⟨by simp [NLogN.Ex.eval, e2], ?_, ?_⟩
      · simpa [NLogN.Ex.ok, NLogN.IState.IsInt, e2, e] using g7
      · simpa [NLogN.Ex.Bnd, NLogN.Ex.eval, e2] using g8)
  set b4 := (s.upd NLogN.GL.gSA (NLogN.gints Ua ++ s.G NLogN.GL.gSA)).upd NLogN.GL.gV RV with hb4
  set s4 := b4.upd NLogN.GL.gD (NLogN.ints v ++ R) with hs4
  have r4' : (NLogN.GL.xferP NLogN.GL.gV NLogN.GL.gD (.reg NLogN.GL.gPM)).run s3 = s4 := by
    rw [r4, hs4, hb4, hs3]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  -- 5: scale v
  have E4 : NLogN.EX.FwdEnvX q kb Ctx b4 :=
    (hE.updW fw hfw NLogN.GL.gSA (Or.inr (Or.inr (Or.inl rfl))) _).updW fw hfw NLogN.GL.gV
      (Or.inr (Or.inr (Or.inr rfl))) _
  obtain ⟨LS', hPS'⟩ : ∃ L, s4.G NLogN.GL.gPS = .int (2 ^ (q.p - q.b)) :: L :=
    ⟨LS, by simp (config := {decide := true}) [hs4, hb4, hPS]⟩
  have S5 := NLogN.GL.scaleP_all M NLogN.GL.gPM (Or.inr rfl) (q.p - q.b) mu Q q.S s4 v R LM LS'
    (by simp [hs4]) hvl (by simp (config := {decide := true}) [hs4, hb4, hPM]) hPS' hvb hmu hSQ
  set V := NLogN.GL.exU q v with hV
  have e5 : v.map (NLogN.GL.scaleF (q.p - q.b)) = V := rfl
  rw [e5, hs4, NLogN.IState.upd_upd_same] at S5
  set s5 := b4.upd NLogN.GL.gD (NLogN.gints V ++ R) with hs5
  -- 6: fwd
  obtain ⟨r6, o6, c6, l6, b6⟩ := NLogN.EX.fwdLP_all fw hfw hM hcfg s5
    (E4.updW fw hfw NLogN.GL.gD (Or.inl rfl) _) V R (by simp [hs5]) inV
  rw [hs5, NLogN.IState.upd_upd_same] at r6
  set Va := fwdL q V with hVa
  set s6 := b4.upd NLogN.GL.gD (NLogN.gints Va ++ R) with hs6
  -- 7: `Ua` from `gSA` to `gZA`
  obtain ⟨r7, o7, c7⟩ := NLogN.GL.xferG M NLogN.GL.gSA NLogN.GL.gZA NLogN.GL.gPM s6 Ua (s.G NLogN.GL.gSA) LM Q q.S (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by simp (config := {decide := true}) [hs6, hb4]) l2
    (by simp (config := {decide := true}) [hs6, hb4, hPM]) hSQ (b2.mono hBQ')
  set b8 := s.upd NLogN.GL.gV RV with hb8
  set s7 := (b8.upd NLogN.GL.gD (NLogN.gints Va ++ R)).upd NLogN.GL.gZA (NLogN.gints Ua ++ s.G NLogN.GL.gZA) with hs7
  have r7' : (NLogN.GL.xferP NLogN.GL.gSA NLogN.GL.gZA (NLogN.GL.cnt2 NLogN.GL.gPM)).run s6 = s7 := by
    rw [r7, hs7, hb8, hs6, hb4]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  -- 8: pointwise product
  have hpQ : q.p + 1 ≤ Q := by have := hcfg.k; omega
  obtain ⟨r8, o8, c8⟩ := NLogN.GL.zipP_all M hM NLogN.GL.sgMulConj NLogN.GL.gPM (Or.inr rfl) q.p Q q.S s7 Ua Va (s.G NLogN.GL.gZA) R
    LM LP (by simp (config := {decide := true}) [hs7])
    (by simp (config := {decide := true}) [hs7])
    l2 l6 (by simp (config := {decide := true}) [hs7, hb8, hPM])
    (by simp (config := {decide := true}) [hs7, hb8, hPP]) (b2.mono hcfg.Bm) (b6.mono hcfg.Bm)
    hcfg.mQ hpQ hSQ
  rw [NLogN.GL.zipM_eq] at r8
  have eW : List.zipWith (fun a b => conjZ (mulZ q.p a b)) Ua Va = NLogN.GL.exW q u v := rfl
  rw [eW] at r8
  set s8 := b8.upd NLogN.GL.gD (NLogN.gints (NLogN.GL.exW q u v) ++ R) with hs8
  have r8' : (NLogN.GL.zipP NLogN.GL.sgMulConj NLogN.GL.gPM).run s7 = s8 := by
    rw [r8, hs8, hs7, hb8]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  -- 9: fwd
  have E8 : NLogN.EX.FwdEnvX q kb Ctx b8 := hE.updW fw hfw NLogN.GL.gV (Or.inr (Or.inr (Or.inr rfl))) _
  obtain ⟨r9, o9, c9, l9, b9⟩ := NLogN.EX.fwdLP_all fw hfw hM hcfg s8
    (E8.updW fw hfw NLogN.GL.gD (Or.inl rfl) _) (NLogN.GL.exW q u v) R (by simp [hs8]) inW
  rw [hs8, NLogN.IState.upd_upd_same] at r9
  set Y := fwdL q (NLogN.GL.exW q u v) with hY
  set s9 := b8.upd NLogN.GL.gD (NLogN.gints Y ++ R) with hs9
  -- 10: round
  obtain ⟨r10, o10, c10⟩ := NLogN.GL.roundP_all M hM NLogN.GL.gPM (Or.inr rfl) ((q.S : ℤ) ^ 2) (NLogN.GL.exC q) q.p Q q.S
    s9 Y R LM LQ LC LP LR (by simp [hs9]) l9
    (by simp (config := {decide := true}) [hs9, hb8, hPM])
    (by simp (config := {decide := true}) [hs9, hb8, hPQ])
    (by simp (config := {decide := true}) [hs9, hb8, hPC])
    (by simp (config := {decide := true}) [hs9, hb8, hPP])
    (by simp (config := {decide := true}) [hs9, hb8, hPR]) (b9.mono hcfg.Bm) hS2 hBQ hSQ
  rw [hs9, NLogN.IState.upd_upd_same, ← NLogN.GL.exactConvL_eq] at r10
  -- assemble
  have A := NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ S1
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r2, o2, c2⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r3', o3, c3⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r4', o4, c4⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ S5
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r6, o6, c6⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r7', o7, c7⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r8', o8, c8⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r9, o9, c9⟩ ⟨r10, o10, c10⟩))))))))
  refine ⟨A.1, A.2.1, ?_⟩
  have hc := A.2.2
  have hsz : (NLogN.Ex.reg (S := NLogN.HS) NLogN.GL.gPM).size = 1 := rfl
  rw [hsz, hvl] at hc
  calc _ ≤ _ := hc
    _ ≤ _ := by nlinarith
end
