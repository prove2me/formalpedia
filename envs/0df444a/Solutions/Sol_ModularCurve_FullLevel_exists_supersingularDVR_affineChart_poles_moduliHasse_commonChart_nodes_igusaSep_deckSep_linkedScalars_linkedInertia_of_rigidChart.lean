    (nodes₀ : Finset (Subring K₀)) (nodes : Finset (Subring F₀))
    (hnodes : ∀ O : Subring F₀, O ∈ nodes ↔ ∃ O₀ ∈ nodes₀, ∀ y : F₀, y ∈ O ↔ φ.symm y ∈ O₀)
    (heqv₀ : ∀ γ : S, γ ∈ Γ → ∀ τ : E ≃ₐ[k] E, Att γ τ → ∀ O ∈ nodes₀, ∃ O' ∈ nodes₀,
