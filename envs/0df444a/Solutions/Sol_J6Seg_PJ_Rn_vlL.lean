theorem cfV_step (D : Cs) (f g : ℕ → ℤ) (k : ℕ) (L : List ℤ) :
    update (update (update (cfV D f g k) 50 L) SV (f k :: update (cfV D f g k) 50 L SV)) SC
      (g k :: update (cfV D f g k) 50 L SC) =
    update (cfV D f g (k + 1)) 50 L := by
  funext j
  simp only [cfV, List.range_succ, List.map_append, List.map_cons, List.map_nil,
    List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append, List.singleton_append]
  by_cases h1 : j = SC
  · subst h1; simp (disch := decide) only [update_self, update_of_ne]
  by_cases h2 : j = SV
  · subst h2; simp (disch := decide) only [update_self, update_of_ne]
  by_cases h3 : j = 50
  · subst h3; simp (disch := decide) only [update_self, update_of_ne]
  simp only [update_of_ne h1, update_of_ne h2, update_of_ne h3]

section loop
variable {Q W N : ℕ} {T : Tables} {B : Blocks} {D : Cs} {a c n s t α : ℕ}

/-- **The slot loop.** -/
theorem Rn.vlL_sol_aux {v : Vr} (hN : N ≤ 2 ^ W) (hW2 : 2 ≤ W) (hv : BV W v)
    (h1 : v 1 = c) (h2 : v 2 = n) (h11 : v 11 = n * (2 * B.w + 1)) (h20 : v 20 = Q) (h22 : v 22 = s)
    (h23 : v 23 = t) (h25 : v 25 = α) (h26 : v 26 = B.w) (h9 : v 9 = 2 ^ Q)
    (h10 : v 10 = 2 ^ (Q + 1))
    (hBs : B.s = s) (hs : 0 < s) (hBa : B.st a = c)
    (hBl : ∀ u < n, B.st (c + u) = c ∧ B.len (c + u) = n)
    (hnW : n * (2 * B.w + 1) < 2 ^ W) (hnN : n ≤ N) (hQW : Q ≤ W + 1)
    (hcpl : ∀ i h, T.cpl i h = HvdH.expNeg Q (s ^ 2) (α ^ 2 * (HvdH.eKz s t i h).toNat))
    (hMI : D SMI = ((List.range n).map (miV Q T B a)).reverse)
    (hSV : D SV = []) (hSC : D SC = []) (h50 : D 50 = [])
    (bMI : ∀ i < n, |miV Q T B a i| ≤ 2 ^ W)
    (bss : s * s ≤ 2 ^ W)
    (bX : ∀ u < n, ∀ j < 2 * B.w + 1, α ^ 2 * (HvdH.eKz s t ((c + u : ℕ) : ℤ)
      ((j : ℤ) - B.w)).toNat ≤ 2 ^ W)
    (bC : ∀ u < n, ∀ j < 2 * B.w + 1, |T.cpl (c + u) ((j : ℤ) - B.w)| ≤ 2 ^ W)
    (bV : ∀ y < n * (2 * B.w + 1), |gV Q T B a y| ≤ 2 ^ W) :
    Rn PJ.vlL v D (fun v' => Fxk [3, 4, 5, 8, 29] v v' ∧ BV W v')
      (cfV D (gV Q T B a) (gC B c) (n * (2 * B.w + 1)))
      (cFor W (n * (2 * B.w + 1)) (costL W N PJ.vlB)) := by
  have hm : 0 < 2 * B.w + 1 := by omega
  have hD : cfV D (gV Q T B a) (gC B c) 0 = D := by
    simp only [cfV, List.range_zero, List.map_nil, List.reverse_nil]
    rw [Function.update_eq_self_iff.2 (by rw [update_of_ne (by decide), hSC]),
      Function.update_eq_self_iff.2 hSV.symm]
  have H := Rn.forL (C := 50) (rN := 11) (ix := 3) (b := progL PJ.vlB) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := n * (2 * B.w + 1)) (W := W)
    (Iv := fun k u => Fxk [3, 4, 5, 8, 29] v u) (cf := cfV D (gV Q T B a) (gC B c))
    (cb := costL W N PJ.vlB)
    (fun k => by simp only [cfV]; rw [update_of_ne (by decide), update_of_ne (by decide), h50]) hnW
    (fun k hk u hfx hu3 hbu => by
      have g : ∀ j : Fin HS, j ∉ ([3, 4, 5, 8, 29] : List (Fin HS)) → u j = v j := hfx
      have hu : k / (2 * B.w + 1) < n := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hk)
      have hj : k % (2 * B.w + 1) < 2 * B.w + 1 := Nat.mod_lt _ hm
      have R := Rn.vlB (Q := Q) (W := W) (N := N) (T := T) (B := B)
        (D := update (cfV D (gV Q T B a) (gC B c) k) 50 [((n * (2 * B.w + 1) : ℕ) : ℤ) - k])
        (u := u) (a := a) (c := c) (n := n) (y := k) (s := s) (t := t) (α := α) hN hW2 hbu
        (by rw [g 1 (by decide), h1]) (by rw [g 2 (by decide), h2]) hu3
        (by rw [g 20 (by decide), h20]) (by rw [g 22 (by decide), h22])
        (by rw [g 23 (by decide), h23]) (by rw [g 25 (by decide), h25])
        (by rw [g 26 (by decide), h26]) (by rw [g 9 (by decide), h9]) (by rw [g 10 (by decide), h10])
        hBs hs hBa (hBl _ hu).1 (hBl _ hu).2 hk hnN hQW hcpl
        (by simp only [cfV]; rw [update_of_ne (by decide), update_of_ne (by decide),
          update_of_ne (by decide), hMI])
        bMI bss (bX _ hu _ hj) (bC _ hu _ hj) (bV k hk)
      rw [cfV_step] at R
      refine R.mono (fun v' ⟨fr, bv⟩ => ⟨fun j hj => ?_, ?_, bv⟩) le_rfl
      · have hj3 : j ≠ 3 := fun h => hj (by simp [h])
        rw [update_of_ne hj3, fr j (fun h => hj (by simp only [List.mem_cons] at h ⊢; tauto)),
          g j hj]
      · rw [fr 3 (by decide), hu3])
    hv h11 (fun j hj => by rw [update_of_ne (fun h => hj (by simp [h]))])
  rw [hD] at H
  exact H.mono (fun v' ⟨fr, _, bv⟩ => ⟨fr, bv⟩) le_rfl

end loop

