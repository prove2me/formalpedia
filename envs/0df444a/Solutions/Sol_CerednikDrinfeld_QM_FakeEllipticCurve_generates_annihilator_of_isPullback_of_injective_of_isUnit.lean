theorem solution
    {a b : ℚ} {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N m : ℕ)
    (R' L : Type) [CommRing R'] [IsNoetherianRing R'] [CommRing L] (φ : R' →+* L) (hφ : Function.Injective φ)
    (hm : IsUnit ((m : ℕ) : R'))
    (E' : FakeEllipticCurve Λ N R') (P' : SchemeHomOver (𝟙 (Spec (CommRingCat.of R'))) E'.f)
    (hP'tor : nsmulPt E'.L (𝟙 (Spec (CommRingCat.of R'))) m P' = E'.L.one (𝟙 (Spec (CommRingCat.of R'))))
    (E : FakeEllipticCurve Λ N L) (gL : E.A ⟶ E'.A)
    (hgL : CategoryTheory.IsPullback gL E.f E'.f (Spec.map (CommRingCat.ofHom φ)))
    (hmul : (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of L)) (P Q : SchemeHomOver t' E.f),
        (E.L.mul t' P Q).1 ≫ gL =
          (E'.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
            ⟨P.1 ≫ gL, by rw [Category.assoc, hgL.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ gL, by rw [Category.assoc, hgL.w, ← Category.assoc, Q.2]⟩).1))
    (hact : ∀ x : ↥Λ, E.act x ≫ gL = gL ≫ E'.act x)
    (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of L))) E.f) (hP : P.1 ≫ gL = Spec.map (CommRingCat.ofHom φ) ≫ P'.1)
    (hgen : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : L →+* k) (Q : SchemeHomOver (geomPoint k sk) E.f),
        nsmulPt E.L (geomPoint k sk) m Q = E.L.one (geomPoint k sk) →
          ∃ x : ↥Λ, pushPt (E.act x) (E.act_over x) (FakeEllipticCurve.sectionAt P k sk) = Q)
    (hann : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : L →+* k) (x : ↥Λ),
        pushPt (E.act x) (E.act_over x) (FakeEllipticCurve.sectionAt P k sk) = E.L.one (geomPoint k sk) ↔
          ∃ y : ↥Λ, (x : ℍ[ℚ, a, b]) = (m : ℚ) • (y : ℍ[ℚ, a, b])) :
    (∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k) (Q : SchemeHomOver (geomPoint k sk) E'.f),
        nsmulPt E'.L (geomPoint k sk) m Q = E'.L.one (geomPoint k sk) →
          ∃ x : ↥Λ, pushPt (E'.act x) (E'.act_over x) (FakeEllipticCurve.sectionAt P' k sk) = Q) ∧
    (∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k) (x : ↥Λ),
        pushPt (E'.act x) (E'.act_over x) (FakeEllipticCurve.sectionAt P' k sk) = E'.L.one (geomPoint k sk) ↔
          ∃ y : ↥Λ, (x : ℍ[ℚ, a, b]) = (m : ℚ) • (y : ℍ[ℚ, a, b])) := by
  classical

  have nsmulPt_eq : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R')) (n : ℕ) (Q : SchemeHomOver t E'.f),
      nsmulPt E'.L t n Q = E'.L.nsmul t n Q := by
    intro T t n Q
    induction n with
    | zero => rfl
    | succ n ih =>
      show E'.L.mul t (nsmulPt E'.L t n Q) Q = E'.L.mul t (E'.L.nsmul t n Q) Q
      rw [ih]

  obtain ⟨𝒢, h𝒢closed, h𝒢⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isClopen_genLocus_schemeKer hB Λ hΛ (N := N) m hm E'

  set e₀ : Spec (CommRingCat.of R') ⟶ E'.A := (E'.L.one (𝟙 (Spec (CommRingCat.of R')))).1 with he₀def
  have he₀ : e₀ ≫ E'.f = 𝟙 _ := (E'.L.one (𝟙 (Spec (CommRingCat.of R')))).2
  have w : P'.1 ≫ E'.L.schemeNsmul m = 𝟙 _ ≫ e₀ := by
    have hnat := E'.L.nsmul_natural E'.f (𝟙 _) P'.1 P'.2 m RelativeGroupLaw.idPoint
    have h1 : GoodReductionJacobian.schemeHomOverComp P'.1 P'.2 (RelativeGroupLaw.idPoint (f := E'.f)) = P' :=
      Subtype.ext (Category.comp_id _)
    rw [h1] at hnat
    rw [← nsmulPt_eq (𝟙 _) m P', hP'tor] at hnat
    have h2 := congrArg Subtype.val hnat
    rw [Category.id_comp]
    exact h2
  let κ' : Spec (CommRingCat.of R') ⟶ E'.L.schemeKer m := pullback.lift P'.1 (𝟙 _) w
  have hκ'fst : κ' ≫ pullback.fst _ _ = P'.1 := pullback.lift_fst _ _ _

  haveI : Mono e₀ := ⟨fun {Z} g h hgh => by
    have := congrArg (· ≫ E'.f) hgh
    simpa only [Category.assoc, he₀, Category.comp_id] using this⟩
  haveI : Mono (pullback.fst (E'.L.schemeNsmul m) e₀) := inferInstance

  set W : Set ↥(Spec (CommRingCat.of R')) := κ'.base ⁻¹' (𝒢 : Set ↥(E'.L.schemeKer m)) with hWdef
  have hW : IsClopen W := ⟨h𝒢closed.preimage κ'.base.hom.continuous, 𝒢.isOpen.preimage κ'.base.hom.continuous⟩

  have tors : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k),
      nsmulPt E'.L (geomPoint k sk) m (FakeEllipticCurve.sectionAt P' k sk) = E'.L.one (geomPoint k sk) := by
    intro k _ _ sk
    rw [nsmulPt_eq]
    change E'.L.nsmul (geomPoint k sk) m (GoodReductionJacobian.schemeHomOverComp (geomPoint k sk) (Category.comp_id _) P') = _
    rw [← E'.L.nsmul_natural, ← nsmulPt_eq, hP'tor, E'.L.one_natural]
  have key : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k),
      (∀ p : ↥(Spec (CommRingCat.of k)), κ'.base ((geomPoint k sk).base p) ∈ (𝒢 : Set ↥(E'.L.schemeKer m))) ↔
      ((∀ Q : SchemeHomOver (geomPoint k sk) E'.f,
          nsmulPt E'.L (geomPoint k sk) m Q = E'.L.one (geomPoint k sk) →
            ∃ x : ↥Λ, pushPt (E'.act x) (E'.act_over x) (FakeEllipticCurve.sectionAt P' k sk) = Q) ∧
       (∀ x : ↥Λ, pushPt (E'.act x) (E'.act_over x) (FakeEllipticCurve.sectionAt P' k sk) = E'.L.one (geomPoint k sk) ↔
          ∃ y : ↥Λ, (x : ℍ[ℚ, a, b]) = (m : ℚ) • (y : ℍ[ℚ, a, b]))) := by
    intro k _ _ sk
    rw [← h𝒢 k sk (FakeEllipticCurve.sectionAt P' k sk) (tors k sk)]
    constructor
    · intro hp
      refine ⟨geomPoint k sk ≫ κ', ?_, ?_⟩
      · rw [Category.assoc, hκ'fst]; rfl
      · rintro _ ⟨p, rfl⟩; exact hp p
    · rintro ⟨κ, hκ, hr⟩ p
      have hκeq : κ = geomPoint k sk ≫ κ' := by
        apply (cancel_mono (pullback.fst (E'.L.schemeNsmul m) e₀)).1
        rw [hκ, Category.assoc, hκ'fst]; rfl
      subst hκeq
      exact hr ⟨p, rfl⟩

  have hWL : Set.range (Spec.map (CommRingCat.ofHom φ)).base ⊆ W := by
    rintro _ ⟨x, rfl⟩
    let κx : Type := x.asIdeal.ResidueField
    let k : Type := AlgebraicClosure κx
    let sk : L →+* k := (algebraMap κx k).comp (algebraMap L κx)
    have hpt : ∀ q : ↥(Spec (CommRingCat.of k)), (Spec.map (CommRingCat.ofHom sk)).base q = x := by
      intro q
      apply PrimeSpectrum.ext
      change ((Spec.map (CommRingCat.ofHom sk)) q).asIdeal = x.asIdeal
      rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, CommRingCat.hom_ofHom]
      have hq : q.asIdeal = ⊥ := by
        haveI := q.isPrime
        exact Ideal.eq_bot_of_prime q.asIdeal
      rw [hq, ← RingHom.ker_eq_comap_bot, show RingHom.ker sk = RingHom.ker (algebraMap L κx) from
        RingHom.ker_comp_of_injective _ (algebraMap κx k).injective, Ideal.ker_algebraMap_residueField]
    have hlev := (CerednikDrinfeld.QM.FakeEllipticCurve.generates_annihilator_iff_of_isPullback Λ N m R' L φ E' P' E gL hgL
      hmul hact P hP k sk).1 ⟨hgen k sk, hann k sk⟩
    have hin := (key k (sk.comp φ)).2 hlev default
    have hgeom : (geomPoint k (sk.comp φ)).base default = (Spec.map (CommRingCat.ofHom φ)).base x := by
      have hfac : geomPoint k (sk.comp φ) = Spec.map (CommRingCat.ofHom sk) ≫ Spec.map (CommRingCat.ofHom φ) := by
        change Spec.map (CommRingCat.ofHom (sk.comp φ)) = _
        rw [CommRingCat.ofHom_comp, Spec.map_comp]
      rw [hfac]
      change (Spec.map (CommRingCat.ofHom φ)).base ((Spec.map (CommRingCat.ofHom sk)).base default) = _
      rw [hpt]
    show κ'.base ((Spec.map (CommRingCat.ofHom φ)).base x) ∈ (𝒢 : Set ↥(E'.L.schemeKer m))
    rw [← hgeom]; exact hin

  have hWu : W = Set.univ :=
    AlgebraicGeometry.eq_univ_of_isClopen_of_range_specMap_subset_of_injective φ hφ W hW hWL
  have hall : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k), ∀ p : ↥(Spec (CommRingCat.of k)),
      κ'.base ((geomPoint k sk).base p) ∈ (𝒢 : Set ↥(E'.L.schemeKer m)) := by
    intro k _ _ sk p
    have : (geomPoint k sk).base p ∈ W := by rw [hWu]; trivial
    exact this
  exact ⟨fun k _ _ sk => ((key k sk).1 (hall k sk)).1, fun k _ _ sk => ((key k sk).1 (hall k sk)).2⟩

end S_CerednikDrinfeld_QM_FakeEllipticCurve_generates_annihilator_of_isPullback_of_injective_of_isUnit
