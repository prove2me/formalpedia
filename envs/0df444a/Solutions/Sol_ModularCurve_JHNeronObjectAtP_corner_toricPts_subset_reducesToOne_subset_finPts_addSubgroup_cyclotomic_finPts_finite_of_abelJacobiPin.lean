    (∀ x : J, (x ∈ C ∧
          (∃ w : G.Point L 1,
            Δ (G.pointsMkAdd L 1 (Additive.ofMul w)) = x ∧
            ∀ b : G.level 1, Pl.valuation (PDivisibleGroup.Point.toAlgHom w b -
              algebraMap R L (Coalgebra.counit b)) < 1)) → (x ∈ C ∧ x ∈ F q)) ∧
    ((0 : J) ∈ C ∧
          (∃ w : G.Point L 1,
            Δ (G.pointsMkAdd L 1 (Additive.ofMul w)) = (0 : J) ∧
            ∀ b : G.level 1, Pl.valuation (PDivisibleGroup.Point.toAlgHom w b -
              algebraMap R L (Coalgebra.counit b)) < 1)) ∧
