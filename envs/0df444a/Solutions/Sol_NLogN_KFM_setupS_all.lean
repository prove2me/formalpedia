theorem filter_Icc_eq (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    (Finset.Icc 1 N).filter P = Finset.Icc 1 (Nat.findGreatest P N) := by
  ext x
  simp only [Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    exact ⟨h1, Nat.le_findGreatest h2 h3⟩
  · rintro ⟨h1, h2⟩
    have hle : Nat.findGreatest P N ≤ N := Nat.findGreatest_le N
    have hpos : 0 < Nat.findGreatest P N := by omega
    have hP : P (Nat.findGreatest P N) := Nat.findGreatest_of_ne_zero rfl (by omega)
    exact ⟨⟨h1, by omega⟩, hdc x _ h1 h2 hP⟩

theorem count_eq_findGreatest (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    ∑ x ∈ Finset.Icc 1 N, (if P x then (1 : ℤ) else 0) = (Nat.findGreatest P N : ℤ) := by
  rw [← Finset.sum_filter, filter_Icc_eq P N hdc]
  simp

/-- The count of `x ∈ [1, v]` with `x^{2^m} ≤ v` is the integer `2^m`-th root. -/
theorem count_root_spec (m v : ℕ) (hv : 1 ≤ v) :
    (Nat.findGreatest (fun x => x ^ (2 ^ m) ≤ v) v) ^ (2 ^ m) ≤ v ∧
      v < (Nat.findGreatest (fun x => x ^ (2 ^ m) ≤ v) v + 1) ^ (2 ^ m) := by
  set c := Nat.findGreatest (fun x => x ^ (2 ^ m) ≤ v) v with hc
  have hm : 1 ≤ 2 ^ m := Nat.one_le_two_pow
  have h1 : 1 ^ (2 ^ m) ≤ v := by simpa using hv
  have hcpos : 1 ≤ c := Nat.le_findGreatest hv h1
  have hcle : c ≤ v := Nat.findGreatest_le v
  refine ⟨Nat.findGreatest_spec (P := fun x => x ^ (2 ^ m) ≤ v) hcle (by
    have := Nat.findGreatest_spec (P := fun x => x ^ (2 ^ m) ≤ v) (m := 1) hv h1; exact this), ?_⟩
  by_cases hcv : c + 1 ≤ v
  · have := Nat.findGreatest_is_greatest (P := fun x => x ^ (2 ^ m) ≤ v) (k := c + 1) (by omega) hcv
    simpa using this
  · have : c = v := by omega
    rw [this]
    calc v < v + 1 := by omega
      _ = (v + 1) ^ 1 := by ring
      _ ≤ (v + 1) ^ (2 ^ m) := Nat.pow_le_pow_right (by omega) hm

end NLogN.KFM

