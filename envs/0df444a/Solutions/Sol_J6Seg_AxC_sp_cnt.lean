section steps
variable {s : IState HS}

theorem sp_pushR (f : Fin HS → List ℤ) {i j : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hi : i.val < 56) (hj : j.val < 56) (hf : f j = a :: l) (ha : zsz a ≤ B) :
    Sp (.push i (.reg j)) (encK s f) (encK s (Function.update f i (a :: f i))) (4000 * (B + 2)) := by
  have h := Sp.push s f (i := i) (e := .reg j) (B := B) hi (clean_reg hj) (ok_reg hf) trivial
    (bnd_reg hf ha)
  rw [eval_reg hf] at h
  exact h.mono (by simp only [Ex.size]; omega)

theorem sp_pop (f : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hi : i.val < 56) (hf : f i = a :: l) (ha : zsz a ≤ B) :
    Sp (.pop i) (encK s f) (encK s (Function.update f i l)) (2 * B + 2) := Sp.pop s f hi hf ha

end steps

