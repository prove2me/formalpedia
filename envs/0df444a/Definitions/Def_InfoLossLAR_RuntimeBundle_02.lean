/-! Actual width-index enumeration and slice averaging for the native profile
kernel. The width is supplied by a real unary buffer, never expanded from an
arbitrary binary number. The signed endpoints and every term use actual TM2
integer/rational programs. -/
namespace Integration9_9.TM2NativeAveragedSlice
open AFT AFT.RationalNumerics AFT.BinaryArithmetic AFT.V7Calibration
open OAI.MetricKMedian.Binary OAI.MetricKMedian.Binary.Automatic
open TM2NativeFiniteSeries TM2NativeSliceProbability
open scoped BigOperators

abbrev Request := (ℤ×ℤ)×((ℤ×ℤ)×(List Unit×ℤ))
abbrev requestCode : _root_.Integration9_9.TM2NativeAveragedSlice.Request → List Bool := Automatic.enc

def term (x : _root_.Integration9_9.TM2NativeAveragedSlice.Request×ℕ) : ℚ :=
  let shift := x.1.2.1.1+(x.2 : ℤ)
