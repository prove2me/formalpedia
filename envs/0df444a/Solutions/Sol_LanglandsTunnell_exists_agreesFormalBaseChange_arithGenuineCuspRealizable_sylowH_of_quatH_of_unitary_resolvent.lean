          (fun N =>
            NumberField.AdelicLevel.levelOne
                (NumberField.RingOfIntegers ↥(LanglandsTunnell.fixFld (LanglandsTunnell.sylowH e)))
                ↥(LanglandsTunnell.fixFld (LanglandsTunnell.sylowH e)) N ⊓
