/-- `NF d s ≤ C · X^9` when `d, s + 1 ≤ X`. -/
theorem NF_le_X {d s X : ℕ} (hX : 1 ≤ X) (hd : d ≤ X) (hs : s + 1 ≤ X) :
    NF d s ≤ CN * X ^ 9 := by
  have hX2 : 1 ≤ X ^ 2 := Nat.one_le_pow _ _ hX
  have hsq : Nat.sqrt d ≤ X := (Nat.sqrt_le_self d).trans hd
  have hL : lamF d ≤ 2 * X ^ 2 := by
    unfold lamF kF
    calc d * (Nat.sqrt d + 1) ≤ X * (X + 1) := Nat.mul_le_mul hd (by omega)
      _ ≤ 2 * X ^ 2 := by nlinarith
  have hL1 : lamF d + 1 ≤ 3 * X ^ 2 := by omega
  have hA : (lamF d + 1) * (3 * lamF d + 3) + 1 ≤ 28 * X ^ 4 := by
    have e : (lamF d + 1) * (3 * lamF d + 3) = 3 * (lamF d + 1) ^ 2 := by ring
    have h2 : (lamF d + 1) ^ 2 ≤ (3 * X ^ 2) ^ 2 := Nat.pow_le_pow_left hL1 2
    have h4 : 1 ≤ X ^ 4 := Nat.one_le_pow _ _ hX
    have e2 : (3 * X ^ 2) ^ 2 = 9 * X ^ 4 := by ring
    omega
  have hw : 2 * wF d + 1 ≤ 29 * X := by unfold wF kF; omega
  have hs2 : (s + 1) ^ 2 ≤ 4 * X ^ 2 := by
    have := Nat.pow_le_pow_left hs 2; omega
  unfold NF
  calc 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      ≤ 1500 * (28 * X ^ 4) * (3 * X ^ 2) * (29 * X) * (4 * X ^ 2) := by gcongr
    _ = CN * X ^ 9 := by unfold CN; ring

/-- The whole set-up product, as a polynomial in `p, t, b`. -/
theorem slab_poly_sol_aux {K d s p t α b : ℕ} (hp : 1 ≤ p) (ht : 1 ≤ t) (hb : 1 ≤ b) (hd : d ≤ p)
    (hs : s ≤ t) (hα : α ^ 2 ≤ p) :
    K * (NF d s + p + t + 1) *
        (J6Seg.Src.uC (4 * p) J6Seg.Src.DD + J6Seg.Src.ePC (4 * p) p α +
          NLogN.KFUU.cU (4 * p + 1) + 20000) + 2 ≤
      ((K * (CN + 1) * CUt + 2) * 3 ^ 19) * b ^ 20 * t ^ 20 * p ^ 20 := by
  obtain ⟨X, hXd⟩ : ∃ X, X = p + t + 1 := ⟨_, rfl⟩
  have hX : 1 ≤ X := by omega
  have hN := NF_le_X (d := d) (s := s) hX (by omega) (by omega)
  have hU := Ut_le_X (α := α) hX (show p ≤ X by omega) hα
  generalize J6Seg.Src.uC (4 * p) J6Seg.Src.DD + J6Seg.Src.ePC (4 * p) p α +
    NLogN.KFUU.cU (4 * p + 1) + 20000 = U at hU ⊢
  have hX9 : 1 ≤ X ^ 9 := Nat.one_le_pow _ _ hX
  have hN' : NF d s + p + t + 1 ≤ (CN + 1) * X ^ 9 := by
    have : X ≤ X ^ 9 := by
      calc X = X ^ 1 := (pow_one X).symm
        _ ≤ X ^ 9 := Nat.pow_le_pow_right hX (by norm_num)
    have e : (CN + 1) * X ^ 9 = CN * X ^ 9 + X ^ 9 := by
      ring
    omega
  have hX19 : 1 ≤ X ^ 19 := Nat.one_le_pow _ _ hX
  have hprod : K * (NF d s + p + t + 1) * U + 2 ≤
      (K * (CN + 1) * CUt + 2) * X ^ 19 := by
    have m : K * (NF d s + p + t + 1) * U ≤
        K * ((CN + 1) * X ^ 9) * (CUt * X ^ 10) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left _ hN') hU
    have e : K * ((CN + 1) * X ^ 9) * (CUt * X ^ 10) =
        K * (CN + 1) * CUt * X ^ 19 := by ring
    have e2 : (K * (CN + 1) * CUt + 2) * X ^ 19 =
        K * (CN + 1) * CUt * X ^ 19 + 2 * X ^ 19 := by ring
    rw [e2, ← e]
    exact Nat.add_le_add m (by
      calc 2 = 2 * 1 := rfl
        _ ≤ 2 * X ^ 19 := Nat.mul_le_mul_left _ hX19)
  have hX3 : X ≤ 3 * (t * p) := by
    have : 1 ≤ t * p := Nat.one_le_iff_ne_zero.mpr (by positivity)
    have h1 : p ≤ t * p := Nat.le_mul_of_pos_left _ ht
    have h2 : t ≤ t * p := Nat.le_mul_of_pos_right _ hp
    omega
  have hpow : X ^ 19 ≤ 3 ^ 19 * b ^ 20 * t ^ 20 * p ^ 20 := by
    have h1 := Nat.pow_le_pow_left hX3 19
    have hb20 : 1 ≤ b ^ 20 := Nat.one_le_pow _ _ hb
    have htp : 1 ≤ t * p := Nat.one_le_iff_ne_zero.mpr (by positivity)
    have h2 : (t * p) ^ 19 ≤ (t * p) ^ 20 := Nat.pow_le_pow_right htp (by norm_num)
    calc X ^ 19 ≤ (3 * (t * p)) ^ 19 := h1
      _ = 3 ^ 19 * (t * p) ^ 19 := by ring
      _ ≤ 3 ^ 19 * (t * p) ^ 20 := Nat.mul_le_mul_left _ h2
      _ = 3 ^ 19 * 1 * (t * p) ^ 20 := by ring
      _ ≤ 3 ^ 19 * b ^ 20 * (t * p) ^ 20 := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hb20)
      _ = 3 ^ 19 * b ^ 20 * t ^ 20 * p ^ 20 := by ring
  calc _ ≤ (K * (CN + 1) * CUt + 2) * X ^ 19 := hprod
    _ ≤ (K * (CN + 1) * CUt + 2) * (3 ^ 19 * b ^ 20 * t ^ 20 * p ^ 20) :=
        Nat.mul_le_mul_left _ hpow
    _ = ((K * (CN + 1) * CUt + 2) * 3 ^ 19) * b ^ 20 * t ^ 20 * p ^ 20 := by
        simp only [mul_assoc]

end J6Seg.Side
