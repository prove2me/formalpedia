theorem solution (R : Type) [CommRing R] (t x : R)
    (hreg : TypeDensity.RegularParameterPair R t x) (beta : TypeDensity.BlowupRestriction R t x)
    (hregSwap : TypeDensity.RegularParameterPair R x t) (d n : ℕ) (hn : n ≤ d)
    (h : TypeDensity.cechInputLattice R t x n ≤ (TypeDensity.cechOutputLattice R t x n).comap
      (TypeDensity.fullCechDifferential R t x beta d)) :
    Function.Injective (TypeDensity.finiteCechDifferential R t x beta d n h) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  induction z using Submodule.Quotient.induction_on with
  | H z =>
    obtain ⟨a, b⟩ := z
    rw [TypeDensity.finiteCechDifferential, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at hz
    rw [Submodule.Quotient.mk_eq_zero]
    have hz' : TypeDensity.fullCechDifferential R t x beta d (a, b) ∈
        (Ideal.span {algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)
          (TypeDensity.chartBase R t x t)})^n := hz
    have main (j : ℕ) (hj : j ≤ n) : a ∈ (Ideal.span {TypeDensity.chartBase R t x t})^j ∧
        b ∈ (Ideal.span {TypeDensity.chartBase R x t x})^j := by
      induction j with
      | zero => simp
      | succ j ih =>
        obtain ⟨ha, hb⟩ := ih (by omega)
        exact TypeDensity.cech_kernel_step R t x hreg beta hregSwap d j (by omega) a b ha hb
          (Ideal.pow_le_pow_right (by omega) hz')
    exact main n le_rfl
