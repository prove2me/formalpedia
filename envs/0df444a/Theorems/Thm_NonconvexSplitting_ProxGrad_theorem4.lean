-- title:
--   Theorem 4: proximal gradient descends and its cluster points are stationary for $\beta < 1/\ell$
-- statement:
--   Consider $\min_x h(x) + P(x)$ on $\mathbb{R}^n$, where $h$ is twice continuously differentiable with a bounded Hessian and $P : \mathbb{R}^n \to (-\infty, +\infty]$ is proper and closed with well-defined proximal mappings.
--
--   Suppose there exist a twice continuously differentiable convex function $q$ and $\ell > 0$ such that for all $x$
--   $$
--   -\ell I \preceq \nabla^2 h(x) + \nabla^2 q(x) \preceq \ell I . \qquad (44)
--   $$
--   Let $(x^t)$ be generated by the proximal gradient update
--   $$
--   x^{t+1} \in \operatorname*{Arg\,min}_x \Bigl\{ \langle \nabla h(x^t), x - x^t\rangle + \frac{1}{2\beta}\|x - x^t\|^2 + P(x) \Bigr\} \qquad (43)
--   $$
--   with $\beta \in (0, 1/\ell)$. Then:
--
--   1. the algorithm is a descent algorithm: $h(x^{t+1}) + P(x^{t+1}) \le h(x^t) + P(x^t)$ for every $t \ge 0$;
--   2. every cluster point $x^*$ of $(x^t)$, if one exists, is a stationary point: $0 \in \nabla h(x^*) + \partial P(x^*)$, with $\partial$ the limiting subdifferential.
--
--   The constant $\ell$ bounds the curvature of $h$ only after its concave part is offset by the convex $q$, so it may be smaller than the Lipschitz modulus of $\nabla h$; the result then permits step sizes beyond the classical range $(0, 1/L)$.
--
--   **Formalization Note** Objective values are compared in `EReal`. A cluster point is a limit of $x^{\varphi(i)}$ for a strictly increasing $\varphi$. The start $x^0$ is arbitrary, and no boundedness of the sequence is assumed.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 18, Theorem 4

import Mathlib
import Definitions.Def_NonconvexSplitting_ProxGrad_StandingAssumptions
import Definitions.Def_NonconvexSplitting_ProxGrad_HessianSandwich
import Definitions.Def_NonconvexSplitting_ProxGrad_IsProxGradSeq
import Definitions.Def_NonconvexSplitting_ProxGrad_IsStationary
open NonconvexSplitting.Shared

open Filter Topology

namespace NonconvexSplitting.ProxGrad

/-- Theorem 4 of Li–Pong (p. 18). Suppose `q` is twice continuously differentiable and convex,
`ℓ > 0`, and `-ℓ I ⪯ ∇²h(x) + ∇²q(x) ⪯ ℓ I` for all `x` (44). Let `{x^t}` be generated by (43)
with `β ∈ (0, 1/ℓ)`. Then the algorithm is a descent algorithm, and every cluster point of
`{x^t}` (if one exists) is a stationary point. -/
theorem theorem4 {n : ℕ} (h q : EuclideanSpace ℝ (Fin n) → ℝ) (P : EuclideanSpace ℝ (Fin n) → EReal) (ℓ β : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n))
    (hSA : StandingAssumptions h P) (hq : ContDiff ℝ 2 q) (hq_convex : ConvexOn ℝ Set.univ q)
    (hℓ : 0 < ℓ) (h44 : HessianSandwich h q ℓ) (hβ : 0 < β)
    (hβℓ : β < 1 / ℓ) (hx : IsProxGradSeq h P β x) :
    (∀ t, ((h (x (t + 1)) : ℝ) : EReal) + P (x (t + 1)) ≤ ((h (x t) : ℝ) : EReal) + P (x t)) ∧
    ∀ xs : EuclideanSpace ℝ (Fin n),
      (∃ φ : ℕ → ℕ, StrictMono φ ∧ Tendsto (x ∘ φ) atTop (𝓝 xs)) → IsStationary h P xs := by sorry

end NonconvexSplitting.ProxGrad
