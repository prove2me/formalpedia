-- title:
--   Theorem 1 (second claim): $\lim_{i\to\infty}\mu_L(x_i) = 0$
-- statement:
--   Let $F \subseteq \mathbb{R}^n$ be a closed convex set with nonempty interior, and let $f$ be twice differentiable on $F$, with gradient $f'(x)$ and Hessian $f''(x)$. Assume the Hessian is Lipschitz continuous on $F$ in the spectral norm (Assumption 1): for some $L > 0$,
--   $$\|f''(x) - f''(y)\| \le L\,\|x - y\| \qquad \text{for all } x, y \in F.$$
--
--   Let $x_0 \in \operatorname{int} F$ be a starting point such that $F$ contains the level set $\mathcal{L}(f(x_0)) = \{x \in \mathbb{R}^n : f(x) \le f(x_0)\}$ in its interior.
--
--   Let $0 < L_0 \le L$ and let $\{x_k\}_{k \ge 0}$ be generated by the **cubic regularization of Newton method** (3.3): $x_0$ is the starting point and, at every iteration $k \ge 0$, a parameter $M_k \in [L_0, 2L]$ is chosen such that $f(T_{M_k}(x_k)) \le \bar f_{M_k}(x_k)$, and $x_{k+1} = T_{M_k}(x_k)$. Here $T_M(x)$ is any global minimizer of the cubic model $y \mapsto \langle f'(x), y - x\rangle + \tfrac12\langle f''(x)(y - x), y - x\rangle + \tfrac{M}{6}\|y - x\|^3$ and $\bar f_M(x) = f(x) + \min_y(\text{cubic model})$. Assume $f$ is bounded below on $F$: $f(x) \ge f^*$ for all $x \in F$.
--
--   For $M > 0$ the second-order optimality measure of Section 3 is
--   $$\mu_M(x) = \max\Big\{ \sqrt{\tfrac{2}{L + M}\,\|f'(x)\|},\ -\tfrac{2}{2L + M}\,\lambda_n(f''(x)) \Big\},$$
--   where $\lambda_n$ denotes the smallest eigenvalue. Then
--   $$\lim_{i \to \infty} \mu_L(x_i) = 0 .$$
--   Every limit point of the iterates therefore satisfies the second-order necessary conditions $f'(x^*) = 0$, $f''(x^*) \succeq 0$, whenever these quantities are continuous there.
--
--   **Formalization Note** The space is `EuclideanSpace ℝ (Fin n)`. The gradient and Hessian are given as maps `g` and `H` with `HasGradientAt f (g x) x` and `HasFDerivAt g (H x) x` at every `x ∈ F` (two-sided derivatives, also at boundary points of $F$); the operator norm on `H x` is the spectral norm. A run is the predicate `IsCubicNewtonRun` on the sequences `x : ℕ → E` and `M : ℕ → ℝ`, 0-based as in the paper, with $\bar f_{M_k}(x_k)$ written as `f (x k) + cubicModel g H (M k) (x k) (x (k+1))`, which equals the minimum because $x_{k+1}$ attains it. The level-set hypothesis is written `{x | f x ≤ f x₀} ⊆ interior F`, for $f$ defined on all of $\mathbb{R}^n$ as in problem (3.1). $\lambda_n$ is `lamMin`, the Rayleigh-quotient infimum over the unit sphere (for $n = 0$ it is $0$).
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, DOI 10.1007/s10107-006-0706-8, p. 185, Theorem 1 (second claim)

import Mathlib
import Definitions.Def_CubicNewton_Shared_IsCubicNewtonRun
import Definitions.Def_CubicNewton_Nonconvex_muMeasure

open scoped RealInnerProductSpace

namespace CubicNewton.Nonconvex

/-- Nesterov–Polyak 2006, Theorem 1 (second claim), p. 185: along every run of method (3.3),
`lim_{i→∞} μ_L(x_i) = 0`. -/
theorem run_mu_tendsto_zero {n : ℕ}
    (F : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L : ℝ)
    (hF_closed : IsClosed F) (hF_convex : Convex ℝ F)
    (hf : ∀ x ∈ F, HasGradientAt f (g x) x) (hg : ∀ x ∈ F, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x ∈ F, ∀ y ∈ F, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (x₀ : EuclideanSpace ℝ (Fin n)) (hx₀ : x₀ ∈ interior F)
    (hlevel : {x | f x ≤ f x₀} ⊆ interior F)
    (L₀ : ℝ) (hL₀ : 0 < L₀) (hL₀L : L₀ ≤ L)
    (fstar : ℝ) (hfstar : ∀ y ∈ F, fstar ≤ f y)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ) (hrun : CubicNewton.Shared.IsCubicNewtonRun f g H L₀ L x₀ x M) :
    Filter.Tendsto (fun i => muMeasure L L g H (x i)) Filter.atTop (nhds 0) := by sorry

end CubicNewton.Nonconvex
