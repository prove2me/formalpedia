-- title:
--   Completed right-continuous natural Poisson filtration
-- statement:
--   The minimal completed, right-continuous filtration generated by past Poisson count evaluations.
-- source:
--   A. E. Kyprianou (2006), Chapter 2, pp. 33–66

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal
set_option autoImplicit false

namespace Kyprianou.Ch02

/-- The smallest completed right-continuous filtration making every past
Poisson random measure count measurable.  The last clause is its minimality
among filtrations with the first three properties. -/
def IsCompletedPoissonFiltration
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (levyMeasure : Measure ℝ)
    [SigmaFinite levyMeasure]
    (N : LevyStochCalc.Poisson.PoissonRandomMeasure.{0, 0, 0} P levyMeasure)
    (ℱ : Filtration ℝ≥0 (inferInstance : MeasurableSpace Ω)) : Prop :=
  (∀ t u : ℝ≥0, u ≤ t →
    ∀ A : Set ℝ, MeasurableSet A →
      @Measurable Ω ℝ≥0∞ (ℱ t) inferInstance
        (fun ω => N.N ω (Set.Ioc (0 : ℝ) (u : ℝ) ×ˢ A))) ∧
  (∀ t (S : Set Ω), MeasurableSet S → P S = 0 → @MeasurableSet Ω (ℱ t) S) ∧
  ℱ.IsRightContinuous ∧
  ∀ (G : Filtration ℝ≥0 (inferInstance : MeasurableSpace Ω)),
    (∀ t u : ℝ≥0, u ≤ t →
      ∀ A : Set ℝ, MeasurableSet A →
        @Measurable Ω ℝ≥0∞ (G t) inferInstance
          (fun ω => N.N ω (Set.Ioc (0 : ℝ) (u : ℝ) ×ˢ A))) →
    (∀ t (S : Set Ω), MeasurableSet S → P S = 0 → @MeasurableSet Ω (G t) S) →
    G.IsRightContinuous → ℱ ≤ G

end Kyprianou.Ch02


