-- Source module: Solutions.J6AILTab0
/-!
# A lines, table set-up, part 0: the contract `PreA6`

The kernel pass of the `A` lines (`pipeAL`, `J6AIL6`) is

    kerPass (8H) post (pre · nc) (fun b => gK p s t α H (8H) (b % nc)),   nc = t/(16H) · 8,

run through `kerW` with the register file `kerRegs` (`J6SegPreIface`). The table of block `q`,
read by `J6Seg.KR.AK.aKprog` on `dT = 49`, is

    aTab6 … q = aKTab2 (2W) (2H) (8H) (QA p) pk b (aTabA … q) (rTabA … q) (cTabA … q)

(`H = 2^⌊log₂ m⌋`, `m = sWidth p α`, `W = H + m + 3`). **`PreA6`** asks, as `PreU6` does
for the `B` lines, for a set-up / tear-down pair of procedures building the register file
`aRegs6` on any admissible registers `ρ` from the axis descriptor `descAx6` on any admissible
stack `dA`, at cost `Cp · cU6 P n A / (D + 1)`. (Internally the file is built on the fixed
registers `ρA` and the descriptor stack `31`.)
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function IntMul.HvdH

/-- `H = 2^⌊log₂ m⌋`, `m = sWidth p α` (`= J6A.PA.HH`, `= HA6`). -/
def HAx (p α : ℕ) : ℕ := 2 ^ Nat.log 2 (sWidth p α)

/-- The number of blocks per line, `t / (16 H) · 8`. -/
def ncA (p t α : ℕ) : ℕ := t / (16 * HAx p α) * 8

/-- **The table of block `q`** (read by `aKprog` on `dT = 49`). -/
def aTab6 (p s t α pk b : ℕ) (q : ℕ) : List ℤ :=
  KR.AK.aKTab2 (2 * J6A.WA p α (HAx p α)) (2 * HAx p α) (8 * HAx p α) (J6A.QA p) pk b
    (J6A.aTabA p s t α (HAx p α) q) (J6A.rTabA p s t α (HAx p α) q)
    (J6A.cTabA p s t α (HAx p α) q)

/-- The plan precisions, affine in `p`. -/
def pkA6 (pkA pkC p : ℕ) : ℕ := pkA * p + pkC
def bA6 (bA bC p : ℕ) : ℕ := bA * p + bC

/-- **The register file of the `A` kernel pass** of axis `k`. -/
def aRegs6 (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k pk b : ℕ) : Fin 19 → List ℤ :=
  let p := pP6 P n; let s := src k; let t := tF6 P n k; let α := αN6 P n
  kerRegs (p + 2) (pk + 1) (Nat.log 2 (sWidth p α) + 3) (preT P n D k) (ncA p t α)
    (postT P n D k) (tabsT (aTab6 p s t α pk b) (ncA p t α))

/-- **`PreA6` (A-line table set-up).** For every admissible register map `ρ` and descriptor
stack `dA` (as `PreU6`, also avoiding the table stack `49`) there is a family of procedures,
uniform in the table, with a set-up / tear-down pair `(eA, eAd)` for the `A` kernel pass of
axis `k`, reading only the descriptor `descAx6 P n src D k` on `dA`, each at cost
`Cp · cU6 P n A / (D + 1)`. -/
def PreA6 (P : Prm) (pkA pkC bA bC : ℕ) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∀ (ρ : Fin 19 → Fin HS) (dA : Fin HS), Injective ρ → (∀ i, ρ i ≠ dA) → (∀ i, ρ i ≠ 0) →
    (∀ i, ρ i ≠ 49) → dA ≠ 0 → dA ≠ 49 → (∀ i, (ρ i).val < 56) → dA.val < 56 →
  ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (eA eAd : Fin nU) (Cp : ℝ) (A n₁ : ℕ), 0 ≤ Cp ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
  ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
    (∀ i, IL.kTableP tab ext (idx i) = U E idx i) →
    ∀ Isym : List Sym,
      SetupBody6 Isym (IL.kTableP tab ext) (idx eA) (idx eAd) ρ dA (descAx6 P n src D k)
        (aRegs6 P n src D k (pkA6 pkA pkC (pP6 P n)) (bA6 bA bC (pP6 P n)))
        (Cp * cU6 P n A / (D + 1))

end J6Seg

end

end

