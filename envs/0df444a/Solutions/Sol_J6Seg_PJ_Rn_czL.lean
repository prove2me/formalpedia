set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-! ## Row-major matrices -/

theorem matL_getD (f : ℕ → ℕ → ℤ) {m x : ℕ} (hx : x < m * m) :
    (matL f m).getD x 0 = f (x / m) (x % m) := by
  rw [List.getD_eq_getElem _ _ (by simpa using hx)]; simp [matL]

theorem idx_lt {m i k : ℕ} (hi : i < m) (hk : k < m) : i * m + k < m * m := by
  have : (i + 1) * m ≤ m * m := Nat.mul_le_mul_right _ hi
  nlinarith

theorem matL_get2 (f : ℕ → ℕ → ℤ) {m i k : ℕ} (hi : i < m) (hk : k < m) :
    (matL f m).getD (i * m + k) 0 = f i k := by
  rw [matL_getD f (idx_lt hi hk)]
  have hm : 0 < m := by omega
  congr 1
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt hk]; simp
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hk]

theorem matL_mem_bnd {f : ℕ → ℕ → ℤ} {m : ℕ} {V : ℤ} (h : ∀ i < m, ∀ k < m, |f i k| ≤ V) :
    ∀ x ∈ matL f m, |x| ≤ V := by
  intro y hy
  simp only [matL, List.mem_map, List.mem_range] at hy
  obtain ⟨x, hx, rfl⟩ := hy
  have hm : 0 < m := by rcases Nat.eq_zero_or_pos m with h | h <;> simp_all
  exact h _ (Nat.div_lt_of_lt_mul hx) _ (Nat.mod_lt _ hm)

/-! ## Expressions -/

theorem den_bSE {v : Vr} {mw cB a b : ℕ} (h11 : v 11 = mw) (h12 : v 12 = cB) {x y : E}
    (hx : x.den v = a) (hy : y.den v = b) :
    (bSE x y).den v = if bandS mw cB a b then 1 else 0 := by
  simp only [bSE, E.den, den_ltE, hx, hy, h11, h12, bandS]
  split_ifs <;> omega

section run
variable {v : Vr} {c : Cs} {Q m q x mw cB : ℕ} {L : List ℕ} {F : ℕ → ℕ → ℤ}

theorem castL_getD (L : List ℕ) (i : ℕ) : (L.map (fun j : ℕ => (j : ℤ))).getD i 0 = (Lg L i : ℤ) := by
  have := List.getD_map L 0 (n := i) (fun j : ℕ => (j : ℤ)); simpa only [Lg, Nat.cast_zero] using this

end run

