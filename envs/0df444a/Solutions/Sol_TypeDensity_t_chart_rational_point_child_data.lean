      = Φ.map ((Ideal.Quotient.mk (Ideal.span ({t, x} : Set R))).comp f) := by
    have := Polynomial.hom_eval₂ Φ ((chartBase R t x).comp f)
      (((e1 : _ ≃+* _).toRingHom).comp
        (Ideal.Quotient.mk (chartExceptional R t x))) (chartSlope R t x)
