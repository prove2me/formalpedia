  by_cases hi : i = j
  · subst hi; simp [NLogN.KFL.P1, Function.update_apply, h0, h1, h2, h3, h4, h5, h6]
  · simp only [NLogN.KFL.P1, Function.update_apply, hi, if_false]
    simp [Ne.symm h0, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4, Ne.symm h5, Ne.symm h6]

