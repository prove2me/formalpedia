  have vG' : AModel.vol (NLogN.KFS.midS sh' p q) = (NLogN.KFS.midS sh p q).prod := by
    simp only [AModel.vol, NLogN.KFS.midS, hsh', List.drop_append_of_le_length (show p + 1 ≤ sh.length by omega)]
    rw [List.take_append_of_le_length (by simp; omega)]
  have vS' : AModel.vol (NLogN.KFS.sufS sh' q) = (NLogN.KFS.sufS sh q).prod * 2 := by
    simp only [AModel.vol, NLogN.KFS.sufS, hsh', List.drop_append_of_le_length (show q + 1 ≤ sh.length by omega),
      List.prod_append, List.prod_singleton]
  have vN : AModel.vol (AModelL12.binShape (NLogN.KFS.preS sh' p) (NLogN.KFS.midS sh' p q) (NLogN.KFS.sufS sh' q) (2 ^ u)) = 2 * sh.prod := by
    rw [eS, hsh', AModel.vol_append]; simp [AModel.vol]; ring
  set t := NLogN.KIL.encK s (NLogN.KFW.regsSw f w u p q sh) with ht
  set R0 := NLogN.ints l ++ s.G 0 with hR0
  have ht0 : t.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0 := by
    simp [ht, NLogN.KFW.regsSw, hf0, NLogN.ints_append, hR0]
  obtain ⟨c2, Hc, hc⟩ := HK u w (NLogN.KFS.preS sh' p) (NLogN.KFS.midS sh' p q) (NLogN.KFS.sufS sh' q) hu h1 h2 h3 I t (NLogN.KFB.gflat zs) R0
    ht0 (by rw [eS, NLogN.KFB.length_gflat, hzl, hsh', AModel.vol_append]; simp [AModel.vol]; ring) (NLogN.KFS.zsz_gflat' hGB)
    (L1 := s.G NLogN.KFW.sN) (L2 := s.G NLogN.KFW.sW) (L3 := s.G NLogN.KFW.sP) (L4 := s.G NLogN.KFW.sG) (L5 := s.G NLogN.KFW.sS) (L6 := s.G NLogN.KFW.sU)
    (by rw [vN, ht, NLogN.KIL.encK_G]; rfl) (by rw [ht, NLogN.KIL.encK_G]; rfl) (by rw [vP', ht, NLogN.KIL.encK_G]; rfl)
    (by rw [vG', ht, NLogN.KIL.encK_G]; rfl) (by rw [vS', ht, NLogN.KIL.encK_G]; rfl) (by rw [ht, NLogN.KIL.encK_G]; rfl)
  rw [eS, NLogN.KFS.len_midS sh' hpq hq', NLogN.KFS.len_preS sh' (by omega)] at Hc
  have hs : sh.getD p 0 = sh.getD q 0 := by rw [hpu, hqu]
  rw [← NLogN.KFS.gflat_pull_swapPos sh hp hq hs 0 zs hzl] at Hc
  set Y := NLogN.KFB.gflat (AModel.pull sh sh (AModel.swapPos p q) 0 zs) with hY
  have eT : t.upd 0 (NLogN.ints Y ++ R0) =
      NLogN.KIL.encK s (NLogN.KFW.stD (Function.update f 0 (Y ++ l)) (f NLogN.KFW.dS) [] [(w : ℤ)] [(u : ℤ)]
        [((NLogN.KFS.preS sh p).prod : ℤ)] [((NLogN.KFS.midS sh p q).prod : ℤ)]
        [(((NLogN.KFS.sufS sh q).prod * 2 * (w + 1) : ℕ) : ℤ)] [((2 * sh.prod : ℕ) : ℤ)] [] [] [] []) := by
    rw [ht, hR0, show NLogN.ints Y ++ (NLogN.ints l ++ s.G 0) = NLogN.ints (Y ++ l) ++ s.G 0 by
      rw [NLogN.ints_append, List.append_assoc], NLogN.KIL.encK_upd, NLogN.KFW.regsSw, NLogN.KFW.stD_upd0]
  have S2 := Hc.mono' eT le_rfl
  -- 3. pop the registers
  set g := Function.update f 0 (Y ++ l) with hg
  have hgD : g NLogN.KFW.dS = f dS := Function.update_of_ne (by decide) _ _
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := NLogN.KFW.regs_bnd (w := w) (u := u) (p := p) (q := q) hsh
  have P3 := NLogN.KFW.popP_fsp s g (f NLogN.KFW.dS) _ _ _ _ _ _ b1 b2 b3 b4 b5 b6
  have eG : NLogN.KFW.stD g (f NLogN.KFW.dS) [] [] [] [] [] [] [] [] [] [] [] = g := by
    rw [← hgD]; refine NLogN.KFW.stD_self g (fun j hj => ?_)
    have hj0 : j ≠ 0 := by
      intro h; subst h; revert hj; decide
    rw [hg, Function.update_of_ne hj0]; exact hfe j (by simp only [List.mem_cons] at hj ⊢; tauto)
  rw [eG] at P3
  have S3 := NLogN.KFD.FSp.irun (I := I) (iprog := NLogN.KFL.l12prog) NLogN.KFW.fok_popP P3
  refine ⟨_, S1.seq (S2.seq S3), ?_⟩
  -- 4. the cost
  have hdc := NLogN.KFW.descCost_le sh.length sh.prod w u
  rw [vN] at hc
  set X : ℝ := ((w : ℝ) + 1) * ((AModel.vol sh : ℝ) + 1) * (u : ℝ) ^ NLogN.KFS.τS with hX
  set Yc : ℕ := (sh.length + 1) * (Nat.size (AModel.vol sh) + w + u + 1) ^ 2 with hYc
  have hX0 : 0 ≤ X := by positivity
  have hc2 : (c2 : ℝ) ≤ 2 * K * X := by
    refine le_trans hc ?_
    have hu0 : (0 : ℝ) ≤ (u : ℝ) ^ τS := by positivity
    have hV : ((2 * sh.prod : ℕ) : ℝ) + 1 ≤ 2 * ((AModel.vol sh : ℝ) + 1) := by
      push_cast; simp only [AModel.vol]; push_cast; linarith
    rw [hX]
    have := mul_le_mul_of_nonneg_left hV (show (0 : ℝ) ≤ K * ((w : ℝ) + 1) by positivity)
    nlinarith
  have hdc' : ((25 * NLogN.KFW.xD sh.length (Nat.size sh.prod + w + u + 8)
      (Nat.size sh.prod + w + u + 8 + NLogN.zsz (sh.length : ℤ)) +
      6 * (2 * (Nat.size sh.prod + w + u + 8) + 2) : ℕ) : ℝ) ≤ 10 ^ 14 * (Yc : ℝ) := by
    rw [hYc]; exact_mod_cast hdc
  have hY0 : (0 : ℝ) ≤ Yc := Nat.cast_nonneg _
  push_cast at hdc' ⊢
  nlinarith
end
