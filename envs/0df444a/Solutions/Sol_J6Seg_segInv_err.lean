      (fun j hj => hB.wf i hi j (by omega)) (by omega) (by omega) huv

lemma kd_add (c u q : ℕ) : kd (c + u) (c + q) = kd u q := by simp [kd]

/-- **`M M⁻¹ = I`** on each block (exact q-LU inverse of the recentred block). -/
theorem hinvG (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 1 ≤ α) {i : ℕ} (hi : i < s)
    {m : ℕ} (hm : m ∈ blS B i) :
    ∑ j ∈ blS B i, MxG s t α i j * MiG s t α B j m = kd i m := by
  obtain ⟨c1, c2, c3⟩ := hB.cover i hi
  rw [mem_blS] at hm
  have hσ : 0 < (α : ℝ) ^ 2 * ((t : ℝ) / s) := by
    have : (0 : ℝ) < α := by exact_mod_cast hα
    have : (0 : ℝ) < (t : ℝ) / s := div_pos (by exact_mod_cast (by omega : 0 < t))
      (by exact_mod_cast hs)
    positivity
  obtain ⟨u0, hu0⟩ : ∃ u0, i = B.st i + u0 := ⟨i - B.st i, by omega⟩
  obtain ⟨q, hq⟩ : ∃ q, m = B.st i + q := ⟨m - B.st i, by omega⟩
  have hu0n : u0 < B.len i := by omega
  have hqn : q < B.len i := by omega
  rw [blS, sum_Ico_eq_sum_range, show B.st i + B.len i - B.st i = B.len i by omega]
  have e : ∀ v ∈ range (B.len i), MxG s t α i (B.st i + v) * MiG s t α B (B.st i + v) m =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) u0 v *
        MinvF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) (B.len i) v q := by
    intro v hv
    rw [mem_range] at hv
    obtain ⟨h1, h2⟩ := hB.cons i hi (B.st i + v) (by omega) (by omega)
    rw [show MxG s t α i (B.st i + v) = MxG s t α (B.st i + u0) (B.st i + v) by rw [← hu0],
      MxG_loc hB hs hi hu0n hv]
    congr 1
    unfold MiG
    rw [h1, h2, hq]
    congr 1 <;> omega
  rw [sum_congr rfl e, MF_mul_MinvF _ _ _ hσ hu0n hqn, hu0, hq, kd_add]

lemma xθ_eq (hs : 0 < s) (hst : s ≤ t) : xθ s t α = (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  unfold xθ; rw [Nat.cast_mul, Nat.cast_sub hst]; push_cast; field_simp

lemma rpow_neg_le_eighth {x : ℝ} (hx : 3 ≤ x) : (2 : ℝ) ^ (-x) ≤ 1 / 8 := by
  have : (2 : ℝ) ^ (-x) ≤ (2 : ℝ) ^ (-3 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  refine this.trans (le_of_eq ?_)
  rw [Real.rpow_neg (by norm_num)]; norm_num

/-- `‖M - I‖ ≤ 2^{-α²θ}` row-wise. -/
theorem rowM (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) {i : ℕ}
    (hi : i < s) : ∑ k ∈ blS B i, |MxG s t α i k - kd i k| ≤ (2 : ℝ) ^ (-xθ s t α) := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have e : ∑ k ∈ blS B i, |MxG s t α i k - kd i k| =
      ∑ h ∈ (blS B i).image (fun k : ℕ => (k : ℤ) - i), eEx s t α i h := by
    rw [sum_image (fun a _ b _ hab => by simpa using hab)]
    refine sum_congr rfl fun k _ => ?_
    simp only [MxG, add_sub_cancel_left]
    exact abs_of_nonneg (eEx_nonneg s t α _ _)
  rw [e]
  exact (hsum.1.sum_le_tsum _ fun h _ => eEx_nonneg s t α _ _).trans hsum.2

/-- `‖Δ‖ ≤ 2^{-α²θ}` row-wise. -/
theorem rowD (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (i : ℕ) :
    ∑ h ∈ Hset B i, |cfG s t α i h| ≤ (2 : ℝ) ^ (-xθ s t α) := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have e : ∑ h ∈ Hset B i, |cfG s t α i h| = ∑ h ∈ Hset B i, eEx s t α i h :=
    sum_congr rfl fun h _ => abs_of_nonneg (eEx_nonneg s t α _ _)
  rw [e]
  exact (hsum.1.sum_le_tsum _ fun h _ => eEx_nonneg s t α _ _).trans hsum.2

lemma rowMabs (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) {i : ℕ}
    (hi : i < s) : ∑ k ∈ blS B i, |MxG s t α i k| ≤ 1 + (2 : ℝ) ^ (-xθ s t α) := by
  have h1 : ∑ k ∈ blS B i, |MxG s t α i k| ≤
      ∑ k ∈ blS B i, (|kd i k| + |MxG s t α i k - kd i k|) :=
    sum_le_sum fun k _ => by
      have := abs_add_le (kd i k) (MxG s t α i k - kd i k); simpa using this
  have h2 : ∑ k ∈ blS B i, |kd i k| = 1 := by
    simp only [kd, apply_ite abs, abs_one, abs_zero]
    rw [sum_ite_eq]; simp [blS_self hB hi]
  rw [sum_add_distrib, h2] at h1
  have := rowM hB hs hst hx1 hi
  linarith

/-- **`‖M⁻¹‖ ≤ 8/7`** (applied to a vector) when `α²θ ≥ 3`. -/
theorem MiG_apply (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 1 ≤ α)
    (hx : 3 ≤ xθ s t α) (f : ℕ → ℝ) (F : ℝ) (hF : ∀ k ∈ range s, |f k| ≤ F) {i : ℕ}
    (hi : i < s) : |Mv (blS B) (MiG s t α B) f i| ≤ 8 / 7 * F := by
  have hm := rpow_neg_le_eighth hx
  have key := Miv_bound (blS B) (MxG s t α) (MiG s t α B) (m := 1 / 8) (F := F) (by norm_num)
    (fun k hk => blS_self hB (blS_lt hB hi hk)) (fun k hk => blS_eq hB hi hk)
    (fun k hk q hq => by
      have hk' := blS_lt hB hi hk
      rw [← blS_eq hB hi hk]
      exact hinvG hB hs hst hα hk' (by rw [blS_eq hB hi hk]; exact hq))
    (fun k hk => by
      have hk' := blS_lt hB hi hk
      rw [← blS_eq hB hi hk]
      exact (rowM hB hs hst (by linarith) hk').trans hm)
    f (fun k hk => hF k (mem_range.2 (blS_lt hB hi hk))) (blS_self hB hi)
  rw [show F / (1 - 1 / 8) = 8 / 7 * F by ring] at key
  exact key

lemma Hset_card (i : ℕ) : (Hset B i).card ≤ 2 * B.w + 1 := by
  unfold Hset
  exact (card_filter_le _ _).trans (card_image_le.trans (by simp))

lemma mem_Hset {i : ℕ} {h : ℤ} (hh : h ∈ Hset B i) :
    -(B.w : ℤ) ≤ h ∧ h ≤ B.w ∧ h ≠ 0 ∧ ¬ ((B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i) := by
  unfold Hset at hh
  rw [mem_filter, mem_image] at hh
  obtain ⟨⟨j, hj, rfl⟩, h1, h2⟩ := hh
  rw [mem_range] at hj
  refine ⟨by omega, by omega, h1, h2⟩

lemma emod_cases (hs : 0 < s) {a : ℤ} (h1 : -(s : ℤ) ≤ a) (h2 : a < 2 * s) :
    (0 ≤ a ∧ a < s ∧ a % s = a) ∨ (s ≤ a ∧ a % s = a - s) ∨ (a < 0 ∧ a % s = a + s) := by
  have hs' : (0 : ℤ) < s := by exact_mod_cast hs
  rcases lt_or_ge a 0 with ha | ha
  · right; right; refine ⟨ha, ?_⟩
    have e : (a + s) % s = a % s := by simp
    rw [← e]; exact Int.emod_eq_of_lt (by omega) (by omega)
  rcases lt_or_ge a s with hb | hb
  · left; exact ⟨ha, hb, Int.emod_eq_of_lt ha hb⟩
  · right; left; refine ⟨hb, ?_⟩
    have e : (a - s + s) % s = (a - s) % s := by simp
    rw [sub_add_cancel] at e
    rw [e]; exact Int.emod_eq_of_lt (by omega) (by omega)

/-- Every coupling column is a near-boundary position (`Jlist`). -/
theorem col_mem (hB : BlocksOK s t B) (hs : 0 < s) {i : ℕ} (hi : i < s) {h : ℤ}
    (hh : h ∈ Hset B i) : col B.s i h ∈ (Jlist B).toFinset := by
  obtain ⟨hw1, hw2, h0, hout⟩ := mem_Hset hh
  have hw := hB.hw
  have hbs := hB.hs
  obtain ⟨ci1, ci2, ci3⟩ := hB.cover i hi
  rw [List.mem_toFinset, Jlist, List.mem_filter, List.mem_range, hbs]
  unfold col
  set j := ((((i : ℤ) + h) % s)).toNat with hj
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : ((j : ℕ) : ℤ) = ((i : ℤ) + h) % s := by
    rw [hj]; exact Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  have hjs : j < s := by
    have := Int.emod_lt_of_pos ((i : ℤ) + h) (by exact_mod_cast hs : (0 : ℤ) < s); omega
  refine ⟨hjs, ?_⟩
  obtain ⟨cj1, cj2, cj3⟩ := hB.cover j hjs
  have key : ¬ (B.st j ≤ i ∧ i < B.st j + B.len j) ∨ (B.st i = B.st j ∧ B.len i = B.len j) := by
    by_cases hc : B.st j ≤ i ∧ i < B.st j + B.len j
    · right; obtain ⟨a, b⟩ := hB.cons j hjs i hc.1 hc.2; exact ⟨a, b⟩
    · left; exact hc
  unfold nearB
  simp only [decide_eq_true_eq]
  omega

lemma toNat_emod_lt (hs : 0 < s) (a : ℤ) : (a % s).toNat < s := by
  have := Int.emod_lt_of_pos a (by exact_mod_cast hs : (0 : ℤ) < s)
  have := Int.emod_nonneg a (by exact_mod_cast hs.ne' : (s : ℤ) ≠ 0)
  omega

lemma sumN (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (x : ℕ → ℝ) (X : ℝ)
    (hX : ∀ k < s, |x k| ≤ X) (i : ℕ) :
    Summable (fun h : ℤ => eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)) ∧
    |∑' h : ℤ, eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)| ≤ (2 : ℝ) ^ (-xθ s t α) * X := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have hX0 : 0 ≤ X := (abs_nonneg _).trans (hX 0 hs)
  have hb : ∀ h : ℤ, ‖eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)‖ ≤ eEx s t α i h * X :=
    fun h => by
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (eEx_nonneg s t α _ _)]
      exact mul_le_mul_of_nonneg_left (hX _ (toNat_emod_lt hs _)) (eEx_nonneg s t α _ _)
  have hS2 : Summable (fun h : ℤ => eEx s t α i h * X) := hsum.1.mul_right X
  have hS : Summable (fun h : ℤ => eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)) :=
    hS2.of_norm_bounded hb
  refine ⟨hS, ?_⟩
  have hn : Summable (fun h : ℤ => ‖eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)‖) :=
    hS2.of_nonneg_of_le (fun _ => norm_nonneg _) hb
  calc |∑' h : ℤ, eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)|
      = ‖∑' h : ℤ, eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)‖ := (Real.norm_eq_abs _).symm
    _ ≤ ∑' h : ℤ, ‖eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)‖ := norm_tsum_le_tsum_norm hn
    _ ≤ ∑' h : ℤ, eEx s t α i h * X := hn.tsum_le_tsum hb hS2
    _ = (∑' h : ℤ, eEx s t α i h) * X := tsum_mul_right
    _ ≤ (2 : ℝ) ^ (-xθ s t α) * X := mul_le_mul_of_nonneg_right hsum.2 hX0

lemma NxR_sub (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (x y : ℕ → ℝ) (X Y : ℝ)
    (hX : ∀ k < s, |x k| ≤ X) (hY : ∀ k < s, |y k| ≤ Y) (i : ℕ) :
    NxR s t α (fun k => x k - y k) i = NxR s t α x i - NxR s t α y i := by
  unfold NxR
  have h1 := (sumN hs hst hx1 x X hX i).1
  have h2 := (sumN hs hst hx1 y Y hY i).1
  have e : (fun h : ℤ => eEx s t α i h * (x ((((i : ℤ) + h) % s).toNat) -
      y ((((i : ℤ) + h) % s).toNat))) = fun h => eEx s t α i h * x ((((i : ℤ) + h) % s).toNat) -
      eEx s t α i h * y ((((i : ℤ) + h) % s).toNat) := by funext h; ring
  rw [e, h1.tsum_sub h2]; ring

/-- **`‖N d‖ ≤ ρ ⇒ ‖d‖ ≤ 8ρ/7`** (`‖N - I‖ ≤ 2^{-α²θ} ≤ 1/8`). -/
theorem nearN (hs : 0 < s) (hst : s ≤ t) (hx : 3 ≤ xθ s t α) (d : ℕ → ℝ) (ρ : ℝ)
    (hd : ∀ i < s, |NxR s t α d i| ≤ ρ) : ∀ i < s, |d i| ≤ 8 / 7 * ρ := by
  intro i hi
  obtain ⟨i0, hi0, hmax⟩ := (range s).exists_max_image (fun k => |d k|) ⟨i, mem_range.2 hi⟩
  rw [mem_range] at hi0
  suffices h : |d i0| ≤ 8 / 7 * ρ from (hmax i (mem_range.2 hi)).trans h
  have hb := (sumN hs hst (by linarith) d (|d i0|) (fun k hk => hmax k (mem_range.2 hk)) i0).2
  have h8 := rpow_neg_le_eighth hx
  have h8' : (2 : ℝ) ^ (-xθ s t α) * |d i0| ≤ 1 / 8 * |d i0| :=
    mul_le_mul_of_nonneg_right h8 (abs_nonneg _)
  have hN := hd i0 hi0
  unfold NxR at hN
  have := abs_sub_abs_le_abs_sub (d i0) (-∑' h : ℤ, eEx s t α i0 h * d ((((i0 : ℤ) + h) % s).toNat))
  rw [abs_neg, sub_neg_eq_add] at this
  linarith

end glob

end J6Seg

end

section
-- Source module: Solutions.J6SegEnt
/-!
# Segmented inverse (S2): single entries of the block inverse (capacitance corners)

`TinvI` evaluates `T⁻¹_{uv}` directly or through persymmetry (`TinvF_persym`), `MinvI`
evaluates `M⁻¹_{uv} = D_u T⁻¹_{uv} D_v⁻¹`.  With `K = (n+1)E + 1`, `100 K ≤ 2^P`:
`|TinvI/2^P - T⁻¹_{uv}| ≤ 7K/2^P` and `|MinvI/2^P - M⁻¹_{uv}| ≤ 12 Dm K/2^P`.
-/

open Finset Real

namespace J6Seg
open J6QLU

section ent
variable (P : ℕ)

lemma fmul_approx {x y : ℤ} {c d ex ey Y C : ℝ} (hx : |(x : ℝ) / 2 ^ P - c| ≤ ex)
    (hy : |(y : ℝ) / 2 ^ P - d| ≤ ey) (hY : |(y : ℝ) / 2 ^ P| ≤ Y) (hC : |c| ≤ C)
    (hex : 0 ≤ ex) (hey : 0 ≤ ey) :
    |(fmul P x y : ℝ) / 2 ^ P - c * d| ≤ 1 / (2 * 2 ^ P) + ex * Y + C * ey := by
  have h := fmul_err P x y
  have e : (fmul P x y : ℝ) / 2 ^ P - c * d =
      ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P)) +
      (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d)) := by ring
  rw [e]
  have h1 : |((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)| ≤ ex * Y := by
    rw [abs_mul]; exact mul_le_mul hx hY (abs_nonneg _) hex
  have h2 : |c * ((y : ℝ) / 2 ^ P - d)| ≤ C * ey := by
    rw [abs_mul]; exact mul_le_mul hC hy (abs_nonneg _) ((abs_nonneg _).trans hC)
  have h3 := abs_add_le (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)) (c * ((y : ℝ) / 2 ^ P - d))
  have h4 := abs_add_le ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P))
    (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d))
  linarith

variable {P} {α σ b : ℝ}

lemma abs_le_of_approx {x : ℤ} {c e B : ℝ} (h : |(x : ℝ) / 2 ^ P - c| ≤ e) (hc : |c| ≤ B) :
    |(x : ℝ) / 2 ^ P| ≤ B + e := by
  have := abs_sub_abs_le_abs_sub ((x : ℝ) / 2 ^ P) c; linarith

end ent

end J6Seg

end

section
-- Source module: Solutions.J6SegStage
/-!
# Segmented inverse (S2): accuracy of the global stages

With `K = (λ+1)E + 1` (`λ` ≥ every block length, `E` the table accuracy in ulps) and `Dm` ≥ every
`D_u = e^{πα²θu²}` used:
* `applyMinv_err`: `|applyMinv V / 2^P - M⁻¹ (V/2^P)| ≤ 9 Dm K (B+1)/2^P` (`|V/2^P| ≤ B`);
* `coupleI_err`: `|coupleI z / 2^P - Δ (z/2^P)| ≤ (2w+1)(1/2 + E Z)/2^P` (`|z/2^P| ≤ Z` on `J`);
* `capI_row`, `capI_apply`: the computed capacitance `C = I + (M⁻¹Δ)|_J` has row deviation
  `≤ 1/7 + λ(2w+1)δ` and `|C z - (z + M⁻¹ Δ z)| ≤ λ(2w+1) δ Z` with `δ = 15 Dm K / 2^P`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section stage
variable {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}

lemma blk_params (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hx : 3 ≤ xθ s t α) (c : ℕ) :
    2 ≤ (α : ℝ) ∧ 1 ≤ (t : ℝ) / s ∧ 2 ≤ (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) ∧
      |(bOf s t c : ℝ) / s| ≤ 1 / 2 := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  refine ⟨by exact_mod_cast hα, by rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst, ?_, ?_⟩
  · rw [← xθ_eq hs hst]; linarith
  · obtain ⟨h1, h2⟩ := bOf_bounds s t hs (c : ℤ)
    have h1' : -(s : ℝ) ≤ 2 * (bOf s t c : ℝ) := by exact_mod_cast h1
    have h2' : 2 * (bOf s t c : ℝ) < s := by exact_mod_cast h2
    rw [abs_le, le_div_iff₀ hsR, div_le_iff₀ hsR]; constructor <;> linarith

lemma Kn_le {n lam : ℕ} (hn : n ≤ lam) (hE : 0 ≤ E) :
    ((n : ℝ) + 1) * E + 1 ≤ ((lam : ℝ) + 1) * E + 1 := by
  have : (n : ℝ) ≤ lam := by exact_mod_cast hn
  nlinarith

lemma Mv_MiG_eq (hB : BlocksOK s t B) {i : ℕ} (hi : i < s) (f : ℕ → ℝ) :
    Mv (blS B) (MiG s t α B) f i = ∑ k ∈ range (B.len i),
      MinvF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) (B.len i) (i - B.st i) k *
        f (B.st i + k) := by
  unfold Mv blS
  rw [sum_Ico_eq_sum_range, show B.st i + B.len i - B.st i = B.len i by omega]
  refine sum_congr rfl fun k _ => ?_
  simp [MiG]

/-- **Block-diagonal solve.** -/
theorem applyMinv_err (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (V : ℕ → ℤ) {Bv : ℝ} (hB0 : 0 ≤ Bv)
    (hV : ∀ k < s, |(V k : ℝ) / 2 ^ P| ≤ Bv)
    (hP : 8 * (((lam : ℝ) + 1) * E + 1) * (Bv + 1) ≤ 2 ^ P) {i : ℕ} (hi : i < s) :
    |(applyMinv P T B V i : ℝ) / 2 ^ P - Mv (blS B) (MiG s t α B) (fun k => (V k : ℝ) / 2 ^ P) i| ≤
      9 * Dm * (((lam : ℝ) + 1) * E + 1) * (Bv + 1) / 2 ^ P := by
  obtain ⟨c1, c2, c3⟩ := hB.cover i hi
  obtain ⟨p1, p2, p3, p4⟩ := blk_params hs hst hα hx (B.st i)
  have hKn := Kn_le (hlam i hi) hE
  have hS := two_pow_pos' P
  have hn0 : 0 ≤ ((B.len i : ℝ) + 1) * E + 1 := by positivity
  have h := blkI_err p1 p2 p3 p4 (hT.blk i hi) hE hB0 (hT.dm i hi)
    (le_trans (by nlinarith) hP) (fun u => V (B.st i + u))
    (fun u hu => hV _ (by omega)) (i - B.st i) (by omega)
  rw [blkE_eq _ _ _ (by omega : i - B.st i < B.len i)] at h
  rw [Mv_MiG_eq hB hi]
  refine h.trans ?_
  have hDm1 : 1 ≤ Dm := le_trans (one_le_ddR p2 0) (hT.dm i hi 0 (by omega))
  apply div_le_div_of_nonneg_right _ hS.le
  have := mul_le_mul_of_nonneg_left hKn (by linarith : (0 : ℝ) ≤ 9 * Dm)
  have := mul_le_mul_of_nonneg_right this (by linarith : (0 : ℝ) ≤ Bv + 1)
  linarith

lemma eEx_le_one' (hs : 0 < s) (hst : s ≤ t) (l h : ℤ) : eEx s t α l h ≤ 1 := by
  refine (eEx_le_cf s t α hs hst l h).trans ?_
  rw [Real.exp_le_one_iff, neg_nonpos]
  rcases le_or_gt |(h : ℝ)| 1 with h1 | h1
  · rcases eq_or_lt_of_le h1 with h2 | h2
    · rw [h2]; simp
    · have : |(h : ℝ)| = 0 := by
        have : |h| < 1 := by exact_mod_cast (show |(h : ℝ)| < 1 from h2)
        have : |h| = 0 := by have := abs_nonneg h; omega
        exact_mod_cast this
      rw [this]; simp
  · have := abs_nonneg (h : ℝ)
    have : 0 ≤ |(h : ℝ)| * (|(h : ℝ)| - 1) := mul_nonneg (by linarith) (by linarith)
    positivity

/-- **Coupling `W = Δ z`.** -/
theorem coupleI_err (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t)
    (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) (z : ℕ → ℤ) {Z : ℝ}
    (hz : ∀ k ∈ (Jlist B).toFinset, |(z k : ℝ) / 2 ^ P| ≤ Z) (hZ0 : 0 ≤ Z) {i : ℕ} (hi : i < s) :
    |(coupleI P T B z i : ℝ) / 2 ^ P -
      Dv (Hset B) (col B.s) (cfG s t α) (fun k => (z k : ℝ) / 2 ^ P) i| ≤
      (2 * B.w + 1) * (1 / 2 + E * Z) / 2 ^ P := by
  have hS := two_pow_pos' P
  unfold coupleI Dv
  push_cast
  rw [sum_div, ← sum_sub_distrib]
  have hterm : ∀ h ∈ Hset B i, |(fmul P (T.cpl i h) (z (col B.s i h)) : ℝ) / 2 ^ P -
      cfG s t α i h * ((z (col B.s i h) : ℝ) / 2 ^ P)| ≤ (1 / 2 + E * Z) / 2 ^ P := by
    intro h hh
    have hc := ulp_div P (hT.cpl i hi h hh)
    have hZ := hz _ (col_mem hB hs hi hh)
    have hzz : |(z (col B.s i h) : ℝ) / 2 ^ P - (z (col B.s i h) : ℝ) / 2 ^ P| ≤ 0 := by simp
    have h1 := fmul_approx P hc hzz hZ
      (show |eEx s t α i h| ≤ 1 by
        rw [abs_of_nonneg (eEx_nonneg s t α _ _)]; exact eEx_le_one' hs hst _ _)
      (div_nonneg hE hS.le) le_rfl
    refine h1.trans (le_of_eq ?_)
    rw [mul_zero, add_zero]; field_simp
  refine (abs_sum_le_sum_abs _ _).trans ((sum_le_sum hterm).trans ?_)
  rw [sum_const, nsmul_eq_mul]
  have hc : ((Hset B i).card : ℝ) ≤ 2 * B.w + 1 := by exact_mod_cast Hset_card i
  have h0 : 0 ≤ (1 / 2 + E * Z) / 2 ^ P := by positivity
  rw [mul_div_assoc]
  exact mul_le_mul_of_nonneg_right hc h0

lemma Dm_one (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hT : TabOK P s t α B T E Dm)
    {a : ℕ} (ha : a < s) : 1 ≤ Dm := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have p2 : 1 ≤ (t : ℝ) / s := by rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst
  exact le_trans (one_le_ddR p2 0) (hT.dm a ha 0 (by have := hB.cover a ha; omega))

end stage

end J6Seg

end

section
-- Source module: Solutions.J6SegMain
/-!
# Segmented inverse (S2): the main error theorem (report L10)

`segInv_err`: for the resampling system `N = I + E` of lengths `s < t` with Gaussian parameter
`α ≥ 2` and `α²θ = α²(t-s)/s ≥ 3`, any valid block structure `B` (wrap-free runs of length
`≤ λ` partitioning `[0, s)`, coupling width `w ≤ s`), tables accurate to `E` ulps
(`TabOK`, `D_u ≤ Dm` on every block), a fixed-point input `U` (`|U/2^P| ≤ Bu`) approximating `v`
to `ε_in`, and the exact solution `w` of `N w = v`, the segmented inverse satisfies

`|segInv U i / 2^P - w_i| ≤ 60 G / 2^P + 12 e^{-πα² w(w+1)} (Bu+1) + (8/7) ε_in`

with `G = Dm ((λ+1)E+1) (Bu+1) (λ+1) (2w+1) (|J|+1)²` (`|J|` = number of near-boundary
positions), as soon as `1000 G ≤ 2^P`. In bits: precision
`P ≥ Q + log₂ Dm + 2 log₂(|J|+1) + log₂((λ+1)²(2w+1)) + log₂((λ+1)E+1) + log₂(Bu+1) + 16`
gives error `≤ 2^{-Q}` up to the truncation and input terms.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

lemma Jlist_nodup (B : Blocks) : (Jlist B).Nodup := (List.nodup_range).filter _

lemma Jlist_lt {B : Blocks} {s : ℕ} (hs : B.s = s) {a : ℕ} (ha : a ∈ (Jlist B).toFinset) : a < s := by
  rw [List.mem_toFinset, Jlist, List.mem_filter, List.mem_range, hs] at ha; exact ha.1

section budget
variable {Dm K β L Wd Q e : ℝ}

lemma bud_one {a b : ℝ} (ha : 0 ≤ a) (hb : 1 ≤ b) : a ≤ a * b := le_mul_of_one_le_right ha hb

lemma one_le_mul' {a b : ℝ} (ha : 1 ≤ a) (hb : 1 ≤ b) : 1 ≤ a * b := by nlinarith

lemma bud1 (hDm : 1 ≤ Dm) (hK : 1 ≤ K) (hβ : 1 ≤ β) (hL : 1 ≤ L) (hW : 1 ≤ Wd) (hQ : 1 ≤ Q)
    (he : 0 ≤ e) : Dm * K * β * e ≤ Dm * K * β * L * Wd * Q * e := by
  have h := bud_one (by positivity : 0 ≤ Dm * K * β * e)
    (one_le_mul' (one_le_mul' hL hW) hQ)
  exact h.trans (le_of_eq (by ring))

lemma bud2 (hDm : 1 ≤ Dm) (hK : 1 ≤ K) (hβ : 1 ≤ β) (hL : 1 ≤ L) (hW : 1 ≤ Wd) (hQ : 1 ≤ Q)
    (he : 0 ≤ e) : β * Q * e ≤ Dm * K * β * L * Wd * Q * e := by
  have h := bud_one (by positivity : 0 ≤ β * Q * e)
    (one_le_mul' (one_le_mul' hDm hK) (one_le_mul' hL hW))
  exact h.trans (le_of_eq (by ring))

lemma bud3 (hDm : 1 ≤ Dm) (hK : 1 ≤ K) (hβ : 1 ≤ β) (hL : 1 ≤ L) (hW : 1 ≤ Wd) (hQ : 1 ≤ Q)
    (he : 0 ≤ e) : Wd * K * β * e ≤ Dm * K * β * L * Wd * Q * e := by
  have h := bud_one (by positivity : 0 ≤ Wd * K * β * e) (one_le_mul' (one_le_mul' hDm hL) hQ)
  exact h.trans (le_of_eq (by ring))

lemma bud4 {lam : ℝ} (hDm : 1 ≤ Dm) (hK : 1 ≤ K) (hβ : 1 ≤ β) (hL : 1 ≤ L) (hW : 1 ≤ Wd)
    (hQ : 1 ≤ Q) (he : 0 ≤ e) (hl0 : 0 ≤ lam) (hlL : lam ≤ L) :
    lam * Wd * (Dm * K * e) * β ≤ Dm * K * β * L * Wd * Q * e := by
  have h1 : lam * Wd * (Dm * K * e) * β ≤ L * Wd * (Dm * K * e) * β :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hlL
      (by positivity)) (by positivity)) (by positivity)
  have h2 := bud_one (by positivity : 0 ≤ L * Wd * (Dm * K * e) * β) hQ
  exact h1.trans (h2.trans (le_of_eq (by ring)))

lemma bud5 (hDm : 1 ≤ Dm) (hK : 1 ≤ K) (hβ : 1 ≤ β) (he : 0 ≤ e) :
    K * e ≤ Dm * K * β * e := by
  have h := bud_one (by positivity : 0 ≤ K * e) (one_le_mul' hDm hβ)
  exact h.trans (le_of_eq (by ring))

lemma bud6 (hβ : 1 ≤ β) (hQ : 1 ≤ Q) (he : 0 ≤ e) : Q * e ≤ β * Q * e := by
  have h := bud_one (by positivity : 0 ≤ Q * e) hβ
  exact h.trans (le_of_eq (by ring))

end budget

/-- **Main theorem (segmented inverse, real form).** -/
theorem segInv_err_sol_aux {P s t α lam : ℕ} {B : Blocks} {T : Tables} {E Dm Bu εin Wm : ℝ}
    (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hx : 3 ≤ xθ s t α)
    (hB : BlocksOK s t B) (hlam : ∀ i < s, B.len i ≤ lam)
    (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E)
    (U : ℕ → ℤ) (hBu : 0 ≤ Bu) (hU : ∀ i < s, |(U i : ℝ) / 2 ^ P| ≤ Bu)
    (v w : ℕ → ℝ) (hw : ∀ i < s, |w i| ≤ Wm) (hsys : ∀ i < s, NxR s t α w i = v i)
    (hin : ∀ i < s, |(U i : ℝ) / 2 ^ P - v i| ≤ εin)
    (hP : 1000 * segG B lam E Dm Bu ≤ 2 ^ P) :
    ∀ i < s, |(segInv P T B U i : ℝ) / 2 ^ P - w i| ≤
      60 * segG B lam E Dm Bu / 2 ^ P +
        3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1))))) * (Bu + 1) + 8 / 7 * εin := by
  have hS := two_pow_pos' P
  -- the atoms
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((lam : ℝ) + 1) * E + 1 := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = Bu + 1 := ⟨_, rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = (lam : ℝ) + 1 := ⟨_, rfl⟩
  obtain ⟨Wd, hWd⟩ : ∃ Wd : ℝ, Wd = 2 * (B.w : ℝ) + 1 := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ℝ, Q = (((Jlist B).length : ℝ) + 1) ^ 2 := ⟨_, rfl⟩
  obtain ⟨e, he⟩ : ∃ e : ℝ, e = 1 / 2 ^ P := ⟨_, rfl⟩
  have hdiv : ∀ c : ℝ, c / 2 ^ P = c * e := fun c => by rw [he]; ring
  have he0 : 0 ≤ e := by rw [he]; positivity
  have hDm1 : 1 ≤ Dm := Dm_one hB hs hst hT hs
  have hlam0 : (0 : ℝ) ≤ lam := Nat.cast_nonneg _
  have hlE : 0 ≤ (lam : ℝ) * E := mul_nonneg hlam0 hE
  have hK1 : 1 ≤ K := by rw [hK]; linarith
  have hEK : E ≤ K := by rw [hK]; linarith
  have hβ1 : 1 ≤ β := by rw [hβ]; linarith
  have hL1 : 1 ≤ L := by rw [hL]; linarith
  have hlamL : (lam : ℝ) ≤ L := by rw [hL]; linarith
  have hWd1 : 1 ≤ Wd := by rw [hWd]; have := Nat.cast_nonneg (α := ℝ) B.w; linarith
  have hQ1 : 1 ≤ Q := by
    rw [hQ]; have := Nat.cast_nonneg (α := ℝ) (Jlist B).length
    exact one_le_pow₀ (by linarith)
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = Dm * K * β * L * Wd * Q := ⟨_, rfl⟩
  have hGdef : segG B lam E Dm Bu = G := by rw [hG, segG, hK, hβ, hL, hWd, hQ]
  rw [hGdef] at hP ⊢
  obtain ⟨Ge, hGe'⟩ : ∃ Ge : ℝ, Ge = G * e := ⟨_, rfl⟩
  have hGe : 1000 * Ge ≤ 1 := by
    rw [hGe', he, mul_one_div, ← mul_div_assoc, div_le_one hS]; exact hP
  have b1 : Dm * K * β * e ≤ Ge := by rw [hGe', hG]; exact bud1 hDm1 hK1 hβ1 hL1 hWd1 hQ1 he0
  have b2 : β * Q * e ≤ Ge := by rw [hGe', hG]; exact bud2 hDm1 hK1 hβ1 hL1 hWd1 hQ1 he0
  have b3 : Wd * K * β * e ≤ Ge := by rw [hGe', hG]; exact bud3 hDm1 hK1 hβ1 hL1 hWd1 hQ1 he0
  have b4 : (lam : ℝ) * Wd * (Dm * K * e) * β ≤ Ge := by
    rw [hGe', hG]; exact bud4 hDm1 hK1 hβ1 hL1 hWd1 hQ1 he0 hlam0 hlamL
  have b5 : K * e ≤ Ge := (bud5 hDm1 hK1 hβ1 he0).trans b1
  have b6 : Q * e ≤ Ge := (bud6 hβ1 hQ1 he0).trans b2
  have hP100 : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P := by
    rw [← hK]
    have h : 100 * K * e ≤ 1 := by linarith
    rw [he, mul_one_div, div_le_one hS] at h; exact h
  have hMi : ∀ (f : ℕ → ℝ) (F : ℝ), (∀ k ∈ range s, |f k| ≤ F) →
      ∀ i ∈ range s, |Mv (blS B) (MiG s t α B) f i| ≤ 8 / 7 * F :=
    fun f F hF i hi => MiG_apply hB hs hst (by omega) hx f F hF (mem_range.1 hi)
  -- stage 1: `Y = M⁻¹ U`
  obtain ⟨Y, hY⟩ : ∃ Y, Y = applyMinv P T B U := ⟨_, rfl⟩
  have hP1 : 8 * (((lam : ℝ) + 1) * E + 1) * (Bu + 1) ≤ 2 ^ P := by
    rw [← hK, ← hβ]
    have h : 8 * (K * β) * e ≤ 1 := by
      have := bud5 hDm1 hK1 hβ1 he0
      have : K * β * e ≤ Dm * K * β * e := by
        have := bud_one (by positivity : 0 ≤ K * β * e) hDm1
        exact this.trans (le_of_eq (by ring))
      have : 8 * (K * β) * e = 8 * (K * β * e) := by ring
      linarith
    rw [he, mul_one_div, div_le_one hS] at h; linarith
  obtain ⟨ε1, hε1⟩ : ∃ ε1 : ℝ, ε1 = 9 * (Dm * K * β * e) := ⟨_, rfl⟩
  have h1 : ∀ i ∈ range s, |(Y i : ℝ) / 2 ^ P -
      Mv (blS B) (MiG s t α B) (fun k => (U k : ℝ) / 2 ^ P) i| ≤ ε1 := by
    intro i hi
    rw [hY]
    refine (applyMinv_err hB hs hst hα hx hT hE hlam U hBu hU hP1 (mem_range.1 hi)).trans
      (le_of_eq ?_)
    rw [hdiv, ← hK, ← hβ, hε1]; ring
  have hε1b : ε1 ≤ 9 * Ge := by rw [hε1]; linarith
  have hε10 : 0 ≤ ε1 := by rw [hε1]; positivity
  have hy : ∀ i < s, |(Y i : ℝ) / 2 ^ P| ≤ 8 / 7 * Bu + ε1 := by
    intro i hi
    have h0 := hMi (fun k => (U k : ℝ) / 2 ^ P) Bu (fun k hk => hU k (mem_range.1 hk)) i
      (mem_range.2 hi)
    have := abs_le_of_approx (P := P) (h1 i (mem_range.2 hi)) h0
    linarith
  -- stage 2: the capacitance solve
  obtain ⟨By, hBy⟩ : ∃ By : ℝ, By = 8 / 7 * Bu + ε1 := ⟨_, rfl⟩
  have hδ : 15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P = 15 * (Dm * K * e) := by
    rw [← hK, hdiv]; ring
  have hcr : (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) ≤
      15 * Ge := by
    rw [hδ, ← hWd]
    have h2 : (lam : ℝ) * Wd * (Dm * K * e) ≤ (lam : ℝ) * Wd * (Dm * K * e) * β :=
      bud_one (by positivity) hβ1
    have : (lam : ℝ) * Wd * (15 * (Dm * K * e)) = 15 * ((lam : ℝ) * Wd * (Dm * K * e)) := by ring
    linarith
  have hη : 1 / 7 + (lam : ℝ) * (2 * B.w + 1) *
      (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) ≤ 1 / 4 := by linarith
  have hJs := hB.hs
  have hge := geSolve_bound P (Jlist B) (capI P T B) Y
    (1 / 7 + (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P)) By
    (Jlist_nodup B) (by positivity) hη (by rw [← hQ, hdiv]; linarith)
    (fun a ha => cap_row hB hs hst hα hx hT hE hlam hP100
      (Jlist_lt hJs (List.mem_toFinset.2 ha)))
    (fun a ha => by rw [hBy]; exact hy a (Jlist_lt hJs (List.mem_toFinset.2 ha)))
    (by rw [hBy]; linarith)
  obtain ⟨z, hzd⟩ : ∃ z, z = geSolve P (Jlist B) (capI P T B) Y := ⟨_, rfl⟩
  rw [← hzd] at hge
  obtain ⟨Z, hZd⟩ : ∃ Z : ℝ, Z = 4 * By + 1 := ⟨_, rfl⟩
  have hz : ∀ k ∈ (Jlist B).toFinset, |(z k : ℝ) / 2 ^ P| ≤ Z :=
    fun k hk => by rw [hZd]; exact hge.1 k (List.mem_toFinset.1 hk)
  have hBy0 : 0 ≤ By := by rw [hBy]; linarith
  have hZ0 : 0 ≤ Z := by rw [hZd]; positivity
  have hZ : Z ≤ 5 * β := by rw [hZd, hBy, hβ]; linarith
  -- stage 3: coupling
  obtain ⟨W, hWdef⟩ : ∃ W, W = coupleI P T B z := ⟨_, rfl⟩
  obtain ⟨ε3, hε3d⟩ : ∃ ε3 : ℝ, ε3 = Wd * (1 / 2 + E * Z) * e := ⟨_, rfl⟩
  have h3 : ∀ i ∈ range s, |(W i : ℝ) / 2 ^ P -
      Dv (Hset B) (col B.s) (cfG s t α) (fun k => (z k : ℝ) / 2 ^ P) i| ≤ ε3 := by
    intro i hi
    rw [hWdef]
    refine (coupleI_err hB hs hst hT hE z hz hZ0 (mem_range.1 hi)).trans (le_of_eq ?_)
    rw [hdiv, hε3d, hWd]
  have hε3 : ε3 ≤ 6 * Ge := by
    have hEZ : E * Z ≤ K * (5 * β) := mul_le_mul hEK hZ hZ0 (by linarith)
    have hKb : 1 / 2 ≤ K * β := by have := one_le_mul' hK1 hβ1; linarith
    have : 1 / 2 + E * Z ≤ 6 * (K * β) := by linarith
    have := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left this (by linarith : 0 ≤ Wd)) he0
    rw [hε3d]
    have : Wd * (6 * (K * β)) * e = 6 * (Wd * K * β * e) := by ring
    linarith
  have hd8 : ∀ i ∈ range s, ∑ h ∈ Hset B i, |cfG s t α i h| ≤ 1 / 8 :=
    fun i _ => (rowD hs hst (by linarith) i).trans (rpow_neg_le_eighth hx)
  obtain ⟨BW, hBWd⟩ : ∃ BW : ℝ, BW = 1 / 8 * Z + ε3 := ⟨_, rfl⟩
  have hWb : ∀ i < s, |(W i : ℝ) / 2 ^ P| ≤ BW := by
    intro i hi
    have h0 := Dv_abs (Hset B) (col B.s) (cfG s t α) (hd8 i (mem_range.2 hi))
      (fun h hh => col_mem hB hs hi hh) hz hZ0
    have := abs_le_of_approx (P := P) (h3 i (mem_range.2 hi)) h0
    rw [hBWd]; linarith
  have hBW : BW ≤ 5 / 8 * β + 6 * Ge := by rw [hBWd]; linarith
  have hBW0 : 0 ≤ BW := by
    have := hWb 0 hs; exact (abs_nonneg _).trans this
  -- stage 4: `Y₂ = M⁻¹ W`
  obtain ⟨Y₂, hY₂⟩ : ∃ Y₂, Y₂ = applyMinv P T B W := ⟨_, rfl⟩
  have hBW1 : BW + 1 ≤ 2 * β := by linarith
  have hKBW : Dm * K * (BW + 1) * e ≤ 2 * (Dm * K * β * e) := by
    have := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hBW1
      (by positivity : 0 ≤ Dm * K)) he0
    linarith
  have hP2 : 8 * (((lam : ℝ) + 1) * E + 1) * (BW + 1) ≤ 2 ^ P := by
    rw [← hK]
    have hK' : K * (BW + 1) * e ≤ Dm * K * (BW + 1) * e := by
      have := bud_one (by positivity : 0 ≤ K * (BW + 1) * e) hDm1
      exact this.trans (le_of_eq (by ring))
    have h : 8 * K * (BW + 1) * e ≤ 1 := by
      have : 8 * K * (BW + 1) * e = 8 * (K * (BW + 1) * e) := by ring
      linarith
    rw [he, mul_one_div, div_le_one hS] at h; exact h
  obtain ⟨ε2, hε2d⟩ : ∃ ε2 : ℝ, ε2 = 9 * (Dm * K * (BW + 1) * e) := ⟨_, rfl⟩
  have h2 : ∀ i ∈ range s, |(Y₂ i : ℝ) / 2 ^ P -
      Mv (blS B) (MiG s t α B) (fun k => (W k : ℝ) / 2 ^ P) i| ≤ ε2 := by
    intro i hi
    rw [hY₂]
    refine (applyMinv_err hB hs hst hα hx hT hE hlam W hBW0 hWb hP2 (mem_range.1 hi)).trans
      (le_of_eq ?_)
    rw [hdiv, ← hK, hε2d]; ring
  have hε2 : ε2 ≤ 18 * Ge := by rw [hε2d]; linarith
  -- stage 5: the capacitance residual
  obtain ⟨ε4, hε4d⟩ : ∃ ε4 : ℝ, ε4 = (4 * By + 2) * Q * e +
      (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) * Z :=
    ⟨_, rfl⟩
  have h4 : ∀ a ∈ (Jlist B).toFinset, |(z a : ℝ) / 2 ^ P + Mv (blS B) (MiG s t α B)
      (Dv (Hset B) (col B.s) (cfG s t α) (fun k => (z k : ℝ) / 2 ^ P)) a - (Y a : ℝ) / 2 ^ P| ≤
      ε4 := by
    intro a ha
    have ha' := Jlist_lt hJs ha
    have hr := hge.2 a (List.mem_toFinset.1 ha)
    have hc := cap_apply hB hs hst hα hx hT hE hlam hP100 ha ha' (fun k => (z k : ℝ) / 2 ^ P)
      hZ0 hz
    have e1 : ((4 * By + 2) * (((Jlist B).length : ℝ) + 1) ^ 2 / 2 ^ P) =
        (4 * By + 2) * Q * e := by rw [hdiv, hQ]
    rw [e1] at hr
    rw [abs_sub_comm] at hc
    have := abs_sub_le ((z a : ℝ) / 2 ^ P + Mv (blS B) (MiG s t α B)
      (Dv (Hset B) (col B.s) (cfG s t α) (fun k => (z k : ℝ) / 2 ^ P)) a)
      (∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * ((z k : ℝ) / 2 ^ P))
      ((Y a : ℝ) / 2 ^ P)
