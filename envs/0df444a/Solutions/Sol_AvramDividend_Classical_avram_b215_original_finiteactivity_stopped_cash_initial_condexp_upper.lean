  classical
  letI : IsProbabilityMeasure P := X.isProbability
  obtain ⟨MG, MJ, BG, BJ, G, J, E, hGI, hJI, hGconv, hJconv,
      hEconv, hBG, hBJ, hGdom, hJdom, hGzero, hJzero, hUpper⟩ :=
    avram_b216_original_two_channel_dominated_stopped_cash_mesh_witness
      X hX hBV hν hσ q hq w C hC hw0 hw_cont hw_neg hw_smooth
      hw_gen hw_grad x hx hxc D hD hw_nonneg hjump
      n hn σ hσstop hσbound F hFsource hFI hFiniteActivity
  have hBound := avram_jb24_finite_mesh_stopped_cash_condexp_upper
    (𝓕 := 𝓕) (w x) F MG MJ BG BJ G J E hFI hGI hJI
    hGconv hJconv hEconv hBG hBJ hGdom hJdom hGzero hJzero hUpper
  exact hBound.2.2.2.2
