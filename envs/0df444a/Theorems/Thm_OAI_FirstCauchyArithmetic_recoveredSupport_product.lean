theorem OAI.FirstCauchyArithmetic.recoveredSupport_product {ι : Type*} [DecidableEq ι]
    (P : ι → Ideal O) [∀ i, (P i).IsMaximal]
    (hinj : Function.Injective P) (B S : Finset ι) (hS : S ⊆ B) :
    recoveredSupport P B (∏ i ∈ S, P i) = S := by sorry
