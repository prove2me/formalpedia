variable (K : Type) [Field K] [NumberField K] [StarRing K] [IsTotallyComplex K]

theorem Formalism.LFunctionChainParameters.LChain2.scaled_std (n : Type) [Fintype n] [DecidableEq n] [Nonempty n] (c : ℝ) (hc : 0 < c) :
    muDef (Pi.basisFun K n) (fun _ => (c : ℂ) • (1 : Matrix n n ℂ)) (stdLat K n) = 2 * Real.log c ∧
    muMaxDef (Pi.basisFun K n) (fun _ => (c : ℂ) • (1 : Matrix n n ℂ)) (stdLat K n)
      = muMaxDef (Pi.basisFun K n) (fun _ => 1) (stdLat K n) + 2 * Real.log c := by sorry
