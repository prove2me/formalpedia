  fun index => state (_root_.InfoLossLAR.WorstCase.bundleOutput blocks index)
def bundleBitLaw (blocks : List _root_.InfoLossLAR.WorstCase.QuantumBlock) : _root_.AFT.FiniteDist (_root_.QAlgorithms.Complexity.Bits blocks.length) :=
  (_root_.InfoLossLAR.WorstCase.DecisionSearch.finalStateLaw (_root_.InfoLossLAR.WorstCase.bundleCircuit blocks) (_root_.InfoLossLAR.WorstCase.bundleState blocks) (_root_.InfoLossLAR.WorstCase.bundleState_mass blocks)).map (_root_.InfoLossLAR.WorstCase.DecisionSearch.bundleBits blocks)
end InfoLossLAR.WorstCase.DecisionSearch
