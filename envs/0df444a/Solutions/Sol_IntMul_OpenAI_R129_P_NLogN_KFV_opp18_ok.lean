theorem applyN_append (o1 o2 : List LOp) (a : List ℕ) :
    applyN (o1 ++ o2) a = applyN o2 (applyN o1 a) := by
  unfold applyN; rw [List.foldl_append]

theorem applyN_bm (A B X E : List ℕ) :
    applyN (bmOps A.length B.length X.length) (A ++ (B ++ (X ++ E))) = A ++ (X ++ (B ++ E)) := by
  unfold applyN bmOps
  rw [List.foldl_map]
  have e : ∀ t, (LOp.mv (A.length + t) (A.length + t + B.length)).idx =
      rotIdx (A.length + t) B.length 1 := fun t => by
    simp only [LOp.idx, Nat.add_sub_cancel_left]
  simp only [e]
  rw [rot_as_moves A.length B.length X.length _ (by simp; omega), permIdx_rot]

theorem applyN_gen : ∀ (xs : List (List ℕ × List ℕ × List ℕ)) (Ta Ra E : List ℕ),
    applyN (genOps Ta.length Ra.length xs) (Ta ++ (Ra ++ (xs.flatMap trip ++ E))) =
      Ta ++ (xs.flatMap tOf ++ (Ra ++ (xs.flatMap uvOf ++ E)))
  | [], Ta, Ra, E => by simp [genOps, applyN]
  | (U, T, V) :: xs, Ta, Ra, E => by
    simp only [genOps, applyN_append]
    have h1 : Ta ++ (Ra ++ (((U, T, V) :: xs).flatMap trip ++ E)) =
        Ta ++ ((Ra ++ U) ++ (T ++ (V ++ (xs.flatMap trip ++ E)))) := by
      simp [trip, List.append_assoc]
    rw [h1, show Ra.length + U.length = (Ra ++ U).length by simp, applyN_bm]
    have h2 : Ta ++ (T ++ ((Ra ++ U) ++ (V ++ (xs.flatMap trip ++ E)))) =
        (Ta ++ T) ++ ((Ra ++ U ++ V) ++ (xs.flatMap trip ++ E)) := by simp
    rw [h2, show Ta.length + T.length = (Ta ++ T).length by simp,
      show (Ra ++ U).length + V.length = (Ra ++ U ++ V).length by simp; omega, applyN_gen xs]
    simp [tOf, uvOf, List.append_assoc]

section Paper

variable (D ℓ K : ℕ) (long : Fin D → Bool)

theorem range_add_rev_map (f : ℕ → ℕ) (b Q : ℕ) :
    (List.range (b + Q)).reverse.map f =
      (List.range Q).reverse.map (fun t => f (b + t)) ++ (List.range b).reverse.map f := by
  rw [List.range_add, List.reverse_append, List.map_append, ← List.map_reverse, List.map_map]
  rfl

theorem axis_split (hK : 0 < K) (hℓ : 1 ≤ ℓ) (i : Fin D) :
    (List.range (Synth.al D ℓ long i)).reverse.map (nm D i) =
      topS D ℓ long i ++ (restA D ℓ K i ++ loS D ℓ K 0 i) := by
  have hq : ℓ - 1 = bb ℓ K + Synth.qq ℓ K * K := by
    unfold bb Synth.qq; rw [Nat.mul_comm]; exact (Nat.mod_add_div _ _).symm
  have e1 : (List.range (ℓ - 1)).reverse.map (nm D i) = restA D ℓ K i ++ loS D ℓ K 0 i := by
    rw [hq, range_add_rev_map]; simp [restA, loS]
  unfold Synth.al topS
  by_cases hl : long i
  · simp only [hl, if_true]
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
    simp only [Nat.add_sub_cancel] at e1 ⊢
    rw [List.range_succ, List.reverse_append, List.map_append, e1]
    simp
  · simp only [hl, Bool.false_eq_true, if_false, List.nil_append]
    exact e1

theorem initL_split (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    initL D ℓ long = (xs1 D ℓ K long).flatMap trip := by
  unfold initL xs1
  rw [List.flatMap_map]
  apply List.flatMap_congr
  intro i _
  rw [axis_split D ℓ K long hK hℓ i]; simp [trip]

theorem loS_succ {u : ℕ} (hu : u < bb ℓ K) (i : Fin D) :
    loS D ℓ K u i = nm D i (bb ℓ K - 1 - u) :: loS D ℓ K (u + 1) i := by
  unfold loS
  rw [show bb ℓ K - u = (bb ℓ K - (u + 1)) + 1 by omega, List.range_succ, List.reverse_append]
  simp only [List.reverse_singleton, List.singleton_append, List.map_cons]
  congr 2; omega

theorem loS_end (i : Fin D) : loS D ℓ K (bb ℓ K) i = [] := by simp [loS]

theorem flatMap_ite {α : Type*} (p : α → Bool) (f : α → ℕ) : ∀ l : List α,
    l.flatMap (fun i => if p i then [f i] else []) = (l.filter p).map f
  | [] => rfl
  | a :: l => by
    rw [List.flatMap_cons, List.filter_cons, flatMap_ite p f l]
    by_cases h : p a <;> simp [h]

/-- Phase 1. -/
theorem phase1 (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    applyN (genOps 0 0 (xs1 D ℓ K long)) (initL D ℓ long) =
      NLogN.KFV.pre2 D ℓ K long 0 ++ (List.finRange D).flatMap fun i => restA D ℓ K i ++ loS D ℓ K 0 i := by
  have H := applyN_gen (xs1 D ℓ K long) [] [] []
  simp only [List.length_nil, List.nil_append, List.append_nil] at H
  rw [initL_split D ℓ K long hK hℓ, H]
  unfold NLogN.KFV.pre2 xs1
  simp only [List.range_zero, List.flatMap_nil, List.append_nil, List.flatMap_map, tOf, uvOf,
    List.nil_append]
  congr 1
  unfold topS
  exact flatMap_ite _ _ _

theorem phase2_step {u : ℕ} (hu : u < bb ℓ K) :
    applyN (genOps (NLogN.KFV.pre2 D ℓ K long u).length 0 (xs2 D ℓ K u)) (NLogN.KFV.pre2 D ℓ K long u ++ arr2 D ℓ K u) =
      NLogN.KFV.pre2 D ℓ K long (u + 1) ++ arr2 D ℓ K (u + 1) := by
  have H := applyN_gen (xs2 D ℓ K u) (NLogN.KFV.pre2 D ℓ K long u) [] []
  simp only [List.length_nil, List.nil_append, List.append_nil] at H
  have e1 : (xs2 D ℓ K u).flatMap trip = arr2 D ℓ K u := by
    unfold xs2 arr2; rw [List.flatMap_map]
    apply List.flatMap_congr; intro i _
    rw [loS_succ D ℓ K hu i]; simp [trip]
  rw [e1] at H
  rw [H]
  unfold NLogN.KFV.pre2 xs2 arr2
  simp only [List.flatMap_map, tOf, uvOf, List.range_succ, List.flatMap_append, List.append_assoc]
  simp [List.map_eq_flatMap]

theorem phase2_all : ∀ u ≤ bb ℓ K,
    applyN ((List.range u).flatMap fun u' => genOps (NLogN.KFV.pre2 D ℓ K long u').length 0 (xs2 D ℓ K u'))
      (NLogN.KFV.pre2 D ℓ K long 0 ++ arr2 D ℓ K 0) = NLogN.KFV.pre2 D ℓ K long u ++ arr2 D ℓ K u
  | 0, _ => by simp [applyN]
  | u + 1, hu => by
    rw [List.range_succ, List.flatMap_append, applyN_append, phase2_all u (by omega)]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    exact phase2_step D ℓ K long (by omega)

theorem range_rev_eq (b : ℕ) : (List.range b).reverse = (List.range b).map (fun u => b - 1 - u) := by
  apply List.ext_getElem (by simp)
  intro k h1 h2
  simp only [List.getElem_reverse, List.getElem_range, List.getElem_map, List.length_range]

theorem flatMap_range_rev {β : Type*} (g : ℕ → List β) (b : ℕ) :
    (List.range b).reverse.flatMap g = (List.range b).flatMap fun u => g (b - 1 - u) := by
  rw [range_rev_eq, List.flatMap_map]

theorem pre2_end : NLogN.KFV.pre2 D ℓ K long (bb ℓ K) = lstL D ℓ K long := by
  unfold NLogN.KFV.pre2 lstL
  rw [flatMap_range_rev]

theorem arr2_end : arr2 D ℓ K (bb ℓ K) = (List.finRange D).flatMap (restA D ℓ K) := by
  unfold arr2
  apply List.flatMap_congr; intro i _
  simp [loS_end]

/-- **Phases 1–2**: the prefix `Lst` is in place, the chunks are in axis-major order. -/
theorem applyN_moves12 (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    applyN (moves12 D ℓ K long) (initL D ℓ long) =
      lstL D ℓ K long ++ (List.finRange D).flatMap (restA D ℓ K) := by
  unfold moves12
  rw [applyN_append, phase1 D ℓ K long hK hℓ]
  have e0 : (List.finRange D).flatMap (fun i => restA D ℓ K i ++ loS D ℓ K 0 i) = arr2 D ℓ K 0 := rfl
  rw [e0, phase2_all D ℓ K long _ le_rfl, pre2_end, arr2_end]

end Paper

end NLogN.KFV

