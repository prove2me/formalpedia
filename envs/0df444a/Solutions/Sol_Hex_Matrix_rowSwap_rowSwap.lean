namespace Matrix

/-- Swapping the same two rows twice restores the original matrix. -/
theorem p2m_solution_aux (M : Matrix R n m) (i j : Fin n) :
    rowSwap (rowSwap M i j) i j = M := by
  apply ext_getElem
  intro rr kk
  rw [getElem_rowSwap]
  by_cases hrj : rr = j
  · rw [ite_eq_left hrj]
    rw [getElem_rowSwap]
    by_cases hji : i = j
    · simp [hrj, hji]
    · simp [hrj, hji]
  · rw [ite_eq_right hrj]
    by_cases hri : rr = i
    · rw [ite_eq_left hri]
      rw [getElem_rowSwap]
      simp [hri]
    · rw [ite_eq_right hri]
      rw [getElem_rowSwap, ite_eq_right hrj, ite_eq_right hri]

end Matrix
end Hex
end

theorem solution.{u_1} : type_of% @Hex.Matrix.p2m_solution_aux.{u_1} := @Hex.Matrix.p2m_solution_aux.{u_1}
