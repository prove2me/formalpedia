private def x (j : Fin 270) (w : Fin 5) : ℚ :=
  (massNumerator j w : ℚ) / 1000000000000000000000000000000000000

private def lower (j : Fin 270) (w : Fin 5) : ℚ :=
  -(logLowerNumerator j w : ℚ) / 1000000000000

private def upper (j : Fin 270) (w : Fin 5) : ℚ :=
  -(logUpperNumerator j w : ℚ) / 1000000000000

private theorem log_bounds (j : Fin 270) (w : Fin 5)
    (hpos : 0 < x j w / ∑ v, x j v) :
    (lower j w : ℝ) ≤ Real.log ((x j w / ∑ v, x j v : ℚ) : ℝ) ∧
      Real.log ((x j w / ∑ v, x j v : ℚ) : ℝ) ≤ (upper j w : ℝ) := by
  apply mme_rational_log_series_certificate _ hpos (logScale j w) 16
  all_goals revert j w; decide +kernel

/-- The actual common-mode coarse marginal entropy retains its physical
mass and has a certified rational lower bound per released outer block. -/
theorem solution :
    (denominator : ℝ) ^ 5 * (735444403 / 1000000000 : ℝ) ≤
      coarsePotential (splitCount 2 1) 0 := by
  have hx : ∀ j w, 0 ≤ x j w := by decide +kernel
  have h := mme_rational_scaled_mass_entropy_sum_certificate x hx lower upper
    log_bounds ((denominator : ℝ) ^ 5) (by positivity) (735444403 / 1000000000)
    (by decide +kernel)
  have hid : ∀ j w, (denominator : ℚ) ^ 5 * x j w =
      (marginalCounts (splitCount 2 1) 0 j w : ℚ) := by
    decide +kernel
  have he (j : Fin 270) (w : Fin 5) :
      (denominator : ℝ) ^ 5 * (x j w : ℝ) =
        (marginalCounts (splitCount 2 1) 0 j w : ℝ) := by
    exact_mod_cast hid j w
  simp_rw [he] at h
  norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one, Rat.cast_zero] at h
  exact h


