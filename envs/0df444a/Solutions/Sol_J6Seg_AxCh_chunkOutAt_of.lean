-- Source module: Solutions.J6SegKr10
/-!
# B3 (chunk kernel), part 10: the line's chunk kernel as a `RowBody6` procedure

* `blFrom_bnd`, `descsOf_ok`, `sumN_descsOf`: the block descriptors of a chunk have lengths
  `1 ≤ n ≤ λ`, tables of length `n`, and total length `≤ λ`;
* **`chunkK_rowBody6`**: if procedure `e` is `chunkI pM`, it is a `RowBody6` row kernel for the
  line's chunk kernel `liftG (chunkK P R s t λ α q)` with the tables
  `tabK P pk b λ diL giL gamL ddL (descsOf … q)` (= `chunkTab6` at the round-six parameters).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

section desc
variable {s t lam : ℕ}

theorem blFrom_bnd (hl : 1 ≤ lam) (c : ℕ) : ∀ (f st : ℕ), c * lam ≤ st →
    (∀ b ∈ blFrom s t lam (min s (c * lam + lam)) f st, 1 ≤ b.2 ∧ b.2 ≤ lam) ∧
    ((blFrom s t lam (min s (c * lam + lam)) f st).map Prod.snd).sum + st ≤
      max st (c * lam + lam)
  | 0, st, _ => by simp [blFrom]
  | f + 1, st, hst => by
    unfold blFrom
    split_ifs with h
    · have he := en_le_chunk (s := s) (t := t) hl hst (lt_of_lt_of_le h (min_le_right _ _))
      obtain ⟨ih1, ih2⟩ := blFrom_bnd hl c f (st + 1 + enF s t lam st) (by omega)
      refine ⟨fun b hb => ?_, ?_⟩
      · rcases List.mem_cons.1 hb with rfl | hb
        · simp only; omega
        · exact ih1 b hb
      · simp only [List.map_cons, List.sum_cons]
        have : max (st + 1 + enF s t lam st) (c * lam + lam) = c * lam + lam := by omega
        rw [this] at ih2
        omega
    · simp

theorem sumN_map (l : List (ℕ × ℕ)) (F G : ℕ → ℕ → ℤ) :
    sumN (l.map fun b => (b.2, (List.range b.2).map (F b.1), (List.range b.2).map (G b.1))) =
      (l.map Prod.snd).sum := by
  induction l with
  | nil => rfl
  | cons b l ih => simp only [List.map_cons, sumN, List.sum_cons]; rw [ih]

theorem sumN_descsOf (hl : 1 ≤ lam) (T : Tables) (c : ℕ) : sumN (descsOf s t lam T c) ≤ lam := by
  unfold descsOf chunkBl
  rw [sumN_map]
  have := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).2
  omega

theorem descsOf_ok (hl : 1 ≤ lam) (T : Tables) (c : ℕ) :
    ∀ d ∈ descsOf s t lam T c, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
      (∀ v ∈ d.2.1, ∃ h < d.1, ∃ c', v = T.am c' h) ∧ (∀ v ∈ d.2.2, ∃ h < d.1, ∃ c', v = T.ap c' h) := by
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  obtain ⟨h1, h2⟩ := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).1 b hb
  refine ⟨h1, by simp, by simp, h2, ?_, ?_⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩

end desc

end J6Seg.KR

end

section
-- Source module: Solutions.J6SegVal4
/-!
# B-line value bounds 4: size arithmetic at `Q = segPF p d s`

All from the definition `segPF p d s = p + 1 + p/7 + size (NF d s)`, with
`NF d s ≥ (λ_F + 1)(2w + 1)(s + 1)²` (no regime hypotheses):
`p + 1 ≤ Q`, `7(R + 2) ≤ Q + 13`, `log₂ λ_F < Q`, `size (2w+1) ≤ Q`, `(s+1)² < 2^Q`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Val
open J6Seg

section ar
variable (p d s : ℕ)

theorem NF_pos_factors : (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 ≤ NF d s := by
  unfold NF
  have h1 : 1 ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) := by omega
  calc (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      = 1 * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := by ring
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) *
        (s + 1) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
        exact h1

theorem NF_lt_Q : NF d s < 2 ^ segPF p d s := by
  have h := Nat.lt_size_self (NF d s)
  exact h.trans_le (Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega))

theorem le_NF_lam : lamF d + 1 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (2 * wF d + 1) * (s + 1) ^ 2 := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc lamF d + 1 = (lamF d + 1) * 1 := by ring
    _ ≤ (lamF d + 1) * ((2 * wF d + 1) * (s + 1) ^ 2) := Nat.mul_le_mul_left _ h2
    _ = _ := by ring
    _ ≤ _ := this

theorem sevenR_le_Q : 7 * (p / 7 + 2) ≤ segPF p d s + 13 := by
  unfold segPF; omega

theorem log_lam_lt_Q : Nat.log 2 (lamF d) < segPF p d s := by
  have h1 : lamF d < 2 ^ segPF p d s :=
    lt_of_lt_of_le (by have := le_NF_lam d s; omega) (NF_lt_Q p d s).le
  by_cases h0 : lamF d = 0
  · rw [h0, Nat.log_zero_right]; unfold segPF; omega
  · have h2 := Nat.pow_log_le_self 2 h0
    have h3 : 2 ^ Nat.log 2 (lamF d) < 2 ^ segPF p d s := lt_of_le_of_lt h2 h1
    exact (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3

end ar

end J6Seg.Val

end

