-- title:
--   Primes of F⊗_S B versus minimal primes of B
-- statement:
--   Let $A$ and $B$ be commutative rings with $B$ an $A$-algebra, and let $j_0\in B$. Write $S=\mathrm{Algebra.adjoin}\ A\ \{j_0\}$ for the $A$-subalgebra of $B$ generated by $j_0$, and assume: $S$ is a domain; $B$ is integral over $S$; and every minimal prime $\mathfrak p$ of the zero ideal of $B$ contracts to $(0)$ along $\mathrm{algebraMap}\ S\ B$, i.e. $\mathfrak p\cap S=0$. Put $F=\mathrm{FractionRing}\ S$, $R=F\otimes_S B$, and let $\iota_R\colon B\to R$ be the $S$-algebra map $\mathrm{Algebra.TensorProduct.includeRight}$, $b\mapsto 1\otimes b$. The conclusion is the conjunction of three assertions: (i) for every prime ideal $\mathfrak P$ of $R$, the contraction $\iota_R^{-1}(\mathfrak P)$ lies in the set of minimal primes of $(0)\subseteq B$; (ii) for every minimal prime $\mathfrak p$ of $(0)\subseteq B$ there is exactly one ideal $\mathfrak P$ of $R$ that is prime and satisfies $\iota_R^{-1}(\mathfrak P)=\mathfrak p$; (iii) for every $A$-algebra automorphism $e$ of $B$ with $e(j_0)=j_0$ there exists an $F$-algebra automorphism $\tilde e$ of $R$ with $\tilde e(\iota_R(b))=\iota_R(e(b))$ for all $b\in B$.
--
--   This is the commutative-algebra dictionary between the irreducible components of $\operatorname{Spec} B$ and the points of the generic fibre of $\operatorname{Spec} B\to\operatorname{Spec} A[j_0]$, together with the statement that automorphisms fixing $j_0$ act compatibly on that fibre. It is applied in the analysis of modular curves of full and of $\Gamma_0$-type level structure, where $B$ is a ring of functions, $j_0$ the $j$-invariant, and the counting of minimal primes (the components) and their permutation under the diamond operators is needed.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Ideal_minimalPrimes_tensorProduct_fractionRing_dictionary.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open scoped TensorProduct

theorem Ideal.minimalPrimes_tensorProduct_fractionRing_dictionary
    (A B : Type) [CommRing A] [CommRing B] [Algebra A B] (j₀ : B)
    [IsDomain ↥(Algebra.adjoin A ({j₀} : Set B))]
    (hint : Algebra.IsIntegral ↥(Algebra.adjoin A ({j₀} : Set B)) B)
    (hdom : ∀ 𝔭 ∈ (⊥ : Ideal B).minimalPrimes,
      Ideal.comap (algebraMap ↥(Algebra.adjoin A ({j₀} : Set B)) B) 𝔭 = ⊥) :
    letI S := ↥(Algebra.adjoin A ({j₀} : Set B))
    letI F := FractionRing S
    letI R := F ⊗[S] B
    letI ιR : B →ₐ[S] R := Algebra.TensorProduct.includeRight
    (∀ 𝔓 : Ideal R, 𝔓.IsPrime → Ideal.comap ιR 𝔓 ∈ (⊥ : Ideal B).minimalPrimes) ∧
    (∀ 𝔭 ∈ (⊥ : Ideal B).minimalPrimes, ∃! 𝔓 : Ideal R, 𝔓.IsPrime ∧ Ideal.comap ιR 𝔓 = 𝔭) ∧
    (∀ e : B ≃ₐ[A] B, e j₀ = j₀ →
      ∃ ee : R ≃ₐ[F] R, ∀ b : B, ee (ιR b) = ιR (e b)) := by sorry
