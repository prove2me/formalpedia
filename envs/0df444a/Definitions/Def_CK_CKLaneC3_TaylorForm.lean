  have h2 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d3 (ys + u * (y - ys)) * (y - ys) ^ 2)
      (j.d4 (ys + u * (y - ys)) * (y - ys) ^ (2 + 1)) u := by
    intro u hu
