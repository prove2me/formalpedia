open UpperHalfPlane ModularCurve

theorem ModularCurve.isIntegral_adjoin_coeffEmb_jq_inv_of_mul_thetaL_eq_qExpansion (N : ℕ)
    [NeZero N] (f : CuspForm (CongruenceSubgroup.Gamma0 N) 2) (Y : LaurentSeries ℂ)
    (hY : Y * thetaL ℂ (coeffEmb ℂ jq) =
      ((qExpansion 1 (f : ℍ → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ)) :
    IsIntegral (Algebra.adjoin ℂ ({(coeffEmb ℂ jq)⁻¹} : Set (LaurentSeries ℂ)))
      (Y ^ (2 * N) * coeffEmb ℂ jq ^ (N + 1) * (coeffEmb ℂ jq - 1728) ^ N) := by sorry
