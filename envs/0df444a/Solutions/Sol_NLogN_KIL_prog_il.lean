  have S8 := Sp.popI ((t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 3) (by decide)
    (a := ((PL : ℕ) : ℤ)) (L := t.G 3) (by simp [t5, t4, t3, t2, t1, t0, IState.upd_G]) zPL
  have S9 := Sp.popI (((t5.upd 1 (t.G 1)).upd 2 (t.G 2)).upd 3 (t.G 3)) (i := 4) (by decide)
