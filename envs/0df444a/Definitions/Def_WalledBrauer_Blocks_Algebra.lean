-- title:
--   The walled Brauer algebra $B_{r,s}(\delta)$, the diagrams $E_{i,j}$, $X_t$, permutation diagrams and the ideals $J_t$ (pp. 3–5, 11)
-- statement:
--   Fix $r,s\in\mathbb N$, a field $k$ and $\delta\in k$. Put a wall after the first $r$ northern nodes and after the first $r$ southern nodes of a Brauer diagram on $r+s$ strands. A **walled Brauer diagram** is a Brauer diagram in which no propagating line crosses the wall and every northern or southern arc does. These diagrams are closed under the stacking product. The **walled Brauer algebra** $B_{r,s}(\delta)$ is their $k$-span with the product $A\cdot B=\delta^{t(A,B)}(A\circ B)$, a subalgebra of $B_{r+s}(\delta)$ (p. 3).
--
--   This file also fixes the following elements and ideals.
--
--   1. The **permutation diagram** of $\sigma\in\Sigma_r\times\Sigma_s=\Sigma_{r,s}$. It has no arcs, and these diagrams span $k\Sigma_{r,s}\subseteq B_{r,s}(\delta)$.
--   2. For $1\le i\le r<j\le r+s$, the diagram $E_{i,j}$ (p. 11). It has the northern arc $\{i,j\}$, the southern arc $\{\bar i,\bar j\}$, and propagating lines $u$ — $\bar u$ for $u\ne i,j$.
--   3. For $0\le t\le\min(r,s)$, the diagram $X_t$. It has the northern and southern arcs $r-u$ — $r+1+u$ for $0\le u<t$ (the arcs of $e_{r,s,t}$, p. 5) and propagating lines elsewhere.
--   4. The ideal $J_t$ (Proposition 2.3, p. 5). It is spanned by the diagrams with at least $t$ northern arcs, that is, with propagating vector $(a,b)$, $a\le r-t$, $b\le s-t$.
--
--   **Formalization Note** Proving associativity of diagram composition is real work, so $B_{r,s}(\delta)$ is realised through its left regular representation, without an associativity proof. On the space with basis the walled diagrams, left multiplication by $A$ is the matrix sending $e_B$ to $\delta^{t(A,B)}e_{A\circ B}$. $B_{r,s}(\delta)$ is the subalgebra of this matrix algebra generated by these matrices (`Algebra.adjoin`). The map $A\mapsto$ (left multiplication by $A$) is the left regular representation of the paper's associative unital algebra, so it is an algebra homomorphism. It is injective, since the matrix of $A$ sends $e_{\mathrm{id}}$ to $e_A$. So the subalgebra is isomorphic to $B_{r,s}(\delta)$, and its elements are exactly the linear combinations of the matrices of diagrams. Nodes are 0-based, with node $a$ left of the wall iff $a<r$. In this numbering the arcs of $X_t$ join $r-1-u$ and $r+u$. `ofPairing` falls back to the identity diagram when its argument is not a walled diagram; it is applied only to walled diagrams (side-preserving permutations, $i<r\le j$ for $E_{i,j}$, $t\le\min(r,s)$ for $X_t$). $J_t$ is the left ideal generated by its diagrams. That left ideal equals their $k$-span, because the number of arcs cannot decrease under multiplication (p. 5).
-- source:
--   Cox, De Visscher, Doty & Martin, On the blocks of the walled Brauer algebra, arXiv:0709.0851v1, pp. 3–5, Section 2 and Proposition 2.3; p. 11 (E_{i,j})

import Mathlib
import Definitions.Def_WalledBrauer_Blocks_Diagram

namespace WalledBrauer.Blocks

/-- Whether a node is northern. -/
def Node.isNorth {n : ℕ} : Node n → Bool
  | Sum.inl _ => true
  | Sum.inr _ => false

/-- The position `0, …, n-1` of a node in its row. -/
def Node.pos {n : ℕ} : Node n → Fin n
  | Sum.inl i => i
  | Sum.inr i => i

/-- The walled condition on a diagram on `r + s` strands with the wall after the first `r`
nodes of each row (p. 3): no propagating line crosses the wall, and every northern or southern
arc crosses it. -/
def IsWalled (r s : ℕ) (f : Node (r + s) → Node (r + s)) : Prop :=
  ∀ x, (x.isNorth = (f x).isNorth → ((x.pos.val < r) ↔ ¬ ((f x).pos.val < r))) ∧
    (x.isNorth ≠ (f x).isNorth → ((x.pos.val < r) ↔ ((f x).pos.val < r)))

/-- Walled Brauer diagrams: the basis of `B_{r,s}(δ)` (p. 3). -/
def WalledDiagram (r s : ℕ) := {f : Node (r + s) → Node (r + s) // IsBrauerDiagram f ∧ IsWalled r s f}

namespace WalledDiagram

variable {r s : ℕ}

/-- The underlying Brauer diagram on `r + s` strands. -/
def toBrauer (A : WalledDiagram r s) : BrauerDiagram (r + s) := ⟨A.1, A.2.1⟩

/-- The identity diagram. -/
def one (r s : ℕ) : WalledDiagram r s :=
  ⟨Sum.swap, (BrauerDiagram.one (r + s)).2, fun x => by cases x <;> simp [Node.isNorth, Node.pos]⟩

open scoped Classical in
/-- The walled diagram with the given pairing; the fallback (identity) is used only when the
pairing is not a walled Brauer diagram, which never happens where this is applied. -/
noncomputable def ofPairing (f : Node (r + s) → Node (r + s)) : WalledDiagram r s :=
  if h : IsBrauerDiagram f ∧ IsWalled r s f then ⟨f, h⟩ else one r s

/-- The diagram `C` of the product `AB = δ^t C` (stack `A` over `B`). Walled diagrams are closed
under this product (p. 3). -/
noncomputable def comp (A B : WalledDiagram r s) : WalledDiagram r s :=
  ofPairing (A.toBrauer.comp B.toBrauer).1

/-- The number of northern arcs of a walled diagram (each has its left end at a node `< r`). -/
noncomputable def numNorthArcs (A : WalledDiagram r s) : ℕ :=
  Nat.card {i : Fin (r + s) // i.val < r ∧ ∃ j, A.1 (Sum.inl i) = Sum.inl j}

/-- The permutation diagram of `σ ∈ Σ_{r+s}`: northern node `i` is joined to southern node
`σ i`. It is walled exactly when `σ ∈ Σ_r × Σ_s = Σ_{r,s}`, the only case in which it is used. -/
noncomputable def perm (σ : Equiv.Perm (Fin (r + s))) : WalledDiagram r s :=
  ofPairing fun x => match x with
    | Sum.inl i => Sum.inr (σ i)
    | Sum.inr j => Sum.inl (σ.symm j)

open scoped Classical in
/-- The diagram `E_{i,j}` (p. 11) for `i < r ≤ j`: the northern arc `{i, j}`, the southern arc
`{i, j}` and the propagating lines `u — u` for `u ≠ i, j`. -/
noncomputable def E (i j : Fin (r + s)) : WalledDiagram r s :=
  ofPairing fun x => match x with
    | Sum.inl u => if u = i then Sum.inl j else if u = j then Sum.inl i else Sum.inr u
    | Sum.inr u => if u = i then Sum.inr j else if u = j then Sum.inr i else Sum.inl u

/-- The partner `2r - 1 - a` of node `a` in the arc configuration of `X_t` (0-based version of
the paper's arcs `r - u — r + 1 + u`). -/
def arcPartner (a : Fin (r + s)) : Fin (r + s) :=
  if h : 2 * r - 1 - a.val < r + s then ⟨2 * r - 1 - a.val, h⟩ else a

/-- Whether node `a` is an end of one of the `t` arcs of `X_t`: `r - t ≤ a < r + t`. -/
def inArcZone (t : ℕ) (a : Fin (r + s)) : Prop := r - t ≤ a.val ∧ a.val < r + t

open scoped Classical in
/-- `X_t` (`t ≤ min(r, s)`): northern and southern arcs joining `r - 1 - u` and `r + u`
for `0 ≤ u < t` (0-based; the paper's `r - u — r + 1 + u`, the arcs of `e_{r,s,t}`, p. 5) and
propagating lines `a — a` at the other nodes. -/
noncomputable def arcDiagram (t : ℕ) : WalledDiagram r s :=
  ofPairing fun x => match x with
    | Sum.inl a => if inArcZone (r := r) (s := s) t a then Sum.inl (arcPartner a) else Sum.inr a
    | Sum.inr a => if inArcZone (r := r) (s := s) t a then Sum.inr (arcPartner a) else Sum.inl a

end WalledDiagram

variable (k : Type*) [Field k]

/-- There are finitely many walled diagrams. -/
instance (r s : ℕ) : Finite (WalledDiagram r s) := Subtype.finite

/-- The finite set of walled diagrams. -/
noncomputable instance (r s : ℕ) : Fintype (WalledDiagram r s) := Fintype.ofFinite _

/-- Equality of walled diagrams is decidable. -/
instance (r s : ℕ) : DecidableEq (WalledDiagram r s) :=
  inferInstanceAs
    (DecidableEq {f : Node (r + s) → Node (r + s) // IsBrauerDiagram f ∧ IsWalled r s f})

/-- Left multiplication by the walled diagram `A` on the space `k^{walled diagrams}` with basis
the walled diagrams `e_B`, as a matrix: `e_B ↦ δ^{t(A,B)} e_{A ∘ B}`, where `t(A,B)` is the
number of closed loops formed when `A` is stacked over `B` (p. 3). The entry in row `C`,
column `B` is `δ^{t(A,B)}` if `C = A ∘ B` and `0` otherwise. -/
noncomputable def leftMul {r s : ℕ} (δ : k) (A : WalledDiagram r s) :
    Matrix (WalledDiagram r s) (WalledDiagram r s) k :=
  fun C B => if WalledDiagram.comp A B = C then δ ^ loops A.1 B.1 else 0

/-- The walled Brauer algebra `B_{r,s}(δ)` (p. 3), realised through its (faithful) left regular
representation: the subalgebra of the matrix algebra on the walled diagrams generated by the
left multiplications by walled diagrams. Its elements are exactly the linear combinations of
the `leftMul δ A`. -/
noncomputable def walledBrauerSubalgebra (r s : ℕ) (δ : k) :
    Subalgebra k (Matrix (WalledDiagram r s) (WalledDiagram r s) k) :=
  Algebra.adjoin k (Set.range (leftMul k δ))

/-- `B_{r,s}(δ)` as a type. -/
def WalledBrauerAlgebra (r s : ℕ) (δ : k) : Type _ := ↥(walledBrauerSubalgebra k r s δ)

noncomputable instance (r s : ℕ) (δ : k) : Ring (WalledBrauerAlgebra k r s δ) :=
  inferInstanceAs (Ring ↥(walledBrauerSubalgebra k r s δ))

noncomputable instance (r s : ℕ) (δ : k) : Algebra k (WalledBrauerAlgebra k r s δ) :=
  inferInstanceAs (Algebra k ↥(walledBrauerSubalgebra k r s δ))

variable {k}

/-- The basis element of `B_{r,s}(δ)` given by a walled diagram. -/
noncomputable def diag {r s : ℕ} {δ : k} (A : WalledDiagram r s) : WalledBrauerAlgebra k r s δ :=
  (⟨leftMul k δ A, Algebra.subset_adjoin (Set.mem_range_self A)⟩ : walledBrauerSubalgebra k r s δ)

/-- The ideal `J_t` (Proposition 2.3, p. 5): spanned by the diagrams with at least `t` northern
arcs (propagating vector `(a, b)` with `a ≤ r - t`, `b ≤ s - t`). Generated here as a left
ideal; it is a two-sided ideal with exactly these diagrams as a basis. -/
noncomputable def cellIdeal (r s : ℕ) (δ : k) (t : ℕ) :
    Submodule (WalledBrauerAlgebra k r s δ) (WalledBrauerAlgebra k r s δ) :=
  Submodule.span (WalledBrauerAlgebra k r s δ)
    {x | ∃ A : WalledDiagram r s, t ≤ A.numNorthArcs ∧ x = diag A}

end WalledBrauer.Blocks


