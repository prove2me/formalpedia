theorem _root_.solution {t s : ℝ} (ht : 0 ≤ t) (hs : 0 ≤ s) :
    planarAmplitude t s ≤ Real.exp (3 * t) := by
  simpa only [Real.exp_log (planarAmplitude_pos ht hs)] using
    Real.exp_le_exp.mpr (log_planarAmplitude_upper_bound ht hs)
end Eden
