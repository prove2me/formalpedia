  unfold _root_.LIDT.MIPStarRE.LDT.Pasting.qBipartiteLinearConsDefect
  rw [hdiff_sum]
  rw [Fintype.sum_option]
  simp [hAnone, hBnone, _root_.LIDT.MIPStarRE.LDT.opTensor, _root_.LIDT.MIPStarRE.LDT.ev_zero]
