-- title:
--   Smoothness of the projective Weierstrass model from two charts
-- statement:
--   Let $R$ be a commutative ring and let $V$ be a projective Weierstrass curve over $R$ whose discriminant is a unit (`V.IsElliptic`). Write $B$ for the quotient of $R[X_0,X_1,X_2]$ by the ideal generated by the homogeneous Weierstrass cubic `V.polynomial`, graded by the submodules $B_i$ obtained as images of the homogeneous degree-$i$ submodules of $R[X_0,X_1,X_2]$ under the quotient map, this grading being `projModelGradingCR V`. Two hypotheses are assumed. First, there exists a ring homomorphism $f$ from the degree-zero part of the homogeneous localisation of $B$ away from the class of $X_2$ to $R[X][Y]/(\,$`V.toAffine.polynomial`$\,)$ which is bijective and satisfies: $f$ composed with the canonical map $B_0 \to$ (that degree-zero part) composed with the structure map $R \to B_0$ equals the algebra map of $R$ into $R[X][Y]/(\,$`V.toAffine.polynomial`$\,)$. Second, the composite of $R \to B_0$ with the canonical map of $B_0$ into the degree-zero part of the homogeneous localisation of $B$ away from the class of $X_1$ is smooth in the sense of `RingHom.Smooth`. The conclusion is that the morphism `projModelStrCR V`, namely $\operatorname{Proj} B \to \operatorname{Spec} B_0 \to \operatorname{Spec} R$, is a smooth morphism of schemes.
--
--   This is the chart-by-chart reduction for smoothness of the projective Weierstrass model over a base ring: the $X_2$-chart is identified with the affine Weierstrass curve and the $X_1$-chart is assumed smooth, the two basic opens covering $\operatorname{Proj} B$. It is used by [`WeierstrassProjModel.projModelStrCR_smooth`](thm.html#WeierstrassProjModel.projModelStrCR_smooth), where both hypotheses are discharged for an elliptic $V$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WeierstrassProjModel_projModelStrCR_smooth_of_zChartBridge_of_yChartSmooth.lean

import Definitions.Def_WeierstrassCurve_ProjModel
import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Mathlib.RingTheory.RingHom.Smooth

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

attribute [local instance] MvPolynomial.gradedAlgebra in

theorem WeierstrassProjModel.projModelStrCR_smooth_of_zChartBridge_of_yChartSmooth
    {R : Type} [CommRing R] (V : WeierstrassCurve.Projective R) [V.IsElliptic]
    (hbr : ∃ f : HomogeneousLocalization.Away (WeierstrassProjModel.projModelGradingCR V)
          (Ideal.Quotient.mk (WeierstrassProjModel.projModelHomogeneousIdealCR V).toIdeal
            (MvPolynomial.X 2 : MvPolynomial (Fin 3) R)) →+*
        (Polynomial (Polynomial R) ⧸ Ideal.span {V.toAffine.polynomial}),
      Function.Bijective f ∧
        f.comp ((HomogeneousLocalization.fromZeroRingHom
              (WeierstrassProjModel.projModelGradingCR V)
              (Submonoid.powers (Ideal.Quotient.mk
                (WeierstrassProjModel.projModelHomogeneousIdealCR V).toIdeal
                (MvPolynomial.X 2 : MvPolynomial (Fin 3) R)))).comp
            (algebraMap R (WeierstrassProjModel.projModelGradingCR V 0))) =
          algebraMap R (Polynomial (Polynomial R) ⧸ Ideal.span {V.toAffine.polynomial}))
    (hy : RingHom.Smooth ((HomogeneousLocalization.fromZeroRingHom
            (WeierstrassProjModel.projModelGradingCR V)
            (Submonoid.powers (Ideal.Quotient.mk
              (WeierstrassProjModel.projModelHomogeneousIdealCR V).toIdeal
              (MvPolynomial.X 1 : MvPolynomial (Fin 3) R)))).comp
          (algebraMap R (WeierstrassProjModel.projModelGradingCR V 0)))) :
    AlgebraicGeometry.Smooth (WeierstrassProjModel.projModelStrCR V) := by sorry
