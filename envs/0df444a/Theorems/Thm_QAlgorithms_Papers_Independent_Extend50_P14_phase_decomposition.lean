-- title:
--   Theorem 12: phase decomposition with finite correction
-- statement:
--   For n≥1 define D_l=C_l/[2^n binom(n,l)] and let G_0 be generated by exp(2πiD_l), 0≤l≤n. This group is finite. For any invariant unitary V, write φ_l∈(-π,π] for its principal l-body phase. There are V_0∈G_0 and V_2∈G_2 such that
--
--   $$V=V_0\left[\prod_{l=0}^n e^{i\varphi_lD_l}\right]V_2.$$
--
--   Here G_2 is generated by exchange and Z evolutions. No uniqueness is asserted.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 33, Theorem 12: decomposition by l-body phases and a finite correction

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.33, D16: no uniqueness, all weights 0,...,n, and the actual finite
correction D15. The sign is the plus sign in the displayed theorem. -/
theorem phase_decomposition (n : ℕ) (hn : 1 ≤ n) :
    (u1FinitePhaseGroup n : Set (QMat n)).Finite ∧
    ∀ V : QMat n, U1Unitary V → ∃ V0 V2 : QMat n,
      V0 ∈ u1FinitePhaseGroup n ∧ V2 ∈ xyZGroup n ∧ V = V0 * u1PhaseFactor V * V2 := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
