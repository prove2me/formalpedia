section

variable (t : GL (Fin 3) ℚ) (v : HeightOneSpectrum (𝓞 ℚ)) (α : (v.adicCompletion ℚ)ˣ)

private def dualTorus : LocalGL3 v := Matrix.GeneralLinearGroup.scalar (Fin 3) (α⁻¹ ^ 2) * localTorus t v

private theorem coe_localTorus_of_coe_eq {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    (localTorus t v : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![(α : v.adicCompletion ℚ) ^ 2, (α : v.adicCompletion ℚ), 1] := by
  rw [coe_localTorus t v ht]
  congr 1
  ext i
  fin_cases i <;> simp [hα]

private theorem coe_localTorus_inv
    {a : ℚ} (ha : a ≠ 0) (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    (((localTorus t v)⁻¹ : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![((α : v.adicCompletion ℚ) ^ 2)⁻¹, (α : v.adicCompletion ℚ)⁻¹, 1] := by
  rw [localTorus, ← map_inv,
    TorusDilation.coe_map_eq_diagonal _ (TorusDilation.coe_inv_of_coe_eq_diagonal ha t ht)]
  congr 1
  ext i
  fin_cases i <;> simp [hα]

private theorem coe_transposeInv3_localTorus {a : ℚ} (ha : a ≠ 0)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    (transposeInv3 (localTorus t v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![((α : v.adicCompletion ℚ) ^ 2)⁻¹, (α : v.adicCompletion ℚ)⁻¹, 1] :=
  coe_transposeInv3_of_coe_inv_eq_diagonal (coe_localTorus_inv t v α ha ht hα)

private theorem coe_dualTorus {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    (dualTorus t v α : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
      Matrix.diagonal ![1, (α : v.adicCompletion ℚ)⁻¹, ((α : v.adicCompletion ℚ) ^ 2)⁻¹] := by
  have h0 : (α : v.adicCompletion ℚ) ≠ 0 := α.ne_zero
  rw [dualTorus, Units.val_mul, ScalarComponents.coe_glScalar, Matrix.scalar_apply,
    coe_localTorus_of_coe_eq t v α ht hα, Matrix.diagonal_mul_diagonal]
  congr 1
  ext i
  fin_cases i <;> simp [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val]
  field_simp

private theorem longWeyl3_mul_transposeInv3_dualTorus {a : ℚ} (ha : a ≠ 0)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    longWeyl3 * transposeInv3 (dualTorus t v α) = localTorus t v * longWeyl3 := by
  have h0 : (α : v.adicCompletion ℚ) ≠ 0 := α.ne_zero
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, dualTorus, transposeInv3_glScalar_mul, Units.val_mul,
    ScalarComponents.coe_glScalar, Matrix.scalar_apply, coe_transposeInv3_localTorus t v α ha ht hα,
    coe_localTorus_of_coe_eq t v α ht hα, Matrix.diagonal_mul_diagonal]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [longWeyl3, Matrix.mul_apply, Matrix.diagonal]
  field_simp

private theorem dualTorus_mul_iotaGL_diagUnitGL2_mul_lowerUnipotent21 {a : ℚ}
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) (y : (v.adicCompletion ℚ)ˣ)
    (x : v.adicCompletion ℚ) :
    dualTorus t v α * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x) =
      iotaGL (diagUnitGL2 y) * lowerUnipotent21 ((α : v.adicCompletion ℚ)⁻¹ * x) * dualTorus t v α := by
  refine Units.ext ?_
  simp only [Units.val_mul, coe_dualTorus t v α ht hα, TorusPoints.coe_iotaGL_diagUnitGL2]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [lowerUnipotent21, Matrix.mul_apply, Matrix.diagonal]

private theorem dualTorus_mul_weylPrime3 {a : ℚ} (ha : a ≠ 0)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) :
    dualTorus t v α * weylPrime3 =
      Matrix.GeneralLinearGroup.scalar (Fin 3) α⁻¹ *
        (iotaGL (diagUnitGL2 (α ^ 3)) * (weylPrime3 * transposeInv3 (localTorus t v))) := by
  have h0 : (α : v.adicCompletion ℚ) ≠ 0 := α.ne_zero
  refine Units.ext ?_
  simp only [Units.val_mul, coe_dualTorus t v α ht hα, ScalarComponents.coe_glScalar, Matrix.scalar_apply,
    TorusPoints.coe_iotaGL_diagUnitGL2, coe_transposeInv3_localTorus t v α ha ht hα, Units.val_pow_eq_pow_val,
    Units.val_inv_eq_inv_val]
  ext i j
  simp only [Matrix.diagonal_mul, Matrix.mul_diagonal]
  fin_cases i <;> fin_cases j <;> simp [weylPrime3] <;> field_simp

private theorem dualWhittakerFn3_transported {a : ℚ} (ha : a ≠ 0)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a) (W : LocalGL3 v → ℂ) (h : LocalGL3 v) :
    dualWhittakerFn3 (transported t W) h = dualWhittakerFn3 W (dualTorus t v α * h) := by
  rw [dualWhittakerFn3_apply, transported_apply, dualWhittakerFn3_apply, transposeInv3_mul, ← mul_assoc, ← mul_assoc,
    longWeyl3_mul_transposeInv3_dualTorus t v α ha ht hα]

end
