    generalize decode [vol A, F, vol M, F, vol C] j = D at hval
    rcases hval with _ | ⟨ha, _ | ⟨h1, _ | ⟨hm, _ | ⟨h2, _ | ⟨hc, h⟩⟩⟩⟩⟩
    cases h
    exact ⟨_, _, _, _, _, rfl, ha, h1, hm, h2, hc⟩
  have hj : j = encode [vol A, F, vol M, F, vol C] [a, f1, m, f2, c] := by
    rw [← hdec, encode_decode h2]
  have hDv : Valid (A ++ F :: M ++ F :: C) (decode A a ++ f1 :: decode M m ++ f2 :: decode C c) := by
    rw [show A ++ F :: M ++ F :: C = A ++ (F :: (M ++ F :: C)) by simp,
      show decode A a ++ f1 :: decode M m ++ f2 :: decode C c =
        decode A a ++ (f1 :: (decode M m ++ f2 :: decode C c)) by simp]
