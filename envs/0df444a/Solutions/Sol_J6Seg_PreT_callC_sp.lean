-- Source module: Solutions.J6SegILPre2
/-!
# B-line IL, pre-tables (B5), part 2: the register file and the basic steps

The pre-table programs keep their values in the registers `rg` (one integer each) and write
their outputs onto stacks outside `rg`. The managed state is `RF v c`: register `j ∈ rg` holds
`[v j]`, every other stack `j` holds `c j`.

* congruence of expressions: `eval`, `ok`, `cost`, `Bnd` only see the tops of the registers read;
* `spA` (assignment to a register of `rg`), `spU` (push onto a stack outside `rg`), `spO` (pop);
* `enC d eN eK eJ` / `epC d eN eK eJ eS`: `v d := expNeg n k j` / `expPos n k j σ` through the
  library programs `expNegP` / `expPosP` (inputs on `16, 17, 18, 27`, output on `19`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

/-! ## Congruence -/

theorem Agr.sub {s1 s2 : IState HS} {l l' : List (Fin HS)} (h : Agr s1 s2 l)
    (hs : ∀ i ∈ l', i ∈ l) : Agr s1 s2 l' := fun i hi => h i (hs i hi)

theorem agr_eval {s1 s2 : IState HS} : ∀ e : Ex HS, Agr s1 s2 e.regs → e.eval s1 = e.eval s2
  | .reg i, h => by simp only [Ex.eval]; exact (h i (by simp [Ex.regs])).1
  | .lit c, _ => rfl
  | .add a b, h | .mul a b, h | .shl a b, h | .quo a b, h | .rem a b, h | .ndiv a b, h
  | .nmod a b, h => by
    simp only [Ex.eval]
    rw [agr_eval a (h.sub (by intro i hi; simp [Ex.regs, hi])),
      agr_eval b (h.sub (by intro i hi; simp [Ex.regs, hi]))]
  | .neg a, h | .pow2 a, h => by
    simp only [Ex.eval]; rw [agr_eval a (h.sub (by intro i hi; simpa [Ex.regs] using hi))]
  | .sel c x y, h => by
    simp only [Ex.eval]
    rw [agr_eval c (h.sub (by intro i hi; simp [Ex.regs, hi])),
      agr_eval x (h.sub (by intro i hi; simp [Ex.regs, hi])),
      agr_eval y (h.sub (by intro i hi; simp [Ex.regs, hi]))]

theorem agr_ok {s1 s2 : IState HS} : ∀ e : Ex HS, Agr s1 s2 e.regs → e.ok s1 → e.ok s2
  | .reg i, h, _ => by simp only [Ex.ok]; exact (h i (by simp [Ex.regs])).2.2
  | .lit c, _, _ => trivial
  | .add a b, h, ho | .mul a b, h, ho => by
    simp only [Ex.ok] at ho ⊢
    exact ⟨agr_ok a (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.1,
      agr_ok b (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.2⟩
  | .shl a b, h, ho | .quo a b, h, ho | .rem a b, h, ho => by
    simp only [Ex.ok] at ho ⊢
    rw [← agr_eval b (h.sub (by intro i hi; simp [Ex.regs, hi]))]
    exact ⟨agr_ok a (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.1,
      agr_ok b (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.2.1, ho.2.2⟩
  | .ndiv a b, h, ho | .nmod a b, h, ho => by
    simp only [Ex.ok] at ho ⊢
    rw [← agr_eval a (h.sub (by intro i hi; simp [Ex.regs, hi])),
      ← agr_eval b (h.sub (by intro i hi; simp [Ex.regs, hi]))]
    exact ⟨agr_ok a (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.1,
      agr_ok b (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.2.1, ho.2.2⟩
  | .neg a, h, ho => by
    simp only [Ex.ok] at ho ⊢
    exact agr_ok a (h.sub (by intro i hi; simpa [Ex.regs] using hi)) ho
  | .pow2 a, h, ho => by
    simp only [Ex.ok] at ho ⊢
    rw [← agr_eval a (h.sub (by intro i hi; simpa [Ex.regs] using hi))]
    exact ⟨agr_ok a (h.sub (by intro i hi; simpa [Ex.regs] using hi)) ho.1, ho.2⟩
  | .sel c x y, h, ho => by
    simp only [Ex.ok] at ho ⊢
    rw [← agr_eval c (h.sub (by intro i hi; simp [Ex.regs, hi]))]
    refine ⟨agr_ok c (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.1, ?_⟩
    split_ifs at ho ⊢
    · exact agr_ok x (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.2
    · exact agr_ok y (h.sub (by intro i hi; simp [Ex.regs, hi])) ho.2

/-! ## The register file -/

theorem top_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (encK s (RF v c)).top j = v j := top_encK (RF_in h)

theorem isInt_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (encK s (RF v c)).IsInt j := isInt_encK (RF_in h)

theorem agr_RF {s s' : IState HS} {v : Fin HS → ℤ} {c c' : Fin HS → List ℤ} {e : Ex HS}
    (he : InRg e) : Agr (encK s (RF v c)) (encK s' (RF v c')) e.regs := fun i hi =>
  ⟨by rw [top_RF (he i hi), top_RF (he i hi)], isInt_RF (he i hi), isInt_RF (he i hi)⟩

theorem RF_bnd {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} {V : Fin HS → ℕ}
    (he : InRg e) (hv : ∀ i ∈ e.regs, |v i| ≤ V i) : ∀ i ∈ e.regs, |(encK s (RF v c)).top i| ≤ V i :=
  fun i hi => by rw [top_RF (he i hi)]; exact hv i hi

/-- Clean for expressions reading only `rg`. -/
theorem clean_of_inRg {e : Ex HS} (he : InRg e) : e.Clean := by
  intro i hi
  have h := he i hi
  simp only [rg, List.mem_cons, List.not_mem_nil, or_false] at h
  simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false]
  rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
    (subst h; decide)

/-! ## Basic steps -/

/-- Push onto a stack outside `rg`. -/
theorem spU (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {i : Fin HS} (hi : i ∉ rg)
    (hi5 : i.val < 56) {e : Ex HS} (he : InRg e) (hok : e.ok (encK s (RF v c))) {V : Fin HS → ℕ} {B : ℕ}
    (hv : ∀ j ∈ e.regs, |v j| ≤ V j) (hm : mg V e < 2 ^ B) :
    Sp (.push i e) (encK s (RF v c))
      (encK s (RF v (Function.update c i (e.eval (encK s (RF v c)) :: c i)))) (cE e B) := by
  have h := Sp.pushQ s (RF v c) hi5 (clean_of_inRg he) hok
    (bnd_of_mg _ V B e (RF_bnd he hv) hm)
  rw [upd_RF_out hi, RF_out hi] at h
  exact h

/-- Pop from a stack outside `rg`. -/
theorem spO (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {i : Fin HS} (hi : i ∉ rg)
    (hi5 : i.val < 56) {a : ℤ} {l : List ℤ} (hc : c i = a :: l) {B : ℕ} (ha : zsz a ≤ B) :
    Sp (.pop i) (encK s (RF v c)) (encK s (RF v (Function.update c i l))) (2 * B + 2) := by
  have h := Sp.pop s (RF v c) hi5 (by rw [RF_out hi, hc]) ha
  rw [upd_RF_out hi] at h
  exact h

end J6Seg.PreT

end

