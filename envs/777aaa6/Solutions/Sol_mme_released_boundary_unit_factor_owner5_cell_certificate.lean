theorem log_ok : ∀ s : Fin 45, ∀ j : Fin 3, ((shape s).val (hashMode 5 j)).val = 0 →
    ∀ w : Word, 0 < pq s (hashMode 5 (j + 1)) w →
    let q := pq s (hashMode 5 (j + 1)) w
    let k : ℤ := ks s w
    let n := 14
    let t := ((2 : ℚ) ^ k * q - 1) / ((2 : ℚ) ^ k * q + 1)
    let twoCenter := 2 * ∑ i ∈ Finset.range n, (1 / 3 : ℚ) ^ (2 * i + 1) / (2 * i + 1)
    let twoError := 2 * ((1 / 3 : ℚ) ^ (2 * n + 1) / (1 - (1 / 3 : ℚ) ^ 2))
    let center := (2 * ∑ i ∈ Finset.range n, t ^ (2 * i + 1) / (2 * i + 1)) -
      (k : ℚ) * twoCenter
    let error := 2 * (|t| ^ (2 * n + 1) / (1 - t ^ 2)) + |(k : ℚ)| * twoError
    lower s w ≤ center - error ∧ center + error ≤ upper s w := by
  decide +kernel

