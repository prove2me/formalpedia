    (h0 : 0 ≤ x0)
    (ha0 : 0 < alo) (ha1 : alo ^ 2 ≤ 1 + 12 * x0) (ha2 : 1 + 12 * x1 ≤ ahi ^ 2) (ha3 : 0 ≤ ahi)
