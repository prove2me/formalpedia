    rw [hB1, KFH.stT, KFH.stS_eq t 1 S0 0 (by norm_num)]; simp; ring
  set G := KFH.grpG B t e 0 with hG
  have hGv : G = B * 2 ^ (t - e - 1) := by rw [hG, KFH.grpG]; simp
  have hpe : 2 ^ e * 2 ^ (t - e - 1) * 2 = 2 ^ t := by
    rw [← pow_add, ← pow_succ]; congr 1; omega
  have hGB : G * B1 * 2 = N := by rw [hGv, hB1v, hN, ← hpe]; ring
  have hB1N : B1 ≤ N := by
    rw [hB1v, hN]
    have : 2 ^ e ≤ 2 ^ t := Nat.pow_le_pow_right (by norm_num) het.le
    have : 2 ^ e * (S0 * r) ≤ 2 ^ t * (S0 * r) := Nat.mul_le_mul_right _ this
    have : 2 ^ t * (S0 * r) ≤ B * 2 ^ t * S0 * r := by
      have := Nat.mul_le_mul_right (2 ^ t * (S0 * r)) hB
      calc 2 ^ t * (S0 * r) = 1 * (2 ^ t * (S0 * r)) := (one_mul _).symm
