theorem descOK_of (n kb W N J : ℕ) (d : Desc) (hd : d.1 * (2 ^ d.2.1 * d.2.2.2) = N ∧ 1 ≤ d.1 ∧
    1 ≤ d.2.2.2 ∧ 2 ^ d.2.1 * d.2.2.1 = 2 * n ∧ d.2.1 ≤ J) (hN : N ≤ 2 ^ kb)
    (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W) : DescOK n kb W N d := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hd
  have : d.2.2.1 ≤ 2 * n := by
    rw [← h4]; exact Nat.le_mul_of_pos_left _ (by positivity)
  exact ⟨h1, h2, h3, hN, by omega, by omega, by omega, by omega⟩

theorem passOK_dif (M : MulSpec) (n kb W N J : ℕ) (D : List Desc) (hD : LvlOK n kb W N J D)
    (hn : 1 ≤ n) (hN : N ≤ 2 ^ kb) (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W) :
    PassOK M difPrc (Gd n) (difCost n) n kb W N J D := fun d hd =>
  ⟨descOK_of n kb W N J d (hD d hd) hN hW hJ, trOK_dif M n d.2.1 d.2.2.1 hn (Or.inr (hD d hd).2.2.2.1),
    gOK_dif n d.2.1 d.2.2.1, (hD d hd).2.2.2.2⟩

end NLogN.FW

