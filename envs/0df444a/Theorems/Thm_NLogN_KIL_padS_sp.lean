theorem NLogN.KIL.padS_sp (s : IState HS) (F : Fin HS → List ℤ) (v : Fin HS → ℕ) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) (hv : ∀ i ∈ regD, v i ≤ M) (x b z t : NE)
    (hx : PadE F v M x) (hb : PadE F v M b) (hz : PadE F v M z) (ht : PadE F v M t)
    {X Fa Fb Y : ℕ} (vx : x.val v = X) (vb : b.val v = Fa * Y) (vz : z.val v = (Fb - Fa) * Y)
    (vt : t.val v = X * (Fb * Y)) (hF : Fa ≤ Fb) (hF1 : 1 ≤ Fb) (hY : 1 ≤ Y)
    (xs : List ℤ) (h0 : F 0 = xs) (h15 : F 15 = []) (h20 : F 20 = []) (h21 : F 21 = [])
    (hxs : xs.length = X * (Fa * Y)) (hbd : Bnd B xs) :
    Sp (padS x b z t) (encK s (regState F v regD))
      (encK s (regState (Function.update F 0 (padL X Fa Fb Y 0 xs)) (padV v X (Fa * Y)
        ((Fb - Fa) * Y) (X * (Fb * Y))) regD))
      ((x.size + b.size + z.size + t.size + 5) * 10 ^ 7 * (B + 2) ^ 2 + cPad (X * (Fb * Y)) B) := by sorry
