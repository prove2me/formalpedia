section


















































set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace InfoLossLAR.WorstCase
open AFT Matrix QAlgorithms.Complexity
open scoped BigOperators Classical

/-- The encoded query is computed from the observed matrix/response table and
one auxiliary vector plus one label for each block. -/
def rankOneEncodedQuery (lam : ℕ) (pp : Str) (q N d ℓ t : ℕ) [NeZero q]
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q))
    (coins : (Fin N → ZMod q) × (Fin t → Fin ℓ → ZMod q))
    (input : Fin t → Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) : Str :=
  encInput lam pp (encTable (fun index =>
    _root_.InfoLossLAR.WorstCase.larRankOnePreprocess coins.1 direction (input index).1 (input index).2 (coins.2 index)))

/-- The executable bounded reduction makes the same fixed query on failure,
independently of the LWE table. -/
def boundedRankOnePre (lam : ℕ) (pp fallback : Str) (q N d ℓ t : ℕ) [NeZero q]
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q))
    (tape : Fin (Nat.size (q^(N+t*ℓ))) → Bool)
    (input : Fin t → Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) : Str :=
  match _root_.InfoLossLAR.WorstCase.boundedJointDraw q N t ℓ tape with
  | none => fallback
  | some coins => _root_.InfoLossLAR.WorstCase.rankOneEncodedQuery lam pp q N d ℓ t direction coins input



/-- The actual LWE response table for one shared secret; errors and public
matrices are independent, with fresh source errors in every block. -/
noncomputable def larObservedRealTableLaw (q N d t : ℕ) [NeZero q]
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) (secret : Fin N → ZMod q) :
    _root_.AFT.FiniteDist (Fin t → Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) :=
  ((_root_.AFT.FiniteDist.uniform (Fin t → Matrix (Fin d) (Fin N) (ZMod q))).prod
    (_root_.AFT.FiniteDist.independent (fun _ : Fin t => source))).map fun draw index =>
      (draw.1 index,(draw.1 index).mulVec secret+draw.2 index)

/-- The ideal observed table samples every response uniformly and independently. -/
noncomputable def larObservedIdealTableLaw (q N d t : ℕ) [NeZero q] :
    _root_.AFT.FiniteDist (Fin t → Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) :=
  ((_root_.AFT.FiniteDist.uniform (Fin t → Matrix (Fin d) (Fin N) (ZMod q))).prod
    (_root_.AFT.FiniteDist.uniform (Fin t → Fin d → ZMod q))).map fun draw index =>
      (draw.1 index,draw.2 index)



















/-- The real experiment of the actual bounded Boolean preprocessing. -/
noncomputable def prBoundedRankOneRealLAR (D : Family) (lam : ℕ) (pp fallback : Str)
    (q N d ℓ t : ℕ) [Fact q.Prime] [NeZero q]
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q))
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q)) : ℝ :=
  avg fun secret : Fin N → ZMod q =>
    (_root_.InfoLossLAR.WorstCase.larObservedRealTableLaw q N d t source secret).expectation fun input =>
      avg fun tape : Fin (Nat.size (q^(N+t*ℓ))) → Bool =>
        acceptProb D (_root_.InfoLossLAR.WorstCase.boundedRankOnePre lam pp fallback q N d ℓ t direction tape input)

/-- The ideal experiment uses the identical bounded program and failure query. -/
noncomputable def prBoundedRankOneIdealLAR (D : Family) (lam : ℕ) (pp fallback : Str)
    (q N d ℓ t : ℕ) [Fact q.Prime] [NeZero q]
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q)) : ℝ :=
  (_root_.InfoLossLAR.WorstCase.larObservedIdealTableLaw q N d t).expectation fun input =>
    avg fun tape : Fin (Nat.size (q^(N+t*ℓ))) → Bool =>
      acceptProb D (_root_.InfoLossLAR.WorstCase.boundedRankOnePre lam pp fallback q N d ℓ t direction tape input)















end InfoLossLAR.WorstCase

