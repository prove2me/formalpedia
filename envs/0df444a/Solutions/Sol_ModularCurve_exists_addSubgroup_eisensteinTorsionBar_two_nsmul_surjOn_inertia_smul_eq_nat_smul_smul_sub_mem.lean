theorem reductionModL_heckeOperatorBar_eq_zero (ℓ : Nat.Primes) (z : JZero p)
    (hz : reductionModL B p z = 0) :
    reductionModL B p (heckeOperatorBar p ℓ z) = 0 := by
  have h2p := not_two_dvd p h2n
  have hRI := reductionInputs p h2n B hB
  haveI : CharP (IsLocalRing.ResidueField ↥B) 2 :=
    ValuationSubring.residueField_charP_of_liesOverPrime B Nat.prime_two hB
  obtain ⟨ℓ, hℓ⟩ := ℓ
  by_cases hℓ2 : ℓ = 2
  · subst hℓ2
    have h := reductionModL_heckeOperatorBar p (ℓ := 2) h2p B hB hRI z
    rw [hz, map_zero] at h
    exact h
  · haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    have hE := modularFunctionFieldC_eq_modularFunctionFieldFullC
      (IsLocalRing.ResidueField ↥B) 2 p h2p
    have hN : (p : IsLocalRing.ResidueField ↥B) ≠ 0 := by
      rw [Ne, CharP.cast_eq_zero_iff (IsLocalRing.ResidueField ↥B) 2]
      exact h2p
    have hq : (ℓ : IsLocalRing.ResidueField ↥B) ≠ 0 := by
      rw [Ne, CharP.cast_eq_zero_iff (IsLocalRing.ResidueField ↥B) 2]
      intro h
      exact hℓ2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hℓ).1 h).symm
    have hf : HeckeInputsFibre (IsLocalRing.ResidueField ↥B) p ℓ :=
      heckeInputsFibre_of_prime _ p ℓ hN hq
    have h := reductionModL_heckeOperatorBar_of_ne p (ℓ := 2) h2p B hB hRI ℓ hℓ hℓ2 hE hf z
    rw [h, hz]
    exact addEquiv_end_symm_zero _ _

