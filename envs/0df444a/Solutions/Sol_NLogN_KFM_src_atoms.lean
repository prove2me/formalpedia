theorem srcM_le (d r t : ℕ) (hd : 1 ≤ d) : srcM d r t ≤ t := by
  unfold srcM
  have hQ : 1 ≤ srcQ d r := by
    have : 0 < srcQ d r := by unfold srcQ; positivity
    omega
  apply Nat.div_le_of_le_mul
  calc (4 * d - 1) * t - 4 * d ≤ (4 * d - 1) * t := Nat.sub_le _ _
    _ ≤ 4 * d * t := Nat.mul_le_mul_right _ (by omega)
    _ ≤ 4 * d * srcQ d r * t := Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ (by omega))

end NLogN.KFM

