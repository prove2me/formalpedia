theorem solution (p s t α : ℕ) :
    (NLogN.Rsp.eTab p s t α).flatten.length = s * (2 * HvdH.eWidth p α + 1) := by
  rw [List.length_flatten]
  have : (NLogN.Rsp.eTab p s t α).map List.length = List.replicate (2 * HvdH.eWidth p α + 1) s := by
    apply List.eq_replicate_iff.2
    refine ⟨by simp [NLogN.Rsp.eTab_length], fun b hb => ?_⟩
    obtain ⟨W, hW, rfl⟩ := List.mem_map.1 hb
    exact NLogN.Rsp.eTab_rows p s t α W hW
  rw [this, List.sum_replicate, smul_eq_mul, mul_comm]
end
