/-!
# Section 12 pasting: from-H-to-G stage-mass bookkeeping

Stage-`0` identification, terminal identification, adjacent-stage split, and
telescoping lemmas that connect the Lean recurrence stages to the paper scalars.
-/

@[expose] public section

open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open MIPStarRE.LDT.CommutativityPoints
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (ψbi : _root_.LIDT.MIPStarRE.LDT.QuantumState (ι × ι))
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι) (k : ℕ) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGStageMass params ψbi family k k =
      _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGBernoulliTailMass params ψbi family k := by
  classical
  have hweight :
      _root_.LIDT.MIPStarRE.LDT.Pasting.truncatedTypeSums family.averagedSubMeas.total params.d k (default : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType 0) =
        _root_.LIDT.MIPStarRE.LDT.Pasting.bernoulliTailOperator k params.d family.averagedSubMeas.total :=
    _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToG_truncatedTypeSums_full_eq_bernoulliTailOperator
      family.averagedSubMeas.total params.d k
  simp only [_root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGStageMass, _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass,
    _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageFamily, _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGRecurrenceWeight,
    _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGBernoulliTailMass, _root_.LIDT.MIPStarRE.LDT.subMeasMass, _root_.LIDT.MIPStarRE.LDT.IdxSubMeas.liftRight,
    _root_.LIDT.MIPStarRE.LDT.Pasting.bernoulliTailFromFamily, _root_.LIDT.MIPStarRE.LDT.constSubMeasFamily, _root_.LIDT.MIPStarRE.LDT.mkRightPlacedSubMeas_total]
  rw [Nat.sub_self]
  simp only [Finset.univ_unique, _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToG_averagedSandwichByTypeSubMeas_zero_total_eq_one,
    _root_.LIDT.MIPStarRE.LDT.leftTensor_one, one_mul, Finset.sum_singleton]
  exact congrArg (fun A : _root_.LIDT.MIPStarRE.Quantum.Op ι => _root_.LIDT.MIPStarRE.LDT.ev ψbi (_root_.LIDT.MIPStarRE.LDT.rightTensor (ι₁ := ι) A)) hweight
