  induction xs generalizing pc with
  | nil => exact ⟨not_false,not_false⟩
  | cons ins rest ih => exact ⟨not_false,⟨⟨not_false,not_false⟩,action_real_frame ins k hev⟩,ih (pc+1)⟩
lemma observed_real_frame (p : Program) (k : ℕ) (hev : Even k) :
    RealFrame (observedInterpreter p.code) k := dispatch_real_frame _ _ k hev
