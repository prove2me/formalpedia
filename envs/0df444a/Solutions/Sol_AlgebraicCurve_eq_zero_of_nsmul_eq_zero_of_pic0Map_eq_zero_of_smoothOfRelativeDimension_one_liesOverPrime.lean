      have hy' := hsub hy
      rw [show (⟨-y, hny⟩ : Divisor.degZero (K := AlgebraicClosure ℚ) (F := F)) = -⟨y, hy'⟩ from rfl,
        show Pic0.mk (-⟨y, hy'⟩) = -Pic0.mk ⟨y, hy'⟩ from
          (QuotientAddGroup.mk' _).map_neg (⟨y, hy'⟩ : Divisor.degZero (K := AlgebraicClosure ℚ) (F := F))]
      exact S.neg_mem (ih hy')

  haveI hOh : HenselianLocalRing ↥O := by
    have h := ValuationSubring.henselianLocalRing_inf_fixedField_of_le_inertiaSubgroupIn (K := ℚ) O ⊥ bot_le
    have hS : O.toSubring ⊓ (IntermediateField.fixedField (⊥ : Subgroup (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ))).toSubring = O.toSubring := by
      rw [IntermediateField.fixedField_bot]; exact inf_of_le_left (fun x _ => trivial)
    rw [hS] at h
    exact h
  have hπu : ∀ x : ↥O, IsUnit x ↔ res x ≠ 0 := fun x => (IsLocalRing.residue_ne_zero_iff_isUnit x).symm
  have hST := (GoodReductionJacobian.RelativeGroupLaw.eq_one_of_pow_eq_one_of_reduction_eq_and_exists_pow_eq_one_reduction_eq_of_isUnit_of_henselianLocalRing
    L hcomm n (hju n hpn) (↥O) j k res IsLocalRing.residue_surjective hπu).1

  have hz_pow : (ext (ptsQ t)) ^ n = 1 := by
    show extH (ptsQ t) ^ n = 1
    rw [← map_pow extH, show (ptsQ t) ^ n = ptsQ (n • t) from (ptsQ_nsmul n t).symm, hnt, ptsQ_zero]
    exact ext_one
  have hz_red : Spec.map (CommRingCat.ofHom res) ≫ (ext (ptsQ t)).1 = (1 : SchemeHomOver sk f).1 := by
    show (redk (ext (ptsQ t))).1 = (1 : SchemeHomOver sk f).1
    rw [← compat t, hrt, ptsk_zero]
