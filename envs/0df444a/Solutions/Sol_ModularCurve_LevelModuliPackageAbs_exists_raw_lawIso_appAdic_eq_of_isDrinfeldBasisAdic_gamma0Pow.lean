  obtain ⟨Q, χQ', hQ', hzQ⟩ :=
    WeierstrassCurve.DrinfeldGlobal.exists_section_reducesToOrigin_originParam_eq E _ hz₁

  obtain ⟨ω, hωs, hωapp⟩ := FormalGroup.LawHom.exists_comp_appAdic_eq ψ'.toLawHom ψ.toLawHom
  obtain ⟨ρ, hρs, hρapp⟩ := FormalGroup.exists_lawIso_refl_appAdic_eq_of_mem (maximalIdeal T) G
  have hωX : ω.series = PowerSeries.X := hωs.trans hψ'ψ
