inductive IOp where
  | set (d:ℕ) (v:ℤ) | copy (d s:ℕ) | inc (d:ℕ) | dec (d:ℕ) | add (d a b:ℕ) | sub (d a b:ℕ)
  | load (d a:ℕ) | store (a s:ℕ)
def IOp.lower : IOp→Op
  | .set d v=>.pointerConst d v | .copy d s=>.pointerCopy d s | .inc d=>.pointerInc d
  | .dec d=>.pointerDec d | .add d a b=>.pointerAdd d a b | .sub d a b=>.pointerSub d a b
  | .load d a=>.integerLoad d a | .store a s=>.integerStore a s
inductive Code where
  | skip | atom (o:IOp) | seq (p q:Code)
  | cond (a b:ℕ) (p q:Code) | loop (a b:ℕ) (p:Code)
def Code.lower : Code→Cmd
  | .skip=>.skip | .atom o=>.atom o.lower | .seq p q=>.seq p.lower q.lower
  | .cond a b p q=>.ite (.pointerLE a b) p.lower q.lower | .loop a b p=>.whileDo (.pointerLE a b) p.lower
theorem Code.integer (p:Code) : IntegerCmd p.lower:=by
  induction p with
  | skip=>trivial
  | atom o=>cases o <;> trivial
  | seq p q hp hq=>exact ⟨hp,hq⟩
  | cond a b p q hp hq=>exact ⟨trivial,hp,hq⟩
  | loop a b p hp=>exact ⟨trivial,hp⟩

def seqs (cs:List Code) : Code := cs.foldr Code.seq Code.skip
def setc (d:ℕ) (v:ℤ) := Code.atom (.set d v)
def cp (d s:ℕ) := Code.atom (.copy d s)
def inc (d:ℕ) := Code.atom (.inc d)
def dec (d:ℕ) := Code.atom (.dec d)
def add (d a b:ℕ) := Code.atom (.add d a b)
def sub (d a b:ℕ) := Code.atom (.sub d a b)
def ld (d a:ℕ) := Code.atom (.load d a)
def st (a s:ℕ) := Code.atom (.store a s)

/-- Register 6 holds one, register 7 holds zero, and register 8 is the allocation cursor.
Registers 10 through 15 are the temporaries of these leaf routines. -/
def mul (d a b:ℕ) := seqs [cp 10 b,setc d 0,.loop 6 10 (seqs [add d d a,dec 10])]
def divrem (q:Bool) (d a b:ℕ) := seqs [cp 10 a,setc 11 0,
  .cond 6 b (.loop b 10 (seqs [sub 10 10 b,inc 11])) .skip,cp d (if q then 11 else 10)]
def lshift (d a k:ℕ) : Code := seqs (cp d a::List.replicate k (add d d d))
def addr (i:ℕ) := seqs [lshift 12 i 6,setc 13 (-95),sub 12 13 12]
def readCell (d a i:ℕ) := seqs [add 14 a i,addr 14,ld d 12]
def writeCell (a i v:ℕ) := seqs [add 14 a i,addr 14,st 12 v]
def allocate (d len:ℕ) := seqs [cp d 8,cp 15 len,
  .loop 6 15 (seqs [addr 8,st 12 7,inc 8,dec 15])]
def forN (i last len:ℕ) (body:Code) := seqs [setc i 0,cp last len,dec last,
  .loop i last (seqs [body,inc i])]
end StableMSR.Recovery.NativeWriter.Production.Candidates.IntegerGeometry.Canonical.CandidateRAM


