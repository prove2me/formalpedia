theorem mainN0_facts (n : ℕ) :
    2 * n < mainN0 n ∧ 1 ≤ mainN0 n ∧ 2 ^ fmK (mainN0 n) ∣ mainN0 n ∧
      fmL (mainN0 n) = zsz ((n + 1 : ℕ) : ℤ) + 2 := by
