private noncomputable def d046 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (R : SOrderReps K S)
    (g : AdelicGL2 (𝓞 K) K) (χ : ↥(torusClass (K := K) S) →* ℂˣ) (s : ℂ) (n : ↥S → ℤ)
    (p : ↥(torusClass (K := K) S) × ℝ) : ℂ :=
  ∑' β : {β : Kˣ // IsSUnit K S β},
    d010 d archR archC dR dC dF (torusPoint g p) (R.rep n * β.1) *
        ((d039 S χ (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
          Ideles.archScale K p.2) : ℂˣ) : ℂ) *
      ((ideleNorm K (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
        Ideles.archScale K p.2) : ℝ) : ℂ) ^ s

private theorem t0413 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    (R : SOrderReps K S) (g : AdelicGL2 (𝓞 K) K) (χ : ↥(torusClass (K := K) S) →* ℂˣ) (s : ℂ)
    (p : ↥(torusClass (K := K) S) × ℝ)
    (hsum : Summable fun α : Kˣ => d010 d archR archC dR dC dF (torusPoint g p) α) :
    jlSeries' d archR archC dR dC dF (torusPoint g p) * ((χ p.1 : ℂˣ) : ℂ) * Complex.exp (s * (p.2 : ℂ)) =
      ∑' n : ↥S → ℤ, d046 archR archC dR dC d dF R g χ s n p := by
  unfold d046
  rw [mul_assoc, ← t0412 χ p s, ← mul_assoc, t0146,
    ← tsum_mul_right, ← tsum_mul_right, t0409 R]
  exact (hsum.mul_right _).mul_right _

private theorem t0414 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (R : SOrderReps K S)
    (g : AdelicGL2 (𝓞 K) K) (χ : ↥(torusClass (K := K) S) →* ℂˣ) (s : ℂ) (n : ↥S → ℤ)
    (hF : Continuous (d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s))
    (hFi : IntegrableOn (d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s)
      (d020 S) (NumberField.Idele.idelicHaar K)) :
    Integrable (d046 archR archC dR dC d dF R g χ s n) (d012 S) ∧
      ∫ p, d046 archR archC dR dC d dF R g χ s n p ∂(d012 S) =
        d.a (R.rep n) * d.epsChar g * ((d034 S).toReal : ℂ) *
          ∫ z in d020 S, d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s z
            ∂(NumberField.Idele.idelicHaar K) :=
  t0411 archR archC dR dC d dF (R.rep n) g (t0338 S χ) s hF hFi

private theorem t0415 {X ι : Type*} {_ : MeasurableSpace X} [Countable ι] {ν : Measure X}
    {T : ι → X → ℂ} (hT : ∀ i, Integrable (T i) ν) (hbound : ∑' i, ∫⁻ x, ‖T i x‖ₑ ∂ν ≠ ⊤) :
    Integrable (fun x => ∑' i, T i x) ν := by
  refine ⟨AEStronglyMeasurable.tsum fun i => (hT i).aestronglyMeasurable, ?_⟩
  refine lt_of_le_of_lt (lintegral_mono fun x => enorm_tsum_le_tsum_enorm) ?_
  rw [lintegral_tsum fun i => (hT i).aestronglyMeasurable.enorm]
  exact lt_top_iff_ne_top.2 hbound

private theorem t0416 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    (R : SOrderReps K S) (g : AdelicGL2 (𝓞 K) K) (χ : ↥(torusClass (K := K) S) →* ℂˣ) (s : ℂ)
    (hsum : ∀ p : ↥(torusClass (K := K) S) × ℝ,
      Summable fun α : Kˣ => d010 d archR archC dR dC dF (torusPoint g p) α)
    (hF : ∀ n : ↥S → ℤ, Continuous (d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s))
    (hFi : ∀ n : ↥S → ℤ, IntegrableOn (d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s)
      (d020 S) (NumberField.Idele.idelicHaar K))
    (hbound : ∑' n : ↥S → ℤ, ∫⁻ p, ‖d046 archR archC dR dC d dF R g χ s n p‖ₑ ∂(d012 S) ≠ ⊤) :
    Integrable (fun p : ↥(torusClass (K := K) S) × ℝ =>
        jlSeries' d archR archC dR dC dF (torusPoint g p) * ((χ p.1 : ℂˣ) : ℂ) * Complex.exp (s * (p.2 : ℂ)))
        (d012 S) ∧
      ∫ p : ↥(torusClass (K := K) S) × ℝ,
          jlSeries' d archR archC dR dC dF (torusPoint g p) * ((χ p.1 : ℂˣ) : ℂ) * Complex.exp (s * (p.2 : ℂ))
            ∂(d012 S) =
        ∑' n : ↥S → ℤ, d.a (R.rep n) * d.epsChar g * ((d034 S).toReal : ℂ) *
          ∫ z in d020 S, d043 archR archC dR dC epsS dF (R.rep n) g (d039 S χ) s z
            ∂(NumberField.Idele.idelicHaar K) := by
  have hshell : ∀ n, Integrable (d046 archR archC dR dC d dF R g χ s n) (d012 S) :=
    fun n => (t0414 archR archC dR dC d dF R g χ s n (hF n) (hFi n)).1
  have hfun : (fun p : ↥(torusClass (K := K) S) × ℝ =>
      jlSeries' d archR archC dR dC dF (torusPoint g p) * ((χ p.1 : ℂˣ) : ℂ) * Complex.exp (s * (p.2 : ℂ))) =
      fun p => ∑' n : ↥S → ℤ, d046 archR archC dR dC d dF R g χ s n p :=
    funext fun p => t0413 archR archC dR dC d dF R g χ s p (hsum p)
  rw [hfun]
  refine ⟨t0415 hshell hbound, ?_⟩
  rw [integral_tsum (fun n => (hshell n).aestronglyMeasurable) hbound]
  exact tsum_congr fun n => (t0414 archR archC dR dC d dF R g χ s n (hF n) (hFi n)).2

