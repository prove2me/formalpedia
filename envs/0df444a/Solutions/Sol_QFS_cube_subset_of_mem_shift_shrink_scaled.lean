/-- The scaled form of the previous step: if `y ∈ V_{h√d}[x]` then the whole cube
`A_h(y)` lies in `V_{(h/2)√d}[x]`. -/
lemma solution {S : Set (EuclideanSpace ℝ (Fin d))} {h : ℝ}
    {x y : EuclideanSpace ℝ (Fin d)}
    (hy : y ∈ QFS.shift (QFS.shrink S (h * Real.sqrt d)) x) :
    QFS.cube h y ⊆ QFS.shift (QFS.shrink S (h / 2 * Real.sqrt d)) x := by
  rw [← QFS.shrink_shift] at hy ⊢
  have h2 : h * Real.sqrt d = 2 * (h / 2 * Real.sqrt d) := by ring
  rw [h2] at hy
  exact (QFS.cube_subset_closedBall y).trans (QFS.closedBall_subset_shrink hy)
