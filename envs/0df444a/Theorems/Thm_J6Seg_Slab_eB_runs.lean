theorem J6Seg.Slab.eB_runs (s : IState HS) (G : Fin HS → List ℤ) (X Sv LC T Cd A D W : List ℤ) (k cur : ℕ)
    (a : ℤ) (hle : cur ≤ k) {Z : ℕ} (hk : zsz (k : ℤ) ≤ Z) (ha : zsz a ≤ Z)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) :
    IRuns I iprog eB (encK s (cS G X Sv ((cur : ℤ) :: LC) T ((k : ℤ) :: Cd) (a :: A) D W))
      (encK s (cS G X Sv ((k : ℤ) :: LC)
        ((flatC (stO (some k) a cur)).reverse ++ T) ((k : ℤ) :: Cd) (a :: A) D W))
      (cEnt Z (k - cur) - 5 * cU Z) := by sorry
