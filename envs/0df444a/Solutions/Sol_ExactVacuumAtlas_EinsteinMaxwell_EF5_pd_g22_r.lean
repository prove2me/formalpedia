variable (mu beta Q : ℝ)
theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 1 (gEF5 mu beta 2 2) x = x 1 / (2 * x 2 * (1 - x 2)) := by
  have hu := domU5_u hx
  have h1u := domU5_1mu hx
  rw [gEF5_22_fun, pd]
  have hslice : (fun u : ℝ => (Function.update x 1 u) 1 ^ 2 /
                              (4 * (Function.update x 1 u) 2 * (1 - (Function.update x 1 u) 2)))
              = fun u => u ^ 2 / (4 * x 2 * (1 - x 2)) := by
    funext u; simp [Function.update_apply, show (2 : Fin 5) ≠ 1 from by decide]
  rw [hslice]
  have hd : 4 * x 2 * (1 - x 2) ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) hu) h1u
  exact (((hasDerivAt_id' (x 1)).fun_pow 2).div_const _).congr_deriv
    (by push_cast; field_simp; ring) |>.deriv
