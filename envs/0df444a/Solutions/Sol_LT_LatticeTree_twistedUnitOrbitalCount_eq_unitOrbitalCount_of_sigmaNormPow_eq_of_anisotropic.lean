    have h0 := (hdU.map κ).ne_zero
    apply hunit
    intro ha0
    apply h0
    have ha0' : κ δq.a = 0 := ha0
    have hκτ' : κ (Y.map ι 0 0 + Y.map ι 1 1) = 0 := by
      rw [htr', map_mul, hκπ, zero_mul]
