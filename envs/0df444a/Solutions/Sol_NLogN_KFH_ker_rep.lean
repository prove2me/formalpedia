      have := h0; push_cast at this; omega
    have e1 : AModel.encode (Butterfly.layerShape P K D S) ((Butterfly.layerSel P K D S ρ hρ).set (AModel.decode (Butterfly.layerShape P K D S) j)
        (Function.update ((Butterfly.layerSel P K D S ρ hρ).bits (AModel.decode (Butterfly.layerShape P K D S) j)) i 1)) = j := by
      have := h1; push_cast at this; omega
    have hJT : J - T * r = (j - T) * r + c := by
      simp only [J, Nat.sub_mul]
      have : T * r ≤ j * r := Nat.mul_le_mul_right _ hjT
      omega
    rw [e0, e1, NLogN.KFH.toC_lin2, hJT, hx.getD (by omega) c, hx.getD (by omega) c]
    have ha := hA 1 0; have hb2 := hA 1 1
    simp only [NLogN.KFH.Ment, show (1 : Fin 2) ≠ 0 by decide, if_false, if_true] at ha hb2
    have e11 : (⟨j / T % 2, Nat.mod_lt _ (by norm_num)⟩ : Fin 2) = 1 := Fin.ext hbit
    rw [e11, ha, hb2, pow_add]; ring
end
