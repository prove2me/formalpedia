  have hP := pop_rv_half (N := lay0.length) hr
  have hD := Dl_step mz (bgB bs) hP (List.range n ++ [n]) (rv n (n / 2) lay0) (by simp)
    (by rw [rv_rv_half hr]; exact hnd) (by rw [rv_rv_half hr]; exact hF) xs0 0
  rw [rv_rv_half hr, map_rv_lay0 u cz bs (by omega), hsh] at hD
  rw [← rv_half hr, ← hD]
  apply pull_congr
  intro b hb
  have hbl : n ≤ b.length := by rw [hb.length_eq]; simp [SH]
  rw [word_rev hQ2 hb, rv_half hbl]
  rfl

