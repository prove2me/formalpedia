variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}
theorem solution {N : ℝ → ℝ} (hIo : IsOpen I) (hI : IsPreconnected I)
    (hN : ContDiffOn ℝ ∞ N I) {r₀ : ℝ} (hr₀ : r₀ ∈ I)
    (h2 : ∀ r ∈ I, deriv (deriv N) r = 2) :
    ∃ β γ : ℝ, β = deriv N r₀ - 2 * r₀ ∧ γ = N r₀ - r₀ ^ 2 - β * r₀ ∧
      ∀ r ∈ I, N r = r ^ 2 + β * r + γ := by
  have d1 : ∀ s ∈ I, HasDerivAt N (deriv N s) s := fun s hs => hasDerivAt_of_cd hIo hN hs
  have d2 : ∀ s ∈ I, HasDerivAt (deriv N) (deriv (deriv N) s) s := fun s hs =>
    hasDerivAt_of_cd hIo (cd_deriv hIo hN) hs
  have hg : ∀ s ∈ I, HasDerivAt (fun x => deriv N x - 2 * x) 0 s := fun s hs =>
    ((d2 s hs).sub ((hasDerivAt_id' s).const_mul 2)).congr_deriv (by rw [h2 s hs]; ring)
  refine ⟨deriv N r₀ - 2 * r₀, N r₀ - r₀ ^ 2 - (deriv N r₀ - 2 * r₀) * r₀, rfl, rfl, ?_⟩
  have hN1 : ∀ s ∈ I, deriv N s = 2 * s + (deriv N r₀ - 2 * r₀) := fun s hs => by
    have h := hIo.is_const_of_deriv_eq_zero hI
      (fun s hs => (hg s hs).differentiableAt.differentiableWithinAt)
      (fun s hs => (hg s hs).deriv) hs hr₀
    linarith
  have hh : ∀ s ∈ I, HasDerivAt (fun x => N x - x ^ 2 - (deriv N r₀ - 2 * r₀) * x) 0 s :=
    fun s hs => (((d1 s hs).sub (hasDerivAt_sq' (hasDerivAt_id' s))).sub
      ((hasDerivAt_id' s).const_mul (deriv N r₀ - 2 * r₀))).congr_deriv
      (by rw [hN1 s hs]; ring)
  intro r hr
  have h := hIo.is_const_of_deriv_eq_zero hI
    (fun s hs => (hh s hs).differentiableAt.differentiableWithinAt)
    (fun s hs => (hh s hs).deriv) hr hr₀
  linarith
