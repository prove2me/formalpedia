    show ((KP6 Q.P Q.n : ℤ) :: descLine6 Q.P Q.n Q.src).length = _
    rw [List.length_cons, descLine6, len_descLine]
  obtain ⟨hs1, hs2⟩ := small_len hQ (k := 2) (c := 5) (Bd := Bd) (by norm_num) (by norm_num)
  obtain ⟨hok, hrun, hc⟩ := cpy_call (Or.inr (Or.inl rfl)) dS t Q.dCh hR.hCh Q.d hR.hD 2 5 hl
    (Bd + Q.b) (fun x hx => (hBd x hx).trans (by omega)) hs1 hs2
  obtain ⟨Mrt, hMrt, ys, c, hrun', hy, hg, hcst⟩ :=
    hC (wS t dS R0) (wF (gflat xs) Q.dCh dS) [] wF_nil (wF_dS hd0) xs x
      (by rw [wF_zero, List.append_nil]) hx hx1
  refine ⟨Mrt, hMrt, ys, _, callW_I hprog _ hd0 eC t _ _ _ R0 h0 Bd hBd hok hrun hrun', hy, hg, ?_⟩
  exact cpy_cost_le Q.dCh hl _ hc c C₀ A hcst

