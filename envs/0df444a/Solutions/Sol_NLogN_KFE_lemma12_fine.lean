/-- For an idempotent matrix, `rank = trace`. -/
theorem rank_eq_trace_of_idem (P : Matrix ι ι K) (hP : P * P = P) : (P.rank : K) = P.trace := by
  have hf : IsIdempotentElem (Matrix.toLin' P) := by
