/-!
# Painlevé–Gullstrand: the `M = 0` special case and the coordinate locus `r = 2M`

* `M = 0`: `q = √(0/r) = 0` identically, so `gPG 0 ε` and `giPG 0 ε` coincide componentwise with the
  Minkowski spherical data `gSph`, `giSph` on `domSph = domEF`; the certificate is transported from
  `Minkowski.certSph` by componentwise equality (`cert_zero`). This is a statement for the fixed
  parameter value `M = 0`; nothing is claimed about joint smoothness in `(M, r)` at `M = 0`.
  (`PG.cert 0 ε` from the general tables is another proof route for the same certificate, needing
  `ε² = 1`; both routes share the definition layer, so `cert_zero_both` is `P ∧ P`, not an
  independent check.)
* `M > 0`, `r = 2M`: the certified domain contains the equatorial point `(0, 2M, π/2, 0)`; there
  `q = 1`, `g_TT = 0`, `g_Tr = ε`, all Ricci components vanish, the PG→EF relation has `H' = 1/2`,
  Jacobian entry `ε/2` and determinant `1` (`horizon_data`, `horizon_point`). All of this is
  coordinate-level; no horizon, causal or global statement is made.
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.PG

/-! ### `M = 0` -/

/-! ### `M > 0`, `r = 2M` -/

/-- Regular data at the coordinate locus `r = 2M` (`M > 0`), at the equatorial point
`equatorPt (2M) = (0, 2M, π/2, 0)`: `q = 1`, `H_M' (2M) = 1/2`, PG→EF Jacobian entry `ε/2`,
`det = 1`, `g_TT = 0`, `g_Tr = ε`. -/
theorem horizon_data (M ε : ℝ) (hM : 0 < M) :
    equatorPt (2 * M) ∈ domEF ∧ qf M (2 * M) = 1 ∧
    HasDerivAt (fun u => HPG M u) (1 / 2) (2 * M) ∧
    jac M ε (equatorPt (2 * M)) 0 1 = ε / 2 ∧ (jac M ε (equatorPt (2 * M))).det = 1 ∧
    gPG M ε 0 0 (equatorPt (2 * M)) = 0 ∧ gPG M ε 0 1 (equatorPt (2 * M)) = ε := by
  have h2M : 0 < 2 * M := by positivity
  have hq1 := qf_two_mul hM
  refine ⟨(horizon_mem_domEF hM).1, hq1, ?_, ?_, det_jac M ε _, ?_, ?_⟩
  · have h := hasDerivAt_HPG hM.le h2M
    rw [hq1] at h
    exact h.congr_deriv (by norm_num)
  · simp [jac, equatorPt, hq1]; norm_num
  · simp [gPG, equatorPt, div_self h2M.ne']
  · simp [gPG, equatorPt, hq1]

end ExactVacuumAtlas.Schwarzschild.PG

