variable {K : Type} [Field K] {σ : Type} {l linv : PowerSeries K}

theorem Formalism.L2.Th1.C.Pts.fmul_fadd (h : IsLogPair l linv) (a : K) {x y : MvPowerSeries σ K}
    (hx : MvPowerSeries.constantCoeff x = 0) (hy : MvPowerSeries.constantCoeff y = 0) :
    fmul l linv a (fadd l linv x y) = fadd l linv (fmul l linv a x) (fmul l linv a y) := by sorry
