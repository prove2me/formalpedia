open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.KN
open ExactVacuumAtlas.Kerr.In (Ui Wi)
theorem solution (M a Q : ℝ) : (domReg M a Q).Nonempty := by
  refine ⟨![0, 2 * |M| + 1, π / 2, 0], ?_, ?_, ?_⟩
  · show Sig a (2 * |M| + 1) (π / 2) ≠ 0
    unfold Sig; rw [cos_pi_div_two]; positivity
  · show Del M a Q (2 * |M| + 1) ≠ 0
    unfold Del
    have h2 := abs_nonneg M
    have hm : M * (2 * |M| + 1) ≤ |M| * (2 * |M| + 1) :=
      mul_le_mul_of_nonneg_right (le_abs_self M) (by positivity)
    nlinarith [sq_nonneg a, sq_nonneg Q]
  · show sin (π / 2) ≠ 0
    rw [sin_pi_div_two]; exact one_ne_zero
