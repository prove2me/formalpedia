theorem prod_drop_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : (s.drop i).prod ≤ s.prod := by
  conv_rhs => rw [← List.prod_take_mul_prod_drop s i]
  have : 0 < (s.take i).prod := List.prod_pos (fun x hx => hs x (List.mem_of_mem_take hx))
  exact Nat.le_mul_of_pos_left _ this

theorem sw_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : s.getD i 1 * wgt s i ≤ s.prod := by
  rcases lt_or_ge i s.length with hi | hi
  · have : s.getD i 1 * wgt s i = (s.drop i).prod := by
      rw [wgt, List.getD_eq_getElem _ _ hi, List.drop_eq_getElem_cons hi, List.prod_cons]
    rw [this]; exact prod_drop_le s hs i
  · rw [List.getD_eq_default _ _ hi, wgt, List.drop_eq_nil_of_le (by omega)]
    simp; exact List.prod_pos hs

theorem getD_le_prod (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : s.getD i 1 ≤ s.prod := by
  have := sw_le s hs i
  have h2 : 0 < wgt s i := List.prod_pos (fun x hx => hs x (List.mem_of_mem_drop hx))
  exact le_trans (Nat.le_mul_of_pos_right _ h2) this

theorem wgt_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : wgt s i ≤ s.prod := by
  have := sw_le s hs i
  have h2 := getD_pos hs i
  exact le_trans (Nat.le_mul_of_pos_left _ h2) this

theorem mixJ_lt (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k m i : ℕ) : mixJ s k m i < s.getD i 1 := by
  simp only [mixJ]; split_ifs <;> exact Nat.mod_lt _ (getD_pos hs i)

theorem rmPos_mixJ_lt (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k m : ℕ) :
    rmPos s (mixJ s k m) < s.prod := rmPos_lt s _ (fun i _ => mixJ_lt s hs k m i)

theorem recI_bnd (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k i : ℕ) :
    ∀ x ∈ recI s k i, 0 ≤ x ∧ x ≤ s.prod := by
  intro x hx
  simp only [recI, List.mem_cons, List.not_mem_nil, or_false] at hx
  have h1 := Nat.mod_lt k (getD_pos hs i)
  have h2 := getD_le_prod s hs i
  have h3 := wgt_le s hs i
  have h4 := sw_le s hs i
  rcases hx with rfl | rfl | rfl | rfl
  · exact ⟨by positivity, by exact_mod_cast (by omega : k % s.getD i 1 ≤ s.prod)⟩
  · exact ⟨by positivity, by exact_mod_cast h2⟩
  · exact ⟨by positivity, by exact_mod_cast h3⟩
  · exact ⟨by positivity, by exact_mod_cast h4⟩

theorem zsz_le_of_bnd {x : ℤ} {M B : ℕ} (h0 : 0 ≤ x) (h1 : x ≤ M) (hB : M < 2 ^ B) : zsz x ≤ B :=
  zsz_le_of_abs (by rw [abs_of_nonneg h0]; exact lt_of_le_of_lt h1 (by exact_mod_cast hB))

theorem natCast_lt_pow {x B : ℕ} (h : x < 2 ^ B) : zsz (x : ℤ) ≤ B :=
  zsz_le_of_bnd (by positivity) le_rfl h

theorem inner_cost (t1 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ)
    (Rst LK LP : List Item) (hK : t1.G kKR = .int s.length :: LK)
    (hA : t1.G kRA = ints (recL s k).flatten ++ Rst)
    (hP : t1.G kPS = .int (crtKey s k) :: LP) (B : ℕ)
    (hB : 2 * s.prod + 4 * s.length + 1 < 2 ^ B) :
    (rep kC2 (.reg kKR) NLogN.CR.axBody).cost t1 ≤
      4000 * (B + 2) + s.length * (146000 * (B + 2) + 30) + 32 := by
  have H := NLogN.CR.inner_states t1 s hs k Rst LK LP hK hA hP
  have e : (Ex.reg (S := HS) kKR).eval t1 = s.length := by simp [Ex.eval, IState.top_eq hK]
  have hc := RepStates.cost_le_lin H B (46 * 3000 * (B + 2)) trivial
    (by simp only [Ex.Bnd, IState.top_eq hK]; exact natCast_lt_pow (by omega)) ?_
  · rw [e, Int.toNat_natCast] at hc
    have : s.length * (46 * 3000 * (B + 2) + 8000 * (B + 2) + 30) ≤
        s.length * (146000 * (B + 2) + 30) := Nat.mul_le_mul_left _ (by omega)
    have hs1 : (Ex.reg (S := HS) kKR).size = 1 := rfl
    rw [hs1] at hc
    generalize (rep kC2 (Ex.reg kKR) NLogN.CR.axBody).cost t1 = X at *
    nlinarith
  intro m hm
  rw [e, Int.toNat_natCast] at hm ⊢
  set u := withCtr kC2 t1 s.length m (innerSt t1 s k Rst (t1.G kRB) LP m) with hu
  set sm := s.getD m 1 with hsm
  have uA : u.G kRA = .int ((k % sm : ℕ) : ℤ) :: .int (sm : ℤ) :: .int (wgt s m : ℤ) ::
      .int ((sm * wgt s m : ℕ) : ℤ) :: (ints ((recL s k).drop (m + 1)).flatten ++ Rst) := by
    simp only [hu, withCtr, innerSt, IState.upd_G]
    simp (config := {decide := true}) only [if_true, if_false]
    rw [recL_drop s k m hm, List.flatten_cons, ints_append]
    simp [recI, hsm]
  have uP : u.G kPS = .int (rmPos s (mixJ s k m) : ℤ) :: LP := by
    simp only [hu, withCtr, innerSt, IState.upd_G]
    simp (config := {decide := true})
  have hb := recI_bnd s hs k m
  simp only [recI, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at hb
  have hpl := rmPos_mixJ_lt s hs k m
  exact axBody_cost u _ _ _ _ _ _ _ uA uP s.prod B hb.1 hb.2.1 hb.2.2.1 hb.2.2.2
    ⟨by positivity, by exact_mod_cast hpl.le⟩ (by omega)

theorem recL_flat_bnd (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ) :
    ∀ x ∈ (recL s k).flatten, 0 ≤ x ∧ x ≤ s.prod := by
  intro x hx
  simp only [recL, List.mem_flatten, List.mem_map, List.mem_range] at hx
  obtain ⟨l, ⟨i, _, rfl⟩, hx⟩ := hx
  exact recI_bnd s hs k i x hx

end NLogN.CR

