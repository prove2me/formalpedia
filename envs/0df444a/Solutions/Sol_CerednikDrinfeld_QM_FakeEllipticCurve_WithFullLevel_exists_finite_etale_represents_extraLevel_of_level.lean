section Univ

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S : Type} [CommRing S]
  (E : FakeEllipticCurve Λ N₀ S) (N : ℕ)
  {Z₀ : Scheme.{0}} (ζ₀ : Z₀ ⟶ Spec (CommRingCat.of S)) [IsAffine Z₀]

private abbrev _root_.L1Asm22.Main.C : Type := Aff.Q ζ₀

p2m_export "L1Asm22.Main" "C"
omit [IsAffine Z₀] in
theorem univ_spec : ∃ (E' : FakeEllipticCurve Λ N₀ (C ζ₀)) (g : E'.A ⟶ E.A),
    FakeEllipticCurve.IsPullbackVia (algebraMap S (C ζ₀)) E E' g ∧
    ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (C ζ₀))) (P : SchemeHomOver t' E'.f),
      (∃ P₀ : T ⟶ E.C, P₀ ≫ E.lev = P.1 ≫ g) → FactorsThrough E'.lev P := by
  obtain ⟨E', g, hg, hmul, hact, hlev, hlev'⟩ :=
    FakeEllipticCurve.exists_isPullback_levelIff (algebraMap S (C ζ₀)) E
  exact ⟨E', g, ⟨hg, hmul, hact, hlev⟩, hlev'⟩

def EC : FakeEllipticCurve Λ N₀ (C ζ₀) := (univ_spec E ζ₀).choose

def gC : (EC E ζ₀).A ⟶ E.A := (univ_spec E ζ₀).choose_spec.choose
theorem gC_via : FakeEllipticCurve.IsPullbackVia (algebraMap S (C ζ₀)) E (EC E ζ₀) (gC E ζ₀) :=
  (univ_spec E ζ₀).choose_spec.choose_spec.1

theorem gC_lev' {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (C ζ₀))) (P : SchemeHomOver t' (EC E ζ₀).f)
    (h : ∃ P₀ : T ⟶ E.C, P₀ ≫ E.lev = P.1 ≫ gC E ζ₀) : FactorsThrough (EC E ζ₀).lev P :=
  (univ_spec E ζ₀).choose_spec.choose_spec.2 t' P h

end Univ
