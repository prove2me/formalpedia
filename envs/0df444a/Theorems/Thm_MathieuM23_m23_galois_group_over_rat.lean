-- title:
--   Theorem 1.1 — $M_{23}$ is a Galois group over $\mathbb{Q}$
-- statement:
--   Let $M_{23}\le S_{23}$ be the Mathieu group, generated by the permutations $g_1,g_2$ of the source. Then there exists a finite Galois extension $K/\mathbb{Q}$ whose Galois group is isomorphic to $M_{23}$:
--
--   $$\exists\,K/\mathbb{Q}\ \text{finite Galois}:\qquad \mathrm{Gal}(K/\mathbb{Q})\cong M_{23}.$$
--
--   This is the last sporadic simple group to be realized as a Galois group over $\mathbb{Q}$.
--
--   **Formalization Note** $K$ ranges over fields in the lowest universe with a $\mathbb{Q}$-algebra structure. The Galois group is the group of $\mathbb{Q}$-algebra automorphisms of $K$, and the conclusion is the existence of a group isomorphism with the subgroup $M_{23}$.
-- source:
--   X. Huang, B. Jackson, K.-H. Lee, B. Poonen, R. Pries, S. Zhang, *The Mathieu group M23 is a Galois group over Q*, arXiv:2608.08538v1 (2026), https://arxiv.org/abs/2608.08538, p. 1, Theorem 1.1

import Definitions.Def_MathieuM23_Group

namespace MathieuM23

theorem m23_galois_group_over_rat :
    ∃ (K : Type) (_ : Field K) (_ : Algebra ℚ K),
      FiniteDimensional ℚ K ∧ IsGalois ℚ K ∧ Nonempty ((K ≃ₐ[ℚ] K) ≃* M23) := by sorry

end MathieuM23
