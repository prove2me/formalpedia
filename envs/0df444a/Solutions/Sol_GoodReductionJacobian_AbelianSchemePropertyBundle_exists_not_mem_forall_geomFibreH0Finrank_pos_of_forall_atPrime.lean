  haveI : IsProper (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) := hAk.proper
  haveI : Smooth (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) := hAk.smooth
  have h𝓛k := h𝓛.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S k))
  have hKk := kernelIsTwoTorsion_baseChange_of_isInvertible (Scheme.TwoAffineOpenCover.specMap S k) f L 𝓛 h𝓛 hK
  obtain ⟨d, hd⟩ := (L.baseChange (Scheme.TwoAffineOpenCover.specMap S k)).exists_smoothOfRelativeDimension_of_smooth
  haveI := hd
  obtain ⟨-, hfin, hrep⟩ :=
    isClosedImmersion_and_isFinite_and_forall_exists_comp_eq_iff_isInStabilizer_of_kernelIsTwoTorsion k
      (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) (L.baseChange (Scheme.TwoAffineOpenCover.specMap S k))
      hck hAk d _ h𝓛k hKk
  haveI := hfin

  have hKpts : (kernelPts (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k))
      (L.baseChange (Scheme.TwoAffineOpenCover.specMap S k))
      ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S k))).obj 𝓛)).Finite := by
    have hS := finite_setOf_comp_eq_id
      (pullback.fst ((L.baseChange (Scheme.TwoAffineOpenCover.specMap S k)).schemeNsmul 2)
        ((L.baseChange (Scheme.TwoAffineOpenCover.specMap S k)).one (𝟙 (Spec (CommRingCat.of k)))).1 ≫
        pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k))
    refine Set.Finite.of_injOn (f := fun x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k)))
        (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) => x.1)
      (t := (fun κ => κ ≫ pullback.fst ((L.baseChange (Scheme.TwoAffineOpenCover.specMap S k)).schemeNsmul 2)
        ((L.baseChange (Scheme.TwoAffineOpenCover.specMap S k)).one (𝟙 (Spec (CommRingCat.of k)))).1) '' _) ?_
      (Subtype.val_injective.injOn) (hS.image _)
    intro x hx
    obtain ⟨κ, hκ⟩ := (hrep k (𝟙 _) x).mpr hx
    refine ⟨κ, ?_, hκ⟩
    show κ ≫ (_ ≫ _) = 𝟙 _
    rw [← Category.assoc, hκ, x.2]
  have hpos' := hpos
  unfold Scheme.Modules.geomFibreH0Finrank at hpos'
  exact subsingleton_HSucc_of_iso_tensorPow_of_finite_kernelPts_of_finrank_pos k
    (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) (L.baseChange (Scheme.TwoAffineOpenCover.specMap S k))
    hck hAk _ h𝓛k hKpts hpos' 1 one_pos _ (Scheme.Modules.tensorPowOneIso _).symm 𝒰' i

