section Tables

variable {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}

/-- The integer spelling of a product: the entry of the multiplication table. -/
noncomputable def mulTab (b : Module.Basis (Fin w) (ZMod 2) F) (a c : ℕ) : ℕ :=
  enc b (dec b a * dec b c)

/-- The integer spelling of a square: the entry of the squaring table. -/
noncomputable def sqTab (b : Module.Basis (Fin w) (ZMod 2) F) (a : ℕ) : ℕ :=
  enc b ((dec b a) ^ 2)

/-- The integer spelling of an inverse: the entry of the inversion table.  (`0⁻¹ = 0`, so no
separate treatment of zero is needed.) -/
noncomputable def invTab (b : Module.Basis (Fin w) (ZMod 2) F) (a : ℕ) : ℕ :=
  enc b ((dec b a)⁻¹)

/-- The position table: `ι⁻¹(v) + 1`, and `0` for a field element outside the image. -/
noncomputable def posTab (N : ℕ) (ι : ℕ → F) (v : F) : ℕ := by
  classical
  exact if h : ∃ i, i < N ∧ ι i = v then (Classical.choose h) + 1 else 0

/-- The image table: `ι i` in integer form. -/
noncomputable def imgTab (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (i : ℕ) : ℕ :=
  enc b (ι i)

/-- The header of `det`: the parameters the program reads before it does anything else.  Slot `0` is
`t`, `1` is `w`, `2` is `N`, `3` is `2t`; `4 … 12` are the derived addresses and the mask, so that
the program itself never has to compute a table address. -/
noncomputable def hdrTab (t N : ℕ) (w : ℕ) : ℕ → ℕ
  | 0 => t
  | 1 => w
  | 2 => N
  | 3 => 2 * t
  | 4 => wordsOf (8 * w) (t * w)
  | 5 => 2 ^ w - 1
  | 6 => detSqBase w
  | 7 => detMulBase w
  | 8 => detInvBase w
  | 9 => detPosBase w
  | 10 => detImgBase w
  | 11 => detEnd w
  | 12 => 8 * w
  | _ => 0

/-- **The preprocessing table.**  Its storage is not charged (`RAMEnv.det`), and it is fixed before
the payload is seen: it holds only the parameters and the field tables, never any part of `y`. -/
noncomputable def detStd (t N : ℕ) (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F)
    (addr : ℕ) : ℕ :=
  if addr < 13 then hdrTab t N w addr
  else if addr < detMulBase w then 0
  else if addr < detSqBase w then
    mulTab b ((addr - detMulBase w) / 2 ^ w) ((addr - detMulBase w) % 2 ^ w)
  else if addr < detInvBase w then sqTab b (addr - detSqBase w)
  else if addr < detPosBase w then invTab b (addr - detInvBase w)
  else if addr < detImgBase w then posTab N ι (dec b (addr - detPosBase w))
  else if addr < detEnd w then imgTab b ι (addr - detImgBase w)
  else 0

end Tables

