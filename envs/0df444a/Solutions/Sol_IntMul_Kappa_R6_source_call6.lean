      Grid p (chirpT p (mcT p Mrt θt θit) bt at' w) ∧
      ‖(2 : ℂ) ^ (2 * (D + 1) * α ^ 2) • v - Rperm s t (dftM s u)‖ ≤
        (2 : ℝ) ^ (2 * (D + 1) * α ^ 2) * ((εA + (Er + 22) + εB) * hp p) := by
  obtain ⟨hAn, hBn, h20⟩ := lemma20_6 M
  have hA := linC_clm _ hAn
  have hB := linC_clm _ hBn
  have hQF := linC_QF s t
  have nw : ‖w‖ ≤ 6 / 10 := by
    have := norm_sub_norm_le w (tensCLM (kerA M.A) u)
    have := hA.le u
    linarith
  set c := chirpT p (mcT p Mrt θt θit) bt at' w with hc
  obtain ⟨eC, nC, gC⟩ := chirp_call_err p s t ht ζ hζ Er hMrt hθ hθi ha hb' hbg hEr nw
  refine ⟨nw, nC, gC, ?_⟩
  rw [h20 u, ← smul_sub, norm_smul, norm_pow, Complex.norm_ofNat]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  have e1 : v - tensCLM (kerB M.B) (Qperm s t (dftM t (tensCLM (kerA M.A) u))) =
      (v - tensCLM (kerB M.B) c) +
      (tensCLM (kerB M.B) c - tensCLM (kerB M.B) (Qperm s t (dftM t w))) +
      (tensCLM (kerB M.B) (Qperm s t (dftM t w)) -
        tensCLM (kerB M.B) (Qperm s t (dftM t (tensCLM (kerA M.A) u)))) := by abel
  rw [e1]
  have t2 : ‖tensCLM (kerB M.B) c - tensCLM (kerB M.B) (Qperm s t (dftM t w))‖ ≤
      (Er + 22) * hp p := (hB.err _ _).trans eC
  have t3 : ‖tensCLM (kerB M.B) (Qperm s t (dftM t w)) -
      tensCLM (kerB M.B) (Qperm s t (dftM t (tensCLM (kerA M.A) u)))‖ ≤ εA * hp p :=
    (hB.err _ _).trans ((hQF.err _ _).trans hw)
  calc _ ≤ _ := norm_add₃_le
    _ ≤ εB * hp p + (Er + 22) * hp p + εA * hp p := add_le_add (add_le_add hv t2) t3
    _ = (εA + (Er + 22) + εB) * hp p := by ring

end Chain

