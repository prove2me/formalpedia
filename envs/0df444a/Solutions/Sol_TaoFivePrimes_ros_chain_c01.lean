  have s1 := sol_u003 hγ (by simpa [gu002, gu003] using s0.1)
  have s2 := sol_u004 hγ (by simpa [gu003, gu004] using s1.1)
  have s3 := sol_u005 hγ (by simpa [gu004, gu005] using s2.1)
