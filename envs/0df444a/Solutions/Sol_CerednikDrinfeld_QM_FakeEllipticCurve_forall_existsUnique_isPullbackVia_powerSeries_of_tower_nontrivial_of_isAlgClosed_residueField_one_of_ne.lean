    _ ≤ (maximalIdeal B ^ (n + 1)).comap χ.1 := Ideal.le_comap_pow _ _
    _ = RingHom.ker χ.1 := by rw [hn, ← RingHom.ker_eq_comap_bot]

theorem versal_of_bijective [IsDomain O] [IsDiscreteValuationRing O] (p : ℕ) [Fact p.Prime]
