  have heG_act : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (f g : WithConv (I.H₁ →ₐ[GaloisRep.ratLocalizedAt p] AlgebraicClosure ℚ)),
