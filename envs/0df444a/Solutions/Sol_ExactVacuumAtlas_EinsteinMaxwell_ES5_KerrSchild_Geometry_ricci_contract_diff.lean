variable {Γ Γb : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ} {K : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
  {x : Pt 5}
theorem solution (hU : IsOpen U) (hx : x ∈ U)
    (hΓ : ∀ a p q, DifferentiableAt ℝ (Γ a p q) x) (hΓb : ∀ a p q, DifferentiableAt ℝ (Γb a p q) x)
    (hK : ∀ a, DifferentiableAt ℝ (fun y => K y a) x)
    (hsb : ∀ a p q, Γb a p q x = Γb a q p x)
    (hsC : ∀ y ∈ U, ∀ a p q, cdiffOf Γ Γb a p q y = cdiffOf Γ Γb a q p y)
    (hkk : ∀ y ∈ U, ∀ a, ∑ p, ∑ q, cdiffOf Γ Γb a p q y * K y p * K y q = 0)
    (htr : ∀ y ∈ U, ∀ p, ∑ a, cdiffOf Γ Γb a p a y = 0) :
    ∑ p, ∑ q, ricci Γ p q x * K x p * K x q =
      ∑ p, ∑ q, ricci Γb p q x * K x p * K x q
        - 2 * ∑ a, ∑ p, mOf (cdiffOf Γ Γb) K x a p * covD Γb K x a p
        - ∑ a, ∑ p, mOf (cdiffOf Γ Γb) K x a p * mOf (cdiffOf Γ Γb) K x p a := by
  set C := cdiffOf Γ Γb with hCdef
  have hC : ∀ a p q, DifferentiableAt ℝ (C a p q) x := fun a p q => (hΓ a p q).fun_sub (hΓb a p q)
  -- the differentiated trace vanishes
  have hA2 : ∀ p q, ∑ i, pd q (C i p i) x = 0 := fun p q => by
    rw [← pd_sum Finset.univ q fun i _ => hC i p i,
      pd_congr_of_eqOn hU hx (f := fun y => ∑ i, C i p i y) (h := fun _ => (0 : ℝ))
        (fun y hy => htr y hy p) q]
    exact pd_const 0 q x
  -- the differentiated `Ckk` identity
  have hA1 : ∀ i, ∑ p, ∑ q, pd i (C i p q) x * K x p * K x q =
      -2 * ∑ p, mOf C K x i p * pd i (fun y => K y p) x := fun i => by
    have h0 : pd i (fun y => ∑ p, ∑ q, C i p q y * K y p * K y q) x = 0 := by
      rw [pd_congr_of_eqOn hU hx (f := fun y => ∑ p, ∑ q, C i p q y * K y p * K y q)
        (h := fun _ => (0 : ℝ)) (fun y hy => hkk y hy i) i]
      exact pd_const 0 i x
    rw [pd_quad (T := C i) (fun p q => hC i p q) hK i] at h0
    simp only [Finset.sum_add_distrib] at h0
    have e1 : ∑ p, ∑ q, C i p q x * pd i (fun y => K y p) x * K x q =
        ∑ p, mOf C K x i p * pd i (fun y => K y p) x := by
      refine Finset.sum_congr rfl fun p _ => ?_
      unfold mOf
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun q _ => by ring
    have e2 : ∑ p, ∑ q, C i p q x * K x p * pd i (fun y => K y q) x =
        ∑ p, mOf C K x i p * pd i (fun y => K y p) x := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun q _ => ?_
      unfold mOf
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun p _ => by rw [hsC x hx i p q]
    rw [e1, e2] at h0
    linarith
  -- quadratic terms for fixed `i j`
  have hQ : ∀ i j, ∑ p, ∑ q, qTerm Γb C x p q i j * K x p * K x q =
      C i i j x * (∑ p, ∑ q, Γb j p q x * K x p * K x q)
        - mOf C K x j i * (covD Γb K x j i - pd j (fun y => K y i) x)
        - (covD Γb K x i j - pd i (fun y => K y j) x) * mOf C K x i j
        - mOf C K x j i * mOf C K x i j := fun i j => by
    have h1 : ∑ p, ∑ q, qTerm Γb C x p q i j * K x p * K x q =
        Γb i i j x * (∑ p, ∑ q, C j p q x * K x p * K x q)
          + C i i j x * (∑ p, ∑ q, Γb j p q x * K x p * K x q)
          + C i i j x * (∑ p, ∑ q, C j p q x * K x p * K x q)
          - (∑ p, C j p i x * K x p) * (∑ q, Γb i q j x * K x q)
          - (∑ p, Γb j p i x * K x p) * (∑ q, C i q j x * K x q)
          - (∑ p, C j p i x * K x p) * (∑ q, C i q j x * K x q) := by
      simp only [Finset.sum_mul_sum]
      simp only [Finset.mul_sum]
      simp only [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by unfold qTerm; ring
    have f1 : ∑ p, C j p i x * K x p = mOf C K x j i := by
      unfold mOf
      exact Finset.sum_congr rfl fun p _ => by rw [hsC x hx j p i]
    have f2 : ∑ q, C i q j x * K x q = mOf C K x i j := by
      unfold mOf
      exact Finset.sum_congr rfl fun q _ => by rw [hsC x hx i q j]
    have f3 : ∑ q, Γb i q j x * K x q = covD Γb K x j i - pd j (fun y => K y i) x := by
      unfold covD
      rw [add_sub_cancel_left]
      exact Finset.sum_congr rfl fun q _ => by rw [hsb i q j]
    have f4 : ∑ p, Γb j p i x * K x p = covD Γb K x i j - pd i (fun y => K y j) x := by
      unfold covD
      rw [add_sub_cancel_left]
      exact Finset.sum_congr rfl fun p _ => by rw [hsb j p i]
    rw [h1, hkk x hx j, f1, f2, f3, f4]
    ring
  -- the four double sums
  have hT1 : ∑ i, ∑ j, C i i j x * (∑ p, ∑ q, Γb j p q x * K x p * K x q) = 0 := by
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [← Finset.sum_mul]
    have : ∑ i, C i i j x = 0 := by
      rw [← htr x hx j]
      exact Finset.sum_congr rfl fun i _ => hsC x hx i i j
    rw [this, zero_mul]
  have hT2 : ∑ i, ∑ j, mOf C K x j i * (covD Γb K x j i - pd j (fun y => K y i) x) =
      ∑ a, ∑ p, mOf C K x a p * covD Γb K x a p
        - ∑ a, ∑ p, mOf C K x a p * pd a (fun y => K y p) x := by
    rw [Finset.sum_comm]
    simp only [mul_sub, Finset.sum_sub_distrib]
  have hT3 : ∑ i, ∑ j, (covD Γb K x i j - pd i (fun y => K y j) x) * mOf C K x i j =
      ∑ a, ∑ p, mOf C K x a p * covD Γb K x a p
        - ∑ a, ∑ p, mOf C K x a p * pd a (fun y => K y p) x := by
    simp only [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun p _ => by ring
  have hT4 : ∑ i, ∑ j, mOf C K x j i * mOf C K x i j =
      ∑ a, ∑ p, mOf C K x a p * mOf C K x p a := by
    rw [Finset.sum_comm]
  have hQsum : ∑ i, ∑ j, ∑ p, ∑ q, qTerm Γb C x p q i j * K x p * K x q =
      -2 * ∑ a, ∑ p, mOf C K x a p * covD Γb K x a p
        + 2 * ∑ a, ∑ p, mOf C K x a p * pd a (fun y => K y p) x
        - ∑ a, ∑ p, mOf C K x a p * mOf C K x p a := by
    rw [Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => hQ i j]
    simp only [Finset.sum_sub_distrib]
    rw [hT1, hT2, hT3, hT4]
    ring
  -- assembly
  have hexp := ricci_sub_expand hΓ hΓb
  have hsplit : ∑ p, ∑ q, ricci Γ p q x * K x p * K x q =
      ∑ p, ∑ q, ricci Γb p q x * K x p * K x q
        + ∑ p, ∑ q, (∑ i, pd i (C i p q) x) * K x p * K x q
        - ∑ p, ∑ q, (∑ i, pd q (C i p i) x) * K x p * K x q
        + ∑ p, ∑ q, (∑ i, ∑ j, qTerm Γb C x p q i j) * K x p * K x q := by
    simp only [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by rw [hexp p q]; ring
  have hA2' : ∑ p, ∑ q, (∑ i, pd q (C i p i) x) * K x p * K x q = 0 := by
    simp only [hA2, zero_mul, Finset.sum_const_zero]
  have hA1' : ∑ p, ∑ q, (∑ i, pd i (C i p q) x) * K x p * K x q =
      -2 * ∑ a, ∑ p, mOf C K x a p * pd a (fun y => K y p) x := by
    calc _ = ∑ p, ∑ q, ∑ i, pd i (C i p q) x * K x p * K x q := by simp only [Finset.sum_mul]
      _ = ∑ p, ∑ i, ∑ q, pd i (C i p q) x * K x p * K x q :=
          Finset.sum_congr rfl fun _ _ => Finset.sum_comm
      _ = ∑ i, ∑ p, ∑ q, pd i (C i p q) x * K x p * K x q := Finset.sum_comm
      _ = ∑ i, -2 * ∑ p, mOf C K x i p * pd i (fun y => K y p) x :=
          Finset.sum_congr rfl fun i _ => hA1 i
      _ = _ := by rw [← Finset.mul_sum]
  have hQ' : ∑ p, ∑ q, (∑ i, ∑ j, qTerm Γb C x p q i j) * K x p * K x q =
      ∑ i, ∑ j, ∑ p, ∑ q, qTerm Γb C x p q i j * K x p * K x q := by
    calc _ = ∑ p, ∑ q, ∑ i, ∑ j, qTerm Γb C x p q i j * K x p * K x q := by
          simp only [Finset.sum_mul]
      _ = _ := sum4_comm _
  rw [hsplit, hA1', hA2', hQ', hQsum]
  ring
