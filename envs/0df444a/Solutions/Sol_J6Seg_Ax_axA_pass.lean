section
-- Source module: Solutions.J6SegAxis3
/-!
# B-line axis program (`AxisU6`), part 3: the slab passes as `PassOK` steps

The slab passes (B1, `J6SegILSlab8`) read the skeleton registers
`rC = flatC cs`, `rM = [2 post]`, `rNC = [|cs|]`, `rNB = [pre]`, `rTOT = [pre · n' · 2 post]`
(and `rK1 = [2^(P-p)]`, `rK2 = [2^p]` for the output pass). They are built from the descriptor
by a set-up / tear-down pair:

* `SetupS Isym tbl stUp stDn ρ dA desc V C`: from any managed state in which only `0`, `sZ`,
  `dA` and the registers `ρ` may be nonempty (registers empty, `desc` on `dA`), `stUp` writes the
  register file `V` and `stDn` clears it, everything else unchanged, each at cost `≤ C`
  (B1's source-table producers and `ctlB`; `J6SegILSrc*`, `J6SegILCtl*`).
* `slabV cs pre post n' K1 K2`: the register file on `ρS = (rC, rM, rNC, rNB, rTOT, rK1, rK2)`.

`slabId_ok`, `slabSc_ok` (`PassOK`) and `slabOut_ok` (`Pass2OK`): set-up; the B1 pass; tear-down.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab
open NLogN.KFUU (lA lC lD)

theorem ρS_inj : Injective ρS := by
  intro a b h; fin_cases a <;> fin_cases b <;> simp_all +decide [ρS]

section gen
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

theorem ρS_ne0 (i : Fin 7) : ρS i ≠ 0 := by fin_cases i <;> decide
theorem ρS_neZ (i : Fin 7) : ρS i ≠ sZ := by fin_cases i <;> decide
theorem ρS_neA (i : Fin 7) : ρS i ≠ lA := by fin_cases i <;> decide
theorem ρS_neC (i : Fin 7) : ρS i ≠ lC := by fin_cases i <;> decide
theorem ρS_neD (i : Fin 7) : ρS i ≠ lD := by fin_cases i <;> decide
theorem ρS_neACC (i : Fin 7) : ρS i ≠ rACC := by fin_cases i <;> decide

theorem extS (V : Fin 7 → List ℤ) (F : Fin HS → List ℤ) (i : Fin 7) :
    extend ρS V F (ρS i) = V i := ρS_inj.extend_apply V F i

theorem extS_out {j : Fin HS} (hj : ∀ i, ρS i ≠ j) (V : Fin 7 → List ℤ) (F : Fin HS → List ℤ) :
    extend ρS V F j = F j := extend_apply' _ _ _ (fun ⟨a, ha⟩ => hj a ha)

/-- The extension commutes with an update off the registers. -/
theorem extS_upd {j : Fin HS} (hj : ∀ i, ρS i ≠ j) (V : Fin 7 → List ℤ) (F : Fin HS → List ℤ)
    (v : List ℤ) : extend ρS V (update F j v) = update (extend ρS V F) j v := by
  funext x
  by_cases hx : x = j
  · subst hx; rw [extS_out hj, update_self, update_self]
  · rw [update_of_ne hx]
    by_cases hr : ∃ a, ρS a = x
    · simp only [extend_def]; rw [dif_pos hr, dif_pos hr]
    · rw [extend_apply' _ _ _ hr, extend_apply' _ _ _ hr, update_of_ne hx]

/-- A generic slab step from a set-up and a run of the body on the extended state. -/
theorem slab_step {stUp stDn body : IStmt HS Pp} {dA : Fin HS} {desc : List ℤ}
    {V : Fin 7 → List ℤ} {Cs : ℝ} (hSet : SetupS Isym tbl stUp stDn ρS dA desc V Cs)
    (s : IState HS) (F : Fin HS → List ℤ) (G : Fin HS → List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → F j = []) (hR : ∀ i, F (ρS i) = [])
    (hd : F dA = desc) {cb : ℕ}
    (hb : IRuns Isym tbl body (encK s (extend ρS V F)) (encK s (extend ρS V G)) cb)
    (hG : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → G j = []) (hRG : ∀ i, G (ρS i) = [])
    (hdG : G dA = desc) :
    ∃ c : ℕ, IRuns Isym tbl (slSt stUp stDn body) (encK s F) (encK s G) c ∧
      (c : ℝ) ≤ 2 * Cs + cb := by
  obtain ⟨⟨cu, ru, ku⟩, -⟩ := hSet s F hF hR hd
  obtain ⟨-, ⟨cd, rd, kd⟩⟩ := hSet s G hG hRG hdG
  refine ⟨cu + (cb + cd), ru.seq (hb.seq rd), ?_⟩
  push_cast; linarith

section inst
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- The common facts of the extended state. -/
theorem slab_ext_facts {dA : Fin HS} (hfree : SlabFree dA) (F : Fin HS → List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ dA → j ≠ sZ → F j = []) (V : Fin 7 → List ℤ) :
    (∀ i, F (ρS i) = []) ∧ extend ρS V F 0 = F 0 ∧ extend ρS V F sZ = F sZ ∧
    extend ρS V F lA = [] ∧ extend ρS V F lC = [] ∧ extend ρS V F lD = [] ∧
    extend ρS V F rACC = [] := by
  obtain ⟨h0, hZ, hA, h1, h2, h3, h4⟩ := hfree
  refine ⟨fun i => hF _ (ρS_ne0 i) (fun h => hA i h) (ρS_neZ i), extS_out (fun i => ρS_ne0 i) _ _,
    extS_out (fun i => ρS_neZ i) _ _, ?_, ?_, ?_, ?_⟩
  · rw [extS_out (fun i => ρS_neA i)]; exact hF _ (by decide) (Ne.symm h1) (by decide)
  · rw [extS_out (fun i => ρS_neC i)]; exact hF _ (by decide) (Ne.symm h2) (by decide)
  · rw [extS_out (fun i => ρS_neD i)]; exact hF _ (by decide) (Ne.symm h3) (by decide)
  · rw [extS_out (fun i => ρS_neACC i)]; exact hF _ (by decide) (Ne.symm h4) (by decide)

theorem slab_G_facts {dA : Fin HS} (hfree : SlabFree dA) {desc : List ℤ} (F : Fin HS → List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ dA → j ≠ sZ → F j = []) (hd : F dA = desc) :
    (∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → F j = []) ∧ (∀ i, F (ρS i) = []) ∧
    F dA = desc :=
  ⟨fun j h1 h2 h3 _ => hF j h1 h3 h2,
    fun i => hF _ (ρS_ne0 i) (fun h => hfree.2.2.1 i h) (ρS_neZ i), hd⟩

/-- **The identity slab pass (passes 3, 5) as a step.** -/
theorem slabId_ok {stUp stDn : IStmt HS Pp} {dA : Fin HS} {desc : List ℤ} {n n' post pre Bu : ℕ}
    {src : ℕ → Option ℕ} {Cs : ℝ} (hfree : SlabFree dA) (hs : MonoSrc n n' src)
    (hnp : 0 < n * post)
    (hSet : SetupS Isym tbl stUp stDn ρS dA desc
      (slabV (ctlOf n n' src (fun _ => 0)) pre post n' [] []) Cs) :
    PassOK Isym tbl (slSt stUp stDn (passP (.op (.drop 0)) (.op (.mv 0 Slab.rT)) itI (.op (.mv Slab.rT 0))))
      dA desc (fun L => L.length = pre * (n * post) ∧ ∀ u ∈ gflat L, zsz u ≤ Bu)
      (slabPass n n' post src (fun _ z => z))
      (2 * Cs + (passC pre (ctlOf n n' src (fun _ => 0)).length (2 * post) 1
        (2 * Bu + 2 + (2 * moveCost Bu + 19) + 300 * (Bu + 1) + (2 * moveCost Bu + 19))
        (pre * (n' * (2 * post))) Bu : ℕ)) := by
  intro s F L l hF hd h0 ⟨hL, hBu⟩
  have hF' : ∀ j, j ≠ 0 → j ≠ dA → j ≠ sZ → F j = [] := fun j h1 h2 _ => hF j h1 h2
  set V := slabV (ctlOf n n' src (fun _ => 0)) pre post n' [] [] with hV
  obtain ⟨hR, e0, -, eA, eC, eD, eACC⟩ := slab_ext_facts hfree F hF' V
  set X := gflat (slabPass n n' post src (fun _ z => z) L) ++ l
  have hb := slabId_runs (I := Isym) (iprog := tbl) s (extend ρS V F) hnp hs L l hL hBu
    (by rw [e0, h0]) eA eC eD [] (by rw [List.append_nil]; exact extS V F 0) eACC
    (LM := []) (extS V F 1) (LN := []) (extS V F 2) (LB := []) (extS V F 3) (LT := [])
    (extS V F 4)
  rw [← extS_upd (fun i => ρS_ne0 i)] at hb
  obtain ⟨g1, g2, g3⟩ := slab_G_facts hfree F hF' hd
  obtain ⟨g1', g2', g3'⟩ := slab_G_facts hfree (update F 0 X)
    (fun j h1 h2 h3 => by rw [update_of_ne h1]; exact hF' j h1 h2 h3)
    (by rw [update_of_ne hfree.1, hd])
  exact slab_step hSet s F (update F 0 X) g1 g2 g3 hb g1' g2' g3'

end inst

