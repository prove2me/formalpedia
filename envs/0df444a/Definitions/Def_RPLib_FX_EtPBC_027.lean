-- ===== S4.Def_RP_EtPBC_A_EF =====
section

/-!
# S4-EtPBC-A, M4(E), EF: relations of the generators hold for the sections `f_j`

* `xmap ξ g : Spec κ(ξ) ×_P V ⟶ Spec κ(ξ) ×_P W`, `xmap_κp` (naturality of `κp`);
* `exists_gen_pt`: every point of `V ×_P Y` generizes to a point over the generic point `yg` of `Y`;
* `exists_κp_pre`: points of `V ×_P Y` over `yg` come from `X'`;
* `exists_beta`: a point of `X'_V` gives a fibre point `β` of `V` with `xmap g e = sx (τ (g β)) pt`;
* `key_pt`: the images of a point over `yg` in `W ×_P Y` are the sheet points `κp (sx (τ (g β)) pt)`;
* **`ef_rel`**: if `f_j` takes the value `[p]` at the sheet point of `p`, every relation of the `z_j` at any point
  `x` is a relation of the `f_j`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech GenAlg

universe u

variable {P : Scheme.{u}} {T : P.Etale} (ξ : T.left)

theorem xmap_κp {V W : P.Etale} (g : V ⟶ W) :
    xmap ξ g ≫ κp ξ W = κp ξ V ≫ ((etPull (πn T ξ)).map g).left := by
  refine pullback.hom_ext ?_ ?_
  · calc (xmap ξ g ≫ κp ξ W) ≫ pullback.fst W.hom (πn T ξ)
        = xmap ξ g ≫ pullback.snd (f0 T ξ) W.hom :=
          (Category.assoc _ _ _).trans (congrArg (xmap ξ g ≫ ·) (pullback.lift_fst _ _ _))
      _ = pullback.snd (f0 T ξ) V.hom ≫ g.left := xmap_snd ξ g
      _ = (κp ξ V ≫ pullback.fst V.hom (πn T ξ)) ≫ g.left :=
          congrArg (· ≫ g.left) (pullback.lift_fst _ _ _).symm
      _ = (κp ξ V ≫ ((etPull (πn T ξ)).map g).left) ≫ pullback.fst W.hom (πn T ξ) :=
          (Category.assoc _ _ _).trans ((congrArg (κp ξ V ≫ ·) (etPull_map_left_fst (πn T ξ) g).symm).trans
            (Category.assoc _ _ _).symm)
  · calc (xmap ξ g ≫ κp ξ W) ≫ pullback.snd W.hom (πn T ξ)
        = xmap ξ g ≫ pullback.fst (f0 T ξ) W.hom ≫ g0 T ξ :=
          (Category.assoc _ _ _).trans (congrArg (xmap ξ g ≫ ·) (pullback.lift_snd _ _ _))
      _ = pullback.fst (f0 T ξ) V.hom ≫ g0 T ξ :=
          (Category.assoc _ _ _).symm.trans (congrArg (· ≫ g0 T ξ) (xmap_fst ξ g))
      _ = κp ξ V ≫ pullback.snd V.hom (πn T ξ) := (pullback.lift_snd _ _ _).symm
      _ = (κp ξ V ≫ ((etPull (πn T ξ)).map g).left) ≫ pullback.snd W.hom (πn T ξ) :=
          (congrArg (κp ξ V ≫ ·) (etPull_map_left_snd (πn T ξ) g).symm).trans (Category.assoc _ _ _).symm

/-- **Generization to the generic fibre of `V ×_P Y ⟶ Y`.** -/
theorem exists_gen_pt (V : P.Etale) (w : Up ξ V) :
    ∃ ν, ν ⤳ w ∧ pullback.snd V.hom (πn T ξ) ν = yg T ξ := by
  have : Etale V.hom := V.prop
  have : Flat (pullback.snd V.hom (πn T ξ)) := inferInstance
  exact Flat.generalizingMap _ (yg_specializes T ξ _)

/-- **Points over `yg` come from `X'`.** -/
theorem exists_κp_pre (V : P.Etale) (ν : Up ξ V) (hν : pullback.snd V.hom (πn T ξ) ν = yg T ξ) :
    ∃ e : Xp ξ V, κp ξ V e = ν := by
  obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := pullback.snd V.hom (πn T ξ))
    (g := g0 T ξ) ν default hν
  let m : pullback (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ⟶ Xp ξ V :=
    pullback.lift (pullback.snd _ _) (pullback.fst _ _ ≫ pullback.fst _ _) (by
      calc pullback.snd (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ≫ f0 T ξ
          = pullback.snd (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ≫ g0 T ξ ≫ πn T ξ :=
            congrArg _ (g0_π T ξ).symm
        _ = (pullback.fst (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ≫ pullback.snd V.hom (πn T ξ)) ≫ πn T ξ :=
            (Category.assoc _ _ _).symm.trans (congrArg (· ≫ πn T ξ) pullback.condition.symm)
        _ = pullback.fst (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ≫ pullback.fst V.hom (πn T ξ) ≫ V.hom :=
            (Category.assoc _ _ _).trans (congrArg _ pullback.condition.symm)
        _ = (pullback.fst (pullback.snd V.hom (πn T ξ)) (g0 T ξ) ≫ pullback.fst V.hom (πn T ξ)) ≫ V.hom :=
            (Category.assoc _ _ _).symm)
  have hm : m ≫ κp ξ V = pullback.fst _ _ := by
    refine pullback.hom_ext ?_ ?_
    · exact (Category.assoc _ _ _).trans ((congrArg (m ≫ ·) (pullback.lift_fst _ _ _)).trans
        (pullback.lift_snd _ _ _))
    · exact (Category.assoc _ _ _).trans ((congrArg (m ≫ ·) (pullback.lift_snd _ _ _)).trans
        ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ g0 T ξ) (pullback.lift_fst _ _ _)).trans
          pullback.condition.symm)))
  exact ⟨m z, by rw [← Scheme.Hom.comp_apply, hm, hz1]⟩

