-- ===== S4.Def_RP_EtPBC_A_CovCv =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1c, part 1): the locally directed chart cover of `Y_{V'}`

`directed_of_range`: directedness of an open cover from its ranges. **`covV`**: the open cover of `Y_{V'} = Y ×_V Spec R'`
by the charts `Spec (R' ⊗ Γ(Y₀₁))`, `Spec (R' ⊗ Γ(Y₀))`, `Spec (R' ⊗ Γ(Y₁))`, indexed by `WalkingSpan`
(`zero ↦ Y₀₁`), with transition maps the `span` of the chart restrictions `a0`, `a1`; instance `LocallyDirected`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open RamanujanPetersson.EtPBC.Z3

universe u

/-- **Directedness of an open cover from its ranges.** -/
theorem directed_of_range {X : Scheme.{u}} (𝒰 : X.OpenCover) [Category 𝒰.I₀]
    (tr : ∀ {i j : 𝒰.I₀}, (i ⟶ j) → (𝒰.X i ⟶ 𝒰.X j)) (htr : ∀ {i j : 𝒰.I₀} (h : i ⟶ j), tr h ≫ 𝒰.f j = 𝒰.f i)
    (H : ∀ (i j : 𝒰.I₀) (z : X), z ∈ Set.range (𝒰.f i) → z ∈ Set.range (𝒰.f j) →
      ∃ (k : 𝒰.I₀) (_ : k ⟶ i) (_ : k ⟶ j), z ∈ Set.range (𝒰.f k))
    {i j : 𝒰.I₀} (x : (pullback (𝒰.f i) (𝒰.f j)).carrier) :
    ∃ (k : 𝒰.I₀) (hki : k ⟶ i) (hkj : k ⟶ j) (y : 𝒰.X k),
      pullback.lift (tr hki) (tr hkj) (by rw [htr, htr]) y = x := by
  have hc := congrArg (fun g : pullback (𝒰.f i) (𝒰.f j) ⟶ X => g x) (pullback.condition (f := 𝒰.f i) (g := 𝒰.f j))
  simp only [Scheme.Hom.comp_apply] at hc
  obtain ⟨k, hki, hkj, y, hy⟩ := H i j (𝒰.f i (pullback.fst (𝒰.f i) (𝒰.f j) x)) ⟨_, rfl⟩
    ⟨pullback.snd (𝒰.f i) (𝒰.f j) x, hc.symm⟩
  refine ⟨k, hki, hkj, y, (pullback.fst (𝒰.f i) (𝒰.f j)).injective ?_⟩
  apply (𝒰.f i).injective
  rw [← hy, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, pullback.lift_fst_assoc, htr]

variable (K : Type u) [Field K] {V : Scheme.{u}} (gV : V ⟶ Spec (CommRingCat.of K)) {Y : Scheme.{u}} [IsAffine V] (R' : Type u) [CommRing R'] [Algebra Γ(V, ⊤) R']

/-- The arrow `zero ⟶ j` of `WalkingSpan`. -/
def fromZ (j : WalkingSpan) : (WalkingSpan.zero ⟶ j) := by
  rcases j with _ | (_ | _)
  · exact 𝟙 _
  · exact WalkingSpan.Hom.fst
  · exact WalkingSpan.Hom.snd

end RamanujanPetersson.EtPBC.Cov

end

