    (hfA : f A = a ++ la) (hfZ : f Z = b ++ lb) (hab : a.length = b.length)
    (ha : NLogN.KIL.Bits a) (hb : NLogN.KIL.Bits b) (hfC : f C = []) (Bb : ℕ)
