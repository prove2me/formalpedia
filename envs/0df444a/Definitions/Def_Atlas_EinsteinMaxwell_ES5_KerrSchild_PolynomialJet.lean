/-! ### Seed definitions (unchanged) -/

noncomputable def fJet (M h J Q c : ℝ) : Polynomial ℝ :=
  C ((1 : ℝ)) +
    C ((-1 : ℝ) * M) * X ^ 1 +
    C (((1 : ℝ) / 2) * M ^ 2 + ((-1 : ℝ) / 2) * M * h + ((4 : ℝ) / 3) * Q ^ 2) * X ^ 2 +
    C (((-1 : ℝ) / 6) * M ^ 3 + ((1 : ℝ) / 2) * M ^ 2 * h + ((-1 : ℝ) / 3) * M * h ^ 2 + ((-16 : ℝ) / 9) * M * Q ^ 2 + ((4 : ℝ) / 3) * h * Q ^ 2 + ((2 : ℝ) / 3) * J ^ 2 + ((4 : ℝ) / 9) * c ^ 2) * X ^ 3

noncomputable def aJet (M h J Q c : ℝ) : Polynomial ℝ :=
  C ((1 : ℝ) * c) * X ^ 1 +
    C (((1 : ℝ) / 6) * M * c + ((1 : ℝ) / 2) * h * c + ((2 : ℝ) / 3) * J * Q) * X ^ 2 +
    C (((1 : ℝ) / 12) * M ^ 2 * c + ((1 : ℝ) / 6) * M * h * c + ((-1 : ℝ) / 6) * M * J * Q + ((1 : ℝ) / 4) * h ^ 2 * c + ((2 : ℝ) / 3) * h * J * Q) * X ^ 3 +
    C (((1 : ℝ) / 60) * M ^ 3 * c + ((1 : ℝ) / 8) * M ^ 2 * h * c + ((1 : ℝ) / 12) * M ^ 2 * J * Q + ((2 : ℝ) / 15) * M * h ^ 2 * c + ((-1 : ℝ) / 4) * M * h * J * Q + ((-34 : ℝ) / 135) * M * Q ^ 2 * c + ((1 : ℝ) / 8) * h ^ 3 * c + ((17 : ℝ) / 30) * h ^ 2 * J * Q + ((-7 : ℝ) / 30) * J ^ 2 * c + ((8 : ℝ) / 135) * J * Q ^ 3 + ((-2 : ℝ) / 45) * c ^ 3) * X ^ 4

noncomputable def mBarJet (M h _J _Q _c : ℝ) : Polynomial ℝ :=
  C ((1 : ℝ)) +
    C (((-1 : ℝ) / 2) * M + ((-1 : ℝ) / 2) * h) * X ^ 1

/-- `δ = d/dR = -x² d/dx` acting on polynomials in `x`. -/
noncomputable def deltaR (p : Polynomial ℝ) : Polynomial ℝ :=
  -(X ^ 2) * p.derivative

/-- The seed body of Γ with the a-jet as a free argument. -/
noncomputable def gammaWith (M h J Q c : ℝ) (a : Polynomial ℝ) : Polynomial ℝ :=
  let f := fJet M h J Q c
  let mbar := mBarJet M h J Q c
  let u := 1 - C h * X
  C Q * (u * X ^ 2 * f * deltaR (deltaR a)
    - u * deltaR (X ^ 2 * f) * deltaR a
    + C h * X ^ 4 * f * deltaR a)
    + C 2 * (C J + C (2 * Q) * a) * f * X ^ 3 * mbar * (deltaR a) ^ 2

/-- Γ for the transcribed jets. -/
noncomputable def gammaJet (M h J Q c : ℝ) : Polynomial ℝ :=
  gammaWith M h J Q c (aJet M h J Q c)

/-! ### Structural factorisation Γ = X⁵ K₁ + X⁷ K₂ -/

/-- `E p = -(2 p + x p')`, so that `δ(x² p) = x³ E p`. -/
noncomputable def ePart (p : Polynomial ℝ) : Polynomial ℝ :=
  -(C 2 * p + X * derivative p)

/-- The x⁵-part of Γ divided by x⁵. -/
noncomputable def gammaLow (M h J Q c : ℝ) (a : Polynomial ℝ) : Polynomial ℝ :=
  C Q * ((1 - C h * X) * (fJet M h J Q c * ePart (-derivative a)
      - ePart (fJet M h J Q c) * (-derivative a))
    + C h * X * fJet M h J Q c * (-derivative a))

/-- The x⁷-part of Γ divided by x⁷. -/
noncomputable def gammaHigh (M h J Q c : ℝ) (a : Polynomial ℝ) : Polynomial ℝ :=
  C 2 * (C J + C (2 * Q) * a) * fJet M h J Q c * mBarJet M h J Q c *
    (derivative a * derivative a)

