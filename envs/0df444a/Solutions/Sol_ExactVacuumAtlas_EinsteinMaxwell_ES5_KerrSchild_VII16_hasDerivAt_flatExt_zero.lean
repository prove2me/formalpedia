theorem solution {h : ℝ → ℝ} {ε : ℝ} (hε : 0 < ε)
    (hdiff : DifferentiableOn ℝ h (Ioo (0:ℝ) ε))
    (hlim0 : Tendsto h (𝓝[>] (0:ℝ)) (𝓝 0))
    (hlim1 : Tendsto (deriv h) (𝓝[>] (0:ℝ)) (𝓝 0)) :
    HasDerivAt (flatExt h) 0 0 := by
  have hdiffR : DifferentiableOn ℝ (flatExt h) (Ioo (0:ℝ) ε) := by
    intro y hy
    have hz : flatExt h =ᶠ[𝓝 y] h := by
      filter_upwards [Ioi_mem_nhds hy.1] with z hz'
      exact flatExt_of_pos hz'
    exact (DifferentiableAt.congr_of_eventuallyEq
      ((hdiff y hy).differentiableAt (Ioo_mem_nhds hy.1 hy.2)) hz).differentiableWithinAt
  have hm0 : Tendsto (flatExt h) (𝓝[Ioo (0:ℝ) ε] 0) (𝓝 (flatExt h 0)) := by
    rw [flatExt_zero]
    refine Tendsto.congr' ?_ (hlim0.mono_left (nhdsWithin_mono 0 Ioo_subset_Ioi_self))
    filter_upwards [self_mem_nhdsWithin] with y hy
    exact (flatExt_of_pos hy.1).symm
  have hderivR : Tendsto (fun x => deriv (flatExt h) x) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    refine Tendsto.congr' ?_ hlim1
    filter_upwards [Ioo_mem_nhdsGT' hε] with y hy
    have hz : flatExt h =ᶠ[𝓝 y] h := by
      filter_upwards [Ioi_mem_nhds hy.1] with z hz'
      exact flatExt_of_pos hz'
    simp only [hz.deriv_eq]
  have hright : HasDerivWithinAt (flatExt h) 0 (Ici 0) 0 :=
    hasDerivWithinAt_Ici_of_tendsto_deriv hdiffR hm0 (Ioo_mem_nhdsGT' hε) hderivR
  have hdiffL : DifferentiableOn ℝ (flatExt h) (Ioo (-ε) (0:ℝ)) := by
    intro y hy
    have hz : flatExt h =ᶠ[𝓝 y] (fun _ => (0:ℝ)) := by
      filter_upwards [Iio_mem_nhds hy.2] with z hz'
      exact flatExt_of_nonpos (not_lt.mpr hz'.le)
    exact (DifferentiableAt.congr_of_eventuallyEq (differentiableAt_const (c := (0:ℝ))) hz)
      |>.differentiableWithinAt
  have hmL : Tendsto (flatExt h) (𝓝[Ioo (-ε) (0:ℝ)] 0) (𝓝 (flatExt h 0)) := by
    rw [flatExt_zero]
    refine Tendsto.congr' ?_ (tendsto_const_nhds (x := (0:ℝ)))
    filter_upwards [self_mem_nhdsWithin] with y hy
    exact (flatExt_of_nonpos (not_lt.mpr hy.2.le)).symm
  have hderivL : Tendsto (fun x => deriv (flatExt h) x) (𝓝[<] (0:ℝ)) (𝓝 0) := by
    refine Tendsto.congr' ?_ tendsto_const_nhds
    filter_upwards [Ioo_mem_nhdsLT' hε] with y hy
    have hz : flatExt h =ᶠ[𝓝 y] (fun _ => (0:ℝ)) := by
      filter_upwards [Iio_mem_nhds hy.2] with z hz'
      exact flatExt_of_nonpos (not_lt.mpr hz'.le)
    simp only [hz.deriv_eq, deriv_const]
  have hleft : HasDerivWithinAt (flatExt h) 0 (Iic 0) 0 :=
    hasDerivWithinAt_Iic_of_tendsto_deriv hdiffL hmL (Ioo_mem_nhdsLT' hε) hderivL
  exact (hright.union hleft).hasDerivAt (by simp)
