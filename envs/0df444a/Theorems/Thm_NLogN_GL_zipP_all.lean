theorem NLogN.GL.zipP_all (M : MulSpec) {m Φm : ℕ} (hM : MulBnd M m Φm) (σ : Sg) (cN : Fin HS)
    (hcN : IsCnt cN) (p Q N : ℕ) (s : IState HS) (A U : List (ℤ × ℤ)) (R1 R2 LN LP : List Item)
    (hA : s.G gZA = gints A ++ R1) (hU : s.G gD = gints U ++ R2) (hlA : A.length = N)
    (hlU : U.length = N) (hN : s.G cN = .int N :: LN) (hP : s.G gPP = .int (2 ^ p) :: LP)
    (hAb : GB m A) (hUb : GB m U) (hmQ : 2 * m + 1 ≤ Q) (hpQ : p + 1 ≤ Q)
    (hNQ : zsz ((2 * N : ℕ) : ℤ) ≤ Q) :
    (zipP σ cN).run s = (s.upd gZA R1).upd gD (gints (List.zipWith (gzF σ p) A U) ++ R2) ∧
    (zipP σ cN).ok M s ∧
    (zipP σ cN).cost M s ≤ N * (4 * Φm + 200000 * (Q + 2)) + 20000 * (Q + 2) := by sorry
