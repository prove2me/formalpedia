def toField (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    ↥(B.toSubring ⊓ K'.toSubring) →+* ↥K' where
  toFun x := ⟨x.1, x.2.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem toField_apply_coe (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ))
    (x : ↥(B.toSubring ⊓ K'.toSubring)) : ((toField B K' x : ↥K') : AlgebraicClosure ℚ) = (x : AlgebraicClosure ℚ) :=
  rfl

theorem toField_injective (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    Function.Injective (toField B K') := by
  intro x y h
  apply Subtype.ext
  have := congrArg (fun z : ↥K' => (z : AlgebraicClosure ℚ)) h
  exact this

theorem isFractionRing_toField (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    letI := (toField B K').toAlgebra
    IsFractionRing ↥(B.toSubring ⊓ K'.toSubring) ↥K' := by
  letI := (toField B K').toAlgebra
  have halg : ∀ x, algebraMap ↥(B.toSubring ⊓ K'.toSubring) ↥K' x = toField B K' x := fun _ => rfl
  refine ⟨?_, ?_, ?_⟩
  ·
    rintro ⟨s, hs⟩
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    refine isUnit_iff_ne_zero.mpr ?_
    rw [halg]
    intro h
    exact hs0 (toField_injective B K' (by rw [h, map_zero]))
  ·
    intro y
    rcases B.mem_or_inv_mem (y : AlgebraicClosure ℚ) with hy | hy
    · refine ⟨⟨⟨(y : AlgebraicClosure ℚ), ⟨hy, y.2⟩⟩, 1⟩, ?_⟩
      simp only [OneMemClass.coe_one, map_one, mul_one]
      rw [halg]
      exact Subtype.ext rfl
    · by_cases hy0 : y = 0
      · refine ⟨⟨0, 1⟩, ?_⟩
        simp [hy0]
      have hyinv : ((y : AlgebraicClosure ℚ))⁻¹ ∈ B.toSubring ⊓ K'.toSubring :=
        ⟨hy, by simp⟩
      have hne : (⟨(y : AlgebraicClosure ℚ)⁻¹, hyinv⟩ : ↥(B.toSubring ⊓ K'.toSubring)) ≠ 0 := by
        intro h
        have := congrArg (fun z : ↥(B.toSubring ⊓ K'.toSubring) => (z : AlgebraicClosure ℚ)) h
        simp only [ZeroMemClass.coe_zero, inv_eq_zero] at this
        exact hy0 (Subtype.ext this)
      refine ⟨⟨1, ⟨⟨(y : AlgebraicClosure ℚ)⁻¹, hyinv⟩, mem_nonZeroDivisors_of_ne_zero hne⟩⟩, ?_⟩
      simp only [map_one]
      rw [halg]
      apply Subtype.ext
      change (y : AlgebraicClosure ℚ) * (y : AlgebraicClosure ℚ)⁻¹ = 1
      exact mul_inv_cancel₀ fun h => hy0 (Subtype.ext h)
  ·
    intro x y h
    rw [halg, halg] at h
    exact ⟨1, by rw [toField_injective B K' h]⟩

theorem isUnit_natCast_inf (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) {n : ℕ} (hn : IsUnit ((n : ℤ) : ↥B)) :
    IsUnit ((n : ℕ) : ↥(B.toSubring ⊓ K'.toSubring)) := by
  obtain ⟨u, hu⟩ := hn
  have hinvB : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) ∈ B := (↑u⁻¹ : ↥B).2

  have hval : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) = ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ := by
    have h := congrArg (fun z : ↥B => (z : AlgebraicClosure ℚ)) u.inv_mul
    simp only [hu, OneMemClass.coe_one] at h

    have h' : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) * ((n : ℕ) : AlgebraicClosure ℚ) = 1 := by simpa using h
    have hn0 : ((n : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by
      intro h0; rw [h0, mul_zero] at h'; exact zero_ne_one h'
    exact (eq_inv_of_mul_eq_one_left h')
  have hinvK : ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ K'.toSubring := by
    have : ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ K' := inv_mem (natCast_mem K' n)
    exact this
  have hmem : ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ B.toSubring ⊓ K'.toSubring := ⟨hval ▸ hinvB, hinvK⟩
  have hn0 : ((n : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by
    intro h0
    have h := congrArg (fun z : ↥B => (z : AlgebraicClosure ℚ)) u.inv_mul
    simp only [hu, OneMemClass.coe_one] at h
    have : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) * ((n : ℕ) : AlgebraicClosure ℚ) = 1 := by simpa using h
    rw [h0, mul_zero] at this
    exact zero_ne_one this
  refine ⟨⟨(n : ↥(B.toSubring ⊓ K'.toSubring)), ⟨((n : ℕ) : AlgebraicClosure ℚ)⁻¹, hmem⟩, ?_, ?_⟩, rfl⟩
  · apply Subtype.ext
    change ((n : ℕ) : AlgebraicClosure ℚ) * ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ = 1
    exact mul_inv_cancel₀ hn0
  · apply Subtype.ext
    change ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ * ((n : ℕ) : AlgebraicClosure ℚ) = 1
    exact inv_mul_cancel₀ hn0

end Arithmetic

section GaloisModule

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
  {K₀ : Type} [CommRing K₀] {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of K₀)}
  (L₀ : RelativeGroupLaw K₀ f₀) (hc₀ : L₀.IsCommutative)
  (act : ↥Λ → (A₀ ⟶ A₀)) (act_over : ∀ x : ↥Λ, act x ≫ f₀ = f₀)
  (act_hom : ∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of K₀)) (u v : SchemeHomOver t f₀),
    pushPt (act x) (act_over x) (L₀.mul t u v) = L₀.mul t (pushPt (act x) (act_over x) u) (pushPt (act x) (act_over x) v))
  (Ω : Type) [CommRing Ω] [Algebra K₀ Ω]

def actPt (x : ↥Λ) : L₀.AlgPoints hc₀ Ω →+ L₀.AlgPoints hc₀ Ω :=
  AddMonoidHom.mk'
    (fun P => RelativeGroupLaw.AlgPoints.ofPoint
      (pushPt (act x) (act_over x) (RelativeGroupLaw.AlgPoints.toPoint P)))
    fun P Q => by
      apply RelativeGroupLaw.AlgPoints.toPoint_injective
      rw [RelativeGroupLaw.AlgPoints.toPoint_add]
      simp only [RelativeGroupLaw.AlgPoints.toPoint_ofPoint, RelativeGroupLaw.AlgPoints.toPoint_add]
      exact act_hom x _ _ _

@[scoped simp] theorem toPoint_actPt_coe (x : ↥Λ) (P : L₀.AlgPoints hc₀ Ω) :
    (RelativeGroupLaw.AlgPoints.toPoint (actPt L₀ hc₀ act act_over act_hom Ω x P)).1 =
      (RelativeGroupLaw.AlgPoints.toPoint P).1 ≫ act x := rfl

theorem actPt_one (act_one : ∀ h : (1 : ℍ[ℚ, a, b]) ∈ Λ, act ⟨1, h⟩ = 𝟙 A₀) (h : (1 : ℍ[ℚ, a, b]) ∈ Λ) :
    actPt L₀ hc₀ act act_over act_hom Ω ⟨1, h⟩ = AddMonoidHom.id _ := by
  refine AddMonoidHom.ext fun P => RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext ?_)
  rw [toPoint_actPt_coe, act_one h, Category.comp_id]
  rfl

theorem actPt_mul
    (act_mul : ∀ (x y : ↥Λ) (h : (x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]) ∈ Λ),
      act ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩ = act y ≫ act x)
    (x y : ↥Λ) (h : (x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]) ∈ Λ) :
    actPt L₀ hc₀ act act_over act_hom Ω ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩ =
      (actPt L₀ hc₀ act act_over act_hom Ω x).comp (actPt L₀ hc₀ act act_over act_hom Ω y) := by
  refine AddMonoidHom.ext fun P => RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext ?_)
  rw [toPoint_actPt_coe, act_mul x y h, AddMonoidHom.comp_apply, toPoint_actPt_coe, toPoint_actPt_coe,
    Category.assoc]

theorem actPt_add
    (act_add : ∀ (x y : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of K₀)) (u : SchemeHomOver t f₀),
      pushPt (act (x + y)) (act_over (x + y)) u =
        L₀.mul t (pushPt (act x) (act_over x) u) (pushPt (act y) (act_over y) u))
    (x y : ↥Λ) :
    actPt L₀ hc₀ act act_over act_hom Ω (x + y) =
      actPt L₀ hc₀ act act_over act_hom Ω x + actPt L₀ hc₀ act act_over act_hom Ω y := by
  refine AddMonoidHom.ext fun P => RelativeGroupLaw.AlgPoints.toPoint_injective ?_
  rw [AddMonoidHom.add_apply, RelativeGroupLaw.AlgPoints.toPoint_add]
  change pushPt (act (x + y)) (act_over (x + y)) (RelativeGroupLaw.AlgPoints.toPoint P) = _
  rw [act_add x y]
  rfl

end GaloisModule

theorem smul_actPt {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
    {K₀ : Type} [Field K₀] {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of K₀)}
    (L₀ : RelativeGroupLaw K₀ f₀) (hc₀ : L₀.IsCommutative)
    (act : ↥Λ → (A₀ ⟶ A₀)) (act_over : ∀ x : ↥Λ, act x ≫ f₀ = f₀)
    (act_hom : ∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of K₀)) (u v : SchemeHomOver t f₀),
      pushPt (act x) (act_over x) (L₀.mul t u v) =
        L₀.mul t (pushPt (act x) (act_over x) u) (pushPt (act x) (act_over x) v))
    (Ω : Type) [CommRing Ω] [Algebra K₀ Ω]
    (σ : Ω ≃ₐ[K₀] Ω) (x : ↥Λ) (P : L₀.AlgPoints hc₀ Ω) :
    σ • actPt L₀ hc₀ act act_over act_hom Ω x P = actPt L₀ hc₀ act act_over act_hom Ω x (σ • P) := by
  refine RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext ?_)
  rw [RelativeGroupLaw.AlgPoints.toPoint_smul_coe, toPoint_actPt_coe, toPoint_actPt_coe,
    RelativeGroupLaw.AlgPoints.toPoint_smul_coe, Category.assoc]

section BaseChangeP

variable {S₀ S₁ : Type} [CommRing S₀] [CommRing S₁] (ι : S₀ →+* S₁)
  {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of S₀)} (L₀ : RelativeGroupLaw S₀ f₀)
  {P : Scheme.{0}} {fP : P ⟶ Spec (CommRingCat.of S₁)} (LP : RelativeGroupLaw S₁ fP)
  (gP : P ⟶ A₀) (hgP : CategoryTheory.IsPullback gP fP f₀ (Spec.map (CommRingCat.ofHom ι)))
  (hmulP : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (x y : SchemeHomOver t' fP),
    (LP.mul t' x y).1 ≫ gP =
      (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom ι))
        ⟨x.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, y.2]⟩).1)

include hmulP in

theorem isCommutative_of_isPullback (hc₀ : L₀.IsCommutative) : LP.IsCommutative := by
  intro T t' x y
  apply Subtype.ext
  apply hgP.hom_ext
  · rw [hmulP, hmulP, hc₀.mul_comm]
  · rw [(LP.mul t' x y).2, (LP.mul t' y x).2]

theorem abelianSchemePropertyBundle_of_iso {R : Type} [CommRing R] {X Q : Scheme.{0}}
    {fX : X ⟶ Spec (CommRingCat.of R)} {fQ : Q ⟶ Spec (CommRingCat.of R)}
    (e : X ⟶ Q) [IsIso e] (he : e ≫ fQ = fX) (LX : RelativeGroupLaw R fX)
    (hQ : AbelianSchemePropertyBundle R fQ) : AbelianSchemePropertyBundle R fX := by
  refine ⟨?_, ?_, ?_, ⟨LX⟩⟩
  · rw [← he]
    exact (MorphismProperty.cancel_left_of_respectsIso @Smooth e fQ).mpr hQ.smooth
  · rw [← he]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsProper e fQ).mpr hQ.proper
  · intro s
    have hset : fX.base ⁻¹' {s} = e.homeomorph ⁻¹' (fQ.base ⁻¹' {s}) := by
      rw [← he, Scheme.Hom.comp_base, ← Set.preimage_comp]
      rfl
    rw [hset, Homeomorph.isConnected_preimage]
    exact hQ.connectedFibres s

theorem abelianSchemePropertyBundle_of_isPullback {S₀ : Type} [CommRing S₀] {S₁ : Type} [Field S₁] (ι : S₀ →+* S₁)
    {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of S₀)} (h₀ : AbelianSchemePropertyBundle S₀ f₀)
    {P : Scheme.{0}} {fP : P ⟶ Spec (CommRingCat.of S₁)} (LP : RelativeGroupLaw S₁ fP)
    (gP : P ⟶ A₀) (hgP : CategoryTheory.IsPullback gP fP f₀ (Spec.map (CommRingCat.ofHom ι))) :
    AbelianSchemePropertyBundle S₁ fP := by
  have hbc := AbelianSchemePropertyBundle.baseChange_of_field h₀ (Spec.map (CommRingCat.ofHom ι))
  haveI : IsIso (hgP.isoPullback).hom := inferInstance
  exact abelianSchemePropertyBundle_of_iso (hgP.isoPullback).hom (hgP.isoPullback_hom_snd) LP hbc

end BaseChangeP

theorem mul_val_congr {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

section Transport

variable (K K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (hKK' : K ≤ K')
  {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of ↥K)} (L₀ : RelativeGroupLaw ↥K f₀) (hc₀ : L₀.IsCommutative)
  {P : Scheme.{0}} {fP : P ⟶ Spec (CommRingCat.of ↥K')} (LP : RelativeGroupLaw ↥K' fP) (hcP : LP.IsCommutative)
  (gP : P ⟶ A₀)
  (hgP : CategoryTheory.IsPullback gP fP f₀ (Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom)))

theorem specMap_algebraMap_comp_inclusion :
    Spec.map (CommRingCat.ofHom (algebraMap ↥K' (AlgebraicClosure ℚ))) ≫
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥K (AlgebraicClosure ℚ))) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rfl

def transfer (y : LP.AlgPoints hcP (AlgebraicClosure ℚ)) : L₀.AlgPoints hc₀ (AlgebraicClosure ℚ) :=
  RelativeGroupLaw.AlgPoints.ofPoint
    ⟨(RelativeGroupLaw.AlgPoints.toPoint y).1 ≫ gP, by
      rw [Category.assoc, hgP.w, ← Category.assoc, (RelativeGroupLaw.AlgPoints.toPoint y).2,
        specMap_algebraMap_comp_inclusion K K' hKK']⟩

@[scoped simp] theorem toPoint_transfer_coe (y : LP.AlgPoints hcP (AlgebraicClosure ℚ)) :
    (RelativeGroupLaw.AlgPoints.toPoint (transfer K K' hKK' L₀ hc₀ LP hcP gP hgP y)).1 =
      (RelativeGroupLaw.AlgPoints.toPoint y).1 ≫ gP := rfl

theorem transfer_injective : Function.Injective (transfer K K' hKK' L₀ hc₀ LP hcP gP hgP) := by
  intro y y' h
  have h1 := congrArg (fun z => (RelativeGroupLaw.AlgPoints.toPoint z).1) h
  refine RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext (hgP.hom_ext h1 ?_))
  rw [(RelativeGroupLaw.AlgPoints.toPoint y).2, (RelativeGroupLaw.AlgPoints.toPoint y').2]

theorem transfer_add
    (hmulP : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (x y : SchemeHomOver t' fP),
      (LP.mul t' x y).1 ≫ gP =
        (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom))
          ⟨x.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, y.2]⟩).1)
    (y y' : LP.AlgPoints hcP (AlgebraicClosure ℚ)) :
    transfer K K' hKK' L₀ hc₀ LP hcP gP hgP (y + y') =
      transfer K K' hKK' L₀ hc₀ LP hcP gP hgP y + transfer K K' hKK' L₀ hc₀ LP hcP gP hgP y' := by
  refine RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext ?_)
  rw [toPoint_transfer_coe K K' hKK' L₀ hc₀ LP hcP gP hgP (y + y'), RelativeGroupLaw.AlgPoints.toPoint_add,
    RelativeGroupLaw.AlgPoints.toPoint_add, hmulP]
  apply mul_val_congr L₀ (specMap_algebraMap_comp_inclusion K K' hKK')
  · rfl
  · rfl

def transferHom
    (hmulP : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (x y : SchemeHomOver t' fP),
      (LP.mul t' x y).1 ≫ gP =
        (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom))
          ⟨x.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, y.2]⟩).1) :
    LP.AlgPoints hcP (AlgebraicClosure ℚ) →+ L₀.AlgPoints hc₀ (AlgebraicClosure ℚ) :=
  AddMonoidHom.mk' (transfer K K' hKK' L₀ hc₀ LP hcP gP hgP) (transfer_add K K' hKK' L₀ hc₀ LP hcP gP hgP hmulP)

theorem transfer_smul (σ' : AlgebraicClosure ℚ ≃ₐ[↥K'] AlgebraicClosure ℚ)
    (σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ) (h : ∀ x, σ' x = σ x)
    (y : LP.AlgPoints hcP (AlgebraicClosure ℚ)) :
    transfer K K' hKK' L₀ hc₀ LP hcP gP hgP (σ' • y) = σ • transfer K K' hKK' L₀ hc₀ LP hcP gP hgP y := by
  refine RelativeGroupLaw.AlgPoints.toPoint_injective (Subtype.ext ?_)
  rw [toPoint_transfer_coe K K' hKK' L₀ hc₀ LP hcP gP hgP (σ' • y), RelativeGroupLaw.AlgPoints.toPoint_smul_coe,
    RelativeGroupLaw.AlgPoints.toPoint_smul_coe, toPoint_transfer_coe K K' hKK' L₀ hc₀ LP hcP gP hgP y, Category.assoc]
  have hστ : (σ' : AlgebraicClosure ℚ →ₐ[↥K'] AlgebraicClosure ℚ).toRingHom =
      (σ : AlgebraicClosure ℚ →ₐ[↥K] AlgebraicClosure ℚ).toRingHom := RingHom.ext fun x => h x
  rw [hστ]

end Transport

section ClosureTransport

variable {K₁ : Type} [Field K₁] {P : Scheme.{0}} {fP : P ⟶ Spec (CommRingCat.of K₁)}
  (LP : RelativeGroupLaw K₁ fP) (hcP : LP.IsCommutative)
  {Ω Ω' : Type} [Field Ω] [Field Ω'] [Algebra K₁ Ω] [Algebra K₁ Ω'] (θ : Ω ≃ₐ[K₁] Ω')

theorem map_algEquiv_injective :
    Function.Injective (RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[K₁] Ω')) := by
  intro y y' h
  have h2 := congrArg (RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ.symm : Ω' →ₐ[K₁] Ω)) h
  have hcomp : (RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ.symm : Ω' →ₐ[K₁] Ω)).comp
      (RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[K₁] Ω')) = AddMonoidHom.id _ := by
    rw [← RelativeGroupLaw.AlgPoints.map_comp]
    have : (θ.symm : Ω' →ₐ[K₁] Ω).comp (θ : Ω →ₐ[K₁] Ω') = AlgHom.id K₁ Ω := by
      ext x; simp
    rw [this, RelativeGroupLaw.AlgPoints.map_id]
  have h3 := congrArg (fun F : LP.AlgPoints hcP Ω →+ LP.AlgPoints hcP Ω => F y) hcomp
  have h4 := congrArg (fun F : LP.AlgPoints hcP Ω →+ LP.AlgPoints hcP Ω => F y') hcomp
  simp only [AddMonoidHom.comp_apply, AddMonoidHom.id_apply] at h3 h4
  rw [← h3, ← h4, h2]

theorem map_algEquiv_smul (σ : Ω ≃ₐ[K₁] Ω) (y : LP.AlgPoints hcP Ω) :
    RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[K₁] Ω') (σ • y) =
      (θ.symm.trans (σ.trans θ)) • RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[K₁] Ω') y := by
  rw [RelativeGroupLaw.AlgPoints.smul_def, RelativeGroupLaw.AlgPoints.smul_def, ← AddMonoidHom.comp_apply,
    ← AddMonoidHom.comp_apply, ← RelativeGroupLaw.AlgPoints.map_comp, ← RelativeGroupLaw.AlgPoints.map_comp]
  have hcomp : (θ : Ω →ₐ[K₁] Ω').comp (σ : Ω →ₐ[K₁] Ω) =
      ((θ.symm.trans (σ.trans θ) : Ω' ≃ₐ[K₁] Ω') : Ω' →ₐ[K₁] Ω').comp (θ : Ω →ₐ[K₁] Ω') := by
    ext x
    simp
  rw [hcomp]

end ClosureTransport

section InertiaTransport

variable {K₁ : Type} [Field K₁] {Ω : Type} [Field Ω] [Algebra K₁ Ω]

theorem smul_eq_of_mem_inertiaSubgroupIn (A : ValuationSubring Ω) {σ : Ω ≃ₐ[K₁] Ω}
    (hσ : σ ∈ A.inertiaSubgroupIn K₁) : σ • A = A := by
  obtain ⟨d, -, rfl⟩ := Subgroup.mem_map.mp hσ
  exact d.2

theorem mem_iff_apply_mem_of_mem_inertiaSubgroupIn (A : ValuationSubring Ω) {σ : Ω ≃ₐ[K₁] Ω}
    (hσ : σ ∈ A.inertiaSubgroupIn K₁) (x : Ω) : σ x ∈ A ↔ x ∈ A := by
  have h := smul_eq_of_mem_inertiaSubgroupIn A hσ
  constructor
  · intro hx
    have : σ x ∈ σ • A := by rw [h]; exact hx
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def] at this
    simpa using this
  · intro hx
    have : σ • x ∈ σ • A := ValuationSubring.smul_mem_pointwise_smul σ x A hx
    rw [h, AlgEquiv.smul_def] at this
    exact this

end InertiaTransport

theorem mem_inertiaSubgroupIn_of_conj
    (K K' : IntermediateField ℚ (AlgebraicClosure ℚ))
    {Ω : Type} [Field Ω] [Algebra ↥K' Ω] (θ : Ω ≃ₐ[↥K'] AlgebraicClosure ℚ)
    (AΩ : ValuationSubring Ω) {σΩ : Ω ≃ₐ[↥K'] Ω} (hσΩ : σΩ ∈ AΩ.inertiaSubgroupIn ↥K')
    (σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ) (hσ : ∀ x, σ x = θ (σΩ (θ.symm x))) :
    σ ∈ (AΩ.comap (θ.symm : AlgebraicClosure ℚ →ₐ[↥K'] Ω).toRingHom).inertiaSubgroupIn ↥K := by
  set A : ValuationSubring (AlgebraicClosure ℚ) := AΩ.comap (θ.symm : AlgebraicClosure ℚ →ₐ[↥K'] Ω).toRingHom
    with hA_def
  have hA : ∀ x : AlgebraicClosure ℚ, x ∈ A ↔ θ.symm x ∈ AΩ := fun x => ValuationSubring.mem_comap
  have hσinvΩ : σΩ⁻¹ ∈ AΩ.inertiaSubgroupIn ↥K' := inv_mem hσΩ

  have hσinv : ∀ x, σ⁻¹ x = θ (σΩ⁻¹ (θ.symm x)) := by
    intro x
    have h1 : σ (θ (σΩ⁻¹ (θ.symm x))) = x := by
      rw [hσ]; simp [AlgEquiv.aut_inv]
    calc σ⁻¹ x = σ⁻¹ (σ (θ (σΩ⁻¹ (θ.symm x)))) := by rw [h1]
      _ = θ (σΩ⁻¹ (θ.symm x)) := by simp [AlgEquiv.aut_inv]

  have hstab : σ • A = A := by
    ext x
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def, hA, hA, hσinv,
      AlgEquiv.symm_apply_apply]
    exact mem_iff_apply_mem_of_mem_inertiaSubgroupIn AΩ hσinvΩ (θ.symm x)
  refine ValuationSubring.mem_inertiaSubgroupIn_of_valuation_sub_lt_one A hstab fun x hx => ?_

  rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]
  have hxΩ : θ.symm x ∈ AΩ := (hA x).mp hx
  obtain ⟨-, hlt⟩ := ValuationSubring.valuation_sub_lt_one_of_mem_inertiaSubgroupIn AΩ hσΩ hxΩ
  rw [← ValuationSubring.mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or] at hlt
  have hdiff : θ.symm (σ x - x) = σΩ (θ.symm x) - θ.symm x := by
    rw [map_sub, hσ, AlgEquiv.symm_apply_apply]
  rcases hlt with h0 | hninv
  · left
    have : θ.symm (σ x - x) = 0 := by rw [hdiff, h0]
    simpa using congrArg θ this
  · right
    rw [hA, map_inv₀, hdiff]
    exact hninv

theorem isAlgClosure_intermediateField (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    IsAlgClosure ↥K' (AlgebraicClosure ℚ) := by
  have hQ : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := by
    convert AlgebraicClosure.isAlgebraic ℚ
    rfl
    rfl
  haveI : Algebra.IsAlgebraic ↥K' (AlgebraicClosure ℚ) := Algebra.IsAlgebraic.tower_top (K := ℚ) ↥K'
  exact IsAlgClosure.mk inferInstance inferInstance

theorem exists_restrict_intermediateField (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥K]
    (L : IntermediateField ↥K (AlgebraicClosure ℚ)) [hL : FiniteDimensional ↥K ↥L] :
    ∃ F : IntermediateField ℚ (AlgebraicClosure ℚ), FiniteDimensional ℚ ↥F ∧ K ≤ F ∧
      ∀ x : AlgebraicClosure ℚ, x ∈ F ↔ x ∈ L := by
  refine ⟨L.restrictScalars ℚ, ?_, ?_, fun x => Iff.rfl⟩
  · haveI : FiniteDimensional ℚ ↥L := FiniteDimensional.trans ℚ ↥K ↥L
    change FiniteDimensional ℚ ↥L
    infer_instance
  · intro x hx
    change x ∈ L
    have : algebraMap ↥K (AlgebraicClosure ℚ) ⟨x, hx⟩ ∈ L := L.algebraMap_mem _
    exact this

set_option synthInstance.maxHeartbeats 1600000 in

theorem nonempty_algEquiv_algebraicClosure (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    Nonempty (AlgebraicClosure ↥K' ≃ₐ[↥K'] AlgebraicClosure ℚ) := by
  haveI : IsAlgClosure ↥K' (AlgebraicClosure ℚ) := isAlgClosure_intermediateField K'
  exact ⟨IsAlgClosure.equiv ↥K' _ _⟩

def restrictAut (K K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (hKK' : K ≤ K')
    (σ' : AlgebraicClosure ℚ ≃ₐ[↥K'] AlgebraicClosure ℚ) : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ :=
  AlgEquiv.ofRingEquiv (f := (σ' : AlgebraicClosure ℚ ≃+* AlgebraicClosure ℚ)) fun z =>
    σ'.commutes (⟨(z : AlgebraicClosure ℚ), hKK' z.2⟩ : ↥K')

theorem restrictAut_apply (K K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (hKK' : K ≤ K')
    (σ' : AlgebraicClosure ℚ ≃ₐ[↥K'] AlgebraicClosure ℚ) (z : AlgebraicClosure ℚ) :
    restrictAut K K' hKK' σ' z = σ' z := rfl

theorem smul_eq_of_torsion_of_mem_inertiaSubgroupIn
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
    {ℓ : ℕ} [Fact ℓ.Prime] (hdiv : ∀ x : ℍ[ℚ, a, b] ⊗[ℚ] ℚ_[ℓ], x ≠ 0 → IsUnit x) (hΛo : IsOrder Λ)
    (K K' : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥K] [FiniteDimensional ℚ ↥K']
    (hKK' : K ≤ K')
    {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of ↥K)} (L₀ : RelativeGroupLaw ↥K f₀) (hc₀ : L₀.IsCommutative)
    (i : ↥Λ → L₀.AlgPoints hc₀ (AlgebraicClosure ℚ) →+ L₀.AlgPoints hc₀ (AlgebraicClosure ℚ))
    (hi_one : ∀ h : (1 : ℍ[ℚ, a, b]) ∈ Λ, i ⟨1, h⟩ = AddMonoidHom.id _)
    (hi_mul : ∀ (x y : ↥Λ) (h : (x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]) ∈ Λ),
      i ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩ = (i x).comp (i y))
    (hi_add : ∀ x y : ↥Λ, i (x + y) = i x + i y)
    (hi_smul : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ) (x : ↥Λ)
      (m : L₀.AlgPoints hc₀ (AlgebraicClosure ℚ)), σ • i x m = i x (σ • m))
    {P : Scheme.{0}} {fP : P ⟶ Spec (CommRingCat.of ↥K')} (LP : RelativeGroupLaw ↥K' fP) (hcP : LP.IsCommutative)
    (gP : P ⟶ A₀)
    (hgP : CategoryTheory.IsPullback gP fP f₀
      (Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom)))
    (hmulP : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (x y : SchemeHomOver t' fP),
      (LP.mul t' x y).1 ≫ gP =
        (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion hKK').toRingHom))
          ⟨x.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gP, by rw [Category.assoc, hgP.w, ← Category.assoc, y.2]⟩).1)
    (hcard : ∀ n : ℕ, Nat.card (Submodule.torsionBy ℤ (L₀.AlgPoints hc₀ (AlgebraicClosure ℚ))
      ((ℓ ^ n : ℕ) : ℤ)) = (ℓ ^ n) ^ 4)
    (hcont : ∀ n : ℕ, ∃ Fn : IntermediateField ℚ (AlgebraicClosure ℚ), FiniteDimensional ℚ ↥Fn ∧
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ, (∀ x ∈ Fn, σ x = x) →
        ∀ m ∈ Submodule.torsionBy ℤ (L₀.AlgPoints hc₀ (AlgebraicClosure ℚ)) ((ℓ ^ n : ℕ) : ℤ), σ • m = m)
    {c : ℕ} (hc : 3 ≤ ℓ ^ c)
    (hlevel : ∀ σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ, (∀ x ∈ K', σ x = x) →
      ∀ m ∈ Submodule.torsionBy ℤ (L₀.AlgPoints hc₀ (AlgebraicClosure ℚ)) ((ℓ ^ c : ℕ) : ℤ), σ • m = m)
    {Ω : Type} [Field Ω] [Algebra ↥K' Ω] (θ : Ω ≃ₐ[↥K'] AlgebraicClosure ℚ)
    (AΩ : ValuationSubring Ω) (hℓA' : ((ℓ : ℕ) : Ω)⁻¹ ∈ AΩ)
    {σΩ : Ω ≃ₐ[↥K'] Ω} (hσΩ : σΩ ∈ AΩ.inertiaSubgroupIn ↥K')
    (v : ℕ) (y : LP.AlgPoints hcP Ω) (hy : (ℓ ^ v : ℕ) • y = 0) : σΩ • y = y := by
  have hℓp : ℓ.Prime := Fact.out

  let y' : LP.AlgPoints hcP (AlgebraicClosure ℚ) :=
    RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[↥K'] AlgebraicClosure ℚ) y
  let m : L₀.AlgPoints hc₀ (AlgebraicClosure ℚ) := transfer K K' hKK' L₀ hc₀ LP hcP gP hgP y'
  have hm : m ∈ Submodule.torsionBy ℤ (L₀.AlgPoints hc₀ (AlgebraicClosure ℚ)) ((ℓ ^ v : ℕ) : ℤ) := by
    rw [Submodule.mem_torsionBy_iff, natCast_zsmul]
    change (ℓ ^ v : ℕ) • transferHom K K' hKK' L₀ hc₀ LP hcP gP hgP hmulP
      (RelativeGroupLaw.AlgPoints.map (L := LP) (hc := hcP) (θ : Ω →ₐ[↥K'] AlgebraicClosure ℚ) y) = 0
    rw [← map_nsmul, ← map_nsmul, hy, map_zero, map_zero]

  let σ' : AlgebraicClosure ℚ ≃ₐ[↥K'] AlgebraicClosure ℚ := θ.symm.trans (σΩ.trans θ)
  let σ : AlgebraicClosure ℚ ≃ₐ[↥K] AlgebraicClosure ℚ := restrictAut K K' hKK' σ'
  have hσσ' : ∀ z, σ' z = σ z := fun z => (restrictAut_apply K K' hKK' σ' z).symm
  have hσθ : ∀ z, σ z = θ (σΩ (θ.symm z)) := fun z => by rw [← hσσ']; rfl
  have hσK' : ∀ z ∈ K', σ z = z := fun z hz => by
    rw [← hσσ']
    exact σ'.commutes ⟨z, hz⟩

  have hσA := mem_inertiaSubgroupIn_of_conj K K' θ AΩ hσΩ σ hσθ
  have hℓ0 : ((ℓ : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by exact_mod_cast hℓp.ne_zero
  have hA2 : ((ℓ : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈
      AΩ.comap (θ.symm : AlgebraicClosure ℚ →ₐ[↥K'] Ω).toRingHom := by
    rw [ValuationSubring.mem_comap]
    simpa using hℓA'
  have hℓunit : IsUnit ((ℓ : ℕ) : ↥(AΩ.comap (θ.symm : AlgebraicClosure ℚ →ₐ[↥K'] Ω).toRingHom)) := by
    refine ⟨⟨_, ⟨((ℓ : ℕ) : AlgebraicClosure ℚ)⁻¹, hA2⟩, ?_, ?_⟩, rfl⟩
    · exact Subtype.ext (mul_inv_cancel₀ hℓ0)
    · exact Subtype.ext (inv_mul_cancel₀ hℓ0)

  have hfix : σ • m = m :=
    QuaternionAlgebra.IsOrder.smul_eq_of_mem_inertiaSubgroupIn_of_mem_torsionBy_of_forall_isUnit_tensorProduct_padic
      hΛo hdiv K hcard hcont i hi_one hi_mul hi_add hi_smul hc K' hKK' hlevel _ hℓunit hσK' hσA v m hm

  have hfix' : σ' • y' = y' := by
    apply transfer_injective K K' hKK' L₀ hc₀ LP hcP gP hgP
    rw [transfer_smul K K' hKK' L₀ hc₀ LP hcP gP hgP σ' σ hσσ']
    exact hfix
  apply map_algEquiv_injective LP hcP θ
  rw [map_algEquiv_smul]
  exact hfix'

section LiesOver

variable (B : ValuationSubring (AlgebraicClosure ℚ))

theorem valuation_natCast_eq_one_of_forall (h : ∀ p : ℕ, p.Prime → ¬ B.LiesOverPrime p) :
    ∀ n : ℕ, n ≠ 0 → B.valuation (n : AlgebraicClosure ℚ) = 1 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn
    by_cases h1 : n = 1
    · subst h1; simp
    obtain ⟨p, hp, hpn⟩ := Nat.exists_prime_and_dvd h1
    obtain ⟨m, rfl⟩ := hpn
    have hm0 : m ≠ 0 := by rintro rfl; simp at hn
    have hmlt : m < p * m := by
      have := hp.one_lt
      nlinarith [Nat.pos_of_ne_zero hm0]
    have hvp : B.valuation (p : AlgebraicClosure ℚ) = 1 := by
      have hle : B.valuation (p : AlgebraicClosure ℚ) ≤ 1 :=
        (B.valuation_le_one_iff _).mpr (natCast_mem B p)
      have hnlt : ¬ B.valuation (p : AlgebraicClosure ℚ) < 1 := by
        intro hlt
        exact h p hp ((B.mem_nonunits_iff).mpr hlt)
      exact le_antisymm hle (not_lt.mp hnlt)
    rw [Nat.cast_mul, map_mul, hvp, one_mul]
    exact ih m hmlt hm0

theorem ratCast_mem_of_forall (h : ∀ p : ℕ, p.Prime → ¬ B.LiesOverPrime p) (q : ℚ) :
    (q : AlgebraicClosure ℚ) ∈ B := by
  have hden : B.valuation ((q.den : ℕ) : AlgebraicClosure ℚ) = 1 :=
    valuation_natCast_eq_one_of_forall B h q.den q.den_nz
  rw [← B.valuation_le_one_iff, Rat.cast_def, map_div₀]
  have hnum : B.valuation ((q.num : ℤ) : AlgebraicClosure ℚ) ≤ 1 :=
    (B.valuation_le_one_iff _).mpr (intCast_mem B q.num)
  rw [hden, div_one]
  exact hnum

theorem exists_prime_liesOverPrime (hB : B ≠ ⊤) : ∃ p : ℕ, p.Prime ∧ B.LiesOverPrime p := by
  by_contra hcon
  push Not at hcon
  apply hB

  have hmem : ∀ q : ℚ, algebraMap ℚ (AlgebraicClosure ℚ) q ∈ B := fun q => by
    rw [eq_ratCast]; exact ratCast_mem_of_forall B hcon q
  let φ : ℚ →+* ↥B := (algebraMap ℚ (AlgebraicClosure ℚ)).codRestrict B hmem
  have hφ : (algebraMap ↥B (AlgebraicClosure ℚ)).comp φ = algebraMap ℚ (AlgebraicClosure ℚ) :=
    RingHom.ext fun _ => rfl
  ext x
  refine ⟨fun _ => trivial, fun _ => ?_⟩

  have hint : IsIntegral ↥B x := by
    have hx : IsIntegral ℚ x := ((AlgebraicClosure.isAlgebraic ℚ).isAlgebraic x).isIntegral
    refine ⟨(minpoly ℚ x).map φ, (minpoly.monic hx).map φ, ?_⟩
    rw [Polynomial.eval₂_map, hφ]
    exact minpoly.aeval ℚ x
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥B) (K := AlgebraicClosure ℚ)).mp hint
  rw [← hy]
  exact y.2

end LiesOver

section Transport

theorem henselianLocalRing_of_ringEquiv {A C : Type*} [CommRing A] [CommRing C] [HenselianLocalRing A]
    (e : A ≃+* C) : HenselianLocalRing C := by
  haveI : IsLocalRing C := e.isLocalRing
  refine ⟨fun f hf c₀ hc₀ hunit => ?_⟩

  let g : A[X] := f.map (e.symm : C →+* A)
  have hg : g.Monic := hf.map _
  have hmax : ∀ z : C, z ∈ IsLocalRing.maximalIdeal C ↔ e.symm z ∈ IsLocalRing.maximalIdeal A := fun z => by
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact (map_mem_nonunits_iff e.symm z).symm
  have hga₀ : g.eval (e.symm c₀) ∈ IsLocalRing.maximalIdeal A := by
    have : g.eval (e.symm c₀) = e.symm (f.eval c₀) := by
      rw [Polynomial.eval_map]
      exact Polynomial.eval₂_at_apply (e.symm : C →+* A) c₀
    rw [this]
    exact (hmax _).mp hc₀
  have hgunit : IsUnit (g.derivative.eval (e.symm c₀)) := by
    have : g.derivative.eval (e.symm c₀) = e.symm (f.derivative.eval c₀) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map]
      exact Polynomial.eval₂_at_apply (e.symm : C →+* A) c₀
    rw [this]
    exact hunit.map _
  obtain ⟨a, ha, haa₀⟩ := HenselianLocalRing.is_henselian g hg (e.symm c₀) hga₀ hgunit
  refine ⟨e a, ?_, ?_⟩
  ·
    have h1 : e.symm (f.eval (e a)) = g.eval a := by
      have h2 := Polynomial.eval₂_at_apply (e.symm : C →+* A) (e a) (p := f)
      have h3 : (e.symm : C →+* A) (e a) = a := e.symm_apply_apply a
      rw [h3] at h2
      rw [Polynomial.eval_map, h2]
      rfl
    rw [Polynomial.IsRoot] at ha ⊢
    apply e.symm.injective
    rw [h1, ha, map_zero]
  · rw [hmax, map_sub, e.symm_apply_apply]
    exact haa₀

variable (B : ValuationSubring (AlgebraicClosure ℚ))

def levelEquiv {F : Type*} [Field F] [Algebra F (AlgebraicClosure ℚ)] (K : IntermediateField F (AlgebraicClosure ℚ)) :
    ↥(B.comap (algebraMap ↥K (AlgebraicClosure ℚ))) ≃+* ↥(B.toSubring ⊓ K.toSubring) where
  toFun x := ⟨((x : ↥K) : AlgebraicClosure ℚ), ⟨x.2, (x : ↥K).2⟩⟩
  invFun y := ⟨⟨(y : AlgebraicClosure ℚ), y.2.2⟩, y.2.1⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

@[scoped simp]
theorem levelEquiv_apply_coe {F : Type*} [Field F] [Algebra F (AlgebraicClosure ℚ)]
    (K : IntermediateField F (AlgebraicClosure ℚ)) (x : ↥(B.comap (algebraMap ↥K (AlgebraicClosure ℚ)))) :
    ((levelEquiv B K x : ↥(B.toSubring ⊓ K.toSubring)) : AlgebraicClosure ℚ) = ((x : ↥K) : AlgebraicClosure ℚ) :=
  rfl

end Transport

section HenselianLevel

variable (B : ValuationSubring (AlgebraicClosure ℚ))

abbrev decField : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  IntermediateField.fixedField (B.decompositionSubgroup ℚ)

theorem isDiscreteValuationRing_comap_decField {p : ℕ} (hp : p.Prime) (hBp : B.LiesOverPrime p) :
    IsDiscreteValuationRing ↥(B.comap (algebraMap ↥(decField B) (AlgebraicClosure ℚ))) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : IsDiscreteValuationRing ↥(B.toSubring ⊓ (decField B).toSubring) :=
    (ValuationSubring.isDiscreteValuationRing_inf_fixedField_decompositionSubgroup B p hBp).1
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing (levelEquiv B (decField B)).symm

theorem henselianLocalRing_comap_decField {p : ℕ} (hp : p.Prime) (hBp : B.LiesOverPrime p) :
    HenselianLocalRing ↥(B.comap (algebraMap ↥(decField B) (AlgebraicClosure ℚ))) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : HenselianLocalRing ↥(B.toSubring ⊓ (decField B).toSubring) :=
    (ValuationSubring.henselianLocalRing_and_exists_residue_zmod_inf_fixedField_decompositionSubgroup B p hBp).1
  exact henselianLocalRing_of_ringEquiv (levelEquiv B (decField B)).symm

theorem exists_eq_adjoin_simple (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥K'] :
    ∃ a : AlgebraicClosure ℚ, K' = ℚ⟮a⟯ := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element ℚ ↥K'
  refine ⟨(α : AlgebraicClosure ℚ), ?_⟩
  have h1 := IntermediateField.lift_adjoin_simple ℚ K' α
  have h2 := IntermediateField.lift_top ℚ K'
  erw [hα] at h1
  exact h2.symm.trans h1

theorem exists_henselianLevel (hB : B ≠ ⊤) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥K'] :
    ∃ Z : IntermediateField ℚ (AlgebraicClosure ℚ), K' ≤ Z ∧
      IsDiscreteValuationRing ↥(B.toSubring ⊓ Z.toSubring) ∧ HenselianLocalRing ↥(B.toSubring ⊓ Z.toSubring) ∧
      ∀ x ∈ Z, ∃ K'' : IntermediateField ℚ (AlgebraicClosure ℚ),
        K' ≤ K'' ∧ K'' ≤ Z ∧ FiniteDimensional ℚ ↥K'' ∧ x ∈ K'' := by
  obtain ⟨p, hp, hBp⟩ := exists_prime_liesOverPrime B hB
  obtain ⟨a, ha⟩ := exists_eq_adjoin_simple K'

  have haint : IsIntegral ↥(decField B) a :=
    (((AlgebraicClosure.isAlgebraic ℚ).isAlgebraic a).isIntegral).tower_top
  haveI : FiniteDimensional ↥(decField B) ↥(↥(decField B))⟮a⟯ := IntermediateField.adjoin.finiteDimensional haint
  obtain ⟨hdvr, hhens⟩ :=
    ValuationSubring.isDiscreteValuationRing_and_henselianLocalRing_comap_of_finiteDimensional (F := ℚ)
      (E := AlgebraicClosure ℚ) (AlgebraicClosure.isAlgebraic ℚ) B (decField B)
      (isDiscreteValuationRing_comap_decField B hp hBp)
      (henselianLocalRing_comap_decField B hp hBp) (↥(decField B))⟮a⟯ inferInstance
  refine ⟨((↥(decField B))⟮a⟯).restrictScalars ℚ, ?_, ?_, ?_, ?_⟩
  · rw [ha]
    exact IntermediateField.adjoin_simple_le_iff.mpr (IntermediateField.mem_adjoin_simple_self _ a)
  · haveI := hdvr
    have e : ↥(B.comap (algebraMap ↥(↥(decField B))⟮a⟯ (AlgebraicClosure ℚ))) ≃+*
        ↥(B.toSubring ⊓ (IntermediateField.restrictScalars ℚ (↥(decField B))⟮a⟯).toSubring) :=
      levelEquiv B (↥(decField B))⟮a⟯
    exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e
  · haveI := hhens
    have e : ↥(B.comap (algebraMap ↥(↥(decField B))⟮a⟯ (AlgebraicClosure ℚ))) ≃+*
        ↥(B.toSubring ⊓ (IntermediateField.restrictScalars ℚ (↥(decField B))⟮a⟯).toSubring) :=
      levelEquiv B (↥(decField B))⟮a⟯
    exact henselianLocalRing_of_ringEquiv e
  · intro x hx
    have hxint : IsIntegral ℚ x := ((AlgebraicClosure.isAlgebraic ℚ).isAlgebraic x).isIntegral
    haveI : FiniteDimensional ℚ ↥ℚ⟮x⟯ := IntermediateField.adjoin.finiteDimensional hxint
    refine ⟨K' ⊔ ℚ⟮x⟯, le_sup_left, sup_le ?_ (IntermediateField.adjoin_simple_le_iff.mpr hx),
      IntermediateField.finiteDimensional_sup K' ℚ⟮x⟯, ?_⟩
    · rw [ha]
      exact IntermediateField.adjoin_simple_le_iff.mpr (IntermediateField.mem_adjoin_simple_self _ a)
    · exact (le_sup_right : ℚ⟮x⟯ ≤ K' ⊔ ℚ⟮x⟯) (IntermediateField.mem_adjoin_simple_self ℚ x)

end HenselianLevel

section FiniteLevels

def FiniteLevel (K' Z : IntermediateField ℚ (AlgebraicClosure ℚ)) : Type :=
  {K'' : IntermediateField ℚ (AlgebraicClosure ℚ) // K' ≤ K'' ∧ K'' ≤ Z ∧ FiniteDimensional ℚ ↥K''}

variable (K' Z : IntermediateField ℚ (AlgebraicClosure ℚ))

scoped instance : Preorder (FiniteLevel K' Z) := Subtype.preorder _

abbrev FiniteLevel.field (i : FiniteLevel K' Z) : IntermediateField ℚ (AlgebraicClosure ℚ) := i.1

theorem FiniteLevel.monotone_field : Monotone (FiniteLevel.field K' Z) := fun _ _ h => h

theorem FiniteLevel.field_le (i : FiniteLevel K' Z) : FiniteLevel.field K' Z i ≤ Z := i.2.2.1

theorem FiniteLevel.le_field (i : FiniteLevel K' Z) : K' ≤ FiniteLevel.field K' Z i := i.2.1

