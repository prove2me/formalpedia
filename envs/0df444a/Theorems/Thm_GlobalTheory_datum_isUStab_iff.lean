theorem GlobalTheory.datum_isUStab_iff (h0 : ξ0 ≠ 0) (γ : GL (Fin (D.p + D.q)) E) :
    IsUStab (datumGram D ξ0) (datumLat D) γ ↔
      ∃ g : D.La ≃ₗ[𝓞 E] D.La,
        (∀ x, (γ : Matrix (Fin (D.p + D.q)) (Fin (D.p + D.q)) E) *ᵥ datumEmb D x = datumEmb D (g x)) ∧
        ∀ x y, D.EF (g x) (g y) = D.EF x y := by sorry
