open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry

theorem AlgebraicGeometry.Scheme.IdealSheafData.isInvertible_and_nonempty_invModule_iso_tensorUnit_ofIdealTop_span_singleton
    {X : Scheme.{u}} (r : Γ(X, ⊤))
    (hr : ∀ U : X.affineOpens, X.presheaf.map (homOfLE (le_top : (U : X.Opens) ≤ ⊤)).op r ∈ nonZeroDivisors Γ(X, U)) :
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span {r})).IsInvertible ∧
      Nonempty ((Scheme.IdealSheafData.ofIdealTop (Ideal.span {r})).invModule ≅ 𝟙_ X.Modules) := by sorry
