variable {n : ℕ}

theorem GlobalTheory.CompanionTheory.RgExhHecke.capEntry_apply_shift {V : Type} [AddCommGroup V] [Module ℂ V]
    (E : Fin n → Fin n → Module.End ℂ V) (x : ℂ) (a b : Fin n) (v : V) :
    capEntry E x a b v = capEntry E (x - 1) a b v + if b = a then v else 0 := by sorry
