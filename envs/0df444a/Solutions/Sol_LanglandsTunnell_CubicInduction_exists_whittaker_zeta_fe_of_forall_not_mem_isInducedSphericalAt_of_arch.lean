variable (t : GL (Fin 3) ℚ) {v : HeightOneSpectrum (𝓞 ℚ)}
variable {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} {mA : MeasurableSpace (v.adicCompletion ℚ)}
variable (μ : Measure (v.adicCompletion ℚ)ˣ) (ν : Measure (v.adicCompletion ℚ))

private theorem localZetaDual31_transported
    (hμ : ∀ (u : (v.adicCompletion ℚ)ˣ) (f : (v.adicCompletion ℚ)ˣ → ℂ), ∫ y, f (u * y) ∂μ = ∫ y, f y ∂μ)
    (hν : ∀ c : (v.adicCompletion ℚ)ˣ, TateLocal.modulus (c : v.adicCompletion ℚ) = 1 →
      ∀ f : v.adicCompletion ℚ → ℂ, ∫ x, f ((c : v.adicCompletion ℚ) * x) ∂ν = ∫ x, f x ∂ν)
    {a : ℚ} (ha : a ≠ 0) (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    {α : (v.adicCompletion ℚ)ˣ} (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) a)
    (hmα : TateLocal.modulus (α : v.adicCompletion ℚ) = 1)
    {W : LocalGL3 v → ℂ} {ω : (v.adicCompletion ℚ)ˣ →* ℂˣ}
    (hW : ∀ (z : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v),
      W (Matrix.GeneralLinearGroup.scalar (Fin 3) z * g) = ((ω z : ℂˣ) : ℂ) * W g)
    (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) (s : ℂ) (g : LocalGL3 v) :
    localZetaDual31 v μ ν (transported t W) χ s g =
      ((ω α : ℂˣ) : ℂ) * (((χ α : ℂˣ) : ℂ) ^ 3 * localZetaDual31 v μ ν W χ s (localTorus t v * g)) := by
  have hdual : dualWhittakerFn3 (transported t W) = fun h => dualWhittakerFn3 W (dualTorus t v α * h) :=
    funext (dualWhittakerFn3_transported t v α ha ht hα W)
  have hD := dualTorus_mul_iotaGL_diagUnitGL2_mul_lowerUnipotent21 t v α ht hα
  have hc : TateLocal.modulus ((α⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := modulus_coe_inv_eq_one hmα
  have hD' : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      dualTorus t v α * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x) =
        iotaGL (diagUnitGL2 y) *
          lowerUnipotent21 (((α⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * x) * dualTorus t v α := by
    intro y x
    rw [Units.val_inv_eq_inv_val]
    exact hD y x
  have hpoint : dualTorus t v α * (weylPrime3 * transposeInv3 g) =
      Matrix.GeneralLinearGroup.scalar (Fin 3) α⁻¹ *
        (iotaGL (diagUnitGL2 (α ^ 3)) * (weylPrime3 * transposeInv3 (localTorus t v * g))) := by
    rw [transposeInv3_mul, ← mul_assoc (dualTorus t v α) weylPrime3 (transposeInv3 g),
      dualTorus_mul_weylPrime3 t v α ha ht hα]
    simp only [mul_assoc]
  have hcentral : ∀ X : LocalGL3 v,
      dualWhittakerFn3 W (Matrix.GeneralLinearGroup.scalar (Fin 3) α⁻¹ * X) =
        ((ω α : ℂˣ) : ℂ) * dualWhittakerFn3 W X := by
    intro X
    rw [dualWhittakerFn3_glScalar_mul hW, inv_inv]
  have hb : TateLocal.modulus ((α ^ 3 : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 :=
    modulus_coe_pow_eq_one hmα 3
  have hχ : ((χ⁻¹ (α ^ 3)⁻¹ : ℂˣ) : ℂ) = ((χ α : ℂˣ) : ℂ) ^ 3 := by
    rw [MonoidHom.inv_apply, map_inv, inv_inv, map_pow, Units.val_pow_eq_pow_val]
  calc localZetaDual31 v μ ν (transported t W) χ s g
      = localZeta31 v μ ν (fun h => dualWhittakerFn3 W (dualTorus t v α * h)) χ⁻¹ s
          (weylPrime3 * transposeInv3 g) := by
        rw [localZetaDual31, hdual]
    _ = localZeta31 v μ ν (dualWhittakerFn3 W) χ⁻¹ s (dualTorus t v α * (weylPrime3 * transposeInv3 g)) :=
        localZeta31_comp_mul_left v μ ν hν (dualWhittakerFn3 W) χ⁻¹ s hc hD' _
    _ = ((ω α : ℂˣ) : ℂ) * localZeta31 v μ ν (dualWhittakerFn3 W) χ⁻¹ s
          (iotaGL (diagUnitGL2 (α ^ 3)) * (weylPrime3 * transposeInv3 (localTorus t v * g))) := by
        rw [hpoint]
        exact localZeta31_glScalar_mul v μ ν (dualWhittakerFn3 W) χ⁻¹ s hcentral _
    _ = ((ω α : ℂˣ) : ℂ) * (((χ α : ℂˣ) : ℂ) ^ 3 * localZetaDual31 v μ ν W χ s (localTorus t v * g)) := by
        rw [localZeta31_iotaGL_diagUnitGL2_mul v μ ν hμ hν (dualWhittakerFn3 W) χ⁻¹ s hb, hχ]
        rfl

end
