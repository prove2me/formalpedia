/-! # Complete closeness from a represented paired finite factor -/

namespace KadisonKastler

noncomputable section

universe u

variable {A : Type*} [CStarAlgebra A]
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

local instance pairedAmplificationSourceOrder_rb8e49a_1 : PartialOrder A := CStarAlgebra.spectralOrder _
local instance pairedAmplificationSourceStarOrder_rb8e49a_1 : StarOrderedRing A :=
  CStarAlgebra.spectralOrderedRing _
local instance pairedAmplificationOperatorOrder_rb8e49a_1 : PartialOrder (H →L[ℂ] H) :=
  CStarAlgebra.spectralOrder _
local instance pairedAmplificationOperatorStarOrder_rb8e49a_1 : StarOrderedRing (H →L[ℂ] H) :=
  CStarAlgebra.spectralOrderedRing _
/-- The switch commutator records exactly the difference of the pair. -/
theorem paired_switch_commutator_oai (ρ θ : A →⋆ₐ[ℂ] (H →L[ℂ] H)) (x : A) :
    innerDerivation (blockFlip (A := H →L[ℂ] H) :
      CStarMatrix (Fin 2) (Fin 2) (H →L[ℂ] H)) (pairedRepresentation ρ θ x) =
      offDiagonalLinearMap (ρ x - θ x) := by
  rw [pairedRepresentation_apply, innerDerivation_flip_diagonal]

end

end KadisonKastler

end OAI
