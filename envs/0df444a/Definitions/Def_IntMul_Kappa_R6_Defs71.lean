-- Source module: Solutions.J6SegILPreJC4
/-!
# B5 chunk side (`eC`), part 4: the register-file core

`parP; cPre; cMid; chunkStoreP2 41 42; cA3` from the descriptor on `Z`: the table stream
`tabsT (tabQ2 …) nc` on `41`, its length on `42`, the register values `ρ 0 … ρ 8` on `45`
(`Rn.eCcore`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

section
variable (pkA pkC bA bC kA kC wA wC : ℕ) (Z : Fin HS)

def eCcore : RS :=
  .seq (parP kA kC wA wC Z) (.seq (cPreP pkA pkC bA bC) (.seq (progL cMid)
    (.seq (PreT.chunkStoreP2 sOut sLn) (progL cA3))))

def cCcore (W d NF Q kJ lam R M nc : ℕ) : ℕ :=
  cPar kA kC wA wC W d NF Q kJ + (cCPre pkA pkC bA bC W 0 lam + (costL W 0 cMid +
    (PreT.cCS2 Q R W lam M nc + costL W 0 cA3)))

end

/-- The register values `ρ 0 … ρ 8` of a chunk pass, top first. -/
def cVals (wd f pre nc post : ℕ) : List ℤ :=
  [(wd : ℤ), (wd : ℤ), (f : ℤ), ((pre * nc : ℕ) : ℤ), (post : ℤ), (pre : ℤ), (nc : ℤ),
    ((2 * 2 ^ f : ℕ) : ℤ), ((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ)]

end J6Seg.PJ

end

