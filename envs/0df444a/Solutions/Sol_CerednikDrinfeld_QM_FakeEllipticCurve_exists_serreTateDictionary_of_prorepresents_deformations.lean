theorem pt_ext {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g)
    {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of (ResidueField O))} (P₁ P₂ : SchemeHomOver t u₀.1.f)
    (h : P₁.1 ≫ g = P₂.1 ≫ g) : P₁ = P₂ := by
  obtain ⟨hsq, -⟩ := hg
  exact Subtype.ext (hsq.hom_ext h (by rw [P₁.2, P₂.2]))

