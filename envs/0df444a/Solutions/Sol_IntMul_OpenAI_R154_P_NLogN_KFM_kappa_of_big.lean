variable {S L : ℕ}

theorem Tapes.ext' {Γ' : Type} {k : ℕ} {T T' : Tapes Γ' k} (h1 : T.cells = T'.cells)
    (h2 : T.head = T'.head) : T = T' := by
  cases T; cases T'; simp_all

theorem fin_cases3 (l : Fin (S + 3)) :
    l = tin ∨ l = tout ∨ l = tctl ∨ ∃ i : Fin S, l = tst i := by
  rcases l with ⟨v, hv⟩
  rcases (show v = 0 ∨ v = 1 ∨ v = 2 ∨ 3 ≤ v by omega) with h | h | h | h
  · left; ext; simp [tin, h]
  · right; left; ext; simp [tout, h]
  · right; right; left; ext; simp [tctl, h]
  · right; right; right; exact ⟨⟨v - 3, by omega⟩, by ext; simp [tst]; omega⟩

theorem tst_inj {i j : Fin S} (h : tst i = tst j) : i = j := by
  simp [tst, Fin.ext_iff] at h; exact Fin.ext h

@[simp] theorem enc_cells_tin (inp : ℕ → Γ L) (c : NLogN.Cfg S) : (NLogN.enc inp c).cells tin = inp := by
  simp [NLogN.enc, tin]
@[simp] theorem enc_head_tin (inp : ℕ → Γ L) (c : NLogN.Cfg S) : (NLogN.enc inp c).head tin = c.σ.ip := by
  simp [NLogN.enc, tin]
@[simp] theorem enc_cells_tout (inp : ℕ → Γ L) (c : NLogN.Cfg S) :
    (NLogN.enc inp c).cells tout = tapeOf (syms L) (c.σ.out.map (bitSym (syms L))) := by
  simp [NLogN.enc, tout]
@[simp] theorem enc_head_tout (inp : ℕ → Γ L) (c : NLogN.Cfg S) :
    (NLogN.enc inp c).head tout = c.σ.out.length := by
  simp [NLogN.enc, tout]
@[simp] theorem enc_cells_tctl (inp : ℕ → Γ L) (c : NLogN.Cfg S) :
    (NLogN.enc inp c).cells tctl = tapeOf (syms L) (c.ctl.map retSym).reverse := by
  simp [NLogN.enc, tctl]
@[simp] theorem enc_head_tctl (inp : ℕ → Γ L) (c : NLogN.Cfg S) :
