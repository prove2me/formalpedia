    exact ⟨⟨hall.toEvalsTo,hbound⟩⟩

/-- Polynomial bounded iteration in the full original platform stock TM2
model, with no internal alphabet restriction or additional step uniformity premise. -/
theorem loop_polynomial {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    {f : α → β ⊕ α} (callee : TM2ComputableInPolyTime ea (OAI.MetricKMedian.Binary.encodeLoop ea eb) f)
    (result : α → β) (iterations sizes : Polynomial ℕ)
    (h : ∀ input,∃ rounds ≤ iterations.eval (ea input).length,
      OAI.MetricKMedian.Binary.BoundedRun ea f (sizes.eval (ea input).length) rounds input (result input)) :
    Nonempty (TM2ComputableInPolyTime ea eb result) := by
  classical
  let wrapper := _root_.Integration9_9.TM2StockLoop.loopMachine callee.tm callee.inputAlphabet callee.outputAlphabet
  let cost : Polynomial ℕ := 2*Polynomial.X+2+
    iterations*(callee.time.comp sizes+2*(_root_.Integration9_9.TM2StockLoop.sizeBound callee).comp sizes+3)
  have hout (input : α) : Nonempty (TM2OutputsInTime wrapper (ea input) (some (eb (result input)))
      (cost.eval (ea input).length)) := by
    obtain ⟨rounds,hr,hbounded⟩ := h input
    obtain ⟨hloop⟩ := _root_.Integration9_9.TM2StockLoop.run_bounded callee hbounded
    have hi := _root_.Integration9_9.TM2StockLoop.initial_run callee.tm callee.inputAlphabet callee.outputAlphabet (ea input)
    have hall := EvalsToInTime.trans _ _ _ _ _ _ hi hloop
    have hm := Nat.mul_le_mul_right (_root_.Integration9_9.TM2StockLoop.passTime callee (sizes.eval (ea input).length)) hr
    have he : cost.eval (ea input).length=2*(ea input).length+2+
        iterations.eval (ea input).length*_root_.Integration9_9.TM2StockLoop.passTime callee (sizes.eval (ea input).length) := by
      simp only [cost,Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_X,Polynomial.eval_ofNat,
        Polynomial.eval_comp,_root_.Integration9_9.TM2StockLoop.passTime]
    have hb : hall.steps ≤ cost.eval (ea input).length := by
      rw [he]
      have hh := hall.steps_le_m
      omega
    change Nonempty (EvalsToInTime (TM2.step (_root_.Integration9_9.TM2StockLoop.program callee.tm callee.inputAlphabet callee.outputAlphabet))
      (initList wrapper (ea input)) (some (haltList wrapper (eb (result input)))) _)
    rw [_root_.Integration9_9.TM2StockLoop.initial_caller_eq,←_root_.Integration9_9.TM2StockLoop.terminal_caller_eq]
    exact ⟨⟨hall.toEvalsTo,hb⟩⟩
  refine ⟨{
    tm := wrapper
    inputAlphabet := Equiv.refl Bool
    outputAlphabet := Equiv.refl Bool
    time := cost
    outputsFun := ?_ }⟩
  intro input
  have run := Classical.choice (hout input)
  simpa only [Equiv.refl,List.map_id] using run

end Integration9_9.TM2StockLoop

