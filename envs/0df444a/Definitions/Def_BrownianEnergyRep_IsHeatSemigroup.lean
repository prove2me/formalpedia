-- title:
--   The heat semigroup $e^{t\Delta/2}$ on $L^2(G,dx)$
-- statement:
--   The operator $\Delta/2$ is essentially self-adjoint on smooth functions, and its closure generates a strongly continuous self-adjoint contraction semigroup $e^{t\Delta/2}$ on $L^2(G,dx)$. This predicate says that $S_t$, $t\ge0$, is that semigroup.
--
--   **Formalization Note** The predicate asks for a strongly continuous symmetric contraction semigroup with $\lim_{t\downarrow0}t^{-1}(S_tf-f)=\tfrac12\Delta f$ in $L^2$ for smooth $f$. Its generator is then a self-adjoint extension of $\Delta/2$ on $C^\infty(G)$, and essential self-adjointness makes it the closure.
-- source:
--   Albeverio, Driver, Gordina, Vershik, Equivalence of the Brownian and energy representations, arXiv:1511.07378v1, §2.1, p.2

import Mathlib
import Definitions.Def_BrownianEnergyRep_MatrixLieAlgebra
import Definitions.Def_BrownianEnergyRep_MatrixLieAlgebra_laplacian
import Definitions.Def_BrownianEnergyRep_IsSmoothOnGroup

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology ContDiff RealInnerProductSpace

namespace BrownianEnergyRep

/-- `S` is the semigroup `e^{tΔ/2}` on `L²(G, dx)` generated by the closure of the essentially
self-adjoint operator `Δ/2` on smooth functions (arXiv:1511.07378v1, §2.1, p.2).

**Formalization Note** A strongly continuous symmetric contraction semigroup whose generator
extends `Δ/2` on `C^∞(G)` has a self-adjoint generator, which then equals the closure of `Δ/2`,
because `Δ/2` is essentially self-adjoint. Only `t ≥ 0` is constrained. -/
structure IsHeatSemigroup {n : ℕ} {G : Subgroup (GL (Fin n) ℝ)} {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (L : MatrixLieAlgebra G E) (m : Measure ↥G)
    (S : ℝ → Lp ℝ 2 m →L[ℝ] Lp ℝ 2 m) : Prop where
  zero : S 0 = ContinuousLinearMap.id ℝ _
  add : ∀ s ≥ 0, ∀ t ≥ 0, S (s + t) = (S s).comp (S t)
  strongly_continuous : ∀ f, Tendsto (fun t => S t f) (𝓝[>] 0) (𝓝 f)
  contraction : ∀ t ≥ 0, ‖S t‖ ≤ 1
  symmetric : ∀ t ≥ 0, ∀ f g, ⟪S t f, g⟫ = ⟪f, S t g⟫
  generator : ∀ f : ↥G → ℝ, IsSmoothOnGroup f → ∀ (hf : MemLp f 2 m)
    (hΔ : MemLp (fun x => (1 / 2) * L.laplacian f x) 2 m),
    Tendsto (fun t : ℝ => t⁻¹ • (S t (hf.toLp f) - hf.toLp f)) (𝓝[>] 0)
      (𝓝 (hΔ.toLp (fun x => (1 / 2) * L.laplacian f x)))

end BrownianEnergyRep


