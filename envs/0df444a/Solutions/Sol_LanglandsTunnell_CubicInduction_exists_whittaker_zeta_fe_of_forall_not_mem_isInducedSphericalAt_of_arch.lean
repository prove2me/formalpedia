private theorem tPart_dual_of
    (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    {ψloc : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ}
    (hWψ : ∀ v ∉ T, IsGL3PsiWhittakerFn (ψloc v) (dualWhittakerFn3 (Wloc v)))
    (hWK : ∀ v ∉ T, IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (hW1 : ∀ v ∉ T, dualWhittakerFn3 (Wloc v) 1 = 1)
    (hψloc : ∀ v ∉ T, ∀ y₀ ∉ v.adicCompletionIntegers ℚ,
      ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψloc v y ≠ 1)
    (hgT : ∀ w ∉ T, componentAt3 (𝓞 ℚ) ℚ w g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ w)
    (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hE : ∀ u : (InfiniteAdeleRing ℚ)ˣ,
    M4aHerbrand.infPart (E u) = u ∧ RatIdele.finPart (E u) = 1)
    (a : ℚ) (hapm : a = 1 ∨ a = -1)
    [mA : MeasurableSpace (InfiniteAdeleRing ℚ)] [BorelSpace (InfiniteAdeleRing ℚ)]
    [mT : MeasurableSpace (InfiniteAdeleRing ℚ)ˣ] [BorelSpace (InfiniteAdeleRing ℚ)ˣ]
    (ν_add : MeasureTheory.Measure (InfiniteAdeleRing ℚ))
    (hν_add : ν_add = ENNReal.ofReal (|(a : ℝ)| ^ ((1 : ℝ) / 2)) •
    MeasureTheory.Measure.map (InfiniteAdeleRing.ringEquiv_mixedSpace ℚ).symm MeasureTheory.volume)
    (ν_mul : MeasureTheory.Measure (InfiniteAdeleRing ℚ)ˣ) [ν_mul.IsHaarMeasure]
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (r : ℝ) (hr : 0 < r) (r₀ : NNReal) (hrdef : r = (r₀ : ℝ))
    (hsPart :
      (letI := fun v : HeightOneSpectrum (𝓞 ℚ) =>
        (letI := localBorel ℚ v; (inferInstance : MeasurableSpace (v.adicCompletion ℚ)ˣ))
      NumberField.Idele.sPartMeasure ℚ T = r₀ • Measure.map (TPart.embHom T) (TPart.torusMeasure T
        (fun v => letI := localBorel ℚ v; Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) ν_mul))) :
    ∀ s : ℂ,
      (hcl : ∀ v ∈ T, (letI := localBorel ℚ v;
        Integrable (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
        dualWhittakerFn3 (Wloc v) (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 *
            (weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g))) *
          (((localChar χ v)⁻¹ p.1 : ℂˣ) : ℂ) * ((TateLocal.modulus (p.1 : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (1 - s - 1))
        ((Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))).prod (selfDualHaarAt ℚ v)))) →
      (hca : Integrable (fun p : (InfiniteAdeleRing ℚ)ˣ × InfiniteAdeleRing ℚ =>
        dualWhittakerFn3 (fun h => Warch (h * archComponent3 (𝓞 ℚ) ℚ g))
            (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * (weylPrime3 * transposeInv3 1)) *
          (((χ.comp E)⁻¹ p.1 : ℂˣ) : ℂ) * ((‖(p.1 : InfiniteAdeleRing ℚ)‖ : ℝ) : ℂ)
              ^ (1 - s - 1)) (ν_mul.prod ν_add)) →
      Integrable (fun a : (AdeleRing (𝓞 ℚ) ℚ)ˣ =>
          (((NumberField.AdelicHaar.adelicAddHaar (𝓞 ℚ) ℚ (AdelicBox.adelicBox ℚ)).toReal : ℂ)⁻¹ *
              ∫ x : AdeleRing (𝓞 ℚ) ℚ, LineIntegral.xLine Warch Wloc a g x
                ∂(NumberField.AdelicHaar.adelicAddHaar (𝓞 ℚ) ℚ)) *
            ((χ⁻¹ a : ℂˣ) : ℂ) * ((ideleNorm ℚ a : ℝ) : ℂ) ^ (1 - s - 1))
        (Idele.sPartMeasure ℚ T) ∧
      ∫ a : (AdeleRing (𝓞 ℚ) ℚ)ˣ,
          (((NumberField.AdelicHaar.adelicAddHaar (𝓞 ℚ) ℚ (AdelicBox.adelicBox ℚ)).toReal : ℂ)⁻¹ *
              ∫ x : AdeleRing (𝓞 ℚ) ℚ, LineIntegral.xLine Warch Wloc a g x
                ∂(NumberField.AdelicHaar.adelicAddHaar (𝓞 ℚ) ℚ)) *
            ((χ⁻¹ a : ℂˣ) : ℂ) * ((ideleNorm ℚ a : ℝ) : ℂ) ^ (1 - s - 1) ∂(Idele.sPartMeasure ℚ T) =
          ((r : ℂ) * archZetaDual31 ν_mul ν_add (fun h => Warch (h * archComponent3 (𝓞 ℚ) ℚ g))
            (χ.comp E) (1 - s) 1) *
            ∏ v ∈ T,
              (letI := localBorel ℚ v;
                localZetaDual31 v (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) (selfDualHaarAt ℚ v)
                (Wloc v) (localChar χ v) (1 - s) (componentAt3 (𝓞 ℚ) ℚ v g)) := by
  intro s hcl hca
  have hr₀ : r₀ ≠ 0 := fun h => hr.ne' (by rw [hrdef, h, NNReal.coe_zero])
  haveI : (r₀ • ν_mul).IsHaarMeasure := MeasureTheory.Measure.IsHaarMeasure.nnreal_smul ν_mul hr₀
  have hνs :=
    letI := fun v : HeightOneSpectrum (𝓞 ℚ) =>
      (letI := localBorel ℚ v; (inferInstance : MeasurableSpace (v.adicCompletion ℚ)ˣ))
    TPart.sPartMeasure_eq_map_torusMeasure_nnreal_smul T
      (fun v => letI := localBorel ℚ v; Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) ν_mul hsPart
  haveI : SFinite ν_add := by rw [hν_add]; infer_instance
  have hprod : (r₀ • ν_mul).prod ν_add = r₀ • ν_mul.prod ν_add := by
    rw [← Measure.coe_nnreal_smul, Measure.prod_smul_left, Measure.coe_nnreal_smul]
  refine ⟨?_, ?_⟩
  · exact DualPassage.integrable_sPart_of_integrable_arch_and_local T Warch Wloc g hWψ hWK hW1 hψloc hgT E hE
      a hapm ν_add hν_add (r₀ • ν_mul) hνs χ (1 - s) hcl (by rw [hprod]; exact hca.smul_measure_nnreal)
  · have hB := DualPassage.integral_sPart_eq_mul_archZetaDual31_mul_prod_localZetaDual31 T Warch Wloc g hWψ hWK
      hW1 hψloc hgT E hE a hapm ν_add hν_add (r₀ • ν_mul) hνs χ (1 - s)
    rw [ArchZetaSmul.archZetaDual31_nnreal_smul] at hB
    rw [hrdef]
    exact hB

private theorem rootNumberAbsorption_of
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hμc : Continuous μ) (hμu : IsUnitaryChar (𝓞 K) K μ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v)
    (v₀ : HeightOneSpectrum (𝓞 ℚ)) (hv₀ : v₀ ∈ S)
    (ν : (v : HeightOneSpectrum (𝓞 ℚ)) → Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ))
    (aex : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ)
    (hcond : ∀ v ∈ S, ∀ i, 1 ≤ aex v i ∧ LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (ν v i) (aex v i))
    (hsum : ∀ v ∈ S, (∑ i, (aex v i : ℤ)) =
      ∑ᶠ w ∈ primeFibre ℚ K v, (v.asIdeal.inertiaDeg' w.asIdeal : ℤ) * LanglandsTunnell.Converse.pinnedExp K μ w)
    (hunit : ∀ v ∈ S, ∀ i, ‖((ν v i (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ)‖ = 1)
    (θS Θ : HeightOneSpectrum (𝓞 ℚ) → ℂ)
    (hθ : ∀ v ∈ S, (∏ i, LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (ν v i)) = θS v)
    (hΘ_eq : ∀ v, Θ v = ∏ᶠ 𝔓 ∈ primeFibre ℚ K v, LanglandsTunnell.TateLocal.stdRootNumberAt K 𝔓 (localChar μ 𝔓))
    (hθSv₀ : θS v₀ = (∏ w : InfinitePlace K, lambdaArch K w)⁻¹ * Θ v₀)
    (hθS_of_ne : ∀ v, v ≠ v₀ → θS v = Θ v)
    (hlam : ‖(∏ w : InfinitePlace K, lambdaArch K w)⁻¹‖ = 1) :
    (∏ v ∈ S, ∏ i, LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (ν v i * localChar χ v))
        * (∏ w : InfinitePlace K, lambdaArch K w)
      = ∏ v ∈ S, ∏ᶠ 𝔓 ∈ primeFibre ℚ K v,
          LanglandsTunnell.TateLocal.stdRootNumberAt K 𝔓
            (localChar (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓) := by
  classical

  obtain rfl := LanglandsTunnell.CubicInduction.RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›

  have hχ0 : ∀ v ∈ S, LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (localChar χ v) 0 := fun v hv =>
    LanglandsTunnell.CubicInduction.NormUnramified.hasConductorExponentAt_zero_of_isUnramifiedCharAt (hχS v hv)
  have hχu' : ∀ v : HeightOneSpectrum (𝓞 ℚ), ‖(localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂ)‖ = 1 :=
    fun v => LanglandsTunnell.CubicInduction.TwistFibre.norm_localChar_apply_eq_one hχu v _

  have hexp : ∀ 𝔓 : HeightOneSpectrum (𝓞 K), LanglandsTunnell.TateLocal.HasConductorExponentAt K 𝔓 (localChar μ 𝔓)
      (LanglandsTunnell.TateLocal.conductorExponentAt K 𝔓 (localChar μ 𝔓)) := fun 𝔓 => by
    obtain ⟨c, hc⟩ := LanglandsTunnell.TateLocal.exists_hasConductorExponentAt_of_continuous K 𝔓 (localChar μ 𝔓)
      (NumberField.TateGlobal.continuous_localChar μ hμc 𝔓)
    rw [LanglandsTunnell.TateLocal.conductorExponentAt_eq_of_hasConductorExponentAt K 𝔓 hc]
    exact hc
  have hμu' : ∀ 𝔓 : HeightOneSpectrum (𝓞 K), ‖(localChar μ 𝔓 (NumberField.AdelicLevel.uniformizerUnit K 𝔓) : ℂ)‖ = 1 :=
    fun 𝔓 => LanglandsTunnell.CubicInduction.TwistFibre.norm_localChar_apply_eq_one hμu 𝔓 _

  have hL : ∀ v ∈ S, (∏ i, LanglandsTunnell.TateLocal.stdRootNumberAt ℚ v (ν v i * localChar χ v))
      = (localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂ) ^ (∑ i, (aex v i : ℤ)) * θS v :=
      fun v hv => by
    rw [LanglandsTunnell.CubicInduction.TwistFibreS.prod_stdRootNumberAt_mul_of_hasConductorExponentAt_zero v (ν v)
      (aex v) (fun i => (hcond v hv i).2) (hunit v hv) (localChar χ v) (hχ0 v hv) (hχu' v), hθ v hv]
  have hR : ∀ v ∈ S, (∏ᶠ 𝔓 ∈ primeFibre ℚ K v, LanglandsTunnell.TateLocal.stdRootNumberAt K 𝔓
        (localChar (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓))
      = (localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂ) ^ (∑ i, (aex v i : ℤ)) * Θ v :=
      fun v hv => by
    rw [LanglandsTunnell.CubicInduction.TwistFibreS.finprod_primeFibre_stdRootNumberAt_localChar_mul_comp_idelicNorm
      K μ v χ (hχS v hv) (hχu' v) (fun 𝔓 _ => hexp 𝔓) (fun 𝔓 _ => hμu' 𝔓)
      (fun w => LanglandsTunnell.TateLocal.hasConductorExponentAt_comp_norm_zero ℚ K v w (localChar χ v) (hχ0 v hv)),
      ← hsum v hv, hΘ_eq v]

  have hne : (∏ w : InfinitePlace K, lambdaArch K w) ≠ 0 := by
    intro h
    rw [h, inv_zero, norm_zero] at hlam
    exact zero_ne_one hlam
  have hoff : (∏ v ∈ S.erase v₀,
        (localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂ) ^ (∑ i, (aex v i : ℤ)) * θS v)
      = ∏ v ∈ S.erase v₀,
        (localChar χ v (NumberField.AdelicLevel.uniformizerUnit ℚ v) : ℂ) ^ (∑ i, (aex v i : ℤ)) * Θ v :=
    Finset.prod_congr rfl fun v hv => by rw [hθS_of_ne v (Finset.ne_of_mem_erase hv)]

  rw [Finset.prod_congr rfl hL, Finset.prod_congr rfl hR, ← Finset.mul_prod_erase S _ hv₀,
    ← Finset.mul_prod_erase S _ hv₀, hoff, hθSv₀]
  have hcancel : ∀ c P : ℂ,
      c * ((∏ w : InfinitePlace K, lambdaArch K w)⁻¹ * Θ v₀) * P * (∏ w : InfinitePlace K, lambdaArch K w)
        = c * Θ v₀ * P * ((∏ w : InfinitePlace K, lambdaArch K w)⁻¹ * ∏ w : InfinitePlace K, lambdaArch K w) :=
    fun c P => by ring
  rw [hcancel, inv_mul_cancel₀ hne, mul_one]

private theorem dualPassage_of
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
