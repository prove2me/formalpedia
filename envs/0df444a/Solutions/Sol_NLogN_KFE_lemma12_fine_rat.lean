theorem solution (Qc : AModelRat.QCircuit (ZMod 2) m W) (hm : 2 ≤ m)
    (gatesOK : ∀ g ∈ Qc.gates, g.OK)
    (route : ∀ (v : Fin W → ZMod 2) w, AModel.scalarRun Qc.gates v (Qc.ρ w) = v w)
    (unit : ∀ w, Qc.Mout (Qc.ρ w) - Qc.Min w = 1) {τ : ℝ} (hτ : 0 < τ ∧ τ < 1)
    (hs : ((AModel.frameSum (fun A : AModelFac.QMat m => A.rank) Qc.gates Qc.Min Qc.Mout : ℕ) : ℝ) / W <
      (m : ℝ) ^ τ) :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : AModel.Shape) (Bb : ℕ), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      NLogN.zsz ((T * (q ^ 2 * AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) + 1) ^ 2 : ℕ) : ℤ) ≤ Bb → 1 ≤ Bb →
      ∀ (I : List NLogN.Sym) (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (xs : List (ZMod 2))
        (LP LG LS LU : List ℤ),
      F NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: LP → F NLogN.KIL.kG = (AModel.vol G : ℤ) :: LG → F NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: LS →
      F NLogN.KIL.aU = (u : ℤ) :: LU → F 0 = NLogN.KIL.enc2 xs →
      F 8 = [] → F 9 = [] → F 10 = [] → F 11 = [] → F 15 = [] → F 20 = [] → F 21 = [] →
      F 23 = [] → F 24 = [] →
      xs.length = AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) →
      ∃ c : ℕ, NLogN.IRuns I (NLogN.KFD.progF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc)) (NLogN.KFE.l12F q m W) (NLogN.KIL.encK s F)
        (NLogN.KIL.encK s (Function.update F 0 (NLogN.KIL.enc2 (AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u))
          (AModelL12.binShape Pre G Suf (2 ^ u)) (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs))))
        c ∧
        (c : ℝ) ≤ K * (((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ +
          ((u : ℝ) + 1) ^ (Nat.clog m (AModel.frameSum (fun A : AModelFac.QMat m => A.rank) Qc.gates Qc.Min Qc.Mout + 1)
            + 1) * ((Bb : ℝ) + 2) ^ 2) := by
  classical
  set S := (AModelFac.frameMS Qc.gates Qc.Min Qc.Mout).toFinset with hS
  set T := 8 + m + W + ∑ A ∈ S, NLogN.KIL.tokBnd A with hT
  obtain ⟨q₁, hq₁⟩ := AModelRat.prop11_ratLabels Qc hm gatesOK route unit hτ hs
  refine ⟨T, max q₁ (Qc.den + ∑ A ∈ S, (AModelRat.facBoundQ A + NLogN.KIL.tokBnd A)), fun q hq hlt => ?_⟩
  have hq1 : q₁ < q := lt_of_le_of_lt (le_max_left _ _) hlt
  have hq2 : Qc.den + ∑ A ∈ S, (AModelRat.facBoundQ A + NLogN.KIL.tokBnd A) < q :=
    lt_of_le_of_lt (le_max_right _ _) hlt
  obtain ⟨hcorr, -⟩ := hq₁ q hq hq1
  have hsS : ((NLogN.KIL.SWn (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) : ℕ) : ℝ) / W < (m : ℝ) ^ τ := by
    rw [NLogN.KIL.SWn_toCircuit_eq]; exact hs
  obtain ⟨K, hK, hKb⟩ := NLogN.KFE.cL12F_le (S := NLogN.KIL.SWn (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc))
    (NLogN.KFD.KlevF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 5) (NLogN.KFD.KbF (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 10 ^ 9 + 100)
    (NLogN.KIL.Kd m) q hm NeZero.one_le hq.two_le hτ hsS
  have hcE : Nat.clog m (NLogN.KIL.SWn (Qc.toCircuit 1) (NLogN.KIL.edgeTplQ Qc) + 1) =
      Nat.clog m (AModel.frameSum (fun A : AModelFac.QMat m => A.rank) Qc.gates Qc.Min Qc.Mout + 1) := by
    rw [NLogN.KIL.SWn_toCircuit_eq]
  simp only [hcE] at hKb
  refine ⟨K, hK, ?_⟩
  intro u Pre G Suf Bb hu hPre hG hSf hBb hB1 I s F xs LP LG LS LU FP FG FS FU F0 F8 F9 F10 F11
    F15 F20 F21 F23 F24 hxs
  set e := Nat.clog q (2 ^ u) with he
  set Kp := Nat.clog m e with hKp
  set Vb := AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) with hVb
  set Vq := AModel.vol (AModelL12.qShape Pre G Suf q e) with hVqd
  have hVq : Vq ≤ q ^ 2 * Vb := NLogN.KIL.vq_le_vb hq.two_le hu Pre G Suf
  have hqe : q ^ e ≤ Vq := by
    rw [hVqd, ← AModelL12.vol_binShape_q, NLogN.KIL.vol_binShape]
    have h1 := NLogN.KIL.one_le_vol hPre; have h2 := NLogN.KIL.one_le_vol hG; have h3 := NLogN.KIL.one_le_vol hSf
    have h4 : 1 ≤ q ^ e := Nat.one_le_pow _ _ hq.pos
    calc q ^ e = q ^ e * 1 := by ring
      _ ≤ q ^ e * (AModel.vol G * (q ^ e * AModel.vol Suf)) :=
        Nat.mul_le_mul_left _ (Nat.mul_pos h2 (Nat.mul_pos h4 h3))
      _ ≤ AModel.vol Pre * (q ^ e * (AModel.vol G * (q ^ e * AModel.vol Suf))) := Nat.le_mul_of_pos_left _ h1
  have he1 : e < q ^ e := Nat.lt_pow_self hq.one_lt
  have hBnd : ∀ N : ℕ, N ≤ T * (Vq + 1) ^ 2 → NLogN.zsz (N : ℤ) ≤ Bb := fun N hN =>
    le_trans (NLogN.KIL.zsz_nat_le (hN.trans (Nat.mul_le_mul_left _
      (Nat.pow_le_pow_left (by omega) 2)))) hBb
  have hjq : ∀ j < Kp, q ^ m ^ j ≤ Vq := fun j hj =>
    (Nat.pow_le_pow_right hq.pos (Nat.pow_lt_of_lt_clog hj).le).trans hqe
  have hsq : ∀ j < Kp, (q ^ m ^ j + 1) ^ 2 ≤ (Vq + 1) ^ 2 := fun j hj =>
    Nat.pow_le_pow_left (by have := hjq j hj; omega) 2
  have hspec : AModelL12.OracleSpec (AModel.prog (Qc.toCircuit (q ^ m ^ Kp)) q) 0 W m q Kp :=
    fun j hj P L A B Cs ys hL hys => hcorr Kp j hj P L A B Cs ys hL hys
  have hfr : ∀ j < Kp, AModel.FramesOK (fun X => AModelRat.GoodAtQ q ((Qc.den : ℚ)⁻¹ • AModelFac.ratM X) ∧
      ∀ T, NLogN.KIL.TStep.sh T ∈ NLogN.KIL.edgeTplQ Qc X → NLogN.KIL.TOK T (q ^ m ^ j) Bb)
      (Qc.toCircuit (q ^ m ^ Kp)).gates (Qc.toCircuit (q ^ m ^ Kp)).Min
      (Qc.toCircuit (q ^ m ^ Kp)).Mout := by
    intro j hj
    refine NLogN.KIL.framesOK_toCircuit Qc _ (fun X hX => ?_) _
    set A := (Qc.den : ℚ)⁻¹ • AModelFac.ratM X with hAdef
    have hX' : A ∈ S := hX
    have hA : AModelRat.facBoundQ A + NLogN.KIL.tokBnd A ≤ ∑ A ∈ S, (AModelRat.facBoundQ A + NLogN.KIL.tokBnd A) :=
      Finset.single_le_sum (f := fun A => AModelRat.facBoundQ A + NLogN.KIL.tokBnd A) (fun _ _ => Nat.zero_le _) hX'
    have hA' : NLogN.KIL.tokBnd A ≤ ∑ A ∈ S, NLogN.KIL.tokBnd A :=
      Finset.single_le_sum (f := NLogN.KIL.tokBnd) (fun _ _ => Nat.zero_le _) hX'
    have hg := AModelRat.goodAtQ_of_lt _ hq (show AModelRat.facBoundQ A < q by omega)
    refine ⟨hg, NLogN.KIL.tok_edgeTpl Qc X hq (Nat.one_le_pow _ _ (by omega)) hg (show NLogN.KIL.tokBnd A < q by omega) (hBnd _ ?_)⟩
    exact Nat.mul_le_mul (show NLogN.KIL.tokBnd A ≤ T by omega) (hsq j hj)
  have hsb : ∀ j < Kp, NLogN.KIL.SubBnd (q ^ m ^ j) Bb := fun j hj =>
    NLogN.KIL.subBnd_of (hBnd _ (Nat.mul_le_mul (by omega) (hsq j hj)))
  have hBb' : NLogN.zsz (((2 * Vq + m + W * e : ℕ)) : ℤ) ≤ Bb := by
    apply hBnd
    have h1 : Vq + 1 ≤ (Vq + 1) ^ 2 := by nlinarith
    have h2 : (8 + m + W) * (Vq + 1) ≤ T * (Vq + 1) ^ 2 :=
      Nat.mul_le_mul (by omega) h1
    have h3 : W * e ≤ W * Vq := Nat.mul_le_mul_left _ (by omega)
    nlinarith
  have H := NLogN.KFE.l12F_rat_correct Qc hm q hq Bb u Pre G Suf hu hPre hG hSf e Kp he hKp hspec hfr hsb
    hBb' hB1 I s F xs LP LG LS LU FP FG FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs
  exact ⟨_, H, hKb u Pre G Suf Bb e Kp hu hPre hG hSf he hKp⟩
end
