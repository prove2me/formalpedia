theorem CuspForm.heckeLocal.residue_pi (N : ℕ) [NeZero N] (S : Set ℕ) (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪] [IsAdicComplete (IsLocalRing.maximalIdeal 𝒪) 𝒪] (θ : ↥(CuspForm.heckeAlgebra N 2 S) →+* IsLocalRing.ResidueField 𝒪) [Fact (CuspForm.HasIntegralStructure N 2)] (t : ↥(CuspForm.heckeAlgebra N 2 S)) : IsLocalRing.residue (CuspForm.heckeLocal N S 𝒪 θ) (CuspForm.heckeLocal.π N S 𝒪 θ t) = IsLocalRing.ResidueField.map (algebraMap 𝒪 (CuspForm.heckeLocal N S 𝒪 θ)) (θ t) := by sorry
