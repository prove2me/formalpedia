    have hlt := encode_lt hT
    rw [List.getD_eq_getElem _ _ (by simpa using hlt)]
    simp only [List.getElem_map, List.getElem_range, decode_encode hT]
  · rw [if_neg hT, if_neg (fun h => hT (h1.valid h))]

