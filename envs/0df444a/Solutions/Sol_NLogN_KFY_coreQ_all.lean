    simp [hsc, hsb, hsa, rn'2, rn'3, (notW rn'1).1, (notW rn'1).2.2.2.2.2.2.1, tn']
  obtain ⟨d1, d2, d3⟩ := mvG_fwd M ax.sl.O gZB ax.rn' sc (ax.f x) (sb.G ax.sl.O) Ln' Q ax.n'
    hO.2.2.2.2.2.1 hO.2.2.2.2.2.2.2.2.1 (by decide) ax.sl.hO (by decide) (by omega) scO hfx.1 scn
