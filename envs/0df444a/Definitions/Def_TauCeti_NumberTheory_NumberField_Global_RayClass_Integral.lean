open IsDedekindDomain IsDedekindDomain.HeightOneSpectrum NumberField
open scoped nonZeroDivisors NumberField

namespace TauCeti.GlobalNumberFields

variable {K : Type*} [Field K] [NumberField K]

/-! ### Generators congruent to one modulo a modulus -/

/-- **An algebraic integer in `1 + 𝔪₀` is congruent to one modulo `𝔪`.**  Membership of `a - 1` in
the finite part gives the valuation bound at *every* finite place, since the prime power prescribed
by the exponent divides the finite part (`Modulus.pow_exponent_dvd_finitePart`); the real
conditions are carried over unchanged. -/
theorem isCongrOne_of_sub_one_mem {𝔪 : Modulus K} {x : Kˣ} {a : 𝓞 K} (hxa : (x : K) = a)
    (hmem : a - 1 ∈ 𝔪.finitePart)
    (hpos : ∀ w ∈ 𝔪.infinitePart, 0 < InfinitePlace.embedding_of_isReal w.2 (x : K)) :
    IsCongrOne 𝔪 x := by
  refine isCongrOne_iff.mpr ⟨fun v _ ↦ ?_, hpos⟩
  have hsub : (x : K) - 1 = algebraMap (𝓞 K) K (a - 1) := by rw [map_sub, map_one, hxa]
  rw [hsub, valuation_of_algebraMap, intValuation_le_pow_iff_mem]
  exact Ideal.le_of_dvd (Modulus.pow_exponent_dvd_finitePart 𝔪 v) hmem

/-- **Congruence to one, read back on an algebraic integer.**  The converse of
`isCongrOne_of_sub_one_mem` at the finite places: a unit congruent to one modulo `𝔪` that is the
image of `a : 𝓞 K` has `a - 1` in the finite part. -/
theorem sub_one_mem_of_isCongrOne {𝔪 : Modulus K} {x : Kˣ} {a : 𝓞 K} (hxa : (x : K) = a)
    (h : IsCongrOne 𝔪 x) : a - 1 ∈ 𝔪.finitePart := by
  refine Modulus.mem_finitePart_of_forall_mem_pow_exponent 𝔪 fun v hv ↦ ?_
  have hsub : (x : K) - 1 = algebraMap (𝓞 K) K (a - 1) := by rw [map_sub, map_one, hxa]
  simpa only [hsub, valuation_of_algebraMap, intValuation_le_pow_iff_mem]
    using h.valuation_sub_one_le hv



/-! ### The moving lemma -/









/-! ### Triviality criteria with integral generators -/

/-- **Trivial ray class, in generator form.**  An integral ideal prime to `𝔪` has trivial ray class
exactly when it is generated by an algebraic integer that is congruent to one modulo the finite
part and positive at every real place of the infinite part.  This differs from
`idealClass_eq_one_iff` in keeping the generator inside `𝓞 K`, with the two conditions on it
spelled out instead of packaged as `IsCongrOne`. -/
theorem idealClass_eq_one_iff_exists_generator {𝔪 : Modulus K} (J : integralIdealsPrimeTo 𝔪) :
    idealClass 𝔪 J = 1 ↔ ∃ α : 𝓞 K, α - 1 ∈ 𝔪.finitePart ∧ (∀ w ∈ 𝔪.infinitePart,
      0 < InfinitePlace.embedding_of_isReal w.2 (algebraMap (𝓞 K) K α)) ∧
      (J : Ideal (𝓞 K)) = Ideal.span {α} := by
  rw [idealClass_eq_one_iff]
  constructor
  · rintro ⟨x, hx, hJ⟩
    -- The generator lies in the integral ideal `J`, so it is an algebraic integer.
    obtain ⟨α, -, hα⟩ := (FractionalIdeal.mem_coeIdeal (𝓞 K)⁰).mp
      (hJ ▸ FractionalIdeal.mem_spanSingleton_self (𝓞 K)⁰ (x : K))
    exact ⟨α, sub_one_mem_of_isCongrOne hα.symm hx, fun w hw ↦ hα ▸ (isCongrOne_iff.mp hx).2 w hw,
      (FractionalIdeal.coeIdeal_inj (K := K)).mp <| by simp [hJ, hα]⟩
  · rintro ⟨α, hα1, hαpos, hJ⟩
    -- `J` is nonzero, so its generator is too.
    have hαne : algebraMap (𝓞 K) K α ≠ 0 := by
      simpa [hJ] using (NumberFieldArithmetic.mem_integralIdealsAway_iff.mp J.prop).1
    exact ⟨Units.mk0 _ hαne, isCongrOne_of_sub_one_mem rfl hα1 hαpos, by simp [hJ]⟩



end TauCeti.GlobalNumberFields

