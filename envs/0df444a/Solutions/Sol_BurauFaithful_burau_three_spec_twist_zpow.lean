/-
`BurauFaithful.burau_three_spec_twist_zpow`: every power of the full twist squared dies at
`t = -1`, i.e. the whole cyclic subgroup generated by `Δ⁴ = (σ₁σ₂)⁶` lies in the kernel of the
specialization (Birman, §3.3, Theorem 3.15, pp. 129--130).
-/
import Definitions.Def_BurauFaithful_UnreducedBurau
import Theorems.Thm_BurauFaithful_burauRep3_y

set_option autoImplicit false

open LaurentPolynomial Matrix BraidsLinksMCG

/-- The specialization `ℤ[t,t⁻¹] → ℤ`, `t ↦ -1`. -/
noncomputable def specM1 : (LaurentPolynomial ℤ) →+* ℤ :=
  LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ)

theorem solution (k : ℤ) :
    Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 ((BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩) ^ (6 * k))) = 1 := by
  have hmat : (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩)) : Matrix (Fin 3) (Fin 3) ℤ) =
      !![ 2, -2, 1;
          1,  0, 0;
          0,  1, 0 ] := by
    ext i j
    rw [Matrix.GeneralLinearGroup.map_apply]
    rw [show (↑(BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
          BraidsLinksMCG.sigma ⟨1, by decide⟩)) :
            Matrix (Fin 3) (Fin 3) (LaurentPolynomial ℤ)) = _ from BurauFaithful.burauRep3_y]
    fin_cases i <;> fin_cases j <;> simp [specM1, LaurentPolynomial.eval₂_T] <;> norm_num
  have h6 : (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩))) ^ 6 = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one, hmat]
    decide
  have h6z : (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩))) ^ (6 : ℤ) = 1 := by
    simpa using h6
  have hpow : (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩))) ^ (6 * k) = 1 := by
    rw [_root_.zpow_mul]
    have hcong := congrArg (fun x : GL (Fin 3) ℤ => x ^ k) h6z
    simpa using hcong
  calc Matrix.GeneralLinearGroup.map specM1
        (BurauFaithful.burauRep 3 ((BraidsLinksMCG.sigma ⟨0, by decide⟩ *
          BraidsLinksMCG.sigma ⟨1, by decide⟩) ^ (6 * k)))
      = (Matrix.GeneralLinearGroup.map specM1
          (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
            BraidsLinksMCG.sigma ⟨1, by decide⟩))) ^ (6 * k) := by
        simp only [map_zpow]
    _ = 1 := hpow
