open PositionalRateLink in
theorem solution{G : Type*} [Fintype G] [Nonempty G] (t : G → ℝ)
    {α : ℝ} (hα : 0 ≤ α) :
    ((Finset.univ.filter (fun g => permPValue t g ≤ α)).card : ℝ) ≤ α * Fintype.card G := by
  classical
  have hM : (0:ℝ) < Fintype.card G := by exact_mod_cast Fintype.card_pos
  set S := Finset.univ.filter (fun g => permPValue t g ≤ α) with hS
  rcases S.eq_empty_or_nonempty with h | h
  · rw [h]
    simp
    positivity
  · obtain ⟨g0, hg0S, hg0min⟩ := S.exists_min_image t h
    have hsub : S ⊆ Finset.univ.filter (fun h => t g0 ≤ t h) := by
      intro g hg
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact hg0min g hg
    have hcard := Finset.card_le_card hsub
    have hp : permPValue t g0 ≤ α := (Finset.mem_filter.1 hg0S).2
    rw [permPValue, div_le_iff₀ hM] at hp
    calc ((S.card : ℝ)) ≤ ((Finset.univ.filter (fun h => t g0 ≤ t h)).card : ℝ) := by
          exact_mod_cast hcard
      _ ≤ α * Fintype.card G := hp
