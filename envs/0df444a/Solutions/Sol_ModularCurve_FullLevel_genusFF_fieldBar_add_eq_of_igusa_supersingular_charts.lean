theorem exists_eq_algebraMap_of_isAlgebraic {κ F : Type*} [Field κ] [IsAlgClosed κ] [Field F] [Algebra κ F]
    {r : F} (hr : IsAlgebraic κ r) : ∃ k, r = algebraMap κ F k := by
  have hint : IsIntegral κ r := hr.isIntegral
  have h : (minpoly κ r).degree = 1 :=
    IsAlgClosed.degree_eq_one_of_irreducible κ (minpoly.irreducible hint)
  have hq : (minpoly κ r).leadingCoeff = 1 := minpoly.monic hint
  have := minpoly.aeval κ r
  rw [Polynomial.eq_X_add_C_of_degree_eq_one h, hq, Polynomial.C_1, one_mul, map_add, Polynomial.aeval_X,
    Polynomial.aeval_C, add_eq_zero_iff_eq_neg] at this
  exact ⟨-(minpoly κ r).coeff 0, by rw [map_neg]; exact this⟩

variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {Fbar₁ : Type*} [Field Fbar₁] [Algebra (ResidueField A) Fbar₁]
  {Fbar₂ : Type*} [Field Fbar₂] [Algebra (ResidueField A) Fbar₂]

theorem exists_transcendental_of_forall_isUnit_sub [IsAlgClosed (ResidueField A)] (C : ComponentChart A F Fbar₁)
    {O : ValuationSubring F} (hO : C.integers = O)
    (h : ∃ t : F, t ∈ O ∧ ∀ a : A, ∃ h : t - algebraMap L F (a : L) ∈ O, IsUnit (⟨_, h⟩ : O)) :
    ∃ r : Fbar₁, Transcendental (ResidueField A) r := by
  subst hO
  obtain ⟨t, ht, hunit⟩ := h
  refine ⟨C.residue ⟨t, ht⟩, fun halg => ?_⟩
  obtain ⟨k, hk⟩ := exists_eq_algebraMap_of_isAlgebraic halg
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective k
  obtain ⟨hmem, hu⟩ := hunit a
  have ha : algebraMap L F (a : L) ∈ C.integers := (C.algebraMap_mem_iff a).mpr a.2
  rw [← C.residue_algebraMap a, ← sub_eq_zero, ← map_sub] at hk
  have hsub : (⟨t - algebraMap L F (a : L), hmem⟩ : C.integers) = ⟨t, ht⟩ - ⟨algebraMap L F (a : L), ha⟩ := rfl
  have hker : (⟨t - algebraMap L F (a : L), hmem⟩ : C.integers) ∈ maximalIdeal C.integers := by
    rw [← C.ker_residue, RingHom.mem_ker, hsub]; exact hk
  exact (IsLocalRing.mem_maximalIdeal _).mp hker hu

