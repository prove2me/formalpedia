namespace OAI

/-! # Countable matrix corners in type III factors

The absence of nonzero finite projections gives a proper isometry. Its
wandering projections are nonzero and orthogonal. A projection supremum
completes them to a partition of one; the published comparison theorem
then joins the pieces by partial isometries.
-/

namespace KadisonKastler

open Generator.Tracial Filter
open scoped BigOperators Topology

noncomputable section

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {M : VonNeumannAlgebra H}

theorem star_pow_mul_pow_p1 (w : Algebra M) (hw : star w * w = 1) (n : ℕ) :
    star (w ^ n) * w ^ n = 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, star_mul]
    calc
      (star w * star (w ^ n)) * (w ^ n * w) =
          star w * (star (w ^ n) * w ^ n) * w := by simp only [mul_assoc]
      _ = 1 := by rw [ih, mul_one, hw]

def wanderingProjection_p1 (w : Algebra M) (hw : star w * w = 1) :
    AlgebraProjection M :=
  ⟨1 - w * star w, (show IsStarProjection (w * star w) from ⟨by
    change (w * star w) * (w * star w) = w * star w
    calc
      _ = w * (star w * w) * star w := by simp only [mul_assoc]
      _ = _ := by rw [hw, mul_one], IsSelfAdjoint.mul_star_self w⟩).one_sub⟩

def wanderingPartialIsometry_p1 (w : Algebra M) (hw : star w * w = 1) (n : ℕ) :
    PartialIsometry M where
  support := wanderingProjection_p1 w hw
  val := w ^ n * (wanderingProjection_p1 w hw).val
  initial := by
    rw [star_mul, (wanderingProjection_p1 w hw).property.isSelfAdjoint.star_eq]
    calc
      ((wanderingProjection_p1 w hw).val * star (w ^ n)) *
          (w ^ n * (wanderingProjection_p1 w hw).val) =
          (wanderingProjection_p1 w hw).val * (star (w ^ n) * w ^ n) *
            (wanderingProjection_p1 w hw).val := by simp only [mul_assoc]
      _ = (wanderingProjection_p1 w hw).val := by
        rw [star_pow_mul_pow_p1 w hw, mul_one,
          (wanderingProjection_p1 w hw).property.isIdempotentElem.eq]

def orthogonalProjectionNet (p : ℕ → AlgebraProjection M)
    (ho : Pairwise (fun i j => (p i).val * (p j).val = 0))
    (s : Finset ℕ) : AlgebraProjection M :=
  AlgebraProjection.finsetSum p s (fun _ _ _ _ hij => ho hij)

end

end KadisonKastler

end OAI
end

