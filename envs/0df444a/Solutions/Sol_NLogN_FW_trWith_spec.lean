theorem swapsPerm_fixHi' : ∀ l : List (Fin HS × Fin HS), (∀ p ∈ l, p.1.val < 55 ∧ p.2.val < 55) →
    FixHi (swapsPerm l)
  | [], _ => fun _ _ => rfl
  | (a, b) :: l, h => by
    intro i hi
    have ih := swapsPerm_fixHi' l (fun p hp => h p (List.mem_cons_of_mem _ hp)) i hi
    have hab := h (a, b) List.mem_cons_self
    simp only [swapsPerm, Equiv.Perm.mul_apply, ih]
    apply Equiv.swap_apply_of_ne_of_ne
    · intro e; subst e; simp at hab; omega
    · intro e; subst e; simp at hab; omega

theorem swapsPerm_fixHi (l : List (Fin HS × Fin HS)) (h : swapsLow l = true) :
    FixHi (swapsPerm l) :=
  swapsPerm_fixHi' l (by simpa [swapsLow, List.all_eq_true] using h)

end NLogN

