-- Source module: Solutions.J6AIL1
/-!
# A lines, IL side 1: the per-block kernel as a list function

`aKerL w2 bk win Q aTab rTab cTab x` (row `x` of length `win`, the gathered window):

All three stages use the one rounding exponent `Q` (the IL kernel has one `rP` register); the
tables `aTab`, `rTab` are stored scaled by `2^Q`, so the first two stages are exact:

1. scale: `y = dgG Q aTab (x.take w2)` (`aTab_i = 2^Q a_i`: exact products `a_i x_i`);
2. correlate: `z = lwG Q (2n) rTab (padG n y)` with `n = w2 + bk` (`rTab_e = 2^Q r_e`: exact lower
   Toeplitz sums, one record product);
3. extract `z[w2 .. w2 + bk)` and rescale: `dgG Q cTab` (one rounding `rs Q` per entry);
4. pad with zeros to `win`.

* `aKerL_getD`: the entries of `aKerL` as fixed-point products of the explicit window sums.
* The tables of block `b` of an `A` line: `aTabA`, `rTabA`, `cTabA`.
* **`aKer_chirp`**: on the gathered window of block `b`, `aKerL` with these tables gives the
  `chirpC` outputs `k = b·bk + κ`, `κ < bk`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace J6A

open IntMul.HvdH J6Seg Finset

lemma getD_take' {α : Type*} (l : List α) (n i : ℕ) (d : α) (h : i < n) :
    (l.take n).getD i d = l.getD i d := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_take, h]

lemma getD_drop' {α : Type*} (l : List α) (n i : ℕ) (d : α) :
    (l.drop n).getD i d = l.getD (n + i) d := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_drop]

lemma rs_pow (Q : ℕ) (m : ℤ) : J6Seg.rs Q (2 ^ Q * m) = m := by
  unfold J6Seg.rs J6Seg.rq
  have h : (0 : ℤ) < 2 ^ Q := by positivity
  rw [show 2 * (2 ^ Q * m) + 2 ^ Q = 2 ^ Q * (2 * m + 1) by ring,
    show (2 : ℤ) * 2 ^ Q = 2 ^ Q * 2 by ring, Int.mul_ediv_mul_of_pos _ _ h]
  omega

lemma fmul_pow (Q : ℕ) (a x : ℤ) : J6Seg.fmul Q (2 ^ Q * a) x = a * x := by
  unfold J6Seg.fmul; rw [mul_assoc, rs_pow]

lemma getD_dgG (P : ℕ) (c : List ℤ) (z : List (ℤ × ℤ)) {i : ℕ} (hi : i < z.length)
    (hc : z.length ≤ c.length) :
    (dgG P c z).getD i (0, 0) =
      (J6Seg.fmul P (c.getD i 0) (z.getD i (0, 0)).1, J6Seg.fmul P (c.getD i 0) (z.getD i (0, 0)).2) := by
  unfold dgG
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_zipWith,
    List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ hi]

/-- **The entries of the kernel.** -/
theorem aKerL_getD_sol_aux (w2 bk win Q : ℕ) (aTab rTab cTab : List ℤ) (x : List (ℤ × ℤ))
    (hx : w2 ≤ x.length) (ha : w2 ≤ aTab.length) (hr : w2 + bk ≤ rTab.length)
    (hc : bk ≤ cTab.length) (a r : ℕ → ℤ) (haa : ∀ i < w2, aTab.getD i 0 = 2 ^ Q * a i)
    (hrr : ∀ e < w2 + bk, rTab.getD e 0 = 2 ^ Q * r e) {κ : ℕ} (hκ : κ < bk) :
    (aKerL w2 bk win Q aTab rTab cTab x).getD κ (0, 0) =
      (J6Seg.fmul Q (cTab.getD κ 0) (kSum w2 a r (fun i => (x.getD i (0, 0)).1) κ),
        J6Seg.fmul Q (cTab.getD κ 0) (kSum w2 a r (fun i => (x.getD i (0, 0)).2) κ)) := by
  set n := w2 + bk with hn
  set y := dgG Q aTab (x.take w2) with hydef
  have hy : y.length = w2 := by rw [hydef, length_dgG Q (by simp; omega)]; simp; omega
  have hyi : ∀ i < w2, y.getD i (0, 0) =
      (a i * (x.getD i (0, 0)).1, a i * (x.getD i (0, 0)).2) := by
    intro i hi
    rw [hydef, getD_dgG Q _ _ (by simp; omega) (by simp; omega), haa i hi, fmul_pow, fmul_pow,
      getD_take' _ _ _ _ hi]
  set z := padG n y with hzdef
  have hzl : z.length = n := by simp [hzdef, padG, hy]; omega
  have hzi : ∀ i, z.getD i (0, 0) = if i < w2 then y.getD i (0, 0) else (0, 0) := by
    intro i
    rw [hzdef, padG]
    by_cases h : i < w2
    · rw [if_pos h, List.getD_append _ _ _ _ (by omega)]
    · rw [if_neg h, List.getD_append_right _ _ _ _ (by omega), List.getD_eq_getElem?_getD,
        List.getElem?_replicate]
      split_ifs <;> rfl
  have hlw : lwG Q (2 * n) rTab z = liftG (lwL Q rTab) z :=
    (liftG_lwL Q rTab z (by omega) (by omega)).symm
  set Z := lwG Q (2 * n) rTab z with hZdef
  have hZl : Z.length = n := by rw [hZdef, length_lwG Q (by omega), hzl]
  -- entry `w2 + κ` of the correlation
  have hconv : ∀ (g : ℤ × ℤ → ℤ), g (0, 0) = 0 →
      (convL rTab (z.map g)).getD (w2 + κ) 0 =
        2 ^ Q * ∑ i ∈ range w2, r (w2 + κ - i) * g (y.getD i (0, 0)) := by
    intro g hg0
    unfold convL
    rw [List.getD_eq_getElem _ _ (by simp [hzl]; omega), List.getElem_map, List.getElem_range]
    have e1 : ∀ k ∈ range (w2 + κ + 1), rTab.getD (w2 + κ - k) 0 * (z.map g).getD k 0 =
        if k < w2 then rTab.getD (w2 + κ - k) 0 * g (y.getD k (0, 0)) else 0 := by
      intro k hk
      rw [mem_range] at hk
      have hmap : (z.map g).getD k 0 = g (z.getD k (0, 0)) := by
        rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
        cases z[k]? <;> simp [hg0]
      rw [hmap, hzi k]
      split_ifs <;> simp [hg0]
    rw [sum_congr rfl e1, ← sum_filter, mul_sum]
    apply sum_congr (by ext k; simp only [mem_filter, mem_range]; omega)
    intro k hk
    simp only [mem_filter, mem_range] at hk
    rw [hrr _ (by omega)]; ring
  have hZi : (Z.getD (w2 + κ) (0, 0)) =
      (∑ i ∈ range w2, r (w2 + κ - i) * (y.getD i (0, 0)).1,
        ∑ i ∈ range w2, r (w2 + κ - i) * (y.getD i (0, 0)).2) := by
    rw [hlw]
    unfold liftG
    rw [List.getD_eq_getElem _ _ (by simp [length_lwL, hzl]; omega), List.getElem_zip]
    unfold lwL
    simp only [List.getElem_map]
    have h1 := hconv Prod.fst rfl
    have h2 := hconv Prod.snd rfl
    rw [List.getD_eq_getElem _ _ (by simp [length_convL, hzl]; omega)] at h1 h2
    rw [h1, h2, rs_pow, rs_pow]
  -- assemble
  have hsl : ((Z.drop w2).take bk).length = bk := by simp [hZl]; omega
  unfold aKerL
  rw [← hydef, ← hzdef, ← hZdef, List.getD_append _ _ _ _ (by rw [length_dgG Q (by omega), hsl]; exact hκ),
    getD_dgG Q _ _ (by rw [hsl]; exact hκ) (by rw [hsl]; exact hc),
    getD_take' _ _ _ _ hκ, getD_drop', hZi]
  unfold kSum
  congr 2 <;> (dsimp only; apply sum_congr rfl; intro i hi; rw [mem_range] at hi; rw [hyi i hi]; ring)

/-! ## The tables of an `A` line and the kernel on a gathered window -/

