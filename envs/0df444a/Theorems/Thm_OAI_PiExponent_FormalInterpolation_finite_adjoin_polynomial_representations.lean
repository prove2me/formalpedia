-- title:
--   Finite module gives polynomial representations in the generators
-- statement:
--   Finite generation of the polynomial ring as a module over the algebra generated by `g` gives a fixed finite family of module generators, with every polynomial expressible as a sum of polynomial expressions in `g` times those generators.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_polynomial_representations
    {d m : Nat} (g : Fin m → MvPolynomial (Fin d) Complex)
    (hmod : Module.Finite (Algebra.adjoin Complex (Set.range g))
      (MvPolynomial (Fin d) Complex)) :
    ∀ q : MvPolynomial (Fin d) Complex,
      ∃ t : Nat, ∃ b : Fin t → MvPolynomial (Fin d) Complex,
        ∃ F : Fin t → MvPolynomial (Fin m) Complex,
          q = ∑ i : Fin t, MvPolynomial.aeval g (F i) * b i := by sorry
