-- title:
--   Theorem 4.6, 1 ⇒ 2 — Stengle's Positivstellensatz: an empty set (4.4) has a certificate $f+g^2+h=0$
-- statement:
--   Let $(f_j)_{j=1,\dots,s}$, $(g_k)_{k=1,\dots,t}$, $(h_\ell)_{\ell=1,\dots,u}$ be finite families of polynomials in $\mathbb R[x_1,\dots,x_n]$, each possibly empty. Let $P$ be the cone generated by the $f_j$, $M$ the multiplicative monoid generated by the $g_k$, and $I$ the ideal generated by the $h_\ell$. If the set
--   $$
--   \left\{x\in\mathbb R^n \;\middle|\; f_j(x)\ge 0,\ j=1,\dots,s;\ g_k(x)\ne 0,\ k=1,\dots,t;\ h_\ell(x)=0,\ \ell=1,\dots,u\right\}\qquad(4.4)
--   $$
--   is empty, then there exist $f\in P$, $g\in M$, $h\in I$ such that
--   $$
--   f+g^2+h=0.
--   $$
--
--   This is the Positivstellensatz of Stengle (1974), the real counterpart of Hilbert's Nullstellensatz: every infeasible real polynomial system has an algebraic certificate of infeasibility. The paper cites it from Bochnak–Coste–Roy, *Real Algebraic Geometry*, Theorem 4.4.2, and uses it to show that the SDP hierarchy of Theorem 5.1 eventually becomes feasible.
--
--   **Formalization Note** This item formalizes the implication 1 ⇒ 2 of Theorem 4.6, which the paper does not prove ("We refer the reader to [BCR98] for the other direction"). It is stated over $\mathbb R$, as in the paper, with the cone of Definition 4.5 (not a preordering excluding $-1$).
-- source:
--   Parrilo, Semidefinite programming relaxations for semialgebraic problems, Math. Program. Ser. B 96 (2003) 293–320, p. 305, Theorem 4.6 (1 ⇒ 2), cited from [BCR98, Theorem 4.4.2]

import Mathlib
import Definitions.Def_SemialgebraicSDP_Psatz_Cone

namespace SemialgebraicSDP.Psatz

open MvPolynomial

theorem theorem_4_6_positivstellensatz {n s t u : ℕ} (f : Fin s → MvPolynomial (Fin n) ℝ)
    (g : Fin t → MvPolynomial (Fin n) ℝ) (h : Fin u → MvPolynomial (Fin n) ℝ)
    (hempty : psatzSet f g h = ∅) :
    ∃ F ∈ cone (Set.range f), ∃ G ∈ Submonoid.closure (Set.range g),
      ∃ H ∈ Ideal.span (Set.range h), F + G ^ 2 + H = 0 := by sorry

end SemialgebraicSDP.Psatz
