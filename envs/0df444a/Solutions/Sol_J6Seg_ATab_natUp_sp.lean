namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-- One move, with the result given pointwise. -/
theorem mvK_to {X Y C : Fin HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX5 : X.val < 56)
    (hY5 : Y.val < 56) (hC5 : C.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (n : Ex HS)
    (hnc : n.Clean) (hno : n.ok (encK s f)) (L : List ℤ) (hX : f X = L) (hY : f Y = [])
    (hn : n.eval (encK s f) = L.length) (B : ℕ) (hL : Bnd B L) (hnl : n.Lin)
    (hnb : n.Bnd (encK s f) B) (G : Fin HS → List ℤ)
    (hG : ∀ j, G j = if j = Y then L.reverse else if j = X then [] else f j) :
    Sp (mvK X Y C n) (encK s f) (encK s G)
      ((n.size + 1) * 2000 * (B + 2) + L.length * (14000 * (B + 2)) + 32) := by
  refine (Sp.mvK hXY hXC hYC hX5 hY5 hC5 s f n hnc hno L [] (by rw [hX, List.append_nil]) hn B
    hL hnl hnb).congr ?_
  congr 1; funext j; rw [hG j, hY, List.append_nil]
  by_cases h1 : j = Y
  · subst h1; simp
  · by_cases h2 : j = X
    · subst h2; simp [h1]
    · simp [h1, h2]

/-- A list alone on `X`, moved to `Y` (reversed). -/
theorem mv_alone {X Y : Fin HS} (hXY : X ≠ Y) (hX5 : X.val < 56) (hY5 : Y.val < 56)
    (hXC : X ≠ cM) (hYC : Y ≠ cM) (s : IState HS) (L : List ℤ) (B : ℕ) (hL : Bnd B L)
    (h8 : zsz (L.length : ℤ) ≤ B) :
    Sp (mvK X Y cM (.lit (L.length : ℤ))) (encK s (update E0 X L)) (encK s (update E0 Y L.reverse))
      (((Ex.lit (S := HS) (L.length : ℤ)).size + 1) * 2000 * (B + 2) +
        L.length * (14000 * (B + 2)) + 32) :=
  mvK_to hXY hXC hYC hX5 hY5 (by decide) s _ _ (clean_lit _) trivial L (update_self _ _ _)
    (update_of_ne (Ne.symm hXY) _ _) rfl B hL trivial h8 _ (fun j => by
      by_cases h1 : j = Y
      · subst h1; simp
      · by_cases h2 : j = X
        · subst h2; simp [h1]
        · simp [h1, h2])

/-- A list on `X` beside a register file on `oN`, moved to `Y` (reversed). -/
theorem mv_ext {X Y : Fin HS} (hXY : X ≠ Y) (hX5 : X.val < 56) (hY5 : Y.val < 56)
    (hXC : X ≠ cM) (hYC : Y ≠ cM) (oN : Fin 19 → Fin HS) (hinj : Injective oN)
    (hXo : ∀ i, oN i ≠ X) (hYo : ∀ i, oN i ≠ Y) (V : Fin 19 → List ℤ)
    (s : IState HS) (L : List ℤ) (B : ℕ) (hL : Bnd B L) (h8 : zsz (L.length : ℤ) ≤ B) :
    Sp (mvK X Y cM (.lit (L.length : ℤ))) (encK s (extend oN V (update E0 X L)))
      (encK s (extend oN V (update E0 Y L.reverse)))
      (((Ex.lit (S := HS) (L.length : ℤ)).size + 1) * 2000 * (B + 2) +
        L.length * (14000 * (B + 2)) + 32) := by
  have nX : ¬ ∃ i, oN i = X := fun ⟨i, h⟩ => hXo i h
  have nY : ¬ ∃ i, oN i = Y := fun ⟨i, h⟩ => hYo i h
  refine mvK_to hXY hXC hYC hX5 hY5 (by decide) s _ _ (clean_lit _) trivial L
    (by rw [extend_apply' _ _ _ nX, update_self])
    (by rw [extend_apply' _ _ _ nY, update_of_ne (Ne.symm hXY)]) rfl B hL trivial h8 _ (fun j => ?_)
  by_cases hj : ∃ i, oN i = j
  · obtain ⟨i, rfl⟩ := hj
    rw [if_neg (hYo i), if_neg (hXo i), hinj.extend_apply, hinj.extend_apply]
  · rw [extend_apply' _ _ _ hj, extend_apply' _ _ _ hj]
    by_cases h1 : j = Y
    · subst h1; simp
    · by_cases h2 : j = X
      · subst h2; simp [h1]
      · simp [h1, h2]

theorem fne {a b : Fin HS} (h : a.val ≠ b.val) : a ≠ b := fun e => h (congrArg Fin.val e)

set_option maxHeartbeats 2000000 in
/-- **The native set-up.** -/
theorem natUp_sp_sol_aux {W k pre post s t p α d pkA pkC bA bC B : ℕ} (st : IState HS)
    (Zn : Fin HS) (oN : Fin 19 → Fin HS) (hinj : Injective oN)
    (hO : ∀ i, (oN i).val < 31 ∨ (oN i).val = 55) (hZ : Zn.val = 49 ∨ Zn.val = 55)
    (hZo : ∀ i, oN i ≠ Zn)
    (hdL : ∀ x ∈ J6A.PA.dL k pre post s t p α d, |x| < 2 ^ W) (hp1 : 1 ≤ p) (hα1 : 1 ≤ α)
    (hmW : sWidth p α + 4 ≤ W) (hP : PBnd W p t α pkA pkC bA bC) (hA : ABnd W p s t α)
    (hrW : 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) < 2 ^ W)
    (hdB : Bnd B (J6A.PA.dL k pre post s t p α d)) (h8 : zsz 8 ≤ B)
    (hvB : ∀ a ∈ vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3) pre (ncA p t α)
      post, zsz a ≤ B)
    (hlB : zsz ((tabA p s t α (pkA * p + pkC) (bA * p + bC)).length : ℤ) ≤ B)
    (hTB : Bnd B (tabA p s t α (pkA * p + pkC) (bA * p + bC))) :
    Sp (natUp pkA pkC bA bC Zn oN) (encK st (F0 Zn (J6A.PA.dL k pre post s t p α d)))
      (encK st (extend oN (kerV p s t α (pkA * p + pkC) (bA * p + bC) pre post)
        (F0 Zn (J6A.PA.dL k pre post s t p α d))))
      (cNat W p t α pkA pkC bA bC B (tabA p s t α (pkA * p + pkC) (bA * p + bC)).length) := by
  set desc := J6A.PA.dL k pre post s t p α d with hdesc
  set vs := vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3) pre (ncA p t α) post
    with hvs
  set T := tabA p s t α (pkA * p + pkC) (bA * p + bC) with hT
  set V := kerV p s t α (pkA * p + pkC) (bA * p + bC) pre post with hV
  have hl8 : desc.length = 8 := rfl
  have ho : ∀ i (x : Fin HS), 31 ≤ x.val → x.val < 55 → oN i ≠ x := fun i x h1 h2 =>
    fne (by have := hO i; omega)
  have hz : ∀ x : Fin HS, x.val ≠ 49 → x.val ≠ 55 → Zn ≠ x := fun x h1 h2 =>
    fne (by omega)
  have Zn5 : Zn.val < 56 := by omega
  -- 1, 2: the descriptor to `31`
  have m1 := mv_alone (X := Zn) (Y := 54) (hz _ (by decide) (by decide)) Zn5 (by decide)
    (hz _ (by decide) (by decide)) (by decide) st desc B hdB (by rw [hl8]; exact h8)
  have m2 := mv_alone (X := 54) (Y := 31) (by decide) (by decide) (by decide) (by decide)
    (by decide) st desc.reverse B (KIL.bnd_reverse hdB) (by rw [List.length_reverse, hl8]; exact h8)
  rw [List.reverse_reverse] at m2
  -- 3: the core
  set F1 := update E0 31 desc with hF1
  have m3 := sp_core (W := W) (k := k) (d := d) (pkA := pkA) (pkC := pkC) (bA := bA) (bC := bC)
    st F1 (fun j hj => by rw [hF1, update_of_ne hj]) (by rw [hF1, update_self]) hdL hp1 hα1 hmW
    hP hA hrW
  -- 4: the table `43 → 41`
  set G4 := update (update (update F1 45 vs) 42 [(T.length : ℤ)]) 41 T with hG4
  have g42 : coreOut F1 vs T 42 = [(T.length : ℤ)] := by
    rw [coreOut, update_of_ne (by decide), update_self]
  have m4 := mvK_to (X := 43) (Y := 41) (C := cM) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) st (coreOut F1 vs T) (.reg 42) (clean_reg (by decide)) (ok_reg g42)
    T.reverse (by rw [coreOut, update_self])
    (by rw [coreOut, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide),
      hF1, update_of_ne (by decide)])
    (by rw [eval_reg g42, List.length_reverse]) B (KIL.bnd_reverse hTB) trivial (bnd_reg g42 hlB) G4
    (fun j => by
      rw [hG4, List.reverse_reverse]
      by_cases h1 : j = 41
      · subst h1; simp
      · by_cases h2 : j = 43
        · subst h2; simp [hF1]
        · simp only [coreOut, update_apply, h1, h2, if_false])
  -- 5: the distribution
  have hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC := fun i =>
    ⟨ho i _ (by decide) (by decide), ho i _ (by decide) (by decide), ho i _ (by decide) (by decide),
      ho i _ (by decide) (by decide), ho i _ (by decide) (by decide)⟩
  have hlt : ∀ i, (oN i).val < 56 := fun i => by have := hO i; omega
  have m5 := distAll_sp st oN hinj hlt hx G4 vs T rfl
    (by rw [hG4, update_of_ne (by decide), update_of_ne (by decide), update_self])
    (by rw [hG4, update_of_ne (by decide), update_self]) (by rw [hG4, update_self])
    (by rw [hG4, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide), hF1,
      update_of_ne (by decide)])
    (fun i => by
      obtain ⟨a1, a2, a3, -, -⟩ := hx i
      rw [hG4, update_of_ne a3, update_of_ne a2, update_of_ne a1, hF1,
        update_of_ne (ho i _ (by decide) (by decide))])
    V (fun i => kerRegs_vsA _ _ _ _ _ _ _ i) rfl rfl (kerRegs_hi' _ _ _ _ _ _ _) B hvB hlB hTB
  have e5 : update (update (update (extend oN V G4) sX []) sLn []) sOut [] =
      extend oN V (update E0 31 desc) := by
    funext j
    by_cases hj : ∃ i, oN i = j
    · obtain ⟨i, rfl⟩ := hj
      obtain ⟨a1, a2, a3, -, -⟩ := hx i
      rw [update_of_ne a3, update_of_ne a2, update_of_ne a1, hinj.extend_apply,
        hinj.extend_apply]
    · rw [extend_apply' _ _ _ hj]
      by_cases jO : j = sOut
      · subst jO; rw [update_self, update_of_ne (by decide)]
      rw [update_of_ne jO]
      by_cases jL : j = sLn
      · subst jL; rw [update_self, update_of_ne (by decide)]
      rw [update_of_ne jL]
      by_cases jX : j = sX
      · subst jX; rw [update_self, update_of_ne (by decide)]
      rw [update_of_ne jX, extend_apply' _ _ _ hj, hG4, update_of_ne jO, update_of_ne jL,
        update_of_ne jX]
  rw [e5] at m5
  -- 6, 7: the descriptor back
  have m6 := mv_ext (X := 31) (Y := 54) (by decide) (by decide) (by decide) (by decide)
    (by decide) oN hinj (fun i => ho i _ (by decide) (by decide))
    (fun i => ho i _ (by decide) (by decide)) V st desc B hdB (by rw [hl8]; exact h8)
  have m7 := mv_ext (X := 54) (Y := Zn) (Ne.symm (hz _ (by decide) (by decide))) (by decide) Zn5
    (by decide) (hz _ (by decide) (by decide)) oN hinj (fun i => ho i _ (by decide) (by decide))
    hZo V st desc.reverse B (KIL.bnd_reverse hdB) (by rw [List.length_reverse, hl8]; exact h8)
  rw [List.reverse_reverse] at m7
  simp only [List.length_reverse, hl8] at m1 m2 m6 m7
  exact (m1.seq (m2.seq (m3.seq (m4.seq (m5.seq (m6.seq m7)))))).mono
    (by simp only [cNat, cMvA, List.length_reverse, Nat.cast_ofNat]; omega)

