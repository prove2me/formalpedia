import Mathlib
import Definitions.Def_RepairSched_Model_IsBellman
import Definitions.Def_RepairSched_Model_backorderRatio
import Definitions.Def_RepairSched_Model_IsBarrierPolicy
import Definitions.Def_RepairSched_Model_avgBOE
import Definitions.Def_AtaBarjesteh23_Workload_DriftBM

open MeasureTheory Filter Topology

namespace RepairSched

/-- **(A.58): the long-run average cost of the barrier policy is `γ`.**
Özkan and van Houtum, *Joint Inventory and Scheduling Control in a Repair Facility*, SSRN 3784144 (2023), (A.58), OA p.35 (PDF p.75).

Let `(f, B, γ)` satisfy (13), let `X` be a Brownian motion with drift `0` and variance `Σ` for the
filtration `𝔽`, and let `(W, I, E, a, S)` be the barrier policy. Then
`lim_{t→∞} (1/t) E[Σᵢ bᵢ ∫₀ᵗ (aᵢ(s,W(s)) − Sᵢ)⁺ ds + ckμkE(t)] = γ`. -/
theorem equation_A_58 {n : ℕ} [NeZero n] (M : Model n) (S : Fin n → ℝ)
    (hEm : M.emergencyRate < M.backorderRatio) (f : ℝ → ℝ) (B γ : ℝ)
    (hBell : M.IsBellman S f B γ) {Ω : Type*} [mΩ : MeasurableSpace Ω] (𝔽 : Filtration ℝ mΩ)
    (P : Measure Ω) [IsProbabilityMeasure P] (X W I E : ℝ → Ω → ℝ) (a : ℝ → Ω → Fin n → ℝ)
    (hX : AtaBarjesteh23.Workload.IsDriftBM 𝔽 P X 0 (Real.sqrt M.Sigma))
    (hbar : M.IsBarrierPolicy 𝔽 P S f B X W I E a) :
    Tendsto (M.avgBOE P S E a) atTop (𝓝 (ENNReal.ofReal γ)) := by sorry

end RepairSched
