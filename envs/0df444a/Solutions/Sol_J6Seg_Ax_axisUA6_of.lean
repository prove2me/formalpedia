-- Source module: Solutions.J6LineTop2
/-!
# `LineNeed6` top level, part 2: registers, size bounds and the sweep cost

* `sgm dS dA`: nineteen registers in `1..22`, avoiding `0`, `dS`, `dA` (`sgm_ok : SwOK`).
* `swB_of`: with `QOk ⟨P, n, src⟩` the bound `B = 8 b' + 8` meets `SwB`.
* `sweep_cost_le`: the sweep overhead `10^9 (B+2)^2 (2D+3) + 2 ≤ 10^12 · cU6 P n A`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The registers -/

/-! ## The size bound -/

/-! ## The cost -/

theorem T_le_cU6 (P : Prm) (hP : P.Ok) (n A : ℕ) : (TP6 P n : ℝ) ≤ cU6 P n A := by
  unfold cU6 VP6
  have h1 : (1 : ℝ) ≤ pP6 P n := by
    have := b'P6_pos P n
    have e : pP6 P n = 6 * b'P6 P n := rfl
    exact_mod_cast (show 1 ≤ pP6 P n by omega)
  have h2 := Ncost6_ge_one P hP n
  have h3 : (1 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A := one_le_pow₀ (lgn_ge n)
  have hT : (0 : ℝ) ≤ TP6 P n := by positivity
  calc (TP6 P n : ℝ) = TP6 P n * 1 * 1 * 1 := by ring
    _ ≤ TP6 P n * pP6 P n * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A := by
      gcongr

theorem cU6_mono (P : Prm) (hP : P.Ok) (n : ℕ) {A A' : ℕ} (h : A ≤ A') :
    cU6 P n A ≤ cU6 P n A' := by
  unfold cU6
  have h0 : (0 : ℝ) ≤ VP6 P n * Ncost6 P n := by
    unfold VP6; have := Ncost6_ge_one P hP n; positivity
  exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (lgn_ge n) h) h0

end J6Seg

end

