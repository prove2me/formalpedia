theorem length_zipWith_xr {a b : List ℤ} (h : a.length = b.length) :
    (List.zipWith xr a b).length = a.length := by simp [h]

theorem accL_sp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) {Bb : ℕ} (hB : TabB W v Bb) (hr : List ℤ) :
    ∀ (l : List ℕ) (acc : List ℤ), (∀ w ∈ l, w < W) → f 20 = acc ++ hr → acc.length = v →
      NLogN.KIL.Bits acc →
      Sp (NLogN.KIL.accL v l) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 20 (accR F acc l ++ hr)))
        (l.length * (6 * cOp (W * v) Bb) + 1)
  | [], acc, _, h20, _, _ => by
    simp only [NLogN.KIL.accL, accR, List.foldl_nil, List.length_nil, Nat.zero_mul, Nat.zero_add]
    rw [← h20, Function.update_eq_self]; exact Sp.skip _
  | w :: l, acc, hl, h20, hlen, hbits => by
    have hw := hl w List.mem_cons_self
    have h1 := accC_sp hU hw s f rest hf hf21 acc hr h20 hlen hbits hB
    have hFw := hU w hw
    have h2 := accL_sp hU s (Function.update f 20 (List.zipWith xr acc (F w).reverse ++ hr)) rest
      (by simp [hf]) (by simp [hf21]) hB hr l (List.zipWith xr acc (F w).reverse)
      (fun w' hw' => hl w' (List.mem_cons_of_mem _ hw')) (by simp)
      (by rw [length_zipWith_xr (by simp [hlen, hFw.1]), hlen])
      (bits_zipWith_xr hbits (bits_reverse hFw.2))
    have H := h1.seq h2
    refine Sp.mono (Sp.congr H ?_) ?_
    · congr 1
      rw [Function.update_idem]
      rfl
    · simp only [List.length_cons]; nlinarith

theorem zipWith_reverse {a b : List ℤ} (h : a.length = b.length) :
    List.zipWith xr a.reverse b.reverse = (List.zipWith xr a b).reverse := by
  apply List.ext_getElem (by simp [h])
  intro i h1 h2
  simp [List.getElem_reverse, h]

theorem accR_rev {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) :
    ∀ (l : List ℕ) (a : List ℤ), (∀ w ∈ l, w < W) → a.length = v →
      accR F a.reverse l = (l.foldl (fun a w => List.zipWith xr a (F w)) a).reverse
  | [], a, _, _ => rfl
  | w :: l, a, hl, ha => by
    have hFw := hU w (hl w List.mem_cons_self)
    simp only [accR, List.foldl_cons] at *
    rw [zipWith_reverse (by rw [ha, hFw.1])]
    exact accR_rev hU l _ (fun w' h => hl w' (List.mem_cons_of_mem _ h))
      (by rw [length_zipWith_xr (by rw [ha, hFw.1]), ha])

theorem length_sumS {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) :
    ∀ (l : List ℕ) (a : List ℤ), (∀ w ∈ l, w < W) → a.length = v →
      (l.foldl (fun a w => List.zipWith xr a (F w)) a).length = v
  | [], a, _, ha => ha
  | w :: l, a, hl, ha => by
    have hFw := hU w (hl w List.mem_cons_self)
    simp only [List.foldl_cons]
    exact length_sumS hU l _ (fun w' h => hl w' (List.mem_cons_of_mem _ h))
      (by rw [length_zipWith_xr (by rw [ha, hFw.1]), ha])

theorem bits_sumS {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) :
    ∀ (l : List ℕ) (a : List ℤ), (∀ w ∈ l, w < W) → NLogN.KIL.Bits a →
      NLogN.KIL.Bits (l.foldl (fun a w => List.zipWith xr a (F w)) a)
  | [], a, _, ha => ha
  | w :: l, a, hl, ha => by
    have hFw := hU w (hl w List.mem_cons_self)
    simp only [List.foldl_cons]
    exact bits_sumS hU l _ (fun w' h => hl w' (List.mem_cons_of_mem _ h))
      (bits_zipWith_xr ha hFw.2)

theorem bits_replicate (v : ℕ) : NLogN.KIL.Bits (List.replicate v 0) := by
  intro x hx; rw [List.eq_of_mem_replicate hx]; simp

theorem buildC_sp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) {Bb : ℕ} (hB : TabB W v Bb) (l : List ℕ) (hl : ∀ w ∈ l, w < W) :
    Sp (buildC v l) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 20 ((sumS F v l).reverse ++ f 20)))
      ((l.length * 6 + 2) * cOp (W * v) Bb) := by
  have hvv := hB.vle
  have h1 := Sp.zeroK (Y := 20) (C := 21) (by decide) (by decide) (by decide) s f v hf21 Bb
    (hB.le hvv)
  have h2 := accL_sp hU s (Function.update f 20 (List.replicate v 0 ++ f 20)) rest (by simp [hf])
    (by simp [hf21]) hB (f 20) l (List.replicate v 0) hl (by simp) (by simp) (bits_replicate v)
  have H := h1.seq h2
  refine Sp.mono (Sp.congr H ?_) ?_
  · congr 1
    rw [Function.update_idem, show List.replicate v (0 : ℤ) = (List.replicate v 0).reverse by simp,
      accR_rev hU l _ hl (by simp)]
    rfl
  · have := cZero_le (Bb := Bb) hvv
    have := one_le_cOp (W * v) Bb
    nlinarith

theorem uni_sumS {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) {T : ℕ → List ℕ}
    (hT : SrcOK W T) : Uni W v (fun w => sumS F v (T w)) := fun w hw =>
  ⟨length_sumS hU _ _ (hT w hw).1 (by simp), bits_sumS hU _ _ (hT w hw).1 (bits_replicate v)⟩

theorem buildsC_sp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) {Bb : ℕ} (hB : TabB W v Bb) {T : ℕ → List ℕ} (hT : SrcOK W T) :
    ∀ n, n ≤ W → Sp (buildsC v T n) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 20 ((tabR 0 n (fun w => sumS F v (T w))).reverse ++ f 20)))
      (n * ((6 * W + 2) * cOp (W * v) Bb) + 1)
  | 0, _ => by
    simp only [buildsC, tabR, List.range'_zero, List.flatMap_nil, List.reverse_nil,
      List.nil_append, Function.update_eq_self, Nat.zero_mul, Nat.zero_add]
    exact Sp.skip _
  | n + 1, hn => by
    have h1 := buildsC_sp hU s f rest hf hf21 hB hT n (by omega)
    have h2 := buildC_sp hU s (Function.update f 20 ((tabR 0 n (fun w => sumS F v (T w))).reverse ++
      f 20)) rest (by simp [hf]) (by simp [hf21]) hB (T n) (hT n (by omega)).1
    have H := h1.seq h2
    refine Sp.mono (Sp.congr H ?_) ?_
    · congr 1
      rw [Function.update_idem, Function.update_self, tabR_add, List.reverse_append]
      simp [tabR]
    · have := (hT n (by omega)).2
      have := one_le_cOp (W * v) Bb
      have : (T n).length * 6 + 2 ≤ 6 * W + 2 := by omega
      have := Nat.mul_le_mul_right (cOp (W * v) Bb) this
      nlinarith

theorem rebuildC_sp {W v : ℕ} {F : ℕ → List ℤ} (hU : Uni W v F) (s : IState HS)
    (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = tabR 0 W F ++ rest)
    (hf21 : f 21 = []) {Bb : ℕ} (hB : TabB W v Bb) {T : ℕ → List ℕ} (hT : SrcOK W T) :
    Sp (rebuildC W v T) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (tabR 0 W (fun w => sumS F v (T w)) ++ rest)))
      (cRebuild W (W * v) Bb) := by
  have hB1 := hB.one
  have hG := uni_sumS hU hT
  have h1 := buildsC_sp hU s f rest hf hf21 hB hT W le_rfl
  have hlenF := length_tabR hU 0 W (by omega)
  have hlenG := length_tabR hG 0 W (by omega)
  have h2 := Sp.dropK (X := 0) (C := 21) (by decide) (by decide) (by decide) s
    (Function.update f 20 ((tabR 0 W (fun w => sumS F v (T w))).reverse ++ f 20))
    (tabR 0 W F) rest (by simp [hf]) (by simp [hf21]) Bb (bits_bnd (bits_tabR hU 0 W (by omega)) hB1)
    (by rw [hlenF]; exact hB.le le_rfl)
  rw [hlenF] at h2
  have h3 := Sp.mvL (X := 20) (Y := 0) (C := 21) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (Function.update (Function.update f 20
      ((tabR 0 W (fun w => sumS F v (T w))).reverse ++ f 20)) 0 rest)
    (tabR 0 W (fun w => sumS F v (T w))).reverse (f 20) (by simp) Bb
    (NLogN.KIL.bnd_reverse (bits_bnd (bits_tabR hG 0 W (by omega)) hB1))
    (by rw [List.length_reverse, hlenG]; exact hB.le le_rfl)
  rw [List.length_reverse, hlenG] at h3
  have H := h1.seq (h2.seq h3)
  refine Sp.mono (Sp.congr H ?_) ?_
  · congr 1
    funext j
    simp only [Function.update_apply]
    by_cases h0 : j = 0
    · subst h0; simp
    by_cases h20 : j = 20
    · subst h20; simp
    · simp [h0, h20]
  · have := cDrop_le (Bb := Bb) (le_refl (W * v))
    have := cMvL_le (Bb := Bb) (le_refl (W * v))
    have := one_le_cOp (W * v) Bb
    unfold cRebuild
    have e : (W * (6 * W + 2) + 3) * cOp (W * v) Bb =
        W * ((6 * W + 2) * cOp (W * v) Bb) + 3 * cOp (W * v) Bb := by ring
    rw [e]
    omega

end NLogN.KIL

