          ((QseriesFormalization.PartI.Ch04Franklin.pentagonalSign ab.2 : ℤ) : ℂ)) *
        (((QseriesFormalization.PartI.Ch04Franklin.pentagonalSign mk.2 : ℤ) : ℂ) * q^mk.2)
