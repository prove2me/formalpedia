-- title:
--   Integral simplex, its edge vectors at a vertex, and the supporting cone (Definition 2.6)
-- statement:
--   1. **Integral simplex** (Problem 1.1). For integral vectors $v_1,\dots,v_{k+1}\in\mathbb{Z}^d$, $\Delta=\operatorname{conv}\{v_1,\dots,v_{k+1}\}\subseteq\mathbb{R}^d$. (Affine independence, which makes $\Delta$ a $k$-dimensional simplex, is a hypothesis of the theorems.)
--   2. **Edge vectors at a vertex.** At the vertex $v_j$, the $k$ integral vectors $v_i-v_j$, $i\ne j$, listed in the order of the remaining indices.
--   3. **Supporting cone** (Definition 2.6). For a set $P\subseteq\mathbb{R}^d$ and a point $v$,
--   $$K_v=\{u\in\mathbb{R}^d : v+\delta\cdot u\in P\text{ for all sufficiently small }\delta>0\},$$
--   i.e. there is $\delta_0>0$ with $v+\delta u\in P$ for all $0<\delta\le\delta_0$.
--
--   For a vertex $v$ of a polytope $P$ the paper notes that $K_v$ is generated by the vectors $w-v$ over the vertices $w$ adjacent to $v$; for a simplex these are the edge vectors above. That fact is not built into the definition: the goal theorem decomposes the supporting cone as defined by Definition 2.6.
--
--   **Formalization Note** The supporting cone is defined for any set and point; the paper applies it at a vertex of a convex polytope, and the mission applies it only at the vertices of an integral simplex.
-- source:
--   Barvinok, A polynomial time algorithm for counting integral points in polyhedra when the dimension is fixed, Math. Oper. Res. 19 (1994), p. 769, Problem 1.1; p. 771, Definition 2.6

import Mathlib
import Definitions.Def_BarvinokCount_ShortFormula_RationalCone

namespace BarvinokCount.ShortFormula

/-- The simplex `Δ = conv{v_1, …, v_{k+1}} ⊆ ℝ^d` spanned by integral vertices (Problem 1.1). -/
def simplex {d k : ℕ} (v : Fin (k + 1) → Fin d → ℤ) : Set (Fin d → ℝ) :=
  convexHull ℝ (Set.range fun j => castVec (v j))

/-- The edge vectors `v_i − v_j` (`i ≠ j`) at the vertex `v_j` of the simplex, listed in
the order of the remaining vertices. -/
def edgeGens {d k : ℕ} (v : Fin (k + 1) → Fin d → ℤ) (j : Fin (k + 1)) :
    Fin k → Fin d → ℤ :=
  fun i => v (j.succAbove i) - v j

/-- The supporting cone `K_x = {u ∈ ℝ^d : x + δ u ∈ P for all sufficiently small δ > 0}`
of a set `P` at the point `x` (Definition 2.6). -/
def supportingCone {d : ℕ} (P : Set (Fin d → ℝ)) (x : Fin d → ℝ) : Set (Fin d → ℝ) :=
  {u | ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ δ : ℝ, 0 < δ → δ ≤ δ₀ → x + δ • u ∈ P}

end BarvinokCount.ShortFormula


