-- Source module: Solutions.J6SegILPre3
/-!
# B-line IL, pre-tables (B5), part 3: calls of the library number programs

`callC d e16 e17 e18 e27 prog`: push the four inputs on `16, 17, 18, 27`, run `prog` (which pushes
its result on `19` and leaves everything else), move the result into register `d ∈ rg`, pop.
`callC_sp`: generic; `enC_sp` / `epC_sp`: `v d := expNeg n k j` / `expPos n k j σ`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem expPos_prog (n k j σ : ℕ) : ∀ (t : IState HS) (L16 L17 L18 L27 : List Item),
    t.G 16 = .int n :: L16 → t.G 17 = .int k :: L17 → t.G 18 = .int j :: L18 →
    t.G 27 = .int σ :: L27 →
    expPosP.ok t ∧ expPosP.run t = t.upd 19 (.int (expPos n k j σ) :: t.G 19) ∧
      expPosP.cost t ≤ expPosCost n (zsz (k : ℤ)) (zsz (j : ℤ)) σ := by
  intro t L16 L17 L18 L27 g16 g17 g18 g27
  obtain ⟨h1, h2⟩ := expPosP_spec n k j σ t L16 L17 L18 L27 g16 g17 g18 g27
  exact ⟨h1, h2, expPosP_cost n k j σ t L16 L17 L18 L27 g16 g17 g18 g27⟩

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre4
/-!
# B-line IL, pre-tables (B5), part 4: polynomial expressions and the push loop

* `Poly e`: no `pow2`/`shl`, literals of absolute value `≤ 4`; `dg e` its degree;
  `mg_le_dg`: with every register value `≤ 2^A` (`A ≥ 2`), `mg e ≤ 2^(A·dg e)`. Every expression of
  the pre-table loops is polynomial (the powers `2^P`, `2^{P+1}` sit in registers `9`, `10`), so
  all cost conditions reduce to `dg e ≤ D` (by `decide`) and one uniform width `B = A·D + 1`.
* `pushLoop`: a counted loop whose body pushes `f k` onto `O` leaves `rv f N ++ O`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

theorem pow_le_pow' {A a b : ℕ} (h : a ≤ b) : 2 ^ (A * a) ≤ 2 ^ (A * b) :=
  Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ h)

/-- The uniform width: `dg e ≤ D` gives `mg e < 2^(A·D + 1)`. -/
theorem mg_lt {V : Fin HS → ℕ} {A D : ℕ} (hV : ∀ j, V j ≤ 2 ^ A) (hA : 2 ≤ A) {e : Ex HS}
    (hp : Poly e = true) (hd : dg e ≤ D) : mg V e < 2 ^ (A * D + 1) := by
  have h1 := (mg_le_dg hV hA e hp).trans (pow_le_pow' hd)
  have : 2 ^ (A * D) < 2 ^ (A * D + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

/-! ## The push loop -/

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILSrc1
/-!
# B-line IL, source-table producers, part 1: managed states and register-program steps

All producers are register programs (`RS`, `NLogN.HReg`) run on managed states `encK s0 F`
(`Sp p (encK s0 F) (encK s0 F') C` for every base `s0`). The stacks the producers write are
`13, 14, 15, 30, 31, 32, 33, 43, 44`; the state is kept in the form `bS G a13 … a44` (those nine
stacks over `G`). The input stacks are parameters (any stack `< 56` outside that list, `Free`).

* `pushP`, `asgP`, `popP`: one step with the cost from a uniform register bound `2^A` and the
  expression degree `D` (`B = A·D + 1` bits, `J6Seg.PreT.mg_lt`).
* `encK_rebase`: move the managed contents of one stack into the base state (so the `rep`
  counters may start non-empty).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT

/-! ## Steps -/

theorem clean_of_regs' {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
  fun i hi => clean_of_lt (h i hi) i (by simp [Ex.regs])

theorem bnd_P {σ : IState HS} {A D : ℕ} {e : Ex HS} (hR : RB σ A e) (hA : 2 ≤ A)
    (hp : Poly e = true) (hd : J6Seg.PreT.dg e ≤ D) : e.Bnd σ (A * D + 1) :=
  bnd_of_mg σ (fun _ => 2 ^ A) (A * D + 1) e hR (mg_lt (fun _ => le_rfl) hA hp hd)

theorem zsz_le_AD {a : ℤ} {A D : ℕ} (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) : zsz a ≤ A * D + 1 := by
  apply NLogN.zsz_le_of_abs
  have : (2 : ℤ) ^ A < 2 ^ (A * D + 1) :=
    pow_lt_pow_right₀ (by norm_num) (by nlinarith)
  linarith

theorem pushP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {e : Ex HS} {v : ℤ} {A D : ℕ}
    (hi : i.val < 56) (hc : ∀ j ∈ e.regs, j.val < 56) (hok : e.ok (encK s F))
    (hv : e.eval (encK s F) = v) (hR : RB (encK s F) A e) (hA : 2 ≤ A) (hp : Poly e = true)
    (hd : J6Seg.PreT.dg e ≤ D) :
    Sp (.push i e) (encK s F) (encK s (update F i (v :: F i))) ((e.size + 1) * uC A D) := by
  have h := Sp.pushQ s F hi (clean_of_regs' hc) hok (bnd_P hR hA hp hd)
  rw [hv] at h
  refine h.mono (le_of_eq ?_)
  unfold uC; ring

theorem popP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {A D : ℕ}
    (hi : i.val < 56) (hf : F i = a :: l) (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) :
    Sp (.pop i) (encK s F) (encK s (update F i l)) (uC A D) := by
  refine (Sp.pop s F hi hf (zsz_le_AD ha hD)).mono ?_
  unfold uC; nlinarith

theorem topv {s : IState HS} {F : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (h : F i = a :: l) : (encK s F).top i = a := top_encK h

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc3
/-!
# B-line IL, source-table producers, part 3: `ljP`, the forward pass

`ljP iS iT iL iW` (inputs `s, t, λ, w` on the tops of the free stacks `iS, iT, iL, iW`):

1. push the sentinel `0` on `14`;
2. **forward pass** `rep 43 s fwdB`: at step `k` push `stF k` on `14` (`stE`: `k` if `k = 0`,
   `k % λ = 0` or `rrZ k ≠ rrZ (k-1) + 1`, else the previous top);
3. push `s` on `15` (the block end `eB`), `0` on `31` (the count);
4. **backward pass** `rep 43 s bwdB` (part 4): at step `k` (`j = s - 1 - k`) pop `stF j` from
   `14`, push it on `32`, push `eB j - stF j` on `33`, push `j` on `30` and count it on `31` if
   `nearB j`, update `15` to `eB (j - 1)`;
5. pop `15` and the sentinel.

Here: the expressions, their values, and `fwd_runs`.
-/

