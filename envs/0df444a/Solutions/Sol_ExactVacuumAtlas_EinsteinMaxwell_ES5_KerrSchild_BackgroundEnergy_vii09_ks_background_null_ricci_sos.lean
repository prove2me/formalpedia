      (ksMetric gb v K i j) U) {x : Pt 5} (hx : x ∈ U) (hg : PregeodesicAt gb gbi K x) :
    contract2 (ricciOf gb gbi) x (K x) =
      contract2 (ricciOf (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
        (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)) x (K x) := by
  rw [← ks_pregeodesic_ricci_contract_eq hD hx hg]
  exact contract2_congr (fun i j => ricciOf_congr_of_eqOn hD.isOpen (fun i j => (hrep i j).symm)
    (fun i j => (es_inverse_eq_ks hP hUI hD hrep i j).symm) hx i j) _

end Transfer

