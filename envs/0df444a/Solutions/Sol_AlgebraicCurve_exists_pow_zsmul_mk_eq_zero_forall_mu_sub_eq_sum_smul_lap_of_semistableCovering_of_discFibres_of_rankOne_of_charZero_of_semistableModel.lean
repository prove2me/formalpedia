    ∃ h ∈ H, ∃ b : ℕ, ((ℓ ^ b : ℕ) : ℤ) • (x - h) = 0 := by
  have ho : 0 < addOrderOf x := hx.addOrderOf_pos
  obtain ⟨c, r, hr, hocr⟩ := Nat.exists_eq_pow_mul_and_not_dvd ho.ne' ℓ hℓ.one_lt.ne'

  have hcop : Nat.Coprime (ℓ ^ (a + c)) r := (Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr hr))
  obtain ⟨α, β, hαβ⟩ := Nat.isCoprime_iff_coprime.mpr hcop
  refine ⟨(α * ((ℓ ^ c : ℕ) : ℤ)) • (((ℓ ^ a : ℕ) : ℤ) • x), H.zsmul_mem hH _, c, ?_⟩
