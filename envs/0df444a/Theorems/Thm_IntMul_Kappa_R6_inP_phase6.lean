variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

theorem IntMul.Kappa.R6.inP_phase6 (C : BigCtx6 ix Isym tab extM Q D) (t : IState HS) (hR : Q.Base t) (x : ℕ)
    (hx : x < 2 ^ Q.n) (LA : List Item) (hA : t.G ARGM = .int (x : ℤ) :: LA) :
    ∃ (zs : List GI) (U : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ) (c : ℕ),
      IRuns Isym (IL.kTableP tab extM) (inP6 ix) t
        ((t.upd ARGM LA).upd 0 (ints (gflat zs) ++ t.G 0)) c ∧
      RepPad Q.p (Q.sB D) (Q.tB D) zs U ∧
      GB (Q.p + 2 + (2 * (D + 1) * Q.α ^ 2 + 1)) zs ∧
      ‖U - Rperm (Q.sB D) (Q.tB D)
        (dftM (Q.sB D) (fun k => (2 : ℂ)⁻¹ ^ (Q.b + 2) * ubar6 C x k))‖ ≤ Q.Es * hp Q.p ∧
      (c : ℝ) ≤ kIn6 C := by sorry
