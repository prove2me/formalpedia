    · rw [if_neg hw, ha, NumberField.Idele.partAt_snd_of_not_mem K S b hw]
  have hfin : glFin (𝓞 K) K (x * diagOne a) = glFin (𝓞 K) K (x * diagOne (sPartOn S a)) :=
