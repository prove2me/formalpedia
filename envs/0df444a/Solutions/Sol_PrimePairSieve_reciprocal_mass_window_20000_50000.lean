def ordered (a b : Bucket) : Prop :=
  a.lower ≤ a.upper ∧ a.upper < b.lower ∧ b.lower ≤ b.upper
instance : DecidableRel ordered := fun a b =>
  inferInstanceAs (Decidable (a.lower ≤ a.upper ∧ a.upper < b.lower ∧ b.lower ≤ b.upper))
instance : Trans ordered ordered ordered where
  trans := by
    intro a b c hab hbc
    dsimp [ordered] at *
    omega

def separated (a b : Bucket) : Prop := a.upper < b.lower ∨ b.upper < a.lower
instance : Std.Symm separated where
  symm := by intro a b h; exact h.symm

lemma disjoint_of_chain (bs : List Bucket) (h : bs.IsChain ordered) :
    ∀ a ∈ bs.toFinset, ∀ b ∈ bs.toFinset, a ≠ b →
      a.upper < b.lower ∨ b.upper < a.lower := by
  have hp : bs.Pairwise separated := h.pairwise.imp (fun h => Or.inl h.2.1)
  intro a ha b hb hab
  exact hp.forall (List.mem_toFinset.mp ha) (List.mem_toFinset.mp hb) hab
lemma nodup_of_chain (bs : List Bucket) (h : bs.IsChain ordered) : bs.Nodup := by
  change bs.Pairwise (· ≠ ·)
  exact h.pairwise.imp (fun h hab => by subst hab; have := h.1; have := h.2.1; omega)

def finsetOfChain (bs : List Bucket) (h : bs.IsChain ordered) : Finset Bucket :=
  ⟨bs, by simpa using nodup_of_chain bs h⟩

lemma toFinset_eq_finsetOfChain (bs : List Bucket) (h : bs.IsChain ordered) :
    bs.toFinset = finsetOfChain bs h := by
  ext b
  simp [finsetOfChain]
end ReciprocalMassOrdered

