end MazurTorsion.XOneEighteenTwoDivisionArithmetic

end

theorem solution :
Irreducible MazurTorsion.XOneEighteenRealCubicQuotient.cubicPolynomial ∧
  Irreducible MazurTorsion.XOneEighteenTwoDivisionArithmetic.twoDivisionPolynomial := by
  exact ⟨MazurTorsion.XOneEighteenRealCubicQuotient.cubicPolynomial_irreducible, MazurTorsion.XOneEighteenTwoDivisionArithmetic.twoDivisionPolynomial_irreducible⟩

