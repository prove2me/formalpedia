section
-- Source module: Solutions.J6SegILPreJM2
/-!
# B5-J math, part 2: loop forms of the `J`-table quantities

* `sum_flat`: a double sum over `u < n`, `j < m` as one sum over `x < n m` (`x / m`, `x % m`).
* `sum_Hset`: the coupling-offset sum as a sum over `j < 2w + 1` with the test `hc`.
* `TsumI_range`, `TinvI_eq`, `capI_flat`, `ccOf_flat`: the forms the IL loops compute.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Finset

namespace J6Seg

/-- The coupling-offset test of slot `j` (offset `h = j - w`) at position `i`. -/
def hcT (B : Blocks) (i j : ℕ) : Prop :=
  (j : ℤ) - B.w ≠ 0 ∧ ¬ ((B.st i : ℤ) ≤ i + ((j : ℤ) - B.w) ∧ (i : ℤ) + ((j : ℤ) - B.w) < B.st i + B.len i)

instance (B : Blocks) (i j : ℕ) : Decidable (hcT B i j) := by unfold hcT; infer_instance

section tab
variable (P : ℕ) (T : Tables) (B : Blocks)

/-- The index pair used by `TinvI`. -/
def tU (w n u v : ℕ) : ℕ := if max u v + 2 * w + 3 < n then n - 1 - v else u
def tV (w n u v : ℕ) : ℕ := if max u v + 2 * w + 3 < n then n - 1 - u else v

/-- The summand of slot `(u, j)` of row `a`, column `b`. -/
def capG (a b u j : ℕ) : ℤ :=
  if hcT B (B.st a + u) j ∧ col B.s (B.st a + u) ((j : ℤ) - B.w) = b then
    fmul P (MinvI P T B a (B.st a + u)) (T.cpl (B.st a + u) ((j : ℤ) - B.w)) else 0

end tab

end J6Seg

end

