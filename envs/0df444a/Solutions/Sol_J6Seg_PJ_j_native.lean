  have h2 : t ^ (2 * e) ≤ t ^ (7 * e) := Nat.pow_le_pow_right ht (by omega)
  calc r ≤ K * (S + 1) ^ e := hK
    _ ≤ K * (Cs * X) ^ e := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hS e)
    _ = K * Cs ^ e * (p ^ (7 * e) * t ^ (2 * e)) := by
        rw [hX, mul_pow, mul_pow, ← pow_mul, ← pow_mul]; ring
    _ ≤ K * Cs ^ e * (b ^ (7 * e) * (t ^ (7 * e) * p ^ (7 * e))) := by
        apply Nat.mul_le_mul_left
        calc p ^ (7 * e) * t ^ (2 * e) ≤ p ^ (7 * e) * t ^ (7 * e) := Nat.mul_le_mul_left _ h2
          _ = 1 * (t ^ (7 * e) * p ^ (7 * e)) := by ring
          _ ≤ b ^ (7 * e) * (t ^ (7 * e) * p ^ (7 * e)) := Nat.mul_le_mul_right _ h1
    _ = K * Cs ^ e * b ^ (7 * e) * t ^ (7 * e) * p ^ (7 * e) := by ring

