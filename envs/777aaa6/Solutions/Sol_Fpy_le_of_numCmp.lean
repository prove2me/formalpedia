set_option autoImplicit true
open Fpy
open Mpfx
variable {decode : List (Label × Val) → Option RoundCtx} {Φ : Program (fpy decode)}
  {D : FormatDomain} {Γ : AEnv D} {X : Set Var}
namespace Fpy
theorem _root_.solution {s : Bool} {a b : ℝ} (h : numCmp s (.finite a) (.finite b) = true) :
    a ≤ b := by
  cases s
  · simp only [numCmp, cond_false, Num.le, Num.lt, Num.eq, Bool.or_eq_true,
      decide_eq_true_eq] at h
    exact le_iff_lt_or_eq.mpr h
  · simp only [numCmp, cond_true, Num.lt, decide_eq_true_eq] at h
    exact h.le
end Fpy
