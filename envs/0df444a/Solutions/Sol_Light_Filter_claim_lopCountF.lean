  change (numBands p.L p.m p.N : ℝ) * _ * _ ≤ _
  have hR0 : (0 : ℝ) ≤ (retained p.L p.m : ℝ) := Nat.cast_nonneg _
  have hsum : (retained p.L p.m : ℝ) + (p.L : ℝ) * (7 : ℝ) ^ p.L
      ≤ 2 * (p.L : ℝ) * (retained p.L p.m : ℝ) := by
    have : (p.L : ℝ) * (7 : ℝ) ^ p.L ≤ (p.L : ℝ) * (retained p.L p.m : ℝ) :=
