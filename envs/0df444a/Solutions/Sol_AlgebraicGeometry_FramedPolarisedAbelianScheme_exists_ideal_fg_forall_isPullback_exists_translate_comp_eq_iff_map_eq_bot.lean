  obtain ⟨X₁, hX₁⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isPullback_type0 φ₁ X
  have hU₁ : IsUnit (U.map φ₁) := hU.map φ₁.mapMatrix
  obtain ⟨X₁', P₁, -, -, -, hP₁σ⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe X₁ (U.map φ₁) hU₁
  have hJpt₁ : Jpt.map φ₁ = ⊥ := Ideal.map_quotient_self Jpt
  obtain ⟨x₀, hx₀⟩ := (hpt (S ⧸ Jpt) φ₁ X₁ hX₁ P₁ hP₁σ).mpr hJpt₁
  obtain ⟨Jeq, hJeqfg, heq⟩ :=
    AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_ideal_fg_forall_isPullback_translate_comp_eq_iff_map_eq_bot_of_section
      X₁ (U.map φ₁) hU₁ x₀

  obtain ⟨s, hs⟩ := hJeqfg
  obtain ⟨lift, hlift⟩ : ∃ lift : S ⧸ Jpt → S, ∀ a, φ₁ (lift a) = a :=
    ⟨fun a => (Ideal.Quotient.mk_surjective a).choose, fun a => (Ideal.Quotient.mk_surjective a).choose_spec⟩
