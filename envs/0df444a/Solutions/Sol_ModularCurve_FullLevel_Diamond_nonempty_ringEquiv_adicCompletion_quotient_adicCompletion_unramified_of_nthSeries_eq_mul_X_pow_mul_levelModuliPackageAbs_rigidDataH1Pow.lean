    rw [Ideal.mem_comap]
    have h1 : algebraMap (Pz.B₀ ⧸ 𝔭z) ((Pz.B₀ ⧸ 𝔭z) ⊗[Z₀] A₀) (Ideal.Quotient.mk 𝔭z c) = ΘU (algebraMap Pz.B₀ Pu.B₀ c) := by
      show (Ideal.Quotient.mk 𝔭z c) ⊗ₜ[Z₀] (1 : A₀) = mapC (eu.symm (algebraMap Pz.B₀ Pu.B₀ c))
