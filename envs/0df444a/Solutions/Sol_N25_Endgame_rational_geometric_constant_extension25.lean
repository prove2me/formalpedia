import Mathlib
import Definitions.Def_N25_Endgame
import Definitions.Def_ModularCurve_GeometricBaseChange

set_option autoImplicit false

set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

open scoped TensorProduct

namespace N25.Endgame

/-- The actual coefficient embedding is an integral extension generated by constants. -/
theorem _root_.solution :
    letI : Algebra FQ FG := emb25.toRingHom.toAlgebra
    IsScalarTower ℚ FQ FG ∧ Algebra.IsIntegral FQ FG ∧
      Algebra.adjoin FQ (Set.range (algebraMap Qbar FG)) = ⊤ := by
  letI : Algebra FQ FG := emb25.toRingHom.toAlgebra
  letI : Algebra.IsAlgebraic ℚ Qbar := AlgebraicClosure.isAlgebraic ℚ
  have ht : IsScalarTower ℚ FQ FG :=
    IsScalarTower.of_algebraMap_eq (fun a => (emb25.commutes a).symm)
  letI := ht
  have hc (c : Qbar) : IsIntegral FQ (algebraMap Qbar FG c) :=
    ((Algebra.IsIntegral.isIntegral (R := ℚ) c).map
      (IsScalarTower.toAlgHom ℚ Qbar FG)).tower_top
  let S := Algebra.adjoin FQ (Set.range (algebraMap Qbar FG))
  have hall (x : FG) : IsIntegral FQ x ∧ x ∈ S := by
    obtain ⟨t, rfl⟩ := (baseChangeEquiv Qbar FQ).surjective x
    induction t using TensorProduct.induction_on with
    | zero => simpa using (show IsIntegral FQ (0 : FG) ∧ (0 : FG) ∈ S from ⟨isIntegral_zero, S.zero_mem⟩)
    | tmul c f =>
      rw [baseChangeEquiv_tmul]
      change IsIntegral FQ (algebraMap Qbar FG c * algebraMap FQ FG f) ∧
        algebraMap Qbar FG c * algebraMap FQ FG f ∈ S
      exact ⟨(hc c).mul (isIntegral_algebraMap),
        S.mul_mem (Algebra.subset_adjoin ⟨c, rfl⟩) (S.algebraMap_mem f)⟩
    | add x y hx hy =>
      have hadd : baseChangeEquiv Qbar FQ (x + y) =
          baseChangeEquiv Qbar FQ x + baseChangeEquiv Qbar FQ y := by
        apply Subtype.ext
        exact (baseChangeHom Qbar FQ).map_add' x y
      rw [hadd]
      exact ⟨hx.1.add hy.1, S.add_mem hx.2 hy.2⟩
  refine ⟨ht, ⟨fun x => (hall x).1⟩, ?_⟩
  apply top_unique
  intro x _
  exact (hall x).2

end N25.Endgame
