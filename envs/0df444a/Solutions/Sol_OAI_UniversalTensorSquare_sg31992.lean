      seven_kronecker_pos _ (rowDiagram_card [3,1,1,1,1])⟩
  exact Eq.mpr (congrArg (fun α => SquareOccurs α (rowDiagram [3,1,1,1,1])) he) hh

end UniversalTensorSquare
