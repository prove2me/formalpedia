/-!
# L2B_Cut: the class-form Poisson identity on `R` (cut for C2)

For one pair of exterior ideals `(𝔰, 𝔄)`: Weil–Poisson summation on the `S`-integers `R`
(Lemma 3.1), the finite Fourier identity (7.8) and the unfolding of `F_S¹ / U_S⁶` (p. 45), for a
weight pair `(V, M)` coming from one Bruhat–Schwartz function `W₀` as in (7.1): `V` is the
norm-sheet profile of `W₀`, `M` the Mellin transform of the profile `V₀` of `Ŵ₀`, and
`V₀ = mellinInv 2 M`.
-/

namespace ArtinPrimitiveRoots

open NumberField

/-- The class-form Poisson identity of p. 45 (cut for C2). -/
def L2B_PoissonCut (n : ℕ) (_hn0 : 0 < n) (_hn : 12 ∣ n) (F : Type*) [Field F] [NumberField F] [IsCyclotomicExtension {n} ℚ F]
    (ι : F →+* ℂ) : Prop :=
  ∃ N₀ : ℕ, ∀ 𝔪 : Ideal (𝓞 F), 𝔪 ≠ ⊥ → SmallPrimesDvd N₀ 𝔪 →
    ∃ (V : ℝ → ℝ) (M : ℂ → ℂ), IsProbeWeight V ∧ IsMellinWeight M ∧ M (1 / 6) ≠ 0 ∧
      ∀ (g : AllowedGen ι 𝔪) (𝔰 𝔄 : Ideal (𝓞 F)), IsExterior 𝔪 𝔰 → IsExterior 𝔪 𝔄 →
        ∀ X : ℝ, 0 < X →
          HasSum (fun r : RowClass 𝔪 =>
              gaussSumAt g 𝔰 (-((rowElt g r : SInt 𝔪) : F)) * residueSymbol ι 𝔪 𝔄 (rowElt g r) *
                ((V (Ideal.absNorm r.1.1 / (Ideal.absNorm 𝔰 * X)) : ℝ) : ℂ))
            (((X * Ideal.absNorm 𝔰 / Ideal.absNorm 𝔄 : ℝ) : ℂ) *
              ∑' p : FreqClass 𝔪 × {𝔯 : Ideal (𝓞 F) // IsExterior 𝔪 𝔯},
                poissonFactor g 𝔰 𝔄 (freqElt g p.1 * g.gen p.2.1 ^ 6) *
                  mellinInv 2 M (X * (Ideal.absNorm p.1.1.1 * Ideal.absNorm p.2.1 ^ 6) /
                    Ideal.absNorm 𝔄))

/-- The class-form Poisson summation on `R` for a periodic, `U_S⁶`-invariant coefficient `c` of
modulus `𝔫 = νR` (Lemma 3.1 + the unfolding of p. 45), with the weight pair `(V, M)` of (7.1):
`∑_{m ∈ (R∖0)/U_S⁶} c(m) V(q_m/T) = (T/q_𝔫) ∑_{h ∈ (R∖0)/U_S⁶} ĉ(h) V₀(T q_h/q_𝔫)`, where
`ĉ(h) = ∑_{x mod 𝔫} c(x) e(h x/ν)`, `V₀ = mellinInv 2 M`, and `h = u r⁶` runs over
`FreqClass × (exterior 𝔯)` (3.7). -/
def L2B_PoissonCutP (n : ℕ) (_hn0 : 0 < n) (_hn : 12 ∣ n) (F : Type*) [Field F] [NumberField F]
    [IsCyclotomicExtension {n} ℚ F] (ι : F →+* ℂ) : Prop :=
  ∃ N₀ : ℕ, ∀ 𝔪 : Ideal (𝓞 F), 𝔪 ≠ ⊥ → SmallPrimesDvd N₀ 𝔪 →
    ∃ (V : ℝ → ℝ) (M : ℂ → ℂ), IsProbeWeight V ∧ IsMellinWeight M ∧ M (1 / 6) ≠ 0 ∧
      ∀ (g : AllowedGen ι 𝔪) (𝔫 : Ideal (𝓞 F)), IsExterior 𝔪 𝔫 →
        ∀ ν : SInt 𝔪, Ideal.span {ν} = 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪)) →
        ∀ c : SInt 𝔪 → ℂ,
          (∀ x y : SInt 𝔪, y ∈ 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪)) → c (x + y) = c x) →
          (∀ (x : SInt 𝔪) (ε : (SInt 𝔪)ˣ), c ((ε : SInt 𝔪) ^ 6 * x) = c x) →
          ∀ T : ℝ, 0 < T →
            HasSum (fun r : RowClass 𝔪 =>
                c (rowElt g r) * ((V (Ideal.absNorm r.1.1 / T) : ℝ) : ℂ))
              (((T / Ideal.absNorm 𝔫 : ℝ) : ℂ) *
                ∑' p : FreqClass 𝔪 × {𝔯 : Ideal (𝓞 F) // IsExterior 𝔪 𝔯},
                  (∑ᶠ x : SInt 𝔪 ⧸ 𝔫.map (algebraMap (𝓞 F) (SInt 𝔪)),
                    c (quotLift x) * sAddChar 𝔪
                      (((freqElt g p.1 * g.gen p.2.1 ^ 6 : SInt 𝔪) : F) * (quotLift x : F) /
                        (ν : F))) *
                  mellinInv 2 M (T * (Ideal.absNorm p.1.1.1 * Ideal.absNorm p.2.1 ^ 6) /
                    Ideal.absNorm 𝔫))

end ArtinPrimitiveRoots
end

