    2 ^ q.te i = if i < q.dh then 2 ^ (q.e - 1) else 2 ^ q.e := by
  unfold Params.te; split_ifs <;> rfl

theorem te_ge (q : Params) (he : 2 ≤ q.e) (i : ℕ) : 1 ≤ q.te i := by
  unfold Params.te; split_ifs <;> omega

theorem jsum_full (q : Params) (K i k : ℕ) (hK : K = q.K) (hik : i + 1 + k = K - 1) :
    jsum q 0 (K - 1) = jsum q 0 i + (q.te i + jsum q (i + 1) k) := by
  rw [show K - 1 = i + (k + 1) by omega, jsum_add, jsum_succ]; simp

/-- An assignment. -/
theorem spec_asg (M : MulSpec) (i : Fin HS) (e : Ex HS) (s : IState HS) (a : ℤ) (L : List Item)
    (hi : i.val < 56) (hs : s.G i = .int a :: L) (hc : e.Clean) (hok : e.ok s) (B : ℕ)
    (hB : e.Bnd s B) (ha : zsz a ≤ B) (v : ℤ) (hv : e.eval s = v) :
    Spec M (RM.rs (RS.asg i e)) s (s.upd i (.int v :: L)) ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) :=
  spec_rs ⟨hi, hc, hok, IState.isInt_of hs⟩ (by simp [RS.run, hv, hs])
    (by have := RS.asgCost_le i e s B hB (by rw [IState.top_eq hs]; exact ha); simpa [RS.cost] using this)

theorem zle {x B : ℕ} (h : x < 2 ^ B) : zsz (x : ℤ) ≤ B := CR.natCast_lt_pow h

theorem zle' {x B : ℕ} (h : x + 1 ≤ B) : zsz (x : ℤ) ≤ B :=
  CR.natCast_lt_pow (lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_right (by norm_num) (by omega)))

theorem pow_le_pow' {a b : ℕ} (h : a ≤ b) : (2 : ℕ) ^ a ≤ 2 ^ b := Nat.pow_le_pow_right (by norm_num) h

set_option maxHeartbeats 8000000 in
theorem dBody_spec (M : MulSpec) (q : Params) (he : 2 ≤ q.e) (hdh : q.dh < q.K)
    (u : IState HS) (i : ℕ) (hi : i + 1 < q.K) (Lc Lb L47 L48 L49 L51 L54 : List Item)
    (hc : u.G dC = .int ((i : ℤ) + 1) :: Lc)
    (hb : u.G NLogN.ST.dB = .int ((2 ^ jsum q (i + 1) (q.K - 2 - i) : ℕ) : ℤ) :: Lb)
    (h47 : u.G tR = .int ((2 ^ q.e : ℕ) : ℤ) :: L47)
    (h48 : u.G tRh = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L48)
    (h49 : u.G tKd = .int ((q.K - q.dh : ℕ) : ℤ) :: L49)
    (h51 : u.G tLo = .int (q.logOuter : ℤ) :: L51)
    (h54 : u.G tFn = .int (q.fn : ℤ) :: L54) (B : ℕ)
    (hB : 2 * q.fn + q.logOuter + q.e + 2 * q.K + 4 ≤ B) :
    Spec M (dBody q.K) u ((u.upd dO (ints (enc8 (dI q 0 (q.K - 1) i)) ++ u.G dO)).upd NLogN.ST.dB
      (.int ((2 ^ jsum q i (q.K - 1 - i) : ℕ) : ℤ) :: Lb)) (100 * 10 ^ 7 * (B + 2) ^ 2) := by
  set K := q.K with hK
  set t : ℕ := 2 ^ q.te i with ht
  set bs : ℕ := 2 ^ jsum q (i + 1) (K - 2 - i) with hbs
  have hlo := jsum_full q K i (K - 2 - i) hK (by omega)
  rw [← logOuter_eq] at hlo
  have ht2 : 2 ≤ t := by
    have := te_ge q he i
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ t := pow_le_pow' this
  have htv : t = if i < q.dh then 2 ^ (q.e - 1) else 2 ^ q.e := te_pow q (by omega) i
  have htb : t * bs ∣ 2 ^ q.logOuter := by
    rw [hlo, pow_add, pow_add, ht, hbs]; exact Dvd.intro_left _ rfl
  have htb2 : t * bs ≤ 2 ^ q.logOuter := Nat.le_of_dvd (by positivity) htb
  have hpre : 2 ^ q.logOuter / (t * bs) = 2 ^ jsum q 0 i := by
    rw [hlo, pow_add, pow_add, ht, hbs, Nat.mul_div_cancel _ (by positivity)]
  have hte : q.te i ≤ q.e := FW.Prm.te_le q i
  have hlob : q.logOuter + 1 ≤ B := by omega
  have hzt : zsz (t : ℤ) ≤ B := zle (lt_of_le_of_lt (pow_le_pow' hte) (Nat.pow_lt_pow_right (by norm_num) (by omega)))
  have hzbs : zsz (bs : ℤ) ≤ B := zle (lt_of_le_of_lt (le_trans (Nat.le_mul_of_pos_left _ (by omega)) htb2)
    (Nat.pow_lt_pow_right (by norm_num) (by omega)))
  have hztb : zsz ((t * bs : ℕ) : ℤ) ≤ B := zle (lt_of_le_of_lt htb2 (Nat.pow_lt_pow_right (by norm_num) (by omega)))
  -- a: push t
  have tE_ev : (tE K).eval u = (t : ℤ) := by
    simp only [tE, tcE, Ex.eval, IState.top_eq hc, IState.top_eq h49, IState.top_eq h47,
      IState.top_eq h48]
    rw [htv]
    by_cases hid : i < q.dh
    · rw [if_pos hid, if_pos (by push_cast [show q.dh ≤ K by omega]; omega)]
    · rw [if_neg hid, if_neg (by push_cast [show q.dh ≤ K by omega]; omega)]
  have Sa := FW.spec_push_lin M dX (tE K) u (by decide) (CR.clean_of_regs (by
      simp [tE, tcE, Ex.regs]; decide)) (by
      simp only [tE, tcE, Ex.ok]
      refine ⟨⟨⟨IState.isInt_of hc, IState.isInt_of h49⟩, trivial⟩, ?_⟩
      split_ifs
      · exact IState.isInt_of h48
      · exact IState.isInt_of h47) ⟨⟨⟨trivial, trivial⟩, trivial⟩, trivial, trivial⟩ B (by
      simp only [tE, tcE, Ex.Bnd, Ex.eval, IState.top_eq hc, IState.top_eq h49, IState.top_eq h47,
        IState.top_eq h48]
      have hB2 : ((2 * K + 2 : ℕ) : ℤ) < 2 ^ B := by
        have : 2 * K + 2 < 2 ^ B := lt_of_lt_of_le Nat.lt_two_pow_self (pow_le_pow' (by omega))
        exact_mod_cast this
      have z1 : zsz ((i : ℤ) + 1) ≤ B := by
        rw [show (i : ℤ) + 1 = ((i + 1 : ℕ) : ℤ) by push_cast; ring]; exact zle' (by omega)
      have z2 : zsz (((K - q.dh : ℕ) : ℤ)) ≤ B := zle' (by omega)
      have z3 : zsz ((i : ℤ) + 1 + ((K - q.dh : ℕ) : ℤ)) ≤ B := by
        rw [show ((i : ℤ) + 1 + ((K - q.dh : ℕ) : ℤ)) = ((i + 1 + (K - q.dh) : ℕ) : ℤ) by
          push_cast; ring]
        exact zle' (by omega)
      have z4 : zsz (-1 - (K : ℤ)) ≤ B := by
        rw [show (-1 - (K : ℤ)) = -((K + 1 : ℕ) : ℤ) by push_cast; ring, zsz_neg]
        exact zle' (by omega)
      have z5 : zsz ((i : ℤ) + 1 + ((K - q.dh : ℕ) : ℤ) + (-1 - (K : ℤ))) ≤ B := by
        apply CR.zsz_le_of_abs
        have : q.dh ≤ K := by omega
        push_cast [this] at hB2 ⊢
        rw [abs_lt]; constructor <;> omega
      refine ⟨⟨⟨z1, z2, z3⟩, z4, z5⟩, ?_⟩
      split_ifs
      · exact zle (Nat.pow_lt_pow_right (by norm_num) (show q.e - 1 < B by omega))
      · exact zle (Nat.pow_lt_pow_right (by norm_num) (show q.e < B by omega)))
  rw [tE_ev] at Sa
  set u1 := u.upd dX (.int (t : ℤ) :: u.G dX) with hu1
  -- b: the eight pushes
  set pre : ℤ := ((2 ^ jsum q 0 i : ℕ) : ℤ) with hpre'
  set ex : ℤ := 2 ^ (2 * q.fn / t) with hex
  set vals : List ℤ := [pre, (t : ℤ), ex, (bs : ℤ), (bs : ℤ), ex, (t : ℤ), pre] with hvals
  have u1X : u1.G dX = .int (t : ℤ) :: u.G dX := by simp [hu1]
  have u1B : u1.G NLogN.ST.dB = .int (bs : ℤ) :: Lb := by simp (config := {decide := true}) [hu1, hb]
  have u1L : u1.G tLo = .int (q.logOuter : ℤ) :: L51 := by simp (config := {decide := true}) [hu1, h51]
  have u1F : u1.G tFn = .int (q.fn : ℤ) :: L54 := by simp (config := {decide := true}) [hu1, h54]
  have preE_ev : preE.eval u1 = pre := by
    simp only [preE, Ex.eval, IState.top_eq u1X, IState.top_eq u1B, IState.top_eq u1L,
      Int.toNat_natCast, hpre']
    rw [← hpre]; push_cast; rfl
  have expE_ev : expE.eval u1 = ex := by
    simp only [expE, Ex.eval, IState.top_eq u1X, IState.top_eq u1F, hex]
    congr 1
    rw [show (q.fn : ℤ) + q.fn = ((2 * q.fn : ℕ) : ℤ) by push_cast; ring]
    rw [show ((2 * q.fn : ℕ) : ℤ) / (t : ℤ) = ((2 * q.fn / t : ℕ) : ℤ) by push_cast; rfl,
      Int.toNat_natCast]
  have hEx : 2 * q.fn / t + 1 ≤ B := by
    have : 2 * q.fn / t ≤ q.fn := Nat.div_le_of_le_mul (Nat.mul_le_mul_right q.fn ht2)
    omega
  have preE_ok : preE.ok u1 ∧ preE.Bnd u1 B := by
    simp only [preE, Ex.ok, Ex.Bnd, Ex.eval, IState.top_eq u1X, IState.top_eq u1B,
      IState.top_eq u1L, Int.toNat_natCast]
    refine ⟨⟨⟨IState.isInt_of u1L, by positivity⟩, ⟨IState.isInt_of u1X, IState.isInt_of u1B⟩,
      by positivity, by positivity⟩, ⟨⟨zle' (by omega), by omega⟩,
      ⟨hzt, hzbs, by exact_mod_cast hztb⟩, ?_⟩⟩
    rw [show ((2 : ℤ) ^ q.logOuter) / ((t : ℤ) * (bs : ℤ)) = ((2 ^ q.logOuter / (t * bs) : ℕ) : ℤ) by
      push_cast; rfl, hpre]
    exact zle (Nat.pow_lt_pow_right (by norm_num) (show jsum q 0 i < B by omega))
  have expE_ok : expE.ok u1 ∧ expE.Bnd u1 B := by
    have e2 : ((q.fn : ℤ) + q.fn) / (t : ℤ) = ((2 * q.fn / t : ℕ) : ℤ) := by
      rw [show (q.fn : ℤ) + q.fn = ((2 * q.fn : ℕ) : ℤ) by push_cast; ring]; rfl
    simp only [expE, Ex.ok, Ex.Bnd, Ex.eval, IState.top_eq u1X, IState.top_eq u1F, e2,
      Int.toNat_natCast]
    refine ⟨⟨⟨⟨IState.isInt_of u1F, IState.isInt_of u1F⟩, IState.isInt_of u1X, by positivity,
      by positivity⟩, by positivity⟩, ⟨⟨⟨zle' (by omega), zle' (by omega), ?_⟩, hzt, zle' hEx⟩, hEx⟩⟩
    rw [show (q.fn : ℤ) + q.fn = ((2 * q.fn : ℕ) : ℤ) by push_cast; ring]; exact zle' (by omega)
  have hvs : dPush.map Prod.fst = (vals.map fun v => (dO, v)).map Prod.fst := by simp [dPush, hvals]
  have PO := EX.pushOK_of B u1 dPush [] (vals.map fun v => (dO, v)) hvs (by decide) (by
      intro x hx
      simp only [dPush, List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact ⟨by decide, CR.clean_of_regs (by simp [preE, Ex.regs]; decide), preE_ok⟩
      · exact ⟨by decide, FW.clean_reg (by decide), IState.isInt_of u1X, hzt.trans' (by simp [IState.top_eq u1X])⟩
      · exact ⟨by decide, CR.clean_of_regs (by simp [expE, Ex.regs]; decide), expE_ok⟩
      · exact ⟨by decide, FW.clean_reg (by decide), IState.isInt_of u1B, hzbs.trans' (by simp [IState.top_eq u1B])⟩
      · exact ⟨by decide, FW.clean_reg (by decide), IState.isInt_of u1B, hzbs.trans' (by simp [IState.top_eq u1B])⟩
      · exact ⟨by decide, CR.clean_of_regs (by simp [expE, Ex.regs]; decide), expE_ok⟩
      · exact ⟨by decide, FW.clean_reg (by decide), IState.isInt_of u1X, hzt.trans' (by simp [IState.top_eq u1X])⟩
      · exact ⟨by decide, CR.clean_of_regs (by simp [preE, Ex.regs]; decide), preE_ok⟩) (by
      simp only [dPush, hvals, List.map_cons, List.map_nil, List.forall₂_cons, preE_ev, expE_ev,
        Ex.eval, IState.top_eq u1X, IState.top_eq u1B, List.Forall₂.nil, and_true])
  obtain ⟨rb, ob, cb⟩ := EX.pushes_all B dPush _ u1 PO
  rw [show EX.pushV u1 [] = u1 from rfl] at PO
  rw [pushV_one] at rb
  have hrev : vals.reverse = vals := by simp [hvals]
  rw [hrev] at rb
  have Sb : Spec M (RM.rs (EX.pushes dPush)) u1 (u1.upd dO (ints vals ++ u1.G dO))
      (EX.pwt dPush * 10 ^ 7 * (B + 2) ^ 2 + 1) := ⟨ob, rb, cb⟩
  set u2 := u1.upd dO (ints vals ++ u1.G dO) with hu2
  -- c: bs := bs * t
  have u2X : u2.G dX = .int (t : ℤ) :: u.G dX := by simp (config := {decide := true}) [hu2, hu1]
  have u2B : u2.G NLogN.ST.dB = .int (bs : ℤ) :: Lb := by simp (config := {decide := true}) [hu2, hu1, hb]
  have Sc := spec_asg M NLogN.ST.dB (.mul (.reg NLogN.ST.dB) (.reg dX)) u2 _ Lb (by decide) u2B
    (CR.clean_of_regs (by simp [Ex.regs]; decide)) ⟨IState.isInt_of u2B, IState.isInt_of u2X⟩ B
    ⟨hzbs.trans' (by simp [IState.top_eq u2B]), hzt.trans' (by simp [IState.top_eq u2X]), by
      simp only [Ex.eval, IState.top_eq u2B, IState.top_eq u2X]
      rw [show (bs : ℤ) * t = ((t * bs : ℕ) : ℤ) by push_cast; ring]; exact hztb⟩ hzbs
    ((2 ^ jsum q i (K - 1 - i) : ℕ) : ℤ) (by
      simp only [Ex.eval, IState.top_eq u2B, IState.top_eq u2X]
      rw [show K - 1 - i = (K - 2 - i) + 1 by omega, jsum_succ, pow_add, hbs, ht]
      push_cast; ring)
  set u3 := u2.upd NLogN.ST.dB (.int ((2 ^ jsum q i (K - 1 - i) : ℕ) : ℤ) :: Lb) with hu3
  -- d: pop t
  have Sd := FW.spec_pop M dX u3 (t : ℤ) (u.G dX) (by decide)
    (by simp (config := {decide := true}) [hu3, hu2, hu1]) B hzt
  have A := Sa.seq (Sb.seq (Sc.seq Sd))
  refine (A.congr ?_).mono ?_
  · have he8 : ints (enc8 (dI q 0 (K - 1) i)) = ints vals := by
      simp only [enc8, dI, hvals, Nat.sub_zero, hpre', hex, ht, hbs]
      rw [show 0 + (K - 1) - (i + 1) = K - 2 - i by omega]
      push_cast; rfl
    rw [he8]
    apply IState.ext' _ (by simp [hu3, hu2, hu1]) (by simp [hu3, hu2, hu1])
    intro j
    simp only [hu3, hu2, hu1, IState.upd_G]
    split_ifs <;> simp_all (config := {decide := true})
  · have : EX.pwt dPush = 36 := by decide
    rw [this]
    simp only [tE, tcE, Ex.size]
    generalize hX : (B + 2) ^ 2 = X
    have h1 : B + 2 ≤ X := by rw [← hX]; nlinarith
    omega

end NLogN.ST

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.ST
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
open NLogN.FW (Spec Desc descs enc8)
set_option maxHeartbeats 4000000
theorem solution (M : NLogN.MulSpec) (q : Params) (he : 2 ≤ q.e) (hdh : q.dh < q.K)
    (w : NLogN.IState NLogN.HS) (L47 L48 L49 L51 L54 : List NLogN.Item)
    (h47 : w.G NLogN.ST.tR = .int ((2 ^ q.e : ℕ) : ℤ) :: L47)
    (h48 : w.G NLogN.ST.tRh = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L48)
    (h49 : w.G NLogN.ST.tKd = .int ((q.K - q.dh : ℕ) : ℤ) :: L49)
    (h51 : w.G NLogN.ST.tLo = .int (q.logOuter : ℤ) :: L51)
    (h54 : w.G NLogN.ST.tFn = .int (q.fn : ℤ) :: L54) (B : ℕ)
    (hB : 2 * q.fn + q.logOuter + q.e + 2 * q.K + 4 ≤ B) :
    NLogN.FW.Spec M (NLogN.ST.descLoop q.K) w (w.upd NLogN.ST.dO (NLogN.ints ((NLogN.FW.descs q.outerAxes 1).flatMap NLogN.FW.enc8) ++ w.G NLogN.ST.dO))
      ((q.K + 1) * 10 ^ 10 * (B + 2) ^ 2) := by
  set K := q.K with hK
  have hK1 : 1 ≤ K := by omega
  set s1 := w.upd NLogN.ST.dB (.int 1 :: w.G NLogN.ST.dB) with hs1
  have S1 := NLogN.FW.spec_push_lin M NLogN.ST.dB (.lit 1) w (by decide) (by intro i hi; simp [NLogN.Ex.regs] at hi)
    trivial trivial B
    (by simp [NLogN.Ex.Bnd]; exact NLogN.ST.zle' (show 1 + 1 ≤ B by omega))
  simp only [NLogN.Ex.eval] at S1
  let fl : ℕ → List ℤ := fun k => ((List.range' (K - 1 - k) k).map (NLogN.ST.dI q 0 (K - 1))).flatMap NLogN.FW.enc8
  let DS : ℕ → NLogN.IState HS := fun k =>
    (s1.upd NLogN.ST.dO (NLogN.ints (fl k) ++ w.G NLogN.ST.dO)).upd NLogN.ST.dB (.int ((2 ^ NLogN.ST.jsum q (K - 1 - k) k : ℕ) : ℤ) :: w.G NLogN.ST.dB)
  have hDS0 : DS 0 = s1 := by
    apply NLogN.IState.ext' _ (by simp [DS]) (by simp [DS])
    intro j; simp only [DS, fl, NLogN.IState.upd_G, hs1, List.range'_zero, List.map_nil, List.flatMap_nil,
      NLogN.ints_nil, List.nil_append, NLogN.ST.jsum_zero, pow_zero]
    split_ifs <;> simp_all
  have H := NLogN.FW.rep_spec (M := M) (i := NLogN.ST.dC) (n := .lit ((K : ℤ) - 1)) (b := NLogN.ST.dBody K) (s := s1)
    DS (K - 1) (by simp [NLogN.Ex.eval]; omega) (by simp [NLogN.ST.dBody, NLogN.RM.seqL, NLogN.RM.writes, NLogN.RS.writes, NLogN.EX.pushes, NLogN.ST.dPush]; decide) hDS0
    (fun k => by simp (config := {decide := true}) [DS, hs1]) (by decide)
    (by intro i hi; simp [NLogN.Ex.regs] at hi) trivial trivial B
    (by
      simp only [NLogN.Ex.Bnd]
      rw [show (K : ℤ) - 1 = ((K - 1 : ℕ) : ℤ) by omega]; exact NLogN.ST.zle' (by omega))
    (100 * 10 ^ 7 * (B + 2) ^ 2) (by
      intro k hk
      set i := K - 2 - k with hi
      have hi1 : i + 1 < K := by omega
      have hcv : ((K - 1 : ℕ) : ℤ) - (k : ℤ) = (i : ℤ) + 1 := by omega
      have S := NLogN.ST.dBody_spec M q he hdh (NLogN.withCtr NLogN.ST.dC s1 (K - 1) k (DS k)) i hi1 (s1.G NLogN.ST.dC) (w.G NLogN.ST.dB)
        L47 L48 L49 L51 L54
        (by simp (config := {decide := true}) [NLogN.withCtr, hcv])
        (by simp (config := {decide := true}) [NLogN.withCtr, DS]
            rw [show i + 1 = K - 1 - k by omega, show K - 2 - i = k by omega])
        (by simp (config := {decide := true}) [NLogN.withCtr, DS, hs1, h47])
        (by simp (config := {decide := true}) [NLogN.withCtr, DS, hs1, h48])
        (by simp (config := {decide := true}) [NLogN.withCtr, DS, hs1, h49]; rfl)
        (by simp (config := {decide := true}) [NLogN.withCtr, DS, hs1, h51])
        (by simp (config := {decide := true}) [NLogN.withCtr, DS, hs1, h54]) B hB
      refine S.congr ?_
      have e1 : K - 1 - (k + 1) = i := by omega
      have e2 : K - 1 - i = k + 1 := by omega
      have hfl : fl (k + 1) = NLogN.FW.enc8 (NLogN.ST.dI q 0 (K - 1) i) ++ fl k := by
        simp only [fl]
        rw [e1, show k + 1 = k + 1 from rfl, List.range'_succ, show i + 1 = K - 1 - k by omega]
        simp
      apply NLogN.IState.ext' _ (by simp [NLogN.withCtr, DS]) (by simp [NLogN.withCtr, DS])
      intro j
      simp only [NLogN.withCtr, DS, NLogN.IState.upd_G, hfl, e1, e2, NLogN.ints_append, List.append_assoc]
      split_ifs <;> simp_all (config := {decide := true}))
  have hDN : (DS (K - 1)).G NLogN.ST.dB = .int ((2 ^ q.logOuter : ℕ) : ℤ) :: w.G dB := by
    simp (config := {decide := true}) [DS, NLogN.ST.logOuter_eq]; rfl
  have S3 := NLogN.FW.spec_pop M NLogN.ST.dB (DS (K - 1)) _ (w.G NLogN.ST.dB) (by decide) hDN B
    (NLogN.ST.zle (Nat.pow_lt_pow_right (by norm_num) (show q.logOuter < B by omega)))
  have A := S1.seq (H.seq S3)
  refine (A.congr ?_).mono ?_
  · have hfl : fl (K - 1) = (NLogN.FW.descs q.outerAxes 1).flatMap enc8 := by
      simp only [fl, NLogN.ST.descs_outer, Nat.sub_self]; rfl
    apply NLogN.IState.ext' _ (by simp [DS, hs1]) (by simp [DS, hs1])
    intro j
    simp only [DS, hs1, NLogN.IState.upd_G, hfl]
    split_ifs <;> simp_all (config := {decide := true})
  · simp only [NLogN.Ex.size]
    generalize hX : (B + 2) ^ 2 = X
    have h1 : B + 2 ≤ X := by rw [← hX]; nlinarith
    have h2 : (K - 1) * (100 * 10 ^ 7 * X + 8000 * (B + 2) + 30) ≤ K * (101 * 10 ^ 7 * X) := by
      have : 100 * 10 ^ 7 * X + 8000 * (B + 2) + 30 ≤ 101 * 10 ^ 7 * X := by omega
      exact Nat.mul_le_mul (by omega) this
    have h3 : (K + 1) * 10 ^ 10 * X = K * (10 ^ 10 * X) + 10 ^ 10 * X := by ring
    have h4 : K * (101 * 10 ^ 7 * X) ≤ K * (10 ^ 10 * X) := Nat.mul_le_mul_left _ (by omega)
    omega
end
