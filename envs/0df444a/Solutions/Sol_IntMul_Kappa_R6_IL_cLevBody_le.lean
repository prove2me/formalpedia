variable {W T m : ℕ}

theorem rebuild_le (v Bb : ℕ) :
    cRebuildF (T + W) ((T + W) * v) Bb ≤ ((T + W) * (2 * (T + W) + 2) + 202) * uU W T v Bb := by
  unfold cRebuildF
  apply Nat.mul_le_mul_left
  have := cCF_le ((T + W) * v) Bb
  unfold uU
  omega

theorem instrHC_le (hW : 1 ≤ W) (v Bb : ℕ) (cC : ℕ × ℕ × ℕ → ℕ)
    (i : Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m) :
    instrHC (fun e => cEdgeR m e v Bb cC) ((T + W) * v) Bb i ≤
      iK W T i * uU W T v Bb + ((i.edgeOf.toList.flatMap fun e => e.runs).map cC).sum := by
  cases i with
  | gate g S =>
    have h1 : instrHC (fun e => cEdgeR m e v Bb cC) ((T + W) * v) Bb (.gate g S) =
        cRebuildF (T + W) ((T + W) * v) Bb := rfl
    have h2 : iK W T (.gate g S : Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m) =
        (T + W) * (2 * (T + W) + 2) + 202 := rfl
    have h3 : (((Bit.Instr.gate g S : Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m).edgeOf.toList.flatMap
        fun e => e.runs).map cC).sum = 0 := rfl
    rw [h1, h2, h3, Nat.add_zero]
    exact rebuild_le v Bb
  | edge x e =>
    simp only [instrHC, iK, Bit.Instr.edgeOf, Option.toList_some, List.flatMap_cons,
      List.flatMap_nil, List.append_nil, cEdgeR]
    have h1 := cStepsUF_le rXs v 1 Bb (tplE e.E₂)
    have h2 := cStepsUF_le rXs v 1 Bb (tplE e.E₁)
    set t1 := tKFs rXs (tplE e.E₁)
    set t2 := tKFs rXs (tplE e.E₂)
    set Y := (Bb + 2) ^ 2 with hY
    have hB : Bb + 2 ≤ Y := Nat.le_self_pow (by norm_num) _
    have hvX : v ≤ (T + W) * v := Nat.le_mul_of_pos_left _ (by omega)
    have hz : 10 ^ 13 * ((v + 1) * (1 + 2)) + 10 ^ 10 * Y ≤ uU W T v Bb := by
      unfold uU; rw [← hY]; omega
    have h3 := Nat.mul_le_mul_left t1 hz
    have h4 := Nat.mul_le_mul_left t2 hz
    have h5 : 2 * cOF ((T + W) * v) Bb + cPushT Bb + (2 * Bb + 2) + 3 ≤ uU W T v Bb := by
      unfold cOF cPushT uU; rw [← hY]; omega
    have e1 : (t1 + t2 + 1) * uU W T v Bb = t1 * uU W T v Bb + t2 * uU W T v Bb + uU W T v Bb := by
      ring
    rw [e1]
    omega

theorem progHC_le (hW : 1 ≤ W) (v Bb : ℕ) (cC : ℕ × ℕ × ℕ → ℕ) :
    ∀ prog : List (Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m),
      (prog.map (instrHC (fun e => cEdgeR m e v Bb cC) ((T + W) * v) Bb)).sum ≤
        (prog.map (iK W T)).sum * uU W T v Bb +
          (((Bit.progEdges prog).flatMap fun e => e.runs).map cC).sum
  | [] => by simp [Bit.progEdges]
  | i :: l => by
    have h1 := instrHC_le hW v Bb cC i
    have h2 := progHC_le hW v Bb cC l
    simp only [List.map_cons, List.sum_cons, Bit.progEdges_cons, List.flatMap_append,
      List.map_append, List.sum_append]
    have e1 : (iK W T i + (l.map (iK W T)).sum) * uU W T v Bb =
        iK W T i * uU W T v Bb + (l.map (iK W T)).sum * uU W T v Bb := Nat.add_mul _ _ _
    omega

/-- **The level cost bound.** -/
theorem cLevBody_le_sol_aux [NeZero W] (C : Bit.QHNet (ZMod 2) W T m) (P L' h v Bb : ℕ)
    (cC : ℕ × ℕ × ℕ → ℕ) (hP : 1 ≤ P) (hL : 1 ≤ L') (hh : 1 ≤ h) (hv : P * L' * h = v) :
    cLevBody C P L' h v Bb cC ≤ levB C v Bb + ((runsL C).map cC).sum := by
  have hW : 1 ≤ W := NeZero.pos W
  have hn := progHC_le hW v Bb cC C.prog
  have hr := rebuild_le (W := W) (T := T) v Bb
  have hPL : 1 ≤ P * L' := Nat.mul_pos hP hL
  have hb := KFC.cBwdF_le 1 W (P * L') h 1 hh hPL hW le_rfl
  have hf := KFC.cFwdF_le 1 W (P * L') h 1 hh hPL hW le_rfl
  have ek : KFC.kap 1 = 276 := rfl
  have eV : 1 * W * (P * L') * h = W * v := by rw [← hv]; ring
  rw [ek, eV] at hb hf
  set U := uU W T v Bb with hU
  set Y := (Bb + 2) ^ 2 with hY
  have hUa : 10 ^ 14 * ((T + W) * v + 1) + 10 ^ 11 * Y = U := by rw [hU, hY]; rfl
  have hB : Bb + 2 ≤ Y := Nat.le_self_pow (by norm_num) _
  have hWv0 : W * v ≤ (T + W) * v := Nat.mul_le_mul_right _ (by omega)
  have hTv0 : T * v ≤ (T + W) * v := Nat.mul_le_mul_right _ (by omega)
  have hWv : W * v ≤ U := by omega
  have hb' : (2 * W + 69) * 276 * (W * v) ≤ (2 * W + 69) * 276 * U := Nat.mul_le_mul_left _ hWv
  have hf' : (2 * W + 67) * 276 * (W * v) ≤ (2 * W + 69) * 276 * U :=
    le_trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by omega))) hb'
  have hs : cSplit W Bb ≤ (pushSz (splitL W) + 1) * U := by
    unfold cSplit; rw [pushCost_eq, ← hY]
    have h1 : pushSz (splitL W) * 10 ^ 7 * Y ≤ pushSz (splitL W) * U := by
      rw [Nat.mul_assoc]; apply Nat.mul_le_mul_left; omega
    have h2 : 4 * (2 * Bb + 2) + 1 + 1 ≤ U := by omega
    have e3 : (pushSz (splitL W) + 1) * U = pushSz (splitL W) * U + U := by ring
    rw [e3]; omega
  have hl1 : cLp (T * v) 8000 Bb ≤ U := by unfold cLp; omega
  have hl2 : cLp (T * v) (2 * 1 + 2) Bb ≤ U := by unfold cLp; omega
  have hrun : ((Bit.progEdges C.prog).flatMap fun e => e.runs) = runsL C := rfl
  rw [hrun] at hn
  unfold cLevBody levB KL
  set K0 := (C.prog.map (iK W T)).sum
  set G := (T + W) * (2 * (T + W) + 2)
  set ps := pushSz (splitL W)
  set R := ((runsL C).map cC).sum
  have e1 : (K0 + G + 2 * (2 * W + 69) * 276 + 2 * ps + 1000) * U =
      K0 * U + (G + 202) * U + (2 * W + 69) * 276 * U + (2 * W + 69) * 276 * U +
        (ps + 1) * U + (ps + 1) * U + 796 * U := by ring
  rw [e1]
  have hU1 : 1 ≤ U := by unfold uU at hU; omega
  omega

end

