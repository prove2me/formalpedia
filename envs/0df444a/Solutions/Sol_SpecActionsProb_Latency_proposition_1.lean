theorem proposition_1 {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (k : ℕ) (α β p : ℝ) (hβ : 0 < β) (hβα : β < α) (hp0 : 0 < p) (hp1 : p ≤ 1)
    (X : Idx k → Ω → ℝ) (hX : IsSpecModel P k α β p X) :
    let pk : ℝ := 1 - (1 - p) ^ k
    (∀ T : ℕ, 1 ≤ T →
      (∫ ω, specRuntime X T ω ∂P) / (∫ ω, seqRuntime X T ω ∂P)
        = 1 - 1 / (T : ℝ) * (α / (α + β)) *
            (((T : ℝ) - 1) * pk / (1 + pk) + pk ^ 2 / (1 + pk) ^ 2
              - pk ^ 2 / (1 + pk) ^ 2 * (-pk) ^ (T - 1))) ∧
    Filter.Tendsto (fun T : ℕ => (∫ ω, specRuntime X T ω ∂P) / (∫ ω, seqRuntime X T ω ∂P))
      Filter.atTop (nhds (1 - pk / (1 + pk) * (α / (α + β)))) := by
  intro pk
  have hα : 0 < α := by linarith
  have hpk0 : 0 ≤ pk := by
    have : (1 - p) ^ k ≤ 1 := pow_le_one₀ (by linarith) (by linarith)
    simp only [pk]; linarith
  have hpk1 : pk ≤ 1 := by
    have : 0 ≤ (1 - p) ^ k := pow_nonneg (by linarith) _
    simp only [pk]; linarith
  have hb : β ≠ 0 := hβ.ne'
  have hab : α + β ≠ 0 := by linarith
  have h1q : 1 + pk ≠ 0 := by linarith
  have hspec : ∀ T : ℕ, ∫ ω, specRuntime X T ω ∂P =
      (T : ℝ) / β - α / (β * (α + β)) * SpecActions.hits pk (T - 1) := fun T =>
    ((intRun hX hα hβ hp0 hp1 T 0).1.2 : _)
  have hseq : ∀ T : ℕ, ∫ ω, seqRuntime X T ω ∂P = (T : ℝ) / β := by
    intro T
    unfold seqRuntime
    rw [integral_finsetSum _ (fun t _ => (intB hX hβ t).1)]
    simp only [(intB hX hβ _).2, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    ring
  have formula : ∀ T : ℕ, 1 ≤ T →
      (∫ ω, specRuntime X T ω ∂P) / (∫ ω, seqRuntime X T ω ∂P)
        = 1 - 1 / (T : ℝ) * (α / (α + β)) *
            (((T : ℝ) - 1) * pk / (1 + pk) + pk ^ 2 / (1 + pk) ^ 2
              - pk ^ 2 / (1 + pk) ^ 2 * (-pk) ^ (T - 1)) := by
    intro T hT
    rw [hspec, hseq, (hits_closed pk hpk0 (T - 1)).1]
    simp only [SpecActions.hitsClosed]
    have hT' : (T : ℝ) ≠ 0 := by positivity
    rw [Nat.cast_sub hT]
    push_cast
    field_simp
    ring
  refine ⟨formula, ?_⟩
  set a := α / (α + β)
  set C := pk ^ 2 / (1 + pk) ^ 2
  set D := C - pk / (1 + pk)
  have hu : Filter.Tendsto (fun T : ℕ => 1 / (T : ℝ) * (-pk) ^ (T - 1)) Filter.atTop (nhds 0) := by
    apply squeeze_zero_norm (a := fun T : ℕ => 1 / (T : ℝ)) _ tendsto_one_div_atTop_nhds_zero_nat
    intro T
    rw [norm_mul, norm_pow, Real.norm_eq_abs, Real.norm_eq_abs, abs_neg, abs_of_nonneg hpk0,
      abs_of_nonneg (by positivity)]
    calc 1 / (T : ℝ) * pk ^ (T - 1) ≤ 1 / (T : ℝ) * 1 :=
          mul_le_mul_of_nonneg_left (pow_le_one₀ hpk0 hpk1) (by positivity)
      _ = 1 / (T : ℝ) := mul_one _
  have hg : Filter.Tendsto (fun T : ℕ => 1 - a * (pk / (1 + pk)) - a * ((1 / (T : ℝ)) * D
      - C * (1 / (T : ℝ) * (-pk) ^ (T - 1)))) Filter.atTop
      (nhds (1 - a * (pk / (1 + pk)) - a * (0 * D - C * 0))) :=
    tendsto_const_nhds.sub (tendsto_const_nhds.mul
      ((tendsto_one_div_atTop_nhds_zero_nat.mul tendsto_const_nhds).sub
        (tendsto_const_nhds.mul hu)))
  have hL : 1 - a * (pk / (1 + pk)) - a * (0 * D - C * 0) = 1 - pk / (1 + pk) * a := by ring
  rw [hL] at hg
  refine hg.congr' ?_
  filter_upwards [Filter.eventually_ge_atTop 1] with T hT
  rw [formula T hT]
  have hT' : (T : ℝ) ≠ 0 := by positivity
  simp only [D, C]
  field_simp
  ring

end SpecActionsProb.Latency


-- Platform entry point: restates the target verbatim.
namespace SpecActionsProb.Latency

open MeasureTheory ProbabilityTheory

/-- Proposition 1, p. 5: exact finite horizon ratio and its limit for the random runtimes. -/
theorem _root_.solution {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (k : ℕ) (α β p : ℝ) (hβ : 0 < β) (hβα : β < α) (hp0 : 0 < p) (hp1 : p ≤ 1)
    (X : Idx k → Ω → ℝ) (hX : IsSpecModel P k α β p X) :
    let pk : ℝ := 1 - (1 - p) ^ k
    (∀ T : ℕ, 1 ≤ T →
      (∫ ω, specRuntime X T ω ∂P) / (∫ ω, seqRuntime X T ω ∂P)
        = 1 - 1 / (T : ℝ) * (α / (α + β)) *
            (((T : ℝ) - 1) * pk / (1 + pk) + pk ^ 2 / (1 + pk) ^ 2
              - pk ^ 2 / (1 + pk) ^ 2 * (-pk) ^ (T - 1))) ∧
    Filter.Tendsto (fun T : ℕ => (∫ ω, specRuntime X T ω ∂P) / (∫ ω, seqRuntime X T ω ∂P))
      Filter.atTop (nhds (1 - pk / (1 + pk) * (α / (α + β)))) := by
  apply @SpecActionsProb.Latency.proposition_1 <;> assumption

end SpecActionsProb.Latency
