variable {ι k : Type*} [Field k]
variable [Finite ι]

theorem GlobalTheory.idealHilbertPoly_sup_of_isPrime {P : Ideal (MvPolynomial ι k)} [hP : P.IsPrime]
    (hI : P.IsHomogeneous (homogeneousSubmodule ι k)) {f : MvPolynomial ι k} {d : ℕ}
    (hf : f.IsHomogeneous d) (hfP : f ∉ P) :
    idealHilbertPoly (P ⊔ Ideal.span {f}) = idealHilbertPoly P -
      (idealHilbertPoly P).comp (Polynomial.X - Polynomial.C (d : ℚ)) := by sorry
