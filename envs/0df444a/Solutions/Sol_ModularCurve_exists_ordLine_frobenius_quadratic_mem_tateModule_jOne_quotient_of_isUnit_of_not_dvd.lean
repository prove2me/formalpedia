  intro Λ hΛ a d hau ha hd W _ _ hW r π hπ hπσ hπT P hP
  haveI : FiniteDimensional K W := Module.finite_of_finrank_eq_succ hW
  have hp : p.Prime := Fact.out

  let RK : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →*
      Module.End K (K ⊗[ℤ_[p]] TateModule p (JOne M)) :=
    { toFun := fun σ =>
        (TateModule.rep p (JOne M) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ).baseChange K
      map_one' := by rw [map_one, LinearMap.baseChange_one]
      map_mul' := fun σ τ => by rw [map_mul, LinearMap.baseChange_mul] }
  have hRK : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
      (x : K ⊗[ℤ_[p]] TateModule p (JOne M)), π (RK σ x) = r σ (π x) := fun σ x => hπσ σ x
  have hr_mul : ∀ (g g' : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (w : W),
