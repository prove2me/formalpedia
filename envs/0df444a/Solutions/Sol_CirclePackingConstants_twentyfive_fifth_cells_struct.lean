    ∀ e : Fin 5 × Fin 4, |(p e.1 e.2.succ).1 - (p e.1 e.2.castSucc).1| < 4 * K := by
  obtain ⟨hx0, hx4, -, -⟩ := walls p hc
  have a_0_0 : 1/4 - ((p 1 0).1 - (p 0 0).1) < K := hα 0 0
  have a_0_1 : 1/4 - ((p 1 1).1 - (p 0 1).1) < K := hα 0 1
