import Mathlib
import Definitions.Def_Applications_WallpaperRhythm_SymmetryGroup

/-!
# Symmetry groups of periodic rhythms (the 1-dimensional theory)

A (monophonic) *rhythm* is a Boolean onset function on the integer time-line,
`f : ℤ → Bool`, where `f n = true` means "there is an onset at time `n`".

Musically, the most basic symmetry of a rhythm is a **time translation**: a shift
`t` that maps the rhythm onto itself.  The set of all such shifts is the
`symGroup` of the rhythm.  This file develops its structure theory:

* `symGroup f` is an additive subgroup of `ℤ` (`symGroup`).
* Membership is exactly periodicity: `p ∈ symGroup f ↔ Function.Periodic f p`.
* Every symmetry group is cyclic — generated by a single shift
  (`exists_generator`).  This is the algebraic reason a rhythm has a
  *fundamental period* that all other periods are multiples of.
* `exists_fundamental` / `fundamental_period`: a periodic rhythm has a smallest
  positive period `d`, and a shift `q` is a period **iff** `d ∣ q`.  This is the
  classical "the fundamental period divides every period" theorem.

These are the genuine mathematical facts underlying the informal slogan that the
symmetry group of a period-`p` rhythm is a subgroup of `ℤ/pℤ`.
-/

open WallpaperRhythm

open AddSubgroup Function




/-- A shift is a symmetry exactly when it is a period of the rhythm. -/
lemma periodic_iff_mem {f : Rhythm} {p : ℤ} :
    Function.Periodic f p ↔ p ∈ symGroup f := Iff.rfl

/-- **Every symmetry group is cyclic**: it is generated by a single shift `d`.
Consequently the period structure of a rhythm is completely governed by one
number, its fundamental period. -/
theorem exists_generator (f : Rhythm) :
    ∃ d : ℤ, symGroup f = zmultiples d := by
  obtain ⟨d, hd⟩ := Int.subgroup_cyclic (symGroup f)
  exact ⟨d, by rw [hd, zmultiples_eq_closure]⟩

/-- **The periods of a rhythm are exactly the multiples of a fixed integer `d`.**
This is the abstract form of the fundamental-period theorem. -/
theorem exists_fundamental (f : Rhythm) :
    ∃ d : ℤ, ∀ q : ℤ, Function.Periodic f q ↔ d ∣ q := by
  obtain ⟨d, hd⟩ := exists_generator f
  refine ⟨d, fun q => ?_⟩
  rw [periodic_iff_mem, hd, Int.mem_zmultiples_iff]



/-! ## Classification of the symmetry types of a period-`p` rhythm

The possible translation-symmetry groups of a rhythm are exactly the subgroups
`zmultiples d` of `ℤ`.  For a rhythm of period `p`, these are precisely the
divisor lattices `zmultiples d` with `d ∣ p`.  Moreover **every** such lattice is
realised by an actual rhythm, so the symmetry types of period-`p` rhythms are in
bijection with the positive divisors of `p` (the honest 1-D analogue of the
wallpaper-group classification: `τ(p)` types, not a fixed `17`). -/






open WallpaperRhythm in
theorem solution{f : Rhythm} {p : ℤ} (hp : 0 < p)
    (hper : Function.Periodic f p) :
    ∃ d : ℤ, 0 < d ∧ (∀ q : ℤ, Function.Periodic f q ↔ d ∣ q) ∧
      (∀ q : ℤ, 0 < q → Function.Periodic f q → d ≤ q) := by
  obtain ⟨d, hd⟩ := exists_fundamental f
  -- `d ≠ 0` because `p` is a nonzero period.
  have hdp : d ∣ p := (hd p).mp hper
  have hd0 : d ≠ 0 := by
    rintro rfl
    simp only [zero_dvd_iff] at hdp
    omega
  refine ⟨|d|, abs_pos.mpr hd0, fun q => ?_, ?_⟩
  · rw [hd q, abs_dvd]
  · intro q hq hqper
    have : |d| ∣ q := by rw [abs_dvd]; exact (hd q).mp hqper
    exact Int.le_of_dvd hq this
