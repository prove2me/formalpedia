private theorem exists_slice_iteratedDeriv_bound_c {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ)
    (hK : IsArchKFiniteAt F w φ) {τ : ℝ} (hτ : 0 ≤ τ)
    (hc₁ : Continuous fun r : ℂˣ => ((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℂˣ => ((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ))
    (hs₁ : ∀ r : ℂˣ, ‖((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ τ)
    (hs₂ : ∀ r : ℂˣ, ‖((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ (-τ))
    (E : ℝ → ℝ → AdeleRing (𝓞 F) F)
    (hEw : ∀ θ t : ℝ, (E θ t).1 w
      = (ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I)))
    (hEv : ∀ (θ t : ℝ) (v : InfinitePlace F), v ≠ w → (E θ t).1 v = 0)
    (hE2 : ∀ θ t : ℝ, (E θ t).2 = 0) :
    ∃ (m : ℕ) (kv : Fin m → AdelicGL2 (𝓞 F) F), (∀ i, kv i ∈ archRowIsometrySubgroup F w) ∧
      ∀ S : Set (AdelicGL2 (𝓞 F) F), IsCompact S → ∀ n : ℕ, ∃ C : ℝ, 0 ≤ C ∧
        ∀ x ∈ S, ∀ (a : AdeleRing (𝓞 F) F) (θ t : ℝ),
          ‖iteratedDeriv n (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)) t‖
            ≤ C * max 1 ‖(a + E θ t).1 w‖ ^ (-(2 * τ))
                * ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖ := by

  obtain ⟨N₁, kv₁, A₁, B₁, C₁, D₁, E₁, hkv₁, hsm₁, hcb₁, hpen₁⟩ := exists_expansion_penta hw hφc hK
  have hφ'c : Continuous fun y => φ (y * rhoCW hw (-(Real.pi / 2))) := hφc.comp (continuous_mul_const _)
  have hK' : IsArchKFiniteAt F w fun y => φ (y * rhoCW hw (-(Real.pi / 2))) :=
    rightTranslatesSpanFinite_mul hK (rhoCW_mem hw (-(Real.pi / 2)))
  obtain ⟨N₂, kv₂, A₂, B₂, C₂, D₂, E₂, hkv₂, hsm₂, hcb₂, hpen₂⟩ := exists_expansion_penta hw hφ'c hK'
  refine ⟨N₁ + N₂, Fin.append kv₁ (fun i => kv₂ i * rhoCW hw (-(Real.pi / 2))), ?_, fun S hS n => ?_⟩
  · intro i
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · simp only [Fin.append_left]
