section Slot

variable {K ρ n L : ℕ}

/-- Updating the `n` segments of a slot `y < 2^L` (`ρ + n K ≤ L`) by `δ_s` without carries. -/
theorem slot_add_sol_aux (hK : 1 ≤ K) (hL : ρ + n * K ≤ L) {y : ℕ} (hy : y < 2 ^ L) (δ : ℕ → ℤ)
    (h : ∀ s < n, 0 ≤ (seg K ρ s y : ℤ) + δ s ∧ (seg K ρ s y : ℤ) + δ s < 2 ^ K) :
    ∃ y' : ℕ, (y' : ℤ) = y + ∑ s ∈ range n, δ s * ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) ∧ y' < 2 ^ L ∧
      y' % 2 ^ ρ = y % 2 ^ ρ ∧ (∀ s < n, (seg K ρ s y' : ℤ) = seg K ρ s y + δ s) ∧
      y' / 2 ^ ρ / (2 ^ K) ^ n = y / 2 ^ ρ / (2 ^ K) ^ n := by
  obtain ⟨z, e1, e2, e3⟩ := digits_add (2 ^ K) (by positivity) n (y / 2 ^ ρ) δ (by
    intro s hs; have := h s hs; unfold seg at this; push_cast at this ⊢; exact this)
  have hr := Nat.mod_lt y (show 0 < 2 ^ ρ by positivity)
  refine ⟨y % 2 ^ ρ + 2 ^ ρ * z, ?_, ?_, ?_, ?_, ?_⟩
  · have hy' : (y : ℤ) = ((y % 2 ^ ρ : ℕ) : ℤ) + ((2 ^ ρ : ℕ) : ℤ) * ((y / 2 ^ ρ : ℕ) : ℤ) := by
      exact_mod_cast (Nat.mod_add_div y (2 ^ ρ)).symm
    have hS : ((2 ^ ρ : ℕ) : ℤ) * ∑ s ∈ range n, δ s * ((2 ^ K : ℕ) : ℤ) ^ s =
        ∑ s ∈ range n, δ s * ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) := by
      rw [mul_sum]; exact sum_congr rfl fun s _ => by push_cast; ring
    rw [Nat.cast_add, Nat.cast_mul, e1, hy', ← hS]; ring
  · -- bound
    have hz := lt_of_hi (W := 2 ^ K) (n := n) (x := z) (by positivity)
    rw [e3] at hz
    have hq : y / 2 ^ ρ / (2 ^ K) ^ n < 2 ^ (L - ρ - n * K) := by
      rw [Nat.div_div_eq_div_mul, Nat.div_lt_iff_lt_mul (by positivity), ← pow_mul, ← pow_add,
        ← pow_add]
      calc y < 2 ^ L := hy
        _ = 2 ^ (L - ρ - n * K + (ρ + K * n)) := by congr 1; rw [mul_comm K n]; omega
    have hz' : z < 2 ^ (L - ρ) := by
      have h1 : (2 ^ K) ^ n * (y / 2 ^ ρ / (2 ^ K) ^ n + 1) ≤ (2 ^ K) ^ n * 2 ^ (L - ρ - n * K) :=
        Nat.mul_le_mul_left _ hq
      have h2 : (2 ^ K) ^ n * 2 ^ (L - ρ - n * K) = 2 ^ (L - ρ) := by
        rw [← pow_mul, ← pow_add]; congr 1; rw [mul_comm K n]; omega
      omega
    have : 2 ^ ρ * z + 2 ^ ρ ≤ 2 ^ L := by
      have h3 : 2 ^ ρ * (z + 1) ≤ 2 ^ ρ * 2 ^ (L - ρ) := Nat.mul_le_mul_left _ hz'
      rw [← pow_add, show ρ + (L - ρ) = L by omega] at h3; linarith
    omega
  · rw [Nat.add_mul_mod_self_left, Nat.mod_mod]
  · intro s hs
    have hdiv : (y % 2 ^ ρ + 2 ^ ρ * z) / 2 ^ ρ = z := by
      rw [Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt hr, zero_add]
    unfold seg; rw [hdiv]; exact e2 s hs
  · have hdiv : (y % 2 ^ ρ + 2 ^ ρ * z) / 2 ^ ρ = z := by
      rw [Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt hr, zero_add]
    rw [hdiv, e3]

end Slot

