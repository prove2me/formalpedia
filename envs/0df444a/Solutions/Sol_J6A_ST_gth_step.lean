theorem free_top {s0 : IState HS} {G : Fin HS → List ℤ} {i : Fin HS} (hf : Free i) {a : ℤ}
    {l : List ℤ} (hG : G i = a :: l) (x13 x14 x15 x30 x31 x32 x33 x43 x44 : List ℤ) :
    (encK s0 (bS G x13 x14 x15 x30 x31 x32 x33 x43 x44)).top i = a ∧
      (encK s0 (bS G x13 x14 x15 x30 x31 x32 x33 x43 x44)).IsInt i := by
