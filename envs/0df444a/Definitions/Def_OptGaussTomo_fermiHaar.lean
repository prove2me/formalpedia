-- title:
--   The compact group of fermionic Gaussian unitaries and its Haar probability measure
-- statement:
--   The fermionic Gaussian unitaries on $m$ modes form a compact subgroup $\mathcal U_m$ of the unitary group of $(\mathbb C^2)^{\otimes m}$. Its normalized Haar measure $dU$ (total mass $1$) is the source of all randomness in the paper's fermionic constructions: the paper's integrals $\int_{SO(2m)}\cdots dR$ over the Haar probability measure, and the unique probability measures $d\phi$ on the even and odd pure Gaussian states $\mathcal G^\pm_m$ that are invariant under Gaussian unitaries, are the integrals over $\mathcal U_m$ and the push-forwards of $dU$ under $U\mapsto U\psi^\pm$.
--
--   **Formalization Note** The group is defined as the topological closure of the subgroup generated by the Gaussian unitaries; since that set is already a closed subgroup, this is the same set. Compactness of the unitary group is proved in the file. Gaussian unitaries are determined by $R\in SO(2m)$ up to a phase, and every integrand of the mission is phase invariant, so integration over $\mathcal U_m$ reproduces the paper's integrals over $SO(2m)$.
-- source:
--   Chen, Fanizza, Girardi, Lami, Mele, Walter, Witteveen, Optimal tomography of bosonic and fermionic Gaussian states, arXiv:2607.11847 (held version, sha256 0f7548a2a5cfd55079e5d7f1787c97c8561a818a53d7e29824715104bad416ed), §C.1 p.33 (pdf p.33); Corollary 4.1 p.11

import Mathlib
import Definitions.Def_OptGaussTomo_IsFermiGaussUnitary

open FermiCap.Gaussian (Qubits Op)
open MeasureTheory

noncomputable section

namespace OptGaussTomo

/-!
# The compact group of fermionic Gaussian unitaries and its normalized Haar measure

Chen, Fanizza, Girardi, Lami, Mele, Walter, Witteveen, *Optimal tomography of bosonic and
fermionic Gaussian states*, arXiv:2607.11847 (held version, sha256 0f7548a2…), §C.1, p.33:
"Every pure Gaussian state can then be expressed as `U_R|ψ⁺_m⟩` or `U_R|ψ⁻_m⟩` for some Gaussian
unitary `U_R`. The Haar measure on SO(2m) then defines unique probability measures that are
invariant under Gaussian unitaries on `G⁺_m` and `G⁻_m`; we denote both by `dϕ`." Corollary 4.1,
p.11: `∫_{SO(2m)} … dR`.

`fermiGaussGroup m` is the group of fermionic Gaussian unitaries on `m` modes, as a subgroup of
the unitary group of `ℓ²(Qubits m)`, and `fermiHaar m` is its normalized Haar measure.

**Formalization Note.** The set of Gaussian unitaries (`IsFermiGaussUnitary`) is already a closed
subgroup of the unitary group (products and inverses of solutions of (C.1) solve (C.1) with
products and inverses of the `R`'s; limits of solutions solve it with a limit `R`, since `SO(2m)`
is compact). The definition takes the topological closure of the subgroup it generates, which is
therefore the same set, and gets the subgroup structure without restating these facts. It is
compact (closed in the compact unitary group, proved below), so its Haar measure normalized to
total mass `1` exists. Gaussian unitaries are determined by `R ∈ SO(2m)` up to a phase, and every
integrand in this mission is phase invariant, so integrating over this group with `fermiHaar m`
gives the source's integrals over `SO(2m)` with its Haar probability measure, and the push-forward
of `fermiHaar m` under `U ↦ U ψ^±` gives the invariant probability measures `dϕ` on `G^±_m`.
-/

/-- The unitary group of a finite-dimensional matrix algebra is compact. -/
theorem isCompact_unitaryGroup (n : Type) [Fintype n] [DecidableEq n] :
    IsCompact (Matrix.unitaryGroup n ℂ : Set (Matrix n n ℂ)) := by
  have hsub : (Matrix.unitaryGroup n ℂ : Set (Matrix n n ℂ)) ⊆
      Set.pi Set.univ (fun _ : n => Set.pi Set.univ (fun _ : n => Metric.closedBall (0 : ℂ) 1)) := by
    intro U hU i _ j _
    simpa using entry_norm_bound_of_unitary hU i j
  exact IsCompact.of_isClosed_subset
    (isCompact_univ_pi fun _ => isCompact_univ_pi fun _ => isCompact_closedBall 0 1)
    (isClosed_unitary) hsub

instance (n : Type) [Fintype n] [DecidableEq n] : CompactSpace (Matrix.unitaryGroup n ℂ) :=
  isCompact_iff_compactSpace.mp (isCompact_unitaryGroup n)

/-- The group of `m`-mode fermionic Gaussian unitaries. -/
def fermiGaussGroup (m : ℕ) : Subgroup (Matrix.unitaryGroup (Qubits m) ℂ) :=
  (Subgroup.closure {U : Matrix.unitaryGroup (Qubits m) ℂ |
    IsFermiGaussUnitary (U : Op m)}).topologicalClosure

instance (m : ℕ) : CompactSpace (fermiGaussGroup m) :=
  isCompact_iff_compactSpace.mp
    (Subgroup.isClosed_topologicalClosure _).isCompact

instance (m : ℕ) : MeasurableSpace (fermiGaussGroup m) := borel _

instance (m : ℕ) : BorelSpace (fermiGaussGroup m) := ⟨rfl⟩

/-- The Haar probability measure on the group of fermionic Gaussian unitaries. -/
noncomputable def fermiHaar (m : ℕ) : Measure (fermiGaussGroup m) :=
  Measure.haarMeasure ⊤

end OptGaussTomo


