lemma truncR_neg' (p : ℕ) (x : ℝ) : Butterfly.truncR p (-x) = -Butterfly.truncR p x := by
  unfold Butterfly.truncR Butterfly.truncNum
  rcases lt_trichotomy x 0 with h | h | h
  · rw [if_pos (by linarith), if_neg (by linarith), neg_mul, Int.floor_neg]; push_cast; ring
  · subst h; simp
  · rw [if_neg (by linarith), if_pos h.le, neg_mul, Int.ceil_neg]; push_cast; ring

lemma Qp_conj (p : ℕ) (z : ℂ) : Butterfly.Qp p (starRingEnd ℂ z) = starRingEnd ℂ (Butterfly.Qp p z) := by
  apply Complex.ext <;> simp [Butterfly.Qp, truncR_neg']

lemma QA_cnj (p : ℕ) (f : ι → ℂ) : QA p (cnj f) = cnj (QA p f) := by
