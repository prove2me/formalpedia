-- title:
--   Definitions for Sufficiency in quantum statistical inference
-- statement:
--   The objects the formalized statements of *Sufficiency in quantum statistical inference* (arXiv:math-ph/0412093) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `SameNullSets`: PDF p.4: equality of the common null sets of a family and a reference measure.
--   - `SufficientSigmaAlgebra`: PDF p.4, (2): one conditional-probability version for every family member. The [0,1] bound is almost everywhere under each probability; nonnegative Lebesgue integrals have no nonintegrability default.
--   - `MinimalSufficientSigmaAlgebra`: PDF pp.5,21: minimality in the statistical sense, modulo all common null sets. The comparison uses one measurable set B simultaneously for every theta.
--   - `IsMarkovOperator`: PDF pp.3–4: a Markov operator, specified on the real self-adjoint part of L-infinity. Positivity and unitality give its unique complex-linear extension. The last clause is the source's sequential normality f_n decreasing to zero. All order statements are on equivalence classes, expressed almost everywhere.
--   - `PreservesExperiment`: PDF p.4: one normal Markov map preserves all experiment expectations. Explicit integrability makes each pairing independent of Bochner defaults.
--   - `StochasticallyEquivalent`: PDF pp.4–5: stochastic equivalence is randomization in both directions. Probability references with the family's common null sets can be chosen by Lemma 1; the operators are chosen before theta. Distinct measurable structures on the same underlying set are supported by the explicit space arguments.
--   - `StatisticSigma`: PDF pp.20–21: sigma-algebra generated by the entire finite statistic.
--   - `ExponentialDensity`: PDF p.20: h is outside the exponential, and Z is the normalizing constant.
--   - `HasExponentialRepresentation`: PDF p.21: finite exponential representation on the common support. The reference measure is equivalent to every member here, so h is strictly positive almost everywhere. Partition functions are actual finite positive integrals, and the density identity is only an almost-everywhere identity.
--   - `LogDensityClass`: PDF p.21: logarithmic density as a class modulo the common reference null sets. Uses are guarded by strictly positive densities almost everywhere.
--   - `IsCStarCoarseGraining`: PDF p.3: unital complex-linear 2-positive observable maps between unital C-star algebras. Normality is required only for von Neumann coarse-grainings; Lemma 5 is a C-star result and imposes no von Neumann hypothesis.
--   - `MultiplicativeDomain`: PDF pp.11–12, (13), with the adjoint-order typo corrected according to the proof: both equalities are Schwarz equalities in their proper order.
--   - `MarginalAB`: PDF p.24: AB marginal of a density on A tensor (B tensor C), in countable orthonormal coordinates. Trace class guarantees convergence of the series.
--   - `IsTraceClassCoarseGraining`: PDF pp.3–4: the normal-predual orientation of a coarse-graining. Complex linearity is required on trace class. Preservation of normalized positive trace-class matrices and of their 2 by 2 amplifications expresses trace preservation and 2-positivity, without complete positivity. Its bounded trace-class action has a normal unital 2-positive Heisenberg adjoint.
--   - `SufficientTraceClassMap`: PDF pp.5,11: sufficiency in the normal-predual picture. The family may include nonfaithful normalized states. One reverse coarse-graining, selected before theta, recovers every member of the family.
--   - `SsaFamily`: PDF p.24: the two actual states used to interpret equality in SSA.
-- source:
--   Sufficiency in quantum statistical inference, arXiv:math-ph/0412093v1, https://arxiv.org/abs/math-ph/0412093v1

import Mathlib
import Definitions.Def_QAlgorithms_Papers_Independent_Claimed50_P06
import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P33
import Definitions.Def_QAlgorithms_Papers_Independent_Frontier18_P01

/-!
Jenčová–Petz, arXiv:math-ph/0412093v1. PDF page numbers are used throughout.
Only pinned accepted modules are imported. All new definitions are paper-local.
The quantum normal-state interface is used in standard form, without a
finite-dimensional restriction. Classical randomizations act on L-infinity
classes, not on pointwise stochastic kernels. Compilation is pending.
-/

noncomputable section

open MeasureTheory Filter
open scoped ENNReal BigOperators

namespace QAlgorithms.Papers.Independent.Next46.P43

open QAlgorithms.Papers.Independent.Dependency50.P33
  (IsTraceClass IsDensity State tensorApply productCoeff)
open QAlgorithms.Papers.Independent.Frontier18.P01
  (homogeneousEntropy generalizedRelativeEntropy traceFirst traceSecond)

/-- PDF p.4: equality of the common null sets of a family and a reference measure. -/
def SameNullSets {X Theta : Type*} [MeasurableSpace X]
    (mu : Measure X) (P : Theta → Measure X) : Prop :=
  ∀ A, MeasurableSet A → (mu A = 0 ↔ ∀ theta, P theta A = 0)

example {X : Type*} [MeasurableSpace X] (mu : Measure X) :
    SameNullSets mu (fun _ : Unit => mu) := by
  intro A hA
  simp

/-- PDF p.4, (2): one conditional-probability version for every family member.
The [0,1] bound is almost everywhere under each probability; nonnegative
Lebesgue integrals have no nonintegrability default. -/
def SufficientSigmaAlgebra {X Theta : Type*} [m : MeasurableSpace X]
    (P : Theta → Measure X) (m0 : MeasurableSpace X) : Prop :=
  letI : MeasurableSpace X := m
  m0 ≤ m ∧ ∀ A, MeasurableSet A →
    ∃ f : X → ℝ≥0∞, @Measurable X ℝ≥0∞ m0 _ f ∧
      ∀ theta, (∀ᵐ x ∂P theta, f x ≤ 1) ∧
        ∀ B, @MeasurableSet X m0 B →
          (∫⁻ x in B, f x ∂P theta) = P theta (A ∩ B)

example {X Theta : Type*} [m : MeasurableSpace X]
    (P : Theta → Measure X) : SufficientSigmaAlgebra P m := by
  classical
  refine ⟨le_rfl, ?_⟩
  intro A hA
  refine ⟨A.indicator (fun _ => 1), measurable_const.indicator hA, ?_⟩
  intro theta
  refine ⟨Filter.Eventually.of_forall (fun x => ?_), ?_⟩
  · by_cases hx : x ∈ A <;> simp [hx]
  · intro B hB
    rw [lintegral_indicator hA, lintegral_one, Measure.restrict_apply_univ,
      Measure.restrict_apply hA]

/-- PDF pp.5,21: minimality in the statistical sense, modulo all common null
sets. The comparison uses one measurable set B simultaneously for every theta. -/
def MinimalSufficientSigmaAlgebra {X Theta : Type*} [m : MeasurableSpace X]
    (P : Theta → Measure X) (m0 : MeasurableSpace X) : Prop :=
  letI : MeasurableSpace X := m
  @SufficientSigmaAlgebra X Theta m P m0 ∧
    ∀ m1, @SufficientSigmaAlgebra X Theta m P m1 →
      ∀ A, @MeasurableSet X m0 A →
        ∃ B, @MeasurableSet X m1 B ∧
          ∀ theta, ∀ᵐ x ∂P theta, (x ∈ A ↔ x ∈ B)

example {X Theta : Type*} [MeasurableSpace X] (P : Theta → Measure X)
    (h : SufficientSigmaAlgebra P ⊥) : MinimalSufficientSigmaAlgebra P ⊥ := by
  refine ⟨h, ?_⟩
  intro m1 h1 A hA
  refine ⟨A, (show (⊥ : MeasurableSpace X) ≤ m1 from bot_le) A hA, ?_⟩
  intro theta
  exact Filter.Eventually.of_forall (fun x => Iff.rfl)

/-- PDF pp.3–4: a Markov operator, specified on the real self-adjoint part of
L-infinity. Positivity and unitality give its unique complex-linear extension.
The last clause is the source's sequential normality f_n decreasing to zero.
All order statements are on equivalence classes, expressed almost everywhere. -/
def IsMarkovOperator {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (mu : Measure X) (nu : Measure Y)
    (F : Lp ℝ ∞ nu →ₗ[ℝ] Lp ℝ ∞ mu) : Prop :=
  (∀ f, (∀ᵐ y ∂nu, 0 ≤ f y) → ∀ᵐ x ∂mu, 0 ≤ F f x) ∧
  (∀ f, (∀ᵐ y ∂nu, f y = 1) → ∀ᵐ x ∂mu, F f x = 1) ∧
  (∀ f : ℕ → Lp ℝ ∞ nu,
    (∀ n, ∀ᵐ y ∂nu, f (n + 1) y ≤ f n y) →
    (∀ᵐ y ∂nu, Tendsto (fun n => f n y) atTop (nhds 0)) →
    ∀ᵐ x ∂mu, Tendsto (fun n => F (f n) x) atTop (nhds 0))

example {X : Type*} [MeasurableSpace X] (mu : Measure X) :
    IsMarkovOperator mu mu (LinearMap.id : Lp ℝ ∞ mu →ₗ[ℝ] Lp ℝ ∞ mu) := by
  refine ⟨?_, ?_, ?_⟩
  · intro f hf
    exact hf
  · intro f hf
    exact hf
  · intro f hdec hlim
    exact hlim

/-- PDF p.4: one normal Markov map preserves all experiment expectations.
Explicit integrability makes each pairing independent of Bochner defaults. -/
def PreservesExperiment {X Y Theta : Type*}
    [MeasurableSpace X] [MeasurableSpace Y]
    (mu : Measure X) (nu : Measure Y)
    (P : Theta → Measure X) (Q : Theta → Measure Y)
    (F : Lp ℝ ∞ nu →ₗ[ℝ] Lp ℝ ∞ mu) : Prop :=
  ∀ theta f, Integrable (fun y => f y) (Q theta) ∧
    Integrable (fun x => F f x) (P theta) ∧
    (∫ x, F f x ∂P theta) = ∫ y, f y ∂Q theta

example {X Theta : Type*} [MeasurableSpace X] (mu : Measure X)
    [IsProbabilityMeasure mu] :
    PreservesExperiment mu mu (fun _ : Theta => mu) (fun _ : Theta => mu)
      (LinearMap.id : Lp ℝ ∞ mu →ₗ[ℝ] Lp ℝ ∞ mu) := by
  intro theta f
  have hf : Integrable (fun x => f x) mu := MemLp.integrable le_top (Lp.memLp f)
  exact ⟨hf, hf, rfl⟩

/-- PDF pp.4–5: stochastic equivalence is randomization in both directions.
Probability references with the family's common null sets can be chosen by
Lemma 1; the operators are chosen before theta. Distinct measurable structures
on the same underlying set are supported by the explicit space arguments. -/
def StochasticallyEquivalent {X Y Theta : Type*}
    (mX : MeasurableSpace X) (mY : MeasurableSpace Y)
    (P : Theta → @Measure X mX) (Q : Theta → @Measure Y mY) : Prop :=
  letI : MeasurableSpace X := mX
  letI : MeasurableSpace Y := mY
  ∃ (mu : Measure X) (nu : Measure Y),
    IsProbabilityMeasure mu ∧ IsProbabilityMeasure nu ∧
    SameNullSets mu P ∧ SameNullSets nu Q ∧
    ∃ (F : Lp ℝ ∞ nu →ₗ[ℝ] Lp ℝ ∞ mu)
      (G : Lp ℝ ∞ mu →ₗ[ℝ] Lp ℝ ∞ nu),
      IsMarkovOperator mu nu F ∧ IsMarkovOperator nu mu G ∧
      PreservesExperiment mu nu P Q F ∧ PreservesExperiment nu mu Q P G

example {X Theta : Type*} [m : MeasurableSpace X] [Nonempty Theta]
    (mu : Measure X) [IsProbabilityMeasure mu]
    (hMarkov : IsMarkovOperator mu mu
      (LinearMap.id : Lp ℝ ∞ mu →ₗ[ℝ] Lp ℝ ∞ mu)) :
    StochasticallyEquivalent m m (fun _ : Theta => mu) (fun _ : Theta => mu) := by
  have hNull : SameNullSets mu (fun _ : Theta => mu) := by
    intro A hA
    constructor
    · intro h theta
      exact h
    · intro h
      exact h (Classical.choice inferInstance)
  have hPres : PreservesExperiment mu mu (fun _ : Theta => mu) (fun _ : Theta => mu)
      (LinearMap.id : Lp ℝ ∞ mu →ₗ[ℝ] Lp ℝ ∞ mu) := by
    intro theta f
    have hf : Integrable (fun x => f x) mu := MemLp.integrable le_top (Lp.memLp f)
    exact ⟨hf, hf, rfl⟩
  exact ⟨mu, mu, inferInstance, inferInstance, hNull, hNull,
    LinearMap.id, LinearMap.id, hMarkov, hMarkov, hPres, hPres⟩

/-- PDF pp.20–21: sigma-algebra generated by the entire finite statistic. -/
def StatisticSigma {X : Type*} {n : ℕ} (T : Fin n → X → ℝ) : MeasurableSpace X :=
  ⨆ i, MeasurableSpace.comap (T i) (borel ℝ)

example {X : Type*} (T : Fin 0 → X → ℝ) : StatisticSigma T = ⊥ := by
  simp [StatisticSigma]

/-- PDF p.20: h is outside the exponential, and Z is the normalizing constant. -/
def ExponentialDensity {X Theta : Type*} {n : ℕ}
    (T : Fin n → X → ℝ) (xi : Theta → Fin n → ℝ)
    (h : X → ℝ) (Z : Theta → ℝ) (theta : Theta) (x : X) : ℝ :=
  Real.exp (∑ i, xi theta i * T i x) * h x / Z theta

example {X Theta : Type*} (T : Fin 0 → X → ℝ)
    (xi : Theta → Fin 0 → ℝ) (theta : Theta) (x : X) :
    ExponentialDensity T xi (fun _ => 1) (fun _ => 1) theta x = 1 := by
  simp [ExponentialDensity]

/-- PDF p.21: finite exponential representation on the common support.
The reference measure is equivalent to every member here, so h is strictly
positive almost everywhere. Partition functions are actual finite positive
integrals, and the density identity is only an almost-everywhere identity. -/
def HasExponentialRepresentation {X Theta : Type*} [MeasurableSpace X]
    (mu : Measure X) (r : Theta → X → ℝ) : Prop :=
  ∃ (n : ℕ) (T : Fin n → X → ℝ) (xi : Theta → Fin n → ℝ)
    (h : X → ℝ) (Z : Theta → ℝ),
    (∀ i, Measurable (T i)) ∧ Measurable h ∧ (∀ᵐ x ∂mu, 0 < h x) ∧
    (∀ theta, Integrable (fun x => Real.exp (∑ i, xi theta i * T i x) * h x) mu ∧
      Z theta = (∫ x, Real.exp (∑ i, xi theta i * T i x) * h x ∂mu) ∧
      0 < Z theta) ∧
    ∀ theta, r theta =ᵐ[mu] ExponentialDensity T xi h Z theta

example {X Theta : Type*} [MeasurableSpace X] (mu : Measure X)
    (h : X → ℝ) (hh : Measurable h) (hPos : ∀ᵐ x ∂mu, 0 < h x)
    (hInt : Integrable h mu) (hNorm : (∫ x, h x ∂mu) = 1) :
    HasExponentialRepresentation mu (fun _ : Theta => h) := by
  refine ⟨0, (fun i => Fin.elim0 i), (fun _ i => Fin.elim0 i), h,
    (fun _ => 1), ?_, hh, hPos, ?_, ?_⟩
  · intro i
    exact Fin.elim0 i
  · intro theta
    refine ⟨?_, ?_, zero_lt_one⟩
    · simpa using hInt
    · simpa using hNorm.symm
  · intro theta
    exact Filter.Eventually.of_forall (fun x => by simp [ExponentialDensity])

/-- PDF p.21: logarithmic density as a class modulo the common reference null
sets. Uses are guarded by strictly positive densities almost everywhere. -/
def LogDensityClass {X : Type*} [MeasurableSpace X]
    (mu : Measure X) (r : X → ℝ) (hr : Measurable r) : X →ₘ[mu] ℝ :=
  AEEqFun.mk (fun x => Real.log (r x)) hr.log.aestronglyMeasurable

example {X : Type*} [MeasurableSpace X] (mu : Measure X) :
    LogDensityClass mu (fun _ : X => 1) measurable_const = 0 := by
  simp only [LogDensityClass, Real.log_one, AEEqFun.zero_def]

/-- PDF p.3: unital complex-linear 2-positive observable maps between unital
C-star algebras. Normality is required only for von Neumann coarse-grainings;
Lemma 5 is a C-star result and imposes no von Neumann hypothesis. -/
def IsCStarCoarseGraining {N M : Type*} [CStarAlgebra N] [CStarAlgebra M]
    [PartialOrder N] [PartialOrder M] [StarOrderedRing N] [StarOrderedRing M]
    (sigma : N →ₗ[ℂ] M) : Prop :=
  sigma 1 = 1 ∧ ∀ X : CStarMatrix (Fin 2) (Fin 2) N,
    0 ≤ X → 0 ≤ X.map sigma

/-- PDF pp.11–12, (13), with the adjoint-order typo corrected according to the
proof: both equalities are Schwarz equalities in their proper order. -/
def MultiplicativeDomain {N M : Type*} [CStarAlgebra N] [CStarAlgebra M]
    (sigma : N →ₗ[ℂ] M) : Set N :=
  {a | sigma (star a * a) = star (sigma a) * sigma a ∧
    sigma (a * star a) = sigma a * star (sigma a)}

example {N : Type*} [CStarAlgebra N] [PartialOrder N] [StarOrderedRing N] :
    IsCStarCoarseGraining (LinearMap.id : N →ₗ[ℂ] N) := by
  refine ⟨rfl, ?_⟩
  intro X hX
  change 0 ≤ X.map id
  simpa only [CStarMatrix.map_id] using hX

example {N : Type*} [CStarAlgebra N] :
    MultiplicativeDomain (LinearMap.id : N →ₗ[ℂ] N) = Set.univ := by
  ext a
  simp [MultiplicativeDomain]

/-- PDF p.24: AB marginal of a density on A tensor (B tensor C), in countable
orthonormal coordinates. Trace class guarantees convergence of the series. -/
def MarginalAB {I J K : Type} (D : Matrix (I × (J × K)) (I × (J × K)) ℂ) :
    Matrix (I × J) (I × J) ℂ :=
  fun p q => ∑' c : K, D (p.1, (p.2, c)) (q.1, (q.2, c))

example {I J K : Type} : MarginalAB (0 : Matrix (I × (J × K)) (I × (J × K)) ℂ) = 0 := by
  ext p q
  simp [MarginalAB]

/-- PDF pp.3–4: the normal-predual orientation of a coarse-graining.
Complex linearity is required on trace class. Preservation of normalized
positive trace-class matrices and of their 2 by 2 amplifications expresses
trace preservation and 2-positivity, without complete positivity. Its bounded
trace-class action has a normal unital 2-positive Heisenberg adjoint. -/
def IsTraceClassCoarseGraining {I J : Type}
    (Phi : Matrix I I ℂ → Matrix J J ℂ) : Prop :=
  (∀ X, IsTraceClass X → IsTraceClass (Phi X)) ∧
  (∀ X Y, IsTraceClass X → IsTraceClass Y → Phi (X + Y) = Phi X + Phi Y) ∧
  (∀ (c : ℂ) X, IsTraceClass X → Phi (c • X) = c • Phi X) ∧
  (∀ rho : State (I × Fin 1), IsDensity (tensorApply Phi rho.coefficients)) ∧
  (∀ rho : State (I × Fin 2), IsDensity (tensorApply Phi rho.coefficients))

example {I : Type} :
    IsTraceClassCoarseGraining (id : Matrix I I ℂ → Matrix I I ℂ) := by
  refine ⟨(fun X hX => hX), (fun X Y hX hY => rfl),
    (fun c X hX => rfl), ?_, ?_⟩
  · intro rho
    exact rho.density
  · intro rho
    exact rho.density

/-- PDF pp.5,11: sufficiency in the normal-predual picture. The family may
include nonfaithful normalized states. One reverse coarse-graining, selected
before theta, recovers every member of the family. -/
def SufficientTraceClassMap {I J Theta : Type}
    (Phi : Matrix I I ℂ → Matrix J J ℂ) (D : Theta → Matrix I I ℂ) : Prop :=
  IsTraceClassCoarseGraining Phi ∧
    ∃ R : Matrix J J ℂ → Matrix I I ℂ,
      IsTraceClassCoarseGraining R ∧ ∀ theta, R (Phi (D theta)) = D theta

example {I Theta : Type} (D : Theta → Matrix I I ℂ)
    (hId : IsTraceClassCoarseGraining (id : Matrix I I ℂ → Matrix I I ℂ)) :
    SufficientTraceClassMap id D := by
  exact ⟨hId, id, hId, fun _ => rfl⟩

/-- PDF p.24: the two actual states used to interpret equality in SSA. -/
def SsaFamily {I J K : Type}
    (D : Matrix (I × (J × K)) (I × (J × K)) ℂ) :
    Bool → Matrix (I × (J × K)) (I × (J × K)) ℂ :=
  fun b => if b then D else productCoeff (traceSecond (MarginalAB D)) (traceFirst D)

example {I J K : Type}
    (D : Matrix (I × (J × K)) (I × (J × K)) ℂ) : SsaFamily D true = D := by
  simp [SsaFamily]

end QAlgorithms.Papers.Independent.Next46.P43


