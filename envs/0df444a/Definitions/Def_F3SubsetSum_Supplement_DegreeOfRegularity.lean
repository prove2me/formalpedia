-- title:
--   Degree of regularity $d_{\mathrm{reg}}(f_1,\dots,f_r)$
-- statement:
--   Let $K$ be a commutative ring and $f_1,\dots,f_r\in K[x_1,\dots,x_n]$. Write $f_i^{\mathrm{top}}$ for the **top-degree homogeneous part** of $f_i$ (its homogeneous component of degree $\deg f_i$). The **degree of regularity** is
--   $$
--   d_{\mathrm{reg}}(f_1,\dots,f_r)=\min\Big\{D\in\mathbb N:\ \text{every monomial of total degree } D \text{ lies in } \big(f_1^{\mathrm{top}},\dots,f_r^{\mathrm{top}}\big)\Big\},
--   $$
--   that is, the least $D$ such that every degree-$D$ monomial can be written as $f_1^{\mathrm{top}}g_1+\dots+f_r^{\mathrm{top}}g_r$ for suitable polynomials $g_i$.
--
--   A small degree of regularity means every polynomial reduces, modulo the system $f_1=\dots=f_r=0$, to one of degree less than $d_{\mathrm{reg}}$; this controls the running time of Gröbner-basis algorithms.
--
--   **Formalization Note** The value lies in $\mathbb N\cup\{\infty\}$ and is $\infty$ when no $D$ works, so that no bound $d_{\mathrm{reg}}\le D$ holds by a default value.
-- source:
--   Kothari, Metger, O'Donnell, Shutty, Wu, Exponential quantum speedup for F_3^n-Subset-Sum? Or, rigorous classical algorithms for Binary-Error LWE, arXiv:2609.40321v1, Definition 2.1, p.9

import Mathlib

set_option autoImplicit false

namespace F3SubsetSum.Supplement

open MvPolynomial

/-- **The top-degree homogeneous part** `f^top` of a polynomial `f` (Definition 2.1, p.9): the
homogeneous component of `f` of degree `deg f` (its total degree). For `f = 0` it is `0`. -/
noncomputable def topPart {σ K : Type*} [CommRing K] (f : MvPolynomial σ K) : MvPolynomial σ K :=
  homogeneousComponent f.totalDegree f

/-- **Every degree-`D` monomial is a combination of the top parts.** Kothari, Metger, O'Donnell,
Shutty, Wu, arXiv:2609.40321v1, Definition 2.1, p.9: "every degree-D monomial can be written as
f_1^top · g_1 + f_2^top · g_2 + ⋯, where f_i^top is the top-degree homogeneous part of f_i and the
g_i are suitable polynomial multipliers, which may depend on the target monomial."

`MonomialsInTopIdeal f D` says that every monomial `x^s` of total degree `D` lies in the ideal
generated by `f_i^top`, `i ∈ ι`. -/
def MonomialsInTopIdeal {σ K ι : Type*} [CommRing K] (f : ι → MvPolynomial σ K) (D : ℕ) : Prop :=
  ∀ s : σ →₀ ℕ, (s.sum fun _ e => e) = D →
    monomial s (1 : K) ∈ Ideal.span (Set.range fun i => topPart (f i))

/-- **The degree of regularity** `d_reg(f_1, …, f_r)` (Definition 2.1, p.9): "the least D such
that every degree-D monomial can be written as f_1^top · g_1 + f_2^top · g_2 + ⋯".

**Formalization Note** The value lies in `ℕ∞`: it is the least `D ∈ ℕ` with
`MonomialsInTopIdeal f D`, and `⊤` when no such `D` exists, so that a bound `d_reg ≤ D` is never
met by a default value. -/
noncomputable def degReg {σ K ι : Type*} [CommRing K] (f : ι → MvPolynomial σ K) : ℕ∞ :=
  ⨅ (D : ℕ) (_ : MonomialsInTopIdeal f D), (D : ℕ∞)

end F3SubsetSum.Supplement


