set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem kerRegs_vals (w f pre nc post : ℕ) (T : List ℤ) (i : Fin 9) :
    kerRegs w w f pre nc post T (Fin.castLE (by omega) i) = [(cVals w f pre nc post).getD i 0] := by
  fin_cases i <;> simp [kerRegs, cVals]

theorem kerRegs_hi (w f pre nc post : ℕ) (T : List ℤ) (i : Fin 19) (h : 11 ≤ i.val) :
    kerRegs w w f pre nc post T i = [] := by
  unfold kerRegs
  simp only [show i.val ≠ 0 by omega, show i.val ≠ 1 by omega, show i.val ≠ 2 by omega,
    show i.val ≠ 3 by omega, show i.val ≠ 4 by omega, show i.val ≠ 5 by omega,
    show i.val ≠ 6 by omega, show i.val ≠ 7 by omega, show i.val ≠ 8 by omega,
    show i.val ≠ 9 by omega, show i.val ≠ 10 by omega, if_false]

theorem extend_clean (oN : Fin 19 → Fin HS) (hinj : Injective oN) (V : Fin 19 → List ℤ) (G : Cs)
    (a b c : List ℤ) (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC)
    (hX : G sX = []) (hL : G sLn = []) (hO : G sOut = []) :
    update (update (update (extend oN V (update (update (update G sX a) sOut b) sLn c)) sX [])
      sLn []) sOut [] = extend oN V G := by
  funext j
  by_cases hj : ∃ i, oN i = j
  · obtain ⟨i, rfl⟩ := hj
    obtain ⟨a1, a2, a3, -, -⟩ := hx i
    rw [update_of_ne a3, update_of_ne a2, update_of_ne a1, hinj.extend_apply, hinj.extend_apply]
  · rw [extend_apply' _ _ _ hj]
    by_cases jO : j = sOut
    · subst jO; rw [update_self, hO]
    rw [update_of_ne jO]
    by_cases jL : j = sLn
    · subst jL; rw [update_self, hL]
    rw [update_of_ne jL]
    by_cases jX : j = sX
    · subst jX; rw [update_self, hX]
    rw [update_of_ne jX, extend_apply' _ _ _ hj, update_of_ne jL, update_of_ne jO, update_of_ne jX]

/-- **The native chunk set-up.** -/
theorem eCn_sp_sol_aux (pl : Plan6) {k pre post s t p α d W M B : ℕ} {Zn : Fin HS}
    (hZ : Zn ∉ rg) (hZ5 : Zn.val < 56) (hZT : Zn ≠ sTmp) (hZC : Zn ≠ cRdC) (hZ2 : Zn ≠ sT2)
    (hZx : Zn ≠ sSt ∧ Zn ≠ sX ∧ Zn ≠ sOut ∧ Zn ≠ sLn ∧ Zn ≠ cLC ∧ Zn ≠ 13 ∧ Zn ≠ 51 ∧ Zn ≠ 53 ∧
      Zn ≠ 54 ∧ Zn ≠ PreT.Cu)
    (oN : Fin 19 → Fin HS) (hinj : Injective oN) (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC) (hZo : ∀ i, oN i ≠ Zn)
    (hW : parBig pl.kA pl.kC pl.wA pl.wC k pre post s t p α d < 2 ^ W)
    (bpk : pl.pkA * segPF p d s + pl.pkC ≤ 2 ^ W) (bb : pl.bA * segPF p d s + pl.bC ≤ 2 ^ W)
    (bl : pl.pkA + pl.pkC + pl.bA + pl.bC + 2 ≤ 2 ^ W)
    (hPA : segPF p d s ≤ W) (hA2 : 2 ≤ W)
    (TB : PreT.TabB (segPF p d s) (p / 7) s t α (lamP d) W)
    (hpkM : pl.pkA * segPF p d s + pl.pkC ≤ M) (hbM : pl.bA * segPF p d s + pl.bC ≤ M)
    (hncA : t / lamP d * lamP d ≤ 2 ^ W) (hncA' : t / lamP d * (9 + 10 * lamP d) ≤ 2 ^ W)
    (hvB : ∀ a ∈ cVals (pl.wA * segPF p d s + pl.wC) (Nat.log 2 (lamF d)) pre (t / lamP d) post,
      zsz a ≤ B)
    (hlB : zsz ((tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
      (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)).length : ℤ) ≤ B)
    (hTB : Bnd B (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
      (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)))
    (s0 : IState HS) :
    Sp (eCn pl Zn oN) (encK s0 (F0 Zn (dsc k pre post s t p α d)))
      (encK s0 (extend oN (kerRegs (pl.wA * segPF p d s + pl.wC) (pl.wA * segPF p d s + pl.wC)
        (Nat.log 2 (lamF d)) pre (t / lamP d) post
        (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
          (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)))
        (F0 Zn (dsc k pre post s t p α d))))
      (cECn pl W d (NF d s) (segPF p d s) (lamP d) (p / 7) M (t / lamP d) B
        (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
          (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)).length) := by
  obtain ⟨z44, z45, z41, z42, zC, z13, z51, z53, z54, zCu⟩ := hZx
  set G := F0 Zn (dsc k pre post s t p α d) with hG
  have hGe : ∀ j, j ≠ Zn → G j = [] := fun j hj => by rw [hG, F0, update_of_ne hj]
  have S0 := init_sp s0 G (fun j hj => hGe j (fun h => hZ (h ▸ hj)))
  obtain ⟨v', hv', Hc⟩ := Rn.eCcore (pkA := pl.pkA) (pkC := pl.pkC) (bA := pl.bA) (bC := pl.bC)
    (kA := pl.kA) (kC := pl.kC) (wA := pl.wA) (wC := pl.wC) (M := M) hZ hZ5 hZT hZC
    ⟨z44, z45, z41, z42⟩ (c := G) (by rw [hG, F0, update_self]) (hGe _ (Ne.symm zC))
    (hGe _ (Ne.symm z41)) (hGe _ (Ne.symm z42)) (hGe _ (Ne.symm z44)) (hGe _ (Ne.symm z45))
    (hGe _ (Ne.symm z13)) (hGe _ (Ne.symm z51)) (hGe _ (Ne.symm z53)) (hGe _ (Ne.symm z54))
    (hGe _ (Ne.symm zCu)) hW bpk bb bl hPA hA2 TB hpkM hbM hncA hncA'
  set T := tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
      (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d) with hT
  set vs := cVals (pl.wA * segPF p d s + pl.wC) (Nat.log 2 (lamF d)) pre (t / lamP d) post
  set c1 := update (update (update G sX vs) sOut T) sLn [(T.length : ℤ)] with hc1
  have S1 := Hc s0
  have hrg : ∀ j ∈ rg, c1 j = [] := fun j hj => by
    rw [hc1, update_of_ne (fun h => by subst h; revert hj; decide),
      update_of_ne (fun h => by subst h; revert hj; decide),
      update_of_ne (fun h => by subst h; revert hj; decide)]
    exact hGe j (fun h => hZ (h ▸ hj))
  have S2 := fini_sp s0 c1 hrg v' (W := W + 1) (fun j hj => zsz_le_W1 (hv' j hj))
  have S3 := distAll_sp s0 oN hinj hlt hx c1 vs T (by simp [vs, cVals])
    (by rw [hc1, update_of_ne (by decide), update_of_ne (by decide), update_self])
    (by rw [hc1, update_self]) (by rw [hc1, update_of_ne (by decide), update_self])
    (by rw [hc1, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide)]
        exact hGe _ (Ne.symm hZ2))
    (fun i => by
      obtain ⟨a1, a2, a3, -, -⟩ := hx i
      rw [hc1, update_of_ne a2, update_of_ne a3, update_of_ne a1]; exact hGe _ (hZo i))
    _ (kerRegs_vals _ _ _ _ _ T) rfl rfl (kerRegs_hi _ _ _ _ _ T) B hvB hlB hTB
  rw [hc1, extend_clean oN hinj _ G vs T _ hx (hGe _ (Ne.symm z45)) (hGe _ (Ne.symm z42))
    (hGe _ (Ne.symm z41))] at S3
  exact (S0.seq (S1.seq (S2.seq S3))).mono le_rfl

