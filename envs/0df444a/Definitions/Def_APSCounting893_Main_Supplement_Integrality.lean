-- title:
--   Generated polynomial subalgebras and integral dependence
-- statement:
--   Let $K$ be a field, $F=(f_1,\ldots,f_m)$ a finite tuple in $K[x_1,\ldots,x_n]$, and $f$ another polynomial. The generated algebra is $A=K[f_1,\ldots,f_m]$, and $f$ is integral over $A$ when it satisfies a monic polynomial equation over $A$:
--
--   $$f^r+\sum_{j=0}^{r-1}a_j f^j=0,\qquad r\ge1,\quad a_j\in A.$$
--
--   The rank is $\rho=\operatorname{trdeg}_K\operatorname{Frac}(A)$. Appending a fresh independent last variable $z$ gives the tuple $(zf_1,\ldots,zf_m)$. Algebraic APS means origin membership in the Zariski image closure over $K$ and is used only with algebraically closed $K$ in the structural claims. These objects connect integral dependence to the already published polynomial-map geometry. Empty generator families give $A=K$.
-- source:
--   Sanyam Agarwal, Archit Hari, Anurag Pandey, Himanshu Shukla, STOC 2027 submission #893 (October 2026), Definition 3.6, p. 12; §7, p. 28; Lemma 7.11, p. 32

import Definitions.Def_APSCounting893_Main_Geometry

set_option autoImplicit false

namespace APSCounting893.Main.Supplement

/-- The actual polynomial subalgebra generated by the finite family. -/
noncomputable def generatedAlgebra {K : Type} [Field K] {n m : ℕ}
    (F : PolynomialMap K n m) : Subalgebra K (Polynomials K n) :=
  Algebra.adjoin K (Set.range F)

/-- Integrality is independently defined by Mathlib's monic-equation predicate. -/
def IntegralOverGenerators {K : Type} [Field K] {n m : ℕ}
    (F : PolynomialMap K n m) (f : Polynomials K n) : Prop :=
  IsIntegral (generatedAlgebra F) f

/-- The transcendence degree of the generated fraction field, not the number of generators.
For a finitely generated domain this is a finite cardinal. -/
noncomputable def generatorRank {K : Type} [Field K] {n m : ℕ}
    (F : PolynomialMap K n m) : ℕ :=
  (Algebra.trdeg K (FractionRing (generatedAlgebra F))).toNat

/-- Append one independent variable at the last coordinate. -/
noncomputable def extendPolynomial {K : Type} [Field K] {n : ℕ}
    (f : Polynomials K n) : Polynomials K (n + 1) :=
  MvPolynomial.rename Fin.castSucc f

noncomputable def freshVariable {K : Type} [Field K] (n : ℕ) : Polynomials K (n + 1) :=
  MvPolynomial.X (Fin.last n)

noncomputable def scaledGenerators {K : Type} [Field K] {n m : ℕ}
    (F : PolynomialMap K n m) : PolynomialMap K (n + 1) m :=
  fun i => freshVariable n * extendPolynomial (F i)

/-- Algebraic APS over an arbitrary field is closure over that field. The statements that
use this definition require the field to be algebraically closed. -/
noncomputable def AlgebraicAPS {K : Type} [Field K] {n m : ℕ}
    (F : PolynomialMap K n m) : Prop :=
  (0 : Affine K m) ∈ imageClosure F

end APSCounting893.Main.Supplement


