-- title:
--   §3.2, (83) — sufficient decrease of $\mathcal F_k$
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. With the Section 3 regularized augmented Lagrangian, $\mathcal F_k = L_r(x^k,z^k,y^k) + 2T_1\|A^*(y^k-y^{k-1})\|^2 + C_1\|x^k-x^{k-1}\|^2$, for every $k\ge1$
--   $$\mathcal F_{k+1} + \frac{C_1}{4}\|x^{k+1}-x^k\|^2 + \frac12\|z^{k+1}-z^k\|^2_{M_2^k} + \frac{1}{\rho r}\|y^{k+1}-y^k\|^2 \le \mathcal F_k. \qquad (83)$$
--
--   This sufficient-decrease property of $(\mathcal F_k)$ is what the recurrence inequality of Lemma 17 and the length estimates of Lemma 19 are built on.
--
--   **Formalization Note** Stated in `EReal`, with the nonnegative real terms added on the left. $\mathcal F_k$ uses the Section 3 regularization ($2T_1$ and $C_1$; see the definition item).
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, §3.2, (83), p. 25

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **(83)** (Boţ–Nguyen, arXiv:1801.01994v2, §3.2, p. 25). Under Assumption 2, for a
sequence generated by Algorithm 1 or Algorithm 2 and every `k ≥ 1`, with the Section 3
`F_k = L_r(xᵏ, zᵏ, yᵏ) + 2T₁‖A*(yᵏ − y^{k−1})‖² + C₁‖xᵏ − x^{k−1}‖²`:
`F_{k+1} + (C₁/4)‖x^{k+1} − xᵏ‖² + ½‖z^{k+1} − zᵏ‖²_{M₂ᵏ} + (1/(ρr))‖y^{k+1} − yᵏ‖² ≤ F_k`. -/
theorem eq_83
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (k : ℕ) (hk : 1 ≤ k) :
    Fk v g h A L r ρ lam μ₁ x z y (k + 1) +
        ((C1 v L μ₁ lam ρ r / 4 * ‖x (k + 1) - x k‖ ^ 2 +
          1 / 2 * ⟪M₂ k (z (k + 1) - z k), z (k + 1) - z k⟫ +
          1 / (ρ * r) * ‖y (k + 1) - y k‖ ^ 2 : ℝ) : EReal) ≤
      Fk v g h A L r ρ lam μ₁ x z y k := by sorry

end BotNguyenADMM.Rates
