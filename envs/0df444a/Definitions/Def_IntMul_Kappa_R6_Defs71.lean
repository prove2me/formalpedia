-- Source module: Solutions.J6SegILPreJK6
/-!
# B5 `J` side, part K6: the capacitance entry as a slot sum

* `capI_slots`: `capI a b = [a = b] 2^P + Σ_{y < n (2w+1)} [gC y = b] gV y`;
* `PJ.cwB` / `PJ.cwL = forL 54 11 8 PJ.cwB`: `5 ← 5 + Σ_y [gC y = r4] gV y`, reading `SC`, `SV`
  (reversed, length `n (2w+1)` on `11`) (`Rn.cwB`, `Rn.cwL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

/-- One slot's contribution to column `b`. -/
def cTm (gv gc : ℕ → ℤ) (b y : ℕ) : ℤ := if gc y = b then gv y else 0

namespace E
def ixYE : E := .sub (.sub (.r 11) (.k 1)) (.r 8)
end E

def cwB : List Ins :=
  [.rd SC ixYE 12, .a 12 (eqE (.r 12) (.r 4)), .rd SV ixYE 1, .a 5 (.add (.r 5) (.mul (.r 12) (.r 1)))]

def cwL : RS := forL 54 11 8 (progL cwB)

end J6Seg.PJ

end

