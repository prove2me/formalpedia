section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.KIL
open IntMul RS AModel
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (as : ℕ → ℕ) (P Q B Bb : ℕ)
    (R L1 L2 L4 L14 : List NLogN.Item) (has : ∀ p, as p ≤ Q)
    (hlen : xs.length = P * Q * B) (hb : NLogN.Bnd Bb xs) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P)
    (hV : NLogN.zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int B :: L4)
    (h14 : t.G 14 = NLogN.ints ((List.range P).map fun p => (as p : ℤ)) ++ L14) :
    NLogN.KIL.rotP.ok t ∧ NLogN.KIL.rotP.run t =
        (t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.rotAddr Q as) 0 xs) ++ R)).upd 14 L14 ∧
      NLogN.KIL.rotP.cost t ≤ 200000 * (P * (Q * B) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  have H := NLogN.KIL.rotP_sp (NLogN.KIL.rBase t R L1 L2 L4 L14) (NLogN.KIL.recR xs Q B) P Q B Bb as
    (fun _ _ => NLogN.KIL.length_recR xs Q B _ _)
    (fun _ _ a ha => by
      simp only [NLogN.KIL.recR, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact NLogN.KIL.bnd_getD hb _) has hB1 hQ1 hP1 hV
  rw [NLogN.KIL.inR_recR hlen, NLogN.KIL.outR_recR xs P Q B as has, NLogN.KIL.encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4,
    NLogN.KIL.encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4] at H
  have e : (t.upd 0 (NLogN.ints xs ++ R)).upd 14 (NLogN.ints ((List.range P).map fun p => (as p : ℤ)) ++ L14)
      = t := by
    rw [← h0, ← h14, NLogN.IState.upd_self, NLogN.IState.upd_self]
  rw [e] at H
  refine ⟨H.1, ?_, le_trans H.2.2 (NLogN.KIL.cRot_le hB1 hQ1)⟩
  rw [H.2.1]; simp [NLogN.ints]
end
