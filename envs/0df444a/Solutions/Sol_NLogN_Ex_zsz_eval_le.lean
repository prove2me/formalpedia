open NLogN
open IntMul
variable {S : ℕ}
open NLogN.Ex
theorem zsz_eval_le_aux (s : NLogN.IState S) (B : ℕ) : ∀ e : NLogN.Ex S, e.Bnd s B → NLogN.zsz (e.eval s) ≤ B 
  | reg _, h | lit _, h => h
  | add _ _, h | mul _ _, h | shl _ _, h | ndiv _ _, h | nmod _ _, h => h.2.2
  | neg a, h => by simp only [NLogN.Ex.eval, NLogN.zsz_neg]; exact zsz_eval_le_aux s B a h
  | quo a r, h => by
    simp only [NLogN.Ex.eval]
    exact le_trans (NLogN.zsz_mono (by rw [Int.natAbs_tdiv]; exact Nat.div_le_self _ _))
      (zsz_eval_le_aux s B a h.1)
  | rem a r, h => by
    simp only [NLogN.Ex.eval]
    exact le_trans (NLogN.zsz_mono (by rw [Int.natAbs_tmod]; exact Nat.mod_le _ _))
      (zsz_eval_le_aux s B a h.1)
  | pow2 a, h => by
    simp only [NLogN.Ex.eval]; rw [NLogN.zsz_two_pow]; have := h.2; omega
  | sel c x y, h => by
    simp only [NLogN.Ex.eval]; split_ifs with hc
    · exact zsz_eval_le_aux s B x (by simpa [hc] using h.2)
    · exact zsz_eval_le_aux s B y (by simpa [hc] using h.2)

theorem solution (s : NLogN.IState S) (B : ℕ) : ∀ e : NLogN.Ex S, e.Bnd s B → NLogN.zsz (e.eval s) ≤ B := by
  first
  | exact zsz_eval_le_aux
  | (intros; apply zsz_eval_le_aux <;> assumption)
end
