-- title:
--   Represent membership in a finitely generated ideal
-- statement:
--   Membership in the ideal generated by a finite indexed family gives an explicit sum representation using one polynomial coefficient for each generator. This converts the ideal hypothesis into the form needed for degree extraction. It follows by transporting membership across hspan and applying the finite-span membership characterization (or span induction and collecting the finitely many terms). The conclusion remains valid when k is zero: the span is then zero and the sum is empty.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.weighted_span_representation
    {d k : Nat} (g : Fin k → MvPolynomial (Fin d) Complex)
    (J : Ideal (MvPolynomial (Fin d) Complex))
    (hspan : Ideal.span (Set.range g) = J)
    (f : MvPolynomial (Fin d) Complex)
    (hmem : f ∈ J) :
    ∃ a : Fin k → MvPolynomial (Fin d) Complex,
      f = ∑ j : Fin k, a j * g j := by sorry
