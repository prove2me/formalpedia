/-!
# Round six, item language (I3): cost bounds of the pads

With `Y = Yu r Z H`:

* `cost_padH`: the register part of a pad (`padCU`) on `≤ 2 Nn r` entries costs `≤ 10^8 Nn Y`;
* `cost_scaleH`: the scale pad on `N` records costs `≤ 10^16 N Y`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly

theorem cPadC_split (L0 Q Z w dw : ℕ) (cost : ℕ → ℕ) :
    cPadC L0 Q Z w dw cost = cPadC L0 Q Z w dw (fun _ => 0) + cost w := by
  unfold cPadC; ring

/-- **The scale pad.** -/
theorem cost_scaleH {N r Z H δ w : ℕ} (hN : 1 ≤ N) (hw : w + (δ + 2) * 2 ≤ H)
    (hZ : zsz ((2 * (N * r) : ℕ) : ℤ) ≤ Z) :
    400 * (cPadC (2 * (N * r)) (2 * (N * r)) Z w ((δ + 2) * 2)
      (cWrapQ 2 (N * r) Z δ 0 (fun _ => 1)) + 0) + cWrapQ 2 (N * r) Z δ 0 (fun _ => 1) w ≤
      10 ^ 16 * (N * Yu r Z H) := by
  rw [cPadC_split]
  have h1 := cost_padH (L0 := 2 * (N * r)) (Q := 2 * (N * r)) (Z := Z) (w := w)
    (dw := (δ + 2) * 2) (r := r) (H := H) (Nn := N) le_rfl le_rfl hw hZ hN
  have h2 := cWrapQ_Y (W := 2) (n := N) (r := r) (Z := Z) (H := H) (e := δ) (dw := 0) (x := w)
    (by norm_num) hN (fun _ => 1) (by omega)
  have hY8 := yu_8 r Z H
  set Y := Yu r Z H
  have hNY : 1 ≤ N * Y := by
    have := Nat.mul_le_mul hN (show 1 ≤ Y by omega); simpa using this
  have e1 : 10 ^ 12 * (2 + 2) * (2 * N * Y) = 8 * 10 ^ 12 * (N * Y) := by ring
  rw [e1] at h2
  have e2 : 400 * (cPadC (2 * (N * r)) (2 * (N * r)) Z w ((δ + 2) * 2) (fun _ => 0) +
      cWrapQ 2 (N * r) Z δ 0 (fun _ => 1) w + 0) =
      400 * (cPadC (2 * (N * r)) (2 * (N * r)) Z w ((δ + 2) * 2) (fun _ => 0) + 0) +
        400 * cWrapQ 2 (N * r) Z δ 0 (fun _ => 1) w := by ring
  rw [e2]
  generalize cWrapQ 2 (N * r) Z δ 0 (fun _ => 1) w = cw at h2 ⊢
  generalize 400 * (cPadC (2 * (N * r)) (2 * (N * r)) Z w ((δ + 2) * 2) (fun _ => 0) + 0) = cp
    at h1 ⊢
  generalize N * Y = P at *
  omega

end IntMul.Kappa.R6.IL3H

