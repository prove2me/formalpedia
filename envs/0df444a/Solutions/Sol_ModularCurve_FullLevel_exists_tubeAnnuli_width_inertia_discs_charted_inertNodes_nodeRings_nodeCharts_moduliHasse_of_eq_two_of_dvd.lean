theorem exists_tameUniformiser (q : ℕ) [Fact q.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) :
    ∃ π : AlgebraicClosure ℚ, π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ) ∧ π ∈ A := by
  have hq2 : 2 ≤ q := (Fact.out : q.Prime).two_le
  have hn : 0 < q ^ 2 - 1 := by
    have : 4 ≤ q ^ 2 := by nlinarith
    omega
  obtain ⟨π, hπ⟩ := IsAlgClosed.exists_pow_nat_eq (q : AlgebraicClosure ℚ) hn
  refine ⟨π, hπ, ?_⟩
  by_contra hπA
  have hq0 : (q : AlgebraicClosure ℚ) ≠ 0 := by exact_mod_cast (Fact.out : q.Prime).ne_zero
  have hπ0 : π ≠ 0 := by rintro rfl; apply hq0; rw [← hπ]; simp [hn.ne']
  have hinv : π⁻¹ ∈ A := (A.mem_or_inv_mem π).resolve_left hπA

  have hvπ : 1 < A.valuation π := by
    rw [← not_le]; intro h; exact hπA ((A.valuation_le_one_iff π).mp h)
  have hvπ0 : 0 < A.valuation π := lt_trans zero_lt_one hvπ
  have hvinv : A.valuation π⁻¹ < 1 := by rw [map_inv₀]; exact (inv_lt_one₀ hvπ0).mpr hvπ
  have hmax : (⟨π⁻¹, hinv⟩ : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := (A.valuation_lt_one_iff ⟨π⁻¹, hinv⟩).mpr hvinv

  have hqA : ((q : ℕ) : AlgebraicClosure ℚ) ∈ A := by
    have : ((q : ℕ) : ↥A).1 = ((q : ℕ) : AlgebraicClosure ℚ) := by simp
    rw [← this]; exact ((q : ℕ) : ↥A).2
  have hone : (1 : ↥A) = ⟨π⁻¹, hinv⟩ ^ (q ^ 2 - 1) * ⟨(q : AlgebraicClosure ℚ), hqA⟩ := by
    apply Subtype.ext
    show (1 : AlgebraicClosure ℚ) = π⁻¹ ^ (q ^ 2 - 1) * (q : AlgebraicClosure ℚ)
    rw [← hπ, inv_pow, inv_mul_cancel₀ (pow_ne_zero _ hπ0)]
  have h1 : (1 : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := by
    rw [hone]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hmax _ hn)
  exact (IsLocalRing.maximalIdeal.isMaximal ↥A).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

end RedII

