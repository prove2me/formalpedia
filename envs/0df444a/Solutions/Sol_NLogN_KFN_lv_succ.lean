      · rw [Equiv.swap_apply_of_ne_of_ne (fun h => e1 (by rw [← h])) (fun h => e2 (by rw [← h])),
          if_neg e1, if_neg e2]
  · rw [dif_neg hw]
    have : w ≠ a.val := by have := a.isLt; omega
    have : w ≠ b.val := by have := b.isLt; omega
    simp [*]

