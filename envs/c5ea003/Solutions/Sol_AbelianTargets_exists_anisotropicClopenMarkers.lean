/-!
# A clopen maximal independent set from a countable clopen independent cover

This is the maximal-independent-set part of Lemma 3.1 of
arXiv:2609.39824. The graph-neighbor operator is assumed to preserve clopen
sets, as happens for graphs generated by finitely many homeomorphisms.
The existence of the countable independent cover is a separate input.
-/

namespace AbelianTargets

universe u
variable {X : Type u} (G : SimpleGraph X)









variable {G}





/-- No previously selected point is discarded. -/
theorem markerAccumulation_subset_succ (C : ℕ → Set X) (n : ℕ) :
    markerAccumulation G C n ⊆ markerAccumulation G C (n + 1) :=
  fun _ hx => Or.inl hx

/-- The selected sets increase with the stage index. -/
theorem markerAccumulation_monotone (C : ℕ → Set X) :
    Monotone (markerAccumulation G C) :=
  monotone_nat_of_le_succ (markerAccumulation_subset_succ C)



variable [TopologicalSpace X]

/-- Every finite stage is clopen. -/
theorem markerAccumulation_clopen (C : ℕ → Set X)
    (hclopen : ∀ n, IsClopen (C n))
    (neighbor_clopen : ∀ S, IsClopen S → IsClopen (NeighborSet G S)) (n : ℕ) :
    IsClopen (markerAccumulation G C n) := by
  induction n with
  | zero => exact isClopen_empty
  | succ n ih => exact ih.union ((hclopen n).diff (neighbor_clopen _ ih))

omit [TopologicalSpace X] in
/-- Independence survives the increasing union. -/
theorem maximalMarkerSet_independent (C : ℕ → Set X)
    (hindep : ∀ n, GraphIndependent G (C n)) :
    GraphIndependent G (maximalMarkerSet G C) := by
  intro x hx y hy hadj
  obtain ⟨i, hxi⟩ := Set.mem_iUnion.mp hx
  obtain ⟨j, hyj⟩ := Set.mem_iUnion.mp hy
  exact markerAccumulation_independent C hindep (max i j) x
    (markerAccumulation_monotone C (Nat.le_max_left i j) hxi) y
    (markerAccumulation_monotone C (Nat.le_max_right i j) hyj) hadj

omit [TopologicalSpace X] in
/-- Every point not chosen has a previously chosen neighbor at some stage. -/
theorem maximalMarkerSet_neighbor_stage (C : ℕ → Set X)
    (hcover : ∀ x, ∃ n, x ∈ C n) (x : X) (hx : x ∉ maximalMarkerSet G C) :
    ∃ n, x ∈ NeighborSet G (markerAccumulation G C n) := by
  classical
  obtain ⟨n, hxn⟩ := hcover x
  refine ⟨n, ?_⟩
  by_contra hnot
  exact hx (Set.mem_iUnion.mpr ⟨n + 1, Or.inr ⟨hxn, hnot⟩⟩)

omit [TopologicalSpace X] in
/-- The increasing union is a maximal independent set. -/
theorem maximalMarkerSet_maximal (C : ℕ → Set X)
    (hcover : ∀ x, ∃ n, x ∈ C n) :
    ∀ x, x ∉ maximalMarkerSet G C → ∃ a ∈ maximalMarkerSet G C, G.Adj a x := by
  intro x hx
  obtain ⟨n, a, ha, hadj⟩ := maximalMarkerSet_neighbor_stage C hcover x hx
  exact ⟨a, Set.mem_iUnion.mpr ⟨n, ha⟩, hadj⟩

omit [TopologicalSpace X] in
/-- The complement is a union of finite-stage neighbor sets. This identifies
it as an open set, which is the essential continuity argument. -/
theorem maximalMarkerSet_compl (C : ℕ → Set X)
    (hindep : ∀ n, GraphIndependent G (C n))
    (hcover : ∀ x, ∃ n, x ∈ C n) :
    (maximalMarkerSet G C)ᶜ = ⋃ n, NeighborSet G (markerAccumulation G C n) := by
  ext x
  constructor
  · intro hx
    exact Set.mem_iUnion.mpr (maximalMarkerSet_neighbor_stage C hcover x hx)
  · intro hx hxA
    obtain ⟨n, a, ha, hadj⟩ := Set.mem_iUnion.mp hx
    exact maximalMarkerSet_independent C hindep a
      (Set.mem_iUnion.mpr ⟨n, ha⟩) x hxA hadj

/-- Both the greedy union and its complement are open, so the union is clopen. -/
theorem maximalMarkerSet_clopen (C : ℕ → Set X)
    (hclopen : ∀ n, IsClopen (C n))
    (hindep : ∀ n, GraphIndependent G (C n))
    (hcover : ∀ x, ∃ n, x ∈ C n)
    (neighbor_clopen : ∀ S, IsClopen S → IsClopen (NeighborSet G S)) :
    IsClopen (maximalMarkerSet G C) := by
  have hopen : IsOpen (maximalMarkerSet G C) :=
    isOpen_iUnion (fun n => (markerAccumulation_clopen C hclopen neighbor_clopen n).isOpen)
  have hcompl : IsOpen (maximalMarkerSet G C)ᶜ := by
    rw [maximalMarkerSet_compl C hindep hcover]
    exact isOpen_iUnion (fun n =>
      (neighbor_clopen _ (markerAccumulation_clopen C hclopen neighbor_clopen n)).isOpen)
  exact ⟨by simpa only [compl_compl] using hcompl.isClosed_compl, hopen⟩

/-- The maximal independent set assertion in Lemma 3.1.
The assumptions are explicit, including the independent clopen cover. -/
theorem exists_clopen_maximal_independent (G : SimpleGraph X) (C : ℕ → Set X)
    (hclopen : ∀ n, IsClopen (C n))
    (hindep : ∀ n, GraphIndependent G (C n))
    (hcover : ∀ x, ∃ n, x ∈ C n)
    (neighbor_clopen : ∀ S, IsClopen S → IsClopen (NeighborSet G S)) :
    ∃ A : Set X, IsClopen A ∧ GraphIndependent G A ∧
      ∀ x, x ∉ A → ∃ a ∈ A, G.Adj a x :=
  ⟨maximalMarkerSet G C, maximalMarkerSet_clopen C hclopen hindep hcover neighbor_clopen,
    maximalMarkerSet_independent C hindep, maximalMarkerSet_maximal C hcover⟩

end AbelianTargets

end

/-!
# Clopen markers at independent coordinate scales

The initial marker construction in Lemma 3.2 is proved for an actual free
continuous action. Each coordinate has its own scale. This is the input
to the later packing, priority, cut, and rectangular subdivision steps.
-/
namespace AbelianTargets
end AbelianTargets
open AbelianTargets
variable {d : ℕ} {X : Type*} [TopologicalSpace X] [AddAction (Lattice d) X]
variable [ContinuousVAdd (Lattice d) X]
variable [T1Space X] [SecondCountableTopology X]

theorem solution (L : Fin d → ℕ)
    (zeroDim : ZeroDimensional X) (free : IsFree (G := Lattice d) (X := X)) :
    Nonempty (AnisotropicClopenMarkers d L X) := by
  classical
  obtain ⟨C,hclopen,hindep,hcover⟩ := exists_countable_anisotropic_independent_cover L zeroDim free
  obtain ⟨A,hA,hAi,hmax⟩ := exists_clopen_maximal_independent
    (anisotropicDisplacementGraph L free) C hclopen hindep hcover
    (neighbor_clopen_anisotropicDisplacementGraph L free)
  refine ⟨⟨A,hA,?_,?_⟩⟩
  · intro x u v hu hv hne
    by_contra hnone
    have hg : v-u ∈ anisotropicDisplacements L := by
      apply (mem_anisotropicDisplacements L (v-u)).mpr
      refine ⟨?_,sub_ne_zero.mpr hne.symm⟩
      intro i
      have hi : |u i-v i| ≤ (L i : ℤ) := le_of_not_gt (fun hi => hnone ⟨i,hi⟩)
      simpa only [Pi.sub_apply,abs_sub_comm] using hi
    apply hAi (u +ᵥ x) hu (v +ᵥ x) hv
    refine ⟨v-u,hg,?_⟩
    rw [← add_vadd,sub_add_cancel]
  · intro x u
    by_cases hu : u +ᵥ x ∈ A
    · exact ⟨u,hu,by intro i; simp⟩
    · obtain ⟨b,hb,g,hg,hgb⟩ := hmax (u +ᵥ x) hu
      have hab : (u-g) +ᵥ x = b := by
        have hlat : u-g = -g+u := by rw [sub_eq_add_neg,add_comm]
        rw [hlat,add_vadd,← hgb,← add_vadd,neg_add_cancel,zero_vadd]
      refine ⟨u-g,hab.symm ▸ hb,?_⟩
      intro i
      simpa only [Pi.sub_apply,sub_sub_cancel] using
        ((mem_anisotropicDisplacements L g).mp hg).1 i
