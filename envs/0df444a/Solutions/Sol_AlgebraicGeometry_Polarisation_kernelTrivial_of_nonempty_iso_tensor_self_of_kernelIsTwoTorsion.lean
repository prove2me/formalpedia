theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (𝓛₀ 𝓝 : A.Modules) (h𝓛₀ : Scheme.Modules.IsInvertible 𝓛₀) (e : Nonempty (𝓝 ≅ 𝓛₀ ⊗ 𝓛₀))
    (h𝓝 : KernelIsTwoTorsion f L 𝓝) :
    KernelTrivial f L 𝓛₀ := by
  obtain ⟨e⟩ := e
  intro R _ t x hx

  obtain ⟨R', _, _, hff, y, hy⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_faithfullyFlat_mul_self_eq_schemeHomOverComp k L hc hA R t x
  haveI := hff

  let θ : pullback f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) ⟶ pullback f t :=
    pullback.lift (pullback.fst f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t)) (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) ≫ (Spec.map (CommRingCat.ofHom (algebraMap R R'))))
      (by rw [Category.assoc]; exact pullback.condition)
  have hθ₁ : θ ≫ pullback.fst f t = pullback.fst f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) := pullback.lift_fst _ _ _
  have hθ : θ ≫ pullback.snd f t = pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) ≫ (Spec.map (CommRingCat.ofHom (algebraMap R R'))) := pullback.lift_snd _ _ _
  have hθslice : θ ≫ sliceAt f x = sliceAt f (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) rfl x) := by
    apply pullback.hom_ext
    · simp only [sliceAt, Category.assoc, pullback.lift_fst, hθ₁]
    · simp only [sliceAt, Category.assoc, pullback.lift_snd, GoodReductionJacobian.schemeHomOverComp_coe]
      rw [← Category.assoc, hθ, Category.assoc]

  have E := AlgebraicGeometry.Polarisation.LocIsoOnBase.equivalence (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t))
  have hx' : LocIsoOnBase (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t))
      ((Scheme.Modules.pullback (sliceAt f (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) rfl x))).obj (mumfordBundle f L 𝓛₀))
      (𝟙_ _) := by
    have h1 := AlgebraicGeometry.Polarisation.LocIsoOnBase.pullback_of_comp_eq (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t)) θ (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hθ hx
    refine E.trans ?_ (E.trans h1 (locIso_of_iso _ (Scheme.Modules.pullbackTensorUnitObjIso θ)))
    exact locIso_of_iso _ ((Scheme.Modules.pullbackCongr hθslice.symm).app _ ≪≫
      ((Scheme.Modules.pullbackComp θ (sliceAt f x)).app _).symm)

  have hsq := AlgebraicGeometry.Polarisation.locIsoOnBase_sliceAt_mumfordBundle_mul_tensor k f L hc hA 𝓛₀ h𝓛₀ R' ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) y y
  rw [hy] at hsq

  have h𝓝inv : Scheme.Modules.IsInvertible 𝓝 := isInvertible_of_iso e.symm (h𝓛₀.tensor_monoidalV2 h𝓛₀)
  have hΛ : LocIsoOnBase (pullback.fst f f ≫ f) (mumfordBundle f L 𝓝) (mumfordBundle f L (𝓛₀ ⊗ 𝓛₀)) :=
    AlgebraicGeometry.Polarisation.LocIsoOnBase.mumfordBundle_of_isInvertible f L h𝓝inv (h𝓛₀.tensor_monoidalV2 h𝓛₀)
      (locIso_of_iso f e)
  obtain ⟨eΛ⟩ := AlgebraicGeometry.Polarisation.nonempty_mumfordBundle_tensor_iso_tensor k f L 𝓛₀ 𝓛₀ h𝓛₀ h𝓛₀
  have hcomm : sliceAt f y ≫ (pullback.fst f f ≫ f) = pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) ≫ ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) := by
    rw [← Category.assoc]
    simp only [sliceAt, pullback.lift_fst]
    exact pullback.condition
  have hΛy := AlgebraicGeometry.Polarisation.LocIsoOnBase.pullback_of_comp_eq (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t)) (sliceAt f y) ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t)
    hcomm hΛ

  have hy𝓝 : LocIsoOnBase (pullback.snd f ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t))
      ((Scheme.Modules.pullback (sliceAt f y)).obj (mumfordBundle f L 𝓝)) (𝟙_ _) := by
    refine E.trans hΛy ?_
    refine E.trans (locIso_of_iso _ ((Scheme.Modules.pullback (sliceAt f y)).mapIso eΛ ≪≫
      Scheme.Modules.pullbackTensorObjIso (sliceAt f y) _ _)) ?_
    exact E.trans (E.symm hsq) hx'

  have h2y : L.mul ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) y y = L.one ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) := (h𝓝 R' ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) y).mp hy𝓝
  have hxe : (Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ x.1 = (Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ (L.one t).1 := by
    have h1 : (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) rfl x).1 =
        (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) (rfl : (Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t = (Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) (L.one t)).1 := by
      rw [← hy, h2y, L.one_natural t ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ t) (Spec.map (CommRingCat.ofHom (algebraMap R R'))) rfl]
    simpa only [GoodReductionJacobian.schemeHomOverComp_coe] using h1

  have hL : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) ≫ (Spec.map (CommRingCat.ofHom (algebraMap R R'))) =
      Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R').comp (algebraMap R R'))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have hR : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) ≫ (Spec.map (CommRingCat.ofHom (algebraMap R R'))) =
      Spec.map (CommRingCat.ofHom ((Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom.comp (algebraMap R R'))) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have hglue : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : R' →+* TensorProduct R R' R')) ≫ ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ x.1) =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R' →ₐ[R] TensorProduct R R' R').toRingHom) ≫ ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ x.1) := by
    rw [← Category.assoc, hL, ← Category.assoc, hR, Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap]
  obtain ⟨φ, -, huniq⟩ := AlgebraicGeometry.existsUnique_specMap_comp_eq_of_faithfullyFlat ((Spec.map (CommRingCat.ofHom (algebraMap R R'))) ≫ x.1) hglue
  have hφx : x.1 = φ := huniq x.1 rfl
  have hφe : (L.one t).1 = φ := huniq (L.one t).1 hxe.symm
  exact Subtype.ext (hφx.trans hφe.symm)

