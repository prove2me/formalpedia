-- title:
--   Fact 4, p. 4 (d_k form) — for α > 3, Σ_{k≥1} k‖x_{k+1} − x_k‖²/(2s) ≤ α(3α−5)E(1)/(4s(α−1)(α−3))
-- statement:
--   Under the standing assumptions of §1 ($\Psi$ proper, lower semicontinuous and convex with values in $\mathbb R\cup\{+\infty\}$; $\Phi$ real, convex, continuously differentiable with $L$-Lipschitz gradient; $\Theta=\Psi+\Phi$; $0<s<1/L$; $(x_k)$ generated by algorithm (2)), assume $\alpha>3$, let $x^*$ minimize $\Theta$ and let $\mathcal E(k)$ be the energy (5). Write $d_k=\frac1{2s}\|x_{k+1}-x_k\|^2$. Then
--   $$\sum_{k=1}^{\infty}k\,d_k=\sum_{k=1}^{\infty}k\,\frac{\|x_{k+1}-x_k\|^2}{2s}\le\frac{\alpha(3\alpha-5)\,\mathcal E(1)}{4s(\alpha-1)(\alpha-3)} .$$
--
--   Together with Fact 3 this shows that $\sum_k\frac1k\big[k^2d_k+(k+1)^2\theta_{k+1}\big]<\infty$, the summability used in the proof of Theorem 1.
--
--   **Formalization Note.** The page prints the left side as $\sum_k k\|x_{k+1}-x_k\|^2$ with the same constant. The page's own derivation (the summed form of (15) together with $\theta_1\le\mathcal E(1)/(2s(\alpha-1))$ and Fact 3) gives that constant for $\sum_k k\,d_k$, i.e. with the factor $\frac1{2s}$; the printed version is off by the factor $2s$ and fails, for example, for $\mathcal H=\mathbb R$, $\Psi=0$, $\Phi(x)=0.01x^2/2$, $s=90$, $\alpha=4$, $x_0=x_1=1$. The statement here is the corrected $d_k$ form. The series is stated as a bound on every partial sum $\sum_{k=1}^K$.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 4, Fact 4 (corrected: left side in terms of d_k = ||x_{k+1} - x_k||^2/(2s), as derived on the same page)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem fact_4 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 < α)
    (xstar : H) (hxstar : ∀ y, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ K : ℕ, ((∑ k ∈ Finset.Icc 1 K, (k : ℝ) * (‖x (k + 1) - x k‖ ^ 2 / (2 * s)) : ℝ) : EReal)
      ≤ ((α * (3 * α - 5) / (4 * s * (α - 1) * (α - 3)) : ℝ) : EReal) * energy Ψ Φ α s x xstar 1 := by sorry

end NesterovFB.Rates
