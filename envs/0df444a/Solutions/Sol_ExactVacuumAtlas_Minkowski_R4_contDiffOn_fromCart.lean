theorem solution : ContDiffOn ℝ ∞ fromCart imgCart := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, fromCart_0,
    fromCart_1, fromCart_2, fromCart_3]
  · fun_prop
  · exact ContDiffOn.sqrt (by fun_prop) (fun y hy => (S3_pos hy).ne')
  · intro y hy
    apply ContDiffAt.contDiffWithinAt
    have hsq : ContDiffAt ℝ ∞ (fun y : Pt 4 => √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) y :=
      ContDiffAt.sqrt (by fun_prop) (S3_pos hy).ne'
    have hin : ContDiffAt ℝ ∞ (fun y : Pt 4 => y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) y :=
      ContDiffAt.div (by fun_prop) hsq (rho3_pos hy).ne'
    have hat : ContDiffAt ℝ ∞
        (Real.arccos ∘ fun y : Pt 4 => y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) y :=
      ContDiffAt.comp y
        (Real.contDiffAt_arccos (neg_one_lt_z_div_rho3 hy).ne' (z_div_rho3_lt_one hy).ne) hin
