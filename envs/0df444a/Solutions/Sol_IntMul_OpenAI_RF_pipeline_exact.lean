variable (s : Fin d → ℕ) [∀ i, NeZero (s i)]

lemma ee_add (t a b : Π i, ZMod (s i)) : ee s t (a + b) = ee s t a * ee s t b := by
  unfold ee; rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp [mul_add, AddChar.map_add_eq_mul]

lemma sum_ee (a : Π i, ZMod (s i)) :
    ∑ t, ee s t a = if a = 0 then (Fintype.card (Π i, ZMod (s i)) : ℂ) else 0 := by
  unfold ee
  rw [← Fintype.prod_sum (fun i (x : ZMod (s i)) => ZMod.stdAddChar (x * a i))]
  simp_rw [AddChar.sum_mulShift _ (ZMod.isPrimitive_stdAddChar _)]
  split_ifs with h
  · subst h; simp [Fintype.card_pi]
  · obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by
      by_contra hc; push Not at hc; exact h (funext hc)
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hi])

/-- Multidimensional convolution theorem in the unnormalized form (base thread). -/
theorem conv_eq (u v : (Π i, ZMod (s i)) → ℂ) (j : Π i, ZMod (s i)) :
    ∑ k, u k * v (j - k) =
      (1 / (Fintype.card (Π i, ZMod (s i)) : ℂ)) *
        ∑ t : Π i, ZMod (s i), (∏ i, ZMod.stdAddChar (t i * j i)) *
          ((∑ k : Π i, ZMod (s i), (∏ i, ZMod.stdAddChar (-(t i * k i))) * u k) *
           (∑ k : Π i, ZMod (s i), (∏ i, ZMod.stdAddChar (-(t i * k i))) * v k)) := by
  have hn : (Fintype.card (Π i, ZMod (s i)) : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hneg : ∀ t k : Π i, ZMod (s i), (∏ i, ZMod.stdAddChar (-(t i * k i))) = ee s t (-k) := by
    intro t k; unfold ee; simp [mul_neg]
  simp_rw [hneg]
  change _ = _ * ∑ t, ee s t j * _
  simp_rw [Finset.sum_mul_sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  have key : ∀ k l : Π i, ZMod (s i),
      ∑ t, ee s t j * (ee s t (-k) * u k * (ee s t (-l) * v l)) =
        u k * v l * (if j - k - l = 0 then (Fintype.card (Π i, ZMod (s i)) : ℂ) else 0) := by
    intro k l
    rw [← sum_ee s (j - k - l), Finset.mul_sum]
    refine Finset.sum_congr rfl fun t _ => ?_
    have : ee s t (j - k - l) = ee s t j * ee s t (-k) * ee s t (-l) := by
      rw [sub_eq_add_neg, sub_eq_add_neg, ee_add, ee_add]
    rw [this]; ring
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum, key]
  simp_rw [mul_ite, mul_zero]
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero]
  have : (Finset.univ.filter fun l : Π i, ZMod (s i) => j - k - l = 0) = {j - k} := by
    ext l; simp [sub_eq_zero, eq_comm]
  rw [this, Finset.sum_singleton]
  field_simp

lemma card_pi_eq : (Fintype.card (Π i, ZMod (s i)) : ℂ) = ∏ i, (s i : ℂ) := by
  simp [Fintype.card_pi, ZMod.card]

/-- `F⁺ (F u · F v) = (u ∗ v)/S²`. -/
lemma dftP_mul_dftM (u v : ((i : Fin d) → ZMod (s i)) → ℂ) :
    dftP s (fun k => dftM s u k * dftM s v k) = fun j => cconv s u v j / (∏ i, (s i : ℂ)) ^ 2 := by
  ext j
  have hS : (∏ i, (s i : ℂ)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => by exact_mod_cast NeZero.ne (s i))
  rw [cconv, conv_eq, card_pi_eq]
  simp only [dftP, dftM]
  have e : ∀ t : Π i, ZMod (s i), ∀ k : Π i, ZMod (s i),
      (∏ i, (ZMod.stdAddChar (-(k i * t i)) : ℂ)) = ∏ i, ZMod.stdAddChar (-(t i * k i)) := by
    intro t k; congr 1; ext i; rw [mul_comm]
  simp_rw [e]
  rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_div]
  refine Finset.sum_congr rfl (fun t _ => ?_)
  field_simp

variable (t : Fin d → ℕ)

/-- `F⁺ R = R⁻¹ F⁺` (dilation by units). -/
lemma dftP_Rperm (hcop : ∀ i, Nat.Coprime (s i) (t i)) (z : ((i : Fin d) → ZMod (s i)) → ℂ) :
    dftP s (Rperm s t z) = Rinv s t (dftP s z) := by
  ext j
  simp only [dftP, Rperm, Rinv]
  congr 1
  refine Fintype.sum_equiv (dil s t hcop) _ _ (fun h => ?_)
  simp only [dil, Equiv.piCongrRight_apply, Equiv.coe_fn_mk]
  congr 1
  refine Finset.prod_congr rfl (fun i _ => ?_)
  congr 1
  show h i * j i = (t i * h i) * ((t i : ZMod (s i))⁻¹ * j i)
  rw [mul_comm (t i : ZMod (s i)) (h i), ← mul_assoc, mul_assoc (h i),
    ZMod.coe_mul_inv_eq_one _ (hcop i).symm, mul_one]

lemma Rperm_Rinv (hcop : ∀ i, Nat.Coprime (s i) (t i)) (w : ((i : Fin d) → ZMod (s i)) → ℂ) :
    Rperm s t (Rinv s t w) = w := by
  ext j
  simp only [Rperm, Rinv]
  congr 1; funext i
  rw [← mul_assoc, ZMod.inv_mul_of_unit _ ((ZMod.isUnit_iff_coprime _ _).2 (hcop i).symm), one_mul]

/-- **Lemma 21, identity (37)**: the retained source permutation `R` cancels:
`R F_s⁺ ((R F_s u) · (R F_s v)) = (u ∗ v)/S²`. -/
theorem lemma21_cancel (hcop : ∀ i, Nat.Coprime (s i) (t i))
    (u v : ((i : Fin d) → ZMod (s i)) → ℂ) :
    Rperm s t (dftP s (fun k => Rperm s t (dftM s u) k * Rperm s t (dftM s v) k)) =
      fun j => cconv s u v j / (∏ i, (s i : ℂ)) ^ 2 := by
  have e : (fun k => Rperm s t (dftM s u) k * Rperm s t (dftM s v) k) =
      Rperm s t (fun k => dftM s u k * dftM s v k) := rfl
  rw [e, dftP_Rperm s t hcop, Rperm_Rinv s t hcop, dftP_mul_dftM]

end cancel

