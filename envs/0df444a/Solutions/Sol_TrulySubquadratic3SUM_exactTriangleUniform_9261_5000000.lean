  generalize 2 ^ a = x at *
  have haR : a ≤ x * R := le_trans hx.le (Nat.le_mul_of_pos_right _ hR)
  have hsum : 2 ^ 11 + x ≤ 2 ^ 11 * x := by nlinarith
