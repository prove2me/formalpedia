section
-- Source module: NLogN.HExprCost
/-!
# A uniform cost bound for expressions

If every value an expression computes (and every register it reads) has at most `B` bits, its
code costs at most `size · 10^7 · (B+2)^2`.
-/

namespace NLogN

open IntMul

variable {S : ℕ}

namespace Ex

def size : Ex S → ℕ
  | reg _ | lit _ => 1
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => a.size + b.size + 1
  | neg a | pow2 a => a.size + 1
  | sel c x y => c.size + x.size + y.size + 1

/-- Every value computed along the evaluation has at most `B` bits. -/
def Bnd (s : IState S) (B : ℕ) : Ex S → Prop
  | reg i => zsz (s.top i) ≤ B
  | lit c => zsz c ≤ B
  | add a b => a.Bnd s B ∧ b.Bnd s B ∧ zsz (a.eval s + b.eval s) ≤ B
  | mul a b => a.Bnd s B ∧ b.Bnd s B ∧ zsz (a.eval s * b.eval s) ≤ B
  | shl a b => a.Bnd s B ∧ b.Bnd s B ∧ zsz (a.eval s * b.eval s) ≤ B
  | quo a b => a.Bnd s B ∧ b.Bnd s B
  | rem a b => a.Bnd s B ∧ b.Bnd s B
  | ndiv a b => a.Bnd s B ∧ b.Bnd s B ∧ zsz (a.eval s / b.eval s) ≤ B
  | nmod a b => a.Bnd s B ∧ b.Bnd s B ∧ zsz (a.eval s % b.eval s) ≤ B
  | neg a => a.Bnd s B
  | pow2 a => a.Bnd s B ∧ (a.eval s).toNat + 1 ≤ B
  | sel c x y => c.Bnd s B ∧ (if c.eval s < 0 then x.Bnd s B else y.Bnd s B)

end Ex

end NLogN

end

section
-- Source module: NLogN.HReg
/-!
# Register programs

`RS` is a small structured language over the register stacks `0 … 55`: assignments of
expressions, pushes and pops, conditionals and counted loops.  `RS.run` is its functional
semantics on `IState`s, and `RS.code_runs` shows that the compiled `IStmt` realises it with cost
`RS.cost`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

inductive RS where
  | skip
  /-- replace the top of `i` by the value of `e` -/
  | asg (i : Fin HS) (e : Ex HS)
  /-- push the value of `e` onto `i` -/
  | push (i : Fin HS) (e : Ex HS)
  /-- drop the (integer) top of `i` -/
  | pop (i : Fin HS)
  | seq (a b : RS)
  /-- `if c < 0 then a else b` -/
  | ite (c : Ex HS) (a b : RS)
  /-- push `n` on `i`, then run `body; i := i - 1` until the top of `i` is `0`; pop `i`.
  The body sees the remaining count on top of `i`. -/
  | rep (i : Fin HS) (n : Ex HS) (body : RS)

namespace RS

/-- Stacks a program may write. -/
def writes : RS → List (Fin HS)
  | skip => []
  | asg i _ | push i _ | pop i => [i]
  | seq a b | ite _ a b => a.writes ++ b.writes
  | rep i _ b => i :: b.writes

/-- One decrement of the counter on `i`. -/
def decSt (i : Fin HS) (t : IState HS) : IState HS :=
  t.upd i (.int (t.top i - 1) :: (t.G i).tail)

def run : RS → IState HS → IState HS
  | skip, s => s
  | asg i e, s => s.upd i (.int (e.eval s) :: (s.G i).tail)
  | push i e, s => s.upd i (.int (e.eval s) :: s.G i)
  | pop i, s => s.upd i (s.G i).tail
  | seq a b, s => b.run (a.run s)
  | ite c a b, s => if c.eval s < 0 then a.run s else b.run s
  | rep i n b, s =>
    let t := (fun t => decSt i (b.run t))^[(n.eval s).toNat] (s.upd i (.int (n.eval s) :: s.G i))
    t.upd i (t.G i).tail

/-- The state at the start of iteration `k` of `rep i n b` from `s`. -/
def repSt (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (k : ℕ) : IState HS :=
  (fun t => decSt i (b.run t))^[k] (s.upd i (.int (n.eval s) :: s.G i))

/-- The decrement expression. -/
def decE (i : Fin HS) : Ex HS := .add (.reg i) (.lit (-1))

def asgCost (i : Fin HS) (e : Ex HS) (s : IState HS) : ℕ :=
  e.cost s + (2 * zsz (s.top i) + 2) + (2 * moveCost (zsz (e.eval s)) + 19)

def ok : RS → IState HS → Prop
  | skip, _ => True
  | asg i e, s => i.val < 56 ∧ e.Clean ∧ e.ok s ∧ s.IsInt i
  | push i e, s => i.val < 56 ∧ e.Clean ∧ e.ok s
  | pop i, s => i.val < 56 ∧ s.IsInt i
  | seq a b, s => a.ok s ∧ b.ok (a.run s)
  | ite c a b, s => c.Clean ∧ c.ok s ∧ (if c.eval s < 0 then a.ok s else b.ok s)
  | rep i n b, s => i.val < 56 ∧ n.Clean ∧ n.ok s ∧ 0 ≤ n.eval s ∧ i ∉ b.writes ∧
      ∀ k < (n.eval s).toNat, b.ok (NLogN.RS.repSt i n b s k)

def cost : RS → IState HS → ℕ
  | skip, _ => 1
  | asg i e, s => asgCost i e s

  | push i e, s => e.cost s + (2 * moveCost (zsz (e.eval s)) + 19)
  | pop i, s => 2 * zsz (s.top i) + 2
  | seq a b, s => a.cost s + b.cost (a.run s)
  | ite c a b, s => c.cost s + (2 * moveCost (zsz (c.eval s)) + 19) + (2 * zsz (c.eval s) + 2) +
      25 + (if c.eval s < 0 then a.cost s else b.cost s)
  | rep i n b, s => n.cost s + (2 * moveCost (zsz (n.eval s)) + 19) +
      ((∑ k ∈ Finset.range (n.eval s).toNat,
        (b.cost (NLogN.RS.repSt i n b s k) + asgCost i (decE i) (b.run (NLogN.RS.repSt i n b s k)) + 30)) + 30) + 2

def code : RS → IStmt HS P
  | skip => .skip
  | asg i e => .seq (e.code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i)))
  | push i e => .seq (e.code zX) (.op (.mv zX.V i))
  | pop i => .op (.drop i)
  | seq a b => .seq a.code b.code
  | ite c a b => .seq (c.code zX) (.seq (.op (.mv zX.V zX.A))
      (.ite zX.A (fun k => k == .neg) (.seq (.op (.drop zX.A)) a.code)
        (.seq (.op (.drop zX.A)) b.code)))
  | rep i n b => .seq (.seq (n.code zX) (.op (.mv zX.V i)))
      (.seq (.loop i (fun c => c != .zero)
        (.seq b.code (.seq ((decE i).code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i))))))
        (.op (.drop i)))

/-! ## Frame -/

/-! ## Compilation -/

/-! ## Sequences and reasoning lemmas -/

instance (e : Ex HS) : Decidable e.Clean := by unfold Ex.Clean; infer_instance

/-! ## Cost bounds -/

def seqL : List RS → RS
  | [] => skip
  | [a] => a
  | a :: l => NLogN.RS.seq a (seqL l)

end RS

end NLogN

end

section
-- Source module: NLogN.HList
/-!
# Counted loops through a family of states

`rep_states`: if the body maps the `k`-th logical state (with the counter on top of `i`) to the
`(k+1)`-st, the loop computes the last one.  This is the interface used for list processing.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

/-- The `k`-th logical state with the remaining count `N - k` on top of the counter stack. -/
def withCtr (i : Fin HS) (s : IState HS) (N k : ℕ) (t : IState HS) : IState HS :=
  t.upd i (.int ((N : ℤ) - k) :: s.G i)

/-- Run hypothesis of a counted loop through the states `S 0 = s, …, S N`. -/
structure RepStates (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (S : ℕ → IState HS) :
    Prop where
  nonneg : 0 ≤ n.eval s
  hw : i ∉ b.writes
  h0 : S 0 = s
  hG : ∀ k, (S k).G i = s.G i
  step : ∀ k < (n.eval s).toNat,
    b.run (withCtr i s (n.eval s).toNat k (S k)) = withCtr i s (n.eval s).toNat k (S (k + 1))

end NLogN

end

section
-- Source module: NLogN.HRM
/-!
# Register programs with multiplication calls

`RM` extends the register programs `RS` by `mul k i j`, which pushes `top j * top i` onto `k`
by calling the multiplication procedure `pM` with the calling convention

  `ARG = 55 : a :: b :: L  ↦  (a * b) :: L`,

all other stacks unchanged.  The cost of a call and the inputs on which it may be used are a
parameter `M : MulSpec`; `RM.code_runs` holds whenever the procedure meets `MulOK M`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The argument stack of the multiplication procedure. -/
abbrev ARGM : Fin HS := 55

/-- Cost and domain of the multiplication procedure. -/
structure MulSpec where
  Φ : ℤ → ℤ → ℕ
  dom : ℤ → ℤ → Prop

/-- The procedure `pM` multiplies according to `M`. -/
def MulOK (I : List Sym) (iprog : Fin P → IStmt HS P) (pM : Fin P) (M : MulSpec) : Prop :=
  ∀ (s : IState HS) (a b : ℤ) (L : List Item), M.dom a b → s.G ARGM = .int a :: .int b :: L →
    IRuns I iprog (.call pM) s (s.upd ARGM (.int (a * b) :: L)) (M.Φ a b)

inductive RM where
  | rs (p : RS)
  /-- push `top j * top i` onto `k` -/
  | mul (k i j : Fin HS)
  | seq (a b : RM)
  | ite (c : Ex HS) (a b : RM)
  | rep (i : Fin HS) (n : Ex HS) (body : RM)
  /-- a single item-language operation (e.g. `split`/`cat` with costs independent of the
  untouched high part) -/
  | op (o : IOp HS)
  /-- a call of procedure number `q + 1` (number `0` is the multiplication) with functional
  specification `f`, cost `c`, precondition `pre`, writing only the stacks `w` -/
  | prc (q : ℕ) (f : IState HS → IState HS) (c : IState HS → ℕ) (pre : IState HS → Prop)
      (w : List (Fin HS)) (hf : ∀ s j, j ∉ w → (f s).G j = s.G j)
      (hio : ∀ s, (f s).ip = s.ip ∧ (f s).out = s.out)

/-- The stacks an operation mentions. -/
def IOp.stks : IOp HS → List (Fin HS)
  | .add i j k | .split i j k | .cat i j k => [i, j, k]
  | .neg i | .drop i | .const i _ | .mark i | .unmark i => [i]
  | .dup i j | .mv i j | .shl i j | .read i j _ | .write i j => [i, j]

namespace RM

open RS (decSt decE asgCost)

def writes : RM → List (Fin HS)
  | rs p => p.writes
  | mul k _ _ => [k]
  | seq a b | ite _ a b => a.writes ++ b.writes
  | rep i _ b => i :: b.writes
  | op o => o.stks
  | prc _ _ _ _ w _ _ => w

def run : RM → IState HS → IState HS
  | rs p, s => p.run s
  | mul k i j, s => s.upd k (.int (s.top j * s.top i) :: s.G k)
  | seq a b, s => b.run (a.run s)
  | ite c a b, s => if c.eval s < 0 then a.run s else b.run s
  | rep i n b, s =>
    let t := (fun t => decSt i (b.run t))^[(n.eval s).toNat] (s.upd i (.int (n.eval s) :: s.G i))
    t.upd i (t.G i).tail
  | op o, s => match o.run s with
    | some r => r.1
    | none => s
  | prc _ f _ _ _ _ _, s => f s

def repSt (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (k : ℕ) : IState HS :=
  (fun t => decSt i (b.run t))^[k] (s.upd i (.int (n.eval s) :: s.G i))

def mulCost (M : MulSpec) (k i j : Fin HS) (s : IState HS) : ℕ :=
  (dupCost (zsz (s.top i)) + 17) + (dupCost (zsz (s.top j)) + 17) +
    (M.Φ (s.top j) (s.top i) + 2) + (2 * moveCost (zsz (s.top j * s.top i)) + 19)

def ok (M : MulSpec) : RM → IState HS → Prop
  | rs p, s => p.ok s
  | mul k i j, s => k.val < 55 ∧ i.val < 55 ∧ j.val < 55 ∧ s.IsInt i ∧ s.IsInt j ∧
      M.dom (s.top j) (s.top i)
  | seq a b, s => ok M a s ∧ ok M b (a.run s)
  | ite c a b, s => c.Clean ∧ c.ok s ∧ (if c.eval s < 0 then ok M a s else ok M b s)
  | rep i n b, s => i.val < 56 ∧ n.Clean ∧ n.ok s ∧ 0 ≤ n.eval s ∧ i ∉ b.writes ∧
      ∀ k < (n.eval s).toNat, ok M b (repSt i n b s k)
  | op o, s => (o.run s).isSome
  | prc _ _ _ pre _ _ _, s => pre s

def cost (M : MulSpec) : RM → IState HS → ℕ
  | rs p, s => p.cost s
  | mul k i j, s => mulCost M k i j s
  | seq a b, s => cost M a s + cost M b (a.run s)
  | ite c a b, s => c.cost s + (2 * moveCost (zsz (c.eval s)) + 19) + (2 * zsz (c.eval s) + 2) +
      25 + (if c.eval s < 0 then cost M a s else cost M b s)
  | rep i n b, s => n.cost s + (2 * moveCost (zsz (n.eval s)) + 19) +
      ((∑ k ∈ Finset.range (n.eval s).toNat,
        (cost M b (repSt i n b s k) + asgCost i (decE i) (b.run (repSt i n b s k)) + 30)) + 30) + 2
  | op o, s => match o.run s with
    | some r => r.2
    | none => 0
  | prc _ _ c _ _ _ _, s => c s

def code (pM : Fin P) (pc : ℕ → Fin P) : RM → IStmt HS P
  | rs p => p.code
  | mul k i j => .seq (.op (.dup i ARGM)) (.seq (.op (.dup j ARGM)) (.seq (.call pM)
      (.op (.mv ARGM k))))
  | seq a b => .seq (code pM pc a) (code pM pc b)
  | ite c a b => .seq (c.code zX) (.seq (.op (.mv zX.V zX.A))
      (.ite zX.A (fun k => k == .neg) (.seq (.op (.drop zX.A)) (code pM pc a))
        (.seq (.op (.drop zX.A)) (code pM pc b))))
  | rep i n b => .seq (.seq (n.code zX) (.op (.mv zX.V i)))
      (.seq (.loop i (fun c => c != .zero)
        (.seq (code pM pc b) (.seq ((decE i).code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i))))))
        (.op (.drop i)))
  | op o => .op o
  | prc q _ _ _ _ _ _ => .call (pc (q + 1))

/-! ## Frame -/

variable (I iprog) in
/-- Every called procedure meets its specification. -/
def PrcOK (pc : ℕ → Fin P) : RM → Prop
  | prc q f c pre _ _ _ => ∀ s, pre s → IRuns I iprog (.call (pc (q + 1))) s (f s) (c s)
  | seq a b | ite _ a b => PrcOK pc a ∧ PrcOK pc b
  | rep _ _ b => PrcOK pc b
  | rs _ | mul _ _ _ | op _ => True

/-! ## Reasoning lemmas -/

def seqL : List RM → RM
  | [] => rs .skip
  | [a] => a
  | a :: l => NLogN.RM.seq a (seqL l)

/-! ## Counted loops through a family of states -/

structure RepStates (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (S : ℕ → IState HS) :
    Prop where
  nonneg : 0 ≤ n.eval s
  hw : i ∉ b.writes
  h0 : S 0 = s
  hG : ∀ k, (S k).G i = s.G i
  step : ∀ k < (n.eval s).toNat,
    b.run (withCtr i s (n.eval s).toNat k (S k)) = withCtr i s (n.eval s).toNat k (S (k + 1))

end RM

end NLogN

end

section
-- Source module: NLogN.HExprLin
/-!
# Linear cost bound for multiplication-free expressions

Expressions built from registers, literals, `add`, `neg`, `shl`, `quo`, `rem` and `sel` cost at
most `size · 2000 · (B + 2)` when every value has at most `B` bits.  This is what per-element
list operations use; products of large numbers go through the multiplication procedure instead.
-/

namespace NLogN

open IntMul

variable {S : ℕ}

namespace Ex

/-- No `mul`, `pow2`, `ndiv`, `nmod`. -/
def Lin : Ex S → Prop
  | reg _ | lit _ => True
  | add a b | shl a b | quo a b | rem a b => a.Lin ∧ b.Lin
  | neg a => a.Lin
  | sel c x y => c.Lin ∧ x.Lin ∧ y.Lin
  | mul _ _ | pow2 _ | ndiv _ _ | nmod _ _ => False

end Ex

end NLogN

end

section
-- Source module: NLogN.HRen
/-!
# Renaming stacks and procedures of item-language programs

Given a map of stacks `f : Fin S → Fin S'` and a map of procedure indices `g : Fin P → Fin P'`,
`IStmt.ren f g` renames every stack `i` to `f i` and every call `j` to `g j`.  For injective `f`,
executions are simulated: a run from `s` to `s'` becomes a run from `embed f s t` to `embed f s' t`,
where `IState.embed f s t` is `t` with the stacks in the image of `f` overwritten by those of `s`
(and `ip`, `out` taken from `s`).  Stacks outside the image of `f` are untouched.
-/

namespace NLogN

open IntMul

variable {S S' P P' : ℕ}

/-- Rename the stacks of an operation. -/
def IOp.ren (f : Fin S → Fin S') : IOp S → IOp S'
  | .add i j k => .add (f i) (f j) (f k)
  | .neg i => .neg (f i)
  | .dup i j => .dup (f i) (f j)
  | .drop i => .drop (f i)
  | .mv i j => .mv (f i) (f j)
  | .const i c => .const (f i) c
  | .mark i => .mark (f i)
  | .unmark i => .unmark (f i)
  | .shl i j => .shl (f i) (f j)
  | .split i j k => .split (f i) (f j) (f k)
  | .read i j stop => .read (f i) (f j) stop
  | .write i j => .write (f i) (f j)
  | .cat i j k => .cat (f i) (f j) (f k)

/-- Rename the stacks (by `f`) and the called procedures (by `g`) of a program. -/
def IStmt.ren (f : Fin S → Fin S') (g : Fin P → Fin P') : IStmt S P → IStmt S' P'
  | .skip => .skip
  | .op o => .op (o.ren f)
  | .seq p q => .seq (p.ren f g) (q.ren f g)
  | .ite i c p q => .ite (f i) c (p.ren f g) (q.ren f g)
  | .loop i c p => .loop (f i) c (p.ren f g)
  | .call j => .call (g j)

/-- `t` with the stacks `f x` replaced by `s.G x`; `ip` and `out` are those of `s`. -/
noncomputable def IState.embed (f : Fin S → Fin S') (s : IState S) (t : IState S') : IState S' :=
  ⟨Function.extend f s.G t.G, s.ip, s.out⟩

/-- The state seen through `f`. -/
def IState.pull (f : Fin S → Fin S') (t : IState S') : IState S :=
  ⟨fun x => t.G (f x), t.ip, t.out⟩

@[simp] theorem IState.pull_G (f : Fin S → Fin S') (t : IState S') (x : Fin S) :
    (IState.pull f t).G x = t.G (f x) := rfl
@[simp] theorem IState.pull_ip (f : Fin S → Fin S') (t : IState S') :
    (IState.pull f t).ip = t.ip := rfl
@[simp] theorem IState.pull_out (f : Fin S → Fin S') (t : IState S') :
    (IState.pull f t).out = t.out := rfl

@[simp] theorem IState.embed_ip (f : Fin S → Fin S') (s : IState S) (t : IState S') :
    (IState.embed f s t).ip = s.ip := rfl
@[simp] theorem IState.embed_out (f : Fin S → Fin S') (s : IState S) (t : IState S') :
    (IState.embed f s t).out = s.out := rfl

section Inj

variable {f : Fin S → Fin S'} (hf : Function.Injective f)
include hf

variable {I : List Sym}

end Inj

end NLogN

end

section
-- Source module: NLogN.HRenRM
/-!
# Relocating register programs

For a permutation `σ` of the `HS` stacks fixing every stack `≥ 55` (the multiplication argument
`55` and the expression scratch `56..63`), `Ex.ren σ`, `RS.ren σ`, `RM.ren σ` rename every register
`i` to `σ i`.  On the relocated state `IState.rn σ s` (stack `σ i` holds the old stack `i`) the
renamed program computes the relocated result, with the same side conditions and the same cost.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

/-! ## Relocated states -/

/-- Stack `σ i` of the new state holds stack `i` of `s`; `ip`, `out` unchanged. -/
def IState.rn (σ : Equiv.Perm (Fin HS)) (s : IState HS) : IState HS :=
  ⟨fun y => s.G (σ.symm y), s.ip, s.out⟩

variable (σ : Equiv.Perm (Fin HS))

namespace IState

theorem rn_G' (s : IState HS) (y : Fin HS) : (s.rn σ).G y = s.G (σ.symm y) := rfl
@[simp] theorem rn_ip (s : IState HS) : (s.rn σ).ip = s.ip := rfl
@[simp] theorem rn_out (s : IState HS) : (s.rn σ).out = s.out := rfl

end IState

/-! ## Permutations fixing the reserved stacks -/

/-- `σ` fixes every stack `≥ 55`. -/
def FixHi (σ : Equiv.Perm (Fin HS)) : Prop := ∀ i : Fin HS, 55 ≤ i.val → σ i = i

instance (σ : Equiv.Perm (Fin HS)) : Decidable (FixHi σ) := by unfold FixHi; infer_instance

variable {σ}

/-! ## Expressions -/

namespace Ex

/-- Rename the registers of an expression. -/
def ren (σ : Equiv.Perm (Fin HS)) : Ex HS → Ex HS
  | reg i => reg (σ i)
  | lit c => lit c
  | add a b => add (a.ren σ) (b.ren σ)
  | neg a => neg (a.ren σ)
  | mul a b => mul (a.ren σ) (b.ren σ)
  | shl a r => shl (a.ren σ) (r.ren σ)
  | quo a r => quo (a.ren σ) (r.ren σ)
  | rem a r => rem (a.ren σ) (r.ren σ)
  | pow2 a => pow2 (a.ren σ)
  | sel c x y => sel (c.ren σ) (x.ren σ) (y.ren σ)
  | ndiv a b => ndiv (a.ren σ) (b.ren σ)
  | nmod a b => nmod (a.ren σ) (b.ren σ)

variable (σ)

variable {σ}

end Ex

/-! ## Register programs -/

namespace RS

def ren (σ : Equiv.Perm (Fin HS)) : RS → RS
  | skip => skip
  | asg i e => asg (σ i) (e.ren σ)
  | push i e => push (σ i) (e.ren σ)
  | pop i => pop (σ i)
  | seq a b => NLogN.RS.seq (a.ren σ) (b.ren σ)
  | ite c a b => ite (c.ren σ) (a.ren σ) (b.ren σ)
  | rep i n b => rep (σ i) (n.ren σ) (b.ren σ)

variable (σ)

variable {σ}

end RS

/-! ## Operations -/

/-! ## Register programs with multiplication -/

namespace RM

open RS (decSt decE asgCost)

def ren (σ : Equiv.Perm (Fin HS)) : RM → RM
  | rs p => rs (p.ren σ)
  | mul k i j => mul (σ k) (σ i) (σ j)
  | seq a b => NLogN.RM.seq (a.ren σ) (b.ren σ)
  | ite c a b => ite (c.ren σ) (a.ren σ) (b.ren σ)
  | rep i n b => rep (σ i) (n.ren σ) (b.ren σ)
  | op o => op (o.ren σ)
  | prc q f c pre w hf hio => NLogN.RM.prc q (fun t => (f (t.rn σ⁻¹)).rn σ) (fun t => c (t.rn σ⁻¹))
      (fun t => pre (t.rn σ⁻¹)) (w.map σ)
      (fun t j hj => by
        have hj' : σ.symm j ∉ w := fun h => hj (List.mem_map.2 ⟨_, h, by simp⟩)
        rw [IState.rn_G', hf _ _ hj', IState.rn_G']
        simp [Equiv.Perm.inv_def])
      (fun t => by simpa using hio (t.rn σ⁻¹))

variable (σ)

variable {σ}

/-! ## Reading off specifications -/

end RM

namespace RS

end RS

/-! ## Building permutations from swaps -/

/-- The product `swap a₁ b₁ * swap a₂ b₂ * ⋯` (the last swap is applied first). -/
def swapsPerm : List (Fin HS × Fin HS) → Equiv.Perm (Fin HS)
  | [] => 1
  | (a, b) :: l => Equiv.swap a b * swapsPerm l

/-- All swapped stacks are below `55` (a `Bool` check, closed by `rfl`/`decide` on literals). -/
def swapsLow (l : List (Fin HS × Fin HS)) : Bool := l.all fun p => p.1.val < 55 && p.2.val < 55

end NLogN

end

section
-- Source module: NLogN.HIface
/-!
# Interface for multiplication calls inside one recursive step

`MulBnd M m Φm`: the multiplication procedure accepts every pair of operands of at most `m` bits
and costs at most `Φm` on them.  Subroutines state their costs as
`(linear part) + (number of calls) · Φm`.
-/

namespace NLogN

open IntMul

def MulBnd (M : MulSpec) (m Φm : ℕ) : Prop :=
  ∀ a b : ℤ, zsz a ≤ m → zsz b ≤ m → M.dom a b ∧ M.Φ a b ≤ Φm

namespace RM

end RM

end NLogN

end

section
-- Source module: NLogN.SSLoops
/-!
# Generic counted loops over item arrays
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- Decrement the counter on top of `C` (uses `T3`). -/
def decC (C : Fin NS) : IStmt NS P := .seq (.op (.const T3 (-1))) (.op (.add C T3 C))

/-- Move `k` integers from `X` to `Y` (reversing them); `k` is the counter on top of `C`. -/
def mvN (X Y C : Fin NS) : IStmt NS P :=
  .loop C (fun c => c != .zero) (.seq (.op (.mv X Y)) (decC C))

def ints (A : List ℤ) : List Item := A.map .int

@[simp] theorem ints_nil : ints [] = [] := rfl
@[simp] theorem ints_cons (a : ℤ) (A : List ℤ) : ints (a :: A) = .int a :: ints A := rfl

/-- All entries have at most `m` bits. -/
def Bnd (m : ℕ) (A : List ℤ) : Prop := ∀ a ∈ A, zsz a ≤ m

end NLogN

end


