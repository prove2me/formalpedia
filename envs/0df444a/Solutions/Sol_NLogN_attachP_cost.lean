section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
theorem solution (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d) (hm : 1 ≤ m)
    (L1 L2 : List Item) (h0 : s.G 0 = ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) (X : ℕ) (hDB : ∀ r ∈ D, Bnd X r)
    (hX1 : zsz ((n * m + n : ℕ) : ℤ) ≤ X) (hX2 : zsz ((n * m * (d + 1) : ℕ) : ℤ) ≤ X)
    (hXd : zsz ((d + 1 : ℕ) : ℤ) ≤ X) :
    (attachP d).cost s ≤ 100000 * (n * m + 1) * (d + 1) * (X + 2) := by
  have H := NLogN.outer_states d n m D Rest s hD hDw L1 L2 h1 h2
  have g1 : (NLogN.outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
    rw [NLogN.outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
      (by decide), h1]
  have e1 : (NLogN.Ex.reg (S := NLogN.HS) 1).eval (NLogN.outerSt s D Rest n m d 0) = n := by
    simp [NLogN.Ex.eval, NLogN.IState.top_eq g1]
  have hz : (NLogN.RS.push 54 (.lit 0)).run ((NLogN.RS.push 45 (.lit 0)).run ((NLogN.RS.push 42 (.lit 0)).run s)) =
      NLogN.outerSt s D Rest n m d 0 := by
    apply NLogN.IState.ext' _ (by simp [NLogN.outerSt]) (by simp [NLogN.outerSt])
    intro x
    simp only [NLogN.outerSt, NLogN.IState.upd_G, NLogN.RS.run_push_G, NLogN.Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0, NLogN.kflat]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [NLogN.kflat]
    split_ifs <;> simp_all
  have hloop : (NLogN.outerLoop d).run (NLogN.outerSt s D Rest n m d 0) = NLogN.outerSt s D Rest n m d n := by
    rw [NLogN.outerLoop, H.run, e1, Int.toNat_natCast]
  have q1 : NLogN.zsz (n : ℤ) ≤ X := NLogN.zsz_le_of_nat_le (by omega) hX1
  have cl := H.cost_le_lin X (m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) +
      17000 * (X + 2)) (by simp [NLogN.Ex.Lin])
    (by simp only [NLogN.Ex.Bnd]; rw [← NLogN.Ex.eval, e1]; exact q1) (by
      intro i hi
      rw [e1, Int.toNat_natCast] at hi ⊢
      exact NLogN.row_cost d n m D Rest s hD hDw L1 L2 h1 h2 _ _ i hi X hDB hX1 hX2 hXd)
  rw [e1, Int.toNat_natCast] at cl
  have cl' : (NLogN.outerLoop d).cost (NLogN.outerSt s D Rest n m d 0) ≤ (1 + 1) * 2000 * (X + 2) +
      n * (m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) + 17000 * (X + 2) +
        8000 * (X + 2) + 30) + 32 := cl
  set t := NLogN.outerSt s D Rest n m d n with ht
  have hkl := NLogN.kflat_length n m d D hDw (n * m) (by omega)
  have t40 : t.G 40 = NLogN.ints (NLogN.kflat n m D (n * m)).reverse ++ s.G 40 := by simp [ht, NLogN.outerSt]
  have t45 : t.G 45 = .int (((NLogN.kflat n m D (n * m)).reverse.length : ℕ) : ℤ) :: s.G 45 := by
    simp [ht, NLogN.outerSt, hkl]
  have hkB : NLogN.Bnd X (NLogN.kflat n m D (n * m)).reverse := by
    intro x hx
    simp only [List.mem_reverse, NLogN.kflat, List.mem_flatten, List.mem_map, List.mem_range] at hx
    obtain ⟨r, ⟨p, hp, rfl⟩, hx⟩ := hx
    simp only [NLogN.keyRec, List.mem_cons] at hx
    rcases hx with rfl | hx
    · refine NLogN.zsz_le_of_nat_le (b := n * m + n) ?_ hX1
      have : p / m < n := Nat.div_lt_of_lt_mul (by rwa [Nat.mul_comm] at hp)
      have : (p % m) * n + n ≤ m * n := by
        have := Nat.mod_lt p (by omega : 0 < m)
        have := Nat.mul_le_mul_right n this; nlinarith
      nlinarith
    · rw [List.getD_eq_getElem _ _ (by omega : p < D.length)] at hx
      exact hDB _ (List.getElem_mem _) x hx
  have cm := NLogN.mvK_cost (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (.reg 45)
    t _ (s.G 40) t40 (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t45]) X hkB trivial
    (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t45, List.length_reverse, hkl]; exact hX2)
  have hs : (NLogN.Ex.reg (S := NLogN.HS) 45).size = 1 := rfl
  rw [hs, List.length_reverse, hkl] at cm
  simp only [NLogN.attachP, NLogN.cost_seq, NLogN.cost_push_lit0]
  rw [hz, hloop]
  have hn : n ≤ n * m := Nat.le_mul_of_pos_right _ hm
  have hA : X + 2 ≤ (d + 1) * (X + 2) := Nat.le_mul_of_pos_left _ (by omega)
  have b1 : m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) ≤
      m * (41030 * ((d + 1) * (X + 2))) := Nat.mul_le_mul_left m (by nlinarith)
  have b2 : 17000 * (X + 2) + 8000 * (X + 2) + 30 ≤ 25030 * ((d + 1) * (X + 2)) := by nlinarith
  have b3 : n * (m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) + 17000 * (X + 2) +
      8000 * (X + 2) + 30) ≤ n * (m * (41030 * ((d + 1) * (X + 2))) +
        25030 * ((d + 1) * (X + 2))) := Nat.mul_le_mul_left n (by linarith)
  have b4 : n * ((d + 1) * (X + 2)) ≤ n * m * ((d + 1) * (X + 2)) :=
    Nat.mul_le_mul_right _ hn
  have e1 : n * (m * (41030 * ((d + 1) * (X + 2))) + 25030 * ((d + 1) * (X + 2))) =
      41030 * (n * m * ((d + 1) * (X + 2))) + 25030 * (n * ((d + 1) * (X + 2))) := by ring
  have e2 : n * m * (d + 1) * (14000 * (X + 2)) = 14000 * (n * m * ((d + 1) * (X + 2))) := by ring
  have e : 100000 * (n * m + 1) * (d + 1) * (X + 2) =
      100000 * (n * m * ((d + 1) * (X + 2))) + 100000 * ((d + 1) * (X + 2)) := by ring
  rw [e1] at b3
  rw [e2] at cm
  rw [e]
  linarith
end
