-- Source module: Solutions.KFURevBase
/-!
# KFU §3: labelled layouts for the axis reversal

Addresses of the working array are tracked through *layouts*: lists of atom labels (`2j` is the
main part of axis `j`, of size `mz j`; `2j+1` is its extra bit, of size `2`, present when
`bg j`).  An axis of size `tz j = mz j · (2 if bg j)` is the pair `[mz j, 2]` in row-major order.

* `Dl ax0 lay xs`: the array `xs` (shape `ax0.map tz`) viewed in the layout `lay`.
* `POp g σ n`: an address map `g = permIdx σ` on `n` digits, `σ` onto `[0, n)`.
* `Dl_step`: a program realizing `pull (g lay').map asz → lay'.map asz` by `g` turns
  `Dl ax0 (g lay')` into `Dl ax0 lay'`.  `swapPos` and `KIL.swapMid` are `POp`s.
* `Dl_layA`: for the standard layout `layA ax` of an axis order `ax`, `Dl` is an ordinary pull
  onto `ax.map tz`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFU

open AModel AModelL12

/-! ## Position permutations -/

/-! ### `swapPos` -/

/-! ### `swapMid` -/

/-! ## Layouts -/

/-! ## The standard layout -/

theorem idxOf_append_of_notMem {x : ℕ} {P Q : List ℕ} (h : x ∉ P) :
    (P ++ Q).idxOf x = P.length + Q.idxOf x := by
  induction P with
  | nil => simp
  | cons a P ih =>
    simp only [List.mem_cons, not_or] at h
    rw [List.cons_append, List.idxOf_cons_ne _ (Ne.symm h.1), ih h.2]; simp; omega

theorem getD_drop' (b : List ℕ) (k i : ℕ) : (b.drop k).getD i 0 = b.getD (k + i) 0 := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_drop]

section Std

variable (mz : ℕ → ℕ) (bg : ℕ → Bool)

theorem layA_cons (j : ℕ) (L : List ℕ) : layA bg (j :: L) = atm bg j ++ layA bg L := by
  simp [layA]

theorem mem_atm {j x : ℕ} : x ∈ atm bg j → x / 2 = j := by
  unfold atm; intro h; simp only [List.mem_cons] at h
  rcases h with rfl | h
  · omega
  · split_ifs at h <;> simp at h; omega

theorem vol_atm (j : ℕ) : vol ((atm bg j).map (asz mz)) = tz mz bg j := by
  unfold atm tz asz; split_ifs <;> simp [vol] <;> omega

theorem vol_layA : ∀ (L : List ℕ), vol ((layA bg L).map (asz mz)) = vol (L.map (tz mz bg))
  | [] => by simp [layA, vol]
  | j :: L => by
    rw [layA_cons, List.map_append, vol_append, vol_atm, vol_layA L]; simp

/-- **The merged digits of the standard layout.** -/
theorem enc_layA_sol_aux : ∀ (ax : List ℕ), ax.Nodup → (∀ j ∈ ax, 1 ≤ mz j) → ∀ b : List ℕ,
    Valid ((layA bg ax).map (asz mz)) b →
    Valid (ax.map (tz mz bg)) (ax.map (dig bg (layA bg ax) b)) ∧
      encode (ax.map (tz mz bg)) (ax.map (dig bg (layA bg ax) b)) =
        encode ((layA bg ax).map (asz mz)) b
  | [], _, _, b, hb => by
    have : b = [] := by have := hb.length_eq; simp [layA] at this; exact this
    subst this; simp [Valid, encode, layA]
  | j :: ax, hnd, hmz, b, hb => by
    obtain ⟨hj, hax⟩ := List.nodup_cons.1 hnd
    set k := (atm bg j).length
    rw [layA_cons, List.map_append] at hb
    have hlk : ((atm bg j).map (asz mz)).length = k := by simp [k]
    obtain ⟨hb1, hb2⟩ := (KIL.valid_append_iff (A := (atm bg j).map (asz mz))
      (C := (layA bg ax).map (asz mz)) (a := b.take k) (c := b.drop k)
      (by have := hb.length_eq; simp [k] at this ⊢; omega)).1 (by rw [List.take_append_drop]; exact hb)
    have IH := enc_layA_sol_aux ax hax (fun j' hj' => hmz j' (by simp [hj'])) (b.drop k) hb2
    -- the other digits
    have hrest : ax.map (dig bg (layA bg (j :: ax)) b) = ax.map (dig bg (layA bg ax) (b.drop k)) := by
      apply List.map_congr_left
      intro j' hj'
      have hne : j' ≠ j := fun h => hj (h ▸ hj')
      have n1 : 2 * j' ∉ atm bg j := fun h => hne (by have := mem_atm bg h; omega)
      have n2 : 2 * j' + 1 ∉ atm bg j := fun h => hne (by have := mem_atm bg h; omega)
      unfold dig
      rw [layA_cons, idxOf_append_of_notMem n1, idxOf_append_of_notMem n2, getD_drop', getD_drop']
    -- the first digit
    have hm : 1 ≤ mz j := hmz j (by simp)
    have hbl : b.length = k + (layA bg ax).length := by
      have := hb.length_eq; simp [k] at this ⊢; omega
    obtain ⟨-, hlt⟩ := (valid_iff _ _).1 hb1
    simp only [List.map_cons]
    rw [hrest, layA_cons]
    unfold Valid at IH ⊢
    have eb : encode ((atm bg j ++ layA bg ax).map (asz mz)) b =
        encode ((atm bg j).map (asz mz)) (b.take k) * vol ((layA bg ax).map (asz mz)) +
          encode ((layA bg ax).map (asz mz)) (b.drop k) := by
      conv_lhs => rw [List.map_append, ← List.take_append_drop k b]
      exact encode_append_len _ _ (by simp [k]; omega)
    rw [eb]
    simp only [encode, List.headD_cons, List.tail_cons]
    rw [IH.2, vol_layA]
    by_cases hbj : bg j = true
    · have hk : k = 2 := by simp [k, atm, hbj]
      have h0 := hlt 0 (by simp; omega) (by simp [atm, hbj])
      have h1 := hlt 1 (by simp; omega) (by simp [atm, hbj])
      simp only [List.getElem_take, List.getElem_map, atm, hbj, if_true, List.getElem_cons_zero,
        List.getElem_cons_succ, asz] at h0 h1
      have e0 : (2 * j) % 2 = 0 := by omega
      have e1 : (2 * j + 1) % 2 = 1 := by omega
      simp only [e0, if_true, show (2 * j) / 2 = j by omega, e1, show (1 : ℕ) ≠ 0 by omega,
        if_false] at h0 h1
      have d0 : dig bg (atm bg j ++ layA bg ax) b j = b[0]'(by omega) * 2 + b[1]'(by omega) := by
        unfold dig
        rw [if_pos hbj]
        have i0 : (atm bg j ++ layA bg ax).idxOf (2 * j) = 0 := by simp [atm]
        have i1 : (atm bg j ++ layA bg ax).idxOf (2 * j + 1) = 1 := by
          simp [atm, hbj, List.idxOf_cons_ne]
        rw [i0, i1, List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)]
      rw [d0]
      refine ⟨List.Forall₂.cons ?_ IH.1, ?_⟩
      · simp only [tz, hbj, if_true]; omega
      · have et : encode ((atm bg j).map (asz mz)) (b.take k) = b[0]'(by omega) * 2 + b[1]'(by omega) := by
          have : b.take k = [b[0]'(by omega), b[1]'(by omega)] := by
            rw [hk]; apply List.ext_getElem (by simp; omega)
            intro i h1 h2; simp at h2; interval_cases i <;> simp
          rw [this]
          simp [atm, hbj, encode, asz, vol, e1]
        rw [et]
    · have hbj' : bg j = false := by simpa using hbj
      have hk : k = 1 := by simp [k, atm, hbj']
      have h0 := hlt 0 (by simp; omega) (by simp [atm, hbj'])
      simp only [List.getElem_take, List.getElem_map, atm, hbj', List.getElem_cons_zero, asz] at h0
      have e0 : (2 * j) % 2 = 0 := by omega
      simp only [e0, if_true, show (2 * j) / 2 = j by omega] at h0
      have d0 : dig bg (atm bg j ++ layA bg ax) b j = b[0]'(by omega) := by
        unfold dig
        rw [if_neg hbj]
        have i0 : (atm bg j ++ layA bg ax).idxOf (2 * j) = 0 := by simp [atm]
        rw [i0, List.getD_eq_getElem _ _ (by omega)]
      rw [d0]
      refine ⟨List.Forall₂.cons ?_ IH.1, ?_⟩
      · simp only [tz, hbj']; simpa using h0
      · have et : encode ((atm bg j).map (asz mz)) (b.take k) = b[0]'(by omega) := by
          have : b.take k = [b[0]'(by omega)] := by
            rw [hk]; apply List.ext_getElem (by simp; omega)
            intro i h1 h2
            obtain rfl : i = 0 := by simp at h2; omega
            simp
          rw [this]
          simp [atm, hbj', encode, asz, vol]
        rw [et]

end Std

end NLogN.KFU

