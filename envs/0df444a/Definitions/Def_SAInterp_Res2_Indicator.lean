namespace SAInterp.Res2

open Classical

/-!
# Multivalued variables, the indicator algebra, indicator designs and booleanization

Acheampong, Davis, Robere, *Polynomial Interpolation for Sherali-Adams Lower Bounds*,
STOC 2027 submission (manuscript sha256 8de0a787…), §2.3 pp. 19–21 (Definitions 2.9–2.15).

* A collection of multivalued variables is a finite type `V` of variables with a range size
  `size v`; the range of `v` is `Fin (size v)` (the paper's finite set `S_v`, listed as
  `a_{v,0}, …, a_{v,|S_v|−1}`).
* An indicator `⟦x_v = j⟧` is a pair `⟨v, j⟩ : Σ v, Fin (size v)`. An indicator conjunction is a
  finite set of indicators; a multivalued clause `⋁ ⟦x_v ≠ j⟧` is the finite set of the
  indicators it negates; a multivalued CNF is a finite set of such clauses.
* `A(X) = ℝ[I(X)] / 𝒥` is the quotient of `MvPolynomial (Σ v, Fin (size v)) ℝ` by the ideal of
  Definition 2.11.
* Booleanization (p. 21): when `size v = 2 ^ w v`, the variable `v` is encoded by `w v` boolean
  variables `⟨v, k⟩ : Σ v, Fin (w v)`, and `x_v = a_{v,j}` iff `∑_k 2^k x_{v,k} = j`, i.e. bit `k`
  of the encoding is the `k`-th binary digit `j.testBit k`.
-/

variable {V : Type} [Fintype V]

/-- The indicators `I(X)`: pairs `⟨v, j⟩` standing for `⟦x_v = j⟧`. -/
abbrev Indicator (size : V → ℕ) := Σ v : V, Fin (size v)

/-- A total assignment to the multivalued variables. -/
abbrev MVAssignment (size : V → ℕ) := ∀ v : V, Fin (size v)

/-- An indicator conjunction `∏ ⟦x_{vᵢ} = jᵢ⟧`. -/
abbrev IndConj (size : V → ℕ) := Finset (Indicator size)

/-- A multivalued clause `⋁ᵢ ⟦x_{vᵢ} ≠ jᵢ⟧`, given by the set of its indicators `⟨vᵢ, jᵢ⟩`. -/
abbrev MVClause (size : V → ℕ) := Finset (Indicator size)

/-- A multivalued CNF: a finite set of multivalued clauses. -/
abbrev MVCNF (size : V → ℕ) := Finset (MVClause size)

/-- An assignment satisfies an indicator conjunction when it gives every variable the value
named by each of its indicators. -/
def IndConjSat {size : V → ℕ} (a : MVAssignment size) (C : IndConj size) : Prop :=
  ∀ x ∈ C, a x.1 = x.2

/-- An assignment satisfies `⋁ᵢ ⟦x_{vᵢ} ≠ jᵢ⟧` when it differs from one of the named values. -/
def MVClauseSat {size : V → ℕ} (a : MVAssignment size) (Cl : MVClause size) : Prop :=
  ∃ x ∈ Cl, a x.1 ≠ x.2

/-- `C ⇒ C̄ᵢ` for an indicator conjunction `C` and a multivalued clause `Cᵢ`: every assignment
satisfying `C` falsifies `Cᵢ`. -/
def IndWitnesses {size : V → ℕ} (C : IndConj size) (Ci : MVClause size) : Prop :=
  ∀ a : MVAssignment size, IndConjSat a C → ¬ MVClauseSat a Ci

/-- The block degree `bdeg(C)` of an indicator conjunction: the number of distinct variables
whose indicators occur in it (Definition 2.9). -/
noncomputable def bdeg {size : V → ℕ} (C : IndConj size) : ℕ := (C.image Sigma.fst).card

/-- The polynomial ring `ℝ[I(X)]` over the indicators. -/
abbrev IndPoly (size : V → ℕ) := MvPolynomial (Indicator size) ℝ

/-- The ideal `𝒥` of Definition 2.11, generated by `1 − ∑_{i} ⟦x_v = i⟧`,
`⟦x_v = i⟧⟦x_v = i⟧ − ⟦x_v = i⟧` and `⟦x_v = i⟧⟦x_v = k⟧` for `i ≠ k`. -/
noncomputable def indIdeal (size : V → ℕ) : Ideal (IndPoly size) :=
  Ideal.span
    ((Set.range fun v : V => (1 - ∑ i : Fin (size v), MvPolynomial.X ⟨v, i⟩ : IndPoly size)) ∪
      (Set.range fun x : Indicator size =>
        (MvPolynomial.X x * MvPolynomial.X x - MvPolynomial.X x : IndPoly size)) ∪
      {p | ∃ (v : V) (i k : Fin (size v)), i ≠ k ∧
        p = MvPolynomial.X ⟨v, i⟩ * MvPolynomial.X ⟨v, k⟩})

/-- The indicator algebra `A(X) = ℝ[I(X)] / 𝒥` (Definition 2.11). -/
abbrev IndAlg (size : V → ℕ) := IndPoly size ⧸ indIdeal size

/-- An indicator conjunction as an element of `A(X)`. -/
noncomputable def indConj {size : V → ℕ} (C : IndConj size) : IndAlg size :=
  Ideal.Quotient.mk (indIdeal size) (∏ x ∈ C, MvPolynomial.X x)

/-- A partial assignment: each variable gets a value (`some j`) or is unset (`none`, the
paper's `∗`). -/
abbrev PartialAssignment (size : V → ℕ) := ∀ v : V, Option (Fin (size v))

/-- `|σ|`: the number of variables set by `σ`. -/
noncomputable def PartialAssignment.card {size : V → ℕ} (σ : PartialAssignment size) : ℕ :=
  (Finset.univ.filter fun v => (σ v).isSome).card

/-- The indicator conjunction `χ_σ = ∏_{σ(x_v) ≠ ∗} ⟦x_v = σ(x_v)⟧` (Definition 2.10); `χ_σ = 1`
when `σ` sets nothing. -/
noncomputable def chi {size : V → ℕ} (σ : PartialAssignment size) : IndAlg size :=
  Ideal.Quotient.mk (indIdeal size)
    (∏ v : V, match σ v with
      | none => (1 : IndPoly size)
      | some j => MvPolynomial.X ⟨v, j⟩)

/-- `A(X)_{≤ d} = span {χ_σ : |σ| ≤ d}` (Definition 2.12). -/
noncomputable def indAlgLE (size : V → ℕ) (d : ℕ) : Submodule ℝ (IndAlg size) :=
  Submodule.span ℝ {p | ∃ σ : PartialAssignment size, σ.card ≤ d ∧ p = chi σ}

/-- A degree-`d` indicator design (Definition 2.13), as a function on all of `A(X)` of which only
the values on `A(X)_{≤ d}` are constrained: normalization and linearity on `A(X)_{≤ d}`. -/
structure IsIndicatorDesign {size : V → ℕ} (d : ℕ) (D : IndAlg size → ℝ) : Prop where
  normalization : D 1 = 1
  linearity : ∀ (a b : ℝ) (p q : IndAlg size), p ∈ indAlgLE size d → q ∈ indAlgLE size d →
    D (a • p + b • q) = a * D p + b * D q

/-- `F`-nonwitnessing for a multivalued CNF (Definition 2.13): `D[C] = 0` for every clause
`Cᵢ ∈ F` and every indicator conjunction `C ⇒ C̄ᵢ` with `bdeg(C) ≤ d`. -/
def IsIndNonwitnessing {size : V → ℕ} (F : MVCNF size) (d : ℕ) (D : IndAlg size → ℝ) : Prop :=
  ∀ Ci ∈ F, ∀ C : IndConj size, IndWitnesses C Ci → bdeg C ≤ d → D (indConj C) = 0

/-- A degree-`d` indicator pseudoexpectation (Definition 2.14): a degree-`d` indicator design
that is nonnegative on every indicator conjunction of block degree `≤ d`. -/
def IsIndPseudoexpectation {size : V → ℕ} (d : ℕ) (D : IndAlg size → ℝ) : Prop :=
  IsIndicatorDesign d D ∧ ∀ C : IndConj size, bdeg C ≤ d → 0 ≤ D (indConj C)

/-- Evaluation of `A(X)` at a total assignment `a`: `⟦x_v = j⟧ ↦ 1` if `a v = j`, else `0`.
It kills every generator of `𝒥`, so it is a ring map on the quotient. -/
noncomputable def evalAlg {size : V → ℕ} (a : MVAssignment size) : IndAlg size →+* ℝ :=
  Ideal.Quotient.lift (indIdeal size)
    (MvPolynomial.eval fun x : Indicator size => if a x.1 = x.2 then (1 : ℝ) else 0)
    (by
      intro p hp
      have key : indIdeal size ≤ RingHom.ker
          (MvPolynomial.eval fun x : Indicator size => if a x.1 = x.2 then (1 : ℝ) else 0) := by
        unfold indIdeal
        rw [Ideal.span_le]
        rintro q ((⟨v, rfl⟩ | ⟨x, rfl⟩) | ⟨v, i, k, hik, rfl⟩)
        · simp [RingHom.mem_ker]
        · simp only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, MvPolynomial.eval_X]
          split_ifs <;> simp
        · simp only [SetLike.mem_coe, RingHom.mem_ker, map_mul, MvPolynomial.eval_X]
          split_ifs with h1 h2 <;> simp_all
      exact key hp)

/-! ## Booleanization (Definition 2.15) -/

/-- The boolean variables `x_{v,k}` (`k < w v`) encoding the multivalued variables. -/
abbrev BoolVar (w : V → ℕ) := Σ v : V, Fin (w v)

/-- `⟦x_v = j⟧^bool`: the conjunction of the bit literals `x_{v,k} = j.testBit k`, `k < w v`. -/
noncomputable def indBool {size : V → ℕ} (w : V → ℕ) (x : Indicator size) :
    Conjunction (BoolVar w) :=
  Finset.univ.image fun k : Fin (w x.1) => ((⟨x.1, k⟩ : BoolVar w), x.2.val.testBit k.val)

/-- `C^bool = ∏ᵢ Iᵢ^bool` for an indicator conjunction `C`. -/
noncomputable def conjBool {size : V → ℕ} (w : V → ℕ) (C : IndConj size) :
    Conjunction (BoolVar w) :=
  C.biUnion (indBool w)

/-- The boolean clause of `⋁ᵢ ⟦x_{vᵢ} ≠ jᵢ⟧`: the disjunction of the negated bit literals,
`⋁ᵢ ⋁_k (x_{vᵢ,k} = ¬ jᵢ.testBit k)`. -/
noncomputable def clauseBool {size : V → ℕ} (w : V → ℕ) (Cl : MVClause size) :
    Clause (BoolVar w) :=
  Cl.biUnion fun x => (indBool w x).image negLit

/-- `F^bool`: the boolean encoding of a multivalued CNF. -/
noncomputable def cnfBool {size : V → ℕ} (w : V → ℕ) (F : MVCNF size) : CNF (BoolVar w) :=
  F.image (clauseBool w)

/-- The literals mentioned by a monomial of `ℝ[x, x̄]` over the boolean variables:
`(b, true)` when `x_b` divides it and `(b, false)` when `x̄_b` divides it. -/
noncomputable def monoLits (w : V → ℕ) (m : BoolVar w ⊕ BoolVar w →₀ ℕ) :
    Conjunction (BoolVar w) :=
  (Finset.univ.filter fun b => 0 < m (Sum.inl b)).image (fun b => (b, true)) ∪
    (Finset.univ.filter fun b => 0 < m (Sum.inr b)).image (fun b => (b, false))

/-- A partial assignment `σ` to the multivalued variables satisfies the bit literal `(⟨v,k⟩, b)`
when it sets `x_v` to a value whose bit `k` is `b`. -/
def PSatBit {size : V → ℕ} {w : V → ℕ} (σ : PartialAssignment size) (l : Literal (BoolVar w)) :
    Prop :=
  ∃ j, σ l.1.1 = some j ∧ j.val.testBit l.1.2.val = l.2

/-- `D^bool` on a monomial: `∑ D[χ_σ]` over the partial assignments `σ` whose domain is the set
`I_C` of multivalued variables mentioned by the monomial's conjunction `C` and which satisfy
`C` (Definition 2.15). Powers `x_b^e`, `x̄_b^e` (`e ≥ 1`) read as `x_b`, `x̄_b`, which is the
reduction modulo the boolean and complementarity axioms. -/
noncomputable def boolizeMono {size : V → ℕ} (w : V → ℕ) (D : IndAlg size → ℝ)
    (m : BoolVar w ⊕ BoolVar w →₀ ℕ) : ℝ :=
  ∑ σ ∈ (Finset.univ : Finset (PartialAssignment size)).filter (fun σ =>
      (∀ v, (σ v).isSome ↔ v ∈ (monoLits w m).image (fun l => l.1.1)) ∧
      ∀ l ∈ monoLits w m, PSatBit σ l),
    D (chi σ)

/-- The booleanization `D^bool : ℝ[x, x̄] → ℝ` of `D : A(X) → ℝ` (Definition 2.15), extended
linearly from monomials. -/
noncomputable def booleanization {size : V → ℕ} (w : V → ℕ) (D : IndAlg size → ℝ) :
    DualPoly (BoolVar w) → ℝ :=
  fun p => ∑ m ∈ p.support, p.coeff m * boolizeMono w D m

end SAInterp.Res2


