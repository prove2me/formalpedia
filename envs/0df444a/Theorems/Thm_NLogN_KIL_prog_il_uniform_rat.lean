--             (t.upd 0 (ints (enc2 (AModel.prog (Qc.toCircuit (q ^ b)) q k P L A B Cs xs)) ++ R))
--             (ilCostU5 W K Kd S q Bb k (vol (P :: L :: swShape A B Cs (q ^ m ^ k))))
