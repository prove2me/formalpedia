-- Source module: Solutions.R6CxNetFinal
/-!
# Track B: the round-six complex network as a `Prop8IfaceH`

`net = Z_u on every X ++ steps of CH ++ i^{wt u} Z_u on every Y ++ (X ↔ Y)`, on the roles
`Fin 207387136 ⊕ Fin 4193728`.

* `net_correct`: for every column type `κ`, the data block of its denotation is `C^{⊗}` on every
  data role (clean temporaries), from `prog_sim` with the initial labels `g0`, the final labels
  `gF_*` and the logical effect `ΛF_*`, as in `P8Lift.prog_correct`;
* `net_widths`: its child widths are `progWidths CH` (histogram `cxR6`, all `< 576`).

**`cxNetR6 : ∃ T, Nonempty (Prop8IfaceH 207387136 T 576 Jain.cxR6)`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000
set_option synthInstance.maxSize 512

namespace IntMul.Kappa.R6.Cx.NetG

attribute [local irreducible] G1 G2 cs1 cs2 E4mv S1 E4s S2 KK PL CH

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw Complex Butterfly P8Lift

/-! ## Role decoding -/

lemma ab_lt {a b : ℕ} (ha : a < NV) (hb : b < NV) : a * NV + b < NN := by
  unfold NN; nlinarith

lemma xy_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : xy (Xr a b) = a * NV + b := by
  have h := rc_X ha hb
  unfold xy; rw [h, if_pos (by simp only [NN, NV] at *; nlinarith)]

lemma xy_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : xy (Yr a b) = a * NV + b := by
  have h := rc_Y ha hb
  unfold xy; rw [h, if_neg (by omega)]; omega

lemma ua_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : ua (Xr a b) = Uv a b := by
  obtain ⟨q1, q2⟩ := dmU (n := a * NV + b) (q := a) (r := b) (by norm_num [NV]) (by ring) hb
  rw [ua, xy_X ha hb, q1, q2]

lemma ua_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : ua (Yr a b) = Uv a b := by
  obtain ⟨q1, q2⟩ := dmU (n := a * NV + b) (q := a) (r := b) (by norm_num [NV]) (by ring) hb
  rw [ua, xy_Y ha hb, q1, q2]

/-! ## Phases and the role permutation -/

variable {κ : Type} [Fintype κ] [DecidableEq κ]

lemma preR_den (r : Rl) : denListR (tens Cm : Op κ) (preR r) = wireOp r (preOpR κ r) := by
  unfold preR preOpR
  split_ifs
  · rw [show denListR (tens Cm : Op κ) [RStep.phase r 0 0 (uN r)] =
      (RStep.phase r 0 0 (uN r) : RStep Rl 576).den (tens Cm) by simp [denListR], den_phase, colT_ZuMat]
    congr 2; funext x; simp [RStep.phExp, uN]
  · exact (wireOp_one _).symm

lemma postR_den (r : Rl) : denListR (tens Cm : Op κ) (postR r) = wireOp r (postOpR κ r) := by
  unfold postR postOpR
  split_ifs
  · rw [show denListR (tens Cm : Op κ) [RStep.phase r 0 (NetComplexPhase.wt (ua r)) (uN r)] =
      (RStep.phase r 0 (NetComplexPhase.wt (ua r)) (uN r) : RStep Rl 576).den (tens Cm) by
        simp [denListR], den_phase, colT_ZuMat]
    congr 1
    ext x y
    simp only [diagonal_apply, Matrix.smul_apply, smul_eq_mul]
    split_ifs
    · simp only [RStep.phExp, uN, zero_add, pow_add, pow_mul]
    · simp
  · exact (wireOp_one _).symm

/-! ## The network -/

/-! ## Correctness -/

lemma topbot (g : Addr 576 κ → ℂ) :
    PhiK (qL (⊤ : Lab 576)) *ᵥ (PhiK (-qL (⊥ : Lab 576)) *ᵥ g) = (tens Cm : Op (Fin 576 × κ)) *ᵥ g := by
  rw [Matrix.mulVec_mulVec, ← PhiK_add]
  have : qL (⊤ : Lab 576) + -qL (⊥ : Lab 576) = fun x => (NetComplexPhase.wt x : ZMod 4) := by
    funext x; simp only [Pi.add_apply, Pi.neg_apply, qL_top, qL_bot, neg_zero, add_zero]
  rw [this, PhiK, PhiMat_wt, colT_CtenMat]

theorem net_main_sol_aux (F : Rl × Addr 576 κ → ℂ) (hF : ∀ n z, F (Sum.inr n, z) = 0) (w : Fin Wn)
    (x : Addr 576 κ) :
    (denListH (chEx (κ := κ)) net *ᵥ F) (Sum.inl w, x) =
      ((tens Cm : Op (Fin 576 × κ)) *ᵥ fun z => F (Sum.inl w, z)) x := by
  rw [net, denListH_append, denListH_append, denListH_append, ← Matrix.mulVec_mulVec,
    ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, denListH_map_ofR, denListH_map_ofR,
    denListR_wires _ _ _ preR_den, denListR_wires _ _ _ postR_den, denListH_single]
  set F1 := blockOp (preOpR κ) *ᵥ F with hF1
  have hF1r : ∀ r, (fun z => F1 (r, z)) = preOpR κ r *ᵥ fun z => F (r, z) := fun r => by
    funext z; rw [hF1, blockOp_mulVec]
  set Λ0 : Rl → Addr 576 κ → ℂ := fun r => PhiK (-qL (g0 r)) *ᵥ fun z => F1 (r, z) with hΛ0
  have hI : Inv g0 Λ0 F1 := fun r => by
    rw [hΛ0, Matrix.mulVec_mulVec, ← PhiK_add, add_neg_cancel, PhiK_zero, Matrix.one_mulVec]
  have htemp : ∀ n, Λ0 (Sum.inr n) = 0 := fun n => by
    rw [hΛ0]
    simp only
    rw [hF1r]
    have : (fun z => F (Sum.inr n, z)) = 0 := funext fun z => hF n z
    rw [this, Matrix.mulVec_zero, Matrix.mulVec_zero]
  have hsim := prog_sim CH g0 CH_valid.1 Λ0 F1 hI
  set F2 := denListH (chEx (κ := κ)) (progSteps CH) *ᵥ F1 with hF2
  have hF2r : ∀ r, (fun z => F2 (r, z)) = PhiK (qL (gF r)) *ᵥ ΛF Λ0 r := fun r => hsim r
  -- the permutation and the post phases
  have hperm : ((HStep.perm σE : HStep Rl 576).den (chEx (κ := κ)) *ᵥ
      (blockOp (postOpR κ) *ᵥ F2)) (Sum.inl w, x) =
      (postOpR κ (σf (Sum.inl w)) *ᵥ fun z => F2 (σf (Sum.inl w), z)) x := by
    rw [show (HStep.perm σE : HStep Rl 576).den (chEx (κ := κ)) = (RStep.perm σE : RStep Rl 576).den (1 : Op κ)
      from rfl, perm_mulVec, blockOp_mulVec]
    rfl
  rw [hperm]
  rw [inl_eq_rW] at hperm ⊢
  have hw := w.isLt
  set n := w.val with hn
  by_cases h1 : n < NN
  · -- `X(a,b)`: receives `Y(a,b)`
    have ha : n / NV < NV := by
      apply Nat.div_lt_of_lt_mul; simp only [NN] at h1; exact h1
    have hb : n % NV < NV := Nat.mod_lt _ (by norm_num [NV])
    have hr : rW n = Xr (n / NV) (n % NV) := by
      rw [Xr, xI]; exact congrArg rW (Nat.div_add_mod' n NV).symm
    rw [hr]
    set a := n / NV; set b := n % NV
    have hσ : σf (Xr a b) = Yr a b := by
      unfold σf; rw [rc_X ha hb, if_pos (by rw [← rc_X ha hb, ← hr, rc_rW hw]; exact h1)]
      rw [Yr, yI]; exact congrArg rW (by omega)
    have hpost : postOpR κ (Yr a b) =
        (I ^ NetComplexPhase.wt (Uv a b)) ^ Fintype.card κ • colT (ZuMat (Uv a b)) := by
      unfold postOpR; rw [rc_Y ha hb, if_pos ⟨by omega, by have := ab_lt ha hb; omega⟩, ua_Y ha hb]
    have hpre : preOpR κ (Xr a b) = colT (ZuMat (Uv a b)) := by
      unfold preOpR; rw [rc_X ha hb, if_pos (ab_lt ha hb), ua_X ha hb]
    rw [hσ, hpost, hF2r, gF_Y ha hb, ΛF_Y Λ0 htemp ha hb, hΛ0]
    simp only
    rw [hF1r, hpre, g0_X ha hb, Up]
    have hu := Uv_unit ha hb
    have hd : qL (orth 1 (NetT.lineM (Uv a b))) + -qL (NetT.lineM (Uv a b)) =
        fun x => ((NetComplexPhase.wt x + 2 * (Uv a b ⬝ᵥ x).val : ℕ) : ZMod 4) := by
      funext y
      rw [Pi.add_apply, Pi.neg_apply, ← sub_eq_add_neg]
      exact qL_line_perp_diff (Uv a b) hu (NetComplexP8.wt_odd hu) y
    have key : ((I ^ NetComplexPhase.wt (Uv a b)) ^ Fintype.card κ • colT (ZuMat (Uv a b)) *
        PhiK (qL (orth 1 (NetT.lineM (Uv a b)))) * PhiK (-qL (NetT.lineM (Uv a b))) *
        colT (ZuMat (Uv a b)) : Op (Fin 576 × κ)) = tens Cm := by
      rw [Matrix.mul_assoc ((I ^ NetComplexPhase.wt (Uv a b)) ^ Fintype.card κ • colT (ZuMat (Uv a b))),
        ← PhiK_add, hd, PhiK, PhiMat_mixed, smul_mul_assoc, smul_mul_assoc]
      exact Zcorr_cols (Uv a b)
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, key]
  · by_cases h2 : n < 2 * NN
    · -- `Y(a,b)`: receives `X(a,b)`
      have hn' : n - NN < NN := by omega
      have ha : (n - NN) / NV < NV := by
        apply Nat.div_lt_of_lt_mul; simp only [NN] at hn'; exact hn'
      have hb : (n - NN) % NV < NV := Nat.mod_lt _ (by norm_num [NV])
      have hr : rW n = Yr ((n - NN) / NV) ((n - NN) % NV) := by
        rw [Yr, yI]; have := Nat.div_add_mod' (n - NN) NV; exact congrArg rW (by omega)
      rw [hr]
      set a := (n - NN) / NV; set b := (n - NN) % NV
      have hσ : σf (Yr a b) = Xr a b := by
        unfold σf
        rw [rc_Y ha hb, if_neg (by omega), if_pos (by have := ab_lt ha hb; omega)]
        rw [Xr, xI]; exact congrArg rW (by omega)
      have hpost : postOpR κ (Xr a b) = 1 := by
        unfold postOpR; rw [rc_X ha hb, if_neg (by have := ab_lt ha hb; omega)]
      have hpre : preOpR κ (Yr a b) = 1 := by
        unfold preOpR; rw [rc_Y ha hb, if_neg (by omega)]
      rw [hσ, hpost, hF2r, Matrix.one_mulVec, gF_X ha hb, ΛF_X Λ0 htemp ha hb, hΛ0]
      simp only
      rw [hF1r, hpre, Matrix.one_mulVec, g0_Y ha hb, topbot]
    · by_cases h3 : n < 2 * NN + NV * NR
      · -- `A1(b,q)`
        have hn' : n - 2 * NN < NV * NR := by omega
        have hb : (n - 2 * NN) / NR < NV := by
          apply Nat.div_lt_of_lt_mul; rw [mul_comm]; exact hn'
        have hq : (n - 2 * NN) % NR < NR := Nat.mod_lt _ (by norm_num [NR])
        have hr : rW n = A1r ((n - 2 * NN) / NR) ((n - 2 * NN) % NR) := by
          rw [A1r, a1I]; have := Nat.div_add_mod' (n - 2 * NN) NR; exact congrArg rW (by omega)
        rw [hr]
        set b := (n - 2 * NN) / NR; set q := (n - 2 * NN) % NR
        have hσ : σf (A1r b q) = A1r b q := by
          unfold σf; rw [rc_A1 hb hq, if_neg (by omega), if_neg (by omega)]
        have hpost : postOpR κ (A1r b q) = 1 := by
          unfold postOpR; rw [rc_A1 hb hq, if_neg (by omega)]
        have hpre : preOpR κ (A1r b q) = 1 := by
          unfold preOpR; rw [rc_A1 hb hq, if_neg (by omega)]
        rw [hσ, hpost, hF2r, Matrix.one_mulVec, gF_A1 hb hq, ΛF_A1 Λ0 htemp hb hq, hΛ0]
        simp only
        rw [hF1r, hpre, Matrix.one_mulVec, g0_A1 hb hq, topbot]
      · -- `A2(a,q)`
        have hn' : n - (2 * NN + NV * NR) < NV * NR := by simp only [Wn, NN, NV, NR] at *; omega
        have ha : (n - (2 * NN + NV * NR)) / NR < NV := by
          apply Nat.div_lt_of_lt_mul; rw [mul_comm]; exact hn'
        have hq : (n - (2 * NN + NV * NR)) % NR < NR := Nat.mod_lt _ (by norm_num [NR])
        have hr : rW n = A2r ((n - (2 * NN + NV * NR)) / NR) ((n - (2 * NN + NV * NR)) % NR) := by
          rw [A2r, a2I]; have := Nat.div_add_mod' (n - (2 * NN + NV * NR)) NR; exact congrArg rW (by omega)
        rw [hr]
        set a := (n - (2 * NN + NV * NR)) / NR; set q := (n - (2 * NN + NV * NR)) % NR
        have hσ : σf (A2r a q) = A2r a q := by
          unfold σf; rw [rc_A2 ha hq, if_neg (by omega), if_neg (by omega)]
        have hpost : postOpR κ (A2r a q) = 1 := by
          unfold postOpR; rw [rc_A2 ha hq, if_neg (by omega)]
        have hpre : preOpR κ (A2r a q) = 1 := by
          unfold preOpR; rw [rc_A2 ha hq, if_neg (by omega)]
        rw [hσ, hpost, hF2r, Matrix.one_mulVec, gF_A2 ha hq, ΛF_A2 Λ0 htemp ha hq, hΛ0]
        simp only
        rw [hF1r, hpre, Matrix.one_mulVec, g0_A2 ha hq, topbot]

end IntMul.Kappa.R6.Cx.NetG

