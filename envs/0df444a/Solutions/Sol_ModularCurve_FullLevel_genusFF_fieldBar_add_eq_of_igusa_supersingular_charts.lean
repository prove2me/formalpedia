    (W : Finset (Place κ (modularFunctionFieldC κ M'))) (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' κ) :
    (AlgebraicCurve.genusFF κ ↥(xHFunctionFieldC κ (q ^ 2 * M') (levelH q M')) : ℚ) =
      1 + ((q : ℚ) ^ 2 - 1) * dedekindPsi M' / 48 - ((q : ℚ) - 1) * cuspCount M' / 4 - (W.card : ℚ) / 2 :=
