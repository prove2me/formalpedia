    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^21) inversePower21 := by
  have h23 := (lossPower23_approximates hk hklog).scale (960566918220 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (513791607420 : ℚ)).addAppend h23
