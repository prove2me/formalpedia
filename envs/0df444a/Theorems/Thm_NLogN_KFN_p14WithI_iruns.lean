          (Butterfly.layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
      IRuns Isym iprog (p14WithI P K D S ρ r E Cc w) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l)))
        (kC (w + 2 * D) + cWrapE D E (vol (Butterfly.layerShape P K D S) * r)
