private theorem globalPointsGL_eq_map (γ : GL (Fin 3) ℚ) :
    globalPointsGL 3 (𝓞 ℚ) ℚ γ = Matrix.GeneralLinearGroup.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)) γ := rfl

private theorem componentAt3_globalPointsGL (v : HeightOneSpectrum (𝓞 ℚ)) (γ : GL (Fin 3) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (globalPointsGL 3 (𝓞 ℚ) ℚ γ) =
      Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) γ := by
  show Matrix.GeneralLinearGroup.map (((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp
      (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)).comp (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ))) γ = _
  exact congrArg (fun f : ℚ →+* v.adicCompletion ℚ => Matrix.GeneralLinearGroup.map f γ) (RingHom.ext_rat _ _)

private theorem archComponent3_globalPointsGL (γ : GL (Fin 3) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (globalPointsGL 3 (𝓞 ℚ) ℚ γ) =
      Matrix.GeneralLinearGroup.map (algebraMap ℚ (InfiniteAdeleRing ℚ)) γ := by
  show Matrix.GeneralLinearGroup.map ((AdelicLevel.adeleArch (𝓞 ℚ) ℚ).comp
      (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ))) γ = _
  exact congrArg (fun f : ℚ →+* InfiniteAdeleRing ℚ => Matrix.GeneralLinearGroup.map f γ) (RingHom.ext_rat _ _)

private theorem archPlaceComponent3_globalPointsGL (w : InfinitePlace ℚ) (γ : GL (Fin 3) ℚ) :
    archPlaceComponent3 ℚ w (globalPointsGL 3 (𝓞 ℚ) ℚ γ) =
      Matrix.GeneralLinearGroup.map (algebraMap ℚ w.Completion) γ := by
  show Matrix.GeneralLinearGroup.map ((AdelicLevel.archEval ℚ w).comp ((AdelicLevel.adeleArch (𝓞 ℚ) ℚ).comp
      (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)))) γ = _
  exact congrArg (fun f : ℚ →+* w.Completion => Matrix.GeneralLinearGroup.map f γ) (RingHom.ext_rat _ _)

private theorem map_mem_congruenceK1 {a : ℚ} (ha : a ≠ 0) (t : GL (Fin 3) ℚ)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) {v : HeightOneSpectrum (𝓞 ℚ)}
    (hv : Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1) (c : ℕ) :
    Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) t ∈ congruenceK1 (𝓞 ℚ) ℚ v c := by
  have hval : ∀ i j, ((Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) t :
      GL (Fin 3) (v.adicCompletion ℚ)) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j =
        algebraMap ℚ (v.adicCompletion ℚ) (Matrix.diagonal ![a ^ 2, a, 1] i j) := fun i j => by
    rw [Matrix.GeneralLinearGroup.map_apply, ht]
  have hinv : ∀ i j, (((Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) t)⁻¹ :
      GL (Fin 3) (v.adicCompletion ℚ)) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j =
        algebraMap ℚ (v.adicCompletion ℚ) (Matrix.diagonal ![(a ^ 2)⁻¹, a⁻¹, 1] i j) := fun i j => by
    rw [← map_inv, Matrix.GeneralLinearGroup.map_apply, coe_inv_of_coe_eq_diagonal ha t ht]
  have hv' : Valued.v ((a : ℚ) : v.adicCompletion ℚ) = 1 :=
    (congrArg Valued.v (eq_ratCast (algebraMap ℚ (v.adicCompletion ℚ)) a)).symm.trans hv
  rw [mem_congruenceK1_iff, mem_localMaximalCompact3_iff]
  refine ⟨⟨fun i j => ?_, fun i j => ?_⟩, ?_, ?_, ?_⟩
  · rw [hval]
    fin_cases i <;> fin_cases j <;> simp [hv']
  · rw [hinv]
    fin_cases i <;> fin_cases j <;> simp [hv']
  · rw [hval]
    simp
  · rw [hval]
    simp
  · rw [hval]
    simp

private theorem map_mem_localMaximalCompact3 {a : ℚ} (ha : a ≠ 0) (t : GL (Fin 3) ℚ)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) {v : HeightOneSpectrum (𝓞 ℚ)}
    (hv : Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1) :
    Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) t ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
  ((mem_congruenceK1_iff (𝓞 ℚ) ℚ v).1 (map_mem_congruenceK1 ha t ht hv 0)).1

