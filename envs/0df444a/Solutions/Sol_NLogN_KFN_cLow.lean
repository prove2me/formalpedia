variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r n : ℕ} {st : ι → ℕ}

theorem sImpl_skip (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (hT : T = 1) :
