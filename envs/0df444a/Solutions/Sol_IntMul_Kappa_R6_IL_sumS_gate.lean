-- Source module: Solutions.KIL3Net
/-!
# KIL3: the network of one Prop. 11 level on one stack (bits)

The `W` wire streams (bits, `ZMod 2`, encoded as the integers `0, 1`) are kept on stack `0` as a
table (`KIL3Tab`).  A gate `g` with touched set `S`:

1. for every `w ∈ S` (in order), the frame change `Φ (M_g − lab w)` is run in place on stream `w`
   (`applyC`, the stream code is any stack-`0` program, e.g. with child calls);
2. the table is rebuilt: a touched stream becomes the sum mod 2 of the touched streams with
   coefficient `1` in row `w` of the gate matrix, an untouched stream is copied.

At the end the final frame changes `Φ (Mout w − lab w)` are run on every stream.
`netC_runs`: the code computes `netRunF` (`AModelProp11`) with `Φ` given by the stream codes,
cost `Σ_frames (cE + 2·cOp) + Σ_gates (cRebuild + 2) + 1` (`O(V)` per frame and per gate,
`W` and the gate list fixed).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Bits as integers -/

theorem xr_val (a b : ZMod 2) : xr ((a.val : ℕ) : ℤ) ((b.val : ℕ) : ℤ) = (((a + b).val : ℕ) : ℤ) := by
  fin_cases a <;> fin_cases b <;> decide

theorem zipWith_enc2 : ∀ (a b : List (ZMod 2)),
    List.zipWith xr (enc2 a) (enc2 b) = enc2 (List.zipWith (· + ·) a b)
  | [], _ => by simp [enc2]
  | _ :: _, [] => by simp [enc2]
  | x :: a, y :: b => by
    have := zipWith_enc2 a b
    simp only [enc2, List.map_cons, List.zipWith_cons_cons] at *
    rw [xr_val, this]

theorem enc2_replicate (v : ℕ) : enc2 (List.replicate v 0) = List.replicate v 0 := by
  simp [enc2]

theorem sumS_enc2 (Y : ℕ → List (ZMod 2)) (v : ℕ) (l : List ℕ) :
    sumS (fun w => enc2 (Y w)) v l = enc2 (sumZ Y (List.replicate v 0) l) := by
  unfold sumS sumZ
  rw [← enc2_replicate]
  generalize List.replicate v (0 : ZMod 2) = a
  induction l generalizing a with
  | nil => rfl
  | cons w l ih => simp only [List.foldl_cons]; rw [zipWith_enc2, ih]

theorem length_sumZ (Y : ℕ → List (ZMod 2)) :
    ∀ (l : List ℕ) (a : List (ZMod 2)), (∀ w ∈ l, (Y w).length = a.length) →
      (sumZ Y a l).length = a.length
  | [], _, _ => rfl
  | w :: l, a, h => by
    simp only [sumZ, List.foldl_cons]
    have e : (List.zipWith (· + ·) a (Y w)).length = a.length := by
      simp [h w List.mem_cons_self]
    rw [← e]
    exact length_sumZ Y l _ (fun w' hw' => by rw [e]; exact h w' (List.mem_cons_of_mem _ hw'))

theorem getD_sumZ (Y : ℕ → List (ZMod 2)) (i : ℕ) :
    ∀ (l : List ℕ) (a : List (ZMod 2)), (∀ w ∈ l, (Y w).length = a.length) → i < a.length →
      (sumZ Y a l).getD i 0 = a.getD i 0 + (l.map fun w => (Y w).getD i 0).sum
  | [], a, _, _ => by simp [sumZ]
  | w :: l, a, h, hi => by
    have hw := h w List.mem_cons_self
    have e : (List.zipWith (· + ·) a (Y w)).length = a.length := by simp [hw]
    have IH := getD_sumZ Y i l (List.zipWith (· + ·) a (Y w))
      (fun w' hw' => by rw [e]; exact h w' (List.mem_cons_of_mem _ hw')) (by rw [e]; exact hi)
    simp only [sumZ, List.foldl_cons] at IH ⊢
    rw [IH, List.map_cons, List.sum_cons, ← add_assoc]
    congr 1
    rw [List.getD_eq_getElem _ _ (by rw [e]; exact hi), List.getElem_zipWith,
      List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ (by rw [hw]; exact hi)]

/-! ## Sequences of statements -/

/-! ## List sums over `Fin W` -/

/-! ## The network -/

section Net

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W v : ℕ} {M : Type*} [AddGroup M]

theorem srcOK (g : NGate (Fin W) (ZMod 2) M) : SrcOK W (srcT g) := by
  intro n hn
  simp only [srcT, dif_pos hn]
  split_ifs
  · refine ⟨fun w' hw' => ?_, ?_⟩
    · simp only [List.mem_map] at hw'; obtain ⟨x, -, rfl⟩ := hw'; exact x.2
    · simp only [List.length_map]
      exact le_trans (List.length_filter_le _ _) (by simp)
  · exact ⟨fun w' hw' => by simp at hw'; omega, by simp; omega⟩

variable (E : M → IStmt HS Pp)

variable (cE : M → ℕ)

variable {E cE}

/-- The sum of a gate row, list form. -/
theorem gate_sum (g : NGate (Fin W) (ZMod 2) M) (w : Fin W) (Z : ℕ → List (ZMod 2))
    (i : ℕ) :
    ((((List.finRange W).filter (fun w' => w' ∈ g.2.1 ∧ g.1 w w' = 1)).map Fin.val).map
      fun n => (Z n).getD i 0).sum =
      ∑ w' ∈ g.2.1, g.1 w w' • (Z w').getD i 0 := by
  rw [List.map_map]
  rw [← List.sum_toFinset _ ((List.nodup_finRange W).filter _)]
  have e : ((List.finRange W).filter (fun w' => w' ∈ g.2.1 ∧ g.1 w w' = 1)).toFinset =
      g.2.1.filter (fun w' => g.1 w w' = 1) := by
    ext x; simp
  rw [e, Finset.sum_filter]
  refine Finset.sum_congr rfl fun w' _ => ?_
  have : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
  rcases this (g.1 w w') with h | h <;> simp [h]

end Net

