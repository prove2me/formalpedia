namespace InfoLossLAR.WorstCase

open QAlgorithms.Complexity

/-- The single-wire factor of the published Hadamard preserves squared norm. -/
theorem hMat_mass (v : Bool → ℂ) :
    (∑ a : Bool, Complex.normSq (∑ b : Bool, hMat a b * v b)) =
      ∑ b : Bool, Complex.normSq (v b) := by
  have hroot : (Real.sqrt 2) ^ 2 = (2 : ℝ) := Real.sq_sqrt (by norm_num)
  have hscale : Complex.normSq (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) = (1 / 2 : ℝ) := by
    rw [← Complex.ofReal_inv, Complex.normSq_ofReal, ← mul_inv, ← sq, hroot]
    norm_num
  simp only [Fintype.sum_bool, hMat, Matrix.of_apply, Bool.and_false,
    Bool.and_true, Bool.false_eq_true, if_false, if_true, Complex.ofReal_inv]
  rw [show -(((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * v true +
      (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * v false =
      (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * (v false - v true) by ring]
  rw [show (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * v true +
      (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * v false =
      (((Real.sqrt 2 : ℝ) : ℂ)⁻¹) * (v false + v true) by ring]
  rw [Complex.normSq_mul, Complex.normSq_mul, hscale,
    Complex.normSq_add, Complex.normSq_sub]
  ring

/-- The single-wire factor of the published S gate preserves squared norm. -/
theorem sMat_mass (v : Bool → ℂ) :
    (∑ a : Bool, Complex.normSq (∑ b : Bool, sMat a b * v b)) =
      ∑ b : Bool, Complex.normSq (v b) := by
  simp [sMat, Complex.normSq_mul]

/-- The single-wire factor of the published T gate preserves squared norm. -/
theorem tMat_mass (v : Bool → ℂ) :
    (∑ a : Bool, Complex.normSq (∑ b : Bool, tMat a b * v b)) =
      ∑ b : Bool, Complex.normSq (v b) := by
  have hphase : Complex.normSq (Complex.exp (Complex.I * Real.pi / 4)) = 1 := by
    simp [Complex.normSq_eq_norm_sq, Complex.norm_exp, Complex.mul_re]
  simp [tMat, Complex.normSq_mul, hphase]

/-- The single-wire factor of the published X gate preserves squared norm. -/
theorem xMat_mass (v : Bool → ℂ) :
    (∑ a : Bool, Complex.normSq (∑ b : Bool, xMat a b * v b)) =
      ∑ b : Bool, Complex.normSq (v b) := by
  simp [xMat, add_comm]

/-- A one-wire gate preserves the mass of the full register whenever its
actual two-by-two action preserves the mass of each two-dimensional fiber. -/
theorem apply1_mass {n : ℕ} (U : Matrix Bool Bool ℂ) (wire : Fin n) (ψ : QState n)
    (hU : ∀ v : Bool → ℂ,
      (∑ a : Bool, Complex.normSq (∑ b : Bool, U a b * v b)) =
        ∑ b : Bool, Complex.normSq (v b)) :
    (∑ x : Bits n, Complex.normSq (apply1 U wire ψ x)) =
      ∑ x : Bits n, Complex.normSq (ψ x) := by
  let split := Equiv.funSplitAt wire Bool
  have hupdate (a b : Bool) (rest : {j : Fin n // j ≠ wire} → Bool) :
      Function.update (split.symm (a, rest)) wire b = split.symm (b, rest) := by
    funext j
    by_cases hj : j = wire
    · subst j
      simp [split, Equiv.funSplitAt, Equiv.piSplitAt]
    · simp [split, Equiv.funSplitAt, Equiv.piSplitAt, hj]
  have hcoord (a : Bool) (rest : {j : Fin n // j ≠ wire} → Bool) :
      split.symm (a, rest) wire = a := by
    simp [split, Equiv.funSplitAt, Equiv.piSplitAt]
  conv_lhs => rw [← Equiv.sum_comp split.symm, Fintype.sum_prod_type, Finset.sum_comm]
  conv_rhs => rw [← Equiv.sum_comp split.symm, Fintype.sum_prod_type, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro rest hrest
  simpa only [apply1, hcoord, hupdate] using hU (fun b => ψ (split.symm (b, rest)))

/-- The published CNOT is an actual permutation of basis strings. -/
theorem cnotState_mass {n : ℕ} (control target : Fin n) (hne : control ≠ target)
    (ψ : QState n) :
    (∑ x : Bits n, Complex.normSq (cnotState control target hne ψ x)) =
      ∑ x : Bits n, Complex.normSq (ψ x) := by
  let flip : Bits n → Bits n := fun x =>
    Function.update x target (xor (x target) (x control))
  have hinvolutive : Function.Involutive flip := by
    intro x
    funext index
    by_cases hi : index = target
    · subst index
      have hc : flip x control = x control := by
        simp [flip, Function.update_of_ne hne]
      simp only [flip, Function.update_self, hc]
      cases x target <;> cases x control <;> rfl
    · simp [flip, Function.update_of_ne hi]
  let perm : Equiv.Perm (Bits n) := hinvolutive.toPerm
  simpa only [cnotState, perm, Equiv.coe_fn_mk, Function.Involutive.toPerm, flip] using
    Equiv.sum_comp perm (fun x => Complex.normSq (ψ x))

/-- Every instruction of the concrete Clifford+T model preserves total probability. -/
theorem instr_mass {n : ℕ} (instruction : Instr n) (ψ : QState n) :
    (∑ x : Bits n, Complex.normSq (instruction.apply ψ x)) =
      ∑ x : Bits n, Complex.normSq (ψ x) := by
  cases instruction with
  | h wire => exact _root_.InfoLossLAR.WorstCase.apply1_mass hMat wire ψ _root_.InfoLossLAR.WorstCase.hMat_mass
  | s wire => exact _root_.InfoLossLAR.WorstCase.apply1_mass sMat wire ψ _root_.InfoLossLAR.WorstCase.sMat_mass
  | t wire => exact _root_.InfoLossLAR.WorstCase.apply1_mass tMat wire ψ _root_.InfoLossLAR.WorstCase.tMat_mass
  | x wire => exact _root_.InfoLossLAR.WorstCase.apply1_mass xMat wire ψ _root_.InfoLossLAR.WorstCase.xMat_mass
  | cnot control target hne => exact _root_.InfoLossLAR.WorstCase.cnotState_mass control target hne ψ

/-- A layer's actual sequential gate semantics preserves total probability. -/
theorem runLayer_mass {n : ℕ} (layer : List (Instr n)) (ψ : QState n) :
    (∑ x : Bits n, Complex.normSq (runLayer layer ψ x)) =
      ∑ x : Bits n, Complex.normSq (ψ x) := by
  induction layer generalizing ψ with
  | nil => rfl
  | cons instruction rest ih =>
    change (∑ x : Bits n, Complex.normSq (runLayer rest (instruction.apply ψ) x)) = _
    exact (ih (instruction.apply ψ)).trans (_root_.InfoLossLAR.WorstCase.instr_mass instruction ψ)

/-- The complete published circuit semantics preserves total probability.
No disjointness assumption is needed for this property. -/
theorem runLayered_mass {n : ℕ} (circuit : Layered n) (ψ : QState n) :
    (∑ x : Bits n, Complex.normSq (runLayered circuit ψ x)) =
      ∑ x : Bits n, Complex.normSq (ψ x) := by
  induction circuit generalizing ψ with
  | nil => rfl
  | cons layer rest ih =>
    change (∑ x : Bits n, Complex.normSq (runLayered rest (runLayer layer ψ) x)) = _
    exact (ih (runLayer layer ψ)).trans (_root_.InfoLossLAR.WorstCase.runLayer_mass layer ψ)

/-- The input specified by the platform is the normalized computational-basis
state with the classical bits followed by the zero ancillas. -/
theorem basisInput_mass {n a : ℕ} (x : Bits n) :
    (∑ y : Bits (n + (a + 1)), Complex.normSq (basisInput (a := a) x y)) = 1 := by
  let word : Bits (n + (a + 1)) := Fin.append x (fun _ => false)
  have hconditions (y : Bits (n + (a + 1))) :
      ((∀ i : Fin n, y (Fin.castAdd (a + 1) i) = x i) ∧
        (∀ l : Fin (a + 1), y (Fin.natAdd n l) = false)) ↔ y = word := by
    constructor
    · rintro ⟨hinput, hancilla⟩
      funext index
      refine Fin.addCases (fun i => ?_) (fun l => ?_) index
      · simpa only [word, Fin.append_left] using hinput i
      · simpa only [word, Fin.append_right] using hancilla l
    · intro heq
      subst y
      simp [word]
  classical
  simp [basisInput, hconditions]





end InfoLossLAR.WorstCase

end

