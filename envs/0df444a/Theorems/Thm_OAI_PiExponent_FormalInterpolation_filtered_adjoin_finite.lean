-- title:
--   Filtered lifting of finiteness from top components
-- statement:
--   Positive rational weights define an exhaustive positive filtration. Under the support bound, each generator has weighted degree at most D. If the ambient polynomial ring is finite over the algebra generated by the degree-D components, filtered lifting should give finite generation over the algebra generated by the original polynomials. The strict positivity and D > 0 hypotheses preserve the intended filtration and degree cutoff; the hbound uses ≤ D, so terms of degree exactly D are retained. When d = 0 the ambient polynomial ring is just ℂ and the conclusion is immediate. This removes the main finite-generation step from the parent. An independent route is to use the associated graded filtration: the degree-D components control the top forms, establish finite generation of the associated graded ambient ring, then lift a finite set of filtered module generators by induction on weighted degree. This is the remaining core obligation.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.filtered_adjoin_finite
    {d : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (g : Fin m → MvPolynomial (Fin d) Complex)
    (hbound : ∀ j, ∀ a ∈ (g j).support,
      ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real))
    (hfinite : Module.Finite
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j))))
      (MvPolynomial (Fin d) Complex)) :
    Module.Finite (Algebra.adjoin Complex (Set.range g))
      (MvPolynomial (Fin d) Complex) := by sorry
