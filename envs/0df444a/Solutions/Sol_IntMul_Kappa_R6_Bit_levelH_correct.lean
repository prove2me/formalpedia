-- Source module: Solutions.AModel
/-!
# Array model: mixed-radix arrays, pull maps, and linear address maps via Bruhat factors

Arrays are lists in row-major lexicographic order over fields (first field most significant).
All denotations are plain `List` functions.
-/

namespace AModel

open Matrix

/-! ## 1. Mixed-radix basics -/

lemma encode_decode {sh : Shape} {m : ℕ} (h : m < vol sh) : encode sh (decode sh m) = m := by
  induction sh generalizing m with
  | nil => simp at h; subst h; rfl
  | cons q sh ih =>
    simp only [vol_cons] at h
    have hV : 0 < vol sh := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    have hq : m / vol sh < q := (Nat.div_lt_iff_lt_mul hV).2 h
    simp only [decode, encode, List.headD_cons, List.tail_cons, Nat.mod_eq_of_lt hq,
      ih (Nat.mod_lt m hV)]
    exact Nat.div_add_mod' m (vol sh)

/-! ## 2. Pull maps -/

section Pull
variable {α : Type*}

/-- `pull` only depends on `g` at valid output addresses. -/
lemma pull_congr {sh sh' : Shape} {g g' : List ℕ → List ℕ}
    (h : ∀ a, Valid sh' a → g a = g' a) (d : α) (xs : List α) :
    pull sh sh' g d xs = pull sh sh' g' d xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_pull] at h₁
  rw [getElem_pull, getElem_pull, h _ (valid_decode h₁)]

/-- Composition of pulls. -/
theorem pull_comp {sh sh' sh'' : Shape} (g g' : List ℕ → List ℕ)
    (hg' : ∀ a, Valid sh'' a → Valid sh' (g' a)) (d : α) (xs : List α) :
    pull sh' sh'' g' d (pull sh sh' g d xs) = pull sh sh'' (g ∘ g') d xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_pull] at h₁
  have hv := hg' _ (valid_decode h₁)
  have hlt := encode_lt hv
  rw [getElem_pull, getElem_pull, List.getD_eq_getElem _ _ (by simpa using hlt), getElem_pull,
    decode_encode hv, Function.comp_apply]

theorem pull_id {sh : Shape} (d : α) {xs : List α} (h : xs.length = vol sh) :
    pull sh sh id d xs = xs := by
  apply List.ext_getElem (by simp [h])
  intro j h₁ h₂
  simp only [length_pull] at h₁
  rw [getElem_pull, id, encode_decode h₁, List.getD_eq_getElem]

end Pull

/-! ## 3. Active fields -/

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

namespace Layout

lemma actIdx_some {k : ℕ} {i : Fin n} (h : Λ.actIdx k = some i) : (Λ.pos i : ℕ) = k := by
  have := List.find?_some h
  simpa using this

lemma actIdx_pos (i : Fin n) : Λ.actIdx (Λ.pos i) = some i := by
  cases h : Λ.actIdx (Λ.pos i) with
  | none =>
    unfold actIdx at h
    rw [List.find?_eq_none] at h
    exact absurd (by simp) (h i (List.mem_finRange i))
  | some r => rw [Λ.mono.injective (Fin.ext (Λ.actIdx_some h))]

lemma actIdx_none {k : ℕ} (h : Λ.actIdx k = none) (i : Fin n) : (Λ.pos i : ℕ) ≠ k := by
  rintro rfl; rw [Λ.actIdx_pos] at h; cases h

end Layout

@[simp] lemma length_setAct (a : List ℕ) (v : Fin n → ZMod Q) :
    (setAct Λ a v).length = a.length := by simp [setAct]

lemma getElem_setAct (a : List ℕ) (v : Fin n → ZMod Q) (k : ℕ)
    (hk : k < (setAct Λ a v).length) :
    (setAct Λ a v)[k] = match Λ.actIdx k with
      | some i => (v i).val
      | none => a[k]'(by simpa using hk) := by
  simp [setAct]
  all_goals (split <;> simp_all)

lemma Valid.digit_lt {a : List ℕ} (ha : Valid sh a) (i : Fin n) :
    a.getD (Λ.pos i) 0 < Q := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  have h2 : (Λ.pos i : ℕ) < sh.length := (Λ.pos i).2
  have h1 : (Λ.pos i : ℕ) < a.length := by omega
  have := hlt _ h1 h2
  have hs := Λ.size i
  simp only [List.get_eq_getElem] at hs
  rw [List.getD_eq_getElem _ _ h1]; simpa [hs] using this

lemma valid_setAct [NeZero Q] {a : List ℕ} (ha : Valid sh a) (v : Fin n → ZMod Q) :
    Valid sh (setAct Λ a v) := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  refine (valid_iff _ _).2 ⟨by simp [hl], fun k h₁ h₂ => ?_⟩
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none => exact hlt _ _ _
  | some i =>
    have hk := Λ.actIdx_some h
    subst hk
    have := Λ.size i
    simp only [List.get_eq_getElem] at this
    simp only [this]
    exact ZMod.val_lt _

lemma valid_vmap [NeZero Q] (F : (Fin n → ZMod Q) → (Fin n → ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : Valid sh (vmap Λ F a) := valid_setAct Λ ha _

lemma valid_amap [NeZero Q] (L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : Valid sh (amap Λ L a) := valid_setAct Λ ha _

/-! ## 4. Controlled shift -/

/-! ## 5. Field transposition -/

section Swap

lemma val_act [NeZero Q] {a : List ℕ} (ha : Valid sh a) (i : Fin n) :
    (act Λ a i).val = a.getD (Λ.pos i) 0 := by
  rw [act, ZMod.val_natCast, Nat.mod_eq_of_lt (ha.digit_lt Λ i)]

theorem swapMap_eq_vmap [NeZero Q] (i j : Fin n) {a : List ℕ} (ha : Valid sh a) :
    swapMap Λ i j a = vmap Λ (fun x => x ∘ Equiv.swap i j) a := by
  have hl := ha.length_eq
  apply List.ext_getElem (by simp [swapMap, vmap])
  intro k h₁ h₂
  simp only [vmap] at h₂ ⊢
  rw [getElem_setAct]
  simp only [swapMap, List.getElem_set]
  have inj : ∀ p q : Fin n, ((Λ.pos p : ℕ) = Λ.pos q) ↔ p = q := fun p q =>
    ⟨fun h => Λ.mono.injective (Fin.ext h), fun h => h ▸ rfl⟩
  cases h : Λ.actIdx k with
  | none =>
    have := Λ.actIdx_none h
    simp [this i, this j]
  | some m =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only [Function.comp_apply, val_act Λ ha, inj, Equiv.swap_apply_def]
    have hm : (Λ.pos m : ℕ) < a.length := by omega
    by_cases hmj : j = m
    · subst hmj
      by_cases hij : j = i
      · subst hij; simp
      · simp [hij]
    · by_cases hmi : i = m
      · subst hmi; simp [hmj]
      · simp [hmj, hmi, Ne.symm hmj, Ne.symm hmi, List.getElem?_eq_getElem hm]

end Swap

/-! ## Primitive steps and their composition -/

namespace Step

variable [NeZero Q]

lemma inv_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.inv Λ a = vmap Λ s.invVec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma valid_inv (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.inv Λ a) := by
  rw [inv_eq Λ s ha]; exact valid_vmap Λ _ ha

end Step

section Run
variable [NeZero Q]

lemma runArr_pull {α : Type*} (d : α) (steps : List (Step n Q)) (g : List ℕ → List ℕ)
    (xs : List α) :
    runArr Λ d steps (pull sh sh g d xs) = pull sh sh (g ∘ invChain Λ steps) d xs := by
  induction steps generalizing g with
  | nil => rfl
  | cons s rest ih =>
    simp only [runArr, List.foldl_cons] at ih ⊢
    rw [Step.arr, pull_comp _ _ (fun a ha => Step.valid_inv Λ s ha), ih]
    rfl

/-- The array action of a list of steps is a single pull by the composed inverse. -/
theorem runArr_eq_pull {α : Type*} (d : α) (steps : List (Step n Q)) {xs : List α}
    (hxs : xs.length = vol sh) : runArr Λ d steps xs = pull sh sh (invChain Λ steps) d xs := by
  conv_lhs => rw [← pull_id d hxs]
  rw [runArr_pull]; rfl

end Run

/-! ## 6. Linear address maps through Bruhat factors -/

end AModel

end

