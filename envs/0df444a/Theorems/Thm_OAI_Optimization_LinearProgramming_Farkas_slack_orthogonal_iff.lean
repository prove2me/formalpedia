theorem slack_orthogonal_iff (A : Matrix (Fin m) (Fin d) K) (b : Fin m → K) (q : K)
    (y : Fin m → K) :
    (Fin.cons q y : Fin (m+1) → K) ∈ (LinearMap.range (slackMap A b)).orthogonalBilin
        (dotProductBilin K K) ↔ A.transpose *ᵥ y = 0 ∧ b ⬝ᵥ y = -q := by sorry
