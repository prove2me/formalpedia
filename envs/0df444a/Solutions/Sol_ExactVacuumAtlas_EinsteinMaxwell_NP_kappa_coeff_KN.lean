variable (p : Hintz2026.SubextremalKN) {x : Pt 4}
theorem solution (hx : x ∈ domReg p.M p.a p.Q) :
    3 * psi2 (gKN p.M p.a p.Q) (giKN p.M p.a p.Q) (knE p.M p.a p.Q) x
      - (ricF (gKN p.M p.a p.Q) (giKN p.M p.a p.Q) (knE p.M p.a p.Q) 0 1 x
        + ricF (gKN p.M p.a p.Q) (giKN p.M p.a p.Q) (knE p.M p.a p.Q) 2 3 x) / 2
      = -Hintz2026.Fplus p (toRT x) / qbarK p.a x ^ 3 := by
  rw [psi2_KN hx, ricF_KN_01 hx, ricF_KN_23 hx]
  unfold Hintz2026.Fplus
  rw [rhoBar_III, rhoBarStar_III]
  set M := p.M; set a := p.a; set Q := p.Q
  ( (
  have hq := kn_hq a x; have hqb := kn_hqb a x; have hSg := kn_hSg a x; have hDl := kn_hDl M a Q x
  have hsc := kn_hsc x; have hr2 := kn_hr2
