theorem Eb_le : ∀ k, Eb L s k ≤ (k + 1) * NLogN.KFN.Gb L s W A ^ k
  | 0 => by simp [Eb]
  | k + 1 => by
    have ih := Eb_le k
    set G := NLogN.KFN.Gb L s W A with hGd
    have hG : 10 ≤ G := by simp [hGd, NLogN.KFN.Gb]
    have hsG : s ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
    have hLG : L ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
    have p1 : G ≤ G ^ (k + 1) := Nat.le_self_pow (by omega) _
    have e : G * ((k + 1) * G ^ k) = (k + 1) * G ^ (k + 1) := by ring
    simp only [Eb]
    calc L + s * Eb L s k ≤ G + G * ((k + 1) * G ^ k) :=
          Nat.add_le_add hLG (Nat.mul_le_mul hsG ih)
      _ ≤ G ^ (k + 1) + (k + 1) * G ^ (k + 1) := by rw [e]; omega
      _ = (k + 1 + 1) * G ^ (k + 1) := by ring

theorem dwloc_le : dwloc W A ≤ 3 * NLogN.KFN.Gb L s W A ^ 2 := by
  unfold dwloc
  set G := NLogN.KFN.Gb L s W A with hGd
  have hG : 10 ≤ G := by simp [hGd, NLogN.KFN.Gb]
  have hWG : W ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
  have hAG : A ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
  have h1 : W * W ≤ G * G := Nat.mul_le_mul hWG hWG
  have h2 : 8 * G ≤ G * G := Nat.mul_le_mul_right G (by omega)
  have e : G ^ 2 = G * G := pow_two G
  have e2 : 2 * W * W = 2 * (W * W) := by ring
  rw [e, e2]
  omega

theorem DWb_le : ∀ k, DWb L s W A k ≤ 4 * (k + 1) ^ 2 * NLogN.KFN.Gb L s W A ^ (k + 2)
  | 0 => by
    simp only [DWb, zero_add, one_pow, mul_one]
    have : 1 ≤ NLogN.KFN.Gb L s W A ^ 2 := Nat.one_le_pow _ _ (by simp [NLogN.KFN.Gb])
    omega
  | k + 1 => by
    have ih := DWb_le k
    have hE := Eb_le L s W A k
    have hd := dwloc_le L s W A
    set G := NLogN.KFN.Gb L s W A with hGd
    have hG : 10 ≤ G := by simp [hGd, NLogN.KFN.Gb]
    have hsG : s ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
    have hLG : L ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
    have hWG : W ≤ G := by simp [hGd, NLogN.KFN.Gb]; omega
    set X := G ^ k with hX
    have hX1 : 1 ≤ X := Nat.one_le_pow _ _ (by omega)
    have e2 : G ^ (k + 2) = X * G * G := by rw [hX]; ring
    have e3 : G ^ (k + 1 + 2) = X * G * G * G := by rw [hX]; ring
    rw [e2] at ih
    rw [e3]
    simp only [DWb]
    set Y := X * G * G with hY
    have hY3 : Y ≤ Y * G := Nat.le_mul_of_pos_right _ (by omega)
    have hE2 : Eb L s k + 2 ≤ (k + 3) * X := by
      have : 2 ≤ 2 * X := by omega
      calc Eb L s k + 2 ≤ (k + 1) * X + 2 * X := by omega
        _ = (k + 3) * X := by ring
    have h1 : (Eb L s k + 2) * W ≤ (k + 3) * Y := by
      calc (Eb L s k + 2) * W ≤ ((k + 3) * X) * G := Nat.mul_le_mul hE2 hWG
        _ ≤ ((k + 3) * X) * G * G := Nat.le_mul_of_pos_right _ (by omega)
        _ = (k + 3) * Y := by rw [hY]; ring
    have h2 : DWb L s W A k + (Eb L s k + 2) * W ≤ (4 * (k + 1) ^ 2 + (k + 3)) * Y := by
      calc DWb L s W A k + (Eb L s k + 2) * W ≤ 4 * (k + 1) ^ 2 * Y + (k + 3) * Y :=
            Nat.add_le_add ih h1
        _ = _ := by ring
    have h3 : s * (DWb L s W A k + (Eb L s k + 2) * W) ≤
        (4 * (k + 1) ^ 2 + (k + 3)) * (Y * G) := by
      calc s * (DWb L s W A k + (Eb L s k + 2) * W)
          ≤ G * ((4 * (k + 1) ^ 2 + (k + 3)) * Y) := Nat.mul_le_mul hsG h2
        _ = _ := by ring
    have h4 : L * dwloc W A ≤ 3 * (Y * G) := by
      have a : L * dwloc W A ≤ G * (3 * G ^ 2) := Nat.mul_le_mul hLG hd
      have b0 : G ≤ X * G := Nat.le_mul_of_pos_left G (by omega)
      have b : G * G * G ≤ Y * G := by
        rw [hY]
        exact Nat.mul_le_mul_right G (Nat.mul_le_mul_right G b0)
      have e : G * (3 * G ^ 2) = 3 * (G * G * G) := by ring
      omega
    have hc : 4 * (k + 1) ^ 2 + (k + 3) + 3 ≤ 4 * (k + 1 + 1) ^ 2 := by
      have e : 4 * (k + 1 + 1) ^ 2 = 4 * (k + 1) ^ 2 + (8 * k + 12) := by ring
      omega
    calc s * (DWb L s W A k + (Eb L s k + 2) * W) + L * dwloc W A
        ≤ (4 * (k + 1) ^ 2 + (k + 3)) * (Y * G) + 3 * (Y * G) := Nat.add_le_add h3 h4
      _ = (4 * (k + 1) ^ 2 + (k + 3) + 3) * (Y * G) := by ring
      _ ≤ 4 * (k + 1 + 1) ^ 2 * (Y * G) := Nat.mul_le_mul_right _ hc
      _ = _ := by rw [hY]

