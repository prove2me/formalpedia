-- Source module: Solutions.J6SegSideCost3
/-!
# Side costs 3: the cost formulas as polynomials in `V = pre·t·post`, `p`, `wd`

Pure natural-number bounds:
* `passC_gen`: `passC pre L (2 post) Ba cu Tt Bo ≤ 2·10^5 · a · V · (cu + Ba + Bo + 50)` when
  `L + 1 ≤ a t`, `Tt ≤ a V`, `V = pre · t · post`, all `≥ 1`;
* `slabSc_le`, `slabId_le`, `slabOut_le`: the three slab-pass costs;
* `copy_le`, `swap_le`: the copy / swap;
* `fineN`: `cFine` as a natural number.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

theorem passC_gen {pre t post L Ba cu Tt Bo a : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post)
    (ht : 1 ≤ t) (ha : 1 ≤ a) (hL : L + 1 ≤ a * t) (hT : Tt ≤ a * (pre * t * post)) :
    Slab.passC pre L (2 * post) Ba cu Tt Bo ≤
      200000 * a * (pre * t * post) * (cu + Ba + Bo + 50) := by
  have h := Slab.passC_le pre L (2 * post) Ba cu Tt Bo
  generalize hV : pre * t * post = V at hT
  generalize hY : cu + Ba + Bo + 50 = Y
  have hX : cu + Ba + 1 ≤ Y := by omega
  have hBo : Bo + 43 ≤ Y := by omega
  have hY1 : 1 ≤ Y := by omega
  have hpreV : pre ≤ V := by
    rw [← hV]
    calc pre = pre * 1 * 1 := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul (Nat.mul_le_mul_left _ ht) hpost
  have h1 : (L + 1) * ((2 * post + 1) * (cu + Ba + 1)) ≤ (a * t) * ((3 * post) * Y) :=
    Nat.mul_le_mul hL (Nat.mul_le_mul (by omega) hX)
  have h2 : (pre + 1) * (20000 * ((L + 1) * ((2 * post + 1) * (cu + Ba + 1))) + 3000) ≤
      (2 * pre) * (20000 * ((a * t) * ((3 * post) * Y)) + 3000 * Y) :=
    Nat.mul_le_mul (by omega) (Nat.add_le_add (Nat.mul_le_mul_left _ h1) (by nlinarith))
  have e2 : (2 * pre) * (20000 * ((a * t) * ((3 * post) * Y)) + 3000 * Y) =
      120000 * a * (pre * t * post) * Y + 6000 * pre * Y := by ring
  rw [hV] at e2
  have h3 : (Tt + 1) * (76 * Bo + 3200) ≤ (2 * a * V) * (76 * Y) := by
    have hV1 : 1 ≤ V := le_trans (by omega) hpreV
    have : Tt + 1 ≤ 2 * a * V := by nlinarith
    exact Nat.mul_le_mul this (by omega)
  have h4 : 6000 * pre * Y ≤ 6000 * a * V * Y := by
    have : pre ≤ a * V := le_trans hpreV (Nat.le_mul_of_pos_left _ ha)
    nlinarith
  calc Slab.passC pre L (2 * post) Ba cu Tt Bo
      ≤ (pre + 1) * (20000 * ((L + 1) * ((2 * post + 1) * (cu + Ba + 1))) + 3000) +
        (Tt + 1) * (76 * Bo + 3200) := by
        have e : 2 * post + 1 = (2 * post) + 1 := rfl
        exact h
    _ ≤ (120000 * a * V * Y + 6000 * pre * Y) + (2 * a * V) * (76 * Y) := by
        rw [← e2]; exact Nat.add_le_add h2 h3
    _ ≤ 120000 * a * V * Y + 6000 * a * V * Y + (2 * a * V) * (76 * Y) := by omega
    _ ≤ 200000 * a * V * Y := by nlinarith

/-- `moveCost m ≤ 41 (m + 1)`. -/
theorem moveCost_le (m : ℕ) : moveCost m ≤ 41 * (m + 1) := by unfold moveCost; omega

/-- **Pass 1** (`Bu = p + 2`, `e ≤ 3p`, `n ≤ t`). -/
theorem slabSc_le {pre n t post p e : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post) (ht : 1 ≤ t)
    (hn : n ≤ t) (he : e ≤ 3 * p) (hp : 1 ≤ p) :
    cSlabSc pre n post (p + 2) e ≤ 600000 * (pre * t * post) * (3000 * (p + 1)) := by
  unfold cSlabSc
  have h := passC_gen (t := t) (a := 3) (L := n + n) (Tt := pre * (n * (2 * post)))
    (Ba := e + 2) (Bo := p + 2 + (e + 2))
    (cu := 2 * (p + 2) + 2 + (2 * moveCost (p + 2) + 19) + (300 * (p + 2 + 1) + 200 * (e + 1)) +
      (2 * moveCost (p + 2) + 19)) hpre hpost ht (by norm_num) (by omega) (by
        have : n * (2 * post) ≤ 3 * (t * post) := by nlinarith
        calc pre * (n * (2 * post)) ≤ pre * (3 * (t * post)) := Nat.mul_le_mul_left _ this
          _ = 3 * (pre * t * post) := by ring)
  have hm := moveCost_le (p + 2)
  refine h.trans ?_
  have : 2 * (p + 2) + 2 + (2 * moveCost (p + 2) + 19) + (300 * (p + 2 + 1) + 200 * (e + 1)) +
      (2 * moveCost (p + 2) + 19) + (e + 2) + (p + 2 + (e + 2)) + 50 ≤ 3000 * (p + 1) := by omega
  calc 200000 * 3 * (pre * t * post) * _ ≤ 200000 * 3 * (pre * t * post) * (3000 * (p + 1)) :=
        Nat.mul_le_mul_left _ this
    _ = _ := by ring

/-- **Passes 3 and 5** (`Bu = wd`, `n, n' ≤ 3t`). -/
theorem slabId_le {pre n n' t post wd : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post) (ht : 1 ≤ t)
    (hn : n ≤ 3 * t) (hn' : n' ≤ 3 * t) :
    cSlabId pre n n' post wd ≤ 1400000 * (pre * t * post) * (1000 * (wd + 1)) := by
  unfold cSlabId
  have h := passC_gen (t := t) (a := 7) (L := n + n') (Tt := pre * (n' * (2 * post)))
    (Ba := 1) (Bo := wd)
    (cu := 2 * wd + 2 + (2 * moveCost wd + 19) + 300 * (wd + 1) + (2 * moveCost wd + 19))
    hpre hpost ht (by norm_num) (by omega) (by
        have : n' * (2 * post) ≤ 7 * (t * post) := by nlinarith
        calc pre * (n' * (2 * post)) ≤ pre * (7 * (t * post)) := Nat.mul_le_mul_left _ this
          _ = 7 * (pre * t * post) := by ring)
  have hm := moveCost_le wd
  refine h.trans ?_
  have : 2 * wd + 2 + (2 * moveCost wd + 19) + 300 * (wd + 1) + (2 * moveCost wd + 19) + 1 +
      wd + 50 ≤ 1000 * (wd + 1) := by omega
  calc 200000 * 7 * (pre * t * post) * _ ≤ 200000 * 7 * (pre * t * post) * (1000 * (wd + 1)) :=
        Nat.mul_le_mul_left _ this
    _ = _ := by ring

/-- **Pass 7** (`Bu = wd`, `Ba = 2p+6`, `e ≤ 3p`, `n ≤ t`). -/
theorem slabOut_le {pre n t post wd p e : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post) (ht : 1 ≤ t)
    (hn : n ≤ t) (he : e ≤ 3 * p) :
    cSlabOut pre n post wd (2 * p + 6) e p ≤
      600000 * (pre * t * post) *
        (12 * NLogN.KFUU.cU (wd + (2 * p + 6) + 2) + 1000 * (wd + p + 1)) := by
  unfold cSlabOut
  have h := passC_gen (t := t) (a := 3) (L := n + n) (Tt := pre * (n * (2 * post)))
    (Ba := 2 * p + 6) (Bo := wd + (2 * p + 6) + 1)
    (cu := 2 * (2 * wd + 2) + 2 * (2 * moveCost wd + 19) +
      Slab.cItO (wd + (2 * p + 6) + 2) e p + 2 * (2 * moveCost wd + 19))
    hpre hpost ht (by norm_num) (by omega) (by
        have : n * (2 * post) ≤ 3 * (t * post) := by nlinarith
        calc pre * (n * (2 * post)) ≤ pre * (3 * (t * post)) := Nat.mul_le_mul_left _ this
          _ = 3 * (pre * t * post) := by ring)
  have hm := moveCost_le wd
  refine h.trans ?_
  have : 2 * (2 * wd + 2) + 2 * (2 * moveCost wd + 19) + Slab.cItO (wd + (2 * p + 6) + 2) e p +
      2 * (2 * moveCost wd + 19) + (2 * p + 6) + (wd + (2 * p + 6) + 1) + 50 ≤
      12 * NLogN.KFUU.cU (wd + (2 * p + 6) + 2) + 1000 * (wd + p + 1) := by
    unfold Slab.cItO; omega
  calc 200000 * 3 * (pre * t * post) * _ ≤ 200000 * 3 * (pre * t * post) * _ :=
        Nat.mul_le_mul_left _ this
    _ = _ := by ring

/-- **The copy.** -/
theorem copy_le (N B : ℕ) : cCopy N B ≤ 10 ^ 8 * (B + 2) ^ 2 + 100000 * (N + 1) * (B + 2) := by
  unfold cCopy cMvK1 KR.cMvP
  nlinarith

/-- **The swap.** -/
