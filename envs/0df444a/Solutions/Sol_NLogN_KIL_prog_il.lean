theorem Sp.toIRuns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {p : RS}
    {s t : IState HS} {c : ℕ} (h : Sp p s t c) : IRuns I iprog p.code s t c := by
  obtain ⟨c', hc', H⟩ := h.irun (I := I) (iprog := iprog)
  exact H.mono hc'

/-- A code with a generic stack-`0` specification run on a managed state. -/
theorem irun_top {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {code : IStmt HS Pp}
    {ys ys' : List ℤ} {c : ℕ}
    (h : ∀ (t : IState HS) (R : List Item), IRuns I iprog code (t.upd 0 (ints ys ++ R))
      (t.upd 0 (ints ys' ++ R)) c)
    (s : IState HS) (f : Fin HS → List ℤ) (rest : List ℤ) (hf : f 0 = ys ++ rest) :
    IRuns I iprog code (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (ys' ++ rest))) c := by
  have H := h (NLogN.KIL.encK s f) (ints rest ++ s.G 0)
  have e1 : (NLogN.KIL.encK s f).upd 0 (ints ys ++ (ints rest ++ s.G 0)) = NLogN.KIL.encK s f := by
    rw [← List.append_assoc, ← ints_append, ← hf]
    exact IState.upd_self _ _
  rw [e1] at H
  refine H.mono' ?_ le_rfl
  rw [← List.append_assoc, ← ints_append]
  apply IState.ext' <;> intros <;> simp [IState.upd_G, Function.update_apply] <;> split_ifs <;> simp_all

end NLogN.KIL

