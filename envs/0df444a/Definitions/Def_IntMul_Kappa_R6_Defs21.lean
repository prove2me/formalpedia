-- Source module: Solutions.R6IL2CTab
/-!
# Round six, compact controls (I2C): uniform offset tables and rotations

`tabGenR sgn T` pushes on stack 14 the table `p ↦ (sgn · segSum tf ru rv rw w0 (p/d1) (p/d2) n) mod Q`
(`p = P-1, …, 0`), all parameters on registers:
`1: P, 2: Q, 3: d1, 5: d2, 6: ru, 7: rv, 8: rw, 9: w0, 10: n, 11: R` (the term `T` may read `R`).
`rotR` pushes the parameters, runs the table generator and the record rotation `KFC.rotF`
(`rotR_runs`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open AModel NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## Parameters -/

abbrev pW0 : Fin HS := 9

/-- The table parameters on the registers of `t`. -/
structure TPar (t : IState HS) (Q d1 d2 : ℕ) (ru rv rw w0 Rv : ℤ) (n : ℕ) : Prop where
  q : ∃ L, t.G 2 = .int (Q : ℤ) :: L
  d1 : ∃ L, t.G 3 = .int (d1 : ℤ) :: L
  d2 : ∃ L, t.G 5 = .int (d2 : ℤ) :: L
  ru : ∃ L, t.G pRu = .int ru :: L
  rv : ∃ L, t.G pRv = .int rv :: L
  rw : ∃ L, t.G pRw = .int rw :: L
  w0 : ∃ L, t.G pW0 = .int w0 :: L
  n : ∃ L, t.G pN = .int (n : ℤ) :: L
  R : ∃ L, t.G pR = .int Rv :: L

/-- Managed parts that agree on the low registers. -/
def LowEq (G' G : Fin HS → List ℤ) : Prop := ∀ r : Fin HS, r.val < 13 → G' r = G r

/-! ## The expressions -/

/-- `(p / d)` with `p = rP - 1` and `d` from register `r`. -/
def argE (r : Fin HS) : Ex HS := .ndiv (.add (.reg KFL.rP) (.lit (-1))) (.reg r)

/-- `(sgn · rA + Q·Q) mod Q` with `Q` from register `2`. -/
def amtR (sgn : ℤ) : Ex HS :=
  .nmod (.add (.mul (.lit sgn) (.reg rA)) (.mul (.reg 2) (.reg 2))) (.reg 2)

/-! ## One table entry -/

/-- The table entry of prefix `p`. -/
def tabE (sgn : ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw w0 : ℤ) (d1 d2 Q n : ℕ) (p : ℕ) : ℕ :=
  ((sgn * segSum tf ru rv rw w0 ((p / d1 : ℕ) : ℤ) ((p / d2 : ℕ) : ℤ) n) % (Q : ℤ)).toNat

def tabBodyR (sgn : ℤ) (T : Ex HS) : RS :=
  .seq (.push rU (argE 3)) (.seq (.push rV (argE 5)) (.seq (.push rW (.reg pW0))
  (.seq (.push rA (.lit 0)) (.seq (segLoopR T) (.seq (.push 14 (amtR sgn)) (.seq (.pop rA)
  (.seq (.pop rW) (.seq (.pop rV) (.seq (.pop rU)
    (.asg KFL.rP (.add (.reg KFL.rP) (.lit (-1)))))))))))))

def cTabR (T : Ex HS) (Bb n : ℕ) : ℕ := cLp n (cSegItR T Bb) Bb + 60 * 10 ^ 7 * (Bb + 2) ^ 2

/-- The value hypotheses of a table. -/
structure TVal (Q d1 d2 : ℕ) (ru rv rw w0 Tm : ℤ) (n Bb : ℕ) : Prop where
  hQ : 0 < Q
  hd1 : 0 < d1
  hd2 : 0 < d2
  hru : 0 < ru
  hrv : 0 < rv
  hrw : 2 ≤ rw
  hw0 : 0 < w0
  hTm : 1 ≤ Tm
  hB2 : 2 ≤ Bb
  zru : zsz ru ≤ Bb
  zrv : zsz rv ≤ Bb
  zrw : zsz rw ≤ Bb
  zw0 : zsz w0 ≤ Bb
  zn : zsz (n : ℤ) ≤ Bb
  zd1 : zsz (d1 : ℤ) ≤ Bb
  zd2 : zsz (d2 : ℤ) ≤ Bb
  hQQ : Tm * w0 * rw ^ n ≤ (Q : ℤ) * Q
  hbig : 2 * ((Q : ℤ) * Q) < 2 ^ Bb

/-! ## The table generator -/

def tabGenR (sgn : ℤ) (T : Ex HS) : RS :=
  .seq (.push KFL.rP (.reg 1)) (.seq (.rep rq (.reg 1) (tabBodyR sgn T)) (.pop KFL.rP))

def cTabGenR (T : Ex HS) (Bb n P : ℕ) : ℕ := cLp P (cTabR T Bb n) Bb + 3 * 10 ^ 7 * (Bb + 2) ^ 2

/-! ## The rotation -/

/-- The parameter list: `P, Q, B` for `rotF` on `1, 2, 4`, the table parameters on `3, 5, …, 11`. -/
def rotPlR (eP eQ eB e1 e2 eu ev ew e0 en eR : Ex HS) : List (Fin HS × Ex HS) :=
  [(1, eP), (2, eQ), (4, eB), (3, e1), (5, e2), (6, eu), (7, ev), (8, ew), (9, e0), (10, en), (11, eR)]

/-- **One uniform table rotation.** -/
def rotR {Pp : ℕ} (sgn : ℤ) (T : Ex HS) (eP eQ eB e1 e2 eu ev ew e0 en eR : Ex HS) : IStmt HS Pp :=
  withPushI (rotPlR eP eQ eB e1 e2 eu ev ew e0 en eR) (.seq (fcode (tabGenR sgn T)) KFC.rotF)

def cRotR (T : Ex HS) (Bb n P Q B w : ℕ) : ℕ :=
  cTabGenR T Bb n P + KFC.cRotF P Q B w + 10 ^ 10 * (Bb + 2) ^ 2

/-- The pushed table parameters (for `TPar`). -/
def TPars (P Q B d1 d2 : ℕ) (ru rv rw w0 : ℤ) (n : ℕ) (Rv : ℤ) : List (Fin HS × ℤ) :=
  [(1, (P : ℤ)), (2, (Q : ℤ)), (4, (B : ℤ)), (3, (d1 : ℤ)), (5, (d2 : ℤ)), (6, ru), (7, rv),
    (8, rw), (9, w0), (10, (n : ℤ)), (11, Rv)]

end IntMul.Kappa.R6.IL2C

end

