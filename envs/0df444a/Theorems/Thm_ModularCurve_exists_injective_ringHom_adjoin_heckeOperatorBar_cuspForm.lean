import Mathlib
import Definitions.Def_ModularCurve_HeckeModule
import Definitions.Def_ModularCurve_HeckeInputsAll
import Definitions.Def_ModularForm_HeckeOperatorForms

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

theorem ModularCurve.exists_injective_ringHom_adjoin_heckeOperatorBar_cuspForm (N : ℕ) [NeZero N]
    (hin : ModularCurve.HeckeInputsAll N) (hcomm : ModularCurve.HeckeOperatorsCommuteBar N) :
    ∃ Φ : ↥(Algebra.adjoin ℤ (Set.range (ModularCurve.heckeOperatorBar N))) →+*
        Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2),
      Function.Injective Φ ∧
      ∀ (ℓ : Nat.Primes) (hℓN : ¬ (ℓ : ℕ) ∣ N),
        Φ ⟨ModularCurve.heckeOperatorBar N ℓ, Algebra.subset_adjoin (Set.mem_range_self ℓ)⟩
          = CuspForm.heckeTLin 2 ℓ.prop hℓN := by sorry
