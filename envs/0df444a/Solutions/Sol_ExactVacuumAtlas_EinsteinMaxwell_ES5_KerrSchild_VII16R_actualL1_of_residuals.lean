theorem vii04_compactified_bridge (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    {Q J : ℝ} (hB : PaperBVP I f m N w p a Q J) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I) :
    realPF h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPM h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPA h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPC h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) =
      realGamma h Q J (pull s f) (pullM s m) (pull s a) x := by
  obtain ⟨hq, hl, -, hF, hM, h24, hC⟩ := hB _ hxI
  have h24' : eq24cResidual f m N a Q J (s + x⁻¹) = 0 := sub_eq_zero.mpr h24
  obtain ⟨e1, e2, e3, e4⟩ := (compact_iff_paper hP hN hx hxI Q J).mpr ⟨hF, hM, h24', hC⟩
  exact ⟨e1, e2, e3, e4, realGamma_eq hP hx hxI hN (fun r hr => (hB r hr).1)
    (e_w_of_constants hP hxI hq hl).2⟩

/-- The same on an explicit interval `0 < x < ε` of the chart, for `I ⊇ (s + 1/ε, ∞)`. -/
theorem vii04_compactified_bridge_Ioo (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    {Q J : ℝ} (hB : PaperBVP I f m N w p a Q J) {ε : ℝ} (hε : 0 < ε)
    (hsub : Set.Ioi (s + ε⁻¹) ⊆ I) :
    ∀ x ∈ Set.Ioo 0 ε,
      realPF h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPM h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPA h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPC h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) =
        realGamma h Q J (pull s f) (pullM s m) (pull s a) x := by
  intro x hx
  have hxI : s + x⁻¹ ∈ I :=
    hsub (show s + ε⁻¹ < s + x⁻¹ by linarith [(inv_lt_inv₀ hε hx.1).mpr hx.2])
  exact vii04_compactified_bridge hP hN hB hx.1.ne' hxI

end Roots

