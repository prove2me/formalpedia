-- title:
--   Fibres and ramification of j at moduli places of X₀(N)
-- statement:
--   Let $K$ be an algebraically closed field, $N\ge 1$ a natural number with $N\ne 0$ in $K$, and let $F_N=\mathrm{modularFunctionFieldFullC}\;K\;N$ be the $K$-subfield of the Laurent series field $K((q))$ generated by the series $\mathrm{qExpand}\;K\;d\,(\mathrm{jqModC}\;K)$ for the nonzero divisors $d$ of $N$, where $\mathrm{jqModC}\;K=q^{-1}\cdot(E_4^3\,\eta^{-24})$ is the $q$-expansion $\tilde j$ of the modular invariant; a place of $F_N$ over $K$ means a valuation subring of $F_N$ containing $K$, distinct from $F_N$ and a principal ideal ring, and $\mathrm{ord}$ is the associated normalised valuation. For an elliptic Weierstrass curve $E$ over $K$ and a subgroup $C\subseteq E(K)$, $\mathrm{moduliPlace}\;K\;N\;E\;C$ is the place of $F_N$ attached by a test datum to the class of $(E,g)$ in the quotient of pairs (curve, point of additive order $N$) by changes of variable and prime-to-$N$ scaling, when $C=\langle g\rangle$ for such a $g$, and the cusp place otherwise. Assume moduli places are unique: for every class $x$ of such pairs over $K$, any two places $v,v'$ of $F_N$ with $\mathrm{IsModuliPlaceOf}\;K\;N\;x\;v$ and $\mathrm{IsModuliPlaceOf}\;K\;N\;x\;v'$ are equal. Then four statements hold, for elliptic Weierstrass curves $E,E'$ over $K$ and subgroups $C\subseteq E(K)$, $C'\subseteq E'(K)$ that are cyclic of cardinality $N$: (1) $\mathrm{ord}_{\mathrm{moduliPlace}\;K\;N\;E\;C}(\tilde j-j(E))>0$; (2) every place $P$ of $F_N$ over $K$ with $\mathrm{ord}_P(\tilde j-j(E))>0$ equals $\mathrm{moduliPlace}\;K\;N\;E\;C$ for some such $C$; (3) $\mathrm{moduliPlace}\;K\;N\;E\;C=\mathrm{moduliPlace}\;K\;N\;E'\;C'$ if and only if there is a Weierstrass variable change $\gamma$ with $\gamma\cdot E=E'$ such that for every $T\in C$ the point $\mathrm{Point.vcInvFun}\;\gamma\;E\;T$ is heterogeneously equal to some element of $C'$; and (4) $\mathrm{ord}_{\mathrm{moduliPlace}\;K\;N\;E\;C}(\tilde j-j(E))$ equals, as an integer, the number of cyclic subgroups $C'$ of $E(K)$ of cardinality $N$ with $\mathrm{moduliPlace}\;K\;N\;E\;C'=\mathrm{moduliPlace}\;K\;N\;E\;C$.
--
--   This is the modular description of the fibres of the map $j$ on $X_0(N)$ over an algebraically closed field in which $N$ is invertible: the places lying over a value $j(E)$ are exactly the moduli places of the pairs $(E,C)$ with $C$ cyclic of order $N$, two such places agreeing precisely when the pairs are isomorphic through a change of Weierstrass coordinates, and the ramification index at such a place counting the corresponding orbit of cyclic subgroups. It is used in the analysis of supersingular places and in the Čerednik–Drinfeld style comparison of class sets with places of the modular function field.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_moduliPlace_orbitClauses.lean

import Mathlib
import Definitions.Def_ModularCurve_ModuliPlace
import Definitions.Def_WeierstrassCurve_VariableChangePointEquiv

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicCurve ModularCurve WeierstrassCurve WeierstrassCurve.Affine

universe u in

theorem ModularCurve.moduliPlace_orbitClauses
    (K : Type u) [Field K] [IsAlgClosed K] [DecidableEq K] (N : ℕ) [NeZero N] (hN : (N : K) ≠ 0)
    (huniq : ∀ (x : ModuliPoint N K) (v v' : Place K (modularFunctionFieldFullC K N)),
      IsModuliPlaceOf K N x v → IsModuliPlaceOf K N x v' → v = v') :
    (∀ (E : WeierstrassCurve K) [E.IsElliptic]
        (C : {C : AddSubgroup E.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N}),
        0 < (moduliPlace K N E C.1).ord
          ((⟨jqModC K, jqModC_mem_full K N⟩ : modularFunctionFieldFullC K N) -
            algebraMap K (modularFunctionFieldFullC K N) E.j)) ∧
    (∀ (E : WeierstrassCurve K) [E.IsElliptic] (P : Place K (modularFunctionFieldFullC K N)),
        0 < P.ord ((⟨jqModC K, jqModC_mem_full K N⟩ : modularFunctionFieldFullC K N) -
          algebraMap K (modularFunctionFieldFullC K N) E.j) →
        ∃ C : {C : AddSubgroup E.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N},
          moduliPlace K N E C.1 = P) ∧
    (∀ (E E' : WeierstrassCurve K) [E.IsElliptic] [E'.IsElliptic]
        (C : {C : AddSubgroup E.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N})
        (C' : {C : AddSubgroup E'.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N}),
        moduliPlace K N E C.1 = moduliPlace K N E' C'.1 ↔ ∃ γ : VariableChange K, γ • E = E' ∧
          ∀ T ∈ C.1, ∃ T' ∈ C'.1, HEq (Point.vcInvFun γ E.toAffine T) T') ∧
    (∀ (E : WeierstrassCurve K) [E.IsElliptic]
        (C : {C : AddSubgroup E.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N}),
        (moduliPlace K N E C.1).ord
            ((⟨jqModC K, jqModC_mem_full K N⟩ : modularFunctionFieldFullC K N) -
              algebraMap K (modularFunctionFieldFullC K N) E.j) =
          (Nat.card {C' : {C : AddSubgroup E.toAffine.Point // IsAddCyclic C ∧ Nat.card C = N} //
            moduliPlace K N E C'.1 = moduliPlace K N E C.1} : ℤ)) := by sorry
