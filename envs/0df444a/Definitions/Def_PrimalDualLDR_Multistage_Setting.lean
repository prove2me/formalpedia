-- title:
--   Linear multistage stochastic program 𝓜𝒮𝒫 — data, standing assumptions, linear conditional mean, strict feasibility (pp. 17–19)
-- statement:
--   The data of the linear multistage stochastic program $\mathcal{MSP}$ of §4 (pp. 17–19).
--
--   There are $T$ stages $t \in \mathbb T = \{1,\dots,T\}$. The random vector $\xi = (\xi_1,\dots,\xi_T) \in \mathbb R^k$ has stage components $\xi_t \in \mathbb R^{k_t}$ and law $\mathbb P$ on $(\mathbb R^k, \mathfrak B(\mathbb R^k))$; $\xi^t = P_t\xi \in \mathbb R^{k^t}$ is the history up to stage $t$. Stage $t$ has $n_t$ decisions and $m_t$ constraints. The data are
--   - $W \in \mathbb R^{l\times k}$ and $h \in \mathbb R^l$ describing the support $\Xi = \{\xi : W\xi \ge h\}$ (2.1);
--   - deterministic constraint matrices $A_{ts} \in \mathbb R^{m_t\times n_s}$;
--   - $B_t \in \mathbb R^{m_t\times k^t}$ and $C_t \in \mathbb R^{n_t\times k^t}$, giving $b_t(\xi^t) = B_tP_t\xi$ and $c_t(\xi^t) = C_tP_t\xi$;
--   - matrices $M_t \in \mathbb R^{k\times k^t}$ for the conditional mean.
--
--   $\mathbb E_t(\cdot)$ is the conditional expectation given $\xi^t$, that is, with respect to the $\sigma$-algebra generated by $P_t$. A stage-$t$ decision rule in $\mathcal L^2_{k^t,d}$ is a Borel function $x : \mathbb R^{k^t}\to\mathbb R^d$ with $\mathbb E\|x(\xi^t)\|^2 < \infty$.
--
--   The **standing assumptions** of §4 are: $T \ge 1$ and $k_1 = 1$; $\Xi$ is the support of $\mathbb P$, nonempty and bounded; $W, h$ have the form (2.1b) — $l \ge 2$, the first two rows of $W$ are $e_1^\top$ and $-e_1^\top$, and $h = (1,-1,0,\dots,0)$; and $\Xi$ spans $\mathbb R^k$.
--
--   The **linear conditional mean** assumption (p. 19) is
--   $$\mathbb E_t(\xi) = M_tP_t\xi \quad \mathbb P\text{-a.s.}, \qquad t \in \mathbb T.$$
--
--   $M := \mathbb E(\xi\xi^\top)$ is the second-order moment matrix. $\mathcal{MSP}$ is **strictly feasible** if there are $\varepsilon > 0$ and $\bar x_t \in \mathcal L^2_{k^t,n_t}$, $\bar s_t \in \mathcal L^2_{k^t,m_t}$ with
--   $$\mathbb E_t\Big(\sum_{s=1}^T A_{ts}\bar x_s(\xi^s)\Big) + \bar s_t(\xi^t) = b_t(\xi^t), \qquad \bar s_t(\xi^t) \ge \varepsilon e \quad \mathbb P\text{-a.s.}, \ t\in\mathbb T.$$
--
--   These are the objects of Theorem 3: the hypotheses under which the primal and dual linear-decision-rule approximations of $\mathcal{MSP}$ reduce to linear programs.
--
--   **Formalization Note** §4 uses "strictly feasible" without defining it for $\mathcal{MSP}$; the definition above is the analogue of (2.9) (p. 9) for the standard form (4.1), and is our pinning of the term. The matrices $M_t$ are taken as data and the linear-conditional-mean assumption is a separate predicate on them; under the standing assumptions they are uniquely determined by it, since $P_t\Xi$ spans $\mathbb R^{k^t}$. $\mathbb E_t$ is Mathlib's `condExp` with respect to `MeasurableSpace.comap P_t`. Stage $t$ is the `Fin T` index $t-1$.
-- source:
--   Kuhn, Wiesemann, Georghiou, Primal and dual linear decision rules in stochastic and robust optimization, Optimization Online 2009/02/2218, pp. 3–4 ((2.1a), (2.1b), M), p. 9 ((2.9)), pp. 17–19 (§4, 𝓜𝒮𝒫, (4.1), E_t(ξ) = M_tP_tξ)

import Mathlib
import Definitions.Def_PrimalDualLDR_Multistage_Basic

open MeasureTheory

namespace PrimalDualLDR.Multistage

/-- The data of the linear multistage stochastic program `𝓜𝒮𝒫` of §4 (pp. 17–19) of Kuhn, Wiesemann,
Georghiou, Optimization Online 2009/02/2218. Stage `t ∈ 𝕋 = {1, …, T}` of the paper is the `Fin T`
index `t - 1`.
* `kk t = k_t` is the dimension of the stage-`t` observation `ξ_t`; the sample space is `ℝ^k`,
  `k = Σ_t k_t` (`ksum kk`), and the history `ξ^t` lives in `ℝ^{k^t}` (`kbar kk t`);
* `n t = n_t`, `m t = m_t` are the numbers of decisions and of constraints of stage `t`;
* `P` is a probability measure on `(ℝ^k, 𝔅(ℝ^k))`; `W ∈ ℝ^{l×k}`, `h ∈ ℝ^l` describe its support (2.1);
* `A t s = A_ts ∈ ℝ^{m_t × n_s}` are the deterministic constraint matrices, `B t = B_t ∈ ℝ^{m_t × k^t}`
  gives the right-hand side `b_t(ξ^t) = B_t P_t ξ`, and `C t = C_t ∈ ℝ^{n_t × k^t}` the cost
  `c_t(ξ^t) = C_t P_t ξ` (p. 18);
* `Mt t = M_t ∈ ℝ^{k × k^t}` are the matrices of the linear conditional mean `𝔼_t(ξ) = M_t P_t ξ`
  (p. 19); the hypothesis that they are such matrices is `Setting.LinearCondMean`. -/
structure Setting where
  T : ℕ
  kk : Fin T → ℕ
  n : Fin T → ℕ
  m : Fin T → ℕ
  l : ℕ
  P : Measure (Fin (ksum kk) → ℝ)
  [isProb : IsProbabilityMeasure P]
  W : Matrix (Fin l) (Fin (ksum kk)) ℝ
  h : Fin l → ℝ
  A : (t s : Fin T) → Matrix (Fin (m t)) (Fin (n s)) ℝ
  B : (t : Fin T) → Matrix (Fin (m t)) (Fin (kbar kk t)) ℝ
  C : (t : Fin T) → Matrix (Fin (n t)) (Fin (kbar kk t)) ℝ
  Mt : (t : Fin T) → Matrix (Fin (ksum kk)) (Fin (kbar kk t)) ℝ

attribute [instance] Setting.isProb

namespace Setting

variable (σ : Setting)

/-- The dimension `k = Σ_t k_t` of the sample space. -/
abbrev k : ℕ := ksum σ.kk

/-- The history dimension `k^t`. -/
abbrev kb (t : Fin σ.T) : ℕ := kbar σ.kk t

/-- The truncation operator `P_t : ℝ^k → ℝ^{k^t}`, `ξ ↦ ξ^t`. -/
abbrev tr (t : Fin σ.T) : (Fin σ.k → ℝ) → (Fin (σ.kb t) → ℝ) := trunc σ.kk t

/-- The truncation matrix `P_t ∈ ℝ^{k^t × k}`. -/
abbrev Pt (t : Fin σ.T) : Matrix (Fin (σ.kb t)) (Fin σ.k) ℝ := Pmat σ.kk t

/-- The set `Ξ = {ξ ∈ ℝ^k : Wξ ≥ h}` of (2.1a). -/
def Xi : Set (Fin σ.k → ℝ) := PrimalDualLDR.FixedRecourse.polyhedron σ.W σ.h

/-- The σ-algebra generated by the history `ξ^t`, i.e. by the truncation `P_t`; `𝔼_t(·)` is the
conditional expectation with respect to it (p. 18). -/
abbrev F (t : Fin σ.T) : MeasurableSpace (Fin σ.k → ℝ) :=
  MeasurableSpace.comap (σ.tr t) inferInstance

/-- `x` is a stage-`t` decision rule in `𝓛²_{k^t,d}`: a Borel measurable function of the history
`ξ^t ∈ ℝ^{k^t}` whose composition `ξ ↦ x(ξ^t)` is square-integrable under `P` (p. 18). -/
def IsL2RuleAt (t : Fin σ.T) {d : ℕ} (x : (Fin (σ.kb t) → ℝ) → (Fin d → ℝ)) : Prop :=
  Measurable x ∧ MemLp (fun ξ => x (σ.tr t ξ)) 2 σ.P

/-- The standing assumptions of §4 (pp. 17–18), i.e. those of §2 (pp. 3–4) together with `k_1 = 1`:
1. `T ≥ 1` and `k_1 = 1`;
2. `Ξ = {Wξ ≥ h}` is the support of `P` (2.1a);
3. `Ξ` is nonempty and bounded;
4. `W` and `h` have the form (2.1b): `l ≥ 2`, the first row of `W` is `e_1ᵀ`, the second is `−e_1ᵀ`,
   `h = (1, −1, 0, …, 0)`;
5. the linear hull of `Ξ` is `ℝ^k`. -/
def Standing : Prop :=
  (∃ hT : 0 < σ.T, σ.kk ⟨0, hT⟩ = 1) ∧
  PrimalDualLDR.FixedRecourse.IsSupport σ.P σ.Xi ∧ σ.Xi.Nonempty ∧ Bornology.IsBounded σ.Xi ∧
  2 ≤ σ.l ∧
  (∀ i : Fin σ.l,
    (i.val = 0 → σ.W i = PrimalDualLDR.FixedRecourse.e1 σ.k ∧ σ.h i = 1) ∧
    (i.val = 1 → σ.W i = -PrimalDualLDR.FixedRecourse.e1 σ.k ∧ σ.h i = -1) ∧
    (2 ≤ i.val → σ.h i = 0)) ∧
  Submodule.span ℝ σ.Xi = ⊤

/-- The linear-conditional-mean assumption (p. 19): for every stage `t`, `𝔼_t(ξ) = M_t P_t ξ`
`P`-almost surely. -/
def LinearCondMean : Prop :=
  ∀ t : Fin σ.T, σ.P[fun ξ => ξ | σ.F t] =ᵐ[σ.P] fun ξ => (σ.Mt t * σ.Pt t).mulVec ξ

/-- The second-order moment matrix `M := 𝔼(ξξᵀ)` (p. 4), entrywise `M_{ij} = ∫ ξ_i ξ_j dP`. -/
noncomputable def M : Matrix (Fin σ.k) (Fin σ.k) ℝ :=
  fun i j => ∫ ξ, ξ i * ξ j ∂σ.P

/-- Strict feasibility of `𝓜𝒮𝒫`, the multistage analogue of (2.9) (p. 9) for the standard form (4.1)
(p. 19): there are `ε > 0` and non-anticipative rules `x̄_t ∈ 𝓛²_{k^t,n_t}`, `s̄_t ∈ 𝓛²_{k^t,m_t}` with
`𝔼_t(Σ_s A_ts x̄_s(ξ^s)) + s̄_t(ξ^t) = b_t(ξ^t)` and `s̄_t(ξ^t) ≥ ε e` `P`-almost surely for every `t`.
§4 uses but does not define the term; this is our pinning of it. -/
def StrictlyFeasible : Prop :=
  ∃ ε : ℝ, 0 < ε ∧
    ∃ (xbar : (t : Fin σ.T) → (Fin (σ.kb t) → ℝ) → (Fin (σ.n t) → ℝ))
      (sbar : (t : Fin σ.T) → (Fin (σ.kb t) → ℝ) → (Fin (σ.m t) → ℝ)),
      (∀ t, σ.IsL2RuleAt t (xbar t)) ∧ (∀ t, σ.IsL2RuleAt t (sbar t)) ∧
      ∀ t : Fin σ.T, ∀ᵐ ξ ∂σ.P,
        σ.P[fun ξ' => ∑ s, (σ.A t s).mulVec (xbar s (σ.tr s ξ')) | σ.F t] ξ + sbar t (σ.tr t ξ) =
            (σ.B t * σ.Pt t).mulVec ξ ∧
          ∀ i, ε ≤ sbar t (σ.tr t ξ) i

end Setting

end PrimalDualLDR.Multistage


