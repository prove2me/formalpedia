lemma SlotArr.spos_inj (hS : SlotArr D a arr) {i i' : Fin D} {h h' : ℕ} (hh : h < a i)
    (hh' : h' < a i') (he : spos D arr i h = spos D arr i' h') : i = i' ∧ h = h' := by
  have e1 := hS.getD_spos hh
  rw [he, hS.getD_spos hh'] at e1
  exact nm_inj D e1.symm

