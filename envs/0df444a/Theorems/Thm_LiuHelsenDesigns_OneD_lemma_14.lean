-- title:
--   Lemma 14 — free-ring elementary generators
-- statement:
--   For any nonnegative integer l, let $R=\mathbb Z\langle w_1,\ldots,w_l\rangle$. The group EL(3;R) is generated by the following six plus 4l matrices and their inverses:
--
--   $$
--   E_{\alpha\beta}(1)\ (\alpha\ne\beta),\qquad E_{12}(w_j),E_{23}(w_j),E_{21}(w_j),E_{32}(w_j)\ (1\le j\le l).
--   $$
--
--   Inverses occur with the negated coefficient. The case of no free generators is retained.
--
--   Differences from the source:
--   - encoding: a matrix group generated by elements and their inverses → matrix submonoid closure with negative elementary coefficients explicitly included; reason: all elementary inverses are among these generators, so the carrier is the same group
-- source:
--   Guoding Liu, Jonas Helsen, STOC 2027 submission #221 (October 2026), p. 33, Lemma 14. https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/221.pdf

import Definitions.Def_LiuHelsenDesigns_OneD_elementary

namespace LiuHelsenDesigns.OneD
theorem lemma_14 (l : ℕ) :
    EL (Fin 3) (FreeRing (Fin l)) = Submonoid.closure (freeGenerators l) := by sorry
end LiuHelsenDesigns.OneD
