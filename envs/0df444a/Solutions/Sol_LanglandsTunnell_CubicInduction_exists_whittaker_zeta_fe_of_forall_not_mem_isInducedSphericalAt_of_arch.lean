variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem le_exp_neg_one_of_ne_zero_of_lt_one {x : WithZero (Multiplicative ℤ)} (hx0 : x ≠ 0) (hx : x < 1) :
    x ≤ WithZero.exp (-1) := by
  obtain ⟨k, rfl⟩ : ∃ k : ℤ, WithZero.exp k = x := ⟨WithZero.log x, WithZero.exp_log hx0⟩
  rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hx
  rw [WithZero.exp_le_exp]
  omega

private theorem valued_eq_one_of_forall_apply_eq_apply_mul {χ χ' : AddChar (v.adicCompletion ℚ) ℂ}
    {c : v.adicCompletion ℚ} (hχ' : ∀ s, χ' s = χ (c * s))
    (h₁ : ∀ x, Valued.v x ≤ 1 → χ x = 1) (h₂ : ∃ x, Valued.v x ≤ WithZero.exp 1 ∧ χ x ≠ 1)
    (h₁' : ∀ x, Valued.v x ≤ 1 → χ' x = 1) (h₂' : ∃ x, Valued.v x ≤ WithZero.exp 1 ∧ χ' x ≠ 1) :
    Valued.v c = 1 := by
  obtain ⟨x₀, hx₀, hx₀ne⟩ := h₂
  obtain ⟨x₁, hx₁, hx₁ne⟩ := h₂'
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hx₁ne ((hχ' x₁).trans (by rw [zero_mul]; exact h₁ 0 (by simp)))
  rcases lt_trichotomy (Valued.v c) 1 with hlt | heq | hgt
  ·
    exfalso
    refine hx₁ne ((hχ' x₁).trans (h₁ _ ?_))
    rw [map_mul]
    calc Valued.v c * Valued.v x₁ ≤ WithZero.exp (-1) * WithZero.exp 1 :=
          mul_le_mul' (le_exp_neg_one_of_ne_zero_of_lt_one ((Valuation.ne_zero_iff _).2 hc0) hlt) hx₁
      _ = 1 := by rw [← WithZero.exp_add]; simp
  · exact heq
  ·
    exfalso
    have hinv : Valued.v c⁻¹ < 1 := by
      rw [map_inv₀]
      exact inv_lt_one_of_one_lt₀ hgt
    refine hx₀ne ?_
    have e : x₀ = c * (c⁻¹ * x₀) := by rw [← mul_assoc, mul_inv_cancel₀ hc0, one_mul]
    rw [e, ← hχ']
    refine h₁' _ ?_
    rw [map_mul]
    calc Valued.v c⁻¹ * Valued.v x₀ ≤ WithZero.exp (-1) * WithZero.exp 1 :=
          mul_le_mul' (le_exp_neg_one_of_ne_zero_of_lt_one ((Valuation.ne_zero_iff _).2 (inv_ne_zero hc0)) hinv) hx₀
      _ = 1 := by rw [← WithZero.exp_add]; simp

end
