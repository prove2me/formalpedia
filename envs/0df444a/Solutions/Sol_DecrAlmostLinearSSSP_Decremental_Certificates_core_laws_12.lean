section s401
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.Structured
lemma Atom.nat_mem_read (a : Atom) (s : Data) (address : ℕ) :
    (a.effect s).natMem address = primitiveNatMemory a.instruction s address := by
  cases a with
  | mk ins hs =>
    cases ins <;> simp only [Straight] at hs
    all_goals try contradiction
    all_goals simp [Atom.effect,primitiveNatMemory,data,Data.machine,instructionEffect,Function.update_apply,eq_comm]
lemma Atom.real_mem_read (a : Atom) (s : Data) (address : ℕ) :
    (a.effect s).realMem address = primitiveRealMemory a.instruction s address := by
