  | [], _, _ => rfl
  | w :: l, a, h => by
    simp only [sumZ, List.foldl_cons]
    have e : (List.zipWith (· + ·) a (Y w)).length = a.length := by
      simp [h w List.mem_cons_self]
    rw [← e]
