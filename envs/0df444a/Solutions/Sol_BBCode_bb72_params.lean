private lemma zpairLeft : ∀ i j : Fin 72, i < j →
    zlookup (zmask i ^^^ zmask j).toNat = (i.val,j.val) := by decide +kernel
private lemma zlower (v : Fin 72 → ZMod 2) (hv : zH *ᵥ v = 0) (hn : v ≠ 0) :
    6 ≤ weight v :=
  min_six zH zcolParity zcolInj (pair_injective zmask zlookup zpairLeft) v hv hn
private lemma ztable : (HZ polyA polyB).submatrix er eqb = zH := by decide +kernel

private def zv : Fin 72 → ZMod 2 := fun i => if i.val ∈ [0,1,2,3,20,22] then 1 else 0
private def xv : Fin 72 → ZMod 2 := fun i => if i.val ∈ [1,4,7,13,28,31] then 1 else 0
private lemma zv_kernel : xH *ᵥ zv = 0 := by decide +kernel
private lemma xv_kernel : zH *ᵥ xv = 0 := by decide +kernel
private lemma zx_dot : dotProduct zv xv = 1 := by decide +kernel
private lemma zv_weight : weight zv = 6 := by decide +kernel
private lemma xv_weight : weight xv = 6 := by decide +kernel

private lemma row_orthogonal {r c : Type} [Fintype c]
    (H : Matrix r c (ZMod 2)) (v : c → ZMod 2) (hv : H *ᵥ v = 0)
    {w : c → ZMod 2} (hw : w ∈ rowSpace H) : dotProduct w v = 0 := by
  change w ∈ Submodule.span (ZMod 2) (Set.range H) at hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨i,rfl⟩ := hw
    exact congrFun hv i
  | zero => simp
  | add w u hw hu ihw ihu => simp [add_dotProduct, ihw, ihu]
  | smul a w hw ih => simp [smul_dotProduct, ih]

private lemma weight_equiv {a b : Type} [Fintype a] [Fintype b]
    (e : a ≃ b) (v : b → ZMod 2) : weight (v ∘ e) = weight v := by
  classical
  simp only [weight, Finset.card_eq_sum_ones, Finset.sum_filter]
  exact e.sum_comp (fun j => if v j ≠ 0 then (1 : ℕ) else 0)

private lemma unindex_kernel (H : Matrix (Grp 6 6) (Qubit 6 6) (ZMod 2))
    (v : Fin 72 → ZMod 2) (hv : H.submatrix er eqb *ᵥ v = 0) :
    H *ᵥ (v ∘ eqb.symm) = 0 := by
  have h := Matrix.submatrix_mulVec_equiv H v er eqb
  rw [hv] at h
  funext i
  have hi := congrFun h (er.symm i)
  simpa using hi.symm

private lemma index_kernel (H : Matrix (Grp 6 6) (Qubit 6 6) (ZMod 2))
    (v : Qubit 6 6 → ZMod 2) (hv : H *ᵥ v = 0) :
    H.submatrix er eqb *ᵥ (v ∘ eqb) = 0 := by
  rw [Matrix.submatrix_mulVec_equiv]
  have he : (v ∘ eqb) ∘ eqb.symm = v := by funext i; simp
  rw [he,hv]
  rfl

private lemma index_ne_zero (v : Qubit 6 6 → ZMod 2) (hv : v ≠ 0) : v ∘ eqb ≠ 0 := by
  intro h
  apply hv
  funext i
  have := congrFun h (eqb.symm i)
  simpa using this

private lemma zlogical : IsZLogical polyA polyB (zv ∘ eqb.symm) := by
  constructor
  · apply unindex_kernel
    rw [xtable]
    exact zv_kernel
  · intro h
    have hx : HZ polyA polyB *ᵥ (xv ∘ eqb.symm) = 0 := by
      apply unindex_kernel
      rw [ztable]
      exact xv_kernel
    have hh := row_orthogonal (HZ polyA polyB) (xv ∘ eqb.symm) hx h
    rw [comp_equiv_dotProduct_comp_equiv, zx_dot] at hh
    exact one_ne_zero hh

private lemma xlogical : IsXLogical polyA polyB (xv ∘ eqb.symm) := by
  constructor
  · apply unindex_kernel
    rw [ztable]
    exact xv_kernel
  · intro h
    have hz : HX polyA polyB *ᵥ (zv ∘ eqb.symm) = 0 := by
      apply unindex_kernel
      rw [xtable]
      exact zv_kernel
    have hh := row_orthogonal (HX polyA polyB) (zv ∘ eqb.symm) hz h
    rw [comp_equiv_dotProduct_comp_equiv, dotProduct_comm xv zv, zx_dot] at hh
    exact one_ne_zero hh

private lemma logical_ne_zero {l m : ℕ} [NeZero l] [NeZero m]
    (A B : Poly l m) (v : Qubit l m → ZMod 2)
    (h : v ∉ rowSpace (HX A B) ∨ v ∉ rowSpace (HZ A B)) : v ≠ 0 := by
  intro he
  subst v
  simp at h

theorem solution :
    IsCode (l := 6) (m := 6) {(3, 0), (0, 1), (0, 2)} {(0, 3), (1, 0), (2, 0)} 72 12 6 := by
  change IsCode polyA polyB 72 12 6
  refine ⟨rfl, ?_, ?_, ?_⟩
  · unfold NumLogical
    have hx : (HX polyA polyB).rank = 30 := by
      rw [← Matrix.rank_submatrix _ er eqb, xtable, xrank]
    have hz : (HZ polyA polyB).rank = 30 := by
      rw [← Matrix.rank_submatrix _ er eqb, ztable, zrank]
    rw [hx,hz]
  · refine ⟨⟨xv ∘ eqb.symm, xlogical, ?_⟩, ?_⟩
    · rw [weight_equiv, xv_weight]
    · intro v hv
      rw [← weight_equiv eqb v]
      apply zlower
      · rw [← ztable]
        exact index_kernel _ v hv.1
      · exact index_ne_zero v (logical_ne_zero _ _ _ (Or.inl hv.2))
  · refine ⟨⟨zv ∘ eqb.symm, zlogical, ?_⟩, ?_⟩
    · rw [weight_equiv, zv_weight]
    · intro v hv
      rw [← weight_equiv eqb v]
      apply xlower
      · rw [← xtable]
        exact index_kernel _ v hv.1
      · exact index_ne_zero v (logical_ne_zero _ _ _ (Or.inr hv.2))
