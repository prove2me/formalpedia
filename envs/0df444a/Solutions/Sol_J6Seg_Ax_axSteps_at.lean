/-! ## Monotonicity of the contracts -/

theorem PassOK.mono {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {st : IStmt HS Pp}
    {dA : Fin HS} {desc : List ℤ} {Pre : List GI → Prop} {g : List GI → List GI} {C C' : ℝ}
    (h : PassOK Isym tbl st dA desc Pre g C) (hC : C ≤ C') : PassOK Isym tbl st dA desc Pre g C' :=
  fun s F L l h1 h2 h3 h4 => by
    obtain ⟨c, r, k⟩ := h s F L l h1 h2 h3 h4; exact ⟨c, r, k.trans hC⟩

theorem Pass2OK.mono {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {st : IStmt HS Pp}
    {dA : Fin HS} {desc : List ℤ} {Pre : List GI → List GI → Prop}
    {g : List GI → List GI → List GI × List GI} {C C' : ℝ}
    (h : Pass2OK Isym tbl st dA desc Pre g C) (hC : C ≤ C') :
    Pass2OK Isym tbl st dA desc Pre g C' :=
  fun s F A B l l₂ h1 h2 h3 h4 h5 => by
    obtain ⟨c, r, k⟩ := h s F A B l l₂ h1 h2 h3 h4 h5; exact ⟨c, r, k.trans hC⟩

theorem passC_mono_L {pre L L' m Ba cu T Bo : ℕ} (h : L ≤ L') :
    passC pre L m Ba cu T Bo ≤ passC pre L' m Ba cu T Bo := by
  unfold passC blockC; gcongr

