-- Source module: Solutions.R6BitCost
/-!
# Round six, bit side: cost of `progH` and the generalized Prop. 11

`costH C e V`: the structural cost of `progH C q e …` on an array of volume `V`, following the
program: `e < m`: `e` digit-swap passes; `e = m f + r`: `r` digit-swap passes, the row split and
merge (`2V`), `T` zero temporaries (`T V / W`), each gate one pass per touched wire (`V / W`),
each edge `4m` shift passes (`V / W` each) plus its run children, each a recursive call of width
`r' f` on a stream of volume `V / W`.

* `costH_lin`: `costH e V = V · costH e 1`.
* `cH_rec`: `c(e) = (e mod m) + K₀ + (1/W) Σ_{children} c(w ⌊e/m⌋)` (`c = costH · 1`).
* `costH_bound`: with `histMoment C.hist m τ < W`, `costH e V ≤ K V e^τ` for all `e` (via the
  monotone majorant of `c` and `R6.MomentRec.moment_recurrence_bound`).
* `prop11H`: denotation and cost together.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

lemma instrCost_lin {Wr : Type*} (child : ℕ × ℕ × ℕ → ℝ → ℝ)
    (hc : ∀ ρ v, child ρ v = v * child ρ 1) (V : ℝ) (i : Instr Wr R m) :
    instrCost child (V / W) i = V * instrCost child (1 / W) i := by
  cases i with
  | gate g S => simp only [instrCost]; ring
  | edge w e =>
    simp only [instrCost]
    rw [List.map_congr_left (fun ρ _ => hc ρ (V / W)), List.sum_map_mul_left,
      List.map_congr_left (l := e.runs) (fun ρ _ => hc ρ (1 / W)), List.sum_map_mul_left]
    ring

lemma sum_map_mul {α : Type*} (l : List α) (f : α → ℝ) (V : ℝ) :
    (l.map fun a => V * f a).sum = V * (l.map f).sum := List.sum_map_mul_left _ _ _

/-- The cost is linear in the volume. -/
theorem costH_lin (C : QHNet R W T m) : ∀ e V, costH C e V = V * costH C e 1 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro V
  rw [costH, costH]
  split_ifs with he
  · have hc : ∀ (ρ : ℕ × ℕ × ℕ) (v : ℝ),
        (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) v else 0) =
          v * (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) 1 else 0) := by
      intro ρ v
      split_ifs with h
      · exact ih _ h v
      · ring
    rw [List.map_congr_left (fun i _ => instrCost_lin _ hc V i), sum_map_mul]
    ring
  · ring

lemma prog_cost_sum (C : QHNet R W T m) (g : ℕ × ℕ × ℕ → ℝ) :
    ∀ prog : List (Instr (Fin W ⊕ Fin T) R m),
      (prog.map (instrCost (fun ρ v => v * g ρ) (1 / W))).sum =
        ((((prog.map Instr.gateWork).sum : ℕ) : ℝ) + 2 * (m + m) * ((progEdges prog).length : ℝ)) / W +
          (((progEdges prog).flatMap fun e => e.runs).map g).sum / W := by
  intro prog
  induction prog with
  | nil => simp [progEdges]
  | cons i l ih =>
    rw [List.map_cons, List.sum_cons, ih, progEdges_cons]
    cases i with
    | gate g' S =>
      simp only [instrCost, Instr.gateWork, Instr.edgeOf, Option.toList_none, List.nil_append,
        List.map_cons, List.sum_cons]
      push_cast; ring
    | edge w e =>
      simp only [instrCost, Instr.gateWork, Instr.edgeOf, Option.toList_some, List.map_cons,
        List.sum_cons, List.singleton_append, List.length_cons, List.flatMap_cons, List.map_append,
        List.sum_append]
      rw [List.sum_map_mul_left]
      push_cast; ring

lemma width_lt {m e w : ℕ} (he : m ≤ e) (hw : w < m) : w * (e / m) < e := by
  have h1 : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  have h2 : e / m * m ≤ e := Nat.div_mul_le_self e m
  nlinarith

/-- **The cost recurrence.** For `e ≥ m`, `c(e) = (e mod m) + K₀ + (1/W) Σ_w c(w ⌊e/m⌋)`, the sum
over all children (`C.widths`). -/
theorem cH_rec_sol_aux (C : QHNet R W T m) (hruns : C.RunsOK) {e : ℕ} (he : m ≤ e) :
    cH C e = ((e % m : ℕ) : ℝ) + K0 C + (C.widths.map fun w => cH C (w * (e / m))).sum / W := by
  set g : ℕ × ℕ × ℕ → ℝ := fun ρ => if ρ.2.2 * (e / m) < e then cH C (ρ.2.2 * (e / m)) else 0
  have hfun : (fun (ρ : ℕ × ℕ × ℕ) (v : ℝ) =>
      if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) v else 0) = fun ρ v => v * g ρ := by
    funext ρ v
    simp only [g]
    split_ifs
    · rw [costH_lin, cH]
    · ring
  have hg : (((progEdges C.prog).flatMap fun e => e.runs).map g).sum =
      (C.widths.map fun w => cH C (w * (e / m))).sum := by
    rw [List.map_congr_left (g := fun ρ => cH C (ρ.2.2 * (e / m))) (fun ρ hρ => by
      obtain ⟨e', he', hρ'⟩ := List.mem_flatMap.1 hρ
      simp only [g]
      rw [if_pos (width_lt he (hruns e' he' ρ hρ').2.1)])]
    simp [QHNet.widths, QHNet.edges, List.map_flatMap, Function.comp_def]
  rw [cH, costH, if_pos he, hfun, prog_cost_sum C, hg, K0, QHNet.gateWork, QHNet.numEdges,
    QHNet.edges]
  ring

end IntMul.Kappa.R6.Bit

end

