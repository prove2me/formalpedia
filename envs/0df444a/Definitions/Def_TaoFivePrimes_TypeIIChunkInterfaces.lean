-- Source module: Theorems.Thm_TaoFivePrimes_vaughan_identity_elementary
section
open scoped ArithmeticFunction.vonMangoldt ArithmeticFunction.Moebius
open ArithmeticFunction
namespace TaoFivePrimes
noncomputable def arithmeticRestrictGT (B : ℕ)
    (f : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  ⟨fun n => if B < n then f n else 0, by simp⟩
noncomputable def vaughanHalfLog : ArithmeticFunction ℝ :=
  ⟨fun n => (1 / 2 : ℝ) * Real.log n, by simp⟩
noncomputable def vaughanTruncatedHalfLog (V : ℕ) : ArithmeticFunction ℝ :=
  arithmeticRestrictGT V vaughanHalfLog
noncomputable def vaughanTypeIICoefficient (V : ℕ) : ArithmeticFunction ℝ :=
  arithmeticRestrictGT V ArithmeticFunction.vonMangoldt *
      (ArithmeticFunction.zeta : ArithmeticFunction ℝ) -
    vaughanTruncatedHalfLog V
noncomputable def eta0VaughanTest (x alpha : ℝ) (n : ℕ) : ℂ :=
  if n.Coprime 2 then
    expCircle (alpha * n) * (eta0 ((n : ℝ) / x) : ℂ)
  else 0
end TaoFivePrimes
end
-- Source module: Theorems.Thm_TaoFivePrimes_vaughan_typeII_bilinear_reindex
section
open scoped BigOperators ArithmeticFunction.Moebius
namespace TaoFivePrimes
noncomputable def eta0VaughanBilinearSum
    (x alpha U V : ℝ) : ℂ :=
  ∑ p ∈ (Finset.Ioc 0 ⌊x⌋₊).product (Finset.Ioc 0 ⌊x⌋₊) with
      p.1 * p.2 ≤ ⌊x⌋₊,
    (((arithmeticRestrictGT ⌊U⌋₊ (μ : ArithmeticFunction ℝ) p.1) *
        vaughanTypeIICoefficient ⌊V⌋₊ p.2 : ℝ) : ℂ) *
      eta0VaughanTest x alpha (p.1 * p.2)
end TaoFivePrimes
end
