      _ = _ := by simp only [hR]
  have h2 : ∑ a : Fin 4, ∑ b : Fin 4, ginv a b x * (g a b x * ricciScalar g ginv x / 2)
      = (∑ a : Fin 4, ∑ b : Fin 4, ginv a b x * g a b x) * (ricciScalar g ginv x / 2) := by
    simp only [Fin.sum_univ_four]
    ring
  rw [h2, trace_ginv_g hs hinv] at h1
