  set G2 := update G1 TT ((cs.length : ℤ) :: G1 TT) with hG2
  have g2T : G2 dTJ = (cs.length : ℤ) :: (cs ++ flatT (fs.drop (r + 1)) ++ R) := by
    simp +decide [hG2, g1T]
  have s3 := Sp.pop (s := s) (f := G2) (i := dTJ) (B := Bx) (by decide) g2T hzcx
  set G3 := update G2 dTJ (cs ++ flatT (fs.drop (r + 1)) ++ R) with hG3
  have s4 := Sp.push (s := s) (f := G3) (i := SUM) (e := .lit 0) (B := Bx) (by decide)
