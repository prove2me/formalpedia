theorem isUnit_iff (O : Subring K) (f : K) (hf : f ∈ O) :
    IsUnit (⟨f, hf⟩ : ↥O) ↔ ∃ v ∈ O, f * v = 1 := by
  constructor
  · rintro ⟨u, hu⟩
    refine ⟨((u.inv : ↥O) : K), (u.inv : ↥O).2, ?_⟩
    have h1 : ((u.val * u.inv : ↥O) : K) = ((1 : ↥O) : K) := congrArg (fun x : ↥O => (x : K)) u.val_inv
    rw [Subring.coe_mul, Subring.coe_one, hu] at h1
    exact h1
  · rintro ⟨v, hv, hfv⟩
    have h1 : (⟨f, hf⟩ : ↥O) * ⟨v, hv⟩ = 1 := Subtype.ext (by simpa using hfv)
    exact ⟨⟨⟨f, hf⟩, ⟨v, hv⟩, h1, by rw [mul_comm]; exact h1⟩, rfl⟩

theorem end_facts (O : Subring K) (S : Subalgebra A K) (P : Ideal ↥S) (hP : P.IsMaximal)
    (hO : ∀ f : K, f ∈ O ↔ ∃ g h : ↥S, h ∉ P ∧ f * (h : K) = (g : K)) :
    (∀ g : ↥S, (g : K) ∈ O) ∧
    (∀ h : ↥S, h ∉ P → ((h : K))⁻¹ ∈ O) ∧
    (∀ (f : K) (hf : f ∈ O), ¬ IsUnit (⟨f, hf⟩ : ↥O) →
      ∃ g h : ↥S, g ∈ P ∧ h ∉ P ∧ (h : K) ≠ 0 ∧ f * (h : K) = (g : K)) ∧
    (∀ (f : K) (hf : f ∈ O), (∃ g h : ↥S, g ∈ P ∧ h ∉ P ∧ f * (h : K) = (g : K)) →
      ¬ IsUnit (⟨f, hf⟩ : ↥O)) := by
  classical
  have h1P : (1 : ↥S) ∉ P := (Ideal.ne_top_iff_one P).mp hP.ne_top
  have hne0 : ∀ h : ↥S, h ∉ P → (h : K) ≠ 0 := by
    intro h hh h0
    apply hh
    have : h = 0 := by
      ext
      simpa using h0
    rw [this]
    exact P.zero_mem
  have hS : ∀ g : ↥S, (g : K) ∈ O := fun g => (hO _).mpr ⟨g, 1, h1P, by simp⟩
  have hinv : ∀ h : ↥S, h ∉ P → ((h : K))⁻¹ ∈ O := fun h hh =>
    (hO _).mpr ⟨1, h, hh, by rw [inv_mul_cancel₀ (hne0 h hh)]; simp⟩
  refine ⟨hS, hinv, ?_, ?_⟩
  · intro f hf hnu
    obtain ⟨g, h, hh, hfh⟩ := (hO f).mp hf
    refine ⟨g, h, ?_, hh, hne0 h hh, hfh⟩
    by_contra hg
    apply hnu
    rw [isUnit_iff]
    refine ⟨(h : K) * ((g : K))⁻¹, (hO _).mpr ⟨h, g, hg, ?_⟩, ?_⟩
    · rw [mul_assoc, inv_mul_cancel₀ (hne0 g hg), mul_one]
    · calc f * ((h : K) * ((g : K))⁻¹) = (f * (h : K)) * ((g : K))⁻¹ := by ring
        _ = 1 := by rw [hfh, mul_inv_cancel₀ (hne0 g hg)]
  · rintro f hf ⟨g, h, hg, hh, hfh⟩ hu
    obtain ⟨v, hv, hfv⟩ := (isUnit_iff O f hf).mp hu
    obtain ⟨g₂, h₂, hh₂, hvh⟩ := (hO v).mp hv

    have hK : ((h * h₂ : ↥S) : K) = ((g * g₂ : ↥S) : K) := by
      push_cast
      calc (h : K) * (h₂ : K) = (f * v) * ((h : K) * (h₂ : K)) := by rw [hfv, one_mul]
        _ = (f * (h : K)) * (v * (h₂ : K)) := by ring
        _ = (g : K) * (g₂ : K) := by rw [hfh, hvh]
    have hSeq : h * h₂ = g * g₂ := Subtype.ext hK
    have hmem : h * h₂ ∈ P := by rw [hSeq]; exact P.mul_mem_right _ hg
    rcases hP.isPrime.mem_or_mem hmem with h1 | h2
    · exact hh h1
    · exact hh₂ h2

theorem exists_sep
