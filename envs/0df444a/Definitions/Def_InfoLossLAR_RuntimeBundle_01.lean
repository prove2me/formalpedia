    (hr : _root_.Integration9_9.TM2Simulation.ConfigRel i e v label finish anchor a b) :
    ∃ b', Nonempty (EvalsToInTime (TM2.step N) b (some b') m) ∧
      _root_.Integration9_9.TM2Simulation.ConfigRel i e v label finish anchor a' b' :=
  _root_.Integration9_9.TM2Simulation.evalsToInTime_simulation (TM2.step M) (TM2.step N)
    (_root_.Integration9_9.TM2Simulation.ConfigRel i e v label finish anchor)
    (_root_.Integration9_9.TM2Simulation.configuration_step i hi e v label finish M N hN anchor) a a' b m h hr

