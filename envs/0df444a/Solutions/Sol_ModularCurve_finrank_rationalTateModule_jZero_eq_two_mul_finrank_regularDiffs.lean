theorem solution (N : ℕ) [NeZero N] (p : ℕ) [Fact p.Prime] :
    Module.finrank ℚ_[p] (ModularCurve.RationalTateModule p (ModularCurve.JZero N))
      = 2 * Module.finrank (AlgebraicClosure ℚ)
          ↥(AlgebraicCurve.regularDiffs (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N)) := by
  haveI hcurve : AlgebraicCurve.IsCurveOver (AlgebraicClosure ℚ) (ModularCurve.modularFunctionFieldBar N) :=
    ModularCurve.isCurveOver_modularFunctionFieldBar N
  haveI heft : Algebra.EssFiniteType (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N) :=
    ModularCurve.essFiniteType_modularFunctionFieldBar N
  haveI hcan : AlgebraicCurve.HasCanonicalDivisor (K := AlgebraicClosure ℚ) (F := ↥(ModularCurve.modularFunctionFieldBar N)) :=
    AlgebraicCurve.hasCanonicalDivisor_of_isCurveOver
  have hfg := ModularCurve.exists_transcendental_finiteDimensional_modularFunctionFieldBar N
  have hAJ : AlgebraicCurve.AbelJacobiCard (AlgebraicClosure ℚ) (ModularCurve.modularFunctionFieldBar N) p
      (AlgebraicCurve.genus (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N)) :=
    AlgebraicCurve.Pic0.abelJacobiCard_genus (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N) hfg p
  obtain ⟨bas⟩ := ModularCurve.JZero.nonempty_tateModule_basis_of_abelJacobiCard N p
    (AlgebraicCurve.genus (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N)) (Fact.out) hAJ
  have hL : Module.finrank ℚ_[p] (ModularCurve.RationalTateModule p (ModularCurve.JZero N))
      = 2 * AlgebraicCurve.genus (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N) := by
    exact (Module.finrank_eq_card_basis (bas.baseChange ℚ_[p])).trans (Fintype.card_fin _)
  have hR : Module.finrank (AlgebraicClosure ℚ)
      ↥(AlgebraicCurve.regularDiffs (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N))
      = AlgebraicCurve.genus (AlgebraicClosure ℚ) ↥(ModularCurve.modularFunctionFieldBar N) := by
    rw [AlgebraicCurve.regularDiffs_eq_regularDifferentials]
    exact (AlgebraicCurve.finite_and_finrank_regularDifferentials_eq_genus
      (K := AlgebraicClosure ℚ) (F := ↥(ModularCurve.modularFunctionFieldBar N))).2
  rw [hL, hR]

