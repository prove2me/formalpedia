/-! ## Aux edges -/

section Aux

variable {h : ℕ}

/-- Common part: an idempotent `qM M` of rank `m - n` whose `n × n` corner is lower triangular with
nonzero diagonal has the aux runs. -/
theorem aux_edge_of_sol_aux (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ) (hM : M * M = M)
    (htr : M.trace = ((h + 4) * (h + 3) : ℕ))
    (hlow : ∀ β γ : ℕ, β < γ → γ < h + 4 → cor M β (h + 3 + γ) = 0)
    (hdiag : ∀ β : ℕ, β < h + 4 → cor M β (h + 3 + β) ≠ 0) :
    ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e (qM M) ∧
      e.runs = [(0, (h + 4) * (h + 4) - (h + 4), h + 4),
        (h + 4, h + 4, (h + 4) * (h + 4) - 2 * (h + 4))] := by
  have hk := two_k_le (h := h)
  have hmm : (h + 4) * (h + 4) = (h + 4) * (h + 3) + (h + 4) := by ring
  have hq := qM_idem hM
  have hrank : (qM M).rank = (h + 4) * (h + 4) - (h + 4) := by
    have h1 := rank_eq_trace (qM M) hq
    rw [qM_trace, htr] at h1
    have := Nat.cast_injective h1
    omega
  -- the corner
  set Cp : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ := (qM M).submatrix
    (fun l : Fin (h + 4) => (⟨l.val, by omega⟩ : Fin ((h + 4) * (h + 4))))
    (fun r : Fin (h + 4) => (⟨(h + 4) * (h + 4) - (h + 4) + r.val, by omega⟩ :
      Fin ((h + 4) * (h + 4)))) with hCp
  have hCe : ∀ β γ : Fin (h + 4), Cp β γ = cor M β.val (h + 3 + γ.val) := by
    intro β γ
    have e : (⟨(h + 4) * (h + 4) - (h + 4) + γ.val, by omega⟩ : Fin ((h + 4) * (h + 4))) =
        ⟨(h + 4) * (h + 4) - (2 * h + 7) + (h + 3 + γ.val), by omega⟩ :=
      Fin.ext (by simp only; omega)
    rw [hCp, submatrix_apply, e, ← qM_corner M β.val (h + 3 + γ.val) (by omega) (by omega)]
  have hCl : ∀ β γ : Fin (h + 4), β < γ → Cp β γ = 0 := fun β γ hβγ => by
    rw [hCe]; exact hlow _ _ hβγ γ.isLt
  have hCd : ∀ β : Fin (h + 4), Cp β β ≠ 0 := fun β => by rw [hCe]; exact hdiag _ β.isLt
  have hdet : Cp.det ≠ 0 := by
    rw [det_of_isLowerTriangular Cp (fun a b hab => hCl a b hab)]
    exact Finset.prod_ne_zero_iff.2 fun a _ => hCd a
  have hmid := fun i (h1 : h + 4 ≤ i) (h2 : i < (h + 4) * (h + 4) - (h + 4)) =>
    isPiv_mid (k := h + 4) (by omega) (qM M) hq hrank hdet h1 h2
  have hcorner : ∀ l : Fin (h + 4), IsPiv (qM M) l.val ((h + 4) * (h + 4) - (h + 4) + l.val) :=
    fun l => isPiv_block (qM M) Cp (by omega) (by omega) (fun i j => rfl)
      (isPiv_diag_of_lower Cp hCl hCd l)
  refine edge_exact (by omega) (qM M) hq _ ?_ ?_ ?_ ?_
  · intro ρ hρ
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hρ
    rcases hρ with rfl | rfl <;> refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only <;> omega
  · rw [runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil, List.nodup_append]
    refine ⟨nodup_run _ _ _, nodup_run _ _ _, ?_⟩
    intro a ha b hb hab
    rw [mem_run] at ha hb
    obtain ⟨k, hk1, rfl⟩ := ha
    obtain ⟨k', hk2, rfl⟩ := hb
    simp only [Prod.mk.injEq] at hab
    omega
  · intro p hp
    rw [runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil, List.mem_append, mem_run,
      mem_run] at hp
    rcases hp with ⟨k, hk1, rfl⟩ | ⟨k, hk1, rfl⟩
    · simpa using hcorner ⟨k, hk1⟩
    · exact hmid _ (by simp only; omega) (by simp only; omega)
  · rw [hrank, runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil, List.length_append,
      length_run, length_run]
    omega

end Aux

