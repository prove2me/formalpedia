theorem J6Seg.PJ.Rn.jHead {kA kC wA wC k pre post s t p α d W N : ℕ} {Z : Fin HS}
    (hZ : Z ∉ rg) (hZ5 : Z.val < 56) (hZT : Z ≠ sTmp) (hZC : Z ≠ cRdC)
    {c : Cs} (hcZ : c Z = dsc k pre post s t p α d) (hZv : Z.val = 49 ∨ Z.val = 55)
    (hc : ∀ j, j ≠ Z → c j = [])
    (hW : parBig kA kC wA wC k pre post s t p α d < 2 ^ W)
    (hNW : N < 2 ^ W) (hW2 : 2 ≤ W) (hN1 : 1 ≤ N)
    (hs : 0 < s) (hws : wF d ≤ s) (hQW : segPF p d s ≤ W)
    (hsN : s ≤ N) (hlN : lamP d ≤ N) (hNMN : lamP d * (2 * wF d + 1) ≤ N)
    (hmm : (Jlist (mkBlocks s t (lamP d) (wF d))).length *
      (Jlist (mkBlocks s t (lamP d) (wF d))).length ≤ N)
    (hmc : (Jlist (mkBlocks s t (lamP d) (wF d))).length * (2 * wF d + 2) ≤ N)
    (bss : s * s ≤ 2 ^ W)
    (hJB : JB (segPF p d s) (p / 7) W s t α (lamP d) (wF d)) :
    Rn (J6Seg.PJ.jHead kA kC wA wC Z) (fun _ => 0) c
      (fun v => BV W v ∧ v 9 = ((2 ^ segPF p d s : ℕ) : ℤ) ∧
        v 10 = ((2 ^ (segPF p d s + 1) : ℕ) : ℤ) ∧ v 22 = s ∧ v 24 = lamP d ∧ v 26 = wF d ∧
        v 28 = (Jlist (mkBlocks s t (lamP d) (wF d))).length)
