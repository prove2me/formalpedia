    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem]; rfl
  rw [e1, e2]
  unfold rixT
  rw [getD_rix _ _ _ (by rw [Geo.V_rec]; exact h1)]
  conv_lhs => rw [hj, phi_mul hg hF hb]
  conv_rhs => rw [hj]
  rw [getD_flR h (phi_lt hg.recG (g := g.recG) hF hm) hb, getD_flR hl' hm hb]

