    Set.range (ordinaryToFiniteAffineScheme R) ∪
      Set.range (reciprocalToFiniteAffineScheme R h104) = Set.univ := by
  rw [ordinaryToFiniteAffineScheme_range R (two_isUnit_of_104 R h104),
    reciprocalToFiniteAffineScheme_range]
  change ((PrimeSpectrum.basicOpen (parameterElement R) : Set (PrimeSpectrum (candidateAlgebra R))) ∪
    (PrimeSpectrum.basicOpen (inversionElement R) : Set (PrimeSpectrum (candidateAlgebra R)))) ∪
      (PrimeSpectrum.basicOpen (infinityPatchElement R) : Set (PrimeSpectrum (candidateAlgebra R))) = Set.univ
  have he := congrArg (fun U : TopologicalSpace.Opens (PrimeSpectrum (candidateAlgebra R)) =>
    (U : Set (PrimeSpectrum (candidateAlgebra R))))
      (candidate_three_principal_open_cover R (two_isUnit_of_104 R h104))
  simpa only [inversionElement,TopologicalSpace.Opens.coe_sup,TopologicalSpace.Opens.coe_top,Set.union_assoc] using he

def finiteSchemeChart (b : Bool) : Scheme.{u} :=
  if b then MazurTorsion.XOneThirteenAffineCurve.scheme R
  else Spec (.of (Order13SingleSectionReciprocalPatch.PatchRing R))

def finiteSchemeChartMap (h104 : IsUnit (104 : R)) :
    (b : Bool) → finiteSchemeChart R b ⟶ finiteAffineScheme R
  | true => ordinaryToFiniteAffineScheme R
  | false => reciprocalToFiniteAffineScheme R h104

theorem finiteSchemeChartMap_isOpenImmersion (h104 : IsUnit (104 : R)) (b : Bool) :
    IsOpenImmersion (finiteSchemeChartMap R h104 b) := by
  cases b with
  | false => exact reciprocalToFiniteAffineScheme_isOpenImmersion R h104
  | true => exact ordinaryToFiniteAffineScheme_isOpenImmersion R (two_isUnit_of_104 R h104)

def finiteSchemeOpenCover (h104 : IsUnit (104 : R)) : (finiteAffineScheme R).OpenCover where
  I₀ := Bool
  X := finiteSchemeChart R
  f := finiteSchemeChartMap R h104
  mem₀ := by
    rw [Scheme.presieve₀_mem_precoverage_iff]
    constructor
    · intro a
      have ha : a ∈ Set.range (ordinaryToFiniteAffineScheme R) ∪
          Set.range (reciprocalToFiniteAffineScheme R h104) := by
        rw [finiteScheme_two_chart_range_cover]
        trivial
      rcases ha with ha | ha
      · exact ⟨true,ha⟩
      · exact ⟨false,ha⟩
    · exact finiteSchemeChartMap_isOpenImmersion R h104

end MazurTransfer.Order13SingleSectionFiniteAlgebra
