      Z^(v*(67/100+12*e+eps*(N+8))+loss-(3/20)*TunedCandidate.ell+mesh*TunedCandidate.ell)=
      Z^(profileExponent (51/100) e+v*(67/100+12*e+eps*(N+8))+loss-(3/20)*TunedCandidate.ell+mesh*TunedCandidate.ell) := by
    rw [←Real.rpow_add hZp]
    congr 1
    ring
