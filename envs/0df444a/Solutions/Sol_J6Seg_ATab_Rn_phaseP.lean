theorem Rn.phaseP_sol_aux {W p s t α pkA pkC bA bC : ℕ} {v1 : Vr} {c1 : Cs}
    (hv : V1 p s t α pkA pkC bA bC v1) (hBv : BV W v1) (hB : PBnd W p t α pkA pkC bA bC)
    (hc : c1 cLC = []) :
    Rn phaseP v1 c1 (fun v' => V2 p s t α (pkA * p + pkC) (bA * p + bC) v' ∧ BV W v') c1
      (cPhaseP W p (pkA * p + pkC) (bA * p + bC)) := by
  have hW32 := hB.w32
  have hW2 : 2 ≤ 2 ^ W := by omega
  have hWp : W < 2 ^ W := Nat.lt_two_pow_self
  have hp := hB.hp; have hQ := hB.hQ; have hpk := hB.hpk; have hb := hB.hb
  -- `5 := 2^(2p)`
  have s3 := pwL (c := c1) (x := 5) (rc := 1) (by decide) (by decide) (by decide) hBv hv.a5 hv.a1
    (Nat.pow_le_pow_right (by norm_num) hp) (by omega) hW2 hc
  refine Rn.seq s3 (fun v2 ⟨e2, hB2⟩ => ?_)
  subst e2
  -- `6 := β`
  have hβ : eBeta.den (update v1 5 ((2 ^ (2 * p) : ℕ) : ℤ)) = betaT (2 * p) α := by
    simp only [eBeta, E.den, update_self, update_of_ne (show (6 : Fin HS) ≠ 5 by decide), hv.a6,
      betaT]
    push_cast; rfl
  have s4 := Rn.asgs (W := W) (c := c1) [(6, eBeta)] (by decide)
    (by simp only [lbA, eBeta, E.lb, nA2, max_le_iff]; omega) hB2
    ⟨by
      rw [hβ]; unfold betaT
      exact nat_le_W' (le_trans (Nat.div_le_self _ _)
        (Nat.pow_le_pow_right (by norm_num) hp)), trivial⟩
  refine Rn.seq s4 (fun v3 ⟨e3, hB3⟩ => ?_)
  subst e3
  simp only [runA, hβ] at hB3 ⊢
  -- `12 := 2^Q`
  have s5 := pwL (c := c1) (x := 12) (rc := 23) (by decide) (by decide) (by decide) hB3
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact hv.a12)
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact hv.a23)
    (Nat.pow_le_pow_right (by norm_num) hQ) (by omega) hW2 hc
  refine Rn.seq s5 (fun v4 ⟨e4, hB4⟩ => ?_)
  subst e4
  -- `20 := 2^pk`
  have s6 := pwL (c := c1) (x := 20) (rc := 21) (by decide) (by decide) (by decide) hB4
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact hv.a20)
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact hv.a21)
    (Nat.pow_le_pow_right (by norm_num) hpk) (by omega) hW2 hc
  refine Rn.seq s6 (fun v5 ⟨e5, hB5⟩ => ?_)
  subst e5
  -- `21 := 1; 21 := 2^b`
  have s7 := Rn.asgs (W := W) (c := c1) [(21, .k 1)] (by decide)
    (by simp only [lbA, E.lb, nA1, max_le_iff]; omega) hB5 ⟨one_le_W hW32, trivial⟩
  refine Rn.seq s7 (fun v6 ⟨e6, hB6⟩ => ?_)
  subst e6
  simp only [runA, E.den] at hB6 ⊢
  have s8 := pwL (c := c1) (x := 21) (rc := 22) (by decide) (by decide) (by decide) hB6
    (by simp only [update_self])
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact hv.a22)
    (Nat.pow_le_pow_right (by norm_num) hb) (by omega) hW2 hc
  refine s8.mono (fun v7 ⟨e7, hB7⟩ => ⟨?_, hB7⟩) le_rfl
  subst e7
  constructor <;> simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false, if_true,
    ↓reduceIte, Nat.cast_pow, Nat.cast_ofNat]
  all_goals first
    | rfl
    | exact hv.a1 | exact hv.a2 | exact hv.a3 | exact hv.a4 | exact hv.a7 | exact hv.a8
    | exact hv.a9 | exact hv.a10 | exact hv.a11 | exact hv.a22 | exact hv.a24 | exact hv.a25

