-- title:
--   Lemma C.9: Characterization of collecting subspaces
-- statement:
--   For a general CP-generator representation $(K,V_k)$ on $\mathbb C^n$, $n\ge2$, let $S\ne0$ and let $P$ be its orthogonal projection. The following are equivalent:
--
--   $$P e^{tG}(P\rho P)P=e^{tG}(P\rho P)\quad(t\ge0,\ \rho\text{ a density}),$$
--
--   $PG(P\rho P)P=G(P\rho P)$ for every density $\rho$; and invariance of $S$ under the extended relaxation algebra generated by $I,K,V_k$. These characterize collecting subspaces. The equalities express support preservation, with no normalization claim for the compressed or evolved operator.
-- source:
--   Reachability, Coolability, and Stabilizability of Open Markovian Quantum Systems with Fast Unitary Control, arXiv:2308.00561v1, PDF p. 32, Lemma C.9: Characterization of collecting subspaces

import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P16

noncomputable section

open scoped BigOperators Matrix ComplexConjugate ENNReal NNReal Matrix.Norms.L2Operator

open MeasureTheory Filter

attribute [local instance] Classical.propDecidable Classical.decEq

attribute [local instance 100] LieRing.ofAssociativeRing

namespace QAlgorithms.Papers.Independent.Dependency50.P16

local notation "Mat" => fun n : ℕ => Matrix (Fin n) (Fin n) ℂ

local notation "Vec" => fun n : ℕ => Fin n → ℝ

local notation "Hilbert" => fun n : ℕ => EuclideanSpace ℂ (Fin n)

local notation "Operator" => fun n : ℕ => Module.End ℂ (Mat n)

/-- arXiv:2308.00561v1, PDF p.32, Lemma C.9: Characterization of collecting subspaces. No trace-preservation hypothesis is added. Clause (ii) quantifies all normalized rho, as in clause (i), rather than leaving rho unbound. -/
theorem collectingSubspace_characterization {n r : ℕ} (hn : 2 ≤ n) (K : Mat n) (V : Fin r → Mat n)
    (S : Submodule ℂ (Hilbert n)) (hS : S ≠ ⊥) :
    List.TFAE [
      (∀ t ≥ 0, ∀ rho : Mat n, QAlgorithms.IsDensityMatrix rho →
        orthogonalProjector S * semigroupEvolution (cpGenerator K V) t (orthogonalProjector S * rho * orthogonalProjector S) * orthogonalProjector S =
          semigroupEvolution (cpGenerator K V) t (orthogonalProjector S * rho * orthogonalProjector S)),
      (∀ rho : Mat n, QAlgorithms.IsDensityMatrix rho →
        orthogonalProjector S * cpGenerator K V (orthogonalProjector S * rho * orthogonalProjector S) * orthogonalProjector S =
          cpGenerator K V (orthogonalProjector S * rho * orthogonalProjector S)),
      invariant (extendedAlgebra K V : Set (Mat n)) S] := by sorry

end QAlgorithms.Papers.Independent.Dependency50.P16

end
