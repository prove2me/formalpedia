  obtain ⟨LC, hLC⟩ := hR1.hT2
  have r2 := mv2_runs (I := Isym) (iprog := IL.kTableP tab extM) (Cn := KFM.rT2) (X := 0) (Y := pO)
    (Z := pW) ⟨by decide, by decide, by decide, by decide⟩ ⟨by decide, by decide, by decide, by decide⟩
    (by decide) (gflat zsY) (wU6 Q D) (KFL.zsz_gflat gY) t1 [] LC (by simp +decide [t1])
    (by rw [hLC, hlY])
  set t2 := ((t.upd ARGM [.int (x : ℤ)]).upd 0 []).upd pW (ints (gflat zsY)) with ht2
  have e2 : (t1.upd 0 []).upd pW (ints (gflat zsY) ++ t1.G pW) = t2 := by
    rw [ht1, ht2, IState.upd_upd_same]
    congr 1
    simp +decide [IState.upd_G, hW]
  rw [e2] at r2
  have hR2 : Q.Base t2 :=
    BaseOK6.upd (BaseOK6.upd (BaseOK6.upd hR ARGM (by decide) _) 0 (by decide) _) pW (by decide) _
  -- input `x`
  obtain ⟨zsX, Ux, c3, r3, hX, gX, eX, k3⟩ := inP_phase6 C t2 hR2 x hx []
    (by simp +decide [t2, IState.upd_G])
  have h20 : t2.G 0 = [] := by simp +decide [t2, IState.upd_G]
  rw [h20, List.append_nil] at r3
  set t3 := (t2.upd ARGM []).upd 0 (ints (gflat zsX)) with ht3
  have hR3 : Q.Base t3 := BaseOK6.upd (BaseOK6.upd hR2 ARGM (by decide) _) 0 (by decide) _
  -- the product
  have hlX : zsX.length = 2 ^ Q.L := len_T6 hQ hD hX.1
  have hlY' : zsY.length = 2 ^ Q.L := len_T6 hQ hD hY.1
  have hT3 : KFM.Hold t3 KFM.rT (zsX.length : ℤ) := by rw [hlX]; push_cast; exact hR3.hT
  have hT23 : KFM.Hold t3 KFM.rT2 ((2 * zsX.length : ℕ) : ℤ) := by
    have := hR3.hT2; rw [hlX]; convert this using 2; push_cast; ring
  have r4 := gmulW_runs6 (I := Isym) tab extM (wU6 Q D) Q.p t3 zsX zsY [] [] (by rw [hlX, hlY'])
    (by simp +decide [t3]) (by simp +decide [t3, t2, IState.upd_G]) gX gY hT3 hT23 hR3.hP2
  set zM := List.zipWith (gmulT Q.p) zsX zsY with hzM
  have hM : RepPad Q.p (Q.sB D) (Q.tB D) zM (QA Q.p (Ux * Uy)) :=
    RepPad.gmul C.hst hX hY
  obtain ⟨-, nQ⟩ := QA_small Q.p (linC_RF (Q.sB D) (Q.tB D)) Q.Es hQ.hEs
    (norm_dgt_le Q.b Q.M x _) (norm_dgt_le Q.b Q.M y _) eX eY
  have gM : GB (Q.p + 1) zM := gb_of_rep hM (by linarith)
  rw [List.append_nil] at r4
  set t4 := (t3.upd 0 (ints (gflat zM))).upd pW [] with ht4
  have hR4 : Q.Base t4 := BaseOK6.upd (BaseOK6.upd hR3 0 (by decide) _) pW (by decide) _
  -- conjugate
  have hlM : zM.length = 2 ^ Q.L := len_T6 hQ hD hM.1
  have hT4 : KFM.Hold t4 KFM.rT (zM.length : ℤ) := by rw [hlM]; push_cast; exact hR4.hT
  have hT24 : KFM.Hold t4 KFM.rT2 ((2 * zM.length : ℕ) : ℤ) := by
    have := hR4.hT2; rw [hlM]; convert this using 2; push_cast; ring
  have r5 := conjW_runs (I := Isym) (iprog := IL.kTableP tab extM) (Q.p + 1) t4 zM []
    (by simp +decide [t4]) gM hT4 hT24
  rw [List.append_nil] at r5
  have hCj : RepPad Q.p (Q.sB D) (Q.tB D) (zM.map KFM.gconj) (cnj (QA Q.p (Ux * Uy))) :=
    RepPad.conj C.hst hM
  set t5 := t4.upd 0 (ints (gflat (zM.map KFM.gconj))) with ht5
  have hR5 : Q.Base t5 := BaseOK6.upd hR4 0 (by decide) _
  -- the third transform
  obtain ⟨zsZ, Z, c6, r6, hZ, gZ, eZ, k6⟩ := ftil_phase6 C.hp₃ C.hp₄ hQ hD C.M
    C.hdL C.hL C.hdC C.hζ C.hθ C.hθi C.ha C.hb' C.hbg C.hC C.BL C.BC C.hBL C.hBC t5 hR5
    (zM.map KFM.gconj) (cnj (QA Q.p (Ux * Uy))) [] (by simp +decide [t5]) hCj
    (by rw [norm_cnj]; exact nQ)
  rw [ht5, IState.upd_upd_same, List.append_nil] at r6
  have eF : t4.upd 0 (ints (gflat zsZ)) = ((t.upd ARGM []).upd pW []).upd 0 (ints (gflat zsZ)) := by
    rw [ht4, ht3, ht2]; exact st_mul _ _ _ _ _ _ _ _ _
  rw [eF] at r6
  refine ⟨zsZ, Z, Ux, Uy, _, r1.seq (r2.seq (r3.seq (r4.seq (r5.seq r6)))), hZ, gZ, eZ, eX, eY, ?_⟩
  -- cost
  have hlY2 : (gflat zsY).length = 2 ^ (Q.L + 1) := by exact_mod_cast hlY
  have e2' : 2 * cMvN (gflat zsY).length (wU6 Q D) = 2 * cMvN (2 ^ (Q.L + 1)) (wU6 Q D) := by
    rw [hlY2]
  have e4 : zsX.length * (4 * KFM.fmB (2 * wU6 Q D)) + 10 ^ 6 * (zsX.length + 1) * (wU6 Q D + Q.p + 1) +
      2 * cCnt (2 * zsX.length) + cW (2 ^ Q.p) + cW ((2 * zsX.length : ℕ) : ℤ) +
      cW (zsX.length : ℤ) = kGm6 Q D := by
    unfold kGm6; rw [hlX]
  have e5 : cConj zM.length (Q.p + 1) + cW ((2 * zM.length : ℕ) : ℤ) + cW (zM.length : ℤ) =
      kCj6 Q (Q.p + 1) := by
    unfold kCj6; rw [hlM]
  rw [e2', e4, e5]
  unfold kMul6 kFt6
  push_cast
  linarith

