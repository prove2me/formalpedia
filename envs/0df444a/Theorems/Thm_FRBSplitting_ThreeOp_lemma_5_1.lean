-- title:
--   Lemma 5.1, p. 15 — energy inequality for the three-operator scheme (47)
-- statement:
--   Let $H$ be a real inner product space, $A:H\rightrightarrows H$ monotone with resolvents $J_{\gamma A}$, $B:H\to H$ monotone and $L_1$-Lipschitz ($L_1\ge0$), and $C:H\to H$ $\tfrac1{L_2}$-cocoercive ($L_2>0$), i.e. $\tfrac1{L_2}\|C(u)-C(v)\|^2\le\langle C(u)-C(v),u-v\rangle$ for all $u,v$. Let
--
--   $$0<\lambda<\frac{2}{4L_1+L_2},$$
--
--   let $(x_k)_{k\ge-1}$ be generated by (47), $x_{k+1}=J_{\lambda A}(x_k-2\lambda B(x_k)+\lambda B(x_{k-1})-\lambda C(x_k))$, and let $x\in(A+B+C)^{-1}(0)$. Then there exists $\varepsilon>0$ such that for all $k\in\mathbb N$
--
--   $$\begin{aligned}&\|x_{k+1}-x\|^2+2\lambda\langle B(x_{k+1})-B(x_k),\,x-x_{k+1}\rangle+(\lambda L_1+\varepsilon)\|x_{k+1}-x_k\|^2\\&\quad\le\|x_k-x\|^2+2\lambda\langle B(x_k)-B(x_{k-1}),\,x-x_k\rangle+\lambda L_1\|x_k-x_{k-1}\|^2.\end{aligned}$$
--
--   This is the three-operator analogue of the energy inequality behind the forward-reflected-backward method: the quantity on the left is the same expression as on the right, one step later, plus a strictly positive multiple of $\|x_{k+1}-x_k\|^2$. It is the descent property that drives the convergence result, Theorem 5.2.
--
--   **Formalization Note.** The resolvent is a hypothesis (`IsResolventFamily A J`), and "$\tfrac1{L_2}$-cocoercive" is `IsCocoercive L₂⁻¹ C` with $L_2>0$. Indices are shifted by one (Lean's `x j` is $x_{j-1}$). The statement assumes $A$ only monotone (the paper's $A$ is maximally monotone; the lemma uses only monotonicity) and needs neither completeness of $H$ nor a nonempty zero set beyond the given point $x$. The sign $L_1\ge0$ of the Lipschitz constant is carried explicitly; $L_1=0$ is allowed.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 15, Lemma 5.1

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_ThreeOp_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.ThreeOp

theorem lemma_5_1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B C : H → H) (J : ℝ → H → H) (L₁ L₂ lam : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B)
    (hL₁ : 0 ≤ L₁) (hBL : IsLipschitzOp L₁ B)
    (hL₂ : 0 < L₂) (hC : IsCocoercive L₂⁻¹ C)
    (hlam0 : 0 < lam) (hlam1 : lam < 2 / (4 * L₁ + L₂))
    (x : ℕ → H) (hrun : IsThreeOpRun J B C lam x)
    (xs : H) (hxs : xs ∈ FRBSplitting.Weak.zeroSet A (fun y => B y + C y)) :
    ∃ ε > 0, ∀ k : ℕ,
      ‖x (k + 2) - xs‖ ^ 2 + 2 * lam * ⟪B (x (k + 2)) - B (x (k + 1)), xs - x (k + 2)⟫_ℝ
          + (lam * L₁ + ε) * ‖x (k + 2) - x (k + 1)‖ ^ 2
        ≤ ‖x (k + 1) - xs‖ ^ 2 + 2 * lam * ⟪B (x (k + 1)) - B (x k), xs - x (k + 1)⟫_ℝ
          + lam * L₁ * ‖x (k + 1) - x k‖ ^ 2 := by sorry

end FRBSplitting.ThreeOp
