theorem zsz_ediv_le (a d : ℤ) (hd : 1 ≤ d) : zsz (a / d) ≤ zsz a := by
  apply zsz_mono
  have h := abs_ediv_le a d hd
  rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at h
  exact_mod_cast h

theorem expNegFix_zsz (n M : ℕ) (X : ℤ) :
    zsz (expNegFix n M X) ≤ expNegB n M (zsz X) (-X / log2Bits M).toNat + 1 := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, f15⟩ := expNegFix_bnds n M X
  have e : ((((M : ℤ) + -((n : ℤ) + 1)).toNat : ℤ) + ((-X / log2Bits M).toNat : ℤ)).toNat =
      M - n - 1 + (-X / log2Bits M).toNat := by omega
  rw [e] at f15
  simp only [expNegFix]
  exact le_trans (zsz_ediv_le _ _ (one_le_pow₀ (by norm_num))) f15

theorem zsz_ediv_le' (a d : ℤ) (hd : 0 ≤ d) : zsz (a / d) ≤ zsz a := by
  rcases eq_or_lt_of_le hd with h | h
  · rw [← h, Int.ediv_zero, zsz_zero]; exact Nat.zero_le _
  · exact zsz_ediv_le a d (by omega)

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
set_option maxHeartbeats 4000000
theorem solution (n k j : ℕ) (s : NLogN.IState NLogN.HS) (L16 L17 L18 : List NLogN.Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) :
    NLogN.expNegBody.cost s ≤ NLogN.piCost 5 239 (2 * n + 10) +
      NLogN.expNegFixCost n (2 * n + 10) (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
        ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat +
      10 ^ 10 * (NLogN.expNegBB n (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
        ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat
        (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 4) ^ 2 := by
  have e10 : ((n : ℤ) + n + 10).toNat = 2 * n + 10 := by omega
  simp (config := {decide := true}) only [NLogN.expNegBody, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.RS.cost]
  rw [NLogN.piP_run' ((NLogN.RS.push 3 NLogN.m10E).run s)
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h16])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, NLogN.m10E, h16]; positivity)]
  rw [NLogN.expNegFixP_run' ((NLogN.RS.push 12 NLogN.xNegE).run ((NLogN.RS.push 11 NLogN.m10E).run ((NLogN.RS.push 10 (.reg 16)).run
      (((NLogN.RS.push 3 NLogN.m10E).run s).upd 4
        (.int (piBits (((NLogN.RS.push 3 NLogN.m10E).run s).top 3).toNat) :: ((NLogN.RS.push 3 NLogN.m10E).run s).G 4)))))
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h16])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, h16])
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h16])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, NLogN.m10E, h16]; positivity)
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h16])]
  -- size facts
  have fv := NLogN.expNegFix_zsz n (2 * n + 10) (-(piBits (2 * n + 10) * j / k))
  have hP := NLogN.log2Bits_lt (2 * n + 10)
  have hPi : NLogN.zsz (piBits (2 * n + 10)) ≤ 3 * (2 * n + 10) + 14 := by
    apply NLogN.zsz_le_of_abs
    have h := NLogN.piBits_abs_le (2 * n + 10)
    have h1 : ((2 * (2 * n + 10) + 9 : ℕ) : ℤ) < 2 ^ (2 * (2 * n + 10) + 9) := by
      exact_mod_cast Nat.lt_two_pow_self
    have e : (2 : ℤ) ^ (3 * (2 * n + 10) + 14) =
        32 * 2 ^ (2 * (2 * n + 10) + 9) * 2 ^ (2 * n + 10) := by
      rw [show 3 * (2 * n + 10) + 14 = 5 + (2 * (2 * n + 10) + 9) + (2 * n + 10) by omega,
        pow_add, pow_add]; norm_num
    rw [e]
    have : (0 : ℤ) < 2 ^ (2 * n + 10) := by positivity
    nlinarith
  have hPj : NLogN.zsz (piBits (2 * n + 10) * j) ≤ 3 * (2 * n + 10) + 14 + NLogN.zsz (j : ℤ) :=
    le_trans (NLogN.zsz_mul_le (piBits (2 * n + 10)) (j : ℤ)) (by omega)
  have hA : NLogN.zsz (piBits (2 * n + 10) * j / k) ≤ 3 * (2 * n + 10) + 14 + NLogN.zsz (j : ℤ) :=
    le_trans (NLogN.zsz_ediv_le' (piBits (2 * n + 10) * j) (k : ℤ) (Int.natCast_nonneg k)) hPj
  have hX : NLogN.zsz (-(piBits (2 * n + 10) * j / k)) ≤ 3 * (2 * n + 10) + 14 + NLogN.zsz (j : ℤ) := by
    rw [NLogN.zsz_neg]; exact hA
  have hBdef : NLogN.expNegBB n (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
      ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat
      (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) =
      NLogN.expNegB n (2 * n + 10) (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
        ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat +
        NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 12 * n + 100 := by unfold NLogN.expNegBB; rfl
  have hNB : NLogN.expNegB n (2 * n + 10) (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
      ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat =
      NLogN.expB (2 * n + 10) (3 * (2 * n + 10) + 14) + n + (2 * n + 10) +
      ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat +
      NLogN.zsz (-(piBits (2 * n + 10) * j / k)) + 10 := by unfold NLogN.expNegB; rfl
  generalize NLogN.expNegBB n (NLogN.zsz (-(piBits (2 * n + 10) * j / k)))
      ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat
      (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) = Bb at *
  have zn : NLogN.zsz (n : ℤ) ≤ Bb := le_trans (NLogN.zsz_natCast_le_self' n) (by omega)
  have znn : NLogN.zsz ((n : ℤ) + n) ≤ Bb := by
    have := NLogN.zsz_natCast_le_self' (n + n); push_cast at this; omega
  have znn10 : NLogN.zsz ((n : ℤ) + n + 10) ≤ Bb := by
    have := NLogN.zsz_natCast_le_self' (n + n + 10); push_cast at this; omega
  have z10 : NLogN.zsz (10 : ℤ) ≤ Bb := by
    have := NLogN.zsz_natCast_le_self' 10; push_cast at this; omega
  have zm : NLogN.zsz (((2 * n + 10 : ℕ)) : ℤ) ≤ Bb := le_trans (NLogN.zsz_natCast_le_self' _) (by omega)
  have zj : NLogN.zsz (j : ℤ) ≤ Bb := by omega
  have zk : NLogN.zsz (k : ℤ) ≤ Bb := by omega
  have zP : NLogN.zsz (piBits (2 * n + 10)) ≤ Bb := by omega
  have zPj : NLogN.zsz (piBits (2 * n + 10) * j) ≤ Bb := by omega
  have zA : NLogN.zsz (piBits (2 * n + 10) * j / k) ≤ Bb := by omega
  have zX : NLogN.zsz (-(piBits (2 * n + 10) * j / k)) ≤ Bb := by omega
  have zv : NLogN.zsz (expNegFix n (2 * n + 10) (-(piBits (2 * n + 10) * j / k))) ≤ Bb := by omega
  refine le_trans (add_le_add (NLogN.RS.pushCost_le _ _ Bb ?_) (add_le_add
    (NLogN.piP_cost' _ ?_ ?_) (add_le_add (NLogN.RS.pushCost_le _ _ Bb ?_) (add_le_add
    (NLogN.RS.pushCost_le _ _ Bb ?_) (add_le_add (NLogN.RS.pushCost_le _ _ (Bb + 2) ?_) (add_le_add
    (NLogN.expNegFixP_cost' _ ?_ ?_ ?_ ?_ ?_) (add_le_add (NLogN.RS.pushCost_le _ _ Bb ?_)
    le_rfl))))))) ?_
  all_goals first
    | (apply NLogN.Ex.ediv_bnd)
    | skip
  all_goals simp (config := {decide := true}) only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.Ex.size, NLogN.IState.top,
    NLogN.IState.IsInt, NLogN.RS.run_push_G, NLogN.RS.run_pop_G, NLogN.IState.upd_G, h16, h17, h18, if_true, if_false,
    List.tail_cons, NLogN.Ex.ediv_eval, NLogN.m10E, NLogN.xNegE, Int.toNat_natCast, e10, exists_eq',
    List.cons.injEq, true_and, and_true]
  all_goals (repeat' apply And.intro)
  all_goals try simp (config := {decide := true}) only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top,
    NLogN.RS.run_push_G, NLogN.IState.upd_G, h16, h17, h18, if_true, if_false]
  all_goals (repeat' apply And.intro)
  all_goals first
    | with_reducible assumption
    | (apply Nat.le_add_right_of_le; with_reducible assumption)
    | (exact Nat.cast_nonneg _)
    | positivity
    | skip
  simp only [NLogN.Ex.ediv_size, NLogN.Ex.size, show Bb + 2 + 2 = Bb + 4 by omega]
  have hZ2 : (Bb + 2) ^ 2 ≤ (Bb + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have hBZ : Bb ≤ (Bb + 4) ^ 2 := by nlinarith
  generalize (Bb + 4) ^ 2 = Z at *
  generalize (Bb + 2) ^ 2 = Y at *
  linarith [zv, zX, znn10, zn, zP]
end
