  have e1 : (fun z => (cA * ricF g gi E J B z - cB * ricF g gi E J A z - cC * ricF g gi E I B z
      + cD * ricF g gi E I A z) / 2) = fun z => (1 / 2 : ℂ) * (cA * ricF g gi E J B z - cB * ricF g gi E J A z
      - cC * ricF g gi E I B z + cD * ricF g gi E I A z) := funext fun z => by ring
