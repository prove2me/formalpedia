theorem PI.WGL.Fock6.applyWord_append {R : Type*} [CommRing R] {r n : ℕ} (l1 l2 : List (Fin r × Fin r × ℕ))
    (f : MvPolynomial (Fin r × Fin n) R) :
    applyWord R (l1 ++ l2) f = applyWord R l1 (applyWord R l2 f) := by sorry
