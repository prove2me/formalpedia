  intro X hX
  refine Submodule.span_induction
    (p := fun M _ =>
      infinityConjugationLinearMap P r (cartwrightStegerGenerator P r x) M ∈
        InfinityCyclicLattice P r)
    ?basis ?zero ?add ?smul hX
  · intro M hM
    obtain ⟨c, k, hk, rfl⟩ := hM
    let kFin : Fin r.matrixRank := ⟨k, hk⟩
    change
      ((cartwrightStegerGenerator P r x :
            Matrix (Fin r.matrixRank) (Fin r.matrixRank)
              (SplittingFunctionField P r)) *
          (constantMatrix P r c * cyclicGeneratorMatrix P r ^ k)) *
          (((cartwrightStegerGenerator P r x)⁻¹ :
              Matrix.GeneralLinearGroup (Fin r.matrixRank)
                (SplittingFunctionField P r)) :
            Matrix (Fin r.matrixRank) (Fin r.matrixRank)
              (SplittingFunctionField P r)) ∈ InfinityCyclicLattice P r
    have hformula := cartwrightStegerGenerator_conj_monomial P r x kFin c
    change _ = infinityConjugationFormula P r
      (constantClassRepresentative P r x) k c at hformula
    rw [hformula]
    exact infinityConjugationFormula_mem_lattice P r
      (constantClassRepresentative P r x) k hk c
  · change infinityConjugationLinearMap P r
      (cartwrightStegerGenerator P r x) 0 ∈ InfinityCyclicLattice P r
