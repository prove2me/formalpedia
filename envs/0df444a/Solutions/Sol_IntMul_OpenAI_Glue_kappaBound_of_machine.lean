    have hpos : 0 ≤ 50 * (6 * L) ^ es := by
      have := Real.rpow_nonneg (show (0 : ℝ) ≤ 6 * L by linarith) es; positivity
    calc V n * Ncost (6 * L) (d n) (K n) (ℓ n) (α n) ≤ V n * (50 * (6 * L) ^ es) :=
          mul_le_mul_of_nonneg_left hN (hV0 n hn)
      _ ≤ 48 * n * (50 * (6 * L) ^ es) := mul_le_mul_of_nonneg_right (hV n hn) hpos
      _ ≤ 48 * n * (50 * (6 * L ^ (1 - 1 / 2 ^ 182 : ℝ))) := by gcongr
  have hgoal : C₀ * (V n * Ncost (6 * L) (d n) (K n) (ℓ n) (α n) + n) ≤
      (C₀ * (48 * 50 * 6 + 1) + 1) * (n * L ^ (1 - 1 / 2 ^ 182 : ℝ)) := by
    have hnL : (n : ℝ) ≤ n * L ^ (1 - 1 / 2 ^ 182 : ℝ) := by nlinarith
    have hX : 0 ≤ (n : ℝ) * L ^ (1 - 1 / 2 ^ 182 : ℝ) := by positivity
    calc C₀ * (V n * Ncost (6 * L) (d n) (K n) (ℓ n) (α n) + n)
        ≤ C₀ * (48 * n * (50 * (6 * L ^ (1 - 1 / 2 ^ 182 : ℝ))) +
            n * L ^ (1 - 1 / 2 ^ 182 : ℝ)) := by gcongr
      _ = C₀ * (48 * 50 * 6 + 1) * (n * L ^ (1 - 1 / 2 ^ 182 : ℝ)) := by ring
      _ ≤ (C₀ * (48 * 50 * 6 + 1) + 1) * (n * L ^ (1 - 1 / 2 ^ 182 : ℝ)) := by nlinarith
  exact hgoal

end

