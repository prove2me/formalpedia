-- title:
--   Finite module from strict-weight monic relations
-- statement:
--   For positive weights, monic coordinate relations with strictly lower-weight remainders imply that the polynomial ring is a finite module over the algebra generated by those relations. Induction on weighted degree reduces to finitely many bounded-exponent monomials.

import Definitions.Def_OAI_PiExponent_TruncatedPolynomialJets
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Defs

open scoped BigOperators
open OAI.PiExponent OAI.PiExponent.DeterminantContradiction OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_strict_monic_relations
    {m : Nat}
    (w : Fin (m + 1) → Real)
    (I : Ideal (MvPolynomial (Fin (m + 1)) Complex))
    (s : Nat) (D : Real)
    (N : Fin (m + 1) → Nat)
    (r f : Fin (m + 1) → MvPolynomial (Fin (m + 1)) Complex)
    (hN : ∀ i, 0 < N i)
    (hf : ∀ i, f i = MvPolynomial.X i ^ N i - r i)
    (hmem : ∀ i, f i ∈ I ^ s)
    (hbound : ∀ i, ∀ a ∈ (f i).support,
      ∑ j, w j * (a j : Real) ≤ D)
    (hNbound : ∀ i, (N i : Real) * w i ≤ D)
    (hlow : ∀ i, ∀ a ∈ (r i).support,
      ∑ j, w j * (a j : Real) < (N i : Real) * w i)
    (hw : ∀ i, 0 < w i) :
    Module.Finite (Algebra.adjoin Complex (Set.range f))
      (MvPolynomial (Fin (m + 1)) Complex) := by sorry
