section

private theorem psiLoc_eq_of_forall_apply_inr_eq_finprod {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    {ψv : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ}
    (h : ∀ x : FiniteAdeleRing (𝓞 ℚ) ℚ,
      ψ (AddMonoidHom.inr (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) x) =
        ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), ψv v (x v))
    (v : HeightOneSpectrum (𝓞 ℚ)) (s : v.adicCompletion ℚ) : psiLoc ψ v s = ψv v s := by
  show ψ (AddMonoidHom.inr (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)
    (StandardAddChar.finAdeleSingleAt ℚ v s)) = ψv v s
  rw [h, finprod_eq_single (fun w => ψv w (StandardAddChar.finAdeleSingleAt ℚ v s w)) v fun w hw => by
    show ψv w (StandardAddChar.finAdeleSingleAt ℚ v s w) = 1
    rw [StandardAddChar.finAdeleSingleAt_apply_of_ne ℚ v s hw, AddChar.map_zero_eq_one]]
  show ψv v (StandardAddChar.finAdeleSingleAt ℚ v s v) = ψv v s
  rw [StandardAddChar.finAdeleSingleAt_apply_self]

private theorem psiLoc_ne_one_and_exists_ball {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ} (hψ : IsGlobalAddChar ℚ ψ)
    (v : HeightOneSpectrum (𝓞 ℚ)) :
    psiLoc ψ v ≠ 1 ∧ ∃ k : ℤ, ∀ x : v.adicCompletion ℚ, Valued.v x ≤ WithZero.exp k → psiLoc ψ v x = 1 := by
  obtain ⟨ψv, nψ, θr, θc, h1, h2, -, h4, -, -, -⟩ := exists_localComponents_of_isGlobalAddChar ℚ ψ hψ
  have e : ∀ s, psiLoc ψ v s = ψv v s := psiLoc_eq_of_forall_apply_inr_eq_finprod h4 v
  refine ⟨fun h => ?_, nψ v, fun x hx => (e x).trans (h1 v x hx)⟩
  obtain ⟨x, -, hx⟩ := h2 v
  exact hx ((e x).symm.trans (by rw [h, AddChar.one_apply]))

private theorem ne_one_and_exists_ball_of_forall_apply_eq_apply_mul {v : HeightOneSpectrum (𝓞 ℚ)}
    {χ χ' : AddChar (v.adicCompletion ℚ) ℂ} {c : v.adicCompletion ℚ} (hc : c ≠ 0) (hχ' : ∀ s, χ' s = χ (c * s))
    (h : χ ≠ 1 ∧ ∃ k : ℤ, ∀ x, Valued.v x ≤ WithZero.exp k → χ x = 1) :
    χ' ≠ 1 ∧ ∃ k : ℤ, ∀ x, Valued.v x ≤ WithZero.exp k → χ' x = 1 := by
  obtain ⟨hne, k, hk⟩ := h
  obtain ⟨m, hm⟩ : ∃ m : ℤ, WithZero.exp m = Valued.v c :=
    ⟨WithZero.log (Valued.v c), WithZero.exp_log ((Valuation.ne_zero_iff _).2 hc)⟩
  refine ⟨fun h1 => hne ?_, k - m, fun x hx => ?_⟩
  · ext y
    rw [AddChar.one_apply, show y = c * (c⁻¹ * y) by rw [← mul_assoc, mul_inv_cancel₀ hc, one_mul], ← hχ', h1,
      AddChar.one_apply]
  · rw [hχ']
    refine hk _ ?_
    rw [map_mul, ← hm]
    calc WithZero.exp m * Valued.v x ≤ WithZero.exp m * WithZero.exp (k - m) := mul_le_mul' le_rfl hx
      _ = WithZero.exp k := by rw [← WithZero.exp_add]; congr 1; omega

private theorem valued_algebraMap_eq_one_of_addCharLevel_eq_zero {ψ ψ₀ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ₀ : IsGlobalAddChar ℚ ψ₀) {a : ℚ} (ha : a ≠ 0)
    (hψ : ∀ x, ψ x = ψ₀ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x)) (v : HeightOneSpectrum (𝓞 ℚ))
    (h₀ : TateLocal.addCharLevel (psiLoc ψ₀ v) = 0) (h : TateLocal.addCharLevel (psiLoc ψ v) = 0) :
    Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1 := by
  have hd : ∀ s, psiLoc ψ v s = psiLoc ψ₀ v (algebraMap ℚ (v.adicCompletion ℚ) a * s) :=
    psiLoc_apply_of_forall_apply_eq hψ v
  have ha' : algebraMap ℚ (v.adicCompletion ℚ) a ≠ 0 := (map_ne_zero (algebraMap ℚ (v.adicCompletion ℚ))).2 ha
  have H₀ := psiLoc_ne_one_and_exists_ball hψ₀ v
  have H := ne_one_and_exists_ball_of_forall_apply_eq_apply_mul ha' hd H₀
  obtain ⟨h₁, h₂⟩ := TateLocal.forall_eq_one_and_exists_ne_one_of_addCharLevel ℚ v (psiLoc ψ₀ v) H₀.2 H₀.1
  obtain ⟨h₁', h₂'⟩ := TateLocal.forall_eq_one_and_exists_ne_one_of_addCharLevel ℚ v (psiLoc ψ v) H.2 H.1
  rw [h₀] at h₁ h₂
  rw [h] at h₁' h₂'
  rw [WithZero.exp_zero] at h₁ h₁'
  rw [zero_add] at h₂ h₂'
  exact valued_eq_one_of_forall_apply_eq_apply_mul v hd h₁ h₂ h₁' h₂'

