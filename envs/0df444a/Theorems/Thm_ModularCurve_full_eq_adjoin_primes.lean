-- title:
--   At squarefree level, divisor expansions are generated by prime ones
-- statement:
--   Let $N$ be a natural number, nonzero as a typeclass hypothesis, and assume $N$ is squarefree. Work inside the field $\mathbb{Q}((q))$ of Laurent series over $\mathbb{Q}$, in which `jq` denotes the Laurent series $q^{-1}$ times the rational power series `jNumQ` (the $q$-expansion of the $j$-invariant), and in which `qExpand ℚ n` is the ring endomorphism substituting $q \mapsto q^{n}$, obtained by multiplying exponents by $n$; thus `jqN p` $=$ `qExpand ℚ p jq` is the expansion of $j(q^{p})$. The assertion is an equality of intermediate fields of $\mathbb{Q}((q))$ over $\mathbb{Q}$: the field `modularFunctionFieldFull N`, defined as the subfield generated over $\mathbb{Q}$ by all the series `qExpand ℚ d jq` for nonzero divisors $d$ of $N$, coincides with the subfield generated over $\mathbb{Q}$ by `jq` together with the series `jqN p` for $p$ ranging over the prime factors of $N$ (the nonzero condition on $p$ being automatic there).
--
--   This identifies, at squarefree level, the formal $q$-expansion model of the compositum of the function fields of the curves $X_0(d)$, $d \mid N$, with the field generated by the prime-level expansions alone: $\mathbb{Q}(j(q^{d}) : d \mid N) = \mathbb{Q}(j, j(q^{p}) : p \mid N)$. It is used in the degree computations for the fields $\mathbb{Q}(j)(j(q^{N}))$, in particular by [`ModularCurve.finrank_adjoin_jqN_eq_of_squarefree`](thm.html#ModularCurve.finrank_adjoin_jqN_eq_of_squarefree), [`ModularCurve.relfinrank_adjoin_primes`](thm.html#ModularCurve.relfinrank_adjoin_primes) and [`ModularCurve.relfinrank_full_mul_prime`](thm.html#ModularCurve.relfinrank_full_mul_prime), which together give the degree $\psi(N)$ of the modular equation of level $N$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_full_eq_adjoin_primes.lean

import Definitions.Def_ModularCurve_X0
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

theorem ModularCurve.full_eq_adjoin_primes (N : ℕ) [NeZero N] (hN : Squarefree N) : modularFunctionFieldFull N = IntermediateField.adjoin ℚ (insert jq {x : LaurentSeries ℚ | ∃ p ∈ N.primeFactors, ∃ _ : NeZero p, x = jqN p}) := by sorry
