-- title:
--   The cyclotomic wheel ring after coefficient extension
-- statement:
--   Let $1\le r\le k$, let $\zeta\in\mathbb C$ be a primitive $r$th root of unity, and use the actual subring $O=\mathbb Z[\zeta]\subseteq\mathbb C$ and subfield $K=\mathbb Q(\zeta)\subseteq\mathbb C$. Let $R_{r,k}\subseteq O[y_1,\ldots,y_k]$ consist of the symmetric polynomials satisfying
--   $$
--   f(y_1,\zeta y_1,\ldots,\zeta^{r-1}y_1,y_{r+1},\ldots,y_k)
--   =f(0,\ldots,0,y_{r+1},\ldots,y_k).
--   $$
--   Let $\iota$ denote coefficient inclusion into $\mathbb C[y_1,\ldots,y_k]$, and write $p_n=\sum_{j=1}^k y_j^n$. Then
--   $$
--   \operatorname{span}_K\iota(R_{r,k})=K[p_n:n\ge1,\ r\nmid n].
--   $$
--   The left side is the canonical image of $R_{r,k}\otimes_O K$. At $r=1$ both sides are constants.
--
--   The formulation identifies subspaces in a common ambient polynomial ring and retains the specified cyclotomic coefficient field.
-- source:
--   Affine and degenerate affine BMW algebras: The center, arXiv:1105.4207v2, PDF p. 22, Equation 4.13

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P34

namespace QAlgorithms.Papers.Independent.Intakenext100.P34

open QAlgorithms.Papers.Independent.Support21.P08 (Central)

noncomputable section

universe u

variable (C : Type u) [CommRing C]

/-- Equation (4.13), PDF p.22: equality of the image of coefficient extension
with the algebra generated by power sums of degrees not divisible by r.
Both sides lie in the complex polynomial ring, with scalars Q(zeta).
The left side is precisely the linear image of R_(r,k) tensor Q(zeta). -/
theorem equation4_13 (k r : ℕ) (hr : 0 < r) (hrk : r ≤ k)
    (zeta : ℂ) (hzeta : IsPrimitiveRoot zeta r) :
    let hk : 0 < k := lt_of_lt_of_le hr hrk
    let O := CyclotomicIntegers zeta
    let K := CyclotomicField zeta
    Submodule.span K {g : MvPolynomial (Fin k) ℂ | ∃ f : MvPolynomial (Fin k) O,
      Wheel O k r hk (integralRoot zeta) f ∧ MvPolynomial.map O.val f = g} =
    (Algebra.adjoin K {g : MvPolynomial (Fin k) ℂ | ∃ n : ℕ,
      ¬ r ∣ n ∧ g = coefficientPowerSum ℂ k n}).toSubmodule := by sorry

end

end QAlgorithms.Papers.Independent.Intakenext100.P34
