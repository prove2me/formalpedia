            Spec.map (CommRingCat.ofHom (algebraMap C T)) →
          ∃ s₀ : Spec (CommRingCat.of T) ⟶ Xb, s₀ ≫ j = s) ∧
      (∀ (B : Type) [CommRing B] [Algebra C B]
        (t : Spec (CommRingCat.of B) ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))),
