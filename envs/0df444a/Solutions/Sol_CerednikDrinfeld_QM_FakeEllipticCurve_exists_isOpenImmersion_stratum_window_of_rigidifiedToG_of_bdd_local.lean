      ∃ xe : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (ξ Nc ≫ Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))),
          InB Nc S xe ∧ pts Nc S xe = x := by
  intro S _ _ _ _ _ _ x h0 hch
  have hS : IsNilpotent (algebraMap 𝒪 S π) :=
    ⟨1, by rw [pow_one, IsScalarTower.algebraMap_apply 𝒪 C S]; exact h0⟩
  obtain ⟨u, ρ, hx⟩ := hR3s S ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl x
  have hθx := hθ S hS ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl u ρ
  rw [← hx, hθx] at hch
  obtain ⟨ρ', hd', heq⟩ := hEXH S hS ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) ⟨u.1, ρ⟩ hch
  obtain ⟨i, j, hbal, he⟩ := ChartDict3.exists_pad_window_eq hΛℤ c hc deg deg' hpad hprod ρ' Nc (by omega)
  have hpt : ptR S _ rfl u (ChartDict3.pad hΛℤ ρ' i j) = x := by
    rw [← hx]
    have h1 := ChartDict3.ptR_eq_of_equiv hΛℤ (ptR S ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl)
      (hR1 S ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl) u ρ ρ' heq
    have h2 := ChartDict3.ptR_eq_of_equiv hΛℤ (ptR S ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl)
      (hR1 S ((IsScalarTower.toAlgHom 𝒪 C S).comp χC) rfl) u ρ' _ (ChartDict3.equiv_pad hΛℤ ρ' i j)
    rw [h2, h1]
  refine ⟨ptX Nc S _ rfl u (ChartDict3.pad hΛℤ ρ' i j) he h0, (hInB Nc S _ rfl u _ he h0).mpr hbal, ?_⟩
  rw [hx1, hpt]

