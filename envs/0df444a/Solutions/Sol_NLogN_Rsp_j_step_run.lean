    ⟨R9, h9⟩⟩ := h
  exact ⟨⟨L1, by rw [he _ (by simp [eRegs]), h1]⟩, ⟨L2, by rw [he _ (by simp [eRegs]), h2]⟩,
    ⟨L3, by rw [he _ (by simp [eRegs]), h3]⟩, ⟨L4, by rw [he _ (by simp [eRegs]), h4]⟩,
    ⟨L5, by rw [he _ (by simp [eRegs]), h5]⟩, ⟨L6, by rw [he _ (by simp [eRegs]), h6]⟩,
    ⟨L7, by rw [he _ (by simp [eRegs]), h7]⟩, ⟨R8, by rw [he _ (by simp [eRegs]), h8]⟩,
    ⟨R9, by rw [he _ (by simp [eRegs]), h9]⟩⟩

theorem dist_J : Dist6 CU JA JS JT JW JK := ⟨by decide, by decide⟩

theorem sgV_neg (j : ℕ) : -(sgV (decide (j % 2 = 1))) = sgV (decide ((j + 1) % 2 = 1)) := by
  rcases Nat.mod_two_eq_zero_or_one j with h | h
  · have : (j + 1) % 2 = 1 := by omega
    simp [sgV, h, this]
  · have : (j + 1) % 2 = 0 := by omega
    simp [sgV, h, this]

theorem jSt_eRegs (s1 : IState HS) (p s t α : ℕ) (u : List (ℤ × ℤ)) (RU RA LS : List Item) (j : ℕ)
    (S0 : IState HS) (N k : ℕ) (σ : IState HS)
