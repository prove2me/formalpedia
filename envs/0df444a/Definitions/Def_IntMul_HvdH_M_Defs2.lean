section
-- Source module: NLogN.HExprDiv
/-!
# Long division
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

/-- The number of stacks of the HvdH machine. -/
abbrev HS : ℕ := 64

/-- The expression scratch stacks. -/
def zX : ExSt HS := ⟨56, 57, 58, 59, 60, 61, 62, 63⟩

@[simp] theorem zX_V : zX.V = 56 := rfl
@[simp] theorem zX_A : zX.A = 57 := rfl
@[simp] theorem zX_B : zX.B = 58 := rfl
@[simp] theorem zX_C : zX.C = 59 := rfl
@[simp] theorem zX_D : zX.D = 60 := rfl
@[simp] theorem zX_E : zX.E = 61 := rfl
@[simp] theorem zX_F : zX.F = 62 := rfl
@[simp] theorem zX_G : zX.G = 63 := rfl

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The state of the long division: `V = L`, registers `A … E` on top of the original stacks,
optionally a flag on `F`. -/
def ldSt (s : IState HS) (L : List Item) (a b c d : ℤ) (f : Option ℤ) : IState HS :=
  ((((((s.upd 56 L).upd 57 (.int a :: s.G 57)).upd 58 (.int b :: s.G 58)).upd 59
    (.int c :: s.G 59)).upd 60 (.int d :: s.G 60)).upd 61 (.int 2 :: s.G 61)).upd 62
    (match f with | some x => .int x :: s.G 62 | none => s.G 62)

end NLogN

end

