    exact Ideal.IsPrime.mem_of_pow_mem inferInstance _ hpe
  have hmod0 : ∀ s : ↥SS, (((An s).modulus : ↥A) : AlgebraicClosure ℚ) ≠ 0 := by
    intro s
    obtain ⟨u, hu, hmod⟩ := hmodulus s
