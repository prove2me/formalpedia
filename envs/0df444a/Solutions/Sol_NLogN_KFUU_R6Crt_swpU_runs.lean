-- Source module: Solutions.R6CrtAlg
/-!
# CRT reversal §2: the address algebra of the additive-swap reversal

Addresses of the shape `SH n Q T = replicate n Q ++ T` (the `n` main digits of size `Q`, then an
arbitrary tail `T`).  With `m = n / 2`, `x` = digits `[0, m)`, `y` = digits `[n-m, n)`:

* `shr Q i k μ` — digit `i` := digit `i` − `μ ·` digit `k` (mod `Q`): the pull map of one
  digit-selector rotation `rotDU` (`rotG_shr`);
* `lsetK … sig μ m` — the `m` shears of one rotation set (target `n-m+j`, control
  `ctl sig m j = σ j` or `j`);
* `bsw n m` — exchange of the digit blocks `x` and `y` (one composite Lemma 12 swap).

**`word_rev`**: `L(-σ) ∘ S ∘ L(σ) ∘ L(-1) ∘ S ∘ L(1) ∘ S ∘ L(σ) ∘ L(-1) = revH n` on valid
addresses (as a composite pull map; see `jain6/crt/DESIGN.md`).  The proof computes the digits in
`ZMod Q` block by block.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFUU.R6Crt

open IntMul KIL AModel NLogN.KFUU

/-! ## Shapes and maps -/

/-! ## The selector table -/

/-! ## Digits -/

/-! ## The rotation sets -/

/-! ## The block swap -/

/-! ## The word -/

/-! ## The reversal identity -/

/-! ## The block swap as a composite Lemma 12 swap -/

theorem encode_rep_lt {m Q : ℕ} {a : List ℕ} (h : Valid (List.replicate m Q) a) :
    encode (List.replicate m Q) a < Q ^ m := by
  have := encode_lt h
  simpa [vol, List.prod_replicate] using this

theorem vol_rep (m Q : ℕ) : vol (List.replicate m Q) = Q ^ m := by simp [vol, List.prod_replicate]

/-- The address split `x ++ z ++ y ++ t` of `SH n Q T`. -/
theorem SH_split (n m Q : ℕ) (T : Shape) (hmn : 2 * m ≤ n) :
    SH n Q T = List.replicate m Q ++ (List.replicate (n - 2 * m) Q ++ (List.replicate m Q ++ T)) := by
  unfold SH
  rw [← List.append_assoc, ← List.append_assoc, ← List.replicate_add, ← List.replicate_add]
  congr 2; omega

theorem encode_SH {n m Q : ℕ} {T : Shape} (hmn : 2 * m ≤ n) {xa za ya ta : List ℕ}
    (hx : xa.length = m) (hz : za.length = n - 2 * m) (hy : ya.length = m) :
    encode (SH n Q T) (xa ++ (za ++ (ya ++ ta))) =
      encode (List.replicate m Q) xa * (Q ^ (n - 2 * m) * (Q ^ m * vol T)) +
        (encode (List.replicate (n - 2 * m) Q) za * (Q ^ m * vol T) +
          (encode (List.replicate m Q) ya * vol T + encode T ta)) := by
  rw [SH_split n m Q T hmn, AModelL12.encode_append_len _ _ (by simp [hx]), AModelL12.encode_append_len _ _ (by simp [hz]),
    AModelL12.encode_append_len _ _ (by simp [hy]), vol_append, vol_append, vol_rep, vol_rep]

theorem bsw_split {n m : ℕ} (hmn : 2 * m ≤ n) {xa za ya ta : List ℕ}
    (hx : xa.length = m) (hz : za.length = n - 2 * m) (hy : ya.length = m) :
    bsw n m (xa ++ (za ++ (ya ++ ta))) = ya ++ (za ++ (xa ++ ta)) := by
  have e1 : (xa ++ (za ++ (ya ++ ta))).take n = xa ++ (za ++ ya) := by
    rw [← List.append_assoc za, ← List.append_assoc xa, ← List.append_assoc,
      List.take_append_of_le_length (by simp; omega), List.take_of_length_le (by simp; omega)]
    all_goals simp
  have e2 : (xa ++ (za ++ (ya ++ ta))).take (n - m) = xa ++ za := by
    rw [← List.append_assoc, List.take_append_of_le_length (by simp; omega),
      List.take_of_length_le (by simp; omega)]
  have e3 : (xa ++ (za ++ (ya ++ ta))).take m = xa := by
    rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega)]
  have e4 : (xa ++ (za ++ (ya ++ ta))).drop n = ta := by
    rw [← List.append_assoc za, ← List.append_assoc xa, List.drop_append_of_le_length (by simp; omega),
      List.drop_of_length_le (by simp; omega)]
    all_goals simp
  unfold bsw
  rw [e1, e2, e3, e4, ← List.append_assoc xa, List.drop_append_of_le_length (by simp; omega),
    List.drop_of_length_le (by simp; omega), List.drop_append_of_le_length (by omega),
    List.drop_of_length_le (by omega)]
  all_goals simp

theorem valid_app {A B : Shape} {b : List ℕ} (h : Valid (A ++ B) b) :
    Valid A (b.take A.length) ∧ Valid B (b.drop A.length) := by
  constructor
  · have := h.take A.length; rwa [List.take_left] at this
  · have := h.drop A.length; rwa [List.drop_left] at this

theorem valid_split {n m Q : ℕ} {T : Shape} (hmn : 2 * m ≤ n) {b : List ℕ} (hb : Valid (SH n Q T) b) :
    ∃ xa za ya ta, b = xa ++ (za ++ (ya ++ ta)) ∧ Valid (List.replicate m Q) xa ∧
      Valid (List.replicate (n - 2 * m) Q) za ∧ Valid (List.replicate m Q) ya ∧ Valid T ta := by
  rw [SH_split n m Q T hmn] at hb
  obtain ⟨v1, h1⟩ := valid_app hb
  obtain ⟨v2, h2⟩ := valid_app h1
  obtain ⟨v3, v4⟩ := valid_app h2
  simp only [List.length_replicate] at v1 v2 v3 v4
  refine ⟨_, _, _, _, ?_, v1, v2, v3, v4⟩
  simp

theorem vol_SH (n Q : ℕ) (T : Shape) : vol (SH n Q T) = Q ^ n * vol T := by
  rw [SH, vol_append, vol_rep]

/-- **The composite Lemma 12 swap `[1, Q^m, Q^{n-2m}, Q^m, vol T]` (axes 1, 3) is `bsw`.** -/
theorem pull_bsw {n m Q : ℕ} {T : Shape} (hmn : 2 * m ≤ n) (hQ : 1 ≤ Q) (hT : ∀ a ∈ T, 1 ≤ a)
    (xs : List ℤ) :
    pull [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T] [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T]
        (swapPos 1 3) 0 xs = pull (SH n Q T) (SH n Q T) (bsw n m) 0 xs := by
  have hv : vol [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T] = vol (SH n Q T) := by
    rw [vol_SH]; simp only [vol_cons, vol_nil]
    rw [show n = m + (n - 2 * m) + m by omega, pow_add, pow_add]
    rw [show m + (n - 2 * m) + m - 2 * m = n - 2 * m by omega]; ring
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  rw [length_pull] at h1
  rw [getElem_pull, getElem_pull]
  congr 1
  have hj : j < vol (SH n Q T) := by rwa [← hv]
  obtain ⟨xa, za, ya, ta, hb, vx, vz, vy, vt⟩ := valid_split hmn (valid_decode hj)
  have hx := vx.length_eq; have hz := vz.length_eq; have hy := vy.length_eq
  simp only [List.length_replicate] at hx hz hy
  have he : encode (SH n Q T) (decode (SH n Q T) j) = j := encode_decode hj
  rw [hb] at he
  -- the five digits
  set D5 : List ℕ := [0, encode (List.replicate m Q) xa, encode (List.replicate (n - 2 * m) Q) za,
    encode (List.replicate m Q) ya, encode T ta] with hD5
  have v5 : Valid [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T] D5 :=
    List.Forall₂.cons (by norm_num) (List.Forall₂.cons (encode_rep_lt vx)
      (List.Forall₂.cons (encode_rep_lt vz) (List.Forall₂.cons (encode_rep_lt vy)
        (List.Forall₂.cons (encode_lt vt) List.Forall₂.nil))))
  have e5 : encode [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T] D5 = j := by
    rw [← he, encode_SH hmn hx hz hy]
    simp [D5, encode, vol]
  have hd5 : decode [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, vol T] j = D5 := by
    rw [← e5, decode_encode v5]
  rw [hd5, hb, bsw_split hmn hx hz hy, encode_SH hmn hy hz hx]
  simp [D5, swapPos, encode, vol]
  all_goals ring

end NLogN.KFUU.R6Crt

