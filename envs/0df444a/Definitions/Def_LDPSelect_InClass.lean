-- title:
--   Minimally infeasible sets, components, the conflict graph and the class $\mathcal G$
-- statement:
--   Let $\mathcal F$ be a downward-closed family on $E$.
--
--   1. A set $C$ is **minimally infeasible** if $C\notin\mathcal F$ and every proper subset of $C$ lies in $\mathcal F$.
--   2. Elements are grouped into **components** by the equivalence relation generated by "lying in a common minimally infeasible set". An element in no minimally infeasible set (a **free element**) forms its own component.
--   3. The **conflict graph** joins distinct $u,v$ when $\{u,v\}$ is minimally infeasible.
--   4. $\mathcal F$ belongs to the class $\mathcal G$ of Theorem 1 if every component $K$ satisfies one of:
--      - exactly one minimally infeasible set is contained in $K$; or
--      - every minimally infeasible set contained in $K$ has two elements, and the conflict graph induced on $K$ is complete multipartite.
--
--   A free element meets the second condition, as the parenthesis in Theorem 1 says; a loop $\{x\}\notin\mathcal F$ meets the first. Every minimally infeasible set lies inside one component, so counting the sets contained in $K$ counts the sets of that component.
--
--   **Formalization Note** A graph is complete multipartite in Mathlib's sense when non-adjacency is transitive; this includes edgeless graphs on one vertex, which is how a free element qualifies.
-- source:
--   Chen, Wang, When Does Private Data Collection Need Interaction? Online Selection under Local Differential Privacy, STOC 2027 submission (manuscript sha256 2e2d6157…), §1.1, p.1–2 (pdf pp.2–3), Theorem 1; §5, p.9 (pdf p.10)

import Mathlib
import Definitions.Def_LDPSelect_Family

namespace LDPSelect

/-!
# Minimally infeasible sets, components, the class `G`

Chen, Wang, *When Does Private Data Collection Need Interaction? Online Selection under Local
Differential Privacy*, STOC 2027 submission (manuscript sha256 2e2d6157…), §1.1, pp.1–2 (Theorem 1); §5, p.9 ("Let G be the class described in Theorem 1").

**Formalization Note.** A component is a class of the equivalence relation generated by "lying in a
common minimally infeasible set", so an element in no minimally infeasible set is its own class. "The
component has exactly one minimally infeasible set" counts the minimally infeasible sets contained in
the class, and every such set lies in one class. The conflict graph of a component is the induced
graph on the class, with only two-element minimally infeasible sets as edges. Mathlib's
`IsCompleteMultipartite` is transitivity of non-adjacency, so an edgeless graph and a singleton
qualify; a free element therefore meets the second disjunct, as the parenthesis of Theorem 1 says.
-/

/-- `C` is minimally infeasible: not in `F`, with all proper subsets in `F` (p.1). -/
def IsMIS {n : ℕ} (F : Family n) (C : Finset (Fin n)) : Prop :=
  C ∉ F ∧ ∀ T, T ⊂ C → T ∈ F

/-- The transitive closure of lying in a common minimally infeasible set, made reflexive (p.1). -/
def SameComp {n : ℕ} (F : Family n) : Fin n → Fin n → Prop :=
  Relation.EqvGen (fun u v => ∃ C, IsMIS F C ∧ u ∈ C ∧ v ∈ C)

/-- The component of `u`. -/
def comp {n : ℕ} (F : Family n) (u : Fin n) : Set (Fin n) := {v | SameComp F u v}

/-- The conflict graph: distinct `u, v` are adjacent when `{u, v}` is minimally infeasible. -/
def conflictGraph {n : ℕ} (F : Family n) : SimpleGraph (Fin n) where
  Adj u v := u ≠ v ∧ IsMIS F {u, v}
  symm := ⟨fun u v h => ⟨h.1.symm, by rw [Finset.pair_comm]; exact h.2⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- The class `G` of Theorem 1: every component either has exactly one minimally infeasible set, or
has only two-element minimally infeasible sets forming a complete multipartite conflict graph. -/
def InClass {n : ℕ} (F : Family n) : Prop :=
  ∀ u : Fin n,
    (∃! C, IsMIS F C ∧ (↑C : Set (Fin n)) ⊆ comp F u) ∨
    ((∀ C, IsMIS F C → (↑C : Set (Fin n)) ⊆ comp F u → C.card = 2) ∧
      ((conflictGraph F).induce (comp F u)).IsCompleteMultipartite)

end LDPSelect


