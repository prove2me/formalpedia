-- Source module: Solutions.J6SegILPreJ5
/-!
# B-line IL, `J` pre-table (B5-J), part 5: register-only loops and the parameter recursions

* `Rn.loopA`: `repeat rN times (asgs l)` (registers only), from a step invariant.
* the four recursions of the parameter phase, as pure invariant lemmas:
  `sqrt` (`sqS_step`), `2^⌊log₂ x⌋` by doubling (`lgS_step`), `Nat.size` by halving
  (`szS_step`), `2^⌈log₂ m⌉` (`clS_step`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E

/-! ## The recursions -/

/-- One step of the integer square root. -/
theorem sqS_step (d k : ℕ) :
    (if (d : ℤ) - ((min k (Nat.sqrt d) : ℕ) + 1) * ((min k (Nat.sqrt d) : ℕ) + 1) < 0 then
      ((min k (Nat.sqrt d) : ℕ) : ℤ) else ((min k (Nat.sqrt d) : ℕ) : ℤ) + 1) =
      ((min (k + 1) (Nat.sqrt d) : ℕ) : ℤ) := by
  rcases lt_or_ge k (Nat.sqrt d) with h | h
  · have hm : min k (Nat.sqrt d) = k := min_eq_left h.le
    have hm' : min (k + 1) (Nat.sqrt d) = k + 1 := min_eq_left h
    rw [hm, hm']
    have h1 : (k + 1) * (k + 1) ≤ d := by
      have := Nat.sqrt_le' d
      calc (k + 1) * (k + 1) ≤ Nat.sqrt d * Nat.sqrt d := Nat.mul_le_mul h h
        _ ≤ d := Nat.sqrt_le d
    have : ¬ ((d : ℤ) - ((k : ℕ) + 1) * ((k : ℕ) + 1) < 0) := by
      push Not; have : (((k + 1) * (k + 1) : ℕ) : ℤ) ≤ d := by exact_mod_cast h1
      push_cast at this; linarith
    rw [if_neg this]; push_cast; ring
  · have hm : min k (Nat.sqrt d) = Nat.sqrt d := min_eq_right h
    have hm' : min (k + 1) (Nat.sqrt d) = Nat.sqrt d := min_eq_right (by omega)
    rw [hm, hm']
    have h1 : d < (Nat.sqrt d + 1) * (Nat.sqrt d + 1) := Nat.lt_succ_sqrt d
    have : (d : ℤ) - ((Nat.sqrt d : ℕ) + 1) * ((Nat.sqrt d : ℕ) + 1) < 0 := by
      have : (d : ℤ) < (((Nat.sqrt d + 1) * (Nat.sqrt d + 1) : ℕ) : ℤ) := by exact_mod_cast h1
      push_cast at this; linarith
    rw [if_pos this]

/-- One doubling step towards `2^⌊log₂ x⌋`. -/
theorem lgS_step (x k : ℕ) :
    (if (x : ℤ) - 2 * ((2 ^ min k (Nat.log 2 x) : ℕ) : ℤ) < 0 then ((2 ^ min k (Nat.log 2 x) : ℕ) : ℤ)
      else 2 * ((2 ^ min k (Nat.log 2 x) : ℕ) : ℤ)) = ((2 ^ min (k + 1) (Nat.log 2 x) : ℕ) : ℤ) := by
  rcases lt_or_ge k (Nat.log 2 x) with h | h
  · rw [min_eq_left h.le, min_eq_left h]
    have hx : x ≠ 0 := by rintro rfl; simp at h
    have h1 : 2 ^ (k + 1) ≤ x :=
      le_trans (Nat.pow_le_pow_right (by norm_num) h) (Nat.pow_log_le_self 2 hx)
    have : ¬ ((x : ℤ) - 2 * ((2 ^ k : ℕ) : ℤ) < 0) := by
      push Not; have : ((2 ^ (k + 1) : ℕ) : ℤ) ≤ x := by exact_mod_cast h1
      push_cast at this ⊢; rw [pow_succ] at this; linarith
    rw [if_neg this]; push_cast; ring
  · rw [min_eq_right h, min_eq_right (by omega : Nat.log 2 x ≤ k + 1)]
    have h1 : x < 2 ^ (Nat.log 2 x + 1) := Nat.lt_pow_succ_log_self (by norm_num) x
    have : (x : ℤ) - 2 * ((2 ^ Nat.log 2 x : ℕ) : ℤ) < 0 := by
      have : (x : ℤ) < ((2 ^ (Nat.log 2 x + 1) : ℕ) : ℤ) := by exact_mod_cast h1
      push_cast at this ⊢; rw [pow_succ] at this; linarith
    rw [if_pos this]

end J6Seg.PJ

end

