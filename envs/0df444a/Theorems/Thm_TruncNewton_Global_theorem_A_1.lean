-- title:
--   Theorem A.1 — conjugate-gradient relations
-- statement:
--   Let $H$ be a self-adjoint operator on Euclidean $\mathbb R^n$, let $g$ be a vector, and run the paper's conjugate-gradient recurrence. If $\varepsilon>0$ and $\langle d_i,Hd_i\rangle>\varepsilon\delta_i$ for every $0\le i\le k$, then the relations (A.2)–(A.7) hold: the directions are $H$-conjugate; earlier directions are orthogonal to later residuals; $\langle r_i,d_j\rangle=\|r_j\|^2=\langle r_0,d_j\rangle$ for $i\le j\le k$; the directions through $k$ span the Krylov space generated by $g,Hg,\ldots,H^kg$; $p_{k+1}$ minimizes
--
--   $$\phi(q)=\langle g,q\rangle+\tfrac12\langle q,Hq\rangle$$
--
--   over that span; and $\delta_i=\|d_i\|^2$ through $k$. These identities underpin the descent and bounded-direction estimates.
--
--   **Formalization Note** The printed (A.5) ends at $H^{k-1}g$, an indexing slip: its left side has $k+1$ vectors, and the consistent Krylov span ends at $H^kg$.
-- source:
--   Dembo and Steihaug, Truncated-Newton algorithms for large-scale unconstrained optimization, Math. Programming 26 (1983), p. 206, Theorem A.1, (A.1)–(A.7), https://doi.org/10.1007/BF02592055

import Mathlib
import Definitions.Def_TruncNewton_Global_Setting

namespace TruncNewton.Global

theorem theorem_A_1 {n : ℕ} (H : E n →L[ℝ] E n) (hH : IsSelfAdjoint H)
    (g : E n) (ε : ℝ) (hε : 0 < ε) (k : ℕ)
    (hcurv : ∀ i ≤ k, ε * (cg H g i).δ < inner ℝ (cg H g i).d (H (cg H g i).d)) :
    (∀ i j, i ≤ k → j ≤ k → i ≠ j →
      inner ℝ (cg H g i).d (H (cg H g j).d) = 0) ∧
    (∀ i j, i < j → j ≤ k + 1 →
      inner ℝ (cg H g i).d (cg H g j).r = 0) ∧
    (∀ i j, i ≤ j → j ≤ k →
      inner ℝ (cg H g i).r (cg H g j).d = inner ℝ (cg H g j).r (cg H g j).r ∧
      inner ℝ (cg H g j).r (cg H g j).r = inner ℝ (cg H g 0).r (cg H g j).d) ∧
    Submodule.span ℝ ((fun i : ℕ => (cg H g i).d) '' Set.Iic k) =
      Submodule.span ℝ ((fun i : ℕ => (H ^ i) g) '' Set.Iic k) ∧
    ((cg H g (k + 1)).p ∈ Submodule.span ℝ ((fun i : ℕ => (cg H g i).d) '' Set.Iic k) ∧
      ∀ q ∈ Submodule.span ℝ ((fun i : ℕ => (cg H g i).d) '' Set.Iic k),
        phi H g (cg H g (k + 1)).p ≤ phi H g q) ∧
    (∀ i ≤ k, (cg H g i).δ = inner ℝ (cg H g i).d (cg H g i).d) := by sorry

end TruncNewton.Global
