    (γ : SL(2, ℤ)) (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') (ℓ : CuspidalType.ProjLine q) (s : ↥W)
    (P : Place Qbar ↥(fieldBar q M')) :
