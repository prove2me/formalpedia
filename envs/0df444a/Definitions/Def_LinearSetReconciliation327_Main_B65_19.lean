theorem rootOutputProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
