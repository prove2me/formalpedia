section Residuals

variable {F b A : ℝ → ℝ} (hF : ContDiffAt ℝ ∞ F 0) (hb : ContDiffAt ℝ ∞ b 0)
  (hA : ContDiffAt ℝ ∞ A 0) (h Q J : ℝ)
