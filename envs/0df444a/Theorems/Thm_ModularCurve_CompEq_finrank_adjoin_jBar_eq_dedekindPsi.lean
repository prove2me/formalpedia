-- title:
--   Degree ψ(N) of the level-N function field over ℚ̄(j)
-- statement:
--   Let $N$ be a positive natural number. Inside the field $\mathrm{LaurentSeries}(\mathbb{Q})$ let `modularFunctionFieldFull N` be the subfield generated over $\mathbb{Q}$ by the set `divisorExpansions N`, and let $\bar{\mathbb{Q}}$ denote `AlgebraicClosure ℚ`. The field `modularFunctionFieldBar N` is the base change `laurentBaseChange`, that is, the intermediate field of $\mathrm{LaurentSeries}(\bar{\mathbb{Q}})$ over $\bar{\mathbb{Q}}$ generated by the image of `modularFunctionFieldFull N` under the coefficientwise map `coeffEmb` induced by $\mathbb{Q} \to \bar{\mathbb{Q}}$. The element `jBar N` of this field is the image under `coeffEmb` of the Laurent series `jq`. The assertion is that the $\bar{\mathbb{Q}}$-intermediate field of `modularFunctionFieldBar N` generated by the single element `jBar N` has the property that `modularFunctionFieldBar N` is a module over it of rank `Module.finrank` equal to `dedekindPsi N`, where `dedekindPsi N` is defined as the sum of $N/d$ over the squarefree divisors $d$ of $N$ (so $N\prod_{p \mid N}(1 + p^{-1})$).
--
--   This is the classical computation of the degree $[\,\bar{\mathbb{Q}}(j, j_N) : \bar{\mathbb{Q}}(j)\,] = \psi(N)$, the index of $\Gamma_0(N)$ in $\mathrm{SL}_2(\mathbb{Z})$ up to the usual normalisation, in the form needed for the function field of $X_0(N)$ over an algebraically closed constant field. It is the numerical input to the count of places of this function field above a given value of $j$, and is used in the analysis of the characteristic-$p$ models and fibres of the modular curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_CompEq_finrank_adjoin_jBar_eq_dedekindPsi.lean

import Definitions.Def_ModularCurve_MazurStepThreeInputs
import Mathlib.FieldTheory.Relrank
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem ModularCurve.CompEq.finrank_adjoin_jBar_eq_dedekindPsi (N : ℕ) [NeZero N] :
    Module.finrank
      (IntermediateField.adjoin (AlgebraicClosure ℚ)
        ({(jBar N : modularFunctionFieldBar N)} : Set (modularFunctionFieldBar N)))
      (modularFunctionFieldBar N) = dedekindPsi N := by sorry
