variable (D ℓ K : ℕ) (long : Fin D → Bool)
theorem solution {q x y : ℕ} (hx : x < D * q) (hy : y < D * q) (h : NLogN.KFV.srcT D q x = NLogN.KFV.srcT D q y) :
    x = y := by
  unfold NLogN.KFV.srcT at h
  have hD : 0 < D := Nat.pos_of_ne_zero (by rintro rfl; simp at hx)
  have hx1 : x / D < q := by rw [Nat.div_lt_iff_lt_mul hD]; rwa [Nat.mul_comm]
  have hy1 : y / D < q := by rw [Nat.div_lt_iff_lt_mul hD]; rwa [Nat.mul_comm]
  have e1 : x / D = y / D := by
    have := congrArg (· % q) h
    simp only [Nat.mul_comm _ q, Nat.mul_add_mod, Nat.mod_eq_of_lt hx1, Nat.mod_eq_of_lt hy1] at this
    exact this
  have e2 : x % D = y % D := by
    have hq : 0 < q := Nat.pos_of_ne_zero (by rintro rfl; simp at hx)
    have := congrArg (· / q) h
    simp only [Nat.mul_comm _ q] at this
    rw [Nat.mul_add_div hq, Nat.mul_add_div hq, Nat.div_eq_of_lt hx1, Nat.div_eq_of_lt hy1] at this
    simpa using this
  rw [← Nat.div_add_mod x D, ← Nat.div_add_mod y D, e1, e2]
end
