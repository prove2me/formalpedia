-- title:
--   The IALM iteration: the function $h_k$ and the relations (32a), (32b), (33)
-- statement:
--   Given $z^k$ and $v^k$, let
--   $$
--   h_k(w,u):=f(w)+\frac\mu2\|w-v^k\|^2+\langle z^k,Aw+b-u\rangle+\frac\rho2\|Aw+b-u\|^2 .
--   $$
--
--   A sequence $\{(w^k;u^k;z^k;v^k)\}_{k\in\mathbb N}$, with positive tolerances $\{\epsilon_k\}$ and $\alpha=1/\rho$, is an **IALM sequence satisfying the stopping criteria (32)** if for every $k$:
--
--   1. $\mathcal V_{\rho,\mu}(w^{k+1},u^{k+1},z^k,v^k)\le\mathcal V_{\rho,\mu}(w^k,u^k,z^k,v^k)$; (32a)
--   2. $\max\{\mathrm{dist}(u^{k+1},\mathrm{Prox}_{\alpha\lambda\|(\cdot)_+\|_0}(u^{k+1}-\alpha\nabla_uh_k(w^{k+1},u^{k+1}))),\ \|\nabla_wh_k(w^{k+1},u^{k+1})\|\}\le\epsilon_k$; (32b)
--   3. $z^{k+1}=z^k+\rho(Aw^{k+1}+b-u^{k+1})$; (33)
--   4. $v^{k+1}=w^{k+1}$.
--
--   The initial point $(w^0;u^0;z^0;v^0)$ is arbitrary. Algorithm 1 obtains $(w^{k+1};u^{k+1})$ as an approximate minimizer of $\mathcal V_{\rho,\mu}(\cdot,\cdot,z^k,v^k)$.
--
--   **Formalization Note** The predicate records the relations above and not how the primal step is computed, so it covers every sequence the paper's inner solver 0/1-BALM produces. The gradients are Mathlib's `gradient` of the partial functions of $h_k$; a verification file proves that they agree with the closed forms (34). The distance is `Metric.infDist`.
-- source:
--   Zhang & Xiu, Global Convergence of Inexact Augmented Lagrangian Method for Zero-One Composite Optimization, arXiv:2112.00440v1, Algorithm 1, displays (32a), (32b), (33), p.13

import Mathlib
import Definitions.Def_ZeroOneIALM_Prox
import Definitions.Def_ZeroOneIALM_Lyapunov

namespace ZeroOneIALM

variable {p n : ℕ}

/-- The function `h_k(w, u)`, Zhang & Xiu, arXiv:2112.00440v1, p.13, with `zk = zᵏ` and `vk = vᵏ`:
`f(w) + (μ/2)‖w - vᵏ‖² + ⟨zᵏ, Aw + b - u⟩ + (ρ/2)‖Aw + b - u‖²`. -/
noncomputable def hk (f : EuclideanSpace ℝ (Fin p) → ℝ)
    (A : EuclideanSpace ℝ (Fin p) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (b : EuclideanSpace ℝ (Fin n)) (ρ μ : ℝ)
    (zk : EuclideanSpace ℝ (Fin n)) (vk : EuclideanSpace ℝ (Fin p))
    (w : EuclideanSpace ℝ (Fin p)) (u : EuclideanSpace ℝ (Fin n)) : ℝ :=
  f w + μ / 2 * ‖w - vk‖ ^ 2 + inner ℝ zk (A w + b - u) + ρ / 2 * ‖A w + b - u‖ ^ 2

/-- The partial gradient `∇_w h_k(w, u)`, arXiv:2112.00440v1, p.13. -/
noncomputable def gradWhk (f : EuclideanSpace ℝ (Fin p) → ℝ)
    (A : EuclideanSpace ℝ (Fin p) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (b : EuclideanSpace ℝ (Fin n)) (ρ μ : ℝ)
    (zk : EuclideanSpace ℝ (Fin n)) (vk : EuclideanSpace ℝ (Fin p))
    (w : EuclideanSpace ℝ (Fin p)) (u : EuclideanSpace ℝ (Fin n)) :
    EuclideanSpace ℝ (Fin p) :=
  gradient (fun w' => hk f A b ρ μ zk vk w' u) w

/-- The partial gradient `∇_u h_k(w, u)`, arXiv:2112.00440v1, p.13. -/
noncomputable def gradUhk (f : EuclideanSpace ℝ (Fin p) → ℝ)
    (A : EuclideanSpace ℝ (Fin p) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (b : EuclideanSpace ℝ (Fin n)) (ρ μ : ℝ)
    (zk : EuclideanSpace ℝ (Fin n)) (vk : EuclideanSpace ℝ (Fin p))
    (w : EuclideanSpace ℝ (Fin p)) (u : EuclideanSpace ℝ (Fin n)) :
    EuclideanSpace ℝ (Fin n) :=
  gradient (fun u' => hk f A b ρ μ zk vk w u') u

/-- `(wᵏ; uᵏ; zᵏ; vᵏ)` is a sequence generated by IALM satisfying the stopping criteria (32),
Algorithm 1, Zhang & Xiu, arXiv:2112.00440v1, p.13, with `α = 1/ρ`: the tolerances are positive, and
for every `k` the relations (32a), (32b), (33) and `vᵏ⁺¹ = wᵏ⁺¹` hold. The initial data
`(w⁰; u⁰; z⁰; v⁰)` are arbitrary.

**Formalization Note.** `dist` in (32b) is `Metric.infDist`. It is `0` on the empty set, but the
prox is never empty (`proximal_behavior`). How `(wᵏ⁺¹; uᵏ⁺¹)` is computed is not recorded: every
sequence with these relations counts, which covers the sequences the paper produces with 0/1-BALM.
`f` is assumed differentiable wherever this predicate is used, so the gradients are genuine. -/
structure IsIALMRun (f : EuclideanSpace ℝ (Fin p) → ℝ)
    (A : EuclideanSpace ℝ (Fin p) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (b : EuclideanSpace ℝ (Fin n)) (lam μ ρ : ℝ) (ε : ℕ → ℝ)
    (w : ℕ → EuclideanSpace ℝ (Fin p)) (u : ℕ → EuclideanSpace ℝ (Fin n))
    (z : ℕ → EuclideanSpace ℝ (Fin n)) (v : ℕ → EuclideanSpace ℝ (Fin p)) : Prop where
  /-- The positive sequence `{εₖ}` of the initialization. -/
  eps_pos : ∀ k, 0 < ε k
  /-- Display (32a). -/
  descent : ∀ k, lyapunov f A b lam ρ μ (w (k + 1)) (u (k + 1)) (z k) (v k) ≤
    lyapunov f A b lam ρ μ (w k) (u k) (z k) (v k)
  /-- Display (32b). -/
  stopping : ∀ k,
    max
      (Metric.infDist (u (k + 1))
        (proxVec lam (1 / ρ)
          (u (k + 1) - (1 / ρ) • gradUhk f A b ρ μ (z k) (v k) (w (k + 1)) (u (k + 1)))))
      ‖gradWhk f A b ρ μ (z k) (v k) (w (k + 1)) (u (k + 1))‖ ≤ ε k
  /-- Display (33), the multiplier step. -/
  multiplier : ∀ k, z (k + 1) = z k + ρ • (A (w (k + 1)) + b - u (k + 1))
  /-- The Lyapunov step. -/
  lyapunov_step : ∀ k, v (k + 1) = w (k + 1)

end ZeroOneIALM


