theorem IntMul.Kappa.R6.Bit.levelH_correct (hOK : C.OK N) {child : ℕ × ℕ × ℕ → List R → List R}
    (hch : ChildOKH (R := R) (m := m) N P L' A B Cs child) {xs : List R}
    (_hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    levelH C N P L' A B Cs child xs =
      pull (P :: W * L' :: hdShape A B Cs m N) (P :: W * L' :: hdShape A B Cs m N)
        (blockSwap (A.length + 2) (A.length + B.length + m + 2) m) 0 xs := by sorry
