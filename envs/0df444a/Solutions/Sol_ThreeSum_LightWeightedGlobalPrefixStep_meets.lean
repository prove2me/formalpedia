theorem _root_.solution {X : Inputs} {C : Config} [Fact C.p.Prime] {D : Family C} {lim : Limits}
    {depth K R S n U dB dC dP tB tC tP newSpan seedTime : ℕ} {raws : List ℤ} {words maps : List ℕ} (μ : ℕ → ℤ)
    (H : PrepareReady X lim (depth + 1) μ) (hprime : X.p = C.p) (hJ : X.J = C.J)
    (plans :
      ∀ ν, Prepared X μ ν → FullPlan C D lim (depth + 1) K R S n U dB dC dP tB tC tP newSpan seedTime raws words maps ν)
    (A : LightWeightedGlobalPrefixFinish.Layout C lim X.seed (X.power * X.p) newSpan)
    (hheader :
      ∀ ν, Prepared X μ ν → Seg ν X.seed (LightWeightedGlobalPrefixFinish.header C n dB dC dP tB tC tP newSpan))
    (hfinal :
      ∀ ν,
        ∀ h : Prepared X μ ν,
          ∀ ξ,
            (plans ν h).finalState ξ →
              Seg ξ X.seed (LightWeightedGlobalPrefixFinish.header C n dB dC dP tB tC tP newSpan)) :
    Meets lim (program C.p R S K raws words maps D.xl D.yl D.zl D.xr D.yr D.zr) 192 depth X.argv μ (time X C n seedTime)
      (fun r ω =>
        r = ((X.power * X.p : ℕ) : ℤ) ∧
          ∃ ν,
            ∃ h : Prepared X μ ν,
              ∃ ξ,
                (plans ν h).finalState ξ ∧
                  LightWeightedGlobalPrefixFinish.Committed C (X.power * X.p) newSpan ξ ω ∧
                    Seg ω X.seed (LightWeightedGlobalPrefixFinish.header C n dB dC dP tB tC tP newSpan)) :=
  by
  have L := program_library C.p R S K raws words maps D.xl D.yl D.zl D.xr D.yr D.zr
  have hp := H.run L
  have hd := H.depthBound
  apply Meets.of_body L.step
  rw [LightWeightedGlobalPrefixFinish.step_eq]
  unfold time
  focus
    ((first
        | refine _root_.Light.Ends.seqSelf ?_
        | refine _root_.Light.Ends.skipLast ?_);
      (repeat
          with_unfolding_none
            first
            | refine _root_.Light.Ends.seqAssoc ?_
            | refine _root_.Light.Ends.skipThen ?_))
    first
    | refine _root_.Light.Ends.callToThen (hp _ (by omega)) ?_ ?_ ?_ ?_
    | refine _root_.Light.Ends.callToThen hp ?_ ?_ ?_ ?_
    on_goal -1 =>
      first
      | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost, _root_.List.map_cons,
            _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, Inputs.argv, stepArgs]
          first
          | omega
          | (ring_nf; omega))
      | omega
      |
        (simp [Inputs.argv, stepArgs] <;> first
            | omega
            | (ring_nf; omega))
    on_goal -1 => omega
    on_goal -1 =>
      ( (try have := _root_.Light.Std.space_le (by assumption))
        (try have := _root_.Light.Std.const_le (by assumption))
        simp [_root_.Light.Limits.Addr, _root_.abs_le, -_root_.abs_mul, Inputs.argv, stepArgs] <;> omega)
    on_goal -1 => (rintro rows ν ⟨hrows, hprepared⟩; try with_unfolding_none refine _root_.Light.Ends.skip ?_)
  have hf :=
    LightWeightedGlobalPrefixFinish.ends (setLocal X.argv 19 rows) ν (plans ν hprepared) A
      (by simp [Inputs.argv, stepArgs, frame_setLocal]) (by simp [Inputs.argv, stepArgs, frame_setLocal, hJ])
      (by change frame (setLocal X.argv 19 rows) 19 = ((X.power * X.p : ℕ) : ℤ); rw [frame_setLocal]; simpa using hrows)
      (hheader ν hprepared) (hfinal ν hprepared)
  apply
    hf.mono
      (by
        first
        | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost,
              _root_.List.map_cons, _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil,
              LightWeightedGlobalPrefixFinish.time]
            first
            | omega
            | (ring_nf; omega))
        | omega
        |
          (simp [LightWeightedGlobalPrefixFinish.time] <;> first
              | omega
              | (ring_nf; omega)))
  intro σ hσ
  exact ⟨hσ.1, ν, hprepared, hσ.2⟩
end ThreeSum.LightWeightedGlobalPrefixStep
