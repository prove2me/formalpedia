/-!
# B5-J math, part 2: loop forms of the `J`-table quantities

* `sum_flat`: a double sum over `u < n`, `j < m` as one sum over `x < n m` (`x / m`, `x % m`).
* `sum_Hset`: the coupling-offset sum as a sum over `j < 2w + 1` with the test `hc`.
* `TsumI_range`, `TinvI_eq`, `capI_flat`, `ccOf_flat`: the forms the IL loops compute.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Finset

namespace J6Seg

theorem sum_Hset {M : Type*} [AddCommMonoid M] (B : Blocks) (i : ℕ) (g : ℤ → M) :
    ∑ h ∈ Hset B i, g h = ∑ j ∈ range (2 * B.w + 1), if hcT B i j then g ((j : ℤ) - B.w) else 0 := by
  unfold Hset
  rw [Finset.sum_filter, Finset.sum_image (fun x _ y _ h => by simpa using h)]
  rfl

theorem ccOf_flat (T : Tables) (B : Blocks) (L : List ℕ) (K r i : ℕ) :
    ccOf T B L K r i = ∑ j ∈ range (2 * B.w + 1),
      if hcT B (L.getD r 0) j ∧ col B.s (L.getD r 0) ((j : ℤ) - B.w) = L.getD (qOf L K r i) 0
      then T.cpl (L.getD r 0) ((j : ℤ) - B.w) else 0 := by
  unfold ccOf
  rw [sum_Hset]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  split_ifs <;> simp_all

end J6Seg

end

