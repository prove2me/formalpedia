    z.2.rank < s.rank := by
  have hv := TypeDensity.Tests.children_valid s hs P hP z hz
  have hle : z.2.degree ≤ s.degree := calc
    z.2.degree ≤ z.1 * z.2.degree := Nat.le_mul_of_pos_left _ (TypeDensity.Tests.children_fst_pos s P z hz)
    _ ≤ ((TypeDensity.children s P).map fun z ↦ z.1*z.2.degree).sum :=
      List.single_le_sum (fun _ _ ↦ Nat.zero_le _) _ (List.mem_map.2 ⟨z, hz, rfl⟩)
    _ = s.degree := TypeDensity.Tests.children_degree_sum s P hP
