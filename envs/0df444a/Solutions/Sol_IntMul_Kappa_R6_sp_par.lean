theorem d_count6 (P : Prm) (hP : P.Ok) (a c : ℕ) (hc : 0 < c) (hε : P.ε = (a : ℝ) / c) (n : ℕ) :
    dP6 P n = Nat.findGreatest (fun x => x ^ c ≤ bP6 n ^ a) (bP6 n) := by
  set b := bP6 n
  set y := (b : ℝ) ^ P.ε with hy
  have hy0 : 0 ≤ y := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hyc : y ^ c = (b : ℝ) ^ a := by
    rw [hy, hε, ← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg _),
      div_mul_cancel₀ _ (by exact_mod_cast hc.ne'), Real.rpow_natCast]
  have key : ∀ x : ℕ, (x : ℝ) ≤ y ↔ x ^ c ≤ b ^ a := by
    intro x
    rw [← pow_le_pow_iff_left₀ (Nat.cast_nonneg _) hy0 hc.ne', hyc]
    exact_mod_cast Iff.rfl
  symm
  rw [Nat.findGreatest_eq_iff]
  refine ⟨d_le_b P hP n, fun h0 => ?_, fun k hk hkb => ?_⟩
  · exact (key _).1 (Nat.floor_le hy0)
  · intro hk'
    have := Nat.le_floor ((key k).2 hk')
    have e : dP6 P n = ⌊y⌋₊ := rfl
    omega

theorem L_count6 (P : Prm) (n : ℕ) (hL1 : 1 ≤ LP6 P n) (hLb : LP6 P n ≤ bP6 n) :
    LP6 P n = Nat.findGreatest (fun x => 2 ^ (x - 1) * b'P6 P n < 4 * n) (bP6 n) := by
  symm
  rw [Nat.findGreatest_eq_iff]
  refine ⟨hLb, fun _ => ?_, fun k hk hkb => ?_⟩
  · have := Nat.find_min (LP6_exists P n) (m := LP6 P n - 1)
      (show LP6 P n - 1 < Nat.find (LP6_exists P n) from by
        have : LP6 P n = Nat.find (LP6_exists P n) := rfl
        omega)
    push Not at this; exact this
  · simp only [not_lt]
    calc 4 * n ≤ 2 ^ LP6 P n * b'P6 P n := Nat.find_spec (LP6_exists P n)
      _ ≤ 2 ^ (k - 1) * b'P6 P n :=
        Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega))

theorem α2_le (P : Prm) (n : ℕ) : α2P6 P n ≤ b'P6 P n := by
  unfold α2P6 pP6
  rcases Nat.eq_zero_or_pos (dP6 P n) with h | h
  · rw [h]; simp
  · calc 6 * b'P6 P n / (48 * dP6 P n) ≤ 6 * b'P6 P n / 48 := Nat.div_le_div_left (by omega) (by norm_num)
      _ ≤ b'P6 P n := by omega

theorem α_count6 (P : Prm) (n : ℕ) :
    αN6 P n = Nat.findGreatest (fun x => x * x ≤ α2P6 P n) (b'P6 P n) := by
  symm
  rw [Nat.findGreatest_eq_iff]
  have hsq := Nat.sqrt_le' (α2P6 P n)
  refine ⟨le_trans (Nat.sqrt_le_self _) (α2_le P n), fun _ => ?_, fun k hk _ => ?_⟩
  · unfold αN6; rw [← pow_two]; exact hsq
  · intro hk'
    have := Nat.le_sqrt.2 hk'
    unfold αN6 at hk; omega

/-- Downward-closed counts. -/
theorem dc_d (c a b : ℕ) : ∀ x y, 1 ≤ x → x ≤ y → y ^ c ≤ b ^ a → x ^ c ≤ b ^ a :=
  fun x y _ hxy h => le_trans (Nat.pow_le_pow_left hxy c) h

theorem dc_L (b' N : ℕ) : ∀ x y, 1 ≤ x → x ≤ y → 2 ^ (y - 1) * b' < N → 2 ^ (x - 1) * b' < N :=
  fun x y _ hxy h => lt_of_le_of_lt (Nat.mul_le_mul_right _
    (Nat.pow_le_pow_right (by norm_num) (by omega))) h

theorem dc_α (X : ℕ) : ∀ x y, 1 ≤ x → x ≤ y → y * y ≤ X → x * x ≤ X :=
  fun x y _ hxy h => le_trans (Nat.mul_le_mul hxy hxy) h

end

end IntMul.Kappa.R6

