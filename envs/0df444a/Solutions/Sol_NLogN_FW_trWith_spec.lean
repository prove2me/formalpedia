  | zero =>
    simp only [radixSort, List.range_zero, List.foldl_nil, SortedMod, pow_zero, Int.emod_one]
    exact List.Pairwise.imp (fun _ => le_refl _) (List.pairwise_of_forall (fun _ _ => trivial))
  | succ kb ih =>
    rw [radixSort_succ]
    exact radixPass_sorted kb _ (fun r hr => hn r ((radixSort_perm kb L).subset hr)) ih

/-- Radix sort of records whose keys `σ p` form a permutation of `0, …, N-1` (with inverse `τ`)
puts the record with key `q` at position `q`. -/
theorem radixSort_keys (kb N : ℕ) (σ τ : ℕ → ℕ) (d : ℕ → List ℤ) (hN : N ≤ 2 ^ kb)
    (hσ : ∀ p < N, σ p < N) (hτ : ∀ q < N, τ q < N) (hστ : ∀ q < N, σ (τ q) = q)
    (hτσ : ∀ p < N, τ (σ p) = p) :
    radixSort kb ((List.range N).map fun p => (σ p : ℤ) :: d p) =
      (List.range N).map fun (q : ℕ) => (q : ℤ) :: d (τ q) := by
  set R := (List.range N).map fun p => (σ p : ℤ) :: d p with hR
  set L' := radixSort kb R
  have hp : L'.Perm R := radixSort_perm kb R
  have hmemR : ∀ r ∈ R, ∃ p < N, r = (σ p : ℤ) :: d p := by
    intro r hr; simp only [hR, List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr; exact ⟨p, hp, rfl⟩
  have hn : ∀ r ∈ R, 0 ≤ key r := by
    intro r hr; obtain ⟨p, _, rfl⟩ := hmemR r hr; simp [key]
  have hs := radixSort_sorted kb R hn
  -- the keys of `L'` are sorted
  have hks : (L'.map key).Pairwise (· ≤ ·) := by
    rw [List.pairwise_map]
    refine hs.imp_of_mem ?_
    intro a b ha hb hab
    obtain ⟨p, hpN, rfl⟩ := hmemR a (hp.subset ha)
    obtain ⟨p', hpN', rfl⟩ := hmemR b (hp.subset hb)
    have e1 : ((σ p : ℤ)) % 2 ^ kb = σ p :=
      Int.emod_eq_of_lt (by positivity) (by have := hσ p hpN; exact_mod_cast (by omega : σ p < 2 ^ kb))
    have e2 : ((σ p' : ℤ)) % 2 ^ kb = σ p' :=
      Int.emod_eq_of_lt (by positivity) (by have := hσ p' hpN'; exact_mod_cast (by omega : σ p' < 2 ^ kb))
    simp only [key, List.headD_cons] at hab ⊢
    rw [e1, e2] at hab; exact hab
  -- the key list of `R` is a permutation of `0, …, N-1`
  have hperm : ((List.range N).map σ).Perm (List.range N) := by
    rw [List.perm_ext_iff_of_nodup]
    · intro q
      simp only [List.mem_map, List.mem_range]
      constructor
      · rintro ⟨p, hpN, rfl⟩; exact hσ p hpN
      · intro hq; exact ⟨τ q, hτ q hq, hστ q hq⟩
    · refine List.Nodup.map_on ?_ List.nodup_range
      intro x hx y hy hxy
      simp only [List.mem_range] at hx hy
      rw [← hτσ x hx, ← hτσ y hy, hxy]
    · exact List.nodup_range
  have hkR : R.map key = ((List.range N).map σ).map (fun q : ℕ => (q : ℤ)) := by
    simp [hR, key, Function.comp_def]
  have hkey : L'.map key = (List.range N).map (fun q : ℕ => (q : ℤ)) := by
    refine List.Perm.eq_of_pairwise (le := (· ≤ ·)) (fun a b _ _ h1 h2 => le_antisymm h1 h2) hks ?_ ?_
    · rw [List.pairwise_map]
      exact List.pairwise_lt_range.imp (fun h => by exact_mod_cast h.le)
    · exact (hp.map key).trans (by rw [hkR]; exact hperm.map _)
  have hlen : L'.length = N := by
    have := congrArg List.length hkey; simpa using this
  apply List.ext_getElem (by simp [hlen])
  intro q h1 h2
  have hq : q < N := by simpa using h2
  obtain ⟨p, hpN, hpe⟩ := hmemR _ (hp.subset (List.getElem_mem h1))
  have hk : key L'[q] = q := by
    have := congrArg (fun l => l[q]?) hkey
    simp only [List.getElem?_map, List.getElem?_eq_getElem h1, List.getElem?_range hq] at this
    simpa using this
  rw [hpe] at hk
  simp only [key, List.headD_cons, Nat.cast_inj] at hk
  rw [List.getElem_map, hpe]
  simp only [List.getElem_range]
  rw [← hk, hτσ p hpN]

