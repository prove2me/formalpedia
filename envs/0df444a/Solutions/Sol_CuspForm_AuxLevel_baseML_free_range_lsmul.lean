    rintro ⟨a, P, rfl⟩
    induction P using MvPolynomial.induction_on with
    | C a =>
      refine ⟨algebraMap 𝒪 _ a, Subtype.ext ?_⟩
      rw [AlgHom.commutes]
      show algebraMap 𝒪 (Module.End 𝒪 D.ML) a = Algebra.lsmul 𝒪 𝒪 D.ML (MvPolynomial.C a)
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
