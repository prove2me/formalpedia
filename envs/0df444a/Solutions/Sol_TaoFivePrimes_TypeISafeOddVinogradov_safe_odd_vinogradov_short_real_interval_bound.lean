theorem safe_odd_vinogradov_short_real_interval_bound
    (a q : ℕ) (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y)
    (hwidth : y - x ≤ 2 * (q : ℝ))
    (hq : 2 ≤ q) (haq : Nat.Coprime a q)
    (alpha beta theta A B : ℝ)
    (halpha : 2 * alpha = (a : ℝ) / (q : ℝ) + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (∑ n ∈ realOddInterval x y,
      safeCappedCosecant A B (Real.pi * alpha * (n : ℝ) + theta)) ≤
      2 * A + (2 / Real.pi) * B * (q : ℝ) *
        Real.log (4 * (q : ℝ)) := by
  classical
  let s : Finset ℕ := realOddInterval x y
  let C : ℝ := 2 * A + (2 / Real.pi) * B * (q : ℝ) *
    Real.log (4 * (q : ℝ))
  let f : ℕ → ℝ := fun n ↦
    safeCappedCosecant A B (Real.pi * alpha * (n : ℝ) + theta)
  have hqR : (2 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
  have hlog : 0 ≤ Real.log (4 * (q : ℝ)) :=
    Real.log_nonneg (by nlinarith)
  have hC : 0 ≤ C := by
    dsimp [C]
    positivity
  change (∑ n ∈ s, f n) ≤ C
  by_cases hse : s = ∅
