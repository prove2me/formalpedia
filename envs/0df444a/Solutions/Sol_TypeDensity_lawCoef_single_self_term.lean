  have hpos : 0 < (TypeDensity.State.single a n).degree := by rw [hdeg]; exact Nat.mul_pos ha (by omega)
  have hn1 : n - 1 < (TypeDensity.State.single a n).degree := by
    rw [hdeg]; have := Nat.le_mul_of_pos_left n ha; omega
  have hprob : (TypeDensity.divisorProbability (TypeDensity.State.single a n) P.d.val).rational
      = ((RatFunc.X : RatFunc ℚ) ^ TypeDensity.tri n)⁻¹ := by
    rw [hd, TypeDensity.rational_divisorProbability_single a n n]; simp
  have hf : ∀ b, (∏ j : Fin (TypeDensity.State.single a n).degree,
      ((Nat.factorial (P.other (b, j)).val : ℕ) : ℚ)) = 1 := fun b ↦
    Finset.prod_eq_one fun j _ ↦ by rw [hother]; split_ifs <;> simp
  have hcount : (TypeDensity.divisorCount 0 P.other).rational = (RatFunc.X : RatFunc ℚ) := by
