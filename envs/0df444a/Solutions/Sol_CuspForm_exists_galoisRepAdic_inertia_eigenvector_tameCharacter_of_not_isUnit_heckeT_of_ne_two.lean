            = quotEnd ρ.ρ I σ ((levelFactor ρ.V hle).toAddMonoidHom z)
        exact levelFactor_quotEnd ρ.V hle ρ.ρ σ z)
  exact ⟨H₂, i₂, j₂, hfin₂, hflat₂, hcocomm₂, e₂, he₂_add, he₂_act⟩

end FiniteQuotientModel
