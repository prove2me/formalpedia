theorem zsz_one : zsz 1 = 1 := by
  simp [zsz, zbits]; rw [nbits_pos (by norm_num)]; simp [nbits_zero]

theorem zsz_mono {a b : ℤ} (h : a.natAbs ≤ b.natAbs) : zsz a ≤ zsz b :=
  zsz_le_of_lt (lt_of_le_of_lt h (natAbs_lt_zsz b))

