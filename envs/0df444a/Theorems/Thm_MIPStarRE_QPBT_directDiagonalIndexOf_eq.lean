/-! ## The leading index of a direction -/

theorem MIPStarRE.QPBT.directDiagonalIndexOf_eq (D : _root_.MIPStarRE.QPBT.DirectLdParams)
    {v : Fin D.m → _root_.MIPStarRE.QPBT.DirectScalarQ D} {i : Fin D.m}
    (hzero : ∀ j : Fin D.m, j.val < i.val → v j = 0) (hi : v i ≠ 0) :
    _root_.MIPStarRE.QPBT.directDiagonalIndexOf D v = i := by sorry
