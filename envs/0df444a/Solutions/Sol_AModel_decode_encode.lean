section
open AModel
open Matrix
theorem solution {sh : AModel.Shape} {a : List ℕ} (h : AModel.Valid sh a) : AModel.decode sh (AModel.encode sh a) = a := by
  induction h with
  | nil => rfl
  | @cons x q as sh hx hr ih =>
    have he := AModel.encode_lt hr
    have hV : 0 < AModel.vol sh := by omega
    simp only [AModel.encode, List.headD_cons, List.tail_cons, AModel.decode]
    rw [show x * AModel.vol sh + AModel.encode sh as = AModel.encode sh as + AModel.vol sh * x by ring,
      Nat.add_mul_div_left _ _ hV, Nat.div_eq_of_lt he, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt he, ih, zero_add, Nat.mod_eq_of_lt hx]
end
