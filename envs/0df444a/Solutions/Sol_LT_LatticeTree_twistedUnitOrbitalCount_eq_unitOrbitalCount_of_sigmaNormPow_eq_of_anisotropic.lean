      = ⟨ι mu, ι ϖ ^ d⟩ := by
    apply QExt.toMat_injective_of_isUnit (Y.map ι) hoff
    rw [← QExt.rPN_toMat (Y.map ι) σS hZσ hτ hν δq n, ← hδq,
