-- Source module: Solutions.KFV11Kron
/-!
# KFV §15: the uniform pointwise Kronecker stage `kronU`

`kronU pM` multiplies two arrays of `N` records (`r` Gaussian integers each) record by record:
stack `0` holds `gflat zf ++ gflat zg ++ l`; afterwards it holds `gflat (kmulN r p ρ N zf zg) ++ l`,
where record `j` of `kmulN` is `kmul r p ρ` of records `j` of `zf` and `zg` (`KFV6Math`).

The code is fixed: the six record-product parameters sit on the frame stacks `50 … 55`
(`KFV10Rec`), `N` on the frame of `vRH` and `2Nr` on the frame of `vT`; the record loop is a unary
loop on the frame of `vZ` (`toUL`). **`kronU_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Records -/

/-- Record `j` (of length `r`) of an array. -/
def blk (r j : ℕ) (z : List GI) : List GI := (z.drop (j * r)).take r

/-- The first `k` record products. -/
def kmulN (r p ρ k : ℕ) (zf zg : List GI) : List GI :=
  (List.range k).flatMap fun j => kmul r p ρ (NLogN.KFV.blk r j zf) (NLogN.KFV.blk r j zg)

/-! ## Output bounds -/

/-! ## The stage -/

/-- **The uniform pointwise Kronecker stage.** -/
def kronU (pM : Fin Pp) : IStmt HS Pp :=
  .seq (fcode (NLogN.mvK 0 vA NLogN.KFV.vL (.reg NLogN.KFV.vT))) <|
  .seq (fcode (NLogN.mvK 0 NLogN.KFV.vB NLogN.KFV.vL (.reg NLogN.KFV.vT))) <|
  .seq (fcode (NLogN.mvK vA NLogN.KFV.vX NLogN.KFV.vL (.reg NLogN.KFV.vT))) <|
  .seq (fcode (NLogN.mvK NLogN.KFV.vB NLogN.KFV.vY NLogN.KFV.vL (.reg NLogN.KFV.vT))) <|
  .seq (KFC.toUL vRH vZ) <|
  .seq (.loop vZ isMk (.seq (.op (.unmark vZ)) (recU pM))) <|
  fcode (NLogN.mvK vO 0 NLogN.KFV.vL (.reg NLogN.KFV.vT))

/-- Its cost. -/
def cKron (N r p b ρ φ : ℕ) : ℕ :=
  4 * cLp (2 * (N * r)) (250 * (p + 4)) (zsz ((2 * (N * r) : ℕ) : ℤ)) + cUL N +
    (N * (1 + 2000 * cRec r p b (p + ρ) φ + 30) + 30) +
    cLp (2 * (N * r)) (250 * (b + 4)) (zsz ((2 * (N * r) : ℕ) : ℤ))

end NLogN.KFV

end

