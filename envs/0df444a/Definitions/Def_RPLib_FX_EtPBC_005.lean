/-!
# S4-EtPBC-A, M4(E), geometry part A: sections of etale maps, agreeing maps, generizations

* `isOpen_range_section`, `isClosed_range_section`: the image of a section of an etale (resp. separated) morphism is
  open (resp. closed);
* **`exists_opens_eq`**: two morphisms `α β : U ⟶ W` over `S` with `W ⟶ S` etale that agree after some `u : T ⟶ U`
  agree on an open neighbourhood of the image of `u`;
* **`mem_range_of_specializes`**: for a flat `p : B ⟶ A` and sections with closed images covering the fibre over
  `a₀`, the sections also cover the fibres over all specialisations of `a₀`;
* **`eq_of_specializes_of_etale`**: distinct points in a fibre of an etale morphism do not specialise to each other.
-/

set_option autoImplicit false

noncomputable section

open CategoryTheory Limits AlgebraicGeometry

namespace RamanujanPetersson.EtPBC.GenGeo

universe u

/-- The image of a section of an etale morphism is open. -/
theorem isOpen_range_section {A B : Scheme.{u}} (σ : A ⟶ B) (p : B ⟶ A) [Etale p] (h : σ ≫ p = 𝟙 A) :
    IsOpen (Set.range σ) := by
  have := RamanujanPetersson.EtSheaves.isOpenImmersion_of_section σ p h
  exact σ.isOpenEmbedding.isOpen_range

/-- The image of a section of a separated morphism is closed. -/
theorem isClosed_range_section {A B : Scheme.{u}} (σ : A ⟶ B) (p : B ⟶ A) [IsSeparated p] (h : σ ≫ p = 𝟙 A) :
    IsClosed (Set.range σ) := by
  have : IsClosedImmersion (σ ≫ p) := by rw [h]; infer_instance
  have := IsClosedImmersion.of_comp σ p
  exact σ.isClosedEmbedding.isClosed_range

/-- **Maps into an etale scheme agreeing on the image of `u` agree near it.** -/
theorem exists_opens_eq {S U W T : Scheme.{u}} (pU : U ⟶ S) (pW : W ⟶ S) [Etale pW] (α β : U ⟶ W)
    (hα : α ≫ pW = pU) (hβ : β ≫ pW = pU) (u : T ⟶ U) (hu : u ≫ α = u ≫ β) :
    ∃ O : U.Opens, Set.range u ⊆ (O : Set U) ∧ O.ι ≫ α = O.ι ≫ β := by
  let σα : U ⟶ pullback pW pU := pullback.lift α (𝟙 U) (by simp [hα])
  let σβ : U ⟶ pullback pW pU := pullback.lift β (𝟙 U) (by simp [hβ])
  have hσβ : σβ ≫ pullback.snd pW pU = 𝟙 U := pullback.lift_snd _ _ _
  have : IsOpenImmersion σβ := RamanujanPetersson.EtSheaves.isOpenImmersion_of_section σβ _ hσβ
  have huσ : u ≫ σα = u ≫ σβ := by
    apply pullback.hom_ext
    · simp only [Category.assoc, σα, σβ, pullback.lift_fst]; exact hu
    · simp only [Category.assoc, σα, σβ, pullback.lift_snd]
  refine ⟨σα ⁻¹ᵁ σβ.opensRange, ?_, ?_⟩
  · rintro _ ⟨t, rfl⟩
    have e := congrArg (fun φ : T ⟶ pullback pW pU => φ t) huσ
    simp only [Scheme.Hom.comp_apply] at e
    exact ⟨u t, e.symm⟩
  · have hr : Set.range ((σα ⁻¹ᵁ σβ.opensRange).ι ≫ σα) ⊆ Set.range σβ := by
      rintro _ ⟨t, rfl⟩
      have ht : (σα ⁻¹ᵁ σβ.opensRange).ι t ∈ ((σα ⁻¹ᵁ σβ.opensRange : U.Opens) : Set U) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨t, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact ht
    let h := IsOpenImmersion.lift σβ _ hr
    have hh : h ≫ σβ = (σα ⁻¹ᵁ σβ.opensRange).ι ≫ σα := IsOpenImmersion.lift_fac _ _ _
    have hσα : σα ≫ pullback.snd pW pU = 𝟙 U := pullback.lift_snd _ _ _
    have hσαf : σα ≫ pullback.fst pW pU = α := pullback.lift_fst _ _ _
    have hσβf : σβ ≫ pullback.fst pW pU = β := pullback.lift_fst _ _ _
    have hh' : h = (σα ⁻¹ᵁ σβ.opensRange).ι := by
      calc h = h ≫ σβ ≫ pullback.snd pW pU := by rw [hσβ, Category.comp_id]
        _ = (σα ⁻¹ᵁ σβ.opensRange).ι ≫ σα ≫ pullback.snd pW pU := by rw [← Category.assoc, hh, Category.assoc]
        _ = _ := by rw [hσα, Category.comp_id]
    calc (σα ⁻¹ᵁ σβ.opensRange).ι ≫ α = ((σα ⁻¹ᵁ σβ.opensRange).ι ≫ σα) ≫ pullback.fst pW pU := by
          rw [Category.assoc, hσαf]
      _ = (h ≫ σβ) ≫ pullback.fst pW pU := by rw [hh]
      _ = _ := by rw [Category.assoc, hσβf, hh']

/-- **Generizations and closed sections.** -/
theorem mem_range_of_specializes {A B : Scheme.{u}} (p : B ⟶ A) [Flat p] {ι : Type*} (σ : ι → (A ⟶ B))
    (hσ : ∀ i, IsClosed (Set.range (σ i))) (a₀ : A) (h₀ : ∀ b, p b = a₀ → ∃ i, b ∈ Set.range (σ i))
    (b : B) (hb : a₀ ⤳ p b) : ∃ i, b ∈ Set.range (σ i) := by
  obtain ⟨b', hb', hpb'⟩ := Flat.generalizingMap p hb
  obtain ⟨i, hi⟩ := h₀ b' hpb'
  exact ⟨i, hb'.mem_closed (hσ i) hi⟩

/-- **Points of one fibre of an etale morphism do not specialise to each other.** -/
theorem eq_of_specializes_of_etale {X Y : Scheme.{u}} (f : X ⟶ Y) [Etale f] {x x' : X} (h : x ⤳ x')
    (hf : f x = f x') : x = x' := by
  obtain ⟨o, ho, hos⟩ := (isDiscrete_iff_forall_mem_exists_isOpen.1 (f.isDiscrete_preimage_singleton (f x')))
    x' rfl
  have hx' : x' ∈ o ∩ f ⁻¹' {f x'} := by rw [hos]; rfl
  have hx : x ∈ o ∩ f ⁻¹' {f x'} := ⟨h.mem_open ho hx'.1, hf⟩
  rw [hos] at hx
  exact hx

end RamanujanPetersson.EtPBC.GenGeo

end

end

-- ===== S4.Def_RP_EtPBC_A_EFin =====
section

/-!
# S4-EtPBC-A, M4(E), EFin: geometric fibres of quasi-compact etale objects are finite

For `W : P.Etale` with `W.hom` quasi-compact and any `x : P`, the fibre of `geomPtAt x` over `W` is finite
(**`finite_fiber`**): a fibre point gives a `κ(x)`-algebra map from the global sections of the scheme-theoretic fibre
`W ×_P Spec κ(x)` (finite over `κ(x)`: etale and quasi-compact) to `Ω`, injectively.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact.Cech

universe u

variable {P : Scheme.{u}}

/-- **Geometric fibres of quasi-compact etale objects are finite.** -/
theorem finite_fiber (W : P.Etale) [QuasiCompact W.hom] (x : P) :
    Finite ((geomPtAt x).point.fiber.obj W) := by
  have hq0 : IsFinite (W.hom.fiberToSpecResidueField x) := inferInstance
  have hq : IsFinite (pullback.snd W.hom (P.fromSpecResidueField x)) := hq0
  have hA : IsAffine (pullback W.hom (P.fromSpecResidueField x)) :=
    isAffine_of_isAffineHom (pullback.snd W.hom (P.fromSpecResidueField x))
  let q := pullback.snd W.hom (P.fromSpecResidueField x)
  let κ := P.residueField x
  let Ω := SeparableClosure (P.residueField x)
  let B := Γ(pullback W.hom (P.fromSpecResidueField x), ⊤)
  let algK : κ ⟶ B := (Scheme.ΓSpecIso κ).inv ≫ q.appTop
  let alg : κ ⟶ CommRingCat.of Ω := CommRingCat.ofHom (algebraMap (P.residueField x) (SeparableClosure (P.residueField x)))
  let b : (geomPtAt x).point.fiber.obj W → (Spec (CommRingCat.of Ω) ⟶ pullback W.hom (P.fromSpecResidueField x)) :=
    fun a => pullback.lift (fl x a) (Spec.map alg) (by exact Over.w ((geomPtAt x).liftOf a))
  let ψ : (geomPtAt x).point.fiber.obj W → (B ⟶ CommRingCat.of Ω) :=
    fun a => (b a).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom
  have hψ : ∀ a, algK ≫ ψ a = alg := by
    intro a
    have e1 : b a ≫ q = Spec.map alg := pullback.lift_snd _ _ _
    have e2 : q.appTop ≫ (b a).appTop = (Spec.map alg).appTop := by
      rw [← Scheme.Hom.comp_appTop, e1]
    change (Scheme.ΓSpecIso κ).inv ≫ q.appTop ≫ (b a).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).hom = alg
    rw [← Category.assoc q.appTop, e2, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
  have hinj : Function.Injective ψ := by
    intro a a' h
    have h1 : (b a).appTop = (b a').appTop := by
      have := congrArg (· ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv) h
      simpa [ψ] using this
    have h2 : b a = b a' := ext_of_isAffine h1
    have e : ∀ c, b c ≫ pullback.fst W.hom (P.fromSpecResidueField x) = fl x c :=
      fun c => pullback.lift_fst _ _ _
    have h3 : fl x a = fl x a' :=
      (e a).symm.trans ((congrArg (· ≫ pullback.fst W.hom (P.fromSpecResidueField x)) h2).trans (e a'))
    exact fiber_ext _ h3
  let _ : Algebra κ B := algK.hom.toAlgebra
  have hfin : Module.Finite κ B := by
    have h1 : q.appTop.hom.Finite := q.finite_appTop
    have h2 : ((Scheme.ΓSpecIso κ).inv).hom.Finite :=
      RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso κ).inv).2
    have h3 : algK.hom.Finite := by
      change (q.appTop.hom.comp (Scheme.ΓSpecIso κ).inv.hom).Finite
      exact h1.comp h2
    exact h3
  let ψA : (geomPtAt x).point.fiber.obj W → (B →ₐ[κ] Ω) := fun a =>
    { toRingHom := (ψ a).hom
      commutes' := fun c => by
        have := congrArg (fun f => f.hom c) (hψ a)
        exact this }
  have hinjA : Function.Injective ψA := by
    intro a a' h
    refine hinj ?_
    apply CommRingCat.hom_ext
    exact congrArg AlgHom.toRingHom h
  exact Finite.of_injective ψA hinjA

end RamanujanPetersson.EtPBC.GenGeo

end

end

-- ===== S4.Def_RP_EtPBC_A_EGeoB =====
section

/-!
# S4-EtPBC-A, M4(E), EGeoB: a splitting neighbourhood of a geometric point and its sections

* `exists_common_nbhd`: finitely many etale neighbourhoods of `t` have a common affine refinement;
* `FibPts x W := Σ j, fibre of W j over x̄`, finite (`finite_fibPts`); **`exists_split`**: an affine `T` with a point
  `t` over `x̄` and maps `τ p : T ⟶ W p.1` sending `t` to `p.2`, for all `p : FibPts x W`;
* `exists_opens_unique`, `specializes_of_unique`: shrinking `T` so that `fpt t` is its only point over `x`; then every
  point of `T` over a specialisation of `x` is a specialisation of `fpt t`;
* `prd W T` (`W ×_P T`), `prW`, `prT`, `sec τ` (the section of `prT` given by `τ : T ⟶ W`), `pair a t`;
* **`exists_eq_tau`**: if every point of `W` over `x̄` is `τ b (t)` and `fpt t ⤳ fpt t'` (`t'` over `ȳ`), every point
  `a` of `W` over `ȳ` is `τ b (t')` for some `b`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech

universe u

variable {P : Scheme.{u}}

/-- The points of the `W j` over `x̄`. -/
abbrev FibPts (x : P) {J : Type u} (W : J → P.Etale) : Type u := Σ j, (geomPtAt x).point.fiber.obj (W j)

/-- If `fpt t` is the only point over `x`, every point over a specialisation of `x` specialises from it. -/
theorem specializes_of_unique (T : P.Etale) (x : P) (t : (geomPtAt x).point.fiber.obj T)
    (h : ∀ v, T.hom v = x → v = fpt x t) (v : T.left) (hv : x ⤳ T.hom v) : fpt x t ⤳ v := by
  obtain ⟨v', hv', hpv'⟩ := Flat.generalizingMap T.hom hv
  rw [← h v' hpv']
  exact hv'

section Prd

variable (W T : P.Etale)

/-- `W ×_P T` as an etale object. -/
def prd : P.Etale := Scheme.Etale.mk (pullback.snd W.hom T.hom ≫ T.hom)

variable {W T}

theorem liftOf_map {V V' : P.Etale} (g : V ⟶ V') (y : P) (b : (geomPtAt y).point.fiber.obj V) :
    ((geomPtAt y).liftOf ((geomPtAt y).point.fiber.map g b)).left = ((geomPtAt y).liftOf b).left ≫ g.left := rfl

end Prd

end RamanujanPetersson.EtPBC.GenGeo

end

end

-- ===== S4.Def_RP_EtPBC_A_EN =====
section

/-!
# S4-EtPBC-A, M4(E), EN: a splitting neighbourhood that kills the relations at the generic point

* `exists_generic_open`: a closed nonempty `Z` in a noetherian scheme has a point `η` and an open `V₀ ∋ η` with
  `V₀ ∩ Z ⊆ closure {η}`;
* `gsum f τ c := Σ c_p · τ_p^* (f p.1) ∈ G(T)`; `germ_gsum` (its germ at `t` is `rel W G f x c`); `gsum_comp`;
* **`exists_good`**: an etale `T` with a point `t` over `x̄`, maps `τ_p` sending `t` to `p`, such that every relation
  `c` of the `f j` at `x̄` has `gsum f τ c = 0` on all of `T`, and `fpt t` is the only point of `T` over `x`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech GenAlg

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}} (G : EtSh Λ P)

section Gsum

variable {x : P} {J : Type u} {W : J → P.Etale} (f : ∀ j, G.obj.obj (op (W j)))

theorem map_comp_fib {T' T V : P.Etale} (ρ : T' ⟶ T) (g : T ⟶ V) (t' : (geomPtAt x).point.fiber.obj T') :
    (geomPtAt x).point.fiber.map (ρ ≫ g) t' =
      (geomPtAt x).point.fiber.map g ((geomPtAt x).point.fiber.map ρ t') :=
  fiber_ext _ rfl

end Gsum

end RamanujanPetersson.EtPBC.GenGeo

end

end

-- ===== S4.Def_RP_EtPBC_A_H1FG =====
section

/-!
# S4-EtPBC-A, R2(c-e): degree-1 base change reduces to finitely generated subsheaves

* `ofSec_sc`: `ofSec (c(1)) = c` for `c : Λ_Y ⟶ F`;
* `presHom c`: the map of injective presentations `injPres A ⟶ injPres B` over `c : A ⟶ B`;
* **`exists_kill`**: for `X` compact with affine maps from affines, every `β ∈ Ext¹(Λ_X, ι^* G)` is killed by
  `ι^* (coker φ)` for some `φ : ∐ Λ[W x] ⟶ G` from finitely many affines (local lift of the class on one affine
  etale surjection `V ⟶ X`, its Cech coboundary on `V ×_X V`, `exists_fg_sec`, gluing in the presentation of
  `ι^* (coker φ)`);
* **`bcSurj_one_of_fgt`**: `BCSurj 1` for every sheaf on `P` from `BCSurj 1` for `FGT` sheaves.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite GrothendieckTopology Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtCompact.Supp RamanujanPetersson.EtCompact.PtSec

universe u

theorem ofSec_sc {Λ : Type u} [CommRing Λ] {Y : Scheme.{u}} {F : EtSh Λ Y} (c : unitSh Λ Y ⟶ F) :
    ofSec (sc c (etId Y)) = c := by
  rw [sc_homEquiv, ofSec, Equiv.symm_apply_eq]
  refine ModuleCat.hom_ext (LinearMap.ext_ring ?_)
  simp

theorem mono_kerι {C : Type*} [Category C] [Abelian C] {A B : C} (f : A ⟶ B) : Mono (kernel.ι f) := inferInstance

section Kill

variable {Λ : Type u} [CommRing Λ] {X P : Scheme.{u}} (ι : X ⟶ P)

/-- The map of injective presentations over `c : A ⟶ B`. -/
abbrev presHom {A B : EtSh Λ X} (c : A ⟶ B) : injPres A ⟶ injPres B where
  τ₁ := c
  τ₂ := Injective.factorThru (c ≫ Injective.ι B) (Injective.ι A)
  τ₃ := cokernel.map (Injective.ι A) (Injective.ι B) c (Injective.factorThru (c ≫ Injective.ι B) (Injective.ι A))
    (Injective.comp_factorThru _ _)
  comm₁₂ := (Injective.comp_factorThru _ _).symm
  comm₂₃ := (cokernel.π_desc _ _ _).symm

theorem presHom_τ₁ {A B : EtSh Λ X} (c : A ⟶ B) : (presHom c).τ₁ = c := rfl

end Kill

section Red

end Red

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_NagA =====
section

/-!
# S4-EtPBC-A, M4(N1): integral closures over a finite type domain over a perfect field (integrally closed case)

* `finite_of_comp_injective`: if `ι ∘ f` is finite, `ι` injective and the source noetherian, then `f` is finite;
* `iterateFrobenius_finite`: for a finite type algebra `A` over a perfect field, `a ↦ a ^ p ^ e` is finite;
* **`finite_integralClosure_of_isIntegrallyClosed`**: `A` a noetherian integrally closed domain of finite type over a
  perfect field, `L` finite over `Frac A` ⇒ the integral closure of `A` in `L` is a finite `A`-module (separable
  part: `IsIntegralClosure.finite`; inseparable part: Frobenius `b ↦ b ^ p ^ e` into the separable closure).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Nagata

open Polynomial

/-- **Finiteness descends along an injective map** (noetherian source). -/
theorem finite_of_comp_injective {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [IsNoetherianRing A]
    (f : A →+* B) (ι : B →+* C) (hι : Function.Injective ι) (h : (ι.comp f).Finite) : f.Finite := by
  let := f.toAlgebra
  let := (ι.comp f).toAlgebra
  have hC : Module.Finite A C := h
  let θ : B →ₗ[A] C :=
    { toFun := ι
      map_add' := ι.map_add
      map_smul' := fun a b => by
        simp only [RingHom.id_apply, Algebra.smul_def, map_mul]
        rfl }
  exact Module.Finite.of_injective θ hι

section Frob

variable (K : Type*) [Field K] (p : ℕ) [ExpChar K p] [PerfectRing K p] (A : Type*) [CommRing A] [Algebra K A]
  [Algebra.FiniteType K A] [ExpChar A p] (e : ℕ)

include K in
/-- **The iterated Frobenius of a finite type algebra over a perfect field is finite.** -/
theorem iterateFrobenius_finite : (iterateFrobenius A p e).Finite := by
  refine RingHom.IsIntegral.to_finite (fun x => ?_) ?_
  · refine ⟨X ^ (p ^ e) - C x, monic_X_pow_sub_C _ (pow_ne_zero e (expChar_pos K p).ne'), ?_⟩
    simp only [eval₂_sub, eval₂_X_pow, eval₂_C, iterateFrobenius_def, sub_self]
  · have h : (iterateFrobenius A p e).comp ((algebraMap K A).comp (iterateFrobeniusEquiv K p e).symm.toRingHom) =
        algebraMap K A := by
      ext k
      simp only [RingHom.comp_apply, iterateFrobenius_def, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [← map_pow, ← iterateFrobeniusEquiv_def, RingEquiv.apply_symm_apply]
    refine RingHom.FiniteType.of_comp_finiteType (f := (algebraMap K A).comp (iterateFrobeniusEquiv K p e).symm.toRingHom) ?_
    rw [h]
    exact RingHom.finiteType_algebraMap.2 inferInstance

end Frob

section N1

end N1

end RamanujanPetersson.EtPBC.Nagata

end

end

-- ===== S4.Def_RP_EtPBC_A_NagB =====
section

/-!
# S4-EtPBC-A, M4(N2): integral closures of finite type domains over a perfect field are finite

* `isLocalization_of_finite`: for a domain `D` integral over a domain `A ⊆ D`, `Frac D` is the localization of `D`
  at the image of `A⁰`;
* **`finite_integralClosure`**: `D` a domain of finite type over a perfect field `K`, `F = Frac D`, `L` finite over
  `F` ⇒ the integral closure of `D` in `L` is a finite `D`-module (Noether normalization + `NagA`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Nagata

/-- **`Frac D` is a localization of `D` at `A⁰`** when `D` is integral over `A ⊆ D`. -/
theorem isLocalization_of_finite (A D F : Type*) [CommRing A] [IsDomain A] [CommRing D] [IsDomain D]
    [Algebra A D] [Algebra.IsIntegral A D] (hinj : Function.Injective (algebraMap A D)) [Field F] [Algebra D F]
    [IsFractionRing D F] : IsLocalization (Algebra.algebraMapSubmonoid D (nonZeroDivisors A)) F := by
  refine ⟨?_, fun z => ?_, fun {x y} h => ⟨1, ?_⟩⟩
  · rintro ⟨_, a, ha, rfl⟩
    refine isUnit_iff_ne_zero.2 ?_
    rw [map_ne_zero_iff _ (IsFractionRing.injective D F), map_ne_zero_iff _ hinj]
    exact nonZeroDivisors.ne_zero ha
  · obtain ⟨⟨d, d'⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors D) z
    have hd' : (d' : D) ≠ 0 := nonZeroDivisors.ne_zero d'.2
    have hc := Ideal.comap_ne_bot_of_integral_mem hd' (Ideal.mem_span_singleton_self (d' : D))
      (Algebra.IsIntegral.isIntegral (R := A) (d' : D))
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hc
    obtain ⟨c, hc'⟩ := Ideal.mem_span_singleton'.1 (Ideal.mem_comap.1 ha)
    refine ⟨⟨d * c, ⟨algebraMap A D a, a, mem_nonZeroDivisors_of_ne_zero ha0, rfl⟩⟩, ?_⟩
    show z * algebraMap D F (algebraMap A D a) = algebraMap D F (d * c)
    rw [← hc', map_mul, map_mul, mul_comm (algebraMap D F c), ← mul_assoc, hz]
  · simp [IsFractionRing.injective D F h]

end RamanujanPetersson.EtPBC.Nagata

end

end

-- ===== S4.Def_RP_EtPBC_A_NagC =====
section

/-!
# S4-EtPBC-A, M4(N3): the relative normalization of a finite field point is finite

* `finite_integralClosure_of_gen`: `A` of finite type over a perfect field `K`, `F` a field generated (as a field)
  by the image of `A`, `L` finite over `F` ⇒ the integral closure of `A` in `L` is a finite `A`-module (via `NagB`
  for the domain `A ⧸ ker`);
* **`isFinite_fromNormalization`**: `X` locally of finite type over a perfect field, `y : X`, `φ : κ(y) ⟶ κ(ξ)` a
  finite extension ⇒ the relative normalization of `Spec κ(ξ) ⟶ Spec κ(y) ⟶ X` is finite over `X`.
-/

set_option autoImplicit false

noncomputable section

open CategoryTheory AlgebraicGeometry

namespace RamanujanPetersson.EtPBC.Nagata

universe u

/-- The residue field of a point on an affine open is generated by the sections. -/
theorem residue_gen {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) (y : X) (hy : y ∈ U)
    (x : X.residueField y) : ∃ a b : Γ(X, U), (X.presheaf.germ U y hy ≫ X.residue y) b ≠ 0 ∧
      x * (X.presheaf.germ U y hy ≫ X.residue y) b = (X.presheaf.germ U y hy ≫ X.residue y) a := by
  let : Algebra Γ(X, U) (X.presheaf.stalk y) := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hy⟩
  have := hU.isLocalization_stalk ⟨y, hy⟩
  obtain ⟨s, rfl⟩ := X.residue_surjective y x
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl s
  have hu : IsUnit (X.presheaf.germ U y hy b) := IsLocalization.map_units (M :=
    (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl) (X.presheaf.stalk y) b
  refine ⟨a, b, ?_, ?_⟩
  · exact (hu.map (X.residue y).hom).ne_zero
  · have := congrArg (X.residue y).hom hab
    rw [map_mul] at this
    exact this

end RamanujanPetersson.EtPBC.Nagata

namespace RamanujanPetersson.EtPBC.Nagata

universe v

variable {X : Scheme.{v}} (y : X) {T : Scheme.{v}} (ξ : T) (φ : X.residueField y ⟶ T.residueField ξ)

theorem appLE_fromSpecStalk {R : CommRingCat.{v}} (ψ : X.presheaf.stalk y ⟶ R) {U : X.Opens} (hy : y ∈ U)
    (hle : ⊤ ≤ (Spec.map ψ ≫ X.fromSpecStalk y) ⁻¹ᵁ U) :
    (Spec.map ψ ≫ X.fromSpecStalk y).appLE U ⊤ hle =
      X.presheaf.germ U y hy ≫ ψ ≫ (Scheme.ΓSpecIso R).inv := by
  rw [Scheme.Hom.comp_appLE, Scheme.fromSpecStalk_app hy]
  simp only [Category.assoc]
  rw [Scheme.ΓSpecIso_inv_naturality]
  rfl

theorem not_mem_preimage {U : X.Opens} (hy : y ∉ U) (z : Spec (T.residueField ξ)) :
    z ∉ (Spec.map φ ≫ X.fromSpecResidueField y) ⁻¹ᵁ U := by
  intro hz; apply hy; simpa using hz

theorem top_le_preimage {U : X.Opens} (hy : y ∈ U) :
    ⊤ ≤ (Spec.map φ ≫ X.fromSpecResidueField y) ⁻¹ᵁ U := by
  intro z _; show (Spec.map φ ≫ X.fromSpecResidueField y) z ∈ U; simpa using hy

end RamanujanPetersson.EtPBC.Nagata

end

end

-- ===== S4.Def_RP_EtPBC_A_EY =====
section

/-!
# S4-EtPBC-A, M4(E), EY: the finite cover `Y` and the sections of `Spec κ(ξ) ×_P W`

* `residueFieldMap_finite`: residue field extensions of etale morphisms are finite;
* `f0 T ξ : Spec κ(ξ) ⟶ P`, `Yn`, `πn`, `g0` (relative normalization), **`isFinite_πn`** (Nagata), `yg` the generic
  point of `Y` (`closure {yg} = univ`);
* `exists_iota`: `fl x t` factors through `Spec κ(fpt x t)`;
* `Xp ξ W := pullback (f0 T ξ) W.hom`, its sections `sx ξ W u` (`u : T ⟶ W`), clopen ranges, **`sx_cover`** (every
  point lies on a section `sx (τ b)`) and **`sx_disj`** (the sections `sx (τ b)` have distinct points).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech

universe u

/-- **Residue field extensions of etale morphisms are finite.** -/
theorem residueFieldMap_finite {X Y : Scheme.{u}} (f : X ⟶ Y) [Etale f] (x : X) :
    (f.residueFieldMap x).hom.Finite := by
  let := (f.residueFieldMap x).hom.toAlgebra
  have : Algebra.EssFiniteType (Y.residueField (f x)) (X.residueField x) := by
    rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
    exact RingHom.EssFiniteType.residueFieldMap (LocallyOfFiniteType.stalkMap f x)
  have : Algebra.IsSeparable (Y.residueField (f x)) (X.residueField x) := inferInstance
  have : Module.Finite (Y.residueField (f x)) (X.residueField x) :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  exact this

variable {P : Scheme.{u}} (T : P.Etale) (ξ : T.left)

/-- The field point `Spec κ(ξ) ⟶ P`. -/
def f0 : Spec (T.left.residueField ξ) ⟶ P :=
  Spec.map (T.hom.residueFieldMap ξ) ≫ P.fromSpecResidueField (T.hom ξ)

/-- `fl x t` factors through `Spec κ(fpt x t)`. -/
theorem exists_iota (x : P) {V : P.Etale} (a : (geomPtAt x).point.fiber.obj V) :
    ∃ ι : Spec (CommRingCat.of (geomPtAt x).Ω) ⟶ Spec (V.left.residueField (fpt x a)),
      ι ≫ V.left.fromSpecResidueField (fpt x a) = fl x a := by
  have h : fl x a (IsLocalRing.closedPoint (geomPtAt x).Ω) = fpt x a := by
    show _ = fl x a default
    exact congrArg _ (Subsingleton.elim _ _)
  revert h
  generalize fpt x a = ξ'
  intro h
  subst h
  exact ⟨_, Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ _ (fl x a)⟩

section Sec

end Sec

end RamanujanPetersson.EtPBC.GenGeo

end

