variable (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]

theorem reciprocalToFiniteAffineScheme_base (h104 : IsUnit (104 : R)) :
    reciprocalToFiniteAffineScheme R h104 ≫ finiteAffineSchemeToBase R =
      reciprocalPatchChartMap R ≫ curveToBase R := by
  rw [reciprocalPatchChartMap, Category.assoc, reciprocalChartMap_curveToBase]
  unfold reciprocalToFiniteAffineScheme reciprocalFiniteChartIso candidateInfinityChartMap
    finiteAffineSchemeToBase finiteAffineMap reciprocalPatchInclusion reciprocalChartToBase
  change (Spec.map (CommRingCat.ofHom (recoveredReciprocalPatchEquiv R h104).symm.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (candidateAlgebra R) (infinityLocalization R)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap (Polynomial R) (candidateAlgebra R))) ≫
        Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)) = _
  simp only [← Spec.map_comp]
  change Spec.map _ = Spec.map _
  apply congrArg Spec.map
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  change candidateToReciprocalPatch R h104 (algebraMap R (candidateAlgebra R) r) =
    algebraMap R (Order13SingleSectionReciprocalPatch.PatchRing R) r
  exact (candidateToReciprocalPatch R h104).commutes r

theorem finiteModelToCurve_base (h104 : IsUnit (104 : R)) :
    finiteModelToCurve R h104 ≫ curveToBase R = finiteAffineSchemeToBase R := by
  apply (finiteSchemeOpenCover R h104).hom_ext
  intro b
  cases b with
  | true =>
    change ordinaryToFiniteAffineScheme R ≫ finiteModelToCurve R h104 ≫ curveToBase R =
      ordinaryToFiniteAffineScheme R ≫ finiteAffineSchemeToBase R
    rw [← Category.assoc, ordinaryToFiniteAffineScheme_finiteModelToCurve,
      ordinaryChartMap_curveToBase, ordinaryToFiniteAffineScheme_base]
  | false =>
    change reciprocalToFiniteAffineScheme R h104 ≫ finiteModelToCurve R h104 ≫ curveToBase R =
      reciprocalToFiniteAffineScheme R h104 ≫ finiteAffineSchemeToBase R
    rw [← Category.assoc, reciprocalToFiniteAffineScheme_finiteModelToCurve,
      reciprocalToFiniteAffineScheme_base]

def sectionComplementFiniteMap (h104 : IsUnit (104 : R)) :
    (sectionComplementOpen R).toScheme ⟶ Spec (.of (Polynomial R)) :=
  (finiteModelSectionComplementIso R h104).inv ≫ finiteAffineMap R

theorem sectionComplementFiniteMap_isFinite (h104 : IsUnit (104 : R)) :
    IsFinite (sectionComplementFiniteMap R h104) := by
  let := finiteAffineMap_isFinite R (two_isUnit_of_104 R h104)
  unfold sectionComplementFiniteMap
  infer_instance

theorem sectionComplementFiniteMap_base (h104 : IsUnit (104 : R)) :
    sectionComplementFiniteMap R h104 ≫
      Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)) =
    (sectionComplementOpen R).ι ≫ curveToBase R := by
  change (finiteModelSectionComplementIso R h104).inv ≫ finiteAffineSchemeToBase R = _
  rw [← finiteModelToCurve_base R h104, ← Category.assoc,
    finiteModelSectionComplementIso_inv_comp]

end MazurTransfer.Order13SingleSectionFiniteAlgebra
