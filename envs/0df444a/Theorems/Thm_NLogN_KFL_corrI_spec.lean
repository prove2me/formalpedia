open IntMul RS KIL KFD Butterfly Finset

theorem NLogN.KFL.corrI_spec :
    ∃ Kc : ℝ, 0 < Kc ∧
      ∀ (K ρ f : ℕ), 6 ≤ K → ρ < K → 1 ≤ f →
      ∀ (g : Geo), g.Pos → g.Q = 2 ^ (f * K) →
      ∀ (I : List Sym) (iprog : Fin 1 → IStmt HS 1) (t : IState HS) (zs : List ℤ) (R : List Item),
      Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
      ∃ c : ℕ, IRuns I iprog (corrI K ρ f g) t
          (t.upd 0 (ints (rixT g (corrc K ρ f) zs) ++ R)) c ∧
        (c : ℝ) ≤ Kc * (((g.V / g.B : ℕ) : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
          min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * ((g.V / g.B : ℕ) : ℝ) *
            ((zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (zsz (g.V : ℤ) : ℝ) + 1)) := by sorry
