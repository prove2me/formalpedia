theorem isOpen_domJ : IsOpen domJ := isOpen_domRN.preimage continuous_snd

theorem mem_domJ {y : Pt 4} (hy : y ∈ domRN) (ε : ℝ) : (ε, y) ∈ domJ := hy

/-! ## Families -/

theorem familyData_param (M Q m q : ℝ) :
    FamilyData (fun ε => gRN (M + ε * m) ((Q + ε * q) ^ 2)) (fun ε => giRN (M + ε * m) ((Q + ε * q) ^ 2))
