      TypeDensity.descendBlock O Φ r (TypeDensity.selectBlock O Φ r a) = a) ∧
    (∀ b ∈ TypeDensity.blockCell O Φ r, TypeDensity.selectBlock O Φ r (TypeDensity.descendBlock O Φ r b) = b) ∧
    (∀ a ∈ TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r),
      (TypeDensity.monicPolyO (TypeDensity.selectBlock O Φ r a)).Monic ∧
        TypeDensity.monicPolyO (TypeDensity.selectBlock O Φ r a) ∣ (TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ)) := by
