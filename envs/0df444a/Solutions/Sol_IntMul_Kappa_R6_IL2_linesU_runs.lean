/-! ## One line, register-driven -/

/-- **One line on the geometry**, register-driven. -/
theorem rotU_geo {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (l : Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zV : zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = g.V) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R)
    {eP eQ eB ed0 ed1 er ef eK : Ex HS}
    (hsz : ((rotPl eP eQ eB ed0 ed1 er ef eK).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eQ) (n3 : NoLow eB) (n4 : NoLow ed0) (n5 : NoLow ed1)
    (n6 : NoLow er) (n7 : NoLow ef) (n8 : NoLow eK)
    (E1 : ESp eP t Bb ((g.N0 * g.Q * g.N1 * g.Q * g.N2 : ℕ) : ℤ))
    (E2 : ESp eQ t Bb ((g.Q : ℕ) : ℤ)) (E3 : ESp eB t Bb ((g.S2 : ℕ) : ℤ))
    (E4 : ESp ed0 t Bb ((g.N2 * g.Q * g.N1 : ℕ) : ℤ)) (E5 : ESp ed1 t Bb ((g.N2 : ℕ) : ℤ))
    (E6 : ESp er t Bb ((2 : ℤ) ^ ρ)) (E7 : ESp ef t Bb ((f - 1 : ℕ) : ℤ))
    (E8 : ESp eK t Bb ((2 : ℤ) ^ K)) :
    IRuns I iprog (rotU l.sgn l.b eP eQ eB ed0 ed1 er ef eK) t
