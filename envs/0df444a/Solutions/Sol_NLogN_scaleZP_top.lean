      ceilSqrtCost (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))) (k + Bz + 1) := by
  have hV0 : 0 ≤ 2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y) :=
    add_nonneg (mul_self_nonneg _) (mul_self_nonneg _)
  have hVlt := scale_v_lt k Bz x y hx hy
  have hlt : (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat < 4 ^ (k + Bz + 1) := by
    have : (((2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat : ℕ) : ℤ) <
        ((4 ^ (k + Bz + 1) : ℕ) : ℤ) := by
      rw [Int.toNat_of_nonneg hV0]; push_cast
      rw [show (4 : ℤ) = 2 ^ 2 by norm_num, ← pow_mul]; exact hVlt
    exact_mod_cast this
  have h41 : ((push 42 scBE).run ((push 41 (.reg 19)).run (NLogN.scSt s k x y))).G 41 =
      .int (((2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat : ℕ) : ℤ) ::
        (NLogN.scSt s k x y).G 41 := by
    rw [Int.toNat_of_nonneg hV0]
    simp (config := {decide := true}) [NLogN.scSt, Ex.eval, IState.top, IState.upd_G]
  have h42 : ((push 42 scBE).run ((push 41 (.reg 19)).run (NLogN.scSt s k x y))).G 42 =
      .int ((k + Bz + 1 : ℕ) : ℤ) :: (NLogN.scSt s k x y).G 42 := by
    simp (config := {decide := true}) [NLogN.scSt, Ex.eval, IState.top, IState.upd_G, scBE, h11, h14]
  obtain ⟨hok, hrun, hcost⟩ := ceilSqrtP_spec _ _ hlt _ _ _ h41 h42
  refine ⟨hok, ?_, ?_⟩
  · rw [hrun]
    apply IState.ext' _ (by simp [scSt2]) (by simp [scSt2])
    intro j
    simp (config := {decide := true}) only [scSt2, RS.run_push_G, IState.upd_G, Ex.eval,
      IState.top, scBE, if_true, if_false]
    split_ifs <;> simp_all [NLogN.scSt, Int.toNat_of_nonneg hV0]
  · rw [Int.toNat_of_nonneg hV0] at hcost; exact hcost

theorem scaleZ_eq (p k : ℕ) (x y : ℤ) : scaleZ p k (x, y) =
    if (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ≤ 2 ^ (p + p) then (2 ^ k * x, 2 ^ k * y)
    else ((2 ^ k * x * 2 ^ p).tdiv (ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat),
      (2 ^ k * y * 2 ^ p).tdiv (ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat)) := by
  have e : (4 : ℤ) ^ p = 2 ^ (p + p) := by
    rw [show (4 : ℤ) = 2 ^ 2 by norm_num, ← pow_mul]; ring_nf
  simp only [scaleZ, pow_two, e]

theorem scCond_eval (s : IState HS) (p k : ℕ) (x y : ℤ) {L10 : List Item} (h10 : s.G 10 = .int p :: L10) :
    scCondE.eval (NLogN.scSt s k x y) = 2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) := by
  simp (config := {decide := true}) [scCondE, NLogN.scSt, Ex.eval, IState.top, IState.upd_G, h10]
  norm_cast

