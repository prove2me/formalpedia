  rw [Int.natAbs_natCast] at hv
  have hsq : (v + 1) ^ 2 < 2 ^ (2 * zsz ((v + 1 : ℕ) : ℤ)) := by
    rw [pow_mul']; exact Nat.pow_lt_pow_left hv (by norm_num)
  have hz : z.natAbs ≤ (v + 1) ^ 2 := by
    have : (z.natAbs : ℤ) ≤ ((v + 1) ^ 2 : ℕ) := by
      push_cast; rw [abs_le]; constructor <;> linarith
