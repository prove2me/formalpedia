open CategoryTheory AlgebraicGeometry NeronModelInfra GoodReductionJacobian QuaternionAlgebra IsDedekindDomain CerednikDrinfeld CerednikDrinfeld.QM
open scoped Quaternion TensorProduct NumberField

theorem solution
    {r rbar N : ℕ} [Fact r.Prime] [Fact rbar.Prime] [NeZero N] (hrr : rbar ≠ r) (hrbarN : ¬ rbar ∣ N)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (k₀ : Type) [Field k₀] [IsAlgClosed k₀] [CharP k₀ r] (A₀ : FakeEllipticCurve Λ N k₀) (e : ℕ)
    (f f' : A₀.A ⟶ A₀.A) (hf : f ≫ A₀.f = A₀.f) (hf' : f' ≫ A₀.f = A₀.f)
    (hf_hom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P Q : SchemeHomOver t A₀.f),
      mapPt f hf (A₀.L.mul t P Q) = A₀.L.mul t (mapPt f hf P) (mapPt f hf Q))
    (hf'_hom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P Q : SchemeHomOver t A₀.f),
      mapPt f' hf' (A₀.L.mul t P Q) = A₀.L.mul t (mapPt f' hf' P) (mapPt f' hf' Q))
    (hf_lin : ∀ m : ↥Λ, A₀.act m ≫ f = f ≫ A₀.act m) (hf'_lin : ∀ m : ↥Λ, A₀.act m ≫ f' = f' ≫ A₀.act m)
    (hf_lev : FakeEllipticCurve.PreservesLevel A₀ A₀ f hf)
    (hff' : f ≫ f' = A₀.act ⟨(((r ^ e * rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩) (hf'f : f' ≫ f = A₀.act ⟨(((r ^ e * rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩)
    (hf_not : ∀ (j : ℕ) (ψ : A₀.A ⟶ A₀.A), ¬ FakeEllipticCurve.IsIsogenyPair (r ^ j) A₀ A₀ f ψ)
    (hf'_not : ∀ (j : ℕ) (ψ : A₀.A ⟶ A₀.A), ¬ FakeEllipticCurve.IsIsogenyPair (r ^ j) A₀ A₀ f' ψ) :
    ∃ (A₀w : FakeEllipticCurve Λ N k₀)
      (aw : A₀.A ⟶ A₀w.A) (haw : aw ≫ A₀w.f = A₀.f) (aw' : A₀w.A ⟶ A₀.A) (haw' : aw' ≫ A₀.f = A₀w.f)
      (kw : ℕ) (bw : A₀w.A ⟶ A₀.A) (hbw : bw ≫ A₀.f = A₀w.f) (bw' : A₀.A ⟶ A₀w.A),
      FakeEllipticCurve.IsAtkinLehnerQuotientVia rbar A₀ A₀w aw haw aw' haw' ∧
      FakeEllipticCurve.IsIsogenyPair (r ^ kw) A₀w A₀ bw bw' ∧ FakeEllipticCurve.PreservesLevel A₀w A₀ bw hbw ∧
      aw ≫ bw = f := by
  classical
  have hr : r.Prime := Fact.out
  have hrbar : rbar.Prime := Fact.out

  have hsplit : ∀ (E : FakeEllipticCurve Λ N k₀),
      E.act ⟨(((r ^ e * rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = E.act ⟨(((rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ≫ E.act ⟨(((r ^ e : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := by
    intro E
    have hval : ((((r ^ e : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) * ((((rbar : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) =
        ((((r ^ e * rbar : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) := by
      rw [← QuaternionAlgebra.coe_mul]; congr 1; push_cast; ring
    have hmem : ((((r ^ e : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) * ((((rbar : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := hval ▸ hΛℤ _
    rw [← E.act_mul ⟨_, hΛℤ _⟩ ⟨_, hΛℤ _⟩ hmem]
    congr 1; exact Subtype.ext hval.symm

  obtain ⟨A₀w, aw, haw, aw', haw', hAL, hepi, hUP⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isAtkinLehnerQuotientVia_epi_and_forall_existsUnique_comp_eq hrr hrbarN hB Λ hΛ k₀ A₀
  obtain ⟨haw_hom, haw'_hom, haw_lin, haw'_lin, haw_comp, haw_ker, haw_lev⟩ := hAL

  have hker := fun {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P : SchemeHomOver t A₀.f) =>
    CerednikDrinfeld.QM.FakeEllipticCurve.forall_mapPt_eq_one_iff_torsionPrime_of_comp_eq_act_of_not_isIsogenyPair hrr hB Λ hΛ hΛℤ k₀ A₀ e
      f f' hf hf' hf_hom hf'_hom hf_lin hf'_lin hff' hf'f hf_not hf'_not t P

  obtain ⟨χ, ⟨hχ, hχhom⟩, -⟩ := hUP f hf hf_hom (fun t P htors => (hker t P).1 htors)
  have hbw_lin : ∀ m : ↥Λ, A₀w.act m ≫ χ.1 = χ.1 ≫ A₀.act m := by
    intro m
    haveI := hepi
    rw [← cancel_epi aw]
    calc aw ≫ A₀w.act m ≫ χ.1 = (A₀.act m ≫ aw) ≫ χ.1 := by rw [← Category.assoc, haw_lin]
      _ = A₀.act m ≫ f := by rw [Category.assoc, hχ]
      _ = f ≫ A₀.act m := hf_lin m
      _ = aw ≫ χ.1 ≫ A₀.act m := by rw [← Category.assoc, hχ]

  have hrbar0 : ((rbar : ℕ) : k₀) ≠ 0 := fun h =>
    hrr ((Nat.prime_dvd_prime_iff_eq hr hrbar).mp ((CharP.cast_eq_zero_iff k₀ r rbar).mp h)).symm
  have hφover : (f' ≫ aw) ≫ A₀w.f = A₀.f := by rw [Category.assoc, haw, hf']
  have hφhom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P R : SchemeHomOver t A₀.f),
      mapPt (f' ≫ aw) hφover (A₀.L.mul t P R) = A₀w.L.mul t (mapPt (f' ≫ aw) hφover P) (mapPt (f' ≫ aw) hφover R) := by
    intro T t P R
    have hc : ∀ S : SchemeHomOver t A₀.f, mapPt (f' ≫ aw) hφover S = mapPt aw haw (mapPt f' hf' S) :=
      fun S => Subtype.ext (by simp [Category.assoc])
    rw [hc, hc, hc, hf'_hom, haw_hom]
  have hφlin : ∀ m : ↥Λ, A₀.act m ≫ (f' ≫ aw) = (f' ≫ aw) ≫ A₀w.act m := by
    intro m; rw [← Category.assoc, hf'_lin, Category.assoc, haw_lin, Category.assoc]
  have hφkill : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P : SchemeHomOver t A₀.f),
      nsmulPt A₀.L t rbar P = A₀.L.one t → mapPt (f' ≫ aw) hφover P = A₀w.L.one t := by
    intro T t P hP
    have hc : mapPt (f' ≫ aw) hφover P = mapPt aw haw (mapPt f' hf' P) := Subtype.ext (by simp [Category.assoc])
    rw [hc, (haw_ker t _)]
    exact (hker t P).2.2 hP
  obtain ⟨bw', hbw', hbw'_hom, hbw'_lin, hdiv⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_eq_act_comp_of_forall_nsmulPt_eq_one_imp_mapPt_eq_one_of_hom hΛℤ k₀ A₀ A₀w rbar hrbar0 (f' ≫ aw) hφover hφhom hφlin hφkill

  have hepiR : Epi (A₀.act ⟨(((rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩) := CerednikDrinfeld.QM.FakeEllipticCurve.epi_act_of_ne_zero hΛℤ k₀ A₀ _ (by exact_mod_cast hrbar.ne_zero)
  have hcomp2 : bw' ≫ χ.1 = A₀.act ⟨(((r ^ e : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := by
    haveI := hepiR
    rw [← cancel_epi (A₀.act ⟨(((rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩)]
    calc A₀.act ⟨(((rbar : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ≫ bw' ≫ χ.1 = (f' ≫ aw) ≫ χ.1 := by rw [← Category.assoc, ← hdiv]
