theorem solution (hroot : TypeDensity.RootCellLaw) (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] [TopologicalSpace O] [IsTopologicalRing O]
    [CompactSpace O] [T2Space O] [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ)
    (r : ℕ) (hr : 0 < r) (n : ℕ) (hn : Φ.natDegree * r = n) (σ : TypeDensity.FactorType) :
    MeasurableSet (TypeDensity.residueCell O n (TypeDensity.residuePoly O Φ ^ r) ∩ TypeDensity.typeEvent O n σ) ∧ TypeDensity.cellMeasure O n
      (TypeDensity.residueCell O n (TypeDensity.residuePoly O Φ ^ r)) (TypeDensity.typeEvent O n σ) = TypeDensity.densityValue
      (TypeDensity.lawCoeff (TypeDensity.lawDescend Φ.natDegree (TypeDensity.stateLaw (TypeDensity.State.single 1 r))) σ)
      (Nat.card (IsLocalRing.ResidueField O)) := by
  -- strategy: transport cell measures along the point chart onto the zero cell over `O[X]/(Φ)`,
  -- where the root cell law applies; non-scaled types have empty events
  subst hn
  let tτ : TopologicalSpace (AdjoinRoot Φ) := TypeDensity.unramifiedTopology O Φ hΦ.1
  let tm : MeasurableSpace (AdjoinRoot Φ) := TypeDensity.unramifiedMeasurableSpace O Φ hΦ.1
  obtain ⟨hdom, hloc, hchar, hdvr, hcomp, hfin, hcard, htr, hcpt, ht2, hsc, hbor, hadic⟩ :=
    TypeDensity.unramified_extension_measure_package O htop Φ hΦ rfl rfl
  obtain ⟨pi, hpi⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hδ : 0 < Φ.natDegree := hΦ.1.natDegree_map (IsLocalRing.residue O) ▸
    Polynomial.natDegree_pos_iff_degree_pos.2 (Polynomial.degree_pos_of_irreducible hΦ.2)
  have hφmon : (TypeDensity.residuePoly O Φ ^ r).Monic := (hΦ.1.map _).pow r
  have hφdeg : (TypeDensity.residuePoly O Φ ^ r).natDegree = Φ.natDegree * r := by
    rw [(hΦ.1.map _).natDegree_pow, hΦ.1.natDegree_map, mul_comm]
  have hqinv0 : (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ≠ 0 :=
    ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _)
  obtain ⟨hCm, hCμ, -⟩ := TypeDensity.residue_cell_mass O htop (Φ.natDegree * r) _ hφmon hφdeg
  obtain ⟨hZm, hZμ, -, -⟩ := TypeDensity.zero_cell_type_event_mass hroot O htop Φ hΦ rfl rfl pi hpi r hr σ
  obtain ⟨hbij, hcong⟩ := TypeDensity.point_chart_bijection O Φ hΦ r
  have hmax : IsLocalRing.maximalIdeal (AdjoinRoot Φ) = TypeDensity.baseIdeal O Φ :=
    (TypeDensity.unramified_is_dvr O Φ hΦ).2.2.2.1
  set C := TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r) with hC
  set Z := TypeDensity.zeroCell O Φ r with hZ
  set T := TypeDensity.pointChart O Φ r with hT
  have hmass : ∀ (L : ℕ), 1 ≤ L → ∀ a ∈ C,
      TypeDensity.cellMeasure O (Φ.natDegree * r) C {a' | ∀ j, a' j - a j ∈ (IsLocalRing.maximalIdeal O) ^ L}
        = TypeDensity.cellMeasure (AdjoinRoot Φ) r Z
            {b | ∀ j, b j - T a j ∈ (IsLocalRing.maximalIdeal (AdjoinRoot Φ)) ^ L} := by
    intro L hL a ha
    have hsub1 : {a' : Fin (Φ.natDegree * r) → O | ∀ j, a' j - a j ∈ (IsLocalRing.maximalIdeal O) ^
        L} ⊆ C := fun a' ha' ↦ by
      rw [hC, (TypeDensity.residue_cell_cylinder O _ _).1 a ha]
      exact fun i ↦ Ideal.pow_le_self (by omega) (ha' i)
    have hsub2 : {b : Fin r → AdjoinRoot Φ | ∀ j, b j - T a j ∈
        (IsLocalRing.maximalIdeal (AdjoinRoot Φ)) ^ L} ⊆ Z := fun b hb ↦ by
      have h3 := (TypeDensity.zero_cell_scaled O Φ pi hpi r σ).2.2
      have hTa := (h3 _).1 (hbij.mapsTo ha)
      refine (h3 b).2 fun j ↦ ?_
      have hbj := Ideal.pow_le_self (by omega : L ≠ 0) (hb j)
      rw [hmax] at hbj
      rw [show b j - 0 = (b j - T a j) + (T a j - 0) by ring, pow_one]
      exact Ideal.add_mem _ hbj (pow_one (TypeDensity.baseIdeal O Φ) ▸ hTa j)
    rw [TypeDensity.cellMeasure_apply_of_measurableSet _ _ _ hCm, TypeDensity.cellMeasure_apply_of_measurableSet _ _ _ hZm,
      Set.inter_eq_left.mpr hsub1, Set.inter_eq_left.mpr hsub2, hCμ, hZμ,
      TypeDensity.coefficient_cylinder_mass O htop, TypeDensity.coefficient_cylinder_mass (AdjoinRoot Φ) hadic, hcard]
    congr 1
    rw [TypeDensity.residueCard, Nat.cast_pow, ENNReal.inv_pow, ← pow_mul, ← mul_assoc]
  have htrans := TypeDensity.cell_transport_preimage O htop (AdjoinRoot Φ) hadic (Φ.natDegree * r) r C Z
    hCm hZm (by rw [hCμ]; exact pow_ne_zero _ hqinv0) (by rw [hZμ]; exact pow_ne_zero _ hqinv0) T
    hbij (by rw [hmax]; exact hcong) hmass
  by_cases hσ : ∃ τ₀, σ = TypeDensity.scaleType Φ.natDegree τ₀
  · obtain ⟨τ₀, rfl⟩ := hσ
    obtain ⟨-, -, hZTm, hZTμ⟩ := TypeDensity.zero_cell_type_event_mass hroot O htop Φ hΦ rfl rfl pi hpi r hr τ₀
    have hset := TypeDensity.point_cell_typeEvent_scaleType_eq O Φ hΦ r τ₀
    obtain ⟨hm1, hm2⟩ := htrans _ hZTm
    refine ⟨?_, ?_⟩
    · rw [Set.inter_comm, hset, Set.inter_comm]; exact hm1
