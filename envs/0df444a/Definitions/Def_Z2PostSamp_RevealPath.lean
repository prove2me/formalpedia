-- title:
--   The revealing path: $S_k$, $R_k$, the field $h^{(k)}$, the conditional mean $m^{(k)}$, the logit $\ell^{(k)}$ and $\mathcal H_k$
-- statement:
--   Fix a matrix $J$ and an order $I=(I_1,\dots,I_n)$. Write $S_k=\{I_1,\dots,I_k\}$ and $R_k=[n]\setminus S_k$. For a prefix $x_{S_k}$ the **field** is $h^{(k)}_j(x_{S_k})=\sum_{a=1}^k J_{j,I_a}x_{I_a}$, and the exact conditional law of the free coordinates is
--
--   $$\mathbb P(\theta_{R_k}=u\mid J,I,\theta_{S_k}=x_{S_k})\propto\exp\Big\{\tfrac12u^\top J_{R_k,R_k}u+h^{(k)}(x_{S_k})^\top u\Big\},\qquad u\in\{-1,1\}^{R_k}. $$
--
--   Its mean is $m^{(k)}(x_{S_k})$, extended by $\bar m^{(k)}_i=x_i$ on $S_k$, and the **conditional logit** is $\ell^{(k)}_i(x_{S_k})=\operatorname{arctanh}(m^{(k)}_i(x_{S_k}))$, the exact half-log-odds of the next sign. A map of configurations is a **prefix function** if it depends on $x$ only through $x_{S_k}$. Finally $\mathcal H_k=\sigma\big(J,(I_a,\theta_{I_a})_{a\le k}\big)$ is the σ-algebra of the data and the first $k$ exposed index–value pairs on the planted sample space.
--
--   These are the exact targets the sequential proposal approximates; the milestones compare algorithmic quantities with them along a posterior-distributed prefix.
--
--   **Formalization Note** `I a` (0-based) is $I_{a+1}$, so $S_k=\{I\,a : a<k\}$ and $I_{k+1}$ is `I ⟨k, _⟩`. The conditional mean is a ratio of finite sums over the completions of the prefix; for $i\in S_k$ it returns $x_i$, so it is $\bar m^{(k)}$, and `onR` restricts a vector to $R_k$. `arctanh` is Mathlib's `Real.artanh`.
-- source:
--   Z. Li, Efficient Posterior Sampling for ℤ₂ Synchronization, arXiv:2610.08199 (held version, sha256 536ad4d8…), §2.2, pp.7–8, (2.4); Lemma 2.2, p.8 (ℋ_k); §3.2, p.18 (m̄^{(k)})

import Mathlib
import Definitions.Def_CriticalSK
import Definitions.Def_Z2PostSamp_Model

set_option autoImplicit false

open scoped ENNReal
open MeasureTheory OAI.CriticalSK

namespace Z2PostSamp

noncomputable section

/-!
# The revealing path: prefixes, fields, exact conditional means and logits, ℋ_k

Z. Li, *Efficient Posterior Sampling for ℤ₂ Synchronization*, arXiv:2610.08199 (held version,
sha256 536ad4d8…), §2.2, pp.7–8: `S_k = {I_1, …, I_k}`, `R_k = [n] ∖ S_k`; for a prefix `x_{S_k}`,
`h_j^{(k)}(x_{S_k}) = Σ_{a=1}^k J_{j,I_a} x_{I_a}` (`j ∈ R_k`), `m^{(k)}(x_{S_k}) = E[θ_{R_k} | J, I,
θ_{S_k} = x_{S_k}]` with the conditional law (2.4)
`P(θ_{R_k} = u | J, I, θ_{S_k} = x_{S_k}) ∝ exp{½ uᵀ J_{R_k,R_k} u + h^{(k)}(x_{S_k})ᵀ u}`,
`ℓ_i^{(k)}(x_{S_k}) = arctanh(m_i^{(k)}(x_{S_k}))` (p.8), and Lemma 2.2, p.8:
`ℋ_k = σ(J, (I_a, θ_{I_a})_{a ≤ k})`. §3.2, p.18: the extension `m̄^{(k)}` equal to `x_i` on `S_k`.

**Formalization Note.** The order is a permutation `I` of `Fin n`; `I a` (0-based `a`) is the paper's
`I_{a+1}`, so `S_k = {I a | a < k}` and the paper's `I_{k+1}` is `I ⟨k, _⟩`. Configurations are full
`x : Spin n`; every quantity here depends on `x` only through `x` on `S_k` (the sums run over the
completions of the prefix, which are in bijection with `u ∈ {±1}^{R_k}`). `condMean` is the weighted
mean of `spinValue (y i)` over the completions with the weights (2.4); for `i ∈ S_k` it equals
`spinValue (x i)`, so it is the paper's extended `m̄^{(k)}` (p.18), and `onR` restricts a vector to
`R_k` (zero elsewhere), which gives the paper's `m^{(k)}`. `logit` uses Mathlib's `Real.artanh`
(`= ½ log((1+u)/(1−u))` on `[−1,1]`). `ℋ_k` is the σ-algebra generated by `J` (as a function
`Fin n → Fin n → ℝ`) and the exposed pairs; positions `a ≥ k` are masked by a constant.
-/

/-- `S_k = {I_1, …, I_k}`: the revealed sites. -/
def Sset {n : ℕ} (I : Equiv.Perm (Fin n)) (k : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun i => (I.symm i).val < k

/-- `R_k = [n] ∖ S_k`: the free sites. -/
def Rset {n : ℕ} (I : Equiv.Perm (Fin n)) (k : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun i => k ≤ (I.symm i).val

/-- The restriction of a vector to `R_k` (zero on `S_k`). -/
def onR {n : ℕ} (I : Equiv.Perm (Fin n)) (k : ℕ) (v : Fin n → ℝ) : Fin n → ℝ :=
  fun i => if i ∈ Rset I k then v i else 0

/-- The field `h_j^{(k)}(x_{S_k}) = Σ_{a=1}^k J_{j,I_a} x_{I_a}` (p.7; also `ĥ^{(k)}`, p.10). -/
def field {n : ℕ} (J : Matrix (Fin n) (Fin n) ℝ) (I : Equiv.Perm (Fin n)) (x : Spin n) (k : ℕ)
    (j : Fin n) : ℝ :=
  ∑ a : Fin n, if a.val < k then J j (I a) * spinValue (x (I a)) else 0

/-- The completions of the prefix `x_{S_k}`: configurations agreeing with `x` on `S_k`. -/
def completions {n : ℕ} (I : Equiv.Perm (Fin n)) (x : Spin n) (k : ℕ) : Finset (Spin n) :=
  Finset.univ.filter fun y => ∀ i ∈ Sset I k, y i = x i

/-- The unnormalized conditional weight (2.4) of a completion `y`:
`exp{½ Σ_{i,j ∈ R_k} J_ij y_i y_j + Σ_{i ∈ R_k} h_i^{(k)}(x_{S_k}) y_i}`. -/
def condW {n : ℕ} (J : Matrix (Fin n) (Fin n) ℝ) (I : Equiv.Perm (Fin n)) (x : Spin n) (k : ℕ)
    (y : Spin n) : ℝ :=
  Real.exp ((1 / 2 : ℝ) * (∑ i ∈ Rset I k, ∑ j ∈ Rset I k,
      J i j * spinValue (y i) * spinValue (y j)) +
    ∑ i ∈ Rset I k, field J I x k i * spinValue (y i))

/-- The exact conditional mean `m̄_i^{(k)}(x_{S_k})` of (2.4) (p.7), extended by `x_i` on `S_k`
(p.18). -/
def condMean {n : ℕ} (J : Matrix (Fin n) (Fin n) ℝ) (I : Equiv.Perm (Fin n)) (x : Spin n) (k : ℕ)
    (i : Fin n) : ℝ :=
  (∑ y ∈ completions I x k, condW J I x k y * spinValue (y i)) /
    ∑ y ∈ completions I x k, condW J I x k y

/-- The exact conditional logit `ℓ_i^{(k)}(x_{S_k}) = arctanh(m_i^{(k)}(x_{S_k}))` (p.8). -/
def logit {n : ℕ} (J : Matrix (Fin n) (Fin n) ℝ) (I : Equiv.Perm (Fin n)) (x : Spin n) (k : ℕ)
    (i : Fin n) : ℝ :=
  Real.artanh (condMean J I x k i)

/-- A map of configurations depends on `x` only through the prefix `x_{S_k}`. -/
def IsPrefixFn {n : ℕ} {β : Type} (I : Equiv.Perm (Fin n)) (k : ℕ) (f : Spin n → β) : Prop :=
  ∀ x y : Spin n, (∀ i ∈ Sset I k, x i = y i) → f x = f y

/-- The observation generating `ℋ_k`: the matrix `J` and the exposed pairs `(I_a, θ_{I_a})_{a ≤ k}`
(unexposed positions masked by a constant). -/
def prefixObs (n : ℕ) (lam : ℝ) (k : ℕ) (ω : PΩ n) :
    (Fin n → Fin n → ℝ) × (Fin n → Fin n × Bool) :=
  (fun i j => Jof n lam ω i j,
   fun a => if a.val < k then (ω.2.2 a, ω.1 (ω.2.2 a)) else (a, false))

/-- `ℋ_k = σ(J, (I_a, θ_{I_a})_{a ≤ k})`, a σ-algebra on the planted sample space (Lemma 2.2, p.8). -/
@[instance_reducible]
def Hk (n : ℕ) (lam : ℝ) (k : ℕ) : MeasurableSpace (PΩ n) :=
  MeasurableSpace.comap (prefixObs n lam k) inferInstance

end

end Z2PostSamp


