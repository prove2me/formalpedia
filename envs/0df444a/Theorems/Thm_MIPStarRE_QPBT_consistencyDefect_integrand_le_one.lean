/-!
# Pointwise consistency defect bound

This module records the unit upper bound for the pointwise consistency defect
of complete measurements placed on opposite expanded registers.

## References

This is a proof-only bound used when restoring discarded sampling mass in
`lem:qld-xz-lines`, paper
`references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:950-963`.
-/



open scoped BigOperators MatrixOrder ComplexOrder

open MIPStarRE.QPBT

open LIDT.MIPStarRE.LDT hiding Measurement
open LIDT.MIPStarRE.Quantum

theorem MIPStarRE.QPBT.consistencyDefect_integrand_le_one {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {ε : ℝ}
    {Outcome : Type*} [Fintype Outcome] [DecidableEq Outcome]
    (S : _root_.MIPStarRE.QPBT.ProjectiveSetting P ε) (p1 p2 : _root_.MIPStarRE.QPBT.Placement) (hopp : p1.IsOpposite p2)
    (first : _root_.LIDT.MIPStarRE.Quantum.Measurement Outcome (S.ExpandedLocalSpace p1.side))
    (second : _root_.LIDT.MIPStarRE.Quantum.Measurement Outcome (S.ExpandedLocalSpace p2.side)) :
    (∑ answer : Outcome, ∑ other : Outcome,
      if answer = other then 0 else _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm S.psiHat
        (S.place p1 (first.effect answer) * S.place p2 (second.effect other))) ≤ 1 := by sorry
