variable {h Q J x : ℝ} {F b A : ℝ → ℝ}
theorem solution (hx : x ≠ 0) (hF : F x ≠ 0) (hb : b x ≠ 0) (hu : 1 - h * x ≠ 0)
    (cF : ContDiffAt ℝ ∞ F x) (cb : ContDiffAt ℝ ∞ b x) (hPC : realPC h Q J F b A x = 0) :
    x * deriv (Df F b) x + 2 * (Df F b x + h)
      = x * rdE h Q J x (F x) (b x) (Zf h F x) (Vf A x) (Wf b A x) (Df F b x) (rf b x)
          ((F x - 1) / x) := by
  have hDd : HasDerivAt (Df F b)
      (((2 * b x * deriv b x - deriv F x) * x - (b x ^ 2 - F x) * 1) / x ^ 2) x := by
    have h2 : HasDerivAt (fun y => b y ^ 2) (2 * b x * deriv b x) x := by
      refine ((hd1' cb).fun_pow 2).congr_deriv ?_
      norm_num
    exact (h2.sub (hd1' cF)).div (hasDerivAt_id' x) hx
  have hq := quad_pcE x h Q J (F x) (deriv F x) (deriv (deriv F) x) (b x) (deriv b x)
    (deriv (deriv b) x) (A x) (deriv A x) (deriv (deriv A) x) hx hF hb hu
  unfold realPC at hPC
  rw [hPC, zero_div] at hq
  have hq0 := (mul_eq_zero.1 hq).resolve_left hx
  have key := dmode_id (x := x) (h := h) (Q := Q) (J := J) (F := F x) (F₁ := deriv F x)
    (b := b x) (b₁ := deriv b x) (A := A x) (A₁ := deriv A x) hx hF hb hu
  rw [hq0, mul_zero] at key
  rw [hDd.deriv]
  unfold Zf Vf Wf Df rf
  have : x * ((x * (2 * b x * deriv b x - deriv F x) - (b x ^ 2 - F x)) / x ^ 2)
      = x * (((2 * b x * deriv b x - deriv F x) * x - (b x ^ 2 - F x) * 1) / x ^ 2) := by ring
  rw [← this]; linarith
