  map_smul' a x := Subtype.ext (funext fun n => by
    show f (((a.appr n : ℕ) : ℤ) • (x : ℕ → A) n) = ((a.appr n : ℕ) : ℤ) • f ((x : ℕ → A) n)
    exact map_zsmul f _ _)

