theorem ModularCurve.reductionInputsModL_of_not_dvd (N : ℕ) [NeZero N] {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓN : ¬ ℓ ∣ N) (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ) :
    ModularCurve.ReductionInputsModL A N := by sorry
