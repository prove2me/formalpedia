  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp]
  rw [show (0 : ℤ) = (((0 : ZMod 2).val : ℕ) : ℤ) by simp, List.getD_map]

theorem arr_enc2 {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) (s : Step n Q) (xs : List (ZMod 2)) :
    s.arr Λ 0 (enc2 xs) = enc2 (s.arr Λ 0 xs) := pull_enc2 _ _ _ _

theorem runArr_enc2 {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) :
    ∀ (steps : List (Step n Q)) (xs : List (ZMod 2)),
      AModel.runArr Λ 0 steps (enc2 xs) = enc2 (AModel.runArr Λ 0 steps xs)
  | [], _ => rfl
  | s :: rest, xs => by
    simp only [AModel.runArr, List.foldl_cons] at *
    rw [arr_enc2]; exact runArr_enc2 Λ rest _

theorem rowSplit_enc2 {W : ℕ} (P L : ℕ) (rest : Shape) (w : Fin W) (xs : List (ZMod 2)) :
    rowSplit P W L rest w 0 (enc2 xs) = enc2 (rowSplit P W L rest w 0 xs) := pull_enc2 _ _ _ _

theorem rowMerge_enc2 {W : ℕ} [NeZero W] (P L : ℕ) (rest : Shape) (s : Fin W → List (ZMod 2)) :
    rowMerge P W L rest 0 (fun w => enc2 (s w)) = enc2 (rowMerge P W L rest 0 s) := by
  simp only [rowMerge, enc2, List.map_map]
  refine List.map_congr_left fun j _ => ?_
  simp only [Function.comp]
  rw [show (0 : ℤ) = (((0 : ZMod 2).val : ℕ) : ℤ) by simp, List.getD_map]

