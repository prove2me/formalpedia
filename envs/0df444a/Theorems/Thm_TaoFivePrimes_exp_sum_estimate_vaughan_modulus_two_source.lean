theorem exp_sum_estimate_vaughan_modulus_two_source
    (x alpha beta U V : ℝ) (a : ℤ) (q : ℕ)
    (hq : 4 ≤ q) (haq : Nat.Coprime a.natAbs q)
    (halpha : 4 * alpha = (a : ℝ) / q + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hU40 : 40 ≤ U) (hV40 : 40 ≤ V)
    (hUx : U < x) (hVx : V < x)
    (hUV : U * V ≤ x / 4) (hUV2 : x ≤ U * V ^ 2) :
    ‖smoothedExpSum eta0 2 x alpha‖ ≤
      0.5 * (x / q) * Real.log x *
          Real.log (2 * U * V / q + 4) +
        0.89 * (U * V + (5 / 2 : ℝ) * q) *
          (8 + Real.log q) * Real.log (2 * x) +
        (0.1 * (x / Real.sqrt q) +
          0.39 * (x / Real.sqrt (x / q))) *
            Real.log (x / (U * V)) * Real.log (V * x / U) +
        (0.55 * (x / Real.sqrt U) +
          0.78 * (x / Real.sqrt V)) * Real.log (x / U) := by sorry
