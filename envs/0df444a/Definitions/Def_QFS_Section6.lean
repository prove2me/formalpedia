/-- The set of pairs `discreteForm` sums over. -/
def pairSet (S : Set (EuclideanSpace ℝ (Fin d))) (R₀ : ℝ) :
    Set (EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d)) :=
  {p | p.1 ∈ S ∩ lattice d ∧ p.2 ∈ S ∩ lattice d ∧ R₀ < ‖p.1 - p.2‖}

