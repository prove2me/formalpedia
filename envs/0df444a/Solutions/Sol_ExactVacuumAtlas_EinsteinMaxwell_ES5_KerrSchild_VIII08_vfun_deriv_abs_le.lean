theorem solution {j Aq Ar : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG)
    (hrb : ∀ x ∈ KG, |r x| ≤ Ar) (hAr : 0 ≤ Ar) {R : ℝ} (hR : 3 < R) :
    |R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)| ≤ 3 * (3 * |j| + Aq) / 4 + Ar := by
  have hR0 : (0:ℝ) < R := by linarith
  have hRne : R ≠ 0 := ne_of_gt hR0
  have h1R0 : (0:ℝ) < 1 / R := by positivity
  have haG : aG = 1 / 3 := rfl
  have h1Ra : (1:ℝ) / R ≤ aG := by
    rw [haG]; exact one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 3) (le_of_lt hR)
  have h1RK : (1:ℝ) / R ∈ KG := ⟨le_of_lt h1R0, h1Ra⟩
  have hbeta : beta j q (1 / R) = bfun j q R := by
    rw [beta_of_ne (ne_of_gt h1R0)]
    congr 1
    field_simp
  have hd := deriv_vfun (j := j) hqc hq hAq hr hR
  have hb := bfun_abs_le_sharp (j := j) hqc hq hAq hR
  have hrb' := hrb (1 / R) h1RK
  -- `R⁴ (v' + 2j/R³) = r(1/R) - 6 R b_s(R)`
  have hident : R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)
      = r (1 / R) - 6 * (R * bfun j q R) := by
    rw [hd]
    unfold ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Gfun
    rw [hbeta]
    field_simp
    ring
  rw [hident]
  have h1 : |6 * (R * bfun j q R)| ≤ 6 * ((3 * |j| + Aq) / 8) := by
    rw [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 6)]
    exact mul_le_mul_of_nonneg_left (by
      have hmul := mul_le_mul_of_nonneg_left hb (le_of_lt hR0)
      calc |R * bfun j q R| = R * |bfun j q R| := by rw [abs_mul, abs_of_pos hR0]
        _ ≤ R * ((3 * |j| + Aq) / (8 * R)) := hmul
        _ = (3 * |j| + Aq) / 8 := by field_simp) (by norm_num)
  calc |r (1 / R) - 6 * (R * bfun j q R)|
      ≤ |r (1 / R)| + |6 * (R * bfun j q R)| := by
        have h := abs_sub_le (r (1 / R)) 0 (6 * (R * bfun j q R))
        simpa using h
    _ ≤ Ar + 6 * ((3 * |j| + Aq) / 8) := add_le_add hrb' h1
    _ = 3 * (3 * |j| + Aq) / 4 + Ar := by ring
