namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

/-! ### Joint smoothness of the nonlinear building blocks -/

theorem contDiffOn_raise2_joint {ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {W : Set (ℝ × Pt n)}
    (hgi : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => ginv p.1 i j p.2) W)
    (hF : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => F p.1 i j p.2) W) (a b : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => raise2 (ginv p.1) (F p.1) a b p.2) W := by
  unfold raise2
  exact ContDiffOn.sum fun c _ => ContDiffOn.sum fun d _ => ((hgi a c).mul (hgi b d)).mul (hF c d)

/-! ### Pointwise chain rules (inputs: genuine derivatives of the ingredients at one point) -/

section pointwise

variable {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {h : Metric n} {f : TwoForm n} {y : Pt n}

theorem hasDerivAt_christoffel_of
    (hgi : ∀ i j, HasDerivAt (fun ε => ginv ε i j y) (invVar (ginv 0) h i j y) 0)
    (hpd : ∀ k i j, HasDerivAt (fun ε => pd k (g ε i j) y) (pd k (h i j) y) 0) (a b c : Fin n) :
    HasDerivAt (fun ε => christoffel (g ε) (ginv ε) a b c y) (chrVar (g 0) (ginv 0) h a b c y) 0 :=
  (HasDerivAt.fun_sum fun k _ => (hgi a k).mul (((hpd c k b).add (hpd b k c)).sub (hpd k b c))).div_const 2

end pointwise

section four

variable {g ginv : ℝ → Metric 4} {F : ℝ → TwoForm 4} {h : Metric 4} {f : TwoForm 4} {y : Pt 4}

end four

/-! ### Family-level bridges -/

namespace FamilyData

variable {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {W : Set (ℝ × Pt n)} {h : Metric n} {f : TwoForm n}

theorem smooth_inv (hfam : FamilyData g ginv F W) (i j : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => ginv p.1 i j p.2) W :=
  contDiffOn_inv_joint hfam.smooth hfam.inv i j

/-- `δ ginv = invVar ginv h` (true inverse; `δG = -G h G`). -/
theorem hasDerivAt_inv (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (a b : Fin n) :
    HasDerivAt (fun ε => ginv ε a b y) (invVar (ginv 0) h a b y) 0 :=
  hasDerivAt_param_inv hfam.isOpen hfam.smooth hfam.inv hy (ht.metric y hy) a b

