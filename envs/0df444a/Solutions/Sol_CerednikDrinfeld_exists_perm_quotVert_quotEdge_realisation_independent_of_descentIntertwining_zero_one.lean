        rw [RingEquiv.apply_symm_apply]
      have := h y
      rw [hy] at this
      rw [mul_smul, this, smul_smul, inv_mul_cancel, one_smul]

    have hΔ : Γ₂ j ≤ Γ₂ none := by
      cases j with
      | none => exact le_rfl
      | some ℓ => rw [hΓ₂ℓ ℓ]; exact inf_le_left
    have hidx : (Γ₂ j).relIndex (Γ₂ none) ≠ 0 := by
      cases j with
      | none => rw [Subgroup.relIndex_self]; exact one_ne_zero
      | some ℓ =>
        rw [hΓ₂ℓ ℓ, CerednikDrinfeld.CosetGraph.relIndex_inf_map_conj_eq_arrowDegree_of_hecke hN hqN hq'N hqq' hq5 hq'5 hdef₁ Λ₁ R₁ hΛ₁ hR₁ hRΛ₁ n₁ hn₁ hS₁ v₂ hv₂ ℓ (s₂ ℓ) (sf₂ ℓ) (hs₂ ℓ) (Γ₂ none) hΓ₂0]
        unfold HeckeTower.arrowDegree
        split_ifs <;> first | exact ℓ.1.prop.ne_zero | exact Nat.succ_ne_zero _ | omega
    exact CerednikDrinfeld.apply_mem_map_of_forall_smul_invariantFieldOf_eq_of_relIndex_ne_zero_of_frame hN hqN hq'N hqq' hq5 hq'5 hdef₁ Λ₁ R₁ hΛ₁ hR₁ hRΛ₁ n₁ hn₁ hS₁ hnorm₁ hsq₁ A₂ hA₂ v₂ hv₂ ι₂ hι₂ ρ₂ hρ₂ ϖ₂ hϖ₂
      s₂ sf₂ hs₂ (Γ₂ none) hΓ₂0 (Γ₂ j) hΔ hidx (n'⁻¹ * n) hfix

  refine ⟨πV₂, πE₂, hπV0, hπV1, hπE0, hπE1, fun j τ h => ⟨hπVe j τ h, hπEe j τ h⟩, fun j τ h => ⟨hπVo j τ h, hπEo j τ h⟩, ?_⟩
  intro j σ n t hn hreal
  obtain ⟨nσ, tσ, hRσ, hn', hVσ, hTσ, hNTσ⟩ := RQ j σ
  have hmem : ρ₂ (nσ⁻¹ * n) ∈ (Γ₂ j).map ρ₂ := RR j n nσ t tσ (fun y => (hreal y).symm.trans (hRσ y))
  have hn_eq : ρ₂ n = ρ₂ nσ * ρ₂ (nσ⁻¹ * n) := by rw [map_mul, map_inv, mul_inv_cancel_left]
  have hconj : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₂)), x ∈ (Γ₂ j).map ρ₂ → ρ₂ nσ * x * (ρ₂ nσ)⁻¹ ∈ (Γ₂ j).map ρ₂ := fun x hx => by
    rw [hn']; have e0 : (ρ₂ nσ)⁻¹ * (ρ₂ nσ * x * (ρ₂ nσ)⁻¹) * ρ₂ nσ = x := by group
    rw [e0]; exact hx
  have hmem' : ρ₂ nσ * ρ₂ (nσ⁻¹ * n) * (ρ₂ nσ)⁻¹ ∈ (Γ₂ j).map ρ₂ := hconj _ hmem
  have hpar : (ρ₂ n ∈ Mumford.typePreserving PGL(2, ↥(ValuationSubring.ratClosure A₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) (LT.LatticeTree.stdVertex R₀ ↥(ValuationSubring.ratClosure A₂)) ↔ ρ₂ nσ ∈ Mumford.typePreserving PGL(2, ↥(ValuationSubring.ratClosure A₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) (LT.LatticeTree.stdVertex R₀ ↥(ValuationSubring.ratClosure A₂))) := by
    rw [hn_eq, hTmul]; exact ⟨fun h' => h'.2 (hIMG1 j hmem), fun h' => ⟨fun _ => hIMG1 j hmem, fun _ => h'⟩⟩
  refine ⟨fun v => ?_, fun e => ⟨fun hT => ?_, fun hT => ?_⟩⟩
  · rw [hVσ v, hn_eq]
    have e1 : ρ₂ nσ * ρ₂ (nσ⁻¹ * n) = (ρ₂ nσ * ρ₂ (nσ⁻¹ * n) * (ρ₂ nσ)⁻¹) * ρ₂ nσ := by group
