/-!
# Round six: the top-level assembly `kappa_final6`

The frozen `KFM.kappa_final` chain at the round-six parameters, with every stack piece not yet
proved taken as one of the fixed interfaces of `R6Ifaces.lean`:

* `SetupNeed6` (§9.2 setup, sources), `CrtNeed6` (`Φ` with the E′ CRT reversal), `FineNeed6`
  (fine-bit exposure), `LineNeed6` (the line maps), `P14Need6` (the uniform Prop 14, `P14UH`),
  `P18IL6` (Prop 18 from `P14UH`).

* **`kappa_final6_at`**: for one parameter record with rational `ε`.
* `rat_eps`: `ε` can be lowered to a rational one keeping `P.Ok` and `κ < P.gap`.
* **`kappa_final6`**: the target.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open Finset IntMul NLogN NLogN.KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

/-- **`ε` can be taken rational**: lowering `ε` to a nearby rational keeps `P.Ok` and `κ < gap`
(all constraints are monotone or open in `ε ≥ 1/2`). -/
theorem rat_eps_sol_aux (P : Prm) (hP : P.Ok) (κ : ℝ) (hκ : κ < P.gap) :
    ∃ q : ℚ, (({ P with ε := (q : ℝ) } : Prm)).Ok ∧ κ < ({ P with ε := (q : ℝ) } : Prm).gap := by
  have hlam1 := hP.lamp_lt
  have hlam0 := hP.lamp_pos
  have hτ0 := hP.tau_pos
  have hτ1 := hP.tau_le
  have hC0 : (0 : ℝ) ≤ P.C1 := Nat.cast_nonneg _
  have key : ∀ e : ℝ, 1 / 2 ≤ e → e ≤ P.ε → P.ε - (P.gap - κ) < e →
      ({ P with ε := e } : Prm).Ok ∧ κ < ({ P with ε := e } : Prm).gap := by
    intro e he1 he2 he3
    have hO : ({ P with ε := e } : Prm).Ok := by
      refine ⟨hP.tau_pos, hP.tau_le, hP.sigma_pos, hP.sigma_le, he1,
        lt_of_le_of_lt he2 hP.eps_lt, hP.x_ge, hP.lampOf_le, hP.lamp_lt, ?_, ?_, ?_, ?_,
        hP.delta_pos, hP.delta_lt⟩
      · show e * (2 - P.lamp) < 1
        have := hP.eps_two_sub; nlinarith
      · show e * P.C1 < 1 + P.x
        have := hP.eps_C1; nlinarith
      · show 2 * e + e < 1 + P.x
        have := hP.three_eps; linarith
      · show 2 * e - 1 < P.lamp * e
        have := hP.eps_two_sub; nlinarith
    refine ⟨hO, ?_⟩
    have g := (Prm.lt_gap_iff P P.gap).1
    rw [Prm.lt_gap_iff]
    have g1 := P.gap_le_one_sub
    have g2 := P.gap_le_lamp
    have g3 := P.gap_le_poly
    have g4 := P.gap_le_eps
    have g5 := P.gap_le_tau
    have hm : max P.ε (1 - P.ε) = P.ε := max_eq_left (by linarith [hP.eps_ge])
    rw [hm] at g5
    have hpoly : ({ P with ε := e } : Prm).poly = P.poly := rfl
    show κ < 1 - e ∧ κ < e * (1 - P.lamp) ∧ κ < 1 - e - ({ P with ε := e } : Prm).poly ∧ κ < e ∧
      κ < max e (1 - e) * (1 - P.τ)
    rw [hpoly, max_eq_left (by linarith : 1 - e ≤ e)]
    refine ⟨by linarith, ?_, by linarith, by linarith, ?_⟩
    · have : (P.ε - (P.gap - κ)) * (1 - P.lamp) ≤ e * (1 - P.lamp) :=
        mul_le_mul_of_nonneg_right he3.le (by linarith)
      nlinarith
    · have : (P.ε - (P.gap - κ)) * (1 - P.τ) ≤ e * (1 - P.τ) :=
        mul_le_mul_of_nonneg_right he3.le (by linarith)
      nlinarith
  rcases eq_or_lt_of_le hP.eps_ge with h | h
  · refine ⟨1 / 2, key _ (by push_cast; rfl) (by push_cast; rw [h]) ?_⟩
    push_cast; rw [← h]; linarith
  · obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show max (1 / 2) (P.ε - (P.gap - κ)) < P.ε by
      rw [max_lt_iff]; constructor <;> linarith)
    rw [max_lt_iff] at hq1
    exact ⟨q, key _ hq1.1.le hq2.le hq1.2⟩

end

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.rat_eps_sol_aux := @IntMul.Kappa.R6.rat_eps_sol_aux
