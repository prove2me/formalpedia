theorem ModularCurve.modularFunctionFieldC_self_collapse_unconditional (K : Type*) [Field K] {ℓ : ℕ} [Fact ℓ.Prime] [CharP K ℓ] :
    modularFunctionFieldC K ℓ = modularFunctionFieldC K 1 := by sorry
