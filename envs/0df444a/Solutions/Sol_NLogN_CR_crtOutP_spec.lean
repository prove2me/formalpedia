theorem dropN_states (i C : Fin HS) (hiC : i ≠ C) (n : Ex HS) (s : IState HS) (l : List ℤ)
    (R : List Item) (hs : s.G i = ints l ++ R) (hne : n.eval s = l.length) :
    RepStates C n (pop i) s (fun k => s.upd i (ints (l.drop k) ++ R)) where
  nonneg := by rw [hne]; omega
  hw := by simp [RS.writes, Ne.symm hiC]
  h0 := by simp [← hs]
  hG := fun k => by simp [hiC.symm]
  step := fun k hk => by
    have hk' : k < l.length := by rw [hne] at hk; simpa using hk
    obtain ⟨y, rest, hd⟩ : ∃ y rest, l.drop k = y :: rest := ⟨_, _, List.drop_eq_getElem_cons hk'⟩
    have hd2 : l.drop (k + 1) = rest := by rw [← List.drop_drop, hd]; rfl
    rw [hd, hd2]
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro x
    simp only [RS.run, withCtr, IState.upd_G, ints_cons, List.cons_append]
    clear * - hiC
    split_ifs <;> (try subst_vars) <;> simp_all

theorem dropN_spec (i C : Fin HS) (hiC : i ≠ C) (hi : i.val < 56) (hC : C.val < 56) (n : Ex HS)
    (hn : n.Clean) (s : IState HS) (l : List ℤ) (R : List Item) (hs : s.G i = ints l ++ R)
    (hno : n.ok s) (hne : n.eval s = l.length) :
    (dropN i C n).ok s ∧ (dropN i C n).run s = s.upd i R := by
  have H := dropN_states i C hiC n s l R hs hne
  have e : (n.eval s).toNat = l.length := by rw [hne]; simp
  refine ⟨H.ok hC hn hno ?_, ?_⟩
  · intro k hk
    rw [e] at hk
    obtain ⟨y, rest, hd⟩ : ∃ y rest, l.drop k = y :: rest := ⟨_, _, List.drop_eq_getElem_cons hk⟩
    refine ⟨hi, ?_⟩
    apply IState.isInt_of (a := y) (L := ints rest ++ R)
    simp [withCtr, hiC, hd]
  · rw [dropN, H.run, e, List.drop_length]; rfl

theorem rangeZ_zero (N : ℕ) : rangeZ N 0 = [] := rfl

theorem rangeZ_succ (N k : ℕ) (hk : k < N) :
    rangeZ N (k + 1) = ((N - (k + 1) : ℕ) : ℤ) :: rangeZ N k := by
  unfold rangeZ
  rw [List.range_succ_eq_map, List.map_cons, List.map_map, Nat.add_zero]
  congr 1
  apply List.map_congr_left; intro j _
  rw [Function.comp_apply, show N - (k + 1) + (j + 1) = N - k + j by omega]

theorem rangeZ_full (N : ℕ) : rangeZ N N = (List.range N).map (Nat.cast : ℕ → ℤ) := by
  simp [rangeZ]

theorem rangeP_states (i C : Fin HS) (hiC : i ≠ C) (n : Ex HS) (s : IState HS) (N : ℕ)
    (hne : n.eval s = N) :
    RepStates C n (push i (.add (.reg C) (.lit (-1)))) s
      (fun k => s.upd i (ints (rangeZ N k) ++ s.G i)) where
  nonneg := by rw [hne]; omega
  hw := by simp [RS.writes, Ne.symm hiC]
  h0 := by simp [rangeZ_zero]
  hG := fun k => by simp [hiC.symm]
  step := fun k hk => by
    have hk' : k < N := by rw [hne] at hk; simpa using hk
    rw [rangeZ_succ N k hk', hne]
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro x
    simp only [RS.run, withCtr, IState.upd_G, ints_cons, List.cons_append, Ex.eval, IState.top,
      if_true, Int.toNat_natCast]
    have e : (N : ℤ) - k + -1 = ((N - (k + 1) : ℕ) : ℤ) := by push_cast [show k + 1 ≤ N by omega]; ring
    rw [e]
    clear * - hiC
    split_ifs <;> (try subst_vars) <;> simp_all

theorem rangeP_spec (i C : Fin HS) (hiC : i ≠ C) (hi : i.val < 56) (hC : C.val < 56) (n : Ex HS)
    (hn : n.Clean) (s : IState HS) (N : ℕ) (hno : n.ok s) (hne : n.eval s = N) :
    (rangeP i C n).ok s ∧
      (rangeP i C n).run s = s.upd i (ints ((List.range N).map (Nat.cast : ℕ → ℤ)) ++ s.G i) := by
  have H := rangeP_states i C hiC n s N hne
  have e : (n.eval s).toNat = N := by rw [hne]; simp
  refine ⟨H.ok hC hn hno (fun k _ => ⟨hi, ?_, ?_⟩), ?_⟩
  · intro j hj; simp [Ex.regs] at hj; subst hj
    exact clean_of_lt hC _ (by simp [Ex.regs])
  · exact ⟨IState.isInt_of (a := ((n.eval s).toNat : ℤ) - k) (L := s.G C) (by simp [withCtr]),
      trivial⟩
  · rw [rangeP, H.run, e, rangeZ_full]

end NLogN.CR

end

