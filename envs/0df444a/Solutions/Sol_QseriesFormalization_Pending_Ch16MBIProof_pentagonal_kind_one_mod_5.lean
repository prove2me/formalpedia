      _ = 3 * ((k : ZMod 5) * (3 * (k : ZMod 5) - 1)) := by rw [h_2q_cast]
  rw [h_q_eq]
  obtain ⟨k', hk'⟩ : ∃ k' : ZMod 5, (k : ZMod 5) = k' := ⟨(k : ZMod 5), rfl⟩
