theorem GlobalTheory.CompanionTheory.KLowSpan.kcomm_apply (hF : KRel ε F) {i j a b : Fin n} (hij : ε i = ε j) (hab : ε a = ε b) (u : U) :
    F i j (F a b u) = F a b (F i j u) +
      ((if j = a then F i b u else 0) - (if b = i then F a j u else 0)) := by sorry
