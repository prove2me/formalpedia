  have hh := ((Approximates.parameter 24 k (-9)).mul hk hu).replacePolynomial
    (inversePower9_eval k)
  convert hh using 1
  funext z
  rw [mean_inverse_eq hk, mul_pow]
  simp only [Rat.cast_zero,zpow_neg,zpow_natCast,inv_pow] <;> rfl

