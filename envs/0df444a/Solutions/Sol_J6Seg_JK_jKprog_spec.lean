    (RS.clean_of_lt (by decide)) (isInt_encK (kM _ _ _ _ _ _ _ _)) wr.reverse []
    (by rw [kS_W, List.append_nil]) (by simp [Ex.eval, top_encK (kM _ _ _ _ _ _ _ _), hwrl])
    Bx (NLogN.bnd_reverse bwr) trivial (by simp only [Ex.Bnd, top_encK (kM _ _ _ _ _ _ _ _)]; exact zm)
  rw [kS_uW, kS_TMP, List.append_nil, List.reverse_reverse, kS_uTMP] at s5
  have s6 := Sp.mvK (X := TMP) (Y := WR) (C := CM) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (kS B1 l [] im.reverse [] [] wr [] []) (.reg HM)
    (RS.clean_of_lt (by decide)) (isInt_encK (kM _ _ _ _ _ _ _ _)) wr []
    (by rw [kS_TMP, List.append_nil]) (by simp [Ex.eval, top_encK (kM _ _ _ _ _ _ _ _), hwrl])
    Bx bwr trivial (by simp only [Ex.Bnd, top_encK (kM _ _ _ _ _ _ _ _)]; exact zm)
  rw [kS_uTMP, kS_WR, List.append_nil, kS_uWR] at s6
  -- the imaginary part
  have s7 := Sp.mvK (X := IM) (Y := V) (C := CM) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (kS B1 l [] im.reverse [] [] [] wr.reverse []) (.reg HG)
