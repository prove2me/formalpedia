section Alg
variable (x h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ : ℝ)

/-- 3A: the real `pcE` (incl. J-term) is `x · (x u r² + (2 - xZ) r + ρ)` up to a nonzero factor. -/
theorem quad_pcE (hx : x ≠ 0) (hF : F ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0) :
    x * (x * (1 - h * x) * (b₁ / b) ^ 2 + (2 - x * ((1 - h * x) * F₁ / F)) * (b₁ / b)
      + rhoE h Q J x F b ((1 - h * x) * F₁ / F) (A / x) (b * A₁) ((b ^ 2 - F) / x))
    = pcE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ / (F ^ 2 * b ^ 2 * (1 - h * x) ^ 2) := by
  unfold pcE rhoE
  generalize hu_def : 1 - h * x = u at hu ⊢
  field_simp
  subst hu_def
  ring

/-- 3D: `x D′ + 2(D + h) - x RD = b² · (quadratic)` with `D′` the quotient-rule derivative. -/
theorem dmode_id (hx : x ≠ 0) (hF : F ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0) :
    x * ((x * (2 * b * b₁ - F₁) - (b ^ 2 - F)) / x ^ 2) + 2 * ((b ^ 2 - F) / x + h)
      - x * rdE h Q J x F b ((1 - h * x) * F₁ / F) (A / x) (b * A₁) ((b ^ 2 - F) / x) (b₁ / b)
          ((F - 1) / x)
    = b ^ 2 * (x * (1 - h * x) * (b₁ / b) ^ 2 + (2 - x * ((1 - h * x) * F₁ / F)) * (b₁ / b)
      + rhoE h Q J x F b ((1 - h * x) * F₁ / F) (A / x) (b * A₁) ((b ^ 2 - F) / x)) := by
  unfold rdE rhoE
  generalize hu_def : 1 - h * x = u at hu ⊢
  field_simp
  subst hu_def
  ring

end Alg

