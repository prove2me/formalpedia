section
-- Source module: Solutions.R6P18Cost
/-!
# Round six, Proposition 18: the cost

**`total6`**: the exact cost of a call of the Proposition 18 entry of `ext6` (setup, core with the
layout programs, Lemma 16 procedures with the round-six chunk cost `cChunk6`, teardown).
**`cost6`**: for every choice of the constants of the Proposition 14 call, the swap and the setup,
`total6 ≤ C · cU6 P n 1` whenever the side conditions `Par6` hold and the input has
`∏ t_i · r = T` records. The rows: layout `d`, rounds `ℓ + d`, chunk calls
`ℓ d^lamp (zsz p + 1)`, Kronecker products `(ℓ + log₂ p + 1)(ln p + 1)`, setup and moves `O(1)`
(all per bit, against `Ncost6 · (log lg n + 1)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError
open IntMul.Kappa.R6 IntMul.Kappa.R6.P18

/-- The logarithmic factor of the Kronecker products (`P18M.log18Need` for any `p ≥ 7`). -/
theorem log6 {P ℓ : ℕ} (hP7 : 7 ≤ P) (hℓP : ℓ ≤ P) :
    (((zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) + 2) *
      (zsz (((zsz ((2 * (kb P ℓ * 2 ^ ℓ + 2) + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) : ℕ) : ℝ) ≤
      84 * ((ℓ : ℝ) + Real.logb 2 P + 1) * (Real.log P + 1) := by
  set q := Nat.log 2 P with hqd
  have hq1 : 2 ^ q ≤ P := Nat.pow_log_le_self 2 (by omega)
  have hq2 : P < 2 ^ (q + 1) := Nat.lt_pow_succ_log_self (by norm_num) P
  have hnat := P18M.log_nat P ℓ q hP7 hℓP hq1 hq2
  have hPr : (0 : ℝ) < P := by exact_mod_cast (show 0 < P by omega)
  have hlog2 : (0.6931471803 : ℝ) < Real.log 2 := Real.log_two_gt_d9
  have hlogP : (q : ℝ) * Real.log 2 ≤ Real.log P := by
    have : ((2 ^ q : ℕ) : ℝ) ≤ (P : ℝ) := by exact_mod_cast hq1
    have h := Real.log_le_log (by positivity) this
    push_cast at h
    rwa [Real.log_pow] at h
  have hlb : (q : ℝ) ≤ Real.logb 2 P := by
    unfold Real.logb
    rw [le_div_iff₀ (by linarith)]
    exact hlogP
  have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg _
  have hℓ0 : (0 : ℝ) ≤ ℓ := Nat.cast_nonneg _
  have hA : ((ℓ + q + 7 : ℕ) : ℝ) ≤ 7 * ((ℓ : ℝ) + Real.logb 2 P + 1) := by
    push_cast; linarith
  have hB : ((4 * q + 12 : ℕ) : ℝ) ≤ 12 * (Real.log P + 1) := by
    push_cast; nlinarith
  have hcast := (Nat.cast_le (α := ℝ)).2 hnat
  rw [Nat.cast_mul (ℓ + q + 7) (4 * q + 12)] at hcast
  have h0A : (0 : ℝ) ≤ ((ℓ + q + 7 : ℕ) : ℝ) := Nat.cast_nonneg _
  have h0B : (0 : ℝ) ≤ ((4 * q + 12 : ℕ) : ℝ) := Nat.cast_nonneg _
  have hprod := mul_le_mul hA hB h0B (by linarith)
  calc _ ≤ _ := hcast
    _ ≤ _ := hprod
    _ = 84 * ((ℓ : ℝ) + Real.logb 2 P + 1) * (Real.log P + 1) := by ring

/-- `zsz p + 1 ≤ 2 (ln p + 1)`. -/
theorem zsz_log (p : ℕ) (hp : 1 ≤ p) : (zsz (p : ℤ) : ℝ) + 1 ≤ 2 * (Real.log p + 1) := by
  set q := Nat.log 2 p with hqd
  have hq1 : 2 ^ q ≤ p := Nat.pow_log_le_self 2 (by omega)
  have hq2 : p < 2 ^ (q + 1) := Nat.lt_pow_succ_log_self (by norm_num) p
  have hz : zsz (p : ℤ) ≤ q + 1 := zsz_nat_lt hq2
  have hlog2 : (0.6931471803 : ℝ) < Real.log 2 := Real.log_two_gt_d9
  have hlogP : (q : ℝ) * Real.log 2 ≤ Real.log p := by
    have : ((2 ^ q : ℕ) : ℝ) ≤ (p : ℝ) := by exact_mod_cast hq1
    have h := Real.log_le_log (by positivity) this
    push_cast at h
    rwa [Real.log_pow] at h
  have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg _
  have hzr : (zsz (p : ℤ) : ℝ) ≤ q + 1 := by exact_mod_cast hz
  nlinarith

/-- `ln p + 1 ≤ (x + 7)(ln b + 1)` at `p = 6 b^{1+x}`. -/
theorem logp_le (P : Prm) (n : ℕ) :
    Real.log (pP6 P n) + 1 ≤ ((P.x : ℝ) + 7) * (Real.log (bP6 n) + 1) := by
  have hb1 : (1 : ℝ) ≤ bP6 n := by exact_mod_cast bP6_pos n
  have hlb : 0 ≤ Real.log (bP6 n) := Real.log_nonneg hb1
  have e : ((pP6 P n : ℕ) : ℝ) = 6 * (bP6 n : ℝ) ^ (1 + P.x) := by
    show ((6 * bP6 n ^ (1 + P.x) : ℕ) : ℝ) = _; push_cast; ring
  rw [e, Real.log_mul (by norm_num) (by positivity), Real.log_pow]
  have h6 : Real.log 6 ≤ 5 := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 6 by norm_num); linarith
  have hx : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  push_cast
  nlinarith

/-- More lower bounds of `Ncost6`. -/
theorem Ncost6_ge' (P : Prm) (n : ℕ) (hp : 1 ≤ pP6 P n) :
    (ℓP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp + ((ℓP6 P n : ℝ) + Real.logb 2 (pP6 P n) + 1) ≤
      Ncost6 P n := by
  have hp1 : (1 : ℝ) ≤ pP6 P n := by exact_mod_cast hp
  have hl0 : 0 ≤ Real.log (pP6 P n) := Real.log_nonneg hp1
  have a0 : (0 : ℝ) ≤ dP6 P n := Nat.cast_nonneg _
  have a2 : 0 ≤ (dP6 P n : ℝ) * (pP6 P n : ℝ) ^ P.δ := by positivity
  have a4 : 0 ≤ (pP6 P n : ℝ) ^ P.δ := by positivity
  have a5 : 0 ≤ (ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ := by positivity
  unfold Ncost6 Ncost6R
  linarith

/-- `d + 1 ≤ Ncost6`. -/
theorem Ncost6_ge_d (P : Prm) (n : ℕ) (hp : 1 ≤ pP6 P n) : (dP6 P n : ℝ) + 1 ≤ Ncost6 P n := by
  have hp1 : (1 : ℝ) ≤ pP6 P n := by exact_mod_cast hp
  have hl0 : 0 ≤ Real.log (pP6 P n) := Real.log_nonneg hp1
  have a1 : 0 ≤ (ℓP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp := by positivity
  have a2 : 0 ≤ (dP6 P n : ℝ) * (pP6 P n : ℝ) ^ P.δ := by positivity
  have a3 : 0 ≤ (ℓP6 P n : ℝ) + Real.logb 2 (pP6 P n) := by
    have := Real.logb_nonneg (b := 2) (by norm_num) hp1; positivity
  have a4 : 0 ≤ (pP6 P n : ℝ) ^ P.δ := by positivity
  have a5 : 0 ≤ (ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ := by positivity
  unfold Ncost6 Ncost6R
  linarith

set_option maxHeartbeats 8000000 in
/-- **The cost of a Proposition 18 call at round six.** -/
theorem cost6_sol_aux (P : Prm) (hP : P.Ok) (C₀ Kc : ℝ) (Cs : ℕ) (hC₀ : 0 ≤ C₀) (hKc : 0 ≤ Kc) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (Ew : ℕ → ℕ) (K₀ n : ℕ), Par6 P Ew K₀ n →
    ∀ (ts : List ℕ) [NeZero ts.length], ts.length + 1 = dP6 P n →
      (∀ t ∈ ts, t = rP6 P n ∨ 2 * t = rP6 P n) → ts.prod * rP6 P n = TP6 P n →
      (total6 C₀ P.lamp Kc Cs (pP6 P n) (ℓP6 P n) (KP6 P n) ts : ℝ) ≤ C * cU6 P n 1 := by
  obtain ⟨cF, hcF⟩ : ∃ cF : ℕ, ∀ m : ℕ, KFM.fmB m = cF * (m + 1) *
      ((zsz ((m + 1 : ℕ) : ℤ) + 2) * (zsz (((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1)) :=
    ⟨_, fun m => by unfold KFM.fmB; simp only [Nat.mul_assoc]; rfl⟩
  have hx0 : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  have hcl0 : (0 : ℝ) ≤ (P.x : ℝ) + 7 := by linarith
  have hCs0 : (0 : ℝ) ≤ (Cs : ℝ) := Nat.cast_nonneg _
  have hcF0 : (0 : ℝ) ≤ (cF : ℝ) := Nat.cast_nonneg _
  have hC10 : 0 ≤ 12 * (Cs : ℝ) + 2 * 10 ^ 7 + 9 * 10 ^ 12 + 12 + 6 * C₀ * ((P.x : ℝ) + 7) +
      10 ^ 15 + 48000 * (cF : ℝ) * 84 * ((P.x : ℝ) + 7) := by
    have h1 : 0 ≤ C₀ * ((P.x : ℝ) + 7) := mul_nonneg hC₀ hcl0
    have h2 : 0 ≤ (cF : ℝ) * ((P.x : ℝ) + 7) := mul_nonneg hcF0 hcl0
    linarith
  refine ⟨4 * (12 * (Cs : ℝ) + 2 * 10 ^ 7 + 9 * 10 ^ 12 + 12 + 6 * C₀ * ((P.x : ℝ) + 7) +
      10 ^ 15 + 48000 * (cF : ℝ) * 84 * ((P.x : ℝ) + 7)), by linarith, ?_⟩
  intro Ew K₀ n H ts _ hDl hts hT
  obtain ⟨hG, hb64, hd3, hK6, hKl, hc3, hp7', hc8, hc9, hov, herr, hDlb, hbp, hew, hn1, hn2,
    hn3⟩ := H
  have hp1 : 1 ≤ pP6 P n := by have := b'P6_pos P n; show 1 ≤ 6 * b'P6 P n; omega
  have hpy : pP6 P n = 6 * b'P6 P n := rfl
  have hN1 := Ncost6_ge_d P n hp1
  have hN2 := Ncost6_ge' P n hp1
  have hlp0 := logp_le P n
  have hbL : Real.log (bP6 n) = Real.log (IntMul.lg n : ℝ) := rfl
  rw [hbL] at hlp0
