open IntMul IntMul.HvdH NLogN

theorem NLogN.FW.fwCost_le_add (q : Ref.Params) (kb Φm : ℕ) (hP : 1 ≤ q.P) (hK1 : 1 ≤ q.K) :
    fwCost q kb Φm ≤ 10 ^ 9 * q.K * (2 ^ q.logOuter * q.r * (q.P + 1) * (q.e + kb + 1) +
      2 ^ q.logOuter * (kb + 1) ^ 2) + 2 ^ q.logOuter * Φm := by sorry
