open Matrix Finset ProbabilityTheory

namespace ResolvingNRM.FRLower.ProofPlan

abbrev Policy := History → Fin 2 → ℝ

noncomputable def canonicalPolicy (T : ℕ) : Policy :=
  fun h => canonicalProb (T - h.length) (capAfter T h)

lemma validProb_canonicalPolicy (T : ℕ) (h : History) :
    ValidProb (canonicalPolicy T h) :=
  validProb_canonicalProb _ _

noncomputable def treeExp (p : Policy) : ℕ → History → (History → ℝ) → ℝ
  | 0, h, F => F h
  | k + 1, h, F => stepExp (p h) (fun w => treeExp p k (h ++ [w]) F)

def TreeIntegrable (p : Policy) : ℕ → History → (History → ℝ) → Prop
  | 0, _, _ => True
  | k + 1, h, F =>
      (∀ w, TreeIntegrable p k (h ++ [w]) F) ∧
        StepAbsIntegrable (p h) (fun w => treeExp p k (h ++ [w]) F)

inductive ExtSupported (p : Policy) : ℕ → History → History → Prop
  | zero (h : History) : ExtSupported p 0 h h
  | succ {k : ℕ} {h h' : History} (w : Window)
      (hw : 0 < markWeight (p h) w.1 w.2.1 w.2.2)
      (hk : ExtSupported p k (h ++ [w]) h') :
      ExtSupported p (k + 1) h h'

lemma ExtSupported.exists_suffix {p : Policy} {k : ℕ} {h h' : History}
    (hs : ExtSupported p k h h') :
    ∃ s : History, s.length = k ∧ h' = h ++ s := by
  induction hs with
  | zero h => exact ⟨[], rfl, by simp⟩
  | @succ k h h' w _ _ ih =>
    rcases ih with ⟨s, hslen, rfl⟩
    exact ⟨w :: s, by simp [hslen, Nat.add_comm], by simp⟩

lemma ExtSupported.append_split {p : Policy} {m n : ℕ} {h h'' : History}
    (hs : ExtSupported p (m + n) h h'') :
    ∃ h' : History, ExtSupported p m h h' ∧ ExtSupported p n h' h'' := by
  induction m generalizing h with
  | zero =>
    rw [Nat.zero_add] at hs
    exact ⟨h, ExtSupported.zero h, hs⟩
  | succ m ih =>
    rw [Nat.succ_add] at hs
    cases hs with
    | succ w hw hk =>
      rcases ih hk with ⟨h', hm, hn⟩
      exact ⟨h', ExtSupported.succ w hw hm, hn⟩

lemma treeExp_add_steps (p : Policy) (m n : ℕ) (h : History) (F : History → ℝ) :
    treeExp p (m + n) h F = treeExp p m h (fun h' => treeExp p n h' F) := by
  induction m generalizing h with
  | zero => simp [treeExp]
  | succ m ih =>
    rw [Nat.succ_add]
    simp only [treeExp]
    congr 1; ext w
    exact ih (h ++ [w])

lemma treeExp_const {p : Policy} (hp : ∀ h, ValidProb (p h)) (k : ℕ) (h : History) (c : ℝ) :
    TreeIntegrable p k h (fun _ => c) ∧ treeExp p k h (fun _ => c) = c := by
  induction k generalizing h with
  | zero => simp [TreeIntegrable, treeExp]
  | succ k ih =>
    simp only [TreeIntegrable, treeExp]
    have hchild : ∀ w, treeExp p k (h ++ [w]) (fun _ => c) = c := fun w => (ih (h ++ [w])).2
    refine ⟨⟨fun w => (ih (h ++ [w])).1, ?_⟩, ?_⟩
    · simp_rw [hchild]; exact stepAbsIntegrable_const (hp h) c
    · simp_rw [hchild]; exact stepExp_const c

lemma treeExp_nonneg_of_support {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) {F : History → ℝ}
    (hF : ∀ h', ExtSupported p k h h' → 0 ≤ F h') :
    0 ≤ treeExp p k h F := by
  induction k generalizing h with
  | zero => exact hF h (ExtSupported.zero h)
  | succ k ih =>
    simp only [treeExp]
    refine stepExp_nonneg_of_support (hp h) fun w hw => ?_
    exact ih (h ++ [w]) fun h' hk => hF h' (ExtSupported.succ w hw hk)

lemma treeExp_add {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) {F G : History → ℝ}
    (hF : TreeIntegrable p k h F) (hG : TreeIntegrable p k h G) :
    TreeIntegrable p k h (fun h' => F h' + G h') ∧
      treeExp p k h (fun h' => F h' + G h') = treeExp p k h F + treeExp p k h G := by
  induction k generalizing h with
  | zero => simp [TreeIntegrable, treeExp]
  | succ k ih =>
    rcases hF with ⟨hFc, hFs⟩
    rcases hG with ⟨hGc, hGs⟩
    have hchild := fun w => ih (h ++ [w]) (hFc w) (hGc w)
    have heq : (fun w => treeExp p k (h ++ [w]) (fun h' => F h' + G h')) =
        (fun w => treeExp p k (h ++ [w]) F + treeExp p k (h ++ [w]) G) := by
      ext w; exact (hchild w).2
    refine ⟨⟨fun w => (hchild w).1, ?_⟩, ?_⟩
    · rw [heq]; exact stepAbsIntegrable_add (hp h) hFs hGs
    · simp only [treeExp]; rw [heq]; exact stepExp_add (hp h) hFs hGs

lemma treeExp_mul_left {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) (c : ℝ) {F : History → ℝ}
    (hF : TreeIntegrable p k h F) :
    TreeIntegrable p k h (fun h' => c * F h') ∧
      treeExp p k h (fun h' => c * F h') = c * treeExp p k h F := by
  induction k generalizing h with
  | zero => simp [TreeIntegrable, treeExp]
  | succ k ih =>
    rcases hF with ⟨hFc, hFs⟩
    have hchild := fun w => ih (h ++ [w]) (hFc w)
    have heq : (fun w => treeExp p k (h ++ [w]) (fun h' => c * F h')) =
        (fun w => c * treeExp p k (h ++ [w]) F) := by
      ext w; exact (hchild w).2
    refine ⟨⟨fun w => (hchild w).1, ?_⟩, ?_⟩
    · rw [heq]; exact stepAbsIntegrable_mul_left (hp h) c hFs
    · simp only [treeExp]; rw [heq]; exact stepExp_mul_left (p h) c _

lemma treeExp_sub {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) {F G : History → ℝ}
    (hF : TreeIntegrable p k h F) (hG : TreeIntegrable p k h G) :
    TreeIntegrable p k h (fun h' => F h' - G h') ∧
      treeExp p k h (fun h' => F h' - G h') = treeExp p k h F - treeExp p k h G := by
  have hG' := treeExp_mul_left hp k h (-1) hG
  have heq : (fun h' => F h' - G h') = (fun h' => F h' + (-1) * G h') := by ext h'; ring
  have h := treeExp_add hp k h hF hG'.1
  refine ⟨?_, ?_⟩
  · rw [heq]; exact h.1
  · rw [heq, h.2, hG'.2]; ring

lemma treeExp_mono_of_support {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) {F G : History → ℝ}
    (hF : TreeIntegrable p k h F) (hG : TreeIntegrable p k h G)
    (hFG : ∀ h', ExtSupported p k h h' → F h' ≤ G h') :
    treeExp p k h F ≤ treeExp p k h G := by
  rw [← sub_nonneg, ← (treeExp_sub hp k h hG hF).2]
  refine treeExp_nonneg_of_support hp k h fun h' hs => ?_
  linarith [hFG h' hs]

lemma treeExp_bdd {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) {F : History → ℝ} (B : ℝ) (hB : 0 ≤ B)
    (hF : ∀ h', |F h'| ≤ B) :
    TreeIntegrable p k h F ∧ |treeExp p k h F| ≤ B := by
  induction k generalizing h with
  | zero => exact ⟨trivial, hF h⟩
  | succ k ih =>
    have hchild := fun w => ih (h ++ [w])
    have hint_s : StepAbsIntegrable (p h) (fun w => treeExp p k (h ++ [w]) F) :=
      stepAbsIntegrable_of_bdd (hp h) B hB (fun w => (hchild w).2)
    have hti : TreeIntegrable p (k + 1) h F := ⟨fun w => (hchild w).1, hint_s⟩
    refine ⟨hti, abs_le.mpr ⟨?_, ?_⟩⟩
    · have hc := treeExp_const hp (k + 1) h (-B)
      rw [← hc.2]
      exact treeExp_mono_of_support hp (k + 1) h hc.1 hti fun h' _ => (abs_le.mp (hF h')).1
    · have hc := treeExp_const hp (k + 1) h B
      rw [← hc.2]
      exact treeExp_mono_of_support hp (k + 1) h hti hc.1 fun h' _ => (abs_le.mp (hF h')).2

/-- The core recursive potential bound (used for both `Q₂` and the gated low-fare sum). -/
theorem treeExp_potential_bound
    (p : Policy) (V : History → ℝ) (v : ℝ)
    (hp : ∀ h, ValidProb (p h))
    (hv : 0 ≤ v)
    (hV : ∀ h, 0 ≤ V h)
    (hint : ∀ h, StepAbsIntegrable (p h) (fun w => V (h ++ [w])))
    (hdrift : ∀ h, stepExp (p h) (fun w => V (h ++ [w])) ≤ V h + v)
    (k : ℕ) (h : History) :
    TreeIntegrable p k h V ∧
      0 ≤ treeExp p k h V ∧
      treeExp p k h V ≤ V h + (k : ℝ) * v := by
  induction k generalizing h with
  | zero =>
    exact ⟨trivial, hV h, by simp [treeExp]⟩
  | succ k ih =>
    have hchild := fun w => ih (h ++ [w])
    let G : Window → ℝ := fun w => V (h ++ [w]) + (k : ℝ) * v
    have hG_int : StepAbsIntegrable (p h) G :=
      stepAbsIntegrable_add (hp h) (hint h) (stepAbsIntegrable_const (hp h) ((k : ℝ) * v))
    have hF_int : StepAbsIntegrable (p h) (fun w => treeExp p k (h ++ [w]) V) := by
      refine stepAbsIntegrable_of_le (hp h) hG_int fun w _ => ?_
      have h0 := (hchild w).2.1
      have hle := (hchild w).2.2
      have hG0 : 0 ≤ G w := by dsimp [G]; positivity [hV (h ++ [w])]
      rw [abs_of_nonneg h0, abs_of_nonneg hG0]
      exact hle
    have hnn : 0 ≤ treeExp p (k + 1) h V :=
      stepExp_nonneg_of_support (hp h) fun w _ => (hchild w).2.1
    have hle : treeExp p (k + 1) h V ≤ V h + ((k + 1 : ℕ) : ℝ) * v := by
      simp only [treeExp]
      calc
        stepExp (p h) (fun w => treeExp p k (h ++ [w]) V)
            ≤ stepExp (p h) G :=
              stepExp_mono_of_support (hp h) hF_int hG_int fun w _ => (hchild w).2.2
        _ = stepExp (p h) (fun w => V (h ++ [w])) + (k : ℝ) * v := by
              dsimp [G]
              rw [stepExp_add (hp h) (hint h) (stepAbsIntegrable_const (hp h) _), stepExp_const]
        _ ≤ (V h + v) + (k : ℝ) * v := by linarith [hdrift h]
        _ = V h + ((k + 1 : ℕ) : ℝ) * v := by push_cast; ring
    exact ⟨⟨fun w => (hchild w).1, hF_int⟩, hnn, hle⟩

/-! ### Bridge to `frTail` -/

theorem treeExp_histRev_eq_add_frTail
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (sel : (Fin 1 → ℝ) → Fin 2 → ℝ)
    (hsel : IsDLPSelector (tcInst r₁ r₂ hr₂ hr) sel)
    (T k : ℕ) (h : History) (hlen : h.length + k = T) :
    treeExp (canonicalPolicy T) k h (histRev T r₁ r₂) =
      histRev T r₁ r₂ h +
        frTail (tcInst r₁ r₂ hr₂ hr) sel k (fun _ => (capAfter T h : ℝ)) := by
  have hr₁ : 0 < r₁ := lt_trans hr₂ hr
  have hB : 0 ≤ r₁ * (T : ℝ) := by positivity
  have hRevBdd : ∀ h', |histRev T r₁ r₂ h'| ≤ r₁ * (T : ℝ) := fun h' => by
    rw [abs_of_nonneg (histRev_nonneg r₁ r₂ hr₂ hr T h')]
    exact histRev_le r₁ r₂ hr₂ hr T h'
  induction k generalizing h with
  | zero =>
    simp [treeExp, frTail]
  | succ k ih =>
    have hrem : T - h.length = k + 1 := by omega
    have hpol : canonicalPolicy T h = canonicalProb (k + 1) (capAfter T h) := by
      simp [canonicalPolicy, hrem]
    have hsel_eq := sel_div_lam_eq_canonicalProb r₁ r₂ hr₂ hr sel hsel (k + 1) (capAfter T h)
    have hfr : frTail (tcInst r₁ r₂ hr₂ hr) sel (k + 1) (fun _ => (capAfter T h : ℝ)) =
        stepExp (canonicalPolicy T h) (fun w =>
          let out := runWindow (tcInst r₁ r₂ hr₂ hr) (fun _ => (capAfter T h : ℝ)) (windowList w)
          out.1 + frTail (tcInst r₁ r₂ hr₂ hr) sel k out.2) := by
      simp only [frTail]
      rw [hsel_eq, ← hpol, windowValue_tcInst_eq_stepExp]
    have hchild_eq : ∀ w : Window,
        treeExp (canonicalPolicy T) k (h ++ [w]) (histRev T r₁ r₂) =
          histRev T r₁ r₂ h +
            (let out := runWindow (tcInst r₁ r₂ hr₂ hr) (fun _ => (capAfter T h : ℝ)) (windowList w)
             out.1 + frTail (tcInst r₁ r₂ hr₂ hr) sel k out.2) := by
      intro w
      have hlen' : (h ++ [w]).length + k = T := by simp; omega
      rw [ih (h ++ [w]) hlen']
      have happ := histRev_append_singleton r₁ r₂ hr₂ hr T h w
      dsimp only at happ ⊢
      rw [happ.1, ← happ.2]
      ring
    have hp := validProb_canonicalPolicy T h
    have hti := (treeExp_bdd (validProb_canonicalPolicy T) (k + 1) h (r₁ * (T : ℝ)) hB hRevBdd).1
    have hchild_int : StepAbsIntegrable (canonicalPolicy T h)
        (fun w => treeExp (canonicalPolicy T) k (h ++ [w]) (histRev T r₁ r₂)) := hti.2
    let g : Window → ℝ := fun w =>
      let out := runWindow (tcInst r₁ r₂ hr₂ hr) (fun _ => (capAfter T h : ℝ)) (windowList w)
      out.1 + frTail (tcInst r₁ r₂ hr₂ hr) sel k out.2
    have hg_eq : g = fun w =>
        treeExp (canonicalPolicy T) k (h ++ [w]) (histRev T r₁ r₂) - histRev T r₁ r₂ h := by
      ext w; dsimp [g]; linarith [hchild_eq w]
    have hg_int : StepAbsIntegrable (canonicalPolicy T h) g := by
      rw [hg_eq]
      exact stepAbsIntegrable_sub hp hchild_int (stepAbsIntegrable_const hp _)
    simp only [treeExp]
    have hfun : (fun w => treeExp (canonicalPolicy T) k (h ++ [w]) (histRev T r₁ r₂)) =
        (fun w => histRev T r₁ r₂ h + g w) := by
      ext w; exact hchild_eq w
    rw [hfun, stepExp_add hp (stepAbsIntegrable_const hp _) hg_int, stepExp_const, hfr]

theorem frTail_eq_treeExp_histRev
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (sel : (Fin 1 → ℝ) → Fin 2 → ℝ)
    (hsel : IsDLPSelector (tcInst r₁ r₂ hr₂ hr) sel)
    (T : ℕ) :
    frTail (tcInst r₁ r₂ hr₂ hr) sel T (initialCapacity T) =
      treeExp (canonicalPolicy T) T [] (histRev T r₁ r₂) := by
  have h := treeExp_histRev_eq_add_frTail r₁ r₂ hr₂ hr sel hsel T T [] (by simp)
  unfold initialCapacity
  simpa using h.symm

