        (lowerPolarizationPath path p) =
      lowerPolarizationPath path
        (ambientRotation (r := r) a b p) := by
  induction path generalizing p with
  | nil => rfl
  | cons i rest ih =>
      cases rest with
      | nil => rfl
      | cons j tail =>
          change
            ambientRotation (r := r) a b
              (polarization r n j i
