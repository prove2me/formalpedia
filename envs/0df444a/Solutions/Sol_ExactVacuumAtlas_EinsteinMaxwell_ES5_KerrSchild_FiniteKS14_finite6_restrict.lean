variable {I : Set ℝ} {f m N w p a F b A : ℝ → ℝ} {s h ε Q J : ℝ}
theorem solution (hS : FiniteBranch6 I s ε f m a F b A) {η : ℝ} (hη : 0 < η)
    (hηε : η ≤ ε) : FiniteBranch6 I s η f m a F b A := by
  have hsub : Set.Ioo (-η) η ⊆ Set.Ioo (-ε) ε := fun x hx => ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hsub0 : Set.Ioo 0 η ⊆ Set.Ioo 0 ε := fun x hx => ⟨hx.1, by linarith [hx.2]⟩
  have hinv : ε⁻¹ ≤ η⁻¹ := inv_anti₀ hη hηε
  exact
    { eps_pos := hη
      chart_tail := fun R hR => hS.chart_tail (show s + ε⁻¹ < R by
        have := Set.mem_Ioi.mp hR; linarith)
      cF := hS.cF.mono hsub
      cb := hS.cb.mono hsub
      cA := hS.cA.mono hsub
      matchF := hS.matchF.mono hsub0
      matchb := hS.matchb.mono hsub0
      matchA := hS.matchA.mono hsub0
      F0 := hS.F0
      b0 := hS.b0
      A0 := hS.A0 }
