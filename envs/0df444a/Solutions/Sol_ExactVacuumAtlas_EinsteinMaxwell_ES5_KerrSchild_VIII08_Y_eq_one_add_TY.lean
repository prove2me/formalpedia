theorem T_partial (N : ℕ) {R : ℝ} (hR : 3 ≤ R) : T (SN N) R = SN (N + 1) R - 1 := by
  induction N with
  | zero =>
      have h0 : SN 0 = fun _ : ℝ => (0 : ℝ) := by
        funext t; unfold SN; simp
      rw [h0, T_zero_apply]
      simp [SN, Yfun_zero_apply]
  | succ N ih =>
      rw [show SN (N + 1) = fun t => SN N t + Yfun N t from funext (SN_succ N)]
      rw [T_add (continuousOn_SN N) (continuousOn_Yfun N) hR, ih, ← Yfun_succ]
      rw [SN_succ (N + 1) R]
      ring

/-! ## The factorial tail -/

/-- The tail tends to zero (it is the tail of a convergent series). -/
theorem tail_tendsto (R : ℝ) : Tendsto (fun N => tail N R) atTop (𝓝 0) :=
  tendsto_sum_nat_add (fun k : ℕ => (R - 3) ^ k / (Nat.factorial k : ℝ))

/-- `Y t - SN N t` is the shifted tail of the Picard series. -/
theorem Y_sub_SN {N : ℕ} {t : ℝ} (ht : 3 ≤ t) : Y t - SN N t = ∑' k : ℕ, Yfun (k + N) t := by
  have hsum : Summable (fun n : ℕ => Yfun n t) := summable_Yfun ht
  have hshift := hsum.sum_add_tsum_nat_add N
  have hSN : SN N t = ∑ i ∈ Finset.range N, Yfun i t := rfl
  have hY : Y t = ∑' i, Yfun i t := rfl
  linarith [hshift]

/-- Pointwise factorial bound on the shifted series (norm form), valid on `[3, R]`. -/
theorem Yfun_shift_norm_le {N : ℕ} {t R : ℝ} (ht : 3 ≤ t) (htR : t ≤ R) (k : ℕ) :
    ‖Yfun (k + N) t‖ ≤ (R - 3) ^ (k + N) / (Nat.factorial (k + N) : ℝ) := by
  rw [Real.norm_eq_abs]
  have h1 : |Yfun (k + N) t| ≤ (t - 3) ^ (k + N) / (Nat.factorial (k + N) : ℝ) :=
    Yfun_bound_mem (k + N) (R := R) (le_trans ht htR) t ⟨ht, htR⟩
  have hpow : (t - 3) ^ (k + N) ≤ (R - 3) ^ (k + N) :=
    pow_le_pow_left₀ (by linarith) (by linarith) (k + N)
  exact le_trans h1 (div_le_div_of_nonneg_right hpow (by positivity))

/-- The shifted factorial series is summable. -/
theorem summable_tail (N : ℕ) (R : ℝ) :
    Summable (fun k : ℕ => (R - 3) ^ (k + N) / (Nat.factorial (k + N) : ℝ)) :=
  (Real.summable_pow_div_factorial (R - 3)).comp_injective
    (fun a b (h : a + N = b + N) => Nat.add_right_cancel h)

/-- Sup-norm bound for the difference `Y - SN N` on `[3, R]`. -/
theorem abs_Y_sub_SN_le {N : ℕ} {t R : ℝ} (ht : 3 ≤ t) (htR : t ≤ R) :
    |Y t - SN N t| ≤ tail N R := by
  have hnormsum : Summable (fun k : ℕ => ‖Yfun (k + N) t‖) := by
    refine Summable.of_norm_bounded (summable_tail N R) (fun k => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact Yfun_shift_norm_le ht htR k
  have h1 : |Y t - SN N t| = ‖∑' k : ℕ, Yfun (k + N) t‖ := by
    rw [Y_sub_SN ht, Real.norm_eq_abs]
  rw [h1, tail]
  exact le_trans (norm_tsum_le_tsum_norm hnormsum)
    (hnormsum.tsum_le_tsum (fun k => Yfun_shift_norm_le ht htR k) (summable_tail N R))

