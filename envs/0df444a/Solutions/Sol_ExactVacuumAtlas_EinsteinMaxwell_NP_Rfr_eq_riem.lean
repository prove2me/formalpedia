theorem solution (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (A B I J : Fin n) :
    Rfr g gi E Θ A B x I J = ∑ μ, ∑ ν, ∑ ρ, ∑ σ,
      E A μ x * E B ν x * Θ I ρ x * (riem g gi ρ σ μ ν x : ℂ) * E J σ x := by
  rw [Rfr_eq hF hx]
  simp only [Fom_eq hF hx, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Matrix.mul_apply, coMat, frMat,
    riemC, Matrix.map_apply, Matrix.of_apply, riem, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => ?_
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun ρ _ => Finset.sum_congr rfl fun σ _ => by ring
