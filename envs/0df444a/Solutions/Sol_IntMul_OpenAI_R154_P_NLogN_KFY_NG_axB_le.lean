theorem NG.t_big : 8 * pP n + 8 ≤ tN n k := by
  have hl := h.l_big
  have hp := h.p_le
  have h1 : 2 ^ (ℓP n - 1) ≤ tN n k := by unfold tN; exact p2le (by omega)
  have hc := cube_lt_pow (ℓP n) (by omega)
  have h2 : 2 ^ ℓP n = 2 * 2 ^ (ℓP n - 1) := by
    rw [← pow_succ']; congr 1; omega
  have h3 : 8 * pP n + 8 ≤ 96 * ℓP n ^ 2 + 8 := by omega
  have h4 : 96 * ℓP n ^ 2 + 8 ≤ 36 * ℓP n ^ 3 := by
    have : 3 ≤ ℓP n := by omega
    nlinarith [Nat.mul_le_mul_left (ℓP n ^ 2) this]
  omega

open _root_.NLogN.KFY.NG hiding Lb bl casesOn d5 dbig mk nf rec recOn win2 α4
open _root_.IntMul.OpenAI.R154.P.NLogN.KFY.NG
theorem NG.t2s : tN n k < 2 * IntMul.OpenAI.R154.P.NLogN.KFM.srcN n k := by
  have hw := h.win2 k hk
  have hd4 := h.d4
  by_contra hc
  push Not at hc
  set D := 4 * IntMul.OpenAI.R154.dP n - 2 with hD
  have e : 4 * IntMul.OpenAI.R154.dP n = D + 2 := by omega
  rw [e] at hw
  have h1 : D * (2 * IntMul.OpenAI.R154.P.NLogN.KFM.srcN n k) ≤ D * tN n k := Nat.mul_le_mul_left _ hc
  have hD14 : 14 ≤ D := by omega
  nlinarith

open _root_.NLogN.KFY.NG hiding Lb bl casesOn d5 dbig mk nf rec recOn win2 α4
open _root_.IntMul.OpenAI.R154.P.NLogN.KFY.NG
theorem NG.ts1 : tN n k / IntMul.OpenAI.R154.P.NLogN.KFM.srcN n k ≤ 1 := by
  have h1 := h.t2s hk
  have hs : 0 < IntMul.OpenAI.R154.P.NLogN.KFM.srcN n k := (IntMul.OpenAI.R154.P.NLogN.KFY.axF h.nf k hk).s0
  have : tN n k / IntMul.OpenAI.R154.P.NLogN.KFM.srcN n k < 2 := (Nat.div_lt_iff_lt_mul hs).2 (by omega)
  omega

open _root_.NLogN.KFY.NG hiding Lb bl casesOn d5 dbig mk nf rec recOn win2 α4
open _root_.IntMul.OpenAI.R154.P.NLogN.KFY.NG
theorem NG.zt : zsz ((tN n k : ℕ) : ℤ) ≤ pP n + 1 := by
  have h1 := (IntMul.OpenAI.R154.P.NLogN.KFY.axF h.nf k hk).tr
  have h2 : tN n k < 2 ^ (ℓP n + 1) := lt_of_le_of_lt h1 (Nat.pow_lt_pow_right (by norm_num) (by omega))
  have := NLogN.KFY.zN h2
  have := h.lp
  omega

