section
/-!
# The jump function of `H(ℤ)`: germs, logarithmic derivatives, translation germ

For `f ∈ H(ℤ)` and a real `t`, the one-sided germs of `f` at `t` are Möbius maps `mob γ₋`,
`mob γ₊`, and `log f'₊(t) - log f'₋(t) = log (mu γ₋ t)² - log (mu γ₊ t)²` (`jumpFun`, real
valued: the lamps are `(ℝ, +)`). At `∞` we record instead the translation amount `tau f` of the
germ of `f` at `+∞` (an element of `SL(2, ℤ)` fixing `∞` acts as `x ↦ x + n`). Since `∞` is fixed
by `H(ℤ)`, `g ↦ jumpFun g` is a cocycle: `jumpFun (g h) x = jumpFun g (h x) + jumpFun h x`.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

/-- `H(ℤ)`. -/
abbrev HZ := H (⊥ : Subring ℝ)

lemma H_smul (g : H (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    g • x = (g : OnePoint ℝ ≃ₜ OnePoint ℝ) x := rfl

/-! ### Basic facts on `H(ℤ)` -/

/-! ### Chosen germs -/

/-- A Möbius matrix agreeing with `f` just left of `x` (`1` if there is none). -/
noncomputable def lg (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (x : OnePoint ℝ) : SLZ :=
  open Classical in
  if h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob g then h.choose else 1

lemma lg_spec {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob (lg f x) := by
  have h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob g := germL_of_mem_G hf x
  rw [lg, dif_pos h]
  exact h.choose_spec

/-! ### Logarithmic derivatives -/

/-! ### The translation germ at `+∞` -/

lemma upper_of_fix {k : SLZ} (h : mob k ∞ = ∞) :
    ent k 1 0 = 0 ∧ ent k 0 0 = ent k 1 1 ∧ ent k 1 1 * ent k 1 1 = 1 := by
  have hc : ent k 1 0 = 0 := by
    by_contra hc
    rw [mob_infty, if_neg hc] at h
    exact coe_ne_infty _ h
  have hdet := det_ent k
  rw [hc, mul_zero, sub_zero] at hdet
  obtain ⟨a, ha⟩ := ent_int k 0 0
  obtain ⟨d, hd⟩ := ent_int k 1 1
  rw [ha, hd] at hdet ⊢
  have hadZ : a * d = 1 := by exact_mod_cast hdet
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hadZ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    norm_num [hc]

lemma lg_fix {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ)) : mob (lg f ∞) ∞ = ∞ := by
  rw [← germ_value LF_le_nhds f.continuous (lg_spec hf.1 ∞)]
  exact hf.2

/-! ### The jump function and the cocycle identity -/

end FAmenHZ
end

section
/-!
# The action `H(ℤ) ↷ P_ℤ` is amenable: explicit Følner sets

Every `g ∈ H(ℤ)` is, near `+∞`, an integer translation `x ↦ x + n` (its germ at `∞` lies in the
stabiliser of `∞` in `PSL₂(ℤ)`). `P_ℤ` is invariant under `x ↦ x + 1`. Hence for `p ∈ P_ℤ` the
sets `{p + j : N ≤ j < N + L}` with `N` large are Følner sets for any finite subset of `H(ℤ)`:
`|g A Δ A| ≤ 2 |n_g|`. So the necessary condition "the action is amenable" for extensive
amenability holds, and holds on every `H(ℤ)`-orbit in `P_ℤ` (each contains `p + ℤ`).
-/

open OnePoint Filter Topology Set
open scoped symmDiff

namespace FAmenHZ

open Monod Monod.Dev.Dyn

/-- The translation `x ↦ x + j`, as an element of `SL(2, ℤ)`. -/
noncomputable def transl (j : ℤ) : SLZ :=
  ⟨!![1, (j : (⊥ : Subring ℝ)); 0, 1], by simp [Matrix.det_fin_two]⟩

lemma mob_transl (j : ℤ) (y : ℝ) :
    mob (transl j) (y : OnePoint ℝ) = ((y + j : ℝ) : OnePoint ℝ) := by
  rw [mob_coe]
  simp [transl, ent]

lemma add_mem_P {p : ℝ} (hp : (p : OnePoint ℝ) ∈ P (⊥ : Subring ℝ)) (j : ℤ) :
    ((p + j : ℝ) : OnePoint ℝ) ∈ P (⊥ : Subring ℝ) := by
  have := mob_mem_P' hp (transl j)
  rwa [mob_transl] at this

/-- Near `+∞`, every element of `H(ℤ)` is an integer translation. -/
lemma exists_shift (g : HZ) :
    ∃ (n : ℤ) (M : ℝ), ∀ y : ℝ, M < y →
      (g : OnePoint ℝ ≃ₜ OnePoint ℝ) y = ((y + n : ℝ) : OnePoint ℝ) := by
  obtain ⟨hc, ha, hd⟩ := upper_of_fix (lg_fix g.2)
  obtain ⟨β, hβ⟩ := ent_int (lg (g : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞) 0 1
  obtain ⟨δ, hδ⟩ := ent_int (lg (g : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞) 1 1
  have hd0 : ent (lg (g : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞) 1 1 ≠ 0 := by
    intro h0; rw [h0] at hd; simp at hd
  have e := lg_spec g.2.1 ∞
  rw [LF_infty] at e
  obtain ⟨M, hM⟩ := eventually_atTop.1 (eventually_map.1 e)
  refine ⟨β * δ, M, fun y hy => ?_⟩
  rw [hM y hy.le, mob_coe, hc, zero_mul, zero_add, if_neg hd0, ha]
  congr 1
  push_cast
  rw [← hβ, ← hδ, div_eq_iff hd0]
  linear_combination (-(ent (lg (g : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞) 0 1)) * hd

lemma card_Ico_symmDiff_shift (a b n : ℤ) :
    ((Finset.Ico (a + n) (b + n)) ∆ (Finset.Ico a b)).card ≤ 2 * n.natAbs := by
  rw [symmDiff_def]
  refine (Finset.card_union_le _ _).trans ?_
  have h1 : Finset.Ico (a + n) (b + n) \ Finset.Ico a b ⊆
      Finset.Ico (a + n) a ∪ Finset.Ico b (b + n) := by
    intro j hj
    simp only [Finset.mem_sdiff, Finset.mem_Ico, Finset.mem_union] at hj ⊢
    omega
  have h2 : Finset.Ico a b \ Finset.Ico (a + n) (b + n) ⊆
      Finset.Ico a (a + n) ∪ Finset.Ico (b + n) b := by
    intro j hj
    simp only [Finset.mem_sdiff, Finset.mem_Ico, Finset.mem_union] at hj ⊢
    omega
  have c1 := (Finset.card_le_card h1).trans (Finset.card_union_le _ _)
  have c2 := (Finset.card_le_card h2).trans (Finset.card_union_le _ _)
  simp only [Int.card_Ico] at c1 c2
  omega

open Classical in
/-- **Følner sets** for `H(ℤ) ↷ P_ℤ`: inside `p + ℤ` for any `p ∈ P_ℤ`. -/
theorem exists_foelner {p : ℝ} (hp : (p : OnePoint ℝ) ∈ P (⊥ : Subring ℝ)) (S : Finset HZ)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ A : Finset (OnePoint ℝ), A.Nonempty ∧ (↑A : Set (OnePoint ℝ)) ⊆ P (⊥ : Subring ℝ) ∧
      (∀ x ∈ A, ∃ j : ℤ, x = ((p + j : ℝ) : OnePoint ℝ)) ∧
      ∀ s ∈ S, (((A.image (fun x => s • x)) ∆ A).card : ℝ) ≤ ε * A.card := by
  classical
  choose n M hnM using exists_shift
  -- one threshold and one shift bound for all of `S`
  set K : ℕ := ∑ s ∈ S, (n s).natAbs with hK
  obtain ⟨N, hN⟩ := exists_nat_gt (∑ s ∈ S, |M s| - p)
  obtain ⟨L, hL⟩ := exists_nat_gt (2 * K / ε)
  set e : ℤ → OnePoint ℝ := fun j => ((p + j : ℝ) : OnePoint ℝ) with he
  have e_inj : Function.Injective e := by
    intro i j hij
    have := coe_injective hij
    exact_mod_cast (add_left_cancel this)
  set X : Finset ℤ := Finset.Ico (N : ℤ) (N + (L + 1 : ℕ)) with hX
  refine ⟨X.image e, ?_, ?_, ?_, ?_⟩
  · refine Finset.Nonempty.image ?_ _
    exact ⟨N, by simp [hX]⟩
  · intro x hx
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hx
    exact add_mem_P hp j
  · intro x hx
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hx
    exact ⟨j, rfl⟩
  · intro s hs
    have hMs : M s < p + N := by
      have h1 : |M s| ≤ ∑ t ∈ S, |M t| :=
        Finset.single_le_sum (f := fun t => |M t|) (fun t _ => abs_nonneg _) hs
      linarith [le_abs_self (M s)]
    have hshift : (X.image e).image (fun x => s • x) =
        (Finset.Ico ((N : ℤ) + n s) (N + (L + 1 : ℕ) + n s)).image e := by
      rw [Finset.image_image]
      have : (Finset.Ico ((N : ℤ) + n s) (N + (L + 1 : ℕ) + n s)) = X.image (· + n s) := by
        rw [hX, Finset.image_add_right_Ico]
      rw [this, Finset.image_image]
      refine Finset.image_congr fun j hj => ?_
      simp only [Function.comp_apply, he, H_smul]
      have hj' : (N : ℤ) ≤ j := (Finset.mem_Ico.1 hj).1
      have hjR : M s < p + j := by
        have : (N : ℝ) ≤ j := by exact_mod_cast hj'
        linarith
      rw [hnM s (p + j) hjR]
      push_cast
      ring_nf
    rw [hshift, ← Finset.image_symmDiff _ _ e_inj]
    have hcardA : (X.image e).card = L + 1 := by
      rw [Finset.card_image_of_injective _ e_inj, hX, Int.card_Ico]
      omega
    have hc := (Finset.card_image_le (s := (Finset.Ico ((N : ℤ) + n s) (N + (L + 1 : ℕ) + n s)) ∆ X)
      (f := e)).trans (card_Ico_symmDiff_shift _ _ (n s))
    have hKs : (n s).natAbs ≤ K := by
      rw [hK]
      exact Finset.single_le_sum (f := fun t => (n t).natAbs) (fun t _ => Nat.zero_le _) hs
    rw [hcardA]
    have : ((((Finset.Ico ((N : ℤ) + n s) (N + (L + 1 : ℕ) + n s)) ∆ X).image e).card : ℝ)
        ≤ 2 * K := by
      have : (((Finset.Ico ((N : ℤ) + n s) (N + (L + 1 : ℕ) + n s)) ∆ X).image e).card ≤ 2 * K := by
        omega
      exact_mod_cast this
    refine this.trans ?_
    have hL' : 2 * (K : ℝ) < ε * L := by
      rw [div_lt_iff₀ hε] at hL
      linarith
    push_cast
    nlinarith

end FAmenHZ
end

section
/-! `chk_exists_foelner_P_bot`: the prove2.me statement `ThompsonAmenability.exists_foelner_P_bot`, copied verbatim and renamed, proved by `FAmenHZ.exists_foelner`. -/

namespace ThompsonAmenability

end ThompsonAmenability
end

section
open ThompsonAmenability
open Classical in
theorem solution {p : ℝ} (hp : (p : OnePoint ℝ) ∈ Monod.P (⊥ : Subring ℝ))
    (S : Finset (Monod.H (⊥ : Subring ℝ))) {ε : ℝ} (hε : 0 < ε) :
    ∃ A : Finset (OnePoint ℝ), A.Nonempty ∧ (↑A : Set (OnePoint ℝ)) ⊆ Monod.P (⊥ : Subring ℝ) ∧
      (∀ x ∈ A, ∃ j : ℤ, x = ((p + j : ℝ) : OnePoint ℝ)) ∧
      ∀ s ∈ S, ((symmDiff (A.image (fun x => s • x)) A).card : ℝ) ≤ ε * A.card := by
  exact FAmenHZ.exists_foelner hp S hε
end
