set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFV

open IntMul KFC KFT KFU KFB KFH AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## 1. Index arithmetic and closed forms -/

/-! ## 2. The Gaussian result -/

/-! ## 3. Records -/

/-! ## 4. The program -/

theorem cTw_le (N r w : ℕ) (hN : 1 ≤ N) (hr : 1 ≤ r) :
    cTw N r w ≤ 3 * 10 ^ 5 * (w + 1) * (N * r + N + 1) := by
  have h1 := cDblI_le N (2 * r) w
  have h2 := cUnpadI_le N (2 * r) (4 * r) w (by omega)
  have h3 := cRotF_le N (2 * r) 2 w hN (by omega) (by omega)
  have hz1 := zsz_nat_le N; have hz2 := zsz_nat_le (2 * r)
  have hz3 : zsz ((2 : ℕ) : ℤ) ≤ 2 := zsz_nat_le 2
  unfold cTw cRotC
  simp only [kap] at h3
  push_cast at hz1 hz2 hz3 ⊢
  nlinarith [Nat.zero_le (N * r * w), Nat.zero_le (N * w), Nat.zero_le w, Nat.mul_pos hN hr]

end NLogN.KFV

