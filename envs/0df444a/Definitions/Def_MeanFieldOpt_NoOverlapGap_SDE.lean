-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-10-04T03:43:40.546077+00:00
-- url     : https://prove2.me/theorems/59c751a5-ccb5-4122-92f3-e89f4bae9edf
-- title:
--   Strong solution of the SDE (6.3): $dX_t=\xi''(t)\gamma(t)\partial_x\Phi^\gamma(t,X_t)\,dt+\sqrt{\xi''(t)}\,dB_t$, $X_0=0$
-- statement:
--   Let $\xi$ be a mixture, $\gamma \in \mathscr L$ and $\Phi = \Phi^\gamma$. Let $(B_t)_{t\ge0}$ be a real process on a probability space $(\Omega, \mathcal F, \mathbb P)$. A real process $(X_t)_{t\ge 0}$ **solves the SDE (6.3)**
--
--   $$dX_t = \xi''(t)\gamma(t)\,\partial_x\Phi(t, X_t)\,dt + \sqrt{\xi''(t)}\, dB_t, \qquad X_0 = 0,$$
--
--   if it is a strong solution of this equation on $[0,1]$: $X$ has continuous paths, is adapted to the completed filtration generated by $B$, starts at $0$, and almost surely, for all $t$,
--
--   $$X_t = \int_0^t \xi''(s)\gamma(s)\,\partial_x\Phi(s,X_s)\,ds + \int_0^t \sqrt{\xi''(s)}\, dB_s ,$$
--
--   the last term being an Itô integral.
--
--   This process is the one along which the paper evaluates the expectations $\mathbb E\{\partial_x\Phi(t,X_t)^2\}$ that appear in the first variation of the Parisi functional and in the stationarity conditions.
--
--   **Formalization Note** The predicate is the published definition `EthierKurtz.SolvesBrownianSDE` in dimension $d = 1$ (states and Brownian increments are one-dimensional Euclidean vectors), with initial value $0$. Its coefficients are defined for all times $t \ge 0$, so the drift is extended by $0$ for $t \ge 1$ and the diffusion coefficient by $0$ for $t > 1$; only $[0,1]$ matters. $\partial_x\Phi$ is `deriv` of $\Phi^\gamma(t,\cdot)$. The predicate does not itself require $B$ to be a Brownian motion; every statement using it assumes `IsBrownianReal B ℙ`.
-- source:
--   El Alaoui, Montanari, Sellke, Optimization of Mean-field Spin Glasses, arXiv:2001.00904v1, p. 23, Eq. (6.3); p. 26, Lemma 6.5 (unique strong solution)

import Mathlib
import Definitions.Def_EthierKurtz_SolvesBrownianSDE
import Definitions.Def_MeanFieldOpt_NoOverlapGap_Parisi

open MeasureTheory ProbabilityTheory Set
open scoped NNReal

namespace MeanFieldOpt.NoOverlapGap

/-- Drift of the SDE (6.3), p. 23, as a coefficient on `ℝ≥0 × ℝ¹`:
`ξ''(t) γ(t) ∂_xΦ^γ(t, x)` for `t < 1`, extended by `0` for `t ≥ 1`. -/
noncomputable def parisiDrift (ξ : Mixture) (γ : ℝ → ℝ) :
    ℝ≥0 × EthierKurtz.SDEState 1 → EthierKurtz.SDEState 1 :=
  fun p => WithLp.toLp 2 (fun _ : Fin 1 =>
    if (p.1 : ℝ) < 1 then
      ξ.xi'' p.1 * γ p.1 * deriv (fun y => PhiL ξ γ p.1 y) (p.2 0)
    else 0)

/-- Diffusion coefficient of the SDE (6.3): `√(ξ''(t))` for `t ≤ 1`, extended by `0` for `t > 1`. -/
noncomputable def parisiDiffusion (ξ : Mixture) :
    ℝ≥0 × EthierKurtz.SDEState 1 → EthierKurtz.SDEDiffusion 1 :=
  fun p => WithLp.toLp 2 (fun _ : Fin 1 × Fin 1 =>
    if (p.1 : ℝ) ≤ 1 then Real.sqrt (ξ.xi'' p.1) else 0)

/-- A real process viewed as an `ℝ¹`-valued process. -/
def toState1 {Ω : Type*} (Y : ℝ≥0 → Ω → ℝ) : ℝ≥0 → Ω → EthierKurtz.SDEState 1 :=
  fun t ω => WithLp.toLp 2 (fun _ : Fin 1 => Y t ω)

/-- `X` is a strong solution of the SDE (6.3), p. 23,
`dX_t = ξ''(t) γ(t) ∂_xΦ^γ(t, X_t) dt + √(ξ''(t)) dB_t`, `X_0 = 0`,
driven by the real process `B` on `(Ω, P)`, in the sense of the published definition
`EthierKurtz.SolvesBrownianSDE` with `d = 1` (coefficients extended by `0` after time `1`). -/
def SolvesParisiSDE {Ω : Type*} [MeasurableSpace Ω] (ξ : Mixture) (γ : ℝ → ℝ)
    (P : Measure Ω) (B X : ℝ≥0 → Ω → ℝ) : Prop :=
  EthierKurtz.SolvesBrownianSDE P (parisiDiffusion ξ) (parisiDrift ξ γ) (toState1 B)
    (fun _ => 0) (toState1 X)

end MeanFieldOpt.NoOverlapGap


