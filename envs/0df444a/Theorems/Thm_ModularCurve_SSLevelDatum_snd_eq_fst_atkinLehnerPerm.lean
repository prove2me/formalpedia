theorem ModularCurve.SSLevelDatum.snd_eq_fst_atkinLehnerPerm
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [CharP K p] [DecidableEq K] {M s : ℕ} [NeZero M] [NeZero s]
    (X : SSLevelDatum p K M s) (W : ↥(ssPlaces p (M * s) K)) :
