    (c := ((χ (d038 S (d004 v u)) : ℂˣ) : ℂ) * ((epsS v u : ℂˣ) : ℂ)) (fun p => ?_) hne
  rw [t0528 archR archC dR dC hω hωunr hωb hωR hωC d dF g hv hu p,
