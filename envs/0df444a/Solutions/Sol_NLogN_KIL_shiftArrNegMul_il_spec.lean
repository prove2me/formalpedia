theorem length_flatten_const (L : List (List ℤ)) (B : ℕ) (h : ∀ x ∈ L, x.length = B) :
    L.flatten.length = L.length * B := by
  rw [← List.flatMap_id', length_fm_const _ _ B h]

theorem length_refBlk (r : ℕ → ℕ → List ℤ) (Q B : ℕ) (as : ℕ → ℕ)
    (hr : ∀ p y, (r p y).length = B) (has : ∀ p, as p < Q) (p : ℕ) :
    (refBlk r Q as p).length = Q * B := by
  have hF : ∀ x ∈ (NLogN.KIL.FR r as p).reverse, x.length = B := by
    intro x hx; simp only [NLogN.KIL.FR, List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, -, rfl⟩ := hx; exact hr _ _
  have hS : ∀ x ∈ (SR r Q as p).reverse, x.length = B := by
    intro x hx; simp only [SR, List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, -, rfl⟩ := hx; exact hr _ _
  rw [refBlk, List.length_append, length_flatten_const _ B hF, length_flatten_const _ B hS]
  simp only [List.length_reverse, NLogN.KIL.FR, SR, List.length_map, List.length_range, List.length_range']
  have := has p
  rw [← Nat.add_mul, show as p + 1 + (Q - (as p + 1)) = Q by omega]

theorem length_outN (r : ℕ → ℕ → List ℤ) (P Q B : ℕ) (as : ℕ → ℕ)
    (hr : ∀ p y, (r p y).length = B) (has : ∀ p, as p < Q) :
    (outN r Q as P).length = P * (Q * B) := by
  unfold outN; rw [length_fm_const _ _ (Q * B) (fun p _ => length_refBlk r Q B as hr has p)]; simp

theorem bnd_refBlk (r : ℕ → ℕ → List ℤ) (Q Bb : ℕ) (as : ℕ → ℕ) (hb : ∀ p y, Bnd Bb (r p y))
    (p : ℕ) : Bnd Bb (refBlk r Q as p) := by
  have h : ∀ L : List ℕ, Bnd Bb ((L.map (r p)).reverse.flatten) := fun L z hz => by
    obtain ⟨x, hx, hz⟩ := List.mem_flatten.1 hz
    simp only [List.mem_reverse, List.mem_map] at hx; obtain ⟨y, -, rfl⟩ := hx; exact hb _ _ z hz
  exact bnd_append (h _) (h _)

theorem negP_sp (s : IState HS) (r : ℕ → ℕ → List ℤ) (P Q B Bb : ℕ) (as : ℕ → ℕ)
    (hr : ∀ p y, (r p y).length = B) (hb : ∀ p y, Bnd Bb (r p y))
    (has : ∀ p, as p < Q) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P)
    (hV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) :
    Sp NLogN.KIL.negP (NLogN.KIL.encK s (toF (rIO (inR r Q P) ((List.range P).map (fun p => (as p : ℤ))) P Q B)))
      (NLogN.KIL.encK s (toF (rIO (outN r Q as P) [] P Q B))) (cNeg P Q B Bb) := by
  have hle : ∀ n : ℕ, n ≤ P * (Q * B) → zsz (n : ℤ) ≤ Bb := fun n hn => le_trans (NLogN.KIL.zsz_nat_le hn) hV
  have zP := hle P (Nat.le_mul_of_pos_right _ (Nat.mul_pos hQ1 hB1))
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ hB1) (Nat.le_mul_of_pos_left _ hP1))
  have zB := hle B (le_trans (Nat.le_mul_of_pos_left _ hQ1) (Nat.le_mul_of_pos_left _ hP1))
  have zQB : zsz ((Q : ℤ) * B) ≤ Bb := by
    have := hle (Q * B) (Nat.le_mul_of_pos_left _ hP1); push_cast at this; exact this
  have zV : zsz ((P : ℤ) * ((Q : ℤ) * B)) ≤ Bb := by push_cast at hV; exact hV
  set rin := rIO (inR r Q P) ((List.range P).map (fun p => (as p : ℤ))) P Q B
  have p1 := Sp.pushQ s (toF rin) (i := 8) (e := .mul (.reg 1) (.mul (.reg 2) (.reg 4))) (B := Bb)
    (by decide) (clean_mul (clean_reg (by decide)) (clean_mul (clean_reg (by decide))
      (clean_reg (by decide))))
    ⟨ok_reg (l := []) rfl, ok_reg (l := []) rfl, ok_reg (l := []) rfl⟩
    ⟨bnd_reg (l := []) rfl zP, ⟨bnd_reg (l := []) rfl zQ, bnd_reg (l := []) rfl zB, by
      simp only [Ex.eval, top_encK', toF_q, toF_B, List.headD_cons, rin, rIO]; exact zQB⟩, by
      simp only [Ex.eval, top_encK', toF_q, toF_B, toF_P, List.headD_cons, rin, rIO]; exact zV⟩
  have e1 : Function.update (toF rin) 8 (Ex.eval (NLogN.KIL.encK s (toF rin))
      (.mul (.reg 1) (.mul (.reg 2) (.reg 4))) :: toF rin 8) = toF (nSt r P Q B as 0 []) := by
    simp only [Ex.eval, top_encK', toF_q, toF_B, toF_P, List.headD_cons, rin, rIO, toF_V, upd_V]
    congr 1
    simp [nSt, inR, List.range_eq_range']
  rw [e1] at p1
  have hloop := Sp.rep (C := 30) (n := .reg 1) (b := nBlk) (s := s)
    (F := fun p => toF (nSt r P Q B as p [])) (N := P) (B := Bb)
    (c := cNBlk Q B Bb) (by decide)
    (fun _ => rfl) (by decide) (clean_reg (by decide)) (ok_reg (l := []) rfl) trivial
    (bnd_reg (l := []) rfl zP) (eval_reg (l := []) rfl) (fun p hp => by
      rw [upd_k0, upd_k0]
      exact nBlk_sp s r P Q B Bb as hr hb has p hp zQ zB)
  have hlen := length_outN r P Q B as hr has
  have m1 := Sp.mvK (X := 12) (Y := 0) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF (nSt r P Q B as P [])) (.reg 8) (clean_reg (by decide))
    (ok_reg (l := []) rfl) (outN r Q as P).reverse [] (by rw [List.append_nil]; rfl)
    (by rw [eval_reg (l := []) rfl, List.length_reverse, hlen]; push_cast; ring) Bb
    (NLogN.KIL.bnd_reverse (bnd_flatMap fun p => bnd_refBlk r Q Bb as hb p)) trivial
    (bnd_reg (l := []) rfl zV)
  rw [upd_o, upd_x] at m1
  refine Sp.mono (Sp.congr (p1.seq (hloop.seq (m1.seq
    (Sp.pop (i := 8) (l := []) (B := Bb) s _ (by decide) rfl zV)))) ?_) ?_
  · rw [upd_V]
    congr 2
    simp [nSt, rIO, toF_x, outN]
  · rw [List.length_reverse, hlen]
    simp only [cNeg, Ex.size]
    omega

theorem ref_split (g : ℕ → List ℤ) {Q a : ℕ} (ha : a < Q) :
    ((List.range (a + 1)).map g).reverse.flatten ++
      ((List.range' (a + 1) (Q - (a + 1))).map g).reverse.flatten =
      (List.range Q).flatMap fun y => g ((a + Q - y) % Q) := by
  have e : List.range Q = List.range (a + 1) ++ (List.range (Q - (a + 1))).map (a + 1 + ·) := by
    rw [← List.range'_eq_map_range, List.range_eq_range', List.range_eq_range']
    have := List.range'_append (s := 0) (m := a + 1) (n := Q - (a + 1)) (step := 1)
    simp only [Nat.zero_add, Nat.one_mul, Nat.add_sub_cancel' (show a + 1 ≤ Q by omega)] at this
    exact this.symm
  rw [e, List.flatMap_append, List.flatMap_map, ← List.map_reverse, ← List.map_reverse,
    List.range_eq_range', List.reverse_range', List.reverse_range', List.map_map, List.map_map,
    ← List.flatMap_def, ← List.flatMap_def, ← List.range_eq_range']
  congr 1
  · refine fm_congr fun y hy => ?_
    simp only [List.mem_range] at hy
    simp only [Function.comp_apply]
    congr 1
    rw [show a + Q - y = (a - y) + Q by omega, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
    omega
  · refine fm_congr fun y hy => ?_
    simp only [List.mem_range] at hy
    simp only [Function.comp_apply]
    congr 1
    rw [Nat.mod_eq_of_lt (by omega)]
    omega

theorem outN_recR (xs : List ℤ) (P Q B : ℕ) (as : ℕ → ℕ) (has : ∀ p, as p < Q) :
    outN (recR xs Q B) Q as P = AModel.pull [P, Q, B] [P, Q, B] (refAddr Q as) 0 xs := by
  unfold AModel.pull
  rw [show AModel.vol [P, Q, B] = P * Q * B by simp [AModel.vol]; ring, map_range3]
  unfold outN
  refine fm_congr fun p hp => ?_
  simp only [List.mem_range] at hp
  rw [refBlk, NLogN.KIL.FR, SR, ref_split _ (has p)]
  refine fm_congr fun y hy => ?_
  simp only [List.mem_range] at hy
  unfold recR
  refine List.map_congr_left fun b hb => ?_
  simp only [List.mem_range] at hb
  rw [decode_three hp hy hb]
  simp [refAddr, encode, AModel.vol]
  ring_nf

theorem cNBlk_le {Q B Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    cNBlk Q B Bb ≤ 200000 * (Q * B) * (Bb + 2) := by
  unfold cNBlk NLogN.KIL.cMv
  have hQ : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB1
  have h1 : 1 ≤ Q * B := le_trans hQ1 hQ
  have h2 : Q * (Bb + 2) ≤ Q * B * (Bb + 2) := Nat.mul_le_mul_right _ hQ
  have h3 : (Bb + 2) ≤ Q * B * (Bb + 2) := by nlinarith
  nlinarith

theorem cNeg_le {P Q B Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    cNeg P Q B Bb ≤ 250000 * (P * (Q * B) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  unfold cNeg
  have hb := cNBlk_le (Bb := Bb) hB1 hQ1
  have h1 : 1 ≤ Q * B := Nat.mul_pos hQ1 hB1
  have h5 : P * (cNBlk Q B Bb + 8000 * (Bb + 2) + 30) ≤
      P * (200000 * (Q * B) * (Bb + 2) + 8000 * (Bb + 2) + 30) := by gcongr
  have h6 : P * (Bb + 2) ≤ P * (Q * B) * (Bb + 2) := by
    apply Nat.mul_le_mul_right; exact Nat.le_mul_of_pos_right _ h1
  have h7 : P ≤ P * (Q * B) * (Bb + 2) := by nlinarith
  have e : P * (200000 * (Q * B) * (Bb + 2) + 8000 * (Bb + 2) + 30) =
      200000 * (P * (Q * B)) * (Bb + 2) + 8000 * (P * (Bb + 2)) + 30 * P := by ring
  nlinarith

/-- **Block reflection.** With the array on `[P, Q, B]` on stack `0`, `P, Q, B` on stacks
`1, 2, 4` and offsets `a_p < Q` on stack `14`, `negP` replaces the array by
`pull [P, Q, B] [P, Q, B] (refAddr Q as) 0 xs` (record `y` of block `p` moves to
`(a_p − y) mod Q`), pops the offsets, restores every other stack; linear cost. -/
theorem negP_spec (t : IState HS) (xs : List ℤ) (as : ℕ → ℕ) (P Q B Bb : ℕ)
    (R L1 L2 L4 L14 : List Item) (has : ∀ p, as p < Q)
    (hlen : xs.length = P * Q * B) (hb : Bnd Bb xs) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P)
    (hV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int B :: L4)
    (h14 : t.G 14 = ints ((List.range P).map fun p => (as p : ℤ)) ++ L14) :
    NLogN.KIL.negP.ok t ∧ NLogN.KIL.negP.run t =
        (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (refAddr Q as) 0 xs) ++ R)).upd 14 L14 ∧
      NLogN.KIL.negP.cost t ≤ 250000 * (P * (Q * B) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  have H := negP_sp (rBase t R L1 L2 L4 L14) (recR xs Q B) P Q B Bb as
    (fun _ _ => length_recR xs Q B _ _)
    (fun _ _ a ha => by
      simp only [recR, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact bnd_getD hb _) has hB1 hQ1 hP1 hV
  rw [inR_recR hlen, outN_recR xs P Q B as has, encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4,
    encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4] at H
  have e : (t.upd 0 (ints xs ++ R)).upd 14 (ints ((List.range P).map fun p => (as p : ℤ)) ++ L14)
      = t := by
    rw [← h0, ← h14, IState.upd_self, IState.upd_self]
  rw [e] at H
  refine ⟨H.1, ?_, le_trans H.2.2 (cNeg_le hB1 hQ1)⟩
  rw [H.2.1]; simp [ints]

section ShiftNeg

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- The inverse of a controlled shift (any coefficient `u`) on `A ++ Q :: C`, target at `|A|`,
controls before the target. -/
theorem shiftInv_split_u [NeZero Q] (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (dA dC : List ℕ) (y : ℕ) (hA : (Λ.pos i : ℕ) = dA.length)
    (hD : Valid sh (dA ++ y :: dC)) :
    shiftInv Λ i u c (dA ++ y :: dC) =
      dA ++ ((u⁻¹ * ((y : ZMod Q) - ∑ j, c j * ((dA.getD (Λ.pos j) 0 : ℕ) : ZMod Q))).val) :: dC := by
  have hacti : act Λ (dA ++ y :: dC) i = (y : ZMod Q) := by
    unfold act; rw [hA, List.getD_append_right _ _ _ _ le_rfl]; simp
  have hsum : ∑ j, c j * act Λ (dA ++ y :: dC) j =
      ∑ j, c j * ((dA.getD (Λ.pos j) 0 : ℕ) : ZMod Q) := by
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hij : i ≤ j
    · simp [hc j hij]
    · push Not at hij
      have hlt : (Λ.pos j : ℕ) < Λ.pos i := Λ.mono hij
      unfold act; rw [List.getD_append _ _ _ _ (by omega)]
  unfold shiftInv
  rw [setAct_update_eq_set Λ hD, hacti, hsum, hA]
  simp

theorem val_sub_eq_mod' [NeZero Q] (y : ℕ) (hy : y < Q) (s : ZMod Q) :
    (s - (y : ZMod Q)).val = (s.val + Q - y) % Q := by
  have e : ((s.val + Q - y : ℕ) : ZMod Q) = s - (y : ZMod Q) := by
    rw [Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero, ZMod.natCast_zmod_val]
  rw [← e, ZMod.val_natCast]

/-- **Coefficient `-1` shift = block reflection.** -/
theorem shiftArr_neg_eq_ref [NeZero Q] {α : Type*} (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (d : α) (xs : List α) :
    shiftArr Λ i (-1) c d xs =
      AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (refAddr Q (offs Λ c A)) d xs := by
  have hv : AModel.vol sh = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [hsh, vol_append, vol_cons]; simp [AModel.vol]
  unfold shiftArr
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  have hval := valid_decode h2
  obtain ⟨p, y, b, hdec, hp, hy, hb⟩ : ∃ p y b, decode [AModel.vol A, Q, AModel.vol C] j = [p, y, b] ∧
      p < AModel.vol A ∧ y < Q ∧ b < AModel.vol C := by
    generalize decode [AModel.vol A, Q, AModel.vol C] j = D at hval
    rcases hval with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
    cases h
    exact ⟨_, _, _, rfl, hp, hy, hb⟩
  have hj : j = (p * Q + y) * AModel.vol C + b := by
    rw [← encode_decode h2, hdec]; simp [encode, AModel.vol]; ring
  have hlA : (decode A p).length = A.length := length_decode _ _
  have hDv : Valid sh (decode A p ++ y :: decode C b) := by
    rw [hsh]; exact valid_append (valid_decode hp) (List.Forall₂.cons hy (valid_decode hb))
  have henc : ∀ w, encode sh (decode A p ++ w :: decode C b) = (p * Q + w) * AModel.vol C + b := by
    intro w
    rw [hsh, encode_append_len _ _ hlA, encode_decode hp]
    simp only [encode, List.headD_cons, List.tail_cons, encode_decode hb, vol_cons]; ring
  have hdD : decode sh j = decode A p ++ y :: decode C b := by
    rw [← decode_encode hDv, henc, hj]
  rw [hdD, hdec, shiftInv_split_u Λ i (-1) c hc _ _ y (by rw [hA, hlA]) hDv, henc,
    ZMod.inv_neg_one, neg_one_mul, neg_sub, val_sub_eq_mod' y hy]
  simp [refAddr, encode, AModel.vol, offs]
  ring

/-- **Coefficient `-1` controlled shift, self-contained IL program.** -/
theorem shiftArrNeg_il_spec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : IState HS) (xs : List ℤ) (Bb : ℕ) (R : List Item)
    (hlen : xs.length = AModel.vol sh) (hb : Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) :
    (shN Q (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))).ok t ∧
      (shN Q (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))).run t =
        t.upd 0 (ints (shiftArr Λ i (-1) c 0 xs) ++ R) ∧
      (shN Q (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))).cost t ≤
        cShift A.length (AModel.vol A * (Q * AModel.vol C)) Bb := by
  set V := AModel.vol A * (Q * AModel.vol C)
  set ac := A.zip (csOf Λ c A)
  have hle : ∀ m : ℕ, m ≤ V → zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have zA := hle (AModel.vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ (by omega)) (Nat.le_mul_of_pos_left _ hP1))
  have zC := hle (AModel.vol C) (le_trans (Nat.le_mul_of_pos_left _ (by omega))
    (Nat.le_mul_of_pos_left _ hP1))
  have hfst : ac.map Prod.fst = A := List.map_fst_zip (by rw [length_csOf])
  have hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q := fun p hp =>
    ⟨one_le_of_vol hP1 _ (List.of_mem_zip hp).1, csOf_lt Λ c A p hp⟩
  have G := genP_spec t Q Bb ac (by omega) hQ2 hac (by rw [hfst]; exact zA)
  rw [hfst, tbl_eq_offs] at G
  set t1 := t.upd 14 (ints ((List.range (AModel.vol A)).map fun p => (offs Λ c A p : ℤ)) ++ t.G 14)
