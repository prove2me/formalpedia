  unfold nR; nlinarith [Nat.one_le_two_pow (n := t), Nat.mul_le_mul hB hS]

theorem alN_ge (W A : ℕ) : (A + W + 1) * 1000000 ≤ alN W A ∧ (W + 5) * 1000000 ≤ alN W A ∧
    (W * (W + 5) + 1) * 1000000 ≤ alN W A ∧ 4 * 1000000 + (W + 3) * 1000000 ≤ alN W A := by
  unfold alN
  have h : W + A + 10 ≤ (W + A + 10) ^ 3 := by
    calc W + A + 10 = (W + A + 10) ^ 1 := (pow_one _).symm
      _ ≤ (W + A + 10) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h2 : (W + A + 10) ^ 2 ≤ (W + A + 10) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩

theorem zsz_ph {W t S0 B r Z : ℕ} (hW : 1 ≤ W) (hr : 1 ≤ r) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) :
    zsz ((4 * (B * (S0 * r * 2 ^ t) + S0 * r + B + 1) : ℕ) : ℤ) ≤ Z := by
  refine le_trans (zsz_nat_le ?_) hZ
  have h1 : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have hb : 1 ≤ B * 2 ^ t := Nat.mul_le_mul hB h1
  have a1 : S0 * r ≤ B * 2 ^ t * S0 * r := by
    calc S0 * r = 1 * (S0 * r) := (one_mul _).symm
      _ ≤ (B * 2 ^ t) * (S0 * r) := Nat.mul_le_mul_right _ hb
      _ = B * 2 ^ t * S0 * r := by ring
  have h2 : 1 ≤ 2 ^ t * S0 * r := by
    have := Nat.mul_le_mul (Nat.mul_le_mul h1 hS) hr; simpa using this
  have a2 : B ≤ B * 2 ^ t * S0 * r := by
    calc B = B * 1 := (mul_one _).symm
      _ ≤ B * (2 ^ t * S0 * r) := Nat.mul_le_mul_left _ h2
      _ = B * 2 ^ t * S0 * r := by ring
  have a3 : 1 ≤ B * 2 ^ t * S0 * r := le_trans hB a2
  have e : W * nR t S0 B * r = W * (B * 2 ^ t * S0 * r) := by unfold nR; ring
  have e2 : B * (S0 * r * 2 ^ t) = B * 2 ^ t * S0 * r := by ring
  rw [e, e2]
  have a4 : B * 2 ^ t * S0 * r ≤ W * (B * 2 ^ t * S0 * r) := Nat.le_mul_of_pos_left _ hW
  omega

/-- A gate given by atoms. -/
theorem step_gate (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) {t S0 B : ℕ} (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hZ : zsz ((2 * (W * (nR t S0 B * r)) : ℕ) : ℤ) ≤ Z) (as : List KFG.Atom) (hA : as.length ≤ A)
    (hok : ∀ a ∈ as, a.Ok W ∧ a.h ≤ 1) (hts : KFG.NoTS as) (O : ℕ) (hO : dwloc W A + 5 ≤ O) :
    ∃ (code : RS) (e dw : ℕ) (cost : ℕ → ℕ), NLogN.KFD.fok code = true ∧
      RImpl r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.gate (KFG.gateMat W as) : RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ 1 ∧ dw ≤ dwloc W A ∧ ∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O) := by
  have hn := one_le_nR (t := t) hS hB
  refine ⟨_, _, _, _, fok_gateC W _ as, rImpl_gate (Butterfly.tens Cm) as hok hts (by omega) _ Z hZ,
    by unfold gδ; split_ifs <;> omega, by unfold dwloc; nlinarith, fun w => ?_⟩
  unfold cGateC
  set n := nR t S0 B
  set X := Xf r Ψ (w + O)
  have c1 := cAtom_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + 3 * as.length) (D := 1) hW hn hZΨ
  have c2 := cAtom_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + 3 * as.length + 3 * W) (D := 1) hW hn hZΨ
  have x1 : Xf r Ψ (w + 3 * as.length + 1 + 4) ≤ X := Xf_mono hΨm (by unfold dwloc at hO; omega)
  have x2 : Xf r Ψ (w + 3 * as.length + 3 * W + 1 + 4) ≤ X :=
    Xf_mono hΨm (by unfold dwloc at hO; omega)
  have hX : 2 ≤ X := by simp only [X]; unfold Xf; have := hZΨ (w + O); omega
  have hal := (alN_ge W A).1
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set Y := 1000000 * (W * n) * X
  have k1 : as.length * cAtom (w + 3 * as.length) 1 (n * r) W Z ≤ A * Y :=
    Nat.mul_le_mul hA (c1.trans (Nat.mul_le_mul_left _ x1))
  have k2 : W * cAtom (w + 3 * as.length + 3 * W) 1 (n * r) W Z ≤ W * Y :=
    Nat.mul_le_mul_left _ (c2.trans (Nat.mul_le_mul_left _ x2))
  have k3 : 2 ≤ Y := by simp only [Y]; nlinarith
  have k4 : (A + W + 1) * Y ≤ alN W A * (W * n) * X := by
    simp only [Y]
    have := Nat.mul_le_mul_right ((W * n) * X) hal
    calc (A + W + 1) * (1000000 * (W * n) * X) = (A + W + 1) * 1000000 * (W * n * X) := by ring
      _ ≤ alN W A * (W * n * X) := this
      _ = alN W A * (W * n) * X := by ring
  nlinarith

/-- A role permutation. -/
theorem step_perm (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) {t S0 B : ℕ} (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hZ : zsz ((2 * (W * (nR t S0 B * r)) : ℕ) : ℤ) ≤ Z) (σ : Equiv.Perm (Fin W)) (O : ℕ)
    (hO : dwloc W A + 5 ≤ O) :
    ∃ (code : RS) (e dw : ℕ) (cost : ℕ → ℕ), NLogN.KFD.fok code = true ∧
      RImpl r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.perm σ : RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ 1 ∧ dw ≤ dwloc W A ∧ ∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O) := by
  have hn := one_le_nR (t := t) hS hB
  refine ⟨_, _, _, _, fok_swapsP _ _, rImpl_perm (Butterfly.tens Cm) σ (by omega) _ Z hZ, by omega,
    by omega, fun w => ?_⟩
  set n := nR t S0 B
  set X := Xf r Ψ (w + O)
  have c1 := cAtom_X (r := r) (Ψ := Ψ) (Z := Z) (w := w) (D := 0) hW hn hZΨ
  have x1 : Xf r Ψ (w + 0 + 4) ≤ X := Xf_mono hΨm (by omega)
  have hX : 2 ≤ X := by simp only [X]; unfold Xf; have := hZΨ (w + O); omega
  have hal := (alN_ge W A).1
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set Y := 1000000 * (W * n) * X
  have k1 : W * cAtom w 0 (n * r) W Z ≤ W * Y := Nat.mul_le_mul_left _ (c1.trans (Nat.mul_le_mul_left _ x1))
  have k3 : 2 ≤ Y := by simp only [Y]; nlinarith
  have k4 : (A + W + 1) * Y ≤ alN W A * (W * n) * X := by
    simp only [Y]
    have := Nat.mul_le_mul_right ((W * n) * X) hal
    calc (A + W + 1) * (1000000 * (W * n) * X) = (A + W + 1) * 1000000 * (W * n * X) := by ring
      _ ≤ alN W A * (W * n * X) := this
      _ = alN W A * (W * n) * X := by ring
  nlinarith

/-- A phase step on one role. -/
theorem step_phase (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) {t S0 B : ℕ} (hpos : ∀ p, pos p < t) (hS : 1 ≤ S0)
    (hB : 1 ≤ B) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (w0 : Fin W) (k₀ k₁ : ℕ)
    (a : Fin m → ℕ) (O : ℕ) (hO : dwloc W A + 5 ≤ O) :
    ∃ (code : RS) (e dw : ℕ) (cost : ℕ → ℕ), NLogN.KFD.fok code = true ∧
      RImpl r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.phase w0 k₀ k₁ a : RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ 1 ∧ dw ≤ dwloc W A ∧ ∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O) := by
  have hn := one_le_nR (t := t) hS hB
  have hZ1 := zsz_ph (W := W) (r := r) (t := t) hW hr hS hB hZ
  have hZ2 : zsz ((2 * (W * (B * 2 ^ t * S0 * r)) : ℕ) : ℤ) ≤ Z := by
    refine le_trans (zsz_nat_le ?_) hZ
    have : W * nR t S0 B * r = W * (B * 2 ^ t * S0 * r) := by unfold nR; ring
    omega
  refine ⟨_, _, _, _, fok_wrapC _ _ _ _ (fok_phL _ _ _ _ _),
    rImpl_phaseStep (by omega) (by omega) pos t S0 B hpos (by omega) hB w0 k₀ k₁ a (Butterfly.tens Cm) Z hZ1 hZ2,
    by omega, by unfold dwloc; nlinarith, fun w => ?_⟩
  have h := wrapPh_X (r := r) (Z := Z) (w := w) (t := t) hW hS hB hΨm hZΨ
  have x1 : Xf r Ψ (w + 2 * W + 4) ≤ Xf r Ψ (w + O) := Xf_mono hΨm (by unfold dwloc at hO; omega)
  have hal := (alN_ge W A).2.1
  calc _ ≤ (W + 5) * 1000000 * (W * nR t S0 B) * Xf r Ψ (w + 2 * W + 4) := h
    _ ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O) :=
      Nat.mul_le_mul (Nat.mul_le_mul_right _ hal) x1

/-- A `±1` role diagonal (as phase steps). -/
theorem step_fixG (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) (hinj : Function.Injective pos) {t S0 B : ℕ}
    (hpos : ∀ p, pos p < t) (hS : 1 ≤ S0)
    (hB : 1 ≤ B) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (U : Finset (Fin W))
    (O : ℕ) (hO : dwloc W A + 5 ≤ O) :
    ∃ (code : RS) (e dw : ℕ) (cost : ℕ → ℕ), NLogN.KFD.fok code = true ∧
      RImpl r (nR t S0 B) (fun p => 2 ^ pos p * S0)
        ((RStep.gate (Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1) :
          RStep (Fin W) m).den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ 1 ∧ dw ≤ dwloc W A ∧ ∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O) := by
  have hn := one_le_nR (t := t) hS hB
  have hZ1 := zsz_ph (W := W) (r := r) (t := t) hW hr hS hB hZ
  have hZ2 : zsz ((2 * (W * (B * 2 ^ t * S0 * r)) : ℕ) : ℤ) ≤ Z := by
    refine le_trans (zsz_nat_le ?_) hZ
    have : W * nR t S0 B * r = W * (B * 2 ^ t * S0 * r) := by unfold nR; ring
    omega
  have hs : SLaws (fun p => 2 ^ pos p * S0) (nR t S0 B) := slaws_pow pos hinj t S0 B hpos
  set c0 := cWrapR W (B * 2 ^ t * S0 * r) Z 0 0 (fun w => cPhL w (B * (S0 * r * 2 ^ t)) t B Z)
  have H := rImpl_fixG (W := W) hs (Butterfly.tens Cm : Butterfly.Op (Fin (m ^ k))) U
    (phStepC W (nR t S0 B) r pos S0 t B) (fun _ => 0) (fun _ => 0 + (0 + 2) * W) (fun _ => c0)
    (fun a ha => by
      obtain ⟨w0, _, rfl⟩ := List.mem_map.1 ha
      exact rImpl_phaseStep (by omega) (by omega) pos t S0 B hpos (by omega) hB w0 2 0 0
        (Butterfly.tens Cm) Z hZ1 hZ2)
  have hlen : (negSteps (m := m) U.toList).length ≤ W := by
    rw [negSteps, List.length_map, Finset.length_toList]
    simpa using Finset.card_le_univ U
  refine ⟨_, _, _, _, fok_seqL _ ?_, H, by simp, ?_, fun w => ?_⟩
  · intro c hc
    obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hc
    obtain ⟨w0, _, rfl⟩ := List.mem_map.1 ha
    exact fok_wrapC _ _ _ _ (fok_phL _ _ _ _ _)
  · simp only [List.map_const', List.sum_replicate, smul_eq_mul]
    unfold dwloc
    have : (negSteps (m := m) U.toList).length * (0 + (0 + 2) * W) ≤ W * (2 * W) := by
      have := Nat.mul_le_mul_right (0 + (0 + 2) * W) hlen; simpa using this
    nlinarith
  · set n := nR t S0 B
    set bd := fun v => (W + 5) * 1000000 * (W * n) * Xf r Ψ (v + 2 * W + 4)
    have hbd : Monotone bd := fun a b h => Nat.mul_le_mul_left _ (Xf_mono hΨm (by omega))
    have C := costL_const c0 (0 + (0 + 2) * W) bd
      (fun v => wrapPh_X (r := r) (Z := Z) (w := v) (t := t) hW hS hB hΨm hZΨ) hbd
      (negSteps (m := m) U.toList) w
    set len := (negSteps (m := m) U.toList).length
    have x1 : bd (w + len * (0 + (0 + 2) * W)) ≤ (W + 5) * 1000000 * (W * n) * Xf r Ψ (w + O) := by
      simp only [bd]
      refine Nat.mul_le_mul_left _ (Xf_mono hΨm ?_)
      have : len * (0 + (0 + 2) * W) ≤ W * (2 * W) := by
        have := Nat.mul_le_mul_right (0 + (0 + 2) * W) hlen; simpa using this
      unfold dwloc at hO; nlinarith
    have hX : 2 ≤ Xf r Ψ (w + O) := by unfold Xf; have := hZΨ (w + O); omega
    have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
    have hal := (alN_ge W A).2.2.1
    have k1 : len * bd (w + len * (0 + (0 + 2) * W)) ≤
        W * ((W + 5) * 1000000 * (W * n) * Xf r Ψ (w + O)) := Nat.mul_le_mul hlen x1
    have k2 : (W * (W + 5) + 1) * 1000000 * (W * n * Xf r Ψ (w + O)) ≤
        alN W A * (W * n * Xf r Ψ (w + O)) := Nat.mul_le_mul_right _ hal
    have k3 : 1 ≤ W * n * Xf r Ψ (w + O) := by nlinarith
    calc costL (fun _ => c0) (fun _ => 0 + (0 + 2) * W) (negSteps U.toList) w
        ≤ len * bd (w + len * (0 + (0 + 2) * W)) + 1 := C
      _ ≤ W * ((W + 5) * 1000000 * (W * n) * Xf r Ψ (w + O)) + 1 := by omega
      _ ≤ alN W A * (W * n) * Xf r Ψ (w + O) := by nlinarith

theorem zsz_role2 {W t S0 B r Z : ℕ} (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) :
    zsz ((2 * (W * (B * 2 ^ t * S0 * r)) : ℕ) : ℤ) ≤ Z := by
  refine le_trans (zsz_nat_le ?_) hZ
  have : W * nR t S0 B * r = W * (B * 2 ^ t * S0 * r) := by unfold nR; ring
  omega

end Steps

end NLogN.KFN

