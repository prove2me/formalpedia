      (pd c v x * lowerK b k x i * lowerK b k x j
        + v x * pd c (fun y => lowerK b k y i) x * lowerK b k x j
        + v x * lowerK b k x i * pd c (fun y => lowerK b k y j) x) := by
  have hvi := (hD.diff_v hx).fun_mul (hD.diff_lowerK hx i)
  have e : ksMetric b v k i j = fun y => b i j y + v y * lowerK b k y i * lowerK b k y j := rfl
  rw [e, pd_add c (hD.diff_b hx i j) (hvi.fun_mul (hD.diff_lowerK hx j)),
    pd_mul c hvi (hD.diff_lowerK hx j), pd_mul c (hD.diff_v hx) (hD.diff_lowerK hx i)]
  ring

theorem lower_bchr {x : Pt 5} (hx : x ∈ U) (d j l : Fin 5) :
    ∑ i, b d i x * christoffel b bi i j l x =
      (pd l (b d j) x + pd j (b d l) x - pd d (b j l) x) / 2 :=
  lower_christoffel (hD.mul_inv hx) d j l

theorem bchr_symm {x : Pt 5} (hx : x ∈ U) (a p q : Fin 5) :
    christoffel b bi a p q x = christoffel b bi a q p x :=
  hD.bg.christoffel_symm hx a p q

theorem chrL_symm {x : Pt 5} (hx : x ∈ U) (c d : Fin 5) :
    chrL b bi k x c d = chrL b bi k x d c := by
  unfold chrL
  exact Finset.sum_congr rfl fun e _ => by rw [hD.bchr_symm hx e c d]

