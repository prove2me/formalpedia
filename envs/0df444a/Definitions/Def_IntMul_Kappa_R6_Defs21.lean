instance (e : Ex HS) : Decidable (KFL.NoSeg e) := by unfold KFL.NoSeg; infer_instance

/-! ## Value hypotheses and the register environment -/

/-- The value hypotheses of the key computation. -/
structure KVal (l : Lay) (K ρ G n L M Bb : ℕ) : Prop where
  ok : l.OK
  qc : l.QC = Qc G n
  ql : l.QL = 2 ^ L
  hM : l.M = M
  hK : 1 ≤ K
  hG : 1 ≤ G
  hL : ρ + n * K ≤ L
  hA : 2 * 2 ^ G * 2 ^ ρ * (2 ^ K) ^ n ≤ 2 ^ L * 2 ^ L
  hT : 2 ^ ρ * (2 ^ K) ^ n ≤ 2 ^ L * 2 ^ L
  hRL : 2 ^ G ≤ 2 ^ L
  hKL : 2 ^ K ≤ 2 ^ L
  hρL : 2 ^ ρ ≤ 2 ^ L
  hnL : n ≤ 2 ^ L
  hCL : Qc G n ≤ 2 ^ L
  hQM : 2 ^ L * 2 ^ L ≤ M
  hbig : 8 * M < 2 ^ Bb

/-- The layout in the registers. -/
structure KEnv (t : IState HS) (l : Lay) (K ρ G n : ℕ) : Prop where
  ql : ∃ L, t.G kQL = .int (l.QL : ℤ) :: L
  su : ∃ L, t.G kSU = .int (l.sU : ℤ) :: L
  st : ∃ L, t.G kST = .int (l.sT : ℤ) :: L
  sx : ∃ L, t.G kSX = .int (l.sX : ℤ) :: L
  sy : ∃ L, t.G kSY = .int (l.sY : ℤ) :: L
  qc : ∃ L, t.G kQC = .int (l.QC : ℤ) :: L
  rr : ∃ L, t.G kRR = .int ((2 : ℤ) ^ G) :: L
  nn : ∃ L, t.G kN = .int (n : ℤ) :: L
  k2 : ∃ L, t.G kK2 = .int ((2 : ℤ) ^ K) :: L
  r2 : ∃ L, t.G kR2 = .int ((2 : ℤ) ^ ρ) :: L

/-- The registers the environment lives on. -/
def kEnvRegs : List (Fin HS) := [kQL, kSU, kST, kSX, kSY, kQC, kRR, kN, kK2, kR2]

/-! ## The key state -/

/-- The managed state during the key computation. -/
def KS (G0 : Fin HS → List ℤ) (nv R x t u y : ℤ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update G0 pN (nv :: G0 pN)) pR (R :: G0 pR)) kx (x :: G0 kx)) kt (t :: G0 kt))
    ku (u :: G0 ku)) ky (y :: G0 ky)

