    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1)
    (hpos : 0 < kt19EndpointWeight R mu hmu_nonneg hmu_sum .accepted)
    (port : Logical) :
    0 ≤ kt19PortError R mu hmu_nonneg hmu_sum hpos port := by
  unfold kt19PortError
  apply Finset.sum_nonneg
  intro label _
  by_cases hlabel : label port = 0
  · simp [hlabel]
  · simpa [hlabel] using
      kt19AcceptedOutputDistribution_nonneg R mu hmu_nonneg hmu_sum hpos label
