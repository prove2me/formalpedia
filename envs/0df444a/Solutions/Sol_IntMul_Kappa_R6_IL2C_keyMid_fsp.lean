    unfold tfT
    rcases emod2_01 a with h | h <;> rcases emod2_01 b with h' | h' <;> rw [h, h'] <;> norm_num

theorem oT_tab {K ρ n : ℕ} (x y : ℕ) : segSum tfT ((2 : ℤ) ^ K) ((2 : ℤ) ^ K) ((2 : ℤ) ^ K)
    ((2 : ℤ) ^ ρ) ((x / 2 ^ ρ : ℕ) : ℤ) ((y / 2 ^ ρ : ℕ) : ℤ) n = oT K ρ n x y := rfl

