theorem GaussianTensorExecution.execute_inverse_forward_canonical (n : Nat) (x : TaggedCube n) (p : Path n) :
    normalize (coordinate n (executeInverse n (executeForward n x)) p) =
      normalize (coordinate n x p) := by sorry
