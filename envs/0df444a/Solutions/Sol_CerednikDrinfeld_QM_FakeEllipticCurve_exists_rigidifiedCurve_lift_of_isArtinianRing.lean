  obtain ⟨-, -, hactv, -⟩ := hv₃
  obtain ⟨-, -, hactuA'', -⟩ := huA''₁
  have hrel' : (ib ≫ ub') ≫ ρ.φ ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ =
      x₀.2.φ ≫ (v ≫ uA'') ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := by
    have := congrArg (· ≫ v ≫ uA'') hrel
    simp only [Category.assoc] at this ⊢
    have eL : ib ≫ ρ'.φ ≫ uA' ≫ x₀.2.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ≫ v ≫ uA'' =
        ib ≫ ub' ≫ ρ.φ ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := by
      rw [reassoc_of% (hactv ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩), reassoc_of% huA'v,
        hactuA'' ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩, reassoc_of% hsq]
