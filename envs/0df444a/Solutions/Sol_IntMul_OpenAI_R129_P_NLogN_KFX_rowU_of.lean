    zsz v ≤ Bb :=
  le_trans (zsz_mono (b := ((VbR T S0 B r H : ℕ) : ℤ)) (by
    rw [Int.natAbs_natCast]
    exact Int.ofNat_le.mp (by rw [Int.natCast_natAbs]; exact abs_le.mpr ⟨h0, h1⟩))) hBb

