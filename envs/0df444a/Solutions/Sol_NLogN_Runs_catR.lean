theorem nbits_zero : nbits 0 = [] := by rw [nbits]; simp

theorem nbits_pos {m : ℕ} (h : m ≠ 0) : nbits m = decide (m % 2 = 1) :: nbits (m / 2) := by
  rw [nbits]; simp [h]

theorem wval_nbits (m : ℕ) : wval (nbits m) = m := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · simp [nbits_zero, wval]
    · rw [nbits_pos hm.ne', wval, ih _ (Nat.div_lt_self hm (by norm_num))]
      by_cases h : m % 2 = 1 <;> simp [h] <;> omega

theorem nbits_wval : ∀ l, nbits (wval l) = trimL l
  | [] => by simp [wval, nbits_zero, trimL]
  | b :: l => by
    have ih := nbits_wval l
    simp only [trimL, wval]
    by_cases h0 : b.toNat + 2 * wval l = 0
    · have hb : b = false := by cases b <;> simp_all
      have hl : wval l = 0 := by omega
      rw [h0, nbits_zero, if_pos ⟨by rw [← ih, hl, nbits_zero], hb⟩]
    · rw [nbits_pos h0, if_neg]
      · congr 1
        · cases b <;> simp <;> omega
        · rw [← ih]; congr 1; cases b <;> simp <;> omega
      · rintro ⟨h1, rfl⟩
        rw [← ih] at h1
        have : wval l = 0 := by rw [← wval_nbits (wval l), h1]; rfl
        simp_all

