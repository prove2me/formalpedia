-- title:
--   Homomorphism property
-- statement:
--   $L$ is a signature without relation symbols and $M$ an $L$-algebra; congruences are compatible equivalence relations, ordered by inclusion. $m_0,\dots,m_n$ are Day terms for $M$: 4-ary terms with $m_e(x,y,y,x)=x$, $m_0=x$, $m_n=u$, $m_e(x,x,u,u)=m_{e+1}(x,x,u,u)$ ($e$ even), $m_e(x,y,y,u)=m_{e+1}(x,y,y,u)$ ($e$ odd), holding for all elements of $M$. For congruences $T=(\theta_0,\dots,\theta_{k-1})$ with $k\ge2$, a $T$-matrix is a map $h:\{0,1\}^k\to M$, $h(f)=t(\mathbf x_0,\dots,\mathbf x_{k-1})$ with $\mathbf x_i=\mathbf a_i$ if $f(i)=0$ and $\mathbf x_i=\mathbf b_i$ if $f(i)=1$, for a polynomial $t$ (a term with constants from $M$) in blocks of variables of arbitrary arities and tuples $\mathbf a_i\equiv_{\theta_i}\mathbf b_i$. A $(j)$-line is a pair of vertices differing only in coordinate $j$; the pivot $(j)$-line has all other coordinates $1$, the others are supporting. $C(T;j;\delta)$: in every $T$-matrix, if all supporting $(j)$-lines are $\delta$-pairs then so is the pivot $(j)$-line. $[\theta_0,\dots,\theta_k]$ is the intersection of all congruences $\delta$ with $C(T;k;\delta)$ (last coordinate). Let $f:M\to N$ be a surjective homomorphism with kernel $\pi$; for a congruence $\theta$ of $M$, $f(\theta)$ is the congruence of $N$ generated by $\{(f x,f y):(x,y)\in\theta\}$, and $f^{-1}(\psi)$ is the preimage. For $k\ge1$ and congruences $\theta_0,\dots,\theta_k$ of $M$: $[\theta_0,\dots,\theta_k]\vee\pi=f^{-1}\big([f(\theta_0\vee\pi),\dots,f(\theta_k\vee\pi)]\big)$.
-- source:
--   A. Moorhead, Higher commutator theory for congruence modular varieties, J. Algebra 513 (2018) 133-158, https://doi.org/10.1016/j.jalgebra.2018.07.026 (arXiv:1610.07087), Prop 5.2

import Definitions.Def_HigherComm_defs

universe u v w

open FirstOrder FirstOrder.Language

namespace HigherComm

variable {L : FirstOrder.Language.{u, v}} {M : Type w} [L.Structure M] [L.IsAlgebraic]

/-- Moorhead, Prop 5.2 (homomorphism property).  In an algebra with Day terms, for a surjective
homomorphism `f : M → N` with kernel `π`:
`[θ₀, …, θ_{k+1}] ∨ π = f⁻¹([f(θ₀ ∨ π), …, f(θ_{k+1} ∨ π)])`. -/
theorem hom_property {n k : ℕ} (m : Fin (n + 1) → L.Term (Fin 4)) (hm : IsDayTerms M m)
    {N : Type*} [L.Structure N] (f : M →[L] N) (hf : Function.Surjective f)
    (T : Fin (k + 2) → Congruence (L := L) M) :
    (higherComm T).sup (Congruence.ker f) =
      Congruence.comap f
        (higherComm (fun i => Congruence.map f ((T i).sup (Congruence.ker f)))) := by sorry

end HigherComm
