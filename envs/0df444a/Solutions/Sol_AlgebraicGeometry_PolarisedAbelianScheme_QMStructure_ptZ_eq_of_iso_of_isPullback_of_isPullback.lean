theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {star : ↥Λ → ↥Λ} {β : Fin (2 * 2) → ↥Λ}
    {d m : ℕ} (hm : 3 ≤ m) {R : Type} [CommRing R] (hm' : IsUnit ((m : ℕ) : R))
    (X : PolarisedAbelianScheme 2 d m R) {Z : Scheme.{0}} (ζ : Z ⟶ Spec (CommRingCat.of R))
    (ptZ : ∀ (T : Type) [CommRing T] (φ : R →+* T) (X' : PolarisedAbelianScheme 2 d m T),
      PolarisedAbelianScheme.IsPullback φ X X' → QMStructure Λ star β X' →
      SchemeHomOver (Spec.map (CommRingCat.ofHom φ)) ζ)
    (hnat : ∀ (T T' : Type) [CommRing T] [CommRing T'] (φ : R →+* T) (φ' : R →+* T') (ψ : T →+* T')
      (hψ : ψ.comp φ = φ')
      (X' : PolarisedAbelianScheme 2 d m T) (X'' : PolarisedAbelianScheme 2 d m T')
      (hX' : PolarisedAbelianScheme.IsPullback φ X X') (hX'' : PolarisedAbelianScheme.IsPullback φ' X X'')
      (s' : QMStructure Λ star β X') (s'' : QMStructure Λ star β X''),
      QMStructure.IsPullback ψ s' s'' →
      (ptZ T' φ' X'' hX'' s'').1 = Spec.map (CommRingCat.ofHom ψ) ≫ (ptZ T φ X' hX' s').1)
    (T : Type) [CommRing T] (φ : R →+* T) (X' X'' : PolarisedAbelianScheme 2 d m T)
    (hX' : PolarisedAbelianScheme.IsPullback φ X X') (hX'' : PolarisedAbelianScheme.IsPullback φ X X'')
    (s' : QMStructure Λ star β X') (s'' : QMStructure Λ star β X'') (h : QMStructure.Iso s' s'') :
    ptZ T φ X' hX' s' = ptZ T φ X'' hX'' s'' := by
  obtain ⟨gA', hpb', hmul', hP', ⟨ipol'⟩⟩ := id hX'
  obtain ⟨gA'', hpb'', hmul'', hP'', ⟨ipol''⟩⟩ := id hX''
  obtain ⟨e, he, hmul_e, hlev_e, hpol_e, hact_e, hP_e⟩ := h

  have h₂ : IsPullback (e.hom ≫ gA'') X'.f X.f (Spec.map (CommRingCat.ofHom φ)) := by
    have sq : IsPullback e.hom X'.f X''.f (𝟙 _) := IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, he]⟩
    simpa using sq.paste_horiz hpb''
  let j : (Scheme.Modules.pullback (e.hom ≫ gA'')).obj X.pol ≅ (Scheme.Modules.pullback e.hom).obj X''.pol :=
    ((Scheme.Modules.pullbackComp e.hom gA'').app X.pol).symm ≪≫ (Scheme.Modules.pullback e.hom).mapIso ipol''
  have hmT : IsUnit ((m : ℕ) : T) := by simpa using hm'.map φ
  have hg : gA' = e.hom ≫ gA'' := by
    refine AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hm φ hmT X X'
      gA' (e.hom ≫ gA'') hpb' hmul' hP' (fun s => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso ipol'⟩⟩) h₂ ?_ ?_ ?_
    · intro W t' x y
      rw [← Category.assoc, hmul_e, hmul'']
      exact mul_val_congr X.L _ (Subtype.ext (Category.assoc _ _ _)) (Subtype.ext (Category.assoc _ _ _))
    · intro i
      rw [← Category.assoc, hlev_e i, hP'' i]
    · intro s
      obtain ⟨U, hs, ⟨i⟩⟩ := hpol_e s
      exact ⟨U, hs, ⟨(Scheme.Modules.pullback _).mapIso j ≪≫ i⟩⟩

  let k₀ : X'.pol ≅ (Scheme.Modules.pullback e.hom).obj X''.pol :=
    ipol'.symm ≪≫ (Scheme.Modules.pullbackCongr hg).app X.pol ≪≫ j
  let k : (Scheme.Modules.pullback e.inv).obj X'.pol ≅ X''.pol :=
    (Scheme.Modules.pullback e.inv).mapIso k₀ ≪≫ pullbackInvHomIso e X''.pol

  have hid : Spec.map (CommRingCat.ofHom (RingHom.id T)) = 𝟙 (Spec (CommRingCat.of T)) := by
    rw [CommRingCat.ofHom_id]; exact Spec.map_id _
  have hinv : e.inv ≫ X'.f = X''.f := inv_over e he
  have hIP : QMStructure.IsPullback (RingHom.id T) s' s'' := by
    refine ⟨e.inv, ?_, ?_, ?_, ⟨k⟩, ?_, ?_⟩
    · rw [hid]
      exact IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, hinv]⟩
    · intro W t' x y
      have h1 : ((X''.L.mul t' x y).1 ≫ e.inv) = (X'.L.mul t' (ePt e he x) (ePt e he y)).1 :=
        congrArg Subtype.val (ePt_mul X'.L X''.L e he hmul_e t' x y)
      rw [h1]
      exact mul_val_base_congr X'.L (by rw [hid, Category.comp_id]) _ _ _ _
    · intro i
      rw [hid, Category.id_comp, ← hlev_e i, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    · intro x
      rw [(Iso.eq_inv_comp e).mpr (hact_e x).symm, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    · rw [hid, Category.id_comp, ← hP_e, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have hn := hnat T T φ φ (RingHom.id T) (RingHom.id_comp φ) X' X'' hX' hX'' s' s'' hIP
  rw [hid, Category.id_comp] at hn
  exact (Subtype.ext hn).symm

