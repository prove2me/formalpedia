def PrimitiveFormFullBranchConstant.Statement : Prop :=
  ∀ (σ : Type) [Fintype σ] (X W N' : Set (σ → ℂ)) (k : ℕ) (f : Fin k → (σ → ℂ) → ℂ) (d : ℕ)
