theorem massEntropy_smul {W : Type*} [Fintype W] (a : ℝ) (p : W → ℝ) (hp : ∑ w, p w = 1) :
    MME.RegionRate.massEntropy (fun w => a * p w) = a * MME.RegionRate.entropy p := by
  unfold MME.RegionRate.massEntropy MME.RegionRate.entropy
  simp only [Real.negMulLog_mul, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum, hp,
    Real.negMulLog_one]
  ring

theorem list_swap (L : List (Fin 1296 × ℕ)) (m : Fin 3) (w : Word) :
    (∑ v : JointWord, if v m = w then (L.map (fun a ↦ if atom a.1 = v then a.2 else 0)).sum else 0) =
      (L.map (fun a ↦ if atom a.1 m = w then a.2 else 0)).sum := by
  induction L with
  | nil => simp
  | cons a L ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [← ih]
    have h1 : (∑ v : JointWord, if v m = w then (if atom a.1 = v then a.2 else 0) else 0) =
        if atom a.1 m = w then a.2 else 0 := by
      rw [Finset.sum_eq_single (atom a.1)]
      · simp
      · intro b _ hb
        simp [Ne.symm hb]
      · simp
    rw [← h1, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro v _
    split_ifs <;> simp

theorem wordCounts_eq (o : Fin 6) (s : Fin 45) (m : Fin 3) (w : Word) :
    wordCounts o m (shape s) w =
      alpha o s * ((jointRows o s).map (fun a ↦ if atom a.1 m = w then a.2 else 0)).sum := by
  have hs : shapeEquiv.symm (shape s) = s := shapeEquiv.symm_apply_apply s
  unfold wordCounts jointCounts
  rw [hs, ← list_swap, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _
  unfold rowCounts
  split_ifs <;> simp

theorem log5_lower (L : ℚ) (h : let q : ℚ := 5
    let k : ℤ := -2
    let n := 14
    let t := ((2 : ℚ) ^ k * q - 1) / ((2 : ℚ) ^ k * q + 1)
    let twoCenter := 2 * ∑ i ∈ Finset.range n, (1 / 3 : ℚ) ^ (2 * i + 1) / (2 * i + 1)
    let twoError := 2 * ((1 / 3 : ℚ) ^ (2 * n + 1) / (1 - (1 / 3 : ℚ) ^ 2))
    let center := (2 * ∑ i ∈ Finset.range n, t ^ (2 * i + 1) / (2 * i + 1)) -
      (k : ℚ) * twoCenter
    let error := 2 * (|t| ^ (2 * n + 1) / (1 - t ^ 2)) + |(k : ℚ)| * twoError
    L ≤ center - error ∧ center + error ≤ 2) : (L : ℝ) ≤ Real.log 5 := by
  have := (mme_rational_log_series_certificate 5 (by norm_num) (-2) 14 L 2 h.1 h.2).1
  simpa using this

theorem log10_upper (h : let q : ℚ := 10
    let k : ℤ := -3
    let n := 14
    let t := ((2 : ℚ) ^ k * q - 1) / ((2 : ℚ) ^ k * q + 1)
    let twoCenter := 2 * ∑ i ∈ Finset.range n, (1 / 3 : ℚ) ^ (2 * i + 1) / (2 * i + 1)
    let twoError := 2 * ((1 / 3 : ℚ) ^ (2 * n + 1) / (1 - (1 / 3 : ℚ) ^ 2))
    let center := (2 * ∑ i ∈ Finset.range n, t ^ (2 * i + 1) / (2 * i + 1)) -
      (k : ℚ) * twoCenter
    let error := 2 * (|t| ^ (2 * n + 1) / (1 - t ^ 2)) + |(k : ℚ)| * twoError
    (0 : ℚ) ≤ center - error ∧ center + error ≤ 2303 / 1000) : Real.log 10 ≤ 2303 / 1000 := by
  have := (mme_rational_log_series_certificate 10 (by norm_num) (-3) 14 0 (2303 / 1000) h.1 h.2).2
  norm_num at this
  linarith

theorem log10_upper' : Real.log 10 ≤ 2303 / 1000 := log10_upper (by decide +kernel)

theorem err_bound (N : ℕ) (hN : 6 * (N + 1) ≤ 10 ^ 60) :
    81 * Real.log (6 * ((N : ℝ) + 1)) ≤ 11340 := by
  have hpos : (0 : ℝ) < 6 * ((N : ℝ) + 1) := by positivity
  have h1 : 6 * ((N : ℝ) + 1) ≤ (10 : ℝ) ^ 60 := by exact_mod_cast hN
  have h2 : Real.log (6 * ((N : ℝ) + 1)) ≤ Real.log ((10 : ℝ) ^ 60) := Real.log_le_log hpos h1
  rw [Real.log_pow] at h2
  have := log10_upper'
  push_cast at h2
  nlinarith

