    have ih := kpack_lt b l (fun x hx => h x (by simp [hx]))
    have hd := h d (by simp)
    rw [show b * (l.length + 1) = b + b * l.length by ring, pow_add]
    have : (2 : ℤ) ^ b * kpack (2 ^ b) l ≤ 2 ^ b * (2 ^ (b * l.length) - 1) := by
      apply mul_le_mul_of_nonneg_left (by omega) (by positivity)
    nlinarith

theorem carry1_cost (M : MulSpec) (s : IState HS) (b B : ℕ) (c : List ℤ) (y0 : ℤ)
    (RA LY LR LM : List Item)
    (hA : s.G CA = ints c ++ RA) (hY : s.G CY = .int y0 :: LY) (hR : s.G CR = .int (2 ^ b) :: LR)
    (hM : s.G CM = .int c.length :: LM) (hy0 : 0 ≤ y0) (hyB : y0 < 2 ^ B)
    (hc : ∀ x ∈ c, 0 ≤ x ∧ x < 2 ^ B) (hb1 : 1 ≤ b) (hbB : b ≤ B) (hMB : zsz (c.length : ℤ) ≤ B) :
    carry1.cost M s ≤ 4000 * (B + 2) + c.length * (20000 * (B + 3)) + 32 := by
  have hc0 : ∀ x ∈ c, 0 ≤ x := fun x hx => (hc x hx).1
  have hst := carry1_states s b c y0 RA LY LR LM hA hY hR hM hy0 hc0
  have hN : (Ex.eval s (Ex.reg CM)).toNat = c.length := by simp [Ex.eval, IState.top, hM]
  have hBnd : (Ex.reg CM).Bnd s B := by simpa [Ex.Bnd, IState.top, hM] using hMB
  have h := RM.RepStates.cost_le_lin (M := M) hst B (20000 * (B + 3) - 8000 * (B + 2) - 30) trivial hBnd ?_
  · rw [hN] at h
    have : 20000 * (B + 3) - 8000 * (B + 2) - 30 + 8000 * (B + 2) + 30 = 20000 * (B + 3) := by
      omega
    rw [this] at h
    simpa [Ex.size, carry1] using h
  intro k hk
  rw [hN] at hk ⊢
  obtain ⟨x, rest, hd⟩ : ∃ x rest, c.drop k = x :: rest := ⟨_, _, List.drop_eq_getElem_cons hk⟩
  have hx : x ∈ c := by
    have : x ∈ c.drop k := by rw [hd]; simp
    exact List.mem_of_mem_drop this
  have hxB := hc x hx
  have hy := carryL_carry_nonneg b (c.take k) y0 hy0 (fun z hz => hc0 z (List.mem_of_mem_take hz))
  have hyB' := carryL_carry_lt b B hb1 (c.take k) y0 hy0 hyB
    (fun z hz => hc z (List.mem_of_mem_take hz))
  set y := (carryL b (c.take k) y0).2 with hydef
  set t := withCtr CQ s c.length k (c1St s b c y0 RA LY k) with ht
  have tY : t.G CY = .int y :: LY := by
    simp (config := {decide := true}) [ht, withCtr, c1St, IState.upd_G]
    try rfl
  have tA : t.G CA = .int x :: (ints rest ++ RA) := by
    simp (config := {decide := true}) [ht, withCtr, c1St, IState.upd_G, hd]
  have e1 : RM.cost M carryBody t = RS.asgCost CY (.add (.reg CY) (.reg CA)) t +
      RS.cost (.pop CA) ((RS.asg CY (.add (.reg CY) (.reg CA))).run t) +
      RM.cost M (.op (.split CY CR CD)) ((RS.seq (.asg CY (.add (.reg CY) (.reg CA)))
        (.pop CA)).run t) := by
    simp only [carryBody, RM.cost, RS.cost, RM.run]
  have e2 : RS.cost (.pop CA) ((RS.asg CY (.add (.reg CY) (.reg CA))).run t) = 2 * zsz x + 2 := by
    simp (config := {decide := true}) [RS.cost, RS.run, IState.top, IState.upd_G, tA]
  have e3 : RM.cost M (.op (.split CY CR CD)) ((RS.seq (.asg CY (.add (.reg CY) (.reg CA)))
      (.pop CA)).run t) = splitCost b + 17 := by
    have tR : t.G CR = .int (2 ^ b) :: LR := by
      simp (config := {decide := true}) [ht, withCtr, c1St, IState.upd_G, hR]
    simp (config := {decide := true}) [RM.cost, RS.run, IOp.run, IState.top, IState.upd_G, tA, tY,
      tR, Ex.eval, rulerExp_two_pow]
  have hlt : y + x < 2 ^ (B + 1) := by rw [pow_succ]; omega
  have hlt' : y < 2 ^ (B + 1) := by rw [pow_succ]; omega
  have hlx : x < 2 ^ (B + 1) := by rw [pow_succ]; omega
  have e4 := RS.asgCost_le_lin CY (.add (.reg CY) (.reg CA)) t (B + 1) (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top, tY, tA]
      refine ⟨zsz_le_of_nonneg_lt hy hlt', zsz_le_of_nonneg_lt hxB.1 hlx,
        zsz_le_of_nonneg_lt (by omega) hlt⟩)
    (by simp only [IState.top, tY]; exact zsz_le_of_nonneg_lt hy hlt')
  have e5 : zsz x ≤ B := zsz_le_of_nonneg_lt hxB.1 hxB.2
  rw [e1, e2, e3]
  simp only [Ex.size] at e4
  simp only [splitCost, moveCost, takeCost]
  have : 20000 * (B + 3) - 8000 * (B + 2) - 30 = 12000 * B + 43970 := by omega
  rw [this]
  have hb' := hbB
  nlinarith

theorem asm_cost (M : MulSpec) (s1 : IState HS) (b B : ℕ) (dl : List ℤ) (y : ℤ)
    (LY D0 P0 LR LM : List Item)
    (hdig : ∀ d ∈ dl, 0 ≤ d ∧ d < 2 ^ b) (hy : 0 ≤ y)
    (hR : s1.G CR = .int (2 ^ b) :: LR) (hM : s1.G CM = .int dl.length :: LM)
    (hbB : b ≤ B) (hMB : zsz (dl.length : ℤ) ≤ B) :
    (RM.rep CQ (.reg CM) asmBody).cost M (c2St s1 b dl y LY D0 P0 0) ≤
      4000 * (B + 2) + dl.length * (10000 * (B + 3)) + 32 := by
  have hst := asm_states s1 b dl y LY D0 P0 LR LM hdig hy hR hM
  have hN : (Ex.eval (c2St s1 b dl y LY D0 P0 0) (Ex.reg CM)).toNat = dl.length := by
    simp (config := {decide := true}) [Ex.eval, IState.top, hM, c2St, IState.upd_G]
  have hBnd : (Ex.reg CM).Bnd (c2St s1 b dl y LY D0 P0 0) B := by
    simpa (config := {decide := true}) [Ex.Bnd, IState.top, hM, c2St, IState.upd_G] using hMB
  have h := RM.RepStates.cost_le_lin (M := M) hst B (10000 * (B + 3) - 8000 * (B + 2) - 30)
    trivial hBnd ?_
  · rw [hN] at h
    have : 10000 * (B + 3) - 8000 * (B + 2) - 30 + 8000 * (B + 2) + 30 = 10000 * (B + 3) := by
      omega
    rw [this] at h
    simpa [Ex.size] using h
  intro k hk
  rw [hN] at hk ⊢
  have hi : dl.length - k - 1 < dl.length := by omega
  set d := dl.get ⟨dl.length - k - 1, hi⟩ with hd
  have htk : dl.take (dl.length - k) = dl.take (dl.length - (k + 1)) ++ [d] := by
    rw [show dl.length - k = (dl.length - (k + 1)) + 1 by omega, List.take_add_one,
      List.getElem?_eq_getElem (by omega)]
    simp only [Option.toList_some, hd, List.get_eq_getElem]
    congr 2
    try omega
  have hdd := hdig d (List.get_mem _ _)
  have hkp := kpack_nonneg b (dl.drop (dl.length - k))
    (fun x hx => (hdig x (List.mem_of_mem_drop hx)).1)
  have hApos : 0 < kpack (2 ^ b) (dl.drop (dl.length - k)) + (y + 1) * 2 ^ (b * k) := by
    have : (0 : ℤ) < (y + 1) * 2 ^ (b * k) := by positivity
    omega
  simp only [asmBody, RM.cost, RM.run, withCtr, c2St]
  rw [htk]
  simp (config := {decide := true}) only [IOp.run, IState.upd_G, if_true, if_false,
    List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append, ints,
    List.map_append, List.map_cons, List.map_nil, List.singleton_append, List.cons_append, hR,
    rulerExp_two_pow]
  generalize kpack (2 ^ b) (dl.drop (dl.length - k)) + (y + 1) * 2 ^ (b * k) = A at *
  have e1 : ¬ (A = 0 ∨ d < 0 ∨ 2 ^ b ≤ d) := by omega
  simp (config := {decide := true}) [e1, IState.upd_G, hR, rulerExp_two_pow]
  simp only [catCost, shlCost, moveCost, zipCost]
  have : 10000 * (B + 3) - 8000 * (B + 2) - 30 = 2000 * B + 13970 := by omega
  rw [this]
  nlinarith

theorem RM.cost_seq' (M : MulSpec) (a b : RM) (s : IState HS) :
    (RM.seq a b).cost M s = a.cost M s + b.cost M (a.run s) := rfl
theorem RM.cost_rs' (M : MulSpec) (p : RS) (s : IState HS) : (RM.rs p).cost M s = p.cost s := rfl
theorem RS.cost_seq' (a b : RS) (s : IState HS) : (RS.seq a b).cost s = a.cost s + b.cost (a.run s) :=
  rfl

set_option maxHeartbeats 1000000 in
theorem carryP_cost (M : MulSpec) (s : IState HS) (b B : ℕ) (c : List ℤ) (y0 : ℤ)
    (RA LY LR LM : List Item)
    (hA : s.G CA = ints c ++ RA) (hY : s.G CY = .int y0 :: LY) (hR : s.G CR = .int (2 ^ b) :: LR)
    (hM : s.G CM = .int c.length :: LM) (hy0 : 0 ≤ y0) (hyB : y0 < 2 ^ B)
    (hc : ∀ x ∈ c, 0 ≤ x ∧ x < 2 ^ B) (hb1 : 1 ≤ b) (hbB : b ≤ B) (hMB : zsz (c.length : ℤ) ≤ B) :
    carryP.cost M s ≤ 40000 * (c.length + 1) * (B + 3) + 20000 * (b * c.length + B + 4) := by
  have hc0 : ∀ x ∈ c, 0 ≤ x := fun x hx => (hc x hx).1
  have k1 := carry1_cost M s b B c y0 RA LY LR LM hA hY hR hM hy0 hyB hc hb1 hbB hMB
  rw [carryP, RM.cost_seq']
  rw [carry1_run s b c y0 RA LY LR LM hA hY hR hM hy0 hc0]
  set dl := (carryL b c y0).1 with hdl
  set yM := (carryL b c y0).2 with hyM
  have hlen : dl.length = c.length := carryL_length b c y0
  have hyM0 : 0 ≤ yM := carryL_carry_nonneg b c y0 hy0 hc0
  have hyMB : yM < 2 ^ B := carryL_carry_lt b B hb1 c y0 hy0 hyB hc
  set s1 := ((s.upd CA RA).upd CY (.int yM :: LY)).upd CD (ints dl.reverse ++ s.G CD) with hs1
  have hR1 : s1.G CR = .int (2 ^ b) :: LR := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hR]
  have hM1 : s1.G CM = .int dl.length :: LM := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hM, hlen]
  have hY1 : s1.G CY = .int yM :: LY := by
    simp (config := {decide := true}) [hs1, IState.upd_G]
  have e0 : (RS.seq (.asg CY (.add (.reg CY) (.lit 1))) (.push CP (.lit 1))).run s1 =
      c2St s1 b dl yM LY (s.G CD) (s.G CP) 0 := by
    simp only [c2St, Nat.sub_zero, List.drop_length, List.take_length, mul_zero, pow_zero]
    apply IState.ext' <;> intros <;>
      simp (config := {decide := true}) only [RS.run, IState.upd_G, IState.upd_ip,
        IState.upd_out, Ex.eval, IState.top, hs1] <;>
      split_ifs <;> simp_all (config := {decide := true}) [kpack]
  have hst := asm_states s1 b dl yM LY (s.G CD) (s.G CP) LR LM (carryL_digits b c y0) hyM0 hR1 hM1
  have hN : (Ex.eval (c2St s1 b dl yM LY (s.G CD) (s.G CP) 0) (Ex.reg CM)).toNat = dl.length := by
    simp (config := {decide := true}) [Ex.eval, IState.top, hM1, c2St, IState.upd_G]
  have k2 := asm_cost M s1 b B dl yM LY (s.G CD) (s.G CP) LR LM (carryL_digits b c y0) hyM0 hR1 hM1
    hbB (by rw [hlen]; exact hMB)
  rw [carry2, RM.cost_seq', RM.cost_seq', RM.cost_rs', RM.cost_rs', RS.cost_seq', RS.cost_seq',
    RM.run_rs, e0, hst.run, hN]
  -- the initial assignment and push
  have hlt1 : yM + 1 < 2 ^ (B + 1) := by rw [pow_succ]; have : (1 : ℤ) ≤ 2 ^ B := one_le_pow₀ (by norm_num); omega
  have hlt0 : yM < 2 ^ (B + 1) := by omega
  have a1 := RS.asgCost_le_lin CY (.add (.reg CY) (.lit 1)) s1 (B + 1) (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top, hY1]
      refine ⟨zsz_le_of_nonneg_lt hyM0 hlt0, by rw [zsz_one]; omega,
        zsz_le_of_nonneg_lt (by omega) hlt1⟩)
    (by simp only [IState.top, hY1]; exact zsz_le_of_nonneg_lt hyM0 hlt0)
  have a2 := RS.pushCost_le_lin (.lit 1) ((RS.asg CY (.add (.reg CY) (.lit 1))).run s1) (B + 1)
    (by simp [Ex.Lin]) (by simp only [Ex.Bnd]; rw [zsz_one]; omega)
  -- the final subtraction
  have hdig := carryL_digits b c y0
  have hkp := kpack_nonneg b dl (fun x hx => (hdig x hx).1)
  have hkl := kpack_lt b dl hdig
  set W := b * dl.length with hW
  have hpos : (0 : ℤ) < 2 ^ W := by positivity
  have hA2 : kpack (2 ^ b) dl + (yM + 1) * 2 ^ W < 2 ^ (W + B + 1) := by
    have : (yM + 1) * 2 ^ W ≤ 2 ^ B * 2 ^ W := mul_le_mul_of_nonneg_right (by omega) hpos.le
    rw [pow_add, pow_add, pow_one]; nlinarith
  have hWlt : (2 : ℤ) ^ W < 2 ^ (W + B + 1) := pow_lt_pow_right₀ (by norm_num) (by omega)
  set t2 := c2St s1 b dl yM LY (s.G CD) (s.G CP) dl.length with ht2
  have tY : t2.G CY = .int (kpack (2 ^ b) dl + (yM + 1) * 2 ^ W) :: LY := by
    simp (config := {decide := true}) [ht2, c2St, IState.upd_G, hW]
  have tP : t2.G CP = .int (2 ^ W) :: s.G CP := by
    simp (config := {decide := true}) [ht2, c2St, IState.upd_G, hW]
  have hfin : 0 ≤ kpack (2 ^ b) dl + (yM + 1) * 2 ^ W + -2 ^ W := by nlinarith
  have hfin2 : kpack (2 ^ b) dl + (yM + 1) * 2 ^ W + -2 ^ W < 2 ^ (W + B + 1) := by nlinarith
  have a3 := RS.asgCost_le_lin CY (.add (.reg CY) (.neg (.reg CP))) t2 (W + B + 1)
    (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top, tY, tP]
      refine ⟨zsz_le_of_nonneg_lt (by positivity) hA2, zsz_le_of_nonneg_lt hpos.le hWlt, ?_⟩
      exact zsz_le_of_nonneg_lt hfin hfin2)
    (by simp only [IState.top, tY]; exact zsz_le_of_nonneg_lt (by positivity) hA2)
  have a4 : RS.cost (.pop CP) ((RS.asg CY (.add (.reg CY) (.neg (.reg CP)))).run t2) =
      2 * (W + 1) + 2 := by
    simp (config := {decide := true}) [RS.cost, RS.run, IState.top, IState.upd_G, tP, NLogN.zsz_two_pow]
  simp only [Ex.size] at a1 a2 a3
  have a1' : (RS.asg CY (.add (.reg CY) (.lit 1))).cost s1 ≤ (1 + 1 + 1 + 1) * 2000 * (B + 1 + 2) :=
    a1
  have a2' : (RS.push CP (.lit 1)).cost ((RS.asg CY (.add (.reg CY) (.lit 1))).run s1) ≤
      (1 + 1) * 2000 * (B + 1 + 2) := a2
  have a3' : (RS.asg CY (.add (.reg CY) (.neg (.reg CP)))).cost t2 ≤
      (1 + 1 + 1 + 1 + 1) * 2000 * (W + B + 1 + 2) := a3
  rw [hlen] at k2 hW
  rw [a4]
  have hW' : W = b * c.length := hW
  rw [hW'] at a3'
  push_cast at *
  linarith

end NLogN

