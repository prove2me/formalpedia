-- title:
--   $\mathcal P(\mathbb R^d)$, paths, measure flows, empirical measures, total variation, $\mathbb F$-Brownian motion and Assumptions A, B, C
-- statement:
--   This file fixes the spaces and standing assumptions of Lacker's model of $n$-player stochastic differential games and their mean field limit.
--
--   1. **State and measure spaces.** The state space is $\mathbb R^d$ with the Euclidean norm. $\mathcal P(\mathbb R^d)$ is the set of Borel probability measures on $\mathbb R^d$, with the topology of weak convergence and the Borel $\sigma$-field of that topology. For a subset $A$ of a real normed space, $\mathcal P(A)$ (the relaxed controls) is defined the same way.
--   2. **Paths and flows.** $\mathcal C^d = C([0,T];\mathbb R^d)$ is the path space, and $C([0,T];\mathcal P(\mathbb R^d))$ is the space of continuous measure flows. Both carry the topology of uniform convergence and its Borel $\sigma$-field. A path $x$ is read at a real time $s$ by clamping $s$ to $[0,T]$.
--   3. **Empirical measures.** For $n\ge 1$ points $x_1,\dots,x_n$ of $\mathbb R^d$, the empirical measure is $L_n(x)=\frac1n\sum_{k=1}^n\delta_{x_k}$. The Dirac mass $\delta_m$ at a flow $m$ is a probability measure on $C([0,T];\mathcal P(\mathbb R^d))$.
--   4. **Total variation.** For $m,m'\in\mathcal P(\mathbb R^d)$,
--   $$\|m-m'\|_{TV}=\sup_f\int_{\mathbb R^d}f\,d(m-m'),$$
--   the supremum taken over all measurable $f:\mathbb R^d\to[-1,1]$.
--   5. **$\mathbb F$-Brownian motion.** On a filtered probability space $(\Omega,\mathcal F,\mathbb F,\mathbb P)$, a process $W$ is an $\mathbb F$-Brownian motion when three things hold: it is a standard $d$-dimensional Brownian motion, it is $\mathbb F$-adapted, and for every $t$ the increments $(W_r-W_t)_{r\ge t}$ are independent of $\mathcal F_t$. For an initial variable $\xi$, the completed filtration generated by $(\xi,W_s)_{s\le t}$ is $\sigma(\xi,W_s:s\le t)$ joined with all subsets of $\mathbb P$-null sets.
--   6. **Assumption A.** (A.1) $A$ is a compact convex subset of a real normed space. (A.2) The coefficients
--   $$b:[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)\times A\to\mathbb R^d,\qquad f:[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)\times A\to\mathbb R,\qquad g:\mathbb R^d\times\mathcal P(\mathbb R^d)\to\mathbb R$$
--   are bounded and jointly continuous.
--   7. **Assumption B.** For each $(t,x,m)\in[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)$ the set
--   $$K(t,x,m)=\{(b(t,x,m,a),z):a\in A,\ z\le f(t,x,m,a)\}\subset\mathbb R^d\times\mathbb R$$
--   is convex.
--   8. **Assumption C.** There is $c>0$ such that, for all $(t,x,a)\in[0,T]\times\mathbb R^d\times A$ and $m,m'\in\mathcal P(\mathbb R^d)$,
--   $$\tfrac1c\,|b(t,x,m,a)-b(t,x,m',a)|\le\|m-m'\|_{TV}.$$
--
--   These objects are the common vocabulary of every statement in the mission. Assumption C is the total-variation Lipschitz condition that makes propagation of chaos hold without continuity of the feedback controls.
--
--   **Formalization Note** $\mathcal P(\cdot)$ is a type synonym of Mathlib's `ProbabilityMeasure` whose measurable structure is `borel`, as the paper fixes (p. 5). On maps from a compact interval into a metrizable space, the compact-open topology is the topology of uniform convergence, so path and flow spaces carry the paper's topology without writing out the metric (2.1). The coefficients are defined at all real times and in all of the normed space; continuity and boundedness are required only on $[0,T]\times\mathbb R^d\times\mathcal P(\mathbb R^d)\times A$, as in the paper. The real supremum defining $\|\cdot\|_{TV}$ is over a nonempty set (it contains $f=0$) bounded above by $2$, so it is the true supremum. The paper's $\|\cdot\|_{TV}$ is twice the "$\sup_A|m(A)-m'(A)|$" distance of the platform's `TotalVariationDist`, which is why it is defined here. The empirical measure requires $n\ge1$ (`NeZero n`). Brownian motions are indexed by $[0,\infty)$; a Brownian motion on $[0,T]$ always extends, and every statement of the mission is about laws, so nothing changes.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, pp. 5–6 (Section 2, Assumptions A and B), p. 9 (Assumption C)

import Mathlib
import Definitions.Def_EthierKurtz_SDEState
import Definitions.Def_EthierKurtz_IsStandardBrownian
import Definitions.Def_ClosedLoopMFG_Limit_Model

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Converse

/-- `P(ℝ^d)`: probability measures on `ℝ^d` with the topology of weak convergence and its Borel
σ-field (Lacker, arXiv:1808.02745v1, p. 5). A type synonym of `ProbabilityMeasure (ClosedLoopMFG.Limit.E d)`, so that
its σ-field is `borel` rather than the Giry σ-field. -/
def PR (d : ℕ) : Type := ProbabilityMeasure (ClosedLoopMFG.Limit.E d)

instance instTopologicalSpacePR (d : ℕ) : TopologicalSpace (PR d) :=
  inferInstanceAs (TopologicalSpace (ProbabilityMeasure (ClosedLoopMFG.Limit.E d)))

instance instMeasurableSpacePR (d : ℕ) : MeasurableSpace (PR d) := borel _

instance instBorelSpacePR (d : ℕ) : BorelSpace (PR d) := ⟨rfl⟩

/-- A point of `P(ℝ^d)` as a measure on `ℝ^d`. -/
def PR.meas {d : ℕ} (m : PR d) : Measure (ClosedLoopMFG.Limit.E d) :=
  ((show ProbabilityMeasure (ClosedLoopMFG.Limit.E d) from m) : Measure (ClosedLoopMFG.Limit.E d))

instance PR.isProb_meas {d : ℕ} (m : PR d) : IsProbabilityMeasure m.meas :=
  (show ProbabilityMeasure (ClosedLoopMFG.Limit.E d) from m).2

/-- `P(A)`: probability measures on the action set `A ⊆ EA` (relaxed controls), with the weak
topology and its Borel σ-field. -/
def PA {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA] (A : Set EA) : Type :=
  ProbabilityMeasure A

instance instTopologicalSpacePA {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : TopologicalSpace (PA A) :=
  inferInstanceAs (TopologicalSpace (ProbabilityMeasure A))

instance instMeasurableSpacePA {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : MeasurableSpace (PA A) := borel _

instance instBorelSpacePA {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : BorelSpace (PA A) := ⟨rfl⟩

/-- A point of `P(A)` as a measure on `A`. -/
def PA.meas {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA] {A : Set EA}
    (q : PA A) : Measure A :=
  ((show ProbabilityMeasure A from q) : Measure A)

instance instBorelSpacePath (d : ℕ) (T : ℝ≥0) : BorelSpace (ClosedLoopMFG.Limit.Path d T) := ⟨rfl⟩

/-- Measure flows `C([0, T]; P(ℝ^d))` (compact-open = uniform topology), Borel σ-field. -/
abbrev Flow (d : ℕ) (T : ℝ≥0) : Type := C(Set.Icc (0 : ℝ) T, PR d)

instance instMeasurableSpaceFlow (d : ℕ) (T : ℝ≥0) : MeasurableSpace (Flow d T) := borel _

instance instBorelSpaceFlow (d : ℕ) (T : ℝ≥0) : BorelSpace (Flow d T) := ⟨rfl⟩

/-- Reading a path (or a flow) at a real time: `ev x s = x(min (max s 0) T)`. -/
noncomputable def ev {X : Type} [TopologicalSpace X] {T : ℝ≥0} (x : C(Set.Icc (0 : ℝ) T, X)) (s : ℝ) : X :=
  x (ClosedLoopMFG.Limit.clampT T s)

/-- The Dirac mass `δ_m` at a flow `m`, as a probability measure on `C([0, T]; P(ℝ^d))`;
"`μ^n` converges in law to `m`" means that the laws of `μ^n` converge weakly to `δ_m`. -/
noncomputable def diracFlow {d : ℕ} {T : ℝ≥0} (m : Flow d T) : ProbabilityMeasure (Flow d T) :=
  ⟨Measure.dirac m, inferInstance⟩

/-- The empirical measure `(1/n) ∑_{k} δ_{x_k}` of `n ≥ 1` points of `ℝ^d`. -/
noncomputable def empirical {n d : ℕ} [NeZero n] (x : Fin n → ClosedLoopMFG.Limit.E d) : PR d :=
  ⟨(n : ℝ≥0∞)⁻¹ • ∑ k, Measure.dirac (x k), by
    constructor
    simp only [Measure.smul_apply, Measure.coe_finsetSum, Finset.sum_apply,
      Measure.dirac_apply_of_mem (Set.mem_univ _), Finset.sum_const, Finset.card_univ,
      Fintype.card_fin, nsmul_eq_mul, mul_one, smul_eq_mul]
    exact ENNReal.inv_mul_cancel (by simp [NeZero.ne n]) (by simp)⟩

/-- The paper's total variation norm `‖m − m'‖_TV = sup_f ∫ f d(m − m')`, the supremum over all
measurable `f : ℝ^d → [−1, 1]` (Assumption C, p. 9). -/
noncomputable def tvNorm {d : ℕ} (m m' : PR d) : ℝ :=
  ⨆ φ : {φ : ClosedLoopMFG.Limit.E d → ℝ // Measurable φ ∧ ∀ x, |φ x| ≤ 1},
    ((∫ x, φ.1 x ∂m.meas) - ∫ x, φ.1 x ∂m'.meas)

/-- An `𝔽`-Brownian motion: a standard `d`-dimensional Brownian motion, adapted to `𝔽`, whose
increments after `t` are independent of `𝓕_t`. -/
def IsFBrownian {Ω : Type} [mΩ : MeasurableSpace Ω] {d : ℕ} (𝓕 : Filtration ℝ≥0 mΩ)
    (P : Measure Ω) (W : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d) : Prop :=
  EthierKurtz.IsStandardBrownian P W ∧ (∀ t, Measurable[𝓕 t] (W t)) ∧
    ∀ t, Indep (𝓕 t)
      (MeasurableSpace.comap (fun ω (r : Set.Ici t) => W r ω - W t ω) inferInstance) P

/-- The `P`-completed filtration generated by `(ξ, W_s)_{s ≤ t}`: the σ-field of `ξ` and of
`W_s`, `s ≤ t`, joined with all subsets of `P`-null measurable sets. -/
abbrev genFilt0 {Ω : Type} [MeasurableSpace Ω] {d : ℕ} (P : Measure Ω) (ξ : Ω → ClosedLoopMFG.Limit.E d)
    (W : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d) (t : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap ξ inferInstance ⊔
    (⨆ s : Set.Iic t, MeasurableSpace.comap (W s.val) inferInstance) ⊔
    MeasurableSpace.generateFrom {S | ∃ N : Set Ω, MeasurableSet N ∧ P N = 0 ∧ S ⊆ N}

/-- Assumption A (p. 6): (A.1) `A` is a compact convex subset of the real normed space `EA`;
(A.2) `b`, `f`, `g` are bounded and jointly continuous on `[0, T] × ℝ^d × P(ℝ^d) × A`
(resp. `ℝ^d × P(ℝ^d)`). -/
def AssumptionA {d : ℕ} (T : ℝ≥0) {EA : Type} [NormedAddCommGroup EA] [NormedSpace ℝ EA]
    (A : Set EA) (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ)
    (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) : Prop :=
  (IsCompact A ∧ Convex ℝ A) ∧
  (ContinuousOn (fun p : ℝ × ClosedLoopMFG.Limit.E d × PR d × EA => b p.1 p.2.1 p.2.2.1 p.2.2.2)
      (Set.Icc 0 (T : ℝ) ×ˢ Set.univ ×ˢ Set.univ ×ˢ A) ∧
    ∃ C : ℝ, ∀ t ∈ Set.Icc 0 (T : ℝ), ∀ x m, ∀ a ∈ A, ‖b t x m a‖ ≤ C) ∧
  (ContinuousOn (fun p : ℝ × ClosedLoopMFG.Limit.E d × PR d × EA => f p.1 p.2.1 p.2.2.1 p.2.2.2)
      (Set.Icc 0 (T : ℝ) ×ˢ Set.univ ×ˢ Set.univ ×ˢ A) ∧
    ∃ C : ℝ, ∀ t ∈ Set.Icc 0 (T : ℝ), ∀ x m, ∀ a ∈ A, |f t x m a| ≤ C) ∧
  (Continuous (fun p : ClosedLoopMFG.Limit.E d × PR d => g p.1 p.2) ∧ ∃ C : ℝ, ∀ x m, |g x m| ≤ C)

/-- Assumption B (p. 6): for each `(t, x, m) ∈ [0, T] × ℝ^d × P(ℝ^d)` the set
`K(t, x, m) = {(b(t, x, m, a), z) : a ∈ A, z ≤ f(t, x, m, a)} ⊆ ℝ^d × ℝ` is convex. -/
def AssumptionB {d : ℕ} (T : ℝ≥0) {EA : Type} (A : Set EA)
    (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ) : Prop :=
  ∀ t ∈ Set.Icc 0 (T : ℝ), ∀ (x : ClosedLoopMFG.Limit.E d) (m : PR d),
    Convex ℝ {p : ClosedLoopMFG.Limit.E d × ℝ | ∃ a ∈ A, p.1 = b t x m a ∧ p.2 ≤ f t x m a}

/-- Assumption C (p. 9): there is `c > 0` with
`(1/c) |b(t, x, m, a) − b(t, x, m', a)| ≤ ‖m − m'‖_TV` for all `(t, x, a) ∈ [0, T] × ℝ^d × A`
and `m, m' ∈ P(ℝ^d)`. -/
def AssumptionC {d : ℕ} (T : ℝ≥0) {EA : Type} (A : Set EA)
    (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ t ∈ Set.Icc 0 (T : ℝ), ∀ (x : ClosedLoopMFG.Limit.E d), ∀ a ∈ A, ∀ m m' : PR d,
    (1 / c) * ‖b t x m a - b t x m' a‖ ≤ tvNorm m m'

end ClosedLoopMFG.Converse


