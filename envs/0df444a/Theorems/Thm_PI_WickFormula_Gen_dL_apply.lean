variable {K I J : Type} [CommRing K] [Fintype I] [Fintype J]

theorem PI.WickFormula.Gen.dL_apply (κ : I → J → K) (i : I) (R : MvPolynomial (I ⊕ J) K) :
    dL κ i R = ∑ j, κ i j • pderiv (Sum.inr j) R := by sorry
