lemma clamp_eval (s : Data) (hz : s.realReg 56 = 0) : Eval clampCode s 2 (clamped s) := by
  by_cases hh : s.realReg 624 < 0
  · have ht : (Test.realLess 624 56).holds s := by simpa only [Test.holds,hz] using hh
    have he := Eval.branchYes (no := Cmd.skip) ht (eval_add s 624 56 56)
    simpa only [clampCode,clamped,hz,zero_add,max_eq_left hh.le] using he
  · have ht : ¬ (Test.realLess 624 56).holds s := by simpa only [Test.holds,hz] using hh
    have hc : clamped s = s := by simp only [clamped,max_eq_right (le_of_not_gt hh),Function.update_eq_self]
    simpa only [clampCode,hc] using Eval.branchNo (yes := add 624 56 56) ht (Eval.skip s)
lemma finite_eval (s : Data) (hz : s.realReg 56 = 0) : Eval finiteCode s 6 (finiteResult s) := by
  let a := finitePrepared s
  have he : Eval (Structured.sequence (finitePrefix.map Cmd.atom)) s 2 a := eval_sequence_atoms finitePrefix s
  have haz : a.realReg 56 = 0 := by simp [a,finitePrepared,finitePrefix,Atom.effect,instructionEffect,data,Data.machine,hz]
  let t := clamped a
  have ht := clamp_eval a haz
  have hw := Eval.seq (eval_store t 620 624) (Eval.seq (eval_storeN _ 620 622) (Eval.skip _))
  exact Eval.seq he (Eval.seq ht hw)
lemma infinite_eval (s : Data) : Eval infiniteCode s 2 (infiniteResult s) := by
  have hh := Eval.seq (eval_natural s 622 1) (Eval.seq (eval_storeN _ 620 622) (Eval.skip _))
  simpa only [infiniteCode,Structured.sequence,infiniteResult,Function.update_self,
    Function.update_of_ne (by decide : (620 : ℕ) ≠ 622)] using hh
lemma eval_code (b : Core) (s : Data) (v : ℕ) (r : ℝ)
    (hv : s.natReg 620 = v) (hr : s.realReg 616 = r) (hz : s.realReg 56 = 0)
    (hq : s.realReg 502 = Q b) (hh : s.realReg 534 = H b/2)
    (hf : s.realReg 518 = (1+b.input.accuracy/2)*Q b) :
    ∃ cost t, Eval code s cost t ∧ cost ≤ 9 ∧ stored t.machine v = readout b r ∧
      t.natMem v ≤ 1 ∧ (t.natMem v = 0 → 0 ≤ t.realMem v) ∧
      ∀ j, j ≠ v → t.natMem j = s.natMem j ∧ t.realMem j = s.realMem j := by
  let a : Data := {s with realReg := Function.update s.realReg 620 (s.realReg 502*s.realReg 616)}
  have ha := eval_mul s 620 502 616
  have haz : a.realReg 56 = 0 := by simpa [a] using hz
  by_cases htest : H b/2 < Q b*r
  · have ht : (Test.realLess 534 620).holds a := by simpa [Test.holds,a,hq,hr,hh] using htest
    refine ⟨4,infiniteResult a,Eval.seq ha (Eval.branchYes ht (infinite_eval a)),by omega,?_,?_,?_,?_⟩
    · simp [stored,Data.machine,infiniteResult,a,hv,readout,htest]
    · simp [infiniteResult,a,hv]
    · simp [infiniteResult,a,hv]
    · intro j hj
      simp [infiniteResult,a,hv,Function.update_of_ne hj]
  · have ht : ¬ (Test.realLess 534 620).holds a := by simpa [Test.holds,a,hq,hr,hh] using htest
    refine ⟨9,finiteResult a,Eval.seq ha (Eval.branchNo ht (finite_eval a haz)),le_rfl,?_,?_,?_,?_⟩
    · simp [stored,Data.machine,finiteResult,clamped,finitePrepared,finitePrefix,Atom.effect,
        instructionEffect,data,a,hv,hr,hf,readout,htest,ENNReal.ofReal_max]
    · simp [finiteResult,clamped,finitePrepared,finitePrefix,Atom.effect,instructionEffect,data,Data.machine,a,hv]
    · intro _
      simpa [finiteResult,clamped,finitePrepared,finitePrefix,Atom.effect,instructionEffect,data,Data.machine,a,hv] using
        (le_max_left 0 (s.realReg 518*s.realReg 616))
    · intro j hj
      simp [finiteResult,clamped,finitePrepared,finitePrefix,Atom.effect,instructionEffect,data,Data.machine,a,hv,Function.update_of_ne hj]
end DecrAlmostLinearSSSP.Decremental.CoreOutput
