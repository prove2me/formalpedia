  obtain ⟨L6, h6⟩ := h6
  obtain ⟨L7, h7⟩ := h7
  exact (expP_spec _ _ _ s L L6 L7 hL h6 h7).1

theorem expP_run' (s : IState HS) (h5 : s.IsInt 5) (h0 : 0 ≤ s.top 5) (h6 : s.IsInt 6)
