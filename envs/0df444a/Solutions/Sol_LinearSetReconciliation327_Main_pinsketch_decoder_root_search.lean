  have hcountWord : (keepFactor σ).length < 2 ^ E.W := by
    have hh : (keepFactor σ).length ≤ 1 := by by_cases h : σ.natDegree = 0 <;> simp [keepFactor, h]
    omega
  let m5 := Function.update m4 89 (keepFactor σ).length
  let m6 := Function.update m5 84 Q1
  have hCount : Sem P E (pc + 273) (pc + 295) (boundaryState (pc + 273) m4)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 295) m5) :=
    Sem.boundary_block P E _ (copyMetaCode 90 89) m4 m5 hCountAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 90 89 (keepFactor σ).length (by omega) (by omega) hcountWord (by simpa [boundaryState, m4] using hCount4))
  have hRestore : Sem P E (pc + 295) (pc + 317) (boundaryState (pc + 295) m5)
