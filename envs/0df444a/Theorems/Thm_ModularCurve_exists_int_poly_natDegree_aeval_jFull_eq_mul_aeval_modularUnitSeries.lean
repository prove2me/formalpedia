-- title:
--   Integral norm relation for g of Ogg's modular unit
-- statement:
--   Let $p$ be a prime and let $F = \mathbb{Q}(\{\,\mathrm{qExpand}_{\mathbb{Q},d}\, j_q : d \mid p,\ d \neq 0\,\})$ be the intermediate field `modularFunctionFieldFull p` of the Laurent series field $\mathbb{Q}((q))$ over $\mathbb{Q}$, generated by the $q$-expansions $j(q^d)$ for the divisors $d$ of $p$; write $j =$ `IgusaScheme.jFull p` for the element of $F$ given by the $q$-expansion of the $j$-invariant. Let $u =$ `modularUnitSeries p` $= \Delta(q)\cdot\Delta(q^p)^{-1}$, where $\Delta$ is `deltaSeries` (the Laurent series $q$ times the Dedekind eta unit power series) and $\Delta(q^p)$ its $p$-fold $q$-substitution, and assume the hypothesis `hmem` that $u$ lies in $F$. Let $v \in F$ satisfy either $v = u$ or $v = p^{12}u^{-1}$, and let $g \in \mathbb{Z}[X]$ be monic with $\deg g \geq 1$ and $g(0) \neq 0$. The assertion is that there exist $N \in \mathbb{Z}[X]$, a unit $\varepsilon \in \mathbb{Z}^{\times}$, an exponent $k \in \mathbb{N}$ and an element $c \in F$ such that $\deg N = \deg g \cdot (p-1)$ (truncated subtraction in $\mathbb{N}$), the leading coefficient of $N$ equals $\varepsilon\, g(0)^k$, $c$ lies in [`AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ F j`](def/AlgebraicCurve_TwoChartIntegralModel.html#L142), i.e. $c$ is integral over the $\mathbb{Z}$-subalgebra of $F$ generated by $j$, and $N(j) = c \cdot g(v)$ in $F$.
--
--   This is the norm-down step for Ogg's modular unit $u = \Delta(q)/\Delta(q^p)$ and its Fricke transform $p^{12}u^{-1}$: the norm of $g(v)$ from $F$ to $\mathbb{Q}(j)$ is an integral polynomial in $j$ whose degree and leading coefficient are controlled by $\deg g$ and $g(0)$, and the remaining conjugates assemble into a factor integral over $\mathbb{Z}[j]$. It feeds the finiteness statements for the level rings and the $j$-finite chart rings of the two-chart integral model, such as [`ModularCurve.HpoolLevelRing.finite_levelRing`](thm.html#ModularCurve.HpoolLevelRing.finite_levelRing) and [`ModularCurve.XHDRModelAtP.exists_forall_finite_quotient_span_aeval_and_finrank_le_chartAlgFin`](thm.html#ModularCurve.XHDRModelAtP.exists_forall_finite_quotient_span_aeval_and_finrank_le_chartAlgFin), and is proved from the integrality of $u$ and $p^{12}u^{-1}$ over $\mathbb{Z}[j]$ together with the degree and leading-coefficient computations for such norms.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_int_poly_natDegree_aeval_jFull_eq_mul_aeval_modularUnitSeries.lean

import Mathlib
import Definitions.Def_ModularCurve_ModularUnit
import Definitions.Def_ModularCurve_IgusaScheme
import Definitions.Def_AlgebraicCurve_TwoChartIntegralModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve Polynomial

theorem ModularCurve.exists_int_poly_natDegree_aeval_jFull_eq_mul_aeval_modularUnitSeries
    (p : ℕ) [Fact p.Prime] [NeZero p]
    (hmem : modularUnitSeries p ∈ modularFunctionFieldFull p)

    (v : ↥(ModularCurve.modularFunctionFieldFull p))
    (hv : v = ⟨modularUnitSeries p, hmem⟩ ∨
      v = (p : ↥(ModularCurve.modularFunctionFieldFull p)) ^ 12 * (⟨modularUnitSeries p, hmem⟩)⁻¹)
    (g : Polynomial ℤ) (hg : g.Monic) (hD : 1 ≤ g.natDegree) (h0 : g.coeff 0 ≠ 0) :
    ∃ (N : Polynomial ℤ) (ε : ℤˣ) (k : ℕ) (c : ↥(ModularCurve.modularFunctionFieldFull p)),
      N.natDegree = g.natDegree * (p - 1) ∧
      N.leadingCoeff = (ε : ℤ) * (g.coeff 0) ^ k ∧
      c ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ ↥(ModularCurve.modularFunctionFieldFull p) (IgusaScheme.jFull p) ∧
      (Polynomial.aeval (IgusaScheme.jFull p) N : ↥(ModularCurve.modularFunctionFieldFull p)) = c * Polynomial.aeval v g := by sorry
