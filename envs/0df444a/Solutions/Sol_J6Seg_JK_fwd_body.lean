  set G4 := update G3 SUM (0 :: G3 SUM) with hG4
  -- the dot loop
  have hAr := hAB r hr.le
  have hAl : (fA P fs v r).length = r := fA_length P fs v hr.le (by omega)
  have hSk : ∀ k ≤ cs.length, zsz (0 + dotF P (cs.take k) (fA P fs v r)) ≤ Bx := by
    intro k hk
    have := dotF_take_zsz P Xb Bc (hcB r hr) hAr (lt_of_le_of_lt hcl (lt_trans hr hmB)) k
    rw [zero_add]
    exact le_trans (zsz_le_of_lt this) (by omega)
