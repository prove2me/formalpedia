-- Source module: Solutions.J6LineTop2
/-!
# `LineNeed6` top level, part 2: registers, size bounds and the sweep cost

* `sgm dS dA`: nineteen registers in `1..22`, avoiding `0`, `dS`, `dA` (`sgm_ok : SwOK`).
* `swB_of`: with `QOk ⟨P, n, src⟩` the bound `B = 8 b' + 8` meets `SwB`.
* `sweep_cost_le`: the sweep overhead `10^9 (B+2)^2 (2D+3) + 2 ≤ 10^12 · cU6 P n A`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The registers -/

theorem sgV_mono (a b : ℕ) {x y : ℕ} (h : x < y) : sgV a b x < sgV a b y := by
  unfold sgV skp; split_ifs <;> omega

theorem sgV_ne0 (a b x : ℕ) : sgV a b x ≠ 0 := by
  unfold sgV skp; split_ifs <;> omega

theorem sgV_neA (a b x : ℕ) : sgV a b x ≠ a := by
  unfold sgV skp; split_ifs <;> omega

theorem sgV_neB (a b x : ℕ) : sgV a b x ≠ b := by
  unfold sgV skp; split_ifs <;> omega

theorem sgm_ok (dS dA : Fin HS) (h0 : dS ≠ 0) (hS : dS.val < 56) (hA : dA ≠ 0) :
    SwOK (sgm dS dA) dS dA where
  inj := by
    intro i j hij
    have e : sgV dS.val dA.val i.val = sgV dS.val dA.val j.val := congrArg Fin.val hij
    rcases lt_trichotomy i.val j.val with h | h | h
    · exact absurd e (sgV_mono _ _ h).ne
    · exact Fin.ext h
    · exact absurd e (sgV_mono _ _ h).ne'
  ne0 i := by
    intro e; exact sgV_ne0 dS.val dA.val i.val (congrArg Fin.val e)
  neS i := by
    intro e; exact sgV_neA dS.val dA.val i.val (congrArg Fin.val e)
  neA i := by
    intro e; exact sgV_neB dS.val dA.val i.val (congrArg Fin.val e)
  lt i := by
    show sgV dS.val dA.val i.val < 56
    have := sgV_lt dS.val dA.val i.val; have := i.isLt; omega
  S0 := h0
  Slt := hS
  A0 := hA

/-! ## The size bound -/

theorem TW_eq (P : Prm) (n D : ℕ) (hD : dP6 P n = D + 1) (hl : 1 ≤ ℓP6 P n) :
    TW P n D = 2 ^ LP6 P n := by
  unfold TW
  rw [List.prod_ofFn]
  show ∏ i : Fin (D + 1), tF6 P n i.val = _
  rw [Fin.prod_univ_eq_prod_range (fun j => tF6 P n j) (D + 1), ← hD]
  exact prod_tF6 P n (by omega) hl

theorem swB_of (P : Prm) (n : ℕ) (src : ℕ → ℕ) (hQ : QOk ⟨P, n, src⟩) (D : ℕ)
    (hD : dP6 P n = D + 1) : SwB P n src D (bSw P n) := by
  have hD' : (⟨P, n, src⟩ : IntMul.Kappa.R6.Q6).d = D + 1 := hD
  obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := small_facts6 hQ hD'
  have hLb : LP6 P n + 2 ≤ b'P6 P n := hQ.hLb
  have hdb : dP6 P n + 4 ≤ b'P6 P n := hQ.hdb
  have hl2 : 2 ≤ ℓP6 P n := hQ.hℓ2
  have hsm : ∀ x : ℕ, x ≤ 2 ^ b'P6 P n → zsz (x : ℤ) ≤ bSw P n := fun x hx => by
    have := NLogN.KFM.zsz_small (b := b'P6 P n) (x := (x : ℤ)) (by positivity)
      (by exact_mod_cast hx)
    unfold bSw; omega
  refine ⟨by unfold bSw; omega, ?_, ?_, hsm _ a6, hsm _ a4, fun k hk => ?_⟩
  · -- `h d + d + 1 ≤ B`
    have hdl : ℓP6 P n * dP6 P n ≤ LP6 P n + dP6 P n - 1 := Nat.div_mul_le_self _ _
    have hh : hN6 P n * (D + 1) ≤ ℓP6 P n * dP6 P n := by
      rw [← hD]; exact Nat.mul_le_mul_right _ (by unfold hN6; omega)
    unfold bSw; omega
  · rw [TW_eq P n D hD (by omega)]
    have := NLogN.KFG.zsz_two_pow (LP6 P n)
    push_cast
    unfold bSw; omega
  · exact hsm _ (a7 k (by show k < dP6 P n; omega)).1

/-! ## The cost -/

theorem T_le_cU6 (P : Prm) (hP : P.Ok) (n A : ℕ) : (TP6 P n : ℝ) ≤ cU6 P n A := by
  unfold cU6 VP6
  have h1 : (1 : ℝ) ≤ pP6 P n := by
    have := b'P6_pos P n
    have e : pP6 P n = 6 * b'P6 P n := rfl
    exact_mod_cast (show 1 ≤ pP6 P n by omega)
  have h2 := Ncost6_ge_one P hP n
  have h3 : (1 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A := one_le_pow₀ (lgn_ge n)
  have hT : (0 : ℝ) ≤ TP6 P n := by positivity
  calc (TP6 P n : ℝ) = TP6 P n * 1 * 1 * 1 := by ring
    _ ≤ TP6 P n * pP6 P n * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A := by
      gcongr

theorem cU6_mono (P : Prm) (hP : P.Ok) (n : ℕ) {A A' : ℕ} (h : A ≤ A') :
    cU6 P n A ≤ cU6 P n A' := by
  unfold cU6
  have h0 : (0 : ℝ) ≤ VP6 P n * Ncost6 P n := by
    unfold VP6; have := Ncost6_ge_one P hP n; positivity
  exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (lgn_ge n) h) h0

theorem sweep_cost_le (P : Prm) (hP : P.Ok) (n : ℕ) (src : ℕ → ℕ) (hQ : QOk ⟨P, n, src⟩)
    (D : ℕ) (hD : dP6 P n = D + 1) (A : ℕ) :
    (10 : ℝ) ^ 9 * ((bSw P n : ℝ) + 2) ^ 2 * (2 * D + 3) + 2 ≤ 10 ^ 12 * cU6 P n A := by
  have hb64 : 64 ≤ b'P6 P n := hQ.hb
  have hdb : dP6 P n + 4 ≤ b'P6 P n := hQ.hdb
  have hb6 : b'P6 P n ^ 6 ≤ TP6 P n := hQ.hb6
  set b := b'P6 P n with hbd
  have hN : 10 ^ 9 * (bSw P n + 2) ^ 2 * (2 * D + 3) + 2 ≤ 10 ^ 12 * TP6 P n := by
    have e1 : bSw P n + 2 ≤ 9 * b := by unfold bSw; omega
    have e2 : 2 * D + 3 ≤ 3 * b := by omega
    have e3 : (bSw P n + 2) ^ 2 ≤ (9 * b) ^ 2 := Nat.pow_le_pow_left e1 2
    have e4 : b ^ 3 ≤ b ^ 6 := Nat.pow_le_pow_right (by omega) (by norm_num)
    have e5 : 10 ^ 9 * (bSw P n + 2) ^ 2 * (2 * D + 3) ≤ 10 ^ 9 * (9 * b) ^ 2 * (3 * b) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left _ e3) e2
    have e6 : 10 ^ 9 * (9 * b) ^ 2 * (3 * b) + 2 ≤ 10 ^ 12 * b ^ 3 := by
      have : 1 ≤ b ^ 3 := Nat.one_le_pow _ _ (by omega)
      ring_nf; omega
    have e7 : 10 ^ 12 * b ^ 3 ≤ 10 ^ 12 * TP6 P n := Nat.mul_le_mul_left _ (e4.trans hb6)
    omega
  have hT := T_le_cU6 P hP n A
  have : ((10 ^ 9 * (bSw P n + 2) ^ 2 * (2 * D + 3) + 2 : ℕ) : ℝ) ≤ ((10 ^ 12 * TP6 P n : ℕ) : ℝ) :=
    by exact_mod_cast hN
  push_cast at this
  nlinarith

end J6Seg

end

