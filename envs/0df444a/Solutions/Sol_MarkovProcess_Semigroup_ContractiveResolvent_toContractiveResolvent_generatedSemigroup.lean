open scoped NNReal



variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]



namespace MarkovProcess.Semigroup.ContractiveResolvent

end MarkovProcess.Semigroup.ContractiveResolvent
open MarkovProcess.Semigroup.ContractiveResolvent
theorem solution (R : ContractiveResolvent E) :
    R.generatedSemigroup.toContractiveResolvent = R := by
  cases R
  simp only [StronglyContinuousContractionSemigroup.toContractiveResolvent,
    ContractiveResolvent.mk.injEq]
  funext μ
  exact resolvent_generatedSemigroup _ μ
