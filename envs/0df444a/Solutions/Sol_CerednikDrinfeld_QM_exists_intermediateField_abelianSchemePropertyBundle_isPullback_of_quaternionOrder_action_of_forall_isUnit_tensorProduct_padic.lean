theorem baseChange_mul_fst {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (G : RelativeGroupLaw S f)
    {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S'))
    (x y : SchemeHomOver t' (pullback.snd f (Spec.map (CommRingCat.ofHom φ)))) :
    ((G.baseChange (Spec.map (CommRingCat.ofHom φ))).mul t' x y).1 ≫ pullback.fst f (Spec.map (CommRingCat.ofHom φ)) =
      (G.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
        ⟨x.1 ≫ pullback.fst f (Spec.map (CommRingCat.ofHom φ)), by
          rw [Category.assoc, pullback.condition, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ pullback.fst f (Spec.map (CommRingCat.ofHom φ)), by
          rw [Category.assoc, pullback.condition, ← Category.assoc, y.2]⟩).1 := by
  have h := congrArg Subtype.val
    (RelativeGroupLaw.baseChangePointToBase_mul (Spec.map (CommRingCat.ofHom φ)) G t' x y)
  rw [RelativeGroupLaw.baseChangePointToBase_coe] at h
  exact h

theorem isTorsionPoint_baseCongr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (G : RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂) (n : ℕ)
    (x : SchemeHomOver t₁ f) (hx : G.IsTorsionPoint t₁ n x) :
    G.IsTorsionPoint t₂ n ⟨x.1, by rw [← h]; exact x.2⟩ := by
  subst h
  exact hx

theorem isTorsionPoint_map_of_mul' {R R' : Type} [CommRing R] [CommRing R'] {X Y T : Scheme.{0}}
    {fX : X ⟶ Spec (CommRingCat.of R)} {fY : Y ⟶ Spec (CommRingCat.of R')}
    (GX : RelativeGroupLaw R fX) (GY : RelativeGroupLaw R' fY) (t : T ⟶ Spec (CommRingCat.of R))
    (t' : T ⟶ Spec (CommRingCat.of R')) (φ : SchemeHomOver t fX → SchemeHomOver t' fY)
    (hφ : ∀ x y : SchemeHomOver t fX, φ (GX.mul t x y) = GY.mul t' (φ x) (φ y))
    (n : ℕ) (x : SchemeHomOver t fX) (hx : GX.IsTorsionPoint t n x) : GY.IsTorsionPoint t' n (φ x) := by
  have hone : φ (GX.one t) = GY.one t' := by
    have h : GY.mul t' (φ (GX.one t)) (φ (GX.one t)) = φ (GX.one t) := by rw [← hφ, GX.one_mul]
    calc φ (GX.one t)
        = GY.mul t' (GY.inv t' (φ (GX.one t))) (GY.mul t' (φ (GX.one t)) (φ (GX.one t))) := by
            rw [← GY.mul_assoc, GY.inv_mul_cancel, GY.one_mul]
      _ = GY.one t' := by rw [h, GY.inv_mul_cancel]
  have hnsmul : ∀ k : ℕ, φ (GX.nsmul t k x) = GY.nsmul t' k (φ x) := by
    intro k
    induction k with
    | zero => exact hone
    | succ k ih =>
        change φ (GX.mul t (GX.nsmul t k x) x) = GY.mul t' (GY.nsmul t' k (φ x)) (φ x)
        rw [hφ, ih]
  rw [RelativeGroupLaw.isTorsionPoint_def] at hx ⊢
  rw [← hnsmul, hx, hone]

theorem restrictScalars_mem_inertiaSubgroupIn {F E Ω : Type} [Field F] [Field E] [Field Ω] [Algebra F E]
    [Algebra E Ω] [Algebra F Ω] [IsScalarTower F E Ω] (A : ValuationSubring Ω) {σ : Ω ≃ₐ[E] Ω}
    (hσ : σ ∈ A.inertiaSubgroupIn E) : σ.restrictScalars F ∈ A.inertiaSubgroupIn F := by
  refine ValuationSubring.mem_inertiaSubgroupIn_of_valuation_sub_lt_one A ?_ ?_
  · ext x
    rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, AlgEquiv.smul_def]
    have h1 : (σ.restrictScalars F)⁻¹ x = σ⁻¹ x := rfl
    rw [h1]
    have hσinv : σ⁻¹ ∈ A.inertiaSubgroupIn E := inv_mem hσ
    exact mem_iff_apply_mem_of_mem_inertiaSubgroupIn A hσinv x
  · intro a ha
    exact (ValuationSubring.valuation_sub_lt_one_of_mem_inertiaSubgroupIn A hσ ha).2

