    (h0 : s.G 0 = NLogN.ints L ++ R0) (hR : s.G NLogN.KFM.pR = .int (2 ^ γ) :: LR) (hw : ∀ x ∈ L, NLogN.zsz x ≤ w) :
    NLogN.IRuns I iprog (NLogN.KFM.itemP NLogN.KFM.shlB L.length) s (s.upd 0 (NLogN.ints (L.map (· * 2 ^ γ)) ++ R0))
      (NLogN.KFM.cItem L.length (1000 * (w + γ + 2)) (w + γ + 1)) := by
