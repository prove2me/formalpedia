-- title:
--   Exact killed mesh Stieltjes payment identity for genuine shifted Lévy future
-- statement:
--   For any genuine spectrally negative Lévy path and any deterministic shifted future, every finite rational mesh prefix of the actual shifted running-supremum Stieltjes dividend integral equals the finite discounted killed sum of true future-record increments. The stopping clock is arbitrary and no renewal law is assumed.
-- source:
--   Use the Proved shifted original-clock Stieltjes Ioc cash-increment theorem and generic constant-on-mesh-cell killed integral identity, then the Proved finite half-open-interval Stieltjes partition. This is the source-faithful finite step in the future payout reconstruction.

import Mathlib
import Theorems.Thm_AvramDividend_Classical_lintegral_Ioc_partition_fin
import Theorems.Thm_AvramDividend_Classical_avram_root29_05_shiftedSup_stieltjes_Ioc_eq_record_increment
import Theorems.Thm_AvramDividend_Classical_avram_root29_05_killed_mesh_cell_integral_eq_mass

open AvramDividend.Classical MeasureTheory Set
open scoped NNReal ENNReal BigOperators Classical

/-- The actual Stieltjes regulator generated by shifted Lévy future records
integrates killed discounted mesh payments to exact shifted cash increments. -/

theorem AvramDividend.Classical.avram_root29_05_shifted_killed_mesh_prefix_integral_identity
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕) (ω : Ω) (age : ℝ≥0)
    (q : ℝ) (τ : ℝ≥0∞) (n N : ℕ) :
    let M : ℝ≥0 → ℝ := fun v =>
      sSup ((fun w : ℝ≥0 => X.X (age + w) ω - X.X age ω) '' Icc 0 v)
    let μ : Measure ℝ := dividendMeasure (fun r (_ : Ω) => M r) ω
    let grid : ℕ → ℝ := fun j => (j : ℝ) / ((n : ℝ) + 1)
    (∫⁻ r in Ioc (grid 0) (grid N),
      (let e := ((⌈r * ((n : ℝ) + 1)⌉ : ℤ) : ℝ) / ((n : ℝ) + 1)
       if ENNReal.ofReal e < τ then
         ENNReal.ofReal (Real.exp (-(q * e))) else 0) ∂μ) =
    ∑ k ∈ Finset.range N,
      (if ENNReal.ofReal (grid (k + 1)) < τ then
        ENNReal.ofReal (Real.exp (-(q * grid (k + 1)))) else 0) *
      ENNReal.ofReal (M (grid (k + 1)).toNNReal -
        M (grid k).toNNReal) := by sorry
