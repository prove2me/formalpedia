theorem _root_.solution (f : ι → Kˣ) (M : Submodule R (ι → K)) (hf : ∀ i j, f i = f j) (i : ι) :
    GL.diagonal f • M = f i • M := by
  have : f = fun _ ↦ f i := by
    ext : 1
    apply hf
  rw [this, SetLike.ext'_iff]
  ext x
  simp [mem_smul, Set.mem_smul_set, Units.smul_def]
end Matrix.GeneralLinearGroup
