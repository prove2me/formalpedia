/-!
# B-line machine, sweep 1: in-place axis maps

The machine keeps the array in its row-major layout and applies the line map of axis `i` in
place (no axis rotation). For a box `dims` and an axis `i`, the array is `(pre, n, post)`
(`pre = ∏_{j<i}`, `n = dims_i`, `post = ∏_{j>i}`), and

* `axisL n post f L`: every `(n, post)` block is transposed, `f` is applied to each of its `post`
  lines, and the block is transposed back;
* **`axisL_getD`**: entry `b (n·post) + a·post + c` of `axisL n post f L` is entry `a` of `f`
  applied to the line `k ↦ L[b (n·post) + k·post + c]`;
* **`digL_split`**: the row-major digits of `b (n·post) + a·post + c`;
* **`axisL_listOf`**: on `listOf dims g`, `axisL` is the slice map `j ↦ A (k ↦ g (j[i ↦ k])) (j i)`.
-/

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Products of a list around a position -/

theorem prod_split3 : ∀ (l : List ℕ) (i : ℕ), i < l.length →
    l.prod = (l.take i).prod * (l.getD i 1 * (l.drop (i + 1)).prod)
  | [], _, h => by simp at h
  | a :: l, 0, _ => by simp
  | a :: l, i + 1, h => by
    simp only [List.length_cons] at h
    simp only [List.prod_cons, List.take_succ_cons, List.getD_cons_succ, List.drop_succ_cons]
    rw [prod_split3 l i (by omega)]; ring

/-! ## Row-major digits of a split index -/

/-! ## In-place axis maps -/

section axis
variable {α : Type*} [Inhabited α]

lemma getD_drop_take (L : List α) (o m q : ℕ) (hq : q < m) :
    ((L.drop o).take m).getD q default = L.getD (o + q) default := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_take, List.getElem?_drop, if_pos hq]

lemma ext_getD' {X Y : List α} (hl : X.length = Y.length)
    (h : ∀ k < X.length, X.getD k default = Y.getD k default) : X = Y := by
  apply List.ext_getElem hl
  intro k h1 h2
  have := h k h1
  rwa [List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2] at this

lemma mod_div_split {a c post : ℕ} (hc : c < post) :
    (a * post + c) % post = c ∧ (a * post + c) / post = a := by
  have hp : 0 < post := by omega
  constructor
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt hc, zero_add]

lemma lt_mul_of_split {a c n post : ℕ} (ha : a < n) (hc : c < post) : a * post + c < n * post := by
  have : (a + 1) * post ≤ n * post := Nat.mul_le_mul_right _ (by omega)
  rw [Nat.succ_mul] at this; omega

/-- The blocks of a `(pre, n·post)` array. -/
theorem chunk_blocks (m pre : ℕ) (hm : 0 < m) (L : List α) (hL : L.length = pre * m) :
    IntMul.HvdH.Ref.chunkL m L = (List.range pre).map (fun i => (L.drop (i * m)).take m) ∧
      ∀ B ∈ (List.range pre).map (fun i => (L.drop (i * m)).take m), B.length = m := by
  refine ⟨IntMul.HvdH.RefPf.chunkL_eq m pre hm L hL, fun B hB => ?_⟩
  simp only [List.mem_map, List.mem_range] at hB
  obtain ⟨i, hi, rfl⟩ := hB
  simp only [List.length_take, List.length_drop, hL]
  have : (i + 1) * m ≤ pre * m := Nat.mul_le_mul_right _ hi
  rw [Nat.succ_mul] at this; omega

theorem length_blkImg (n post : ℕ) (f : List α → List α) (B : List α) :
    (blkImg n post f B).length = n * post := by
  simp only [blkImg, IntMul.HvdH.RefPf.transposeL_length]

theorem blkImg_getD (n post : ℕ) (hn : 0 < n) (f : List α → List α)
    (hf : ∀ X : List α, X.length = n → (f X).length = n) (B : List α)
    (hB : B.length = n * post) {a c : ℕ} (ha : a < n) (hc : c < post) :
    (blkImg n post f B).getD (a * post + c) default =
      (f ((List.range n).map fun k => B.getD (k * post + c) default)).getD a default := by
  obtain ⟨hq1, hq2⟩ := mod_div_split (a := a) hc
  unfold blkImg
  rw [IntMul.HvdH.RefPf.transposeL_getD post n _ _ (lt_mul_of_split ha hc), hq1, hq2]
  set T := transposeL n post B with hT
  have hTl : T.length = post * n := IntMul.HvdH.RefPf.transposeL_length n post B
  obtain ⟨hch, hlen⟩ := chunk_blocks n post hn T hTl
  rw [hch, List.flatMap_def, List.map_map]
  have hrows : ∀ row ∈ (List.range post).map (f ∘ fun i => (T.drop (i * n)).take n),
      row.length = n := by
    intro row hrow
    simp only [List.mem_map, List.mem_range, Function.comp] at hrow
    obtain ⟨i, hi, rfl⟩ := hrow
    exact hf _ (hlen _ (List.mem_map.2 ⟨i, List.mem_range.2 hi, rfl⟩))
  rw [IntMul.HvdH.RefPf.flatten_getD_uniform n default _ hrows c (by simp; exact hc) a ha]
  rw [List.getD_eq_getElem _ [] (by simp; exact hc), List.getElem_map, List.getElem_range,
    Function.comp_apply]
  congr 2
  apply ext_getD'
  · simp only [List.length_take, List.length_drop, hTl, List.length_map, List.length_range]
    have : (c + 1) * n ≤ post * n := Nat.mul_le_mul_right _ (by omega)
    rw [Nat.succ_mul] at this; omega
  · intro k hk
    have hkn : k < n := by
      simp only [List.length_take] at hk; omega
    have hq : c * n + k < post * n := by
      have : (c + 1) * n ≤ post * n := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.succ_mul] at this; omega
    obtain ⟨e1, e2⟩ := mod_div_split (a := c) (post := n) hkn
    rw [getD_drop_take T _ _ _ hkn, hT, IntMul.HvdH.RefPf.transposeL_getD n post B _ hq, e1, e2]
    rw [List.getD_eq_getElem ((List.range n).map _) _ (by simp; exact hkn), List.getElem_map, List.getElem_range]

theorem length_axisL (n post : ℕ) (hn : 0 < n) (hp : 0 < post) (f : List α → List α)
    (L : List α) (pre : ℕ) (hL : L.length = pre * (n * post)) :
    (axisL n post f L).length = pre * (n * post) := by
  obtain ⟨hch, hlen⟩ := chunk_blocks (n * post) pre (by positivity) L hL
  unfold axisL
  rw [hch, List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform (n * post)]
  · simp
  · intro row hrow
    simp only [List.mem_map] at hrow
    obtain ⟨B, _, rfl⟩ := hrow
    exact length_blkImg n post f B

theorem axisL_getD (n post : ℕ) (hn : 0 < n) (hp : 0 < post) (f : List α → List α)
    (hf : ∀ X : List α, X.length = n → (f X).length = n) (L : List α) (pre : ℕ)
    (hL : L.length = pre * (n * post)) {b a c : ℕ} (hb : b < pre) (ha : a < n) (hc : c < post) :
    (axisL n post f L).getD (b * (n * post) + a * post + c) default =
      (f (lineAt n post L b c)).getD a default := by
  obtain ⟨hch, hlen⟩ := chunk_blocks (n * post) pre (by positivity) L hL
  unfold axisL
  rw [hch, List.flatMap_def]
  have hrows : ∀ row ∈ ((List.range pre).map fun i => (L.drop (i * (n * post))).take (n * post)).map
      (blkImg n post f), row.length = n * post := by
    intro row hrow
    simp only [List.mem_map] at hrow
    obtain ⟨B, _, rfl⟩ := hrow
    exact length_blkImg n post f B
  rw [Nat.add_assoc, IntMul.HvdH.RefPf.flatten_getD_uniform (n * post) default _ hrows b
    (by simp; exact hb) _ (lt_mul_of_split ha hc)]
  rw [List.getD_eq_getElem _ [] (by simp; exact hb), List.getElem_map, List.getElem_map,
    List.getElem_range]
  have hBl := hlen _ (List.mem_map.2 ⟨b, List.mem_range.2 hb, rfl⟩)
  rw [blkImg_getD n post hn f hf _ hBl ha hc]
  congr 2
  unfold lineAt
  apply List.map_congr_left
  intro k hk
  rw [List.mem_range] at hk
  rw [getD_drop_take L _ _ _ (lt_mul_of_split hk hc), Nat.add_assoc]

end axis

/-! ## The sweep is the tensor product -/

end J6Seg

end

section
-- Source module: Solutions.J6SegSw2
/-!
# B-line machine, sweep 2: the per-axis passes on line representations

A `(pre, n, post)` array `L` *represents* the lines `φ b c` (`LRep pre n post L φ`) when
`L[b (n·post) + a·post + c] = (φ b c)[a]`. The machine's passes act on representations:

* **`LRep_axisL`**: the in-place axis map applies `f` to every line;
* **`LRep_slabPass`**: a monotone slab pass (output slab `l` = `h l` of input slab `src l`, or
  zeros) applies `slabLine` to every line (selection, `J` gather and scatter, output);
* **`LRep_kerPass`**: expose `(A, m, post) → (A, post, m)` (`blkTg`), apply a kernel to each
  contiguous `m`-row (indexed by its block), expose back;
* **`LRep_split` / `LRep_join`**: `(pre, nc·λ, post)` is `(pre·nc, λ, post)`;
* **`LRep_chunkPass`**: the chunk kernel `chunksG g λ nc` on every line, by one `λ`-exposure.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

section passes
variable {α β : Type*} [Inhabited α] [Inhabited β]

lemma idx3 {pre n post x : ℕ} (hx : x < pre * (n * post)) :
    ∃ b a c, b < pre ∧ a < n ∧ c < post ∧ x = b * (n * post) + a * post + c := by
  have hnp : 0 < n * post := by
    rcases Nat.eq_zero_or_pos (n * post) with h | h
    · rw [h, mul_zero] at hx; omega
    · exact h
  have hp0 : 0 < post := Nat.pos_of_ne_zero (fun h => by rw [h, mul_zero] at hnp; omega)
  obtain ⟨b, r, rfl, hr⟩ : ∃ b r, x = b * (n * post) + r ∧ r < n * post :=
    ⟨x / (n * post), x % (n * post), (Nat.div_add_mod' x (n * post)).symm, Nat.mod_lt _ hnp⟩
  obtain ⟨a, c, rfl, hc⟩ : ∃ a c, r = a * post + c ∧ c < post :=
    ⟨r / post, r % post, (Nat.div_add_mod' r post).symm, Nat.mod_lt _ hp0⟩
  have ha : a < n := by
    by_contra hcon; push Not at hcon
    have : n * post ≤ a * post := Nat.mul_le_mul_right _ hcon
    omega
  have hb : b < pre := by
    by_contra hcon; push Not at hcon
    have : pre * (n * post) ≤ b * (n * post) := Nat.mul_le_mul_right _ hcon
    omega
  exact ⟨b, a, c, hb, ha, hc, by omega⟩

lemma idx3_lt {pre n post b a c : ℕ} (hb : b < pre) (ha : a < n) (hc : c < post) :
    b * (n * post) + a * post + c < pre * (n * post) := by
  have h1 := lt_mul_of_split ha hc
  have : (b + 1) * (n * post) ≤ pre * (n * post) := Nat.mul_le_mul_right _ (by omega)
  rw [Nat.succ_mul] at this; omega

/-- A representation determines the array. -/
theorem LRep_ext {pre n post : ℕ} {L L' : List α} {φ : ℕ → ℕ → List α}
    (h : LRep pre n post L φ) (h' : LRep pre n post L' φ) : L = L' := by
  apply ext_getD' (by rw [h.1, h'.1])
  intro x hx
  rw [h.1] at hx
  obtain ⟨b, a, c, hb, ha, hc, rfl⟩ := idx3 hx
  rw [h.2.2 b hb a ha c hc, h'.2.2 b hb a ha c hc]

theorem LRep_congr {pre n post : ℕ} {L : List α} {φ ψ : ℕ → ℕ → List α}
    (h : LRep pre n post L φ) (he : ∀ b < pre, ∀ c < post, φ b c = ψ b c) :
    LRep pre n post L ψ :=
  ⟨h.1, fun b hb c hc => by rw [← he b hb c hc]; exact h.2.1 b hb c hc,
    fun b hb a ha c hc => by rw [← he b hb c hc]; exact h.2.2 b hb a ha c hc⟩

/-- Every array of the right length represents its own lines. -/
theorem LRep_lineAt {pre n post : ℕ} {L : List α} (hL : L.length = pre * (n * post)) :
    LRep pre n post L (fun b c => lineAt n post L b c) := by
  refine ⟨hL, fun b _ c _ => by simp [lineAt], fun b hb a ha c hc => ?_⟩
  unfold lineAt
  rw [List.getD_eq_getElem ((List.range n).map _) _ (by simp; exact ha), List.getElem_map, List.getElem_range]

theorem lineAt_of_LRep {pre n post : ℕ} {L : List α} {φ : ℕ → ℕ → List α}
    (h : LRep pre n post L φ) {b c : ℕ} (hb : b < pre) (hc : c < post) :
    lineAt n post L b c = φ b c := by
  apply ext_getD' (by rw [h.2.1 b hb c hc]; simp [lineAt])
  intro k hk
  simp only [lineAt, List.length_map, List.length_range] at hk
  unfold lineAt
  rw [List.getD_eq_getElem _ _ (by simp; exact hk), List.getElem_map, List.getElem_range]
  exact h.2.2 b hb k hk c hc

/-- **The in-place axis map on a representation.** -/
theorem LRep_axisL {pre n post : ℕ} (hn : 0 < n) (hp : 0 < post) {L : List α}
    {φ : ℕ → ℕ → List α} (h : LRep pre n post L φ) (f : List α → List α)
    (hf : ∀ X : List α, X.length = n → (f X).length = n) :
    LRep pre n post (axisL n post f L) (fun b c => f (φ b c)) := by
  refine ⟨length_axisL n post hn hp f L pre h.1, fun b hb c hc => hf _ (h.2.1 b hb c hc),
    fun b hb a ha c hc => ?_⟩
  rw [axisL_getD n post hn hp f hf L pre h.1 hb ha hc, lineAt_of_LRep h hb hc]

/-! ## Slab passes -/

/-! ## Exposures and kernels on rows -/

theorem length_blkTg (m k a : ℕ) (zs : List α) : (blkTg m k a zs).length = a * (k * m) := by
  unfold blkTg
  rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform (k * m)]
  · simp
  · intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨i, _, rfl⟩ := hrow
    exact IntMul.HvdH.RefPf.transposeL_length m k _

theorem blkTg_getD (m k a : ℕ) (zs : List α) {i c r : ℕ} (hi : i < a) (hc : c < k)
    (hr : r < m) :
    (blkTg m k a zs).getD (i * (k * m) + c * m + r) default =
      zs.getD (i * (m * k) + r * k + c) default := by
  unfold blkTg
  have hrows : ∀ row ∈ (List.range a).map (fun i => transposeL m k ((zs.drop (i * (m * k))).take
      (m * k))), row.length = k * m := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨i, _, rfl⟩ := hrow
    exact IntMul.HvdH.RefPf.transposeL_length m k _
  rw [List.flatMap_def, Nat.add_assoc, IntMul.HvdH.RefPf.flatten_getD_uniform (k * m) default _
    hrows i (by simp; exact hi) _ (lt_mul_of_split hc hr)]
  rw [List.getD_eq_getElem _ [] (by simp; exact hi), List.getElem_map, List.getElem_range]
  obtain ⟨e1, e2⟩ := mod_div_split (a := c) (post := m) hr
  rw [IntMul.HvdH.RefPf.transposeL_getD m k _ _ (lt_mul_of_split hc hr), e1, e2,
    getD_drop_take zs _ _ _ (lt_mul_of_split hr hc), Nat.add_assoc]

theorem rowMap_spec (n R : ℕ) (g : ℕ → List α → List α)
    (hg : ∀ r X, X.length = n → (g r X).length = n) (X : List α) (hX : X.length = R * n) :
    (rowMap n R g X).length = R * n ∧ ∀ r < R, ∀ a < n,
      (rowMap n R g X).getD (r * n + a) default = (g r ((X.drop (r * n)).take n)).getD a default := by
  have hrows : ∀ row ∈ (List.range R).map (fun r => g r ((X.drop (r * n)).take n)),
      row.length = n := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨r, hr, rfl⟩ := hrow
    apply hg
    simp only [List.length_take, List.length_drop, hX]
    have : (r + 1) * n ≤ R * n := Nat.mul_le_mul_right _ hr
    rw [Nat.succ_mul] at this; omega
  refine ⟨?_, fun r hr a ha => ?_⟩
  · unfold rowMap
    rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform n _ hrows]; simp
  · unfold rowMap
    rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform n default _ hrows r
      (by simp; exact hr) a ha]
    rw [List.getD_eq_getElem _ [] (by simp; exact hr), List.getElem_map, List.getElem_range]

theorem LRep_kerPass {A m post : ℕ} (hm : 0 < m) (hp : 0 < post) {L : List α}
    {φ : ℕ → ℕ → List α} (hL : LRep A m post L φ) (g : ℕ → List α → List α)
    (hg : ∀ b X, X.length = m → (g b X).length = m) :
    LRep A m post (kerPass m post A g L) (fun b c => g b (φ b c)) := by
  set X := blkTg m post A L with hXdef
  have hXl : X.length = A * post * m := by rw [length_blkTg]; ring
  obtain ⟨hYl, hY⟩ := rowMap_spec m (A * post) (fun r => g (r / post)) (fun r X h => hg _ X h) X hXl
  have hrow : ∀ b < A, ∀ c < post, (X.drop ((b * post + c) * m)).take m = φ b c := by
    intro b hb c hc
    apply ext_getD' (by
      rw [hL.2.1 b hb c hc]; simp only [List.length_take, List.length_drop, hXl]
      have : (b * post + c + 1) * m ≤ A * post * m :=
        Nat.mul_le_mul_right _ (by
          have : (b + 1) * post ≤ A * post := Nat.mul_le_mul_right _ hb
          rw [Nat.succ_mul] at this; omega)
      rw [Nat.succ_mul] at this; omega)
    intro k hk
    have hkm : k < m := by simp only [List.length_take] at hk; omega
    rw [getD_drop_take X _ _ _ hkm, hXdef,
      show (b * post + c) * m + k = b * (post * m) + c * m + k by ring,
      blkTg_getD m post A L hb hc hkm]
    exact hL.2.2 b hb k hkm c hc
  refine ⟨?_, fun b hb c hc => hg b _ (hL.2.1 b hb c hc), fun b hb a ha c hc => ?_⟩
  · unfold kerPass; rw [length_blkTg]
  unfold kerPass
  rw [blkTg_getD post m A _ hb ha hc, show b * (post * m) + c * m + a = (b * post + c) * m + a by
    ring, hY _ (by
      have : (b + 1) * post ≤ A * post := Nat.mul_le_mul_right _ hb
      rw [Nat.succ_mul] at this; omega) a ha]
  have hdiv : (b * post + c) / post = b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt hc, zero_add]
  simp only [hdiv]
  rw [hrow b hb c hc]

/-! ## Reshaping `(pre, nc·λ, post) ↔ (pre·nc, λ, post)` -/

theorem LRep_split {pre nc lam post : ℕ} (hl : 0 < lam) (hnc : 0 < nc) {L : List α}
    {φ : ℕ → ℕ → List α} (hL : LRep pre (nc * lam) post L φ) :
    LRep (pre * nc) lam post L (fun b c => ((φ (b / nc) c).drop (b % nc * lam)).take lam) := by
  refine ⟨by rw [hL.1]; ring, fun b hb c hc => ?_, fun b hb a ha c hc => ?_⟩
  · have hb' : b / nc < pre := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hb)
    have hq := Nat.mod_lt b hnc
    simp only [List.length_take, List.length_drop, hL.2.1 _ hb' c hc]
    have : (b % nc + 1) * lam ≤ nc * lam := Nat.mul_le_mul_right _ hq
    rw [Nat.succ_mul] at this; omega
  · have hb' : b / nc < pre := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hb)
    have hq := Nat.mod_lt b hnc
    have hql : b % nc * lam + a < nc * lam := by
      have : (b % nc + 1) * lam ≤ nc * lam := Nat.mul_le_mul_right _ hq
      rw [Nat.succ_mul] at this; omega
    rw [getD_drop_take _ _ _ _ ha, ← hL.2.2 _ hb' _ hql c hc]
    congr 1
    conv_lhs => rw [← Nat.div_add_mod b nc]
    ring

theorem LRep_join {pre nc lam post : ℕ} (hl : 0 < lam) {L : List α}
    {ψ : ℕ → ℕ → List α} (hL : LRep (pre * nc) lam post L ψ) :
    LRep pre (nc * lam) post L (fun b c => joinC nc fun q => ψ (b * nc + q) c) := by
  have hbq : ∀ b < pre, ∀ q < nc, b * nc + q < pre * nc := by
    intro b hb q hq
    have : (b + 1) * nc ≤ pre * nc := Nat.mul_le_mul_right _ hb
    rw [Nat.succ_mul] at this; omega
  have hrows : ∀ b < pre, ∀ c < post, ∀ row ∈ (List.range nc).map (fun q => ψ (b * nc + q) c),
      row.length = lam := by
    intro b hb c hc row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨q, hq, rfl⟩ := hrow
    exact hL.2.1 _ (hbq b hb q hq) c hc
  refine ⟨by rw [hL.1]; ring, fun b hb c hc => ?_, fun b hb a ha c hc => ?_⟩
  · beta_reduce
    unfold joinC
    rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform lam _ (hrows b hb c hc)]
    simp [Nat.mul_comm]
  · obtain ⟨q, r, rfl, hr⟩ : ∃ q r, a = q * lam + r ∧ r < lam :=
      ⟨a / lam, a % lam, (Nat.div_add_mod' a lam).symm, Nat.mod_lt _ hl⟩
    have hq : q < nc := by
      by_contra hcon; push Not at hcon
      have : nc * lam ≤ q * lam := Nat.mul_le_mul_right _ hcon
      omega
    beta_reduce
    unfold joinC
    rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform lam default _ (hrows b hb c hc) q
      (by simp; exact hq) r hr]
    rw [List.getD_eq_getElem _ [] (by simp; exact hq), List.getElem_map, List.getElem_range,
      ← hL.2.2 _ (hbq b hb q hq) r hr c hc]
    congr 1; ring

/-- **The chunk pass**: one `λ`-exposure applies `chunksG g λ nc` to every line. -/
theorem LRep_chunkPass {pre nc lam post : ℕ} (hl : 0 < lam) (hnc : 0 < nc) (hp : 0 < post)
    {L : List α} {φ : ℕ → ℕ → List α} (hL : LRep pre (nc * lam) post L φ)
    (g : ℕ → List α → List α) (hg : ∀ q X, X.length = lam → (g q X).length = lam) :
    LRep pre (nc * lam) post (kerPass lam post (pre * nc) (fun b => g (b % nc)) L)
      (fun b c => chunksG g lam nc (φ b c)) := by
  have h1 := LRep_kerPass hl hp (LRep_split hl hnc hL) (fun b => g (b % nc)) (fun b X h => hg _ X h)
  have h2 := LRep_join hl h1
  refine LRep_congr h2 (fun b hb c hc => ?_)
  unfold joinC chunksG
  apply List.flatMap_congr
  intro q hq
  rw [List.mem_range] at hq
  have e1 : (b * nc + q) / nc = b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hnc, Nat.div_eq_of_lt hq, zero_add]
  have e2 : (b * nc + q) % nc = q := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hq]
  simp only [e1, e2]

end passes

end J6Seg

end

section
-- Source module: Solutions.J6SegSw3
/-!
# B-line machine, sweep 3: the `B₀` axis map as seven passes

On a `(pre, N, post)` array of Gaussian items (`N = n_c λ`), the in-place `B₀` line map of the
axis (`axisL N post (lineB …)`) is computed by (`axisPipe`):

1. a selection slab pass (row `rowSel l`, scaled by `2^{P-p-1}`, zeros for `l ≥ s`);
2. the chunk kernel `chunkK` on every `λ`-chunk (one `λ`-exposure);
3. a slab gather of the `m` near-boundary rows `LJ` (padded to `G` rows);
4. the `J` kernel (`fwdK`, `bwdK`, coupling window) on every `G`-row (one `G`-exposure);
5. a slab scatter back to the `N` rows;
6. the chunk kernel again;
7. the output slab pass on the pair `(Y, Y₂)`: `outE l (Y - Y₂)`.

Real and imaginary parts are carried together (`liftG`). **`axisPipe_eq`** proves the equality.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Pairs of arrays -/

section zipS
variable {α β : Type*} [Inhabited α] [Inhabited β]

lemma getD_zip_of_lt {a : List α} {b : List β} {k : ℕ} (ha : k < a.length) (hb : k < b.length) :
    (List.zip a b).getD k default = (a.getD k default, b.getD k default) := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_zip,
    List.getD_eq_getElem _ _ ha, List.getD_eq_getElem _ _ hb]

theorem LRep_zip {pre n post : ℕ} {L₁ : List α} {L₂ : List β} {φ₁ : ℕ → ℕ → List α}
    {φ₂ : ℕ → ℕ → List β} (h₁ : LRep pre n post L₁ φ₁) (h₂ : LRep pre n post L₂ φ₂) :
    LRep pre n post (List.zip L₁ L₂) (fun b c => List.zip (φ₁ b c) (φ₂ b c)) := by
  refine ⟨by simp [h₁.1, h₂.1], fun b hb c hc => by simp [h₁.2.1 b hb c hc, h₂.2.1 b hb c hc],
    fun b hb a ha c hc => ?_⟩
  have hx := idx3_lt hb ha hc
  rw [getD_zip_of_lt (by rw [h₁.1]; exact hx) (by rw [h₂.1]; exact hx),
    getD_zip_of_lt (by rw [h₁.2.1 b hb c hc]; exact ha) (by rw [h₂.2.1 b hb c hc]; exact ha),
    h₁.2.2 b hb a ha c hc, h₂.2.2 b hb a ha c hc]

end zipS

/-! ## Gaussian lifts -/

lemma length_liftG (f : List ℤ → List ℤ) (n : ℕ) (hf : ∀ y : List ℤ, y.length = n → (f y).length = n)
    (x : List (ℤ × ℤ)) (hx : x.length = n) : (liftG f x).length = n := by
  unfold liftG
  rw [List.length_zip, hf _ (by simp [hx]), hf _ (by simp [hx]), Nat.min_self]

/-! ## The passes of the `B₀` axis map -/

section pipe
variable (p P R s t lam w α K nc G : ℕ)

variable {p P R s t lam w α K nc G}

lemma length_wOf (v : List ℤ) : (wOf P R s t lam w α K v).length = (LJ s t lam w).length := by
  simp [wOf]

lemma length_jKer (hG : (LJ s t lam w).length ≤ G) (v : List ℤ) :
    (jKer P R s t lam w α K G v).length = G := by
  simp only [jKer, List.length_append, length_wOf, List.length_replicate]; omega

/-! ## The line identity -/

/-- **The seven passes compute the in-place `B₀` axis map.** -/
theorem axisPipe_eq (hl : 1 ≤ lam) (hnc : 0 < nc) (hst : s ≤ t) (hN : nc * lam = t)
    (hG : (LJ s t lam w).length ≤ G) (hG0 : 0 < G) {pre post : ℕ} (hp : 0 < post)
    (L : List (ℤ × ℤ)) (hL : L.length = pre * (nc * lam * post)) :
    axisPipe p P R s t lam w α K nc G pre post L =
      axisL (nc * lam) post (lineB p P R s t lam w α K nc) L := by
  have hl0 : 0 < lam := by omega
  have hN0 : 0 < nc * lam := Nat.mul_pos hnc hl0
  have hck : ∀ q (X : List (ℤ × ℤ)), X.length = lam →
      (liftG (chunkK P R s t lam α q) X).length = lam :=
    fun q X hX => length_liftG _ lam (fun y hy => by rw [length_chunkK P hl, hy]) X hX
  have h0 := LRep_lineAt (n := nc * lam) hL
  have h1 := LRep_slabPass (n' := nc * lam) hN0 hp h0 (selSrc s t) (selH p P) (by
    intro l _ k hk
    unfold selSrc at hk
    split_ifs at hk with h
    cases hk
    rw [hN]; exact rowSel_lt hst h)
  have h2 := LRep_chunkPass hl0 hnc hp h1 (fun q => liftG (chunkK P R s t lam α q)) hck
  have h3 := LRep_slabPass (n' := G) hN0 hp h2 (jSrc s t lam w) (fun _ z => z) (by
    intro r _ k hk
    unfold jSrc at hk
    split_ifs at hk with h
    cases hk
    rw [hN]; exact lt_of_lt_of_le (LJ_getD_lt h) hst)
  have h4 := LRep_kerPass hG0 hp h3 (fun _ => liftG (jKer P R s t lam w α K G))
    (fun b X hX => length_liftG _ G (fun y _ => length_jKer hG y) X hX)
  have h5 := LRep_slabPass (n' := nc * lam) hG0 hp h4 (scSrc s t lam w) (fun _ z => z) (by
    intro u _ k hk
    unfold scSrc at hk
    split_ifs at hk with h
    cases hk
    exact lt_of_lt_of_le (List.idxOf_lt_length_of_mem h) hG)
  have h6 := LRep_chunkPass hl0 hnc hp h5 (fun q => liftG (chunkK P R s t lam α q)) hck
  have h7 := LRep_slabPass (n' := nc * lam) hN0 hp (LRep_zip h2 h6) (fun l => some l)
    (outH p P s t α) (by intro l hl k hk; cases hk; exact hl)
  have hA := LRep_axisL hN0 hp h0 (lineB p P R s t lam w α K nc) (fun X _ => by simp [lineB])
  exact LRep_ext h7 (LRep_congr hA (fun b _ c _ =>
    (pipeLine_eq (p := p) (R := R) (α := α) (K := K) hl hst hN hG (lineAt (nc * lam) post L b c)).symm))

end pipe

end J6Seg

end

section
-- Source module: Solutions.J6PipeDisc1
/-!
# `PipeDisc6`: the seven-pass axis maps keep the disc

* `mem_axisL`: if a line map `f` keeps lengths and a predicate `Q` (with `Q default`), the
  in-place axis map `axisL n post f` keeps `Q` on every entry;
* `b0seg_disc`: in the round-six regime one `B₀` line (`B0seg`, the `lineB` map) sends
  `DiscL p` lines to `DiscL p` lines: rows `l < s` have modulus
  `≤ 2^p ‖B‖ ‖v‖_∞ + 9 ≤ 2^{p-1} + 9 ≤ 2^p` (`FitSpec6`), rows `l ≥ s` are `0` (`B0seg_ge`);
* **`pipeDisc6_all`**: `∀ P, P.Ok → PipeDisc6 P`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

namespace J6Seg

/-- **Axis maps keep an entrywise predicate.** -/
theorem mem_axisL {α : Type*} [Inhabited α] (Q : α → Prop) (hQ0 : Q default) (n post : ℕ)
    (hn : 0 < n) (hp : 0 < post) (f : List α → List α)
    (hf : ∀ X : List α, X.length = n → (f X).length = n)
    (hfQ : ∀ X : List α, X.length = n → (∀ z ∈ X, Q z) → ∀ z ∈ f X, Q z)
    (L : List α) (pre : ℕ) (hL : L.length = pre * (n * post)) (hLQ : ∀ z ∈ L, Q z) :
    ∀ z ∈ axisL n post f L, Q z := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hlen := length_axisL n post hn hp f L pre hL
  have hnp : 0 < n * post := Nat.mul_pos hn hp
  have hi2 : i < pre * (n * post) := by omega
  have e1 := Nat.div_add_mod i (n * post)
  have e2 := Nat.div_add_mod (i % (n * post)) post
  have hb : i / (n * post) < pre := (Nat.div_lt_iff_lt_mul hnp).2 hi2
  have hr : i % (n * post) < n * post := Nat.mod_lt _ hnp
  have ha : i % (n * post) / post < n := (Nat.div_lt_iff_lt_mul hp).2 hr
  have hc : i % (n * post) % post < post := Nat.mod_lt _ hp
  have hidx : i / (n * post) * (n * post) + i % (n * post) / post * post + i % (n * post) % post = i := by
    have e1' : n * post * (i / (n * post)) = i / (n * post) * (n * post) := mul_comm _ _
    have e2' : post * (i % (n * post) / post) = i % (n * post) / post * post := mul_comm _ _
    omega
  have e := axisL_getD n post hn hp f hf L pre hL hb ha hc
  rw [hidx, List.getD_eq_getElem _ _ hi] at e
  rw [e]
  have hX : (lineAt n post L (i / (n * post)) (i % (n * post) % post)).length = n := by
    simp [lineAt]
  rw [List.getD_eq_getElem _ _ (by rw [hf _ hX]; exact ha)]
  refine hfQ _ hX ?_ _ (List.getElem_mem _)
  intro y hy
  unfold lineAt at hy
  simp only [List.mem_map] at hy
  obtain ⟨k, _, rfl⟩ := hy
  by_cases hm : (i / (n * post) * (n * post) + k * post + i % (n * post) % post) < L.length
  · rw [List.getD_eq_getElem _ _ hm]; exact hLQ _ (List.getElem_mem _)
  · rw [List.getD_eq_default _ _ (by omega)]; exact hQ0

end J6Seg

end

