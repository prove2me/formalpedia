variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (b B : ℕ) (hb : 1 ≤ b) (zs : List NLogN.KFB.GI) (hre : ∀ z ∈ zs, 0 ≤ z.1)
    (hB : NLogN.KFB.GB B zs) {W : Fin NLogN.HS} (hW0 : W ≠ 0) (s : NLogN.IState NLogN.HS) (R0 LW : List NLogN.Item) (m : ℕ)
    (hv : NLogN.KFT.carOut b zs < 2 ^ m) (h0 : s.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0)
    (hW : s.G W = .int (2 ^ m) :: LW) :
    NLogN.IRuns I iprog (NLogN.KFT.carW b zs.length W) s
      { (s.upd 0 R0).upd W LW with out := s.out ++ IntMul.bin m (NLogN.KFT.carOut b zs) }
      (NLogN.KFT.cCar b B zs.length + NLogN.outRCost m) := by
  have h1 := NLogN.KFT.carI_spec (I := I) (iprog := iprog) b B hb zs hre hB s R0 h0
  have h2 := NLogN.KFT.writeI_spec (I := I) (iprog := iprog) (A := 0) (W := W) hW0.symm
    (s.upd 0 (.int (NLogN.KFT.carOut b zs : ℤ) :: R0)) (NLogN.KFT.carOut b zs) m hv R0 LW (by simp)
    (by simp [hW0, hW])
  refine (h1.seq h2).mono' ?_ le_rfl
  simp
