def record (k : Fin 140) : Certificate := records[k.val]!
def first (i : Fin 30) : ℤ := firstCoordinates[i.val]!
def second (i : Fin 30) : ℤ := secondCoordinates[i.val]!
def degree (c : Certificate) (i : Fin 30) : ℤ := c.degrees[i.val]!

/-- Arguments are target row, source column: the source loses one Maslov degree. -/
def Allowed (c : Certificate) (i j : Fin 30) : Prop :=
  first i < first j ∧ second i ≤ second j ∧ degree c i = degree c j - 1

def MixedAllowed (c : Certificate) (i j : Fin 30) : Prop :=
  Allowed c i j ∧ second i < second j

instance (c : Certificate) (i j : Fin 30) : Decidable (Allowed c i j) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))
instance (c : Certificate) (i j : Fin 30) : Decidable (MixedAllowed c i j) :=
  inferInstanceAs (Decidable (_ ∧ _))

def totalBudget (c : Certificate) : ℕ :=
  c.totalRows.toFinset.card + c.totalCols.toFinset.card
def mixedBudget (c : Certificate) : ℕ :=
  c.mixedRows.toFinset.card + c.mixedCols.toFinset.card

/-- Finite computational assertion only; matrix rank conclusions are separate. -/
def Valid (c : Certificate) : Prop :=
  c.degrees.size = 30 ∧
  (∀ i j : Fin 30, Allowed c i j → i ∈ c.totalRows ∨ j ∈ c.totalCols) ∧
  (∀ i j : Fin 30, MixedAllowed c i j → i ∈ c.mixedRows ∨ j ∈ c.mixedCols) ∧
  min (totalBudget c) (4 + mixedBudget c) ≤ 13 ∧
  min (totalBudget c) (2 + mixedBudget c) ≤ 11

instance (c : Certificate) : Decidable (Valid c) :=
  by
    have d0 : Decidable (c.degrees.size = 30) := inferInstance
    have d1 : Decidable (∀ i j : Fin 30, Allowed c i j → i ∈ c.totalRows ∨ j ∈ c.totalCols) := inferInstance
    have d2 : Decidable (∀ i j : Fin 30, MixedAllowed c i j → i ∈ c.mixedRows ∨ j ∈ c.mixedCols) := inferInstance
    have d3 : Decidable (min (totalBudget c) (4 + mixedBudget c) ≤ 13) := inferInstance
    have d4 : Decidable (min (totalBudget c) (2 + mixedBudget c) ≤ 11) := inferInstance
    unfold Valid
    exact @instDecidableAnd _ _ d0 (@instDecidableAnd _ _ d1 (@instDecidableAnd _ _ d2 (@instDecidableAnd _ _ d3 d4)))

end SP4Table22


