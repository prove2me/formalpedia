      rw [hΨπ k, hΨπ n, hΨresT k ℓ hℓ hℓk hℓmin hℓS, hΨresT n ℓ hℓ hℓn hℓmin hℓS]

    have haex : ∀ k, k < n → ¬ qf k ∣ Nf (k + 1) → ∃ (ak : 𝒪') (ρ' : GaloisRepAdic 𝒪'),
