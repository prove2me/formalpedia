-- title:
--   Proof of Lemma 2.1, p. 4 — 𝒩_{C₁}(x₀, y₀) = (Ker[A, B])^⊥ = {[Aᵀ; Bᵀ]λ : λ ∈ ℝ^q}
-- statement:
--   Let $A\in\mathbb R^{q\times m}$, $B\in\mathbb R^{q\times n}$, $b\in\mathbb R^q$ and $C_1=\{(x,y)\in\mathbb R^m\times\mathbb R^n: Ax+By=b\}$. For every $(x_0,y_0)\in C_1$,
--   $$\mathcal N_{C_1}(x_0,y_0)=\big(\operatorname{Ker}[A,B]\big)^\perp=\operatorname{Im}[A^\top;B^\top]=\big\{(A^\top\lambda,\ B^\top\lambda):\ \lambda\in\mathbb R^q\big\}.$$
--
--   This identifies the multiplier term $\{[A^\top;B^\top]\lambda\}$ of formula (2.4): normals to the affine constraint set are exactly the vectors generated by the transposed constraint matrix.
--
--   **Formalization Note** The statement records the final set; the intermediate tangent-cone and kernel expressions on the page are not separate conjuncts. $A^\top\lambda$ is `Matrix.toEuclideanLin P.A.transpose lam`.
-- source:
--   Guigues, Convergence Analysis of Sampling-Based Decomposition Methods for Risk-Averse Multistage Stochastic Convex Programs, arXiv:1408.4439v4, p. 4, proof of Lemma 2.1

import Mathlib
import Definitions.Def_RiskAverseSDDP_Subdiff_Model
import Definitions.Def_FirstOrderOpt_ConvexTheory_normalCone

open scoped RealInnerProductSpace

namespace RiskAverseSDDP.Subdiff

open ConvexProgram

/-- Proof of Lemma 2.1, p. 4: at a point `z₀ ∈ C₁ = {(x, y) : Ax + By = b}`,
`𝒩_{C₁}(z₀) = (Ker [A, B])^⊥ = Im [Aᵀ; Bᵀ] = {(Aᵀλ, Bᵀλ) : λ ∈ ℝ^q}`. -/
theorem normalCone_C1 {m n q p : ℕ} (P : ConvexProgram m n q p)
    (z₀ : E m × E n) (hz₀ : z₀ ∈ P.C1) :
    normalConeProd P.C1 z₀ =
      {v | ∃ lam : E q,
        v = (Matrix.toEuclideanLin P.A.transpose lam, Matrix.toEuclideanLin P.B.transpose lam)} := by sorry

end RiskAverseSDDP.Subdiff
