-- Source module: Solutions.J6SegStage
/-!
# Segmented inverse (S2): accuracy of the global stages

With `K = (λ+1)E + 1` (`λ` ≥ every block length, `E` the table accuracy in ulps) and `Dm` ≥ every
`D_u = e^{πα²θu²}` used:
* `applyMinv_err`: `|applyMinv V / 2^P - M⁻¹ (V/2^P)| ≤ 9 Dm K (B+1)/2^P` (`|V/2^P| ≤ B`);
* `coupleI_err`: `|coupleI z / 2^P - Δ (z/2^P)| ≤ (2w+1)(1/2 + E Z)/2^P` (`|z/2^P| ≤ Z` on `J`);
* `capI_row`, `capI_apply`: the computed capacitance `C = I + (M⁻¹Δ)|_J` has row deviation
  `≤ 1/7 + λ(2w+1)δ` and `|C z - (z + M⁻¹ Δ z)| ≤ λ(2w+1) δ Z` with `δ = 15 Dm K / 2^P`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section stage
variable {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}

lemma Dm_one (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hT : TabOK P s t α B T E Dm)
    {a : ℕ} (ha : a < s) : 1 ≤ Dm := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have p2 : 1 ≤ (t : ℝ) / s := by rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst
  exact le_trans (one_le_ddR p2 0) (hT.dm a ha 0 (by have := hB.cover a ha; omega))

lemma capI_div (a k : ℕ) :
    (capI P T B a k : ℝ) / 2 ^ P = kd a k + ∑ i ∈ blS B a, ∑ h ∈ Hset B i,
      if col B.s i h = k then (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P else 0 := by
  have hS := two_pow_pos' P
  unfold capI blS kd
  push_cast
  rw [add_div, sum_div]
  congr 1
  · split_ifs <;> simp [hS.ne']
  · refine sum_congr rfl fun i _ => ?_
    rw [sum_div]; refine sum_congr rfl fun h _ => ?_
    split_ifs <;> simp

/-- The computed capacitance applied to `z`. -/
theorem cap_expand (hB : BlocksOK s t B) (hs : 0 < s) {a : ℕ} (ha : a ∈ (Jlist B).toFinset)
    (ha' : a < s) (zr : ℕ → ℝ) :
    ∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * zr k =
      zr a + ∑ i ∈ blS B a, ∑ h ∈ Hset B i,
        (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr (col B.s i h) := by
  simp only [capI_div, add_mul, sum_add_distrib, sum_mul]
  congr 1
  · simp only [kd, ite_mul, one_mul, zero_mul]; rw [sum_ite_eq]; simp [ha]
  · rw [sum_comm]; refine sum_congr rfl fun i hi => ?_
    rw [sum_comm]; refine sum_congr rfl fun h hh => ?_
    simp only [ite_mul, zero_mul]
    rw [sum_ite_eq]
    simp [col_mem hB hs (blS_lt hB ha' hi) hh]

/-- The computed capacitance acts as `z ↦ z + (M⁻¹ Δ z)|_J` up to `λ(2w+1) δ Z`. -/
theorem cap_apply_sol_aux (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha : a ∈ (Jlist B).toFinset) (ha' : a < s) (zr : ℕ → ℝ) {Z : ℝ} (hZ0 : 0 ≤ Z)
    (hz : ∀ k ∈ (Jlist B).toFinset, |zr k| ≤ Z) :
    |∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * zr k -
      (zr a + Mv (blS B) (MiG s t α B) (Dv (Hset B) (col B.s) (cfG s t α) zr) a)| ≤
      lam * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) * Z := by
  set δ := 15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P
  have hδ0 : 0 ≤ δ := by
    have := two_pow_pos' P
    have := Dm_one hB hs hst hT ha'
    positivity
  rw [cap_expand hB hs ha ha']
  have e : Mv (blS B) (MiG s t α B) (Dv (Hset B) (col B.s) (cfG s t α) zr) a =
      ∑ i ∈ blS B a, ∑ h ∈ Hset B i, MiG s t α B a i * eEx s t α i h * zr (col B.s i h) := by
    unfold Mv Dv cfG; refine sum_congr rfl fun i _ => ?_
    rw [mul_sum]; exact sum_congr rfl fun h _ => by ring
  rw [e, add_sub_add_left_eq_sub, ← sum_sub_distrib]
  have hb : ∀ i ∈ blS B a, |∑ h ∈ Hset B i, (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P *
      zr (col B.s i h) - ∑ h ∈ Hset B i, MiG s t α B a i * eEx s t α i h * zr (col B.s i h)| ≤
      (2 * B.w + 1) * (δ * Z) := by
    intro i hi
    rw [← sum_sub_distrib]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    have hδ : ∀ h ∈ Hset B i, |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P *
        zr (col B.s i h) - MiG s t α B a i * eEx s t α i h * zr (col B.s i h)| ≤ δ * Z := by
      intro h hh
      rw [← sub_mul, abs_mul]
      exact mul_le_mul (cap_term hB hs hst hα hx hT hE hlam hP ha' hi hh)
        (hz _ (col_mem hB hs (blS_lt hB ha' hi) hh)) (abs_nonneg _)
        ((abs_nonneg _).trans (cap_term hB hs hst hα hx hT hE hlam hP ha' hi hh))
    refine (sum_le_sum hδ).trans ?_
    rw [sum_const, nsmul_eq_mul]
    have hc : ((Hset B i).card : ℝ) ≤ 2 * B.w + 1 := by exact_mod_cast Hset_card i
    exact mul_le_mul_of_nonneg_right hc (mul_nonneg hδ0 hZ0)
  refine (abs_sum_le_sum_abs _ _).trans ((sum_le_sum hb).trans ?_)
  rw [sum_const, nsmul_eq_mul]
  have hcard : ((blS B a).card : ℝ) ≤ lam := by
    unfold blS; rw [Nat.card_Ico]; exact_mod_cast (by have := hlam a ha'; omega)
  have := mul_le_mul_of_nonneg_right hcard
    (by positivity : (0 : ℝ) ≤ (2 * B.w + 1) * (δ * Z))
  refine this.trans (le_of_eq ?_)
  ring

end stage

end J6Seg

end

theorem solution : type_of% @J6Seg.cap_apply_sol_aux := @J6Seg.cap_apply_sol_aux
