theorem translate_comp_translate {k : Type} [Field k] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of k)}
    (L : RelativeGroupLaw k f) (x y : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    L.translate y ≫ L.translate x = L.translate (L.mul (𝟙 _) y x) := by

  let pt : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f → SchemeHomOver f f := fun z =>
    ⟨f ≫ z.1, by rw [Category.assoc, z.2, Category.comp_id]⟩
  have hT : ∀ z, L.translate z = (L.mul f RelativeGroupLaw.idPoint (pt z)).1 := fun z => rfl
  have hψ : L.translate y ≫ f = f := L.translate_over y
  have h1 := L.mul_natural f f (L.translate y) hψ RelativeGroupLaw.idPoint (pt x)
  have hid : schemeHomOverComp (L.translate y) hψ RelativeGroupLaw.idPoint =
      L.mul f RelativeGroupLaw.idPoint (pt y) := by
    apply Subtype.ext
    rw [schemeHomOverComp_coe]
    show L.translate y ≫ 𝟙 A = _
    rw [Category.comp_id]; rfl
  have hx : schemeHomOverComp (L.translate y) hψ (pt x) = pt x := by
    apply Subtype.ext
    rw [schemeHomOverComp_coe]
    show L.translate y ≫ (f ≫ x.1) = f ≫ x.1
    rw [← Category.assoc, hψ]
  rw [hid, hx, L.mul_assoc] at h1
  have h2 := L.mul_natural (𝟙 _) f f (Category.comp_id f) y x
  have hy' : schemeHomOverComp f (Category.comp_id f) y = pt y := Subtype.ext rfl
  have hx' : schemeHomOverComp f (Category.comp_id f) x = pt x := Subtype.ext rfl
  rw [hy', hx'] at h2
  have h3 : pt (L.mul (𝟙 _) y x) = L.mul f (pt y) (pt x) := by
    rw [← h2]; exact Subtype.ext rfl
  rw [hT y, hT x, hT (L.mul _ y x), h3, ← h1, schemeHomOverComp_coe]
  rfl

end P2mCF1h

theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f) (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛) (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) :
    InPicZero f L ((Scheme.Modules.pullback (L.translate x)).obj 𝓛 ⊗ Scheme.Modules.dual 𝓛) := by
  classical
  have hD := Scheme.Modules.IsInvertible.dual_monoidalV2 h𝓛
  refine ⟨Scheme.Modules.IsInvertible.tensor_monoidalV2 (h𝓛.pullback _) hD.1, fun y => ?_⟩

  let Tx := L.translate x
  let Ty := L.translate y
  let X : A.Modules := (Scheme.Modules.pullback Tx).obj 𝓛
  let Q : A.Modules := (Scheme.Modules.pullback Ty).obj 𝓛
  let P : A.Modules := (Scheme.Modules.pullback (L.translate (L.mul (𝟙 _) x y))).obj 𝓛
  have hQ : Scheme.Modules.IsInvertible Q := h𝓛.pullback _
  obtain ⟨U⟩ := hD.2
  obtain ⟨V⟩ := (Scheme.Modules.IsInvertible.dual_monoidalV2 hQ).2
  obtain ⟨D⟩ := Scheme.Modules.IsInvertible.pullback_dual_monoidalV2 Ty h𝓛
  obtain ⟨S⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_translate_mul_tensor_iso k f L hc hA 𝓛 h𝓛 x y

  have hcomp : Ty ≫ Tx = L.translate (L.mul (𝟙 _) x y) := by
    rw [P2mCF1h.translate_comp_translate, hc.mul_comm]
  let C : (Scheme.Modules.pullback Ty).obj X ≅ P :=
    (Scheme.Modules.pullbackComp Ty Tx).app 𝓛 ≪≫ (Scheme.Modules.pullbackCongr hcomp).app 𝓛
  refine ⟨Scheme.Modules.pullbackTensorObjIso Ty X (Scheme.Modules.dual 𝓛) ≪≫ (C ⊗ᵢ D) ≪≫ ?_⟩

  exact ((ρ_ P).symm ⊗ᵢ Iso.refl _) ≪≫ ((Iso.refl P ⊗ᵢ U.symm) ⊗ᵢ Iso.refl _) ≪≫
    ((α_ P 𝓛 (Scheme.Modules.dual 𝓛)).symm ⊗ᵢ Iso.refl _) ≪≫ ((S ⊗ᵢ Iso.refl _) ⊗ᵢ Iso.refl _) ≪≫
    ((α_ X Q (Scheme.Modules.dual 𝓛)) ⊗ᵢ Iso.refl _) ≪≫ ((Iso.refl X ⊗ᵢ β_ Q (Scheme.Modules.dual 𝓛)) ⊗ᵢ Iso.refl _) ≪≫
    ((α_ X (Scheme.Modules.dual 𝓛) Q).symm ⊗ᵢ Iso.refl _) ≪≫ (α_ (X ⊗ Scheme.Modules.dual 𝓛) Q (Scheme.Modules.dual Q)) ≪≫
    (Iso.refl _ ⊗ᵢ V) ≪≫ (ρ_ (X ⊗ Scheme.Modules.dual 𝓛))

end S_AlgebraicGeometry_Polarisation_inPicZero_pullback_translate_tensor_dual
