-- title:
--   Proposition 3.20
-- statement:
--   For a quasipoint $\mathfrak B$ in the closed-subspace lattice of a complex Hilbert space, containing a finite-dimensional subspace is equivalent to being generated by a unique line $V$:
--
--   $$\mathfrak B=\{U:V\subseteq U\},\qquad\dim V=1.$$
--
--   Containing no finite-dimensional subspace is equivalent to containing every subspace of finite codimension. Lines are intrinsic subspaces, independent of a choice of nonzero vector.
-- source:
--   Observables I: Stone Spectra, arXiv:math-ph/0509020v1, PDF p. 65, Proposition 3.20

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P20

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakethird100.P20

open Set TopologicalSpace

open QAlgorithms.Papers.Independent.Next46.P33 (Projection)

open scoped Topology

universe u v

/-- Proposition 3.20; de Groote, Observables I, PDF p./pp. 65.
-/
theorem hilbert_quasipoint_finite_dimension_dichotomy {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (B : StoneSpectrum (ClosedSubmodule ℂ H)) :
    ((∃ U : ClosedSubmodule ℂ H, U ∈ B.val ∧ FiniteDimensional ℂ U.toSubmodule) ↔
      ∃! V : ClosedSubmodule ℂ H, Module.rank ℂ V = 1 ∧ B.val = principalQuasipoint V) ∧
    ((¬ ∃ U : ClosedSubmodule ℂ H, U ∈ B.val ∧ FiniteDimensional ℂ U.toSubmodule) ↔
      ∀ W : ClosedSubmodule ℂ H, FiniteDimensional ℂ W.orthogonal.toSubmodule → W ∈ B.val) := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P20

end
