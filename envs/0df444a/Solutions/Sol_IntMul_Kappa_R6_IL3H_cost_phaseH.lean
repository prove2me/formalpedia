/-- **A phase step** (body and wrapper). -/
theorem cost_phaseH_sol_aux {W m Bn t S0 r Z H x : ℕ} (hW : 1 ≤ W) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (v : ℤ)
    (hv : zsz v ≤ Z) (εE : Ex HS) (hsz : εE.size ≤ 12 * m + 27) (hx : x + 2 * W ≤ H) :
    cWrapQ W (nN Bn t S0 * r) Z 0 0 (cPhStep Z v εE Bn t S0 r) x ≤
      MphH W m * ((W * nN Bn t S0) * Yu r Z H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := 0) (dw := 0) (x := x) hW hn
    (cPhStep Z v εE Bn t S0 r) (by omega)
  have h2 := cPhU_Y (r := r) (Z := Z) (H := H) (x := x) (t := t) hS hBn (by omega) εE hsz
  have h3 := yu_z2 r Z H
  have h4 : moveCost (zsz v) ≤ 50 * Yu r Z H := (moveCost_mono hv).trans (moveCost_Y Z r H)
  have h5 := yu_z1 r Z H
  unfold cPhStep cpU at h1 ⊢
  unfold MphH
  set n := nN Bn t S0
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have hnYP : n * Y ≤ P := by rw [hP]; exact Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_left _ hW)
  have e2 : 1000000000 * (12 * m + 27 + 2) * n * Y = 1000000000 * (12 * m + 29) * (n * Y) := by
    ring
  rw [e2] at h2
  have k2 : 1000000000 * (12 * m + 29) * (n * Y) ≤ 1000000000 * (12 * m + 29) * P :=
    Nat.mul_le_mul_left _ hnYP
  have k3 : 7 * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost (zsz v) + 19) + 1 + (1 * (2 * Z + 2) + 1) ≤
      10 ^ 9 * P := by
    have : 7 * 10 ^ 7 * (Z + 2) ^ 2 ≤ 7 * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h3
    omega
  have k4 : 10 ^ 12 * (W + 2) * P + 1000000000 * (12 * m + 29) * P + 10 ^ 9 * P ≤
      10 ^ 12 * (12 * m + 30) * (W + 3) * P := by
    have e : 10 ^ 12 * (12 * m + 30) * (W + 3) * P = 10 ^ 12 * (12 * m + 30) * (W * P) +
        3 * 10 ^ 12 * (12 * m + 30) * P := by ring
    have e' : 10 ^ 12 * (W + 2) * P = 10 ^ 12 * (W * P) + 2 * 10 ^ 12 * P := by ring
    have hm : 1 ≤ 12 * m + 30 := by omega
    have a : 10 ^ 12 * (W * P) ≤ 10 ^ 12 * (12 * m + 30) * (W * P) := by
      have := Nat.mul_le_mul_left (10 ^ 12) (Nat.le_mul_of_pos_left (W * P) hm)
      calc 10 ^ 12 * (W * P) ≤ 10 ^ 12 * ((12 * m + 30) * (W * P)) := this
        _ = 10 ^ 12 * (12 * m + 30) * (W * P) := by ring
    have b : 2 * 10 ^ 12 * P + 1000000000 * (12 * m + 29) * P + 10 ^ 9 * P ≤
        3 * 10 ^ 12 * (12 * m + 30) * P := by
      have e3 : 3 * 10 ^ 12 * (12 * m + 30) * P = 36 * 10 ^ 12 * (m * P) + 90 * 10 ^ 12 * P := by
        ring
      have e4 : 1000000000 * (12 * m + 29) * P = 12 * 10 ^ 9 * (m * P) + 29 * 10 ^ 9 * P := by
        ring
      omega
    omega
  omega

