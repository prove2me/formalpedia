    hℓS (Finset.mem_coe.mpr (hNS _ hℓ h))
  have hSL : ∀ {ℓ : ℕ}, ℓ.Prime → ℓ ∉ (↑S : Set ℕ) → ¬ ℓ ∣ L₁ * q := fun hℓ hℓS h =>
