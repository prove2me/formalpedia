theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ)
    (r : ℕ) (L : ℕ) (a a' : Fin (Φ.natDegree * r) → O)
    (ha : a ∈ TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r))
    (ha' : a' ∈ TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r)) :
    (∀ j, a j - a' j ∈ (IsLocalRing.maximalIdeal O) ^ L) ↔
