-- title:
--   Rational-degree component relations yield an integer-degree initial ideal
-- statement:
--   Given coordinate-power relations generated by components of a common positive rational weighted degree `q`, with `q ≤ B < sR`, clear the denominator of `q` to obtain a positive integer degree `D`. Raising the relations to that denominator multiplies the component degree and the ordinary ideal-power exponent by the same factor. Products preserve the weighted support bound and give the required integer-degree component relations. The strict slope inequality is preserved by multiplication; in dimension zero the coordinate condition is vacuous.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.rational_degree_initial_components_to_integer_degree
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (R : Real) (s B : Nat) (q : Rat)
    (hs : 0 < s) (hB : (B : Real) < (s : Real) * R)
    (hq : 0 < q) (hqB : (q : Real) ≤ (B : Real))
    (hcoords : ∀ i : Fin d, ∃ n : Nat, 0 < n ∧
      MvPolynomial.X i ^ n ∈ Ideal.span (Set.range (fun (p :
        {g : MvPolynomial (Fin d) Complex //
          g ∈ I ^ s ∧
          ∀ a ∈ g.support,
            ∑ j, (w j : Real) * (a j : Real) ≤ (q : Real)}) =>
        MvPolynomial.weightedHomogeneousComponent
          (fun j => (w j : ℚ)) q p.1))) :
    ∃ s' : Nat, 0 < s' ∧ ∃ D : Nat,
      (D : Real) < (s' : Real) * R ∧ 0 < D ∧
      ∀ i : Fin d, ∃ n : Nat, 0 < n ∧
        MvPolynomial.X i ^ n ∈ Ideal.span {h : MvPolynomial (Fin d) Complex |
          ∃ g : MvPolynomial (Fin d) Complex,
            g ∈ I ^ s' ∧
            (∀ a ∈ g.support,
              ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real)) ∧
            h = MvPolynomial.weightedHomogeneousComponent
              (fun k => (w k : ℚ)) (D : ℚ) g} := by sorry
