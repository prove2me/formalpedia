theorem Formalism.FourierDecayAlt.P.Cx2.cj_apply (S : HidaSetting E Wp Wq) (c : J.CV E) (v : Fin S.f) :
    (S.σ v = (S.pl v).embedding → cj S c (S.pl v) = c (S.pl v)) ∧
      (S.σ v ≠ (S.pl v).embedding → cj S c (S.pl v) = conj (c (S.pl v))) := by sorry
