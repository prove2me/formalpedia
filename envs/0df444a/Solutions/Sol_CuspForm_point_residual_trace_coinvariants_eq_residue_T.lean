      stable_eq_bot_or_top_of_equiv ρbar ψ' ρ (P.decompositionSubgroup ℚ) e (hirr₃)
    have h0 := (ResidualGaloisRep.iSup_range_sub_one_eq_top_and_trace_quotient_eq_zero_of_forall_stable
