  have hnest := hD.1
  have hdom := hD.2.1
  have hininf := hD.2.2.1
  have hdiam0 := hD.2.2.2.2.1
  have hdiaminf := hD.2.2.2.2.2.1

  suffices h0 : (TateModule.rep p (ModularCurve.JOne M) ModularCurve.HeckeAlgOne (ModularCurve.diamondGen u)
        (TateModule.rep p (ModularCurve.JOne M) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ (TateModule.rep p (ModularCurve.JOne M) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ y - y))
      - (TateModule.rep p (ModularCurve.JOne M) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ y - y)) = 0 from sub_eq_zero.mp h0

  have hyA : ∀ n, (y : ℕ → ModularCurve.JOne M) n ∈ ModularCurve.normFreePartAt M q := by
    intro n
    refine ⟨(x : ℕ → ModularCurve.JOne M) n, ?_⟩
