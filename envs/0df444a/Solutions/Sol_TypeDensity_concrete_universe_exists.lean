  TypeDensity.concrete_universe_of_cell_measure
    (fun m c D _ ↦ @TypeDensity.member_cell_box_measurable m c D.mc (fun j ↦ (D.child j).algO)
      (fun j ↦ inferInstanceAs (Algebra m.O (D.mc j).R))
      (fun j ↦ inferInstanceAs (IsScalarTower m.O (D.mc j).O (D.mc j).R)) (fun j ↦ (D.child j).pc)
      (fun j ↦ (D.child j).pc_cont.2.2.1) (fun j ↦ (D.child j).pc_cont.2.2.2)
      (fun j ↦ (D.child j).hcard) (TypeDensity.cellChild_algebraMap_pi m c D) (TypeDensity.cellChild_degree_sum m c D)
      D.alpha (fun j ↦ (D.mc j).S.t) (fun _ ↦ rfl) (TypeDensity.cellChild_pi_pow_eq m c D)
      (TypeDensity.cell_child_bijOn m c D) (TypeDensity.cellChild_strict_generator m c D) (TypeDensity.cellChild_index_map m c D)
      (TypeDensity.cellChild_firstContact_sum m c D))
    (fun m c D _ ↦ @TypeDensity.member_cell_box_measure m c D.mc (fun j ↦ (D.child j).algO)
      (fun j ↦ inferInstanceAs (Algebra m.O (D.mc j).R))
      (fun j ↦ inferInstanceAs (IsScalarTower m.O (D.mc j).O (D.mc j).R)) (fun j ↦ (D.child j).pc)
      (fun j ↦ (D.child j).pc_cont.2.2.1) (fun j ↦ (D.child j).pc_cont.2.2.2)
      (fun j ↦ (D.child j).hcard) (TypeDensity.cellChild_algebraMap_pi m c D) (TypeDensity.cellChild_degree_sum m c D)
      D.alpha (fun j ↦ (D.mc j).S.t) (fun _ ↦ rfl) (TypeDensity.cellChild_pi_pow_eq m c D)
      (TypeDensity.cell_child_bijOn m c D) (TypeDensity.cellChild_strict_generator m c D) (TypeDensity.cellChild_index_map m c D)
