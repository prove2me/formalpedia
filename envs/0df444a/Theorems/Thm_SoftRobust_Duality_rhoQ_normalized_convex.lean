-- title:
--   Proof of Theorem 2.1: $\rho^Q$ is a convex risk measure generated by the convex, normalized penalty $\alpha^Q$
-- statement:
--   Let $\mathbf Q = \{\mathcal Q(\varepsilon) : \varepsilon\ge0\}$ be a nondecreasing, convex family of probability measures on $(\Omega,\mathcal F)$ with $\mathcal Q(0)$ nonempty, and let $\alpha^Q(\mathbb Q) = \inf\{\varepsilon\ge0 : \mathbb Q\in\mathcal Q(\varepsilon)\}$. Then:
--
--   1. $\rho^Q$, defined by $\rho^Q(Y) = \sup_{\mathbb Q\in\mathcal P}\{-\mathbb E_{\mathbb Q}[Y] - \alpha^Q(\mathbb Q)\}$, is a convex risk measure on bounded measurable payoffs (Definitions 2.1 and 2.2);
--   2. $\rho^Q$ is generated by $\alpha^Q$, and $\alpha^Q$ is convex in the sense of mixtures:
--   $$
--   \alpha^Q\big(t\mathbb Q_1 + (1-t)\mathbb Q_2\big) \le t\,\alpha^Q(\mathbb Q_1) + (1-t)\,\alpha^Q(\mathbb Q_2), \qquad t\in[0,1];
--   $$
--   3. $\alpha^Q$ is normalized: $\alpha^Q(\mathbb Q) = 0$ for some $\mathbb Q\in\mathcal P$.
--
--   This is the part of Theorem 2.1 that identifies $\rho^Q$ as "the normalized, convex risk measure generated by the penalty function $\alpha^Q$".
--
--   **Formalization Note** $\alpha^Q$ takes values in $[0,\infty]$, so nonnegativity is automatic. "Generated by" includes the least-upper-bound property of the supremum for every bounded measurable $Y$.
-- source:
--   Ben-Tal, Bertsimas, Brown, A Soft Robust Model for Optimization Under Ambiguity, Oper. Res. 58(4) (2010), p. 1224, §2.3, proof of Theorem 2.1 (convexity of α^Q and ρ^Q, normalization)

import Mathlib
import Definitions.Def_SoftRobust_Duality_Mixture
import Definitions.Def_SoftRobust_Duality_ConvexRiskMeasure
import Definitions.Def_SoftRobust_Duality_Model

open MeasureTheory
open scoped NNReal ENNReal

namespace SoftRobust.Duality

/-- §2.3, proof of Theorem 2.1, p. 1224: for a nondecreasing, convex family `𝐐` with `𝒬(0)`
nonempty, `ρ^Q` is a convex risk measure generated by the convex penalty `α^Q`, and `α^Q` is
normalized. -/
theorem rhoQ_normalized_convex {Ω : Type*} [MeasurableSpace Ω]
    (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) (h𝒬 : IsAdmissibleFamily 𝒬) :
    IsConvexRiskMeasure (rhoQ 𝒬) ∧ IsGeneratedBy (rhoQ 𝒬) (penaltyOfFamily 𝒬) ∧
      IsNormalizedPenalty (penaltyOfFamily 𝒬) := by sorry

end SoftRobust.Duality
