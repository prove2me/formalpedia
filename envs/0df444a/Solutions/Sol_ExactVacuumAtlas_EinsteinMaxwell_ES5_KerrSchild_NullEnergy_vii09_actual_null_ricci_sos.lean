theorem solution (hP : PaperData I f m N w p a) {x : Pt 5}
    (hx : x ∈ esDomain I) (hf : 0 < f (x 1)) (hm : 0 < m (x 1)) (hN : 0 < N (x 1))
    (ha2 : 0 < alphaSq f m N w p a (x 1))
