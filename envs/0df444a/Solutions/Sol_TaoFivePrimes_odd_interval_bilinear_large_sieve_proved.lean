  have hnfac : 0 ≤ nfac := by
    dsimp [nfac]
    have hinv : 0 < 1 / delta := by positivity
    linarith
  have hmfac : 0 ≤ mfac := by
    dsimp [mfac]
    positivity
  have hamass : 0 ≤ amass := by
    dsimp [amass]
    positivity
  have hbmass : 0 ≤ bmass := by
    dsimp [bmass]
    positivity
  have hbilinear :
      (∑ p ∈ J.product I,
          A p.2 * B p.1 * expCircle (alpha * (p.2 * p.1))) =
        ∑ m ∈ J, B m * inner m := by
    calc
      (∑ p ∈ J.product I,
          A p.2 * B p.1 * expCircle (alpha * (p.2 * p.1))) =
          ∑ m ∈ J, ∑ n ∈ I,
            A n * B m * expCircle (alpha * (n * m)) := by
        exact Finset.sum_product J I _
      _ = ∑ m ∈ J, B m * inner m := by
        apply Finset.sum_congr rfl
        intro m hm
        dsimp [inner]
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro n hn
        ring
  have hmaps : ∀ m ∈ J, block m ∈ blocks := by
    intro m hm
    exact Finset.mem_image_of_mem block hm
  have hsplit :
      ∑ b ∈ blocks, ∑ m ∈ J.filter (fun m => block m = b), ‖inner m‖ ^ 2 =
        ∑ m ∈ J, ‖inner m‖ ^ 2 :=
    Finset.sum_fiberwise_of_maps_to hmaps (fun m => ‖inner m‖ ^ 2)
  have hper : ∀ b ∈ blocks,
      ∑ m ∈ J.filter (fun m => block m = b), ‖inner m‖ ^ 2 ≤
        nfac * amass := by
    intro b hb
    have h := odd_block_inner_mass_le_of_selberg hLS
      alpha delta M n0 n1 m0 I J A b hdelta hM hIodd hJodd hIrange
      (fun m hm => (hJrange m hm).1) hspacing
    simpa [block, inner, nfac, amass] using h
  have hcard : (blocks.card : ℝ) ≤ mfac := by
    have h := card_image_oddLSBlockIndex_le hMpos (by linarith : m0 ≤ m1) hJrange
    simpa [blocks, block, mfac] using h
  have hinnerMass : ∑ m ∈ J, ‖inner m‖ ^ 2 ≤ mfac * (nfac * amass) := by
    calc
      (∑ m ∈ J, ‖inner m‖ ^ 2) =
          ∑ b ∈ blocks, ∑ m ∈ J.filter (fun m => block m = b),
            ‖inner m‖ ^ 2 := hsplit.symm
      _ ≤ ∑ _b ∈ blocks, nfac * amass := Finset.sum_le_sum hper
      _ = (blocks.card : ℝ) * (nfac * amass) := by
        rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ mfac * (nfac * amass) := by
        exact mul_le_mul_of_nonneg_right hcard (mul_nonneg hnfac hamass)
  have hcauchy :
      ‖∑ m ∈ J, B m * inner m‖ ≤
        Real.sqrt bmass * Real.sqrt (∑ m ∈ J, ‖inner m‖ ^ 2) := by
    calc
      ‖∑ m ∈ J, B m * inner m‖ ≤
          ∑ m ∈ J, ‖B m * inner m‖ := norm_sum_le _ _
      _ = ∑ m ∈ J, ‖B m‖ * ‖inner m‖ := by
        apply Finset.sum_congr rfl
        intro m hm
        rw [norm_mul]
      _ ≤ Real.sqrt (∑ m ∈ J, ‖B m‖ ^ 2) *
          Real.sqrt (∑ m ∈ J, ‖inner m‖ ^ 2) :=
        Real.sum_mul_le_sqrt_mul_sqrt J (fun m => ‖B m‖) (fun m => ‖inner m‖)
      _ = Real.sqrt bmass * Real.sqrt (∑ m ∈ J, ‖inner m‖ ^ 2) := by
        rfl
  rw [hbilinear]
  calc
    ‖∑ m ∈ J, B m * inner m‖ ≤
        Real.sqrt bmass * Real.sqrt (∑ m ∈ J, ‖inner m‖ ^ 2) := hcauchy
    _ ≤ Real.sqrt bmass * Real.sqrt (mfac * (nfac * amass)) := by
      exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hinnerMass)
