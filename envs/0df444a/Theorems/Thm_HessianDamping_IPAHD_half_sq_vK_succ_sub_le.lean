-- url     : https://prove2.me/theorems/2b723fd4-1dc2-4dbb-a582-2dd54d4e7eec
-- title:
--   Proof of Theorem 4, p. 13 — ½‖v_{k+1}‖² − ½‖v_k‖² ≤ −(α − 1)hC_k(f(x⋆) − f(x_{k+1})) − hC_k(k + 1)(f(x_k) − f(x_{k+1}))
-- statement:
--   Let $\mathcal H$ be a real Hilbert space and $f:\mathcal H\to\mathbb R$ a convex $\mathcal C^1$ function with a minimizer $x^\star$. Let $\alpha\ge1$, $h>0$, $s=h^2$, let $(\beta_k)$, $(b_k)$ be non-negative sequences, and let $(x_k)$ be generated by (IPAHD). With
--   $C_k=\beta_{k+1}+k(\beta_{k+1}-\beta_k)-b_khk$ and $v_k=(\alpha-1)(x_k-x^\star)+k(x_k-x_{k-1}+\beta_kh\nabla f(x_k))$, if $k\ge1$ and the growth condition $(\mathcal G_2^{\rm dis})$ holds at $k$, i.e. $b_khk-\beta_{k+1}-k(\beta_{k+1}-\beta_k)>0$, then
--   $$\tfrac12\|v_{k+1}\|^2-\tfrac12\|v_k\|^2\le-(\alpha-1)hC_k\big(f(x^\star)-f(x_{k+1})\big)-hC_k(k+1)\big(f(x_k)-f(x_{k+1})\big).$$
--
--   This is the key estimate on the quadratic part of the Lyapunov energy $E_k$ of Theorem 4.
--
--   **Formalization Note.** The minimizer is carried as a point $x^\star$ with $f(x^\star)\le f(y)$ for all $y$ (the paper's "Given $x^\star\in\mathrm{argmin} f$"). $h>0$ and $\beta_k,b_k\ge0$ are implicit on the page and added; $\beta_{k+1}\ge0$ is what makes the dropped coefficient of $\|\nabla f(x_{k+1})\|^2$ non-positive.
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, §3.1.1, proof of Theorem 4, p. 13

import Mathlib
import Definitions.Def_GoldenRatioVI_Shared_IsProxPoint
import Definitions.Def_HessianDamping_IPAHD_Setting

namespace HessianDamping.IPAHD

/-- Proof of Theorem 4, p. 13: the bound on `½‖v_{k+1}‖² - ½‖v_k‖²` under (G₂dis) at `k`. -/
theorem half_sq_vK_succ_sub_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f : H → ℝ) (hfconv : ConvexOn ℝ Set.univ f) (hfC1 : ContDiff ℝ 1 f)
    (xstar : H) (hxstar : ∀ y, f xstar ≤ f y)
    (α : ℝ) (hα : 1 ≤ α)
    (h s : ℝ) (hh : 0 < h) (hs : s = h ^ 2)
    (β b : ℕ → ℝ) (hβ : ∀ k, 0 ≤ β k) (hb : ∀ k, 0 ≤ b k)
    (x : ℕ → H) (hx : IsIPAHDRun f α s β b x)
    (k : ℕ) (hk : 1 ≤ k)
    (hG2 : 0 < b k * h * k - β (k + 1) - k * (β (k + 1) - β k)) :
    1 / 2 * ‖vK f α h β x xstar (k + 1)‖ ^ 2 - 1 / 2 * ‖vK f α h β x xstar k‖ ^ 2
      ≤ -(α - 1) * h * CK h β b k * (f xstar - f (x (k + 1)))
        - h * CK h β b k * ((k : ℝ) + 1) * (f (x k) - f (x (k + 1))) := by sorry

end HessianDamping.IPAHD
