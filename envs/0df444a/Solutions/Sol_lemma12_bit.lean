/-- **(9)**: `s_b = W_b m − N + 2 L_b = 177176569088785861287000000`. -/
theorem rankSum_bit :
    (frameSum (fun A : QMat (100 ^ 3) => A.rank) (bitQC NetProp7.ind₀).gates (bitQC NetProp7.ind₀).Min
      (bitQC NetProp7.ind₀).Mout : ℕ) = 177176569088785861287000000 := by
  have := (prop7_interface NetProp7.ind₀ NetProp7.ind₀_card NetProp7.ind₀_inj).2.2.2
  have hW : (Fintype.card (NetScalar.Wr NetProp7.ind₀) : ℚ) = ((177176569091445000000 : ℕ) : ℚ) := by
    rw [NetProp7.card_Wr₀]
  have h2 : ((frameSum (fun A : QMat (100 ^ 3) => A.rank) (bitQC NetProp7.ind₀).gates (bitQC NetProp7.ind₀).Min
      (bitQC NetProp7.ind₀).Mout : ℕ) : ℚ) = ((177176569088785861287000000 : ℕ) : ℚ) := by
    rw [this, hW, NetProp7.card_T₀]; norm_num
  exact Nat.cast_injective h2

/-- `log 10⁶ < 20`. -/
lemma log_m_lt : Real.log (1000000 : ℝ) < 20 := by
  rw [Real.log_lt_iff_lt_exp (by norm_num),
    show Real.exp 20 = Real.exp 1 ^ 20 by rw [Real.exp_one_pow]; norm_num]
  have h1 := Real.exp_one_gt_d9
  calc (1000000 : ℝ) < 2.7182818283 ^ 20 := by norm_num
    _ < Real.exp 1 ^ 20 := by gcongr

/-- `m^τ ≥ m (1 − 20 · 2^{−50})` for `m = 10⁶`, `τ = 1 − 2^{−50}`. -/
lemma rpow_lower : (1000000 : ℝ) * (1 - 20 * (2 : ℝ)⁻¹ ^ 50) ≤
    (1000000 : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  rw [Real.rpow_def_of_pos (by norm_num)]
  set ε : ℝ := (2 : ℝ)⁻¹ ^ 50 with hε
  have hε0 : 0 < ε := by positivity
  have hl := log_m_lt
  have e : Real.log 1000000 * (1 - ε) = Real.log 1000000 + -(ε * Real.log 1000000) := by ring
  rw [e, Real.exp_add, Real.exp_log (by norm_num)]
  have h2 := Real.add_one_le_exp (-(ε * Real.log 1000000))
  have h3 : 1 - 20 * ε ≤ -(ε * Real.log 1000000) + 1 := by nlinarith
  have := mul_le_mul_of_nonneg_left (h3.trans h2) (by norm_num : (0 : ℝ) ≤ 1000000)
  exact this

/-- **`s_b / W_b < m^τ`** with `τ = 1 − 2^{−50}`. -/
theorem hs_bit :
    ((frameSum (fun A : QMat (100 ^ 3) => A.rank) (bitQC NetProp7.ind₀).gates (bitQC NetProp7.ind₀).Min
      (bitQC NetProp7.ind₀).Mout : ℕ) : ℝ) / (Fintype.card (NetScalar.Wr NetProp7.ind₀) : ℕ) <
      ((100 ^ 3 : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  have hm : ((100 ^ 3 : ℕ) : ℝ) = 1000000 := by norm_num
  rw [rankSum_bit, NetProp7.card_Wr₀, hm]
  refine lt_of_lt_of_le ?_ rpow_lower
  norm_num

/-- **Proposition 7 (bit network, rational interface)**: the circuit `bitQC ind₀` on
`W_b = 177176569091445000000` wires with labels in `QMat 10⁶` has OK gates, routes `w ↦ ρ w`,
satisfies `M_sink(ρ w) − M_source(w) = I_m`, and its rank sum is `s_b` with
`s_b / W_b < m^{1 − 2^{−50}}`. -/
theorem prop7_bit :
    Fintype.card (NetScalar.Wr NetProp7.ind₀) = 177176569091445000000 ∧
    (∀ g ∈ (bitQC NetProp7.ind₀).gates, g.OK) ∧
    (∀ (v : Fin (Fintype.card (NetScalar.Wr NetProp7.ind₀)) → ZMod 2) w,
      scalarRun (bitQC NetProp7.ind₀).gates v ((bitQC NetProp7.ind₀).ρ w) = v w) ∧
    (∀ w, (bitQC NetProp7.ind₀).Mout ((bitQC NetProp7.ind₀).ρ w) - (bitQC NetProp7.ind₀).Min w = 1) ∧
    (frameSum (fun A : QMat (100 ^ 3) => A.rank) (bitQC NetProp7.ind₀).gates (bitQC NetProp7.ind₀).Min
      (bitQC NetProp7.ind₀).Mout : ℕ) = 177176569088785861287000000 ∧
    ((frameSum (fun A : QMat (100 ^ 3) => A.rank) (bitQC NetProp7.ind₀).gates (bitQC NetProp7.ind₀).Min
      (bitQC NetProp7.ind₀).Mout : ℕ) : ℝ) / (Fintype.card (NetScalar.Wr NetProp7.ind₀) : ℕ) <
      ((100 ^ 3 : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  obtain ⟨h1, h2, h3, -⟩ := prop7_interface NetProp7.ind₀ NetProp7.ind₀_card NetProp7.ind₀_inj
  exact ⟨NetProp7.card_Wr₀, h1, h2, h3, rankSum_bit, hs_bit⟩

end NetProp7

end

section
open AModel AModelL12 AModelRat NetProp7
theorem solution {c : ℝ} (hc : 0 ≤ c) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ u : ℕ, 1 ≤ u → ∀ Pre G Suf : AModel.Shape,
        (∀ xs : List (ZMod 2),
          AModelL12.lemma12Prog (fun K => AModel.prog ((NetProp7.bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q)
              (Fintype.card (NetScalar.Wr NetProp7.ind₀)) (100 ^ 3) q (Fintype.card (NetScalar.Wr NetProp7.ind₀))
              Pre G Suf u 0 xs =
            AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (2 ^ u))
              (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs) ∧
        AModelL12.lemma12Cost (fun K => AModel.progCost ((NetProp7.bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q) c
            (Fintype.card (NetScalar.Wr NetProp7.ind₀)) (100 ^ 3) q (Fintype.card (NetScalar.Wr NetProp7.ind₀))
            Pre G Suf u ≤
          K * (AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  obtain ⟨-, h1, h2, h3, -, hs⟩ := NetProp7.prop7_bit
  exact AModelL12.lemma12_rat (NetProp7.bitQC NetProp7.ind₀) (by norm_num) h1 h2 h3 ⟨by norm_num, by norm_num⟩ hs hc
end
