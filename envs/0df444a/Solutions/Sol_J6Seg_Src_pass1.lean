theorem flat_abs {n n' A : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ}
    (ha : ∀ l < n', |argOf l| ≤ 2 ^ A) : ∀ y ∈ flatC (ctlOf n n' src argOf), |y| ≤ 2 ^ A := by
