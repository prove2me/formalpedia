variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalRing K] [LocallyCompactSpace K] [T1Space K]
  [ContinuousInv₀ K] [MeasurableSpace K] [BorelSpace K] (μ : Measure K) [μ.IsAddHaarMeasure] [μ.Regular]

private theorem isHaarMeasure_comap_mulMeasure (hcont : Continuous fun x : K => modulus x) :
    (Measure.comap Units.val (mulMeasure μ)).IsHaarMeasure := by
  set ν : Measure Kˣ := Measure.comap Units.val (mulMeasure μ) with hν
  have hinv : ν.IsMulLeftInvariant := by
    refine ⟨fun g => Measure.ext fun s hs => ?_⟩
    rw [Measure.map_apply (measurable_units_mul_left g) hs, hν,
      comap_val_apply _ ((measurable_units_mul_left g) hs), comap_val_apply _ hs,
      image_val_preimage_mul_left]
    exact mulMeasure_preimage_mul_left μ hcont g (measurableSet_image_val hs) (image_val_subset s)
  have hfin : IsFiniteMeasureOnCompacts ν := by
    refine ⟨fun C hC => ?_⟩
    have hCK : IsCompact (Units.val '' C) := hC.image Units.continuous_val
    have hCm : MeasurableSet C :=
      MeasurableSpace.measurableSet_comap.mpr
        ⟨Units.val '' C, hCK.isClosed.measurableSet, Set.preimage_image_eq C Units.val_injective⟩
    rw [hν, comap_val_apply _ hCm, mulMeasure_apply_of_subset μ (measurableSet_image_val hCm) (image_val_subset C)]
    rcases (Units.val '' C).eq_empty_or_nonempty with hemp | hne
    · rw [hemp, Measure.restrict_empty, lintegral_zero_measure]
      exact ENNReal.zero_lt_top
    · obtain ⟨x₀, hx₀, hmin⟩ := hCK.exists_isMinOn hne hcont.continuousOn
      have hx₀0 : x₀ ≠ 0 := image_val_subset C hx₀
      calc ∫⁻ x in Units.val '' C, dens x ∂μ
          ≤ ∫⁻ _ in Units.val '' C, (modulus x₀ : ℝ≥0∞)⁻¹ ∂μ := by
            refine setLIntegral_mono measurable_const fun x hx => ?_
            unfold dens
            exact ENNReal.inv_le_inv.mpr (ENNReal.coe_le_coe.mpr (hmin hx))
        _ = (modulus x₀ : ℝ≥0∞)⁻¹ * μ (Units.val '' C) := setLIntegral_const _ _
        _ < ∞ := ENNReal.mul_lt_top (ENNReal.inv_lt_top.mpr (by exact_mod_cast modulus_pos hx₀0))
            hCK.measure_lt_top
  have hpos : ν.IsOpenPosMeasure := by
    refine ⟨fun U hU hne => ?_⟩
    obtain ⟨V, hV, rfl⟩ := Units.isEmbedding_val₀.toIsInducing.isOpen_iff.mp hU
    have hUm : MeasurableSet (Units.val ⁻¹' V : Set Kˣ) :=
      MeasurableSpace.measurableSet_comap.mpr ⟨V, hV.measurableSet, rfl⟩
    rw [hν, comap_val_apply _ hUm, Set.image_preimage_eq_inter_range, range_val]
    have hopen : IsOpen (V ∩ ({0}ᶜ : Set K)) := hV.inter isOpen_compl_singleton
    have hne' : (V ∩ ({0}ᶜ : Set K)).Nonempty := by
      obtain ⟨u, hu⟩ := hne
      exact ⟨u, hu, u.ne_zero⟩
    rw [mulMeasure_apply_of_subset μ hopen.measurableSet Set.inter_subset_right]
    intro h0
    have hμ0 : μ (V ∩ ({0}ᶜ : Set K)) = 0 := by
      rw [lintegral_eq_zero_iff (measurable_dens hcont)] at h0

      have : ∀ᵐ x ∂(μ.restrict (V ∩ ({0}ᶜ : Set K))), False := by
        filter_upwards [h0] with x hx
        exact dens_ne_zero x hx
      simpa [ae_iff, Measure.restrict_apply MeasurableSet.univ] using this
    exact hopen.measure_ne_zero μ hne' hμ0
  exact { hfin, hinv, hpos with }

private theorem map_prodMap_comap_mulMeasure_prod (hcont : Continuous fun x : K => modulus x)
    [SFinite (Measure.comap Units.val (mulMeasure μ))] [SFinite μ] (u : Kˣ) {c : Kˣ}
    (hc : modulus (c : K) = 1) :
    ((Measure.comap Units.val (mulMeasure μ)).prod μ).map
        (Prod.map (fun y : Kˣ => u * y) fun x : K => (c : K) * x) =
      (Measure.comap Units.val (mulMeasure μ)).prod μ := by
  haveI := isHaarMeasure_comap_mulMeasure μ hcont
  rw [← Measure.map_prod_map _ _ (measurable_units_mul_left u) (measurable_mul_left c),
    MeasureTheory.map_mul_left_eq_self _ u, map_mul_left_eq_self_of_modulus_eq_one μ hc]

private theorem integrable_prod_comp_mul_left_iff (hcont : Continuous fun x : K => modulus x)
    [SFinite (Measure.comap Units.val (mulMeasure μ))] [SFinite μ] (u : Kˣ) {c : Kˣ}
    (hc : modulus (c : K) = 1) (F : Kˣ × K → ℂ) :
    Integrable (fun p : Kˣ × K => F (u * p.1, (c : K) * p.2))
        ((Measure.comap Units.val (mulMeasure μ)).prod μ) ↔
      Integrable F ((Measure.comap Units.val (mulMeasure μ)).prod μ) := by
  have h := ((unitsMulLeftEquiv u).prodCongr (mulLeftEquiv c)).measurableEmbedding.integrable_map_iff
    (μ := (Measure.comap Units.val (mulMeasure μ)).prod μ) (g := F)
  have hcoe : ⇑((unitsMulLeftEquiv u).prodCongr (mulLeftEquiv c)) =
      Prod.map (fun y : Kˣ => u * y) fun x : K => (c : K) * x := rfl
  rw [hcoe, map_prodMap_comap_mulMeasure_prod μ hcont u hc] at h
  exact h.symm

end
