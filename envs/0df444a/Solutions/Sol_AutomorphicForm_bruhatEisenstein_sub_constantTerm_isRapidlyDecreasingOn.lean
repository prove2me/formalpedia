private theorem exists_bound_iteratedFDerivWithin_Icc {f : ℝ → ℝ} {p q : ℝ} (hpq : p < q)
    (hf : ContDiffOn ℝ ∞ f (Set.Icc p q)) (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ i ≤ n, ∀ y ∈ Set.Icc p q, ‖iteratedFDerivWithin ℝ i f (Set.Icc p q) y‖ ≤ C := by
  have hb : ∀ i : ℕ, ∃ Ci : ℝ, ∀ y ∈ Set.Icc p q, ‖iteratedFDerivWithin ℝ i f (Set.Icc p q) y‖ ≤ Ci :=
    fun i => isCompact_Icc.exists_bound_of_continuousOn
      (hf.continuousOn_iteratedFDerivWithin (by exact_mod_cast le_top) (uniqueDiffOn_Icc hpq))
  choose Cf hCf using hb
  refine ⟨∑ i ∈ Finset.range (n + 1), max 0 (Cf i), Finset.sum_nonneg fun i _ => le_max_left _ _,
    fun i hi y hy => ?_⟩
  calc ‖iteratedFDerivWithin ℝ i f (Set.Icc p q) y‖ ≤ Cf i := hCf i y hy
    _ ≤ max 0 (Cf i) := le_max_right _ _
    _ ≤ ∑ j ∈ Finset.range (n + 1), max 0 (Cf j) :=
        Finset.single_le_sum (f := fun j => max 0 (Cf j)) (fun j _ => le_max_left _ _)
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))

variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private def hatD (g : Matrix (Fin 2) (Fin 2) ℂ) (n : ℕ) : ℝ :=
  max 1 (∑ i ∈ Finset.range (n + 1), hatTower g i)

private theorem one_le_hatD (g : Matrix (Fin 2) (Fin 2) ℂ) (n : ℕ) : 1 ≤ hatD g n := le_max_left _ _

private theorem hatTower_le_hatD (g : Matrix (Fin 2) (Fin 2) ℂ) {n i : ℕ} (hi : i ≤ n) : hatTower g i ≤ hatD g n :=
  (Finset.single_le_sum (f := fun j => hatTower g j) (fun j _ => hatTower_nonneg g j)
    (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))).trans (le_max_right _ _)

private theorem hatTower_le_hatD_pow (g : Matrix (Fin 2) (Fin 2) ℂ) {n i : ℕ} (hi1 : 1 ≤ i) (hi : i ≤ n) :
    hatTower g i ≤ hatD g n ^ i :=
  (hatTower_le_hatD g hi).trans (le_self_pow₀ (one_le_hatD g n) (by omega))

private theorem norm_imCLM_le_one : ‖(Complex.imCLM : ℂ →L[ℝ] ℝ)‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun z => by
    rw [Complex.imCLM_apply, Real.norm_eq_abs, one_mul]
    exact Complex.abs_im_le_norm z

private theorem norm_reCLM_le_one : ‖(Complex.reCLM : ℂ →L[ℝ] ℝ)‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun z => by
    rw [Complex.reCLM_apply, Real.norm_eq_abs, one_mul]
    exact Complex.abs_re_le_norm z

private theorem norm_iteratedFDeriv_clm_clamp_le {h : ℝ → ℂ} (hh : ContDiff ℝ ∞ h)
    (hT : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h t‖ ≤ hatTower g i) (L : ℂ →L[ℝ] ℝ) (hL : ‖L‖ ≤ 1)
    {a b η : ℝ} (hη : 0 < η) (ha : a < 0) (hb : 0 < b) (i : ℕ) :
    ‖iteratedFDeriv ℝ i (fun t : ℝ => L (h (chartClamp a b η t))) 0‖ ≤ hatTower g i := by
  have hev : (fun t : ℝ => L (h (chartClamp a b η t))) =ᶠ[nhds (0 : ℝ)] (L ∘ h) := by
    filter_upwards [Icc_mem_nhds ha hb] with t ht
    simp only [Function.comp_apply, chartClamp_of_mem hη ht]
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hev.iteratedDeriv_eq i,
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv,
    ContinuousLinearMap.iteratedFDeriv_comp_left _ hh.contDiffAt (by exact_mod_cast le_top)]
  calc ‖L.compContinuousMultilinearMap (iteratedFDeriv ℝ i h 0)‖
      ≤ ‖L‖ * ‖iteratedFDeriv ℝ i h 0‖ := ContinuousLinearMap.norm_compContinuousMultilinearMap_le _ _
    _ ≤ 1 * hatTower g i := mul_le_mul hL (hT i 0) (norm_nonneg _) zero_le_one
    _ = hatTower g i := one_mul _

private theorem norm_iteratedFDeriv_im_clamp_le {h : ℝ → ℂ} (hh : ContDiff ℝ ∞ h)
    (hT : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h t‖ ≤ hatTower g i) {a b η : ℝ} (hη : 0 < η)
    (ha : a < 0) (hb : 0 < b) (i : ℕ) :
