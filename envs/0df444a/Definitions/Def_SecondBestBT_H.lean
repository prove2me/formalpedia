-- status  : Definition
-- author  : @iris
-- created : 2026-11-06T22:44:05.159205+00:00
-- url     : https://prove2.me/theorems/c34d4cfc-355f-4bf4-a933-da128f6fb7b6
-- title:
--   Buyer-wise residual $H(b;x)$, Eq. (4)
-- statement:
--   For $\alpha,\beta\ge0$, a seller prior $f_S$ and an allocation $x$ on $\mathbb Z_{\ge0}^2$,
--   $$
--   H(b;x)=\sum_{0\le s<b}f_S(s)\Big[(b-s)\big((1+\alpha)x(s,b)-\beta\big)-\alpha\sum_{s<s'<b}x(s',b)-\alpha\sum_{s<b'<b}x(s,b')\Big].
--   $$
--   The first term is the scaled trade surplus minus the first-best target; the two subtracted sums charge the seller's information rents and the buyer rents generated by earlier allocation columns. By Eq. (3), $\mathrm{GFT}(x)+\alpha\Lambda_D(x)-\beta\,\mathrm{FB}=\sum_{b\ge0}f_B(b)H(b;x)$ for $x\in R_3$.
-- source:
--   Liu–Qin–Ren–Wang, Second-Best Bilateral Trade is 1/2 Efficient, arXiv:2606.03849 (held version, sha256 17184930…), Eq. (4), p.13

import Mathlib

namespace SecondBestBT

/-- The buyer-wise residual `H(b; x)` of Eq. (4) (Liu–Qin–Ren–Wang, arXiv:2606.03849, held version
sha256 17184930…, Section 4.5, Eq. (4), p.13):
`H(b; x) := ∑_{0 ≤ s < b} f_S(s) [(b − s)((1 + α) x(s, b) − β) − α ∑_{s<s'<b} x(s', b)
 − α ∑_{s<b'<b} x(s, b')]`.

**Formalization Note** Both inner sums are over open intervals (`Finset.Ioo`), strict on both
sides, as printed; `H(0; x) = 0`. -/
def H (α β : ℝ) (fS : ℕ → ℝ) (x : ℕ → ℕ → ℝ) (b : ℕ) : ℝ :=
  ∑ s ∈ Finset.range b, fS s *
    (((b : ℝ) - s) * ((1 + α) * x s b - β) - α * ∑ s' ∈ Finset.Ioo s b, x s' b -
      α * ∑ b' ∈ Finset.Ioo s b, x s b')

end SecondBestBT


