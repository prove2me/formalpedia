    funext z
    ring
  have h10 : Approximates 24 k (fun z => f z ^ 10) replay12p10 := by
    convert (h2.mul hk h8).replacePolynomial (equalityCheck_sound replay12p10_checked k) using 1
    funext z
    ring
  have h12 : Approximates 24 k (fun z => f z ^ 12) replay12p12 := by
    convert (h2.mul hk h10).replacePolynomial (equalityCheck_sound replay12p12_checked k) using 1
    funext z
    ring
  have h14 : Approximates 24 k (fun z => f z ^ 14) replay12p14 := by
    convert (h2.mul hk h12).replacePolynomial (equalityCheck_sound replay12p14_checked k) using 1
    funext z
    ring
  have h16 : Approximates 24 k (fun z => f z ^ 16) replay12p16 := by
    convert (h2.mul hk h14).replacePolynomial (equalityCheck_sound replay12p16_checked k) using 1
    funext z
    ring
  have h18 : Approximates 24 k (fun z => f z ^ 18) replay12p18 := by
    convert (h2.mul hk h16).replacePolynomial (equalityCheck_sound replay12p18_checked k) using 1
    funext z
    ring
  have h20 : Approximates 24 k (fun z => f z ^ 20) replay12p20 := by
