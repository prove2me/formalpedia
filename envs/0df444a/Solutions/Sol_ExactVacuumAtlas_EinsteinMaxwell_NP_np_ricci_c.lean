  have a31 : ∀ A, omL g gi E Θ 3 A 1 x = -omL g gi E Θ 1 A 3 x := fun A => hN.omL_antisymm hx 3 A 1
  have a32 : ∀ A, omL g gi E Θ 3 A 2 x = -omL g gi E Θ 2 A 3 x := fun A => hN.omL_antisymm hx 3 A 2
