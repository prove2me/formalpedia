private theorem _root_.ModularCurve.JZeroNeronObjectAtP.inertia_toricPts (m : ℕ)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσ : σ ∈ A.inertiaSubgroupIn ℚ) (c : ℕ)
    (hc : ∀ ζ : AlgebraicClosure ℚ, ζ ^ m = 1 → σ ζ = ζ ^ c) :
    ∀ x ∈ O.toricPts m, σ • x = c • x := by
  intro x hx
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [toricPts_zero, AddSubgroup.mem_bot] at hx
    subst hx
    rw [nsmul_zero]
    exact smul_zero (A := JZero (N₀ * p)) σ
  rw [toricPts_of_pos O hm] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
      obtain ⟨χ, rfl⟩ := hy
      exact O.toricLift_inertia m hm σ hσ c hc χ
  | zero =>
      rw [nsmul_zero]
      exact smul_zero (A := JZero (N₀ * p)) σ
  | add y z _ _ hy hz =>
      rw [nsmul_add, ← hy, ← hz]
      exact smul_add (A := JZero (N₀ * p)) σ y z
  | neg y _ hy =>
      rw [neg_nsmul, ← hy]
      exact smul_neg σ y

p2m_export "ModularCurve.JZeroNeronObjectAtP" "inertia_toricPts"

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.galois_smul_mem_toricPts (m : ℕ)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσ : σ ∈ A.decompositionSubgroup ℚ) :
    ∀ x ∈ O.toricPts m, σ • x ∈ O.toricPts m := by
  intro x hx
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [toricPts_zero, AddSubgroup.mem_bot] at hx
    subst hx
    rw [smul_zero (A := JZero (N₀ * p)) σ]; exact AddSubgroup.zero_mem _
  rw [toricPts_of_pos O hm] at hx ⊢
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
      obtain ⟨χ, rfl⟩ := hy
      obtain ⟨χ', hχ'⟩ := O.toricLift_dec m hm σ hσ χ
      exact AddSubgroup.subset_closure ⟨χ', hχ'.symm⟩
  | zero => rw [smul_zero (A := JZero (N₀ * p)) σ]; exact AddSubgroup.zero_mem _
  | add y z _ _ hy hz => rw [smul_add]; exact AddSubgroup.add_mem _ hy hz
  | neg y _ hy => rw [smul_neg]; exact AddSubgroup.neg_mem _ hy

p2m_export "ModularCurve.JZeroNeronObjectAtP" "galois_smul_mem_toricPts"
