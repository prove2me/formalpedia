namespace Integration9_9.TM2OutputLength
open Turing StateTransition

variable {K Λ σ : Type} {Γ : K → Type} [Fintype K] [DecidableEq K]

/-- Largest stack length; unlike a total-size bound it needs no common stack alphabet. -/
def stackSize (S : ∀ k, List (Γ k)) : ℕ := Finset.univ.sup fun k => (S k).length

omit [DecidableEq K] in
theorem length_le_stackSize (S : ∀ k, List (Γ k)) (k : K) :
    (S k).length ≤ _root_.Integration9_9.TM2OutputLength.stackSize S :=
  by
    unfold _root_.Integration9_9.TM2OutputLength.stackSize
    exact Finset.le_sup (f := fun j => (S j).length) (Finset.mem_univ k)

theorem stackSize_update_le (S : ∀ k, List (Γ k)) (k : K) (v : List (Γ k)) (n : ℕ)
    (hS : _root_.Integration9_9.TM2OutputLength.stackSize S ≤ n) (hv : v.length ≤ n) :
    _root_.Integration9_9.TM2OutputLength.stackSize (Function.update S k v) ≤ n := by
  apply Finset.sup_le
  intro j hj
  by_cases h : j = k
  · subst j
    simpa using hv
  · simpa [Function.update_of_ne h] using (_root_.Integration9_9.TM2OutputLength.length_le_stackSize S j).trans hS

/-- The maximum number of pushes along one branch of a single TM2 statement. -/
def pushBound : TM2.Stmt Γ Λ σ → ℕ
  | .push _ _ q => pushBound q + 1
  | .peek _ _ q => pushBound q
  | .pop _ _ q => pushBound q
  | .load _ q => pushBound q
  | .branch _ q r => max (pushBound q) (pushBound r)
  | .goto _ => 0
  | .halt => 0

theorem stepAux_stackSize_le (q : TM2.Stmt Γ Λ σ) (v : σ) (S : ∀ k, List (Γ k)) :
    _root_.Integration9_9.TM2OutputLength.stackSize (TM2.stepAux q v S).stk ≤ _root_.Integration9_9.TM2OutputLength.stackSize S + _root_.Integration9_9.TM2OutputLength.pushBound q := by
  induction q generalizing v S with
  | push k f q ih =>
    have h := ih v (Function.update S k (f v :: S k))
    have hu : _root_.Integration9_9.TM2OutputLength.stackSize (Function.update S k (f v :: S k)) ≤ _root_.Integration9_9.TM2OutputLength.stackSize S + 1 :=
      _root_.Integration9_9.TM2OutputLength.stackSize_update_le S k _ _ (Nat.le_add_right _ _) (by
        simpa using Nat.succ_le_succ (_root_.Integration9_9.TM2OutputLength.length_le_stackSize S k))
    simpa only [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound] using h.trans (by omega)
  | peek k f q ih => simpa only [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound] using ih (f v (S k).head?) S
  | pop k f q ih =>
    have h := ih (f v (S k).head?) (Function.update S k (S k).tail)
    have hu : _root_.Integration9_9.TM2OutputLength.stackSize (Function.update S k (S k).tail) ≤ _root_.Integration9_9.TM2OutputLength.stackSize S :=
      _root_.Integration9_9.TM2OutputLength.stackSize_update_le S k _ _ (le_refl _) (by
        simp only [List.length_tail]
        exact (Nat.sub_le _ _).trans (_root_.Integration9_9.TM2OutputLength.length_le_stackSize S k))
    simpa only [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound] using h.trans (Nat.add_le_add_right hu _)
  | load f q ih => simpa only [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound] using ih (f v) S
  | branch f q r iq ir =>
    cases h : f v with
    | false => simpa only [TM2.stepAux, h, Bool.cond_false, _root_.Integration9_9.TM2OutputLength.pushBound] using
        (ir v S).trans (Nat.add_le_add_left (le_max_right _ _) _)
    | true => simpa only [TM2.stepAux, h, Bool.cond_true, _root_.Integration9_9.TM2OutputLength.pushBound] using
        (iq v S).trans (Nat.add_le_add_left (le_max_left _ _) _)
  | goto f => simp [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound]
  | halt => simp [TM2.stepAux, _root_.Integration9_9.TM2OutputLength.pushBound]

variable [Fintype Λ]

/-- A constant depending only on the finite machine, not on its input. -/
def programPushBound (M : Λ → TM2.Stmt Γ Λ σ) : ℕ :=
  Finset.univ.sup fun l => _root_.Integration9_9.TM2OutputLength.pushBound (M l)

theorem step_stackSize_le (M : Λ → TM2.Stmt Γ Λ σ) (a b : TM2.Cfg Γ Λ σ)
    (h : TM2.step M a = some b) :
    _root_.Integration9_9.TM2OutputLength.stackSize b.stk ≤ _root_.Integration9_9.TM2OutputLength.stackSize a.stk + _root_.Integration9_9.TM2OutputLength.programPushBound M := by
  rcases a with ⟨l,v,S⟩
  cases l with
  | none => simp [TM2.step] at h
  | some l =>
    simp only [TM2.step, Option.some.injEq] at h
    subst b
    have hp : _root_.Integration9_9.TM2OutputLength.pushBound (M l) ≤ _root_.Integration9_9.TM2OutputLength.programPushBound M := by
      unfold _root_.Integration9_9.TM2OutputLength.programPushBound
      exact Finset.le_sup (f := fun j => _root_.Integration9_9.TM2OutputLength.pushBound (M j)) (Finset.mem_univ l)
    exact (_root_.Integration9_9.TM2OutputLength.stepAux_stackSize_le (M l) v S).trans (Nat.add_le_add_left hp _)

/-- Abstract accumulation of a one-step size bound through a bounded execution. -/
theorem iterate_size_bound {C : Type} (step : C → Option C) (size : C → ℕ) (cost : ℕ)
    (hstep : ∀ a b, step a = some b → size b ≤ size a + cost) :
    ∀ n a b, ((fun x : Option C => x.bind step)^[n]) (some a) = some b →
      size b ≤ size a + cost * n := by
  intro n
  induction n with
  | zero =>
    intro a b h
    simp only [Function.iterate_zero, id_eq, Option.some.injEq] at h
    subst b
    simp
  | succ n ih =>
    intro a b h
    rw [Function.iterate_succ_apply] at h
    cases hs : step a with
    | none =>
      have hn : ∀ k, ((fun x : Option C => x.bind step)^[k]) none = none := by
        intro k
        induction k with
        | zero => rfl
        | succ k hk => simpa only [Function.iterate_succ_apply, Option.bind_none] using hk
      simp only [Option.bind_some, hs, hn] at h
      contradiction
    | some a' =>
      simp only [Option.bind_some, hs] at h
      have hi := ih a' b h
      have hlocal := hstep a a' hs
      calc
        size b ≤ size a' + cost * n := hi
        _ ≤ size a + cost * (n+1) := by rw [Nat.mul_add, Nat.mul_one]; omega

theorem evalsToInTime_stackSize_le (M : Λ → TM2.Stmt Γ Λ σ)
    (a b : TM2.Cfg Γ Λ σ) (m : ℕ)
    (h : EvalsToInTime (TM2.step M) a (some b) m) :
    _root_.Integration9_9.TM2OutputLength.stackSize b.stk ≤ _root_.Integration9_9.TM2OutputLength.stackSize a.stk + _root_.Integration9_9.TM2OutputLength.programPushBound M * m := by
  have hs := _root_.Integration9_9.TM2OutputLength.iterate_size_bound (TM2.step M) (fun c => _root_.Integration9_9.TM2OutputLength.stackSize c.stk)
    (_root_.Integration9_9.TM2OutputLength.programPushBound M) (_root_.Integration9_9.TM2OutputLength.step_stackSize_le M) h.steps a b h.evals_in_steps
  exact hs.trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ h.steps_le_m) _)

local instance tmStacksFintype (tm : FinTM2) : Fintype tm.K := tm.kFin
local instance tmLabelsFintype (tm : FinTM2) : Fintype tm.Λ := tm.ΛFin

/-- The initialized machine has no stack longer than its input. -/
theorem initList_stackSize_le (tm : FinTM2) (input : List (tm.Γ tm.k₀)) :
    _root_.Integration9_9.TM2OutputLength.stackSize (initList tm input).stk ≤ input.length := by
  apply Finset.sup_le
  intro k hk
  by_cases h : k = tm.k₀
  · subst k
    simp [initList]
  · simp [initList, h]

/-- A machine cannot emit more symbols than it initially receives plus its
fixed per-step push capacity times the allowed number of steps. -/
theorem output_length_le (tm : FinTM2) (input : List (tm.Γ tm.k₀))
    (output : List (tm.Γ tm.k₁)) (time : ℕ)
    (h : TM2OutputsInTime tm input (some output) time) :
    output.length ≤ input.length + _root_.Integration9_9.TM2OutputLength.programPushBound tm.m * time := by
  have hs := _root_.Integration9_9.TM2OutputLength.evalsToInTime_stackSize_le tm.m (initList tm input) (haltList tm output) time h
  calc
    output.length = ((haltList tm output).stk tm.k₁).length := by simp [haltList]
    _ ≤ _root_.Integration9_9.TM2OutputLength.stackSize (haltList tm output).stk := _root_.Integration9_9.TM2OutputLength.length_le_stackSize _ _
    _ ≤ _root_.Integration9_9.TM2OutputLength.stackSize (initList tm input).stk + _root_.Integration9_9.TM2OutputLength.programPushBound tm.m * time := hs
    _ ≤ input.length + _root_.Integration9_9.TM2OutputLength.programPushBound tm.m * time :=
      Nat.add_le_add_right (_root_.Integration9_9.TM2OutputLength.initList_stackSize_le tm input) _



end Integration9_9.TM2OutputLength

end

