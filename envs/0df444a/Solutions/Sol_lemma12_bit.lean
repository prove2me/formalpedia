lemma netRunF_coe (Φ : M → (Ω → R) →ₗ[R] (Ω → R)) (gates : List (NGate Wr R M))
    (Min Mout : Wr → M) (f : Wr → Ω → R) :
    netRunF (fun a => ⇑(Φ a)) gates Min Mout f = netRun Φ gates Min Mout f := rfl

omit [Fintype Wr] in
lemma foldl_physStepF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (Mout : Wr → M) :
    ∀ (gates : List (NGate Wr R M)) (st : (Wr → M) × (Wr → Ω → R)),
      FramesOK Pr gates st.1 Mout →
      gates.foldl (physStepF Φ₁) st = gates.foldl (physStepF Φ₂) st ∧
        ∀ w, Pr (Mout w - (gates.foldl (physStepF Φ₁) st).1 w) := by
  intro gates
  induction gates with
  | nil => intro st hF; exact ⟨rfl, hF⟩
  | cons g gs ih =>
    intro st hF
    have e : physStepF Φ₁ st g = physStepF Φ₂ st g := by
      simp only [physStepF, Prod.mk.injEq, true_and]
      funext w
      split_ifs
      · exact Finset.sum_congr rfl fun w' hw' => by rw [h _ (hF.1 w' hw')]
      · rfl
    simp only [List.foldl_cons]
    rw [← e]
    exact ih _ hF.2

omit [Fintype Wr] in
/-- Two implementations agreeing on every frame change that occurs give the same network. -/
theorem netRunF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (gates : List (NGate Wr R M)) (Min Mout : Wr → M)
    (hF : FramesOK Pr gates Min Mout) (f : Wr → Ω → R) :
    netRunF Φ₁ gates Min Mout f = netRunF Φ₂ gates Min Mout f := by
  obtain ⟨e, hp⟩ := foldl_physStepF_congr Pr Φ₁ Φ₂ h Mout gates (Min, f) hF
  funext w
  simp only [netRunF]
  rw [← e, h _ (hp w)]

