/-- The plan widths are `O(p)`. -/
theorem wt_facts :
    cBI P n src k ap + cBH P n src k ap + 2 ≤ Wt ap * pP6 P n ∧
    cBk P n src k ap + 2 ≤ Wt ap * pP6 P n ∧
    cBH P n src k ap + cBI P n src k ap + axb6 P n src k ap + axpk6 P n src k ap + 10 ≤
      Wt ap * pP6 P n ∧
    axb6 P n src k ap ≤ Wt ap * pP6 P n ∧
    2 * cBI P n src k ap ≤ 64 * ((Wt ap + 10) * pP6 P n) := by
  have hp := h.p1
  have hQ := h.Qp
  have hR : axR6 P n ≤ pP6 P n := Nat.div_le_self _ _
  have hwd := Side.wd_le ap h
  have hb : axb6 P n src k ap ≤ Wb ap * pP6 P n := by
    have h1 : ap.pl.bA * axQ6 P n src k ≤ ap.pl.bA * (3 * pP6 P n) := Nat.mul_le_mul_left _ hQ
    have h2 : ap.pl.bC ≤ ap.pl.bC * pP6 P n := Nat.le_mul_of_pos_right _ hp
    show ap.pl.bA * axQ6 P n src k + ap.pl.bC ≤ (3 * ap.pl.bA + ap.pl.bC) * pP6 P n
    have e : (3 * ap.pl.bA + ap.pl.bC) * pP6 P n = ap.pl.bA * (3 * pP6 P n) + ap.pl.bC * pP6 P n :=
      by ring
    omega
  have hk : axpk6 P n src k ap ≤ Wk ap * pP6 P n := by
    have h1 : ap.pl.pkA * axQ6 P n src k ≤ ap.pl.pkA * (3 * pP6 P n) := Nat.mul_le_mul_left _ hQ
    have h2 : ap.pl.pkC ≤ ap.pl.pkC * pP6 P n := Nat.le_mul_of_pos_right _ hp
    show ap.pl.pkA * axQ6 P n src k + ap.pl.pkC ≤ (3 * ap.pl.pkA + ap.pl.pkC) * pP6 P n
    have e : (3 * ap.pl.pkA + ap.pl.pkC) * pP6 P n =
        ap.pl.pkA * (3 * pP6 P n) + ap.pl.pkC * pP6 P n := by ring
    omega
  have e : Wt ap * pP6 P n = Side.Wc ap * pP6 P n + 4 * (Wb ap * pP6 P n) +
      5 * (Wk ap * pP6 P n) + 60 * pP6 P n := by unfold Wt; ring
  have e2 : 64 * ((Wt ap + 10) * pP6 P n) = 64 * (Wt ap * pP6 P n) + 640 * pP6 P n := by ring
