theorem U_ge (W : ℕ) : 10 ^ 42 * (W + 40) ^ 2 ≤ U W := by
  unfold U
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by omega) (by norm_num))

theorem lin_U (W : ℕ) : 10 ^ 9 * (W + 40) ^ 2 ≤ U W :=
  le_trans (Nat.mul_le_mul_right _ (by norm_num)) (U_ge W)

/-- The table length. -/
theorem tl_le {W p s t α pk b pkA pkC bA bC : ℕ} (h : CB W p t α pkA pkC bA bC) :
    (tabA p s t α pk b).length ≤ W * W := by
  rw [tabA, tabsA_length]; exact Nat.mul_le_mul h.c5 (by have := h.c1; omega)

set_option maxRecDepth 20000 in
/-- **The cost of the tear-down.** -/
theorem cTear_le {W p s t α pkA pkC bA bC : ℕ} (h : CB W p t α pkA pkC bA bC) :
    cTear (W + 1) (tabA p s t α (pkA * p + pkC) (bA * p + bC)).length + 2 ≤
      10 ^ 45 * (W + 40) ^ 12 := by
  have hn := tl_le (s := s) (pk := pkA * p + pkC) (b := bA * p + bC) h
  generalize (tabA p s t α (pkA * p + pkC) (bA * p + bC)).length = n at hn ⊢
  unfold cTear
  have s3 : (Ex.reg (S := HS) sLn).size = 1 := rfl
  try simp only [s3]
  have d := lin_U W
  have hnU' : n * (2 * (W + 1) + 2 + 8000 * (W + 1 + 2) + 30) ≤ (W + 1) * ((W + 1) * U W) := by
    have : 2 * (W + 1) + 2 + 8000 * (W + 1 + 2) + 30 ≤ U W := by nlinarith
    calc _ ≤ (W * W) * U W := Nat.mul_le_mul hn this
      _ ≤ (W + 1) * ((W + 1) * U W) := by nlinarith
  have u1 : U W ≤ (W + 1) * U W := Nat.le_mul_of_pos_left _ (by omega)
  have u2 : (W + 1) * U W ≤ (W + 1) * ((W + 1) * U W) := Nat.le_mul_of_pos_left _ (by omega)
  have small : 9 * (2 * (W + 1) + 2) + 1 + (1 + 1) * 2000 * (W + 1 + 2) + 32 + (2 * (W + 1) + 2) + 2
      ≤ U W := by nlinarith
  have hfin : 2 * ((W + 1) * ((W + 1) * U W)) ≤ 10 ^ 45 * (W + 40) ^ 12 := by
    unfold U
    have h1 : (W + 1) * (W + 1) ≤ (W + 40) ^ 2 := by nlinarith
    calc 2 * ((W + 1) * ((W + 1) * (10 ^ 42 * (W + 40) ^ 10))) =
        2 * 10 ^ 42 * ((W + 1) * (W + 1) * (W + 40) ^ 10) := by ring
      _ ≤ 2 * 10 ^ 42 * ((W + 40) ^ 2 * (W + 40) ^ 10) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ h1)
      _ = 2 * 10 ^ 42 * (W + 40) ^ 12 := by ring
      _ ≤ _ := Nat.mul_le_mul_right _ (by norm_num)
  refine le_trans ?_ hfin
  clear hfin
  linarith

