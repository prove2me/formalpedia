private theorem interval_drops (x : ℕ) (hl : 574619648 ≤ x) (hu : x < 587202560)
    (hodd : ¬2 ∣ x) (hthree : ¬3 ∣ x) : Drops x x := by
  by_cases hone : x % 4 = 1
  · refine ⟨2, ?_⟩
    have he : x % 2 ≠ 0 := by omega
    have he' : ((3*x+1)/2) % 2 = 0 := by omega
    change halfStep (halfStep x) < x
    simp [halfStep, he, he']
    omega
  · by_cases hs : x % 12 = 7
    · let k := (x-574619659)/12
      have hk : k < 2^20 := by dsimp [k]; omega
      have hx : 574619659+12*k=x := by dsimp [k]; omega
      simpa only [hx] using drops_class _ k hk classSeven
    · let k := (x-574619651)/12
      have hres : x % 12 = 11 := by omega
      have hk : k < 2^20 := by dsimp [k]; omega
      have hx : 574619651+12*k=x := by dsimp [k]; omega
      simpa only [hx] using drops_class _ k hk classEleven

private def oddPart (n : ℕ) : ℕ := ordCompl[2] n

private theorem oddPart_half (n : ℕ) :
    ∃ k : ℕ, syracuseStep^[k] (oddPart n) = oddPart (halfStep n) := by
  by_cases he : n % 2 = 0
  · refine ⟨0, ?_⟩
    simpa [oddPart, halfStep, he] using
      (Nat.ordCompl_div_of_dvd Nat.prime_two (Nat.dvd_of_mod_eq_zero he)).symm
  · have ho : oddPart n = n :=
      (Nat.ordCompl_eq_self_iff_zero_or_not_dvd n Nat.prime_two).mpr (Or.inr (by omega))
    refine ⟨1, ?_⟩
    rw [ho, Function.iterate_one]
    simpa [syracuseStep, oddPart, halfStep, he] using
      (Nat.ordCompl_div_of_dvd Nat.prime_two (show 2 ∣ 3*n+1 by omega)).symm

private theorem liftHalf (n j : ℕ) :
    ∃ k : ℕ, syracuseStep^[k] (oddPart n) = oddPart (halfStep^[j] n) := by
  induction j with
  | zero => exact ⟨0,rfl⟩
  | succ j ih =>
    obtain ⟨k,hk⟩ := ih
    obtain ⟨l,hl⟩ := oddPart_half (halfStep^[j] n)
    exact ⟨l+k, by rw [Function.iterate_add_apply, hk, Function.iterate_succ_apply', hl]⟩

theorem solution (x : ℕ) (hl : 574619648 ≤ x) (hu : x < 587202560)
    (hodd : ¬2 ∣ x) (hthree : ¬3 ∣ x) : ∃ t : ℕ, syracuseStep^[t] x < x := by
  obtain ⟨n,hn⟩ := interval_drops x hl hu hodd hthree
  obtain ⟨k,hk⟩ := liftHalf x n
  have hself : oddPart x = x :=
    (Nat.ordCompl_eq_self_iff_zero_or_not_dvd x Nat.prime_two).mpr (Or.inr hodd)
  rw [hself] at hk
  have hpart : oddPart (halfStep^[n] x) ≤ halfStep^[n] x := Nat.div_le_self _ _
  exact ⟨k, (hk.trans_le hpart).trans_lt hn⟩
