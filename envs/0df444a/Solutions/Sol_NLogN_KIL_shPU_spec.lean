    hS.hA hS.hC hS.hM hS.hAM hNQ
  set t1 := ((((t.upd 14 (ints (NLogN.KIL.tbl Q ac) ++ t.G 14)).upd sSA LA).upd sSC LC).upd sSM LM).upd sSAM LAM
  have S2 := Sp.pushReg t1 (i := 1) (j := sPA) (by decide) (by decide) (a := (vol A : ℤ)) (L := LP)
    (by simp (config := {decide := true}) [t1, hPA]) zA
  set t2 := t1.upd 1 (.int (vol A : ℤ) :: t1.G 1)
  have S3 := Sp.pushReg t2 (i := 2) (j := sQQ) (by decide) (by decide) (a := (Q : ℤ)) (L := LQ)
    (by simp (config := {decide := true}) [t2, t1, hQQ]) zQ
  set t3 := t2.upd 2 (.int (Q : ℤ) :: t2.G 2)
  have S4 := Sp.pushReg t3 (i := 4) (j := sPC) (by decide) (by decide) (a := (vol C : ℤ)) (L := LC')
    (by simp (config := {decide := true}) [t3, t2, t1, hPC]) zC
  set t4 := t3.upd 4 (.int (vol C : ℤ) :: t3.G 4)
  have R5 := hcore t4 (by simp (config := {decide := true}) [t4, t3, t2, t1, h0])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
    (by simp (config := {decide := true}) [t4, t3, t2, t1])
  set t5 := (t4.upd 0 (ints ys ++ R)).upd 14 (t.G 14)
