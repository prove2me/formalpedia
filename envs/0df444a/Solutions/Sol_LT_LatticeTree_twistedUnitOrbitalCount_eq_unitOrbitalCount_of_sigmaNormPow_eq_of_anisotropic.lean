  have hrank : (A.map (algebraMap O F)).rank ≤ (A.map (algebraMap O K)).rank :=
    rank_map_le_rank_map_of_isFractionRing A
  have eK : (A.map (algebraMap O K)).rank
      = Module.finrank K (LinearMap.range (A.map (algebraMap O K)).mulVecLin) := rfl
  have eF : (A.map (algebraMap O F)).rank
      = Module.finrank F (LinearMap.range (A.map (algebraMap O F)).mulVecLin) := rfl
