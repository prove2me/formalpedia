private theorem t0399 (dF : FinWhittakerDatum K S Pi) (A : AdelicGL2 (𝓞 K) K → ℂ)
    (δ : (AdeleRing (𝓞 K) K)ˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
