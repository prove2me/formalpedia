    (e := .lit 0) (inRg_of (by decide)) (by decide) (by decide) (by decide)
  try simp only [Ex.eval] at P14
  have T := P1.seq (P2.seq (P3.seq (P4.seq (P5.seq (P6.seq (P7.seq (P8.seq (P9.seq (P10.seq
    (P11.seq (P12.seq (P13.seq P14))))))))))))
