theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N]
    (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)) (φ : E.A ⟶ E.A) (hφ : φ ≫ E.f = E.f) [IsIso φ] (k : ℕ)
    (h : (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P : SchemeHomOver t E.f),
            mapPt φ hφ P = nsmulPt E.L t k P) ∨
         (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P : SchemeHomOver t E.f),
            mapPt φ hφ P = E.L.inv t (nsmulPt E.L t k P))) :
    k = 1 := by
  classical
  have hord : IsOrder Λ := hΛ.isOrder
  set t₀ : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)) := 𝟙 _ with ht₀
  letI grp : Group (SchemeHomOver t₀ E.f) := E.L.pointGroup t₀

  have hpow : ∀ (n : ℕ) (P : SchemeHomOver t₀ E.f), nsmulPt E.L t₀ n P = P ^ n := by
    intro n P
    induction n with
    | zero => rfl
    | succ n ih => show E.L.mul _ (nsmulPt E.L _ n P) P = P ^ (n + 1); rw [ih, pow_succ]; rfl

  have hinj : ∀ P Q : SchemeHomOver t₀ E.f, mapPt φ hφ P = mapPt φ hφ Q → P = Q := by
    intro P Q hPQ
    have h1 : P.1 ≫ φ = Q.1 ≫ φ := congrArg Subtype.val hPQ
    exact Subtype.ext ((cancel_mono φ).mp h1)

  have hkill : ∀ P : SchemeHomOver t₀ E.f, nsmulPt E.L t₀ k P = E.L.one t₀ → P = E.L.one t₀ := by
    intro P hP
    have hone : nsmulPt E.L t₀ k (E.L.one t₀) = E.L.one t₀ := by rw [hpow]; exact one_pow k
    apply hinj
    rcases h with h | h
    · rw [h t₀ P, h t₀ (E.L.one t₀), hP, hone]
    · rw [h t₀ P, h t₀ (E.L.one t₀), hP, hone]

  have hpt : ∀ p : ℕ, p.Prime → ∃ P₀ : SchemeHomOver t₀ E.f, nsmulPt E.L t₀ p P₀ = E.L.one t₀ ∧ P₀ ≠ E.L.one t₀ := by
    intro p hp
    haveI : Fact p.Prime := ⟨hp⟩
    have hpK : (p : AlgebraicClosure ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
    obtain ⟨P₀, hP₀, -, hann⟩ :=
      FakeEllipticCurve.exists_generator_torsionPoints_of_isMaximalOrder_of_prime hB Λ hΛ (AlgebraicClosure ℚ) E p hpK
    refine ⟨P₀, hP₀, fun h0 => ?_⟩
    have h1 : pushPt (E.act ⟨1, hord.one_mem⟩) (E.act_over ⟨1, hord.one_mem⟩) P₀ = E.L.one t₀ := by
      rw [← h0]
      apply Subtype.ext
      show P₀.1 ≫ E.act ⟨1, hord.one_mem⟩ = P₀.1
      rw [E.act_one hord.one_mem, Category.comp_id]
    obtain ⟨m', hm'⟩ := (hann ⟨1, hord.one_mem⟩).mp h1
    exact one_ne_natCast_mul hord p hp.two_le m' hm'

  by_contra hk1
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  ·
    subst hk0
    obtain ⟨P₀, -, hne⟩ := hpt 2 Nat.prime_two
    exact hne (hkill P₀ rfl)
  ·
    have hk2 : 2 ≤ k := by omega
    obtain ⟨p, hp, hpk⟩ := Nat.exists_prime_and_dvd (show k ≠ 1 from hk1)
    obtain ⟨P₀, hP₀, hne⟩ := hpt p hp
    apply hne
    apply hkill
    obtain ⟨c, rfl⟩ := hpk
    rw [hpow] at hP₀ ⊢
    rw [pow_mul, hP₀]
    exact one_pow c

end S_CerednikDrinfeld_QM_FakeEllipticCurve_eq_one_of_isIso_of_forall_mapPt_eq_nsmulPt
