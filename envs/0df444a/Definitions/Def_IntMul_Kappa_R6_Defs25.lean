-- Source module: Solutions.R6CxNetSeg
/-!
# Chaining the kernel label checks of the two stage programs

`stage1Seg` / `stage2Seg`: the checked programs `specs1 dat` / `specs2 dat` from the snapshot
states `S1_0` / `S2_0` are valid (`progChk … = true`), with the summed packed histograms and move
counts, ending in `S1_14` / `S2_14`.
-/

set_option maxRecDepth 100000
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetSeg

open NetBT NetLoc NetSpec NetFast NetRaw NetData NetEff

variable {nl : ℕ} {mvOK : ℕ → ℕ → ℕ → Bool} {wd : ℕ → ℕ → ℕ → ℕ}

/-- A checked segment from `t` to `t'` with packed histogram `H` and move count `C`. -/
def Seg (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) (ss : List Spec) (t t' : BT)
    (H C : ℕ) : Prop :=
  (progChk nl mvOK wd ss t).1 = true ∧ (progChk nl mvOK wd ss t).2.1 = H ∧
    (progChk nl mvOK wd ss t).2.2.1 = C ∧ (progRun ss t).2 = t'

end IntMul.Kappa.R6.Cx.NetSeg

end

section
-- Source module: Solutions.R6CxNetChkI
/-!
# Kernel checks of the boundary states and of the triple data

* `chkW`: the snapshot trees are well formed;
* `chkI1` / `chkI2`: the initial snapshots hold `init1` / `init2`;
* `chkF1` / `chkF2`: the final codes of the `x`, `y`, `a` wires;
* `chkTV`: every triple mask has three bits and its line code is `psp a b {c}` with `{a,b,c}` the triple;
* `chkG`: every gate has an input.
-/

set_option Elab.async false

namespace IntMul.Kappa.R6.Cx.NetData

open NetBT NetLoc NetSpec NetFast NetRaw NetMask

/-- `f i` for all `i < n` (recursor form). -/
def allN (f : ℕ → Bool) (n : ℕ) : Bool := Nat.rec (motive := fun _ => Bool) true (fun i ih => f i && ih) n

/-- Final codes of stage one: `x ↦ ⊤`, `y_S ↦ perp t_S`, `a ↦ ⊤`. -/
def fin1 (w : ℕ) : ℕ :=
  cond (Nat.blt w NV) TOPC (cond (Nat.blt w (2 * NV)) (perpC (dat.tv (w - NV))) TOPC)

/-- Final codes of stage two: `x_b ↦ ⟨t_b⟩`, `y ↦ ⊥`, `a ↦ ⊥`. -/
def fin2 (w : ℕ) : ℕ := cond (Nat.blt w NV) (dat.lc w) 0

/-- The line code of triple `t`: `psp a b C` with `C` one bit, `a, b ∉ C`, and the triple mask is
`2^a ||| 2^b ||| C`. -/
def lineOK (t : ℕ) : Bool :=
  let c := dat.lc t
  let a := Nat.mod (Nat.div c 4) 32
  let b := Nat.mod (Nat.div c 128) 32
  let C := Nat.div c 4096
  Nat.beq (Nat.mod c 4) 1 && Nat.blt a 24 && Nat.blt b 24 && !(Nat.beq a b) && Nat.beq (pcR C) 1 &&
    !(Nat.testBit C a) && !(Nat.testBit C b) &&
    Nat.beq (dat.tv t) (Nat.lor (Nat.lor (Nat.pow 2 a) (Nat.pow 2 b)) C)

end IntMul.Kappa.R6.Cx.NetData

end

