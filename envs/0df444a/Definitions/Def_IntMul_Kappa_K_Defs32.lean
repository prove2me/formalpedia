set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Reading pushed assignments -/

/-! ## Level registers -/

/-- The registers of a level call. -/
structure LevR (σ : Fin HS → Option ℤ) (K t S0 r H k e B : ℕ) : Prop where
  off : OffG σ
  offp : ∀ i ∈ NLogN.KFW.pT, σ i = none
  lt : ∀ i v, σ i = some v → i.val < 56
  hK : σ vK = some (K : ℤ)
  ht : σ NLogN.KFW.vT = some (t : ℤ)
  hS : σ vS = some (S0 : ℤ)
  hr : σ vR = some (r : ℤ)
  hH : σ vH = some (H : ℤ)
  hk : σ vk = some (k : ℤ)
  hF : σ vF = some ((mC ^ k : ℕ) : ℤ)
  hE : σ NLogN.KFW.vE = some (e : ℤ)
  hB : σ NLogN.KFW.vB = some (B : ℤ)
  hX : σ NLogN.KFW.vX = some ((ES k : ℕ) : ℤ)

/-- The child frame values. -/
noncomputable def childL (K k e Bn h : ℕ) : List (Fin HS × ℤ) :=
  [(vk, (k : ℤ)), (vF, ((mC ^ k : ℕ) : ℤ)), (NLogN.KFW.vE, ((e - h * (K * mC ^ k) : ℕ) : ℤ)),
    (NLogN.KFW.vB, (Bn : ℤ)), (NLogN.KFW.vX, ((ES k : ℕ) : ℤ))]

/-- The assignment inside a child call. -/
noncomputable def σChild (σ : Fin HS → Option ℤ) (K k e Bn h : ℕ) : Fin HS → Option ℤ :=
  σPush σ (childL K k e Bn h)

/-! ## Phase-pass registers and the `ZD` pass -/

/-- The registers of a phase pass on bits `e - K i`, `i < F`. -/
structure PhR (σ : Fin HS → Option ℤ) (K t S0 r e F Bn : ℕ) : Prop where
  offp : ∀ i ∈ NLogN.KFW.pT, σ i = none
  lt : ∀ i v, σ i = some v → i.val < 56
  hK : σ vK = some (K : ℤ)
  ht : σ NLogN.KFW.vT = some (t : ℤ)
  hE : σ NLogN.KFW.vE = some (e : ℤ)
  hF : σ vF = some (F : ℤ)
  gR0 : σ wR0 = some ((S0 * r : ℕ) : ℤ)
  gB : σ NLogN.KFW.wB = some (Bn : ℤ)
  gV : σ wV = some ((2 * (Bn * (S0 * r * 2 ^ t)) : ℕ) : ℤ)

/-- Cost of a `ZD`-type pass. -/
def cPhZ (Z Bu : ℕ) (Bn t S0 r : ℕ) (x : ℕ) : ℕ :=
  (5 * 10 ^ 7 * (Bu + 2) ^ 2 + (2 * moveCost Bu + 19) + 1) +
    cPhU x (Bn * (S0 * r * 2 ^ t)) t Bn Z (S0 * r) (xPh (εLit NLogN.KFW.vE vK vF ((2 % 4 : ℕ) : ℤ)) Z Z) +
    (1 * (2 * Bu + 2) + 1)

section Steps

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}

/-- Cost of the code of a child step (inside the frame). -/
def cChildF (cIH cZ : ℕ → ℕ) (DWc : ℕ) (fwd : Bool) (x : ℕ) : ℕ :=
  if fwd then cIH x + 2 else cZ x + (cIH x + 2) + cZ (x + DWc)

end Steps

end NLogN.KFW

