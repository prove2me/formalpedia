variable {m : ℕ}

theorem framesOK_toCircuit {R : Type*} [CommRing R] {W : ℕ} (Qc : QCircuit R m W)
    (Pr : IMat m → Prop)
    (h : ∀ X : IMat m, (Qc.den : ℚ)⁻¹ • ratM X ∈ (frameMS Qc.gates Qc.Min Qc.Mout).toFinset → Pr X)
    (Q : ℕ) : FramesOK Pr (Qc.toCircuit Q).gates (Qc.toCircuit Q).Min (Qc.toCircuit Q).Mout := by
  set S := (frameMS Qc.gates Qc.Min Qc.Mout).toFinset
  have hFS : FramesOK2 (fun a b => a - b ∈ S) Qc.gates Qc.Min Qc.Mout :=
    (framesOK_iff2 _ _ _ _).1 (framesOK_of_mem (fun A => A ∈ S) _ _ _
      fun a ha => Multiset.mem_toFinset.2 ha)
  rw [framesOK_iff2]
  change FramesOK2 _ (mapG (intM Qc.den) Qc.gates) (fun w => intM Qc.den (Qc.Min w))
    (fun w => intM Qc.den (Qc.Mout w))
  apply framesOK2_mapG
  refine framesOK2_mono (fun a b hab => ?_) _ _ _ (framesOK2_and _ _ _ Qc.framesOK2_labOK hFS)
  apply h
  have hD : (Qc.den : ℚ) ≠ 0 := by exact_mod_cast Qc.den_pos.ne'
  rw [intM_sub hab.1.1 hab.1.2, smul_smul, inv_mul_cancel₀ hD, one_smul]
  exact hab.2

theorem subBnd_of {N Bb : ℕ} (h : zsz ((8 * (N + 1) ^ 2 : ℕ) : ℤ) ≤ Bb) : SubBnd N Bb := by
  refine ⟨le_trans (NLogN.KIL.zsz_nat_le ?_) h, le_trans (NLogN.KIL.zsz_nat_le ?_) h, le_trans (NLogN.KIL.zsz_nat_le ?_) h⟩ <;>
    simp [ctrlBnd] <;> nlinarith [Nat.zero_le ((N + 1) ^ 2)]

namespace QStep

theorem isSw_rev : ∀ s : QStep m, s.rev.isSw = s.isSw
  | .sh _ _ _ => rfl
  | .sw _ _ => rfl

end QStep

theorem swN_map_tpl : ∀ l : List (QStep m), swN (l.map QStep.tpl) = l.countP QStep.isSw
  | [] => rfl
  | .sh _ _ _ :: l => by
      simp only [List.map_cons, QStep.tpl, swN, List.countP_cons, QStep.isSw, swN_map_tpl l]; simp
  | .sw _ _ :: l => by
      simp only [List.map_cons, QStep.tpl, swN, List.countP_cons, QStep.isSw, swN_map_tpl l]; simp

theorem countP_revQ (l : List (QStep m)) : (revQ l).countP QStep.isSw = l.countP QStep.isSw := by
  simp only [revQ, List.countP_reverse, List.countP_map]
  congr 1
  funext s; simp [QStep.isSw_rev]

theorem countP_hQ (E : QMat m) : (hQ E).countP QStep.isSw = 0 := by
  simp [hQ, List.countP_eq_zero, QStep.isSw]

theorem countP_dQ (E : QMat m) : (dQ E).countP QStep.isSw = 0 := by
  simp [dQ, List.countP_eq_zero, QStep.isSw]

theorem countP_addQ (ps : List (Fin m × Fin m)) : (addQ ps).countP QStep.isSw = ps.length := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    simp only [addQ, List.flatMap_cons, List.countP_append] at ih ⊢
    rw [ih]
    simp only [pivotQ, List.countP_cons, List.countP_nil, QStep.isSw, List.length_cons]
    simp; omega

theorem length_pivotsZ (P : IMat m) :
    (pivotsZ P).length = (Finset.univ.filter fun p : Fin m × Fin m => P p.1 p.2 = 1).card := by
  unfold pivotsZ
  have hnd : ((List.finRange m ×ˢ List.finRange m).filter fun p => P p.1 p.2 = 1).Nodup :=
    List.Nodup.filter _ (List.Nodup.product (List.nodup_finRange m) (List.nodup_finRange m))
  rw [← List.toFinset_card_of_nodup hnd]
  congr 1
  ext p
  simp only [List.mem_toFinset, List.mem_filter, List.mem_product, List.mem_finRange,
    Finset.mem_filter, Finset.mem_univ, true_and, and_self, decide_eq_true_eq]
  exact ⟨fun h => h.2, fun h => ⟨List.mem_product.2 ⟨List.mem_finRange _, List.mem_finRange _⟩, h⟩⟩

theorem swN_edgeTplQ {R : Type*} [CommRing R] {W : ℕ} (Qc : QCircuit R m W) (X : IMat m) :
    swN (edgeTplQ Qc X) = ((Qc.den : ℚ)⁻¹ • ratM X).rank := by
  simp only [edgeTplQ]
  rw [swN_map_tpl, shearQ]
  simp only [List.countP_append, countP_revQ, countP_hQ, countP_dQ, countP_addQ, zero_add,
    add_zero, length_pivotsZ]
  exact card_piQ _

theorem SWn_toCircuit_eq {W : ℕ} [NeZero W] (Qc : QCircuit (ZMod 2) m W) (Q : ℕ) :
    SWn (Qc.toCircuit Q) (edgeTplQ Qc) = frameSum (fun A => A.rank) Qc.gates Qc.Min Qc.Mout := by
  rw [← QCircuit.rankSum_toCircuit Qc Q]
  unfold SWn rankSum
  congr 1
  funext X
  rw [swN_edgeTplQ, QCircuit.pivRank_toCircuit]

end NLogN.KIL

end

