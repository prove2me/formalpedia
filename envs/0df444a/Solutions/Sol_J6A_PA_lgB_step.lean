/-! ## The loops -/

section loops
variable {W : ℕ}

theorem pow_le_W {k m W : ℕ} (hk : k ≤ m) (hmW : m ≤ W) : |(2 : ℤ) ^ k| ≤ 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]
  exact pow_le_pow_right₀ (by norm_num) (by omega)

