theorem ModularCurve.FullLevel.apply_eq_cyclicQuotientJ_of_classify_eq_jqNModC_of_tatePoint_gamma0Pow
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
