open MeasureTheory





variable {alpha : Type*} [TopologicalSpace alpha]













open MarkovProcess.ContinuousPath in
@[simp]

theorem MarkovProcess.ContinuousPath.coordinateProcess_apply (t : NNReal) (omega : ContinuousPath alpha) :
    coordinateProcess t omega = omega t := by sorry
