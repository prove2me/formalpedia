    exact hrec.2.2.2 _ hTm ((Polynomial.natDegree_taylor B _).trans hBn)
  have htrans : ∀ τ, TypeDensity.HasPolynomialTypeF (AdjoinRoot Φ)
      (B.map (algebraMap _ (TypeDensity.BaseField (AdjoinRoot Φ)))) τ ↔
      TypeDensity.HasPolynomialTypeF (AdjoinRoot Φ) (TypeDensity.monicPolynomial (AdjoinRoot Φ) (TypeDensity.pointChart O Φ r a)) τ :=
