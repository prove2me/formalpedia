open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}
theorem lv_all_aux (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    ∀ k, NLogN.KFN.Lv Isym iprog K W m r Z Ψ k (NLogN.KFN.Eb J.net.length s k) (NLogN.KFN.DWb J.net.length s W A k)
      (NLogN.KFN.Whb J.net.length s W A k) (NLogN.KFN.cb J.net.length s W A m CR τ k) ∧
      0 ≤ NLogN.KFN.cb J.net.length s W A m CR τ k 
  | 0 => ⟨NLogN.KFN.lv_zero hr hZΨ, by simp [NLogN.KFN.cb]⟩
  | k + 1 => by
    obtain ⟨IH, hc⟩ := lv_all_aux hGc hrow hCR hτ hW hr hΨm hZΨ k
    refine ⟨NLogN.KFN.lv_succ J hGc hrow hCR hτ hW hr hΨm hZΨ hc IH, ?_⟩
    simp only [NLogN.KFN.cb]
    have : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
    positivity

theorem solution (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) :
    ∀ k, NLogN.KFN.Lv Isym iprog K W m r Z Ψ k (NLogN.KFN.Eb J.net.length s k) (NLogN.KFN.DWb J.net.length s W A k)
      (NLogN.KFN.Whb J.net.length s W A k) (NLogN.KFN.cb J.net.length s W A m CR τ k) ∧
      0 ≤ NLogN.KFN.cb J.net.length s W A m CR τ k := by
  first
  | exact lv_all_aux
  | (intros; apply lv_all_aux <;> assumption)
end
