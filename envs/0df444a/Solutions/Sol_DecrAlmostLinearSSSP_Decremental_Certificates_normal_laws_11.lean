    t.realMem address = s.realMem address ∧ t.natMem address = s.natMem address := by
  let u : Data := {s with natReg := Function.update (Function.update s.natReg 2 (g.pc+1)) 3 (s.natReg 3+1)}
  have hu : Eval (.seq (natural 2 (g.pc+1)) (nadd 3 3 1)) s 2 u := by
    simpa only [h1] using eval_shadow_header s g.pc
  cases he with
  | seq hhead haction =>
    obtain ⟨_,rfl⟩ := hhead.deterministic hu
    have hu0 : u.natReg 0 = B := by simp [u,hb]
    have hu7 : u.natReg 7 = F := by simp [u,hf]
    have hu1 : u.natReg 1 = 1 := by simp [u,h1]
    have hu14 : u.natReg 14 = 2 := by simp [u,h14]
    have huptr : address ≠ u.natReg 10 := by simpa [u] using hreport
    exact observedAction_memory_frame (h.header h1) hu0 hu7 hu1 hu14 ins _ haction address hout huptr
lemma observedDispatchAux_memory_frame {B F : ℕ} (code : List Instruction) (pc : ℕ)
    (s t : Data) (g : Machine) (h : ShadowDataRep B F s g)
    (hb : s.natReg 0 = B) (hf : s.natReg 7 = F) (h1 : s.natReg 1 = 1) (h14 : s.natReg 14 = 2)
    (hpc : pc ≤ g.pc) (ins : Instruction) (hins : code[g.pc-pc]? = some ins)
    (cost : ℕ) (he : Eval (observedDispatchAux pc code) s cost t)
    (address : ℕ) (hout : ∀ a, address ≠ B+F*(2*a+1)) (hreport : address ≠ s.natReg 10) :
    t.realMem address = s.realMem address ∧ t.natMem address = s.natMem address := by
  induction code generalizing pc s cost with
  | nil => simp at hins
  | cons head rest ih =>
    let u : Data := {s with natReg := Function.update s.natReg 8 (pc+1)}
    have hu := eval_natural s 8 (pc+1)
    cases he with
    | seq hnat hbranch =>
      obtain ⟨_,rfl⟩ := hnat.deterministic hu
      have huRep : ShadowDataRep B F u g := h.scratch8 (pc+1)
      have hu0 : u.natReg 0 = B := by simp [u,hb]
      have hu7 : u.natReg 7 = F := by simp [u,hf]
      have hu1 : u.natReg 1 = 1 := by simp [u,h1]
      have hu14 : u.natReg 14 = 2 := by simp [u,h14]
      have huptr : address ≠ u.natReg 10 := by simpa [u] using hreport
      by_cases hp : g.pc = pc
      · have hins' : head = ins := by simpa only [hp,Nat.sub_self,List.getElem?_cons_zero,Option.some.injEq] using hins
        have htest : (Test.natLess 2 8).holds u := by
          change u.natReg 2 < u.natReg 8
          simp only [u,Function.update_self,Function.update_of_ne (by decide : (2 : ℕ) ≠ 8)]
          have hh : s.natReg 2 = g.pc := h.pc
          omega
        cases hbranch with
        | @branchYes _ _ _ _ _ amount ht hbody =>
          have hbody' : Eval (observedInstruction g.pc head) u amount t := by simpa only [hp] using hbody
          exact observedInstruction_memory_frame huRep hu0 hu7 hu1 hu14 head _ hbody' address hout huptr
        | branchNo ht hbody => exact False.elim (ht htest)
      · have hnext : pc+1 ≤ g.pc := by omega
        have hidx : g.pc-pc = (g.pc-(pc+1))+1 := by omega
        have htail : rest[g.pc-(pc+1)]? = some ins := by simpa only [hidx,List.getElem?_cons_succ] using hins
        have htest : ¬(Test.natLess 2 8).holds u := by
          change ¬u.natReg 2 < u.natReg 8
          simp only [u,Function.update_self,Function.update_of_ne (by decide : (2 : ℕ) ≠ 8)]
          have hh : s.natReg 2 = g.pc := h.pc
          omega
        cases hbranch with
        | branchYes ht hbody => exact False.elim (htest ht)
        | branchNo ht hbody => exact ih (pc+1) u huRep hu0 hu7 hu1 hu14 hnext htail _ hbody huptr
end DecrAlmostLinearSSSP.Decremental
end s260
section s261
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental
open Structured
lemma observed_interpreter_memory_frame (guest : Program) (steps : ℕ) (B bank start : ℕ)
    (s u : Data) (g : Machine) (h : ShadowDataRep B (bankFactor bank) s g) (hb : s.natReg 0 = B)
    (h1 : s.natReg 1 = 1) (hf : s.natReg 7 = bankFactor bank)
    (hrf : s.realReg 7 = (bankFactor bank : ℝ)) (h14 : s.natReg 14 = 2)
    (reports : List ℕ) (hl : ReportLog start reports s) (hstart : ∃ r, start = B+2*r+1)
    (hflag : s.natReg 4 ≤ 1)
    (hvalid : ∀ j < steps, (execute guest g j).halted = false → ∃ ins, guest.code[(execute guest g j).pc]? = some ins)
    (hfinal : (execute guest g steps).halted = true)
    (cost : ℕ) (he : Eval (observedInterpreter guest.code) s cost u)
    (address : ℕ) (hout : ∀ a, address ≠ B+bankFactor bank*(2*a+1))
    (havoid : ∀ j ≤ reports.length+(physicalTraceWrites B bank guest g steps).length, address ≠ start+2*j) :
    u.realMem address = s.realMem address ∧ u.natMem address = s.natMem address := by
  induction steps generalizing s u g reports cost with
  | zero =>
    have hgh : g.halted = true := hfinal
    have hs := h.halt_flag hflag
    have htest : ¬(Test.natLess 4 1).holds s := by simp [Test.holds,hs,hgh,h1]
    obtain ⟨_,rfl⟩ := he.deterministic (show Eval (observedInterpreter guest.code) s 2 s from Eval.loopNo s htest)
    exact ⟨rfl,rfl⟩
  | succ steps ih =>
    by_cases hgh : g.halted = true
    · have hs := h.halt_flag hflag
      have htest : ¬(Test.natLess 4 1).holds s := by simp [Test.holds,hs,hgh,h1]
      obtain ⟨_,rfl⟩ := he.deterministic (show Eval (observedInterpreter guest.code) s 2 s from Eval.loopNo s htest)
      exact ⟨rfl,rfl⟩
    · have hgh' : g.halted = false := Bool.eq_false_iff.mpr hgh
      obtain ⟨ins,hins⟩ := hvalid 0 (by omega) hgh'
      have hins' : guest.code[g.pc]? = some ins := by simpa [execute] using hins
      obtain ⟨first,t,hbody,hfirst,hrep,hlog⟩ := eval_observed_dispatch_aux guest.code 0 s g h hb h1 hf hrf h14
        reports hl hstart (Nat.zero_le _) ins (by simpa only [Nat.sub_zero] using hins')
      have hptr : address ≠ s.natReg 10 := by
        rw [hl.1]
        exact havoid reports.length (Nat.le_add_right _ _)
      have hbodyMem := observedDispatchAux_memory_frame guest.code 0 s t g h hb hf h1 h14
        (Nat.zero_le _) ins (by simpa only [Nat.sub_zero] using hins') first hbody address hout hptr
      rw [← step_eq_effect guest g ins hgh' hins'] at hrep
      have ht0 : t.natReg 0 = B := (hbody.nat_frame (observedDispatchAux_nat_frame _ _ 0 (Or.inl rfl))).trans hb
      have ht1 : t.natReg 1 = 1 := (hbody.nat_frame (observedDispatchAux_nat_frame _ _ 1 (Or.inr (Or.inl rfl)))).trans h1
      have ht7 : t.natReg 7 = bankFactor bank := (hbody.nat_frame (observedDispatchAux_nat_frame _ _ 7 (Or.inr (Or.inr rfl)))).trans hf
      have htr7 : t.realReg 7 = (bankFactor bank : ℝ) := (hbody.real_frame (observedDispatchAux_real_frame _ _)).trans hrf
      have ht14 : t.natReg 14 = 2 := (hbody.nat_frame (observedDispatchAux_nat14_frame _ _)).trans h14
      have htflag : t.natReg 4 ≤ 1 := hbody.flag_bound (observedDispatchAux_flag_frame _ _) hflag
      have hv : ∀ j < steps, (execute guest (step guest g) j).halted = false → ∃ ins, guest.code[(execute guest (step guest g) j).pc]? = some ins := by
        intro j hj hh
        rw [← execute_succ_front] at hh ⊢
        exact hvalid (j+1) (by omega) hh
      have hfin : (execute guest (step guest g) steps).halted = true := by rwa [← execute_succ_front]
      obtain ⟨rest,v,hrest,_,_,_⟩ := eval_observed_interpreter guest steps B bank start t (step guest g) hrep
        ht0 ht1 ht7 htr7 ht14 (reports++physicalWrites B bank ins g) hlog hstart htflag hv hfin
      have hlen : reports.length+(physicalTraceWrites B bank guest g (steps+1)).length =
          (reports++physicalWrites B bank ins g).length+(physicalTraceWrites B bank guest (step guest g) steps).length := by
        simp [physicalTraceWrites,hgh',hins',List.length_append,Nat.add_assoc]
      have htailAvoid : ∀ j ≤ (reports++physicalWrites B bank ins g).length+
          (physicalTraceWrites B bank guest (step guest g) steps).length, address ≠ start+2*j := by
        intro j hj
        apply havoid j
        rwa [hlen]
      have hrestMem := ih t v (step guest g) hrep ht0 ht1 ht7 htr7 ht14
        (reports++physicalWrites B bank ins g) hlog htflag hv hfin rest hrest htailAvoid
      have hs := h.halt_flag hflag
      have htest : (Test.natLess 4 1).holds s := by simp [Test.holds,hs,hgh',h1]
      have hcombined : Eval (observedInterpreter guest.code) s (first+rest+2) v := Eval.loopYes htest hbody hrest
      obtain ⟨_,rfl⟩ := he.deterministic hcombined
      exact ⟨hrestMem.1.trans hbodyMem.1,hrestMem.2.trans hbodyMem.2⟩
end DecrAlmostLinearSSSP.Decremental
end s261
section s262
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental
open Structured
lemma eval_observed_call (guest : Program) (B bank start : ℕ)
    (s : Data) (g final : Machine) (h : ShadowDataRep B (bankFactor bank) s g) (hb : s.natReg 0 = B)
    (h1 : s.natReg 1 = 1) (hf : s.natReg 7 = bankFactor bank)
    (hrf : s.realReg 7 = (bankFactor bank : ℝ)) (h14 : s.natReg 14 = 2)
    (reports : List ℕ) (hl : ReportLog start reports s) (hstart : ∃ r, start = B+2*r+1)
    (hflag : s.natReg 4 ≤ 1) (he : Ends guest g final) :
    ∃ cost u t, Eval (observedInterpreter guest.code) s cost u ∧ execute guest g t = final ∧
      t = final.work-g.work ∧ cost ≤ (observedDispatchCharge guest.code+2)*(final.work-g.work)+2 ∧
      ShadowDataRep B (bankFactor bank) u final ∧
      ReportLog start (reports++physicalTraceWrites B bank guest g t) u ∧
      ∀ address, (∀ a, address ≠ B+bankFactor bank*(2*a+1)) →
        (∀ j ≤ reports.length+(final.work-g.work), address ≠ start+2*j) →
        u.realMem address = s.realMem address ∧ u.natMem address = s.natMem address := by
  obtain ⟨cost,u,t,hu,ht,hcost,hrep,hlog,htime⟩ := eval_observed_interpreter_ends guest B bank start s g final
    h hb h1 hf hrf h14 reports hl hstart hflag he
  have hfh : final.halted = true := by obtain ⟨_,_,hh,_⟩ := he;exact hh
  have hff : final.fault = false := by obtain ⟨_,_,_,hh⟩ := he;exact hh
  refine ⟨cost,u,t,hu,ht,htime,hcost,hrep,hlog,?_⟩
  intro address hout havoid
  apply observed_interpreter_memory_frame guest t B bank start s u g h hb h1 hf hrf h14 reports hl hstart hflag
    (execution_valid_code guest g t (by rwa [ht])) (by rwa [ht]) cost hu address hout
  intro j hj
  apply havoid j
  have hlen : (physicalTraceWrites B bank guest g t).length ≤ final.work-g.work :=
    (physicalTraceWrites_length B bank guest g t).trans_eq htime
  omega
lemma other_bank_outside (B bank other a : ℕ) (hne : other ≠ bank) :
    ∀ b, B+bankFactor other*(2*a+1) ≠ B+bankFactor bank*(2*b+1) := by
  intro b heq
  have hh : bankAddress B other a = bankAddress B bank b := heq
  exact hne (bankAddress_injective hh).1
lemma other_bank_avoids_reports (B other a start : ℕ) (hstart : ∃ r, start = B+2*r+1) :
    ∀ j, B+bankFactor other*(2*a+1) ≠ start+2*j := by
  obtain ⟨r,rfl⟩ := hstart
  intro j
  have hh : B+2*r+1+2*j = B+(2*(r+j)+1) := by ring
  rw [hh]
  exact guest_bank_ne_host B other a (r+j)
lemma prefix_outside_guest_reports (B bank start address : ℕ) (ha : address ≤ B)
    (hstart : ∃ r, start = B+2*r+1) :
    (∀ a, address ≠ B+bankFactor bank*(2*a+1)) ∧ (∀ j, address ≠ start+2*j) := by
  refine ⟨?_,?_⟩
  · intro a heq
    have hh := guest_bank_above B bank a
    change B < B+bankFactor bank*(2*a+1) at hh
    omega
  · obtain ⟨r,rfl⟩ := hstart
    intro j
    omega
lemma odd_record_outside_guest_reports (B bank start address : ℕ)
    (hodd : ∃ a, address = B+2*a+1) (hbefore : address < start) :
    (∀ a, address ≠ B+bankFactor bank*(2*a+1)) ∧ (∀ j, address ≠ start+2*j) := by
  refine ⟨?_,?_⟩
  · obtain ⟨r,rfl⟩ := hodd
    intro a
    exact Ne.symm (guest_bank_ne_host B bank a r)
  · intro j
    omega
end DecrAlmostLinearSSSP.Decremental
end s262
section s263
set_option autoImplicit false
set_option maxRecDepth 10000
namespace DecrAlmostLinearSSSP.Decremental.ObservedSourceCall
open Structured
lemma action_nat_frame (ins : Instruction) (k : ℕ) (hk : 14 < k) (hev : Even k) :
    NatFrame (observedAction ins) k := by
  have ha := shadowAction_even_frame ins k (by omega) hev
  have hp := appendStoreReport_nat_frame k (by omega) (by omega)
  cases ins <;> first | exact ha | exact ⟨ha,hp⟩
lemma instruction_nat_frame (pc : ℕ) (ins : Instruction) (k : ℕ) (hk : 14 < k) (hev : Even k) :
    NatFrame (observedInstruction pc ins) k := by
  refine ⟨⟨?_,?_⟩,action_nat_frame ins k hk hev⟩ <;>
    norm_num [NatFrame,Structured.natural,nadd,writesNat] <;> omega
lemma dispatch_nat_frame (xs : List Instruction) (pc k : ℕ) (hk : 14 < k) (hev : Even k) :
    NatFrame (observedDispatchAux pc xs) k := by
  induction xs generalizing pc with
  | nil => simp [observedDispatchAux,NatFrame,Structured.natural,writesNat];omega
  | cons ins rest ih =>
    exact ⟨by norm_num [NatFrame,Structured.natural,writesNat];omega,
      instruction_nat_frame pc ins k hk hev,ih (pc+1)⟩
lemma observed_nat_frame (p : Program) (k : ℕ) (hk : 14 < k) (hev : Even k) :
    NatFrame (observedInterpreter p.code) k := dispatch_nat_frame _ _ k hk hev
lemma eval_code (N entry B bank start : ℕ) (s : Data) (p : Program) (g final : Machine)
    (hB : s.natReg 74 = B) (hF : s.natReg 112 = bankFactor bank) (hz : s.natReg 56 = 0)
    (hentry : g.pc = entry) (hwork : s.natMem (s.natReg 106+6) = g.work)
    (hhalt : g.halted = false) (hfault : g.fault = false)
    (hmr : ∀ a, s.realMem (B+bankFactor bank*(2*a+1)) = g.realMem a)
    (hmn : ∀ a, s.natMem (B+bankFactor bank*(2*a+1)) = bankFactor bank*g.natMem a)
    (hsaved : ∀ j < N, s.natMem (s.natReg 50+2*j) = bankFactor bank*g.natReg j ∧
      s.realMem (s.natReg 50+2*j) = g.realReg j)
    (htail : ∀ j, N ≤ j → s.natReg (shadowReg j) = 0 ∧ s.realReg (shadowReg j) = 0)
    (hgtail : ZeroRegisterTail N g) (he : Ends p g final)
    (h14 : s.natReg 14 = 2) (hl : ReportLog start [] s) (hstart : ∃ r, start = B+2*r+1) :
    ∃ (cost steps : ℕ) (t : Data), Eval (code N entry p) s cost t ∧ execute p g steps = final ∧
      steps = final.work-g.work ∧ cost ≤ (observedDispatchCharge p.code+2)*(final.work-g.work)+4*N+12 ∧
      ShadowDataRep B (bankFactor bank) t final ∧ ReportLog start (physicalTraceWrites B bank p g steps) t ∧
      ∀ address, (∀ a, address ≠ B+bankFactor bank*(2*a+1)) →
        (∀ j ≤ final.work-g.work, address ≠ start+2*j) →
        t.realMem address = s.realMem address ∧ t.natMem address = s.natMem address := by
  obtain ⟨a,ha,harep,ha0,ha1,ha7,har7,ha4,hamr,hamn⟩ := SourceSetup.eval_code N entry B (bankFactor bank) s g
    hB hF hz hentry hwork hhalt hfault hmr hmn hsaved htail hgtail
  have ha14 : a.natReg 14 = 2 := (ha.nat_frame
    (SourceSetup.nat_even_frame N entry 14 (by omega) (by decide) (by omega) (by omega))).trans h14
  have halog : ReportLog start [] a := by
    rcases hl with ⟨hptr,hcount,hentries⟩
    refine ⟨?_,?_,?_⟩
    · rw [ha.nat_frame (SourceSetup.nat_even_frame N entry 10 (by omega) (by decide) (by omega) (by omega))]
      exact hptr
    · rw [ha.nat_frame (SourceSetup.nat_even_frame N entry 12 (by omega) (by decide) (by omega) (by omega))]
      exact hcount
    · simpa using hentries
  obtain ⟨c,t,steps,ht,hsteps,htime,hcost,htrep,htlog,htframe⟩ :=
    eval_observed_call p B bank start a g final harep ha0 ha1 ha7 har7 ha14 [] halog hstart (by omega) he
  refine ⟨(10+4*N)+c,steps,t,Eval.seq ha ht,hsteps,htime,by omega,htrep,?_,?_⟩
  · simpa only [List.nil_append] using htlog
  · intro address hout hreport
    have hh := htframe address hout (by simpa only [List.length_nil,Nat.zero_add] using hreport)
    exact ⟨hh.1.trans (congrFun hamr address),hh.2.trans (congrFun hamn address)⟩
end DecrAlmostLinearSSSP.Decremental.ObservedSourceCall
end s263
