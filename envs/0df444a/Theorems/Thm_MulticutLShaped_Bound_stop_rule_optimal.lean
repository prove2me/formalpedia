-- title:
--   Section 3 — if (14) holds for no k, x^ν is optimal
-- statement:
--   Assume every scenario has positive probability, $p_k>0$. Consider a state reached by the multicut algorithm, an optimal solution $(x^\nu,\theta^\nu)$ of its master (11)–(13) for which every Step 2 feasibility LP has value $w^1=0$, and, for every $k$, a simplex-optimal basis of Problem $k$ of type (7) at $x^\nu$ with multiplier $\pi_k^\nu$. If (14),
--   $$\theta_k^\nu < p_k\,\pi_k^\nu(h_k-T_kx^\nu),$$
--   holds for no $k=1,\dots,K$ (in particular every scenario already has an optimality cut), then $x^\nu\in K_1\cap K_2$ and $x^\nu$ is an optimal solution of the deterministic equivalent (2):
--   $$cx^\nu+\Omega(x^\nu)\ \le\ cx+\Omega(x)\qquad\text{for all } x\in K_1\cap K_2 .$$
--
--   This is the correctness of the multicut algorithm's stopping rule.
--
--   **Formalization Note** $\Omega(x)=\sum_k p_kQ_k(x)$ and $K_2$ are those of the published `StochasticProg_Recourse_Instance`. Reachability supplies the fact that every recorded cut was generated by a simplex-optimal basis, which is what makes the cuts valid.
-- source:
--   Birge and Louveaux, A multicut algorithm for two-stage stochastic linear programs, Eur. J. Oper. Res. 34 (1988), p. 387, Section 3 Step 3

import Mathlib
import Definitions.Def_StochasticProg_Recourse_Instance
import Definitions.Def_StochasticProg_LShaped_Bases
import Definitions.Def_MulticutLShaped_Bound_Cuts
import Definitions.Def_MulticutLShaped_Bound_Masters
import Definitions.Def_MulticutLShaped_Bound_Algorithm

namespace MulticutLShaped.Bound

open StochasticProg.Recourse StochasticProg.LShaped
open scoped Matrix

theorem stop_rule_optimal {n1 n2 m1 m2 K : ℕ} (inst : Instance n1 n2 m1 m2 K)
    (hp : ∀ k, 0 < inst.p k) (s : State n1 K) (hs : Reachable inst s)
    (x : Fin n1 → ℝ) (θ : Fin K → ℝ) (β : Fin K → Basis n2 m2)
    (hopt : IsMasterOptimal inst s x θ) (hfeas : ∀ k, feasLPValue inst k x = 0)
    (hβ : ∀ k, IsSimplexOptimal inst k (β k) x)
    (hstop : ∀ k, ¬ Cond14 inst s x θ k (β k)) :
    x ∈ K1 inst ∧ x ∈ K2 inst ∧ ∀ x' ∈ K1 inst, x' ∈ K2 inst → obj inst x ≤ obj inst x' := by sorry

end MulticutLShaped.Bound
