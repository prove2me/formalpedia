-- title:
--   Theorem 3.3 — every accumulation point of the greedy sparse-simplex method is a coordinate-wise minimum of (P)
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), and let $0<s<n$ be an integer. Consider the sparsity constrained problem
--   $$(\mathrm P)\qquad \min\ f(x)\quad\text{s.t.}\quad \|x\|_0\le s .$$
--   Let $(x^k)_{k\ge0}$ be a sequence generated by the greedy sparse-simplex method. Then every accumulation point $x^*$ of $(x^k)$ is a coordinate-wise minimum of (P) (Definition 2.4): $x^*\in C_s$, and
--
--   1. if $\|x^*\|_0<s$, then $f(x^*)\le f(x^*+te_i)$ for every $i$ and every $t\in\mathbb R$;
--   2. if $\|x^*\|_0=s$, then $f(x^*)\le f(x^*-x^*_ie_i+te_j)$ for every $i\in I_1(x^*)$, every $j$ and every $t\in\mathbb R$.
--
--   The theorem needs no Lipschitz assumption on $\nabla f$. Combined with Theorem 2.4 (every CW-minimum is an $L_2(f)$-stationary point), it shows that under Assumption 2 the limit points of the method are $L_2(f)$-stationary points (Corollary 3.2), without knowledge of any Lipschitz constant.
--
--   **Formalization Note** A run of the method is any sequence satisfying the step rule, with every choice of minimizers allowed, and a STOP modelled as $x^{k+1}=x^k$; the theorem holds for every run. "Accumulation point" is `MapClusterPt xstar atTop x`. Indices are $0,\dots,n-1$ and $te_i$ is `EuclideanSpace.single i t`.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 19, Theorem 3.3 (proof §4.2.1, pp. 29–30)

import Definitions.Def_SparseNLO_Greedy_Method

open Filter Topology

namespace SparseNLO.Greedy

/-- Theorem 3.3 (p. 19): let `{xᵏ}` be a sequence generated by the greedy sparse-simplex method
for (P), where `f` is continuously differentiable and bounded below (Assumption 1) and
`0 < s < n`. Then every accumulation point of `{xᵏ}` is a CW-minimum of (P). -/
theorem theorem_3_3
    {n s : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x) (hs : 0 < s) (hsn : s < n)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsGreedyRun f s x)
    (xstar : EuclideanSpace ℝ (Fin n)) (hacc : MapClusterPt xstar atTop x) :
    SparseNLO.CWOpt.IsCWMin f s xstar := by sorry

end SparseNLO.Greedy
