theorem blkL2_sp_sol_aux (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {K Cs Cb : Fin HS}
    (hK : K ∉ rg) (hK5 : K.val < 56) (hKC : K ≠ Cu) (hCs : Cs ∉ rg) (hCs5 : Cs.val < 56)
    (hKs : K ≠ Cs) (hCb : Cb ∉ rg) (hCb5 : Cb.val < 56) (hKb : K ≠ Cb) (hbs : Cb ≠ Cs)
    (hbu : Cb ≠ Cu) (hwb : Cb ∉ (blkB2 K Cs).writes)
    (hcs : c Cs = []) (hcu : c Cu = []) (hcb : c Cb = [])
    {P R sN tN lam aN A b q : ℕ}
    (hi : StIn2 v P R sN tN lam aN A) (hPA : P ≤ A) (TB : TabB P R sN tN aN lam A)
    (h28 : v 28 = b) (h4l : 4 * lam ≤ 2 ^ A)
    (h6 : v 6 = q) (hl : 1 ≤ lam) (hsA : sN ≤ 2 ^ A) (hqA : q * lam ≤ 2 ^ A) :
    Sp (blkL2 K Cs Cb)
      (encK s (RF (bS P R sN tN lam aN v (min sN (q * lam + lam)) (q * lam) 0) c))
      (encK s (RF (bS P R sN tN lam aN v (min sN (q * lam + lam)) (q * lam) lam)
        (Function.update c K ((J6Seg.KR.dsEnc2 b
          (J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q)).reverse ++ c K))))
      (cBL2 A lam) := by
  have hA := hi.A2
  set e := min sN (q * lam + lam) with he
  set st0 := q * lam
  have heS : e ≤ sN := min_le_left _ _
  set T := mkTables P R sN tN aN
  set x : ℕ → ℕ := fun k => (bst sN tN lam e)^[k] st0 with hx
  set pr : ℕ → List (ℕ × List ℤ × List ℤ) := fun k => preD P R sN tN lam aN e st0 k with hpr
  have hxs : ∀ k, x k = st0 + J6Seg.KR.sumN (pr k) := fun k => sumN_preD P R sN tN lam aN e st0 k
  have hxle : ∀ k, x k ≤ 2 ^ A := fun k => by
    have := bst_iter_le sN tN lam (st := st0) heS k
    simp only [x]; omega
  have hlen : ∀ k, (pr k).length ≤ k := fun k => by
    simp only [pr, preD, List.length_map]; exact blFrom_len sN tN lam e k st0
  have hsum : ∀ k, J6Seg.KR.sumN (pr k) ≤ 2 ^ A := fun k => by have := hxs k; have := hxle k; omega
  set W : ℕ → Fin HS → ℤ := fun k => bS P R sN tN lam aN v e st0 k with hW
  have Woth : ∀ k j, ¬ Wk j → j ≠ 1 → j ≠ 7 → j ≠ 8 → W k j = v j := by
    intro k j hj a b' c'
    simp only [W, bS]; rw [zr_ne hj, upd_ne c', upd_ne b', upd_ne a]
  have W1 : ∀ k, W k 1 = x k := fun k => by
    simp only [W, bS]; rw [zr_ne (by unfold Wk; decide)]; simp [x]
  have W7 : ∀ k, W k 7 = (pr k).length := fun k => by
    simp only [W, bS]; rw [zr_ne (by unfold Wk; decide)]; simp [pr]
  have W8 : ∀ k, W k 8 = J6Seg.KR.sumN (pr k) := fun k => by
    simp only [W, bS]; rw [zr_ne (by unfold Wk; decide)]; simp [pr]
  have WVB : ∀ k ≤ lam, VB (W k) A := by
    intro k hk
    refine zr_VB (VB_upd (VB_upd (VB_upd hi.vb 1 ?_) 7 ?_) 8 ?_)
    · rw [abs_of_nonneg (by positivity)]; exact_mod_cast hxle k
    · rw [abs_of_nonneg (by positivity)]
      have := hlen k; have := hi.lam
      exact_mod_cast (show (pr k).length ≤ 2 ^ A by omega)
    · rw [abs_of_nonneg (by positivity)]; exact_mod_cast hsum k
  have Wi : ∀ k ≤ lam, StIn2 (W k) P R sN tN lam aN A := fun k hk =>
    hi.of' (WVB k hk) (fun j hj => Woth k j
      (by unfold Wk; rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
      (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
      (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide)
      (by rcases hj with h | h | h | h | h | h | h | h <;> subst h <;> decide))
  set G : ℕ → Fin HS → List ℤ := fun k =>
    RF (W k) (Function.update c K ((J6Seg.KR.dsEnc2 b (pr k)).reverse ++ c K)) with hG
  have hG0 : G 0 = RF (W 0) c := by
    simp only [G, pr, preD, J6Seg.blFrom, List.map_nil]
    congr 1; funext j; by_cases h : j = K
    · subst h; simp [J6Seg.KR.dsEnc2]
    · simp [h]
  have R := Sp.rep (C := Cb) (n := .reg 24) (b := .ite tE (blkB2 K Cs) .skip) (s := s) (F := G)
    (N := lam) (B := BW A) (c := cRnd2 A lam) hCb5
    (fun k => by simp only [G, RF_out hCb, Function.update_of_ne (Ne.symm hKb), hcb])
    (by simp only [RS.writes, List.mem_append, List.not_mem_nil, or_false]; exact hwb)
    (clean_of_inRg (inRg_reg (by decide))) (by rw [hG0]; exact ok_RF (inRg_reg (by decide)) rfl)
    trivial
    (by rw [hG0]; exact bnd_of_mg _ (fun _ => 2 ^ A) (BW A) _ (RF_bnd (inRg_reg (by decide))
      (vb_regs (WVB 0 (by omega)) (inRg_reg (by decide)))) (mgB hA (by decide) (by decide)))
    (by rw [hG0, ev_reg (by decide), Woth 0 24 (by unfold Wk; decide) (by decide) (by decide)
      (by decide), hi.h24])
    (fun k hk => by
      simp only [G, upd_RF_out hCb]
      set cc := Function.update (Function.update c K ((J6Seg.KR.dsEnc2 b (pr k)).reverse ++ c K))
        Cb [(lam : ℤ) - k]
      have hw := WVB k hk.le
      have iT : InRg tE := inRg_of (by decide)
      have evT : tE.eval (encK s (RF (W k) cc)) = (x k : ℤ) - e := by
        simp only [tE, Ex.eval, top_RF (show (1 : Fin HS) ∈ rg by decide), W1,
          eE_eval (s := s) (v := W k) (c := cc) (q := q) (sN := sN) (lam := lam)
            (by rw [Woth k 6 (by unfold Wk; decide) (by decide) (by decide) (by decide), h6])
            (by rw [Woth k 22 (by unfold Wk; decide) (by decide) (by decide) (by decide), hi.h22])
            (by rw [Woth k 24 (by unfold Wk; decide) (by decide) (by decide) (by decide), hi.h24])]
        ring
      have hsucc := blFrom_succ sN tN lam e k st0
      have xsucc : x (k + 1) = bst sN tN lam e (x k) := by
        simp only [x]; rw [Function.iterate_succ_apply']
      by_cases hlt : x k < e
      · -- a block
        have hxs' : x k < sN := lt_of_lt_of_le hlt heS
        have hen := J6Seg.en_le_s (s := sN) (t := tN) (lam := lam) hxs'
        have B := blk2_sp s (W k) cc hK hK5 hKC hCs hCs5 hKs
          (by simp only [cc]; rw [Function.update_of_ne (Ne.symm hbs),
            Function.update_of_ne (Ne.symm hKs), hcs])
          (by simp only [cc]; rw [Function.update_of_ne (Ne.symm hbu),
            Function.update_of_ne hKC.symm, hcu])
          (Wi k hk.le) hPA TB
          (by rw [Woth k 28 (by unfold Wk; decide) (by decide) (by decide) (by decide), h28])
          h4l (W1 k) (W7 k) (W8 k) hl (by omega)
          (by have := hlen k; have := hi.lam; omega)
          (by have := hxs k; omega)
        have I := spIT s (W k) cc iT (ok_RF iT rfl) (vb_regs hw iT) (mgB hA (by decide) (by decide))
          (by rw [evT]; have : (x k : ℤ) < e := by exact_mod_cast hlt
              linarith) (b := .skip) B
        refine (I.congr ?_).mono (by unfold cRnd2; omega)
        have hb' : bAdd sN tN lam e st0 k = [(x k, 1 + J6Seg.enF sN tN lam (x k))] := by
          simp only [bAdd]; rw [if_pos hlt]
        have hpr : pr (k + 1) = pr k ++ [dscOf P R sN tN lam aN (x k)] := by
          simp only [pr, preD]; rw [hsucc, hb', List.map_append]; rfl
        have hx1 : (bst sN tN lam e)^[k + 1] st0 = x k + (1 + J6Seg.enF sN tN lam (x k)) := by
          rw [Function.iterate_succ_apply']
          show bst sN tN lam e (x k) = _
          simp only [bst, if_pos hlt]; omega
        have eW : zr (Function.update (Function.update (Function.update (W k) 1
            ((x k + (1 + J6Seg.enF sN tN lam (x k)) : ℕ) : ℤ)) 7 (((pr k).length + 1 : ℕ) : ℤ)) 8
            ((J6Seg.KR.sumN (pr k) + (1 + J6Seg.enF sN tN lam (x k)) : ℕ) : ℤ)) = W (k + 1) := by
          apply zr_congr
          intro j hj
          have hpr' : preD P R sN tN lam aN e st0 (k + 1) =
              preD P R sN tN lam aN e st0 k ++ [dscOf P R sN tN lam aN (x k)] := hpr
          simp only [W, bS, Function.update_apply, hx1, hpr']
          split_ifs with h8 h7 h1
          · simp [sumN_append, J6Seg.KR.sumN, dscOf, pr]
          · simp [pr]
          · rfl
          · rw [zr_ne hj]; simp [Function.update_apply, h8, h7, h1]
        have eC : Function.update cc K ((J6Seg.KR.encD2 b (dscOf P R sN tN lam aN (x k))).reverse ++
            cc K) = Function.update (Function.update c K ((J6Seg.KR.dsEnc2 b (pr (k + 1))).reverse ++
              c K)) Cb [(lam : ℤ) - k] := by
          funext i
          simp only [cc, Function.update_apply]
          split_ifs with h1 h2 h2
          · exact absurd (h1.symm.trans h2) hKb
          · rw [hpr]
            simp [J6Seg.KR.dsEnc2, List.flatMap_append, List.reverse_append]
          · rfl
          · rfl
        rw [eW, eC]
