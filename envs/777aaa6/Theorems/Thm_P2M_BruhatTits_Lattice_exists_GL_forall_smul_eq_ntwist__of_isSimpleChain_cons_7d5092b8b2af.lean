variable [IsDiscreteValuationRing R] [IsFractionRing R K]

theorem P2M_BruhatTits_Lattice_exists_GL_forall_smul_eq_ntwist__of_isSimpleChain_cons_7d5092b8b2af (l : List (BruhatTits.Lattice R)) (M : BruhatTits.Lattice R)
    (hMl : (M :: l).IsSimpleChain) (b : Basis (Fin 2) K (Fin 2 → K)) (ϖ : R) (hϖ : Irreducible ϖ)
    (hl : l.zipIdx.Forall (fun (L, n) ↦ L = (b.ntwist₂ hϖ (l.length - n - 1) 0).toLattice)) :
    ∃ (g : GL (Fin 2) K), (M :: l).zipIdx.Forall
      (fun (L, n) ↦ g • L = (b.ntwist₂ hϖ (l.length - n) 0).toLattice) := by sorry

