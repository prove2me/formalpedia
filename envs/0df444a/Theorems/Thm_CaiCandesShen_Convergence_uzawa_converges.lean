-- title:
--   Theorem 4.2 (first sentence) — Uzawa's iteration (3.3) converges to the unique solution of (3.1)
-- statement:
--   Let $\tau>0$, let $\mathcal A:\mathbb R^{n_1\times n_2}\to\mathbb R^m$ be linear with spectral norm $\|\mathcal A\|$, and let $b\in\mathbb R^m$ be such that the constraint set $\{X:\mathcal A(X)=b\}$ is nonempty. Suppose the step sizes obey
--   $$0<\inf_k\delta_k\le\sup_k\delta_k<\frac{2}{\|\mathcal A\|^2}.$$
--   Let $(X^k,y^k)$ be generated by Uzawa's iteration (3.3) from $y^0=0$:
--   $$X^k=\mathcal D_\tau(\mathcal A^*(y^{k-1})),\qquad y^k=y^{k-1}+\delta_k(b-\mathcal A(X^k)).$$
--   Then problem (3.1), minimize $f_\tau(X)=\tau\|X\|_*+\tfrac12\|X\|_F^2$ subject to $\mathcal A(X)=b$, has exactly one solution $X^\star$, and $X^k\to X^\star$ as $k\to\infty$.
--
--   This is the general convergence result for the SVT algorithm under linear equality constraints.
--
--   **Formalization Note** The step-size condition is written as: there are $a>0$ and $C$ with $C\|\mathcal A\|^2<2$ and $a\le\delta_k\le C$ for all $k\ge1$. This is equivalent to the printed condition when $\|\mathcal A\|>0$, and when $\mathcal A=0$ it reads $\inf\delta_k>0$ and $\sup\delta_k<\infty$ (the paper's $2/0=+\infty$), instead of becoming vacuous through Lean's $x/0=0$. Feasibility of (3.1) is an added hypothesis: "the unique solution to (3.1)" presupposes it, and without it the conclusion is false. Convergence is in the (Frobenius) topology of $\mathbb R^{n_1\times n_2}$, and both uniqueness and convergence of the whole sequence are asserted.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1968, Theorem 4.2, first sentence

import Mathlib
import Definitions.Def_CaiCandesShen_Convergence_Iterations
open Filter Topology

namespace CaiCandesShen.Convergence

/-- Theorem 4.2, first sentence, p. 1968: if `0 < inf δ_k ≤ sup δ_k < 2/‖𝒜‖²`, the sequence `X^k`
produced by Uzawa's iteration (3.3) from `y⁰ = 0` converges to the unique solution of (3.1).
The step-size condition is written multiplicatively (`C‖𝒜‖² < 2`); feasibility of (3.1) is
assumed, as "the unique solution" presupposes it. -/
theorem uzawa_converges {n₁ n₂ m : ℕ} (τ : ℝ) (hτ : 0 < τ) (Aop : Fin m → Mat n₁ n₂)
    (b : Fin m → ℝ) (hfeas : ∃ X : Mat n₁ n₂, applyA Aop X = b) (δ : ℕ → ℝ)
    (hδ : ∃ a C : ℝ, 0 < a ∧ C * opNormA Aop ^ 2 < 2 ∧ ∀ k : ℕ, 1 ≤ k → a ≤ δ k ∧ δ k ≤ C)
    (X : ℕ → Mat n₁ n₂) (y : ℕ → Fin m → ℝ) (hXy : IsUzawaSeq τ Aop b δ X y) :
    (∃! Xs : Mat n₁ n₂, IsSol31 τ Aop b Xs) ∧
      ∀ Xs : Mat n₁ n₂, IsSol31 τ Aop b Xs → Tendsto X atTop (𝓝 Xs) := by sorry

end CaiCandesShen.Convergence
