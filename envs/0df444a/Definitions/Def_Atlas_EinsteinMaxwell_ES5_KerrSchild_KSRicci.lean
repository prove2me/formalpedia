namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry

/-- `M^a_p = Σ_q C^a_{pq} K^q`. -/
noncomputable def mOf (C : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ) (K : Pt 5 → Fin 5 → ℝ) (x : Pt 5)
    (a p : Fin 5) : ℝ :=
  ∑ q, C a p q x * K x q

/-- The quadratic connection-difference terms of `ricci Γ − ricci Γ̄` (fixed `p q i j`). -/
noncomputable def qTerm (Γb C : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ) (x : Pt 5) (p q i j : Fin 5) :
    ℝ :=
  Γb i i j x * C j p q x + C i i j x * Γb j p q x + C i i j x * C j p q x
    - Γb i q j x * C j p i x - C i q j x * Γb j p i x - C i q j x * C j p i x

