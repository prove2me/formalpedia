/-! # Equal-spin D = 5: generic rewriting tools for candidate certificates (ATLAS-VI-02/02)

Dimension-5 helper lemmas used by the generated candidate modules. No new definitions:
* `pd` of a field that agrees with a `liftRU` closed form on an open set (`pd_eqOn_lift_*`);
* `christoffel_comm` for a metric whose components are symmetric as functions;
* locality (`*_congr_of_eqOn`) of `ricciScalar`, `einsteinMaxwellD`, `maxwellDiv`, `faradayCyclic`,
  so a certificate proved for normalised closed forms transfers to the candidate's own fields. -/

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

variable {U : Set (Pt 5)} {f : Pt 5 → ℝ} {F : ℝ → ℝ → ℝ} {x : Pt 5}

theorem pd_eqOn_lift_zero (hU : IsOpen U) (hx : x ∈ U) (h : Set.EqOn f (liftRU F) U) :
    pd 0 f x = 0 := by
  rw [pd_congr_of_eqOn hU hx h 0, pd_liftRU_zero]

theorem pd_eqOn_lift_three (hU : IsOpen U) (hx : x ∈ U) (h : Set.EqOn f (liftRU F) U) :
    pd 3 f x = 0 := by
  rw [pd_congr_of_eqOn hU hx h 3, pd_liftRU_three]

theorem pd_eqOn_lift_four (hU : IsOpen U) (hx : x ∈ U) (h : Set.EqOn f (liftRU F) U) :
    pd 4 f x = 0 := by
  rw [pd_congr_of_eqOn hU hx h 4, pd_liftRU_four]

theorem pd_eqOn_lift_one (hU : IsOpen U) (hx : x ∈ U) (h : Set.EqOn f (liftRU F) U) {d : ℝ}
    (hd : HasDerivAt (fun s => F s (x 2)) d (x 1)) : pd 1 f x = d := by
  rw [pd_congr_of_eqOn hU hx h 1, pd_liftRU_one]; exact hd.deriv

theorem pd_eqOn_lift_two (hU : IsOpen U) (hx : x ∈ U) (h : Set.EqOn f (liftRU F) U) {d : ℝ}
    (hd : HasDerivAt (fun s => F (x 1) s) d (x 2)) : pd 2 f x = d := by
  rw [pd_congr_of_eqOn hU hx h 2, pd_liftRU_two]; exact hd.deriv

theorem christoffel_comm {n : ℕ} {g : Metric n} (ginv : Metric n) (hg : ∀ i j, g i j = g j i)
    (a b c : Fin n) (y : Pt n) : christoffel g ginv a b c y = christoffel g ginv a c b y := by
  unfold christoffel
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hg b c]; ring

variable {g g' ginv ginv' : Metric 5} {Fm Fm' : TwoForm 5}

end ExactVacuumAtlas.EinsteinMaxwell.ES5
