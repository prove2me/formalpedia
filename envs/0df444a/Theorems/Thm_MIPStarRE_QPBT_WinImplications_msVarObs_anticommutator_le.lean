/-! ## The Magic Square anticommutation on the undilated strategy -/

theorem MIPStarRE.QPBT.WinImplications.msVarObs_anticommutator_le (S : _root_.MIPStarRE.QPBT.Strategy _root_.MIPStarRE.QPBT.msGame) (ε : ℝ) (hε : 0 ≤ ε)
    (hwin : 1 - ε ≤ S.value) :
    ‖_root_.MIPStarRE.QPBT.applyOperatorToState
        (_root_.MIPStarRE.QPBT.heteroKron (1 : _root_.LIDT.MIPStarRE.Quantum.Op S.ιA)
          (_root_.MIPStarRE.QPBT.obsOf ((S.B (.var 0)).postprocess _root_.MIPStarRE.QPBT.msBitOrZero) *
              _root_.MIPStarRE.QPBT.obsOf ((S.B (.var 4)).postprocess _root_.MIPStarRE.QPBT.msBitOrZero) +
            _root_.MIPStarRE.QPBT.obsOf ((S.B (.var 4)).postprocess _root_.MIPStarRE.QPBT.msBitOrZero) *
              _root_.MIPStarRE.QPBT.obsOf ((S.B (.var 0)).postprocess _root_.MIPStarRE.QPBT.msBitOrZero)))
        S.ψ‖ ^ 2 ≤ 1183680 * ε := by sorry
