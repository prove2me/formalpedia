-- title:
--   Theorem 3.1 — every accumulation point of the IHT method with stepsize 1/L, L > L(f), is an L-stationary point
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), with gradient Lipschitz with constant $L(f)$ (Assumption 2), let $0<s<n$, and let $L>L(f)$. Let $(x^k)_{k\ge0}$ be any sequence generated by the IHT method with stepsize $1/L$:
--   $$x^0\in C_s,\qquad x^{k+1}\in P_{C_s}\Big(x^k-\tfrac1L\nabla f(x^k)\Big)\quad(k=0,1,2,\dots).$$
--   Then every accumulation point $x^*$ of $(x^k)$ is an $L$-stationary point of (P): $x^*\in C_s$ and $x^*\in P_{C_s}\big(x^*-\tfrac1L\nabla f(x^*)\big)$.
--
--   This is the general convergence guarantee of the IHT method; for least squares with an $s$-regular matrix it is upgraded to convergence of the whole sequence (Theorem 3.2).
--
--   **Formalization Note** $L(f)$ is any constant `Lf : ℝ≥0` with `LipschitzWith Lf (gradient f)`. "$x^*$ is an accumulation point" is `MapClusterPt xstar atTop x`: some subsequence of $(x^k)$ converges to $x^*$. The statement does not assert that an accumulation point exists.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 16, Theorem 3.1 (proof §4.1.1, pp. 27–28)

import Mathlib
import Definitions.Def_SparseNLO_IHT_Setting

open Filter Topology

namespace SparseNLO.IHT

/-- Theorem 3.1 (p. 16). Let `(x^k)` be generated by the IHT method with stepsize `1/L`, where
`L > L(f)`. Then any accumulation point of `(x^k)` is an `L`-stationary point. -/
theorem theorem_3_1 {n s : ℕ} (hs : 0 < s) (hsn : s < n)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f) (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x)
    (Lf : NNReal) (hLip : LipschitzWith Lf (gradient f)) (L : ℝ) (hL : (Lf : ℝ) < L)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsIHTRun f s L x)
    (xstar : EuclideanSpace ℝ (Fin n)) (hacc : MapClusterPt xstar atTop x) :
    IsLStationary f s L xstar := by sorry

end SparseNLO.IHT
