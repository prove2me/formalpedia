    (hl : l.length = n) {x : ℕ} (hx : x ∈ g l) : x ∈ l := by
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
  rw [hP.getElem hl hi]; exact List.getElem_mem _

