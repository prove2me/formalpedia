theorem isArtinianRing_quotient_pow {R : Type} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ) :
    IsArtinianRing (R ⧸ maximalIdeal R ^ (n + 1)) := by
  rw [isArtinianRing_iff_krullDimLE_zero]
  refine Ring.KrullDimLE.mk₀ fun I hI => ?_
  have hc : (I.comap (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1)))).IsPrime := Ideal.comap_isPrime _ _
  have hle : maximalIdeal R ≤ I.comap (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1))) := by
    apply (Ideal.IsPrime.pow_le_iff (I := maximalIdeal R) (Nat.succ_ne_zero n)).1
    intro x hx
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.2 hx]
    exact I.zero_mem
  have heq : I.comap (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1))) = maximalIdeal R :=
    ((maximalIdeal.isMaximal R).eq_of_le hc.ne_top hle).symm
  have hmax : (I.comap (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1)))).IsMaximal := by rw [heq]; exact maximalIdeal.isMaximal R
  have hsurj : Function.Surjective (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1))) := Ideal.Quotient.mk_surjective
  rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hsurj hmax with h | h
  · exact absurd (by rwa [Ideal.map_comap_of_surjective _ hsurj] at h) hI.ne_top
  · rwa [Ideal.map_comap_of_surjective _ hsurj] at h

theorem maximalIdeal_quotient_eq_map {R : Type} [CommRing R] [IsLocalRing R] (I : Ideal R)
    [Nontrivial (R ⧸ I)] [IsLocalRing (R ⧸ I)] :
    maximalIdeal (R ⧸ I) = (maximalIdeal R).map (Ideal.Quotient.mk I) := by
  have hI : I ≤ maximalIdeal R := by
    apply IsLocalRing.le_maximalIdeal
    intro h
    exact (Ideal.Quotient.nontrivial_iff.mp inferInstance) h
  symm
  apply IsLocalRing.eq_maximalIdeal
  rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    (maximalIdeal.isMaximal R) with h | h
  · exfalso
    apply (maximalIdeal.isMaximal R).ne_top
    have := congrArg (Ideal.comap (Ideal.Quotient.mk I)) h
    rw [Ideal.comap_top, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, sup_eq_left.2 hI] at this
    exact this
  · exact h

theorem ker_eq_maximalIdeal_of_surjective {B k : Type} [CommRing B] [IsLocalRing B] [Field k]
    (r : B →+* k) (hr : Function.Surjective r) : RingHom.ker r = maximalIdeal B :=
  IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective r hr)

def residueFieldEquivOfSurjective {B k : Type} [CommRing B] [IsLocalRing B] [Field k]
    (r : B →+* k) (hr : Function.Surjective r) : ResidueField B ≃+* k :=
  (Ideal.quotEquivOfEq (ker_eq_maximalIdeal_of_surjective r hr).symm).trans (RingHom.quotientKerEquivOfSurjective hr)

theorem isAlgClosed_residueField_of_surjective {B k : Type} [CommRing B] [IsLocalRing B] [Field k] [IsAlgClosed k]
    (r : B →+* k) (hr : Function.Surjective r) : IsAlgClosed (ResidueField B) :=
  IsAlgClosed.of_ringEquiv k _ (residueFieldEquivOfSurjective r hr).symm

theorem charP_residueField_of_surjective {B k : Type} [CommRing B] [IsLocalRing B] [Field k] (p : ℕ) [Fact p.Prime] [CharP k p]
    (r : B →+* k) (hr : Function.Surjective r) : CharP (ResidueField B) p := by
  apply (CharP.charP_iff_prime_eq_zero Fact.out).2
  apply (residueFieldEquivOfSurjective r hr).injective
  rw [map_natCast, map_zero, CharP.cast_eq_zero]

theorem factorsThrough_of_exists_of_level_one {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
    {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (E : FakeEllipticCurve Λ 1 S) (E' : FakeEllipticCurve Λ 1 S') (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g)
    {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' E'.f)
    (hP : ∃ P₀ : T ⟶ E.C, P₀ ≫ E.lev = P.1 ≫ g) : FactorsThrough E'.lev P := by
  obtain ⟨sq, hmul, -, -⟩ := hg
  rw [CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_iff_eq_one_of_level_one]
  let Pg : SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) E.f :=
    ⟨P.1 ≫ g, by rw [Category.assoc, sq.w, ← Category.assoc, P.2]⟩
  have h1 : Pg = E.L.one _ :=
    (CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_iff_eq_one_of_level_one E _ Pg).1 hP
  let y : SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) E.f :=
    ⟨(E'.L.one t').1 ≫ g, by rw [Category.assoc, sq.w, ← Category.assoc, (E'.L.one t').2]⟩
  have hyy : E.L.mul _ y y = y := by
    apply Subtype.ext
    have := hmul t' (E'.L.one t') (E'.L.one t')
    rw [E'.L.one_mul] at this
    exact this.symm
  have h2 : y = E.L.one _ := by
    calc y = E.L.mul _ (E.L.mul _ y y) (E.L.inv _ y) := by rw [E.L.mul_assoc, E.L.mul_inv_cancel, E.L.mul_one]
      _ = E.L.mul _ y (E.L.inv _ y) := by rw [hyy]
      _ = E.L.one _ := E.L.mul_inv_cancel _ _
  have hval : P.1 ≫ g = (E'.L.one t').1 ≫ g := by
    change Pg.1 = y.1
    rw [h1, h2]
  apply Subtype.ext
  apply sq.hom_ext hval
  rw [P.2, (E'.L.one t').2]

