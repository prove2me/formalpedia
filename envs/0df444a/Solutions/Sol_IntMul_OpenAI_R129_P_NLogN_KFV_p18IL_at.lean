theorem poly_lt (C k : ℕ) : ∃ N, ∀ x, N ≤ x → C * x ^ k < 2 ^ x := by
  have h := tendsto_pow_const_div_const_pow_of_one_lt k (show (1 : ℝ) < 2 by norm_num)
  have h2 := h.eventually (gt_mem_nhds (show (0 : ℝ) < 1 / ((C : ℝ) + 1) by positivity))
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 h2
  refine ⟨N, fun x hx => ?_⟩
  have h3 := hN x hx
  have hp : (0 : ℝ) < 2 ^ x := by positivity
  rw [div_lt_div_iff₀ hp (by positivity)] at h3
  have hx0 : (0 : ℝ) ≤ (x : ℝ) ^ k := by positivity
  have : ((C * x ^ k : ℕ) : ℝ) < ((2 ^ x : ℕ) : ℝ) := by push_cast; nlinarith
  exact_mod_cast this

theorem rb (M b m : ℕ) (h : M ^ (2 ^ m) ≤ b) : (M : ℝ) ≤ (b : ℝ) ^ ((1 : ℝ) / 2 ^ m) := by
  have e : (M : ℝ) = ((M : ℝ) ^ (2 ^ m : ℕ)) ^ ((1 : ℝ) / 2 ^ m) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
    push_cast
    rw [mul_one_div_cancel (by positivity), Real.rpow_one]
  rw [e]
  exact Real.rpow_le_rpow (by positivity) (by exact_mod_cast h) (by positivity)

theorem bP_ge {n m : ℕ} (hn : 2 ^ m ≤ n) : m ≤ bP n := by
  have h := Nat.clog_mono_right 2 hn
  rw [Nat.clog_pow 2 m (by norm_num)] at h
  exact h.trans (le_max_left _ _)

theorem zN (m : ℕ) : zsz (m : ℤ) ≤ m :=
  zsz_le_of_lt (by simpa using (Nat.lt_two_pow_self (n := m)))

theorem fmB_le (n : ℕ) : KFM.fmB n ≤ 2 * (8 * fmA + 10 ^ 7 + 10 ^ 5) * (n + 3) ^ 6 := by
  unfold KFM.fmB
  generalize 8 * fmA + 10 ^ 7 + 10 ^ 5 = F
  have h1 : zsz ((n + 1 : ℕ) : ℤ) + 2 ≤ n + 3 := by have := NLogN.KFV.P18M.zN (n + 1); omega
  have h2 : zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1 ≤ (n + 3) ^ 4 + 1 := by
    have := NLogN.KFV.P18M.zN ((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4)
    have := Nat.pow_le_pow_left h1 4
    omega
  have h3 : (n + 3) ^ 4 + 1 ≤ 2 * (n + 3) ^ 4 := by
    have : 1 ≤ (n + 3) ^ 4 := Nat.one_le_pow _ _ (by omega)
    omega
  exact le_trans (Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul le_rfl
    (show n + 1 ≤ n + 3 by omega)) h1) (h2.trans h3)) (le_of_eq (by ring))

theorem cU_le (B : ℕ) :
    10 ^ 12 * (B + 2) ^ 3 + 16 * KFUU.cU B ≤ Cu * (2 * B + 3) ^ 6 := by
  have h1 := NLogN.KFV.P18M.fmB_le (2 * B)
  have hc : KFUU.cU B = 10 ^ 4 * (B + 1) + KFM.fmB (2 * B) := rfl
  have hCu : Cu = 10 ^ 12 + 16 * 10 ^ 4 + 16 * (2 * (8 * fmA + 10 ^ 7 + 10 ^ 5)) := rfl
  rw [hc, hCu]
  have hX : 1 ≤ 2 * B + 3 := by omega
  have e1 : (B + 2) ^ 3 ≤ (2 * B + 3) ^ 6 :=
    (Nat.pow_le_pow_left (by omega) 3).trans (Nat.pow_le_pow_right hX (by norm_num))
  have e2 : 2 * B + 3 ≤ (2 * B + 3) ^ 6 := by
    simpa using Nat.pow_le_pow_right hX (show 1 ≤ 6 by norm_num)
  linarith

