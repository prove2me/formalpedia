  have e2 : B * (S0 * r * 2 ^ t) = B * 2 ^ t * S0 * r := by ring
  rw [e, e2]
  have a4 : B * 2 ^ t * S0 * r ≤ W * (B * 2 ^ t * S0 * r) := Nat.le_mul_of_pos_left _ hW
  omega

/-- The wrapper around a child program. -/
theorem wrapChild_X (hW : 1 ≤ W) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) {n : ℕ}
