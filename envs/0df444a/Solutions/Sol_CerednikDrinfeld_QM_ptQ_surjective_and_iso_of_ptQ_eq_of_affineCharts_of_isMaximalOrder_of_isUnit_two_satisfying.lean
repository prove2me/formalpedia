theorem exists_cover {M : Scheme.{0}} {S : Type} [CommRing S] (p : Spec (CommRingCat.of S) ⟶ M) :
    ∃ (k : ℕ) (r : Fin k → S), Ideal.span (Set.range r) = ⊤ ∧
      ∀ i, ∃ U : M.affineOpens,
        Set.range (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i)))) ≫ p).base ⊆ (U : Set M) := by
  classical
  let R : Set S := {r | ∃ U : M.affineOpens,
    Set.range (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away r))) ≫ p).base ⊆ (U : Set M)}
  have hR : Ideal.span R = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hR𝔪⟩ := Ideal.exists_le_maximal (Ideal.span R) hne
    let x : ↥(Spec (CommRingCat.of S)) := ⟨𝔪, h𝔪.isPrime⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      M.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (p.base x)) isOpen_univ
    have hopen : IsOpen (p.base ⁻¹' (U : Set M)) := U.isOpen.preimage p.base.hom.continuous
    obtain ⟨_, ⟨_, ⟨r, rfl⟩, rfl⟩, hxr, hrU⟩ :=
      PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open (show x ∈ p.base ⁻¹' (U : Set M) from hxU) hopen
    have hrR : r ∈ R := by
      refine ⟨⟨U, hU⟩, ?_⟩
      rintro _ ⟨y, rfl⟩
      apply hrU
      show (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away r)))).base y ∈
        ((PrimeSpectrum.basicOpen r : TopologicalSpace.Opens (PrimeSpectrum S)) : Set (PrimeSpectrum S))
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away r) r]
      exact ⟨y, rfl⟩
    exact hxr (hR𝔪 (Ideal.subset_span hrR))
  have h1 : (1 : S) ∈ Ideal.span R := by rw [hR]; trivial
  obtain ⟨T, hTR, hT1⟩ := Submodule.mem_span_finite_of_mem_span h1
  refine ⟨T.card, fun i => (T.equivFin.symm i).1, ?_, fun i => hTR (T.equivFin.symm i).2⟩
  rw [Ideal.eq_top_iff_one]
  have : Set.range (fun i => ((T.equivFin.symm i).1 : S)) = (T : Set S) := by
    ext y; constructor
    · rintro ⟨i, rfl⟩; exact (T.equivFin.symm i).2
    · intro hy; exact ⟨T.equivFin ⟨y, hy⟩, by simp⟩
  rw [this]; exact hT1

theorem isUnit_of_forall_away {S : Type} [CommRing S] {k : ℕ} (r : Fin k → S) (hr : Ideal.span (Set.range r) = ⊤)
    (m : ℕ) (h : ∀ i, IsUnit ((m : ℕ) : Localization.Away (r i))) : IsUnit ((m : ℕ) : S) := by
  classical
  have hn : ∀ i, ∃ n : ℕ, r i ^ n ∈ Ideal.span ({(m : S)} : Set S) := by
    intro i
    have htop : (Ideal.span ({(m : S)} : Set S)).map (algebraMap S (Localization.Away (r i))) = ⊤ := by
      apply Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_singleton _)))
      simpa using h i
    have hnd : ¬ Disjoint (↑(Submonoid.powers (r i)) : Set S) (↑(Ideal.span ({(m : S)} : Set S))) := fun hd =>
      ((IsLocalization.map_algebraMap_ne_top_iff_disjoint (Submonoid.powers (r i)) (Localization.Away (r i))
        (Ideal.span ({(m : S)} : Set S))).mpr hd) htop
    obtain ⟨y, ⟨n, rfl⟩, hy⟩ := Set.not_disjoint_iff.mp hnd
    exact ⟨n, hy⟩
  choose n hn using hn
  let N := Finset.univ.sup n
  have hle : Ideal.span ((fun x => x ^ N) '' Set.range r) ≤ Ideal.span ({(m : S)} : Set S) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    have hi : n i ≤ N := Finset.le_sup (Finset.mem_univ i)
    obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le hi
    show r i ^ N ∈ Ideal.span ({(m : S)} : Set S)
    rw [hc, pow_add]
    exact Ideal.mul_mem_right _ _ (hn i)
  rw [Ideal.span_pow_eq_top _ hr N, top_le_iff, Ideal.span_singleton_eq_top] at hle
  exact hle

