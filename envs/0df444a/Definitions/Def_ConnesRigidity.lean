    (E : SplitAbelianExtension A G H)
    (π : UnitaryRepresentation G V) (h : H) (T : V →L[ℂ] V) :
    quotientOperatorConjugation E π h T =
      (π (E.splitting h) : V →L[ℂ] V) * T *
        star (π (E.splitting h) : V →L[ℂ] V) := rfl
