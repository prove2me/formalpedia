section AmbVal
variable {m r : ℕ} {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

def GenHom (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) : Prop :=
  ∀ i ξ x, f i ξ x ∈ ⋀[ℝ]^(i + 1) (Module.Dual ℝ (Fin m → ℝ))

noncomputable def ceLift (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) : CE L →ₐ[ℝ] Ω m :=
  (generator_lift_dga.1 f hf).choose

theorem ceLift_gen (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : ceLift f hf (gen L i ξ) = f i ξ :=
  (generator_lift_dga.1 f hf).choose_spec i ξ

noncomputable def retr (S : GenSys L) (i : ℕ) : Module.Dual ℝ (L i) →ₗ[ℝ] S i :=
  (LinearMap.exists_leftInverse_of_injective (K := ℝ) (V := S i) (V' := Module.Dual ℝ (L i))
    (S i).subtype (Submodule.ker_subtype _)).choose

theorem retr_spec (S : GenSys L) (i : ℕ) (ξ : S i) : retr S i (ξ : Module.Dual ℝ (L i)) = ξ :=
  LinearMap.congr_fun
    (LinearMap.exists_leftInverse_of_injective (K := ℝ) (V := S i) (V' := Module.Dual ℝ (L i))
      (S i).subtype (Submodule.ker_subtype _)).choose_spec ξ

noncomputable def rawVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ) :
    Module.Dual ℝ (L i) →ₗ[ℝ] Ω m :=
  if h : i < m then
    ∑ k : Fin (Module.finrank ℝ (S i)), LinearMap.smulRight
      ((Finsupp.lapply k).comp ((genBasis S i).repr.toLinearMap.comp (retr S i)))
      (wRep hr (z ⟨i, h⟩ k))
  else 0

theorem rawVal_lt (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : i < m)
    (ξ : Module.Dual ℝ (L i)) :
    rawVal hr S z i ξ = ∑ k : Fin (Module.finrank ℝ (S i)),
      (genBasis S i).repr (retr S i ξ) k • wRep hr (z ⟨i, h⟩ k) := by
  simp only [rawVal, h, ↓reduceDIte, LinearMap.sum_apply,
    LinearMap.smulRight_apply, LinearMap.comp_apply, Finsupp.lapply_apply,
    LinearEquiv.coe_coe]

theorem rawVal_ge (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : ¬ i < m)
    (ξ : Module.Dual ℝ (L i)) : rawVal hr S z i ξ = 0 := by
  simp only [rawVal, h, ↓reduceDIte, LinearMap.zero_apply]

theorem isDeg_rawVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : IsDeg (i + 1) (rawVal hr S z i ξ) := by
  by_cases h : i < m
  · rw [rawVal_lt hr S z h]
    intro x hx
    rw [Finset.sum_apply]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ ((wRep_spec hr _).1.1 x hx)
  · rw [rawVal_ge hr S z h]
    exact isDeg_zero

open Classical in
noncomputable def cutL : Ω m →ₗ[ℝ] Ω m where
  toFun ϖ x := if x ∈ simplex m then ϖ x else 0
  map_add' ϖ ϖ' := by funext x; by_cases hx : x ∈ simplex m <;> simp [hx]
  map_smul' c ϖ := by funext x; by_cases hx : x ∈ simplex m <;> simp [hx]

theorem cutL_eqOn (ϖ : Ω m) : FormEqOn (cutL ϖ) ϖ := fun x hx => by simp [cutL, hx]

noncomputable def genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ) :
    Module.Dual ℝ (L i) →ₗ[ℝ] Ω m :=
  cutL ∘ₗ rawVal hr S z i

theorem genHom_genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) : GenHom (genVal hr S z) :=
  fun i ξ x => by
  by_cases hx : x ∈ simplex m
  · simp only [genVal, cutL, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, hx, ↓reduceIte]
    exact isDeg_rawVal hr S z i ξ x hx
  · simp only [genVal, cutL, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, hx, ↓reduceIte]
    exact Submodule.zero_mem _

theorem isCr_genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : IsCr r (genVal hr S z i ξ) := by
  have e : ∀ x ∈ simplex m, rawVal hr S z i ξ x = genVal hr S z i ξ x :=
    fun x hx => (cutL_eqOn (rawVal hr S z i ξ) x hx).symm
  refine generator_lift_dga.2.2.2.2.2.2.2.2 e ?_
  by_cases h : i < m
  · rw [rawVal_lt hr S z h]
    exact IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr _ _ fun k _ => isCr_smul hr _ (wRep_spec hr _).1.2
  · rw [rawVal_ge hr S z h]; exact isCr_zero

theorem genVal_ge (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : m ≤ i)
    (ξ : Module.Dual ℝ (L i)) : genVal hr S z i ξ = 0 := by
  show cutL (rawVal hr S z i ξ) = 0
  rw [rawVal_ge hr S z (by omega), map_zero]

theorem jet_genVal_basis (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S t))) :
    jet r (genVal hr S z t (genBasis S t k)) = z t k := by
  have e : FormEqOn (genVal hr S z t (genBasis S t k)) (wRep hr (z t k)) := fun x hx => by
    show cutL (rawVal hr S z t (genBasis S t k)) x = _
    rw [cutL_eqOn _ x hx, rawVal_lt hr S z t.2, retr_spec, Module.Basis.repr_self]
    simp only [Finsupp.single_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
      Finset.mem_univ, ↓reduceIte, Fin.eta]
  rw [jet_congr e]
  exact (wRep_spec hr (z t k)).2

theorem smoothFam_genVal (hr : 1 ≤ r) (S : GenSys L) (i : ℕ) (ξ : Module.Dual ℝ (L i)) :
    SmoothFam r (i + 1) (fun z : Amb r S m => genVal hr S z i ξ) := by
  by_cases h : i < m
  · have hs : SmoothFam r (i + 1) (fun z : Amb r S m => ∑ k : Fin (Module.finrank ℝ (S i)),
        (genBasis S i).repr (retr S i ξ) k • wRep hr (z ⟨i, h⟩ k)) :=
      smoothFam_sum hr _ fun k _ => IntLInfty.Kan.integ_iff_generator_condition.2.2.2.1 hr _
        ⟨fun z => z ⟨i, h⟩ k, IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.1 S ⟨i, h⟩ k, fun z => wRep_spec hr (z ⟨i, h⟩ k)⟩
    refine smoothFam_congr hs fun z x hx => ?_
    show cutL (rawVal hr S z i ξ) x = _
    rw [cutL_eqOn _ x hx, rawVal_lt hr S z h]
  · refine smoothFam_congr (IntLInfty.Kan.integ_iff_generator_condition.2.1 hr (i + 1)) fun z x hx => ?_
    show cutL (rawVal hr S z i ξ) x = _
    rw [cutL_eqOn _ x hx, rawVal_ge hr S z h]

theorem ceLift_mem_deg (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) {p : ℕ}
    {a : CE L} (ha : a ∈ ceDeg L p) (x : Fin m → ℝ) :
    ceLift f hf a x ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ)) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 f hf (ceLift f hf) (ceLift_gen f hf) ha x

theorem genVal_eqOn_of_integ (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S m)
    (φ : genAlg L S →ₐ[ℝ] Ω m) (hφ : IsDGAMap r δ S m φ)
    (hz : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      (z t k : Jet r m × Jet r m) =
        jet r (φ ⟨gen L t (genBasis S t k), gen_mem_genAlg S (genBasis S t k).2⟩))
    (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    FormEqOn (φ ⟨gen L i ξ, gen_mem_genAlg S hξ⟩) (genVal hr S z i ξ) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr δ S z (genVal hr S z) (isCr_genVal hr S z) (fun i h ξ => genVal_ge hr S z h ξ)
    (jet_genVal_basis hr S z) φ hφ hz i ξ hξ

/-- The cone operator, in the form the C1/I1 hypothesis `hKc` accepts by `rfl`. -/
noncomputable def Kc : ∀ m : ℕ, ℕ → Ω m → Ω m := fun m n β y =>
  letI : NormedAddCommGroup (ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))) :=
    NormedAddCommGroup.induced (ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ)))
      (Finset (Fin m) → ℝ) (formBasis m).equivFun.toLinearMap (formBasis m).equivFun.injective
  letI : NormedSpace ℝ (ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))) :=
    NormedSpace.induced ℝ (ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ)))
      (Finset (Fin m) → ℝ) (formBasis m).equivFun.toLinearMap
  CliffordAlgebra.contractLeft (Module.Dual.eval ℝ (Fin m → ℝ) y) (∫ t in (0 : ℝ)..1, t ^ n • β (t • y))

end AmbVal

end IntLInfty.Kan.A83I1

namespace IntLInfty.Kan.K2U
open IntLInfty.Kan IntLInfty.Kan.A83 IntLInfty.Kan.A83I1
open scoped ContDiff
set_option linter.unusedSectionVars false

section Basic
variable {m r : ℕ}

theorem jet_zero' (hr : 1 ≤ r) : jet r (0 : Ω m) = 0 := by
  have := jet_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m))
  simpa using this

theorem extD_zero' (hr : 1 ≤ r) {x : Fin m → ℝ} (hx : x ∈ simplex m) : extD (0 : Ω m) x = 0 := by
  have := extD_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m)) hx
  simpa using this

theorem extD_sub (hr : 1 ≤ r) {ϖ ϖ' : Ω m} (hϖ : IsCr r ϖ) (hϖ' : IsCr r ϖ') {x : Fin m → ℝ}
    (hx : x ∈ simplex m) : extD (ϖ - ϖ') x = extD ϖ x - extD ϖ' x := by
  have e : ϖ - ϖ' = ϖ + (-1 : ℝ) • ϖ' := by funext y; simp [sub_eq_add_neg]
  rw [e, extD_add hr hϖ (isCr_smul hr _ hϖ') hx, extD_smul hr _ hϖ' hx]
  simp [sub_eq_add_neg]

theorem jet_sub' (hr : 1 ≤ r) {a b : Ω m} (ha : IsCr r a) (hb : IsCr r b) :
    jet r (a - b) = jet r a - jet r b := by
  have e : a - b = a + (-1 : ℝ) • b := by funext x; simp [sub_eq_add_neg]
  rw [e, jet_add hr ha (isCr_smul hr _ hb), jet_smul hr _ hb]
  simp [sub_eq_add_neg]

theorem isCr_sub (hr : 1 ≤ r) {ϖ ϖ' : Ω m} (h : IsCr r ϖ) (h' : IsCr r ϖ') : IsCr r (ϖ - ϖ') := by
  have e : ϖ - ϖ' = ϖ + (-1 : ℝ) • ϖ' := by funext x; simp [sub_eq_add_neg]
  rw [e]; exact isCr_add hr h (isCr_smul hr _ h')

theorem isDeg_sub {n : ℕ} {ϖ ϖ' : Ω m} (h : IsDeg n ϖ) (h' : IsDeg n ϖ') : IsDeg n (ϖ - ϖ') := by
  have e : ϖ - ϖ' = ϖ + (-1 : ℝ) • ϖ' := by funext x; simp [sub_eq_add_neg]
  rw [e]; exact isDeg_add h (isDeg_smul _ h')

theorem isCr_extD (hr : 1 ≤ r) {ϖ : Ω m} (hC : IsCr r ϖ) : IsCr r (extD ϖ) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr Kc (fun _ _ _ _ => rfl)).2.2.2.2.2.2.2.1 m ϖ hC

theorem isDeg_extD (hr : 1 ≤ r) {ϖ : Ω m} {n : ℕ} (hC : IsCr r ϖ) (hD : IsDeg n ϖ) :
    IsDeg (n + 1) (extD ϖ) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr Kc (fun _ _ _ _ => rfl)).2.2.2.2.2.2.1 m n ϖ hC hD

noncomputable def dCLM (hr : 1 ≤ r) (n : ℕ) : CrForms r m n →L[ℝ] CrForms r m (n + 1) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr Kc (fun _ _ _ _ => rfl)).2.2.2.2.2.2.2.2.2.choose_spec.choose m n

theorem dLin_val (hr : 1 ≤ r) {n : ℕ} (w : CrForms r m n) {ϖ : Ω m} (hC : IsCr r ϖ)
    (h : jet r ϖ = w) : (dCLM hr n w : Jet r m × Jet r m) = jet r (extD ϖ) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr Kc
    (fun _ _ _ _ => rfl)).2.2.2.2.2.2.2.2.2.choose_spec.choose_spec.2.1 m n w ϖ hC h

theorem isCr_sum (hr : 1 ≤ r) {ι : Type} (s : Finset ι) (ϖ : ι → Ω m)
    (h : ∀ k ∈ s, IsCr r (ϖ k)) : IsCr r (∑ k ∈ s, ϖ k) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr s ϖ h

theorem alg_eq_zero_of_lt {p : ℕ} (h : m < p) {a : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))}
    (ha : a ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ))) : a = 0 :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.1 h ha

theorem faceCr_val (hr : 1 ≤ r) {n : ℕ} (i : Fin (m + 2)) (w : CrForms r (m + 1) n)
    {ϖ : Ω (m + 1)} (hD : IsDeg n ϖ) (hC : IsCr r ϖ) (h : jet r ϖ = w) :
    (faceCr r m n i w : Jet r m × Jet r m) = jet r (pull m i ϖ) := by
  obtain ⟨w, hw⟩ := w
  simp only at h
  subst h
  exact faceCr_eq hr i hD hC hw

noncomputable def pullAlg (m : ℕ) (i : Fin (m + 2)) : Ω (m + 1) →ₐ[ℝ] Ω m where
  toFun := pull m i
  map_one' := funext fun _ => map_one (ExteriorAlgebra.map (cofaceLin m i).dualMap)
  map_mul' a b := funext fun x =>
    map_mul (ExteriorAlgebra.map (cofaceLin m i).dualMap) (a (coface m i x)) (b (coface m i x))
  map_zero' := funext fun _ => map_zero (ExteriorAlgebra.map (cofaceLin m i).dualMap)
  map_add' a b := funext fun x =>
    map_add (ExteriorAlgebra.map (cofaceLin m i).dualMap) (a (coface m i x)) (b (coface m i x))
  commutes' c := funext fun _ => (ExteriorAlgebra.map (cofaceLin m i).dualMap).commutes c

end Basic

section Alg
variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

theorem gen_mem_ceDeg (i : ℕ) (ξ : Module.Dual ℝ (L i)) : gen L i ξ ∈ ceDeg L (i + 1) :=
  Submodule.subset_span ⟨1, fun _ => i, fun _ => ξ, by simp, by simp⟩

theorem detGen {p : ℕ} (c : Module.Dual ℝ (L (p + 1))) (hc : gen L (p + 1) c ∈ lowAlg L p) :
    c = 0 :=
  (IntLInfty.Kan.tauLt_delta_closed_and_detection (L := L)).2.2.2.1 p c hc

theorem ceDeg_succ_succ_le (p : ℕ) :
    ceDeg L (p + 2) ≤ Subalgebra.toSubmodule (lowAlg L p) ⊔ LinearMap.range (gen L (p + 1)) :=
  (IntLInfty.Kan.tauLt_delta_closed_and_detection (L := L)).2.2.1 p

theorem dga_of_gen {m r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (Φ : CE L →ₐ[ℝ] Ω m)
    (hdeg : ∀ (i : ℕ) (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsDeg (i + 1) (Φ (gen L i ξ)))
    (hcr : ∀ (i : ℕ) (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsCr r (Φ (gen L i ξ)))
    (hd : ∀ (i : ℕ) (ξ : Module.Dual ℝ (L i)), ξ ∈ S i →
        ∀ x ∈ simplex m, extD (Φ (gen L i ξ)) x = Φ (δ.δ (gen L i ξ)) x) :
    ∀ a ∈ genAlg L S, IsCr r (Φ a) ∧ ∀ x ∈ simplex m, extD (Φ a) x = Φ (δ.δ a) x :=
  generator_lift_dga.2.1 hr δ S Φ hdeg hcr hd

theorem exists_dStar (δ : LInfty L) (n : ℕ) :
    ∃ D : Module.Dual ℝ (L n) →ₗ[ℝ] Module.Dual ℝ (L (n + 1)),
      ∀ b, δ.δ (gen L n b) - gen L (n + 1) (D b) ∈ lowAlg L n := by
  have hex : ∀ b : Module.Dual ℝ (L n), ∃ c,
      δ.δ (gen L n b) - gen L (n + 1) c ∈ lowAlg L n := by
    intro b
    have hx := ceDeg_succ_succ_le (L := L) n (δ.deg _ _ (gen_mem_ceDeg n b))
    obtain ⟨y, hy, z, ⟨c, rfl⟩, hyz⟩ := Submodule.mem_sup.1 hx
    refine ⟨c, ?_⟩
    rw [← hyz, add_sub_cancel_right]
    exact hy
  choose f hf using hex
  have huniq : ∀ b c c', δ.δ (gen L n b) - gen L (n + 1) c ∈ lowAlg L n →
      δ.δ (gen L n b) - gen L (n + 1) c' ∈ lowAlg L n → c' = c := by
    intro b c c' h1 h2
    have h3 : gen L (n + 1) (c' - c) ∈ lowAlg L n := by
      have := Subalgebra.sub_mem _ h1 h2
      rw [map_sub]
      convert this using 1
      abel
    exact sub_eq_zero.1 (detGen _ h3)
  refine ⟨{ toFun := f, map_add' := ?_, map_smul' := ?_ }, fun b => hf b⟩
  · intro b b'
    refine huniq (b + b') _ _ ?_ (hf _)
    have := Subalgebra.add_mem _ (hf b) (hf b')
    rw [map_add, map_add, map_add]
    convert this using 1
    abel
  · intro s b
    refine huniq (s • b) _ _ ?_ (hf _)
    convert Subalgebra.smul_mem _ (hf b) s using 1
    rw [map_smul, map_smul, RingHom.id_apply, map_smul]
    exact (smul_sub s _ _).symm

/-- A generalised inverse over a field. -/
theorem exists_genInv {V W : Type} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
    (D : V →ₗ[ℝ] W) : ∃ h : W →ₗ[ℝ] V, ∀ v, D (h (D v)) = D v := by
  obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective D.rangeRestrict
    (LinearMap.range_rangeRestrict D)
  obtain ⟨t, ht⟩ := LinearMap.exists_leftInverse_of_injective (LinearMap.range D).subtype
    (Submodule.ker_subtype _)
  refine ⟨s ∘ₗ t, fun v => ?_⟩
  have h1 : t (D v) = D.rangeRestrict v := by
    have := LinearMap.congr_fun ht (D.rangeRestrict v)
    simpa using this
  have h2 := LinearMap.congr_fun hs (D.rangeRestrict v)
  simp only [LinearMap.comp_apply, LinearMap.id_apply] at h2
  simp only [LinearMap.comp_apply, h1]
  have := congrArg Subtype.val h2
  simpa using this

theorem kerSub_iff (δ : LInfty L) (n : ℕ) (D : Module.Dual ℝ (L n) →ₗ[ℝ] Module.Dual ℝ (L (n + 1)))
    (hD : ∀ b, δ.δ (gen L n b) - gen L (n + 1) (D b) ∈ lowAlg L n) (ξ : Module.Dual ℝ (L n)) :
    ξ ∈ kerSub δ n ↔ D ξ = 0 := by
  have hk : ξ ∈ kerSub δ n ↔ δ.δ (gen L n ξ) ∈ lowAlg L n := Iff.rfl
  rw [hk]
  constructor
  · intro h
    apply detGen
    have := Subalgebra.sub_mem _ h (hD ξ)
    convert this using 1
    abel
  · intro h
    have := hD ξ
    rwa [h, map_zero, sub_zero] at this


theorem faceAmb_mem_integ [∀ i, FiniteDimensional ℝ (L i)] {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L)
    (S : GenSys L) (m : ℕ)
    (i : Fin (m + 2)) {z : Amb r S (m + 1)} (hz : z ∈ integ r δ S (m + 1)) :
    faceAmb r S m i z ∈ integ r δ S m := by
  obtain ⟨φ, ⟨hdeg, hcr, hd⟩, hzφ⟩ := hz
  refine ⟨(pullAlg m i).comp φ, ⟨fun t ξ hξ => pull_isDeg i (hdeg t ξ hξ),
    fun a => pull_isCr hr i (hcr a), fun a b hab x hx => ?_⟩, fun t k => ?_⟩
  · show extD (pull m i (φ a)) x = pull m i (φ b) x
    rw [extD_pull hr i (fun I => (hcr a I).1) hx]
    show ExteriorAlgebra.map _ (extD (φ a) (coface m i x)) =
      ExteriorAlgebra.map _ (φ b (coface m i x))
    rw [hd a b hab _ (coface_mem i hx)]
  · exact faceCr_val hr i _ (hdeg _ _ (genBasis S t.castSucc k).2) (hcr _) (hzφ t.castSucc k).symm

theorem hcl_tauLe [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) (n : ℕ) :
    ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLe δ n i → δ.δ (gen L i ξ) ∈ genAlg L (tauLe δ n) :=
  (IntLInfty.Kan.postnikov_genAlg_delta_closed L δ).2.2.1 n

theorem hcl_tauLt [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) (n : ℕ) :
    ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLt δ n i → δ.δ (gen L i ξ) ∈ genAlg L (tauLt δ n) :=
  (IntLInfty.Kan.postnikov_genAlg_delta_closed L δ).2.2.2.1 n

theorem delta_gen_mem_top [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : δ.δ (gen L i ξ) ∈ genAlg L (⊤ : GenSys L) :=
  (IntLInfty.Kan.postnikov_genAlg_delta_closed L δ).2.2.2.2 i ξ

theorem contDiff_coord [∀ i, FiniteDimensional ℝ (L i)] {r m : ℕ} (S : GenSys L) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S t))) : ContDiff ℝ ∞ (fun z : Amb r S m => z t k) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.1 S t k

end Alg

section K2A
variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

noncomputable def Dn (δ : LInfty L) (n : ℕ) :
    Module.Dual ℝ (L n) →ₗ[ℝ] Module.Dual ℝ (L (n + 1)) :=
  (exists_dStar δ n).choose

theorem Dn_spec (δ : LInfty L) (n : ℕ) (b : Module.Dual ℝ (L n)) :
    δ.δ (gen L n b) - gen L (n + 1) (Dn δ n b) ∈ lowAlg L n :=
  (exists_dStar δ n).choose_spec b

noncomputable def secD (δ : LInfty L) (n : ℕ) :
    Module.Dual ℝ (L (n + 1)) →ₗ[ℝ] Module.Dual ℝ (L n) :=
  (exists_genInv (Dn δ n)).choose

theorem Dn_secD (δ : LInfty L) (n : ℕ) (v : Module.Dual ℝ (L n)) :
    Dn δ n (secD δ n (Dn δ n v)) = Dn δ n v :=
  (exists_genInv (Dn δ n)).choose_spec v

theorem mem_kerSub_iff (δ : LInfty L) (n : ℕ) (ξ : Module.Dual ℝ (L n)) :
    ξ ∈ kerSub δ n ↔ Dn δ n ξ = 0 :=
  kerSub_iff δ n _ (Dn_spec δ n) ξ

theorem mem_imSub_iff (δ : LInfty L) (n : ℕ) (ξ : Module.Dual ℝ (L (n + 1))) :
    ξ ∈ imSub δ (n + 1) ↔ ∃ η, Dn δ n η = ξ := by
  constructor
  · intro h
    simp only [imSub, Submodule.mem_map, Submodule.mem_comap] at h
    obtain ⟨⟨η, ξ''⟩, hm, rfl⟩ := h
    refine ⟨η, ?_⟩
    have hm' : δ.δ (gen L n η) - gen L (n + 1) ξ'' ∈ lowAlg L n := hm
    have e : gen L (n + 1) (Dn δ n η - ξ'') =
        (δ.δ (gen L n η) - gen L (n + 1) ξ'') - (δ.δ (gen L n η) - gen L (n + 1) (Dn δ n η)) := by
      rw [map_sub]; abel
    have h1 : gen L (n + 1) (Dn δ n η - ξ'') ∈ lowAlg L n := by
      rw [e]; exact Subalgebra.sub_mem _ hm' (Dn_spec δ n η)
    exact sub_eq_zero.1 (detGen _ h1)
  · rintro ⟨η, rfl⟩
    simp only [imSub, Submodule.mem_map, Submodule.mem_comap]
    exact ⟨(η, Dn δ n η), Dn_spec δ n η, rfl⟩

theorem Dn_secD_of_mem (δ : LInfty L) (n : ℕ) {ξ : Module.Dual ℝ (L (n + 1))}
    (hξ : ξ ∈ imSub δ (n + 1)) : Dn δ n (secD δ n ξ) = ξ := by
  obtain ⟨η, rfl⟩ := (mem_imSub_iff δ n ξ).1 hξ
  exact Dn_secD δ n η

/-- The part of `δ(genₙ η)` in `lowAlg n`. -/
noncomputable def lowPart (δ : LInfty L) (n : ℕ) (η : Module.Dual ℝ (L n)) : CE L :=
  δ.δ (gen L n η) - gen L (n + 1) (Dn δ n η)

theorem lowPart_mem (δ : LInfty L) (n : ℕ) (η : Module.Dual ℝ (L n)) :
    lowPart δ n η ∈ lowAlg L n :=
  Dn_spec δ n η

/-- Generators of degree `≤ n`. -/
noncomputable def S0 (n : ℕ) : GenSys L := fun i => if i ≤ n then ⊤ else ⊥

theorem lowAlg_le_S0 (n : ℕ) : lowAlg L n ≤ genAlg L (S0 n) := by
  unfold lowAlg genAlg
  refine Algebra.adjoin_mono ?_
  intro x hx
  simp only [Set.mem_iUnion, Set.mem_range] at hx
  obtain ⟨k, hk, ξ, rfl⟩ := hx
  exact Set.mem_iUnion.2 ⟨k, ξ, by simp [S0, hk], rfl⟩

theorem mem_tauLt_succ_of_le (δ : LInfty L) {n i : ℕ} (h : i ≤ n) (ξ : Module.Dual ℝ (L i)) :
    ξ ∈ tauLt δ (n + 1) i := by
  simp [tauLt, Nat.lt_succ_of_le h]

theorem mem_tauLe_of_lt (δ : LInfty L) {n i : ℕ} (h : i < n) (ξ : Module.Dual ℝ (L i)) :
    ξ ∈ tauLe δ n i := by
  simp [tauLe, h]

/-- K2 generator-level DGA lemma. -/
theorem k2_hd {r m : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (n : ℕ) (Φ : CE L →ₐ[ℝ] Ω m)
    (hdeg : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLt δ (n + 1) i → IsDeg (i + 1) (Φ (gen L i ξ)))
    (hcr : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLt δ (n + 1) i → IsCr r (Φ (gen L i ξ)))
    (hS' : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLe δ n i →
      ∀ x ∈ simplex m, extD (Φ (gen L i ξ)) x = Φ (δ.δ (gen L i ξ)) x)
    (hF : ∀ ξ : Module.Dual ℝ (L (n + 1)), ξ ∈ imSub δ (n + 1) →
      FormEqOn (Φ (gen L (n + 1) ξ))
        (extD (Φ (gen L n (secD δ n ξ))) - Φ (lowPart δ n (secD δ n ξ)))) :
    ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLt δ (n + 1) i →
      ∀ x ∈ simplex m, extD (Φ (gen L i ξ)) x = Φ (δ.δ (gen L i ξ)) x := by
  have hTop : ∀ ζ : Module.Dual ℝ (L n), ζ ∈ tauLt δ (n + 1) n :=
    mem_tauLt_succ_of_le δ le_rfl
  -- degree `n`, every `ξ`
  have hn : ∀ (ξ : Module.Dual ℝ (L n)), ∀ x ∈ simplex m,
      extD (Φ (gen L n ξ)) x = Φ (δ.δ (gen L n ξ)) x := by
    intro ξ x hx
    obtain ⟨η, hη⟩ : ∃ η, secD δ n (Dn δ n ξ) = η := ⟨_, rfl⟩
    have hDη : Dn δ n η = Dn δ n ξ := hη ▸ Dn_secD δ n ξ
    have hκ : ξ - η ∈ tauLe δ n n := by
      have : ξ - η ∈ kerSub δ n := by
        rw [mem_kerSub_iff, map_sub, hDη, sub_self]
      simpa [tauLe] using this
    have h1 := hS' n _ hκ x hx
    have hIm : Dn δ n ξ ∈ imSub δ (n + 1) := (mem_imSub_iff δ n _).2 ⟨ξ, rfl⟩
    have h2 := hF _ hIm x hx
    rw [hη] at h2
    have e3 : δ.δ (gen L n ξ) =
        δ.δ (gen L n (ξ - η)) + (gen L (n + 1) (Dn δ n ξ) + lowPart δ n η) := by
      rw [lowPart, hDη, map_sub, map_sub]; abel
    have eξ : Φ (gen L n ξ) = Φ (gen L n (ξ - η)) + Φ (gen L n η) := by
      rw [← map_add, ← map_add, sub_add_cancel]
    rw [eξ, A83.extD_add hr (hcr _ _ (hTop _)) (hcr _ _ (hTop _)) hx, h1, e3]
    simp only [map_add, Pi.add_apply, h2, Pi.sub_apply]
    abel
  have hzero : ∀ i, ∀ x ∈ simplex m,
      extD (Φ (gen L i (0 : Module.Dual ℝ (L i)))) x = Φ (δ.δ (gen L i 0)) x := by
    intro i x hx
    simp only [map_zero, Pi.zero_apply]
    exact extD_zero' hr hx
  have hS0 : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S0 n i → i ≤ n ∨ ξ = 0 := by
    intro i ξ h
    by_cases hi : i ≤ n
    · exact Or.inl hi
    · right; simpa [S0, hi] using h
  -- degrees `≤ n`: the DGA property on `lowAlg n`
  have hle : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S0 n i →
      ∀ x ∈ simplex m, extD (Φ (gen L i ξ)) x = Φ (δ.δ (gen L i ξ)) x := by
    intro i ξ hξ x hx
    rcases hS0 i ξ hξ with hi | h0
    · rcases Nat.lt_or_ge i n with h | h
      · exact hS' i ξ (mem_tauLe_of_lt δ h ξ) x hx
      · obtain rfl : i = n := le_antisymm hi h
        exact hn ξ x hx
    · subst h0; exact hzero i x hx
  have hlow : ∀ η : Module.Dual ℝ (L n), IsCr r (Φ (lowPart δ n η)) ∧
      ∀ x ∈ simplex m, extD (Φ (lowPart δ n η)) x = Φ (δ.δ (lowPart δ n η)) x := fun η =>
    dga_of_gen hr δ (S0 n) Φ
      (fun i ξ h => (hS0 i ξ h).elim (fun hi => hdeg i ξ (mem_tauLt_succ_of_le δ hi ξ))
        (fun h0 => by subst h0; simp only [map_zero]; exact A83.isDeg_zero))
      (fun i ξ h => (hS0 i ξ h).elim (fun hi => hcr i ξ (mem_tauLt_succ_of_le δ hi ξ))
        (fun h0 => by subst h0; simp only [map_zero]; exact A83.isCr_zero))
      hle (lowPart δ n η) (lowAlg_le_S0 n (lowPart_mem δ n η))
  intro i ξ hξ x hx
  rcases Nat.lt_or_ge i (n + 1) with h | h
  · rcases Nat.lt_or_ge i n with h' | h'
    · exact hS' i ξ (mem_tauLe_of_lt δ h' ξ) x hx
    · obtain rfl : i = n := by omega
      exact hn ξ x hx
  rcases Nat.lt_or_ge (n + 1) i with h' | h'
  · have h0 : ξ = 0 := by
      simpa [tauLt, show ¬ i < n + 1 by omega, show i ≠ n + 1 by omega] using hξ
    subst h0
    exact hzero i x hx
  obtain rfl : i = n + 1 := by omega
  have hξ' : ξ ∈ imSub δ (n + 1) := by simpa [tauLt] using hξ
  have hηC := hcr n _ (hTop (secD δ n ξ))
  have hL := hlow (secD δ n ξ)
  rw [A83.extD_congr (hF ξ hξ') x hx, extD_sub hr (isCr_extD hr hηC) hL.1 hx,
    A83.extD_extD hr hηC x hx, hL.2 x hx]
  have e : δ.δ (lowPart δ n (secD δ n ξ)) = -δ.δ (gen L (n + 1) ξ) := by
    have hsq : δ.δ (δ.δ (gen L n (secD δ n ξ))) = 0 := LinearMap.congr_fun δ.sq _
    rw [lowPart, map_sub, hsq, Dn_secD_of_mem δ n hξ', zero_sub]
  rw [e, map_neg, Pi.neg_apply, zero_sub, neg_neg]

end K2A

section K2V
variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

/-- `CrForms`-valued generator values of `w : Amb r S m` (degree `≥ m` generators go to `0`). -/
noncomputable def valC {r m : ℕ} (S : GenSys L) (w : Amb r S m) (t : ℕ) :
    Module.Dual ℝ (L t) →ₗ[ℝ] CrForms r m (t + 1) :=
  if h : t < m then
    ∑ k : Fin (Module.finrank ℝ (S t)), LinearMap.smulRight
      ((Finsupp.lapply k).comp ((genBasis S t).repr.toLinearMap.comp (retr S t)))
      (w ⟨t, h⟩ k)
  else 0

theorem valC_lt {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : t < m)
    (ξ : Module.Dual ℝ (L t)) :
    valC S w t ξ = ∑ k : Fin (Module.finrank ℝ (S t)),
      (genBasis S t).repr (retr S t ξ) k • w ⟨t, h⟩ k := by
  simp only [valC, h, ↓reduceDIte, LinearMap.sum_apply,
    LinearMap.smulRight_apply, LinearMap.comp_apply, Finsupp.lapply_apply,
    LinearEquiv.coe_coe]

theorem valC_ge {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : ¬ t < m)
    (ξ : Module.Dual ℝ (L t)) : valC S w t ξ = 0 := by
  simp only [valC, h, ↓reduceDIte, LinearMap.zero_apply]

theorem valC_of_mem {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : t < m)
    {ξ : Module.Dual ℝ (L t)} (hξ : ξ ∈ S t) :
    valC S w t ξ = ∑ k : Fin (Module.finrank ℝ (S t)),
      (genBasis S t).repr ⟨ξ, hξ⟩ k • w ⟨t, h⟩ k := by
  have e : retr S t ξ = ⟨ξ, hξ⟩ := retr_spec S t ⟨ξ, hξ⟩
  rw [valC_lt S w h, e]

theorem valC_basis {r m : ℕ} (S : GenSys L) (w : Amb r S m) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S t))) :
    valC S w t (genBasis S t k : Module.Dual ℝ (L t)) = w t k := by
  rw [valC_of_mem S w t.2 (genBasis S t k).2, Module.Basis.repr_self]
  simp only [Finsupp.single_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
    Finset.mem_univ, ↓reduceIte, Fin.eta]

theorem valC_add {r m : ℕ} (S : GenSys L) (w w' : Amb r S m) (t : ℕ)
    (ξ : Module.Dual ℝ (L t)) : valC S (w + w') t ξ = valC S w t ξ + valC S w' t ξ := by
  by_cases h : t < m
  · rw [valC_lt S _ h, valC_lt S _ h, valC_lt S _ h, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun k _ => smul_add _ _ _
  · rw [valC_ge S _ h, valC_ge S _ h, valC_ge S _ h, add_zero]

theorem valC_smul {r m : ℕ} (S : GenSys L) (c : ℝ) (w : Amb r S m) (t : ℕ)
    (ξ : Module.Dual ℝ (L t)) : valC S (c • w) t ξ = c • valC S w t ξ := by
  by_cases h : t < m
  · rw [valC_lt S _ h, valC_lt S _ h, Finset.smul_sum]
    exact Finset.sum_congr rfl fun k _ => smul_comm (_ : ℝ) c (w ⟨t, h⟩ k)
  · rw [valC_ge S _ h, valC_ge S _ h, smul_zero]

theorem continuous_valC {r m : ℕ} (S : GenSys L) (t : ℕ) (ξ : Module.Dual ℝ (L t)) :
    Continuous fun w : Amb r S m => valC S w t ξ := by
  by_cases h : t < m
  · simp only [valC_lt S _ h]
    exact continuous_finset_sum _ fun k _ =>
      (continuous_const_smul _).comp ((continuous_apply k).comp (continuous_apply (⟨t, h⟩ : Fin m)))
  · simp only [valC_ge S _ h]
    exact continuous_const

/-- `w ↦ valC S w t ξ` as a continuous linear map. -/
noncomputable def valCLM {r : ℕ} (S : GenSys L) (m t : ℕ) (ξ : Module.Dual ℝ (L t)) :
    Amb r S m →L[ℝ] CrForms r m (t + 1) where
  toFun w := valC S w t ξ
  map_add' w w' := valC_add S w w' t ξ
  map_smul' c w := valC_smul S c w t ξ
  cont := continuous_valC S t ξ

theorem valCLM_apply {r : ℕ} (S : GenSys L) (m t : ℕ) (ξ : Module.Dual ℝ (L t))
    (w : Amb r S m) : valCLM S m t ξ w = valC S w t ξ := rfl

/-- Restriction `S' ≤ S` does not change the values on `S'`. -/
theorem valC_res {r m : ℕ} {S S' : GenSys L} (hS : ∀ i, S' i ≤ S i) (w : Amb r S m) (t : ℕ)
    {ξ : Module.Dual ℝ (L t)} (hξ : ξ ∈ S' t) : valC S' (res hS w) t ξ = valC S w t ξ := by
  by_cases h : t < m
  · have e1 : (⟨ξ, hS t hξ⟩ : S t) = Submodule.inclusion (hS t) ⟨ξ, hξ⟩ := rfl
    rw [valC_of_mem S' (res hS w) h hξ, valC_of_mem S w h (hS t hξ), e1]
    conv_rhs => rw [← (genBasis S' t).sum_repr ⟨ξ, hξ⟩]
    simp only [res, map_sum, map_smul, Finsupp.coe_finset_sum, Finsupp.coe_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.smul_sum, Finset.sum_smul, mul_smul]
    exact Finset.sum_comm
  · rw [valC_ge S' _ h, valC_ge S _ h]

/-- The point of the ambient space with prescribed generator values. -/
noncomputable def mkAmb {r m : ℕ} (S : GenSys L)
    (F : ∀ t : ℕ, Module.Dual ℝ (L t) →ₗ[ℝ] CrForms r m (t + 1)) : Amb r S m :=
  fun t k => F t (genBasis S t k)

theorem valC_mkAmb {r m : ℕ} (S : GenSys L)
    (F : ∀ t : ℕ, Module.Dual ℝ (L t) →ₗ[ℝ] CrForms r m (t + 1)) {t : ℕ} (h : t < m)
    {ξ : Module.Dual ℝ (L t)} (hξ : ξ ∈ S t) : valC S (mkAmb S F) t ξ = F t ξ := by
  have e : ξ = ∑ k, (genBasis S t).repr ⟨ξ, hξ⟩ k •
      ((genBasis S t k : S t) : Module.Dual ℝ (L t)) := by
    have h1 := congrArg Subtype.val ((genBasis S t).sum_repr ⟨ξ, hξ⟩)
    rw [Submodule.coe_sum] at h1
    exact h1.symm
  rw [valC_of_mem S _ h hξ]
  conv_rhs => rw [e]
  rw [map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul]
  rfl

end K2V

section K2F
variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem jet_sum_aux {r M : ℕ} (hr : 1 ≤ r) {ι : Type} (s : Finset ι) (f : ι → Ω M)
    (h : ∀ k, IsCr r (f k)) : jet r (∑ k ∈ s, f k) = ∑ k ∈ s, jet r (f k) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp only [Finset.sum_empty]
    exact jet_zero' hr
  · intro a s ha ih
    rw [Finset.sum_insert ha, Finset.sum_insert ha,
      jet_add hr (h a) (isCr_sum hr s f fun k _ => h k), ih]

/-- The jet of a generator value is its `CrForms` value. -/
theorem jet_genVal {r M : ℕ} (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S M) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) :
    jet r (genVal hr S z i ξ) = (valC S z i ξ : Jet r M × Jet r M) := by
  by_cases h : i < M
  · have e : FormEqOn (genVal hr S z i ξ) (rawVal hr S z i ξ) := cutL_eqOn (rawVal hr S z i ξ)
    rw [jet_congr e, rawVal_lt hr S z h, valC_lt S z h,
      jet_sum_aux hr _ _ fun k => isCr_smul hr _ (wRep_spec hr (z ⟨i, h⟩ k)).1.2,
      Submodule.coe_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [jet_smul hr _ (wRep_spec hr (z ⟨i, h⟩ k)).1.2, (wRep_spec hr _).2, Submodule.coe_smul]
  · rw [genVal_ge hr S z (by omega) ξ, valC_ge S z h, jet_zero' hr]
    rfl

theorem genVal_res {r M : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    (z : Amb r S M) (i : ℕ) {ξ : Module.Dual ℝ (L i)} (hξ : ξ ∈ S' i) :
    FormEqOn (genVal hr S' (res h z) i ξ) (genVal hr S z i ξ) :=
  formEqOn_of_jet (isCr_genVal hr S' _ i ξ) (isCr_genVal hr S z i ξ) (by
    rw [jet_genVal, jet_genVal, valC_res h z i hξ])

/-- Two generator maps agreeing on the generators of `S` agree on `A_S` (on the simplex). -/
theorem ceLift_eqOn_gen {M : ℕ} (S : GenSys L) (f g : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω M)
    (hf : GenHom f) (hg : GenHom g)
    (hfg : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → FormEqOn (f i ξ) (g i ξ)) :
    ∀ a (_ : a ∈ Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) ''
      (S i : Set (Module.Dual ℝ (L i))))), FormEqOn (ceLift f hf a) (ceLift g hg a) := by
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
    intro x hx
    rw [ceLift_gen, ceLift_gen]
    exact hfg i ξ hξ x hx
  | algebraMap c =>
    intro x hx
    exact congrFun (((ceLift f hf).commutes c).trans ((ceLift g hg).commutes c).symm) x
  | add y w hy hw ihy ihw =>
    intro x hx
    rw [map_add, map_add, Pi.add_apply, Pi.add_apply, ihy x hx, ihw x hx]
  | mul y w hy hw ihy ihw =>
    intro x hx
    rw [map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, ihy x hx, ihw x hx]

/-- (⊆) A point of `∫_S` satisfies the generator-level DGA condition for `Φ_z`. -/
theorem genCond_of_integ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    {z : Amb r S M} (hz : z ∈ integ r δ S M) (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    ∀ x ∈ simplex M, extD (genVal hr S z i ξ) x =
      ceLift (genVal hr S z) (genHom_genVal hr S z) (δ.δ (gen L i ξ)) x := by
  obtain ⟨φ, hφ, hzφ⟩ := hz
  have hg := fun i ξ hξ => genVal_eqOn_of_integ hr δ S z φ hφ hzφ i ξ hξ
  have hall : ∀ a (ha : a ∈ Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) ''
      (S i : Set (Module.Dual ℝ (L i))))),
      FormEqOn (φ ⟨a, ha⟩) (ceLift (genVal hr S z) (genHom_genVal hr S z) a) := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
      intro x hx
      rw [ceLift_gen]
      exact hg i ξ hξ x hx
    | algebraMap c =>
      intro x hx
      exact congrFun ((φ.commutes c).trans ((ceLift _ _).commutes c).symm) x
    | add y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ + ⟨w, hw⟩) x = ceLift _ _ (y + w) x
      rw [map_add, map_add, Pi.add_apply, Pi.add_apply, ihy x hx, ihw x hx]
    | mul y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ * ⟨w, hw⟩) x = ceLift _ _ (y * w) x
      rw [map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, ihy x hx, ihw x hx]
  intro x hx
  have e1 := (extD_congr (hg i ξ hξ)) x hx
  have e2 := hφ.2.2 ⟨gen L i ξ, gen_mem_genAlg S hξ⟩ ⟨δ.δ (gen L i ξ), hcl _ _ hξ⟩ rfl x hx
  have e3 := hall _ (hcl _ _ hξ) x hx
  rw [← e1, e2, e3]

/-- (⊇) The generator-level DGA condition for `Φ_z` puts `z` in `∫_S`. -/
theorem integ_of_genCond {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M)
    (hd : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → ∀ x ∈ simplex M,
      extD (genVal hr S z i ξ) x =
        ceLift (genVal hr S z) (genHom_genVal hr S z) (δ.δ (gen L i ξ)) x) :
    z ∈ integ r δ S M :=
  ⟨(ceLift (genVal hr S z) (genHom_genVal hr S z)).comp (genAlg L S).val,
    generator_lift_dga.2.2.1 hr δ S (ceLift (genVal hr S z) (genHom_genVal hr S z))
      (fun i ξ _ x _ => by rw [ceLift_gen]; exact genHom_genVal hr S z i ξ x)
      (fun i ξ _ => by rw [ceLift_gen]; exact isCr_genVal hr S z i ξ)
      (fun i ξ hξ x hx => by rw [ceLift_gen]; exact hd i ξ hξ x hx),
    fun t k => by
      show _ = jet r (ceLift (genVal hr S z) (genHom_genVal hr S z) (gen L t (genBasis S t k)))
      rw [ceLift_gen]; exact (jet_genVal_basis hr S z t k).symm⟩

/-! ### The low part `Φ_z(lowPart η)` as a smooth jet family. -/

theorem lowPart_add (δ : LInfty L) (s : ℕ) (a b : Module.Dual ℝ (L s)) :
    lowPart δ s (a + b) = lowPart δ s a + lowPart δ s b := by
  simp only [lowPart, map_add]
  abel

theorem lowPart_smul (δ : LInfty L) (s : ℕ) (c : ℝ) (a : Module.Dual ℝ (L s)) :
    lowPart δ s (c • a) = c • lowPart δ s a := by
  simp only [lowPart, map_smul, smul_sub]

theorem lowPart_deg (δ : LInfty L) (s : ℕ) (η : Module.Dual ℝ (L s)) :
    lowPart δ s η ∈ ceDeg L (s + 1 + 1) :=
  Submodule.sub_mem _ (δ.deg _ _ (gen_mem_ceDeg _ _)) (gen_mem_ceDeg _ _)

theorem lowPart_mem_top (δ : LInfty L) (s : ℕ) (η : Module.Dual ℝ (L s)) :
    lowPart δ s η ∈ genAlg L (⊤ : GenSys L) :=
  Subalgebra.sub_mem _ (delta_gen_mem_top δ s η) (gen_mem_genAlg (⊤ : GenSys L) Submodule.mem_top)

theorem lowFam {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (s : ℕ)
    (η : Module.Dual ℝ (L s)) :
    SmoothFam r (s + 1 + 1) (fun z : Amb r S M =>
      ceLift (genVal hr S z) (genHom_genVal hr S z) (lowPart δ s η)) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr (⊤ : GenSys L)
    (fun z => genVal hr S z) (fun z => genHom_genVal hr S z)
    (fun z => ceLift (genVal hr S z) (genHom_genVal hr S z))
    (fun z => ceLift_gen _ (genHom_genVal hr S z))
    (fun i ξ _ => smoothFam_genVal hr S i ξ) _ (lowPart_mem_top δ s η)
    (fun z y _ => ceLift_mem_deg _ _ (lowPart_deg δ s η) y)

noncomputable def lowJ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M)
    (s : ℕ) (η : Module.Dual ℝ (L s)) : CrForms r M (s + 1 + 1) :=
  (lowFam (M := M) hr δ S s η).choose z

theorem lowJ_spec {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M)
    (s : ℕ) (η : Module.Dual ℝ (L s)) :
    IsCr r (ceLift (genVal hr S z) (genHom_genVal hr S z) (lowPart δ s η)) ∧
      (lowJ hr δ S z s η : Jet r M × Jet r M) =
        jet r (ceLift (genVal hr S z) (genHom_genVal hr S z) (lowPart δ s η)) :=
  ⟨((lowFam (M := M) hr δ S s η).choose_spec.2 z).1.2,
    ((lowFam (M := M) hr δ S s η).choose_spec.2 z).2.symm⟩

theorem contDiff_lowJ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (s : ℕ)
    (η : Module.Dual ℝ (L s)) : ContDiff ℝ ∞ (fun z : Amb r S M => lowJ hr δ S z s η) :=
  (lowFam (M := M) hr δ S s η).choose_spec.1

noncomputable def lowJL {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M)
    (s : ℕ) : Module.Dual ℝ (L s) →ₗ[ℝ] CrForms r M (s + 1 + 1) where
  toFun η := lowJ hr δ S z s η
  map_add' a b := by
    apply Subtype.ext
    rw [Submodule.coe_add, (lowJ_spec hr δ S z s (a + b)).2, (lowJ_spec hr δ S z s a).2,
      (lowJ_spec hr δ S z s b).2, lowPart_add, map_add,
      jet_add hr (lowJ_spec hr δ S z s a).1 (lowJ_spec hr δ S z s b).1]
  map_smul' c a := by
    apply Subtype.ext
    rw [RingHom.id_apply, Submodule.coe_smul, (lowJ_spec hr δ S z s (c • a)).2,
      (lowJ_spec hr δ S z s a).2, lowPart_smul, map_smul,
      jet_smul hr c (lowJ_spec hr δ S z s a).1]

/-- The forced generator values: `ξ ↦ d(val (s ξ)) - Φ(lowPart (s ξ))` in degree `s + 1`. -/
noncomputable def fcL {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M) :
    (t : ℕ) → Module.Dual ℝ (L t) →ₗ[ℝ] CrForms r M (t + 1)
  | 0 => 0
  | s + 1 => (dCLM (m := M) hr (s + 1)).toLinearMap ∘ₗ valC S z s ∘ₗ secD δ s -
      lowJL hr δ S z s ∘ₗ secD δ s

/-- Replace the degree-`n+1` coordinates by the forced values. -/
noncomputable def forceZ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) : Amb r S M :=
  mkAmb S fun t => if t = n + 1 then fcL hr δ S z t else valC S z t

theorem forceZ_apply_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) (t : Fin M) (ht : (t : ℕ) ≠ n + 1) (k : Fin (Module.finrank ℝ (S t))) :
    forceZ hr δ S n z t k = z t k := by
  show (if (t : ℕ) = n + 1 then fcL hr δ S z t else valC S z t) (genBasis S t k) = z t k
  rw [if_neg ht, valC_basis]

theorem forceZ_apply_eq {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) (t : Fin M) (ht : (t : ℕ) = n + 1) (k : Fin (Module.finrank ℝ (S t))) :
    forceZ hr δ S n z t k = fcL hr δ S z t (genBasis S t k) := by
  show (if (t : ℕ) = n + 1 then fcL hr δ S z t else valC S z t) (genBasis S t k) = _
  rw [if_pos ht]

theorem valC_forceZ_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) {t : ℕ} (ht : t ≠ n + 1) (ξ : Module.Dual ℝ (L t)) :
    valC S (forceZ hr δ S n z) t ξ = valC S z t ξ := by
  by_cases h : t < M
  · rw [valC_lt S _ h, valC_lt S _ h]
    exact Finset.sum_congr rfl fun k _ => by rw [forceZ_apply_ne hr δ S n z ⟨t, h⟩ ht k]
  · rw [valC_ge S _ h, valC_ge S _ h]

theorem valC_forceZ_eq {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) (hM : n + 1 < M) {ξ : Module.Dual ℝ (L (n + 1))} (hξ : ξ ∈ S (n + 1)) :
    valC S (forceZ hr δ S n z) (n + 1) ξ = fcL hr δ S z (n + 1) ξ := by
  rw [forceZ, valC_mkAmb S _ hM hξ, if_pos rfl]

/-- (c) On `∫_S` the degree-`n+1` values are the forced ones. -/
theorem fcL_eq_valC_of_integ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    (hSn : ∀ η : Module.Dual ℝ (L n), η ∈ S n)
    (hSn1 : ∀ ξ : Module.Dual ℝ (L (n + 1)), ξ ∈ S (n + 1) → ξ ∈ imSub δ (n + 1))
    {w : Amb r S M} (hw : w ∈ integ r δ S M) {ξ : Module.Dual ℝ (L (n + 1))}
    (hξ : ξ ∈ S (n + 1)) : fcL hr δ S w (n + 1) ξ = valC S w (n + 1) ξ := by
  apply Subtype.ext
  have hCn := isCr_genVal hr S w n (secD δ n ξ)
  have hlow := lowJ_spec hr δ S w n (secD δ n ξ)
  have e1 : (fcL hr δ S w (n + 1) ξ : Jet r M × Jet r M) =
      jet r (extD (genVal hr S w n (secD δ n ξ))) -
        jet r (ceLift (genVal hr S w) (genHom_genVal hr S w) (lowPart δ n (secD δ n ξ))) := by
    show (dCLM hr (n + 1) (valC S w n (secD δ n ξ)) : Jet r M × Jet r M) -
      (lowJ hr δ S w n (secD δ n ξ) : Jet r M × Jet r M) = _
    rw [dLin_val hr _ hCn (jet_genVal hr S w n (secD δ n ξ)), hlow.2]
  rw [e1, ← jet_sub' hr (isCr_extD hr hCn) hlow.1, ← jet_genVal hr S w (n + 1) ξ]
  refine jet_congr fun x hx => ?_
  have e : δ.δ (gen L n (secD δ n ξ)) = lowPart δ n (secD δ n ξ) + gen L (n + 1) ξ := by
    rw [lowPart, Dn_secD_of_mem δ n (hSn1 ξ hξ)]
    abel
  rw [Pi.sub_apply, genCond_of_integ hr δ S hcl hw n _ (hSn _) x hx, e, map_add, Pi.add_apply,
    ceLift_gen]
  abel

theorem forceZ_of_integ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    (hSn : ∀ η : Module.Dual ℝ (L n), η ∈ S n)
    (hSn1 : ∀ ξ : Module.Dual ℝ (L (n + 1)), ξ ∈ S (n + 1) → ξ ∈ imSub δ (n + 1))
    {w : Amb r S M} (hw : w ∈ integ r δ S M) : forceZ hr δ S n w = w := by
  funext t k
  by_cases ht : (t : ℕ) = n + 1
  · rw [forceZ_apply_eq hr δ S n w t ht k, ← valC_basis S w t k]
    have key : ∀ (t' : ℕ) (_ : t' = n + 1) (_ : t' < M) (ξ : Module.Dual ℝ (L t')), ξ ∈ S t' →
        fcL hr δ S w t' ξ = valC S w t' ξ := by
      intro t' ht' _ ξ hξ
      subst ht'
      exact fcL_eq_valC_of_integ hr δ S n hcl hSn hSn1 hw hξ
    exact key t ht t.2 _ (genBasis S t k).2
  · exact forceZ_apply_ne hr δ S n w t ht k

theorem contDiff_fcL {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (t : ℕ)
    (ξ : Module.Dual ℝ (L t)) : ContDiff ℝ ∞ (fun z : Amb r S M => fcL hr δ S z t ξ) := by
  cases t with
  | zero => exact contDiff_const
  | succ s =>
    show ContDiff ℝ ∞ (fun z : Amb r S M => dCLM (m := M) hr (s + 1)
      (valCLM S M s (secD δ s ξ) z) - lowJ hr δ S z s (secD δ s ξ))
    exact ((dCLM (m := M) hr (s + 1)).contDiff.comp (valCLM S M s (secD δ s ξ)).contDiff).sub
      (contDiff_lowJ hr δ S s _)

theorem contDiff_forceZ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ) :
    ContDiff ℝ ∞ (forceZ (M := M) hr δ S n) := by
  refine contDiff_pi.2 fun t => contDiff_pi.2 fun k => ?_
  by_cases ht : (t : ℕ) = n + 1
  · have e : (fun z : Amb r S M => forceZ hr δ S n z t k) =
        fun z => fcL hr δ S z t (genBasis S t k) :=
      funext fun z => forceZ_apply_eq hr δ S n z t ht k
    rw [e]
    exact contDiff_fcL hr δ S t _
  · have e : (fun z : Amb r S M => forceZ hr δ S n z t k) = fun z => z t k :=
      funext fun z => forceZ_apply_ne hr δ S n z t ht k
    rw [e]
    exact contDiff_coord S t k

theorem genVal_forceZ_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) {i : ℕ} (hi : i ≠ n + 1) :
    genVal hr S (forceZ hr δ S n z) i = genVal hr S z i := by
  have e : rawVal hr S (forceZ hr δ S n z) i = rawVal hr S z i := by
    refine LinearMap.ext fun ξ => ?_
    by_cases h : i < M
    · rw [rawVal_lt hr S _ h, rawVal_lt hr S _ h]
      exact Finset.sum_congr rfl fun k _ => by rw [forceZ_apply_ne hr δ S n z ⟨i, h⟩ hi k]
    · rw [rawVal_ge hr S _ h, rawVal_ge hr S _ h]
  show cutL ∘ₗ rawVal hr S (forceZ hr δ S n z) i = cutL ∘ₗ rawVal hr S z i
  rw [e]

theorem lowPart_eqOn_forceZ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    (z : Amb r S M) (η : Module.Dual ℝ (L n)) :
    FormEqOn (ceLift (genVal hr S (forceZ hr δ S n z)) (genHom_genVal hr S _) (lowPart δ n η))
      (ceLift (genVal hr S z) (genHom_genVal hr S z) (lowPart δ n η)) :=
  ceLift_eqOn_gen (S0 n) _ _ _ _ (fun i ξ hξ => by
    by_cases hi : i = n + 1
    · have h0 : ξ = 0 := by
        subst hi
        simpa [S0] using hξ
      subst h0
      intro x _
      simp only [map_zero]
    · rw [genVal_forceZ_ne hr δ S n z hi]
      exact fun _ _ => rfl) _ (lowAlg_le_S0 n (lowPart_mem δ n η))


theorem res_forceZ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (n : ℕ)
    (h : ∀ i, tauLe δ n i ≤ tauLt δ (n + 1) i) (z : Amb r (tauLt δ (n + 1)) M) :
    res h (forceZ hr δ (tauLt δ (n + 1)) n z) = res h z := by
  funext t k
  by_cases ht : (t : ℕ) = n + 1
  · have hb : tauLe δ n t = ⊥ := by simp [tauLe, ht]
    have h0 : Submodule.inclusion (h t) (genBasis (tauLe δ n) t k) = 0 := by
      apply Subtype.ext
      exact (Submodule.mem_bot ℝ).1 (hb.le (genBasis (tauLe δ n) t k).2)
    simp only [res, h0, map_zero, Finsupp.coe_zero, Pi.zero_apply, zero_smul]
  · simp only [res]
    exact Finset.sum_congr rfl fun l _ => by rw [forceZ_apply_ne hr δ _ n z t ht l]

set_option maxHeartbeats 1000000 in
/-- (d) The forced point is integrable when its `tauLe n` part is. -/
theorem integ_forceZ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (n : ℕ)
    (h : ∀ i, tauLe δ n i ≤ tauLt δ (n + 1) i) (z : Amb r (tauLt δ (n + 1)) M)
    (hres : res h z ∈ integ r δ (tauLe δ n) M) :
    forceZ hr δ (tauLt δ (n + 1)) n z ∈ integ r δ (tauLt δ (n + 1)) M := by
  have hresw : res h (forceZ hr δ (tauLt δ (n + 1)) n z) ∈ integ r δ (tauLe δ n) M := by
    rw [res_forceZ hr δ n h z]
    exact hres
  refine integ_of_genCond hr δ (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) fun i ξ hξ x hx => ?_
  have key := k2_hd hr δ n (ceLift (genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z)) (genHom_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z)))
    (fun i ξ _ x _ => by rw [ceLift_gen]; exact genHom_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) i ξ x)
    (fun i ξ _ => by rw [ceLift_gen]; exact isCr_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) i ξ)
    (fun i ξ hξ x hx => by
      rw [ceLift_gen, ← extD_congr (genVal_res hr h (forceZ hr δ (tauLt δ (n + 1)) n z) i hξ) x hx,
        genCond_of_integ hr δ (tauLe δ n) (hcl_tauLe δ n) hresw i ξ hξ x hx]
      exact ceLift_eqOn_gen (tauLe δ n) _ _ _ _ (fun i ξ hξ => genVal_res hr h (forceZ hr δ (tauLt δ (n + 1)) n z) i hξ) _
        (hcl_tauLe δ n i ξ hξ) x hx)
    (fun ξ hξ => by
      rw [ceLift_gen, ceLift_gen]
      have hξS : ξ ∈ tauLt δ (n + 1) (n + 1) := by simpa [tauLt] using hξ
      have hCn := isCr_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) n (secD δ n ξ)
      have hlow := lowJ_spec hr δ (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) n (secD δ n ξ)
      by_cases hM : n + 1 < M
      · refine formEqOn_of_jet (isCr_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) (n + 1) ξ)
          (isCr_sub hr (isCr_extD hr hCn) hlow.1) ?_
        have hlz := lowJ_spec hr δ (tauLt δ (n + 1)) z n (secD δ n ξ)
        rw [jet_genVal, valC_forceZ_eq hr δ _ n z hM hξS,
          jet_sub' hr (isCr_extD hr hCn) hlow.1,
          ← dLin_val hr _ hCn (jet_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) n (secD δ n ξ)),
          jet_congr (lowPart_eqOn_forceZ hr δ (tauLt δ (n + 1)) n z (secD δ n ξ)), ← hlz.2,
          valC_forceZ_ne hr δ _ n z (by omega)]
        rfl
      · intro x hx
        have hD : IsDeg (n + 1 + 1) (extD (genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) n (secD δ n ξ)) -
            ceLift (genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z)) (genHom_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z)) (lowPart δ n (secD δ n ξ))) :=
          isDeg_sub (isDeg_extD hr hCn fun y _ => genHom_genVal hr (tauLt δ (n + 1)) (forceZ hr δ (tauLt δ (n + 1)) n z) n _ y)
            (fun y _ => ceLift_mem_deg _ _ (lowPart_deg δ n _) y)
        rw [genVal_ge hr _ _ (by omega) ξ, Pi.zero_apply]
        exact (alg_eq_zero_of_lt (p := n + 1 + 1) (by omega) (hD x hx)).symm)
    i ξ hξ x hx
  rw [ceLift_gen] at key
  exact key


theorem valC_congr_ne {r M : ℕ} (S : GenSys L) (n : ℕ) {w1 w2 : Amb r S M}
    (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k) {t : ℕ} (ht : t ≠ n + 1)
    (ξ : Module.Dual ℝ (L t)) : valC S w1 t ξ = valC S w2 t ξ := by
  by_cases h : t < M
  · rw [valC_lt S _ h, valC_lt S _ h]
    exact Finset.sum_congr rfl fun k _ => by rw [hw ⟨t, h⟩ k ht]
  · rw [valC_ge S _ h, valC_ge S _ h]

theorem genVal_congr_ne {r M : ℕ} (hr : 1 ≤ r) (S : GenSys L) (n : ℕ) {w1 w2 : Amb r S M}
    (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k) {i : ℕ} (hi : i ≠ n + 1) :
    genVal hr S w1 i = genVal hr S w2 i := by
  have e : rawVal hr S w1 i = rawVal hr S w2 i := by
    refine LinearMap.ext fun ξ => ?_
    by_cases h : i < M
    · rw [rawVal_lt hr S _ h, rawVal_lt hr S _ h]
      exact Finset.sum_congr rfl fun k _ => by rw [hw ⟨i, h⟩ k hi]
    · rw [rawVal_ge hr S _ h, rawVal_ge hr S _ h]
  show cutL ∘ₗ rawVal hr S w1 i = cutL ∘ₗ rawVal hr S w2 i
  rw [e]

theorem lowJ_congr_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    {w1 w2 : Amb r S M} (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k)
    (η : Module.Dual ℝ (L n)) : lowJ hr δ S w1 n η = lowJ hr δ S w2 n η := by
  apply Subtype.ext
  rw [(lowJ_spec hr δ S w1 n η).2, (lowJ_spec hr δ S w2 n η).2]
  exact jet_congr (ceLift_eqOn_gen (S0 n) _ _ _ _ (fun i ξ hξ => by
    by_cases hi : i = n + 1
    · have h0 : ξ = 0 := by
        subst hi
        simpa [S0] using hξ
      subst h0
      intro x _
      simp only [map_zero]
    · rw [genVal_congr_ne hr S n hw hi]
      exact fun _ _ => rfl) _ (lowAlg_le_S0 n (lowPart_mem δ n η)))

theorem fcL_congr_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    {w1 w2 : Amb r S M} (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k) :
    ∀ s, s = n + 1 → fcL hr δ S w1 s = fcL hr δ S w2 s := by
  rintro s rfl
  have e1 : valC S w1 n = valC S w2 n :=
    LinearMap.ext fun ξ => valC_congr_ne S n hw (by omega) ξ
  have e2 : lowJL hr δ S w1 n = lowJL hr δ S w2 n :=
    LinearMap.ext fun η => lowJ_congr_ne hr δ S n hw η
  show (dCLM (m := M) hr (n + 1)).toLinearMap ∘ₗ valC S w1 n ∘ₗ secD δ n -
      lowJL hr δ S w1 n ∘ₗ secD δ n =
    (dCLM (m := M) hr (n + 1)).toLinearMap ∘ₗ valC S w2 n ∘ₗ secD δ n -
      lowJL hr δ S w2 n ∘ₗ secD δ n
  rw [e1, e2]

theorem forceZ_congr {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (n : ℕ)
    {w1 w2 : Amb r S M} (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k) :
    forceZ hr δ S n w1 = forceZ hr δ S n w2 := by
  funext t k
  by_cases ht : (t : ℕ) = n + 1
  · rw [forceZ_apply_eq hr δ S n w1 t ht, forceZ_apply_eq hr δ S n w2 t ht]
    exact LinearMap.congr_fun (fcL_congr_ne hr δ S n hw _ ht) _
  · rw [forceZ_apply_ne hr δ S n w1 t ht, forceZ_apply_ne hr δ S n w2 t ht, hw t k ht]

theorem eq_of_integ_ne {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (n : ℕ)
    {w1 w2 : Amb r (tauLt δ (n + 1)) M}
    (h1 : w1 ∈ integ r δ (tauLt δ (n + 1)) M) (h2 : w2 ∈ integ r δ (tauLt δ (n + 1)) M)
    (hw : ∀ (t : Fin M) k, (t : ℕ) ≠ n + 1 → w1 t k = w2 t k) : w1 = w2 := by
  have hSn : ∀ η : Module.Dual ℝ (L n), η ∈ tauLt δ (n + 1) n := fun η => by simp [tauLt]
  have hSn1 : ∀ ξ : Module.Dual ℝ (L (n + 1)), ξ ∈ tauLt δ (n + 1) (n + 1) →
      ξ ∈ imSub δ (n + 1) := fun ξ hξ => by simpa [tauLt] using hξ
  rw [← forceZ_of_integ hr δ _ n (hcl_tauLt δ (n + 1)) hSn hSn1 h1,
    ← forceZ_of_integ hr δ _ n (hcl_tauLt δ (n + 1)) hSn hSn1 h2]
  exact forceZ_congr hr δ _ n hw


end K2F

end IntLInfty.Kan.K2U

open IntLInfty.Kan IntLInfty.Kan.A83 IntLInfty.Kan.A83I1 IntLInfty.Kan.K2U in
theorem solution (r : ℕ) (hr : 1 ≤ r) (L : ℕ → Type) [∀ i, AddCommGroup (L i)]
    [∀ i, Module ℝ (L i)] [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) (n : ℕ)
    (h : ∀ i, tauLe δ n i ≤ tauLt δ (n + 1) i) (m : ℕ) (j : Fin (m + 2)) :
    ∃ σ : Amb r (tauLt δ (n + 1)) (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r (tauLt δ (n + 1)) m) × Amb r (tauLe δ n) (m + 1)) →
        Amb r (tauLt δ (n + 1)) (m + 1),
      (∀ x, ContDiff ℝ ∞ (σ x)) ∧
      (∀ x ∈ integ r δ (tauLt δ (n + 1)) (m + 1), ∀ y ∈ RelHorn r δ h m j,
          σ x y ∈ integ r δ (tauLt δ (n + 1)) (m + 1) ∧ kanMap h m j (σ x y) = y) ∧
      (∀ x ∈ integ r δ (tauLt δ (n + 1)) (m + 1), σ x (kanMap h m j x) = x) := by
  obtain ⟨Z, hZc, hZres, hZface, hZkan⟩ :=
    (IntLInfty.Kan.linear_horn_filler_ambient r hr L (tauLt δ (n + 1)) (tauLe δ n) h).1 m j
  have hSn : ∀ η : Module.Dual ℝ (L n), η ∈ tauLt δ (n + 1) n := fun η => by simp [tauLt]
  have hSn1 : ∀ ξ : Module.Dual ℝ (L (n + 1)), ξ ∈ tauLt δ (n + 1) (n + 1) →
      ξ ∈ imSub δ (n + 1) := fun ξ hξ => by simpa [tauLt] using hξ
  refine ⟨fun x y => forceZ hr δ (tauLt δ (n + 1)) n (Z x y), fun x => ?_,
    fun x _ y hy => ?_, fun x hx => ?_⟩
  · exact (contDiff_forceZ hr δ _ n).comp (hZc x)
  · obtain ⟨hy1, hy2, hy3, hy4⟩ := hy
    have hres : res h (Z x y) = y.2 := hZres x y
    have hint := integ_forceZ hr δ n h (Z x y) (by rw [hres]; exact hy2)
    refine ⟨hint, Prod.ext ?_ ?_⟩
    · funext i
      show faceAmb r _ m i.1 (forceZ hr δ _ n (Z x y)) = y.1 i
      refine eq_of_integ_ne hr δ n (faceAmb_mem_integ hr δ _ m i.1 hint) (hy1 i)
        fun t k ht => ?_
      rw [← hZface x y hy3 hy4 i]
      show faceCr r m (t + 1) i.1 (forceZ hr δ _ n (Z x y) t.castSucc k) =
        faceCr r m (t + 1) i.1 (Z x y t.castSucc k)
      rw [forceZ_apply_ne hr δ _ n _ t.castSucc ht k]
    · show res h (forceZ hr δ _ n (Z x y)) = y.2
      rw [res_forceZ hr δ n, hres]
  · show forceZ hr δ _ n (Z x (kanMap h m j x)) = x
    rw [hZkan x]
    exact forceZ_of_integ hr δ _ n (hcl_tauLt δ (n + 1)) hSn hSn1 hx
