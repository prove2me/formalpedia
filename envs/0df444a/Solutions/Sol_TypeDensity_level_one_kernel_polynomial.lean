      (∀ s, Module.length R (TypeDensity.BlowupChart R t x ⧸ P s) = ((φ s).natDegree : ℕ∞)) ∧
      (∀ s, Module.length (TypeDensity.CompletedLocalAt (TypeDensity.BlowupChart R t x) (P s))
        (TypeDensity.CompletedLocalAt (TypeDensity.BlowupChart R t x) (P s) ⧸
          TypeDensity.finiteLocalCurveIdeal (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) (g s) 1) =
        (m s : ℕ∞)) ∧
      ((⨅ s, TypeDensity.contractedLocalCurveIdeal (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) (g s) 1).map
        (Ideal.Quotient.mk (TypeDensity.chartExceptional R t x))).map e = Ideal.span {∏ᶠ s, φ s ^ m s} := by
