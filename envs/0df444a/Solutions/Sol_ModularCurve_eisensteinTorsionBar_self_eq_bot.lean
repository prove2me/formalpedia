namespace CEISN

open ModularCurve

private theorem pow_smul_eq_pow_zsmul {R : Type*} [Semiring R] {M : Type*} [AddCommGroup M] [Module R M]
    (i : R) (n : ℤ) (h : ∀ x : M, i • x = n • x) :
    ∀ (k : ℕ) (x : M), i ^ k • x = n ^ k • x := by
  intro k
  induction k with
  | zero => intro x; rw [pow_zero, pow_zero, one_smul, one_smul]
  | succ k ih => intro x; rw [pow_succ, mul_smul, h, ih, smul_smul, ← pow_succ]

private theorem eq_zero_of_coprime_of_smul_eq_zero {M : Type*} [AddCommGroup M] {a b : ℕ}
    (hab : a.Coprime b) (x : M) (ha : (a : ℤ) • x = 0) (hb : (b : ℤ) • x = 0) : x = 0 := by
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hab
  calc x = (1 : ℤ) • x := (one_smul ℤ x).symm
    _ = (u * a + v * b) • x := by rw [huv]
    _ = 0 := by rw [add_smul, mul_smul, mul_smul, ha, hb, smul_zero, smul_zero, add_zero]

private theorem eisensteinNumerator_coprime_self (p : ℕ) [hp : Fact p.Prime] :
    (eisensteinNumerator p).Coprime p := by
  have h1 : 1 < p := hp.out.one_lt
  have hd : eisensteinNumerator p ∣ p - 1 := eisensteinNumerator_dvd p
  have hn : eisensteinNumerator p ≠ 0 := by
    intro h0
    rw [h0] at hd
    have := Nat.eq_zero_of_zero_dvd hd
    omega
  have hle : eisensteinNumerator p ≤ p - 1 := Nat.le_of_dvd (by omega) hd
  have hnd : ¬ p ∣ eisensteinNumerator p := fun h =>
    absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero hn) h) (by omega)
  exact ((Nat.Prime.coprime_iff_not_dvd hp.out).mpr hnd).symm

private theorem mem_eisensteinMaximalIdeal_of_mem_eisensteinIdeal (N q : ℕ) {i : HeckeAlg}
    (hi : i ∈ eisensteinIdeal N) : i ∈ eisensteinMaximalIdeal N q := by
  have hi' : i ∈ eigenIdeal (eisensteinSystem N) := hi
  have h0 : MvPolynomial.aeval (R := ℤ) (eisensteinSystem N) i = 0 := (mem_eigenIdeal_iff _ _).mp hi'
  rw [mem_eisensteinMaximalIdeal_iff, show eisensteinEval N i = 0 from h0]
  exact dvd_zero _

private theorem natCast_pow_eq_C (p m : ℕ) : ((p : HeckeAlg) ^ m : HeckeAlg) = MvPolynomial.C ((p : ℤ) ^ m) := by
  rw [map_pow, map_natCast]

end CEISN

open ModularCurve

theorem solution
    (p : ℕ) [Fact p.Prime] (m : ℕ) :
    eisensteinTorsionBar p p m = ⊥ := by
  letI := heckeModuleBar p
  obtain ⟨i, hi, hix⟩ := ModularCurve.exists_mem_eisensteinIdeal_smul_eq_eisensteinNumerator_zsmul p
  refine (AddSubgroup.eq_bot_iff_forall _).mpr fun x hx => ?_
  have hx0 : x ∈ Submodule.torsionBySet HeckeAlg (JZero p)
      (↑((eisensteinMaximalIdeal p p) ^ m) : Set HeckeAlg) := hx
  have hx' : ∀ t ∈ (eisensteinMaximalIdeal p p) ^ m, t • x = 0 := fun t ht =>
    (Submodule.mem_torsionBySet_iff _ _).mp hx0 ⟨t, ht⟩
  have hiP : i ∈ eisensteinMaximalIdeal p p :=
    CEISN.mem_eisensteinMaximalIdeal_of_mem_eisensteinIdeal p p hi
  have h1 : i ^ m • x = 0 := hx' _ (Ideal.pow_mem_pow hiP m)
  have h2 : (p : HeckeAlg) ^ m • x = 0 := hx' _ (Ideal.pow_mem_pow (natCast_mem_eisensteinMaximalIdeal p p) m)
  have h1' : ((eisensteinNumerator p : ℤ) ^ m) • x = 0 := by
    rw [← CEISN.pow_smul_eq_pow_zsmul i _ hix m x]
    exact h1
  have h2' : ((p : ℤ) ^ m) • x = 0 := by
    rw [CEISN.natCast_pow_eq_C, heckeModuleBar_C_smul] at h2
    exact h2
  have hcop : ((eisensteinNumerator p) ^ m).Coprime (p ^ m) :=
    Nat.Coprime.pow m m (CEISN.eisensteinNumerator_coprime_self p)
  exact CEISN.eq_zero_of_coprime_of_smul_eq_zero hcop x (by exact_mod_cast h1') (by exact_mod_cast h2')

end S_ModularCurve_eisensteinTorsionBar_self_eq_bot
