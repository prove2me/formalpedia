@[simp] theorem length_selOpF (st : ι → ℕ) (n : ℕ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ)
    (xs : List M) : (selOpF st n T xs).length = n := by simp [selOpF]

