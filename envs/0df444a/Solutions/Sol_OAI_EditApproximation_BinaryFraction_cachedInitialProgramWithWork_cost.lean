theorem initialScaleGuardWithWork_cost (U b B : ℕ) (A : BinaryFraction)
    (hB : 8 ≤ B) (hU : Nat.size U + 2 ≤ B) (hb : Nat.size b + 2 ≤ B) (hA : A.width ≤ B) :
