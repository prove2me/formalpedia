variable {n r : ℕ} (I J : Finset (Fin n))
/-! ## The application -/
/-- Position of `i` in `I` (number of smaller elements). -/
def pos (I : Finset (Fin n)) (i : Fin n) : ℕ := (I.filter (· < i)).card

theorem pos_lt {I : Finset (Fin n)} {i : Fin n} (hi : i ∈ I) : pos I i < I.card :=
  Finset.card_lt_card (Finset.filter_ssubset.2 ⟨i, hi, lt_irrefl i⟩)

/-- Index set of the generators: pairs `(i, j) ∈ I × J`. -/
def Idx (I J : Finset (Fin n)) := {ij : Fin n × Fin n // ij.1 ∈ I ∧ ij.2 ∈ J}

instance (I J : Finset (Fin n)) : Fintype (Idx I J) := by unfold Idx; infer_instance

/-- The column `p(i) + q(j)` of the leading monomial of `xy i j`. -/
def col (hIJ : I.card + J.card ≤ r) (ij : Idx I J) : Fin r :=
  ⟨pos I ij.1.1 + pos J ij.1.2,
    by have := pos_lt ij.2.1; have := pos_lt ij.2.2; omega⟩

/-- The weight. -/
def wt (I J : Finset (Fin n)) (r : ℕ) : Var n r → ℕ
  | Sum.inl (i, k) => if i ∈ I then 2 * pos I i * k.val + (r * r - k.val * k.val) else 0
  | Sum.inr (j, k) => if j ∈ J then 2 * pos J j * k.val else 0

/-- Leading monomial `x_{i,p+q} y_{j,p+q}` of the generator `xy i j`. -/
def mu (hIJ : I.card + J.card ≤ r) (ij : Idx I J) : Var n r →₀ ℕ :=
  Finsupp.single (Sum.inl (ij.1.1, col I J hIJ ij)) 1 +
    Finsupp.single (Sum.inr (ij.1.2, col I J hIJ ij)) 1

/-- The generators. -/
def gen (ij : Idx I J) : Poly n r := xy ij.1.1 ij.1.2

end SoSLinAlg.WeakRank.Dev.Leaf
end
end

section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartT
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
theorem pos_strict {n : ℕ} {I : Finset (Fin n)} {i i' : Fin n} (hi : i ∈ I) (h : i < i') :
    pos I i < pos I i' := by
  unfold pos
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_of_subset]
  · exact ⟨i, by simp [hi, h], by simp⟩
  · intro x hx
    simp only [Finset.mem_filter] at hx ⊢
    exact ⟨hx.1, hx.2.trans h⟩

theorem pos_inj {n : ℕ} {I : Finset (Fin n)} {i i' : Fin n} (hi : i ∈ I) (hi' : i' ∈ I)
    (h : pos I i = pos I i') : i = i' := by
  rcases lt_trichotomy i i' with h1 | h1 | h1
  · exact absurd h (pos_strict hi h1).ne
  · exact h1
  · exact absurd h (pos_strict hi' h1).ne'

theorem weight_two {σ : Type*} (w : σ → ℕ) (a b : σ) :
    Finsupp.weight w (Finsupp.single a 1 + Finsupp.single b 1) = w a + w b := by
  rw [map_add, Finsupp.weight_single, Finsupp.weight_single]; simp

theorem xy_eq {n r : ℕ} (i j : Fin n) :
    (xy i j : Poly n r) = ∑ k : Fin r,
      monomial (Finsupp.single (Sum.inl (i, k)) 1 + Finsupp.single (Sum.inr (j, k)) 1) 1 := by
  unfold xy x y
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [X, X, monomial_mul, one_mul]

theorem wt_ineq (p q k c r : ℕ) (hc : c = p + q) (hcr : c < r) (hkr : k < r) (hk : k ≠ c) :
    2 * p * k + (r * r - k * k) + 2 * q * k < 2 * p * c + (r * r - c * c) + 2 * q * c := by
  have h1 : k * k ≤ r * r := Nat.mul_le_mul hkr.le hkr.le
  have h2 : c * c ≤ r * r := Nat.mul_le_mul hcr.le hcr.le
  zify [h1, h2]
  have : (0 : ℤ) < ((k : ℤ) - c) ^ 2 := by
    have : (k : ℤ) - c ≠ 0 := by omega
    positivity
  subst hc
  push_cast at this ⊢
  nlinarith

theorem gen_top {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) (ij : Idx I J) :
    TopTerm (wt I J r) (gen I J ij) (mu I J hIJ ij) := by
  classical
  intro s hs
  set c := col I J hIJ ij
  have hsum : gen I J ij - monomial (mu I J hIJ ij) 1 = ∑ k ∈ Finset.univ.erase c,
      monomial (Finsupp.single (Sum.inl (ij.1.1, k)) 1 + Finsupp.single (Sum.inr (ij.1.2, k)) 1)
        (1 : ℝ) := by
    rw [gen, xy_eq, ← Finset.add_sum_erase _ _ (Finset.mem_univ c)]
    simp [mu, c]
  rw [hsum] at hs
  have hs' := support_sum hs
  simp only [Finset.mem_biUnion, Finset.mem_erase] at hs'
  obtain ⟨k, ⟨hk, -⟩, hk2⟩ := hs'
  rw [Finset.mem_singleton.mp (support_monomial_subset hk2), mu, weight_two, weight_two]
  simp only [wt, if_pos ij.2.1, if_pos ij.2.2]
  apply wt_ineq (pos I ij.1.1) (pos J ij.1.2) k.val c.val r rfl c.2 k.2
  exact fun h => hk (Fin.ext h)

end SoSLinAlg.WeakRank.Dev.Leaf.PartT
end
