theorem NLogN.KFZ.M_runs (j : Fin (7 + E)) (d18 : Fin HS) (hd0 : d18 ≠ 0) {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n)
    {p h d σ K B : ℕ} (hB : RB p h d σ K B) (hd : d = IntMul.OpenAI.Glue.dP n) (hdp : d - σ = dpN n)
    (hr : 2 ^ (h + 1) = IntMul.OpenAI.Glue.rP n) (hK : K = KP n) (hl : h + 1 = ℓP n) (hb : p / 6 = bP n)
    (hp : p = pP n) (Bd : ℕ) (hBd : ∀ x ∈ desc18 (pP n) (ℓP n) (KP n) (tsN n), zsz x ≤ Bd)
    (s : IState HS) (G : Fin HS → List ℤ) (hR : Regs G p h d σ K) (ZF ZG : List GI) (l : List ℤ)
