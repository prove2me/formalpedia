-- title:
--   Lexicographic completion, real realization, and Algorithm 1
-- statement:
--   The completion adds every missing cross edge, keeps the original edges within $L$, and adds no edges within $R$. An edge's deterministic identifier is the ordered-pair index of its smaller and larger vertex. Its symbolic cost is
--   $$\widetilde w_e=(0,w_e,2^{\iota(e)})\ (e\in E),\qquad (1,0,2^{\iota(e)})\ (e\notin E),$$
--   ordered lexicographically. Realization maps a triple to $x_0+\varepsilon x_1+\varepsilon^2x_2$ only for the existential structural statement.
--
--   Algorithm 1's dictionary is generated by the shared enumeration using symbolic canonical assignments, filtered to contain $s$. Its dynamic program uses only original edges and costs. The headline output additionally exposes the computed maximum independent set before the tour answer, so independent-set preprocessing is explicitly included in the charged computation. None of these definitions includes an optimality axiom or a running-time assumption.
-- source:
--   Ethan X. Fang, Shengtao Guo, Junwei Lu, Yuan Yao, STOC 2027 submission #481 (October 2026), §5, equation (5.1), Lemma 5.1, and Algorithm 1, PDF p. 11–12; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/481.pdf

import Definitions.Def_ProportionalTSP_Exact_DP

noncomputable section

namespace ProportionalTSP.Exact
open scoped Classical

abbrev SymbolicCost := ℤ × (ℝ × ℤ)

def lexLE (x y : SymbolicCost) : Prop :=
  x.1 < y.1 ∨ (x.1 = y.1 ∧ (x.2.1 < y.2.1 ∨ (x.2.1 = y.2.1 ∧ x.2.2 ≤ y.2.2)))

/-- Canonical integer labels give distinct ids below (m+k)² on all unordered nonloop edges. -/
def vertexIndex {m k : ℕ} : Vertex m k → ℕ
  | .inl l => l.val
  | .inr r => m + r.val

def edgeId {m k : ℕ} : Sym2 (Vertex m k) → ℕ :=
  Sym2.lift ⟨fun x y => min (vertexIndex x) (vertexIndex y) * (m+k) +
    max (vertexIndex x) (vertexIndex y), by intro x y; simp [min_comm, max_comm]⟩

def completedGraph {m k : ℕ} (G : SimpleGraph (Vertex m k)) : SimpleGraph (Vertex m k) :=
  SimpleGraph.fromRel (fun x y => G.Adj x y ∨ ∃ l r, x = Sum.inl l ∧ y = Sum.inr r)

def symbolicCosts {m k : ℕ} (G : SimpleGraph (Vertex m k))
    (w : Sym2 (Vertex m k) → ℝ) (e : Sym2 (Vertex m k)) : SymbolicCost :=
  if e ∈ G.edgeSet then (0, w e, (2:ℤ)^edgeId e) else (1, 0, (2:ℤ)^edgeId e)

def realize (ε : ℝ) (x : SymbolicCost) : ℝ :=
  (x.1 : ℝ) + ε * x.2.1 + ε^2 * (x.2.2 : ℝ)

def SymbolicOptimal {m k : ℕ} (G : SimpleGraph (Vertex m k))
    (w : Sym2 (Vertex m k) → SymbolicCost) (H : Finset (Sym2 (Vertex m k))) : Prop :=
  IsTour G H ∧ ∀ H', IsTour G H' → lexLE (tourCost w H) (tourCost w H')

/-- Algorithm 1's containing-s dictionary uses the symbolic costs only for enumeration. -/
def symbolicStateFamily {m k : ℕ} [NeZero m] [NeZero k]
    (G : SimpleGraph (Vertex m k)) (w : Sym2 (Vertex m k) → ℝ) (s : Fin k) :
    Finset (Finset (Vertex m k)) :=
  (enumerationBy (canonicalBy lexLE (cross (symbolicCosts G w)))).toFinset.filter
    (fun U => Sum.inr s ∈ U)

/-- Algorithm 1 after its explicit small-size and k>m checks; all DP edges and costs are original. -/
def algorithmOne {m k : ℕ} [NeZero m] [NeZero k]
    (G : SimpleGraph (Vertex m k)) (w : Sym2 (Vertex m k) → ℝ) (s : Fin k) :
    Option (Finset (Sym2 (Vertex m k))) :=
  if k > m ∨ m+k < 3 then none else
    restrictedDP G w (vertexList m k) (symbolicStateFamily G w s) (.inr s)

/-- The program exposes its independently computed maximum independent set as a finite
certificate, then its tour/nonexistence output. No supplied R is encoded in graphInput. -/
def HeadlineOutput {n : ℕ} (G : SimpleGraph (Fin n)) (w : Sym2 (Fin n) → ℝ)
    (out : List ℕ) : Prop :=
  ∃ (rs : List (Fin n)) (answer : List ℕ), rs.Nodup ∧ Independent G rs.toFinset ∧
    (∀ S : Finset (Fin n), Independent G S → S.card ≤ rs.length) ∧
    out = rs.length :: (rs.map Fin.val ++ answer) ∧ AnswerOutput G w answer

end ProportionalTSP.Exact


