theorem solution
    {α : Type*}
    (𝒟 : _root_.LIDT.MIPStarRE.LDT.Distribution α) (f : α → _root_.LIDT.MIPStarRE.LDT.Error) :
    |_root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 f| ≤ _root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 (fun a => |f a|) := by
  classical
  unfold _root_.LIDT.MIPStarRE.LDT.avgOver
  calc
    |∑ a ∈ 𝒟.support, 𝒟.weight a * f a|
      ≤ ∑ a ∈ 𝒟.support, |𝒟.weight a * f a| := by
          exact Finset.abs_sum_le_sum_abs _ _
    _ = ∑ a ∈ 𝒟.support, 𝒟.weight a * |f a| := by
          refine Finset.sum_congr rfl ?_
          intro a _
          rw [abs_mul, abs_of_nonneg (𝒟.nonnegative a)]
    _ = _root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 (fun a => |f a|) := by
          rfl
