theorem solution {g g' : ℝ → ℝ} {ε L : ℝ} (hε : 0 < ε)
    (hd : ∀ x ∈ Ioo (0:ℝ) ε, HasDerivAt g (g' x) x)
    (hl : Tendsto g' (𝓝[>] 0) (𝓝 L)) : ∃ M, Tendsto g (𝓝[>] 0) (𝓝 M) := by
  have hev : ∀ᶠ x in 𝓝[>] (0:ℝ), |g' x - L| < 1 ∧ x ∈ Ioo (0:ℝ) ε := by
    have h1 := (tendsto_iff_norm_sub_tendsto_zero.mp hl).eventually (gt_mem_nhds one_pos)
    filter_upwards [h1, Ioo_mem_nhdsGT hε] with x h1 h2
    exact ⟨by simpa [Real.norm_eq_abs] using h1, h2⟩
  obtain ⟨δ, hδ, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hev
  have hδ0 : (0:ℝ) < δ := hδ
  set Mb := |L| + 1
  have hMb : 0 ≤ Mb := by positivity
  have hbound : ∀ x ∈ Ioo (0:ℝ) δ, ‖g' x‖ ≤ Mb := by
    intro x hx
    have h := (hsub hx).1
    rw [Real.norm_eq_abs]
    have := abs_sub_abs_le_abs_sub (g' x) L
    linarith
  have hderiv : ∀ x ∈ Ioo (0:ℝ) δ, HasDerivWithinAt g (g' x) (Ioo 0 δ) x :=
    fun x hx => (hd x (hsub hx).2).hasDerivWithinAt
  apply cauchy_map_iff_exists_tendsto.mp
  rw [Metric.cauchy_iff]
  refine ⟨inferInstance, fun η hη => ?_⟩
  set r := min δ (η / (Mb + 1))
  have hr : 0 < r := lt_min hδ0 (by positivity)
  have hrle : r * (Mb + 1) ≤ η := by
    have := min_le_right δ (η / (Mb + 1))
    rwa [le_div_iff₀ (by positivity)] at this
  refine ⟨g '' Ioo 0 r, image_mem_map (Ioo_mem_nhdsGT hr), ?_⟩
  rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
  have haδ : a ∈ Ioo (0:ℝ) δ := ⟨ha.1, lt_of_lt_of_le ha.2 (min_le_left _ _)⟩
  have hbδ : b ∈ Ioo (0:ℝ) δ := ⟨hb.1, lt_of_lt_of_le hb.2 (min_le_left _ _)⟩
  have hmv := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hderiv hbound
    (convex_Ioo 0 δ) hbδ haδ
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at hmv
  have hab : |a - b| < r := by rw [abs_lt]; constructor <;> linarith [ha.1, ha.2, hb.1, hb.2]
  rw [Real.dist_eq]
  nlinarith [abs_nonneg (a - b)]
