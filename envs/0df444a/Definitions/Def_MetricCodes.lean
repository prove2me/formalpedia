    {r n k : ℕ} (lam : Fin (r + 1) → ℕ)
    (f : RootJointHarmonicChain n lam (k + 1))
    (S : AdmissibleRootWedge lam (k + 1)) : PolynomialSpace r n :=
  ∑ α : PositiveRoot r,
    (rootPolynomialActionCoboundaryDifferentialIncidence lam f S α α +
