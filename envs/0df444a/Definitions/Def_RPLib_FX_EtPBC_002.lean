section Refine

variable {Y : Scheme.{u}}

/-- **Finite affine refinement** of a covering sieve of a compact etale object. -/
theorem exists_affine_refine' (T : Y.Etale) [CompactSpace T.left] (R : Sieve T) (hR : R ∈ Y.smallEtaleTopology T) :
    ∃ (ι : Type u) (_ : Finite ι) (S : ι → Y.Etale) (g : ∀ k, S k ⟶ T),
      (∀ k, IsAffine (S k).left) ∧ (∀ k, R (g k)) ∧ ∀ x : T.left, ∃ k s, (g k).left s = x := by
  classical
  rw [mem_smallEtale_iff] at hR
  choose W g w hg hw using hR
  let a (x : T.left) : (W x).left.affineCover.X ((W x).left.affineCover.idx (w x)) ⟶ (W x).left :=
    (W x).left.affineCover.f _
  let S (x : T.left) : Y.Etale := Scheme.Etale.mk (a x ≫ (W x).hom)
  let h (x : T.left) : S x ⟶ W x := MorphismProperty.Over.homMk (a x) rfl
  have hO : ∀ x, IsOpen (Set.range ((h x ≫ g x).left)) := fun x =>
    ((h x ≫ g x).left).isOpenMap.isOpen_range
  have hcov : (Set.univ : Set T.left) ⊆ ⋃ x, Set.range ((h x ≫ g x).left) := by
    intro x _
    obtain ⟨y, hy⟩ := (W x).left.affineCover.covers (w x)
    refine Set.mem_iUnion.2 ⟨x, y, ?_⟩
    change (g x).left ((W x).left.affineCover.f _ y) = x
    rw [hy, hw]
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover _ hO hcov
  refine ⟨t, inferInstance, fun k => S k.1, fun k => h k.1 ≫ g k.1, fun k => ?_,
    fun k => R.downward_closed (hg k.1) _, fun x => ?_⟩
  · change IsAffine ((W k.1).left.affineCover.X _)
    infer_instance
  · obtain ⟨k, hk, s, hs⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ x))
    exact ⟨⟨k, hk⟩, s, hs⟩

end Refine

/-- The point of `U.left` under a fibre element of a geometric point. -/
def fibPt {X : Scheme.{u}} (t : GeomPt X) {U : X.Etale} (b : t.point.fiber.obj U) : U.left :=
  (b : CategoryTheory.Over.mk t.pt ⟶ (Scheme.Etale.forget X).obj U).left (default : Spec (CommRingCat.of t.Ω))

theorem fibPt_map {X : Scheme.{u}} (t : GeomPt X) {U' U : X.Etale} (f₀ : U' ⟶ U) (b : t.point.fiber.obj U') :
    fibPt t (t.point.fiber.map f₀ b) = f₀.left (fibPt t b) := rfl

/-- A fibre element of `geomPtAt (U.hom u)` on `U` over the point `u`. -/
theorem exists_fib_at {X : Scheme.{u}} (U : X.Etale) (u : U.left) :
    ∃ w : (geomPtAt (U.hom u)).point.fiber.obj U, fibPt _ w = u := by
  have : Etale U.hom := U.prop
  obtain ⟨l, hl, hlu⟩ := Scheme.exists_fac_of_etale_of_isSepClosed U.hom (geomPtAt (U.hom u)).pt u
    (center_geomPtAt (U.hom u)).symm
  exact ⟨(Over.homMk l hl : CategoryTheory.Over.mk (geomPtAt (U.hom u)).pt ⟶ (Scheme.Etale.forget X).obj U), by exact hlu⟩

