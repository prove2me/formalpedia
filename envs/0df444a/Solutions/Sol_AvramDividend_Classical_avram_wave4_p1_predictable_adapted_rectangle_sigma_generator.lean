import Mathlib

set_option pp.explicit true
set_option pp.fullNames true
set_option pp.universes true

open MeasureTheory Set
open scoped ENNReal NNReal

/-- The predictable σ-algebra is generated by actual adapted past
half-line rectangles and the initial-time atom. This is the set-theoretic
bridge needed before an L² density proof for predictable elementary kernels. -/
theorem solution
    {Ω ι : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι]
    (𝓕 : Filtration ι mΩ) :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    𝓕.predictable = MeasurableSpace.generateFrom G := by
  classical
  let G : Set (Set (ι × Ω)) :=
    {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
              S = ({⊥} ×ˢ A)) ∨
         (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
              S = (Set.Ioi i ×ˢ A))}
  change 𝓕.predictable = MeasurableSpace.generateFrom G
  apply le_antisymm
  · apply measurableSpace_le_predictable_of_measurableSet
    · intro A hA
      exact MeasurableSpace.measurableSet_generateFrom
        (show ({⊥} ×ˢ A) ∈ G from Or.inl ⟨A, hA, rfl⟩)
    · intro i A hA
      exact MeasurableSpace.measurableSet_generateFrom
        (show (Set.Ioi i ×ˢ A) ∈ G from Or.inr ⟨i, A, hA, rfl⟩)
  · apply MeasurableSpace.generateFrom_le
    intro S hS
    change (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
      S = ({⊥} ×ˢ A)) ∨
      (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
        S = (Set.Ioi i ×ˢ A)) at hS
    rcases hS with ⟨A, hA, rfl⟩ | ⟨i, A, hA, rfl⟩
    · exact measurableSet_predictable_singleton_bot_prod hA
    · exact measurableSet_predictable_Ioi_prod hA
