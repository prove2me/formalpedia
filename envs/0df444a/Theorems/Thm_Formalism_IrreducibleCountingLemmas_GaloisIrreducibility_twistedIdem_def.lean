theorem Formalism.IrreducibleCountingLemmas.GaloisIrreducibility.twistedIdem_def {G : Type} [Group G] [Fintype G] (J : Subgroup G) (χ : J →* ℂˣ) :
    twistedIdem J χ =
      ∑ u : J, ((Nat.card J : ℂ)⁻¹ * (((χ u)⁻¹ : ℂˣ) : ℂ)) • MonoidAlgebra.of ℂ G (u : G) := by sorry
