set_option autoImplicit true
open ULHC ULHC.T
open Finset TF
namespace ULHC.T
theorem _root_.solution (V : Finset Pt) (F0 : Finset Edge) :
    ∀ (Ls : List (Finset Pt)) (v : Pt) (F : Finset Edge), (walkT V F0 Ls v F).ret = walk V F0 Ls v F
  | [], _, _ => rfl
  | L :: Ls, v, F => by
    simp only [walkT, walk, ret_bind, memT]
    by_cases hv : v ∈ L
    · simp [hv, solution V F0 Ls v F]
    · simp only [hv, decide_false, Bool.false_eq_true, ite_false, ret_bind, predT_ret]
      rcases pred V F0 L v with _ | e
      · rfl
      · by_cases hb : Black v
        · simp [hb, eraseT, solution V F0 Ls (other e v) (F.erase e)]
        · simp [hb, insertT, solution V F0 Ls (other e v) (insert e F)]
end ULHC.T
