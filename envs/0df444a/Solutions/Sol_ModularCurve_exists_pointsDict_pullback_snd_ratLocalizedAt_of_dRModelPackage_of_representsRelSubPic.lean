theorem pasteIso_inv_fst_fst :
    (pasteIso D (ℓ := ℓ)).inv ≫ pullback.fst (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫
        pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) = pullback.fst D.toBase (specMap ℤ ℚ) := by
  simp only [pasteIso, Iso.trans_inv, Category.assoc, pullbackLeftPullbackSndIso_inv_fst, pullback.congrHom_inv,
    pullback.lift_fst, Category.comp_id]

theorem mul_congr_base {S : Scheme.{0}} (L : RelativeGroupLaw ℤ D.toBase) {t t' : S ⟶ Spec (CommRingCat.of ℤ)} (ht : t = t')
    (x y : SchemeHomOver t D.toBase) (x' y' : SchemeHomOver t' D.toBase) (hx : x.1 = x'.1) (hy : y.1 = y'.1) :
    (L.mul t x y).1 = (L.mul t' x' y').1 := by
  subst ht
  obtain rfl : x = x' := Subtype.ext hx
  obtain rfl : y = y' := Subtype.ext hy
  rfl

theorem theta_key
    (θQ : SchemeHomOver (P.D.baseChange ℚ).toBase (D.baseChange ℚ).toBase)
    (θ : SchemeHomOver P.D.toBase (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (hθK : (genericFibreRestrict ↥(GaloisRep.ratLocalizedAt ℓ) ℚ (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))
          P.D.toBase θ).1 = θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv) :
    pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))
      = θQ.1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by
  have h1 : (genericFibreRestrict ↥(GaloisRep.ratLocalizedAt ℓ) ℚ (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))
      P.D.toBase θ).1 ≫ pullback.fst _ _ = pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 := by
    simp only [genericFibreRestrict, pullback.lift_fst]
    rfl
  have h2 : pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 =
      θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv ≫
        pullback.fst (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) := by
    rw [← h1, hθK]
    exact Category.assoc _ _ _
  calc pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1 ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))
      = (pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≫ θ.1) ≫ pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) :=
        (Category.assoc _ _ _).symm
    _ = (θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv ≫
        pullback.fst (pullback.snd D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))) (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)) ≫
          pullback.fst D.toBase (specMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)) := by rw [h2]
    _ = θQ.1 ≫ pullback.fst D.toBase (specMap ℤ ℚ) := by
        simp only [Category.assoc, pasteIso_inv_fst_fst]

theorem specMap_rat_algClosure :
    Spec.map (CommRingCat.ofHom (algebraMap ℚ (AlgebraicClosure ℚ))) ≫ specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ =
      Spec.map (CommRingCat.ofHom (algebraMap ↥(GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ))) := by
  rw [specMap, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]

