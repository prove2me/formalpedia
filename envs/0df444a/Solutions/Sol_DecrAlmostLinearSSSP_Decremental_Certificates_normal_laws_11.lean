    obtain ⟨cb,u,ys,hu,hcb,hum,hlen,huenv,huq,huframe⟩ := body_eval i hi p B reserve N offset hB a xs s h j g henv hp hnormal logical rest hq
    have hencodedRest : ∀ address ∈ rest, ∃ logical, address = bankAddress B j.val logical :=
