open MIPRE
open MIPRE.Introspection
open MIPRE.Introspection.AuxiliaryDual
open Finset
variable {F ι : Type*} [Field F] [Fintype ι] [DecidableEq ι] {S : Finset ι}

theorem MIPRE.Introspection.AuxiliaryDual.registerDual_zero_iff_dot (L : CL.RegLinear F S) (x : ι → F) :
    registerDual L x = 0 ↔ ∀ y : ι → F, L y = 0 → ∑ i, y i * CL.proj S x i = 0 := by sorry
