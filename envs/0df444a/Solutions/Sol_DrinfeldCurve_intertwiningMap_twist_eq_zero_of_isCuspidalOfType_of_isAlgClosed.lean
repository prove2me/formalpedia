@[scoped simp] private theorem muHom_fst (ζ : rootsOfUnity (q + 1) (GaloisField q 2)) :
    ((muHom q ζ : hSubgroup q) : GL2 q × (GaloisField q 2)ˣ).1 = 1 := rfl

@[scoped simp] private theorem muHom_snd (ζ : rootsOfUnity (q + 1) (GaloisField q 2)) :
    ((muHom q ζ : hSubgroup q) : GL2 q × (GaloisField q 2)ˣ).2 = (ζ : (GaloisField q 2)ˣ) := rfl

