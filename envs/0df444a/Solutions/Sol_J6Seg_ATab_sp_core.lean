/-!
# A lines, table set-up, part 7: the parameter phase

From the registers of `parA` (`J6A.PA.PV`: `1 pre, 2 post, 3 s, 4 t, 5 p, 6 α, 7 m, 8 H, 9 W,
10 t/16H, 11 8H, 12 f`):

1. `pushTo`: the `kerRegs` values `p+2, pk+1, f, pre·nc, post, pre, nc, 2·8H,
   2·(pre·nc·post·8H), |T|` onto the stacks `32 … 41` (`ρA 0 … ρA 9`);
2. the loop registers `LV` (`J6AILTab2`) and `10 = nc`, by assignments, four doubling loops
   (`2^(2p)`, `2^Q`, `2^pk`, `2^b`), the product `b · r` and a `clog` loop (`jA = ⌈log₂ r⌉`,
   `r = 4W + 4H`), the two `aHdr2` constants.

**`Rn.phase`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## Pushes to several stacks -/

theorem Rn.pushTo {W : ℕ} {v : Vr} (hv : BV W v) :
    ∀ (l : List (Fin HS × E)) (c : Cs), (∀ x ∈ l, x.1 ∉ rg ∧ x.1.val < 56 ∧ x.2.ok = true ∧
      x.2.lb ≤ 2 ^ W) →
    Rn (pushTo l) v c (· = v) (pushToC v l c) (cPushTo W l)
  | [], c, _ => Rn.skip v c
  | (X, e) :: l, c, h => by
    obtain ⟨h1, h2, h3, h4⟩ := h (X, e) List.mem_cons_self
    refine Rn.seq (Rn.pushE (c := c) (X := X) (e := e) h1 h2 h3 h4 hv) (fun v1 e1 => ?_)
    subst e1
    exact Rn.pushTo hv l _ (fun x hx => h x (List.mem_cons_of_mem _ hx))

/-! ## The values -/

end J6Seg.ATab

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

theorem nat_le_W {N W : ℕ} (h : N ≤ W) : |(N : ℤ)| ≤ 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]
  have := Nat.lt_two_pow_self (n := W); exact_mod_cast (by omega : N ≤ 2 ^ W)

theorem nat_le_W' {N W : ℕ} (h : N ≤ 2 ^ W) : |(N : ℤ)| ≤ 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]; exact_mod_cast h

set_option maxHeartbeats 4000000 in
theorem bndA_asgA {W pre post s t p α pkA pkC bA bC : ℕ} {v : Vr}
    (hv : J6A.PA.PV pre post s t p α W v) (hB : PBnd W p t α pkA pkC bA bC) :
    BndA W (asgA pkA pkC bA bC) v := by
  have h3 := hB.ht3; have h2 := hB.ht2; have hr := hB.hr; have hnc := hB.hnc
  simp only [asgA, BndA, E.den, update_apply, hv.r4, hv.r5, hv.r6, hv.r8, hv.r9, hv.r10]
  simp only [Fin.isValue, Fin.reduceEq, if_false, if_true, and_true]
  have hW := hB.hp
  have one : |(1 : ℤ)| ≤ 2 ^ W := by simp; exact one_le_pow₀ (by norm_num)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, one, one, one⟩
  · have e : ((ncA p t α : ℕ) : ℤ) = ↑t / (16 * ↑(J6A.PA.HH p α)) * 8 := by
      simp [ncA, HAx, J6A.PA.HH]
    rw [← e]; exact nat_le_W' hnc
  · have := nat_le_W (W := W) (N := 2 * p) hW; push_cast at this; exact this
  · have := nat_le_W (W := W) (N := p / 2) (by omega); push_cast at this; exact this
  · have := nat_le_W' (W := W) (N := t ^ 3 * α ^ 2) h3; push_cast at this
    convert this using 2; ring
  · have := nat_le_W' (W := W) (N := t ^ 2 * α ^ 2) h2; push_cast at this
    convert this using 2; ring
  · have := nat_le_W (W := W) (N := pkA * p + pkC) hB.hpk; push_cast at this; exact this
  · have := nat_le_W (W := W) (N := bA * p + bC) hB.hb; push_cast at this; exact this
  · have e : ((J6A.QA p : ℕ) : ℤ) = 6 * ↑p - ↑p / 2 := by
      unfold J6A.QA; rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [← e]; exact nat_le_W hB.hQ
  · have := nat_le_W' (W := W) (N := 4 * J6A.WA p α (HAx p α) + 4 * HAx p α) (by omega)
    push_cast at this; exact this
  · have := nat_le_W' (W := W) (N := 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α)) hr
    push_cast at this; exact this

end J6Seg.ATab

