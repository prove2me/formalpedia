theorem PadicInt.eq_zero_of_forall_sq_sub_self_mul_mem_span_two_pow
    (b : ℤ_[2]) (n : ℕ → ℕ) (hn : ∀ k, 2 ≤ k → n k % 4 = 3)
    (hb : ∀ k, 2 ≤ k → ((n k : ℤ_[2]) ^ 2 - n k) * b ∈ Ideal.span {(2 : ℤ_[2]) ^ k}) :
    b = 0 := by
  have h2 : ‖(2 : ℤ_[2])‖ = 2⁻¹ := by exact_mod_cast PadicInt.norm_p (p := 2)

  have hodd : ∀ m : ℕ, m % 2 = 1 → ‖(m : ℤ_[2])‖ = 1 := by
    intro m hm
    refine le_antisymm (PadicInt.norm_le_one _) ?_
    by_contra hlt
    push Not at hlt
    have hlt' : ‖((m : ℤ) : ℤ_[2])‖ < 1 := by rwa [Int.cast_natCast]
    have := (PadicInt.norm_int_lt_one_iff_dvd (p := 2) (m : ℤ)).mp hlt'
    have h2m : (2 : ℤ) ∣ (m : ℤ) := by exact_mod_cast this
    omega
  have key : ∀ k : ℕ, 2 ≤ k → ‖b‖ ≤ (2 : ℝ) ^ (-((k : ℤ) - 1)) := by
    intro k hk
    have hmem := (PadicInt.norm_le_pow_iff_mem_span_pow _ k).mpr (hb k hk)
    obtain ⟨m, hm⟩ : ∃ m, n k = 4 * m + 3 :=
      ⟨n k / 4, by have := Nat.div_add_mod (n k) 4; rw [hn k hk] at this; omega⟩
    have hfac : ((n k : ℤ_[2]) ^ 2 - n k) * b = 2 * ((((4 * m + 3) * (2 * m + 1) : ℕ) : ℤ_[2]) * b) := by
      rw [hm]; push_cast; ring
    have hmodd : ((4 * m + 3) * (2 * m + 1)) % 2 = 1 :=
      Nat.odd_iff.mp (Nat.odd_mul.mpr ⟨by rw [Nat.odd_iff]; omega, by rw [Nat.odd_iff]; omega⟩)
    rw [hfac, norm_mul, norm_mul, h2, hodd _ hmodd, one_mul] at hmem
    have h2pos : (0 : ℝ) < 2 := by norm_num
    rw [show -((k : ℤ) - 1) = -(k : ℤ) + 1 by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]
    push_cast at hmem
    nlinarith [hmem, norm_nonneg b]

  by_contra hb0
  have hpos : 0 < ‖b‖ := norm_pos_iff.mpr hb0

  obtain ⟨k, hk⟩ : ∃ k : ℕ, (2 : ℝ) ^ (-((k : ℤ) - 1)) < ‖b‖ := by
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hpos (by norm_num : (2⁻¹ : ℝ) < 1)
    refine ⟨k + 1, ?_⟩
    rw [show -(((k + 1 : ℕ) : ℤ) - 1) = -(k : ℤ) by push_cast; ring, zpow_neg, zpow_natCast, ← inv_pow]
    exact hk
  have hk2 : 2 ≤ k := by
    by_contra hlt
    push Not at hlt
    have : (1 : ℝ) ≤ (2 : ℝ) ^ (-((k : ℤ) - 1)) := by
      interval_cases k <;> norm_num
    have hb1 : ‖b‖ ≤ 1 := PadicInt.norm_le_one b
    linarith
  exact absurd (key k hk2) (not_le.mpr hk)

