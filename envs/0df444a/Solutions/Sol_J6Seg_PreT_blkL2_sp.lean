        have I := spIF s (W k) cc iT (ok_RF iT rfl) (vb_regs hw iT) (mgB hA (by decide) (by decide))
          (by rw [evT]; push Not at hlt; exact_mod_cast (show ¬ ((x k : ℤ) - e < 0) by omega))
          (a := blkB2 K Cs) (Sp.skip _)
        refine (I.congr ?_).mono (by unfold cRnd2; omega)
        have hb' : bAdd sN tN lam e st0 k = [] := by
          simp only [bAdd]; rw [if_neg hlt]
        have hpr : pr (k + 1) = pr k := by
          simp only [pr, preD]; rw [hsucc, hb', List.append_nil]
        have hxk : x (k + 1) = x k := by rw [xsucc]; simp [bst, hlt]
        have hWk : W (k + 1) = W k := by
          simp only [W, bS]
          have e1 : (bst sN tN lam e)^[k + 1] st0 = (bst sN tN lam e)^[k] st0 := hxk
          have e2 : preD P R sN tN lam aN e st0 (k + 1) = preD P R sN tN lam aN e st0 k := hpr
