-- title:
--   Dense witness for outer compatibility of pinned chart addition maps
-- statement:
--   Let $R$ be a Noetherian integral domain and let $W$ be a Weierstrass curve over $R$ that is elliptic. Write $\mathcal A_i$ for the degree-zero homogeneous localisation of the graded ring $\mathrm{MvPolynomial}(\mathrm{Fin}\,3,R)/(F_W)$ — the quotient by the ideal generated by the Weierstrass cubic of $W$, graded by the images of the homogeneous submodules — away from the class of $X_i$, and let $E=\mathrm{Proj}$ of this grading be the projective model, with structure morphism $\pi$ to $\operatorname{Spec} R$. Suppose given a family of morphisms $\mathrm{pcm}_{i,j}\colon\operatorname{Spec}(\mathcal A_i\otimes_R\mathcal A_j)\to E$ for $i,j\in\mathrm{Fin}\,3$, pinned in the sense that for every $i,j$ and every $l\in\mathrm{Fin}\,3\sqcup\mathrm{Fin}\,3$ the canonical localisation map $\operatorname{Spec}$ of $\mathcal A_i\otimes_R\mathcal A_j$ localised away from the element $\mathrm{kw\_lrSixU}\,W\,i\,j\,l$, followed by $\mathrm{pcm}_{i,j}$, equals the prescribed morphism $\mathrm{kw\_lrSixU\_toE}\,W\,i\,j\,l$ to $E$. Let $(i,j)$ and $(i',j')$ be two indices of the nine-chart open cover of $E\times_{\operatorname{Spec} R}E$ obtained from the affine chart cover of $E$ on each factor, and assume the overlap, i.e. the pullback of the two chart immersions, has a point. Then there exist a scheme $D$, a morphism $\iota$ from $D$ to that overlap which is scheme-theoretically dominant, and an equality: $\iota$ followed by the first projection, the identification of the $(i,j)$ chart with $\operatorname{Spec}(\mathcal A_i\otimes_R\mathcal A_j)$ and $\mathrm{pcm}_{i,j}$ agrees with $\iota$ followed by the second projection, the corresponding identification for $(i',j')$ and $\mathrm{pcm}_{i',j'}$.
--
--   This is the density half of the gluing compatibility for the relative addition morphism on the projective Weierstrass model: the pinned per-chart maps, given on each chart by the Lange–Ruppert addition formulas, are to be glued over $E\times_R E$, and agreement on chart overlaps is checked after pulling back along a scheme-theoretically dominant morphism. It is used by [`WeierstrassProjModel.perChart_addMorphism_pin_outerCompat`](thm.html#WeierstrassProjModel.perChart_addMorphism_pin_outerCompat).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WeierstrassProjModel_kw_pcmpin_outerCompat_dense_witness.lean

import Definitions.Def_WeierstrassCurve_ProjModel_GroupLawVocabulary
import Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra WeierstrassProjModel
open MvPolynomial WeierstrassCurve HomogeneousLocalization
open scoped TensorProduct

universe u

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] WeierstrassProjModel.kw_pbac_awayAlgebra

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

set_option quotPrecheck false in
local notation "𝒜" i => HomogeneousLocalization.Away (projModelGradingCR W.toProjective)
  (Ideal.Quotient.mk (projModelHomogeneousIdealCR W.toProjective).toIdeal
    (X i : MvPolynomial (Fin 3) R))

theorem WeierstrassProjModel.kw_pcmpin_outerCompat_dense_witness
    [IsDomain R] [IsNoetherianRing R] [W.IsElliptic]
    (pcm : ∀ (i j : Fin 3), Spec (CommRingCat.of ((𝒜 i) ⊗[R] (𝒜 j))) ⟶ projModelCR W.toProjective)
    (hpin : ∀ (i j : Fin 3) (l : Fin 3 ⊕ Fin 3),
      kw_lrSixU_locMap W i j l ≫ pcm i j = kw_lrSixU_toE W i j l)
    (ij ij' : Fin 3 × Fin 3)
    (hne : Nonempty ↥(pullback ((kwProjPullbackOpenCoverCR R W.toProjective).f ij)
                               ((kwProjPullbackOpenCoverCR R W.toProjective).f ij'))) :
    ∃ (D : Scheme.{u}) (ι : D ⟶ pullback ((kwProjPullbackOpenCoverCR R W.toProjective).f ij)
                                         ((kwProjPullbackOpenCoverCR R W.toProjective).f ij'))
      (_ : IsSchemeTheoreticallyDominant ι),
      ι ≫ pullback.fst ((kwProjPullbackOpenCoverCR R W.toProjective).f ij)
                       ((kwProjPullbackOpenCoverCR R W.toProjective).f ij')
          ≫ (kwProjPullbackChartIsoCR R W.toProjective ij.1 ij.2).hom ≫ pcm ij.1 ij.2
        = ι ≫ pullback.snd ((kwProjPullbackOpenCoverCR R W.toProjective).f ij)
                           ((kwProjPullbackOpenCoverCR R W.toProjective).f ij')
          ≫ (kwProjPullbackChartIsoCR R W.toProjective ij'.1 ij'.2).hom ≫ pcm ij'.1 ij'.2 := by sorry
