private theorem K48_star_tr2 : ∀ k ∈ _root_.LanglandsTunnell.Lift48.K48, star (_root_.LanglandsTunnell.Lift48.tr2 k) = _root_.LanglandsTunnell.Lift48.tr2 k * _root_.LanglandsTunnell.Lift48.det2 k := by decide

