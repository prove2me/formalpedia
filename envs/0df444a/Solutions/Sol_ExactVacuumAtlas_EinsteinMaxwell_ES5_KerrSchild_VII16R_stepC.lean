      · linarith
      · linarith
    have hg0 : Tendsto g (𝓝[>] (0:ℝ)) (𝓝 0) := by
      have := hid.mul hb1v; simpa using this
    have hle : g x0 ≤ 0 := ge_of_tendsto hg0 (by
      filter_upwards [Ioo_mem_nhdsGT hx0.1] with y hy using (hdec y hy).le)
    have : 0 < g x0 := by
      rw [hgdef]; exact mul_pos hx0.1 (hb0 x0 (hin x0 hx0))
    linarith
  -- main branch: q > −1
  set Dq : ℝ → ℝ := fun x => (1 - h * x) * q x + β x with hDqdef
  have hDq : ∀ x ∈ Ioo (0:ℝ) δ₂, 1 / 2 < Dq x := by
    intro x hx
    have hxi := hin x hx
    have hux := hu x hxi
    have h1 := (hsub₂ hx).1.2
    have h2 := hgt x hx
    rw [hDqdef]; simp only
    nlinarith
  have hqD : ∀ x ∈ Ioo (0:ℝ) δ₂, q x * Dq x = -(x * ρ x) := by
    intro x hx
    have := hquad x (hin x hx)
    rw [hDqdef]; simp only; linarith
  have hxρ : Tendsto (fun x => x * ρ x) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have := hid.mul hρ; simpa using this
  have hq0 : Tendsto q (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have hbound : ∀ᶠ x in 𝓝[>] (0:ℝ), ‖q x‖ ≤ 2 * ‖x * ρ x‖ := by
      filter_upwards [Ioo_mem_nhdsGT hδ₂0] with x hx
      have hD := hDq x hx
      have e := hqD x hx
      rw [Real.norm_eq_abs, Real.norm_eq_abs]
      have : |q x| * Dq x = |x * ρ x| := by
        rw [← abs_of_pos (by linarith : (0:ℝ) < Dq x), ← abs_mul, e, abs_neg]
      nlinarith [abs_nonneg (q x)]
    have h2 : Tendsto (fun x => 2 * ‖x * ρ x‖) (𝓝[>] (0:ℝ)) (𝓝 0) := by
      have := (hxρ.norm).const_mul 2; simpa using this
    exact tendsto_zero_iff_norm_tendsto_zero.mpr (squeeze_zero' (Eventually.of_forall
      fun _ => norm_nonneg _) hbound h2)
  have hD2 : Tendsto Dq (𝓝[>] (0:ℝ)) (𝓝 2) := by
    have := (hu1.mul hq0).add hβ; simpa using this
  have hqx : Tendsto (fun x => q x / x) (𝓝[>] (0:ℝ)) (𝓝 (-(2 * h - 2 * f₁ + 2 * b₁) / 2)) := by
    have hlim := (hρ.neg).div hD2 (by norm_num)
    refine Tendsto.congr' ?_ hlim
    filter_upwards [Ioo_mem_nhdsGT hδ₂0] with x hx
    have hD := (hDq x hx)
    have e := hqD x hx
    have hx0 : x ≠ 0 := hx.1.ne'
    have hDne : Dq x ≠ 0 := by linarith
    show -ρ x / Dq x = q x / x
    rw [div_eq_div_iff hDne hx0]
    linarith [e]
  have hbd : Tendsto (deriv b) (𝓝[>] (0:ℝ)) (𝓝 (-(2 * h - 2 * f₁ + 2 * b₁) / 2)) := by
    have hm := hb1v.mul hqx
    rw [one_mul] at hm
    refine Tendsto.congr' ?_ hm
    filter_upwards [Ioo_mem_nhdsGT hδ₂0] with x hx
    have hbne := (hb0 x (hin x hx)).ne'
    rw [hqdef]; simp only
    field_simp [hx.1.ne']
  have hid2 : -(2 * h - 2 * f₁ + 2 * b₁) / 2 = b₁ := k2_ident hδ hb1d hvalb hbd
  refine ⟨hid2 ▸ hbd, ?_⟩
  linarith
