-- url     : https://prove2.me/theorems/c01e4188-d261-41bb-9cb4-86f22975346d
-- title:
--   §4, (33)–(46), Definition 4.4, pp. 13–18 — Skorokhod space with J1, 𝒫, 𝒫₀, π, the stable topology on ℛ, ℛ₀, W̄₁, randomized q̲ and Ĥ̲, the map Φ
-- statement:
--   The objects of the fixed-point argument of §4.
--
--   1. **Skorokhod space.** $D=\Omega$ with the J1 metric (34), $d_D(x,y)=\inf_{\lambda\in\Lambda}\max\{\sup_{t\le T}|\lambda(t)-t|,\ \sup_{t\le T}d_E(y(\lambda(t)),x(t))\}$, where $\Lambda$ is the set of strictly increasing continuous bijections of $[0,T]$ and $d_E(x,y)=\mathbb 1(x\ne y)$; the J1 topology is generated by the open $d_D$-balls.
--   2. **$\mathcal P$ and $\mathcal P_0$.** $\mathcal P$ is the set of probability measures on $D$ with the weak topology: the coarsest topology making $\mu\mapsto\int\varphi\,d\mu$ continuous for every bounded J1-continuous $\varphi$. For $C_0\in\mathbb R$, $\mathcal P_0=\{\mathbb Q\in\mathcal P:\ d\mathbb Q/d\mathbb P=L,\ \mathbb E^{\mathbb P}[L^2]\le C_0\}$ (35).
--   3. **$\pi$.** $\pi(t,\mu)=(\mu(X_t=e_1),\dots,\mu(X_t=e_m))$ (p. 14).
--   4. **$\mathcal R$ and $\mathcal R_0$.** $\mathcal R$ is the set of probability measures on $[0,T]\times\mathcal P(A)$ with $\mathcal B([0,T])\otimes\mathcal B(\mathcal P(A))$, carrying the **stable topology** (Definition 4.4): the coarsest topology making $\eta\mapsto\int g\,d\eta$ continuous for every bounded measurable $g$ with $m\mapsto g(t,m)$ continuous for each $t$. With $\mathcal L(dt)=\frac1Tdt$, $\mathcal R_0=\{\eta\in\mathcal R:\ \text{the marginal of }\eta\text{ on }[0,T]\text{ is }\mathcal L\}$; for a flow $\nu$ the element $\mathcal L(dt)\times\delta_{\nu_t}(d\nu)$ is (37).
--   5. **$\bar{\mathcal W}_1$** (40): $\bar{\mathcal W}_1(m,m')=\inf_\pi\int\mathcal W_1(\nu,\nu')\,\pi(d\nu,d\nu')$ over couplings $\pi$ of $m,m'\in\mathcal P(\mathcal P(A))$.
--   6. **Randomized versions** (p. 16): $\underline q(t,i,j,\alpha,p,m)=\int q(t,i,j,\alpha,p,\nu)\,m(d\nu)$ and $\underline{\hat H}_i(t,z,p,m)=\int\hat H_i(t,z,p,\nu)\,m(d\nu)$.
--   7. **The map $\Phi$** (41)–(46), through its graph: for $\mu\in\mathcal P$ and $\eta=\mathcal L(dt)\times\eta_t(dm)\in\mathcal R_0$, $\Phi(\mu,\eta)=(\mu',\eta')$ holds when there is a solution $(Y,Z)$ of
--   $$Y_t=g(X_T,\pi(T,\mu))+\int_t^T\underline{\hat H}(s,X_{s-},Z_s,\pi(s,\mu),\eta_s)\,ds-\int_t^TZ_s^*\,d\mathcal M_s\qquad(41)$$
--   such that, with $\hat\alpha_t=\hat a(t,X_{t-},Z_t,\pi(t,\mu))$ and $\hat{\mathbb Q}^{(\mu,\eta)}$ the measure whose density is the Doléans-Dade exponential for the rates $\underline q(t,\cdot,\cdot,\hat\alpha_t,\pi(t,\mu),\eta_t)$ (42)–(43), $\mu'=\hat{\mathbb Q}^{(\mu,\eta)}$ (44) and $\eta'=\mathcal L(dt)\times\delta_{\hat{\mathbb Q}^{(\mu,\eta)}_{\#\hat\alpha_t}}(d\nu)$ (45).
--
--   **Formalization Note** Bounded J1-continuous functions on $D$ are measurable for the coordinate $\sigma$-field; measurability is listed explicitly among the test functions of $\mathcal P$ so that the integrals are genuine. Elements of $\mathcal R_0$ are passed to $\Phi$ through their disintegration $t\mapsto\eta_t$. Following Remark 4.9, $\Phi$ is described by its graph, so no solution of (41) is chosen. Three printed slips are corrected: $\bar{\mathcal W}_1$ in (40) is printed without the marginal constraint (which would make it identically $0$); (42) is printed without the $\psi^+_s$ of (5), and the rates of (5) are used; the $p_T$ of (41) is read as $\pi(T,\mu)$, as in the proof of Proposition 4.12.
-- source:
--   Carmona & Wang, A Probabilistic Approach to Extended Finite State Mean Field Games, arXiv:1808.07635v1, pp. 13–18, (33)–(35), π p. 14, Definition 4.4, ℛ₀ and (37) p. 16, (40)–(46)

import Mathlib
import Definitions.Def_ExtFSMFG_Existence_Model
import Definitions.Def_ExtFSMFG_Existence_BSDE

open MeasureTheory Filter Topology
open scoped ENNReal NNReal

namespace ExtFSMFG.Existence

noncomputable section

variable {m l : ℕ} {T : ℝ≥0}

/-! ### The Skorokhod space `D` with the J1 metric (33)–(34), and `𝒫` -/

/-- The set `Λ` of strictly increasing continuous bijections of `[0, T]` (p. 13). -/
def LambdaSet (T : ℝ≥0) : Set (ℝ≥0 → ℝ≥0) :=
  {lam | StrictMonoOn lam (Set.Icc 0 T) ∧ ContinuousOn lam (Set.Icc 0 T) ∧
    Set.BijOn lam (Set.Icc 0 T) (Set.Icc 0 T)}

/-- The J1 metric (34) on `D = Ω`, with the discrete metric `d_E(x, y) = 𝟙(x ≠ y)` on `E`:
`d_D(x, y) := inf_{λ∈Λ} max{sup_{t≤T} |λ(t) − t|, sup_{t≤T} d_E(y(λ(t)), x(t))}`. -/
def dJ1 (x y : Omega m T) : ℝ :=
  sInf ((fun lam : ℝ≥0 → ℝ≥0 =>
      max (sSup ((fun t : ℝ≥0 => |(lam t : ℝ) - t|) '' Set.Icc 0 T))
        (sSup ((fun t : ℝ≥0 => if y.1 (lam t) = x.1 t then (0 : ℝ) else 1) '' Set.Icc 0 T))) ''
    LambdaSet T)

/-- The J1 (Skorokhod) topology on `D = Ω`, generated by the open `d_D`-balls. -/
@[instance_reducible]
def J1Top (m : ℕ) (T : ℝ≥0) : TopologicalSpace (Omega m T) :=
  TopologicalSpace.generateFrom {s | ∃ x : Omega m T, ∃ r : ℝ, 0 < r ∧ s = {y | dJ1 x y < r}}

/-- `𝒫`: probability measures on `(D, d_D)` (σ-algebra generated by the coordinates). -/
def PD (m : ℕ) (T : ℝ≥0) : Type := ProbabilityMeasure (Omega m T)

/-- The underlying measure of `mu ∈ 𝒫`. -/
def PD.toMeasure (mu : PD m T) : Measure (Omega m T) :=
  ProbabilityMeasure.toMeasure (mu : ProbabilityMeasure (Omega m T))

/-- The weak topology on `𝒫`: the coarsest topology making `mu ↦ ∫ φ dmu` continuous for every
bounded J1-continuous `φ : D → ℝ` (these are coordinate-measurable). -/
instance (m : ℕ) (T : ℝ≥0) : TopologicalSpace (PD m T) :=
  ⨅ (φ : Omega m T → ℝ) (_ : Continuous[J1Top m T, inferInstance] φ ∧ Measurable φ ∧
      ∃ C, ∀ x, |φ x| ≤ C),
    TopologicalSpace.induced (fun mu : PD m T => ∫ x, φ x ∂mu.toMeasure) inferInstance

/-- `𝒫₀ := {Q : dQ/dP = L, E^P[L²] ≤ C₀}` (35). -/
def P0set (P : Measure (Omega m T)) (C₀ : ℝ) : Set (PD m T) :=
  {Q | ∃ L : Omega m T → ℝ≥0∞, Measurable L ∧ Q.toMeasure = P.withDensity L ∧
    ∫⁻ ω, L ω ^ 2 ∂P ≤ ENNReal.ofReal C₀}

/-- `π(t, mu) := [mu_{#X_t}({e₁}), …, mu_{#X_t}({e_m})] ∈ S` (p. 14). -/
def piMarg (t : ℝ≥0) (mu : PD m T) : Fin m → ℝ := fun i => (mu.toMeasure {ω | Xc t ω = i}).toReal

/-! ### The space `ℛ` with the stable topology (Definition 4.4), and `ℛ₀` -/

/-- `ℛ`: probability measures on `([0, T] × P(A), B([0, T]) ⊗ B(P(A)))` (Definition 4.4, p. 15). -/
def Rstable (T : ℝ≥0) (A : Set (EuclideanSpace ℝ (Fin l))) : Type :=
  ProbabilityMeasure (Set.Icc (0 : ℝ) T × PA A)

/-- The underlying measure of `η ∈ ℛ`. -/
def Rstable.toMeasure {A : Set (EuclideanSpace ℝ (Fin l))} (η : Rstable T A) :
    Measure (Set.Icc (0 : ℝ) T × PA A) :=
  ProbabilityMeasure.toMeasure (η : ProbabilityMeasure (Set.Icc (0 : ℝ) T × PA A))

/-- The stable topology of `ℛ` (Definition 4.4): the coarsest topology such that
`η ↦ ∫ g(t, m) η(dt, dm)` is continuous for every bounded measurable `g` on `[0, T] × P(A)` with
`m ↦ g(t, m)` continuous for each fixed `t`. -/
instance (T : ℝ≥0) (A : Set (EuclideanSpace ℝ (Fin l))) : TopologicalSpace (Rstable T A) :=
  ⨅ (g : Set.Icc (0 : ℝ) T × PA A → ℝ) (_ : Measurable g ∧ (∃ C, ∀ x, |g x| ≤ C) ∧
      ∀ t, Continuous fun ν => g (t, ν)),
    TopologicalSpace.induced (fun η : Rstable T A => ∫ x, g x ∂η.toMeasure) inferInstance

/-- The normalized Lebesgue measure `ℒ(dt) := (1/T) dt` on `[0, T]` (p. 15). -/
def Lnorm (T : ℝ≥0) : Measure (Set.Icc (0 : ℝ) T) :=
  (T : ℝ≥0∞)⁻¹ • Measure.comap Subtype.val volume

/-- `ℛ₀ := {η ∈ ℛ : the marginal of η on [0, T] is ℒ}` (p. 16). -/
def R0set (T : ℝ≥0) (A : Set (EuclideanSpace ℝ (Fin l))) : Set (Rstable T A) :=
  {η | η.toMeasure.map Prod.fst = Lnorm T}

/-- The measure `ℒ(dt) × δ_{ν_t}(dν)` on `[0, T] × P(A)` for a flow `ν : [0, T] → P(A)` ((37), p. 16). -/
def LdeltaFlow {A : Set (EuclideanSpace ℝ (Fin l))} (ν : ℝ≥0 → PA A) :
    Measure (Set.Icc (0 : ℝ) T × PA A) :=
  (Lnorm T).map fun t => (t, ν (t : ℝ).toNNReal)

/-! ### Randomized versions and the map `Φ` (pp. 16–18) -/

/-- The Wasserstein-1 distance on `P(P(A))` with cost `W₁` (40), the infimum over couplings `π` of
`m` and `m′` (probability measures on `P(A) × P(A)` with marginals `m`, `m′`):
`W̄₁(m, m′) := inf_π ∫ W₁(ν, ν′) π(dν, dν′)`. -/
def W1bar {A : Set (EuclideanSpace ℝ (Fin l))} (mη mη' : ProbabilityMeasure (PA A)) : ℝ :=
  sInf {c | ∃ π : Measure (PA A × PA A), IsProbabilityMeasure π ∧
    π.map Prod.fst = (mη : Measure (PA A)) ∧ π.map Prod.snd = (mη' : Measure (PA A)) ∧
    c = ∫ x, W1 x.1 x.2 ∂π}

/-- The randomized rate `q̲(t, i, j, α, p, m) := ∫ q(t, i, j, α, p, ν) m(dν)` (p. 16). -/
def qbar {A : Set (EuclideanSpace ℝ (Fin l))}
    (q : ℝ≥0 → Fin m → Fin m → EuclideanSpace ℝ (Fin l) → (Fin m → ℝ) → PA A → ℝ)
    (t : ℝ≥0) (i j : Fin m) (a : EuclideanSpace ℝ (Fin l)) (p : Fin m → ℝ)
    (mη : ProbabilityMeasure (PA A)) : ℝ :=
  ∫ ν, q t i j a p ν ∂(mη : Measure (PA A))

/-- The randomized minimized Hamiltonian `Ĥ̲ᵢ(t, z, p, m) := ∫ Ĥᵢ(t, z, p, ν) m(dν)` (p. 16). -/
def Hhatbar {A : Set (EuclideanSpace ℝ (Fin l))}
    (q : ℝ≥0 → Fin m → Fin m → EuclideanSpace ℝ (Fin l) → (Fin m → ℝ) → PA A → ℝ)
    (f : ℝ≥0 → Fin m → EuclideanSpace ℝ (Fin l) → (Fin m → ℝ) → PA A → ℝ)
    (t : ℝ≥0) (i : Fin m) (z : Fin m → ℝ) (p : Fin m → ℝ) (mη : ProbabilityMeasure (PA A)) : ℝ :=
  ∫ ν, Hhat q f t i z p ν ∂(mη : Measure (PA A))

/-- The graph of the map `Φ = (Φ^mu, Φ^η)` of (41)–(46) at an input `(mu, η) ∈ 𝒫 × ℛ₀`, with `η`
given by its disintegration `η(dt, dm) = ℒ(dt) × η_t(dm)`: there is a solution `(Y, Z)` of the
BSDE (41), `Y_t = g(X_T, π(T, mu)) + ∫ₜᵀ Ĥ̲(s, X_{s−}, Z_s, π(s, mu), η_s) ds − ∫ₜᵀ Z*_s · d𝓜_s`,
such that, with `α̂_t := â(t, X_{t−}, Z_t, π(t, mu))` and `Q̂^(mu,η)` the measure with density
`ℰ(L^(mu,η))_T` for the rates `q̲(t, ·, ·, α̂_t, π(t, mu), η_t)` (42)–(43):
`mu' = Q̂^(mu,η)` (44) and `η' = ℒ(dt) × δ_{Q̂^(mu,η)_{#α̂_t}}(dν)` (45). -/
def PhiGraph {A : Set (EuclideanSpace ℝ (Fin l))} (P : Measure (Omega m T))
    (q : ℝ≥0 → Fin m → Fin m → EuclideanSpace ℝ (Fin l) → (Fin m → ℝ) → PA A → ℝ)
    (f : ℝ≥0 → Fin m → EuclideanSpace ℝ (Fin l) → (Fin m → ℝ) → PA A → ℝ)
    (g : Fin m → (Fin m → ℝ) → ℝ)
    (ahat : ℝ≥0 → Fin m → (Fin m → ℝ) → (Fin m → ℝ) → EuclideanSpace ℝ (Fin l))
    (mu : PD m T) (ηt : ℝ≥0 → ProbabilityMeasure (PA A)) (mu' : PD m T) (η' : Rstable T A) :
    Prop :=
  ∃ (Y : ℝ≥0 → Omega m T → ℝ) (Z : ℝ≥0 → Omega m T → (Fin m → ℝ)),
    SolvesBSDE P (fun ω => g (Xc T ω) (piMarg T mu))
      (fun ω s _ z => Hhatbar q f s (Xm s ω) z (piMarg s mu) (ηt s)) Y Z ∧
    let αh := ahatProc (T := T) ahat Z (fun s => piMarg s mu)
    let Qh := P.withDensity fun ω => ENNReal.ofReal
      (densityR T (fun s ω i j => qbar q s i j (αh s ω) (piMarg s mu) (ηt s)) ω)
    mu'.toMeasure = Qh ∧
    ∃ ν' : ℝ≥0 → PA A, (∀ t ≤ T, (ν' t).toMeasureE = Qh.map (αh t)) ∧
      η'.toMeasure = LdeltaFlow ν'

end

end ExtFSMFG.Existence


