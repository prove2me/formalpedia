-- title:
--   Finite multigraphs with loops: degree, walks, trees, breaking vertices, and planarity by rotation systems
-- statement:
--   A **multigraph** on a vertex type $V$ is a finite list $G$ of pairs $(a_i,b_i)\in V\times V$, edge $i$ joining $a_i$ and $b_i$; orientation is ignored, a **loop** has $a_i=b_i$, and a repeated pair is a **parallel edge**. Edge $i$ has two **ends** $(i,0)$ at $a_i$ and $(i,1)$ at $b_i$. The **degree** of $v$ is the number of edge ends at $v$ (a loop counts twice). $G$ is a **(simple) graph** if it has no loop and no two edges with the same unordered pair of ends.
--
--   For an abstract multigraph with edge set $\iota$ and ends $\mathrm{ends}:\iota\times\{0,1\}\to W$, a **walk** from $x$ to $y$ is a sequence of steps, each leaving the current vertex along one end of an edge and arriving at its other end. The multigraph is **connected** if $W\neq\emptyset$ and every two vertices are joined by a walk, **acyclic** if no nonempty closed walk uses pairwise distinct edges (so a loop, and a pair of parallel edges, are cycles), and a **tree** if it is connected and acyclic. The empty multigraph is not a tree.
--
--   **Breaking** a set $S\subseteq V$ of vertices of $G$ removes the vertices of $S$ and gives every edge end at a vertex of $S$ its own new vertex: the vertices of the result are $V\setminus S$ together with one new vertex per edge end at $S$, every edge of $G$ is kept, and an end at $v\notin S$ stays at $v$. A vertex of degree $d$ is thus replaced by $d$ new degree-1 vertices, one per neighbour incidence; a loop at a broken vertex becomes an edge between two new vertices.
--
--   **Planarity** is defined combinatorially. The flip $\alpha$ exchanges the two ends of each edge. A **rotation system** is a permutation $\sigma$ of the edge ends whose cycles are exactly the sets of ends at the vertices (the cyclic order around each vertex). It is **planar** if
--   $$\#\mathrm{orbits}(\sigma)+\#\mathrm{orbits}(\sigma\circ\alpha)=|E|+2\,c,$$
--   where $c$ is the number of classes of edge ends under the equivalence generated by $\sigma$ and $\alpha$ (the components that have an edge); this is Euler's formula $V-E+F=2$ on every component. $G$ is **planar** if it has a planar rotation system. Isolated vertices play no role.
-- source:
--   Demaine & Rudoy, Tree-Residue Vertex-Breaking: a new tool for proving hardness, arXiv:1706.07900v3 (3 May 2018; SWAT 2018, doi:10.4230/LIPIcs.SWAT.2018.32), §3, pp. 7–8 (PDF pp. 7–8): breaking a vertex, Problem 3.1 ('the resulting multigraph is a tree'), Planar and Graph variants; Figure 1 p. 2. PDF SHA-256: d5f076af211e597d517c4365b4401ca0a6341590adb0a62be78489b9e737fcd7.

import Mathlib

set_option autoImplicit false

namespace TRVB.PlanarNPC

/-! Finite undirected multigraphs with loops and parallel edges.

A multigraph on a vertex type `V` is a list `G : List (V × V)` of edges; edge `i`
joins `G[i].1` and `G[i].2` (orientation is ignored, a loop has equal ends, a
repeated pair is a parallel edge).  Edge `i` has two *ends* (darts) `(i, false)`
and `(i, true)`. -/

/-- The vertex at end `d = (i, b)` of edge `i`: `G[i].1` for `b = false`, `G[i].2`
for `b = true`. -/
def dartVertex {V : Type} (G : List (V × V)) (d : Fin G.length × Bool) : V :=
  if d.2 then G[d.1].2 else G[d.1].1

/-- Degree: the number of edge ends at `v` (a loop at `v` counts twice). -/
def degree {V : Type} [DecidableEq V] (G : List (V × V)) (v : V) : ℕ :=
  G.countP (fun e => e.1 = v) + G.countP (fun e => e.2 = v)

/-- A multigraph is a (simple) graph: no loops and no two edges with the same
unordered pair of ends. -/
def IsSimpleMG {V : Type} (G : List (V × V)) : Prop :=
  (∀ e ∈ G, e.1 ≠ e.2) ∧ (G.map (fun e => s(e.1, e.2))).Nodup

/-! ### Walks, connectivity, acyclicity and trees for an abstract multigraph

An abstract multigraph is given by an edge index type `ι` and the ends
`ends : ι → Bool → W` of every edge. -/

/-- `IsWalk ends x w y`: the list of steps `w` is a walk from `x` to `y`; a step
`(e, b)` leaves the current vertex `ends e b` along edge `e` and arrives at
`ends e (!b)`. -/
def IsWalk {W ι : Type} (ends : ι → Bool → W) : W → List (ι × Bool) → W → Prop
  | x, [], y => x = y
  | x, s :: w, y => ends s.1 s.2 = x ∧ IsWalk ends (ends s.1 (!s.2)) w y

/-- Connected: at least one vertex, and a walk between any two vertices. -/
def IsConnectedMG {W ι : Type} (ends : ι → Bool → W) : Prop :=
  Nonempty W ∧ ∀ x y : W, ∃ w : List (ι × Bool), IsWalk ends x w y

/-- Acyclic (as a multigraph): no nonempty closed walk that uses pairwise distinct
edges.  A loop is such a walk of length 1, and two parallel edges give one of
length 2. -/
def IsAcyclicMG {W ι : Type} (ends : ι → Bool → W) : Prop :=
  ∀ (x : W) (w : List (ι × Bool)), IsWalk ends x w x → (w.map Prod.fst).Nodup → w = []

/-- A tree: a connected, acyclic multigraph (the empty multigraph is not a tree). -/
def IsTreeMG {W ι : Type} (ends : ι → Bool → W) : Prop :=
  IsConnectedMG ends ∧ IsAcyclicMG ends

/-! ### Breaking a set of vertices -/

/-- Vertices of the multigraph obtained from `G` by breaking every vertex of `S`:
the vertices of `V` outside `S`, and one new vertex for every edge end at a vertex
of `S` (so a broken vertex of degree `d` is replaced by `d` new vertices). -/
abbrev BrokenVertex {V : Type} (G : List (V × V)) (S : Finset V) : Type :=
  {v : V // v ∉ S} ⊕ {d : Fin G.length × Bool // dartVertex G d ∈ S}

/-- Ends of the edges after breaking `S`: every edge of `G` is kept; an end at a
vertex outside `S` stays there, an end at a vertex of `S` is re-attached to its own
new vertex.  A loop at a broken vertex becomes an edge between two new vertices. -/
def breakEnds {V : Type} [DecidableEq V] (G : List (V × V)) (S : Finset V) :
    Fin G.length → Bool → BrokenVertex G S :=
  fun i b =>
    if h : dartVertex G (i, b) ∈ S then Sum.inr ⟨(i, b), h⟩
    else Sum.inl ⟨dartVertex G (i, b), h⟩

/-! ### Planarity, combinatorially (rotation systems of genus 0) -/

/-- The involution exchanging the two ends of each edge. -/
def dartFlip {V : Type} (G : List (V × V)) : Equiv.Perm (Fin G.length × Bool) :=
  Equiv.prodCongr (Equiv.refl _) Equiv.boolNot

/-- `σ` is a rotation system of `G`: the cycles of `σ` are exactly the sets of edge
ends at the vertices (`σ` gives the cyclic order of the ends around each vertex). -/
def IsRotationSystem {V : Type} (G : List (V × V)) (σ : Equiv.Perm (Fin G.length × Bool)) :
    Prop :=
  ∀ d d' : Fin G.length × Bool, dartVertex G d = dartVertex G d' ↔ σ.SameCycle d d'

/-- Number of orbits (cycles, fixed points included) of a permutation. -/
noncomputable def numOrbits {α : Type} (σ : Equiv.Perm α) : ℕ :=
  Nat.card (Quotient (Equiv.Perm.SameCycle.setoid σ))

/-- Number of connected components of the map: classes of edge ends under the
equivalence generated by `σ` and `dartFlip G` (the components of `G` that have an
edge). -/
noncomputable def numDartComponents {V : Type} (G : List (V × V))
    (σ : Equiv.Perm (Fin G.length × Bool)) : ℕ :=
  Nat.card (Quot (fun d d' : Fin G.length × Bool => d' = σ d ∨ d' = dartFlip G d))

/-- A planar rotation system: a rotation system for which Euler's formula
`V - E + F = 2` holds on every component, summed over the components:
`#vertex orbits + #face orbits = #edges + 2 · #components`, where the faces are the
orbits of `σ ∘ dartFlip`.  (Each component has `V - E + F ≤ 2`, so the sum forces
genus 0 on every component.) -/
def IsPlanarRotation {V : Type} (G : List (V × V)) (σ : Equiv.Perm (Fin G.length × Bool)) :
    Prop :=
  IsRotationSystem G σ ∧
    numOrbits σ + numOrbits (σ * dartFlip G) = G.length + 2 * numDartComponents G σ

/-- A finite multigraph is planar when it has a planar rotation system
(equivalently, an embedding in the plane; isolated vertices play no role). -/
def IsPlanarMG {V : Type} (G : List (V × V)) : Prop :=
  ∃ σ : Equiv.Perm (Fin G.length × Bool), IsPlanarRotation G σ

end TRVB.PlanarNPC


