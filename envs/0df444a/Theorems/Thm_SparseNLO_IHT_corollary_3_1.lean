-- title:
--   Corollary 3.1 — the function values f(xᵏ) of the IHT method with L > L(f) converge
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), with gradient Lipschitz with constant $L(f)$ (Assumption 2), let $0<s<n$, and let $L>L(f)$. Let $(x^k)_{k\ge0}$ be any sequence generated by the IHT method with constant stepsize $1/L$. Then the sequence $(f(x^k))_{k\ge0}$ converges: there is $c\in\mathbb R$ with
--   $$\lim_{k\to\infty}f(x^k)=c.$$
--
--   The common limit of the function values is used in the proof of Theorem 3.1 to show that consecutive iterates along a convergent subsequence have the same limit.
--
--   **Formalization Note** $L(f)$ is any constant `Lf : ℝ≥0` with `LipschitzWith Lf (gradient f)`; convergence is to a finite real number.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 16, Corollary 3.1

import Mathlib
import Definitions.Def_SparseNLO_IHT_Setting

open Filter Topology

namespace SparseNLO.IHT

/-- Corollary 3.1 (p. 16). Let `(x^k)` be generated by the IHT method with constant stepsize
`1/L`, where `L > L(f)`. Then the sequence `(f(x^k))` converges. -/
theorem corollary_3_1 {n s : ℕ} (hs : 0 < s) (hsn : s < n)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f) (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x)
    (Lf : NNReal) (hLip : LipschitzWith Lf (gradient f)) (L : ℝ) (hL : (Lf : ℝ) < L)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsIHTRun f s L x) :
    ∃ c : ℝ, Tendsto (fun k => f (x k)) atTop (𝓝 c) := by sorry

end SparseNLO.IHT
