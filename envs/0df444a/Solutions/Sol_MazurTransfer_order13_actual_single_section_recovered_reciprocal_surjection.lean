end RecoveredReciprocalSurjectionPublicProof

theorem solution.{u}
    (R : Type u) [CommRing R] (h2 : IsUnit (2 : R)) :
    let τ : CoordinateRing R := yCoordinate R + (xCoordinate R ^ 3 + xCoordinate R ^ 2 + 1)
    let μ : CoordinateRing R := xCoordinate R * τ
    let ν : CoordinateRing R := xCoordinate R * (μ + 2)
    let α : Algebra (Polynomial R) (CoordinateRing R) := (aeval τ).toRingHom.toAlgebra
    letI : Algebra (Polynomial R) (CoordinateRing R) := α
    letI : SMul (Polynomial R) (CoordinateRing R) := α.toSMul
    letI : Module (Polynomial R) (CoordinateRing R) :=
      @Algebra.toModule (Polynomial R) (CoordinateRing R) _ _ α
    let B : Subalgebra (Polynomial R) (CoordinateRing R) :=
      Algebra.adjoin (Polynomial R) ({μ,ν} : Set (CoordinateRing R))
    let β : Algebra R B := ((algebraMap (Polynomial R) B).comp Polynomial.C).toAlgebra
    letI : Algebra R B := β
    let d : ReciprocalRing R := wCoordinate R - 1 - zCoordinate R - zCoordinate R ^ 3
    let d' : ReciprocalRing R := wCoordinate R - 1 - zCoordinate R + zCoordinate R ^ 3
    let P := Localization.Away (d * d')
    let zP : P := algebraMap (ReciprocalRing R) P (zCoordinate R)
    let di : P := algebraMap (ReciprocalRing R) P d' * IsLocalization.Away.invSelf (d * d')
    let d'i : P := algebraMap (ReciprocalRing R) P d * IsLocalization.Away.invSelf (d * d')
    let τP : P := 4 * zP * (1 + zP) * di
    let μP : P := 4 * (1 + zP) * di
    let νP : P := 8 * zP ^ 2 * (1 + zP) ^ 2 * di * d'i
    ∃ tB pB qB : B,
      (tB : CoordinateRing R) = τ ∧ (pB : CoordinateRing R) = μ ∧
      (qB : CoordinateRing R) = ν ∧
      ∃ χ : P →ₐ[R] Localization.Away (pB * (pB + tB)),
        Function.Surjective χ ∧
        χ τP = algebraMap B (Localization.Away (pB * (pB + tB))) tB ∧
        χ μP = algebraMap B (Localization.Away (pB * (pB + tB))) pB ∧
        χ νP = algebraMap B (Localization.Away (pB * (pB + tB))) qB := by
  dsimp only
  refine ⟨RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.parameterElement R,
    RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.pElement R, RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.qElement R,
    ?_, rfl, rfl, RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch R h2,
    RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch_surjective R h2,
    RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch_tau R h2,
    RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch_mu R h2,
    RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch_nu R h2⟩
  exact RecoveredReciprocalSurjectionPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.parameterElement_coe R

#print axioms solution
