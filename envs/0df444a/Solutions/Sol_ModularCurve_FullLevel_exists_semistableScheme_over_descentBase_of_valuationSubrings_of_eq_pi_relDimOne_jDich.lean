section CoeffSubfield

variable (L : Type) [Field L] [Algebra ℚ L] (F₁ : IntermediateField ℚ (LaurentSeries ℚ)) (K₀ : Subfield L)

noncomputable def fixedBy (σ : L ≃ₐ[ℚ] L) : Subfield ↥(laurentBaseChange L F₁) where
  carrier := {f | coeffMap (σ : L →+* L) (f : LaurentSeries L) = (f : LaurentSeries L)}
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [IntermediateField.coe_mul, map_mul, ha, hb]
  one_mem' := by simp
  add_mem' {a b} ha hb := by
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [IntermediateField.coe_add, map_add, ha, hb]
  zero_mem' := by simp
  neg_mem' {a} ha := by
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [IntermediateField.coe_neg, map_neg, ha]
  inv_mem' a ha := by
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [IntermediateField.coe_inv, map_inv₀, ha]

noncomputable def coeffSubfield : Subfield ↥(laurentBaseChange L F₁) :=
  ⨅ σ : {σ : L ≃ₐ[ℚ] L // ∀ c ∈ K₀, σ c = c}, fixedBy L F₁ σ.1

theorem mem_coeffSubfield_iff (f : ↥(laurentBaseChange L F₁)) :
    f ∈ coeffSubfield L F₁ K₀ ↔
      ∀ σ : L ≃ₐ[ℚ] L, (∀ c ∈ K₀, σ c = c) → coeffMap (σ : L →+* L) (f : LaurentSeries L) = (f : LaurentSeries L) := by
  simp only [coeffSubfield, Subfield.mem_iInf, Subtype.forall]
  rfl

theorem mem_coeffSubfield_of_forall_coeff_mem (f : ↥(laurentBaseChange L F₁))
    (hf : ∀ n : ℤ, (f : LaurentSeries L).coeff n ∈ K₀) : f ∈ coeffSubfield L F₁ K₀ := by
  rw [mem_coeffSubfield_iff]
  intro σ hσ
  ext n
  rw [coeffMap_coeff]
  exact hσ _ (hf n)

theorem forall_coeff_mem_of_mem_coeffSubfield
    (hfix : ∀ x : L, (∀ σ : L ≃ₐ[ℚ] L, (∀ c ∈ K₀, σ c = c) → σ x = x) → x ∈ K₀)
    (f : ↥(laurentBaseChange L F₁)) (hf : f ∈ coeffSubfield L F₁ K₀) (n : ℤ) :
    (f : LaurentSeries L).coeff n ∈ K₀ := by
  rw [mem_coeffSubfield_iff] at hf
  refine hfix _ (fun σ hσ => ?_)
  have h := congrArg (fun x : LaurentSeries L => x.coeff n) (hf σ hσ)
  simpa [coeffMap_coeff] using h

theorem mem_coeffSubfield_iff_forall_coeff_mem
    (hfix : ∀ x : L, (∀ σ : L ≃ₐ[ℚ] L, (∀ c ∈ K₀, σ c = c) → σ x = x) → x ∈ K₀)
    (f : ↥(laurentBaseChange L F₁)) :
    f ∈ coeffSubfield L F₁ K₀ ↔ ∀ n : ℤ, (f : LaurentSeries L).coeff n ∈ K₀ :=
  ⟨fun hf n => forall_coeff_mem_of_mem_coeffSubfield L F₁ K₀ hfix f hf n,
   fun hf => mem_coeffSubfield_of_forall_coeff_mem L F₁ K₀ f hf⟩

end CoeffSubfield

theorem mem_of_forall_algEquiv_fix (K₀ : Subfield (AlgebraicClosure ℚ)) (x : AlgebraicClosure ℚ)
    (hx : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, (∀ c ∈ K₀, σ c = c) → σ x = x) : x ∈ K₀ := by

  haveI hsc : IsScalarTower ℚ ↥K₀ (AlgebraicClosure ℚ) :=
    IsScalarTower.of_algebraMap_eq (fun r => by
      have h : (algebraMap ↥K₀ (AlgebraicClosure ℚ)).comp (algebraMap ℚ ↥K₀) = algebraMap ℚ (AlgebraicClosure ℚ) :=
        RingHom.ext_rat _ _
      exact (congrArg (fun φ : ℚ →+* AlgebraicClosure ℚ => φ r) h).symm)
  haveI hQ : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.isAlgebraic ℚ
  haveI hAlg : Algebra.IsAlgebraic ↥K₀ (AlgebraicClosure ℚ) := Algebra.IsAlgebraic.tower_top (K := ℚ) ↥K₀
  haveI : IsAlgClosure ↥K₀ (AlgebraicClosure ℚ) := ⟨inferInstance, hAlg⟩
  haveI : Normal ↥K₀ (AlgebraicClosure ℚ) := IsAlgClosure.normal ↥K₀ (AlgebraicClosure ℚ)
  haveI : Algebra.IsSeparable ↥K₀ (AlgebraicClosure ℚ) := Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : IsGalois ↥K₀ (AlgebraicClosure ℚ) := ⟨⟩
  have hmem : x ∈ IntermediateField.fixedField (⊥ : IntermediateField ↥K₀ (AlgebraicClosure ℚ)).fixingSubgroup := by
    rw [IntermediateField.mem_fixedField_iff]
    intro f _
    refine hx (f.restrictScalars ℚ) (fun c hc => ?_)
    rw [AlgEquiv.restrictScalars_apply]
    exact f.commutes ⟨c, hc⟩
  rw [InfiniteGalois.fixedField_fixingSubgroup, IntermediateField.mem_bot] at hmem
  obtain ⟨c, hc⟩ := hmem
  rw [← hc]
  exact c.2

section Constants

variable (L : Type) [Field L] [Algebra ℚ L] (F₁ : IntermediateField ℚ (LaurentSeries ℚ)) (K₀ : Subfield L)

theorem algebraMap_mem_coeffSubfield_iff
    (hfix : ∀ x : L, (∀ σ : L ≃ₐ[ℚ] L, (∀ c ∈ K₀, σ c = c) → σ x = x) → x ∈ K₀) (c : L) :
    algebraMap L ↥(laurentBaseChange L F₁) c ∈ coeffSubfield L F₁ K₀ ↔ c ∈ K₀ := by
  rw [mem_coeffSubfield_iff_forall_coeff_mem L F₁ K₀ hfix]
  have h1 : ((algebraMap L ↥(laurentBaseChange L F₁) c : ↥(laurentBaseChange L F₁)) : LaurentSeries L) =
      HahnSeries.single 0 c := by
    rw [← algebraMap_laurentSeries_eq_single]; rfl
  constructor
  · intro h
    have h0 := h 0
    rw [h1, HahnSeries.coeff_single_same] at h0
    exact h0
  · intro hc n
    rw [h1]
    by_cases hn : n = 0
    · subst hn; rw [HahnSeries.coeff_single_same]; exact hc
    · rw [HahnSeries.coeff_single_of_ne hn]; exact zero_mem K₀

end Constants

theorem mem_range_algebraMap_of_isAlgebraic_of_isAlgClosed
    (L : Type) [Field L] [IsAlgClosed L] (F : Type) [Field F] [Algebra L F]
    (x : F) (hx : IsAlgebraic L x) : x ∈ Set.range (algebraMap L F) := by
  have hint : IsIntegral L x := hx.isIntegral
  have hirr : Irreducible (minpoly L x) := minpoly.irreducible hint
  have hdeg : (minpoly L x).degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible L hirr
  exact minpoly.mem_range_of_degree_eq_one L x hdeg

section Dominate

theorem mem_maximalIdeal_comap_of_inv_not_mem
    {F : Type} [Field F] (F₀ : Subfield F) (O : ValuationSubring F)
    (c : F) (hcF₀ : c ∈ F₀) (hcO : c ∈ O) (hinv : c⁻¹ ∉ O) :
    ∃ hO : (⟨c, hcF₀⟩ : ↥F₀) ∈ O.comap F₀.subtype,
      (⟨⟨c, hcF₀⟩, hO⟩ : ↥(O.comap F₀.subtype)) ∈ IsLocalRing.maximalIdeal ↥(O.comap F₀.subtype) := by
  have hO : (⟨c, hcF₀⟩ : ↥F₀) ∈ O.comap F₀.subtype := by
    rw [ValuationSubring.mem_comap]; exact hcO
  refine ⟨hO, ?_⟩
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  obtain ⟨u, hu⟩ := hu
  apply hinv

  have hc0 : c ≠ 0 := by
    intro h0
    have : (u : ↥(O.comap F₀.subtype)) = 0 := by
      rw [hu]; ext; exact h0
    exact u.ne_zero this
  have hval : (((u⁻¹ : (↥(O.comap F₀.subtype))ˣ) : ↥(O.comap F₀.subtype)) : ↥F₀) * ⟨c, hcF₀⟩ = 1 := by
    have := u.inv_mul
    rw [hu] at this
    exact congrArg Subtype.val this
  have hval' : ((((u⁻¹ : (↥(O.comap F₀.subtype))ˣ) : ↥(O.comap F₀.subtype)) : ↥F₀) : F) * c = 1 := by
    have := congrArg Subtype.val hval
    simpa using this
  have hinv' : c⁻¹ = ((((u⁻¹ : (↥(O.comap F₀.subtype))ˣ) : ↥(O.comap F₀.subtype)) : ↥F₀) : F) := by
    rw [eq_comm, ← mul_eq_one_iff_eq_inv₀ hc0]; exact hval'
  rw [hinv']
  have hmem := ((u⁻¹ : (↥(O.comap F₀.subtype))ˣ) : ↥(O.comap F₀.subtype)).2
  rw [ValuationSubring.mem_comap] at hmem
  exact hmem

end Dominate

