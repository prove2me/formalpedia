theorem st_upd0_gSt (t : IState HS) (Q u n vT : ℕ) (D : List Item) :
    (gSt t Q u n vT).upd 0 D = gSt (t.upd 0 D) Q u n vT := by
  unfold gSt; ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))

set_option maxHeartbeats 16000000 in
theorem p2E_runs_sol_aux {pM : Fin P} (hMul : MulOK I iprog pM MS) {pS : Fin HS} (hpS : LS pS)
    {eSw : Fin P} {dS : Fin HS} {K : ℝ} (hK : SwOKτ τ I iprog eSw dS K) (hdS : dS ≠ 0)
    {Dsc : Fin HS} (hD : Dsc = 18 ∨ Dsc = 19) (hDd : Dsc ≠ dS)
    (u w cz cr : ℕ) (bs : List Bool) (hu : 1 ≤ u) (hcz : cz = 2 * cr) (hcr : 1 ≤ cr)
    (hn2 : 2 ≤ bs.length)
    (xs0 : List ℤ) (hx : Bnd w xs0) (Z : ℕ) (hZ3 : 3 ≤ Z)
    (hVZ : zsz ((vol (shP u bs) * cz : ℕ) : ℤ) ≤ Z) (zw : zsz (w : ℤ) ≤ Z)
    (zU : zsz ((2 ^ u : ℕ) : ℤ) ≤ Z)
    (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
      (lay1 (bgB bs) bs.length 0) xs0 0) ++ R)
    {RS LN LZ LW LU L2 : List Item}
    (hpS0 : t.G pS = ints (zl (shP u bs)) ++ RS) (hN : t.G nR = .int (bs.length : ℤ) :: LN)
    (hZ : t.G rCZ = .int (cz : ℤ) :: LZ)
    (hW : t.G rW = .int (w : ℤ) :: LW) (hUu : t.G rU = .int (u : ℤ) :: LU)
    (h2 : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: L2) :
    IRuns I iprog (p2E pM pS eSw dS Dsc) t
      (t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (((lay1 (bgB bs) bs.length 0).take bs.length).reverse ++
          (lay1 (bgB bs) bs.length 0).drop bs.length) xs0 0) ++ R))
      (cP2E τ K u bs.length w Z (vol (ctB u cz bs) * cr) (vol (shP u bs) * cz)) := by
  set n := bs.length with hn
  set Q := 2 ^ u with hQd
  set T := ctB u cz bs ++ [cz] with hT
  set c2 := vol (ctB u cz bs) * cr with hc2d
  set V := vol (shP u bs) * cz with hV
  have hcz1 : 1 ≤ cz := by omega
  have hvc := vol_ctB u cz bs hcz1
  have hct := one_le_ctB u cz bs hcz1
  have hQ1 : 1 ≤ Q := Nat.one_le_two_pow
  have hvT : vol T = c2 * 2 := by
    rw [hT, vol_append]; simp only [vol_cons, vol_nil, mul_one]; rw [hc2d, hcz]; ring
  have hTpos : ∀ a ∈ T, 1 ≤ a := by
    have h1 : (lay1 (bgB bs) n 0).map (asz (mzB u n cz)) = SH n Q T := by
      rw [shape_lay0]; rfl
    intro a ha
    have : a ∈ (lay1 (bgB bs) n 0).map (asz (mzB u n cz)) := by
      rw [h1]; unfold SH; exact List.mem_append_right _ ha
    obtain ⟨j, -, rfl⟩ := List.mem_map.1 this
    unfold asz; split_ifs
    · exact mzB_pos hcz1 _
    · norm_num
  have hVSH : vol (SH n Q T) = V := by
    rw [vol_SH, hvT, hc2d, hV, ← hvc, hcz]; ring
  have hVge : Q ^ n * (c2 * 2) ≤ V := by rw [← hvT, ← vol_SH, hVSH]
  have hc21 : 1 ≤ c2 := Nat.mul_pos hct hcr
  -- 1. the prologue
  have P1 := proU_runs (I := I) (iprog := iprog) hMul hpS u cz cr bs hu hcz hcr Z hZ3 hVZ zU t
    (RS := RS) (LN := LN) (LZ := LZ) (L2 := L2) hpS0 hN hZ h2
  set s1 := ((t.upd rB (.int ((c2 : ℕ) : ℤ) :: t.G rB)).upd
    rM (.int ((Q ^ n : ℕ) : ℤ) :: t.G rM)).upd rH (.int ((n / 2 : ℕ) : ℤ) :: t.G rH) with hs1
  -- 2. the globals
  have P2 := globU_runs (I := I) (iprog := iprog) hMul Q u n c2 V Z hQd hu hn2 hVge hc21 hVZ s1
    (L2 := L2) (LM := t.G rM) (LB := t.G rB) (LH := t.G rH) (LN := LN) (LU := LU)
    (by simp +decide [s1, h2]) (by simp +decide [s1]) (by simp +decide [s1])
    (by simp +decide [s1]) (by simp +decide [s1, hN]) (by simp +decide [s1, hUu])
  -- 3. the nine phases
  set xs := Dl (mzB u n cz) (bgB bs) (List.range n ++ [n]) (lay1 (bgB bs) n 0) xs0 0 with hxs
  have hlen : xs.length = vol (SH n Q T) := by
    rw [hxs, Dl, length_pull, vol_lay1, hVSH]
  have P3 := mainU_runs (I := I) (iprog := iprog) hK hdS hD hDd Q u n hQd T hu hn2 hTpos c2 hvT w Z
    hZ3 zw (by rw [hVSH]; exact hVZ) xs hlen (KFU.bnd_pull _ _ _ hx) (gSt s1 Q u n (c2 * 2)) R
    (by simp +decide [gSt, s1, h0])
    (L2 := L2) (LP := t.G gP) (LB := t.G gB) (LD := t.G gD) (LI := t.G gI) (LH := t.G rH)
    (RSP := t.G oSP) (LUm := t.G gUm) (LQm := t.G gQm) (LMd := t.G gMd) (LBB := t.G rB) (LW := LW)
    (by simp +decide [gSt, s1, h2]) (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1, hvT])
    (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1])
    (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1])
    (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1]) (by simp +decide [gSt, s1, hW])
  rw [hQd, word_Dl u cz bs hu hcz1 xs0, ← hQd] at P3
  set D := ints (Dl (mzB u n cz) (bgB bs) (List.range n ++ [n])
    (((lay1 (bgB bs) n 0).take n).reverse ++ (lay1 (bgB bs) n 0).drop n) xs0 0) ++ R with hDd'
  rw [st_upd0_gSt] at P3
  -- 4. pop the globals
  have P4 := gdropU_runs (I := I) (iprog := iprog) Q u n (c2 * 2) V Z (by
      have : 2 ^ 1 ≤ 2 ^ u := Nat.pow_le_pow_right (by norm_num) hu
      simpa [hQd] using this) hn2 hVge (by omega)
    (by
      have h1 : u * (n / 2) < 2 ^ (u * (n / 2)) := Nat.lt_two_pow_self
      have h2' : 2 ^ (u * (n / 2)) ≤ Q ^ n := by
        rw [hQd, ← pow_mul]; exact Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ (by omega))
      have h3 : Q ^ n ≤ V := le_trans (Nat.le_mul_of_pos_right _ (by omega)) hVge
      omega) hVZ
    (s1.upd 0 D) (LN := LN) (by simp +decide [s1, hN])
  -- 5. pop rB, rM, rH
  have hle : ∀ x : ℕ, x ≤ V → zsz (x : ℤ) ≤ Z := fun x hx => le_trans (zsz_natCast_le hx) hVZ
  have hQnV : Q ^ n ≤ V := le_trans (Nat.le_mul_of_pos_right _ (by omega)) hVge
  have hc2V : c2 ≤ V := le_trans (by omega) (le_trans (Nat.le_mul_of_pos_left _
    (Nat.one_le_pow _ _ (by omega))) hVge)
  have hnV : n / 2 ≤ V := le_trans (by
    have : n < 2 ^ n := Nat.lt_two_pow_self
    have h' : 2 ^ n ≤ Q ^ n := Nat.pow_le_pow_left (by
      have : 2 ^ 1 ≤ 2 ^ u := Nat.pow_le_pow_right (by norm_num) hu
      simpa [hQd] using this) _
    omega) hQnV
  have D1 := IRuns.drop (I := I) (iprog := iprog) (s := s1.upd 0 D) (i := rB)
    (a := ((c2 : ℕ) : ℤ)) (L := t.G rB) (by simp +decide [s1])
  have D2 := IRuns.drop (I := I) (iprog := iprog) (s := (s1.upd 0 D).upd rB (t.G rB)) (i := rM)
    (a := ((Q ^ n : ℕ) : ℤ)) (L := t.G rM) (by simp +decide [s1])
  have D3 := IRuns.drop (I := I) (iprog := iprog)
    (s := ((s1.upd 0 D).upd rB (t.G rB)).upd rM (t.G rM)) (i := rH)
    (a := ((n / 2 : ℕ) : ℤ)) (L := t.G rH) (by simp +decide [s1])
  refine (P1.seq (P2.seq (P3.seq (P4.seq (D1.seq (D2.seq D3)))))).mono' ?_ ?_
  · simp only [s1]
    clear * -
    ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
  · have d1 := drop_le_cU (Z := Z) (hle _ hc2V)
    have d2 := drop_le_cU (Z := Z) (hle _ hQnV)
    have d3 := drop_le_cU (Z := Z) (hle _ hnV)
    unfold cP2E
    rw [← hQd, ← hVSH]
    have hPn : cPro bs.length Z = cPro n Z := by rw [hn]
    clear * - d1 d2 d3 hPn
    omega

/-! ## The reversal -/

end Gen

end NLogN.KFUU.R6Crt

end

theorem solution : type_of% @NLogN.KFUU.R6Crt.p2E_runs_sol_aux := @NLogN.KFUU.R6Crt.p2E_runs_sol_aux
