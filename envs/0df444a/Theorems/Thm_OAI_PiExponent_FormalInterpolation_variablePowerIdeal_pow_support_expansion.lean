-- title:
--   Finite monomial expansion for powers of variable-power ideals
-- statement:
--   Membership in the nth power of the ideal generated by the variable powers yields a finite sum of polynomial multiples of monomials, with each monomial’s generator multiplicities summing to n. If the coefficient of the sum at d is nonzero, at least one summand has a nonzero coefficient there. The statement includes n = 0 and zero generator exponents.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.variablePowerIdeal_pow_support_expansion
    {σ : Type*} [Fintype σ] {k : Type*} [CommSemiring k]
    (e : σ → Nat) (n : Nat) (p : MvPolynomial σ k)
    (hp : p ∈ (Ideal.span (Set.range
      (fun i : σ => (MvPolynomial.X i : MvPolynomial σ k) ^ e i))) ^ n)
    (d : σ →₀ Nat) (hd : p.coeff d ≠ 0) :
    ∃ (m : Nat) (b : Fin m → σ → Nat)
      (q : Fin m → MvPolynomial σ k),
      (∀ j, (∑ i, b j i) = n) ∧
      p = ∑ j, MvPolynomial.monomial
        (Finsupp.equivFunOnFinite.symm (fun i : σ => e i * b j i)) (1 : k) * q j ∧
      ∃ j, (MvPolynomial.monomial
        (Finsupp.equivFunOnFinite.symm (fun i : σ => e i * b j i)) (1 : k) * q j).coeff d ≠ 0 := by sorry
