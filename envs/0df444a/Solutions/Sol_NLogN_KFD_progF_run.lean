      or_false, Step.swap.injEq] at hp
    exact ⟨p.1, p.2, hp.1, hp.2⟩
  · exact absurd h (swap_not_mem_of_shifts (hSteps_shift E₁))
  · exact absurd h (swap_not_mem_of_shifts (revSteps_shift (dSteps_shift E₂)))

