  intro ⟨hX, hY⟩
  have heq : Affine.Point.some _ _ (nonsingular_map_addFun hΔ hA) = mapPoint hΔ hA := by
    show Affine.Point.some _ _ _ = Affine.Point.some _ _ _
    simp only [Affine.Point.some.injEq]; exact ⟨hX, hY⟩
