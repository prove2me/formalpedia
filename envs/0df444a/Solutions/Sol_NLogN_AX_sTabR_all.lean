theorem solution (p s t α Bq : ℕ) (st : NLogN.IState NLogN.HS) (ht : 0 < t) (hR : NLogN.AX.STabRegs p s t α st)
    (H : NLogN.AX.TabHyp p s t α Bq) :
    NLogN.AX.sTabR.ok st ∧ NLogN.AX.sTabR.run st = st.upd NLogN.AX.aW (NLogN.ints (NLogN.Rsp.sTab p s t α).flatten ++ st.G NLogN.AX.aW) ∧
      NLogN.AX.sTabR.cost st ≤ NLogN.Rsp.tabCost (2 * HvdH.sWidth p α + 1) t (NLogN.Rsp.sWCost p Bq) := by
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, ⟨L6, h6⟩, ⟨L7, h7⟩⟩ := hR
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, -⟩ := NLogN.AX.σB_vals
  have K := NLogN.Rsp.sTabP_all (st.rn NLogN.AX.σB⁻¹) p s t α Bq L1 L2 L3 L4 L5 L6 L7 ht
    (by rw [NLogN.Rsp.rn_inv_G, v1, h1]) (by rw [NLogN.Rsp.rn_inv_G, v2, h2]) (by rw [NLogN.Rsp.rn_inv_G, v3, h3])
    (by rw [NLogN.Rsp.rn_inv_G, v4, h4]) (by rw [NLogN.Rsp.rn_inv_G, v5, h5]) (by rw [NLogN.Rsp.rn_inv_G, v6, h6])
    (by rw [NLogN.Rsp.rn_inv_G, v7, h7]) H.hBq (NLogN.AX.p_zsz p Bq H.hEq)
    (NLogN.zsz_le_of_lt (by rw [Int.natAbs_natCast]; exact H.hK2)) (NLogN.AX.beta_zsz p α Bq H.hEq)
    (fun j => NLogN.AX.betaExp_zsz p α _ j Bq H.hEq) (fun j => NLogN.AX.expNeg_zsz p _ j Bq H.hEq)
  refine ⟨(NLogN.AX.rs_ok_any NLogN.AX.σB NLogN.AX.σB_fix _ st).2 K.1, ?_, by rw [NLogN.AX.sTabR, NLogN.AX.rs_cost_any]; exact K.2.2⟩
  rw [NLogN.AX.sTabR, NLogN.RS.run_ren_any, K.2.1, NLogN.Rsp.rn_inv_upd, v8, NLogN.Rsp.rn_inv_G, v8]
