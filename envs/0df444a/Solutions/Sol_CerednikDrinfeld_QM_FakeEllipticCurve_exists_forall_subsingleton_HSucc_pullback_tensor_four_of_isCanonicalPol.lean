theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S : Type} [CommRing S]
    (E : FakeEllipticCurve Λ N S) (star : ↥Λ → ↥Λ) (𝓛 : E.A.Modules) (h𝓛 : E.IsCanonicalPol star 𝓛)
    (K : Type) [Field K] [Algebra S K] :
    ∃ 𝒲 : (Limits.pullback E.f (Scheme.TwoAffineOpenCover.specMap S K)).OrderedAffineCover, ∀ i : ℕ,
      Subsingleton ((OModulePresheaf.ofModules (Limits.pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K))
        ((Scheme.Modules.pullback (Limits.pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K))).obj (𝓛 ⊗ 𝓛 ⊗ 𝓛 ⊗ 𝓛))).HSucc 𝒲 i) := by
  have hinv : Scheme.Modules.IsInvertible 𝓛 := h𝓛.1
  haveI : Smooth E.f := E.bundle.smooth

  have hAK : AbelianSchemePropertyBundle K (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) :=
    E.bundle.of_isPullback (IsPullback.of_hasPullback E.f (Scheme.TwoAffineOpenCover.specMap S K))
  have hdimK : ∀ s' : ↥(Spec (CommRingCat.of K)), topologicalKrullDim ↥((pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)).base ⁻¹' {s'}) = 2 :=
    AlgebraicGeometry.topologicalKrullDim_preimage_pullback_snd_eq_of_smooth_of_isConnected (algebraMap S K) E.f
      E.bundle.connectedFibres 2 E.dim_fibre
  let act' : ↥Λ → (pullback E.f (Scheme.TwoAffineOpenCover.specMap S K) ⟶ pullback E.f (Scheme.TwoAffineOpenCover.specMap S K)) := fun x =>
    pullback.lift ((pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)) ≫ E.act x) (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) (by rw [Category.assoc, E.act_over]; exact pullback.condition)
  have act_over' : ∀ x : ↥Λ, act' x ≫ (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) = (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) := fun x => pullback.lift_snd _ _ _
  have hact : ∀ x : ↥Λ, act' x ≫ (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)) = (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)) ≫ E.act x := fun x => pullback.lift_fst _ _ _
  have hmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t' (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K))),
      ((E.L.baseChange (Scheme.TwoAffineOpenCover.specMap S K)).mul t' x y).1 ≫ (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)) =
        (E.L.mul (t' ≫ (Scheme.TwoAffineOpenCover.specMap S K))
          ⟨x.1 ≫ (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)), by rw [Category.assoc, (IsPullback.of_hasPullback E.f (Scheme.TwoAffineOpenCover.specMap S K)).w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)), by rw [Category.assoc, (IsPullback.of_hasPullback E.f (Scheme.TwoAffineOpenCover.specMap S K)).w, ← Category.assoc, y.2]⟩).1 := by
    intro T t' x y
    rw [RelativeGroupLaw.baseChange_mul, RelativeGroupLaw.baseChangePointOfBase_coe, pullback.lift_fst]
    rfl
  have hdatK : IsCanonicalPolData (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) (E.L.baseChange (Scheme.TwoAffineOpenCover.specMap S K)) act' act_over' star
      ((Scheme.Modules.pullback (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K))).obj 𝓛) :=
    CerednikDrinfeld.QM.IsCanonicalPolData.pullback_of_isPullback (algebraMap S K) E.L (E.L.baseChange (Scheme.TwoAffineOpenCover.specMap S K))
      E.act E.act_over act' act_over' star (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K)) (IsPullback.of_hasPullback E.f (Scheme.TwoAffineOpenCover.specMap S K)) hmul hact 𝓛 h𝓛

  let Kb : Type := AlgebraicClosure K
  obtain ⟨Lk, hc, hAk, hsm, 𝓛₀, h𝓛₀, hK₀, hsym₀, ⟨e₀⟩, hpos₀⟩ :=
    CerednikDrinfeld.QM.IsCanonicalPolData.exists_relativeGroupLaw_geomFibre_exists_kernelTrivial_isSymmetric_iso_tensor_self_finrank_pos
      (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) (E.L.baseChange (Scheme.TwoAffineOpenCover.specMap S K)) hAK hdimK act' act_over' star ((Scheme.Modules.pullback (pullback.fst E.f (Scheme.TwoAffineOpenCover.specMap S K))).obj 𝓛) hdatK
      Kb (algebraMap K Kb)
  haveI := hsm
  have hKfin₀ : (kernelPts (pullback.snd (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) (Spec.map (CommRingCat.ofHom (algebraMap K Kb)))) Lk 𝓛₀).Finite := by
    rw [AlgebraicGeometry.Polarisation.kernelPts_eq_singleton_one_of_kernelTrivial _ Lk 𝓛₀ h𝓛₀ hK₀]
    exact Set.finite_singleton _

  let p' := pullback.fst (pullback.snd E.f (Scheme.TwoAffineOpenCover.specMap S K)) (Spec.map (CommRingCat.ofHom (algebraMap K Kb)))
  let e4 : (𝓛₀ ⊗ 𝓛₀) ⊗ (𝓛₀ ⊗ 𝓛₀) ≅ 𝓛₀.tensorPow 4 :=
    (α_ (𝓛₀ ⊗ 𝓛₀) 𝓛₀ 𝓛₀).symm ≪≫ whiskerRightIso (whiskerRightIso (whiskerRightIso (λ_ 𝓛₀).symm 𝓛₀) 𝓛₀) 𝓛₀
