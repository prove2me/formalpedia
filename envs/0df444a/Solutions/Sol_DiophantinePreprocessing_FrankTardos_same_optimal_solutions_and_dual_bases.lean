  let G : Matrix ι ι ℝ := (integerGram C).map (Int.castRingHom ℝ)
  have hGcoeff : G *ᵥ coeff = fun i => (b i : ℝ) := by
    funext i
    calc
      (G *ᵥ coeff) i = inner ℝ (integerRows C i) (∑ k, coeff k • integerRows C k) := by
        simp [G, integerGram_cast, Matrix.mulVec, dotProduct, inner_sum,
