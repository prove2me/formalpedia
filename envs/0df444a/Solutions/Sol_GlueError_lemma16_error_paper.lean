section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
open GlueError
open Finset Butterfly AModel Synth GlueLayout GlueP14
variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ}
variable (C : CoeffModel y r)
variable {C}
variable {D : ℕ} {sh : Shape} {ι : Type} [Fintype ι] [DecidableEq ι]
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
theorem solution (p : ℕ) (hK : 0 < K) (hℓ : 1 ≤ ℓ) (hy : y ^ (2 ^ ℓ) = -1)
    {xs : List R} (hlen : xs.length = AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length))
    (hdisk : ∀ k, ‖C.co (xs.getD k 0)‖ ≤ 1)
    {v : List ℕ} (hv : AModel.Valid (Synth.binSh (Synth.tgtL D ℓ K long).length) v) :
    ‖C.co ((GlueError.procQ C p (GlueLayout.paperLayout D ℓ K long hK hℓ) ℓ (Synth.partAxes (Synth.al D ℓ long))
        (GlueLayout.paperSel D ℓ K long hK hℓ) ℓ xs).getD (AModel.encode (Synth.binSh (Synth.tgtL D ℓ K long).length) v) 0 -
        Synth.Fm y ℓ (Synth.al D ℓ long) (Synth.fn (GlueLayout.paperLayout D ℓ K long hK hℓ) xs)
          (Synth.revV (Synth.al D ℓ long) ((GlueLayout.paperLayout D ℓ K long hK hℓ).coord v)))‖ <
      ℓ * (Real.sqrt 2 * 2⁻¹ ^ p) :=
  GlueError.lemma16_error_Fm p _ hy (GlueLayout.al_le D ℓ long) hℓ (fun h _ => GlueLayout.paper_compat D ℓ K long hK hℓ h)
    hlen hdisk hv
