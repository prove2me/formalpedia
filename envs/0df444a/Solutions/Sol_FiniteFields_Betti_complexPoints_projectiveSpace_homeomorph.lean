/-!
# Cartes de `ℙⁿ_R` sur un anneau quelconque (A5b, préliminaires)

Reprise de `Bridge/Chart.lean` et `Bridge/ProjectivePoints.lean` (écrits pour un corps `k` et
une `k`-algèbre `L`), pour un anneau commutatif `R` (noté `k` ici), l'espace `projectiveSpaceOver`
et un morphisme d'anneaux `σ : R →+* L` au lieu d'une structure d'algèbre. Les preuves sont
inchangées. Les fichiers d'origine ne sont pas modifiés.

* `Chart k n i = 𝒜_(Xᵢ)`, `ratio i j = Xⱼ/Xᵢ`, `chartBase`, déshomogénéisation
  `eval₂_ratio_eq_mk`, `chart_hom_ext`, `chartEval σ i v`, `awayHomEquiv`.
* `chartι`, `chartPoint`, `exists_chartPoint`, `exists_forall_mem_basicOpen`,
  `chartPoint_mem_basicOpen_iff`.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization FiniteFields.Betti

namespace FiniteFields.Betti.ProjCharts

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k : Type) [CommRing k] (n : ℕ)

/-- La graduation de `k[X₀, …, Xₙ]` par le degré total. -/
abbrev Grading : ℕ → Submodule k (MvPolynomial (Fin (n + 1)) k) :=
  MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k

theorem X_mem_grading (j : Fin (n + 1)) : (X j : MvPolynomial (Fin (n + 1)) k) ∈ Grading k n 1 :=
  (mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X k j)

/-- L'anneau de la carte `D₊(Xᵢ)` : la partie de degré zéro de `k[X₀, …, Xₙ][1/Xᵢ]`. -/
abbrev Chart (i : Fin (n + 1)) : Type :=
  Away (Grading k n) (X i : MvPolynomial (Fin (n + 1)) k)

variable {k n}

/-- La fonction coordonnée `Xⱼ / Xᵢ` sur la carte `D₊(Xᵢ)`. -/
def ratio (i j : Fin (n + 1)) : Chart k n i :=
  Away.mk (Grading k n) (X_mem_grading k n i) 1 (X j) (by simpa using X_mem_grading k n j)

variable (k n) in
/-- La flèche structurale `k → 𝒜_(Xᵢ)`, via `k → 𝒜 0 → 𝒜_(Xᵢ)` comme dans `projectiveSpace.toSpec`. -/
def chartBase (i : Fin (n + 1)) : k →+* Chart k n i :=
  (algebraMap (Grading k n 0) (Chart k n i)).comp (algebraMap k (Grading k n 0))

/-- **Déshomogénéisation.** Pour `x` homogène de degré `m`, `x / Xᵢ^m` est la valeur de `x` en
les coordonnées `Xⱼ / Xᵢ`. -/
theorem eval₂_ratio_eq_mk (i : Fin (n + 1)) (m : ℕ) (x : MvPolynomial (Fin (n + 1)) k)
    (hx : x ∈ Grading k n (m • 1)) :
    eval₂ (chartBase k n i) (ratio i) x = Away.mk (Grading k n) (X_mem_grading k n i) m x hx := by
  let ι := algebraMap (MvPolynomial (Fin (n + 1)) k)
    (Localization.Away (X i : MvPolynomial (Fin (n + 1)) k))
  let ν := algebraMap (Chart k n i) (Localization.Away (X i : MvPolynomial (Fin (n + 1)) k))
  have hxi : (X i : MvPolynomial (Fin (n + 1)) k) ∈ Submonoid.powers (X i) := Submonoid.mem_powers _
  let u : Localization.Away (X i : MvPolynomial (Fin (n + 1)) k) :=
    IsLocalization.mk' _ (1 : MvPolynomial (Fin (n + 1)) k) ⟨X i, hxi⟩
  have hbase : ν.comp (chartBase k n i) = ι.comp (algebraMap k _) := by
    ext c
    change Localization.mk ((algebraMap k (Grading k n 0) c : MvPolynomial (Fin (n + 1)) k)) 1 = _
    rw [Localization.mk_one_eq_algebraMap]
    rfl
  have hratio : ∀ j, ν (ratio i j) = ι (X j) * u := by
    intro j
    change Localization.mk _ _ = _
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one]
    congr 2
    exact Subtype.ext (pow_one _)
  have hrhs : ν (Away.mk (Grading k n) (X_mem_grading k n i) m x hx) = ι x * u ^ m := by
    change Localization.mk _ _ = _
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, ← IsLocalization.mk'_pow, one_pow]
    rfl
  have hhom : x.IsHomogeneous m := by
    simpa using (mem_homogeneousSubmodule _ _).mp hx
  apply val_injective
  rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply]
  change ν _ = ν _
  rw [eval₂_comp_left, hbase, hrhs]
  simp_rw [Function.comp_def, hratio]
  conv_lhs => rw [x.as_sum]
  conv_rhs => rw [x.as_sum]
  rw [eval₂_sum, map_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun s hs ↦ ?_
  have hdeg : ∑ j, s j = m := by
    rw [← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
    exact hhom (mem_support_iff.mp hs)
  rw [eval₂_monomial, monomial_eq, Finsupp.prod_fintype _ _ (by simp),
    Finsupp.prod_fintype _ _ (by simp)]
  simp only [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg, map_mul, map_prod,
    map_pow, RingHom.comp_apply, MvPolynomial.algebraMap_eq]
  ring


/-- Deux morphismes `𝒜_(Xᵢ) → L` compatibles à `k` et égaux sur les `Xⱼ / Xᵢ` sont égaux. -/
theorem chart_hom_ext {L : Type*} [CommRing L] {σ : k →+* L} {i : Fin (n + 1)}
    {φ ψ : Chart k n i →+* L} (hφ : φ.comp (chartBase k n i) = σ)
    (hψ : ψ.comp (chartBase k n i) = σ) (h : ∀ j, φ (ratio i j) = ψ (ratio i j)) :
    φ = ψ := by
  ext z
  obtain ⟨m, x, hx, rfl⟩ := Away.mk_surjective (Grading k n) (X_mem_grading k n i) z
  rw [← eval₂_ratio_eq_mk i m x hx, eval₂_comp_left, eval₂_comp_left, hφ, hψ]
  congr 1
  funext j
  exact h j

variable {L : Type*} [CommRing L] (σ : k →+* L)

/-- Évaluation en un vecteur `v` avec `vᵢ = 1` : `x / Xᵢ^m ↦ x(v)`. -/
def chartEval (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i = 1) : Chart k n i →+* L :=
  (IsLocalization.Away.lift (S := Localization.Away (X i : MvPolynomial (Fin (n + 1)) k))
      (X i : MvPolynomial (Fin (n + 1)) k)
      (g := eval₂Hom σ v)
      (by simp [hv])).comp
    (algebraMap (Chart k n i) (Localization.Away (X i : MvPolynomial (Fin (n + 1)) k)))

theorem chartEval_ratio (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i = 1) (j : Fin (n + 1)) :
    chartEval σ i v hv (ratio (k := k) i j) = v j := by
  simp [chartEval, ratio, Localization.mk_eq_mk', IsLocalization.Away.lift,
    IsLocalization.lift_mk'_spec, hv]

theorem chartEval_comp_base (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i = 1) :
    (chartEval σ i v hv).comp (chartBase k n i) = σ := by
  ext c
  have h : HomogeneousLocalization.val ((algebraMap (Grading k n 0) (Chart k n i)) ((algebraMap k (Grading k n 0)) c)) =
      algebraMap (MvPolynomial (Fin (n + 1)) k)
        (Localization.Away (X i : MvPolynomial (Fin (n + 1)) k)) (algebraMap k _ c) := by
    change Localization.mk ((algebraMap k (Grading k n 0) c : MvPolynomial (Fin (n + 1)) k)) 1 = _
    rw [Localization.mk_one_eq_algebraMap]
    rfl
  simp [chartEval, chartBase, h, IsLocalization.Away.lift_eq]

theorem ratio_self (i : Fin (n + 1)) : ratio (k := k) i i = 1 := by
  apply val_injective
  simp [ratio]

variable (k n) in
/-- **Morphismes de la carte `D₊(Xᵢ)` vers `L`.** Un morphisme `𝒜_(Xᵢ) → L` compatible à `k`
équivaut au vecteur de ses valeurs sur les `Xⱼ / Xᵢ`, qui vaut `1` en `i`. -/
def awayHomEquiv (i : Fin (n + 1)) :
    {φ : Chart k n i →+* L // φ.comp (chartBase k n i) = σ} ≃
      {v : Fin (n + 1) → L // v i = 1} where
  toFun φ := ⟨fun j ↦ φ.1 (ratio i j), by simp only [ratio_self, map_one]⟩
  invFun v := ⟨chartEval σ i v.1 v.2, chartEval_comp_base σ i v.1 v.2⟩
  left_inv φ := by
    have hv : (fun j ↦ φ.1 (ratio i j)) i = 1 := by simp only [ratio_self, map_one]
    exact Subtype.ext (chart_hom_ext (chartEval_comp_base σ i _ hv) φ.2 fun j ↦ chartEval_ratio σ i _ hv j)
  right_inv v := Subtype.ext <| funext fun j ↦ chartEval_ratio σ i v.1 v.2 j


variable {k : Type} [CommRing k] {n : ℕ}

/-! ## A3. Cartes et flèche structurale -/

variable (k n) in
/-- L'immersion ouverte de la carte `D₊(Xᵢ) ≅ Spec 𝒜_(Xᵢ)` dans `ℙⁿ_k`. -/
abbrev chartι (i : Fin (n + 1)) : Spec (.of (Chart k n i)) ⟶ projectiveSpaceOver k n :=
  Proj.awayι (Grading k n) (X i) (X_mem_grading k n i) zero_lt_one

/-- Sur la carte `i`, la flèche structurale de la plateforme est `Spec` de `chartBase`. -/
theorem chartι_toSpec (i : Fin (n + 1)) :
    chartι k n i ≫ projectiveSpaceOver.toSpec k n = Spec.map (CommRingCat.ofHom (chartBase k n i)) := by
  rw [projectiveSpaceOver.toSpec, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
  rfl

variable (k n) in
/-- Les cartes `D₊(Xᵢ)` recouvrent `ℙⁿ_k`. -/
theorem iSup_basicOpen_X :
    ⨆ i, Proj.basicOpen (Grading k n) (X i : MvPolynomial (Fin (n + 1)) k) = ⊤ := by
  apply Proj.iSup_basicOpen_eq_top'
  · exact fun i ↦ ⟨1, X_mem_grading k n i⟩
  · suffices h : ∀ p, p ∈ Algebra.adjoin (Grading k n 0)
        (Set.range (X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k)) from
      eq_top_iff.mpr fun p _ ↦ h p
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      exact Subalgebra.algebraMap_mem _
        (⟨C a, (mem_homogeneousSubmodule _ _).mpr (isHomogeneous_C _ a)⟩ : Grading k n 0)
    | add p q hp hq => exact add_mem hp hq
    | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

/-! ## B2. Points dans une carte -/

variable {L : Type} [Field L]

/-- Le point de `ℙⁿ` à valeurs dans `L` défini par un morphisme de l'anneau de la carte `i`. -/
def chartPoint (i : Fin (n + 1)) (φ : Chart k n i →+* L) : Spec (.of L) ⟶ projectiveSpaceOver k n :=
  Spec.map (CommRingCat.ofHom φ) ≫ chartι k n i

theorem chartPoint_toSpec (i : Fin (n + 1)) (φ : Chart k n i →+* L) :
    chartPoint i φ ≫ projectiveSpaceOver.toSpec k n =
      Spec.map (CommRingCat.ofHom (φ.comp (chartBase k n i))) := by
  rw [chartPoint, Category.assoc, chartι_toSpec, ← Spec.map_comp]
  rfl

/-- Le point `chartPoint i φ` est au-dessus de `k` si et seulement si `φ` est compatible à `k`. -/
theorem chartPoint_over_iff (σ : k →+* L) (i : Fin (n + 1)) (φ : Chart k n i →+* L) :
    chartPoint i φ ≫ projectiveSpaceOver.toSpec k n = Spec.map (CommRingCat.ofHom σ) ↔
      φ.comp (chartBase k n i) = σ := by
  rw [chartPoint_toSpec, Spec.map_inj]
  exact ⟨fun h ↦ by simpa using congrArg CommRingCat.Hom.hom h, fun h ↦ by rw [h]⟩

theorem chartPoint_injective (i : Fin (n + 1)) :
    Function.Injective (chartPoint (k := k) (L := L) i) := by
  intro φ ψ h
  rw [chartPoint, chartPoint, cancel_mono, Spec.map_inj] at h
  simpa using congrArg CommRingCat.Hom.hom h

/-- Un point dont l'image est dans `D₊(Xᵢ)` vient de la carte `i`. -/
theorem exists_chartPoint (x : Spec (.of L) ⟶ projectiveSpaceOver k n) (i : Fin (n + 1))
    (hx : ∀ p, x.base p ∈ Proj.basicOpen (Grading k n) (X i : MvPolynomial (Fin (n + 1)) k)) :
    ∃ φ, chartPoint i φ = x := by
  have H : Set.range x.base ⊆ Set.range (chartι k n i).base := by
    rintro _ ⟨p, rfl⟩
    have := hx p
    rw [← Proj.opensRange_awayι (Grading k n) (X i) (X_mem_grading k n i) zero_lt_one] at this
    exact this
  obtain ⟨ψ, hψ⟩ := Spec.map_surjective (IsOpenImmersion.lift (chartι k n i) x H)
  exact ⟨ψ.hom, by rw [chartPoint, CommRingCat.ofHom_hom, hψ, IsOpenImmersion.lift_fac]⟩

/-- Tout point de `ℙⁿ` à valeurs dans un corps tombe dans une carte. -/
theorem exists_forall_mem_basicOpen (x : Spec (.of L) ⟶ projectiveSpaceOver k n) :
    ∃ i, ∀ p, x.base p ∈ Proj.basicOpen (Grading k n) (X i : MvPolynomial (Fin (n + 1)) k) := by
  obtain ⟨p₀⟩ := (inferInstance : Nonempty (PrimeSpectrum L))
  have h : x.base p₀ ∈ (⊤ : (projectiveSpaceOver k n).Opens) := trivial
  rw [← iSup_basicOpen_X k n, TopologicalSpace.Opens.mem_iSup] at h
  obtain ⟨i, hi⟩ := h
  exact ⟨i, fun p ↦ by rwa [Subsingleton.elim p p₀]⟩

theorem ratio_eq_isLocalizationElem (i j : Fin (n + 1)) :
    ratio (k := k) i j = Away.isLocalizationElem (X_mem_grading k n i) (X_mem_grading k n j) := by
  apply val_injective
  simp [ratio]

/-- **Critère d'appartenance à une carte.** Le point de la carte `i` défini par `φ` est dans
`D₊(Xⱼ)` si et seulement si `φ (Xⱼ / Xᵢ) ≠ 0`. -/
theorem chartPoint_mem_basicOpen_iff (i j : Fin (n + 1)) (φ : Chart k n i →+* L)
    (p : Spec (.of L)) :
    (chartPoint i φ).base p ∈ Proj.basicOpen (Grading k n) (X j : MvPolynomial (Fin (n + 1)) k) ↔
      φ (ratio i j) ≠ 0 := by
  have hpre : chartPoint i φ ⁻¹ᵁ Proj.basicOpen (Grading k n) (X j) =
      PrimeSpectrum.basicOpen (φ (ratio i j)) := by
    rw [chartPoint, Scheme.Hom.comp_preimage,
      Proj.awayι_preimage_basicOpen (Grading k n) (X_mem_grading k n i) zero_lt_one
        (X_mem_grading k n j) zero_lt_one, ← ratio_eq_isLocalizationElem, SpecMap_preimage_basicOpen]
    rfl
  rw [← Scheme.Hom.mem_preimage, hpre]
  change φ (ratio i j) ∉ (p : PrimeSpectrum L).asIdeal ↔ _
  have hbot : (p : PrimeSpectrum L).asIdeal = ⊥ :=
    haveI := (p : PrimeSpectrum L).isPrime
    Ideal.eq_bot_of_prime _
  rw [hbot, Ideal.mem_bot]

end FiniteFields.Betti.ProjCharts

end
end

/-! ## Recopié de `Bridge/Betti/ProjPoints.lean` -/

section

/-!
# Points de `ℙⁿ_R` à valeurs dans un corps

Pour un anneau commutatif `R`, un corps `L` et `σ : R →+* L`, les points `Spec L ⟶ ℙⁿ_R`
au-dessus de `Spec σ` sont en bijection avec les droites de `Lⁿ⁺¹` (`projPointsEquiv`).

* **Recollement** : les points des cartes `i` et `j` définis par `v/vᵢ` et `v/vⱼ` coïncident,
  via la carte `D₊(XᵢXⱼ)` (`SpecMap_awayMap_awayι`).
* **La bijection** `ℙ(Lⁿ⁺¹) → ℙⁿ_R(L)`, `[v] ↦ point de la carte i défini par v/vᵢ`.

Avec `L = ℂ`, c'est la bijection sous-jacente à l'homéomorphisme d'A5b
(`ComplexPointsProj.lean`) ; avec `L = 𝔽_{q^m}`, elle compte les points.
-/

open AlgebraicGeometry CategoryTheory Opposite MvPolynomial HomogeneousLocalization
open scoped LinearAlgebra.Projectivization

namespace FiniteFields.Betti

theorem top_le_preimage_iff_forall {L : Type} [Field L] {Y : Scheme.{0}} (x : Spec (.of L) ⟶ Y)
    (U : Y.Opens) : ⊤ ≤ x ⁻¹ᵁ U ↔ ∀ p, x.base p ∈ U :=
  ⟨fun h p ↦ h (show p ∈ (⊤ : (Spec (.of L)).Opens) from trivial), fun h p _ ↦ h p⟩

section Glue

open ProjCharts

attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type} [CommRing R] {L : Type} [Field L] (σ : R →+* L) {n : ℕ}

/-- Évaluation `𝒜_(f) → L`, `a / fᵐ ↦ a(v) / f(v)ᵐ`, pour `f(v) ≠ 0`. -/
noncomputable def evAway (f : MvPolynomial (Fin (n + 1)) R) (v : Fin (n + 1) → L)
    (hv : eval₂ σ v f ≠ 0) : Away (Grading R n) f →+* L :=
  (IsLocalization.Away.lift (S := Localization.Away f) f (g := eval₂Hom σ v)
    (isUnit_iff_ne_zero.mpr hv)).comp
    (algebraMap (Away (Grading R n) f) (Localization.Away f))

theorem evAway_mk (f : MvPolynomial (Fin (n + 1)) R) (v : Fin (n + 1) → L)
    (hv : eval₂ σ v f ≠ 0) {d : ℕ} (hf : f ∈ Grading R n d) (m : ℕ) (a : MvPolynomial (Fin (n + 1)) R)
    (ha : a ∈ Grading R n (m • d)) :
    evAway σ f v hv (Away.mk (Grading R n) hf m a ha) = eval₂ σ v a / eval₂ σ v f ^ m := by
  rw [eq_div_iff (pow_ne_zero m hv)]
  have hs : f ^ m ∈ Submonoid.powers f := ⟨m, rfl⟩
  have key : algebraMap (Away (Grading R n) f) (Localization.Away f)
      (Away.mk (Grading R n) hf m a ha) * algebraMap _ (Localization.Away f) (f ^ m) =
      algebraMap _ (Localization.Away f) a := by
    rw [HomogeneousLocalization.algebraMap_apply, Away.val_mk, Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec _ a ⟨f ^ m, hs⟩
  have := congrArg (IsLocalization.Away.lift (S := Localization.Away f) f (g := eval₂Hom σ v)
    (isUnit_iff_ne_zero.mpr hv)) key
  rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at this
  simpa [evAway] using this

/-- Le vecteur normalisé `v / vᵢ`. -/
noncomputable def nv (i : Fin (n + 1)) (v : Fin (n + 1) → L) : Fin (n + 1) → L := fun k ↦ v k / v i

theorem nv_self {i : Fin (n + 1)} {v : Fin (n + 1) → L} (hv : v i ≠ 0) : nv i v i = 1 :=
  div_self hv

/-- **Compatibilité des cartes** : `evAway (XᵢXⱼ) ∘ awayMap = chartEval i (v/vᵢ)`. -/
theorem evAway_comp_awayMap (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hi : v i ≠ 0)
    (hj : v j ≠ 0) (x : MvPolynomial (Fin (n + 1)) R) (hx : x = X i * X j) :
    (evAway σ x v (by subst hx; simp [hi, hj])).comp
        (awayMap (Grading R n) (X_mem_grading R n j) hx) =
      chartEval σ i (nv i v) (nv_self hi) := by
  refine chart_hom_ext ?_ (chartEval_comp_base σ i _ _) fun k ↦ ?_
  · ext r
    simp only [RingHom.comp_apply, chartBase]
    rw [show (algebraMap (Grading R n 0) (Chart R n i)) = fromZeroRingHom _ _ from rfl,
      awayMap_fromZeroRingHom]
    simp only [evAway, fromZeroRingHom, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
    erw [HomogeneousLocalization.val_mk]
    erw [Localization.mk_one_eq_algebraMap, IsLocalization.Away.lift_eq]
    exact eval₂_C σ v r
  · rw [chartEval_ratio, RingHom.comp_apply, ratio, awayMap_mk, evAway_mk]
    subst hx
    simp only [pow_one, nv, eval₂_mul, eval₂_X]
    field_simp

/-- Le point de la carte `i` de vecteur `w` (`wᵢ = 1`). -/
noncomputable def ptOf' (i : Fin (n + 1)) (w : Fin (n + 1) → L) (hw : w i = 1) :
    Spec (.of L) ⟶ projectiveSpaceOver R n :=
  chartPoint i (chartEval σ i w hw)

/-- Le point de `[v]` vu dans la carte `i` (`vᵢ ≠ 0`). -/
noncomputable def ptOf (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    Spec (.of L) ⟶ projectiveSpaceOver R n :=
  ptOf' σ i (nv i v) (nv_self hv)

theorem ptOf'_congr (i : Fin (n + 1)) {w w' : Fin (n + 1) → L} (h : w = w') (hw : w i = 1)
    (hw' : w' i = 1) : ptOf' σ i w hw = ptOf' σ i w' hw' := by
  subst h
  rfl

/-- **Recollement** : le point ne dépend pas de la carte. -/
theorem ptOf_eq (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hi : v i ≠ 0) (hj : v j ≠ 0) :
    ptOf σ i v hi = ptOf (R := R) σ j v hj := by
  have e1 := evAway_comp_awayMap σ i j v hi hj (X i * X j) rfl
  have e2 := evAway_comp_awayMap σ j i v hj hi (X i * X j) (mul_comm _ _)
  simp only [ptOf, ptOf', chartPoint]
  rw [← e1, ← e2, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
    Category.assoc, Category.assoc, chartι, chartι, Proj.SpecMap_awayMap_awayι,
    Proj.SpecMap_awayMap_awayι]

theorem ptOf_smul (i : Fin (n + 1)) (v : Fin (n + 1) → L) (c : L) (hc : c ≠ 0)
    (h : (c • v) i ≠ 0) (hi : v i ≠ 0) : ptOf σ i (c • v) h = ptOf (R := R) σ i v hi := by
  refine ptOf'_congr σ i (funext fun k ↦ ?_) _ _
  simp [nv, mul_div_mul_left _ _ hc]

theorem ptOf_indep {v w : Fin (n + 1) → L} (c : L) (hc : c ≠ 0) (hw : w = c • v)
    (i j : Fin (n + 1)) (hi : w i ≠ 0) (hj : v j ≠ 0) : ptOf σ i w hi = ptOf (R := R) σ j v hj := by
  subst hw
  have hi' : v i ≠ 0 := fun h ↦ hi (by simp [h])
  rw [ptOf_smul σ i v c hc hi hi']
  exact ptOf_eq σ i j v hi' hj

theorem ptOf_over (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    ptOf σ i v hv ≫ projectiveSpaceOver.toSpec R n = Spec.map (CommRingCat.ofHom σ) :=
  (chartPoint_over_iff σ i _).mpr (chartEval_comp_base σ i _ _)

theorem opensRange_chartι (j : Fin (n + 1)) :
    (chartι R n j).opensRange = Proj.basicOpen (Grading R n) (X j : MvPolynomial (Fin (n + 1)) R) :=
  Proj.opensRange_awayι _ _ _ _

theorem ptOf_mem_iff (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    ⊤ ≤ ptOf σ i v hv ⁻¹ᵁ (chartι R n j).opensRange ↔ v j ≠ 0 := by
  obtain ⟨p₀⟩ := (inferInstance : Nonempty (PrimeSpectrum L))
  rw [top_le_preimage_iff_forall, opensRange_chartι]
  simp only [ptOf, ptOf', chartPoint_mem_basicOpen_iff, chartEval_ratio, nv, div_ne_zero_iff]
  exact ⟨fun h ↦ (h p₀).1, fun h _ ↦ ⟨h, hv⟩⟩

end Glue
section Points

open ProjCharts

variable {R : Type} [CommRing R] {L : Type} [Field L] (σ : R →+* L) (n : ℕ)

/-- Les points de `ℙⁿ_R` à valeurs dans `L` au-dessus de `Spec σ`. -/
abbrev ProjPoints : Type :=
  {x : Spec (.of L) ⟶ projectiveSpaceOver R n //
    x ≫ projectiveSpaceOver.toSpec R n = Spec.map (CommRingCat.ofHom σ)}

variable {σ n}

/-- Un indice de coordonnée non nulle. -/
noncomputable def idxL {v : Fin (n + 1) → L} (hv : v ≠ 0) : Fin (n + 1) :=
  Classical.choose (Function.ne_iff.mp hv)

theorem idxL_spec {v : Fin (n + 1) → L} (hv : v ≠ 0) : v (idxL hv) ≠ 0 :=
  Classical.choose_spec (Function.ne_iff.mp hv)

variable (σ) in
/-- **L'application `ℙ(Lⁿ⁺¹) → ℙⁿ_R(L)`.** -/
noncomputable def projPt (p : ℙ L (Fin (n + 1) → L)) : ProjPoints σ n :=
  ⟨ptOf σ (idxL p.rep_nonzero) p.rep (idxL_spec p.rep_nonzero), ptOf_over σ _ _ _⟩

theorem projPt_mk (v : Fin (n + 1) → L) (hv : v ≠ 0) (i : Fin (n + 1)) (hi : v i ≠ 0) :
    (projPt (R := R) σ (Projectivization.mk L v hv)).1 = ptOf σ i v hi := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep L v hv
  exact ptOf_indep σ (c : L) c.ne_zero (by rw [← hc, Units.smul_def]) _ i (idxL_spec _) hi

theorem projPt_injective : Function.Injective (projPt (R := R) (n := n) σ) := by
  intro p p' h
  induction p using Projectivization.ind with
  | h v hv =>
  induction p' using Projectivization.ind with
  | h w hw =>
    have h1 := congrArg Subtype.val h
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hv
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hw
    rw [projPt_mk v hv i hi, projPt_mk w hw j hj] at h1
    have hwi : w i ≠ 0 := by
      have := (ptOf_mem_iff σ i i v hi).mpr hi
      rw [h1] at this
      exact (ptOf_mem_iff σ j i w hj).mp this
    rw [← ptOf_eq σ i j w hwi hj] at h1
    have h2 := chartPoint_injective i h1
    have h3 : ∀ k, v k / v i = w k / w i := fun k ↦ by
      have := congrArg (fun φ ↦ φ (ratio i k)) h2
      simpa [chartEval_ratio, nv] using this
    have hi' : v i ≠ 0 := by simpa using hi
    refine (Projectivization.mk_eq_mk_iff' L _ _ _ _).mpr ⟨v i / w i, funext fun k ↦ ?_⟩
    have := h3 k
    rw [div_eq_div_iff hi' hwi] at this
    rw [Pi.smul_apply, smul_eq_mul, div_mul_eq_mul_div, div_eq_iff hwi]
    linear_combination -this

theorem projPt_surjective : Function.Surjective (projPt (R := R) (n := n) σ) := by
  intro x
  obtain ⟨i, hi⟩ := exists_forall_mem_basicOpen x.1
  obtain ⟨φ, hφ⟩ := exists_chartPoint x.1 i hi
  have hbase : φ.comp (chartBase R n i) = σ :=
    (chartPoint_over_iff σ i φ).mp (by rw [hφ]; exact x.2)
  let v : Fin (n + 1) → L := fun j ↦ φ (ratio i j)
  have hvi : v i = 1 := by
    change φ (ratio i i) = 1
    rw [ratio_self]
    exact φ.map_one
  have hv : v ≠ 0 := fun h ↦ one_ne_zero (hvi ▸ congrFun h i)
  refine ⟨Projectivization.mk L v hv, Subtype.ext ?_⟩
  rw [projPt_mk v hv i (by rw [hvi]; exact one_ne_zero), ptOf,
    ptOf'_congr σ i (w' := v) (funext fun k ↦ by simp [nv, hvi]) _ hvi, ptOf', ← hφ]
  congr 1
  exact chart_hom_ext (chartEval_comp_base σ i _ _) hbase fun j ↦ chartEval_ratio σ i _ _ j

variable (σ n) in
/-- **Bijection `ℙ(Lⁿ⁺¹) ≃ ℙⁿ_R(L)`.** -/
noncomputable def projPointsEquiv : ℙ L (Fin (n + 1) → L) ≃ ProjPoints σ n :=
  Equiv.ofBijective (projPt σ) ⟨projPt_injective, projPt_surjective⟩

end Points

end FiniteFields.Betti

end

/-! ## Recopié de `Bridge/Singular/CPTopology.lean` -/

section

/-!
# Topologie quotient de `ℂPⁿ` (A3, A5b)

Extrait de `ComplexProjective.lean`, sans homologie, pour servir aussi à A5b
(`Bridge/Betti/ComplexPointsProj.lean`) :
* `q : ℂⁿ⁺¹ ∖ {0} → ℂPⁿ` est une application quotient ouverte ; ses restrictions aux ouverts, et
  leurs produits avec un espace quelconque, sont des applications quotient. Une application définie
  sur un ouvert de `ℂPⁿ` (ou sur `Z × ouvert`) est continue dès que son relèvement l'est.
* Coordonnées `init'`, `last'`, `snoc'` de `ℂⁿ⁺²` et représentants (`rep_mk`).
-/

open scoped LinearAlgebra.Projectivization

namespace Hatcher.Singular

section Quot

/-- `ℂⁿ⁺¹`. -/
abbrev Vec (n : ℕ) : Type := Fin (n + 1) → ℂ

/-- `ℂⁿ⁺¹ ∖ {0}`. -/
abbrev NZ (n : ℕ) : Type := {v : Vec n // v ≠ 0}

variable {n : ℕ}

/-- La projection `ℂⁿ⁺¹ ∖ {0} → ℂPⁿ`. -/
noncomputable def q (v : NZ n) : CP n := Projectivization.mk ℂ v.1 v.2

theorem isQuotientMap_q : Topology.IsQuotientMap (q (n := n)) := isQuotientMap_quotient_mk'

theorem continuous_q : Continuous (q (n := n)) := isQuotientMap_q.continuous

theorem surjective_q : Function.Surjective (q (n := n)) := isQuotientMap_q.surjective

/-- L'action de `c ∈ ℂ^×` sur `ℂⁿ⁺¹ ∖ {0}`. -/
def smulNZ (c : ℂˣ) (v : NZ n) : NZ n := ⟨c • v.1, (smul_ne_zero_iff_ne c).mpr v.2⟩

theorem continuous_smulNZ (c : ℂˣ) : Continuous (smulNZ (n := n) c) :=
  ((continuous_const_smul c).comp continuous_subtype_val).subtype_mk _

/-- `ℂⁿ⁺¹ ∖ {0} → ℂPⁿ` est ouverte. -/
theorem isOpenMap_q : IsOpenMap (q (n := n)) := by
  intro O hO
  rw [← isQuotientMap_q.isOpen_preimage]
  have : q ⁻¹' (q '' O) = ⋃ c : ℂˣ, smulNZ c ⁻¹' O := by
    ext w
    simp only [Set.mem_preimage, Set.mem_image, Set.mem_iUnion]
    constructor
    · rintro ⟨v, hv, hvw⟩
      obtain ⟨c, hc⟩ := (Projectivization.mk_eq_mk_iff ℂ _ _ v.2 w.2).mp hvw
      exact ⟨c, by rwa [show smulNZ c w = v from Subtype.ext hc]⟩
    · rintro ⟨c, hc⟩
      exact ⟨_, hc, (Projectivization.mk_eq_mk_iff ℂ _ _ _ w.2).mpr ⟨c, rfl⟩⟩
  rw [this]
  exact isOpen_iUnion fun c ↦ hO.preimage (continuous_smulNZ c)

/-- **Continuité par relèvement** sur `Z × Ω`, `Ω ⊆ ℂPⁿ` (l'ouverture de `q` suffit). -/
theorem continuous_of_lift {Ω : Set (CP n)} {Z Y : Type} [TopologicalSpace Z]
    [TopologicalSpace Y] (F : Z × Ω → Y)
    (hF : Continuous fun p : Z × (q ⁻¹' Ω) ↦ F (p.1, ⟨q p.2, p.2.2⟩)) : Continuous F := by
  have hφ : Topology.IsQuotientMap (Prod.map id (Ω.restrictPreimage (q (n := n))) :
      Z × (q ⁻¹' Ω) → Z × Ω) :=
    (IsOpenMap.id.prodMap (isOpenMap_q.restrictPreimage Ω)).isQuotientMap
      (continuous_id.prodMap continuous_q.restrictPreimage)
      (Function.surjective_id.prodMap (Set.restrictPreimage_surjective _ surjective_q))
  exact hφ.continuous_iff.mpr hF

theorem isOpen_of_preimage {Ω : Set (CP n)} (h : IsOpen (q ⁻¹' Ω)) : IsOpen Ω :=
  isQuotientMap_q.isOpen_preimage.mp h

/-- Un point de référence de `ℂPⁿ`. -/
noncomputable def basePt (n : ℕ) : CP n :=
  Projectivization.mk ℂ (Pi.single 0 1) (by simp)

/-- `mkD w = [w]` si `w ≠ 0`, et un point fixé sinon. -/
noncomputable def mkD (w : Vec n) : CP n :=
  if h : w ≠ 0 then Projectivization.mk ℂ w h else basePt n

theorem mkD_of_ne {w : Vec n} (h : w ≠ 0) : mkD w = Projectivization.mk ℂ w h := dif_pos h

theorem mkD_smul (c : ℂˣ) (w : Vec n) : mkD (c • w) = mkD w := by
  by_cases h : w = 0
  · rw [h, smul_zero]
  · rw [mkD_of_ne h, mkD_of_ne ((smul_ne_zero_iff_ne c).mpr h)]
    exact (Projectivization.mk_eq_mk_iff ℂ _ _ _ h).mpr ⟨c, rfl⟩

theorem q_eq_mkD (v : NZ n) : q v = mkD v.1 := (mkD_of_ne v.2).symm

/-- Une fonction de `p ∈ ℂPⁿ` définie par un représentant. -/
noncomputable def liftInv {Z Y : Type} (G : Z → Vec n → Y) (p : Z × CP n) : Y :=
  G p.1 p.2.rep

theorem liftInv_mk {Z Y : Type} {G : Z → Vec n → Y} (hG : ∀ z (c : ℂˣ) v, G z (c • v) = G z v)
    (z : Z) (v : Vec n) (hv : v ≠ 0) : liftInv G (z, Projectivization.mk ℂ v hv) = G z v := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep ℂ v hv
  rw [liftInv, ← hc, hG]

theorem continuous_liftInv {Ω : Set (CP n)} {Z Y : Type} [TopologicalSpace Z]
    [TopologicalSpace Y] {G : Z → Vec n → Y} (hG : ∀ z (c : ℂˣ) v, G z (c • v) = G z v)
    (hc : Continuous fun p : Z × (q ⁻¹' Ω) ↦ G p.1 p.2.1.1) :
    Continuous fun p : Z × Ω ↦ liftInv G (p.1, (p.2 : CP n)) := by
  refine continuous_of_lift _ ?_
  convert hc using 2 with p
  exact liftInv_mk hG _ _ _

/-- `mkD ∘ f` est continue là où `f` ne s'annule pas. -/
theorem continuous_mkD_comp {Z : Type} [TopologicalSpace Z] {f : Z → Vec n} (hf : Continuous f)
    (hne : ∀ z, f z ≠ 0) : Continuous fun z ↦ mkD (f z) := by
  have : (fun z ↦ mkD (f z)) = fun z ↦ q ⟨f z, hne z⟩ := funext fun z ↦ (q_eq_mkD ⟨f z, hne z⟩).symm
  rw [this]
  exact continuous_q.comp (hf.subtype_mk _)

end Quot

section Coords

variable {m : ℕ}

/-- `(z_0, …, z_m)`. -/
def init' (z : Vec (m + 1)) : Vec m := Fin.init z

/-- `z_{m+1}`. -/
def last' (z : Vec (m + 1)) : ℂ := z (Fin.last (m + 1))

/-- `(w, c)`. -/
def snoc' (w : Vec m) (c : ℂ) : Vec (m + 1) := Fin.snoc (α := fun _ ↦ ℂ) w c

@[simp] theorem init'_snoc' (w : Vec m) (c : ℂ) : init' (snoc' w c) = w := Fin.init_snoc _ _

@[simp] theorem last'_snoc' (w : Vec m) (c : ℂ) : last' (snoc' w c) = c := by
  simp [last', snoc']

@[simp] theorem snoc'_init'_last' (z : Vec (m + 1)) : snoc' (init' z) (last' z) = z :=
  Fin.snoc_init_self _

@[simp] theorem init'_smul (c : ℂ) (z : Vec (m + 1)) : init' (c • z) = c • init' z := rfl

@[simp] theorem last'_smul (c : ℂ) (z : Vec (m + 1)) : last' (c • z) = c * last' z := rfl

theorem snoc'_smul (c : ℂ) (w : Vec m) (a : ℂ) : snoc' (c • w) (c * a) = c • snoc' w a := by
  funext i
  refine Fin.lastCases ?_ (fun j ↦ ?_) i <;> simp [snoc']

theorem snoc'_eq_zero {w : Vec m} {c : ℂ} : snoc' w c = 0 ↔ w = 0 ∧ c = 0 := by
  constructor
  · intro h
    exact ⟨by rw [← init'_snoc' w c, h]; rfl, by rw [← last'_snoc' w c, h]; rfl⟩
  · rintro ⟨rfl, rfl⟩
    funext i
    refine Fin.lastCases ?_ (fun j ↦ ?_) i <;> simp [snoc']

theorem continuous_init' : Continuous (init' (m := m)) :=
  continuous_pi fun _ ↦ continuous_apply _

theorem continuous_last' : Continuous (last' (m := m)) := continuous_apply _

theorem continuous_snoc' {Z : Type} [TopologicalSpace Z] {f : Z → Vec m} {g : Z → ℂ}
    (hf : Continuous f) (hg : Continuous g) : Continuous fun z ↦ snoc' (f z) (g z) :=
  Continuous.finSnoc hf hg

theorem rep_mk (v : Vec m) (hv : v ≠ 0) :
    ∃ c : ℂˣ, (Projectivization.mk ℂ v hv).rep = c • v := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep ℂ v hv
  exact ⟨c, hc.symm⟩

end Coords

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Betti/ComplexPointsProj.lean` -/

section

/-!
# Les points complexes de `ℙⁿ_R` forment `ℂPⁿ` (A5b)

* **Cartes** : pour une immersion ouverte `ι : Spec A ⟶ Y`, un point complexe à valeurs dans
  l'image `W` de `ι` s'écrit `Spec φ ≫ ι` pour un unique `φ : A →+* ℂ` (`chartHom`), et
  `x ↦ φ` est un plongement de `W(ℂ)` dans `ℂ^A` (A5a transporté par `Γ(Y, W) ≅ A`).
* **Coordonnées sur `D₊(Xᵢ)`** : `x ↦ (φ(Xⱼ/Xᵢ))ⱼ` est un plongement de `D₊(Xᵢ)(ℂ)` dans
  `ℂⁿ⁺¹`, car `𝒜_(Xᵢ)` est engendré par les `Xⱼ/Xᵢ` (déshomogénéisation).
* **Recollement** : les points des cartes `i` et `j` définis par `v/vᵢ` et `v/vⱼ` coïncident
  (`ProjPoints.lean`, pour un corps quelconque).
* **L'homéomorphisme** `Φ : ℂPⁿ → ℙⁿ(ℂ)`, `[v] ↦ point de la carte i défini par v/vᵢ`.
-/

open AlgebraicGeometry CategoryTheory Opposite MvPolynomial HomogeneousLocalization

namespace FiniteFields.Betti

theorem val_congr {Y : Scheme.{0}} {U : Y.Opens} {x y : Spec (.of ℂ) ⟶ Y} (hxy : x = y)
    (h : ⊤ ≤ x ⁻¹ᵁ U) (h' : ⊤ ≤ y ⁻¹ᵁ U) : val x U h = val y U h' := by
  subst hxy
  rfl

section OpenImm

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))
  {A : CommRingCat.{0}} (ι : Spec A ⟶ Y) [IsOpenImmersion ι]

theorem preimage_opensRange_top : ⊤ ≤ ι ⁻¹ᵁ ι.opensRange := by
  rw [Scheme.Hom.preimage_opensRange]

/-- `Γ(Y, ι(Spec A)) → A`. -/
noncomputable def secHom : Γ(Y, ι.opensRange) →+* A :=
  (ι.appLE ι.opensRange ⊤ (preimage_opensRange_top ι) ≫ (Scheme.ΓSpecIso A).hom).hom

theorem bijective_secHom : Function.Bijective (secHom ι) := by
  have h1 : IsIso (ι.app ι.opensRange) := ι.isIso_app _ le_rfl
  have e : ι ⁻¹ᵁ ι.opensRange = ⊤ := Scheme.Hom.preimage_opensRange ι
  have h0 : IsIso (homOfLE (preimage_opensRange_top ι)).op :=
    ⟨⟨(homOfLE e.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
  have : IsIso (ι.appLE ι.opensRange ⊤ (preimage_opensRange_top ι)) := by
    rw [Scheme.Hom.appLE]; infer_instance
  exact ConcreteCategory.bijective_of_isIso
    (ι.appLE ι.opensRange ⊤ (preimage_opensRange_top ι) ≫ (Scheme.ΓSpecIso A).hom)

theorem val_SpecMap_comp (φ : A →+* ℂ) (h : ⊤ ≤ (Spec.map (CommRingCat.ofHom φ) ≫ ι) ⁻¹ᵁ ι.opensRange)
    (t : Γ(Y, ι.opensRange)) :
    val (Spec.map (CommRingCat.ofHom φ) ≫ ι) ι.opensRange h t = φ (secHom ι t) := by
  have h2 : (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top =
      (Spec.map (CommRingCat.ofHom φ)).appTop := by
    simp [Scheme.Hom.appLE]
    rfl
  have key : (Spec.map (CommRingCat.ofHom φ) ≫ ι).appLE ι.opensRange ⊤ h =
      ι.appLE ι.opensRange ⊤ (preimage_opensRange_top ι) ≫
        (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top :=
    (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).symm
  rw [val_apply, key, h2]
  change (ι.appLE ι.opensRange ⊤ (preimage_opensRange_top ι) ≫
    (Spec.map (CommRingCat.ofHom φ)).appTop ≫ (Scheme.ΓSpecIso (.of ℂ)).hom) t = _
  rw [Scheme.ΓSpecIso_naturality]
  rfl

/-- Le morphisme `φ : A →+* ℂ` d'un point `x = Spec φ ≫ ι`. -/
noncomputable def chartHom (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ ι.opensRange) : A →+* ℂ :=
  (Spec.preimage (IsOpenImmersion.lift ι x (by
    rintro _ ⟨p, rfl⟩
    exact h (show p ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)))).hom

theorem eq_chartHom (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ ι.opensRange) :
    x = Spec.map (CommRingCat.ofHom (chartHom ι x h)) ≫ ι := by
  rw [chartHom, CommRingCat.ofHom_hom, Spec.map_preimage]
  exact (IsOpenImmersion.lift_fac ι x _).symm

theorem chartHom_unique (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ ι.opensRange) (φ : A →+* ℂ)
    (hφ : x = Spec.map (CommRingCat.ofHom φ) ≫ ι) : chartHom ι x h = φ := by
  have e2 : Spec.map (CommRingCat.ofHom (chartHom ι x h)) ≫ ι = Spec.map (CommRingCat.ofHom φ) ≫ ι :=
    (eq_chartHom ι x h).symm.trans hφ
  rw [cancel_mono, Spec.map_inj] at e2
  exact congrArg CommRingCat.Hom.hom e2

theorem ev_eq_chartHom (x : LW σ π ι.opensRange) (t : Γ(Y, ι.opensRange)) :
    ev σ π ι.opensRange x t = chartHom ι x.1.1 x.2 (secHom ι t) := by
  have hx := eq_chartHom ι x.1.1 x.2
  have h' : ⊤ ≤ (Spec.map (CommRingCat.ofHom (chartHom ι x.1.1 x.2)) ≫ ι) ⁻¹ᵁ ι.opensRange := by
    rw [← hx]; exact x.2
  have := val_SpecMap_comp ι (chartHom ι x.1.1 x.2) h' t
  rw [← this]
  exact congrArg (fun f ↦ f t) (val_congr hx x.2 h')

/-- **Plongement d'une carte** `ι(Spec A)(ℂ) → ℂ^A`. -/
theorem isEmbedding_chartHom :
    Topology.IsEmbedding (fun x : LW σ π ι.opensRange ↦ ⇑(chartHom ι x.1.1 x.2)) := by
  let e := RingEquiv.ofBijective (secHom ι) (bijective_secHom ι)
  have hemb := isEmbedding_ev σ π (isAffineOpen_opensRange ι)
  let Q : (A → ℂ) → (Γ(Y, ι.opensRange) → ℂ) := fun g t ↦ g (secHom ι t)
  have hQ : Q ∘ (fun x : LW σ π ι.opensRange ↦ ⇑(chartHom ι x.1.1 x.2)) = ev σ π ι.opensRange :=
    funext fun x ↦ funext fun t ↦ (ev_eq_chartHom σ π ι x t).symm
  have hcont : Continuous fun x : LW σ π ι.opensRange ↦ ⇑(chartHom ι x.1.1 x.2) := by
    refine continuous_pi fun c ↦ ?_
    have : (fun x : LW σ π ι.opensRange ↦ chartHom ι x.1.1 x.2 c) =
        fun x ↦ ev σ π ι.opensRange x (e.symm c) := by
      funext x
      rw [ev_eq_chartHom]
      exact congrArg _ (e.apply_symm_apply c).symm
    rw [this]
    exact (continuous_apply _).comp hemb.continuous
  refine ⟨Topology.IsInducing.of_comp hcont (continuous_pi fun t ↦ continuous_apply _)
    (hQ ▸ hemb.isInducing), fun x x' hxx ↦ hemb.injective ?_⟩
  rw [← hQ, Function.comp_apply, Function.comp_apply, hxx]

end OpenImm

section Coords

open ProjCharts

attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type} [CommRing R] (σ : R →+* ℂ) (n : ℕ)

/-- `D₊(Xᵢ)(ℂ)`. -/
abbrev Wi (i : Fin (n + 1)) : Type :=
  LW σ (projectiveSpaceOver.toSpec R n) (chartι R n i).opensRange

variable {σ n}

/-- Le morphisme de carte `φₓ : 𝒜_(Xᵢ) → ℂ` d'un point de `D₊(Xᵢ)(ℂ)`. -/
noncomputable def phiI {i : Fin (n + 1)} (x : Wi σ n i) : Chart R n i →+* ℂ :=
  chartHom (chartι R n i) x.1.1 x.2

/-- Les coordonnées `(φₓ(Xⱼ/Xᵢ))ⱼ` d'un point de `D₊(Xᵢ)(ℂ)`. -/
noncomputable def coords {i : Fin (n + 1)} (x : Wi σ n i) : Fin (n + 1) → ℂ :=
  fun j ↦ phiI x (ratio i j)

theorem eq_chartPoint {i : Fin (n + 1)} (x : Wi σ n i) : x.1.1 = chartPoint i (phiI x) :=
  eq_chartHom (chartι R n i) x.1.1 x.2

theorem phiI_comp_base {i : Fin (n + 1)} (x : Wi σ n i) : (phiI x).comp (chartBase R n i) = σ :=
  (chartPoint_over_iff σ i (phiI x)).mp (by rw [← eq_chartPoint]; exact x.1.2)

theorem coords_self {i : Fin (n + 1)} (x : Wi σ n i) : coords x i = 1 := by
  simp [coords, ratio_self]

theorem chartEval_coords {i : Fin (n + 1)} (x : Wi σ n i) :
    chartEval σ i (coords x) (coords_self x) = phiI x :=
  chart_hom_ext (chartEval_comp_base σ i _ _) (phiI_comp_base x)
    fun j ↦ chartEval_ratio σ i _ _ j

theorem exists_poly (i : Fin (n + 1)) (c : Chart R n i) :
    ∃ p : MvPolynomial (Fin (n + 1)) R, c = eval₂ (chartBase R n i) (ratio i) p := by
  obtain ⟨m, x, hx, rfl⟩ := Away.mk_surjective (Grading R n) (X_mem_grading R n i) c
  exact ⟨x, (eval₂_ratio_eq_mk i m x hx).symm⟩

/-- **Plongement de `D₊(Xᵢ)(ℂ)` dans `ℂⁿ⁺¹`** par les coordonnées `Xⱼ/Xᵢ`. -/
theorem isEmbedding_coords (i : Fin (n + 1)) : Topology.IsEmbedding (coords (σ := σ) (i := i)) := by
  have hemb := isEmbedding_chartHom σ (projectiveSpaceOver.toSpec R n) (chartι R n i)
  choose P hP using exists_poly (R := R) (n := n) i
  let G : (Fin (n + 1) → ℂ) → (Chart R n i → ℂ) := fun v c ↦ eval v (map σ (P c))
  have hG : G ∘ coords = fun x : Wi σ n i ↦ ⇑(phiI x) := by
    funext x c
    simp only [Function.comp_apply, G]
    conv_rhs => rw [hP c, eval₂_comp_left, phiI_comp_base]
    rw [MvPolynomial.eval_map]
    rfl
  have hc : Continuous (coords (σ := σ) (i := i)) :=
    continuous_pi fun j ↦ (continuous_apply (ratio i j)).comp hemb.continuous
  refine ⟨Topology.IsInducing.of_comp hc (continuous_pi fun c ↦ continuous_eval _)
    (hG ▸ hemb.isInducing), fun x x' hxx ↦ hemb.injective ?_⟩
  change (fun x : Wi σ n i ↦ ⇑(phiI x)) x = (fun x : Wi σ n i ↦ ⇑(phiI x)) x'
  rw [← hG, Function.comp_apply, Function.comp_apply, hxx]

end Coords

section Phi

open ProjCharts

attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {n : ℕ}

/-- Un indice de coordonnée non nulle. -/
noncomputable def idx {v : Fin (n + 1) → ℂ} (hv : v ≠ 0) : Fin (n + 1) :=
  Classical.choose (Function.ne_iff.mp hv)

theorem idx_spec {v : Fin (n + 1) → ℂ} (hv : v ≠ 0) : v (idx hv) ≠ 0 :=
  Classical.choose_spec (Function.ne_iff.mp hv)

/-- **L'application `Φ : ℂPⁿ → ℙⁿ_R(ℂ)`.** -/
noncomputable def Phi (p : Hatcher.CP n) : ComplexPoints σ (projectiveSpaceOver.toSpec R n) :=
  ⟨ptOf σ (idx p.rep_nonzero) p.rep (idx_spec p.rep_nonzero), ptOf_over σ _ _ _⟩

theorem Phi_mk (v : Fin (n + 1) → ℂ) (hv : v ≠ 0) (i : Fin (n + 1)) (hi : v i ≠ 0) :
    (Phi (R := R) σ (Projectivization.mk ℂ v hv)).1 = ptOf σ i v hi := by
  obtain ⟨c, hc⟩ := Hatcher.Singular.rep_mk v hv
  exact ptOf_indep σ (c : ℂ) c.ne_zero (by rw [hc, Units.smul_def]) _ i (idx_spec _) hi

theorem Phi_injective : Function.Injective (Phi (R := R) (n := n) σ) := by
  intro p p' h
  induction p using Projectivization.ind with
  | h v hv =>
  induction p' using Projectivization.ind with
  | h w hw =>
    have h1 := congrArg Subtype.val h
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hv
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hw
    rw [Phi_mk σ v hv i hi, Phi_mk σ w hw j hj] at h1
    have hwi : w i ≠ 0 := by
      have := (ptOf_mem_iff σ i i v hi).mpr hi
      rw [h1] at this
      exact (ptOf_mem_iff σ j i w hj).mp this
    rw [← ptOf_eq σ i j w hwi hj] at h1
    have h2 := chartPoint_injective i h1
    have h3 : ∀ k, v k / v i = w k / w i := fun k ↦ by
      have := congrArg (fun φ ↦ φ (ratio i k)) h2
      simpa [chartEval_ratio, nv] using this
    have hi' : v i ≠ 0 := by simpa using hi
    refine (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr ⟨v i / w i, funext fun k ↦ ?_⟩
    have := h3 k
    rw [div_eq_div_iff hi' hwi] at this
    rw [Pi.smul_apply, smul_eq_mul, div_mul_eq_mul_div, div_eq_iff hwi]
    linear_combination -this

theorem exists_chart (x : ComplexPoints σ (projectiveSpaceOver.toSpec R n)) :
    ∃ i, ⊤ ≤ x.1 ⁻¹ᵁ (chartι R n i).opensRange := by
  obtain ⟨i, hi⟩ := exists_forall_mem_basicOpen x.1
  exact ⟨i, (top_le_preimage_iff _ _).mpr (by rw [opensRange_chartι]; exact hi _)⟩

theorem coords_ne_zero {i : Fin (n + 1)} (x : Wi σ n i) : coords x ≠ 0 := fun h ↦ by
  have := coords_self x
  rw [h] at this
  exact zero_ne_one this

theorem Phi_coords {i : Fin (n + 1)} (x : Wi σ n i) :
    Phi σ (Projectivization.mk ℂ (coords x) (coords_ne_zero σ x)) = x.1 := by
  refine Subtype.ext ?_
  rw [Phi_mk σ _ _ i (by rw [coords_self]; exact one_ne_zero), ptOf,
    ptOf'_congr σ i (w' := coords x) (funext fun k ↦ by simp [nv, coords_self]) _ (coords_self x),
    ptOf', chartEval_coords, ← eq_chartPoint]

theorem Phi_surjective : Function.Surjective (Phi (R := R) (n := n) σ) := by
  intro x
  obtain ⟨i, hi⟩ := exists_chart σ x
  exact ⟨_, Phi_coords σ (i := i) ⟨x, hi⟩⟩

/-! ### Continuité et homéomorphisme -/

/-- La carte `Cᵢ = {vᵢ ≠ 0}` de `ℂPⁿ`. -/
def Ci (n : ℕ) (i : Fin (n + 1)) : Set (Hatcher.CP n) := {p | p.rep i ≠ 0}

theorem mk_mem_Ci (i : Fin (n + 1)) (v : Fin (n + 1) → ℂ) (hv : v ≠ 0) :
    Projectivization.mk ℂ v hv ∈ Ci n i ↔ v i ≠ 0 := by
  obtain ⟨c, hc⟩ := Hatcher.Singular.rep_mk v hv
  simp only [Ci, Set.mem_ofPred_eq, hc, Units.smul_def, Pi.smul_apply, smul_eq_mul, ne_eq,
    mul_eq_zero, c.ne_zero, false_or]

theorem isOpen_Ci (i : Fin (n + 1)) : IsOpen (Ci n i) := by
  refine Hatcher.Singular.isOpen_of_preimage ?_
  have : Hatcher.Singular.q ⁻¹' Ci n i = {v : Hatcher.Singular.NZ n | v.1 i ≠ 0} := by
    ext v; exact mk_mem_Ci i v.1 v.2
  rw [this]
  exact isOpen_compl_singleton.preimage ((continuous_apply i).comp continuous_subtype_val)

theorem nv_smul (i : Fin (n + 1)) (c : ℂˣ) (v : Fin (n + 1) → ℂ) : nv i (c • v) = nv i v := by
  funext k
  simp [nv, Units.smul_def, mul_div_mul_left _ _ c.ne_zero]

theorem Phi_mem (i : Fin (n + 1)) (p : Ci n i) :
    ⊤ ≤ (Phi (R := R) σ p.1).1 ⁻¹ᵁ (chartι R n i).opensRange := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    have hi := (mk_mem_Ci i v hv).mp hp
    rw [Phi_mk σ v hv i hi]
    exact (ptOf_mem_iff σ i i v hi).mpr hi

theorem coords_Phi (i : Fin (n + 1)) (p : Ci n i) :
    coords (σ := σ) (⟨Phi (R := R) σ p.1, Phi_mem σ i p⟩ : Wi σ n i) =
      Hatcher.Singular.liftInv (fun (_ : Unit) v ↦ nv i v) ((), p.1) := by
  obtain ⟨p, hp⟩ := p
  induction p using Projectivization.ind with
  | h v hv =>
    have hi := (mk_mem_Ci i v hv).mp hp
    rw [Hatcher.Singular.liftInv_mk (fun _ c v ↦ nv_smul i c v)]
    have hphi : phiI (σ := σ) (⟨Phi (R := R) σ (Projectivization.mk ℂ v hv),
        Phi_mem σ i ⟨_, hp⟩⟩ : Wi σ n i) = chartEval σ i (nv i v) (nv_self hi) :=
      chartHom_unique _ _ _ _ (by rw [Phi_mk σ v hv i hi]; rfl)
    funext k
    simp only [coords, hphi, chartEval_ratio]

theorem continuousOn_Phi (i : Fin (n + 1)) : ContinuousOn (Phi (R := R) σ) (Ci n i) := by
  rw [continuousOn_iff_continuous_domRestrict]
  let Φ' : Ci n i → Wi σ n i := fun p ↦ ⟨Phi σ p.1, Phi_mem σ i p⟩
  have hΦ' : Continuous Φ' := by
    refine (isEmbedding_coords (σ := σ) i).continuous_iff.mpr ?_
    have : coords ∘ Φ' = fun p : Ci n i ↦
        Hatcher.Singular.liftInv (fun (_ : Unit) v ↦ nv i v) ((), p.1) :=
      funext fun p ↦ coords_Phi σ i p
    rw [this]
    refine (Hatcher.Singular.continuous_liftInv (Ω := Ci n i) (fun _ c v ↦ nv_smul i c v) ?_).comp
      (continuous_const.prodMk continuous_id)
    refine continuous_pi fun k ↦ ?_
    have hv : Continuous fun p : Unit × (Hatcher.Singular.q ⁻¹' Ci n i) ↦ p.2.1.1 :=
      continuous_subtype_val.comp (continuous_subtype_val.comp continuous_snd)
    exact ((continuous_apply k).comp hv).div ((continuous_apply i).comp hv)
      fun p ↦ (mk_mem_Ci i p.2.1.1 p.2.1.2).mp p.2.2
  exact continuous_subtype_val.comp hΦ'

theorem continuous_Phi : Continuous (Phi (R := R) (n := n) σ) := by
  refine continuous_iff_continuousAt.mpr fun p ↦ ?_
  have hp : p ∈ Ci n (idx p.rep_nonzero) := idx_spec p.rep_nonzero
  exact (continuousOn_Phi σ _).continuousAt ((isOpen_Ci _).mem_nhds hp)

/-- `Φ` comme bijection. -/
noncomputable def PhiEquiv : Hatcher.CP n ≃ ComplexPoints σ (projectiveSpaceOver.toSpec R n) :=
  Equiv.ofBijective (Phi σ) ⟨Phi_injective σ, Phi_surjective σ⟩

theorem continuous_PhiEquiv_symm : Continuous (PhiEquiv (R := R) (n := n) σ).symm := by
  refine continuous_iff_continuousAt.mpr fun x ↦ ?_
  obtain ⟨i, hi⟩ := exists_chart σ x
  have hO : IsOpen {y : ComplexPoints σ (projectiveSpaceOver.toSpec R n) |
      ⊤ ≤ y.1 ⁻¹ᵁ (chartι R n i).opensRange} :=
    isOpen_LW σ _ (isAffineOpen_opensRange (chartι R n i))
  refine ContinuousOn.continuousAt ?_ (hO.mem_nhds hi)
  rw [continuousOn_iff_continuous_domRestrict]
  have h : ∀ y : Wi σ n i, (PhiEquiv σ).symm y.1 =
      Projectivization.mk ℂ (coords y) (coords_ne_zero σ y) := fun y ↦
    (Equiv.symm_apply_eq _).mpr (Phi_coords σ y).symm
  refine Continuous.congr (f := fun y : Wi σ n i ↦
    Hatcher.Singular.q ⟨coords y, coords_ne_zero σ y⟩) ?_ fun y ↦ (h y).symm
  exact Hatcher.Singular.continuous_q.comp
    ((isEmbedding_coords (σ := σ) i).continuous.subtype_mk _)

/-- **L'homéomorphisme `ℂPⁿ ≃ₜ ℙⁿ_R(ℂ)`.** -/
noncomputable def PhiHomeomorph :
    Hatcher.CP n ≃ₜ ComplexPoints σ (projectiveSpaceOver.toSpec R n) where
  toEquiv := PhiEquiv σ
  continuous_toFun := continuous_Phi σ
  continuous_invFun := continuous_PhiEquiv_symm σ

end Phi

theorem complexPoints_projectiveSpace_homeomorph_proof (R : Type) [CommRing R] (σ : R →+* ℂ)
    (n : ℕ) : Nonempty (ComplexPoints σ (projectiveSpaceOver.toSpec R n) ≃ₜ Hatcher.CP n) :=
  ⟨(PhiHomeomorph σ).symm⟩


end FiniteFields.Betti

