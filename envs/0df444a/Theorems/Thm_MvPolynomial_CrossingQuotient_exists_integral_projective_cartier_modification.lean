-- title:
--   An integral projective nodal modification with the global Cartier lifting property
-- statement:
--   Let $R$ be a commutative integral domain, let $a,b\in R$ be nonzero, and put
--   $$N=\operatorname{Spec}R[u,v]/(uv-ab),\qquad I=(u,a).$$
--   For a morphism $f:T\to N$, say that its pulled-back center is Cartier if, at every $t\in T$, the ideal of $\mathcal O_{T,t}$ generated by the images of $u$ and $a$ is generated by a non-zero-divisor. There exist an integral scheme $Y$ and a proper surjective morphism $q:Y\to N$ such that $q$ is an isomorphism over the whole $D(u)$ and has a closed embedding over $N$ into the relative projective line:
--   $$e:Y\hookrightarrow\mathbb P^1_N,\qquad \pi\circ e=q.$$
--   The pulled-back center on $Y$ is Cartier. Moreover, for every germ-injective scheme $T$ and every morphism $f:T\to N$ whose pulled-back center is Cartier, there is a unique lift
--   $$\ell:T\longrightarrow Y,\qquad q\circ\ell=f.$$
--   Here germ-injective means that each point $t$ has an affine open neighborhood $U$ for which the germ map $\Gamma(U,\mathcal O_T)\to\mathcal O_{T,t}$ is injective. This includes every integral scheme and every locally Noetherian scheme. The lifting assertion does not require the source to be reduced.
--
--   No field, perfectness, characteristic or noetherianity assumption is made on $R$. This constructs a single integral projective modification and proves its global Cartier factorization property, supplying uniqueness for comparisons between nodal charts. The asserted universal property is restricted to the stated class of source schemes; compatible global alterations are further assertions.
-- source:
--   Derived auxiliary form of the binary nodal modification in A. J. de Jong, Smoothness, semi-stability and alterations, Publications Mathematiques de l’IHES 83 (1996), Section 3.6, pp. 64–65; https://www.numdam.org/article/PMIHES_1996__83__51_0.pdf . The Cartier lifting formulation is motivated by the universal property in The Stacks Project, Lemma 31.33.5, tag 0806, https://stacks.math.columbia.edu/tag/0806 . This is a proved derived local-modification result, not a verbatim statement of either source: the explicit two-chart model has the stated property for germ-injective source schemes, including integral and locally Noetherian sources. No identification with a registered general blowup construction or complete alteration theorem is asserted.

import Mathlib
import Definitions.Def_MvPolynomial_CrossingResolution
import Definitions.Def_AlgebraicGeometry_ProjSpace
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open MvPolynomial MvPolynomial.CrossingQuotient
attribute [local instance] MvPolynomial.gradedAlgebra
universe u

theorem MvPolynomial.CrossingQuotient.exists_integral_projective_cartier_modification {R : Type u} [CommRing R] [IsDomain R]
    (a b : R) (ha : a ≠ 0) (hb : b ≠ 0) :
    let N : Scheme.{u} := Spec (.of (CrossingQuotient R (a * b)))
    let Cartier : ∀ X : Scheme.{u}, (X ⟶ N) → Prop := fun X f =>
      ∀ x : X, ∃ r : X.presheaf.stalk x,
        Ideal.span ({(Spec.preimage (X.fromSpecStalk x ≫ f)).hom (U (a * b)),
          (Spec.preimage (X.fromSpecStalk x ≫ f)).hom (algebraMap R _ a)} :
          Set (X.presheaf.stalk x)) = Ideal.span ({r} : Set (X.presheaf.stalk x)) ∧
        r ∈ nonZeroDivisors (X.presheaf.stalk x)
    ∃ (Y : Scheme.{u}) (q : Y ⟶ N),
      IsIntegral Y ∧ IsProper q ∧ Surjective q ∧
      IsIso (q ∣_ PrimeSpectrum.basicOpen (U (a * b))) ∧
      (∃ e : Y ⟶ Proj (@MvPolynomial.homogeneousSubmodule (Fin (1 + 1))
          (CrossingQuotient R (a * b))
          (@CommRing.toCommSemiring (CrossingQuotient R (a * b)) inferInstance)),
        IsClosedImmersion e ∧ e ≫ ProjSpace.π (CrossingQuotient R (a * b)) 1 = q) ∧
      Cartier Y q ∧
      (∀ (X : Scheme.{u}) [X.IsGermInjective] (f : X ⟶ N),
        Cartier X f → ∃! l : X ⟶ Y, l ≫ q = f) := by sorry
