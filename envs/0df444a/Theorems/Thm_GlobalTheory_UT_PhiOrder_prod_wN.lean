theorem GlobalTheory.UT.PhiOrder.prod_wN (h : A → U) (x : A) (n : ℕ) (T : ℤ) (hT : 2 * T = n * (n - 1)) :
    Additive.ofMul (∏ j ∈ Finset.range n, wN h x j) = Additive.ofMul (h (x ^ n)) - T • Additive.ofMul (h (x ^ 2)) +
      (2 * T - n) • Additive.ofMul (h x) + (n - 1 - T) • Additive.ofMul (h 1) := by sorry
