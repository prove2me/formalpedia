theorem smul_eq_zero_of_equiv' {R : Type} [CommRing R] {M : Type} [AddCommGroup M] [Module R M]
    {M' : Type} [AddCommMonoid M'] [Module R M']
    (e : M ≃ₗ[R] M') (J : Ideal R) (hJ : J • (⊤ : Submodule R M') = ⊥) (a : R) (ha : a ∈ J) (m : M) : a • m = 0 := by
