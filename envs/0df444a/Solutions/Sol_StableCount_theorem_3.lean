theorem Aval_one (h : ℕ → ℝ) : Aval h 1 = 4 * h 1 := by simp [Aval]
theorem Aval_ne (h : ℕ → ℝ) (c : ℕ) (hc : c ≠ 1) : Aval h c = Hsum h c + h 1 + 2 * h 2 := by
  simp [Aval, hc]

theorem expEA (c : ℕ) (h1 : 1 ≤ c) (h2 : c ≤ 33) : Real.exp (-Aval hR c) ≤ ear c := by
  have hc := checkEA_ok
  simp only [checkEA, Bool.and_eq_true, decide_eq_true_eq] at hc
  unfold ear; rw [le_div_iff₀ Dn_pos]
  rcases Nat.lt_or_ge c 2 with hc1 | hc2
  · obtain rfl : c = 1 := by omega
    rw [Aval_one]
    have e1 := exp_le_ur 1 le_rfl (by norm_num)
    have hcast : ((u 1 ^ 4 : ℕ) : ℝ) ≤ ((ea 1 * Dn ^ 3 : ℕ) : ℝ) := by exact_mod_cast hc.1
    push_cast at hcast
    have e4 : Real.exp (-(4 * hR 1)) = Real.exp (-hR 1) ^ 4 := by
      rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
    rw [e4]
    have : Real.exp (-hR 1) ^ 4 ≤ ur 1 ^ 4 := pow_le_pow_left₀ (Real.exp_pos _).le e1 4
    have hD := Dn_pos
    calc Real.exp (-hR 1) ^ 4 * Dn ≤ ur 1 ^ 4 * Dn := by gcongr
      _ = (u 1 : ℝ) ^ 4 / (Dn : ℝ) ^ 3 := by unfold ur; field_simp
      _ ≤ ea 1 := by rw [div_le_iff₀ (by positivity)]; exact hcast
  · rw [Aval_ne _ _ (by omega)]
    have hm := mem_of_all hc.2 (i := c - 2) (a := (eh c, ea c)) (by
      apply zip_some
      · rw [List.getElem?_drop, show 2 + (c - 2) = c by omega]
        exact getD_some (by rw [ehT_len]; omega)
      · rw [List.getElem?_drop, show 2 + (c - 2) = c by omega]
        exact getD_some (by rw [eaT_len]; omega))
    have he := expOK_sound hm
    have ez : ((pz : ℕ) : ℝ) / ((10 ^ 12 : ℕ) : ℝ) = hR 1 + 2 * hR 2 := by
      rw [hR1, hR2]; unfold pz; push_cast; ring
    rw [ez] at he
    have ih := expEH c (by omega)
    rw [show -(Hsum hR c + hR 1 + 2 * hR 2) = -Hsum hR c + -(hR 1 + 2 * hR 2) by ring,
      Real.exp_add]
    calc Real.exp (-Hsum hR c) * Real.exp (-(hR 1 + 2 * hR 2)) * Dn
        = Real.exp (-(hR 1 + 2 * hR 2)) * (Real.exp (-Hsum hR c) * Dn) := by ring
      _ ≤ Real.exp (-(hR 1 + 2 * hR 2)) * eh c :=
          mul_le_mul_of_nonneg_left ih (Real.exp_pos _).le
      _ ≤ ea c := he

/-! ### `λ` lemmas -/

theorem lam_pair {x y z L1 L2 : ℝ} (h1 : 0 ≤ L1) (h1' : L1 ≤ 1 - Real.exp (-x)) (h2 : 0 ≤ L2)
    (h2' : L2 ≤ 1 - Real.exp (-y)) (h : Real.exp (-z) ≤ L1 * L2) : lam x + lam y ≤ z := by
  have hp : 0 < L1 * L2 := lt_of_lt_of_le (Real.exp_pos _) h
  have hL1 : 0 < L1 := by
    rcases h1.lt_or_eq with h | h
    · exact h
    · rw [← h, zero_mul] at hp; exact absurd hp (lt_irrefl _)
  have hL2 : 0 < L2 := by
    rcases h2.lt_or_eq with h | h
    · exact h
    · rw [← h, mul_zero] at hp; exact absurd hp (lt_irrefl _)
  have ha : 0 < 1 - Real.exp (-x) := lt_of_lt_of_le hL1 h1'
  have hb : 0 < 1 - Real.exp (-y) := lt_of_lt_of_le hL2 h2'
  unfold lam
  rw [← neg_add, ← Real.log_mul ha.ne' hb.ne', neg_le]
  rw [Real.le_log_iff_exp_le (mul_pos ha hb)]
  exact h.trans (mul_le_mul h1' h2' h2 ha.le)

theorem lam_one {x z L : ℝ} (h1 : L ≤ 1 - Real.exp (-x))
    (h : Real.exp (-z) ≤ L) : lam x ≤ z := by
  have hL : 0 < L := lt_of_lt_of_le (Real.exp_pos _) h
  have ha : 0 < 1 - Real.exp (-x) := lt_of_lt_of_le hL h1
  unfold lam
  rw [neg_le, Real.le_log_iff_exp_le ha]
  exact h.trans h1

theorem exp_two (x : ℝ) : Real.exp (-(2 * x)) = Real.exp (-x) ^ 2 := by
  rw [← Real.exp_nat_mul]; congr 1; push_cast; ring

/-! ### The constraints -/

theorem h1R : Real.log 2 ≤ 2 * hR 1 := by
  rw [Real.log_le_iff_le_exp (by norm_num)]
  have e1 := exp_le_ur 1 le_rfl (by norm_num)
  have hc : ((2 * (u 1 * u 1) : ℕ) : ℝ) ≤ ((Dn * Dn : ℕ) : ℝ) := by exact_mod_cast misc1
  push_cast at hc
  have hsq : Real.exp (-hR 1) ^ 2 ≤ 1 / 2 := by
    calc Real.exp (-hR 1) ^ 2 ≤ ur 1 ^ 2 := pow_le_pow_left₀ (Real.exp_pos _).le e1 2
      _ ≤ 1 / 2 := by
        have hD := Dn_pos
        unfold ur; rw [div_pow, div_le_div_iff₀ (by positivity) (by norm_num)]; nlinarith
  have : Real.exp (2 * hR 1) * Real.exp (-hR 1) ^ 2 = 1 := by
    rw [← exp_two, ← Real.exp_add]; simp
  nlinarith [Real.exp_pos (2 * hR 1), Real.exp_pos (-hR 1)]

theorem h4cR : hR 2 ≤ 4 * hR 1 - lam (hR 1) := by
  have hm := expOK_sound misc2
  have hu := expU 1 le_rfl (by norm_num)
  change _ ≤ ((Dn - u 1 : ℕ) : ℝ) at hm
  rw [Nat.cast_sub hu.2] at hm
  have ex : (((4 * 346573640280 - 156726247027 : ℕ)) : ℝ) / ((10 ^ 12 : ℕ) : ℝ) =
      4 * hR 1 - hR 2 := by rw [hR1, hR2]; norm_num
  rw [ex] at hm
  have hD := Dn_pos
  suffices lam (hR 1) ≤ 4 * hR 1 - hR 2 by linarith
  refine lam_one (L := 1 - ur 1)
    (by linarith [exp_le_ur 1 le_rfl (by norm_num)]) ?_
  unfold ur
  rw [one_sub_div hD.ne', le_div_iff₀ hD]
  exact hm

theorem h2R (d : ℕ) (h2 : 2 ≤ d) (h33 : d ≤ 33) : lam (2 * hR d) ≤ Hsum hR d + hR 2 := by
  have hc := checkH2_ok
  have hm := mem_of_all hc (i := d - 2) (a := (u d, eh d)) (by
    apply zip_some
    · rw [List.getElem?_take, if_pos (by omega), List.getElem?_drop,
        show 2 + (d - 2) = d by omega]
      exact getD_some (by rw [uT_len]; omega)
    · rw [List.getElem?_drop, show 2 + (d - 2) = d by omega]
      exact getD_some (by rw [ehT_len]; omega))
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hm
  obtain ⟨hA, hB⟩ := hm
  have hD := Dn_pos
  have cA : ((u d : ℝ)) * u d ≤ (Dn : ℝ) * Dn := by exact_mod_cast hA
  have cB : ((eh d * uT.getD 2 0 : ℕ) : ℝ) ≤ ((Dn * Dn - u d * u d : ℕ) : ℝ) := by
    exact_mod_cast hB
  rw [Nat.cast_sub (by exact hA)] at cB
  push_cast at cB
  have eu2 : (uT.getD 2 0 : ℝ) = u 2 := rfl
  rw [eu2] at cB
  refine lam_one (L := 1 - ur d ^ 2) ?_ ?_
  · rw [exp_two]
    have := pow_le_pow_left₀ (Real.exp_pos _).le (exp_le_ur d (by omega) (by omega)) 2
    linarith
  · rw [neg_add, Real.exp_add]
    calc Real.exp (-Hsum hR d) * Real.exp (-hR 2) ≤ ehr d * ur 2 :=
          mul_le_mul (exp_le_ehr d (by omega)) (exp_le_ur 2 (by norm_num) (by norm_num))
            (Real.exp_pos _).le (by unfold ehr; positivity)
      _ ≤ 1 - ur d ^ 2 := by
          have k : 1 - ur d ^ 2 = ((Dn : ℝ) * Dn - u d * u d) / ((Dn : ℝ) * Dn) := by
            unfold ur; field_simp
          have k2 : ehr d * ur 2 = ((eh d : ℝ) * u 2) / ((Dn : ℝ) * Dn) := by
            unfold ehr ur; field_simp
          rw [k, k2]
          exact div_le_div_of_nonneg_right cB (by positivity)

theorem pair_real (ua1 ua uc e f : ℕ) (h : pairOK ua1 ua uc e f = true) :
    0 ≤ 1 - ((ua : ℝ) / Dn) ^ 2 ∧
    0 ≤ 1 - ((ua1 : ℝ) / Dn) * ((ua : ℝ) / Dn) ^ 2 * ((uc : ℝ) / Dn) ∧
    ((e : ℝ) / Dn) * ((f : ℝ) / Dn) ≤ (1 - ((ua : ℝ) / Dn) ^ 2) *
      (1 - ((ua1 : ℝ) / Dn) * ((ua : ℝ) / Dn) ^ 2 * ((uc : ℝ) / Dn)) := by
  simp only [pairOK, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  have c3 : ((e * f * Dn ^ 4 : ℕ) : ℝ) ≤
      (((Dn * Dn - ua * ua) * (Dn ^ 4 - ua1 * (ua * ua) * uc) : ℕ) : ℝ) := by exact_mod_cast h3
  rw [Nat.cast_mul (Dn * Dn - ua * ua), Nat.cast_sub h1, Nat.cast_sub h2] at c3
  push_cast at c3
  have c1 : (ua : ℝ) * ua ≤ (Dn : ℝ) * Dn := by exact_mod_cast h1
  have c2 : (ua1 : ℝ) * (ua * ua) * uc ≤ (Dn : ℝ) ^ 4 := by exact_mod_cast h2
  have hD := Dn_pos
  have k1 : 1 - ((ua : ℝ) / Dn) ^ 2 = ((Dn : ℝ) * Dn - ua * ua) / (Dn : ℝ) ^ 2 := by
    field_simp
  have k2 : 1 - ((ua1 : ℝ) / Dn) * ((ua : ℝ) / Dn) ^ 2 * ((uc : ℝ) / Dn) =
      ((Dn : ℝ) ^ 4 - ua1 * (ua * ua) * uc) / (Dn : ℝ) ^ 4 := by
    field_simp
  refine ⟨?_, ?_, ?_⟩
  · rw [k1]; apply div_nonneg <;> nlinarith
  · rw [k2]; apply div_nonneg <;> nlinarith
  · rw [k1, k2, div_mul_div_comm, div_mul_div_comm, div_le_div_iff₀ (by positivity)
      (by positivity)]
    have : (e : ℝ) * f * (Dn : ℝ) ^ 4 * ((Dn : ℝ) ^ 2 * (Dn : ℝ) ^ 4) ≤
        ((Dn : ℝ) * Dn - ua * ua) * ((Dn : ℝ) ^ 4 - ua1 * (ua * ua) * uc) *
          ((Dn : ℝ) ^ 2 * (Dn : ℝ) ^ 4) :=
      mul_le_mul_of_nonneg_right c3 (by positivity)
    calc (e : ℝ) * f * ((Dn : ℝ) ^ 2 * (Dn : ℝ) ^ 4)
        = (e : ℝ) * f * (Dn : ℝ) ^ 4 * ((Dn : ℝ) ^ 2 * (Dn : ℝ) ^ 4) / (Dn : ℝ) ^ 4 := by
          field_simp
      _ ≤ ((Dn : ℝ) * Dn - ua * ua) * ((Dn : ℝ) ^ 4 - ua1 * (ua * ua) * uc) *
          ((Dn : ℝ) ^ 2 * (Dn : ℝ) ^ 4) / (Dn : ℝ) ^ 4 := by gcongr
      _ = ((Dn : ℝ) * Dn - ua * ua) * ((Dn : ℝ) ^ 4 - ua1 * (ua * ua) * uc) *
          ((Dn : ℝ) * (Dn : ℝ)) := by field_simp

theorem h3R (a c : ℕ) (ha : 3 ≤ a) (ha' : a < 512) (hc : 1 ≤ c) (hc' : c ≤ 33) :
    lam (2 * hR a) + lam (hR (a - 1) + 2 * hR a + hR c) ≤ Hsum hR a + Aval hR c := by
  have hrow := mem_of_all checkH3_ok (i := a - 3) (a := (u (a - 1), u a, eh a)) (by
    apply zip_some
    · rw [List.getElem?_take, if_pos (by omega), List.getElem?_drop,
        show 2 + (a - 3) = a - 1 by omega]
      exact getD_some (by rw [uT_len]; omega)
    · apply zip_some
      · rw [List.getElem?_drop, show 3 + (a - 3) = a by omega]
        exact getD_some (by rw [uT_len]; omega)
      · rw [List.getElem?_drop, show 3 + (a - 3) = a by omega]
        exact getD_some (by rw [ehT_len]; omega))
  have hm := mem_of_all hrow (i := c - 1) (a := (u c, ea c)) (by
    apply zip_some
    · rw [List.getElem?_drop, show 1 + (c - 1) = c by omega]
      exact getD_some (by rw [uT_len]; omega)
    · rw [List.getElem?_drop, show 1 + (c - 1) = c by omega]
      exact getD_some (by rw [eaT_len]; omega))
  have hm' : pairOK (u (a - 1)) (u a) (u c) (eh a) (ea c) = true := hm
  obtain ⟨n1, n2, key⟩ := pair_real _ _ _ _ _ hm'
  have ea1 := exp_le_ur (a - 1) (by omega) (by omega)
  have ea0 := exp_le_ur a (by omega) (by omega)
  have ec := exp_le_ur c (by omega) (by omega)
  have e0 := (Real.exp_pos (-hR a)).le
  refine lam_pair n1 ?_ n2 ?_ ?_
  · rw [exp_two]
    have := pow_le_pow_left₀ e0 ea0 2
    unfold ur at this; linarith
  · rw [show -(hR (a - 1) + 2 * hR a + hR c) = -hR (a - 1) + -(2 * hR a) + -hR c by ring,
      Real.exp_add, Real.exp_add, exp_two]
    have p2 := pow_le_pow_left₀ e0 ea0 2
    have : Real.exp (-hR (a - 1)) * Real.exp (-hR a) ^ 2 * Real.exp (-hR c) ≤
        ur (a - 1) * ur a ^ 2 * ur c := by
      gcongr
      all_goals first
        | exact ur_nonneg _
        | exact mul_nonneg (ur_nonneg _) (pow_nonneg (ur_nonneg _) 2)
    unfold ur at this; linarith
  · rw [neg_add, Real.exp_add]
    calc Real.exp (-Hsum hR a) * Real.exp (-Aval hR c) ≤ ehr a * ear c :=
          mul_le_mul (exp_le_ehr a (by omega)) (expEA c hc hc') (Real.exp_pos _).le
            (by unfold ehr; positivity)
      _ ≤ _ := key

theorem m_real (U V e f : ℕ) (h1 : U * U ≤ Dn * Dn) (h2 : V ≤ Dn)
    (h3 : e * f * Dn ≤ (Dn * Dn - U * U) * (Dn - V)) :
    0 ≤ 1 - ((U : ℝ) / Dn) ^ 2 ∧ 0 ≤ 1 - (V : ℝ) / Dn ∧
    ((e : ℝ) / Dn) * ((f : ℝ) / Dn) ≤ (1 - ((U : ℝ) / Dn) ^ 2) * (1 - (V : ℝ) / Dn) := by
  have c3 : ((e * f * Dn : ℕ) : ℝ) ≤ (((Dn * Dn - U * U) * (Dn - V) : ℕ) : ℝ) := by
    exact_mod_cast h3
  rw [Nat.cast_mul (Dn * Dn - U * U), Nat.cast_sub h1, Nat.cast_sub h2] at c3
  push_cast at c3
  have c1 : (U : ℝ) * U ≤ (Dn : ℝ) * Dn := by exact_mod_cast h1
  have c2 : (V : ℝ) ≤ Dn := by exact_mod_cast h2
  have hD := Dn_pos
  refine ⟨?_, ?_, ?_⟩
  · rw [div_pow, sub_nonneg, div_le_one (by positivity)]; nlinarith
  · rw [sub_nonneg, div_le_one hD]; exact c2
  · rw [div_mul_div_comm, div_le_iff₀ (by positivity)]
    have k : (1 - ((U : ℝ) / Dn) ^ 2) * (1 - (V : ℝ) / Dn) * ((Dn : ℝ) * Dn) =
        ((Dn : ℝ) * Dn - U * U) * (Dn - V) / Dn := by
      field_simp
    rw [k, le_div_iff₀ hD]
    exact c3

theorem hMR (c : ℕ) (hc : 1 ≤ c) (hc' : c ≤ 33) :
    lam (2 * hR 512) + lam (hR c) ≤ Hsum hR 512 + Aval hR c := by
  have hm := mem_of_all checkM_ok (i := c - 1) (a := (u c, ea c)) (by
    apply zip_some
    · rw [List.getElem?_drop, show 1 + (c - 1) = c by omega]
      exact getD_some (by rw [uT_len]; omega)
    · rw [List.getElem?_drop, show 1 + (c - 1) = c by omega]
      exact getD_some (by rw [eaT_len]; omega))
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hm
  obtain ⟨⟨h1, h2⟩, h3⟩ := hm
  obtain ⟨n1, n2, key⟩ := m_real _ _ _ _ h1 h2 h3
  have e512 := exp_le_ur 512 (by norm_num) le_rfl
  have e0 := (Real.exp_pos (-hR 512)).le
  refine lam_pair n1 ?_ n2 ?_ ?_
  · rw [exp_two]
    have := pow_le_pow_left₀ e0 e512 2
    unfold ur u at this
    linarith
  · have := exp_le_ur c hc (by omega)
    unfold ur at this
    linarith
  · rw [neg_add, Real.exp_add]
    calc Real.exp (-Hsum hR 512) * Real.exp (-Aval hR c) ≤ ehr 512 * ear c :=
          mul_le_mul (exp_le_ehr 512 le_rfl) (expEA c hc hc') (Real.exp_pos _).le
            (div_nonneg (Nat.cast_nonneg _) Dn_pos.le)
      _ ≤ _ := key

theorem monoR (d : ℕ) (h1 : 1 ≤ d) (h2 : d < 32) : hR (d + 1) ≤ hR d := by
  have hm := mem_of_all checkMono_ok (i := d - 1) (a := (tbl.getD (d - 1) 0, tbl.getD d 0)) (by
    apply zip_some
    · exact getD_some (by rw [tbl_len]; omega)
    · rw [List.getElem?_drop, show 1 + (d - 1) = d by omega]
      exact getD_some (by rw [tbl_len]; omega))
  simp only [decide_eq_true_eq] at hm
  rw [hR_small _ (by omega), hR_small _ (by omega)]
  have e1 : hp (d + 1) = tbl.getD d 0 := by simp [hp, show d + 1 ≤ 32 by omega]
  have e2 : hp d = tbl.getD (d - 1) 0 := by simp [hp, show d ≤ 32 by omega]
  rw [e1, e2]
  gcongr

theorem feasible : IsFeasibleP 32 512 hR Cr := by
  unfold IsFeasibleP
  simp only [extend_eq]
  refine ⟨monoR, ?_, ?_, h1R, ⟨?_, ?_, h4cR⟩, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [hR32, Cr]; norm_num
  · rw [Cr]; norm_num
  · rw [hR1, hR2]; norm_num
  · rw [hR2, hR3]; norm_num
  · rw [hR3]; norm_num
  · rw [hR2, hR3]; norm_num
  · intro d hd2 hd33; exact h2R d hd2 (by norm_num at hd33; omega)
  · intro a c ha ha' hc hc'; exact h3R a c ha ha' hc (by norm_num at hc'; omega)
  · intro c hc hc'; exact hMR c hc (by norm_num at hc'; omega)

theorem sum_tbl : ∑ d ∈ Finset.Icc 1 32, hR d + Cr / ((32 : ℕ) : ℝ) =
    33058268595733 / 32000000000000 := by
  have e : ∀ d ∈ Finset.Icc 1 32, hR d = (hp d : ℝ) / 10 ^ 12 := fun d hd =>
    hR_small d (Finset.mem_Icc.mp hd).2
  rw [Finset.sum_congr rfl e, ← Finset.sum_div, ← Nat.cast_sum,
    show ∑ d ∈ Finset.Icc 1 32, hp d = 970150622894 by decide +kernel, Cr]
  norm_num

theorem final_bound : (33058268595733 / 32000000000000 : ℝ) < Real.log 2.81 := by
  rw [Real.lt_log_iff_exp_lt (by norm_num)]
  set x : ℝ := 33058268595733 / 32000000000000 - 1 with hx
  have hx1 : |x| ≤ 1 := by rw [hx, abs_le]; constructor <;> norm_num
  have hb := Real.exp_bound hx1 (n := 5) (by norm_num)
  have hb' := (abs_le.mp hb).2
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial] at hb'
  have hxv : |x| = x := abs_of_nonneg (by rw [hx]; norm_num)
  rw [hxv] at hb'
  have hex : Real.exp x ≤ 1.0336240 := by rw [hx] at hb' ⊢; norm_num at hb'; linarith
  have e : (33058268595733 / 32000000000000 : ℝ) = 1 + x := by rw [hx]; ring
  rw [e, Real.exp_add]
  have := Real.exp_one_lt_d9
  calc Real.exp 1 * Real.exp x ≤ 2.7182818286 * 1.0336240 := by
        gcongr
    _ < 2.81 := by norm_num

end Dev.T3

open Dev.T3 in
theorem chk_theorem_3 :
    ∃ h : ℕ → ℝ, IsAdmissible h ∧ Summable (fun d => h (d + 1)) ∧
      ∑' d, h (d + 1) < Real.log 2.81 := by
  obtain ⟨hA, hS, hsum, -⟩ := proposition_9_2 32 512 (by norm_num) (by norm_num) hR Cr feasible
  refine ⟨extend hR Cr 32, hA, hS, ?_⟩
  rw [hsum, extend_eq, sum_tbl]
  exact final_bound

end StableCount
end

theorem solution : type_of% @StableCount.chk_theorem_3 := @StableCount.chk_theorem_3
