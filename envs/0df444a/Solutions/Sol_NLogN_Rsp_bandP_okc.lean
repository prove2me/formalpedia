    rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
  have hkD : k < Dl.length := by omega
  have hkW : k < Wi.length := by omega
  have hka : k < acc.length := by omega
  obtain ⟨a, ha⟩ : ∃ a, NLogN.Rsp.pre Dl k = a := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, Dl[k] = d := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w, Wi[k] = w := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c, acc[k] = c := ⟨_, rfl⟩
  have hpre : NLogN.Rsp.pre Dl (k + 1) = a + d := by rw [pre_succ Dl k hkD, ha, hd]
  have hle : NLogN.Rsp.pre Dl (k + 1) ≤ NLogN.Rsp.pre Dl n := pre_mono Dl (by omega)
  obtain ⟨x0, hx0⟩ : ∃ x0, Xi[a + d]'(by omega) = x0 := ⟨_, rfl⟩
  have hXd : Xi.drop a = (Xi.drop a).take d ++ Xi.drop (a + d) := by
    rw [← List.drop_drop, List.take_append_drop]
  have hlen : ((Xi.drop a).take d).length = d := by simp; omega
  have hDk : (Dl.map (Nat.cast : ℕ → ℤ)).drop k = (d : ℤ) :: (Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1) := by
    rw [List.drop_eq_getElem_cons (by simpa using hkD)]; simp [hd]
  have hWk : Wi.drop k = w :: Wi.drop (k + 1) := by rw [List.drop_eq_getElem_cons hkW, hw]
  have hAk : acc.drop k = c :: acc.drop (k + 1) := by rw [List.drop_eq_getElem_cons hka, hc]
  have hXk : Xi.drop (a + d) = x0 :: Xi.drop (a + d + 1) := by
    rw [List.drop_eq_getElem_cons (by omega), hx0]
  have tX : t.G NLogN.Rsp.BX = ints ((Xi.drop a).take d) ++ (ints (Xi.drop (a + d)) ++ RX) := by
    rw [tG NLogN.Rsp.BX (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [ha]; conv_lhs => rw [hXd]
    rw [ints_append, List.append_assoc]
  have tD : t.G BD = .int (d : ℤ) :: (ints ((Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1)) ++ RD) := by
    rw [tG BD (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hDk]; rfl
  have hm := mvK_spec (X := NLogN.Rsp.BX) (Y := BY) (C := BCM) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BD) (RS.clean_of_lt (by decide)) t
    ((Xi.drop a).take d) _ tX (IState.isInt_of tD) (by rw [hlen]; simp [Ex.eval, IState.top, tD])
  refine ⟨hm.1, ?_⟩
  have tW : t.G NLogN.Rsp.BW = .int w :: (ints (Wi.drop (k + 1)) ++ RW) := by
    rw [tG NLogN.Rsp.BW (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hWk]; rfl
  have tA : t.G BA = .int c :: (ints (acc.drop (k + 1)) ++ RA) := by
    rw [tG BA (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hAk]; rfl
  have tC : t.G BCC = .int (a : ℤ) :: LCC := by
    rw [tG BCC (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true}) [ha]
  have tR : t.G BR = .int R :: LR := by
    rw [tG BR (by decide), kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide), huR]
  have hout : (bandRound R Xi Dl Wi acc).take (k + 1) = (bandRound R Xi Dl Wi acc).take k ++
      [c + (w * x0).tdiv R] := by
    rw [← List.take_concat_get' _ k (by rw [bandRound_length]; omega)]
    congr 2
    simp only [bandRound, List.getElem_map, List.getElem_range]
    rw [List.getD_eq_getElem _ _ hka, List.getD_eq_getElem _ _ hkW, hpre,
      List.getD_eq_getElem _ _ (by omega), hc, hw, hx0]
  have hXt : (Xi.take (a + d)).reverse =
      ((Xi.drop a).take d).reverse ++ (Xi.take a).reverse := by
    rw [List.take_add, List.reverse_append]
  have hDt : (Dl.map (Nat.cast : ℕ → ℤ)).take (k + 1) =
      (Dl.map (Nat.cast : ℕ → ℤ)).take k ++ [(d : ℤ)] := by
    rw [← List.take_concat_get' _ k (by simpa using hkD)]; simp [hd]
  have hWt : Wi.take (k + 1) = Wi.take k ++ [w] := by rw [← List.take_concat_get' _ k hkW, hw]
  have hAt : acc.drop (k + 1) = acc.drop (k + 1) := rfl
  simp only [kBody, RM.run, hm.2]
  apply RS.run_ext _ (by rw [← ht]; simp [withCtr, kSt]) (by rw [← ht]; simp [withCtr, kSt])
  intro x
  simp only [seqL, RS.run_seq, RS.run_push_G, RS.run_pop_G, RS.run_asg_G, RM.run_mul_G,
    IState.upd_G, Ex.eval]
  have tY : t.G BY = ints (Xi.take a).reverse ++ u.G BY := by
    rw [tG BY (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true}) [ha]
  have tWT : t.G BWT = ints (Wi.take k).reverse ++ u.G BWT := by
    rw [tG BWT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  have tDT : t.G BDT = ints ((Dl.map (Nat.cast : ℕ → ℤ)).take k).reverse ++ u.G BDT := by
    rw [tG BDT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  have tAT : t.G BAT = ints ((bandRound R Xi Dl Wi acc).take k).reverse ++ u.G BAT := by
    rw [tG BAT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  by_cases x1 : x = NLogN.Rsp.BX
  · subst x1; simp (config := {decide := true}) [withCtr, kSt, hpre, hXk, ← ha]
  by_cases x2 : x = BY
  · subst x2; simp (config := {decide := true}) [withCtr, kSt, hpre, tY, hXt, ints_append, ints_reverse]
  by_cases x3 : x = BCC
  · subst x3; simp (config := {decide := true}) [withCtr, kSt, hpre, tC, IState.top, tD]
  by_cases x4 : x = NLogN.Rsp.BW
  · subst x4; simp (config := {decide := true}) [withCtr, kSt, tW]
  by_cases x5 : x = BWT
  · subst x5; simp (config := {decide := true}) [withCtr, kSt, tWT, IState.top, tW, hWt, ints_append, ints_reverse]
  by_cases x6 : x = BD
  · subst x6; simp (config := {decide := true}) [withCtr, kSt, tD]
  by_cases x7 : x = BDT
  · subst x7; simp (config := {decide := true}) [withCtr, kSt, tDT, IState.top, tD, hDt, ints_append, ints_reverse]
  by_cases x8 : x = BA
  · subst x8; simp (config := {decide := true}) [withCtr, kSt, tA]
  by_cases x9 : x = BAT
  · subst x9; simp (config := {decide := true}) [withCtr, kSt, tAT, IState.top, tA, tR, tW, hout,
      ints_append, ints_reverse, tX, hXk]
  by_cases x10 : x = BP
  · subst x10; simp (config := {decide := true}) [withCtr, kSt, tG]
  by_cases x11 : x = BCK
  · subst x11; simp (config := {decide := true}) [withCtr, kSt]; rw [← ht]; simp [withCtr]
  simp only [if_neg x1, if_neg x2, if_neg x3, if_neg x4, if_neg x5, if_neg x6, if_neg x7, if_neg x8,
    if_neg x9, if_neg x10, if_neg x11, withCtr_G_ne' _ _ _ _ _ _ x11]
  rw [tG x x11, kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ x1 x2 x3 x4 x5 x6 x7 x8 x9,
    kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ x1 x2 x3 x4 x5 x6 x7 x8 x9]

theorem zsz_le_of_mem {l : List ℤ} {B : ℕ} (h : ∀ y ∈ l, zsz y ≤ B) {i : ℕ} (hi : i < l.length) :
    zsz l[i] ≤ B := h _ (List.getElem_mem hi)

set_option maxHeartbeats 4000000 in
theorem k_okc (M : MulSpec) (m Φ B sh : ℕ) (hM : MulBnd M m Φ) (u : IState HS) (R : ℤ)
    (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA LCC LR : List Item) (n : ℕ)
    (hWl : Wi.length = n) (hDl : Dl.length = n) (hal : acc.length = n)
    (hX : NLogN.Rsp.pre Dl n < Xi.length) (huR : u.G BR = .int R :: LR) (hR : R = 2 ^ sh)
    (hXB : ∀ y ∈ Xi, zsz y ≤ m) (hWB : ∀ y ∈ Wi, zsz y ≤ m)
    (hAB : ∀ y ∈ acc, zsz y ≤ B) (hOB : ∀ y ∈ bandRound R Xi Dl Wi acc, zsz y ≤ B)
    (hmB : 2 * m ≤ B) (hLB : zsz (Xi.length : ℤ) ≤ B) (hsh : sh + 1 ≤ B)
    (S0 : IState HS) (N0 k : ℕ) (hk : k < n) :
    kBody.ok M (withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k)) ∧
    kBody.cost M (withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k)) ≤
      Φ + 1000 * (m + 1) + 60000 * (B + 2) + Dl[k]! * (14000 * (B + 2)) := by
  generalize ht : withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k) = t
  have tG : ∀ x, x ≠ BCK → t.G x = (kSt u R Xi Dl Wi acc RX RW RD RA LCC k).G x := fun x hx => by
    rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
  have hkD : k < Dl.length := by omega
  have hkW : k < Wi.length := by omega
  have hka : k < acc.length := by omega
  have hdk : Dl[k]! = Dl[k] := by simp [hkD]
  rw [hdk]
  have hwB := zsz_le_of_mem hWB hkW
  have hcB := zsz_le_of_mem hAB hka
  have hoB := zsz_le_of_mem hOB (i := k) (by rw [bandRound_length]; omega)
  obtain ⟨a, ha⟩ : ∃ a, NLogN.Rsp.pre Dl k = a := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, Dl[k] = d := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w, Wi[k] = w := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c, acc[k] = c := ⟨_, rfl⟩
  rw [hw] at hwB; rw [hc] at hcB
  have hpre : NLogN.Rsp.pre Dl (k + 1) = a + d := by rw [pre_succ Dl k hkD, ha, hd]
  have hle : NLogN.Rsp.pre Dl (k + 1) ≤ NLogN.Rsp.pre Dl n := pre_mono Dl (by omega)
  obtain ⟨x0, hx0⟩ : ∃ x0, Xi[a + d]'(by omega) = x0 := ⟨_, rfl⟩
  have hxB : zsz x0 ≤ m := by rw [← hx0]; exact zsz_le_of_mem hXB _
  have hoB' : zsz (c + (w * x0).tdiv R) ≤ B := by
    have : (bandRound R Xi Dl Wi acc)[k]'(by rw [bandRound_length]; omega) =
        c + (w * x0).tdiv R := by
      simp only [bandRound, List.getElem_map, List.getElem_range]
      rw [List.getD_eq_getElem _ _ hka, List.getD_eq_getElem _ _ hkW, hpre,
        List.getD_eq_getElem _ _ (by omega), hc, hw, hx0]
    rw [← this]; exact hoB
  have hXd : Xi.drop a = (Xi.drop a).take d ++ Xi.drop (a + d) := by
    rw [← List.drop_drop, List.take_append_drop]
  have hlen : ((Xi.drop a).take d).length = d := by simp; omega
  have hDk : (Dl.map (Nat.cast : ℕ → ℤ)).drop k = (d : ℤ) :: (Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1) := by
    rw [List.drop_eq_getElem_cons (by simpa using hkD)]; simp [hd]
  have hWk : Wi.drop k = w :: Wi.drop (k + 1) := by rw [List.drop_eq_getElem_cons hkW, hw]
  have hAk : acc.drop k = c :: acc.drop (k + 1) := by rw [List.drop_eq_getElem_cons hka, hc]
  have hXk : Xi.drop (a + d) = x0 :: Xi.drop (a + d + 1) := by
    rw [List.drop_eq_getElem_cons (by omega), hx0]
  have tX : t.G NLogN.Rsp.BX = ints ((Xi.drop a).take d) ++ (ints (Xi.drop (a + d)) ++ RX) := by
    rw [tG NLogN.Rsp.BX (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [ha]; conv_lhs => rw [hXd]
    rw [ints_append, List.append_assoc]
  have tD : t.G BD = .int (d : ℤ) :: (ints ((Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1)) ++ RD) := by
    rw [tG BD (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hDk]; rfl
  have hm := mvK_spec (X := NLogN.Rsp.BX) (Y := BY) (C := BCM) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BD) (RS.clean_of_lt (by decide)) t
    ((Xi.drop a).take d) _ tX (IState.isInt_of tD) (by rw [hlen]; simp [Ex.eval, IState.top, tD])
  have tW : t.G NLogN.Rsp.BW = .int w :: (ints (Wi.drop (k + 1)) ++ RW) := by
    rw [tG NLogN.Rsp.BW (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hWk]; rfl
  have tA : t.G BA = .int c :: (ints (acc.drop (k + 1)) ++ RA) := by
    rw [tG BA (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hAk]; rfl
  have tC : t.G BCC = .int (a : ℤ) :: LCC := by
    rw [tG BCC (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true}) [ha]
  have tR : t.G BR = .int R :: LR := by
    rw [tG BR (by decide), kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide), huR]
  -- the intermediate states
  set t1 := (t.upd NLogN.Rsp.BX (ints (Xi.drop (a + d)) ++ RX)).upd BY
    ((ints ((Xi.drop a).take d)).reverse ++ t.G BY) with ht1
  have u1 : t1.G BCC = .int (a : ℤ) :: LCC := by simp (config := {decide := true}) [ht1, tC]
  have u1D : t1.G BD = .int (d : ℤ) :: (ints ((Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1)) ++ RD) := by
    simp (config := {decide := true}) [ht1, tD]
  set t2 := (asg BCC (.add (.reg BCC) (.reg BD))).run t1 with ht2
  have u2X : t2.G NLogN.Rsp.BX = .int x0 :: (ints (Xi.drop (a + d + 1)) ++ RX) := by
    simp (config := {decide := true}) [ht2, ht1, hXk]
  have u2W : t2.G NLogN.Rsp.BW = .int w :: (ints (Wi.drop (k + 1)) ++ RW) := by
    simp (config := {decide := true}) [ht2, ht1, tW]
  set t3 := (RM.mul BP NLogN.Rsp.BX NLogN.Rsp.BW).run t2 with ht3
  have u3 : t3.G BP = .int (w * x0) :: t.G BP := by
    simp (config := {decide := true}) [ht3, ht2, ht1, IState.top, tW, hXk]
  have u3A : t3.G BA = .int c :: (ints (acc.drop (k + 1)) ++ RA) := by
    simp (config := {decide := true}) [ht3, ht2, ht1, tA]
  have u3R : t3.G BR = .int R :: LR := by
    simp (config := {decide := true}) [ht3, ht2, ht1, tR]
  have u3W : t3.G NLogN.Rsp.BW = .int w :: (ints (Wi.drop (k + 1)) ++ RW) := by
    simp (config := {decide := true}) [ht3, u2W]
  have u3D : t3.G BD = .int (d : ℤ) :: (ints ((Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1)) ++ RD) := by
    simp (config := {decide := true}) [ht3, ht2, u1D]
  have hrun : kBody.run t = (seqL [push BAT (.add (.reg BA) (.quo (.reg BP) (.reg BR))), pop BP,
      pop BA, push BWT (.reg NLogN.Rsp.BW), pop NLogN.Rsp.BW, push BDT (.reg BD), pop BD]).run t3 := by
    simp only [kBody, RM.run, hm.2]; rfl
  have hdX : a + d ≤ Xi.length := by omega
  have zd : zsz (d : ℤ) ≤ B := le_trans (zsz_natCast_le (by omega)) hLB
  have za : zsz (a : ℤ) ≤ B := le_trans (zsz_natCast_le (by omega)) hLB
  have zad : zsz ((a : ℤ) + d) ≤ B := by
    have : ((a : ℤ) + d) = ((a + d : ℕ) : ℤ) := by push_cast; ring
    rw [this]; exact le_trans (zsz_natCast_le hdX) hLB
  have zwx : zsz (w * x0) ≤ B := le_trans (zsz_mul_le _ _) (by omega)
  have zR : zsz R ≤ B := by rw [hR, NLogN.zsz_two_pow]; omega
  have hq : zsz ((w * x0).tdiv R) ≤ B :=
    le_trans (zsz_mono (by rw [Int.natAbs_tdiv]; exact Nat.div_le_self _ _)) zwx
  have ok1 : (asg BCC (.add (.reg BCC) (.reg BD))).ok t1 :=
    ⟨by decide, by decide, ⟨IState.isInt_of u1, IState.isInt_of u1D⟩, IState.isInt_of u1⟩
  have ok2 : (RM.mul BP NLogN.Rsp.BX NLogN.Rsp.BW).ok M t2 :=
    RM.mul_ok_of_bnd hM BP NLogN.Rsp.BX NLogN.Rsp.BW t2 x0 w _ _ (by decide) (by decide) (by decide) u2X u2W hxB hwB
  have ok3 : (seqL [push BAT (.add (.reg BA) (.quo (.reg BP) (.reg BR))), pop BP,
      pop BA, push BWT (.reg NLogN.Rsp.BW), pop NLogN.Rsp.BW, push BDT (.reg BD), pop BD]).ok t3 := by
    simp (config := {decide := true}) only [seqL, RS.ok, RS.run_push_G, RS.run_pop_G, Ex.ok,
      IState.IsInt, IState.top, IState.upd_G, RS.run, u3, u3A, u3R, u3W, u3D, if_true, if_false,
      List.tail_cons, Ex.eval]
    refine ⟨⟨by decide, by decide, ⟨⟨_, rfl⟩, ⟨_, rfl⟩, ⟨_, rfl⟩, ⟨sh, hR⟩⟩⟩, ⟨by decide, ⟨_, rfl⟩⟩,
      ⟨by decide, ⟨_, rfl⟩⟩, ⟨by decide, by decide, ⟨_, rfl⟩⟩, ⟨by decide, ⟨_, rfl⟩⟩,
      ⟨by decide, by decide, ⟨_, rfl⟩⟩, ⟨by decide, ⟨_, rfl⟩⟩⟩
  have e2 : (RM.rs (asg BCC (.add (.reg BCC) (.reg BD)))).run t1 = t2 := rfl
  have e1 : (RM.rs (mvK NLogN.Rsp.BX BY BCM (.reg BD))).run t = t1 := hm.2
  refine ⟨⟨hm.1, by rw [e1]; exact ok1, by rw [e1, e2]; exact ok2, by rw [e1, e2]; exact ok3⟩, ?_⟩
  -- costs
  have c1 := mvK_cost (X := NLogN.Rsp.BX) (Y := BY) (C := BCM) (by decide) (by decide) (by decide) (.reg BD) t
    ((Xi.drop a).take d) _ tX (by rw [hlen]; simp [Ex.eval, IState.top, tD]) B
    (fun y hy => le_trans (hXB y (List.mem_of_mem_drop (List.mem_of_mem_take hy))) (by omega))
    trivial (by simpa [Ex.Bnd, IState.top, tD] using zd)
  rw [hlen] at c1
  have c2 : (asg BCC (.add (.reg BCC) (.reg BD))).cost t1 ≤ (3 + 1) * 2000 * (B + 2) :=
    RS.asgCost_le_lin BCC (.add (.reg BCC) (.reg BD)) t1 B (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top, u1, u1D]; exact ⟨za, zd, zad⟩)
    (by simpa [IState.top, u1] using za)
  have c3 := RM.mul_cost_of_bnd hM BP NLogN.Rsp.BX NLogN.Rsp.BW t2 x0 w _ _ u2X u2W hxB hwB
  have c4 : (seqL [push BAT (.add (.reg BA) (.quo (.reg BP) (.reg BR))), pop BP,
      pop BA, push BWT (.reg NLogN.Rsp.BW), pop NLogN.Rsp.BW, push BDT (.reg BD), pop BD]).cost t3 ≤ 40000 * (B + 2) := by
    have p1 : (push BAT (.add (.reg BA) (.quo (.reg BP) (.reg BR)))).cost t3 ≤ (5 + 1) * 2000 * (B + 2) :=
      RS.pushCost_le_lin (.add (.reg BA) (.quo (.reg BP) (.reg BR))) t3 B
      (by simp [Ex.Lin]) (by
        simp only [Ex.Bnd, Ex.eval, IState.top, u3, u3A, u3R]
        exact ⟨hcB, ⟨zwx, zR⟩, hoB'⟩)
    have hwB' : zsz w ≤ B := by omega
    simp only [seqL, RS.cost_seq']
    refine le_trans (add_le_add p1 (add_le_add (cpop _ _ B ?_) (add_le_add (cpop _ _ B ?_)
      (add_le_add (cpush_reg _ _ _ B ?_) (add_le_add (cpop _ _ B ?_)
      (add_le_add (cpush_reg _ _ _ B ?_) (cpop _ _ B ?_))))))) (by omega)
    all_goals simpa (config := {decide := true}) [RS.run, IState.top, IState.upd_G, u3, u3A, u3R,
      u3W, u3D] using (by assumption)
  have ec : kBody.cost M t = (mvK NLogN.Rsp.BX BY BCM (.reg BD)).cost t +
