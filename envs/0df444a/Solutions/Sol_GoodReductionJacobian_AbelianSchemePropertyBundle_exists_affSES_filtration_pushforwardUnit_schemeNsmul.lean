p2m_open "CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry NeronModelInfra GoodReductionJacobian"

universe u

theorem solution
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (n : ℕ) (hn : (n : K) ≠ 0) :
    ∃ (E : ℕ → OModulePresheaf f) (M : ℕ → A.Modules),
      E 0 = OModulePresheaf.zero f ∧
      E (n ^ (2 * g)) = OModulePresheaf.pushforwardUnit f (L.schemeNsmul n) ∧
      ∀ j : ℕ, j < n ^ (2 * g) →
        Scheme.Modules.IsInvertible (M j) ∧ Nonempty ((M j).tensorPow n ≅ 𝟙_ (A.Modules)) ∧
        Nonempty (OModulePresheaf.AffSES (E j) (E (j + 1)) (OModulePresheaf.ofModules f (M j))) := by
  classical

  have hG : ∀ x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n,
      L.translate x ≫ L.schemeNsmul n = L.schemeNsmul n :=
    fun x hx => L.translate_comp_schemeNsmul_of_mem_torsionSubset hc n x hx

  obtain ⟨hfin, hcard, hmulX, hpow, hdec⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.finite_isNsmulCharacter_and_ncard_eq_pow_and_bijective_sum_eigenInclusion
      K f L hc hA g n hn hG

  obtain ⟨hfr, hone⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_affineOpens_bijective_smul_eigenSubdatum_and_bijective_smul_eigenOne
      K f L hc hA g n hn hG

  choose N φ ψ hφψ hψφ using
    fun χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K =>
      L.exists_modules_hom_ofModules_eigenSubdatum_inverse n hG χ
  have h1 : L.IsNsmulCharacter n 1 := L.isNsmulCharacter_one n
  have hpowX : ∀ χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K, L.IsNsmulCharacter n χ →
      ∀ k : ℕ, L.IsNsmulCharacter n (χ ^ k) := by
    intro χ hχ k
    induction k with
    | zero => simpa using h1
    | succ k ih => rw [pow_succ]; exact hmulX _ _ ih hχ

  have hframeN : ∀ χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K, L.IsNsmulCharacter n χ →
      ∀ (V : A.affineOpens) (s : (L.eigenSubdatum n hG χ).obj V.1),
        (∀ (W : A.affineOpens) (hW : W.1 ≤ V.1),
          Function.Bijective (fun a : Γ(A, W.1) => a • (L.eigenSubdatum n hG χ).res hW s)) →
        Scheme.Modules.IsFrameOn (show Γ(N χ, V.1) from (ψ χ).app V.1 s) V.1 := by
    intro χ hχ V s hs
    apply Scheme.Modules.isFrameOn_of_forall_affineOpens_bijective_smul
    intro W hW
    have hnat : (N χ).presheaf.map (homOfLE hW).op (show Γ(N χ, V.1) from (ψ χ).app V.1 s) =
        (ψ χ).app W.1 ((L.eigenSubdatum n hG χ).res hW s) := by
      change (OModulePresheaf.ofModules f (N χ)).res hW ((ψ χ).app V.1 s) = _
      exact ((ψ χ).naturality_apply hW s).symm
    have hcomp : (fun a : Γ(A, W.1) => a • ((N χ).presheaf.map (homOfLE hW).op
          (show Γ(N χ, V.1) from (ψ χ).app V.1 s) : Γ(N χ, W.1))) =
        (fun t => (ψ χ).app W.1 t) ∘ (fun a : Γ(A, W.1) => a • (L.eigenSubdatum n hG χ).res hW s) := by
      funext a
      simp only [Function.comp_apply, hnat]
      exact ((ψ χ).app_smul W.1 a _).symm
    rw [hcomp]
    refine Function.Bijective.comp ?_ (hs W hW)
    exact ⟨fun a b hab => by have h' := congrArg ((φ χ).app W.1) hab; rwa [hφψ, hφψ] at h',
      fun t => ⟨(φ χ).app W.1 t, hψφ χ W.1 t⟩⟩
  have hinv : ∀ χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K, L.IsNsmulCharacter n χ →
      Scheme.Modules.IsInvertible (N χ) := by
    intro χ hχ
    refine ⟨fun y => ?_⟩
    obtain ⟨V, hyV, s, t, hst⟩ := hfr χ 1 hχ h1 y
    have hfrm := hframeN χ hχ V s (fun W hW => (hst W hW).1)
    exact ⟨V.1, hyV, Scheme.Modules.IsFrameOn.nonempty_pullback_iso_unit_monoidalV2 hfrm V.1 le_rfl le_rfl⟩

  have htens : ∀ χ χ' : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K,
      L.IsNsmulCharacter n χ → L.IsNsmulCharacter n χ' → Nonempty (N χ ⊗ N χ' ≅ N (χ * χ')) := by
    intro χ χ' hχ hχ'
    exact L.nonempty_tensor_iso_of_hom_eigenSubdatum_of_forall_exists_bijective_smul n hG χ χ'
      (N χ) (N χ') (N (χ * χ')) (φ χ) (ψ χ) (hφψ χ) (hψφ χ) (φ χ') (ψ χ') (hφψ χ') (hψφ χ')
      (φ (χ * χ')) (ψ (χ * χ')) (hφψ (χ * χ')) (hψφ (χ * χ')) (hfr χ χ' hχ hχ')
  have hunit : Nonempty (N 1 ≅ 𝟙_ (A.Modules)) :=
    L.nonempty_iso_tensorUnit_of_hom_eigenSubdatum_one_of_bijective_smul_eigenOne n hG (N 1)
      (φ 1) (ψ 1) (hφψ 1) (hψφ 1) hone
  have htpow : ∀ χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K, L.IsNsmulCharacter n χ →
      ∀ k : ℕ, Nonempty ((N χ).tensorPow k ≅ N (χ ^ k)) := by
    intro χ hχ k
    induction k with
    | zero =>
      obtain ⟨e⟩ := hunit
      exact ⟨(e.symm).trans (eqToIso (by rw [pow_zero]))⟩
    | succ k ih =>
      obtain ⟨e⟩ := ih
      obtain ⟨m⟩ := htens (χ ^ k) χ (hpowX χ hχ k) hχ
      exact ⟨(whiskerRightIso e (N χ)).trans (m.trans (eqToIso (by rw [pow_succ])))⟩
  have htors : ∀ χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K, L.IsNsmulCharacter n χ →
      Nonempty ((N χ).tensorPow n ≅ 𝟙_ (A.Modules)) := by
    intro χ hχ
    obtain ⟨e⟩ := htpow χ hχ n
    obtain ⟨u⟩ := hunit
    exact ⟨e.trans ((eqToIso (congrArg N (hpow χ hχ))).trans u)⟩

  set d : ℕ := n ^ (2 * g) with hd_def
  have hd : 0 < d := by
    have hn0 : n ≠ 0 := by rintro rfl; exact hn (by simp)
    positivity
  let X : Finset (SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) := hfin.toFinset
  have hXmem : ∀ χ, χ ∈ X ↔ L.IsNsmulCharacter n χ := fun χ => by
    simp [X, Set.Finite.mem_toFinset]
  have hXcard : X.card = d := by
    rw [← hcard]; exact (Set.ncard_eq_toFinset_card _ hfin).symm
  obtain ⟨e⟩ : Nonempty (Fin d ≃ ↥X) := ⟨(X.equivFinOfCardEq hXcard).symm⟩
  let χ_ : ℕ → (SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) :=
    fun j => if h : j < d then (e ⟨j, h⟩).1 else 1
  have hχ_X : ∀ j : ℕ, L.IsNsmulCharacter n (χ_ j) := fun j => by
    by_cases h : j < d
    · simp only [χ_, dif_pos h]; exact (hXmem _).1 (e ⟨j, h⟩).2
    · simp only [χ_, dif_neg h]; exact h1
  have hχ_fin : ∀ j : Fin d, χ_ (j : ℕ) = (e j).1 := fun j => by
    simp only [χ_, dif_pos j.2]
  let M : ℕ → A.Modules := fun j => N (χ_ j)
  let F : ℕ → OModulePresheaf f := fun j => OModulePresheaf.ofModules f (M j)
  let ι : ∀ j : ℕ, OModulePresheaf.Hom (F j) (OModulePresheaf.pushforwardUnit f (L.schemeNsmul n)) :=
    fun j => (L.eigenInclusion n hG (χ_ j)).comp (φ (χ_ j))
  have hbij : ∀ U : A.affineOpens, Function.Bijective
      (fun s : (j : Fin d) → (F j).obj U.1 => ∑ j : Fin d, (ι j).app U.1 (s j)) := by
    intro U
    have hD := hdec X hXmem U.1

    have hΦ : ∀ s : (j : Fin d) → (F j).obj U.1,
        (∑ j : Fin d, (ι j).app U.1 (s j)) = ∑ j : Fin d, ((φ (χ_ j)).app U.1 (s j)).1 := fun s => rfl
    have key : ∀ (a b : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) (hab : a = b)
        (v : (OModulePresheaf.pushforwardUnit f (L.schemeNsmul n)).obj U.1),
        v ∈ L.eigenSubmodule n hG a U.1 → v ∈ L.eigenSubmodule n hG b U.1 := by
      intro a b hab v hv; subst hab; exact hv
    have hχe : ∀ χ : ↥X, χ_ (e.symm χ : ℕ) = (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) :=
      fun χ => by rw [hχ_fin, Equiv.apply_symm_apply]
    constructor
    · intro s s' hss'
      dsimp only at hss'
      rw [hΦ, hΦ] at hss'
      let v : Fin d → (OModulePresheaf.pushforwardUnit f (L.schemeNsmul n)).obj U.1 :=
        fun j => ((φ (χ_ j)).app U.1 (s j)).1
      let v' : Fin d → (OModulePresheaf.pushforwardUnit f (L.schemeNsmul n)).obj U.1 :=
        fun j => ((φ (χ_ j)).app U.1 (s' j)).1
      have hvv : ∑ j, v j = ∑ j, v' j := hss'

      let u : (χ : ↥X) → (L.eigenSubdatum n hG (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K)).obj U.1 :=
        fun χ => ⟨v (e.symm χ), key _ _ (hχe χ) _ ((φ (χ_ (e.symm χ))).app U.1 (s (e.symm χ))).2⟩
      let u' : (χ : ↥X) → (L.eigenSubdatum n hG (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K)).obj U.1 :=
        fun χ => ⟨v' (e.symm χ), key _ _ (hχe χ) _ ((φ (χ_ (e.symm χ))).app U.1 (s' (e.symm χ))).2⟩
      have hu : (∑ χ : ↥X, (L.eigenInclusion n hG (χ : _ → K)).app U.1 (u χ)) =
          ∑ χ : ↥X, (L.eigenInclusion n hG (χ : _ → K)).app U.1 (u' χ) := by
        simp only [RelativeGroupLaw.eigenInclusion_app, u, u']
        rw [Equiv.sum_comp e.symm v, Equiv.sum_comp e.symm v']
        exact hvv
      have huu := hD.1 hu
      funext j
      have hj := congrArg Subtype.val (congrFun huu (e j))
      simp only [u, u', Equiv.symm_apply_apply] at hj

      have hj' : (φ (χ_ j)).app U.1 (s j) = (φ (χ_ j)).app U.1 (s' j) := Subtype.ext hj
      have := congrArg ((ψ (χ_ j)).app U.1) hj'
      rwa [hψφ, hψφ] at this
    · intro w
      obtain ⟨u, hu⟩ := hD.2 w
      refine ⟨fun j => (ψ (χ_ j)).app U.1 ⟨(u (e j)).1, key _ _ (hχ_fin j).symm _ (u (e j)).2⟩, ?_⟩
      dsimp only
      rw [hΦ]
      simp only [hφψ]
      rw [← hu]
      simp only [RelativeGroupLaw.eigenInclusion_app]
      exact (Equiv.sum_comp e (fun χ : ↥X => (u χ).1))
  obtain ⟨P, hP0, hPd, hSES⟩ :=
    AlgebraicGeometry.OModulePresheaf.exists_filtration_affSES_of_forall_affineOpens_bijective_sum
      (OModulePresheaf.pushforwardUnit f (L.schemeNsmul n)) d hd F ι hbij
  exact ⟨P, M, hP0, hPd, fun j hj => ⟨hinv _ (hχ_X j), htors _ (hχ_X j), hSES j hj⟩⟩

