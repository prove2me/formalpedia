/-! ## Rank counts from the packed counts -/

theorem digit_ext (B : ℕ) (hB : 0 < B) (c : ℕ → ℕ) (hc : ∀ r, c r < B) :
    ∀ K i, i < K → (∑ r ∈ Finset.range K, c r * B ^ r) / B ^ i % B = c i := by
  intro K
  induction K generalizing c with
  | zero => intro i hi; omega
  | succ K ih =>
    intro i hi
    rw [Finset.sum_range_succ']
    have e : ∑ r ∈ Finset.range K, c (r + 1) * B ^ (r + 1) = B * ∑ r ∈ Finset.range K, c (r + 1) * B ^ r := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun r _ => by ring
    rw [e, pow_zero, mul_one]
    rcases i with _ | i
    · rw [pow_zero, Nat.div_one, add_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hc 0)]
    · rw [pow_succ', ← Nat.div_div_eq_div_mul, add_comm, Nat.add_mul_div_left _ _ hB, Nat.div_eq_of_lt (hc 0),
        zero_add]
      exact ih (fun r => c (r + 1)) (fun r => hc (r + 1)) i (by omega)

theorem count_sum_real (L : List ℕ) (K : ℕ) (hL : ∀ r ∈ L, r < K) (g : ℕ → ℝ) :
    (L.map g).sum = ∑ r ∈ Finset.range K, (L.count r : ℝ) * g r := by
  rw [Finset.sum_list_map_count]
  refine Finset.sum_subset (fun r hr => Finset.mem_range.2 (hL r (List.mem_toFinset.1 hr))) ?_ |>.trans ?_
  · intro r _ hr
    rw [List.count_eq_zero_of_not_mem (fun h => hr (List.mem_toFinset.2 h)), zero_smul]
  · exact Finset.sum_congr rfl fun r _ => by rw [nsmul_eq_mul]

theorem count_sum_nat (L : List ℕ) (K : ℕ) (hL : ∀ r ∈ L, r < K) (g : ℕ → ℕ) :
    (L.map g).sum = ∑ r ∈ Finset.range K, L.count r * g r := by
  rw [Finset.sum_list_map_count]
  refine Finset.sum_subset (fun r hr => Finset.mem_range.2 (hL r (List.mem_toFinset.1 hr))) ?_ |>.trans ?_
  · intro r _ hr
    rw [List.count_eq_zero_of_not_mem (fun h => hr (List.mem_toFinset.2 h)), zero_smul]
  · exact Finset.sum_congr rfl fun r _ => by rw [smul_eq_mul]

/-- Counting ranks from a packed count. -/
theorem ranks_count (L : List ℕ) (P : ℕ) (hP : (L.map fun r => 2 ^ (32 * r)).sum = P)
    (hlen : L.length < 2 ^ 32) (hPK : P < 2 ^ (32 * 23)) :
    (∀ r ∈ L, r < 23) ∧ ∀ i < 23, L.count i = P / 2 ^ (32 * i) % 2 ^ 32 := by
  have hlt : ∀ r ∈ L, r < 23 := by
    intro r hr
    have h1 : 2 ^ (32 * r) ≤ P := by
      rw [← hP]; exact List.le_sum_of_mem (List.mem_map.2 ⟨r, hr, rfl⟩)
    by_contra hc
    have : 2 ^ (32 * 23) ≤ 2 ^ (32 * r) := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact absurd (lt_of_lt_of_le hPK (this.trans h1)) (lt_irrefl P)
  refine ⟨hlt, fun i hi => ?_⟩
  have hc : ∀ r, L.count r < 2 ^ 32 := fun r => lt_of_le_of_lt (List.count_le_length) hlen
  have e := count_sum_nat L 23 hlt fun r => 2 ^ (32 * r)
  rw [hP] at e
  have e2 : P = ∑ r ∈ Finset.range 23, L.count r * (2 ^ 32) ^ r := by
    rw [e]; exact Finset.sum_congr rfl fun r _ => by rw [← pow_mul]
  rw [e2, show 2 ^ (32 * i) = (2 ^ 32) ^ i by rw [← pow_mul]]
  exact (digit_ext (2 ^ 32) (by norm_num) (fun r => L.count r) hc 23 i hi).symm

theorem len1 : (mvRanks cs1).length < 2 ^ 32 := by
  have h := mvRanks_len W1F (codeOf SG1_0)
  rw [← cs1_eq] at h
  exact lt_of_le_of_lt h touchW1

theorem len2 : (mvRanks cs2).length < 2 ^ 32 := by
  have h := mvRanks_len W2F (codeOf SG2_0)
  rw [← cs2_eq] at h
  exact lt_of_le_of_lt h touchW2

theorem RS_eq (τ : ℝ) (cs : List LChunk) (P : ℕ) (hP : cntF cs = P) (hlen : (mvRanks cs).length < 2 ^ 32)
    (hPK : P < 2 ^ (32 * 23)) (hD : ∀ i < 23, P / 2 ^ (32 * i) % 2 ^ 32 = DC i) :
    RS τ cs = ∑ r ∈ Finset.range 23, (DC r : ℝ) * sideV τ r := by
  rw [cntF_eq] at hP
  obtain ⟨hlt, hcnt⟩ := ranks_count _ P hP hlen hPK
  rw [RS, count_sum_real _ 23 hlt]
  exact Finset.sum_congr rfl fun r hr => by
    rw [hcnt r (Finset.mem_range.1 hr), hD r (Finset.mem_range.1 hr)]

theorem RS1_eq (τ : ℝ) : RS τ cs1 = ∑ r ∈ Finset.range 23, (DC r : ℝ) * sideV τ r :=
  RS_eq τ cs1 CNs1 seg1.2.2.2 len1 CNs1_lt fun _ _ => rfl

theorem RS2_eq (τ : ℝ) : RS τ cs2 = ∑ r ∈ Finset.range 23, (DC r : ℝ) * sideV τ r :=
  RS_eq τ cs2 CNs2 seg2.2.2.2 len2 CNs2_lt DC_eq2

theorem side_total (τ : ℝ) : ∑ r ∈ Finset.range 23, (DC r : ℝ) * sideV τ r =
    2668 * sideV τ 0 + 45080 * sideV τ 1 + 26286 * sideV τ 2 + 8326 * sideV τ 3 + 12804 * sideV τ 4 +
    9110 * sideV τ 5 + 3607 * sideV τ 6 + 3026 * sideV τ 7 + 3285 * sideV τ 8 + 2451 * sideV τ 9 +
    3515 * sideV τ 10 + 1255 * sideV τ 11 + 3239 * sideV τ 12 + 1600 * sideV τ 13 + 3308 * sideV τ 14 +
    1968 * sideV τ 15 + 4159 * sideV τ 16 + 1255 * sideV τ 17 + 10043 * sideV τ 18 + 3926 * sideV τ 19 +
    1288 * sideV τ 20 + 2750 * sideV τ 21 + 3565 * sideV τ 22 := by
  have hv : ∀ i < 23, DC i = ((List.range 23).map DC).getD i 0 := fun i hi => by
    rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hi]; rfl
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
  rw [hv 0 (by norm_num), hv 1 (by norm_num), hv 2 (by norm_num), hv 3 (by norm_num), hv 4 (by norm_num),
    hv 5 (by norm_num), hv 6 (by norm_num), hv 7 (by norm_num), hv 8 (by norm_num), hv 9 (by norm_num),
    hv 10 (by norm_num), hv 11 (by norm_num), hv 12 (by norm_num), hv 13 (by norm_num),
    hv 14 (by norm_num), hv 15 (by norm_num), hv 16 (by norm_num), hv 17 (by norm_num),
    hv 18 (by norm_num), hv 19 (by norm_num), hv 20 (by norm_num), hv 21 (by norm_num),
    hv 22 (by norm_num), DC_vals]
  norm_num

