-- title:
--   Proposition 3.1, Part 2 — one-step inequality (3.10) under Lipschitz C and strongly monotone B
-- statement:
--   Let $H$ be a real Hilbert space, $A, B : H \to 2^H$ maximal monotone, with $B$ $\mu_B$-strongly monotone for some $\mu_B > 0$, and let $C : H \to H$ be monotone and $L_C$-Lipschitz ($L_C \ge 0$). Let $(\gamma_j)_{j \ge 0}$ be any positive stepsizes. Let $x^* \in H$, $u_A^* \in Ax^*$, $u_B^* \in Bx^*$ with $u_A^* + u_B^* + Cx^* = 0$. Let $(x_A^k, x_B^k, u_B^k)$ be generated by recursion (3.8) (Algorithm 3) from an arbitrary $x_A^0 \in H$. Then for every $k \ge 1$,
--   $$\Big(1 + 2\gamma_k\big(\mu_B - \tfrac{\gamma_k L_C^2}{2}\big)\Big)\|x_B^{k+1} - x^*\|^2 + \gamma_k^2L_C^2\|x_B^{k+1} - x^*\|^2 + \gamma_k^2\|u_B^{k+1} - u_B^*\|^2 \le \|x_B^k - x^*\|^2 + \gamma_k^2L_C^2\|x_B^k - x^*\|^2 + \gamma_k^2\|u_B^k - u_B^*\|^2.$$
--
--   This is inequality (3.10), the counterpart of (3.9) when $C$ is only Lipschitz: the strong monotonicity of $B$ alone drives the acceleration of Theorem 3.3, Part 2.
--
--   **Formalization Note** The paper states (3.10) "for all $k \ge 0$"; at $k = 0$ the point $x_A^0$ is the free initial point and not a resolvent output, and the inequality fails in general (e.g. $A = 0$, $C = 0$, $B = \mu_B I$, $x^* = 0$). The statement is made for $k \ge 1$. $C$ is assumed monotone: the proposition says "not necessarily strongly monotone", but $C$ is monotone throughout problem (1.1) and the proof on p. 844 uses "the monotonicity of $C$". The points $x^*$, $u_A^*$, $u_B^*$ are hypotheses.
-- source:
--   Davis and Yin, A Three-Operator Splitting Scheme and its Optimization Applications, Set-Valued Var. Anal. 25 (2017), https://doi.org/10.1007/s11228-017-0421-z, p. 843, Proposition 3.1, Part 2, Eq. (3.10)

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_ThreeOpSplitting_Accel_Algorithm3
import Definitions.Def_ThreeOpSplitting_Accel_Stepsizes

open InnerProductSpace Filter Topology

namespace ThreeOpSplitting.Accel

/-- Proposition 3.1, Part 2 (inequality (3.10)), for every iteration `k ≥ 1` of recursion (3.8)
with arbitrary positive stepsizes. The paper writes "for all `k ≥ 0`"; at `k = 0` the point
`x_A^0` is the free initial point, not a resolvent output, and (3.10) fails in general. -/
theorem prop_3_1_part2 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H]
    (A B : H → Set H) (C : H → H) (JA JB : ℝ → H → H)
    (μB LC : ℝ) (γ : ℕ → ℝ) (xA0 xs uAs uBs : H)
    (hA : IsMaximalMonotone A) (hB : IsMaximalMonotone B)
    (hμB : 0 < μB) (hBs : IsStronglyMonotoneOp μB B)
    (hCm : IsMonotoneFun C) (hLC : 0 ≤ LC) (hCL : IsLipschitzOp LC C)
    (hγ : ∀ j : ℕ, 0 < γ j)
    (hJA : IsResolventFamily A JA) (hJB : IsResolventFamily B JB)
    (huA : uAs ∈ A xs) (huB : uBs ∈ B xs) (hsum : uAs + uBs + C xs = 0)
    (k : ℕ) (hk : 1 ≤ k) :
    (1 + 2 * γ k * (μB - γ k * LC ^ 2 / 2)) * ‖(accelIter JA JB C γ xA0 (k + 1)).xB - xs‖ ^ 2
        + γ k ^ 2 * LC ^ 2 * ‖(accelIter JA JB C γ xA0 (k + 1)).xB - xs‖ ^ 2
        + γ k ^ 2 * ‖(accelIter JA JB C γ xA0 (k + 1)).uB - uBs‖ ^ 2
      ≤ ‖(accelIter JA JB C γ xA0 k).xB - xs‖ ^ 2
        + γ k ^ 2 * LC ^ 2 * ‖(accelIter JA JB C γ xA0 k).xB - xs‖ ^ 2
        + γ k ^ 2 * ‖(accelIter JA JB C γ xA0 k).uB - uBs‖ ^ 2 := by sorry

end ThreeOpSplitting.Accel
