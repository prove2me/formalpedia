-- title:
--   Path periods generate the dual of S₂(Γ₀(N))
-- statement:
--   Let $N$ be a natural number with $N \neq 0$, and let $V =$ `CuspForm (CongruenceSubgroup.Gamma0 N) 2` be the space of weight-$2$ cusp forms for $\Gamma_0(N)$, with $\mathbb{C}$-linear dual `Module.Dual ℂ V`. For a pair $p = (\tau_0, \tau_1)$ of points of the upper half-plane $\mathbb{H}$, the functional [`ModularCurve.periodAlong N τ₀ τ₁`](def/ModularCurve_PeriodLattice.html#L78) is the element of this dual sending $f \in V$ to the interval integral $\int_0^1 f(\mathrm{segmentPath}\ \tau_0\ \tau_1\ t)\,((\tau_1 : \mathbb{C}) - \tau_0)\, dt$, i.e. the integral of the integrand `periodIntegrand N τ₀ τ₁ f` over $[0,1]$, where `segmentPath τ₀ τ₁ : ℝ → ℍ` is the path in $\mathbb{H}$ determined by $\tau_0$ and $\tau_1$ and the constant factor $\tau_1 - \tau_0$ is the derivative factor of the parametrisation; additivity in $f$ and $\mathbb{C}$-homogeneity hold by linearity of the integral. The theorem asserts that the additive subgroup of `Module.Dual ℂ V` generated by the set of all such functionals, as $(\tau_0,\tau_1)$ ranges over $\mathbb{H} \times \mathbb{H}$, is the whole dual: every $\mathbb{C}$-linear functional on $S_2(\Gamma_0(N))$ is a finite sum of path periods and their negatives (an integral, not merely a $\mathbb{C}$-linear, combination).
--
--   This is the Jacobi inversion, or surjectivity, input for the analytic description of the Jacobian of $X_0(N)$ as a quotient of the dual of $S_2(\Gamma_0(N))$ by the period lattice: finite sums of Abel–Jacobi path integrals already fill the whole dual. It is used in the constructions of a Hecke-equivariant isomorphism, and of an injective Hecke-equivariant homomorphism, from the degree-zero Picard group of the complex modular curve to the quotient of the dual by the period lattice.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_addSubgroupClosure_range_periodAlong_eq_top.lean

import Mathlib
import Definitions.Def_ModularCurve_PeriodLattice

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem ModularCurve.addSubgroupClosure_range_periodAlong_eq_top (N : ℕ) [NeZero N] :
    AddSubgroup.closure
        (Set.range fun p : UpperHalfPlane × UpperHalfPlane =>
          ModularCurve.periodAlong N p.1 p.2) =
      (⊤ : AddSubgroup (Module.Dual ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2))) := by sorry
