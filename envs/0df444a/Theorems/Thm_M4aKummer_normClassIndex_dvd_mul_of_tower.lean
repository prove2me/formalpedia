-- title:
--   Tower divisibility for narrow ray norm-class indices
-- statement:
--   Let $k$, $M$, $E$ be number fields forming a tower, i.e. equipped with algebra structures $k \to M$, $M \to E$, $k \to E$ compatible as a scalar tower (no Galois or separability hypothesis beyond this), and let $\mathfrak f$ be an ideal of $\mathcal O_k$. For a number field $K$ and an ideal $\mathfrak c$ of $\mathcal O_K$, write $I_K(\mathfrak c)$ for `coprimeToModulus K`$\mathfrak c$, the subgroup of invertible fractional ideals $I$ of $K$ with $v$-adic count $0$ at every height-one prime $v$ whose ideal divides $\mathfrak c$, and $P^+_{\mathfrak c}$ for `narrowRaySubgroup K`$\mathfrak c$, the subgroup generated by the invertible fractional ideals of the form $(\alpha)$ with $0 \neq \alpha \in \mathcal O_K$, $\alpha - 1 \in \mathfrak c$, and $\tau(\alpha) > 0$ for every ring homomorphism $K \to \mathbb R$. For a finite extension $F'/F$ in the tower, the relative ideal norm is realised as `raySymbolUnitsHom` applied to the function sending a height-one prime $w$ of $\mathcal O_{F'}$ to `primeUnit` of the prime $v$ of $\mathcal O_F$ under $w$ raised to the power `inertiaDeg'` of $w$ over $v$; concretely it sends $I$ to the finite product $\prod_w v(w)^{f(w|v)\,\mathrm{count}_w(I)}$. Put $h(F'/F,\mathfrak c)$ for the index, inside $I_F(\mathfrak c)$, of the join of $P^+_{\mathfrak c} \cap I_F(\mathfrak c)$ with the intersection of $I_F(\mathfrak c)$ and the image under this norm map of $I_{F'}(\mathfrak c \mathcal O_{F'})$ (`Subgroup.index`, hence $0$ if the index is infinite). The assertion is that $h(E/k,\mathfrak f)$ divides $h(M/k,\mathfrak f) \cdot h(E/M, \mathfrak f \mathcal O_M)$, where in the last factor the modulus of $E$ is obtained by pushing $\mathfrak f \mathcal O_M$ forward to $\mathcal O_E$.
--
--   This is the tower reduction step for the norm-class indices attached to narrow ray moduli, the mechanism by which the second inequality of global class field theory is propagated from cyclic prime-power steps up a general tower. It is used in the derivation of the bounds [`M4aKummer.normClassIndex_dvd_card_aut`](thm.html#M4aKummer.normClassIndex_dvd_card_aut), [`M4aKummer.normClassIndex_dvd_card_aut_of_isSolvable`](thm.html#M4aKummer.normClassIndex_dvd_card_aut_of_isSolvable) and [`M4aKummer.normClassIndex_dvd_card_aut_of_prime_pow`](thm.html#M4aKummer.normClassIndex_dvd_card_aut_of_prime_pow).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_M4aKummer_normClassIndex_dvd_mul_of_tower.lean

import Definitions.Def_NarrowRayClassGroup

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open NumberField IsDedekindDomain Deep.NTSupply

theorem M4aKummer.normClassIndex_dvd_mul_of_tower
    (k M E : Type*) [Field k] [NumberField k] [Field M] [NumberField M] [Field E] [NumberField E]
    [Algebra k M] [Algebra M E] [Algebra k E] [IsScalarTower k M E] (𝔣 : Ideal (𝓞 k)) :
    ((narrowRaySubgroup k 𝔣).subgroupOf (coprimeToModulus k 𝔣) ⊔
      ((coprimeToModulus E (𝔣.map (algebraMap (𝓞 k) (𝓞 E)))).map
        (raySymbolUnitsHom E (fun w : HeightOneSpectrum (𝓞 E) =>
          primeUnit k (w.under (𝓞 k)) ^ ((w.under (𝓞 k)).asIdeal.inertiaDeg' w.asIdeal)))).subgroupOf
        (coprimeToModulus k 𝔣)).index
    ∣ ((narrowRaySubgroup k 𝔣).subgroupOf (coprimeToModulus k 𝔣) ⊔
        ((coprimeToModulus M (𝔣.map (algebraMap (𝓞 k) (𝓞 M)))).map
          (raySymbolUnitsHom M (fun u : HeightOneSpectrum (𝓞 M) =>
            primeUnit k (u.under (𝓞 k)) ^ ((u.under (𝓞 k)).asIdeal.inertiaDeg' u.asIdeal)))).subgroupOf
          (coprimeToModulus k 𝔣)).index
      * ((narrowRaySubgroup M (𝔣.map (algebraMap (𝓞 k) (𝓞 M)))).subgroupOf
            (coprimeToModulus M (𝔣.map (algebraMap (𝓞 k) (𝓞 M)))) ⊔
          ((coprimeToModulus E ((𝔣.map (algebraMap (𝓞 k) (𝓞 M))).map (algebraMap (𝓞 M) (𝓞 E)))).map
            (raySymbolUnitsHom E (fun w : HeightOneSpectrum (𝓞 E) =>
              primeUnit M (w.under (𝓞 M)) ^ ((w.under (𝓞 M)).asIdeal.inertiaDeg' w.asIdeal)))).subgroupOf
            (coprimeToModulus M (𝔣.map (algebraMap (𝓞 k) (𝓞 M))))).index := by sorry
