theorem row_step (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d)
    (L1 L2 : List Item) (h1 : s.G 1 = .int n :: L1) (h2 : s.G 2 = .int m :: L2)
    (S0 : IState HS) (N0 i : ℕ) (hi : i < n) :
    (rowBody d).ok (withCtr 43 S0 N0 i (outerSt s D Rest n m d i)) ∧
    (rowBody d).run (withCtr 43 S0 N0 i (outerSt s D Rest n m d i)) =
      withCtr 43 S0 N0 i (outerSt s D Rest n m d (i + 1)) := by
  generalize ht : withCtr 43 S0 N0 i (outerSt s D Rest n m d i) = t
  have tG : ∀ x, x ≠ 43 → t.G x = (outerSt s D Rest n m d i).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t42 : t.G 42 = .int (i : ℤ) :: s.G 42 := by rw [tG 42 (by decide)]; simp [outerSt]
  set u := (push 41 (.reg 42)).run t with hu
  have u1 : u.G 1 = .int n :: L1 := by
    rw [hu, run_push_G, if_neg (by decide), tG 1 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have u2 : u.G 2 = .int m :: L2 := by
    rw [hu, run_push_G, if_neg (by decide), tG 2 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h2]
  have hz : innerSt s u D Rest n m d i 0 = u := by
    apply IState.ext' _ (by simp [innerSt]) (by simp [innerSt])
    intro x
    simp only [innerSt, IState.upd_G]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hu, tG 0 (by decide), outerSt]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [hu, tG 40 (by decide), outerSt]
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [hu, Ex.eval, IState.top_eq t42, tG 41 (by decide), outerSt]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [hu, tG 45 (by decide), outerSt]
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [hu, tG 54 (by decide), outerSt]
    simp [x0, x40, x41, x45, x54]
  have H := inner_states d n m i D Rest s u hD hDw hi L1 L2 u1 u2 hz
  have e2 : (Ex.reg (S := HS) 2).eval u = m := by simp [Ex.eval, IState.top_eq u2]
  have hin : (innerLoop d).run u = innerSt s u D Rest n m d i m := by
    rw [innerLoop, H.run, e2, Int.toNat_natCast]
  set v := innerSt s u D Rest n m d i m with hv
  have v41 : v.G 41 = .int ((m * n + i : ℕ) : ℤ) :: s.G 41 := by simp [hv, innerSt]
  have v42' : v.G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [hv, innerSt, IState.upd_G]
    simp (config := {decide := true}) [hu, t42]
  have v42 : ((pop 41).run v).G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [run_pop_G]; simp (config := {decide := true}) [v42']
  have hrun : (rowBody d).run t = (asg 42 (.add (.reg 42) (.lit 1))).run ((pop 41).run v) := by
    simp only [rowBody, run_seq, ← hu, hin]
  refine ⟨?_, ?_⟩
  · refine ⟨⟨by decide, clean_of_lt (by decide), IState.isInt_of t42⟩, ?_, ?_⟩
    · refine H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of u2) ?_
      intro j hj
      rw [e2, Int.toNat_natCast] at hj ⊢
      exact (elem_step d n m i D Rest s u hD hDw hi j hj L1 u1 _).1
    rw [hin]
    refine ⟨⟨by decide, IState.isInt_of v41⟩, by decide, ?_, ⟨IState.isInt_of v42, trivial⟩,
      IState.isInt_of v42⟩
    intro x hx; simp [Ex.regs] at hx; subst hx; decide
  · rw [hrun]
    apply run_ext _ (by simp [hv, innerSt, hu]; rw [← ht]; simp [withCtr, outerSt])
      (by simp [hv, innerSt, hu]; rw [← ht]; simp [withCtr, outerSt])
    intro x
    simp only [run_asg_G, run_pop_G, Ex.eval, IState.top_eq v42]
    by_cases x43 : x = 43
    · subst x43
      simp (config := {decide := true}) [hv, innerSt, hu]
      rw [← ht]; simp [withCtr]
    rw [withCtr_G_ne _ _ _ _ x43]
    by_cases x42 : x = 42
    · subst x42; simp [outerSt, v42']
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [v41, outerSt]
    simp only [if_neg x42, if_neg x41]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [hv, innerSt, outerSt]; left; ring
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    rw [hv, innerSt_G_other _ _ _ _ _ _ _ _ _ _ x0 x40 x41 x45 x54, hu, run_push_G, if_neg x41,
      tG x x43, outerSt_G_other _ _ _ _ _ _ _ _ x0 x40 x42 x45 x54,
      outerSt_G_other _ _ _ _ _ _ _ _ x0 x40 x42 x45 x54]

theorem kflat_length (n m d : ℕ) (D : List (List ℤ)) (hDw : ∀ r ∈ D, r.length = d) :
    ∀ p, p ≤ D.length → (kflat n m D p).length = p * (d + 1)
  | 0, _ => by simp [kflat]
  | p + 1, h => by
    rw [kflat_succ, List.length_append, kflat_length n m d D hDw p (by omega)]
    simp only [keyRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
    ring

theorem outer_states (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d)
    (L1 L2 : List Item) (h1 : s.G 1 = .int n :: L1) (h2 : s.G 2 = .int m :: L2) :
    RepStates 43 (.reg 1) (rowBody d) (outerSt s D Rest n m d 0) (outerSt s D Rest n m d) where
  nonneg := by
    have g1 : (outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
      rw [outerSt_G_other s D Rest n m d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    simp [Ex.eval, IState.top_eq g1]
  hw := by simp (config := {decide := true}) [rowBody, innerLoop, elemBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
  step := by
    intro i hi
    have g1 : (outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
      rw [outerSt_G_other s D Rest n m d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    have e : (Ex.reg (S := HS) 1).eval (outerSt s D Rest n m d 0) = n := by
      simp [Ex.eval, IState.top_eq g1]
    rw [e, Int.toNat_natCast] at hi ⊢
    exact (row_step d n m D Rest s hD hDw L1 L2 h1 h2 _ _ i hi).2

theorem attachP_spec (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d)
    (L1 L2 : List Item) (h0 : s.G 0 = ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) :
    (attachP d).ok s ∧ (attachP d).run s =
      (((s.upd 0 (ints (kflat n m D (n * m)) ++ Rest)).upd 42 (.int (n : ℤ) :: s.G 42)).upd 45
        (.int ((n * m * (d + 1) : ℕ) : ℤ) :: s.G 45)).upd 54 (.int ((n * m : ℕ) : ℤ) :: s.G 54) := by
  have H := outer_states d n m D Rest s hD hDw L1 L2 h1 h2
  have g1 : (outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
    rw [outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
      (by decide), h1]
  have e1 : (Ex.reg (S := HS) 1).eval (outerSt s D Rest n m d 0) = n := by
    simp [Ex.eval, IState.top_eq g1]
  have hz : (push 54 (.lit 0)).run ((push 45 (.lit 0)).run ((push 42 (.lit 0)).run s)) =
      outerSt s D Rest n m d 0 := by
    apply IState.ext' _ (by simp [outerSt]) (by simp [outerSt])
    intro x
    simp only [outerSt, IState.upd_G, run_push_G, Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0, kflat]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [kflat]
    split_ifs <;> simp_all
  have hloop : (outerLoop d).run (outerSt s D Rest n m d 0) = outerSt s D Rest n m d n := by
    rw [outerLoop, H.run, e1, Int.toNat_natCast]
  set t := outerSt s D Rest n m d n with ht
  have hkl := kflat_length n m d D hDw (n * m) (by omega)
  have t40 : t.G 40 = ints (kflat n m D (n * m)).reverse ++ s.G 40 := by simp [ht, outerSt]
  have t45 : t.G 45 = .int (((kflat n m D (n * m)).reverse.length : ℕ) : ℤ) :: s.G 45 := by
    simp [ht, outerSt, hkl]
  have hm := mvK_spec (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 45) (clean_of_lt (by decide)) t _ (s.G 40) t40
    (IState.isInt_of t45) (by simp [Ex.eval, IState.top_eq t45])
  refine ⟨⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩,
    ⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩,
    ⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩, ?_⟩
  · rw [hz]
    refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of g1) ?_, ?_⟩
    · intro i hi
      rw [e1, Int.toNat_natCast] at hi ⊢
      exact (row_step d n m D Rest s hD hDw L1 L2 h1 h2 _ _ i hi).1
    · rw [hloop]; exact hm.1
  · simp only [attachP, run_seq]
    rw [hz, hloop, hm.2]
    apply IState.ext' _ (by simp [ht, outerSt]) (by simp [ht, outerSt])
    intro x
    simp only [IState.upd_G]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [ht, outerSt, ints_reverse, ← hD]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true})
    simp only [if_neg x0, if_neg x40]
    rw [ht]
    by_cases x42 : x = 42
    · subst x42; simp (config := {decide := true}) [outerSt]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [outerSt]
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [outerSt]
    rw [outerSt_G_other _ _ _ _ _ _ _ _ x0 x40 x42 x45 x54]
    simp [x42, x45, x54]

theorem stripSt_G_other (s : IState HS) (S : List (List ℤ)) (Rest : List Item) (d q : ℕ)
    (x : Fin HS) (h0 : x ≠ 0) (h40 : x ≠ 40) (h45 : x ≠ 45) :
    (stripSt s S Rest d q).G x = s.G x := by
  simp [stripSt, h0, h40, h45]

theorem strip_step (d : ℕ) (S : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hS : ∀ r ∈ S, r.length = d + 1) (S0 : IState HS) (N0 q : ℕ) (hq : q < S.length) :
    (stripBody d).ok (withCtr 43 S0 N0 q (stripSt s S Rest d q)) ∧
    (stripBody d).run (withCtr 43 S0 N0 q (stripSt s S Rest d q)) =
      withCtr 43 S0 N0 q (stripSt s S Rest d (q + 1)) := by
  have hdr : S.drop q = S[q] :: S.drop (q + 1) := List.drop_eq_getElem_cons hq
  have htk : S.take (q + 1) = S.take q ++ [S[q]] := (List.take_concat_get' S q hq).symm
  have hlen : S[q].length = d + 1 := hS _ (List.getElem_mem hq)
  obtain ⟨a, r', hr⟩ : ∃ a r', S[q] = a :: r' := by
    rcases h : S[q] with _ | ⟨a, r'⟩
    · rw [h] at hlen; simp at hlen
    · exact ⟨a, r', rfl⟩
  have hlen' : r'.length = d := by rw [hr] at hlen; simpa using hlen
  generalize ht : withCtr 43 S0 N0 q (stripSt s S Rest d q) = t
  have tG : ∀ x, x ≠ 43 → t.G x = (stripSt s S Rest d q).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t0 : t.G 0 = .int a :: (ints r' ++ (ints (S.drop (q + 1)).flatten ++ Rest)) := by
    rw [tG 0 (by decide)]; simp only [stripSt, IState.upd_G]
    simp (config := {decide := true})
    rw [hdr, List.flatten_cons, hr]; simp [ints_append]
  have t45 : t.G 45 = .int ((q * d : ℕ) : ℤ) :: (s.G 45).tail := by
    rw [tG 45 (by decide)]; simp [stripSt]
  set t1 := (pop 0).run t with ht1
  have u0 : t1.G 0 = ints r' ++ (ints (S.drop (q + 1)).flatten ++ Rest) := by
    simp [ht1, t0]
  have hm := mvK_spec (X := 0) (Y := 40) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.lit d) (by intro x hx; simp [Ex.regs] at hx) t1
    r' _ u0 trivial (by simp [Ex.eval, hlen'])
  have v45 : ((t1.upd 0 (ints (S.drop (q + 1)).flatten ++ Rest)).upd 40
      ((ints r').reverse ++ t1.G 40)).G 45 = .int ((q * d : ℕ) : ℤ) :: (s.G 45).tail := by
    simp only [IState.upd_G, ht1, run_pop_G]; simp (config := {decide := true}) [t45]
  refine ⟨⟨⟨by decide, IState.isInt_of t0⟩, hm.1, ?_⟩, ?_⟩
  · rw [hm.2]
    refine ⟨by decide, ?_, ⟨IState.isInt_of v45, trivial⟩, IState.isInt_of v45⟩
    intro x hx; simp [Ex.regs] at hx; subst hx; decide
  · simp only [stripBody, run_seq]
    rw [← ht1, hm.2]
    apply run_ext _ (by simp [ht1]; rw [← ht]; simp [withCtr, stripSt])
      (by simp [ht1]; rw [← ht]; simp [withCtr, stripSt])
    intro x
    simp only [run_asg_G, IState.upd_G, Ex.eval, IState.top_eq v45]
    by_cases x43 : x = 43
    · subst x43
      simp (config := {decide := true}) [ht1]
      rw [← ht]; simp [withCtr]
    rw [withCtr_G_ne _ _ _ _ x43]
    by_cases x45 : x = 45
    · subst x45; simp [stripSt, v45, ht1, t45]; ring
    by_cases x0 : x = 0
    · subst x0; simp [stripSt]
    by_cases x40 : x = 40
    · subst x40
      simp (config := {decide := true}) [stripSt, ht1, tG 40 (by decide), htk, hr, ints_append,
        ints_reverse]
    simp only [if_neg x45, if_neg x0, if_neg x40, ht1, run_pop_G]
    rw [tG x x43, stripSt_G_other _ _ _ _ _ _ x0 x40 x45, stripSt_G_other _ _ _ _ _ _ x0 x40 x45]

theorem strip_states (d : ℕ) (S : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hS : ∀ r ∈ S, r.length = d + 1) (L54 : List Item) (h54 : s.G 54 = .int S.length :: L54) :
    RepStates 43 (.reg 54) (stripBody d) (stripSt s S Rest d 0) (stripSt s S Rest d) where
  nonneg := by
    have g : (stripSt s S Rest d 0).G 54 = .int S.length :: L54 := by
      rw [stripSt_G_other s S Rest d 0 54 (by decide) (by decide) (by decide), h54]
    simp [Ex.eval, IState.top_eq g]
  hw := by simp (config := {decide := true}) [stripBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [stripSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide),
      stripSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide)]
  step := by
    intro q hq
    have g : (stripSt s S Rest d 0).G 54 = .int S.length :: L54 := by
      rw [stripSt_G_other s S Rest d 0 54 (by decide) (by decide) (by decide), h54]
    have e : (Ex.reg (S := HS) 54).eval (stripSt s S Rest d 0) = S.length := by
      simp [Ex.eval, IState.top_eq g]
    rw [e, Int.toNat_natCast] at hq ⊢
    exact (strip_step d S Rest s hS _ _ q hq).2

theorem stripP_spec (d : ℕ) (S : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hS : ∀ r ∈ S, r.length = d + 1) (L54 : List Item) (h54 : s.G 54 = .int S.length :: L54)
    (h0 : s.G 0 = ints S.flatten ++ Rest) (h45 : s.IsInt 45) :
    (stripP d).ok s ∧ (stripP d).run s =
      (s.upd 0 (ints (S.map List.tail).flatten ++ Rest)).upd 45
        (.int ((S.length * d : ℕ) : ℤ) :: (s.G 45).tail) := by
  have H := strip_states d S Rest s hS L54 h54
  have g : (stripSt s S Rest d 0).G 54 = .int S.length :: L54 := by
    rw [stripSt_G_other s S Rest d 0 54 (by decide) (by decide) (by decide), h54]
  have e : (Ex.reg (S := HS) 54).eval (stripSt s S Rest d 0) = S.length := by
    simp [Ex.eval, IState.top_eq g]
  have hz : (asg 45 (.lit 0)).run s = stripSt s S Rest d 0 := by
    apply IState.ext' _ (by simp [stripSt]) (by simp [stripSt])
    intro x
    simp only [stripSt, IState.upd_G, run_asg_G, Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true})
    split_ifs <;> simp_all
  have hloop : (stripLoop d).run (stripSt s S Rest d 0) = stripSt s S Rest d S.length := by
    rw [stripLoop, H.run, e, Int.toNat_natCast]
  set t := stripSt s S Rest d S.length with ht
  have hfl : ((S.map List.tail).flatten).length = S.length * d := by
    rw [flatten_length_of (w := d)]
    · simp
    · intro r hr; simp only [List.mem_map] at hr; obtain ⟨r0, h0, rfl⟩ := hr
      simp [hS r0 h0]
  have t40 : t.G 40 = ints (S.map List.tail).flatten.reverse ++ s.G 40 := by
    simp [ht, stripSt]
  have t45 : t.G 45 = .int (((S.map List.tail).flatten.reverse.length : ℕ) : ℤ) ::
      (s.G 45).tail := by
    simp [ht, stripSt, hfl]
  have hm := mvK_spec (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 45) (clean_of_lt (by decide)) t _ (s.G 40) t40
    (IState.isInt_of t45) (by simp [Ex.eval, IState.top_eq t45])
  refine ⟨⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial, h45⟩, ?_⟩, ?_⟩
  · rw [hz]
    refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of g) ?_, ?_⟩
    · intro q hq
      rw [e, Int.toNat_natCast] at hq ⊢
      exact (strip_step d S Rest s hS _ _ q hq).1
    · rw [hloop]; exact hm.1
  · simp only [stripP, run_seq]
    rw [hz, hloop, hm.2]
    apply IState.ext' _ (by simp [ht, stripSt]) (by simp [ht, stripSt])
    intro x
    simp only [IState.upd_G]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [ht, stripSt, ints_reverse]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true})
    simp only [if_neg x0, if_neg x40]
    rw [ht]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [stripSt]
    rw [stripSt_G_other _ _ _ _ _ _ x0 x40 x45]
    simp [x45]

theorem sortW_spec (w kb : ℕ) (t : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L54 L3 : List Item)
    (h0 : t.G 0 = ints R.flatten ++ Rest) (h54 : t.G 54 = .int R.length :: L54)
    (h3 : t.G 3 = .int kb :: L3) :
    (sortW w).ok t ∧ (sortW w).run t = t.upd 0 (ints (radixSort kb R).flatten ++ Rest) := by
  set t1 := (push 2 (.reg 3)).run ((push 1 (.reg 54)).run t) with ht1
  have g0 : t1.G 0 = ints R.flatten ++ Rest := by
    simp only [ht1, run_push_G]; simp (config := {decide := true}) [h0]
  have g1 : t1.G 1 = .int R.length :: t.G 1 := by
    simp only [ht1, run_push_G]; simp (config := {decide := true}) [Ex.eval, IState.top_eq h54]
  have g3 : ((push 1 (.reg 54)).run t).G 3 = .int kb :: L3 := by
    simp only [run_push_G]; simp (config := {decide := true}) [h3]
  have g2 : t1.G 2 = .int kb :: t.G 2 := by
    simp only [ht1, run_push_G]
    simp (config := {decide := true}) [Ex.eval, IState.top_eq g3]
