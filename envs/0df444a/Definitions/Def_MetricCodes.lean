      youngClebschLower (loweredInternalYoungWeight lam a) lam
        (loweredInternalYoungWeight_sum_add_one lam a ha) a q⟫_ℝ =
      internalRowLowerGramScalar lam a * ⟪p, q⟫_ℝ := by
