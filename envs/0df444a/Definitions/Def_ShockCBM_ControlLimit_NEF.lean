-- title:
--   (1), (5) — natural exponential family on ℕ: natural parameter space Θ, log-partition A, damage pmf, k-fold convolution, conjugate density
-- statement:
--   Let $h:\mathbb N\to\mathbb R$ be a family of base weights. The **natural exponential family** on $\mathbb N$ generated by $h$ consists of the following objects.
--
--   1. The **natural parameter space**
--   $$\Theta=\Big\{\phi\in\mathbb R:\ \sum_{y\in\mathbb N}h(y)e^{\phi y}<\infty\Big\},$$
--   where the series is required to be summable.
--   2. The **log-partition function** $A(\phi)=\log\sum_{y\in\mathbb N}h(y)e^{\phi y}$.
--   3. The **damage pmf** of (1) with sufficient statistic $T(y)=y$:
--   $$f(y\mid\phi)=h(y)\,e^{\phi y-A(\phi)},\qquad y\in\mathbb N .$$
--   4. Its **$k$-fold convolution** $f^{(k)}(z\mid\phi)$, defined recursively by $f^{(0)}(z\mid\phi)=\mathbf 1\{z=0\}$ and
--   $$f^{(k+1)}(z\mid\phi)=\sum_{j=0}^{z}f^{(k)}(j\mid\phi)\,f(z-j\mid\phi).$$
--   5. The **conjugate density** (5) with hyperparameters $(a,b)$:
--   $$f_\Phi(\phi\mid a,b)=H(a,b)\,e^{a\phi-bA(\phi)}\,\mathbf 1\{\phi\in\Theta\},\qquad H(a,b)=\Big(\int_\Theta e^{a\psi-bA(\psi)}\,d\psi\Big)^{-1},$$
--   together with the predicate that $e^{a\phi-bA(\phi)}$ is integrable on $\Theta$ with a positive integral, which makes $f_\Phi(\cdot\mid a,b)$ a probability density.
--
--   For $\phi\in\Theta$ with $h\ge 0$ not identically zero, $f(\cdot\mid\phi)$ is a probability mass function on $\mathbb N$ and $f^{(k)}(\cdot\mid\phi)$ is the law of the sum of $k$ independent draws from it. These objects describe the random damage of one shock in a cumulative shock degradation model and the Bayesian prior on its parameter.
--
--   **Formalization Note** The paper allows damages with a density on $\mathbb R_+$; this formalization restricts to integer valued damages, as the paper's MDP and numerical sections do. $A$ is defined as the log-partition function rather than taken as a free "known function". Outside $\Theta$ Lean's `tsum` and `Real.log` return junk values, so the conjugate density carries the indicator of $\Theta$ and the normaliser is written explicitly as the reciprocal of the integral over $\Theta$.
-- source:
--   Drent, Drent, Arts, Kapodistria, Real-Time Integrated Learning and Decision Making for Cumulative Shock Degradation, Manufacturing & Service Operations Management 25(1) (2023), doi:10.1287/msom.2022.1149, accepted manuscript, p. 8, (1); p. 10, (5); p. 11, Lemma 1 (k-fold convolution)

import Mathlib

namespace ShockCBM.ControlLimit

open MeasureTheory

/-- The natural parameter space `Θ = {φ | ∑_y h(y) e^{φ y} < ∞}` of the natural exponential
family on `ℕ` with base weights `h`. -/
def natParamSpace (h : ℕ → ℝ) : Set ℝ :=
  {φ : ℝ | Summable (fun y : ℕ => h y * Real.exp (φ * y))}

/-- The log-partition function `A(φ) = log ∑_y h(y) e^{φ y}`. -/
noncomputable def logPartition (h : ℕ → ℝ) (φ : ℝ) : ℝ :=
  Real.log (∑' y : ℕ, h y * Real.exp (φ * y))

/-- The damage pmf (1) with sufficient statistic `T(y) = y`: `f(y | φ) = h(y) e^{φ y − A(φ)}`. -/
noncomputable def damagePMF (h : ℕ → ℝ) (φ : ℝ) (y : ℕ) : ℝ :=
  h y * Real.exp (φ * y - logPartition h φ)

/-- The `k`-fold convolution `f^{(k)}(z | φ)` of the damage pmf, by recursion on `k`;
`f^{(0)}` is the point mass at `0`. -/
noncomputable def conv (h : ℕ → ℝ) (φ : ℝ) : ℕ → ℕ → ℝ
  | 0, z => if z = 0 then 1 else 0
  | k + 1, z => ∑ j ∈ Finset.range (z + 1), conv h φ k j * damagePMF h φ (z - j)

/-- The unnormalised conjugate kernel `e^{a φ − b A(φ)}` of (5). -/
noncomputable def conjKernel (h : ℕ → ℝ) (a b φ : ℝ) : ℝ :=
  Real.exp (a * φ - b * logPartition h φ)

/-- The conjugate prior density (5), `f_Φ(φ | a, b) = H(a, b) e^{a φ − b A(φ)}` on `Θ` and `0` off
`Θ`, with the normaliser `H(a, b) = 1 / ∫_Θ e^{a ψ − b A(ψ)} dψ`. -/
noncomputable def conjDensity (h : ℕ → ℝ) (a b φ : ℝ) : ℝ :=
  Set.indicator (natParamSpace h) (conjKernel h a b) φ /
    ∫ ψ in natParamSpace h, conjKernel h a b ψ

/-- The conjugate kernel at `(a, b)` is integrable on `Θ` with positive integral, so that
`conjDensity h a b` is a probability density. -/
def ConjNormalizable (h : ℕ → ℝ) (a b : ℝ) : Prop :=
  IntegrableOn (conjKernel h a b) (natParamSpace h) ∧
    0 < ∫ ψ in natParamSpace h, conjKernel h a b ψ

end ShockCBM.ControlLimit


