set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

/-! ## Relocation -/

/-! ## Gaussian lists -/

/-! ## The encoding loop -/

def encL : RM := .seq (.rep C0 (.reg NN) encP) (.rs (mvList EO XD C2 (.reg NN)))

/-- The residue of one block. -/
def encRes (P r : ℕ) (blk : List (ℤ × ℤ)) : ℤ := Ref.encBlk P r blk % (2 ^ (4 * r * P) + 1)

def eSt (P r : ℕ) (s : IState HS) (Bl : List (List (ℤ × ℤ))) (RU : List Item) (k : ℕ) :
    IState HS :=
