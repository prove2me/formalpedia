section Data

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S : Type} [CommRing S]

structure L1aData (E : FakeEllipticCurve Λ N₀ S) (N : ℕ) where
  Z₀ : Scheme.{0}
  ζ₀ : Z₀ ⟶ Spec (CommRingCat.of S)
  fin : IsFinite ζ₀
  et : Etale ζ₀
  pt : Pk.PtZ (E.L.schemeKerStr N) Z₀
  h1 : Pk.Law1 ζ₀ pt
  h2 : Pk.Law2 pt
  h3 : Pk.Law3 ζ₀ pt
  h4 : Pk.Law4 pt

variable {E : FakeEllipticCurve Λ N₀ S} {N : ℕ} (D : L1aData E N)

scoped instance : IsFinite D.ζ₀ := D.fin
scoped instance : Etale D.ζ₀ := D.et
scoped instance : IsAffine D.Z₀ := isAffine_of_isAffineHom D.ζ₀

abbrev kNC : (EC E D.ζ₀).L.schemeKer N ⟶ E.L.schemeKer N :=
  kN (algebraMap S (C D.ζ₀)) E (EC E D.ζ₀) (gC E D.ζ₀) (gC_via E D.ζ₀) N

abbrev zU : Spec (CommRingCat.of (C D.ζ₀)) ⟶ D.Z₀ := (Aff.eX D.ζ₀).inv

theorem zU_over : zU D ≫ D.ζ₀ = Spec.map (CommRingCat.ofHom (algebraMap S (C D.ζ₀))) := Aff.eX_inv_p D.ζ₀

theorem univClopen_spec : ∃ (U : ((EC E D.ζ₀).L.schemeKer N).Opens) (hU : IsClosed (U : Set ↥((EC E D.ζ₀).L.schemeKer N))),
    D.pt (C D.ζ₀) (algebraMap S (C D.ζ₀)) _ ((EC E D.ζ₀).L.schemeKerStr N) (kNC D)
      (kN_isPullback _ E _ _ (gC_via E D.ζ₀) N) U hU = zU D :=
  D.h3 (C D.ζ₀) (algebraMap S (C D.ζ₀)) _ ((EC E D.ζ₀).L.schemeKerStr N) (kNC D)
    (kN_isPullback _ E _ _ (gC_via E D.ζ₀) N) (zU D) (zU_over D)

def 𝒰 : ((EC E D.ζ₀).L.schemeKer N).Opens := (univClopen_spec D).choose
theorem 𝒰_closed : IsClosed (𝒰 D : Set ↥((EC E D.ζ₀).L.schemeKer N)) := (univClopen_spec D).choose_spec.choose
theorem 𝒰_pt : D.pt (C D.ζ₀) (algebraMap S (C D.ζ₀)) _ ((EC E D.ζ₀).L.schemeKerStr N) (kNC D)
    (kN_isPullback _ E _ _ (gC_via E D.ζ₀) N) (𝒰 D) (𝒰_closed D) = zU D :=
  (univClopen_spec D).choose_spec.choose_spec

theorem key_transfer {T : Type} [CommRing T] (φ : S →+* T) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g)
    (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N)))
    (θ : C D.ζ₀ →+* T) (hθ : θ.comp (algebraMap S (C D.ζ₀)) = φ)
    (hz : D.pt T φ _ (E'.L.schemeKerStr N) (kN φ E E' g hg N) (kN_isPullback φ E E' g hg N) U' hU' =
      Spec.map (CommRingCat.ofHom θ) ≫ zU D) :
    kN θ (EC E D.ζ₀) E' (kA E D.ζ₀ φ E' g hg θ hθ) (kA_via E D.ζ₀ φ E' g hg θ hθ) N ⁻¹ᵁ (𝒰 D) = U' := by
  set kN' := kN θ (EC E D.ζ₀) E' (kA E D.ζ₀ φ E' g hg θ hθ) (kA_via E D.ζ₀ φ E' g hg θ hθ) N with hkN'def
  have hfac : kN' ≫ kNC D = kN φ E E' g hg N := kN_factor E D.ζ₀ φ E' g hg θ hθ N
  have h' : IsPullback (kN' ≫ kNC D) (E'.L.schemeKerStr N) (E.L.schemeKerStr N)
      (Spec.map (CommRingCat.ofHom (θ.comp (algebraMap S (C D.ζ₀))))) := by
    rw [hfac, hθ]; exact kN_isPullback φ E E' g hg N
  have hcl : IsClosed ((kN' ⁻¹ᵁ 𝒰 D : (E'.L.schemeKer N).Opens) : Set ↥(E'.L.schemeKer N)) :=
    (𝒰_closed D).preimage kN'.continuous
  have step := D.h2 (C D.ζ₀) T (algebraMap S (C D.ζ₀)) θ _ ((EC E D.ζ₀).L.schemeKerStr N) (kNC D)
    (kN_isPullback _ E _ _ (gC_via E D.ζ₀) N) _ (E'.L.schemeKerStr N) (kN' ≫ kNC D) h' kN'
    (kN_isPullback θ (EC E D.ζ₀) E' _ (kA_via E D.ζ₀ φ E' g hg θ hθ) N).w rfl (𝒰 D) (𝒰_closed D)
    (kN' ⁻¹ᵁ 𝒰 D) hcl rfl
  rw [𝒰_pt] at step

  apply D.h4 T φ _ (E'.L.schemeKerStr N) (kN φ E E' g hg N) (kN_isPullback φ E E' g hg N) _ _ hcl hU'
  rw [hz, ← step]
  exact (Pk.pt_congr D.pt T hθ _ (E'.L.schemeKerStr N) hfac h' (kN_isPullback φ E E' g hg N) _ hcl).symm

end Data
