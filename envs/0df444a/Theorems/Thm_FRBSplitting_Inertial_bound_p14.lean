-- title:
--   Proof of Theorem 4.3, p. 14 — βε‖x_{k+1} − x‖² + εΣ‖x_{i+1} − x_i‖² is bounded by the initial energy
-- statement:
--   In the setting of Lemma 4.2 — $A$ monotone with resolvents $J_{\gamma A}$, $B$ monotone, $B'=B-\frac\alpha\lambda I$ $L'$-Lipschitz, $x\in(A+B)^{-1}(0)$, $(x_k),(z_k)$ generated by (34), $b_k=2\lambda\langle B(x)-B(x_k),x-x_k\rangle$ — assume moreover $\alpha\in[0,1)$, $\beta\in(0,1]$, $\lambda>0$ and
--
--   $$\varepsilon:=\min\Big\{\frac{2-\beta(1+\alpha)}{2},\frac{1-\alpha}{\beta}\Big\}-\lambda L'>0 .$$
--
--   Then for every $k\in\mathbb N$
--
--   $$\beta\varepsilon\|x_{k+1}-x\|^2+\varepsilon\sum_{i=1}^{k}\|x_{i+1}-x_i\|^2\le(1-\alpha)\|x_0-x\|^2+2\lambda\langle B'(x_0)-B'(x_{-1}),x-x_0\rangle+b_0+\frac{\lambda L'}{\beta}\|x_0-x_{-1}\|^2 .$$
--
--   The right-hand side depends only on the initial points, so this bound shows that $(x_k)$ is bounded and that $\|x_k-x_{k+1}\|\to0$.
--
--   **Formalization Note.** Index shift: paper $x_{k+1}$ is `x (k+2)`, paper $x_0$, $x_{-1}$ are `x 1`, `x 0`, and the sum over $i=1,\dots,k$ is over `Finset.Icc 1 k` of `‖x (i+2) - x (i+1)‖²`. The sum starts at $i=1$ as printed (the $i=0$ term could be included; the printed form is weaker). $A$ is only assumed monotone and $H$ need not be complete.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 14, proof of Theorem 4.3, display after (44)

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_Inertial_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.Inertial

theorem bound_p14 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B : H → H) (J : ℝ → H → H) (α β lam L' : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B)
    (hα : 0 ≤ α) (hα1 : α < 1) (hβ : 0 < β) (hβ1 : β ≤ 1) (hlam : 0 < lam)
    (hL' : IsLipschitzOp L' (shiftOp B (α / lam)))
    (hε : 0 < min ((2 - β * (1 + α)) / 2) ((1 - α) / β) - lam * L')
    (x z : ℕ → H) (hrun : IsRelaxedInertialRun J B α β lam x z)
    (xs : H) (hxs : xs ∈ FRBSplitting.Weak.zeroSet A B) :
    ∀ k : ℕ,
      β * (min ((2 - β * (1 + α)) / 2) ((1 - α) / β) - lam * L') * ‖x (k + 2) - xs‖ ^ 2
          + (min ((2 - β * (1 + α)) / 2) ((1 - α) / β) - lam * L')
            * ∑ i ∈ Finset.Icc 1 k, ‖x (i + 2) - x (i + 1)‖ ^ 2 ≤
        (1 - α) * ‖x 1 - xs‖ ^ 2
          + 2 * lam * ⟪shiftOp B (α / lam) (x 1) - shiftOp B (α / lam) (x 0), xs - x 1⟫_ℝ
          + 2 * lam * ⟪B xs - B (x 1), xs - x 1⟫_ℝ
          + lam * L' / β * ‖x 1 - x 0‖ ^ 2 := by sorry

end FRBSplitting.Inertial
