  have h3 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d4 (ys + u * (y - ys)) * (y - ys) ^ 3)
      (j.d5 (ys + u * (y - ys)) * (y - ys) ^ (3 + 1)) u := by
    intro u hu
