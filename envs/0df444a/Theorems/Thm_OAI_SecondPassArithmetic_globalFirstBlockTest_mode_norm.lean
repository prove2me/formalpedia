theorem OAI.SecondPassArithmetic.globalFirstBlockTest_mode_norm (g V : 𝓢(ℝ,ℂ)) (ell : ℝ) (side : Bool)
    (t : ℝ) (b : GlobalFirstData ι) (G : Finset ι) :
    ‖globalFirstBlockTest p (firstCoreModeProfile g V side t) ell side b G‖ =
      ‖globalFirstBlockTest p (firstCoreBaseProfile g V side) ell side b G‖ := by sorry
