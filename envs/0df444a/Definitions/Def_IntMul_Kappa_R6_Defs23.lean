-- Source module: Solutions.R6IL3Top12
/-!
# Round six, item language (I3): the parameter facts of the uniform Proposition 14

Under the hypotheses of `P14NeedH'` (bundled in `Hyp14`, with guard `EwH c` and
`K₀ = K0c c = 2^{Zc c}`), the chain values `chV c (cWc c) P K D S r w` satisfy:

* `Zc c ≤ K`, `K + 5 < Z` (so every configuration constant is below `Z`);
* `Zl ≤ 2 Z + W'`, `Zl ≤ 2 p + W' + 5`, `G ≤ 2 zsz p + 2 W' + 10`;
* the field-width guards `4 Zl (Zl+2) ≤ 2^G`, `16 Zl (Zl+2) 2^G ≤ 2^K`;
* the chunk bound `cW d + 2 ⌊D/m⌋ G ≤ K D`;
* the kernel count `K (q₀ + q_B) ≤ K₀ D (zsz p + 1) + 2 K`;
* the width/exponent bounds of the body.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The size of all configuration constants. -/
noncomputable def Zc (c : Cfg) : ℕ :=
  c.Wr + c.W + c.Aw + c.p + cLH c + c.m + Sc c + c.Aw * (2 * c.m + 1) ^ c.p + 64

/-- The constant `K₀` of the uniform Proposition 14. -/
noncomputable def K0c (c : Cfg) : ℕ := 2 ^ Zc c

/-- The width exponent of the padding `W ≤ 2^cW`. -/
def cWc (c : Cfg) : ℕ := Nat.clog 2 c.W

/-- **The hypotheses of `P14NeedH'`** at guard `EwH c`, `K₀ = K0c c` (with `vol = P 2^{KD} S`). -/
structure Hyp14 (c : Cfg) (P K D S r p w Z : ℕ) (lamp : ℝ) : Prop where
  K6 : 6 ≤ K
  r1 : 1 ≤ r
  KZ : 80 * Z * (Z + 2) ≤ 2 ^ K
  S1 : 1 ≤ S
  P1 : 1 ≤ P
  D1 : 1 ≤ D
  Z32 : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z
  pZ : zsz (p : ℤ) ≤ Z
  Ew : EwH c D ≤ w + 1
  wZ : w + EwH c D + 2 < 2 ^ Z
  rZ : 2 * (2 * Z + 4) ^ 3 + 2 ≤ r
  h1 : zsz ((P * 2 ^ (K * D) * S * r + w + EwH c D : ℕ) : ℤ) ≤ p
  h2 : (p + K0c c) ^ 5 ≤ 2 ^ K
  h3 : ((K0c c * D * (zsz (p : ℤ) + 1) : ℕ) : ℝ) ≤ K * (D : ℝ) ^ lamp
  l0 : 0 ≤ lamp
  l1 : lamp ≤ 1

namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

end Hyp14

namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

end Hyp14

end IntMul.Kappa.R6.IL3H

end

