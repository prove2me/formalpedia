-- title:
--   Independent rested reward sequences and their induced history law
-- statement:
--   A rested reward environment is a probability law on a table $X_i(s)$, with finitely many arms and countably many local reward indices. Its general interface imposes no serial independence. The separate independence predicate requires the entire sequences of distinct arms to be mutually independent.
--
--   When the policy selects arm $i$ after $t$ completed rounds, the next observed reward is
--   $$Y(t+1)=X_i(N_i(t)+1).$$
--   The joint law is built recursively by retaining the sampled table, drawing the next action from the published history kernel, and appending the revealed reward to the history. Its marginal is the process interaction law $\mathbb P_{\nu\pi}$; rewards are not resampled from marginal distributions. The file proves measurability of the reveal map and that these induced laws are probability measures.
--
--   This interface allows dependent, nonstationary arm sequences without imposing a change-of-measure construction. It also defines histories generated by a fixed table and action sequence, and compatible policy paths with nonzero conditional probabilities. **Formalization Note** Arms and local reward indices start at zero; a law on the canonical table space represents the joint law of any collection of measurable real reward sequences.
-- source:
--   Fan and Glynn, The Fragility of Optimized Bandit Algorithms, arXiv:2109.13595v8, p.7, history kernels; p.20, rested independent arms

import Mathlib
import Definitions.Def_BanditPolicy

set_option autoImplicit false

namespace FragileBandit.CauchyTail.Supplement

open MeasureTheory ProbabilityTheory BanditAlgorithm

/-- A table of potential rewards, indexed by arm and local pull number, starting at zero. -/
abbrev RewardTable (K : ℕ) := Fin K → ℕ → ℝ

/-- A general rested environment. Serial dependence is unrestricted. Independence between
arms is a separate predicate, rather than part of the general probability-law interface. -/
structure RestedEnvironment (K : ℕ) where
  law : Measure (RewardTable K)
  probability : IsProbabilityMeasure law

attribute [instance] RestedEnvironment.probability

/-- The complete reward sequences of distinct arms are independent. -/
def IndependentArms {K : ℕ} (ν : RestedEnvironment K) : Prop :=
  iIndepFun (fun i (x : RewardTable K) => x i) ν.law

/-- One step retains the table and reveals the next unused reward of the selected arm. -/
def reveal {K n : ℕ} (p : (RewardTable K × BanditHistory K n) × Fin K) :
    RewardTable K × BanditHistory K (n + 1) :=
  (p.1.1, Fin.snoc p.1.2 (p.2, p.1.1 p.2 (armPullCount p.2 p.1.2)))

/-- Counts depend on the finite action coordinates only. -/
lemma measurable_count {K n : ℕ} (i : Fin K) :
    Measurable (fun h : BanditHistory K n => armPullCount i h) := by
  let f : (Fin n → Fin K) → ℕ := fun b => (Finset.univ.filter (fun t => b t = i)).card
  have hf : Measurable f := measurable_of_finite f
  have hh : Measurable (fun h : BanditHistory K n => fun t => (h t).1) :=
    measurable_pi_lambda _ (fun t => measurable_fst.comp (measurable_pi_apply t))
  simpa [f, Function.comp_def, armPullCount, Set.toFinset_ofPred] using hf.comp hh

/-- Revealing a reward is a measurable map, so Measure.map cannot return its junk zero. -/
lemma measurable_reveal {K n : ℕ} : Measurable (@reveal K n) := by
  have hc : Measurable (fun p : (RewardTable K × BanditHistory K n) × Fin K =>
      armPullCount p.2 p.1.2) :=
    measurable_from_prod_countable_left (fun i => (measurable_count i).comp measurable_snd)
  have he : Measurable (fun p : RewardTable K × (Fin K × ℕ) => p.1 p.2.1 p.2.2) :=
    measurable_from_prod_countable_left (fun q =>
      (measurable_pi_apply q.2).comp (measurable_pi_apply q.1))
  have hr := he.comp (measurable_fst.fst.prodMk (measurable_snd.prodMk hc))
  exact measurable_fst.fst.prodMk
    (measurable_banditHistorySnoc.comp (measurable_fst.snd.prodMk (measurable_snd.prodMk hr)))

/-- The joint law of the table and the observed history, constructed from the policy kernels.
The table is sampled once, not independently resampled in later rounds. -/
noncomputable def processJointMeasure {K : ℕ} (ν : RestedEnvironment K)
    (π : BanditPolicy K) : (n : ℕ) → Measure (RewardTable K × BanditHistory K n)
  | 0 => ν.law.map (fun x => (x, fun t => t.elim0))
  | n + 1 =>
    ((processJointMeasure ν π n).compProd
      ((π.select n).comap Prod.snd measurable_snd)).map reveal

/-- The induced observable history law P_{νπ}, with rested sampling. -/
noncomputable def processMeasure {K : ℕ} (ν : RestedEnvironment K)
    (π : BanditPolicy K) (n : ℕ) : Measure (BanditHistory K n) :=
  (processJointMeasure ν π n).map Prod.snd

instance processJointMeasure.probability {K : ℕ} (ν : RestedEnvironment K)
    (π : BanditPolicy K) (n : ℕ) : IsProbabilityMeasure (processJointMeasure ν π n) := by
  induction n with
  | zero =>
    unfold processJointMeasure
    apply Measure.isProbabilityMeasure_map
    exact (measurable_id.prodMk (measurable_pi_lambda _ (fun t => t.elim0))).aemeasurable
  | succ n ih =>
    rw [processJointMeasure]
    exact Measure.isProbabilityMeasure_map measurable_reveal.aemeasurable

instance processMeasure.probability {K : ℕ} (ν : RestedEnvironment K)
    (π : BanditPolicy K) (n : ℕ) : IsProbabilityMeasure (processMeasure ν π n) :=
  Measure.isProbabilityMeasure_map measurable_snd.aemeasurable

/-- The first n local rewards of an arm, before adaptive sampling. -/
def rewardSum {K : ℕ} (x : RewardTable K) (i : Fin K) (n : ℕ) : ℝ :=
  ∑ s ∈ Finset.range n, x i s

/-- History generated by a table and an infinite sequence of actions. -/
def realizedHistory {K : ℕ} (x : RewardTable K) (a : ℕ → Fin K) (n : ℕ) :
    BanditHistory K n :=
  fun t => (a t, x (a t) ((Finset.range t.val).filter (fun s => a s = a t)).card)

/-- A possible policy path: at every round its action has nonzero conditional probability. -/
def IsPolicyPath {K : ℕ} (π : BanditPolicy K) (x : RewardTable K) (a : ℕ → Fin K) : Prop :=
  ∀ n, π.select n (realizedHistory x a n) {a n} ≠ 0

end FragileBandit.CauchyTail.Supplement


