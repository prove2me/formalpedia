              c0 * f0 W + ((1 / 2 : ℝ) * f1 W +
                (1 / Real.sqrt 2 : ℝ) * f2 W)) =
              (∫ W : ℝ in Set.Icc V (x / U), c0 * f0 W) +
                ∫ W : ℝ in Set.Icc V (x / U),
