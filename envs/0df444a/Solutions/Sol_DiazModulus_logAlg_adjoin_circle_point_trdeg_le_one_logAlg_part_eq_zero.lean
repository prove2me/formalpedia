import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_transcendental_add_mul_add_mul_conj
import Theorems.Thm_DiazModulus_isAlgebraic_of_mem_of_isAlgebraic_adjoin_transcendental
import Theorems.Thm_DiazModulus_hermite_lindemann_holds

open Complex ComplexConjugate

/-! # In transcendence degree one, `ℚ[S]` meets `ℒ` only in `0` once it holds a point off `ℒ`

Let `F` be the field generated by `ℒ̃`, `u` transcendental over `F` with `u ū` algebraic, and
`ℚ[S]` of transcendence degree at most one. Suppose `e = c + p u + q ū ∈ ℚ[S]` with `c ∈ ℒ` and
`(p, q) ≠ (0, 0)`. Algebraic numbers, rationals and `ℒ` all lie in `F`, so
`transcendental_add_mul_add_mul_conj` makes `e` transcendental over `F`, hence over `ℚ`. In a
ring of transcendence degree at most one, every element is algebraic over `ℚ(e)` for any
transcendental `e` in it: otherwise it would form with `e` an algebraically independent pair, two
elements against the bound. So `w ∈ ℒ ∩ ℚ[S]` is algebraic over `ℚ(e)`; since `w ∈ F` and `e` is
transcendental over `F`, `isAlgebraic_of_mem_of_isAlgebraic_adjoin_transcendental` makes `w`
algebraic over `ℚ`. Then `e^w` is algebraic with `w` algebraic, and Hermite–Lindemann forces
`w = 0`. -/

namespace R19_T1
open DiazModulus

/-- In `ℚ[S] ⊆ ℂ` of transcendence degree at most one, every element is algebraic over `ℚ(ω)`,
for any transcendental `ω ∈ ℚ[S]`. -/
lemma isAlgebraic_of_trdeg_le_one (S : Set ℂ) (htr : Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ S) ≤ 1)
    {ω z : ℂ} (hωS : ω ∈ Algebra.adjoin ℚ S) (hzS : z ∈ Algebra.adjoin ℚ S)
    (hω : Transcendental ℚ ω) :
    IsAlgebraic (IntermediateField.adjoin ℚ ({ω} : Set ℂ)) z := by
  rw [IntermediateField.isAlgebraic_adjoin_iff]
  by_contra hz
  have hind : AlgebraicIndependent ℚ (fun _ : Unit => ω) :=
    (algebraicIndependent_singleton_iff ()).2 hω
  have htrans : Transcendental (Algebra.adjoin ℚ (Set.range fun _ : Unit => ω)) z := by
    rw [Set.range_const]
    exact hz
  have hopt := (hind.option_iff_transcendental z).2 htrans
  let v : Option Unit → Algebra.adjoin ℚ S := fun o => o.elim ⟨z, hzS⟩ (fun _ => ⟨ω, hωS⟩)
  have hv : AlgebraicIndependent ℚ v := by
    refine AlgebraicIndependent.of_comp (Algebra.adjoin ℚ S).val ?_
    convert hopt using 1
    funext o
    cases o <;> rfl
  have hcard := hv.cardinalMk_le_trdeg
  rw [show Cardinal.mk (Option Unit) = 2 by simp] at hcard
  have := hcard.trans htr
  norm_num at this

/-- Algebraic numbers lie in the field generated by `ℒ̃`. -/
lemma mem_closure_of_isAlgebraic {a : ℂ} (ha : IsAlgebraic ℚ a) :
    a ∈ Subfield.closure (LogAlgTilde : Set ℂ) := by
  apply Subfield.subset_closure
  have h1 : (1 : ℂ) ∈ LogAlgTilde := Submodule.subset_span (Set.mem_insert _ _)
  have := LogAlgTilde.smul_mem (⟨a, mem_Qbar_iff.2 ha⟩ : Qbar) h1
  simpa [Subfield.smul_def] using this

/-- `ℒ` lies in the field generated by `ℒ̃`. -/
lemma mem_closure_of_mem_logAlg {c : ℂ} (hc : c ∈ LogAlg) :
    c ∈ Subfield.closure (LogAlgTilde : Set ℂ) :=
  Subfield.subset_closure (Submodule.subset_span (Set.mem_insert_of_mem _ hc))

end R19_T1

open DiazModulus R19_T1 in
theorem solution
    (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u)
    (S : Set ℂ) (htr : Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ S) ≤ 1)
    (c : ℂ) (p q : ℚ) (hc : c ∈ LogAlg) (hpq : p ≠ 0 ∨ q ≠ 0)
    (he : c + (p : ℂ) * u + (q : ℂ) * conj u ∈ Algebra.adjoin ℚ S)
    (w : ℂ) (hw : w ∈ LogAlg) (hwS : w ∈ Algebra.adjoin ℚ S) :
    w = 0 := by
  set F := Subfield.closure (LogAlgTilde : Set ℂ) with hF
  -- `e = c + p u + q ū` is transcendental over `F`
  have hpq' : (p : ℂ) ≠ 0 ∨ (q : ℂ) ≠ 0 := by
    rcases hpq with h | h
    · exact Or.inl (by exact_mod_cast h)
    · exact Or.inr (by exact_mod_cast h)
  have heF : Transcendental F (c + (p : ℂ) * u + (q : ℂ) * conj u) :=
    DiazModulus.transcendental_add_mul_add_mul_conj F u hu (mem_closure_of_isAlgebraic hρ) c p q
      (mem_closure_of_mem_logAlg hc) (SubfieldClass.ratCast_mem F p)
      (SubfieldClass.ratCast_mem F q) hpq'
  -- hence over `ℚ`
  have heQ : Transcendental ℚ (c + (p : ℂ) * u + (q : ℂ) * conj u) := fun h =>
    heF (h.tower_top F)
  -- `w` is algebraic over `ℚ(e)`, hence over `ℚ`
  have hwe := isAlgebraic_of_trdeg_le_one S htr he hwS heQ
  have hwalg : IsAlgebraic ℚ w :=
    DiazModulus.isAlgebraic_of_mem_of_isAlgebraic_adjoin_transcendental F _ w heF
      (mem_closure_of_mem_logAlg hw) hwe
  -- Hermite–Lindemann
  by_contra hw0
  exact DiazModulus.hermite_lindemann_holds w hw0 hwalg hw
