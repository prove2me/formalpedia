namespace QEC.Coding.FiberBundle
theorem _root_.solution
    {r typeCount ell : Nat}
    [NeZero typeCount] [NeZero ell] [NeZero (ell - 1)]
    (baseSample : RandomBase.Sample r)
    (twistSample : RandomTwist.Sample r typeCount ell)
    (u : Word (ZMod 2)
      (C0Index (Fin (3 * r)) (ZMod (ell * ell))))
    (a a' : Fin (3 * r)) :
    HammingWeight
        (verticalFiber
          (bundleCoboundary
            (RandomTwist.fiberBundleData baseSample twistSample)
            (eraseC0Fiber u a)) a') ≤
      HammingWeight
        (verticalFiber
          (bundleCoboundary
            (RandomTwist.fiberBundleData baseSample twistSample) u) a') := by
  by_cases ha : a' = a
  · subst a'
    have hFiberZero :
        verticalFiber
            (bundleCoboundary
              (RandomTwist.fiberBundleData baseSample twistSample)
              (eraseC0Fiber u a)) a = 0 := by
      rw [verticalFiber_bundleCoboundary_fiberBundleData,
        c0Fiber_eraseC0Fiber_same]
      funext j
      simp [cycleFiberCoboundary]
    rw [hFiberZero, HammingWeight_zero]
    exact Nat.zero_le _
  · have hFiberEq :
        verticalFiber
            (bundleCoboundary
              (RandomTwist.fiberBundleData baseSample twistSample)
              (eraseC0Fiber u a)) a' =
          verticalFiber
            (bundleCoboundary
              (RandomTwist.fiberBundleData baseSample twistSample) u) a' := by
      rw [verticalFiber_bundleCoboundary_fiberBundleData,
        verticalFiber_bundleCoboundary_fiberBundleData,
        c0Fiber_eraseC0Fiber_of_ne u ha]
    rw [hFiberEq]
end QEC.Coding.FiberBundle
