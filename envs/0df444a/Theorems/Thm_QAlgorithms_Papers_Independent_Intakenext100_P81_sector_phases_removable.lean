-- title:
--   Vacuum-sector phases can be removed without changing local transformations
-- statement:
--   Let $G$ be a Lie group acting on a nonempty set $B$ of vacuum labels. In a complex Hilbert space $\mathcal H$, let $\Omega_b$ be normalized vacua and let $\mathcal A$ be the unital algebra generated by local operators. Write $\mathcal H_b=\overline{\mathcal A\Omega_b}$. Assume that these sectors are mutually orthogonal and their algebraic sum is dense in $\mathcal H$. Let $U(g)$ be unitaries which preserve $\mathcal A$ under conjugation, whose conjugation action on $\mathcal A$ obeys the group law, and such that $U(g)\Omega_b=c(g,b)\Omega_{gb}$ with $|c(g,b)|=1$. Then there is a unitary group homomorphism $\widetilde U$ such that
--
--   $$\widetilde U(g)v=\overline{c(g,b)}U(g)v\quad(v\in\mathcal H_b),\qquad \widetilde U(g)^\dagger O\widetilde U(g)=U(g)^\dagger OU(g)\quad(O\in\mathcal A).$$
--
--   In particular $\widetilde U(g)\Omega_b=\Omega_{gb}$. The Hilbert direct sum has countable support even when $B$ is uncountable. Additional gauge-charged sectors are excluded by the dense-sector hypothesis. This removes the sector phases; it does not assert strong continuity of the improved homomorphism.
-- source:
--   Symmetries in quantum field theory and quantum gravity, arXiv:1810.05338v2, PDF p. 137, Appendix B: remove superselection-dependent phases

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P81

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakenext100.P81

open scoped BigOperators ComplexConjugate Manifold ContDiff

section Hilbert

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [hilbertComplete : CompleteSpace H]

section Lie

variable {m : ℕ} {G : Type*} [Group G] [TopologicalSpace G]
  [lieCharts : ChartedSpace (EuclideanSpace ℝ (Fin m)) G]
  [lieSmooth : LieGroup 𝓘(ℝ, EuclideanSpace ℝ (Fin m)) ∞ G]
  [lieHausdorff : T2Space G] [lieSecondCountable : SecondCountableTopology G]

include hilbertComplete lieCharts lieSmooth lieHausdorff lieSecondCountable

/-- Appendix B, PDF pp.19--20,137 (B.5)--(B.6). Orthogonal closed cyclic sectors
span densely, so their Hilbert sum has countable support even for uncountably many vacua.
The operator action respects the group law; phases may depend on the sector. No strong
continuity of the corrected homomorphism is claimed (footnote 94). -/
theorem sector_phases_removable {B : Type*} [Nonempty B] [MulAction G B]
    (A : Subalgebra ℂ (H →L[ℂ] H)) (vac : B → H)
    (hnorm : ∀ b, ‖vac b‖ = 1)
    (horthogonal : ∀ b c, b ≠ c → ∀ v ∈ cyclicVacuumSector A (vac b),
      ∀ w ∈ cyclicVacuumSector A (vac c), inner ℂ v w = 0)
    (htotal : Dense (Submodule.span ℂ (⋃ b, (cyclicVacuumSector A (vac b) : Set H)) : Set H))
    (U : G → H ≃ₗᵢ[ℂ] H) (phase : G → B → ℂ)
    (hphase : ∀ g b, ‖phase g b‖ = 1)
    (hpermute : ∀ g b, U g (vac b) = phase g b • vac (g • b))
    (hnormalizes : ∀ g (O : A), adjointConjugationCLM (U g) (O : H →L[ℂ] H) ∈ A)
    (hoperatorLaw : ∀ g h (O : A),
      adjointConjugationCLM (U (g * h)) (O : H →L[ℂ] H) =
        adjointConjugationCLM (U h) (adjointConjugationCLM (U g) (O : H →L[ℂ] H))) :
    ∃ improved : G →* (H ≃ₗᵢ[ℂ] H),
      (∀ g b v, v ∈ cyclicVacuumSector A (vac b) →
        improved g v = star (phase g b) • U g v) ∧
      (∀ g b, improved g (vac b) = vac (g • b)) ∧
      (∀ g (O : A), adjointConjugationCLM (improved g) (O : H →L[ℂ] H) =
        adjointConjugationCLM (U g) (O : H →L[ℂ] H)) := by sorry

end Lie

end Hilbert

end QAlgorithms.Papers.Independent.Intakenext100.P81

end
