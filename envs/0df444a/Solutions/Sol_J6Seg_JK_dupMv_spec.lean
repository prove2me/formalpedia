theorem dupMv_spec_sol_aux {X Y T C : Fin HS} (hXY : X ≠ Y) (hXT : X ≠ T) (hYT : Y ≠ T) (hXC : X ≠ C)
    (hYC : Y ≠ C) (hTC : T ≠ C) (hX5 : X.val < 56) (hY5 : Y.val < 56) (hT5 : T.val < 56)
    (hC5 : C.val < 56) (hC : G C = []) {L l : List ℤ} (hX : G X = L ++ l) {n : Ex HS}
    (hnc : n.Clean) (hno : n.ok (encK s G)) (hnl : n.Lin) {B : ℕ} (hnb : n.Bnd (encK s G) B)
    (hn : n.eval (encK s G) = L.length) (hL : Bnd B L) :
    Sp (dupMv X Y T C n) (encK s G)
      (encK s (update (update (update G Y (L.reverse ++ G Y)) T (L.reverse ++ G T)) X l))
      ((n.size + 1) * 2000 * (B + 2) + L.length * (20000 * (B + 2)) + 32) := by
  set Fk : ℕ → Fin HS → List ℤ := fun k => update (update (update G Y ((L.take k).reverse ++ G Y))
    T ((L.take k).reverse ++ G T)) X (L.drop k ++ l) with hFk
  have hF0 : Fk 0 = G := by
    funext j
    simp only [hFk, List.take_zero, List.reverse_nil, List.nil_append, List.drop_zero, update_apply]
    split_ifs with h1 h2 h3 <;> subst_vars <;> simp [hX]
  have H := Sp.rep (s := s) (C := C) (n := n)
    (b := .seq (.push Y (.reg X)) (.seq (.push T (.reg X)) (.pop X)))
    (F := Fk) (N := L.length) (B := B) (c := 8000 * (B + 2) + 2 * B + 2) hC5
    (fun k => by simp [hFk, update_apply, Ne.symm hXC, Ne.symm hYC, Ne.symm hTC, hC])
    (by simp [RS.writes, Ne.symm hXC, Ne.symm hYC, Ne.symm hTC])
    hnc (by rw [hF0]; exact hno) hnl (by rw [hF0]; exact hnb) (by rw [hF0]; exact hn) (fun k hk => by
      have hd : L.drop k ++ l = L[k] :: (L.drop (k + 1) ++ l) := by
        rw [List.drop_eq_getElem_cons hk]; rfl
      have hz : zsz L[k] ≤ B := hL _ (List.getElem_mem hk)
      set H0 := update (Fk k) C [(L.length : ℤ) - k] with hH0
      have g0 : H0 X = L[k] :: (L.drop (k + 1) ++ l) := by
        simp [hH0, hFk, hXC, hd]
      have s1 := Sp.push (s := s) (f := H0) (i := Y) (e := .reg X) (B := B) hY5
        (RS.clean_of_lt hX5) (isInt_encK g0) trivial (by simp only [Ex.Bnd, top_encK g0]; exact hz)
      rw [show (Ex.reg X).eval (encK s H0) = L[k] from top_encK g0] at s1
      have g1 : update H0 Y (L[k] :: H0 Y) X = L[k] :: (L.drop (k + 1) ++ l) := by
        rw [update_of_ne hXY, g0]
      have s2 := Sp.push (s := s) (f := update H0 Y (L[k] :: H0 Y)) (i := T) (e := .reg X) (B := B)
        hT5 (RS.clean_of_lt hX5) (isInt_encK g1) trivial (by simp only [Ex.Bnd, top_encK g1]; exact hz)
      rw [show (Ex.reg X).eval (encK s (update H0 Y (L[k] :: H0 Y))) = L[k] from top_encK g1] at s2
      have g2 : update (update H0 Y (L[k] :: H0 Y)) T (L[k] :: update H0 Y (L[k] :: H0 Y) T) X =
          L[k] :: (L.drop (k + 1) ++ l) := by rw [update_of_ne hXT, g1]
      have s3 := Sp.pop (s := s) (f := _) (B := B) hX5 g2 hz
      refine ((s1.seq (s2.seq s3)).congr ?_).mono ?_
      · congr 1
        have tk : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have rv : ∀ M : List ℤ, L[k] :: ((L.take k).reverse ++ M) = (L.take (k + 1)).reverse ++ M := by
