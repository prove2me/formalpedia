variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
  (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))

private theorem inducedEulerPoly_mul_comp_idelicNorm_eq_comp (hfin : (primeFibre ℚ K v).Finite)
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hχ : IsUnramifiedCharAt χ v) :
    inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v =
      (inducedEulerPoly ℚ (inducedCoeff K μ) v).comp
        (Polynomial.C ((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ) * Polynomial.X) := by
  have hcomp : (inducedEulerPoly ℚ (inducedCoeff K μ) v).comp
      (Polynomial.C ((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ) * Polynomial.X) =
      ∏ᶠ 𝔓 ∈ primeFibre ℚ K v, (inducedFactor ℚ (inducedCoeff K μ) 𝔓).comp
        (Polynomial.C ((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ) * Polynomial.X) := by
    unfold inducedEulerPoly
    rw [finprod_mem_eq_finite_toFinset_prod _ hfin, finprod_mem_eq_finite_toFinset_prod _ hfin, Polynomial.prod_comp]
  rw [hcomp]
  unfold inducedEulerPoly
  refine finprod_mem_congr rfl fun 𝔓 h𝔓 => ?_
  have hu : 𝔓.under (𝓞 ℚ) = v := (mem_primeFibre ℚ v 𝔓).mp h𝔓
  rw [inducedFactor, inducedFactor,
    inducedCoeff_mul_comp_idelicNorm_of_isUnramifiedCharAt μ χ 𝔓 (hμ 𝔓 h𝔓) (he 𝔓 h𝔓) (hu.symm ▸ hχ), hu]
  simp only [sub_comp, C_comp, mul_comp, pow_comp, X_comp, mul_pow, ← C_pow, C_mul]
  ring

private theorem eval_inducedEulerPoly_mul_comp_idelicNorm (hfin : (primeFibre ℚ K v).Finite)
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hχ : IsUnramifiedCharAt χ v) (x : ℂ) :
    (inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v).eval x =
      (inducedEulerPoly ℚ (inducedCoeff K μ) v).eval (((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ) * x) := by
  rw [inducedEulerPoly_mul_comp_idelicNorm_eq_comp μ χ v hfin hμ he hχ, eval_comp, eval_mul, eval_C, eval_X]

private theorem inducedEulerPoly_mul_comp_idelicNorm_eq_one (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hc : Continuous (localChar χ v)) (hχ : ¬ IsUnramifiedCharAt χ v) :
    inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v = 1 := by
  unfold inducedEulerPoly
  have h1 : ∀ 𝔓 ∈ primeFibre ℚ K v,
      inducedFactor ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) 𝔓 = 1 := by
    intro 𝔓 h𝔓
    have hu : 𝔓.under (𝓞 ℚ) = v := (mem_primeFibre ℚ v 𝔓).mp h𝔓
    rw [inducedFactor, inducedCoeff_mul_comp_idelicNorm_of_not_isUnramifiedCharAt μ χ 𝔓 (hμ 𝔓 h𝔓) (he 𝔓 h𝔓)
      (hu.symm ▸ hc) (hu.symm ▸ hχ), C_0, zero_mul, sub_zero, C_1]
  rw [finprod_mem_congr rfl h1, finprod_mem_one]

private theorem eval_inducedEulerPoly_mul_comp_idelicNorm_eq_one
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hc : Continuous (localChar χ v)) (hχ : ¬ IsUnramifiedCharAt χ v) (x : ℂ) :
    (inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v).eval x = 1 := by
  rw [inducedEulerPoly_mul_comp_idelicNorm_eq_one μ χ v hμ he hc hχ, eval_one]

private theorem eval_inducedEulerPoly_twist_of_not_isBadPlace (hv : ¬ IsBadPlace K μ v) (hχ : IsUnramifiedCharAt χ v)
    (x : ℂ) :
    (inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v).eval x =
      (inducedEulerPoly ℚ (inducedCoeff K μ) v).eval (((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ) * x) := by
  have hμ := BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hv
  have he := BadPlaceBridges.ramificationIdx_under_eq_one_of_not_isBadPlace K μ v hv
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  exact eval_inducedEulerPoly_mul_comp_idelicNorm μ χ v (FibreDegree.primeFibre_finite K v) hμ he hχ x

private theorem eval_inducedEulerPoly_twist_eq_one_of_not_isBadPlace (hv : ¬ IsBadPlace K μ v)
    (hc : Continuous (localChar χ v)) (hχ : ¬ IsUnramifiedCharAt χ v) (x : ℂ) :
    (inducedEulerPoly ℚ (inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)) v).eval x = 1 :=
  eval_inducedEulerPoly_mul_comp_idelicNorm_eq_one μ χ v
    (BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hv)
    (BadPlaceBridges.ramificationIdx_under_eq_one_of_not_isBadPlace K μ v hv) hc hχ x

end LanglandsTunnell.CubicInduction.TwistEuler
