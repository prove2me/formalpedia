-- title:
--   Repeated first-price auctions with censored feedback: payoff (1), expected reward (2), regret (3), non-anticipating policies
-- statement:
--   A single bidder takes part in $T$ repeated first-price auctions. In round $t$ she has a private value $v_t\in[0,1]$, submits a bid $b_t\in[0,1]$, and wins if $b_t\ge m_t$, where $m_t\in[0,1]$ is the highest other bid (HOB). Her payoff (1) is
--   $$
--   r(v_t,b_t;m_t)=(v_t-b_t)\,\mathbb 1(b_t\ge m_t).
--   $$
--   The HOBs are iid with an unknown law on $[0,1]$ whose CDF is $G(x)=\mathbb P(m_t\le x)$; no smoothness or shape assumption is made, so $G$ may have atoms. The expected reward (2) is $R(v,b)=(v-b)G(b)$, and the regret (3) of a bid sequence against the value sequence $v=(v_1,\dots,v_T)$ is
--   $$
--   R_T(\pi;v)=\sum_{t=1}^T\Big(\max_{b\in[0,1]}R(v_t,b)-R(v_t,b_t)\Big).
--   $$
--   Feedback is censored: after round $t$ the bidder observes only $\max\{b_t,m_t\}$, which reveals whether she won and, if she lost, the value of $m_t$.
--
--   A **bidding rule** gives the bid in round $t$ as a function of the values $v_1,\dots,v_t$ and the feedback $\max\{b_s,m_s\}$, $s<t$. A **policy** is a randomized family of such rules: it draws internal randomness $u$ from a probability space, and for each $u$ uses a rule whose bids lie in $[0,1]$ and depend measurably on $(u,v_1,\dots,v_t,\text{feedback})$. The bids generated by a rule against $(v,m)$ are defined by recursion on the rounds, and the expected regret of a policy against a fixed (oblivious) value sequence $v$ is the expectation of $R_T(\pi;v)$ over the internal randomness and the iid HOBs.
--
--   These objects are the model of Section 2.2 used by every statement of this mission.
--
--   **Formalization Note** Rounds are `Fin T`; Lean round $t$ is the paper's time $t+1$. $G(x)$ is `(μG (Set.Iic x)).toReal` for a probability measure `μG` on `ℝ` with `μG [0,1]ᶜ = 0`. The maximum in (3) is a supremum over `Set.Icc 0 1` (it is bounded and attained). Non-anticipation is enforced by the argument types of a rule: in round $t$ it receives a function on `Fin (t+1)` (values) and one on `Fin t` (feedback). The expectation is a Bochner integral against `μU.prod (Measure.pi (fun _ => μG))`.
-- source:
--   Han, Zhou, Weissman, Optimal No-regret Learning in Repeated First-price Auctions, arXiv:2003.09795v7, pp. 8-9, §2.2, eqs. (1), (2), (3)

import Mathlib
import Definitions.Def_FirstPriceLearning_Stochastic_Auction

open MeasureTheory

namespace FirstPriceLearning.Adversarial

/-- The regret (3), p. 9, of a bid sequence `bid` against the value sequence `v`
(round `t : Fin T` is the paper's time `t + 1`). -/
noncomputable def regret {T : ℕ} (μG : Measure ℝ) (v bid : Fin T → ℝ) : ℝ :=
  ∑ t, (FirstPriceLearning.Stochastic.oracle μG (v t) - FirstPriceLearning.Stochastic.expReward μG (v t) (bid t))

/-- A deterministic non-anticipating bidding rule with censored feedback: the bid in round `t`
(paper time `t + 1`) is a function of the values of rounds `0, …, t` and of the feedback
`y_s = max{b_s, m_s}` of rounds `0, …, t - 1`. -/
def BidRule (T : ℕ) : Type :=
  (t : Fin T) → (Fin (t.val + 1) → ℝ) → (Fin t.val → ℝ) → ℝ

/-- The bids generated by a rule `f` against values `v` and highest other bids `m`, by recursion
on the round (indexed by `ℕ`; rounds `≥ T` get the dummy value `0`). -/
noncomputable def runBidsNat {T : ℕ} (f : BidRule T) (v m : Fin T → ℝ) : ℕ → ℝ
  | t =>
    if h : t < T then
      f ⟨t, h⟩ (fun s => v ⟨s.val, by omega⟩)
        (fun s => max (runBidsNat f v m s.val) (m ⟨s.val, by omega⟩))
    else 0
termination_by t => t
decreasing_by exact s.isLt

/-- The bids `b_t` generated by the rule `f`. -/
noncomputable def runBids {T : ℕ} (f : BidRule T) (v m : Fin T → ℝ) : Fin T → ℝ :=
  fun t => runBidsNat f v m t.val

/-- A non-anticipating randomized bidding policy for horizon `T` with censored feedback.
Its internal randomness `u` is drawn from the probability measure `μU` on `U`; given `u`, the
bid in round `t` is a measurable function of the values of rounds `0, …, t` and of the
feedback `max{b_s, m_s}` of rounds `s < t`, with values in `[0, 1]`. -/
structure Policy (T : ℕ) where
  U : Type
  [instMeas : MeasurableSpace U]
  μU : Measure U
  [isProb : IsProbabilityMeasure μU]
  bid : U → BidRule T
  measurable_bid : ∀ t : Fin T,
    Measurable (fun p : U × (Fin (t.val + 1) → ℝ) × (Fin t.val → ℝ) => bid p.1 t p.2.1 p.2.2)
  bid_mem : ∀ u t vs ys, bid u t vs ys ∈ Set.Icc (0 : ℝ) 1

attribute [instance] Policy.instMeas Policy.isProb

/-- The expected regret `𝔼[R_T(π; v)]` of a policy against a fixed (oblivious) value sequence `v`,
the expectation being over the policy's internal randomness and the iid HOBs `m_t ∼ G`. -/
noncomputable def expectedRegret {T : ℕ} (π : Policy T) (μG : Measure ℝ) (v : Fin T → ℝ) : ℝ :=
  ∫ p, regret μG v (runBids (π.bid p.1) v p.2) ∂(π.μU.prod (Measure.pi fun _ : Fin T => μG))

end FirstPriceLearning.Adversarial


