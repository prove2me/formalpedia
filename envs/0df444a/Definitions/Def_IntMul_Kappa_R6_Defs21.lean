section
-- Source module: Solutions.R6IL2CCorr
/-!
# Round six, compact controls (I2C): the correction with an abstract key program

`corrG kp B M A` is `KFL.corrRS` with the key program `keyProg` replaced by any register program
`kp` that pushes a key `κ k` on `rK` (`KeyOK`); the radix sort and pass 3 are the frozen ones.

**`corrG_fsp`**: for a bijection `κ` of `ℕ` (inverse `γ`) preserving `[0, M)`,
`flR recs M ↦ flR (recs ∘ γ) M`, at the cost `cCorrG` (moved records only in the sort).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## The program -/

def p1BG (kp : RS) (B : ℕ) : RS :=
  .seq kp (.seq (brB B) (.seq (.pop rK) (.asg rm (.add (.reg rm) (.lit 1)))))

def p1ProgG (kp : RS) (B M : ℕ) : RS := .rep c1 (.lit (M : ℤ)) (p1BG kp B)

def corrG (kp : RS) (B M A : ℕ) : RS :=
  .seq (.push rm (.lit 0)) (.seq (.push rNB (.lit 0)) (.seq (p1ProgG kp B M) (.seq (.pop rm)
    (.seq (radixProg B A) (.seq (p3Prog B M) (.pop rNB))))))

def cP1G (cK B Bb : ℕ) : ℕ := cK + 2 * cIte Bb + KFL.cBr B Bb + 10 ^ 4 * (Bb + 2) ^ 2

def cCorrG (cK B M A nB Bb : ℕ) : ℕ :=
  10 ^ 5 * (Bb + 2) + cLp M (cP1G cK B Bb) Bb + cLp A (cPass B nB Bb) Bb + cLp M (cP3 B Bb) Bb

/-- The key program pushes `κ k` on `rK` when `rm` holds `k < M`. -/
def KeyOK (kp : RS) (s : IState HS) (κ : ℕ → ℕ) (M cK : ℕ) : Prop :=
  ∀ (G0 : Fin HS → List ℤ) (k : ℕ) (lm : List ℤ), G0 rC = [] → (∀ r ∈ kEnvRegs, G0 r = []) →
    k < M → G0 rm = (k : ℤ) :: lm →
    FSp kp (encK s G0) (encK s (Function.update G0 rK ((κ k : ℤ) :: G0 rK))) cK

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCount
/-!
# Round six, compact controls (I2C): the moved records are few

The correction key `κ = stepP (TlS ∘ Psi)` fixes every record whose state is `Good`
(`Psi_good`, `Tl_Tl`). A record is not good only if one of the `n` digits of `T` or `U` is
`2^G - 1`, or one of the `n` guard segments of `Y` is out of range (`2·2^G + 2` values of
`2^K`).

**`card_moved_C`**: `#{m < M : κ m ≠ m} · 2^G · 2^K ≤ n · M · (2 · 2^K + (2 · 2^G + 2) · 2^G)`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL Finset

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

/-- A bad top digit of `T`. -/
abbrev bT (l : Lay) (G s m : ℕ) : Prop := 2 ^ G < m / (l.sT * (2 ^ G) ^ s) % 2 ^ G + 2
/-- A bad top digit of `U`. -/
abbrev bU (l : Lay) (G s m : ℕ) : Prop := 2 ^ G < m / (l.sU * (2 ^ G) ^ s) % 2 ^ G + 2
/-- A bad guard segment of `Y`. -/
abbrev bY (l : Lay) (K ρ G s m : ℕ) : Prop :=
  ¬ (1 ≤ m / (l.sY * 2 ^ ρ * (2 ^ K) ^ s) % 2 ^ K / 2 ∧
    m / (l.sY * 2 ^ ρ * (2 ^ K) ^ s) % 2 ^ K / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1))

end Lay

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCorrU
/-!
# Round six, compact controls (I2C): the register-driven correction

`corrV kp` is `corrG kp B M A` with `B, M, A` read from the registers `1, 2, 3`;
`corrVC = corrV keyProgC`; `corrLC eB eM eA` pushes the three parameters and runs it.

**`corrLC_runs`**: on `flR recs M` (layout in the registers, `KEnv`), `corrLC` computes
`flR (recs ∘ corrC) M`, where `corrC = stepP (Sfw ∘ TlS)` inverts the key `keyC`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel

/-! ## The uniform program -/

def badBV : RS :=
  .seq (NLogN.mvK 0 sKB KFL.cMv (.reg 1)) (.seq (.push sKK (.reg rK))
    (.seq (.push sFL (.lit 1)) (.asg rNB (.add (.reg rNB) (.lit 1)))))

def goodBV : RS := .seq (NLogN.mvK 0 KFL.sT KFL.cMv (.reg 1)) (.push sFL (.lit 0))

def brBV : RS := .ite e1E badBV (.ite e2E badBV goodBV)

def p1BV (kp : RS) : RS :=
  .seq kp (.seq brBV (.seq (.pop rK) (.asg rm (.add (.reg rm) (.lit 1)))))

def p1ProgV (kp : RS) : RS := .rep c1 (.reg 2) (p1BV kp)

def bucketV (ZK ZB n nB : Fin HS) : RS :=
  .seq (.push ZK (.quo (.reg sKK) (.lit 2))) (.seq (.pop sKK) (.seq (NLogN.mvK sKB ZB KFL.cMv (.reg 1))
    (.seq (.asg n (.add (.reg n) (.lit 1))) (.asg nB (.add (.reg nB) (.reg 1))))))

def entBV : RS := .ite condE (bucketV sZ1K sZ1B rn1 rn1B) (bucketV sZ0K sZ0B rn0 rn0B)

def entLoopV : RS := .rep c3 (.reg rNB) entBV

def passBV : RS :=
  .seq (.push rn0 (.lit 0)) (.seq (.push rn1 (.lit 0)) (.seq (.push rn0B (.lit 0))
  (.seq (.push rn1B (.lit 0)) (.seq entLoopV
  (.seq (NLogN.mvK sZ0B sKB KFL.cMv (.reg rn0B)) (.seq (NLogN.mvK sZ0K sKK KFL.cMv (.reg rn0))
  (.seq (NLogN.mvK sZ1B sKB KFL.cMv (.reg rn1B)) (.seq (NLogN.mvK sZ1K sKK KFL.cMv (.reg rn1))
  (.seq (.pop rn0) (.seq (.pop rn1) (.seq (.pop rn0B) (.pop rn1B))))))))))))

def radixProgV : RS := .rep c2 (.reg 3) passBV

def p3BV : RS :=
  .seq (.ite (.neg (.reg sFL)) (.seq (NLogN.mvK sKB 0 KFL.cMv (.reg 1)) (.pop sKK))
    (NLogN.mvK KFL.sT 0 KFL.cMv (.reg 1))) (.pop sFL)

def p3ProgV : RS := .rep c4 (.reg 2) p3BV

def corrV (kp : RS) : RS :=
  .seq (.push rm (.lit 0)) (.seq (.push rNB (.lit 0)) (.seq (p1ProgV kp) (.seq (.pop rm)
    (.seq radixProgV (.seq p3ProgV (.pop rNB))))))

/-- **The register-driven correction** with the compact key program. -/
def corrVC : RS := corrV keyProgC

/-- The register assignment: `1 ↦ B`, `2 ↦ M`, `3 ↦ A`. -/
def σV (b m a : ℤ) : Fin HS → Option ℤ := fun i =>
  if i = 1 then some b else if i = 2 then some m else if i = 3 then some a else none

/-! ## The inverse of the key -/

/-- The correction map: `stepP (Sfw ∘ TlS)`. -/
def corrC (l : Lay) (K ρ G n L : ℕ) (m : ℕ) : ℕ :=
  l.stepP (fun x c => Sfw K ρ G n L x (TlS K ρ n x c)) m

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

end Lay

/-! ## The run -/

def corrPlC (eB eM eA : Ex HS) : List (Fin HS × Ex HS) := [(1, eB), (2, eM), (3, eA)]

/-- **The register-driven correction step.** -/
def corrLC {Pp : ℕ} (eB eM eA : Ex HS) : IStmt HS Pp := withPushI (corrPlC eB eM eA) (fcode corrVC)

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CTop
/-!
# Round six, compact controls (I2C): the top selected bit and the record-step calculus

* `Tl_xor`: the ideal toggle is `y ⊕ (x ∧ selM n)`; with the top bit `q = ρ + n K` flipped as
  well (`flipS q`) the composite step is the slot row addition `phi g (Fpp K ρ (n+1) px py)`
  (`tlflip_phi`).
* `flip_pull`, `swflip`: the last-bit table rotation (directly when `X` is above `Y`, between two
  swaps of single bits otherwise) is the record pull `l.stepP (flipS q)`.
* `RecStep`: a program acting on the record array `flR recs M` as `recs ∘ π`, with sequencing,
  branching and skip.
* `CEnv`: the registers of the compact program; `topC_step`: the top-bit code as a `RecStep`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel AModelL12 Butterfly

/-! ## Bits -/

/-! ## The top-bit step on the record index -/

/-- Toggle bit `q` of the target slot by bit `q` of the source slot. -/
def flipS (q : ℕ) (x : ℕ) (c : CS) : CS := ⟨c.t, c.u, c.y ^^^ (x &&& 2 ^ q)⟩

namespace Lay

variable {l : Lay} {L q : ℕ}

end Lay

/-! ## The composite is the slot row addition -/

/-! ## Record steps -/

/-- `p` acts on the record array `flR recs M` (records of `B` bits) as `recs ∘ π`, at cost `≤ c`,
from every state satisfying `E`. -/
def RecStep (I : List Sym) (tab : Fin 1 → IStmt HS 1) (p : IStmt HS 1) (E : IState HS → Prop)
    (M B : ℕ) (π : ℕ → ℕ) (c : ℝ) : Prop :=
  ∀ (t : IState HS) (recs : ℕ → List ℤ) (R0 : List Item), E t → (∀ m, (recs m).length = B) →
    (∀ m, KFL.Bits (recs m)) → t.G 0 = ints (flR recs M) ++ R0 →
    ∃ c' : ℕ, IRuns I tab p t (t.upd 0 (ints (flR (fun m => recs (π m)) M) ++ R0)) c' ∧
      (c' : ℝ) ≤ c

/-- `E` only reads the registers other than `0`. -/
def Stab (E : IState HS → Prop) : Prop := ∀ t L, E t → E (t.upd 0 L)

namespace RecStep

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {E : IState HS → Prop} {M B : ℕ}

theorem seq {p q : IStmt HS 1} {π1 π2 : ℕ → ℕ} {c1 c2 : ℝ} (hE : Stab E)
    (h1 : RecStep I tab p E M B π1 c1) (h2 : RecStep I tab q E M B π2 c2) :
    RecStep I tab (.seq p q) E M B (fun m => π1 (π2 m)) (c1 + c2) := by
  intro t recs R0 ht hl hb h0
  obtain ⟨d1, H1, hd1⟩ := h1 t recs R0 ht hl hb h0
  obtain ⟨d2, H2, hd2⟩ := h2 (t.upd 0 (ints (flR (fun m => recs (π1 m)) M) ++ R0))
    (fun m => recs (π1 m)) R0 (hE _ _ ht) (fun m => hl _) (fun m => hb _) (by simp)
  refine ⟨d1 + d2, (H1.seq_r6c H2).mono' (by rw [IState.upd_upd_same]) le_rfl, ?_⟩
  push_cast; linarith

theorem skip : RecStep I tab .skip E M B (fun m => m) 1 := by
  intro t recs R0 ht hl hb h0
  refine ⟨1, (IRuns.skip_r6c t).mono' ?_ le_rfl, by norm_num⟩
  rw [← h0, IState.upd_self]

end RecStep

/-! ## The registers of the compact program -/

abbrev kM : Fin HS := 20
abbrev kJ2 : Fin HS := 21
abbrev kF : Fin HS := 22
abbrev kNG : Fin HS := 23
abbrev kBr : Fin HS := 15
abbrev kA : Fin HS := 48

/-- The register environment of the compact program: the key layout (`KEnv`), the record count
`M`, `2^q` (the top bit), the flag `j - i` (positive iff `X` is above `Y`), `n G`, the record
length and `A = zsz (M B)`. -/
structure CEnv (t : IState HS) (l : Lay) (K ρ G n q Br : ℕ) (fl : ℤ) : Prop where
  key : KEnv t l K ρ G n
  m : ∃ L, t.G kM = .int (l.M : ℤ) :: L
  j2 : ∃ L, t.G kJ2 = .int ((2 ^ q : ℕ) : ℤ) :: L
  fl : ∃ L, t.G kF = .int fl :: L
  ng : ∃ L, t.G kNG = .int ((n * G : ℕ) : ℤ) :: L
  br : ∃ L, t.G kBr = .int (Br : ℤ) :: L
  a : ∃ L, t.G kA = .int (zsz ((l.M * Br : ℕ) : ℤ) : ℤ) :: L

/-! ## The top-bit code -/

/-- `M / (2 sY 2^q)`. -/
def eTP (rS : Fin HS) : Ex HS := .ndiv (.reg kM) (.mul (.lit 2) (.mul (.reg rS) (.reg kJ2)))
/-- `sY 2^q B`. -/
def eTB (rS : Fin HS) : Ex HS := .mul (.mul (.reg rS) (.reg kJ2)) (.reg kBr)
/-- `sX / (2 sY 2^q)`. -/
def eTd : Ex HS := .ndiv (.reg kSX) (.mul (.lit 2) (.mul (.reg kSY) (.reg kJ2)))
/-- `sY / (2 sX)`. -/
def eTm : Ex HS := .ndiv (.reg kSY) (.mul (.lit 2) (.reg kSX))

/-- `X` above `Y`: one last-bit rotation of `Y`'s bit `q` by `X`'s bit `q`. -/
def topA : IStmt HS 1 := xorU (eTP kSY) (eTB kSY) eTd (.reg kQL) (.reg kJ2)

/-- The single-bit swap of `Y`'s bit `q` (upper) with `X`'s bit `q` (lower). -/
def topSw (l12 : IStmt HS 1) : IStmt HS 1 := IL2.swE l12 (eTP kSY) eTm (eTB kSX) (.lit 1)

/-- `X` below `Y`: swap the two bits, flip the lower by the upper, swap back. -/
def topB (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq (topSw l12) (.seq (xorU (eTP kSX) (eTB kSX) eTm (.lit 2) (.lit 1)) (topSw l12))

/-- **The top-bit step.** -/
def topC (l12 : IStmt HS 1) : IStmt HS 1 := .ite kF NLogN.KFX.isPos topA (topB l12)

section Top

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n q L Br : ℕ} {fl : ℤ}

/-- The size bound of the register values. -/
theorem zsz_le_of {V Bb z : ℕ} (hBb : Bb = zsz (V : ℤ) + 3) (hz : z ≤ 4 * V) : zsz (z : ℤ) ≤ Bb := by
  have h1 := zsz_nat_le hz
  have h2 : zsz (((4 * V : ℕ)) : ℤ) ≤ zsz (4 : ℤ) + zsz (V : ℤ) := by
    push_cast; exact zsz_mul_le _ _
  have h3 : zsz (4 : ℤ) = 3 := by simpa using (NLogN.zsz_two_pow_r6c 2)
  omega

/-- The facts on the layout used by the top-bit code. -/
structure TopOK (l : Lay) (L q Br : ℕ) : Prop where
  ok : l.OK
  ql : l.QL = 2 ^ L
  hq : q < L
  br : 1 ≤ Br

end Top

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CPhase
/-!
# Round six, compact controls (I2C): the compact phase as record steps

The ten table rotations (`rotYA`, `rotYB` on `Y`; `rotS`, `rotC`, `rotL ±1` on `Bk`) and the
twelve Lemma 12 swaps (`swT`, `swU`: the compact fields `T`, `U` with `Bk`) of the compact
program, with all parameters read from the registers of `CEnv`, as `RecStep`s:

* `phaseC_step`: one phase is `l.stepP phInv`;
* `psiC_step`: phase, load, phase, unload is `l.stepP Psi`;
* `compactC_step`: followed by the correction it is `l.stepP TlS` (exactly).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel AModelL12

/-! ## Generic rotation and swap steps -/

/-! ## The layout facts of the compact phase -/

/-- The value facts of the compact phase (`Bk` at stride `1`). -/
structure PhOK (l : Lay) (K ρ G n L Br : ℕ) : Prop where
  kv : KVal l K ρ G n L l.M (zsz ((l.M * Br : ℕ) : ℤ) + 3)
  sb : l.sB = 1
  br : 1 ≤ Br

namespace PhOK

variable {l : Lay} {K ρ G n L Br : ℕ} (hP : PhOK l K ρ G n L Br)
include hP

theorem zB {v : ℕ} (h : v ≤ 4 * (l.M * Br)) : zsz (v : ℤ) ≤ zsz ((l.M * Br : ℕ) : ℤ) + 3 :=
  zsz_le_of rfl h

end PhOK

/-! ## The register expressions -/

/-- `M / (QL sY)`. -/
def eYP : Ex HS := .ndiv (.reg kM) (.mul (.reg kQL) (.reg kSY))
/-- `sY Br`. -/
def eYB : Ex HS := .mul (.reg kSY) (.reg kBr)
/-- `s / (QL sY)` for the stride `s` on `r`. -/
def eYd (r : Fin HS) : Ex HS := .ndiv (.reg r) (.mul (.reg kQL) (.reg kSY))
/-- `M / QC`. -/
def eBP : Ex HS := .ndiv (.reg kM) (.reg kQC)
/-- `s 2^ρ / QC` for the stride `s` on `r`. -/
def eBd (r : Fin HS) : Ex HS := .ndiv (.mul (.reg r) (.reg kR2)) (.reg kQC)
/-- `sU / QC`. -/
def eUQ : Ex HS := .ndiv (.reg kSU) (.reg kQC)
/-- `M / (QC s)`, `s / QC` for the swap of the field at stride `s` on `r` with `Bk`. -/
def eWP (r : Fin HS) : Ex HS := .ndiv (.reg kM) (.mul (.reg kQC) (.reg r))
def eWM (r : Fin HS) : Ex HS := .ndiv (.reg r) (.reg kQC)

/-- Step `A` / `B` (rotations of `Y`). -/
def rotYA : IStmt HS 1 :=
  rotR 1 tmA eYP (.reg kQL) eYB (eYd kSU) (eYd kST) (.reg kRR) (.reg kRR) (.reg kK2) (.reg kR2)
    (.reg kN) (.reg kRR)
def rotYB : IStmt HS 1 :=
  rotR 1 tmB eYP (.reg kQL) eYB (eYd kSU) (eYd kST) (.reg kRR) (.reg kRR) (.reg kK2) (.reg kR2)
    (.reg kN) (.reg kRR)
/-- Step `S` (rotation of `Bk` holding `T`). -/
def rotS : IStmt HS 1 :=
  rotR 1 tmS eBP (.reg kQC) (.reg kBr) (eBd kSY) (eBd kSY) (.reg kK2) (.reg kK2) (.reg kRR) (.lit 1)
    (.reg kN) (.reg kRR)
/-- Step `C`. -/
def rotC : IStmt HS 1 :=
  rotR (-1) tmC eBP (.reg kQC) (.reg kBr) (eBd kSY) eUQ (.reg kK2) (.reg kRR) (.reg kRR) (.lit 1)
    (.reg kN) (.reg kRR)
/-- Load / unload (rotation of `Bk` holding `U`). -/
def rotL (sgn : ℤ) : IStmt HS 1 :=
  rotR sgn tmS eBP (.reg kQC) (.reg kBr) (eBd kSX) (eBd kSX) (.reg kK2) (.reg kK2) (.reg kRR)
    (.lit 1) (.reg kN) (.reg kRR)

/-- The swap of the compact field at stride `s` (on `r`) with `Bk`. -/
def swW (l12 : IStmt HS 1) (r : Fin HS) : IStmt HS 1 :=
  IL2.swE l12 (eWP r) (eWM r) (.reg kBr) (.reg kNG)

/-- A rotation of `Bk` between two swaps. -/
def thru (l12 : IStmt HS 1) (r : Fin HS) (p : IStmt HS 1) : IStmt HS 1 :=
  .seq (swW l12 r) (.seq p (swW l12 r))

/-- **One phase** (`A, S, B, C`). -/
def phaseC (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq rotYA (.seq (thru l12 kST rotS) (.seq rotYB (thru l12 kST rotC)))

/-- **The ten pulls**: phase, load, phase, unload. -/
def psiC (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq (phaseC l12) (.seq (thru l12 kSU (rotL 1)) (.seq (phaseC l12) (thru l12 kSU (rotL (-1)))))

/-- **The compact phase**: the ten pulls and the correction. -/
def compactC (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq (psiC l12) (corrLC (.reg kBr) (.reg kM) (.reg kA))

/-! ## The steps -/

section Steps

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n L q Br : ℕ} {fl : ℤ}

/-- The cost bound of one table rotation. -/
noncomputable def cR (T : Ex HS) (l : Lay) (n Br P Q S : ℕ) : ℝ :=
  (cRotR T (zsz ((l.M * Br : ℕ) : ℤ) + 3) n P Q (S * Br) 1 : ℕ)

variable (hP : PhOK l K ρ G n L Br)
include hP

/-- The cost bound of one swap. -/
noncomputable def cW (Ksw τ : ℝ) (l : Lay) (n G Br : ℕ) : ℝ :=
  Ksw * (((l.M * Br : ℕ) : ℝ) + 1) * ((n * G : ℕ) : ℝ) ^ τ

/-- The cost of one phase. -/
noncomputable def cPh (Ksw τ : ℝ) (l : Lay) (n G Br : ℕ) : ℝ :=
  cR tmA l n Br (l.M / (l.QL * l.sY)) l.QL l.sY + cR tmB l n Br (l.M / (l.QL * l.sY)) l.QL l.sY +
    cR tmS l n Br (l.M / l.QC) l.QC 1 + cR tmC l n Br (l.M / l.QC) l.QC 1 + 4 * cW Ksw τ l n G Br

/-- The cost of the ten pulls. -/
noncomputable def cPsi (Ksw τ : ℝ) (l : Lay) (n G Br : ℕ) : ℝ :=
  2 * cPh Ksw τ l n G Br + 2 * cR tmS l n Br (l.M / l.QC) l.QC 1 + 4 * cW Ksw τ l n G Br

/-- The cost of the correction. -/
noncomputable def cCo (l : Lay) (K ρ G n L Br : ℕ) : ℝ :=
  ((30 * 10 ^ 7 * (zsz ((l.M * Br : ℕ) : ℤ) + 3 + 2) ^ 2 + 1 +
    400 * cCorrG (cKeyC (zsz ((l.M * Br : ℕ) : ℤ) + 3) n) Br l.M (zsz ((l.M * Br : ℕ) : ℤ))
      (nMv (keyC l K ρ G n L) l.M) (zsz ((l.M * Br : ℕ) : ℤ) + 3) +
    (3 * (2 * (zsz ((l.M * Br : ℕ) : ℤ) + 3) + 2) + 1) : ℕ) : ℝ)

/-- The cost of the compact phase. -/
noncomputable def cCmp (Ksw τ : ℝ) (l : Lay) (K ρ G n L Br : ℕ) : ℝ :=
  cPsi Ksw τ l n G Br + cCo l K ρ G n L Br

end Steps

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCore
/-!
# Round six, compact controls (I2C): the compact Lemma 13 code

* `layR`: the record layout of a row addition (`T`, `U` in the top of `N0`, the bit-control field
  `Bk` at stride `1` in the bottom of `N3`, `X`, `Y` the slots `px`, `py`), `layR_ok`, `layR_kval`.
* `midC`: the compact phase (only when `n = f - 1 > 0`) and the top bit; `midC_step`: it is the
  record pull `stepP (TlS ∘ flipS)`.
* `l13C`: to bits, `midC`, from bits; **`l13C_runs`**: it is the row addition
  `permRecs (rect …) (rowAddAddr K ρ f px py)`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX NLogN.KFB NLogN.KFH IntMul RS AModel AModelL12 Butterfly

/-! ## The layout of a row addition -/

/-- The record geometry (records of one bit-record each). -/
def gR (N0 N1 N2 N3 L : ℕ) : Geo := ⟨2 ^ L, N0, N1, N2, N3, 1⟩

/-- The layout: `T` at `QC · U`, `U` just above slot `0`, `Bk` at stride `1`. -/
def layR (N0 N1 N2 N3 L G n : ℕ) (px py : Fin 3) : Lay where
  QC := Qc G n
  QL := 2 ^ L
  sT := Qc G n * (2 ^ L * (gR N0 N1 N2 N3 L).S0)
  sU := 2 ^ L * (gR N0 N1 N2 N3 L).S0
  sX := strd (gR N0 N1 N2 N3 L) px
  sY := strd (gR N0 N1 N2 N3 L) py
  sB := 1
  M := (gR N0 N1 N2 N3 L).V

/-- The row-addition parameters (positivity and the divisibility of the compact fields). -/
structure RP (N0 N1 N2 N3 K f ρ G : ℕ) (px py : Fin 3) : Prop where
  hpxy : px ≠ py
  hK : 6 ≤ K
  hρ : ρ < K
  hf : 1 ≤ f
  hG : 1 ≤ G
  hGK : G < K
  n0 : ∃ a, 0 < a ∧ N0 = Qc G (f - 1) * Qc G (f - 1) * a
  n1 : 0 < N1
  n2 : 0 < N2
  n3 : ∃ b, 0 < b ∧ N3 = Qc G (f - 1) * b

namespace RP

variable {N0 N1 N2 N3 K f ρ G : ℕ} {px py : Fin 3} (hp : RP N0 N1 N2 N3 K f ρ G px py)
include hp

end RP

/-! ## The middle part: the compact phase and the top bit -/

/-- The compact phase (when `n > 0`) followed by the top bit. -/
def midC (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq (.ite kN NLogN.KFX.isPos (compactC l12) .skip) (topC l12)

/-- The cost of the top bit. -/
noncomputable def cTop (Ksw : ℝ) (l : Lay) (q Br : ℕ) : ℝ :=
  25 + (cXorU (l.M / (2 * (l.sY * 2 ^ q))) (l.sY * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) +
    (cXorU (l.M / (2 * (l.sX * 2 ^ q))) (l.sX * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) +
    2 * (Ksw * (((l.M * Br : ℕ) : ℝ) + 1))

/-! ## The compact Lemma 13 code -/

/-- **The compact Lemma 13 code.** -/
def l13C (l12 : IStmt HS 1) : IStmt HS 1 := .seq toBitsU (.seq (midC l12) fromBitsU)

/-- The cost of the compact Lemma 13 code. -/
noncomputable def cL13 (Ksw τ : ℝ) (N0 N1 N2 N3 K f ρ G R w : ℕ) (px py : Fin 3) : ℝ :=
  2000 * (cTo (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) +
    (26 + cCmp Ksw τ (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (f * K)
        (R * (2 * (w + 1))) +
      cTop Ksw (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) (ρ + (f - 1) * K) (R * (2 * (w + 1)))) +
    2000 * (cFrom (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ)

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL3Pad
/-!
# Round six, item language (I3): the scale pad

`scaleQ xL xQ ρ ρE = padCU xL xQ (wrapQ 2 1 ρ ρE .skip)`: append `n` zero records, swap the zero
half to the front, level the data half by `2^e`, swap back, drop the zeros.

* **`wrapQ_zero`**: the wrapper with `U = skip` on a zero role (zeros sit at every scale);
* **`sImplQ_scale`**: `scaleQ` implements the identity with scale shift `e`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The scale pad. -/
def scaleQ (xL xQ ρ ρE : Fin HS) : IStmt HS Pp :=
  padCU xL xQ (wrapQ 2 1 ρ ρE (.skip : IStmt HS Pp))

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Norm
/-!
# Round six, item language (I3): normal form of a `Prop8IfaceH` network

The item-language level procedure only implements **forward children on a prefix of slots**
(`child w (pref m s) ∅`): their bits are a contiguous stride-`K` block, exactly as a recursive
call needs them.  Every `Prop8IfaceH` network can be put in this form without changing its
denotation, its child widths or its gates:

* the sign set: `signedOp ch S neg = (-i)^{|N||κ|} Z_N ch(S) Z_N` (`N = neg ∩ S`), and `Z_N`,
  `(-i)^{|N||κ|} Z_N` are phase steps (`phase w 0 0 (2·1_N)`, `phase w 0 (3|N|) (2·1_N)`);
* the slot set: a slot permutation `σ` with `σ(pref) = S` conjugates the prefix child into the
  child on `S`, and every slot permutation is a product of slot swaps, each three row additions
  (`x_i ⊕= x_j` XOR-swap): `swap3`.

**`Prop8IfaceH.norm`**: the normalized network; `norm_child`: its children are prefix forward
children; `norm_gate`: its gates are gates of the original network.

`GClassH J A`: the gate class of the item-language implementation (atoms of the KFG gate
passes in the role numbering `roleEqv`: data `0 … W-1`, temporaries `W … W+T-1`, or `±1` role diagonals).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL3H

open Matrix Finset Complex Butterfly P8Lift IntMul.Kappa.R6.Cx

/-! ## Address maps -/

section Ops

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- The permutation matrix of an address map. -/
def opF (f : Addr m κ → Addr m κ) : Op (Fin m × κ) := fun x y => if y = f x then 1 else 0

theorem opF_mul (f g : Addr m κ → Addr m κ) : opF f * opF g = opF (g ∘ f) := by
  ext x y
  simp only [opF, Matrix.mul_apply, Function.comp]
  rw [Finset.sum_eq_single (f x)]
  · simp
  · intro b _ hb; simp [hb]
  · simp

theorem opF_id : opF (id : Addr m κ → Addr m κ) = 1 := by
  ext x y; simp [opF, one_apply, eq_comm]

/-- Slot relabelling: slot `a` of the result is slot `σ a` of `x`. -/
def rl (σ : Equiv.Perm (Fin m)) (x : Addr m κ) : Addr m κ := fun p => x (σ p.1, p.2)

theorem rl_mul (σ τ : Equiv.Perm (Fin m)) : rl (κ := κ) (σ * τ) = rl τ ∘ rl σ := by
  funext x p; rfl

theorem rl_one : rl (κ := κ) (1 : Equiv.Perm (Fin m)) = id := by
  funext x p; rfl

theorem rl_refl : rl (κ := κ) (Equiv.refl (Fin m)) = id := by
  funext x p; rfl

theorem rl_inv_rl (σ : Equiv.Perm (Fin m)) (x : Addr m κ) : rl σ⁻¹ (rl σ x) = x := by
  funext p; simp [rl]

theorem rl_rl_inv (σ : Equiv.Perm (Fin m)) (x : Addr m κ) : rl σ (rl σ⁻¹ x) = x := by
  funext p; simp [rl]

/-- **XOR swap**: three row additions swap two slots. -/
theorem rowAddr_swap3 {i j : Fin m} (hij : i ≠ j) :
    rowAddr (κ := κ) i j ∘ (rowAddr j i ∘ rowAddr i j) = rl (Equiv.swap i j) := by
  funext x p
  obtain ⟨a, c⟩ := p
  simp only [Function.comp, rowAddr, rl]
  by_cases ha : a = j
  · subst ha
    simp [hij, Ne.symm hij]
    generalize x (i, c) = u; generalize x (a, c) = v; revert u v; decide
  · by_cases hai : a = i
    · subst hai
      simp [ha, hij, Ne.symm hij]
      generalize x (a, c) = u; generalize x (j, c) = v; revert u v; decide
    · simp [ha, hai, Equiv.swap_apply_of_ne_of_ne hai ha]

/-- **Conjugation by a slot permutation** relabels a tensor family. -/
theorem conj_tensF (σ : Equiv.Perm (Fin m)) (g : Fin m × κ → M2) :
    opF (rl σ) * tensF g * opF (rl σ⁻¹) = tensF (fun p => g (σ⁻¹ p.1, p.2)) := by
  ext x y
  have h1 : ∀ (M : Op (Fin m × κ)) (x y : Addr m κ), (opF (rl σ) * M : Op (Fin m × κ)) x y = M (rl σ x) y := by
    intro M x y
    simp only [opF, Matrix.mul_apply, ite_mul, one_mul, zero_mul]
    rw [Finset.sum_eq_single (rl σ x)]
    · simp
    · intro b _ hb; simp [hb]
    · simp
  have h2 : ∀ (M : Op (Fin m × κ)) (x y : Addr m κ), (M * opF (rl σ⁻¹) : Op (Fin m × κ)) x y = M x (rl σ y) := by
    intro M x y
    simp only [opF, Matrix.mul_apply, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_eq_single (rl σ y)]
    · simp [rl_inv_rl]
    · intro b _ hb
      rw [if_neg]
      intro h; apply hb; rw [h, rl_rl_inv]
    · simp
  rw [h2, h1]
  simp only [tensF, rl]
  let e : Fin m × κ ≃ Fin m × κ := Equiv.prodCongr σ (Equiv.refl κ)
  refine Fintype.prod_equiv e _ _ (fun p => ?_)
  simp [e]; rfl

end Ops

/-! ## Slot swaps and slot permutations as row additions -/

section Steps

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ}

/-- Swap slots `i, j` of role `w` by three row additions. -/
def swap3 (w : R) (i j : Fin m) : List (HStep R m) :=
  if h : i = j then [] else [.rowAdd w i j h, .rowAdd w j i (Ne.symm h), .rowAdd w i j h]

theorem den_rowAddH {κ : Type} [Fintype κ] [DecidableEq κ] (ch : Finset (Fin m) → Op (Fin m × κ))
    (w : R) (i j : Fin m) (hij : i ≠ j) :
    (HStep.rowAdd w i j hij : HStep R m).den ch = wireOp w (opF (rowAddr i j)) :=
  den_rowAdd (1 : Op κ) w i j hij

theorem den_swap3 {κ : Type} [Fintype κ] [DecidableEq κ] (ch : Finset (Fin m) → Op (Fin m × κ))
    (w : R) (i j : Fin m) : denListH ch (swap3 w i j) = wireOp w (opF (rl (Equiv.swap i j))) := by
  unfold swap3
  split_ifs with h
  · subst h; simp [opF_id, rl_refl, wireOp_one]
  · rw [show ([.rowAdd w i j h, .rowAdd w j i (Ne.symm h), .rowAdd w i j h] : List (HStep R m)) =
        [.rowAdd w i j h] ++ [.rowAdd w j i (Ne.symm h)] ++ [.rowAdd w i j h] from rfl]
    simp only [denListH_append, denListH_single]
    rw [den_rowAddH, den_rowAddH, wireOp_mul, wireOp_mul, opF_mul, opF_mul, ← rowAddr_swap3 h]
    rfl

/-- A list of row additions on role `w`. -/
def RowAddsOn (w : R) (l : List (HStep R m)) : Prop :=
  ∀ st ∈ l, ∃ i j h, st = HStep.rowAdd w i j h

theorem rowAddsOn_swap3 (w : R) (i j : Fin m) : RowAddsOn w (swap3 w i j) := by
  intro st hst
  unfold swap3 at hst
  split_ifs at hst with h
  · simp at hst
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hst
    rcases hst with rfl | rfl | rfl
    · exact ⟨_, _, _, rfl⟩
    · exact ⟨_, _, _, rfl⟩
    · exact ⟨_, _, _, rfl⟩

theorem widths_rowAddsOn {w : R} : ∀ {l : List (HStep R m)}, RowAddsOn w l →
    l.filterMap HStep.width = []
  | [], _ => rfl
  | st :: l, h => by
    obtain ⟨i, j, hij, rfl⟩ := h st List.mem_cons_self
    rw [List.filterMap_cons]
    exact widths_rowAddsOn (fun s hs => h s (List.mem_cons_of_mem _ hs))

/-- **Every slot permutation is a list of row additions.** -/
theorem exists_permSteps (w : R) (σ : Equiv.Perm (Fin m)) :
    ∃ l : List (HStep R m), RowAddsOn w l ∧ ∀ (κ : Type) [Fintype κ] [DecidableEq κ]
      (ch : Finset (Fin m) → Op (Fin m × κ)), denListH ch l = wireOp w (opF (rl σ)) := by
  induction σ using Equiv.Perm.swap_induction_on with
  | one => exact ⟨[], fun st h => by simp at h, fun κ _ _ ch => by simp [rl_one, opF_id, wireOp_one]⟩
  | swap_mul f x y hxy ih =>
    obtain ⟨l, hl, hd⟩ := ih
    refine ⟨l ++ swap3 w x y, fun st hst => ?_, fun κ _ _ ch => ?_⟩
    · rcases List.mem_append.1 hst with h | h
      · exact hl st h
      · exact rowAddsOn_swap3 w x y st h
    · rw [denListH_append, den_swap3, hd, wireOp_mul, opF_mul, rl_mul]

/-- The chosen row-addition list of a slot permutation. -/
noncomputable def permSteps (w : R) (σ : Equiv.Perm (Fin m)) : List (HStep R m) :=
  Classical.choose (exists_permSteps w σ)

theorem permSteps_rows (w : R) (σ : Equiv.Perm (Fin m)) : RowAddsOn w (permSteps w σ) :=
  (Classical.choose_spec (exists_permSteps w σ)).1

theorem den_permSteps {κ : Type} [Fintype κ] [DecidableEq κ] (ch : Finset (Fin m) → Op (Fin m × κ))
    (w : R) (σ : Equiv.Perm (Fin m)) : denListH ch (permSteps w σ) = wireOp w (opF (rl σ)) :=
  (Classical.choose_spec (exists_permSteps w σ)).2 κ ch

end Steps

/-! ## Prefix slot sets -/

/-- The first `s` slots. -/
def pref (m s : ℕ) : Finset (Fin m) := univ.filter fun i => i.val < s

theorem card_pref {m s : ℕ} (h : s ≤ m) : (pref m s).card = s := by
  unfold pref
  rw [Fin.card_filter_val_lt]; omega

theorem exists_perm_pref {m : ℕ} (S : Finset (Fin m)) :
    ∃ σ : Equiv.Perm (Fin m), (pref m S.card).map σ.toEmbedding = S := by
  have hc : Fintype.card {x // x ∈ pref m S.card} = Fintype.card {x // x ∈ S} := by
    rw [Fintype.card_coe, Fintype.card_coe, card_pref]
    exact (card_le_univ S).trans (le_of_eq (Fintype.card_fin m))
  let e := Fintype.equivOfCardEq hc
  refine ⟨e.extendSubtype, ?_⟩
  apply Finset.eq_of_subset_of_card_le
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_map.1 hy
    exact Equiv.extendSubtype_mem e x hx
  · rw [Finset.card_map, card_pref]
    exact (card_le_univ S).trans (le_of_eq (Fintype.card_fin m))

/-- The chosen permutation moving the prefix onto `S`. -/
noncomputable def σS {m : ℕ} (S : Finset (Fin m)) : Equiv.Perm (Fin m) :=
  Classical.choose (exists_perm_pref S)

theorem σS_spec {m : ℕ} (S : Finset (Fin m)) : (pref m S.card).map (σS S).toEmbedding = S :=
  Classical.choose_spec (exists_perm_pref S)

/-! ## Phases -/

section Phase

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- The phase weights `2 · 1_N`. -/
def a2 (N : Finset (Fin m)) : Fin m → ℕ := fun r => if r ∈ N then 2 else 0

theorem tensF_diag2 (c : Fin m × κ → ℂ) :
    (tensF (fun p => !![1, 0; 0, c p]) : Op (Fin m × κ)) =
      diagonal fun x => ∏ p, (if x p = 0 then (1 : ℂ) else c p) := by
  ext x y
  simp only [tensF, diagonal_apply]
  by_cases h : x = y
  · subst h; simp only [if_true]
    refine Finset.prod_congr rfl fun i _ => ?_
    rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h0 | h1 <;> simp [*]
  · simp only [h, if_false]
    obtain ⟨i, hi⟩ : ∃ i, x i ≠ y i := by
      by_contra hc; push Not at hc; exact h (funext hc)
    apply Finset.prod_eq_zero (mem_univ i)
    rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h0 | h0 <;>
    rcases Fin.exists_fin_two.1 ⟨y i, rfl⟩ with h1 | h1 <;> simp_all

theorem setFam_Zm (N : Finset (Fin m)) :
    (setFam (κ := κ) N Zm) = fun p => !![1, 0; 0, if p.1 ∈ N then (-1 : ℂ) else 1] := by
  funext p
  unfold setFam Zm
  split_ifs
  · rfl
  · ext i j; fin_cases i <;> fin_cases j <;> simp

theorem I_pow_a2 (N : Finset (Fin m)) (x : Addr m κ) :
    I ^ (∑ p : Fin m × κ, a2 N p.1 * (x p).val) =
      ∏ p, (if x p = 0 then (1 : ℂ) else if p.1 ∈ N then -1 else 1) := by
  rw [← Finset.prod_pow_eq_pow_sum]
  refine Finset.prod_congr rfl fun p _ => ?_
  rcases Fin.exists_fin_two.1 ⟨x p, rfl⟩ with h | h <;> rw [h] <;> simp [a2] <;>
    split_ifs <;> simp [pow_two]

theorem den_phase_a2 {R : Type} [Fintype R] [DecidableEq R] (ch : Finset (Fin m) → Op (Fin m × κ))
    (w : R) (k₀ k₁ : ℕ) (N : Finset (Fin m)) :
    (HStep.phase w k₀ k₁ (a2 N) : HStep R m).den ch =
      wireOp w ((I ^ (k₀ + k₁ * Fintype.card κ)) • tensF (setFam (κ := κ) N Zm)) := by
  rw [HStep.den, den_phase]
  congr 1
  rw [setFam_Zm, tensF_diag2]
  ext x y
  simp only [diagonal_apply, Matrix.smul_apply, smul_eq_mul]
  split_ifs
  · rw [RStep.phExp, pow_add, I_pow_a2]
  · simp

end Phase

/-! ## The normalized child -/

section Child

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ}

/-- The forward prefix child conjugated onto `S`. -/
noncomputable def fwdS (w : R) (S : Finset (Fin m)) : List (HStep R m) :=
  permSteps w (σS S)⁻¹ ++ [HStep.child w (pref m S.card) ∅] ++ permSteps w (σS S)

/-- The normalized child: sign phases around the forward child. -/
noncomputable def normChild (w : R) (S neg : Finset (Fin m)) : List (HStep R m) :=
  [HStep.phase w 0 0 (a2 (neg ∩ S))] ++ fwdS w S ++
    [HStep.phase w 0 (3 * (neg ∩ S).card) (a2 (neg ∩ S))]

variable {κ : Type} [Fintype κ] [DecidableEq κ]

theorem slotFam_empty (S : Finset (Fin m)) : slotFam (κ := κ) S ∅ = setFam S Cm := by
  funext p; simp [slotFam, setFam]

theorem den_fwdS (w : R) (S : Finset (Fin m)) :
    denListH (chEx (κ := κ)) (fwdS w S) = wireOp w (chEx (κ := κ) S) := by
  unfold fwdS
  rw [denListH_append, denListH_append, denListH_single, den_permSteps, den_permSteps,
    HStep.den_child_exact, slotFam_empty, wireOp_mul, wireOp_mul, ← mul_assoc, conj_tensF]
  unfold chEx
  congr 2
  funext p
  simp only [setFam]
  have : (σS S)⁻¹ p.1 ∈ pref m S.card ↔ p.1 ∈ S := by
    conv_rhs => rw [← σS_spec S]
    rw [Finset.mem_map_equiv]
    rfl
  by_cases h : p.1 ∈ S
  · rw [if_pos (this.2 h), if_pos h]
  · rw [if_neg (fun h' => h (this.1 h')), if_neg h]

theorem neg_I_pow (n : ℕ) : (-I) ^ n = I ^ (3 * n) := by
  rw [pow_mul]; congr 1; rw [pow_succ, pow_two, I_mul_I]; ring

theorem den_normChild (w : R) (S neg : Finset (Fin m)) :
    denListH (chEx (κ := κ)) (normChild w S neg) = (HStep.child w S neg).den chEx := by
  unfold normChild
  rw [denListH_append, denListH_append, denListH_single, denListH_single, den_fwdS,
    den_phase_a2, den_phase_a2, HStep.den, wireOp_mul, wireOp_mul]
  congr 1
  unfold signedOp
  rw [neg_I_pow, Nat.zero_mul, Nat.add_zero, pow_zero, one_smul, Nat.zero_add, ← mul_assoc,
    Matrix.smul_mul, Matrix.smul_mul, mul_assoc]

theorem widths_fwdS (w : R) (S : Finset (Fin m)) :
    (fwdS w S).filterMap HStep.width = [S.card] := by
  unfold fwdS
  rw [List.filterMap_append, List.filterMap_append, widths_rowAddsOn (permSteps_rows _ _),
    widths_rowAddsOn (permSteps_rows _ _)]
  simp [HStep.width, card_pref ((card_le_univ S).trans (le_of_eq (Fintype.card_fin m)))]

theorem widths_normChild (w : R) (S neg : Finset (Fin m)) :
    (normChild w S neg).filterMap HStep.width = [S.card] := by
  unfold normChild
  rw [List.filterMap_append, List.filterMap_append, widths_fwdS]
  simp [HStep.width, List.filterMap]

/-- The normalized form of a step. -/
noncomputable def normStep : HStep R m → List (HStep R m)
  | .child w S neg => normChild w S neg
  | st => [st]

theorem den_normStep (st : HStep R m) :
    denListH (chEx (κ := κ)) (normStep st) = st.den chEx := by
  cases st with
  | child w S neg => exact den_normChild w S neg
  | _ => exact denListH_single _ _

theorem widths_normStep (st : HStep R m) :
    (normStep st).filterMap HStep.width = [st].filterMap HStep.width := by
  cases st with
  | child w S neg => rw [normStep, widths_normChild]; simp [HStep.width]
  | _ => rfl

end Child

/-! ## The normalized network -/

namespace Prop8IfaceH'

variable {W T m : ℕ} {h : List (ℕ × ℕ)}

theorem widths_flatMap_norm (l : List (HStep (Fin W ⊕ Fin T) m)) :
    (l.flatMap normStep).filterMap HStep.width = l.filterMap HStep.width := by
  rw [widths_flatMap]
  induction l with
  | nil => rfl
  | cons st l ih =>
    rw [List.flatMap_cons, ih, widths_normStep, List.filterMap_cons, List.filterMap_cons,
      List.filterMap_nil]
    cases st.width <;> rfl

/-- **The normalized network.** -/
noncomputable def norm (J : Prop8IfaceH W T m h) : Prop8IfaceH W T m h where
  net := J.net.flatMap normStep
  small := by rw [widths_flatMap_norm]; exact J.small
  hist := by rw [widths_flatMap_norm]; exact J.hist
  correct := by
    intro κ _ _
    have : denListH (chEx (κ := κ)) (J.net.flatMap normStep) = denListH chEx J.net := by
      rw [denListH_flatMap_congr chEx J.net normStep (fun st => [st]) (fun st _ => by
        rw [den_normStep, denListH_single]), List.flatMap_singleton']
    rw [this]; exact J.correct κ

end Prop8IfaceH'

/-! ## The gate class -/

/-- Roles in the item-language numbering: data `0 … W-1`, temporaries `W … W+T-1` (the
temporaries are zero records appended after the data). -/
def roleEqv (W T : ℕ) : Fin W ⊕ Fin T ≃ Fin (W + T) := finSumFinEquiv

/-- **The gate class of the item-language implementation** (`KFN.GClass` for `Prop8IfaceH`):
every gate is a list of at most `A` KFG atoms (`Ok`, `h ≤ 1`, no target is a source) in the
numbering `roleEqv` (data first), or a `±1` role diagonal. -/
def GClassH {W T m : ℕ} {h : List (ℕ × ℕ)} (J : Prop8IfaceH W T m h) (A : ℕ) : Prop :=
  ∀ G, HStep.gate G ∈ J.net →
    (∃ as : List NLogN.KFG.Atom, as.length ≤ A ∧ (∀ a ∈ as, a.Ok (W + T) ∧ a.h ≤ 1) ∧ NLogN.KFG.NoTS as ∧
        G = (NLogN.KFG.gateMat (W + T) as).submatrix (roleEqv W T) (roleEqv W T)) ∨
      (∃ U : Finset (Fin W ⊕ Fin T), G = Matrix.diagonal fun w => if w ∈ U then -1 else 1)

end IntMul.Kappa.R6.IL3H

end


