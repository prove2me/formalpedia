private theorem deriv_eq_mul (hR : IsOneParamGroup R) (t : ℝ) : deriv R t = R t * deriv R 0 := by
  have hd := hR.differentiable
  have heq : (fun s => R (t + s)) = fun s => R t * R s := funext fun s => hR.map_add t s
