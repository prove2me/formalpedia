-- Source module: Solutions.KFDOps
/-!
# KFD: fine element loops

Fine (`FSp`) versions of the element loops of KIL3Ops (`dupK`, `dropK`, `zeroK`, `zipK`), of
`mvK` with a register count, and of the conditional / `c`-way branch (`sel`).  The per-element
cost depends only on a *data bound* `w` (bits: `w = 1`); the count enters only through the
loop overhead `cRep N = O(N + zsz N)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL

/-! ## Expression costs -/

theorem cost_lit (t : IState HS) (c : ℤ) : (Ex.lit (S := HS) c).cost t = zsz c + 2 := rfl

theorem cRep_le {N Bb : ℕ} (h : zsz (N : ℤ) ≤ Bb) : cRep N ≤ 400 * (Bb + 2) + 1100 * N + 400 := by
  unfold cRep; omega

/-- Fine counted loop with a literal count. -/
theorem FSp.repLit {C : Fin HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ}
    {N c Bb : ℕ} (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes)
    (hNB : zsz (N : ℤ) ≤ Bb)
    (hb : ∀ k < N, FSp b (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) c) :
    FSp (.rep C (.lit (N : ℤ)) b) (encK s (F 0)) (encK s (F N)) (cLp N c Bb) := by
  have H := FSp.rep (n := .lit (N : ℤ)) hC5 hC hw (clean_lit _) trivial rfl hb
  refine H.mono ?_
  rw [cost_lit]
  have := cRep_le hNB
  unfold cLp; nlinarith

/-! ## Moves with a register count -/

/-! ## `dupK`, `dropK`, `zeroK`, `zipK` -/

theorem FSp.dupK_sol_aux {X Y Z C : Fin HS} (hXY : X ≠ Y) (hXZ : X ≠ Z) (hYZ : Y ≠ Z) (hXC : X ≠ C)
    (hYC : Y ≠ C) (hZC : Z ≠ C) (hX5 : X.val < 56) (hY5 : Y.val < 56) (hZ5 : Z.val < 56)
    (hC5 : C.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L l : List ℤ)
    (hfX : f X = L ++ l) (hfC : f C = []) (w Bb : ℕ) (hL : Bnd w L)
    (hn : zsz (L.length : ℤ) ≤ Bb) :
    FSp (dupK X Y Z C L.length) (encK s f)
      (encK s (Function.update (Function.update (Function.update f X l) Y (L.reverse ++ f Y)) Z
        (L.reverse ++ f Z))) (cLp L.length (9000 * (w + 2)) Bb) := by
  have H := FSp.repLit (C := C) (s := s) (F := dupSt f X Y Z L l)
    (N := L.length) (Bb := Bb) (c := 9000 * (w + 2))
    (b := .seq (.push Y (.reg X)) (.seq (.push Z (.reg X)) (.pop X))) hC5
    (fun k => by simp [dupSt, Function.update_apply, hXC.symm, hYC.symm, hZC.symm, hfC])
    (by simp [RS.writes, hXC.symm, hYC.symm, hZC.symm]) hn ?_
  · have e0 : dupSt f X Y Z L l 0 = f := by
      funext j; simp only [dupSt, Function.update_apply]
      split_ifs <;> simp_all
    have e1 : dupSt f X Y Z L l L.length = Function.update (Function.update
        (Function.update f X l) Y (L.reverse ++ f Y)) Z (L.reverse ++ f Z) := by
      simp [dupSt]
    rw [e0, e1] at H
    exact H
  · intro k hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : L.take (k + 1) = L.take k ++ [L[k]] := (List.take_concat_get' L k hk).symm
    obtain ⟨G, hG⟩ : ∃ G, G = Function.update (dupSt f X Y Z L l k) C [(L.length : ℤ) - k] :=
      ⟨_, rfl⟩
    rw [← hG]
    have hGX : G X = L[k] :: (L.drop (k + 1) ++ l) := by
      simp only [hG, dupSt, Function.update_apply, if_neg hXC, if_neg hXZ, if_neg hXY, if_true, hd,
        List.cons_append]
    have hb : zsz L[k] ≤ w := hL _ (List.getElem_mem hk)
    have h1 := Sp.push s G (i := Y) (e := .reg X) (B := w) hY5 (clean_reg hX5) (ok_reg hGX)
      trivial (bnd_reg hGX hb)
    rw [eval_reg hGX] at h1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G Y (L[k] :: G Y) := ⟨_, rfl⟩
    rw [← hG1] at h1
    have hG1X : G1 X = L[k] :: (L.drop (k + 1) ++ l) := by
      rw [hG1, Function.update_apply, if_neg hXY, hGX]
    have h2 := Sp.push s G1 (i := Z) (e := .reg X) (B := w) hZ5 (clean_reg hX5) (ok_reg hG1X)
      trivial (bnd_reg hG1X hb)
    rw [eval_reg hG1X] at h2
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 Z (L[k] :: G1 Z) := ⟨_, rfl⟩
    rw [← hG2] at h2
    have h3 := Sp.pop s G2 (i := X) (B := w) hX5 (by rw [hG2, Function.update_apply, if_neg hXZ, hG1X])
      hb
    have H3 := FSp.of_norep rfl (h1.seq (h2.seq h3))
    refine FSp.mono (FSp.congr H3 ?_) (by simp only [Ex.size]; omega)
    congr 1
    funext j
    simp only [hG2, hG1, hG, dupSt, Function.update_apply]
    by_cases h1 : j = X
    · simp only [h1, if_true, if_neg hXY, if_neg hXZ, if_neg hXC]
    by_cases h2 : j = Y
    · simp only [h2, if_true, if_neg hXY.symm, if_neg hYZ, if_neg hYC, if_neg hYZ.symm, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    by_cases h3 : j = Z
    · simp only [h3, if_true, if_neg hXZ.symm, if_neg hYZ.symm, if_neg hZC, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    · simp only [h1, h2, h3, if_false]

/-! ## Conditionals and the `c`-way branch -/

end KFD

