      have hcol := hn₁ ⟨s, hs⟩ (X.atkinLehnerPerm i)
      simp only [Matrix.transpose_apply] at hcol
      rw [← hcol]
      simp only [adjE_s M s q' hs hq5 hsq' hq'M hsM A X hPD]
      exact hbij.sum_comp (fun j => X.edgeHecke ⟨s, hs⟩ j (X.atkinLehnerPerm i))
