variable {s t α : ℕ} {B : Blocks}

lemma mem_Hset {i : ℕ} {h : ℤ} (hh : h ∈ Hset B i) :
    -(B.w : ℤ) ≤ h ∧ h ≤ B.w ∧ h ≠ 0 ∧ ¬ ((B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i) := by
  unfold Hset at hh
  rw [mem_filter, mem_image] at hh
  obtain ⟨⟨j, hj, rfl⟩, h1, h2⟩ := hh
  rw [mem_range] at hj
  refine ⟨by omega, by omega, h1, h2⟩

lemma emod_cases (hs : 0 < s) {a : ℤ} (h1 : -(s : ℤ) ≤ a) (h2 : a < 2 * s) :
    (0 ≤ a ∧ a < s ∧ a % s = a) ∨ (s ≤ a ∧ a % s = a - s) ∨ (a < 0 ∧ a % s = a + s) := by
  have hs' : (0 : ℤ) < s := by exact_mod_cast hs
  rcases lt_or_ge a 0 with ha | ha
  · right; right; refine ⟨ha, ?_⟩
    have e : (a + s) % s = a % s := by simp
    rw [← e]; exact Int.emod_eq_of_lt (by omega) (by omega)
  rcases lt_or_ge a s with hb | hb
  · left; exact ⟨ha, hb, Int.emod_eq_of_lt ha hb⟩
  · right; left; refine ⟨hb, ?_⟩
    have e : (a - s + s) % s = (a - s) % s := by simp
    rw [sub_add_cancel] at e
    rw [e]; exact Int.emod_eq_of_lt (by omega) (by omega)

