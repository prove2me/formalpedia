    have hψ : Ideal.Quotient.factor hle (Ideal.Quotient.mk _ (G.left 1)) =
        Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (G.left 1) := rfl
    rw [hψ, heG] at h2
