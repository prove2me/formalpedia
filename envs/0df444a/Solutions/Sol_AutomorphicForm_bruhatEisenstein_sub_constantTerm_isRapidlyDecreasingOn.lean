section Continuity

variable {G : Type*} [Group G] [TopologicalSpace G] [ContinuousMul G]
variable (K : Subgroup G) (φ : G → ℂ)

private theorem continuous_of_mem_V (hφ : Continuous φ) {ψ : G → ℂ} (hψ : ψ ∈ V K φ) : Continuous ψ := by
  induction hψ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, rfl⟩ := hx
    show Continuous fun x => φ (x * k)
    exact hφ.comp (continuous_id.mul continuous_const)
  | zero => exact continuous_const
  | add x y _ _ hx hy => exact hx.add hy
  | smul a x _ hx => exact hx.const_smul a

variable (ρ : ℝ → G) (hρK : ∀ θ, ρ θ ∈ K)

private def ρK (θ : ℝ) : K := ⟨ρ θ, hρK θ⟩

private theorem continuous_T_ρ (hφ : Continuous φ) (hρc : Continuous ρ) (v : V K φ) :
    Continuous fun θ => T K φ (ρK K ρ hρK θ) v := by
  rw [Topology.IsInducing.subtypeVal.continuous_iff]
  apply continuous_pi
  intro x
  show Continuous fun θ => (v : G → ℂ) (x * ρ θ)
  exact (continuous_of_mem_V K φ hφ v.2).comp (continuous_const.mul hρc)

variable {n : ℕ} (b : Module.Basis (Fin n) ℂ (V K φ))

private def R (θ : ℝ) : (Fin n → ℂ) →L[ℝ] (Fin n → ℂ) :=
  LinearMap.toContinuousLinearMap (((b.equivFun.conj (T K φ (ρK K ρ hρK θ))) : (Fin n → ℂ) →ₗ[ℂ] (Fin n → ℂ)).restrictScalars ℝ)

omit [TopologicalSpace G] [ContinuousMul G] in
private theorem R_apply (θ : ℝ) (w : Fin n → ℂ) :
    R K φ ρ hρK b θ w = b.equivFun (T K φ (ρK K ρ hρK θ) (b.equivFun.symm w)) := rfl

omit [TopologicalSpace G] [ContinuousMul G] in
private theorem R_zero (hρ0 : ρ 0 = 1) : R K φ ρ hρK b 0 = 1 := by
  have h1 : ρK K ρ hρK 0 = 1 := Subtype.ext hρ0
  apply ContinuousLinearMap.ext
  intro w
  rw [R_apply, h1, T_one, LinearMap.id_apply, LinearEquiv.apply_symm_apply, ContinuousLinearMap.one_apply]

omit [TopologicalSpace G] [ContinuousMul G] in
private theorem R_add (hρadd : ∀ s t, ρ (s + t) = ρ s * ρ t) (s t : ℝ) :
    R K φ ρ hρK b (s + t) = R K φ ρ hρK b s * R K φ ρ hρK b t := by
  have hk : ρK K ρ hρK (s + t) = ρK K ρ hρK s * ρK K ρ hρK t := Subtype.ext (hρadd s t)
  apply ContinuousLinearMap.ext
  intro w
  rw [ContinuousLinearMap.mul_apply, R_apply, R_apply, R_apply, hk, T_mul, LinearMap.comp_apply,
    LinearEquiv.symm_apply_apply]

private theorem continuous_R [FiniteDimensional ℂ (V K φ)] (hφ : Continuous φ) (hρc : Continuous ρ) :
    Continuous (R K φ ρ hρK b) := by
  rw [continuous_clm_apply]
