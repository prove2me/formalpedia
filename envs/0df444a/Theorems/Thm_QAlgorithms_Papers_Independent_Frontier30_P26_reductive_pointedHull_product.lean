section LieGeometry

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 3.10, PDF p. 10. Internal direct-product formulation, including nonhermitian factors.
The tuple-sum map is bijective, so the right side is precisely the stated product set. -/
theorem reductive_pointedHull_product [LieAlgebra.HasCentralRadical ℝ G]
    (n : ℕ) (K : LieIdeal ℝ G) (I : Fin n → LieIdeal ℝ G)
    (hk : MaximalCompactIdeal K)
    (hsimple : ∀ j, LieAlgebra.IsSimple ℝ (I j))
    (hnoncompact : ∀ j, ¬ CompactlyEmbedded (Set.univ : Set (I j)))
    (hdecomp : Function.Bijective (fun p : K × (∀ j, I j) =>
      (p.1 : G) + (∑ j, (p.2 j : G))))
    (W : ∀ j, Set (I j))
    (hw : ∀ j, (Hermitian (G := I j) → MaximalPointedInvariantCone (W j)) ∧
      (¬ Hermitian (G := I j) → W j = {0})) (x : G) :
    x ∈ pointedHullElements ↔ ∃ p : K × (∀ j, I j),
      x = (p.1 : G) + (∑ j, (p.2 j : G)) ∧
      ∀ j, p.2 j ∈ W j ∪ (Neg.neg '' W j) := by sorry

end LieGeometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
