    simp only [T, List.drop_zero, List.take_zero, oprod_nil, gflat_nil, List.reverse_nil]
    rw [← h1]; simp [ints]
  have H := rptX_runs (I := I) (iprog := iprog) (X := rN) (A := NLogN.KFM.oA) (C := NLogN.KFM.oC) (D := NLogN.KFM.oD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    A.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    (obBU pM) (cObU B.length w Δ φ)
    (by
      intro k hk LA LC LD
      have hd : A.drop k = A[k] :: A.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hmem := List.getElem_mem hk
      have Hb := obBU_runs (I := I) (iprog := iprog) hM hdom hΦ Δ (cf3 (T k) NLogN.KFM.oA NLogN.KFM.oC NLogN.KFM.oD LA LC LD)
        A[k] B (ints (gflat (A.drop (k + 1))) ++ R1) R2 LR LX LX2
        (by simp +decide only [T, cf3, IState.upd_G, if_true, if_false]
