section
-- module Solutions.Q229_CA.CoarseAssembly_FilledEdges
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # Linear edges in the filled polygon

The polygon's straight paths map to the actual barycentric Rips edges.
These identities supply the filling factorization of the boundary walk.
-/

noncomputable section

namespace CoarseAssembly

open Rips

theorem realLatticeRadius_add_le (p q : ℝ × ℝ) :
    realLatticeRadius (p + q) ≤ realLatticeRadius p + realLatticeRadius q := by
  have hp := realLatticeRadius_le_iff.mp (le_refl (realLatticeRadius p))
  have hq := realLatticeRadius_le_iff.mp (le_refl (realLatticeRadius q))
  apply realLatticeRadius_le_iff.mpr
  refine ⟨(abs_add_le _ _).trans (add_le_add hp.1 hq.1),
    (abs_add_le _ _).trans (add_le_add hp.2.1 hq.2.1), ?_⟩
  change |(p.1 + q.1) + (p.2 + q.2)| ≤ _
  rw [show (p.1 + q.1) + (p.2 + q.2) = (p.1 + p.2) + (q.1 + q.2) by ring]
  exact (abs_add_le _ _).trans (add_le_add hp.2.2 hq.2.2)

theorem realLatticeRadius_vertex (v : LatticeVertex) :
    realLatticeRadius (realVertex v) = (latticeRadius v : ℝ) := by
  unfold realLatticeRadius realVertex latticeRadius
  push_cast
  rfl

def filledVertex {j : ℕ} (v : Disc j) : FilledDisc j :=
  ⟨realVertex v.val, by rw [realLatticeRadius_vertex]; exact_mod_cast v.property⟩

end CoarseAssembly

end

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_HexagonSides
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # The six oriented sides of the lattice hexagon

These explicit vertex sequences support the boundary-walk construction.
They run counterclockwise from `(j,0)`; only the final side crosses the
half-open positive ray used by the integral charge.
-/

namespace CoarseAssembly

theorem hexagonPoint_charge (s : Fin 6) (j k : ℕ) (hk : k < j) :
    latticeCharge (hexagonPoint s j k) (hexagonPoint s j (k + 1)) =
      if s = 5 ∧ k + 1 = j then 1 else 0 := by
  have hk' : (k : ℤ) < j := by exact_mod_cast hk
  have hj : (0 : ℤ) < j := by exact_mod_cast (Nat.zero_lt_of_lt hk)
  have hn : (0 : ℤ) ≤ k := by positivity
  fin_cases s <;> simp only [hexagonPoint, latticeCharge, Nat.cast_add, Nat.cast_one]
  all_goals split_ifs <;> first | omega | (norm_num at * <;> omega) | (simp_all <;> omega)

end CoarseAssembly

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_KazhdanInput
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # The fixed published spectral-gap input

The elementary matrices below and their inverses give a fixed finite
symmetric generating set of SL3(Z), with the identity included. The input
used in the conditional development is exactly the uniform lazy-averaging
estimate on the finite congruence quotients, with the standard ample
coefficient space. It is the specialization of Bekka–de la Harpe–Valette
(2008), Proposition 1.3.2 and Example 1.7.4, explained in manuscript §5.2.

No proof of that published input is asserted during the conditional phase.
The spatial Roe transfer itself is proved from it below.
-/

noncomputable section

namespace CoarseAssembly

open Congruence

theorem elementaryMoves_nonempty : elementaryMoves.Nonempty :=
  ⟨1, one_mem_symmetricMoves _⟩

end CoarseAssembly

end

end OAI
end

