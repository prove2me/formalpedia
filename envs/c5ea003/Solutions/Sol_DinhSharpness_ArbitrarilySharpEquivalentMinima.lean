section DinhSharpnessBundleModule3
/-!
The coordinate amplification step in Dinh et al., arXiv:1703.04933v2,
Section 4.2, Theorem 4, PDF pp. 5--6 (unnumbered displays).
-/

noncomputable section

namespace DinhSharpness

variable {d h : ℕ}

theorem coordinate_diag_le_norm
    (B : Parameter d h →L[ℝ] Parameter d h →L[ℝ] ℝ) (i : Coordinate d h) :
    B (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) ≤ ‖B‖ := by
  have hn := B.le_opNorm₂ (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)
  simp only [PiLp.norm_single, norm_one, mul_one, Real.norm_eq_abs] at hn
  exact (le_abs_self _).trans hn

theorem exists_rescaling_large_norm
    (H : Parameter d h →L[ℝ] Parameter d h →L[ℝ] ℝ)
    (B : ℝ → Parameter d h →L[ℝ] Parameter d h →L[ℝ] ℝ)
    (hcov : ∀ α : ℝ, 0 < α → ∀ u v : Parameter d h,
      B α u v = H (scale α⁻¹ u) (scale α⁻¹ v))
    (i : Coordinate d h)
    (hi : 0 < H (EuclideanSpace.single i 1) (EuclideanSpace.single i 1))
    (M : ℝ) (hM : 0 < M) : ∃ α : ℝ, 0 < α ∧ M ≤ ‖B α‖ := by
  let γ := H (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)
  have hγ : 0 < γ := hi
  let β := M / γ + 1
  have hβ : 0 < β := by dsimp [β]; positivity
  have hβone : 1 ≤ β := by dsimp [β]; linarith [div_pos hM hγ]
  have hβγ : M < β * γ := by
    dsimp [β]
    rw [add_mul, div_mul_cancel₀ _ hγ.ne', one_mul]
    linarith
  have hlarge : M ≤ β * (β * γ) := by
    have hp : 0 < β * γ := mul_pos hβ hγ
    nlinarith
  cases i with
  | inl ij =>
      refine ⟨β⁻¹, inv_pos.mpr hβ, ?_⟩
      have hdiag := coordinate_diag_le_norm (B β⁻¹) (Sum.inl ij)
      rw [hcov β⁻¹ (inv_pos.mpr hβ)] at hdiag
      simp only [inv_inv, scale_single_inl, map_smul, ContinuousLinearMap.smul_apply,
        smul_eq_mul] at hdiag
      exact hlarge.trans hdiag
  | inr j =>
      refine ⟨β, hβ, ?_⟩
      have hdiag := coordinate_diag_le_norm (B β) (Sum.inr j)
      rw [hcov β hβ] at hdiag
      simp only [scale_single_inr, inv_inv, map_smul, ContinuousLinearMap.smul_apply,
        smul_eq_mul] at hdiag
      exact hlarge.trans hdiag

end DinhSharpness
end -- original EOF-open anonymous section
end DinhSharpnessBundleModule3
