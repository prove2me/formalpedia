theorem solution {h : ℝ} {F b : ℝ → ℝ} {f₁ b₁ C_F C_b ε : ℝ} (hε : 0 < ε)
    (hvalF : ∀ x ∈ Ioo (0:ℝ) ε, |F x - (1 + f₁ * x)| ≤ C_F * x ^ 2)
    (hvalb : ∀ x ∈ Ioo (0:ℝ) ε, |b x - (1 + b₁ * x)| ≤ C_b * x ^ 2) :
    ∃ δ, 0 < δ ∧ δ ≤ ε ∧
      (∀ x ∈ Ioo (0:ℝ) δ, 1 / 2 ≤ 1 - h * x ∧ 0 < F x ∧ F x ≤ 2 ∧ 0 < b x ∧ b x ≤ 2) := by
  have hF1 : Tendsto F (𝓝[>] (0:ℝ)) (𝓝 1) := k0_value hε hvalF
  have hb1v : Tendsto b (𝓝[>] (0:ℝ)) (𝓝 1) := k0_value hε hvalb
  have hcl : ∀ g : ℝ → ℝ, Tendsto g (𝓝[>] (0:ℝ)) (𝓝 1) →
      ∀ᶠ x in 𝓝[>] (0:ℝ), 0 < g x ∧ g x ≤ 2 := by
    intro g hg
    have h : ∀ᶠ x in 𝓝[>] (0:ℝ), |g x - 1| < 1 / 2 := by
      have := (tendsto_iff_norm_sub_tendsto_zero.mp hg).eventually
        (gt_mem_nhds (by norm_num : (0:ℝ) < 1 / 2))
      simpa [Real.norm_eq_abs] using this
    filter_upwards [h] with x hx
    have := abs_lt.mp hx
    exact ⟨by linarith [this.1], by linarith [this.2]⟩
  have hu : ∀ᶠ x in 𝓝[>] (0:ℝ), 1 / 2 ≤ 1 - h * x := by
    have hcont : Tendsto (fun x : ℝ => 1 - h * x) (𝓝[>] (0:ℝ)) (𝓝 (1 - h * 0)) :=
      ((continuous_const.sub (continuous_const.mul continuous_id)).tendsto 0)
        |>.mono_left nhdsWithin_le_nhds
    have : ∀ᶠ x in 𝓝[>] (0:ℝ), |(1 - h * x) - 1| < 1 / 2 := by
      have := (tendsto_iff_norm_sub_tendsto_zero.mp (by simpa using hcont)).eventually
        (gt_mem_nhds (by norm_num : (0:ℝ) < 1 / 2))
      simpa [Real.norm_eq_abs] using this
    filter_upwards [this] with x hx
    have := abs_lt.mp hx
    linarith [this.1, this.2]
  have hall : ∀ᶠ x in 𝓝[>] (0:ℝ),
      1 / 2 ≤ 1 - h * x ∧ 0 < F x ∧ F x ≤ 2 ∧ 0 < b x ∧ b x ≤ 2 := by
    filter_upwards [hu, hcl F hF1, hcl b hb1v] with x a b1 b2
    exact ⟨a, b1.1, b1.2, b2.1, b2.2⟩
  have hsub : ∀ᶠ x in 𝓝[>] (0:ℝ), x ∈ Ioo (0:ℝ) ε := Ioo_mem_nhdsGT hε
  obtain ⟨δ₀, hδ₀, hsub'⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp (hall.and hsub)
  refine ⟨min δ₀ (ε / 2), lt_min hδ₀ (by positivity),
    le_trans (min_le_right _ _) (by linarith), ?_⟩
  intro x hx
  exact (hsub' ⟨hx.1, lt_of_lt_of_le hx.2 (min_le_left _ _)⟩).1
