set_option autoImplicit false
universe u v
open scoped Pointwise Classical

theorem Glauberman.Dickson.huppert_II_8_3_split_torus_reflection_data
    {F : Type u} [Field F] [Finite F] {p f : ℕ} [Fact p.Prime]
    (hFcard : Nat.card F = p ^ f) :
    ∃ U : Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F),
      ∃ w : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F,
      IsCyclic U ∧
      Nat.card U =
        (Nat.card F - 1) / Nat.gcd (Nat.card F - 1) 2 ∧
      w ∈ Subgroup.normalizer (U : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) ∧
      w ∉ U ∧
      w * w = 1 ∧
      (∀ t : Matrix.ProjectiveSpecialLinearGroup (Fin 2) F, t ∈ U → w * t * w⁻¹ = t⁻¹) ∧
      Nat.card (U ⊔ Subgroup.zpowers w :
        Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) = 2 * Nat.card U ∧
      ∀ R : Subgroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F), R ≤ U → R ≠ ⊥ →
        Subgroup.normalizer (R : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)) =
          U ⊔ Subgroup.zpowers w := by sorry
