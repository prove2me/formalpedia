namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma code_no_memory (N : ℕ) : NoMemory (code N) := by
  simp [code,heightStart,heightLoop,heightBody,heightStartAtoms,heightBodyAtoms,rootStart,rootPrefix,
    rootStartAtoms,rootPower,rootPowerAtoms,rootLoop,rootBody,nadd,exponentStart,exponentAtoms,
    qualityLoop,qualityBody,qualityBodyAtoms,Structured.sequence,NoMemory,NoStore]
lemma code_eval (N m : ℕ) (hm : 2 ≤ m) (s : Data) (hsize : s.natReg 64 = m) (hunit : s.natReg 26 = 1) :
    ∃ t cost, Eval (code N) s cost t ∧ t.realReg 442 = computableCutQuality N m ∧
      cost ≤ 4*cutLogHeight m+8*cutRoot m+4*(N*(cutRoot m)^11)+30 ∧
      t.realMem = s.realMem ∧ t.natMem = s.natMem := by
  have hs0 := heightStarted_rep s m hsize hunit
  obtain ⟨h,c1,he1,hr1,hh1,hc1⟩ := heightLoop_eval m hm (heightStarted s) hs0.1 hs0.2
  have hs2 := rootStarted_rep (cutLogHeight m) h hh1 hr1.unit
  obtain ⟨r,c2,he2,hr2,hh2,hc2⟩ := rootLoop_eval (cutLogHeight m) (rootStarted h) hs2.1
  have hr : r.natReg 408 = cutRoot m := hh2
  have heFields := exponentStarted_fields N r
  let E := N*(r.natReg 408)^11
  have hs3 : QualityRep E (exponentStarted N r) := by
    exact ⟨0,Nat.zero_le _,by simpa using heFields.2.1,by simpa only [pow_zero] using heFields.2.2.1,
      heFields.1,heFields.2.2.2.1,heFields.2.2.2.2⟩
  obtain ⟨t,c3,he3,hout,hc3⟩ := qualityLoop_eval E (exponentStarted N r) hs3
  have hc3' : c3 ≤ 4*E+2 := by simpa only [heFields.2.1,Nat.floor_zero,Nat.sub_zero] using hc3
  have hc2' : c2 ≤ 8*cutRoot m+2 := by
    rw [hs2.2] at hc2
    change c2 ≤ 8*(cutRoot m-1)+2 at hc2
    omega
  have hE : E = N*(cutRoot m)^11 := by dsimp [E];rw [hr]
  have he : Eval (code N) s (3+(c1+(8+(c2+(13+c3))))) t :=
    Eval.seq (heightStart_eval s) (Eval.seq he1 (Eval.seq (rootStart_eval h) (Eval.seq he2 (Eval.seq (exponentStart_eval N r) he3))))
  refine ⟨t,3+(c1+(8+(c2+(13+c3)))),he,?_,?_,(he.no_memory (code_no_memory N)).1,(he.no_memory (code_no_memory N)).2⟩
  · rw [hE] at hout
    exact hout
  · rw [hE] at hc3'
    omega
end DecrAlmostLinearSSSP.Decremental.CutQualityNative
