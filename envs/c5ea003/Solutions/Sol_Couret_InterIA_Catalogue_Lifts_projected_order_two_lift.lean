theorem p2m_local_projected_order_two_lift (m : ℕ) (hm : 0 < m) (r : ZMod (2*m))
    (ho : addOrderOf (projection m r)=2) : r+r=m := by
  have hδ : projection m r ≠ 0 := by intro hz; simpa [hz] using ho
  have hz : projection m (r+r)=0 := by
    rw [map_add]
    have h := addOrderOf_nsmul_eq_zero (projection m r)
    simpa only [ho,two_nsmul] using h
  rcases (projection_kernel m hm (r+r)).mp hz with h|h
