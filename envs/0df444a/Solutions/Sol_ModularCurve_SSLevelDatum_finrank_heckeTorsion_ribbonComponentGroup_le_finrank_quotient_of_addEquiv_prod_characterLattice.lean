    adjE M s q' A X ℓ y x = Divisor.correspondence (heckeAlphaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ) (heckeBetaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ)
          (X.legsIntegral (M * s) ℓ).1 (X.legsIntegral (M * s) ℓ).2 (Finsupp.single x.1 1) y.1 := by
