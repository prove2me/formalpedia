/-!
# B-line IL, the `J` kernel (B4), part 8: one backward record

The backward table `flatB k bs = ⋃_j (|cb| :: cb ++ |cz| :: cz ++ [pv, iv, fl])` (with the
reciprocal `iv = ivOf k pv`) lies on `dTJ`. Record `j` computes both dot products against
`Z = (bwdS j).1` and `BZ = (bwdS j).2`, the numerator `bt_j - d₁ - d₂`, its fixed-point quotient
by `pv` (`recip`, or `0` for `pv = 0`), pushes it onto `Z` and, for `fl = 1`, onto `BZ`
(`stepB`): `bwd_body`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

theorem bwdS_length2 (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) {j : ℕ}
    (hb : j ≤ bs.length) (ht : j ≤ bts.length) : (bwdS P bs bts j).2.length ≤ j := by
  induction j with
  | zero => simp [bwdS_zero]
  | succ j ih =>
    rw [bwdS_succ P bs bts (by omega) (by omega)]
    have := ih (by omega) (by omega)
    simp only [stepB]; split_ifs <;> simp <;> omega

section bwd
variable (P k : ℕ) (F : Fin HS → List ℤ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts R T0 : List ℤ)

variable {P k F bs bts R T0}

theorem bnd_mono {B B' : ℕ} {l : List ℤ} (h : Bnd B l) (hB : B ≤ B') : Bnd B' l :=
  fun a ha => le_trans (h a ha) hB

end bwd

end J6Seg.JK

