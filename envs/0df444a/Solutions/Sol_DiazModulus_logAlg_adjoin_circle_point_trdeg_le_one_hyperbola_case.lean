import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_mem_logAlg_adjoin_circle_point_iff
import Theorems.Thm_DiazModulus_isAlgebraic_of_hyperbola_pair_not_algebraicIndependent
import Theorems.Thm_DiazModulus_logAlg_adjoin_circle_point_trdeg_le_one_logAlg_part_eq_zero
import Theorems.Thm_DiazModulus_hermite_lindemann_holds

open Complex ComplexConjugate

/-! # The hyperbola case of the trichotomy: `S ⊆ ℚu + ℚū`

Let `F` be the field generated by `ℒ̃`, `u` transcendental over `F` with `u ū` algebraic,
`S ⊆ ℒ_u = ℒ + ℚu + ℚū`, and `ℚ[S]` of transcendence degree at most one, containing
`c₁ + u` and `c₂ + ū` with `c₁, c₂ ∈ ℒ`. Two algebraically independent elements of `ℚ[S]`
would give two independent elements of that ring, against the bound; so the pair
`(c₁ + u, c₂ + ū)` is algebraically dependent. Algebraic numbers and `ℒ` lie in `F`, so the
hyperbola step `isAlgebraic_of_hyperbola_pair_not_algebraicIndependent` makes `c₁` and `c₂`
algebraic, and Hermite–Lindemann (their exponentials are algebraic) makes them `0`. Hence
`u, ū ∈ ℚ[S]`. Each `z ∈ S` is `c + p u + q ū` with `c ∈ ℒ` (`mem_logAlg_adjoin_circle_point_iff`),
so `c = z − p u − q ū ∈ ℒ ∩ ℚ[S]`. Then `logAlg_adjoin_circle_point_trdeg_le_one_logAlg_part_eq_zero`,
applied with the point `u = 0 + 1·u + 0·ū ∈ ℚ[S]`, gives `c = 0`, that is `z = p u + q ū`. -/

namespace R19_T2
open DiazModulus

/-- Algebraic numbers lie in the field generated by `ℒ̃`. -/
lemma mem_closure_of_isAlgebraic {a : ℂ} (ha : IsAlgebraic ℚ a) :
    a ∈ Subfield.closure (LogAlgTilde : Set ℂ) := by
  apply Subfield.subset_closure
  have h1 : (1 : ℂ) ∈ LogAlgTilde := Submodule.subset_span (Set.mem_insert _ _)
  have := LogAlgTilde.smul_mem (⟨a, mem_Qbar_iff.2 ha⟩ : Qbar) h1
  simpa [Subfield.smul_def] using this

/-- `ℒ` lies in the field generated by `ℒ̃`. -/
lemma mem_closure_of_mem_logAlg {c : ℂ} (hc : c ∈ LogAlg) :
    c ∈ Subfield.closure (LogAlgTilde : Set ℂ) :=
  Subfield.subset_closure (Submodule.subset_span (Set.mem_insert_of_mem _ hc))

/-- A ring `ℚ[S]` of transcendence degree at most one holds no algebraically independent pair. -/
lemma not_algebraicIndependent_pair (S : Set ℂ)
    (htr : Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ S) ≤ 1) {a b : ℂ}
    (ha : a ∈ Algebra.adjoin ℚ S) (hb : b ∈ Algebra.adjoin ℚ S) :
    ¬ AlgebraicIndependent ℚ ![a, b] := by
  intro hind
  let v : Fin 2 → Algebra.adjoin ℚ S := ![⟨a, ha⟩, ⟨b, hb⟩]
  have hv : AlgebraicIndependent ℚ v := by
    refine AlgebraicIndependent.of_comp (Algebra.adjoin ℚ S).val ?_
    convert hind using 1
    funext i
    fin_cases i <;> rfl
  have hcard := hv.cardinalMk_le_trdeg
  rw [show Cardinal.mk (Fin 2) = 2 by simp] at hcard
  have := hcard.trans htr
  norm_num at this

/-- Hermite–Lindemann on `ℒ`: an algebraic element of `ℒ` is `0`. -/
lemma eq_zero_of_isAlgebraic {c : ℂ} (hc : c ∈ LogAlg) (halg : IsAlgebraic ℚ c) : c = 0 := by
  by_contra h
  exact hermite_lindemann_holds c h halg hc

/-- A `ℚ`-subalgebra of `ℂ` is stable under multiplication by rationals. -/
lemma ratMul_mem (A : Subalgebra ℚ ℂ) (r : ℚ) {z : ℂ} (hz : z ∈ A) : (r : ℂ) * z ∈ A := by
  have := A.smul_mem hz r
  rwa [Rat.smul_def] at this

end R19_T2

open DiazModulus R19_T2 in
theorem solution
    (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u)
    (S : Set ℂ) (hS : ∀ z ∈ S, z ∈ (Submodule.span ℚ LogAlg ⊔ Submodule.span ℚ ({u, conj u} : Set ℂ)))
    (htr : Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ S) ≤ 1)
    (c₁ c₂ : ℂ) (hc₁ : c₁ ∈ LogAlg) (hc₂ : c₂ ∈ LogAlg)
    (he₁ : c₁ + u ∈ Algebra.adjoin ℚ S) (he₂ : c₂ + conj u ∈ Algebra.adjoin ℚ S) :
    ∀ z ∈ S, ∃ p q : ℚ, z = (p : ℂ) * u + (q : ℂ) * conj u := by
  -- the pair is dependent, so `c₁ = c₂ = 0`
  obtain ⟨h₁, h₂⟩ := DiazModulus.isAlgebraic_of_hyperbola_pair_not_algebraicIndependent
    (Subfield.closure (LogAlgTilde : Set ℂ)) u hu (mem_closure_of_isAlgebraic hρ) c₁ c₂
    (mem_closure_of_mem_logAlg hc₁) (mem_closure_of_mem_logAlg hc₂)
    (not_algebraicIndependent_pair S htr he₁ he₂)
  rw [eq_zero_of_isAlgebraic hc₁ h₁, zero_add] at he₁
  rw [eq_zero_of_isAlgebraic hc₂ h₂, zero_add] at he₂
  -- the `ℒ`-part of each `z ∈ S` lies in `ℒ ∩ ℚ[S]`, so it is `0`
  intro z hz
  obtain ⟨c, hc, p, q, rfl⟩ := ((DiazModulus.mem_logAlg_adjoin_circle_point_iff u).1 _).1 (hS _ hz)
  have hcA : c ∈ Algebra.adjoin ℚ S := by
    have := sub_mem (sub_mem (Algebra.subset_adjoin hz) (ratMul_mem _ p he₁)) (ratMul_mem _ q he₂)
    convert this using 1
    ring
  have h0 : (0 : ℂ) ∈ LogAlg := by
    show IsAlgebraic ℚ (Complex.exp 0)
    rw [Complex.exp_zero]
    exact isAlgebraic_one
  have hc0 := DiazModulus.logAlg_adjoin_circle_point_trdeg_le_one_logAlg_part_eq_zero u hρ hu S
    htr 0 1 0 h0 (Or.inl one_ne_zero) (by simpa using he₁) c hc hcA
  exact ⟨p, q, by rw [hc0, zero_add]⟩
