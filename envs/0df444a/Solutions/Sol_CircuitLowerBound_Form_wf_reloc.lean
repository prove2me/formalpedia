open CircuitLowerBound
open ENP Groundwork
open CircuitLowerBound.Form
namespace CircuitLowerBound.Form
theorem _root_.solution {L N : ℕ} {o : List ℕ} (ho : ∀ i, o.getD i 0 < N) (off : ℕ) {C : List GateD} (hC : WF L C) : WF N (reloc L N o off C) := by
  intro t h
  have ht : t < C.length := by rwa [length_reloc] at h
  have hw := hC t ht
  simp only [reloc, List.getElem_map]
  exact ⟨rho_lt ho off hw.1, rho_lt ho off hw.2⟩
end CircuitLowerBound.Form
