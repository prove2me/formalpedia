theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 2 (christoffel (gEF5 mu beta) (giEF5 mu beta) 2 2 2) x =
    (2 * x 2 ^ 2 - 2 * x 2 + 1) / (2 * x 2 ^ 2 * (1 - x 2) ^ 2) := by
  have hu := domU5_u_pos hx; have h1u := domU5_1mu_pos hx
  rw [pd_congr_of_eqOn isOpen_domU5 hx (eqOn_G2_22 mu beta), pd]
  have hslice : (fun t : ℝ =>
      (2 * (Function.update x 2 t) 2 - 1) / (2 * (Function.update x 2 t) 2 * (1 - (Function.update x 2 t) 2)))
    = fun t => (2 * t - 1) / (2 * t * (1 - t)) := by
    funext t; simp [Function.update_apply]
  rw [hslice]
  have hnum : HasDerivAt (fun t : ℝ => 2 * t - 1) 2 (x 2) :=
    ((hasDerivAt_id' (x 2)).const_mul 2 |>.sub (hasDerivAt_const (x 2) (1:ℝ))).congr_deriv (by ring)
  have h1mt : HasDerivAt (fun t : ℝ => 1 - t) (-1) (x 2) :=
    ((hasDerivAt_const (x 2) (1:ℝ)).sub (hasDerivAt_id' (x 2))).congr_deriv (by ring)
  have hden : HasDerivAt (fun t : ℝ => 2 * t * (1 - t)) (2 - 4 * x 2) (x 2) :=
    ((hasDerivAt_id' (x 2)).const_mul 2 |>.mul h1mt).congr_deriv (by ring)
  exact (hnum.fun_div hden (mul_ne_zero (mul_ne_zero two_ne_zero hu.ne') h1u.ne')).congr_deriv
    (by field_simp [hu.ne', h1u.ne']; ring) |>.deriv
