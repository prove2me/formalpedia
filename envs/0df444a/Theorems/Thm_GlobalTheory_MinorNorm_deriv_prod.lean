variable {R : Type} [CommRing R] [Algebra ℂ R]

theorem GlobalTheory.MinorNorm.deriv_prod {ι : Type} [DecidableEq ι] (D : Derivation ℂ R R) (s : Finset ι) (f : ι → R) :
    D (∏ i ∈ s, f i) = ∑ i ∈ s, (∏ j ∈ s.erase i, f j) • D (f i) := by sorry
