        (P * 2 ^ u * Mid * 2 ^ u * S)) ++ R0)) c ∧
      (c : ℝ) ≤ Ksw * (((P * 2 ^ u * Mid * 2 ^ u * S * B : ℕ) : ℝ) + 1) * (u : ℝ) ^ τ := by
  set zs := flR recs (P * 2 ^ u * Mid * 2 ^ u * S)
  set xs : List (ZMod 2) := zs.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hx : enc2 xs = zs := KFL.bits_enc2 zs hb
  have hvol : vol (binShape [P] [Mid] [S * B] (2 ^ u)) = P * 2 ^ u * Mid * 2 ^ u * S * B := by
    simp [binShape, vol]; ring
  have hzl : zs.length = P * 2 ^ u * Mid * 2 ^ u * S * B := by
    rw [length_flR hlen]; try ring
  obtain ⟨c, Hc, hc⟩ := H u [P] [Mid] [S * B] hu (by intro a ha; simp at ha; omega) (by intro a ha; simp at ha; omega)
    (by intro a ha; simp at ha; subst ha; exact Nat.mul_pos hS hB) I t xs R0 (by rw [hx]; exact h0) (by simp [xs, hzl, hvol])
    eP eG eS eU Bb (by rw [hvol]; exact hBb) hsz nP nG nS nU
    (by simpa [vol] using E1) (by simpa [vol] using E2) (by simpa [vol] using E3) E4
