theorem solution (U : TypeDensity.SurfaceUniverse) (hE1 : U.ChildTypesExist)
    (δ : ∀ i : U.ι, Ideal (U.M i).R → ℕ) (hE2 : U.InvariantDecreases δ) (i : U.ι) (σ : TypeDensity.FactorType) :
    U.typeEvent i σ = U.termTypeEvent i σ :=
  Set.Subset.antisymm (fun J hJ ↦ ⟨hJ, TypeDensity.etale_terminates_of_invariant U hE1 δ hE2 i J hJ.1 σ hJ.2⟩)
    Set.inter_subset_left
