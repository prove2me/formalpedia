theorem solution {t₀ : ℝ} (ht₀ : t₀ ∈ Ici (3:ℝ)) :
    ContinuousWithinAt Y (Ici 3) t₀ := by
  set R := max (t₀ + 1) 4 with hRdef
  have h3R : (3:ℝ) ≤ R := by
    have h4 : (4:ℝ) ≤ R := le_max_right _ _
    linarith
  have ht₀R : t₀ ≤ R := by
    have : t₀ + 1 ≤ R := le_max_left _ _
    linarith
  have hu : Summable (fun n : ℕ => (R - 3) ^ n / (Nat.factorial n : ℝ)) :=
    Real.summable_pow_div_factorial (R - 3)
  have hcont : ContinuousOn (fun x => ∑' n, Yfun n x) (Icc 3 R) := by
    refine continuousOn_tsum (fun n => (continuousOn_Yfun n).mono ?_) hu (fun n x hx => ?_)
    · intro x hx; exact hx.1
    · rw [Real.norm_eq_abs]
      have h1 : |Yfun n x| ≤ (x - 3) ^ n / (Nat.factorial n : ℝ) :=
        Yfun_bound_mem n h3R x ⟨hx.1, hx.2⟩
      have hpow : (x - 3) ^ n ≤ (R - 3) ^ n :=
        pow_le_pow_left₀ (by linarith [hx.1]) (by linarith [hx.2]) n
      have hf0 : (0:ℝ) < (Nat.factorial n : ℝ) := by positivity
      calc |Yfun n x| ≤ (x - 3) ^ n / (Nat.factorial n : ℝ) := h1
        _ ≤ (R - 3) ^ n / (Nat.factorial n : ℝ) := by gcongr
  have hEq : ∀ x ∈ Icc (3:ℝ) R, Y x = ∑' n, Yfun n x := fun x _ => rfl
  have hY : ContinuousOn Y (Icc 3 R) := hcont.congr (fun x hx => (hEq x hx).symm)
  refine (hY t₀ ⟨ht₀, ht₀R⟩).mono_of_mem_nhdsWithin ?_
  rw [mem_nhdsWithin_iff_exists_mem_nhds_inter]
  refine ⟨Iio R, ?_, ?_⟩
  · exact Iio_mem_nhds (by linarith [le_max_left (t₀+1) (4:ℝ)])
  · intro x hx
    exact ⟨hx.2, le_of_lt hx.1⟩
