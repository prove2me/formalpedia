theorem solution {n : ℕ} (G : SimpleGraph (Fin n)) (M : EdgeSet n)
    (hMG : M ⊆ graphEdges G) (hM : IsMatching M) (hmax : M.card = OPT G) (a b p : ℝ) (ha : 0 ≤ a) (hab : a < b) (hb : b ≤ 3/8)
    (hp0 : 0 ≤ p) (hp2 : p ≤ 2/3)
    (t : Times G) :
    2 * ((shadowAt G t b).card - (shadowAt G t a).card : ℝ) ≥
      U G M t a - U G M t b + (M2 G M a b t).card := by
  exact retain_accounting G M hM a b (le_of_lt hab) t


