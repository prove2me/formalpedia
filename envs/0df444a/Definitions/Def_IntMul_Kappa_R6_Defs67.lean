noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab (passP drP rdP itO bkP)

/-- The axis program at the stack / procedure choices. -/
def axBody {Pp : ℕ} (dA dF : Fin HS) (ρ : Fin 19 → Fin HS) (eF eB eK eJK eC eCd eJ eJd pM : Fin Pp)
    (u1 d1 u3 d3 u5 d5 u7 d7 : IStmt HS Pp) : IStmt HS Pp :=
