theorem mem_axTr {L : LP} {op : Bool} {Q h i tp : ℕ} {t : ℕ × ℕ × ℕ} (hh : h ≤ L.ℓ)
    (ht : t ∈ axTr L op Q h i tp) : t.1 ≤ Q + 2 ^ L.ℓ ∧ t.2.1 ≤ L.n - 1 ∧ t.2.2 ≤ L.n - 1 := by
  simp only [axTr, List.mem_map, List.mem_range] at ht
  obtain ⟨u, hu, rfl⟩ := ht
  simp only
  refine ⟨?_, by omega, by omega⟩
  have : 2 ^ (L.ℓ - h + u) ≤ 2 ^ L.ℓ := Nat.pow_le_pow_right (by norm_num) (by omega)
  unfold NLogN.KFV.tF; split_ifs
  · exact le_trans (Nat.sub_le _ _) (Nat.le_add_right _ _)
  · omega

theorem mem_genL {L : LP} {fl : List Bool} {op : Bool} {Q h k : ℕ} {t : ℕ × ℕ × ℕ} (hh : h ≤ L.ℓ)
    (ht : t ∈ genL L fl op Q h k) : t.1 ≤ Q + 2 ^ L.ℓ ∧ t.2.1 ≤ L.n - 1 ∧ t.2.2 ≤ L.n - 1 := by
  simp only [genL, List.mem_flatMap] at ht
  obtain ⟨i, _, hi⟩ := ht
  unfold axG at hi
  split_ifs at hi
  · exact mem_axTr hh hi
  · exact mem_axTr hh hi
  · simp at hi

theorem genG_length_le (L : LP) (fl : List Bool) (op : Bool) (h : ℕ) :
    (genG L fl op h).length ≤ L.D * h := by
  have := genL_length_le L fl op (2 ^ (L.ℓ + 1)) h L.D
  simpa [genG] using this

