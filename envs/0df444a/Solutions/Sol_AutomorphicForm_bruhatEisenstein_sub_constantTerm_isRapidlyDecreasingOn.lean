variable (F : Type) [Field F] [NumberField F] (w : InfinitePlace F)

private theorem ext_of_components {x y : AdelicGL2 (𝓞 F) F}
    (harch : ∀ v : InfinitePlace F,
      archComponent F v (glArch (𝓞 F) F x) = archComponent F v (glArch (𝓞 F) F y))
    (hfin : glFin (𝓞 F) F x = glFin (𝓞 F) F y) : x = y := by
  apply Units.ext
  ext i j
  refine Prod.ext ?_ ?_
  · funext v
    exact congrArg (fun k : GL (Fin 2) v.Completion => (k : Matrix (Fin 2) (Fin 2) v.Completion) i j) (harch v)
  · exact congrArg (fun k : GL (Fin 2) (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) =>
      (k : Matrix (Fin 2) (Fin 2) (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F)) i j) hfin

private theorem adelicArchGLInclAt_apply (k : GL (Fin 2) w.Completion) :
    adelicArchGLInclAt F w k = adelicArchGLIncl F (archGLIncl F w k) := rfl

@[scoped simp] private theorem archComponent_incl_self (k : GL (Fin 2) w.Completion) :
    archComponent F w (glArch (𝓞 F) F (adelicArchGLInclAt F w k)) = k := by
  rw [adelicArchGLInclAt_apply, glArch_adelicArchGLIncl, archComponent_archGLIncl_self]

private theorem archComponent_incl_of_ne {v : InfinitePlace F} (hvw : v ≠ w) (k : GL (Fin 2) w.Completion) :
    archComponent F v (glArch (𝓞 F) F (adelicArchGLInclAt F w k)) = 1 := by
  rw [adelicArchGLInclAt_apply, glArch_adelicArchGLIncl, archComponent_archGLIncl_of_ne F hvw]

@[scoped simp] private theorem glFin_incl (k : GL (Fin 2) w.Completion) :
    glFin (𝓞 F) F (adelicArchGLInclAt F w k) = 1 := by
  rw [adelicArchGLInclAt_apply, glFin_adelicArchGLIncl]

private def awayFrom (x : AdelicGL2 (𝓞 F) F) : AdelicGL2 (𝓞 F) F :=
  (adelicArchGLInclAt F w (archComponent F w (glArch (𝓞 F) F x)))⁻¹ * x

private theorem incl_mul_awayFrom (x : AdelicGL2 (𝓞 F) F) :
    adelicArchGLInclAt F w (archComponent F w (glArch (𝓞 F) F x)) * awayFrom F w x = x :=
  mul_inv_cancel_left _ _

@[scoped simp] private theorem archComponent_awayFrom_self (x : AdelicGL2 (𝓞 F) F) :
    archComponent F w (glArch (𝓞 F) F (awayFrom F w x)) = 1 := by
  unfold awayFrom
  rw [map_mul, map_mul, map_inv, map_inv, archComponent_incl_self, inv_mul_cancel]

private theorem archComponent_awayFrom_of_ne {v : InfinitePlace F} (hvw : v ≠ w) (x : AdelicGL2 (𝓞 F) F) :
    archComponent F v (glArch (𝓞 F) F (awayFrom F w x)) = archComponent F v (glArch (𝓞 F) F x) := by
  unfold awayFrom
  rw [map_mul, map_mul, map_inv, map_inv, archComponent_incl_of_ne F w hvw, inv_one, one_mul]

@[scoped simp] private theorem glFin_awayFrom (x : AdelicGL2 (𝓞 F) F) :
    glFin (𝓞 F) F (awayFrom F w x) = glFin (𝓞 F) F x := by
  unfold awayFrom
  rw [map_mul, map_inv, glFin_incl, inv_one, one_mul]

private theorem awayFrom_eq_of_agree {x y : AdelicGL2 (𝓞 F) F}
    (harch : ∀ v : InfinitePlace F, v ≠ w →
      archComponent F v (glArch (𝓞 F) F x) = archComponent F v (glArch (𝓞 F) F y))
    (hfin : glFin (𝓞 F) F x = glFin (𝓞 F) F y) : awayFrom F w x = awayFrom F w y := by
  refine ext_of_components F (fun v => ?_) ?_
  · by_cases hvw : v = w
    · subst hvw
      rw [archComponent_awayFrom_self, archComponent_awayFrom_self]
    · rw [archComponent_awayFrom_of_ne F w hvw, archComponent_awayFrom_of_ne F w hvw, harch v hvw]
  · rw [glFin_awayFrom, glFin_awayFrom, hfin]

private theorem incl_mul_comm_of_archComponent_eq_one {y : AdelicGL2 (𝓞 F) F}
    (hy : archComponent F w (glArch (𝓞 F) F y) = 1) (k : GL (Fin 2) w.Completion) :
    adelicArchGLInclAt F w k * y = y * adelicArchGLInclAt F w k := by
  refine ext_of_components F (fun v => ?_) ?_
  · rw [map_mul, map_mul, map_mul, map_mul]
    by_cases hvw : v = w
    · subst hvw
      rw [hy, archComponent_incl_self, mul_one, one_mul]
    · rw [archComponent_incl_of_ne F w hvw, one_mul, mul_one]
  · rw [map_mul, map_mul, glFin_incl, one_mul, mul_one]

private theorem incl_mul_awayFrom_comm (k : GL (Fin 2) w.Completion) (x : AdelicGL2 (𝓞 F) F) :
    adelicArchGLInclAt F w k * awayFrom F w x = awayFrom F w x * adelicArchGLInclAt F w k :=
  incl_mul_comm_of_archComponent_eq_one F w (archComponent_awayFrom_self F w x) k

private theorem archComponent_unipotentGL2 (a : AdeleRing (𝓞 F) F) (v : InfinitePlace F) :
    archComponent F v (glArch (𝓞 F) F (unipotentGL2 a)) = unipotentGL2 (a.1 v) := by
  apply Units.ext
  ext i j
  rw [archComponent_apply, glArch_apply, unipotentGL2_coe, unipotentGL2_coe]
  fin_cases i <;> fin_cases j <;> rfl

private theorem glFin_unipotentGL2 (a : AdeleRing (𝓞 F) F) :
    glFin (𝓞 F) F (unipotentGL2 a) = unipotentGL2 a.2 := by
  apply Units.ext
  ext i j
  rw [glFin_apply, unipotentGL2_coe, unipotentGL2_coe]
  fin_cases i <;> fin_cases j <;> rfl

private theorem archComponent_adelicWeyl (v : InfinitePlace F) :
    archComponent F v (glArch (𝓞 F) F (adelicWeyl (𝓞 F) F)) = gl2Weyl := by
  apply Units.ext
  ext i j
  rw [archComponent_apply, glArch_apply, gl2Weyl_val]
  have h0 : ((algebraMap F (AdeleRing (𝓞 F) F)) 0).1 v = 0 := by rw [map_zero]; rfl
  have h1 : ((algebraMap F (AdeleRing (𝓞 F) F)) 1).1 v = 1 := by rw [map_one]; rfl
  fin_cases i <;> fin_cases j <;> first | exact h0 | exact h1

private theorem glFin_weyl_unipotent_eq {a a' : AdeleRing (𝓞 F) F} (ha : a.2 = a'.2) (x : AdelicGL2 (𝓞 F) F) :
    glFin (𝓞 F) F (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = glFin (𝓞 F) F (adelicWeyl (𝓞 F) F * unipotentGL2 a' * x) := by
  rw [map_mul, map_mul, map_mul, map_mul, glFin_unipotentGL2, glFin_unipotentGL2, ha]

private theorem awayFrom_weyl_unipotent_eq_of_agree {a a' : AdeleRing (𝓞 F) F}
    (harch : ∀ v : InfinitePlace F, v ≠ w → a.1 v = a'.1 v) (hfin : a.2 = a'.2)
    (x : AdelicGL2 (𝓞 F) F) :
    awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a' * x) := by
  refine awayFrom_eq_of_agree F w (fun v hvw => ?_) (glFin_weyl_unipotent_eq F hfin x)
  simp only [map_mul, archComponent_unipotentGL2, harch v hvw]

private theorem incl_entry_fst (k : GL (Fin 2) w.Completion) (i j : Fin 2) (v : InfinitePlace F) :
    (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
        Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).1 v
      = archMatrixUpdate F w (k : Matrix (Fin 2) (Fin 2) w.Completion) i j v := rfl

private theorem incl_entry_snd (k : GL (Fin 2) w.Completion) (i j : Fin 2) :
    (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
        Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).2
      = (1 : Matrix (Fin 2) (Fin 2) (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F)) i j := rfl

private theorem continuous_incl_val :
    Continuous fun k : GL (Fin 2) w.Completion =>
      ((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) : Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) := by
  refine continuous_matrix fun i j => ?_
  change Continuous fun k : GL (Fin 2) w.Completion =>
    (show AdeleRing (𝓞 F) F from
      ((((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
          Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).1,
       (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
          Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).2))
  refine Continuous.prodMk ?_ ?_
  · refine continuous_pi fun v => ?_
    show Continuous fun k : GL (Fin 2) w.Completion =>
      (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
        Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).1 v
    by_cases hvw : v = w
    · subst hvw
      have hf : (fun k : GL (Fin 2) v.Completion =>
          (((adelicArchGLInclAt F v k : AdelicGL2 (𝓞 F) F) :
            Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).1 v)
          = fun k : GL (Fin 2) v.Completion => (k : Matrix (Fin 2) (Fin 2) v.Completion) i j := by
        funext k
        rw [incl_entry_fst, archMatrixUpdate_apply_self]
      rw [hf]
      exact Units.continuous_val.matrix_elem i j
    · have hf : (fun k : GL (Fin 2) w.Completion =>
          (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
            Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).1 v)
          = fun _ => (1 : Matrix (Fin 2) (Fin 2) v.Completion) i j := by
        funext k
        rw [incl_entry_fst, archMatrixUpdate_apply_of_ne F w _ i j hvw]
      rw [hf]
      exact continuous_const
  · show Continuous fun k : GL (Fin 2) w.Completion =>
      (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
        Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).2
    have hf : (fun k : GL (Fin 2) w.Completion =>
        (((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) :
          Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) i j).2)
        = fun _ => (1 : Matrix (Fin 2) (Fin 2) (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F)) i j := by
      funext k
      rw [incl_entry_snd]
    rw [hf]
    exact continuous_const

private theorem continuous_adelicArchGLInclAt : Continuous (adelicArchGLInclAt F w) := by
  refine Units.continuous_iff.2 ⟨continuous_incl_val F w, ?_⟩
  have hinv : (fun k : GL (Fin 2) w.Completion =>
      (((adelicArchGLInclAt F w k)⁻¹ : AdelicGL2 (𝓞 F) F) : Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)))
      = (fun k : GL (Fin 2) w.Completion =>
          ((adelicArchGLInclAt F w k : AdelicGL2 (𝓞 F) F) : Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)))
        ∘ fun k => k⁻¹ := by
    funext k
    simp only [Function.comp_apply, map_inv]
  rw [hinv]
  exact (continuous_incl_val F w).comp continuous_inv

private def archIdeleAt : (w.Completion)ˣ →* (AdeleRing (𝓞 F) F)ˣ :=
  Units.map
    { toFun := fun t =>
        (show AdeleRing (𝓞 F) F from (Function.update (1 : InfiniteAdeleRing F) w t, 1))
      map_one' := by
        refine Prod.ext ?_ rfl
        exact Function.update_eq_self_iff.mpr rfl
      map_mul' := fun s t => by
        refine Prod.ext ?_ (one_mul (1 : IsDedekindDomain.FiniteAdeleRing (𝓞 F) F)).symm
        funext v
        show Function.update (1 : InfiniteAdeleRing F) w (s * t) v
          = Function.update (1 : InfiniteAdeleRing F) w s v * Function.update (1 : InfiniteAdeleRing F) w t v
        by_cases hvw : v = w
        · subst hvw
          rw [Function.update_self, Function.update_self, Function.update_self]
        · rw [Function.update_of_ne hvw, Function.update_of_ne hvw, Function.update_of_ne hvw]
          exact (one_mul _).symm }

private theorem archIdeleAt_fst_apply (t : (w.Completion)ˣ) (v : InfinitePlace F) :
    ((archIdeleAt F w t : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 v
      = Function.update (1 : InfiniteAdeleRing F) w (t : w.Completion) v := rfl

@[scoped simp] private theorem archIdeleAt_fst_self (t : (w.Completion)ˣ) :
    ((archIdeleAt F w t : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 w = t := by
  rw [archIdeleAt_fst_apply, Function.update_self]

private theorem archIdeleAt_fst_of_ne (t : (w.Completion)ˣ) {v : InfinitePlace F} (hvw : v ≠ w) :
    ((archIdeleAt F w t : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).1 v = 1 := by
  rw [archIdeleAt_fst_apply, Function.update_of_ne hvw]
  rfl

@[scoped simp] private theorem archIdeleAt_snd (t : (w.Completion)ˣ) :
    ((archIdeleAt F w t : (AdeleRing (𝓞 F) F)ˣ) : AdeleRing (𝓞 F) F).2 = 1 := rfl

private theorem incl_mem_adelicBorel {b : GL (Fin 2) w.Completion} (hb : b ∈ borelSubgroup w.Completion) :
    adelicArchGLInclAt F w b ∈ adelicBorel (𝓞 F) F := by
  have hb' : (b : Matrix (Fin 2) (Fin 2) w.Completion) 1 0 = 0 := hb
  show ((adelicArchGLInclAt F w b : AdelicGL2 (𝓞 F) F) :
      Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) 1 0 = 0
  refine Prod.ext ?_ ?_
  · funext v
    rw [incl_entry_fst]
    by_cases hvw : v = w
    · subst hvw
      rw [archMatrixUpdate_apply_self]
      exact hb'
    · rw [archMatrixUpdate_apply_of_ne F w _ 1 0 hvw]
      exact Matrix.one_apply_ne (by decide)
  · rw [incl_entry_snd]
    exact Matrix.one_apply_ne (by decide)

private theorem borelDiagFst_incl {b : GL (Fin 2) w.Completion} (hb : b ∈ borelSubgroup w.Completion) :
    borelDiagFst ⟨adelicArchGLInclAt F w b, incl_mem_adelicBorel F w hb⟩
      = archIdeleAt F w (borelDiagFst ⟨b, hb⟩) := by
  apply Units.ext
  rw [borelDiagFst_apply_val]
  show ((adelicArchGLInclAt F w b : AdelicGL2 (𝓞 F) F) :
      Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) 0 0 = _
  refine Prod.ext ?_ ?_
  · funext v
    rw [incl_entry_fst, archIdeleAt_fst_apply, borelDiagFst_apply_val]
    by_cases hvw : v = w
    · subst hvw
      rw [archMatrixUpdate_apply_self, Function.update_self]
    · rw [archMatrixUpdate_apply_of_ne F w _ 0 0 hvw, Function.update_of_ne hvw]
      exact Matrix.one_apply_eq 0
  · rw [incl_entry_snd, archIdeleAt_snd]
    exact Matrix.one_apply_eq 0

private theorem borelDiagSnd_incl {b : GL (Fin 2) w.Completion} (hb : b ∈ borelSubgroup w.Completion) :
    borelDiagSnd ⟨adelicArchGLInclAt F w b, incl_mem_adelicBorel F w hb⟩
      = archIdeleAt F w (borelDiagSnd ⟨b, hb⟩) := by
  apply Units.ext
  rw [borelDiagSnd_apply_val]
  show ((adelicArchGLInclAt F w b : AdelicGL2 (𝓞 F) F) :
      Matrix (Fin 2) (Fin 2) (AdeleRing (𝓞 F) F)) 1 1 = _
  refine Prod.ext ?_ ?_
  · funext v
    rw [incl_entry_fst, archIdeleAt_fst_apply, borelDiagSnd_apply_val]
    by_cases hvw : v = w
    · subst hvw
      rw [archMatrixUpdate_apply_self, Function.update_self]
    · rw [archMatrixUpdate_apply_of_ne F w _ 1 1 hvw, Function.update_of_ne hvw]
      exact Matrix.one_apply_eq 1
  · rw [incl_entry_snd, archIdeleAt_snd]
    exact Matrix.one_apply_eq 1

