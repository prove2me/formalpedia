theorem solution (p : ℕ) [Fact p.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    [DecidableEq (IsLocalRing.ResidueField ↥A)] [CharP (IsLocalRing.ResidueField ↥A) p] (Γ : ChartCtx p A)
    {r : ℕ} (Φ : FamCtx p r) :
    ∀ μ : AbsoluteValue (AlgebraicClosure ℚ) ℝ, (∀ a : AlgebraicClosure ℚ, a ∈ A ↔ μ a ≤ 1) →
      ∀ Q ∈ (zeroChart Γ).dom, Q.IsRational ∧ ∀ i : Fin r,
        goodFamily Φ i ∈ Q.toValuationSubring ∧
        μ (Q.evalAt (goodFamily Φ i)) ≤ μ (p : AlgebraicClosure ℚ) ^ hasseExp Φ.toFamData i := by
  intro μ hμA Q hQ
  have hp : p.Prime := Fact.out
  have hp0 : (p : AlgebraicClosure ℚ) ≠ 0 := Nat.cast_ne_zero.2 hp.ne_zero
  obtain ⟨hintZ, -⟩ := zeroChart_residue_goodFamilyZero_ne_zero p A hA Γ Φ
  have hQrat : Q.IsRational := isRational_modularFunctionFieldBar Q
  refine ⟨hQrat, fun i => ?_⟩
  set c : AlgebraicClosure ℚ := (p : AlgebraicClosure ℚ) ^ hasseExp Φ.toFamData i with hc
