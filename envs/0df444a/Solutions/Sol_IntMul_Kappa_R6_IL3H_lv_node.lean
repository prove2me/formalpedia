theorem levRH_push3 (hL : LevRH c σ K t S0 r H E e B) (E' e' : ℕ) :
    LevRH c (σPush σ (lev3 c E' e')) K t S0 r H E' e' B := by
  have ne : ∀ i : Fin HS, i ∉ [vX, vE, vk] → σPush σ (lev3 c E' e') i = σ i :=
    fun i hi => lev3_ne c E' e' hi
  have mem : ∀ i v, (i, v) ∈ lev3 c E' e' → σPush σ (lev3 c E' e') i = some v :=
