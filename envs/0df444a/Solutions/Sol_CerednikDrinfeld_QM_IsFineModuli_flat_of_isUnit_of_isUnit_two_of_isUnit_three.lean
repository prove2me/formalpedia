theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N m : ℕ) [NeZero N] (hm : 3 ≤ m)
    (𝒪 : Type) [CommRing 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪))
    (h2 : IsUnit ((2 : ℕ) : 𝒪)) (h3 : IsUnit ((3 : ℕ) : 𝒪))
    {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of 𝒪)}
    {ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM}
    (hM : IsFineModuli Λ N m M πM ptF) :
    Flat πM := by
  haveI : NeZero m := ⟨by omega⟩
  haveI : IsDedekindDomain (Zaway N m) := isDedekindDomain_Zaway N m hm

  obtain ⟨M₀, π₀, ptF₀, hM₀, -⟩ :=
    CerednikDrinfeld.QM.exists_isFineModuli_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm (Zaway N m) (isUnit_natCast_N N m) (isUnit_natCast_m N m)
      (isUnit_natCast_two N m) (isUnit_natCast_three N m)
  have hflat : Flat π₀ := flat_model Λ N m hqq' hB hΛ hm hM₀

  have htf := (AlgebraicGeometry.flat_iff_forall_appLE_mul_eq_zero_of_isDedekindDomain π₀).mp hflat
  refine CerednikDrinfeld.QM.IsFineModuli.flat_of_exists_isFineModuli_localizationAway_six_mul_of_forall_mul_eq_zero Λ N m
    ⟨M₀, π₀, ptF₀, hM₀, fun U z s hz hzs ↦ ?_⟩ 𝒪 hN hm' h2 h3 hM
  refine htf U (algebraMap ℤ (Zaway N m) z) s ?_ ?_
  · intro h
    exact hz (algebraMap_int_injective N m hm (by rw [h, map_zero]))
  · have hcast : (z : Γ(M₀, U)) =
        ((Scheme.ΓSpecIso (CommRingCat.of (Zaway N m))).inv ≫ π₀.appLE ⊤ (U : M₀.Opens) le_top)
          (algebraMap ℤ (Zaway N m) z) := by
      simp
    rw [← hcast]
    exact hzs

