variable {K : Type*} [Field K]

private theorem range_val : Set.range (Units.val : Kˣ → K) = {0}ᶜ := by
  ext x
  simp only [Set.mem_range, Set.mem_compl_iff, Set.mem_singleton_iff]
  exact ⟨fun ⟨u, hu⟩ => hu ▸ u.ne_zero, fun hx => ⟨Units.mk0 x hx, rfl⟩⟩

private theorem image_val_subset (s : Set Kˣ) : Units.val '' s ⊆ ({0}ᶜ : Set K) := by
  rintro _ ⟨u, -, rfl⟩
  exact u.ne_zero

private theorem preimage_mul_left_eq (u : Kˣ) (s : Set K) :
    (fun x : K => (u : K) * x) ⁻¹' s = u⁻¹ • s := by
  simpa only [Units.smul_def, smul_eq_mul] using Set.preimage_smul u s

private theorem image_val_preimage_mul_left (g : Kˣ) (s : Set Kˣ) :
    Units.val '' ((fun x : Kˣ => g * x) ⁻¹' s) = (fun x : K => (g : K) * x) ⁻¹' (Units.val '' s) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨g * y, hy, by simp⟩
  · rintro ⟨z, hz, hx⟩
    refine ⟨g⁻¹ * z, ?_, ?_⟩
    · simpa [Set.mem_preimage] using hz
    · have hgx : (g : K) * x = (z : K) := hx.symm
      calc ((g⁻¹ * z : Kˣ) : K) = ((g⁻¹ : Kˣ) : K) * ((g : K) * x) := by rw [hgx]; simp
        _ = x := by rw [← mul_assoc, Units.inv_mul, one_mul]

end
