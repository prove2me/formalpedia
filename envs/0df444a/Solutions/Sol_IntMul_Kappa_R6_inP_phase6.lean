  rw [List.append_nil, wF_update hd0] at h2
  exact callW_runs bld (bX_ne_bY dS) (bX_ne dS) (bY_ne dS) hd0 (bX_ne0 dS) (g e) t data data'
    desc R0 h0 B hB hok hrun h2

