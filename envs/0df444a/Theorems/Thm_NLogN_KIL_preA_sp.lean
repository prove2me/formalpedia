theorem NLogN.KIL.preA_sp (s : IState HS) (F : Fin HS → List ℤ) {M B : ℕ} (hM : zsz (M : ℤ) ≤ B)
    {q m W u P g sv : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m)
    (FP : ∃ L, F kP = (P : ℤ) :: L) (FG : ∃ L, F kG = (g : ℤ) :: L)
    (FS : ∃ L, F NLogN.KIL.kS = (sv : ℤ) :: L) (FU : ∃ L, F aU = (u : ℤ) :: L) (hg : 1 ≤ g)
    (F23 : F 23 = [])
    (hM1 : 2 ^ u + q ≤ M) (hM4 : Nat.clog q (2 ^ u) + m ≤ M) (hM6 : W * Nat.clog q (2 ^ u) ≤ M)
    (hM6' : W ≤ M) (hM7 : g * q ^ Nat.clog q (2 ^ u) ≤ M) :
    ∃ v : Fin HS → ℕ, (∀ i ∈ regD, v i ≤ M) ∧ v kP = P ∧ v kG = g ∧ v NLogN.KIL.kS = sv ∧ v aU = u ∧
      v aT2 = 2 ^ u ∧ v NLogN.KIL.aE = Nat.clog q (2 ^ u) ∧ v aQE = q ^ Nat.clog q (2 ^ u) ∧
      v aK = Nat.clog m (Nat.clog q (2 ^ u)) ∧
      v kR = min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v aN = Nat.clog q (2 ^ u) - min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v aQR = q ^ min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v aQN = q ^ (Nat.clog q (2 ^ u) -
        min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u))) ∧
      v aGR = g * q ^ min (W * Nat.clog m (Nat.clog q (2 ^ u))) (Nat.clog q (2 ^ u)) ∧
      v kQt = q ^ 0 ∧ v kQr = q ^ (Nat.clog q (2 ^ u) - 0) / q ∧
      Sp (preA q m W) (encK s F) (encK s (regState F v regD)) (cPreA u (Nat.clog q (2 ^ u)) B) := by sorry
