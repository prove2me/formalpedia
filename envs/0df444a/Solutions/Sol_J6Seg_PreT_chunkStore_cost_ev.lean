/-!
# B-line IL, pre-tables (B5′), part 28: **the chunk store is within the per-axis budget**

`chunkStore_cost_ev`: for widths `A ≤ aA·Q + aC`, `M ≤ mA·Q + mC` (`Q = Q6 p d s`), eventually
`cCS2 Q R A λ M nc ≤ cU6 P n A' / (D + 1)` on every axis (`Cp = 1`, any `A'`).

The ℕ core: `cCS2 ≤ K b⁴ t p¹⁰` (`cCS2_le`, `λ ≤ 4b²`, `nc λ ≤ t`), `d ≤ b`, and
`K b⁵ p⁹ t ≤ T` because `t² ≤ 2T` (`ℓ ≤ (L+1)/2` for `d ≥ 2`) and `2 (K b⁵ p⁹)² ≤ T`
(`T b' ≥ 4n > 2^(b+1)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.PreT

open IntMul NLogN IntMul.Kappa.R6 J6Seg J6Seg.Side

theorem core_ineq {K b p t T d : ℕ} (hdb : d ≤ b) (ht2 : t * t ≤ 2 * T)
    (hX : 2 * ((K * b ^ 5 * p ^ 9) * (K * b ^ 5 * p ^ 9)) ≤ T) :
    K * b ^ 4 * t * p ^ 10 * d ≤ T * p := by
  set X := K * b ^ 5 * p ^ 9 with hXd
  have hsq : (X * t) * (X * t) ≤ T * T := by
    calc (X * t) * (X * t) = (X * X) * (t * t) := by ring
      _ ≤ (X * X) * (2 * T) := Nat.mul_le_mul_left _ ht2
      _ = (2 * (X * X)) * T := by ring
      _ ≤ T * T := Nat.mul_le_mul_right _ hX
  have hXt : X * t ≤ T := Nat.mul_self_le_mul_self_iff.1 hsq
  calc K * b ^ 4 * t * p ^ 10 * d ≤ K * b ^ 4 * t * p ^ 10 * b := Nat.mul_le_mul_left _ hdb
    _ = X * t * p := by rw [hXd]; ring
    _ ≤ T * p := Nat.mul_le_mul_right _ hXt

/-- **The chunk-store cost is within the per-axis budget** (`Cp = 1`). -/
theorem chunkStore_cost_ev_sol_aux (P : Prm) (hP : P.Ok) (aA aC mA mC : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D, ∀ A M : ℕ,
      A ≤ aA * J6Seg.Q6 (pP6 P n) (dP6 P n) (src k) + aC →
      M ≤ mA * J6Seg.Q6 (pP6 P n) (dP6 P n) (src k) + mC → ∀ A' : ℕ,
      (cCS2 (J6Seg.Q6 (pP6 P n) (dP6 P n) (src k)) (R6 (pP6 P n)) A (lamP (dP6 P n)) M
        (tF6 P n k / lamP (dP6 P n)) : ℝ) ≤ cU6 P n A' / (D + 1) := by
  obtain ⟨n₁, hAx⟩ := axNum_ev P hP
  obtain ⟨n₂, hQ⟩ := qok_of P hP
  obtain ⟨n₃, hd2⟩ := eventually_d_ge P hP 2
  obtain ⟨B₀, hB⟩ := big_ev (cK aA aC mA mC) P.x
  obtain ⟨n₄, hb4⟩ := eventually_b_ge (max B₀ 2)
  refine ⟨max (max n₁ n₂) (max n₃ (max n₄ 2)), fun n hn src hs D hD k hk A M hA hM A' => ?_⟩
  have hn1 : n₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
  have hn2 : n₂ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
  have hn3 : n₃ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
  have hn4 : n₄ ≤ n := le_trans (le_trans (le_trans (le_max_left _ _) (le_max_right _ _))
    (le_max_right _ _)) hn
  have hn5 : 2 ≤ n := le_trans (le_trans (le_trans (le_max_right _ _) (le_max_right _ _))
    (le_max_right _ _)) hn
  have ax := hAx n hn1 src hs D hD k hk
  have hq := hQ n hn2 src hs
  have hd : 2 ≤ dP6 P n := hd2 n hn3
  have hbB : max B₀ 2 ≤ bP6 n := hb4 n hn4
  set b := bP6 n with hbdef
  set b' := b'P6 P n with hb'def
  set p := pP6 P n with hpdef
  set d := dP6 P n with hddef
  set t := tF6 P n k with htdef
  set T := TP6 P n with hTdef
  set L := LP6 P n with hLdef
  set ℓ := ℓP6 P n with hℓdef
  have hb1 : 1 ≤ b := by omega
  have hpe : p = 6 * b' := rfl
  have hb'e : b' = b ^ (1 + P.x) := rfl
  have hb'1 : 1 ≤ b' := b'P6_pos P n
  have hp1 : 1 ≤ p := ax.p1
  have ht1 : 1 ≤ t := ax.t1
  -- the cost in ℕ
  have hlam : lamP d ≤ 4 * b ^ 2 := by
    have e1 : lamP d = 2 ^ axfC6 P n := ax.lamC
    have e2 := ax.fC
    have e3 : 2 ^ Nat.log 2 b ≤ b := Nat.pow_log_le_self 2 (by omega)
    rw [e1]
    calc 2 ^ axfC6 P n ≤ 2 ^ (2 * Nat.log 2 b + 2) := Nat.pow_le_pow_right (by norm_num) e2
      _ = 4 * (2 ^ Nat.log 2 b) ^ 2 := by ring
      _ ≤ 4 * b ^ 2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left e3 2)
  have hC := cost_le_core (Q := J6Seg.Q6 p d (src k)) (R := R6 p) (A := A) (M := M) (lam := lamP d)
    (nc := t / lamP d) (aA := aA) (aC := aC) (mA := mA) (mC := mC) hp1 hb1 ht1 hA hM ax.Qp
    (Nat.div_le_self _ _) hlam ax.ncl Nat.one_le_two_pow
  -- t² ≤ 2T
  have hℓ2 : 2 ≤ ℓ := hq.hℓ2
  have htl : t ≤ 2 ^ ℓ := by
    have e : ℓ = hN6 P n + 1 := by simp only [hℓdef, hN6]; omega
    simp only [htdef, tF6]; rw [e, pow_succ]; split_ifs <;> omega
  have hdl : d * ℓ ≤ L + d - 1 := by
    have := Nat.div_mul_le_self (L + d - 1) d
    simp only [hℓdef, ℓP6]; rw [mul_comm]; exact this
  have h2l : 2 * ℓ ≤ L + 1 := by
    have : 2 * (ℓ - 1) ≤ d * (ℓ - 1) := Nat.mul_le_mul_right _ hd
    have e : d * (ℓ - 1) = d * ℓ - d := by rw [Nat.mul_sub_one]
    omega
  have ht2 : t * t ≤ 2 * T := by
    calc t * t ≤ 2 ^ ℓ * 2 ^ ℓ := Nat.mul_le_mul htl htl
      _ = 2 ^ (2 * ℓ) := by ring
      _ ≤ 2 ^ (L + 1) := Nat.pow_le_pow_right (by norm_num) h2l
      _ = 2 * T := by rw [hTdef, TP6, pow_succ]; ring
  -- 2 X² ≤ T
  have hn4 : 4 * n ≤ T * b' := by
    have := Nat.find_spec (LP6_exists P n)
    simp only [hTdef, TP6, LP6]; exact this
  have hbn : 2 ^ (b + 1) < 4 * n := by
    have := two_pow_b_lt hn5
    have e : 2 ^ (b + 1) = 4 * 2 ^ (b - 1) := by
      rw [show b + 1 = (b - 1) + 2 by omega, pow_add]; ring
    have h' : 2 ^ (b - 1) < n := this
    rw [e]; omega
  have hX : 2 * ((cK aA aC mA mC * b ^ 5 * p ^ 9) * (cK aA aC mA mC * b ^ 5 * p ^ 9)) ≤ T := by
    have h := hB b (le_of_max_le_left hbB)
    rw [← hb'e, ← hpe] at h
    have : 2 * ((cK aA aC mA mC * b ^ 5 * p ^ 9) * (cK aA aC mA mC * b ^ 5 * p ^ 9)) * b' ≤ T * b' :=
      h.trans (hbn.le.trans hn4)
    exact Nat.le_of_mul_le_mul_right this (by omega)
  have hcore := core_ineq (K := cK aA aC mA mC) (d := d) (d_le_b P hP n) ht2 hX
  have hN : cCS2 (J6Seg.Q6 p d (src k)) (R6 p) A (lamP d) M (t / lamP d) * d ≤ T * p :=
    (Nat.mul_le_mul_right _ hC).trans hcore
  -- to ℝ
  have hdR : ((D : ℝ) + 1) = (d : ℝ) := by rw [hD]; push_cast; ring
  have hd0 : (0 : ℝ) < d := by exact_mod_cast (show 0 < d by omega)
  have hU : (T : ℝ) * p ≤ cU6 P n A' := by
    unfold cU6 VP6
    have h2 := Ncost6_ge_one P hP n
    have h3 : (1 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A' := one_le_pow₀ (lgn_ge n)
    have h0 : (0 : ℝ) ≤ (TP6 P n : ℝ) * (pP6 P n : ℝ) := by positivity
    calc (T : ℝ) * p = (TP6 P n : ℝ) * (pP6 P n : ℝ) * 1 * 1 := by ring
      _ ≤ (TP6 P n : ℝ) * (pP6 P n : ℝ) * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A' := by
        gcongr
  rw [hdR, le_div_iff₀ hd0]
  have : ((cCS2 (J6Seg.Q6 p d (src k)) (R6 p) A (lamP d) M (t / lamP d) * d : ℕ) : ℝ) ≤
      ((T * p : ℕ) : ℝ) := by exact_mod_cast hN
  push_cast at this
  linarith

end J6Seg.PreT
end

