namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

theorem IState.top_upd_ne (s : IState S) {i j : Fin S} (h : i ≠ j) (L : List Item) :
    (s.upd j L).top i = s.top i := by
  simp [IState.top, IState.upd_G, h]

theorem IState.isInt_upd_ne (s : IState S) {i j : Fin S} (h : i ≠ j) (L : List Item) :
    (s.upd j L).IsInt i ↔ s.IsInt i := by
  simp [IState.IsInt, IState.top_upd_ne s h, IState.upd_G, h]

theorem IState.isInt_of_r6c {s : IState S} {i : Fin S} {a : ℤ} {L : List Item}
    (h : s.G i = .int a :: L) : s.IsInt i := ⟨L, by rw [IState.top_eq_r6c h, h]⟩

namespace Ex

theorem eval_upd (s : IState S) (j : Fin S) (L : List Item) :
    ∀ e : Ex S, j ∉ e.regs → e.eval (s.upd j L) = e.eval s
  | reg i, h => by simp only [regs, List.mem_singleton] at h; exact IState.top_upd_ne s (Ne.symm h) L
  | lit _, _ => rfl
  | add a b, h | mul a b, h | shl a b, h | quo a b, h | rem a b, h | ndiv a b, h | nmod a b, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [eval, eval_upd s j L a h.1, eval_upd s j L b h.2]
  | neg a, h | pow2 a, h => by
    simp only [regs] at h; simp only [eval, eval_upd s j L a h]
  | sel c x y, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [eval, eval_upd s j L c h.1.1, eval_upd s j L x h.1.2, eval_upd s j L y h.2]

theorem ok_upd (s : IState S) (j : Fin S) (L : List Item) :
    ∀ e : Ex S, j ∉ e.regs → (e.ok (s.upd j L) ↔ e.ok s)
  | reg i, h => by
    simp only [regs, List.mem_singleton] at h; exact IState.isInt_upd_ne s (Ne.symm h) L
  | lit _, _ => Iff.rfl
  | add a b, h | mul a b, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [ok, ok_upd s j L a h.1, ok_upd s j L b h.2]
  | shl a b, h | quo a b, h | rem a b, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [ok, ok_upd s j L a h.1, ok_upd s j L b h.2, eval_upd s j L b h.2]
  | ndiv a b, h | nmod a b, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [ok, ok_upd s j L a h.1, ok_upd s j L b h.2, eval_upd s j L a h.1,
      eval_upd s j L b h.2]
  | neg a, h => by simp only [regs] at h; simp only [ok, ok_upd s j L a h]
  | pow2 a, h => by simp only [regs] at h; simp only [ok, ok_upd s j L a h, eval_upd s j L a h]
  | sel c x y, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [ok, ok_upd s j L c h.1.1, ok_upd s j L x h.1.2, ok_upd s j L y h.2,
      eval_upd s j L c h.1.1]

theorem cost_upd (s : IState S) (j : Fin S) (L : List Item) :
    ∀ e : Ex S, j ∉ e.regs → e.cost (s.upd j L) = e.cost s
  | reg i, h => by
    simp only [regs, List.mem_singleton] at h; simp only [cost, IState.top_upd_ne s (Ne.symm h) L]
  | lit _, _ => rfl
  | add a b, h | mul a b, h | shl a b, h | quo a b, h | rem a b, h | ndiv a b, h | nmod a b, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [cost, cost_upd s j L a h.1, cost_upd s j L b h.2, eval_upd s j L a h.1,
      eval_upd s j L b h.2]
  | neg a, h => by simp only [regs] at h; simp only [cost, cost_upd s j L a h]
  | pow2 a, h => by
    simp only [regs] at h; simp only [cost, cost_upd s j L a h, eval_upd s j L a h]
  | sel c x y, h => by
    simp only [regs, List.mem_append, not_or] at h
    simp only [cost, cost_upd s j L c h.1.1, cost_upd s j L x h.1.2, cost_upd s j L y h.2,
      eval_upd s j L c h.1.1]

end Ex

end NLogN

