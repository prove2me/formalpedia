-- Source module: Solutions.J6AILTab1
/-!
# A lines, table set-up, part 1: tools

On the register file `RF v c` of `J6SegILPreJ*` (`Rn` runs):

* `Rn.enR` / `Rn.epR`: `v d := expNeg a b e` / `expPos a b e σ` with the arguments in registers,
  at the uniform costs `Ins.cEn W` / `cEp W`;
* `Rn.pushFor`: a counted loop (`forL`) whose body pushes `f k` onto a stack `S` and changes
  only the registers of a list `T` leaves `rv f N ++ c S` on `S`;
* `expNeg_absW`, `expPos_absW`: `|expNeg n k j|, |expPos n k j σ| ≤ (4n + 35) 2^n`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-- The scratch stack of the tables. -/
abbrev sS : Fin HS := 43
/-- The loop counters (outer, inner) and the move counter (not written by `expNegP`,
`expPosP`, which write `0 … 15, 19, 30 … 47`). -/
abbrev cO : Fin HS := 50
abbrev cI : Fin HS := 51
abbrev cM : Fin HS := 52

/-! ## Exponentials -/

/-! ## Calls -/

section calls
variable {W : ℕ} {v : Vr} {c : Cs}

/-- The cost of an `expPos` call at width `W`. -/
def cEp (W : ℕ) : ℕ :=
  J6A.PA.cCallX (.reg 0) (.reg 0) (.reg 0) (.reg 0) W (expPosCost (W + 1) (W + 1) (W + 1) (W + 1))

end calls

/-! ## The push loop -/

end J6Seg.ATab

end

