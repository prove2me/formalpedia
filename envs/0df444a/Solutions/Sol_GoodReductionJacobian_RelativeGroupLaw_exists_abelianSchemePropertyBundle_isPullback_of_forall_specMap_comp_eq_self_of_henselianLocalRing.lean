theorem abelianSchemePropertyBundle_of_iso {R : Type u} [CommRing R] {X Q : Scheme.{u}}
    {fX : X ⟶ Spec (CommRingCat.of R)} {fQ : Q ⟶ Spec (CommRingCat.of R)}
    (e : X ⟶ Q) [IsIso e] (he : e ≫ fQ = fX) (LX : RelativeGroupLaw R fX)
    (hQ : AbelianSchemePropertyBundle R fQ) : AbelianSchemePropertyBundle R fX := by
  refine ⟨?_, ?_, ?_, ⟨LX⟩⟩
  · rw [← he]
    exact (MorphismProperty.cancel_left_of_respectsIso @Smooth e fQ).mpr hQ.smooth
  · rw [← he]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsProper e fQ).mpr hQ.proper
  · intro s
    have hset : fX.base ⁻¹' {s} = e.homeomorph ⁻¹' (fQ.base ⁻¹' {s}) := by
      rw [← he, Scheme.Hom.comp_base, ← Set.preimage_comp]
      rfl
    rw [hset, Homeomorph.isConnected_preimage]
    exact hQ.connectedFibres s

theorem isTorsionPoint_map_of_mul {R : Type u} [CommRing R] {X Y T : Scheme.{u}}
    {fX : X ⟶ Spec (CommRingCat.of R)} {fY : Y ⟶ Spec (CommRingCat.of R)}
    (GX : RelativeGroupLaw R fX) (GY : RelativeGroupLaw R fY) (t : T ⟶ Spec (CommRingCat.of R))
    (φ : SchemeHomOver t fX → SchemeHomOver t fY)
    (hφ : ∀ x y : SchemeHomOver t fX, φ (GX.mul t x y) = GY.mul t (φ x) (φ y))
    (n : ℕ) (x : SchemeHomOver t fX) (hx : GX.IsTorsionPoint t n x) : GY.IsTorsionPoint t n (φ x) := by

  have hone : φ (GX.one t) = GY.one t := by
    have h : GY.mul t (φ (GX.one t)) (φ (GX.one t)) = φ (GX.one t) := by rw [← hφ, GX.one_mul]
    calc φ (GX.one t)
        = GY.mul t (GY.inv t (φ (GX.one t))) (GY.mul t (φ (GX.one t)) (φ (GX.one t))) := by
            rw [← GY.mul_assoc, GY.inv_mul_cancel, GY.one_mul]
      _ = GY.one t := by rw [h, GY.inv_mul_cancel]

  have hnsmul : ∀ k : ℕ, φ (GX.nsmul t k x) = GY.nsmul t k (φ x) := by
    intro k
    induction k with
    | zero => exact hone
    | succ k ih =>
        change φ (GX.mul t (GX.nsmul t k x) x) = GY.mul t (GY.nsmul t k (φ x)) (φ x)
        rw [hφ, ih]
  rw [RelativeGroupLaw.isTorsionPoint_def] at hx ⊢
  rw [← hnsmul, hx, hone]

