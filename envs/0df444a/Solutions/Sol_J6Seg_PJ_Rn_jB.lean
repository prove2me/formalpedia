variable {Q W N : ℕ} {T : Tables} {B : Blocks} {u : Vr} {D : Cs} {l b j s t α : ℕ}

theorem Rn.jB_sol_aux (hN : N ≤ 2 ^ W) (hW2 : 2 ≤ W) (hu : BV W u)
    (h1 : u 1 = B.st l) (h2 : u 2 = B.len l) (h4 : u 4 = b) (h5 : u 5 = j) (h7 : u 7 = l)
    (h20 : u 20 = Q) (h22 : u 22 = s) (h23 : u 23 = t) (h25 : u 25 = α) (h26 : u 26 = B.w)
    (hBs : B.s = s) (hs : 0 < s) (hQW : Q ≤ W + 1)
    (hcpl : ∀ i h, T.cpl i h = HvdH.expNeg Q (s ^ 2) (α ^ 2 * (HvdH.eKz s t i h).toNat))
    (bss : s * s ≤ 2 ^ W)
    (bX : α ^ 2 * (HvdH.eKz s t (l : ℤ) ((j : ℤ) - B.w)).toNat ≤ 2 ^ W)
    (bC : |T.cpl l ((j : ℤ) - B.w)| ≤ 2 ^ W)
    (bS : |u 8 + ccT T B l b j| ≤ 2 ^ W) :
    Rn (progL PJ.jB) u D (fun v' => v' 8 = u 8 + ccT T B l b j ∧ Fxk [8, 12, 29] u v' ∧ BV W v') D
      (costL W N PJ.jB) := by
  set kz := HvdH.eKz s t (l : ℤ) ((j : ℤ) - B.w) with hkz
  obtain ⟨w1, hw1⟩ : ∃ w1 : Vr, w1 = update u 29 ((s * s : ℕ) : ℤ) := ⟨_, rfl⟩
  have q1 : ∀ i : Fin HS, i ≠ 29 → w1 i = u i := fun i a => by rw [hw1, update_of_ne a]
  have d1 : (E.mul (.r 22) (.r 22)).den u = ((s * s : ℕ) : ℤ) := by
    simp only [E.den, h22]; push_cast; ring
  have d2 : xE2.den w1 = ((α ^ 2 * kz.toNat : ℕ) : ℤ) :=
    den_xE2 (by rw [q1 5 (by decide), h5]) (by rw [q1 7 (by decide), h7])
      (by rw [q1 26 (by decide), h26]) (by rw [q1 22 (by decide), h22])
      (by rw [q1 23 (by decide), h23]) (by rw [q1 25 (by decide), h25])
  obtain ⟨w2, hw2⟩ : ∃ w2 : Vr, w2 = update w1 12 ((α ^ 2 * kz.toNat : ℕ) : ℤ) := ⟨_, rfl⟩
  have q2 : ∀ i : Fin HS, i ≠ 29 → i ≠ 12 → w2 i = u i := fun i a b => by
    rw [hw2, update_of_ne b, q1 i a]
  have hcp : HvdH.expNeg (w2 20).toNat (w2 29).toNat (w2 12).toNat = T.cpl l ((j : ℤ) - B.w) := by
    rw [q2 20 (by decide) (by decide), h20, hw2, update_of_ne (by decide), hw1, update_self,
      update_self, Int.toNat_natCast, Int.toNat_natCast, Int.toNat_natCast, hcpl, ← hkz, pow_two s]
  obtain ⟨w3, hw3⟩ : ∃ w3 : Vr, w3 = update w2 12 (T.cpl l ((j : ℤ) - B.w)) := ⟨_, rfl⟩
  have q3 : ∀ i : Fin HS, i ≠ 29 → i ≠ 12 → w3 i = u i := fun i a b => by
    rw [hw3, update_of_ne b, q2 i a b]
  have d4 : (E.add (.r 8) (.mul cdE2 (.r 12))).den w3 = u 8 + ccT T B l b j := by
    have c := den_cdE2 (v := w3) (B := B) (l := l) (j := j) (b := b)
      (by rw [q3 1 (by decide) (by decide), h1]) (by rw [q3 2 (by decide) (by decide), h2])
      (by rw [q3 4 (by decide) (by decide), h4]) (by rw [q3 5 (by decide) (by decide), h5])
      (by rw [q3 7 (by decide) (by decide), h7]) (by rw [q3 26 (by decide) (by decide), h26])
      (by rw [q3 22 (by decide) (by decide), h22, hBs]) (by omega)
    simp only [E.den, c]
    rw [q3 8 (by decide) (by decide), hw3, update_self, ccT]
    split_ifs <;> ring
  have s1 : Ins.run (.a 29 (.mul (.r 22) (.r 22))) (u, D) = (w1, D) := by
    simp only [Ins.run, d1, hw1]
  have s2 : Ins.run (.a 12 xE2) (w1, D) = (w2, D) := by simp only [Ins.run, d2, hw2]
  have s3 : Ins.run (.en 12 20 29 12) (w2, D) = (w3, D) := by simp only [Ins.run, hcp, hw3]
  have s4 : Ins.run (.a 8 (.add (.r 8) (.mul cdE2 (.r 12)))) (w3, D) =
      (update w3 8 (u 8 + ccT T B l b j), D) := by simp only [Ins.run, d4]
  have e : runL PJ.jB (u, D) = (update w3 8 (u 8 + ccT T B l b j), D) := by
    simp only [PJ.jB, runL]; rw [s1, s2, s3, s4]
  have h2W : (4 : ℕ) ≤ 2 ^ W := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW2
  have hok : OkL W N PJ.jB (u, D) := by
    have bss' : |((s * s : ℕ) : ℤ)| ≤ 2 ^ W := by
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast bss
    have bX' : |((α ^ 2 * kz.toNat : ℕ) : ℤ)| ≤ 2 ^ W := by
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast bX
    have bC' : |HvdH.expNeg (w2 20).toNat (w2 29).toNat (w2 12).toNat| ≤ 2 ^ W := by
      rw [hcp]; exact bC
    have w220 : w2 20 = (Q : ℤ) := by rw [q2 20 (by decide) (by decide), h20]
    have w229 : w2 29 = ((s * s : ℕ) : ℤ) := by
      rw [hw2, update_of_ne (by decide), hw1, update_self]
    have w212 : w2 12 = ((α ^ 2 * kz.toNat : ℕ) : ℤ) := by rw [hw2, update_self]
    have o3 : Ins.ok W N (.en 12 20 29 12) (w2, D) := by
      simp only [Ins.ok]
      refine ⟨by decide, by decide, by decide, by decide, ?_, ?_, ?_, ?_, bC'⟩
      · rw [w220]; positivity
      · rw [w229]; positivity
      · rw [w212]; positivity
      · rw [w220, Int.toNat_natCast]; exact hQW
    simp only [PJ.jB, OkL, s1, s2, s3]
    refine ⟨?_, ?_, o3, ?_, trivial⟩ <;> simp only [Ins.ok]
    · exact ⟨by decide, rfl, by simp only [E.lb]; norm_num; omega, by rw [d1]; exact bss'⟩
    · exact ⟨by decide, rfl, by simp only [xE2, kzE2, hE2, bOfE, mx0E, E.lb]; norm_num; omega, by rw [d2]; exact bX'⟩
    · exact ⟨by decide, rfl, by simp only [cdE2, c1E2, c2E2, colE2, pE2, hE2, eqE, ltE, E.lb]; norm_num; omega, by rw [d4]; exact bS⟩
  have R := Rn.insL hN PJ.jB hu hok
  rw [e] at R
  dsimp only at R
  refine R.mono (fun v' ⟨ev, bv⟩ => ⟨by rw [ev, update_self], fun i hi => ?_, bv⟩) le_rfl
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
  rw [ev, update_of_ne hi.1, q3 i hi.2.2 hi.2.1]

end body

