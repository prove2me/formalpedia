-- Source module: Solutions.J6SegILPre4
/-!
# B-line IL, pre-tables (B5), part 4: polynomial expressions and the push loop

* `Poly e`: no `pow2`/`shl`, literals of absolute value `≤ 4`; `dg e` its degree;
  `mg_le_dg`: with every register value `≤ 2^A` (`A ≥ 2`), `mg e ≤ 2^(A·dg e)`. Every expression of
  the pre-table loops is polynomial (the powers `2^P`, `2^{P+1}` sit in registers `9`, `10`), so
  all cost conditions reduce to `dg e ≤ D` (by `decide`) and one uniform width `B = A·D + 1`.
* `pushLoop`: a counted loop whose body pushes `f k` onto `O` leaves `rv f N ++ O`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

theorem pow_le_pow' {A a b : ℕ} (h : a ≤ b) : 2 ^ (A * a) ≤ 2 ^ (A * b) :=
  Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ h)

/-- The uniform width: `dg e ≤ D` gives `mg e < 2^(A·D + 1)`. -/
theorem mg_lt {V : Fin HS → ℕ} {A D : ℕ} (hV : ∀ j, V j ≤ 2 ^ A) (hA : 2 ≤ A) {e : Ex HS}
    (hp : Poly e = true) (hd : dg e ≤ D) : mg V e < 2 ^ (A * D + 1) := by
  have h1 := (mg_le_dg hV hA e hp).trans (pow_le_pow' hd)
  have : 2 ^ (A * D) < 2 ^ (A * D + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

/-! ## The push loop -/

theorem rv_zero (f : ℕ → ℤ) : rv f 0 = [] := rfl

theorem rv_succ (f : ℕ → ℤ) (k : ℕ) : rv f (k + 1) = f k :: rv f k := by
  simp [rv, List.range_succ]

/-- **The push loop.** -/
theorem pushLoop (s : IState HS) (c : Fin HS → List ℤ) {C O : Fin HS} (hC : C ∉ rg) (hCO : C ≠ O)
    (hC5 : C.val < 56) (hc : c C = []) {b : RS} (hw : C ∉ b.writes) {n : Ex HS} (hn : InRg n)
    (hnl : n.Lin) (w : ℕ → Fin HS → ℤ) (hno : n.ok (encK s (RF (w 0) c))) {N : ℕ}
    (hN : n.eval (encK s (RF (w 0) c)) = N) {V : Fin HS → ℕ} {B : ℕ}
    (hV : ∀ j ∈ n.regs, |w 0 j| ≤ V j) (hm : mg V n < 2 ^ B) (f : ℕ → ℤ) {cb : ℕ}
    (hb : ∀ k < N, Sp b (encK s (RF (w k) (Function.update (Function.update c O (rv f k ++ c O)) C
        [(N : ℤ) - k])))
      (encK s (RF (w (k + 1)) (Function.update (Function.update c O (rv f (k + 1) ++ c O)) C
        [(N : ℤ) - k]))) cb) :
    Sp (.rep C n b) (encK s (RF (w 0) c)) (encK s (RF (w N) (Function.update c O (rv f N ++ c O))))
      ((n.size + 1) * 2000 * (B + 2) + N * (cb + 8000 * (B + 2) + 30) + 32) := by
  set F : ℕ → Fin HS → List ℤ := fun k => RF (w k) (Function.update c O (rv f k ++ c O)) with hF
  have hF0 : F 0 = RF (w 0) c := by simp [hF, rv_zero]
  have H := Sp.rep (s := s) (F := F) (C := C) (n := n) (b := b) (N := N) (B := B) (c := cb) hC5
    (fun k => by simp only [hF, RF_out hC, Function.update_of_ne hCO, hc]) hw (clean_of_inRg hn)
    (by rw [hF0]; exact hno) hnl
    (by rw [hF0]; exact bnd_of_mg _ V B n (RF_bnd hn hV) hm) (by rw [hF0]; exact hN)
    (fun k hk => by
      simp only [hF, upd_RF_out hC]
      exact hb k hk)
  rw [hF0] at H
  exact H

end J6Seg.PreT

end

