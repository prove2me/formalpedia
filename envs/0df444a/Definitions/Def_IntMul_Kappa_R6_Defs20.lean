section
-- Source module: Solutions.R6IL2CMath
/-!
# Round six, compact controls (I2C): the value-level mechanism

Colkitt's compact dirty controls, uniform variant (see `jain6/compact/DESIGN.md`).  The state of
one record is `(t, u, y)` (the temporary `T`, the control `U`, the target slot `Y`); the source
slot `x` is a parameter.  Radices: `W = 2^K` (slot segments), `R = 2^G` (compact digits);
`n` low selected positions `j_s = ρ + s K`.

* `dgt W s x = x / W^s % W`; `digits_add`: digit-wise addition without carries;
  `eq_of_digits`: equal low digits and equal high part give equal numbers.
* `segSum tf ru rv rw w0 u v n = Σ_{s<n} w0 rw^s tf (u / ru^s) (v / rv^s)` (the register loop).
* The offsets `oA` (`Y += Σ 2 z_s t_s 2^{j_s}`), `oB` (`Y += Σ z_s (1 - 2 t_s) 2^{j_s}`), `oS`
  (packed selected bits), `oC` (`Σ (y_s xor z_s) R^s`), `oT` (the ideal toggle).
* The pull maps `rT, rU, rY`, the inverse phase `phInv` and the whole pull composite `Psi`.
* **`Psi_good`**: on a good state `Psi` is the ideal map (toggle the `n` low selected bits of `y`
  by those of `x`); `Psi_bij`-type facts are proved at rank level.
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL2C

open Finset

/-! ## Digits -/

/-- Digit `s` of `x` in radix `W`. -/
def dgt (W s x : ℕ) : ℕ := x / W ^ s % W

/-! ## The register-loop sum -/

/-- `Σ_{s<n} w0 · rw^s · tf (u / ru^s) (v / rv^s)`. -/
def segSum (tf : ℤ → ℤ → ℤ) (ru rv rw w0 u v : ℤ) (n : ℕ) : ℤ :=
  ∑ s ∈ range n, w0 * rw ^ s * tf (u / ru ^ s) (v / rv ^ s)

/-! ## Parameters and the offsets -/

section Params

variable (K ρ G n : ℕ)

/-- Segment `s` of the slot `y` (the `K` bits at `ρ + s K`). -/
def seg (s y : ℕ) : ℕ := dgt (2 ^ K) s (y / 2 ^ ρ)

/-- Bit `ρ + s K` of `y`. -/
def ybit (s y : ℕ) : ℕ := seg K ρ s y % 2

/-- Digit `s` of a compact field. -/
def cdg (s w : ℕ) : ℕ := dgt (2 ^ G) s w

/-- `oA u t = Σ 2 z_s t_s 2^{ρ+sK}` (`z_s = cdg u s % 2`). -/
def oA (u t : ℕ) : ℤ :=
  segSum (fun a b => 2 * (a % 2) * (b % 2 ^ G)) (2 ^ G) (2 ^ G) (2 ^ K) (2 ^ ρ) u t n

/-- `oB u t = Σ z_s (1 - 2 t_s) 2^{ρ+sK}`. -/
def oB (u t : ℕ) : ℤ :=
  segSum (fun a b => (a % 2) * (1 - 2 * (b % 2 ^ G))) (2 ^ G) (2 ^ G) (2 ^ K) (2 ^ ρ) u t n

/-- `oS y = Σ ybit_s R^s` (packed selected bits). -/
def oS (y : ℕ) : ℤ := segSum (fun a _ => a % 2) (2 ^ K) 1 (2 ^ G) 1 ((y / 2 ^ ρ : ℕ) : ℤ) 0 n

/-- `oC u y = Σ (ybit_s xor z_s) R^s`. -/
def oC (u y : ℕ) : ℤ :=
  segSum (fun a b => (a + b) % 2) (2 ^ K) (2 ^ G) (2 ^ G) 1 ((y / 2 ^ ρ : ℕ) : ℤ) u n

/-- `oT x y = Σ x_s (1 - 2 y_s) 2^{ρ+sK}` (the ideal toggle). -/
def oT (x y : ℕ) : ℤ :=
  segSum (fun a b => (a % 2) * (1 - 2 * (b % 2))) (2 ^ K) (2 ^ K) (2 ^ K) (2 ^ ρ)
    ((x / 2 ^ ρ : ℕ) : ℤ) ((y / 2 ^ ρ : ℕ) : ℤ) n

end Params

/-! ## Closed forms of the offsets -/

/-! ## Segment-wise updates of a slot -/

/-! ## Modular pulls -/

/-- `((a - o) mod Q).toNat`. -/
def subM (Q : ℕ) (a : ℕ) (o : ℤ) : ℕ := (((a : ℤ) - o) % (Q : ℤ)).toNat

/-! ## States, the phases, the composites -/

/-- The state of one record: temporary `t`, control `u`, target slot `y`. -/
structure CS where
  t : ℕ
  u : ℕ
  y : ℕ

section Comp

variable (K ρ G n L : ℕ)

/-- The compact field size `R^n = 2^{nG}`. -/
abbrev Qc : ℕ := (2 ^ G) ^ n

/-- Pull of `T += o` is `T -= o`: `pT o` subtracts `o`. -/
def pT (o : ℤ) (c : CS) : CS := ⟨subM (Qc G n) c.t o, c.u, c.y⟩
def pU (o : ℤ) (c : CS) : CS := ⟨c.t, subM (Qc G n) c.u o, c.y⟩
def pY (o : ℤ) (c : CS) : CS := ⟨c.t, c.u, subM (2 ^ L) c.y o⟩

/-- The pull of one phase (`Y += oA; T += oS Y; Y += oB; T -= oC`). -/
def phInv (c : CS) : CS :=
  let c1 := pT G n (-(oC K ρ G n c.u c.y)) c
  let c2 := pY L (oB K ρ G n c1.u c1.t) c1
  let c3 := pT G n (oS K ρ G n c2.y) c2
  pY L (oA K ρ G n c3.u c3.t) c3

/-- The phase itself (push). -/
def phFw (c : CS) : CS :=
  let c1 := pY L (-(oA K ρ G n c.u c.t)) c
  let c2 := pT G n (-(oS K ρ G n c1.y)) c1
  let c3 := pY L (-(oB K ρ G n c2.u c2.t)) c2
  pT G n (oC K ρ G n c3.u c3.y) c3

/-- **The pull of the whole program** (load `U += sel x`, phase, unload, phase): apply the
pulls of the ten steps from the last to the first. -/
def Psi (x : ℕ) (c : CS) : CS :=
  phInv K ρ G n L (pU G n (oS K ρ G n x) (phInv K ρ G n L (pU G n (-(oS K ρ G n x)) c)))

/-- The program itself. -/
def Sfw (x : ℕ) (c : CS) : CS :=
  pU G n (oS K ρ G n x) (phFw K ρ G n L (pU G n (-(oS K ρ G n x)) (phFw K ρ G n L c)))

/-- The ideal map (toggle the `n` low selected bits of `y` by those of `x`). -/
def Tl (x y : ℕ) : ℕ := ((y : ℤ) + oT K ρ n x y).toNat

def TlS (x : ℕ) (c : CS) : CS := ⟨c.t, c.u, Tl K ρ n x c.y⟩

/-- The box. -/
def Box (c : CS) : Prop := c.t < Qc G n ∧ c.u < Qc G n ∧ c.y < 2 ^ L

/-- Good states. -/
def Good (c : CS) : Prop :=
  ∀ s < n, cdg G s c.t + 2 ≤ 2 ^ G ∧ cdg G s c.u + 2 ≤ 2 ^ G ∧ 1 ≤ seg K ρ s c.y / 2 ∧
    seg K ρ s c.y / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1)

end Comp

/-! ## Exactness on good states -/

end IntMul.Kappa.R6.IL2C

end

