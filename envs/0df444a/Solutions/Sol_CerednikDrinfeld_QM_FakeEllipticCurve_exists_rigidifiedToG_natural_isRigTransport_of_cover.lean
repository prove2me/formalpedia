    CerednikDrinfeld.QM.FakeEllipticCurve.exists_cover_connected_isPullbackVia_isFormalModuleVia coord hcoord B hBr x.1
  let f : Fin s.card → B := fun i => ((s.equivFin.symm i : ↥s) : B)
