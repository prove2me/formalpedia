section R05Seg10
/-!
# Atlas V-02 (D): lowered frame Bianchi identity and the Weyl/Ricci decomposition under frame derivatives

General (any null frame; no field equation):

* `bianchi_low`: the covariant second Bianchi identity `Σ_cyc(C,A,B) (∇_C R)_{IJAB} = 0` with the first index lowered,
  written with the connection components `omL`, `Ω` and the frame curvature `riemFL`:
  `(∇_C R)_{IJAB} = D_C R_{IJAB} + Σ_L ω_{ICL} Σ_M η_{LM} R_{MJAB} − Σ_L R_{ILAB} Ω_C^L_J − Σ_K Ω_C^K_A R_{IJKB}
  − Σ_K Ω_C^K_B R_{IJAK}`;
* `riemFL_decomp`, `fdir_riemFL_decomp`: `R_{IJAB} = C_{IJAB} + ½(η_{IA}R_{JB} − η_{IB}R_{JA} − η_{JA}R_{IB}
  + η_{JB}R_{IA}) − (R/6)(η_{IA}η_{JB} − η_{IB}η_{JA})`, also under a frame derivative (the Ricci tensor and the
  scalar curvature are kept as source terms; with IV's residual they are `2S + E − ½ g tr E`).
-/

open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}

/-! ### Smoothness of frame curvature, Weyl and Ricci components -/

theorem smoothOnC_Rfr (hF : FrameData g gi E Θ U) (A B : Fin 4) : SmoothOnC (Rfr g gi E Θ A B) U := by
  have h : SmoothOnC (fun z => ∑ μ, ∑ ν, (E A μ z * E B ν z) • Fom g gi E Θ μ ν z) U :=
    SmoothOnC.sum Finset.univ fun μ _ => SmoothOnC.sum Finset.univ fun ν _ =>
      SmoothOnC.smul ((hF.smooth_E A μ).mul (hF.smooth_E B ν)) (smoothOnC_Fom hF μ ν)
  intro a b
  exact (h a b).congr fun z hz => by rw [Rfr_eq hF hz]

/-! ### Lowered covariant Bianchi identity -/

theorem fdir_riemFL (hF : FrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (C I J A B : Fin 4) :
    (∑ K, etaNull I K * Dmat E C (Rfr g gi E Θ A B) x K J) = fdir E C (riemFL g gi E Θ I J A B) x := by
  have hU := hF.isOpen
  have e : riemFL g gi E Θ I J A B = fun z => ∑ K, etaNull I K * Rfr g gi E Θ A B z K J := rfl
  rw [e]
  simp only [Dmat, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, pdMC_apply, fdir, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun μ _ => ?_
  rw [cpdC_sum_of hU hx μ Finset.univ fun K _ => contDiffOn_const.mul (smoothOnC_Rfr hF A B K J), Finset.mul_sum]
  refine Finset.sum_congr rfl fun K _ => ?_
  rw [cpdC_const_mul]
  ring

theorem Rfr_eq_riemFL (g gi : Metric 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (A B L J : Fin 4) (x : Pt 4) :
    Rfr g gi E Θ A B x L J = ∑ M, etaNull L M * riemFL g gi E Θ M J A B x := by
  simp only [riemFL, Finset.mul_sum, ← mul_assoc]
  rw [Finset.sum_comm]
  simp only [← Finset.sum_mul, sum_etaNull_mul, Matrix.one_apply, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq, Finset.mem_univ, if_true]

/-! ### Weyl + Ricci decomposition of the frame curvature -/

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg10

-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hF : FrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (I J C A B : Fin 4) :
    covL g gi E Θ I J C A B x = ∑ K, etaNull I K * covX g gi E Θ C A B x K J := by
  unfold covL covX
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.mul_apply, mul_sub, mul_add, Finset.sum_sub_distrib, Finset.sum_add_distrib]
  rw [fdir_riemFL hF hx]
  have h1 : ∑ K, etaNull I K * ∑ L, Omega g gi E Θ C x K L * Rfr g gi E Θ A B x L J
      = ∑ L, omL g gi E Θ I C L x * ∑ M, etaNull L M * riemFL g gi E Θ M J A B x := by
    simp only [← Rfr_eq_riemFL, omL, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun L _ => Finset.sum_congr rfl fun K _ => by ring
  have h2 : ∑ K, etaNull I K * ∑ L, Rfr g gi E Θ A B x K L * Omega g gi E Θ C x L J
      = ∑ L, riemFL g gi E Θ I L A B x * Omega g gi E Θ C x L J := by
    simp only [riemFL, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun L _ => Finset.sum_congr rfl fun K _ => by ring
  have h3 : ∀ P Q : Fin 4 → Fin 4 → Fin 4 → Fin 4 → Fin 4, True := fun _ _ => trivial
  have h4 : ∑ K, etaNull I K * ∑ L, Omega g gi E Θ C x L A * Rfr g gi E Θ L B x K J
      = ∑ L, Omega g gi E Θ C x L A * riemFL g gi E Θ I J L B x := by
    simp only [riemFL, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun L _ => Finset.sum_congr rfl fun K _ => by ring
  have h5 : ∑ K, etaNull I K * ∑ L, Omega g gi E Θ C x L B * Rfr g gi E Θ A L x K J
      = ∑ L, Omega g gi E Θ C x L B * riemFL g gi E Θ I J A L x := by
    simp only [riemFL, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun L _ => Finset.sum_congr rfl fun K _ => by ring
  rw [h1, h2, h4, h5]
