    (fun q => blockB certificate051 q certificate051.blockers[q]!) = true := by
  apply List.all_eq_true.mpr
  intro q hq
  have hq' : q < 6561 := List.mem_range.mp hq
  by_cases h : q < 3328
  · simpa only [Nat.zero_add] using case051_blockers0 ⟨q,h⟩
  · have hle : 3328 ≤ q := by omega
    simpa only [Nat.add_sub_of_le hle] using
      case051_blockers1 ⟨q-3328,by omega⟩
private theorem rows_check : certificate051.rows.toList.all (rowB certificate051) = true := by
  decide_cbv
private theorem covers_check : (List.range certificate051.pool.size).all (localCoverB certificate051) = true := by
  decide_cbv
private theorem cost_check : decide (cost certificate051 < certificate051.denominator * (deletedCount certificate051+1)) = true := by
  decide_cbv
theorem solution : CompletionBound (decode 249) (1 : ZMod 3) := by
  have hs : certificate051.blockers.size = 6561 := by
    simp only [certificate051, binaryBlockers, Array.size_ofFn]
  have hb : CompletionBound (decode certificate051.normal) certificate051.level := by
    apply boolean_check_completion_bound
    unfold verifyB
    rw [hs, all_blocks, rows_check, covers_check, cost_check]
    decide_cbv
  exact hb
