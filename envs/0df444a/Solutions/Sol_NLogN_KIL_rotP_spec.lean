namespace NLogN.KIL

open AModel

theorem length_recR (xs : List ℤ) (Q B p y : ℕ) : (recR xs Q B p y).length = B := by
  simp [recR]

theorem inR_recR {xs : List ℤ} {P Q B : ℕ} (h : xs.length = P * Q * B) :
    inR (recR xs Q B) Q P = xs := by
  conv_rhs => rw [list_eq_range xs, h, map_range3]
  rfl

theorem rot_split (g : ℕ → List ℤ) {Q a : ℕ} (ha : a ≤ Q) :
    (List.range' (Q - a) a).flatMap g ++ (List.range (Q - a)).flatMap g =
      (List.range Q).flatMap fun y => g ((y + Q - a) % Q) := by
  have e : List.range Q = List.range a ++ (List.range (Q - a)).map (a + ·) := by
    rw [← List.range'_eq_map_range, List.range_eq_range', List.range_eq_range']
    have := List.range'_append (s := 0) (m := a) (n := Q - a) (step := 1)
    simp only [Nat.zero_add, Nat.one_mul, Nat.add_sub_cancel' ha] at this
    exact this.symm
  rw [e, List.flatMap_append, List.flatMap_map, List.range'_eq_map_range, List.flatMap_map]
  congr 1
  · refine fm_congr fun y hy => ?_
    simp only [List.mem_range] at hy
    congr 1; rw [Nat.mod_eq_of_lt (by omega)]; omega
  · refine fm_congr fun y hy => ?_
    simp only [List.mem_range] at hy
    congr 1
    rw [show a + y + Q - a = y + Q by omega, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]

theorem decode_three {P Q B p y b : ℕ} (hp : p < P) (hy : y < Q) (hb : b < B) :
    decode [P, Q, B] ((p * Q + y) * B + b) = [p, y, b] := by
  have hv : Valid [P, Q, B] [p, y, b] :=
    List.Forall₂.cons hp (List.Forall₂.cons hy (List.Forall₂.cons hb List.Forall₂.nil))
  have he : encode [P, Q, B] [p, y, b] = (p * Q + y) * B + b := by simp [encode, AModel.vol]; ring
  rw [← he, decode_encode hv]

theorem outR_recR (xs : List ℤ) (P Q B : ℕ) (as : ℕ → ℕ) (has : ∀ p, as p ≤ Q) :
    outR (recR xs Q B) Q as P = AModel.pull [P, Q, B] [P, Q, B] (rotAddr Q as) 0 xs := by
  unfold AModel.pull
  rw [show AModel.vol [P, Q, B] = P * Q * B by simp [AModel.vol]; ring, map_range3]
  unfold outR
  refine fm_congr fun p hp => ?_
  simp only [List.mem_range] at hp
  rw [rotBlk, firstR, secondR, ← List.flatMap_def, ← List.flatMap_def, rot_split _ (has p)]
  refine fm_congr fun y hy => ?_
  simp only [List.mem_range] at hy
  unfold recR
  refine List.map_congr_left fun b hb => ?_
  simp only [List.mem_range] at hb
  rw [decode_three hp hy hb]
  simp [rotAddr, encode, AModel.vol]
  ring_nf

end NLogN.KIL

namespace NLogN.KIL

open IntMul RS AModel

theorem cRBlk_le {Q B Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    cRBlk Q B Bb ≤ 150000 * (Q * B) * (Bb + 2) := by
  unfold cRBlk
  have hQ : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB1
  have h1 : 1 ≤ Q * B := le_trans hQ1 hQ
  have e : Q * ((1 + 1) * 2000 * (Bb + 2) + B * (14000 * (Bb + 2)) + 32 + 8000 * (Bb + 2) + 30) =
      12000 * Q * (Bb + 2) + 14000 * (Q * B) * (Bb + 2) + 62 * Q := by ring
  have h2 : Q * (Bb + 2) ≤ Q * B * (Bb + 2) := Nat.mul_le_mul_right _ hQ
  have h3 : (Bb + 2) ≤ Q * B * (Bb + 2) := by nlinarith
  rw [e]
  nlinarith

theorem cRot_le {P Q B Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    NLogN.KIL.cRot P Q B Bb ≤ 200000 * (P * (Q * B) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  unfold NLogN.KIL.cRot
  have hb := cRBlk_le (Bb := Bb) hB1 hQ1
  have h1 : 1 ≤ Q * B := Nat.mul_pos hQ1 hB1
  have h5 : P * (cRBlk Q B Bb + 8000 * (Bb + 2) + 30) ≤
      P * (150000 * (Q * B) * (Bb + 2) + 8000 * (Bb + 2) + 30) := by gcongr
  have h6 : P * (Bb + 2) ≤ P * (Q * B) * (Bb + 2) := by
    apply Nat.mul_le_mul_right; exact Nat.le_mul_of_pos_right _ h1
  have h7 : P ≤ P * (Q * B) * (Bb + 2) := by nlinarith
  have e : P * (150000 * (Q * B) * (Bb + 2) + 8000 * (Bb + 2) + 30) =
      150000 * (P * (Q * B)) * (Bb + 2) + 8000 * (P * (Bb + 2)) + 30 * P := by ring
  nlinarith

theorem encK_rIO_eq (t : IState HS) (x w : List ℤ) (P Q B : ℕ) (R L1 L2 L4 L14 : List Item)
    (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2) (h4 : t.G 4 = .int B :: L4) :
    NLogN.KIL.encK (rBase t R L1 L2 L4 L14) (toF (rIO x w P Q B)) =
      (t.upd 0 (ints x ++ R)).upd 14 (ints w ++ L14) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  fin_cases j <;> simp +decide [rBase, toF, rIO, h1, h2, h4]
  all_goals first | exact h1.symm | exact h2.symm | exact h4.symm

end NLogN.KIL

