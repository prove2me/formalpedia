-- title:
--   Corollary 2.3, p. 943 — under uniform continuity of DF there is a jointly measurable ∂_μf with DF(t, X̃) = ∂_μf(t, ℙ̃_{X̃_{t∧·}}, X̃_{t∧·}), unique if continuous
-- statement:
--   Let all the conditions of Theorem 2.2 hold, and assume further that the continuity (2.11) of $DF$ is uniform. Then there is a jointly Borel-measurable function $\partial_\mu f:\widehat\Theta\times\widehat\Omega\to\mathbb R^d$ such that for every $t\in[0,T]$ and $\tilde X\in\mathbb L^2(\tilde\Omega;\widehat\Omega)$,
--   $$
--   DF(t,\tilde X)=\partial_\mu f\big(t,\tilde{\mathbb P}_{\tilde X_{t\wedge\cdot}},\tilde X_{t\wedge\cdot}\big),\qquad\tilde{\mathbb P}\text{-a.s.}\tag{2.17}
--   $$
--   Moreover, if $\partial_\mu f(t,\cdot)$ is jointly continuous in $\widehat{\mathcal P}_2\times\widehat\Omega$ for all $t$, then $\partial_\mu f$ is unique: any two jointly measurable functions satisfying (2.17) that are both jointly continuous in $(\hat\mu,\hat\omega)\in\widehat{\mathcal P}_2\times\widehat\Omega$ for every $t\in[0,T]$ agree at every point $(t,\hat\mu_{[0,t]},\hat\omega_{t\wedge\cdot})$ with $t\le T$, $\hat\mu\in\widehat{\mathcal P}_2$, $\hat\omega\in\widehat\Omega$.
--
--   The corollary turns the pointwise representation of Theorem 2.2 into a single derivative function on $\widehat\Theta\times\widehat\Omega$, which is the $\partial_\mu f$ of Definition 2.5.
--
--   **Formalization Note** "Uniform" is read as uniform in $t$ and in $\tilde X$ (see the definition `IsUnifL2ContDF`); the page does not specify it. Joint Borel measurability is with respect to the product of the Borel $\sigma$-algebra of $[0,\infty)$, the Giry $\sigma$-algebra on measures (generated by $\mu\mapsto\mu(A)$) and the evaluation $\sigma$-algebra on $\widehat\Omega$; the Giry $\sigma$-algebra is the Borel $\sigma$-algebra of the weak topology on a Polish space, which is not obviously that of $\mathcal W_2$. Joint continuity in $\widehat{\mathcal P}_2\times\widehat\Omega$ is for $\mathcal W_2+d_{SK}$. Uniqueness is stated at the points $(t,\hat\mu_{[0,t]},\hat\omega_{t\wedge\cdot})$, the only points (2.17) evaluates: at other points the value of $\partial_\mu f$ is not constrained by (2.17).
-- source:
--   Wu, Zhang, Viscosity solutions to parabolic master equations and McKean–Vlasov SDEs with closed-loop controls, Ann. Appl. Probab. 30(2) (2020), Corollary 2.3 and (2.17), p. 943

import Mathlib
import Definitions.Def_EthierKurtz_SDEState
import Definitions.Def_MasterVisc_Ito_Setting
import Definitions.Def_MasterVisc_Ito_Derivatives
import Definitions.Def_MasterVisc_Ito_Lift
open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace MasterVisc.Ito

theorem corollary_2_3 {d : ℕ} {T : ℝ≥0}
    {Ω' : Type} [MeasurableSpace Ω'] [TopologicalSpace Ω'] [PolishSpace Ω'] [BorelSpace Ω']
    (P : Measure Ω') [IsProbabilityMeasure P] [NullSingletonClass P]
    (f : ℝ≥0 → Measure (DPath d T) → ℝ) (hf : ContOnΘD f)
    (DF : ℝ≥0 → (Ω' → DPath d T) → Ω' → EthierKurtz.SDEState d)
    (hDF : IsFrechetLift P f DF) (hcont : IsL2ContDF P DF) (hunif : IsUnifL2ContDF P DF) :
    (∃ g : ℝ≥0 → Measure (DPath d T) → DPath d T → EthierKurtz.SDEState d,
      Measurable (fun p : ℝ≥0 × Measure (DPath d T) × DPath d T => g p.1 p.2.1 p.2.2) ∧
      ∀ t (X : Ω' → DPath d T), t ≤ T → IsL2D P X →
        DF t X =ᵐ[P] fun ω => g t (P.map (fun ω' => stopD t (X ω'))) (stopD t (X ω))) ∧
    (∀ g₁ g₂ : ℝ≥0 → Measure (DPath d T) → DPath d T → EthierKurtz.SDEState d,
      (∀ g ∈ ({g₁, g₂} : Set (ℝ≥0 → Measure (DPath d T) → DPath d T → EthierKurtz.SDEState d)),
        Measurable (fun p : ℝ≥0 × Measure (DPath d T) × DPath d T => g p.1 p.2.1 p.2.2) ∧
        (∀ t (X : Ω' → DPath d T), t ≤ T → IsL2D P X →
          DF t X =ᵐ[P] fun ω => g t (P.map (fun ω' => stopD t (X ω'))) (stopD t (X ω))) ∧
        (∀ t μ ω, t ≤ T → IsP2D μ → ∀ ε > 0, ∃ δ > 0, ∀ μ' ω', IsP2D μ' →
          W2SK μ μ' + dSK ω ω' < ENNReal.ofReal δ → ‖g t μ' ω' - g t μ ω‖ < ε)) →
      ∀ t μ ω, t ≤ T → IsP2D μ →
        g₁ t (μ.map (stopD t)) (stopD t ω) = g₂ t (μ.map (stopD t)) (stopD t ω)) := by sorry

end MasterVisc.Ito
