theorem NearU.mono {Δ : ℕ} {e e' : ℝ} {z : GI} (h : NearU Δ e z) (he : e ≤ e') : NearU Δ e' z :=
  let ⟨Z, hZ, hz⟩ := h; ⟨Z, hZ, hz.trans he⟩

theorem oprod_near (Δ : ℕ) (A B : List GI) {ea eb : ℝ} (hA : ∀ a ∈ A, NearU Δ ea a)
    (hB : ∀ b ∈ B, NearU Δ eb b) (ha1 : ea ≤ 1) :
    ∀ x ∈ oprod Δ A B, NearU Δ (ea + 2 * eb + 2 * (2 : ℝ)⁻¹ ^ Δ) x := by
  intro x hx
  simp only [oprod, List.mem_flatMap, List.mem_map] at hx
  obtain ⟨a, ha, b, hb, rfl⟩ := hx
  obtain ⟨Z, hZ, hz⟩ := hA a ha
  obtain ⟨W, hW, hw⟩ := hB b hb
  exact ⟨Z * W, norm_mul_le_one hZ hW, step_err Δ a b Z W hZ hW hz ha1 hw⟩

theorem axTab_near (Δ s t : ℕ) (hst : s ≤ t) (ht : 0 < t)
    (hu : (4 * (t : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1) :
    ∀ x ∈ axTab Δ s t, NearU Δ (4 * (t : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ Δ) x := by
  intro x hx
  obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 hx
  rw [length_axTab] at hk
  refine ⟨_, ?_, axTab_err Δ s t hst ht hu k hk⟩
  exact norm_exp_phase (-(Real.pi * s * ((k : ℤ) : ℝ) ^ 2 / t)) _ (by push_cast; ring)

