-- title:
--   The relaxed formulation: relaxed controls $\mathcal V$, the canonical space, the generator $L$, the admissible laws $\mathcal R$ and the reward $\Gamma^\mu$
-- statement:
--   This module encodes the relaxed (martingale-problem) formulation of §4.2.
--
--   1. **Relaxed controls.** $\mathcal V$ is the set of measures $q$ on $[0,T]\times A$ with first marginal equal to Lebesgue measure, with the topology of weak convergence.
--   2. **Canonical space.** $\Omega=\mathcal V\times[0,1]\times\mathcal C^d$ with coordinates $(\Lambda,U,X)$ and the canonical filtration $\mathcal F_t=\sigma\big(\Lambda|_{[0,t]\times A},U,(X_s)_{s\le t}\big)$.
--   3. **Generator.** For $\varphi\in C^\infty_c(\mathbb R^d)$,
--   $$L\varphi(t,x,a)=b(t,x,a)\cdot\nabla\varphi(x)+\tfrac12\mathrm{Tr}\big(\sigma\sigma^\top(t,x)\nabla^2\varphi(x)\big),$$
--   and $N^\varphi_t(q,u,x)=\varphi(x_t)-\int_{[0,t]\times A}L\varphi(s,x_s,a)\,q(ds,da)$.
--   4. **Admissible laws.** For an initial law $\lambda$, $\mathcal R$ is the set of $P\in\mathcal P(\Omega)$ with $P\circ(U,X_0)^{-1}=\lambda$ such that $(N^\varphi_t)_{t\in[0,T]}$ is a $P$-martingale for every $\varphi\in C^\infty_c(\mathbb R^d)$. With $\lambda=\delta_u\times m$ this is the set $\mathcal R_{u,m}$ of the proof of Lemma 5.1.
--   5. **Reward** (4.1): $\Gamma^\mu(q,u,x)=g(x_T,\mathsf W\mu_T(u))+\int_{[0,T]\times A}f(t,x_t,\mathsf W\mu_t(u),a)\,q(dt,da)$.
--
--   This is the setting in which Markovian controls are shown to achieve the relaxed value, (4.10) and (5.1).
--
--   **Formalization Note** $\mathcal V$ is the set of finite measures on $\mathbb R\times A$ whose first marginal is Lebesgue measure on $[0,T]$, with the subspace topology and its Borel σ-field. The σ-field generated by $\Lambda|_{[0,t]\times A}$ is generated by the evaluations $\Lambda(B)$, $B\subseteq[0,t]\times A$ Borel. "Martingale on $[0,T]$" is stated directly: each $N_t$ is $\mathcal F_t$-measurable and integrable, and $\mathbb E[N_t;S]=\mathbb E[N_s;S]$ for $s\le t\le T$ and $S\in\mathcal F_s$. $C^\infty_c$ is `ContDiff ℝ ∞` with compact support; $\nabla^2\varphi$ is the second Fréchet derivative. (4.1) is printed for $\mu\in\mathcal P_{\mathrm{Unif}}([0,1]\times\mathcal C^d)$ through its marginals $\mu_t$; here the flow $(\mu_t)$ is the argument.
-- source:
--   Lacker, Soret, A Label-State Formulation of Stochastic Graphon Games and Approximate Equilibria on Large Networks, arXiv:2204.09642v1, §4.2 p.16 (𝒱, Ω, 𝔽, L, N^φ, ℛ, (4.1)); proof of Lemma 5.1 p.22 (ℛ_{u,m})

import Mathlib
import Definitions.Def_GraphonLabelGame_Model

open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped ENNReal NNReal Matrix

namespace GraphonLabelGame

/-- The set `𝒱` of relaxed controls (§4.2, p.16): measures `q` on `[0, T] × A` whose first
marginal is Lebesgue measure on `[0, T]`, with the topology of weak convergence and its Borel
σ-field.

**Formalization Note** Encoded as finite measures on `ℝ × A` whose first marginal is
`Leb|_{[0,T]}`; such a measure is concentrated on `[0, T] × A`. -/
abbrev RelCtrl (T : ℝ≥0) (A : Type*) [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A] :=
  {q : FiniteMeasure (ℝ × A) //
    (q : Measure (ℝ × A)).map Prod.fst = volume.restrict (Icc (0 : ℝ) T)}

noncomputable instance (T : ℝ≥0) (A : Type*) [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A] :
    MeasurableSpace (RelCtrl T A) := borel _

/-- The canonical space `Ω := 𝒱 × [0, 1] × C^d` (§4.2, p.16), with generic element `(q, u, x)`
and coordinate maps `Λ, U, X`.

**Formalization Note** The label coordinate is `ℝ`; every law in `ℛ` puts its `U`-marginal on
`[0, 1]` when `λ ∈ P_Unif`. -/
abbrev CanSpace (d : ℕ) (T : ℝ≥0) (A : Type*) [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A] :=
  RelCtrl T A × ℝ × Path d T

set_option warn.classDefReducibility false in
/-- The canonical σ-field `𝓕ₜ` (§4.2, p.16), generated by `Λ|_{[0,t]×A}`, `U` and
`(Xₛ)_{s ∈ [0, t]}`. The restricted random measure `Λ|_{[0,t]×A}` generates the same σ-field as
the evaluations `Λ(B)`, `B ⊆ [0, t] × A` Borel. -/
noncomputable def canSigma {d : ℕ} {T : ℝ≥0} {A : Type*} [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A]
    (t : ℝ≥0) : MeasurableSpace (CanSpace d T A) :=
  (⨆ (B : Set (ℝ × A)) (_ : MeasurableSet B) (_ : B ⊆ Icc (0 : ℝ) t ×ˢ univ),
      MeasurableSpace.comap (fun ω : CanSpace d T A => (ω.1.1 : Measure (ℝ × A)) B)
        inferInstance)
    ⊔ MeasurableSpace.comap (fun ω : CanSpace d T A => ω.2.1) inferInstance
    ⊔ ⨆ (s : ℝ≥0) (_ : s ≤ t),
      MeasurableSpace.comap (fun ω : CanSpace d T A => pathAt ω.2.2 s) inferInstance

/-- The generator (§4.2, p.16):
`Lφ(t, x, a) := b(t, x, a) · ∇φ(x) + ½ Tr(σσᵀ(t, x) ∇²φ(x))`. -/
noncomputable def genL {d d₀ : ℕ} {A : Type*} (D : Data d d₀ A) (φ : (Fin d → ℝ) → ℝ)
    (t : ℝ≥0) (x : Fin d → ℝ) (a : A) : ℝ :=
  fderiv ℝ φ x (D.b t x a)
    + (1 / 2) * ∑ j, ∑ k, (D.σ t x * (D.σ t x)ᵀ) j k
        * fderiv ℝ (fderiv ℝ φ) x (Pi.single k 1) (Pi.single j 1)

/-- The process `N^φ_t(q, u, x) := φ(xₜ) − ∫_{[0,t]×A} Lφ(s, xₛ, a) q(ds, da)` (p.16). -/
noncomputable def Nphi {d d₀ : ℕ} {A : Type*} [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A]
    (D : Data d d₀ A) (φ : (Fin d → ℝ) → ℝ) (t : ℝ≥0) (ω : CanSpace d D.T A) : ℝ :=
  φ (pathAt ω.2.2 t)
    - ∫ p in Icc (0 : ℝ) t ×ˢ (univ : Set A),
        genL D φ p.1.toNNReal (pathAt ω.2.2 p.1.toNNReal) p.2 ∂(ω.1.1 : Measure (ℝ × A))

/-- `(Nₜ)_{t ∈ [0, T]}` is a `P`-martingale for the σ-fields `𝓖ₜ`: each `Nₜ` is
`𝓖ₜ`-measurable and integrable, and `E[Nₜ ; S] = E[Nₛ ; S]` for `s ≤ t ≤ T` and `S ∈ 𝓖ₛ`. -/
def IsMartingaleOn {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (𝓖 : ℝ≥0 → MeasurableSpace Ω) (N : ℝ≥0 → Ω → ℝ) (T : ℝ≥0) : Prop :=
  (∀ t ≤ T, StronglyMeasurable[𝓖 t] (N t) ∧ Integrable (N t) P) ∧
    ∀ s t : ℝ≥0, s ≤ t → t ≤ T → ∀ S : Set Ω, MeasurableSet[𝓖 s] S →
      ∫ ω in S, N t ω ∂P = ∫ ω in S, N s ω ∂P

/-- The set `ℛ` of admissible laws (§4.2, p.16) for the initial law `λ`: probability measures
`P` on `Ω` with (1) `P ∘ (U, X₀)⁻¹ = λ` and (2) `(N^φ_t)_{t ∈ [0, T]}` a `P`-martingale for the
canonical filtration, for every `φ ∈ C_c^∞(ℝᵈ)`. With `λ = δᵤ × m` this is the set `ℛ_{u,m}` of
the proof of Lemma 5.1 (p.22). -/
def admissibleLaws {d d₀ : ℕ} {A : Type*} [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A]
    (D : Data d d₀ A) (lam : Measure (ℝ × (Fin d → ℝ))) :
    Set (ProbabilityMeasure (CanSpace d D.T A)) :=
  {P | (P : Measure (CanSpace d D.T A)).map (fun ω => (ω.2.1, pathAt ω.2.2 0)) = lam ∧
    ∀ φ : (Fin d → ℝ) → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ → HasCompactSupport φ →
      IsMartingaleOn (P : Measure (CanSpace d D.T A)) canSigma (Nphi D φ) D.T}

/-- The reward `Γ^μ(q, u, x) := g(x_T, 𝐖μ_T(u)) + ∫_{[0,T]×A} f(t, xₜ, 𝐖μₜ(u), a) q(dt, da)`
of (4.1), p.16, for a measure flow `μ·`.

**Formalization Note** (4.1) is printed for `μ ∈ P_Unif([0, 1] × C^d)` through its time marginals
`μₜ`; here the flow `(μₜ)` is the argument. -/
noncomputable def Gamma {d d₀ : ℕ} {A : Type*} [MetricSpace A] [CompactSpace A] [MeasurableSpace A] [BorelSpace A]
    (D : Data d d₀ A) (W : ℝ → ℝ → ℝ) (μ : ℝ≥0 → ProbabilityMeasure (ℝ × (Fin d → ℝ)))
    (ω : CanSpace d D.T A) : ℝ :=
  D.g (pathAt ω.2.2 D.T) (Wop W (μ D.T : Measure (ℝ × (Fin d → ℝ))) ω.2.1)
    + ∫ p in Icc (0 : ℝ) D.T ×ˢ (univ : Set A),
        D.f p.1.toNNReal (pathAt ω.2.2 p.1.toNNReal)
          (Wop W (μ p.1.toNNReal : Measure (ℝ × (Fin d → ℝ))) ω.2.1) p.2
        ∂(ω.1.1 : Measure (ℝ × A))

end GraphonLabelGame


