private theorem s002.t0914 (d : JLData K S epsS ω) (D : s002 (S := S) b)
    (v : HeightOneSpectrum (𝓞 K)) :
    ∃ k' : GL (Fin 2) (Valued.v : Valuation (v.adicCompletion K) ℤᵐ⁰).integer,
      LocalIwasawa.d101 ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K) (Units.ne_zero _)
          * compAt v b
        = unipotent (D.xT d v)
          * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero
              (D.cT d v)
          * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero
              ^ D.nT d v
          * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k' := by
  rw [D.t0910 v]
  by_cases h : D.d109 d v
  · simp only [s002.xT, s002.cT, s002.nT, if_pos h]
    exact LocalIwasawa.t0899 Valued.v (uniformizerUnit K v : v.adicCompletion K)
      (uniformizerUnit K v).ne_zero (valued_uniformizerUnit K v) (Units.ne_zero _) (d105 d v)
      (d106 d v) (t0906 d v) (t0907 d v) (D.xAll v) (D.cAll v)
      (D.nAll v) (D.kAll v) h
  · simp only [s002.xT, s002.cT, s002.nT, if_neg h]
    exact LocalIwasawa.t0900 Valued.v (uniformizerUnit K v : v.adicCompletion K)
      (uniformizerUnit K v).ne_zero (valued_uniformizerUnit K v) (Units.ne_zero _) (d105 d v)
      (d106 d v) (t0906 d v) (t0907 d v) (D.xAll v) (D.cAll v)
      (D.nAll v) (D.d108 d v) (D.kAll v) (D.t0911 d (D.t0912 d h))
      (D.t0913 d h)

private noncomputable def s002.d110 (d : JLData K S epsS ω) (D : s002 (S := S) b) :
    Finset (HeightOneSpectrum (𝓞 K)) :=
  (t0881 (K := K) (-d.A)).toFinset \ (S ∪ D.L.toFinset)

private theorem s002.t0915 (d : JLData K S epsS ω) (D : s002 (S := S) b)
    (v : HeightOneSpectrum (𝓞 K)) :
    v ∈ D.d110 d
      ↔ Valued.v ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K) ≠ 1 ∧ v ∉ S ∪ D.L.toFinset := by
  rw [s002.d110, Finset.mem_sdiff, Set.Finite.mem_toFinset, Set.mem_setOf_eq]

private noncomputable def s002.d111 (d : JLData K S epsS ω) (D : s002 (S := S) b)
    (b' : AdelicGL2 (𝓞 K) K)
    (hb' : ∀ v : HeightOneSpectrum (𝓞 K), compAt v b'
      = LocalIwasawa.d101 ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K) (Units.ne_zero _)
          * compAt v b) :
    s002 (S := S) b' where
  L := D.L ++ (D.d110 d).toList
  nodup := by
    refine List.nodup_append.2 ⟨D.nodup, Finset.nodup_toList _, fun v hv w hw hvw => ?_⟩
    subst hvw
    exact ((D.t0915 d v).1 (Finset.mem_toList.1 hw)).2
      (Finset.mem_union_right _ (List.mem_toFinset.2 hv))
  not_mem v hv := by
    rcases List.mem_append.1 hv with h | h
    · exact D.not_mem v h
    · exact fun hS => ((D.t0915 d v).1 (Finset.mem_toList.1 h)).2 (Finset.mem_union_left _ hS)
  level_eq_zero v hv :=
    D.level_eq_zero v fun h => hv (by
      rw [List.toFinset_append, ← Finset.union_assoc]
      exact Finset.mem_union_left _ h)
  x := D.xT d
  c := D.cT d
  n := D.nT d
  k v := (D.t0914 d v).choose
  compAt_eq v _ := by
    rw [hb' v]
    exact (D.t0914 d v).choose_spec
  isIntegral w hwS hwL := by
    have hwL' : w ∉ D.L := fun h => hwL (List.mem_append.2 (Or.inl h))
    have hwF : w ∉ D.d110 d := fun h => hwL (List.mem_append.2 (Or.inr (Finset.mem_toList.2 h)))
    have hA : Valued.v ((localOf K w (-d.A) : (w.adicCompletion K)ˣ) : w.adicCompletion K) = 1 := by
      by_contra hne
      exact hwF ((D.t0915 d w).2 ⟨hne, fun h => (Finset.mem_union.1 h).elim hwS
        fun h' => hwL' (List.mem_toFinset.1 h')⟩)
    rw [t0904] at hA
    have hiff := t0880 d w hA b
    rw [map_mul, t0901] at hiff
    rw [hb' w]
    exact hiff.2 (D.isIntegral w hwS hwL')

private noncomputable def s002.d112 (d : JLData K S epsS ω) {g₀ : AdelicGL2 (𝓞 K) K}
    (D : s002 (S := S) (d087 g₀)) :
    s002 (S := S) (d087 (globalPoints (𝓞 K) K (weylA d) * g₀)) :=
  D.d111 d (d087 (globalPoints (𝓞 K) K (weylA d) * g₀)) (t0903 d g₀)

variable (d : JLData K S epsS ω) {g₀ : AdelicGL2 (𝓞 K) K} (D : s002 (S := S) (d087 g₀))

private theorem s002.t0916 :
    (D.d112 d).L = D.L ++ (D.d110 d).toList := rfl

private theorem s002.t0917 (v : HeightOneSpectrum (𝓞 K)) :
    v ∈ (D.d112 d).L
      ↔ v ∈ D.L ∨ (Valued.v ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K) ≠ 1
          ∧ v ∉ S ∪ D.L.toFinset) := by
  rw [s002.t0916, List.mem_append, Finset.mem_toList, D.t0915 d]

private theorem s002.t0918 {v : HeightOneSpectrum (𝓞 K)} (h : D.d109 d v) :
    (D.d112 d).c v = -D.combExp d v := by
  dsimp only [s002.d112, s002.d111, s002.cT]
  exact if_pos h

private theorem s002.t0919 {v : HeightOneSpectrum (𝓞 K)}
    (h : ¬ D.d109 d v) : (D.d112 d).c v = D.combExp d v - 2 * D.d108 d v := by
  dsimp only [s002.d112, s002.d111, s002.cT]
  exact if_neg h

private theorem s002.t0920 {v : HeightOneSpectrum (𝓞 K)} (h : D.d109 d v) :
    (D.d112 d).n v = D.nAll v + D.combExp d v := by
  dsimp only [s002.d112, s002.d111, s002.nT]
  exact if_pos h

private theorem s002.t0921 {v : HeightOneSpectrum (𝓞 K)}
    (h : ¬ D.d109 d v) : (D.d112 d).n v = D.nAll v + D.d108 d v := by
  dsimp only [s002.d112, s002.d111, s002.nT]
  exact if_neg h

private theorem s002.t0922 {v : HeightOneSpectrum (𝓞 K)} (h : D.d109 d v) :
    (D.d112 d).x v = 0 := by
  dsimp only [s002.d112, s002.d111, s002.xT]
  exact if_pos h

private theorem s002.t0923 {v : HeightOneSpectrum (𝓞 K)}
    (h : ¬ D.d109 d v) : (D.d112 d).x v = -(D.d107 d v)⁻¹ := by
  dsimp only [s002.d112, s002.d111, s002.xT]
  exact if_neg h

private theorem s002.t0924 {v : HeightOneSpectrum (𝓞 K)}
    (h : D.d109 d v) : (D.d112 d).entries v = 0 := by
  rw [s002.entries, D.t0922 d h, mul_zero]

private theorem s002.t0925 {v : HeightOneSpectrum (𝓞 K)}
    (h : ¬ D.d109 d v) :
    Valued.v ((D.d112 d).entries v) = WithZero.exp (D.combExp d v - D.d108 d v) := by
  rw [s002.entries, D.t0923 d h, D.t0919 d h,
    Valuation.map_mul, Valuation.map_neg, map_inv₀, D.t0911 d (D.t0912 d h),
    t0359, ← WithZero.exp_neg, ← WithZero.exp_add]
  congr 1
  ring

private theorem s002.t0926 {v : HeightOneSpectrum (𝓞 K)}
    (h : ¬ D.d109 d v) :
    (D.d112 d).entries v * D.d107 d v
      = -((uniformizerUnit K v ^ (-(D.combExp d v - 2 * D.d108 d v)) : (v.adicCompletion K)ˣ) :
          v.adicCompletion K) := by
  rw [s002.entries, D.t0923 d h, D.t0919 d h,
    mul_neg, neg_mul, mul_assoc, inv_mul_cancel₀ (D.t0912 d h), mul_one]

