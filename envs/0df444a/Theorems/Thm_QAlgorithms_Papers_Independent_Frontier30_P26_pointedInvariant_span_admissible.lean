-- title:
--   Remark 2.3: The span of a pointed invariant convex subset is an admissible ideal
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $C\subseteq\mathfrak g$ be closed, convex, pointed and invariant. There is a Lie ideal $\mathfrak g_C$ whose underlying real subspace is $\operatorname{span}_{\mathbb R}C$, such that the inverse image of $C$ spans this ideal and $\mathfrak g_C$ is admissible:
--
--   $$\mathfrak g_C=\operatorname{span}_{\mathbb R}C\trianglelefteq\mathfrak g.$$
--
--   No admissibility of the ambient algebra is assumed. This allows invariant pointed subsets to be studied within their own admissible span.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 4, Remark 2.3: The span of a pointed invariant convex subset is an admissible ideal

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section LieGeometry

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Remark 2.3, PDF p. 4. No ambient admissibility is assumed. -/
theorem pointedInvariant_span_admissible (C : Set G)
    (hc : IsClosed C) (hv : Convex ℝ C) (hp : Pointed C) (hi : Invariant C) :
    ∃ I : LieIdeal ℝ G, I.toSubmodule = Submodule.span ℝ C ∧
      Submodule.span ℝ ((Subtype.val : I → G) ⁻¹' C) = ⊤ ∧ LieAdmissible (G := I) := by sorry

end LieGeometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
