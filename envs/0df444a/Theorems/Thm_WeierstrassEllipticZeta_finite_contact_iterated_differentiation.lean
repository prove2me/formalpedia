-- title:
--   Exact contact orders and quotient lengths after iterated differentiation
-- statement:
--   Fix either elliptic-extension chart, its derivation $D$, a finite set
--   $V$ of points in $\mathbb C^4$, and contact orders $n_v\in\mathbb N$.
--   Write
--
--   $$C_v(r)=\{p:D^j p(v)=0\text{ for all }0\leq j<r\},\qquad
--   I=\bigcap_{v\in V}C_v(n_v).$$
--
--   For any $k\in\mathbb N$, let $K$ be the ideal generated by $I$ and all
--   $k$-th derivatives of elements of $I$:
--
--   $$K=I+(D^kq:q\in I).$$
--
--   Then
--
--   $$K=\bigcap_{v\in V}C_v(\max(n_v-k,0)).$$
--
--   The quotient $\mathbb C[t,x,y,z]/K$ is finite dimensional, with
--
--   $$\dim_{\mathbb C}(\mathbb C[t,x,y,z]/K)
--   =\sum_{v\in V}\max(n_v-k,0).$$
--
--   Moreover, a polynomial $p$ belongs to $K$ exactly when there exists
--   $q\in I$ such that $p-D^kq\in I$. Finally,
--
--   $$K=\mathbb C[t,x,y,z]\quad\Longleftrightarrow\quad
--   n_v\leq k\text{ for every }v\in V.$$
--
--   There is no distinctness requirement on the points' time coordinates.
--   The set $V$ may be empty, and the contact orders and $k$ may be zero.
-- source:
--   Derived calculation for the differential polynomial-ring method associated with Senthil Kumar K (2026), Appendix A introductory paragraphs and Theorem A.2, https://doi.org/10.1017/S001309152610145X. This exact iterated-differentiation statement is proved here, not quoted from the article. Reuses the Proved elliptic_extension_contact_ideal_structure and elliptic_extension_contact_quotient_dimension. Differentiation shifts jets and lowers contact orders. Simultaneous jet interpolation constructs a single k-th primitive modulo the original ideal for every polynomial with the reduced orders, giving the reverse ideal inclusion. The existing contact quotient dimension formula supplies exact lengths and the unit-ideal criterion. No injectivity of the time coordinate on the support or prescribed polynomial degree is assumed.

import Definitions.Def_WeierstrassEllipticZeta_ProjectiveContactIdeal
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.RingTheory.Ideal.Quotient.Basic

open WeierstrassEllipticZeta
open scoped Classical

theorem WeierstrassEllipticZeta.finite_contact_iterated_differentiation (g₂ g₃ : ℂ) (c : Fin 2)
    (V : Finset (Fin 4 → ℂ)) (n : V → ℕ) (k : ℕ) :
    let I : Ideal (MvPolynomial (Fin 4) ℂ) :=
      ⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)
    let K := I ⊔ Ideal.span ((extensionChartDerivation g₂ g₃ c)^[k] ''
      (I : Set (MvPolynomial (Fin 4) ℂ)))
    K = (⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v - k)) ∧
      FiniteDimensional ℂ (MvPolynomial (Fin 4) ℂ ⧸ K) ∧
      Module.finrank ℂ (MvPolynomial (Fin 4) ℂ ⧸ K) = ∑ v : V, (n v - k) ∧
      (∀ p : MvPolynomial (Fin 4) ℂ,
        p ∈ K ↔ ∃ q : MvPolynomial (Fin 4) ℂ, q ∈ I ∧
          p - (extensionChartDerivation g₂ g₃ c)^[k] q ∈ I) ∧
      (K = ⊤ ↔ ∀ v : V, n v ≤ k) := by sorry
