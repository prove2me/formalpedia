namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

/-! ## The exposed rows -/

theorem bnd_gflat {w B : ℕ} {x : List GI} (h : GB w x) (hw : w ≤ B) : Bnd B (gflat x) := by
  intro v hv
  simp only [gflat, List.mem_flatMap, List.mem_cons, List.mem_nil_iff, or_false] at hv
  obtain ⟨z, hz, rfl | rfl⟩ := hv
  · exact le_trans (h z hz).1 hw
  · exact le_trans (h z hz).2 hw

end J6Seg

