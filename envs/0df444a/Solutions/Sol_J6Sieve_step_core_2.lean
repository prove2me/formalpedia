-- Source module: Solutions.J6SieveBonf
/-!
# J6Sieve, part 1: Bonferroni (Brun pure sieve) inequalities

Truncated inclusion–exclusion over subsets of size `≤ m`.
-/

namespace J6Sieve
open Finset

lemma bonf_eq_range (Q : Finset ℕ) (m : ℕ) :
    bonf Q m = ∑ j ∈ range (m + 1), (-1 : ℤ) ^ j * (Q.card.choose j : ℤ) := by
  unfold bonf
  rw [sum_filter, sum_powerset_apply_card (fun j => if j ≤ m then (-1 : ℤ) ^ j else 0)]
  set N := Q.card
  have h1 : ∑ j ∈ range (N + 1), N.choose j • (if j ≤ m then (-1 : ℤ) ^ j else 0)
      = ∑ j ∈ range (N + m + 1), N.choose j • (if j ≤ m then (-1 : ℤ) ^ j else 0) := by
    apply sum_subset
    · intro j hj; simp only [mem_range] at hj ⊢; omega
    · intro j _ hj
      simp only [mem_range, not_lt] at hj
      rw [Nat.choose_eq_zero_of_lt (by omega)]; simp
  have h2 : ∑ j ∈ range (m + 1), (-1 : ℤ) ^ j * (N.choose j : ℤ)
      = ∑ j ∈ range (N + m + 1), N.choose j • (if j ≤ m then (-1 : ℤ) ^ j else 0) := by
    apply sum_subset_zero_on_sdiff
    · intro j hj; simp only [mem_range] at hj ⊢; omega
    · intro j hj
      simp only [mem_sdiff, mem_range] at hj
      rw [if_neg (by omega)]; simp
    · intro j hj
      simp only [mem_range] at hj
      rw [if_pos (by omega), nsmul_eq_mul]; ring
  rw [h1, h2]

lemma bonf_of_nonempty (Q : Finset ℕ) (m : ℕ) (hQ : Q.Nonempty) :
    bonf Q m = (-1 : ℤ) ^ m * ((Q.card - 1).choose m : ℤ) := by
  rw [bonf_eq_range]
  obtain ⟨N, hN⟩ : ∃ N, Q.card = N + 1 := ⟨Q.card - 1, by have := hQ.card_pos; omega⟩
  rw [hN, Nat.add_sub_cancel]
  exact_mod_cast Int.alternating_sum_range_choose_eq_choose

lemma bonf_empty (m : ℕ) : bonf ∅ m = 1 := by
  simp [bonf, filter_singleton]

/-- Lower Bonferroni: for odd `m`, `bonf Q m ≤ [Q = ∅]`. -/
lemma bonf_le_of_odd (Q : Finset ℕ) (m : ℕ) (hm : Odd m) :
    bonf Q m ≤ if Q = ∅ then 1 else 0 := by
  split_ifs with h
  · subst h; rw [bonf_empty]
  · rw [bonf_of_nonempty Q m (nonempty_iff_ne_empty.2 h), hm.neg_one_pow]
    have : (0 : ℤ) ≤ ((Q.card - 1).choose m : ℤ) := by positivity
    linarith

/-- Upper Bonferroni: for even `m`, `[Q = ∅] ≤ bonf Q m`. -/
lemma le_bonf_of_even (Q : Finset ℕ) (m : ℕ) (hm : Even m) :
    (if Q = ∅ then 1 else 0) ≤ bonf Q m := by
  split_ifs with h
  · subst h; rw [bonf_empty]
  · rw [bonf_of_nonempty Q m (nonempty_iff_ne_empty.2 h), hm.neg_one_pow]
    have : (0 : ℤ) ≤ ((Q.card - 1).choose m : ℤ) := by positivity
    linarith

lemma mem_P {z p : ℕ} : p ∈ P z ↔ p ≤ z ∧ p.Prime := by
  simp [P]

lemma rough_iff_Pn (z n : ℕ) : rough z n ↔ Pn z n = ∅ := by
  simp [rough, Pn, filter_eq_empty_iff]

/-- Swapping sums: `∑_{n∈S} bonf (Pn n) m = ∑_{t∈T} (-1)^|t| #{n∈S : ∏ t ∣ n}`. -/
lemma sum_bonf_eq (z m : ℕ) (S : Finset ℕ) :
    ∑ n ∈ S, bonf (Pn z n) m
      = ∑ t ∈ T z m, (-1 : ℤ) ^ t.card * ((S.filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℤ) := by
  have key : ∀ n, bonf (Pn z n) m
      = ∑ t ∈ T z m, if (∏ p ∈ t, p) ∣ n then (-1 : ℤ) ^ t.card else 0 := by
    intro n
    unfold bonf
    rw [← sum_filter]
    apply sum_congr
    · ext t
      simp only [T, Pn, mem_filter, mem_powerset]
      constructor
      · rintro ⟨ht, hc⟩
        refine ⟨⟨fun x hx => (mem_filter.1 (ht hx)).1, hc⟩, ?_⟩
        apply Finset.prod_primes_dvd
        · intro p hp; exact (mem_P.1 (mem_filter.1 (ht hp)).1).2.prime
        · intro p hp; exact (mem_filter.1 (ht hp)).2
      · rintro ⟨⟨ht, hc⟩, hd⟩
        refine ⟨fun x hx => mem_filter.2 ⟨ht hx, ?_⟩, hc⟩
        exact (Finset.dvd_prod_of_mem _ hx).trans hd
    · intro _ _; rfl
  simp_rw [key]
  rw [sum_comm]
  apply sum_congr rfl
  intro t _
  rw [← sum_filter, sum_const, nsmul_eq_mul, mul_comm]

/-- Lower sieve identity (count form). -/
lemma card_rough_ge (z m : ℕ) (hm : Odd m) (S : Finset ℕ) :
    ∑ t ∈ T z m, (-1 : ℤ) ^ t.card * ((S.filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℤ)
      ≤ ((S.filter (rough z)).card : ℤ) := by
  rw [← sum_bonf_eq, card_filter]
  push_cast
  apply sum_le_sum
  intro n _
  have := bonf_le_of_odd (Pn z n) m hm
  by_cases h : rough z n
  · rw [if_pos h]; rw [if_pos ((rough_iff_Pn z n).1 h)] at this; exact this
  · rw [if_neg h]; rw [if_neg (fun e => h ((rough_iff_Pn z n).2 e))] at this; exact this

/-- Upper sieve identity (count form). -/
lemma card_rough_le (z m : ℕ) (hm : Even m) (S : Finset ℕ) :
    ((S.filter (rough z)).card : ℤ) ≤
      ∑ t ∈ T z m, (-1 : ℤ) ^ t.card * ((S.filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℤ) := by
  rw [← sum_bonf_eq, card_filter]
  push_cast
  apply sum_le_sum
  intro n _
  have := le_bonf_of_even (Pn z n) m hm
  by_cases h : rough z n
  · rw [if_pos h]; rw [if_pos ((rough_iff_Pn z n).1 h)] at this; exact this
  · rw [if_neg h]; rw [if_neg (fun e => h ((rough_iff_Pn z n).2 e))] at this; exact this

end J6Sieve

end

section
-- Source module: Solutions.J6SieveEst
/-!
# J6Sieve, part 2: real-valued sieve bounds

* counting multiples in an interval,
* the sieve inequalities with main term `W z m`,
* Rankin's trick `|W z m - V z| ≤ 2^{-(m+1)} ∏ (1 + 2/p)`,
* `V z ≥ 1/z`, `∏ (1+2/p) ≤ (z+1)(z+2)/2`, `#T z m ≤ (m+1) z^m`.
-/

namespace J6Sieve
open Finset

lemma P_succ (z : ℕ) :
    P (z + 1) = if (z + 1).Prime then insert (z + 1) (P z) else P z := by
  unfold P
  rw [range_add_one, filter_insert]

lemma P_zero : P 0 = ∅ := by decide

lemma P_one : P 1 = ∅ := by decide

lemma not_mem_P_self (z : ℕ) : z + 1 ∉ P z := by
  simp [mem_P]

lemma P_pos {z p : ℕ} (hp : p ∈ P z) : 0 < p := (mem_P.1 hp).2.pos

/-- Floor bounds for `x / e`. -/
lemma nat_div_bounds (x e : ℕ) (he : 0 < e) :
    (x : ℝ) / e - 1 ≤ ((x / e : ℕ) : ℝ) ∧ ((x / e : ℕ) : ℝ) ≤ (x : ℝ) / e := by
  refine ⟨?_, Nat.cast_div_le⟩
  have h1 := Nat.div_add_mod x e
  have h2 := Nat.mod_lt x he
  have he' : (0 : ℝ) < e := by exact_mod_cast he
  rw [sub_le_iff_le_add, div_le_iff₀ he']
  have : (x : ℝ) = e * ((x / e : ℕ) : ℝ) + ((x % e : ℕ) : ℝ) := by exact_mod_cast h1.symm
  have h3 : ((x % e : ℕ) : ℝ) ≤ e := by exact_mod_cast h2.le
  nlinarith

lemma card_Ioc_dvd (A h e : ℕ) (_he : 0 < e) :
    ((Ioc A (A + h)).filter (e ∣ ·)).card = (A + h) / e - A / e := by
  have hsplit : (Ioc 0 (A + h)).filter (e ∣ ·)
      = (Ioc 0 A).filter (e ∣ ·) ∪ (Ioc A (A + h)).filter (e ∣ ·) := by
    rw [← filter_union, Ioc_union_Ioc_eq_Ioc (Nat.zero_le _) (Nat.le_add_right _ _)]
  have hdisj : Disjoint ((Ioc 0 A).filter (e ∣ ·)) ((Ioc A (A + h)).filter (e ∣ ·)) := by
    apply disjoint_filter_filter
    rw [disjoint_left]; intro a ha hb; simp only [mem_Ioc] at ha hb; omega
  have := card_union_of_disjoint hdisj
  rw [← hsplit, Nat.Ioc_filter_dvd_card_eq_div, Nat.Ioc_filter_dvd_card_eq_div] at this
  omega

lemma card_Ioc_dvd_bound (A h e : ℕ) (he : 0 < e) :
    |(((Ioc A (A + h)).filter (e ∣ ·)).card : ℝ) - (h : ℝ) / e| ≤ 1 := by
  rw [card_Ioc_dvd A h e he]
  have hle : A / e ≤ (A + h) / e := Nat.div_le_div_right (by omega)
  rw [Nat.cast_sub hle]
  obtain ⟨a1, a2⟩ := nat_div_bounds A e he
  obtain ⟨b1, b2⟩ := nat_div_bounds (A + h) e he
  have : ((A + h : ℕ) : ℝ) / e = (A : ℝ) / e + (h : ℝ) / e := by push_cast; ring
  rw [abs_le]; constructor <;> linarith

/-- With `D` coprime to all primes `≤ z`, the inner counts are counts of multiples of
`D * ∏ t`. -/
lemma filter_filter_eq (z m D A h : ℕ) (hD : ∀ p ∈ P z, ¬ p ∣ D) (t : Finset ℕ)
    (ht : t ∈ T z m) :
    (((Ioc A (A + h)).filter (D ∣ ·)).filter (fun n => (∏ p ∈ t, p) ∣ n))
      = (Ioc A (A + h)).filter ((D * ∏ p ∈ t, p) ∣ ·) := by
  have htP : t ⊆ P z := mem_powerset.1 (mem_filter.1 ht).1
  have hcop : Nat.Coprime D (∏ p ∈ t, p) := by
    apply Nat.Coprime.prod_right
    intro p hp
    exact (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd (mem_P.1 (htP hp)).2).2
      (hD p (htP hp))))
  ext n
  simp only [mem_filter]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨h1, hcop.mul_dvd_of_dvd_of_dvd h2 h3⟩
  · rintro ⟨h1, h2⟩
    exact ⟨⟨h1, (Dvd.intro _ rfl).trans h2⟩, (Dvd.intro_left _ rfl).trans h2⟩

lemma prod_pos_T {z m : ℕ} {t : Finset ℕ} (ht : t ∈ T z m) : 0 < ∏ p ∈ t, p := by
  have htP : t ⊆ P z := mem_powerset.1 (mem_filter.1 ht).1
  exact prod_pos fun p hp => P_pos (htP hp)

lemma term_bound (z m D A h : ℕ) (hD0 : 0 < D) (hD : ∀ p ∈ P z, ¬ p ∣ D) (t : Finset ℕ)
    (ht : t ∈ T z m) :
    |(((((Ioc A (A + h)).filter (D ∣ ·)).filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℝ))
      - ((h : ℝ) / D) * ∏ p ∈ t, ((p : ℝ))⁻¹| ≤ 1 := by
  rw [filter_filter_eq z m D A h hD t ht]
  have := card_Ioc_dvd_bound A h (D * ∏ p ∈ t, p) (Nat.mul_pos hD0 (prod_pos_T ht))
  convert this using 3
  push_cast
  rw [prod_inv_distrib]; field_simp

lemma neg_one_pow_term (k : ℕ) (c x : ℝ) (h : |c - x| ≤ 1) :
    (-1 : ℝ) ^ k * x - 1 ≤ (-1 : ℝ) ^ k * c ∧ (-1 : ℝ) ^ k * c ≤ (-1 : ℝ) ^ k * x + 1 := by
  rw [abs_le] at h
  rcases neg_one_pow_eq_or ℝ k with e | e <;> rw [e] <;> constructor <;> linarith [h.1, h.2]

/-- Lower sieve bound (`m` odd). -/
theorem sieve_lower (z m D A h : ℕ) (hm : Odd m) (hD0 : 0 < D) (hD : ∀ p ∈ P z, ¬ p ∣ D) :
    ((h : ℝ) / D) * W z m - (T z m).card
      ≤ ((((Ioc A (A + h)).filter (D ∣ ·)).filter (rough z)).card : ℝ) := by
  have hZ := card_rough_ge z m hm ((Ioc A (A + h)).filter (D ∣ ·))
  have hR : (∑ t ∈ T z m, (-1 : ℝ) ^ t.card *
      (((((Ioc A (A + h)).filter (D ∣ ·)).filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℝ)))
      ≤ ((((Ioc A (A + h)).filter (D ∣ ·)).filter (rough z)).card : ℝ) := by
    exact_mod_cast hZ
  refine le_trans ?_ hR
  rw [W, mul_sum, card_eq_sum_ones, Nat.cast_sum, ← sum_sub_distrib]
  apply sum_le_sum
  intro t ht
  have := (neg_one_pow_term t.card _ _ (term_bound z m D A h hD0 hD t ht)).1
  push_cast
  linarith

/-- Upper sieve bound (`m` even). -/
theorem sieve_upper (z m D A h : ℕ) (hm : Even m) (hD0 : 0 < D) (hD : ∀ p ∈ P z, ¬ p ∣ D) :
    ((((Ioc A (A + h)).filter (D ∣ ·)).filter (rough z)).card : ℝ)
      ≤ ((h : ℝ) / D) * W z m + (T z m).card := by
  have hZ := card_rough_le z m hm ((Ioc A (A + h)).filter (D ∣ ·))
  have hR : ((((Ioc A (A + h)).filter (D ∣ ·)).filter (rough z)).card : ℝ) ≤
      (∑ t ∈ T z m, (-1 : ℝ) ^ t.card *
      (((((Ioc A (A + h)).filter (D ∣ ·)).filter (fun n => (∏ p ∈ t, p) ∣ n)).card : ℝ))) := by
    exact_mod_cast hZ
  refine le_trans hR ?_
  rw [W, mul_sum, card_eq_sum_ones, Nat.cast_sum, ← sum_add_distrib]
  apply sum_le_sum
  intro t ht
  have := (neg_one_pow_term t.card _ _ (term_bound z m D A h hD0 hD t ht)).2
  push_cast
  linarith

/-- Rankin's trick. -/
theorem W_sub_V (z m : ℕ) :
    |W z m - V z| ≤ ((2 : ℝ) ^ (m + 1))⁻¹ * ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹) := by
  have hV : V z = ∑ t ∈ (P z).powerset, (-1 : ℝ) ^ t.card * ∏ p ∈ t, ((p : ℝ))⁻¹ := by
    rw [V]
    simp_rw [sub_eq_add_neg]
    rw [prod_one_add]
    apply sum_congr rfl; intro t _
    rw [prod_neg]
  have hR : ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹)
      = ∑ t ∈ (P z).powerset, (2 : ℝ) ^ t.card * ∏ p ∈ t, ((p : ℝ))⁻¹ := by
    rw [prod_one_add]
    apply sum_congr rfl; intro t _
    rw [prod_mul_distrib, prod_const]
  have hsplit := sum_filter_add_sum_filter_not (P z).powerset (fun t : Finset ℕ => t.card ≤ m)
    (fun t => (-1 : ℝ) ^ t.card * ∏ p ∈ t, ((p : ℝ))⁻¹)
  rw [hV, ← hsplit, W, T]
  rw [show ∀ a b : ℝ, a - (a + b) = -b from fun a b => by ring, abs_neg, hR, mul_sum]
  refine (abs_sum_le_sum_abs _ _).trans ?_
  refine le_trans ?_ (sum_le_sum_of_subset_of_nonneg
    (filter_subset (fun t : Finset ℕ => ¬ t.card ≤ m) (P z).powerset) ?_)
  · apply sum_le_sum
    intro t ht
    simp only [mem_filter, not_le] at ht
    have hg : 0 ≤ ∏ p ∈ t, ((p : ℝ))⁻¹ := prod_nonneg fun p _ => by positivity
    rw [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul, abs_of_nonneg hg]
    have h2 : (2 : ℝ) ^ (m + 1) ≤ 2 ^ t.card := pow_le_pow_right₀ (by norm_num) ht.2
    rw [← mul_assoc]
    have : 1 ≤ ((2 : ℝ) ^ (m + 1))⁻¹ * 2 ^ t.card := by
      rw [inv_mul_eq_div, le_div_iff₀ (by positivity)]; linarith
    nlinarith
  · intro t _ _; positivity

lemma V_ge (z : ℕ) (hz : 1 ≤ z) : 1 / (z : ℝ) ≤ V z := by
  induction z, hz using Nat.le_induction with
  | base => rw [V, P_one]; simp
  | succ z hz ih =>
    rw [V, P_succ]
    split_ifs with hp
    · rw [prod_insert (not_mem_P_self z), ← V]
      have hz' : (0 : ℝ) < z := by exact_mod_cast hz
      have h1 : (1 : ℝ) - ((z + 1 : ℕ) : ℝ)⁻¹ = z / (z + 1) := by
        push_cast; field_simp; ring
      rw [h1]
      calc 1 / ((z + 1 : ℕ) : ℝ) = (z / (z + 1)) * (1 / z) := by
              push_cast; field_simp
        _ ≤ (z / (z + 1)) * V z := by gcongr
    · rw [← V]
      refine le_trans ?_ ih
      gcongr; linarith

lemma prod_two_le (z : ℕ) :
    ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹) ≤ ((z : ℝ) + 1) * (z + 2) / 2 := by
  induction z with
  | zero => rw [P_zero]; norm_num
  | succ z ih =>
    rw [P_succ]
    split_ifs with hp
    · rw [prod_insert (not_mem_P_self z)]
      have h1 : (1 : ℝ) + 2 * ((z + 1 : ℕ) : ℝ)⁻¹ = (z + 3) / (z + 1) := by
        push_cast; field_simp; ring
      rw [h1]
      calc (z + 3) / (z + 1) * ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹)
          ≤ ((z : ℝ) + 3) / (z + 1) * (((z : ℝ) + 1) * (z + 2) / 2) := by
            gcongr
        _ = (((z + 1 : ℕ) : ℝ) + 1) * ((z + 1 : ℕ) + 2) / 2 := by
            push_cast; field_simp; ring
    · refine ih.trans ?_
      push_cast
      have : (0 : ℝ) ≤ z := by positivity
      nlinarith

lemma card_P_le (z : ℕ) : (P z).card ≤ z := by
  have : P z ⊆ (range (z + 1)).erase 0 := by
    intro p hp
    exact mem_erase.2 ⟨(P_pos hp).ne', (mem_filter.1 hp).1⟩
  have := card_le_card this
  rw [card_erase_of_mem (by simp), card_range] at this
  omega

lemma card_T_le (z m : ℕ) (hz : 1 ≤ z) : (T z m).card ≤ (m + 1) * z ^ m := by
  have hsub : T z m ⊆ (range (m + 1)).biUnion (fun j => powersetCard j (P z)) := by
    intro t ht
    simp only [T, mem_filter, mem_powerset] at ht
    simp only [mem_biUnion, mem_range, mem_powersetCard]
    exact ⟨t.card, by omega, ht.1, rfl⟩
  refine (card_le_card hsub).trans (card_biUnion_le.trans ?_)
  simp only [card_powersetCard]
  calc ∑ j ∈ range (m + 1), (P z).card.choose j ≤ ∑ _j ∈ range (m + 1), z ^ m := by
        apply sum_le_sum; intro j hj
        simp only [mem_range] at hj
        calc (P z).card.choose j ≤ (P z).card ^ j := Nat.choose_le_pow _ _
          _ ≤ z ^ j := Nat.pow_le_pow_left (card_P_le z) _
          _ ≤ z ^ m := Nat.pow_le_pow_right hz (by omega)
    _ = (m + 1) * z ^ m := by simp

end J6Sieve

end

section
-- Source module: Solutions.J6SieveStep
/-!
# J6Sieve, part 3: one greedy step

If `Q` is a set of at most `Ω + 1` primes, all `> z = 4(Ω+1)`, and `H` exceeds the
explicit bound, then every interval `(A, A+H]` contains a `z`-rough integer
divisible by no element of `Q`.
-/

namespace J6Sieve
open Finset

/-- Rankin error bound at level `m = 4k+3` with `z < 2^k`. -/
lemma rankin_small (z k : ℕ) (hz : 1 ≤ z) (hk : z < 2 ^ k) :
    ((2 : ℝ) ^ (4 * k + 3 + 1))⁻¹ * (((z : ℝ) + 1) * (z + 2) / 2) ≤ 1 / (5 * z) := by
  have hN : 5 * z * ((z + 1) * (z + 2)) ≤ 2 * 2 ^ (4 * k + 3 + 1) := by
    have h1 : z + 1 ≤ 2 ^ k := hk
    have h2 : z + 2 ≤ 2 * 2 ^ k := by
      have : 1 ≤ 2 ^ k := Nat.one_le_two_pow; omega
    have h3 : 5 * z ≤ 8 * 2 ^ k := by omega
    have h4 : 2 * 2 ^ (4 * k + 3 + 1) = 32 * (2 ^ k) ^ 4 := by ring
    have h5 : 1 ≤ 2 ^ k := Nat.one_le_two_pow
    rw [h4]
    calc 5 * z * ((z + 1) * (z + 2)) ≤ (8 * 2 ^ k) * (2 ^ k * (2 * 2 ^ k)) := by
          gcongr
      _ = 16 * (2 ^ k) ^ 3 := by ring
      _ ≤ 32 * (2 ^ k) ^ 4 := by
          have : (2 ^ k) ^ 3 ≤ (2 ^ k) ^ 4 := Nat.pow_le_pow_right h5 (by norm_num)
          omega
  have hR : (5 * z * ((z + 1) * (z + 2)) : ℝ) ≤ 2 * 2 ^ (4 * k + 3 + 1) := by exact_mod_cast hN
  have hz' : (0 : ℝ) < z := by exact_mod_cast hz
  rw [inv_mul_eq_div, div_div, div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith

/-- The real-arithmetic core of the greedy step. -/
lemma arith_core (H z Ω u V Wm Wm1 Ta Tb E : ℝ) (hu : u * z = 1) (hzΩ : z = 4 * (Ω + 1))
    (hΩ : 0 ≤ Ω) (hH : 0 ≤ H) (hV : u ≤ V) (hWm : V - u / 5 ≤ Wm) (hWm1 : Wm1 ≤ V + u / 5)
    (hTa : Ta ≤ E) (hTb : Tb ≤ E) (_hE : 0 ≤ E) (hHb : 2 * z * (Ω + 2) * E < H) :
    (Ω + 1) * (H * u * Wm1 + Tb) < H * Wm - Ta := by
  have hq : (Ω + 1) * u = 1 / 4 := by
    have : u * (4 * (Ω + 1)) = 1 := hzΩ ▸ hu
    linarith
  have hu0 : 0 < u := by
    have hz : 0 < z := by rw [hzΩ]; linarith
    by_contra h; push Not at h; nlinarith
  have e1 : (Ω + 1) * (H * u * Wm1) = H / 4 * Wm1 := by
    rw [show (Ω + 1) * (H * u * Wm1) = ((Ω + 1) * u) * (H * Wm1) by ring, hq]; ring
  have a1 : H * (V - u / 5) ≤ H * Wm := mul_le_mul_of_nonneg_left hWm hH
  have a2 : H / 4 * Wm1 ≤ H / 4 * (V + u / 5) :=
    mul_le_mul_of_nonneg_left hWm1 (by positivity)
  have a3 : H * u ≤ H * V := mul_le_mul_of_nonneg_left hV hH
  have a4 : (Ω + 2) * E * 2 < H * u := by
    have := mul_lt_mul_of_pos_right hHb hu0
    have e : 2 * z * (Ω + 2) * E * u = (Ω + 2) * E * 2 * (u * z) := by ring
    rw [e, hu] at this; linarith
  have a5 : (Ω + 1) * Tb ≤ (Ω + 1) * E := mul_le_mul_of_nonneg_left hTb (by linarith)
  nlinarith

/-- The greedy step, with abstract parameters. -/
theorem step_core_sol_aux (z Ω k m H A : ℕ) (Q : Finset ℕ) (hzΩn : z = 4 * (Ω + 1))
    (hk : z < 2 ^ k) (hmk : m = 4 * k + 3) (hQp : ∀ q ∈ Q, q.Prime)
    (hQz : ∀ q ∈ Q, q ∉ P z) (hQc : Q.card ≤ Ω + 1)
    (hH : 2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1) < H) :
    ∃ n, A < n ∧ n ≤ A + H ∧ rough z n ∧ ∀ q ∈ Q, ¬ q ∣ n := by
  have hz4 : 4 ≤ z := by omega
  have hz1 : 1 ≤ z := by omega
  have hzr : (0 : ℝ) < z := by exact_mod_cast (show 0 < z by omega)
  have hzΩ : (z : ℝ) = 4 * ((Ω : ℝ) + 1) := by rw [hzΩn]; push_cast; ring
  have hmodd : Odd m := ⟨2 * k + 1, by omega⟩
  have hmeven : Even (m + 1) := by rcases hmodd with ⟨j, hj⟩; exact ⟨j + 1, by omega⟩
  -- error terms
  have hV := V_ge z hz1
  have hR0 := rankin_small z k hz1 hk
  have hprod := prod_two_le z
  have hpos2 : (0 : ℝ) ≤ ((2 : ℝ) ^ (m + 1))⁻¹ := by positivity
  have hW1 := W_sub_V z m
  have hW2 := W_sub_V z (m + 1)
  have hRm : ((2 : ℝ) ^ (m + 1))⁻¹ * ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹) ≤ 1 / (5 * z) :=
    le_trans (mul_le_mul_of_nonneg_left hprod hpos2) (by rw [hmk]; exact hR0)
  have hRm1 : ((2 : ℝ) ^ (m + 1 + 1))⁻¹ * ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹)
      ≤ ((2 : ℝ) ^ (m + 1))⁻¹ * ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹) := by
    have h0 : 0 ≤ ∏ p ∈ P z, (1 + 2 * ((p : ℝ))⁻¹) :=
      prod_nonneg fun p _ => by positivity
    apply mul_le_mul_of_nonneg_right _ h0
    apply inv_anti₀ (by positivity)
    exact pow_le_pow_right₀ (by norm_num) (by omega)
  have hWlo : 1 / (z : ℝ) - 1 / (5 * z) ≤ W z m := by
    have := (abs_le.1 hW1).1; linarith
  have hWhi : W z (m + 1) ≤ V z + 1 / (5 * z) := by
    have := (abs_le.1 hW2).2; linarith
  have hWnn : 0 ≤ W z (m + 1) := by
    have := (abs_le.1 hW2).1
    have h5 : 1 / (5 * (z : ℝ)) ≤ 1 / z := by
      apply one_div_le_one_div_of_le hzr; linarith
    linarith
  -- counts
  set I := Ioc A (A + H)
  have hD1 : ∀ p ∈ P z, ¬ p ∣ 1 := fun p hp h => (mem_P.1 hp).2.one_lt.ne' (Nat.dvd_one.1 h)
  have hlow := sieve_lower z m 1 A H hmodd one_pos hD1
  have hbad : ∀ q ∈ Q, (((I.filter (q ∣ ·)).filter (rough z)).card : ℝ)
      ≤ ((H : ℝ) / z) * W z (m + 1) + (T z (m + 1)).card := by
    intro q hq
    have hqp := hQp q hq
    have hqD : ∀ p ∈ P z, ¬ p ∣ q := by
      intro p hp hpq
      have := (Nat.prime_dvd_prime_iff_eq (mem_P.1 hp).2 hqp).1 hpq
      exact hQz q hq (this ▸ hp)
    have hqz : z < q := by
      by_contra hc
      exact hQz q hq (mem_P.2 ⟨by omega, hqp⟩)
    have hu := sieve_upper z (m + 1) q A H hmeven hqp.pos hqD
    refine hu.trans ?_
    have hqz' : (z : ℝ) ≤ q := by exact_mod_cast hqz.le
    have hH0 : (0 : ℝ) ≤ H := by positivity
    have := div_le_div_of_nonneg_left hH0 hzr hqz'
    linarith [mul_le_mul_of_nonneg_right this hWnn]
  -- combinatorics
  by_contra hcon
  push Not at hcon
  have hsub : (I.filter (1 ∣ ·)).filter (rough z) ⊆
      Q.biUnion (fun q => (I.filter (q ∣ ·)).filter (rough z)) := by
    intro n hn
    simp only [I, mem_filter, mem_Ioc] at hn
    obtain ⟨q, hq, hqn⟩ := hcon n hn.1.1.1 hn.1.1.2 hn.2
    simp only [mem_biUnion, mem_filter, I, mem_Ioc]
    exact ⟨q, hq, ⟨⟨hn.1.1.1, hn.1.1.2⟩, hqn⟩, hn.2⟩
  have hcard := (card_le_card hsub).trans card_biUnion_le
  have hcardR : (((I.filter (1 ∣ ·)).filter (rough z)).card : ℝ)
      ≤ ∑ q ∈ Q, (((I.filter (q ∣ ·)).filter (rough z)).card : ℝ) := by
    exact_mod_cast hcard
  have hsum := sum_le_sum hbad
  rw [sum_const, nsmul_eq_mul] at hsum
  have hQcR : (Q.card : ℝ) ≤ Ω + 1 := by exact_mod_cast hQc
  have hT1 : ((T z m).card : ℝ) ≤ (m + 2) * (z : ℝ) ^ (m + 1) := by
    have h := card_T_le z m hz1
    have h' : (m + 1) * z ^ m ≤ (m + 2) * z ^ (m + 1) :=
      Nat.mul_le_mul (by omega) (Nat.pow_le_pow_right hz1 (by omega))
    exact_mod_cast h.trans h'
  have hT2 : ((T z (m + 1)).card : ℝ) ≤ (m + 2) * (z : ℝ) ^ (m + 1) := by
    exact_mod_cast card_T_le z (m + 1) hz1
  have hHR : ((2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1) : ℕ) : ℝ) < H := by exact_mod_cast hH
  have hSB : ((2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1) : ℕ) : ℝ)
      = 2 * z * (Ω + 2) * ((m + 2) * (z : ℝ) ^ (m + 1)) := by
    push_cast; ring
  have hE0 : 0 ≤ (m + 2) * (z : ℝ) ^ (m + 1) := by positivity
  have hHnn : (0 : ℝ) ≤ H := by positivity
  have hu : (1 / (z : ℝ)) * z = 1 := by field_simp
  have hΩ0 : (0 : ℝ) ≤ Ω := by positivity
  have hWlo' : V z - 1 / (z : ℝ) / 5 ≤ (W z m) := by
    have := (abs_le.1 hW1).1
    have e : 1 / (z : ℝ) / 5 = 1 / (5 * z) := by field_simp
    rw [e]; linarith
  have hWhi' : (W z (m + 1)) ≤ V z + 1 / (z : ℝ) / 5 := by
    have e : 1 / (z : ℝ) / 5 = 1 / (5 * z) := by field_simp
    rw [e]; exact hWhi
  have hHb : 2 * (z : ℝ) * (Ω + 2) * ((m + 2) * (z : ℝ) ^ (m + 1)) < H := by rw [← hSB]; exact hHR
  have core := arith_core H z Ω (1 / z) (V z) (W z m) (W z (m + 1)) _ _ ((m + 2) * (z : ℝ) ^ (m + 1)) hu hzΩ hΩ0 hHnn hV hWlo' hWhi'
    hT1 hT2 hE0 hHb
  have hbadsum : ∑ q ∈ Q, (((I.filter (q ∣ ·)).filter (rough z)).card : ℝ)
      ≤ (Ω + 1) * ((H : ℝ) * (1 / z) * (W z (m + 1)) + (T z (m + 1)).card) := by
    refine hsum.trans ?_
    have h0 : 0 ≤ ((H : ℝ) / z) * (W z (m + 1)) + (T z (m + 1)).card := by positivity
    rw [show (H : ℝ) * (1 / z) = H / z by ring]
    exact mul_le_mul_of_nonneg_right hQcR h0
  have hlow' : (H : ℝ) * (W z m) - (T z m).card
      ≤ (((I.filter (1 ∣ ·)).filter (rough z)).card : ℝ) := by
    simpa using hlow
  linarith

end J6Sieve

end

theorem solution : type_of% @J6Sieve.step_core_sol_aux := @J6Sieve.step_core_sol_aux
