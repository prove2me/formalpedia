-- Source module: Solutions.SynthKron
/-!
# §7 Lemma 17: signed packing, centered extraction, negacyclic fold, truncation

All the arithmetic content of Lemma 17, stated over `ℤ` (and over a coefficient model for the
ring-level identification).

* **Packing** (`gam`, `dig`): with carry `γ₀ = 0`, `d_j = (u_j + γ_j) mod B`,
  `γ_{j+1} = (u_j + γ_j - d_j)/B`; `pack_digit`, `pack_carry` (`γ_j ∈ {-1,0}` when `|u_j| < B`),
  `pack_telescope` (`∑ u_j B^j = ∑ d_j B^j + γ_r B^r`), `pack_sign` (`γ_r = -1 ↔ A_u < 0`).
* `pack_bound`: `|u_j| ≤ c`, `2c < B` give `2|A_u| < B^r`.
* `cnv` (ordinary product coefficients), `eval_mul_cnv` (`A_a A_c = ∑_{j<2r} h_j B^j`),
  `abs_cnv_le` and `coeff_bound31` (`|h_j| ≤ r 2^{2p} < 2^{3p}`, `2·2^{3p} < B₀ = 2^{4p}`).
* `twos_complement_exists`: a fixed-width signed block representation `Z = ∑ q_j B^j + ε B^J`.
* **Extraction** (`cent`, `rho`): `extract` proves the residual identity, `ρ_j ∈ {0,1}`, exact
  recovery `ĥ_j = h_j`, and `ρ_J + ε = 0`; `kron_recover` is the instance of Lemma 17.
* **Negacyclic fold**: `fold_formula`, `co_mul` and `co_mul_gauss` (the Gaussian numerators of
  `f g` are `(ac - be) + i(ae + bc)` folded modulo `y^r + 1`).
* **Truncation**: `truncNum_div` (`trunc₀(H / 2^{p+ℓ})` is `H.tdiv 2^{p+ℓ}`), `Qp_normalized`.
* **Scaling by appending zeros**: `append_zeros`.
-/

set_option linter.unusedSectionVars false

namespace Synth

open Finset Butterfly

/-! ## 1. Signed packing -/

/-! ## 2. Ordinary product coefficients -/

lemma inner_eq {M : Type*} [AddCommMonoid M] (r i j : ℕ) (f : ℕ → M) :
    ∑ k ∈ range r, (if i + k = j then f k else 0) = if i ≤ j ∧ j - i < r then f (j - i) else 0 := by
  split_ifs with h
  · rw [sum_eq_single (j - i)]
    · rw [if_pos (by omega)]
    · intro k _ hk; rw [if_neg (by omega)]
    · intro hk; exact absurd (mem_range.2 h.2) hk
  · exact sum_eq_zero fun k hk => by rw [if_neg (by have := mem_range.1 hk; omega)]

theorem eval_mul_cnv (B : ℤ) (r : ℕ) (a c : ℕ → ℤ) :
    (∑ i ∈ range r, a i * B ^ i) * (∑ k ∈ range r, c k * B ^ k) =
      ∑ j ∈ range (2 * r), cnv r a c j * B ^ j := by
  rw [sum_mul_sum]
  symm
  unfold cnv
  simp_rw [sum_mul, ite_mul, zero_mul]
  rw [sum_comm]
  refine sum_congr rfl fun i hi => ?_
  rw [sum_comm]
  refine sum_congr rfl fun k hk => ?_
  rw [sum_ite_eq, if_pos (mem_range.2 (by have := mem_range.1 hi; have := mem_range.1 hk; omega)),
    pow_add]
  ring

theorem abs_cnv_le {r : ℕ} {a c : ℕ → ℤ} {c1 c2 : ℤ} (ha : ∀ i, |a i| ≤ c1) (hc : ∀ k, |c k| ≤ c2)
    (j : ℕ) : |cnv r a c j| ≤ r * (c1 * c2) := by
  unfold cnv
  rw [sum_congr rfl fun i _ => inner_eq r i j (fun k => a i * c k)]
  have hc1 : 0 ≤ c1 := le_trans (abs_nonneg _) (ha 0)
  refine (abs_sum_le_sum_abs _ _).trans ?_
  calc ∑ i ∈ range r, |if i ≤ j ∧ j - i < r then a i * c (j - i) else 0|
      ≤ ∑ _i ∈ range r, c1 * c2 := sum_le_sum fun i _ => by
        split_ifs
        · rw [abs_mul]; exact mul_le_mul (ha i) (hc _) (abs_nonneg _) hc1
        · simp only [abs_zero]; exact mul_nonneg hc1 (le_trans (abs_nonneg _) (hc 0))
    _ = r * (c1 * c2) := by simp

