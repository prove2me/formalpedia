section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12 Finset
theorem solution {m W S : ℕ} (Kc Kd q : ℕ) (hm : 2 ≤ m) (hW : 1 ≤ W) (hq : 2 ≤ q) {τ : ℝ}
    (hτ : 0 < τ ∧ τ < 1) (hs : (S : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (u : ℕ) (Pre G Suf : AModel.Shape) (Bb e Kp : ℕ), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      e = Nat.clog q (2 ^ u) → Kp = Nat.clog m e →
      (NLogN.KIL.cL12 u e (min (W * Kp) e) Kp (e - min (W * Kp) e) (AModel.vol (AModelL12.qShape Pre G Suf q e))
        (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
          (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e))) m q
        (fun j => NLogN.KIL.ilCostU5 W Kc Kd S q Bb j
          (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
            (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e)))) Bb : ℝ) ≤
        K * ((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * ((Bb : ℝ) + 2) ^ 2 * (u : ℝ) ^ τ := by
  obtain ⟨K₀, hK₀, hK₀b⟩ := NLogN.KIL.ilCostU5_le (S := S) Kc Kd q hm hW hτ hs
  obtain ⟨K', hK', hK'b⟩ := AModel.arbitrary_width_sum m τ hm hτ.1
  obtain ⟨Ck, hCk, hCkb⟩ := AModelL12.clog_le_rpow hm hτ.1
  refine ⟨(NLogN.KIL.Nc q m W : ℝ) * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K', by positivity, ?_⟩
  intro u Pre G Suf Bb e Kp hu hPre hG hS he hKp
  set r := min (W * Kp) e with hr
  set n := e - r with hn
  set Vb := AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) with hVb
  set Vq := AModel.vol (AModelL12.qShape Pre G Suf q e) with hVq
  set R' := AModelL12.padRows W Kp (q ^ r) with hR'
  set V' := AModel.vol (AModelL12.rowShape (AModel.vol Pre) R' (G ++ List.replicate r q) Suf q n) with hV'
  set cO := fun j => NLogN.KIL.ilCostU5 W Kc Kd S q Bb j V' with hcO
  have he1 : 1 ≤ e := by rw [he]; exact NLogN.KIL.one_le_e hq hu
  have heu : e ≤ u := by rw [he]; exact NLogN.KIL.e_le_u hq
  have huV : u ≤ Vb := NLogN.KIL.u_le_vb Pre G Suf hPre hG hS
  have hVqb : Vq ≤ q ^ 2 * Vb := by rw [hVq, he]; exact NLogN.KIL.vq_le_vb hq hu Pre G Suf
  have hKe : e ≤ m ^ Kp := by rw [hKp]; exact Nat.le_pow_clog (by omega) e
  have hV'2 : n ≠ 0 → V' ≤ 2 * Vq := fun hn0 => by
    have hrW : r = W * Kp := by rw [hr]; apply min_eq_left; omega
    have h := NLogN.KIL.rowVol_le (n := n) hq hW Pre G Suf (show W ^ Kp ≤ q ^ r by
      rw [hrW]; exact NLogN.KIL.pow_le_q_pow hq)
    rwa [show r + n = e by omega] at h
  -- the linear part
  have hlin := NLogN.KIL.cL12_lin (q := q) (m := m) (W := W) (u := u) (e := e) (Kp := Kp) (r := r) (n := n)
    (Vb := Vb) (Vq := Vq) (V' := V') cO Bb hm hq heu huV hVqb (min_le_left _ _) (by omega) hV'2
  -- the oracle part
  have hWV : n ≠ 0 → ∀ j < (Nat.digits m n).length, W ^ j ≤ V' := by
    intro hn0 j hj
    have h1 := NLogN.KIL.pow_le_of_lt_len hm (by omega) hj
    have hjK : j ≤ Kp := (Nat.pow_le_pow_iff_right (by omega)).1
      (le_trans h1 (le_trans (by omega : n ≤ e) hKe))
    have hR1 : W ^ Kp ≤ R' := by
      rw [hR', AModelL12.padRows]
      have hpos : 0 < W ^ Kp := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
      have : 1 ≤ (q ^ r + W ^ Kp - 1) / W ^ Kp := by
        rw [Nat.le_div_iff_mul_le hpos]
        have := Nat.one_le_pow r q (by omega)
        omega
      calc W ^ Kp = W ^ Kp * 1 := (mul_one _).symm
        _ ≤ _ := Nat.mul_le_mul_left _ this
    have hRV : R' ≤ V' := by
      rw [hV', AModelL12.vol_rowShape]
      have h1 := NLogN.KIL.one_le_vol hPre
      have h2 : 1 ≤ AModel.vol (AModelL12.restShape (G ++ List.replicate r q) Suf q n) := by
        rw [NLogN.KIL.vol_restShape']
        have := NLogN.KIL.one_le_vol hG; have := NLogN.KIL.one_le_vol hS
        have h3 : 1 ≤ AModel.vol (G ++ List.replicate r q) := by
          rw [AModel.vol_append, AModel.vol_replicate]
          exact Nat.mul_pos (NLogN.KIL.one_le_vol hG) (Nat.one_le_pow _ _ (by omega))
        have h4 : 1 ≤ q ^ n := Nat.one_le_pow _ _ (by omega)
        exact Nat.mul_pos h4 (Nat.mul_pos h3 (Nat.mul_pos h4 (NLogN.KIL.one_le_vol hS)))
      calc R' = 1 * R' * 1 := by ring
        _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_right _ h1) h2
    exact le_trans (Nat.pow_le_pow_right (by omega) hjK) (le_trans hR1 hRV)
  set X : ℝ := ((Bb : ℝ) + 2) ^ 2 with hX
  have hX0 : 0 ≤ X := by positivity
  have hτ0 : 0 ≤ τ := hτ.1.le
  have huτ : 1 ≤ (u : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast hu) hτ0
  set D := ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j with hD
  have hDb : (D : ℝ) ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * X * (u : ℝ) ^ τ) := by
    by_cases hn0 : n = 0
    · have : D = 0 := by rw [hD, hn0]; simp
      rw [this]; push_cast; positivity
    · have hn1 : 1 ≤ n := by omega
      have step1 : (D : ℝ) ≤ ∑ j ∈ range (Nat.digits m n).length,
          (AModel.digit m n j : ℝ) * (2 * K₀ * X * V') * ((m : ℝ) ^ j) ^ τ := by
        rw [hD]; push_cast
        apply sum_le_sum
        intro j hj
        rw [mem_range] at hj
        rw [NLogN.KIL.digit_eq hm]
        have hc := hK₀b Bb j V'
        have hWj : ((W : ℝ) ^ j) ≤ V' := by exact_mod_cast hWV hn0 j hj
        have hd0 : (0 : ℝ) ≤ ((n / m ^ j % m : ℕ) : ℝ) := Nat.cast_nonneg _
        have hmj : 0 ≤ ((m : ℝ) ^ j) ^ τ := by positivity
        have : (cO j : ℝ) ≤ 2 * K₀ * X * V' * ((m : ℝ) ^ j) ^ τ := by
          refine le_trans hc ?_
          rw [← hX]
          have : X * ((V' : ℝ) + (W : ℝ) ^ j) ≤ X * (2 * V') := by
            apply mul_le_mul_of_nonneg_left _ hX0; linarith
          calc K₀ * (X * ((V' : ℝ) + (W : ℝ) ^ j)) * ((m : ℝ) ^ j) ^ τ
              ≤ K₀ * (X * (2 * V')) * ((m : ℝ) ^ j) ^ τ := by gcongr
            _ = 2 * K₀ * X * V' * ((m : ℝ) ^ j) ^ τ := by ring
        calc ((n / m ^ j % m : ℕ) : ℝ) * (cO j : ℝ)
            ≤ ((n / m ^ j % m : ℕ) : ℝ) * (2 * K₀ * X * V' * ((m : ℝ) ^ j) ^ τ) :=
              mul_le_mul_of_nonneg_left this hd0
          _ = _ := by ring
      have step2 : ∑ j ∈ range (Nat.digits m n).length,
          (AModel.digit m n j : ℝ) * (2 * K₀ * X * V') * ((m : ℝ) ^ j) ^ τ =
          (2 * K₀ * X * V') * ∑ j ∈ range (Nat.digits m n).length,
            (AModel.digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ := by
        rw [mul_sum]; apply sum_congr rfl; intro j _; ring
      have step3 := hK'b n hn1
      have hnτ : (n : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast (show n ≤ u by omega)) hτ0
      have hV'r : (V' : ℝ) ≤ 2 * (q : ℝ) ^ 2 * Vb := by
        have := le_trans (hV'2 hn0) (Nat.mul_le_mul_left 2 hVqb)
        have h' : (V' : ℝ) ≤ ((2 * (q ^ 2 * Vb) : ℕ) : ℝ) := by exact_mod_cast this
        push_cast at h'; linarith
      have hc0 : 0 ≤ 2 * K₀ * X := by positivity
      have hsum0 : 0 ≤ ∑ j ∈ range (Nat.digits m n).length, (AModel.digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ :=
        sum_nonneg fun j _ => by positivity
      calc (D : ℝ) ≤ (2 * K₀ * X * V') * ∑ j ∈ range (Nat.digits m n).length,
            (AModel.digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ := by rw [← step2]; exact step1
        _ ≤ (2 * K₀ * X * V') * (K' * (n : ℝ) ^ τ) :=
            mul_le_mul_of_nonneg_left step3 (by positivity)
        _ ≤ (2 * K₀ * X * (2 * (q : ℝ) ^ 2 * Vb)) * (K' * (u : ℝ) ^ τ) := by
            gcongr
        _ ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * X * (u : ℝ) ^ τ) := by
            have : (0 : ℝ) ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * X * (u : ℝ) ^ τ := by positivity
            nlinarith
  -- `Kp + 1 ≤ (Ck + 1) u^τ`
  have hKpb : (Kp : ℝ) + 1 ≤ (Ck + 1) * (u : ℝ) ^ τ := by
    have h1 := hCkb e he1
    rw [← hKp] at h1
    have h2 : (e : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast heu) hτ0
    nlinarith
  have hlinR : (NLogN.KIL.cL12 u e r Kp n Vq V' m q cO Bb : ℝ) ≤
      (NLogN.KIL.Nc q m W : ℝ) * (X * ((Vb : ℝ) + 1) * ((Kp : ℝ) + 1)) + D := by
    have := hlin
    have h' : ((NLogN.KIL.cL12 u e r Kp n Vq V' m q cO Bb : ℕ) : ℝ) ≤
        ((NLogN.KIL.Nc q m W * ((Bb + 2) ^ 2 * (Vb + 1) * (Kp + 1)) + D : ℕ) : ℝ) := by exact_mod_cast this
    push_cast at h'
    rw [hX]; linarith
  have hNc : (0 : ℝ) ≤ NLogN.KIL.Nc q m W := Nat.cast_nonneg _
  have hVb0 : (0 : ℝ) ≤ (Vb : ℝ) + 1 := by positivity
  calc (NLogN.KIL.cL12 u e r Kp n Vq V' m q cO Bb : ℝ)
      ≤ (NLogN.KIL.Nc q m W : ℝ) * (X * ((Vb : ℝ) + 1) * ((Kp : ℝ) + 1)) + D := hlinR
    _ ≤ (NLogN.KIL.Nc q m W : ℝ) * (X * ((Vb : ℝ) + 1) * ((Ck + 1) * (u : ℝ) ^ τ)) +
        4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * X * (u : ℝ) ^ τ) :=
        add_le_add (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hKpb
          (mul_nonneg hX0 hVb0)) hNc) hDb
    _ = ((NLogN.KIL.Nc q m W : ℝ) * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K') * ((Vb : ℝ) + 1) * X *
        (u : ℝ) ^ τ := by ring
end
