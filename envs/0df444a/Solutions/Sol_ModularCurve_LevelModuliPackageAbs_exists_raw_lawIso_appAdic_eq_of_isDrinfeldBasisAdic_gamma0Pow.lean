theorem appAdic_mem {T : Type} [CommRing T] {F G : FormalGroup T} (φ : FormalGroup.LawHom F G)
    (I : Ideal T) [IsAdicComplete I T] {a : T} (ha : a ∈ I) : φ.appAdic I a ∈ I := by
  obtain ⟨e, he, hep⟩ := FormalGroup.exists_ringHom_evalSeries_eq I a ha
  have h1 : φ.appAdic I a = e φ.series := he φ.series
  obtain ⟨g, hg⟩ : (PowerSeries.X : PowerSeries T) ∣ φ.series := PowerSeries.X_dvd_iff.mpr φ.constantCoeff_series
  have hX : e PowerSeries.X = a := by rw [← Polynomial.coe_X, hep, Polynomial.eval_X]
  rw [h1, hg, map_mul, hX]
  exact I.mul_mem_right _ ha

