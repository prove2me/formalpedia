namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

/-! ## The coordinate-change family -/

theorem shiftMap_zero (ξ : Fin n → Pt n → ℝ) (y : Pt n) : shiftMap ξ 0 y = y := by
  funext k; simp [shiftMap]

theorem shiftJac_zero (ξ : Fin n → Pt n → ℝ) (y : Pt n) : shiftJac ξ 0 y = 1 := by
  simp [shiftJac]

theorem shiftJac_apply (ξ : Fin n → Pt n → ℝ) (ε : ℝ) (y : Pt n) (k i : Fin n) :
    shiftJac ξ ε y k i = (1 : Matrix (Fin n) (Fin n) ℝ) k i + ε * pd i (ξ k) y := by
  simp [shiftJac, Matrix.add_apply]

theorem pullCov_apply (ξ : Fin n → Pt n → ℝ) (T : Fin n → Fin n → Pt n → ℝ) (ε : ℝ) (a b : Fin n) (y : Pt n) :
    pullCov ξ T ε a b y = ∑ p, ∑ q, shiftJac ξ ε y p a * shiftJac ξ ε y q b * T p q (shiftMap ξ ε y) := by
  rw [pullCov, congr_entry]
  rfl

section regularity

variable {U : Set (Pt n)} (hU : IsOpen U) {ξ : Fin n → Pt n → ℝ} (hξ : ∀ k, ContDiffOn ℝ ∞ (ξ k) U)
include hU hξ

