                                (rootAdmissibleErase lam S α hα herase)
                                β hβ hins)).val :
                                youngMultihomogeneousSubmodule n
                                  (rootWedgeWeight lam
                                    (rootAdmissibleInsert lam
                                      (rootAdmissibleErase lam S α hα herase)
                                      β hβ hins))) :
                                PolynomialSpace r n))
                else 0
            else 0
          else 0 := by
