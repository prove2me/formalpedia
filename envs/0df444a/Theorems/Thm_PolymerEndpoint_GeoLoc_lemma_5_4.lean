-- title:
--   Lemma 5.4, p. 40 — max(f) = max_u f(u) is continuous on 𝒮
-- statement:
--   Let $d\ge1$ and let $\mathcal S$ be the space of partitioned subprobability measures with the metric $d$ of (2.3). The function
--   $$\max:\mathcal S\to[0,1],\qquad \max(f)=\max_{u\in\mathbb N\times\mathbb Z^d}f(u),$$
--   is continuous, and therefore Borel measurable.
--
--   Together with the convergence of the empirical measures of the endpoint distributions to $\mathcal M$, this lemma turns the Cesàro average of $\max_x f_i(x)$ into an integral against $\mathcal M$; it is the continuity step of the proof of Theorem 5.3.
--
--   **Formalization Note.** $\mathcal S$ is represented by the set $S$ of representatives with the topology generated by $d$-balls (see the definition module).
-- source:
--   Bates and Chatterjee, The endpoint distribution of directed polymers, arXiv:1612.03443v5, p. 40, Lemma 5.4

import Mathlib
import Definitions.Def_PolymerEndpoint_GeoLoc_Functionals
open MeasureTheory

namespace PolymerEndpoint.GeoLoc

/-- Lemma 5.4: `max : 𝒮 → [0, 1]`, `max(f) = max_u f(u)`, is continuous and thus measurable. -/
theorem lemma_5_4 (d : ℕ) (hd : 1 ≤ d) :
    Continuous (maxS : PolymerEndpoint.Atomic.PSM d → ℝ) ∧ Measurable (maxS : PolymerEndpoint.Atomic.PSM d → ℝ) := by sorry

end PolymerEndpoint.GeoLoc
