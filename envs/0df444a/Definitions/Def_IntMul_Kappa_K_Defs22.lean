namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- The state after `setupS`: `d, K, α, L, ℓ, r, d', Q, M_{r/2}, M_r` pushed on `zD … zMf`. -/
noncomputable def setupSt (n : ℕ) (s : IState HS) : IState HS :=
  let p := fun (t : IState HS) (i : Fin HS) (v : ℕ) => t.upd i (.int (v : ℤ) :: s.G i)
  p (p (p (p (p (p (p (p (p (p s NLogN.KFM.zD (dP n)) zK (KP n)) zAl (αP n)) zL (LP n)) zEl (ℓP n)) zR (IntMul.OpenAI.Glue.rP n))
    zDp (mcnt (LP n) (dP n))) zQ (srcQ (dP n) (IntMul.OpenAI.Glue.rP n))) zMh (srcM (dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n / 2)))
    zMf (srcM (dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n))

end NLogN.KFM

