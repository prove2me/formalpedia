/-!
Repair provenance: the frozen namesakes are not interchangeable with the five
interfaces below. Dependency50.P32.PureInput is a single unit vector with an
input-sized reference, whereas DynamicPureEnsemble packages an arbitrary finite
reference and the imported P08.PureEnsemble. Information100.P56.holevo is in nats;
cqHolevoBits uses imported base-two vnEntropy on receiver marginals. Frozen
TwoPartyProtocol.finalState and QueryAlg.finalState describe wire/query protocols,
not catalytic CPTP codes. Information100.P67.codeError is private-code infidelity,
not the full joint trace norm catalyticJointError. Information100.P04.Achievable
is PPT-state distillation, not signed six-resource AchievableDynamicRates.
Their distinct names preserve the source's objects without redefining or silently
substituting a frozen concept. All imported primitive definitions stay unchanged.
-/

/-- PDF pp.3--6: coordinates 0,1,2 are C,Q,E, with their usual Euclidean topology. -/
abbrev Rate := Fin 3 → ℝ

/-- PDF p.7: exactly the cone generated by ED, superdense coding, and teleportation. -/
def unitCone : Set Rate :=
  {r | ∃ a b c : ℝ, 0 ≤ a ∧ 0 ≤ b ∧ 0 ≤ c ∧
    r = a • ![0, -1, 1] + b • ![2, -1, -1] + c • ![-2, 1, -1]}

/-- PDF pp.6,11: an arbitrary finite reference and a finite normalized pure ensemble.
Neither dimension is fixed by the channel or by a preceding ensemble. -/
structure DynamicPureEnsemble (A : Type) [Fintype A] where
  referenceDim : ℕ
  referencePositive : 0 < referenceDim
  ensemble : PureEnsemble (Fin referenceDim × A)

/-- PDF p.6 (12): channel output on each pure input, preserving its reference. -/
def pureOutputs {A B : Type} [Fintype A] (N : Superop A B) (e : DynamicPureEnsemble A)
    (x : Fin e.ensemble.size) :
    Matrix (Fin e.referenceDim × B) (Fin e.referenceDim × B) ℂ :=
  idTensorSuperop N (pureDensity (e.ensemble.vector x))

/-- PDF pp.3,11 (18): Holevo information of normalized conditional bipartite outputs. -/
def cqHolevoBits {X R B : Type} [Fintype X] [Fintype R] [Fintype B]
    [DecidableEq B] (p : X → ℝ) (rho : X → Matrix (R × B) (R × B) ℂ) : ℝ :=
  vnEntropy (∑ x, p x • traceLeft (rho x)) -
    ∑ x, p x * vnEntropy (traceLeft (rho x))

/-- PDF pp.3,11 (19): I(RX;B); classical entropy terms cancel exactly. -/
def jointMutual {X R B : Type} [Fintype X] [Fintype R] [Fintype B]
    [DecidableEq R] [DecidableEq B]
    (p : X → ℝ) (rho : X → Matrix (R × B) (R × B) ℂ) : ℝ :=
  vnEntropy (∑ x, p x • traceLeft (rho x)) +
    ∑ x, p x * (vnEntropy (traceRight (rho x)) - vnEntropy (rho x))

/-- PDF pp.3,11 (20): I(R>B X)=sum_x p_x [H(B)_x-H(RB)_x]. -/
def conditionalCoherent {X R B : Type} [Fintype X] [Fintype R] [Fintype B]
    [DecidableEq R] [DecidableEq B]
    (p : X → ℝ) (rho : X → Matrix (R × B) (R × B) ℂ) : ℝ :=
  ∑ x, p x * (vnEntropy (traceLeft (rho x)) - vnEntropy (rho x))

/-- PDF p.6 (9)--(11): the three constraint right sides on ONE ensemble. -/
def bounds {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) (e : DynamicPureEnsemble A) : Rate :=
  let p := e.ensemble.prob
  let rho := pureOutputs N e
  ![jointMutual p rho, conditionalCoherent p rho,
    cqHolevoBits p rho + conditionalCoherent p rho]

/-- PDF p.6: all three inequalities use the same right-side triple. -/
def rateConstraints (b r : Rate) : Prop :=
  r 0 + 2 * r 1 ≤ b 0 ∧ r 1 + r 2 ≤ b 1 ∧ r 0 + r 1 + r 2 ≤ b 2

/-- PDF p.6: unclosed one-shot union over all finite pure ensembles and references. -/
def oneShotRegion {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set Rate :=
  {r | ∃ e : DynamicPureEnsemble A, rateConstraints (bounds N e) r}

/-- PDF p.6 (8): closure OUTSIDE the union; positive blocklength and inverse scaling. -/
def regularizedRegion {A B : Type} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B] (N : Superop A B) : Set Rate :=
  closure {r | ∃ k : ℕ, 0 < k ∧
    (k : ℝ) • r ∈ oneShotRegion (piSuperop (fun _ : Fin k => N))}

/-- PDF p.11 (21): scalarization on one common ensemble, including the entire mu term. -/
def dynamicScore {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) (lambda mu : ℝ) (e : DynamicPureEnsemble A) : ℝ :=
  bounds N e 0 + lambda * bounds N e 1 + mu * bounds N e 2

/-- PDF p.11 (21): feasible values, with normalized states even at zero-weight labels. -/
def dynamicValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) (lambda mu : ℝ) : Set ℝ :=
  {v | ∃ e : DynamicPureEnsemble A, v = dynamicScore N lambda mu e}

/-- PDF p.11 (21): D. For CPTP N on nonempty finite systems and nonnegative
weights this set is nonempty, bounded by output-dimension entropy bounds, and attains
its supremum. Extra reference dimensions cannot make these values unbounded. -/
def dynamic {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) (lambda mu : ℝ) : ℝ := sSup (dynamicValues N lambda mu)

/-- PDF p.11, Definition 4: positive-block supremum implementation of Dreg.
The value set is nonempty and bounded for finite CPTP channels. Lemma 1 below
explicitly asserts convergence to this value, so no default real limit is used. -/
def regularizedDynamic {A B : Type} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B] (N : Superop A B) (lambda mu : ℝ) : ℝ :=
  sSup {v | ∃ n : ℕ, 0 < n ∧
    v = dynamic (piSuperop (fun _ : Fin n => N)) lambda mu / (n : ℝ)}

/-- PDF p.12, Lemma 1: genuinely GLOBAL pairwise additivity, not just N tensor N. -/
def AdditiveDynamic (lambda mu : ℝ) : Prop :=
  ∀ (A B C D : Type) [Fintype A] [Fintype B] [Fintype C] [Fintype D]
    [DecidableEq A] [DecidableEq B] [DecidableEq C] [DecidableEq D]
    [Nonempty A] [Nonempty B] [Nonempty C] [Nonempty D],
    ∀ (N : Superop A B) (M : Superop C D), IsChannel N → IsChannel M →
      dynamic (tensorChannel N M) lambda mu = dynamic N lambda mu + dynamic M lambda mu

/-- PDF p.12: single-letterization includes a genuine limit at every nonnegative weight. -/
def SingleLetterDynamic {A B : Type} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B] (N : Superop A B) : Prop :=
  ∀ lambda mu : ℝ, 0 ≤ lambda → 0 ≤ mu →
    Tendsto (fun n : ℕ => dynamic (piSuperop (fun _ : Fin n => N)) lambda mu / (n : ℝ))
      atTop (nhds (dynamic N lambda mu))

/-- PDF p.11: componentwise maximal points, not the full topological boundary. -/
def pareto (S : Set Rate) : Set Rate :=
  {r | r ∈ S ∧ ∀ s ∈ S, (∀ i, r i ≤ s i) → s = r}

/-- PDF pp.4--6: six independent positive resource dimensions. Coordinates are
(Cgen,Qgen,Egen,Ccons,Qcons,Econs), so dimension one means zero gross resource. -/
structure Resources where
  dim : Fin 6 → ℕ
  positive : ∀ i, 0 < dim i

/-- PDF p.4: the local encoder's M,A1,TA input. -/
abbrev EncoderInput (s : Resources) := Fin (s.dim 0) × (Fin (s.dim 1) × Fin (s.dim 5))

/-- PDF pp.4--5: noisy block input, SA, classical L, and noiseless quantum A2. -/
abbrev EncoderOutput (A : Type) (n : ℕ) (s : Resources) :=
  (Fin n → A) × (Fin (s.dim 2) × (Fin (s.dim 3) × Fin (s.dim 4)))

/-- PDF p.5: decoder has exactly B^n,A2,TB,L and no feedback register. -/
abbrev DecoderInput (B : Type) (n : ℕ) (s : Resources) :=
  ((Fin n → B) × Fin (s.dim 4)) × (Fin (s.dim 5) × Fin (s.dim 3))

/-- PDF p.5: decoder returns B1,SB,Mhat. -/
abbrev DecoderOutput (s : Resources) := Fin (s.dim 1) × (Fin (s.dim 2) × Fin (s.dim 0))

/-- PDF p.5 (4): joint retained marginal ordered as (M,Mhat),(R,B1),(SA,SB). -/
abbrev FinalRegister (s : Resources) :=
  (Fin (s.dim 0) × Fin (s.dim 0)) ×
    ((Fin (s.dim 1) × Fin (s.dim 1)) × (Fin (s.dim 2) × Fin (s.dim 2)))

/-- PDF pp.4--6: physical catalytic protocol. Local environments and randomness
are included in the arbitrary CPTP maps; no entropic constraint defines the code. -/
structure DynamicCode (A B : Type) [Fintype A] [Fintype B] (n : ℕ) where
  resources : Resources
  encoder : Superop (EncoderInput resources) (EncoderOutput A n resources)
  decoder : Superop (DecoderInput B n resources) (DecoderOutput resources)
  encoderChannel : IsChannel encoder
  decoderChannel : IsChannel decoder

/-- PDF pp.4--5: an unnormalized encoder block with untouched external M,R,TB
indices. Normalization is applied once in catalyticFinalState, from the initial three resources. -/
def initialBlock (s : Resources) (m : Fin (s.dim 0))
    (r t : Fin (s.dim 1)) (u v : Fin (s.dim 5)) :
    Matrix (EncoderInput s) (EncoderInput s) ℂ :=
  fun a b => if a = (m, (r, u)) ∧ b = (m, (t, v)) then 1 else 0

/-- PDF p.5: actual final M,Mhat,R,B1,SA,SB marginal, by matrix-unit expansion.
The L wire is dephased before Bob receives it; Mhat is read out classically.
A2 and TB remain fully quantum.
Both local maps are fixed before the uniformly distributed message and reference.
The prefactor is 1/(|M| |A1| |TA|), from classical correlation and two Bell states. -/
def catalyticFinalState {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]
    (N : Superop A B) {n : ℕ} (P : DynamicCode A B n) :
    Matrix (FinalRegister P.resources) (FinalRegister P.resources) ℂ :=
  let s := P.resources
  fun f g => if f.1.1 = g.1.1 ∧ f.1.2 = g.1.2 then
    ((s.dim 0 : ℂ) * (s.dim 1 : ℂ) * (s.dim 5 : ℂ))⁻¹ *
      ∑ y : DecoderInput B n s, ∑ z : DecoderInput B n s,
        P.decoder (Matrix.single y z 1) (f.2.1.2, (f.2.2.2, f.1.2))
          (g.2.1.2, (g.2.2.2, g.1.2)) *
        (if y.2.2 = z.2.2 then
          piSuperop (fun _ : Fin n => N)
            (fun a b => P.encoder
              (initialBlock s f.1.1 f.2.1.1 g.2.1.1 y.2.1 z.2.1)
              (a, (f.2.2.1, (y.2.2, y.1.2)))
              (b, (g.2.2.1, (z.2.2, z.1.2)))) y.1.1 z.1.1
        else 0)
  else 0

/-- PDF p.5 (4): uniform classical correlation tensor Bell(R,B1) tensor Bell(SA,SB).
Its denominator differs from the initial state's denominator when entanglement is generated. -/
def idealFinal (s : Resources) : Matrix (FinalRegister s) (FinalRegister s) ℂ :=
  fun f g => if f.1.1 = f.1.2 ∧ g.1.1 = g.1.2 ∧ f.1.1 = g.1.1 ∧
      f.2.1.1 = f.2.1.2 ∧ g.2.1.1 = g.2.1.2 ∧
      f.2.2.1 = f.2.2.2 ∧ g.2.2.1 = g.2.2.2 then
    ((s.dim 0 : ℂ) * (s.dim 1 : ℂ) * (s.dim 2 : ℂ))⁻¹ else 0

/-- PDF p.5 (4): FULL trace norm of the entire joint marginal error. -/
def catalyticJointError {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]
    (N : Superop A B) {n : ℕ} (P : DynamicCode A B n) : ℝ :=
  traceNorm (idealFinal P.resources - catalyticFinalState N P)

/-- PDF pp.5--6: integer resource dimensions divided by a positive blocklength.
Only n>=1 is used by achievability; there is no artificial exact-real dimension constraint. -/
def grossRate (s : Resources) (n : ℕ) (i : Fin 6) : ℝ :=
  Real.logb 2 (s.dim i : ℝ) / (n : ℝ)

/-- PDF p.6 (5)--(7): signed net rates, generation minus consumption. -/
def netRates (g : Fin 6 → ℝ) : Rate := ![g 0 - g 3, g 1 - g 4, g 2 - g 5]

/-- PDF p.6, Definition 1, with usual integer rounding made explicit.
Finite gross rates are fixed BEFORE both tolerances and every blocklength.
Every sufficiently large positive n has a code, not just a favorable subsequence. -/
def AchievableDynamicRates {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]
    (N : Superop A B) (r : Rate) : Prop :=
  ∃ gross : Fin 6 → ℝ, (∀ i, 0 ≤ gross i) ∧ netRates gross = r ∧
    ∀ epsilon delta : ℝ, 0 < epsilon → 0 < delta →
      ∃ n0 : ℕ, 0 < n0 ∧ ∀ n ≥ n0, ∃ P : DynamicCode A B n,
        catalyticJointError N P < epsilon ∧ ∀ i, |grossRate P.resources n i - gross i| < delta

/-- PDF p.6, Definition 2: independently defined operational capacity region. -/
def operationalDynamicRegion {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]
    (N : Superop A B) : Set Rate := closure {r | AchievableDynamicRates N r}

/-- PDF p.14: mutual-information values over arbitrary reference purifications. -/
def singleMutualValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ :=
  {v | ∃ r : ℕ, 0 < r ∧ ∃ psi : EuclideanSpace ℂ (Fin r × A), ‖psi‖ = 1 ∧
    v = vnEntropy (traceRight (idTensorSuperop N (pureDensity psi))) +
      vnEntropy (traceLeft (idTensorSuperop N (pureDensity psi))) -
      vnEntropy (idTensorSuperop N (pureDensity psi))}

/-- PDF p.14: coherent-information values of arbitrary pure bipartite inputs. -/
def singleCoherentValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ :=
  {v | ∃ r : ℕ, 0 < r ∧ ∃ psi : EuclideanSpace ℂ (Fin r × A), ‖psi‖ = 1 ∧
    v = vnEntropy (traceLeft (idTensorSuperop N (pureDensity psi))) -
      vnEntropy (idTensorSuperop N (pureDensity psi))}

/-- PDF p.14, Corollary 1: all cq mutual-information values. -/
def cqMutualValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ := {v | ∃ e : DynamicPureEnsemble A, v = bounds N e 0}

/-- PDF p.14, Corollary 2: all cq conditional coherent-information values. -/
def cqCoherentValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ := {v | ∃ e : DynamicPureEnsemble A, v = bounds N e 1}

/-- PDF pp.14--15, Corollary 3: optimize the SUM on one common cq ensemble. -/
def cqSumValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ := {v | ∃ e : DynamicPureEnsemble A, v = bounds N e 2}

/-- PDF pp.14--15: pure, unentangled channel-input ensembles on the HSW side. -/
def pureHolevoValues {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) : Set ℝ :=
  {v | ∃ e : PureEnsemble A,
    v = vnEntropy (∑ x, e.prob x • N (pureDensity (e.vector x))) -
      ∑ x, e.prob x * vnEntropy (N (pureDensity (e.vector x)))}

/-- PDF p.16: gamma contains p/2 because p is complete-dephasing probability. -/
def dephasingGamma (nu p : ℝ) : ℝ :=
  1 / 2 + (1 / 2) * Real.sqrt (1 - 16 * (p / 2) * (1 - p / 2) * nu * (1 - nu))

/-- PDF p.16 (26)--(28): one common nu for all three constraints. -/
def dephasingBounds (p nu : ℝ) : Rate :=
  ![1 + binEntropy2 nu - binEntropy2 (dephasingGamma nu p),
    binEntropy2 nu - binEntropy2 (dephasingGamma nu p),
    1 - binEntropy2 (dephasingGamma nu p)]

/-- PDF pp.16--17 (29)--(31): canonical purifications of the two displayed marginals. -/
def dephasingVector (nu : ℝ) (x : Fin 2) : EuclideanSpace ℂ (Fin 2 × Fin 2) :=
  WithLp.toLp 2 fun a => if a.1 = a.2 then
    if a.2 = x then (Real.sqrt nu : ℂ) else (Real.sqrt (1 - nu) : ℂ)
  else 0

/-- PDF pp.16--18: actual scalar functional of the equiprobable binary ensemble (29).
On 0<=nu<=1/2 its vectors are normalized; reference isometries leave the score invariant. -/
def dephasingBinaryScore (p lambda mu nu : ℝ) : ℝ :=
  let rho := fun x : Fin 2 =>
    idTensorSuperop (qubitDephasing (1 - p)) (pureDensity (dephasingVector nu x))
  jointMutual (fun _ : Fin 2 => (1 / 2 : ℝ)) rho +
    lambda * conditionalCoherent (fun _ : Fin 2 => (1 / 2 : ℝ)) rho +
    mu * (cqHolevoBits (fun _ : Fin 2 => (1 / 2 : ℝ)) rho +
      conditionalCoherent (fun _ : Fin 2 => (1 / 2 : ℝ)) rho)

/-- PDF p.18, Theorem 5: erasure bounds, with a shared scalar p. -/
def erasureBounds (epsilon p : ℝ) : Rate :=
  ![(1 - epsilon) * (1 + binEntropy2 p),
    (1 - 2 * epsilon) * binEntropy2 p,
    1 - epsilon - epsilon * binEntropy2 p]

/-- PDF pp.20--21 (34): the entire scalar maximand, without a coefficient restriction. -/
def erasureScore (epsilon lambda mu p : ℝ) : ℝ :=
  erasureBounds epsilon p 0 + lambda * erasureBounds epsilon p 1 +
    mu * erasureBounds epsilon p 2

/-- PDF p.21: sign-sensitive entropy coefficient in the erasure maximand. -/
def erasureCoefficient (epsilon lambda mu : ℝ) : ℝ :=
  (1 - epsilon) + lambda * (1 - 2 * epsilon) - mu * epsilon

/-- PDF pp.18--19: CEF endpoints, parametrized by input entropy h=0 or 1.
The Q coordinate is (1-epsilon)*h and E is -epsilon*h, including full erasure. -/
def erasureCEF (epsilon h : ℝ) : Rate := ![(1 - epsilon) * (1 - h), (1 - epsilon) * h, -epsilon * h]

/-- PDF p.21: the classical endpoint translated by the unit-resource cone. -/
def classicalBranchRegion (epsilon : ℝ) : Set Rate :=
  {r | rateConstraints ![1 - epsilon, 0, 1 - epsilon] r}

/-! Sanity examples pin small cases of each group of paper-local definitions. -/

example : netRates (fun _ => 0) = 0 := by
  ext i
  fin_cases i <;> simp [netRates]

example (r : Rate) : rateConstraints ![0, 0, 0] r ↔
    r 0 + 2 * r 1 ≤ 0 ∧ r 1 + r 2 ≤ 0 ∧ r 0 + r 1 + r 2 ≤ 0 := by
  rfl

example {R B : Type} [Fintype R] [Fintype B] [DecidableEq B]
    (rho : Fin 0 → Matrix (R × B) (R × B) ℂ) : cqHolevoBits (fun _ => 0) rho = 0 := by
  simp [cqHolevoBits, vnEntropy]

example (nu : ℝ) : dephasingGamma nu 0 = 1 := by
  norm_num [dephasingGamma]

example (nu : ℝ) : dephasingVector nu 0 (0, 1) = 0 := by
  norm_num [dephasingVector]

example : erasureCEF 1 0 = 0 := by
  ext i
  fin_cases i <;> norm_num [erasureCEF]

example (s : Resources) (n : ℕ) (i : Fin 6) (hi : s.dim i = 1) :
    grossRate s n i = 0 := by simp [grossRate, hi]

example (s : Resources) (m : Fin (s.dim 0)) (r : Fin (s.dim 1))
    (t : Fin (s.dim 5)) : initialBlock s m r r t t (m, (r, t)) (m, (r, t)) = 1 := by
  simp [initialBlock]

example (s : Resources) (f g : FinalRegister s) (h : f.1.1 ≠ f.1.2) :
    idealFinal s f g = 0 := by simp [idealFinal, h]

example {A B : Type} [Fintype A] [Fintype B] [DecidableEq B]
    (N : Superop A B) (e : DynamicPureEnsemble A) : dynamicScore N 0 0 e = bounds N e 0 := by
  simp [dynamicScore]

example {A B : Type} [Fintype A] [Fintype B] [DecidableEq A]
    (N : Superop A B) {n : ℕ} (P : DynamicCode A B n)
    (f g : FinalRegister P.resources) (h : f.1.1 ≠ g.1.1) : catalyticFinalState N P f g = 0 := by
  simp [catalyticFinalState, h]

example : Resources := ⟨fun _ => 1, fun _ => by decide⟩

end QAlgorithms.Papers.Independent.Claimed50.P20


