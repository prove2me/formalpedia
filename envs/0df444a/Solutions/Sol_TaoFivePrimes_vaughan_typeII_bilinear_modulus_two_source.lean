theorem vaughan_typeII_bilinear_modulus_two_source_integrated
    (x alpha beta U V : ℝ) (a : ℤ) (q : ℕ)
    (hq : 4 ≤ q) (haq : Nat.Coprime a.natAbs q)
    (halpha : 4 * alpha = (a : ℝ) / q + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hU40 : 40 ≤ U) (hV40 : 40 ≤ V)
    (hUx : U < x) (hVx : V < x)
    (hUV : U * V ≤ x / 4) (hUV2 : x ≤ U * V ^ 2) :
    ‖eta0VaughanBilinearSum x alpha U V‖ ≤
      (0.1 * (x / Real.sqrt q) +
        0.39 * (x / Real.sqrt (x / q))) *
          Real.log (x / (U * V)) * Real.log (V * x / U) +
      (0.55 * (x / Real.sqrt U) +
        0.78 * (x / Real.sqrt V)) * Real.log (x / U) := by
  have hUpos : 0 < U := lt_of_lt_of_le (by norm_num) hU40
  have hVpos : 0 < V := lt_of_lt_of_le (by norm_num) hV40
  have hxpos : 0 < x := hUpos.trans hUx
  have hqpos : (0 : ℝ) < q := by positivity
  have hVX : V ≤ x / U := by
    apply (le_div_iff₀ hUpos).2
    nlinarith [hUV]
  have hVone : (1 : ℝ) ≤ V := (by norm_num : (1 : ℝ) ≤ 40) |>.trans hV40
  have hXone : (1 : ℝ) ≤ x / U := hVone.trans hVX
  let G : ℝ → ℝ := fun W =>
    (1 / (2 * Real.sqrt 2) : ℝ) * (x / Real.sqrt q) +
      (1 / 2 : ℝ) * Real.sqrt (x * W) +
      (1 / Real.sqrt 2 : ℝ) * (x / Real.sqrt W) +
      Real.sqrt 2 * (x / Real.sqrt (x / q))
  have hblockIntegral :
      (∫ W : ℝ in Set.Icc V (x / U),
          ‖eta0VaughanTypeIIBlock x alpha U V W‖ * (1 / W)) ≤
        (1.1 / 8 : ℝ) *
          ∫ W : ℝ in Set.Icc V (x / U),
            G W * Real.log W * (1 / W) := by
    calc
      (∫ W : ℝ in Set.Icc V (x / U),
          ‖eta0VaughanTypeIIBlock x alpha U V W‖ * (1 / W)) ≤
          ∫ W : ℝ in Set.Icc V (x / U),
            (1.1 / 8 : ℝ) * (G W * Real.log W * (1 / W)) := by
        apply MeasureTheory.integral_mono_of_nonneg
        · filter_upwards [ae_restrict_mem measurableSet_Icc] with W hW
          have hWpos : 0 < W := hVpos.trans_le hW.1
          positivity
        · refine ContinuousOn.integrableOn_Icc ?_
          dsimp [G]
          fun_prop (disch := grind)
        · filter_upwards [ae_restrict_mem measurableSet_Icc] with W hW
          have hWpos : 0 < W := hVpos.trans_le hW.1
          have hp := norm_eta0VaughanTypeIIBlock_le_four_term_pointwise
            x alpha beta U V W a q hq haq halpha hbeta
              hU40 hV40 hW.1 hW.2
          calc
