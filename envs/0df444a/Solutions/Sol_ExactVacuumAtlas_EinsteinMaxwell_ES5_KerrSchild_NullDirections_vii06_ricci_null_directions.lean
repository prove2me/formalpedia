  fin_cases i <;>
    simp [principalCoord, principalFrame, esFrame, Matrix.mulVec, dotProduct, Fin.sum_univ_five] <;>
    ring

theorem frameInv_injective (W : ℝ → ℝ) (x : Pt 5) {k k' : Fin 5 → ℝ}
    (h : frameInv W x k = frameInv W x k') : k = k' := by
  rw [← esFrame_mulVec_frameInv W x k, h, esFrame_mulVec_frameInv]

section Pointwise

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}

theorem pos_frame_factors {r : ℝ} (hf : 0 < f r) (hm : 0 < m r) (hN : 0 < N r) :
    0 < Dfun f m N r ∧ 0 < Afun f m r ∧ 0 < Hfun m N r := by
  refine ⟨?_, ?_, ?_⟩ <;> simp only [Dfun, Afun, Hfun] <;> positivity

theorem eFun_ne_zero_of_alphaSq_pos {r : ℝ} (hf : 0 < f r) (ha2 : 0 < alphaSq f m N w p a r) :
    eFun w p a r ≠ 0 := by
  intro he
  rw [alphaSq, he] at ha2
  have : 0 ≤ f r * deriv a r ^ 2 := by positivity
  nlinarith

/-- **Actual Faraday eigen-equation.** If `λ² = alphaSq`, then `(g⁻¹ F) 𝒦_λ = λ 𝒦_λ`
for the actual `esInverse` and `esFaraday`. -/
theorem principalCoord_eigen (hP : PaperData I f m N w p a) {x : Pt 5} (hx : x ∈ esDomain I)
    {lam : ℝ} (hl : lam ^ 2 = alphaSq f m N w p a (x 1)) :
