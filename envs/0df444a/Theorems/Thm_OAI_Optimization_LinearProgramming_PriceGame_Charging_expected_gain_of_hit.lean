theorem expected_gain_of_hit {n : ℕ} (p : V → ℚ) (hp₀ : ∀ v, 0 ≤ p v)
    (hp : ∑ v, p v = 1) (good : Finset V) (gain : (Fin n → V) → ℚ) (b : ℚ)
    (hit : ∀ x, (∃ j, x j ∈ good) → 1 ≤ gain x)
    (miss : ∀ x, (∀ j, x j ∉ good) → b ≤ gain x) :
    1 - (1 - b) * (1 - ∑ v ∈ good, p v) ^ n ≤
      ∑ x, drawWeight p x * gain x := by sorry
