section
-- Source module: Solutions.NetLabels
open Matrix Module

set_option linter.unusedSectionVars false

namespace NetLabels

variable {K : Type*} [Field K] {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The bilinear form `xᵀ G y`. -/
def bf (G : Matrix ι ι K) (x y : ι → K) : K := x ⬝ᵥ G *ᵥ y

/-- Orthogonal complement `U^⊥ = {y | ∀ x ∈ U, xᵀ G y = 0}`. -/
def orth (G : Matrix ι ι K) (U : Submodule K (ι → K)) : Submodule K (ι → K) :=
  (Matrix.toBilin' G).orthogonal U

/-- `U` is nondegenerate for `G`. -/
def NondegOn (G : Matrix ι ι K) (U : Submodule K (ι → K)) : Prop :=
  ∀ x ∈ U, (∀ y ∈ U, bf G x y = 0) → x = 0

lemma bf_eq_toBilin' (G : Matrix ι ι K) (x y : ι → K) : bf G x y = Matrix.toBilin' G x y := by
  rw [Matrix.toBilin'_apply']; rfl

lemma mem_orth {G : Matrix ι ι K} {U : Submodule K (ι → K)} {y : ι → K} :
    y ∈ orth G U ↔ ∀ x ∈ U, bf G x y = 0 := by
  simp only [orth, LinearMap.BilinForm.mem_orthogonal_iff, bf_eq_toBilin']

lemma bf_symm {G : Matrix ι ι K} (hG : G.IsSymm) (x y : ι → K) : bf G x y = bf G y x := by
  unfold bf
  rw [Matrix.dotProduct_mulVec, dotProduct_comm, ← Matrix.mulVec_transpose, hG.eq]

lemma bf_sub_right (G : Matrix ι ι K) (x y y' : ι → K) : bf G x (y - y') = bf G x y - bf G x y' := by
  simp [bf, mulVec_sub, dotProduct_sub]
lemma bf_smul_left (G : Matrix ι ι K) (c : K) (x y : ι → K) : bf G (c • x) y = c * bf G x y := by
  simp [bf, smul_dotProduct]

theorem isCompl_orth {G : Matrix ι ι K} (hG : G.IsSymm) {U : Submodule K (ι → K)}
    (hU : NondegOn G U) : IsCompl U (orth G U) := by
  apply LinearMap.BilinForm.isCompl_orthogonal_of_restrict_nondegenerate
  · intro x y h
    rw [← bf_eq_toBilin'] at h ⊢
    rw [bf_symm hG]; exact h
  · constructor
    · intro x hx
      have := hU x.1 x.2 (fun y hy => by
        have := hx ⟨y, hy⟩
        simpa [LinearMap.BilinForm.restrict_apply, ← bf_eq_toBilin'] using this)
      exact Subtype.ext this
    · intro x hx
      have := hU x.1 x.2 (fun y hy => by
        have := hx ⟨y, hy⟩
        rw [bf_symm hG]
        simpa [LinearMap.BilinForm.restrict_apply, ← bf_eq_toBilin'] using this)
      exact Subtype.ext this

/-- The projection matrix onto `U` along `U^⊥` (zero if `U ⊕ U^⊥ ≠ F`). -/
noncomputable def proj (G : Matrix ι ι K) (U : Submodule K (ι → K)) : Matrix ι ι K := by
  classical
  exact if h : IsCompl U (orth G U) then LinearMap.toMatrix' (U.projection (orth G U) h) else 0

lemma proj_mulVec_of_isCompl {G : Matrix ι ι K} {U : Submodule K (ι → K)}
    (h : IsCompl U (orth G U)) (x : ι → K) :
    proj G U *ᵥ x = U.projection (orth G U) h x := by
  unfold proj
  rw [dif_pos h, LinearMap.toMatrix'_mulVec]

section proj
variable {G : Matrix ι ι K} (hG : G.IsSymm) {U : Submodule K (ι → K)} (hU : NondegOn G U)
include hG hU

theorem proj_mulVec_mem (x : ι → K) : proj G U *ᵥ x ∈ U := by
  rw [proj_mulVec_of_isCompl (isCompl_orth hG hU)]
  exact Submodule.projection_apply_mem _ _

theorem sub_proj_mulVec_mem (x : ι → K) : x - proj G U *ᵥ x ∈ orth G U := by
  have h := isCompl_orth hG hU
  rw [proj_mulVec_of_isCompl h]
  have := Submodule.projection_add_projection_eq_self h x
  rw [← eq_sub_of_add_eq' this]
  exact Submodule.projection_apply_mem _ _

theorem proj_mulVec_of_mem {x : ι → K} (hx : x ∈ U) : proj G U *ᵥ x = x := by
  rw [proj_mulVec_of_isCompl (isCompl_orth hG hU)]
  exact Submodule.projection_apply_of_mem_left _ hx

/-- Uniqueness of the projection. -/
theorem proj_unique (P : Matrix ι ι K) (h1 : ∀ x, P *ᵥ x ∈ U)
    (h2 : ∀ x, x - P *ᵥ x ∈ orth G U) : P = proj G U := by
  have hc := isCompl_orth hG hU
  apply Matrix.toLin'.injective
  apply LinearMap.ext
  intro x
  simp only [Matrix.toLin'_apply]
  have hmem : P *ᵥ x - proj G U *ᵥ x ∈ U ⊓ orth G U := by
    refine ⟨U.sub_mem (h1 x) (proj_mulVec_mem hG hU x), ?_⟩
    have := (orth G U).sub_mem (sub_proj_mulVec_mem hG hU x) (h2 x)
    simpa using this
  rw [hc.inf_eq_bot, Submodule.mem_bot, sub_eq_zero] at hmem
  exact hmem

end proj

section diff
variable {G : Matrix ι ι K} (hG : G.IsSymm)
include hG

variable {U V : Submodule K (ι → K)} (hU : NondegOn G U) (hV : NondegOn G V) (hUV : U ≤ V)
include hU hV hUV

theorem sub_proj_mem_diff (v : ι → K) (hv : v ∈ V) : v - proj G U *ᵥ v ∈ V ⊓ orth G U :=
  ⟨V.sub_mem hv (hUV (proj_mulVec_mem hG hU v)), sub_proj_mulVec_mem hG hU v⟩

theorem nondeg_diff : NondegOn G (V ⊓ orth G U) := by
  intro w hw hww
  apply hV w hw.1
  intro v hv
  have h1 := hww _ (sub_proj_mem_diff hG hU hV hUV v hv)
  have h2 : bf G w (proj G U *ᵥ v) = 0 := by
    rw [bf_symm hG]; exact (mem_orth.1 hw.2) _ (proj_mulVec_mem hG hU v)
  rw [bf_sub_right, h2, sub_zero] at h1
  exact h1

/-- `P_V − P_U` is the projection onto `V ∩ U^⊥` along its orthogonal complement. -/
theorem proj_sub_proj : proj G V - proj G U = proj G (V ⊓ orth G U) := by
  apply proj_unique hG (nondeg_diff hG hU hV hUV)
  · intro x
    rw [Matrix.sub_mulVec]
    refine ⟨V.sub_mem (proj_mulVec_mem hG hV x) (hUV (proj_mulVec_mem hG hU x)), ?_⟩
    show _ ∈ orth G U
    rw [mem_orth]
    intro u hu
    have e1 := (mem_orth.1 (sub_proj_mulVec_mem hG hU x)) u hu
    have e2 := (mem_orth.1 (sub_proj_mulVec_mem hG hV x)) u (hUV hu)
    rw [bf_sub_right] at e1 e2 ⊢
    linear_combination e1 - e2
  · intro x
    rw [mem_orth]
    intro w hw
    have e1 := (mem_orth.1 (sub_proj_mulVec_mem hG hV x)) w hw.1
    have e2 : bf G w (proj G U *ᵥ x) = 0 := by
      rw [bf_symm hG]; exact (mem_orth.1 hw.2) _ (proj_mulVec_mem hG hU x)
    rw [Matrix.sub_mulVec, bf_sub_right, bf_sub_right] at *
    linear_combination e1 + e2

theorem finrank_diff : finrank K ↥(V ⊓ orth G U) + finrank K U = finrank K V := by
  have hsup : U ⊔ (V ⊓ orth G U) = V := by
    apply le_antisymm (sup_le hUV inf_le_left)
    intro v hv
    have := Submodule.add_mem_sup (proj_mulVec_mem hG hU v) (sub_proj_mem_diff hG hU hV hUV v hv)
    simpa using this
  have hinf : U ⊓ (V ⊓ orth G U) = ⊥ := by
    have := (isCompl_orth hG hU).inf_eq_bot
    exact eq_bot_iff.2 (fun x hx => by
      rw [← this]; exact ⟨hx.1, hx.2.2⟩)
  have := Submodule.finrank_sup_add_finrank_inf_eq U (V ⊓ orth G U)
  rw [hsup, hinf, finrank_bot] at this
  omega

end diff

section source
variable {G : Matrix ι ι K} (hG : G.IsSymm) {U : Submodule K (ι → K)} (hU : NondegOn G U)
include hG hU

theorem nondeg_orth (hdet : G.det ≠ 0) : NondegOn G (orth G U) := by
  intro w hw hww
  have hall : ∀ y, bf G w y = 0 := by
    intro y
    have e1 := hww _ (sub_proj_mulVec_mem hG hU y)
    have e2 : bf G w (proj G U *ᵥ y) = 0 := by
      rw [bf_symm hG]; exact (mem_orth.1 hw) _ (proj_mulVec_mem hG hU y)
    rw [bf_sub_right, e2, sub_zero] at e1
    exact e1
  have hGw : G *ᵥ w = 0 := by
    funext i
    have := hall (Pi.single i 1)
    rw [bf_symm hG, bf, single_dotProduct, one_mul] at this
    exact this
  by_contra hne
  exact hdet (Matrix.exists_mulVec_eq_zero_iff.1 ⟨w, hne, hGw⟩)

/-- `P_{U^⊥} = 1 − P_U`. -/
theorem proj_orth (hdet : G.det ≠ 0) : proj G (orth G U) = 1 - proj G U := by
  symm
  apply proj_unique hG (nondeg_orth hG hU hdet)
  · intro x
    rw [Matrix.sub_mulVec, Matrix.one_mulVec]
    exact sub_proj_mulVec_mem hG hU x
  · intro x
    rw [Matrix.sub_mulVec, Matrix.one_mulVec, sub_sub_cancel, mem_orth]
    intro y hy
    rw [bf_symm hG]; exact (mem_orth.1 hy) _ (proj_mulVec_mem hG hU x)

end source

