set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

lemma AB_chunkB (P : ℕ) {A : ℤ} {di gi gam dd : List ℤ} :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI), chunkOK P A di gi gam dd ds z →
      AB A (chunkB P di gi gam dd ds z)
  | [], z, _ => by intro w hw; simp [chunkB] at hw
  | (n, am, ap) :: ds, z, ⟨h1, h2⟩ => by
    intro w hw
    simp only [chunkB, List.mem_append] at hw
    rcases hw with hw | hw
    · exact h1.2.2.2.2.2.2.2 w hw
    · exact AB_chunkB P ds (z.drop n) h2 w hw

end J6Seg.KR

