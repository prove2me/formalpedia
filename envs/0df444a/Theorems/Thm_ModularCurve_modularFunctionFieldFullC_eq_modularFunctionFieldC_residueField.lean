theorem ModularCurve.modularFunctionFieldFullC_eq_modularFunctionFieldC_residueField
    (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime] (hℓN : ¬ ℓ ∣ N)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ)
    [CharP (ResidueField ↥A) ℓ] [IsAlgClosed (ResidueField ↥A)] :
    modularFunctionFieldFullC (ResidueField ↥A) N = modularFunctionFieldC (ResidueField ↥A) N := by sorry
