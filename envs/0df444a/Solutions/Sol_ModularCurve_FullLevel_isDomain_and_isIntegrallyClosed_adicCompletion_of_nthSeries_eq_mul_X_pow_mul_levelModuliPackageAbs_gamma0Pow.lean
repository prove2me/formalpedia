    intro h
    apply IsDiscreteValuationRing.not_a_field W₀
    rw [hW₀, h, Ideal.span_singleton_eq_bot]
  apply hq0
  have h4 := congrArg (PowerSeries.constantCoeff : PowerSeries W₀ →+* W₀) h3
  rwa [map_natCast, map_natCast, map_zero] at h4

