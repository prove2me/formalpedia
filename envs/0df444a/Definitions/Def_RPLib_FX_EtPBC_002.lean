/-- Generic `Epi` instances, stated over an abstract abelian category (instance search for `Epi` of a concrete map of
etale sheaves gets stuck on a universe constraint). -/
theorem epi_cokπ {C : Type*} [Category C] [Abelian C] {A B : C} (f : A ⟶ B) : Epi (cokernel.π f) := inferInstance

theorem epi_fti {C : Type*} [Category C] [Abelian C] {A B : C} (f : A ⟶ B) : Epi (Abelian.factorThruImage f) :=
  inferInstance

/-- **`biprod.lift a b` is mono if on every stalk `a` or `b` is.** -/
theorem mono_lift_of_stalk {F A B : EtSh Λ P} (a : F ⟶ A) (b : F ⟶ B)
    (h : ∀ x : P, Mono (((geomPtAt x).stalkF Λ).map a) ∨ Mono (((geomPtAt x).stalkF Λ).map b)) :
    Mono (biprod.lift a b) := by
  refine (mono_iff_stalk Λ _).2 fun x => ?_
  rcases h x with h1 | h1
  · have e : ((geomPtAt x).stalkF Λ).map (biprod.lift a b) ≫ ((geomPtAt x).stalkF Λ).map biprod.fst =
        ((geomPtAt x).stalkF Λ).map a := by
      rw [← CategoryTheory.Functor.map_comp, biprod.lift_fst]
    exact mono_of_mono_fac e
  · have e : ((geomPtAt x).stalkF Λ).map (biprod.lift a b) ≫ ((geomPtAt x).stalkF Λ).map biprod.snd =
        ((geomPtAt x).stalkF Λ).map b := by
      rw [← CategoryTheory.Functor.map_comp, biprod.lift_snd]
    exact mono_of_mono_fac e

