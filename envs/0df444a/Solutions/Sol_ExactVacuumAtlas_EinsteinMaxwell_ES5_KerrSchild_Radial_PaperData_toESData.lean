variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}
theorem solution (hP : PaperData I f m N w p a) :
    ESData I f (Dfun f m N) (Afun f m) (Hfun m N) w p a where
  isOpen := hP.isOpen
  cB := hP.cf
  cD := hP.cm.div ((contDiffOn_const.mul hP.cf).mul hP.cN) fun _ hr => hP.n4fN hr
  cA := hP.cm.div hP.cf hP.nf
  cH := hP.cN.div hP.cm hP.nm
  cW := hP.cw
  cΦ := hP.cp
  cΨ := hP.ca
  nB := hP.nf
  nD := fun r hr => div_ne_zero (hP.nm r hr) (hP.n4fN hr)
  nA := fun r hr => div_ne_zero (hP.nm r hr) (hP.nf r hr)
  nH := fun r hr => div_ne_zero (hP.nN r hr) (hP.nm r hr)
