noncomputable def sourceMixer : SourceSU2 := by
  let c : ℝ := Real.sqrt (1/2)
  have hc : (c : ℂ)^2=(1/2 : ℂ) := by
    have hs : c^2=(1/2 : ℝ) := Real.sq_sqrt (by norm_num)
    have h := congrArg Complex.ofReal hs
    push_cast at h
