      [if B ≤ 2 * (d + bcar B l c) then d + bcar B l c - B else d + bcar B l c] := by
  rw [balConv_append]; simp only [balConv]; split_ifs <;> rfl

theorem bcar_snoc (B : ℤ) (l : List ℤ) (d c : ℤ) :
    bcar B (l ++ [d]) c = if B ≤ 2 * (d + bcar B l c) then 1 else 0 := by
  rw [bcar_append]; rfl

theorem bcar_01 (B : ℤ) : ∀ (l : List ℤ) (c : ℤ), (c = 0 ∨ c = 1) → (bcar B l c = 0 ∨ bcar B l c = 1)
  | [], _, h => h
  | d :: l, c, _ => bcar_01 B l _ (by split_ifs <;> simp)

theorem length_kunpack (B : ℤ) : ∀ (n : ℕ) (W : ℤ), (kunpack B n W).length = n
  | 0, _ => rfl
  | n + 1, W => by simp [kunpack, length_kunpack B n]

theorem decX_nonneg (N z : ℤ) (hN : 0 ≤ N) (hz : 0 ≤ z) : 0 ≤ decX N z := by
  unfold decX; split_ifs <;> omega

theorem balMod_dvd (N z : ℤ) (hz : 0 ≤ z) (hzF : z < N + 1) :
    N ∣ balMod (N + 1) z - decX N z := by
  unfold balMod decX
  rw [Int.emod_eq_of_lt hz hzF]
  by_cases h : N + 1 < 2 * z
  · rw [if_pos h, if_pos (by omega)]; exact ⟨-1, by ring⟩
  · rw [if_neg h, if_neg (by omega)]; exact ⟨0, by ring⟩

theorem kunpack_decX (P r : ℕ) (hP : 1 ≤ P) (z : ℤ) (hz : 0 ≤ z) (hzF : z < 2 ^ (4 * r * P) + 1) :
    kunpack (2 ^ P) (4 * r) (balMod (2 ^ (4 * r * P) + 1) z) =
      balConv (2 ^ P) (chunksL P (4 * r) (decX (2 ^ (4 * r * P)) z).toNat) 0 := by
  rw [← stdDigits_eq_chunksL, Int.toNat_of_nonneg (decX_nonneg _ _ (by positivity) hz)]
  have h2 : (2 : ℤ) ≤ 2 ^ P := by
    calc (2 : ℤ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ P := pow_le_pow_right₀ (by norm_num) hP
  apply kunpack_eq_balConv _ h2 ⟨2 ^ (P - 1), by rw [← pow_succ']; congr 1; omega⟩ _ _ _ _
    (Or.inl rfl)
  rw [add_zero, ← pow_mul, show P * (4 * r) = 4 * r * P by ring]
  exact balMod_dvd _ z hz hzF

theorem kunpack_quarters (l : List ℤ) (r : ℕ) :
    l.reverse = (l.drop (3 * r)).reverse ++ ((l.drop (2 * r)).take r).reverse ++
      ((l.drop r).take r).reverse ++ (l.take r).reverse := by
  have h1 := List.take_append_drop r l
  have h2 := List.take_append_drop r (l.drop r)
  have h3 := List.take_append_drop r (l.drop (2 * r))
  have d1 : (l.drop r).drop r = l.drop (2 * r) := by rw [List.drop_drop]; congr 1; omega
  have d2 : (l.drop (2 * r)).drop r = l.drop (3 * r) := by rw [List.drop_drop]; congr 1; omega
  rw [d1] at h2; rw [d2] at h3
  conv_lhs => rw [← h1, ← h2, ← h3]
  simp only [List.reverse_append, List.append_assoc]

theorem balPass_states (s : IState HS) (B : ℤ) (dl : List ℤ) (RE LB : List Item)
    (hE : s.G KE = ints dl ++ RE) (hB : s.G KB = .int B :: LB) (hn : fourR.eval s = dl.length) :
    RepStates KC fourR balBody (s.upd KY (.int 0 :: s.G KY)) (balSt s B dl RE) where
  nonneg := by
    have : fourR.eval (s.upd KY (.int 0 :: s.G KY)) = fourR.eval s := by
      simp +decide [fourR, Ex.eval, IState.top, IState.upd_G]
    rw [this, hn]; omega
  hw := by decide
  h0 := by
    simp only [balSt, List.drop_zero, List.take_zero, balConv, bcar, List.reverse_nil, ints_nil,
      List.nil_append]
    rw [← hE]; simp
  hG := fun k => by simp +decide [balSt, IState.upd_G]
  step := fun k hk => by
    have hn' : fourR.eval (s.upd KY (.int 0 :: s.G KY)) = fourR.eval s := by
      simp +decide [fourR, Ex.eval, IState.top, IState.upd_G]
    rw [hn', hn] at hk ⊢
    have hk' : k < dl.length := by simpa using hk
    obtain ⟨d, rest, hd⟩ : ∃ d rest, dl.drop k = d :: rest :=
      ⟨_, _, List.drop_eq_getElem_cons hk'⟩
    have hd2 : dl.drop (k + 1) = rest := by rw [← List.drop_drop, hd]; rfl
    have ht : dl.take (k + 1) = dl.take k ++ [d] := by
      rw [List.take_add_one, List.getElem?_eq_getElem hk']
      have : dl[k] = d := by
        have := congrArg List.head? hd
        rw [List.head?_drop, List.getElem?_eq_getElem hk'] at this
        simpa using this
      simp [this]
    simp only [balSt]
    rw [ht, balConv_snoc, bcar_snoc]
    generalize bcar B (dl.take k) 0 = c
    have hcond : (B + -(d + c + (d + c)) + -1 < 0) ↔ B ≤ 2 * (d + c) := by omega
    simp only [balBody, RS.seqL, RS.run, withCtr, balT, balCnd]
    apply IState.ext' <;> intros <;>
      simp (config := {decide := true}) only [IState.upd_G, IState.upd_ip, IState.upd_out,
        Ex.eval, IState.top, hd, hd2, hB, ints_cons, List.cons_append, List.reverse_append,
        List.reverse_cons, List.reverse_nil, List.nil_append, List.singleton_append,
        List.tail_cons, if_true, if_false, hcond, ints_append] <;>
      split_ifs <;> simp_all +decide [ints, sub_eq_add_neg]

theorem balPass_run (s : IState HS) (B : ℤ) (dl : List ℤ) (RE LB : List Item)
    (hE : s.G KE = ints dl ++ RE) (hB : s.G KB = .int B :: LB) (hn : fourR.eval s = dl.length) :
    balPass.run s = (s.upd KE RE).upd KG (ints (balConv B dl 0).reverse ++ s.G KG) := by
  have h := (balPass_states s B dl RE LB hE hB hn).run
  have hn' : fourR.eval (s.upd KY (.int 0 :: s.G KY)) = fourR.eval s := by
    simp +decide [fourR, Ex.eval, IState.top, IState.upd_G]
  simp only [balPass, RS.seqL, RS.run_seq] at h ⊢
  rw [show (RS.push KY (.lit 0)).run s = s.upd KY (.int 0 :: s.G KY) by simp [RS.run, Ex.eval], h,
    hn', hn]
  simp only [Int.toNat_natCast, balSt, List.drop_length, List.take_length, ints_nil,
    List.nil_append, RS.run]
  apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out]
  split_ifs <;> simp_all +decide

theorem drop_getD_cons (l : List ℤ) (k : ℕ) (hk : k < l.length) :
    l.drop k = l.getD k 0 :: l.drop (k + 1) := by
  rw [List.drop_eq_getElem_cons hk, List.getD_eq_getElem _ _ hk]

theorem foldPass_states (s : IState HS) (r : ℕ) (q₁ q₂ q₃ q₄ : List ℤ) (R₁ R₂ R₃ R₄ LR : List Item)
    (h1 : s.G KQ1 = ints q₁ ++ R₁) (h2 : s.G KQ2 = ints q₂ ++ R₂) (h3 : s.G KQ3 = ints q₃ ++ R₃)
    (h4 : s.G KQ4 = ints q₄ ++ R₄) (hR : s.G KR = .int r :: LR) (l1 : q₁.length = r)
    (l2 : q₂.length = r) (l3 : q₃.length = r) (l4 : q₄.length = r) :
    RepStates KC (.reg KR) foldBody s (foldSt s q₁ q₂ q₃ q₄ R₁ R₂ R₃ R₄) where
  nonneg := by simp [Ex.eval, IState.top, hR]
  hw := by decide
  h0 := by
    simp only [foldSt, List.drop_zero, List.range_zero, List.map_nil, List.reverse_nil, gints_nil,
      List.nil_append]
    rw [← h1, ← h2, ← h3, ← h4]; simp
  hG := fun k => by simp +decide [foldSt, IState.upd_G]
  step := fun k hk => by
    have hk' : k < r := by simpa [Ex.eval, IState.top, hR] using hk
    simp only [foldSt]
    rw [drop_getD_cons q₁ k (by omega), drop_getD_cons q₂ k (by omega),
      drop_getD_cons q₃ k (by omega), drop_getD_cons q₄ k (by omega), List.range_succ,
      List.map_append, List.reverse_append]
    simp only [foldBody, RS.seqL, RS.run, withCtr]
    apply IState.ext' <;> intros <;>
      simp (config := {decide := true}) only [IState.upd_G, IState.upd_ip, IState.upd_out,
        Ex.eval, IState.top, ints_cons, List.cons_append, List.map_cons, List.map_nil,
        List.reverse_cons, List.reverse_nil, List.nil_append, List.singleton_append,
        List.tail_cons, if_true, if_false, gints_cons, foldF] <;>
      split_ifs <;> simp_all +decide [ints]

