-- Source module: Solutions.J6SegILSrc18
/-!
# B-line IL, source-table producers, part 18: the tear-down

`dnCore Cm`: pop `rNB = 37`, `rM = 39`, `rTOT = 40`, pop `2 |cs|` entries of `rC = 45` (loop on
`rNC = 38`, counter `Cm`), pop `38`. `dn0 Cm = dnCore Cm`; `dn7 Cm` also pops `rK1 = 41`, `rK2 = 42`.
From `regOut F cs pre post n' K1 K2` (with empty registers in `F`) back to `F`
(`dn0_sp`, `dn7_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (flatC)

theorem flatC_drop (cs : List (ℤ × ℤ)) {k : ℕ} (hk : k < cs.length) :
    flatC (cs.drop k) = (cs[k]).1 :: (cs[k]).2 :: flatC (cs.drop (k + 1)) := by
  rw [List.drop_eq_getElem_cons hk]; rfl

set_option maxHeartbeats 2000000 in
theorem dnCore_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {Cm : Fin HS} (hC5 : Cm.val < 56)
    (hCm : Cm ≠ 37 ∧ Cm ≠ 38 ∧ Cm ≠ 39 ∧ Cm ≠ 40 ∧ Cm ≠ 41 ∧ Cm ≠ 42 ∧ Cm ≠ 45) (hFC : F Cm = [])
    (h37 : F 37 = []) (h38 : F 38 = []) (h39 : F 39 = []) (h40 : F 40 = []) (h45 : F 45 = [])
    (cs : List (ℤ × ℤ)) (pre post n' : ℕ) (K1 K2 : List ℤ) {A : ℕ}
    (hcs : ∀ y ∈ flatC cs, |y| ≤ 2 ^ A) (hm : cs.length ≤ 2 ^ A) (hpre : pre ≤ 2 ^ A)
    (hpost : 2 * post ≤ 2 ^ A) (htot : pre * (n' * (2 * post)) ≤ 2 ^ A) :
    Sp (dnCore Cm) (encK s0 (regOut F cs pre post n' K1 K2))
      (encK s0 (update (update F 41 (K1 ++ F 41)) 42 (K2 ++ F 42))) (dnC A cs.length) := by
  obtain ⟨c37, c38, c39, c40, c41, c42, c45⟩ := hCm
  set G := regOut F cs pre post n' K1 K2 with hG
  have k1 := popP s0 G (i := 37) (l := F 37) (D := DD) (by decide) (by simp [hG, regOut, update_apply])
    (abs_nat_le hpre) (by decide)
  have k2 := popP s0 (update G 37 (F 37)) (i := 39) (l := F 39) (D := DD) (by decide)
    (by simp [hG, regOut, update_apply]) (abs_nat_le hpost) (by decide)
  have k3 := popP s0 (update (update G 37 (F 37)) 39 (F 39)) (i := 40) (l := F 40) (D := DD) (by decide)
    (by simp [hG, regOut, update_apply]) (abs_nat_le htot) (by decide)
  set G3 := update (update (update G 37 (F 37)) 39 (F 39)) 40 (F 40) with hG3
  let S : ℕ → Fin HS → List ℤ := fun k => update G3 45 (flatC (cs.drop k))
  have hS0 : S 0 = G3 := by
    simp only [S, List.drop_zero]
    funext j
    by_cases hj : j = 45
    · subst hj; simp [hG3, hG, regOut, update_apply, h45]
    · rw [update_of_ne hj]
  have hSC : ∀ k, S k Cm = [] := fun k => by
    simp [S, hG3, hG, regOut, update_apply, c37, c38, c39, c40, c41, c42, c45, hFC]
  have hS38 : S 0 38 = (cs.length : ℤ) :: F 38 := by
    simp [S, hG3, hG, regOut, update_apply]
  have HL := repP (C := Cm) (i := 38) (b := .seq (.pop 45) (.pop 45)) (s0 := s0) (F := S)
    (N := cs.length) (A := A) (D := DD) (c := 2 * uC A DD) hC5 hSC
    (by simp [RS.writes]; exact c45) (by decide) hS38 hm (by decide)
    (fun k hk => by
      have hq : update (S k) Cm [(cs.length : ℤ) - k] 45 =
          (cs[k]).1 :: ((cs[k]).2 :: flatC (cs.drop (k + 1))) := by
        simp only [S]; rw [update_of_ne (Ne.symm c45), update_self, flatC_drop cs hk]
      have hy1 : |(cs[k]).1| ≤ 2 ^ A := hcs _ (by
        simp only [flatC, List.mem_flatMap]; exact ⟨cs[k], List.getElem_mem hk, by simp⟩)
      have hy2 : |(cs[k]).2| ≤ 2 ^ A := hcs _ (by
        simp only [flatC, List.mem_flatMap]; exact ⟨cs[k], List.getElem_mem hk, by simp⟩)
      have p1 := popP s0 _ (i := 45) (D := DD) (by decide) hq hy1 (by decide)
      have p2 := popP s0 (update (update (S k) Cm [(cs.length : ℤ) - k]) 45
        ((cs[k]).2 :: flatC (cs.drop (k + 1)))) (i := 45) (l := flatC (cs.drop (k + 1))) (D := DD)
        (by decide) (update_self ..) hy2 (by decide)
      rw [update_idem] at p2
      have e : update (update (S k) Cm [(cs.length : ℤ) - k]) 45 (flatC (cs.drop (k + 1))) =
          update (S (k + 1)) Cm [(cs.length : ℤ) - k] := by
        simp only [S]; rw [update_comm (Ne.symm c45), update_idem, update_comm c45]
      rw [e] at p2
      exact (p1.seq p2).mono (by omega))
  rw [hS0] at HL
  have q38 : S cs.length 38 = (cs.length : ℤ) :: F 38 := by
    simp [S, hG3, hG, regOut, update_apply]
  have k5 := popP s0 (S cs.length) (i := 38) (D := DD) (by decide) q38 (abs_nat_le hm) (by decide)
  have e : update (S cs.length) 38 (F 38) = update (update F 41 (K1 ++ F 41)) 42 (K2 ++ F 42) := by
    funext j
    by_cases j45 : j = 45
    · subst j45; simp [S, update_apply, h45]
    by_cases j38 : j = 38
    · subst j38; simp [S, update_apply]
    by_cases j37 : j = 37
    · subst j37; simp [S, hG3, update_apply]
    by_cases j39 : j = 39
    · subst j39; simp [S, hG3, update_apply]
    by_cases j40 : j = 40
    · subst j40; simp [S, hG3, update_apply]
    simp [S, hG3, hG, regOut, update_apply, j45, j38, j37, j39, j40]
  rw [e] at k5
  refine (k1.seq (k2.seq (k3.seq (HL.seq k5)))).mono (le_of_eq ?_)
  simp only [dnC]; ring

end J6Seg.Src

end

