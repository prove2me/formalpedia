-- title:
--   Lemma 3.5 — frozen-flow solvability and decoupling function
-- statement:
--   Let $\nu$ be a probability law with finite second moment on continuous $\mathbb R^d$-valued paths over $[0,T]$, and let $\mu_t$ be its time marginals. Under (A.1)–(A.7), the FBSDE (2.13) for $\mu$ has a unique solution $(X,Y,Z)$. There is a locally bounded measurable function $u^\nu$ and a constant $c>0$, depending only on the parameters of the assumptions, such that
--   $$\|u^\nu(t,x')-u^\nu(t,x)\|\le c\|x'-x\|,\qquad Y_t=u^\nu(t,X_t)\quad\text{almost surely for every }t\in[0,T].$$
--   This decoupling function underlies the matching map and the value function in Theorem 3.2.
--
--   **Formalization Note** Uniqueness means indistinguishability of $X,Y$ and equality of $Z$ almost everywhere in time and probability. The constant precedes the model coefficients and path law in the Lean quantifiers.
-- source:
--   Carmona and Delarue, Probabilistic analysis of mean-field games, SIAM J. Control Optim. 51 (2013), p. 2714, Lemma 3.5; https://doi.org/10.1137/120883499

import Mathlib
import Definitions.Def_ProbMFG_Existence_Model
import Definitions.Def_ProbMFG_Existence_Solution

open MeasureTheory
open scoped ENNReal NNReal

namespace ProbMFG.Existence

/-- Lemma 3.5: the frozen-flow FBSDE generated by a square-integrable
continuous-path law is uniquely solvable and has a measurable Lipschitz
decoupling function. The Lipschitz constant is uniform in the model and path law
for fixed dimension, horizon, λ, and c_L. -/
theorem lemma_3_5 {d m k : ℕ} (T : ℝ≥0) (lam cL : ℝ)
    (hlam : 0 < lam) (hcL : 0 < cL) :
    ∃ c : ℝ, 0 < c ∧ ∀ (M : Model d m k), M.T = T →
      M.Assumptions lam cL →
      ∀ {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
        (W : ℝ≥0 → Ω → Fin m → ℝ)
        (hW : Peng1990.SMP.IsStdBrownian P W)
        (ν : Measure M.Path) [IsProbabilityMeasure ν],
        (∫⁻ w, ⨆ t : {t : ℝ≥0 // t ≤ M.T}, ‖w t‖ₑ ^ 2 ∂ν) < ⊤ →
        ∃ (X Y : StateProcess Ω d) (Z : NoiseProcess Ω d m),
          M.SolvesFrozen P hW (M.marginalFlow ν) X Y Z ∧
          (∀ (X' Y' : StateProcess Ω d) (Z' : NoiseProcess Ω d m),
            M.SolvesFrozen P hW (M.marginalFlow ν) X' Y' Z' →
            (∀ᵐ ω ∂P, ∀ t ≤ M.T, X t ω = X' t ω ∧ Y t ω = Y' t ω) ∧
            (∀ᵐ q ∂((volume.restrict (Set.Icc (0 : ℝ) M.T)).prod P),
              ∀ j : Fin m, Z j q.1.toNNReal q.2 = Z' j q.1.toNNReal q.2)) ∧
          ∃ u : ℝ≥0 → State d → State d,
            Measurable (fun q : {t : ℝ≥0 // t ≤ M.T} × State d => u q.1.1 q.2) ∧
            (∀ R : ℝ, 0 ≤ R → ∃ B : ℝ, 0 ≤ B ∧
              ∀ t ≤ M.T, ∀ x : State d, ‖x‖ ≤ R → ‖u t x‖ ≤ B) ∧
            (∀ t ≤ M.T, ∀ x x' : State d,
              ‖u t x' - u t x‖ ≤ c * ‖x' - x‖) ∧
            ∀ᵐ ω ∂P, ∀ t ≤ M.T, Y t ω = u t (X t ω) := by sorry

end ProbMFG.Existence
