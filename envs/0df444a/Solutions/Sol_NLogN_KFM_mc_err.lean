theorem bil_err {M : (ι → ℂ) → (ι → ℂ) → (κ → ℂ)} (hM : BilC M) (a a' b b' : ι → ℂ) :
    ‖M a' b' - M a b‖ ≤ ‖a' - a‖ * ‖b'‖ + ‖a‖ * ‖b' - b‖ := by
  rw [hM.sub]
  exact (norm_add_le _ _).trans (add_le_add (hM.le _ _) (hM.le _ _))

