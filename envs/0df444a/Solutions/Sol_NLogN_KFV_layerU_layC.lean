  funext x
  simp only [regF, Function.update_apply]
  split_ifs <;> subst_vars <;> simp_all

theorem Cl_updC {f : Fin HS → List ℤ} (h : Cl f) (v : List ℤ) : Cl (Function.update f yC v) :=
  ⟨⟨by simp +decide [h.scr.t], by simp +decide [h.scr.o], by simp +decide [h.scr.ur],
    by simp +decide [h.scr.ui], by simp +decide [h.scr.vr], by simp +decide [h.scr.vi],
    by simp +decide [h.scr.c]⟩, by simp +decide [h.a], by simp +decide [h.g], by simp +decide [h.b],
    by simp +decide [h.b2], by simp +decide [h.b4], by simp +decide [h.rg], by simp +decide [h.rn],
    by simp +decide [h.rp], by simp +decide [h.p]⟩

theorem stT_rev (D S k : ℕ) (hk : k < D) : stT 1 D S 0 (D - 1 - k) = 2 ^ k * S := by
  unfold stT; rw [stS_eq 1 D S _ (by omega)]
  simp only [pow_zero, one_mul, pow_one]; congr 2; omega

theorem gK_eq (P D k : ℕ) (hk : k < D) : P * 2 ^ (D - 1) / 2 ^ k = P * 2 ^ (D - 1 - k) := by
  rw [show (2 : ℕ) ^ (D - 1) = 2 ^ (D - 1 - k) * 2 ^ k by rw [← pow_add]; congr 1; omega,
    ← mul_assoc, Nat.mul_div_cancel _ (by positivity)]

theorem grpG_rev (P D k : ℕ) (hk : k < D) : grpG P 1 0 (D - 1 - k) = P * 2 ^ (D - 1) / 2 ^ k := by
  rw [gK_eq P D k hk]; simp [grpG]

theorem PK_succ (A : Butterfly.M2) (D k : ℕ) (hk : k < D) :
    PK A D (k + 1) = Butterfly.tensF (Butterfly.kerAt (⟨D - 1 - k, by omega⟩ : Fin D) A) * PK A D k := by
  unfold PK
  rw [List.drop_eq_getElem_cons (by simp; omega)]
  simp only [List.map_cons, List.prod_cons, List.getElem_finRange]
  rw [show D - (k + 1) + 1 = D - k by omega]
  congr 3
  ext; simp; omega

theorem PK_full (A : Butterfly.M2) (D : ℕ) : PK A D D = (Butterfly.tens A : Butterfly.Op (Fin D)) := by
  unfold PK
  rw [Nat.sub_self, List.drop_zero]
  exact (Butterfly.tens_eq_prod_kerAt A _ (List.nodup_finRange D) (List.mem_finRange)).symm

/-- Semantics of the loop arrays. -/
theorem zsK_rep {P D S r : ℕ} {M : M2G} (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e)
    {F w : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (hx : RecRep r F zs xs)
    (hl : xs.length = vol (Butterfly.layerShape P 1 D S)) (hb : NLogN.KFB.GB w zs) :
    ∀ k ≤ D, RecRep r (F + e * k) (zsK M (S * r) (P * 2 ^ (D - 1)) zs k)
      (Butterfly.selOp (Butterfly.layerSel P 1 D S 0 Nat.zero_lt_one) (PK A D k) xs) ∧
      NLogN.KFB.GB (w + 2 * k) (zsK M (S * r) (P * 2 ^ (D - 1)) zs k)
  | 0, _ => by
    refine ⟨?_, by simpa [zsK] using hb⟩
    have : PK A D 0 = 1 := by simp [PK, List.drop_eq_nil_of_le]
    rw [this, Butterfly.selOp_one _ hl]; simpa [zsK] using hx
  | k + 1, hk => by
    obtain ⟨r1, b1⟩ := zsK_rep hM hA hx hl hb k (by omega)
    have H := ker_rep (P := P) (S := S) Nat.zero_lt_one (⟨D - 1 - k, by omega⟩ : Fin D) hA r1
      (by rw [Butterfly.length_selOp])
    rw [Butterfly.selOp_mul, ← PK_succ A D k (by omega)] at H
    simp only [stT_rev D S k (by omega), grpG_rev P D k (by omega)] at H
    refine ⟨?_, ?_⟩
    · simp only [zsK]; rw [show F + e * (k + 1) = F + e * k + e by ring, ← mul_assoc]; exact H
    · simp only [zsK]
      rw [show w + 2 * (k + 1) = w + 2 * k + 2 by ring]
      exact GB_qopL [M] (by simpa using hM) _ b1 _

theorem geomK (P D S r k : ℕ) (hk : k < D) :
    P * 2 ^ (D - 1) / 2 ^ k * (2 * (2 ^ k * (S * r)) * 1) = vol (Butterfly.layerShape P 1 D S) * r := by
  have h := grpG_mul (P := P) (S := S) (K := 1) (D := D) Nat.zero_lt_one (D - 1 - k) (by omega)
  rw [grpG_rev P D k hk, stT_rev D S k hk] at h
  rw [← h]; ring

/-- One loop step: a kernel pass and the register update. -/
theorem body_fsp (s : IState HS) (M : M2G) (hM : M.Ok) (B1 G w Z : ℕ) {LN : List Item}
    (g : Fin HS → List ℤ) (hsN : (NLogN.KIL.encK s g).G yN = .int ((2 * (G * (2 * B1 * [M].length)) : ℕ) : ℤ) :: LN)
    (zs : List GI) (l : List ℤ)
    (hlen : zs.length = G * (2 * B1 * [M].length))
    (h0 : g 0 = gflat zs ++ l) (hC : Cl g) (hb : NLogN.KFB.GB w zs)
    (hZ : zsz (((4 * (B1 + G + G * (2 * B1 * [M].length) + 0)) : ℕ) : ℤ) ≤ Z)
    (hB : zsz ((8 * B1 : ℕ) : ℤ) ≤ Z) (hG : zsz (G : ℤ) ≤ Z) (h2 : 2 ≤ Z) :
    FSp (.seq (kerCore M) kUpd) (NLogN.KIL.encK s (regF B1 G g))
      (NLogN.KIL.encK s (regF (2 * B1) (G / 2) (Function.update g 0 (gflat (qopL [M] B1 G zs) ++ l))))
      (400 * cQopW w B1 [M].length G 0 Z + 40000 * (Z + 2)) :=
  (kerCore_fsp s M hM B1 G w Z g hsN zs l hlen h0 hC hb hZ).seq (kUpd_fsp s B1 G Z _ hB hG h2)

/-- **The uniform kernel loop** implements `A^{⊗D}` on `[P] × [2]^D × [S]`. -/
theorem kersU_fsp {P D S r : ℕ} (hD : 1 ≤ D) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    {M : M2G} (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e)
    (s : IState HS) {LN LD : List Item} (f : Fin HS → List ℤ)
    (hsN : (NLogN.KIL.encK s f).G yN = .int ((2 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ) :: LN)
    (hsD : (NLogN.KIL.encK s f).G yD = .int (D : ℤ) :: LD) (hfC : f yC = [])
    (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ)) (F w : ℕ) (hx : RecRep r F zs xs)
    (hl : xs.length = vol (Butterfly.layerShape P 1 D S))
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ) ≤ Z) (h2 : 2 ≤ Z) :
    RecRep r (F + e * D) (zsK M (S * r) (P * 2 ^ (D - 1)) zs D)
      (Butterfly.selOp (Butterfly.layerSel P 1 D S 0 Nat.zero_lt_one) (Butterfly.tens A) xs) ∧
    NLogN.KFB.GB (w + 2 * D) (zsK M (S * r) (P * 2 ^ (D - 1)) zs D) ∧
    FSp (kersU M) (NLogN.KIL.encK s (regF (S * r) (P * 2 ^ (D - 1)) f))
      (NLogN.KIL.encK s (regF (2 ^ D * (S * r)) (P * 2 ^ (D - 1) / 2 ^ D)
        (Function.update f 0 (gflat (zsK M (S * r) (P * 2 ^ (D - 1)) zs D) ++ l))))
      (cKers D (vol (Butterfly.layerShape P 1 D S) * r) Z w) := by
  set N := vol (Butterfly.layerShape P 1 D S) * r with hN
  have SR := zsK_rep hM hA hx hl hb
  refine ⟨by simpa [PK_full] using (SR D le_rfl).1, (SR D le_rfl).2, ?_⟩
  set Fk : ℕ → Fin HS → List ℤ := fun k => regF (2 ^ k * (S * r)) (P * 2 ^ (D - 1) / 2 ^ k)
    (Function.update f 0 (gflat (zsK M (S * r) (P * 2 ^ (D - 1)) zs k) ++ l)) with hFk
  have e0 : regF (S * r) (P * 2 ^ (D - 1)) f = Fk 0 := by
    simp only [hFk, pow_zero, one_mul, Nat.div_one, zsK, ← h0, Function.update_eq_self]
  have hlenK : ∀ k ≤ D, (zsK M (S * r) (P * 2 ^ (D - 1)) zs k).length = N := by
    intro k hk; rw [(SR k hk).1.1, Butterfly.length_selOp]
  have zN : ∀ c : ℕ, c ≤ 12 * N → zsz (c : ℤ) ≤ Z := fun c hc => le_trans (zsz_natCast_le hc) hZ
  rw [e0]
  have hD0 : (NLogN.KIL.encK s (Fk 0)).G yD = .int (D : ℤ) :: LD := by
    rw [encK_G] at hsD ⊢
    rw [show Fk 0 yD = f yD by simp +decide [hFk, regF, Function.update_apply]]; exact hsD
  have R := FSp.rep (C := yC) (n := .reg yD) (b := .seq (kerCore M) kUpd) (s := s) (F := Fk) (N := D)
    (c := 400 * ck N Z (w + 2 * D) + 40000 * (Z + 2)) (by decide)
    (fun k => by simp +decide [hFk, regF, Function.update_apply, hfC]) (yC_not_writes M)
    (clean_reg (by decide))
    (IState.isInt_of hD0)
    (by simp only [Ex.eval]; rw [IState.top_eq hD0])
    (by
      intro k hk
      set X := gflat (zsK M (S * r) (P * 2 ^ (D - 1)) zs k) ++ l
      set g := Function.update (Function.update f 0 X) yC [(D : ℤ) - k]
      have hg : Function.update (Fk k) yC [(D : ℤ) - k] =
          regF (2 ^ k * (S * r)) (P * 2 ^ (D - 1) / 2 ^ k) g := by
        simp only [hFk]; exact regF_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
      have hg' : Function.update (Fk (k + 1)) yC [(D : ℤ) - k] =
          regF (2 * (2 ^ k * (S * r))) (P * 2 ^ (D - 1) / 2 ^ k / 2)
            (Function.update g 0 (gflat (qopL [M] (2 ^ k * (S * r)) (P * 2 ^ (D - 1) / 2 ^ k)
              (zsK M (S * r) (P * 2 ^ (D - 1)) zs k)) ++ l)) := by
        simp only [hFk]
        rw [regF_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)]
        have e1 : 2 ^ (k + 1) * (S * r) = 2 * (2 ^ k * (S * r)) := by ring
        have e2 : P * 2 ^ (D - 1) / 2 ^ (k + 1) = P * 2 ^ (D - 1) / 2 ^ k / 2 := by
          rw [Nat.div_div_eq_div_mul, pow_succ]
        rw [e1, e2]
        congr 1
        simp only [g, zsK]
        funext j
        by_cases a : j = 0
        · subst a; simp +decide [Function.update_apply]
        · simp [Function.update_apply, a]
      rw [hg, hg']
      have gl := geomK P D S r k hk
      rw [← hN] at gl
      have hB1 : 2 ^ k * (S * r) ≤ N := by
        rw [← gl]
        have : 1 ≤ P * 2 ^ (D - 1) / 2 ^ k := by
          rw [gK_eq P D k hk]; exact Nat.mul_pos hP (by positivity)
        nlinarith
      have hG1 : P * 2 ^ (D - 1) / 2 ^ k ≤ N := by
        rw [← gl]; have : 1 ≤ 2 ^ k * (S * r) := Nat.mul_pos (by positivity) (Nat.mul_pos hS hr)
        nlinarith
      have H := body_fsp s M hM (2 ^ k * (S * r)) (P * 2 ^ (D - 1) / 2 ^ k) (w + 2 * k) Z
        (LN := LN) g (by
          simp only [List.length_singleton]; rw [gl]
          rw [encK_G] at hsN ⊢
          rw [show g yN = f yN by simp +decide [g, Function.update_apply]]; exact hsN) (zsK M (S * r) (P * 2 ^ (D - 1)) zs k) l
        (by simp only [List.length_singleton]; rw [gl, hlenK k hk.le]) (by simp +decide [g, X])
        (Cl_updC (hC.upd0 _) _) (SR k hk.le).2
        (zN _ (by simp only [List.length_singleton]; rw [gl]; omega)) (zN _ (by omega))
        (zN _ (by omega)) h2
      refine H.mono ?_
      have c1 := cQopW_le_ck (P * 2 ^ (D - 1) / 2 ^ k) (2 ^ k * (S * r)) (w + 2 * k) Z
        (Nat.mul_pos (by positivity) (Nat.mul_pos hS hr))
      have c2 : 2 * (P * 2 ^ (D - 1) / 2 ^ k) * (2 ^ k * (S * r)) = N := by
        rw [← gl]; ring
      rw [c2] at c1
      have c3 := ck_mono (N := N) (Z := Z) (show w + 2 * k ≤ w + 2 * D by omega)
      simp only [List.length_singleton]
      omega)
  refine R.mono ?_
  unfold cKers
  have := cost_reg_le (NLogN.KIL.encK s (Fk 0)) yD
  rw [IState.top_eq hD0] at this
  omega

theorem kPush_fsp (s : IState HS) (f : Fin HS → List ℤ) (a b : Fin HS) (ha5 : a.val < 56)
    (hb5 : b.val < 56) (hna : a ∉ [NLogN.KFV.yB, yB2, yB4, yG]) (hnb : b ∉ [NLogN.KFV.yB, yB2, yB4, yG])
    {A G Bk : ℕ} {La Lb : List Item}
    (hA : (NLogN.KIL.encK s f).G a = .int (A : ℤ) :: La) (hG : (NLogN.KIL.encK s f).G b = .int (G : ℤ) :: Lb)
    (hK : KFree f) (hAB : zsz ((4 * A : ℕ) : ℤ) ≤ Bk) (hGB : zsz (G : ℤ) ≤ Bk) :
    FSp (kPush a b) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (regF A G f)) (24000 * (Bk + 2)) := by
  obtain ⟨k1, k2, k3, k4⟩ := hK
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hna hnb
  have z : ∀ c : ℕ, c ≤ 4 * A → zsz (c : ℤ) ≤ Bk := fun c hc => le_trans (zsz_natCast_le hc) hAB
  have S1 := Sp.push s f (i := NLogN.KFV.yB) (e := .reg a) (B := Bk) (by decide) (clean_reg ha5)
    (IState.isInt_of hA) trivial (by simp only [Ex.Bnd]; rw [IState.top_eq hA]; exact z A (by omega))
  rw [show Ex.eval (NLogN.KIL.encK s f) (.reg a) = (A : ℤ) by simp only [Ex.eval]; rw [IState.top_eq hA], k1] at S1
  set f1 := Function.update f NLogN.KFV.yB [(A : ℤ)]
  have t1 : (NLogN.KIL.encK s f1).top NLogN.KFV.yB = (A : ℤ) := top_encK (l := []) (by simp [f1])
  have S2 := Sp.push s f1 (i := yB2) (e := .add (.reg NLogN.KFV.yB) (.reg NLogN.KFV.yB)) (B := Bk) (by decide)
    (clean_add (clean_reg (by decide)) (clean_reg (by decide)))
    ⟨isInt_encK (l := []) (a := (A : ℤ)) (by simp [f1]), isInt_encK (l := []) (a := (A : ℤ)) (by simp [f1])⟩
    ⟨trivial, trivial⟩
    (by
      simp only [Ex.Bnd, Ex.eval, t1]
      refine ⟨z A (by omega), z A (by omega), ?_⟩
      have := z (2 * A) (by omega); push_cast at this ⊢; rwa [show (A : ℤ) + A = 2 * A by ring])
  simp only [Ex.eval, t1] at S2
  rw [show f1 yB2 = [] by simp +decide [f1, k2]] at S2
  set f2 := Function.update f1 yB2 [(A : ℤ) + A]
  have t2 : (NLogN.KIL.encK s f2).top yB2 = (A : ℤ) + A := top_encK (l := []) (by simp [f2])
  have S3 := Sp.push s f2 (i := yB4) (e := .add (.reg yB2) (.reg yB2)) (B := Bk) (by decide)
    (clean_add (clean_reg (by decide)) (clean_reg (by decide)))
    ⟨isInt_encK (l := []) (a := (A : ℤ) + A) (by simp [f2]),
      isInt_encK (l := []) (a := (A : ℤ) + A) (by simp [f2])⟩
    ⟨trivial, trivial⟩
    (by
      simp only [Ex.Bnd, Ex.eval, t2]
      have h2 := z (2 * A) (by omega); have h4 := z (4 * A) le_rfl
      push_cast at h2 h4 ⊢
      refine ⟨by rwa [show (A : ℤ) + A = 2 * A by ring], by rwa [show (A : ℤ) + A = 2 * A by ring], ?_⟩
      rwa [show (A : ℤ) + A + (A + A) = 4 * A by ring])
  simp only [Ex.eval, t2] at S3
  rw [show f2 yB4 = [] by simp +decide [f2, f1, k3]] at S3
  set f3 := Function.update f2 yB4 [(A : ℤ) + A + (A + A)]
  have hG3 : (NLogN.KIL.encK s f3).G b = .int (G : ℤ) :: Lb := by
    rw [encK_G] at hG ⊢
    rw [show f3 b = f b by simp [f3, f2, f1, Function.update_apply, hnb.1, hnb.2.1, hnb.2.2.1]]
    exact hG
  have S4 := Sp.push s f3 (i := yG) (e := .reg b) (B := Bk) (by decide) (clean_reg hb5)
    (IState.isInt_of hG3) trivial (by simp only [Ex.Bnd]; rw [IState.top_eq hG3]; exact hGB)
  rw [show Ex.eval (NLogN.KIL.encK s f3) (.reg b) = (G : ℤ) by simp only [Ex.eval]; rw [IState.top_eq hG3],
    show f3 yG = [] by simp +decide [f3, f2, f1, k4]] at S4
  have S := FSp.of_norep (p := kPush a b) rfl (S1.seq (S2.seq (S3.seq S4)))
  refine (S.congr ?_).mono ?_
  · congr 1
    funext j
    simp only [f3, f2, f1, regF, Function.update_apply]
    split_ifs <;> first | rfl | (push_cast; ring_nf)
  · simp only [Ex.size]; omega

theorem kPop_fsp (s : IState HS) (f : Fin HS → List ℤ) {A G Bk : ℕ} (hK : KFree f)
    (hAB : zsz ((4 * A : ℕ) : ℤ) ≤ Bk) (hGB : zsz (G : ℤ) ≤ Bk) :
    FSp kPop (NLogN.KIL.encK s (regF A G f)) (NLogN.KIL.encK s f) (4 * (2 * Bk + 2)) := by
  obtain ⟨k1, k2, k3, k4⟩ := hK
  have z : ∀ c : ℕ, c ≤ 4 * A → zsz (c : ℤ) ≤ Bk := fun c hc => le_trans (zsz_natCast_le hc) hAB
  have S1 := Sp.pop (s := s) (f := regF A G f) (i := yG) (a := (G : ℤ)) (l := []) (by decide)
    (by simp +decide [regF]) hGB
  have S2 := Sp.pop (s := s) (f := Function.update (regF A G f) yG []) (i := yB4)
    (a := ((4 * A : ℕ) : ℤ)) (l := []) (by decide) (by simp +decide [regF]) (z _ le_rfl)
  have S3 := Sp.pop (s := s) (f := Function.update (Function.update (regF A G f) yG []) yB4 [])
    (i := yB2) (a := ((2 * A : ℕ) : ℤ)) (l := []) (by decide) (by simp +decide [regF]) (z _ (by omega))
  have S4 := Sp.pop (s := s)
    (f := Function.update (Function.update (Function.update (regF A G f) yG []) yB4 []) yB2 [])
    (i := NLogN.KFV.yB) (a := (A : ℤ)) (l := []) (by decide) (by simp +decide [regF]) (z _ (by omega))
  have S := FSp.of_norep (p := kPop) rfl (S1.seq (S2.seq (S3.seq S4)))
  refine (S.congr ?_).mono (by omega)
  congr 1
  funext j
  simp only [regF, Function.update_apply]
  split_ifs <;> subst_vars <;> simp_all

theorem LRegs.congr {s : IState HS} {f g : Fin HS → List ℤ} {P D S r : ℕ} (h : NLogN.KFV.LRegs s f P D S r)
    (hg : ∀ j ∈ yIn, g j = f j) : NLogN.KFV.LRegs s g P D S r := by
  have e : ∀ j ∈ yIn, (NLogN.KIL.encK s g).G j = (NLogN.KIL.encK s f).G j := fun j hj => by
    rw [encK_G, encK_G, hg j hj]
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, ⟨L6, h6⟩, ⟨L7, h7⟩, ⟨L8, h8⟩⟩ := h
  exact ⟨⟨L1, by rw [e _ (by decide)]; exact h1⟩, ⟨L2, by rw [e _ (by decide)]; exact h2⟩,
    ⟨L3, by rw [e _ (by decide)]; exact h3⟩, ⟨L4, by rw [e _ (by decide)]; exact h4⟩,
    ⟨L5, by rw [e _ (by decide)]; exact h5⟩, ⟨L6, by rw [e _ (by decide)]; exact h6⟩,
    ⟨L7, by rw [e _ (by decide)]; exact h7⟩, ⟨L8, by rw [e _ (by decide)]; exact h8⟩⟩

theorem LRegs.upd0 {s : IState HS} {f : Fin HS → List ℤ} {P D S r : ℕ} (h : NLogN.KFV.LRegs s f P D S r)
    (v : List ℤ) : NLogN.KFV.LRegs s (Function.update f 0 v) P D S r :=
  h.congr fun j hj => by
    have : j ≠ 0 := by revert hj; revert j; decide
    simp [Function.update_apply, this]

theorem KFree.upd0 {f : Fin HS → List ℤ} (h : KFree f) (v : List ℤ) : KFree (Function.update f 0 v) := by
  obtain ⟨a, b, c, d⟩ := h; exact ⟨by simp +decide [a], by simp +decide [b], by simp +decide [c], by simp +decide [d]⟩

theorem LU.comp {P D S r : ℕ} {T U : Butterfly.Op (Fin D)} {c1 c2 : RS} {e1 e2 d1 d2 : ℕ}
    {k1 k2 : ℕ → ℕ} (h1 : LU P D S r T c1 e1 d1 k1) (h2 : LU P D S r U c2 e2 d2 k2) :
    LU P D S r (U * T) (.seq c1 c2) (e1 + e2) (d1 + d2) (fun w => k1 w + k2 (w + d1)) := by
  intro s f zs l xs F w hC hK hfC hR h0 hx hl hb
  obtain ⟨zs1, r1, b1, f1⟩ := h1 s f zs l xs F w hC hK hfC hR h0 hx hl hb
  obtain ⟨zs2, r2, b2, f2⟩ := h2 s (Function.update f 0 (gflat zs1 ++ l)) zs1 l _ (F + e1) (w + d1)
    (hC.upd0 _) (hK.upd0 _) (by simp +decide [hfC]) (hR.upd0 _) (by simp) r1
    (Butterfly.length_selOp _ _ _) b1
  refine ⟨zs2, ?_, ?_, ?_⟩
  · rw [← Butterfly.selOp_mul, ← add_assoc]; exact r2
  · rw [← add_assoc]; exact b2
  · have := f1.seq f2
    rwa [Function.update_idem] at this

theorem volN (P D S r : ℕ) (hD : 1 ≤ D) :
    vol (Butterfly.layerShape P 1 D S) * r = P * 2 ^ (D - 1) * (2 * (S * r)) := by
  rw [← geomK P D S r 0 (by omega)]; simp

theorem kLoop_lu {P D S r : ℕ} (hD : 1 ≤ D) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    {M : M2G} (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ) ≤ Z) (h2 : 2 ≤ Z) :
    LU P D S r (Butterfly.tens A) (kLoop M) (e * D) (2 * D)
      (fun w => 24000 * (Z + 2) + (cKers D (vol (Butterfly.layerShape P 1 D S) * r) Z w +
        4 * (2 * Z + 2))) := by
  intro s f zs l xs F w hC hK hfC hR h0 hx hl hb
  have hN := volN P D S r hD
  set N := vol (Butterfly.layerShape P 1 D S) * r
  have zN : ∀ c : ℕ, c ≤ 12 * N → zsz (c : ℤ) ≤ Z := fun c hc => le_trans (zsz_natCast_le hc) hZ
  obtain ⟨LQ, hQ⟩ := hR.q
  obtain ⟨LG, hG0⟩ := hR.g0
  obtain ⟨LN, hNr⟩ := hR.n
  obtain ⟨LD, hDr⟩ := hR.d
  have p1 : 1 ≤ P * 2 ^ (D - 1) := Nat.mul_pos hP (by positivity)
  have p2 : 1 ≤ S * r := Nat.mul_pos hS hr
  have e2 : 2 ^ D = 2 * 2 ^ (D - 1) := by rw [← pow_succ']; congr 1; omega
  have P1 := kPush_fsp s f yQ yG0 (by decide) (by decide) (by decide) (by decide) hQ hG0 hK
    (Bk := Z) (zN _ (by rw [hN]; nlinarith)) (zN _ (by rw [hN]; nlinarith))
  obtain ⟨r1, b1, K1⟩ := kersU_fsp hD hr hS hP hM hA s f hNr hDr hfC zs l xs F w hx hl h0 hC hb Z hZ h2
  have P2 := kPop_fsp s (Function.update f 0 (gflat (zsK M (S * r) (P * 2 ^ (D - 1)) zs D) ++ l))
    (A := 2 ^ D * (S * r)) (G := P * 2 ^ (D - 1) / 2 ^ D) (Bk := Z) (hK.upd0 _)
    (zN _ (by rw [hN, e2]; nlinarith))
    (zN _ (le_trans (Nat.div_le_self _ _) (by rw [hN]; nlinarith)))
  exact ⟨_, r1, b1, (P1.seq (K1.seq P2))⟩

theorem gD_mod (D : ℕ) : NLogN.KFH.gD (D % 8) = NLogN.KFH.gD D := by
  have h1 : D % 8 % 2 = D % 2 := by omega
  have h2 : 3 * (D % 8 / 2) % 4 = 3 * (D / 2) % 4 := by omega
  simp only [NLogN.KFH.gD, ipw, h1, h2]

theorem MD_mod (D : ℕ) : MD (D % 8) = MD D := by simp only [MD, gD_mod]

theorem MD_ok (D : ℕ) : (MD D).Ok := ⟨Sm_gD D, Sm_zero, Sm_zero, Sm_gD D⟩

theorem kerDU_lu {P D S r : ℕ} (hD : 1 ≤ D) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ) ≤ Z) :
    LU P D S r (Butterfly.tensF (Butterfly.kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : Butterfly.M2))))
      kerDU (D / 2 + D % 2) 2
      (kdU (vol (Butterfly.layerShape P 1 D S) * r) Z) := by
  intro s f zs l xs F w hC hK hfC hR h0 hx hl hb
  have hN := volN P D S r hD
  set N := vol (Butterfly.layerShape P 1 D S) * r
  have zN : ∀ c : ℕ, c ≤ 12 * N → zsz (c : ℤ) ≤ Z := fun c hc => le_trans (zsz_natCast_le hc) hZ
  obtain ⟨LQ, hQ⟩ := hR.qd
  obtain ⟨LP, hPr⟩ := hR.p
  obtain ⟨LN, hNr⟩ := hR.n
  obtain ⟨LM, hMr⟩ := hR.m
  have p1 : 1 ≤ 2 ^ (D - 1) := Nat.one_le_two_pow
  have p2 : 1 ≤ S * r := Nat.mul_pos hS hr
  set A := 2 ^ (D - 1) * (S * r)
  have hNA : N = P * (2 * A * [MD D].length) := by
    rw [hN]; simp only [A, List.length_singleton]; ring
  have hA1 : 1 ≤ A := Nat.mul_pos p1 p2
  have hAN : A ≤ N := by rw [hNA]; simp only [List.length_singleton, mul_one]; nlinarith
  have hPN : P ≤ N := by rw [hNA]; simp only [List.length_singleton, mul_one]; nlinarith
  have P1 := kPush_fsp s f yQD NLogN.KFV.yP (by decide) (by decide) (by decide) (by decide) hQ hPr hK
    (Bk := Z) (zN _ (by omega)) (zN _ (by omega))
  -- the semantic step
  have Hr := ker_rep (P := P) (S := S) Nat.zero_lt_one (⟨0, hD⟩ : Fin D) (kerOk_MD D) hx hl
  have st : stT 1 D S 0 0 * r = A := by
    have := stT_rev D S (D - 1) (by omega); rw [Nat.sub_self] at this; rw [this]; simp only [A]; ring
  have gg : grpG P 1 0 0 = P := by simp [grpG]
  rw [st, gg] at Hr
  have hlen : zs.length = P * (2 * A * [MD D].length) := by rw [hx.1, hl, ← hNA]
  have K1 := kerCore_fsp s (MD D) (NLogN.KFV.MD_ok D) A P w Z f
    (by rw [← hNA]; exact hNr) zs l hlen h0 hC hb (zN _ (by rw [← hNA]; omega))
  have hsel : (NLogN.KIL.encK s (regF A P f)).G NLogN.KFV.yM = .int ((D % 8 : ℕ) : ℤ) :: LM := by
    rw [encK_G] at hMr ⊢; rw [regF_other _ _ _ _ (by decide) (by decide) (by decide) (by decide)]
    exact hMr
  have S1 := FSp.sel (r := NLogN.KFV.yM) (by decide) (fun c => kerCore (MD c)) hsel (Bb := Z)
    (hb := by simp only [MD_mod]; exact K1)
    (fun x hx => zN _ (by have := Nat.mod_lt D (show 8 > 0 by omega); omega)) 8 0 (by omega)
    (by have := Nat.mod_lt D (show 8 > 0 by omega); omega)
  have P2 := kPop_fsp s (Function.update f 0 (gflat (qopL [MD D] A P zs) ++ l)) (A := A) (G := P)
    (Bk := Z) (hK.upd0 _) (zN _ (by omega)) (zN _ (by omega))
  refine ⟨_, Hr, GB_qopL [MD D] (by simpa using NLogN.KFV.MD_ok D) zs hb _, ?_⟩
  refine (P1.seq (S1.seq P2)).mono ?_
  have c1 := cQopW_le_ck P A w Z hA1
  rw [show 2 * P * A = N by rw [hNA]; simp; ring] at c1
  unfold kdU; simp only [List.length_singleton] at c1 ⊢; omega

theorem sub_truncU (Δ N : ℕ) : KFW.RS.sub (sgT Δ N) NLogN.KFV.truncU = truncP Δ N := by
  have h1 : KFW.RS.sub (sgT Δ N) (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg NLogN.KFB.rN)) = NLogN.mvK qO 0 NLogN.KFB.c1 (.reg NLogN.KFB.rN) := by
    apply KFW.RS.sub_id
    intro i hi
    simp only [sgT]
    split_ifs <;> first | rfl | (subst_vars; revert hi; decide)
  simp +decide only [NLogN.KFV.truncU, truncP, truncLoop, quoE, KFW.RS.sub, KFW.Ex.sub, h1, sgT, if_true, if_false]

theorem truncU_writes : ∀ i ∈ NLogN.KFV.truncU.writes, i ≠ yN ∧ i ≠ yW := by
  intro i hi
  revert hi; generalize i = y; revert y; decide

theorem truncU_fsp (s : IState HS) {r p Δ w : ℕ} (f : Fin HS → List ℤ) (zs : List GI)
    (xs : List (Fin r → ℂ)) (l : List ℤ) (hx : RecRep r (p + Δ) zs xs)
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz ((2 * zs.length : ℕ) : ℤ) ≤ Z) {L1 L2 : List Item}
    (hN : (NLogN.KIL.encK s f).G yN = .int ((2 * zs.length : ℕ) : ℤ) :: L1)
    (hW : (NLogN.KIL.encK s f).G NLogN.KFV.yW = .int ((2 ^ Δ : ℕ) : ℤ) :: L2) :
    RecRep r p (zs.map (gtr Δ)) (Butterfly.QpArr p xs) ∧ NLogN.KFB.GB w (zs.map (gtr Δ)) ∧
      FSp NLogN.KFV.truncU (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (gflat (zs.map (gtr Δ)) ++ l)))
        (400 * cTrunc w Δ (2 * zs.length) Z) := by
  obtain ⟨R1, R2, R3⟩ := truncP_rec s f zs xs l hx h0 hC hb Z hZ
  refine ⟨R1, R2, ?_⟩
  rw [← NLogN.KFV.sub_truncU] at R3
  refine KFW.FSp.of_sub ?_ ?_ ?_ R3
  · intro i hi
    simp only [sgT] at hi
    split_ifs at hi with a b <;> first | (subst_vars; decide) | simp at hi
  · intro i hi
    obtain ⟨a, b⟩ := truncU_writes i hi
    simp [sgT, a, b]
  · intro i v hv
    by_cases a : i = yN
    · subst a; simp [sgT] at hv; subst hv; exact ⟨L1, by simpa using hN⟩
    by_cases b : i = NLogN.KFV.yW
    · subst b; simp +decide [sgT] at hv; subst hv; exact ⟨L2, by simpa using hW⟩
    simp [sgT, a, b] at hv

theorem leafU_fsp {P D S r p w : ℕ} (hD : 1 ≤ D) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : RecRep r p zs xs) (hl : xs.length = vol (Butterfly.layerShape P 1 D S))
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hK : KFree f) (hfC : f yC = [])
    (hR : NLogN.KFV.LRegs s f P D S r) (hb : NLogN.KFB.GB w zs) :
    ∃ zs', RecRep r p zs' (Butterfly.QpArr p (Butterfly.layerH P 1 D S 0 Nat.zero_lt_one xs)) ∧
      NLogN.KFB.GB (w + 6 * D + 2) zs' ∧
      FSp leafU (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (gflat zs' ++ l)))
        (cLeafU D (vol (Butterfly.layerShape P 1 D S) * r)
          (zsz ((12 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ)) w) := by
  have hN := volN P D S r hD
  set N := vol (Butterfly.layerShape P 1 D S) * r with hN'
  set Z := zsz ((12 * N : ℕ) : ℤ)
  have hZ : zsz ((12 * N : ℕ) : ℤ) ≤ Z := le_rfl
  have hN1 : 1 ≤ N := by
    rw [hN]; exact Nat.mul_pos (Nat.mul_pos hP (by positivity)) (by have := Nat.mul_pos hS hr; omega)
  have h2 : 2 ≤ Z := by
    have : zsz ((2 : ℕ) : ℤ) ≤ Z := le_trans (zsz_natCast_le (by omega)) hZ
    rwa [show zsz ((2 : ℕ) : ℤ) = 2 by simpa using NLogN.zsz_two_pow 1] at this
  have L1 := kLoop_lu hD hr hS hP MS_ok kerOk_MS Z hZ h2
  have L2 := kLoop_lu hD hr hS hP MC_ok kerOk_MC Z hZ h2
  have L4 := kerDU_lu hD hr hS hP Z hZ
  have L := ((L1.comp L2).comp L1).comp L4
  obtain ⟨zs1, r1, b1, f1⟩ := L s f zs l xs p w hC hK hfC hR h0 hx hl hb
  have hT : Butterfly.tensF (Butterfly.kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : Butterfly.M2))) *
      (Butterfly.tens Butterfly.Sm * (Butterfly.tens Butterfly.Cm * Butterfly.tens Butterfly.Sm)) =
      (Butterfly.tens Butterfly.H0 : Butterfly.Op (Fin D)) := by
    rw [tensF_kerAt_smul_one, Butterfly.tens_H0, Butterfly.tens_Sm, Fintype.card_fin, smul_mul_assoc,
      one_mul, mul_assoc]
  rw [hT] at r1
  have r1' : RecRep r (p + dScale D) zs1 (Butterfly.layerH P 1 D S 0 Nat.zero_lt_one xs) := by
    have e : p + (0 * D + 1 * D + 0 * D + (D / 2 + D % 2)) = p + dScale D := by unfold dScale; ring
    rw [e] at r1; exact r1
  have hz1 : zs1.length = N := by
    rw [r1'.1, Butterfly.layerH, Butterfly.butterflyLayer, Butterfly.length_selOp]
  obtain ⟨LN, hNr⟩ := hR.n
  obtain ⟨LW, hWr⟩ := hR.w
  have hR1 := hR.upd0 (gflat zs1 ++ l)
  obtain ⟨LN', hNr'⟩ := hR1.n
  obtain ⟨LW', hWr'⟩ := hR1.w
  obtain ⟨rT, bT, fT⟩ := truncU_fsp s (Function.update f 0 (gflat zs1 ++ l)) zs1 _ l r1'
    (by simp) (hC.upd0 _) (w := w + 6 * D + 2) (b1.mono (by omega)) Z
    (by rw [hz1]; exact zsz_natCast_le' (by omega)) (by rw [hz1]; exact hNr') hWr'
  refine ⟨_, rT, bT, ?_⟩
  have F := f1.seq fT
  rw [Function.update_idem, hz1] at F
  refine F.mono (le_of_eq ?_)
  simp only [cLeafU, kcU, ← hN']

theorem yC_not_touch_kerCore (M : M2G) : yC ∉ touch (kerCore M) := by
  intro h
  have hq : yC ∉ touch (qop [M]) := fun h' => touch_qop_lo [M] yC h' (by decide)
  simp only [kerCore, touch, NLogN.KFD.touch_mvK, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, List.nil_append, List.append_nil] at h
  simp +decide [hq] at h

theorem fok_kerCore (M : M2G) : fok (kerCore M) = true := by
  simp only [kerCore, fok, fok_mvK_eq, fok_qop, Bool.and_true, Bool.true_and]
  decide

theorem fok_sel' (r : Fin HS) (br : ℕ → RS) (h : ∀ v, fok (br v) = true) :
    ∀ k m, fok (NLogN.KIL.sel r br k m) = true
  | _, 0 => rfl
  | k, 1 => h k
  | k, m + 2 => by simp [NLogN.KIL.sel, fok, h, fok_sel' r br h (k + 1) (m + 1)]

theorem fok_kersU (M : M2G) : fok (kersU M) = true := by
  have h1 : yC ∉ touch (RS.seq (kerCore M) kUpd) := by
    simp only [touch, List.mem_append, not_or]
    exact ⟨yC_not_touch_kerCore M, by decide⟩
  simp only [kersU, fok, fok_kerCore, KFD.not_contains_of h1]
  decide

theorem fok_leafU : fok leafU = true := by
  simp only [leafU, kLoop, kerDU, fok, fok_kersU, fok_sel' NLogN.KFV.yM _ (fun v => fok_kerCore (MD v)),
    Bool.and_true, Bool.true_and]
  simp only [NLogN.KFV.truncU, fok, fok_mvK_eq, touch, Ex.regs]
  decide

/-- **The uniform leaf as an IL run with the paper's guarantees** (the prefix and top rounds of
Lemma 16 with `K = 1`, `ρ = 0`). -/
theorem leafU_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {P D S r p w : ℕ}
    (hD : 1 ≤ D) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : RecRep r p zs xs) (hl : xs.length = vol (Butterfly.layerShape P 1 D S))
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hK : KFree f) (hfC : f yC = [])
    (hR : NLogN.KFV.LRegs s f P D S r) (hb : NLogN.KFB.GB w zs) (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) (K := 1) Nat.zero_lt_one p
        ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs) ∧
      NLogN.KFB.GB (p + 1) zs' ∧
      (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) (K := 1) Nat.zero_lt_one p
          ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs).length)
        (h' : j < (Butterfly.layerH P 1 D S 0 Nat.zero_lt_one xs).length), ∀ c,
        ‖(Butterfly.prop14Proc (P := P) (S := S) (K := 1) Nat.zero_lt_one p
            ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs)[j] c -
          (Butterfly.layerH P 1 D S 0 Nat.zero_lt_one xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
      IRuns I iprog (fcode leafU) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (gflat zs' ++ l)))
        (cLeafU D (vol (Butterfly.layerShape P 1 D S) * r)
          (zsz ((12 * (vol (Butterfly.layerShape P 1 D S) * r) : ℕ) : ℤ)) w) := by
  obtain ⟨zs', hr', hb', hf⟩ := leafU_fsp hD hr hS hP s f zs l xs hx hl h0 hC hK hfC hR hb
  obtain ⟨hout, hdisk', herr⟩ := Butterfly.prop14_output (P := P) (S := S) (K := 1) Nat.zero_lt_one p
    (Butterfly.tens Butterfly.Cm) rfl xs hdisk
  rw [← hout] at hr'
  exact ⟨zs', hr', GB_trunc_disk hr' (fun j hj c => hdisk' j hj c), herr, FSp.irun fok_leafU hf⟩

end NLogN.KFV

end

