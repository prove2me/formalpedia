/-- Iterating a map that commutes with relocation. -/
theorem iterate_rn {F F' : IState HS → IState HS} (h : ∀ t, F' (t.rn σ) = (F t).rn σ) (k : ℕ)
    (t : IState HS) : F'^[k] (t.rn σ) = (F^[k] t).rn σ := by
  induction k generalizing t with
  | zero => rfl
  | succ k ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ← ih, h]

@[simp] theorem run_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).run (s.rn σ) = (p.run s).rn σ
  | skip, _ => rfl
  | asg i e, s => by simp [ren, NLogN.RS.run, IState.rn_upd]
  | push i e, s => by simp [ren, NLogN.RS.run, IState.rn_upd]
  | pop i, s => by simp [ren, NLogN.RS.run, IState.rn_upd]
  | seq a b, s => by simp [ren, NLogN.RS.run, run_ren a, run_ren b]
  | ite c a b, s => by
    simp only [ren, NLogN.RS.run, Ex.eval_ren]; split_ifs
    · exact run_ren a s
    · exact run_ren b s
  | rep i n b, s => by
    simp only [ren, NLogN.RS.run, Ex.eval_ren]
    rw [← IState.rn_G σ s i, ← IState.rn_upd,
      iterate_rn σ (F := fun t => decSt i (b.run t)) (fun t => by
        simp only [run_ren b, decSt_rn])]
    simp only [IState.rn_G, IState.rn_upd]

theorem repSt_ren (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (k : ℕ) :
    repSt (σ i) (n.ren σ) (b.ren σ) (s.rn σ) k = (repSt i n b s k).rn σ := by
  simp only [repSt, Ex.eval_ren]
  rw [← IState.rn_G σ s i, ← IState.rn_upd]
  exact iterate_rn σ (fun t => by simp only [run_ren, decSt_rn]) k _

@[simp] theorem cost_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).cost (s.rn σ) = p.cost s
  | skip, _ => rfl
  | asg i e, s => by simp [ren, NLogN.RS.cost, asgCost_ren]
  | push i e, s => by simp [ren, NLogN.RS.cost]
  | pop i, s => by simp [ren, NLogN.RS.cost]
  | seq a b, s => by simp [ren, NLogN.RS.cost, cost_ren a, cost_ren b]
  | ite c a b, s => by
    simp only [ren, NLogN.RS.cost, Ex.eval_ren, Ex.cost_ren]; split_ifs
