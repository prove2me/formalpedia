/-- **The Prop 18 descriptor for `n`.** -/
theorem desc18P_run_n (dst : Fin HS) (hd : D18Ok dst) {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (t : IState HS)
    (h : D18Regs t n) :
    (desc18P dst).ok t ∧ (desc18P dst).run t =
      t.upd dst (ints (desc18 (pP n) (ℓP n) (KP n) (tsN n)) ++ t.G dst) := by
  obtain ⟨hb8, hd1, -⟩ := setup_facts hn
  obtain ⟨LD, hD⟩ := h.hD
  obtain ⟨LP, hDp⟩ := h.hDp
  obtain ⟨LR, hR⟩ := h.hR
  obtain ⟨k1, r1⟩ := tsLoop_run dst hd t (IntMul.OpenAI.R129.dP n) (dpN n) (IntMul.OpenAI.R129.rP n) LD LP LR hD hDp hR
  set vs := (List.range (IntMul.OpenAI.R129.dP n - 1)).map (fun j => tsV (dpN n) (IntMul.OpenAI.R129.rP n) (j + 1)) with hvs
  have hsplit := range_map_succ (IntMul.OpenAI.R129.dP n) hd1 (tsV (dpN n) (IntMul.OpenAI.R129.rP n))
  set t1 := t.upd dst (ints ((List.range (IntMul.OpenAI.R129.dP n)).map (tsV (dpN n) (IntMul.OpenAI.R129.rP n))) ++ t.G dst) with ht1
  have hX1 : t1.G dst = .int (tsV (dpN n) (IntMul.OpenAI.R129.rP n) 0) :: (ints vs ++ t.G dst) := by
    rw [ht1, hvs]; simp [hsplit]
  set t2 := t.upd dst (ints vs ++ t.G dst) with ht2
  have r2 : (RS.pop dst).run t1 = t2 := by
    show t1.upd dst (t1.G dst).tail = t2
    rw [hX1, List.tail_cons, ht1, IState.upd_upd_same]
  have o2 : (RS.pop dst).ok t1 := ⟨hd.lt, IState.isInt_of hX1⟩
  have h2 : D18Regs t2 n := h.upd dst hd _
  obtain ⟨LD2, hD2⟩ := h2.hD
  set t3 := t2.upd dst (.int ((IntMul.OpenAI.R129.dP n - 1 : ℕ) : ℤ) :: t2.G dst) with ht3
  have r3 : (RS.push dst dmE).run t2 = t3 := by
    simp only [RS.run, dmE, Ex.eval, IState.top_eq hD2, ht3]
    congr 3; omega
  have o3 : (RS.push dst dmE).ok t2 :=
    ⟨hd.lt, NLogN.KFM.clean_of_regs _ (by decide), ⟨IState.isInt_of hD2, trivial⟩⟩
  have h3 : D18Regs t3 n := h2.upd dst hd _
  obtain ⟨LK3, hK3⟩ := h3.hK
  set t4 := t3.upd dst (.int (KP n : ℤ) :: t3.G dst) with ht4
  have r4 : (RS.push dst (.reg zK)).run t3 = t4 := by
    simp only [RS.run, Ex.eval, IState.top_eq hK3, ht4]
  have o4 : (RS.push dst (.reg zK)).ok t3 :=
    ⟨hd.lt, NLogN.KFM.clean_of_regs _ (by decide), IState.isInt_of hK3⟩
  have h4 : D18Regs t4 n := h3.upd dst hd _
  obtain ⟨LE4, hE4⟩ := h4.hEl
  set t5 := t4.upd dst (.int (ℓP n : ℤ) :: t4.G dst) with ht5
  have r5 : (RS.push dst (.reg zEl)).run t4 = t5 := by
    simp only [RS.run, Ex.eval, IState.top_eq hE4, ht5]
  have o5 : (RS.push dst (.reg zEl)).ok t4 :=
    ⟨hd.lt, NLogN.KFM.clean_of_regs _ (by decide), IState.isInt_of hE4⟩
  have h5 : D18Regs t5 n := h4.upd dst hd _
  obtain ⟨LB5, hB5⟩ := h5.hB
  have r6 : (RS.push dst pE).run t5 = t5.upd dst (.int (pP n : ℤ) :: t5.G dst) := by
    simp only [RS.run, pE, Ex.eval, IState.top_eq hB5, pP]
    push_cast; ring_nf
  have o6 : (RS.push dst pE).ok t5 :=
    ⟨hd.lt, NLogN.KFM.clean_of_regs _ (by decide), ⟨trivial, IState.isInt_of hB5⟩⟩
  have o5' : (RS.seq (.push dst (.reg zEl)) (.push dst pE)).ok t4 := ⟨o5, by rw [r5]; exact o6⟩
  have o4' : (RS.seq (.push dst (.reg zK)) (.seq (.push dst (.reg zEl)) (.push dst pE))).ok t3 :=
    ⟨o4, by rw [r4]; exact o5'⟩
  have o3' : (RS.seq (.push dst dmE) (.seq (.push dst (.reg zK)) (.seq (.push dst (.reg zEl))
      (.push dst pE)))).ok t2 := ⟨o3, by rw [r3]; exact o4'⟩
  have o1 : (tsP dst).ok t := ⟨k1, by rw [r1]; exact o2⟩
  have r1' : (tsP dst).run t = t2 := by simp only [tsP, RS.run_seq, r1]; exact r2
  refine ⟨⟨o1, by rw [r1']; exact o3'⟩, ?_⟩
  simp only [desc18P, RS.run_seq]
  rw [r1', r3, r4, r5, r6]
  simp only [ht5, ht4, ht3, ht2, IState.upd_upd_same, IState.upd_G, if_true, ite_true, ↓reduceIte]
  congr 1
  have hvsE : vs = (tsN n).map (fun a : ℕ => (a : ℤ)) := by
    rw [hvs, tsN, List.map_map]; congr 1; funext j; simp only [Function.comp, tsV_succ]
  rw [desc18_ints, ← hvsE, show (((tsN n).length : ℕ) : ℤ) = ((IntMul.OpenAI.R129.dP n - 1 : ℕ) : ℤ) by simp [tsN]]
  simp only [List.cons_append]

theorem KP_le_dP (n : ℕ) : KP n ≤ IntMul.OpenAI.R129.dP n :=
  le_trans (Nat.le_self_pow (by positivity) _) (KP_spec n).1

set_option maxHeartbeats 4000000 in
/-- **Cost of the Prop 18 descriptor for `n`.** -/
theorem desc18P_cost_n (dst : Fin HS) (hd : D18Ok dst) {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (t : IState HS)
    (h : D18Regs t n) :
    (desc18P dst).cost t ≤ 10 ^ 12 * (bP n + 1) ^ 3 := by
  obtain ⟨hb8, hd1, hdb, -, -, hLb, hlL, -, hr, -⟩ := setup_facts hn
  obtain ⟨a1, -, -, -, a5, -⟩ := src_atoms hn
  have hEnv := costEnv_n (bP n) (by omega)
  set A := 2 ^ (2 * bP n + 2) with hA
  have hA2 : 2 ≤ A := by have := hEnv.hA; omega
  have h2b : 2 ^ bP n ≤ A := by rw [hA]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
  have hbA : 6 * bP n ≤ A := by
    have : 6 * bP n ≤ 2 ^ bP n := by
      have := Nat.lt_two_pow_self (n := bP n - 3)
      have e : 2 ^ bP n = 2 ^ (bP n - 3) * 8 := by
        rw [show (8 : ℕ) = 2 ^ 3 by norm_num, ← pow_add]; congr 1; omega
      omega
    omega
  have hrA : IntMul.OpenAI.R129.rP n ≤ A := le_trans hr h2b
  have hKA : KP n ≤ A := by have := KP_le_dP n; omega
  have hlA : ℓP n ≤ A := by omega
  set B := 16 * bP n + 17 with hB
  set K := 10 ^ 7 * (B + 2) ^ 2 with hK
  have hK1 := hEnv.K
  have hKn := K_n (bP n)
  obtain ⟨LD, hD⟩ := h.hD
  obtain ⟨LP, hDp⟩ := h.hDp
  obtain ⟨LR, hR⟩ := h.hR
  have hdO := hd.ne.1
  -- the loop
  have c1 := pushLoop_cost (.push dst tsE) dst hdO t (IntMul.OpenAI.R129.dP n) LD hD (tsV (dpN n) (IntMul.OpenAI.R129.rP n))
    (fun L c hc1 hcd => by
      set u := (t.upd dst (L ++ t.G dst)).upd mOc (.int (c : ℤ) :: t.G mOc) with hu
      have uO : u.G mOc = .int (c : ℤ) :: t.G mOc := by simp [hu]
      have uDp : u.G zDp = .int (dpN n : ℤ) :: LP := by
        simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.1, hDp]
      have uR : u.G zR = .int (IntMul.OpenAI.R129.rP n : ℤ) :: LR := by
        simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.2.1, hR]
      refine ⟨⟨hd.lt, NLogN.KFM.clean_of_regs _ (by decide), ?_⟩, ?_⟩
      · simp only [tsE, ixO, Ex.ok, Ex.eval, IState.top_eq uO, IState.top_eq uDp, IState.top_eq uR]
        refine ⟨⟨⟨⟨IState.isInt_of uO, trivial⟩, IState.isInt_of uDp⟩, trivial⟩, ?_⟩
        split_ifs
        · exact ⟨IState.isInt_of uR, trivial, by positivity, by norm_num⟩
        · exact IState.isInt_of uR
      · simp only [RS.run, tsE, ixO, Ex.eval, IState.top_eq uO, IState.top_eq uDp, IState.top_eq uR]
        rw [show u.G dst = L ++ t.G dst by simp [hu, IState.upd_G, hdO]]
        congr 3
        unfold tsV
        split_ifs <;> first | omega | (push_cast; omega))
    B (20 * K) (hEnv.zsz_nat a5) hEnv.B1
    (fun L c hc1 hcd => by
      set u := (t.upd dst (L ++ t.G dst)).upd mOc (.int (c : ℤ) :: t.G mOc) with hu
      have uO : u.G mOc = .int (c : ℤ) :: t.G mOc := by simp [hu]
      have uDp : u.G zDp = .int (dpN n : ℤ) :: LP := by
        simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.1, hDp]
      have uR : u.G zR = .int (IntMul.OpenAI.R129.rP n : ℤ) :: LR := by
        simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.2.1, hR]
      have cc := pushCost_le tsE u B (exSmS_bnd A B u hA2 _ (by
          simp only [tsE, ixO, exSmS, Ex.eval, IState.top_eq uO, IState.top_eq uDp, IState.top_eq uR]
          constructorm* _ ∧ _; (all_goals
                                  first
                                  | assumption
                                  | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                  | ((norm_num); (done))
                                  | ((norm_num); (omega))
                                  | omega
                                  | positivity
                                  |
                                    ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                          first
                                          | ((norm_num); (done))
                                          | omega);
                                      (done))))
        (hEnv.dg _ (by simp only [exDgS, tsE, ixO]; norm_num)))
      have s1 : tsE.size + 1 ≤ 20 := by simp [tsE, ixO, Ex.size]
      rw [rsCost_push]
      calc _ ≤ _ := cc
        _ ≤ 20 * 10 ^ 7 * (B + 2) ^ 2 := by
            apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; exact s1
        _ = 20 * K := by rw [hK]; ring)
  -- the rest, via the run lemma's states
  obtain ⟨k1, r1⟩ := tsLoop_run dst hd t (IntMul.OpenAI.R129.dP n) (dpN n) (IntMul.OpenAI.R129.rP n) LD LP LR hD hDp hR
  have hsplit := range_map_succ (IntMul.OpenAI.R129.dP n) hd1 (tsV (dpN n) (IntMul.OpenAI.R129.rP n))
  set vs := (List.range (IntMul.OpenAI.R129.dP n - 1)).map (fun j => tsV (dpN n) (IntMul.OpenAI.R129.rP n) (j + 1)) with hvs
  set t1 := t.upd dst (ints ((List.range (IntMul.OpenAI.R129.dP n)).map (tsV (dpN n) (IntMul.OpenAI.R129.rP n))) ++ t.G dst) with ht1
  have hX1 : t1.G dst = .int (tsV (dpN n) (IntMul.OpenAI.R129.rP n) 0) :: (ints vs ++ t.G dst) := by
    rw [ht1]; simp [hsplit]
  set t2 := t.upd dst (ints vs ++ t.G dst) with ht2
