theorem solution :
    let f : ℂ → ℂ := fun s => (s*(s-1)*completedRiemannZeta₀ s+1)/2
    let F : ℂ → ℂ := fun z => f (z+1/2)
    let U : Type := (z : {z : ℂ // 0 < z.im}) × Fin (analyticOrderNatAt F z.val)
    ∀ w : ℂ, Multipliable (fun p : U => 1+w^2/(-p.1.val^2)) ∧
      F w/F 0 = ∏' p : U, (1+w^2/(-p.1.val^2)) := by
  dsimp only
  intro w
  let f : ℂ → ℂ := fun s => (s*(s-1)*completedRiemannZeta₀ s+1)/2
  let F : ℂ → ℂ := fun z => f (z+1/2)
  let U : Type := (z : {z : ℂ // 0 < z.im}) × Fin (analyticOrderNatAt F z.val)
  let D : Type := {p : (z : ℂ) × Fin ((MeromorphicOn.divisor F Set.univ z).toNat) // p.1 ≠ 0}
  obtain ⟨_,hs,hHad⟩ := XiHadamardPortPublished.concrete_xi_centered_normalized_hadamard
  obtain ⟨e,heplus,heminus,_⟩ := XiPairingPublished.concrete_divisor_reindex
  let a : D → ℂ := fun p => (1-w/p.val.1)*Complex.exp (w/p.val.1)
  have hN : Summable (fun p => ‖a p-1‖) := by
    simpa [a,Complex.weierstrassFactor_def,Complex.partialLogSum_eq_sum,
      Complex.Hadamard.divisorZeroIndex₀_val, D,
      Complex.Hadamard.divisorZeroIndex₀, Complex.Hadamard.divisorZeroIndex] using
      Complex.Hadamard.absolute_factor_sum F w hs
  obtain ⟨hp,hm,hprod⟩ := split_products a e hN
  have hp' : Multipliable (fun p : U => (1-w/p.1.val)*Complex.exp (w/p.1.val)) := by
    apply hp.congr
    intro p
    dsimp only [a]
    rw [(heplus p).1]
  have hm' : Multipliable (fun p : U => (1-w/(-p.1.val))*Complex.exp (w/(-p.1.val))) := by
    apply hm.congr
    intro p
    dsimp only [a]
    rw [(heminus p).1]
  obtain ⟨hpair,hpairEq⟩ := paired_products (fun p : U => p.1.val) w hp' hm'
  refine ⟨hpair,?_⟩
  change F w/F 0 = _
  rw [hHad w]
  change (∏' p : D,a p) = _
  rw [hprod]
  have hpEq : (∏' p : U, a (e (Sum.inl p))) = ∏' p : U, (1-w/p.1.val)*Complex.exp (w/p.1.val) := by
    apply tprod_congr; intro p; dsimp only [a]; rw [(heplus p).1]
  have hmEq : (∏' p : U, a (e (Sum.inr p))) = ∏' p : U, (1-w/(-p.1.val))*Complex.exp (w/(-p.1.val)) := by
    apply tprod_congr; intro p; dsimp only [a]; rw [(heminus p).1]
  rw [hpEq,hmEq]
  exact hpairEq
