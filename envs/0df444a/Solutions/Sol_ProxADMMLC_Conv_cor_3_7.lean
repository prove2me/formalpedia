namespace C37Aux

open ProxADMMLC.Conv E312Aux Filter Topology

theorem box_closed {n : ℕ} (ℓ u : Fin n → ℝ) : IsClosed (box ℓ u) := by
  have : box ℓ u = ⋂ i, ({x : E n | ℓ i ≤ x i} ∩ {x | x i ≤ u i}) := by
    ext x; simp [box]
  rw [this]
  refine isClosed_iInter fun i => ?_
  have hc : Continuous fun x : E n => x i := by fun_prop
  exact (isClosed_le continuous_const hc).inter (isClosed_le hc continuous_const)

theorem box_bounded {n : ℕ} (ℓ u : Fin n → ℝ) : Bornology.IsBounded (box ℓ u) := by
  have hc : Continuous (WithLp.toLp 2 : (Fin n → ℝ) → E n) := by fun_prop
  have hK : IsCompact ((WithLp.toLp 2 : (Fin n → ℝ) → E n) ''
      Set.univ.pi fun i => Set.Icc (ℓ i) (u i)) :=
    (isCompact_univ_pi fun i => isCompact_Icc).image hc
  refine hK.isBounded.subset fun x hx => ⟨WithLp.ofLp x, fun i _ => hx i, rfl⟩

theorem box_compact {n : ℕ} (ℓ u : Fin n → ℝ) : IsCompact (box ℓ u) :=
  Metric.isCompact_of_isClosed_isBounded (box_closed ℓ u) (box_bounded ℓ u)

theorem proj_coord {n : ℕ} (ℓ u : Fin n → ℝ) (q : E n) (i : Fin n) :
    (boxProj ℓ u q) i = if q i < ℓ i then ℓ i else if q i ≤ u i then q i else u i := by
  simp only [boxProj, PiLp.toLp_apply]

theorem proj_mem {n : ℕ} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) (q : E n) :
    boxProj ℓ u q ∈ box ℓ u := by
  intro i
  rw [proj_coord]
  have := hℓu i
  split_ifs with h1 h2 <;> constructor <;> (try push Not at *) <;> linarith

theorem proj_ineq {n : ℕ} (ℓ u : Fin n → ℝ) (q v : E n) (hv : v ∈ box ℓ u) :
    inner ℝ (q - boxProj ℓ u q) (v - boxProj ℓ u q) ≤ 0 := by
  rw [PiLp.inner_apply]
  refine Finset.sum_nonpos (fun i _ => ?_)
  simp only [PiLp.sub_apply, RCLike.inner_apply, conj_trivial]
  rw [proj_coord]
  obtain ⟨hv1, hv2⟩ := hv i
  split_ifs with h1 h2
  · nlinarith
  · simp
  · push Not at h1 h2
    nlinarith

theorem proj_sign {n : ℕ} (ℓ u : Fin n → ℝ) (q : E n) (i : Fin n) :
    (q i < (boxProj ℓ u q) i → (boxProj ℓ u q) i = ℓ i) ∧
    ((boxProj ℓ u q) i < q i → (boxProj ℓ u q) i = u i) := by
  rw [proj_coord]
  split_ifs with h1 h2 <;> constructor <;> intro h <;> first | rfl | (exfalso; linarith)

theorem gradK_sub {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (Γ p : ℝ)
    (x x' z : E n) (y : E m) :
    gradK f A b Γ p x z y - gradK f A b Γ p x' z y
      = (gradient f x - gradient f x') + Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))
        + p • (x - x') := by
  unfold gradK
  simp only [map_sub]
  module

theorem vi_gradK {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z x' : E n) (hx' : x' ∈ box ℓ u) :
    0 ≤ inner ℝ (gradK f A b Γ p (xs y z) z y) (x' - xs y z) := by
  have h := vi_xs hdiff hxs y z x' hx'
  unfold gradK
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left]
  linarith

theorem mono_gradK {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m}
    {ℓ u : Fin n → ℝ} {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ) (hΓ : 0 ≤ Γ) (z : E n) (y : E m)
    (x x' : E n) (hx : x ∈ box ℓ u) (hx' : x' ∈ box ℓ u) :
    (p + γ) * ‖x - x'‖ ^ 2
      ≤ inner ℝ (gradK f A b Γ p x z y - gradK f A b Γ p x' z y) (x - x') := by
  rw [gradK_sub]
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left,
    real_inner_self_eq_norm_sq]
  have h1 := hγ x hx x' hx'
  have h2 : 0 ≤ Γ * ‖A (x - x')‖ ^ 2 := by positivity
  linarith

theorem lip_gradK {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m}
    {ℓ u : Fin n → ℝ} {L Γ p : ℝ}
    (hlip : ∀ x ∈ box ℓ u, ∀ x' ∈ box ℓ u, ‖gradient f x - gradient f x'‖ ≤ L * ‖x - x'‖)
    (hΓ : 0 ≤ Γ) (hp : 0 ≤ p) (z : E n) (y : E m)
    (x x' : E n) (hx : x ∈ box ℓ u) (hx' : x' ∈ box ℓ u) :
    ‖gradK f A b Γ p x z y - gradK f A b Γ p x' z y‖
      ≤ (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p) * ‖x - x'‖ := by
  rw [gradK_sub]
  have h1 := hlip x hx x' hx'
  have h2 : ‖Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))‖
      ≤ Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) * ‖x - x'‖ := by
    rw [norm_smul, Real.norm_of_nonneg hΓ]
    have h3 := (ContinuousLinearMap.adjoint A).le_opNorm (A (x - x'))
    have h4 := A.le_opNorm (x - x')
    have h5 : ‖(ContinuousLinearMap.adjoint A) (A (x - x'))‖
        ≤ ‖ContinuousLinearMap.adjoint A‖ * (‖A‖ * ‖x - x'‖) :=
      h3.trans (mul_le_mul_of_nonneg_left h4 (norm_nonneg _))
    calc Γ * ‖(ContinuousLinearMap.adjoint A) (A (x - x'))‖
        ≤ Γ * (‖ContinuousLinearMap.adjoint A‖ * (‖A‖ * ‖x - x'‖)) :=
          mul_le_mul_of_nonneg_left h5 hΓ
      _ = Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) * ‖x - x'‖ := by ring
  have h3 : ‖p • (x - x')‖ = p * ‖x - x'‖ := by rw [norm_smul, Real.norm_of_nonneg hp]
  have h6 := norm_add_le ((gradient f x - gradient f x')
    + Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))) (p • (x - x'))
  have h7 := norm_add_le (gradient f x - gradient f x')
    (Γ • (ContinuousLinearMap.adjoint A) (A (x - x')))
  linarith

/-- Error bound: the distance to the minimiser of `K(·, z; y⁺)` is controlled by the
projected-gradient residual `‖x − x⁺‖`. -/
theorem eb {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    (hℓu : ∀ i, ℓ i < u i) {L γ Γ p c α : ℝ} (hf : Assump22c f ℓ u L)
    (hγ : MonoConst f ℓ u γ) (hΓ : 0 ≤ Γ) (hp : 0 ≤ p) (hc : 0 < c) (hpγ : 0 < p + γ)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z x : E n)
    (hx : x ∈ box ℓ u) :
    ‖xs (yPlus A b α x y) z - x‖
      ≤ (1 + c * (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p)) / (c * (p + γ))
        * ‖x - xPlus f A b ℓ u Γ p c α x z y‖ := by
  obtain ⟨hdiff, hL, hlip⟩ := hf
  have hPdef : xPlus f A b ℓ u Γ p c α x z y
      = boxProj ℓ u (x - c • gradK f A b Γ p x z (yPlus A b α x y)) := rfl
  rw [hPdef]
  obtain ⟨y', hy'⟩ : ∃ y', y' = yPlus A b α x y := ⟨_, rfl⟩
  rw [← hy']
  have hxh : xs y' z ∈ box ℓ u := (hxs y' z).1
  have hLK0 : 0 ≤ L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p :=
    add_nonneg (add_nonneg hL.le (mul_nonneg hΓ (mul_nonneg (norm_nonneg _) (norm_nonneg _)))) hp
  obtain ⟨LK, hLK⟩ : ∃ LK, LK = L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p :=
    ⟨_, rfl⟩
  rw [← hLK] at hLK0 ⊢
  obtain ⟨xh, hxh_def⟩ : ∃ xh, xh = xs y' z := ⟨_, rfl⟩
  rw [← hxh_def] at hxh ⊢
  obtain ⟨G, hG⟩ : ∃ G, G = gradK f A b Γ p x z y' := ⟨_, rfl⟩
  obtain ⟨Gh, hGh⟩ : ∃ Gh, Gh = gradK f A b Γ p xh z y' := ⟨_, rfl⟩
  rw [← hG]
  obtain ⟨P, hP⟩ : ∃ P, P = boxProj ℓ u (x - c • G) := ⟨_, rfl⟩
  rw [← hP]
  have hPbox : P ∈ box ℓ u := hP ▸ proj_mem hℓu _
  have hproj : inner ℝ (x - c • G - P) (xh - P) ≤ 0 := hP ▸ proj_ineq ℓ u (x - c • G) xh hxh
  have hvi : 0 ≤ inner ℝ Gh (P - xh) := by
    rw [hGh, hxh_def]; exact vi_gradK hdiff hxs y' z P hPbox
  have hmono : (p + γ) * ‖xh - x‖ ^ 2 ≤ inner ℝ (Gh - G) (xh - x) := by
    rw [hGh, hG]; exact mono_gradK hγ hΓ z y' xh x hxh hx
  have hlipK : ‖Gh - G‖ ≤ LK * ‖xh - x‖ := by
    rw [hGh, hG, hLK]; exact lip_gradK hlip hΓ hp z y' xh x hxh hx
  obtain ⟨e, he⟩ : ∃ e, e = x - P := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D, D = xh - x := ⟨_, rfl⟩
  have r1 : x - c • G - P = e - c • G := by rw [he]; abel
  have r2 : xh - P = D + e := by rw [he, hD]; abel
  have r3 : P - xh = -(D + e) := by rw [← r2]; abel
  rw [r1, r2] at hproj
  rw [r3] at hvi
  rw [← hD] at hmono hlipK
  rw [← he, ← hD]
  rw [inner_sub_left, inner_add_right, inner_add_right, real_inner_smul_left,
    real_inner_smul_left] at hproj
  rw [inner_neg_right, inner_add_right] at hvi
  rw [inner_sub_left] at hmono
  have hcs1 : -(‖Gh - G‖ * ‖e‖) ≤ inner ℝ Gh e - inner ℝ G e := by
    rw [← inner_sub_left]; exact neg_le_of_abs_le (abs_real_inner_le_norm _ _)
  have hcs2 : -(‖e‖ * ‖D‖) ≤ inner ℝ e D := neg_le_of_abs_le (abs_real_inner_le_norm _ _)
  have hs : 0 ≤ inner ℝ e e := real_inner_self_nonneg
  have hN := mul_le_mul_of_nonneg_right hlipK (norm_nonneg e)
  have hc1 := mul_le_mul_of_nonneg_left hmono hc.le
  have hc2 := mul_nonneg hc.le hvi
  have hc3 := mul_le_mul_of_nonneg_left hcs1 hc.le
  have hc4 := mul_le_mul_of_nonneg_left hN hc.le
  have key : c * (p + γ) * ‖D‖ ^ 2 ≤ (1 + c * LK) * ‖e‖ * ‖D‖ := by
    linarith
  have hμ : 0 < c * (p + γ) := mul_pos hc hpγ
  rcases (norm_nonneg D).eq_or_lt with h0 | hpos
  · rw [← h0]
    exact mul_nonneg (div_nonneg (by positivity) hμ.le) (norm_nonneg _)
  · have k2 : (c * (p + γ) * ‖D‖) * ‖D‖ ≤ ((1 + c * LK) * ‖e‖) * ‖D‖ := by
      calc (c * (p + γ) * ‖D‖) * ‖D‖ = c * (p + γ) * ‖D‖ ^ 2 := by ring
        _ ≤ (1 + c * LK) * ‖e‖ * ‖D‖ := key
    have k3 := le_of_mul_le_mul_right k2 hpos
    rw [div_mul_eq_mul_div, le_div_iff₀ hμ]
    linarith

/-- The generators of the cone `range Aᵀ + N_box(xb)` (with a sign flip on `range Aᵀ`). -/
noncomputable def V {n m : ℕ} (A : E n →L[ℝ] E m) (ℓ u : Fin n → ℝ) (xb : E n) :
    (Fin m ⊕ Fin m) ⊕ (Fin n ⊕ Fin n) → E n :=
  Sum.elim (Sum.elim (fun j => (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1))
      (fun j => -(ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)))
    (Sum.elim (fun i => if xb i = ℓ i then EuclideanSpace.single i 1 else 0)
      (fun i => if xb i = u i then -EuclideanSpace.single i 1 else 0))

theorem mem_C {n m : ℕ} (A : E n →L[ℝ] E m) (ℓ u : Fin n → ℝ) (hℓu : ∀ i, ℓ i < u i)
    (xb : E n) (w : E m) (η : E n) (h1 : ∀ i, 0 < η i → xb i = ℓ i)
    (h2 : ∀ i, η i < 0 → xb i = u i) :
    -((ContinuousLinearMap.adjoint A) w) + η ∈ gcone (V A ℓ u xb) := by
  refine ⟨Sum.elim (Sum.elim (fun j => max (-w j) 0) (fun j => max (w j) 0))
    (Sum.elim (fun i => max (η i) 0) (fun i => max (-η i) 0)), ?_, ?_⟩
  · rintro ((j | j) | (i | i)) <;> simp
  · rw [Fintype.sum_sum_type, Fintype.sum_sum_type, Fintype.sum_sum_type]
    simp only [V, Sum.elim_inl, Sum.elim_inr]
    have e12 : ∑ j, max (-w j) 0 • (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
        + ∑ j, max (w j) 0 • -(ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
        = -((ContinuousLinearMap.adjoint A) w) := by
      conv_rhs => rw [vec_eq_sum w]
      rw [map_sum, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul]
      have := max_zero_sub_max_neg_zero_eq_self (w j)
      rw [smul_neg, ← sub_eq_add_neg, ← sub_smul, ← neg_smul]
      congr 1
      linarith
    have e34 : ∑ i, max (η i) 0 • (if xb i = ℓ i then EuclideanSpace.single i (1:ℝ) else 0)
        + ∑ i, max (-η i) 0 • (if xb i = u i then -EuclideanSpace.single i (1:ℝ) else 0)
        = η := by
      conv_rhs => rw [vec_eq_sum η]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rcases lt_trichotomy (η i) 0 with h | h | h
      · have hu := h2 i h
        have hl : xb i ≠ ℓ i := by rw [hu]; exact (hℓu i).ne'
        rw [if_neg hl, if_pos hu, max_eq_right h.le, max_eq_left (by linarith)]
        simp
      · rw [h]; simp
      · have hl := h1 i h
        have hu : xb i ≠ u i := by rw [hl]; exact (hℓu i).ne
        rw [if_pos hl, if_neg hu, max_eq_left h.le, max_eq_right (by linarith)]
        simp
    rw [e12, e34]

theorem kkt_of_C {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    {xb : E n} (hbox : xb ∈ box ℓ u) (hA : A xb = b)
    (h : gradient f xb ∈ gcone (V A ℓ u xb)) : xb ∈ Xstar f A b ℓ u := by
  obtain ⟨lam, hlam, hGsum⟩ := h
  let c : Fin n → ℝ := fun i => if xb i = ℓ i then lam (Sum.inr (Sum.inl i)) else 0
  let c' : Fin n → ℝ := fun i => if xb i = u i then lam (Sum.inr (Sum.inr i)) else 0
  let S : E n := ∑ j, (lam (Sum.inl (Sum.inl j)) - lam (Sum.inl (Sum.inr j))) •
    (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
  have hS : (ContinuousLinearMap.adjoint A) (∑ j, (lam (Sum.inl (Sum.inr j))
      - lam (Sum.inl (Sum.inl j))) • EuclideanSpace.single j (1:ℝ)) = -S := by
    rw [map_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_smul]
    module
  have hkey : gradient f xb = S + WithLp.toLp 2 c - WithLp.toLp 2 c' := by
    rw [hGsum, Fintype.sum_sum_type, Fintype.sum_sum_type, Fintype.sum_sum_type]
    simp only [V, Sum.elim_inl, Sum.elim_inr]
    rw [vec_eq_sum (WithLp.toLp 2 c), vec_eq_sum (WithLp.toLp 2 c')]
    have e12 : ∑ j, lam (Sum.inl (Sum.inl j)) •
          (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
        + ∑ j, lam (Sum.inl (Sum.inr j)) •
          -(ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1) = S := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      module
    have e3 : ∑ i, lam (Sum.inr (Sum.inl i)) •
          (if xb i = ℓ i then EuclideanSpace.single i (1:ℝ) else 0)
        = ∑ i, (WithLp.toLp 2 c : E n) i • EuclideanSpace.single i (1:ℝ) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [c, PiLp.toLp_apply]
      split_ifs <;> simp
    have e4 : ∑ i, lam (Sum.inr (Sum.inr i)) •
          (if xb i = u i then -EuclideanSpace.single i (1:ℝ) else 0)
        = -∑ i, (WithLp.toLp 2 c' : E n) i • EuclideanSpace.single i (1:ℝ) := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [c', PiLp.toLp_apply]
      split_ifs <;> simp
    rw [e12, e3, e4]
    abel
  refine ⟨∑ j, (lam (Sum.inl (Sum.inr j)) - lam (Sum.inl (Sum.inl j))) •
    EuclideanSpace.single j (1:ℝ), WithLp.toLp 2 c, WithLp.toLp 2 c', ?_, hA, hbox,
    fun i => ?_, fun i => ?_, fun i => ?_, fun i => ?_⟩
  · rw [hS, hkey]
    abel
  · simp only [c, PiLp.toLp_apply]
    split_ifs
    · exact hlam _
    · exact le_rfl
  · simp only [c', PiLp.toLp_apply]
    split_ifs
    · exact hlam _
    · exact le_rfl
  · simp only [c, PiLp.toLp_apply]
    split_ifs with h
    · rw [h]; ring
    · ring
  · simp only [c', PiLp.toLp_apply]
    split_ifs with h
    · rw [h]; ring
    · ring

/-- Sequential core of Corollary 3.7: a limit of points with vanishing residuals is a KKT point. -/
theorem key {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    (hℓu : ∀ i, ℓ i < u i) {L γ Γ p c α : ℝ} (hf : Assump22c f ℓ u L)
    (hγ : MonoConst f ℓ u γ) (hΓ : 0 ≤ Γ) (hp : 0 ≤ p) (hc : 0 < c) (hpγ : 0 < p + γ)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs) (xk zk : ℕ → E n)
    (yk : ℕ → E m) (hxk : ∀ k, xk k ∈ box ℓ u) (xb : E n) (hxb : xb ∈ box ℓ u)
    (hlim : Tendsto xk atTop (𝓝 xb))
    (h1 : Tendsto (fun k => ‖xk k - xPlus f A b ℓ u Γ p c α (xk k) (zk k) (yk k)‖) atTop (𝓝 0))
    (h2 : Tendsto (fun k => ‖zk k - xPlus f A b ℓ u Γ p c α (xk k) (zk k) (yk k)‖) atTop (𝓝 0))
    (h3 : Tendsto (fun k => ‖A (xs (yPlus A b α (xk k) (yk k)) (zk k)) - b‖) atTop (𝓝 0)) :
    xb ∈ Xstar f A b ℓ u := by
  have hf' := hf
  obtain ⟨hdiff, hL, hlip⟩ := hf
  obtain ⟨M, hM⟩ : ∃ M, M = (1 + c * (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p))
      / (c * (p + γ)) := ⟨_, rfl⟩
  -- feasibility of the limit
  have hAxb : A xb = b := by
    have hb : ∀ k, ‖A (xk k) - b‖ ≤ ‖A‖ * (M * ‖xk k - xPlus f A b ℓ u Γ p c α (xk k) (zk k)
        (yk k)‖) + ‖A (xs (yPlus A b α (xk k) (yk k)) (zk k)) - b‖ := by
      intro k
      have heb := eb hℓu hf' hγ hΓ hp hc hpγ hxs (yk k) (zk k) (xk k) (hxk k) (α := α)
      rw [← hM] at heb
      obtain ⟨xh, hxh⟩ : ∃ xh, xh = xs (yPlus A b α (xk k) (yk k)) (zk k) := ⟨_, rfl⟩
      rw [← hxh] at heb ⊢
      have e : A (xk k) - b = (A xh - b) - A (xh - xk k) := by rw [map_sub]; abel
      rw [e]
      have h4 := norm_sub_le (A xh - b) (A (xh - xk k))
      have h5 := A.le_opNorm (xh - xk k)
      have h6 := mul_le_mul_of_nonneg_left heb (norm_nonneg A)
      linarith
    have hT : Tendsto (fun k => ‖A‖ * (M * ‖xk k - xPlus f A b ℓ u Γ p c α (xk k) (zk k)
        (yk k)‖) + ‖A (xs (yPlus A b α (xk k) (yk k)) (zk k)) - b‖) atTop (𝓝 0) := by
      simpa using ((h1.const_mul M).const_mul ‖A‖).add h3
    have hz : Tendsto (fun k => ‖A (xk k) - b‖) atTop (𝓝 0) :=
      squeeze_zero (fun k => norm_nonneg _) hb hT
    have hc' : Tendsto (fun k => ‖A (xk k) - b‖) atTop (𝓝 ‖A xb - b‖) :=
      (((A.continuous.tendsto xb).comp hlim).sub_const b).norm
    have := tendsto_nhds_unique hc' hz
    exact sub_eq_zero.mp (norm_eq_zero.mp this)
  -- the cone membership
  obtain ⟨P, hP⟩ : ∃ P : ℕ → E n, P = fun k => xPlus f A b ℓ u Γ p c α (xk k) (zk k) (yk k) :=
    ⟨_, rfl⟩
  have h1' : Tendsto (fun k => ‖xk k - P k‖) atTop (𝓝 0) := by rw [hP]; exact h1
  have h2' : Tendsto (fun k => ‖zk k - P k‖) atTop (𝓝 0) := by rw [hP]; exact h2
  have hPx : Tendsto (fun k => P k - xk k) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    exact h1'.congr (fun k => norm_sub_rev _ _)
  have hxz : Tendsto (fun k => xk k - zk k) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    refine squeeze_zero (fun k => norm_nonneg _) (fun k => ?_) (by simpa using h1'.add h2')
    calc ‖xk k - zk k‖ = ‖(xk k - P k) - (zk k - P k)‖ := by congr 1; abel
      _ ≤ ‖xk k - P k‖ + ‖zk k - P k‖ := norm_sub_le _ _
  have hPlim : Tendsto P atTop (𝓝 xb) := by
    have := hPx.add hlim
    simp only [sub_add_cancel, zero_add] at this
    exact this
  have hgf : Tendsto (fun k => gradient f (xk k)) atTop (𝓝 (gradient f xb)) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun k => norm_nonneg _) (fun k => hlip _ (hxk k) _ hxb) ?_
    simpa using ((tendsto_iff_norm_sub_tendsto_zero.mp hlim).const_mul L)
  have hglim : Tendsto (fun k => gradient f (xk k) + p • (xk k - zk k) + c⁻¹ • (P k - xk k))
      atTop (𝓝 (gradient f xb)) := by
    simpa using (hgf.add (hxz.const_smul p)).add (hPx.const_smul c⁻¹)
  have hident : ∀ k, gradient f (xk k) + p • (xk k - zk k) + c⁻¹ • (P k - xk k)
      = -((ContinuousLinearMap.adjoint A) (yPlus A b α (xk k) (yk k) + Γ • (A (xk k) - b)))
        + c⁻¹ • (P k - (xk k - c • gradK f A b Γ p (xk k) (zk k) (yPlus A b α (xk k) (yk k)))) := by
    intro k
    have e : P k - (xk k - c • gradK f A b Γ p (xk k) (zk k) (yPlus A b α (xk k) (yk k)))
        = (P k - xk k) + c • gradK f A b Γ p (xk k) (zk k) (yPlus A b α (xk k) (yk k)) := by
      abel
    rw [e, smul_add, smul_smul, inv_mul_cancel₀ hc.ne', one_smul]
    unfold gradK
    rw [map_add, map_smul]
    abel
  have hsign : ∀ k i,
      (0 < (c⁻¹ • (P k - (xk k - c • gradK f A b Γ p (xk k) (zk k)
        (yPlus A b α (xk k) (yk k))))) i → P k i = ℓ i) ∧
      ((c⁻¹ • (P k - (xk k - c • gradK f A b Γ p (xk k) (zk k)
        (yPlus A b α (xk k) (yk k))))) i < 0 → P k i = u i) := by
    intro k i
    have hPk : P k = boxProj ℓ u
        (xk k - c • gradK f A b Γ p (xk k) (zk k) (yPlus A b α (xk k) (yk k))) := by
      rw [hP]; rfl
    rw [hPk]
    have hq := proj_sign ℓ u
      (xk k - c • gradK f A b Γ p (xk k) (zk k) (yPlus A b α (xk k) (yk k))) i
    simp only [PiLp.smul_apply, PiLp.sub_apply, smul_eq_mul] at hq ⊢
    have hci : 0 ≤ c⁻¹ := (inv_pos.mpr hc).le
    constructor
    · intro h
      have := pos_of_mul_pos_right h hci
      exact hq.1 (by linarith)
    · intro h
      have := neg_of_mul_neg_right h hci
      exact hq.2 (by linarith)
  have hev : ∀ᶠ k in atTop, ∀ i, (P k i = ℓ i → xb i = ℓ i) ∧ (P k i = u i → xb i = u i) := by
    rw [Filter.eventually_all]
    intro i
    have hci : Tendsto (fun k => P k i) atTop (𝓝 (xb i)) :=
      ((show Continuous (fun v : E n => v i) by fun_prop).tendsto xb).comp hPlim
    refine Filter.Eventually.and ?_ ?_
    · by_cases h : xb i = ℓ i
      · exact Filter.Eventually.of_forall (fun _ _ => h)
      · exact (hci.eventually_ne h).mono (fun k hk hk' => absurd hk' hk)
    · by_cases h : xb i = u i
      · exact Filter.Eventually.of_forall (fun _ _ => h)
      · exact (hci.eventually_ne h).mono (fun k hk hk' => absurd hk' hk)
  have hmem : ∀ᶠ k in atTop, gradient f (xk k) + p • (xk k - zk k) + c⁻¹ • (P k - xk k)
      ∈ gcone (V A ℓ u xb) := by
    refine hev.mono (fun k hk => ?_)
    rw [hident k]
    exact mem_C A ℓ u hℓu xb _ _ (fun i hi => (hk i).1 ((hsign k i).1 hi))
      (fun i hi => (hk i).2 ((hsign k i).2 hi))
  exact kkt_of_C hxb hAxb ((gcone_closed _).mem_of_tendsto hglim hmem)

end C37Aux

open Filter Topology ProxADMMLC.Conv in
theorem solution {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (ha : Assump22a A b ℓ u) (L : ℝ) (hf : Assump22c f ℓ u L)
    (γ : ℝ) (hγ : MonoConst f ℓ u γ) (Γ p c α : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hc : 0 < c)
    (hcL : c * (L + p + Γ * ‖A‖ ^ 2) < 1) (hpγ : -γ < p) (hα : 0 < α)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs) :
    ∀ y0 : E m, ∀ ε > 0, ∃ δ > 0, ∀ x ∈ box ℓ u, ∀ z ∈ box ℓ u, ∀ y : E m,
      y - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) →
      max (max ‖x - xPlus f A b ℓ u Γ p c α x z y‖ ‖z - xPlus f A b ℓ u Γ p c α x z y‖)
          ‖A (xs (yPlus A b α x y) z) - b‖ < δ →
        max (Metric.infDist x (Xstar f A b ℓ u)) (Metric.infDist z (Xstar f A b ℓ u)) < ε := by
  intro y0 ε hε
  by_contra hcon
  push Not at hcon
  have hseq := fun k : ℕ => hcon (1 / ((k : ℝ) + 1)) (by positivity)
  choose xk hxk zk hzk yk _ hres hfar using hseq
  obtain ⟨xb, hxb, φ, hφ, hlim⟩ := (C37Aux.box_compact ℓ u).tendsto_subseq hxk
  have hφt : Tendsto (fun k => 1 / ((φ k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat.comp hφ.tendsto_atTop
  have r1 : Tendsto (fun k => ‖xk (φ k) - xPlus f A b ℓ u Γ p c α (xk (φ k)) (zk (φ k))
      (yk (φ k))‖) atTop (𝓝 0) :=
    squeeze_zero (fun _ => norm_nonneg _)
      (fun k => ((le_max_left _ _).trans (le_max_left _ _)).trans (hres (φ k)).le) hφt
  have r2 : Tendsto (fun k => ‖zk (φ k) - xPlus f A b ℓ u Γ p c α (xk (φ k)) (zk (φ k))
      (yk (φ k))‖) atTop (𝓝 0) :=
    squeeze_zero (fun _ => norm_nonneg _)
      (fun k => ((le_max_right _ _).trans (le_max_left _ _)).trans (hres (φ k)).le) hφt
  have r3 : Tendsto (fun k => ‖A (xs (yPlus A b α (xk (φ k)) (yk (φ k))) (zk (φ k))) - b‖)
      atTop (𝓝 0) :=
    squeeze_zero (fun _ => norm_nonneg _) (fun k => (le_max_right _ _).trans (hres (φ k)).le) hφt
  have hX : xb ∈ Xstar f A b ℓ u :=
    C37Aux.key hℓu hf hγ hΓ.le hp.le hc (by linarith) hxs (xk ∘ φ) (zk ∘ φ) (yk ∘ φ)
      (fun k => hxk _) xb hxb hlim r1 r2 r3
  have hz : Tendsto (zk ∘ φ) atTop (𝓝 xb) := by
    have hd : Tendsto (fun k => zk (φ k) - xk (φ k)) atTop (𝓝 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      refine squeeze_zero (fun k => norm_nonneg _) (fun k => ?_) (by simpa using r2.add r1)
      calc ‖zk (φ k) - xk (φ k)‖
          = ‖(zk (φ k) - xPlus f A b ℓ u Γ p c α (xk (φ k)) (zk (φ k)) (yk (φ k)))
            - (xk (φ k) - xPlus f A b ℓ u Γ p c α (xk (φ k)) (zk (φ k)) (yk (φ k)))‖ := by
              congr 1; abel
        _ ≤ _ := norm_sub_le _ _
    have := hd.add hlim
    simp only [Function.comp_def, sub_add_cancel, zero_add] at this ⊢
    exact this
  have hd1 : Tendsto (fun k => Metric.infDist (xk (φ k)) (Xstar f A b ℓ u)) atTop (𝓝 0) :=
    squeeze_zero (fun _ => Metric.infDist_nonneg) (fun k => Metric.infDist_le_dist_of_mem hX)
      (tendsto_iff_dist_tendsto_zero.mp hlim)
  have hd2 : Tendsto (fun k => Metric.infDist (zk (φ k)) (Xstar f A b ℓ u)) atTop (𝓝 0) :=
    squeeze_zero (fun _ => Metric.infDist_nonneg) (fun k => Metric.infDist_le_dist_of_mem hX)
      (tendsto_iff_dist_tendsto_zero.mp hz)
  have hmax := hd1.max hd2
  rw [max_self] at hmax
  obtain ⟨k, hk⟩ := (hmax.eventually (gt_mem_nhds hε)).exists
  exact absurd (hfar (φ k)) (not_le.mpr hk)
