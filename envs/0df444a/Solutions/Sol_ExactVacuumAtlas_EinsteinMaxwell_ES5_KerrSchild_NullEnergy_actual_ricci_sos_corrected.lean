/-! ## The actual frame: explicit inverse and bindings to the actual tensors -/

/-- The actual metric contraction is the frame quadratic form of the frame components. -/
theorem contract2_esMetric (B D A H W : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) :
    contract2 (esMetric B D A H W) x k =
      frameQ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2) (frameInv W x k) := by
  simp only [contract2, Fin.sum_univ_five]
  simp [esMetric, frameQ, frameInv]
  ring

