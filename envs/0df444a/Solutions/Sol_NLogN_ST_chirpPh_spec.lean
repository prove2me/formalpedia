  have : (a : ℤ) + (u : ℤ) * (((x % tv : ℕ) : ℤ) * ((x % tv : ℕ) : ℤ)) =
      ((a + u * (x % tv) ^ 2 : ℕ) : ℤ) := by push_cast; ring
  rw [this, tmod_nat]

theorem axStep_spec (s : IState HS) (t : Fin HS) (ht : t.val < 56) (htA : t ≠ hAc)
    (htX : t ≠ hXq) (m M' u a x : ℕ) (LA LX Lt LM : List Item)
    (hA : s.G hAc = .int a :: LA) (hX : s.G hXq = .int x :: LX)
    (hT : s.G t = .int ((2 ^ m : ℕ) : ℤ) :: Lt) (hM : s.G hM2 = .int ((2 ^ M' : ℕ) : ℤ) :: LM) :
    (axStep t u).ok s ∧ (axStep t u).run s = axSt s LA LX (axIt (2 ^ m) u (2 ^ M') (a, x)) := by
  have ev := axE_eval s t u (2 ^ m) (2 ^ M') a x (IState.top_eq hA) (IState.top_eq hX)
    (IState.top_eq hT) (IState.top_eq hM)
  have r1 : (asg hAc (axE t u)).run s =
      s.upd hAc (.int (((a + u * (x % 2 ^ m) ^ 2) % 2 ^ M' : ℕ) : ℤ) :: LA) := by
    simp only [RS.run, ev, hA, List.tail_cons]
  set s1 := s.upd hAc (.int (((a + u * (x % 2 ^ m) ^ 2) % 2 ^ M' : ℕ) : ℤ) :: LA) with hs1
  have s1X : s1.G hXq = .int x :: LX := by simp +decide [hs1, hX]
  have s1T : s1.G t = .int ((2 ^ m : ℕ) : ℤ) :: Lt := by
    simp [hs1, IState.upd_G, htA, hT]
  have ruler : ∀ k : ℕ, ((2 ^ k : ℕ) : ℤ) = 2 ^ k := fun k => by push_cast; rfl
  refine ⟨⟨⟨by decide, ?_, ?_, IState.isInt_of hA⟩, ?_⟩, ?_⟩
  · refine clean_of_regs fun i hi => ?_
    have : i = hAc ∨ i = hXq ∨ i = t ∨ i = hM2 := by
      simp only [axE, fE, Ex.regs, List.mem_append, List.mem_singleton, List.nil_append] at hi
      tauto
    rcases this with rfl | rfl | rfl | rfl <;> first | decide | omega
  · simp only [axE, fE, Ex.ok, Ex.eval, IState.top_eq hT, IState.top_eq hM]
    exact ⟨⟨IState.isInt_of hA, trivial, ⟨IState.isInt_of hX, IState.isInt_of hT, m, ruler m⟩,
      ⟨IState.isInt_of hX, IState.isInt_of hT, m, ruler m⟩⟩, IState.isInt_of hM, M', ruler M'⟩
  · rw [r1]
    refine ⟨by decide, clean_of_regs fun i hi => ?_, ?_, IState.isInt_of s1X⟩
    · simp only [Ex.regs, List.mem_append, List.mem_singleton] at hi
      rcases hi with rfl | rfl <;> first | decide | omega
    simp only [Ex.ok, Ex.eval, IState.top_eq s1T]
    exact ⟨IState.isInt_of s1X, IState.isInt_of s1T, m, ruler m⟩
  · show (asg hXq _).run ((asg hAc (axE t u)).run s) = _
    rw [r1]
    simp only [RS.run, Ex.eval, IState.top_eq s1X, IState.top_eq s1T, tdiv_nat, s1X,
      List.tail_cons, axSt, axIt]
    rfl

theorem axLoop_states (s : IState HS) (t cnt : Fin HS) (ht : t.val < 56) (htA : t ≠ hAc)
    (htX : t ≠ hXq) (htI : t ≠ NLogN.CR.hI) (m M' u a x n : ℕ)
    (LA LX Lt LM Lc : List Item)
    (hA : s.G hAc = .int a :: LA) (hX : s.G hXq = .int x :: LX)
    (hT : s.G t = .int ((2 ^ m : ℕ) : ℤ) :: Lt) (hM : s.G hM2 = .int ((2 ^ M' : ℕ) : ℤ) :: LM)
    (hC : s.G cnt = .int n :: Lc) :
    RepStates NLogN.CR.hI (.reg cnt) (axStep t u) s
      (fun k => axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x))) ∧
    ∀ k, (axStep t u).ok (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))) := by
  have e : (Ex.reg (S := HS) cnt).eval s = n := by simp [Ex.eval, IState.top_eq hC]
  have hst : ∀ k, (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))).G t =
      .int ((2 ^ m : ℕ) : ℤ) :: Lt := fun k => by
    simp [withCtr, axSt, IState.upd_G, htA, htX, htI, hT]
  have hsm : ∀ k, (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))).G hM2 =
      .int ((2 ^ M' : ℕ) : ℤ) :: LM := fun k => by
    simp +decide [withCtr, axSt, IState.upd_G, hM]
  have step : ∀ k, (axStep t u).ok (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))) ∧
      (axStep t u).run (withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)))) =
      withCtr NLogN.CR.hI s n k (axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k + 1] (a, x))) := by
    intro k
    obtain ⟨o, r⟩ := axStep_spec _ t ht htA htX m M' u ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)).1
      ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x)).2 LA LX Lt LM
      (by simp +decide [withCtr, axSt, IState.upd_G]) (by simp +decide [withCtr, axSt, IState.upd_G])
      (hst k) (hsm k)
    refine ⟨o, ?_⟩
    rw [r, Function.iterate_succ_apply']
    apply IState.ext' _ (by simp [withCtr, axSt]) (by simp [withCtr, axSt])
    intro y
    simp only [withCtr, axSt, IState.upd_G]
    clear * -
    ((split_ifs <;> (try subst_vars) <;> simp_all +decide))
  have H : RepStates NLogN.CR.hI (.reg cnt) (axStep t u) s
      (fun k => axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[k] (a, x))) := {
    nonneg := by rw [e]; omega
    hw := by simp [axStep, RS.writes]; decide
    h0 := by
      apply IState.ext' _ (by simp [axSt]) (by simp [axSt])
      intro y
      simp only [axSt, IState.upd_G, Function.iterate_zero, id]
      clear * - hA hX
      split_ifs <;> (try subst_vars) <;> simp_all
    hG := fun k => by simp +decide [axSt, IState.upd_G]
    step := fun k hk => by rw [e, Int.toNat_natCast]; exact (step k).2 }
  exact ⟨H, fun k => (step k).1⟩

theorem axLoop_spec (s : IState HS) (t cnt : Fin HS) (ht : t.val < 56) (htA : t ≠ hAc)
    (htX : t ≠ hXq) (htI : t ≠ NLogN.CR.hI) (hc : cnt.val < 56) (m M' u a x n : ℕ)
    (LA LX Lt LM Lc : List Item)
    (hA : s.G hAc = .int a :: LA) (hX : s.G hXq = .int x :: LX)
    (hT : s.G t = .int ((2 ^ m : ℕ) : ℤ) :: Lt) (hM : s.G hM2 = .int ((2 ^ M' : ℕ) : ℤ) :: LM)
    (hC : s.G cnt = .int n :: Lc) :
    (axLoop t u cnt).ok s ∧
      (axLoop t u cnt).run s = axSt s LA LX ((axIt (2 ^ m) u (2 ^ M'))^[n] (a, x)) := by
  have e : (Ex.reg (S := HS) cnt).eval s = n := by simp [Ex.eval, IState.top_eq hC]
  obtain ⟨H, hok⟩ := axLoop_states s t cnt ht htA htX htI m M' u a x n LA LX Lt LM Lc hA hX hT hM hC
  refine ⟨H.ok (by decide) (clean_of_lt hc) (IState.isInt_of hC) ?_, ?_⟩
  · intro k hk; rw [e, Int.toNat_natCast]; exact hok k
  · rw [axLoop, H.run, e, Int.toNat_natCast]

theorem ChirpRegs.of_eq {q : Params} {w w' : IState HS}
    (h : ∀ i : Fin HS, i ∈ [hM2, hRr, hRh, hNa, hNb, hTT] → w'.G i = w.G i) (hw : ChirpRegs q w) :
    ChirpRegs q w' := by
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, ⟨L6, h6⟩⟩ := hw
  exact ⟨⟨L1, by rw [h _ (by simp)]; exact h1⟩, ⟨L2, by rw [h _ (by simp)]; exact h2⟩,
    ⟨L3, by rw [h _ (by simp)]; exact h3⟩, ⟨L4, by rw [h _ (by simp)]; exact h4⟩,
    ⟨L5, by rw [h _ (by simp)]; exact h5⟩, ⟨L6, by rw [h _ (by simp)]; exact h6⟩⟩

theorem two_r (q : Params) : (2 : ℕ) ^ (q.e + 1) = 2 * q.r := by
  rw [Params.r, pow_succ, mul_comm]

theorem reqBody_spec (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (w : IState HS)
    (hw : ChirpRegs q w) (x : ℕ) (hx : x < q.tdims.prod) (LQ : List Item)
    (hq : w.G hQ = .int ((x : ℤ) + 1) :: LQ) :
    reqBody.ok w ∧ reqBody.run w = w.upd 0 (ints (reqRec (chirpKey q) x) ++ w.G 0) := by
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, -⟩ := hw
  have eq : (Ex.add (Ex.reg (S := HS) hQ) (.lit (-1))).eval w = x := by
    simp [Ex.eval, IState.top_eq hq]
  set w1 := (push hXq (.add (.reg hQ) (.lit (-1)))).run w with hw1
  have r1 : w1 = w.upd hXq (.int x :: w.G hXq) := by simp only [hw1, RS.run, eq]
  set w2 := (push hAc (.lit 0)).run w1 with hw2
  have r2 : w2 = (w.upd hXq (.int x :: w.G hXq)).upd hAc (.int 0 :: w.G hAc) := by
    simp +decide only [hw2, RS.run, r1, Ex.eval, IState.upd_G]; rfl
  obtain ⟨o3, r3⟩ := axLoop_spec w2 hRr hNa (by decide) (by decide) (by decide) (by decide)
    (by decide) q.e (q.e + 1) 1 0 x (q.K - q.dh) (w.G hAc) (w.G hXq) L2 L1 L4
    (by rw [r2]; simp +decide) (by rw [r2]; simp +decide) (by rw [r2]; simp +decide [h2])
    (by rw [r2]; simp +decide [h1]) (by rw [r2]; simp +decide [h4])
  simp only [Nat.cast_one] at r3 o3
  set z1 := (axIt (2 ^ q.e) 1 (2 ^ (q.e + 1)))^[q.K - q.dh] (0, x) with hz1
  set w3 := axSt w2 (w.G hAc) (w.G hXq) z1 with hw3
  obtain ⟨o4, r4⟩ := axLoop_spec w3 hRh hNb (by decide) (by decide) (by decide) (by decide)
    (by decide) (q.e - 1) (q.e + 1) 2 z1.1 z1.2 q.dh (w.G hAc) (w.G hXq) L3 L1 L5
    (by rw [hw3, r2]; simp +decide [axSt]) (by rw [hw3, r2]; simp +decide [axSt])
    (by rw [hw3, r2]; simp +decide [axSt, h3])
    (by rw [hw3, r2]; simp +decide [axSt, h1]) (by rw [hw3, r2]; simp +decide [axSt, h5])
  simp only [Nat.cast_ofNat] at r4 o4
  set z2 := (axIt (2 ^ (q.e - 1)) 2 (2 ^ (q.e + 1)))^[q.dh] (z1.1, z1.2) with hz2
  have hkey : z2.1 = chirpKey q x := by
    rw [hz2, hz1, two_r]; exact chirpKey_loop q he hdh x hx
  set w4 := axSt w3 (w.G hAc) (w.G hXq) z2 with hw4
  have w4Q : w4.G hQ = .int ((x : ℤ) + 1) :: LQ := by
    rw [hw4, hw3, r2]; simp +decide [axSt, hq]
  have w4A : w4.G hAc = .int (chirpKey q x : ℤ) :: w.G hAc := by
    rw [hw4, ← hkey]; simp +decide [axSt]
  have w4X : w4.G hXq = .int (z2.2 : ℤ) :: w.G hXq := by rw [hw4]; simp +decide [axSt]
  have w4eq : w4 = (w.upd hAc (.int (chirpKey q x : ℤ) :: w.G hAc)).upd hXq
      (.int (z2.2 : ℤ) :: w.G hXq) := by
    rw [hw4, hw3, r2, ← hkey]
    apply IState.ext' _ (by simp [axSt]) (by simp [axSt])
    intro y; simp only [axSt, IState.upd_G]; clear * -; ((split_ifs <;> (try subst_vars) <;> simp_all +decide))
  have run34 : (NLogN.RS.seq (axLoop hRr 1 hNa) (NLogN.RS.seq (axLoop hRh 2 hNb) (NLogN.RS.seq (push 0 (.lit 0))
      (NLogN.RS.seq (push 0 (.add (.reg hQ) (.lit (-1))))
      (NLogN.RS.seq (push 0 (.add (.add (.reg hAc) (.reg hAc)) (.lit 1)))
      (NLogN.RS.seq (pop hAc) (pop hXq))))))).run w2 = w.upd 0 (ints (reqRec (chirpKey q) x) ++ w.G 0) := by
    simp only [RS.run]
    rw [r3, r4, w4eq]
    apply IState.ext' _ (by simp) (by simp)
    intro y
    simp only [RS.run, Ex.eval, IState.top, IState.upd_G, reqRec]
    simp +decide only [if_true, if_false, List.tail_cons]
    clear * - hq
    split_ifs <;> (try subst_vars) <;> simp_all +decide <;> ring_nf
  refine ⟨⟨⟨by decide, clean_of_regs (by decide), by
      simp [Ex.ok, IState.isInt_of hq]⟩, ⟨by decide, clean_of_regs (by decide), trivial⟩,
      ?_⟩, ?_⟩
  · rw [← hw1, ← hw2]
    refine ⟨o3, ?_⟩
    rw [r3]
    refine ⟨o4, ?_⟩
    rw [r4, w4eq]
    refine ⟨⟨by decide, clean_of_regs (by decide), trivial⟩, ⟨by decide, clean_of_regs (by decide), ?_⟩,
      ⟨by decide, clean_of_regs (by decide), ?_⟩, ⟨by decide, ?_⟩, ⟨by decide, ?_⟩⟩ <;>
    simp +decide [RS.run, Ex.ok, IState.IsInt, IState.top, IState.upd_G, hq]
  · show (NLogN.RS.seq _ _).run ((push hAc (.lit 0)).run ((push hXq _).run w)) = _
    rw [← hw1, ← hw2]; exact run34

theorem reqTail_succ (κ : ℕ → ℕ) (T k : ℕ) (hk : k < T) :
    reqTail κ T (k + 1) = reqRec κ (T - (k + 1)) :: reqTail κ T k := by
  unfold reqTail
  rw [List.range_succ_eq_map, List.map_cons, List.map_map, Nat.add_zero]
  congr 1
  apply List.map_congr_left; intro j _
  rw [Function.comp_apply, show T - (k + 1) + (j + 1) = T - k + j by omega]

theorem reqTail_full (κ : ℕ → ℕ) (T : ℕ) : reqTail κ T T = (List.range T).map (reqRec κ) := by
  simp [reqTail]

theorem chirpRegs_upd {q : Params} {w : IState HS} (hw : ChirpRegs q w) (i : Fin HS)
    (hi : i ∉ [hM2, hRr, hRh, hNa, hNb, hTT]) (L : List Item) : ChirpRegs q (w.upd i L) :=
  ChirpRegs.of_eq (fun j hj => by
    rw [IState.upd_G, if_neg]; rintro rfl; exact hi hj) hw

theorem reqGen_states (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (s : IState HS)
    (hw : ChirpRegs q s) :
    RepStates hQ (.reg hTT) reqBody s
      (fun k => s.upd 0 (ints (reqTail (chirpKey q) q.tdims.prod k).flatten ++ s.G 0)) ∧
    ∀ k < q.tdims.prod, reqBody.ok (withCtr hQ s q.tdims.prod k
      (s.upd 0 (ints (reqTail (chirpKey q) q.tdims.prod k).flatten ++ s.G 0))) := by
  obtain ⟨LT, hT⟩ := hw.tt
  set T := q.tdims.prod with hTdef
  have e : (Ex.reg (S := HS) hTT).eval s = T := by simp [Ex.eval, IState.top_eq hT]
  set S : ℕ → IState HS := fun k => s.upd 0 (ints (reqTail (chirpKey q) T k).flatten ++ s.G 0)
    with hSd
  have step : ∀ k < T, reqBody.ok (withCtr hQ s T k (S k)) ∧
      reqBody.run (withCtr hQ s T k (S k)) = withCtr hQ s T k (S (k + 1)) := by
    intro k hk
    have hw' : ChirpRegs q (withCtr hQ s T k (S k)) := by
      simp only [withCtr, hSd]
      exact chirpRegs_upd (chirpRegs_upd hw _ (by decide) _) _ (by decide) _
    obtain ⟨o, r⟩ := reqBody_spec q he hdh _ hw' (T - (k + 1)) (by omega) (s.G hQ)
      (by simp only [withCtr, IState.upd_G, if_true]; congr 2; push_cast [show k + 1 ≤ T by omega]; ring)
    refine ⟨o, ?_⟩
    rw [r]
    apply IState.ext' _ (by simp [withCtr, hSd]) (by simp [withCtr, hSd])
    intro y
    simp only [withCtr, hSd, IState.upd_G, reqTail_succ _ _ _ hk, List.flatten_cons, ints_append,
      List.append_assoc]
    clear * -
    ((split_ifs <;> (try subst_vars) <;> simp_all +decide))
  have H : RepStates hQ (.reg hTT) reqBody s S := {
    nonneg := by rw [e]; omega
    hw := by decide
    h0 := by
      apply IState.ext' _ (by simp [hSd]) (by simp [hSd])
      intro y
      simp only [hSd, IState.upd_G, reqTail, List.range_zero, List.map_nil, List.flatten_nil,
        ints_nil, List.nil_append]
      split_ifs with h <;> simp [h]
    hG := fun k => by simp +decide [hSd, IState.upd_G]
    step := fun k hk => by
      rw [e, Int.toNat_natCast] at hk ⊢; exact (step k hk).2 }
  exact ⟨H, fun k hk => (step k hk).1⟩

theorem reqGen_spec (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (s : IState HS)
    (hw : ChirpRegs q s) :
    reqGen.ok s ∧ reqGen.run s =
      s.upd 0 (ints ((List.range q.tdims.prod).map (reqRec (chirpKey q))).flatten ++ s.G 0) := by
  obtain ⟨LT, hT⟩ := hw.tt
  have e : (Ex.reg (S := HS) hTT).eval s = q.tdims.prod := by simp [Ex.eval, IState.top_eq hT]
  obtain ⟨H, hok⟩ := reqGen_states q he hdh s hw
  refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of hT) ?_, ?_⟩
  · intro k hk; rw [e, Int.toNat_natCast] at hk ⊢; exact hok k hk
  · rw [reqGen, H.run, e, Int.toNat_natCast]
    simp only [reqTail_full]

end NLogN.CR

