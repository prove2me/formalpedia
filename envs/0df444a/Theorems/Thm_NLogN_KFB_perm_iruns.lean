theorem NLogN.KFB.perm_iruns {k m n : ℕ} (σ : Equiv.Perm (Fin (k + 1))) :
    ∃ L : List ℕ, (∀ r ∈ L, r + 1 < k + 1) ∧
    ∀ {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} (s : IState HS) (wb : ℕ)
      (T : Butterfly.Op (Fin n)) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
      (x : Fin (k + 1) × (Fin m × Fin n → Fin 2) → ℂ), Rep zs x → f 0 = gflat zs ++ l →
      Cl f → NLogN.KFB.GB wb zs →
      ∃ zs', Rep zs' ((P8Lift.RStep.den T
          (P8Lift.RStep.perm σ : P8Lift.RStep (Fin (k + 1)) m)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
        IRuns I iprog (fcode (NLogN.KFB.permP (2 ^ (m * n)) L)) (encK s f)
          (encK s (Function.update f 0 (gflat zs' ++ l)))
          (L.length * NLogN.KFB.cPass wb (2 * 2 ^ (m * n)) ((k + 1) * 2 ^ (m * n))
            (zsz (((4 * (6 * 2 ^ (m * n) + (k + 1) * 2 ^ (m * n))) : ℕ) : ℤ)) + 1) := by sorry
