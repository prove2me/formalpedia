namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

/-- The paper's radial BVP with common constants `Q`, `J` on `I` (field equations only). -/
def PaperBVP (I : Set ℝ) (f m N w p a : ℝ → ℝ) (Q J : ℝ) : Prop :=
  ∀ r ∈ I, qFun f N w p a r = -Q ∧ ellFun f m N w p a r = -2 * J ∧
    deriv (deriv N) r = 2 ∧
    paperFResidual f m N a Q r = 0 ∧
    paperMResidual f m N a Q J r = 0 ∧
    m r * deriv (fun s => m s * deriv a s) r - f r * a r =
      2 * Q * f r * m r ^ 2 / N r ^ 2 * (J + 2 * Q * a r) ∧
    paperConstraintResidual f m N a Q J r = 0

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

