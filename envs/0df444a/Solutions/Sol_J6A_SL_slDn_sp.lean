section frame
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem slDn_sp_sol_aux (s : IState HS) (F : Fin HS → List ℤ) (h43 : F 43 = [])
    (hρ : ∀ i, F (ρS i) = []) {n n' pre post W : ℕ} {src : ℕ → Option ℕ}
    (hs : J6Seg.MonoSrc n n' src) (hW : 1 ≤ W) (hnW : n + n' ≤ 2 ^ W) (hpW : pre ≤ 2 ^ W)
    (hqW : 2 * post ≤ 2 ^ W) (hT : pre * (n' * (2 * post)) ≤ 2 ^ W) :
    Sp slDn (encK s (extend ρS (slabV (J6Seg.ctlOf n n' src (fun _ => 0)) pre post n' [] []) F))
      (encK s F) ((n + n' + 1) * ((2 + 1) * uC W DD + uC W DD) + (4 + 1) * uC W DD) := by
  set cs := J6Seg.ctlOf n n' src (fun _ => 0) with hcs
  have hlen : cs.length = n + n' := J6Seg.Slab.length_ctlOf (argOf := fun _ => (0 : ℤ)) hs
  set F' := extend ρS (slabV cs pre post n' [] []) F with hF'
  have e45 : F' 45 = flatC cs ++ [] := by
    rw [hF', show (45 : Fin HS) = ρS 0 from rfl, J6Seg.Ax.extS]; simp [slabV]
  have e38 : F' 38 = ((n + n' : ℕ) : ℤ) :: [] := by
    rw [hF', show (38 : Fin HS) = ρS 2 from rfl, J6Seg.Ax.extS]; simp [slabV, hlen]
  have e43 : F' 43 = [] := by
    rw [hF', J6Seg.Ax.extS_out (fun i => by fin_cases i <;> decide)]; exact h43
  have hb : ∀ a ∈ flatC cs, |a| ≤ 2 ^ W := fun a ha => by
    have h := J6Seg.Slab.flat_bound (n := n) (n' := n') (src := src) (argOf := fun _ => (0 : ℤ))
      (Z := 1) le_rfl (fun l _ => by show zsz (0 : ℤ) ≤ 1; rw [NLogN.zsz_zero]; norm_num) a ha
    have h2 : |a| < 2 ^ zsz a := abs_lt_two_pow_zsz a
    have h3 : (2 : ℤ) ^ zsz a ≤ 2 ^ W := pow_le_pow_right₀ (by norm_num) (by omega)
    linarith
  have d := dropP_sp s F' (R := 38) (X := 45) (k := 2) (m := n + n') (A := W) (by decide)
    (by decide) (by decide) (by decide) e43 e38 e45
    (by rw [J6Seg.Slab.length_flatC, hlen]) hb hnW
  set F'' := update F' 45 [] with hF''
  have p := popL_sp s (A := W) [38, 37, 39, 40] F'' (by decide) (by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl
    · refine ⟨by decide, _, [], by rw [hF'', update_of_ne (by decide), e38], ?_⟩
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast hnW
    · refine ⟨by decide, _, [], by
        rw [hF'', update_of_ne (by decide), hF', show (37 : Fin HS) = ρS 3 from rfl,
          J6Seg.Ax.extS]; rfl, ?_⟩
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast hpW
    · refine ⟨by decide, _, [], by
        rw [hF'', update_of_ne (by decide), hF', show (39 : Fin HS) = ρS 1 from rfl,
          J6Seg.Ax.extS]; rfl, ?_⟩
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast hqW
    · refine ⟨by decide, _, [], by
        rw [hF'', update_of_ne (by decide), hF', show (40 : Fin HS) = ρS 4 from rfl,
          J6Seg.Ax.extS]; rfl, ?_⟩
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast hT)
  have e : (fun j => if j ∈ [(38 : Fin HS), 37, 39, 40] then (F'' j).tail else F'' j) = F := by
    have x : ∀ i, F' (ρS i) = slabV cs pre post n' [] [] i := fun i => J6Seg.Ax.extS _ F i
    funext j
    by_cases h45 : j = 45
    · subst h45; rw [if_neg (by decide), hF'', update_self]; exact (hρ 0).symm
    by_cases h38 : j = 38
    · subst h38; rw [if_pos (by decide), hF'', update_of_ne (by decide), e38]; exact (hρ 2).symm
    by_cases h37 : j = 37
    · subst h37; rw [if_pos (by decide), hF'', update_of_ne (by decide),
        show (37 : Fin HS) = ρS 3 from rfl, x]; exact (hρ 3).symm
    by_cases h39 : j = 39
    · subst h39; rw [if_pos (by decide), hF'', update_of_ne (by decide),
        show (39 : Fin HS) = ρS 1 from rfl, x]; exact (hρ 1).symm
    by_cases h40 : j = 40
    · subst h40; rw [if_pos (by decide), hF'', update_of_ne (by decide),
        show (40 : Fin HS) = ρS 4 from rfl, x]; exact (hρ 4).symm
    by_cases h41 : j = 41
    · subst h41; rw [if_neg (by decide), hF'', update_of_ne (by decide),
        show (41 : Fin HS) = ρS 5 from rfl, x]; exact (hρ 5).symm
    by_cases h42 : j = 42
    · subst h42; rw [if_neg (by decide), hF'', update_of_ne (by decide),
        show (42 : Fin HS) = ρS 6 from rfl, x]; exact (hρ 6).symm
    have hj : ∀ i, ρS i ≠ j := by
      intro i hi; subst hi
      fin_cases i
      exacts [h45 rfl, h39 rfl, h38 rfl, h37 rfl, h40 rfl, h41 rfl, h42 rfl]
    have hm : j ∉ [(38 : Fin HS), 37, 39, 40] := by
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]; exact ⟨h38, h37, h39, h40⟩
    rw [if_neg hm, hF'', update_of_ne h45, hF', J6Seg.Ax.extS_out hj]
  rw [e] at p
  exact (d.seq p).mono (by simp)

end frame

