-- title:
--   Lemma 6.5.1 — a finitely generated cone has a point nearest to b
-- statement:
--   Let $C\subseteq\mathbb{R}^m$ be the convex cone generated by finitely many vectors $a_1,\dots,a_n$, and let $b\in\mathbb{R}^m$ be a point with $b\notin C$. Then there is a point $z\in C$ nearest to $b$ in the Euclidean distance:
--
--   $$\|z-b\|\le\|x-b\| \qquad\text{for all } x\in C.$$
--
--   The nearest point $z$ is used to build the separating vector $y=z-b$ in the analytic proof of the geometric Farkas lemma (Proposition 6.4.2). The existence of $z$ is not automatic, since a nearest point need not exist in a set that is not closed.
--
--   **Formalization Note** $\mathbb{R}^m$ is `EuclideanSpace ℝ (Fin m)`, whose norm is the Euclidean norm.
-- source:
--   Matoušek & Gärtner, Understanding and Using Linear Programming, Springer 2007, p. 95, Lemma 6.5.1

import Mathlib
import Definitions.Def_MatousekLP_Duality_Cones

namespace MatousekLP.Duality

/-- Matoušek & Gärtner, Lemma 6.5.1 (p. 95): if `C` is the convex cone in `ℝ^m` generated by
finitely many vectors `a₁, …, aₙ` and `b ∉ C`, then some `z ∈ C` is nearest to `b` in the
Euclidean distance: `‖z - b‖ ≤ ‖x - b‖` for all `x ∈ C`. -/
theorem exists_nearest_point_cone {m n : ℕ} (a : Fin n → EuclideanSpace ℝ (Fin m))
    (b : EuclideanSpace ℝ (Fin m)) (hb : b ∉ coneGen a) :
    ∃ z ∈ coneGen a, ∀ x ∈ coneGen a, ‖z - b‖ ≤ ‖x - b‖ := by sorry

end MatousekLP.Duality
