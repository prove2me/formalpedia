open Filter Topology
open scoped ContDiff
open Matrix
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
variable {U : Set (Pt n)} {g gi h : Metric n} {F f : TwoForm n}
theorem solution (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
    (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hf : ∀ i j, ContDiffOn ℝ ∞ (f i j) U) :
    FamilyData (lineMetric g h) (lineInv g h) (lineMetric F f) (lineDom U g h) where
  isOpen := isOpen_lineDom hU hg hh
  smooth i j := (contDiffOn_lineMetric hg hh i j).mono fun _ hp => hp.1
  smooth_F i j := (contDiffOn_lineMetric hF hf i j).mono fun _ hp => hp.1
  inv p hp := by
    have e : metricMatrix (lineInv g h p.1) p.2 = (metricMatrix (lineMetric g h p.1) p.2)⁻¹ := by ext; rfl
    rw [e]
    exact Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hp.2)
