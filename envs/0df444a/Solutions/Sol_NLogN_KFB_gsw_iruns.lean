theorem getD_gflat (zs : List GI) (J : ℕ) :
    (gflat zs).getD J 0 = if J % 2 = 0 then (zs.getD (J / 2) 0).1 else (zs.getD (J / 2) 0).2 := by
  induction zs generalizing J with
  | nil => simp
  | cons z zs ih =>
    rcases J with _ | _ | J
    · simp
    · simp
    · rw [gflat_cons, List.getD_cons_succ, List.getD_cons_succ, ih,
        show (J + 1 + 1) / 2 = J / 2 + 1 by omega, List.getD_cons_succ,
        show (J + 1 + 1) % 2 = J % 2 by omega]

theorem vol_swSh {W K P Q : ℕ} (hPQ : P < Q) (hQK : Q < K) :
    vol (swSh W K P Q) = 2 * (W * 2 ^ K) := by
  simp only [swSh, vol_cons, vol_nil, mul_one]
  have : 2 ^ K = 2 ^ (K - Q - 1) * 2 * 2 ^ (Q - P - 1) * 2 * 2 ^ P := by
    rw [← pow_succ, ← pow_add, ← pow_succ, ← pow_add]; congr 1; omega
  rw [this, pow_succ 2 P]; ring

theorem digits_eq (k P Q : ℕ) (hPQ : P < Q) :
    k = k / 2 ^ (Q + 1) * (4 * 2 ^ P * 2 ^ (Q - P - 1)) + k / 2 ^ Q % 2 * (2 * 2 ^ P * 2 ^ (Q - P - 1)) +
      k / (2 * 2 ^ P) % 2 ^ (Q - P - 1) * (2 * 2 ^ P) + k / 2 ^ P % 2 * 2 ^ P + k % 2 ^ P := by
  have eQ : 2 ^ Q = 2 * 2 ^ P * 2 ^ (Q - P - 1) := by
    rw [show 2 * 2 ^ P = 2 ^ (P + 1) by ring, ← pow_add]; congr 1; omega
  have eQ1 : 2 ^ (Q + 1) = 4 * 2 ^ P * 2 ^ (Q - P - 1) := by rw [pow_succ, eQ]; ring
  have h1 : 2 ^ (Q + 1) * (k / 2 ^ (Q + 1)) + k % 2 ^ (Q + 1) = k := Nat.div_add_mod k (2 ^ (Q + 1))
  have h2 : k % 2 ^ (Q + 1) = k % 2 ^ Q + 2 ^ Q * (k / 2 ^ Q % 2) := Nat.mod_pow_succ
  have h3 : k % 2 ^ Q = k % (2 * 2 ^ P) + (2 * 2 ^ P) * (k / (2 * 2 ^ P) % 2 ^ (Q - P - 1)) := by
    rw [eQ, Nat.mod_mul]
  have h4 : k % (2 * 2 ^ P) = k % 2 ^ P + 2 ^ P * (k / 2 ^ P % 2) := by
    rw [show 2 * 2 ^ P = 2 ^ (P + 1) by ring]; exact Nat.mod_pow_succ
  generalize k / 2 ^ (Q + 1) = d0 at h1 ⊢
  generalize k / 2 ^ Q % 2 = d1 at h2 ⊢
  generalize k / (2 * 2 ^ P) % 2 ^ (Q - P - 1) = d2 at h3 ⊢
  generalize k / 2 ^ P % 2 = d3 at h4 ⊢
  generalize k % 2 ^ (Q + 1) = t1 at h1 h2
  generalize k % 2 ^ Q = t2 at h2 h3
  generalize k % (2 * 2 ^ P) = t3 at h3 h4
  generalize k % 2 ^ P = t4 at h4 ⊢
  rw [eQ1] at h1
  rw [eQ] at h2
  generalize 2 ^ (Q - P - 1) = B at *
  generalize 2 ^ P = a at *
  subst h1 h2 h3 h4
  ring

theorem swap_index {W K P Q : ℕ} (hPQ : P < Q) (hQK : Q < K) (k c : ℕ) (hc : c < 2)
    (hk : k < W * 2 ^ K) :
    encode (swSh W K P Q) (swapPos 1 3 (decode (swSh W K P Q) (2 * k + c))) =
      2 * swbit P Q k + c := by
  have eK : 2 ^ K = 2 ^ (K - Q - 1) * 2 ^ (Q + 1) := by rw [← pow_add]; congr 1; omega
