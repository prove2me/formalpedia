  have claimA : ∀ y : ↥(pullback (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))), (∀ y', y' ⤳ y → y' = y) →
