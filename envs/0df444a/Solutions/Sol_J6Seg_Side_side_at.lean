theorem blockC_le (L m Ba cu : ℕ) : blockC L m Ba cu ≤ 20000 * ((L + 1) * ((m + 1) * (cu + Ba + 1))) := by
  unfold blockC cmdC moveCost
  have h1 : (m + 1) * (cu + 12002) + 456 * Ba + 6656 ≤ 20000 * ((m + 1) * (cu + Ba + 1)) := by
    nlinarith
  have h2 : (L + 1) * (4 * (2 * ((Ba + 1) * 38 + 3) + 19) + 50 + (m + 1) * (cu + 12002) + 3000) +
      (L + 1) * (2 * (2 * ((Ba + 1) * 38 + 3) + 19) + 3000) =
      (L + 1) * ((m + 1) * (cu + 12002) + 456 * Ba + 6656) := by ring
  rw [h2]
  calc (L + 1) * ((m + 1) * (cu + 12002) + 456 * Ba + 6656)
      ≤ (L + 1) * (20000 * ((m + 1) * (cu + Ba + 1))) := Nat.mul_le_mul_left _ h1
    _ = _ := by ring

theorem passC_le (pre L m Ba cu T Bo : ℕ) :
    passC pre L m Ba cu T Bo ≤
      (pre + 1) * (20000 * ((L + 1) * ((m + 1) * (cu + Ba + 1))) + 3000) +
        (T + 1) * (76 * Bo + 3200) := by
  unfold passC
  have h1 := blockC_le L m Ba cu
  have h2 : (pre + 1) * (blockC L m Ba cu + 3000) ≤
      (pre + 1) * (20000 * ((L + 1) * ((m + 1) * (cu + Ba + 1))) + 3000) :=
