  have : NLogN.KFUU.K0 * M * (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ NLogN.KFUU.K0 * M * (1280 * M) := by
    rw [mul_assoc (NLogN.KFUU.K0 * M)]; exact Nat.mul_le_mul_left _ h5
  unfold NLogN.KFUU.K0 at this ⊢
  nlinarith

theorem cU_le (Z : ℕ) : cU Z ≤ NLogN.KFUU.CU * (Z + 1) ^ 2 := by
