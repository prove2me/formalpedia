variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.SymStrat params.next ι) (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    (zeta : _root_.LIDT.MIPStarRE.LDT.Error)
    (hnorm : strategy.state.IsNormalized)
    (hself : family.StronglySelfConsistent strategy.state zeta) :
    |_root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceABABAvg params strategy family -
        _root_.LIDT.MIPStarRE.LDT.Commutativity.xEvaluatedSliceBABAtensorAvg params strategy family| ≤
      (↑params.m : _root_.LIDT.MIPStarRE.LDT.Error) * ↑params.d / ↑params.q + Real.sqrt zeta := by
  have hComparison := _root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceABAB_scalar_to_BABAtensor params strategy family zeta hnorm hself
  have hx := _root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceBABA_tensor_marginalize_x params strategy family hnorm
  have hx' :
      |_root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceBABAtensorAvg params strategy family -
          _root_.LIDT.MIPStarRE.LDT.Commutativity.xEvaluatedSliceBABAtensorAvg params strategy family| ≤
        (↑params.m : _root_.LIDT.MIPStarRE.LDT.Error) * ↑params.d / ↑params.q := by
    simpa [Nat.cast_mul] using hx
  have htri :=
    abs_sub_le
      (_root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceABABAvg params strategy family)
      (_root_.LIDT.MIPStarRE.LDT.Commutativity.fullSliceBABAtensorAvg params strategy family)
      (_root_.LIDT.MIPStarRE.LDT.Commutativity.xEvaluatedSliceBABAtensorAvg params strategy family)
