def bits (m e : ℕ) : ℕ := cond (Nat.ble (2 ^ 127) m) (e + 127) e

theorem bits_le (m e : ℕ) (hm : 1 ≤ m) : 2 ^ bits m e ≤ m * 2 ^ e := by
