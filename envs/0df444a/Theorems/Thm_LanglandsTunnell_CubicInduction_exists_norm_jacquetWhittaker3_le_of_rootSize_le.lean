theorem LanglandsTunnell.CubicInduction.exists_norm_jacquetWhittaker3_le_of_rootSize_le
    (v : HeightOneSpectrum (𝓞 ℚ))
    (χ : Fin 3 → ((v.adicCompletion ℚ)ˣ →* ℂˣ)) (hχ : ∀ i, IsLocallyConstant (χ i))
    (hωu : ∀ u : (v.adicCompletion ℚ)ˣ, ‖(((χ 0 * χ 1 * χ 2) u : ℂˣ) : ℂ)‖ = 1)
    (Φ : (Fin 3 → v.adicCompletion ℚ) → ℂ) (hΦ : IsLocallyConstant Φ) (hΦc : HasCompactSupport Φ) (B : ℝ) :
    ∃ (t : ℕ) (C : ℝ), ∀ g : LocalGL3 v,
      detSize g * lastRowSup g / minorSup g ^ 2 ≤ B → minorSup g / lastRowSup g ^ 2 ≤ B →
        ‖jacquetWhittaker3 v χ Φ g‖ ≤
          C / ((detSize g * lastRowSup g / minorSup g ^ 2) * (minorSup g / lastRowSup g ^ 2)) ^ t := by sorry
