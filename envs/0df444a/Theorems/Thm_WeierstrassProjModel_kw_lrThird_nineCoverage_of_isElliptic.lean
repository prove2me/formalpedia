-- title:
--   Nine-element unit-ideal coverage of each chart of E× E
-- statement:
--   Let $R$ be a commutative ring and $W$ a Weierstrass curve over $R$ which is elliptic, i.e. satisfies `W.IsElliptic`. Write $S$ for the quotient of $R[X_0,X_1,X_2]$ by the homogeneous ideal generated by the projective Weierstrass polynomial of `W.toProjective`, graded by the images `projModelGradingCR W.toProjective` of the spaces of homogeneous polynomials of each degree, and for $i\in\mathrm{Fin}\,3$ let $\mathcal A_i$ denote `HomogeneousLocalization.Away` of this graded ring at the image of $X_i$, regarded as an $R$-algebra through the map of $R$ into the degree-zero part followed by `fromZeroRingHom` (this is the coordinate ring of the standard chart $D_+(X_i)$ of the projective model). Fix $i,j\in\mathrm{Fin}\,3$ and work in $\mathcal A_i\otimes_R\mathcal A_j$. Consider the family `kw_lrSixU W i j`, indexed by $\mathrm{Fin}\,3\sqcup\mathrm{Fin}\,3$, given on the left summand by the three dehomogenised coordinates `kw_lrChart_u W i j` of the chord addition law and on the right summand by the three coordinates `kw_lrSymChart_u W i j` of the symmetric addition law, together with the three-element family `kw_lrThird_u₃ W i j`. The assertion is that the ideal of $\mathcal A_i\otimes_R\mathcal A_j$ spanned by the union of the ranges of these two families is the whole ring $\top$. No hypothesis is imposed on $R$ beyond ellipticity of $W$; in particular $2$ need not be invertible.
--
--   This is the characteristic-free coverage statement underlying the Bosma–Lenstra/Lange–Ruppert complete system of addition laws: on every chart $D_+(X_i)\times D_+(X_j)$ of $E\times_R E$ the non-vanishing loci of the chord, symmetric and third addition laws together cover the chart, whereas the chord and symmetric laws alone suffice only when $2$ is invertible. It is used by [`WeierstrassProjModel.exists_thirdLaw_nineCoverage_of_isElliptic_of_isDomain`](thm.html#WeierstrassProjModel.exists_thirdLaw_nineCoverage_of_isElliptic_of_isDomain) in the construction of the group law on the projective model.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WeierstrassProjModel_kw_lrThird_nineCoverage_of_isElliptic.lean

import Definitions.Def_WeierstrassCurve_ProjModel_ThirdLawCharts
import Mathlib.RingTheory.Noetherian.Defs

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra WeierstrassProjModel
open MvPolynomial WeierstrassCurve HomogeneousLocalization
open scoped TensorProduct

universe u

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] WeierstrassProjModel.kw_pbac_awayAlgebra

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

set_option quotPrecheck false in
local notation "𝒜" i => HomogeneousLocalization.Away (projModelGradingCR W.toProjective)
  (Ideal.Quotient.mk (projModelHomogeneousIdealCR W.toProjective).toIdeal
    (X i : MvPolynomial (Fin 3) R))

theorem WeierstrassProjModel.kw_lrThird_nineCoverage_of_isElliptic
    [W.IsElliptic] (i j : Fin 3) :
    Ideal.span (Set.range (kw_lrSixU W i j) ∪ Set.range (kw_lrThird_u₃ W i j))
      = (⊤ : Ideal ((𝒜 i) ⊗[R] (𝒜 j))) := by sorry
