/- Begin Solutions.CappedWindowLimit (SHA-256 c910be43cc8785bf301c3aaeb92e9dff195d8d04a59e2b20232d0ae8e155d35f). -/
section CappedPolicyUploadModule15
noncomputable section
open Filter MeasureTheory CappedBaseStock CappedWindowIntegrals
open scoped ENNReal NNReal BigOperators Topology

namespace CappedWindowLimit

/-- Expected inventory after m periods from deterministic nonnegative input means. -/
def G (P : DemandLaw) (m : ℕ) (r z : ℝ) : ℝ :=
  ∫ d, realInventory d r z m ∂demandPathLaw P

/-- Vanishing-error finite-window inequalities yield an exact pair of input means. -/
lemma exists_exact_means_of_approximate_bounds
    (P : DemandLaw) (c : Parameters) (C A : ℝ)
    (rj zj ej : ℕ → ℝ)
    (hrj : ∀ j, 0 ≤ rj j) (hzj : ∀ j, 0 ≤ zj j) (_hej : ∀ j, 0 ≤ ej j)
    (helim : Tendsto ej atTop (𝓝 0))
    (hzbound : ∀ᶠ j in atTop, zj j ≤ A)
    (hrbound : ∀ᶠ j in atTop, rj j ≤ mean P + ej j)
    (hL : ∀ᶠ j in atTop, G P c.L (rj j) (zj j) ≤ zj j + ej j)
    (hL1 : ∀ᶠ j in atTop, G P (c.L + 1) (rj j) (zj j) ≤ zj j + ej j)
    (hcost : ∀ ε : ℝ, 0 < ε → ∀ᶠ j in atTop,
      c.h * zj j + c.p * (mean P - rj j) ≤ C + ε) :
    ∃ r z : ℝ, 0 ≤ r ∧ r ≤ mean P ∧ 0 ≤ z ∧
      G P c.L r z ≤ z ∧ G P (c.L + 1) r z ≤ z ∧
      c.h * z + c.p * (mean P - r) ≤ C := by
  have heone : ∀ᶠ j in atTop, ej j ≤ 1 := by
    exact ((tendsto_order.mp helim).2 1 (by norm_num)).mono (fun _ h => h.le)
  have hrupper : ∀ᶠ j in atTop, rj j ≤ mean P + 1 := by
    filter_upwards [hrbound, heone] with j hr he
    linarith
  obtain ⟨r, z, hr, hz, s, hs, hzlim, hrlim⟩ :=
    CappedMeanCompactness.extract_nonneg_pair zj rj hzj hrj A (mean P + 1) hzbound hrupper
  have hsTop : Tendsto s atTop atTop := hs.tendsto_atTop
  have helim' : Tendsto (fun j => ej (s j)) atTop (𝓝 0) := helim.comp hsTop
  have hrmean : r ≤ mean P := by
    exact CappedMeanCompactness.limit_le_of_le_add_vanishing
      (fun j => rj (s j)) (fun j => ej (s j)) r (mean P)
      hrlim helim' (hsTop.eventually hrbound)
  have hright : Tendsto (fun j => zj (s j) + ej (s j)) atTop (𝓝 z) := by
    simpa using hzlim.add helim'
  have hGlim : ∀ m : ℕ,
      Tendsto (fun j => G P m (rj (s j)) (zj (s j))) atTop (𝓝 (G P m r z)) := by
    intro m
    exact CappedMeanCompactness.integral_realInventory_tendsto P m
      (fun j => rj (s j)) (fun j => zj (s j)) r z
      (fun j => hrj (s j)) (fun j => hzj (s j)) hr hz hrlim hzlim
  have hGL : G P c.L r z ≤ z :=
    le_of_tendsto_of_tendsto (hGlim c.L) hright (hsTop.eventually hL)
  have hGL1 : G P (c.L + 1) r z ≤ z :=
    le_of_tendsto_of_tendsto (hGlim (c.L + 1)) hright (hsTop.eventually hL1)
  have hclim : Tendsto (fun j => c.h * zj (s j) + c.p * (mean P - rj (s j))) atTop
      (𝓝 (c.h * z + c.p * (mean P - r))) := by
    exact (hzlim.const_mul c.h).add ((tendsto_const_nhds.sub hrlim).const_mul c.p)
  have hc : c.h * z + c.p * (mean P - r) ≤ C := by
    by_contra! hgt
    have hepos : 0 < (c.h * z + c.p * (mean P - r) - C) / 2 := by linarith
    have hbound := le_of_tendsto hclim
      (hsTop.eventually (hcost _ hepos))
    linarith
  exact ⟨r, z, hr, hrmean, hz, hGL, hGL1, hc⟩

/-- The exact limiting means supply an integrable independent Dirac window law. -/
lemma exists_window_law_of_approximate_bounds
    (P : DemandLaw) (c : Parameters) (C A : ℝ)
    (rj zj ej : ℕ → ℝ)
    (hrj : ∀ j, 0 ≤ rj j) (hzj : ∀ j, 0 ≤ zj j) (hej : ∀ j, 0 ≤ ej j)
    (helim : Tendsto ej atTop (𝓝 0))
    (hzbound : ∀ᶠ j in atTop, zj j ≤ A)
    (hrbound : ∀ᶠ j in atTop, rj j ≤ mean P + ej j)
    (hL : ∀ᶠ j in atTop, G P c.L (rj j) (zj j) ≤ zj j + ej j)
    (hL1 : ∀ᶠ j in atTop, G P (c.L + 1) (rj j) (zj j) ≤ zj j + ej j)
    (hcost : ∀ ε : ℝ, 0 < ε → ∀ᶠ j in atTop,
      c.h * zj j + c.p * (mean P - rj j) ≤ C + ε) :
    ∃ W : WindowLaw (c.L + 1), ∃ r z : ℝ,
      0 ≤ r ∧ r ≤ mean P ∧ 0 ≤ z ∧ WindowMeans W r z ∧
      windowExpectedInventory P W c.L ≤ ENNReal.ofReal z ∧
      windowExpectedInventory P W (c.L + 1) ≤ ENNReal.ofReal z ∧
      certificateObjective P c r z ≤ ENNReal.ofReal C := by
  obtain ⟨r, z, hr, hrmean, hz, hGL, hGL1, hc⟩ :=
    exists_exact_means_of_approximate_bounds P c C A rj zj ej hrj hzj hej
      helim hzbound hrbound hL hL1 hcost
  let rn : ℝ≥0 := ⟨r, hr⟩
  let zn : ℝ≥0 := ⟨z, hz⟩
  refine ⟨CappedWindowApproximation.diracWindowLaw (c.L + 1) rn zn,
    r, z, hr, hrmean, hz, ?_, ?_, ?_, ?_⟩
  · exact CappedWindowApproximation.diracWindowLaw_means (c.L + 1) rn zn
  · rw [CappedWindowApproximation.windowExpectedInventory_dirac P (c.L + 1) rn zn c.L (by omega)]
    exact ENNReal.ofReal_le_ofReal hGL
  · rw [CappedWindowApproximation.windowExpectedInventory_dirac P (c.L + 1) rn zn (c.L + 1) le_rfl]
    exact ENNReal.ofReal_le_ofReal hGL1
  · exact ENNReal.ofReal_le_ofReal hc

end CappedWindowLimit
end
end CappedPolicyUploadModule15
