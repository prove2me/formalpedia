    exact hwrite.2.1
  · rcases hrest with hmarker | hunchanged
    · refine Or.inr (Or.inl ⟨?_, ?_, ?_⟩)
      · intro himpossible
        exact hmarker.1 (hcenter.symm.trans himpossible)
      · exact hleft.trans hmarker.2.1
      · exact hnext.trans hmarker.2.2
    · refine Or.inr (Or.inr ⟨?_, ?_, ?_⟩)
      · intro himpossible
