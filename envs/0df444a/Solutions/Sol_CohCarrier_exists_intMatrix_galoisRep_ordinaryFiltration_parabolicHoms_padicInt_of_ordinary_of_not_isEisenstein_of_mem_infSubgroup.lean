theorem χ_e₁ : χ (S₁.e i₁) = 1 := by
  have h : χ (S₁.e i₁) * χ (S₁.e i₁) = χ (S₁.e i₁) * 1 := by rw [← map_mul, (S₁.idem i₁).eq, mul_one]
  exact mul_left_cancel₀ hi₁ h

