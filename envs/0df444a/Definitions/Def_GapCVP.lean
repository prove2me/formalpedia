            (fiveFamilyRowMajorInitialClauses
              (paddedAcceptancePhaseSpecification
                bound machine original) ++
              (fiveFamilyRowMajorAcceptanceClauses
                (paddedAcceptancePhaseSpecification
                  bound machine original) ++
                fiveIndependentForbiddenSourceClauses
                  (paddedAcceptancePhaseSpecification
                    bound machine original)))))
