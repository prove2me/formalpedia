structure Carrier {C : Type} [CommRing C] (πC : C) {MC : Scheme.{0}} (X : ℕ → Scheme.{0}) (ξ : ∀ d, X d ⟶ MC)
    (T : Type) [CommRing T] [Algebra C T] (t : Spec (CommRingCat.of T) ⟶ MC) where
  d : ℕ
  x : Spec (CommRingCat.of (T ⧸ Ideal.span {algebraMap C T πC})) ⟶ X d
  hx : x ≫ ξ d = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T πC}))) ≫ t

