end Monod.Dev.MonodRat

namespace Monod

open Monod.Dev.MonodRat

/-- `H(ℤ)` with rational breakpoints consists exactly of the elements of `G` piecewise in
`PSL(2, ℤ)` with all breakpoints in `ℚ ∪ {∞}` that fix `∞`. -/
theorem mem_HRat_iff (f : OnePoint ℝ ≃ₜ OnePoint ℝ) :
    f ∈ HRat ↔ (f ∈ Gpp ∧ IsPiecewiseProjOn ⊥ ratPoints f) ∧ f ∈ fixInf := by
  rw [HRat, Subgroup.mem_inf, mem_GRat_iff]

end Monod

