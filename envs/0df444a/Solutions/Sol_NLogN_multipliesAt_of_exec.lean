    (NLogN.enc inp c).cells tout = tapeOf (syms L) (c.σ.out.map (bitSym (syms L))) := by
  simp [NLogN.enc, tout]
@[simp] theorem enc_head_tout (inp : ℕ → Γ L) (c : Cfg S) :
    (NLogN.enc inp c).head tout = c.σ.out.length := by
  simp [NLogN.enc, tout]
@[simp] theorem enc_cells_tctl (inp : ℕ → Γ L) (c : Cfg S) :
    (NLogN.enc inp c).cells tctl = tapeOf (syms L) (c.ctl.map retSym).reverse := by
  simp [NLogN.enc, tctl]
@[simp] theorem enc_head_tctl (inp : ℕ → Γ L) (c : Cfg S) :
    (NLogN.enc inp c).head tctl = c.ctl.length := by
  simp [NLogN.enc, tctl]

/-- Two encodings agree if they agree tape by tape. -/
theorem enc_eq_of (inp : ℕ → Γ L) (c : Cfg S) (T : Tapes (Γ L) (S + 3))
    (h0 : T.cells tin = inp) (h0' : T.head tin = c.σ.ip)
    (h1 : T.cells tout = tapeOf (syms L) (c.σ.out.map (bitSym (syms L))))
    (h1' : T.head tout = c.σ.out.length)
    (h2 : T.cells tctl = tapeOf (syms L) (c.ctl.map retSym).reverse) (h2' : T.head tctl = c.ctl.length)
    (h3 : ∀ i, T.cells (tst i) = tapeOf (syms L) ((c.σ.stk i).map gsym).reverse)
    (h3' : ∀ i, T.head (tst i) = (c.σ.stk i).length) : T = NLogN.enc inp c := by
  apply Tapes.ext' <;> funext l <;> rcases fin_cases3 l with rfl | rfl | rfl | ⟨i, rfl⟩ <;>
    simp_all [enc_cells_tst, enc_head_tst]

theorem Reach.trans {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q₁ q₂ q₃ : P.Q} {T₁ T₂ T₃ : Tapes Γ' k} {m n : ℕ}
    (h₁ : Reach st P q₁ T₁ m q₂ T₂) (h₂ : Reach st P q₂ T₂ n q₃ T₃) : Reach st P q₁ T₁ (m + n) q₃ T₃ := by
  induction h₁ with
  | refl => simpa using h₂
  | step h _ ih => rw [Nat.add_right_comm]; exact Reach.step h (ih h₂)

theorem Reach.halts {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q₁ q₂ : P.Q} {T₁ T₂ T₃ : Tapes Γ' k} {m n : ℕ}
    (h₁ : Reach st P q₁ T₁ m q₂ T₂) (h₂ : Halts st P q₂ T₂ n T₃) : Halts st P q₁ T₁ (m + n) T₃ := by
  induction h₁ with
  | refl => simpa using h₂
  | step h _ ih => rw [Nat.add_right_comm]; exact Halts.step h (ih h₂)

theorem Reach.refl_of_eq {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q : P.Q} {T T' : Tapes Γ' k} (h : T = T') : Reach st P q T 0 q T' := h ▸ Reach.refl q T

theorem Reach.one {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q q' : P.Q} {T : Tapes Γ' k} {w : Fin k → Γ' × Move}
    (h : P.δ q T.read = some (q', w)) : Reach st P q T 1 q' (T.write (fix st T.read w)) :=
  Reach.step h (Reach.refl _ _)

@[simp] theorem tst_eq_tst {i j : Fin S} : tst i = tst j ↔ i = j :=
  ⟨tst_inj, fun h => h ▸ rfl⟩
@[simp] theorem tin_ne_tst (i : Fin S) : tin ≠ tst i := (tst_ne_tin i).symm
@[simp] theorem tout_ne_tst (i : Fin S) : tout ≠ tst i := (tst_ne_tout i).symm
@[simp] theorem tctl_ne_tst (i : Fin S) : tctl ≠ tst i := (tst_ne_tctl i).symm
@[simp] theorem tout_ne_tin : (tout : Fin (S + 3)) ≠ tin := tin_ne_tout.symm
@[simp] theorem tctl_ne_tin : (tctl : Fin (S + 3)) ≠ tin := tin_ne_tctl.symm
@[simp] theorem tctl_ne_tout : (tctl : Fin (S + 3)) ≠ tout := tout_ne_tctl.symm

theorem gsym_ne_gst (a : Sym) : gsym a ≠ (gst : Γ L) := by simp [gsym, gst]
theorem gbl_ne_gst : (gbl : Γ L) ≠ gst := by simp [gbl, gst]
theorem gret_ne_gst (x : Fin L) : gret x ≠ (gst : Γ L) := by simp [gret, gst]
theorem retSym_ne_gst (e : ℕ) : retSym e ≠ (gst : Γ L) := by
  unfold retSym; split_ifs <;> simp [gret, gbl, gst]
theorem bitSym_ne_gst (b : Bool) : bitSym (syms L) b ≠ gst := by
  unfold bitSym; split_ifs <;> simp [syms, gsym, gst]

/-- Cell right after the top of a stack is blank. -/
theorem tapeOf_after (W : List (Γ L)) : tapeOf (syms L) W (W.length + 1) = gbl := by
  simp [tapeOf, syms]

section Sim

variable (code : ℕ → Instr S) (L) (pc0 : Fin L) (inp : ℕ → Γ L)

theorem sim_push (c : Cfg S) (hpc : c.pc < L) (i : Fin S) (x : Sym) (e : ℕ) (he : e < L)
    (hcode : code c.pc = .push i x e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 2 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ.push i x, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨c.pc, hpc⟩, true), wr1 (NLogN.enc inp c).read (tst i) ((NLogN.enc inp c).read (tst i)) Move.right) := by
    simp [progOf, δf, hcode]
  refine Reach.step h1 ?_
  rw [fix_wr1 _ _ _ _ (Or.inl ⟨rfl, by simp⟩), write_wr1]
  simp only [Tapes.read, Function.update_eq_self, moveHead]
  set T1 : Tapes (Γ L) (S + 3) := ⟨(NLogN.enc inp c).cells,
    Function.update (NLogN.enc inp c).head (tst i) ((NLogN.enc inp c).head (tst i) + 1)⟩ with hT1
  have hr : T1.read (tst i) = gbl := by
    simp only [hT1, Tapes.read, Function.update_self, enc_cells_tst, enc_head_tst]
    have := tapeOf_after ((c.σ.stk i).map (gsym (L := L))).reverse
    simpa using this
  have h2 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, true) T1.read =
      some ((⟨e, he⟩, false), wr1 T1.read (tst i) (gsym x) Move.stay) := by
    simp [progOf, δf, hcode, toPc, he]
  refine Reach.step h2 ?_
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp, by rw [hr]; exact gbl_ne_gst, gsym_ne_gst x⟩), write_wr1]
  apply Reach.refl_of_eq
  apply enc_eq_of <;> simp [hT1, St.push, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
  · intro j
    split_ifs with hj
    · subst hj; exact tapeOf_push_stk _ _
    · rfl
  · intro j
    split_ifs with hj
    · subst hj; rfl
    · rfl

theorem fix_stayAll {k : ℕ} (a : Fin k → Γ L) : fix gst a (stayAll a) = stayAll a := by
  apply fix_eq_of; intro l; left; simp [stayAll]

theorem write_stayAll {k : ℕ} (T : Tapes (Γ L) k) : T.write (stayAll T.read) = T := by
  apply Tapes.ext' <;> funext l <;> simp [Tapes.write, stayAll, Tapes.read, moveHead]

theorem sim_jmp (c : Cfg S) (hpc : c.pc < L) (e : ℕ) (he : e < L) (hcode : code c.pc = .jmp e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 1 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨e, he⟩, false), stayAll (NLogN.enc inp c).read) := by
    simp [progOf, δf, hcode, toPc, he]
  have := Reach.one (st := gst) h1
  rwa [fix_stayAll, write_stayAll] at this

theorem sim_br (c : Cfg S) (hpc : c.pc < L) (i : Fin S) (f : Option Sym → Bool) (y n : ℕ)
    (hy : y < L) (hn : n < L) (hcode : code c.pc = .br i f y n) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 1
      (⟨if f (c.σ.top i) then y else n, by split_ifs <;> assumption⟩, false)
      (NLogN.enc inp ⟨if f (c.σ.top i) then y else n, c.σ, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨if f (c.σ.top i) then y else n, by split_ifs <;> assumption⟩, false),
        stayAll (NLogN.enc inp c).read) := by
    simp only [progOf, δf, hcode, enc_read_tst]
    split_ifs <;> simp [toPc, hy, hn]
  have := Reach.one (st := gst) h1
  rwa [fix_stayAll, write_stayAll] at this

theorem sim_pop (c : Cfg S) (hpc : c.pc < L) (i : Fin S) (e : ℕ) (he : e < L)
    (hcode : code c.pc = .pop i e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 1 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ.pop i, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨e, he⟩, false), wr1 (NLogN.enc inp c).read (tst i) gbl Move.left) := by
    simp [progOf, δf, hcode, toPc, he]
  refine Reach.step h1 (Reach.refl_of_eq ?_)
  rcases hs : c.σ.stk i with _ | ⟨x, l⟩
  · -- empty stack: nothing changes
    have hr : (NLogN.enc inp c).read (tst i) = gst := by
      simp [Tapes.read, enc_cells_tst, enc_head_tst, hs]; rfl
    have hfix : fix gst (NLogN.enc inp c).read (wr1 (NLogN.enc inp c).read (tst i) gbl Move.left) =
        stayAll (NLogN.enc inp c).read := by
      funext l
      simp only [fix, wr1, stayAll]
      by_cases hl : l = tst i
      · subst hl; simp [hr]
      · simp only [hl, if_false]
        split_ifs <;> simp_all
    rw [hfix, write_stayAll]
    have : c.σ.pop i = c.σ := by
      ext j : 1
      · funext j; simp only [St.pop, Function.update_apply]; split_ifs with hj
        · subst hj; simp [hs]
        · rfl
      · rfl
      · rfl
    rw [this]; rfl
  · have hr : (NLogN.enc inp c).read (tst i) = gsym x := by
      simp only [Tapes.read, enc_cells_tst, enc_head_tst, hs]
      have := tapeOf_top (L := L) (l.map gsym).reverse (gsym x)
      simpa using this
    rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp, by rw [hr]; exact gsym_ne_gst x, gbl_ne_gst⟩), write_wr1]
    apply enc_eq_of <;> simp [St.pop, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
    · intro j
      split_ifs with hj
      · subst hj; rw [hs]
        have := tapeOf_pop_stk (L := L) l x
        simpa using this
      · rfl
    · intro j
      split_ifs with hj
      · subst hj; simp [hs]
      · rfl

theorem sim_out (c : Cfg S) (hpc : c.pc < L) (b : Bool) (e : ℕ) (he : e < L)
    (hcode : code c.pc = .out b e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 2 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ.outB b, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨c.pc, hpc⟩, true), wr1 (NLogN.enc inp c).read tout ((NLogN.enc inp c).read tout) Move.right) := by
    simp [progOf, δf, hcode]
  refine Reach.step h1 ?_
  rw [fix_wr1 _ _ _ _ (Or.inl ⟨rfl, by simp⟩), write_wr1]
  simp only [Tapes.read, Function.update_eq_self, moveHead]
  set T1 : Tapes (Γ L) (S + 3) := ⟨(NLogN.enc inp c).cells,
    Function.update (NLogN.enc inp c).head tout ((NLogN.enc inp c).head tout + 1)⟩ with hT1
  have hr : T1.read tout = gbl := by
    simp only [hT1, Tapes.read, Function.update_self, enc_cells_tout, enc_head_tout]
    have := tapeOf_after (c.σ.out.map (bitSym (syms L)))
    simpa using this
  have h2 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, true) T1.read =
      some ((⟨e, he⟩, false), wr1 T1.read tout (bitSym (syms L) b) Move.stay) := by
    simp [progOf, δf, hcode, toPc, he, bitSym, syms]
    cases b <;> rfl
  refine Reach.step h2 ?_
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp [tout], by rw [hr]; exact gbl_ne_gst, bitSym_ne_gst b⟩),
    write_wr1]
  apply Reach.refl_of_eq
  apply enc_eq_of <;> simp [hT1, St.outB, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
  have := tapeOf_append_singleton (syms L) (c.σ.out.map (bitSym (syms L))) (bitSym (syms L) b)
  simpa using this

theorem sim_call (c : Cfg S) (hpc : c.pc < L) (t e : ℕ) (ht : t < L)
    (hcode : code c.pc = .call t e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 2 (⟨t, ht⟩, false)
      (NLogN.enc inp ⟨t, c.σ, e :: c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨c.pc, hpc⟩, true), wr1 (NLogN.enc inp c).read tctl ((NLogN.enc inp c).read tctl) Move.right) := by
    simp [progOf, δf, hcode]
  refine Reach.step h1 ?_
  rw [fix_wr1 _ _ _ _ (Or.inl ⟨rfl, by simp⟩), write_wr1]
  simp only [Tapes.read, Function.update_eq_self, moveHead]
  set T1 : Tapes (Γ L) (S + 3) := ⟨(NLogN.enc inp c).cells,
    Function.update (NLogN.enc inp c).head tctl ((NLogN.enc inp c).head tctl + 1)⟩ with hT1
  have hr : T1.read tctl = gbl := by
    simp only [hT1, Tapes.read, Function.update_self, enc_cells_tctl, enc_head_tctl]
    have := tapeOf_after (c.ctl.map (retSym (L := L))).reverse
    simpa using this
  have h2 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, true) T1.read =
      some ((⟨t, ht⟩, false), wr1 T1.read tctl (retSym e) Move.stay) := by
    simp [progOf, δf, hcode, toPc, ht]
  refine Reach.step h2 ?_
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp [tctl], by rw [hr]; exact gbl_ne_gst, retSym_ne_gst e⟩),
    write_wr1]
  apply Reach.refl_of_eq
  apply enc_eq_of <;> simp [hT1, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
  have := tapeOf_append_singleton (syms L) (c.ctl.map (retSym (L := L))).reverse (retSym e)
  simpa using this

theorem sim_ret (c : Cfg S) (hpc : c.pc < L) (e : ℕ) (l : List ℕ) (hctl : c.ctl = e :: l)
    (he : e < L) (hcode : code c.pc = .ret) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 1 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ, l⟩) := by
  have hr : (NLogN.enc inp c).read tctl = gret ⟨e, he⟩ := by
    simp only [Tapes.read, enc_cells_tctl, enc_head_tctl, hctl]
    have := tapeOf_top (L := L) (l.map retSym).reverse (retSym e)
    simp only [List.length_reverse, List.length_map] at this
    have e2 : retSym e = gret (L := L) ⟨e, he⟩ := by simp [retSym, he]
    rw [e2] at this
    simp only [List.map_cons, List.reverse_cons, List.length_cons]
    rw [e2]; exact this
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨e, he⟩, false), wr1 (NLogN.enc inp c).read tctl gbl Move.left) := by
    simp only [progOf, δf, hcode, hr, gret]
  refine Reach.step h1 (Reach.refl_of_eq ?_)
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp [tctl], by rw [hr]; exact gret_ne_gst _, gbl_ne_gst⟩),
    write_wr1]
  apply enc_eq_of <;> simp [Function.update_apply, enc_cells_tst, enc_head_tst, moveHead, hctl]
  have := tapeOf_pop' (L := L) (l.map retSym).reverse (retSym e)
  simpa using this

theorem sim_halt (c : Cfg S) (hpc : c.pc < L) (hctl : c.ctl = []) (hcode : code c.pc = .ret)
    (b : Bool) : (progOf code L pc0).δ (⟨c.pc, hpc⟩, b) (NLogN.enc inp c).read = none := by
  have hr : (NLogN.enc inp c).read tctl = gst := by
    simp [Tapes.read, enc_cells_tctl, enc_head_tctl, hctl]; rfl
  simp only [progOf, δf, hcode, hr, gst]

theorem sim_inRd (I : List Sym) (hinp : ∀ p, inCode (inp (p + 1)) = I.getD p codeEnd)
    (c : Cfg S) (hpc : c.pc < L) (i : Fin S) (e : ℕ) (he : e < L)
    (hcode : code c.pc = .inRd i e) :
    Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) 2 (⟨e, he⟩, false)
      (NLogN.enc inp ⟨e, c.σ.inRd I i, c.ctl⟩) := by
  have h1 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, false) (NLogN.enc inp c).read =
      some ((⟨c.pc, hpc⟩, true), wr2 (NLogN.enc inp c).read tin ((NLogN.enc inp c).read tin) Move.right
        (tst i) ((NLogN.enc inp c).read (tst i)) Move.right) := by
    simp [progOf, δf, hcode]
  refine Reach.step h1 ?_
  rw [fix_wr2 _ _ _ _ _ _ _ (tst_ne_tin i).symm (Or.inl ⟨rfl, by simp⟩) (Or.inl ⟨rfl, by simp⟩),
    write_wr2 _ _ _ _ _ _ _ (tst_ne_tin i).symm]
  simp only [Tapes.read, Function.update_eq_self, moveHead]
  set T1 : Tapes (Γ L) (S + 3) := ⟨(NLogN.enc inp c).cells,
    Function.update (Function.update (NLogN.enc inp c).head tin ((NLogN.enc inp c).head tin + 1)) (tst i)
      ((NLogN.enc inp c).head (tst i) + 1)⟩ with hT1
  have hr : T1.read (tst i) = gbl := by
    simp only [hT1, Tapes.read, Function.update_self, enc_cells_tst, enc_head_tst]
    have := tapeOf_after ((c.σ.stk i).map (gsym (L := L))).reverse
    simpa using this
  have hr0 : T1.read tin = inp (c.σ.ip + 1) := by
    simp [hT1, Tapes.read, Function.update_apply]
  have h2 : (progOf code L pc0).δ (⟨c.pc, hpc⟩, true) T1.read =
      some ((⟨e, he⟩, false), wr1 T1.read (tst i) (gsym (I.getD c.σ.ip codeEnd)) Move.stay) := by
    simp [progOf, δf, hcode, toPc, he, hr0, hinp]
  refine Reach.step h2 ?_
  rw [fix_wr1 _ _ _ _ (Or.inr ⟨by simp, by rw [hr]; exact gbl_ne_gst, gsym_ne_gst _⟩), write_wr1]
  apply Reach.refl_of_eq
  apply enc_eq_of <;> simp [hT1, St.inRd, Function.update_apply, enc_cells_tst, enc_head_tst, moveHead]
  · intro j
    split_ifs with hj
    · subst hj; exact tapeOf_push_stk _ _
    · rfl
  · intro j
    split_ifs with hj
    · subst hj; rfl
    · rfl

theorem sim_step (I : List Sym) (hinp : ∀ p, inCode (inp (p + 1)) = I.getD p codeEnd)
    (hv : ∀ x < L, (code x).Valid L) (c c' : Cfg S) (hpc : c.pc < L) (hctl : ∀ e ∈ c.ctl, e < L)
    (h : fstep I code c = some c') :
    ∃ hpc' : c'.pc < L, (∀ e ∈ c'.ctl, e < L) ∧ ∃ t, t ≤ 2 ∧
      Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) t (⟨c'.pc, hpc'⟩, false)
        (NLogN.enc inp c') := by
  have hvc := hv c.pc hpc
  rcases c with ⟨pc, σ, ctl⟩
  simp only at hpc hctl hvc ⊢
  unfold fstep at h
  simp only at h
  rcases hcode : code pc with e | ⟨i, x, e⟩ | ⟨i, e⟩ | ⟨i, e⟩ | ⟨b, e⟩ | ⟨i, f, y, n⟩ | ⟨t, e⟩ | _ <;>
    rw [hcode] at h hvc <;> simp only [Instr.Valid] at hvc
  · cases h; exact ⟨hvc, hctl, 1, by omega, sim_jmp (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc e hvc hcode⟩
  · cases h; exact ⟨hvc, hctl, 2, le_rfl, sim_push (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc i x e hvc hcode⟩
  · cases h; exact ⟨hvc, hctl, 1, by omega, sim_pop (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc i e hvc hcode⟩
  · cases h
    exact ⟨hvc, hctl, 2, le_rfl, sim_inRd (code := code) (L := L) (pc0 := pc0) (inp := inp) I hinp ⟨pc, σ, ctl⟩ hpc i e hvc hcode⟩
  · cases h; exact ⟨hvc, hctl, 2, le_rfl, sim_out (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc b e hvc hcode⟩
  · cases h
    exact ⟨by split_ifs <;> simp only [hvc.1, hvc.2], hctl, 1, by omega,
      sim_br (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc i f y n hvc.1 hvc.2 hcode⟩
  · cases h
    refine ⟨hvc.1, ?_, 2, le_rfl, sim_call (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, ctl⟩ hpc t e hvc.1 hcode⟩
    intro x hx; simp only [List.mem_cons] at hx; rcases hx with rfl | hx
    · exact hvc.2
    · exact hctl x hx
  · rcases ctl with _ | ⟨e, l⟩
    · simp at h
    · cases h
      have he := hctl e (by simp)
      exact ⟨he, fun x hx => hctl x (by simp [hx]), 1, by omega,
        sim_ret (code := code) (L := L) (pc0 := pc0) (inp := inp) ⟨pc, σ, e :: l⟩ hpc e l rfl he hcode⟩

theorem sim_steps (I : List Sym) (hinp : ∀ p, inCode (inp (p + 1)) = I.getD p codeEnd)
    (hv : ∀ x < L, (code x).Valid L) {c c' : Cfg S} {n : ℕ} (h : Steps I code c n c') :
    ∀ (hpc : c.pc < L), (∀ e ∈ c.ctl, e < L) →
    ∃ hpc' : c'.pc < L, (∀ e ∈ c'.ctl, e < L) ∧ ∃ t, t ≤ 2 * n ∧
      Reach gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) t (⟨c'.pc, hpc'⟩, false)
        (NLogN.enc inp c') := by
  induction h with
  | refl c => intro hpc hctl; exact ⟨hpc, hctl, 0, le_rfl, Reach.refl _ _⟩
  | @step c₁ c₂ c₃ n h1 _ ih =>
    intro hpc hctl
    obtain ⟨hpc₂, hctl₂, t₁, ht₁, r₁⟩ := sim_step (code := code) (L := L) (pc0 := pc0) (inp := inp) I hinp hv c₁ c₂ hpc hctl h1
    obtain ⟨hpc₃, hctl₃, t₂, ht₂, r₂⟩ := ih hpc₂ hctl₂
    exact ⟨hpc₃, hctl₃, t₁ + t₂, by omega, r₁.trans r₂⟩

theorem sim_halts (I : List Sym) (hinp : ∀ p, inCode (inp (p + 1)) = I.getD p codeEnd)
    (hv : ∀ x < L, (code x).Valid L) {c c' : Cfg S} {n : ℕ} (h : Steps I code c n c')
    (hpc : c.pc < L) (hctl : ∀ e ∈ c.ctl, e < L) (hend : code c'.pc = .ret) (hctl' : c'.ctl = []) :
    ∃ t, t ≤ 2 * n ∧ Halts gst (progOf code L pc0) (⟨c.pc, hpc⟩, false) (NLogN.enc inp c) t (NLogN.enc inp c') := by
  obtain ⟨hpc', -, t, ht, r⟩ := sim_steps (code := code) (L := L) (pc0 := pc0) (inp := inp) I hinp hv h hpc hctl
  refine ⟨t, ht, ?_⟩
  have := r.halts (Halts.done (sim_halt (code := code) (L := L) (pc0 := pc0) (inp := inp) c' hpc' hctl' hend false))
  simpa using this

end Sim

end NLogN

end

section
-- Source module: NLogNP.Top
namespace NLogN

open IntMul IntMul.Mach

variable {S P : ℕ}

theorem instrAt_valid (ent : Fin P → ℕ) (L : ℕ) (hent : ∀ j, ent j < L) :
    ∀ (s : Stmt S P) (a e x : ℕ) (ins : Instr S), a + s.size ≤ L → e < L →
      s.instrAt ent a e x = some ins → ins.Valid L := by
  intro s
  induction s with
  | skip | push | pop | inRd | out =>
    intro a e x ins _ he h
    simp only [Stmt.instrAt] at h; split_ifs at h; cases h; exact he
  | call j =>
    intro a e x ins _ he h
    simp only [Stmt.instrAt] at h; split_ifs at h; cases h; exact ⟨hent j, he⟩
  | seq p q ihp ihq =>
    intro a e x ins ha he h
    have hp := p.size_pos; have hq := q.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · exact ihp _ _ _ _ (by omega) (by omega) h
    · exact ihq _ _ _ _ (by omega) he h
  | ite i f p q ihp ihq =>
    intro a e x ins ha he h
    have hp := p.size_pos; have hq := q.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · cases h; exact ⟨by omega, by omega⟩
    · exact ihp _ _ _ _ (by omega) he h
    · exact ihq _ _ _ _ (by omega) he h
  | loop i f p ihp =>
    intro a e x ins ha he h
    have hp := p.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · cases h; exact ⟨by omega, he⟩
    · exact ihp _ _ _ _ (by omega) (by omega) h

theorem codeOf_valid (prog : Fin P → Stmt S P) :
    ∀ x < codeLen prog, (codeOf prog x).Valid (codeLen prog) := by
  intro x _
  unfold codeOf
  split
  · next j _ =>
    rcases h : (prog j).instrAt (fun j => entryOf prog j) (entryOf prog j)
      (entryOf prog j + (prog j).size) x with _ | ins
    · trivial
    · have hj := entryOf_le_codeLen prog j
      exact instrAt_valid (fun j => entryOf prog j) (codeLen prog)
        (fun j' => by have := entryOf_le_codeLen prog j'; omega)
        (prog j) _ _ _ _ (by omega) (by omega) h
  · trivial

theorem init_enc (L : ℕ) (x y : List Bool) :
    initTapes (syms L) (by omega : 2 ≤ S + 3) x y =
      NLogN.enc ((initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin) ⟨0, St.init S, []⟩ := by
  apply enc_eq_of
  · rfl
  · simp [initTapes, tin, St.init]
  · funext p; rcases p with _ | p <;> simp [initTapes, tout, St.init, tapeOf]
  · simp [initTapes, tout, St.init]
  · funext p; rcases p with _ | p <;> simp [initTapes, tctl, tapeOf]
  · simp [initTapes, tctl]
  · intro i; funext p; rcases p with _ | p <;> simp [initTapes, tst, St.init, tapeOf]
  · intro i; simp [initTapes, tst, St.init]

theorem init_inCode (L : ℕ) (x y : List Bool) (p : ℕ) :
    inCode ((initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin (p + 1)) =
      (inputCodes x y).getD p codeEnd := by
  simp only [initTapes, tin, if_true]
  have e : (x.map (fun b => if b then (syms L).one else (syms L).zero) ++
      (syms L).sep :: y.map (fun b => if b then (syms L).one else (syms L).zero)) =
      (inputCodes x y).map gsym := by
    simp only [inputCodes, List.map_append, List.map_map, List.map_cons]
    congr 1
    · congr 1; funext b; cases b <;> rfl
    · congr 1; congr 1; funext b; cases b <;> rfl
  rw [e]
  by_cases hp : p < (inputCodes x y).length
  · rw [List.getD_eq_getElem _ _ (by simpa using hp), List.getD_eq_getElem _ _ hp]
    simp [inCode, gsym]
  · rw [List.getD_eq_default _ _ (by simpa using hp), List.getD_eq_default _ _ (by omega)]
    rfl

end NLogN

end

section
open NLogN
open IntMul IntMul.Mach
variable {S P : ℕ}
theorem solution (prog : Fin P → Stmt S P) (hP : 0 < P) (n : ℕ) (T : ℝ)
    (h : ∀ x y : List Bool, x.length = n → y.length = n → ∃ σ' c,
      Exec (inputCodes x y) prog (prog ⟨0, hP⟩) (St.init S) σ' c ∧
        σ'.out = bin (2 * n) (val x * val y) ∧ (2 * c + 1 : ℝ) ≤ T) :
    MultipliesAt (machineOf prog hP) n T := by
  intro x y hx hy
  obtain ⟨σ', c, hexec, hout, hT⟩ := h x y hx hy
  set L := codeLen prog
  have hent0 : entryOf prog (⟨0, hP⟩ : Fin P) = 0 := by simp [entryOf]
  have hflat := exec_flat (progPlaced_codeOf prog) hexec _ _ ((progPlaced_codeOf prog) ⟨0, hP⟩).1 []
  simp only [hent0] at hflat
  have hret := ((progPlaced_codeOf prog) ⟨0, hP⟩).2
  simp only [hent0] at hret
  set inp := (initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin
  obtain ⟨t, ht, hh⟩ := sim_halts (code := codeOf prog) (L := L) (pc0 := ⟨0, codeLen_pos prog hP⟩)
    (inp := inp) (inputCodes x y) (init_inCode L x y) (codeOf_valid prog) hflat
    (codeLen_pos prog hP) (by simp) hret rfl
  have hrun : IntMul.Mach.Runs (syms L).st (progOf (codeOf prog) L ⟨0, codeLen_pos prog hP⟩)
      (initTapes (syms L) (by omega : 2 ≤ S + 3) x y) t (NLogN.enc inp ⟨0 + (prog ⟨0, hP⟩).size, σ', []⟩) := by
    rw [init_enc L x y]
    exact hh
  refine ⟨t + 1, ?_, compile_haltsWithOutput (syms L) (by omega) _ x y _ t _ hrun ?_⟩
  · have : (t : ℝ) ≤ 2 * c := by exact_mod_cast ht
    push_cast; linarith
  · show (NLogN.enc inp _).cells tout = _
    rw [enc_cells_tout]
    simp only [hout]
end
