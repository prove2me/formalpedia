-- Source module: Solutions.R6IL3Norm
/-!
# Round six, item language (I3): normal form of a `Prop8IfaceH` network

The item-language level procedure only implements **forward children on a prefix of slots**
(`child w (pref m s) ∅`): their bits are a contiguous stride-`K` block, exactly as a recursive
call needs them.  Every `Prop8IfaceH` network can be put in this form without changing its
denotation, its child widths or its gates:

* the sign set: `signedOp ch S neg = (-i)^{|N||κ|} Z_N ch(S) Z_N` (`N = neg ∩ S`), and `Z_N`,
  `(-i)^{|N||κ|} Z_N` are phase steps (`phase w 0 0 (2·1_N)`, `phase w 0 (3|N|) (2·1_N)`);
* the slot set: a slot permutation `σ` with `σ(pref) = S` conjugates the prefix child into the
  child on `S`, and every slot permutation is a product of slot swaps, each three row additions
  (`x_i ⊕= x_j` XOR-swap): `swap3`.

**`Prop8IfaceH.norm`**: the normalized network; `norm_child`: its children are prefix forward
children; `norm_gate`: its gates are gates of the original network.

`GClassH J A`: the gate class of the item-language implementation (atoms of the KFG gate
passes in the role numbering `roleEqv`: data `0 … W-1`, temporaries `W … W+T-1`, or `±1` role diagonals).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL3H

open Matrix Finset Complex Butterfly P8Lift IntMul.Kappa.R6.Cx

/-! ## Address maps -/

/-! ## Slot swaps and slot permutations as row additions -/

/-! ## Prefix slot sets -/

/-! ## Phases -/

/-! ## The normalized child -/

section Child

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ}

variable {κ : Type} [Fintype κ] [DecidableEq κ]

/-- The steps of a normalized step: row additions, sign phases, a prefix child, or the step. -/
theorem mem_normStep {st a : HStep R m} (ha : a ∈ normStep st) :
    a = st ∨ (∃ w i j h, a = HStep.rowAdd w i j h) ∨ (∃ w k₀ k₁ ph, a = HStep.phase w k₀ k₁ ph) ∨
      ∃ w s, a = HStep.child w (pref m s) ∅ ∧ ∃ S neg, st = HStep.child w S neg ∧ s = S.card := by
  cases st with
  | child w S neg =>
    simp only [normStep, normChild, fwdS, List.mem_append, List.mem_cons, List.not_mem_nil,
      or_false, or_assoc] at ha
    rcases ha with h | h | h | h | h
    · exact Or.inr (Or.inr (Or.inl ⟨_, _, _, _, h⟩))
    · obtain ⟨i, j, hij, h'⟩ := permSteps_rows _ _ a h
      exact Or.inr (Or.inl ⟨_, _, _, _, h'⟩)
    · exact Or.inr (Or.inr (Or.inr ⟨w, S.card, h, S, neg, rfl, rfl⟩))
    · obtain ⟨i, j, hij, h'⟩ := permSteps_rows _ _ a h
      exact Or.inr (Or.inl ⟨_, _, _, _, h'⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨_, _, _, _, h⟩))
  | _ => simp only [normStep, List.mem_cons, List.not_mem_nil, or_false] at ha; exact Or.inl ha

end Child

/-! ## The normalized network -/

namespace Prop8IfaceH'

variable {W T m : ℕ} {h : List (ℕ × ℕ)}

theorem norm_widths (J : Prop8IfaceH W T m h) : (norm J).widths = J.widths :=
  widths_flatMap_norm J.net

/-- Children of the normalized network are forward prefix children. -/
theorem norm_child (J : Prop8IfaceH W T m h) {w : Fin W ⊕ Fin T} {S neg : Finset (Fin m)}
    (hc : HStep.child w S neg ∈ (norm J).net) : neg = ∅ ∧ S = pref m S.card ∧ S.card < m := by
  obtain ⟨st, hst, ha⟩ := List.mem_flatMap.1 hc
  have hsm : ∀ S' neg', HStep.child w S' neg' ∈ J.net → S'.card < m := fun S' neg' h' =>
    J.small _ (List.mem_filterMap.2 ⟨_, h', rfl⟩)
  rcases mem_normStep ha with h1 | ⟨_, _, _, _, h1⟩ | ⟨_, _, _, _, h1⟩ | ⟨w', s, h1, S', neg', h2, h3⟩
  · subst h1
    simp only [normStep, normChild, fwdS, List.mem_append, List.mem_cons, List.not_mem_nil,
      or_false, or_assoc, HStep.child.injEq, reduceCtorEq, false_or] at ha
    rcases ha with h | ⟨h1, h2⟩ | h
    · obtain ⟨_, _, _, h'⟩ := permSteps_rows _ _ _ h; cases h'
    · exact ⟨h2.2, h2.1, hsm S neg hst⟩
    · obtain ⟨_, _, _, h'⟩ := permSteps_rows _ _ _ h; cases h'
  · cases h1
  · cases h1
  · cases h1
    subst h2 h3
    have hc' := hsm S' neg' hst
    refine ⟨rfl, ?_, ?_⟩
    · rw [card_pref hc'.le]
    · rw [card_pref hc'.le]; exact hc'

/-- Gates of the normalized network are gates of the network. -/
theorem norm_gate (J : Prop8IfaceH W T m h) {G : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) ℂ}
    (hg : HStep.gate G ∈ (norm J).net) : HStep.gate G ∈ J.net := by
  obtain ⟨st, hst, ha⟩ := List.mem_flatMap.1 hg
  rcases mem_normStep ha with h1 | ⟨_, _, _, _, h1⟩ | ⟨_, _, _, _, h1⟩ | ⟨_, _, h1, _⟩
  · rw [h1]; exact hst
  · cases h1
  · cases h1
  · cases h1

end Prop8IfaceH'

/-! ## The gate class -/

theorem GClassH.norm {W T m : ℕ} {h : List (ℕ × ℕ)} {J : Prop8IfaceH W T m h} {A : ℕ}
    (hJ : GClassH J A) : GClassH (Prop8IfaceH'.norm J) A :=
  fun G hG => hJ G (Prop8IfaceH'.norm_gate J hG)

end IntMul.Kappa.R6.IL3H

end

