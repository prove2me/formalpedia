open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
theorem solution
    {s h Q J ε : ℝ} (hε : 0 < ε)
    {I : Set ℝ} {f m N w p a : ℝ → ℝ}
    (hP : PaperData I f m N w p a)
    (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J)
    (htail : Set.Ioi (s + ε⁻¹) ⊆ I)
    {f₁ b₁ a₁ C_F C_b C_A : ℝ}
    (_hCF : 0 ≤ C_F) (_hCb : 0 ≤ C_b) (_hCA : 0 ≤ C_A)
    (hvalF : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pull  s f x - (1 + f₁ * x)| ≤ C_F * x ^ 2)
    (hvalb : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pullM s m x - (1 + b₁ * x)| ≤ C_b * x ^ 2)
    (hvalA : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pull  s a x - a₁ * x|       ≤ C_A * x ^ 2) :
    Tendsto (deriv (pull  s f)) (𝓝[>] (0:ℝ)) (𝓝 f₁) ∧
    Tendsto (deriv (pullM s m)) (𝓝[>] (0:ℝ)) (𝓝 b₁) ∧
    Tendsto (deriv (pull  s a)) (𝓝[>] (0:ℝ)) (𝓝 a₁) ∧
    f₁ - 2 * b₁ = h := by
  have hsubI : Ioo (0:ℝ) ε ⊆ {y | y ≠ 0 ∧ s + y⁻¹ ∈ I} := by
    intro x hx
    refine ⟨hx.1.ne', htail ?_⟩
    show s + ε⁻¹ < s + x⁻¹
    linarith [(inv_lt_inv₀ hε hx.1).mpr hx.2]
  have hcF : ContDiffOn ℝ ∞ (pull s f) (Ioo (0:ℝ) ε) :=
    (contDiffOn_pull (I := I) (s := s) hP.cf).mono hsubI
  have hcb : ContDiffOn ℝ ∞ (pullM s m) (Ioo (0:ℝ) ε) :=
    (contDiffOn_pullM (I := I) (s := s) hP.cm).mono hsubI
  have hcA : ContDiffOn ℝ ∞ (pull s a) (Ioo (0:ℝ) ε) :=
    (contDiffOn_pull (I := I) (s := s) hP.ca).mono hsubI
  have hR := vii04_compactified_bridge_Ioo hP hN hB hε htail
  exact core_L1 hε (hd1 hcF) (hd2 hcF) (hd1 hcb) (hd2 hcb) (hd1 hcA) (hd2 hcA)
    (fun x hx => (hR x hx).1) (fun x hx => (hR x hx).2.2.1) (fun x hx => (hR x hx).2.2.2.1)
    hvalF hvalb hvalA
