      4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1)))) * X := by
  have hX0 : 0 ≤ X := (abs_nonneg _).trans (hX 0 hs)
  obtain ⟨ci1, ci2, ci3⟩ := hB.cover i hi
  set f : ℤ → ℝ := fun h => eEx s t α i h * x ((((i : ℤ) + h) % s).toNat) with hf
  have hfs := (sumN hs hst hx1 x X hX i).1
  set Fb : Finset ℤ := (blS B i).image (fun k : ℕ => (k : ℤ) - i)
