-- title:
--   Restriction of Hecke algebras along a division of levels
-- statement:
--   Let $N$ and $N'$ be non-zero natural numbers with $N \mid N'$, let $k$ be an integer weight, and let $S$ be a set of natural numbers such that every prime $q$ dividing $N'$ lies in $S$. For a level $M$, [`CuspForm.heckeAlgebra M k S`](def/CuspForm_HeckeAlgebra.html#L18) denotes the $\mathbb{Z}$-subalgebra of $\operatorname{End}_{\mathbb{C}} S_k(\Gamma_0(M))$ generated by the operators `heckeTLin` attached to primes $\ell \nmid M$ with $\ell \notin S$ together with the operators `heckeULin` attached to primes $q \mid M$ with $q \notin S$; under the hypothesis on $S$ the latter family is empty for both $M = N$ and $M = N'$, so both algebras are generated by the $T_\ell$ alone. The assertion is that there exists a ring homomorphism $\mathrm{res} \colon$ `heckeAlgebra N' k S` $\to$ `heckeAlgebra N k S` which is surjective, which sends the generator [`CuspForm.heckeAlgebra.T`](def/CuspForm_HeckeAlgebra.html#L77) for a prime $\ell$ with $\ell \nmid N'$, $\ell \nmid N$ and $\ell \notin S$ to the corresponding generator at level $N$, and which is compatible with the inclusion of cusp forms in the following sense: for every $t$ in `heckeAlgebra N' k S`, every $f \in S_k(\Gamma_0(N))$ and every $g \in S_k(\Gamma_0(N'))$ whose underlying function on the upper half-plane equals that of $f$, the endomorphism $\mathrm{res}(t)$ applied to $f$ and $t$ applied to $g$ have equal underlying functions.
--
--   This is the elementary oldform compatibility of Hecke operators with change of level: the anemic Hecke algebra at level $N'$ restricts, along the inclusion $S_k(\Gamma_0(N)) \subseteq S_k(\Gamma_0(N'))$ of cusp forms with the same underlying function, onto the anemic Hecke algebra at level $N$, matching $T_\ell$ with $T_\ell$. It is used in the constructions of ring homomorphisms out of Hecke algebras and their localisations at maximal ideals, in particular in the passage between levels needed for level lowering.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_heckeAlgebra_exists_surjective_ringHom_of_dvd.lean

import Definitions.Def_CuspForm_HeckeAlgebra

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem CuspForm.heckeAlgebra.exists_surjective_ringHom_of_dvd
    (N N' : ℕ) [NeZero N] [NeZero N'] (hNN' : N ∣ N') (k : ℤ) (S : Set ℕ)
    (hN'S : ∀ q : ℕ, q.Prime → q ∣ N' → q ∈ S) :
    ∃ res : CuspForm.heckeAlgebra N' k S →+* CuspForm.heckeAlgebra N k S,
      Function.Surjective res ∧
      (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN' : ¬ ℓ ∣ N') (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S),
        res (CuspForm.heckeAlgebra.T hℓ hℓN' hℓS) = CuspForm.heckeAlgebra.T hℓ hℓN hℓS) ∧
      ∀ (t : CuspForm.heckeAlgebra N' k S) (f : CuspForm (CongruenceSubgroup.Gamma0 N) k)
        (g : CuspForm (CongruenceSubgroup.Gamma0 N') k), ⇑g = ⇑f →
        ⇑((res t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)) f) =
          ⇑((t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N') k)) g) := by sorry
