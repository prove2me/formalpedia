variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]
  {Γ : Type*} [Monoid Γ] {X : Type*} [AddCommGroup X] [DistribMulAction Γ X]

private theorem eq_zero_of_forall_apply_eq_natCast_smul {J : Type*} (ι : J → V →+ X) (N : Set X)
    (hιN : ∀ j v, ι j v ∈ N) (hι : ∀ v : V, (∀ j, ι j v = 0) → v = 0)
    (ρ : Γ → V →ₗ[k] V) (S : Set Γ) (hιρ : ∀ j, ∀ σ ∈ S, ∀ v, ι j (ρ σ v) = σ • ι j v)
    (c : Γ → ℕ) (hN : ∀ x ∈ N, (∀ σ ∈ S, σ • x = c σ • x) → x = 0)
    (v : V) (hv : ∀ σ ∈ S, ρ σ v = (c σ : k) • v) : v = 0 := by
  refine hι v (fun j => hN _ (hιN j v) (fun σ hσ => ?_))
  rw [← hιρ j σ hσ v, hv σ hσ, Nat.cast_smul_eq_nsmul, map_nsmul]

private theorem eq_zero_of_forall_apply_eq {J : Type*} (ι : J → V →+ X) (N : Set X)
    (hιN : ∀ j v, ι j v ∈ N) (hι : ∀ v : V, (∀ j, ι j v = 0) → v = 0)
    (ρ : Γ → V →ₗ[k] V) (S : Set Γ) (hιρ : ∀ j, ∀ σ ∈ S, ∀ v, ι j (ρ σ v) = σ • ι j v)
    (hN : ∀ x ∈ N, (∀ σ ∈ S, σ • x = x) → x = 0)
    (v : V) (hv : ∀ σ ∈ S, ρ σ v = v) : v = 0 :=
  eq_zero_of_forall_apply_eq_natCast_smul ι N hιN hι ρ S hιρ (fun _ => 1)
    (fun x hx h => hN x hx (fun σ hσ => by rw [h σ hσ, one_smul])) v
    (fun σ hσ => by rw [hv σ hσ, Nat.cast_one, one_smul])

end Embed
