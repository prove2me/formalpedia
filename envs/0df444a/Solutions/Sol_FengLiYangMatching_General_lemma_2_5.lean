lemma retain_accounting {n : ℕ} (G : SimpleGraph (Fin n)) (M : EdgeSet n) (hM : IsMatching M)
    (a b : ℝ) (hab : a ≤ b) (t : Times G) :
    2 * ((shadowAt G t b).card - (shadowAt G t a).card : ℝ) ≥
      U G M t a - U G M t b + (M2 G M a b t).card := by
  have hsub := shadowAt_mono G t a b hab
  have h := unmatched_extension_bound M hM (shadowAt G t a) (shadowAt G t b \ shadowAt G t a)
  rw [Finset.union_sdiff_of_subset hsub] at h
  have hr := Nat.cast_le (α:=ℝ).mpr h
  simp only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat] at hr
  rw [Finset.card_sdiff_of_subset hsub, Nat.cast_sub (Finset.card_le_card hsub)] at hr
  change 2 * ((shadowAt G t b).card - (shadowAt G t a).card : ℝ) ≥
    ((M.filter (free (shadowAt G t a))).card : ℝ) - (M.filter (free (shadowAt G t b))).card +
      (M ∩ (shadowAt G t b \ shadowAt G t a)).card
  linarith

end
