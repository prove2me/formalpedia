-- title:
--   Lemma 3.7: Bloch data of a traceless jump
-- statement:
--   Let $L=a\cdot\sigma$ be a nonzero traceless qubit jump, where $a=\alpha+i\beta\in\mathbb C^3$, where $\sigma=(\sigma_x,\sigma_y,\sigma_z)$ is the standard Pauli triple, and use $\rho(v)=(I+v\cdot\sigma)/2$. The operator dissipator $D_L(\rho)=L\rho L^\dagger-\{L^\dagger L,\rho\}/2$ induces $\dot v=Qv+b$, where
--
--   $$Q=2(\alpha\alpha^{\mathsf T}+\beta\beta^{\mathsf T}-|a|^2I),\qquad b=4\alpha\times\beta.$$
--
--   The coordinate coefficients extracted from the actual matrix action equal these formulas. The matrix $Q$ is symmetric and negative semidefinite, so the channel has no intrinsic rotation. For every finite coherent control list, any Hamiltonian direction in the Lie algebra generated by that list and $D_L$ is a sum of an element of the control Lie algebra and a linear combination of brackets of generated elements.
--
--   The formula fixes the affine translation sign and separates direct dissipation from Hamiltonian directions produced by brackets.
-- source:
--   Lie-Wedge Stratification and Pure-State Stabilizability in Single- Channel Qubit Control, arXiv:2610.00046v1, PDF p. 11, Lemma 3.7

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P59

noncomputable section

open scoped Matrix ComplexOrder

namespace QAlgorithms.Papers.Independent.Information100.P59

attribute [local instance 100] LieRing.ofAssociativeRing

/-- arXiv:2610.00046v1 PDF pp.11--12, Lemma 3.7. Coordinate extraction is from
D_L, so the displayed Q and b are conclusions rather than definitions of D_L.
The final clause expresses Hamiltonian generation modulo bracket directions. -/
theorem tracelessJumpBlochData (a : Cvec) (ha : a ≠ 0) :
    operatorQ a = channelQ a ∧ operatorB a = channelB a ∧
    (∀ v : Vec, dissipator (jump a) (blochState v) =
      (2⁻¹ : ℂ) • jump (fun j => (((channelQ a).mulVec v) j + channelB a j : ℝ))) ∧
    (operatorQ a).transpose = operatorQ a ∧
    (∀ v : Vec, (∑ i, v i * ((operatorQ a).mulVec v) i) ≤ 0) ∧
    (∀ axes : Finset Vec, ∀ n : Vec,
      controlBlock n ∈ generatedAlgebra (axes : Set Vec) a →
      ∃ C ∈ controlAlgebra (axes : Set Vec),
        ∃ B ∈ bracketDirections (generatedAlgebra (axes : Set Vec) a),
          controlBlock n = C + B) := by sorry

end QAlgorithms.Papers.Independent.Information100.P59

end
