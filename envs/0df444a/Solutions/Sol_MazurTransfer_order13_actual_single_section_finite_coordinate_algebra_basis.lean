/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: the distinct polynomial degrees of the actual parameter
powers and generator products. Named downstream consumer: the actual
R[T]-linear independence of 1,p,q. Canonical x-polynomial scalars are used.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionWeightedPolynomialCoordinates
open Polynomial
open MazurTorsion.XOneThirteenAffineCurve
open Order13SingleSectionFiniteMapIdentities
open Order13SingleSectionPowerCoordinates
variable (R : Type u) [CommRing R] [IsDomain R]

def firstComponent : CoordinateRing R →ₗ[R] Polynomial R :=
  (LinearMap.fst R (Polynomial R) (Polynomial R)).comp
    ((coordinates R).toLinearMap.restrictScalars R)

theorem first_expansion (A B : Polynomial R) :
    firstComponent R (AdjoinRoot.of (affineEquation R) A +
      AdjoinRoot.of (affineEquation R) B * yCoordinate R) = A := by
  change (coordinates R _).1 = A
  exact congrArg Prod.fst (QuadraticCoordinates.coordinates_of_add_of_mul_root
    (Polynomial R) (sexticPolynomial R) A B)

theorem first_power (n : ℕ) :
    firstComponent R (t R ^ n) = (powerCoordinates R n).1 := by
  rw [power_expansion, first_expansion]

omit [IsDomain R] in
theorem p_power_expansion (n : ℕ) :
    p R * t R ^ n =
      AdjoinRoot.of (affineEquation R) (X * (powerCoordinates R (n + 1)).1) +
        AdjoinRoot.of (affineEquation R) (X * (powerCoordinates R (n + 1)).2) *
          yCoordinate R := by
  rw [p, mul_assoc, ← pow_succ', power_expansion]
  simp only [map_mul]
  change AdjoinRoot.of (affineEquation R) X * _ = _
  ring

omit [IsDomain R] in
theorem q_power_expansion (n : ℕ) :
    q R * t R ^ n =
      AdjoinRoot.of (affineEquation R)
        (X ^ 2 * (powerCoordinates R (n + 1)).1 + 2 * X * (powerCoordinates R n).1) +
      AdjoinRoot.of (affineEquation R)
        (X ^ 2 * (powerCoordinates R (n + 1)).2 + 2 * X * (powerCoordinates R n).2) *
          yCoordinate R := by
  have hq : q R * t R ^ n =
      xCoordinate R ^ 2 * t R ^ (n + 1) + 2 * xCoordinate R * t R ^ n := by
    rw [pow_succ]
    dsimp [q, p]
    ring
  rw [hq, power_expansion, power_expansion]
  simp only [map_add, map_mul, map_pow, _root_.map_ofNat]
  change AdjoinRoot.of (affineEquation R) X ^ 2 * _ +
    2 * AdjoinRoot.of (affineEquation R) X * _ = _
  ring

theorem first_p_power (n : ℕ) :
    firstComponent R (p R * t R ^ n) = X * (powerCoordinates R (n + 1)).1 := by
  rw [p_power_expansion, first_expansion]

theorem first_q_power (n : ℕ) :
    firstComponent R (q R * t R ^ n) =
      X ^ 2 * (powerCoordinates R (n + 1)).1 + 2 * X * (powerCoordinates R n).1 := by
  rw [q_power_expansion, first_expansion]

def weightedPowers : Fin 3 × ℕ → CoordinateRing R
  | (i,n) => if i = 0 then t R ^ n else if i = 1 then p R * t R ^ n else q R * t R ^ n

def weight : Fin 3 × ℕ → ℕ
  | (i,n) => if i = 0 then 3 * n else if i = 1 then 3 * n + 4 else 3 * n + 5

theorem weight_injective : Function.Injective weight := by
  rintro ⟨i,n⟩ ⟨j,m⟩ h
  fin_cases i <;> fin_cases j <;> simp [weight] at h <;>
    congr <;> omega

theorem first_power_degree (h2 : (2 : R) ≠ 0) (n : ℕ) :
    (firstComponent R (t R ^ n)).natDegree = 3 * n := by
  rw [first_power]
  cases n with
  | zero => simp
  | succ n => exact (power_coordinates_degree_and_leadingCoeff R h2 n).1

theorem first_p_power_degree (h2 : (2 : R) ≠ 0) (n : ℕ) :
    (firstComponent R (p R * t R ^ n)).natDegree = 3 * n + 4 := by
  obtain ⟨hd, hc, -⟩ := power_coordinates_degree_and_leadingCoeff R h2 n
  have hA : (powerCoordinates R (n + 1)).1 ≠ 0 := by
    intro h
    apply hc.trans_ne (pow_ne_zero _ h2)
    rw [h, leadingCoeff_zero]
  rw [first_p_power, natDegree_X_mul hA, hd]
  omega

theorem first_q_power_degree (h2 : (2 : R) ≠ 0) (n : ℕ) :
    (firstComponent R (q R * t R ^ n)).natDegree = 3 * n + 5 := by
  obtain ⟨hd, hc, -⟩ := power_coordinates_degree_and_leadingCoeff R h2 n
  have hA : (powerCoordinates R (n + 1)).1 ≠ 0 := by
    intro h
    apply hc.trans_ne (pow_ne_zero _ h2)
    rw [h, leadingCoeff_zero]
  have hdtop : (X ^ 2 * (powerCoordinates R (n + 1)).1).natDegree = 3 * n + 5 := by
    rw [natDegree_X_pow_mul _ hA, hd]
    omega
  have hdlower : (2 * X * (powerCoordinates R n).1).natDegree ≤ 3 * n + 1 := by
    have hdn : (powerCoordinates R n).1.natDegree ≤ 3 * n := by
      rw [← first_power, first_power_degree R h2]
    have hd2X : (2 * X : Polynomial R).natDegree ≤ 1 := by compute_degree!
    exact (natDegree_mul_le.trans (Nat.add_le_add hd2X hdn)).trans (by omega)
  rw [first_q_power, natDegree_add_eq_left_of_natDegree_lt (by omega :
    (2 * X * (powerCoordinates R n).1).natDegree <
      (X ^ 2 * (powerCoordinates R (n + 1)).1).natDegree), hdtop]

theorem weighted_first_degree (h2 : (2 : R) ≠ 0) (i : Fin 3 × ℕ) :
    (firstComponent R (weightedPowers R i)).natDegree = weight i := by
  rcases i with ⟨i,n⟩
  fin_cases i
  · simpa [weightedPowers, weight] using first_power_degree R h2 n
  · simpa [weightedPowers, weight] using first_p_power_degree R h2 n
  · simpa [weightedPowers, weight] using first_q_power_degree R h2 n

theorem weighted_first_nonzero (h2 : (2 : R) ≠ 0) (i : Fin 3 × ℕ) :
    firstComponent R (weightedPowers R i) ≠ 0 := by
  rcases i with ⟨i,n⟩
  by_cases hn : n = 0
  · subst n
    fin_cases i
    · have hf := first_power R 0
      simpa [weightedPowers] using hf.trans_ne (one_ne_zero : (1 : Polynomial R) ≠ 0)
    · intro h
      have hd := first_p_power_degree R h2 0
      simp [weightedPowers] at h
      simp only [pow_zero, mul_one] at hd
      rw [h, natDegree_zero] at hd
      norm_num [weight] at hd
    · intro h
      have hd := first_q_power_degree R h2 0
      simp [weightedPowers] at h
      simp only [pow_zero, mul_one] at hd
      rw [h, natDegree_zero] at hd
      norm_num [weight] at hd
  · intro h
    have hd := weighted_first_degree R h2 (i,n)
    rw [h, natDegree_zero] at hd
    fin_cases i <;> simp [weight] at hd <;> omega

end MazurTransfer.Order13SingleSectionWeightedPolynomialCoordinates
#print axioms MazurTransfer.Order13SingleSectionWeightedPolynomialCoordinates.weighted_first_degree
#print axioms MazurTransfer.Order13SingleSectionWeightedPolynomialCoordinates.weighted_first_nonzero

end
end

