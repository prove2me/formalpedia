    ∃ e, 1 ≤ e ∧ tBD n D i = 2 ^ e := by
  refine ⟨axExp (IntMul.OpenAI.Glue.LP n) (D + 1) i, ?_, tBD_eq hn hD i⟩
  have := ell_ge hn hD
  rcases axExp_cases (IntMul.OpenAI.Glue.LP n) (D + 1) i with h | h <;> omega

