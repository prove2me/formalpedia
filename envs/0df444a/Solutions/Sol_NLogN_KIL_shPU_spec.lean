-- Source module: Solutions.KIL4Sim
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS

section ESimLemmas

variable {π : PMap} {s : IState HS}

theorem ESim.eval_eq (hs : PV π s) {e e' : Ex HS} (h : ESim π e e') : e'.eval s = e.eval s := by
  induction h with
  | reg i => rfl
  | lit c => rfl
  | par hi =>
    obtain ⟨L, hL⟩ := hs _ _ hi
    exact IState.top_eq hL
  | add _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | neg _ iha => simp only [Ex.eval, iha]
  | mul _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | shl _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | quo _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | rem _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | pow2 _ iha => simp only [Ex.eval, iha]
  | sel _ _ _ ihc iha ihb => simp only [Ex.eval, ihc, iha, ihb]
  | ndiv _ _ iha ihb => simp only [Ex.eval, iha, ihb]
  | nmod _ _ iha ihb => simp only [Ex.eval, iha, ihb]

theorem ESim.ok (hs : PV π s) {e e' : Ex HS} (h : ESim π e e') : e.ok s → e'.ok s := by
  induction h with
  | reg i => exact id
  | lit c => exact id
  | par hi =>
    intro _
    obtain ⟨L, hL⟩ := hs _ _ hi
    exact IState.isInt_of hL
  | add _ _ iha ihb => exact fun h => ⟨iha h.1, ihb h.2⟩
  | neg _ iha => exact iha
  | mul _ _ iha ihb => exact fun h => ⟨iha h.1, ihb h.2⟩
  | shl ha hb iha ihb =>
    intro h; refine ⟨iha h.1, ihb h.2.1, ?_⟩; rw [hb.eval_eq hs]; exact h.2.2
  | quo ha hb iha ihb =>
    intro h; refine ⟨iha h.1, ihb h.2.1, ?_⟩; rw [hb.eval_eq hs]; exact h.2.2
  | rem ha hb iha ihb =>
    intro h; refine ⟨iha h.1, ihb h.2.1, ?_⟩; rw [hb.eval_eq hs]; exact h.2.2
  | pow2 ha iha => intro h; exact ⟨iha h.1, by rw [ha.eval_eq hs]; exact h.2⟩
  | sel hc ha hb ihc iha ihb =>
    intro h
    refine ⟨ihc h.1, ?_⟩
    have h2 := h.2
    rw [hc.eval_eq hs]
    split_ifs at h2 ⊢
    · exact iha h2
    · exact ihb h2
  | ndiv ha hb iha ihb =>
    intro h; refine ⟨iha h.1, ihb h.2.1, ?_, ?_⟩
    · rw [ha.eval_eq hs]; exact h.2.2.1
    · rw [hb.eval_eq hs]; exact h.2.2.2
  | nmod ha hb iha ihb =>
    intro h; refine ⟨iha h.1, ihb h.2.1, ?_, ?_⟩
    · rw [ha.eval_eq hs]; exact h.2.2.1
    · rw [hb.eval_eq hs]; exact h.2.2.2

theorem ESim.regs_sub {e e' : Ex HS} (h : ESim π e e') :
    ∀ j ∈ e'.regs, j ∈ e.regs ∨ ∃ v, π j = some v := by
  induction h with
  | reg i => intro j hj; exact Or.inl hj
  | lit c => intro j hj; simp [Ex.regs] at hj
  | par hi =>
    intro j hj
    simp only [Ex.regs, List.mem_singleton] at hj
    subst hj; exact Or.inr ⟨_, hi⟩
  | add _ _ iha ihb | mul _ _ iha ihb | shl _ _ iha ihb | quo _ _ iha ihb | rem _ _ iha ihb
  | ndiv _ _ iha ihb | nmod _ _ iha ihb =>
    intro j hj
    simp only [Ex.regs, List.mem_append] at hj ⊢
    rcases hj with hj | hj
    · rcases iha j hj with h | h
      · exact Or.inl (Or.inl h)
      · exact Or.inr h
    · rcases ihb j hj with h | h
      · exact Or.inl (Or.inr h)
      · exact Or.inr h
  | neg _ iha | pow2 _ iha =>
    intro j hj
    simp only [Ex.regs] at hj ⊢
    exact iha j hj
  | sel _ _ _ ihc iha ihb =>
    intro j hj
    simp only [Ex.regs, List.mem_append] at hj ⊢
    rcases hj with (hj | hj) | hj
    · rcases ihc j hj with h | h
      · exact Or.inl (Or.inl (Or.inl h))
      · exact Or.inr h
    · rcases iha j hj with h | h
      · exact Or.inl (Or.inl (Or.inr h))
      · exact Or.inr h
    · rcases ihb j hj with h | h
      · exact Or.inl (Or.inr h)
      · exact Or.inr h

theorem ESim.clean (hπ : PLow π) {e e' : Ex HS} (h : ESim π e e') (hc : e.Clean) : e'.Clean := by
  intro j hj
  rcases h.regs_sub j hj with h1 | ⟨v, hv⟩
  · exact hc j h1
  · exact (clean_of_lt (hπ j v hv)) j (by simp [Ex.regs])

theorem par_cost (v : ℤ) : dupCost (zsz v) + 17 ≤ 200 * (zsz v + 2) := by
  unfold dupCost zipCost moveCost; omega

theorem ESim.cost_le (hs : PV π s) {e e' : Ex HS} (h : ESim π e e') :
    e'.cost s ≤ 200 * e.cost s := by
  induction h with
  | reg i => simp only [Ex.cost]; omega
  | lit c => simp only [Ex.cost]; omega
  | par hi =>
    obtain ⟨L, hL⟩ := hs _ _ hi
    simp only [Ex.cost, IState.top_eq hL]
    exact par_cost _
  | add ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | neg _ iha => simp only [Ex.cost]; omega
  | mul ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | shl ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | quo ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | rem ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | pow2 ha iha =>
    simp only [Ex.cost, ha.eval_eq hs]; nlinarith
  | sel hc ha hb ihc iha ihb =>
    simp only [Ex.cost, hc.eval_eq hs]
    split_ifs <;> nlinarith
  | ndiv ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith
  | nmod ha hb iha ihb =>
    simp only [Ex.cost, ha.eval_eq hs, hb.eval_eq hs]; nlinarith

end ESimLemmas

theorem RSim.writes_eq {π : PMap} {p p' : RS} (h : RSim π p p') : p'.writes = p.writes := by
  induction h with
  | skip => rfl
  | asg i _ => rfl
  | push i _ => rfl
  | pop i => rfl
  | seq _ _ iha ihb => simp only [RS.writes, iha, ihb]
  | ite _ _ _ iha ihb => simp only [RS.writes, iha, ihb]
  | rep i _ _ ihb => simp only [RS.writes, ihb]

theorem PV.of_G {π : PMap} {s t : IState HS} (hs : PV π s)
    (h : ∀ i v, π i = some v → t.G i = s.G i) : PV π t := by
  intro i v hi
  rw [h i v hi]; exact hs i v hi

/-- The iterate states of `rep` keep every stack outside `i :: b.writes`. -/
theorem repSt_G_of_not_mem (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (j : Fin HS)
    (hji : j ≠ i) (hj : j ∉ b.writes) : ∀ k, (repSt i n b s k).G j = s.G j := by
  intro k
  induction k with
  | zero => simp [repSt, IState.upd_G, hji]
  | succ k ih =>
    simp only [repSt] at ih ⊢
    rw [Function.iterate_succ_apply']
    generalize ((fun t => decSt i (b.run t))^[k] (s.upd i (.int (n.eval s) :: s.G i))) = X at ih ⊢
    simp only [decSt, IState.upd_G, if_neg hji]
    rw [RS.run_G_of_not_mem b X j hj, ih]

/-- **The simulation theorem.** -/
theorem RSim.sim {π : PMap} (hπ : PLow π) {p p' : RS} (h : RSim π p p') :
    (∀ i v, π i = some v → i ∉ p.writes) → ∀ s, PV π s → p.ok s →
      p'.ok s ∧ p'.run s = p.run s ∧ p'.cost s ≤ 200 * p.cost s := by
  induction h with
  | skip => intro _ s _ _; exact ⟨trivial, rfl, by simp [RS.cost]⟩
  | asg i he =>
    intro _ s hs hok
    obtain ⟨hi, hc, ho, hint⟩ := hok
    refine ⟨⟨hi, he.clean hπ hc, he.ok hs ho, hint⟩, ?_, ?_⟩
    · simp only [RS.run, he.eval_eq hs]
    · simp only [RS.cost, asgCost, he.eval_eq hs]
      have := he.cost_le hs; omega
  | push i he =>
    intro _ s hs hok
    obtain ⟨hi, hc, ho⟩ := hok
    refine ⟨⟨hi, he.clean hπ hc, he.ok hs ho⟩, ?_, ?_⟩
    · simp only [RS.run, he.eval_eq hs]
    · simp only [RS.cost, he.eval_eq hs]
      have := he.cost_le hs; omega
  | pop i => intro _ s _ hok; exact ⟨hok, rfl, by simp only [RS.cost]; omega⟩
  | seq ha hb iha ihb =>
    intro hw s hs hok
    have hwa : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inl h')
    have hwb : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inr h')
    obtain ⟨o1, r1, c1⟩ := iha hwa s hs hok.1
    have hs' : PV π (_ : IState HS) := hs.of_G (t := RS.run _ s)
      (fun i v hv => RS.run_G_of_not_mem _ s i (hwa i v hv))
    obtain ⟨o2, r2, c2⟩ := ihb hwb _ hs' hok.2
    refine ⟨⟨o1, by rw [r1]; exact o2⟩, ?_, ?_⟩
    · simp only [RS.run, r1, r2]
    · simp only [RS.cost, r1]; omega
  | ite hc ha hb iha ihb =>
    intro hw s hs hok
    have hwa : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inl h')
    have hwb : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inr h')
    obtain ⟨hcl, hco, hbr⟩ := hok
    have he := hc.eval_eq hs
    refine ⟨⟨hc.clean hπ hcl, hc.ok hs hco, ?_⟩, ?_, ?_⟩
    · rw [he]
      split_ifs at hbr ⊢
      · exact (iha hwa s hs hbr).1
      · exact (ihb hwb s hs hbr).1
    · simp only [RS.run, he]
      split_ifs at hbr ⊢
      · exact (iha hwa s hs hbr).2.1
      · exact (ihb hwb s hs hbr).2.1
    · simp only [RS.cost, he]
      have := hc.cost_le hs
      split_ifs at hbr ⊢
      · have := (iha hwa s hs hbr).2.2; omega
      · have := (ihb hwb s hs hbr).2.2; omega
  | @rep i n n' b b' hn hb ihb =>
    intro hw s hs hok
    have hwb : ∀ j v, π j = some v → j ∉ b.writes := fun j v hv h' =>
      hw j v hv (by simp only [RS.writes, List.mem_cons]; exact Or.inr h')
    have hwi : ∀ j v, π j = some v → j ≠ i := fun j v hv h' =>
      hw j v hv (by simp only [RS.writes, List.mem_cons]; exact Or.inl h')
    obtain ⟨hi, hnc, hno, hn0, hiw, hbok⟩ := hok
    have he := hn.eval_eq hs
    set N := (n.eval s).toNat
    -- the iterate states of `p` keep the parameters
    have hPV : ∀ k, PV π (repSt i n b s k) := fun k =>
      hs.of_G (fun j v hv => repSt_G_of_not_mem i n b s j (hwi j v hv) (hwb j v hv) k)
    have hstep : ∀ k < N, b'.ok (repSt i n b s k) ∧ b'.run (repSt i n b s k) = b.run (repSt i n b s k) ∧
        b'.cost (repSt i n b s k) ≤ 200 * b.cost (repSt i n b s k) :=
      fun k hk => ihb hwb _ (hPV k) (hbok k hk)
    have hst : ∀ k ≤ N, repSt i n' b' s k = repSt i n b s k := by
      intro k hk
      induction k with
      | zero => simp only [repSt, Function.iterate_zero, id, he]
      | succ k ih =>
        simp only [repSt] at ih ⊢
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih (by omega)]
        have := (hstep k (by omega)).2.1
        simp only [repSt] at this
        rw [this]
    have hN' : (n'.eval s).toNat = N := by rw [he]
    have hw' : b'.writes = b.writes := hb.writes_eq
    refine ⟨⟨hi, hn.clean hπ hnc, hn.ok hs hno, by rw [he]; exact hn0, by rw [hw']; exact hiw,
      fun k hk => ?_⟩, ?_, ?_⟩
    · rw [hN'] at hk
      rw [hst k hk.le]; exact (hstep k hk).1
    · simp only [RS.run]
      rw [hN']
      have := hst N le_rfl
      simp only [repSt] at this
      rw [he] at this ⊢
      rw [this]
    · simp only [RS.cost, he]
      rw [show (n'.eval s).toNat = N from hN'] at *
      have hsum : (∑ k ∈ Finset.range N, (b'.cost (repSt i n' b' s k) +
          asgCost i (decE i) (b'.run (repSt i n' b' s k)) + 30)) ≤
          200 * (∑ k ∈ Finset.range N, (b.cost (repSt i n b s k) +
          asgCost i (decE i) (b.run (repSt i n b s k)) + 30)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum fun k hk => ?_
        rw [Finset.mem_range] at hk
        rw [hst k hk.le, (hstep k hk).2.1]
        have := (hstep k hk).2.2
        omega
      have := hn.cost_le hs
      simp only [N] at hsum
      omega

/-- **Specifications transfer along a simulation.** -/
theorem Sp.sim {π : PMap} (hπ : PLow π) {p p' : RS} (h : RSim π p p')
    (hw : ∀ i v, π i = some v → i ∉ p.writes) {s t : IState HS} (hs : PV π s) {c : ℕ}
    (H : Sp p s t c) : Sp p' s t (200 * c) := by
  obtain ⟨o, r, co⟩ := h.sim hπ hw s hs H.1
  exact ⟨o, r.trans H.2.1, le_trans co (Nat.mul_le_mul_left 200 H.2.2)⟩

theorem pmOf_some {l : List (Fin HS × ℤ)} {i : Fin HS} {v : ℤ} (h : pmOf l i = some v) :
    (i, v) ∈ l := by
  induction l with
  | nil => simp [pmOf] at h
  | cons p l ih =>
    obtain ⟨j, w⟩ := p
    simp only [pmOf] at h
    split_ifs at h with hij
    · cases h; subst hij; exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

theorem PV.of_list {l : List (Fin HS × ℤ)} {s : IState HS}
    (h : ∀ p ∈ l, ∃ L, s.G p.1 = .int p.2 :: L) : PV (pmOf l) s :=
  fun _ _ hv => h _ (pmOf_some hv)

theorem PLow.of_idx {l : List (Fin HS × ℤ)} (h : ∀ i ∈ l.map Prod.fst, i.val < 56) :
    PLow (pmOf l) :=
  fun _ _ hv => h _ (List.mem_map.2 ⟨_, pmOf_some hv, rfl⟩)

theorem notw_of_idx {l : List (Fin HS × ℤ)} {p : RS} (h : ∀ i ∈ l.map Prod.fst, i ∉ p.writes) :
    ∀ i v, pmOf l i = some v → i ∉ p.writes :=
  fun _ _ hv => h _ (List.mem_map.2 ⟨_, pmOf_some hv, rfl⟩)

end NLogN.KIL

end

section
-- Source module: Solutions.KIL4Tbl
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

theorem gStage_eq_T (Q a c M : ℕ) :
    gStage Q a c M = gStageT (.lit (-(Q : ℤ))) (.lit a) (.lit c) (.lit M) (.lit ((a * M : ℕ) : ℤ)) :=
  rfl

theorem ESim.mAddT {π : PMap} {n n' x x' y y' : Ex HS} (hn : ESim π n n') (hx : ESim π x x')
    (hy : ESim π y y') : ESim π (mAddT n x y) (mAddT n' x' y') :=
  .sel (.add (.add hx hy) hn) (.add hx hy) (.add (.add hx hy) hn)

theorem RSim.mvK {π : PMap} (X Y C : Fin HS) {n n' : Ex HS} (h : ESim π n n') :
    RSim π (NLogN.mvK X Y C n) (NLogN.mvK X Y C n') :=
  .rep C h (.seq (.push Y (.reg X)) (.pop X))

theorem rsim_gStageT {π : PMap} {n n' a a' c c' M M' aM aM' : Ex HS} (hn : ESim π n n')
    (ha : ESim π a a') (hc : ESim π c c') (hM : ESim π M M') (haM : ESim π aM aM') :
    RSim π (gStageT n a c M aM) (gStageT n' a' c' M' aM') := by
  unfold gStageT gBodyT gInnerT
  exact .seq (.push _ (.lit _)) (.seq (.rep _ ha (.seq (.rep _ hM (.seq (.push _
    (ESim.mAddT hn (.reg _) (.reg _))) (.seq (.push _ (.reg _)) (.pop _))))
    (.seq (RSim.mvK _ _ _ hM) (.asg _ (ESim.mAddT hn (.reg _) hc)))))
    (.seq (.pop _) (.seq (.rep _ hM (.pop _)) (RSim.mvK _ _ _ haM))))

theorem gStageT_writes (n a c M aM : Ex HS) :
    (gStageT n a c M aM).writes = [12, 30, 31, 11, 10, 14, 33, 14, 10, 12, 12, 31, 14, 33, 14, 11] :=
  rfl

theorem gStage_stk (t : IState HS) {Q Bb : ℕ} (T : List ℤ) (L : List Item)
    (h14 : t.G 14 = ints T ++ L) (a c : ℕ) (hc : c < Q) (hT : InR Q T)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) (ha : zsz (a : ℤ) ≤ Bb)
    (haM : zsz ((a * T.length : ℕ) : ℤ) ≤ Bb) :
    Sp (gStage Q a c T.length) t (t.upd 14 (ints (stg Q a c T) ++ L)) (cStage a T.length Bb) := by
  have H := gStage_sp (t.upd 14 L) ({} : NLogN.KIL.KS) T [] a c hc hT hQ hM ha haM
  have e1 : ({ ({} : NLogN.KIL.KS) with w := T ++ [], a := [], c := [], k0 := [], k1 := [] } : NLogN.KIL.KS) =
      { w := T } := by simp
  have e2 : ({ ({} : NLogN.KIL.KS) with w := stg Q a c T ++ [], a := [], c := [], k0 := [], k1 := [] } : NLogN.KIL.KS) =
      { w := stg Q a c T } := by simp
  rw [e1, e2, encK_w, encK_w] at H
  simp only [IState.upd_upd_same, IState.upd_G, if_pos rfl, if_true] at H
  rwa [← h14, IState.upd_self] at H

theorem stageU_sp (t : IState HS) {Q Bb : ℕ} (T : List ℤ) (L : List Item)
    (h14 : t.G 14 = ints T ++ L) (a c : ℕ) (LA LC LM LAM LN : List Item)
    (hSA : t.G sSA = .int a :: LA) (hSC : t.G sSC = .int c :: LC)
    (hSM : t.G sSM = .int T.length :: LM) (hSAM : t.G sSAM = .int ((a * T.length : ℕ) : ℤ) :: LAM)
    (hNQ : t.G sNQ = .int (-(Q : ℤ)) :: LN) (hc : c < Q) (hT : InR Q T)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) (ha : zsz (a : ℤ) ≤ Bb)
    (haM : zsz ((a * T.length : ℕ) : ℤ) ≤ Bb) :
    Sp stageU t (((((t.upd 14 (ints (stg Q a c T) ++ L)).upd sSA LA).upd sSC LC).upd sSM LM).upd
      sSAM LAM) (cStageU a T.length Bb) := by
  have H := gStage_stk t T L h14 a c hc hT hQ hM ha haM
  rw [gStage_eq_T] at H
  set π := pmOf [(sNQ, -(Q : ℤ)), (sSA, (a : ℤ)), (sSC, (c : ℤ)), (sSM, (T.length : ℤ)),
    (sSAM, ((a * T.length : ℕ) : ℤ))]
  have hπ : PLow π := PLow.of_idx (by simp only [List.map_cons, List.map_nil]; decide)
  have hsim : RSim π (gStageT (.lit (-(Q : ℤ))) (.lit a) (.lit c) (.lit T.length)
      (.lit ((a * T.length : ℕ) : ℤ))) (gStageT (.reg sNQ) (.reg sSA) (.reg sSC) (.reg sSM)
      (.reg sSAM)) :=
    rsim_gStageT (.par rfl) (.par rfl) (.par rfl) (.par rfl) (.par rfl)
  have hw := notw_of_idx (l := [(sNQ, -(Q : ℤ)), (sSA, (a : ℤ)), (sSC, (c : ℤ)),
    (sSM, (T.length : ℤ)), (sSAM, ((a * T.length : ℕ) : ℤ))])
    (p := gStageT (.lit (-(Q : ℤ))) (.lit a) (.lit c) (.lit T.length)
      (.lit ((a * T.length : ℕ) : ℤ)))
    (by rw [gStageT_writes]; simp only [List.map_cons, List.map_nil]; decide)
  have hPV : PV π t := PV.of_list (by
    intro p hp
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl
    · exact ⟨_, hNQ⟩
    · exact ⟨_, hSA⟩
    · exact ⟨_, hSC⟩
    · exact ⟨_, hSM⟩
    · exact ⟨_, hSAM⟩)
  have S1 := Sp.sim hπ hsim hw hPV H
  set t1 := t.upd 14 (ints (stg Q a c T) ++ L)
  have zc : zsz (c : ℤ) ≤ Bb := zsz_lt_Q (by positivity) (by exact_mod_cast hc) hQ
  have S2 := Sp.popI t1 (i := sSA) (by decide) (a := (a : ℤ)) (L := LA)
    (by simp (config := {decide := true}) [t1, IState.upd_G, hSA]) ha
  have S3 := Sp.popI (t1.upd sSA LA) (i := sSC) (by decide) (a := (c : ℤ)) (L := LC)
    (by simp (config := {decide := true}) [t1, IState.upd_G, hSC]) zc
  have S4 := Sp.popI ((t1.upd sSA LA).upd sSC LC) (i := sSM) (by decide) (a := (T.length : ℤ))
    (L := LM) (by simp (config := {decide := true}) [t1, IState.upd_G, hSM]) hM
  have S5 := Sp.popI (((t1.upd sSA LA).upd sSC LC).upd sSM LM) (i := sSAM) (by decide)
    (a := ((a * T.length : ℕ) : ℤ)) (L := LAM) (by simp (config := {decide := true}) [t1, IState.upd_G, hSAM]) haM
  exact (S1.seq (S2.seq (S3.seq (S4.seq S5)))).mono (by simp only [cStageU]; omega)

theorem vol_map_append (l1 l2 : List (ℕ × ℕ)) :
    vol ((l1 ++ l2).map Prod.fst) = vol (l1.map Prod.fst) * vol (l2.map Prod.fst) := by
  rw [List.map_append, vol_append]

theorem stagesU_sp {Q Bb : ℕ} (hQ0 : 0 < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (L14 LA LC LM LAM LN : List Item) :
    ∀ (rv suf : List (ℕ × ℕ)) (t : IState HS),
      (∀ p ∈ rv, 1 ≤ p.1 ∧ p.2 < Q) → (∀ p ∈ suf, 1 ≤ p.1) →
      zsz ((vol ((rv.reverse ++ suf).map Prod.fst) : ℕ) : ℤ) ≤ Bb →
      t.G 14 = ints (NLogN.KIL.tbl Q suf) ++ L14 →
      t.G sSA = ints (rv.map fun p => (p.1 : ℤ)) ++ LA →
      t.G sSC = ints (rv.map fun p => (p.2 : ℤ)) ++ LC →
      t.G sSM = ints (stgM rv suf) ++ LM →
      t.G sSAM = ints (stgAM rv suf) ++ LAM →
      t.G sNQ = .int (-(Q : ℤ)) :: LN →
      Sp (stagesU rv.length) t
        (((((t.upd 14 (ints (NLogN.KIL.tbl Q (rv.reverse ++ suf)) ++ L14)).upd sSA LA).upd sSC LC).upd
          sSM LM).upd sSAM LAM) (NLogN.KIL.stCost Bb rv suf)
  | [], suf, t, _, _, _, h14, hA, hC, hM, hAM, _ => by
    refine ((Sp.skip t).congr ?_).mono (by simp [NLogN.KIL.stCost])
    simp only [List.map_nil, ints, List.nil_append, stgM, stgAM] at hA hC hM hAM
    simp only [List.reverse_nil, List.nil_append]
    rw [← h14, ← hA, ← hC, ← hM, ← hAM]
    simp
  | x :: rv, suf, t, hrv, hsuf, hV, h14, hA, hC, hM, hAM, hN => by
    obtain ⟨a, c⟩ := x
    have hx := hrv (a, c) List.mem_cons_self
    have hsufv : 1 ≤ vol (suf.map Prod.fst) := vol_le_of_pos _ (fun b hb => by
      simp only [List.mem_map] at hb; obtain ⟨p, hp, rfl⟩ := hb; exact hsuf p hp)
    have hrv1 : 1 ≤ vol (rv.reverse.map Prod.fst) := vol_le_of_pos _ (fun b hb => by
      simp only [List.mem_map, List.mem_reverse] at hb; obtain ⟨p, hp, rfl⟩ := hb
      exact (hrv p (List.mem_cons_of_mem _ hp)).1)
    have hVe : vol ((((a, c) :: rv).reverse ++ suf).map Prod.fst) =
        vol (rv.reverse.map Prod.fst) * (a * vol (suf.map Prod.fst)) := by
      simp only [List.reverse_cons, List.append_assoc, vol_map_append, List.singleton_append,
        List.map_cons, vol_cons]
    rw [hVe] at hV
    have haM_le : a * vol (suf.map Prod.fst) ≤ vol (rv.reverse.map Prod.fst) *
        (a * vol (suf.map Prod.fst)) := Nat.le_mul_of_pos_left _ hrv1
    have zaM : zsz ((a * vol (suf.map Prod.fst) : ℕ) : ℤ) ≤ Bb := le_trans (NLogN.KIL.zsz_nat_le haM_le) hV
    have zM : zsz ((vol (suf.map Prod.fst) : ℕ) : ℤ) ≤ Bb :=
      le_trans (NLogN.KIL.zsz_nat_le (le_trans (Nat.le_mul_of_pos_left _ (by omega)) haM_le)) hV
    have za : zsz (a : ℤ) ≤ Bb :=
      le_trans (NLogN.KIL.zsz_nat_le (le_trans (Nat.le_mul_of_pos_right _ hsufv) haM_le)) hV
    have hlen : (NLogN.KIL.tbl Q suf).length = vol (suf.map Prod.fst) := NLogN.KIL.length_tbl suf
    have S1 := stageU_sp t (Q := Q) (Bb := Bb) (NLogN.KIL.tbl Q suf) L14 h14 a c
      (ints (rv.map fun p => (p.1 : ℤ)) ++ LA) (ints (rv.map fun p => (p.2 : ℤ)) ++ LC)
      (ints (stgM rv ((a, c) :: suf)) ++ LM) (ints (stgAM rv ((a, c) :: suf)) ++ LAM) LN
      (by rw [hA]; rfl) (by rw [hC]; rfl) (by rw [hM, hlen]; rfl) (by rw [hAM, hlen]; rfl) hN
      hx.2 (InR_tbl hQ0 suf) hQ (by rw [hlen]; exact zM) za (by rw [hlen]; exact zaM)
    rw [hlen] at S1
    set t1 := ((((t.upd 14 (ints (stg Q a c (NLogN.KIL.tbl Q suf)) ++ L14)).upd sSA
      (ints (rv.map fun p => (p.1 : ℤ)) ++ LA)).upd sSC
      (ints (rv.map fun p => (p.2 : ℤ)) ++ LC)).upd sSM (ints (stgM rv ((a, c) :: suf)) ++ LM)).upd
      sSAM (ints (stgAM rv ((a, c) :: suf)) ++ LAM)
    have IH := stagesU_sp hQ0 hQ L14 LA LC LM LAM LN rv ((a, c) :: suf) t1
      (fun p hp => hrv p (List.mem_cons_of_mem _ hp))
      (fun p hp => by
        simp only [List.mem_cons] at hp
        rcases hp with rfl | hp
        · exact hx.1
        · exact hsuf p hp)
      (by
        have e : vol ((rv.reverse ++ (a, c) :: suf).map Prod.fst) =
            vol (rv.reverse.map Prod.fst) * (a * vol (suf.map Prod.fst)) := by
          simp only [vol_map_append, List.map_cons, vol_cons]
        rw [e]; exact hV)
      (by simp (config := {decide := true}) [t1, IState.upd_G, NLogN.KIL.tbl])
      (by simp (config := {decide := true}) [t1, IState.upd_G]) (by simp (config := {decide := true}) [t1, IState.upd_G]) (by simp (config := {decide := true}) [t1, IState.upd_G])
      (by simp (config := {decide := true}) [t1, IState.upd_G]) (by simp (config := {decide := true}) [t1, IState.upd_G, hN])
    refine ((S1.seq IH).congr ?_).mono (by simp only [NLogN.KIL.stCost]; rfl)
    simp only [t1, List.reverse_cons, List.append_assoc, List.singleton_append]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all

/-- **The uniform offset-table generator.** -/
theorem genPU_sp {Q Bb : ℕ} (hQ0 : 0 < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb)
    (ac : List (ℕ × ℕ)) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hV : zsz ((vol (ac.map Prod.fst) : ℕ) : ℤ) ≤ Bb)
    (t : IState HS) (LA LC LM LAM LN : List Item)
    (hA : t.G sSA = ints (ac.reverse.map fun p => (p.1 : ℤ)) ++ LA)
    (hC : t.G sSC = ints (ac.reverse.map fun p => (p.2 : ℤ)) ++ LC)
    (hM : t.G sSM = ints (stgM ac.reverse []) ++ LM)
    (hAM : t.G sSAM = ints (stgAM ac.reverse []) ++ LAM)
    (hN : t.G sNQ = .int (-(Q : ℤ)) :: LN) :
    Sp (genPU ac.length) t
      (((((t.upd 14 (ints (NLogN.KIL.tbl Q ac) ++ t.G 14)).upd sSA LA).upd sSC LC).upd sSM LM).upd sSAM LAM)
      ((1 + 1) * 2000 * (Bb + 2) + NLogN.KIL.stCost Bb ac.reverse []) := by
  have S1 := Sp.pushLit t (i := 14) (by decide) 0 (Bb := Bb) (by simp [zsz_zero])
  set t1 := t.upd 14 (.int 0 :: t.G 14)
  have H := stagesU_sp hQ0 hQ (t.G 14) LA LC LM LAM LN ac.reverse [] t1
    (fun p hp => hac p (List.mem_reverse.1 hp)) (by simp)
    (by simpa using hV) (by simp (config := {decide := true}) [t1, IState.upd_G, NLogN.KIL.tbl, ints])
    (by simp (config := {decide := true}) [t1, IState.upd_G, hA]) (by simp (config := {decide := true}) [t1, IState.upd_G, hC])
    (by simp (config := {decide := true}) [t1, IState.upd_G, hM]) (by simp (config := {decide := true}) [t1, IState.upd_G, hAM])
    (by simp (config := {decide := true}) [t1, IState.upd_G, hN])
  rw [List.length_reverse, List.reverse_reverse, List.append_nil] at H
  refine (S1.seq H).congr ?_
  simp only [t1, IState.upd_upd_same]

theorem stCost_le (Bb : ℕ) : ∀ (rv suf : List (ℕ × ℕ)), (∀ p ∈ rv, 1 ≤ p.1) →
    (∀ p ∈ suf, 1 ≤ p.1) →
    NLogN.KIL.stCost Bb rv suf ≤ 10 ^ 8 * (rv.length + 1) * (vol ((rv.reverse ++ suf).map Prod.fst) + 1) *
      (Bb + 2)
  | [], suf, _, _ => by
    simp only [NLogN.KIL.stCost, List.length_nil, List.reverse_nil, List.nil_append]
    have h1 : 1 ≤ 10 ^ 8 * (0 + 1) * (vol (List.map Prod.fst suf) + 1) := by
      have : 1 ≤ vol (List.map Prod.fst suf) + 1 := by omega
      nlinarith
    nlinarith
  | x :: rv, suf, hrv, hsuf => by
    obtain ⟨a, c⟩ := x
    have ha : 1 ≤ a := hrv (a, c) List.mem_cons_self
    have IH := stCost_le Bb rv ((a, c) :: suf) (fun p hp => hrv p (List.mem_cons_of_mem _ hp))
      (fun p hp => by
        simp only [List.mem_cons] at hp
        rcases hp with rfl | hp
        · exact ha
        · exact hsuf p hp)
    have hsufv : 1 ≤ vol (suf.map Prod.fst) := vol_le_of_pos _ (fun b hb => by
      simp only [List.mem_map] at hb; obtain ⟨p, hp, rfl⟩ := hb; exact hsuf p hp)
    have hrv1 : 1 ≤ vol (rv.reverse.map Prod.fst) := vol_le_of_pos _ (fun b hb => by
      simp only [List.mem_map, List.mem_reverse] at hb; obtain ⟨p, hp, rfl⟩ := hb
      exact hrv p (List.mem_cons_of_mem _ hp))
    have e1 : (rv.reverse ++ (a, c) :: suf).map Prod.fst = ((a, c) :: rv).reverse.map Prod.fst ++
        suf.map Prod.fst := by simp
    rw [e1] at IH
    simp only [NLogN.KIL.stCost, List.length_cons]
    have hS := cStage_le a (vol (suf.map Prod.fst)) Bb
    set M := vol (suf.map Prod.fst)
    set V := vol ((((a, c) :: rv).reverse ++ suf).map Prod.fst)
    have hV : V = vol (rv.reverse.map Prod.fst) * (a * M) := by
      simp only [V, M, List.reverse_cons, List.append_assoc, vol_map_append, List.singleton_append,
        List.map_cons, vol_cons, List.map_nil]
      simp [vol, mul_assoc]
    have hVe : vol (((a, c) :: rv).reverse.map Prod.fst ++ suf.map Prod.fst) = V := by
      simp only [V, List.map_append]
    rw [hVe] at IH
    have haM : a * M ≤ V := by rw [hV]; exact Nat.le_mul_of_pos_left _ hrv1
    have h1 : a * M + a + M + 1 ≤ 4 * (V + 1) := by
      have : a ≤ a * M := Nat.le_mul_of_pos_right _ hsufv
      have : M ≤ a * M := Nat.le_mul_of_pos_left _ ha
      omega
    unfold cStageU
    have h2 : 200 * cStage a M Bb ≤ 200 * (100000 * (4 * (V + 1)) * (Bb + 2)) := by
      have := Nat.mul_le_mul_right (Bb + 2) (Nat.mul_le_mul_left 100000 h1)
      omega
    have h3 : 4 * (2 * Bb + 2) ≤ 8 * (V + 1) * (Bb + 2) := by nlinarith
    have e2 : 10 ^ 8 * (rv.length + 1 + 1) * (V + 1) * (Bb + 2) =
        10 ^ 8 * (rv.length + 1) * (V + 1) * (Bb + 2) + 10 ^ 8 * (V + 1) * (Bb + 2) := by ring
    rw [e2]
    nlinarith

end NLogN.KIL

end

