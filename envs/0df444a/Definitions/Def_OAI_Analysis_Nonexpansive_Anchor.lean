namespace OAI

/-!
# The actual anchor of the resolvent tail families

The tail-limit set is an intersection of closures in the weak carrier.
Its points are then viewed in the original normed space.  The idempotent
constructed from the actual resolvents fixes the selected anchor, and
compactness plus separation gives the required norm-convex-hull property.
-/

noncomputable section

open Set
open scoped Topology

namespace ReflexiveFixedPoints

universe u

variable {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
variable {K : Set X}

/-- Underlying original-norm point of a weak carrier element.
No weak-to-norm continuity assertion is made. -/
def weakCarrierPoint (w : WeakCarrier K) : X := (toWeakSpace ℝ X).symm w

/-- The closure of the `(n+1)`st tail image, in the weak subtype topology. -/
def anchorTailClosure (H : ℕ → Set (K → K)) (x : K) (n : ℕ) :
    Set (WeakCarrier K) :=
  closure ((fun h : K → K => normToWeak K (h x)) '' H (n + 1))

/-- The literal tail-limit set, viewed in the original ambient space. -/
def anchorTailSet (H : ℕ → Set (K → K)) (x : K) : Set X :=
  weakCarrierPoint '' (⋂ n, anchorTailClosure H x n)

theorem anchorTailSet_subset (H : ℕ → Set (K → K)) (x : K) :
    anchorTailSet H x ⊆ K := by
  rintro _ ⟨w, _, rfl⟩
  exact w.property

theorem anchorTailSet_mem_tailClosure (H : ℕ → Set (K → K)) (x : K)
    {m : ℕ} (hm : 1 ≤ m) (d : anchorTailSet H x) :
    normToWeak K ⟨d, anchorTailSet_subset H x d.property⟩ ∈
      closure ((fun h : K → K => normToWeak K (h x)) '' H m) := by
  rcases d.property with ⟨w, hw, hwd⟩
  have hpoint : normToWeak K ⟨d, anchorTailSet_subset H x d.property⟩ = w := by
    apply Subtype.ext
    change toWeakSpace ℝ X (d : X) = (w : WeakSpace ℝ X)
    rw [← hwd]
    exact (toWeakSpace ℝ X).apply_symm_apply w
  rw [hpoint]
  have hm' : m - 1 + 1 = m := Nat.sub_add_cancel hm
  simpa only [anchorTailClosure, hm'] using mem_iInter.mp hw (m - 1)

/-- This record states actual output properties.  Its tail-set equality
retains the concrete intersection definition used to construct it. -/
structure AnchorPoint (H : ℕ → Set (K → K)) where
  x : K
  D : Set X
  D_eq_tailSet : D = anchorTailSet H x
  D_subset : D ⊆ K
  D_nonempty : D.Nonempty
  D_weaklyCompact : WeaklyCompact D
  mem_closedConvexHull : (x : X) ∈ closure (convexHull ℝ D)
  tail_closure : ∀ m : ℕ, 1 ≤ m → ∀ d : D,
    normToWeak K ⟨d, D_subset d.property⟩ ∈
      closure ((fun h : K → K => normToWeak K (h x)) '' H m)

 theorem subtype_val_image_iInter (B : ℕ → Set (WeakCarrier K)) :
    (Subtype.val : WeakCarrier K → WeakSpace ℝ X) '' (⋂ n, B n) =
      ⋂ n, (Subtype.val : WeakCarrier K → WeakSpace ℝ X) '' B n := by
  ext z
  constructor
  · rintro ⟨w, hw, rfl⟩
    exact mem_iInter.mpr fun n => ⟨w, mem_iInter.mp hw n, rfl⟩
  · intro hz
    obtain ⟨w, hw, hwz⟩ := mem_iInter.mp hz 0
    refine ⟨w, mem_iInter.mpr fun n => ?_, hwz⟩
    obtain ⟨v, hv, hvz⟩ := mem_iInter.mp hz n
    have hvw : v = w := Subtype.ext (hvz.trans hwz.symm)
    simpa only [hvw] using hv

 theorem norm_preimage_subtype_image (B : Set (WeakCarrier K)) :
    (toWeakSpace ℝ X) ⁻¹' ((Subtype.val : WeakCarrier K → WeakSpace ℝ X) '' B) =
      weakCarrierPoint '' B := by
  ext z
  constructor
  · rintro ⟨w, hw, hwz⟩
    refine ⟨w, hw, ?_⟩
    simpa only [weakCarrierPoint, LinearEquiv.symm_apply_apply] using
      congrArg (toWeakSpace ℝ X).symm hwz
  · rintro ⟨w, hw, rfl⟩
    exact ⟨w, hw, ((toWeakSpace ℝ X).apply_symm_apply w).symm⟩

section ActualTails

variable [CompleteSpace X]
variable (hKclosed : IsClosed K) (hKconvex : Convex ℝ K)
variable (T : K → K) (hT : LipschitzWith 1 T)

 theorem evaluated_tail_hull_mem {m : ℕ} {f : K → K}
    (hf : ambientMap f ∈ ambientTailConvexHull hKclosed hKconvex T hT m)
    (x : K) :
    (f x : X) ∈ convexHull ℝ
      ((fun h : K → K => (h x : X)) '' tailFamily hKclosed hKconvex T hT m) := by
  let ev : (K → X) →ₗ[ℝ] X := LinearMap.proj x
  have he : (f x : X) ∈ ev ''
      convexHull ℝ (ambientTailFamily hKclosed hKconvex T hT m) :=
    ⟨ambientMap f, hf, rfl⟩
  rw [ev.image_convexHull] at he
  have hset : ev '' ambientTailFamily hKclosed hKconvex T hT m =
      (fun h : K → K => (h x : X)) '' tailFamily hKclosed hKconvex T hT m := by
    rw [ambientTailFamily, Set.image_image]
    rfl
  rwa [hset] at he

 theorem anchor_mem_closedConvexHull_each
    {P : WeakSelfMap K} {x : K} (hPx : WeakSelfMap.toNorm P x = x)
    (hP : ∀ n, P ∈ closure (weakTailConvexFamily hKclosed hKconvex T hT (n + 1)))
    (n : ℕ) :
    (x : X) ∈ closure (convexHull ℝ ((toWeakSpace ℝ X) ⁻¹'
      ((Subtype.val : WeakCarrier K → WeakSpace ℝ X) ''
        anchorTailClosure (tailFamily hKclosed hKconvex T hT) x n))) := by
  classical
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨g, hg, hnear⟩ := WeakSelfMap.exists_finset_norm_approx
    (convex_weakTailConvexFamily hKclosed hKconvex T hT (n + 1)) (hP n) {x} hε
  have hxnear : dist (WeakSelfMap.toNorm g x) x < ε := by
    simpa only [hPx] using hnear x (by simp)
  refine ⟨(WeakSelfMap.toNorm g x : X), ?_, ?_⟩
  · apply convexHull_mono (s := (fun h : K → K => (h x : X)) ''
        tailFamily hKclosed hKconvex T hT (n + 1)) ?_
      (evaluated_tail_hull_mem hKclosed hKconvex T hT hg x)
    rintro _ ⟨h, hh, rfl⟩
    exact ⟨normToWeak K (h x), subset_closure ⟨h, hh, rfl⟩, rfl⟩
  · simpa only [Subtype.dist_eq, dist_comm] using hxnear

/-- Construct the actual anchor and its literal tail-limit set from the
resolvents.  No approximation, semigroup, or convex-hull law is assumed. -/
theorem exists_anchorPoint (hKnonempty : K.Nonempty)
    (hKweak : WeaklyCompact K) :
    Nonempty (AnchorPoint (tailFamily hKclosed hKconvex T hT)) := by
  let : CompactSpace (WeakCarrier K) := hKweak.compactSpace
  let : T2Space (WeakSpace ℝ X) := weakSpaceT2Space (X := X)
  let : T2Space (WeakCarrier K) := inferInstance
  obtain ⟨P, hP, hPP, hPLip⟩ :=
    exists_idempotent_in_tail_closures hKclosed hKconvex T hT
  let a : K := ⟨hKnonempty.choose, hKnonempty.choose_spec⟩
  let x : K := WeakSelfMap.toNorm P a
  have hPx : WeakSelfMap.toNorm P x = x := by
    have he := congrArg (fun f : WeakSelfMap K => WeakSelfMap.toNorm f a) hPP
    exact he
  let H := tailFamily hKclosed hKconvex T hT
  let B : ℕ → Set (WeakCarrier K) := anchorTailClosure H x
  have hBanti : Antitone B := by
    intro m n hmn
    exact closure_mono (image_mono
      (tailFamily_antitone hKclosed hKconvex T hT (Nat.add_le_add_right hmn 1)))
  have hBn (n : ℕ) : (B n).Nonempty :=
    ((tailFamily_nonempty hKclosed hKconvex T hT (n + 1) (Nat.succ_le_succ (Nat.zero_le n))).image
      (fun h : K → K => normToWeak K (h x))).mono subset_closure
  have hBc (n : ℕ) : IsCompact (B n) := isClosed_closure.isCompact
  have hBclosed (n : ℕ) : IsClosed (B n) := isClosed_closure
  have hIn : (⋂ n, B n).Nonempty :=
    IsCompact.nonempty_iInter_of_directed_nonempty_isCompact_isClosed
      B hBanti.directed_ge hBn hBc hBclosed
  have hIc : IsCompact (⋂ n, B n) := (isClosed_iInter hBclosed).isCompact
  let D : Set X := anchorTailSet H x
  have hDn : D.Nonempty := hIn.image weakCarrierPoint
  have hDweak : WeaklyCompact D := by
    have hc := hIc.image (continuous_subtype_val :
      Continuous (Subtype.val : WeakCarrier K → WeakSpace ℝ X))
    change IsCompact ((toWeakSpace ℝ X) '' (weakCarrierPoint '' (⋂ n, B n)))
    rw [Set.image_image]
    have heq : (fun w : WeakCarrier K => toWeakSpace ℝ X (weakCarrierPoint w)) =
        (Subtype.val : WeakCarrier K → WeakSpace ℝ X) := by
      funext w
      exact (toWeakSpace ℝ X).apply_symm_apply w
    rw [heq]
    exact hc
  have hxD : (x : X) ∈ closure (convexHull ℝ D) := by
    let C : ℕ → Set (WeakSpace ℝ X) := fun n =>
      (Subtype.val : WeakCarrier K → WeakSpace ℝ X) '' B n
    have hCc (n : ℕ) : IsCompact (C n) := (hBc n).image continuous_subtype_val
    have hCn (n : ℕ) : (C n).Nonempty := (hBn n).image Subtype.val
    have hCanti : Antitone C := fun m n hmn => image_mono (hBanti hmn)
    have hxC : ∀ n, (x : X) ∈ closure (convexHull ℝ ((toWeakSpace ℝ X) ⁻¹' C n)) :=
      anchor_mem_closedConvexHull_each hKclosed hKconvex T hT hPx
        (fun n => mem_iInter.mp hP n)
    have hm := mem_closure_convexHull_iInter_weaklyCompact C hCc hCn hCanti hxC
    have hset : (toWeakSpace ℝ X) ⁻¹' (⋂ n, C n) = D := by
      change (toWeakSpace ℝ X) ⁻¹'
        (⋂ n, (Subtype.val : WeakCarrier K → WeakSpace ℝ X) '' B n) =
          weakCarrierPoint '' (⋂ n, B n)
      rw [← subtype_val_image_iInter, norm_preimage_subtype_image]
    rwa [hset] at hm
  refine ⟨{
    x := x
    D := D
    D_eq_tailSet := rfl
    D_subset := anchorTailSet_subset H x
    D_nonempty := hDn
    D_weaklyCompact := hDweak
    mem_closedConvexHull := hxD
    tail_closure := ?_
  }⟩
  intro m hm d
  exact anchorTailSet_mem_tailClosure H x hm d

end ActualTails

end ReflexiveFixedPoints

