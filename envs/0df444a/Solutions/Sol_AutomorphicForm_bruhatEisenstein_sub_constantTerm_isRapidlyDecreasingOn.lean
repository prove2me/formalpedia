private theorem norm_iteratedFDeriv_mul_zero_le {f₁ f₂ : ℝ → ℂ} (hf₁ : ContDiff ℝ ∞ f₁) (hf₂ : ContDiff ℝ ∞ f₂)
    {n : ℕ} {K₁ K₂ : ℝ} (h₁ : ∀ i ≤ n, ‖iteratedFDeriv ℝ i f₁ 0‖ ≤ K₁)
    (h₂ : ∀ i ≤ n, ‖iteratedFDeriv ℝ i f₂ 0‖ ≤ K₂) {i : ℕ} (hi : i ≤ n) :
    ‖iteratedFDeriv ℝ i (fun t => f₁ t * f₂ t) 0‖ ≤ 2 ^ n * (K₁ * K₂) := by
  refine (norm_iteratedFDeriv_mul_le hf₁ hf₂ 0 (by exact_mod_cast le_top)).trans ?_
  have hK₁ : 0 ≤ K₁ := (norm_nonneg _).trans (h₁ 0 (Nat.zero_le _))
  have hK : 0 ≤ K₁ * K₂ := mul_nonneg hK₁ ((norm_nonneg _).trans (h₂ 0 (Nat.zero_le _)))
  calc ∑ j ∈ Finset.range (i + 1),
          (i.choose j : ℝ) * ‖iteratedFDeriv ℝ j f₁ 0‖ * ‖iteratedFDeriv ℝ (i - j) f₂ 0‖
      ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * (K₁ * K₂) := by
        refine Finset.sum_le_sum fun j hj => ?_
        have hj : j ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul (h₁ j (hj.trans hi)) (h₂ (i - j) ((Nat.sub_le i j).trans hi)) (norm_nonneg _) hK₁)
          (Nat.cast_nonneg _)
    _ = (2 : ℝ) ^ i * (K₁ * K₂) := by
        rw [← Finset.sum_mul, ← Nat.cast_sum, Nat.sum_range_choose]
        push_cast
        ring
