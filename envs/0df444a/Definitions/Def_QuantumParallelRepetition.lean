      (Σ side : Finset M,
        ExactReverseSideContext M side × Fin side.card) → ℝ :=
    fun marker =>
      (∑ position : Fin marker.1.card,
        statistic marker.1 marker.2.1 position) /
        (marker.1.card : ℝ)
