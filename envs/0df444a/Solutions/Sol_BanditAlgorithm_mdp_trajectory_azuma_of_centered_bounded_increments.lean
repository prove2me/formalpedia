import Theorems.Thm_BanditAlgorithm_mdp_integral_trajectory_succ
import Theorems.Thm_BanditAlgorithm_mdp_measure_map_restrict
import Theorems.Thm_hasCondSubgaussianMGF_of_mem_Icc_of_condExp_eq_zero
import Mathlib.Probability.Process.Adapted

open MeasureTheory ProbabilityTheory BanditAlgorithm
open scoped NNReal ENNReal

/-!
The partial sums of the increments form a martingale for the filtration generated
by the rounds, because conditionally on the rounds up to `t` the state of round
`t + 1` is drawn from the true transition row, against which the increment
averages to zero.  Mathlib's Azuma-Hoeffding inequality for conditionally
sub-Gaussian increments then applies, with the per-step parameter supplied by the
conditional Hoeffding lemma for increments in `[-c, c]`.
-/

namespace MdpAz

variable {S A : ℕ}

/-! ### Truncation of trajectories -/

/-- Truncation of a trajectory to its first `m` rounds. -/
def trunc {m n : ℕ} (hmn : m ≤ n) (h : MDPTrajectory S A n) : MDPTrajectory S A m :=
  fun t ↦ h (Fin.castLE hmn t)

lemma measurable_trunc {m n : ℕ} (hmn : m ≤ n) :
    Measurable (trunc (S := S) (A := A) hmn) := by
  fun_prop

/-- Integrating a function of the first `m` rounds against the horizon-`n`
measure is the same as integrating it against the horizon-`m` measure. -/
lemma integral_trunc (M : FiniteMDP S A) (μ0 : MDPStateDistribution S)
    (π : MDPPolicy S A) {m n : ℕ} (hmn : m ≤ n) (F : MDPTrajectory S A m → ℝ) :
    ∫ h, F (trunc hmn h) ∂(mdpMeasure M μ0 π n) = ∫ g, F g ∂(mdpMeasure M μ0 π m) := by
  have hmap : (mdpMeasure M μ0 π n).map (trunc (S := S) (A := A) hmn)
      = mdpMeasure M μ0 π m := mdp_measure_map_restrict M μ0 π hmn
  calc ∫ h, F (trunc hmn h) ∂(mdpMeasure M μ0 π n)
      = ∫ g, F g ∂((mdpMeasure M μ0 π n).map (trunc hmn)) := by
        rw [integral_map (measurable_trunc hmn).aemeasurable
          (Measurable.aestronglyMeasurable (measurable_of_countable F))]
    _ = ∫ g, F g ∂(mdpMeasure M μ0 π m) := by rw [hmap]

lemma trunc_snoc {m : ℕ} (g : MDPTrajectory S A m) (p : Fin S × Fin A) :
    trunc (Nat.le_succ m) (Fin.snoc (α := fun _ ↦ Fin S × Fin A) g p) = g := by
  funext j
  show Fin.snoc (α := fun _ ↦ Fin S × Fin A) g p (Fin.castLE (Nat.le_succ m) j) = g j
  have : Fin.castLE (Nat.le_succ m) j = j.castSucc := rfl
  rw [this, Fin.snoc_castSucc]

/-! ### The filtration generated by the rounds -/

/-- The prefix of a trajectory up to round `i`, as a map into a discrete space. -/
def pre (S A n : ℕ) (i : ℕ) (h : MDPTrajectory S A n) : Fin n → Option (Fin S × Fin A) :=
  fun j ↦ if j.val ≤ i then some (h j) else none

lemma eq_of_pre_eq {n i : ℕ} {h h' : MDPTrajectory S A n}
    (hp : pre S A n i h = pre S A n i h') {j : Fin n} (hj : j.val ≤ i) : h j = h' j := by
  have := congrFun hp j
  simp only [pre, if_pos hj] at this
  exact Option.some_injective _ this

/-- The filtration generated by the rounds `0, …, i + 1`. -/
def filt (S A n : ℕ) : Filtration ℕ (inferInstance : MeasurableSpace (MDPTrajectory S A n)) where
  seq i := MeasurableSpace.comap (pre S A n (i + 1)) ⊤
  mono' := by
    intro i j hij s hs
    obtain ⟨t, -, rfl⟩ := hs
    refine ⟨(fun g : Fin n → Option (Fin S × Fin A) ↦
      fun k ↦ if k.val ≤ i + 1 then g k else none) ⁻¹' t, trivial, ?_⟩
    ext h
    simp only [Set.mem_preimage, pre]
    refine Iff.of_eq (congrArg (· ∈ t) ?_)
    funext k
    by_cases hk : k.val ≤ i + 1
    · simp [pre, hk, show k.val ≤ j + 1 by omega]
    · simp [pre, hk]
  le' := fun _ _ _ ↦ MeasurableSet.of_discrete

/-- A function of the trajectory that only depends on the rounds up to `i`
is measurable for the σ-algebra generated by those rounds. -/
lemma measurable_comap_pre {n i : ℕ} (f : MDPTrajectory S A n → ℝ)
    (hf : ∀ h h' : MDPTrajectory S A n, pre S A n i h = pre S A n i h' → f h = f h') :
    Measurable[MeasurableSpace.comap (pre S A n i) ⊤] f := by
  intro U _
  refine ⟨{g | ∃ h₀, pre S A n i h₀ = g ∧ f h₀ ∈ U}, trivial, ?_⟩
  ext h
  simp only [Set.mem_preimage, Set.mem_setOf_eq]
  constructor
  · rintro ⟨h₀, hh₀, hU'⟩
    rwa [hf h h₀ hh₀.symm]
  · intro hh
    exact ⟨h, rfl, hh⟩

/-! ### Integrals against the step kernel -/

/-- The integral against the measure of a probability vector is the sum. -/
lemma integral_stateDist (d : MDPStateDistribution S) (f : Fin S → ℝ) :
    ∫ s, f s ∂d.toMeasure = ∑ s, (d.prob s : ℝ) * f s := by
  rw [integral_fintype Integrable.of_finite]
  refine Finset.sum_congr rfl fun s _ ↦ ?_
  have : d.toMeasure {s} = (d.prob s : ℝ≥0∞) := by
    simp only [MDPStateDistribution.toMeasure, Measure.finsetSum_apply, Measure.smul_apply,
      Measure.dirac_apply' _ (measurableSet_singleton s), Set.indicator_apply,
      Set.mem_singleton_iff]
    rw [Finset.sum_eq_single s] <;> simp +contextual
  rw [measureReal_def, this, smul_eq_mul]
  simp

/-- Integrating a function of the next state against the step kernel. -/
lemma integral_step_fst (M : FiniteMDP S A) (μ0 : MDPStateDistribution S)
    (π : MDPPolicy S A) (m : ℕ) (g : MDPTrajectory S A (m + 1)) (f : Fin S → ℝ) :
    ∫ p, f p.1 ∂(mdpStepKernel M μ0 π (m + 1) g)
      = ∑ s', (M.P (g (Fin.last m)).1 (g (Fin.last m)).2 s' : ℝ) * f s' := by
  have h1 : ∫ p, f p.1 ∂(mdpStepKernel M μ0 π (m + 1) g)
      = ∫ s, (∫ _a, f s ∂(π.select (m + 1) (g, s))) ∂(mdpStateKernel M μ0 (m + 1) g) :=
    ProbabilityTheory.integral_compProd Integrable.of_finite
  rw [h1]
  simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
  rw [mdpStateKernel, Kernel.comap_apply]
  show ∫ s, f s ∂((M.transitionDist (g (Fin.last m)).1 (g (Fin.last m)).2).toMeasure) = _
  rw [integral_stateDist]
  rfl

/-- **Conditional mean zero.** If the weight `φ` and the centred kernel `ψ` depend
only on the first `t + 1` rounds, and `ψ` averages to zero against the true
transition row out of round `t`, then the product with the state of round `t + 1`
integrates to zero. -/
lemma integral_weighted_centered (M : FiniteMDP S A) (μ0 : MDPStateDistribution S)
    (π : MDPPolicy S A) {t n : ℕ} (ht : t + 2 ≤ n)
    (φ : MDPTrajectory S A (t + 1) → ℝ) (ψ : MDPTrajectory S A (t + 1) → Fin S → ℝ)
    (hψ : ∀ g : MDPTrajectory S A (t + 1),
      ∑ s', (M.P (g (Fin.last t)).1 (g (Fin.last t)).2 s' : ℝ) * ψ g s' = 0) :
    ∫ h, φ (trunc (by omega : t + 1 ≤ n) h)
          * ψ (trunc (by omega : t + 1 ≤ n) h) ((h ⟨t + 1, by omega⟩).1)
        ∂(mdpMeasure M μ0 π n) = 0 := by
  set F : MDPTrajectory S A (t + 2) → ℝ := fun g ↦
    φ (trunc (Nat.le_succ (t + 1)) g)
      * ψ (trunc (Nat.le_succ (t + 1)) g) ((g (Fin.last (t + 1))).1) with hF
  have hrw : ∀ h : MDPTrajectory S A n,
      φ (trunc (by omega : t + 1 ≤ n) h)
        * ψ (trunc (by omega : t + 1 ≤ n) h) ((h ⟨t + 1, by omega⟩).1)
      = F (trunc (by omega : t + 2 ≤ n) h) := by
    intro h
    simp only [hF]
    rfl
  simp_rw [hrw]
  rw [integral_trunc M μ0 π (by omega : t + 2 ≤ n) F,
    mdp_integral_trajectory_succ M μ0 π (t + 1) F]
  have hinner : ∀ g : MDPTrajectory S A (t + 1),
      ∫ p, F (Fin.snoc (α := fun _ ↦ Fin S × Fin A) g p) ∂(mdpStepKernel M μ0 π (t + 1) g)
        = 0 := by
    intro g
    have hp : ∀ p : Fin S × Fin A,
        F (Fin.snoc (α := fun _ ↦ Fin S × Fin A) g p) = φ g * ψ g p.1 := by
      intro p
      simp only [hF, trunc_snoc, Fin.snoc_last]
    simp_rw [hp]
    rw [integral_const_mul, integral_step_fst M μ0 π t g (ψ g), hψ g, mul_zero]
  simp_rw [hinner]
  simp

end MdpAz

open MdpAz in
theorem solution
    {S A : ℕ} (n : ℕ) (M : FiniteMDP S A) (μ0 : MDPStateDistribution S)
    (π : MDPPolicy S A) (G : MDPTrajectory S A n → ℕ → Fin S → ℝ)
    (c : ℝ) (hc : 0 ≤ c)
    (hdep : ∀ (t : ℕ) (h h' : MDPTrajectory S A n),
        (∀ i : Fin n, i.val ≤ t → h i = h' i) → G h t = G h' t)
    (hcent : ∀ (t : ℕ) (ht : t < n) (h : MDPTrajectory S A n),
        ∑ s', ((M.P (h ⟨t, ht⟩).1 (h ⟨t, ht⟩).2 s' : ℝ)) * G h t s' = 0)
    (hbdd : ∀ (t : ℕ) (h : MDPTrajectory S A n) (s' : Fin S), |G h t s'| ≤ c)
    {ε : ℝ} (hε : 0 ≤ ε) :
    (mdpMeasure M μ0 π n).real
        {h | ∃ (st : ℕ → Fin S) (act : ℕ → Fin A),
              (∀ t : Fin n, h t = (st t, act t)) ∧
              ε ≤ ∑ t ∈ Finset.range (n - 1), G h t (st (t + 1))}
      ≤ Real.exp (-ε ^ 2 / (2 * ((n : ℝ) - 1) * c ^ 2)) := by
  classical
  set μ := mdpMeasure M μ0 π n with hμ
  -- degenerate cases: the right-hand side is at least one
  by_cases hdeg : n ≤ 1 ∨ c = 0
  · have hone : (1 : ℝ) ≤ Real.exp (-ε ^ 2 / (2 * ((n : ℝ) - 1) * c ^ 2)) := by
      refine Real.one_le_exp ?_
      rcases hdeg with hn | hc0
      · interval_cases n
        · have : (2 : ℝ) * ((0 : ℕ) - 1) * c ^ 2 = -(2 * c ^ 2) := by push_cast; ring
          rw [this]
          rcases eq_or_lt_of_le hc with h0 | h0
          · simp [← h0]
          · rw [div_neg, neg_div, neg_neg]
            positivity
        · norm_num
      · simp [hc0]
    exact le_trans (measureReal_le_one) hone
  push_neg at hdeg
  obtain ⟨hn2, hc0⟩ := hdeg
  have hn2 : 2 ≤ n := by omega
  have hcpos : 0 < c := lt_of_le_of_ne hc (Ne.symm hc0)
  -- the martingale increments
  set Y : ℕ → MDPTrajectory S A n → ℝ := fun t h ↦
    if ht : t + 1 < n then G h t ((h ⟨t + 1, ht⟩).1) else 0 with hY
  have hYbdd : ∀ t h, Y t h ∈ Set.Icc (-c) c := by
    intro t h
    simp only [hY]
    split
    · exact abs_le.1 (hbdd _ _ _)
    · exact ⟨by linarith, hc⟩
  have hYmeas : ∀ t, Measurable (Y t) := fun t ↦ measurable_of_countable _
  -- `Y t` depends only on the rounds up to `t + 1`
  have hYdep : ∀ t (h h' : MDPTrajectory S A n),
      pre S A n (t + 1) h = pre S A n (t + 1) h' → Y t h = Y t h' := by
    intro t h h' hp
    simp only [hY]
    split
    · rename_i ht
      have hG : G h t = G h' t := hdep t h h' (fun i hi ↦ eq_of_pre_eq hp (by omega))
      rw [hG, eq_of_pre_eq hp (j := ⟨t + 1, ht⟩) (le_refl _)]
    · rfl
  have hadapted : StronglyAdapted (filt S A n) Y := fun t ↦
    (measurable_comap_pre (Y t) (hYdep t)).stronglyMeasurable
  -- the conditional mean of an increment given the strict past vanishes
  have hcond : ∀ i : ℕ, μ[Y (i + 1) | (filt S A n) i] =ᵐ[μ] 0 := by
    intro i
    by_cases hi : i + 2 < n
    · refine (ae_eq_condExp_of_forall_setIntegral_eq ((filt S A n).le i)
        (Integrable.of_finite) (fun s _ _ ↦ Integrable.of_finite.integrableOn)
        (fun s hs _ ↦ ?_) aestronglyMeasurable_zero).symm
      obtain ⟨B, -, rfl⟩ := hs
      simp only [Pi.zero_apply]
      rw [integral_zero, eq_comm]
      -- the indicator, as a function of the first `i + 2` rounds
      set φ : MDPTrajectory S A (i + 2) → ℝ := fun g ↦
        if (fun j : Fin n ↦ if hj : j.val ≤ i + 1 then some (g ⟨j.val, by omega⟩) else none) ∈ B
          then 1 else 0 with hφ
      -- the increment, as a function of the first `i + 2` rounds
      set ext : MDPTrajectory S A (i + 2) → MDPTrajectory S A n := fun g j ↦
        if hj : j.val < i + 2 then g ⟨j.val, hj⟩ else g ⟨0, by omega⟩ with hext
      set ψ : MDPTrajectory S A (i + 2) → Fin S → ℝ := fun g s' ↦ G (ext g) (i + 1) s' with hψd
      have hextagree : ∀ (h : MDPTrajectory S A n) (j : Fin n), j.val ≤ i + 1 →
          ext (trunc (by omega : i + 2 ≤ n) h) j = h j := by
        intro h j hj
        simp only [hext, dif_pos (show j.val < i + 2 by omega), trunc]
        exact congrArg h (Fin.ext rfl)
      have hψ : ∀ g : MDPTrajectory S A (i + 2),
          ∑ s', (M.P (g (Fin.last (i + 1))).1 (g (Fin.last (i + 1))).2 s' : ℝ) * ψ g s' = 0 := by
        intro g
        have h1 := hcent (i + 1) (by omega) (ext g)
        have h2 : ext g ⟨i + 1, by omega⟩ = g (Fin.last (i + 1)) := by
          simp only [hext, dif_pos (show (i + 1) < i + 2 by omega)]
          rfl
        rw [h2] at h1
        exact h1
      have hkey := integral_weighted_centered (t := i + 1) M μ0 π (by omega : i + 1 + 2 ≤ n) φ ψ hψ
      rw [← hkey]
      rw [← integral_indicator (MeasurableSet.of_discrete)]
      refine integral_congr_ae (Filter.Eventually.of_forall fun h ↦ ?_)
      by_cases hmem : h ∈ (pre S A n (i + 1)) ⁻¹' B
      · rw [Set.indicator_of_mem hmem]
        have hφ1 : φ (trunc (by omega : i + 1 + 1 ≤ n) h) = 1 := by
          simp only [hφ]
          exact if_pos hmem
        have hψ1 : ψ (trunc (by omega : i + 1 + 1 ≤ n) h) = G h (i + 1) := by
          simp only [hψd]
          exact hdep (i + 1) _ h (fun j hj ↦ hextagree h j hj)
        simp only [hφ1, hψ1, one_mul]
        simp only [hY, dif_pos (show i + 1 + 1 < n by omega)]
      · rw [Set.indicator_of_notMem hmem]
        have hφ0 : φ (trunc (by omega : i + 1 + 1 ≤ n) h) = 0 := by
          simp only [hφ]
          exact if_neg hmem
        simp only [hφ0, zero_mul]
    · have hzero : Y (i + 1) = fun _ ↦ (0 : ℝ) := by
        funext h
        simp only [hY, dif_neg (show ¬ (i + 1 + 1 < n) by omega)]
      rw [hzero, show (fun _ : MDPTrajectory S A n ↦ (0 : ℝ)) = 0 from rfl, condExp_zero]
  -- each increment is conditionally sub-Gaussian
  have hsubG : ∀ i, HasCondSubgaussianMGF ((filt S A n) i) ((filt S A n).le i)
      (Y (i + 1)) ((‖c - (-c)‖₊ / 2) ^ 2) μ := fun i ↦
    hasCondSubgaussianMGF_of_mem_Icc_of_condExp_eq_zero ((filt S A n).le i)
      (hYmeas _) (Filter.Eventually.of_forall fun h ↦ hYbdd _ h) (hcond i)
  -- and the first one is unconditionally sub-Gaussian
  have hY0 : HasSubgaussianMGF (Y 0) ((‖c - (-c)‖₊ / 2) ^ 2) μ := by
    refine hasSubgaussianMGF_of_mem_Icc_of_integral_eq_zero (hYmeas 0).aemeasurable
      (Filter.Eventually.of_forall fun h ↦ hYbdd _ h) ?_
    have hkey := integral_weighted_centered (t := 0) M μ0 π (by omega : 0 + 2 ≤ n)
      (fun _ ↦ (1 : ℝ)) (fun g s' ↦ G (fun _ ↦ g ⟨0, Nat.zero_lt_one⟩) 0 s') ?_
    · rw [← hkey]
      refine integral_congr_ae (Filter.Eventually.of_forall fun h ↦ ?_)
      simp only [one_mul, hY, dif_pos (show 0 + 1 < n by omega)]
      refine congrFun (hdep 0 h _ (fun j hj ↦ ?_)) _
      exact congrArg h (Fin.ext (by simp only [Fin.coe_castLE]; omega))
    · intro g
      have h1 := hcent 0 (by omega) (fun _ ↦ g ⟨0, Nat.zero_lt_one⟩)
      exact h1
  -- Azuma-Hoeffding
  have hazuma := measure_sum_ge_le_of_hasCondSubgaussianMGF (μ := μ)
    (cY := fun _ ↦ (‖c - (-c)‖₊ / 2) ^ 2) hadapted hY0 (n - 1) (fun i _ ↦ hsubG i) hε
  -- identify the parameter
  have hparam : ((∑ _i ∈ Finset.range (n - 1), (‖c - (-c)‖₊ / 2) ^ 2 : ℝ≥0) : ℝ)
      = ((n : ℝ) - 1) * c ^ 2 := by
    have hcoe : ((‖c - (-c)‖₊ / 2 : ℝ≥0) : ℝ) = c := by
      rw [show c - (-c) = 2 * c by ring]
      simp only [NNReal.coe_div, coe_nnnorm, Real.norm_eq_abs, NNReal.coe_ofNat,
        abs_of_nonneg (by linarith : (0:ℝ) ≤ 2 * c)]
      ring
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, NNReal.coe_mul, NNReal.coe_pow,
      hcoe, NNReal.coe_natCast, Nat.cast_sub (by omega)]
    push_cast
    ring
  rw [hparam] at hazuma
  -- and compare the events
  refine le_trans ?_ (le_trans hazuma (le_of_eq ?_))
  · refine measureReal_mono ?_ (measure_ne_top _ _)
    rintro h ⟨st, act, hagree, hsum⟩
    refine le_trans hsum (le_of_eq (Finset.sum_congr rfl fun t htmem ↦ ?_))
    have ht : t < n - 1 := Finset.mem_range.1 htmem
    have ht1 : t + 1 < n := by omega
    simp only [hY, dif_pos ht1]
    congr 1
    rw [hagree ⟨t + 1, ht1⟩]
  · congr 1
    ring
