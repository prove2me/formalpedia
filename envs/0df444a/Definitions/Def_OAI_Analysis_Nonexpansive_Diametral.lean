/-!
# The Goebel–Karlovitz diameter lemma

The proof uses actual eventual-radius sublevel sets in place of numerical
limsups. Their closedness, convexity, and invariance are proved below.
Weak compactness supplies a cluster point in actual weakly closed norm balls.
-/

noncomputable section

open Set Filter Topology

namespace ReflexiveFixedPoints.NormalizedMinimalData

universe u

variable {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- The image of a minimal invariant set has the whole set as its closed convex hull. -/
theorem image_hull_eq (D : NormalizedMinimalData (X := X)) :
    closure (convexHull ℝ (Set.range (fun x : D.K => (D.T x : X)))) = D.K := by
  let A := closure (convexHull ℝ (Set.range (fun x : D.K => (D.T x : X))))
  have hAK : A ⊆ D.K := by
    apply closure_minimal _ D.closed
    apply convexHull_min _ D.convex
    rintro _ ⟨x, rfl⟩
    exact (D.T x).property
  have himage (x : D.K) : (D.T x : X) ∈ A :=
    subset_closure (subset_convexHull ℝ _ (Set.mem_range_self x))
  apply D.minimal A hAK
  · obtain ⟨x, hx⟩ := D.nonempty
    exact ⟨D.T ⟨x, hx⟩, himage ⟨x, hx⟩⟩
  · exact isClosed_closure
  · exact (convex_convexHull ℝ _).closure
  · intro x _
    exact himage x

 def eventualRadius (D : NormalizedMinimalData (X := X))
    (u : ℕ → D.K) (r : ℝ) : Set X :=
  {z | z ∈ D.K ∧ ∀ ε > 0, ∀ᶠ n in atTop, dist z (u n : X) ≤ r + ε}

 theorem eventualRadius_closed (D : NormalizedMinimalData (X := X))
    (u : ℕ → D.K) (r : ℝ) : IsClosed (eventualRadius D u r) := by
  apply isClosed_of_closure_subset
  intro z hz
  have hzK : z ∈ D.K :=
    D.closed.closure_subset (closure_mono (fun _ hx => hx.1) hz)
  refine ⟨hzK, ?_⟩
  intro ε hε
  obtain ⟨w, hw, hzw⟩ := Metric.mem_closure_iff.mp hz (ε / 2) (half_pos hε)
  filter_upwards [hw.2 (ε / 2) (half_pos hε)] with n hn
  have htri := dist_triangle z w (u n : X)
  linarith

 theorem eventualRadius_convex (D : NormalizedMinimalData (X := X))
    (u : ℕ → D.K) (r : ℝ) : Convex ℝ (eventualRadius D u r) := by
  intro x hx y hy a b ha hb hab
  refine ⟨D.convex hx.1 hy.1 ha hb hab, ?_⟩
  intro ε hε
  filter_upwards [hx.2 ε hε, hy.2 ε hε] with n hxn hyn
  calc
    dist (a • x + b • y) (u n : X) ≤
        a * dist x (u n : X) + b * dist y (u n : X) :=
      (convexOn_dist (u n : X) D.convex).2 hx.1 hy.1 ha hb hab
    _ ≤ a * (r + ε) + b * (r + ε) :=
      add_le_add (mul_le_mul_of_nonneg_left hxn ha) (mul_le_mul_of_nonneg_left hyn hb)
    _ = r + ε := by rw [← add_mul, hab, one_mul]

 theorem eventualRadius_invariant (D : NormalizedMinimalData (X := X))
    (u : ℕ → D.K) (r : ℝ)
    (hu : Tendsto (fun n => ‖(D.T (u n) : X) - (u n : X)‖) atTop (𝓝 0)) :
    InvariantSubset D.K D.T (eventualRadius D u r) := by
  intro z hz
  refine ⟨(D.T z).property, ?_⟩
  intro ε hε
  have hsmall : ∀ᶠ n in atTop, ‖(D.T (u n) : X) - (u n : X)‖ < ε / 2 :=
    hu.eventually (Iio_mem_nhds (half_pos hε))
  filter_upwards [hz.2 (ε / 2) (half_pos hε), hsmall] with n hzn hdef
  have hnon : dist (D.T z : X) (D.T (u n) : X) ≤ dist (z : X) (u n : X) := by
    simpa [Subtype.dist_eq] using D.nonexpansive.dist_le_mul z (u n)
  have htri := dist_triangle (D.T z : X) (D.T (u n) : X) (u n : X)
  rw [dist_eq_norm (D.T (u n) : X) (u n : X)] at htri
  linarith

 theorem weak_closedBall (z : X) (r : ℝ) :
    IsClosed ((toWeakSpace ℝ X) '' Metric.closedBall z r) := by
  apply closure_eq_iff_isClosed.mp
  rw [← (convex_closedBall z r).toWeakSpace_closure ℝ,
    Metric.isClosed_closedBall.closure_eq]

 def centerSet (D : NormalizedMinimalData (X := X)) (r : ℝ) : Set X :=
  D.K ∩ ⋂ w : D.K, Metric.closedBall (w : X) r

 theorem centerSet_invariant (D : NormalizedMinimalData (X := X)) (r : ℝ) :
    InvariantSubset D.K D.T (centerSet D r) := by
  intro z hz
  refine ⟨(D.T z).property, Set.mem_iInter.mpr ?_⟩
  intro w
  have hball : D.K ⊆ Metric.closedBall (D.T z : X) r := by
    refine D.image_hull_eq.ge.trans ?_
    apply closure_minimal _ Metric.isClosed_closedBall
    apply convexHull_min _ (convex_closedBall _ _)
    rintro _ ⟨v, rfl⟩
    have hzv : dist (z : X) (v : X) ≤ r :=
      Metric.mem_closedBall.mp (Set.mem_iInter.mp hz.2 v)
    have hnon : dist (D.T z : X) (D.T v : X) ≤ dist (z : X) (v : X) := by
      simpa [Subtype.dist_eq] using D.nonexpansive.dist_le_mul z v
    exact Metric.mem_closedBall.mpr (by rw [dist_comm]; exact hnon.trans hzv)
  have hw := Metric.mem_closedBall.mp (hball w.property)
  exact Metric.mem_closedBall.mpr (by simpa [dist_comm] using hw)

 theorem one_le_radius_of_bounded_afps (D : NormalizedMinimalData (X := X))
    (u : ℕ → D.K)
    (hu : Tendsto (fun n => ‖(D.T (u n) : X) - (u n : X)‖) atTop (𝓝 0))
    (r : ℝ) (z : D.K) (hz : ∀ n, dist (z : X) (u n : X) ≤ r) : 1 ≤ r := by
  have hA : eventualRadius D u r = D.K := by
    apply D.minimal (eventualRadius D u r) (fun _ hx => hx.1)
    · refine ⟨z, z.property, ?_⟩
      intro ε hε
      exact Eventually.of_forall (fun n => (hz n).trans (by linarith))
    · exact eventualRadius_closed D u r
    · exact eventualRadius_convex D u r
    · exact eventualRadius_invariant D u r hu
  have hcompact : IsCompact ((toWeakSpace ℝ X) '' D.K) := D.weak_compact
  have hcarried :
      Filter.map (fun n => toWeakSpace ℝ X (u n : X)) atTop ≤
        𝓟 ((toWeakSpace ℝ X) '' D.K) := by
    apply le_principal_iff.mpr
    change ∀ᶠ n in atTop, toWeakSpace ℝ X (u n : X) ∈ (toWeakSpace ℝ X) '' D.K
    exact Eventually.of_forall (fun n => ⟨u n, (u n).property, rfl⟩)
  obtain ⟨a, ha, hcluster⟩ := hcompact.exists_clusterPt hcarried
  obtain ⟨a, ha, rfl⟩ := ha
  have har (w : D.K) : dist a (w : X) ≤ r := by
    apply le_of_forall_pos_le_add
    intro ε hε
    have hwA : (w : X) ∈ eventualRadius D u r := by rw [hA]; exact w.property
    have hevent : ((toWeakSpace ℝ X) '' Metric.closedBall (w : X) (r + ε)) ∈
        Filter.map (fun n => toWeakSpace ℝ X (u n : X)) atTop := by
      change ∀ᶠ n in atTop,
        toWeakSpace ℝ X (u n : X) ∈ (toWeakSpace ℝ X) '' Metric.closedBall (w : X) (r + ε)
      filter_upwards [hwA.2 ε hε] with n hn
      exact ⟨u n, Metric.mem_closedBall.mpr (by simpa [dist_comm] using hn), rfl⟩
    have hclosed := weak_closedBall (w : X) (r + ε)
    have hmem := hcluster.mem_closure_of_mem _ hevent
    rw [hclosed.closure_eq] at hmem
    obtain ⟨b, hb, hba⟩ := hmem
    have hba' : b = a := (toWeakSpace ℝ X).injective hba
    subst b
    exact Metric.mem_closedBall.mp hb
  have hC : centerSet D r = D.K := by
    apply D.minimal (centerSet D r) (fun _ hx => hx.1)
    · exact ⟨a, ha, Set.mem_iInter.mpr (fun w => Metric.mem_closedBall.mpr (har w))⟩
    · exact D.closed.inter (isClosed_iInter (fun w : D.K => Metric.isClosed_closedBall))
    · exact D.convex.inter (convex_iInter (fun w : D.K => convex_closedBall (w : X) r))
    · exact centerSet_invariant D r
  have hdiam : Metric.diam D.K ≤ r := by
    apply Metric.diam_le_of_forall_dist_le_of_nonempty D.nonempty
    intro x hx y hy
    have hxC : x ∈ centerSet D r := by rw [hC]; exact hx
    exact Metric.mem_closedBall.mp (Set.mem_iInter.mp hxC.2 ⟨y, hy⟩)
  simpa [D.diam_one] using hdiam

/-- Every approximate fixed point sequence is diametral at every point of the minimal set. -/
theorem diametral (D : NormalizedMinimalData (X := X)) (u : ℕ → D.K)
    (hu : Tendsto (fun n => ‖(D.T (u n) : X) - (u n : X)‖) atTop (𝓝 0))
    (z : D.K) :
    Tendsto (fun n => ‖(u n : X) - (z : X)‖) atTop (𝓝 1) := by
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  by_contra h
  push Not at h
  choose ns hge hbad using h
  have hns : Tendsto ns atTop atTop := tendsto_atTop_mono hge tendsto_id
  have hbound (n : ℕ) : dist (z : X) (u (ns n) : X) ≤ 1 - ε := by
    have hle := D.norm_sub_le_one (u (ns n)) z
    have hn := hbad n
    rw [Real.dist_eq, abs_of_nonpos (sub_nonpos.mpr hle)] at hn
    rw [dist_comm, dist_eq_norm]
    linarith
  have hrad := one_le_radius_of_bounded_afps D (fun n => u (ns n))
    (hu.comp hns) (1 - ε) z hbound
  linarith

end ReflexiveFixedPoints.NormalizedMinimalData

