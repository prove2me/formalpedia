theorem ModularCurve.modularFunctionFieldFull_algHom_ext {N : ℕ} {A : Type*} [DivisionRing A] [Algebra ℚ A] {f g : modularFunctionFieldFull N →ₐ[ℚ] A} (h : ∀ (d : ℕ) (_ : NeZero d) (hd : d ∣ N), f ⟨qExpand ℚ d jq, jqd_mem_full N hd⟩ = g ⟨qExpand ℚ d jq, jqd_mem_full N hd⟩) : f = g := by sorry
