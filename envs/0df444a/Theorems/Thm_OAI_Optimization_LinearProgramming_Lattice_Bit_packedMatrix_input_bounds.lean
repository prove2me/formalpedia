theorem packedMatrix_input_bounds {n m : ℕ} (b : Hex.Matrix ℤ n m) (hn : 0 < n) :
    let L := (intMatrixCode (packMatrix b)).length
    n ≤ L ∧ m ≤ L ∧ ∀ i j, ((b.getRow i).get j).natAbs.size ≤ L := by sorry
