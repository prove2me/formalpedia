section SetIntegral

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

theorem _root_.solution {P : Measure Ω}
    [IsFiniteMeasure P] {X : Ω → V} (hX : Measurable X) {Z : Ω → ℂ} (hZ : Integrable Z P)
    (h : ∀ w : V, ∫ ω, Complex.exp ((⟪X ω, w⟫ : ℝ) * Complex.I) * Z ω ∂P = 0)
    {s : Set Ω} (hs : MeasurableSet[MeasurableSpace.comap X inferInstance] s) :
    ∫ ω in s, Z ω ∂P = 0 := by
  obtain ⟨hre, him⟩ := integral_smul_re_im_eq_zero
    (E := fun w ω => Complex.exp ((⟪X ω, w⟫ : ℝ) * Complex.I))
    (fun w => (by fun_prop : Continuous fun v : V => Complex.exp ((⟪v, w⟫ : ℝ) * Complex.I)).comp_aestronglyMeasurable
      hX.aestronglyMeasurable)
    (fun w ω => Complex.norm_exp_ofReal_mul_I _)
    (fun w ω => char_neg (X ω) w) hZ h
  have h1 := setIntegral_eq_zero_of_integral_char_comp_smul_eq_zero hX hZ.re hre hs
  have h2 := setIntegral_eq_zero_of_integral_char_comp_smul_eq_zero hX hZ.im him hs
  rw [← integral_re_add_im hZ.restrict, h1, h2]
  simp

end SetIntegral

