theorem ratio_window_shift (c a b i j t : ℕ) (hc : 0 < c)
    (h : c ^ i * a ≤ c ^ j * b ∧ c ^ j * b < c ^ 2 * (c ^ i * a)) :
    c ^ (i + t) * a ≤ c ^ (j + t) * b ∧ c ^ (j + t) * b < c ^ 2 * (c ^ (i + t) * a) := by
  obtain ⟨h1, h2⟩ := h
  constructor
  · calc c ^ (i + t) * a = c ^ t * (c ^ i * a) := by ring
      _ ≤ c ^ t * (c ^ j * b) := Nat.mul_le_mul_left _ h1
      _ = c ^ (j + t) * b := by ring
