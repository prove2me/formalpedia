    (laurentBaseChange ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (xHFunctionField (q ^ 2 * M') (levelH q M'))) ↥(A.comap (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ))) hAq (e.symm j₁) hj g hg hgA hgj hgK

