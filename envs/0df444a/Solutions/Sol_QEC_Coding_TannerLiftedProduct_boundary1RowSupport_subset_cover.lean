open QEC.Coding.LiftedProduct
universe u v
variable {F : Type u} {G W R R' : Type v}
variable [Field F] [Fintype F]
variable [Group G] [Fintype G] [DecidableEq G]
variable [Fintype W] [DecidableEq W]
variable [Fintype R] [DecidableEq R]
variable [Fintype R'] [DecidableEq R']
namespace QEC.Coding.TannerLiftedProduct
theorem _root_.solution
    (label : W → G) (h : Matrix R W F) (g' : Matrix R' W F)
    (c0 : LiftedProduct.C0Index (Fin 2 × R) W G) :
    LiftedProduct.boundary1RowSupport (data label h g') c0 ⊆
      boundary1SupportCover label h g' c0 := by
  classical
  rcases c0 with ⟨ar, br, go⟩
  intro q hq
  cases q with
  | inl q =>
      rcases q with ⟨ac, br', gi⟩
      rw [LiftedProduct.mem_boundary1RowSupport_inl] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      rw [data, doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgi : gi = go * (doubleCoverVoltage label ar.1 ac)⁻¹ := by
        calc
          gi = go * (gi⁻¹ * go)⁻¹ := by simp
          _ = go * (doubleCoverVoltage label ar.1 ac)⁻¹ := by rw [hCoeff.1]
      apply Finset.mem_union_left
      apply Finset.mem_map.mpr
      refine ⟨ac, Finset.mem_univ ac, ?_⟩
      subst gi
      rfl
  | inr q =>
      rcases q with ⟨ar', bc, gi⟩
      rw [LiftedProduct.mem_boundary1RowSupport_inr] at hq
      rcases hq with ⟨rfl, hCoeff⟩
      change (LiftedProduct.groupConj
        (doubleCoverTannerMatrix label g' bc br)).coeff (go * gi⁻¹) ≠ 0 at hCoeff
      rw [LiftedProduct.groupConj_apply,
        doubleCoverTannerMatrix_coeff_ne_zero_iff] at hCoeff
      have hgi : gi = doubleCoverVoltage label bc.1 br * go := by
        calc
          gi = (gi * go⁻¹) * go := by simp
          _ = doubleCoverVoltage label bc.1 br * go := by
            rw [show gi * go⁻¹ = doubleCoverVoltage label bc.1 br by
              simpa only [mul_inv_rev, inv_inv] using hCoeff.1]
      apply Finset.mem_union_right
      apply Finset.mem_map.mpr
      refine ⟨bc, Finset.mem_univ bc, ?_⟩
      subst gi
      rfl
end QEC.Coding.TannerLiftedProduct
