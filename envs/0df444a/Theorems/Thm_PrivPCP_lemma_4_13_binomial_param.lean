-- title:
--   Lemma 4.13, dependent case: rational parametrization $x=\mu z^b$, $y=\nu z^{\pm a}$
-- statement:
--   This is the structural step of the multiplicatively dependent case in the proof of Lemma 4.13 in the source.
--
--   Let $q$ be prime, $K=\overline{\mathbb F}_q$, let $S_1,S_2\le\mathbb F_q^\times$ be subgroups of coprime orders $n_1,n_2$, and let $F\in K[X,Y]$ be irreducible of bidegree $(a,b)$ with $0<a,b<q$. Let $x,y$ be the coordinate functions of its function field $L=K(x,y)$, and suppose $(x^{n_1})^r(y^{n_2})^s\in K^\times$ for some $(r,s)\ne(0,0)$. Then $L$ is a rational function field: there are a transcendental $z$ with $L=K(z)$, constants $\mu,\nu\in K^\times$ and a sign $\sigma\in\{\pm1\}$ with
--
--   $$x=\mu z^{b},\qquad y=\nu z^{\sigma a}.$$
--
--   In the source, clearing negative exponents gives $x^Ay^B=\lambda$ or $x^A=\lambda y^B$. Factoring this binomial and using the irreducibility of $F$ shows that $F$ is a primitive binomial $X^aY^b=\lambda'$ or $X^a=\lambda'Y^b$ with $\gcd(a,b)=1$. Its normalization then has a coordinate $z$ with $x=\mu z^b$ and $y=\nu z^{\mp a}$.
--
--   **Formalization Note** The function field is any field generated by $x,y$ in which the kernel of $X\mapsto x$, $Y\mapsto y$ is $(F)$. The exponent $\sigma a$ is an integer power, so negative exponents are allowed.
-- source:
--   Bafna, Vyas, Private PCPs from Product Expansion, STOC 2027 submission manuscript (sha256 c2cac1e07fc4af8721f673867373fc5bd417aa65f45cf170c543568abcf1e47e), proof of Lemma 4.13, p.25 (PDF p.27), multiplicatively dependent case

import Mathlib

namespace PrivPCP

theorem lemma_4_13_binomial_param : ∀ (q : ℕ) [Fact q.Prime] (S₁ S₂ : Subgroup (ZMod q)ˣ),
    Nat.Coprime (Nat.card S₁) (Nat.card S₂) →
    ∀ F : MvPolynomial (Fin 2) (AlgebraicClosure (ZMod q)),
    Irreducible F → 0 < F.degreeOf 0 → 0 < F.degreeOf 1 → F.degreeOf 0 < q → F.degreeOf 1 < q →
    ∀ (L : Type) [Field L] [Algebra (AlgebraicClosure (ZMod q)) L] (x y : L),
    RingHom.ker (MvPolynomial.aeval (R := AlgebraicClosure (ZMod q)) ![x, y]).toRingHom =
      Ideal.span {F} →
    IntermediateField.adjoin (AlgebraicClosure (ZMod q)) {x, y} = ⊤ →
    (∃ r s : ℤ, ¬ (r = 0 ∧ s = 0) ∧ ∃ c : AlgebraicClosure (ZMod q), c ≠ 0 ∧
      (x ^ Nat.card S₁) ^ r * (y ^ Nat.card S₂) ^ s =
        algebraMap (AlgebraicClosure (ZMod q)) L c) →
    ∃ (z : L) (μ ν : AlgebraicClosure (ZMod q)) (σ : ℤ), μ ≠ 0 ∧ ν ≠ 0 ∧ (σ = 1 ∨ σ = -1) ∧
      Transcendental (AlgebraicClosure (ZMod q)) z ∧
      IntermediateField.adjoin (AlgebraicClosure (ZMod q)) {z} = ⊤ ∧
      x = algebraMap (AlgebraicClosure (ZMod q)) L μ * z ^ F.degreeOf 1 ∧
      y = algebraMap (AlgebraicClosure (ZMod q)) L ν * z ^ (σ * (F.degreeOf 0 : ℤ)) := by
  sorry

end PrivPCP
