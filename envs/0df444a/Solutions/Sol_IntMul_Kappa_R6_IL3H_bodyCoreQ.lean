section
-- Source module: Solutions.ButterflyLayer
/-!
# §5 The simultaneous butterfly layer as an array denotation

The array has complete address set `[P] × [2^K]^D × [S]` (shape `layerShape P K D S`), in
lexicographic order, one record per address. Records live in a complex vector space `M`
(a record of `r` coefficients is `Fin r → ℂ`; its sup norm is the maximum coefficient norm, and
every operator below acts coefficientwise because it is `ℂ`-linear on records).

On each of the `D` chunks, bit `ρ` (from the least significant end) is selected.
A matrix `T` on the selected bits acts by
`(selOp T xs)(a) = ∑_y T(bits a, y) • xs(a with selected bits y)`,
fixing every unselected bit and both spectator fields.

* `selOp_mul`, `selOp_one`, `selOp_list_prod`: composition = matrix product.
* `selOp_diagonal`: diagonals are pointwise maps (the phase `S_D`, the signs `Z^{⊗}`).
* `kernel_pair`: an individual selected-bit kernel is the paired map of (25) on the two
  aligned streams split at that bit.
* `layer_eq_kernels`: the layer `A^{⊗D}` is the composition of the `D` individual kernels.
* `butterflyLayer_eq` (18 on arrays): `H0`-layer `= b^D • S_D ∘ C-layer ∘ S_D`.
* `butterflyLayer_norm_le`: disk arrays go to disk arrays.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open AModel Matrix Finset

/-! ## 1. Abstract selected-bit structure on a shape -/

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

variable (Sb : SelBits sh ι)

@[simp] lemma length_selOp (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    (selOp Sb T xs).length = vol sh := by simp [selOp]

lemma getElem_selOp (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) (j : ℕ)
    (hj : j < (selOp Sb T xs).length) :
    (selOp Sb T xs)[j] =
      ∑ y, T (Sb.bits (decode sh j)) y • xs.getD (encode sh (Sb.set (decode sh j) y)) 0 := by
  simp [selOp]

/-- Value of `selOp` at a valid address. -/
lemma getD_selOp_encode (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) {a : List ℕ}
    (ha : Valid sh a) :
    (selOp Sb T xs).getD (encode sh a) 0 =
      ∑ y, T (Sb.bits a) y • xs.getD (encode sh (Sb.set a y)) 0 := by
  have hlt := encode_lt ha
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), getElem_selOp, decode_encode ha]

/-- Composition of selected-bit operators is the matrix product. -/
theorem selOp_mul (T U : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb T (selOp Sb U xs) = selOp Sb (T * U) xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_selOp] at h₁
  have hv := valid_decode h₁
  rw [getElem_selOp, getElem_selOp]
  simp_rw [getD_selOp_encode Sb U xs (Sb.valid_set _ _ hv), Sb.bits_set _ _ hv,
    Sb.set_set _ _ _ hv, Finset.smul_sum, smul_smul, Matrix.mul_apply, Finset.sum_smul]
  exact Finset.sum_comm

theorem selOp_smul (c : ℂ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb (c • T) xs = (selOp Sb T xs).map (c • ·) := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [List.getElem_map, getElem_selOp, Matrix.smul_apply, smul_eq_mul, mul_smul,
    Finset.smul_sum]

/-! ## 2. Individual kernels and the full layer -/

lemma tensF_kerAt_apply (i : ι) (A : M2) (x y : ι → Fin 2) :
    tensF (kerAt i A) x y = ∑ b : Fin 2, if y = Function.update x i b then A (x i) b else 0 := by
  rw [tensF_apply, ← Finset.mul_prod_erase _ _ (mem_univ i)]
  have hi : kerAt i A i = A := Function.update_self _ _ _
  have hrest : ∏ k ∈ univ.erase i, kerAt i A k (x k) (y k) =
      if ∀ k, k ≠ i → x k = y k then 1 else 0 := by
    have : ∀ k ∈ univ.erase i, kerAt i A k (x k) (y k) = if x k = y k then 1 else 0 := by
      intro k hk
      rw [kerAt, Function.update_of_ne (Finset.ne_of_mem_erase hk), Matrix.one_apply]
    rw [Finset.prod_congr rfl this, Finset.prod_boole]
    simp only [Finset.mem_erase, mem_univ, and_true]
  rw [hi, hrest]
  rw [Finset.sum_eq_single (y i)]
  · by_cases hxy : ∀ k, k ≠ i → x k = y k
    · have : y = Function.update x i (y i) := by
        funext k; by_cases hk : k = i
        · subst hk; simp
        · rw [Function.update_of_ne hk, hxy k hk]
      rw [if_pos hxy, if_pos this, mul_one]
    · have : ¬ y = Function.update x i (y i) := by
        intro hy; apply hxy; intro k hk; rw [hy, Function.update_of_ne hk]
      rw [if_neg hxy, if_neg this, mul_zero]
  · intro b _ hb
    rw [if_neg]; intro hy; apply hb; rw [hy, Function.update_self]
  · simp

/-- (18) on arrays: `H0^{⊗D} z = b^D • S_D C^{⊗D} S_D z`. -/
theorem butterflyLayer_eq (xs : List M) :
    butterflyLayer Sb xs =
      (phaseLayer Sb (cLayer Sb (phaseLayer Sb xs))).map ((cb ^ Fintype.card ι) • ·) := by
  rw [butterflyLayer, tens_H0, selOp_smul, phaseLayer, cLayer, phaseLayer, selOp_mul, selOp_mul]

/-- Disk arrays go to disk arrays (every row of `H0^{⊗D}` has absolute row sum one). -/
theorem butterflyLayer_norm_le {N : Type*} [SeminormedAddCommGroup N] [NormedSpace ℂ N]
    (Sb : SelBits sh ι) (xs : List N) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∀ j (h : j < (butterflyLayer Sb xs).length), ‖(butterflyLayer Sb xs)[j]‖ ≤ 1 := by
  intro j h
  rw [show (butterflyLayer Sb xs)[j] = _ from getElem_selOp Sb (tens H0) xs j h]
  have hg : ∀ k, ‖xs.getD k 0‖ ≤ 1 := by
    intro k
    by_cases hk : k < xs.length
    · rw [List.getD_eq_getElem _ _ hk]; exact hxs k hk
    · rw [List.getD_eq_default _ _ (by omega)]; simp
  calc ‖∑ y, (tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖
      ≤ ∑ y, ‖(tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖ := norm_sum_le _ _
    _ ≤ ∑ y, ‖(tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y‖ := by
        apply Finset.sum_le_sum; intro y _
        rw [norm_smul]
        exact mul_le_of_le_one_right (norm_nonneg _) (hg _)
    _ = 1 := tens_H0_row_sum _

/-! ## 3. The concrete layout `[P] × [2^K]^D × [S]` with bit `ρ` selected in every chunk -/

section Layout

variable (P K D S ρ : ℕ)

/-- (18) for the concrete layout. -/
theorem layerH_eq (hρ : ρ < K) (xs : List M) :
    layerH P K D S ρ hρ xs =
      (phaseLayer (layerSel P K D S ρ hρ) (cLayer (layerSel P K D S ρ hρ)
        (phaseLayer (layerSel P K D S ρ hρ) xs))).map (((-Complex.I / 2) ^ (D / 2) * cb ^ (D % 2)) • ·) := by
  rw [layerH, butterflyLayer_eq, Fintype.card_fin, cb_pow]

end Layout

end Butterfly

end

section
-- Source module: Solutions.ButterflyProp14
/-!
# §5.1/§5.3/Proposition 14, conditional on the Proposition 8 interface

The phase-frame network of Proposition 8 is taken as an explicit hypothesis `Prop8Iface W m s`:
for every column index type `κ`, a list of network steps acting on `W` roles, each role
holding a complex function of the `m·|κ|` selected bits of one group (`Fin m × κ`: slot `h`,
column `j`). A step is either a non-recursive linear step (binary row additions `P_M`, scalar
gates, source/sink/bank corrections — any matrix) or a child call on slot `h` of role `w`,
forward (`(C)^{⊗κ}`) or inverse (implemented by (17) as `(-i)^{|κ|} Z C^{⊗κ} Z`, one forward call).
The interface asserts: exactly `s` child steps, and with exact children the composite is
`C^{⊗(Fin m × κ)}` on every role (the "exact recursive contract" of §5.1).

From it we prove:
* `recOp_eq`: the recursive program (leaves = individual kernels (25)) computes `C^{⊗}` on
  `u·m^k` selected bits at every depth `k`, on every role including scratch roles.
* `recCost_le`: its cost obeys the §5.3 recurrence and is `≤ K₁ V ((u m^k)^λ + (u m^k)^σ u^{1-σ})`.
* `tens_blocks`, `embed_tens`: pieces on disjoint blocks of selected bits multiply to `C^{⊗D}`.
* `prop14_output`: the layer procedure `Q_p(b^D S_D C^{⊗D} S_D z)` equals `Q_p(H0^{⊗D} z)`, stays
  in the unit disk and is within `√2·2^{-p}` of `H0^{⊗D} z` in every coefficient.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open Matrix Finset Complex AModel

/-! ## The recursion -/

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

/-! ## Pieces on disjoint blocks of selected bits -/

/-! ## Proposition 14: the normalized layer from the C-layer -/

section Prop14

variable {P K D S ρ r : ℕ}

/-- **Proposition 14, output (conditional on the C-layer).** Let `Cimpl` be any implementation
of `C^{⊗D}` on the selected bits (by `recOp_eq` and `tens_blocks`/`embed_tens`, the recursive
program on the pieces is one). The procedure returns exactly `Q_p(H0^{⊗D} z)`; for disk inputs
every returned coefficient lies in the disk and differs from the exact layer by less than
`√2 · 2^{-p}`. -/
theorem prop14_output (hρ : ρ < K) (p : ℕ) (Cimpl : Op (Fin D)) (hC : Cimpl = tens Cm)
    (xs : List (Fin r → ℂ)) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c‖ ≤ 1) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length)
      (h' : j < (layerH P K D S ρ hρ xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c - (layerH P K D S ρ hρ xs)[j] c‖
        < Real.sqrt 2 * 2⁻¹ ^ p) := by
  have hout : prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) := by
    unfold prop14Proc; rw [hC, layerH_eq]; simp only [phaseLayer, cLayer]
  refine ⟨hout, ?_, ?_⟩
  · intro j h c
    rw [List.getElem_of_eq hout h]
    have hj : j < (layerH P K D S ρ hρ xs).length := by rw [hout] at h; simpa [QpArr] using h
    have hd := butterflyLayer_norm_le (layerSel P K D S ρ hρ) xs hxs j hj
    unfold QpArr; rw [List.getElem_map]
    exact (norm_Qp_le p _).trans ((norm_le_pi_norm _ c).trans hd)
  · intro j h h' c
    rw [List.getElem_of_eq hout h]
    unfold QpArr; rw [List.getElem_map]
    exact norm_Qp_sub_lt p _

end Prop14

