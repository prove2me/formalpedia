-- title:
--   Young symmetrizers, cell modules $\Delta_{r,s}(\lambda^L,\lambda^R)$, labels and simple modules $L_{r,s}(\lambda^L,\lambda^R)$ (pp. 6–10, 22)
-- statement:
--   Let $k$ be a field of characteristic $0$, $\delta\in k$ and $0\le t\le\min(r,s)$. Let $\lambda^L\vdash r-t$ and $\lambda^R\vdash s-t$, so $(\lambda^L,\lambda^R)\in\Lambda^{r-t,s-t}$.
--
--   1. **Young symmetrizer.** Number the boxes of $\lambda^L$ along the rows, from left to right and from top to bottom (p. 22), and place them on the left propagating nodes $1,\dots,r-t$ of $X_t$. Place the boxes of $\lambda^R$ in the same way on the right propagating nodes $r+t+1,\dots,r+s$. Let $C$ and $R$ be the column and row stabilisers of this filling inside $\Sigma_{r,s}$. Put
--   $$
--   y_{\lambda}=\sum_{\sigma\in C}\sum_{\tau\in R}\operatorname{sgn}(\sigma)\,\sigma\tau\ \in k\Sigma_{r,s}\subseteq B_{r,s}(\delta).
--   $$
--   This is the paper's convention on p. 22, without the normalising factor. It equals $y_{\lambda^L}y_{\lambda^R}$.
--   2. **Cell module.** Let $\Delta_{r,s}(\lambda^L,\lambda^R)$ be the $B_{r,s}(\delta)$-submodule of $B_{r,s}(\delta)/J_{t+1}$ generated by the class of $X_t\,y_\lambda$.
--   3. **Labels.** The labels of simple modules are all $(\lambda^L,\lambda^R)\in\Lambda^{r-t,s-t}$ with $0\le t\le\min(r,s)$, except $(\emptyset,\emptyset)$ (that is, $t=r=s>0$) when $\delta=0$ and $r=s$ (Theorem 2.7(ii),(iii), with $p=0$).
--   4. **Simple modules.** $L_{r,s}(\lambda^L,\lambda^R)$ is the head of $\Delta_{r,s}(\lambda^L,\lambda^R)$ (p. 8).
--
--   **Formalization Note** This model is the paper's cell module in characteristic $0$. Modulo $J_{t+1}$, $B_{r,s}X_t$ has basis the diagrams $X_{v,1,\sigma}$ ($v\in V_{r,s,t}$, $\sigma\in\Sigma_{r-t,s-t}$). So $B_{r,s}X_ty_\lambda\equiv I^t_{r,s}\otimes k\Sigma_{r-t,s-t}\,y_\lambda$. In characteristic $0$, $k\Sigma_{r-t,s-t}\,y_\lambda\cong S^{\lambda^L}\boxtimes S^{\lambda^R}$. This gives $\Delta_{r,s}(\lambda^L,\lambda^R)\cong I^t_{r,s}\otimes_{\Sigma_{r-t,s-t}}(S^{\lambda^L}\boxtimes S^{\lambda^R})$, the description after Proposition 3.1 (p. 10). Any filling, and either order of the two stabiliser sums, gives an isomorphic module. Cell indices (`CellIndex`) carry $t$, $\lambda^L$ and $\lambda^R$ with $|\lambda^L|=r-t$ and $|\lambda^R|=s-t$. Labels (`Label`) add the exclusion of $(\emptyset,\emptyset)$ when $\delta=0$ and $r=s$. The cell module $\Delta_{r,r}(\emptyset,\emptyset)$ still exists for $\delta=0$, but it is not a label. Rows and columns of the filling are computed from `YoungDiagram.rowLens`.
-- source:
--   Cox, De Visscher, Doty & Martin, On the blocks of the walled Brauer algebra, arXiv:0709.0851v1, pp. 6–10 (Theorem 2.7, Proposition 3.1), p. 22 (Young symmetrizers)

import Mathlib
import Definitions.Def_WalledBrauer_Blocks_Algebra
import Definitions.Def_WalledBrauer_Blocks_ModuleTheory

namespace WalledBrauer.Blocks

/-- The row (0-based) of the box numbered `a` (0-based) when the boxes of `μ` are numbered along
the rows from left to right and from top to bottom (p. 22): the number of complete rows that
precede it. -/
def rowOfIndex (μ : YoungDiagram) (a : ℕ) : ℕ :=
  ((List.range μ.rowLens.length).filter fun i => (μ.rowLens.take (i + 1)).sum ≤ a).length

/-- The column (0-based) of the box numbered `a` in the same numbering. -/
def colOfIndex (μ : YoungDiagram) (a : ℕ) : ℕ :=
  a - (μ.rowLens.take (rowOfIndex μ a)).sum

/-- The tableau labels used for the Young symmetrizer of `(λL, λR)` at stage `t`
(`λL ⊢ r - t`, `λR ⊢ s - t`): the left propagating nodes `a < r - t` carry the boxes of `λL`
numbered `a`, the right propagating nodes `r + t ≤ a < r + s` carry the boxes of `λR` numbered
`a - (r + t)`; `pos` picks rows (`pos = true`) or columns. Every other node gets its own label
`Sum.inr a`, so it is fixed by both stabilisers. -/
def tableauLabel (r s t : ℕ) (lamL lamR : YoungDiagram) (pos : Bool) (a : Fin (r + s)) :
    (Bool × ℕ) ⊕ Fin (r + s) :=
  if a.val < r - t then
    Sum.inl (false, if pos then rowOfIndex lamL a.val else colOfIndex lamL a.val)
  else if r + t ≤ a.val then
    Sum.inl (true, if pos then rowOfIndex lamR (a.val - (r + t))
      else colOfIndex lamR (a.val - (r + t)))
  else Sum.inr a

open scoped Classical in
/-- The row stabiliser `R(λL) × R(λR)` (`pos = true`) or the column stabiliser `C(λL) × C(λR)`
(`pos = false`), as permutations of the `r + s` nodes. -/
noncomputable def stabiliser (r s t : ℕ) (lamL lamR : YoungDiagram) (pos : Bool) :
    Finset (Equiv.Perm (Fin (r + s))) :=
  Finset.univ.filter fun σ =>
    ∀ a, tableauLabel r s t lamL lamR pos (σ a) = tableauLabel r s t lamL lamR pos a

variable {k : Type*} [Field k]

/-- The Young symmetrizer `y = y_{λL} y_{λR} = ∑_{σ ∈ C} ∑_{τ ∈ R} sgn(σ) σ τ` (the paper's
convention, p. 22, without the normalising factor) of `λL` on the left propagating nodes
`0, …, r-t-1` and of `λR` on the right propagating nodes `r+t, …, r+s-1`, as an element of
`k Σ_{r-t,s-t} ⊆ B_{r,s}(δ)`. -/
noncomputable def youngSymmetrizer (r s : ℕ) (δ : k) (t : ℕ) (lamL lamR : YoungDiagram) :
    WalledBrauerAlgebra k r s δ :=
  ∑ σ ∈ stabiliser r s t lamL lamR false, ∑ τ ∈ stabiliser r s t lamL lamR true,
    (((Equiv.Perm.sign σ : ℤ) : k)) •
      (diag (WalledDiagram.perm σ) * diag (WalledDiagram.perm τ))

/-- A cell-module index: `(λL, λR) ∈ Λ^{r-t,s-t}`, i.e. `0 ≤ t ≤ min(r, s)`, `λL ⊢ r - t`,
`λR ⊢ s - t` (Theorem 2.7(i), p. 8). -/
structure CellIndex (r s : ℕ) where
  /-- the number of northern arcs `t` -/
  t : ℕ
  /-- the left partition `λL` -/
  L : YoungDiagram
  /-- the right partition `λR` -/
  R : YoungDiagram
  t_le_r : t ≤ r
  t_le_s : t ≤ s
  card_L : L.cells.card = r - t
  card_R : R.cells.card = s - t

/-- The cell module `Δ_{r,s}(λL, λR)` (Proposition 3.1, p. 10), in characteristic zero: the
`B_{r,s}(δ)`-submodule of `B_{r,s}(δ) / J_{t+1}` generated by the class of `X_t · y`, with `X_t`
the arc diagram of `e_{r,s,t}` and `y` the Young symmetrizer of `(λL, λR)` on the propagating
nodes. -/
noncomputable def cellModule {r s : ℕ} (δ : k) (x : CellIndex r s) :
    Submodule (WalledBrauerAlgebra k r s δ) (WalledBrauerAlgebra k r s δ ⧸ cellIdeal r s δ (x.t + 1)) :=
  Submodule.span (WalledBrauerAlgebra k r s δ)
    {Submodule.Quotient.mk (diag (WalledDiagram.arcDiagram x.t) * youngSymmetrizer r s δ x.t x.L x.R)}

/-- The cell module as a type. -/
def CellModule {r s : ℕ} (δ : k) (x : CellIndex r s) : Type _ := ↥(cellModule δ x)

noncomputable instance {r s : ℕ} (δ : k) (x : CellIndex r s) : AddCommGroup (CellModule δ x) :=
  inferInstanceAs (AddCommGroup ↥(cellModule δ x))

noncomputable instance {r s : ℕ} (δ : k) (x : CellIndex r s) :
    Module (WalledBrauerAlgebra k r s δ) (CellModule δ x) :=
  inferInstanceAs (Module (WalledBrauerAlgebra k r s δ) ↥(cellModule δ x))

noncomputable instance {r s : ℕ} (δ : k) (x : CellIndex r s) : Module k (CellModule δ x) :=
  inferInstanceAs (Module k ↥(cellModule δ x))

instance {r s : ℕ} (δ : k) (x : CellIndex r s) :
    IsScalarTower k (WalledBrauerAlgebra k r s δ) (CellModule δ x) :=
  inferInstanceAs (IsScalarTower k (WalledBrauerAlgebra k r s δ) ↥(cellModule δ x))


/-- A label of a simple `B_{r,s}(δ)`-module in characteristic zero (Theorem 2.7(ii),(iii),
p. 8): every `(λL, λR) ∈ Λ^{r-t,s-t}`, `0 ≤ t ≤ min(r, s)`, except `(∅, ∅)` (`t = r = s`)
when `δ = 0` and `0 < r = s`. At `r = s = 0`, the algebra is `k` and has its one simple. -/
structure Label (r s : ℕ) (δ : k) extends CellIndex r s where
  not_excluded : ¬ (δ = 0 ∧ r = s ∧ 0 < r ∧ t = r)

/-- The simple module `L_{r,s}(λL, λR)`: the head of the cell module `Δ_{r,s}(λL, λR)` (p. 8). -/
abbrev SimpleModule {r s : ℕ} {δ : k} (x : Label r s δ) : Type _ :=
  Head (WalledBrauerAlgebra k r s δ) (CellModule δ x.toCellIndex)

end WalledBrauer.Blocks


