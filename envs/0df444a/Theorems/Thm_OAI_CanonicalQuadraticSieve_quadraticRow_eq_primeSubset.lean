theorem OAI.CanonicalQuadraticSieve.quadraticRow_eq_primeSubset (F : Finset (Ideal O)) (hF : ∀ I ∈ F, Admissible I)
    (I : Ideal O) (hIF : I ∈ F) (z : O) :
    quadraticRow I z = finiteSexticRow
      (fun i : idealSupport F I => i.val.val) (fun i => poolGood F hF i.val) (fun _ => 3) z := by sorry
