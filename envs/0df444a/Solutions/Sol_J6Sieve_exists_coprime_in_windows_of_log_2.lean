-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

/-- **Corollary** (logarithmic form): `log₂ H ≥ 4 (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2`
suffices. -/
theorem exists_coprime_in_windows_of_log_sol_aux (d X H : ℕ) (A : Fin d → ℕ)
    (hA : ∀ i, A i + H ≤ X)
    (hH : 4 * (Nat.log 2 (4 * (d * (Nat.log 2 X + 1) + 1)) + 2) ^ 2 ≤ Nat.log 2 H) :
    ∃ s : Fin d → ℕ, (∀ i, Odd (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      Pairwise (fun i j => Nat.Coprime (s i) (s j)) := by
  apply exists_coprime_in_windows_of_pow_le d X H A hA
  have hH0 : H ≠ 0 := by
    rintro rfl
    simp at hH
  exact (Nat.pow_le_pow_right (by norm_num) hH).trans (Nat.pow_log_le_self 2 hH0)

end J6Sieve

end

