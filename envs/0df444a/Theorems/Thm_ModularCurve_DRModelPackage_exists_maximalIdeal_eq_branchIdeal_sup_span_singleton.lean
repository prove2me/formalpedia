open CategoryTheory CategoryTheory.Limits AlgebraicGeometry ModularCurve

theorem ModularCurve.DRModelPackage.exists_maximalIdeal_eq_branchIdeal_sup_span_singleton
    (p : ℕ) [Fact p.Prime] (hp : 5 ≤ p) (𝔛 : DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    (n : ↥(pullback (𝔛.compInf κ) (𝔛.compZero κ)))
    (hinf : 𝔛.ξinf O κ toκ ⤳ 𝔛.crossingPt O κ toκ n) (hzero : 𝔛.ξzero O κ toκ ⤳ 𝔛.crossingPt O κ toκ n) :
    (∃ t : (baseChangeO p O).presheaf.stalk (𝔛.crossingPt O κ toκ n),
      IsLocalRing.maximalIdeal ((baseChangeO p O).presheaf.stalk (𝔛.crossingPt O κ toκ n)) =
        Scheme.branchIdeal hinf ⊔ Ideal.span {t}) ∧
    (∃ t : (baseChangeO p O).presheaf.stalk (𝔛.crossingPt O κ toκ n),
      IsLocalRing.maximalIdeal ((baseChangeO p O).presheaf.stalk (𝔛.crossingPt O κ toκ n)) =
        Scheme.branchIdeal hzero ⊔ Ideal.span {t}) := by sorry
