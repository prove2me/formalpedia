-- title:
--   Path space C, P_ψ(C) with τ_ψ, the control measures P(A), the base space (ξ, W) with its augmented filtration, admissible controls (§3.1)
-- statement:
--   This file sets up the probabilistic objects of the weak formulation of a mean field game.
--
--   1. **Paths.** $\mathcal C = C([0,T];\mathbb R^d)$ is the space of continuous paths with the sup norm $\|x\| = \sup_{s\in[0,T]}|x(s)|$ and its Borel $\sigma$-field. The canonical filtration on $\mathcal C$ is generated at time $t$ by the coordinates $x\mapsto x(s)$, $s\le t\wedge T$; a map $(t,x)\mapsto\varphi(t,x)$ is *progressively measurable* when it is progressive for this filtration.
--   2. **Measures with a moment.** For a measurable $\psi:\mathcal C\to[1,\infty)$,
--   $$\mathcal P_\psi(\mathcal C)=\Big\{\mu\in\mathcal P(\mathcal C):\int\psi\,d\mu<\infty\Big\},\qquad \mathcal B_\varphi(\mathcal C)=\Big\{f \text{ measurable}:\ \sup_x |f(x)|/\varphi(x)<\infty\Big\}.$$
--   The topology $\tau_\varphi(\mathcal C)$ on $\mathcal P_\psi(\mathcal C)$ is the weakest one making $\mu\mapsto\int f\,d\mu$ continuous for each $f\in\mathcal B_\varphi(\mathcal C)$. Unless said otherwise $\mathcal P_\psi(\mathcal C)$ carries $\tau_\psi(\mathcal C)$; $\tau_1(\mathcal C)$ is the case $\varphi\equiv 1$. Two measures are *equivalent*, $\mu\sim\mu'$, when each is absolutely continuous with respect to the other.
--   3. **Control measures.** For the control set $A$ in a normed space, $\mathcal P(A)$ is the set of probability measures on $A$, with the topology of weak convergence and the corresponding Borel $\sigma$-field.
--   4. **Base space.** A probability space $(\Omega,\mathcal F,P)$ carries an initial state $\xi$ with law $\lambda_0$ and a standard $d$-dimensional Brownian motion $W$ independent of $\xi$. The filtration $\mathcal F_t$ is generated by $\xi$ and $(W_s)_{s\le t}$ and augmented by the $P$-null sets.
--   5. **Admissible controls.** $\mathbb A$ is the set of $\mathbb F$-progressively measurable processes with values in $A$.
--
--   **Formalization Note** The canonical space $\Omega=\mathbb R^d\times\mathcal C$ with $P=\lambda_0\otimes$Wiener measure is generalized to any probability space carrying such $(\xi,W)$ (every object of the paper is a law, and the canonical space is an instance); the augmentation adds the measurable null sets, since Lean's $\sigma$-fields are not complete. $\mathbb R^d$ is `Fin d → ℝ`, time is `ℝ≥0` and paths are indexed by $[0,T]\subset\mathbb R$. $\mathcal P_\psi(\mathcal C)$ is a structure (not a subtype of Mathlib's probability measures), so its only topology is $\tau_\psi$. $\mathcal P(A)$ is a type synonym of Mathlib's `ProbabilityMeasure A`, so that its $\sigma$-field is the Borel one. The Brownian motion uses the published definition `Peng1990.SMP.IsStdBrownian`.
-- source:
--   Carmona, Lacker, A probabilistic weak formulation of mean field games and applications, arXiv:1307.1152v2 (2014), §3.1, pp. 8–9

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace WeakMFG.Existence

/-- The path space `C = C([0, T]; ℝ^d)` with the sup norm `‖x‖ = sup_{s ∈ [0,T]} |x(s)|`
(Carmona–Lacker, arXiv:1307.1152v2, §3.1, p. 8).
Formalization Note: states are `Fin d → ℝ` (sup norm on `ℝ^d`; every notion used is
norm-independent), time on paths is `Set.Icc (0 : ℝ) T`. -/
abbrev Path (d : ℕ) (T : ℝ≥0) : Type := C(Set.Icc (0 : ℝ) T, Fin d → ℝ)

/-- `C` carries its Borel σ-field. -/
instance instMeasurableSpacePath (d : ℕ) (T : ℝ≥0) : MeasurableSpace (Path d T) := borel _

instance instBorelSpacePath (d : ℕ) (T : ℝ≥0) : BorelSpace (Path d T) := ⟨rfl⟩

/-- The time `min t T` as a point of `[0, T]`. -/
def clampT (T : ℝ≥0) (t : ℝ≥0) : Set.Icc (0 : ℝ) T :=
  ⟨min (t : ℝ) T, le_min t.2 T.2, min_le_right _ _⟩

/-- The canonical filtration on `C`: `pathFilt t` is generated by the coordinates `x ↦ x(s)`,
`s ≤ min t T`. A map `(t, x) ↦ φ(t, x)` is *progressively measurable* in the paper's sense iff it
is `IsStronglyProgressive (pathFilt d T)`. -/
noncomputable def pathFilt (d : ℕ) (T : ℝ≥0) : Filtration ℝ≥0 (instMeasurableSpacePath d T) :=
  Filtration.natural (fun t (x : Path d T) => x (clampT T t))
    (fun t => (continuous_eval_const (clampT T t)).measurable.stronglyMeasurable)

/-- `P_ψ(C)`: probability measures `μ` on `C` with `∫ ψ dμ < ∞` (§3.1, p. 8).
Formalization Note: a structure (not a subtype of Mathlib's `ProbabilityMeasure`), so that the
only topology on it is `τ_ψ` below. -/
structure Ppsi {d : ℕ} {T : ℝ≥0} (ψ : Path d T → ℝ) where
  /-- the underlying measure -/
  toMeasure : Measure (Path d T)
  isProb : IsProbabilityMeasure toMeasure
  lintegral_psi_lt_top : ∫⁻ x, ENNReal.ofReal (ψ x) ∂toMeasure < ⊤

/-- `B_φ(C)`: measurable `f : C → ℝ` with `sup_x |f(x)| / φ(x) < ∞` (§3.1, p. 8). -/
def Bpsi {d : ℕ} {T : ℝ≥0} (φ : Path d T → ℝ) : Type :=
  {f : Path d T → ℝ // Measurable f ∧ ∃ c : ℝ, ∀ x, |f x| ≤ c * φ x}

/-- `τ_φ` on `P_ψ(C)`: the weakest topology making `μ ↦ ∫ f dμ` continuous for every
`f ∈ B_φ(C)` (§3.1, p. 8). `τ_ψ(C)` is `tauTop ψ ψ`; `τ₁(C)` restricted to `P_ψ(C)` is
`tauTop ψ 1`. -/
noncomputable def tauTop {d : ℕ} {T : ℝ≥0} (ψ : Path d T → ℝ) (φ : Path d T → ℝ) :
    TopologicalSpace (Ppsi ψ) :=
  TopologicalSpace.induced (fun (μ : Ppsi ψ) (f : Bpsi φ) => ∫ x, f.1 x ∂μ.toMeasure)
    Pi.topologicalSpace

/-- Unless stated otherwise, `P_ψ(C)` carries `τ_ψ(C)` (p. 8). -/
noncomputable instance instTopologicalSpacePpsi {d : ℕ} {T : ℝ≥0} (ψ : Path d T → ℝ) :
    TopologicalSpace (Ppsi ψ) :=
  tauTop ψ ψ

/-- Equivalence of measures, `μ ∼ μ'`: `μ ≪ μ'` and `μ' ≪ μ`. -/
def MEquiv {α : Type*} [MeasurableSpace α] (μ μ' : Measure α) : Prop :=
  μ ≪ μ' ∧ μ' ≪ μ

/-- `P(A)`, the probability measures on the control set `A` (with the subspace Borel σ-field),
with Mathlib's topology of weak convergence; its σ-field is the Borel σ-field of that topology
(p. 9: "P(A) is endowed with the weak topology and its corresponding Borel σ-field").
Formalization Note: a type synonym of `ProbabilityMeasure A`, so that its `MeasurableSpace`
instance is `borel` rather than Mathlib's Giry σ-field. -/
def PA {EA : Type*} [TopologicalSpace EA] [MeasurableSpace EA] (A : Set EA) : Type _ :=
  ProbabilityMeasure A

instance instTopologicalSpacePA {EA : Type*} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : TopologicalSpace (PA A) :=
  inferInstanceAs (TopologicalSpace (ProbabilityMeasure A))

instance instMeasurableSpacePA {EA : Type*} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : MeasurableSpace (PA A) :=
  borel _

instance instBorelSpacePA {EA : Type*} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) : BorelSpace (PA A) :=
  ⟨rfl⟩

/-- A point `q ∈ P(A)` as a measure on `A`. -/
def PA.meas {EA : Type*} [TopologicalSpace EA] [MeasurableSpace EA] {A : Set EA}
    (q : PA A) : Measure A :=
  ((show ProbabilityMeasure A from q) : Measure A)

/-- The σ-field generated by the measurable `P`-null sets. -/
abbrev nullSigma {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | MeasurableSet s ∧ P s = 0}

/-- The base space (§3.1, p. 8): a probability space carrying an initial state `ξ` and a standard
`d`-dimensional Brownian motion `W` independent of `ξ`; `λ₀ = P ∘ ξ⁻¹`.
Formalization Note (D1): an arbitrary such space replaces the canonical `Ω = ℝ^d × C` with
`P = λ₀ ⊗` Wiener measure; the canonical space is an instance. -/
structure Base (d : ℕ) (T : ℝ≥0) (Ω : Type*) [MeasurableSpace Ω] where
  /-- the probability measure -/
  P : Measure Ω
  isProb : IsProbabilityMeasure P
  /-- the initial state -/
  ξ : Ω → Fin d → ℝ
  meas_ξ : Measurable ξ
  /-- the Brownian motion -/
  W : ℝ≥0 → Ω → Fin d → ℝ
  hW : Peng1990.SMP.IsStdBrownian P W
  indep : IndepFun ξ (fun ω t => W t ω) P

/-- The filtration `F_t`: the σ-field of `(ξ, W_s)_{s ≤ t}`, augmented by the measurable
`P`-null sets ("the completion of σ((ξ, W_s) : 0 ≤ s ≤ t) by P-null sets", p. 8).
Formalization Note (D1): Mathlib measurable spaces are not complete, so the augmentation adds the
measurable null sets. -/
noncomputable def Base.filt {d : ℕ} {T : ℝ≥0} {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (B : Base d T Ω) : Filtration ℝ≥0 mΩ where
  seq t := MeasurableSpace.comap B.ξ inferInstance ⊔
    Peng1990.SMP.brownianFiltration B.hW t ⊔ nullSigma B.P
  mono' _ _ hst :=
    sup_le_sup_right (sup_le_sup_left ((Peng1990.SMP.brownianFiltration B.hW).mono hst) _) _
  le' t :=
    sup_le (sup_le B.meas_ξ.comap_le ((Peng1990.SMP.brownianFiltration B.hW).le t))
      (MeasurableSpace.generateFrom_le fun _ hs => hs.1)

/-- The admissible controls `𝔸` (S.1): progressively measurable (for `F`) `A`-valued
processes. -/
def IsAdmissible {d : ℕ} {T : ℝ≥0} {Ω : Type*} [MeasurableSpace Ω]
    {EA : Type*} [NormedAddCommGroup EA] (B : Base d T Ω) (A : Set EA)
    (α : ℝ≥0 → Ω → EA) : Prop :=
  IsStronglyProgressive B.filt α ∧ ∀ t ω, α t ω ∈ A

end WeakMFG.Existence


