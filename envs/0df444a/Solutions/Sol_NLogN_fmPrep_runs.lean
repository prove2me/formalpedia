  zsz_mono (by simpa using h)

theorem mvN_runs {X Y C : Fin NS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX3 : X ≠ T3)
    (hY3 : Y ≠ T3) (hC3 : C ≠ T3) (s : IState NS) (A : List ℤ) (R LC : List Item) (m : ℕ)
    (hX : s.G X = ints A ++ R) (hC : s.G C = .int A.length :: LC) (hA : Bnd m A) :
    IRuns I iprog (mvN X Y C) s
      (((s.upd X R).upd Y ((ints A).reverse ++ s.G Y)).upd C (.int 0 :: LC))
      (A.length * (1000 * (m + zsz (A.length : ℤ) + 3)) + 30) := by
  set k := A.length with hkdef
  let ss : ℕ → IState NS := fun j =>
    ((s.upd X (ints (A.drop j) ++ R)).upd Y ((ints (A.take j)).reverse ++ s.G Y)).upd C
      (.int ((k - j : ℕ) : ℤ) :: LC)
  have h0 : ss 0 = s := by
    apply IState.ext' <;> intros <;> simp [ss, hX, hC, hkdef] <;> split_ifs <;> simp_all
  have hk : ss k = (((s.upd X R).upd Y ((ints A).reverse ++ s.G Y)).upd C (.int 0 :: LC)) := by
    simp [ss, k]
  have := IRuns.loop' (I := I) (iprog := iprog) (i := C) (f := fun c => c != .zero)
    (p := .seq (.op (.mv X Y)) (decC C)) ss (1000 * (m + zsz (k : ℤ) + 3) - 30) k
    (by intro j hj; simp [ss]; omega)
    (by simp [ss])
    (by
      intro j hj
      apply IRuns.of_runsTo 0
      have hd : A.drop j = A[j] :: A.drop (j + 1) := List.drop_eq_getElem_cons hj
      have ht : A.take (j + 1) = A.take j ++ [A[j]] := by simp [List.take_add_one, hj]
      have hm : zsz A[j] ≤ m := hA _ (List.getElem_mem hj)
      have hc : zsz ((k - j : ℕ) : ℤ) ≤ zsz (k : ℤ) := zsz_natCast_le (by omega)
      simp only [ss]
      rw [hd, ht, ints_cons, List.cons_append]
      simp +decide [mvN, decC, IStmt.run, IOp.run, hXY, hXC, hYC, hX3, hY3, hC3,
        Ne.symm hXY, Ne.symm hXC, Ne.symm hYC, Ne.symm hX3, Ne.symm hY3, Ne.symm hC3, zsz_neg_one]
      constructor
      · have e1 : ((A.length - j : ℕ) : ℤ) + -1 = ((A.length - (j + 1) : ℕ) : ℤ) := by omega
        have e2 : ints (List.take (j + 1) A) = ints (List.take j A) ++ [.int A[j]] := by
          rw [ht, ints_append]; rfl
        apply IState.ext' <;> intros <;> simp [ints_append] <;> split_ifs <;> simp_all
      · simp only [moveCost, addIntCost, addMagCost, subMagCost, zipCost] at *
        have : zsz ((k - j : ℕ) : ℤ) ≤ zsz (k : ℤ) := hc
        omega)
  rw [h0, hk] at this
  refine this.mono ?_
  have : 30 ≤ 1000 * (m + zsz (k : ℤ) + 3) := by omega
  rw [Nat.sub_add_cancel this]

/-- A loop that consumes the list `L0` one entry at a time: `St D R` is the state with `D` done
and `R` remaining. -/
theorem IRuns.loopList {S : ℕ} {α : Type} {i : Fin S} {f : Cls → Bool} {p : IStmt S P}
    {iprog : Fin P → IStmt S P} (L0 : List α) (St : List α → List α → IState S) (c : ℕ)
    (hT : ∀ D x R, D ++ x :: R = L0 → f ((St D (x :: R)).cl i) = true)
    (hF : f ((St L0 []).cl i) = false)
    (hb : ∀ D x R, D ++ x :: R = L0 → IRuns I iprog p (St D (x :: R)) (St (D ++ [x]) R) c) :
    IRuns I iprog (.loop i f p) (St [] L0) (St L0 []) (L0.length * (c + 30) + 30) := by
  suffices H : ∀ R D, D ++ R = L0 →
      IRuns I iprog (.loop i f p) (St D R) (St L0 []) (R.length * (c + 30) + 30) by
    simpa using H L0 [] rfl
  intro R
  induction R with
  | nil => intro D hD; simp at hD; subst hD; simpa using IRuns.loopF hF
  | cons x R ih =>
    intro D hD
    have := IRuns.loopT (hT D x R hD) (hb D x R hD) (ih (D ++ [x]) (by simpa using hD))
    refine this.mono ?_
    simp only [List.length_cons]; ring_nf; omega

theorem IRuns.seq_assoc {S : ℕ} {p q r : IStmt S P} {iprog : Fin P → IStmt S P} {s t : IState S}
    {c : ℕ} (h : IRuns I iprog (.seq (.seq p q) r) s t c) : IRuns I iprog (.seq p (.seq q r)) s t c := by
  obtain ⟨c', hc, h⟩ := h
  cases h with
  | seq h1 h3 =>
    cases h1 with
    | seq h1 h2 => exact ⟨_, by omega, .seq h1 (.seq h2 h3)⟩

end NLogN

