theorem emod2_cases (v : ℤ) : v % 2 = 0 ∨ v % 2 = 1 := by omega

theorem zsz_01 {v : ℤ} {Bb : ℕ} (hB : 1 ≤ Bb) (h : v = 0 ∨ v = 1) : zsz v ≤ Bb := by
  rcases h with rfl | rfl
  · rw [zsz_zero]; omega
  · rw [zsz_one]; omega

theorem segT_offE (b : ℤ) {Bb : ℕ} (hB : 2 ≤ Bb) : SegT (offE b) (tfB b) Bb where
  regs := by
    intro i hi
    unfold offE at hi
    split_ifs at hi <;> simp [Ex.regs] at hi <;> tauto
  ev := by
    intro t a c ha hc
    unfold offE tfB
    split_ifs with h <;> simp only [Ex.eval, ha, hc, if_pos, if_neg, h, not_false_eq_true] <;> ring
  ok := by
    intro t a c ha hc hia hic ha0 hc0 hab hcb
    have z2 : zsz (2 : ℤ) ≤ Bb := by
      apply zsz_le_of_lt
      have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB
      simp only [Int.reduceAbs]; norm_num at this ⊢; omega
    have z1 : zsz (1 : ℤ) ≤ Bb := by rw [zsz_one]; omega
    have ea : (Ex.reg NLogN.KFL.rU : Ex HS).eval t = a := by simp [Ex.eval, ha]
    have ec : (Ex.reg NLogN.KFL.rV : Ex HS).eval t = c := by simp [Ex.eval, hc]
    have ma := emod2_cases a
    have mc := emod2_cases c
    unfold offE
    split_ifs with h
    · refine ⟨⟨⟨hia, trivial, by rw [ea]; exact ha0, by simp [Ex.eval]⟩,
        ⟨hic, trivial, by rw [ec]; exact hc0, by simp [Ex.eval]⟩⟩, ?_⟩
      simp only [Ex.Bnd, Ex.eval, ha, hc]
      refine ⟨⟨hab, z2, zsz_01 (by omega) ma⟩, ⟨hcb, z2, zsz_01 (by omega) mc⟩, ?_⟩
      apply zsz_01 (by omega)
      rcases ma with h1 | h1 <;> rcases mc with h2 | h2 <;> simp [h1, h2]
    · refine ⟨⟨⟨hia, trivial, by rw [ea]; exact ha0, by simp [Ex.eval]⟩,
        ⟨trivial, ⟨hic, trivial, by rw [ec]; exact hc0, by simp [Ex.eval]⟩⟩⟩, ?_⟩
      simp only [Ex.Bnd, Ex.eval, ha, hc]
      refine ⟨⟨hab, z2, zsz_01 (by omega) ma⟩, ⟨z1, ⟨hcb, z2, zsz_01 (by omega) mc⟩,
        ?_⟩, ?_⟩
      · apply zsz_01 (by omega); rcases mc with h2 | h2 <;> simp [h2]
      · apply zsz_01 (by omega)
        rcases ma with h1 | h1 <;> rcases mc with h2 | h2 <;> simp [h1, h2]
  abs := by
    intro a c
    unfold tfB
    have ma := emod2_cases a
    have mc := emod2_cases c
    split_ifs <;> rcases ma with h1 | h1 <;> rcases mc with h2 | h2 <;> simp [h1, h2]

theorem tfB_eq (b : ℤ) (hb : b = 0 ∨ b = 1) (u v : ℤ) :
    tfB b u v = if u % 2 = 1 ∧ v % 2 = b then 1 else 0 := by
  unfold tfB
  have ma := emod2_cases u
  have mc := emod2_cases v
  rcases hb with rfl | rfl <;> rcases ma with h1 | h1 <;> rcases mc with h2 | h2 <;> simp [h1, h2]

/-- **`offset` as a segment accumulation.** -/
theorem offset_seg (K ρ f : ℕ) (x t : ℕ) (b : ℤ) (hb : b = 0 ∨ b = 1) :
    Butterfly.offset K ρ f (x : ℤ) (t : ℤ) b =
      segAcc K (tfB b) ((x : ℤ) / 2 ^ ρ) ((t : ℤ) / 2 ^ ρ) (2 ^ ρ) (f - 1) := by
  unfold Butterfly.offset segAcc
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have e1 : (x : ℤ) / 2 ^ ρ / 2 ^ (i * K) = x / 2 ^ (ρ + i * K) := by
    rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_add]
  have e2 : (t : ℤ) / 2 ^ ρ / 2 ^ (i * K) = t / 2 ^ (ρ + i * K) := by
    rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_add]
  rw [tfB_eq b hb, e1, e2, ← pow_add]
  rfl

theorem segF_rA (F : Fin HS → List ℤ) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ) (k : ℕ) :
    segF F K tf a u v w k rA = (a + segAcc K tf u v w k) :: (F rA).tail := by
  simp only [segF]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
    Function.update_self]

theorem segF_rU (F : Fin HS → List ℤ) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ) (k : ℕ) :
    segF F K tf a u v w k NLogN.KFL.rU = (u / 2 ^ (k * K)) :: (F NLogN.KFL.rU).tail := by
  simp only [segF]; rw [upd_ne (by decide), upd_ne (by decide), Function.update_self]

theorem segF_rV (F : Fin HS → List ℤ) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ) (k : ℕ) :
    segF F K tf a u v w k NLogN.KFL.rV = (v / 2 ^ (k * K)) :: (F NLogN.KFL.rV).tail := by
  simp only [segF]; rw [upd_ne (by decide), Function.update_self]

theorem segF_rW (F : Fin HS → List ℤ) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ) (k : ℕ) :
    segF F K tf a u v w k NLogN.KFL.rW = (w * 2 ^ (k * K)) :: (F NLogN.KFL.rW).tail := by
  simp only [segF]; rw [Function.update_self]

theorem segF_ne (F : Fin HS → List ℤ) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ) (k : ℕ) {j : Fin HS}
    (h1 : j ≠ rA) (h2 : j ≠ NLogN.KFL.rU) (h3 : j ≠ NLogN.KFL.rV) (h4 : j ≠ NLogN.KFL.rW) :
    segF F K tf a u v w k j = F j := by
  simp only [segF]; rw [upd_ne h4, upd_ne h3, upd_ne h2, upd_ne h1]
end NLogN.KFL
end

