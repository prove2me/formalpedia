theorem nA4 : (4 : ℤ).natAbs = 4 := rfl
theorem nA6 : (6 : ℤ).natAbs = 6 := rfl
theorem nA8 : (8 : ℤ).natAbs = 8 := rfl
theorem nA18 : (18 : ℤ).natAbs = 18 := rfl
