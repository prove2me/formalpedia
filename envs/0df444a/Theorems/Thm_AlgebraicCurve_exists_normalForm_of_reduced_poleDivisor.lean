-- title:
--   Normal form for L(kD) along a reduced pole divisor of degree 2g+1
-- statement:
--   Let $K$ be an algebraically closed field and $F$ a field with a $K$-algebra structure, and write $g = \mathrm{genusFF}\,K\,F$ for the $K$-dimension of $H^1$ of the zero divisor. Let $x \in F$ and let $P : \mathrm{Fin}(2g+1) \to \mathrm{Place}\,K\,F$ be an injective family of places of $F/K$ (valuation subrings of $F$ containing the image of $K$, proper, with principal ideal structure). Assume $x$ is transcendental over $K$, that $F$ is finite-dimensional over the intermediate field $K(x)$ generated by $x$, with $[F : K(x)] = 2g+1$, that $\mathrm{ord}_{P_j}(x) = -1$ for every $j$, where $\mathrm{ord}_v(f) = -\log$ of the adic valuation of $f$ at $v$, and that $\mathrm{ord}_v(x) \ge 0$ for every place $v$ outside the range of $P$. Then there exist a divisor $D$ (a finitely supported integer-valued function on places), elements $e_i \in F$, natural numbers $d_i$, polynomials $q_{ijk} \in K[X]$ and scalars $\tau_{ji} \in K$, all indexed by $\mathrm{Fin}(2g+1)$, such that: $D(v) = \max(0, -\mathrm{ord}_v(x))$ for all $v$; $e_0 = 1$, $d_0 = 0$, $d_i \in \{1,2\}$ for $i \ne 0$, and $\sum_i d_i = 3g$; for every $k \in \mathbb{N}$ and $f \in F$, $f$ lies in the Riemann–Roch space of $k \cdot D$ (the $f$ with adic valuation at most $\exp(kD(v))$ at every $v$) if and only if $f = \sum_i c_i(x) e_i$ for polynomials $c_i$ of degree $< k+1-d_i$ (truncated subtraction); the $e_i$ are linearly independent over the polynomials in $x$, in the sense that $\sum_i c_i(x) e_i = 0$ forces $c = 0$; every $z \in F$ satisfies $r(x)z \in L(kD)$ for some nonzero $r \in K[X]$ and some $k$; $e_i e_j = \sum_k q_{ijk}(x) e_k$ for all $i,j$, with $\deg q_{ijk} \le d_i + d_j - d_k$ (truncated) whenever $i,j \ne 0$; and the matrix $\tau$ has unit determinant, satisfies $\tau_{j0} = 1$ for all $j$, and $\tau_{ji}\tau_{ji'} = \sum_k \big(\text{coefficient of } X^{d_i+d_{i'}-d_k} \text{ in } q_{ii'k}\big)\,\tau_{jk}$ for $i,i' \ne 0$.
--
--   This packages the Riemann–Roch theory of a function field $F/K$ with algebraically closed constant field into explicit structure constants: a free basis $e_i$ with weights $d_i$ adapted to the filtration by the spaces $L(kD)$, multiplication constants $q_{ijk}$, and a matrix $\tau$ recording the leading behaviour of the $e_i$ at the $2g+1$ poles of $x$. It is used by [`AlgebraicCurve.exists_riemannRochSpace_nsmul_poleDivisor_normalForm`](thm.html#AlgebraicCurve.exists_riemannRochSpace_nsmul_poleDivisor_normalForm), and relies on the non-special range of Riemann–Roch via [`AlgebraicCurve.ell_eq_degree_add_one_sub_genusFF_of_isAlgClosed_of_isSeparable`](thm.html#AlgebraicCurve.ell_eq_degree_add_one_sub_genusFF_of_isAlgClosed_of_isSeparable) together with the existence of a separating transcendental element over a perfect field.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_exists_normalForm_of_reduced_poleDivisor.lean

import Mathlib
import Definitions.Def_AlgebraicCurve_DivisorClassGroup
import Definitions.Def_AlgebraicCurve_Repartitions

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Polynomial
open AlgebraicCurve

universe u v

theorem AlgebraicCurve.exists_normalForm_of_reduced_poleDivisor
    (K : Type u) (F : Type v) [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    (x : F) (P : Fin (2 * genusFF K F + 1) → Place K F)
    (hP : Function.Injective P) (hx : Transcendental K x)
    (hfd : FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    (hdegF : Module.finrank (IntermediateField.adjoin K ({x} : Set F)) F = 2 * genusFF K F + 1)
    (hpole : ∀ j, (P j).ord x = -1)
    (hfin : ∀ v : Place K F, v ∉ Set.range P → 0 ≤ v.ord x) :
    ∃ (D : Divisor K F) (e : Fin (2 * genusFF K F + 1) → F)
      (d : Fin (2 * genusFF K F + 1) → ℕ)
      (q : Fin (2 * genusFF K F + 1) → Fin (2 * genusFF K F + 1) → Fin (2 * genusFF K F + 1) → K[X])
      (τ : Fin (2 * genusFF K F + 1) → Fin (2 * genusFF K F + 1) → K),
      (∀ v : Place K F, D v = max 0 (-v.ord x)) ∧
      e 0 = 1 ∧ d 0 = 0 ∧ (∀ i, i ≠ 0 → d i = 1 ∨ d i = 2) ∧ (∑ i, d i = 3 * genusFF K F) ∧
      (∀ (k : ℕ) (f : F), f ∈ riemannRochSpace (k • D) ↔
        ∃ c : Fin (2 * genusFF K F + 1) → K[X],
          (∀ i, c i ∈ Polynomial.degreeLT K (k + 1 - d i)) ∧
          f = ∑ i, Polynomial.aeval x (c i) * e i) ∧
      (∀ c : Fin (2 * genusFF K F + 1) → K[X], ∑ i, Polynomial.aeval x (c i) * e i = 0 → c = 0) ∧
      (∀ z : F, ∃ r : K[X], r ≠ 0 ∧ ∃ k : ℕ, Polynomial.aeval x r * z ∈ riemannRochSpace (k • D)) ∧
      (∀ i j, e i * e j = ∑ k, Polynomial.aeval x (q i j k) * e k) ∧
      (∀ i j k, i ≠ 0 → j ≠ 0 → (q i j k).natDegree ≤ d i + d j - d k) ∧
      IsUnit (Matrix.det (Matrix.of τ)) ∧
      (∀ j, τ j 0 = 1) ∧
      (∀ j i i', i ≠ 0 → i' ≠ 0 →
        τ j i * τ j i' = ∑ k, (q i i' k).coeff (d i + d i' - d k) * τ j k) := by sorry
