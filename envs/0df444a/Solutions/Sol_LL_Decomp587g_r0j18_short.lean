      div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right sl hs) (le_of_lt hD)
    have hlo_r : 2 * aR ≤ (sl : ℝ) / D_den := by
      rw [aR_eq]; have : 2 * ((A_num : ℝ) / D_den) = ((2 * A_num : ℕ) : ℝ) / D_den := by push_cast; ring
