-- title:
--   Homotopy of walks, the $r$-local subgroup, coverings, lifts and projections, the displacement $\Delta_r(G)$ and $K(G,r)$
-- statement:
--   Let $G$ be a graph and $r\in\mathbb N$.
--
--   1. Two walks with the same ends are **homotopic** if one is obtained from the other by inserting and deleting backtracks $u\,e\,v\,e\,u$ (equivalently, they have the same reduction). A closed walk at $x_0$ **stems from** a cycle $O$ if it has the form $W_0QW_0^{-}$ with $Q$ once around $O$. The **$r$-local subgroup** $\pi_1^r(G,x_0)$ of the combinatorial fundamental group is generated by the closed walks at $x_0$ that stem from cycles of length $\le r$; a closed walk lies in it if it is homotopic to a finite concatenation of such walks.
--   2. A **covering** $p:C\to G$ is a homomorphism from a connected graph $C$ onto $G$ that maps the edges at every vertex $v$ of $C$ bijectively to the edges at $p(v)$. It is an **$r$-local covering** if it induces an isomorphism from $\pi_1(C,\hat x_0)$ onto $\pi_1^r(G,p(\hat x_0))$: a closed walk at $p(\hat x_0)$ lifts to a closed walk at $\hat x_0$ if and only if it lies in $\pi_1^r$. A **deck transformation** is an automorphism $\varphi$ of $C$ with $p\circ\varphi=p$.
--   3. A **lift** of a vertex set $X$ is a set $\hat X$ mapped bijectively onto $X$ by $p$; $\hat X$ is **$r$-locally closed** if no $r$-local $p^{-1}(p(\hat X))$-path joins a vertex of $\hat X$ to a vertex of $p^{-1}(p(\hat X))\setminus\hat X$. For an $r$-local separation $(E_1,X,E_2)$ of $G$ and an $r$-locally closed lift $\hat X$ of $X$, the **$\hat X$-lift** is $(p^{-1}(E_1)\cap\partial\hat X,\ \hat X,\ p^{-1}(E_2)\cap\partial\hat X)$; a lift of an $r$-local separation is an $\hat X$-lift for some such $\hat X$. Projections are images under $p$.
--   4. The **displacement** is
--   $$\Delta_r(G)=\min\{\operatorname{dist}_{G_r}(\hat u,\hat v):\hat u\neq\hat v,\ p_r(\hat u)=p_r(\hat v)\},\qquad \min\emptyset=\infty,$$
--   and $K(G,r)=\Delta_r(G)/r+1$ for $r>0$, $K(G,0)=2$. The starred results assume $(k-1)r<\Delta_r(G)$ (integer arithmetic).
--
--   The $r$-local covering unfolds every cycle longer than $r$ while keeping the short ones; the displacement measures how far it is from being injective, and $k<K(G,r)$ is the paper's guarantee under which $r$-local separations of order $\le k$ lift to and project from $G_r$.
--
--   **Formalization Note** The $r$-local covering is not constructed: statements quantify over every covering with the defining property (all are isomorphic). $K(G,r)$ takes values in $[0,\infty]$, and $\Delta_r=\infty$ gives $K=\infty$.
-- source:
--   Jacobs, Knappe, Kurkofka, Canonical Graph Decompositions via Local Separations, preprint (STOC 2027 submission, arXiv:2501.16170; sha256 9a11d48d…), §2.1 (p.13), §4.2 (pp.28–31, Lift 4.19), §5.1 (p.31), pp.5 and 56

import Mathlib
import Definitions.Def_LocalSepDecomp_Basics

set_option autoImplicit false

namespace LocalSepDecomp

/-! # Coverings, the r-local covering, lifts and projections, displacement and `K(G, r)`

R. W. Jacobs, P. Knappe, J. Kurkofka, *Canonical Graph Decompositions via Local Separations*,
preprint (STOC 2027 submission, arXiv:2501.16170; sha256 9a11d48d…), §2.1 (p.13), §4.2
(pp.28–31), §5.1 (p.31), pp.5 and 56.

**Formalization Note.**
1. Homotopy of walks is the equivalence relation generated by deleting a backtrack `u e v e u`;
   this is "equal reductions" of p.13 (reductions are unique).
2. The `r`-local covering `p_r : G_r → G` is determined only up to isomorphism of coverings
   (p.13). It is not constructed: `IsLocalCovering G r p` says that `p` is a covering whose
   characteristic subgroup is the `r`-local subgroup, i.e. a closed walk at `p x̂₀` lifts to a
   closed walk at `x̂₀` iff it lies in `π^r_1(G, p x̂₀)`. For a covering, `p_*` is injective on
   homotopy classes, so this says exactly that `p` induces an isomorphism `π₁(C, x̂₀) → π^r_1`.
   Statements about `G_r` are quantified over every such `p`. -/

open SimpleGraph

variable {V W : Type*}

/-- One elementary reduction (p.13): `W'` arises from `W` by replacing a subwalk `u e v e u`
with the trivial walk `u`. -/
def ElemReduction (G : SimpleGraph V) {x y : V} (W W' : G.Walk x y) : Prop :=
  ∃ (a b : V) (P : G.Walk x a) (h : G.Adj a b) (S : G.Walk a y),
    W = P.append (Walk.cons h (Walk.cons h.symm S)) ∧ W' = P.append S

/-- Two walks with the same ends are **homotopic** (p.13). -/
def Homotopic (G : SimpleGraph V) {x y : V} (W W' : G.Walk x y) : Prop :=
  Relation.EqvGen (ElemReduction G) W W'

/-- Finite products of generators of the `r`-local subgroup (p.13): concatenations of closed
walks `W₀ Q W₀⁻` at `x₀` that stem from a closed walk `Q` once around a short cycle (a cycle of
length `≤ r`). A walk once around a cycle traversed backwards is again once around it, so this
set of products is closed under inverses. -/
inductive LocalProduct (G : SimpleGraph V) (r : ℕ) (x₀ : V) : G.Walk x₀ x₀ → Prop
  | nil : LocalProduct G r x₀ Walk.nil
  | cons {u : V} (W₀ : G.Walk x₀ u) (Q : G.Walk u u) (hQ : IsShortCycle G r Q)
      (W : G.Walk x₀ x₀) (hW : LocalProduct G r x₀ W) :
      LocalProduct G r x₀ ((W₀.append (Q.append W₀.reverse)).append W)

/-- The closed walk `W` at `x₀` lies in (its homotopy class belongs to) the **`r`-local subgroup**
`π^r_1(G, x₀)` (p.13), the subgroup of `π₁(G, x₀)` generated by the closed walks at `x₀` that
stem from short cycles. -/
def InLocalSubgroup (G : SimpleGraph V) (r : ℕ) {x₀ : V} (W : G.Walk x₀ x₀) : Prop :=
  ∃ W' : G.Walk x₀ x₀, LocalProduct G r x₀ W' ∧ Homotopic G W W'

/-- `p : C → G` is a **covering** of `G` (p.13): `C` is connected, `p` is an epimorphism
(surjective on vertices) and for every vertex `v` of `C`, `p` maps the edges at `v` bijectively
to the edges at `p v`. -/
def IsCovering {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) : Prop :=
  C.Connected ∧ Function.Surjective p ∧
    ∀ v : W, Set.BijOn (Sym2.map p) (C.incidenceSet v) (G.incidenceSet (p v))

/-- `p : C → G` is an **`r`-local covering** of `G` (p.13): a covering that induces an
isomorphism from `π₁(C, x̂₀)` onto the `r`-local subgroup `π^r_1(G, p x̂₀)`: for some base vertex
`x̂₀`, a closed walk at `p x̂₀` is the projection of a closed walk at `x̂₀` iff it lies in
`π^r_1(G, p x̂₀)`. -/
def IsLocalCovering (G : SimpleGraph V) (r : ℕ) {C : SimpleGraph W} (p : C →g G) : Prop :=
  IsCovering p ∧ ∃ x₀ : W, ∀ Wk : G.Walk (p x₀) (p x₀),
    (∃ Wh : C.Walk x₀ x₀, Wh.map p = Wk) ↔ InLocalSubgroup G r Wk

/-- `φ` is a **deck transformation** of `p` (p.13): an automorphism of `C` commuting with `p`. -/
def IsDeck {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (φ : C ≃g C) : Prop :=
  ∀ v, p (φ v) = p v

/-- The **displacement** `Δ_r(G)` of the covering `p` (p.31): the minimum distance in `C`
between two distinct lifts of the same vertex of `G`, with `min ∅ = ∞`. -/
noncomputable def displacement {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) : ℕ∞ :=
  ⨅ (u : W) (v : W) (_ : u ≠ v ∧ p u = p v), C.edist u v

/-- The parameter `K(G, r)` (p.5, p.56), computed from the `r`-local covering `p`:
`K(G, r) = Δ_r(G)/r + 1` if `r > 0`, and `K(G, 0) = 2`, as an element of `ℝ≥0∞`
(`Δ_r(G) = ∞` gives `K = ∞`). -/
noncomputable def Kval {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r : ℕ) :
    ENNReal :=
  if r = 0 then 2 else ((displacement p : ℕ∞) : ENNReal) / (r : ENNReal) + 1

/-- The displacement hypothesis `(k − 1) r < Δ_r(G)` of the starred results (p.47 ff.), with
integer subtraction: whenever `Δ_r(G)` is finite, `(k − 1)·r < Δ_r(G)` in `ℤ` (and the
hypothesis is void when `Δ_r(G) = ∞`). -/
def DisplacementBound {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r k : ℕ) : Prop :=
  ∀ n : ℕ, displacement p = n → ((k : ℤ) - 1) * r < n

/-- `X̂` is a **lift** of the vertex set `X` (p.13): `p` restricts to a bijection `X̂ → X`. -/
def IsVertexSetLift {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (Xh : Set W)
    (X : Set V) : Prop :=
  Set.BijOn p Xh X

/-- `X̂` is **`r`-locally closed** with respect to `p` (p.28): with `X := p(X̂)`, no `r`-local
`p⁻¹(X)`-path links a vertex in `X̂` to a vertex in `p⁻¹(X) ∖ X̂`. -/
def IsRLocallyClosed {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r : ℕ)
    (Xh : Set W) : Prop :=
  ∀ (u v : W) (P : C.Walk u v), IsRLocalXPath C r (p ⁻¹' (p '' Xh)) P → u ∈ Xh → v ∈ Xh

/-- The `X̂`-lift `(Ê₁, X̂, Ê₂)` of an oriented `r`-local separation `(E₁, X, E₂)` (Lift 4.19,
p.30): `Êᵢ := p⁻¹(Eᵢ) ∩ ∂X̂`. -/
def lsepLiftAt {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (s : LSep V)
    (Xh : Set W) : LSep W :=
  ⟨{e | Sym2.map p e ∈ s.E₁} ∩ boundary C Xh, Xh, {e | Sym2.map p e ∈ s.E₂} ∩ boundary C Xh⟩

/-- `ŝ` is a **lift** of the oriented `r`-local separation `s` (p.31): `ŝ` is the `X̂`-lift of
`s` for some `r`-locally closed lift `X̂` of the separator of `s`. -/
def IsLSepLift {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r : ℕ) (sh : LSep W)
    (s : LSep V) : Prop :=
  ∃ Xh : Set W, IsVertexSetLift p Xh s.X ∧ IsRLocallyClosed p r Xh ∧ sh = lsepLiftAt p s Xh

/-- `û` is a lift of the unoriented `r`-local separation `u`: some orientation of `û` is a lift
of some orientation of `u` (the other orientation then lifts to the inverse). -/
def IsULSepLift {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r : ℕ) (uh : ULSep W)
    (u : ULSep V) : Prop :=
  ∃ (sh : LSep W) (s : LSep V), sh.unorient = uh ∧ s.unorient = u ∧ IsLSepLift p r sh s

/-- The set `N̂` of all lifts to `C` of the elements of a set `N` of unoriented `r`-local
separations of `G` (Projection 8.13, p.52; Theorem 8.21, p.55). -/
def liftSet {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (r : ℕ) (N : Set (ULSep V)) :
    Set (ULSep W) :=
  {uh | ∃ u ∈ N, IsULSepLift p r uh u}

/-- The projection `p(ŝ) = (p(Ê₁), p(X̂), p(Ê₂))` of an oriented triple (p.30). -/
def lsepProj {G : SimpleGraph V} {C : SimpleGraph W} (p : C →g G) (sh : LSep W) : LSep V :=
  ⟨Sym2.map p '' sh.E₁, p '' sh.X, Sym2.map p '' sh.E₂⟩

/-- The image `φ(s) = (φ(E₁), φ(X), φ(E₂))` of an oriented triple under a vertex map (the action
of automorphisms, p.46). -/
def LSep.map {V' : Type*} (f : V → V') (s : LSep V) : LSep V' :=
  ⟨Sym2.map f '' s.E₁, f '' s.X, Sym2.map f '' s.E₂⟩

/-- The image `φ{E₁, X, E₂} = {φ(E₁), φ(X), φ(E₂)}` of an unoriented triple (p.46). -/
def ULSep.map {V' : Type*} (f : V → V') (u : ULSep V) : ULSep V' :=
  ⟨Sym2.map (fun E => Sym2.map f '' E) u.sides, f '' u.X⟩

end LocalSepDecomp


