theorem solution (R : Type) [CommRing R] [IsLocalRing R] (t x : R)
    (hmax : maximalIdeal R = Ideal.span {t, x}) (d : ℕ) (c : Fin (d + 1) → R) :
    Module.length (TypeDensity.BlowupChart R x t) (TypeDensity.BlowupChart R x t ⧸ (Ideal.span
