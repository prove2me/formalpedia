namespace P2mKcSerreAVBase

variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
variable {k : Type u} [CommRing k] (ι : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of R))

theorem nsmul_val_congr (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)}
    (y : SchemeHomOver t₁ f) (h₂ : y.1 ≫ f = t₂) (n : ℕ) :
    (L.nsmul t₂ n ⟨y.1, h₂⟩).1 = (L.nsmul t₁ n y).1 := by
  have h : t₁ = t₂ := y.2.symm.trans h₂
  subst h; rfl

theorem one_val_congr (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)}
    (h : t₁ = t₂) : (L.one t₂).1 = (L.one t₁).1 := by
  subst h; rfl

theorem baseChangePointToBase_nsmul (L : RelativeGroupLaw R f) {T : Scheme.{u}}
    (t' : T ⟶ Spec (CommRingCat.of k)) (n : ℕ) (x : SchemeHomOver t' (RelativeGroupLaw.baseChangeStr ι f)) :
    RelativeGroupLaw.baseChangePointToBase ι ((L.baseChange ι).nsmul t' n x) =
      L.nsmul _ n (RelativeGroupLaw.baseChangePointToBase ι x) := by
  induction n with
  | zero => exact RelativeGroupLaw.baseChangePointToBase_one ι L t'
  | succ n ih =>
      rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.baseChangePointToBase_mul, ih, RelativeGroupLaw.nsmul_succ]

theorem fibreRestrictAlong_schemeHomOverId :
    fibreRestrictAlong ι f f (NeronModelInfra.schemeHomOverId f) = NeronModelInfra.schemeHomOverId (pullback.snd f ι) := by
  apply Subtype.ext
  apply pullback.hom_ext
  · rw [fibreRestrictAlong_coe_comp_fst, NeronModelInfra.schemeHomOverId_coe, NeronModelInfra.schemeHomOverId_coe,
      Category.comp_id, Category.id_comp]
  · rw [fibreRestrictAlong_coe_comp_snd, NeronModelInfra.schemeHomOverId_coe, Category.id_comp]

theorem fibreRestrictAlong_schemeHomOverComp (σ τ : SchemeHomOver f f) :
    fibreRestrictAlong ι f f (NeronModelInfra.schemeHomOverComp σ τ) =
      NeronModelInfra.schemeHomOverComp (fibreRestrictAlong ι f f σ) (fibreRestrictAlong ι f f τ) := by
  apply Subtype.ext
  apply pullback.hom_ext
  · rw [fibreRestrictAlong_coe_comp_fst, NeronModelInfra.schemeHomOverComp_coe, NeronModelInfra.schemeHomOverComp_coe,
      Category.assoc, fibreRestrictAlong_coe_comp_fst, fibreRestrictAlong_coe_comp_fst_assoc]
  · rw [fibreRestrictAlong_coe_comp_snd, NeronModelInfra.schemeHomOverComp_coe, Category.assoc,
      fibreRestrictAlong_coe_comp_snd, fibreRestrictAlong_coe_comp_snd]

theorem fibreRestrictAlong_schemeHomOverNpow (σ : SchemeHomOver f f) (i : ℕ) :
    fibreRestrictAlong ι f f (NeronModelInfra.schemeHomOverNpow σ i) =
      NeronModelInfra.schemeHomOverNpow (fibreRestrictAlong ι f f σ) i := by
  induction i with
  | zero => exact fibreRestrictAlong_schemeHomOverId ι
  | succ i ih =>
      rw [NeronModelInfra.schemeHomOverNpow_succ, NeronModelInfra.schemeHomOverNpow_succ,
        fibreRestrictAlong_schemeHomOverComp, ih]

end P2mKcSerreAVBase

