section DualEulerIdentification

variable {K : Type} [Field K] [NumberField K]
variable {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}
variable {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ} {ω : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
variable (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
variable {χ : ↥(torusClass (K := K) S) →* ℂˣ}

private noncomputable def d100 (hχ : Continuous χ) (v : HeightOneSpectrum (𝓞 K)) (s : ℂ) : ℂ :=
  ((if IsUnramifiedCharAt (d039 S χ) v
    then Polynomial.C 1
      - Polynomial.C ((((d039 S χ (uniformizerIdele K v))⁻¹ : ℂˣ) : ℂ)
          * ((Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).a v
            / (Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).b v)) * Polynomial.X
      + Polynomial.C ((((d039 S χ (uniformizerIdele K v)) ^ (-2 : ℤ) : ℂˣ) : ℂ)
          * ((Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).b v)⁻¹) * Polynomial.X ^ 2
    else Polynomial.C 1 : Polynomial ℂ).eval (((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(1 / 2 - s))))⁻¹

private theorem t0882 (η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) {v : HeightOneSpectrum (𝓞 K)}
    (hv : v ∉ S) :
    ((ω * η)⁻¹ * d017 S (fun v => localChar ω v * (epsS v)⁻¹)) (uniformizerIdele K v)
      = (ω (uniformizerIdele K v) * η (uniformizerIdele K v))⁻¹ := by
  simp only [t0031, MonoidHom.mul_apply, MonoidHom.inv_apply,
    t0253 S (fun v => localChar ω v * (epsS v)⁻¹) hv, mul_one]

private theorem t0883 {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (hω : IsUnramifiedCharAt ω v) :
    IsUnramifiedCharAt ((ω * d039 S χ)⁻¹ * d017 S (fun v => localChar ω v * (epsS v)⁻¹)) v
      ↔ IsUnramifiedCharAt (d039 S χ) v :=
  (t0784 S epsS ω (d039 S χ) hv hω).trans
    (t0797 hv)

private theorem t0884 (hχ : Continuous χ) {v : HeightOneSpectrum (𝓞 K)}
    (hv : v ∉ S) (hω : IsUnramifiedCharAt ω v)
    (hωb : ((ω (uniformizerIdele K v) : ℂˣ) : ℂ)
      = (Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).b v) (s : ℂ) :
    d093 (Pi := Pi) ((ω * d039 S χ)⁻¹ * d017 S (fun v => localChar ω v * (epsS v)⁻¹)) v (-s)
      = d100 (Pi := Pi) hχ v s := by
  unfold d093 d100
  by_cases hU : IsUnramifiedCharAt (d039 S χ) v
  · rw [if_pos ((t0883 hv hω).2 hU), if_pos hU,
      t0882 (d039 S χ) hv]
    have hN := absNorm_ne_zero v
    have hq : ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(1 / 2 : ℂ)) ≠ 0 := fun h =>
      hN ((Complex.cpow_eq_zero_iff _ _).1 h).1
    have hw : ((d039 S χ (uniformizerIdele K v) : ℂˣ) : ℂ) ≠ 0 := Units.ne_zero _
    have hhalf : (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)
        = ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(1 / 2 : ℂ)) := by
      rw [Complex.ofReal_cpow (Nat.cast_nonneg _)]
      push_cast
      ring_nf
    have hb : Pi.b v ≠ 0 := by
      have hB : (Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).b v ≠ 0 :=
        hωb ▸ Units.ne_zero _
      rw [HeckeEigensystem.twist_b] at hB
      exact right_ne_zero_of_mul hB
    have hX : ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(-s + 1))
        = ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(1 / 2 : ℂ))
          * ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (-(1 / 2 - s)) := by
      rw [← Complex.cpow_add _ _ hN]
      congr 1
      ring
    congr 1
    simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
      Polynomial.eval_pow, Units.val_pow_eq_pow_val, Units.val_zpow_eq_zpow_val, Units.val_inv_eq_inv_val,
      Units.val_mul, hωb, HeckeEigensystem.twist_a, HeckeEigensystem.twist_b, hhalf, hX, zpow_neg, zpow_two]
    field_simp <;> ring
  · rw [if_neg (fun h => hU ((t0883 hv hω).1 h)), if_neg hU]
    simp only [Polynomial.eval_C]

