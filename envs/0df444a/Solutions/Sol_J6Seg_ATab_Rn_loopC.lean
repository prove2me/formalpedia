    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)]
  rw [log2P_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)]
  rw [expNegFixP_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, h16])
