-- title:
--   Theorem 18 — finite, linear or sublinear convergence of $\mathcal F_k$ to $\mathcal F_*$
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is a bounded sequence generated by Algorithm 1 or Algorithm 2, converging to $(\hat x,\hat z,\hat y)$, such that $\mathcal F_r$ satisfies the Łojasiewicz property (70) at $(\hat x,\hat z,\hat y,\hat x,\hat y)$ with constant $C_L>0$ and exponent $\theta\in[0,1)$. Then:
--   1. if $\theta = 0$, $(\mathcal F_k)_{k\ge1}$ converges in finite time: $\mathcal F_k = \mathcal F_*$ for all large $k$;
--   2. if $\theta\in(0,\frac12]$, there are $k_0\ge1$, $\hat C_0>0$ and $Q\in[0,1)$ with $0\le\mathcal F_k - \mathcal F_*\le\hat C_0Q^k$ for every $k\ge k_0$;
--   3. if $\theta\in(\frac12,1)$, there are $k_0\ge3$ and $\hat C_1>0$ with
--   $$0\le\mathcal F_k - \mathcal F_* \le \hat C_1 (k-1)^{-\frac{1}{2\theta-1}}\qquad\text{for every } k\ge k_0.$$
--
--   These rates for the regularized augmented Lagrangian are transferred to the iterates in Theorem 20.
--
--   **Formalization Note** $\mathcal F_k - \mathcal F_*$ is $\mathcal E_k$ (a real number); $\mathcal F_*$ is $\mathcal F_r(\hat x,\hat z,\hat y,\hat x,\hat y)$, which the paper shows equals $\lim_k\mathcal F_k$. In part 1 the index $K$ is required to be $\ge1$, as $(\mathcal F_k)$ is indexed from $k=1$. All constants are quantified after the data, the run, the limit, $C_L$ and $\theta$, and before $k$. For the Łojasiewicz hypothesis and the Section 3 $\mathcal F_r$ see the definition items.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 27, Theorem 18

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **Theorem 18** (Boţ–Nguyen, arXiv:1801.01994v2, p. 27). Under Assumption 2, for a bounded
sequence generated by Algorithm 1 or Algorithm 2 such that `F_r` has the Łojasiewicz
property (70) at its limit with constant `C_L > 0` and exponent `θ ∈ [0, 1)`:
(i) `θ = 0`: `F_k = F_*` for all large `k`;
(ii) `θ ∈ (0, 1/2]`: `0 ≤ F_k − F_* ≤ Ĉ₀ Qᵏ` for `k ≥ k₀`, some `k₀ ≥ 1`, `Ĉ₀ > 0`, `Q ∈ [0, 1)`;
(iii) `θ ∈ (1/2, 1)`: `0 ≤ F_k − F_* ≤ Ĉ₁(k − 1)^{−1/(2θ−1)}` for `k ≥ k₀`, some `k₀ ≥ 3`,
`Ĉ₁ > 0`. -/
theorem theorem_18
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (hbx : Bornology.IsBounded (Set.range x)) (hbz : Bornology.IsBounded (Set.range z))
    (hby : Bornology.IsBounded (Set.range y))
    (xh : BotNguyenADMM.KL.E n) (zh yh : BotNguyenADMM.KL.E m) (CL θ : ℝ)
    (hloj : LojAt v g h A L r ρ lam μ₁ x z y xh zh yh CL θ) :
    (θ = 0 → ∃ K : ℕ, 1 ≤ K ∧ ∀ k ≥ K,
      Fk v g h A L r ρ lam μ₁ x z y k = Fstar v g h A L r ρ lam μ₁ xh zh yh) ∧
    (0 < θ ∧ θ ≤ 1 / 2 → ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∃ C0hat : ℝ, 0 < C0hat ∧ ∃ Q : ℝ, 0 ≤ Q ∧ Q < 1 ∧
      ∀ k ≥ k₀, 0 ≤ Ek v g h A L r ρ lam μ₁ x z y xh zh yh k ∧
        Ek v g h A L r ρ lam μ₁ x z y xh zh yh k ≤ C0hat * Q ^ k) ∧
    (1 / 2 < θ ∧ θ < 1 → ∃ k₀ : ℕ, 3 ≤ k₀ ∧ ∃ C1hat : ℝ, 0 < C1hat ∧
      ∀ k ≥ k₀, 0 ≤ Ek v g h A L r ρ lam μ₁ x z y xh zh yh k ∧
        Ek v g h A L r ρ lam μ₁ x z y xh zh yh k ≤
          C1hat * ((k : ℝ) - 1) ^ (-(1 / (2 * θ - 1)))) := by sorry

end BotNguyenADMM.Rates
