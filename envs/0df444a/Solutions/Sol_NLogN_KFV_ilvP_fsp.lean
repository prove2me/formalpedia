    have zv := hwv _ (List.getElem_mem hk')
    obtain ⟨G, hG⟩ : ∃ G, G = Function.update (F k) NLogN.KFV.vL [(u.length : ℤ) - k] := ⟨_, rfl⟩
    rw [← hG]
    have hGu : G NLogN.KFV.vOR = u[k] :: (u.drop (k + 1) ++ lu) := by
      rw [hG, Function.update_of_ne (by decide), hF]
      simp only [Function.update_of_ne (show NLogN.KFV.vOR ≠ NLogN.KFV.vO by decide),
        Function.update_of_ne (show NLogN.KFV.vOR ≠ NLogN.KFV.vOI by decide), Function.update_self]
      rw [hdu]; rfl
    have hGv : G NLogN.KFV.vOI = v[k] :: (v.drop (k + 1) ++ lv) := by
      rw [hG, Function.update_of_ne (by decide), hF]
      simp only [Function.update_of_ne (show NLogN.KFV.vOI ≠ NLogN.KFV.vO by decide), Function.update_self]
      rw [hdv]; rfl
    have s1 := NLogN.KIL.Sp.push s G (i := NLogN.KFV.vO) (e := .reg NLogN.KFV.vOR) (B := w) (by decide) (NLogN.KIL.clean_reg (by decide))
      (NLogN.KIL.ok_reg hGu) trivial (NLogN.KIL.bnd_reg hGu zu)
    rw [NLogN.KIL.eval_reg hGu] at s1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G NLogN.KFV.vO (u[k] :: G NLogN.KFV.vO) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have hG1v : G1 NLogN.KFV.vOI = v[k] :: (v.drop (k + 1) ++ lv) := by
      rw [hG1, Function.update_of_ne (by decide), hGv]
    have s2 := NLogN.KIL.Sp.push s G1 (i := NLogN.KFV.vO) (e := .reg NLogN.KFV.vOI) (B := w) (by decide) (NLogN.KIL.clean_reg (by decide))
      (NLogN.KIL.ok_reg hG1v) trivial (NLogN.KIL.bnd_reg hG1v zv)
    rw [NLogN.KIL.eval_reg hG1v] at s2
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 NLogN.KFV.vO (v[k] :: G1 NLogN.KFV.vO) := ⟨_, rfl⟩
    rw [← hG2] at s2
    have hG2u : G2 NLogN.KFV.vOR = u[k] :: (u.drop (k + 1) ++ lu) := by
      rw [hG2, Function.update_of_ne (by decide), hG1, Function.update_of_ne (by decide), hGu]
    have s3 := NLogN.KIL.Sp.pop s G2 (i := NLogN.KFV.vOR) (B := w) (by decide) hG2u zu
    obtain ⟨G3, hG3⟩ : ∃ G3, G3 = Function.update G2 NLogN.KFV.vOR (u.drop (k + 1) ++ lu) := ⟨_, rfl⟩
    rw [← hG3] at s3
    have hG3v : G3 NLogN.KFV.vOI = v[k] :: (v.drop (k + 1) ++ lv) := by
      rw [hG3, Function.update_of_ne (by decide), hG2, Function.update_of_ne (by decide), hG1,
        Function.update_of_ne (by decide), hGv]
    have s4 := NLogN.KIL.Sp.pop s G3 (i := NLogN.KFV.vOI) (B := w) (by decide) hG3v zv
    have HH := NLogN.KFD.FSp.of_norep rfl (s1.seq (s2.seq (s3.seq s4)))
    refine NLogN.KFD.FSp.mono (NLogN.KFD.FSp.congr HH ?_) (by simp only [NLogN.Ex.size]; omega)
    congr 1
    funext j
    simp only [hG3, hG2, hG1, hG, hF, Function.update_apply]
    by_cases e1 : j = NLogN.KFV.vL
    · subst e1; simp +decide
    by_cases e2 : j = NLogN.KFV.vOI
    · subst e2; simp +decide
    by_cases e3 : j = NLogN.KFV.vOR
    · subst e3; simp +decide
    by_cases e4 : j = NLogN.KFV.vO
    · subst e4
      simp +decide only [if_true, if_false, htu, htv]
      rw [List.zip_append (by simp [List.length_take]; omega)]
      simp [NLogN.KFB.gflat_append]
    · simp [e1, e2, e3, e4]
end
