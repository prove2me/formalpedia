  have hb1v : Tendsto b (𝓝[>] (0:ℝ)) (𝓝 1) := k0_value hδ (c₀ := 1) hvalb
  have hvalA' : ∀ x ∈ Ioo (0:ℝ) δ, |A x - (0 + a₁ * x)| ≤ C_A * x ^ 2 :=
    fun x hx => by simpa using hvalA x hx
  have hA0 : Tendsto A (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have := k0_value hδ (c₀ := 0) hvalA'; simpa using this
  have hAx : Tendsto (fun x => A x / x) (𝓝[>] (0:ℝ)) (𝓝 a₁) := by
    have := k0_slope hδ hvalA'; simpa using this
  have hΦlim : Tendsto (fun x => F x * A x / (x * b x)
      + 2 * Q * F x * b x * x * (J + 2 * Q * A x) / (1 - h * x) ^ 2) (𝓝[>] (0:ℝ)) (𝓝 a₁) := by
