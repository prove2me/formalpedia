/-!
# Lane C3 — Taylor-form enclosures of the inverse jet on slope segments

`tf c w δ` encloses, componentwise, `Q^(k)(ys + δ) = Σ_{m ≤ 4-k} Q^(k+m)(ys) δ^m/m!
+ Q^(5)(ξ) δ^{5-k}/(5-k)!` given a centre jet `c ∋ Q^(·)(ys)`, a jet `w` whose fifth
component encloses `Q^(5)` on the whole segment, and `δ ∋ y - ys`.
(Generated by tools/gen_taylor_form.py.)
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option linter.unusedSimpArgs false

namespace CKLaneC3.TaylorForm

open Set GeneralCK GeneralCK.Certificates DyadicInterval
open CKLaneC3.TaylorChain CKLaneC3.SlopeTable E8TAxisDeltaDirectionalJet

theorem seg_mem {y0 y1 ys y u : ℝ} (hys : y0 ≤ ys ∧ ys ≤ y1) (hy : y0 ≤ y ∧ y ≤ y1)
    (hu : u ∈ Icc (0 : ℝ) 1) : y0 ≤ ys + u * (y - ys) ∧ ys + u * (y - ys) ≤ y1 := by
  constructor <;> nlinarith [hu.1, hu.2, hys.1, hys.2, hy.1, hy.2]

theorem seg_deriv {F F' : ℝ → ℝ} {ys d u : ℝ} (m : ℕ)
    (hF : HasDerivAt F (F' (ys + u * d)) (ys + u * d)) :
    HasDerivAt (fun u : ℝ => F (ys + u * d) * d ^ m) (F' (ys + u * d) * d ^ (m + 1)) u := by
  have hlin : HasDerivAt (fun u : ℝ => ys + u * d) d u := by
    simpa using ((hasDerivAt_id u).mul_const d).const_add ys
  have hc : HasDerivAt (F ∘ fun u : ℝ => ys + u * d) (F' (ys + u * d) * d) u :=
    HasDerivAt.comp u hF hlin
  exact (hc.mul_const (d ^ m)).congr_deriv (by ring)

def tfTerm (c δ : DyadicInterval P) (m : ℕ) : DyadicInterval P :=
  (c.mul (E8TAxisReparamInterval.powI δ m)).mul (ofInt P (m.factorial : ℤ)).recip

theorem tfTerm_sound {c δ : DyadicInterval P} {x d : ℝ} (hc : c.Contains x) (hd : δ.Contains d)
    (m : ℕ) : (tfTerm c δ m).Contains (x * d ^ m * ((m.factorial : ℤ) : ℝ)⁻¹) := by
  have hpos : 0 < (ofInt P (m.factorial : ℤ)).lo := by
    simp only [ofInt]
    exact mul_pos (scale_pos P) (by exact_mod_cast Nat.factorial_pos m)
  exact mul_sound (mul_sound hc (E8TAxisReparamInterval.powI_sound hd m))
    (recip_sound hpos (ofInt_sound P (m.factorial : ℤ)))

/-- Order-5 Lagrange form for component `d0` along a segment. -/
theorem seg_taylor_d0 {j : Jet5} {y0 y1 ys y : ℝ}
    (hs : ∀ z, y0 ≤ z → z ≤ y1 → j.SoundAt z)
    (hys : y0 ≤ ys ∧ ys ≤ y1) (hy : y0 ≤ y ∧ y ≤ y1) :
    ∃ ξ, y0 ≤ ξ ∧ ξ ≤ y1 ∧ j.d0 y = j.d0 ys * (y - ys) ^ 0 * ((1 : ℤ) : ℝ)⁻¹ + j.d1 ys * (y - ys) ^ 1 * ((1 : ℤ) : ℝ)⁻¹ + j.d2 ys * (y - ys) ^ 2 * ((2 : ℤ) : ℝ)⁻¹ + j.d3 ys * (y - ys) ^ 3 * ((6 : ℤ) : ℝ)⁻¹ + j.d4 ys * (y - ys) ^ 4 * ((24 : ℤ) : ℝ)⁻¹ + j.d5 ξ * (y - ys) ^ 5 * ((120 : ℤ) : ℝ)⁻¹ := by
  have h0 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d0 (ys + u * (y - ys)) * (y - ys) ^ 0)
      (j.d1 (ys + u * (y - ys)) * (y - ys) ^ (0 + 1)) u := by
    intro u hu
    have hz := seg_mem hys hy hu
    have hsa := hs _ hz.1 hz.2
    exact seg_deriv 0 hsa.1
  have h1 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d1 (ys + u * (y - ys)) * (y - ys) ^ 1)
      (j.d2 (ys + u * (y - ys)) * (y - ys) ^ (1 + 1)) u := by
    intro u hu
    have hz := seg_mem hys hy hu
    have hsa := hs _ hz.1 hz.2
    exact seg_deriv 1 hsa.2.1
  have h2 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d2 (ys + u * (y - ys)) * (y - ys) ^ 2)
      (j.d3 (ys + u * (y - ys)) * (y - ys) ^ (2 + 1)) u := by
    intro u hu
    have hz := seg_mem hys hy hu
    have hsa := hs _ hz.1 hz.2
    exact seg_deriv 2 hsa.2.2.1
  have h3 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d3 (ys + u * (y - ys)) * (y - ys) ^ 3)
      (j.d4 (ys + u * (y - ys)) * (y - ys) ^ (3 + 1)) u := by
    intro u hu
    have hz := seg_mem hys hy hu
    have hsa := hs _ hz.1 hz.2
    exact seg_deriv 3 hsa.2.2.2.1
  have h4 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d4 (ys + u * (y - ys)) * (y - ys) ^ 4)
      (j.d5 (ys + u * (y - ys)) * (y - ys) ^ (4 + 1)) u := by
    intro u hu
    have hz := seg_mem hys hy hu
    have hsa := hs _ hz.1 hz.2
    exact seg_deriv 4 hsa.2.2.2.2
  obtain ⟨θ, hθ, heq⟩ := exists_remainder5 h0 h1 h2 h3 h4
  have hz := seg_mem hys hy ⟨hθ.1.le, hθ.2.le⟩
  refine ⟨ys + θ * (y - ys), hz.1, hz.2, ?_⟩
  simp only [zero_mul, add_zero, one_mul, pow_zero, mul_one] at heq
  have hy1 : ys + (y - ys) = y := by ring
  rw [hy1] at heq
  rw [heq]
  push_cast
  ring

