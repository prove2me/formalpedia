-- title:
--   Certified rational negative-exponential references for Fourier contour evaluation
-- statement:
--   A1024-entry cache of rational negative-exponential references. Each record includes an ordinary kernel proof of its input,32-term exponential seed, eight rounded squarings, reciprocal, frequency input and quantitative finite guards. This certifies only exact rational arithmetic and its guards; analytic exponential accuracy is proved separately. No sign, winding, count or RH statement is asserted.
-- source:
--   Existing Gaussian gamma-amplitude enclosure architecture after Platt DOI10.1090/mcom/3198. Original surrounding attribution sometik179 c9908072-d99a-4431-aad8-a72c6352619a and Gabewhigham.

import Mathlib
import Definitions.Def_TaoFivePrimes_RHHighGammaArithmetic
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
namespace RHHighContourReference
open RHHighLogData
noncomputable def rr (m : Nat) : Int := -((RHHighGammaArithmetic.P*D*m/(512*10^50):Nat):Int)
noncomputable def frequency (m : Nat) : Nat := RHHighGammaArithmetic.P*D*m/(8192*10^50)
noncomputable def iterate (a : Nat) : Nat→Nat
  | 0 => a
  | k+1 => let t:=iterate a k;t*t/D
noncomputable def check (m d seed amp inverse x : Nat) : Bool := decide (
  1 ≤ m ∧ m≤1024 ∧ d=(-rr m).toNat/256 ∧ seed=RHHighNegativeExp.seed D d ∧
  amp=iterate seed 8 ∧ inverse=D*D/amp ∧ x=frequency m ∧ 2*d≤D ∧
  d*RHHighGenericExpHorner.horner (RHHighNegativeExp.en D) (d^2)≤
    RHHighGenericExpHorner.horner (RHHighNegativeExp.ep D) (d^2) ∧
  D≤1000*amp ∧ amp≤D)
structure Record where
  m : Nat
  d : Nat
  seed : Nat
  amplitude : Nat
  inverse : Nat
  x : Nat
  valid : check m d seed amplitude inverse x=true
