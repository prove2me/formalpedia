  rw [signedBitTape_length]
  induction es with
  | nil => simp
  | cons x es ih =>
    have h := ih (fun y hy => hw y (by simp [hy]))
    have hx := Nat.size_le.mpr (hw x (by simp))
    simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.succ_mul]
    omega

