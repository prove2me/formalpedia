    apply mul_le_mul_of_nonneg_left _ hD0; nlinarith
  push_cast
  have e : (K + 10 ^ 8 * D) * ((V : ℝ) + 1) * x = K * ((V : ℝ) + 1) * x + 10 ^ 8 * (D * (((V : ℝ) + 1) * x)) := by ring
