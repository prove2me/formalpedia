-- Source module: Solutions.KFUUAbs
/-!
# KFUU §9d: absorbing the costs of `Φ` into `cPhiU`

With `L = size V_T` (`V_T ≥ 2^{d+1}`, so `d + 2 ≤ L` and `L^4 ≤ 64 V_T`), every bit-size
quantity of the setup, the table and the multiplications is polylogarithmic in `V_T`, or is
covered by the descriptor term `(d+1)(h + w + size V_S + 1)^2`.

* `pow4_le`: `x^4 ≤ 32 · 2^x`; `fmB_le`: `fmB n ≤ 1280 K₀ (n+1)^2`; `cU_le`.
* `natPart_le`: all `ℕ` costs `≤ C₁ ((d+1) cScan V_T w + D + d·cRb)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

theorem pow4_le (x : ℕ) : x ^ 4 ≤ 32 * 2 ^ x := by
  induction x with
  | zero => norm_num
  | succ n ih =>
    by_cases hn : n < 9
    · interval_cases n <;> norm_num
    · push_neg at hn
      have h1 : (n + 1) ^ 4 ≤ 2 * n ^ 4 := by
        have : 9 * n ^ 3 ≤ n ^ 4 := by
          have := Nat.mul_le_mul_right (n ^ 3) hn; nlinarith [this]
        nlinarith [Nat.zero_le n, sq_nonneg n]
      calc (n + 1) ^ 4 ≤ 2 * n ^ 4 := h1
        _ ≤ 2 * (32 * 2 ^ n) := by omega
        _ = 32 * 2 ^ (n + 1) := by ring

theorem zsz_le_size' (n : ℕ) : zsz (n : ℤ) ≤ Nat.size n :=
  zsz_le_of_lt (by simpa using Nat.lt_size_self n)

theorem two_pow_size_le {M : ℕ} (hM : 1 ≤ M) : 2 ^ Nat.size M ≤ 2 * M := by
  have h1 : 0 < Nat.size M := Nat.size_pos.2 (by omega)
  have h2 : 2 ^ (Nat.size M - 1) ≤ M := Nat.lt_size.1 (by omega)
  have h3 : 2 ^ Nat.size M = 2 * 2 ^ (Nat.size M - 1) := by
    rw [← pow_succ']; congr 1; omega
  omega

theorem two_pow_zsz_le2 {M : ℕ} (hM : 1 ≤ M) : 2 ^ zsz (M : ℤ) ≤ 2 * M :=
  le_trans (Nat.pow_le_pow_right (by norm_num) (zsz_le_size' M)) (two_pow_size_le hM)

theorem fmB_le (n : ℕ) : KFM.fmB n ≤ 1280 * K0 * (n + 1) ^ 2 := by
  set M := n + 1 with hM
  set z := zsz ((M : ℕ) : ℤ) with hz
  have h4 : zsz (((z + 2) ^ 4 : ℕ) : ℤ) ≤ 4 * (z + 2) := by
    apply zsz_le_of_lt
    have : z + 2 < 2 ^ (z + 2) := Nat.lt_two_pow_self
    have := Nat.pow_lt_pow_left this (show 4 ≠ 0 by norm_num)
    rw [Int.natAbs_natCast, show 4 * (z + 2) = (z + 2) * 4 by ring, pow_mul]; exact this
  have h2 : (z + 2) ^ 4 ≤ 128 * 2 ^ z := by
    have := pow4_le (z + 2); rw [pow_add] at this; omega
  have h3 : 2 ^ z ≤ 2 * M := two_pow_zsz_le2 (by omega)
  have h5 : (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ 1280 * M := by
    have a : (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ (z + 2) * (4 * (z + 2) + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    have b : (z + 2) ^ 2 ≤ (z + 2) ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    nlinarith
  unfold KFM.fmB
  rw [← hM, ← hz]
  have : K0 * M * (z + 2) * (zsz (((z + 2) ^ 4 : ℕ) : ℤ) + 1) ≤ K0 * M * (1280 * M) := by
    rw [mul_assoc (K0 * M)]; exact Nat.mul_le_mul_left _ h5
  unfold K0 at this ⊢
  nlinarith

theorem cU_le (Z : ℕ) : cU Z ≤ CU * (Z + 1) ^ 2 := by
  unfold cU CU
  have h1 := fmB_le (2 * Z)
  have h2 : (2 * Z + 1) ^ 2 ≤ 4 * (Z + 1) ^ 2 :=
    calc (2 * Z + 1) ^ 2 ≤ (2 * (Z + 1)) ^ 2 := Nat.pow_le_pow_left (by omega) 2
      _ = 4 * (Z + 1) ^ 2 := by ring
  have h3 : Z + 1 ≤ (Z + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
  have h4 := Nat.mul_le_mul_left (1280 * K0) h2
  have h5 := Nat.mul_le_mul_left (10 ^ 4) h3
  have h6 := Nat.zero_le (K0 * (Z + 1) ^ 2)
  linarith

