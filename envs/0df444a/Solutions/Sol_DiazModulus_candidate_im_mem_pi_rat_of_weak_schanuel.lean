import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_hermite_lindemann_holds
import Theorems.Thm_DiazModulus_diaz_on_axes_of_hermite_lindemann

open Complex ComplexConjugate

/-!
# Under weak Schanuel (n = 2), a candidate has imaginary part in `πℚ`

Let `u` be a candidate: `u ≠ 0`, `|u|` algebraic, `exp u` algebraic. By Hermite–Lindemann,
`diaz_on_axes_of_hermite_lindemann` rules out `u` on either axis, so `Re u ≠ 0` and `Im u ≠ 0`.
Apply the weak Schanuel hypothesis to the pair `(u, ū)`. Every generator of
`ℚ[u, ū, e^u, e^ū]` is algebraic over `ℚ[u]`: `e^u` is algebraic, `e^ū = conj(e^u)` is algebraic,
and `ū` is a root of `u·X − |u|²` with `|u|²` algebraic. So the transcendence degree is at most
`1 < 2`, and the hypothesis yields integers `m, n, k`, not both of `m, n` zero, with
`m u + n ū = 2πik`. The real part gives `(m + n) Re u = 0`, so `n = −m` and `m ≠ 0`; the
imaginary part then gives `2 m Im u = 2πk`, so `Im u = (k/m) π`, and `k ≠ 0` since `Im u ≠ 0`.
-/

namespace R7_wscIm

/-- A subalgebra generated by elements all algebraic over `K[x]` has transcendence degree
at most one (copied from the accepted node `Transcendence.trdeg_adjoin_le_one_of_isAlgebraic_adjoin`). -/
theorem trdeg_le_one_of_adjoin_singleton {K L : Type*} [Field K] [Field L] [Algebra K L]
    {B : Subalgebra K L} {x : L} (hxB : x ∈ B)
    (halg : ∀ y ∈ B, IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) y) :
    Algebra.trdeg K ↥B ≤ 1 := by
  set x' : (↥B) := ⟨x, hxB⟩ with hx'
  have hmap : Subalgebra.map B.val (Algebra.adjoin K ({x'} : Set ↥B))
      = Algebra.adjoin K ({x} : Set L) := by
    rw [AlgHom.map_adjoin]
    congr 1
    simp [hx']
  let e : ↥(Algebra.adjoin K ({x'} : Set ↥B)) ≃ₐ[K] ↥(Algebra.adjoin K ({x} : Set L)) :=
    (Subalgebra.equivMapOfInjective _ B.val Subtype.val_injective).trans
      (Subalgebra.equivOfEq _ _ hmap)
  have : Algebra.IsAlgebraic ↥(Algebra.adjoin K ({x'} : Set ↥B)) ↥B := by
    constructor
    intro y
    refine IsAlgebraic.of_ringHom_of_comp_eq (f := (e : _ →+* _))
      (g := (B.val : ↥B →+* L)) (halg y y.2) e.surjective Subtype.val_injective ?_
    ext c
    rfl
  simpa using Algebra.IsAlgebraic.trdeg_le_cardinalMk K ({x'} : Set ↥B)

/-- `Algebra.adjoin K S` has transcendence degree at most one when every element of `S` is
algebraic over `K[x]`. -/
theorem trdeg_adjoin_le_one {K L : Type*} [Field K] [Field L] [Algebra K L] (x : L) (S : Set L)
    (hS : ∀ s ∈ S, IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) s) :
    Algebra.trdeg K ↥(Algebra.adjoin K S) ≤ 1 := by
  let E : Subalgebra K L :=
    (Subalgebra.algebraicClosure ↥(Algebra.adjoin K ({x} : Set L)) L).restrictScalars K
  have hxE : x ∈ E := by
    show IsAlgebraic ↥(Algebra.adjoin K ({x} : Set L)) x
    have h : x = algebraMap ↥(Algebra.adjoin K ({x} : Set L)) L
        ⟨x, Algebra.subset_adjoin rfl⟩ := rfl
    rw [h]
    exact isAlgebraic_algebraMap _
  have hle : Algebra.adjoin K S ≤ E := Algebra.adjoin_le fun s hs => hS s hs
  exact (trdeg_le_of_injective (Subalgebra.inclusion hle)
    (Subalgebra.inclusion_injective hle)).trans
    (trdeg_le_one_of_adjoin_singleton hxE (fun _ hy => hy))

end R7_wscIm

open DiazModulus R7_wscIm in
theorem solution
    (hWSC : ∀ a b : ℂ,
      Algebra.trdeg ℚ ↥(Algebra.adjoin ℚ ({a, b, Complex.exp a, Complex.exp b} : Set ℂ)) < 2 →
      ∃ m n k : ℤ, (m ≠ 0 ∨ n ≠ 0) ∧
        (m : ℂ) * a + (n : ℂ) * b = 2 * ((Real.pi : ℝ) : ℂ) * Complex.I * (k : ℂ))
    {u : ℂ} (h : IsCandidate u) :
    u.re ≠ 0 ∧ ∃ q : ℚ, q ≠ 0 ∧ u.im = (q : ℝ) * Real.pi := by
  obtain ⟨hu0, hun, hue⟩ := h
  have hax := DiazModulus.diaz_on_axes_of_hermite_lindemann
    DiazModulus.hermite_lindemann_holds u hu0
  have hre : u.re ≠ 0 := fun h0 => hax (Or.inr h0) hun hue
  have him : u.im ≠ 0 := fun h0 => hax (Or.inl h0) hun hue
  refine ⟨hre, ?_⟩
  -- transcendence degree of `ℚ[u, ū, e^u, e^ū]` is at most one
  have hext : ∀ z : ℂ, IsAlgebraic ℚ z → IsAlgebraic (Algebra.adjoin ℚ ({u} : Set ℂ)) z :=
    fun z hz => hz.extendScalars (algebraMap ℚ _).injective
  have huu : IsAlgebraic (Algebra.adjoin ℚ ({u} : Set ℂ)) u :=
    isAlgebraic_algebraMap (⟨u, Algebra.subset_adjoin rfl⟩ : Algebra.adjoin ℚ ({u} : Set ℂ))
  have hcuu : IsAlgebraic (Algebra.adjoin ℚ ({u} : Set ℂ)) (conj u) := by
    refine IsAlgebraic.of_mul (mem_nonZeroDivisors_of_ne_zero hu0) huu (hext _ ?_)
    have h : u * conj u = ((‖u‖ : ℝ) : ℂ) ^ 2 := by
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]; push_cast; ring
    rw [h]; exact hun.pow 2
  have hecu : IsAlgebraic ℚ (Complex.exp (conj u)) := by
    rw [Complex.exp_conj]
    exact hue.algHom ((Complex.conjAe : ℂ ≃ₐ[ℝ] ℂ).toAlgHom.restrictScalars ℚ)
  have htr := trdeg_adjoin_le_one (K := ℚ) u
    ({u, conj u, Complex.exp u, Complex.exp (conj u)} : Set ℂ) (by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl | rfl
      · exact huu
      · exact hcuu
      · exact hext _ hue
      · exact hext _ hecu)
  obtain ⟨m, n, k, hmn, hrel⟩ := hWSC u (conj u) (htr.trans_lt Cardinal.one_lt_two)
  have hR := congrArg Complex.re hrel
  have hI := congrArg Complex.im hrel
  simp at hR hI
  -- `hR : m * u.re + n * u.re = 0`, `hI : m * u.im - n * u.im = 2 * π * k`
  have hnm : (n : ℝ) = -m := by
    have : ((m : ℝ) + n) * u.re = 0 := by linarith
    rcases mul_eq_zero.1 this with h1 | h1
    · linarith
    · exact absurd h1 hre
  have hnm' : n = -m := by exact_mod_cast hnm
  have hm : m ≠ 0 := by
    rintro rfl
    simp [hnm'] at hmn
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
  have hkey : (m : ℝ) * u.im = Real.pi * k := by
    rw [hnm] at hI; linarith
  have hk : k ≠ 0 := by
    rintro rfl
    simp at hkey
    rcases hkey with h1 | h1
    · exact hm h1
    · exact him h1
  refine ⟨(k : ℚ) / m, ?_, ?_⟩
  · exact div_ne_zero (by exact_mod_cast hk) (by exact_mod_cast hm)
  · push_cast
    field_simp
    linarith
