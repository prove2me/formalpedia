    (hnormU : ∀ u : (AdeleRing (𝓞 ℚ) ℚ)ˣ, (u : AdeleRing (𝓞 ℚ) ℚ).1 = 1 →
      (∀ v ∈ T, (u : AdeleRing (𝓞 ℚ) ℚ).2 v = 1) →
      NumberField.AdeleRing.finitePartUnits (𝓞 ℚ) ℚ u ∈ IsDedekindDomain.FiniteAdeleRing.unitIdeles (𝓞 ℚ) ℚ →
        TateGlobal.ideleNorm ℚ u = 1)
    (hnorm : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      TateGlobal.ideleNorm ℚ (uniformizerIdele ℚ v) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹)
    (s : ℂ) (L : List (HeightOneSpectrum (𝓞 ℚ))) (hLT : ∀ v ∈ L, v ∉ T) (hL : L.Nodup) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (ha : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T ∪ {v | v ∈ L})) :
    integrand Φ χ s a = integrand Φ χ s (NumberField.Idele.partAt ℚ T a) *
      (L.map fun v => shellTerm (Ideal.absNorm v.asIdeal) (τ v) (χ (uniformizerIdele ℚ v)) s
        (NumberField.Idele.ord ℚ v a)).prod := by
