open Finset Real

namespace J6Seg.TabBnd
open IntMul.HvdH IntMul.HvdH.JPf J6QLU J6Seg

variable {P R s t α lam : ℕ}

lemma int_abs_of_real {x : ℤ} {A : ℕ} (h : |(x : ℝ)| ≤ (2 : ℝ) ^ A) : |x| ≤ 2 ^ A := by
  have : ((|x| : ℤ) : ℝ) ≤ ((2 ^ A : ℤ) : ℝ) := by push_cast; exact h
  exact_mod_cast this

/-- From an ulp bound `|x - 2^P y| ≤ E` with `|y| ≤ 2^R · 1.0001`, `E ≤ 2^P`: `|x| ≤ 2^(P+R+2)`. -/
lemma abs_of_err {x : ℤ} {y E : ℝ} (h : |(x : ℝ) - 2 ^ P * y| ≤ E) (hy : |y| ≤ 2 * 2 ^ R)
    (hE : E ≤ 2 ^ P) (hR1 : (1 : ℝ) ≤ 2 ^ R) : |x| ≤ 2 ^ (P + R + 2) := by
  apply int_abs_of_real
  have hS : (0 : ℝ) < 2 ^ P := by positivity
  have e : (2 : ℝ) ^ (P + R + 2) = 4 * 2 ^ P * 2 ^ R := by rw [pow_add, pow_add]; ring
  rw [e]
  have h1 : |(x : ℝ)| ≤ |(x : ℝ) - 2 ^ P * y| + |2 ^ P * y| := by
    have := abs_add_le ((x : ℝ) - 2 ^ P * y) (2 ^ P * y); simpa using this
  rw [abs_mul, abs_of_pos hS] at h1
  have h2 : 2 ^ P * |y| ≤ 2 ^ P * (2 * 2 ^ R) := mul_le_mul_of_nonneg_left hy hS.le
  nlinarith

/-- **All table entries `≤ 2^(P+R+2)`.** -/
theorem tab_bnd_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) (hl : 1 ≤ lam)
    (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R) :
    ∀ u < lam, |(mkTables P R s t α).di u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).gi u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).gam u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).dd u| ≤ 2 ^ (P + R + 2) ∧
      ∀ c, |(mkTables P R s t α).am c u| ≤ 2 ^ (P + R + 2) ∧
        |(mkTables P R s t α).ap c u| ≤ 2 ^ (P + R + 2) := by
  intro u hu
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  have hR1 : (1 : ℝ) ≤ 2 ^ R := one_le_pow₀ (by norm_num)
  have hlR : (1 : ℝ) ≤ lam := by exact_mod_cast hl
  have hE : 3 * (lam : ℝ) + 3 ≤ 2 ^ P := by linarith
  have hE0 : (0 : ℝ) ≤ 3 * (lam : ℝ) + 3 := by positivity
  have hS : (0 : ℝ) < 2 ^ P := by positivity
  have hgi1 := giR_le hα' hσ u
  have hgi0 := one_le_giR hα' hσ u
  -- the one-block partition starting at `c`
  have blk : ∀ c : ℕ, BlkTab P (α : ℝ) ((t : ℝ) / s) ((bOf s t c : ℝ) / s) (mkTables P R s t α) c
      lam (3 * lam + 3) := fun c =>
    (mkTables_ok (R := R) hs hst hα hP hl hPl hR ⟨s, fun _ => c, fun _ => lam, 0⟩
      (fun _ _ => le_rfl)).blk 0 hs
  have b0 := blk 0
  -- `D_u ≤ 2^R`
  have hdd : ddR (α : ℝ) ((t : ℝ) / s) u ≤ 2 ^ R := (ddR_mono hσ (by omega)).trans hR
  have hdd1 := one_le_ddR (α := (α : ℝ)) hσ u
  have hσ1 : 0 ≤ π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) * (u : ℝ) ^ 2 := by
    have : (0 : ℝ) ≤ (t : ℝ) / s - 1 := by linarith
    positivity
  -- `|a^±| ≤ giR` for any `c`
  have hapm : ∀ c : ℕ, |aplus (α : ℝ) ((t : ℝ) / s) ((bOf s t c : ℝ) / s) u| ≤ 2 * 2 ^ R ∧
      |aminus (α : ℝ) ((t : ℝ) / s) ((bOf s t c : ℝ) / s) u| ≤ 2 * 2 ^ R := by
    intro c
    have hsR : (0 : ℝ) < s := by exact_mod_cast hs
    obtain ⟨h1, h2⟩ := bOf_bounds s t hs (c : ℤ)
    have h1' : -(s : ℝ) ≤ 2 * (bOf s t c : ℝ) := by exact_mod_cast h1
    have h2' : 2 * (bOf s t c : ℝ) < s := by exact_mod_cast h2
    have hb1 : 0 ≤ (t : ℝ) / s + 2 * ((bOf s t c : ℝ) / s) := by
      have : (t : ℝ) / s + 2 * ((bOf s t c : ℝ) / s) = ((t : ℝ) + 2 * (bOf s t c : ℝ)) / s := by ring
      rw [this]; exact div_nonneg (by linarith [(by exact_mod_cast hst : (s : ℝ) ≤ t)]) hsR.le
    have hb2 : 0 ≤ (t : ℝ) / s - 2 * ((bOf s t c : ℝ) / s) := by
      have : (t : ℝ) / s - 2 * ((bOf s t c : ℝ) / s) = ((t : ℝ) - 2 * (bOf s t c : ℝ)) / s := by ring
      rw [this]; exact div_nonneg (by linarith [(by exact_mod_cast hst : (s : ℝ) ≤ t)]) hsR.le
    have hq : giR (α : ℝ) ((t : ℝ) / s) u = (qpoch (qR (α : ℝ) ((t : ℝ) / s)) u)⁻¹ := rfl
    have key : ∀ x : ℝ, 0 ≤ x →
        |(-1) ^ u * exp (-(π * (α : ℝ) ^ 2 * x * u)) / qpoch (qR (α : ℝ) ((t : ℝ) / s)) u| ≤
          2 * 2 ^ R := by
      intro x hx
      rw [div_eq_mul_inv, ← hq, abs_mul, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul,
        abs_of_pos (exp_pos _), abs_of_pos (by linarith)]
      have : exp (-(π * (α : ℝ) ^ 2 * x * u)) ≤ 1 := by
        rw [Real.exp_le_one_iff]; have : 0 ≤ π * (α : ℝ) ^ 2 * x * u := by positivity
        linarith
      nlinarith [exp_pos (-(π * (α : ℝ) ^ 2 * x * u))]
    exact ⟨key _ hb1, key _ hb2⟩
  refine ⟨abs_of_err (b0.di u hu) ?_ hE hR1, abs_of_err (b0.gi u hu) ?_ hE hR1,
    abs_of_err (b0.gam u hu) ?_ hE hR1, ?_, fun c => ⟨abs_of_err ((blk c).am u hu) (hapm c).2 hE hR1,
      abs_of_err ((blk c).ap u hu) (hapm c).1 hE hR1⟩⟩
  · rw [diR, abs_of_pos (exp_pos _)]
    have : exp (-(π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) * (u : ℝ) ^ 2)) ≤ 1 := by
      rw [Real.exp_le_one_iff]; linarith
    linarith
  · rw [abs_of_pos (by linarith)]; linarith
  · have h0 := gamR_pos hα' hσ u
    have h1 := gamR_le_one hα' hσ u
    rw [abs_of_pos h0]; linarith
  · -- `dd`: `|dd| ≤ (2^P + E) D_u ≤ 2^(P+1) 2^R`
    have h := b0.dd u hu
    apply int_abs_of_real
    have e : (2 : ℝ) ^ (P + R + 2) = 4 * 2 ^ P * 2 ^ R := by rw [pow_add, pow_add]; ring
    rw [e]
    have h1 : |((mkTables P R s t α).dd u : ℝ)| ≤
        |((mkTables P R s t α).dd u : ℝ) - 2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u| +
          |2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u| := by
      have := abs_add_le (((mkTables P R s t α).dd u : ℝ) - 2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u)
        (2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u)
      simpa using this
    rw [abs_of_pos (by positivity : (0 : ℝ) < 2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u)] at h1
    have h2 : (3 * (lam : ℝ) + 3) * ddR (α : ℝ) ((t : ℝ) / s) u ≤ 2 ^ P * 2 ^ R :=
      mul_le_mul hE hdd (by linarith) hS.le
    have h3 : 2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u ≤ 2 ^ P * 2 ^ R :=
      mul_le_mul_of_nonneg_left hdd hS.le
    have h4 : 0 ≤ (2 : ℝ) ^ P * 2 ^ R := by positivity
    linarith

end J6Seg.TabBnd

