-- title:
--   Finite sum representation for ideal-span membership
-- statement:
--   Every element of the ideal generated by a set in a commutative semiring is a finite sum of generators multiplied by coefficients.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.mem_ideal_span_as_finset_sum
    {R : Type*} [CommSemiring R] (S : Set R) (p : R)
    (hp : p ∈ Ideal.span S) :
    ∃ (m : Nat) (x : Fin m → R) (q : Fin m → R),
      (∀ j, x j ∈ S) ∧ p = ∑ j, x j * q j := by sorry
