open MooreLiteralConnected in
theorem solution {G : Type*} [Group G] (Γ : Finset G) (hsymm : ∀ γ ∈ Γ, γ⁻¹ ∈ Γ)
    (hgen : Subgroup.closure (Γ : Set G) = ⊤) (A : Set G) :
    ∀ x ∈ A, ∀ y ∈ A, ∃ (l : ℕ) (p : Fin (l + 1) → G), p 0 = x ∧ p (Fin.last l) = y ∧
      ∀ i : Fin l, ∃ γ ∈ Γ, MooreFoelner.rightMul (p i.castSucc) γ = some (p i.succ) := by
  intro x _ y _
  obtain ⟨w, hw, hprod⟩ :=
    Submonoid.exists_list_of_mem_closure (mem_submonoid_closure Γ hsymm hgen (x⁻¹ * y))
  refine ⟨w.length, fun i => x * (w.take i).prod, ?_, ?_, ?_⟩
  · simp
  · simp [hprod]
  · intro i
    refine ⟨w[i], by exact_mod_cast hw _ (List.getElem_mem i.isLt), ?_⟩
    simp only [MooreFoelner.rightMul, Fin.val_castSucc, Fin.val_succ, Option.some.injEq]
    rw [List.prod_take_succ w i i.isLt, mul_assoc]
    rfl
