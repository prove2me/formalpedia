open MeasureTheory ProbabilityTheory Filter
open scoped BigOperators Topology InnerProductSpace
namespace BCN
variable {d : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]
  {P : Objective d} {C : MomentConstants} {prob : Measure Ω}
  [IsProbabilityMeasure prob] {α : ℕ → ℝ}

omit [IsProbabilityMeasure prob] in
lemma inner_integrable_of_memLp {X Y : Ω → Space d}
    (hX : MemLp X 2 prob) (hY : MemLp Y 2 prob) :
    Integrable (fun ω ↦ ⟪X ω, Y ω⟫_ℝ) prob := by
  have h := L2.integrable_inner (𝕜 := ℝ) (hX.toLp X) (hY.toLp Y)
  apply h.congr
  filter_upwards [hX.coeFn_toLp, hY.coeFn_toLp] with ω hx hy
  rw [hx, hy]

theorem Run.pointwise_descent (R : Run P C prob α) (k : ℕ) :
    ∀ᵐ ω ∂prob, loss R (k+1) ω ≤ loss R k ω -
      α k * ⟪gradient P.F (R.w k ω), R.g k ω⟫_ℝ +
      (α k ^ 2 * P.L / 2) * ‖R.g k ω‖ ^ 2 := by
  filter_upwards [R.update k] with ω hω
  have h := P.descent (R.w k ω) (R.w (k+1) ω)
  rw [hω, sub_sub_cancel_left, inner_neg_right, inner_smul_right,
    norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos (R.step_pos k)] at h
  dsimp only [loss]
  rw [hω]
  nlinarith [h]

theorem Run.conditional_descent_first (R : Run P C prob α) (k : ℕ) :
    ∀ᵐ ω ∂prob, prob[loss R (k+1) | R.history k] ω - loss R k ω ≤
      -(C.μ * α k) * gradSq R k ω + α k ^ 2 * P.L / 2 *
        prob[(fun ω ↦ ‖R.g k ω‖ ^ 2) | R.history k] ω := by
  let v : Ω → Space d := fun ω ↦ gradient P.F (R.w k ω)
  let z : Ω → ℝ := fun ω ↦ ⟪v ω, R.g k ω⟫_ℝ
  let q : Ω → ℝ := fun ω ↦ ‖R.g k ω‖ ^ 2
  have hz : Integrable z prob := inner_integrable_of_memLp
    (R.gradient_memLp k) (R.g_squareIntegrable k)
  have hq : Integrable q prob := (R.g_squareIntegrable k).norm.integrable_sq
  have hm := condExp_mono (m := R.history k) (R.loss_integrable (k+1))
    (((R.loss_integrable k).sub (hz.const_mul (α k))).add
      (hq.const_mul (α k ^ 2 * P.L / 2))) (R.pointwise_descent k)
  have hs := condExp_sub (R.loss_integrable k) (hz.const_mul (α k)) (R.history k)
  have ha := condExp_add ((R.loss_integrable k).sub (hz.const_mul (α k)))
    (hq.const_mul (α k ^ 2 * P.L / 2)) (R.history k)
  have hzlin := condExp_smul (μ := prob) (α k) z (R.history k)
  have hqlin := condExp_smul (μ := prob) (α k ^ 2 * P.L / 2) q (R.history k)
  have hpull := condExp_bilin_of_stronglyMeasurable_left (innerSL ℝ)
    (R.gradient_adapted k) hz ((R.g_squareIntegrable k).integrable (by norm_num))
  have hself := condExp_of_stronglyMeasurable (R.history.le k)
    (R.loss_adapted k) (R.loss_integrable k)
  filter_upwards [hm, hs, ha, hzlin, hqlin, hpull, R.angle k]
    with ω hm hs ha hzlin hqlin hpull hangle
  simp only [Pi.sub_def, Pi.add_def, Pi.smul_def, smul_eq_mul] at *
  change prob[z | R.history k] ω = ⟪v ω, prob[R.g k | R.history k] ω⟫_ℝ at hpull
  rw [ha, hs, hzlin, hqlin, hself, hpull] at hm
  dsimp only [v] at hm
  dsimp only [gradSq]
  nlinarith [mul_le_mul_of_nonneg_left hangle (R.step_pos k).le]

theorem MomentConstants.μG_pos (C : MomentConstants) : 0 < C.μG :=
  C.μ_pos.trans_le C.μ_le_μG

theorem MomentConstants.MG_pos (C : MomentConstants) : 0 < C.MG := by
  have h := C.μG_pos
  have hv := C.MV_nonneg
  dsimp only [MomentConstants.MG]
  positivity

theorem MomentConstants.μ_sq_le_MG (C : MomentConstants) : C.μ ^ 2 ≤ C.MG := by
  have h := C.μ_le_μG
  have := C.μ_pos
  have := C.MV_nonneg
  dsimp only [MomentConstants.MG]
  nlinarith

theorem Run.conditional_second_moment (R : Run P C prob α) (k : ℕ) :
    ∀ᵐ ω ∂prob, prob[(fun ω ↦ ‖R.g k ω‖ ^ 2) | R.history k] ω ≤
      C.M + C.MG * gradSq R k ω := by
  filter_upwards [R.variance k, R.mean_norm k] with ω hv hm
  have hμG := C.μG_pos.le
  have hn := norm_nonneg (prob[R.g k | R.history k] ω)
  have hg := norm_nonneg (gradient P.F (R.w k ω))
  have hs := sq_le_sq₀ hn (mul_nonneg hμG hg) |>.mpr hm
  dsimp only [gradSq, MomentConstants.MG]
  nlinarith

theorem Run.conditional_descent_second (R : Run P C prob α) (k : ℕ) :
    ∀ᵐ ω ∂prob,
      -(C.μ * α k) * gradSq R k ω + α k ^ 2 * P.L / 2 *
        prob[(fun ω ↦ ‖R.g k ω‖ ^ 2) | R.history k] ω ≤
      -(C.μ - α k * P.L * C.MG / 2) * α k * gradSq R k ω +
        α k ^ 2 * P.L * C.M / 2 := by
  filter_upwards [R.conditional_second_moment k] with ω hω
  have hL := P.L_pos
  have hh := mul_le_mul_of_nonneg_left hω
    (by positivity : 0 ≤ α k ^ 2 * P.L / 2)
  nlinarith


theorem Run.expected_descent (R : Run P C prob α) (k : ℕ) :
    (∫ ω, loss R (k+1) ω ∂prob) ≤ (∫ ω, loss R k ω ∂prob) -
      (C.μ - α k * P.L * C.MG / 2) * α k * expectedGradSq R k +
      α k ^ 2 * P.L * C.M / 2 := by
  have hcond : ∀ᵐ ω ∂prob, prob[loss R (k+1) | R.history k] ω ≤
      loss R k ω + (-(C.μ - α k * P.L * C.MG / 2) * α k) * gradSq R k ω +
        α k ^ 2 * P.L * C.M / 2 := by
    filter_upwards [R.conditional_descent_first k, R.conditional_descent_second k]
      with ω h1 h2
    linarith
  have hi := integral_mono_ae (integrable_condExp (f := loss R (k+1)))
    (((R.loss_integrable k).add ((R.gradSq_integrable k).const_mul (-(C.μ - α k * P.L * C.MG / 2) * α k))).add
      (integrable_const (α k ^ 2 * P.L * C.M / 2))) hcond
  have h1 := integral_add
    ((R.loss_integrable k).add
      ((R.gradSq_integrable k).const_mul (-(C.μ - α k * P.L * C.MG / 2) * α k)))
    (integrable_const (α k ^ 2 * P.L * C.M / 2))
  have h2 := integral_add (R.loss_integrable k)
    ((R.gradSq_integrable k).const_mul (-(C.μ - α k * P.L * C.MG / 2) * α k))
  simp only [Pi.add_apply] at hi h1 h2
  rw [integral_condExp (R.history.le k), h1, h2, integral_const_mul] at hi
  simp only [integral_const, probReal_univ, one_smul] at hi
  dsimp only [expectedGradSq]
  nlinarith [hi]

theorem Run.expected_descent_small (R : Run P C prob α) (k : ℕ)
    (hk : α k ≤ C.μ / (P.L * C.MG)) :
    (∫ ω, loss R (k+1) ω ∂prob) ≤ (∫ ω, loss R k ω ∂prob) -
      C.μ / 2 * α k * expectedGradSq R k + α k ^ 2 * P.L * C.M / 2 := by
  have h := (le_div_iff₀ (mul_pos P.L_pos C.MG_pos)).mp hk
  have hg := R.expectedGradSq_nonneg k
  have hα := (R.step_pos k).le
  have hcoef : C.μ / 2 * α k ≤ (C.μ - α k * P.L * C.MG / 2) * α k := by
    nlinarith
  have hprod := mul_le_mul_of_nonneg_right hcoef hg
  linarith [R.expected_descent k]


theorem ExpectedDescent :
  ∀ (d : ℕ) (P : Objective d) (C : MomentConstants)
    (Ω : Type*) [MeasurableSpace Ω] (prob : Measure Ω) [IsProbabilityMeasure prob]
    (α : ℕ → ℝ) (R : Run P C prob α) (k : ℕ),
    (∀ᵐ ω ∂prob, prob[loss R (k + 1) | R.history k] ω - loss R k ω ≤
      -(C.μ * α k) * gradSq R k ω + α k ^ 2 * P.L / 2 *
        prob[(fun ω ↦ ‖R.g k ω‖ ^ 2) | R.history k] ω) ∧
    (∀ᵐ ω ∂prob,
      -(C.μ * α k) * gradSq R k ω + α k ^ 2 * P.L / 2 *
        prob[(fun ω ↦ ‖R.g k ω‖ ^ 2) | R.history k] ω ≤
      -(C.μ - α k * P.L * C.MG / 2) * α k * gradSq R k ω +
        α k ^ 2 * P.L * C.M / 2) := by
  intro d P C Ω _ prob _ α R k
  exact ⟨R.conditional_descent_first k, R.conditional_descent_second k⟩

end BCN
end -- original EOF-open anonymous section
end BCNBundleModule3
