theorem solution
    {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (hA : AbelianSchemePropertyBundle R f) (L : RelativeGroupLaw R f)
    (n : ℕ) (hn3 : 3 ≤ n) (hn : IsUnit ((n : ℕ) : R)) (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (m : ℕ) (hm : m ≠ 0) (hord : NeronModelInfra.schemeHomOverNpow σ m = NeronModelInfra.schemeHomOverId f)
    (hfix : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ι : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of R))
      (x : SchemeHomOver ι f), L.IsTorsionPoint ι n x → NeronModelInfra.schemeHomOverComp x σ = x) :
    σ = NeronModelInfra.schemeHomOverId f := by
  apply Subtype.ext
  rw [NeronModelInfra.schemeHomOverId_coe]
  refine GoodReductionJacobian.AbelianSchemePropertyBundle.eq_id_of_one_comp_eq_of_forall_comp_eq_of_isAlgClosed
    hA L σ.1 σ.2 ?_ ?_
  ·
    letI := L.pointGroup (𝟙 (Spec (CommRingCat.of R)))
    have h := hσ (𝟙 _) (L.one _) (L.one _)
    rw [L.one_mul] at h
    have h1 : NeronModelInfra.schemeHomOverComp (L.one (𝟙 _)) σ = L.one (𝟙 _) :=
      mul_left_cancel (a := NeronModelInfra.schemeHomOverComp (L.one (𝟙 _)) σ) (h.symm.trans (mul_one _).symm)
    simpa using congrArg Subtype.val h1
  ·
    intro k _ _ x

    set ι : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of R) := x ≫ f with hι

    have hA' : AbelianSchemePropertyBundle k (pullback.snd f ι) := hA.baseChange_of_field ι
    haveI : IsProper (pullback.snd f ι) := hA'.proper
    haveI : GeometricallyIntegral (pullback.snd f ι) := hA'.geometricallyIntegral
    have hc' : (L.baseChange ι).IsCommutative :=
      GoodReductionJacobian.RelativeGroupLaw.isCommutative_of_isProper_of_geometricallyIntegral (L.baseChange ι)

    have hnk : (n : k) ≠ 0 := by
      obtain ⟨ψ, -⟩ := Spec.map_surjective ι
      have := hn.map ψ.hom
      rw [map_natCast] at this
      exact this.ne_zero

    have hfib : fibreRestrictAlong ι f f σ = NeronModelInfra.schemeHomOverId (pullback.snd f ι) := by
      refine GoodReductionJacobian.RelativeGroupLaw.eq_schemeHomOverId_of_schemeHomOverNpow_eq_of_forall_isTorsionPoint_of_three_le
        k (pullback.snd f ι) (L.baseChange ι) hc' hA' n hn3 hnk (fibreRestrictAlong ι f f σ) ?_ m hm ?_ ?_
      ·
        intro T t y z
        apply (RelativeGroupLaw.baseChangePointEquiv ι t).injective
        show RelativeGroupLaw.baseChangePointToBase ι _ = RelativeGroupLaw.baseChangePointToBase ι _
        rw [RelativeGroupLaw.baseChangePointToBase_comp_fibreRestrictAlong, RelativeGroupLaw.baseChangePointToBase_mul,
          hσ, RelativeGroupLaw.baseChangePointToBase_mul, RelativeGroupLaw.baseChangePointToBase_comp_fibreRestrictAlong,
          RelativeGroupLaw.baseChangePointToBase_comp_fibreRestrictAlong]
      ·
        rw [← fibreRestrictAlong_schemeHomOverNpow, hord, fibreRestrictAlong_schemeHomOverId]
      ·
        intro y hy
        have hb : 𝟙 (Spec (CommRingCat.of k)) ≫ ι = ι := Category.id_comp ι
        have hw₂ : (RelativeGroupLaw.baseChangePointToBase ι y).1 ≫ f = ι :=
          (RelativeGroupLaw.baseChangePointToBase ι y).2.trans hb
        let w : SchemeHomOver ι f := ⟨(RelativeGroupLaw.baseChangePointToBase ι y).1, hw₂⟩
        have hw : L.IsTorsionPoint ι n w := by
          show L.nsmul ι n w = L.one ι
          apply Subtype.ext
          rw [nsmul_val_congr L (RelativeGroupLaw.baseChangePointToBase ι y) hw₂ n, one_val_congr L hb,
            ← baseChangePointToBase_nsmul, ← RelativeGroupLaw.baseChangePointToBase_one ι L (𝟙 _)]
          exact congrArg (fun z => (RelativeGroupLaw.baseChangePointToBase ι z).1) hy
        have hwσ : (y.1 ≫ pullback.fst f ι) ≫ σ.1 = y.1 ≫ pullback.fst f ι := by
          have := congrArg Subtype.val (hfix k ι w hw)
          simpa [w] using this
        apply Subtype.ext
        apply pullback.hom_ext
        · rw [NeronModelInfra.schemeHomOverComp_coe, Category.assoc, fibreRestrictAlong_coe_comp_fst, ← Category.assoc]
          exact hwσ
        · rw [NeronModelInfra.schemeHomOverComp_coe, Category.assoc, fibreRestrictAlong_coe_comp_snd]

    have hσ'1 : (fibreRestrictAlong ι f f σ).1 = 𝟙 _ := by
