      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(27/10000:ℝ)^2/24 < 2*(539/2000:ℝ)/(1-(539/2000:ℝ)^2)^2)
