  obtain ⟨a, rfl⟩ := hS
  obtain ⟨b, rfl⟩ := hT
  have hkernel :
      E.inclusion (Multiplicative.ofAdd a) *
        E.inclusion (Multiplicative.ofAdd b) =
      E.inclusion (Multiplicative.ofAdd b) *
        E.inclusion (Multiplicative.ofAdd a) := by
    rw [← E.inclusion.map_mul, ← E.inclusion.map_mul]
    congr 1
