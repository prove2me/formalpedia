theorem dyadicSearch_numerator_lt (test : ℕ → ℕ → Bool) (k : ℕ) :
    (dyadicSearch test k).1 < 2 ^ k := by
  induction k with
  | zero => simp [dyadicSearch]
  | succ k ih =>
    simp only [dyadicSearch, pow_succ]
    cases test (2 * (dyadicSearch test k).1 + 1) (k + 1) <;> simp_all <;> omega

