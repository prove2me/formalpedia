-- Source module: Solutions.J6SegTab
/-!
# Segmented inverse (S2): construction of the constant tables

`mkTables P R s t α` (computable) fills the tables of `J6SegAlg` with
* `di u = expNeg P s (α²(t-s)u²)` (`≈ 2^P e^{-πα²θu²}`),
* `dd u = expPos (P+R) s (α²(t-s)u²) R` (`≈ 2^P e^{πα²θu²}`, needs `e^{πα²θu²} ≤ 2^R`),
* `gam`: `(q;q)_u` by the recurrence `Γ_{u+1} = Γ_u (1 - q^{u+1})` (`q^k` by `expNeg`),
* `gi u = 2^P / Γ_u` (`fdiv`), `ap/am c h = (-1)^h e^{-πα²(σ ± 2β_c)h} / Γ_h`,
* `cpl i h = expNeg P s² (α² K_{i,h})` (the entries of `E`, as in `Eapprox`).

`mkTables_ok`: `TabOK` with `E = 3λ + 3` and `Dm = D_{λ-1}`, for blocks of length `≤ λ`, as soon as
`200 (3λ+1) ≤ 2^P` and `D_{λ-1} ≤ 2^R`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section tab
variable {P R s t α : ℕ}

lemma expNeg_err (hk : 0 < s) (j : ℕ) {x : ℝ} (hx : x = π * j / s) :
    |(expNeg P s j : ℝ) - 2 ^ P * exp (-x)| ≤ 1 := by
  rw [hx]; exact expNeg_bound P s j hk

lemma sigma_ge (hs : 0 < s) (hst : s ≤ t) : 1 ≤ (t : ℝ) / s := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst

lemma bOf_cast_plus (hs : 0 < s) (hst : s ≤ t) (c : ℕ) :
    (((t : ℤ) + 2 * bOf s t c).toNat : ℝ) = (t : ℝ) + 2 * (bOf s t c : ℝ) := by
  obtain ⟨h1, h2⟩ := bOf_bounds s t hs (c : ℤ)
  have : (0 : ℤ) ≤ t + 2 * bOf s t c := by omega
  rw [show (((t : ℤ) + 2 * bOf s t c).toNat : ℝ) = (((t : ℤ) + 2 * bOf s t c).toNat : ℤ) by
    push_cast; rfl, Int.toNat_of_nonneg this]
  push_cast; ring

lemma bOf_cast_minus (hs : 0 < s) (hst : s ≤ t) (c : ℕ) :
    (((t : ℤ) - 2 * bOf s t c).toNat : ℝ) = (t : ℝ) - 2 * (bOf s t c : ℝ) := by
  obtain ⟨h1, h2⟩ := bOf_bounds s t hs (c : ℤ)
  have : (0 : ℤ) ≤ t - 2 * bOf s t c := by omega
  rw [show (((t : ℤ) - 2 * bOf s t c).toNat : ℝ) = (((t : ℤ) - 2 * bOf s t c).toNat : ℤ) by
    push_cast; rfl, Int.toNat_of_nonneg this]
  push_cast; ring

/-- **The constructed tables are accurate** (`TabOK` with `E = 3λ + 3`, `Dm = D_{λ-1}`). -/
theorem mkTables_ok_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) {lam : ℕ}
    (hl : 1 ≤ lam) (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R) (B : Blocks)
    (hlen : ∀ i < s, B.len i ≤ lam) :
    TabOK P s t α B (mkTables P R s t α) (3 * lam + 3) (ddR (α : ℝ) ((t : ℝ) / s) (lam - 1)) := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  have hS := two_pow_pos' P
  have hlam1 : (1 : ℝ) ≤ lam := by exact_mod_cast hl
  have hE1 : (1 : ℝ) ≤ 3 * (lam : ℝ) + 3 := by linarith
  have hsub : ((t - s : ℕ) : ℝ) = (t : ℝ) - s := by rw [Nat.cast_sub hst]
  -- exponent of `D_u`
  have hD : ∀ u : ℕ, π * ((α ^ 2 * (t - s) * u ^ 2 : ℕ) : ℝ) / s =
      π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) * (u : ℝ) ^ 2 := by
    intro u; push_cast; rw [hsub]; field_simp
  have hu_le : ∀ i < s, ∀ u < B.len i, (u : ℝ) ≤ lam - 1 := by
    intro i hi u hu
    have := hlen i hi
    have : u ≤ lam - 1 := by omega
    have h' : ((u : ℕ) : ℝ) ≤ ((lam - 1 : ℕ) : ℝ) := by exact_mod_cast this
    rw [Nat.cast_sub hl] at h'; simpa using h'
  refine ⟨fun i hi => ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_⟩
  · -- di
    intro u hu
    have h := expNeg_err (P := P) hs (α ^ 2 * (t - s) * u ^ 2) (hD u).symm
    refine h.trans (by linarith)
  · -- dd
    intro u hu
    have hmono : ddR (α : ℝ) ((t : ℝ) / s) u ≤ 2 ^ R := by
      refine (ddR_mono hσ ?_).trans hR
      have := hlen i hi; omega
    have h := expPos_bound (P + R) s (α ^ 2 * (t - s) * u ^ 2) R hs
      (by rw [hD u]; exact hmono) (by omega)
    rw [hD u] at h
    have e : (2 : ℝ) ^ (P + R) * ((2 ^ R)⁻¹ * exp (π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) *
        (u : ℝ) ^ 2)) = 2 ^ P * ddR (α : ℝ) ((t : ℝ) / s) u := by
      rw [pow_add, ddR]; field_simp
    rw [e] at h
    have hd1 := one_le_ddR (α := (α : ℝ)) hσ u
    refine h.trans ?_
    nlinarith
  · -- gam
    intro u hu
    refine (gamI_err (P := P) hs hst hα hP u).trans ?_
    have := hu_le i hi u hu; linarith
  · -- gi
    intro u hu
    have := hu_le i hi u hu
    refine (giI_err (P := P) hs hst hα hP (u := u) (by nlinarith)).trans (by linarith)
  · -- ap
    intro h hh
    have hhl := hu_le i hi h hh
    have hb := bOf_cast_plus hs hst (B.st i)
    have hex : π * ((α ^ 2 * ((t : ℤ) + 2 * bOf s t (B.st i)).toNat * h : ℕ) : ℝ) / s =
        π * (α : ℝ) ^ 2 * ((t : ℝ) / s + 2 * ((bOf s t (B.st i) : ℝ) / s)) * h := by
      push_cast [hb]; field_simp
    have hX := expNeg_err (P := P) hs (α ^ 2 * ((t : ℤ) + 2 * bOf s t (B.st i)).toNat * h) hex.symm
    have hpos : 0 ≤ π * (α : ℝ) ^ 2 * ((t : ℝ) / s + 2 * ((bOf s t (B.st i) : ℝ) / s)) * h := by
      rw [← hex]; positivity
    have h1 := apm_err (P := P) hs hst hα hP (h := h) (by linarith) hX (exp_pos _).le
      (Real.exp_le_one_iff.2 (by linarith))
    have e : aplus (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) h =
        (-1) ^ h * (exp (-(π * (α : ℝ) ^ 2 * ((t : ℝ) / s + 2 * ((bOf s t (B.st i) : ℝ) / s)) * h)) *
          giR (α : ℝ) ((t : ℝ) / s) h) := by
      simp only [aplus, giR, gamR]; ring
    rw [e]
    exact h1.trans (by linarith)
  · -- am
    intro h hh
    have hhl := hu_le i hi h hh
    have hb := bOf_cast_minus hs hst (B.st i)
    have hex : π * ((α ^ 2 * ((t : ℤ) - 2 * bOf s t (B.st i)).toNat * h : ℕ) : ℝ) / s =
        π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 2 * ((bOf s t (B.st i) : ℝ) / s)) * h := by
      push_cast [hb]; field_simp
    have hX := expNeg_err (P := P) hs (α ^ 2 * ((t : ℤ) - 2 * bOf s t (B.st i)).toNat * h) hex.symm
    have hpos : 0 ≤ π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 2 * ((bOf s t (B.st i) : ℝ) / s)) * h := by
      rw [← hex]; positivity
    have h1 := apm_err (P := P) hs hst hα hP (h := h) (by linarith) hX (exp_pos _).le
      (Real.exp_le_one_iff.2 (by linarith))
    have e : aminus (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) h =
        (-1) ^ h * (exp (-(π * (α : ℝ) ^ 2 * ((t : ℝ) / s - 2 * ((bOf s t (B.st i) : ℝ) / s)) * h)) *
          giR (α : ℝ) ((t : ℝ) / s) h) := by
      simp only [aminus, giR, gamR]; ring
    rw [e]
    exact h1.trans (by linarith)
  · -- coupling entries
    intro i hi h hh
    obtain ⟨_, _, h0, _⟩ := mem_Hset hh
    have hK := eKz_ge s t hs hst (i : ℤ) h
    have hK0 : 0 ≤ eKz s t i h := le_trans (by
      have : 0 ≤ |h| * (|h| - 1) := mul_nonneg (abs_nonneg _) (by
        have : 1 ≤ |h| := Int.one_le_abs h0
        omega)
      positivity) hK
    have hs2 : 0 < s ^ 2 := by positivity
    have hex : π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ) =
        π * (α : ℝ) ^ 2 * (eKz s t i h : ℝ) / (s : ℝ) ^ 2 := by
      have : (((eKz s t i h).toNat : ℕ) : ℝ) = (eKz s t i h : ℝ) := by
        rw [show (((eKz s t i h).toNat : ℕ) : ℝ) = (((eKz s t i h).toNat : ℤ) : ℝ) by rfl,
          Int.toNat_of_nonneg hK0]
      push_cast [this]; ring
    have h1 := expNeg_bound P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) hs2
    rw [hex] at h1
    have e : eEx s t α i h = exp (-(π * (α : ℝ) ^ 2 * (eKz s t i h : ℝ) / (s : ℝ) ^ 2)) := by
      simp [eEx, h0]
    show |(expNeg P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) : ℝ) - 2 ^ P * eEx s t α i h| ≤ _
    rw [e]; exact h1.trans (by linarith)
  · -- `Dm`
    intro i hi u hu
    exact ddR_mono hσ (by have := hlen i hi; omega)

end tab

