theorem tBox_eq {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R154.dP n = D + 1) :
    tBox (D + 1) (ℓP n - 1) (bLn n) = tBD n D := by
  have hl := ell_pos hn
  funext i
  simp only [tBox, tBD, tP_eq, if_pos i.2, bLn, decide_eq_true_eq]
  have e : IntMul.OpenAI.R154.rP n = 2 ^ (ℓP n - 1) * 2 := by
    rw [IntMul.OpenAI.R154.rP, ← pow_succ]; congr 1; omega
  split_ifs <;> rw [e]; simp

theorem digG_getD (b e M S x κ : ℕ) (hM : M ≤ S) (hκ : κ < S) :
    (digG b e M S x).getD κ 0 = ((dgt b M x κ : ℤ) * 2 ^ e, 0) := by
  unfold digG
  by_cases h : κ < M
  · rw [List.getD_append _ _ _ _ (by simp [chk]; omega)]
    simp [chk, dgt, h, List.getD_eq_getElem?_getD]
  · rw [List.getD_append_right _ _ _ _ (by simp [chk]; omega)]
    simp [chk, dgt, h, List.getD_eq_getElem?_getD, List.getElem?_replicate]
    split_ifs <;> first | rfl | omega

theorem hsw_of {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R154.dP n = D + 1) (hst : ∀ i, sBD n D i ≤ tBD n D i) :
    ∀ j < D + 1, srcN n j ≤ tP (D + 1) (ℓP n - 1) (bLn n) j := by
  intro j hj
  have h1 := hst ⟨j, hj⟩
  have e := congrFun (tBox_eq hn hD) ⟨j, hj⟩
  simp only [tBox, sBD] at e h1
  rw [e]; exact h1

/-- **The digits after `Φ`.** -/
theorem phiF_rep {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R154.dP n = D + 1) [∀ i, NeZero (sBD n D i)]
    (hst : ∀ i, sBD n D i ≤ tBD n D i) (H : CrtOK (D + 1) (srcN n) (muN n))
    (b e M S x : ℕ) (hMS : M ≤ S) (hS : S = ∏ i : Fin (D + 1), srcN n i) (zs : List GI)
    (hz : gflat zs = PhiD (ℓP n - 1) (D + 1) (bLn n) (srcN n) (muN n) (gflat (digG b e M S x))) :
    RepPad (pP n) (sBD n D) (tBD n D) zs
      (fun k => (2 : ℂ) ^ e / 2 ^ pP n * (dgt b M x ((NLogN.KFM.eB (srcN n) (muN n) H).symm k).val : ℂ)) := by
  obtain ⟨hl, hpz, hv⟩ := phiD_pad (h := ℓP n - 1) (bL := bLn n) (sF := srcN n) (μ := muN n) (H := H)
    (hsw_of hn hD hst) (gflat (digG b e M S x)) hz
  rw [tBox_eq hn hD] at hl hpz hv
  refine (repPad_iff hst _).2 ⟨⟨hl, hpz⟩, ?_⟩
  haveI := sBox_ne (srcN n) (muN n) H
  haveI : NeZero (∏ i, sBox (D + 1) (srcN n) i) :=
    ⟨Finset.prod_ne_zero_iff.2 fun i _ => (sBox_ne (srcN n) (muN n) H i).out⟩
  funext k
  have hvk : zs.getD (encode (List.ofFn (tBD n D)) (kL k)) 0 =
      ((gflat (digG b e M S x)).getD (2 * ((NLogN.KFM.eB (srcN n) (muN n) H).symm k).val) 0,
        (gflat (digG b e M S x)).getD (2 * ((NLogN.KFM.eB (srcN n) (muN n) H).symm k).val + 1) 0) := hv k
  have hκ : ((NLogN.KFM.eB (srcN n) (muN n) H).symm k).val < S := by
    rw [hS]; exact ZMod.val_lt _
  simp only [funP]
  rw [hvk, gflat_getD_even, gflat_getD_odd, digG_getD b e M S x _ hMS hκ]
  simp only [toC]
  push_cast
  ring

end

