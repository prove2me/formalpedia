-- title:
--   Lemma 2 — the chain-generated subposet and its maximal chains
-- statement:
--   Let $P=(X,\preceq)$ be a finite poset, $X'\subseteq X$, and $\mathcal C'\subseteq\mathcal C$ a family of maximal chains closed under both splices whenever two of its chains meet at a point of $X'$. On $X'$, define $x\preceq_{\mathcal C'}y$ when $x=y$, or when some $C\in\mathcal C'$ contains both points and $x\prec y$ in $P$. Then $(X',\preceq_{\mathcal C'})$ is a poset. Moreover, every maximal chain $C$ of this new poset with at least two points is the restriction of some chain in $\mathcal C'$:
--   $$|C|\ge2\quad\Longrightarrow\quad\exists D\in\mathcal C',\ C=D\cap X'.$$
--
--   This links the order generated by a selected chain family to the original poset's maximal chains.
--
--   **Formalization Note** A maximal chain in the generated poset is represented by a finite subset maximal among its chains. The theorem does not require $X'$ to be nonempty, as the source permits an arbitrary subset; its second conclusion concerns chains of size at least two.
-- source:
--   Dahan, Amin & Jaillet, arXiv:1811.08516v3, p. 6, Lemma 2; proof pp. 34–35

import Mathlib
import Definitions.Def_PosetMarginals_Chains_Model

open Classical

namespace PosetMarginals.Chains

/-- Dahan, Amin and Jaillet, Lemma 2, p. 6. -/
theorem lemma_2 {α : Type*} [PartialOrder α] [Fintype α]
    (X' : Finset α) (C' : Finset (Finset α))
    (hC' : C' ⊆ maxChains α) (h : PreservesDecomp X' C') :
    IsPosetOn X' C' ∧
      ∀ C : Finset α, IsMaxChainOf X' C' C → 2 ≤ C.card →
        ∃ D ∈ C', C = D ∩ X' := by sorry

end PosetMarginals.Chains
