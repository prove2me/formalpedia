variable {σ : Type*}
lemma lift_finset {ι : Type*} [DecidableEq ι] (w : σ → ℕ) (f : ι → MvPolynomial σ ℝ)
    (μ : ι → σ →₀ ℕ) (hdisj : Pairwise fun l l' => Disjoint (μ l).support (μ l').support)
    (hf : ∀ l, TopTerm w (f l) (μ l)) (T : Finset ι) :
    ∀ h ∈ Ideal.span (f '' (T : Set ι)), ∀ d, DegLE w d h →
      weightedHomogeneousComponent w d h ∈ MI μ T := by
  induction T using Finset.induction_on with
  | empty =>
    intro h hh d _
    simp only [Finset.coe_empty, Set.image_empty, Ideal.span_empty, Ideal.mem_bot] at hh
    simp [hh]
  | insert N T hN IH =>
    intro h hh d hd
    rw [Finset.coe_insert, Set.image_insert_eq, Ideal.mem_span_insert] at hh
    obtain ⟨a, z, hz, rfl⟩ := hh
    rw [add_comm] at hd ⊢
    have hdisjT : ∀ l ∈ T, Disjoint (μ N).support (μ l).support :=
      fun l hl => hdisj (fun e => hN (e ▸ hl))
    refine lift_insert w f μ hf T N hdisjT IH d
      (∑ s ∈ z.support, Finsupp.weight w s +
        ∑ s ∈ a.support, (Finsupp.weight w s + Finsupp.weight w (μ N))) z a hz ?_ ?_ hd
    · intro s hs
      exact (Finset.single_le_sum (fun _ _ => Nat.zero_le _) hs).trans (Nat.le_add_right _ _)
    · intro s hs
      exact (Finset.single_le_sum (f := fun s => Finsupp.weight w s + Finsupp.weight w (μ N))
        (fun _ _ => Nat.zero_le _) hs).trans (Nat.le_add_left _ _)

/-- Lifting (Buchberger's coprime criterion, graded form). -/
theorem lift {ι : Type*} [Fintype ι] (w : σ → ℕ) (f : ι → MvPolynomial σ ℝ) (μ : ι → σ →₀ ℕ)
    (hdisj : Pairwise fun l l' => Disjoint (μ l).support (μ l').support)
    (hf : ∀ l, TopTerm w (f l) (μ l)) (h : MvPolynomial σ ℝ)
    (hh : h ∈ Ideal.span (Set.range f)) (d : ℕ) (hd : DegLE w d h) :
    weightedHomogeneousComponent w d h ∈ monIdeal μ := by
  classical
  have := lift_finset w f μ hdisj hf Finset.univ h (by simpa using hh) d hd
  rwa [MI, Finset.coe_univ, Set.image_univ] at this

end SoSLinAlg.WeakRank.Dev.Leaf.PartA
