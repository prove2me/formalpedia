/-! ## Negative-side Taylor polynomial -/

/-- Negative-side Taylor polynomial with prescribed jet `L`. -/
noncomputable def taylorPoly (L : ℕ → ℝ) (n : ℕ) : ℝ → ℝ :=
  fun x => ∑ k ∈ Finset.range (n + 1), L k / (k.factorial : ℝ) * x ^ k

/-! ## The flat extension -/

/-- Extend a function on `(0, ε)` by zero to the left of the origin. -/
noncomputable def flatExt (h : ℝ → ℝ) : ℝ → ℝ := fun x => if 0 < x then h x else 0

