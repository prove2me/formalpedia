-- title:
--   Orders over a place sum to the order of the field norm
-- statement:
--   For a finite extension E/K, where K is the intermediate field generated by t, the sum of the normalized orders of f over places of E equals the sum of the normalized orders of its field norm over places of K. The geometric route identifies places with closed points on the normal projective models and applies the local norm formula; the residue degree factors are one because the constant field is algebraically closed. This is an independent local-to-global extension step, not a consequence of finite support alone.
-- source:
--   openai/math Approximation FibreNormalRigidity: nonconstant fibre coordinates imply quantitative contact bound.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.Algebra.BigOperators.Finprod
import Mathlib.Algebra.FiniteSupport.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.FieldTheory.IsAlgClosed.Basic

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.polynomialCurveOrder_sum_eq_norm
    (E : Type) [Field E] [Algebra Complex E]
    (t : E)
    (hfinite : FiniteDimensional (IntermediateField.adjoin Complex {t}) E)
    (ht : Transcendental Complex t) (f : E) :
    (∑ᶠ nu : PolynomialCurvePlace E,
      (polynomialCurveOrder nu f : Real)) =
      ∑ᶠ nu : PolynomialCurvePlace (IntermediateField.adjoin Complex {t}),
        (polynomialCurveOrder nu
          (Algebra.norm (IntermediateField.adjoin Complex {t}) f :
            IntermediateField.adjoin Complex {t}) : Real) := by
  sorry
