theorem coe_unit_inv' {F : Type*} [Field F] {S : ValuationSubring F} (u : Sˣ) :
    (((u⁻¹ : Sˣ) : S) : F) = ((u : S) : F)⁻¹ := by
  have h1 : ((u : S) : F) * (((u⁻¹ : Sˣ) : S) : F) = 1 := by
