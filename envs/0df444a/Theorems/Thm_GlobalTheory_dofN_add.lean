variable {R : Type} [CommRing R] {d n : ℕ}

theorem GlobalTheory.dofN_add (F : Fin d → PS R 2 d) (b : Fin n) (u : Fin d → R) (f g : PS R n d) :
    DofN F b u (f + g) = DofN F b u f + DofN F b u g := by sorry
