-- title:
--   Finite witnesses for powers in spans of a restricted range
-- statement:
--   For finitely many elements, if each has some positive power in the ideal generated by a restricted range of generators, then one finite selection of those restricted generators suffices for all the elements.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

universe u v w

theorem OAI.PiExponent.FormalInterpolation.finite_power_witnesses_of_span_range
    {R : Type u} [CommSemiring R]
    {ι : Type v} [Fintype ι] [DecidableEq ι]
    {α : Type w}
    (x : ι → R) (P : α → Prop) (g : α → R)
    (h : ∀ i : ι, ∃ e : Nat, 0 < e ∧
      x i ^ e ∈ Ideal.span (Set.range (fun a : {a // P a} => g a.1))) :
    ∃ k : Nat, ∃ f : Fin k → {a // P a},
      ∀ i : ι, ∃ e : Nat, 0 < e ∧
        x i ^ e ∈ Ideal.span (Set.range (fun j : Fin k => g (f j).1)) := by sorry
