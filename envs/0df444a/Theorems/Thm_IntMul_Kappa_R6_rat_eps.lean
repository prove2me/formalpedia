--   ```lean
--   theorem IntMul.Kappa.R6.rat_eps (P : Prm) (hP : P.Ok) (κ : ℝ) (hκ : κ < P.gap) :
--       ∃ q : ℚ, (({ P with ε := (q : ℝ) } : Prm)).Ok ∧ κ < ({ P with ε := (q : ℝ) } : Prm).gap
--   ```
