variable {d : ℕ}

/-- `A_h(x) ⊆ B̄_{(h/2)√d}(x)`: the observation closing the proof of Lemma 2.7. -/
lemma solution {h : ℝ} (u : EuclideanSpace ℝ (Fin d)) :
    QFS.cube h u ⊆ closedBall u (h / 2 * Real.sqrt d) := by
  intro x hx
  rw [Metric.mem_closedBall, dist_eq_norm]
  calc ‖x - u‖ ≤ Real.sqrt d * QFS.infNorm (x - u) := QFS.norm_le_sqrt_dim_mul_infNorm _
    _ ≤ Real.sqrt d * (h / 2) := by
        exact mul_le_mul_of_nonneg_left (le_of_lt hx) (Real.sqrt_nonneg _)
    _ = h / 2 * Real.sqrt d := by ring
