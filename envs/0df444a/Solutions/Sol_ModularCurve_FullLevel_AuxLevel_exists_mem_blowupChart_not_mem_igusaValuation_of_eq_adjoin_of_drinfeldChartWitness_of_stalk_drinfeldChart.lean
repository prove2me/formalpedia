    dsimp only at hJ'
    rw [hJ', Ideal.mem_sInf]
    rintro J' ⟨γ, hγq, hγ0, τ, hτ, hpres, rfl⟩
    rw [Ideal.mem_comap]
    have hτi : ((τ : ↥K →+* ↥K).restrict (chartAlgFin A (↥K) j) (chartAlgFin A (↥K) j) hpres) iC = iC := by
      apply Subtype.ext
      show τ (iC : ↥K) = iC
      rw [hiC_coe, map_sub, hfix γ hγq hγ0 τ hτ, IsScalarTower.algebraMap_apply A L ↥K a₀, AlgEquiv.commutes]
    rw [hτi, Ideal.mem_comap]
    convert hmkSh using 2 <;> first | (with_reducible_and_instances rfl) | rfl | exact hHC | (simp only [RingHom.comp_apply]; exact hHC) | (simp only [RingHom.comp_apply, iC]; exact hHC) | skip
  let b : ↥K := (iC : ↥K) * (algebraMap A ↥K ϖt)⁻¹
  have hbϖt : b * algebraMap A ↥K ϖt = (iC : ↥K) := by
    simp only [b]; field_simp
  refine ⟨b, ?_, ?_⟩
  ·
    rw [hB, Subalgebra.mem_restrictScalars]
    exact Algebra.subset_adjoin ⟨iC, hiJ, hbϖt⟩

  intro V hVA hϖV hjV hp hbV
  have hAV : ∀ a : A, algebraMap A ↥K a ∈ V := fun a => by
    rw [IsScalarTower.algebraMap_apply A L ↥K]; exact (hVA _).mpr ⟨a, rfl⟩
  let V' : Subalgebra A ↥K :=
    { carrier := V, mul_mem' := fun ha hb => V.mul_mem _ _ ha hb, add_mem' := fun ha hb => V.add_mem _ _ ha hb,
