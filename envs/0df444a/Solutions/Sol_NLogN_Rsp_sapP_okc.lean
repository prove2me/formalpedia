theorem split_states {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS) (s : IState HS)
    (U : List (ℤ × ℤ)) (R : List Item) (hX : s.G X = gints U ++ R) (hn : n.eval s = U.length) :
    RepStates C n (NLogN.RS.seq (NLogN.Rsp.mv1 X A) (NLogN.Rsp.mv1 X B)) s (spSt X A B s U R) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, NLogN.Rsp.mv1, hd.xc.symm, hd.ac.symm, hd.bc.symm]
  h0 := by
    apply IState.ext' _ (by simp [spSt]) (by simp [spSt])
    intro x; simp only [spSt, IState.upd_G]
    by_cases h1 : x = X
    · subst h1; simp [hd.xa, hd.xb, hX]
    by_cases h2 : x = A
    · subst h2; simp [hd.ab]
    by_cases h3 : x = B
    · subst h3; simp
    simp [h1, h2, h3]
  hG := fun k => by simp [spSt, hd.xc.symm, hd.ac.symm, hd.bc.symm]
  step := by
    intro k hk
    rw [hn, Int.toNat_natCast] at hk
    exact (split_step hd s U R s _ k hk).2.1

theorem splitP_all {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS) (hnc : n.Clean)
    (s : IState HS) (U : List (ℤ × ℤ)) (R : List Item) (hX : s.G X = gints U ++ R)
    (hno : n.ok s) (hn : n.eval s = U.length) :
    (splitP X A B C n).ok s ∧
      (splitP X A B C n).run s = ((s.upd X R).upd A (ints (U.map Prod.fst).reverse ++ s.G A)).upd B
        (ints (U.map Prod.snd).reverse ++ s.G B) := by
  have H := split_states hd n s U R hX hn
  refine ⟨H.ok hd.c5 hnc hno ?_, ?_⟩
  · intro k hk
    rw [hn, Int.toNat_natCast] at hk
    exact (split_step hd s U R s _ k hk).1
  · rw [splitP, H.run, hn, Int.toNat_natCast]
    simp [spSt]

theorem splitP_cost {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS)
    (s : IState HS) (U : List (ℤ × ℤ)) (R : List Item) (hX : s.G X = gints U ++ R)
    (hn : n.eval s = U.length) (Bd : ℕ) (hU : ∀ z ∈ U, zsz z.1 ≤ Bd ∧ zsz z.2 ≤ Bd)
    (hnl : n.Lin) (hnb : n.Bnd s Bd) :
    (splitP X A B C n).cost s ≤ (n.size + 1) * 2000 * (Bd + 2) + U.length * (20000 * (Bd + 2)) + 32 := by
  have H := split_states hd n s U R hX hn
  have := H.cost_le_lin Bd (2 * (4000 * (Bd + 2) + 2 * Bd + 2)) hnl hnb ?_
  · rw [hn, Int.toNat_natCast] at this
    have h2 : U.length * (2 * (4000 * (Bd + 2) + 2 * Bd + 2) + 8000 * (Bd + 2) + 30) ≤
        U.length * (20000 * (Bd + 2)) := Nat.mul_le_mul_left _ (by omega)
    rw [splitP]; exact le_trans this (by omega)
  intro k hk
  rw [hn, Int.toNat_natCast] at hk
  have hb := hU _ (List.getElem_mem hk)
  exact (split_step hd s U R s _ k hk).2.2 Bd hb.1 hb.2

theorem merge_step {X A B C : Fin HS} (hd : Dist4 X A B C) (s : IState HS)
    (LA LB : List ℤ) (RA RB : List Item) (S0 : IState HS) (N j : ℕ) (hjA : j < LA.length)
    (hjB : j < LB.length) :
    let t := withCtr C S0 N j (mgSt X A B s LA LB RA RB j)
    (NLogN.RS.seq (NLogN.Rsp.mv1 B X) (NLogN.Rsp.mv1 A X)).ok t ∧
      (NLogN.RS.seq (NLogN.Rsp.mv1 B X) (NLogN.Rsp.mv1 A X)).run t = withCtr C S0 N j (mgSt X A B s LA LB RA RB (j + 1)) ∧
      ∀ Bd, zsz LA[j] ≤ Bd → zsz LB[j] ≤ Bd →
        (NLogN.RS.seq (NLogN.Rsp.mv1 B X) (NLogN.Rsp.mv1 A X)).cost t ≤ 2 * (4000 * (Bd + 2) + 2 * Bd + 2) := by
  intro t
  have hdA : LA.drop j = LA[j] :: LA.drop (j + 1) := List.drop_eq_getElem_cons hjA
  have hdB : LB.drop j = LB[j] :: LB.drop (j + 1) := List.drop_eq_getElem_cons hjB
  have hjz : j < (LA.zip LB).length := by simp; omega
  have htk : (LA.zip LB).take (j + 1) = (LA.zip LB).take j ++ [(LA[j], LB[j])] := by
    rw [← List.take_concat_get' _ j hjz]; simp
  have tB : t.G B = .int LB[j] :: (ints (LB.drop (j + 1)) ++ RB) := by
    simp only [t, withCtr, mgSt, IState.upd_G, if_neg hd.xb.symm, if_neg hd.bc, if_true]
    rw [hdB]; rfl
  have m1 := mv1_all hd.xb.symm hd.b5 hd.x5 t _ _ tB
  have tA : ((t.upd B (ints (LB.drop (j + 1)) ++ RB)).upd X (.int LB[j] :: t.G X)).G A =
      .int LA[j] :: (ints (LA.drop (j + 1)) ++ RA) := by
    simp only [t, withCtr, mgSt, IState.upd_G, if_neg hd.xa.symm, if_neg hd.ab, if_neg hd.ac,
      if_true]
    rw [hdA]; rfl
  have m2 := mv1_all hd.xa.symm hd.a5 hd.x5 _ _ _ tA
  refine ⟨⟨m1.1, ?_⟩, ?_, ?_⟩
  · rw [m1.2.1]; exact m2.1
  · rw [run_seq, m1.2.1, m2.2.1]
    apply IState.ext' _ (by simp [t, withCtr, mgSt]) (by simp [t, withCtr, mgSt])
    intro x
    simp only [IState.upd_G, t, withCtr, mgSt]
    by_cases h1 : x = X
    · subst h1; rw [htk]; simp [hd.xa, hd.xb, hd.xc]
    by_cases h2 : x = A
    · subst h2; simp [hd.xa.symm, hd.ab, hd.ac, hdA]
    by_cases h3 : x = B
    · subst h3; simp [hd.xb.symm, hd.ab.symm, hd.bc]
    simp [h1, h2, h3]
  · intro Bd h1 h2
    simp only [RS.cost]
    have c1 := m1.2.2 Bd h2
    rw [m1.2.1]
    have c2 := m2.2.2 Bd h1
    omega

theorem merge_states {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS) (s : IState HS)
    (LA LB : List ℤ) (RA RB : List Item) (hA : s.G A = ints LA ++ RA) (hB : s.G B = ints LB ++ RB)
    (hl : LA.length = LB.length) (hn : n.eval s = LA.length) :
    RepStates C n (NLogN.RS.seq (NLogN.Rsp.mv1 B X) (NLogN.Rsp.mv1 A X)) s (mgSt X A B s LA LB RA RB) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, NLogN.Rsp.mv1, hd.xc.symm, hd.ac.symm, hd.bc.symm]
  h0 := by
    apply IState.ext' _ (by simp [mgSt]) (by simp [mgSt])
    intro x; simp only [mgSt, IState.upd_G]
    by_cases h1 : x = X
    · subst h1; simp
    by_cases h2 : x = A
    · subst h2; simp [hd.ab, hd.xa.symm, hA]
    by_cases h3 : x = B
    · subst h3; simp [hd.xb.symm, hB]
    simp [h1, h2, h3]
  hG := fun k => by simp [mgSt, hd.xc.symm, hd.ac.symm, hd.bc.symm]
  step := by
    intro k hk
    rw [hn, Int.toNat_natCast] at hk
    exact (merge_step hd s LA LB RA RB s _ k hk (by omega)).2.1

theorem mergeP_all {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS) (hnc : n.Clean)
    (s : IState HS) (LA LB : List ℤ) (RA RB : List Item) (hA : s.G A = ints LA ++ RA)
    (hB : s.G B = ints LB ++ RB) (hl : LA.length = LB.length)
    (hno : n.ok s) (hn : n.eval s = LA.length) :
    (mergeP X A B C n).ok s ∧
      (mergeP X A B C n).run s = ((s.upd A RA).upd B RB).upd X
        (gints (LA.zip LB).reverse ++ s.G X) := by
  have H := merge_states hd n s LA LB RA RB hA hB hl hn
  refine ⟨H.ok hd.c5 hnc hno ?_, ?_⟩
  · intro k hk
    rw [hn, Int.toNat_natCast] at hk
    exact (merge_step hd s LA LB RA RB s _ k hk (by omega)).1
  · rw [mergeP, H.run, hn, Int.toNat_natCast]
    have h1 : LB.drop LA.length = [] := by simp [hl]
    have h2 : (LA.zip LB).take LA.length = LA.zip LB := List.take_of_length_le (by simp [hl])
    simp [mgSt, h1, h2]

theorem mergeP_cost {X A B C : Fin HS} (hd : Dist4 X A B C) (n : Ex HS)
    (s : IState HS) (LA LB : List ℤ) (RA RB : List Item) (hA : s.G A = ints LA ++ RA)
    (hB : s.G B = ints LB ++ RB) (hl : LA.length = LB.length) (hn : n.eval s = LA.length)
    (Bd : ℕ) (hLA : ∀ y ∈ LA, zsz y ≤ Bd) (hLB : ∀ y ∈ LB, zsz y ≤ Bd)
    (hnl : n.Lin) (hnb : n.Bnd s Bd) :
    (mergeP X A B C n).cost s ≤ (n.size + 1) * 2000 * (Bd + 2) + LA.length * (20000 * (Bd + 2)) + 32 := by
  have H := merge_states hd n s LA LB RA RB hA hB hl hn
  have := H.cost_le_lin Bd (2 * (4000 * (Bd + 2) + 2 * Bd + 2)) hnl hnb ?_
  · rw [hn, Int.toNat_natCast] at this
    have h2 : LA.length * (2 * (4000 * (Bd + 2) + 2 * Bd + 2) + 8000 * (Bd + 2) + 30) ≤
        LA.length * (20000 * (Bd + 2)) := Nat.mul_le_mul_left _ (by omega)
    rw [mergeP]; exact le_trans this (by omega)
  intro k hk
  rw [hn, Int.toNat_natCast] at hk
  exact (merge_step hd s LA LB RA RB s _ k hk (by omega)).2.2 Bd (hLA _ (List.getElem_mem _))
    (hLB _ (List.getElem_mem _))

end NLogN.Rsp

