-- title:
--   Elementary matrix groups over unital rings
-- statement:
--   For any possibly noncommutative unital ring $R$, elementary matrices have the form $I+r e_{ij}$ with $i\ne j$.
--
--   $$EL(I;R)=\langle I+r e_{ij}:i\ne j,\ r\in R\rangle.$$
--
--   The matrix submonoid generated by all these matrices is their group because inverse elementary matrices occur with coefficient $-r$. Block flattening uses the actual pair of row and column indices. Free-ring generators include both signs. The same module supplies the AB and BC actions on a three-register binary vector space.
-- source:
--   Guoding Liu, Jonas Helsen, STOC 2027 submission #221 (October 2026), pp.32–33, Eqs.(182)–(185); pp.38–40, Lemma 19. https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/221.pdf

import Mathlib

namespace LiuHelsenDesigns.OneD

/-- Elementary matrices, over any unital ring, including noncommutative rings. -/
def elementary {I R : Type} [Fintype I] [DecidableEq I] [Ring R]
    (i j : I) (r : R) : Matrix I I R := 1 + Matrix.single i j r

/-- The generated matrix monoid has all elementary inverses among its generators,
so its carrier is precisely the elementary matrix group. -/
def EL (I R : Type) [Fintype I] [DecidableEq I] [Ring R] : Submonoid (Matrix I I R) :=
  Submonoid.closure {A | ∃ i j : I, i ≠ j ∧ ∃ r : R, A = elementary i j r}

def flattenBlocks {n m : ℕ} {R : Type}
    (A : Matrix (Fin n) (Fin n) (Matrix (Fin m) (Fin m) R)) :
    Matrix (Fin n × Fin m) (Fin n × Fin m) R := fun i j => A i.1 j.1 i.2 j.2

def freeGenerators (l : ℕ) : Set (Matrix (Fin 3) (Fin 3) (FreeRing (Fin l))) :=
  {A | (∃ i j : Fin 3, i ≠ j ∧
    (A = elementary i j (1 : FreeRing (Fin l)) ∨ A = elementary i j (-1 : FreeRing (Fin l)))) ∨
    ∃ w : Fin l, ∃ p : Fin 3 × Fin 3,
      p ∈ ({(0,1),(1,2),(1,0),(2,1)} : Finset (Fin 3 × Fin 3)) ∧
      (A = elementary p.1 p.2 (FreeRing.of w) ∨ A = elementary p.1 p.2 (-FreeRing.of w))}

abbrev Register (n : ℕ) := Fin n → ZMod 2
def onAB {a b c : ℕ} (P : (Register a × Register b) ≃ₗ[ZMod 2] (Register a × Register b))
    (v : Register a × (Register b × Register c)) : Register a × (Register b × Register c) :=
  ((P (v.1,v.2.1)).1, (P (v.1,v.2.1)).2, v.2.2)
def onBC {a b c : ℕ} (R : (Register b × Register c) ≃ₗ[ZMod 2] (Register b × Register c))
    (v : Register a × (Register b × Register c)) : Register a × (Register b × Register c) :=
  (v.1,R v.2)

end LiuHelsenDesigns.OneD


