    have hd := NLogN.KFUU.zl_rev_get (NLogN.KFUU.shP u bs) (k := k) (i := n - 1 - k) (by omega)
    set t' := NLogN.KFT.cf3 (NLogN.KFUU.scS Up NLogN.KFUU.tS pS (NLogN.KFUU.zl (NLogN.KFUU.shP u bs).reverse) RtS RS k) NLogN.KFUU.lA NLogN.KFUU.lC NLogN.KFUU.lD LA LC LD with ht'
    have H := NLogN.KFUU.p1B_runs (I := I) (iprog := iprog) hM u cz bs hi hcz w xs0 hx Z hVZ hZ2 t' R
      (LV := NLogN.ints (NLogN.KFUU.sufV (NLogN.KFUU.shP u bs).reverse (k + 2)) ++ RV)
      (LtS := NLogN.ints ((NLogN.KFUU.zl (NLogN.KFUU.shP u bs).reverse).drop (k + 1)) ++ RtS) (LB := RB) (LZ := LZ) (LU := LU)
      (by rw [← e5]; simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14, Ne.symm n15] <;> rfl)
      (by simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, hs1, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14])
      (by simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, hd, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14])
      (by rw [← e5]; simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14, Ne.symm n15] <;> rfl)
      (by simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, hZ, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14]) (by simp +decide [t', NLogN.KFT.cf3, NLogN.KFUU.scS, Up, hU, Ne.symm n1, Ne.symm n2, Ne.symm n3, Ne.symm n4, Ne.symm n5, Ne.symm n6, Ne.symm n7, Ne.symm n8, Ne.symm n9, Ne.symm n10, Ne.symm n11, Ne.symm n12, Ne.symm n13, Ne.symm n14, Ne.symm n15])
    refine H.mono' ?_ le_rfl
    have e6 : n - (k + 1) = n - 1 - k := by omega
    simp only [t', NLogN.KFT.cf3, NLogN.KFUU.scS, NLogN.KFUU.scM, Up, e6]
    simp only [← hn]
    clear * - n1 n2 n3 n4 n5 n6 n7 n8 n9 n10 n11 n12 n13 n14 n15
    ((apply NLogN.IState.ext' <;> (try intros) <;>
               (simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip,
                   NLogN.IState.upd_out, ↓reduceIte, n15, Ne.symm n15, n1, Ne.symm n1, n2, Ne.symm n2,
                   n3, Ne.symm n3, n4, Ne.symm n4, n5, Ne.symm n5, n6, Ne.symm n6, n7, Ne.symm n7, n8,
                   Ne.symm n8, n9, Ne.symm n9, n10, Ne.symm n10, n11, Ne.symm n11, n12, Ne.symm n12, n13,
                   Ne.symm n13, n14, Ne.symm n14]) <;>
             (try split_ifs) <;>
