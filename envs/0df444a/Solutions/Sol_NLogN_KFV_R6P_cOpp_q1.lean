section
-- Source module: Solutions.KFV57CostR
/-!
# KFV §57: cost of the rounds of the uniform Lemma 16 procedures

With `X = 2^n · 2^ℓ` (`n = |tgtL|`) the number of coefficients and `S` a bound for the small
quantities (`B + 2`, `zsz U + 2`, `D ℓ + 1`, …) with `10^12 S^3 ≤ 2^ℓ`:

* `leafR_le`: a prefix leaf costs `≤ 10^11 (D+1)(W+1) X`;
* `top_le`: the top round costs `≤ 10^12 (D+1)(W+1) X`;
* `twist_le`: a twist costs `≤ 10^10 (W+1) X`;
* **`cFwd_le`**, **`cOpp_le`**: the forward / opposite procedure costs
  `≤ 10^13 (W+1) X (K (D+1) + ℓ) + ℓ · cCh`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem sz_pre : ePre.size + (Ex.reg gD : Ex HS).size + eSpre.size ≤ 100 := by
  simp [ePre, eSpre, Ex.size]

/-- A leaf on all `n` bits. -/
theorem leafR_le {a d c sz W B : ℕ} (hv : vol (Butterfly.layerShape (2 ^ a) 1 d (2 ^ c)) = 2 ^ nB D ℓ K long)
    (hsz : sz ≤ 100) (hd : d ≤ nB D ℓ K long) (hdW : d ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) :
    cLeafR sz a d c ℓ W B ≤ 10 ^ 11 * (d + 1) * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) := by
  unfold cLeafR
  rw [hv]
  set X := 2 ^ nB D ℓ K long * 2 ^ ℓ with hX
  have hX1 : 2 ^ ℓ ≤ X := Nat.le_mul_of_pos_left _ (Nat.two_pow_pos _)
  have hdX : d < X := lt_of_lt_of_le (lt_of_le_of_lt hd Nat.lt_two_pow_self)
    (Nat.le_mul_of_pos_right _ (Nat.two_pow_pos _))
  have hz : zsz ((12 * X : ℕ) : ℤ) ≤ 12 * X := zsz_natCast_le_self' _
  have hDZ : zsz (d : ℤ) ≤ zsz ((12 * X : ℕ) : ℤ) := zsz_natCast_le' (by omega)
  have h1 := cLeafU_le d X (zsz ((12 * X : ℕ) : ℤ)) W hDZ
  have h2 : cLfPush sz B ≤ 3 * 10 ^ 10 * (B + 2) ^ 2 := by
    unfold cLfPush
    have : 8 * (3 * sz + 12) ≤ 3000 := by omega
    calc 8 * (3 * sz + 12) * 10 ^ 7 * (B + 2) ^ 2 ≤ 3000 * 10 ^ 7 * (B + 2) ^ 2 := by gcongr
      _ = 3 * 10 ^ 10 * (B + 2) ^ 2 := by ring
  have hB2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h3 : 10 ^ 12 * (B + 2) ^ 2 ≤ X := by omega
  have h4 : (W + 8 * d + 8) * X + zsz ((12 * X : ℕ) : ℤ) + 2 ≤ 23 * ((W + 1) * X) := by
    have : (W + 8 * d + 8) * X ≤ 9 * (W + 1) * X := Nat.mul_le_mul_right _ (by omega)
    have : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
    nlinarith
  have h5 : 10 ^ 9 * (d + 1) * ((W + 8 * d + 8) * X + zsz ((12 * X : ℕ) : ℤ) + 2) ≤
      10 ^ 9 * (d + 1) * (23 * ((W + 1) * X)) := Nat.mul_le_mul_left _ h4
  have h6 : X ≤ (d + 1) * (W + 1) * X := by
    have : 1 ≤ (d + 1) * (W + 1) := Nat.mul_pos (by omega) (by omega)
    nlinarith
  have h7 : 16 * B + 16 ≤ X := by nlinarith
  calc cLfPush sz B + cLeafU d X (zsz ((12 * X : ℕ) : ℤ)) W + 8 * (2 * B + 2)
      ≤ 3 * 10 ^ 10 * (B + 2) ^ 2 + 10 ^ 9 * (d + 1) * (23 * ((W + 1) * X)) + X := by omega
    _ ≤ 10 ^ 11 * (d + 1) * (W + 1) * X := by nlinarith

/-- The register leaf of a prefix round. -/
theorem pre_le (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h W B : ℕ} (hh : h < bb ℓ K) (hDW : D ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) :
    cLeafR (ePre.size + (Ex.reg gD : Ex HS).size + eSpre.size) (preP D ℓ K long h) D
        (sufP D ℓ K long h) ℓ W B ≤
      10 ^ 11 * (D + 1) * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) := by
  have hv := vol_pre D ℓ K long hK hℓ hh
  have hd : D ≤ nB D ℓ K long := by
    have h1 := length_lstL_le_tgt D ℓ K long
    rw [length_lstL] at h1
    have : D ≤ bb ℓ K * D := Nat.le_mul_of_pos_left _ (by omega)
    unfold nB; omega
  exact leafR_le D ℓ K long hv (sz_pre) hd hDW hS

/-- The bound of the twist tables. -/
theorem twA_le {N h m Bt S : ℕ} (hBt : Bt + 2 ≤ S) (hh : h ≤ S) (hD : D ≤ S) (hm : m + 1 ≤ S) :
    cTwA N D h m Bt ≤ 10 ^ 11 * S ^ 4 + 2 * 10 ^ 9 * (N + 1) * S ^ 3 := by
  have hS2 : 2 ≤ S := by omega
  have s1 : S ≤ S ^ 2 := by nlinarith
  have s2 : S ^ 2 ≤ S ^ 3 := by nlinarith
  have s3 : S ^ 3 ≤ S ^ 4 := by nlinarith
  have hB2 : (Bt + 2) ^ 2 ≤ S ^ 2 := Nat.pow_le_pow_left hBt 2
  have tl : cTLoop h Bt ≤ 2 * 10 ^ 9 * S ^ 3 := by
    unfold cTLoop cLp cTermB
    have : h * (10 ^ 9 * (Bt + 2) ^ 2 + 1100) ≤ S * (10 ^ 9 * S ^ 2 + 1100) :=
      Nat.mul_le_mul hh (by omega)
    nlinarith
  have ax : cAX 100 h Bt ≤ 4 * 10 ^ 9 * S ^ 3 := by unfold cAX; nlinarith
  have br : cAxB h Bt ≤ 10 ^ 10 * S ^ 3 := by unfold cAxB KFV.cBr; nlinarith
  have al : cAxL D h Bt ≤ 2 * 10 ^ 10 * S ^ 4 := by
    unfold cAxL cLp
    have : D * (cAxB h Bt + 1100) ≤ S * (10 ^ 10 * S ^ 3 + 1100) := Nat.mul_le_mul hD (by omega)
    nlinarith
  have gt : cGenT D h Bt ≤ 3 * 10 ^ 10 * S ^ 4 := by
    unfold cGenT
    have : D * (Bt + 2) ≤ S * S := Nat.mul_le_mul hD hBt
    nlinarith
  have tb : cTabU N m Bt ≤ 10 ^ 9 * (N + 1) * S ^ 3 := by
    unfold cTabU
    have : (m + 1) * (Bt + 2) ^ 2 ≤ S * S ^ 2 := Nat.mul_le_mul hm hB2
    calc 10 ^ 9 * (N + 1) * (m + 1) * (Bt + 2) ^ 2 = 10 ^ 9 * (N + 1) * ((m + 1) * (Bt + 2) ^ 2) := by ring
      _ ≤ 10 ^ 9 * (N + 1) * (S * S ^ 2) := Nat.mul_le_mul_left _ this
      _ = 10 ^ 9 * (N + 1) * S ^ 3 := by ring
  have lp : cLp m (6 * Bt + 6) Bt ≤ 10 ^ 4 * S ^ 2 := by
    unfold cLp
    have : m * (6 * Bt + 6 + 1100) ≤ S * (6 * S + 1100) := Nat.mul_le_mul (by omega) (by omega)
    nlinarith
  have hN : 10 ^ 9 * (N + 1) * S ^ 3 ≤ 10 ^ 9 * (N + 1) * S ^ 3 := le_rfl
  unfold cTwA
  nlinarith

/-- A twist. -/
theorem twist_le {h m W B Bt : ℕ} (hh : h < ℓ) (hm : m ≤ D * h) (hBt : Bt ≤ B)
    (hDl : D * ℓ ≤ B) (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) (hBW : B + 2 ≤ 6 * (W + 1)) :
    cTwistU (nB D ℓ K long) ℓ D h m W Bt ≤
      10 ^ 10 * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) := by
  set N := 2 ^ nB D ℓ K long with hN
  set X := N * 2 ^ ℓ with hX
  have hN1 : 1 ≤ N := Nat.one_le_two_pow
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hl1 : ℓ ≤ D * ℓ := Nat.le_mul_of_pos_left _ hD1
  have hD : D ≤ D * ℓ := Nat.le_mul_of_pos_right _ (by omega)
  have hmD : m ≤ D * ℓ := le_trans hm (Nat.mul_le_mul_left _ hh.le)
  have h1 := twA_le D (N := N) (h := h) (m := m) (Bt := Bt) (S := B + 2) (by omega) (by omega)
    (by omega) (by omega)
  have h2 := cTw_le N (2 ^ ℓ) W hN1 Nat.one_le_two_pow
  have hS2 : 2 ≤ B + 2 := by omega
  have s3 : (B + 2) ^ 4 = (B + 2) * (B + 2) ^ 3 := by ring
  have hX1 : 2 ^ ℓ ≤ X := Nat.le_mul_of_pos_left _ hN1
  have hNX : N ≤ X := Nat.le_mul_of_pos_right _ Nat.one_le_two_pow
  have a1 : 10 ^ 12 * (B + 2) ^ 4 ≤ (B + 2) * X := by
    rw [s3]; nlinarith
  have a2 : 10 ^ 12 * ((N + 1) * (B + 2) ^ 3) ≤ 2 * X := by
    have : (N + 1) * (10 ^ 12 * (B + 2) ^ 3) ≤ (2 * N) * 2 ^ ℓ := Nat.mul_le_mul (by omega) hS
    nlinarith
  have hWX : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have a3 : (B + 2) * X ≤ 6 * ((W + 1) * X) := by nlinarith
  have a4 : N * 2 ^ ℓ + N + 1 ≤ 3 * X := by omega
  have a5 : 3 * 10 ^ 5 * (W + 1) * (N * 2 ^ ℓ + N + 1) ≤ 9 * 10 ^ 5 * ((W + 1) * X) := by
    have := Nat.mul_le_mul_left (3 * 10 ^ 5 * (W + 1)) a4
    nlinarith
  have hB2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have a6 : 10 ^ 4 * (Bt + 2) ≤ X := by nlinarith
  unfold cTwistU
  nlinarith

theorem layC_le (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h W B cCh : ℕ} (hh : h < ℓ) (hDW : D ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) :
    cLayC D ℓ K long h W B cCh ≤ 2 ^ nB D ℓ K long * 2 ^ ℓ + brR18 D ℓ K long h cCh W := by
  set X := 2 ^ nB D ℓ K long * 2 ^ ℓ with hX
  have hX1 : 2 ^ ℓ ≤ X := Nat.le_mul_of_pos_left _ (Nat.two_pow_pos _)
  have hB2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hI : cIteB 4 B + cIteB 6 B ≤ X := by unfold cIteB; nlinarith
  unfold cLayC brR18
  by_cases h1 : h < bb ℓ K
  · rw [if_pos h1, if_pos h1]
    have := pre_le D ℓ K long hK hℓ h1 hDW hS
    rw [← hX] at this ⊢
    omega
  · rw [if_neg h1, if_neg h1]
    by_cases h2 : h < ℓ - 1
    · rw [if_pos h2, if_neg (by omega)]; omega
    · rw [if_neg h2, if_pos (by omega)]
      have := top_le D ℓ K long hK hℓ hDW hS (B := B)
      rw [← hX] at this ⊢
      omega

theorem rndO_le (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h W B cCh U : ℕ} (hh : h < ℓ) (hDW : D ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) (hBW : B + 2 ≤ 6 * (W + 1)) (hDl : D * ℓ ≤ B)
    (hU : zsz (U : ℤ) ≤ B) :
    cRndO D ℓ K long h W B cCh U ≤
      11 * 10 ^ 9 * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) + brR18 D ℓ K long h cCh W := by
  have h1 := layC_le D ℓ K long hK hℓ hh hDW hS (cCh := cCh)
  have h2 := twist_le D ℓ K long hh (by exact genG_length_le (pLP D ℓ K long) (flOf D long) true h) hU hDl hS hBW (W := W)
  have hX : 2 ^ nB D ℓ K long * 2 ^ ℓ ≤ (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) :=
    Nat.le_mul_of_pos_left _ (by omega)
  unfold cRndO
  have e : 11 * 10 ^ 9 * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) =
    11 * 10 ^ 9 * ((W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ)) := by ring
  have e2 : 10 ^ 10 * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) =
    10 ^ 10 * ((W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ)) := by ring
  rw [e]; rw [e2] at h2
  exact le_trans (Nat.add_le_add h2 h1) (by omega)

theorem sum_ite_eq (ℓ a c : ℕ) : ∑ h ∈ Finset.range ℓ, (if h = a then c else 0) ≤ c := by
  rw [Finset.sum_ite_eq']; split_ifs <;> omega

end Paper

