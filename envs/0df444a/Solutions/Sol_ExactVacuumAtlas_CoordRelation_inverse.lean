open scoped ContDiff
open Matrix Filter Topology
open ExactVacuumAtlas
open ExactVacuumAtlas.CoordRelation
variable {g₁ g₂ : Metric 4} {U V : Set (Pt 4)} {Φ Ψ : Pt 4 → Pt 4}
  {J K : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}
theorem solution (h : CoordRelation g₁ g₂ U V Φ Ψ J) (hU : IsOpen U) (hV : IsOpen V)
    (hJK : ∀ x ∈ U, J x * K x = 1) :
    CoordRelation g₂ g₁ V U Ψ Φ (fun y => K (Ψ y)) where
  left_inv y hy := h.right_inv y hy
  right_inv x hx := h.left_inv x hx
  bijOn := h.bijOn_inv
  smooth := h.smooth_inv
  smooth_inv := h.smooth
  jacobian y hy k i := h.jacobian_inv hU hV hJK hy k i
  pullback y hy := by
    have hx : Ψ y ∈ U := h.bijOn_inv.mapsTo hy
    have hp := h.pullback (Ψ y) hx
    rw [h.right_inv y hy] at hp
    have hKJt : (K (Ψ y))ᵀ * (J (Ψ y))ᵀ = 1 := by
      rw [← Matrix.transpose_mul, hJK _ hx, Matrix.transpose_one]
    calc (K (Ψ y))ᵀ * metricMatrix g₁ (Ψ y) * K (Ψ y)
        = (K (Ψ y))ᵀ * ((J (Ψ y))ᵀ * metricMatrix g₂ y * J (Ψ y)) * K (Ψ y) := by rw [hp]
      _ = ((K (Ψ y))ᵀ * (J (Ψ y))ᵀ) * metricMatrix g₂ y * (J (Ψ y) * K (Ψ y)) := by
          simp only [Matrix.mul_assoc]
      _ = metricMatrix g₂ y := by rw [hKJt, hJK _ hx, Matrix.one_mul, Matrix.mul_one]
