variable {S : Scheme.{u}} {X Y Z : Type u} [AddCommGroup X] [AddCommGroup Y] [AddCommGroup Z]

theorem GlobalTheory.SplitTorus.homEquiv_comp [ConnectedSpace S] (φ : Y →+ X) (ψ : Z →+ Y) :
