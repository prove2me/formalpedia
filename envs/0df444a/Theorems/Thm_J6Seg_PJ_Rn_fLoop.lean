theorem J6Seg.PJ.Rn.fLoop {v : Vr} {D : Cs} (hF : Fx Q kk m mw cB v) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W v) {t : ℕ} (h23 : v 23 = t)
    (hD50 : D 50 = []) (hD51 : D 51 = [])
    (ht : t + ((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).length ≤ 2 ^ W)
    (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) :
    Rn (PJ.forL 50 28 1 J6Seg.PJ.fBody) v D (fun v' =>
      v' 23 = ((t + ((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).length
        : ℕ) : ℤ) ∧
      (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 23, 29] : List (Fin HS)), v' i = v i) ∧ BV W v')
      (update D 41 (((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).reverse
        ++ D 41))
