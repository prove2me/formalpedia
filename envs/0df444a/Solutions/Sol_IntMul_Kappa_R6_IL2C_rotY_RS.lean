theorem sp_reg {t : IState HS} {r : Fin HS} {v : ℕ} (h : ∃ L, t.G r = .int (v : ℤ) :: L)
    (hr : r.val < 56) {Bb : ℕ} (hz : zsz (v : ℤ) ≤ Bb) : ESp (.reg r) t Bb (v : ℤ) := by
  obtain ⟨L, hL⟩ := h; exact ESp.ofG' hL hr hz

theorem sp_pow {t : IState HS} {r : Fin HS} {x : ℕ} (h : ∃ L, t.G r = .int ((2 : ℤ) ^ x) :: L)
    (hr : r.val < 56) {Bb : ℕ} (hz : zsz ((2 ^ x : ℕ) : ℤ) ≤ Bb) : ESp (.reg r) t Bb ((2 : ℤ) ^ x) := by
  obtain ⟨L, hL⟩ := h; exact ESp.ofG' hL hr (by push_cast at hz; exact hz)

variable (hP : PhOK l K ρ G n L Br)
include hP

/-- The rotation of `Y` with the term `T ∈ {tmA, tmB}`. -/
theorem rotY_RS_sol_aux {T : Ex HS} {tf : ℤ → ℤ → ℤ}
    (hT : SegTR T tf (zsz ((l.M * Br : ℕ) : ℤ) + 3) (2 * (2 : ℤ) ^ G) ((2 : ℤ) ^ G))
    (hfok : fok (tabGenR 1 T) = true)
    (hsz : ((rotPlR eYP (.reg kQL) eYB (eYd kSU) (eYd kST) (.reg kRR) (.reg kRR) (.reg kK2)
      (.reg kR2) (.reg kN) (.reg kRR)).map fun p => p.2.size + 1).sum ≤ 200) :
    RecStep I tab (rotR 1 T eYP (.reg kQL) eYB (eYd kSU) (eYd kST) (.reg kRR) (.reg kRR)
        (.reg kK2) (.reg kR2) (.reg kN) (.reg kRR)) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (rotP l.QL l.sY (tabE 1 tf ((2 : ℤ) ^ G) ((2 : ℤ) ^ G) ((2 : ℤ) ^ K) ((2 : ℤ) ^ ρ)
        (l.sU / (l.QL * l.sY)) (l.sT / (l.QL * l.sY)) l.QL n))
      (cR T l n Br (l.M / (l.QL * l.sY)) l.QL l.sY) := by
  have hV := hP.kv
  have hOK := hP.ok
  set Bb := zsz ((l.M * Br : ℕ) : ℤ) + 3 with hBb
  have pY := hOK.pY
  have hql := hV.ql1
  obtain ⟨kM, hkM, eM⟩ := hOK.kMT
  obtain ⟨b, hb, eb⟩ := hOK.kTY
  obtain ⟨c, hc, ec⟩ := hOK.kUY
  have hQY : 0 < l.QL * l.sY := by positivity
  have eP : l.M / (l.QL * l.sY) * l.QL * l.sY = l.M := by
    rw [mul_assoc, Nat.div_mul_cancel ⟨b * l.QC * kM, by rw [eM, eb]; ring⟩]
  have ed1 : l.sU / (l.QL * l.sY) = c := by
    rw [ec, show l.sY * l.QL * c = (l.QL * l.sY) * c by ring, Nat.mul_div_cancel_left _ hQY]
  have ed2 : l.sT / (l.QL * l.sY) = b := by
    rw [eb, show l.sY * l.QL * b = (l.QL * l.sY) * b by ring, Nat.mul_div_cancel_left _ hQY]
  have hPM : l.M / (l.QL * l.sY) ≤ l.M := Nat.div_le_self _ _
  have hd1 : c ≤ l.M := by rw [← ed1]; exact le_trans (Nat.div_le_self _ _) hP.uM
  have hd2 : b ≤ l.M := by rw [← ed2]; exact le_trans (Nat.div_le_self _ _) hP.tM
  have hYQ := hOK.yq_le
  have hYQ' : l.QL * l.sY ≤ l.M := by rw [mul_comm]; exact hYQ
  have hyM : l.sY ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hql) hYQ
  have hR := hV.RM
  have hTV : TVal l.QL (l.sU / (l.QL * l.sY)) (l.sT / (l.QL * l.sY)) ((2 : ℤ) ^ G) ((2 : ℤ) ^ G)
      ((2 : ℤ) ^ K) ((2 : ℤ) ^ ρ) (2 * (2 : ℤ) ^ G) n Bb := by
    rw [ed1, ed2]
    refine ⟨hql, hc, hb, by positivity, by positivity, ?_, by positivity, ?_, by omega, ?_, ?_, ?_,
      ?_, hP.z3 (by have := hV.nM; omega), hP.z3 (by omega), hP.z3 (by omega), ?_, ?_⟩
    · have : (2 : ℤ) ^ 1 ≤ 2 ^ K := pow_le_pow_right₀ (by norm_num) hV.hK
      simpa using this
    · have : (1 : ℤ) ≤ 2 ^ G := one_le_pow₀ (by norm_num)
      linarith
    · have := hP.z3 (v := 2 ^ G) (by omega); push_cast at this; exact this
    · have := hP.z3 (v := 2 ^ G) (by omega); push_cast at this; exact this
    · have := hP.z3 (v := 2 ^ K) (by have := hV.KM; omega); push_cast at this; exact this
    · have := hP.z3 (v := 2 ^ ρ) (by have := hV.ρM; omega); push_cast at this; exact this
    · have h1 := hV.hA
      rw [← hV.ql] at h1
      have : ((2 * 2 ^ G * 2 ^ ρ * (2 ^ K) ^ n : ℕ) : ℤ) ≤ ((l.QL * l.QL : ℕ) : ℤ) := by
        exact_mod_cast h1
      push_cast at this; linarith
    · have := hV.q3 (le_refl l.QL)
      have h0 : (0 : ℤ) ≤ (l.QL : ℤ) * (l.QL : ℤ) := by positivity
      linarith
  refine rotRS hT 1 (Or.inl rfl) hfok hTV pY (by have := hP.br; omega) eP (hP.z3 (by omega))
    hsz (by intro p hp; simp only [rotPlR, List.mem_cons, List.not_mem_nil, or_false] at hp
            rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
              (unfold KFX.NoLow; decide))
    (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_)
    (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_) (fun t ht => ?_)
  · exact ESp.ndivN (sp_reg ht.m (by decide) (hP.z3 (by omega)))
      (ESp.mulN (sp_reg ht.key.ql (by decide) (hP.z3 (by have := hV.qlM; omega)))
        (sp_reg ht.key.sy (by decide) (hP.z3 (by omega))) (hP.z3 (by omega))) hQY (hP.z3 (by omega))
  · exact sp_reg ht.key.ql (by decide) (hP.z3 (by have := hV.qlM; omega))
  · exact ESp.mulN (sp_reg ht.key.sy (by decide) (hP.z3 (by omega)))
      (sp_reg ht.br (by decide) (hP.zB (by nlinarith))) (hP.zB (by
        have := Nat.mul_le_mul_right Br hP.yM; omega))
  · exact ESp.ndivN (sp_reg ht.key.su (by decide) (hP.z3 (by have := hP.uM; omega)))
      (ESp.mulN (sp_reg ht.key.ql (by decide) (hP.z3 (by have := hV.qlM; omega)))
        (sp_reg ht.key.sy (by decide) (hP.z3 (by omega))) (hP.z3 (by omega))) hQY
      (hP.z3 (by rw [ed1]; omega))
  · exact ESp.ndivN (sp_reg ht.key.st (by decide) (hP.z3 (by have := hP.tM; omega)))
      (ESp.mulN (sp_reg ht.key.ql (by decide) (hP.z3 (by have := hV.qlM; omega)))
        (sp_reg ht.key.sy (by decide) (hP.z3 (by omega))) (hP.z3 (by omega))) hQY
      (hP.z3 (by rw [ed2]; omega))
  · exact sp_pow ht.key.rr (by decide) (hP.z3 (by omega))
  · exact sp_pow ht.key.rr (by decide) (hP.z3 (by omega))
  · exact sp_pow ht.key.k2 (by decide) (hP.z3 (by have := hV.KM; omega))
  · exact sp_pow ht.key.r2 (by decide) (hP.z3 (by have := hV.ρM; omega))
  · exact sp_reg ht.key.nn (by decide) (hP.z3 (by have := hV.nM; omega))
  · exact sp_pow ht.key.rr (by decide) (hP.z3 (by omega))

end Steps

