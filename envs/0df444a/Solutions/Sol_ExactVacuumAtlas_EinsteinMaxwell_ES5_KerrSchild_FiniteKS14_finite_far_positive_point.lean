namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

theorem hasDerivAt_of_cd {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) {s : ℝ}
    (hs : s ∈ R) : HasDerivAt f (deriv f s) s :=
  ((h.contDiffAt (hR.mem_nhds hs)).differentiableAt (by simp)).hasDerivAt

theorem cd_deriv {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) :
    ContDiffOn ℝ ∞ (deriv f) R :=
  h.deriv_of_isOpen hR (by simp)

