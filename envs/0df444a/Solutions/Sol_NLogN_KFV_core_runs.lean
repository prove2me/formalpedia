  by_cases h : i ≤ j
  · rw [if_pos ⟨h, by omega⟩, if_neg (by omega), if_pos h, sub_zero]
  · rw [if_neg (by omega), if_pos ⟨by omega, by omega⟩, if_neg h, zero_sub]

