      (Ω × ConditionedAnswerFlag A B D) ×
        (Fin h → V) → ℝ :=
    fun context =>
      finiteRelativeEntropy
        (jointConditional posteriorNext
          (finitePrefixMask default k.castSucc context))
        (jointConditional priorNext
          (finitePrefixMask default k.castSucc context))
