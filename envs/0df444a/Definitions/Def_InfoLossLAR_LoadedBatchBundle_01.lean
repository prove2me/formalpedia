        rw [PMF.map_apply]
        by_cases h : head = vector 0 <;> simp [hpair, h]
      simp only [_root_.AFT.GaussianSource.independentCoordinates, PMF.bind_apply, hmap, mul_ite, mul_zero]
      rw [tsum_ite_eq, Fin.prod_univ_succ]
      rw [ih]
      rfl
