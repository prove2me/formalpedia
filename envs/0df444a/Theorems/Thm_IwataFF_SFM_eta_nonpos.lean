-- title:
--   §4, p. 13 — if $\eta \le 0$, a consistent extreme base is $\le 0$ and $V$ minimizes $f$
-- statement:
--   Let $V$ be a finite nonempty set, $f$ submodular on $V$ with $f(\emptyset) = 0$, $D = (V, F)$ a digraph with $F \subseteq V \times V$, and $x$ the extreme base generated by a linear ordering of $V$ consistent with $D$. If
--   $$\eta = \max\{f(R(v)) - f(R(v) \setminus \{v\}) \mid v \in V\} \le 0,$$
--   then $x(v) \le 0$ for each $v \in V$, and $V$ minimizes $f$.
--
--   This is the stopping test of the loop of Figure 3.
-- source:
--   Iwata, Fleischer & Fujishige, A Combinatorial, Strongly Polynomial-Time Algorithm for Minimizing Submodular Functions, arXiv:math/0004089v1, p. 13, §4 (the case η ≤ 0)

import Mathlib
import Definitions.Def_IwataFF_SFM_Basic
import Definitions.Def_IwataFF_SFM_Phase
import Definitions.Def_IwataFF_SFM_Main

namespace IwataFF.SFM

/-- §4, p. 13 (arXiv:math/0004089v1): if `η ≤ 0`, an extreme base consistent with `D` satisfies
`x(v) ≤ 0` for each `v ∈ V`, and `V` minimizes `f`. -/
theorem eta_nonpos {α : Type} [DecidableEq α] (V : Finset α) (hV : V.Nonempty)
    (f : Finset α → ℝ) (hsub : SubmodularOn V f) (hf0 : f ∅ = 0)
    (F : Finset (α × α)) (hF : ∀ e ∈ F, e.1 ∈ V ∧ e.2 ∈ V)
    (L : List α) (hL : IsOrdering V L) (hcons : IsConsistent F L)
    (hη : etaVal V F f ≤ 0) :
    (∀ v ∈ V, greedy f L v ≤ 0) ∧ IsMinimizer V f V := by sorry

end IwataFF.SFM
