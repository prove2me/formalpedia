theorem Formalism.L2.Th1.C.Calc.phi_norm (D : Data R l linv τ) {ph : PowerSeries K} {α : O}
    (hN : PhNormAt R l linv ph (τ α) (τ (star α))) {σ : Type} (u : ptsSub D σ) :
    phi D ph (α • u) = nm α • phi D ph u := by sorry
