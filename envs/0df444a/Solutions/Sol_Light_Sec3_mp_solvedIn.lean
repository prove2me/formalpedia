/-- **The loop that doubles** computes the number L of levels and 2^L. -/
theorem pow_spec (C : (Ctx P₀ R' p pAff pDown pTr pRow pFill pOr T r lim d q μ fr)) :
    Ends lim (P₀ ++ R') d paPow ⟨Light.frame (Light.Sec3.PaHost.locals q fr 1 0 0 0), μ⟩ (14 * ntLevels q.U + 6)
      fun σ' => σ' = ⟨Light.frame (Light.Sec3.PaHost.locals q fr (2 ^ ntLevels q.U : ℕ) (ntLevels q.U) 0 0), μ⟩ := by
  have hplaces := C.places
  have hL := two_pow_ntLevels_le' C.pre.U_pos
  refine Ends.whileBlock (Light.Sec3.PaHost.PowInv q μ fr) (ntLevels q.U) (by simp [Light.Sec3.PaHost.PowInv]) ?round ?done
    (by simp; omega)
  case round =>
    rintro i _ hi rfl
    have hpow : 2 ^ (i + 1) ≤ 2 ^ ntLevels q.U := Nat.pow_le_pow_right (by norm_num) hi
    have hlt : i + 1 < 2 ^ (i + 1) := Nat.lt_two_pow_self
    rw [pow_succ'] at hpow hlt
    generalize hpw : 2 ^ i = pw at hpow hlt ⊢
    exact ⟨by (( (try have := Light.Std.space_le (by assumption))
                 (try have := Light.Std.const_le (by assumption))
                 (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))), by simp; omega, by (( (try have := Light.Std.space_le (by assumption))
                                                                                                   (try have := Light.Std.const_le (by assumption))
                                                                                                   (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))),
      by simp [Light.Sec3.PaHost.PowInv, pow_succ', hpw, update_frame_setLocal, Light.Sec3.PaHost.locals]⟩
  case done =>
    rintro _ rfl
    have hlt := lt_two_pow_ntLevels' q.U
    generalize 2 ^ ntLevels q.U = pw at hL hlt ⊢
    exact ⟨by (( (try have := Light.Std.space_le (by assumption))
                 (try have := Light.Std.const_le (by assumption))
                 (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))), by simp; omega, rfl⟩

/-- The three shifted and doubled matrices, one after the other, are the array r at the start. -/
theorem seg_zs (C : (Ctx P₀ R' p pAff pDown pTr pRow pFill pOr T r lim d q μ fr)) {μ' : ℕ → ℤ}
    (h1 : Seg μ' (fr + 3 * (q.n * q.n)) (affL 2 (2 * q.U) (negL q.V)))
    (h2 : Seg μ' (fr + 4 * (q.n * q.n)) (affL 2 (2 * q.U) (transL q.n q.Y)))
    (h3 : Seg μ' (fr + 5 * (q.n * q.n)) (affL (-2) (4 * q.U) q.X)) :
    Seg μ' (fr + 3 * (q.n * q.n)) (Light.Sec3.PaHost.zs q) := by
  have hp := C.places
  rw [Light.Sec3.PaHost.zs, negStart, seg_append, seg_append]
  simp only [length_affL, negL, transL, List.length_map, List.length_range, hp.2.2.2.1.2.2]
  rw [show fr + 3 * (q.n * q.n) + q.n * q.n = fr + 4 * (q.n * q.n) by omega,
    show fr + 4 * (q.n * q.n) + q.n * q.n = fr + 5 * (q.n * q.n) by omega]
  exact ⟨h1, h2, h3⟩

theorem flagsOf_false (N : ℕ) {A : ℕ → Prop} (h : ∀ i, ¬ A i) :
    flagsOf N A = List.replicate N 0 := by
  simp [flagsOf, flag_of_not (h _), List.map_const']

theorem flagsOf_congr (N : ℕ) {A B : ℕ → Prop} (h : ∀ i, A i ↔ B i) : flagsOf N A = flagsOf N B := by
  simp only [flagsOf]
  congr 1
  funext i
  exact flag_congr (h i)

