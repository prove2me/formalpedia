theorem LitOK.twoR {π : PMap} {r : ℕ} (hr : π kr = some (r : ℤ)) :
    LitOK π ((2 * r : ℕ) : ℤ) exTwoR := by
  refine ⟨fun j hj hj' => ?_, fun s hs => ?_⟩
  · simp [exTwoR, Ex.regs] at hj; subst hj; revert hj'; simp only [NLogN.zX_all]; decide
  · obtain ⟨L, hL⟩ := hs kr r hr
    refine ⟨⟨IState.isInt_of hL, IState.isInt_of hL⟩, ?_, ?_⟩
    · simp only [exTwoR, Ex.eval, IState.top_eq hL]; push_cast; ring
    · simp only [exTwoR, Ex.cost, Ex.eval, IState.top_eq hL]
      have h1 : zsz (r : ℤ) ≤ zsz ((2 * r : ℕ) : ℤ) := zsz_natCast_le' (by omega)
      simp only [addIntCost, addMagCost, subMagCost, zipCost, moveCost, dupCost]
      omega

theorem LitOK.negReg {π : PMap} (hπ : PLow π) {i : Fin HS} {v : ℤ} (hv : π i = some v) :
    LitOK π (-v) (.neg (.reg i)) := by
  obtain ⟨hc, -⟩ := LitOK.reg hπ hv
  refine ⟨fun j hj => hc j (by simpa [Ex.regs] using hj), fun s hs => ?_⟩
  obtain ⟨L, hL⟩ := hs i v hv
  refine ⟨IState.isInt_of hL, by simp [Ex.eval, IState.top_eq hL], ?_⟩
  simp only [Ex.cost, IState.top_eq hL]
  rw [zsz_neg]
  have := dup_cost_le (zsz v)
  simp only [moveCost] at this ⊢
  omega

theorem GSim.refl (π : PMap) : ∀ p : RS, GSim π p p
  | .skip => .skip
  | .asg i e => .asg i (.refl e)
  | .push i e => .push i (.refl e)
  | .pop i => .pop i
  | .seq a b => .seq (refl π a) (refl π b)
  | .ite c a b => .ite (.refl c) (refl π a) (refl π b)
  | .rep i n b => .rep i (.refl n) (refl π b)

theorem isim_rptR {π : PMap} {R A C D : Fin HS} {n : ℕ} (hR : π R = some (n : ℤ)) (hRA : R ≠ A)
    (b : IStmt HS Pp) : ISim I iprog π (rpt A C D n b) (rptR R A C D b) :=
  .seq (.par hR hRA) (ISim.refl π _)

theorem isim_carI {π : PMap} {b r : ℕ} (hB : π kB = some ((2 : ℤ) ^ b)) (hr : π kr = some (r : ℤ)) :
    ISim I iprog π (carI b r) carU :=
  .seq (.par hB (by decide)) (.seq (.op _) (.seq (isim_rptR hr (by decide) _) (.seq (.op _)
    (.seq (.op _) (.seq (.op _) (.seq (isim_rptR hr (by decide) _) (.seq (.op _) (.seq (.op _)
    (.op _)))))))))

