  set pre := axpre6 P n D k
  set post := axpost6 P n D k
  set nc := axnc6 P n k
  set t := axt6 P n k
  set T := TP6 P n
  set p := pP6 P n
  have htT : t ≤ T := by
    rw [← htot]
    calc t = 1 * t * 1 := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul (Nat.mul_le_mul_right _ hpre1) hpost1
  have hpreT : pre ≤ T := by
    rw [← htot]
    calc pre = pre * 1 * 1 := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul (Nat.mul_le_mul_left _ ht1) hpost1
  have hpostT : post ≤ T := by
    rw [← htot]
    calc post = 1 * 1 * post := by ring
