variable {F : Type} [Field F] [NumberField F] [MeasurableSpace (AdeleRing (𝓞 F) F)ˣ]
  {ν : Measure (AdeleRing (𝓞 F) F)ˣ} {S : Finset (HeightOneSpectrum (𝓞 F))} (Hν : ProductMeasureData S ν)
  {Z f : (AdeleRing (𝓞 F) F)ˣ → ℂ} {φ : HeightOneSpectrum (𝓞 F) → ℤ → ℂ}

private theorem integrableOn_and_setIntegral_eq
    (hfact : ∀ L : List (HeightOneSpectrum (𝓞 F)), (∀ v ∈ L, v ∉ S) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}),
        Z a = f (Hν.projS a) * (L.map fun v => φ v (Hν.ord v a)).prod)
    (hf : Integrable f Hν.νS) (hφ : ∀ v, v ∉ S → Summable fun m : ℤ => ‖φ v m‖)
    (L : List (HeightOneSpectrum (𝓞 F))) (hLS : ∀ v ∈ L, v ∉ S) (hL : L.Nodup) :
    IntegrableOn Z
        (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) : Set (AdeleRing (𝓞 F) F)ˣ) ν ∧
      (∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) : Set (AdeleRing (𝓞 F) F)ˣ),
          Z a ∂ν) = Hν.c * (∫ a, f a ∂Hν.νS) * (L.map fun v => ∑' m : ℤ, φ v m).prod := by
  have htone := Hν.tonelli L hLS hL f φ hf fun v hv => hφ v (hLS v hv)
  have hmeas := Hν.measurableSet L hLS hL
  have heq : Set.EqOn (fun a => f (Hν.projS a) * (L.map fun v => φ v (Hν.ord v a)).prod) Z
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) : Set (AdeleRing (𝓞 F) F)ˣ) :=
    fun a ha => (hfact L hLS hL a ha).symm
  exact ⟨htone.1.congr_fun heq hmeas, (setIntegral_congr_fun hmeas heq).symm.trans htone.2⟩

private theorem setIntegral_norm_le
    (hfact : ∀ L : List (HeightOneSpectrum (𝓞 F)), (∀ v ∈ L, v ∉ S) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}),
        Z a = f (Hν.projS a) * (L.map fun v => φ v (Hν.ord v a)).prod)
    (hf : Integrable f Hν.νS) (hφ : ∀ v, v ∉ S → Summable fun m : ℤ => ‖φ v m‖)
    {c : HeightOneSpectrum (𝓞 F) → ℝ} (hφc : ∀ v, v ∉ S → ∑' m : ℤ, ‖φ v m‖ ≤ 1 + c v)
    (hc0 : ∀ v, 0 ≤ c v) (hc : Summable c)
    (L : List (HeightOneSpectrum (𝓞 F))) (hLS : ∀ v ∈ L, v ∉ S) (hL : L.Nodup) :
    (∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) : Set (AdeleRing (𝓞 F) F)ˣ),
        ‖Z a‖ ∂ν) ≤ Hν.c * (∫ a, ‖f a‖ ∂Hν.νS) * Real.exp (∑' v, c v) := by
  classical
  have hmeas := Hν.measurableSet L hLS hL
  have hpt : Set.EqOn (fun a => ((‖Z a‖ : ℝ) : ℂ))
      (fun a => ((‖f (Hν.projS a)‖ : ℝ) : ℂ) * (L.map fun v => ((‖φ v (Hν.ord v a)‖ : ℝ) : ℂ)).prod)
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) : Set (AdeleRing (𝓞 F) F)ˣ) := by
    intro a ha
    dsimp only
    rw [hfact L hLS hL a ha, norm_mul, List.norm_prod, Complex.ofReal_mul, ofReal_map_prod]
    simp only [List.map_map, Function.comp_def]
  have hφ' : ∀ v ∈ L, Summable fun m : ℤ => ‖((‖φ v m‖ : ℝ) : ℂ)‖ := by
    intro v hv
    simpa using hφ v (hLS v hv)
  have htone := Hν.tonelli L hLS hL (fun a => ((‖f a‖ : ℝ) : ℂ)) (fun v m => ((‖φ v m‖ : ℝ) : ℂ))
    hf.norm.ofReal hφ'
  have hC : ((∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) :
          Set (AdeleRing (𝓞 F) F)ˣ), ‖Z a‖ ∂ν : ℝ) : ℂ) =
      (Hν.c : ℂ) * ((∫ a, ‖f a‖ ∂Hν.νS : ℝ) : ℂ) * (L.map fun v => ((∑' m : ℤ, ‖φ v m‖ : ℝ) : ℂ)).prod :=
    calc ((∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) :
            Set (AdeleRing (𝓞 F) F)ˣ), ‖Z a‖ ∂ν : ℝ) : ℂ)
        = ∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) :
            Set (AdeleRing (𝓞 F) F)ˣ), ((‖Z a‖ : ℝ) : ℂ) ∂ν := integral_ofReal.symm
      _ = ∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) :
            Set (AdeleRing (𝓞 F) F)ˣ),
            (((‖f (Hν.projS a)‖ : ℝ) : ℂ) * (L.map fun v => ((‖φ v (Hν.ord v a)‖ : ℝ) : ℂ)).prod) ∂ν :=
          setIntegral_congr_fun hmeas hpt
      _ = (Hν.c : ℂ) * (∫ a, ((‖f a‖ : ℝ) : ℂ) ∂Hν.νS) * (L.map fun v => ∑' m : ℤ, ((‖φ v m‖ : ℝ) : ℂ)).prod :=
          htone.2
      _ = (Hν.c : ℂ) * ((∫ a, ‖f a‖ ∂Hν.νS : ℝ) : ℂ) * (L.map fun v => ((∑' m : ℤ, ‖φ v m‖ : ℝ) : ℂ)).prod := by
          simp only [integral_complex_ofReal, Complex.ofReal_tsum]
  have hreal : (∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}) :
          Set (AdeleRing (𝓞 F) F)ˣ), ‖Z a‖ ∂ν) =
      Hν.c * (∫ a, ‖f a‖ ∂Hν.νS) * (L.map fun v => ∑' m : ℤ, ‖φ v m‖).prod := by
    apply Complex.ofReal_injective
    rw [hC, Complex.ofReal_mul, Complex.ofReal_mul, ofReal_map_prod]
  have hbound : (L.map fun v => ∑' m : ℤ, ‖φ v m‖).prod ≤ Real.exp (∑' v, c v) := by
    rw [← List.prod_toFinset _ hL]
    refine (Finset.prod_le_prod (fun v _ => tsum_nonneg fun m => norm_nonneg _) fun v hv => ?_).trans
      (prod_one_add_le_exp_tsum hc0 hc _)
    exact hφc v (hLS v (List.mem_toFinset.1 hv))
  rw [hreal]
  exact mul_le_mul_of_nonneg_left hbound (mul_nonneg Hν.c_pos.le (integral_nonneg fun a => norm_nonneg _))

end

