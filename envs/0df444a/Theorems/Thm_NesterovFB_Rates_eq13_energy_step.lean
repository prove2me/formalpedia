-- title:
--   (13), p. 3 — E(k+1) + 2s(α−3)/(α−1)·k(Θ(x_k) − Θ(x*)) ≤ E(k)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, $\Psi:\mathcal H\to\mathbb R\cup\{+\infty\}$ proper, lower semicontinuous and convex, $\Phi:\mathcal H\to\mathbb R$ convex and continuously differentiable with $L$-Lipschitz gradient, $\Theta=\Psi+\Phi$, and $0<s<1/L$. Let $\alpha\ge3$ and let $(x_k)$ be generated by algorithm (2), $y_k=x_k+\frac{k-1}{k+\alpha-1}(x_k-x_{k-1})$, $x_{k+1}=\operatorname{prox}_{s\Psi}(y_k-s\nabla\Phi(y_k))$. Let $x^*$ be a minimizer of $\Theta$ and let $\mathcal E(k)$ be the energy (5),
--   $$\mathcal E(k)=\frac{2s}{\alpha-1}(k+\alpha-2)^2\big(\Theta(x_k)-\Theta(x^*)\big)+(\alpha-1)\|z_k-x^*\|^2,\qquad z_k=x_k+\frac{k-1}{\alpha-1}(x_k-x_{k-1}).$$
--   Then for every $k\ge1$,
--   $$\mathcal E(k+1)+2s\,\frac{\alpha-3}{\alpha-1}\,k\,\big(\Theta(x_k)-\Theta(x^*)\big)\le\mathcal E(k).$$
--
--   This is the Lyapunov property of $\mathcal E$ from which Facts 1–3 are deduced.
--
--   **Formalization Note.** $0<s<1/L$ is written $sL<1$ with $L\ge0$, so $L=0$ is allowed. All quantities involving $\Theta$ are extended reals; at $k=1$, $\Theta(x_1)$ may be $+\infty$ (the starting point is arbitrary), and then $\mathcal E(1)=+\infty$ and the inequality is trivially true. The run is required to follow (2) from $k=1$ on (see the definitions file).
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 3, (13)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem eq13_energy_step {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 ≤ α)
    (xstar : H) (hxstar : ∀ y, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k → energy Ψ Φ α s x xstar (k + 1)
      + ((2 * s * (α - 3) / (α - 1) * (k : ℝ) : ℝ) : EReal) * (theta Ψ Φ (x k) - theta Ψ Φ xstar)
      ≤ energy Ψ Φ α s x xstar k := by sorry

end NesterovFB.Rates
