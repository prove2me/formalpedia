/-!
# EML density as a functional-analytic uniqueness principle

The EML fragment used here consists of constants, field operations, and exponentials
of coordinate functions.  It is therefore contained in the class generated by exp,
log, and field operations (log is not needed for density).

The first result applies Stone–Weierstrass to prove density on every compact space
which embeds in finite-dimensional Euclidean space, hence in particular on
`[0,1]^n`.  The connector theorem then bridges approximation theory and functional
analysis: a continuous linear observable on `C(X, ℝ)` is completely determined by
its values on this EML algebra.

A final pair of results gives an explicit shallow, one-exponential approximation to
`x²` on `[0,1]`, with uniform error at most `4/(9n)` at scale `1/n`.
-/

noncomputable section

open scoped NNReal Topology
open Set Real ContinuousMap

open EMLDensityFunctionalAnalysisBridge










/-- Taylor remainder estimate used by the shallow approximation. -/
theorem exp_quadratic_remainder (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    |Real.exp u - (1 + u + u ^ 2 / 2)| ≤ (2 / 9) * u ^ 3 := by
  have h := Real.exp_bound
    (show |u| ≤ 1 by simpa [abs_of_nonneg hu0] using hu1)
    (show 0 < 3 by norm_num)
  norm_num [Finset.sum_range_succ, abs_of_nonneg hu0] at h ⊢
  linarith




open EMLDensityFunctionalAnalysisBridge in
theorem solution(h : ℝ) (hh0 : 0 < h) (hh1 : h ≤ 1)
    (x : ℝ) (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    |shallowSquareApprox h x - x ^ 2| ≤ (4 / 9) * h := by
  have hid : shallowSquareApprox h x - x ^ 2 =
      (2 / h ^ 2) * (Real.exp (h * x) - (1 + h * x + (h * x) ^ 2 / 2)) := by
    have hh : h ≠ 0 := hh0.ne'
    unfold shallowSquareApprox
    field_simp
    ring
  rw [hid, abs_mul, abs_of_pos (by positivity)]
  have ht := exp_quadratic_remainder (h * x)
    (mul_nonneg hh0.le hx.1) (mul_le_one₀ hh1 hx.1 hx.2)
  rw [div_mul_eq_mul_div, div_le_iff₀] <;>
    nlinarith [abs_nonneg (Real.exp (h * x) - (1 + h * x + (h * x) ^ 2 / 2)),
      pow_two_nonneg (h * x), pow_two_nonneg (h * x - 2),
      pow_two_nonneg (h * x - 1), pow_two_nonneg (h * x + 1),
      pow_two_nonneg (h * x + 2),
      mul_le_mul_of_nonneg_left (show x ^ 3 ≤ 1 by exact pow_le_one₀ hx.1 hx.2) hh0.le]
