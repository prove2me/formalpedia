set_option autoImplicit false

open LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

theorem LPCA.vertexDeletionNegativeOneInterval (rank : V ↪ ℕ)
    (K : Complex V) (f : Finset V → ℝ) (hf : FiltrationMonotone K f)
    (i : V) (σ : Finset {v : V // v ≠ i}) :
    Nonempty (supportCohomologyPiecePersistence k rank K f hf (vertexSupport i)
        (extendVertexDegree i 0 (squarefreeNegativeDegree σ)) σ.card ≅
      intervalPersistence k
        (faceCofaceInterval K f (σ.map (complementEmbedding i))
          (Finset.univ.map (complementEmbedding i)))
        (faceCofaceInterval_isInterval K f (σ.map (complementEmbedding i))
          (Finset.univ.map (complementEmbedding i)))) := by sorry
