/-! ## Bounds -/

theorem num_natAbs_lt (W Xb : ℕ) {bt d1 d2 : ℤ} (hbt : zsz bt ≤ Xb) (hW : Xb ≤ W)
    (h1 : d1.natAbs < 2 ^ W) (h2 : d2.natAbs < 2 ^ W) : (bt - d1 - d2).natAbs < 2 ^ (W + 2) := by
  have hb := zsz_le_iff.1 hbt
  have : 2 ^ Xb ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW
  have e : 2 ^ (W + 2) = 4 * 2 ^ W := by rw [pow_add]; ring
  have := Int.natAbs_sub_le (bt - d1) d2
  have := Int.natAbs_sub_le bt d1
  omega

theorem N_natAbs_lt (W P Xb : ℕ) {num pv : ℤ} (hnum : num.natAbs < 2 ^ (W + 2))
    (hpv : zsz pv ≤ Xb) (hW : Xb ≤ W) : (2 * (num * 2 ^ P) + pv).natAbs < 2 ^ (W + P + 4) := by
  have hp := zsz_le_iff.1 hpv
  have : 2 ^ Xb ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW
  have e : 2 ^ (W + P + 4) = 4 * (2 ^ (W + 2) * 2 ^ P) := by rw [pow_add, pow_add, pow_add]; ring
  have h1 := Int.natAbs_add_le (2 * (num * 2 ^ P)) pv
  have h2 : (2 * (num * 2 ^ P)).natAbs = 2 * (num.natAbs * 2 ^ P) := by
    rw [Int.natAbs_mul, Int.natAbs_mul, Int.natAbs_pow]; rfl
  have h3 : num.natAbs * 2 ^ P < 2 ^ (W + 2) * 2 ^ P := Nat.mul_lt_mul_of_pos_right hnum (by positivity)
  have h4 : 2 ^ W ≤ 2 ^ (W + 2) * 2 ^ P := by
    calc 2 ^ W ≤ 2 ^ (W + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
      _ ≤ 2 ^ (W + 2) * 2 ^ P := Nat.le_mul_of_pos_right _ (by positivity)
  omega

theorem ivOf_nonneg (k : ℕ) {pv : ℤ} (hpv : 0 < pv) : 0 ≤ ivOf k pv :=
