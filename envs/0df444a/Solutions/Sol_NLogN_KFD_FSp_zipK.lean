/-!
# KFD: fine element loops

Fine (`FSp`) versions of the element loops of KIL3Ops (`dupK`, `dropK`, `zeroK`, `zipK`), of
`mvK` with a register count, and of the conditional / `c`-way branch (`sel`).  The per-element
cost depends only on a *data bound* `w` (bits: `w = 1`); the count enters only through the
loop overhead `cRep N = O(N + zsz N)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL

/-! ## Expression costs -/

theorem cost_lit (t : IState HS) (c : ℤ) : (Ex.lit (S := HS) c).cost t = zsz c + 2 := rfl

theorem cRep_le {N Bb : ℕ} (h : zsz (N : ℤ) ≤ Bb) : cRep N ≤ 400 * (Bb + 2) + 1100 * N + 400 := by
  unfold cRep; omega

/-- Fine counted loop with a literal count. -/
theorem FSp.repLit {C : Fin HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ}
    {N c Bb : ℕ} (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes)
    (hNB : zsz (N : ℤ) ≤ Bb)
    (hb : ∀ k < N, FSp b (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) c) :
    FSp (.rep C (.lit (N : ℤ)) b) (encK s (F 0)) (encK s (F N)) (cLp N c Bb) := by
  have H := FSp.rep (n := .lit (N : ℤ)) hC5 hC hw (clean_lit _) trivial rfl hb
  refine H.mono ?_
  rw [cost_lit]
  have := cRep_le hNB
  unfold cLp; nlinarith

/-! ## Moves with a register count -/

/-! ## `dupK`, `dropK`, `zeroK`, `zipK` -/

theorem zsz_four : zsz ((2 * 2 : ℕ) : ℤ) ≤ 3 := zsz_le_of_lt (by norm_num)

theorem FSp.zipK_sol_aux {A Z O C : Fin HS} (hAZ : A ≠ Z) (hAO : A ≠ O) (hZO : Z ≠ O) (hAC : A ≠ C)
    (hZC : Z ≠ C) (hOC : O ≠ C) (hA5 : A.val < 56) (hZ5 : Z.val < 56) (hO5 : O.val < 56)
    (hC5 : C.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (a b la lb : List ℤ)
    (hfA : f A = a ++ la) (hfZ : f Z = b ++ lb) (hab : a.length = b.length)
    (ha : Bits a) (hb : Bits b) (hfC : f C = []) (Bb : ℕ)
    (hn : zsz (a.length : ℤ) ≤ Bb) :
    FSp (zipK A Z O C a.length) (encK s f)
      (encK s (Function.update (Function.update (Function.update f A la) Z lb) O
        ((List.zipWith xr a b).reverse ++ f O))) (cLp a.length 200000 Bb) := by
  have hB1 : 1 ≤ 3 := by norm_num
  have H := FSp.repLit (C := C) (s := s) (F := zipSt f A Z O a b la lb)
    (N := a.length) (Bb := Bb) (c := 200000)
    (b := .seq (.push O (mAdd 2 (.reg A) (.reg Z))) (.seq (.pop A) (.pop Z))) hC5
    (fun k => by simp [zipSt, Function.update_apply, hAC.symm, hZC.symm, hOC.symm, hfC])
    (by simp [RS.writes, hAC.symm, hZC.symm, hOC.symm]) hn ?_
  · have e0 : zipSt f A Z O a b la lb 0 = f := by
      funext j; simp only [zipSt, Function.update_apply]
      split_ifs <;> simp_all
    have e1 : zipSt f A Z O a b la lb a.length = Function.update (Function.update
        (Function.update f A la) Z lb) O ((List.zipWith xr a b).reverse ++ f O) := by
      have h1 : List.take a.length b = b := List.take_of_length_le (by omega)
      have h2 : List.take a.length a = a := List.take_of_length_le le_rfl
      simp only [zipSt, List.drop_length, List.nil_append, h1, h2,
        List.drop_of_length_le (show b.length ≤ a.length by omega)]
    rw [e0, e1] at H
    exact H
  · intro k hk
    have hk' : k < b.length := hab ▸ hk
    have hda : a.drop k = a[k] :: a.drop (k + 1) := List.drop_eq_getElem_cons hk
    have hdb : b.drop k = b[k] :: b.drop (k + 1) := List.drop_eq_getElem_cons hk'
    have hta : a.take (k + 1) = a.take k ++ [a[k]] := (List.take_concat_get' a k hk).symm
    have htb : b.take (k + 1) = b.take k ++ [b[k]] := (List.take_concat_get' b k hk').symm
    obtain ⟨G, hG⟩ : ∃ G, G = Function.update (zipSt f A Z O a b la lb k) C
        [(a.length : ℤ) - k] := ⟨_, rfl⟩
    rw [← hG]
    have hGA : G A = a[k] :: (a.drop (k + 1) ++ la) := by
      simp only [hG, zipSt, Function.update_apply, if_neg hAC, if_neg hAO, if_neg hAZ, if_true,
        hda, List.cons_append]
    have hGZ : G Z = b[k] :: (b.drop (k + 1) ++ lb) := by
      simp only [hG, zipSt, Function.update_apply, if_neg hZC, if_neg hZO, if_true,
        hdb, List.cons_append]
    have hak := ha _ (List.getElem_mem hk)
    have hbk := hb _ (List.getElem_mem hk')
    have za := zsz_bit hak hB1
    have zb := zsz_bit hbk hB1
    have h1 := Sp.push s G (i := O) (e := mAdd 2 (.reg A) (.reg Z)) (B := 3) hO5
      (mAdd_clean 2 (clean_reg hA5) (clean_reg hZ5)) (mAdd_ok (ok_reg hGA) (ok_reg hGZ))
      (mAdd_lin 2 trivial trivial)
      (mAdd_bnd (bnd_reg hGA za) (bnd_reg hGZ zb)
        (by rw [eval_reg hGA]; rcases hak with h | h <;> rw [h] <;> norm_num)
        (by rw [eval_reg hGA]; rcases hak with h | h <;> rw [h] <;> norm_num)
        (by rw [eval_reg hGZ]; rcases hbk with h | h <;> rw [h] <;> norm_num)
        (by rw [eval_reg hGZ]; rcases hbk with h | h <;> rw [h] <;> norm_num) zsz_four)
    rw [mAdd_eval, eval_reg hGA, eval_reg hGZ] at h1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G O (xr a[k] b[k] :: G O) := ⟨_, rfl⟩
    rw [show (if a[k] + b[k] + -((2 : ℕ) : ℤ) < 0 then a[k] + b[k] else
      a[k] + b[k] + -((2 : ℕ) : ℤ)) = xr a[k] b[k] from rfl, ← hG1] at h1
    have hG1A : G1 A = a[k] :: (a.drop (k + 1) ++ la) := by
      rw [hG1, Function.update_apply, if_neg hAO, hGA]
    have h2 := Sp.pop s G1 (i := A) (B := 3) hA5 hG1A za
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 A (a.drop (k + 1) ++ la) := ⟨_, rfl⟩
    rw [← hG2] at h2
    have hG2Z : G2 Z = b[k] :: (b.drop (k + 1) ++ lb) := by
      rw [hG2, Function.update_apply, if_neg hAZ.symm, hG1, Function.update_apply, if_neg hZO, hGZ]
    have h3 := Sp.pop s G2 (i := Z) (B := 3) hZ5 hG2Z zb
    have H3 := FSp.of_norep rfl (h1.seq (h2.seq h3))
    refine FSp.mono (FSp.congr H3 ?_) (by simp only [Ex.size, mAdd_size]; omega)
    congr 1
    funext j
    simp only [hG2, hG1, hG, zipSt, Function.update_apply]
    by_cases h1 : j = Z
    · simp only [h1, if_true, if_neg hAZ.symm, if_neg hZO, if_neg hZC]
    by_cases h2 : j = A
    · simp only [h2, if_true, if_neg hAO, if_neg hAC]
    by_cases h3 : j = O
    · simp only [h3, if_true, if_neg hAO.symm, if_neg hZO.symm, if_neg hOC]
      rw [hta, htb, List.zipWith_append (by simp [List.length_take]; omega)]
      simp
    · simp only [h1, h2, h3, if_false]

/-! ## Conditionals and the `c`-way branch -/

