-- title:
--   Lemma 12 — the cluster set Ω of (x^k, z^k, y^k, x^{k−1}, y^{k−1}) lies on the diagonal over crit(L_r), with F_r ≡ F_* on Ω
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$, generated by Algorithm 1 or Algorithm 2, is bounded. Let $\Omega$ be the set of cluster points of $\{(x^k,z^k,y^k,x^{k-1},y^{k-1})\}_{k\ge1}$. Then:
--   1. $\Omega\subseteq\{(\hat x,\hat z,\hat y,\hat x,\hat y):(\hat x,\hat z,\hat y)\in\mathrm{crit}(L_r)\}$;
--   2. $\operatorname{dist}((x^k,z^k,y^k,x^{k-1},y^{k-1}),\Omega)\to0$;
--   3. $\Omega$ is nonempty, connected and compact;
--   4. $F_r$ takes on $\Omega$ the value $F_*=\lim_k F_k$, as does $g\circ A+h$ on the projection of $\Omega$ onto $\mathbb R^n$ (first component).
--
--   These are the properties of the limit set needed to apply the uniformized KL property to $F_r$.
--
--   **Formalization Note** The lifted sequence is indexed as $k\mapsto(x^{k+1},z^{k+1},y^{k+1},x^k,y^k)$, $k\ge0$, which has the same cluster set and the same distance limit. Distances are in the Euclidean 5-fold product.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, pp. 19–20, Lemma 12

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 12 (pp. 19–20). Under Assumption 1, let `{(xᵏ, zᵏ, yᵏ)}` be a bounded sequence
generated by Algorithm 1 or Algorithm 2 and `Ω := ω({(xᵏ, zᵏ, yᵏ, xᵏ⁻¹, yᵏ⁻¹)}_{k≥1})` (the
lifted sequence is indexed here as `k ↦ (xᵏ⁺¹, zᵏ⁺¹, yᵏ⁺¹, xᵏ, yᵏ)`, `k ≥ 0`). Then
(i) `Ω ⊆ {(x̂, ẑ, ŷ, x̂, ŷ) : (x̂, ẑ, ŷ) ∈ crit(L_r)}`;
(ii) `dist((xᵏ, zᵏ, yᵏ, xᵏ⁻¹, yᵏ⁻¹), Ω) → 0`;
(iii) `Ω` is nonempty, connected and compact;
(iv) `F_r` takes on `Ω` the value `F_* = lim F_k`, as `g ∘ A + h` does on the projection of `Ω`
onto `ℝⁿ` (first component). -/
theorem lemma_12 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y)
    (hbdd : Bornology.IsBounded (Set.range fun k => pack3 (x k) (z k) (y k))) :
    (∀ u ∈ clusterSet (fun k => pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k)),
      qx' u = qx u ∧ qy' u = qy u ∧ pack3 (qx u) (qz u) (qy u) ∈ critLr P) ∧
    Tendsto (fun k => Metric.infDist (pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k))
      (clusterSet (fun k => pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k))))
      atTop (𝓝 0) ∧
    IsConnected (clusterSet (fun k => pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k))) ∧
    IsCompact (clusterSet (fun k => pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k))) ∧
    ∃ Fstar : ℝ,
      Tendsto (Fseq v P x z y) atTop (𝓝 (Fstar : EReal)) ∧
      ∀ u ∈ clusterSet (fun k => pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k)),
        Fr v P u = (Fstar : EReal) ∧ P.g (P.A (qx u)) + (P.h (qx u) : EReal) = (Fstar : EReal) := by sorry

end BotNguyenADMM.KL
