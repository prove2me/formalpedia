  letI algB : Algebra Pet.B₀ k := ψet.toRingHom.toAlgebra
  obtain ⟨φc, hφc, hcoef⟩ := WeierstrassProjModel.exists_isCoefficientHom xet.curve ψet.toRingHom
  have hsq := WeierstrassCurve.DrinfeldGlobal.projMap_comp_projModelStrCR_of_isCoefficientHom
    xet.curve ψet.toRingHom φc hφc hcoef
  have hPov : (((𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k)))).1 ≫
      eqToHom (congrArg projModelCR rfl) ≫ Proj.map φc hφc) ≫ projModelStrCR xet.curve =
      Spec.map (CommRingCat.ofHom ψet.toRingHom) := by
    rw [eqToHom_refl, Category.id_comp, Category.assoc, hsq, ← Category.assoc,
      ((𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k)))).2, Category.id_comp]
  have hQov : (Qk.1 ≫ eqToHom (congrArg projModelCR rfl) ≫ Proj.map φc hφc) ≫ projModelStrCR xet.curve =
      Spec.map (CommRingCat.ofHom ψet.toRingHom) := by
    rw [eqToHom_refl, Category.id_comp, Category.assoc, hsq, ← Category.assoc, Qk.2, Category.id_comp]
  have hdict := WeierstrassCurve.DrinfeldGlobal.isLevel_iff_isDrinfeldBasisOver_comp_projMap q
    (𝒢.restrictScalars W₀) h𝒢Or Pet.B₀ xet.curve xet.isUnit_Δ k ψet φc hφc hcoef hsq
    ⟨xet.curve.map ψet.toRingHom, (𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k))), Qk⟩
    rfl hPov hQov
  have hykr : RawDrinfeldPair.IsLevel (𝒢.restrictScalars W₀) q (xet.curve.map ψet.toRingHom)
      ⟨xet.curve.map ψet.toRingHom, (𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k))), Qk⟩ :=
    hyk
