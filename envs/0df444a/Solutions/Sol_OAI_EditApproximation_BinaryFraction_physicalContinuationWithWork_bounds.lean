namespace OAI

/-! Polynomial per-child bit work before the explicitly counted Cartesian
product. All interval endpoints and arities are bounded by their input
word sizes; no good-seed premise occurs in these bounds. -/

namespace EditApproximation

theorem balancedCutWithWork_cost (lo width M i B : ℕ) (hM : 0 < M)
    (hl : Nat.size lo ≤ B) (hw : Nat.size width ≤ B)
    (hm : Nat.size M ≤ B) (hi : Nat.size i ≤ B) :
    (balancedCutWithWork lo width M i).2 ≤ 1000 * (B + 1) ^ 2 := by
  let product := binaryNaturalMulWithWork i width
  let quotient := binaryNaturalDivModWithWork (bitWordValue product.1) M
  have hp := binaryNaturalMulWithWork_cost i width
  have hpl := bitMulWithWork_length i.bits width.bits
  have hps : Nat.size (bitWordValue product.1) ≤ 3 * B + 1 := by
    have hv : Nat.size (bitWordValue product.1) ≤ product.1.length :=
      Nat.size_le.mpr (bitWordValue_lt_pow_length _)
    change product.1.length ≤ _ at hpl
    simp only [Nat.size_eq_bits_len] at hpl
    omega
  have hq := binaryNaturalDivModWithWork_cost (bitWordValue product.1) M
  have hqs : Nat.size (bitWordValue quotient.1) ≤ 3 * B + 1 := by
    rw [(binaryNaturalDivModWithWork_spec _ M hM).1]
    exact (Nat.size_le_size (Nat.div_le_self _ _)).trans hps
  have ha := binaryNaturalAddWithWork_cost lo (bitWordValue quotient.1)
  change product.2 + quotient.2.2 + (binaryNaturalAddWithWork lo (bitWordValue quotient.1)).2 + 2 ≤ _
  nlinarith only [hp, hq, ha, hps, hqs, hl, hw, hm, hi, Nat.zero_le B]

theorem sourceChildWithWork_cost {n M : ℕ} (parent : TargetInterval n) (i : Fin M)
    (B : ℕ) (hn : Nat.size n ≤ B) (hm : Nat.size M ≤ B) :
    (sourceChildWithWork parent i).2 ≤ 2200 * (B + 3) ^ 2 := by
  have hlo := (Nat.size_le_size (parent.ordered.trans parent.valid)).trans hn
  have hhi := (Nat.size_le_size parent.valid).trans hn
  have hi := (Nat.size_le_size i.isLt.le).trans hm
  let width := saturatingSubtractWithWork parent.hi parent.lo
  let next := binaryNaturalAddWithWork i.val 1
  have hwidth : Nat.size (bitWordValue width.1) ≤ B := by
    rw [saturatingSubtractWithWork_value]
    exact (Nat.size_le_size (Nat.sub_le _ _)).trans hhi
  have hnext : Nat.size (bitWordValue next.1) ≤ B + 2 := by
    rw [binaryNaturalAddWithWork_value]
    have h := binaryNaturalAdd_size_le i.val 1
    simp only [Nat.size_one] at h
    have hMpos : 1 ≤ Nat.size M := Nat.size_pos.mpr (Nat.zero_lt_of_lt i.isLt)
    omega
  have hleft := balancedCutWithWork_cost parent.lo (bitWordValue width.1) M i.val (B + 2)
    (Nat.zero_lt_of_lt i.isLt) (by omega) (by omega) (by omega) (by omega)
  have hright := balancedCutWithWork_cost parent.lo (bitWordValue width.1) M
    (bitWordValue next.1) (B + 2) (Nat.zero_lt_of_lt i.isLt)
    (by omega) (by omega) (by omega) hnext
  have hsub := saturatingSubtractWithWork_cost parent.hi parent.lo
  have hadd := binaryNaturalAddWithWork_cost i.val 1
  change width.2 + next.2 + _ + _ + 4 ≤ _
  change width.2 ≤ _ at hsub
  change next.2 ≤ _ at hadd
  simp only [Nat.size_one] at hadd
  nlinarith only [hleft, hright, hsub, hadd, hlo, hhi, hi, Nat.zero_le B]

end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryWideChildWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Every child-grid list is constructed before the Cartesian product.
These bounds include the balanced endpoints, integer spacing and radius,
endpoint translations, and the two bounded grid loops. -/

namespace EditApproximation

theorem seedGridSpacingWithWork_bounds (b P B : ℕ)
    (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (seedGridSpacingWithWork b P).1.length ≤ B + 1 ∧
      (seedGridSpacingWithWork b P).2 ≤ 100 * (B + 2) ^ 2 := by
  let quotient := binaryNaturalDivModWithWork b P
  have hl := (bitDivModWithWork_lengths P.bits b.bits).1
  change quotient.1.length = b.bits.length at hl
  rw [Nat.size_eq_bits_len] at hl
  have hd := binaryNaturalDivModWithWork_cost b P
  have ht := wordLEWithWork_cost quotient.1 [true]
  change quotient.2.2 ≤ _ at hd
  simp only [List.length_cons, List.length_nil] at ht
  unfold seedGridSpacingWithWork
  dsimp only
  constructor
  · split_ifs
    · simp only [List.length_cons, List.length_nil]
      omega
    · change quotient.1.length ≤ B + 1
      omega
  · change quotient.2.2 + (wordLEWithWork quotient.1 [true]).2 + 2 ≤ _
    nlinarith only [hd, ht, hl, hb, hP, Nat.zero_le B]

theorem gridStateBoxBitBudget_mono_count (k l B : ℕ) (h : k ≤ l) :
    gridStateBoxBitBudget k B ≤ gridStateBoxBitBudget l B := by
  unfold gridStateBoxBitBudget gridPointsBitBudget
  gcongr

theorem wideChildGridWithWork_cost {nx ny M : ℕ} (parent : TargetInterval nx)
    (r : TargetInterval ny) (b P B : ℕ) (i : Fin M) (hPpos : 0 < P)
    (hnx : Nat.size nx ≤ B) (hny : Nat.size ny ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (wideChildGridWithWork parent r b P i).2 ≤ wideChildGridBitBudget P B := by
  let child := sourceChildWithWork parent i
  let spacing := seedGridSpacingWithWork b P
  let radius := binaryNaturalMulWithWork 10 b
  let leftOffset := saturatingSubtractWithWork child.1.lo parent.lo
  let rightOffset := saturatingSubtractWithWork child.1.hi parent.lo
  let left := binaryNaturalAddWithWork r.lo (bitWordValue leftOffset.1)
  let right := binaryNaturalAddWithWork r.lo (bitWordValue rightOffset.1)
  have hparent : Nat.size parent.lo ≤ B :=
    (Nat.size_le_size (parent.ordered.trans parent.valid)).trans hnx
  have hcl : Nat.size child.1.lo ≤ B :=
    (Nat.size_le_size (child.1.ordered.trans child.1.valid)).trans hnx
  have hch : Nat.size child.1.hi ≤ B := (Nat.size_le_size child.1.valid).trans hnx
  have hrlo : Nat.size r.lo ≤ B := (Nat.size_le_size (r.ordered.trans r.valid)).trans hny
  have hlo : Nat.size (bitWordValue leftOffset.1) ≤ B := by
    rw [saturatingSubtractWithWork_value]
    exact (Nat.size_le_size (Nat.sub_le _ _)).trans hcl
  have hro : Nat.size (bitWordValue rightOffset.1) ≤ B := by
    rw [saturatingSubtractWithWork_value]
    exact (Nat.size_le_size (Nat.sub_le _ _)).trans hch
  have hleft : Nat.size (bitWordValue left.1) ≤ B + 2 := by
    rw [binaryNaturalAddWithWork_value]
    exact (binaryNaturalAdd_size_le _ _).trans (by omega)
  have hright : Nat.size (bitWordValue right.1) ≤ B + 2 := by
    rw [binaryNaturalAddWithWork_value]
    exact (binaryNaturalAdd_size_le _ _).trans (by omega)
  have hspacing := seedGridSpacingWithWork_bounds b P B hb hP
  have hspacingCost : spacing.2 ≤ 100 * (B + 2) ^ 2 := hspacing.2
  have hgs : Nat.size (bitWordValue spacing.1) ≤ B + 1 :=
    (Nat.size_le.mpr (bitWordValue_lt_pow_length spacing.1)).trans hspacing.1
  have hrl := bitMulWithWork_length (10 : ℕ).bits b.bits
  change radius.1.length ≤ _ at hrl
  simp only [Nat.size_eq_bits_len] at hrl
  have hten : Nat.size 10 = 4 := by decide
  rw [hten] at hrl
  have hrs : Nat.size (bitWordValue radius.1) ≤ B + 9 :=
    (Nat.size_le.mpr (bitWordValue_lt_pow_length radius.1)).trans (by omega)
  have hg := seedGridSpacingWithWork_pos b P hPpos
  have hgrid := gridStateBoxWithWork_cost ny (bitWordValue spacing.1) (bitWordValue radius.1)
    (bitWordValue left.1) (bitWordValue right.1) (B + 12) hg
    (by omega) (by omega) (by omega) (by omega) (by omega)
  have hcount : 2 * bitWordValue radius.1 / bitWordValue spacing.1 + 2 ≤ 40 * P + 2 := by
    rw [binaryNaturalMulWithWork_value, seedGridSpacingWithWork_value b P hPpos]
    simpa only [show 2 * (10 * b) = 20 * b by omega] using seedGridSpacing_radius_count b P hPpos
  have hgrid' := hgrid.trans (gridStateBoxBitBudget_mono_count _ _ (B + 12) hcount)
  have hc := sourceChildWithWork_cost parent i B hnx hM
  have hrad := binaryNaturalMulWithWork_cost 10 b
  have hol := saturatingSubtractWithWork_cost child.1.lo parent.lo
  have hor := saturatingSubtractWithWork_cost child.1.hi parent.lo
  have hal := binaryNaturalAddWithWork_cost r.lo (bitWordValue leftOffset.1)
  have har := binaryNaturalAddWithWork_cost r.lo (bitWordValue rightOffset.1)
  change child.2 ≤ _ at hc
  change radius.2 ≤ _ at hrad
  change leftOffset.2 ≤ _ at hol
  change rightOffset.2 ≤ _ at hor
  change left.2 ≤ _ at hal
  change right.2 ≤ _ at har
  rw [hten] at hrad
  change child.2 + spacing.2 + radius.2 + leftOffset.2 + rightOffset.2 + left.2 + right.2 + _ + 8 ≤ _
  unfold wideChildGridBitBudget
  nlinarith only [hc, hspacingCost, hrad, hol, hor, hal, har, hgrid', hcl, hch, hparent,
    hrlo, hlo, hro, hb, Nat.zero_le B]

end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryRepresentativeWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Bounds for the executed representative scores and velocity. They use
only the widths of actual stored inputs, and apply on every seed. -/

namespace EditApproximation
namespace BinaryFraction

open Finset

theorem endpointDistanceWithWork_bounds {n : ℕ} (q r : TargetInterval n) (B : ℕ)
    (hql : Nat.size q.lo + 2 ≤ B) (hqh : Nat.size q.hi + 2 ≤ B)
    (hrl : Nat.size r.lo + 2 ≤ B) (hrh : Nat.size r.hi + 2 ≤ B) :
    (endpointDistanceWithWork q r).1.width ≤ endpointDistanceWordBudget B ∧
      (endpointDistanceWithWork q r).2 ≤ endpointDistanceBitBudget B := by
  have hlw := distanceWithWork_width (nat q.lo) (nat r.lo) B
    ((nat_width_le _).trans hql) ((nat_width_le _).trans hrl)
  have hhw := distanceWithWork_width (nat q.hi) (nat r.hi) B
    ((nat_width_le _).trans hqh) ((nat_width_le _).trans hrh)
  have hlc := distanceWithWork_cost (nat q.lo) (nat r.lo) B
    ((nat_width_le _).trans hql) ((nat_width_le _).trans hrl)
  have hhc := distanceWithWork_cost (nat q.hi) (nat r.hi) B
    ((nat_width_le _).trans hqh) ((nat_width_le _).trans hrh)
  have hw := canonicalAddWithWork_width (distanceWithWork (nat q.lo) (nat r.lo)).1
    (distanceWithWork (nat q.hi) (nat r.hi)).1 (8 * B + 6) hlw hhw
  have hc := canonicalAddWithWork_cost (distanceWithWork (nat q.lo) (nat r.lo)).1
    (distanceWithWork (nat q.hi) (nat r.hi)).1 (8 * B + 6) hlw hhw
  constructor
  · change (canonicalAddWithWork (distanceWithWork (nat q.lo) (nat r.lo)).1
      (distanceWithWork (nat q.hi) (nat r.hi)).1).1.width ≤ endpointDistanceWordBudget B
    unfold endpointDistanceWordBudget
    omega
  · change _ + _ + _ + _ + _ + _ + _ + 3 ≤ _
    simp only [Nat.add_assoc, Nat.reduceAdd] at hc
    unfold endpointDistanceBitBudget
    omega

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryPreparedRepresentativeWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Complete representative work, with every endpoint grid construction
and every score/prefix predicate charged. Only input word bounds occur. -/

namespace EditApproximation
namespace BinaryFraction

theorem wideActionGridWithWork_complete_cost {nx ny : ℕ} (M : ℕ)
    (parent : TargetInterval nx) (center : TargetInterval ny) (b P B : ℕ)
    (hPpos : 0 < P) (hnx : Nat.size nx ≤ B) (hny : Nat.size ny ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (wideActionGridWithWork M parent center b P).2 ≤ wideMaterializationBitBudget M P B :=
  wideActionGridWithWork_cost M parent center b P _ hPpos
    (fun i => wideChildGridWithWork_cost parent center b P B i hPpos hnx hny hM hb hP)

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryWideActionsWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! The full wide-action list materializes each grid and each connection
charge. Endpoint representation bounds follow from the interval subtype. -/

namespace EditApproximation
namespace BinaryFraction

theorem endpointActionWithWork_bounds {n M : ℕ} (center : TargetInterval n)
    (states : Fin M → TargetInterval n) (B : ℕ) (hn : Nat.size n + 2 ≤ B) :
    (endpointActionWithWork center states).1.connection.width ≤ connectionWordBudget M B ∧
      (endpointActionWithWork center states).2 ≤ connectionBitBudget M B + 2 * B + 2 * M + 3 := by
  have hlo : (nat center.lo).width ≤ B := (nat_width_le center.lo).trans
    ((Nat.add_le_add_right (Nat.size_le_size (center.ordered.trans center.valid)) 2).trans hn)
  have hhi : (nat center.hi).width ≤ B := (nat_width_le center.hi).trans
    ((Nat.add_le_add_right (Nat.size_le_size center.valid) 2).trans hn)
  have hs : ∀ q ∈ List.ofFn states, Nat.size q.lo + 2 ≤ B ∧ Nat.size q.hi + 2 ≤ B := by
    intro q _
    exact ⟨(Nat.add_le_add_right (Nat.size_le_size (q.ordered.trans q.valid)) 2).trans hn,
      (Nat.add_le_add_right (Nat.size_le_size q.valid) 2).trans hn⟩
  have hw := connectionWithWork_width (nat center.lo) (nat center.hi) (List.ofFn states) B hlo hhi hs
  have hc := connectionWithWork_cost (nat center.lo) (nat center.hi) (List.ofFn states) B hlo hhi hs
  simp only [List.length_ofFn] at hw hc
  constructor
  · exact hw
  · have hlo' := (Nat.size_le_size (center.ordered.trans center.valid)).trans (show Nat.size n ≤ B by omega)
    have hhi' := (Nat.size_le_size center.valid).trans (show Nat.size n ≤ B by omega)
    change (connectionWithWork (nat center.lo) (nat center.hi) (List.ofFn states)).2 +
      Nat.size center.lo + Nat.size center.hi + M + 2 + M + 1 ≤ _
    omega

theorem wideActionsFromRepresentativesWithWork_bounds {nx ny M : ℕ}
    (parent : TargetInterval nx) (representatives : List (ℕ × TargetInterval ny)) (P B : ℕ)
    (hPpos : 0 < P) (hnx : Nat.size nx ≤ B) (hny : Nat.size ny + 2 ≤ B)
    (hM : Nat.size M ≤ B) (hP : Nat.size P ≤ B)
    (hrep : ∀ br ∈ representatives, Nat.size br.1 ≤ B) :
    (wideActionsFromRepresentativesWithWork M parent representatives P).1.length ≤
        representatives.length * (40 * P + 2) ^ (2 * M) ∧
      (∀ action ∈ (wideActionsFromRepresentativesWithWork M parent representatives P).1,
        action.connection.width ≤ connectionWordBudget M B) ∧
      (wideActionsFromRepresentativesWithWork M parent representatives P).2 ≤
        wideActionsBitBudget M P representatives.length B := by
  let V := (40 * P + 2) ^ (2 * M)
  let callback := fun br : ℕ × TargetInterval ny =>
    let grids := wideActionGridWithWork M parent br.2 br.1 P
    let actions := arithmeticMapWithWork (fun states => endpointActionWithWork br.2 states.get) grids.1
    (actions.1, grids.2 + actions.2 + 1)
  have hlen (br : ℕ × TargetInterval ny) : (wideActionGridWithWork M parent br.2 br.1 P).1.length ≤ V := by
    have hh := congrArg List.length (wideActionGridWithWork_value M parent br.2 br.1 P hPpos)
    simp only [List.length_map] at hh
    rw [hh]
    exact wideActionList_length_le M parent br.2 br.1 P hPpos
  have hc (br : ℕ × TargetInterval ny) (hbr : br ∈ representatives) :
      (callback br).2 ≤ wideMaterializationBitBudget M P B +
        V * (connectionBitBudget M B + 2 * B + 2 * M + 6) + 1 := by
    have hg := wideActionGridWithWork_complete_cost M parent br.2 br.1 P B hPpos hnx
      (by omega) hM (hrep br hbr) hP
    have hm := arithmeticMapWithWork_cost
      (fun states : Vector (TargetInterval ny) M => endpointActionWithWork br.2 states.get)
      (wideActionGridWithWork M parent br.2 br.1 P).1
      (connectionBitBudget M B + 2 * B + 2 * M + 3)
      (fun states _ => (endpointActionWithWork_bounds br.2 states.get B hny).2)
    have hm' := hm.trans (Nat.mul_le_mul_right _ (hlen br))
    change (wideActionGridWithWork M parent br.2 br.1 P).2 + _ + 1 ≤ _
    simp only [Nat.add_assoc, Nat.reduceAdd] at hm' ⊢
    omega
  have hl (br : ℕ × TargetInterval ny) : (callback br).1.length ≤ V := by
    simpa only [callback, arithmeticMapWithWork_value, List.length_map] using hlen br
  have hcost := arithmeticFlatMapWithWork_cost callback representatives
    (wideMaterializationBitBudget M P B + V * (connectionBitBudget M B + 2 * B + 2 * M + 6) + 1)
    V hc (fun br _ => hl br)
  have hlength : (representatives.flatMap (fun br => (callback br).1)).length ≤ representatives.length * V :=
    list_flatMap_length_le representatives (fun br => (callback br).1) V (fun br _ => hl br)
  refine ⟨?_, ?_, hcost⟩
  · simpa only [wideActionsFromRepresentativesWithWork, arithmeticFlatMapWithWork_value] using hlength
  · intro action ha
    simp only [wideActionsFromRepresentativesWithWork, arithmeticFlatMapWithWork_value,
      arithmeticMapWithWork_value] at ha
    obtain ⟨br, _, ha⟩ := List.mem_flatMap.mp ha
    obtain ⟨states, _, rfl⟩ := List.mem_map.mp ha
    exact (endpointActionWithWork_bounds br.2 states.get B hny).1

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryPhysicalContinuationWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Actual endpoint distances and connection words supply all representation
premises of the two Bellman scans and final refinement update. -/

namespace EditApproximation
namespace BinaryFraction

private theorem endpointDistance_uniform_p1 {n : ℕ} (q r : TargetInterval n) (B : ℕ)
    (hn : Nat.size n + 2 ≤ B) :
    (endpointDistanceWithWork q r).1.width ≤ endpointDistanceWordBudget B ∧
      (endpointDistanceWithWork q r).2 ≤ endpointDistanceBitBudget B :=
  endpointDistanceWithWork_bounds q r B
    ((Nat.add_le_add_right (Nat.size_le_size (q.ordered.trans q.valid)) 2).trans hn)
    ((Nat.add_le_add_right (Nat.size_le_size q.valid) 2).trans hn)
    ((Nat.add_le_add_right (Nat.size_le_size (r.ordered.trans r.valid)) 2).trans hn)
    ((Nat.add_le_add_right (Nat.size_le_size r.valid) 2).trans hn)

theorem physicalContinuationWithWork_bounds_oai {nx ny M : ℕ} (parent : TargetInterval nx)
    (representatives : List (ℕ × TargetInterval ny)) (P F B : ℕ)
    (delta fallback : BinaryFraction) (old current : Fin M × TargetInterval ny → BinaryFraction)
    (groups online : List (BinaryBellmanAction (TargetInterval ny) (Fin M × TargetInterval ny) M))
    (query : TargetInterval ny) (hPpos : 0 < P) (hB : 10 ≤ B)
    (hnx : Nat.size nx ≤ B) (hny : Nat.size ny + 2 ≤ B)
    (hM : Nat.size M ≤ B) (hP : Nat.size P ≤ B) (hF : Nat.size F + 2 ≤ B)
    (hrep : ∀ br ∈ representatives, Nat.size br.1 ≤ B)
    (hdelta : delta.width ≤ B) (hfallback : fallback.width ≤ B)
    (hold : ∀ s, (old s).width ≤ B) (hcurrent : ∀ s, (current s).width ≤ B)
    (hgroups : ∀ action ∈ groups, action.connection.width ≤ connectionWordBudget M B)
    (honline : ∀ action ∈ online, action.connection.width ≤ connectionWordBudget M B) :
    (physicalContinuationWithWork parent representatives P F delta fallback old current groups online query).1.width ≤
        localContinuationWordBudget M (physicalContinuationInputBudget M B) ∧
      (physicalContinuationWithWork parent representatives P F delta fallback old current groups online query).2 ≤
        physicalContinuationBitBudget M P representatives.length groups.length online.length B := by
  let wide := wideActionsFromRepresentativesWithWork M parent representatives P
  let L := canonicalMulWithWork (nat 128) (nat F)
  let W := physicalContinuationInputBudget M B
  have hBW : B ≤ W := by dsimp only [W, physicalContinuationInputBudget]; omega
  have h128 : (nat 128).width ≤ B :=
    (nat_width_le 128).trans (by change 10 ≤ B; exact hB)
  have hL := canonicalMulWithWork_width (nat 128) (nat F) B h128 ((nat_width_le F).trans hF)
  have hLc := canonicalMulWithWork_cost (nat 128) (nat F) B h128 ((nat_width_le F).trans hF)
  have hw := wideActionsFromRepresentativesWithWork_bounds parent representatives P B
    hPpos hnx hny hM hP hrep
  have htail := localContinuationWithWork_bounds endpointDistanceWithWork L.1 delta fallback
    old current query wide.1 groups online W (endpointDistanceBitBudget B)
    (hL.trans (by dsimp only [W, physicalContinuationInputBudget]; omega))
    (hdelta.trans hBW) (hfallback.trans hBW)
    (fun action _ => (endpointDistance_uniform_p1 query action.center B hny).1.trans (by
      dsimp only [W, physicalContinuationInputBudget]; omega))
    (fun action _ => (endpointDistance_uniform_p1 query action.center B hny).2)
    (by
      intro action ha
      rcases List.mem_append.mp ha with ha | ha
      · rcases List.mem_append.mp ha with ha | ha
        · exact (hw.2.1 action ha).trans (by dsimp only [W, physicalContinuationInputBudget]; omega)
        · exact (hgroups action ha).trans (by dsimp only [W, physicalContinuationInputBudget]; omega)
      · exact (honline action ha).trans (by dsimp only [W, physicalContinuationInputBudget]; omega))
    (fun action _ i => (hold (action.childState i)).trans hBW)
    (fun action _ i => (hcurrent (action.childState i)).trans hBW)
  refine ⟨htail.1, ?_⟩
  have htailCost := htail.2.trans (show
      localContinuationBitBudget M wide.1.length groups.length online.length W (endpointDistanceBitBudget B) ≤
      localContinuationBitBudget M (representatives.length * (40 * P + 2) ^ (2 * M)) groups.length online.length W
        (endpointDistanceBitBudget B) by
    unfold localContinuationBitBudget bellmanBitBudget
    gcongr <;> exact hw.1)
  change wide.2 + L.2 +
    (localContinuationWithWork endpointDistanceWithWork L.1 delta fallback old current query wide.1 groups online).2 + 1 ≤ _
  have hwc := hw.2.2
  change wide.2 ≤ _ at hwc
  change L.2 ≤ _ at hLc
  unfold physicalContinuationBitBudget
  change _ ≤ wideActionsBitBudget M P representatives.length B + 2000 * (B + 1) ^ 2 +
    localContinuationBitBudget M (representatives.length * (40 * P + 2) ^ (2 * M))
      groups.length online.length W (endpointDistanceBitBudget B) + 1
  omega

end BinaryFraction
end EditApproximation

end OAI
end

theorem solution : type_of% @OAI.EditApproximation.BinaryFraction.physicalContinuationWithWork_bounds_oai := @OAI.EditApproximation.BinaryFraction.physicalContinuationWithWork_bounds_oai
