namespace AModel

open Matrix

/-! ## 1. Lifting a layout past the prefix and row fields -/

section Cons2

variable {sh : Shape} {n Q : ℕ}

/-- A layout on `sh` viewed on `P :: L :: sh` (positions shifted by two). -/
def Layout.cons2 (Λ : Layout sh n Q) (P L : ℕ) : Layout (P :: L :: sh) n Q where
  pos i := ⟨Λ.pos i + 2, by simp⟩
  mono a b h := by
    have := Λ.mono h
    rw [Fin.lt_def] at this ⊢
    simp only
    omega
  size i := by simpa using Λ.size i

variable (Λ : Layout sh n Q)

@[simp] lemma Layout.cons2_pos (P L : ℕ) (i : Fin n) :
    ((Λ.cons2 P L).pos i : ℕ) = Λ.pos i + 2 := rfl

end Cons2

/-! ## 2. The concrete frame action: shears on the `rest` digits -/

section ShearAction

variable {rest : Shape} {m Q : ℕ} {M : Type*} [AddCommGroup M]

/-- The frame action of a label `a : M` (through an additive map `φ` to `m × m` matrices over
`ZMod Q`): the address map of the shear by `-φ a` on the `rest` digits. Pull by it is the array
permutation of the address map `(H, D) ↦ (H + φ a · D, D)`. -/
def shearπ (Λ : Layout rest (m + m) Q) (φ : M →+ Matrix (Fin m) (Fin m) (ZMod Q)) (a : M) :
    List ℕ → List ℕ :=
  amap Λ (shearMat (-(φ a)))

variable (Λ : Layout rest (m + m) Q) (φ : M →+ Matrix (Fin m) (Fin m) (ZMod Q))

end ShearAction

/-! ## 3. Networks with implemented frame changes -/

section Frames

variable {Wr Ω R M : Type*} [CommRing R] [Fintype Wr] [DecidableEq Wr] [AddGroup M]

/-- `physStep` with a plain function family (an implementation of the frame changes). -/
def physStepF (Φ : M → (Ω → R) → (Ω → R)) (st : (Wr → M) × (Wr → Ω → R))
    (g : NGate Wr R M) : (Wr → M) × (Wr → Ω → R) :=
  (fun w => if w ∈ g.2.1 then g.2.2 else st.1 w,
   fun w => if w ∈ g.2.1 then ∑ w' ∈ g.2.1, g.1 w w' • Φ (g.2.2 - st.1 w') (st.2 w')
     else st.2 w)

/-- `netRun` with a plain function family. -/
def netRunF (Φ : M → (Ω → R) → (Ω → R)) (gates : List (NGate Wr R M)) (Min Mout : Wr → M)
    (f : Wr → Ω → R) : Wr → Ω → R :=
  fun w => Φ (Mout w - (gates.foldl (physStepF Φ) (Min, f)).1 w)
    ((gates.foldl (physStepF Φ) (Min, f)).2 w)

/-- Labels after a gate. -/
def labStep (lab : Wr → M) (g : NGate Wr R M) : Wr → M :=
  fun w => if w ∈ g.2.1 then g.2.2 else lab w

/-- Every frame change of the run (each touched wire of each gate, and the final frames)
satisfies `Pr`. -/
def FramesOK (Pr : M → Prop) : List (NGate Wr R M) → (Wr → M) → (Wr → M) → Prop
  | [], lab, Mout => ∀ w, Pr (Mout w - lab w)
  | g :: gs, lab, Mout => (∀ w ∈ g.2.1, Pr (g.2.2 - lab w)) ∧ FramesOK Pr gs (labStep lab g) Mout

end Frames

/-! ## 4. Running steps with the interchanges delegated to a child procedure -/

section RunChild

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {α : Type*}

/-- One step, with field interchanges delegated to `child`. -/
def stepC (child : Fin n → Fin n → List α → List α) (d : α) (ys : List α) :
    Step n Q → List α
  | .swap a b => child a b ys
  | .shift i u c => (Step.shift i u c).arr Λ d ys

/-- Run steps, delegating every field interchange to `child`. -/
def runC (child : Fin n → Fin n → List α → List α) (d : α) (steps : List (Step n Q))
    (xs : List α) : List α :=
  steps.foldl (stepC Λ child d) xs

end RunChild

/-! ## 5. Chunk shapes: two chunks split into `m` fields, and merged -/

section Chunks

/-- `rest` with two chunks, each split into `m` fields of size `N`:
`A ++ [N]*m ++ B ++ [N]*m ++ C`. -/
def hdShape (A B C : Shape) (m N : ℕ) : Shape :=
  A ++ (List.replicate m N ++ (B ++ (List.replicate m N ++ C)))

/-- `rest` with two single fields of size `F`: `A ++ [F] ++ B ++ [F] ++ C`. -/
def swShape (A B C : Shape) (F : ℕ) : Shape := A ++ (F :: (B ++ (F :: C)))

/-- Position of active field `t` (`H_t` for `t < m`, `D_{t-m}` otherwise) in `hdShape`. -/
def hdPos (A B : Shape) (m t : ℕ) : ℕ := if t < m then A.length + t else A.length + B.length + t

lemma length_hdShape (A B C : Shape) (m N : ℕ) :
    (hdShape A B C m N).length = A.length + m + B.length + m + C.length := by
  simp [hdShape]; omega

lemma hdShape_getD (A B C : Shape) (m N t : ℕ) (ht : t < m + m) :
    (hdShape A B C m N).getD (hdPos A B m t) 0 = N := by
  unfold hdShape hdPos
  split_ifs with h
  · rw [List.getD_append_right _ _ _ _ (by omega), Nat.add_sub_cancel_left,
      List.getD_append _ _ _ _ (by simp; omega)]
    simp [h]
  · rw [List.getD_append_right _ _ _ _ (by omega),
      show A.length + B.length + t - A.length = m + (B.length + (t - m)) by omega,
      List.getD_append_right _ _ _ _ (by simp), List.length_replicate,
      Nat.add_sub_cancel_left, List.getD_append_right _ _ _ _ (by omega),
      Nat.add_sub_cancel_left, List.getD_append _ _ _ _ (by simp; omega),
      List.getD_eq_getElem _ _ (by simp; omega), List.getElem_replicate]

lemma hdPos_lt (A B C : Shape) (m N t : ℕ) (ht : t < m + m) :
    hdPos A B m t < (hdShape A B C m N).length := by
  rw [length_hdShape]; unfold hdPos; split_ifs <;> omega

/-- The layout of the `2m` active fields of `hdShape`. -/
def hdLayout (A B C : Shape) (m N : ℕ) : Layout (hdShape A B C m N) (m + m) N where
  pos t := ⟨hdPos A B m t, hdPos_lt A B C m N t t.2⟩
  mono a b h := by
    rw [Fin.lt_def] at h ⊢
    simp only [hdPos]
    split_ifs <;> omega
  size t := by
    have := hdShape_getD A B C m N t t.2
    rw [List.getD_eq_getElem _ _ (hdPos_lt A B C m N t t.2)] at this
    simpa using this

@[simp] lemma hdLayout_pos (A B C : Shape) (m N : ℕ) (t : Fin (m + m)) :
    ((hdLayout A B C m N).pos t : ℕ) = hdPos A B m t := rfl

end Chunks

/-! ## 6. The chunk interchange `amap swapMat` is a block swap -/

section SwapBlock

variable {sh : Shape} {m Q : ℕ} [NeZero Q] (Λ : Layout sh (m + m) Q)

end SwapBlock

/-! ## 7. One level of Prop. 11, with the children as an oracle -/

section Level

/-- Integer `m × m` matrices: the labels of the circuit. -/
abbrev IMat (m : ℕ) := Matrix (Fin m) (Fin m) ℤ

/-- Reduction of an integer matrix mod `N`. -/
def castM {m : ℕ} (N : ℕ) (X : IMat m) : Matrix (Fin m) (Fin m) (ZMod N) :=
  X.map (Int.castRingHom (ZMod N))

/-- Reduction mod `N` as an additive map (the `φ` of `shear_network`). -/
def castHom (m N : ℕ) : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N) :=
  (Int.castRingHom (ZMod N)).mapMatrix.toAddMonoidHom

variable {R : Type*} [CommRing R] {m W : ℕ}

/-- The data of the circuit: gates on `W` wires with integer matrix labels, input/output labels,
the routing `ρ`, and for every label difference `A` a factorization `A = E₁ Π E₂` (Lemma 10). -/
structure Circuit (R : Type*) [CommRing R] (m W : ℕ) where
  gates : List (NGate (Fin W) R (IMat m))
  Min : Fin W → IMat m
  Mout : Fin W → IMat m
  ρ : Fin W → Fin W
  fac : IMat m → IMat m × IMat m × IMat m

/-- `fac A = (E₁, Π, E₂)` is a Lemma 10 factorization of `A` usable mod `N`: `E₁, E₂` lower
triangular with diagonal units mod `N`, `Π` a `0/1` matrix, `A = E₁ Π E₂` over `ℤ`. -/
def FacAt (N : ℕ) (fac : IMat m → IMat m × IMat m × IMat m) (A : IMat m) : Prop :=
  (∀ i j, i < j → (fac A).1 i j = 0) ∧ (∀ i j, i < j → (fac A).2.2 i j = 0) ∧
  (∀ i, IsUnit (((fac A).1 i i : ℤ) : ZMod N)) ∧ (∀ i, IsUnit (((fac A).2.2 i i : ℤ) : ZMod N)) ∧
  (∀ i j, (fac A).2.1 i j = 0 ∨ (fac A).2.1 i j = 1) ∧ A = (fac A).1 * (fac A).2.1 * (fac A).2.2

/-- The Lemma 10 steps of the frame change `Φ_A` (fields of size `N`). -/
def edgeSteps (C : Circuit R m W) (N : ℕ) (A : IMat m) : List (Step (m + m) N) :=
  shearSteps (castM N (C.fac A).1) (castM N (C.fac A).2.1) (castM N (C.fac A).2.2)

/-- The circuit hypotheses of Prop. 11 at field size `N`. -/
structure Circuit.OK (C : Circuit R m W) (N : ℕ) : Prop where
  gatesOK : ∀ g ∈ C.gates, g.OK
  route : ∀ (v : Fin W → R) w, scalarRun C.gates v (C.ρ w) = v w
  unit : ∀ w, C.Mout (C.ρ w) - C.Min w = 1
  frames : FramesOK (FacAt N C.fac) C.gates C.Min C.Mout

/-- The implemented frame change `Φ_A` on a stream: the Lemma 10 steps of `A`, every field
interchange delegated to `child`. -/
def implΦ (C : Circuit R m W) (N P L' : ℕ) (A B Cs : Shape)
    (child : Fin (m + m) → Fin (m + m) → List R → List R) (X : IMat m)
    (f : Fin (vol (P :: L' :: hdShape A B Cs m N)) → R) :
    Fin (vol (P :: L' :: hdShape A B Cs m N)) → R :=
  fun i => (runC ((hdLayout A B Cs m N).cons2 P L') child 0 (AModel.edgeSteps C N X) (List.ofFn f)).getD
    (i : ℕ) 0

/-- **One level of the procedure** on `P :: (W * L') :: hdShape A B Cs m N` (two chunks of `m`
fields of size `N`): `D ← D − H`; row split into `W` streams; the network (gates pointwise,
frame changes `Φ_A` by `implΦ`); merge undoing `ρ`; `D ← H − D`. -/
def levelR [NeZero W] (C : Circuit R m W) (N P L' : ℕ) (A B Cs : Shape)
    (child : Fin (m + m) → Fin (m + m) → List R → List R) (xs : List R) : List R :=
  AModel.runArr ((hdLayout A B Cs m N).cons2 P (W * L')) 0 (flipSteps m)
    (rowMerge P W L' (hdShape A B Cs m N) 0 (fun w => List.ofFn
      (netRunF (implΦ C N P L' A B Cs child) C.gates C.Min C.Mout
        (fun w' i => (rowSplit P W L' (hdShape A B Cs m N) w' 0
          (AModel.runArr ((hdLayout A B Cs m N).cons2 P (W * L')) 0 (subSteps m) xs)).getD (i : ℕ) 0)
        (C.ρ w))))

variable [NeZero W] (C : Circuit R m W) {N : ℕ} [NeZero N] (P L' : ℕ) (A B Cs : Shape)

/-- The oracle hypothesis on the children: `child H_i D_j` interchanges the two size-`N` fields
`H_i`, `D_j` of a stream (single fields, i.e. a Prop. 11 instance one level down). -/
def ChildOK (child : Fin (m + m) → Fin (m + m) → List R → List R) : Prop :=
  ∀ (i j : Fin m) (ys : List R), ys.length = vol (P :: L' :: hdShape A B Cs m N) →
    child (Fin.castAdd m i) (Fin.natAdd m j) ys =
      pull (P :: L' :: hdShape A B Cs m N) (P :: L' :: hdShape A B Cs m N)
        (swapPos (A.length + i + 2) (A.length + B.length + m + j + 2)) 0 ys

end Level

/-! ## 8. The recursive procedure and Prop. 11 by induction on the level -/

section Recursion

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- **The interchange program.** `prog C q k P L A B Cs` interchanges the two fields of size
`q ^ m ^ k` (chunks of `m ^ k` radix-`q` digits) of `P :: L :: swShape A B Cs (q ^ m ^ k)`.
Level `0`: a single digit swap (primitive). Level `k + 1`: view each chunk as `m` fields of size
`N = q ^ m ^ k` (reshape, free) and run `levelR` with `L / W` stream rows, every field
interchange `H_a ↔ D_b` of every edge's Lemma 10 steps being a level-`k` call on the stream. -/
def prog (C : Circuit R m W) (q : ℕ) : ℕ → ℕ → ℕ → Shape → Shape → Shape → List R → List R
  | 0, P, L, A, B, Cs, xs =>
    pull (P :: L :: swShape A B Cs q) (P :: L :: swShape A B Cs q)
      (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs
  | k + 1, P, L, A, B, Cs, xs =>
    levelR C (q ^ m ^ k) P (L / W) A B Cs
      (fun a b => prog C q k P (L / W) (A ++ List.replicate a (q ^ m ^ k))
        (List.replicate (m - 1 - a) (q ^ m ^ k) ++ (B ++ List.replicate (b - m) (q ^ m ^ k)))
        (List.replicate (m + m - 1 - b) (q ^ m ^ k) ++ Cs)) xs

end Recursion

/-! ## 9. Cost -/

section CostDefs

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

/-- Sum of `f` over all frame changes of the run (as in `FramesOK`). -/
def frameSum {β : Type*} [AddCommMonoid β] (f : M → β) :
    List (NGate Wr R M) → (Wr → M) → (Wr → M) → β
  | [], lab, Mout => ∑ w, f (Mout w - lab w)
  | g :: gs, lab, Mout => (∑ w ∈ g.2.1, f (g.2.2 - lab w)) + frameSum f gs (labStep lab g) Mout

/-- Total number of (gate, touched wire) pairs: the pointwise gate passes on streams. -/
def touched (gates : List (NGate Wr R M)) : ℕ := (gates.map fun g => g.2.1.card).sum

/-- Cost of the network on streams of volume `v`: each frame change costs `fc` of it, each
touched wire of each gate one pass `v` for the pointwise gate. -/
noncomputable def netCost (fc : M → ℝ) (v : ℝ) : List (NGate Wr R M) → (Wr → M) → (Wr → M) → ℝ
  | [], lab, Mout => ∑ w, fc (Mout w - lab w)
  | g :: gs, lab, Mout => (∑ w ∈ g.2.1, (fc (g.2.2 - lab w) + v)) + netCost fc v gs (labStep lab g) Mout

end CostDefs

section StepCost

variable {n Q : ℕ}

/-- Cost of running steps on an array of volume `v`: a shift is one pass (`v`), a field
interchange is a child call (`T v`). -/
noncomputable def runCost (T : ℝ → ℝ) (v : ℝ) (steps : List (Step n Q)) : ℝ :=
  (steps.map fun s => if s.isSwap then T v else v).sum

variable {m : ℕ}

end StepCost

section ProgCost

variable {R : Type*} [CommRing R] {m W : ℕ}

/-- `r_A`: the number of ones of the `Π` of the factorization of `A` (its rank). -/
def pivRank (C : Circuit R m W) (A : IMat m) : ℕ :=
  (Finset.univ.filter fun p : Fin m × Fin m => (C.fac A).2.1 p.1 p.2 = 1).card

/-- `s = Σ_e r_e`, summed over all frame changes of the network: the number of child calls. -/
def rankSum (C : Circuit R m W) : ℕ := frameSum (pivRank C) C.gates C.Min C.Mout

/-- The constant `C₀` of the linear part: `2m + 2` full passes (`D ← D − H`, split, merge,
`D ← H − D`) plus, per stream (volume `V / W`), the shift passes `4m + 2 r_e` of each frame
change and one pass per touched wire of each gate. -/
noncomputable def costConst (C : Circuit R m W) : ℝ :=
  2 * m + 2 + (frameSum (fun A => (4 * m + 2 * pivRank C A : ℝ)) C.gates C.Min C.Mout +
    touched C.gates) / W

/-- Cost of one level with child cost `T`, on input volume `V` (per the structure of `levelR`). -/
noncomputable def levelCost (C : Circuit R m W) (N : ℕ) (T : ℝ → ℝ) (V : ℝ) : ℝ :=
  ((subSteps (Q := N) m).length : ℝ) * V + V +
    netCost (fun X => runCost T (V / W) (AModel.edgeSteps C N X)) (V / W) C.gates C.Min C.Mout + V +
    ((flipSteps (Q := N) m).length : ℝ) * V

/-- Cost of `prog` at level `k` on volume `V` (level `0`: one digit-swap pass). -/
noncomputable def progCost (C : Circuit R m W) (q : ℕ) : ℕ → ℝ → ℝ
  | 0, V => V
  | k + 1, V => levelCost C (q ^ m ^ k) (progCost C q k) V

end ProgCost

