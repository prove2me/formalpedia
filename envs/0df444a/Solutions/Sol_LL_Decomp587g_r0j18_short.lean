          W_real s * (((H_cert.drop (d * mult)).getD i 0 : ℝ) / S_sc) :=
      intervalIntegral.integral_mono_on hsl_sr
        ((hWH_cont.mono (Icc_subset_Icc hlo_r hhi_r)).intervalIntegrable_of_Icc hsl_sr)
        (((hW_cont.mono (Icc_subset_Icc hlo_r hhi_r)).mul continuousOn_const).intervalIntegrable_of_Icc hsl_sr)
        (fun s hs_mem => mul_le_mul_of_nonneg_left (hH_box s hs_mem) (W_real_nonneg s))
    rw [intervalIntegral.integral_mul_const] at hmono
    have hW_int : ∫ s in ((sl : ℝ) / D_den)..((sr : ℝ) / D_den), W_real s ≤ (W_cert.getD i 0 : ℝ) / S_sc := by
      have h1 := W_integral_subinterval_le hNs h2Ns hdivNs h2hs hi
