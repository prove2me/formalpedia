/-- `crtIn` of the chunks of `x`. -/
def uOf (K N x : ℕ) : List ℤ := crtIn (mkParams K N).s (chunksL (mkParams K N).b (mkParams K N).L x)

/-- The values held by the parameter registers at the end (popped by `popPar`). -/
def parV (K N : ℕ) (r : Fin HS) : ℤ :=
  if r = 28 then ((mkParams K N).S : ℤ) else if r = 26 then ((mkParams K N).fn : ℤ)
  else if r = 44 then ((mkParams K N).P : ℤ) else if r = 17 then ((mkParams K N).p : ℤ)
  else if r = 42 then ((mkParams K N).α : ℤ) else if r = 33 then ((2 * (mkParams K N).L - 1 : ℕ) : ℤ)
  else if r = 31 then ((2 ^ (mkParams K N).b : ℕ) : ℤ) else if r = 39 then ((mkParams K N).logOuter : ℤ)
  else if r = 9 then ((mkParams K N).tdims.prod : ℤ) else if r = 4 then ((2 ^ ((mkParams K N).e + 1) : ℕ) : ℤ)
  else if r = 6 then ((2 ^ ((mkParams K N).e - 1) : ℕ) : ℤ) else if r = 5 then ((2 ^ (mkParams K N).e : ℕ) : ℤ)
  else if r = 7 then (((mkParams K N).K - (mkParams K N).dh : ℕ) : ℤ)
  else if r = 8 then ((mkParams K N).dh : ℤ) else if r = 38 then ((mkParams K N).e : ℤ)
  else if r = 37 then (CR.parEx K N : ℤ) else if r = 32 then ((mkParams K N).L : ℤ)
  else if r = 36 then ((mkParams K N).b : ℤ) else if r = 34 then (N : ℤ) else if r = 35 then zsz (N : ℤ)
  else 0

/-- All numeric premises of the step (for `q = mkParams K N`, inputs `a`, `b`). -/
structure StepArgs (M : MulSpec) (K N a b : ℕ) (Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu Bc Bd : ℕ)
    (BS BB : ℕ → ℕ) : Prop where
  K1 : 1 ≤ K
  N1 : 1 ≤ N
  ha : a < 2 ^ N
  hb : b < 2 ^ N
  ex : ExArgs M (mkParams K N) ((mkParams K N).logT + 2) Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu BS BB
    (uOf K N a) (uOf K N b)
  crt : CR.CrtOK (mkParams K N).s
  he : 2 ≤ (mkParams K N).e
  hdh : (mkParams K N).dh < K
  kb1 : 4 * (mkParams K N).r ≤ 2 ^ ((mkParams K N).logT + 2)
  kb2 : (mkParams K N).tdims.prod ≤ 2 ^ ((mkParams K N).logT + 2)
  kbS : (mkParams K N).S ≤ 2 ^ ((mkParams K N).logT + 2)
  LS : (mkParams K N).L ≤ (mkParams K N).S
  MoS : 2 * (mkParams K N).L - 1 ≤ (mkParams K N).S
  aL : a < 2 ^ ((mkParams K N).b * (mkParams K N).L)
  bL : b < 2 ^ ((mkParams K N).b * (mkParams K N).L)
  b1 : 1 ≤ (mkParams K N).b
  kB : 2 * (mkParams K N).S + 4 * K + 1 < 2 ^ Bc
  chB : CR.ChirpB (mkParams K N) Bc
  pB : (mkParams K N).p + 1 ≤ Bc
  bigB : 8 * (mkParams K N).r + 3 * (mkParams K N).tdims.prod + 4 < 2 ^ Bc
  kbB : (mkParams K N).logT + 4 ≤ Bc
  bB : (mkParams K N).b + 1 ≤ Bc
  dB : 2 * (mkParams K N).fn + (mkParams K N).logOuter + (mkParams K N).e + 2 * K + 4 ≤ Bd
  ppB : (mkParams K N).p * (mkParams K N).p + (mkParams K N).p + 2 < 2 ^ Bd
  KB : 8 * K < 2 ^ Bd
  slB : Bnd Bd (EX.sl (mkParams K N))
  TBd : (mkParams K N).tdims.prod < 2 ^ Bd
  SBd : (mkParams K N).S < 2 ^ Bd
  lTBd : (mkParams K N).logT + 1 ≤ Bd
  TB : 2 * (mkParams K N).tdims.prod < 2 ^ Bc
  SB : (mkParams K N).S < 2 ^ Bc
  cB : ∀ x ∈ crtOut (mkParams K N).s (2 * (mkParams K N).L - 1)
    (exactConvL (mkParams K N) (uOf K N a) (uOf K N b)), 0 ≤ x ∧ x < 2 ^ Bc
  wB : Bnd Bc (exactConvL (mkParams K N) (uOf K N a) (uOf K N b))
  wl : (exactConvL (mkParams K N) (uOf K N a) (uOf K N b)).length = (mkParams K N).S
  res : refStep (mkParams K N) a b = ((a * b : ℕ) : ℤ)
  popB : ∀ r ∈ parRegs, zsz (parV K N r) ≤ Bc + N

def stepCost (K N Φf Φm Bs CS CB Bx Q Bc Bd : ℕ) : ℕ :=
  (2 * (4000 * (N + 2)) + 2 * (2 * N + 2)) +
  ((3 * (4000 * (zsz (N : ℤ) + 2)) + Top.blenCost N + 2 * (2 * zsz (N : ℤ) + 2)) +
  (((CR.facN K + 2 * K + 5 * zsz (N : ℤ) + 102) * 10 ^ 9 * (Nat.size (CR.parBnd K N (zsz (N : ℤ))) + 2) ^ 2 +
      4 * 2000 * ((mkParams K N).logT + 5)) +
  (keyCost K (mkParams K N).s.prod Bc +
  (chirpCost (mkParams K N) ((mkParams K N).logT + 2) Bc +
  (crtCost (mkParams K N).S ((mkParams K N).logT + 2) Bc +
  (midPCost (mkParams K N) ((mkParams K N).logT + 2) Bs CS CB Bx Q Φf Φm Bd +
  ((tailCost (mkParams K N).tdims.prod (mkParams K N).S (2 * (mkParams K N).L - 1) ((mkParams K N).logT + 2)
      (mkParams K N).b Bc + (4000 * (2 * N + 2) + (2 * (2 * N) + 2))) +
  (parRegs.length * (2 * (Bc + N) + 2) + 1))))))))

end NLogN.ST

