-- Source module: Solutions.KFWBase
/-!
# KFW: header refinement, uniform leaves, parameters in the background

* `HRef p p' X`: `p'` is `p` with some (non-loop) pushes of literals `v` replaced by closed
  expressions of value `v`; `HRef.fsp`: `FSp p s t c → FSp p' s t (c + X)`.
* `RS.sub_id`: substituting registers a program never touches changes nothing.
* `FSp.uni`: `FSp O s t c`, `HRef O (U.sub σ) X`, the registers of `σ` hold their values and are
  not written ⇒ `FSp U s t (400 (c + X))` (and `fok U` from `fok O`).
* `encK_pushSt`, `agree_pushSt`, **`leafPush`**: a uniform leaf `withPushI pl (fcode U)` from the
  non-uniform spec of `O` on the background with the pushed parameters.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD KIL

/-! ## Header refinement -/

theorem HRef.fok {p p' : RS} {X : ℕ} (h : HRef p p' X) : KFD.fok p = true → KFD.fok p' = true := by
  induction h with
  | refl => exact id
  | seq _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | ite _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | push => intro _; rfl
  | mono _ _ ih => exact ih

/-! ## Substitution of untouched registers -/

/-! ## Uniform register programs -/

/-! ## Pushed parameters in the background -/

theorem agree_pushSt {σ : Fin HS → Option ℤ} (t : IState HS) (l : List (Fin HS × ℤ))
    (hnd : (l.map Prod.fst).Nodup) (hσ : ∀ i v, σ i = some v → (i, v) ∈ l) : Agree σ (pushSt t l) := by
  intro i v hv
  have hm := hσ i v hv
  clear hσ
  refine ⟨t.G i, ?_⟩
  rw [pushSt_G]
  have hf : l.filter (fun p => p.1 = i) = [(i, v)] := by
    induction l with
    | nil => simp at hm
    | cons p l ih =>
      obtain ⟨j, u⟩ := p
      simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnd
      rcases List.mem_cons.1 hm with h | h
      · cases h
        rw [List.filter_cons_of_pos (by simp), List.filter_eq_nil_iff.2]
        intro q hq hq'
        exact hnd.1 ⟨q, hq, by simpa using hq'⟩
      · have hj : j ≠ i := fun e => hnd.1 ⟨(i, v), h, by simp [e]⟩
        rw [List.filter_cons_of_neg (by simpa using hj)]
        exact ih hnd.2 h
  rw [hf]; simp [ints]

