@[expose] public section

namespace Light.Filter

open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3

/-- `cap ≥ 1`. -/
theorem one_le_oCap {n p : ℕ} (hn : 1 ≤ n) (hp : 1 ≤ p) : 1 ≤ oCap n p := by
  rw [oCap, Nat.ceilDiv_eq_add_pred_div, Nat.le_div_iff_mul_le (by omega)]
  have : 1 ≤ n * n := Nat.one_le_iff_ne_zero.2 (by positivity)
  omega

/-- The data are valid. -/
theorem oData_valid {n s p : ℕ} {AB BC AC : List ℤ} (hn : 1 ≤ n) (hs : 1 ≤ s) (hp : 1 ≤ p)
    (lenAB : AB.length = n * n) (lenBC : BC.length = n * n) (lenAC : AC.length = n * n) :
    (oData n s p AB BC AC).Valid where
  n_pos := hn
  p_pos := hp
  q_pos := hs
  cap_pos := one_le_oCap hn hp
  qp_le := le_rfl
  lenAB := lenAB
  lenBC := lenBC
  lenAC := lenAC

/-- The number of blocks. -/
theorem oData_h (n s p : ℕ) (AB BC AC : List ℤ) :
    (oData n s p AB BC AC).h = (n + s - 1) / s := Nat.ceilDiv_eq_add_pred_div _ _

/-- An entry of the matrix `X` of an instance. -/
private theorem getD_xList' {n D p c0 len rho : ℕ} {RAC : List ℕ} {a k : ℕ} (ha : a < n)
    (hk : k < D) :
    (xList n D p c0 len rho RAC).getD (a * D + k) 0 =
      if k / p < len ∧ k % p = (RAC.getD (a * n + c0 + k / p) 0 + rho) % p then 1 else 0 := by
  rw [xList, List.getD_map_range _ (Nat.mul_add_lt_mul ha hk), Nat.mul_add_mod_of_lt hk,
    Nat.mul_add_div_of_lt hk]

/-- An entry of the matrix `Y` of an instance. -/
private theorem getD_yList' {n D p c0 len : ℕ} {RBC : List ℕ} {b k : ℕ} (hb : b < n) (hk : k < D) :
    (yList n D p c0 len RBC).getD (k * n + b) 0 =
      if k / p < len ∧ k % p = (p - RBC.getD (b * n + c0 + k / p) 0) % p then 1 else 0 := by
  rw [yList, List.getD_map_range _ (Nat.mul_add_lt_mul hk hb), Nat.mul_add_mod_of_lt hb,
    Nat.mul_add_div_of_lt hb]

/-- **The entry `(XY)[a, b]` of an instance counts** the vertices of the piece at which the labels
of `a` and `b` agree. -/
theorem oThinEntry_eq_card {n D p c0 len rho : ℕ} {RAC RBC : List ℕ} {a b : ℕ} (hp : 0 < p)
    (hlen : len * p ≤ D) (ha : a < n) (hb : b < n) :
    thinEntry n D (xList n D p c0 len rho RAC) (yList n D p c0 len RBC) a b =
      (((Finset.range len).filter fun c =>
        (RAC.getD (a * n + c0 + c) 0 + rho) % p = (p - RBC.getD (b * n + c0 + c) 0) % p).card
        : ℤ) := by
  set LX : ℕ → ℕ := fun c => (RAC.getD (a * n + c0 + c) 0 + rho) % p with hLX
  set LY : ℕ → ℕ := fun c => (p - RBC.getD (b * n + c0 + c) 0) % p with hLY
  have hLXlt : ∀ c, LX c < p := fun c => Nat.mod_lt _ hp
  rw [thinEntry, List.sum_map_range]
  have hterm : ∀ k ∈ Finset.range D,
      (xList n D p c0 len rho RAC).getD (a * D + k) 0 * (yList n D p c0 len RBC).getD (k * n + b) 0
        = if k / p < len ∧ k % p = LX (k / p) ∧ k % p = LY (k / p) then 1 else 0 := by
    intro k hk
    rw [getD_xList' ha (Finset.mem_range.1 hk), getD_yList' hb (Finset.mem_range.1 hk)]
    by_cases h1 : k / p < len <;> by_cases h2 : k % p = LX (k / p) <;>
      by_cases h3 : k % p = LY (k / p) <;> simp_all
  rw [Finset.sum_congr rfl hterm, Finset.sum_boole]
  congr 1
  symm
  refine Finset.card_nbij' (fun c => c * p + LX c) (fun k => k / p) ?_ ?_ ?_ ?_
  · intro c hc
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc ⊢
    have hdiv : (c * p + LX c) / p = c := Nat.mul_add_div_of_lt (hLXlt c)
    have hmod : (c * p + LX c) % p = LX c := Nat.mul_add_mod_of_lt (hLXlt c)
    rw [hdiv, hmod]
    refine ⟨?_, hc.1, rfl, hc.2⟩
    have := hLXlt c
    have : (c + 1) * p ≤ len * p := Nat.mul_le_mul_right _ hc.1
    rw [Nat.add_mul, Nat.one_mul] at this
    omega
  · intro k hk
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hk ⊢
    exact ⟨hk.2.1, hk.2.2.1.symm.trans hk.2.2.2⟩
  · intro c hc
    exact Nat.mul_add_div_of_lt (hLXlt c)
  · intro k hk
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hk ⊢
    rw [← hk.2.2.1]
    exact Nat.div_add_mod' k p

/-- Proof of Theorem 17 / Lemma 4.1: the labels agree if and only if `p` divides the weight of the
triangle. -/
private theorem oLabels_eq_iff {p : ℕ} (hp : p ≠ 0) (wAC wAB wBC : ℤ) :
    (resid p wAC + resid p wAB) % p = (p - resid p wBC) % p ↔ (p : ℤ) ∣ wAB + wBC + wAC := by
  have hleft : ((resid p wAC + resid p wAB : ℕ) : ℤ) ≡ wAC + wAB [ZMOD (p : ℤ)] := by
    push_cast
    rw [resid_cast hp, resid_cast hp]
    exact (Int.mod_modEq wAC p).add (Int.mod_modEq wAB p)
  have hright : ((p - resid p wBC : ℕ) : ℤ) ≡ -wBC [ZMOD (p : ℤ)] := by
    rw [Nat.cast_sub (resid_lt hp wBC).le, resid_cast hp]
    simpa using (Int.modEq_zero_iff_dvd.2 (dvd_refl (p : ℤ))).sub (Int.mod_modEq wBC p)
  have hiff : wAC + wAB ≡ -wBC [ZMOD (p : ℤ)] ↔ (p : ℤ) ∣ wAB + wBC + wAC := by
    rw [Int.modEq_iff_dvd, ← dvd_neg, show -(-wBC - (wAC + wAB)) = wAB + wBC + wAC by ring]
  rw [← hiff, ← Nat.ModEq, ← Int.natCast_modEq_iff]
  exact ⟨fun h => (hleft.symm.trans h).trans hright, fun h => (hleft.trans h).trans hright.symm⟩

section OData

open HostData

variable {X : HostData}

/-- The count of the candidate `j n² + q` is the number of vertices of the piece number `j` (of
`len` vertices from `c0 = j q`) with `p ∣ S`. -/
theorem cntOf_eq_card (hv : X.Valid) {j r : ℕ} (hr : r < X.n * X.n) (hj : j * X.q < X.n) :
    cntOf X.n X.q X.p X.AB X.BC X.AC (j * (X.n * X.n) + r) =
      ((Finset.range (min X.q (X.n - j * X.q))).filter fun c =>
        (X.p : ℤ) ∣ X.sumAt (r / X.n) (r % X.n) (j * X.q + c)).card := by
  have hn := hv.n_pos
  have hq := hv.q_pos
  have hdiv : (j * (X.n * X.n) + r) / (X.n * X.n) = j := Nat.mul_add_div_of_lt hr
  have hmod : (j * (X.n * X.n) + r) % (X.n * X.n) = r := Nat.mul_add_mod_of_lt hr
  rw [cntOf, hdiv, hmod]
  have htri : ∀ c, triSum X.n X.AB X.BC X.AC r c = X.sumAt (r / X.n) (r % X.n) c := by
    intro c
    rw [triSum, sumAt, Nat.div_add_mod' r X.n]
  have hsucc : (j + 1) * X.q = j * X.q + X.q := by ring
  refine Finset.card_nbij' (fun c => c - j * X.q) (fun c => j * X.q + c) ?_ ?_ ?_ ?_
  · intro c hc
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc ⊢
    obtain ⟨hcn, ⟨hlo, hhi, -⟩, hdvd⟩ := hc
    refine ⟨by omega, ?_⟩
    rw [Nat.add_sub_cancel' hlo, ← htri]
    exact hdvd
  · intro c hc
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc ⊢
    obtain ⟨hc, hdvd⟩ := hc
    rw [htri]
    exact ⟨by omega, ⟨by omega, by omega, by omega⟩, hdvd⟩
  · intro c hc
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc ⊢
    obtain ⟨-, ⟨hlo, -, -⟩, -⟩ := hc
    omega
  · intro c _
    simp

/-- **The answer of the counting solver** for the query pair number `i` of instance `t` is the
count of the candidate `j n² + place`, `j = t / chunkCount` the block of the instance. -/
theorem oThinEntry_eq_cntOf (hv : X.Valid) {t i : ℕ} (ht : t < X.m) (hi : i < X.w t) :
    thinEntry X.n X.D (X.matX t) (X.matY t) (X.rowOf t i) (X.colOf t i) =
      (cntOf X.n X.q X.p X.AB X.BC X.AC (t / X.chunkCount * (X.n * X.n) + X.place t i) : ℤ) := by
  have hc0 := hv.c0_lt ht
  rw [Light.Sec3.HostData.matX, Light.Sec3.HostData.matY, oThinEntry_eq_card hv.p_pos (hv.len_mul_le t) (hv.rowOf_lt ht hi)
    (hv.colOf_lt ht hi), cntOf_eq_card hv (hv.place_lt ht hi) hc0]
  have key : ∀ c, ((X.RAC.getD (X.rowOf t i * X.n + X.c0 t + c) 0 + X.rho t) % X.p =
      (X.p - X.RBC.getD (X.colOf t i * X.n + X.c0 t + c) 0) % X.p) ↔
      (X.p : ℤ) ∣ X.sumAt (X.place t i / X.n) (X.place t i % X.n) (X.c0 t + c) := by
    intro c
    rw [RAC, RBC, getD_residList, getD_residList, ← hv.rab_place ht hi, Light.Sec3.HostData.RAB, getD_residList,
      oLabels_eq_iff hv.p_ne]
    have hrow : X.place t i / X.n = X.rowOf t i := rfl
    have hcol : X.place t i % X.n = X.colOf t i := rfl
    rw [hrow, hcol, sumAt, ← rowOf_mul_add_colOf, Nat.add_assoc, Nat.add_assoc]
  rw [Finset.filter_congr (fun c _ => key c)]
  rfl

/-- **Every candidate is the query pair of some instance**, in the block of the instance. -/
theorem oCover (hv : X.Valid) {e : ℕ} (he : e < X.h * (X.n * X.n)) :
    ∃ t < X.m, ∃ i < X.w t, e = t / X.chunkCount * (X.n * X.n) + X.place t i := by
  have hn := hv.n_pos
  have hq := hv.q_pos
  have hnn : 0 < X.n * X.n := by positivity
  set j := e / (X.n * X.n) with hjdef
  set r := e % (X.n * X.n) with hrdef
  have hr : r < X.n * X.n := Nat.mod_lt _ hnn
  have hj : j < X.h := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact he)
  have hjq : j * X.q < X.n := (Nat.lt_ceilDiv_iff hq).1 hj
  obtain ⟨t, ht, i, hi, ha, hb, c', hc', hc⟩ :=
    hv.exists_query (Nat.div_lt_of_lt_mul hr) (Nat.mod_lt r hn) hjq
  refine ⟨t, ht, i, hi, ?_⟩
  have hblock : t / X.chunkCount = j := by
    have hlen := X.len_le t
    rw [c0] at hc
    generalize t / X.chunkCount = j' at hc ⊢
    rcases Nat.lt_trichotomy j' j with hlt | heq | hgt
    · have : (j' + 1) * X.q ≤ j * X.q := Nat.mul_le_mul_right _ hlt
      rw [Nat.add_mul, Nat.one_mul] at this
      omega
    · exact heq
    · have : (j + 1) * X.q ≤ j' * X.q := Nat.mul_le_mul_right _ hgt
      rw [Nat.add_mul, Nat.one_mul] at this
      omega
  rw [hblock, ← rowOf_mul_add_colOf, ha, hb, Nat.div_add_mod', hjdef, hrdef, Nat.mul_comm,
    Nat.div_add_mod]

