theorem horner_rev (M : ℕ) : ∀ (D : List ℤ) (z : ℤ),
    D.reverse.foldl (fun z d => z * 2 ^ M + d) z = z * 2 ^ (D.length * M) + zev (2 ^ M) D
  | [], z => by simp [zev]
  | d :: D, z => by
    rw [List.reverse_cons, List.foldl_append, horner_rev M D z]
    simp only [List.foldl_cons, List.foldl_nil, List.length_cons, zev]
