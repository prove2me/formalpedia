-- url     : https://prove2.me/theorems/3b55c5a1-715f-4e9e-934b-edc3b176534a
-- title:
--   Algorithm 1 payoff, target, histories, regret, and approachability rate
-- statement:
--   Let $K\subseteq\mathbb R^d$ be the decision set and $\kappa=\sup_{x\in K}\|x\|$. Algorithm 1 uses adversary moves $f\in B_2(1)$, payoff $u(x,f)$, and target $S$ given by
--
--   $$u(x,f)=\bigl(\langle f,x\rangle/\kappa\bigr)\oplus(-f),\qquad S=\operatorname{cone}(\{\kappa\}\times K)^0.$$
--
--   An algorithm $A$ selects its round $t$ decision using the previous $t-1$ loss vectors. Its regret is cumulative linear loss minus the minimum cumulative loss of a fixed point of $K$. Its finite-horizon approachability rate is the distance of the average payoff to $S$.
--
--   **Formalization Note** Rounds start at one. The regret minimum is represented by the infimum of the image of $K$; it is attained when $K$ is nonempty compact. The rate uses Euclidean point-to-set distance. The definitions are only used with $\kappa>0$ and $T\ge1$ in the target results.
-- source:
--   Abernethy, Bartlett, Hazan, Blackwell Approachability and No-Regret Learning are Equivalent, COLT 2011, JMLR W&CP 19, https://proceedings.mlr.press/v19/abernethy11b.html, Definition 9, p. 33 (PDF p. 7); Algorithm 1 and Theorem 16, p. 37 (PDF p. 11)

import Mathlib
import Definitions.Def_ApproachRegret_ToOLO_Cones

open scoped RealInnerProductSpace

namespace ApproachRegret.ToOLO

/-- The norm of the decision set (p. 37). -/
noncomputable def kappa {d : ℕ} (K : Set (E d)) : ℝ :=
  sSup ((fun x : E d => ‖x‖) '' K)

/-- Algorithm 1's vector payoff. -/
noncomputable def payoff {d : ℕ} (K : Set (E d)) (x f : E d) : E (d + 1) :=
  lift (⟪f, x⟫ / kappa K) (-f)

/-- Algorithm 1's target: the polar of the cone generated by `{κ} × K`. -/
noncomputable def target {d : ℕ} (K : Set (E d)) : Set (E (d + 1)) :=
  polar (cone (lift (kappa K) '' K))

/-- The first `n` losses, with rounds numbered from one. -/
def hist {d : ℕ} (f : ℕ → E d) (n : ℕ) : Fin n → E d :=
  fun i => f (i.val + 1)

/-- The action in round `t`, chosen from losses before that round. -/
def play {d : ℕ} (A : (n : ℕ) → (Fin n → E d) → E d)
    (f : ℕ → E d) (t : ℕ) : E d :=
  A (t - 1) (hist f (t - 1))

/-- Definition 9: cumulative loss minus the best fixed decision's cumulative loss. -/
noncomputable def regret {d : ℕ} (K : Set (E d))
    (A : (n : ℕ) → (Fin n → E d) → E d) (f : ℕ → E d) (T : ℕ) : ℝ :=
  (∑ t ∈ Finset.Icc 1 T, ⟪f t, play A f t⟫) -
    sInf ((fun x : E d => ∑ t ∈ Finset.Icc 1 T, ⟪f t, x⟫) '' K)

/-- The finite-horizon rate of approachability on Algorithm 1's instance. -/
noncomputable def approachRate {d : ℕ} (K : Set (E d))
    (A : (n : ℕ) → (Fin n → E d) → E d) (f : ℕ → E d) (T : ℕ) : ℝ :=
  Metric.infDist ((T : ℝ)⁻¹ •
    ∑ t ∈ Finset.Icc 1 T, payoff K (play A f t) (f t)) (target K)

end ApproachRegret.ToOLO


