theorem modulus_mem_smoothNumbers (P : Pattern) {y : ℕ}
    (hhead : ∀ p ∈ P.primes, p ≤ y) :
    P.modulus ∈ Nat.smoothNumbers (y + 1) := by
  rw [Pattern.modulus]
