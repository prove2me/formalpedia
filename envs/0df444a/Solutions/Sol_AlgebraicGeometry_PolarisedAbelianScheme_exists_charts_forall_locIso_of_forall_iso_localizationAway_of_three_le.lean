theorem exists_μ : ∃ (μ : (w S B u i j incL).A ⟶ (v₁ S B u i l).A) (_ : μ ≫ gA₁ S B u i l = gw S B u i j incL ≫ gA₁ S B u i j)
    (hc : IsPullback μ (w S B u i j incL).f (v₁ S B u i l).f (Spec.map (CommRingCat.ofHom τi))),
    (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f),
      ((w S B u i j incL).L.mul t' x y).1 ≫ μ =
        ((v₁ S B u i l).L.mul (t' ≫ Spec.map (CommRingCat.ofHom τi))
          ⟨x.1 ≫ μ, by rw [Category.assoc, hc.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ μ, by rw [Category.assoc, hc.w, ← Category.assoc, y.2]⟩).1) ∧
    (∀ m, ((w S B u i j incL).P m).1 ≫ μ = Spec.map (CommRingCat.ofHom τi) ≫ ((v₁ S B u i l).P m).1) ∧
    Nonempty ((Scheme.Modules.pullback μ).obj (v₁ S B u i l).pol ≅ (w S B u i j incL).pol) := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u i l).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₁ S B u i j).choose_spec
  obtain ⟨hpb₃, hmul₃, hP₃, hpol₃⟩ := (hw S B u i j incL).choose_spec
  have a₁ := compg_isPullback (gA₁ S B u i j) hpb₂ (gw S B u i j incL) hpb₃
  have a₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f), _ :=
    fun t' x y => compg_mul (gA₁ S B u i j) hpb₂ hmul₂ (gw S B u i j incL) hpb₃ hmul₃ t' x y
  have a₃ := compg_P (gA := gA₁ S B u i j) (hP := hP₂) (c := gw S B u i j incL) (hcP := hP₃)
  have a₄ := compg_pol (gA₁ S B u i j) hpol₂ (gw S B u i j incL) hpol₃
  obtain ⟨c₁, c₂, c₃⟩ := clauses_congr (gw S B u i j incL ≫ gA₁ S B u i j) hτi₁ a₁ a₂ a₃
  exact AlgebraicGeometry.PolarisedAbelianScheme.exists_hom_comp_eq_isPullback_of_comp (ρ₁ S B i l).toRingHom τi
    (u i) (v₁ S B u i l) (w S B u i j incL) (gA₁ S B u i l) hpb₁ hmul₁ hP₁ hpol₁ _ c₁ c₂ c₃ a₄

