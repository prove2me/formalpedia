theorem getArrayEntry_schurColumnLoop_col_not_mem
    (cols : List Nat) (rows gram : Array (Array Int)) (row col_target : Nat)
    (h_not_mem : col_target ∉ cols) :
    getArrayEntry
        (cols.foldl
