open OAI OAI.BalancedTransport OAI.BalancedTransport.Effectivity
open BalancedTransport.Geometry


theorem solution {d : ℕ} (p : Fin d → ℝ) (t : ℝ) (x : Space) :
    HasDerivAt (fun s => fieldArgs p s x) (Pi.single (Fin.castAdd d 0) 1) t := by
  rw [hasDerivAt_pi]
  intro j
  induction j using Fin.addCases with
  | left i =>
    induction i using Fin.cases with
    | zero =>
      simp only [fieldArgs, Fin.append_left, Fin.cons_zero, Pi.single_eq_same]
      exact hasDerivAt_id t
    | succ l =>
      simp only [fieldArgs, Fin.append_left, Fin.cons_succ]
      rw [Pi.single_eq_of_ne]
      · exact hasDerivAt_const _ _
      · intro h
        have := Fin.castAdd_injective _ _ h
        exact Fin.succ_ne_zero _ this
  | right k =>
    simp only [fieldArgs, Fin.append_right]
    rw [Pi.single_eq_of_ne]
    · exact hasDerivAt_const _ _
    · intro h
      have := congrArg Fin.val h
      simp at this

