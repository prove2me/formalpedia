theorem J6Seg.segLineC_eq (hl : 1 ≤ lam) (hs : 0 < s) (hws : 2 * w < s) (hwK : w ≤ K)
    (hKm : 2 * K + 1 ≤ (LJ s t lam w).length) {nc : ℕ} (hsN : s ≤ nc * lam) {x : List ℤ}
    (hx : nc * lam ≤ x.length) {u : ℕ} (hu : u < nc * lam) :
    (segLineC P R s t lam w α K nc x).getD u 0 =
      if u < s then segInvS P lam (TT P R s t α) (BB s t lam w) (fun v => x.getD v 0) u else 0 := by sorry
