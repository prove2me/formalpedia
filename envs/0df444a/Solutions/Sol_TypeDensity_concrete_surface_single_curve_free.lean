theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O] (pi : O)
    (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ) (a : ℕ) (ha : 0 < a)
    (f : TypeDensity.ConcreteSurface O pi u a 0)
    (e : (TypeDensity.ConcreteSurface O pi u a 0 ⧸ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a 0) pi})
    ≃+* TypeDensity.SpecialFiber (IsLocalRing.ResidueField O) a 0) (c : ℕ) (hc : 0 < c)
    (hcontact : TypeDensity.contact
    (e (Ideal.Quotient.mk (Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a 0) pi}) f))
    (TypeDensity.fiberT (IsLocalRing.ResidueField O) a 0) = c) :
    Module.Free O (TypeDensity.ConcreteSurface O pi u a 0 ⧸ Ideal.span {f}) ∧ Module.Finite O
      (TypeDensity.ConcreteSurface O pi u a 0 ⧸ Ideal.span {f}) ∧ Module.finrank O
      (TypeDensity.ConcreteSurface O pi u a 0 ⧸ Ideal.span {f}) = a*c := by
  have hreg := TypeDensity.special_fiber_single_contact_regular _ a c ha _ hcontact
  have hreg' := TypeDensity.concrete_surface_residue_regular_of_special_fiber O pi u a 0 f e hreg
  have hlen := TypeDensity.single_special_fiber_length _ a c ha _ hcontact
  have hN := (TypeDensity.concrete_surface_special_fiber_length_transport O pi u a 0 f e).trans hlen
  have hfu : ¬ IsUnit f := by
    intro hu
    have hu' :=
        (hu.map (Ideal.Quotient.mk (Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a 0) pi}))).map
        e
    have htop : Ideal.span
      {e (Ideal.Quotient.mk (Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a 0) pi}) f), TypeDensity.fiberT
      (IsLocalRing.ResidueField O) a 0} = ⊤ := by
      exact Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (by simp)) hu'
    rw [TypeDensity.contact, htop] at hcontact
    have : Subsingleton
        (TypeDensity.SpecialFiber (IsLocalRing.ResidueField O) a 0 ⧸
        (⊤ : Ideal (TypeDensity.SpecialFiber (IsLocalRing.ResidueField O) a 0))) :=
