theorem oTimeAt_le (Tl : List ℕ → ℕ) {n U s p : ℕ} (hn : 1 ≤ n) (hp : 1 ≤ p) (hs : 1 ≤ s)
    (hD : s * p ≤ n) :
    oTimeAt Tl n U s p ≤ 1200 * (n * n) * (bitLen U + 1) + (n + s - 1) / s * (2 * p) *
      (300 * (n * (s * p)) + 26 * oCap n p + oSupTime Tl n (s * p) (oCap n p)) := by
  unfold oTimeAt
  unfold tCeilDiv tBitLen tDblTable tResidues tResid tClasses tChunks
  have hc1 : (n * n) ⌈/⌉ p ≤ n * n := by
    rw [ceilDiv_le_iff_le_mul (by omega)]; nlinarith
  have hc2 : n ⌈/⌉ s ≤ n := by
    rw [ceilDiv_le_iff_le_mul (by omega)]; nlinarith
  have hsD : s ≤ s * p := Nat.le_mul_of_pos_right s hp
  have hpD : p ≤ s * p := Nat.le_mul_of_pos_left p hs
  have hnn : n ≤ n * n := Nat.le_mul_of_pos_left n hn
  have hns : n * s ≤ n * (s * p) := Nat.mul_le_mul_left n hsD
  have hn1 : n ≤ n * (s * p) := Nat.le_mul_of_pos_right n (by omega)
  have hsn : s ≤ n * (s * p) := le_trans (by omega) hn1
  have hB : bitLen U ≤ n * n * bitLen U := Nat.le_mul_of_pos_left _ (by nlinarith)
  set B := bitLen U
  set m := (n + s - 1) / s
  set oS := oSupTime Tl n (s * p) (oCap n p)
  set cap := oCap n p
  have hloop : tWriteX n (s * p) s + tWriteY n (s * p) s + oS + tOScatter cap + 108 ≤
      300 * (n * (s * p)) + 26 * cap + oS := by
    unfold tWriteX tWriteY tOScatter
    have : s * n = n * s := Nat.mul_comm _ _
    have : s * p * n = n * (s * p) := Nat.mul_comm _ _
    nlinarith
  have hloop' := Nat.mul_le_mul_left (m * (2 * p)) hloop
  have hpn : p ≤ n * n := by omega
  have e : 3 * (n * n * (24 * B + 41 + 21) + 6) = 72 * (n * n * B) + 186 * (n * n) + 18 := by ring
  have e2 : 1200 * (n * n) * (B + 1) = 1200 * (n * n * B) + 1200 * (n * n) := by ring
  rw [e, e2]
  omega

/-- The largest time of the solver is one of its times. -/
theorem exists_oSupTime_eq (Tl : List ℕ → ℕ) (n D cap : ℕ) :
    ∃ w ≤ cap, oSupTime Tl n D cap = Tl [n, D, w] := by
  obtain ⟨w, hw, h⟩ := Finset.exists_mem_eq_sup (Finset.range (cap + 1))
    ⟨0, Finset.mem_range.2 (Nat.succ_pos _)⟩ (fun w => Tl [n, D, w])
  exact ⟨w, Nat.lt_succ_iff.1 (Finset.mem_range.1 hw), h⟩

/-- `2^{bitLen U} ≤ 2 U + 1`. -/
theorem two_pow_bitLen_le (U : ℕ) : 2 ^ ThreeSumApsp.Spec.bitLen U ≤ 2 * U + 1 := by
  unfold ThreeSumApsp.Spec.bitLen
  rcases Nat.eq_zero_or_pos U with rfl | hU
  · simp
  · have h1 : 1 ≤ Nat.size U := Nat.size_pos.2 hU
    have h2 : 2 ^ (Nat.size U - 1) ≤ U := Nat.lt_size.1 (by omega)
    have : 2 ^ Nat.size U = 2 * 2 ^ (Nat.size U - 1) := by
      rw [← pow_succ']; congr 1; omega
    omega

/-- **One oracle call**: eventually, for `U ≤ c n^κ` and `1 ≤ p ≤ Pmax`, the oracle at `s = sOf n`
takes at most `n^{2.9960008}`. -/
theorem oracle_bound {Tl : List ℕ → ℕ} {T : ℕ → ℕ → ℕ → ℝ} {C : ℝ}
    (hT : ∀ n D w w' : ℕ, 1 ≤ n → 1 ≤ D → w ≤ w' → (Tl [n, D, w] : ℝ) ≤ T n D w')
    (hC : ∀ n D w : ℕ, 2 ≤ D → D ^ 1249 ≤ n ^ 71 →
      T n D w ≤ C * ((n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
        + (w : ℝ) * (D : ℝ) ^ (0.4296471 : ℝ) * Real.log D + (n : ℝ) * D + w + 1))
    (c κ : ℝ) :
    ∀ᶠ n : ℕ in atTop, ∀ U : ℕ, (U : ℝ) ≤ c * (n : ℝ) ^ κ → ∀ p : ℕ, 1 ≤ p → p ≤ PmaxOf n →
      (oTimeAt Tl n U (sOf n) p : ℝ) ≤ (n : ℝ) ^ (2.9960008 : ℝ) := by
  set C' := max C 0 with hC'
  set c' := max c 1 with hc'
  set κ' := max κ 0 with hκ'
  set A := Real.log 3 + Real.log c' with hA
  have hC'0 : 0 ≤ C' := le_max_right _ _
  have hc'1 : 1 ≤ c' := le_max_right _ _
  have hκ'0 : 0 ≤ κ' := le_max_right _ _
  have hA0 : 0 ≤ A := add_nonneg (Real.log_nonneg (by norm_num)) (Real.log_nonneg hc'1)
  have hl : 0 < Real.log 2 := Real.log_pos (by norm_num)
  filter_upwards [regime, PmaxOf_le (η := 0.000000001) (by norm_num), eventually_ge_atTop 1,
    eventually_mul_rpow_le (Kc C' A κ') (e := 2.996000795) (t := 2.9960008) (by norm_num)]
    with n hreg hPm hn hev U hU p hp hpP
  obtain ⟨h2D, hDn⟩ := hreg p hp hpP
  set s := sOf n with hs
  have hs1 : 1 ≤ s := one_le_sOf n
  have hDle : s * p ≤ n := by
    by_contra h
    have h1 : n ^ 71 < (s * p) ^ 71 := Nat.pow_lt_pow_left (by omega) (by norm_num)
    have h2 : (s * p) ^ 71 ≤ (s * p) ^ 1249 := Nat.pow_le_pow_right (by omega) (by norm_num)
    omega
  have hnat := oTimeAt_le Tl (U := U) hn hp hs1 hDle
  obtain ⟨w, hw, hwe⟩ := exists_oSupTime_eq Tl n (s * p) (oCap n p)
  -- the real quantities
  set N : ℝ := (n : ℝ) with hN
  set S : ℝ := (s : ℝ) with hS
  set P : ℝ := (p : ℝ) with hP
  set M : ℝ := (((n + s - 1) / s : ℕ) : ℝ) with hM
  set Cp : ℝ := (oCap n p : ℝ) with hCp
  set B : ℝ := (ThreeSumApsp.Spec.bitLen U : ℝ) with hB
  set D : ℝ := ((s * p : ℕ) : ℝ) with hD
  set L : ℝ := Real.log D with hL
  set X : ℝ := N ^ 2 * L ^ 2 / D ^ (0.0703531 : ℝ) + Cp * D ^ (0.4296471 : ℝ) * L + N * D + Cp + 1
    with hX
  have hN1 : 1 ≤ N := by simp only [hN]; exact_mod_cast hn
  have hS1 : 1 ≤ S := by simp only [hS]; exact_mod_cast hs1
  have hP1 : 1 ≤ P := by simp only [hP]; exact_mod_cast hp
  have hM1 : 1 ≤ M := by
    simp only [hM]
    have : 1 ≤ (n + s - 1) / s := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
    exact_mod_cast this
  have hD2 : 2 ≤ D := by simp only [hD]; exact_mod_cast h2D
  have hDSP : D = S * P := by simp only [hD, hS, hP]; push_cast; rfl
  have hDN : D ≤ N := by simp only [hD, hN]; exact_mod_cast hDle
  have hCp0 : 0 ≤ Cp := Nat.cast_nonneg _
  have hB0 : 0 ≤ B := Nat.cast_nonneg _
  have hL0 : 0 ≤ L := Real.log_nonneg (by linarith)
  -- the solver
  have hsolve : (oSupTime Tl n (s * p) (oCap n p) : ℝ) ≤ C' * X := by
    rw [hwe]
    have h1 := hT n (s * p) w (oCap n p) hn (by omega) hw
    have h2 := hC n (s * p) (oCap n p) h2D hDn
    have hX0 : 0 ≤ X := by
      simp only [hX]
      have : 0 ≤ N ^ 2 * L ^ 2 / D ^ (0.0703531 : ℝ) := by positivity
      have : 0 ≤ Cp * D ^ (0.4296471 : ℝ) * L := by positivity
      nlinarith
    calc _ ≤ _ := h1
      _ ≤ _ := h2
      _ = C * X := rfl
      _ ≤ C' * X := mul_le_mul_of_nonneg_right (le_max_left _ _) hX0
  clear_value X L D B Cp M P S N
  clear hreg hDn hT hC
  have hN0 : (0 : ℝ) < N := lt_of_lt_of_le one_pos hN1
  have hS0 : (0 : ℝ) < S := lt_of_lt_of_le one_pos hS1
  have hP0 : (0 : ℝ) < P := lt_of_lt_of_le one_pos hP1
  have hM0 : (0 : ℝ) < M := lt_of_lt_of_le one_pos hM1
  have hD0 : (0 : ℝ) < D := lt_of_lt_of_le two_pos hD2
  -- the time in the reals
  have hreal1 : (oTimeAt Tl n U s p : ℝ) ≤ 1200 * N ^ 2 * (B + 1) + M * (2 * P) *
      (300 * (N * D) + 26 * Cp + (oSupTime Tl n (s * p) (oCap n p) : ℝ)) := by
    have := (Nat.cast_le (α := ℝ)).2 hnat
    simp only [hN, hB, hM, hP, hD, hCp]
    push_cast at this ⊢
    linarith
  have hND : 1 ≤ N * D := one_le_mul_of_one_le_of_one_le hN1 (by linarith)
  have hreal2 : 1200 * N ^ 2 * (B + 1) + M * (2 * P) *
      (300 * (N * D) + 26 * Cp + (oSupTime Tl n (s * p) (oCap n p) : ℝ)) ≤
      1200 * N ^ 2 * (B + 1) + M * (2 * P) *
      ((300 + 2 * C') * (N * D) + (26 + C') * Cp + C' * (N ^ 2 * L ^ 2 / D ^ (0.0703531 : ℝ))
        + C' * (Cp * D ^ (0.4296471 : ℝ) * L)) := by
    have hMP : 0 ≤ M * (2 * P) := by positivity
    have h1 : C' * 1 ≤ C' * (N * D) := mul_le_mul_of_nonneg_left hND hC'0
    have h2 : C' * X = C' * (N ^ 2 * L ^ 2 / D ^ (0.0703531 : ℝ)) + C' * (Cp * D ^ (0.4296471 : ℝ) * L)
        + C' * (N * D) + C' * Cp + C' * 1 := by simp only [hX]; ring
    have h3 : 300 * (N * D) + 26 * Cp + (oSupTime Tl n (s * p) (oCap n p) : ℝ) ≤
        (300 + 2 * C') * (N * D) + (26 + C') * Cp + C' * (N ^ 2 * L ^ 2 / D ^ (0.0703531 : ℝ))
          + C' * (Cp * D ^ (0.4296471 : ℝ) * L) := by linarith
    have := mul_le_mul_of_nonneg_left h3 hMP
    linarith
  -- the logarithms
  set ν := Real.log N with hν
  set x := Real.log S with hx
  set y := Real.log P with hy
  set μ := Real.log M with hμ
  have hNe : N = Real.exp ν := (Real.exp_log hN0).symm
  have hSe : S = Real.exp x := (Real.exp_log hS0).symm
  have hPe : P = Real.exp y := (Real.exp_log hP0).symm
  have hMe : M = Real.exp μ := (Real.exp_log hM0).symm
  have hDe : D = Real.exp (x + y) := by rw [Real.exp_add, ← hSe, ← hPe, hDSP]
  have hν0 : 0 ≤ ν := Real.log_nonneg hN1
  have hBlog : B * Real.log 2 ≤ A + κ' * ν := by
    have hUc : (U : ℝ) ≤ c' * N ^ κ' := by
      calc (U : ℝ) ≤ c * N ^ κ := hU
        _ ≤ c' * N ^ κ := mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hN0.le _)
        _ ≤ c' * N ^ κ' := mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_le hN1 (le_max_left _ _)) (by linarith)
    have h1 : 1 ≤ c' * N ^ κ' := one_le_mul_of_one_le_of_one_le hc'1 (Real.one_le_rpow hN1 hκ'0)
    have h2 : (2 : ℝ) ^ ThreeSumApsp.Spec.bitLen U ≤ 2 * U + 1 := by
      exact_mod_cast two_pow_bitLen_le U
    have hNk : 0 < N ^ κ' := Real.rpow_pos_of_pos hN0 _
    calc B * Real.log 2 = Real.log ((2 : ℝ) ^ ThreeSumApsp.Spec.bitLen U) := by
          rw [Real.log_pow, hB]
      _ ≤ Real.log (3 * (c' * N ^ κ')) := Real.log_le_log (by positivity) (by linarith)
      _ = A + κ' * ν := by
          rw [Real.log_mul (by norm_num) (by linarith : (0 : ℝ) < c' * N ^ κ').ne',
            Real.log_mul (lt_of_lt_of_le one_pos hc'1).ne' hNk.ne', Real.log_rpow hN0, hA]
          ring
  have hLν : L ≤ ν := by rw [hL]; exact Real.log_le_log hD0 hDN
  have hCpe : Cp * Real.exp y ≤ 2 * Real.exp ν ^ 2 := by
    rw [← hPe, ← hNe]
    have : oCap n p * p ≤ 2 * (n * n) := by
      have h1 : oCap n p * p ≤ n * n + p - 1 := by
        rw [oCap, Nat.ceilDiv_eq_add_pred_div]; exact Nat.div_mul_le_self _ _
      have : p ≤ n := le_trans (Nat.le_mul_of_pos_left p hs1) hDle
      have : n ≤ n * n := Nat.le_mul_of_pos_left n hn
      omega
    have := (Nat.cast_le (α := ℝ)).2 this
    push_cast at this
    rw [hCp, hP, hN, sq]; exact this
  have hμx : μ + x ≤ Real.log 2 + ν := by
    rw [← Real.log_mul hM0.ne' hS0.ne',
      ← Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hN0.ne']
    apply Real.log_le_log (mul_pos hM0 hS0)
    have := mOf_mul_sOf_le hn
    have := (Nat.cast_le (α := ℝ)).2 this
    push_cast at this
    rw [hM, hS, hN]
    exact this
  have hyx : y ≤ x + 0.000000001 * ν := by
    have h1 : P ≤ S * N ^ (0.000000001 : ℝ) := le_trans (by rw [hP]; exact_mod_cast hpP) hPm
    have hNk : 0 < N ^ (0.000000001 : ℝ) := Real.rpow_pos_of_pos hN0 _
    calc y ≤ Real.log (S * N ^ (0.000000001 : ℝ)) := Real.log_le_log (by assumption) h1
      _ = _ := by rw [Real.log_mul hS0.ne' hNk.ne', Real.log_rpow hN0]
  have hσx : 0.0284225 * ν ≤ Real.log 2 + x := by
    have h1 : N ^ (0.0284225 : ℝ) ≤ 2 * S := by rw [hN, hS, hs]; exact rpow_le_two_mul_sOf n
    calc 0.0284225 * ν = Real.log (N ^ (0.0284225 : ℝ)) := by rw [Real.log_rpow hN0]
      _ ≤ Real.log (2 * S) := Real.log_le_log (Real.rpow_pos_of_pos hN0 _) h1
      _ = _ := Real.log_mul (by norm_num) hS0.ne'
  have hxσ : x ≤ Real.log 2 + 0.0284225 * ν := by
    have h1 : S ≤ 2 * N ^ (0.0284225 : ℝ) := by rw [hN, hS, hs]; exact sOf_le_two_mul_rpow hn
    have hNk : 0 < N ^ (0.0284225 : ℝ) := Real.rpow_pos_of_pos hN0 _
    calc x ≤ Real.log (2 * N ^ (0.0284225 : ℝ)) := Real.log_le_log (by assumption) h1
      _ = _ := by rw [Real.log_mul (by norm_num) hNk.ne', Real.log_rpow hN0]
  have hcore := core_bound hC'0 hA0 hκ'0 hν0 hB0 hBlog hL0 hLν hCp0 hCpe hμx hyx hσx hxσ
  rw [← hDe, ← hNe, ← hMe, ← hPe] at hcore
  have hrp : Real.exp (2.996000795 * ν) = N ^ (2.996000795 : ℝ) := by
    rw [Real.rpow_def_of_pos hN0, mul_comm]
  rw [hrp] at hcore
  linarith
end Light.Filter
end
