    _ ≤ (36*(C+1)*Ke*M^2*B^(1/3:ℝ))*(5832*(D+1)*N^2/L^k) :=
      mul_le_mul_of_nonneg_left hs (by positivity)
    _ = _ := by dsimp [N,L]; ring

end CubicFirstMoment

