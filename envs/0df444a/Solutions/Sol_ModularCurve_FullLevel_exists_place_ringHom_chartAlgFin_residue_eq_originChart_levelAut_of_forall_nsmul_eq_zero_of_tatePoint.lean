theorem jOf_mk_mem_ssJSet_of_forall_smul_eq_zero
    (A : Type) [CommRing A] (ℓ M' q : ℕ) [NeZero M'] [Fact q.Prime]
    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : WeierstrassCurve.DrinfeldGlobal.GroupLaws A) (𝒯 : WeierstrassCurve.DrinfeldGlobal.LevelTransport A 𝒢 q)
    (κ : Type) [Field κ] [IsAlgClosed κ] [DecidableEq κ] [CharP κ q] [Algebra A κ]
    (x : (WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Raw κ)
    (hss : ∀ P : (x.curve).toAffine.Point, q • P = 0 → P = 0) :
    (WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum.jOf
      (Quot.mk _ x : (WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum.Pt κ) ∈ ssJSet q κ := by
  have hΔ : IsUnit ((WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).curve x).Δ :=
    (WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).isUnit_Δ x
  haveI : ((WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).curve x).IsElliptic := ⟨hΔ⟩
  show (WeierstrassCurve.DrinfeldGlobal.rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).jOf (Quot.mk _ x) ∈ ssJSet q κ
  rw [ModularCurve.RigidWeierstrassData.jOf_mk, WeierstrassCurve.jOfUnit_eq_j]
  exact WeierstrassCurve.j_mem_ssJSet_of_forall_smul_eq_zero q _ hss

theorem forall_map_jChartFin_mem_ssJSet
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (ℓ' : ℕ) [Fact ℓ'.Prime] (hℓ'q : ℓ' ≠ q)
    (L : Type) [Field L] [CharZero L]
    (K : IntermediateField L (LaurentSeries L))
    (hK : K = ModularCurve.laurentBaseChange L
      (ModularCurve.xHFunctionField ((q * ℓ') ^ 2 * M') (ModularCurve.FullLevel.levelH (q * ℓ') M')))
    (A₀ : Type) [CommRing A₀] [Algebra A₀ L] [Algebra A₀ ↥K] [IsScalarTower A₀ L ↥K]
    (j : ↥K) (hj : ((j : LaurentSeries L)) = ModularCurve.coeffEmb L ModularCurve.jq) [Fact (j ≠ 0)]
    (D : ModularCurve.LevelModuliDatum A₀) (P₀ : LevelModuliPackageAbs A₀ D) (x₀ : D.Pt ↥K)
    (hx₀ : ((D.jOf x₀ : ↥K) : LaurentSeries L) = ModularCurve.jqNModC L (q * ℓ'))
    (clC : P₀.B₀ →ₐ[A₀] ↥(chartAlgFin A₀ (↥K) j))
    (hclC : ∀ b : P₀.B₀, ((clC b : ↥(chartAlgFin A₀ (↥K) j)) : ↥K) = P₀.classify x₀ b)
    (κ₀ : Type) [Field κ₀] [CharP κ₀ q] [IsAlgClosed κ₀] [DecidableEq κ₀] [Algebra A₀ κ₀]
    (y : Ideal ↥(chartAlgFin A₀ (↥K) j)) (ψ : ↥(chartAlgFin A₀ (↥K) j) →ₐ[A₀] κ₀)
    (hψ : ∀ c : ↥(chartAlgFin A₀ (↥K) j), ψ c = 0 ↔ c ∈ y)
    (hssx : D.jOf (D.map (ψ.comp clC) P₀.univ) ∈ ssJSet q κ₀) :
    ∀ (Ω : Type) [Field Ω] [CharP Ω q] [IsAlgClosed Ω] [DecidableEq Ω] (φ : ↥(chartAlgFin A₀ (↥K) j) →+* Ω),
      RingHom.ker φ = y → φ (jChartFin A₀ (↥K) j) ∈ ssJSet q Ω := by
  classical

  have hjq : ((j : ↥K) : LaurentSeries L) = jqModC L := by
    rw [hj, ← jqModC_rat]; exact map_jqModC (algebraMap ℚ L)
  obtain ⟨hj', hj0', hjℓK, hjℓC⟩ :=
    ModularCurve.FullLevel.qExpand_coeffEmb_jq_mem_and_mem_chartAlgFin_laurentBaseChange_xHFunctionField q M' ℓ' L K hK A₀
  have ej : (⟨ModularCurve.coeffEmb L ModularCurve.jq, hj'⟩ : ↥K) = j := Subtype.ext hj.symm
  have hjℓC' : (⟨ModularCurve.qExpand L ℓ' (ModularCurve.coeffEmb L ModularCurve.jq), hjℓK⟩ : ↥K) ∈ chartAlgFin A₀ (↥K) j := by
    have h := hjℓC; rw [ej] at h; exact h
  let c₁ : ↥(chartAlgFin A₀ (↥K) j) := jChartFin A₀ (↥K) j
  let cℓ : ↥(chartAlgFin A₀ (↥K) j) := ⟨⟨ModularCurve.qExpand L ℓ' (ModularCurve.coeffEmb L ModularCurve.jq), hjℓK⟩, hjℓC'⟩
  let cN : ↥(chartAlgFin A₀ (↥K) j) := clC P₀.j₀
  let ι : ↥(chartAlgFin A₀ (↥K) j) →+* LaurentSeries L :=
    (algebraMap ↥K (LaurentSeries L)).comp (chartAlgFin A₀ (↥K) j).val.toRingHom
  have hι : Function.Injective ι := by
    intro a b hab; apply Subtype.ext; apply Subtype.ext; exact hab
  have hι₁ : ι c₁ = jqNModC L 1 := by rw [jqNModC_one, ← hjq]; rfl
  have hιℓ : ι cℓ = jqNModC L ℓ' := by
    show ModularCurve.qExpand L ℓ' (ModularCurve.coeffEmb L ModularCurve.jq) = jqNModC L ℓ'
    have : ModularCurve.coeffEmb L ModularCurve.jq = jqModC L := by rw [← hj]; exact hjq
    rw [this]; rfl
  have hclj : (P₀.classify x₀) P₀.j₀ = D.jOf x₀ := by
    rw [ModularCurve.LevelModuliPackageAbs.j₀, ← D.jOf_map (P₀.classify x₀) P₀.univ, P₀.map_classify]
  have hgen : ∀ m n : ℕ, m = n → ∀ [NeZero m] [NeZero n], jqNModC L m = jqNModC L n := by
    intro m n h; subst h; intro _ _; rfl
  have hcomm : jqNModC L (ℓ' * q) = jqNModC L (q * ℓ') := hgen _ _ (Nat.mul_comm ℓ' q)
  have hιN : ι cN = jqNModC L (ℓ' * q) := by
    rw [hcomm]
    show (((clC P₀.j₀ : ↥(chartAlgFin A₀ (↥K) j)) : ↥K) : LaurentSeries L) = jqNModC L (q * ℓ')
    rw [hclC, hclj]; exact hx₀

  obtain ⟨dℓ⟩ := ModularCurve.nonempty_modularPolynomialData ℓ'
  obtain ⟨dq⟩ := ModularCurve.nonempty_modularPolynomialData q
  have rel1 : dℓ.Φ.eval₂ (Polynomial.aeval (R := ℤ) c₁).toRingHom cℓ = 0 := by
    apply hι
    rw [map_zero, Polynomial.hom_eval₂, hιℓ]
    have e : ι.comp (Polynomial.aeval (R := ℤ) c₁).toRingHom = (Polynomial.aeval (R := ℤ) (jqNModC L 1)).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro n; simp
      · simp [hι₁]
    rw [e]
    simpa using dℓ.eval_jqNModC_mul_eq_zero L 1
  have rel2 : dq.Φ.eval₂ (Polynomial.aeval (R := ℤ) cℓ).toRingHom cN = 0 := by
    apply hι
    rw [map_zero, Polynomial.hom_eval₂, hιN]
    have e : ι.comp (Polynomial.aeval (R := ℤ) cℓ).toRingHom = (Polynomial.aeval (R := ℤ) (jqNModC L ℓ')).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro n; simp
      · simp [hιℓ]
    rw [e]
    exact dq.eval_jqNModC_mul_eq_zero L ℓ'

  let ψ' : ↥(chartAlgFin A₀ (↥K) j) →+* κ₀ := ψ.toRingHom
  have toRoot : ∀ {N : ℕ} [NeZero N] (d : ModularCurve.ModularPolynomialData N) (a b : κ₀),
      d.Φ.eval₂ (Polynomial.aeval (R := ℤ) a).toRingHom b = 0 →
      (d.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom κ₀) a)).IsRoot b := by
    intro N _ d a b h
    have e : (Polynomial.aeval (R := ℤ) a).toRingHom = Polynomial.eval₂RingHom (Int.castRingHom κ₀) a := by
      apply Polynomial.ringHom_ext
      · intro n; simp
      · simp
    rw [Polynomial.IsRoot, ← Polynomial.eval₂_eq_eval_map, ← e]
    exact h
  have push : ∀ {N : ℕ} [NeZero N] (d : ModularCurve.ModularPolynomialData N) (u v : ↥(chartAlgFin A₀ (↥K) j)),
      d.Φ.eval₂ (Polynomial.aeval (R := ℤ) u).toRingHom v = 0 →
      d.Φ.eval₂ (Polynomial.aeval (R := ℤ) (ψ' u)).toRingHom (ψ' v) = 0 := by
    intro N _ d u v h
    have h' := congrArg ψ' h
    rw [map_zero, Polynomial.hom_eval₂] at h'
    have e : ψ'.comp (Polynomial.aeval (R := ℤ) u).toRingHom = (Polynomial.aeval (R := ℤ) (ψ' u)).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro n; simp
      · simp
    rwa [e] at h'
  have r1 := toRoot dℓ _ _ (push dℓ c₁ cℓ rel1)
  have r2 := toRoot dq _ _ (push dq cℓ cN rel2)

  have hb : ψ' cN ∈ ssJSet q κ₀ := by
    show ψ (clC P₀.j₀) ∈ ssJSet q κ₀
    have : ψ (clC P₀.j₀) = D.jOf (D.map (ψ.comp clC) P₀.univ) := by
      rw [D.jOf_map]; rfl
    rw [this]; exact hssx

  have hKr := ModularCurve.modularPolynomial_kronecker q dq
  have hcast : Int.castRingHom κ₀ = (ZMod.castHom (dvd_refl q) κ₀).comp (Int.castRingHom (ZMod q)) :=
    RingHom.ext_int _ _
  have hcomp : Polynomial.eval₂RingHom (Int.castRingHom κ₀) (ψ' cℓ) =
      (Polynomial.eval₂RingHom (ZMod.castHom (dvd_refl q) κ₀) (ψ' cℓ)).comp
        (Polynomial.mapRingHom (Int.castRingHom (ZMod q))) := by
    apply Polynomial.ringHom_ext
    · intro n
      rw [hcast]
      simp
    · simp
  have hfac : dq.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom κ₀) (ψ' cℓ)) =
      (Polynomial.C ((ψ' cℓ) ^ q) - Polynomial.X) * (Polynomial.C (ψ' cℓ) - Polynomial.X ^ q) := by
    rw [hcomp, ← Polynomial.map_map, hKr]
    simp [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_pow]
  have hssℓ : ψ' cℓ ∈ ssJSet q κ₀ := by
    haveI : PerfectField κ₀ := inferInstance
    have h := r2
    rw [hfac, Polynomial.IsRoot, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_sub, Polynomial.eval_C,
      Polynomial.eval_X, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X] at h
    rcases mul_eq_zero.mp h with h | h
    · rw [sub_eq_zero] at h

      exact (ModularCurve.pow_mem_ssJSet_iff q (ψ' cℓ)).mp (h ▸ hb)
    · rw [sub_eq_zero] at h

      rw [h]
      exact (ModularCurve.pow_mem_ssJSet_iff q (ψ' cN)).mpr hb

  have hss1 : ψ' c₁ ∈ ssJSet q κ₀ :=
    (ModularCurve.mem_ssJSet_iff_of_isRoot_map_modularPolynomialData q ℓ' hℓ'q dℓ κ₀ (ψ' c₁) (ψ' cℓ) r1).mpr hssℓ

  have hkerψ : RingHom.ker ψ' = y := by
    ext c; rw [RingHom.mem_ker]; exact hψ c
  intro Ω _ _ _ _ φ hφ
  exact ModularCurve.forall_apply_mem_ssJSet_of_ker_eq_of_apply_mem_ssJSet q c₁ ψ' hss1 Ω φ (by rw [hφ, hkerψ])

end SSBridge

namespace TD1connAux

theorem forall_coeff_mem_of_aeval_algEquiv_mem
    (A₀ C : Type) [CommRing A₀] [IsLocalRing A₀] [CommRing C] [IsDomain C] [Algebra A₀ C] (j : C)
    (hfin : Module.Finite ↥(Algebra.adjoin A₀ ({j} : Set C)) C)
    (σ : C ≃ₐ[A₀] C) (G : Ideal C) [G.IsPrime]
    (h𝔪G : ∀ a ∈ IsLocalRing.maximalIdeal A₀, algebraMap A₀ C a ∈ G)
    (hGj : ∀ f : Polynomial A₀, Polynomial.aeval j f ∈ G → ∀ i : ℕ, f.coeff i ∈ IsLocalRing.maximalIdeal A₀) :
    ∀ f : Polynomial A₀, Polynomial.aeval (σ j) f ∈ G → ∀ i : ℕ, f.coeff i ∈ IsLocalRing.maximalIdeal A₀ := by
  classical
  intro f hf
  by_contra hnot
  push Not at hnot
  obtain ⟨i₀, hi₀⟩ := hnot
  set κ₀ := IsLocalRing.ResidueField A₀ with hκ₀
  set D := C ⧸ G with hD
  let mk : C →+* D := Ideal.Quotient.mk G
  have hker : ∀ a ∈ IsLocalRing.maximalIdeal A₀, (mk.comp (algebraMap A₀ C)) a = 0 := fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (h𝔪G a ha)
  let ι₀ : κ₀ →+* D := Ideal.Quotient.lift (IsLocalRing.maximalIdeal A₀) (mk.comp (algebraMap A₀ C)) hker
  letI : Algebra κ₀ D := ι₀.toAlgebra
  have hι₀ : ∀ a : A₀, algebraMap κ₀ D (IsLocalRing.residue A₀ a) = mk (algebraMap A₀ C a) := fun a => rfl
  have hcompι : (algebraMap κ₀ D).comp (IsLocalRing.residue A₀) = mk.comp (algebraMap A₀ C) := by
    ext a; exact hι₀ a
  set t : D := mk (σ j) with ht
  set s : D := mk j with hs

  have htalg : IsAlgebraic κ₀ t := by
    refine ⟨f.map (IsLocalRing.residue A₀), ?_, ?_⟩
    · intro h0
      apply hi₀
      have := congrArg (fun p => Polynomial.coeff p i₀) h0
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero] at this
      exact (IsLocalRing.residue_eq_zero_iff _).mp this
    · rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcompι, ht, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hf

  let S₀ : Subalgebra A₀ C := Algebra.adjoin A₀ ({j} : Set C)
  haveI : Module.Finite ↥S₀ C := hfin
  have hint_j : ∀ c : C, IsIntegral ↥S₀ c := fun c => Algebra.IsIntegral.isIntegral c

  let T : Subalgebra κ₀ D := Algebra.adjoin κ₀ ({t} : Set D)
  have hσS₀ : ∀ x : ↥S₀, mk (σ (x : C)) ∈ T := by
    intro x
    obtain ⟨x, hx⟩ := x
    induction hx using Algebra.adjoin_induction with
    | mem y hy => rw [Set.mem_singleton_iff] at hy; subst hy; exact Algebra.subset_adjoin (Set.mem_singleton _)
    | algebraMap a => rw [AlgEquiv.commutes, ← hι₀]; exact T.algebraMap_mem _
    | add x y _ _ hx hy => rw [map_add, map_add]; exact T.add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul, map_mul]; exact T.mul_mem hx hy
  let φ : ↥S₀ →+* ↥T :=
    { toFun := fun x => ⟨mk (σ (x : C)), hσS₀ x⟩
      map_one' := by ext; simp
      map_mul' := fun a b => by ext; simp
      map_zero' := by ext; simp
      map_add' := fun a b => by ext; simp }
  have hcomp : (algebraMap ↥T D).comp φ = (mk.comp (σ : C →+* C)).comp (algebraMap ↥S₀ C) := by ext x; rfl
  have hs_int : IsIntegral ↥T s := by
    have : s = (mk.comp (σ : C →+* C)) (σ.symm j) := by simp [hs]
    rw [this]
    exact (hint_j (σ.symm j)).map_of_comp_eq φ (mk.comp (σ : C →+* C)) hcomp

  haveI : Algebra.IsIntegral κ₀ ↥T := by
    rw [show T = Algebra.adjoin κ₀ ({t} : Set D) from rfl]
    exact Algebra.IsIntegral.adjoin (fun x hx => by rw [Set.mem_singleton_iff] at hx; subst hx; exact htalg.isIntegral)
  have hs_int₀ : IsIntegral κ₀ s := isIntegral_trans s hs_int

  obtain ⟨g, hgmonic, hg⟩ := hs_int₀
  obtain ⟨gl, hgl⟩ := Polynomial.map_surjective (IsLocalRing.residue A₀) IsLocalRing.residue_surjective g
  have hglj : Polynomial.aeval j gl ∈ G := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have : mk (Polynomial.aeval j gl) = Polynomial.eval₂ (algebraMap κ₀ D) s g := by
      rw [← hgl, Polynomial.eval₂_map, Polynomial.aeval_def, Polynomial.hom_eval₂]
      rfl
    rw [show (Ideal.Quotient.mk G) (Polynomial.aeval j gl) = mk (Polynomial.aeval j gl) from rfl, this]
    exact hg
  set N := g.natDegree with hN
  have hlead := hGj gl hglj N
  have hgN : g.coeff N = 1 := by rw [hN]; exact Polynomial.Monic.coeff_natDegree hgmonic
  have h1 : g.coeff N = IsLocalRing.residue A₀ (gl.coeff N) := by
    rw [← hgl, Polynomial.coeff_map]
  rw [hgN] at h1
  exact one_ne_zero (h1.trans ((IsLocalRing.residue_eq_zero_iff _).mpr hlead))

end TD1connAux

namespace SelectBAux

theorem exists_gamma0_gamma_diag_zero (q : ℕ) [hq : Fact q.Prime] (M' ℓ' : ℕ) [NeZero M'] [hℓ : Fact ℓ'.Prime]
    (hqM' : ¬ q ∣ M') (hℓ'q : ℓ' ≠ q) :
    ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ γ ∈ CongruenceSubgroup.Gamma ℓ' ∧
      (((γ 0 0 : ℤ) : ZMod q) = 0 ∧ ((γ 1 1 : ℤ) : ZMod q) = 0) := by

  have hqℓ : (q : ℤ).gcd ℓ' = 1 := by
    rw [Int.gcd_natCast_natCast]
    exact (Nat.coprime_primes hq.out hℓ.out).mpr (Ne.symm hℓ'q)
  have hqM : (q : ℤ).gcd M' = 1 := by
    rw [Int.gcd_natCast_natCast]
    exact (Nat.Prime.coprime_iff_not_dvd hq.out).mpr hqM'
  have hcop1 : IsCoprime ((M' : ℤ) * ℓ') (q : ℤ) := by
    refine IsCoprime.mul_left ?_ ?_
    · exact (Int.isCoprime_iff_gcd_eq_one.mpr (by rw [Int.gcd_comm]; exact hqM))
    · exact (Int.isCoprime_iff_gcd_eq_one.mpr (by rw [Int.gcd_comm]; exact hqℓ))
  have hcop2 : IsCoprime (q : ℤ) (ℓ' : ℤ) := Int.isCoprime_iff_gcd_eq_one.mpr hqℓ
  obtain ⟨u, v, h1⟩ := hcop1
  obtain ⟨x, y, h2⟩ := hcop2

  have hdet : Matrix.det !![v * q, -u + u * (x * q - y * ℓ') * (v * q); (M' : ℤ) * ℓ', 1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ')] = 1 := by
    rw [Matrix.det_fin_two_of]
    linear_combination (1 : ℤ) * h1
  refine ⟨⟨_, hdet⟩, ?_, ?_, ?_, ?_⟩
  ·
    rw [CongruenceSubgroup.Gamma0_mem]
    show ((((M' : ℤ) * ℓ') : ℤ) : ZMod M') = 0
    push_cast; rw [ZMod.natCast_self, zero_mul]
  ·
    rw [CongruenceSubgroup.Gamma_mem]
    have e1 : (v : ZMod ℓ') * q = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod ℓ')) h1; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    have e2 : (x : ZMod ℓ') * q = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod ℓ')) h2; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    refine ⟨?_, ?_, ?_, ?_⟩
    · show (((v * q : ℤ)) : ZMod ℓ') = 1
      push_cast; exact e1
    · show (((-u + u * (x * q - y * ℓ') * (v * q) : ℤ)) : ZMod ℓ') = 0
      push_cast; rw [ZMod.natCast_self]
      linear_combination (u * x * q) * e1 + u * e2
    · show ((((M' : ℤ) * ℓ' : ℤ)) : ZMod ℓ') = 0
      push_cast; rw [ZMod.natCast_self, mul_zero]
    · show (((1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ') : ℤ)) : ZMod ℓ') = 1
      push_cast; rw [ZMod.natCast_self]; ring
  · show (((v * q : ℤ)) : ZMod q) = 0
    push_cast; rw [ZMod.natCast_self, mul_zero]
  · show (((1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ') : ℤ)) : ZMod q) = 0
    have e3 : (u : ZMod q) * (M' * ℓ') = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod q)) h1; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    have e4 : (y : ZMod q) * ℓ' = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod q)) h2; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    push_cast; rw [ZMod.natCast_self]
    linear_combination (-(y : ZMod q) * ℓ') * e3 - e4

end SelectBAux

namespace RelabelQZeroAux

theorem eq_one_of_zpow_eq_one_of_zpow_eq_one_of_isCoprime {G : Type*} [Group G] (b : G) (n q : ℤ)
    (hn : b ^ n = 1) (hq : b ^ q = 1) (hcop : IsCoprime n q) : b = 1 := by
  obtain ⟨u, v, huv⟩ := hcop
  calc b = b ^ (1 : ℤ) := (zpow_one b).symm
    _ = b ^ (u * n + v * q) := by rw [huv]
    _ = 1 := by rw [zpow_add, mul_comm u n, mul_comm v q, zpow_mul, zpow_mul, hn, hq, one_zpow, one_zpow, one_mul]

theorem eq_one_of_zpow_mul_zpow_eq_one {G : Type*} [Group G] (a b : G) (q : ℕ) (m n : ℤ)
    (ha : a ^ (q : ℤ) = 1) (hb : b ^ (q : ℤ) = 1) (hm : (q : ℤ) ∣ m) (hn : IsCoprime n (q : ℤ))
    (h : a ^ m * b ^ n = 1) : b = 1 := by
  obtain ⟨k, rfl⟩ := hm
  have ham : a ^ ((q : ℤ) * k) = 1 := by rw [zpow_mul, ha, one_zpow]
  rw [ham, one_mul] at h
  exact eq_one_of_zpow_eq_one_of_zpow_eq_one_of_isCoprime b n q h hb hn

theorem eq_one_of_zpow_mul_zpow_eq_one_of_prime {G : Type*} [Group G] (a b : G) (q : ℕ) (hq : q.Prime) (m n : ℤ)
    (ha : a ^ (q : ℤ) = 1) (hb : b ^ (q : ℤ) = 1) (hm : (q : ℤ) ∣ m) (hn : ¬ (q : ℤ) ∣ n)
    (h : a ^ m * b ^ n = 1) : b = 1 := by
  have hprime : Prime (q : ℤ) := Nat.prime_iff_prime_int.mp hq
  have hcop : IsCoprime n (q : ℤ) := (Irreducible.coprime_iff_not_dvd hprime.irreducible).mpr hn |>.symm
  exact eq_one_of_zpow_mul_zpow_eq_one a b q m n ha hb hm hcop h

theorem eq_zpow_of_eq_zpow_mul_zpow {G : Type*} [Group G] (a b c : G) (q : ℕ) (m n u : ℤ)
    (ha : a ^ (q : ℤ) = 1) (hb : b ^ (q : ℤ) = 1) (hm : (q : ℤ) ∣ m) (hu : (q : ℤ) ∣ u * n - 1)
    (hc : c = a ^ m * b ^ n) : b = c ^ u := by
  obtain ⟨k, rfl⟩ := hm
  obtain ⟨w, hw⟩ := hu
  have ham : a ^ ((q : ℤ) * k) = 1 := by rw [zpow_mul, ha, one_zpow]
  rw [ham, one_mul] at hc
  rw [hc, ← zpow_mul]
  have : n * u = 1 + (q : ℤ) * w := by linear_combination hw
  rw [this, zpow_add, zpow_one, zpow_mul, hb, one_zpow, mul_one]

end RelabelQZeroAux

