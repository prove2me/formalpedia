/-- `fwP` wrapped as the abstract two-input list program `fermatW` expected by the glue. -/
def fwL (M : MulSpec) {Φm : ℕ} (q : Ref.Params) (kb : ℕ) (hMB : MulBnd M (q.fn + 1) Φm)
    (hP : 1 ≤ q.P) (hK : q.K ≤ q.fn) (hlo : q.logOuter ≤ q.fn) (hkb : q.logOuter ≤ kb) :
    GL.LProg2 M (FwCtx q kb) (FwPre q) (Ref.fermatW q) (fwWCost q kb Φm) where
  p := fwWrap
  I1 := wI1
  I2 := wI2
  O := wO
  hd := by decide
  hI1 := by decide
  hI2 := by decide
  hO := by decide
  run := fun s x y R1 R2 hC hPre h1 h2 =>
    (fwWrap_spec M q kb hMB hP hK hlo hkb s hC x y R1 R2 hPre h1 h2).2.1
  ok := fun s x y R1 R2 hC hPre h1 h2 =>
    (fwWrap_spec M q kb hMB hP hK hlo hkb s hC x y R1 R2 hPre h1 h2).1
  cost := fun s x y R1 R2 hC hPre h1 h2 =>
    (fwWrap_spec M q kb hMB hP hK hlo hkb s hC x y R1 R2 hPre h1 h2).2.2

theorem fwCtx_stab (q : Ref.Params) (kb : ℕ) :
    GL.Stab (FwCtx q kb) (GL.myW ++ [wI1, wI2, wO]) := by
  intro s t hs ht
  have e : ∀ j : Fin HS, j.val ∈ [32, 33, 34, 52, 53, 35, 36, 37, 38, 39] → t.G j = s.G j := by
    intro j hj
    apply ht
    revert j
    decide
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, ⟨L6, h6⟩, ⟨L7, h7⟩, ⟨L8, h8⟩,
    ⟨L9, h9⟩, ⟨L10, h10⟩⟩ := hs
  exact ⟨⟨L1, by rw [e NLogN.KB (by decide), h1]⟩, ⟨L2, by rw [e NLogN.KN (by decide), h2]⟩,
    ⟨L3, by rw [e KR (by decide), h3]⟩, ⟨L4, by rw [e RW (by decide), h4]⟩,
    ⟨L5, by rw [e FR (by decide), h5]⟩, ⟨L6, by rw [e wLO (by decide), h6]⟩,
    ⟨L7, by rw [e wKB (by decide), h7]⟩, ⟨L8, by rw [e wKM (by decide), h8]⟩,
