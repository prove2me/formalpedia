theorem scan_step (s : IState HS) (Z : List (List ℤ)) (hZ : ∀ r ∈ Z, Rec3 r) (Rst : List Item)
    (cur0 : ℤ × ℤ) (LA LB : List Item) (N k : ℕ) (hk : k < Z.length) :
