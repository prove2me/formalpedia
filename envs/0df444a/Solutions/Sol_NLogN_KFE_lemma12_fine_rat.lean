-- Source module: Solutions.AModelShear
namespace AModel

open Matrix

section Blocks

variable {m Q : ℕ}

lemma vec_ext {R : Type*} {x y : Fin (m + m) → R} (h₁ : hv x = hv y) (h₂ : dv x = dv y) :
    x = y := by
  funext k
  induction k using Fin.addCases with
  | left i => exact congrFun h₁ i
  | right j => exact congrFun h₂ j

lemma castAdd_ne_natAdd (i j : Fin m) : Fin.castAdd m i ≠ Fin.natAdd m j := by
  intro h; have := congrArg Fin.val h; simp at this; omega

lemma castAdd_lt_natAdd (i j : Fin m) : Fin.castAdd m i < Fin.natAdd m j := by
  rw [Fin.lt_def]; simp; omega

lemma blk_mulVec (P B C D : Matrix (Fin m) (Fin m) (ZMod Q)) (x : Fin (m + m) → ZMod Q) :
    hv (AModel.blk P B C D *ᵥ x) = P *ᵥ hv x + B *ᵥ dv x ∧
    dv (AModel.blk P B C D *ᵥ x) = C *ᵥ hv x + D *ᵥ dv x := by
  have key : AModel.blk P B C D *ᵥ x =
      (fromBlocks P B C D *ᵥ (x ∘ finSumFinEquiv)) ∘ finSumFinEquiv.symm := by
    rw [AModel.blk, reindex_apply, submatrix_mulVec_equiv]; rfl
  have e1 : (x ∘ finSumFinEquiv) ∘ Sum.inl = hv x := by funext i; simp [hv]
  have e2 : (x ∘ finSumFinEquiv) ∘ Sum.inr = dv x := by funext i; simp [dv]
  refine ⟨?_, ?_⟩ <;> funext i <;>
    simp [hv, dv, key, fromBlocks_mulVec, e1, e2, -Fin.natAdd_eq_addNat]

lemma blk_mul (P B C D P' B' C' D' : Matrix (Fin m) (Fin m) (ZMod Q)) :
    AModel.blk P B C D * AModel.blk P' B' C' D' =
      AModel.blk (P * P' + B * C') (P * B' + B * D') (C * P' + D * C') (C * B' + D * D') := by
  simp only [AModel.blk, reindex_apply]
  rw [submatrix_mul_equiv, fromBlocks_multiply]

lemma blk_lower {P D : Matrix (Fin m) (Fin m) (ZMod Q)} (hP : ∀ i j, i < j → P i j = 0)
    (hD : ∀ i j, i < j → D i j = 0) (C : Matrix (Fin m) (Fin m) (ZMod Q)) :
    ∀ p q, p < q → AModel.blk P 0 C D p q = 0 := by
  intro p q hpq
  induction p using Fin.addCases with
  | left i =>
    induction q using Fin.addCases with
    | left j =>
      simpa [AModel.blk, -Fin.natAdd_eq_addNat] using hP i j (by rw [Fin.lt_def] at hpq ⊢; exact hpq)
    | right j => simp [AModel.blk, -Fin.natAdd_eq_addNat]
  | right i =>
    induction q using Fin.addCases with
    | left j => exact absurd hpq (not_lt.2 (castAdd_lt_natAdd j i).le)
    | right j =>
      simpa [AModel.blk, -Fin.natAdd_eq_addNat] using hD i j ((Fin.natAdd_lt_natAdd_iff m).1 hpq)

lemma hv_shearMat (A : Matrix (Fin m) (Fin m) (ZMod Q)) (x : Fin (m + m) → ZMod Q) :
    hv (shearMat A *ᵥ x) = hv x + A *ᵥ dv x := by
  simp [shearMat, (blk_mulVec _ _ _ _ x).1]

lemma dv_shearMat (A : Matrix (Fin m) (Fin m) (ZMod Q)) (x : Fin (m + m) → ZMod Q) :
    dv (shearMat A *ᵥ x) = dv x := by
  simp [shearMat, (blk_mulVec _ _ _ _ x).2]

theorem shearMat_mul (A A' : Matrix (Fin m) (Fin m) (ZMod Q)) :
    shearMat A' * shearMat A = shearMat (A + A') := by
  simp only [shearMat, blk_mul]; congr 1 <;> simp

theorem shearMat_zero : shearMat (0 : Matrix (Fin m) (Fin m) (ZMod Q)) = 1 := by
  simp [shearMat, AModel.blk, fromBlocks_one]

section AmapShear

variable {sh : Shape} {m Q : ℕ} (Λ : Layout sh (m + m) Q) [NeZero Q]

/-- Composition of shear address maps. -/
theorem amap_shear_comp (A A' : Matrix (Fin m) (Fin m) (ZMod Q)) {a : List ℕ} (ha : AModel.Valid sh a) :
    amap Λ (shearMat A') (amap Λ (shearMat A) a) = amap Λ (shearMat (A + A')) a := by
  rw [amap_mul Λ _ _ ha, shearMat_mul]

omit [NeZero Q] in
/-- The zero shear is the identity. -/
theorem amap_shear_zero {a : List ℕ} (ha : AModel.Valid sh a) :
    amap Λ (shearMat (0 : Matrix (Fin m) (Fin m) (ZMod Q))) a = a := by
  rw [shearMat_zero, amap_one Λ ha]

end AmapShear

