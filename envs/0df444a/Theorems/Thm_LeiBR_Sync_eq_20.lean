-- title:
--   (20) — the mean error recursion $u_{k+1}\le a u_k+\sqrt N\,\alpha_{\max,k}$ of Algorithm 1
-- statement:
--   Assume Assumptions 1 and 2, $\mu>0$, and let $x^*$ be a Nash equilibrium. Let $\{x_k\}$ be generated by Algorithm 1 (abstract form) for a filtration $\{\mathcal F_k\}$, from a deterministic $x_0\in X$, with deterministic accuracies $\alpha_{i,k}\ge0$ in (8). Put $a=\|\Gamma\|$, $\alpha_{\max,k}=\max_i\alpha_{i,k}$ and
--   $$u_k=\mathbb E\left[\left\|\begin{pmatrix}\|x_{1,k}-x_1^*\|\\ \vdots\\ \|x_{N,k}-x_N^*\|\end{pmatrix}\right\|\right].$$
--   Then
--   $$u_{k+1}\le a\,u_k+\sqrt N\,\alpha_{\max,k}\qquad\forall k\ge0 .$$
--
--   This one-step recursion is the core of the geometric rate (Proposition 4): the exact BR contracts by $a$, and the inexactness enters only additively.
-- source:
--   Lei, Shanbhag, Pang & Sen, On Synchronous, Asynchronous, and Randomized Best-Response Schemes for Stochastic Nash Games, arXiv:1704.04578v2, §3.3, proof of Proposition 4, (20), p. 9; α_max,k from p. 8

import Mathlib
import Definitions.Def_LeiBR_Sync_NashGame
import Definitions.Def_LeiBR_Sync_StochGame
import Definitions.Def_LeiBR_Sync_Algorithm1

open MeasureTheory

namespace LeiBR.Sync

/-- (20), proof of Proposition 4, p. 9: for Algorithm 1 with deterministic accuracies
`α_{i,k} ≥ 0`, `u_k = E‖(‖x_{i,k} - x*_i‖)_i‖` satisfies
`u_{k+1} ≤ a u_k + √N α_{max,k}` for all `k ≥ 0`, where `a = ‖Γ‖` and
`α_{max,k} = max_i α_{i,k}`. -/
theorem eq_20
    {N : ℕ} {n : Fin N → ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] {d : ℕ} (ξ : Ω → EuclideanSpace ℝ (Fin d))
    (X : ∀ i : Fin N, Set (Strat n i)) (ψ : Fin N → Profile n → EuclideanSpace ℝ (Fin d) → ℝ)
    (gψ : ∀ i : Fin N, Profile n → EuclideanSpace ℝ (Fin d) → Strat n i) (M : Fin N → ℝ)
    (hA1 : Assumption1 P ξ X ψ gψ M) (μ : ℝ) (hμ : 0 < μ)
    (hA2 : Assumption2 X (payoff P ξ ψ) μ)
    (xhat : Profile n → Profile n) (hxhat : IsProxBR X (payoff P ξ ψ) μ xhat)
    (xs : Profile n) (hxs : IsNashEq X (payoff P ξ ψ) xs)
    (F : Filtration ℕ mΩ) (α : Fin N → ℕ → ℝ) (hα : ∀ i k, 0 ≤ α i k)
    (x0 : Profile n) (x : ℕ → Ω → Profile n) (hx : IsAlg1 P F X xhat α x0 x) :
    ∀ k : ℕ, ∫ ω, blockDist (x (k + 1) ω) xs ∂P ≤
      specNorm (Gamma X (payoff P ξ ψ) μ) * ∫ ω, blockDist (x k ω) xs ∂P +
        Real.sqrt N * ⨆ i : Fin N, α i k := by sorry

end LeiBR.Sync
