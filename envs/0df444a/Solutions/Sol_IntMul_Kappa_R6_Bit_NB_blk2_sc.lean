-- Source module: Solutions.R6BitNBNetC
/-!
# Round six, bit network: the scalar circuit and formal correctness (`FormalOK`)

The module-valued scalar circuit (formal values over `ZMod 2`) of the whole program: stage one
adds `X(T, b)` into `Y(T, b)`, stage two adds `Y(a, S)` into `X(a, S)`, the correction adds
`X` into `τ` and `τ` into `Y`. With the labels of `R6BitNBNetB` and `formal_labels`, every role
`ρ w` ends with `(swapMat, w)`.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-- Chunk gates come from instruction gates. -/
theorem genF_chunk_mem : ∀ (W : List LInstr) (f : ℕ → ℕ), ∀ chk ∈ (genF f W).2, ∃ i ∈ W, chk.2.2 = i.2.2
  | [], f, chk, h => by simp [genF_nil] at h
  | i :: W, f, chk, h => by
    rw [genF_cons] at h
    rcases List.mem_cons.1 h with rfl | h
    · exact ⟨i, List.mem_cons_self, rfl⟩
    · obtain ⟨j, hj, e⟩ := genF_chunk_mem W _ chk h
      exact ⟨j, List.mem_cons_of_mem _ hj, e⟩

theorem chunk_gates_ok {W : List LInstr} (hW : WFw W) (f : ℕ → ℕ) :
    ∀ chk ∈ (genF f W).2, ∀ p ∈ chk.2.2, p.1 < 43642 ∧ p.2 < 43642 ∧ p.1 ≠ p.2 := by
  intro chk hchk p hp
  obtain ⟨i, hi, e⟩ := genF_chunk_mem W f chk hchk
  rw [e] at hp
  obtain ⟨-, ht, hg⟩ := hW i hi
  obtain ⟨h1, h2, h3⟩ := hg p hp
  exact ⟨ht _ h1, ht _ h2, h3⟩

theorem cs2_gates : cs2.flatMap (fun chk => chk.2.2) = G2 := by
  rw [cs2_eq, genF_gates, ← gates_W2F]; rfl

section Scalar

variable {N : ℕ}

variable (ch : Ch)

theorem nYX {a s : ℕ} (ha : a < 1771) (hs : s < 1771) : ι2 a (wY s) ≠ ι2 a (wX s) := by
  intro e
  have := (ι2_inj ha ha (by simp only [wY, Nat.add_eq]; omega) (by simp only [wX]; omega) e).2
  simp only [wY, wX, Nat.add_eq] at this; omega

theorem corr_sc {a s : ℕ} (ha : a < 1771) (hs : s < 1771) (v : Wr → FVN N)
    (hv : ∀ j, j < 3 → v (ι2 a (cw s j)) = cfS ch N a s j) :
    True ∧ (∀ j, j < 3 → (corrI ch a s).foldl scalarStepM v (ι2 a (cw s j)) = cgS ch N a s j) ∧
      ∀ x, (∀ j, j < 3 → ι2 a (cw s j) ≠ x) → (corrI ch a s).foldl scalarStepM v x = v x := by
  have hU := hv 0 (by norm_num)
  have hY := hv 1 (by norm_num)
  have hX := hv 2 (by norm_num)
  rw [cw0, cfS, if_pos rfl] at hU
  rw [cw1, cfS, if_neg (by decide), if_pos rfl] at hY
  rw [cw2, cfS, if_neg (by decide), if_neg (by decide)] at hX
  have nUY := nUY ha hs
  have nUX := nUX ha hs
  obtain ⟨v1, hv1⟩ : ∃ v1, v1 = Function.update v (ι2 a (wU s)) (v (ι2 a (wU s)) + v (ι2 a (wY s))) := ⟨_, rfl⟩
  obtain ⟨v2, hv2⟩ : ∃ v2, v2 = Function.update v1 (ι2 a (wX s)) (v1 (ι2 a (wX s)) + v1 (ι2 a (wU s))) :=
    ⟨_, rfl⟩
  have hfold : (corrI ch a s).foldl scalarStepM v = v2 := by
    have s1 : scalarStepM v (xorG (ι2 a (wU s)) (ι2 a (wY s)) : NI) = v1 := by
      rw [hv1]; exact gateVecM_xorG nUY v
    have s3 : scalarStepM v1 (xorG (ι2 a (wX s)) (ι2 a (wU s)) : NI) = v2 := by
      rw [hv2]; exact gateVecM_xorG (Ne.symm nUX) v1
    have e : (corrI ch a s).foldl scalarStepM v = scalarStepM (scalarStepM (scalarStepM v
        (xorG (ι2 a (wU s)) (ι2 a (wY s)) : NI)) (Instr.edge (ι2 a (wU s)) (ch.ec a s)))
        (xorG (ι2 a (wX s)) (ι2 a (wU s)) : NI) := rfl
    rw [e, s1]; exact s3
  have eU : v1 (ι2 a (wU s)) = xrL G2 (u2 ch N a) (wY s) := by rw [hv1, Function.update_self, hU, hY, zero_add]
  have eX1 : v1 (ι2 a (wX s)) = xrL G2 (u2 ch N a) (wX s) := by
    rw [hv1, Function.update_of_ne (Ne.symm nUX), hX]
  rw [hfold]
  refine ⟨trivial, fun j hj => ?_, fun x hx => ?_⟩
  · rcases (show j = 0 ∨ j = 1 ∨ j = 2 by omega) with rfl | rfl | rfl
    · rw [cw0, cgS, if_pos rfl, hv2, Function.update_of_ne nUX, eU]
    · rw [cw1, cgS, if_neg (by decide), if_pos rfl, hv2,
        Function.update_of_ne (nYX ha hs), hv1, Function.update_of_ne (Ne.symm nUY), hY]
    · rw [cw2, cgS, if_neg (by decide), if_neg (by decide), hv2, Function.update_self, eX1, eU]
  · have h0 := hx 0 (by norm_num)
    have h2' := hx 2 (by norm_num)
    rw [cw0] at h0; rw [cw2] at h2'
    rw [hv2, Function.update_of_ne (Ne.symm h2'), hv1, Function.update_of_ne (Ne.symm h0)]

theorem u2_U {a s : ℕ} (ha : a < 1771) (hs : s < 1771) : u2 ch N a (wU s) = 0 := by
  rw [u2, if_neg (by simp only [wU]; omega), ι2, show wU s = 43642 + s from rfl]
  unfold g2
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), gw_ge (by omega) (by omega)]
  rfl

/-- Block two, scalars. -/
theorem blk2_sc_sol_aux {a : ℕ} (ha : a < 1771) (v : Wr → FVN N) (hv : ∀ w, w < 45413 → v (ι2 a w) = u2 ch N a w) :
    True ∧ (∀ w, w < 45413 → (blk2 ch a).foldl scalarStepM v (ι2 a w) = fin2S ch N a w) ∧
      ∀ x, (∀ w, w < 45413 → ι2 a w ≠ x) → (blk2 ch a).foldl scalarStepM v x = v x := by
  have hι : ∀ w w', w < 45413 → w' < 45413 → ι2 a w = ι2 a w' → w = w' :=
    fun w w' hw hw' e => (ι2_inj ha ha hw hw' e).2
  have hι' : ∀ w w', w < 43642 → w' < 43642 → ι2 a w = ι2 a w' → w = w' :=
    fun w w' hw hw' e => hι w w' (by omega) (by omega) e
  obtain ⟨c1, c2⟩ := chunkProg_scalar (R := ZMod 2) (m := 529) (ι2 a) (· < 43642) (ch.e2 a) hι' cs2
    (by rw [cs2_eq]; exact chunk_gates_ok stage2_seg.1 _) v (u2 ch N a) (fun w hw => hv w (by omega))
  rw [cs2_gates] at c1
  obtain ⟨v2, hv2⟩ : ∃ v2, v2 = (chunkProg (R := ZMod 2) (m := 529) (ι2 a) (ch.e2 a) cs2).foldl scalarStepM v :=
    ⟨_, rfl⟩
  rw [← hv2] at c1 c2
  have hpre : ∀ s ∈ List.range 1771, ∀ j, j < 3 → v2 (ι2 a (cw s j)) = cfS ch N a s j := by
    intro s hs j hj
    rw [List.mem_range] at hs
    rcases (show j = 0 ∨ j = 1 ∨ j = 2 by omega) with rfl | rfl | rfl
    · rw [cw0, cfS, if_pos rfl, c2 _ (fun w hw e => by
        have := hι w (wU s) (by omega) (by simp only [wU]; omega) e
        simp only [wU] at this; omega), hv _ (by simp only [wU]; omega), u2_U ch ha hs]
    · rw [cw1, cfS, if_neg (by decide), if_pos rfl, c1 _ (wY_lt hs)]
    · rw [cw2, cfS, if_neg (by decide), if_neg (by decide), c1 _ (wX_lt hs)]
  obtain ⟨k1, k2, k3⟩ := flat_fold (scalarStepM (R := ZMod 2) (m := 529)) (fun _ _ => True) (fun _ _ _ => by simp)
    (fun _ => trivial) (fun s j => ι2 a (cw s j)) (· < 3) (cfS ch N a) (cgS ch N a) (corrI ch a)
    (List.range 1771) List.nodup_range
    (fun s hs s' hs' hne j j' hj hj' e => hne (cw_inj (List.mem_range.1 hs) (List.mem_range.1 hs') hj hj'
      (ι2_inj ha ha (cw_lt (List.mem_range.1 hs)) (cw_lt (List.mem_range.1 hs')) e).2).1)
    (fun s hs v' hv' => corr_sc ch ha (List.mem_range.1 hs) v' hv') v2 hpre
  have hcw : ∀ w, w < 45413 → (∀ s, s < 1771 → ∀ j, j < 3 → cw s j ≠ w) →
      ∀ s ∈ List.range 1771, ∀ j, j < 3 → ι2 a (cw s j) ≠ ι2 a w := by
    intro w hw hn s hs j hj e
    exact hn s (List.mem_range.1 hs) j hj (hι _ _ (cw_lt (List.mem_range.1 hs)) hw e)
  have hblk : blk2 ch a = ((List.range 43619).map fun w => (Instr.edge (ι2 a w) (entE ch a w) : NI)) ++
      (chunkProg (R := ZMod 2) (ι2 a) (ch.e2 a) cs2 ++ (List.range 1771).flatMap (corrI ch a)) := rfl
  rw [hblk, List.foldl_append, List.foldl_append, edges_scalar, ← hv2]
  refine ⟨trivial, fun w hw => ?_, fun x hx => ?_⟩
  · unfold fin2S
    by_cases hx : w < 1771
    · rw [if_pos hx]
      have k := k2 w (List.mem_range.2 hx) 2 (by norm_num)
      rw [cw2, cgS, if_neg (by decide), if_neg (by decide)] at k
      exact k
    · by_cases hy : w < 3542
      · obtain ⟨t, rfl⟩ : ∃ t, w = 1771 + t := ⟨w - 1771, by omega⟩
        have ht : t < 1771 := by omega
        rw [if_neg hx, if_pos (show 1771 + t < 43642 by omega)]
        have k := k2 t (List.mem_range.2 ht) 1 (by norm_num)
        rw [cw1, cgS, if_neg (by decide), if_pos rfl] at k
        exact k
      · by_cases hu : w < 43642
        · rw [if_neg hx, if_pos hu, k3 _ (hcw w hw (fun s hs j hj e => by
            rw [← e] at hy hx hu
            unfold cw wU at hy hx hu; simp only [wY, wX, Nat.add_eq] at hy hx hu
            split_ifs at hy hx hu <;> omega)), c1 w hu]
        · obtain ⟨t, rfl⟩ : ∃ t, w = 43642 + t := ⟨w - 43642, by omega⟩
          have ht : t < 1771 := by omega
          rw [if_neg hx, if_neg hu, Nat.add_sub_cancel_left, show 43642 + t = cw t 0 from rfl,
            k2 t (List.mem_range.2 ht) 0 (by norm_num), cgS, if_pos rfl]
  · have hx' : ∀ s ∈ List.range 1771, ∀ j, j < 3 → ι2 a (cw s j) ≠ x := fun s hs j hj =>
      hx _ (cw_lt (List.mem_range.1 hs))
    rw [k3 x hx', c2 x (fun w hw => hx w (by omega))]

