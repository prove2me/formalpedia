      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(9159/625000:ℝ)^2/24 < 2*(851/5000:ℝ)/(1-(851/5000:ℝ)^2)^2)
