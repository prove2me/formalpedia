-- title:
--   The adaptive-query experiment of Section 4.2 and the discrete Lemma 4.2 hypotheses
-- statement:
--   `QExp` is the experiment preceding Lemma 4.5. Pool $j$ has a finite label set $N_j$ (pools may overlap); position $r$ of pool $j$ holds server data $X_{j,r}=(a_{j,r},c_{j,r})$, with `none` encoding $c_{j,r}=\bot$. Conditional on $(D,X)$ the bijections $\pi_j:N_j\to\{0,\dots,|N_j|-1\}$ are independent and uniform (`run`). Before the public point $\tau$ there are `steps` steps. At each step the querying strategy chooses a corruption query $(x,I)$, or none, from the observations so far. An observation is then drawn from the observations so far, $D$, all first components $a$, the query, and the assigned data $X_{j,\pi_j(x)}$ for $j\in I$; this is condition (i). After $\tau$ the rest of the view is drawn from the observations, $D$, $\pi$, all $a$, and $c_{j,\pi_j(x)}$ for the labels $x\in Q_j$ queried in pool $j$ by $\tau$; this is condition (ii). `exposure t X` draws independent uniform subsets $E_j$ of the positions of pool $j$, with $|E_j|=t_j$, and reveals $c_{j,r}$ for $r\in E_j$. `SeqFlagHyp` states Lemma 4.2's hypotheses for random variables on a discrete probability space. The hidden bits are independent, uniform and independent of Info. $D$ is independent of the bits given Info. There are distributions $\mu_{i,o,d,v_{<i},b}$, depending on the views only through $v_{<i}$, with $\mathcal L(\mathrm{View}_i\mid \mathrm{Info},D,\mathrm{View}_{<i},B)=\mu_{i,\mathrm{Info},D,\mathrm{View}_{<i},B_i}$ and $\mathrm{TV}(\mu_{\cdot,0},\mu_{\cdot,1})\le p$ at every feasible point.
-- source:
--   Choi 2026, STOC 2027 submission manuscript (sha256 3a47662a…), Section 4.2 and Lemma 4.2, p. 15, 17–18 (PDF 17, 19–20)

import Mathlib
import Definitions.Def_ChoiSemiHonestMPC_OTUpper_Security

open scoped BigOperators ENNReal NNReal

noncomputable section

namespace ChoiSemiHonestMPC.OTUpper

/-! ### Section 4.2: the experiment of Lemma 4.5 -/

/-- The experiment preceding Lemma 4.5 (Section 4.2).  Pools `j : J` have label sets
`N j` (finite sets of server labels, possibly overlapping); position `r` of pool `j` holds
the server data `X_{j,r} = (a_{j,r}, c_{j,r})` (`c = none` encodes `c_{j,r} = ⊥`).  Before
the public point `τ` there are `steps` steps; at each the querying strategy `query` picks a
corruption query `(x, I)` (a label and the pools it accesses, or no query) from the
observations so far, and an observation is generated by `respond` from the observations so
far, the auxiliary data `D`, all first components `a`, the query, and the assigned data
`X_{j, π_j(x)}` for `j ∈ I` — condition (i).  After `τ` the remaining observations are drawn
by `cont` from the observations so far, `D`, the bijections `π`, all `a`, and
`c_{j, π_j(x)}` for the labels `x ∈ Q_j` queried in pool `j` by `τ` — condition (ii). -/
structure QExp (J L Dsp A Cc Obs Cont : Type) [Fintype J] [DecidableEq J] [Fintype L]
    [DecidableEq L] where
  N : J → Finset L
  steps : ℕ
  query : List Obs → PMF (Option (L × Finset J))
  respond : List Obs → Dsp → ((j : J) → Fin (N j).card → A) → Option (L × Finset J) →
    ((j : J) → Option (A × Option Cc)) → PMF Obs
  cont : List Obs → Dsp → ((j : J) → {x // x ∈ N j} ≃ Fin (N j).card) →
    ((j : J) → Fin (N j).card → A) → ((j : J) → L → Option Cc) → PMF Cont

namespace QExp

variable {J L Dsp A Cc Obs Cont : Type} [Fintype J] [DecidableEq J] [Fintype L] [DecidableEq L]
variable (E : QExp J L Dsp A Cc Obs Cont)

/-- Server data of all pools. -/
abbrev Data := (j : J) → Fin (E.N j).card → A × Option Cc

/-- Label-to-position bijections `π_j : N_j → {1, …, |N_j|}` (positions from `0`). -/
abbrev Bij := (j : J) → {x // x ∈ E.N j} ≃ Fin (E.N j).card

/-- First components `a_{j,r}`. -/
def firstOf (X : E.Data) : (j : J) → Fin (E.N j).card → A := fun j r => (X j r).1

/-- One step before `τ`: query, observation, and the updated query sets `Q_j`. -/
def stepPre (D : Dsp) (X : E.Data) (π : E.Bij) (h : List Obs × (J → Finset L)) :
    PMF (List Obs × (J → Finset L)) :=
  (E.query h.1).bind fun q =>
    let data : (j : J) → Option (A × Option Cc) := fun j =>
      match q with
      | some (x, I) => if hx : x ∈ E.N j then (if j ∈ I then some (X j (π j ⟨x, hx⟩)) else none)
          else none
      | none => none
    (E.respond h.1 D (E.firstOf X) q data).map fun o =>
      (h.1 ++ [o], fun j =>
        match q with
        | some (x, I) => if j ∈ I ∧ x ∈ E.N j then insert x (h.2 j) else h.2 j
        | none => h.2 j)

/-- The experiment for fixed `(D, X)` and bijections `π`: observations up to `τ`, the query
sets `Q_j`, and the continuation. -/
def runWith (D : Dsp) (X : E.Data) (π : E.Bij) : PMF ((List Obs × (J → Finset L)) × Cont) :=
  (iterM (E.stepPre D X π) E.steps ([], fun _ => ∅)).bind fun h =>
    (E.cont h.1 D π (E.firstOf X) (fun j x =>
        if hx : x ∈ E.N j then (if x ∈ h.2 j then (X j (π j ⟨x, hx⟩)).2 else none) else none)).map
      fun c => (h, c)

/-- The experiment: conditional on `(D, X)`, the bijections `π_j` are independent and
uniform. -/
def run (dx : Dsp × E.Data) : PMF ((List Obs × (J → Finset L)) × Cont) :=
  haveI : ∀ j, Nonempty ({x // x ∈ E.N j} ≃ Fin (E.N j).card) := fun j => ⟨(E.N j).equivFin⟩
  (PMF.uniformOfFintype E.Bij).bind fun π => E.runWith dx.1 dx.2 π

open Classical in
/-- The intermediate data of Lemma 4.5: independent uniform subsets `E_j` of the positions
of pool `j` with `|E_j| = t_j`, and the second components `c_{j,r}` at `r ∈ E_j`. -/
def exposure (t : J → ℕ) (X : E.Data) :
    PMF ((j : J) → Finset (Fin (E.N j).card) × (Fin (E.N j).card → Option Cc)) :=
  if h : (Finset.univ.filter fun S : (j : J) → Finset (Fin (E.N j).card) =>
      ∀ j, (S j).card = t j).Nonempty then
    (PMF.uniformOfFinset _ h).map fun S j => (S j, fun r => if r ∈ S j then (X j r).2 else none)
  else PMF.pure fun _ => (∅, fun _ => none)

end QExp

/-! ### Lemma 4.2's hypotheses on a discrete probability space (used by Lemma 4.6) -/

/-- The hypotheses of Lemma 4.2 for random variables `Info`, hidden bits `B_1..B_K`,
auxiliary data `D` and views `View_1..View_K` on a discrete probability space `μ`: the bits
are independent, uniform and independent of `Info`; `D` is independent of the bits given
`Info`; and there are distributions `μ_{i, o, d, v_{<i}, b}` (depending on the views only
through `v_{<i}`) with `L(View_i | Info, D, View_{<i}, B_1..B_K) = μ_{i, Info, D, View_{<i}, B_i}`
and `TV(μ_{i,o,d,v,0}, μ_{i,o,d,v,1}) ≤ p` at every feasible `(o, d, v_{<i})`. -/
def SeqFlagHyp {Ω Info Dsp Vw : Type} (μ : PMF Ω) (K : ℕ) (info : Ω → Info)
    (B : Ω → Fin K → Bool) (D : Ω → Dsp) (view : Ω → Fin K → Vw) (p : ℝ) : Prop :=
  μ.map (fun ω => (info ω, B ω)) =
      (μ.map info).bind (fun o => (PMF.uniformOfFintype (Fin K → Bool)).map fun b => (o, b)) ∧
    (∀ ω₀ ∈ μ.support,
      (pcond μ fun ω => info ω = info ω₀).map (fun ω => (D ω, B ω)) =
        ((pcond μ fun ω => info ω = info ω₀).map D).bind fun d =>
          ((pcond μ fun ω => info ω = info ω₀).map B).map fun b => (d, b)) ∧
    ∃ ker : Fin K → Info → Dsp → (Fin K → Vw) → Bool → PMF Vw,
      (∀ i o d v v' b, (∀ j, j < i → v j = v' j) → ker i o d v b = ker i o d v' b) ∧
      (∀ i, ∀ ω₀ ∈ μ.support,
        (pcond μ fun ω => info ω = info ω₀ ∧ D ω = D ω₀ ∧
            (∀ j, j < i → view ω j = view ω₀ j) ∧ B ω = B ω₀).map (fun ω => view ω i) =
          ker i (info ω₀) (D ω₀) (view ω₀) (B ω₀ i)) ∧
      (∀ i, ∀ ω₀ ∈ μ.support,
        tvPMF (ker i (info ω₀) (D ω₀) (view ω₀) false) (ker i (info ω₀) (D ω₀) (view ω₀) true) ≤ p)

end ChoiSemiHonestMPC.OTUpper


