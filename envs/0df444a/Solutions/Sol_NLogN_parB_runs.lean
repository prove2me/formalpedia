  have h3g : ∀ s' : NLogN.IState NLogN.NS, s'.G NLogN.PW = .int (2 ^ (N / 2 ^ k)) :: s.G NLogN.PW →
      NLogN.IRuns I iprog (.op (.mv NLogN.PW NLogN.RMs)) s'
        ((s'.upd NLogN.PW (s.G NLogN.PW)).upd NLogN.RMs (.int (2 ^ (N / 2 ^ k)) :: s'.G NLogN.RMs)) (200 * (N + 2)) := by
    intro s' h
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, h]
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ (N / 2 ^ k))); have := NLogN.zsz_two_pow (N / 2 ^ k)
    omega
  have h3 := h3g (s1.upd NLogN.PW (.int (2 ^ (N / 2 ^ k)) :: s.G NLogN.PW)) (by simp)
  refine (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 h3)).mono' ?_ ?_
  · simp only [hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · simp only [NLogN.pow2CostS]; omega
end
