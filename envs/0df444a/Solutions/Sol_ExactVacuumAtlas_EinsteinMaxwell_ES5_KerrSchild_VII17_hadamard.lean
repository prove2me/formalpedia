/-!
# VII17 — finite-regularity analysis tools (B3 coordinate certificate, analysis layer)

Generic one-variable tools for the finite `C⁶` bootstrap at the compactified endpoint `x = 0⁺`:
* `PS g` — `g` is `C^∞` on a right neighbourhood of `0`; `RL k g` — `g, …, g⁽ᵏ⁾` have finite right limits;
  `ExtV k g L` — an independent `Cᵏ` extension across `0` agreeing with `g` on the positive side, value `L`.
* `extV_of_RL` — right limits ⇒ extension (accepted VII16 `glue`); `ExtV.RL` — the converse.
* `euler_lim` (L'Hôpital), `euler_RL` — `x M′ + (n+1) M = φ`, `x M → 0` transfers right limits from `φ` to `M`.
* `hadamard` — `G ∈ Cᵏ⁺¹`, `G(0)=0` ⇒ `G/x ∈ Cᵏ` (loses one order).
* `euler_gain` — `x g′ + 2 g = x H`, `g → 0`, `H ∈ Cᵏ` ⇒ `g ∈ Cᵏ⁺¹` (gains one order: `g′ = H − 2g/x`).
The endpoint condition `g → 0` excludes the homogeneous `c/x²` mode. No physics input.
-/

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17

open Filter Set Topology
open scoped ContDiff

theorem RL_succ {k : ℕ} {g : ℝ → ℝ} :
    RL (k + 1) g ↔ (∃ L, Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) ∧ RL k (deriv g) := Iff.rfl

theorem ev_pos : ∀ᶠ x in 𝓝[>] (0:ℝ), 0 < x := self_mem_nhdsWithin

theorem ev_ne : ∀ᶠ x in 𝓝[>] (0:ℝ), x ≠ 0 := ev_pos.mono fun _ hx => ne_of_gt hx

theorem ev_nhds {p : ℝ → Prop} (h : ∀ᶠ x in 𝓝[>] (0:ℝ), p x) :
    ∀ᶠ y in 𝓝[>] (0:ℝ), ∀ᶠ x in 𝓝 y, p x := by
  filter_upwards [eventually_eventually_nhdsWithin.2 h, ev_pos] with y hy hy0
  rwa [nhdsWithin_eq_nhds.2 (Ioi_mem_nhds hy0)] at hy

theorem deriv_congr {f g : ℝ → ℝ} (h : f =ᶠ[𝓝[>] (0:ℝ)] g) :
    deriv f =ᶠ[𝓝[>] (0:ℝ)] deriv g := by
  filter_upwards [ev_nhds h] with y hy using Filter.EventuallyEq.deriv_eq hy

theorem RL.congr : ∀ {k : ℕ} {f g : ℝ → ℝ}, f =ᶠ[𝓝[>] (0:ℝ)] g → RL k f → RL k g
  | 0, _, _, h, ⟨L, hL⟩ => ⟨L, hL.congr' h⟩
  | _ + 1, _, _, h, ⟨⟨L, hL⟩, hk⟩ => ⟨⟨L, hL.congr' h⟩, RL.congr (deriv_congr h) hk⟩

theorem contDiffAt_deriv_succ {G : ℝ → ℝ} {k : ℕ} (h : ContDiffAt ℝ ((k + 1 : ℕ)) G 0) :
    ContDiffAt ℝ k (deriv G) 0 := by
  obtain ⟨U, hU, hGU⟩ := h.contDiffOn le_rfl (by simp)
  obtain ⟨V, hVU, hVo, hV0⟩ := mem_nhds_iff.1 hU
  have := (hGU.mono hVU).deriv_of_isOpen hVo (m := k) (by push_cast; exact le_rfl)
  exact this.contDiffAt (hVo.mem_nhds hV0)

theorem RL_of_contDiffAt : ∀ (k : ℕ) {G : ℝ → ℝ}, ContDiffAt ℝ k G 0 → RL k G
  | 0, G, h => ⟨G 0, h.continuousAt.tendsto.mono_left nhdsWithin_le_nhds⟩
  | k + 1, G, h => ⟨⟨G 0, h.continuousAt.tendsto.mono_left nhdsWithin_le_nhds⟩,
      RL_of_contDiffAt k (contDiffAt_deriv_succ h)⟩

theorem ExtV.RL {k : ℕ} {g : ℝ → ℝ} {L : ℝ} (h : ExtV k g L) : RL k g := by
  obtain ⟨G, hG, he, _⟩ := h
  exact (RL_of_contDiffAt k hG).congr he

theorem ExtV.tendsto {k : ℕ} {g : ℝ → ℝ} {L : ℝ} (h : ExtV k g L) :
    Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L) := by
  obtain ⟨G, hG, he, hv⟩ := h
  rw [← hv]
  exact (hG.continuousAt.tendsto.mono_left nhdsWithin_le_nhds).congr' he

theorem RL_iter : ∀ {k : ℕ} {g : ℝ → ℝ}, RL k g →
    ∀ j ≤ k, ∃ M, Tendsto (iteratedDeriv j g) (𝓝[>] (0:ℝ)) (𝓝 M)
  | 0, g, h, j, hj => by
      obtain rfl : j = 0 := Nat.le_zero.1 hj
      rw [iteratedDeriv_zero]; exact h
  | k + 1, g, ⟨h0, hk⟩, j, hj => by
      rcases j with _ | j
      · rw [iteratedDeriv_zero]; exact h0
      · rw [iteratedDeriv_succ']
        exact RL_iter hk j (Nat.le_of_succ_le_succ hj)

theorem PS.contDiffOn {g : ℝ → ℝ} (hg : PS g) : ∃ δ > 0, ContDiffOn ℝ ∞ g (Ioo 0 δ) := by
  obtain ⟨δ, hδ, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hg
  exact ⟨δ, hδ, fun x hx => (show ContDiffAt ℝ ∞ g x from hsub hx).contDiffWithinAt⟩

section Closure
variable {f g : ℝ → ℝ} {k : ℕ} {a c L : ℝ}

theorem PS.div (hf : PS f) (hg : PS g) (hne : ∀ᶠ x in 𝓝[>] (0:ℝ), g x ≠ 0) :
    PS (fun x => f x / g x) :=
  ((hf.and hg).and hne).mono fun _ h => h.1.1.div h.1.2 h.2

theorem PS.id : PS (fun x => x) := Eventually.of_forall fun _ => contDiffAt_id

end Closure

/-- `ExtV` from right limits of derivatives (VII16 glue). -/
theorem extV_of_RL {k : ℕ} {g : ℝ → ℝ} (hg : PS g) (hR : RL k g) {L : ℝ}
    (hL : Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) : ExtV k g L := by
  obtain ⟨δ, hδ, hc⟩ := hg.contDiffOn
  choose! Lf hLf using RL_iter hR
  have hglue := VII16.contDiffOn_glue k hδ (hc.of_le (by exact_mod_cast le_top)) hLf
  refine ⟨VII16.glue Lf k g, hglue.contDiffAt (Ioo_mem_nhds (by linarith) hδ), ?_, ?_⟩
  · filter_upwards [VII16.Ioo_mem_nhdsGT' hδ] with x hx using VII16.glue_of_pos hx.1
  · rw [VII16.glue_zero]
    have h0 := hLf 0 (Nat.zero_le _)
    rw [iteratedDeriv_zero] at h0
    exact tendsto_nhds_unique h0 hL

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
