section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
set_option maxHeartbeats 1000000
theorem solution (n k j : ℕ) (s : NLogN.IState NLogN.HS) (L28 L29 L53 : List NLogN.Item)
    (h28 : s.G 28 = .int n :: L28) (h29 : s.G 29 = .int k :: L29)
    (h53 : s.G 53 = .int j :: L53) :
    NLogN.twiddleP.cost s ≤ NLogN.twiddleCost n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) := by
  have hb := NLogN.twiddleP_cost0 n k j s L28 L29 L53 h28 h29 h53
  have hA := (NLogN.tw_facts n k j).2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  have hBdef : NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) =
      2 * NLogN.expB (n + 4) (3 * (n + 4) + 14 + NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 4) +
      4 * NLogN.zsz (j : ℤ) + 4 * NLogN.zsz (k : ℤ) + 20 * n + 200 := rfl
  have zA : NLogN.zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ) ≤ NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 4 := by
    have hR0 : 0 ≤ 8 * ((j : ℤ) % k) % k := by
      rcases Nat.eq_zero_or_pos k with h | h
      · subst h; simp
      · exact Int.emod_nonneg _ (by positivity)
    have hJ : ((j : ℤ) % k) = ((j % k : ℕ) : ℤ) := by push_cast; rfl
    have hJj : ((j : ℤ) % k) ≤ j := by rw [hJ]; exact_mod_cast Nat.mod_le j k
    have hJ0 : 0 ≤ ((j : ℤ) % k) := by rw [hJ]; positivity
    have zE : NLogN.zsz (8 * ((j : ℤ) % k)) ≤ NLogN.zsz (j : ℤ) + 4 := by
      have := NLogN.zsz_mul_le (8 : ℤ) ((j : ℤ) % k)
      have e : NLogN.zsz (8 : ℤ) = 4 := by rw [show (8 : ℤ) = 2 ^ 3 by norm_num, NLogN.zsz_two_pow]
      have : NLogN.zsz ((j : ℤ) % k) ≤ NLogN.zsz (j : ℤ) := NLogN.zsz_mono (by omega)
      omega
    have zR : NLogN.zsz (8 * ((j : ℤ) % k) % k) ≤ NLogN.zsz (j : ℤ) + 4 :=
      le_trans (NLogN.zsz_emod_le _ _ (by positivity) (by positivity)) zE
    split_ifs
    · rw [Int.toNat_of_nonneg hR0]; omega
    · refine le_trans (NLogN.zsz_mono ?_) (show NLogN.zsz (k : ℤ) ≤ _ by omega)
      have : (((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat : ℤ) ≤ k := by omega
      omega
  generalize hS : n + NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 30 = S
  have hnS : n + 30 ≤ S := by omega
  have p1 : NLogN.octExpCost n (NLogN.zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ)) (NLogN.zsz (k : ℤ)) ≤ 10 ^ 20 * (2 * S) ^ 5 := by
    unfold NLogN.octExpCost; exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 5)
  have hEB : NLogN.expB (n + 4) (3 * (n + 4) + 14 + NLogN.zsz (j : ℤ) + NLogN.zsz (k : ℤ) + 4) ≤ 11 * S ^ 2 := by
    unfold NLogN.expB; nlinarith
  have p2 : NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 6 ≤ 25 * S ^ 2 := by rw [hBdef]; nlinarith
  have p3 := Nat.pow_le_pow_left p2 2
  have p4 : (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 2) ^ 2 ≤ (25 * S ^ 2) ^ 2 :=
    Nat.pow_le_pow_left (by omega) 2
  have e1 : (2 * S) ^ 5 = 32 * S ^ 5 := by ring
  have e2 : (25 * S ^ 2) ^ 2 = 625 * S ^ 4 := by ring
  have q4 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  rw [e1] at p1; rw [e2] at p3 p4
  generalize NLogN.octExpCost n (NLogN.zsz (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ)) (NLogN.zsz (k : ℤ)) = F at hb p1
  generalize (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 6) ^ 2 = G1 at hb p3
  generalize (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 2) ^ 2 = G2 at hb p4
  simp only [NLogN.twiddleCost]
  rw [hS]
  generalize S ^ 5 = W at *
  generalize S ^ 4 = W4 at *
  nlinarith
end
