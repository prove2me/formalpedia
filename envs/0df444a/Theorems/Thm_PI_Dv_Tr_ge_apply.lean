variable {K : Type} [Field K] [NumberField K] [StarRing K] [IsTotallyComplex K]
  {G : Type} [Group G] [Fintype G]

theorem PI.Dv.Tr.ge_apply {V : Type} [AddCommGroup V] [Module K V] (T : GoodSet K G) (ρ : Representation K G V)
    (s : T.S) (x : V) :
    ρ.asAlgebraHom (((Fintype.card G : ℕ) : K) • eS T s) x =
      ∑ y : G, (((finrank K (T.W s) : ℕ) : K) * LinearMap.trace K (T.W s) (T.tau s y⁻¹)) • ρ y x := by sorry
