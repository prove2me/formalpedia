-- title:
--   Orbit augmentation subspace
-- statement:
--   Let a group G act on a set X and let k be a field. The orbit augmentation subspace of the finitely supported functions X → k is the k-linear span of all differences e_(g·x) − e_x, for g in G and x in X.
-- source:
--   Unpublished research note metabelian_pure_fiber_no_go.md, §3 (Orbit-rank theorem); SHA-256 3ba5b183826a2e93741d33827b5a1d701c3df2f6d31beeb3857cc2141849e3c8.

import Mathlib

set_option autoImplicit false

/-- The subspace generated by differences of basis vectors in a group orbit.
The orbit set is not required to be finite in this definition. -/
noncomputable def legacyOrbitAugmentation
    (k G X : Type*) [Field k] [Group G] [MulAction G X] :
    Submodule k (X →₀ k) :=
  Submodule.span k
    (Set.range fun gx : G × X =>
      Finsupp.single (gx.1 • gx.2) (1 : k) - Finsupp.single gx.2 1)


