-- Source module: Solutions.GlueProp18
/-!
# Glue 2c: the opposite procedure on the tape and Proposition 18's error, unconditionally

* §1–2 `roundLI` (one opposite round on the tape: inverse twiddle `J_{-E}`, then the layer
  `H0^{⊗}`), `procLI` (rounds `h = 0, …, n-1`), `fn_procLI` and **`synth_opposite_list`**
  (`procLI` implements `F^+ B^{-1}`: at address `v` it returns `F^+(w ∘ rev)(coord v)`).
* §3 a generic error chain for list procedures (`chain_lists`, via `Synth.error_chain`) and the
  computed opposite procedure `procQI` (each round `Q_p ∘ H0^{⊗} ∘ J_{-E}`, the layer computed by
  Proposition 14's procedure as in `GlueError.layerQ_eq_prop14`): **`opp_error`**.
* §4 **`prop18_error_full`**: forward transforms of two disk arrays (computed by `procQ`),
  normalized pointwise product `P(x,z) = x z / r`, truncation `Q_p`, computed opposite transform:
  the result is within `(3ℓ + 1) √2 2^{-p}` of `M⁻¹ M_r(f, g)` (every coefficient, every valid
  address), where `M_r(f,g) = (f ∗ g)/(rM)` is the normalized cyclic convolution — all
  approximation hypotheses of `Synth.prop18_error` discharged; **`prop18_scaled_full`** after the
  exact scaling by `M`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace GlueProp18

open Finset Butterfly AModel Synth GlueLayout GlueP14 GlueError

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

/-! ## 1. Inverse twiddles and butterflies -/

/-- The inverse twiddle of axis `i` at slot `h`. -/
noncomputable def twidI (ℓ h : ℕ) (i : Fin D) (z : Arr R D) (x : Fin D → ℕ) : R :=
  yp y (-twE ℓ h (x i)) * z x

/-- All inverse twiddles of a list of axes. -/
noncomputable def twidIAll (ℓ h : ℕ) (l : List (Fin D)) (z : Arr R D) (x : Fin D → ℕ) : R :=
  yp y (-(l.map fun i => twE ℓ h (x i)).sum) * z x

/-! ## 2. The opposite procedure on the tape -/

variable {sh : Shape} {a : Fin D → ℕ} (L : CoordLayout sh a)

/-- One opposite round on the tape: `J_{-E}`, then the layer `H0^{⊗}`. -/
noncomputable def roundLI (ℓ h : ℕ) (P : Finset (Fin D)) (Sb : SelBits sh {i // i ∈ P})
    (xs : List R) : List R :=
  selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -roundEx L ℓ h P j) xs)

/-- The opposite procedure: rounds `h = 0, 1, …, n-1`. -/
noncomputable def procLI (ℓ : ℕ) (P : ℕ → Finset (Fin D))
    (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) : ℕ → List R → List R
  | 0, xs => xs
  | n + 1, xs => roundLI y L ℓ n (P n) (Sb n) (procLI ℓ P Sb n xs)

/-! ## 3. Generic error chains for list procedures; the computed opposite procedure -/

variable {r : ℕ} {C : CoeffModel y r}

/-- The computed opposite round `Q_p ∘ H0^{⊗} ∘ J_{-E}`. -/
noncomputable def compRI (C : CoeffModel y r) (p : ℕ) {ι : Type} [Fintype ι] [DecidableEq ι]
    (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List R) : List R :=
  layerQ C p Sb (twL y sh (fun j => -Ex j) xs)

/-- The computed opposite procedure (rounds `h = 0, …, n-1`). -/
noncomputable def procQI (C : CoeffModel y r) (p : ℕ) (ℓ : ℕ) (P : ℕ → Finset (Fin D))
    (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (n : ℕ) (xs : List R) : List R :=
  (List.range n).foldl (fun u k => compRI y C p (Sb k) (roundEx L ℓ k (P k)) u) xs

section OppMaps

variable {ι : Type} [Fintype ι] [DecidableEq ι] (Sb : SelBits sh ι) (Ex : ℕ → ℤ)

end OppMaps

/-! ## 4. Proposition 18 -/

section Prop18

/-- The normalized pointwise product `P(x, z) = x z / r` on arrays. -/
noncomputable def PP (C : CoeffModel y r) {N : ℕ} (x z : CArr C N) : CArr C N :=
  fun j => ((r : ℂ)⁻¹) • ((x : Fin N → R) j * (z : Fin N → R) j)

/-- `Q_p` on every record of an array. -/
noncomputable def QQ (C : CoeffModel y r) (p : ℕ) {N : ℕ} (w : CArr C N) : CArr C N :=
  fun j => QpR C p ((w : Fin N → R) j)

