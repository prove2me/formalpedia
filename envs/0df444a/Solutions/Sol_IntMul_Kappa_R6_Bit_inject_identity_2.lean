/-!
# Round six, bit side: data-free scalar facts of the invocation word

The scalar part of one invocation (`L, J, L⁻¹, V, L, J, L⁻¹, V`, dirty scratch, characteristic
two) and the coefficient identity behind it, stated for any modules (in particular for the module
of formal frame values of `R6BitNBFormal`, where the two-stage motif needs them):

* `word_dirty`: with an invertible producer `A` on the scratch, an injection `B` (scratch →
  targets) and a source copy `C` (inputs → scratch), the word restores **arbitrary** scratch and
  adds `B (A (C x))` to the targets;
* `coeff_mod_two`: for triples `S, T`, `|S ∩ T| + [|S ∩ T| = 1] ≡ [S = T] (mod 2)`;
* `inject_identity`: if target `T` receives the retained point totals `star c` (`c ∈ T`) and the
  excluded sums `star c \ (star t₁ ∪ star t₂)` (`T = {c, t₁, t₂}`), the total injected into `T`
  is `x_T` (in characteristic two). This is the identity `M = I` of the scalar exchange.
-/

namespace IntMul.Kappa.R6.Bit

section Coeff

variable {h : ℕ}

/-- Points of `T` lying in `S`, counted, and those `c` with `S ∩ T = {c}`. -/
lemma sum_star (S T : Finset (Fin h)) : (∑ c ∈ T, if c ∈ S then 1 else 0) = (S ∩ T).card := by
  rw [Finset.sum_boole, Nat.cast_id, Finset.filter_mem_eq_inter, Finset.inter_comm]

lemma sum_excl (S T : Finset (Fin h)) :
    (∑ c ∈ T, if c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S then 1 else 0) =
      if (S ∩ T).card = 1 then 1 else 0 := by
  rw [Finset.sum_boole, Nat.cast_id]
  split_ifs with h1
  · obtain ⟨a, ha⟩ := Finset.card_eq_one.1 h1
    rw [Finset.card_eq_one]
    refine ⟨a, ?_⟩
    ext c
    simp only [Finset.mem_filter, Finset.mem_singleton]
    have hamem : a ∈ S ∩ T := by rw [ha]; exact Finset.mem_singleton_self a
    constructor
    · rintro ⟨hcT, hcS, -⟩
      have : c ∈ S ∩ T := Finset.mem_inter.2 ⟨hcS, hcT⟩
      rw [ha] at this; exact Finset.mem_singleton.1 this
    · rintro rfl
      refine ⟨(Finset.mem_inter.1 hamem).2, (Finset.mem_inter.1 hamem).1, fun t ht htc htS => ?_⟩
      have : t ∈ S ∩ T := Finset.mem_inter.2 ⟨htS, ht⟩
      rw [ha] at this; exact htc (Finset.mem_singleton.1 this)
  · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    rintro c hcT ⟨hcS, hrest⟩
    apply h1
    rw [Finset.card_eq_one]
    refine ⟨c, ?_⟩
    ext t
    simp only [Finset.mem_inter, Finset.mem_singleton]
    constructor
    · rintro ⟨htS, htT⟩
      by_contra htc; exact hrest t htT htc htS
    · rintro rfl; exact ⟨hcS, hcT⟩

variable {M : Type*} [AddCommGroup M]

/-- **The injection identity.** In characteristic two (`z + z = 0`), the retained totals of the
points of `T` plus the excluded sums `(c, T \ {c})` inject exactly `x_T` into target `T`. -/
theorem inject_identity_sol_aux (h2 : ∀ z : M, z + z = 0) (trips : Finset (Finset (Fin h)))
    (htr : ∀ S ∈ trips, S.card = 3) {T : Finset (Fin h)} (hT : T ∈ trips) (x : Finset (Fin h) → M) :
    (∑ c ∈ T, ∑ S ∈ trips.filter (fun S => c ∈ S), x S) +
      (∑ c ∈ T, ∑ S ∈ trips.filter (fun S => c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S), x S) = x T := by
  have two : ∀ (n : ℕ) (z : M), n • z = (n % 2) • z := by
    intro n z
    conv_lhs => rw [← Nat.div_add_mod n 2, add_smul, mul_comm, mul_smul, two_smul, h2, smul_zero,
      zero_add]
  simp only [Finset.sum_filter]
  rw [Finset.sum_comm, Finset.sum_comm (s := T), ← Finset.sum_add_distrib]
  have hcoef : ∀ S ∈ trips, ((∑ c ∈ T, if c ∈ S then x S else 0) +
      ∑ c ∈ T, if c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S then x S else 0) = if S = T then x S else 0 := by
    intro S hS
    rw [← Finset.sum_add_distrib]
    have : ∀ c ∈ T, ((if c ∈ S then x S else 0) +
        if c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S then x S else 0) =
        ((if c ∈ S then 1 else 0) + if c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S then 1 else 0 : ℕ) • x S := by
      intro c _; split_ifs <;> simp [two_smul]
    rw [Finset.sum_congr rfl this, ← Finset.sum_smul, Finset.sum_add_distrib, sum_star, sum_excl,
      two, coeff_mod_two (htr S hS) (htr T hT)]
    split_ifs <;> simp
  rw [Finset.sum_congr rfl hcoef, Finset.sum_ite_eq' trips T, if_pos hT]

end Coeff

