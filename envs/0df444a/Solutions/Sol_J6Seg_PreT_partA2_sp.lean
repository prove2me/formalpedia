theorem zr_eq_self {w : Fin HS → ℤ} (h : ∀ j, Wk j → w j = 0) : zr w = w := by
  funext j; unfold zr; split_ifs with hj
  · exact (h j hj).symm
  · rfl

theorem CS_wk (u : Fin HS → ℤ) (q : ℤ) : ∀ j, Wk j → CS u q j = 0 := by
  intro j hj
  have h6 : j ≠ 6 := by rintro rfl; unfold Wk at hj; revert hj; decide
  unfold Wk at hj
  simp only [CS, Function.update_of_ne h6, Z]
