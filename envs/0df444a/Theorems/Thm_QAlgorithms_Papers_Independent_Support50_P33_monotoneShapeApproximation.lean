section LocallyConvexResults

variable {E : Type*} [UniformSpace E] [AddCommGroup E] [Module ℝ E]
    [hgroup : IsUniformAddGroup E] [hsmul : ContinuousSMul ℝ E]
    [hlc : LocallyConvexSpace ℝ E] [hhaus : T2Space E]

include hgroup hsmul hlc hhaus

/-- Corollary, arXiv:1004.3792v1, PDF p.5. Both the convex and concave
alternatives are retained. Stability is relative openness of midpoint
mixing. Limits may be positive infinite; approximants are real, bounded
and continuous, with a bound for each term and pointwise convergence. -/
theorem monotoneShapeApproximation (A : Set E)
    (hA : GeneralBarycenterSpace A) (hc : Convex ℝ A)
    (hstable : StableConvexSet A) (hmu : MuCompact A) :
    (∀ f : E → EReal, LowerSemicontinuous (fun x : A => f x) →
      (∃ c : ℝ, ∀ x ∈ A, (c : EReal) ≤ f x) → extendedConvexOn A f →
      ∃ g : ℕ → E → ℝ,
        (∀ n, BoundedContinuousOn A (g n) ∧ ConvexOn ℝ A (g n)) ∧
        (∀ x ∈ A, Monotone (fun n => g n x)) ∧
        ∀ x ∈ A, Tendsto (fun n => (g n x : EReal)) atTop (𝓝 (f x))) ∧
    (∀ f : E → EReal, LowerSemicontinuous (fun x : A => f x) →
      (∃ c : ℝ, ∀ x ∈ A, (c : EReal) ≤ f x) →
      extendedConvexOn A (fun x => -f x) →
      ∃ g : ℕ → E → ℝ,
        (∀ n, BoundedContinuousOn A (g n) ∧ ConcaveOn ℝ A (g n)) ∧
        (∀ x ∈ A, Monotone (fun n => g n x)) ∧
        ∀ x ∈ A, Tendsto (fun n => (g n x : EReal)) atTop (𝓝 (f x))) := by sorry

end LocallyConvexResults

end QAlgorithms.Papers.Independent.Support50.P33

