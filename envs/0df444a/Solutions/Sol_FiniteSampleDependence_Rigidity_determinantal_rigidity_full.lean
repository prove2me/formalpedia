namespace FiniteSampleDependence.Dev.GoalS

open FiniteSampleDependence.Rigidity FiniteSampleDependence.Dev.GoalB MvPolynomial Matrix
open scoped Classical

variable {k m : ℕ}

abbrev Mat (k m : ℕ) := Matrix (Fin (k + 1)) (Fin m) ℝ

lemma polyFun_submatrix_det {p : Type} [Fintype p] [DecidableEq p] (r : p → Fin (k + 1))
    (c : p → Fin m) (U : Mat k m) :
    polyFun (((genericMatrix (k + 1) m).submatrix r c).det) U = (U.submatrix r c).det := by
  unfold polyFun
  rw [RingHom.map_det]
  congr 1
  refine Matrix.ext fun i j => ?_
  simp [genericMatrix, Matrix.mvPolynomialX_apply]

lemma polyFun_delta (hkm : k + 1 ≤ m) (U : Mat k m) :
    polyFun (delta hkm) U = (U.submatrix Fin.castSucc (colk hkm)).det :=
  polyFun_submatrix_det _ _ U

lemma polyFun_mu (hkm : k + 1 ≤ m) (α : Fin m) (U : Mat k m) :
    polyFun (mu hkm α) U = (U.submatrix id (sα hkm α)).det :=
  polyFun_submatrix_det _ _ U

def Agree (U U' : Mat k m) : Prop :=
  ∀ i α, (i ≠ Fin.last k ∨ α.val < k) → U i α = U' i α

lemma polyFun_W (hkm : k + 1 ≤ m) (α : Fin m) (U : Mat k m) :
    polyFun (W hkm α) U = ∑ j : Fin k, (-1) ^ (k + j.val) * U (Fin.last k) (colk hkm j) *
      (U.submatrix ((Fin.last k).succAbove) (sα hkm α ∘ (Fin.castSucc j).succAbove)).det := by
  unfold W
  simp only [Matrix.submatrix_submatrix]
  simp only [polyFun, map_sum, map_mul, map_pow, map_neg, map_one, eval_X]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  have h2 := polyFun_submatrix_det (m := m) (p := Fin k) (id ∘ (Fin.last k).succAbove)
    (sα hkm α ∘ (Fin.castSucc j).succAbove) U
  simp only [polyFun] at h2
  rw [h2]
  rfl

lemma polyFun_W_agree (hkm : k + 1 ≤ m) (α : Fin m) {U U' : Mat k m} (h : Agree U U') :
    polyFun (W hkm α) U = polyFun (W hkm α) U' := by
  rw [polyFun_W, polyFun_W]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  have h1 : U (Fin.last k) (colk hkm j) = U' (Fin.last k) (colk hkm j) :=
    h _ _ (Or.inr (by simp [colk]))
  have h4 : U.submatrix ((Fin.last k).succAbove) (sα hkm α ∘ (Fin.castSucc j).succAbove)
      = U'.submatrix ((Fin.last k).succAbove) (sα hkm α ∘ (Fin.castSucc j).succAbove) := by
    refine Matrix.ext fun i l => ?_
    exact h _ _ (Or.inl (Fin.succAbove_ne _ i))
  rw [h1, h4]

lemma polyFun_delta_agree (hkm : k + 1 ≤ m) {U U' : Mat k m} (h : Agree U U') :
    polyFun (delta hkm) U = polyFun (delta hkm) U' := by
  rw [polyFun_delta, polyFun_delta]
  congr 1
  refine Matrix.ext fun i l => ?_
  exact h _ _ (Or.inl (Fin.castSucc_lt_last i).ne)

lemma polyFun_mu_eq (hkm : k + 1 ≤ m) (α : Fin m) (U : Mat k m) :
    (U.submatrix id (sα hkm α)).det
      = (U.submatrix Fin.castSucc (colk hkm)).det * U (Fin.last k) α
        + polyFun (W hkm α) U := by
  rw [← polyFun_mu, ← polyFun_delta, mu_eq]
  simp [polyFun]

def Amat (hkm : k + 1 ≤ m) (U : Mat k m) : Matrix (Fin k) (Fin k) ℝ :=
  U.submatrix Fin.castSucc (colk hkm)

noncomputable def lam (hkm : k + 1 ≤ m) (U : Mat k m) : Fin k → ℝ :=
  (fun j => U (Fin.last k) (colk hkm j)) ᵥ* (Amat hkm U)⁻¹

noncomputable def dstar (hkm : k + 1 ≤ m) (U : Mat k m) (α : Fin m) : ℝ :=
  ∑ i : Fin k, lam hkm U i * U (Fin.castSucc i) α

def Good (hkm : k + 1 ≤ m) (U : Mat k m) : Prop :=
  (Amat hkm U).det ≠ 0 ∧ (∀ i : Fin k, ∀ α, 0 < U (Fin.castSucc i) α) ∧ ∀ i, 0 < lam hkm U i

/-- Replace the entries `(last, α)` with `α ≥ k` by `d α`. -/
def fillU (U : Mat k m) (d : Fin m → ℝ) : Mat k m :=
  Matrix.of fun i α => if i = Fin.last k ∧ k ≤ α.val then d α else U i α

lemma polyFun_delta_Amat (hkm : k + 1 ≤ m) (U : Mat k m) :
    polyFun (delta hkm) U = (Amat hkm U).det := polyFun_delta hkm U

lemma last_eq (hkm : k + 1 ≤ m) (U : Mat k m) (hdet : (Amat hkm U).det ≠ 0) (j : Fin k) :
    U (Fin.last k) (colk hkm j) = ∑ i : Fin k, lam hkm U i * U (Fin.castSucc i) (colk hkm j) := by
  have hu : IsUnit (Amat hkm U).det := isUnit_iff_ne_zero.2 hdet
  have : (lam hkm U ᵥ* Amat hkm U) j = (fun j => U (Fin.last k) (colk hkm j)) j := by
    unfold lam
    rw [Matrix.vecMul_vecMul, Matrix.nonsing_inv_mul _ hu, Matrix.vecMul_one]
  simpa [Matrix.vecMul, dotProduct, Amat] using this.symm

lemma det_zero_of_lastrow (M : Matrix (Fin (k + 1)) (Fin (k + 1)) ℝ) (c : Fin k → ℝ)
    (h : ∀ j, M (Fin.last k) j = ∑ i : Fin k, c i * M (Fin.castSucc i) j) : M.det = 0 := by
  rw [← Matrix.exists_vecMul_eq_zero_iff]
  refine ⟨Fin.snoc (α := fun _ => ℝ) (fun i => -c i) 1, ?_, ?_⟩
  · intro h0
    have := congrFun h0 (Fin.last k)
    simp at this
  · ext j
    simp [Matrix.vecMul, dotProduct, Fin.sum_univ_castSucc, h j, Finset.sum_neg_distrib]

lemma fill_castSucc (U : Mat k m) (d : Fin m → ℝ) (i : Fin k) (α : Fin m) :
    fillU U d (Fin.castSucc i) α = U (Fin.castSucc i) α := by
  simp [fillU, (Fin.castSucc_lt_last i).ne]

lemma fill_agree (U : Mat k m) (d : Fin m → ℝ) : Agree (fillU U d) U := by
  intro i α h
  rcases h with h | h
  · simp [fillU, h]
  · simp [fillU, not_le.2 h]

lemma fill_last_lt (U : Mat k m) (d : Fin m → ℝ) (α : Fin m) (h : α.val < k) :
    fillU U d (Fin.last k) α = U (Fin.last k) α := by
  simp [fillU, not_le.2 h]

lemma fill_last_ge (U : Mat k m) (d : Fin m → ℝ) (α : Fin m) (h : k ≤ α.val) :
    fillU U d (Fin.last k) α = d α := by
  simp [fillU, h]

lemma fill_dstar_lastrow (hkm : k + 1 ≤ m) (U : Mat k m) (hdet : (Amat hkm U).det ≠ 0)
    (α : Fin m) :
    fillU U (dstar hkm U) (Fin.last k) α
      = ∑ i : Fin k, lam hkm U i * fillU U (dstar hkm U) (Fin.castSucc i) α := by
  simp only [fill_castSucc]
  by_cases h : k ≤ α.val
  · rw [fill_last_ge _ _ _ h]; rfl
  · have h' : α.val < k := not_le.1 h
    rw [fill_last_lt _ _ _ h']
    have := last_eq hkm U hdet ⟨α.val, h'⟩
    have hα : colk hkm ⟨α.val, h'⟩ = α := Fin.ext rfl
    rwa [hα] at this

lemma delta_fill (hkm : k + 1 ≤ m) (U : Mat k m) (d : Fin m → ℝ) :
    (Amat hkm (fillU U d)).det = (Amat hkm U).det := by
  rw [← polyFun_delta_Amat, ← polyFun_delta_Amat]
  exact polyFun_delta_agree hkm (fill_agree U d)

/-- Key affine formula: the minors of the filled matrix. -/
lemma mu_fill (hkm : k + 1 ≤ m) (U : Mat k m) (hdet : (Amat hkm U).det ≠ 0) (d : Fin m → ℝ)
    (α : Fin m) (hα : k ≤ α.val) :
    ((fillU U d).submatrix id (sα hkm α)).det = (Amat hkm U).det * (d α - dstar hkm U α) := by
  have h0 : ((fillU U (dstar hkm U)).submatrix id (sα hkm α)).det = 0 := by
    refine det_zero_of_lastrow _ (lam hkm U) (fun j => ?_)
    simpa using fill_dstar_lastrow hkm U hdet (sα hkm α j)
  rw [polyFun_mu_eq] at h0 ⊢
  have hW := polyFun_W_agree hkm α (fill_agree U d)
  have hW' := polyFun_W_agree hkm α (fill_agree U (dstar hkm U))
  have hdl := delta_fill hkm U d
  have hdl' := delta_fill hkm U (dstar hkm U)
  have e1 : (fillU U (dstar hkm U)).submatrix Fin.castSucc (colk hkm) = Amat hkm (fillU U (dstar hkm U)) := rfl
  have e2 : (fillU U d).submatrix Fin.castSucc (colk hkm) = Amat hkm (fillU U d) := rfl
  rw [e1, hdl', fill_last_ge _ _ _ hα, hW'] at h0
  rw [e2, hdl, fill_last_ge _ _ _ hα, hW]
  linarith

lemma polyFun_theta (hkm : k + 1 ≤ m) (P : PolyRing (k + 1) m) (U : Mat k m) :
    polyFun (theta hkm P) U
      = polyFun P (fillU U (fun α => (U.submatrix id (sα hkm α)).det)) := by
  have : (eval (fun p : Fin (k + 1) × Fin m => U p.1 p.2)).comp
      (theta hkm : PolyRing (k + 1) m →ₐ[ℝ] _).toRingHom
      = eval (fun p : Fin (k + 1) × Fin m =>
          fillU U (fun α => (U.submatrix id (sα hkm α)).det) p.1 p.2) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun v => ?_)
    · simp [theta]
    · by_cases hv : v ∈ Qs k m
      · have := mem_Qs.1 hv
        simp [theta, hv, fillU, this.1, this.2]
        exact polyFun_mu hkm v.2 U
      · have := mt mem_Qs.2 hv
        simp [theta, hv, fillU]
        intro h1 h2
        exact absurd ⟨h1, h2⟩ this
  exact congrArg (fun f => f P) this

lemma fill_fill (U : Mat k m) (d d' : Fin m → ℝ) : fillU (fillU U d) d' = fillU U d' := by
  refine Matrix.ext fun i α => ?_
  by_cases h : i = Fin.last k ∧ k ≤ α.val <;> simp [fillU, h]

lemma good_dstar_pos (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (U : Mat k m) (hg : Good hkm U) (α : Fin m) :
    0 < dstar hkm U α :=
  Finset.sum_pos (fun i _ => mul_pos (hg.2.2 i) (hg.2.1 i α)) ⟨⟨0, hk⟩, Finset.mem_univ _⟩

lemma good_last_pos (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (U : Mat k m) (hg : Good hkm U) (α : Fin m)
    (h : α.val < k) : 0 < U (Fin.last k) α := by
  have := last_eq hkm U hg.1 ⟨α.val, h⟩
  have hα : colk hkm ⟨α.val, h⟩ = α := Fin.ext rfl
  rw [hα] at this
  rw [this]
  exact Finset.sum_pos (fun i _ => mul_pos (hg.2.2 i) (hg.2.1 i α)) ⟨⟨0, hk⟩, Finset.mem_univ _⟩

lemma fill_pos (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (U : Mat k m) (hg : Good hkm U) (d : Fin m → ℝ)
    (hd : ∀ α : Fin m, k ≤ α.val → 0 < d α) (i : Fin (k + 1)) (α : Fin m) :
    0 < fillU U d i α := by
  by_cases h : i = Fin.last k ∧ k ≤ α.val
  · simp only [fillU, Matrix.of_apply, h, and_self, if_true]
    exact hd α h.2
  · simp only [fillU, Matrix.of_apply, h, if_false]
    by_cases hi : i = Fin.last k
    · subst hi
      exact good_last_pos hkm hk U hg α (not_le.1 (fun h2 => h ⟨rfl, h2⟩))
    · obtain ⟨j, rfl⟩ := Fin.exists_castSucc_eq.2 hi
      exact hg.2.1 j α

lemma fill_congr (U : Mat k m) (d d' : Fin m → ℝ) (h : ∀ α : Fin m, k ≤ α.val → d α = d' α) :
    fillU U d = fillU U d' := by
  refine Matrix.ext fun i α => ?_
  by_cases hh : i = Fin.last k ∧ k ≤ α.val
  · simp [fillU, hh, h α hh.2]
  · simp [fillU, hh]

lemma core_point (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (H H' : PolyRing (k + 1) m) (N : ℕ)
    (hN : Even N) (hH' : theta hkm H' = delta hkm ^ N * H)
    (hpos : ∀ V : Mat k m, (∀ i α, 0 < V i α) → 0 ≤ polyFun H V)
    (hzero : ∀ V : Mat k m, (∀ i α, 0 < V i α) →
      (∃ c : Fin k → ℝ, (∀ i, 0 ≤ c i) ∧
        ∀ α, V (Fin.last k) α = ∑ i : Fin k, c i * V (Fin.castSucc i) α) → polyFun H V = 0)
    (U : Mat k m) (hg : Good hkm U) (β : Fin m) (hβ : k ≤ β.val) :
    polyFun H' (fillU U 0) = 0 ∧
      polyFun (pderiv (Fin.last k, β) H') (fillU U 0) = 0 := by
  set δ := (Amat hkm U).det with hδdef
  have hδ : δ ≠ 0 := hg.1
  let ds : ℝ → Fin m → ℝ := fun s => Function.update (dstar hkm U) β (dstar hkm U β + s / δ)
  have hV : ∀ s : ℝ, polyFun H' (fillU U (Function.update (0 : Fin m → ℝ) β s))
      = δ ^ N * polyFun H (fillU U (ds s)) := by
    intro s
    have h1 := congrArg (fun P => polyFun P (fillU U (ds s))) hH'
    simp only [polyFun_theta, fill_fill] at h1
    have h2 : polyFun (delta hkm) (fillU U (ds s)) = δ := by
      rw [polyFun_delta_Amat, delta_fill]
    have h3 : polyFun (delta hkm ^ N * H) (fillU U (ds s))
        = δ ^ N * polyFun H (fillU U (ds s)) := by
      simp only [polyFun, map_mul, map_pow] at h2 ⊢
      rw [h2]
    rw [h3] at h1
    rw [← h1]
    congr 1
    refine fill_congr _ _ _ (fun α hα => ?_)
    rw [mu_fill hkm U hg.1 (ds s) α hα]
    by_cases hαβ : α = β
    · subst hαβ
      simp [ds]
      field_simp
      rfl
    · simp [ds, Function.update_of_ne hαβ]
  -- the function of `s`
  set x0 : Fin (k + 1) × Fin m → ℝ := fun p => fillU U 0 p.1 p.2 with hx0
  set v : Fin (k + 1) × Fin m := (Fin.last k, β) with hv
  have hx0v : x0 v = 0 := by simp [hx0, hv, fillU, hβ]
  have hφ : ∀ s : ℝ, polyFun H' (fillU U (Function.update (0 : Fin m → ℝ) β s))
      = eval (Function.update x0 v s) H' := by
    intro s
    unfold polyFun
    have hfun : (fun p : Fin (k + 1) × Fin m => fillU U (Function.update (0 : Fin m → ℝ) β s) p.1 p.2)
        = Function.update x0 v s := by
     funext p
     rcases p with ⟨i, α⟩
     by_cases hp : (i, α) = v
     · have hi : i = Fin.last k := (Prod.ext_iff.1 hp).1
       have hα : α = β := (Prod.ext_iff.1 hp).2
       subst hi; subst hα
       simp [hv, fillU, hβ]
     · have hα : ¬ (i = Fin.last k ∧ α = β) := fun h => hp (by rw [hv, h.1, h.2])
       simp only [Function.update_of_ne hp, hx0, fillU, Matrix.of_apply]
       by_cases hh : i = Fin.last k ∧ k ≤ α.val
       · have : α ≠ β := fun h2 => hα ⟨hh.1, h2⟩
         simp [hh, Function.update_of_ne this]
       · simp [hh]
    rw [hfun]
  have hφ0 : polyFun H' (fillU U 0) = eval x0 H' := rfl
  have hzero0 : eval (Function.update x0 v 0) H' = 0 := by
    rw [← hφ, hV]
    have hds : ds 0 = dstar hkm U := by simp [ds]
    rw [hds]
    have hpos0 : ∀ i α, 0 < fillU U (dstar hkm U) i α :=
      fill_pos hkm hk U hg _ (fun α _ => good_dstar_pos hkm hk U hg α)
    have := hzero _ hpos0 ⟨lam hkm U, fun i => (hg.2.2 i).le, fill_dstar_lastrow hkm U hg.1⟩
    rw [this, mul_zero]
  have hupd : Function.update x0 v 0 = x0 := by
    rw [← hx0v]; exact Function.update_eq_self v x0
  have hmin : IsLocalMin (fun s => eval (Function.update x0 v s) H') 0 := by
    have hr : 0 < |δ| * dstar hkm U β := mul_pos (abs_pos.2 hδ) (good_dstar_pos hkm hk U hg β)
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hr] with s hs
    rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hs
    show eval (Function.update x0 v 0) H' ≤ eval (Function.update x0 v s) H'
    rw [hzero0, ← hφ, hV]
    refine mul_nonneg (hN.pow_nonneg δ) (hpos _ (fill_pos hkm hk U hg (ds s) (fun α hα => ?_)))
    by_cases hαβ : α = β
    · subst hαβ
      simp only [ds, Function.update_self]
      have h1 : |s / δ| < dstar hkm U α := by
        rw [abs_div, div_lt_iff₀ (abs_pos.2 hδ)]
        linarith
      have := neg_abs_le (s / δ)
      linarith
    · simp only [ds, Function.update_of_ne hαβ]
      exact good_dstar_pos hkm hk U hg α
  have hd := GoalA.hasDerivAt_eval_update H' x0 v
  rw [hx0v] at hd
  refine ⟨?_, ?_⟩
  · rw [hφ0, ← hupd]; exact hzero0
  · exact hmin.hasDerivAt_eq_zero (f' := eval x0 (pderiv v H')) (by convert hd)

/-- The base positive point of the paper (with `ε = 1`). -/
noncomputable def U0 (k m : ℕ) : Mat k m :=
  Matrix.of fun i α => if i.val < k then (1 + if i.val = α.val then 1 else 0 : ℝ)
    else ∑ i' : Fin k, (1 + if i'.val = α.val then 1 else 0 : ℝ)

lemma det_J_ne (k : ℕ) :
    (Matrix.of fun (i j : Fin k) => (1 + if i.val = j.val then 1 else 0 : ℝ)).det ≠ 0 := by
  intro h
  obtain ⟨v, hv, hv0⟩ := (Matrix.exists_mulVec_eq_zero_iff).2 h
  have h1 : ∀ i, (∑ j, v j) + v i = 0 := by
    intro i
    have := congrFun hv0 i
    simpa [Matrix.mulVec, dotProduct, add_mul, Finset.sum_add_distrib, Fin.val_inj] using this
  have h2 : ∀ i, v i = -(∑ j, v j) := fun i => by linarith [h1 i]
  have h3 : (∑ j, v j) = -(k : ℝ) * (∑ j, v j) := by
    conv_lhs => rw [Finset.sum_congr rfl (fun i _ => h2 i)]
    simp
  have h4 : (∑ j, v j) = 0 := by
    have : ((k : ℝ) + 1) * (∑ j, v j) = 0 := by linarith
    rcases mul_eq_zero.1 this with h | h
    · have : (0 : ℝ) < (k : ℝ) + 1 := by positivity
      linarith
    · exact h
  apply hv
  funext i
  rw [h2 i, h4]; simp

lemma Amat_U0 (hkm : k + 1 ≤ m) :
    Amat hkm (U0 k m) = Matrix.of fun (i j : Fin k) => (1 + if i.val = j.val then 1 else 0 : ℝ) := by
  refine Matrix.ext fun i j => ?_
  simp [Amat, U0, colk]

lemma good_U0 (hkm : k + 1 ≤ m) (hk : 1 ≤ k) : Good hkm (U0 k m) := by
  have hdet : (Amat hkm (U0 k m)).det ≠ 0 := by rw [Amat_U0]; exact det_J_ne k
  refine ⟨hdet, ?_, ?_⟩
  · intro i α
    simp only [U0, Matrix.of_apply, (Fin.castSucc_lt_last i), Fin.coe_castSucc, i.2, if_true]
    positivity
  · have hc : (fun j => U0 k m (Fin.last k) (colk hkm j)) = (fun _ => (1 : ℝ)) ᵥ* Amat hkm (U0 k m) := by
      funext j
      simp [U0, colk, Amat, Matrix.vecMul, dotProduct, Fin.val_inj]
    have hl : lam hkm (U0 k m) = fun _ => 1 := by
      unfold lam
      rw [hc, Matrix.vecMul_vecMul, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hdet),
        Matrix.vecMul_one]
    intro i
    rw [hl]; exact one_pos

lemma good_nbhd (hkm : k + 1 ≤ m) (hk : 1 ≤ k) :
    ∃ ρ > 0, ∀ x : Fin (k + 1) × Fin m → ℝ, (∀ p, |x p - U0 k m p.1 p.2| < ρ) →
      Good hkm (Matrix.of fun i α => x (i, α)) := by
  set x0 : Fin (k + 1) × Fin m → ℝ := fun p => U0 k m p.1 p.2 with hx0
  let M : (Fin (k + 1) × Fin m → ℝ) → Mat k m := fun x => Matrix.of fun i α => x (i, α)
  have hMx0 : M x0 = U0 k m := Matrix.ext fun i α => rfl
  have hg0 := good_U0 hkm hk
  have hA : Continuous fun x => Amat hkm (M x) :=
    continuous_matrix (fun i j => continuous_apply (Fin.castSucc i, colk hkm j))
  have hdet : Continuous fun x => (Amat hkm (M x)).det := hA.matrix_det
  have hne : (Amat hkm (M x0)).det ≠ 0 := by rw [hMx0]; exact hg0.1
  have ev1 : ∀ᶠ x in nhds x0, (Amat hkm (M x)).det ≠ 0 :=
    hdet.continuousAt.eventually_ne hne
  have ev2 : ∀ᶠ x in nhds x0, ∀ i : Fin k, ∀ α, 0 < M x (Fin.castSucc i) α := by
    rw [Filter.eventually_all]
    intro i
    rw [Filter.eventually_all]
    intro α
    have h0 : 0 < x0 (Fin.castSucc i, α) := by
      have := hg0.2.1 i α
      rwa [← hMx0] at this
    exact (continuous_apply (Fin.castSucc i, α)).continuousAt.eventually (lt_mem_nhds h0)
  have hinv : ∀ j i, ContinuousAt (fun x => (Amat hkm (M x))⁻¹ j i) x0 := by
    intro j i
    have : (fun x => (Amat hkm (M x))⁻¹ j i)
        = fun x => (Amat hkm (M x)).det⁻¹ * (Amat hkm (M x)).adjugate j i := by
      funext x
      simp [Matrix.inv_def, Ring.inverse_eq_inv']
    rw [this]
    exact (hdet.continuousAt.inv₀ hne).mul
      (((continuous_apply i).comp ((continuous_apply j).comp hA.matrix_adjugate)).continuousAt)
  have ev3 : ∀ᶠ x in nhds x0, ∀ i, 0 < lam hkm (M x) i := by
    rw [Filter.eventually_all]
    intro i
    have hc : ContinuousAt (fun x => lam hkm (M x) i) x0 := by
      unfold lam
      simp only [Matrix.vecMul, dotProduct]
      exact tendsto_finset_sum _ (fun j _ =>
        (((continuous_apply (Fin.last k, colk hkm j)).continuousAt).mul (hinv j i)))
    have h0 : 0 < lam hkm (M x0) i := by rw [hMx0]; exact hg0.2.2 i
    exact hc.eventually (lt_mem_nhds h0)
  have hev : ∀ᶠ x in nhds x0, Good hkm (M x) := by
    filter_upwards [ev1, ev2, ev3] with x h1 h2 h3 using ⟨h1, h2, h3⟩
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hev
  refine ⟨ε, hε, fun x hx => hball ?_⟩
  rw [dist_pi_lt_iff hε]
  intro p
  simpa [Real.dist_eq] using hx p

lemma killQ_eq_zero (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (P : PolyRing (k + 1) m)
    (h : ∀ U : Mat k m, Good hkm U → polyFun P (fillU U 0) = 0) :
    GoalA.killQ (Qs k m) P = 0 := by
  obtain ⟨ρ, hρ, hgood⟩ := good_nbhd hkm hk
  refine MvPolynomial.funext_set (s := fun v => Set.Ioo (U0 k m v.1 v.2 - ρ) (U0 k m v.1 v.2 + ρ))
    (fun v => Set.Ioo_infinite (by linarith)) ?_
  intro x hx
  have hx' : ∀ p, |x p - U0 k m p.1 p.2| < ρ := by
    intro p
    have := hx p (Set.mem_univ p)
    rw [abs_lt]
    constructor <;> linarith [this.1, this.2]
  have := h _ (hgood x hx')
  rw [map_zero, GoalA.eval_killQ]
  refine (congrArg (fun f => eval f P) ?_).trans this
  funext v
  rcases v with ⟨i, α⟩
  simp [fillU, mem_Qs]

theorem core (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (H H' : PolyRing (k + 1) m) (N : ℕ)
    (hN : Even N) (hH' : theta hkm H' = delta hkm ^ N * H)
    (hpos : ∀ V : Mat k m, (∀ i α, 0 < V i α) → 0 ≤ polyFun H V)
    (hzero : ∀ V : Mat k m, (∀ i α, 0 < V i α) →
      (∃ c : Fin k → ℝ, (∀ i, 0 ≤ c i) ∧
        ∀ α, V (Fin.last k) α = ∑ i : Fin k, c i * V (Fin.castSucc i) α) → polyFun H V = 0) :
    H' ∈ GoalA.Jid (Qs k m) ^ 2 := by
  refine GoalA.taylor _ _ ?_ ?_
  · exact killQ_eq_zero hkm hk _ (fun U hg =>
      (core_point hkm hk H H' N hN hH' hpos hzero U hg ⟨k, by omega⟩ le_rfl).1)
  · intro v hv
    have hv' := mem_Qs.1 hv
    refine killQ_eq_zero hkm hk _ (fun U hg => ?_)
    have := (core_point hkm hk H H' N hN hH' hpos hzero U hg v.2 hv'.2).2
    rwa [← hv'.1] at this

theorem schur_main (hkm : k + 1 ≤ m) (hk : 1 ≤ k) (H : PolyRing (k + 1) m)
    (hpos : ∀ V : Mat k m, (∀ i α, 0 < V i α) → 0 ≤ polyFun H V)
    (hzero : ∀ V : Mat k m, (∀ i α, 0 < V i α) →
      (∃ c : Fin k → ℝ, (∀ i, 0 ≤ c i) ∧
        ∀ α, V (Fin.last k) α = ∑ i : Fin k, c i * V (Fin.castSucc i) α) → polyFun H V = 0) :
    ∃ N : ℕ, delta hkm ^ N * H ∈ maxMinorIdeal (k + 1) m ^ 2 := by
  obtain ⟨e, he⟩ := exists_pow_delta_mem_range hkm H
  have hd : delta hkm ∈ (theta hkm).range := ⟨delta hkm, theta_delta hkm⟩
  have he' : delta hkm ^ (e + e) * H ∈ (theta hkm).range := by
    have : delta hkm ^ (e + e) * H = delta hkm ^ e * (delta hkm ^ e * H) := by ring
    rw [this]
    exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hd _) he
  obtain ⟨H', hH'⟩ := he'
  refine ⟨e + e, ?_⟩
  rw [← hH']
  exact theta_mem_pow hkm H' (core hkm hk H H' (e + e) ⟨e, rfl⟩ hH' hpos hzero)

end FiniteSampleDependence.Dev.GoalS
end

section
set_option autoImplicit false

namespace FiniteSampleDependence.Dev.GoalH

open FiniteSampleDependence.Rigidity MvPolynomial Matrix
open scoped Classical

lemma eval_smul_homog {σ : Type*} (φ : MvPolynomial σ ℝ) {d : ℕ} (hφ : φ.IsHomogeneous d)
    (c : ℝ) (x : σ → ℝ) : eval (c • x) φ = c ^ d * eval x φ := by
  rw [eval_eq, eval_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun m hm => ?_)
  have hd := hφ (mem_support_iff.1 hm)
  simp only [Finsupp.weight_apply, Pi.one_apply, smul_eq_mul, mul_one] at hd
  simp only [Pi.smul_apply, smul_eq_mul, mul_pow, Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum]
  rw [Finsupp.sum] at hd
  rw [hd]; ring

lemma contDiff_eval {n m : ℕ} (P : PolyRing n m) :
    ContDiff ℝ 1 (fun f : Ambient n m => eval (fun p : Fin n × Fin m => f p.1 p.2) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simpa using contDiff_const
  | add p q hp hq => simpa using hp.add hq
  | mul_X p v hp =>
    simp only [map_mul, eval_X]
    exact hp.mul ((contDiff_apply ℝ ℝ v.2).comp (contDiff_apply ℝ (Fin m → ℝ) v.1))

lemma isC1Extendable_polyFun {n m : ℕ} (P : PolyRing n m) : IsC1Extendable (polyFun P) :=
  ⟨Set.univ, fun f => eval (fun p : Fin n × Fin m => f p.1 p.2) P, isOpen_univ,
    fun _ _ => trivial, (contDiff_eval P).contDiffOn, fun U _ => rfl⟩

/-! Homogenization -/

noncomputable def homog {n m : ℕ} (P : PolyRing n m) : PolyRing n m :=
  ∑ j ∈ Finset.range (P.totalDegree + 1),
    tauPoly n m ^ (P.totalDegree - j) * homogeneousComponent j P

lemma tauPoly_homog (n m : ℕ) : (tauPoly n m).IsHomogeneous 1 := by
  unfold tauPoly
  refine IsHomogeneous.sum _ _ _ (fun i _ => IsHomogeneous.sum _ _ _ (fun α _ => ?_))
  exact isHomogeneous_X _ _

lemma homog_isHomogeneous {n m : ℕ} (P : PolyRing n m) :
    (homog P).IsHomogeneous P.totalDegree := by
  unfold homog
  refine IsHomogeneous.sum _ _ _ (fun j hj => ?_)
  have hj' : j ≤ P.totalDegree := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
  have := ((tauPoly_homog n m).pow (P.totalDegree - j)).mul (homogeneousComponent_isHomogeneous j P)
  rwa [one_mul, Nat.sub_add_cancel hj'] at this

lemma homog_sub_mem {n m : ℕ} (P : PolyRing n m) : homog P - P ∈ simplexIdeal n m := by
  unfold simplexIdeal
  rw [← Ideal.Quotient.eq]
  have hτ : Ideal.Quotient.mk (Ideal.span {tauPoly n m - 1}) (tauPoly n m) = 1 := by
    rw [← map_one (Ideal.Quotient.mk (Ideal.span {tauPoly n m - 1})), Ideal.Quotient.eq]
    exact Ideal.subset_span rfl
  conv_rhs => rw [← sum_homogeneousComponent P]
  unfold homog
  simp only [map_sum, map_mul, map_pow, hτ, one_pow, one_mul]

lemma smul_mem_simplex {n m : ℕ} (V : Matrix (Fin n) (Fin m) ℝ) (h0 : ∀ i α, 0 ≤ V i α)
    (hτ : 0 < tau V) : (tau V)⁻¹ • V ∈ simplex n m := by
  refine ⟨fun i α => ?_, ?_⟩
  · simp only [Matrix.smul_apply, smul_eq_mul]
    exact mul_nonneg (inv_nonneg.2 hτ.le) (h0 i α)
  · unfold tau
    simp only [Matrix.smul_apply, smul_eq_mul, ← Finset.mul_sum]
    have : (∑ i, ∑ α, V i α) = tau V := rfl
    rw [this]
    exact inv_mul_cancel₀ hτ.ne'

lemma polyFun_homog {n m : ℕ} (P : PolyRing n m) (U : Matrix (Fin n) (Fin m) ℝ)
    (hτ : 0 < tau U) :
    polyFun (homog P) U = (tau U) ^ P.totalDegree * polyFun P ((tau U)⁻¹ • U) := by
  set s := tau U with hs
  have hU : (fun p : Fin n × Fin m => U p.1 p.2) = s • (fun p : Fin n × Fin m => ((s)⁻¹ • U) p.1 p.2) := by
    funext p
    simp [Matrix.smul_apply, hτ.ne']
  have hcomp : ∀ j, polyFun (homogeneousComponent j P) U
      = s ^ j * polyFun (homogeneousComponent j P) (s⁻¹ • U) := by
    intro j
    unfold polyFun
    rw [hU]
    exact eval_smul_homog _ (homogeneousComponent_isHomogeneous j P) _ _
  unfold homog
  rw [show polyFun (∑ j ∈ Finset.range (P.totalDegree + 1),
      tauPoly n m ^ (P.totalDegree - j) * homogeneousComponent j P) U
      = ∑ j ∈ Finset.range (P.totalDegree + 1),
        (polyFun (tauPoly n m) U) ^ (P.totalDegree - j) * polyFun (homogeneousComponent j P) U by
    simp [polyFun]]
  rw [polyFun_tauPoly]
  have hsum : polyFun P (s⁻¹ • U) = ∑ j ∈ Finset.range (P.totalDegree + 1),
      polyFun (homogeneousComponent j P) (s⁻¹ • U) := by
    conv_lhs => rw [← sum_homogeneousComponent P]
    simp [polyFun]
  rw [hsum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  have hj' : j ≤ P.totalDegree := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
  rw [hcomp j, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hj']

/-! Degree lower bound -/

lemma maxMinor_homog {n m : ℕ} (s : Fin n → Fin m) : (maxMinor s).IsHomogeneous n := by
  unfold maxMinor
  rw [Matrix.det_apply]
  have : n = ∑ _i : Fin n, 1 := by simp
  conv_rhs => rw [this]
  refine IsHomogeneous.sum _ _ _ (fun σ _ => ?_)
  have h : ∀ i : Fin n, (((genericMatrix n m).submatrix id s) (σ i) i).IsHomogeneous 1 := by
    intro i
    simp only [Matrix.submatrix_apply, genericMatrix, Matrix.mvPolynomialX_apply, id]
    exact isHomogeneous_X _ _
  have hp := IsHomogeneous.prod Finset.univ
    (fun i : Fin n => ((genericMatrix n m).submatrix id s) (σ i) i) (fun _ => 1) (fun i _ => h i)
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one] at hp
  rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h1 | h1
  · rw [h1]; simpa using hp
  · rw [h1]; simpa using hp.neg

lemma hc_mul_zero {n m : ℕ} (a g : PolyRing n m) {e : ℕ} (hg : g.IsHomogeneous e) {d : ℕ}
    (hd : d < e) : homogeneousComponent d (a * g) = 0 := by
  conv_lhs => rw [← sum_homogeneousComponent a]
  rw [Finset.sum_mul, map_sum]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  have hh : (homogeneousComponent i a * g) ∈ homogeneousSubmodule (Fin n × Fin m) ℝ (i + e) :=
    (homogeneousComponent_isHomogeneous i a).mul hg
  rw [homogeneousComponent_of_mem hh, if_neg (by omega)]

lemma deg_lower {n m : ℕ} (φ : PolyRing n m) (hφ : φ ∈ maxMinorIdeal n m ^ 2) {κ : ℕ}
    (hh : φ.IsHomogeneous κ) (h0 : φ ≠ 0) : 2 * n ≤ κ := by
  by_contra hlt
  push_neg at hlt
  have h1 : homogeneousComponent κ φ = φ := by
    rw [homogeneousComponent_of_mem (by exact hh), if_pos rfl]
  apply h0
  rw [← h1]
  unfold maxMinorIdeal at hφ
  rw [pow_two, Ideal.span_mul_span] at hφ
  obtain ⟨nn, f, g, hfg⟩ := Submodule.mem_span_set'.1 hφ
  rw [← hfg, map_sum]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  obtain ⟨a, ha, b, hb, hab⟩ := (g i).2
  obtain ⟨s1, -, rfl⟩ := ha
  obtain ⟨s2, -, rfl⟩ := hb
  have hg : (g i : PolyRing n m).IsHomogeneous (n + n) := by
    rw [← hab]; exact (maxMinor_homog s1).mul (maxMinor_homog s2)
  simp only [smul_eq_mul]
  exact hc_mul_zero _ _ (by rw [show 2 * n = n + n by ring] at hlt; exact hg) (by omega)

/-! `δ ∉ I_n` -/

lemma delta_not_mem {k m : ℕ} (hkm : k + 1 ≤ m) :
    GoalB.delta hkm ∉ maxMinorIdeal (k + 1) m := by
  let U1 : Matrix (Fin (k + 1)) (Fin m) ℝ :=
    Matrix.of fun i α => if i.val = α.val ∧ i.val < k then 1 else 0
  have hI : maxMinorIdeal (k + 1) m ≤ RingHom.ker (eval (fun p : Fin (k + 1) × Fin m => U1 p.1 p.2)) := by
    refine Ideal.span_le.2 ?_
    rintro _ ⟨s, -, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    have := GoalS.polyFun_submatrix_det (m := m) (p := Fin (k + 1)) id s U1
    refine this.trans ?_
    refine Matrix.det_eq_zero_of_row_eq_zero (Fin.last k) (fun j => ?_)
    simp [U1]
  intro hmem
  have h0 := hI hmem
  rw [RingHom.mem_ker] at h0
  have h1 : (eval (fun p : Fin (k + 1) × Fin m => U1 p.1 p.2)) (GoalB.delta hkm) = 1 := by
    have := GoalS.polyFun_delta hkm U1
    refine this.trans ?_
    have : U1.submatrix Fin.castSucc (GoalB.colk hkm) = 1 := by
      refine Matrix.ext fun i j => ?_
      simp [U1, GoalB.colk, Matrix.one_apply, Fin.val_inj]
    rw [this]; exact Matrix.det_one
  rw [h1] at h0
  exact one_ne_zero h0

end FiniteSampleDependence.Dev.GoalH
