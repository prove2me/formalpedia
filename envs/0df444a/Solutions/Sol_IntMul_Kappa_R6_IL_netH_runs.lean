section
-- Source module: Solutions.KIL5Net
/-!
# KIL5: the network of one level with run-time stream length

KIL3Net's `frames_runs`, `gateC_runs`, `netC_runs` re-proved for the register-count table code
(`applyCU`, `rebuildCU`, KIL5Tab).  The stream codes only have to be correct on states satisfying
the invariant `Inv G0` (the protected stacks `≥ 22`, `≠ 44`, hold `G0`): the network keeps these
stacks fixed, so a code that reads the level registers / the descriptor (e.g. a child call) may
rely on them.

Cost: every frame change costs `cE X + cCU (W·v) Bb`, every gate `cRebuildU W (W·v) Bb + 1`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

section Net

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W v : ℕ} {M : Type*} [AddGroup M]

variable (E : M → IStmt HS Pp)

variable (cE : M → ℕ)

variable {E cE}

theorem prot_upd0 {f : Fin HS → List ℤ} (hfp : ∀ r, Prot r → f r = []) (l : List ℤ) :
    ∀ r, Prot r → Function.update f 0 l r = [] := fun r hr => by
  have : r ≠ 0 := fun e => by subst e; exact not_prot (by decide) hr
  simp [this, hfp r hr]

