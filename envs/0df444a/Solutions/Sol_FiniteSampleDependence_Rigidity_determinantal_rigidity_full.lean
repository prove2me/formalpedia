namespace FiniteSampleDependence.Dev.GoalB

open FiniteSampleDependence.Rigidity MvPolynomial Matrix
open scoped Classical

variable {k m : ℕ}

/-- First `k` columns. -/
def colk (hkm : k + 1 ≤ m) (j : Fin k) : Fin m := ⟨j.val, by omega⟩

/-- Column set `{0..k-1} ∪ {α}` listed in order (increasing when `k ≤ α`). -/
def sα (hkm : k + 1 ≤ m) (α : Fin m) : Fin (k + 1) → Fin m :=
  fun j => if h : j.val < k then ⟨j.val, by omega⟩ else α

noncomputable def delta (hkm : k + 1 ≤ m) : PolyRing (k + 1) m :=
  ((genericMatrix (k + 1) m).submatrix Fin.castSucc (colk hkm)).det

noncomputable def mu (hkm : k + 1 ≤ m) (α : Fin m) : PolyRing (k + 1) m :=
  ((genericMatrix (k + 1) m).submatrix id (sα hkm α)).det

noncomputable def W (hkm : k + 1 ≤ m) (α : Fin m) : PolyRing (k + 1) m :=
  ∑ j : Fin k, (-1) ^ (k + j.val) * X (Fin.last k, colk hkm j) *
    (((genericMatrix (k + 1) m).submatrix id (sα hkm α)).submatrix (Fin.last k).succAbove
      (Fin.castSucc j).succAbove).det

def Qs (k m : ℕ) : Finset (Fin (k + 1) × Fin m) :=
  Finset.univ.filter (fun v => v.1 = Fin.last k ∧ k ≤ v.2.val)

noncomputable def theta (hkm : k + 1 ≤ m) : PolyRing (k + 1) m →ₐ[ℝ] PolyRing (k + 1) m :=
  aeval (fun v => if v ∈ Qs k m then mu hkm v.2 else X v)

lemma mu_eq (hkm : k + 1 ≤ m) (α : Fin m) :
    mu hkm α = delta hkm * X (Fin.last k, α) + W hkm α := by
  have h1 : ((genericMatrix (k + 1) m).submatrix id (sα hkm α)).submatrix (Fin.last k).succAbove
        (Fin.last k).succAbove = (genericMatrix (k + 1) m).submatrix Fin.castSucc (colk hkm) := by
    ext i j
    simp [sα, colk, Fin.succAbove_last]
  unfold mu W delta
  rw [Matrix.det_succ_row _ (Fin.last k), Fin.sum_univ_castSucc]
  refine (add_comm _ _).trans ?_
  refine congrArg₂ (· + ·) ?_ ?_
  · simp only [h1]
    simp [sα]
    ring
  · refine Finset.sum_congr rfl (fun j _ => ?_)
    simp [sα, colk]

lemma theta_X_of_not_mem (hkm : k + 1 ≤ m) {v : Fin (k + 1) × Fin m} (hv : v ∉ Qs k m) :
    theta hkm (X v) = X v := by
  simp [theta, hv]

lemma theta_X_of_mem (hkm : k + 1 ≤ m) {v : Fin (k + 1) × Fin m} (hv : v ∈ Qs k m) :
    theta hkm (X v) = mu hkm v.2 := by
  simp [theta, hv]

lemma mem_Qs {v : Fin (k + 1) × Fin m} : v ∈ Qs k m ↔ v.1 = Fin.last k ∧ k ≤ v.2.val := by
  simp [Qs]

lemma theta_det_fix (hkm : k + 1 ≤ m) {p : Type} [Fintype p] [DecidableEq p]
    (r : p → Fin (k + 1)) (c : p → Fin m) (hr : ∀ i, r i ≠ Fin.last k) :
    theta hkm (((genericMatrix (k + 1) m).submatrix r c).det)
      = ((genericMatrix (k + 1) m).submatrix r c).det := by
  rw [AlgHom.map_det]
  congr 1
  refine Matrix.ext fun i j => ?_
  simp only [AlgHom.mapMatrix_apply, Matrix.map_apply, Matrix.submatrix_apply,
    genericMatrix, Matrix.mvPolynomialX_apply]
  exact theta_X_of_not_mem hkm (fun h => hr i (mem_Qs (v := (r i, c j)) |>.1 h).1)

lemma theta_delta (hkm : k + 1 ≤ m) : theta hkm (delta hkm) = delta hkm :=
  theta_det_fix hkm _ _ (fun i => Fin.castSucc_lt_last i |>.ne)

lemma theta_W (hkm : k + 1 ≤ m) (α : Fin m) : theta hkm (W hkm α) = W hkm α := by
  unfold W
  rw [map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_mul, map_mul, map_pow, map_neg, map_one,
    theta_X_of_not_mem hkm (v := (Fin.last k, colk hkm j))
      (fun h => by have := (mem_Qs.1 h).2; simp [colk] at this; omega)]
  congr 1
  rw [Matrix.submatrix_submatrix]
  exact theta_det_fix hkm _ _ (fun i => Fin.succAbove_ne _ i)

lemma sα_strictMono (hkm : k + 1 ≤ m) (α : Fin m) (hα : k ≤ α.val) : StrictMono (sα hkm α) := by
  intro i j hij
  have hi := i.2
  have hj := j.2
  have hij' : i.val < j.val := hij
  by_cases hjk : j.val < k
  · have hik : i.val < k := by omega
    simp [sα, hjk, hik, Fin.lt_def, hij']
  · by_cases hik : i.val < k
    · simp [sα, hjk, hik, Fin.lt_def]
      omega
    · omega

lemma mu_mem (hkm : k + 1 ≤ m) (α : Fin m) (hα : k ≤ α.val) :
    mu hkm α ∈ maxMinorIdeal (k + 1) m :=
  Ideal.subset_span ⟨sα hkm α, sα_strictMono hkm α hα, rfl⟩

lemma delta_X_mem_range (hkm : k + 1 ≤ m) {v : Fin (k + 1) × Fin m} (hv : v ∈ Qs k m) :
    delta hkm * X v ∈ (theta hkm).range := by
  have h1 : delta hkm * X v = theta hkm (X v) - W hkm v.2 := by
    rw [theta_X_of_mem hkm hv, mu_eq hkm v.2]
    have : (Fin.last k, v.2) = v := Prod.ext ((mem_Qs.1 hv).1).symm rfl
    rw [this]; ring
  rw [h1]
  exact Subalgebra.sub_mem _ ⟨X v, rfl⟩ ⟨W hkm v.2, theta_W hkm v.2⟩

lemma exists_pow_delta_mem_range (hkm : k + 1 ≤ m) (H : PolyRing (k + 1) m) :
    ∃ e : ℕ, delta hkm ^ e * H ∈ (theta hkm).range := by
  have hd : delta hkm ∈ (theta hkm).range := ⟨delta hkm, theta_delta hkm⟩
  induction H using MvPolynomial.induction_on with
  | C a => exact ⟨0, by simpa using (theta hkm).range.algebraMap_mem a⟩
  | add p q hp hq =>
    obtain ⟨e1, h1⟩ := hp
    obtain ⟨e2, h2⟩ := hq
    refine ⟨e1 + e2, ?_⟩
    have : delta hkm ^ (e1 + e2) * (p + q) = delta hkm ^ e2 * (delta hkm ^ e1 * p)
        + delta hkm ^ e1 * (delta hkm ^ e2 * q) := by ring
    rw [this]
    exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hd _) h1)
      (Subalgebra.mul_mem _ (Subalgebra.pow_mem _ hd _) h2)
  | mul_X p u hp =>
    obtain ⟨e, h⟩ := hp
    by_cases hu : u ∈ Qs k m
    · refine ⟨e + 1, ?_⟩
      have : delta hkm ^ (e + 1) * (p * X u) = (delta hkm ^ e * p) * (delta hkm * X u) := by ring
      rw [this]
      exact Subalgebra.mul_mem _ h (delta_X_mem_range hkm hu)
    · refine ⟨e, ?_⟩
      have : delta hkm ^ e * (p * X u) = (delta hkm ^ e * p) * X u := by ring
      rw [this]
      exact Subalgebra.mul_mem _ h ⟨X u, theta_X_of_not_mem hkm hu⟩

lemma theta_mem_pow (hkm : k + 1 ≤ m) (P : PolyRing (k + 1) m)
    (hP : P ∈ GoalA.Jid (Qs k m) ^ 2) : theta hkm P ∈ maxMinorIdeal (k + 1) m ^ 2 := by
  have hJ : GoalA.Jid (Qs k m) ≤ Ideal.comap (theta hkm).toRingHom (maxMinorIdeal (k + 1) m) := by
    refine Ideal.span_le.2 ?_
    rintro _ ⟨v, hv, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    change theta hkm (X v) ∈ _
    rw [theta_X_of_mem hkm (by simpa using hv)]
    exact mu_mem hkm _ (mem_Qs.1 (by simpa using hv)).2
  rw [pow_two] at hP ⊢
  have : GoalA.Jid (Qs k m) * GoalA.Jid (Qs k m) ≤
      Ideal.comap (theta hkm).toRingHom (maxMinorIdeal (k + 1) m * maxMinorIdeal (k + 1) m) := by
    rw [Ideal.mul_le]
    intro r hr s hs
    rw [Ideal.mem_comap]
    change theta hkm (r * s) ∈ _
    rw [map_mul]
    exact Ideal.mul_mem_mul (hJ hr) (hJ hs)
  exact this hP

end FiniteSampleDependence.Dev.GoalB
end

