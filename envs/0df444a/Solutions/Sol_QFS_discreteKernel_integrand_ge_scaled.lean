open QFS

variable {d : ℕ}

/-- **The pointwise estimate of Proposition 3.5**, at scale `h`. -/
theorem solution
    {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))} {α Λ : ℝ}
    {k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞}
    (hk : QFS.KernelBounds Γ α Λ k) (hα : 0 < α) {θ : ℝ} (F : QFS.RefFamily Γ θ) {h : ℝ}
    (hh : 0 < h) {x y : EuclideanSpace ℝ (Fin d)} (hx : x ∈ QFS.scaledLattice d h)
    (hy : y ∈ QFS.scaledLattice d h) (hxy : Real.sqrt d * h < ‖x - y‖)
    {m n s t : EuclideanSpace ℝ (Fin d)} (hs : s ∈ QFS.cubeCone Γ (F.cone m) h x)
    (ht : t ∈ QFS.cubeCone Γ (F.cone n) h y) :
    ENNReal.ofReal Λ⁻¹ *
        ((QFS.indE (F.shrunkAt m (h * Real.sqrt d) x) y
          + QFS.indE (F.shrunkAt n (h * Real.sqrt d) y) x)
          * ENNReal.ofReal ((2 * Real.sqrt d) ^ (-(d:ℝ) - α) * ‖x - y‖ ^ (-(d:ℝ) - α)))
      ≤ k s t := by
  have hd : 0 < d := by
    rcases Nat.eq_zero_or_pos d with rfl | hd
    · exfalso
      have h0 : ‖x - y‖ = 0 := by simp [EuclideanSpace.norm_eq]
      rw [h0] at hxy
      simp at hxy
    · exact hd
  have hsd : (0:ℝ) < Real.sqrt d := Real.sqrt_pos.mpr (by exact_mod_cast hd)
  have hxy0 : (0:ℝ) < ‖x - y‖ := lt_trans (by positivity) hxy
  have hexp : (-(d:ℝ) - α) ≤ 0 := by
    have : (0:ℝ) ≤ (d:ℝ) := Nat.cast_nonneg d
    linarith
  have hs1 : s ∈ QFS.cube h x := hs.1
  have ht1 : t ∈ QFS.cube h y := ht.1
  have hbr1 : QFS.indE (QFS.shift (QFS.shrink (F.cone m) (h / 2 * Real.sqrt d)) x) t
      ≤ QFS.indE (QFS.coneAt Γ s) t := by
    refine QFS.indE_le_indE (fun hmem => ?_)
    rw [QFS.mem_coneAt]
    exact hs.2 ((QFS.cone_in_intersection (F.cone m) hh.le x hs1).2 hmem)
  have hbr2 : QFS.indE (QFS.shift (QFS.shrink (F.cone n) (h / 2 * Real.sqrt d)) y) s
      ≤ QFS.indE (QFS.coneAt Γ t) s := by
    refine QFS.indE_le_indE (fun hmem => ?_)
    rw [QFS.mem_coneAt]
    exact ht.2 ((QFS.cone_in_intersection (F.cone n) hh.le y ht1).2 hmem)
  have hker : ENNReal.ofReal ((2 * Real.sqrt d) ^ (-(d:ℝ) - α) * ‖x - y‖ ^ (-(d:ℝ) - α))
      ≤ QFS.jumpKernel d α s t := by
    obtain ⟨hlow, hup⟩ := QFS.lemma_cubes hh hx hy hxy hs1 ht1
    have hst0 : (0:ℝ) < ‖s - t‖ := lt_trans (by positivity) hlow
    have h1 : ‖s - t‖ ^ (-(d:ℝ) - α) ≥ (2 * Real.sqrt d * ‖x - y‖) ^ (-(d:ℝ) - α) :=
      Real.rpow_le_rpow_of_nonpos hst0 hup.le hexp
    have h2 : (2 * Real.sqrt d * ‖x - y‖) ^ (-(d:ℝ) - α)
        = (2 * Real.sqrt d) ^ (-(d:ℝ) - α) * ‖x - y‖ ^ (-(d:ℝ) - α) :=
      Real.mul_rpow (by positivity) (norm_nonneg _)
    rw [QFS.jumpKernel]
    refine ENNReal.ofReal_le_ofReal ?_
    linarith [h1, h2.le, h2.ge]
  refine le_trans (mul_le_mul' le_rfl (mul_le_mul' ?_ hker)) (hk.lower s t)
  exact le_trans (QFS.lemma_min_dist_E_scaled hs1 ht1) (add_le_add hbr1 hbr2)
