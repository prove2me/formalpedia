-- title:
--   Peterfalvi (13.18.b): $U\rtimes W_1$ is a complement of $P$ in $S$
-- statement:
--   Let $G$ be a finite group and `hyp : Hypothesis (G := G)` the Peterfalvi Section 13 hypothesis package, with subgroups $P,U,W_1,S\le G$. Then, inside the group $S$, the subgroup generated by $U$ and $W_1$ is a complement of $P$:
--   $$\texttt{IsComplement'}\ \big((U\sqcup W_1)\text{ in } S\big)\ \big(P\text{ in }S\big),$$
--   i.e. each element of $S$ factors uniquely as an element of $U\sqcup W_1$ times an element of $P$.
--
--   It is the structural bridge for Peterfalvi (13.18.b), giving the Frobenius quotient $S/P\cong U\rtimes W_1$.
--
--   **Formalization Note.** Subgroups of $G$ contained in $S$ are viewed as subgroups of $\uparrow S$ using `Subgroup.subgroupOf`.
-- source:
--   Yawara Ishida, Lean 4 formalization of the Feit–Thompson (odd order) theorem, github.com/yawara/odd-order @ 20a6fccbb63c (Apache-2.0), https://github.com/yawara/odd-order/blob/20a6fccbb63c0b138acda9f7fafd798c42f9441b/OddOrder/Peterfalvi/S15_BridgeCharacterBasic.lean#L88-L158

import Definitions.Def_OddOrder_Peterfalvi_S15_SAndTDefs
import Definitions.Def_OddOrder_Peterfalvi_S15_BridgeCharacterBasic

namespace OddOrder.Peterfalvi.S15

open OddOrder.GroupTheory

open OddOrder.RepresentationTheory

open OddOrder.Isaacs

open scoped Pointwise

variable {G : Type*} [Group G]

theorem uW1_isComplement_P [Finite G] (hyp : Hypothesis (G := G)) :
    Subgroup.IsComplement' ((hyp.U ⊔ hyp.W1).subgroupOf hyp.S) (hyp.P.subgroupOf hyp.S) := by sorry

end OddOrder.Peterfalvi.S15
