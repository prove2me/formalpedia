    rw [this]; ring

theorem getD_flatR {α : Type*} {W n : ℕ} {X : Fin W → List α} (hX : ∀ v, (X v).length = n)
    (d : α) (v : Fin W) {j : ℕ} (hj : j < n) : (flatR X).getD (v.val * n + j) d = (X v).getD j d := by
  induction W with
