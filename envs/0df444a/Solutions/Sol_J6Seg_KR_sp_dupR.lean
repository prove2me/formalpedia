theorem sp_dupR_sol_aux {X Y Z C R : Fin HS} (hXY : X ≠ Y) (hXZ : X ≠ Z) (hYZ : Y ≠ Z) (hXC : X ≠ C)
    (hYC : Y ≠ C) (hZC : Z ≠ C) (hRC : R ≠ C) (hRX : R ≠ X) (hRY : R ≠ Y) (hRZ : R ≠ Z)
    (hX5 : X.val < 56) (hY5 : Y.val < 56) (hZ5 : Z.val < 56) (hC5 : C.val < 56)
    (hR5 : R.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L lx lr : List ℤ)
    (hX : f X = L ++ lx) (hC : f C = []) (hR : f R = (L.length : ℤ) :: lr) (B : ℕ)
    (hL : Bnd B L) (hn : zsz (L.length : ℤ) ≤ B) :
    Sp (dupR X Y Z C R) (encK s f)
      (encK s (Function.update (Function.update (Function.update f X lx) Y (L.reverse ++ f Y)) Z
        (L.reverse ++ f Z))) (cMvP L.length B) := by
  set N := L.length with hN
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update f X
    (L.drop k ++ lx)) Y ((L.take k).reverse ++ f Y)) Z ((L.take k).reverse ++ f Z)
  have hF0 : F 0 = f := by
    funext j; simp only [F, Function.update_apply, List.drop_zero, List.take_zero, List.reverse_nil,
      List.nil_append]
    split_ifs with h1 h2 h3 <;> (try subst h1) <;> (try subst h2) <;> (try subst h3) <;> simp_all
  have hFN : F N = Function.update (Function.update (Function.update f X lx) Y (L.reverse ++ f Y)) Z
      (L.reverse ++ f Z) := by
    simp only [F, hN, List.drop_length, List.take_length, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by
    simp only [F, Function.update_apply, if_neg hXC.symm, if_neg hYC.symm, if_neg hZC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (.seq (.push Y (.reg X)) (.seq (.push Z (.reg X)) (.pop X)))
      (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (30000 * (B + 2)) := by
    intro k hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : L.take (k + 1) = L.take k ++ [L[k]] := (List.take_concat_get' L k hk).symm
    have hb := hL _ (List.getElem_mem hk)
    set G := Function.update (F k) C [(N : ℤ) - k] with hG
    have gX : G X = L[k] :: (L.drop (k + 1) ++ lx) := by
      simp only [hG, F, Function.update_apply, if_neg hXC, if_neg hXY, if_neg hXZ, if_true, hd,
        List.cons_append]
    have s1 := sp_pushR (s := s) G (i := Y) hY5 hX5 gX hb
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G Y (L[k] :: G Y) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have s2 := sp_pushR (s := s) G1 (i := Z) hZ5 hX5 (by rw [hG1, Function.update_apply, if_neg hXY, gX]) hb
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 Z (L[k] :: G1 Z) := ⟨_, rfl⟩
    rw [← hG2] at s2
    have s3 := sp_pop (s := s) G2 (i := X) hX5
      (by rw [hG2, Function.update_apply, if_neg hXZ, hG1, Function.update_apply, if_neg hXY, gX]) hb
    refine ((s1.seq (s2.seq s3)).congr ?_).mono (by omega)
    congr 1; funext j
    simp only [hG2, hG1, hG, F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hXC.symm, hYC.symm, hZC.symm]
    by_cases h2 : j = X
    · subst h2; simp [hXC, hXY, hXZ]
    by_cases h3 : j = Y
    · subst h3; simp only [hXY.symm, hYZ, hYC, if_false, if_true, ↓reduceIte, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    by_cases h4 : j = Z
    · subst h4; simp only [hXZ.symm, hYZ.symm, hZC, if_false, if_true, ↓reduceIte, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    · simp [h1, h2, h3, h4]
  have H := Sp.rep (C := C) (n := .reg R) (b := .seq (.push Y (.reg X)) (.seq (.push Z (.reg X))
    (.pop X))) (s := s) (F := F) (N := N) (B := B) (c := 30000 * (B + 2)) hC5 hFC
    (by simp [RS.writes, hXC.symm, hYC.symm, hZC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0, hFN] at H
  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

