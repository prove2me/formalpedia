-- title:
--   Split tori over $\mathbb Q$, rational representations, rational weight spaces, $\mathrm{Lie}(U)$, truncated exponential
-- statement:
--   Objects of Lemma 5, over a field $K\supseteq\mathbb Q$ (in the paper $K=\overline{\mathbb Q}$).
--
--   1. The truncated exponential $\exp X=\sum_{l<n}X^l/l!$ of an $n\times n$ matrix; for nilpotent $X$ it is the exponential.
--   2. A set $S\subseteq GL_\iota(K)$ is *defined over $\mathbb Q$* if its ideal of vanishing polynomials over $K$ is generated by polynomials with rational coefficients. A matrix is a *$\mathbb Q$-point* if all its entries are rational.
--   3. A map on $GL_\iota(K)$ is a *morphism defined over $\mathbb Q$* on $S$ if on $S$ its entries are polynomials with rational coefficients in the entries and $\det^{-1}$.
--   4. A *split torus defined over $\mathbb Q$* is a Zariski-closed connected subgroup, defined over $\mathbb Q$, that is diagonalized by one rational change of basis.
--   5. A *rational representation* of $T$ is a homomorphism $\rho:T\to GL_n(K)$ given by rational polynomials in the entries and $\det^{-1}$. It *decomposes into rational weight spaces* if $\mathbb Q^n=\bigoplus_kW_k$ with each $\rho(t)$ acting on $W_k\otimes K$ by a scalar $\psi_k(t)$.
--   6. $\mathrm{Lie}(U)=\log U=\{X \text{ nilpotent}:\exp(sX)\in U\ \forall s\in K\}$. The conjugation action of $T$ on it decomposes into rational weight spaces if there are independent $\mathbb Q$-subspaces $W_k$ of rational matrices whose $K$-span is $\mathrm{Lie}(U)$, with $tXt^{-1}=\psi_k(t)X$ on $W_k$.
--
--   **Formalization Note** In characteristic zero the Lie algebra of a unipotent group is $\log U$ (§2.3, p.7; §5 writes $\mathfrak u=\log U$). A connected subgroup of a diagonal group is a torus, and diagonalizability over $\mathbb Q$ is $\mathbb Q$-splitness.
-- source:
--   Zeng–Cao–Dai–Wang–Ding, Copyless Cost Register Automata and Algebraic Groups, STOC 2027 submission (manuscript sha256 434d3094df2665371c402d5b5291b3c7f3a27a0d79384e4a8ec3ca3a46a92543), Lemma 5, p.7 (PDF p.9); §2.3, p.7; display (6), p.12 (PDF p.14)

import Mathlib
import Definitions.Def_CopylessCRA_zariskiClosure
open Matrix

namespace CopylessCRA

/-- The truncated exponential `exp X = ∑_{l < n} X^l / l!` of an `n × n` matrix (`n = |ι|`). For a
nilpotent `X` this is the exponential (`X^n = 0`); §2.3, p.7 and display (6), p.12 (PDF p.14). -/
noncomputable def nexp {ι K : Type*} [Fintype ι] [DecidableEq ι] [Field K]
    (X : Matrix ι ι K) : Matrix ι ι K :=
  ∑ l ∈ Finset.range (Fintype.card ι), ((Nat.factorial l : K)⁻¹) • X ^ l

variable {ι K : Type*} [Fintype ι] [DecidableEq ι] [Field K] [Algebra ℚ K]

/-- A matrix over `K` with all entries rational (a `ℚ`-point). -/
def IsRationalPt (g : Matrix ι ι K) : Prop :=
  ∀ i j, g i j ∈ Set.range (algebraMap ℚ K)

/-- The ideal of polynomials with coefficients in `F` (`F = ℚ` or `F = K`) in the entries that vanish
on a set of invertible matrices over `K`. -/
noncomputable def vanishingIdealOver (F : Type*) [Field F] [Algebra F K] (S : Set (Matrix ι ι K)ˣ) :
    Ideal (MvPolynomial (ι × ι) F) :=
  ⨅ g ∈ S, RingHom.ker (MvPolynomial.eval₂Hom (algebraMap F K) (entries (g : Matrix ι ι K)))

/-- A set of invertible matrices over `K` is **defined over `ℚ`** (§2.3, p.6; Lemma 5, p.7): its
ideal of vanishing polynomials over `K` is generated by polynomials with rational coefficients.

**Formalization Note** Ideals are taken in the polynomial ring of the entries (closed sets are taken
relative to `GL`, see `zariskiClosure`); the published definition `…Renew46.P22.DefinedOver` has the
same form for `Fin n`. -/
def IsDefinedOverQ (S : Set (Matrix ι ι K)ˣ) : Prop :=
  vanishingIdealOver K S =
    Ideal.span ((MvPolynomial.map (algebraMap ℚ K)) '' (vanishingIdealOver ℚ S : Set _))

/-- The coordinates "entries and `det⁻¹`" of a matrix: `some (i, j) ↦ g i j`, `none ↦ (det g)⁻¹`. -/
noncomputable def entriesDetInv (g : Matrix ι ι K) : Option (ι × ι) → K
  | none => (g.det)⁻¹
  | some ij => g ij.1 ij.2

/-- A map `φ` from `GL_ι(K)` to `κ × κ` matrices is **a morphism defined over `ℚ` on `S`**: on `S` each
entry of `φ` is a polynomial with rational coefficients in the entries and `det⁻¹`. -/
def IsRegularQ {κ : Type*} (φ : (Matrix ι ι K)ˣ → Matrix κ κ K) (S : Set (Matrix ι ι K)ˣ) : Prop :=
  ∃ p : κ → κ → MvPolynomial (Option (ι × ι)) ℚ, ∀ g ∈ S, ∀ i j,
    φ g i j = MvPolynomial.eval₂ (algebraMap ℚ K) (entriesDetInv (g : Matrix ι ι K)) (p i j)

/-- A **split torus defined over `ℚ`** (Lemma 5, p.7, PDF p.9): a Zariski-closed, connected subgroup
of `GL_ι(K)`, defined over `ℚ`, that is diagonalized by one rational change of basis. -/
def IsSplitTorusQ (T : Subgroup (Matrix ι ι K)ˣ) : Prop :=
  IsZariskiClosed (T : Set (Matrix ι ι K)ˣ) ∧ IsZariskiConnected (T : Set (Matrix ι ι K)ˣ) ∧
  IsDefinedOverQ (T : Set (Matrix ι ι K)ˣ) ∧
  ∃ P : (Matrix ι ι ℚ)ˣ, ∀ t ∈ T,
    (castMat (K := K) (↑P⁻¹ : Matrix ι ι ℚ) * (t : Matrix ι ι K) *
      castMat (K := K) (↑P : Matrix ι ι ℚ)).IsDiag

/-- A **rational representation** of `T`: a homomorphism `ρ : T → GL_n(K)` given by polynomials with
rational coefficients in the entries and `det⁻¹`. -/
def IsRationalRep (T : Subgroup (Matrix ι ι K)ˣ) {n : ℕ} (ρ : T →* (Matrix (Fin n) (Fin n) K)ˣ) :
    Prop :=
  ∃ p : Fin n → Fin n → MvPolynomial (Option (ι × ι)) ℚ, ∀ t : T, ∀ i j,
    (ρ t : Matrix (Fin n) (Fin n) K) i j =
      MvPolynomial.eval₂ (algebraMap ℚ K) (entriesDetInv ((t : (Matrix ι ι K)ˣ) : Matrix ι ι K))
        (p i j)

/-- `ρ` **decomposes into rational weight spaces**: `ℚ^n` is the direct sum of `ℚ`-subspaces `W_k`
on each of which (after extending scalars to `K`) every `ρ(t)` acts by a scalar `ψ_k(t)`. -/
def HasRationalWeightDecomp (T : Subgroup (Matrix ι ι K)ˣ) {n : ℕ}
    (ρ : T →* (Matrix (Fin n) (Fin n) K)ˣ) : Prop :=
  ∃ (m : ℕ) (W : Fin m → Submodule ℚ (Fin n → ℚ)) (ψ : Fin m → T → K),
    DirectSum.IsInternal W ∧ ∀ k, ∀ v ∈ W k, ∀ t : T,
      (ρ t : Matrix (Fin n) (Fin n) K) *ᵥ (fun i => algebraMap ℚ K (v i)) =
        ψ k t • (fun i => algebraMap ℚ K (v i))

/-- `Lie(U)` for a unipotent group `U` in characteristic zero, as `log U`: the nilpotent `X` with
`exp(sX) ∈ U` for every scalar `s` (§2.3, p.7; §5, p.11 writes `𝔲 = log U`). -/
def lieAlg (U : Set (Matrix ι ι K)ˣ) : Set (Matrix ι ι K) :=
  {X | IsNilpotent X ∧ ∀ s : K, ∃ g ∈ U, (g : Matrix ι ι K) = nexp (s • X)}

/-- The conjugation action of `T` on `Lie(U)` **decomposes into rational weight spaces**: there are
`ℚ`-subspaces `W_k` of rational matrices, independent, whose extensions span `Lie(U)` over `K`, with
`t X t⁻¹ = ψ_k(t) X` for `X ∈ W_k`, `t ∈ T`. -/
def HasRationalLieWeightDecomp (T : Subgroup (Matrix ι ι K)ˣ) (U : Set (Matrix ι ι K)ˣ) : Prop :=
  ∃ (m : ℕ) (W : Fin m → Submodule ℚ (Matrix ι ι ℚ)) (ψ : Fin m → T → K),
    iSupIndep W ∧
    ((Submodule.span K (⋃ k, castMat (K := K) '' (W k : Set (Matrix ι ι ℚ))) : Set (Matrix ι ι K))
      = lieAlg U) ∧
    ∀ k, ∀ X ∈ W k, ∀ t : T,
      ((t : (Matrix ι ι K)ˣ) : Matrix ι ι K) * castMat X * ((t⁻¹ : (Matrix ι ι K)ˣ) : Matrix ι ι K)
        = ψ k t • castMat (K := K) X

end CopylessCRA


