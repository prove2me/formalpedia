open scoped NumberField
open Module

namespace D1Bound5



theorem _root_.solution (x : ℝ) (hx : 0 < x) (n : ℕ) :
    ordinaryLog10 x < n ↔ x < (10 : ℝ)^n := by
  constructor
  · intro hlog
    by_contra hbad
    have hh := ordinaryLog10_mono (by positivity : (0 : ℝ) < 10^n) (le_of_not_gt hbad)
    simp only [ordinaryLog10_pow,ordinaryLog10_ten,mul_one] at hh
    linarith only [hh,hlog]
  · intro hlt
    have hh := ordinaryLog10_strictMono hx hlt
    simpa only [ordinaryLog10_pow,ordinaryLog10_ten,mul_one] using hh







end D1Bound5
