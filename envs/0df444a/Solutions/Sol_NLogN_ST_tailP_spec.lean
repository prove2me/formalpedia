theorem rmPos_lt : ∀ (s : List ℕ) (j : ℕ → ℕ), (∀ i < s.length, j i < s.getD i 1) →
    rmPos s j < s.prod
  | [], _, _ => by simp [rmPos]
  | n :: ns, j, h => by
    simp only [rmPos, List.prod_cons]
    have h0 : j 0 < n := by simpa using h 0 (by simp)
    have h1 := rmPos_lt ns (fun i => j (i + 1)) (fun i hi => by simpa using h (i + 1) (by simp; omega))
    have : (j 0 + 1) * ns.prod ≤ n * ns.prod := Nat.mul_le_mul_right _ h0
    nlinarith

theorem map_range_mul {α : Type*} (n P : ℕ) (g : ℕ → α) :
    (List.range (n * P)).map g = (List.range n).flatMap (fun i => (List.range P).map (fun q => g (i * P + q))) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.succ_mul, List.range_add, List.map_append, ih, List.range_succ, List.flatMap_append]
    simp [List.map_map, Function.comp_def]

