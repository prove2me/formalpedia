  rw [← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0, getD_selOpF _ _ _ _ h1]
  conv_rhs => rw [hJ]
  rw [getD_flatR hn 0 v hjn, getD_selOpF _ _ _ _ hjn]
  conv_lhs => rw [hJ]
  rw [fbit_block ha]
  refine Finset.sum_congr rfl fun y _ => ?_
  rw [fset_block hs ha _ hjn, getD_flatR hX 0 v (hs.lt _ hjn y)]

