/-- **The top-level assembly.** For every parameter record `P` with `P.Ok`, every `κ < P.gap`,
the moment and guard conditions of the two networks, the bit network (`BitNetR6MomStmt`) and the
complex network give `KappaBound κ`, assuming the six stack interfaces of `R6Ifaces.lean` at
every admissible parameter record (only records differing from `P` in `ε` are used). -/
theorem kappa_final6_sol_aux (κ : ℝ)
    (hSet : ∀ P : Prm, P.Ok → SetupNeed6 P) (hCrt : ∀ P : Prm, P.Ok → CrtNeed6 P)
    (hFine : ∀ P : Prm, P.Ok → FineNeed6 P) (hLine : ∀ P : Prm, P.Ok → LineNeed6 P)
    (hP14 : ∀ P : Prm, P.Ok → P14Need6 P) (hP18 : ∀ P : Prm, P.Ok → P18IL6 P) :
    ∀ P : Prm, P.Ok → κ < P.gap →
      histMoment Jain.bitR6 529 P.τ < 148225616 →
      histMoment Jain.cxR6 576 P.σ < 207387136 →
      2 + 576 * Real.log (histRankSum Jain.cxR6) ≤ P.C1 →
      Bit.BitNetR6MomStmt →
      (∃ T, ∃ J : Cx.Prop8IfaceH 207387136 T 576 Jain.cxR6, ∃ A, IL3H.GClassH J A) →
      IntMul.KappaBound κ := by
  intro P hP hκ hJb hJc hC1 hBit hCx
  obtain ⟨q, hO, hg⟩ := rat_eps P hP κ hκ
  exact kappa_final6_at _ hO ⟨q, rfl⟩ κ hg (hSet _ hO) (hCrt _ hO) (hFine _ hO) (hLine _ hO)
    (hP14 _ hO) (hP18 _ hO) hJb hJc hC1 hBit hCx

end

