private theorem charP_residueField_of_liesOverPrime (p : ℕ) [hp : Fact p.Prime]
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p) : CharP (ResidueField A) p := by
  refine (CharP.charP_iff_prime_eq_zero hp.out).mpr ?_
  have h : ((p : A) : AlgebraicClosure ℚ) ∈ A.nonunits := by
    have e : ((p : A) : AlgebraicClosure ℚ) = (p : AlgebraicClosure ℚ) := by norm_cast
    rw [e]
    exact hA
  rw [ValuationSubring.coe_mem_nonunits_iff] at h
  have h0 : residue A (p : A) = 0 := (residue_eq_zero_iff (p : A)).mpr h
  rwa [map_natCast] at h0

