-- name    : ProxAltMin.Conv.theorem_8
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T00:08:57.634379+00:00
-- url     : https://prove2.me/theorems/c6d3095f-4b01-4675-8e28-323aa1a0c010
-- title:
--   Theorem 8 (pre-convergence result) — a run starting near z̄ that never reaches L(z̄) stays in B(z̄, ρ), has finite length and converges to a critical point
-- statement:
--   Let $L=f+Q+g$ satisfy (H) and (H1), with step sizes $\lambda_k,\mu_k\in(r_-,r_+)$, $0<r_-<r_+$. Let $\bar z\in\mathbb R^n\times\mathbb R^m$ and let $\eta>0$, $U$ and $\varphi:[0,\eta)\to\mathbb R_+$ be the objects of the Kurdyka–Łojasiewicz inequality (14) relative to $L$ and $\bar z$: $\varphi$ is continuous, concave, $\varphi(0)=0$, $C^1$ on $(0,\eta)$ with $\varphi'>0$, and
--   $$\varphi'(L(z)-L(\bar z))\operatorname{dist}(0,\partial L(z))\ge1\quad\text{for all }z\in U\text{ with }L(\bar z)<L(z)<L(\bar z)+\eta .$$
--   Let $\rho>0$ with $B(\bar z,\rho)\subset U$, let $C$ be a Lipschitz constant for $\nabla Q$ on $B(\bar z,\sqrt2\rho)$, and $M=2r_+(C+1/r_-)$.
--
--   Let $z_k=(x_k,y_k)$ be generated by the alternating scheme (5)–(6) from $z_0$, with $l_k=L(z_k)$ and $\bar l=L(\bar z)$, and assume
--   $$\bar l<l_k<\bar l+\eta\quad\forall k\ge0,\tag{15}$$
--   $$M\varphi(l_0-\bar l)+2\sqrt{2r_+}\sqrt{l_0-\bar l}+\|z_0-\bar z\|<\rho.\tag{16}$$
--   Then $(z_k)$ converges to a critical point of $L$ (a point $z^\star$ with $0\in\partial L(z^\star)$), and for all $k\ge0$:
--   1. $z_k\in B(\bar z,\rho)$; (17)
--   2. the series below converges and
--   $$\sum_{i=k+1}^{\infty}\|z_{i+1}-z_i\|\le M\varphi(l_k-\bar l)+\sqrt{2r_+}\sqrt{l_k-\bar l}.\tag{18}$$
--
--   A sequence that starts close to $\bar z$ and never improves on $L(\bar z)$ is trapped near $\bar z$ and converges; this local result is what Theorem 9 globalizes.
--
--   **Formalization Note** $B(\bar z,r)$ is the open ball. The KL objects are explicit data; the theorem uses only the inequality on $U$ and $B(\bar z,\rho)\subset U$, and does not separately assume $\bar z\in\operatorname{dom}\partial L$. The convergence of the series in (18) is part of the conclusion.
-- source:
--   Attouch, Bolte, Redont, Soubeyran, Proximal alternating minimization and projection methods for nonconvex problems, Math. Oper. Res. (2010), p. 9, Theorem 8

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_ADMMKL_KLProperty
import Definitions.Def_ProxAltMin_Conv_Setting
open NonconvexSplitting.Shared NonconvexSplitting.ADMMKL
open Filter Topology

namespace ProxAltMin.Conv

/-- Theorem 8 (pre-convergence result, p. 9). Let `L` satisfy (H), (H1), and let `η > 0`, `U` and a
desingularizing `φ : [0, η) → ℝ₊` be such that the Kurdyka–Łojasiewicz inequality (14) holds for `L` at
`z̄` on `U ∩ [L(z̄) < L < L(z̄) + η]`. Let `ρ > 0` with `B(z̄, ρ) ⊂ U`, let `C` be a Lipschitz constant
for `∇Q` on `B(z̄, √2 ρ)`, and `M = 2r₊(C + 1/r₋)`. Let `(zₖ) = ((xₖ, yₖ))` be generated by (5)–(6), with
`lₖ = L(zₖ)`, `l̄ = L(z̄)`, such that `l̄ < lₖ < l̄ + η` for all `k ≥ 0` (15) and
`M φ(l₀ - l̄) + 2 √(2r₊) √(l₀ - l̄) + ‖z₀ - z̄‖ < ρ` (16). Then `(zₖ)` converges to a critical point of `L`,
and for all `k ≥ 0`: (17) `zₖ ∈ B(z̄, ρ)`; (18) `∑_{i=k+1}^∞ ‖z_{i+1} - zᵢ‖ ≤ M φ(lₖ - l̄) + √(2r₊) √(lₖ - l̄)`
(with the series convergent). -/
theorem theorem_8 {n m : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (Q : Z n m → ℝ)
    (g : EuclideanSpace ℝ (Fin m) → EReal) (lam mu : ℕ → ℝ) (rm rp : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m))
    (hH : AssumptionH f Q g) (hH1 : AssumptionH1 f Q g lam mu (y 0) rm rp)
    (hrun : IsPAMRun f Q g lam mu x y)
    (zbar : Z n m) (η : ℝ) (hη : 0 < η) (U : Set (Z n m)) (φ : ℝ → ℝ)
    (hφ : IsDesingularizer η φ) (hKL : KLIneq (L f Q g) zbar η U φ)
    (ρ : ℝ) (hρ : 0 < ρ) (hρU : Metric.ball zbar ρ ⊆ U) (C : NNReal)
    (hC : LipschitzOnWith C (gradient Q) (Metric.ball zbar (Real.sqrt 2 * ρ)))
    (h15 : ∀ k : ℕ, L f Q g zbar < L f Q g (pt (x k) (y k)) ∧
      L f Q g (pt (x k) (y k)) < L f Q g zbar + (η : EReal))
    (h16 : 2 * rp * ((C : ℝ) + 1 / rm) * φ (L f Q g (pt (x 0) (y 0)) - L f Q g zbar).toReal +
        2 * Real.sqrt (2 * rp) * Real.sqrt (L f Q g (pt (x 0) (y 0)) - L f Q g zbar).toReal +
        ‖pt (x 0) (y 0) - zbar‖ < ρ) :
    (∃ zlim : Z n m, (0 : Z n m) ∈ LimitingSubdiff (L f Q g) zlim ∧
      Tendsto (fun k => pt (x k) (y k)) atTop (𝓝 zlim)) ∧
    (∀ k : ℕ, pt (x k) (y k) ∈ Metric.ball zbar ρ) ∧
    ∀ k : ℕ,
      Summable (fun i => ‖pt (x (k + 1 + i + 1)) (y (k + 1 + i + 1)) -
        pt (x (k + 1 + i)) (y (k + 1 + i))‖) ∧
      ∑' i, ‖pt (x (k + 1 + i + 1)) (y (k + 1 + i + 1)) - pt (x (k + 1 + i)) (y (k + 1 + i))‖ ≤
        2 * rp * ((C : ℝ) + 1 / rm) * φ (L f Q g (pt (x k) (y k)) - L f Q g zbar).toReal +
          Real.sqrt (2 * rp) * Real.sqrt (L f Q g (pt (x k) (y k)) - L f Q g zbar).toReal := by sorry

end ProxAltMin.Conv
