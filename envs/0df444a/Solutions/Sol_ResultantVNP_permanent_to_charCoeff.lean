  obtain ⟨k,hk,_,he⟩ := ResultantVNP.lemma_3_7 𝓡 r hr (5*(3^r+1)^2)
  refine ⟨k,hk,fun A hA => ?_⟩
  rw [he _ (cls_surjective _) R _ (supported_equiv _ _ _ hA),gridSum_equiv]

lemma rational_projection (𝓡 : ResultantSystem) (n : ℕ) :
    ∃ ρ : Sym (Fin (5 * gridSide n ^ 2)) 3 → (Fin n × Fin n) ⊕ ℚ,
      MvPolynomial.aeval
        (fun T => Sum.elim MvPolynomial.X (fun q : ℚ => MvPolynomial.C (q : ℂ)) (ρ T))
        (MvPolynomial.map (Int.castRingHom ℂ) (charCoeff 𝓡 (5 * gridSide n ^ 2) (gridSide n ^ 2))) =
        (Matrix.of fun i j : Fin n => (X (i,j) : MvPolynomial (Fin n × Fin n) ℂ)).permanent := by
  obtain ⟨k,hk,he⟩ := extraction (R := MvPolynomial (Fin n × Fin n) ℂ) 𝓡 (gridSide n) (side_form n)
  let q : ℚ := (k : ℚ)⁻¹
  let A := normalized n q
  have hA := normalized_supported n q
  have hf (T : Sym (Fin (5 * gridSide n ^ 2)) 3) :
      ∃ z : (Fin n × Fin n) ⊕ ℚ,
        Sum.elim MvPolynomial.X (fun q : ℚ => MvPolynomial.C (q : ℂ)) z =
          A (Sym.map (indexEquiv (gridSide n)) T) := by
    rcases normalized_entries n q (Sym.map (indexEquiv (gridSide n)) T) with ⟨z,hz⟩ | ⟨ij,hij⟩
    · exact ⟨Sum.inr z,hz.symm⟩
    · exact ⟨Sum.inl ij,hij.symm⟩
  choose ρ hρ using hf
  refine ⟨ρ,?_⟩
  simp_rw [hρ]
  have hex := he A hA
  rw [show gridSum Prod.fst A = C (q : ℂ) *
      (Matrix.of fun i j : Fin n => (X (i,j) : MvPolynomial (Fin n × Fin n) ℂ)).permanent
      from normalized_sum n q] at hex
  have hq : (k : ℂ) * (q : ℂ) = 1 := by
    dsimp [q]
    push_cast
    exact mul_inv_cancel₀ (by exact_mod_cast hk)
  have hmul : (k : MvPolynomial (Fin n × Fin n) ℂ) * C (q : ℂ) = 1 := by
    simpa only [map_mul,map_intCast,map_one] using congrArg
      (C : ℂ →+* MvPolynomial (Fin n × Fin n) ℂ) hq
  rw [← mul_assoc,hmul,one_mul] at hex
  convert hex using 1
  simp only [MvPolynomial.aeval_def,MvPolynomial.eval₂_map]
  congr 1

lemma side_polybounded : PolyBounded gridSide := by
  refine ⟨4,fun n => ?_⟩
  by_cases hn : n = 0
  · subst n
    have hside : gridSide 0 = 4 := by
      apply le_antisymm
      · change 3 ^ Nat.find (gridSide_exists 0) + 1 ≤ 4
        have hfind : Nat.find (gridSide_exists 0) ≤ 1 := Nat.find_min' _ (by norm_num)
        exact Nat.add_le_add_right (Nat.pow_le_pow_right (by omega : 1 ≤ 3) hfind) 1
      · exact side_ge_four 0
    simp [hside]
  · have hside := side_linear n (by omega)
    have hp : n ≤ n^4 := le_self_pow₀ (by omega) (by omega)
    omega

end PermanentProjection

theorem solution (𝓡 : ResultantVNP.ResultantSystem) :
    ∃ t : ℕ → ℕ, ResultantVNP.PolyBounded t ∧ ∀ n, 1 ≤ n → 3 ≤ t n ∧
      ∃ ρ : Sym (Fin (5 * t n ^ 2)) 3 → (Fin n × Fin n) ⊕ ℚ,
        MvPolynomial.aeval
          (fun T => Sum.elim MvPolynomial.X (fun q : ℚ => MvPolynomial.C (q : ℂ)) (ρ T))
          (MvPolynomial.map (Int.castRingHom ℂ)
            (ResultantVNP.charCoeff 𝓡 (5 * t n ^ 2) (t n ^ 2))) =
          (Matrix.of fun i j : Fin n =>
            (MvPolynomial.X (i,j) : MvPolynomial (Fin n × Fin n) ℂ)).permanent := by
  refine ⟨ResultantVNP.gridSide,PermanentProjection.side_polybounded,fun n _ => ?_⟩
  exact ⟨by have := GridConstruction.side_ge_four n; omega,
    PermanentProjection.rational_projection 𝓡 n⟩

