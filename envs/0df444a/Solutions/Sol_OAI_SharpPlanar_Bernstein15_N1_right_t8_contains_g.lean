namespace N1_right
lemma t8_checked : ((hm15_1_0_10.realAnswer).add hm15_0_1_10.realAnswer).scale (1) 256=t8 := by decide +kernel
lemma t8_contains_g_oai : t8.Contains (sourcePower true 15 (1/2) 2 8) := by
  rw [← t8_checked]
  convert RBox.contains_scale_g (RBox.contains_add_g hm15_1_0_10.realContains hm15_0_1_10.realContains) (1) 256 (by norm_num) using 1
  all_goals try with_reducible_and_instances rfl
  norm_num [sourcePower,normalizedH]
end N1_right
end SharpPlanar.Bernstein15

