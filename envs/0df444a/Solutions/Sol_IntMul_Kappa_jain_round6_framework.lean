section
-- Source module: Solutions.J6Final6_1
/-!
# Round six, final glue (1): the platform target from the leaf hypotheses

**`jain_round6_framework_leaf`**: the exact statement of `IntMul.Kappa.jain_round6_framework`
from
* the `A` side: `AxisUA6` (per-axis `A` program; its `GB` invariant is `pipeGBA6_all`),
* the `B` side leaves: `PreNeed6` (B5), `SlabNeed6` (B1), `AxBudget6` (S2) at the concrete plan
  `ap6`.

`ValCond6 ap6` and `ChunkPlan6 ap6` are proved here (`ap6_val`, `ap6_chunk`); `AxisU6` is
`J6Seg.Ax.axisU6_of`. `jain_round6_framework_leaf'` is the same for any plan with those two
conditions.
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6
open IntMul.Kappa

theorem ap6_val : J6Seg.Val.ValCond6 ap6 := by
  unfold J6Seg.Val.ValCond6 ap6; decide

theorem ap6_chunk : J6Seg.AxCh.ChunkPlan6 ap6 := by
  unfold J6Seg.AxCh.ChunkPlan6 ap6; decide

/-- **The round-six target from the leaves, at any admissible plan.** -/
theorem jain_round6_framework_leaf' (ap : J6Seg.AxPlan6) (hVC : J6Seg.Val.ValCond6 ap)
    (hCP : J6Seg.AxCh.ChunkPlan6 ap)
    (hA : ∀ P : Prm, P.Ok → ∀ tab : Fin 1 → NLogN.IStmt NLogN.HS 1, IL.SwapNeedτ tab P.τ →
      IL2.RowUCP 576 P.τ tab → FineU6 tab → J6Seg.AxisUA6 P tab)
    (hPre : ∀ P : Prm, P.Ok → J6Seg.PreNeed6 P ap.pl)
    (hSlab : ∀ P : Prm, P.Ok → J6Seg.Ax.SlabNeed6 P)
    (hBud : ∀ P : Prm, P.Ok → J6Seg.AxBudget6 P ap)
