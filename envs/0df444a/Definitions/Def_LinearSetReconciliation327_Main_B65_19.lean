  have hlen := frontier_length_le_mass fs hpos
  have hmul : T ≤ T * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left T (show 1 ≤ cap by omega)
  have hn : fs.length < 2 ^ E.W := by omega
