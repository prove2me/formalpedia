-- title:
--   Theorem 1 — the fixed-step Golden Ratio Algorithm converges to a solution of the monotone VI
-- statement:
--   Let $\mathcal E$ be a finite-dimensional real inner product space and $\varphi = \frac{\sqrt5+1}2$. Assume
--
--   1. (C1) the solution set $S$ of the variational inequality (1) is nonempty;
--   2. (C2) $g:\mathcal E\to(-\infty,+\infty]$ is proper, convex and lower semicontinuous;
--   3. (C3) $F$ is monotone on $\operatorname{dom} g$;
--   4. $F$ is $L$-Lipschitz on $\operatorname{dom} g$ with $L>0$.
--
--   Let $z^1,\bar z^0\in\mathcal E$ be arbitrary and $\lambda\in\big(0,\frac{\varphi}{2L}\big]$, and let $(z^k)$, $(\bar z^k)$ be generated by the Golden Ratio Algorithm
--   $$\bar z^k = \frac{(\varphi-1)z^k+\bar z^{k-1}}{\varphi},\qquad z^{k+1} = \operatorname{prox}_{\lambda g}\big(\bar z^k-\lambda F(z^k)\big)\qquad(k\ge1).$$
--   Then there is $z^*\in S$ with
--   $$z^k \to z^* \quad\text{and}\quad \bar z^k\to z^* \qquad (k\to\infty).$$
--
--   The theorem shows that one evaluation of $F$ and one proximal step per iteration, with a convex combination weighted by the golden ratio, suffice to solve monotone variational inequalities with a Lipschitz operator.
--
--   **Formalization Note** The Lipschitz condition is $\|F(u)-F(v)\|\le L\|u-v\|$ for $u,v\in\operatorname{dom} g$; the positivity $L>0$ is implicit in the paper's step bound $\varphi/(2L)$. The proximal step is the argmin predicate for $\lambda g$. The starting points are unrestricted, as in the paper (if $z^1\notin\operatorname{dom} g$ the value $F(z^1)$ is an arbitrary vector, which affects only the first step). Both sequences converge to the same limit.
-- source:
--   Malitsky, Golden Ratio Algorithms for Variational Inequalities, preprint (Optimization Online 6598, 2018), p. 4, Theorem 1

import Mathlib
import Definitions.Def_GoldenRatioVI_Fixed_solutionSet
import Definitions.Def_GoldenRatioVI_Fixed_IsGRAALRun
open scoped goldenRatio

namespace GoldenRatioVI.Fixed

/-- Theorem 1: let `F` be `L`-Lipschitz on `dom g` and let (C1)–(C3) hold. For arbitrary
`z¹, z̄⁰ ∈ E` and `λ ∈ (0, φ/(2L)]`, the sequences `(zᵏ)`, `(z̄ᵏ)` generated by the Golden
Ratio Algorithm (6) converge to a common solution of the variational inequality (1). -/
theorem graal_converges {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] (g : E → EReal) (F : E → E) (L lam : ℝ) (z zbar : ℕ → E)
    (hS : (solutionSet g F).Nonempty)
    (hg : IsProperConvexLSC g) (hF : IsMonotoneOperatorOn F (effDom g))
    (hL : 0 < L) (hLip : ∀ u ∈ effDom g, ∀ v ∈ effDom g, ‖F u - F v‖ ≤ L * ‖u - v‖)
    (hlam : 0 < lam) (hlamL : lam ≤ φ / (2 * L))
    (hrun : IsGRAALRun g F lam z zbar) :
    ∃ zs ∈ solutionSet g F,
      Filter.Tendsto z Filter.atTop (nhds zs) ∧
        Filter.Tendsto zbar Filter.atTop (nhds zs) := by sorry

end GoldenRatioVI.Fixed
