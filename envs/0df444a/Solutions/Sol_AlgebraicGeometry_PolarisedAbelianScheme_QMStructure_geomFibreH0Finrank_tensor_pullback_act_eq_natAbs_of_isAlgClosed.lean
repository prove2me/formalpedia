namespace NrdNeZero

theorem nrd_mul' {a b : ℚ} (p q : ℍ[ℚ, a, b]) : nrd (p * q) = nrd p * nrd q := by
  obtain ⟨p0, p1, p2, p3⟩ := p
  obtain ⟨q0, q1, q2, q3⟩ := q
  simp only [nrd_mk, mk_mul_mk, zero_mul, add_zero]
  ring

theorem sig (d1 d2 d3 : ℚ) (h1 : d1 ≤ 0) (h2 : d2 ≤ 0)
    (x1 x2 x3 m1 m2 m3 N : ℚ) (hN : 0 < N)
    (hx : d1 * x1 ^ 2 + d2 * x2 ^ 2 + d3 * x3 ^ 2 = 1)
    (hm : d1 * m1 ^ 2 + d2 * m2 ^ 2 + d3 * m3 ^ 2 = N)
    (hB : d1 * x1 * m1 + d2 * x2 * m2 + d3 * x3 * m3 = 0) : False := by
  have key : d1 * (m3 * x1 - x3 * m1) ^ 2 + d2 * (m3 * x2 - x3 * m2) ^ 2 = m3 ^ 2 * 1 + x3 ^ 2 * N := by
    linear_combination (m3 ^ 2) * hx + (x3 ^ 2) * hm - (2 * m3 * x3) * hB
  have e1 : d1 * (m3 * x1 - x3 * m1) ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg h1 (sq_nonneg _)
  have e2 : d2 * (m3 * x2 - x3 * m2) ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg h2 (sq_nonneg _)
  have hx3sq : x3 ^ 2 * N ≤ 0 := by nlinarith [sq_nonneg m3]
  have hx3 : x3 = 0 := by
    have : x3 ^ 2 ≤ 0 := by
      by_contra hc
      have hc' : 0 < x3 ^ 2 := lt_of_not_ge hc
      have := mul_pos hc' hN
      linarith
    exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp (le_antisymm this (sq_nonneg x3))
  subst hx3
  have : d1 * x1 ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg h1 (sq_nonneg _)
  have : d2 * x2 ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg h2 (sq_nonneg _)
  nlinarith

theorem core (a b : ℚ) (hab : 0 < a ∨ 0 < b) (N : ℚ) (hN : 0 < N)
    (m x s : ℍ[ℚ, a, b]) (hm : m * m = -(N • (1 : ℍ[ℚ, a, b]))) (hs : m * s = star x * m)
    (h : 1 + s * x = 0) : False := by
  have hsx : s * x = -1 := by
    have := congrArg (fun z => z - 1) h
    simpa [add_sub_cancel_left] using this

  have hE : star x * m * x = -m := by
    have : m * (s * x) = star x * m * x := by rw [← mul_assoc, hs]
    rw [hsx, mul_neg_one] at this
    exact this.symm
  have hF : ((nrd x : ℚ) : ℍ[ℚ, a, b]) * m * x = -(x * m) := by
    rw [← mul_star_eq_coe_nrd]
    calc x * star x * m * x = x * (star x * m * x) := by simp only [mul_assoc]
      _ = x * (-m) := by rw [hE]
      _ = -(x * m) := mul_neg x m

  have hnn : nrd x * nrd m * nrd x = nrd m := by
    have := congrArg nrd hE
    rwa [nrd_mul', nrd_mul', nrd_star, nrd_neg] at this
  obtain ⟨m0, m1, m2, m3⟩ := m
  obtain ⟨x0, x1, x2, x3⟩ := x

  have hN1 : -(N • (1 : ℍ[ℚ, a, b])) = ⟨-N, 0, 0, 0⟩ := by ext <;> simp
  rw [hN1] at hm
  simp only [mk_mul_mk, zero_mul, add_zero, QuaternionAlgebra.mk.injEq] at hm
  obtain ⟨hm_re, hm_i, hm_j, hm_k⟩ := hm
  have hm0 : m0 = 0 := by
    by_contra h0
    have h1 : m1 = 0 := by
      have : 2 * m0 * m1 = 0 := by linear_combination hm_i
      rcases mul_eq_zero.mp this with h | h
      · exact absurd (by linarith : m0 = 0) h0
      · exact h
    have h2 : m2 = 0 := by
      have : 2 * m0 * m2 = 0 := by linear_combination hm_j
      rcases mul_eq_zero.mp this with h | h
      · exact absurd (by linarith : m0 = 0) h0
      · exact h
    have h3 : m3 = 0 := by
      have : 2 * m0 * m3 = 0 := by linear_combination hm_k
      rcases mul_eq_zero.mp this with h | h
      · exact absurd (by linarith : m0 = 0) h0
      · exact h
    subst h1 h2 h3
    nlinarith [sq_nonneg m0]
  subst hm0

  have hQm : -a * m1 ^ 2 + -b * m2 ^ 2 + (a * b) * m3 ^ 2 = N := by linear_combination (-1 : ℚ) * hm_re
  have hnrdm : nrd (⟨0, m1, m2, m3⟩ : ℍ[ℚ, a, b]) = N := by rw [nrd_mk]; linear_combination (-1 : ℚ) * hm_re
  rw [hnrdm] at hnn

  have hn2 : nrd (⟨x0, x1, x2, x3⟩ : ℍ[ℚ, a, b]) ^ 2 = 1 := by
    have : (nrd (⟨x0, x1, x2, x3⟩ : ℍ[ℚ, a, b]) ^ 2 - 1) * N = 0 := by linear_combination hnn
    rcases mul_eq_zero.mp this with h | h
    · linarith
    · exact absurd h hN.ne'
  have hnx : nrd (⟨x0, x1, x2, x3⟩ : ℍ[ℚ, a, b]) = x0 ^ 2 - a * x1 ^ 2 - b * x2 ^ 2 + a * b * x3 ^ 2 := nrd_mk _ _ _ _

  set n := nrd (⟨x0, x1, x2, x3⟩ : ℍ[ℚ, a, b]) with hndef
  simp only [coe_mul_eq_smul, smul_mk, smul_eq_mul, mk_mul_mk, zero_mul, mul_zero, add_zero, sub_zero, zero_add,
    neg_mk, QuaternionAlgebra.mk.injEq] at hF
  obtain ⟨hF_re, hF_i, hF_j, hF_k⟩ := hF

  have hQx : n = x0 ^ 2 + (-a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2) := by rw [hndef, nrd_mk]; ring

  have hm' : ¬ (m1 = 0 ∧ m2 = 0 ∧ m3 = 0) := by
    rintro ⟨r1, r2, r3⟩; subst r1 r2 r3; linarith
  have hcases : (n - 1) * (n + 1) = 0 := by linear_combination hn2
  rcases mul_eq_zero.mp hcases with h1 | h1
  ·
    have hn1 : n = 1 := by linarith
    rw [hn1] at hF_re hF_i hF_j hF_k hQx
    have hB : -a * x1 * m1 + -b * x2 * m2 + (a * b) * x3 * m3 = 0 := by linear_combination (-1/2 : ℚ) * hF_re
    have e1 : x0 * m1 = 0 := by linear_combination (1/2 : ℚ) * hF_i
    have e2 : x0 * m2 = 0 := by linear_combination (1/2 : ℚ) * hF_j
    have e3 : x0 * m3 = 0 := by linear_combination (1/2 : ℚ) * hF_k
    have hx0 : x0 = 0 := by
      by_contra h0
      apply hm'
      exact ⟨(mul_eq_zero.mp e1).elim (fun h => absurd h h0) id,
        (mul_eq_zero.mp e2).elim (fun h => absurd h h0) id,
        (mul_eq_zero.mp e3).elim (fun h => absurd h h0) id⟩
    subst hx0
    have hQx1 : -a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2 = 1 := by linear_combination (-1 : ℚ) * hQx

    rcases lt_trichotomy 0 a with ha | ha | ha
    · rcases lt_or_ge 0 b with hb | hb
      ·
        exact sig (-a) (-b) (a * b) (by linarith) (by linarith) x1 x2 x3 m1 m2 m3 N hN hQx1 hQm hB
      ·
        exact sig (-a) (a * b) (-b) (by linarith) (mul_nonpos_of_nonneg_of_nonpos ha.le hb) x1 x3 x2 m1 m3 m2 N hN
          (by linear_combination hQx1) (by linear_combination hQm) (by linear_combination hB)
    ·
      subst ha
      have hb : 0 < b := hab.resolve_left (lt_irrefl 0)
      nlinarith [sq_nonneg m2]
    ·
      have hb : 0 < b := hab.resolve_left (not_lt.mpr ha.le)
      exact sig (-b) (a * b) (-a) (by linarith) (mul_nonpos_of_nonpos_of_nonneg ha.le hb.le) x2 x3 x1 m2 m3 m1 N hN
        (by linear_combination hQx1) (by linear_combination hQm) (by linear_combination hB)
  ·
    have hn1 : n = -1 := by linarith
    rw [hn1] at hF_re hF_i hF_j hF_k hQx
    have c1 : b * (m3 * x2 - m2 * x3) = 0 := by linear_combination (-1/2 : ℚ) * hF_i
    have c2 : a * (m1 * x3 - m3 * x1) = 0 := by linear_combination (-1/2 : ℚ) * hF_j
    have c3 : m1 * x2 - m2 * x1 = 0 := by linear_combination (-1/2 : ℚ) * hF_k

    have lag : (-a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2) * N =
        (-a * x1 * m1 + -b * x2 * m2 + (a * b) * x3 * m3) ^ 2 := by
      have c1' : b * (m3 * x2 - m2 * x3) ^ 2 = 0 := by
        rcases mul_eq_zero.mp c1 with h | h
        · rw [h, zero_mul]
        · rw [h]; ring
      have c2' : a * (m1 * x3 - m3 * x1) ^ 2 = 0 := by
        rcases mul_eq_zero.mp c2 with h | h
        · rw [h, zero_mul]
        · rw [h]; ring
      linear_combination (-(-a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2)) * hQm +
        (a * b * (m1 * x2 - m2 * x1)) * c3 + (-(a * b)) * c2' + (-(a * b)) * c1'
    have hQx' : 0 ≤ -a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2 := by
      by_contra hneg
      have hneg' : -a * x1 ^ 2 + -b * x2 ^ 2 + (a * b) * x3 ^ 2 < 0 := lt_of_not_ge hneg
      have := mul_neg_of_neg_of_pos hneg' hN
      linarith [sq_nonneg (-a * x1 * m1 + -b * x2 * m2 + (a * b) * x3 * m3), lag]
    linarith [sq_nonneg x0, hQx', hQx]

end NrdNeZero

