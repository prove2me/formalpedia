/-!
# VIII08 — the frozen odd magnetic / rotation block: operator, source class, and conventions

Fixed anchor `(R_h, R_i, Q) = (3, 1, 3/2)`, `I = (3, ∞)`.

* `Lmag b = (P b')' - V b` with `P = N/R`, `N = (R-3)(R-1)`, `V = 1/R + 9/R³ = 1/R + 4Q²/R³`;
  this is the inherited VIII04 `Lop 3 1 (3/2)` — not a new parallel operator (`Lmag_eq_Lop`).
* `Dell j b v = R³ v' + 6 b + 2 j` (the actual `ε`-coefficient of the angular-momentum integral,
  with `6 = 4Q`; the convention is fixed by the source identity of this round, so it is stated, not assumed
  from a physical normalisation).
* Compact variable `x = 1/R`; profile window `U = (-1/12, 5/12)`, `K = [0, 1/3]`; `a = 1/3`.
* Sources: `j : ℝ` plus `q, r : ℝ → ℝ` each `C¹` on `U`; `s x = 3j + q x`.
-/

set_option maxHeartbeats 1000000

open Set Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08

open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04

/-! ## Anchor constants -/

/-- `P = N/R`. -/
noncomputable def P (R : ℝ) : ℝ := N0 3 1 R / R

/-- `V` as a function. -/
noncomputable def Vfun (R : ℝ) : ℝ := 1 / R + 9 / R ^ 3

/-- The magnetic operator of the odd block: `(P b')' - V b` at the anchor. -/
noncomputable def Lmag (b : ℝ → ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => P s * deriv b s) R - Vfun R * b R

/-- The angular-momentum-integral defect operator `R³ v' + 6b + 2j` (genuine derivative of `v`). -/
noncomputable def Dell (j : ℝ) (b v : ℝ → ℝ) (R : ℝ) : ℝ :=
  R ^ 3 * deriv v R + 6 * b R + 2 * j

/-! ## Source class -/

/-- The compact profile window. -/
def UG : Set ℝ := Ioo (-1 / 12) (5 / 12)

/-- The compactified source interval `K = [0, 1/3]`. -/
def KG : Set ℝ := Icc 0 (1 / 3)

/-- The compactified horizon value `a = 1/R_h = 1/3`. -/
noncomputable def aG : ℝ := 1 / 3

/-- The source profile function `s = 3j + q`. -/
noncomputable def sfun (j : ℝ) (q : ℝ → ℝ) (x : ℝ) : ℝ := 3 * j + q x

/-! ## Consistency of conventions -/

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08


