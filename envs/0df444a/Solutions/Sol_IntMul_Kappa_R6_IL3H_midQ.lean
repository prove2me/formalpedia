section Layer

variable {P K D S ρ : ℕ}

theorem slaws_layer (hρ : ρ < K) :
    SLaws (fun i : Fin D => KFH.stT K D S ρ i) (P * (2 ^ K) ^ D * S) := by
  have := slaws_of_strideSel (strideSel_layer (P := P) (D := D) (S := S) hρ)
