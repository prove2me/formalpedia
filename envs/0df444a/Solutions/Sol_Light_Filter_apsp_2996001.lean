  omega

theorem PmaxOf_le_two_pow {n : ℕ} (hm : 2 ≤ mmOf n) :
    PmaxOf n ≤ sOf n * 2 ^ (bOf n + 3 * ellOf n + 2) := by
  unfold PmaxOf RR
