-- title:
--   Replacing one component within its core class preserves Jantzen linkage
-- statement:
--   Let $F$ be a field, let $n,r\ge1$, let $q\in F^\times$ with $q\ne1$, and fix integer charges $c_1,\ldots,c_r$, with $Q_a=q^{c_a}$. Let $e$ be the least $k\ge2$ with $1+q+\cdots+q^{k-1}=0$, or $\infty$ if there is none. For an $r$-multipartition $\lambda$ of $n$, each node $(i,j,a)$ has charged residue $j-i+c_a$ modulo $e$, interpreted as an integer when $e=\infty$. Residue multiplicities count nodes individually. The relation $\sim_J$ is the equivalence relation generated by nonzero coefficients $J_{\alpha\beta}$ in Definition 2.5, with intermediate multipartitions of the same size.
--
--   Fix a component $a\in\{1,\ldots,r\}$, and let $\lambda,\mu$ be multipartitions of $n$. Let $\overline\rho$ denote the ordinary $e$-core of a partition $\rho$, obtained by removing all possible $e$-rim hooks; for $e=\infty$ it is $\rho$ itself. Then
--
--   $$
--   \overline{\lambda^{(a)}}=\overline{\mu^{(a)}}
--   \quad\text{and}\quad
--   \lambda^{(b)}=\mu^{(b)}\ (b\ne a)
--   \quad\Longrightarrow\quad
--   \lambda\sim_J\mu.
--   $$
--
--   This describes all multipartitions in the set $\Lambda_a(\lambda)$ of Proposition 3.7. The original selected components may differ; only their cores must agree.
-- source:
--   Blocks of cyclotomic Hecke algebras, arXiv:math/0607451v4, PDF p. 13, Proposition 3.7

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P29

namespace QAlgorithms.Papers.Independent.Intake100.P29

noncomputable section

open scoped BigOperators Classical

variable {F : Type} [Field F]

/-- Proposition 3.7, PDF pp. 13--14. The selected components have equal cores,
not necessarily equal original shapes. At e=infinity this reduces to equality. -/
theorem same_component_core_jantzen {r n : ℕ} (hr : 0 < r) (hn : 0 < n)
    (q : F) (hq : q ≠ 0) (hqOne : q ≠ 1) (c : Fin r → ℤ)
    (L M : Multipartition r) (hL : size L = n) (hM : size M = n) (a : Fin r)
    (hcore : partitionCore (quantumCharacteristic q) (M a) =
      partitionCore (quantumCharacteristic q) (L a))
    (hother : ∀ b, b ≠ a → M b = L b) :
    JantzenEquivalent q (fun b => q ^ c b) L M := by sorry

end

end QAlgorithms.Papers.Independent.Intake100.P29
