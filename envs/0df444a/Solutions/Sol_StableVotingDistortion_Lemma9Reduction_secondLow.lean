theorem released_low_second {p x : ℝ} (hp : p∈Icc pA PaperCurve.lam) (hx : x∈Icc p PaperCurve.lam) :
    p-entry PaperMiddle.Knot.beta p*J score p+max (x-PaperCurve.lam+entry PaperMiddle.Knot.eta p*score x) 0≤0 := by
  have hp0 := (by norm_num [pA] : 0 ≤ pA).trans hp.1
  obtain ⟨c,d,hm,hcd,hp',hen⟩ := lp_cell (show p∈Icc pA pC from ⟨hp.1,hp.2.trans
    (by norm_num [pC,PaperCurve.lam,lamQ])⟩)
  let a := qRank c
  let b := min (qRank d) lamQ
  let mid := (a+b)/2
  have hda : (a:ℝ) ≤ p := by simpa [a,qRank_cast] using hp'.1
  have hdb : p≤(b:ℝ) := by simpa only [b,Rat.cast_min,qRank_cast,PaperCurve.lam] using le_min hp'.2 hp.2
  have hle : a ≤ b := by exact_mod_cast hda.trans hdb
  have hh := List.all_eq_true.mp mass_match _ hm
  change (if b < a then true else _ && _) = true at hh
  rw [if_neg hle.not_gt] at hh
  obtain ⟨lower,upper⟩ := Bool.and_eq_true_iff.mp hh
  have hcell : ∃ m∈masses,∃ l h : ℚ, link c d l h m ∧ p∈Icc (l:ℝ) h := by
    by_cases h : p ≤ mid
    · obtain ⟨m,hmem,hm'⟩ := List.any_eq_true.mp lower
      exact ⟨m,hmem,a,mid,of_decide_eq_true hm',hda,h⟩
    · obtain ⟨m,hmem,hm'⟩ := List.any_eq_true.mp upper
      exact ⟨m,hmem,mid,b,of_decide_eq_true hm',le_of_not_ge h,hdb⟩
  obtain ⟨m,hin,l,h,hl,hd⟩ := hcell
  obtain ⟨elo,ehi,b0,b1,e0,e1⟩ := hl
  obtain ⟨t,ht,eq⟩ := affine_parameter hd
  have ep : p=(1-t)*(l:ℝ)+t*h := by linarith only [eq]
  obtain ⟨s,hs,hxs,hline⟩ := score_majorized ⟨hp0.trans hx.1,hx.2⟩
  have checked := mass_checks m hin
  exact mass_certifies checked.1 (checked.2 s hs) (by simpa only [elo,ehi] using hd) hxs hx.1 hline ht
    (by simpa only [elo,ehi] using ep)
    (by rw [b0,b1];exact entry_mixes hcd hp' ep (hen _))
    (by rw [e0,e1];exact entry_mixes hcd hp' ep (hen _))
    (entry_nonneg _ _)


end StableVotingDistortion.PaperAnalytic
end

open StableVotingDistortion StableVotingDistortion.PaperMiddle StableVotingDistortion.PaperCurve StableVotingDistortion.PaperBox Set
theorem solution {p x : ℝ} (hp : p ∈ Icc pA PaperCurve.lam) (hx : x ∈ Icc p PaperCurve.lam) : p-entry PaperMiddle.Knot.beta p*J score p+max (x-PaperCurve.lam+entry PaperMiddle.Knot.eta p*score x) 0≤0 := by
  exact PaperAnalytic.released_low_second hp hx
