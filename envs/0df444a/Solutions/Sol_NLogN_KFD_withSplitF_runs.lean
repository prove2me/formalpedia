variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem withSplitF_runs_sol_aux (p : IStmt HS Pp) (W P L' h Bb : ℕ) (t : IState HS) (xs ys : List ℤ) (R : List Item)
    (hP1 : 1 ≤ P) (hL1 : 1 ≤ L') (hh : 1 ≤ h)
    (zW : zsz (W : ℤ) ≤ Bb) (zv : zsz ((P * L' * h : ℕ) : ℤ) ≤ Bb) (hB1 : 1 ≤ Bb)
    {L1 L2 L3 : List Item} (hPp : t.G dP = .int (P : ℤ) :: L1)
    (hLp : t.G rLp = .int (L' : ℤ) :: L2)
    (hVv : t.G rV = .int ((P * L' * h : ℕ) : ℤ) :: L3) (cp : ℕ)
    (hp : ∀ u : IState HS, u.G 0 = ints xs ++ R → u.G 1 = .int ((1 : ℕ) : ℤ) :: t.G 1 →
      u.G 2 = .int (W : ℤ) :: t.G 2 → u.G 3 = .int ((P * L' : ℕ) : ℤ) :: t.G 3 →
      u.G 4 = .int (h : ℤ) :: t.G 4 →
      IRuns I iprog p u (u.upd 0 (ints ys ++ R)) cp) :
    IRuns I iprog (withPushI (splitL W) p) (t.upd 0 (ints xs ++ R)) (t.upd 0 (ints ys ++ R))
      (cSplit W Bb + cp) := by
  set t0 := t.upd 0 (ints xs ++ R)
  have g : ∀ r : Fin HS, r ≠ 0 → t0.G r = t.G r := fun r hr => by simp [t0, hr]
  have hPp' := (g dP (by decide)).trans hPp
  have hLp' := (g rLp (by decide)).trans hLp
  have hVv' := (g rV (by decide)).trans hVv
  set v := P * L' * h
  have hle : ∀ x : ℕ, x ≤ v → zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (zsz_nat_le hx) zv
  have lPL : P * L' ≤ v := Nat.le_mul_of_pos_right _ hh
  have lP : P ≤ v := le_trans (Nat.le_mul_of_pos_right _ hL1) lPL
  have lL : L' ≤ v := le_trans (Nat.le_mul_of_pos_left _ hP1) lPL
  have lh : h ≤ v := Nat.le_mul_of_pos_left _ (Nat.mul_pos hP1 hL1)
  have gP := goodE_reg (rd_reg' (r := dP) ⟨by decide, by decide⟩) hPp' (hle _ lP)
  have gL := goodE_reg (rd_reg' (r := rLp) ⟨by decide, by decide⟩) hLp' (hle _ lL)
  have gV := goodE_reg (rd_reg' (r := rV) ⟨by decide, by decide⟩) hVv' zv
  have e3 : (Ex.mul (.reg dP) (.reg rLp) : Ex HS).eval t0 = ((P * L' : ℕ) : ℤ) := by
    simp only [Ex.eval]; rw [IState.top_eq hPp', IState.top_eq hLp']; push_cast; ring
  have g3 : GoodE t0 Bb (.mul (.reg dP) (.reg rLp)) := goodE_mul gP gL (by
    rw [eval_reg' hPp', eval_reg' hLp']; exact_mod_cast hle _ lPL)
  have e4 : (Ex.ndiv (.reg rV) (.mul (.reg dP) (.reg rLp)) : Ex HS).eval t0 = (h : ℤ) := by
    simp only [Ex.eval] at e3 ⊢
    rw [e3, IState.top_eq hVv']
    have hPL0 : ((P * L' : ℕ) : ℤ) ≠ 0 := by have := Nat.mul_pos hP1 hL1; omega
    rw [show ((v : ℕ) : ℤ) = ((P * L' : ℕ) : ℤ) * (h : ℤ) by simp only [v]; push_cast; ring]
    exact Int.mul_ediv_cancel_left _ hPL0
  have g4 : GoodE t0 Bb (.ndiv (.reg rV) (.mul (.reg dP) (.reg rLp))) :=
    goodE_ndiv gV g3 (by rw [eval_reg' hVv']; positivity)
      (by rw [e3]; have := Nat.mul_pos hP1 hL1; omega)
      (by
        show zsz ((Ex.ndiv (.reg rV) (.mul (.reg dP) (.reg rLp)) : Ex HS).eval t0) ≤ Bb
        rw [e4]; exact hle _ lh)
  have z1 : zsz ((1 : ℤ)) ≤ Bb := by rw [zsz_one]; exact hB1
  have hPO : PushOK t0 Bb (splitL W) := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [splitL, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact goodE_lit z1
    · exact goodE_lit zW
    · exact g3
    · exact g4)
  have hev : evalP t0 (splitL W) =
      [(1, (1 : ℤ)), (2, (W : ℤ)), (3, ((P * L' : ℕ) : ℤ)), (4, (h : ℤ))] := by
    simp only [evalP_eq, splitL, List.map_cons, List.map_nil, e3, e4]; rfl
  have hv : ∀ q ∈ splitL W, zsz (q.2.eval t0) ≤ Bb := by
    intro q hq; simp only [splitL, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl
    · exact z1
    · exact zW
    · rw [e3]; exact hle _ lPL
    · rw [e4]; exact hle _ lh
  set u := pushSt t0 (evalP t0 (splitL W))
  have hu : ∀ i : Fin HS, u.G i = if i = 4 then .int (h : ℤ) :: t.G 4 else
      if i = 3 then .int ((P * L' : ℕ) : ℤ) :: t.G 3 else if i = 2 then .int (W : ℤ) :: t.G 2 else
      if i = 1 then .int (1 : ℤ) :: t.G 1 else t0.G i := by
    intro i
    simp only [u, hev, pushSt]
    by_cases h4 : i = 4
    · subst h4; simp +decide [IState.upd_G, t0]
    by_cases h3 : i = 3
    · subst h3; simp +decide [IState.upd_G, t0]
    by_cases h2 : i = 2
    · subst h2; simp +decide [IState.upd_G, t0]
    by_cases h1 : i = 1
    · subst h1; simp +decide [IState.upd_G, t0]
    simp [IState.upd_G, h1, h2, h3, h4]
  have M := hp u (by rw [hu]; simp +decide [t0]) (by rw [hu]; simp +decide)
    (by rw [hu]; simp +decide) (by rw [hu]; simp +decide) (by rw [hu]; simp +decide)
  have S := IRuns.withPushI (I := I) (iprog := iprog) (splitL W) p t0 Bb hPO hv
    (by simp +decide [splitL]) ys R _ M
  rw [IState.upd_upd_same] at S
  refine S.mono (le_of_eq ?_)
  simp only [cSplit, splitL, List.length_cons, List.length_nil]
  omega

end Gen

