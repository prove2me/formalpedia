variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

theorem extB_g {g : κ → ι} (hg : Function.Injective g) (x : ι → Fin 2) (z : κ → Fin 2) (k : κ) :
    extB g x z (g k) = z k := by
  have h : ∃ k', g k' = g k := ⟨k, rfl⟩
