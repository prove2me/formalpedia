/-- A factor is distributed over a sum. -/
theorem mul_add (h₁ : Light.Sec3.Steps (fun θ => m θ * t₁ θ) B) (h₂ : Light.Sec3.Steps (fun θ => m θ * t₂ θ) B) :
    Light.Sec3.Steps (fun θ => m θ * (t₁ θ + t₂ θ)) B :=
  (h₁.add h₂).mono_left fun _ _ => (Nat.mul_add _ _ _).le

