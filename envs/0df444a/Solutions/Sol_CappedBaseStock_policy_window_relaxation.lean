noncomputable section
open Filter
open scoped BigOperators Topology

namespace CappedEndpointSubsequence

/-- Sum of the `L+1` inventory moments adjacent to an endpoint. -/
def block (u : ℕ → ℝ) (L T : ℕ) : ℝ :=
  ∑ k ∈ Finset.range (L + 1), u (T + k)

lemma block_nonneg (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) (L T : ℕ) :
    0 ≤ block u L T := by
  exact Finset.sum_nonneg (fun _ _ => hu _)

/-- Linear prefix growth controls the sums of all shifted endpoint blocks. -/
lemma sum_block_le (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ) (hC : 0 ≤ C)
    (hprefix : ∀ N, (∑ t ∈ Finset.range N, u t) ≤ C * N)
    (L N : ℕ) :
    (∑ t ∈ Finset.range N, block u L t) ≤
      (L + 1 : ℝ) * C * (N + L) := by
  unfold block
  rw [Finset.sum_comm]
  calc
    _ ≤ ∑ k ∈ Finset.range (L + 1), C * (N + L) := by
      apply Finset.sum_le_sum
      intro k hk
      have hkL : k ≤ L := by
        have := Finset.mem_range.mp hk
        omega
      have hshift : (∑ t ∈ Finset.range N, u (t + k)) ≤
          ∑ t ∈ Finset.range (N + k), u t := by
        have h := Finset.sum_range_add u k N
        have hnonneg : 0 ≤ ∑ t ∈ Finset.range k, u t :=
          Finset.sum_nonneg (fun _ _ => hu _)
        simpa only [Nat.add_comm, add_comm] using (le_add_of_nonneg_left hnonneg :
          (∑ t ∈ Finset.range N, u (k + t)) ≤
            (∑ t ∈ Finset.range k, u t) + ∑ t ∈ Finset.range N, u (k + t)) |>.trans_eq h.symm
      calc
        _ ≤ ∑ t ∈ Finset.range (N + k), u t := hshift
        _ ≤ C * (N + k : ℕ) := hprefix _
        _ ≤ C * (N + L) := by
          push_cast
          exact mul_le_mul_of_nonneg_left (by exact_mod_cast Nat.add_le_add_left hkL N) hC
    _ = _ := by simp; ring

/-- Endpoint blocks below a fixed bound occur beyond every prescribed cutoff. -/
lemma exists_bounded_block_ge (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ) (hC : 0 ≤ C)
    (hprefix : ∀ N, (∑ t ∈ Finset.range N, u t) ≤ C * N)
    (L N₀ : ℕ) :
    ∃ T, N₀ ≤ T ∧ block u L T ≤ 4 * ((L + 1 : ℝ) * C) + 1 := by
  by_contra! h
  let D : ℝ := (L + 1 : ℝ) * C
  have hD : 0 ≤ D := mul_nonneg (by positivity) hC
  let N : ℕ := 2 * (N₀ + L + 1)
  have hNN : N₀ ≤ N := by dsimp [N]; omega
  have hlower : (4 * D + 1) * ((N - N₀ : ℕ) : ℝ) ≤
      ∑ t ∈ Finset.range N, block u L t := by
    calc
      _ = ∑ t ∈ Finset.Ico N₀ N, (4 * D + 1) := by simp; ring
      _ ≤ ∑ t ∈ Finset.Ico N₀ N, block u L t := by
        apply Finset.sum_le_sum
        intro t ht
        exact (h t (Finset.mem_Ico.mp ht).1).le
      _ ≤ ∑ t ∈ Finset.range N, block u L t := by
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro t ht
          exact Finset.mem_range.mpr (Finset.mem_Ico.mp ht).2
        · intro t _ _
          exact block_nonneg u hu L t
  have hupper := sum_block_le u hu C hC hprefix L N
  change _ ≤ D * (N + L : ℝ) at hupper
  have hcast : (N : ℝ) = 2 * (N₀ + L + 1 : ℝ) := by dsimp [N]; push_cast; ring
  rw [Nat.cast_sub hNN] at hlower
  nlinarith [mul_nonneg hD (Nat.cast_nonneg (α := ℝ) N₀),
    mul_nonneg hD (Nat.cast_nonneg (α := ℝ) L)]

/-- A uniformly bounded endpoint-block subsequence, without any convergence assumptions on u. -/
lemma exists_strictMono_bounded_block (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ) (hC : 0 ≤ C)
    (hprefix : ∀ N, (∑ t ∈ Finset.range N, u t) ≤ C * N)
    (L : ℕ) :
    ∃ T : ℕ → ℕ, StrictMono T ∧ (∀ j, 0 < T j) ∧
      ∀ j, block u L (T j) ≤ 4 * ((L + 1 : ℝ) * C) + 1 := by
  obtain ⟨T, hmono, hT⟩ := Nat.exists_strictMono_subsequence
    (P := fun t => 0 < t ∧ block u L t ≤ 4 * ((L + 1 : ℝ) * C) + 1) (by
      intro N
      obtain ⟨t, ht, hbound⟩ := exists_bounded_block_ge u hu C hC hprefix L (N + 1)
      exact ⟨t, by omega, by omega, hbound⟩)
  exact ⟨T, hmono, fun j => (hT j).1, fun j => (hT j).2⟩

/-- Dividing the bounded endpoint blocks by their increasing horizons gives zero. -/
lemma exists_endpoint_subsequence (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ) (hC : 0 ≤ C)
    (hprefix : ∀ N, (∑ t ∈ Finset.range N, u t) ≤ C * N)
    (L : ℕ) :
    ∃ T : ℕ → ℕ, StrictMono T ∧ (∀ j, 0 < T j) ∧
      Tendsto (fun j => block u L (T j) / (T j : ℝ)) atTop (𝓝 0) := by
  obtain ⟨T, hmono, hpos, hbound⟩ := exists_strictMono_bounded_block u hu C hC hprefix L
  refine ⟨T, hmono, hpos, ?_⟩
  apply squeeze_zero (fun j => div_nonneg (block_nonneg u hu L _) (Nat.cast_nonneg _))
    (fun j => div_le_div_of_nonneg_right (hbound j) (Nat.cast_nonneg _))
  exact (tendsto_const_div_atTop_nhds_zero_nat (4 * ((L + 1 : ℝ) * C) + 1)).comp
    hmono.tendsto_atTop

/-- An eventual linear prefix bound can be made global by enlarging its constant. -/
lemma global_prefix_bound_of_eventually (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ)
    (hprefix : ∀ᶠ N in atTop, (∑ t ∈ Finset.range N, u t) ≤ C * N) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ N, (∑ t ∈ Finset.range N, u t) ≤ K * N := by
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp hprefix
  let A : ℝ := ∑ t ∈ Finset.range N₀, u t
  have hA : 0 ≤ A := Finset.sum_nonneg (fun _ _ => hu _)
  let K : ℝ := max C 0 + A
  have hK : 0 ≤ K := add_nonneg (le_max_right _ _) hA
  refine ⟨K, hK, fun N => ?_⟩
  by_cases hN : N₀ ≤ N
  · have hCK : C ≤ K := (le_max_left C 0).trans (le_add_of_nonneg_right hA)
    exact (hN₀ N hN).trans (mul_le_mul_of_nonneg_right hCK (Nat.cast_nonneg _))
  · have hsub : (∑ t ∈ Finset.range N, u t) ≤ A := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (by omega))
      intro t _ _
      exact hu t
    by_cases hzero : N = 0
    · subst N
      simp
    · have hAK : A ≤ K := le_add_of_nonneg_left (le_max_right C 0)
      have hNreal : (1 : ℝ) ≤ N := by exact_mod_cast (show 1 ≤ N by omega)
      exact hsub.trans (hAK.trans (by nlinarith))

/-- The endpoint subsequence needed for inventory averaging, assuming only eventual linear growth. -/
lemma exists_endpoint_subsequence_of_eventually (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (C : ℝ)
    (hprefix : ∀ᶠ N in atTop, (∑ t ∈ Finset.range N, u t) ≤ C * N)
    (L : ℕ) :
    ∃ T : ℕ → ℕ, StrictMono T ∧ (∀ j, 0 < T j) ∧
      Tendsto (fun j => block u L (T j) / (T j : ℝ)) atTop (𝓝 0) := by
  obtain ⟨K, hK, hglobal⟩ := global_prefix_bound_of_eventually u hu C hprefix
  exact exists_endpoint_subsequence u hu K hK hglobal L

/-- Every endpoint coordinate in the block is negligible on the selected horizons. -/
lemma endpoint_coordinate_tendsto_zero (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (L : ℕ) (T : ℕ → ℕ)
    (hlim : Tendsto (fun j => block u L (T j) / (T j : ℝ)) atTop (𝓝 0))
    (k : ℕ) (hk : k ≤ L) :
    Tendsto (fun j => u (T j + k) / (T j : ℝ)) atTop (𝓝 0) := by
  apply squeeze_zero (fun j => div_nonneg (hu _) (Nat.cast_nonneg _)) _ hlim
  intro j
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact Finset.single_le_sum (fun i _ => hu _) (Finset.mem_range.mpr (by omega))

lemma sum_shift_sub_sum (u : ℕ → ℝ) (N m : ℕ) :
    (∑ t ∈ Finset.range N, u (t + m)) - (∑ t ∈ Finset.range N, u t) =
      (∑ k ∈ Finset.range m, u (N + k)) - ∑ k ∈ Finset.range m, u k := by
  have hleft := Finset.sum_range_add u m N
  have hright := Finset.sum_range_add u N m
  rw [Nat.add_comm m N] at hleft
  simp only [Nat.add_comm m] at hleft
  linarith

/-- Shifting the averaging window by at most L+1 does not change its subsequential limit. -/
lemma shifted_average_sub_tendsto_zero (u : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n)
    (L : ℕ) (T : ℕ → ℕ) (hT : Tendsto T atTop atTop)
    (hlim : Tendsto (fun j => block u L (T j) / (T j : ℝ)) atTop (𝓝 0))
    (m : ℕ) (hm : m ≤ L + 1) :
    Tendsto (fun j =>
      (∑ t ∈ Finset.range (T j), u (t + m)) / (T j : ℝ) -
        (∑ t ∈ Finset.range (T j), u t) / (T j : ℝ)) atTop (𝓝 0) := by
  have hend : Tendsto (fun j => (∑ k ∈ Finset.range m, u (T j + k)) / (T j : ℝ))
      atTop (𝓝 0) := by
    apply squeeze_zero
      (fun j => div_nonneg (Finset.sum_nonneg (fun _ _ => hu _)) (Nat.cast_nonneg _)) _ hlim
    intro j
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hm) (fun _ _ _ => hu _)
  have hstart := (tendsto_const_div_atTop_nhds_zero_nat
    (∑ k ∈ Finset.range m, u k)).comp hT
  have hsub := hend.sub hstart
  simp only [sub_zero] at hsub
  convert hsub using 1
  funext j
  rw [← sub_div, sum_shift_sub_sum u (T j) m, sub_div]
  rfl

end CappedEndpointSubsequence
