section ComplexFamiliesAdelic

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

p2m_open "Complex Function.Complex"

private def ofComplexGL : GL (Fin 2) ℂ →* GL (Fin 2) w.Completion :=
  Units.map (RingHom.mapMatrix (ringEquivComplexOfIsComplex hw).symm.toRingHom).toMonoidHom

omit [NumberField F] in
private theorem ofComplexGL_coe (k : GL (Fin 2) ℂ) (i j : Fin 2) :
    ((ofComplexGL hw k : GL (Fin 2) w.Completion) : Matrix (Fin 2) (Fin 2) w.Completion) i j
      = (ringEquivComplexOfIsComplex hw).symm ((k : Matrix (Fin 2) (Fin 2) ℂ) i j) := rfl

omit [NumberField F] in

private theorem norm_ringEquivComplexOfIsComplex_symm (z : ℂ) :
    ‖(ringEquivComplexOfIsComplex hw).symm z‖ = ‖z‖ := by
  conv_rhs => rw [← RingEquiv.apply_symm_apply (ringEquivComplexOfIsComplex hw) z]
  rw [ringEquivComplexOfIsComplex_apply,
    (isometry_extensionEmbedding w).norm_map_of_map_zero (map_zero _)]

omit [NumberField F] in

private theorem isRowIsometry_ofComplexGL {k : GL (Fin 2) ℂ} (hk : IsRowIsometry k) :
    IsRowIsometry (ofComplexGL hw k) := by
  obtain ⟨hdet, hrow⟩ := hk
  constructor
  · rw [Matrix.det_fin_two]
    simp only [ofComplexGL_coe, ← map_mul, ← map_sub]
    rw [norm_ringEquivComplexOfIsComplex_symm hw, ← Matrix.det_fin_two, hdet]
  · intro x y
    obtain ⟨x', rfl⟩ := (ringEquivComplexOfIsComplex hw).symm.surjective x
    obtain ⟨y', rfl⟩ := (ringEquivComplexOfIsComplex hw).symm.surjective y
    simp only [ofComplexGL_coe, ← map_mul, ← map_add, norm_ringEquivComplexOfIsComplex_symm hw]
    exact hrow x' y'

omit [NumberField F] in
private theorem continuous_ofComplexGL : Continuous (ofComplexGL hw) := by
  have hcont : Continuous (ringEquivComplexOfIsComplex hw).symm :=
    (AddMonoidHomClass.isometry_of_norm (ringEquivComplexOfIsComplex hw).symm.toRingHom
      (norm_ringEquivComplexOfIsComplex_symm hw)).continuous
  rw [Units.continuous_iff]
  exact ⟨continuous_matrix fun i j => hcont.comp (Units.continuous_val.matrix_elem i j),
    continuous_matrix fun i j => hcont.comp (Units.continuous_coe_inv.matrix_elem i j)⟩

private def dPhiW (t : ℝ) : AdelicGL2 (𝓞 F) F := adelicArchGLInclAt F w (ofComplexGL hw (dPhiGL t))

private def rhoCW (t : ℝ) : AdelicGL2 (𝓞 F) F := adelicArchGLInclAt F w (ofComplexGL hw (rotGLC t))

private theorem dPhiW_mem (t : ℝ) : dPhiW hw t ∈ archRowIsometrySubgroup F w :=
  Subgroup.mem_map.2 ⟨ofComplexGL hw (dPhiGL t), isRowIsometry_ofComplexGL hw
    (isRowIsometry_dPhiGL t), rfl⟩

private theorem rhoCW_mem (t : ℝ) : rhoCW hw t ∈ archRowIsometrySubgroup F w :=
  Subgroup.mem_map.2 ⟨ofComplexGL hw (rotGLC t), isRowIsometry_ofComplexGL hw
    (isRowIsometry_rotGLC t), rfl⟩

private theorem dPhiW_zero : dPhiW hw 0 = 1 := by rw [dPhiW, dPhiGL_zero, map_one, map_one]

private theorem rhoCW_zero : rhoCW hw 0 = 1 := by rw [rhoCW, rotGLC_zero, map_one, map_one]

private theorem dPhiW_add (s t : ℝ) : dPhiW hw (s + t) = dPhiW hw s * dPhiW hw t := by
  rw [dPhiW, dPhiGL_add, map_mul, map_mul]
  rfl

private theorem rhoCW_add (s t : ℝ) : rhoCW hw (s + t) = rhoCW hw s * rhoCW hw t := by
  rw [rhoCW, rotGLC_add, map_mul, map_mul]
  rfl

private theorem continuous_dPhiW : Continuous (dPhiW hw) :=
  (PlaceSplit.continuous_adelicArchGLInclAt F w).comp ((continuous_ofComplexGL hw).comp
    (by rw [Units.continuous_iff]; exact ⟨continuous_dPhiMat, continuous_dPhiMat.comp
      continuous_neg⟩))

private theorem continuous_rhoCW : Continuous (rhoCW hw) :=
  (PlaceSplit.continuous_adelicArchGLInclAt F w).comp ((continuous_ofComplexGL hw).comp
    continuous_rotGLC)

private theorem dPhiW_periodic : Function.Periodic (dPhiW hw) (2 * Real.pi) := fun t => by
  rw [dPhiW, dPhiW, dPhiGL_periodic t]

private theorem rhoCW_periodic : Function.Periodic (rhoCW hw) (2 * Real.pi) := fun t => by
  rw [rhoCW, rhoCW, rotGLC_periodic t]

private theorem rightTranslatesSpanFinite_mul {G : Type*} [Group G] {K : Subgroup G} {φ : G → ℂ}
    (h : RightTranslatesSpanFinite K φ) {g : G} (hg : g ∈ K) :
    RightTranslatesSpanFinite K (fun x => φ (x * g)) := by
  obtain ⟨s, hs⟩ := h
  exact ⟨s, fun k hk => by
    have h2 : (fun x => φ (x * k * g)) = fun x => φ (x * (k * g)) := by
      funext x; rw [mul_assoc]
    exact h2 ▸ hs (k * g) (K.mul_mem hk hg)⟩

private theorem exists_expansion_triple {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφc : Continuous φ)
    (hKf : IsArchKFiniteAt F w φ) :
    ∃ (N : ℕ) (kv : Fin N → AdelicGL2 (𝓞 F) F) (a b c : Fin N → ℝ → ℂ),
      (∀ i, kv i ∈ archRowIsometrySubgroup F w) ∧
      (∀ i, ContDiff ℝ ∞ (a i) ∧ ContDiff ℝ ∞ (b i) ∧ ContDiff ℝ ∞ (c i)) ∧
      (∀ i j, ∃ C, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ C ∧ ‖iteratedDeriv j (b i) θ‖ ≤ C ∧
        ‖iteratedDeriv j (c i) θ‖ ≤ C) ∧
      ∀ (α β γ : ℝ) (x : AdelicGL2 (𝓞 F) F),
        φ (x * dPhiW hw α * rhoCW hw β * dPhiW hw γ)
          = ∑ i, a i α * b i β * c i γ * φ (x * kv i) := by

  obtain ⟨n₁, kv₁, c₁, hkv₁, hc₁s, -, hc₁C, hexp₁⟩ := SpanRep.exists_expansion
    (archRowIsometrySubgroup F w) φ hφc hKf (dPhiW hw) (dPhiW_mem hw) (dPhiW_zero hw)
    (dPhiW_add hw) (continuous_dPhiW hw) Real.two_pi_pos (dPhiW_periodic hw)

  have hK₂ : ∀ l : Fin n₁, IsArchKFiniteAt F w (fun x => φ (x * kv₁ l)) :=
    fun l => rightTranslatesSpanFinite_mul hKf (hkv₁ l)
  have hc₂' : ∀ l : Fin n₁, Continuous (fun x => φ (x * kv₁ l)) :=
    fun l => hφc.comp (continuous_mul_const _)
  choose n₂ kv₂ c₂ hkv₂ hc₂s hc₂per hc₂C hexp₂ using fun l : Fin n₁ => SpanRep.exists_expansion
    (archRowIsometrySubgroup F w) _ (hc₂' l) (hK₂ l) (rhoCW hw) (rhoCW_mem hw) (rhoCW_zero hw)
    (rhoCW_add hw) (continuous_rhoCW hw) Real.two_pi_pos (rhoCW_periodic hw)

  have hK₃ : ∀ (l : Fin n₁) (j : Fin (n₂ l)),
      IsArchKFiniteAt F w (fun x => φ (x * (kv₂ l j * kv₁ l))) := fun l j =>
    rightTranslatesSpanFinite_mul hKf ((archRowIsometrySubgroup F w).mul_mem (hkv₂ l j) (hkv₁ l))
  have hc₃' : ∀ (l : Fin n₁) (j : Fin (n₂ l)), Continuous (fun x => φ (x * (kv₂ l j * kv₁ l))) :=
    fun l j => hφc.comp (continuous_mul_const _)
  choose n₃ kv₃ c₃ hkv₃ hc₃s hc₃per hc₃C hexp₃ using fun (l : Fin n₁) (j : Fin (n₂ l)) =>
    SpanRep.exists_expansion (archRowIsometrySubgroup F w) _ (hc₃' l j) (hK₃ l j) (dPhiW hw)
      (dPhiW_mem hw) (dPhiW_zero hw) (dPhiW_add hw) (continuous_dPhiW hw) Real.two_pi_pos
      (dPhiW_periodic hw)

  let S := Σ l : Fin n₁, Σ j : Fin (n₂ l), Fin (n₃ l j)
  obtain ⟨N, e⟩ : ∃ N : ℕ, Nonempty (S ≃ Fin N) := ⟨Fintype.card S, ⟨Fintype.equivFin S⟩⟩
  obtain ⟨e⟩ := e
  refine ⟨N, fun i => kv₃ (e.symm i).1 (e.symm i).2.1 (e.symm i).2.2 * (kv₂ (e.symm i).1
      (e.symm i).2.1 * kv₁ (e.symm i).1),
    fun i => c₃ (e.symm i).1 (e.symm i).2.1 (e.symm i).2.2,
    fun i => c₂ (e.symm i).1 (e.symm i).2.1,
    fun i => c₁ (e.symm i).1, ?_, ?_, ?_, ?_⟩
  · intro i
    exact (archRowIsometrySubgroup F w).mul_mem (hkv₃ _ _ _)
      ((archRowIsometrySubgroup F w).mul_mem (hkv₂ _ _) (hkv₁ _))
  · exact fun i => ⟨hc₃s _ _ _, hc₂s _ _, hc₁s _⟩
  · intro i j
    obtain ⟨Ca, hCa⟩ := hc₃C (e.symm i).1 (e.symm i).2.1 (e.symm i).2.2 j
    obtain ⟨Cb, hCb⟩ := hc₂C (e.symm i).1 (e.symm i).2.1 j
    obtain ⟨Cc, hCc⟩ := hc₁C (e.symm i).1 j
    exact ⟨max Ca (max Cb Cc), fun θ => ⟨(hCa θ).trans (le_max_left _ _),
      (hCb θ).trans ((le_max_left _ _).trans (le_max_right _ _)),
      (hCc θ).trans ((le_max_right _ _).trans (le_max_right _ _))⟩⟩
  · intro α β γ x
    rw [show x * dPhiW hw α * rhoCW hw β * dPhiW hw γ
        = (x * dPhiW hw α * rhoCW hw β) * dPhiW hw γ by group]
    rw [hexp₁ γ (x * dPhiW hw α * rhoCW hw β)]
    have step2 : ∀ l : Fin n₁, φ (x * dPhiW hw α * rhoCW hw β * kv₁ l)
        = ∑ j, c₂ l j β * φ (x * dPhiW hw α * (kv₂ l j * kv₁ l)) := by
      intro l
      have h := hexp₂ l β (x * dPhiW hw α)
      simp only [mul_assoc] at h ⊢
      exact h
    have step3 : ∀ (l : Fin n₁) (j : Fin (n₂ l)), φ (x * dPhiW hw α * (kv₂ l j * kv₁ l))
        = ∑ i, c₃ l j i α * φ (x * (kv₃ l j i * (kv₂ l j * kv₁ l))) := by
      intro l j
      have h := hexp₃ l j α x
      simp only [mul_assoc] at h ⊢
      exact h
    simp only [step2, step3, Finset.mul_sum]
    have h1 : (∑ i : Fin N, c₃ (e.symm i).1 (e.symm i).2.1 (e.symm i).2.2 α
          * c₂ (e.symm i).1 (e.symm i).2.1 β * c₁ (e.symm i).1 γ
          * φ (x * (kv₃ (e.symm i).1 (e.symm i).2.1 (e.symm i).2.2
              * (kv₂ (e.symm i).1 (e.symm i).2.1 * kv₁ (e.symm i).1))))
        = ∑ p : S, c₃ p.1 p.2.1 p.2.2 α * c₂ p.1 p.2.1 β * c₁ p.1 γ
            * φ (x * (kv₃ p.1 p.2.1 p.2.2 * (kv₂ p.1 p.2.1 * kv₁ p.1))) :=
      Equiv.sum_comp e.symm (fun p : S => c₃ p.1 p.2.1 p.2.2 α * c₂ p.1 p.2.1 β * c₁ p.1 γ
        * φ (x * (kv₃ p.1 p.2.1 p.2.2 * (kv₂ p.1 p.2.1 * kv₁ p.1))))
    rw [h1, ← Finset.univ_sigma_univ, Finset.sum_sigma]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [← Finset.univ_sigma_univ, Finset.sum_sigma]
    exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring

private theorem exists_expansion_duo {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφc : Continuous φ)
    (hKf : IsArchKFiniteAt F w φ) :
    ∃ (N : ℕ) (kv : Fin N → AdelicGL2 (𝓞 F) F) (a b : Fin N → ℝ → ℂ),
      (∀ i, kv i ∈ archRowIsometrySubgroup F w) ∧
      (∀ i, ContDiff ℝ ∞ (a i) ∧ ContDiff ℝ ∞ (b i)) ∧
      (∀ i j, ∃ C, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ C ∧ ‖iteratedDeriv j (b i) θ‖ ≤ C) ∧
      ∀ (α β : ℝ) (x : AdelicGL2 (𝓞 F) F),
        φ (x * dPhiW hw α * rhoCW hw β)
          = ∑ i, a i α * b i β * φ (x * kv i) := by

  obtain ⟨n₁, kv₁, c₁, hkv₁, hc₁s, -, hc₁C, hexp₁⟩ := SpanRep.exists_expansion
    (archRowIsometrySubgroup F w) φ hφc hKf (rhoCW hw) (rhoCW_mem hw) (rhoCW_zero hw)
    (rhoCW_add hw) (continuous_rhoCW hw) Real.two_pi_pos (rhoCW_periodic hw)

  have hK₂ : ∀ l : Fin n₁, IsArchKFiniteAt F w (fun x => φ (x * kv₁ l)) :=
    fun l => rightTranslatesSpanFinite_mul hKf (hkv₁ l)
  have hc₂' : ∀ l : Fin n₁, Continuous (fun x => φ (x * kv₁ l)) :=
    fun l => hφc.comp (continuous_mul_const _)
  choose n₂ kv₂ c₂ hkv₂ hc₂s hc₂per hc₂C hexp₂ using fun l : Fin n₁ => SpanRep.exists_expansion
    (archRowIsometrySubgroup F w) _ (hc₂' l) (hK₂ l) (dPhiW hw) (dPhiW_mem hw) (dPhiW_zero hw)
    (dPhiW_add hw) (continuous_dPhiW hw) Real.two_pi_pos (dPhiW_periodic hw)
  let S := Σ l : Fin n₁, Fin (n₂ l)
  obtain ⟨N, e⟩ : ∃ N : ℕ, Nonempty (S ≃ Fin N) := ⟨Fintype.card S, ⟨Fintype.equivFin S⟩⟩
  obtain ⟨e⟩ := e
  refine ⟨N, fun i => kv₂ (e.symm i).1 (e.symm i).2 * kv₁ (e.symm i).1,
    fun i => c₂ (e.symm i).1 (e.symm i).2, fun i => c₁ (e.symm i).1, ?_, ?_, ?_, ?_⟩
  · exact fun i => (archRowIsometrySubgroup F w).mul_mem (hkv₂ _ _) (hkv₁ _)
  · exact fun i => ⟨hc₂s _ _, hc₁s _⟩
  · intro i j
    obtain ⟨Ca, hCa⟩ := hc₂C (e.symm i).1 (e.symm i).2 j
    obtain ⟨Cb, hCb⟩ := hc₁C (e.symm i).1 j
    exact ⟨max Ca Cb, fun θ => ⟨(hCa θ).trans (le_max_left _ _),
      (hCb θ).trans (le_max_right _ _)⟩⟩
  · intro α β x
    rw [hexp₁ β (x * dPhiW hw α)]
    have step2 : ∀ l : Fin n₁, φ (x * dPhiW hw α * kv₁ l)
        = ∑ j, c₂ l j α * φ (x * (kv₂ l j * kv₁ l)) := by
      intro l
      have h := hexp₂ l α x
      simp only [mul_assoc] at h ⊢
      exact h
    simp only [step2, Finset.mul_sum]
    have h1 : (∑ i : Fin N, c₂ (e.symm i).1 (e.symm i).2 α * c₁ (e.symm i).1 β
          * φ (x * (kv₂ (e.symm i).1 (e.symm i).2 * kv₁ (e.symm i).1)))
        = ∑ p : S, c₂ p.1 p.2 α * c₁ p.1 β * φ (x * (kv₂ p.1 p.2 * kv₁ p.1)) :=
      Equiv.sum_comp e.symm (fun p : S => c₂ p.1 p.2 α * c₁ p.1 β
        * φ (x * (kv₂ p.1 p.2 * kv₁ p.1)))
    rw [h1, ← Finset.univ_sigma_univ, Finset.sum_sigma]
    exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun j _ => by ring

private theorem exists_expansion_penta {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφc : Continuous φ)
    (hKf : IsArchKFiniteAt F w φ) :
    ∃ (N : ℕ) (kv : Fin N → AdelicGL2 (𝓞 F) F) (a b c d e : Fin N → ℝ → ℂ),
      (∀ i, kv i ∈ archRowIsometrySubgroup F w) ∧
      (∀ i, ContDiff ℝ ∞ (a i) ∧ ContDiff ℝ ∞ (b i) ∧ ContDiff ℝ ∞ (c i) ∧
        ContDiff ℝ ∞ (d i) ∧ ContDiff ℝ ∞ (e i)) ∧
      (∀ i j, ∃ C, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ C ∧ ‖iteratedDeriv j (b i) θ‖ ≤ C ∧
        ‖iteratedDeriv j (c i) θ‖ ≤ C ∧ ‖iteratedDeriv j (d i) θ‖ ≤ C ∧
        ‖iteratedDeriv j (e i) θ‖ ≤ C) ∧
      ∀ (α β γ δ ε : ℝ) (x : AdelicGL2 (𝓞 F) F),
        φ (x * dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε)
          = ∑ i, a i α * b i β * c i γ * d i δ * e i ε * φ (x * kv i) := by

  obtain ⟨N₁, kv₁, a₁, b₁, c₁, hkv₁, hs₁, hC₁, hexp₁⟩ := exists_expansion_triple hw hφc hKf

  have hK₂ : ∀ l : Fin N₁, IsArchKFiniteAt F w (fun x => φ (x * kv₁ l)) :=
    fun l => rightTranslatesSpanFinite_mul hKf (hkv₁ l)
  have hc₂' : ∀ l : Fin N₁, Continuous (fun x => φ (x * kv₁ l)) :=
    fun l => hφc.comp (continuous_mul_const _)
  choose N₂ kv₂ A₂ B₂ hkv₂ hs₂ hC₂ hexp₂ using fun l : Fin N₁ =>
    exists_expansion_duo hw (hc₂' l) (hK₂ l)
  let S := Σ l : Fin N₁, Fin (N₂ l)
  obtain ⟨N, e⟩ : ∃ N : ℕ, Nonempty (S ≃ Fin N) := ⟨Fintype.card S, ⟨Fintype.equivFin S⟩⟩
  obtain ⟨e⟩ := e
  refine ⟨N, fun i => kv₂ (e.symm i).1 (e.symm i).2 * kv₁ (e.symm i).1,
    fun i => A₂ (e.symm i).1 (e.symm i).2, fun i => B₂ (e.symm i).1 (e.symm i).2,
    fun i => a₁ (e.symm i).1, fun i => b₁ (e.symm i).1, fun i => c₁ (e.symm i).1,
    ?_, ?_, ?_, ?_⟩
  · exact fun i => (archRowIsometrySubgroup F w).mul_mem (hkv₂ _ _) (hkv₁ _)
  · exact fun i => ⟨(hs₂ _ _).1, (hs₂ _ _).2, (hs₁ _).1, (hs₁ _).2.1, (hs₁ _).2.2⟩
  · intro i j
    obtain ⟨Ca, hCa⟩ := hC₂ (e.symm i).1 (e.symm i).2 j
    obtain ⟨Cb, hCb⟩ := hC₁ (e.symm i).1 j
    exact ⟨max Ca Cb, fun θ => ⟨((hCa θ).1).trans (le_max_left _ _),
      ((hCa θ).2).trans (le_max_left _ _), ((hCb θ).1).trans (le_max_right _ _),
      ((hCb θ).2.1).trans (le_max_right _ _), ((hCb θ).2.2).trans (le_max_right _ _)⟩⟩
  · intro α β γ δ ε x
    have hbase : φ (x * dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε)
        = ∑ l, a₁ l γ * b₁ l δ * c₁ l ε * φ (x * dPhiW hw α * rhoCW hw β * kv₁ l) :=
      hexp₁ γ δ ε (x * dPhiW hw α * rhoCW hw β)
    rw [hbase]
    have step2 : ∀ l : Fin N₁, φ (x * dPhiW hw α * rhoCW hw β * kv₁ l)
        = ∑ j, A₂ l j α * B₂ l j β * φ (x * (kv₂ l j * kv₁ l)) := by
      intro l
      have h := hexp₂ l α β x
      simp only [mul_assoc] at h ⊢
      exact h
    simp only [step2, Finset.mul_sum]
    have h1 : (∑ i : Fin N, A₂ (e.symm i).1 (e.symm i).2 α * B₂ (e.symm i).1 (e.symm i).2 β
          * a₁ (e.symm i).1 γ * b₁ (e.symm i).1 δ * c₁ (e.symm i).1 ε
          * φ (x * (kv₂ (e.symm i).1 (e.symm i).2 * kv₁ (e.symm i).1)))
        = ∑ p : S, A₂ p.1 p.2 α * B₂ p.1 p.2 β * a₁ p.1 γ * b₁ p.1 δ * c₁ p.1 ε
            * φ (x * (kv₂ p.1 p.2 * kv₁ p.1)) :=
      Equiv.sum_comp e.symm (fun p : S => A₂ p.1 p.2 α * B₂ p.1 p.2 β * a₁ p.1 γ * b₁ p.1 δ
        * c₁ p.1 ε * φ (x * (kv₂ p.1 p.2 * kv₁ p.1)))
    rw [h1, ← Finset.univ_sigma_univ, Finset.sum_sigma]
    exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun j _ => by ring

end ComplexFamiliesAdelic
