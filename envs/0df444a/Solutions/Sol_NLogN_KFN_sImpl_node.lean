theorem sImplI_of_rImplI_roleDiag (hW : 0 < W) (hs : SLaws st n) (ha : ∀ i, 2 * st i ∣ n)
    (hr : 0 < r) {T : Butterfly.Op (Fin m × κ)} {code : ℕ → IStmt HS Pp} {e dw : ℕ}
    {cost : ℕ → ℕ}
    (h : RImplI (W := W) I iprog r n st (roleDiag T : NOp W (Fin m × κ)) code e dw cost) :
    SImplI I iprog r st (W * n) T code e dw cost := by
  intro s f zs l xs F w hC h0 hx hl hb
  set X : Fin W → List (Fin r → ℂ) := fun v => (xs.drop (v.val * n)).take n with hXd
  have hX : ∀ v, (X v).length = n := by
    intro v; simp only [hXd, List.length_take, List.length_drop, hl]
    apply Nat.min_eq_left
    have := v.isLt
    have : (v.val + 1) * n ≤ W * n := Nat.mul_le_mul_right _ this
    rw [Nat.succ_mul] at this; omega
  have hxs : xs = flatR X := by
    apply List.ext_getElem (by rw [hl, length_flatR hX])
    intro J h1 h2
    rw [hl] at h1
    have hn0 : 0 < n := by
      rcases Nat.eq_zero_or_pos n with h | h
      · simp [h] at h1
      · exact h
    set v : Fin W := ⟨J / n, by rw [Nat.div_lt_iff_lt_mul hn0]; linarith⟩
    have hJ : J = v.val * n + J % n := by simp only [v]; rw [mul_comm, Nat.div_add_mod]
    have hjn : J % n < n := Nat.mod_lt _ hn0
    rw [← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0]
    conv_rhs => rw [hJ]
    rw [getD_flatR hX 0 v hjn]
    simp only [hXd, List.getD_eq_getElem?_getD, List.getElem?_take, List.getElem?_drop, if_pos hjn]
    rw [← hJ]
  rw [hxs] at hx
  obtain ⟨zs', r1, b1, f1⟩ := h s f zs l X F w hC h0 hx hX hb
  refine ⟨zs', ?_, b1, f1⟩
  rw [hxs, selOpF_flatR hs ha T hX, ← roleOpF_roleDiag]
