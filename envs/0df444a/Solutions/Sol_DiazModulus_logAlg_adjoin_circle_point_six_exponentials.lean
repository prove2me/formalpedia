open Complex ComplexConjugate

/-! # The six exponentials theorem for `ℒ_u = ℒ + ℚu + ℚū`, unconditionally

Let `F` be the field generated by `ℒ̃`, so `Q̄ ≤ F` and `ρ = uū ∈ F`. Take `ℚ`-independent `x₀, x₁`
and `y₀, y₁, y₂` with all six products in `ℒ_u`.
1. Both families are `Q̄`-independent. A `Q̄`-relation `∑ gᵢ xᵢ = 0` gives `∑ gᵢ (xᵢ y₀) = 0`, a
   vanishing linear form with algebraic coefficients in the `ℚ`-independent elements `xᵢ y₀` of
   `ℒ_u`; Baker for `ℒ_u` (`logAlg_adjoin_circle_point_baker_linear_forms`) forbids it. The same
   with `x₀ yⱼ` for `y`.
2. By `mem_logAlg_adjoin_circle_point_iff`, `ℒ_u ⊆ ℒ̃ + Q̄u + Q̄ū ⊆ ℒ̃ + Q̄u + Q̄u⁻¹` (as `ū = ρu⁻¹`),
   so `rank_one_config_inverse_adjoin` with `K = Q̄` and `V₀ = ℒ̃` puts every `xᵢ yⱼ` in `ℒ̃ ⊆ F`.
3. Write `xᵢ yⱼ = c + pu + qū` with `c ∈ ℒ`, `p, q ∈ ℚ`. If `(p, q) ≠ 0`, the element is
   transcendental over `F` (`transcendental_add_mul_add_mul_conj`), yet it lies in `F`. So it lies
   in `ℒ`: all six `exp (xᵢ yⱼ)` are algebraic, against `six_exponentials`.
Roy's theorem is not used.
-/

namespace R19_S6
open DiazModulus

/-- If the products `vᵢ w` (with `w ≠ 0`) are `ℚ`-independent elements of `ℒ_u`, then `v` is
`Q̄`-independent: a `Q̄`-relation on `v` is a vanishing algebraic linear form in the `vᵢ w`,
which Baker for `ℒ_u` excludes. -/
theorem qbar_linearIndependent {n : ℕ} (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u)
    (v : Fin n → ℂ) (hv : LinearIndependent ℚ v) (w : ℂ) (hw : w ≠ 0)
    (hvw : ∀ i, v i * w ∈
      (Submodule.span ℚ LogAlg ⊔ Submodule.span ℚ ({u, conj u} : Set ℂ))) :
    LinearIndependent Qbar v := by
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  by_contra hgi
  have hl : LinearIndependent ℚ (fun i => v i * w) :=
    hv.map' (LinearMap.mulRight ℚ w) (LinearMap.ker_eq_bot.mpr (mul_left_injective₀ hw))
  refine logAlg_adjoin_circle_point_baker_linear_forms u hρ hu n (fun i => v i * w) hl hvw 0
    (fun i => (g i : ℂ)) isAlgebraic_zero (fun i => mem_Qbar_iff.mp (g i).2)
    (Or.inr ⟨i, fun h => hgi (Subtype.ext h)⟩) ?_
  have h0 : (∑ i, g i • v i) * w = 0 := by rw [hg, zero_mul]
  rw [Finset.sum_mul] at h0
  simpa [Subfield.smul_def, mul_assoc] using h0

end R19_S6

open DiazModulus R19_S6 in
theorem solution
    (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u) :
    ¬ ∃ (x : Fin 2 → ℂ) (y : Fin 3 → ℂ), LinearIndependent ℚ x ∧ LinearIndependent ℚ y ∧
      ∀ i j, x i * y j ∈ (Submodule.span ℚ LogAlg ⊔ Submodule.span ℚ ({u, conj u} : Set ℂ)) := by
  rintro ⟨x, y, hx, hy, hxy⟩
  have hV : ∀ v ∈ LogAlgTilde, v ∈ Subfield.closure (LogAlgTilde : Set ℂ) :=
    fun v hv => Subfield.subset_closure hv
  have hKF : Qbar ≤ Subfield.closure (LogAlgTilde : Set ℂ) := fun q hq => hV q (by
    have := Submodule.smul_mem LogAlgTilde (⟨q, hq⟩ : Qbar)
      (Submodule.subset_span (Set.mem_insert 1 LogAlg))
    simpa [Subfield.smul_def] using this)
  -- Step 1: `Q̄`-independence, by Baker for `ℒ_u`.
  have hx' : LinearIndependent Qbar x :=
    qbar_linearIndependent u hρ hu x hx (y 0) (hy.ne_zero 0) fun i => hxy i 0
  have hy' : LinearIndependent Qbar y :=
    qbar_linearIndependent u hρ hu y hy (x 0) (hx.ne_zero 0) fun j => by
      rw [mul_comm]; exact hxy 0 j
  -- Step 2: the products lie in `ℒ̃`.
  have hu0 : u ≠ 0 := fun h => hu (h ▸ isAlgebraic_zero)
  have hle : Submodule.span Qbar ({u, conj u} : Set ℂ) ≤
      Submodule.span Qbar ({u, u⁻¹} : Set ℂ) := by
    rw [Submodule.span_le]
    rintro z (rfl | rfl)
    · exact Submodule.subset_span (Set.mem_insert _ _)
    · have := Submodule.smul_mem (Submodule.span Qbar ({u, u⁻¹} : Set ℂ))
        (⟨_, mem_Qbar_iff.mpr hρ⟩ : Qbar)
        (Submodule.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton u⁻¹)))
      rwa [Subfield.smul_def, smul_eq_mul, show u * conj u * u⁻¹ = conj u by field_simp] at this
  have hM1 := mem_logAlg_adjoin_circle_point_iff u
  have hin : ∀ i j, x i * y j ∈ LogAlgTilde :=
    rank_one_config_inverse_adjoin Qbar _ hKF LogAlgTilde hV u hu x y hx' hy' fun i j => by
      have h1 := Submodule.subset_span (R := Qbar) (Set.mem_insert_of_mem 1 (hxy i j))
      rw [hM1.2] at h1
      exact sup_le_sup_left hle _ h1
  -- Step 3: the products lie in `ℒ`, against the six exponentials theorem.
  obtain ⟨i, j, hij⟩ := six_exponentials x y hx hy
  obtain ⟨c, hc, p, q, hz⟩ := (hM1.1 _).mp (hxy i j)
  by_cases hpq : p = 0 ∧ q = 0
  · rw [hpq.1, hpq.2, Rat.cast_zero, zero_mul, zero_mul, add_zero, add_zero] at hz
    exact hij (hz ▸ hc)
  · have ht := transcendental_add_mul_add_mul_conj _ u hu (hKF (mem_Qbar_iff.mpr hρ)) c p q
      (hV c (Submodule.subset_span (Set.mem_insert_of_mem 1 hc)))
      (SubfieldClass.ratCast_mem _ p) (SubfieldClass.ratCast_mem _ q)
      ((not_and_or.mp hpq).imp Rat.cast_ne_zero.mpr Rat.cast_ne_zero.mpr)
    rw [← hz] at ht
    exact ht (isAlgebraic_algebraMap (⟨_, hV _ (hin i j)⟩ : Subfield.closure (LogAlgTilde : Set ℂ)))
