open AlgebraicCurve ModularCurve ModularCurve.FullLevel GenusFieldBarQ2

theorem solution
    (q : ℕ) [Fact q.Prime] (hq2 : q = 2) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M') :
    (AlgebraicCurve.genusFF (AlgebraicClosure ℚ) ↥(fieldBar q M') : ℚ) =
      1 + (q : ℚ) * ((q : ℚ) ^ 2 - 1) * dedekindPsi M' / 12 -
        ((q : ℚ) ^ 2 - 1) * ((∑ d ∈ M'.divisors, Nat.totient (Nat.gcd d (M' / d)) : ℕ) : ℚ) / 2 := by
  subst hq2
  have h1 : (genusFF (AlgebraicClosure ℚ) ↥(fieldBar 2 M') : ℚ) =
      (genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar (2 ^ 2 * M')) : ℚ) :=
    congrArg (fun X : IntermediateField (AlgebraicClosure ℚ) (LaurentSeries (AlgebraicClosure ℚ)) =>
      (genusFF (AlgebraicClosure ℚ) ↥X : ℚ)) (fieldBar_two M')
  rw [h1, genusFF_modularFunctionFieldBar, genusFormula_sq_mul M' hqM',
    show (∑ d ∈ M'.divisors, Nat.totient (Nat.gcd d (M' / d))) = cuspCount M' from rfl]
  push_cast
  ring

end S_ModularCurve_FullLevel_genusFF_fieldBar_eq_of_eq_two
