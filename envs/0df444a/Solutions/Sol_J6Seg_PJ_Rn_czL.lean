set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-- **A conditional** on an `E` test. -/
theorem Rn.iteE {W : ℕ} {v : Vr} {c : Cs} {e : E} (ho : e.ok = true) (hl : e.lb ≤ 2 ^ W)
    (hv : BV W v) {a b : RS} {Q : Vr → Prop} {c' : Cs} {ca cb : ℕ}
    (ha : e.den v < 0 → Rn a v c Q c' ca) (hb : ¬ e.den v < 0 → Rn b v c Q c' cb) :
    Rn (.ite e.ex a b) v c Q c' (cIte e W + max ca cb) := by
  have hev : ∀ s : IState HS, e.ex.eval (encK s (RF v c)) = e.den v := fun s => by
    rw [eval_RF (E.Rd_ex ho), E.ev_ex e ho]
  have hBd : ∀ s : IState HS, e.ex.Bnd (encK s (RF v c)) ((W + 1) * (2 * e.ex.size)) := fun s =>
    bnd_RF (E.Rd_ex ho) (E.RB_ex ho hv) (mg_lt (E.tame_ex e hl))
  have hok : ∀ s : IState HS, e.ex.ok (encK s (RF v c)) := fun s => ok_RF (E.Rd_ex ho) (E.okR_ex e ho)
  by_cases hneg : e.den v < 0
  · obtain ⟨v', hQ, hS⟩ := ha hneg
    refine ⟨v', hQ, fun s => ?_⟩
    have h1 := pushCost_le e.ex _ _ (hBd s)
    have h2 := Ex.zsz_eval_le _ _ e.ex (hBd s)
    have hs := hS s
    refine ⟨⟨E.clean_ex ho, hok s, by rw [hev s, if_pos hneg]; exact hs.1⟩,
      by simp only [RS.run, hev s, if_pos hneg]; exact hs.2.1, ?_⟩
    simp only [RS.cost, hev s, if_pos hneg] at h2 ⊢
    have := hs.2.2
    simp only [cIte, cT, cE]
    rw [hev s] at h1
    have : ca ≤ max ca cb := le_max_left _ _
    omega
  · obtain ⟨v', hQ, hS⟩ := hb hneg
    refine ⟨v', hQ, fun s => ?_⟩
    have h1 := pushCost_le e.ex _ _ (hBd s)
    have h2 := Ex.zsz_eval_le _ _ e.ex (hBd s)
    have hs := hS s
    refine ⟨⟨E.clean_ex ho, hok s, by rw [hev s, if_neg hneg]; exact hs.1⟩,
      by simp only [RS.run, hev s, if_neg hneg]; exact hs.2.1, ?_⟩
    simp only [RS.cost, hev s, if_neg hneg] at h2 ⊢
    have := hs.2.2
    simp only [cIte, cT, cE]
    rw [hev s] at h1
    have : cb ≤ max ca cb := le_max_right _ _
    omega

