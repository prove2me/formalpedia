p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField
open LanglandsTunnell.RankinSelberg

private theorem tsum_mul_pow_mul_cubic_eq_one (e₁ e₂ e₃ Y : ℂ)
    (hs : Summable fun n : ℕ => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) :
    (∑' n : ℕ, sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) * (1 - e₁ * Y + e₂ * Y ^ 2 - e₃ * Y ^ 3) = 1 := by
  set f : ℕ → ℂ := fun n => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n with hf
  have hrec : ∀ n : ℕ, f (n + 3) = e₁ * Y * f (n + 2) - e₂ * Y ^ 2 * f (n + 1) + e₃ * Y ^ 3 * f n := by
    intro n
    simp only [hf, sphericalTorusValue]
    ring
  have hf0 : f 0 = 1 := by simp [hf, sphericalTorusValue]
  have hf1 : f 1 = e₁ * Y := by simp [hf, sphericalTorusValue]
  have hf2 : f 2 = (e₁ ^ 2 - e₂) * Y ^ 2 := by simp [hf, sphericalTorusValue]
  have h1 : Summable fun n => f (n + 1) := (summable_nat_add_iff 1).mpr hs
  have h2 : Summable fun n => f (n + 2) := (summable_nat_add_iff 2).mpr hs
  have hS1 : ∑' n, f (n + 1) = ∑' n, f n - 1 := by
    rw [← hs.sum_add_tsum_nat_add 1, Finset.sum_range_one, hf0]
    ring
  have hS2 : ∑' n, f (n + 2) = ∑' n, f n - 1 - e₁ * Y := by
    rw [← hs.sum_add_tsum_nat_add 2, Finset.sum_range_succ, Finset.sum_range_one, hf0, hf1]
    ring
  have hS3 : ∑' n, f (n + 3) = ∑' n, f n - 1 - e₁ * Y - (e₁ ^ 2 - e₂) * Y ^ 2 := by
    rw [← hs.sum_add_tsum_nat_add 3, Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one, hf0, hf1,
      hf2]
    ring
  have hsum : HasSum (fun n => e₁ * Y * f (n + 2) - e₂ * Y ^ 2 * f (n + 1) + e₃ * Y ^ 3 * f n)
      (e₁ * Y * ∑' n, f (n + 2) - e₂ * Y ^ 2 * ∑' n, f (n + 1) + e₃ * Y ^ 3 * ∑' n, f n) :=
    ((h2.hasSum.mul_left _).sub (h1.hasSum.mul_left _)).add (hs.hasSum.mul_left _)
  have hS3' : ∑' n, f (n + 3) = e₁ * Y * ∑' n, f (n + 2) - e₂ * Y ^ 2 * ∑' n, f (n + 1) + e₃ * Y ^ 3 * ∑' n, f n :=
    calc ∑' n, f (n + 3) = ∑' n, (e₁ * Y * f (n + 2) - e₂ * Y ^ 2 * f (n + 1) + e₃ * Y ^ 3 * f n) := tsum_congr hrec
      _ = _ := hsum.tsum_eq
  have key := hS3'.symm.trans hS3
  rw [hS2, hS1] at key
  linear_combination (-1 : ℂ) * key

private theorem cubic_ne_zero (e₁ e₂ e₃ Y : ℂ) (hs : Summable fun n : ℕ => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) :
    1 - e₁ * Y + e₂ * Y ^ 2 - e₃ * Y ^ 3 ≠ 0 :=
  right_ne_zero_of_mul_eq_one (tsum_mul_pow_mul_cubic_eq_one e₁ e₂ e₃ Y hs)

private theorem tsum_mul_pow_eq_inv_cubic (e₁ e₂ e₃ Y : ℂ)
    (hs : Summable fun n : ℕ => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) :
    ∑' n : ℕ, sphericalTorusValue e₁ e₂ e₃ n * Y ^ n = (1 - e₁ * Y + e₂ * Y ^ 2 - e₃ * Y ^ 3)⁻¹ :=
  eq_inv_of_mul_eq_one_left (tsum_mul_pow_mul_cubic_eq_one e₁ e₂ e₃ Y hs)

private theorem hasSum_mul_pow_inv_cubic (e₁ e₂ e₃ Y : ℂ)
    (hs : Summable fun n : ℕ => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) :
    HasSum (fun n : ℕ => sphericalTorusValue e₁ e₂ e₃ n * Y ^ n) (1 - e₁ * Y + e₂ * Y ^ 2 - e₃ * Y ^ 3)⁻¹ :=
  tsum_mul_pow_eq_inv_cubic e₁ e₂ e₃ Y hs ▸ hs.hasSum

