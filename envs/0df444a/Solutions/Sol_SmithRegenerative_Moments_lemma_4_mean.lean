import Mathlib
import Definitions.Def_SmithRegenerative_Moments_CumulativeProcess



namespace SmithRegenerative.Moments

open MeasureTheory Filter ProbabilityTheory Topology

variable {Ω : Type*} [MeasurableSpace Ω] (C : CumulativeProcess Ω)

/-- 0-indexed cycle triple. -/
noncomputable def CumulativeProcess.V (i : ℕ) (ω : Ω) : ℝ × ℝ × ℝ :=
  (C.renewal.cycleLength (i + 1) ω, cycleReward C.renewal C.w (i + 1) ω,
    cycleVariation C.renewal C.w (i + 1) ω)

lemma CumulativeProcess.measurable_V (i : ℕ) : Measurable (C.V i) :=
  (C.renewal.measurable_cycle i).prodMk
    ((C.measurable_reward i).prodMk (C.measurable_variation i))

lemma CumulativeProcess.iIndep_V : iIndepFun C.V C.renewal.P := C.independent_cycles

lemma CumulativeProcess.map_V (i : ℕ) :
    Measure.map (C.V i) C.renewal.P = Measure.map (C.V 0) C.renewal.P := by
  have := C.identical_cycles i
  unfold CumulativeProcess.V
  simpa using this

lemma CumulativeProcess.epoch_eq (n : ℕ) (ω : Ω) :
    C.renewal.epoch n ω = ∑ l ∈ Finset.range n, (C.V l ω).1 := by
  unfold Renewal.epoch
  rw [← Finset.Ico_succ_right_eq_Icc, Finset.sum_Ico_eq_sum_range]
  simp [CumulativeProcess.V, add_comm]

lemma CumulativeProcess.measurable_epoch (n : ℕ) : Measurable (C.renewal.epoch n) := by
  have : C.renewal.epoch n = fun ω => ∑ l ∈ Finset.range n, (C.V l ω).1 := by
    funext ω; exact C.epoch_eq n ω
  rw [this]
  exact Finset.measurable_sum _ fun l _ => (C.measurable_V l).fst

/-- The event `{∀ j < k, T_j ≤ t}`, which is `{n_t ≥ k}` when `n_t` is finite. -/
def CumulativeProcess.A (t : ℝ) (k : ℕ) : Set Ω := {ω | ∀ j < k, C.renewal.epoch j ω ≤ t}

lemma CumulativeProcess.A_zero (t : ℝ) : C.A t 0 = Set.univ := by
  ext ω; simp [CumulativeProcess.A]

/-- σ-algebra generated by the cycles with indices in `S`. -/
noncomputable def CumulativeProcess.sigS (S : Finset ℕ) : MeasurableSpace Ω :=
  ⨆ l ∈ (S : Set ℕ), MeasurableSpace.comap (C.V l) inferInstance

lemma CumulativeProcess.sigS_le (S : Finset ℕ) : C.sigS S ≤ ‹MeasurableSpace Ω› := by
  unfold CumulativeProcess.sigS
  exact iSup₂_le fun l _ => (C.measurable_V l).comap_le

lemma CumulativeProcess.measurable_V_sigS (S : Finset ℕ) {l : ℕ} (hl : l ∈ S) :
    Measurable[C.sigS S] (C.V l) := by
  rw [measurable_iff_comap_le]
  exact le_iSup₂ (f := fun l (_ : l ∈ (S : Set ℕ)) => MeasurableSpace.comap (C.V l) inferInstance) l
    (by simpa using hl)

lemma CumulativeProcess.measurable_epoch_sigS (k : ℕ) {j : ℕ} (hj : j ≤ k) :
    Measurable[C.sigS (Finset.range k)] (C.renewal.epoch j) := by
  have : C.renewal.epoch j = fun ω => ∑ l ∈ Finset.range j, (C.V l ω).1 := by
    funext ω; exact C.epoch_eq j ω
  rw [this]
  exact Finset.measurable_sum _ fun l hl =>
    measurable_fst.comp (C.measurable_V_sigS (Finset.range k)
      (Finset.mem_range.2 (lt_of_lt_of_le (Finset.mem_range.1 hl) hj)))

lemma CumulativeProcess.measurableSet_A_sigS (t : ℝ) (k : ℕ) :
    MeasurableSet[C.sigS (Finset.range (k - 1))] (C.A t k) := by
  have : C.A t k = ⋂ j, ⋂ (_ : j < k), {ω | C.renewal.epoch j ω ≤ t} := by
    ext ω; simp [CumulativeProcess.A]
  rw [this]
  refine MeasurableSet.iInter fun j => MeasurableSet.iInter fun hj => ?_
  exact measurableSet_le (C.measurable_epoch_sigS (k - 1) (by omega)) measurable_const

lemma CumulativeProcess.measurableSet_A (t : ℝ) (k : ℕ) : MeasurableSet (C.A t k) :=
  C.sigS_le _ _ (C.measurableSet_A_sigS t k)

/-- Independence of a function of cycle `i` and the event `A t k` when `k ≤ i + 1`. -/
lemma CumulativeProcess.indepFun_V_A {β : Type*} [MeasurableSpace β]
    (f : ℝ × ℝ × ℝ → β) (hf : Measurable f) (t : ℝ) {k i : ℕ} (hki : k ≤ i + 1) :
    IndepFun (fun ω => f (C.V i ω)) ((C.A t k).indicator (fun _ => (1 : ENNReal)))
      C.renewal.P := by
  have hind := indep_iSup_of_disjoint (μ := C.renewal.P)
    (m := fun l => MeasurableSpace.comap (C.V l) inferInstance)
    (fun l => (C.measurable_V l).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 C.iIndep_V)
    (S := ((Finset.range (k - 1) : Finset ℕ) : Set ℕ)) (T := (({i} : Finset ℕ) : Set ℕ))
    (by
      rw [Finset.disjoint_coe]
      simp only [Finset.disjoint_singleton_right, Finset.mem_range]
      omega)
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_left (indep_of_indep_of_le_right hind.symm ?_) ?_
  · rw [← measurable_iff_comap_le]
    exact measurable_const.indicator (C.measurableSet_A_sigS t k)
  · rw [← measurable_iff_comap_le]
    exact hf.comp (C.measurable_V_sigS {i} (Finset.mem_singleton_self i))

/-! ### Facts about `count` on the event where some epoch exceeds `t` -/

lemma CumulativeProcess.epoch_zero (ω : Ω) : C.renewal.epoch 0 ω = 0 := by
  simp [Renewal.epoch]

lemma CumulativeProcess.le_count_iff {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) (k : ℕ) :
    k ≤ C.renewal.count t ω ↔ ω ∈ C.A t k := by
  constructor
  · intro hk j hj
    have := Nat.notMem_of_lt_sInf (s := {n : ℕ | t < C.renewal.epoch n ω}) (lt_of_lt_of_le hj hk)
    simpa using this
  · intro hA
    by_contra h
    push_neg at h
    have hmem : t < C.renewal.epoch (C.renewal.count t ω) ω :=
      Nat.sInf_mem (s := {n : ℕ | t < C.renewal.epoch n ω}) hS
    have := hA _ h
    linarith

lemma CumulativeProcess.lt_epoch_count {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) :
    t < C.renewal.epoch (C.renewal.count t ω) ω :=
  Nat.sInf_mem (s := {n : ℕ | t < C.renewal.epoch n ω}) hS

lemma CumulativeProcess.one_le_count {t : ℝ} (ht : 0 ≤ t) {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) : 1 ≤ C.renewal.count t ω := by
  rw [C.le_count_iff hS]
  intro j hj
  have : j = 0 := by omega
  subst this
  simpa [C.epoch_zero] using ht

lemma CumulativeProcess.epoch_count_pred_le {t : ℝ} (ht : 0 ≤ t) {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) :
    C.renewal.epoch (C.renewal.count t ω - 1) ω ≤ t := by
  have h1 := C.one_le_count ht hS
  have := (C.le_count_iff hS (C.renewal.count t ω)).1 le_rfl
  exact this _ (by omega)

/-- Pointwise: a finite sum up to `n_t + m` as a series with indicators. -/
lemma CumulativeProcess.sum_range_count_eq_tsum {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) (m : ℕ) (g : ℕ → ENNReal) :
    ∑ i ∈ Finset.range (C.renewal.count t ω + m), g i =
      ∑' i, g i * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω := by
  rw [tsum_eq_sum (s := Finset.range (C.renewal.count t ω + m))]
  · refine Finset.sum_congr rfl fun i hi => ?_
    have hmem : ω ∈ C.A t (i + 1 - m) := by
      rw [← C.le_count_iff hS]
      have := Finset.mem_range.1 hi
      omega
    simp [Set.indicator_of_mem hmem]
  · intro i hi
    have hnot : ω ∉ C.A t (i + 1 - m) := by
      rw [← C.le_count_iff hS]
      have : ¬ i < C.renewal.count t ω + m := fun h' => hi (Finset.mem_range.2 h')
      omega
    simp [Set.indicator_of_notMem hnot]

/-! ### Almost surely the epochs tend to infinity (strong law) -/

lemma CumulativeProcess.ae_nonneg_cycles :
    ∀ᵐ ω ∂C.renewal.P, ∀ i : ℕ, 0 ≤ (C.V i ω).1 := by
  rw [ae_all_iff]
  intro i
  exact C.renewal.nonnegative_cycle i

lemma CumulativeProcess.meanLength_pos
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) : 0 < C.meanLength := by
  unfold CumulativeProcess.meanLength
  have := C.renewal.probability
  rw [integral_pos_iff_support_of_nonneg_ae (C.renewal.nonnegative_cycle 0) hμ]
  have hlt := C.renewal.not_all_zero
  have hmeas : MeasurableSet {ω | C.renewal.cycleLength 1 ω = 0} :=
    measurableSet_eq_fun (C.renewal.measurable_cycle 0) measurable_const
  have hc : Function.support (C.renewal.cycleLength 1) =
      {ω | C.renewal.cycleLength 1 ω = 0}ᶜ := by
    ext ω; simp [Function.mem_support]
  rw [hc, prob_compl_eq_one_sub hmeas]
  exact tsub_pos_iff_lt.2 hlt

lemma CumulativeProcess.ae_tendsto_epoch
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    ∀ᵐ ω ∂C.renewal.P, Tendsto (fun n => C.renewal.epoch n ω) atTop atTop := by
  have := C.renewal.probability
  have hX : ∀ i, (fun ω => (C.V i ω).1) = C.renewal.cycleLength (i + 1) := fun i => rfl
  have hint : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by
    rw [hX]; simpa using hμ
  have hindep : Pairwise (fun i j => IndepFun (fun ω => (C.V i ω).1) (fun ω => (C.V j ω).1)
      C.renewal.P) := by
    intro i j hij
    exact (C.iIndep_V.indepFun hij).comp measurable_fst measurable_fst
  have hident : ∀ i, IdentDistrib (fun ω => (C.V i ω).1) (fun ω => (C.V 0 ω).1)
      C.renewal.P C.renewal.P := by
    intro i
    refine ⟨(C.measurable_V i).fst.aemeasurable, (C.measurable_V 0).fst.aemeasurable, ?_⟩
    have h1 : (fun ω => (C.V i ω).1) = Prod.fst ∘ C.V i := rfl
    have h0 : (fun ω => (C.V 0 ω).1) = Prod.fst ∘ C.V 0 := rfl
    rw [h1, h0, ← Measure.map_map measurable_fst (C.measurable_V i),
      ← Measure.map_map measurable_fst (C.measurable_V 0), C.map_V i]
  have hslln := strong_law_ae (μ := C.renewal.P) (fun i ω => (C.V i ω).1) hint hindep hident
  have hpos : 0 < C.meanLength := C.meanLength_pos hμ
  have hmean : (C.renewal.P)[fun ω => (C.V 0 ω).1] = C.meanLength := by
    rw [hX]; rfl
  filter_upwards [hslln] with ω hω
  rw [hmean] at hω
  have h2 : Tendsto (fun n : ℕ => (n : ℝ) * ((n : ℝ)⁻¹ • ∑ i ∈ Finset.range n, (C.V i ω).1))
      atTop atTop :=
    Tendsto.atTop_mul_pos hpos tendsto_natCast_atTop_atTop hω
  refine h2.congr' ?_
  filter_upwards [eventually_ge_atTop 1] with n hn
  rw [C.epoch_eq, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]

lemma CumulativeProcess.ae_exists_epoch_gt
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) (t : ℝ) :
    ∀ᵐ ω ∂C.renewal.P, ∃ n, t < C.renewal.epoch n ω := by
  filter_upwards [C.ae_tendsto_epoch hμ] with ω hω
  obtain ⟨n, hn⟩ := (tendsto_atTop_atTop.1 hω (t + 1)) 
  exact ⟨n, by linarith [hn n le_rfl]⟩

/-! ### Wald's identity (in `ℝ≥0∞`) -/

lemma CumulativeProcess.lintegral_V_eq (f : ℝ × ℝ × ℝ → ENNReal) (hf : Measurable f) (i : ℕ) :
    ∫⁻ ω, f (C.V i ω) ∂C.renewal.P = ∫⁻ ω, f (C.V 0 ω) ∂C.renewal.P := by
  rw [← lintegral_map hf (C.measurable_V i), C.map_V i, lintegral_map hf (C.measurable_V 0)]

/-- `∫ ∑_{i < n_t + m} f(V_i) = (∫ f(V_0)) · ∫ (n_t + m)`. -/
lemma CumulativeProcess.wald (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (f : ℝ × ℝ × ℝ → ENNReal) (hf : Measurable f) (t : ℝ) (m : ℕ) :
    ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω + m), f (C.V i ω) ∂C.renewal.P =
      (∫⁻ ω, f (C.V 0 ω) ∂C.renewal.P) *
        ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P := by
  have hae := C.ae_exists_epoch_gt hμ t
  have hmeasA : ∀ k, Measurable ((C.A t k).indicator (fun _ => (1 : ENNReal))) :=
    fun k => measurable_const.indicator (C.measurableSet_A t k)
  have e1 : ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω + m), f (C.V i ω) ∂C.renewal.P =
      ∫⁻ ω, ∑' i, f (C.V i ω) * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P := by
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with ω hω
    exact C.sum_range_count_eq_tsum hω m _
  have e2 : ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P =
      ∫⁻ ω, ∑' i, (1 : ENNReal) * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P := by
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with ω hω
    rw [← C.sum_range_count_eq_tsum hω m (fun _ => 1)]
    simp
  rw [e1, e2, lintegral_tsum, lintegral_tsum]
  · rw [← ENNReal.tsum_mul_left]
    refine tsum_congr fun i => ?_
    rw [lintegral_mul_eq_lintegral_mul_lintegral_of_indepFun'' (f := fun ω => f (C.V i ω))
      (hf.comp (C.measurable_V i)).aemeasurable
      (hmeasA _).aemeasurable (C.indepFun_V_A f hf t (k := i + 1 - m) (i := i) (by omega)),
      lintegral_mul_eq_lintegral_mul_lintegral_of_indepFun'' measurable_const.aemeasurable
      (hmeasA _).aemeasurable, C.lintegral_V_eq f hf i]
    · have := C.renewal.probability
      simp
    · exact (C.indepFun_V_A (fun _ => (1 : ENNReal)) measurable_const t (k := i + 1 - m) (i := i)
        (by omega))
  · exact fun i => (measurable_const.mul (hmeasA _)).aemeasurable
  · exact fun i => ((hf.comp (C.measurable_V i)).mul (hmeasA _)).aemeasurable

/-! ### The elementary renewal theorem -/

/-- `E n_t` as an extended nonnegative real. -/
noncomputable def CumulativeProcess.nt (t : ℝ) : ENNReal :=
  ∫⁻ ω, (C.renewal.count t ω : ENNReal) ∂C.renewal.P

/-- The truncated mean `E min(t₁, M)`. -/
noncomputable def CumulativeProcess.muM (M : ℕ) : ℝ :=
  ∫ ω, min (C.V 0 ω).1 (M : ℝ) ∂C.renewal.P

lemma CumulativeProcess.V0_fst : (fun ω => (C.V 0 ω).1) = C.renewal.cycleLength 1 := rfl

lemma CumulativeProcess.integrable_min (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (M : ℕ) : Integrable (fun ω => min (C.V 0 ω).1 (M : ℝ)) C.renewal.P := by
  have := C.renewal.probability
  have h1 : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by rw [C.V0_fst]; exact hμ
  exact h1.inf (integrable_const _)

lemma CumulativeProcess.muM_nonneg (M : ℕ) : 0 ≤ C.muM M := by
  unfold CumulativeProcess.muM
  refine integral_nonneg_of_ae ?_
  filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
  exact le_min hω (by positivity)

lemma CumulativeProcess.muM_tendsto (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto C.muM atTop (𝓝 C.meanLength) := by
  have h1 : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by rw [C.V0_fst]; exact hμ
  have hmean : C.meanLength = ∫ ω, (C.V 0 ω).1 ∂C.renewal.P := rfl
  rw [hmean]
  refine tendsto_integral_of_dominated_convergence (fun ω => |(C.V 0 ω).1|)
    (fun M => (C.integrable_min hμ M).aestronglyMeasurable) h1.abs ?_ ?_
  · intro M
    filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
    have : (0 : ℝ) ≤ (C.V 0 ω).1 := hω
    rw [Real.norm_eq_abs, abs_of_nonneg (le_min this (by positivity)), abs_of_nonneg this]
    exact min_le_left _ _
  · refine Eventually.of_forall fun ω => ?_
    refine tendsto_const_nhds.congr' ?_
    obtain ⟨N, hN⟩ := exists_nat_ge (C.V 0 ω).1
    filter_upwards [eventually_ge_atTop N] with M hM
    rw [min_eq_left (hN.trans (by exact_mod_cast hM))]

lemma CumulativeProcess.lintegral_ofReal_min (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (M : ℕ) :
    ∫⁻ ω, ENNReal.ofReal (min (C.V 0 ω).1 (M : ℝ)) ∂C.renewal.P = ENNReal.ofReal (C.muM M) := by
  unfold CumulativeProcess.muM
  rw [ofReal_integral_eq_lintegral_ofReal (C.integrable_min hμ M)]
  filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
  exact le_min hω (by positivity)

lemma CumulativeProcess.lintegral_ofReal_V0 (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (C.V 0 ω).1 ∂C.renewal.P = ENNReal.ofReal C.meanLength := by
  have h1 : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by rw [C.V0_fst]; exact hμ
  have hmean : C.meanLength = ∫ ω, (C.V 0 ω).1 ∂C.renewal.P := rfl
  rw [hmean, ofReal_integral_eq_lintegral_ofReal h1 (C.renewal.nonnegative_cycle 0)]

/-- Upper bound: `E min(t₁,M) · E n_t ≤ t + M`. -/
lemma CumulativeProcess.nt_upper (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (M : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    ENNReal.ofReal (C.muM M) * C.nt t ≤ ENNReal.ofReal (t + M) := by
  have := C.renewal.probability
  have hw := C.wald hμ (fun v => ENNReal.ofReal (min v.1 (M : ℝ)))
    (ENNReal.measurable_ofReal.comp (measurable_fst.min measurable_const)) t 0
  simp only [add_zero] at hw
  rw [← C.lintegral_ofReal_min hμ M]
  unfold CumulativeProcess.nt
  rw [← hw]
  calc ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω), ENNReal.ofReal (min (C.V i ω).1 (M : ℝ))
        ∂C.renewal.P ≤ ∫⁻ _, ENNReal.ofReal (t + M) ∂C.renewal.P := by
        refine lintegral_mono_ae ?_
        filter_upwards [C.ae_exists_epoch_gt hμ t, C.ae_nonneg_cycles] with ω hS hnn
        rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => le_min (hnn i) (by positivity))]
        refine ENNReal.ofReal_le_ofReal ?_
        have h1 := C.one_le_count ht hS
        have h2 := C.epoch_count_pred_le ht hS
        rw [C.epoch_eq] at h2
        obtain ⟨n, hn⟩ : ∃ n, C.renewal.count t ω = n + 1 := ⟨_, (Nat.succ_pred_eq_of_pos h1).symm⟩
        rw [hn] at h2 ⊢
        simp only [Nat.add_sub_cancel] at h2
        rw [Finset.sum_range_succ]
        have h3 : ∑ i ∈ Finset.range n, min (C.V i ω).1 (M : ℝ) ≤ ∑ i ∈ Finset.range n, (C.V i ω).1 :=
          Finset.sum_le_sum fun i _ => min_le_left _ _
        linarith [min_le_right (C.V n ω).1 (M : ℝ)]
    _ = ENNReal.ofReal (t + M) := by simp

/-- Lower bound: `t ≤ μ₁ · E n_t`. -/
lemma CumulativeProcess.nt_lower (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {t : ℝ} :
    ENNReal.ofReal t ≤ ENNReal.ofReal C.meanLength * C.nt t := by
  have := C.renewal.probability
  have hw := C.wald hμ (fun v => ENNReal.ofReal v.1)
    (ENNReal.measurable_ofReal.comp measurable_fst) t 0
  simp only [add_zero] at hw
  rw [← C.lintegral_ofReal_V0 hμ]
  unfold CumulativeProcess.nt
  rw [← hw]
  calc ENNReal.ofReal t = ∫⁻ _, ENNReal.ofReal t ∂C.renewal.P := by simp
    _ ≤ ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω), ENNReal.ofReal (C.V i ω).1
        ∂C.renewal.P := by
        refine lintegral_mono_ae ?_
        filter_upwards [C.ae_exists_epoch_gt hμ t, C.ae_nonneg_cycles] with ω hS hnn
        rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => hnn i)]
        refine ENNReal.ofReal_le_ofReal ?_
        have := C.lt_epoch_count hS
        rw [C.epoch_eq] at this
        exact this.le

/-- The real-valued renewal function `E n_t`. -/
noncomputable def CumulativeProcess.H (t : ℝ) : ℝ := (C.nt t).toReal

lemma CumulativeProcess.exists_muM_pos (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    ∃ M₀ : ℕ, ∀ M ≥ M₀, 0 < C.muM M := by
  have h := (C.muM_tendsto hμ).eventually (lt_mem_nhds (C.meanLength_pos hμ))
  obtain ⟨M₀, hM₀⟩ := eventually_atTop.1 h
  exact ⟨M₀, hM₀⟩

lemma CumulativeProcess.nt_ne_top (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : C.nt t ≠ ⊤ := by
  have h := C.nt_upper hμ M ht
  intro htop
  rw [htop, ENNReal.mul_top (by simpa using hM)] at h
  exact absurd h (by simp)

lemma CumulativeProcess.H_upper (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : C.muM M * C.H t ≤ t + M := by
  have h := C.nt_upper hμ M ht
  have hne := C.nt_ne_top hμ hM ht
  have := ENNReal.toReal_mono (by simp) h
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hM.le, ENNReal.toReal_ofReal (by positivity)] at this

lemma CumulativeProcess.H_lower (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : t ≤ C.meanLength * C.H t := by
  have h := C.nt_lower hμ (t := t)
  have hne := C.nt_ne_top hμ hM ht
  have := ENNReal.toReal_mono (ENNReal.mul_ne_top (by simp) hne) h
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (C.meanLength_pos hμ).le,
    ENNReal.toReal_ofReal ht] at this

lemma CumulativeProcess.H_nonneg (t : ℝ) : 0 ≤ C.H t := ENNReal.toReal_nonneg

/-- The elementary renewal theorem: `E n_t / t → 1/μ₁`. -/
theorem CumulativeProcess.H_div_tendsto (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto (fun t : ℝ => C.H t / t) atTop (𝓝 (1 / C.meanLength)) := by
  have hμpos := C.meanLength_pos hμ
  obtain ⟨M₀, hM₀⟩ := C.exists_muM_pos hμ
  rw [Metric.tendsto_atTop]
  intro ε hε
  -- choose M with 1/muM M ≤ 1/μ + ε/2
  have hinv : Tendsto (fun M => 1 / C.muM M) atTop (𝓝 (1 / C.meanLength)) :=
    tendsto_const_nhds.div (C.muM_tendsto hμ) hμpos.ne'
  obtain ⟨M₁, hM₁⟩ := eventually_atTop.1 (hinv.eventually (gt_mem_nhds (by linarith : 1 / C.meanLength < 1 / C.meanLength + ε / 2)))
  set M := max M₀ M₁ with hMdef
  have hMpos : 0 < C.muM M := hM₀ M (le_max_left _ _)
  have hMinv : 1 / C.muM M < 1 / C.meanLength + ε / 2 := hM₁ M (le_max_right _ _)
  refine ⟨max 1 (2 * M / (C.muM M * ε)), fun t ht => ?_⟩
  have ht1 : 1 ≤ t := le_trans (le_max_left _ _) ht
  have ht0 : 0 < t := by linarith
  have ht2 : 2 * M / (C.muM M * ε) ≤ t := le_trans (le_max_right _ _) ht
  have hup := C.H_upper hμ hMpos ht0.le
  have hlo := C.H_lower hμ hMpos ht0.le
  rw [Real.dist_eq, abs_lt]
  constructor
  · -- lower bound
    have : 1 / C.meanLength ≤ C.H t / t := by
      rw [div_le_div_iff₀ hμpos ht0]
      linarith
    linarith
  · have h1 : C.H t / t ≤ (t + M) / (C.muM M * t) := by
      rw [div_le_div_iff₀ ht0 (by positivity)]
      nlinarith
    have h2 : (t + M) / (C.muM M * t) = 1 / C.muM M + M / (C.muM M * t) := by
      field_simp
    have h3 : (M : ℝ) / (C.muM M * t) ≤ ε / 2 := by
      rw [div_le_iff₀ (by positivity)]
      have := (div_le_iff₀ (by positivity)).1 ht2
      nlinarith
    linarith

/-! ### Random sums `∑_{i < n_t + m} g(V_i)` with `g ≥ 0` -/

lemma CumulativeProcess.nt_ne_top' (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {t : ℝ} (ht : 0 ≤ t) : C.nt t ≠ ⊤ := by
  obtain ⟨M₀, hM₀⟩ := C.exists_muM_pos hμ
  exact C.nt_ne_top hμ (hM₀ M₀ le_rfl) ht

/-- The random sum `∑_{i < n_t + m} g(V_i)`. -/
noncomputable def CumulativeProcess.G (g : ℝ × ℝ × ℝ → ℝ) (m : ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.range (C.renewal.count t ω + m), g (C.V i ω)

lemma CumulativeProcess.aemeasurable_G (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v) (m : ℕ) (t : ℝ) :
    AEMeasurable (C.G g m t) C.renewal.P := by
  have hmeas : Measurable (fun ω => (∑' i, ENNReal.ofReal (g (C.V i ω)) *
      (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω).toReal) := by
    refine ENNReal.measurable_toReal.comp (Measurable.ennreal_tsum fun i => ?_)
    exact ((ENNReal.measurable_ofReal.comp (hg.comp (C.measurable_V i))).mul
      (measurable_const.indicator (C.measurableSet_A t _)))
  refine ⟨_, hmeas, ?_⟩
  filter_upwards [C.ae_exists_epoch_gt hμ t] with ω hS
  unfold CumulativeProcess.G
  rw [← C.sum_range_count_eq_tsum hS m, ENNReal.toReal_sum (fun i _ => ENNReal.ofReal_ne_top)]
  exact Finset.sum_congr rfl fun i _ => (ENNReal.toReal_ofReal (hg0 _)).symm

lemma CumulativeProcess.lintegral_G (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v) (m : ℕ) (t : ℝ) :
    ∫⁻ ω, ENNReal.ofReal (C.G g m t ω) ∂C.renewal.P =
      (∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P) *
        ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P := by
  rw [← C.wald hμ (fun v => ENNReal.ofReal (g v)) (ENNReal.measurable_ofReal.comp hg) t m]
  refine lintegral_congr fun ω => ?_
  unfold CumulativeProcess.G
  rw [ENNReal.ofReal_sum_of_nonneg (fun i _ => hg0 _)]

lemma CumulativeProcess.lintegral_count_add (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    (∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P).toReal = C.H t + m := by
  have := C.renewal.probability
  have h : (fun ω => ((C.renewal.count t ω + m : ℕ) : ENNReal)) =
      fun ω => (C.renewal.count t ω : ENNReal) + (m : ENNReal) := by
    funext ω; push_cast; rfl
  have hne : (∫⁻ ω, (C.renewal.count t ω : ENNReal) ∂C.renewal.P) ≠ ⊤ := C.nt_ne_top' hμ ht
  rw [h, lintegral_add_right _ measurable_const, lintegral_const, measure_univ, mul_one,
    ENNReal.toReal_add hne (by simp)]
  simp [CumulativeProcess.H, CumulativeProcess.nt]

lemma CumulativeProcess.integrable_G (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v)
    (hfin : ∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    Integrable (C.G g m t) C.renewal.P := by
  have := C.renewal.probability
  refine ⟨(C.aemeasurable_G hμ g hg hg0 m t).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (f := C.G g m t)
    (Eventually.of_forall fun ω => Finset.sum_nonneg fun i _ => hg0 _),
    C.lintegral_G hμ g hg hg0 m t]
  refine ENNReal.mul_lt_top hfin.lt_top ?_
  have h : (fun ω => ((C.renewal.count t ω + m : ℕ) : ENNReal)) =
      fun ω => (C.renewal.count t ω : ENNReal) + (m : ENNReal) := by
    funext ω; push_cast; rfl
  rw [h, lintegral_add_right _ measurable_const, lintegral_const, measure_univ, mul_one]
  exact ENNReal.add_lt_top.2 ⟨(C.nt_ne_top' hμ ht).lt_top, by simp⟩

lemma CumulativeProcess.integral_G (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v)
    (hfin : ∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    ∫ ω, C.G g m t ω ∂C.renewal.P =
      (∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P).toReal * (C.H t + m) := by
  rw [integral_eq_lintegral_of_nonneg_ae (f := C.G g m t)
    (Eventually.of_forall fun ω => Finset.sum_nonneg fun i _ => hg0 _)
    (C.aemeasurable_G hμ g hg hg0 m t).aestronglyMeasurable, C.lintegral_G hμ g hg hg0 m t,
    ENNReal.toReal_mul, C.lintegral_count_add hμ m ht]

/-! ### Lemma 4 -/

lemma CumulativeProcess.overshootReward_eq (t : ℝ) (ω : Ω) :
    C.overshootReward t ω =
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
  unfold CumulativeProcess.overshootReward CumulativeProcess.G
  rw [← Finset.sum_sub_distrib, ← Finset.Ico_succ_right_eq_Icc, Finset.sum_Ico_eq_sum_range]
  simp only [Nat.add_sub_cancel]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [CumulativeProcess.V, add_comm]
  rcases le_total 0 (cycleReward C.renewal C.w (i + 1) ω) with h | h
  · rw [max_eq_left h, max_eq_right (by linarith)]; ring
  · rw [max_eq_right h, max_eq_left (by linarith)]; ring

lemma ofReal_max_zero (a : ℝ) : ENNReal.ofReal (max a 0) = ENNReal.ofReal a := by
  rcases le_total 0 a with h | h
  · rw [max_eq_left h]
  · rw [max_eq_right h, ENNReal.ofReal_of_nonpos h, ENNReal.ofReal_zero]

lemma CumulativeProcess.V0_reward : (fun ω => (C.V 0 ω).2.1) = cycleReward C.renewal C.w 1 := rfl

lemma CumulativeProcess.lintegral_pos_part_ne_top
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (max (C.V 0 ω).2.1 0) ∂C.renewal.P ≠ ⊤ := by
  refine ne_top_of_le_ne_top hκ.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
  rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal (le_abs_self _)

lemma CumulativeProcess.lintegral_neg_part_ne_top
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (max (-(C.V 0 ω).2.1) 0) ∂C.renewal.P ≠ ⊤ := by
  refine ne_top_of_le_ne_top hκ.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
  rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal (neg_le_abs _)

theorem CumulativeProcess.integrable_overshootReward
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) {t : ℝ} (ht : 0 ≤ t) :
    Integrable (C.overshootReward t) C.renewal.P := by
  have h : C.overshootReward t = fun ω =>
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
    funext ω; exact C.overshootReward_eq t ω
  have hgp : Measurable fun v : ℝ × ℝ × ℝ => max v.2.1 0 := by fun_prop
  have hgn : Measurable fun v : ℝ × ℝ × ℝ => max (-v.2.1) 0 := by fun_prop
  rw [h]
  exact (C.integrable_G hμ _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht).sub
    (C.integrable_G hμ _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht)

theorem CumulativeProcess.integral_overshootReward
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) {t : ℝ} (ht : 0 ≤ t) :
    ∫ ω, C.overshootReward t ω ∂C.renewal.P = C.meanReward * (C.H t + 1) := by
  have h : C.overshootReward t = fun ω =>
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
    funext ω; exact C.overshootReward_eq t ω
  have hgp : Measurable fun v : ℝ × ℝ × ℝ => max v.2.1 0 := by fun_prop
  have hgn : Measurable fun v : ℝ × ℝ × ℝ => max (-v.2.1) 0 := by fun_prop
  have hp := C.integrable_G hμ _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht
  have hn := C.integrable_G hμ _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht
  rw [h]
  beta_reduce
  rw [integral_sub hp hn,
    C.integral_G hμ _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht,
    C.integral_G hμ _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht]
  have hκ' : C.meanReward = ∫ ω, (C.V 0 ω).2.1 ∂C.renewal.P := rfl
  rw [hκ', integral_eq_lintegral_pos_part_sub_lintegral_neg_part (by rw [C.V0_reward]; exact hκ)]
  simp only [ofReal_max_zero]
  push_cast
  ring

theorem lemma_4_mean_core {Ω : Type*} [MeasurableSpace Ω]
    (C : CumulativeProcess Ω)
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    (∀ t : ℝ, 0 ≤ t → Integrable (C.overshootReward t) C.renewal.P) ∧
    (fun t : ℝ =>
      (∫ ω, C.overshootReward t ω ∂C.renewal.P) -
        C.meanReward / C.meanLength * t) =o[atTop] (fun t : ℝ => t) := by
  refine ⟨fun t ht => C.integrable_overshootReward hμ hκ ht, ?_⟩
  rw [Asymptotics.isLittleO_iff_tendsto']
  · have h1 : Tendsto (fun t : ℝ => C.meanReward * (C.H t / t - 1 / C.meanLength) +
        C.meanReward / t) atTop (𝓝 0) := by
      have h2 := ((C.H_div_tendsto hμ).sub_const (1 / C.meanLength)).const_mul C.meanReward
      have h3 : Tendsto (fun t : ℝ => C.meanReward / t) atTop (𝓝 0) :=
        tendsto_const_nhds.div_atTop tendsto_id
      simpa using h2.add h3
    refine h1.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with t ht
    rw [C.integral_overshootReward hμ hκ ht.le]
    field_simp
    ring
  · filter_upwards [eventually_gt_atTop 0] with t ht h
    exact absurd h ht.ne'

end SmithRegenerative.Moments

open SmithRegenerative.Moments
open MeasureTheory Filter

theorem solution {Ω : Type*} [MeasurableSpace Ω]
    (C : CumulativeProcess Ω)
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    (∀ t : ℝ, 0 ≤ t → Integrable (C.overshootReward t) C.renewal.P) ∧
    (fun t : ℝ =>
      (∫ ω, C.overshootReward t ω ∂C.renewal.P) -
        C.meanReward / C.meanLength * t) =o[atTop] (fun t : ℝ => t) := by
  exact lemma_4_mean_core C hμ hκ
