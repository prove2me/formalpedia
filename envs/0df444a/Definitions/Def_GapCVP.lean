theorem factor400IndexedIrreducibleCandidateMarkers_findIdx?
    (degree : ℕ)
    (rank : Fin (2 ^ degree))
    (hfound :
      (List.finRange (2 ^ degree)).find?
        (fun candidate => noProperFactors degree
          (indexedWord degree candidate)) = some rank) :
