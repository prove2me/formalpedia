theorem hecke_smul_mem_displacement (t : HeckeAlg) {w : J} (hw : w ∈ displacement I E) :
    t • w ∈ displacement I E := by
  let f : J →+ J := DistribSMul.toAddMonoidHom J t
  have hgen : ∀ w ∈ {w : J | ∃ σ ∈ I, ∃ M : ℕ, ∃ x ∈ E M, w = σ • x - x}, f w ∈ displacement I E := by
    rintro _ ⟨σ, hσ, M, x, hx, rfl⟩
    refine AddSubgroup.subset_closure ⟨σ, hσ, M, t • x, hE M t x hx, ?_⟩
    show t • (σ • x - x) = σ • (t • x) - t • x
    rw [smul_sub]
    congr 1
    exact (smul_comm σ t x).symm
  have hle : (displacement I E).map f ≤ displacement I E := by
    rw [displacement, AddMonoidHom.map_closure]
    exact (AddSubgroup.closure_le _).mpr (by rintro _ ⟨w, hw, rfl⟩; exact hgen w hw)
  exact hle ⟨w, hw, rfl⟩

