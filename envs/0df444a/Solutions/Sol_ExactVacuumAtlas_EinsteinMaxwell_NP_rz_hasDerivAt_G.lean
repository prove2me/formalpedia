  simp only [Matrix.mul_apply, Matrix.transpose_apply, cmat, Matrix.map_apply, metricMatrix,
    Matrix.of_apply, ccontr, Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

/-- Matrix form of the first-order normalisation. -/
theorem FrameCompat.matrix {g h : Metric 4} {E B : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
    (hc : FrameCompat g h E B U) {y : Pt 4} (hy : y ∈ U) :
    (frMat E y)ᵀ * cmat h y * frMat E y + (frMat B y)ᵀ * cmat g y * frMat E y
      + (frMat E y)ᵀ * cmat g y * frMat B y = 0 := by
  ext A C
  simp only [Matrix.add_apply, transpose_mul_cmat_mul_apply2, Matrix.zero_apply]
  exact hc y hy A C

section realization

variable (U : Set (Pt 4)) (g0 gi0 : Metric 4) (F0 f : TwoForm 4) (E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ)

end realization

section props

variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}

theorem rzE_zero : rzE E0 B 0 = E0 := by
  funext A μ y; simp [rzE]

theorem rzTh_eq_inv {ε : ℝ} {y : Pt 4} (hy : y ∈ U) (C μ : Fin 4) :
    rzTh U E0 Θ0 B ε C μ y = (frMat (rzE E0 B ε) y)⁻¹ C μ := by
  simp [rzTh, hy]

variable (hN : NullFrameData g0 gi0 E0 Θ0 U)
include hN

theorem rzTh_zero : rzTh U E0 Θ0 B 0 = Θ0 := by
  funext C μ y
  by_cases hy : y ∈ U
  · rw [rzTh_eq_inv hy, rzE_zero, Matrix.inv_eq_left_inv (hN.dual y hy)]; rfl
  · simp [rzTh, hy]

theorem cmat_eq_coMat {y : Pt 4} (hy : y ∈ U) :
    cmat g0 y = (coMat Θ0 y)ᵀ * etaNull * coMat Θ0 y := by
  have hc := hN.toFrameData.compl hy
  have hg := hN.gram y hy
  calc cmat g0 y = (frMat E0 y * coMat Θ0 y)ᵀ * cmat g0 y * (frMat E0 y * coMat Θ0 y) := by
        rw [hc]; simp
    _ = (coMat Θ0 y)ᵀ * ((frMat E0 y)ᵀ * cmat g0 y * frMat E0 y) * coMat Θ0 y := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = _ := by rw [← gramM, hg]

theorem mem_rzW_zero {y : Pt 4} (hy : y ∈ U) : ((0 : ℝ), y) ∈ rzW U E0 B := by
  refine ⟨hy, ?_⟩
  rw [rzE_zero]
  exact Matrix.det_ne_zero_of_left_inverse (hN.dual y hy)

