    unfold NLogN.KFUU.cRotU cStepU
    have : 8 * B + 8 ≤ 10 ^ 9 * (B + 2) ^ 2 := by nlinarith
    omega

theorem fwSt_cf3 (d : ℕ) (sF μ : ℕ → ℕ) (t : IState HS) (R RSP RML LI LP LB : List Item)
    (xs : List ℤ) (k : ℕ) (LA LC LD : List Item) :
    cf3 (fwSt d sF μ t R RSP RML LI LP LB xs k) NLogN.KFUU.lA lC lD LA LC LD =
      fwSt d sF μ (cf3 t NLogN.KFUU.lA lC lD LA LC LD) R RSP RML LI LP LB xs k := by
  unfold fwSt cf3; ((apply NLogN.IState.ext' <;> (try intros) <;>
                              (simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip,
                                  NLogN.IState.upd_out, ↓reduceIte, ]) <;>
                            (try split_ifs) <;>
                          (try subst_vars) <;>
                        (try simp_all +decide)))

/-- **The forward shifts, uniform.** -/
theorem rotsFU_runs (d : ℕ) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (hμ : ∀ j < d, μ j < sF j)
    (B Bb w : ℕ) (hVB : zsz ((vol (KFU.shR d (KFU.sP d sF)) : ℕ) : ℤ) ≤ B) (hdB : zsz (d : ℤ) ≤ B)
    (hVb : zsz ((vol (KFU.shR d (KFU.sP d sF)) : ℕ) : ℤ) ≤ Bb)
    (xs : List ℤ) (hlen : xs.length = vol (KFU.shR d (KFU.sP d sF))) (hb : Bnd w xs)
    (t : IState HS) (R RSP RML LI LP LB LD : List Item)
    (h0 : t.G 0 = ints xs ++ R) (hI : t.G oI = .int d :: LI) (hPi : t.G oPi = .int (Pv sF d) :: LP)
    (hBv : t.G oBv = .int 2 :: LB)
    (hSP : t.G oSP = ints ((List.range d).map fun j => (sF j : ℤ)).reverse ++ RSP)
    (hML : t.G oML = ints ((List.range d).map fun j => (μ j : ℤ)).reverse ++ RML)
    (hD : t.G oD = .int d :: LD) :
    IRuns I iprog rotsFU t
      ((((((t.upd 0 (ints (pull (KFU.shR d (KFU.sP d sF)) (KFU.shR d (KFU.sP d sF))
        (KFU.Gf sF (KFU.csF sF μ) d) 0 xs) ++ R)).upd oI (.int 0 :: LI)).upd oPi (.int 1 :: LP)).upd
        oBv (.int (vol (KFU.shR d (KFU.sP d sF))) :: LB)).upd oSP RSP).upd oML RML)
      ((d + 1) * (cStepU d (vol ((List.range (d - 1)).map sF)) (vol (KFU.shR d (KFU.sP d sF))) w B Bb
        + 3000)) := by
  set T := fwSt d sF μ t R RSP RML LI LP LB xs
  have h0' : T 0 = t := by
    simp only [T, fwSt, Hf, Nat.sub_zero, BvF_zero]
    rw [pull_id 0 hlen]
    ((apply NLogN.IState.ext' <;> (try intros) <;>
               (simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip,
                   NLogN.IState.upd_out, ↓reduceIte, h0, hI, hPi, hBv, hSP, hML]) <;>
             (try split_ifs) <;>
           (try subst_vars) <;>
         (try simp_all +decide)))
  have H := rptXU_runs (I := I) (iprog := iprog) (X := oD) (by decide) d T
    (by intro k; simp +decide [T, fwSt]) (by intro k; simp +decide [T, fwSt])
    (by intro k; simp +decide [T, fwSt]) fwB _
    (fun k hk LA LC LD => by
      rw [fwSt_cf3, fwSt_cf3]
      exact fwB_runs d sF μ hs hμ B Bb w hVB hdB hVb xs hlen hb _ R RSP RML LI LP LB hk)
    LD (by rw [h0']; exact hD)
  rw [h0'] at H
  refine H.mono' ?_ le_rfl
  have eG : Hf d sF (KFU.csF sF μ) d = KFU.Gf sF (KFU.csF sF μ) d := by
    have := Hf_Gf d sF (KFU.csF sF μ) d le_rfl
    simpa [KFU.Gf] using this
  simp only [T, fwSt, Nat.sub_self, eG, BvF_d]
  simp [Pv, vol]

end NLogN.KFUU

end

