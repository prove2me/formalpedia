-- name    : LearnCollude_Randomness
-- status  : Definition
-- author  : @iris
-- created : 2026-10-31T14:02:39.290066+00:00
-- url     : https://prove2.me/theorems/eb931c69-0ec9-43e0-9ee6-ced90b06437f
-- title:
--   The coins $\omega$ and the noise $\epsilon$ on one probability space
-- statement:
--   The randomness of the model lives on one probability space. The **coins** $\omega_i^{a}(n)$, for arm $a\in\{col,com\}$, firm $i$ and $n\ge 1$, take the values $1$ and $-1$ with probability $1/2$ each, and the whole family is mutually independent.
--
--   The **noise** $\epsilon_i(t)$, $t\ge1$, is measurable, with $\epsilon_i(t)$ and $\epsilon_i(t)^2$ integrable. Let $\mathcal G_t$ be the $\sigma$-algebra generated by all the coins and by $\epsilon_j(s)$ for both $j$ and $s<t$. Then
--   $$
--   \mathbb E[\epsilon_i(t)\mid\mathcal G_t]=0,\qquad \mathbb E[\epsilon_i(t)^2\mid\mathcal G_t]\le\sigma^2\quad\text{almost surely.}
--   $$
--   The two firms' noise in one period may be correlated.
--
--   This corrects the paper's conditioning on $p(t)$: noise centred given $p(t)$ only can be correlated with the current coin, and it then biases the recursion by order $a_n/c_n$. Since $p(t)$ is $\mathcal G_t$-measurable, the condition here implies the printed one, and noise independent of the coins satisfies it.
--
--   **Formalization Note** Coins are indexed from $n=1$ and periods from $t=1$; the values at index $0$ are not constrained and never used.
-- source:
--   Meylahn–den Boer, Learning to collude in a pricing duopoly, SSRN:3741385 (PDF of 2021-12-06), §2, p. 8; policy (10), p. 14

import Mathlib

open MeasureTheory ProbabilityTheory

namespace LearnCollude

/-- The two price recursions: `col` learns `pcol`, `com` learns `pcom`. -/
inductive Arm
  | col
  | com
  deriving DecidableEq

/-- The index set of the coins `ω^a_i(n)`: an arm, a firm, and a counter `n ≥ 1`. -/
abbrev CoinIndex := Arm × Fin 2 × {n : ℕ // 1 ≤ n}

/-- The σ-algebra `𝒢_t` generated by all the coins and the noise `ε_j(s)` of the periods
`1 ≤ s < t`. -/
@[instance_reducible] def history {Ω : Type*} [MeasurableSpace Ω] (ω : Arm → Fin 2 → ℕ → Ω → ℝ) (ε : Fin 2 → ℕ → Ω → ℝ)
    (t : ℕ) : MeasurableSpace Ω :=
  (⨆ k : CoinIndex, MeasurableSpace.comap (ω k.1 k.2.1 k.2.2.1) inferInstance) ⊔
    ⨆ (j : Fin 2) (s : ℕ) (_ : 1 ≤ s ∧ s < t), MeasurableSpace.comap (ε j s) inferInstance

/-- **The randomness** on one probability space, Meylahn–den Boer, SSRN:3741385 (PDF of 2021-12-06):
the coins `ω^col_i(n)`, `ω^com_i(n)` of policy (10), p. 14, and the demand noise `εᵢ(t)` of §2, p. 8.

The coins take the values `1` and `−1` with probability `1/2` each, and the whole family (both arms,
both firms, all `n ≥ 1`) is mutually independent. The noise satisfies `E[εᵢ(t) | 𝒢_t] = 0` and
`E[εᵢ(t)² | 𝒢_t] ≤ σ²` almost surely, for `t ≥ 1`. The two firms' noise in one period may be
correlated.

**Formalization Note** The paper conditions on `p(t)`, which is too weak: noise with conditional mean
zero given `p(t)` can be correlated with the current coin and biases the recursion by order
`a_n / c_n`. As `p(t)` is `𝒢_t`-measurable, the condition here implies the printed one, and noise
independent of the coins satisfies it. Integrability is a field because the conditional expectation
of a non-integrable function is `0`. Coins are indexed from `n = 1` and periods from `t = 1`; the
values at index `0` are never used. -/
structure Randomness {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (σ2 : ℝ) where
  /-- The coins `ω^a_i(n)`. -/
  ω : Arm → Fin 2 → ℕ → Ω → ℝ
  /-- The noise `εᵢ(t)`. -/
  ε : Fin 2 → ℕ → Ω → ℝ
  measurable_ω : ∀ a i n, 1 ≤ n → Measurable (ω a i n)
  ω_eq_one : ∀ a i n, 1 ≤ n → μ {x | ω a i n x = 1} = 1 / 2
  ω_eq_neg_one : ∀ a i n, 1 ≤ n → μ {x | ω a i n x = -1} = 1 / 2
  iIndepFun_ω : iIndepFun (fun k : CoinIndex => ω k.1 k.2.1 k.2.2.1) μ
  measurable_ε : ∀ i t, 1 ≤ t → Measurable (ε i t)
  integrable_ε : ∀ i t, 1 ≤ t → Integrable (ε i t) μ
  integrable_ε_sq : ∀ i t, 1 ≤ t → Integrable (fun x => ε i t x ^ 2) μ
  condExp_ε : ∀ i t, 1 ≤ t → μ[ε i t | history ω ε t] =ᵐ[μ] 0
  condExp_ε_sq : ∀ i t, 1 ≤ t →
    μ[fun x => ε i t x ^ 2 | history ω ε t] ≤ᵐ[μ] fun _ => σ2

end LearnCollude


