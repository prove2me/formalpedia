-- Prove2me | Theorems.Thm_CubicNewton_Nonconvex_min_mu_rate
-- name    : CubicNewton.Nonconvex.min_mu_rate
-- status  : Proved
-- author  : @mikedeng1
-- created : 2026-09-26T23:21:48.596987+00:00
-- url     : https://prove2.me/theorems/878bec2a-d0b9-4c92-8eac-4454fb7cefe2
-- title:
--   Theorem 1 (3.4): $\min_{1\le i\le k}\mu_L(x_i) \le \frac83\big(\frac{3(f(x_0)-f^*)}{2kL_0}\big)^{1/3}$
-- statement:
--   Let $F \subseteq \mathbb{R}^n$ be a closed convex set with nonempty interior, and let $f$ be twice differentiable on $F$, with gradient $f'(x)$ and Hessian $f''(x)$. Assume the Hessian is Lipschitz continuous on $F$ in the spectral norm (Assumption 1): for some $L > 0$,
--   $$\|f''(x) - f''(y)\| \le L\,\|x - y\| \qquad \text{for all } x, y \in F.$$
--
--   Let $x_0 \in \operatorname{int} F$ be a starting point such that $F$ contains the level set $\mathcal{L}(f(x_0)) = \{x \in \mathbb{R}^n : f(x) \le f(x_0)\}$ in its interior.
--
--   Let $0 < L_0 \le L$ and let $\{x_k\}_{k \ge 0}$ be generated by the **cubic regularization of Newton method** (3.3): $x_0$ is the starting point and, at every iteration $k \ge 0$, a parameter $M_k \in [L_0, 2L]$ is chosen such that $f(T_{M_k}(x_k)) \le \bar f_{M_k}(x_k)$, and $x_{k+1} = T_{M_k}(x_k)$. Here $T_M(x)$ is any global minimizer of the cubic model $y \mapsto \langle f'(x), y - x\rangle + \tfrac12\langle f''(x)(y - x), y - x\rangle + \tfrac{M}{6}\|y - x\|^3$ and $\bar f_M(x) = f(x) + \min_y(\text{cubic model})$. Assume $f$ is bounded below on $F$: $f(x) \ge f^*$ for all $x \in F$.
--
--   For $M > 0$ the second-order optimality measure of Section 3 is
--   $$\mu_M(x) = \max\Big\{ \sqrt{\tfrac{2}{L + M}\,\|f'(x)\|},\ -\tfrac{2}{2L + M}\,\lambda_n(f''(x)) \Big\},$$
--   where $\lambda_n$ denotes the smallest eigenvalue. Then for any $k \ge 1$,
--   $$\min_{1 \le i \le k} \mu_L(x_i) \le \frac{8}{3}\cdot\left(\frac{3\,\big(f(x_0) - f^*\big)}{2k\cdot L_0}\right)^{1/3}.$$
--   This is the global rate of convergence of the cubic regularization of Newton method to second-order stationary points, for an arbitrary (nonconvex) objective with a Lipschitz Hessian. In particular $\min_{1\le i\le k}\|f'(x_i)\| \le O(k^{-2/3})$, compared with $O(k^{-1/2})$ for the gradient method.
--
--   **Formalization Note** The space is `EuclideanSpace ℝ (Fin n)`. The gradient and Hessian are given as maps `g` and `H` with `HasGradientAt f (g x) x` and `HasFDerivAt g (H x) x` at every `x ∈ F` (two-sided derivatives, also at boundary points of $F$); the operator norm on `H x` is the spectral norm. A run is the predicate `IsCubicNewtonRun` on the sequences `x : ℕ → E` and `M : ℕ → ℝ`, 0-based as in the paper, with $\bar f_{M_k}(x_k)$ written as `f (x k) + cubicModel g H (M k) (x k) (x (k+1))`, which equals the minimum because $x_{k+1}$ attains it. The level-set hypothesis is written `{x | f x ≤ f x₀} ⊆ interior F`, for $f$ defined on all of $\mathbb{R}^n$ as in problem (3.1). $\lambda_n$ is `lamMin`, the Rayleigh-quotient infimum over the unit sphere (for $n = 0$ it is $0$). The minimum over $1 \le i \le k$ is written as the existence of an index $i$ with $1 \le i \le k$ whose value is at most the bound, which is equivalent for a finite nonempty index set. The cube root is `Real.rpow` with exponent `1/3` on a nonnegative base.
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, DOI 10.1007/s10107-006-0706-8, p. 185, Theorem 1, inequality (3.4)

import Mathlib
import Definitions.Def_CubicNewton_Shared_IsCubicNewtonRun
import Definitions.Def_CubicNewton_Nonconvex_muMeasure

open scoped RealInnerProductSpace

namespace CubicNewton.Nonconvex

/-- Nesterov–Polyak 2006, Theorem 1, inequality (3.4), p. 185: along every run of method (3.3),
for every `k ≥ 1`,
`min_{1 ≤ i ≤ k} μ_L(x_i) ≤ (8/3)·(3(f(x₀) − f*)/(2k·L₀))^{1/3}`.
The minimum over the finite index set is written as the existence of an index attaining the bound. -/
theorem min_mu_rate {n : ℕ}
    (F : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L : ℝ)
    (hF_closed : IsClosed F) (hF_convex : Convex ℝ F)
    (hf : ∀ x ∈ F, HasGradientAt f (g x) x) (hg : ∀ x ∈ F, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x ∈ F, ∀ y ∈ F, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (x₀ : EuclideanSpace ℝ (Fin n)) (hx₀ : x₀ ∈ interior F)
    (hlevel : {x | f x ≤ f x₀} ⊆ interior F)
    (L₀ : ℝ) (hL₀ : 0 < L₀) (hL₀L : L₀ ≤ L)
    (fstar : ℝ) (hfstar : ∀ y ∈ F, fstar ≤ f y)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ) (hrun : CubicNewton.Shared.IsCubicNewtonRun f g H L₀ L x₀ x M)
    (k : ℕ) (hk : 1 ≤ k) :
    ∃ i, 1 ≤ i ∧ i ≤ k ∧
      muMeasure L L g H (x i) ≤ 8 / 3 * (3 * (f x₀ - fstar) / (2 * k * L₀)) ^ (1 / 3 : ℝ) := by sorry

end CubicNewton.Nonconvex
