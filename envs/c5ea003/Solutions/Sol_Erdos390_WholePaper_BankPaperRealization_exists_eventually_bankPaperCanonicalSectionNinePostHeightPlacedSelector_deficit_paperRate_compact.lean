        |fourFiveAnchoredLogLogCellAtom A n|) <=
        fourFiveCompactReciprocalMass := by
  have hA2 : 2 <= A :=
    fourFiveReciprocalBVSafeCutoff_ge_two.trans hA
  have hdisc := abs_fourFiveReciprocalPrimeDiscrepancy_le_uniform hA hAY
