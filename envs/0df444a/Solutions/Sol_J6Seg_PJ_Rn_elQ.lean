  have := List.getD_map L 0 (n := i) (fun j : ℕ => (j : ℤ)); simpa only [Lg, Nat.cast_zero] using this

theorem den_flE {w : Vr} {L : List ℕ} {m q x mw cB : ℕ} (h1 : w 1 = q) (h2 : w 2 = x)
    (h28 : w 28 = m) (h11 : w 11 = mw) (h12 : w 12 = cB) (h5 : w 5 = Lg L (x / m))
    (h6 : w 6 = Lg L q) (h7 : w 7 = Lg L (x % m)) :
    flE.den w = if q < x / m ∧ q < x % m ∧ bandS mw cB (Lg L (x / m)) (Lg L q) ∧
      bandS mw cB (Lg L q) (Lg L (x % m)) then 1 else 0 := by
  have ei : ((x : ℤ) / (m : ℤ)) = ((x / m : ℕ) : ℤ) := (Int.natCast_div x m).symm
  have ek : ((x : ℤ) % (m : ℤ)) = ((x % m : ℕ) : ℤ) := (Int.natCast_mod x m).symm
  have a1 := den_bSE (v := w) (x := .r 5) (y := .r 6) h11 h12 h5 h6
  have a2 := den_bSE (v := w) (x := .r 6) (y := .r 7) h11 h12 h6 h7
  simp only [flE, E.den, den_ltE, iE, kE, h1, h2, h28, ei, ek, a1, a2]
  split_ifs <;> simp_all <;> omega

theorem den_nwE {w : Vr} {Q : ℕ} {P : Prop} [Decidable P] (h9 : w 9 = 2 ^ Q)
    (h10 : w 10 = 2 ^ (Q + 1)) (h5 : w 5 = if P then 1 else 0) :
    nwE.den w = if P then w 4 - fmul Q (fdiv Q (w 6) (w 7)) (w 8) else w 4 := by
  have h := den_fmE h9 h10 (fdE (.r 6) (.r 7)) (.r 8)
  rw [den_fdE h9] at h
  simp only [nwE, E.den] at h ⊢
  simp only [h, h5]; split_ifs <;> simp_all

/-- **What the body does.** -/
theorem elB_run (h9 : v 9 = 2 ^ Q) (h10 : v 10 = 2 ^ (Q + 1)) (h11 : v 11 = mw)
    (h12 : v 12 = cB) (h28 : v 28 = m) (h1 : v 1 = q) (h2 : v 2 = x)
    (hM : c 14 = matL F m) (hL : c 30 = L.map (fun j : ℕ => (j : ℤ))) (hq : q < m) (hx : x < m * m) :
    (runL elB (v, c)).2 = update c 16 (stepI Q (bandS mw cB) L q F (x / m) (x % m) :: c 16) := by
  have hm : 0 < m := by omega
  have hi : x / m < m := Nat.div_lt_of_lt_mul hx
  have hk : x % m < m := Nat.mod_lt _ hm
  have ei : ((x : ℤ) / (m : ℤ)) = ((x / m : ℕ) : ℤ) := (Int.natCast_div x m).symm
  have ek : ((x : ℤ) % (m : ℤ)) = ((x % m : ℕ) : ℤ) := (Int.natCast_mod x m).symm
  have g0 : (matL F m).getD x 0 = F (x / m) (x % m) := matL_getD F hx
  have g1 : (matL F m).getD (x / m * m + q) 0 = F (x / m) q := matL_get2 F hi hq
  have g2 : (matL F m).getD (q * m + q) 0 = F q q := matL_get2 F hq hq
  have g3 : (matL F m).getD (q * m + x % m) 0 = F q (x % m) := matL_get2 F hq hk
  have e1 : ((x / m : ℕ) : ℤ) * m + q = ((x / m * m + q : ℕ) : ℤ) := by push_cast; ring
  have e2 : (q : ℤ) * m + q = ((q * m + q : ℕ) : ℤ) := by push_cast; ring
  have e3 : (q : ℤ) * m + ((x % m : ℕ) : ℤ) = ((q * m + x % m : ℕ) : ℤ) := by push_cast; ring
  simp (disch := decide) only [elB, runL, Ins.run, E.den, iE, kE, update_of_ne, update_self, h1,
    h2, h28, h11, h12, hM, hL, ei, ek, e1, e2, e3, Int.toNat_natCast, g0, g1, g2, g3, castL_getD]
  congr 2
  rw [den_nwE (Q := Q) (P := q < x / m ∧ q < x % m ∧ bandS mw cB (Lg L (x / m)) (Lg L q) ∧
      bandS mw cB (Lg L q) (Lg L (x % m)))]
  · simp (disch := decide) only [update_of_ne, update_self, stepI]
  · simp (disch := decide) only [update_of_ne, update_self, h9]
  · simp (disch := decide) only [update_of_ne, update_self, h10]
  · simp (disch := decide) only [update_of_ne, update_self]
    exact den_flE (by simp (disch := decide) only [update_of_ne, update_self, h1])
      (by simp (disch := decide) only [update_of_ne, update_self, h2])
      (by simp (disch := decide) only [update_of_ne, update_self, h28])
      (by simp (disch := decide) only [update_of_ne, update_self, h11])
      (by simp (disch := decide) only [update_of_ne, update_self, h12])
      (by simp (disch := decide) only [update_of_ne, update_self])
      (by simp (disch := decide) only [update_of_ne, update_self])
      (by simp (disch := decide) only [update_of_ne, update_self])

/-- The body only writes `4`–`8` and `29`. -/
theorem elB_fr (st : Vr × Cs) (j : Fin HS) (hj : j ∉ ([4, 5, 6, 7, 8, 29] : List (Fin HS))) :
    (runL elB st).1 j = st.1 j := by
  obtain ⟨v, c⟩ := st
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
  obtain ⟨j4, j5, j6, j7, j8, j29⟩ := hj
  simp only [elB, runL, Ins.run, update_apply, j4, j5, j6, j7, j8, j29, if_false]

/-- **The body's side conditions.** -/
theorem elB_ok {W N : ℕ} (hW : 1 ≤ W) (h9 : v 9 = 2 ^ Q) (h10 : v 10 = 2 ^ (Q + 1))
    (h11 : v 11 = mw) (h12 : v 12 = cB) (h28 : v 28 = m) (h1 : v 1 = q) (h2 : v 2 = x)
    (hM : c 14 = matL F m) (hL : c 30 = L.map (fun j : ℕ => (j : ℤ))) (hLm : L.length = m)
    (hq : q < m) (hx : x < m * m) (hN : m * m + m ≤ N) (hMb : ∀ y ∈ matL F m, |y| ≤ 2 ^ W)
    (hLb : ∀ j ∈ L, j ≤ 2 ^ W) : OkL W N elB (v, c) := by
  have hm : 0 < m := by omega
  have hi : x / m < m := Nat.div_lt_of_lt_mul hx
  have hk : x % m < m := Nat.mod_lt _ hm
  have ei : ((x : ℤ) / (m : ℤ)) = ((x / m : ℕ) : ℤ) := (Int.natCast_div x m).symm
  have ek : ((x : ℤ) % (m : ℤ)) = ((x % m : ℕ) : ℤ) := (Int.natCast_mod x m).symm
  have e1 : ((x / m : ℕ) : ℤ) * m + q = ((x / m * m + q : ℕ) : ℤ) := by push_cast; ring
  have e2 : (q : ℤ) * m + q = ((q * m + q : ℕ) : ℤ) := by push_cast; ring
  have e3 : (q : ℤ) * m + ((x % m : ℕ) : ℤ) = ((q * m + x % m : ℕ) : ℤ) := by push_cast; ring
  have h2W : (2 : ℕ) ≤ 2 ^ W := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW
  simp (disch := decide) only [elB, OkL, runL, Ins.run, Ins.ok, E.den, iE, kE, update_of_ne,
    update_self, h1, h2, h28, h11, h12, hM, hL, ei, ek, e1, e2, e3, Int.toNat_natCast, castL_getD,
    matL_length, List.length_map, hLm]
  rw [den_flE (L := L) (m := m) (q := q) (x := x) (mw := mw) (cB := cB)]
  all_goals try (simp (disch := decide) only [update_of_ne, update_self, h1, h2, h28, h11, h12]; done)
  have hLb' : ∀ y ∈ L.map (fun j : ℕ => (j : ℤ)), |y| ≤ 2 ^ W := by
    intro y hy; simp only [List.mem_map] at hy; obtain ⟨j, hj, rfl⟩ := hy
    simp only [Nat.abs_cast]; exact_mod_cast hLb j hj
  and_intros
  have h1W : (1 : ℤ) ≤ 2 ^ W := one_le_pow₀ (by norm_num)
  all_goals first | assumption | (push_cast; omega) | positivity | decide | exact le_trans (by decide) h2W | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | exact_mod_cast idx_lt hi hq | exact_mod_cast idx_lt hq hq | exact_mod_cast idx_lt hq hk | skip
  done

end run

end J6Seg.PJ

