theorem OAI.CubicEisenstein.ramifiedSourceFunction_omega_sq_translate (A B : ℤ) (w : HyperbolicSpace) :
    ramifiedSourceFunction (omega^2)
      (complexMatrix (upperTranslation (ActualEisensteinCoordinates.eval A B)) • w)=
      eisEmbedding (cubicExp (-(A+B)))*ramifiedSourceFunction (omega^2) w := by sorry
