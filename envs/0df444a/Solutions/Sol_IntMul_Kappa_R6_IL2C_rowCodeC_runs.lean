theorem q3 {Q : ℕ} (hQ : Q ≤ l.QL) : 3 * ((Q : ℤ) * Q) < 2 ^ Bb := by
  have h1 : Q * Q ≤ M := le_trans (Nat.mul_le_mul hQ hQ) hV.qqM
  have : ((8 * M : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hV.hbig
  push_cast at this
  have : ((Q * Q : ℕ) : ℤ) ≤ M := by exact_mod_cast h1
  push_cast at this
  have : (0 : ℤ) ≤ M := by positivity
  linarith

