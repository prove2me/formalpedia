variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
theorem solution {s : ℕ} (J : P8Lift.Prop8IfaceR W m s) (hW : 0 < W) {r n : ℕ} (hr : 0 < r)
    {st : Fin m × κ → ℕ} (hs : NLogN.KFN.SLaws st n) (ha : ∀ i, 2 * st i ∣ n)
    (code : P8Lift.RStep (Fin W) m → ℕ → NLogN.IStmt NLogN.HS Pp) (e dw : P8Lift.RStep (Fin W) m → ℕ)
    (cost : P8Lift.RStep (Fin W) m → ℕ → ℕ)
    (h : ∀ a ∈ J.net, NLogN.KFN.RImplI Isym iprog r n st (a.den (Butterfly.tens Butterfly.Cm)) (code a) (e a) (dw a) (cost a)) :
    NLogN.KFN.SImplI Isym iprog r st (W * n) (Butterfly.tens Butterfly.Cm) (NLogN.KFN.seqLI code dw J.net) (J.net.map e).sum
      (J.net.map dw).sum (NLogN.KFN.costL cost dw J.net) := by
  have H := NLogN.KFN.rImplI_list hs (Butterfly.tens Butterfly.Cm : Butterfly.Op κ) code e dw cost J.net h
  rw [J.correct κ] at H
  exact NLogN.KFN.sImplI_of_rImplI_roleDiag hW hs ha hr H
end
