section
-- Source module: Solutions.J6SegLn3
/-!
# Segmented inverse (S2), machine side 3: the sparse elimination in closed form

For the elimination `geSolveS P S L A b` along `L = [l₀, l₁, …]` (no repetitions), with the
matrices `Aseq L A r` and right-hand sides `bseq L A b r` after `r` pivots:

* **`bseq_closed`**: `bseq r i = b i − ∑_{q < r, S i l_q} fmul (F_q i) (bt q)` where
  `F_q i = fdiv (A_q i l_q) (A_q l_q l_q)` and `bt q = bseq q l_q` (forward substitution: every
  pivot step subtracts one rounded term);
* **`geSolveS_closed`**: `z l_r = fdiv (bt r − ∑_{k ∈ tail, S l_r k} fmul (A_r l_r k) (z k)) (A_r l_r l_r)`
  (back substitution with the final values `z`);
* `geSolveS_off`: `z k = 0` off `L`.

Everything data-independent (`A_q`, hence all multipliers and pivots) can be precomputed; the
data enter only through `bt` and `z`.
-/

open Finset

namespace J6Seg

section closed
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

lemma geSolveS_cons (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (k : ℕ) :
    geSolveS P S (j :: L) A b k = if k = j then
      fdiv P (b j - ∑ k' ∈ L.toFinset.filter (fun k' => S j k'),
        fmul P (A j k') (geSolveS P S L (stepA P S j A) (stepB P S j A b) k')) (A j j)
      else geSolveS P S L (stepA P S j A) (stepB P S j A b) k := rfl

/-- `geSolveS` vanishes off `L`. -/
theorem geSolveS_off : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (k : ℕ), k ∉ L →
    geSolveS P S L A b k = 0
  | [], _, _, _, _ => rfl
  | j :: L, A, b, k, hk => by
    rw [geSolveS_cons]
    simp only [List.mem_cons, not_or] at hk
    rw [if_neg hk.1]
    exact geSolveS_off L _ _ k hk.2

lemma Aseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) : Aseq P S (j :: L) A 0 = A := rfl
lemma Aseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (q : ℕ) :
    Aseq P S (j :: L) A (q + 1) = Aseq P S L (stepA P S j A) q := rfl
lemma bseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) : bseq P S (j :: L) A b 0 = b := rfl
lemma bseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (q : ℕ) :
    bseq P S (j :: L) A b (q + 1) = bseq P S L (stepA P S j A) (stepB P S j A b) q := rfl

/-- **Forward substitution in closed form.** -/
theorem bseq_closed : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (r : ℕ), r ≤ L.length →
    ∀ i, bseq P S L A b r i = b i - ∑ q ∈ (range r).filter (fun q => S i (L.getD q 0)),
      fmul P (fdiv P (Aseq P S L A q i (L.getD q 0)) (Aseq P S L A q (L.getD q 0) (L.getD q 0)))
        (bseq P S L A b q (L.getD q 0))
  | [], A, b, r, hr, i => by
    simp at hr; subst hr; simp [bseq]
  | j :: L, A, b, 0, _, i => by simp [bseq]
  | j :: L, A, b, r + 1, hr, i => by
    simp only [List.length_cons] at hr
    have ih := bseq_closed L (stepA P S j A) (stepB P S j A b) r (by omega) i
    rw [bseq_succ, ih, Finset.sum_filter, Finset.sum_filter, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, Aseq_succ, bseq_succ, Aseq_zero,
      bseq_zero, stepB]
    split_ifs <;> ring

end closed

end J6Seg

end

section
-- Source module: Solutions.J6SegLn4
/-!
# Segmented inverse (S2), machine side 4: the capacitance solve as list kernels

The per-line work on the near-boundary positions `L = Jlist B = [j₀ < j₁ < …]` is done by two
list kernels driven by precomputed (data-independent) coefficient streams:

* `fwdK fs Y []`: for `r = 0, 1, …`: `bt_r = Y_r − ∑_i fmul (fs_r)_i bt_{r-1-i}` (the accumulator
  holds the previous values, most recent first); the result is `[bt_{m-1}, …, bt_0]`;
* `bwdK bs bt [] []`: for `r = m-1, …, 0` with the record `(cb, cz, pv, fl)`:
  `z_r = fdiv (bt_r − ∑ fmul cb_i z_{r+1+i} − ∑ fmul cz_i ZB_i) pv`, where `ZB` holds the
  `z` of the border indices computed so far (`fl = 1` marks a border index); the result is
  `[z₀, …, z_{m-1}]`.

**`fwdK_eq`**, **`bwdK_eq`**: with the coefficient streams `fsOf`, `bsOf` of the line (built from
`Aseq` of the pattern-restricted elimination of `capI`), `fwdK` computes the forward values
`bseq r j_r` and `bwdK` the solution `geSolveS … j_r`, given the support facts of the pattern
(`FwdSupp`, `BwdSupp`).
-/

open Finset

namespace J6Seg

section fwd
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ)

variable {P S L A b}

theorem bt_window (r c : ℕ) (hr : r ≤ L.length) (hs : FwdSupp (S := S) (L := L) r c) :
    btV P S L A b r = b (L.getD r 0) -
      ∑ i ∈ range c, fmul P (fco P S L A r (r - 1 - i)) (btV P S L A b (r - 1 - i)) := by
  have hc := hs.1
  unfold btV
  rw [bseq_closed P S L A b r hr]
  congr 1
  rw [Finset.sum_filter]
  -- reindex `q = r - 1 - i` on `[r - c, r)`; the terms below `r - c` vanish
  have hsplit : ∑ q ∈ range r, (if S (L.getD r 0) (L.getD q 0) then
      fmul P (fdiv P (Aseq P S L A q (L.getD r 0) (L.getD q 0))
        (Aseq P S L A q (L.getD q 0) (L.getD q 0))) (bseq P S L A b q (L.getD q 0)) else 0) =
      ∑ q ∈ Ico (r - c) r, fmul P (fco P S L A r q) (bseq P S L A b q (L.getD q 0)) := by
    rw [← Finset.sum_range_add_sum_Ico _ (show r - c ≤ r by omega)]
    rw [Finset.sum_eq_zero (fun q hq => by
      simp only [Finset.mem_range] at hq
      rw [if_neg (hs.2 q hq)]), zero_add]
    refine Finset.sum_congr rfl (fun q hq => ?_)
    unfold fco
    split_ifs
    · rfl
    · rw [fmul_zero_left P]
  rw [hsplit, Finset.sum_Ico_eq_sum_range]
  rw [show r - (r - c) = c by omega]
  rw [← Finset.sum_range_reflect]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  simp only [Finset.mem_range] at hi
  rw [show r - c + (c - 1 - i) = r - 1 - i by omega]

lemma accF_getD {k i : ℕ} (hi : i < k) : (accF (P := P) (S := S) (L := L) (A := A) (b := b) k).getD i 0 =
    btV P S L A b (k - 1 - i) := by
  unfold accF
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_reverse]
  simp only [List.getElem_map, List.getElem_range, List.length_map, List.length_range]

end fwd

end J6Seg

end

section
-- Source module: Solutions.J6SegLn7
/-!
# Segmented inverse (S2), machine side 7: the capacitance solve of one line as list kernels

For the pattern `S = bandS (λ+w) c` (`c = s - λ - w`, border `bd = (c ≤ ·)`) on the sorted
line `L = Jlist B`:

* `WbOf r` (backward band window): the number of later line positions within `λ + w` of `L_r`;
* `cfOf r` (forward window): all previous rows on border rows, else the number of previous line
  positions within `λ + w`;
* **`jsolve_eq`**: `bwdK (records) (fwdK (forward streams) [Y_{L_r}]_r [])` is the list of the
  solution `geSolveS … Y` at `L_0, …, L_{m-1}`, for every right-hand side `Y`.

All windows and streams depend only on `s, t, λ, w` and the tables (not on the data).
-/

open Finset

namespace J6Seg

section jsolve
variable (P : ℕ) (L : List ℕ) (mw c : ℕ) (A : ℕ → ℕ → ℤ)

variable {P L mw c A}

lemma getD_lt_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i < j) (hj : j < L.length) :
    L.getD i 0 < L.getD j 0 := by
  rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ hj]
  exact (List.pairwise_iff_getElem.1 hsort) i j (by omega) hj hij

lemma getD_le_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i ≤ j) (hj : j < L.length) :
    L.getD i 0 ≤ L.getD j 0 := by
  rcases Nat.lt_or_ge i j with h | h
  · exact (getD_lt_getD hsort h hj).le
  · rw [show i = j by omega]

theorem fwdSupp_of (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    FwdSupp (S := bandS mw c) (L := L) r (cfOf L mw c r) := by
  unfold cfOf
  split_ifs with hb
  · exact ⟨le_rfl, fun q hq => absurd hq (by omega)⟩
  · refine ⟨(card_filter_le _ _).trans (by simp), fun q hq hS => ?_⟩
    have hqr : L.getD q 0 < L.getD r 0 := getD_lt_getD hsort (by omega) hr
    have hband : L.getD r 0 ≤ L.getD q 0 + mw := by
      unfold bandS at hS; omega
    -- every row in `[q, r)` is in the window
    have hsub : Ico q r ⊆ (range r).filter (fun q' => L.getD r 0 ≤ L.getD q' 0 + mw) := by
      intro q' hq'
      rw [mem_Ico] at hq'
      rw [mem_filter, mem_range]
      refine ⟨hq'.2, ?_⟩
      have := getD_le_getD hsort hq'.1 (by omega)
      omega
    have := card_le_card hsub
    rw [Nat.card_Ico] at this
    omega

end jsolve

end J6Seg

end

