-- title:
--   The finite-evidence history topology
-- statement:
--   Fix a history $H$. A **basic neighborhood** of $H$ is built recursively: include $H$; for each included history $\Gamma$, choose a finite set $F_\Gamma\subseteq\mathrm{end}(\Gamma)$ and include every one-step extension $\Gamma^\frown M$ with $M\in\mathcal X$ and $F_\Gamma\subseteq M\subsetneq\mathrm{end}(\Gamma)$; continue through all finite depths. The finite set may depend on the whole history, not only on its endpoint. The **finite-evidence history topology** on the set of all histories is generated by all basic neighborhoods, for all starting histories and all choices of finite sets.
--
--   **Formalization Note** The choices are a total rule `f` on histories with `f Γ ⊆ end(Γ)`; its values at histories that are never included are unused. The topology is a `def`, used as `IsOpen[historyTopology X]`.
-- source:
--   Kleinberg, Wei, Characterizing Local Breadth in Language Generation, STOC 2027 submission (manuscript sha256 f924cbfc…), Definition 5.3, p.25

import Mathlib
import Definitions.Def_LocalBreadth_History

namespace LocalBreadth

variable (X : Set (Set ℤ))

/-- A finite-test rule (Definition 5.3): one finite set `F_Γ ⊆ end(Γ)` for each history `Γ`.

**Formalization Note.** The rule is total; its values on histories that are not included are unused. -/
def IsTestRule (f : History X → Finset ℤ) : Prop := ∀ Γ, (f Γ : Set ℤ) ⊆ Γ.last

/-- The histories included when the recursion of Definition 5.3 starts at `H`, under the rule `f`:
start with `H`, and from an included `Γ` include every `Γ⌢M` with `F_Γ ⊆ M ⊊ end(Γ)`, `M ∈ X`. -/
inductive Reach (f : History X → Finset ℤ) (H : History X) : History X → Prop
  | base : Reach f H H
  | step {Γ : History X} (hΓ : Reach f H Γ) (M : Set ℤ) (hM : M ∈ X) (hlt : M ⊂ Γ.last)
      (hF : (f Γ : Set ℤ) ⊆ M) : Reach f H (Γ.snoc M hM hlt)

/-- A **basic neighborhood** of `H`. Kleinberg, Wei, STOC 2027 submission (manuscript sha256
f924cbfc…), Definition 5.3, p.25. -/
def basicNhd (H : History X) (f : History X → Finset ℤ) : Set (History X) := {Γ | Reach X f H Γ}

/-- All basic neighborhoods, for all starting histories and all choices of finite sets. -/
def basicSets : Set (Set (History X)) :=
  {U | ∃ (H : History X) (f : History X → Finset ℤ), IsTestRule X f ∧ U = basicNhd X H f}

/-- The **finite-evidence history topology**, Definition 5.3, p.25: the topology generated by the
basic neighborhoods.

**Formalization Note.** A `def`, used through `IsOpen[historyTopology X]`, rather than an instance. -/
@[instance_reducible] def historyTopology : TopologicalSpace (History X) :=
  TopologicalSpace.generateFrom (basicSets X)

end LocalBreadth


