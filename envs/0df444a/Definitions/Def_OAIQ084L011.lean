theorem coupledIndex_bounds {n m : ℕ} (i : CoupledIndex n m) :
    i.1.val ≤ n ∧ i.1.val ≤ m ∧ i.2.val ≤ n+m-2*i.1.val := by
  have hz := i.1.isLt
  have hk := i.2.isLt
  have h₁ := min_le_left n m
  have h₂ := min_le_right n m
  omega



