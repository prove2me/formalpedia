-- title:
--   The information $\mathcal F_k$ of the first $k-1$ iterations
-- statement:
--   With $N_{k-1}=D_1+\dots+D_{k-1}$,
--   $$\mathcal F_k=\sigma\big(U_j,V_j:1\le j\le N_{k-1};\ Z_1,\dots,Z_{k-1}\big),$$
--   the σ-algebra generated by the primitives of every customer who entered service in cycles $1,\dots,k-1$ and by the coordinate draws of iterations $1,\dots,k-1$. In particular $\mathcal F_1$ is trivial.
--
--   It is the conditioning σ-algebra of the bias $B_k$ in (4).
-- source:
--   Chen, Liu, Hong, An Online Learning Approach to Dynamic Pricing and Capacity Sizing in Service Systems, arXiv:2009.02911v3, (4), p.13; p.68 ('xₖ ∈ 𝓕ₖ')

import Mathlib
import Definitions.Def_GOLiQ_Primitives

set_option warn.classDefReducibility false

namespace GOLiQ

/-- **The information `𝓕ₖ` available at the start of iteration `k`** (Chen, Liu, Hong,
arXiv:2009.02911v3, (4), p.13: "the σ-algebra including all events in the first `k − 1`
iterations").

With `Nₖ₋₁ = D₁ + ⋯ + Dₖ₋₁`, `𝓕ₖ = σ(Uⱼ, Vⱼ : 1 ≤ j ≤ Nₖ₋₁; Z₁, …, Zₖ₋₁)`: the primitives of every
customer who entered service in cycles `1, …, k − 1`, and the coordinate draws of iterations
`1, …, k − 1`. In particular `𝓕₁` is trivial. -/
def Primitives.info {Ω : Type*} [MeasurableSpace Ω] (Pr : Primitives Ω) (D : ℕ → ℕ) (k : ℕ) :
    MeasurableSpace Ω :=
  (⨆ j ∈ Finset.Icc 1 (∑ i ∈ Finset.Icc 1 (k - 1), D i),
      (MeasurableSpace.comap (Pr.U j) inferInstance ⊔ MeasurableSpace.comap (Pr.V j) inferInstance)) ⊔
    ⨆ i ∈ Finset.Icc 1 (k - 1), MeasurableSpace.comap (Pr.Z i) inferInstance

end GOLiQ


