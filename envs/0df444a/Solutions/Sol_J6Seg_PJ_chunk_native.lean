-- Source module: Solutions.J6QLUBound
/-!
# Bounds on the inverse coefficients `a^±_h`

Under `α ≥ 2`, `σ ≥ 1` and `θ ≤ σ - 2|b|` (in the report `θ = σ - 1`, `|b| ≤ 1/2`):
`|a^±_h| ≤ 1.0001 · e^{-πα²θh}` for every `h`.  (The hypothesis `α²θ ≥ 1` is not needed.)
The key facts are `(q;q)_h ≥ 1 - 2q` for `0 ≤ q ≤ 1/2` and `q = e^{-2πα²σ} ≤ 2^{-24}`.
-/

open Finset Real

namespace J6QLU

lemma one_sub_sum_le_qpoch {q : ℝ} (h0 : 0 ≤ q) (h1 : q ≤ 1) (n : ℕ) :
    1 - ∑ i ∈ range n, q ^ (i + 1) ≤ qpoch q n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [qpoch_succ, sum_range_succ]
    have ha0 : 0 ≤ q ^ (n + 1) := pow_nonneg h0 _
    have ha1 : q ^ (n + 1) ≤ 1 := pow_le_one₀ h0 h1
    have hS : 0 ≤ ∑ i ∈ range n, q ^ (i + 1) := sum_nonneg fun i _ => pow_nonneg h0 _
    nlinarith [mul_le_mul_of_nonneg_right ih (sub_nonneg.2 ha1), mul_nonneg hS ha0]

lemma geom_tail_le {q : ℝ} (h0 : 0 ≤ q) (h1 : q ≤ 1 / 2) (n : ℕ) :
    ∑ i ∈ range n, q ^ (i + 1) ≤ 2 * q := by
  induction n with
  | zero => simp; linarith
  | succ n ih =>
    rw [sum_range_succ']
    have : ∑ i ∈ range n, q ^ (i + 1 + 1) = q * ∑ i ∈ range n, q ^ (i + 1) := by
      rw [mul_sum]; exact sum_congr rfl fun i _ => by ring
    rw [this]; simp only [zero_add, pow_one]
    nlinarith

lemma qpoch_ge {q : ℝ} (h0 : 0 ≤ q) (h1 : q ≤ 1 / 2) (n : ℕ) : 1 - 2 * q ≤ qpoch q n := by
  have := one_sub_sum_le_qpoch h0 (by linarith) n
  have := geom_tail_le h0 h1 n
  linarith

lemma qR_le (α σ : ℝ) (hα : 2 ≤ α) (hσ : 1 ≤ σ) : qR α σ ≤ 1 / 2 ^ 24 := by
  have h24 : 24 ≤ 2 * π * α ^ 2 * σ := by
    have := pi_gt_three
    have : 4 ≤ α ^ 2 := by nlinarith
    have : 4 ≤ α ^ 2 * σ := by nlinarith
    nlinarith
  have he : (2 : ℝ) ^ 24 ≤ exp 24 := by
    have h2 : (2 : ℝ) ≤ exp 1 := by linarith [add_one_le_exp (1 : ℝ)]
    have : exp 24 = exp 1 ^ 24 := by rw [← Real.exp_nat_mul]; norm_num
    rw [this]; exact pow_le_pow_left₀ (by norm_num) h2 _
  rw [qR, le_div_iff₀ (by positivity)]
  calc exp (-(2 * π * α ^ 2 * σ)) * 2 ^ 24 ≤ exp (-24) * exp 24 := by
        apply mul_le_mul (exp_le_exp.2 (by linarith)) he (by positivity) (exp_pos _).le
    _ = 1 := by rw [← Real.exp_add]; simp

lemma inv_qpoch_bound (α σ : ℝ) (hα : 2 ≤ α) (hσ : 1 ≤ σ) (h : ℕ) :
    0 < qpoch (qR α σ) h ∧ 1 ≤ 1.0001 * qpoch (qR α σ) h := by
  have hq := qR_le α σ hα hσ
  have h0 := (qR_pos α σ).le
  have := qpoch_ge h0 (by linarith) h
  constructor <;> nlinarith

end J6QLU

end

