def termUb (n : Nat) : Nat :=
  let m := Nat.sub n 1
  let A := Nat.mul m m
  let A2 := Nat.mul A A
  let num := Nat.add (Nat.sub (Nat.mul 2 A2) A) 1
  let den := Nat.mul (Nat.mul 2 A2) (Nat.sub A 1)
  Nat.div (Nat.sub (Nat.add (Nat.mul 10000000000000 num) den) 1) den

def sumBlock (k : Nat) : List Nat → Nat → Nat
  | [], _ => 0
  | r :: rs, mask =>
    let n := Nat.add (Nat.mul 210 k) r
    let code := Nat.land mask 63
    let rest := sumBlock k rs (Nat.shiftRight mask 6)
    if Nat.ble n 50 then rest
    else
      let q := lookupPrime code
      if Bool.and (Nat.ble 2 q) (Bool.and (Nat.ble (Nat.add q 1) n) (Nat.beq (Nat.mod n q) 0)) then
        rest
      else
        Nat.add (termUb n) rest

def sumAllBlocks : Nat → List Nat → Nat
  | _, [] => 0
  | k, m :: ms => Nat.add (sumBlock k cop210 m) (sumAllBlocks (Nat.add k 1) ms)

