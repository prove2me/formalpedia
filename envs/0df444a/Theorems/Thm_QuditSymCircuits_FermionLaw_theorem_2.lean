-- title:
--   Theorem 2, p. 11 — under any unitary generated by 2-local SU(d)-invariant gates, Tr(Ω[ρ]^l) is conserved for every l ≥ 1
-- statement:
--   Let $V$ be a unitary on $n$ qudits in the group $\mathcal V_2$ generated by 2-local SU(d)-invariant unitaries, let $\rho$ be a density operator of the $n$ qudits, and let $\rho' = V\rho V^\dagger$. Then for every positive integer $l$,
--   $$\mathrm{Tr}\big(\Omega[\rho']^l\big) = \mathrm{Tr}\big(\Omega[\rho]^l\big),$$
--   where $\Omega$ is the completely positive linear map of Eqs. (49) and (51).
--
--   These are conservation laws for local symmetric circuits that general SU(d)-invariant unitaries violate (for $d\ge3$): in the fermionic picture they state that the spectrum of the single-particle reduced state is conserved by free-fermion dynamics.
--
--   **Formalization Note.** $\mathcal V_2$ is the subgroup of the unitary group of $(\mathbb C^d)^{\otimes n}$ generated by the unitaries $V = W_{ab}\otimes\mathbb I_{\text{rest}}$ commuting with all $U^{\otimes n}$, $U\in\mathrm{SU}(d)$, as defined on p. 3; it is not replaced by the generating set of Eq. (6). $\Omega$ is the qudit form (51), not the fermionic form (50). `[NeZero d]` makes $|0\rangle$ available.
-- source:
--   Marvian, Liu and Hulse, Qudit circuits with SU(d) symmetry, arXiv:2105.12877v2, p. 11, Theorem 2, Eq. (54)

import Mathlib
import Definitions.Def_QuditSymCircuits_FermionLaw_Model

open scoped Matrix ComplexOrder
open QuditSymCircuits.FermionLaw QAlgorithms.Entanglement

namespace QuditSymCircuits.FermionLaw

theorem theorem_2 (n d : ℕ) [NeZero d] (V : Matrix.unitaryGroup (Fin n → Fin d) ℂ)
    (hV : V ∈ twoLocalGroup n d) (ρ : Op n d) (hρ : ρ.PosSemidef) (hρ1 : ρ.trace = 1)
    (l : ℕ) (hl : 0 < l) :
    ((omega n d ((V : Op n d) * ρ * star (V : Op n d))) ^ l).trace =
      ((omega n d ρ) ^ l).trace := by sorry

end QuditSymCircuits.FermionLaw
