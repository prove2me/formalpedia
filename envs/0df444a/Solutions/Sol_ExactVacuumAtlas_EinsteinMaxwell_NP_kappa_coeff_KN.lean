  have hqb0 : qbarK a x ≠ 0 := qbarK_ne_zero (domReg_S hx)
  have hs0 := kn_hs0 hx
  have hSg0 : ((Sig a (x 1) (x 2) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_S hx)
  have hDl0 : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_D hx)
  have hr0 : ((Real.sqrt 2 : ℝ) : ℂ) ≠ 0 := sqrt2C_ne_zero
  have hI := Complex.I_sq))
