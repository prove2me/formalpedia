/-! # Möbius maps: basic facts used by the reduction of Monod's Theorem 1 -/

namespace Monod.Dev.Red

open Monod OnePoint Filter Topology

theorem mob_mul {A : Subring ℝ} (g h : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (g * h) x = mob g (mob h x) := by
  simp only [mob, map_mul, mul_smul]

theorem mob_one {A : Subring ℝ} (x : OnePoint ℝ) :
    mob (1 : Matrix.SpecialLinearGroup (Fin 2) A) x = x := by
  simp only [mob, map_one, one_smul]

theorem mob_inv_mob {A : Subring ℝ} (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g⁻¹ (mob g x) = x := by
  rw [← mob_mul, inv_mul_cancel, mob_one]

/-- A scalar matrix acts trivially on the projective line. -/
theorem smul_eq_self_of_scalar (γ : GL (Fin 2) ℝ) (hγ : γ.val ∈ Set.range (Matrix.scalar (Fin 2)))
    (x : OnePoint ℝ) : γ • x = x := by
  obtain ⟨a, ha⟩ := hγ
  have h10 : γ 1 0 = 0 := by rw [← ha]; simp
  have h01 : γ 0 1 = 0 := by rw [← ha]; simp
  have h00 : γ 0 0 = a := by rw [← ha]; simp
  have h11 : γ 1 1 = a := by rw [← ha]; simp
  have hdet := γ.det_ne_zero
  rw [Matrix.det_fin_two] at hdet
  change γ.val 0 0 * γ.val 1 1 - γ.val 0 1 * γ.val 1 0 ≠ 0 at hdet
  have ha0 : a ≠ 0 := by
    intro h0
    apply hdet
    rw [h00, h11, h01, h10, h0]; ring
  cases x with
  | infty => rw [OnePoint.smul_infty_eq_self_iff]; exact h10
  | coe k =>
    rw [OnePoint.smul_some_eq_ite, h10, h11, h00, h01]
    simp [ha0]

/-- An element of `GL(2, ℝ)` fixing infinitely many real points acts trivially. -/
theorem smul_eq_self_of_infinite (γ : GL (Fin 2) ℝ)
    (hinf : {x : ℝ | γ • (x : OnePoint ℝ) = x}.Infinite) (z : OnePoint ℝ) : γ • z = z := by
  apply smul_eq_self_of_scalar
  rw [← Matrix.GeneralLinearGroup.fixpointPolynomial_eq_zero_iff]
  apply Polynomial.eq_zero_of_infinite_isRoot
  refine hinf.mono fun x hx => ?_
  simp only [Set.mem_ofPred_eq, Polynomial.IsRoot.def] at hx ⊢
  have := (Matrix.GeneralLinearGroup.fixpointPolynomial_aeval_eq_zero_iff (c := x) (g := γ)).2 hx
  simpa [Polynomial.aeval_def] using this

/-- Identity theorem: two Möbius maps agreeing near a real point are equal. -/
theorem mob_eq_of_eventuallyEq {A : Subring ℝ} {g g' : Matrix.SpecialLinearGroup (Fin 2) A}
    {r : ℝ} (h : mob g =ᶠ[𝓝 (r : OnePoint ℝ)] mob g') : mob g = mob g' := by
  have h' : ∀ᶠ x : ℝ in 𝓝 r, mob g (x : OnePoint ℝ) = mob g' x :=
    (OnePoint.continuous_coe.tendsto r).eventually h
  have hinf : {x : ℝ | mob g (x : OnePoint ℝ) = mob g' x}.Infinite :=
    infinite_of_mem_nhds r h'
  funext z
  have key := smul_eq_self_of_infinite ((slToGL A g')⁻¹ * slToGL A g) (hinf.mono fun x hx => by
    simp only [Set.mem_ofPred_eq, mob] at hx ⊢
    rw [mul_smul, hx, inv_smul_smul]) z
  rw [mul_smul, inv_smul_eq_iff] at key
  exact key

instance countable_SL (A : Subring ℝ) [Countable A] :
    Countable (Matrix.SpecialLinearGroup (Fin 2) A) :=
  inferInstanceAs (Countable {M : Fin 2 → Fin 2 → A // Matrix.det M = 1})

theorem not_scalar_of_isHyperbolic {A : Subring ℝ} {g : Matrix.SpecialLinearGroup (Fin 2) A}
    (hg : IsHyperbolic g) : (slToGL A g).val ∉ Set.range (Matrix.scalar (Fin 2)) := by
  rintro ⟨a, ha⟩
  have e : ∀ i j, ((g i j : A) : ℝ) = Matrix.scalar (Fin 2) a i j := fun i j => by
    rw [ha]; rfl
  have h00 := e 0 0
  have h11 := e 1 1
  have h01 := e 0 1
  have h10 := e 1 0
  simp at h00 h11 h01 h10
  have hdet : ((g 0 0 : A) : ℝ) * (g 1 1 : A) - (g 0 1 : A) * (g 1 0 : A) = 1 := by
    have := g.det_coe
    rw [Matrix.det_fin_two] at this
    exact_mod_cast this
  unfold IsHyperbolic at hg
  rw [Matrix.trace_fin_two] at hg
  push_cast at hg
  rw [h00, h11] at hg hdet
  rw [h01, h10] at hdet
  have ha : |a| = 1 := by
    have : a ^ 2 = 1 := by simp at hdet; nlinarith
    rcases sq_eq_one_iff.1 this with h | h <;> simp [h]
  have : |a + a| = 2 := by rw [← two_mul, abs_mul, ha]; norm_num
  linarith

theorem countable_P (A : Subring ℝ) [Countable A] : (P A).Countable := by
  have : P A ⊆ ⋃ g : Matrix.SpecialLinearGroup (Fin 2) A,
      {p | IsHyperbolic g ∧ mob g p = p} := fun p ⟨g, hg⟩ => Set.mem_iUnion.2 ⟨g, hg⟩
  refine Set.Countable.mono this (Set.countable_iUnion fun g => ?_)
  by_cases hg : IsHyperbolic g
  · have hne : (slToGL A g).fixpointPolynomial ≠ 0 := by
      rw [Ne, Matrix.GeneralLinearGroup.fixpointPolynomial_eq_zero_iff]
      exact not_scalar_of_isHyperbolic hg
    have hfin : {x : ℝ | ((slToGL A g).fixpointPolynomial).IsRoot x}.Finite :=
      Polynomial.finite_setOfPred_isRoot hne
    refine Set.Finite.countable (((hfin.image ((↑) : ℝ → OnePoint ℝ)).insert ∞).subset ?_)
    rintro p ⟨-, hp⟩
    cases p with
    | infty => exact Set.mem_insert _ _
    | coe x =>
      refine Set.mem_insert_of_mem _ ⟨x, ?_, rfl⟩
      have := (Matrix.GeneralLinearGroup.fixpointPolynomial_aeval_eq_zero_iff
        (c := x) (g := slToGL A g)).2 hp
      simpa [Polynomial.aeval_def] using this
  · exact Set.Subsingleton.countable (fun p hp => absurd hp.1 hg)

end Monod.Dev.Red
end

section
/-! # `H(A)` is countable when `A` is countable

A piecewise projective map with breakpoints in the countable set `P_A` is determined by its
finite set of real breakpoints together with one element of the countable group `SL(2, A)` for
each of the finitely many intervals between them; `G(A)` is generated by these maps. -/

namespace Monod.Dev.Red

open Monod OnePoint Filter Topology

/-- The real points of `P_A`. -/
def realP (A : Subring ℝ) : Set ℝ := {x : ℝ | (x : OnePoint ℝ) ∈ P A}

theorem countable_realP (A : Subring ℝ) [Countable A] : (realP A).Countable :=
  (countable_P A).preimage OnePoint.coe_injective

/-- The breakpoints (from `Bc`) lying to the left of `x`: this labels the interval of `x`. -/
noncomputable def key {A : Subring ℝ} (Bc : Finset (realP A)) (x : ℝ) : Finset (realP A) :=
  Bc.filter (fun c => (c : ℝ) < x)

theorem key_mem_powerset {A : Subring ℝ} (Bc : Finset (realP A)) (x : ℝ) :
    key Bc x ∈ Bc.powerset := Finset.mem_powerset.2 (Finset.filter_subset _ _)

/-- The maps described by the finite data `(Bc, σ)`. -/
def dataSet {A : Subring ℝ} (Bc : Finset (realP A))
    (σ : {K // K ∈ Bc.powerset} → Matrix.SpecialLinearGroup (Fin 2) A) :
    Set (OnePoint ℝ ≃ₜ OnePoint ℝ) :=
  {f | ∀ x : ℝ, (∀ c ∈ Bc, (c : ℝ) ≠ x) →
    f (x : OnePoint ℝ) = mob (σ ⟨key Bc x, key_mem_powerset Bc x⟩) (x : OnePoint ℝ)}

theorem dataSet_subsingleton {A : Subring ℝ} (Bc : Finset (realP A))
    (σ : {K // K ∈ Bc.powerset} → Matrix.SpecialLinearGroup (Fin 2) A) :
    (dataSet Bc σ).Subsingleton := by
  intro f hf f' hf'
  have hfin : ((Bc.image (fun c : realP A => (c : ℝ))) : Set ℝ).Finite := Finset.finite_toSet _
  have hd : Dense (((↑) : ℝ → OnePoint ℝ) '' (Set.univ \ (Bc.image (fun c : realP A => (c : ℝ))))) :=
    OnePoint.denseRange_coe.dense_image OnePoint.continuous_coe (dense_univ.sdiff_finite hfin)
  have : (f : OnePoint ℝ → OnePoint ℝ) = f' := by
    refine Continuous.ext_on hd f.continuous f'.continuous ?_
    rintro _ ⟨x, hx, rfl⟩
    have hx' : ∀ c ∈ Bc, (c : ℝ) ≠ x := by
      intro c hc hcx
      exact hx.2 (Finset.mem_coe.2 (Finset.mem_image.2 ⟨c, hc, hcx⟩))
    rw [hf x hx', hf' x hx']
  exact Homeomorph.ext (congrFun this)

theorem mem_dataSet_of_isPiecewiseProj {A : Subring ℝ} (f : OnePoint ℝ ≃ₜ OnePoint ℝ)
    (hf : IsPiecewiseProj A f) :
    ∃ (Bc : Finset (realP A)) (σ : {K // K ∈ Bc.powerset} → Matrix.SpecialLinearGroup (Fin 2) A),
      f ∈ dataSet Bc σ := by
  classical
  obtain ⟨B, hBP, hloc⟩ := hf
  have hBfin : {c : realP A | ((c : ℝ) : OnePoint ℝ) ∈ B}.Finite :=
    B.finite_toSet.preimage (f := fun c : realP A => ((c : ℝ) : OnePoint ℝ))
      (OnePoint.coe_injective.comp Subtype.val_injective).injOn
  set Bc := hBfin.toFinset with hBc_def
  have hmemBc : ∀ c : realP A, c ∈ Bc ↔ ((c : ℝ) : OnePoint ℝ) ∈ B := fun c => by
    simp [Bc]
  have hnot : ∀ x : ℝ, (∀ c ∈ Bc, (c : ℝ) ≠ x) ↔ (x : OnePoint ℝ) ∉ B := by
    intro x
    constructor
    · intro h hx
      exact h ⟨x, hBP (Finset.mem_coe.2 hx)⟩ ((hmemBc _).2 hx) rfl
    · rintro h c hc rfl
      exact h ((hmemBc c).1 hc)
  choose g hg using fun x : ℝ => fun (hx : (x : OnePoint ℝ) ∉ B) => hloc (x : OnePoint ℝ) hx
  let σ : {K // K ∈ Bc.powerset} → Matrix.SpecialLinearGroup (Fin 2) A := fun K =>
    if h : ∃ x : ℝ, ∃ hx : (x : OnePoint ℝ) ∉ B, key Bc x = K.1 then
      g h.choose h.choose_spec.choose else 1
  refine ⟨Bc, σ, fun x hx => ?_⟩
  have hxB : (x : OnePoint ℝ) ∉ B := (hnot x).1 hx
  have hex : ∃ y : ℝ, ∃ hy : (y : OnePoint ℝ) ∉ B, key Bc y = key Bc x := ⟨x, hxB, rfl⟩
  have hσ : σ ⟨key Bc x, key_mem_powerset Bc x⟩ = g hex.choose hex.choose_spec.choose := by
    simp only [σ, dif_pos hex]
  rw [hσ]
  set y := hex.choose
  have hyB : (y : OnePoint ℝ) ∉ B := hex.choose_spec.choose
  have hky : key Bc y = key Bc x := hex.choose_spec.choose_spec
  -- the interval of `x`
  let I : Set ℝ := {z | (z : OnePoint ℝ) ∉ B ∧ key Bc z = key Bc x}
  have hkey_mono : ∀ a b : ℝ, a ≤ b → key Bc a ⊆ key Bc b := by
    intro a b hab c hc
    simp only [key, Finset.mem_filter] at hc ⊢
    exact ⟨hc.1, lt_of_lt_of_le hc.2 hab⟩
  have hI : I.OrdConnected := by
    refine ⟨fun a ha b hb z hz => ?_⟩
    have hza : key Bc a ⊆ key Bc z := hkey_mono a z hz.1
    have hzb : key Bc z ⊆ key Bc b := hkey_mono z b hz.2
    have hab : key Bc a = key Bc b := ha.2.trans hb.2.symm
    have hzB : (z : OnePoint ℝ) ∉ B := by
      intro hzB
      have hza' : a ≠ z := by rintro rfl; exact ha.1 hzB
      have hzb' : z ≠ b := by rintro rfl; exact hb.1 hzB
      let c : realP A := ⟨z, hBP (Finset.mem_coe.2 hzB)⟩
      have hcb : c ∈ key Bc b := by
        simp only [key, Finset.mem_filter]
        exact ⟨(hmemBc c).2 hzB, lt_of_le_of_ne hz.2 hzb'⟩
      rw [← hab] at hcb
      simp only [key, Finset.mem_filter] at hcb
      exact absurd hcb.2 (not_lt.2 hz.1)
    refine ⟨hzB, le_antisymm ?_ ?_ |>.trans ha.2⟩
    · rw [hab]; exact hzb
    · exact hza
  have : PreconnectedSpace I := Subtype.preconnectedSpace hI.isPreconnected
  let φ : I → OnePoint ℝ → OnePoint ℝ := fun z => mob (g z.1 z.2.1)
  have hφ : IsLocallyConstant φ := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro z
    have h1 := eventually_eventually_nhds.2 (hg z.1 z.2.1)
    have hcont : Continuous (fun w : I => ((w.1 : ℝ) : OnePoint ℝ)) :=
      OnePoint.continuous_coe.comp continuous_subtype_val
    have h2 := (hcont.tendsto z).eventually h1
    filter_upwards [h2] with w hw
    apply mob_eq_of_eventuallyEq (r := w.1)
    filter_upwards [hw, hg w.1 w.2.1] with u hu1 hu2
    rw [← hu1, hu2]
  have := hφ.apply_eq_of_preconnectedSpace ⟨x, hxB, rfl⟩ ⟨y, hyB, hky⟩
  simp only [φ] at this
  rw [← this]
  exact (hg x hxB).self_of_nhds

theorem countable_isPiecewiseProj (A : Subring ℝ) [Countable A] :
    {f | IsPiecewiseProj A f}.Countable := by
  have : Countable (realP A) := (countable_realP A).to_subtype
  have : {f | IsPiecewiseProj A f} ⊆ ⋃ (Bc : Finset (realP A))
      (σ : {K // K ∈ Bc.powerset} → Matrix.SpecialLinearGroup (Fin 2) A), dataSet Bc σ := by
    intro f hf
    obtain ⟨Bc, σ, h⟩ := mem_dataSet_of_isPiecewiseProj f hf
    exact Set.mem_iUnion₂.2 ⟨Bc, σ, h⟩
  exact Set.Countable.mono this (Set.countable_iUnion fun Bc =>
    Set.countable_iUnion fun σ => (dataSet_subsingleton Bc σ).countable)

theorem countable_G (A : Subring ℝ) [Countable A] : Countable (G A) := by
  have : Countable {f | IsPiecewiseProj A f} := (countable_isPiecewiseProj A).to_subtype
  have : ((G A : Set (OnePoint ℝ ≃ₜ OnePoint ℝ))).Countable := by
    rw [Dev.GMono.G_eq_closure_isPiecewiseProj, FreeGroup.closure_eq_range]
    exact Set.countable_range _
  exact this.to_subtype

theorem countable_H (A : Subring ℝ) [Countable A] : Countable (H A) := by
  have := countable_G A
  have : ((H A : Set (OnePoint ℝ ≃ₜ OnePoint ℝ))).Countable :=
    (Set.countable_coe_iff.1 this).mono (fun x hx => hx.1)
  exact this.to_subtype

end Monod.Dev.Red
end

section
/-! # Piecewise projective maps preserve Lebesgue-null sets

A set `S ⊆ P¹` is *null* when its real part `S ∩ ℝ` is Lebesgue-null.  Möbius maps are smooth
away from their pole, so they map null sets to null sets; a piecewise Möbius map sends `S` into a
finite set union countably many Möbius images of `S`. -/

namespace Monod.Dev.Red

open Monod OnePoint Filter Topology MeasureTheory

/-- `S ⊆ P¹` is null: its real points form a Lebesgue-null set. -/
def PNull (S : Set (OnePoint ℝ)) : Prop := volume (((↑) : ℝ → OnePoint ℝ) ⁻¹' S) = 0

theorem PNull.mono {S T : Set (OnePoint ℝ)} (hT : PNull T) (h : S ⊆ T) : PNull S :=
  measure_mono_null (Set.preimage_mono h) hT

theorem PNull.union {S T : Set (OnePoint ℝ)} (hS : PNull S) (hT : PNull T) : PNull (S ∪ T) := by
  unfold PNull at *
  rw [Set.preimage_union]
  exact measure_union_null hS hT

theorem PNull.iUnion {ι : Type*} [Countable ι] {S : ι → Set (OnePoint ℝ)} (h : ∀ i, PNull (S i)) :
    PNull (⋃ i, S i) := by
  unfold PNull at *
  rw [Set.preimage_iUnion]
  exact measure_iUnion_null h

theorem PNull.of_countable {S : Set (OnePoint ℝ)} (hS : S.Countable) : PNull S :=
  (hS.preimage OnePoint.coe_injective).measure_zero _

/-- Möbius maps send null sets to null sets. -/
theorem PNull.image_mob {A : Subring ℝ} (g : Matrix.SpecialLinearGroup (Fin 2) A)
    {S : Set (OnePoint ℝ)} (hS : PNull S) : PNull (mob g '' S) := by
  set a : ℝ := ((g 0 0 : A) : ℝ)
  set b : ℝ := ((g 0 1 : A) : ℝ)
  set c : ℝ := ((g 1 0 : A) : ℝ)
  set d : ℝ := ((g 1 1 : A) : ℝ)
  let φ : ℝ → ℝ := fun x => (a * x + b) / (c * x + d)
  let U : Set ℝ := {x | c * x + d ≠ 0}
  have hφ : DifferentiableOn ℝ φ (((↑) : ℝ → OnePoint ℝ) ⁻¹' S ∩ U) := by
    intro x hx
    apply DifferentiableAt.differentiableWithinAt
    apply DifferentiableAt.div
    · fun_prop
    · fun_prop
    · exact hx.2
  have h1 : volume (φ '' (((↑) : ℝ → OnePoint ℝ) ⁻¹' S ∩ U)) = 0 :=
    addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume hφ
      (measure_mono_null Set.inter_subset_left hS)
  have hsub : ((↑) : ℝ → OnePoint ℝ) ⁻¹' (mob g '' S) ⊆
      φ '' (((↑) : ℝ → OnePoint ℝ) ⁻¹' S ∩ U) ∪ ((↑) : ℝ → OnePoint ℝ) ⁻¹' {mob g ∞} := by
    rintro y ⟨z, hz, hzy⟩
    cases z with
    | infty => exact Or.inr (by simp [← hzy])
    | coe x =>
      left
      rw [mob, OnePoint.smul_some_eq_ite] at hzy
      split_ifs at hzy with hx
      · exact absurd hzy.symm (OnePoint.coe_ne_infty y)
      · exact ⟨x, ⟨hz, hx⟩, OnePoint.coe_injective hzy⟩
  refine measure_mono_null hsub (measure_union_null h1 ?_)
  exact (Set.countable_singleton _).preimage OnePoint.coe_injective |>.measure_zero _

/-- A map which near every point outside a finite set agrees with a Möbius map of `SL(2, A)`,
`A` countable, maps null sets to null sets and pulls null sets back to null sets. -/
theorem PNull.image_preimage_of_isPiecewiseProjOn {A : Subring ℝ} [Countable A]
    {E : Set (OnePoint ℝ)} {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : IsPiecewiseProjOn A E f)
    {S : Set (OnePoint ℝ)} (hS : PNull S) : PNull (f ⁻¹' S) ∧ PNull (f '' S) := by
  obtain ⟨B, -, hloc⟩ := hf
  have hBc : PNull (B : Set (OnePoint ℝ)) := PNull.of_countable B.finite_toSet.countable
  have hfBc : PNull (f '' (B : Set (OnePoint ℝ))) :=
    PNull.of_countable (B.finite_toSet.image _).countable
  constructor
  · refine PNull.mono (hBc.union (PNull.iUnion
      fun (g : Matrix.SpecialLinearGroup (Fin 2) A) => hS.image_mob g⁻¹)) ?_
    intro x hx
    by_cases hxB : x ∈ B
    · exact Or.inl hxB
    · obtain ⟨g, hg⟩ := hloc x hxB
      refine Or.inr (Set.mem_iUnion.2 ⟨g, f x, hx, ?_⟩)
      rw [hg.self_of_nhds, mob_inv_mob]
  · refine PNull.mono (hfBc.union (PNull.iUnion
      fun (g : Matrix.SpecialLinearGroup (Fin 2) A) => hS.image_mob g)) ?_
    rintro _ ⟨x, hx, rfl⟩
    by_cases hxB : x ∈ B
    · exact Or.inl ⟨x, hxB, rfl⟩
    · obtain ⟨g, hg⟩ := hloc x hxB
      exact Or.inr (Set.mem_iUnion.2 ⟨g, x, hx, hg.self_of_nhds.symm⟩)

/-- Every element of `G(A)`, `A` countable, preserves null sets in both directions. -/
theorem PNull.preimage_of_mem_G {A : Subring ℝ} [Countable A] {f : OnePoint ℝ ≃ₜ OnePoint ℝ}
    (hf : f ∈ G A) : ∀ S, PNull S → PNull (f ⁻¹' S) ∧ PNull (f '' S) := by
  rw [Dev.GMono.G_eq_closure_isPiecewiseProj] at hf
  induction hf using Subgroup.closure_induction with
  | mem f hf => exact fun S hS => PNull.image_preimage_of_isPiecewiseProjOn hf hS
  | one => intro S hS; exact ⟨hS, by convert hS; exact Set.image_id S⟩
  | mul f g _ _ ihf ihg =>
    intro S hS
    have e1 : ((f * g : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) ⁻¹' S =
        g ⁻¹' (f ⁻¹' S) := rfl
    have e2 : ((f * g : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) '' S =
        f '' (g '' S) := by rw [← Set.image_comp]; rfl
    rw [e1, e2]
    exact ⟨(ihg _ (ihf S hS).1).1, (ihf _ (ihg S hS).2).2⟩
  | inv f _ ihf =>
    intro S hS
    have e1 : ((f⁻¹ : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) ⁻¹' S = f '' S := by
      ext x
      simp only [Set.mem_preimage, Homeomorph.inv_apply, Set.mem_image]
      constructor
      · intro h; exact ⟨_, h, f.apply_symm_apply x⟩
      · rintro ⟨y, hy, rfl⟩; simpa using hy
    have e2 : ((f⁻¹ : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) '' S = f ⁻¹' S := by
      ext x
      simp only [Set.mem_preimage, Homeomorph.inv_apply, Set.mem_image]
      constructor
      · rintro ⟨y, hy, rfl⟩; simpa using hy
      · intro h; exact ⟨_, h, f.symm_apply_apply x⟩
    rw [e1, e2]
    exact ⟨(ihf S hS).2, (ihf S hS).1⟩

end Monod.Dev.Red
end

section
/-! # Amenable relations: changing the relation on an invariant null set

If `R` and `R'` agree off `N × X ∪ X × N`, where `N` is a measurable `μ`-null set saturated for
`R'`, and the pairs of `R` meeting `N` start from a null set, then amenability of `R` gives
amenability of `R'`.  Given a left invariant mean `P` of `R`, the mean
`P' f := P (1_{Nᶜ × Nᶜ} · f)` is one for `R'`; a partial transformation of `R'` restricted to
`Nᶜ` is a partial transformation of `R`. -/

namespace Monod.Dev.Red

open Monod MeasureTheory

variable {X : Type*} [MeasurableSpace X]

/-- A partial transformation of `R'` restricted to the complement of an `R'`-saturated set `N`
is a partial transformation of `R`, when `R` and `R'` agree off `N`. -/
def PartialTransformation.restrictCompl {R R' : Set (X × X)} {N : Set X} (hN : MeasurableSet N)
    (hsat : ∀ p ∈ R', p.1 ∈ N ↔ p.2 ∈ N)
    (hagree : ∀ p : X × X, p.1 ∉ N → p.2 ∉ N → (p ∈ R ↔ p ∈ R'))
    (φ : PartialTransformation R') : PartialTransformation R where
  dom := φ.dom ∩ Nᶜ
  cod := φ.cod ∩ Nᶜ
  measurableSet_dom := φ.measurableSet_dom.inter hN.compl
  measurableSet_cod := φ.measurableSet_cod.inter hN.compl
  e :=
    { toFun := fun a => ⟨(φ.e ⟨a, a.2.1⟩ : X), (φ.e ⟨a, a.2.1⟩).2, fun h =>
        a.2.2 ((hsat _ (φ.graph_subset ⟨a, a.2.1⟩)).2 h)⟩
      invFun := fun b => ⟨(φ.e.symm ⟨b, b.2.1⟩ : X), (φ.e.symm ⟨b, b.2.1⟩).2, fun h => by
        have := (hsat _ (φ.graph_subset (φ.e.symm ⟨b, b.2.1⟩))).1 h
        rw [MeasurableEquiv.apply_symm_apply] at this
        exact b.2.2 this⟩
      left_inv := fun a => by
        apply Subtype.ext
        simp only [Subtype.coe_eta, MeasurableEquiv.symm_apply_apply]
      right_inv := fun b => by
        apply Subtype.ext
        simp only [Subtype.coe_eta, MeasurableEquiv.apply_symm_apply]
      measurable_toFun := by
        apply Measurable.subtype_mk
        exact measurable_subtype_coe.comp
          (φ.e.measurable.comp (measurable_subtype_coe.subtype_mk))
      measurable_invFun := by
        apply Measurable.subtype_mk
        exact measurable_subtype_coe.comp
          (φ.e.symm.measurable.comp (measurable_subtype_coe.subtype_mk)) }
  graph_subset a := by
    have h1 := φ.graph_subset ⟨a, a.2.1⟩
    refine (hagree ((a : X), (φ.e ⟨a, a.2.1⟩ : X)) a.2.2 ?_).2 h1
    exact fun h => a.2.2 ((hsat _ h1).2 h)

/-- Transfer of amenability across an invariant null set. -/
theorem isAmenableRel_of_agree {μ : Measure X} {R R' : Set (X × X)} {N : Set X}
    (hN : MeasurableSet N) (hN0 : μ N = 0)
    (hsat : ∀ p ∈ R', p.1 ∈ N ↔ p.2 ∈ N)
    (hagree : ∀ p : X × X, p.1 ∉ N → p.2 ∉ N → (p ∈ R ↔ p ∈ R'))
    (hRN : RelNull μ R {p | p.1 ∈ N ∨ p.2 ∈ N})
    (hR : IsAmenableRel μ R) : IsAmenableRel μ R' := by
  classical
  obtain ⟨P, hP⟩ := hR
  set S : Set (X × X) := Nᶜ ×ˢ Nᶜ with hS
  have hSm : MeasurableSet S := hN.compl.prod hN.compl
  let T : (X × X → ℝ) → X × X → ℝ := fun f => S.indicator f
  have hT : ∀ f, IsBddMeasOn R' f → IsBddMeasOn R (T f) := by
    rintro f ⟨hfm, C, hC⟩
    refine ⟨hfm.indicator hSm, max C 0, fun p hp => ?_⟩
    by_cases hpS : p ∈ S
    · simp only [T, Set.indicator_of_mem hpS]
      exact (hC p ((hagree p hpS.1 hpS.2).1 hp)).trans (le_max_left _ _)
    · simp only [T, Set.indicator_of_notMem hpS, abs_zero]
      exact le_max_right _ _
  refine ⟨fun f => P (T f), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun f hf => hP.aemeasurable _ (hT f hf)
  · intro f g hf hg hfg
    refine hP.congr _ _ (hT f hf) (hT g hg) (measure_mono_null ?_ hfg)
    rintro _ ⟨p, ⟨hne, hpR⟩, rfl⟩
    have hpS : p ∈ S := by
      by_contra hpS
      simp [T, Set.indicator_of_notMem hpS] at hne
    refine ⟨p, ⟨fun h => hne ?_, (hagree p hpS.1 hpS.2).1 hpR⟩, rfl⟩
    simp only [T, Set.indicator_of_mem hpS, h]
  · intro f g hf hg
    have : T (f + g) = T f + T g := Set.indicator_add S f g
    rw [this]
    exact hP.add _ _ (hT f hf) (hT g hg)
  · intro c f hf
    have : T (c • f) = c • T f := by
      funext p
      by_cases hp : p ∈ S <;> simp [T, hp]
    rw [this]
    exact hP.smul _ _ (hT f hf)
  · intro f hf hpos
    refine hP.nonneg _ (hT f hf) fun p hp => ?_
    by_cases hpS : p ∈ S
    · simp only [T, Set.indicator_of_mem hpS]
      exact hpos p ((hagree p hpS.1 hpS.2).1 hp)
    · simp [T, Set.indicator_of_notMem hpS]
  · have h1 : IsBddMeasOn R (1 : X × X → ℝ) := ⟨measurable_const, 1, fun _ _ => by simp⟩
    have h1' : IsBddMeasOn R' (1 : X × X → ℝ) := ⟨measurable_const, 1, fun _ _ => by simp⟩
    refine (hP.congr _ _ (hT 1 h1') h1 (measure_mono_null ?_ hRN)).trans hP.one
    rintro _ ⟨p, ⟨hne, hpR⟩, rfl⟩
    refine ⟨p, ⟨?_, hpR⟩, rfl⟩
    by_contra hp
    simp only [Set.mem_ofPred_eq, not_or] at hp
    have hpS : p ∈ S := ⟨hp.1, hp.2⟩
    simp [T, Set.indicator_of_mem hpS] at hne
  · intro φ f hf
    let ψ := PartialTransformation.restrictCompl hN hsat hagree φ
    have hshift : T (φ.shiftRel f) = ψ.shiftRel (T f) := by
      funext p
      obtain ⟨y, z⟩ := p
      simp only [T, PartialTransformation.shiftRel, Set.indicator, S, Set.mem_prod,
        Set.mem_compl_iff]
      by_cases hy : y ∈ N
      · have : y ∉ ψ.cod := fun h => h.2 hy
        simp [hy, this]
      by_cases hz : z ∈ N
      · simp [hz]
      by_cases hc : y ∈ φ.cod
      · have hc' : y ∈ ψ.cod := ⟨hc, hy⟩
        have hx : ((φ.e.symm ⟨y, hc⟩ : φ.dom) : X) ∉ N := by
          intro h
          have := (hsat _ (φ.graph_subset (φ.e.symm ⟨y, hc⟩))).1 h
          rw [MeasurableEquiv.apply_symm_apply] at this
          exact hy this
        simp only [hy, hz, not_false_eq_true, and_self, ↓reduceIte, hc, ↓reduceDIte, hc']
        split_ifs with h
        · rfl
        · exact absurd ⟨hx, trivial⟩ h
      · have : y ∉ ψ.cod := fun h => hc h.1
        simp [hy, hz, hc, this]
    show P (T (φ.shiftRel f)) =ᵐ[μ] φ.shiftBase (P (T f))
    rw [hshift]
    refine (hP.invariant ψ _ (hT f hf)).trans ?_
    have : ∀ᵐ y ∂μ, y ∉ N := measure_mono_null (fun y hy => not_not.1 hy) hN0
    filter_upwards [this] with y hy
    simp only [PartialTransformation.shiftBase]
    by_cases hc : y ∈ φ.cod
    · have hc' : y ∈ ψ.cod := ⟨hc, hy⟩
      simp only [hc, hc', ↓reduceDIte]
      rfl
    · have : y ∉ ψ.cod := fun h => hc h.1
      simp [hc, this]

end Monod.Dev.Red
end

section
/-! # Monod, Theorem 1, as a reduction

`H(A)` is non-amenable for `A ≠ ℤ` (Monod, p. 2): pass to a countable dense `A' ≤ A`.  `H(A')`
is a countable group acting on `P¹` by homeomorphisms that preserve the Lebesgue measure class;
if it were amenable, its orbit relation would be amenable (statement C1).  By Proposition 9 this
relation agrees with the `SL(2, A')`-orbit relation off the countable, hence null, invariant
`SL(2, A')`-orbit of `∞`, so the latter relation would be amenable, contradicting statement C9. -/

namespace Monod.Dev.Red

open Monod OnePoint Filter Topology MeasureTheory
open scoped Pointwise

/-- Amenability transfers along group isomorphisms. -/
theorem isAmenable_of_mulEquiv {G G' : Type*} [Group G] [Group G'] (e : G ≃* G')
    (h : Garrido.IsAmenable G) : Garrido.IsAmenable G' := by
  obtain ⟨m, ⟨h0, hadd⟩, h1, hinv⟩ := h
  refine ⟨fun s => m (e ⁻¹' s), ⟨by simpa using h0, fun s t hst => ?_⟩, by simpa using h1,
    fun g s => ?_⟩
  · show m (e ⁻¹' (s ∪ t)) = m (e ⁻¹' s) + m (e ⁻¹' t)
    rw [Set.preimage_union]
    exact hadd _ _ (hst.preimage _)
  · have : e ⁻¹' (g • s) = e.symm g • e ⁻¹' s := by
      ext x
      simp only [Set.mem_preimage, Set.mem_smul_set_iff_inv_smul_mem, smul_eq_mul]
      rw [map_mul, map_inv, MulEquiv.apply_symm_apply]
    simp only
    rw [this]
    exact hinv _ _

/-- `H(A') ≤ H(A)` for `A' ≤ A`. -/
theorem H_mono {A' A : Subring ℝ} (hle : A' ≤ A) : H A' ≤ H A := by
  have hmob : ∀ g : Matrix.SpecialLinearGroup (Fin 2) A',
      mob (Matrix.SpecialLinearGroup.map (Subring.inclusion hle) g) = mob g := by
    intro g
    have : slToGL A (Matrix.SpecialLinearGroup.map (Subring.inclusion hle) g) = slToGL A' g := by
      ext i j
      rfl
    funext x
    simp only [mob, this]
  have hhyp : ∀ g : Matrix.SpecialLinearGroup (Fin 2) A', IsHyperbolic g →
      IsHyperbolic (Matrix.SpecialLinearGroup.map (Subring.inclusion hle) g) := by
    intro g hg
    unfold IsHyperbolic at *
    convert hg using 2
    simp [Matrix.trace_fin_two]
  have hP : P A' ⊆ P A := by
    rintro p ⟨g, hg, hgp⟩
    exact ⟨_, hhyp g hg, by rw [hmob]; exact hgp⟩
  intro f hf
  refine ⟨?_, hf.2⟩
  have hG : G A' ≤ G A := by
    simp only [Dev.GMono.G_eq_closure_isPiecewiseProj]
    apply Subgroup.closure_le _ |>.2
    rintro f ⟨B, hB, hloc⟩
    apply Subgroup.subset_closure
    refine ⟨B, hB.trans hP, fun x hx => ?_⟩
    obtain ⟨g, hg⟩ := hloc x hx
    exact ⟨_, by rw [hmob]; exact hg⟩
  exact hG hf.1

/-- `H(A)` acts on `P¹` by its homeomorphisms. -/
instance mulActionP1 (A : Subring ℝ) : MulAction (H A) (OnePoint ℝ) where
  smul l x := (l : OnePoint ℝ ≃ₜ OnePoint ℝ) x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl

/-- `volP1 s` is the Lebesgue measure of the real points of `s`. -/
theorem volP1_apply (s : Set (OnePoint ℝ)) :
    volP1 s = volume (((↑) : ℝ → OnePoint ℝ) ⁻¹' s) :=
  OnePoint.isOpenEmbedding_coe.measurableEmbedding.map_apply _ _

theorem volP1_eq_zero_iff (s : Set (OnePoint ℝ)) : volP1 s = 0 ↔ PNull s := by
  rw [volP1_apply]
  rfl

instance sigmaFinite_volP1 : SigmaFinite volP1 :=
  OnePoint.isOpenEmbedding_coe.measurableEmbedding.sigmaFinite_map

/-- The `SL(2, A)`-orbit of `∞`. -/
def orbInf (A : Subring ℝ) : Set (OnePoint ℝ) :=
  Set.range fun g : Matrix.SpecialLinearGroup (Fin 2) A => mob g ∞

theorem not_isAmenable_H_of
    (h_mob_mem_orbit_H : ∀ (A : Subring ℝ),
      (∀ (p : ℝ) (g : Matrix.SpecialLinearGroup (Fin 2) A),
        mob g (p : OnePoint ℝ) = OnePoint.infty ∨ ∃ h ∈ H A, h (p : OnePoint ℝ) = mob g p) ∧
      ∀ p q : ℝ, (∃ g : Matrix.SpecialLinearGroup (Fin 2) A, mob g (p : OnePoint ℝ) = q) ↔
        ∃ h ∈ H A, h (p : OnePoint ℝ) = q)
    (h_exists_countable_dense_subring : ∀ {A : Subring ℝ} (_hA : A ≠ ⊥),
      ∃ A' : Subring ℝ, A' ≤ A ∧ Countable A' ∧ Dense (A' : Set ℝ))
    (h_isAmenableRel_orbit_of_isAmenable : ∀ {X : Type} [MeasurableSpace X]
      (μ : MeasureTheory.Measure X) [MeasureTheory.SigmaFinite μ]
      (Λ : Type) [Group Λ] [Countable Λ] [MulAction Λ X]
      (_hmeas : ∀ l : Λ, Measurable (fun x : X => l • x))
      (_hnull : ∀ (l : Λ) (s : Set X), μ s = 0 → μ ((fun x : X => l • x) ⁻¹' s) = 0)
      (_hΛ : Garrido.IsAmenable Λ),
      IsAmenableRel μ {p : X × X | ∃ l : Λ, l • p.1 = p.2})
    (h_not_isAmenableRel_mob : ∀ (A : Subring ℝ) [Countable A] (_hA : Dense (A : Set ℝ)),
      ¬ IsAmenableRel volP1
        {p : OnePoint ℝ × OnePoint ℝ |
          ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, mob g p.1 = p.2})
    {A : Subring ℝ} (hA : A ≠ ⊥) : ¬ Garrido.IsAmenable (H A) := by
  intro hamen
  obtain ⟨A', hle, hcount, hdense⟩ := h_exists_countable_dense_subring hA
  have hamen' : Garrido.IsAmenable (H A') :=
    isAmenable_of_mulEquiv (Subgroup.subgroupOfEquivOfLe (H_mono hle))
      (Garrido.isAmenable_subgroup hamen _)
  have := countable_H A'
  have hR := h_isAmenableRel_orbit_of_isAmenable volP1 (H A')
    (fun l => (l : OnePoint ℝ ≃ₜ OnePoint ℝ).continuous.measurable)
    (fun l s hs => (volP1_eq_zero_iff _).2
      (PNull.preimage_of_mem_G l.2.1 s ((volP1_eq_zero_iff s).1 hs)).1)
    hamen'
  have hNc : (orbInf A').Countable := Set.countable_range _
  have hNnull : PNull (orbInf A') := PNull.of_countable hNc
  have hinf : ∞ ∈ orbInf A' := ⟨1, mob_one _⟩
  refine h_not_isAmenableRel_mob A' hdense
    (isAmenableRel_of_agree (N := orbInf A') hNc.measurableSet
      ((volP1_eq_zero_iff _).2 hNnull) ?_ ?_ ?_ hR)
  · rintro ⟨x, y⟩ ⟨g, hg⟩
    simp only at hg ⊢
    subst hg
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨g * k, mob_mul _ _ _⟩
    · rintro ⟨k, hk⟩
      refine ⟨g⁻¹ * k, ?_⟩
      replace hk : mob k ∞ = mob g x := hk
      show mob (g⁻¹ * k) ∞ = x
      rw [mob_mul, hk, mob_inv_mob]
  · rintro ⟨x, y⟩ hx hy
    simp only at hx hy
    cases x with
    | infty => exact absurd hinf hx
    | coe p =>
      cases y with
      | infty => exact absurd hinf hy
      | coe q =>
        simp only [Set.mem_ofPred_eq]
        rw [(h_mob_mem_orbit_H A').2 p q]
        constructor
        · rintro ⟨l, hl⟩
          exact ⟨l, l.2, hl⟩
        · rintro ⟨h, hh, hpq⟩
          exact ⟨⟨h, hh⟩, hpq⟩
  · unfold RelNull
    rw [volP1_eq_zero_iff]
    refine PNull.mono (hNnull.union (PNull.iUnion fun l : H A' =>
      (PNull.preimage_of_mem_G l.2.1 _ hNnull).1)) ?_
    rintro _ ⟨⟨x, y⟩, ⟨hp, l, hl⟩, rfl⟩
    simp only [Set.mem_ofPred_eq] at hl hp ⊢
    subst hl
    rcases hp with hp | hp
    · exact Or.inl hp
    · exact Or.inr (Set.mem_iUnion.2 ⟨l, hp⟩)

end Monod.Dev.Red
end

section
/-! # Monod, Corollary 3, as a reduction to Theorem 1 and Theorem 5 -/

namespace Monod.Dev.Red

open Monod

end Monod.Dev.Red
end

open Monod in
theorem solution {A : Subring ℝ} (hA : A ≠ ⊥) : ¬ Garrido.IsAmenable (H A) :=
  Monod.Dev.Red.not_isAmenable_H_of mob_mem_orbit_H exists_countable_dense_subring_of_ne_bot
    (fun μ _ Λ _ _ _ hmeas hnull hΛ => isAmenableRel_orbit_of_isAmenable μ Λ hmeas hnull hΛ)
    (fun A _ hA => not_isAmenableRel_mob A hA) hA
