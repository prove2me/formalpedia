open NLogN
open NLogN.CR
open IntMul RS IntMul.HvdH IntMul.HvdH.Ref
theorem solution (M : NLogN.MulSpec) (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (tw : NLogN.RM)
    (Ctw : ℕ) (htw : NLogN.CR.TwSpec M tw q.p (2 * q.r) Ctw) (s : NLogN.IState NLogN.HS) (hw : NLogN.CR.ChirpRegs q s)
    (LP : List NLogN.Item) (hp : s.G NLogN.CR.hPp = .int q.p :: LP) (kb : ℕ) (L2 : List NLogN.Item)
    (h2 : s.G 2 = .int kb :: L2) (hkb1 : 4 * q.r ≤ 2 ^ kb) (hkb2 : q.tdims.prod ≤ 2 ^ kb) :
    (NLogN.CR.chirpP tw).ok M s ∧ (NLogN.CR.chirpP tw).run s = s.upd 0 (NLogN.gints (chirpL q) ++ s.G 0) := by
  obtain ⟨o1, r1⟩ := NLogN.CR.reqGen_spec q he hdh s hw
  set s1 := s.upd 0 (NLogN.ints ((List.range q.tdims.prod).map (NLogN.CR.reqRec (NLogN.CR.chirpKey q))).flatten ++ s.G 0)
    with hs1
  obtain ⟨LM, hm⟩ := hw.m2
  obtain ⟨LT, ht⟩ := hw.tt
  rw [NLogN.CR.two_r] at hm
  obtain ⟨o2, r2⟩ := NLogN.CR.tabGen_spec M tw q.p (2 * q.r) Ctw htw s1 LP LM (by simp +decide [hs1, hp])
    (by simp +decide [hs1, hm])
  set s2 := s1.upd 0 (NLogN.ints ((List.range (2 * q.r)).map (NLogN.CR.tabRec (twD q.p (2 * q.r)))).flatten ++
    s1.G 0) with hs2
  obtain ⟨o3, r3⟩ := NLogN.CR.chirpTail_spec (twD q.p (2 * q.r)) (NLogN.CR.chirpKey q) (2 * q.r) q.tdims.prod kb
    (fun x _ => NLogN.CR.chirpKey_lt q x) (by omega) hkb2 s2 (s.G 0) LM LT L2
    (by simp [hs2, hs1, NLogN.CR.mergeL, NLogN.ints_append])
    (by simp +decide [hs2, hs1, hm]) (by simp +decide [hs2, hs1, ht])
    (by simp +decide [hs2, hs1, h2])
  have hK : 1 ≤ q.K := by omega
  have fin : s2.upd 0 (NLogN.ints ((List.range q.tdims.prod).map fun x =>
      [(twD q.p (2 * q.r) (NLogN.CR.chirpKey q x)).1, (twD q.p (2 * q.r) (NLogN.CR.chirpKey q x)).2]).flatten ++ s.G 0) =
      s.upd 0 (NLogN.gints (chirpL q) ++ s.G 0) := by
    rw [hs2, hs1, NLogN.IState.upd_upd_same, NLogN.IState.upd_upd_same, NLogN.CR.chirpL_eq q hK hdh, ← NLogN.CR.ints_pairs,
      List.map_map]
    rfl
  rw [fin] at r3
  exact NLogN.CR.rm_seq_spec (NLogN.CR.rm_rs_spec ⟨o1, r1⟩) (NLogN.CR.rm_seq_spec ⟨o2, r2⟩ (NLogN.CR.rm_rs_spec ⟨o3, r3⟩))
end
