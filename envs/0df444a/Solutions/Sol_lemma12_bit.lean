    · exact hg g (List.mem_cons_self ..)
    · exact hl w

lemma frameSum2_congr {β : Type*} [AddCommMonoid β] (F G : M → M → β) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      FramesOK2 (fun a b => F a b = G a b) gates lab Mout →
      frameSum2 F gates lab Mout = frameSum2 G gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout h; exact Finset.sum_congr rfl fun w _ => h w
  | cons g gs ih =>
    intro lab Mout h
