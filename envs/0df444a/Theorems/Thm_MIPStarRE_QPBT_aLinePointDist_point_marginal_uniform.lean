/-!
### Formalization-only auxiliary facts about the ambient low-degree space
-/

theorem MIPStarRE.QPBT.aLinePointDist_point_marginal_uniform (L : _root_.MIPStarRE.QPBT.LdParams) :
    (_root_.MIPStarRE.QPBT.aLinePointDist L).map Prod.snd =
        _root_.LIDT.MIPStarRE.LDT.uniformDistribution (Fin L.m → _root_.MIPStarRE.QPBT.ScalarQ L) ∧
      (_root_.MIPStarRE.QPBT.aLinePointDist L).map (fun sample => _root_.MIPStarRE.QPBT.chiIndex L sample.1.seed) =
        _root_.LIDT.MIPStarRE.LDT.uniformDistribution (Fin L.m) := by sorry
