open scoped BigOperators ArithmeticFunction.Moebius ArithmeticFunction.vonMangoldt
open ArithmeticFunction
namespace TaoFivePrimes
noncomputable def eta0VaughanOpenOddPairs (x : ℝ) : Finset (ℕ × ℕ) :=
  ((Finset.Ioc 0 ⌊x⌋₊).product (Finset.Ioc 0 ⌊x⌋₊)).filter fun p =>
    p.1 * p.2 ≤ ⌊x⌋₊ ∧
    p.1.Coprime 2 ∧ p.2.Coprime 2 ∧
    x / 4 < ((p.1 * p.2 : ℕ) : ℝ) ∧
    ((p.1 * p.2 : ℕ) : ℝ) < x
end TaoFivePrimes
