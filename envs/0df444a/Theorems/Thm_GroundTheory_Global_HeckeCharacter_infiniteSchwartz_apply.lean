open GroundTheory.Global.HeckeCharacter
variable (χ : HeckeCharacter K)

theorem GroundTheory.Global.HeckeCharacter.infiniteSchwartz_apply (x : mixedSpace K) :
    χ.infiniteSchwartz x = χ.infinitePoly x *
      ((Real.exp (-π * (∑ w, x.1 w ^ 2 + 2 * ∑ w, ‖x.2 w‖ ^ 2)) : ℝ) : ℂ) := by sorry
