  refine hH.elim fun _iH hH => ?_
  refine hH.elim fun _iHH hH => ?_
  have hHfin := hH.1
  have hHflat := hH.2.1
  have hHcocomm := hH.2.2.1
  refine hH.2.2.2.elim fun e' he' => ?_
  have he'_add := he'.1
