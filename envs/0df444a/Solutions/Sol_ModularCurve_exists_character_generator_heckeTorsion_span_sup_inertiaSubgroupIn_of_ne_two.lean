private theorem exists_char_quot {T X : Type*} [CommRing T] [AddCommGroup X] [Module T X]
    (hfin : Finite X)
    (𝔭 : Ideal T) (MM : ℕ) (hnil : ∀ g ∈ 𝔭 ^ MM, ∀ x : X, g • x = 0)
    (q : ℕ) (hq : q.Prime) (hq𝔭 : (q : T) ∈ 𝔭)
    (x₀ : X) (hx₀soc : ∀ g ∈ 𝔭, g • x₀ = 0)
    (hgen : ∀ x : X, (∀ g ∈ 𝔭, g • x = 0) → ∃ m : ℕ, x = m • x₀) :
    ∃ φ : X → (AlgebraicClosure ℚ)ˣ,
      (∀ x y, φ (x + y) = φ x * φ y) ∧
      (∀ x : X, (∀ t : T, φ (t • x) = 1) → x = 0) := by
  classical
  haveI : Finite X := hfin
  haveI : Fact q.Prime := ⟨hq⟩

  have descend : ∀ K : X → Prop, (∀ (t : T) (x : X), K x → K (t • x)) →
      ∀ j : ℕ, ∀ x : X, K x → x ≠ 0 → (∀ g ∈ 𝔭 ^ j, g • x = 0) →
      ∃ s : X, K s ∧ s ≠ 0 ∧ ∀ g ∈ 𝔭, g • s = 0 := by
    intro K hKsmul j
    induction j with
    | zero =>
      intro x _ hx0 hkill
      have h1 : (1 : T) ∈ 𝔭 ^ 0 := by
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      have h2 := hkill 1 h1
      rw [one_smul] at h2
      exact absurd h2 hx0
    | succ j ih =>
      intro x hKx hx0 hkill
      by_cases hS : ∀ g ∈ 𝔭, g • x = 0
      · exact ⟨x, hKx, hx0, hS⟩
      · push Not at hS
        obtain ⟨g, hg𝔭, hgx⟩ := hS
        refine ih (g • x) (hKsmul g x hKx) hgx ?_
        intro h hh
        rw [smul_smul]
        exact hkill (h * g) (by rw [pow_succ]; exact Ideal.mul_mem_mul hh hg𝔭)
  by_cases hX : ∀ x : X, x = 0
  · exact ⟨fun _ => 1, fun _ _ => (one_mul (1 : (AlgebraicClosure ℚ)ˣ)).symm, fun x _ => hX x⟩
  push Not at hX
  obtain ⟨z, hz⟩ := hX

  obtain ⟨s₁, -, hs₁ne, hs₁soc⟩ :=
    descend (fun _ => True) (fun _ _ _ => trivial) MM z trivial hz (fun g hg => hnil g hg z)
  have hx₀ne : x₀ ≠ 0 := by
    intro h0
    obtain ⟨m₁, hm₁⟩ := hgen s₁ hs₁soc
    exact hs₁ne (by rw [hm₁, h0, smul_zero])
  have hqx₀ : q • x₀ = 0 := by
    have h1 := hx₀soc _ hq𝔭
    rwa [Nat.cast_smul_eq_nsmul] at h1

  haveI : NeZero ((Monoid.exponent (Multiplicative X) : ℚ)) :=
    ⟨by exact_mod_cast Monoid.exponent_ne_zero_of_finite⟩
  have hx₀ne' : Multiplicative.ofAdd x₀ ≠ (1 : Multiplicative X) := by
    rw [ne_eq, ofAdd_eq_one]
    exact hx₀ne
  obtain ⟨φ₀, hφ₀⟩ := CommGroup.exists_apply_ne_one_of_hasEnoughRootsOfUnity
    (Multiplicative X) (AlgebraicClosure ℚ) hx₀ne'
  have horder : orderOf (φ₀ (Multiplicative.ofAdd x₀)) = q := by
    refine orderOf_eq_prime ?_ hφ₀
    rw [← map_pow, ← ofAdd_nsmul, hqx₀, ofAdd_zero]
    exact map_one φ₀
  refine ⟨fun x => φ₀ (Multiplicative.ofAdd x), ?_, ?_⟩
  · intro x y
    show φ₀ (Multiplicative.ofAdd (x + y)) =
      φ₀ (Multiplicative.ofAdd x) * φ₀ (Multiplicative.ofAdd y)
    rw [ofAdd_add, map_mul]
  · intro x hx
    by_contra hxne
    obtain ⟨s, hKs, hsne, hssoc⟩ :=
      descend (fun y => ∀ t : T, φ₀ (Multiplicative.ofAdd (t • y)) = 1)
        (fun t y hy t' => by rw [smul_smul]; exact hy (t' * t))
        MM x hx hxne (fun g hg => hnil g hg x)
    obtain ⟨m, hm⟩ := hgen s hssoc
    have h1 : φ₀ (Multiplicative.ofAdd s) = 1 := by
      have h2 := hKs 1
      rwa [one_smul] at h2
    have h3 : φ₀ (Multiplicative.ofAdd x₀) ^ m = 1 := by
      rw [← map_pow, ← ofAdd_nsmul, ← hm]
      exact h1
    have hdvd : q ∣ m := by
      rw [← horder]
      exact orderOf_dvd_of_pow_eq_one h3
    obtain ⟨c, rfl⟩ := hdvd
    exact hsne (by rw [hm, mul_comm, mul_smul, hqx₀, smul_zero])

private theorem exists_char {T J : Type*} [CommRing T] [AddCommGroup J] [Module T J]
    (V V₀ : Submodule T J) (hfin : Finite ↥V)
    (𝔭 : Ideal T) (MM : ℕ) (hnil : ∀ g ∈ 𝔭 ^ MM, ∀ v ∈ V, g • v = 0)
    (q : ℕ) (hq : q.Prime) (hq𝔭 : (q : T) ∈ 𝔭)
    (y₀ : J) (hy₀ : y₀ ∈ V) (hy₀soc : ∀ g ∈ 𝔭, g • y₀ ∈ V₀)
    (hgen : ∀ y ∈ V, (∀ g ∈ 𝔭, g • y ∈ V₀) → ∃ m : ℕ, y - m • y₀ ∈ V₀) :
    ∃ e₀ : ↥V → (AlgebraicClosure ℚ)ˣ,
      (∀ v₁ v₂, e₀ (v₁ + v₂) = e₀ v₁ * e₀ v₂) ∧
      (∀ v : ↥V, (v : J) ∈ V₀ → e₀ v = 1) ∧
      (∀ v : ↥V, (∀ t : T, e₀ (t • v) = 1) → (v : J) ∈ V₀) := by
  classical
  haveI : Finite ↥V := hfin
  haveI hXfin : Finite (↥V ⧸ V₀.comap V.subtype) :=
    Finite.of_surjective _ (V₀.comap V.subtype).mkQ_surjective
  have hker : ∀ v : ↥V, (V₀.comap V.subtype).mkQ v = 0 ↔ (v : J) ∈ V₀ := by
    intro v
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Iff.rfl
  have hnilX : ∀ g ∈ 𝔭 ^ MM, ∀ x : ↥V ⧸ V₀.comap V.subtype, g • x = 0 := by
    intro g hg x
    obtain ⟨v, rfl⟩ := (V₀.comap V.subtype).mkQ_surjective x
    rw [← map_smul]
    refine (hker _).mpr ?_
    rw [Submodule.coe_smul, hnil g hg (v : J) v.2]
    exact V₀.zero_mem
  have hx₀soc : ∀ g ∈ 𝔭, g • (V₀.comap V.subtype).mkQ ⟨y₀, hy₀⟩ = 0 := by
    intro g hg
    rw [← map_smul]
    refine (hker _).mpr ?_
    rw [Submodule.coe_smul]
    exact hy₀soc g hg
  have hgenX : ∀ x : ↥V ⧸ V₀.comap V.subtype, (∀ g ∈ 𝔭, g • x = 0) →
      ∃ m : ℕ, x = m • (V₀.comap V.subtype).mkQ ⟨y₀, hy₀⟩ := by
    intro x hx
    obtain ⟨v, rfl⟩ := (V₀.comap V.subtype).mkQ_surjective x
    have hvsoc : ∀ g ∈ 𝔭, g • (v : J) ∈ V₀ := by
      intro g hg
      have h1 : (V₀.comap V.subtype).mkQ (g • v) = 0 := by
        rw [map_smul]
        exact hx g hg
      have h2 := (hker _).mp h1
      rwa [Submodule.coe_smul] at h2
    obtain ⟨m, hm⟩ := hgen (v : J) v.2 hvsoc
    refine ⟨m, ?_⟩
    rw [← sub_eq_zero, ← map_nsmul ((V₀.comap V.subtype).mkQ), ← map_sub]
    refine (hker _).mpr ?_
    rw [Submodule.coe_sub, Submodule.coe_smul_of_tower]
    exact hm
  obtain ⟨φ, hadd, hsep⟩ := exists_char_quot hXfin 𝔭 MM hnilX q hq hq𝔭
    ((V₀.comap V.subtype).mkQ ⟨y₀, hy₀⟩) hx₀soc hgenX
  have hφ0 : φ 0 = 1 := by
    have h := hadd 0 0
    rw [add_zero] at h
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)
  refine ⟨fun v => φ ((V₀.comap V.subtype).mkQ v), ?_, ?_, ?_⟩
  · intro v₁ v₂
    show φ ((V₀.comap V.subtype).mkQ (v₁ + v₂)) =
      φ ((V₀.comap V.subtype).mkQ v₁) * φ ((V₀.comap V.subtype).mkQ v₂)
    rw [map_add, hadd]
  · intro v hv
    show φ ((V₀.comap V.subtype).mkQ v) = 1
    rw [(hker v).mpr hv]
    exact hφ0
  · intro v hv
    refine (hker v).mp (hsep _ ?_)
    intro t
    rw [← map_smul]
    exact hv t

