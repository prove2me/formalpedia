        (m01.trans m12).ne, (m01.trans m12).ne', (m12.trans m23).ne, (m12.trans m23).ne',
        ((m01.trans m12).trans m23).ne, ((m01.trans m12).trans m23).ne']
  · push Not at hk
    rw [h50i_setAct_other Λ a _ k hk]
    simp only [swapMap, List.getElem?_set]
    simp [hk]

theorem solution (N : ℕ) [NeZero N] : (exNet (R := R)).OK N := by
  refine ⟨?_, ?_⟩
  · intro e he ρ hρ
    have he' : e = exEdge := by simpa [QHNet.edges, exNet, progEdges, Instr.edgeOf] using he
    subst he'
    simp [exEdge] at hρ
    rcases hρ with rfl | rfl <;> simp [RunOK]
  · intro sh Λ ins hins w
    have hw : w = 0 := Subsingleton.elim _ _
    subst hw
    show runArr Λ 0 (exEdge.steps N) (ins 0) = pull sh sh (amap Λ swapMat) 0 (ins 0)
    have hsteps : exEdge.steps N = shiftSteps (redM N (1 : QMat2 2)) ++
        swapSteps [((0 : Fin (2 + 2)), (2 : Fin (2 + 2))), (1, 3)] ++ shiftSteps (redM N (1 : QMat2 2)) := rfl
    have hval : ∀ s ∈ exEdge.steps N, ∀ a, Valid sh a → Valid sh (s.inv Λ a) := by
      rw [hsteps]
      intro s hs a ha
      simp only [List.mem_append] at hs
      rcases hs with (hs | hs) | hs
      · rw [h50i_shift_id Λ s hs a ha]; exact ha
      · simp only [swapSteps, List.mem_map, List.mem_cons, List.not_mem_nil, or_false] at hs
        obtain ⟨p, hp, rfl⟩ := hs
        rcases hp with rfl | rfl <;> exact h50i_swapMap_valid Λ _ _ a ha
      · rw [h50i_shift_id Λ s hs a ha]; exact ha
    rw [h50i_runArr Λ 0 _ _ (hins 0) hval]
    apply h50i_pull_congr
    intro a ha
    rw [hsteps, h50i_invChain_append, h50i_invChain_append, h50i_invChain_id Λ _ (h50i_shift_id Λ) _ ha]
    have hv2 : Valid sh (swapMap Λ 0 2 (swapMap Λ 1 3 a)) :=
      h50i_swapMap_valid Λ _ _ _ (h50i_swapMap_valid Λ _ _ _ ha)
    show invChain Λ _ (swapMap Λ 0 2 (swapMap Λ 1 3 a)) = _
    rw [h50i_invChain_id Λ _ (h50i_shift_id Λ) _ hv2]
    exact h50i_key Λ a ha

