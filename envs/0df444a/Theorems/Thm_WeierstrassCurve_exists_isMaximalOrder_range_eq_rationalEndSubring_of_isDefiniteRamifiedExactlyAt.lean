open scoped Quaternion TensorProduct

theorem WeierstrassCurve.exists_isMaximalOrder_range_eq_rationalEndSubring_of_isDefiniteRamifiedExactlyAt
    {k : Type*} [Field k] [IsAlgClosed k] [DecidableEq k]
    (p : ℕ) [Fact p.Prime] [CharP k p] [Algebra (ZMod p) k] [Algebra.IsAlgebraic (ZMod p) k]
    (X : WeierstrassCurve k) [X.IsElliptic]
    (hss : ∀ P : X.toAffine.Point, p • P = 0 → P = 0)
    (a b : ℚ) (hdef : QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b p) :
    ∃ Λ : Submodule ℤ ℍ[ℚ, a, b], QuaternionAlgebra.IsMaximalOrder Λ ∧
      ∃ θ : ↥(WeierstrassCurve.rationalEndSubring k X) →+* ℍ[ℚ, a, b],
        Function.Injective θ ∧ Set.range θ = (Λ : Set ℍ[ℚ, a, b]) := by sorry
