    fun σ v hv => ((CohCarrier.mem_map_iDegL_one_parabolicHoms_iff (N * r) H₀ 𝒪 𝒪 h₁₀ hu₀ v).mp (hW₀ v hv)).2 σ

  have hne : ∃ (ℓ₀ : ℕ) (_ : NeZero ℓ₀), ℓ₀.Prime ∧ ¬ ℓ₀ ∣ N * r * p ∧ ∀ (ϖ : 𝒪), Irreducible ϖ →
