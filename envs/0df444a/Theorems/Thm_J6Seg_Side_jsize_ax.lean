open J6Seg J6Seg.Side
open Finset
open IntMul NLogN NLogN.KIL IntMul.Kappa.R6 J6Seg
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxJ P n src D k)
include h

theorem J6Seg.Side.jsize_ax (hc : Val.ValCond6 ap) :
    let wd := axwd6 P n src k ap; let kJ := axkJ6 P n src k ap
    let pre := axpre6 P n D k; let post := axpost6 P n D k; let fJ := axfJ6 P n src k
    let NJ := 2 * (pre * 1 * post * 2 ^ fJ)
    let TJ := tabsT (fun _ => axTJ6 P n src k ap) 1
    let BkJ := BkJ6 P n src k ap; let Lj := (axTJ6 P n src k ap).length
    1 ≤ BkJ ∧ wd ≤ BkJ ∧ zsz (wd : ℤ) ≤ BkJ ∧ zsz (fJ : ℤ) ≤ BkJ ∧
    zsz ((pre * 1 : ℕ) : ℤ) ≤ BkJ ∧ zsz (post : ℤ) ≤ BkJ ∧ zsz (pre : ℤ) ≤ BkJ ∧
    zsz ((1 : ℕ) : ℤ) ≤ BkJ ∧ zsz ((2 * 2 ^ fJ : ℕ) : ℤ) ≤ BkJ ∧ zsz (NJ : ℤ) ≤ BkJ ∧
    zsz (TJ.length : ℤ) ≤ BkJ ∧ zsz (Lj : ℤ) ≤ BkJ ∧
    Bnd BkJ (axTJ6 P n src k ap) := by sorry
