variable {ι : Type} [Fintype ι] {g r : ℕ} (idx : Fin g ≃ ι × Fin r) (q : ℕ)

theorem GlobalTheory.PeriodOnto.I_smul_ofBlock (t : ι) (w : Fin r → ℂ) :
    Complex.I • ofBlock idx q t w = ofBlock idx q t ((-Complex.I) • (sgnMat r q *ᵥ w)) := by sorry
