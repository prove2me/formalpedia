  exact QuotientAddGroup.lift (OAI.CoarseAssembly.Analytic.relations A) (OAI.CoarseAssembly.Analytic.precompFree φ)
      ((AddSubgroup.closure_le _).2 (fun _ hz => OAI.CoarseAssembly.Analytic.precompFree_relation φ hz))

end CoarseAssembly.Analytic

