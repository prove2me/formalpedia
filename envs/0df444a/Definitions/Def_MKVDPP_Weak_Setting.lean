-- title:
--   Notations and §2 — path spaces, 𝒫(E), W₂, the EReal expectation, conditional laws, r.c.p.d., Brownian motion on [t,T], u.s.a. functions, π, coefficients
-- statement:
--   This file sets up the standing data and notation of Djete, Possamaï and Tan (Notations (i)–(v), pp. 3–5, and the preamble of §2, p. 5).
--
--   1. **Paths.** Fix a horizon $T>0$. For $k\in\mathbb N$, $\mathcal C^k:=C([0,T],\mathbb R^k)$ carries the uniform norm and its Borel $\sigma$-field; $\mathcal C:=C([0,T],\mathbb R)$. Times are nonnegative reals; a path is read at time $s\ge T$ as its value at $T$. The **stopped path** is $x_{t\wedge\cdot}:s\mapsto x(s\wedge t)$, and the **shifted path** is $s\mapsto x(s\vee t)-x(t)$.
--   2. **Measures.** $\mathcal P(E)$ is the set of Borel probability measures on $E$ with the topology of weak convergence. For $\nu\in\mathcal P(\mathcal C^k)$ and $\bar\nu\in\mathcal P(\mathcal C^k\times U)$, $\nu(t):=\nu\circ X_{t\wedge\cdot}^{-1}$ and $\bar\nu(t):=\bar\nu\circ(X_{t\wedge\cdot},\alpha)^{-1}$. The $p$-th moment condition $\int\Delta(e,e_0)^p\,\mu(de)<\infty$ and the quadratic Wasserstein distance $W_2(\mu,\mu')=\big(\inf_{\lambda}\int\Delta(z_1,z_2)^2\,\lambda(dz)\big)^{1/2}$ over couplings $\lambda$ are recorded for later use.
--   3. **Expectation.** For an extended-real random variable $\xi$,
--   $$\mathbb E^{\mathbb P}[\xi]:=\mathbb E^{\mathbb P}[\xi^+]-\mathbb E^{\mathbb P}[\xi^-],\qquad \infty-\infty:=-\infty,$$
--   and the same convention defines the time integral $\int_a^b\phi(r)\,dr:=\int_a^b\phi^+-\int_a^b\phi^-$.
--   4. **Conditional laws and r.c.p.d.** $m$ is a version of $\mathcal L^{\mathbb P}(\xi\mid\mathcal G)$ when $m$ is $\mathcal G$-measurable and $m(\omega)[A]=\mathbb P[\xi\in A\mid\mathcal G](\omega)$ a.s. for every Borel $A$. A family $(\mathbb P^{\mathcal G}_\omega)_\omega$ is an r.c.p.d. of $\mathbb P$ knowing $\mathcal G$ when $\omega\mapsto\mathbb P^{\mathcal G}_\omega$ is $\mathcal G$-measurable, $\mathbb P[A\cap B]=\int_B\mathbb P^{\mathcal G}_\omega[A]\,\mathbb P(d\omega)$ for $A\in\mathcal F$, $B\in\mathcal G$, and $\mathbb P^{\mathcal G}_\omega[[\omega]_{\mathcal G}]=1$ for every $\omega$, where $[\omega]_{\mathcal G}$ is the intersection of all sets of $\mathcal G$ containing $\omega$.
--   5. **Brownian motion on $[t,T]$.** A continuous process $Z$ is such that $Z^t_s:=Z_{s\vee t}-Z_t$ is a standard $(\mathbb F,\mathbb P)$-Brownian motion on $[t,T]$ when $Z^t_s$ is $\mathcal F_s$-measurable and, for $t\le s\le u\le T$, $Z_u-Z_s$ is independent of $\mathcal F_s$ with law $N(0,(u-s)I)$.
--   6. **Upper semi-analytic functions.** $f:X\to[-\infty,\infty]$ is u.s.a. when $\{f>c\}$ is analytic for every real $c$.
--   7. **Controls.** $U$ is a nonempty Polish space with metric $\rho$; $\pi:U\to[0,1]$ is a Borel isomorphism onto its image, extended to $\pi^{-1}:[-\infty,\infty]\to\bar U:=U\cup\{\partial\}$ by $\pi^{-1}(x):=\partial$ for $x\notin\pi(U)$.
--   8. **Coefficients.** $b,\sigma,\sigma_0,L$ map $[0,T]\times\mathcal C^n\times\mathcal P(\mathcal C^n\times U)\times U$ to $\mathbb R^n$, $\mathbb R^{n\times d}$, $\mathbb R^{n\times\ell}$, $\mathbb R$, and $g:\mathcal C^n\times\mathcal P(\mathcal C^n)\to\mathbb R$. The standing assumption is that all five are Borel measurable and that $(b,\sigma,\sigma_0,L)$ are non-anticipative: $(b,\sigma,\sigma_0,L)(t,x,\bar\nu,u)=(b,\sigma,\sigma_0,L)(t,x_{t\wedge\cdot},\bar\nu(t),u)$.
--
--   These objects are the vocabulary of every statement of the mission.
--
--   **Formalization Note** Analytic sets are Mathlib's `AnalyticSet` (empty or a continuous image of $\mathbb N^{\mathbb N}$), which agrees with the paper's projection definition on Polish spaces. Measurability of the coefficients is with respect to Mathlib's $\sigma$-field on probability measures (generated by $\mu\mapsto\mu(A)$), which is the Borel $\sigma$-field of the weak topology on Polish spaces; the file proves the inclusion it needs. Expectations and time integrals are lower integrals of the positive and negative parts, so they are defined for every integrand; for universally measurable integrands they agree with the completed integral. $\mathbb R^k$ is `EuclideanSpace ℝ (Fin k)`; matrices carry the Frobenius norm.
-- source:
--   Djete, Possamaï, Tan, McKean–Vlasov optimal control: the dynamic programming principle, arXiv:1907.08860v2, pp. 3–5, Notations (i)–(v) and §2 (coefficients)

import Mathlib
import Definitions.Def_EthierKurtz_HasBrownianItoIntegral
import Definitions.Def_EthierKurtz_completedSDEPast

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

namespace MKVDPP.Weak

noncomputable section

/-! ## Path spaces (Notations (iv), p. 4) -/

/-- Spaces of continuous maps carry their Borel σ-algebra (compact-open topology; on a compact
time interval this is the topology of uniform convergence). -/
instance instMeasurableSpaceContinuousMap {α E : Type*} [TopologicalSpace α] [TopologicalSpace E] :
    MeasurableSpace C(α, E) := borel _

instance instBorelSpaceContinuousMap {α E : Type*} [TopologicalSpace α] [TopologicalSpace E] :
    BorelSpace C(α, E) := ⟨rfl⟩

/-- `𝒞^k = C([0,T], ℝ^k)`, with the uniform norm (Mathlib's `ContinuousMap` norm). -/
abbrev Cpath (T : ℝ≥0) (k : ℕ) : Type := C(Set.Icc (0:ℝ) (T:ℝ), EuclideanSpace ℝ (Fin k))

/-- `𝒞 = C([0,T], ℝ)`. -/
abbrev CR (T : ℝ≥0) : Type := C(Set.Icc (0:ℝ) (T:ℝ), ℝ)

/-- A real time clamped into `[0,T]`. -/
def clampTime (T : ℝ≥0) (s : ℝ) : Set.Icc (0:ℝ) (T:ℝ) := Set.projIcc (0:ℝ) (T:ℝ) (NNReal.coe_nonneg T) s

/-- The value `x_s` of a path at a time `s ∈ ℝ≥0` (clamped into `[0,T]`). -/
def pathAt {T : ℝ≥0} {E : Type*} [TopologicalSpace E] (x : C(Set.Icc (0:ℝ) (T:ℝ), E))
    (s : ℝ≥0) : E :=
  x (clampTime T s)

/-- The stopped path `x_{t∧·}`: `s ↦ x(s ∧ t)`. -/
def stopPath {T : ℝ≥0} {E : Type*} [TopologicalSpace E] (t : ℝ≥0)
    (x : C(Set.Icc (0:ℝ) (T:ℝ), E)) : C(Set.Icc (0:ℝ) (T:ℝ), E) :=
  x.comp ⟨fun s => clampTime T (min (s : ℝ) (t : ℝ)), by
    unfold clampTime; exact continuous_projIcc.comp (continuous_subtype_val.min continuous_const)⟩

theorem continuous_stopPath {T : ℝ≥0} {E : Type*} [TopologicalSpace E] (t : ℝ≥0) :
    Continuous (stopPath (T := T) (E := E) t) := by
  unfold stopPath; exact ContinuousMap.continuous_precomp _

theorem measurable_stopPath {T : ℝ≥0} {E : Type*} [TopologicalSpace E] (t : ℝ≥0) :
    Measurable (stopPath (T := T) (E := E) t) :=
  (continuous_stopPath t).measurable

/-- The shifted path `s ↦ x(s ∨ t) − x(t)` (the processes `B^t`, `W^t`, `A^t` of the paper). -/
def shiftPath {T : ℝ≥0} {E : Type*} [TopologicalSpace E] [AddCommGroup E] [IsTopologicalAddGroup E]
    (t : ℝ≥0) (x : C(Set.Icc (0:ℝ) (T:ℝ), E)) : C(Set.Icc (0:ℝ) (T:ℝ), E) :=
  x.comp ⟨fun s : Set.Icc (0:ℝ) (T:ℝ) => clampTime T (max (s : ℝ) (t : ℝ)), by
    unfold clampTime; exact continuous_projIcc.comp (continuous_subtype_val.max continuous_const)⟩
    - ContinuousMap.const _ (x (clampTime T t))

theorem continuous_shiftPath {T : ℝ≥0} {E : Type*} [TopologicalSpace E] [AddCommGroup E]
    [IsTopologicalAddGroup E] (t : ℝ≥0) :
    Continuous (shiftPath (T := T) (E := E) t) := by
  unfold shiftPath
  exact (ContinuousMap.continuous_precomp _).sub
    ((ContinuousMap.continuous_const' (X := Set.Icc (0:ℝ) (T:ℝ)) (Y := E)).comp
      (continuous_eval_const _))

/-! ## Probability measures on path spaces (Notations (i), (v), pp. 3–5) -/

/-- `ν(t) := ν ∘ (X_{t∧·})⁻¹`. -/
noncomputable def lawStop {T : ℝ≥0} {E : Type*} [TopologicalSpace E]
    (ν : ProbabilityMeasure C(Set.Icc (0:ℝ) (T:ℝ), E)) (t : ℝ≥0) :
    ProbabilityMeasure C(Set.Icc (0:ℝ) (T:ℝ), E) :=
  ν.map (measurable_stopPath t).aemeasurable

/-- `ν̄(t) := ν̄ ∘ (X_{t∧·}, α)⁻¹` for `ν̄ ∈ 𝒫(𝒞^k × U)`. -/
noncomputable def lawStopProd {T : ℝ≥0} {k : ℕ} {U : Type*} [MeasurableSpace U]
    (ν : ProbabilityMeasure (Cpath T k × U)) (t : ℝ≥0) : ProbabilityMeasure (Cpath T k × U) :=
  ν.map ((measurable_stopPath t).prodMap measurable_id).aemeasurable

/-- `∫ Δ(e, e₀)^k μ(de) < ∞` (lower integral). `𝒫_k(E)` is `∃ e₀, IsPMoment k μ e₀`. -/
def IsPMoment {E : Type*} [PseudoEMetricSpace E] [MeasurableSpace E] (k : ℝ)
    (μ : ProbabilityMeasure E) (e₀ : E) : Prop :=
  ∫⁻ e, edist e e₀ ^ k ∂(μ : Measure E) < ⊤

/-- Couplings of two probability measures. -/
def couplings {E : Type*} [MeasurableSpace E] (μ μ' : ProbabilityMeasure E) :
    Set (ProbabilityMeasure (E × E)) :=
  {q | (q : Measure (E × E)).map Prod.fst = μ ∧ (q : Measure (E × E)).map Prod.snd = μ'}

/-- The quadratic Wasserstein distance on a metric space (Notations (i)). -/
noncomputable def W2 {E : Type*} [PseudoEMetricSpace E] [MeasurableSpace E]
    (μ μ' : ProbabilityMeasure E) : ℝ≥0∞ :=
  (⨅ q ∈ couplings μ μ', ∫⁻ z, edist z.1 z.2 ^ (2:ℝ) ∂(q : Measure (E × E))) ^ (1/2 : ℝ)

/-- On a (pseudo-)metrisable space the Giry σ-algebra of `ProbabilityMeasure X` (generated by the
evaluations `μ ↦ μ(A)`) is contained in the Borel σ-algebra of the topology of weak convergence.
Helper used to show that evaluations of continuous measure-valued paths are measurable. -/
theorem measurable_coe_closed_borel {X : Type*} [MeasurableSpace X] [TopologicalSpace X]
    [OpensMeasurableSpace X] [HasOuterApproxClosed X] {F : Set X} (hF : IsClosed F) :
    Measurable[borel (ProbabilityMeasure X)]
      (fun μ : ProbabilityMeasure X => (μ : Measure X) F) := by
  borelize (ProbabilityMeasure X)
  refine UpperSemicontinuous.measurable ?_
  intro μ y hy
  have h := ProbabilityMeasure.limsup_measure_closed_le_of_tendsto
    (L := 𝓝 μ) (μs := id) tendsto_id hF
  exact eventually_lt_of_limsup_lt (lt_of_le_of_lt h hy)

theorem giry_le_borel (X : Type*) [MeasurableSpace X] [TopologicalSpace X]
    [BorelSpace X] [HasOuterApproxClosed X] :
    (inferInstance : MeasurableSpace (ProbabilityMeasure X)) ≤ borel (ProbabilityMeasure X) := by
  have key : ∀ A : Set X, MeasurableSet A →
      Measurable[borel (ProbabilityMeasure X)]
        (fun μ : ProbabilityMeasure X => (μ : Measure X) A) := by
    intro A hA
    rw [BorelSpace.measurable_eq (α := X), borel_eq_generateFrom_isClosed] at hA
    induction A, hA using MeasurableSpace.induction_on_inter
        (s := {F : Set X | IsClosed F}) (h_eq := rfl)
        (h_inter := fun _ h₁ _ h₂ _ => IsClosed.inter h₁ h₂) with
    | empty => simp [measurable_const]
    | basic F hF => exact measurable_coe_closed_borel hF
    | compl A hA ih =>
      have hA' : MeasurableSet A := by
        rw [BorelSpace.measurable_eq (α := X), borel_eq_generateFrom_isClosed]; exact hA
      have : (fun μ : ProbabilityMeasure X => (μ : Measure X) Aᶜ) =
          fun μ : ProbabilityMeasure X => 1 - (μ : Measure X) A := by
        funext μ; rw [prob_compl_eq_one_sub hA']
      rw [this]; exact measurable_const.sub ih
    | iUnion f hdisj hf ih =>
      have hf' : ∀ i, MeasurableSet (f i) := fun i => by
        rw [BorelSpace.measurable_eq (α := X), borel_eq_generateFrom_isClosed]; exact hf i
      have : (fun μ : ProbabilityMeasure X => (μ : Measure X) (⋃ i, f i)) =
          fun μ : ProbabilityMeasure X => ∑' i, (μ : Measure X) (f i) := by
        funext μ; rw [measure_iUnion hdisj hf']
      rw [this]; exact Measurable.ennreal_tsum ih
  intro s hs
  obtain ⟨t, ht, rfl⟩ := hs
  have hm : Measurable[borel (ProbabilityMeasure X)]
      (fun μ : ProbabilityMeasure X => (μ : Measure X)) :=
    @Measure.measurable_of_measurable_coe _ _ _ (borel _) _ key
  exact hm ht

/-- A continuous map into `ProbabilityMeasure X` is measurable for the Giry σ-algebra. -/
theorem measurable_of_continuous_pm {α X : Type*} [TopologicalSpace α] [MeasurableSpace α]
    [OpensMeasurableSpace α] [MeasurableSpace X] [TopologicalSpace X] [BorelSpace X]
    [HasOuterApproxClosed X] {f : α → ProbabilityMeasure X} (hf : Continuous f) :
    Measurable f := by
  have h : Measurable[_, borel (ProbabilityMeasure X)] f := by
    let _ : MeasurableSpace (ProbabilityMeasure X) := borel _
    have _ : BorelSpace (ProbabilityMeasure X) := ⟨rfl⟩
    exact hf.measurable
  exact h.mono le_rfl (giry_le_borel X)

/-! ## Expectation with the convention `∞ − ∞ := −∞` (Notations (ii), p. 4) -/

/-- `𝔼^ℙ[ξ] := 𝔼^ℙ[ξ⁺] − 𝔼^ℙ[ξ⁻]` with `∞ − ∞ := −∞` (EReal's `⊤ + ⊥ = ⊥`). Lower integrals. -/
noncomputable def eExp {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (ξ : Ω → EReal) : EReal :=
  ((∫⁻ ω, (ξ ω).toENNReal ∂P : ℝ≥0∞) : EReal) - ((∫⁻ ω, (-ξ ω).toENNReal ∂P : ℝ≥0∞) : EReal)

/-- The time integral `∫_a^b φ(r) dr := ∫_a^b φ⁺ − ∫_a^b φ⁻` with `∞ − ∞ := −∞` (p. 16). -/
noncomputable def timeInt (a b : ℝ≥0) (φ : ℝ≥0 → EReal) : EReal :=
  eExp (volume.restrict (Set.Icc (a:ℝ) (b:ℝ))) (fun r : ℝ => φ r.toNNReal)

/-! ## Conditional laws and r.c.p.d. (Notations (iii), p. 4) -/

/-- `m` is a version of the conditional law `ℒ^ℙ(ξ | 𝒢)`. -/
def IsCondLaw {Ω E : Type*} (𝒢 : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] [MeasurableSpace E]
    (P : Measure Ω) (ξ : Ω → E) (m : Ω → ProbabilityMeasure E) : Prop :=
  𝒢 ≤ mΩ ∧ Measurable[𝒢] m ∧
    ∀ A : Set E, MeasurableSet A →
      (fun ω => ((m ω : Measure E) A).toReal) =ᵐ[P]
        condExp 𝒢 P ((ξ ⁻¹' A).indicator (fun _ => (1:ℝ)))

/-- The atom `[ω]_𝒢 := ⋂ {A ∈ 𝒢 : ω ∈ A}`. -/
def atom {Ω : Type*} (𝒢 : MeasurableSpace Ω) (ω : Ω) : Set Ω :=
  ⋂₀ {A | MeasurableSet[𝒢] A ∧ ω ∈ A}

/-- `(κ ω)_ω` is a family of r.c.p.d. of `ℙ` knowing `𝒢`. -/
def IsRCPD {Ω : Type*} (𝒢 : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (κ : Ω → ProbabilityMeasure Ω) : Prop :=
  𝒢 ≤ mΩ ∧ Measurable[𝒢] κ ∧
    (∀ A B : Set Ω, MeasurableSet A → MeasurableSet[𝒢] B →
      P (A ∩ B) = ∫⁻ ω in B, (κ ω : Measure Ω) A ∂P) ∧
    ∀ ω, (κ ω : Measure Ω) (atom 𝒢 ω) = 1

/-! ## Brownian motion on `[t,T]` relative to a filtration -/

/-- `Z^t_s := Z_{s∨t} − Z_t` is a standard `(𝔽, ℙ)`-Brownian motion on `[t,T]` (values in `ℝ^ι`):
continuous paths on `[0,T]`, `𝔽`-adapted increments, and for `t ≤ s ≤ u ≤ T` the increment
`Z_u − Z_s` is independent of `𝔽_s` with law `N(0, (u − s) I)`. -/
def IsFBrownianOn {Ω : Type*} [mΩ : MeasurableSpace Ω] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (𝔽 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t T : ℝ≥0) (Z : ℝ≥0 → Ω → EuclideanSpace ℝ ι) :
    Prop :=
  (∀ ω, ContinuousOn (fun s => Z s ω) (Set.Icc 0 T)) ∧
  (∀ s, t ≤ s → s ≤ T → Measurable[𝔽 s] (fun ω => Z s ω - Z t ω)) ∧
  (∀ s u, t ≤ s → s ≤ u → u ≤ T →
    Indep (MeasurableSpace.comap (fun ω => Z u ω - Z s ω) inferInstance) (𝔽 s) P ∧
    P.map (fun ω => Z u ω - Z s ω) =
      multivariateGaussian 0 (((u - s : ℝ≥0) : ℝ) • (1 : Matrix ι ι ℝ)))

/-! ## Upper semi-analytic functions (Notations (ii), p. 4) -/

/-- `f` is upper semi-analytic: `{f > c}` is analytic for every real `c`. -/
def IsUpperSemianalytic {X : Type*} [TopologicalSpace X] (f : X → EReal) : Prop :=
  ∀ c : ℝ, AnalyticSet {x | (c : EReal) < f x}

/-! ## Control space (Notations (v), pp. 4–5) -/

/-- `π⁻¹` extended to `ℝ ∪ {−∞, ∞}`: `some u` at `π u`, the cemetery `∂ = none` elsewhere. -/
noncomputable def πinv {U : Type*} (π : U → ℝ) : EReal → Option U :=
  Function.extend (fun u => ((π u : ℝ) : EReal)) some (fun _ => none)

/-- The `U`-valued reading of `π⁻¹`: `∂` is replaced by `u₀`. -/
noncomputable def πinvU {U : Type*} (π : U → ℝ) (u₀ : U) (x : EReal) : U :=
  (πinv π x).getD u₀

/-- `π⁻¹(x) ∈ U`, i.e. `x ∈ π(U)`. -/
def InRangeπ {U : Type*} (π : U → ℝ) (x : EReal) : Prop :=
  x ∈ Set.range (fun u => ((π u : ℝ) : EReal))

/-- `π : U → [0,1]` is a Borel isomorphism onto its image. -/
structure IsControlEncoding {U : Type*} [MeasurableSpace U] (π : U → ℝ) : Prop where
  measurableEmbedding : MeasurableEmbedding π
  mem_unit : ∀ u, π u ∈ Set.Icc (0:ℝ) 1

theorem measurable_πinvU {U : Type*} [MeasurableSpace U] {π : U → ℝ} (hπ : IsControlEncoding π)
    (u₀ : U) : Measurable (πinvU π u₀) := by
  have he : MeasurableEmbedding (fun u => ((π u : ℝ) : EReal)) :=
    EReal.measurableEmbedding_coe.comp hπ.measurableEmbedding
  have hinj : Function.Injective (fun u => ((π u : ℝ) : EReal)) := he.injective
  have : πinvU π u₀ = Function.extend (fun u => ((π u : ℝ) : EReal)) id (fun _ => u₀) := by
    funext x
    by_cases hx : ∃ u, ((π u : ℝ) : EReal) = x
    · obtain ⟨u, rfl⟩ := hx
      simp only [πinvU, πinv]
      rw [hinj.extend_apply, hinj.extend_apply]
      rfl
    · simp only [πinvU, πinv]
      rw [Function.extend_apply' _ _ _ hx, Function.extend_apply' _ _ _ hx]
      rfl
  rw [this]
  exact he.measurable_extend measurable_id measurable_const

/-! ## Coefficients (§2, p. 5) -/

/-- The coefficient and reward functions `b, σ, σ₀, L, g` of §2. -/
structure Coeffs (T : ℝ≥0) (n d ℓ : ℕ) (U : Type*) [MeasurableSpace U] where
  b : ℝ≥0 → Cpath T n → ProbabilityMeasure (Cpath T n × U) → U → EuclideanSpace ℝ (Fin n)
  σ : ℝ≥0 → Cpath T n → ProbabilityMeasure (Cpath T n × U) → U → Matrix (Fin n) (Fin d) ℝ
  σ₀ : ℝ≥0 → Cpath T n → ProbabilityMeasure (Cpath T n × U) → U → Matrix (Fin n) (Fin ℓ) ℝ
  L : ℝ≥0 → Cpath T n → ProbabilityMeasure (Cpath T n × U) → U → ℝ
  g : Cpath T n → ProbabilityMeasure (Cpath T n) → ℝ

/-- The standing assumptions on the coefficients (§2, p. 5): Borel measurable on
`[0,T] × 𝒞ⁿ × 𝒫(𝒞ⁿ × U) × U` (resp. `𝒞ⁿ × 𝒫(𝒞ⁿ)`), and non-anticipative. -/
structure Coeffs.IsAdmissible {T : ℝ≥0} {n d ℓ : ℕ} {U : Type*} [MeasurableSpace U]
    (c : Coeffs T n d ℓ U) : Prop where
  meas_b : Measurable (fun z : Set.Icc (0:ℝ≥0) T × Cpath T n × ProbabilityMeasure (Cpath T n × U)
    × U => c.b z.1 z.2.1 z.2.2.1 z.2.2.2)
  meas_σ : ∀ i j, Measurable (fun z : Set.Icc (0:ℝ≥0) T × Cpath T n ×
    ProbabilityMeasure (Cpath T n × U) × U => c.σ z.1 z.2.1 z.2.2.1 z.2.2.2 i j)
  meas_σ₀ : ∀ i j, Measurable (fun z : Set.Icc (0:ℝ≥0) T × Cpath T n ×
    ProbabilityMeasure (Cpath T n × U) × U => c.σ₀ z.1 z.2.1 z.2.2.1 z.2.2.2 i j)
  meas_L : Measurable (fun z : Set.Icc (0:ℝ≥0) T × Cpath T n × ProbabilityMeasure (Cpath T n × U)
    × U => c.L z.1 z.2.1 z.2.2.1 z.2.2.2)
  meas_g : Measurable (fun z : Cpath T n × ProbabilityMeasure (Cpath T n) => c.g z.1 z.2)
  nonanticipative : ∀ t ≤ T, ∀ x ν u,
    c.b t x ν u = c.b t (stopPath t x) (lawStopProd ν t) u ∧
    c.σ t x ν u = c.σ t (stopPath t x) (lawStopProd ν t) u ∧
    c.σ₀ t x ν u = c.σ₀ t (stopPath t x) (lawStopProd ν t) u ∧
    c.L t x ν u = c.L t (stopPath t x) (lawStopProd ν t) u

end

end MKVDPP.Weak


