namespace Prm

variable (q : Ref.Params)

theorem te_le (i : ℕ) : q.te i ≤ q.e := by unfold Ref.Params.te; split_ifs <;> omega

theorem r_eq : q.r = 2 ^ q.e := rfl

theorem fn_eq : q.fn = 4 * q.r * q.P := rfl

theorem F_eq : q.F = 2 ^ q.fn + 1 := rfl

/-- Every outer axis `(j, E)` has `2^j E = 2 fn`. -/
theorem outerAxes_root : ∀ p ∈ q.outerAxes, 2 ^ p.1 * p.2 = 2 * q.fn := by
  intro p hp
  simp only [Ref.Params.outerAxes, List.mem_map, List.mem_range] at hp
  obtain ⟨i, _, rfl⟩ := hp
  simp only
  have hle := NLogN.FW.Prm.te_le q i
  have hd : 2 ^ q.te i ∣ 2 * q.fn := by
    rw [NLogN.FW.Prm.fn_eq, NLogN.FW.Prm.r_eq]
    exact Dvd.dvd.mul_left (Dvd.dvd.mul_right (Dvd.dvd.mul_left (pow_dvd_pow 2 hle) _) _) _
  exact Nat.mul_div_cancel' hd

theorem outerAxes_j_le : ∀ p ∈ q.outerAxes, p.1 ≤ q.e := by
  intro p hp
  simp only [Ref.Params.outerAxes, List.mem_map, List.mem_range] at hp
  obtain ⟨i, _, rfl⟩ := hp
  exact NLogN.FW.Prm.te_le q i

theorem blockSize_outerAxes : Ref.blockSize q.outerAxes = 2 ^ q.logOuter := by
  simp [Ref.blockSize, Ref.Params.outerAxes, Ref.Params.logOuter, List.map_map]
  rfl

end Prm

theorem LvlOK.reverse {n kb W N J : ℕ} {D : List Desc} (h : LvlOK n kb W N J D) :
    LvlOK n kb W N J D.reverse := fun d hd => h d (List.mem_reverse.1 hd)

theorem descOK_of (n kb W N J : ℕ) (d : Desc) (hd : d.1 * (2 ^ d.2.1 * d.2.2.2) = N ∧ 1 ≤ d.1 ∧
    1 ≤ d.2.2.2 ∧ 2 ^ d.2.1 * d.2.2.1 = 2 * n ∧ d.2.1 ≤ J) (hN : N ≤ 2 ^ kb)
    (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W) : DescOK n kb W N d := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hd
  have : d.2.2.1 ≤ 2 * n := by
    rw [← h4]; exact Nat.le_mul_of_pos_left _ (by positivity)
  exact ⟨h1, h2, h3, hN, by omega, by omega, by omega, by omega⟩

theorem passOK_dif (M : MulSpec) (n kb W N J : ℕ) (D : List Desc) (hD : LvlOK n kb W N J D)
    (hn : 1 ≤ n) (hN : N ≤ 2 ^ kb) (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W) :
    PassOK M difPrc (Gd n) (difCost n) n kb W N J D := fun d hd =>
  ⟨descOK_of n kb W N J d (hD d hd) hN hW hJ, trOK_dif M n d.2.1 d.2.2.1 hn (Or.inr (hD d hd).2.2.2.1),
    gOK_dif n d.2.1 d.2.2.1, (hD d hd).2.2.2.2⟩

theorem passOK_dit (M : MulSpec) (n kb W N J : ℕ) (D : List Desc) (hD : LvlOK n kb W N J D)
    (hn : 1 ≤ n) (hN : N ≤ 2 ^ kb) (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W) :
    PassOK M ditPrc (Gt n) (ditCost n) n kb W N J D := fun d hd =>
  ⟨descOK_of n kb W N J d (hD d hd) hN hW hJ, trOK_dit M n d.2.1 d.2.2.1 hn (Or.inr (hD d hd).2.2.2.1),
    gOK_dit n d.2.1 d.2.2.1, (hD d hd).2.2.2.2⟩

/-- The levels of the outer axes of `q` satisfy the conditions. -/
theorem lvlOK_params (q : Ref.Params) (kb W : ℕ) :
    LvlOK q.fn kb W (2 ^ q.logOuter) q.e (descs q.outerAxes 1) := by
  intro d hd
  obtain ⟨h1, h2, h3, h4⟩ := descs_facts q.outerAxes 1 le_rfl d hd
  refine ⟨by rw [h1, Prm.blockSize_outerAxes, one_mul], h2, h3,
    Prm.outerAxes_root q _ h4, Prm.outerAxes_j_le q _ h4⟩

end NLogN.FW

end

