-- title:
--   Cost-feasible laws are generated by two-point laws
-- statement:
--   Let $X$ be a set, let $c:X\to\mathbb R$ be any cost function, and let $\gamma\in\mathbb R$. Write $\mathcal P_{c,\gamma}(X)$ for the finitely supported probability laws $P$ with $\sum_xP(x)c(x)\le\gamma$, and let $\mathcal P_{c,\gamma,2}(X)$ be those supported on at most two points. In the real vector space of finitely supported arrays, $$\mathcal P_{c,\gamma}(X)=\operatorname{conv}(\mathcal P_{c,\gamma,2}(X)).$$ Moreover, each feasible $P$ is a finite convex combination of such laws $Q$ with $\operatorname{supp}Q\subseteq\operatorname{supp}P$ and $\mathbb E_Q[c]=\mathbb E_P[c]$.
--
--   The decomposition reduces optimization under one mean-cost constraint to two-point laws. No closure, topology, or global finiteness of $X$ is needed.
-- source:
--   General formulas for capacity of classical-quantum channels, arXiv:quant-ph/0206186v4, PDF p. 28, Section 8; Appendix II, p.31

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier18_P03

noncomputable section

open Filter

namespace QAlgorithms.Papers.Independent.Frontier18.P03

/-- PDF p.28 and Appendix II, p.31: feasible laws form the finite convex
hull of feasible laws supported on at most two points. The second clause
retains the proof's stronger support- and mean-preserving decomposition.
There is no closure, finite-alphabet, topology or nonnegative-cost hypothesis. -/
theorem feasible_laws_two_point_convex_hull
    {X : Type*} (c : X → ℝ) (gamma : ℝ) :
    feasibleLaws c gamma =
      convexHull ℝ {p : X →₀ ℝ | p ∈ feasibleLaws c gamma ∧ p.support.card ≤ 2} ∧
    ∀ p ∈ feasibleLaws c gamma,
      p ∈ convexHull ℝ {q : X →₀ ℝ |
        q ∈ feasibleLaws c gamma ∧ q.support.card ≤ 2 ∧
        q.support ⊆ p.support ∧ meanCost c q = meanCost c p} := by sorry

end QAlgorithms.Papers.Independent.Frontier18.P03

end
