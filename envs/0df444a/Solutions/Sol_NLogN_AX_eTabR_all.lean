theorem solution (p s t α Bq : ℕ) (st : NLogN.IState NLogN.HS) (hs : 0 < s)
    (hP : ∃ L, st.G NLogN.AX.bO = .int (p : ℤ) :: L) (hS : ∃ L, st.G NLogN.AX.bS = .int (s : ℤ) :: L)
    (hT : ∃ L, st.G NLogN.AX.bT = .int (t : ℤ) :: L) (hM : ∃ L, st.G NLogN.AX.xE = .int (HvdH.eWidth p α : ℤ) :: L)
    (hA : ∃ L, st.G NLogN.AX.bI = .int ((α ^ 2 : ℕ) : ℤ) :: L) (hK : ∃ L, st.G NLogN.AX.xK = .int ((s ^ 2 : ℕ) : ℤ) :: L)
    (hR : ∃ L, st.G NLogN.AX.bNR = .int ((2 * HvdH.eWidth p α + 1 : ℕ) : ℤ) :: L)
    (hBq : (α ^ 2 + s + t + 2 * HvdH.eWidth p α + 2) ^ 24 < 2 ^ Bq) (hpB : NLogN.zsz (p : ℤ) ≤ Bq)
    (hKB : NLogN.zsz ((s ^ 2 : ℕ) : ℤ) ≤ Bq) (hEB : ∀ j, NLogN.zsz (HvdH.expNeg p (s ^ 2) j) ≤ Bq) :
    NLogN.AX.eTabR.ok st ∧ NLogN.AX.eTabR.run st = st.upd NLogN.AX.bW (NLogN.ints (NLogN.Rsp.eTab p s t α).flatten ++ st.G NLogN.AX.bW) ∧
      NLogN.AX.eTabR.cost st ≤ NLogN.Rsp.tabCost (2 * HvdH.eWidth p α + 1) s (NLogN.Rsp.eWCost p Bq) := by
  obtain ⟨L1, h1⟩ := hP; obtain ⟨L2, h2⟩ := hS; obtain ⟨L3, h3⟩ := hT; obtain ⟨L4, h4⟩ := hM
  obtain ⟨L5, h5⟩ := hA; obtain ⟨L6, h6⟩ := hK; obtain ⟨L7, h7⟩ := hR
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8⟩ := NLogN.AX.πE_vals
  have K := NLogN.Rsp.eTabBP_all (st.rn NLogN.AX.πE⁻¹) p s t α Bq L1 L2 L3 L4 L5 L6 L7 hs
    (by rw [NLogN.Rsp.rn_inv_G, v1, h1]) (by rw [NLogN.Rsp.rn_inv_G, v2, h2]) (by rw [NLogN.Rsp.rn_inv_G, v3, h3])
    (by rw [NLogN.Rsp.rn_inv_G, v4, h4]) (by rw [NLogN.Rsp.rn_inv_G, v5, h5]) (by rw [NLogN.Rsp.rn_inv_G, v6, h6])
    (by rw [NLogN.Rsp.rn_inv_G, v7, h7]) hBq hpB hKB hEB
  have := NLogN.AX.ren_spec NLogN.AX.πE NLogN.AX.πE_fix NLogN.Rsp.eTabBP st NLogN.Rsp.BW _ _ K
  rw [v8] at this; exact this
