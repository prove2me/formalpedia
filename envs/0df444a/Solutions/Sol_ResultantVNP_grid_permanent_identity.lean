    have hkval : (k : ZMod m).val = k := ZMod.val_cast_of_lt (by omega)
    have hh := ht (by rw [hkval]; omega)
    simpa only [gridDown,Nat.cast_add,Nat.cast_one] using hh
  · have ht := (ha (i,((m-1 : ℕ) : ZMod m))).2.2.2.2.2
