/-- Actual pregeodesic (non-affine allowed) KS vector: `Ric_g(k,k) = Ric_b(k,k)`. -/
theorem ks_pregeodesic_ricci_contract_eq (hD : KSData b bi v k U) {x : Pt 5} (hx : x ∈ U)
    (hg : PregeodesicAt b bi k x) :
    contract2 (ricciOf (ksMetric b v k) (ksInverse bi v k)) x (k x) =
      contract2 (ricciOf b bi) x (k x) := by
  obtain ⟨κ, hκ⟩ := hg
