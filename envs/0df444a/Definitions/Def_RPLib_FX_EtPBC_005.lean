section KZ

variable {K E : Type} [Field K] [Field E] [Algebra K E] {Γ : Subgroup (E ≃ₐ[K] E)} {N : ℕ} [NeZero N]
  {ζ : E} (hζ : IsPrimitiveRoot ζ N)

theorem kchar_npow {γ : Eˣ} (hγ : γ ∈ rad Γ N) (σ : Γ) (j : ℕ) :
    kchar hζ (γ ^ j) σ = (j : ZMod N) * kchar hζ γ σ := by
  induction j with
  | zero => rw [pow_zero, Nat.cast_zero, zero_mul]; exact kchar_of_fix hζ (fixUnits Γ).one_mem σ
  | succ j ih =>
    rw [pow_succ, kchar_mul_left hζ ((rad Γ N).pow_mem hγ j) hγ σ, ih]
    push_cast
    ring

theorem kchar_inv {γ : Eˣ} (hγ : γ ∈ rad Γ N) (σ : Γ) : kchar hζ γ⁻¹ σ = -kchar hζ γ σ := by
  have h := kchar_mul_left hζ ((rad Γ N).inv_mem hγ) hγ σ
  rw [inv_mul_cancel, kchar_of_fix hζ (fixUnits Γ).one_mem σ] at h
  exact eq_neg_of_add_eq_zero_left h.symm

theorem kchar_zpow {γ : Eˣ} (hγ : γ ∈ rad Γ N) (σ : Γ) (m : ℤ) :
    kchar hζ (γ ^ m) σ = (m : ZMod N) * kchar hζ γ σ := by
  cases m with
  | ofNat n => rw [Int.ofNat_eq_natCast, zpow_natCast, kchar_npow hζ hγ σ n, Int.cast_natCast]
  | negSucc n =>
    rw [zpow_negSucc, kchar_inv hζ ((rad Γ N).pow_mem hγ _), kchar_npow hζ hγ σ, Int.cast_negSucc]
    ring

end KZ

