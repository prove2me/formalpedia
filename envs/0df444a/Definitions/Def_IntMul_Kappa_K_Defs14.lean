section
-- Source module: Solutions.KFESwap
/-!
# KFE: fine binary embedding / extraction and fine high-digit swaps

* `preB_fsp`, `postB_fsp`: KIL6's two padding passes of the binary embedding / extraction with
  fine cost `2 (10^9 (B+2)^2 + cPadF V B)` (were `cPad`).
* `swapsF q`: the `r` high-digit interchanges as an item-language loop (`irep`) whose body is
  KFD's fine interchange `swapEF` (KFC `fwdF`/`bwdF`) plus the two register updates;
  `swapsF_runs`: same denotation as `swapsP_sp`, cost
  `(r + 1) (cSw1F q V B + 10^4 (B+2))` with `cSw1F q V B = (4q+136)·276·V + 10^9 (B+2)^2`
  (no `(B+2)^2` factor on the volume).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false

namespace NLogN.KFE

open IntMul RS AModel AModelL12 KIL KFD

/-! ## Fine high-digit swaps -/

/-- The high-digit interchanges, fine version. -/
def swapsF {Pp : ℕ} (q : ℕ) : IStmt HS Pp :=
  irep 24 (.reg kR) (.seq (swapEF NLogN.KIL.swA (.lit (q : ℤ)) swB swC6)
    (RS.seq (.asg kQt (.mul (.reg kQt) (.lit (q : ℤ)))) (.asg kQr (.ndiv (.reg kQr) (.lit (q : ℤ))))).code)

/-- Fine cost bound of one digit interchange (bit data). -/
def cSw1F (q V Bb : ℕ) : ℕ := (4 * q + 136) * 276 * V + 10 ^ 9 * (Bb + 2) ^ 2

end NLogN.KFE

end

section
-- Source module: Solutions.KFEMain
/-!
# KFE: the fine Lemma 12 program

`l12F q m W` is KIL6's `l12I q m W` with every per-element pass made fine:

* the binary embedding / extraction (`preB`, `postB`) and the row padding of the middle part
  (`padR`, `unpadR`) are compiled by `KFD.fcode` (unary loop counters), cost `cPadF`;
* the high-digit interchanges are `swapsF` (KFC `fwdF`/`bwdF`), cost `cSw1F`;
* the descriptor (`preA`, `desc4`), the piece loop `piecesI` and the register file are unchanged
  (they cost `poly(Bb)` per step and touch no data).

`l12F_run`: for any oracle code meeting `CallSpec` (in particular the fine Prop. 11 code
`KFD.progF`), the program computes the variant denotation `l12v` (same as `l12_run`), at cost
`cL12F`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false

namespace NLogN.KFE

open IntMul RS AModel AModelL12 KIL KFD

/-- The middle part, fine version (row padding by `fcode`). -/
def midF (q m W : ℕ) : IStmt HS 1 :=
  .seq (desc4 W).code (.seq (fcode padR) (.seq (piecesI q m) (fcode unpadR)))

/-- Cost of the middle part. -/
def cMidF (K V m n : ℕ) (cO : ℕ → ℕ) (B : ℕ) : ℕ :=
  10 ^ 9 * (K + 3) * (B + 2) ^ 2 + 2 * cPadF V B + cPcs m n cO B

/-- **The fine Lemma 12 item-language program** (`q`, `m`, `W` are literals). -/
def l12F (q m W : ℕ) : IStmt HS 1 :=
  .seq (preA q m W).code (.seq (fcode preB) (.seq (NLogN.KFE.swapsF q)
    (.seq (.ite aN (fun c => c == Cls.zero) .skip (midF q m W)) (.seq (fcode postB) (popDs regD).code))))

/-- Fine cost of the Lemma 12 program. -/
def cL12F (u e r K n Vq V' m q : ℕ) (cO : ℕ → ℕ) (B : ℕ) : ℕ :=
  cPreA u e B + 4 * (10 ^ 9 * (B + 2) ^ 2 + cPadF Vq B) +
    (r + 1) * (cSw1F q Vq B + 10 ^ 4 * (B + 2)) + ((if n = 0 then 0 else cMidF K V' m n cO B) + 26) +
    25 * (2 * B + 2) + 1

end NLogN.KFE

end

section
-- Source module: Solutions.KIL6Inst
/-!
# KIL6: the Lemma 12 program with the Prop. 11 code as oracle

The oracle code is the uniform Prop. 11 program of KIL5 (`prog_il_uniform_rat`, i.e.
`progU (Qc.toCircuit 1) (edgeTplQ Qc)`).  Its denotation at the levels used is
`prog (Qc.toCircuit (q ^ m ^ Kp)) q`.  The variant denotation `l12v` is taken with the
length-normalised oracle `normO` (equal to the oracle on every call of the procedure, see
`normO_eq`; it only serves to state the uniform length invariant).

* `l12_il_uniform_rat`: the item-language program `l12I q m W` (with the oracle procedure table)
  computes `l12v (normO (prog …)) …`, with cost `cL12 … (ilCostU5 …)`, for every prime `q`, under
  the KIL5 level side conditions at the levels `j < Kp`;
* `l12_il_rat_correct`: if moreover the oracle is correct (`OracleSpec`, which holds for all large
  primes by `prop11_ratLabels`), the output is the interchange of the two `[2^u]` fields.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12 AModelRat AModelFac

section Norm

variable {α : Type*}

/-- The oracle made length-preserving (it is returned unchanged where it preserves length). -/
def normO (child : Oracle α) : Oracle α :=
  fun j P L A B Cs ys => if (child j P L A B Cs ys).length = ys.length then child j P L A B Cs ys
    else ys

end Norm

section Rat

variable {m W : ℕ} [NeZero W]

end Rat

end NLogN.KIL

end

