set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

/-! ## Clearing -/

theorem Rn.clrK {W : ℕ} {X C r : Fin HS} (hX : X ∉ rg) (hX5 : X.val < 56) (hC : C ∉ rg)
    (hC5 : C.val < 56) (hr : r ∈ rg) (hXC : X ≠ C) {v : Vr} {c : Cs} {L l : List ℤ}
    (hcX : c X = L ++ l) (hcC : c C = []) (hvr : v r = L.length) (hNW : L.length < 2 ^ W)
    (hL : ∀ x ∈ L, |x| < 2 ^ W) :
    Rn (PJ.clrK X C r) v c (· = v) (update c X l) (cClr W L.length) := by
  have H := Rn.rep (C := C) (r := r) (b := .pop X) hC hC5 hr
    (by simp only [RS.writes, List.mem_singleton]; exact fun h => hXC h.symm) (N := L.length)
    (Iv := fun _ u => u = v) (cf := fun k => update c X (L.drop k ++ l)) (cb := 2 * W + 2)
    (B := W + 1) (fun k => by rw [update_of_ne (Ne.symm hXC)]; exact hcC) (zsz_nat_le hNW)
    (fun k hk u hu => by
      subst hu
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have R := Rn.pop (W := W) (v := u)
        (c := update (update c X (L.drop k ++ l)) C [((L.length : ℤ) - k)]) (i := X) hX hX5
        (a := L[k]) (l := L.drop (k + 1) ++ l)
        (by rw [update_of_ne hXC, update_self, hd, List.cons_append])
        (hL _ (List.getElem_mem hk))
      refine R.congr ?_
      rw [update_comm hXC, update_idem, update_comm hXC.symm])
    rfl hvr
  have e0 : update c X (L.drop 0 ++ l) = c := by
    rw [List.drop_zero, Function.update_eq_self_iff]; exact hcX.symm
  rw [e0] at H
  simp only [List.drop_length, List.nil_append] at H
  unfold PJ.clrK cClr
  exact H

/-! ## The `M⁻¹` row loop -/

/-! ## The column loop -/

