    simp only [Ex.cost, cost_congr a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h
    simp only [Ex.cost, cost_congr a h, eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.cost, cost_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
