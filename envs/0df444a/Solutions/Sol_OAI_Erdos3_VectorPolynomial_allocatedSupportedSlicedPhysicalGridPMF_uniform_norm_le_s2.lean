      (mul_le_of_le_one_left hcap0 hscale))
  unfold allocatedSupportedSlicedPhysicalGridPMF
  rw [allocatedSupportedSlicedResidueJetPMF_constant_mixture_s2 B U basis hR hσ S q r H step c hH hsubset hcell
    j i hgrid rows x]
