theorem ModularCurve.eq_zero_of_torsion_of_mem_specializationKernel_jZero (N p : ℕ) [NeZero N]
    {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓNp : ¬ ℓ ∣ N * p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ)
    (x : ModularCurve.JZero N) (hx : ∃ n : ℕ, p ^ n • x = 0)
    (hmem : x ∈ AddSubgroup.closure
      ({y : ModularCurve.JZero N | ∃ τ ∈ A.inertiaSubgroupIn ℚ, ∃ z : ModularCurve.JZero N,
          y = τ • z - z} ∪
       {y : ModularCurve.JZero N | ∃ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
          A.IsFrobeniusAt σ ℓ ∧ ∃ z : ModularCurve.JZero N,
            y = σ • σ • z - ModularCurve.heckeOperatorBar N ⟨ℓ, hℓ⟩ (σ • z) + ℓ • z})) :
    x = 0 := by sorry
