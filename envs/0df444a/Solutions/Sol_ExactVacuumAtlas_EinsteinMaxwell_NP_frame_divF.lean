open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

/-! ### Definitions -/

/-! ### Basic algebra -/

theorem omegaC_apply (g gi : Metric n) (E Θ : Fin n → Fin n → Pt n → ℂ) (μ : Fin n) (x : Pt n) (C B : Fin n) :
    omegaC g gi E Θ μ x C B = ∑ ν, Θ C ν x * (cpdC μ (E B ν) x
      + ∑ l, (christoffel g gi ν μ l x : ℂ) * E B l x) := by
  simp only [omegaC, Matrix.mul_apply, Matrix.add_apply, pdMC_apply, coMat, frMat, GamC, Matrix.map_apply,
    connMat_apply, Matrix.of_apply]

/-- `Ω_A^C_B = Σ_ν θ^C_ν (D_A e_B^ν + Σ_{μλ} Γ^ν_{μλ} e_A^μ e_B^λ)` (no hypothesis). -/
theorem Omega_apply (g gi : Metric n) (E Θ : Fin n → Fin n → Pt n → ℂ) (A : Fin n) (x : Pt n) (C B : Fin n) :
    Omega g gi E Θ A x C B = ∑ ν, Θ C ν x * (fdir E A (E B ν) x
      + ∑ μ, ∑ l, (christoffel g gi ν μ l x : ℂ) * E A μ x * E B l x) := by
  simp only [Omega, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, omegaC_apply, fdir, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  simp only [mul_add, Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  · exact Finset.sum_congr rfl fun μ _ => by ring
  · exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun l _ => by ring

namespace FrameData

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem isOpen (hF : FrameData g gi E Θ U) : IsOpen U := hF.metric.isOpen

theorem compl (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) : frMat E x * coMat Θ x = 1 :=
  mul_eq_one_comm.mp (hF.dual x hx)

/-- `Σ_μ θ^C_μ e_B^μ = δ^C_B`. -/
theorem dual_apply (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (C B : Fin n) :
    ∑ μ, Θ C μ x * E B μ x = (1 : Matrix (Fin n) (Fin n) ℂ) C B := by
  have := congrFun (congrFun (hF.dual x hx) C) B
  simpa [Matrix.mul_apply, coMat, frMat] using this

/-- Completeness `Σ_C e_C^ν θ^C_ρ = δ^ν_ρ`. -/
theorem compl_apply (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (ν ρ : Fin n) :
    ∑ C, E C ν x * Θ C ρ x = (1 : Matrix (Fin n) (Fin n) ℂ) ν ρ := by
  have := congrFun (congrFun (hF.compl hx) ν) ρ
  simpa [Matrix.mul_apply, coMat, frMat] using this

/-- Expanding a coordinate vector in the frame: `Σ_C (θ^C(w)) e_C^ν = w^ν`. -/
theorem sum_coeff (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (w : Fin n → ℂ) (ν : Fin n) :
    ∑ C, (∑ ρ, Θ C ρ x * w ρ) * E C ν x = w ν := by
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  have h : ∀ ρ, ∑ C, Θ C ρ x * w ρ * E C ν x = (1 : Matrix (Fin n) (Fin n) ℂ) ν ρ * w ρ := by
    intro ρ
    rw [← hF.compl_apply hx ν ρ, Finset.sum_mul]
    exact Finset.sum_congr rfl fun C _ => by ring
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]

end FrameData

