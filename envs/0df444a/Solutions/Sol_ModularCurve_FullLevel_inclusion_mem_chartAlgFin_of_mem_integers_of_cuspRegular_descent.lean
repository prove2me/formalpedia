  haveI hjfact : Fact (e.symm j₁ ≠ 0) := ⟨fun h => by
    have h1 : j₁ = 0 := by rw [← hej, h, map_zero]
    exact (Fact.out : (⟨_, hjF₀⟩ : ↥F₀) ≠ 0) ((RingEquiv.map_eq_zero_iff Φ).mp h1)⟩

  haveI : CharZero ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) := charZero_of_injective_algebraMap (algebraMap ℚ ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))).injective
  have hAq : (q : ↥(A.comap (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ)))) ∈ maximalIdeal ↥(A.comap (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ))) := by
    have hA' : ((q : ℕ) : AlgebraicClosure ℚ) ∈ A.nonunits := hA
