  apply _root_.AFT.GaussianSource.finiteLaw_full_support
  intro residue
  apply (PMF.mem_support_map_iff _ _ _).mpr
  refine ⟨fun coordinate => (residue coordinate).val, ?_, ?_⟩
  · exact _root_.AFT.GaussianSource.latticeGaussian_full_support dimension width hwidth _
  · funext coordinate
