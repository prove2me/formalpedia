  letI := TateLocal.localBorel K v
  haveI : BorelSpace (v.adicCompletion K) := ⟨rfl⟩
  have hN : (Ideal.absNorm v.asIdeal : NNReal) ≠ 0 := by
    have h : Ideal.absNorm v.asIdeal ≠ 0 := by
      rw [Ne, Ideal.absNorm_eq_zero_iff]
      exact v.ne_bot
    exact_mod_cast h
  unfold TateLocal.selfDualHaarAt
  exact Measure.IsAddHaarMeasure.nnreal_smul _ (NNReal.rpow_pos (pos_iff_ne_zero.2 hN)).ne'

private theorem t0652 :
    (((↑) : (v.adicCompletion K)ˣ → v.adicCompletion K) '' TateLocal.higherUnitsAt K v 1) =
      (fun x => 1 + x) '' d067 v (-1) := by
  ext x
  constructor
  · rintro ⟨u, hu, rfl⟩
    rw [TateLocal.mem_higherUnitsAt_iff] at hu
    refine ⟨(u : v.adicCompletion K) - 1, ?_, by ring⟩
    show Valued.v ((u : v.adicCompletion K) - 1) ≤ WithZero.exp (-1)
    simpa using hu.2
  · rintro ⟨y, hy, rfl⟩
    have hy' : Valued.v y < 1 := lt_of_le_of_lt hy (by rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num)
    have hval : Valued.v (1 + y) = 1 := by
      rw [Valuation.map_add_eq_of_lt_left _ (by rwa [Valuation.map_one])]
      exact Valuation.map_one _
    have hne : 1 + y ≠ 0 := fun h => by rw [h, Valuation.map_zero] at hval; exact zero_ne_one hval
    refine ⟨Units.mk0 _ hne, ?_, rfl⟩
    rw [TateLocal.mem_higherUnitsAt_iff]
    refine ⟨hval, Or.inr ?_⟩
    simpa using (t0636 v).1 hy

private theorem t0653 :
    letI := TateLocal.localBorel K v
    (TateLocal.selfDualHaarAt K v).real (d067 v (-1)) =
      (Ideal.absNorm v.asIdeal : ℝ)⁻¹ *
        (Ideal.absNorm v.asIdeal : ℝ) ^ (-(TateLocal.addCharLevel (StandardAddChar.psiLocal K v) : ℝ) / 2) := by
  letI := TateLocal.localBorel K v
  haveI : BorelSpace (v.adicCompletion K) := ⟨rfl⟩
  haveI := t0651 v
  have h := TateLocal.selfDualHaarAt_real_image_higherUnitsAt K v 1 le_rfl
  rw [t0652, Set.image_add_left] at h
  simp only [Measure.real, measure_preimage_add] at h
  show ((TateLocal.selfDualHaarAt K v) (d067 v (-1))).toReal = _
  rw [h]
