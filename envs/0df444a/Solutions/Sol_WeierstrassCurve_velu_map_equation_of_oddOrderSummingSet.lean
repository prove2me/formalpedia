def ord (f : F) : ℤ := -(WithZero.log (v.adicValuation f))

@[scoped simp]
theorem ord_zero : v.ord (0 : F) = 0 := by simp [ord]

@[scoped simp]
theorem ord_one : v.ord (1 : F) = 0 := by simp [ord]

theorem ord_mul {f g : F} (hf : f ≠ 0) (hg : g ≠ 0) :
    v.ord (f * g) = v.ord f + v.ord g := by
