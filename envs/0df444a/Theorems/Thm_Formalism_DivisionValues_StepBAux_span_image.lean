variable {K : Type} [Field K] [NumberField K] [StarRing K]

theorem Formalism.DivisionValues.StepBAux.span_image {d : ℕ} (φ : Matrix (Fin d) (Fin d) K) (e : Fin d → Fin d → K) :
    Submodule.span (𝓞 K) (Set.range fun i => φ *ᵥ e i) =
      matLat φ (Submodule.span (𝓞 K) (Set.range e)) := by sorry
