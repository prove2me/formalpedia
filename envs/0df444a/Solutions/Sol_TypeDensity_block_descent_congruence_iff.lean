      ∀ j, ((TypeDensity.monicPolyO a).map (AdjoinRoot.of Φ)).coeff j -
        ((TypeDensity.monicPolyO a').map (AdjoinRoot.of Φ)).coeff j ∈ (TypeDensity.baseIdeal O Φ) ^ L := by
    simp only [Polynomial.coeff_map, ← map_sub, ← AdjoinRoot.algebraMap_eq, hpure]
    refine ⟨fun h => (TypeDensity.monic_coeff_sub_mem_iff _ _ _ _ hA.1 hA'.1 hA.2.1 hA'.2.1).1
