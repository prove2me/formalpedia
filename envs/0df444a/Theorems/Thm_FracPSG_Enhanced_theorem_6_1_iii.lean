-- title:
--   Theorem 6.1(iii) — cluster points of the enhanced e-PSG algorithm are strong lifted stationary points
-- statement:
--   Let $H$ be a finite-dimensional real Hilbert space, $S\subseteq H$ nonempty closed convex, and consider $\min_{x\in S} f(x)/g(x)$ with $f=f^{\mathfrak s}+f^{\mathfrak n}$ as in Assumption 1 and $g=\max_{1\le i\le p}g_i$ as in Assumption 2′ (each $g_i$ continuously differentiable near $S$ and weakly convex on $S$, and $m\le g\le M$ on $S\cap\operatorname{dom}f$). Let $(x_n)$ be generated by Algorithm 2 (the enhanced extrapolated proximal subgradient algorithm), and suppose the set $\{x\in S: f(x)/g(x)\le f(x_0)/g(x_0)\}$ is bounded.
--
--   If $\liminf_{n\to+\infty}\tau_n=\bar\tau>0$, then for every cluster point $\bar x$ of $(x_n)$:
--   1. $\bar x\in S\cap\operatorname{dom}f$;
--   2. $\lim_{n\to+\infty} f(x_n)/g(x_n)=f(\bar x)/g(\bar x)$;
--   3. $$\frac{f(\bar x)}{g(\bar x)}\bigcup_{i\in I_0(\bar x)}\nabla g_i(\bar x)\ \subseteq\ \partial_L(f+\iota_S)(\bar x);\qquad(28)$$
--   4. if in addition $f$ is weakly convex on $S$, then $\bar x$ is a strong lifted stationary point of the problem: $f(\bar x)\,\partial_L g(\bar x)\subseteq g(\bar x)\,\partial_L(f+\iota_S)(\bar x)$.
--
--   For a max-type denominator, the lifted stationarity guaranteed by the basic algorithm only asks for one element of $\partial_L g(\bar x)$; the strong notion asks the inclusion for all of them, and rules out stationary points such as $\bar x=0$ in $\min_{|x|\le1}(x^2+1)/(|x|+1)$.
--
--   **Formalization Note** The run uses the step-size rule $0<\tau_n\le1/\max\{\sqrt\beta\theta_n/\zeta,\delta\}$ that the proof uses (the source prints $\beta\theta_n/(1-\zeta)$), and the active-set parameter $\varepsilon>0$ in place of the misprinted $\omega$; see the definition of Algorithm 2. "Weakly convex on $S$" for $f$ is convexity of the epigraph of $f+\iota_S+\frac\rho2\|\cdot\|^2$ for some $\rho\ge0$, and is a hypothesis of the last claim only. The strong lifted inclusion is unfolded elementwise; $I_0(\bar x)$ uses `Fin p` indices.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 22, Theorem 6.1(iii)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Theorem 6.1(iii) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 22): for a run of Algorithm 2 under
Assumptions 1 and 2′ with bounded `S₀`, if `liminf τₙ = τ̄ > 0`, then every cluster point `x̄` of
the iterates satisfies `x̄ ∈ S ∩ dom f`, `f(xₙ)/g(xₙ) → f(x̄)/g(x̄)`, and (28)
`(f(x̄)/g(x̄)) ⋃_{i ∈ I₀(x̄)} ∇gᵢ(x̄) ⊆ ∂_L(f + ι_S)(x̄)`; in addition, if `f` is weakly convex on
`S`, then `x̄` is a strong lifted stationary point of (P). -/
theorem theorem_6_1_iii
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0)))
    (hτ : 0 < Filter.liminf τ atTop) :
    ∀ xbar : EuclideanSpace ℝ (Fin N), MapClusterPt xbar atTop x →
      xbar ∈ S ∧ FracPSG.Subseq.objF fs fn xbar ≠ ⊤ ∧
      Tendsto (fun n => FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n)) atTop
        (𝓝 (FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) xbar)) ∧
      (∀ i ∈ activeSet 0 gi xbar,
        FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) xbar • gradient (gi i) xbar ∈
          LimitingSubdiff (FracPSG.Subseq.addInd (FracPSG.Subseq.objF fs fn) S) xbar) ∧
      ((∃ ρ : ℝ, IsWeaklyConvexOnE S (FracPSG.Subseq.objF fs fn) ρ) →
        IsStrongLiftedStationary (FracPSG.Subseq.objF fs fn) (maxFn gi) S xbar) := by sorry

end FracPSG.Enhanced
