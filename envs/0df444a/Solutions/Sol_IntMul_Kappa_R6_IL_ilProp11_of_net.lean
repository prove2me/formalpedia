/-!
# Round six, item language: the cost of the general procedure against `costH`

`costN_real`: `costN e V ≤ (2 cq + Kv) · V · cH e + KA · ovN e · (Bb + 2)²` for `e ≥ 1`, where
`ovN` counts `(e + 1)` per node of the call tree; `ovN_le`: `ovN e ≤ (e + 1) (S + 1) ^ depH e`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

theorem ovN_eq (C : Bit.QHNet (ZMod 2) W T m) (e : ℕ) :
    ovN C e = (e + 1) + (if m ≤ e then ((runsL C).map fun ρ => if h : ρ.2.2 * (e / m) < e then
      ovN C (ρ.2.2 * (e / m)) else 0).sum else 0) := by
  rw [ovN]

theorem run_facts (C : Bit.QHNet (ZMod 2) W T m) (hruns : C.RunsOK) {e : ℕ} (hm : 2 ≤ m)
    (hme : m ≤ e) {ρ : ℕ × ℕ × ℕ} (hρ : ρ ∈ runsL C) :
    ρ.2.2 * (e / m) < e ∧ 1 ≤ ρ.2.2 * (e / m) ∧ ρ.2.2 < m := by
  obtain ⟨e', he', hρ'⟩ := List.mem_flatMap.1 hρ
  obtain ⟨hr0, hrm, hi, hj⟩ := hruns e' he' ρ hρ'
  have hf : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  exact ⟨Bit.width_lt hme hrm, Nat.mul_pos hr0 hf, hrm⟩

/-- The overhead weight is at most `(e + 1) (S + 1) ^ depH e`. -/
theorem ovN_le (C : Bit.QHNet (ZMod 2) W T m) (hm : 2 ≤ m) (hruns : C.RunsOK) :
    ∀ e, ovN C e ≤ (e + 1) * ((runsL C).length + 1) ^ Bit.depH m e := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  set S := (runsL C).length with hS
  by_cases hme : m ≤ e
  · rw [ovN_eq, if_pos hme, Bit.depH_of_le hme hm]
    set d := Bit.depH m ((m - 1) * (e / m))
    have hch : ∀ ρ ∈ runsL C, (if h : ρ.2.2 * (e / m) < e then ovN C (ρ.2.2 * (e / m)) else 0)
        ≤ (e + 1) * (S + 1) ^ d := by
      intro ρ hρ
      obtain ⟨hlt, h1e, hrm⟩ := run_facts C hruns hm hme hρ
      rw [dif_pos hlt]
      have hd : Bit.depH m (ρ.2.2 * (e / m)) ≤ d := by
        have := Bit.depH_child hm hme hrm
        rw [Bit.depH_of_le hme hm] at this
        omega
      calc ovN C (ρ.2.2 * (e / m)) ≤ (ρ.2.2 * (e / m) + 1) * (S + 1) ^ Bit.depH m (ρ.2.2 * (e / m)) :=
            ih _ hlt
        _ ≤ (e + 1) * (S + 1) ^ d :=
            Nat.mul_le_mul (by omega) (Nat.pow_le_pow_right (by omega) hd)
    have hs := List.sum_le_sum hch
    rw [List.map_const', List.sum_replicate, smul_eq_mul, ← hS] at hs
    have e1 : (e + 1) * (S + 1) ^ (d + 1) = (e + 1) * (S + 1) ^ d * S + (e + 1) * (S + 1) ^ d := by
      rw [pow_succ]; ring
    have h1 : 1 ≤ (S + 1) ^ d := Nat.one_le_pow _ _ (by omega)
    have h2 : e + 1 ≤ (e + 1) * (S + 1) ^ d := Nat.le_mul_of_pos_right _ h1
    have h3 : S * ((e + 1) * (S + 1) ^ d) = (e + 1) * (S + 1) ^ d * S := by ring
    rw [e1]
    omega
  · rw [ovN_eq, if_neg hme, Bit.depH_of_not (by tauto)]
    simp

end

end IntMul.Kappa.R6.IL

