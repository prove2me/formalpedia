  refine he'.2.2.1.elim fun q hq => ?_
  have hq_surj := hq.1
  have hq_pts := hq.2
  refine he'.2.2.2.elim fun φ' hφ' => ?_
  have hφ'_aug := hφ'.1
  have hφ'_act := hφ'.2
  haveI := hHfin
  haveI := hHflat
  haveI := hHcocomm
  haveI hHfree : Module.Free (GaloisRep.ratLocalizedAt p) H := JZeroTorsionTower.free_of_flat p H
  have hpt : ∀ x : I.H₁,
      φ' (heckeGen ⟨p, hp.out⟩) (q x) =
        q ((I.t₁H (heckeGen ⟨p, hp.out⟩) : I.H₁ →ₐ[GaloisRep.ratLocalizedAt p] I.H₁) x) :=
    fun x => RK2DRestrictionLeg.apply_eq_of_points p I.H₁ eG (RK2DAssembly.act M p)
