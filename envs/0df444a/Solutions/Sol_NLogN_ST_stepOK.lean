open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref

theorem prcOK_of_noPrc {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} (pc : ℕ → Fin P) :
    ∀ p : RM, noPrc p = true → RM.PrcOK I iprog pc p
  | .rs _, _ => trivial
  | .mul .., _ => trivial
  | .op _, _ => trivial
  | .seq a b, h => by
    simp only [noPrc, Bool.and_eq_true] at h
    exact ⟨prcOK_of_noPrc pc a h.1, prcOK_of_noPrc pc b h.2⟩
  | .ite _ a b, h => by
    simp only [noPrc, Bool.and_eq_true] at h
    exact ⟨prcOK_of_noPrc pc a h.1, prcOK_of_noPrc pc b h.2⟩
  | .rep _ _ b, h => prcOK_of_noPrc pc b h
  | .prc .., h => by simp [noPrc] at h

theorem stepP_prcOK (K : ℕ) {I : List Sym} {iprog : Fin 5 → IStmt HS 5}
    (h2 : iprog 2 = (difBody 2).ren ssH id) (h3 : iprog 3 = (ditBody 3).ren ssH id)
    (h4 : iprog 4 = Top.blenProc) : RM.PrcOK I iprog Top.pcH (stepP K) := by
  have hb := Top.blenRM_prcOK (I := I) h4 Top.pcH (by decide)
  have hf := FW.prcOK_fwP (I := I) (iprog := iprog) Top.pcH h2 h3
  have hc : RM.PrcOK I iprog Top.pcH (RM.seqL FWW.coreL) := by
    simp only [FWW.coreL, RM.seqL, RM.PrcOK]
    exact ⟨prcOK_of_noPrc _ _ (by decide), prcOK_of_noPrc _ _ (by decide), hf,
      prcOK_of_noPrc _ _ (by decide), prcOK_of_noPrc _ _ (by decide)⟩
  have hw : RM.PrcOK I iprog Top.pcH FWW.fwWrap :=
    ⟨prcOK_of_noPrc _ _ (by decide), hc, prcOK_of_noPrc _ _ (by decide)⟩
  have hx : RM.PrcOK I iprog Top.pcH exCore := by
    simp only [exCore, RM.seqL, RM.PrcOK]
    refine ⟨?_, ?_⟩ <;> (try simp only [RM.PrcOK, and_true, true_and, hw]) <;> (repeat' constructor)
  simp only [stepP, fetchP, nbP, parPh, keyPh, chirpPh, crtPh, midP, midCore, innerP, envP, tailP, popPar,
    RM.seqL, RM.PrcOK, hb, hx, and_true, true_and]
  refine ⟨?_, ?_⟩ <;> (repeat' constructor)

theorem calls_sum (K N : ℕ) (Φ : ℕ → ℕ) : ((calls K N).map fun q => q.1 * Φ q.2).sum =
    cntF K N * Φ ((mkParams K N).fn + 1) + cntM K N * Φ (mmK K N) := by
  unfold calls
  rw [List.map_cons, List.map_cons, List.map_nil, List.sum_cons, List.sum_cons, List.sum_nil, add_zero]

theorem M0_bnd (m : ℕ) : MulBnd M0 m 0 := fun _ _ _ _ => ⟨trivial, le_rfl⟩

