    pointerEnergy i s ≤ i.n * scaleCount i := by
  calc
    pointerEnergy i s ≤ ∑ _v : Fin i.n, scaleCount i := Finset.sum_le_sum (fun v _ => (hs v).1)
    _ = _ := by simp
lemma pointer_energy_increase (i : Input) (s : AdapterState i) (j : Fin (scaleCount i))
    (v : Fin i.n) (value : ℝ≥0∞) :
    pointerEnergy i s ≤ pointerEnergy i (adapterWrite i s j v value) :=
  Finset.sum_le_sum (fun u _ => adapterWrite_pointer_mono i s j v value u)
lemma pointer_local_charge (i : Input) (s : AdapterState i) (j : Fin (scaleCount i))
    (v : Fin i.n) (value : ℝ≥0∞) :
    (adapterWrite i s j v value).pointer v - s.pointer v ≤
      pointerEnergy i (adapterWrite i s j v value) - pointerEnergy i s := by
  classical
  unfold pointerEnergy
  rw [← Finset.sum_tsub_distrib Finset.univ (fun u _ => adapterWrite_pointer_mono i s j v value u)]
  exact Finset.single_le_sum (fun u _ => Nat.zero_le ((adapterWrite i s j v value).pointer u - s.pointer u)) (Finset.mem_univ v)
lemma adapterTrace_pointer_valid (i : Input) (s : AdapterState i) (events : List (AdapterEvent i))
    (hs : ∀ v, PointerValid i s.maxima v (s.pointer v)) :
    ∀ v, PointerValid i (adapterTrace i s events).maxima v ((adapterTrace i s events).pointer v) := by
  induction events generalizing s with
  | nil => exact hs
  | cons event events ih =>
    rcases event with ⟨j,v,value⟩
    exact ih _ (adapterWrite_pointer_valid i s hs j v value)
lemma pointer_travel_energy (i : Input) (s : AdapterState i) (events : List (AdapterEvent i)) :
    pointerTravel i s events + pointerEnergy i s ≤ pointerEnergy i (adapterTrace i s events) := by
  induction events generalizing s with
  | nil => simp only [pointerTravel, adapterTrace, Nat.zero_add, le_refl]
  | cons event events ih =>
    rcases event with ⟨j,v,value⟩
    have hc := pointer_local_charge i s j v value
    have hm := pointer_energy_increase i s j v value
    have ht := ih (adapterWrite i s j v value)
    simp only [pointerTravel, adapterTrace]
    omega
lemma pointer_travel_bound (i : Input) (s : AdapterState i) (events : List (AdapterEvent i))
    (hs : ∀ v, PointerValid i s.maxima v (s.pointer v)) :
    pointerTravel i s events ≤ i.n * scaleCount i := by
  have ht := pointer_travel_energy i s events
  have hb := pointer_energy_bound i (adapterTrace i s events) (adapterTrace_pointer_valid i s events hs)
  omega
