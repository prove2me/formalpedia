-- title:
--   §2 — information skeletons, coordination profiles, cost and the three inefficiencies
-- statement:
--   Let $N=\{1,\dots,n\}$ be a set of players and $K=\{1,\dots,k\}$ a set of information sources. An **information skeleton** $\mathfrak S=(N,K,B)$ assigns to each player $i$ a nonempty set $B(i)\subseteq K$ of available sources.
--
--   A **coordination profile adapted to** $\mathfrak S$ is a family $\pi=(X_i,Z_j)_{i\in N,j\in K}$ of random variables on a probability space $(\Omega,\mathcal F,P)$ such that:
--
--   1. the sources $(Z_j)_{j\in K}$ are mutually independent and take values in arbitrary measurable spaces;
--   2. each $X_i$ is real valued and measurable with respect to the σ-algebra generated by $(Z_j)_{j\in B(i)}$;
--   3. $\mathbb E[X_i]=0$ and $\mathbb E[X_i^2]=1$.
--
--   The profile is **binary** if every $X_i$ takes values in $\{+1,-1\}$, and a binary profile is a **leader profile** if $\operatorname{Cov}(X_i,X_j)\in\{0,1\}$ for all $i,j\in N$.
--
--   For a finite simple graph $G=(N,E)$, the **discoordination cost** of $\pi$ is
--
--   $$C(G,\pi)=\frac1{|E|}\sum_{ij\in E}\bigl(1-\operatorname{Cov}(X_i,X_j)\bigr),$$
--
--   each undirected edge being counted once. The **inefficiency** $I(G,\mathfrak S)$, the **binary inefficiency** $I_{\mathrm{bin}}(G,\mathfrak S)$ and the **leader inefficiency** $I_{\mathrm{leader}}(G,\mathfrak S)$ are the infima of $C(G,\pi)$ over adapted, binary and leader profiles respectively.
--
--   The module also defines the binary entropy function in bits,
--
--   $$h(p)=-p\log_2p-(1-p)\log_2(1-p),\qquad 0\log0=0,$$
--
--   and, for a source assignment $L:N\to K$, the proportion of edges $ij\in E$ with $L(i)\ne L(j)$.
--
--   These definitions are the model of the paper; the goal theorem compares the last two infima.
--
--   **Formalization Note** A profile is a bundled structure whose probability space and value spaces lie in `Type`. The hypothesis $\mathbb E[X_i^2]=1$ forces $X_i\in L^2$, since a non-integrable square would have Lean integral $0$, so $\mathbb E[X_i]$ and the covariances are genuine. For an edgeless graph, Lean's $x/0=0$ gives cost $0$. `h` is Mathlib's `Real.binEntropy` (nats) divided by $\log 2$.
-- source:
--   Peretz and Kraizberg, Entropy Bounds for Local Coordination and Graph Amenability, STOC 2027 submission #272, §2, pp. 5–6 (skeleton, profiles, cost, inefficiencies); Theorem 3.2 and footnote 3, p. 7 (binary entropy function); proof of Theorem 3.2, p. 12 (source assignment).

import Mathlib

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

namespace EntropyLocalCoord.Leader

/-- An information skeleton `𝔖 = (N, K, B)` with `N = Fin n`, `K = Fin k`: every player `i` has
access to a nonempty set `B i` of sources (Peretz--Kraizberg, §2, p. 5). -/
structure InformationSkeleton (n k : ℕ) where
  /-- The sources available to each player. -/
  B : Fin n → Finset (Fin k)
  /-- The source requires `∅ ≠ B(i)`. -/
  nonempty : ∀ i, (B i).Nonempty

/-- The σ-algebra generated by the sources `(Z j)_{j ∈ T}`; for `T = ∅` it is the trivial one. -/
abbrev sourceSigma {Ω : Type*} {k : ℕ} {α : Fin k → Type*} [∀ j, MeasurableSpace (α j)]
    (Z : ∀ j, Ω → α j) (T : Finset (Fin k)) : MeasurableSpace Ω :=
  ⨆ j ∈ T, MeasurableSpace.comap (Z j) inferInstance

/-- A coordination profile `π = (X_i, Z_j)` adapted to `𝔖` (§2, p. 5): mutually independent
sources `Z_j` with arbitrary measurable codomains on an arbitrary probability space, and real
outputs `X_i` measurable with respect to `(Z_j)_{j ∈ B(i)}` with `E[X_i] = 0` and
`E[X_i²] = 1`. -/
structure CoordinationProfile {n k : ℕ} (S : InformationSkeleton n k) where
  /-- The sample space. -/
  Ω : Type
  /-- Its σ-algebra. -/
  [mΩ : MeasurableSpace Ω]
  /-- The probability measure. -/
  P : Measure Ω
  [isProb : IsProbabilityMeasure P]
  /-- The value space of each source. -/
  α : Fin k → Type
  /-- The σ-algebra of each value space. -/
  [mα : ∀ j, MeasurableSpace (α j)]
  /-- The sources. -/
  Z : ∀ j, Ω → α j
  Z_measurable : ∀ j, Measurable (Z j)
  Z_indep : iIndepFun Z P
  /-- The outputs of the players. -/
  X : Fin n → Ω → ℝ
  X_measurable : ∀ i, Measurable[sourceSigma Z (S.B i)] (X i)
  mean_zero : ∀ i, ∫ ω, X i ω ∂P = 0
  second_moment : ∀ i, ∫ ω, X i ω ^ 2 ∂P = 1

attribute [instance] CoordinationProfile.mΩ CoordinationProfile.isProb CoordinationProfile.mα

namespace CoordinationProfile

variable {n k : ℕ} {S : InformationSkeleton n k}

/-- `Cov(X_i, X_j)`. -/
noncomputable def cov (π : CoordinationProfile S) (i j : Fin n) : ℝ :=
  covariance (π.X i) (π.X j) π.P

/-- A profile is binary if each `X_i` takes values in `{+1, -1}`. -/
def IsBinary (π : CoordinationProfile S) : Prop :=
  ∀ i ω, π.X i ω = 1 ∨ π.X i ω = -1

/-- A leader profile: a binary profile with `Cov(X_i, X_j) ∈ {0, 1}` for all `i, j ∈ N`. -/
def IsLeader (π : CoordinationProfile S) : Prop :=
  π.IsBinary ∧ ∀ i j, π.cov i j = 0 ∨ π.cov i j = 1

/-- The term `1 - Cov(X_i, X_j)` of the cost, as a function of the unordered pair `{i, j}`. -/
noncomputable def edgeLoss (π : CoordinationProfile S) : Sym2 (Fin n) → ℝ :=
  Sym2.lift ⟨fun i j => 1 - π.cov i j, fun i j => by
    simp only [cov]
    rw [covariance_comm]⟩

end CoordinationProfile

open scoped Classical in
/-- The discoordination cost `C(G, π) = (1/|E|) ∑_{ij ∈ E} (1 - Cov(X_i, X_j))`, each undirected
edge counted once. With no edges Lean's `x / 0 = 0` gives the value `0`. -/
noncomputable def cost {n k : ℕ} {S : InformationSkeleton n k} (G : SimpleGraph (Fin n))
    (π : CoordinationProfile S) : ℝ :=
  (∑ e ∈ G.edgeFinset, π.edgeLoss e) / (G.edgeFinset.card : ℝ)

/-- The inefficiency `I(G, 𝔖)`: the infimum of the cost over profiles adapted to `𝔖`. -/
noncomputable def Ineff {n k : ℕ} (G : SimpleGraph (Fin n)) (S : InformationSkeleton n k) : ℝ :=
  sInf {c | ∃ π : CoordinationProfile S, cost G π = c}

/-- The binary inefficiency `I_bin(G, 𝔖)`: the infimum over binary profiles. -/
noncomputable def Ibin {n k : ℕ} (G : SimpleGraph (Fin n)) (S : InformationSkeleton n k) : ℝ :=
  sInf {c | ∃ π : CoordinationProfile S, π.IsBinary ∧ cost G π = c}

/-- The leader inefficiency `I_leader(G, 𝔖)`: the infimum over leader profiles. -/
noncomputable def Ileader {n k : ℕ} (G : SimpleGraph (Fin n)) (S : InformationSkeleton n k) : ℝ :=
  sInf {c | ∃ π : CoordinationProfile S, π.IsLeader ∧ cost G π = c}

/-- The binary entropy function in bits, `h(p) = -p log₂ p - (1 - p) log₂ (1 - p)` with
`0 log 0 = 0`. Mathlib's `Real.binEntropy` is in nats. -/
noncomputable def h (p : ℝ) : ℝ := Real.binEntropy p / Real.log 2

open scoped Classical in
/-- The proportion of edges whose endpoints follow different sources under the source assignment
`L`. With no edges Lean's `x / 0 = 0` gives the value `0`. -/
noncomputable def cutFraction {n k : ℕ} (G : SimpleGraph (Fin n)) (L : Fin n → Fin k) : ℝ :=
  ((G.edgeFinset.filter (fun e => ∃ i j, e = s(i, j) ∧ L i ≠ L j)).card : ℝ) /
    (G.edgeFinset.card : ℝ)

end EntropyLocalCoord.Leader


