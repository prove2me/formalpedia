open CategoryTheory GoodReductionJacobian

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {B : Type} [CommRing B]

section PtGroup
variable (E : FakeEllipticCurve Λ N B) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))

abbrev Pt := SchemeHomOver t E.f

noncomputable scoped instance : Add (Pt E t) := ⟨fun P Q => E.L.mul t P Q⟩
noncomputable scoped instance : Zero (Pt E t) := ⟨E.L.one t⟩
noncomputable scoped instance : Neg (Pt E t) := ⟨fun P => E.L.inv t P⟩
noncomputable scoped instance ptGroup : AddCommGroup (Pt E t) where
  add := (· + ·)
  zero := 0
  neg := Neg.neg
  nsmul := nsmulRec
  zsmul := zsmulRec
  add_assoc := E.L.mul_assoc t
  zero_add := E.L.one_mul t
  add_zero := E.L.mul_one t
  neg_add_cancel := E.L.inv_mul_cancel t
  add_comm P Q := E.comm t P Q

theorem add_def (P Q : Pt E t) : P + Q = E.L.mul t P Q := rfl
theorem zero_def : (0 : Pt E t) = E.L.one t := rfl

theorem nsmul_eq_smul (n : ℕ) (P : Pt E t) : E.L.nsmul t n P = n • P := by
  induction n with
  | zero => rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, ih, succ_nsmul]; rfl

theorem nsmulPt_eq_smul (n : ℕ) (P : Pt E t) : nsmulPt E.L t n P = n • P := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show E.L.mul t (nsmulPt E.L t n P) P = (n + 1) • P
    rw [ih, succ_nsmul]; rfl

theorem nsmulPt_eq_nsmul (n : ℕ) (P : Pt E t) : nsmulPt E.L t n P = E.L.nsmul t n P := by
  rw [nsmulPt_eq_smul, nsmul_eq_smul]

end PtGroup

theorem schemeNsmul_pt (E : FakeEllipticCurve Λ N B) (n : ℕ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    (P : SchemeHomOver t E.f) (h : (P.1 ≫ E.L.schemeNsmul n) ≫ E.f = t) :
    (⟨P.1 ≫ E.L.schemeNsmul n, h⟩ : SchemeHomOver t E.f) = E.L.nsmul t n P := by
  have key := E.L.nsmul_natural E.f t P.1 P.2 n RelativeGroupLaw.idPoint
  have hid : schemeHomOverComp P.1 P.2 (RelativeGroupLaw.idPoint (f := E.f)) = P := by
    apply Subtype.ext; simp only [schemeHomOverComp_coe]; exact Category.comp_id _
  rw [hid] at key
  rw [← key]
  apply Subtype.ext
  rfl

theorem mapPt_nsmul {E E' : FakeEllipticCurve Λ N B} (φ : E.A ⟶ E'.A) (hφ : φ ≫ E'.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t E.f),
      mapPt φ hφ (E.L.mul t P Q) = E'.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (n : ℕ) (P : SchemeHomOver t E.f) :
    mapPt φ hφ (E.L.nsmul t n P) = E'.L.nsmul t n (mapPt φ hφ P) := by
  have hone : mapPt φ hφ (E.L.one t) = E'.L.one t := by
    have h := hmul t (E.L.one t) (E.L.one t)
    rw [E.L.one_mul] at h

    have h' : (mapPt φ hφ (E.L.one t) : Pt E' t) + mapPt φ hφ (E.L.one t) = mapPt φ hφ (E.L.one t) + 0 := by
      rw [add_zero]; exact h.symm
    exact add_left_cancel h'
  induction n with
  | zero => exact hone
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hmul, ih]

theorem nsmul_mul (E : FakeEllipticCurve Λ N B) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (n : ℕ)
    (P Q : SchemeHomOver t E.f) :
    E.L.nsmul t n (E.L.mul t P Q) = E.L.mul t (E.L.nsmul t n P) (E.L.nsmul t n Q) := by
  rw [nsmul_eq_smul, nsmul_eq_smul, nsmul_eq_smul]
  exact smul_add n P Q

theorem mapPt_schemeNsmul (E : FakeEllipticCurve Λ N B) (n : ℕ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    (P : SchemeHomOver t E.f) :
    mapPt (E.L.schemeNsmul n) (E.L.schemeNsmul_over n) P = E.L.nsmul t n P :=
  schemeNsmul_pt E n t P _

theorem schemeNsmul_props (E : FakeEllipticCurve Λ N B) (n : ℕ) (hn : 0 < n) :
    IsFinite (E.L.schemeNsmul n) ∧ Flat (E.L.schemeNsmul n) ∧ LocallyOfFinitePresentation (E.L.schemeNsmul n) ∧
      Surjective (E.L.schemeNsmul n) := by
  refine CerednikDrinfeld.QM.FakeEllipticCurve.isFinite_flat_surjective_of_mapPt_mapPt_eq_nsmulPt E E
    (E.L.schemeNsmul n) (E.L.schemeNsmul_over n) ?_ (𝟙 E.A) (Category.id_comp _) n hn ?_ ?_
  · intro T t P Q
    rw [mapPt_schemeNsmul, mapPt_schemeNsmul, mapPt_schemeNsmul]
    exact nsmul_mul E t n P Q
  · intro T t P
    rw [mapPt_schemeNsmul, nsmulPt_eq_nsmul]
    apply Subtype.ext; simp only [mapPt_coe, Category.comp_id]
  · intro T t Q
    have : mapPt (𝟙 E.A) (Category.id_comp _) Q = Q := by apply Subtype.ext; simp only [mapPt_coe, Category.comp_id]
    rw [this, mapPt_schemeNsmul, nsmulPt_eq_nsmul]

theorem schemeNsmul_comm {E E' : FakeEllipticCurve Λ N B} (φ : E.A ⟶ E'.A) (hφ : φ ≫ E'.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t E.f),
      mapPt φ hφ (E.L.mul t P Q) = E'.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q)) (n : ℕ) :
    E.L.schemeNsmul n ≫ φ = φ ≫ E'.L.schemeNsmul n := by
  have h1 := mapPt_nsmul φ hφ hmul E.f n RelativeGroupLaw.idPoint
  have h2 := congrArg Subtype.val h1
  rw [← schemeNsmul_pt E' n E.f (mapPt φ hφ RelativeGroupLaw.idPoint)
    (by rw [Category.assoc, E'.L.schemeNsmul_over]; exact (mapPt φ hφ RelativeGroupLaw.idPoint).2)] at h2
  simpa [mapPt_coe, RelativeGroupLaw.schemeNsmul] using h2

end CerednikDrinfeld.QM.HLAux
