section
-- Source module: Solutions.R6FineIdx
/-!
# Fine-bit exposure §1: index lemmas and the stage lists

The data `xs = gflat zs` of shape `S = [a, N, y, 2]` (`N = 2^f`) is moved one bit of the
`N` axis at a time.

* `gF L`: the stage address `[i, h, r, l, c]` of `[a, H, y, L, 2]` (`H L = N`, the `l` axis holds
  the bits already moved behind `y`) reads `[i, h L + l, r, c]` of `S`.
  **`stepF`**: one `mvFU` move (`A = [a, H]`, `F = [2]`, `G = [y]`, `C = [L, 2]`) takes stage
  `(2H, L)` to stage `(H, 2L)`. **`stF_zero`**, **`stF_end`**: the stage `(N, 1)` is `xs`, the
  stage `(1, N)` is `gflat (blkT N y a zs)`.
* `gB L`: the same for `S = [a, y, N, 2]`, the stage `[a, H, y, L, 2]` reading `[i, r, h L + l, c]`.
  **`stepB`** (`mvBU`, `A = [a, H]`, `F = [y]`, `G = [2]`, `C = [L, 2]`): stage `(H, 2L)` to
  stage `(2H, L)`. **`stB_zero`**, **`stB_end`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFUU.R6Fine

open IntMul AModel NLogN.KFB IntMul.Kappa.R6

/-! ## Generic pull facts -/

theorem getD_pull_enc {α : Type*} {S B : Shape} (g : List ℕ → List ℕ) (d : α) (xs : List α)
    {b : List ℕ} (hb : Valid B b) :
    (pull S B g d xs).getD (encode B b) d = xs.getD (encode S (g b)) d := by
  rw [List.getD_eq_getElem _ _ (by simpa using encode_lt hb), getElem_pull, decode_encode hb]

theorem ext_enc {α : Type*} {B : Shape} {X Y : List α} (d : α) (hX : X.length = vol B)
    (hY : Y.length = vol B) (h : ∀ b, Valid B b → X.getD (encode B b) d = Y.getD (encode B b) d) :
    X = Y := by
  apply List.ext_getElem (by rw [hX, hY])
  intro j h1 h2
  have hj : j < vol B := by rwa [hX] at h1
  have := h _ (valid_decode hj)
  rw [encode_decode hj, List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2] at this
  exact this

theorem valid6 {s0 s1 s2 s3 s4 s5 : ℕ} {b : List ℕ} (h : Valid [s0, s1, s2, s3, s4, s5] b) :
    ∃ b0 b1 b2 b3 b4 b5, b = [b0, b1, b2, b3, b4, b5] ∧ b0 < s0 ∧ b1 < s1 ∧ b2 < s2 ∧ b3 < s3 ∧
      b4 < s4 ∧ b5 < s5 := by
  rcases h with _ | ⟨h0, h⟩
  rcases h with _ | ⟨h1, h⟩
  rcases h with _ | ⟨h2, h⟩
  rcases h with _ | ⟨h3, h⟩
  rcases h with _ | ⟨h4, h⟩
  rcases h with _ | ⟨h5, h⟩
  rcases h with _ | _
  exact ⟨_, _, _, _, _, _, rfl, h0, h1, h2, h3, h4, h5⟩

theorem mk5 {s0 s1 s2 s3 s4 b0 b1 b2 b3 b4 : ℕ} (h0 : b0 < s0) (h1 : b1 < s1) (h2 : b2 < s2)
    (h3 : b3 < s3) (h4 : b4 < s4) : Valid [s0, s1, s2, s3, s4] [b0, b1, b2, b3, b4] :=
  .cons h0 (.cons h1 (.cons h2 (.cons h3 (.cons h4 .nil))))

theorem enc5 (s0 s1 s2 s3 s4 b0 b1 b2 b3 b4 : ℕ) :
    encode [s0, s1, s2, s3, s4] [b0, b1, b2, b3, b4] =
      (((b0 * s1 + b1) * s2 + b2) * s3 + b3) * s4 + b4 := by
  simp [encode, vol]; ring

theorem enc6 (s0 s1 s2 s3 s4 s5 b0 b1 b2 b3 b4 b5 : ℕ) :
    encode [s0, s1, s2, s3, s4, s5] [b0, b1, b2, b3, b4, b5] =
      ((((b0 * s1 + b1) * s2 + b2) * s3 + b3) * s4 + b4) * s5 + b5 := by
  simp [encode, vol]; ring

theorem lt_two_mul {β l L : ℕ} (hβ : β < 2) (hl : l < L) : β * L + l < L * 2 := by
  rcases (by omega : β = 0 ∨ β = 1) with rfl | rfl <;> omega

/-! ## The stage maps -/

/-- **One forward move.** -/
theorem stepF (a N y H H2 L L2 : ℕ) (hH : H2 = H * 2) (hL : L2 = L * 2) (xs : List ℤ) :
    pull ([a, H] ++ [2] ++ [y] ++ [L, 2]) ([a, H] ++ [y] ++ [2] ++ [L, 2]) (KIL.swapMid 2 1 1) 0
      (stF a N y H2 L xs) = stF a N y H L2 xs := by
  subst hH hL
  have e1 : [a, H] ++ [2] ++ [y] ++ [L, 2] = [a, H, 2, y, L, 2] := rfl
  have e2 : [a, H] ++ [y] ++ [2] ++ [L, 2] = [a, H, y, 2, L, 2] := rfl
  rw [e1, e2]
  have eo : vol [a, H, y, L * 2, 2] = vol [a, H, y, 2, L, 2] := by
    simp only [vol, List.prod_cons, List.prod_nil]; ring
  have eB := ext_enc (B := [a, H, y, 2, L, 2]) (0 : ℤ)
    (X := pull [a, H, 2, y, L, 2] [a, H, y, 2, L, 2] (KIL.swapMid 2 1 1) 0 (stF a N y (H * 2) L xs))
    (Y := stF a N y H (L * 2) xs) (by simp) (by rw [length_stF, eo])
  apply eB
  intro b hb
  obtain ⟨i, h, r, β, l, c, rfl, hi, hh, hr, hβ, hl, hc⟩ := valid6 hb
  rw [getD_pull_enc _ _ _ hb]
  have esw : KIL.swapMid 2 1 1 [i, h, r, β, l, c] = [i, h, β, r, l, c] := rfl
  rw [esw]
  -- left: the stage `(2H, L)` at `[i, 2h + β, r, l, c]`
  have v1 : Valid [a, H * 2, y, L, 2] [i, h * 2 + β, r, l, c] := mk5 hi (by omega) hr hl hc
  have q1 : encode [a, H, 2, y, L, 2] [i, h, β, r, l, c] =
      encode [a, H * 2, y, L, 2] [i, h * 2 + β, r, l, c] := by rw [enc6, enc5]; ring
  -- right: the stage `(H, 2L)` at `[i, h, r, β L + l, c]`
  have v2 : Valid [a, H, y, L * 2, 2] [i, h, r, β * L + l, c] := mk5 hi hh hr (lt_two_mul hβ hl) hc
  have q2 : encode [a, H, y, 2, L, 2] [i, h, r, β, l, c] =
      encode [a, H, y, L * 2, 2] [i, h, r, β * L + l, c] := by rw [enc6, enc5]; ring
  rw [q1, q2]
  unfold stF
  rw [getD_pull_enc _ _ _ v1, getD_pull_enc _ _ _ v2]
  congr 2
  simp only [gF, List.getD_cons_zero, List.getD_cons_succ]
  congr 1; ring

/-! ## The first stages -/

/-! ## The blockwise transpose -/

