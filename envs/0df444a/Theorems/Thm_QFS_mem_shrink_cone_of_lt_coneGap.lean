variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

lemma QFS.mem_shrink_cone_of_lt_coneGap {v : E} (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ)
    (hϑ' : ϑ ≤ π / 2) {p : E} {ρ : ℝ} (hρ : 0 ≤ ρ) (h : ρ < coneGap v ϑ p) :
    p ∈ shrink (cone v ϑ) ρ := by sorry
