/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D6: one backward record, one forward row

`Rn.bBodyS`: `bBody` at row `r` pushes `(recP r).reverse` onto `41`, adds `flg r` to `22` and
`(recP r).length` to `23`; `Rn.fBodyS`: `fBody` at `r' ` pushes `(rowP (m - 1 - r')).reverse` and adds
its length to `23`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem recP_length (kk m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (r : ℕ) :
    (recP kk m mw cB L Mf r).length = (czP m mw cB L Mf r).length + wbN m mw L r + 5 := by
  simp [recP, cbP]; omega

section bodies
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **One backward record.** -/
theorem Rn.bBodyS_sol_aux {u : Vr} {D : Cs} (hF : Fx Q kk m mw cB u) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W u) {r n22 t : ℕ} (h1 : u 1 = r)
    (hr : r < m) (h22 : u 22 = n22) (h23 : u 23 = t) (hD51 : D 51 = []) (hmW : m + 1 ≤ 2 ^ W)
    (hn22 : n22 + 1 ≤ 2 ^ W) (ht : t + (recP kk m mw cB L Mf r).length ≤ 2 ^ W) :
    Rn bBody u D (fun u' => u' 22 = (n22 : ℤ) + flg cB L r ∧
      u' 23 = ((t + (recP kk m mw cB L Mf r).length : ℕ) : ℤ) ∧
      (∀ i ∉ ([2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update D 41 ((recP kk m mw cB L Mf r).reverse ++ D 41)) (cbB W m) := by
  have hlen := recP_length kk m mw cB L Mf r
  have H1 := Rn.bHeads (kk := kk) hF hS hB hLm hv h1 hr h22 hn22
  refine Rn.seq H1 (fun u1 hu1 => ?_)
  obtain ⟨a4, a22, a3, af, ab⟩ := hu1
  set D1 := update D 41 (Mf r r :: 2 ^ kk / (2 * Mf r r) :: flg cB L r :: D 41) with hD1
  have F1 : Fx Q kk m mw cB u1 := hF.frm af (by decide)
  have S1 : StS m L Mf D1 := hS.upd (by decide) _
  have a1 : u1 1 = r := by rw [af 1 (by decide), h1]
  have H2 := Rn.czL F1 S1 hB hLm ab a1 hr a4 a3 (by simp [hD1, hD51]) hmW
  refine Rn.seq H2 (fun u2 hu2 => ?_)
  obtain ⟨b3, bf, bb⟩ := hu2
  set n := (czP m mw cB L Mf r).length with hn
  set D2 := update D1 41 ((czP m mw cB L Mf r).reverse ++ D1 41) with hD2
  have b23 : u2 23 = t := by rw [bf 23 (by decide), af 23 (by decide), h23]
  have H3 := Rn.bMids (c := D2) hB bb b3 b23 (by omega)
  refine Rn.seq H3 (fun u3 hu3 => ?_)
  obtain ⟨c23, c3, cf, cb⟩ := hu3
  set D3 := update D2 41 ((n : ℤ) :: D2 41) with hD3
  have fr3 := frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 22, 23, 29])
    (frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 22, 23, 29]) af bf (by decide) (by decide)) cf
    (by decide) (by decide)
  have F3 : Fx Q kk m mw cB u3 := hF.frm fr3 (by decide)
  have S3 : StS m L Mf D3 := ((S1.upd (by decide) _).upd (by decide) _)
  have c1 : u3 1 = r := by rw [fr3 1 (by decide), h1]
  have c4 : u3 4 = Lg L r := by rw [cf 4 (by decide), bf 4 (by decide), a4]
  have H4 := Rn.wbL F3 S3 hB hLm cb c1 c4 c3 (by simp [hD3, hD2, hD1, hD51]) hmW
  refine Rn.seq H4 (fun u4 hu4 => ?_)
  obtain ⟨d3, df, db⟩ := hu4
  have fr4 := frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 22, 23, 29]) fr3 df (by decide) (by decide)
  have F4 : Fx Q kk m mw cB u4 := hF.frm fr4 (by decide)
  have d1 : u4 1 = r := by rw [fr4 1 (by decide), h1]
  have d4 : u4 4 = Lg L r := by rw [df 4 (by decide), c4]
  have H5 := Rn.cbL F4 S3 hB hLm db d1 hr d4 d3 (by simp [hD3, hD2, hD1, hD51]) hmW
  have hwl : wbN m mw L r ≤ m := (wbN_le m mw L r).trans (by omega)
  refine Rn.seq (H5.mono (fun x hx => hx) (cFor_mono (cb := costL W (m * m + m) cbI) hwl))
    (fun u5 hu5 => ?_)
  obtain ⟨ef, eb⟩ := hu5
  set D5 := update D3 41 ((cbP m mw cB L Mf r).reverse ++ D3 41) with hD5
  have e3 : u5 3 = wbN m mw L r := by rw [ef 3 (by decide), d3]
  have e23 : u5 23 = ((t + n + 4 : ℕ) : ℤ) := by rw [ef 23 (by decide), df 23 (by decide), c23]
  have H6 := Rn.bTails (c := D5) (m := m) (L := L) (Mf := Mf) hB eb e3 e23 (by omega)
  have hst : update D5 41 (((wbN m mw L r : ℕ) : ℤ) :: D5 41) =
      update D 41 ((recP kk m mw cB L Mf r).reverse ++ D 41) := by
    simp only [hD5, hD3, hD2, hD1, hn, update_idem, update_self, recP, List.reverse_append,
      List.reverse_cons, List.reverse_nil, List.nil_append, List.append_assoc, List.cons_append,
      List.singleton_append]
  refine (H6.mono (fun u' hu' => ?_) le_rfl).congr hst
  obtain ⟨g23, gf, gb⟩ := hu'
  refine ⟨?_, ?_, ?_, gb⟩
  · rw [gf 22 (by decide), ef 22 (by decide), df 22 (by decide), cf 22 (by decide),
      bf 22 (by decide), a22]
  · rw [g23, hlen]; push_cast; ring
  · exact frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 22, 23, 29])
      (frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 22, 23, 29]) fr4 ef (by decide) (by decide)) gf
      (by decide) (by decide)

end bodies

