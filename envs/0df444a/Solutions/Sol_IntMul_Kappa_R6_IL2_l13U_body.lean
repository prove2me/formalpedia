/-- **Lemma 13 for the fixed register-driven code `l13U l12`** (`Lem13Body` with the parameters in
the master registers `σMR`). -/
theorem l13U_body_sol_aux (hτ : 0 ≤ τ) (hL : L12Canon tab l12 τ) :
    ∃ Kc : ℝ, 0 < Kc ∧
    ∀ {I : List Sym} (N0 N1 N2 N3 K f ρ R w : ℕ) (px py : Fin 3), px ≠ py → 6 ≤ K → ρ < K →
      1 ≤ f → 1 ≤ N0 → 1 ≤ N1 → 1 ≤ N2 → 1 ≤ N3 → 1 ≤ R →
      ∀ (t : IState HS) (zs : List GI) (R0 : List Item),
      Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t →
      t.G 0 = ints (gflat zs) ++ R0 → zs.length = vol (rect N0 N1 N2 N3 (f * K)) * R → GB w zs →
      ∃ c, IRuns I tab (l13U l12) t
          (t.upd 0 (ints (gflat (permRecs (rect N0 N1 N2 N3 (f * K))
            (rowAddAddr K ρ f px py) R zs)) ++ R0)) c ∧
        (c : ℝ) ≤ Kc * ((zs.length : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ τ + 1) +
          (vol (rect N0 N1 N2 N3 (f * K)) : ℝ) * ((zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) ^ 3 +
          min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (vol (rect N0 N1 N2 N3 (f * K)) : ℝ) *
            ((zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) * ((R : ℝ) * (w + 1) +
              (zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1)) := by
  obtain ⟨Ksw, hKsw, HSw⟩ := swE_geo hτ hL
  obtain ⟨Kcr, hKcr, HC⟩ := corrU_spec
  refine ⟨10 ^ 19 + 12 * Ksw + 19200 * Ksw + 2000 * Kcr, by positivity, ?_⟩
  intro I N0 N1 N2 N3 K f ρ R w px py hne hK hρK hf h0 h1 h2 h3 hR t zs R0 hA hg0 hl hGB
  have hp : PPos N0 N1 N2 N3 K f ρ R := ⟨h0, h1, h2, h3, hR, by omega, hf, hρK⟩
  obtain ⟨c, Hc, hc⟩ := l13U_runs (l12 := l12) hKsw hKcr.le HSw HC hne hK hp I t hA zs R0 hg0 hl hGB
  refine ⟨c, Hc, ?_⟩
  set gm := gB N0 N1 N2 N3 K f R w with hgm
  have hg : gm.Pos := hp.geo
  have hQe : gm.Q = 2 ^ (f * K) := rfl
  have hMr : gm.recG.V = vol (rect N0 N1 N2 N3 (f * K)) := (vol_rect (R := R) (w := w)).symm
  have hVn : gm.V = 2 * zs.length * (w + 1) := by rw [hgm, gB, geoB_V, hl]; ring
  have hVz : ((gm.V : ℕ) : ℤ) = (2 * zs.length * (w + 1) : ℤ) := by rw [hVn]; push_cast; ring
  have hcore := coreCost_le (τ := τ) hK hρK hf gm hg hQe Ksw Kcr
  rw [hMr, hVz] at hcore
  have hVr : (gm.V : ℝ) = 2 * (zs.length : ℝ) * (w + 1) := by rw [hVn]; push_cast; ring
  have hBr : (gm.B : ℝ) = 2 * (R : ℝ) * (w + 1) := by simp only [gm, gB, geoB]; push_cast; ring
  rw [hVr, hBr] at hcore
  rw [add_assoc (2 * (R : ℝ) * (w + 1))] at hcore
  rw [hVr, hVz] at hc
  have hMpos : 0 < vol (rect N0 N1 N2 N3 (f * K)) := hMr ▸ hg.recG.v
  have hn1 : (1 : ℝ) ≤ (zs.length : ℝ) := by
    have : 1 ≤ zs.length := by rw [hl]; exact Nat.mul_pos hMpos hR
    exact_mod_cast this
  have hnMR : vol (rect N0 N1 N2 N3 (f * K)) * R = zs.length := hl.symm
  have hTo := cTo_le (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w
  have hFr := cFrom_le (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w
  rw [hnMR] at hTo hFr hc
  have hcast : ∀ x : ℕ, x ≤ 10 ^ 4 * ((2 * zs.length + 1) * (w + 1)) →
      (x : ℝ) ≤ 3 * 10 ^ 4 * ((zs.length : ℝ) * (w + 1)) := by
    intro x hx
    have := (Nat.cast_le (α := ℝ)).2 hx
    push_cast at this
    have hw : (0 : ℝ) ≤ w := Nat.cast_nonneg _
    nlinarith
  have hδ : 0 ≤ min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) := le_min (by norm_num) (by
    have : (1 : ℝ) ≤ f := by exact_mod_cast hf
    have : (0 : ℝ) ≤ 2⁻¹ ^ K := by positivity
    nlinarith)
  have hM1 : (1 : ℝ) ≤ (vol (rect N0 N1 N2 N3 (f * K)) : ℝ) := by exact_mod_cast hMpos
  have hc' : (c : ℝ) ≤ 2000 * (cTo (2 * zs.length) w : ℝ) +
      4 * (26 + Ksw * (2 * (zs.length : ℝ) * (w + 1) + 1) * ((f * K : ℕ) : ℝ) ^ τ) +
      (400 * coreCost τ Ksw Kcr K ρ f gm +
        10 ^ 10 * (((zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) + 4) ^ 2) +
      2000 * (cFrom (2 * zs.length) w : ℝ) := by
    refine hc.trans (le_of_eq ?_)
    push_cast; ring
  have F := l13U_arith (X := (zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) hn1 (Nat.cast_nonneg _)
    hM1 (Nat.cast_nonneg _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    (by linarith [(Nat.cast_nonneg _ : (0 : ℝ) ≤ (zsz (2 * zs.length * (w + 1) : ℤ) : ℝ))])
    hδ hKsw hKsw hKcr.le hc' hcore (hcast _ hTo) (hcast _ hFr)
  rw [← add_assoc ((R : ℝ) * (w + 1))] at F
  exact F
end IntMul.Kappa.R6.IL2

