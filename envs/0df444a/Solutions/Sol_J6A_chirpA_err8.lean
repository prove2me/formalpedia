      _ = 6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ) := by ring
  have hwin : ‖Y - ∑ j ∈ Wn, 2 ^ p * g j‖ ≤ 2 * W * (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ)) := by
    rw [hY, ← Finset.sum_sub_distrib]
    refine (norm_sum_le _ _).trans ?_
    calc ∑ j ∈ Wn, ‖((wt j : ℝ) : ℂ) * toC (U (j % s).toNat) / (D : ℂ) - 2 ^ p * g j‖
        ≤ ∑ _j ∈ Wn, (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ) : ℝ) :=
          Finset.sum_le_sum fun j _ => hterm j
      _ = 2 * W * (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ)) := by
          rw [Finset.sum_const, hWn, Finset.card_map, Finset.card_range, nsmul_eq_mul]; push_cast; ring
  -- tail part (as in `Sapprox_bound`)
  set r : ℝ := Real.exp (-(Real.pi * m / (2 * α ^ 2))) with hr
  have hr0 : 0 ≤ r := (Real.exp_pos _).le
  have hrq : r ≤ 1 / 4.3 := by
    refine le_trans (Real.exp_le_exp.2 ?_) exp_neg_pi_half_le
    have hmR : (m : ℝ) = q * α := by simp [hmdef, sWidth, q]
    have hqR : (α : ℝ) ≤ q := by exact_mod_cast hq
    rw [hmR, show Real.pi * (q * α : ℝ) / (2 * α ^ 2) = Real.pi / 2 * (q / α) by field_simp]
    have : (1 : ℝ) ≤ q / α := by rw [le_div_iff₀ hα0]; linarith
    nlinarith [Real.pi_pos]
  have hr1 : r < 1 := by linarith
  set h : ℤ → ℝ := fun j => (2 * α : ℝ)⁻¹ * (r ^ (m - 1) * r ^ (j - c).natAbs) * 2 ^ ex with hh
  have hhas : HasSum h ((2 * α : ℝ)⁻¹ * (r ^ (m - 1) * ((1 + r) / (1 - r))) * 2 ^ ex) := by
    have h0 := hasSum_geom_int hr0 hr1
    have h1 : HasSum (fun j : ℤ => r ^ (j - c).natAbs) ((1 + r) / (1 - r)) := by
      rw [← (Equiv.subRight c).hasSum_iff] at h0
      · exact h0
    exact ((h1.mul_left (r ^ (m - 1))).mul_left _).mul_right _
  have htail : ‖∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x‖ ≤
      (2 * α : ℝ)⁻¹ * (r ^ (m - 1) * ((1 + r) / (1 - r))) * 2 ^ ex := by
    rw [tsum_subtype (↑Wn : Set ℤ)ᶜ g]
    refine tsum_of_norm_bounded hhas (fun j => ?_)
    by_cases hj : j ∈ (↑Wn : Set ℤ)ᶜ
    · rw [Set.indicator_of_mem hj]
      have hjW : j ∉ Wn := by simpa using hj
      have hb := ew_tail s t α k m (by omega) hm1 c hc1 hc2 j (hWmem j hjW)
      simp only [hg, hh]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by unfold ew; positivity)]
      calc (2 * α : ℝ)⁻¹ * ew s t α k j * ‖u (j % s).toNat‖ ≤ (2 * α : ℝ)⁻¹ * ew s t α k j * 2 ^ ex :=
            mul_le_mul_of_nonneg_left (hu _) (by unfold ew; positivity)
        _ ≤ (2 * α : ℝ)⁻¹ * (r ^ (m - 1) * r ^ (j - c).natAbs) * 2 ^ ex := by
            exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hb (by positivity)) (by positivity)
    · rw [Set.indicator_of_notMem hj, norm_zero]; simp only [hh]; positivity
  have hrm : (2 : ℝ) ^ p * 2 ^ ex * r ^ (m - 1) ≤ 1 := by
    have e1 : r ^ (m - 1) = Real.exp (((m - 1 : ℕ) : ℝ) * (-(Real.pi * m / (2 * α ^ 2)))) := by
      rw [Real.exp_nat_mul]
    have e2 : (2 : ℝ) ^ p * 2 ^ ex = Real.exp (((p + ex : ℕ) : ℝ) * Real.log 2) := by
      rw [Real.exp_nat_mul, Real.exp_log two_pos, pow_add]
    rw [e1, e2, ← Real.exp_add, Real.exp_le_one_iff]
    have hmR : (m : ℝ) = q * α := by simp [hmdef, sWidth, q]
    have hm1R : ((m - 1 : ℕ) : ℝ) = q * α - 1 := by rw [Nat.cast_sub hm1, hmR]; simp
    rw [hm1R, hmR]
    have hqR : (α : ℝ) ≤ q := by exact_mod_cast hq
    have hqpR : (p : ℝ) ≤ q * q := by exact_mod_cast hqp
    have hl := Real.log_two_lt_d9
    have hpi := Real.pi_gt_d2
    have key : (q * α - 1) * (Real.pi * (q * α) / (2 * α ^ 2)) = Real.pi / 2 * (q * q - q / α) := by
      field_simp
    have hqa : (q : ℝ) / α ≤ q / 2 := by
      apply div_le_div_of_nonneg_left (by positivity) (by norm_num) hαR
    have hq1 : (1 : ℝ) ≤ q := by linarith
    have hp0 : (0 : ℝ) ≤ p := Nat.cast_nonneg p
    have h1 : (p : ℝ) / 2 ≤ q * q - q / α := by nlinarith
    have h2 : Real.pi / 2 * ((p : ℝ) / 2) ≤ Real.pi / 2 * (q * q - q / α) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    have h3 : 3.14 * (p : ℝ) ≤ Real.pi * p := mul_le_mul_of_nonneg_right hpi.le hp0
    have heR : (8 : ℝ) * ex ≤ p := by exact_mod_cast he
    have : ((p + ex : ℕ) : ℝ) * 0.6931471808 ≤ Real.pi / 2 * (q * q - q / α) := by
      push_cast; nlinarith
    have hneg : ((q : ℝ) * α - 1) * (-(Real.pi * (q * α) / (2 * α ^ 2))) =
        -(Real.pi / 2 * (q * q - q / α)) := by rw [← key]; ring
    rw [hneg]
    have := mul_le_mul_of_nonneg_left hl.le (Nat.cast_nonneg (p + ex) : (0 : ℝ) ≤ ((p + ex : ℕ) : ℝ))
    linarith
  have hgeo : (1 + r) / (1 - r) ≤ 2 := by rw [div_le_iff₀ (by linarith)]; linarith
  have hα4 : (2 * α : ℝ)⁻¹ ≤ 1 / 4 := by
    rw [inv_le_comm₀ (by positivity) (by norm_num)]; linarith
  have htail2 : ‖(2 : ℂ) ^ p * ∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x‖ ≤ 1 / 2 := by
    rw [norm_mul, norm_pow, Complex.norm_two]
    calc (2 : ℝ) ^ p * ‖∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x‖
        ≤ 2 ^ p * ((2 * α : ℝ)⁻¹ * (r ^ (m - 1) * ((1 + r) / (1 - r))) * 2 ^ ex) :=
          mul_le_mul_of_nonneg_left htail hp.le
      _ = (2 * α : ℝ)⁻¹ * ((2 ^ p * 2 ^ ex * r ^ (m - 1)) * ((1 + r) / (1 - r))) := by ring
      _ ≤ 1 / 4 * (1 * 2) := by
          apply mul_le_mul hα4 _ (by positivity) (by norm_num)
          exact mul_le_mul hrm hgeo (by positivity) (by norm_num)
      _ = 1 / 2 := by norm_num
  -- assemble
  rw [hgS, ← hgsum.sum_add_tsum_compl (s := Wn), mul_add, Finset.mul_sum]
  have e : toC (chirpA P σ W s t α H U k) - (∑ j ∈ Wn, 2 ^ p * g j + 2 ^ p * ∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x)
      = (toC (chirpA P σ W s t α H U k) - Y) + (Y - ∑ j ∈ Wn, 2 ^ p * g j) -
        2 ^ p * ∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x := by ring
  rw [e]
  calc _ ≤ ‖(toC (chirpA P σ W s t α H U k) - Y) + (Y - ∑ j ∈ Wn, 2 ^ p * g j)‖ +
        ‖(2 : ℂ) ^ p * ∑' x : ↑(↑Wn : Set ℤ)ᶜ, g x‖ := norm_sub_le _ _
    _ ≤ (‖toC (chirpA P σ W s t α H U k) - Y‖ + ‖Y - ∑ j ∈ Wn, 2 ^ p * g j‖) + 1 / 2 :=
        add_le_add (norm_add_le _ _) htail2
    _ ≤ (3 / 2 + 2 * W * (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ))) + 1 / 2 := by linarith
    _ = 2 * W * (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ)) + 2 := by ring

end J6A

