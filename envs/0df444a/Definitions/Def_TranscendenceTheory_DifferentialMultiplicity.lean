-- title:
--   Derivative contact ideals and local multiplicity data
-- statement:
--   Let $R$ be a commutative $\mathbb Q$-algebra, $D:R\to R$ a $\mathbb Q$-linear derivation, and $\mathfrak p$ an ideal. For $n\ge0$, define the derivative contact ideal
--
--   $$
--   F_n=\bigl(f\in R:\ D^j f\in\mathfrak p\text{ for }0\le j<n\bigr),
--   $$
--
--   where parentheses denote the ideal generated by the displayed set. The fact that the displayed set is already an ideal is proved separately.
--
--   For nonnegative integers $T,e$, a differential multiplicity witness consists of a commutative $\mathbb Q$-algebra $R$, a prime ideal $\mathfrak p$, a derivation $D$, an element $q\in\mathfrak p$ with $Dq\notin\mathfrak p$, and an ideal $I$ such that
--
--   $$
--   D^j f\in\mathfrak p\quad(f\in I,\ 0\le j\le T),
--   \qquad \operatorname{length}_R(R/I)\le e.
--   $$
--
--   Module length is allowed to be infinite in its definition, but the finite upper bound in a witness excludes that case. The inequality $T+1\le e$ is not assumed in these data; it is the consequence of the separate local multiplicity theorem.
--
--   The ring may be a localization at a prime component. The structure imposes no identification with the mission's geometric objects; constructing such witnesses from the vanishing hypotheses is part of the remaining theorem.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, Proposition 4.7, pp. 378-379, one transverse direction, and section 5, Lemma 5.1, pp. 380-382. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. The local derivative-to-length lower bound is proved; selecting geometric component algebras, verifying their derivative hypotheses, and bounding total length remain open.

import Mathlib.RingTheory.Derivation.Basic
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.RingTheory.Length
import Mathlib.Algebra.Algebra.Rat

noncomputable section
namespace TranscendenceTheory

/-- The ideal generated by elements whose first `n` derivatives lie in `p`.
The equality with the generating set is a separate theorem. -/
def differentialContactIdeal {R : Type*} [CommRing R] [Algebra ℚ R]
    (D : Derivation ℚ R R) (p : Ideal R) (n : ℕ) : Ideal R :=
  Ideal.span {f | ∀ j < n, (D^[j]) f ∈ p}

/-- Concrete local-algebra data for a multiplicity contribution bounded above by `e`.
The lower bound `T + 1` is not a field of this structure. -/
structure DifferentialMultiplicityWitness (T e : ℕ) where
  R : Type
  [commRing : CommRing R]
  [algebra : Algebra ℚ R]
  p : Ideal R
  [prime : p.IsPrime]
  D : Derivation ℚ R R
  q : R
  q_mem : q ∈ p
  deriv_not_mem : D q ∉ p
  I : Ideal R
  jets : ∀ f ∈ I, ∀ j ≤ T, (D^[j]) f ∈ p
  length_le : Module.length R (R ⧸ I) ≤ (e : ℕ∞)

attribute [instance] DifferentialMultiplicityWitness.commRing
  DifferentialMultiplicityWitness.algebra DifferentialMultiplicityWitness.prime

end TranscendenceTheory


