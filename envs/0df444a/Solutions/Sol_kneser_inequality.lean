import Mathlib

/-!
**Kneser's inequality** (1953), in the e-transform presentation of Nathanson
(arXiv:2407.12253, Theorem 10).

If `A` and `B` are nonempty finite subsets of a finite abelian group `G` with
`|A| + |B| ≤ |G|`, then there is a *proper* subgroup `H` of `G` with

  |A + B| ≥ |A| + |B| − |H|,

stated here in `ℕ`-safe form as `A.card + B.card ≤ (A + B).card + Nat.card H`.

The proof is the Dyson e-transform induction (the transform itself is Mathlib's
`Finset.addDysonETransform`, which preserves `|A| + |B|` and only shrinks the sumset). In the
"stable" case — `a + b − b' ∈ A` for all `a ∈ A`, `b, b' ∈ B` — the subgroup `H`
generated by the differences `B − b₀` translates `A` onto itself, hence is proper
(`A ≠ G` because `|A| + |B| ≤ |G|` with `B` nonempty), and satisfies `|B| ≤ |H|`.
Otherwise an e-transform at `e := a − b'` with a witness `a + b − b' ∉ A` strictly
shrinks `B`, and the induction hypothesis transfers its subgroup back along
`A' + B' ⊆ A + B` and `|A'| + |B'| = |A| + |B|`.
-/

open Finset AddSubgroup
open scoped Pointwise

namespace Kneser

variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

/-- If every element of `D` translates `A` onto itself, then so does every element of the
subgroup generated by `D`. -/
lemma image_add_eq_of_mem_closure (A : Finset G) (D : Finset G)
    (h : ∀ d ∈ D, A.image (fun a => a + d) = A) :
    ∀ g ∈ AddSubgroup.closure (D : Set G), A.image (fun a => a + g) = A := by
  intro g hg
  induction hg using AddSubgroup.closure_induction with
  | mem x hx => exact h x hx
  | zero => simp
  | add x y _ _ hx hy =>
    have hcomp : A.image (fun a => a + (x + y))
        = (A.image (fun a => a + x)).image (fun a => a + y) := by
      ext c
      simp only [mem_image]
      constructor
      · rintro ⟨a, ha, rfl⟩
        exact ⟨a + x, ⟨a, ha, rfl⟩, by ac_rfl⟩
      · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
        exact ⟨a, ha, by ac_rfl⟩
    rw [hcomp, hx, hy]
  | neg x _ hx =>
    have hsub : A.image (fun a => a + (-x)) ⊆ A := by
      intro c hc
      rw [mem_image] at hc
      obtain ⟨a, ha, rfl⟩ := hc
      have hax : a ∈ A.image (fun a => a + x) := by rw [hx]; exact ha
      rw [mem_image] at hax
      obtain ⟨a', ha', heq⟩ := hax
      have hsubx : a + (-x) = a' := by rw [← heq]; abel
      rw [hsubx]
      exact ha'
    exact Finset.eq_of_subset_of_card_le hsub
      (by rw [card_image_of_injective _ (fun _ _ hpq => add_right_cancel hpq)])

end Kneser

/-- **Kneser's inequality**: nonempty `A, B` in a finite abelian group with
`|A| + |B| ≤ |G|` admit a proper subgroup `H` with `|A| + |B| ≤ |A + B| + |H|`. -/
theorem solution {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    (A₀ B₀ : Finset G) (hA₀ : A₀.Nonempty) (hB₀ : B₀.Nonempty)
    (hcard₀ : A₀.card + B₀.card ≤ Fintype.card G) :
    ∃ H : AddSubgroup G, H ≠ ⊤ ∧ A₀.card + B₀.card ≤ (A₀ + B₀).card + Nat.card H := by
  have main : ∀ (k : ℕ) (A B : Finset G), B.card ≤ k → A.Nonempty → B.Nonempty →
      A.card + B.card ≤ Fintype.card G →
      ∃ H : AddSubgroup G, H ≠ ⊤ ∧ A.card + B.card ≤ (A + B).card + Nat.card H := by
    intro k
    induction k with
    | zero =>
      intro A B hk hA hB _
      have := Finset.card_pos.2 hB
      omega
    | succ k ih =>
      intro A B hk hA hB hcard
      by_cases hcase : ∀ a ∈ A, ∀ b ∈ B, ∀ b' ∈ B, a + b - b' ∈ A
      · -- the stable case: the subgroup generated by the differences `B - b₀` fixes `A`
        obtain ⟨b₀, hb₀⟩ := hB
        have hinv := Kneser.image_add_eq_of_mem_closure A (B.image (fun b => b - b₀))
          (fun d hd => by
            obtain ⟨b, hb, rfl⟩ := Finset.mem_image.1 hd
            have hsub : A.image (fun a => a + (b - b₀)) ⊆ A := by
              intro c hc
              rw [mem_image] at hc
              obtain ⟨a, ha, rfl⟩ := hc
              have hc2 := hcase a ha b hb b₀ hb₀
              rwa [add_sub_assoc] at hc2
            exact Finset.eq_of_subset_of_card_le hsub
              (by rw [card_image_of_injective _ (fun _ _ hpq => add_right_cancel hpq)]))
        refine ⟨AddSubgroup.closure (B.image (fun b => b - b₀) : Set G), ?_, ?_⟩
        · -- proper: `H = ⊤` would force `A = G`
          intro htop
          obtain ⟨a₀, ha₀⟩ := hA
          have hAuniv : ∀ c : G, c ∈ A := by
            intro c
            have hmem : c - a₀ ∈ AddSubgroup.closure (B.image (fun b => b - b₀) : Set G) := by
              rw [htop]; exact AddSubgroup.mem_top _
            have himg := hinv (c - a₀) hmem
            have hstep : (a₀ + (c - a₀)) ∈ A := by
              have := Finset.mem_image_of_mem (fun a => a + (c - a₀)) ha₀
              exact himg ▸ this
            have ha₀c : a₀ + (c - a₀) = c := by abel
            rwa [ha₀c] at hstep
          have hAeq : A = Finset.univ := Finset.eq_univ_of_forall hAuniv
          have hAGcard : A.card = Fintype.card G := by rw [hAeq, Finset.card_univ]
          have hBpos : 1 ≤ B.card := Finset.card_pos.2 ⟨b₀, hb₀⟩
          have h1 : A.card + B.card ≤ Fintype.card G := hcard
          have h2 : A.card = Fintype.card G := hAGcard
          have h3 : 1 ≤ B.card := hBpos
          omega
        · -- the bound: `|A| ≤ |A + B|` and `|B| ≤ |H|`
          have hcardAB : A.card ≤ (A + B).card := by
            rw [← card_image_of_injective _ (fun _ _ hpq => add_right_cancel hpq)]
            refine card_le_card fun c hc => ?_
            rw [mem_image] at hc
            obtain ⟨a, ha, rfl⟩ := hc
            exact Finset.mem_add.2 ⟨a, ha, b₀, hb₀, rfl⟩
          have hcardBH : B.card ≤ Nat.card
              (AddSubgroup.closure (B.image (fun b => b - b₀) : Set G)) := by
            haveI : Fintype ↥(AddSubgroup.closure (B.image (fun b => b - b₀) : Set G)) :=
              Set.Finite.fintype (Set.toFinite _)
            rw [Nat.card_eq_fintype_card]
            have hinj : Function.Injective (fun b : G => b - b₀) := fun p q hpq => by
              simp only [sub_eq_add_neg] at hpq
              exact add_right_cancel hpq
            rw [← card_image_of_injective _ hinj]
            have hsetsub : B.image (fun b => b - b₀) ⊆
                (Set.toFinite ((AddSubgroup.closure (B.image (fun b => b - b₀) : Set G) : Set G))).toFinset := by
              intro g hg
              exact (Set.Finite.mem_toFinset _).2 (AddSubgroup.subset_closure hg)
            calc (B.image (fun b => b - b₀)).card
                ≤ (Set.toFinite ((AddSubgroup.closure (B.image (fun b => b - b₀) : Set G) : Set G))).toFinset.card :=
                  Finset.card_le_card hsetsub
              _ = Fintype.card ↥(AddSubgroup.closure (B.image (fun b => b - b₀) : Set G)) :=
                  Set.Finite.card_toFinset _
          omega
      · -- the e-transform case
        push_neg at hcase
        obtain ⟨a, haA, b, hb, b', hb', hwit⟩ := hcase
        have hdef : Finset.addDysonETransform (a - b') (A, B)
            = (A ∪ ((a - b') +ᵥ B), B ∩ ((-(a - b')) +ᵥ A)) := rfl
        have hsub : (Finset.addDysonETransform (a - b') (A, B)).1
            + (Finset.addDysonETransform (a - b') (A, B)).2 ⊆ A + B :=
          Finset.addDysonETransform.subset (a - b') (A, B)
        have hcardAB : (Finset.addDysonETransform (a - b') (A, B)).1.card
            + (Finset.addDysonETransform (a - b') (A, B)).2.card = A.card + B.card :=
          Finset.addDysonETransform.card (a - b') (A, B)
        have hA' : (Finset.addDysonETransform (a - b') (A, B)).1.Nonempty := by
          simp only [hdef]
          exact ⟨a, mem_union_left _ haA⟩
        have hb'B' : b' ∈ (Finset.addDysonETransform (a - b') (A, B)).2 := by
          simp only [hdef]
          refine (Finset.mem_inter).2 ⟨hb', ?_⟩
          rw [mem_neg_vadd_finset_iff]
          simpa using haA
        have hbnot : b ∉ (Finset.addDysonETransform (a - b') (A, B)).2 := by
          intro hmem
          simp only [hdef] at hmem
          rw [Finset.mem_inter, mem_neg_vadd_finset_iff, vadd_eq_add] at hmem
          have hrew : (a - b') + b = a + b - b' := by abel
          rw [hrew] at hmem
          exact hwit hmem.2
        have hB'lt : (Finset.addDysonETransform (a - b') (A, B)).2.card < B.card := by
          refine Finset.card_lt_card ⟨?_, ?_⟩
          · intro g hg
            have hg' : g ∈ B ∩ ((-(a - b')) +ᵥ A) := hg
            exact (Finset.mem_inter.1 hg').1
          · intro hsub
            exact hbnot (hsub hb)
        obtain ⟨H, hHtop, hH⟩ := ih
          (Finset.addDysonETransform (a - b') (A, B)).1
          (Finset.addDysonETransform (a - b') (A, B)).2 (by omega) hA' ⟨b', hb'B'⟩
          (by rw [hcardAB]; exact hcard)
        refine ⟨H, hHtop, ?_⟩
        have h1 := Finset.card_le_card hsub
        omega
  exact main B₀.card A₀ B₀ le_rfl hA₀ hB₀ hcard₀
