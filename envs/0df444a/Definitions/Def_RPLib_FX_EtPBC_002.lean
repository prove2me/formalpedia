/-- Germs along an arrow of the category of elements of a point. -/
theorem germ_elem {Λ : Type u} [CommRing Λ] {Z : Scheme.{u}} (Φ : (Z.smallEtaleTopology).Point)
    (F : (Z.Etale)ᵒᵖ ⥤ ModuleCat.{u} Λ) {j j' : Φ.fiber.Elements} (a : j' ⟶ j) (x : F.obj (op j.1)) :
    (Φ.toPresheafFiber j'.1 j'.2 F).hom ((F.map a.1.op).hom x) = (Φ.toPresheafFiber j.1 j.2 F).hom x :=
  (ConcreteCategory.congr_hom (Φ.toPresheafFiber_w a.1 j'.2 F) x).trans
    (congrArg (fun w => (Φ.toPresheafFiber j.1 w F).hom x) a.2)

theorem left_fiberMapIso_inv {X Y : Scheme.{u}} (f : X ⟶ Y) (s : GeomPt X) (V : Y.Etale)
    (b : (comapPt f s).fiber.obj V) :
    ((fiberMapIso f s).inv.app V b).left = (s.liftOf b).left ≫ pullback.fst V.hom f := by
  unfold fiberMapIso Adjunction.compCoyonedaIso
  rfl

theorem fiberMapIso_inv_hom {X Y : Scheme.{u}} (f : X ⟶ Y) (s : GeomPt X) (V : Y.Etale)
    (w : (s.map f).point.fiber.obj V) : (fiberMapIso f s).inv.app V ((fiberMapIso f s).hom.app V w) = w :=
  Iso.hom_inv_id_app_apply _ _ _

theorem pullStalkIso_inj {Λ : Type u} [CommRing Λ] {X Y : Scheme.{u}} (f : X ⟶ Y) (s : GeomPt X) (G : EtSh Λ Y)
    {a₁ a₂ : (s.stalkF Λ).obj ((pull f Λ).obj G)}
