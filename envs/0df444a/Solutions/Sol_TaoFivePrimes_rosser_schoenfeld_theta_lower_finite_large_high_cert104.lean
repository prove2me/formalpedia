  rw [hsr, pow_add]
  calc q / 2 ^ s * (2 ^ e * 2 ^ s) * Y = (q / 2 ^ s * 2 ^ s) * 2 ^ e * Y := by ring
    _ ≤ q * 2 ^ e * Y := Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _))
