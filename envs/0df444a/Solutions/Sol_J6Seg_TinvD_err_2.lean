section ent
variable (P : ℕ)

lemma fmul_approx {x y : ℤ} {c d ex ey Y C : ℝ} (hx : |(x : ℝ) / 2 ^ P - c| ≤ ex)
    (hy : |(y : ℝ) / 2 ^ P - d| ≤ ey) (hY : |(y : ℝ) / 2 ^ P| ≤ Y) (hC : |c| ≤ C)
    (hex : 0 ≤ ex) (hey : 0 ≤ ey) :
    |(fmul P x y : ℝ) / 2 ^ P - c * d| ≤ 1 / (2 * 2 ^ P) + ex * Y + C * ey := by
  have h := fmul_err P x y
  have e : (fmul P x y : ℝ) / 2 ^ P - c * d =
      ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P)) +
      (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d)) := by ring
  rw [e]
  have h1 : |((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)| ≤ ex * Y := by
    rw [abs_mul]; exact mul_le_mul hx hY (abs_nonneg _) hex
  have h2 : |c * ((y : ℝ) / 2 ^ P - d)| ≤ C * ey := by
    rw [abs_mul]; exact mul_le_mul hC hy (abs_nonneg _) ((abs_nonneg _).trans hC)
  have h3 := abs_add_le (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)) (c * ((y : ℝ) / 2 ^ P - d))
  have h4 := abs_add_le ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P))
    (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d))
  linarith

variable {P} {α σ b : ℝ}

lemma small_sq {x c : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 0.01) : x * (c + x) ≤ (c + 0.01) * x := by
  nlinarith

lemma abs_mul_le' {x y X Y : ℝ} (hx : |x| ≤ X) (hy : |y| ≤ Y) : |x * y| ≤ X * Y := by
  rw [abs_mul]; exact mul_le_mul hx hy (abs_nonneg _) ((abs_nonneg _).trans hx)

lemma abs_le_of_approx {x : ℤ} {c e B : ℝ} (h : |(x : ℝ) / 2 ^ P - c| ≤ e) (hc : |c| ≤ B) :
    |(x : ℝ) / 2 ^ P| ≤ B + e := by
  have := abs_sub_abs_le_abs_sub ((x : ℝ) / 2 ^ P) c; linarith

/-- Direct evaluation of `T⁻¹_{uv}` (any `u, v < n`). -/
theorem TinvD_err_sol_aux {T : Tables} {a n : ℕ} {E : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E) (hE : 0 ≤ E)
    (hP : 100 * (((n : ℝ) + 1) * E + 1) ≤ 2 ^ P) {u v : ℕ} (hu : u < n) (hv : v < n) :
    |(fmul P (fmul P (T.gi u) (T.gi v)) (TsumI P T a n u v) : ℝ) / 2 ^ P -
      TinvF α σ b n u v| ≤ 7 * (((n : ℝ) + 1) * E + 1) / 2 ^ P := by
  have hS : (0 : ℝ) < 2 ^ P := two_pow_pos' P
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((n : ℝ) + 1) * E + 1 := ⟨_, rfl⟩
  rw [← hK] at hP ⊢
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hnE : 0 ≤ (n : ℝ) * E := mul_nonneg hn0 hE
  obtain ⟨e, he⟩ : ∃ e : ℝ, e = 1 / 2 ^ P := ⟨_, rfl⟩
  have he0 : 0 ≤ e := by rw [he]; positivity
  have hKe : 100 * (K * e) ≤ 1 := by
    rw [he, mul_one_div, ← mul_div_assoc, div_le_one hS]; linarith
  have hE1 : E * e ≤ K * e := mul_le_mul_of_nonneg_right (by rw [hK]; linarith [mul_nonneg hn0 hE]) he0
  have hK1 : 1 ≤ K := by rw [hK]; linarith [mul_nonneg hn0 hE]
  have hKe' : e ≤ K * e := le_mul_of_one_le_left he0 hK1
  have hdiv : ∀ c : ℝ, c / 2 ^ P = c * e := fun c => by rw [he]; ring
  have hhalf : 1 / (2 * (2 : ℝ) ^ P) = e / 2 := by rw [he]; ring
  have tgi : ∀ u < n, |(T.gi u : ℝ) / 2 ^ P - giR α σ u| ≤ E * e :=
    fun u hu => (ulp_div P (hT.gi u hu)).trans (le_of_eq (hdiv E))
  have tgam : ∀ u < n, |(T.gam u : ℝ) / 2 ^ P - gamR α σ u| ≤ E * e :=
    fun u hu => (ulp_div P (hT.gam u hu)).trans (le_of_eq (hdiv E))
  have tap : ∀ h < n, |(T.ap a h : ℝ) / 2 ^ P - aplus α σ b h| ≤ E * e :=
    fun h hh => (ulp_div P (hT.ap h hh)).trans (le_of_eq (hdiv E))
  have tam : ∀ h < n, |(T.am a h : ℝ) / 2 ^ P - aminus α σ b h| ≤ E * e :=
    fun h hh => (ulp_div P (hT.am h hh)).trans (le_of_eq (hdiv E))
  have hEe0 : 0 ≤ E * e := mul_nonneg hE he0
  have hgi : ∀ u, |giR α σ u| ≤ 1.0001 := fun u => by
    rw [abs_of_pos (giR_pos hα hσ u)]; exact giR_le hα hσ u
  have hgam : ∀ u, |gamR α σ u| ≤ 1 := fun u => by
    rw [abs_of_pos (gamR_pos hα hσ u)]; exact gamR_le_one hα hσ u
  have ham : ∀ h, |aminus α σ b h| ≤ 1.0001 := fun h =>
    (aminus_abs hα hσ hb h).trans (env_le hα hσ h)
  -- the products `Γ_k a⁻_{k-v}`
  have hprod : ∀ k ∈ Ico (max u v) n,
      |(fmul P (T.gam k) (T.am a (k - v)) : ℝ) / 2 ^ P - gamR α σ k * aminus α σ b (k - v)| ≤
        e / 2 + 2.02 * (E * e) := by
    intro k hk
    simp only [mem_Ico] at hk
    have h1 := fmul_approx P (tgam k (by omega)) (tam (k - v) (by omega))
      (abs_le_of_approx (tam (k - v) (by omega)) (ham _)) (hgam k) hEe0 hEe0
    rw [hhalf] at h1
    have := small_sq (c := 1.0001) hEe0 (by linarith)
    linarith
  have hprodX : ∀ k ∈ Ico (max u v) n,
      |(fmul P (T.gam k) (T.am a (k - v)) : ℝ) / 2 ^ P| ≤ 1.04 := by
    intro k hk
    have hb1 : |gamR α σ k * aminus α σ b (k - v)| ≤ 1.0001 := by
      have := abs_mul_le' (hgam k) (ham (k - v)); linarith
    have h1 := abs_le_of_approx (hprod k hk) hb1
    have : e / 2 + 2.02 * (E * e) ≤ 0.03 := by linarith
    linarith
  -- the sum
  have hsum := sum_stage P (I := Ico (max u v) n) (ct := fun k => T.ap a (k - u))
    (xt := fun k => fmul P (T.gam k) (T.am a (k - v))) (c := fun k => aplus α σ b (k - u))
    (x := fun k => gamR α σ k * aminus α σ b (k - v)) (ec := E * e) (δ := e / 2 + 2.02 * (E * e))
    (X := 1.04) (C := 1.05)
    (fun k hk => tap _ (by simp only [mem_Ico] at hk; omega))
    ((sum_le_sum_of_subset_of_nonneg (Ico_subset_Ico_left (le_max_left u v))
      fun _ _ _ => abs_nonneg _).trans (up_rowsum hα hσ hx hb n u))
    hprod hprodX hEe0 (by positivity)
  have hcard : ((Ico (max u v) n).card : ℝ) ≤ n := by
    rw [Nat.card_Ico]; exact_mod_cast Nat.sub_le n _
  set Ts := TsumI P T a n u v with hTs
  have hTs' : Ts = rs P (∑ k ∈ Ico (max u v) n, T.ap a (k - u) * fmul P (T.gam k) (T.am a (k - v))) :=
    rfl
  rw [← hTs'] at hsum
  have hsx : ∑ k ∈ Ico (max u v) n, aplus α σ b (k - u) * (gamR α σ k * aminus α σ b (k - v)) =
      ∑ k ∈ Ico (max u v) n, aplus α σ b (k - u) * gamR α σ k * aminus α σ b (k - v) :=
    sum_congr rfl fun k _ => by ring
  rw [hsx, hhalf] at hsum
  set Sx := ∑ k ∈ Ico (max u v) n, aplus α σ b (k - u) * gamR α σ k * aminus α σ b (k - v)
  have eTs : |(Ts : ℝ) / 2 ^ P - Sx| ≤ 3 * (K * e) := by
    refine hsum.trans ?_
    have h1 : ((Ico (max u v) n).card : ℝ) * (E * e) * 1.04 ≤ (n : ℝ) * (E * e) * 1.04 := by
      have := mul_le_mul_of_nonneg_right hcard (show (0:ℝ) ≤ E * e * 1.04 by positivity)
      linarith
    have hnEe : 0 ≤ (n : ℝ) * (E * e) := mul_nonneg hn0 hEe0
    have : (n : ℝ) * (E * e) * 1.04 + 2.13 * (E * e) + 1.03 * e ≤ 3 * (K * e) := by
      rw [hK]; linarith
    linarith
  have hSx : |Sx| ≤ 1.06 := by
    have := TinvF_abs hα hσ hx hb n u v
    simp only [TinvF] at this
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ Ico (max u v) n, |aplus α σ b (k - u) * gamR α σ k * aminus α σ b (k - v)|
        ≤ ∑ k ∈ Ico u n, |aplus α σ b (k - u)| * 1.0001 := by
          refine (sum_le_sum fun k _ => ?_).trans
            (sum_le_sum_of_subset_of_nonneg (Ico_subset_Ico_left (le_max_left u v))
              fun _ _ _ => by positivity)
          rw [abs_mul, abs_mul]
          have := hgam k; have := ham (k - v)
          have := abs_nonneg (aplus α σ b (k - u)); have := abs_nonneg (gamR α σ k)
          have := abs_nonneg (aminus α σ b (k - v))
          calc |aplus α σ b (k - u)| * |gamR α σ k| * |aminus α σ b (k - v)|
              ≤ |aplus α σ b (k - u)| * 1 * 1.0001 := by gcongr
            _ = _ := by ring
      _ = (∑ k ∈ Ico u n, |aplus α σ b (k - u)|) * 1.0001 := by rw [sum_mul]
      _ ≤ 1.05 * 1.0001 := mul_le_mul_of_nonneg_right (up_rowsum hα hσ hx hb n u) (by norm_num)
      _ ≤ 1.06 := by norm_num
  -- the factor `Γ_u⁻¹ Γ_v⁻¹`
  have hgg := fmul_approx P (tgi u hu) (tgi v hv) (abs_le_of_approx (tgi v hv) (hgi v)) (hgi u)
    hEe0 hEe0
  rw [hhalf] at hgg
  have hgg' : |(fmul P (T.gi u) (T.gi v) : ℝ) / 2 ^ P - giR α σ u * giR α σ v| ≤ 3 * (K * e) := by
    refine hgg.trans ?_
    have := small_sq (c := 1.0001) hEe0 (by linarith)
    linarith
  have hggb : |giR α σ u * giR α σ v| ≤ 1.0003 := by
    have := abs_mul_le' (hgi u) (hgi v); linarith
  have h3 := fmul_approx P hgg' eTs (abs_le_of_approx eTs hSx) hggb (by positivity) (by positivity)
  rw [hhalf] at h3
  have e3 : giR α σ u * giR α σ v * Sx = TinvF α σ b n u v := rfl
  rw [e3] at h3
  rw [show 7 * K / 2 ^ P = 7 * (K * e) by rw [he]; ring]
  refine h3.trans ?_
  have h30 : 3 * (K * e) ≤ 0.03 := by linarith
  have hKe0 : 0 ≤ K * e := by linarith
  have h31 : 3 * (K * e) * (1.06 + 3 * (K * e)) ≤ 3 * (K * e) * 1.09 :=
    mul_le_mul_of_nonneg_left (by linarith) (by linarith)
  linarith

end ent

end J6Seg

