theorem cE_le {e : Ex HS} {B Y : ℕ} (hs : e.size ≤ 1000) (hB : B + 2 ≤ 41 * Y) (hY : 1 ≤ Y) :
    cE e B ≤ 10 ^ 60 * Y ^ 10 := by
  unfold cE
  have h1 : (B + 2) ^ 2 ≤ (41 * Y) ^ 2 := Nat.pow_le_pow_left hB 2
  have h2 : Y ^ 2 ≤ Y ^ 10 := Nat.pow_le_pow_right hY (by norm_num)
  calc (e.size + 1) * 10 ^ 7 * (B + 2) ^ 2 ≤ 1001 * 10 ^ 7 * (41 * Y) ^ 2 :=
        Nat.mul_le_mul (Nat.mul_le_mul_right _ (by omega)) h1
    _ = 1001 * 10 ^ 7 * 1681 * Y ^ 2 := by ring
    _ ≤ 10 ^ 60 * Y ^ 10 := Nat.mul_le_mul (by norm_num) h2

theorem sz_gUpE : (gUpE).size ≤ 1000 := by decide
theorem sz_giE : (giE).size ≤ 1000 := by decide
theorem sz_jQE : (jQE).size ≤ 1000 := by decide
theorem sz_jDE : (jDE).size ≤ 1000 := by decide

section
variable {P R A M : ℕ}

theorem U_lin : 10 ^ 9 * (A + P + R + M + 30) ≤ cUu P R A M := by
  unfold cUu
  have : (A + P + R + M + 30) ^ 1 ≤ (A + P + R + M + 30) ^ 10 :=
    Nat.pow_le_pow_right (by omega) (by norm_num)
  simp only [pow_one] at this
  calc 10 ^ 9 * (A + P + R + M + 30) ≤ 10 ^ 60 * (A + P + R + M + 30) :=
        Nat.mul_le_mul_right _ (by norm_num)
    _ ≤ _ := Nat.mul_le_mul_left _ this

theorem hBW : BW A + 2 ≤ 41 * (A + P + R + M + 30) := by unfold BW; omega

theorem U_bw : 100000 * (BW A + 2) ≤ cUu P R A M := by
  have := U_lin (P := P) (R := R) (A := A) (M := M)
  unfold BW; generalize cUu P R A M = U at *; omega

theorem cEU {e : Ex HS} (hs : e.size ≤ 1000) : cE e (BW A) ≤ cUu P R A M :=
  cE_le hs (hBW (P := P) (R := R) (M := M)) (by omega)

theorem pow10_le {x c Y : ℕ} (h : x ≤ c * Y) : 10 ^ 35 * x ^ 10 ≤ 10 ^ 35 * c ^ 10 * Y ^ 10 := by
  have := Nat.pow_le_pow_left h 10
  rw [mul_pow] at this
  rw [mul_assoc]; exact Nat.mul_le_mul_left _ this

theorem expN1 : expNegCost (BW A) (BW A) (BW A) ≤ cUu P R A M := by
  unfold expNegCost cUu
  have := pow10_le (x := BW A + BW A + BW A + 30) (c := 123) (Y := A + P + R + M + 30)
    (by unfold BW; omega)
  calc _ ≤ _ := this
    _ ≤ _ := Nat.mul_le_mul_right _ (by norm_num)

theorem expN2 : expNegCost P (BW A) (BW A) ≤ cUu P R A M := by
  unfold expNegCost cUu
  have := pow10_le (x := P + BW A + BW A + 30) (c := 123) (Y := A + P + R + M + 30)
    (by unfold BW; omega)
  calc _ ≤ _ := this
    _ ≤ _ := Nat.mul_le_mul_right _ (by norm_num)

theorem expP1 : expPosCost (P + R) (BW A) (BW A) R ≤ cUu P R A M := by
  unfold expPosCost cUu
  have := pow10_le (x := P + R + BW A + BW A + R + 30) (c := 123) (Y := A + P + R + M + 30)
    (by unfold BW; omega)
  calc _ ≤ _ := this
    _ ≤ _ := Nat.mul_le_mul_right _ (by norm_num)

theorem cCall_le {e1 e2 e3 e4 : Ex HS} {C : ℕ} (h1 : e1.size ≤ 1000) (h2 : e2.size ≤ 1000)
    (h3 : e3.size ≤ 1000) (h4 : e4.size ≤ 1000) (hC : C ≤ cUu P R A M) :
    cCall e1 e2 e3 e4 (BW A) C ≤ 6 * cUu P R A M := by
  unfold cCall
  have := cEU (P := P) (R := R) (A := A) (M := M) h1
  have := cEU (P := P) (R := R) (A := A) (M := M) h2
  have := cEU (P := P) (R := R) (A := A) (M := M) h3
  have := cEU (P := P) (R := R) (A := A) (M := M) h4
  have := U_bw (P := P) (R := R) (A := A) (M := M)
  generalize cUu P R A M = U at *; generalize BW A = B at *; linarith

theorem cSt_le {N Cc k : ℕ} (h : Cc ≤ k * cUu P R A M) :
    cSt A N Cc ≤ (N + 1) * ((k + 3) * cUu P R A M) := by
  unfold cSt
  have a1 := cEU (P := P) (R := R) (A := A) (M := M) (e := .lit 0) (by decide)
  have a2 := cEU (P := P) (R := R) (A := A) (M := M) (e := .reg 11) (by decide)
  have a3 := cEU (P := P) (R := R) (A := A) (M := M) (e := .add (.reg 12) (.lit 1)) (by decide)
  have := U_bw (P := P) (R := R) (A := A) (M := M)
  have hb : 8000 * (BW A + 2) + 30 ≤ cUu P R A M := by generalize cUu P R A M = U at *; generalize BW A = B at *; linarith
  have hm := Nat.mul_le_mul_left N (show Cc + cE (.reg 11) (BW A) + cE (.add (.reg 12) (.lit 1)) (BW A) +
    8000 * (BW A + 2) + 30 ≤ (k + 3) * cUu P R A M by generalize cUu P R A M = U at *; nlinarith)
  have h4 : 2 * 2000 * (BW A + 2) + 32 ≤ cUu P R A M := by generalize cUu P R A M = U at *; generalize BW A = B at *; linarith
  generalize cUu P R A M = U at *; nlinarith

end

