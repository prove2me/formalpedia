  intro x hx
  simp only [List.mem_flatMap] at hx
  obtain ⟨X, hX, hx⟩ := hx
  exact hf X hX x hx

theorem canon_colMap' (g : List ℤ → List ℤ) (n j B : ℕ) (hg : GOK g n j) (X : List ℤ)
