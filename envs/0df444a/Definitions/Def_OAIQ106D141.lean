/-- Row sampling in an arbitrary number of retained nonzero coordinates. -/
def averagedRowProducts {p n : ℕ} (H : CMatrix) (A : Matrix (Fin p) (Fin n) ℤ) : ℝ :=
  average (fun ρ : Fin p ↪ Coord =>
    ((∏ j, rowFourier H ρ (fun i => A i j)).re +
      (∏ j, rowFourier H.transpose ρ (fun i => A i j)).re) / 2)

end MUB6

