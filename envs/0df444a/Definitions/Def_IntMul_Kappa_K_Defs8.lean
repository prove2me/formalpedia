/-! ## Generic chains -/

theorem chainOK_mono {M : Type*} {P Q : M → M → Prop} (hPQ : ∀ a b, P a b → Q a b) :
    ∀ (s : M) (xs : List M) (e : M), chainOK P s xs e → chainOK Q s xs e := by
  intro s xs
  induction xs generalizing s with
  | nil => intro e h; exact hPQ _ _ h
  | cons x xs ih => intro e h; exact ⟨hPQ _ _ h.1, ih x e h.2⟩

theorem chainOK_map {M N : Type*} (f : M → N) (P : N → N → Prop) :
    ∀ (s : M) (xs : List M) (e : M),
      chainOK P (f s) (xs.map f) (f e) ↔ chainOK (fun a b => P (f a) (f b)) s xs e := by
  intro s xs
  induction xs generalizing s with
  | nil => intro e; exact Iff.rfl
  | cons x xs ih => intro e; simp only [List.map_cons, chainOK, ih]

theorem chain2_map {M N β : Type*} [AddCommMonoid β] (f : M → N) (F : N → N → β) :
    ∀ (s : M) (xs : List M) (e : M),
      chain2 F (f s) (xs.map f) (f e) = chain2 (fun a b => F (f a) (f b)) s xs e := by
  intro s xs
  induction xs generalizing s with
  | nil => intro e; rfl
  | cons x xs ih => intro e; simp only [List.map_cons, chain2, ih]

/-- Along increasing edges the residual dimensions telescope. -/
theorem chain2_up {m : ℕ} :
    ∀ (s : Submodule (ZMod 2) (Fin m → ZMod 2)) (xs : List (Submodule (ZMod 2) (Fin m → ZMod 2)))
      (e : Submodule (ZMod 2) (Fin m → ZMod 2)), chainOK (fun V U => Up U V) s xs e →
      ((chain2 Fd s xs e : ℕ) : ℤ) = finrank (ZMod 2) e - finrank (ZMod 2) s := by
  intro s xs
  induction xs generalizing s with
  | nil => intro e h; exact Fd_up h
  | cons x xs ih =>
    intro e h
    simp only [chain2]
    push_cast
    rw [Fd_up h.1, ih x e h.2]
    ring

lemma up_edge {m : ℕ} {U V : Submodule (ZMod 2) (Fin m → ZMod 2)} (h : Up U V) : EdgeOK V U :=
  Or.inl h

/-- A side wire joining the `Y`-triple `y` and the `X`-triple `x` (neighbours). -/
theorem side_generic (hh : 7 ≤ h) (j : Fin 3) {S1 S2 x y : Finset (Fin h)} (hS1 : S1.card = 3)
    (hS2 : S2.card = 3) (hx : x.card = 3) (hy : y.card = 3) (hxy : tt y ⬝ᵥ tt x = 0) :
    chainOK (fun V U => Up U V) ⊥
      [lab j S1 S2 (L1 y) ⊥, lab j S1 S2 ⊤ (L1 x), lab j S1 S2 ⊤ (Pp y), lab j S1 S2 ⊤ ⊤] ⊤ := by
  obtain ⟨k1, hk1⟩ := out3 hh hS1
  obtain ⟨k2, hk2⟩ := out3 hh hS2
  obtain ⟨k, hk⟩ := exists_out (x ∪ y) (by
    have := Finset.card_union_le x y; omega)
  have hkx : k ∉ x := fun e => hk (Finset.mem_union_left _ e)
  have hky : k ∉ y := fun e => hk (Finset.mem_union_right _ e)
  have i1 : IncW ⊥ (lab j S1 S2 (L1 y) ⊥) := by
    have := inc_be hS1 hS2 (Ψ2 := ⊥) j bot_le (y := tt y) (tt_mem_L1 _) (tt_norm hy)
      (orth_bot _) hk1
    rwa [lab_bot] at this
  simp only [chainOK]
  refine ⟨upW HasON_bot ?_ i1,
    upW ?_ ?_ (inc_pi hS1 hS2 j le_top bot_le (y := tt x) (tt_mem_L1 _) (tt_norm hx) (orth_bot _)),
    upW ?_ ?_ (inc_pi hS1 hS2 j le_rfl (L1_le_Pp hxy) (y := ek k) (ek_mem_Pp hky) (dot_ek_ek _)
      (orth_L1 (dot_tt_ek hkx))),
    upW ?_ ?_ (inc_pi hS1 hS2 j le_rfl le_top (y := tt y) Submodule.mem_top (tt_norm hy)
      (orth_Pp y)),
    upW ?_ HasON_topC (inc_sink hS1 hS2 j hk1 hk2)⟩
  · exact HasON_lab' hh hS1 hS2 (HasON_L1 hy) HasON_bot
  · exact HasON_lab' hh hS1 hS2 (HasON_L1 hy) HasON_bot
  · exact HasON_lab' hh hS1 hS2 HasON_top (HasON_L1 hx)
  · exact HasON_lab' hh hS1 hS2 HasON_top (HasON_L1 hx)
  · exact HasON_lab' hh hS1 hS2 HasON_top (HasON_Pp' hh hy)
  · exact HasON_lab' hh hS1 hS2 HasON_top (HasON_Pp' hh hy)
  · exact HasON_lab' hh hS1 hS2 HasON_top HasON_top
  · exact HasON_lab' hh hS1 hS2 HasON_top HasON_top

/-- A central wire: the only decreasing edge is time 3 → 4, losing exactly `h`. -/
theorem center_generic (hh : 7 ≤ h) (j : Fin 3) {S1 S2 : Finset (Fin h)} (hS1 : S1.card = 3)
    (hS2 : S2.card = 3) :
    chainOK EdgeOK ⊥ [lab j S1 S2 ⊤ ⊥, lab j S1 S2 ⊤ ⊤, lab j S1 S2 ⊤ ⊥, lab j S1 S2 ⊤ ⊤] ⊤ ∧
      ((chain2 Fd ⊥ [lab j S1 S2 ⊤ ⊥, lab j S1 S2 ⊤ ⊤, lab j S1 S2 ⊤ ⊥, lab j S1 S2 ⊤ ⊤] ⊤ : ℕ) : ℤ) =
        h ^ 3 + 2 * h := by
  obtain ⟨k1, hk1⟩ := out3 hh hS1
  obtain ⟨k2, hk2⟩ := out3 hh hS2
  have H1 := HasON_lab' hh hS1 hS2 (j := j) HasON_top HasON_bot
  have H3 := HasON_lab' hh hS1 hS2 (j := j) HasON_top HasON_top
  have hA : Up ⊥ (lab j S1 S2 ⊤ ⊥) := by
    have := inc_be hS1 hS2 (Ψ2 := ⊥) j bot_le (y := ek k1) Submodule.mem_top (dot_ek_ek _)
      (orth_bot _) hk1
    rw [lab_bot] at this
    exact upW HasON_bot H1 this
  have hB : Up (lab j S1 S2 ⊤ ⊥) (lab j S1 S2 ⊤ ⊤) :=
    upW H1 H3 (inc_pi hS1 hS2 j le_rfl bot_le (y := ek k1) Submodule.mem_top (dot_ek_ek _)
      (orth_bot _))
  have hC : Up (lab j S1 S2 ⊤ ⊤) ⊤ := upW H3 HasON_topC (inc_sink hS1 hS2 j hk1 hk2)
  refine ⟨⟨Or.inl hA, Or.inl hB, Or.inr hB, Or.inl hB, Or.inl hC⟩, ?_⟩
  simp only [chain2]
  push_cast
  rw [Fd_up hA, Fd_up hB, Fd_down hB, Fd_up hC, finrank_lab_center hS1 hS2 j, finrank_top,
    finrank_fin_fun, finrank_bot]
  push_cast
  ring

