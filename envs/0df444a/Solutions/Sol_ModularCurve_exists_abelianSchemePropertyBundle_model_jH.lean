section GaloisGlue

noncomputable abbrev tBar (ℓ : ℕ) : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶
    Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)) :=
  Spec.map (CommRingCat.ofHom (algebraMap ↥(GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ)))

noncomputable abbrev specGal (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)) :=
  Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ))

theorem specGal_comp_tBar (ℓ : ℕ) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    specGal σ ≫ tBar ℓ = tBar ℓ := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext r
  show σ (algebraMap _ (AlgebraicClosure ℚ) r) = algebraMap _ (AlgebraicClosure ℚ) r
  have hr : algebraMap (GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ) r =
      algebraMap ℚ (AlgebraicClosure ℚ) (r : ℚ) := rfl
  rw [hr]
  exact σ.commutes (r : ℚ)

variable (F₀ : IntermediateField ℚ (LaurentSeries ℚ))

abbrev FBar : Type :=
  ↥(laurentBaseChange (AlgebraicClosure ℚ) F₀)

