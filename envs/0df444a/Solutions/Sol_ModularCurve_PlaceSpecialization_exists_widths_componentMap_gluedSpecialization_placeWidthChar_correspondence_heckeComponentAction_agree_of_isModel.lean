private theorem map_sub_zsmul_eq_zero_of_map_eq_zsmul {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    (f : G →+ H) {a b : G} {n : ℤ} (h : f a = n • f b) : f (a - n • b) = 0 := by
  rw [map_sub, map_zsmul, h, sub_self]

private theorem map_eq_zsmul_of_map_sub_zsmul_eq_zero {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    (f : G →+ H) {a b : G} {n : ℤ} (h : f (a - n • b) = 0) : f a = n • f b := by
  rwa [map_sub, map_zsmul, sub_eq_zero] at h

private theorem apply_eq_of_forall_apply_mk_eq {M C R P₀ σ : Type*} [SetLike σ M] {S : σ}
    (c : ↥S → C) (act : C → C) {mk : R → M} {good : R → Prop} {okp : P₀ → Prop}
    {proj : R → ∀ s : P₀, okp s → C}
    (hlaw : ∀ (D : R) (hH : mk D ∈ S), good D → ∀ (s : P₀) (hs : okp s), c ⟨mk D, hH⟩ = proj D s hs)
    {x x' : ↥S} {D D' : R} (hD : good D) (hD' : good D') (hDx : mk D = x) (hD'x : mk D' = x')
    (s : P₀) (hs : okp s) (hC1 : proj D' s hs = act (proj D s hs)) : c x' = act (c x) := by
  have hH : mk D ∈ S := by
    rw [hDx]
    exact x.2
  have hH' : mk D' ∈ S := by
    rw [hD'x]
    exact x'.2
  have ex : (⟨mk D, hH⟩ : ↥S) = x := Subtype.ext hDx
  have ex' : (⟨mk D', hH'⟩ : ↥S) = x' := Subtype.ext hD'x
  rw [← ex, ← ex', hlaw D hH hD s hs, hlaw D' hH' hD' s hs, hC1]

