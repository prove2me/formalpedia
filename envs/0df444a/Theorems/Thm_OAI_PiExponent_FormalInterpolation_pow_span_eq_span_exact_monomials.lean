-- title:
--   Powers of a finitely generated ideal are spanned by exact-degree monomials
-- statement:
--   The nth power of the ideal generated by a finite family is the ideal spanned by the monomials whose generator multiplicities sum to n.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.pow_span_eq_span_exact_monomials
    {σ : Type*} [Fintype σ] {R : Type*} [CommSemiring R]
    (f : σ → R) (n : Nat) :
    (Ideal.span (Set.range f)) ^ n =
      Ideal.span {x : R | ∃ b : σ → Nat, (∑ i, b i) = n ∧ x = ∏ i, f i ^ (b i)} := by sorry
