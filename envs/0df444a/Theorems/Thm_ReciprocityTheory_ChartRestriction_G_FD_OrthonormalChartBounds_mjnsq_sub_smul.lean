theorem ReciprocityTheory.ChartRestriction.G.FD.OrthonormalChartBounds.mjnsq_sub_smul {n : ℕ} (p q : Fin n → ℂ) (t : ℝ) :
    nsq (p - (t : ℂ) • q) = nsq p - 2 * t * (mjip p q).re + t ^ 2 * nsq q := by sorry
