open CategoryTheory AlgebraicGeometry NeronModelInfra GoodReductionJacobian ModularCurve IsLocalRing

namespace KERGlue

section ZlFacts

variable (ℓ : ℕ) [hℓ : Fact ℓ.Prime]

local notation "Zl" => GaloisRep.ratLocalizedAt ℓ

omit hℓ in
lemma mem_ratLocalizedAt_iff {q : ℚ} : q ∈ GaloisRep.ratLocalizedAt ℓ ↔ q.den.Coprime ℓ := Iff.rfl

abbrev Pl : Ideal ℤ := Ideal.span {(ℓ : ℤ)}

scoped instance Pl_isPrime : (Pl ℓ).IsPrime :=
  (Ideal.span_singleton_prime (by exact_mod_cast hℓ.out.ne_zero)).mpr
    (Nat.prime_iff_prime_int.mp hℓ.out)

lemma Pl_ne_bot : Pl ℓ ≠ ⊥ := by
  rw [Ne, Ideal.span_singleton_eq_bot]
  exact_mod_cast hℓ.out.ne_zero

private lemma _root_.KERGlue.mem_primeCompl_iff {z : ℤ} : z ∈ (Pl ℓ).primeCompl ↔ ¬ (ℓ : ℤ) ∣ z := by
  rw [Ideal.mem_primeCompl_iff, Ideal.mem_span_singleton]

p2m_export "KERGlue" "mem_primeCompl_iff"
lemma coprime_of_not_dvd {n : ℕ} (h : ¬ ℓ ∣ n) : n.Coprime ℓ :=
  Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hℓ.out).mpr h)

scoped instance isLocalizationAtPrime : IsLocalization.AtPrime Zl (Pl ℓ) := by
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨z, hz⟩
    rw [mem_primeCompl_iff] at hz
    have hz0' : z ≠ 0 := by rintro rfl; exact hz (dvd_zero _)
    have hz0 : (z : ℚ) ≠ 0 := by exact_mod_cast hz0'
    have hmem : (z : ℚ)⁻¹ ∈ GaloisRep.ratLocalizedAt ℓ := by
      rw [mem_ratLocalizedAt_iff, Rat.inv_intCast_den, if_neg hz0']
      apply coprime_of_not_dvd
      intro h
      exact hz (Int.natCast_dvd.mpr h)
    refine ⟨⟨algebraMap ℤ Zl z, ⟨(z : ℚ)⁻¹, hmem⟩, ?_, ?_⟩, rfl⟩
    · apply Subtype.ext; simp [hz0]
    · apply Subtype.ext; simp [hz0]
  · rintro ⟨q, hq⟩
    have hden : (q.den : ℤ) ∈ (Pl ℓ).primeCompl := by
      rw [mem_primeCompl_iff]
      intro h
      have h' : ℓ ∣ q.den := Int.natCast_dvd_natCast.mp h
      have hc : q.den.Coprime ℓ := hq
      have h1 : ℓ = 1 := Nat.Coprime.eq_one_of_dvd (Nat.Coprime.symm hc) h'
      exact hℓ.out.one_lt.ne' h1
    refine ⟨⟨q.num, ⟨(q.den : ℤ), hden⟩⟩, ?_⟩
    apply Subtype.ext
    show q * ((algebraMap ℤ Zl (q.den : ℤ) : Zl) : ℚ) = ((algebraMap ℤ Zl q.num : Zl) : ℚ)
    simp [Rat.mul_den_eq_num]
  · intro a b h
    refine ⟨1, ?_⟩
    have : ((algebraMap ℤ Zl a : Zl) : ℚ) = ((algebraMap ℤ Zl b : Zl) : ℚ) := by rw [h]
    simpa using this

scoped instance isDVR : IsDiscreteValuationRing Zl :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℤ (Pl_ne_bot ℓ) Zl

omit hℓ in
lemma natCast_eq_algebraMap : (ℓ : Zl) = algebraMap ℤ Zl (ℓ : ℤ) := by simp

lemma maximalIdeal_eq : maximalIdeal Zl = Ideal.span {(ℓ : Zl)} := by
  apply le_antisymm
  · intro y hy
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Pl ℓ).primeCompl y
    have ha : a ∈ Pl ℓ := (IsLocalization.AtPrime.mk'_mem_maximal_iff Zl (Pl ℓ) a s).mp hy
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
    rw [Ideal.mem_span_singleton]
    refine ⟨IsLocalization.mk' Zl c s, ?_⟩
    rw [natCast_eq_algebraMap, IsLocalization.mul_mk'_eq_mk'_of_mul]
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, natCast_eq_algebraMap]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff Zl (Pl ℓ) _).mpr
      (Ideal.mem_span_singleton_self _)

lemma natCast_ne_zero : (ℓ : Zl) ≠ 0 := by
  exact_mod_cast hℓ.out.ne_zero

lemma irreducible_natCast : Irreducible (ℓ : Zl) :=
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal (ℓ : Zl) (natCast_ne_zero ℓ) (maximalIdeal_eq ℓ)

lemma mem_maximalIdeal_iff_dvd {x : Zl} : x ∈ maximalIdeal Zl ↔ (ℓ : Zl) ∣ x := by
  rw [maximalIdeal_eq, Ideal.mem_span_singleton]

end ZlFacts

section Points

universe u

variable {R : Type u} [CommRing R] {J : Scheme.{u}} {f : J ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
  {M : Type*} [AddCommGroup M] (e : M ≃ SchemeHomOver t f)
  (he : ∀ x y : M, e (x + y) = L.mul t (e x) (e y))

include he

lemma e_zero : e 0 = L.one t := by
  letI := L.pointGroup t
  have h : e 0 * e 0 = e 0 * 1 := by
    show L.mul t (e 0) (e 0) = _
    rw [← he, add_zero]; exact (mul_one _).symm
  exact mul_left_cancel h

lemma e_nsmul (n : ℕ) (x : M) : e (n • x) = L.nsmul t n (e x) := by
  induction n with
  | zero => rw [zero_smul, RelativeGroupLaw.nsmul_zero]; exact e_zero L t e he
  | succ n ih => rw [succ_nsmul, he, ih, RelativeGroupLaw.nsmul_succ]

lemma isTorsionPoint_iff (n : ℕ) (x : M) : L.IsTorsionPoint t n (e x) ↔ n • x = 0 := by
  rw [RelativeGroupLaw.isTorsionPoint_def, ← e_nsmul L t e he, ← e_zero L t e he]
  exact e.injective.eq_iff

lemma e_neg (x : M) : letI := L.pointGroup t; e (-x) = (e x)⁻¹ := by
  letI := L.pointGroup t
  apply eq_inv_of_mul_eq_one_right
  show L.mul t (e x) (e (-x)) = L.one t
  rw [← he, add_neg_cancel]; exact e_zero L t e he

end Points

section Main

set_option maxHeartbeats 25600000 in
theorem main (p : ℕ) [NeZero p]
    (ℓ : ℕ) [hℓ : Fact ℓ.Prime] (hℓp : ¬ ℓ ∣ p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ)
    [CharP (ResidueField ↥A) ℓ]
    (hinp : ReductionInputsModL A p) (k : ℕ) (y : JZero p)
    (hy : letI := heckeModuleBar p; y ∈ eisensteinKernelSubmodule p (heckeModuleBar p))
    (hred : reductionModL A p y ∈
      Submodule.torsionBy ℤ (JZeroC (ResidueField ↥A) p) ((ℓ : ℤ) ^ k)) :
    letI := heckeModuleBar p
    ∃ n : ℕ, k ≤ n ∧ ∃ z : JZero p, z ∈ eisensteinKernelSubmodule p (heckeModuleBar p) ∧
      z ∈ Submodule.torsionBy ℤ (JZero p) ((ℓ : ℤ) ^ n) ∧
      reductionModL A p z = reductionModL A p y := by
  letI := heckeModuleBar p

  obtain ⟨J, f, L, pts, hJ, hLcomm, hpts_add, -, hplace, hHecke⟩ :=
    ModularCurve.exists_relJacobian_jZero p ℓ hℓp

  obtain ⟨σA, ptsA, ptsSp, hptsA, hptsSp_add, hRedA⟩ := hplace A hA
  have hRed : ReductionOfPointsAgreesModL p A f σA ptsA ptsSp := hRedA hinp

  obtain ⟨ψ, hψ⟩ : ∃ ψ : (GaloisRep.ratLocalizedAt ℓ) →+* ↥A, Spec.map (CommRingCat.ofHom ψ) = σA :=
    ⟨(Spec.preimage σA).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  letI : Algebra (GaloisRep.ratLocalizedAt ℓ) ↥A := ψ.toAlgebra
  have hσ : σA = Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) ↥A)) := hψ.symm
  subst hσ

  have hsub : algebraMap (↥A) (AlgebraicClosure ℚ) = A.subtype := RingHom.ext fun _ => rfl
  have hIST : IsScalarTower (GaloisRep.ratLocalizedAt ℓ) ↥A (AlgebraicClosure ℚ) := by
    apply IsScalarTower.of_algebraMap_eq'
    have h1 := (pts 0).2
    have h2 := (ptsA 0).2
    rw [hptsA 0] at h2
    rw [h1] at h2
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp] at h2
    have h3 := congrArg CommRingCat.Hom.hom (Spec.map_injective h2)
    simp only [CommRingCat.hom_ofHom] at h3
    rw [hsub]; exact h3

  choose φ hφ_hom hφ_pts using hHecke
  let S : Set (SchemeHomOver f f) := {e | ∃ t ∈ eisensteinKernel (JZero p) (eisensteinIdeal p), e = φ t}
  have hS : ∀ 𝒯 ∈ S, ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (GaloisRep.ratLocalizedAt ℓ))) (x y : SchemeHomOver s f),
      NeronModelInfra.schemeHomOverComp (L.mul s x y) 𝒯 =
        L.mul s (NeronModelInfra.schemeHomOverComp x 𝒯) (NeronModelInfra.schemeHomOverComp y 𝒯) := by
    rintro _ ⟨t, -, rfl⟩ T s x y
    exact hφ_hom t s x y

  have hcomp : ∀ (t : HeckeAlg) (m : JZero p),
      NeronModelInfra.schemeHomOverComp (pts m) (φ t) = pts (t • m) := by
    intro t m
    apply Subtype.ext
    rw [NeronModelInfra.schemeHomOverComp_coe, hφ_pts t m]

  choose extA hextA_gen hextA_sp using hRed
  have hext : ∀ q : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ)))) f,
      Spec.map (CommRingCat.ofHom (algebraMap (↥A) (AlgebraicClosure ℚ))) ≫ (extA (pts.symm q)).1 = q.1 := by
    intro q
    have h := congrArg Subtype.val (hextA_gen (pts.symm q))
    rw [GoodReductionJacobian.schemeHomOverComp_coe, hptsA, Equiv.apply_symm_apply] at h
    rw [hsub]; exact h
  have hext_sp : ∀ m : JZero p,
      GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (residue ↥A))) rfl
          (extA (pts.symm (pts m)))
        = ptsSp (reductionModL A p m) := by
    intro m
    rw [Equiv.symm_apply_apply]; exact hextA_sp m

  letI grpOmega : Group (SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ)))) f) :=
    L.pointGroup _

  have hy' : pts y ∈ Subgroup.closure
      {z | ∃ 𝒯 ∈ S, ∃ x, z = NeronModelInfra.schemeHomOverComp x 𝒯} := by
    refine Submodule.smul_induction_on (p := fun m => pts m ∈ Subgroup.closure
      {z | ∃ 𝒯 ∈ S, ∃ x, z = NeronModelInfra.schemeHomOverComp x 𝒯}) hy ?_ ?_
    · intro t ht m _
      apply Subgroup.subset_closure
      exact ⟨φ t, ⟨t, ht, rfl⟩, pts m, (hcomp t m).symm⟩
    · intro a b ha hb
      rw [hpts_add]; exact Subgroup.mul_mem _ ha hb

  have hred' : L.IsTorsionPoint
      (Spec.map (CommRingCat.ofHom (residue ↥A)) ≫ Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) ↥A)))
      (ℓ ^ k)
      (GoodReductionJacobian.schemeHomOverComp (Spec.map (CommRingCat.ofHom (residue ↥A))) rfl
        (extA (pts.symm (pts y)))) := by
    rw [hext_sp, isTorsionPoint_iff L _ ptsSp hptsSp_add]
    have := (Submodule.mem_torsionBy_iff _ _).mp hred
    rw [← natCast_zsmul]; exact_mod_cast this

  have hfin : ∀ j : ℕ, IsFinite (L.schemeNsmul (ℓ ^ j)) := fun j =>
    (ModularCurve.isFinite_and_flat_schemeNsmul_pow_of_jZeroC_points p ℓ hℓp L hJ (fun s x y => hLcomm s x y)
      A hA _ ptsSp hptsSp_add j).1

  have htors : ∀ x : SchemeHomOver
      (Spec.map (CommRingCat.ofHom (residue ↥A)) ≫ Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) ↥A))) f,
      ∃ n : ℕ, 0 < n ∧ L.IsTorsionPoint _ n x := by
    intro x
    obtain ⟨u, rfl⟩ := ptsSp.surjective x
    obtain ⟨n, hn, hnu⟩ :=
      (isOfFinAddOrder_iff_nsmul_eq_zero.mp (ModularCurve.isOfFinAddOrder_jZeroC_residueField p ℓ hℓp A hA u))
    exact ⟨n, hn, (isTorsionPoint_iff L _ ptsSp hptsSp_add n u).mpr hnu⟩

  obtain ⟨m, z, hkm, hz_mem, hz_tors, hz_red⟩ :=
    @GoodReductionJacobian.RelativeGroupLaw.exists_isTorsionPoint_pow_and_reduction_eq_of_mem_closure_endomorphisms_of_forall_isTorsionPoint
      (GaloisRep.ratLocalizedAt ℓ) _ _ ℓ _ (↥A) _ _ _ _
      (AlgebraicClosure ℚ) _ _ _ _ _ hIST _ _ L hJ
      (fun s x y => hLcomm s x y) hfin htors S hS (fun q => extA (pts.symm q)) hext k (pts y) hy' hred'

  refine ⟨m, hkm, pts.symm z, ?_, ?_, ?_⟩
  ·
    have key : ∀ w ∈ Subgroup.closure
        {z | ∃ 𝒯 ∈ S, ∃ x, z = NeronModelInfra.schemeHomOverComp x 𝒯},
        pts.symm w ∈ eisensteinKernelSubmodule p (heckeModuleBar p) := by
      intro w hw
      induction hw using Subgroup.closure_induction with
      | mem w hw =>
          obtain ⟨_, ⟨t, ht, rfl⟩, x, rfl⟩ := hw
          have : NeronModelInfra.schemeHomOverComp x (φ t) = pts (t • pts.symm x) := by
            rw [← hcomp, Equiv.apply_symm_apply]
          rw [this, Equiv.symm_apply_apply]
          exact Submodule.smul_mem_smul ht Submodule.mem_top
      | one =>
          have : (1 : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap (GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ)))) f) = pts 0 :=
            (e_zero L _ pts hpts_add).symm
          rw [this, Equiv.symm_apply_apply]; exact Submodule.zero_mem _
      | mul a b _ _ iha ihb =>
          have : a * b = pts (pts.symm a + pts.symm b) := by
            rw [hpts_add, Equiv.apply_symm_apply, Equiv.apply_symm_apply]; rfl
          rw [this, Equiv.symm_apply_apply]; exact Submodule.add_mem _ iha ihb
      | inv a _ iha =>
          have : a⁻¹ = pts (-(pts.symm a)) := by
            rw [e_neg L _ pts hpts_add, Equiv.apply_symm_apply]
          rw [this, Equiv.symm_apply_apply]; exact Submodule.neg_mem _ iha
    exact key z hz_mem
  ·
    rw [Submodule.mem_torsionBy_iff]
    have h := (isTorsionPoint_iff L _ pts hpts_add (ℓ ^ m) (pts.symm z)).mp
      (by rw [Equiv.apply_symm_apply]; exact hz_tors)
    rw [← natCast_zsmul] at h; exact_mod_cast h
  ·
    apply ptsSp.injective
    rw [← hext_sp, ← hext_sp, Equiv.apply_symm_apply]
    exact hz_red

end Main

