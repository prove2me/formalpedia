-- Source module: Solutions.J6SegILSlab1
/-!
# B-line IL, B1 (streaming slab pass) §1: the list level

The IL slab pass streams a `(pre, n, m)` array of *units* (an integer, or a pair of integers
for the zipped output pass) block by block. A block is driven by a **command list**
`cs : List (ℤ × ℤ)` of pairs `(op, arg)`:

* `op < 0`: drop the current input slab (`m` units);
* `op = 0`: emit a zero slab (`m` zeros);
* `op > 0`: emit the current input slab mapped unit-wise by `g arg` (the slab is kept).

`runC m g cs B` is the output of one block. For a monotone source `src` (`MonoSrc`),
`ctlOf n n' src argOf` is the command list (drops to the next source slab, then an emit;
a zero emit for `none`; final drops), and **`runC_ctlOf`**: the block output is the block of
`slabPass n n' m src (fun l => g (argOf l))`. **`slabPass_blocks`**: the whole pass is the
concatenation of the block outputs.

**`flat_slabPass`**: for a flattening `φ : α → List γ` with two entries per item and a map `h`
acting entry-wise (`φ (h l x) = (φ x).map (h' l)`), `flatMap φ` commutes with slab passes
(`post ↦ 2 post`). Instances: `gflat` (passes 1, 3, 5) and `pflat` on `zip Y Y₂` (pass 7,
`pflat (zip Y Y₂) = zip (gflat Y) (gflat Y₂)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Commands -/

section cmd
variable {U : Type*}

theorem runC_drops (m : ℕ) (g : ℤ → U → ℤ) (j : ℕ) (cs : List (ℤ × ℤ)) (inp : List U) :
    runC m g (List.replicate j dropC ++ cs) inp = runC m g cs (inp.drop (j * m)) := by
  induction j generalizing inp with
  | zero => simp
  | succ j ih =>
    rw [List.replicate_succ, List.cons_append]
    have e : runC m g (dropC :: (List.replicate j dropC ++ cs)) inp =
        runC m g (List.replicate j dropC ++ cs) (inp.drop m) := by
      simp only [runC, dropC, show (-1 : ℤ) < 0 by norm_num, if_true]
    rw [e, ih, List.drop_drop]
    congr 1; ring

theorem ctlAux_le (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), cur ≤ n → SrcFrom src n ls cur →
      cur ≤ (ctlAux src argOf ls cur).2 ∧ (ctlAux src argOf ls cur).2 ≤ n
  | [], cur, hc, _ => by simp [ctlAux, hc]
  | l :: ls, cur, hc, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs]
      exact ctlAux_le src argOf n ls cur hc h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      have := ctlAux_le src argOf n ls k h2.le h3
      simp only [ctlAux, hs]
      exact ⟨by omega, this.2⟩

variable [Inhabited U]

theorem runC_ctlAux (m : ℕ) (g : ℤ → U → ℤ) (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ)
    (B : List U) :
    ∀ (ls : List ℕ) (cur : ℕ) (tail : List (ℤ × ℤ)), SrcFrom src n ls cur →
      runC m g ((ctlAux src argOf ls cur).1 ++ tail) (B.drop (cur * m)) =
        ls.flatMap (fun l => slabZ B m (src l) (g (argOf l))) ++
          runC m g tail (B.drop ((ctlAux src argOf ls cur).2 * m))
  | [], cur, tail, _ => by simp [ctlAux]
  | l :: ls, cur, tail, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs, List.cons_append, runC, lt_irrefl, if_false, if_true,
        List.flatMap_cons, slabZ_none, List.append_assoc]
      rw [runC_ctlAux m g src argOf n B ls cur tail h]
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      simp only [ctlAux, hs, List.append_assoc, List.cons_append]
      rw [runC_drops, List.drop_drop]
      have e : cur * m + (k - cur) * m = k * m := by rw [← Nat.add_mul]; congr 1; omega
      rw [e]
      simp only [runC, show ¬ (1 : ℤ) < 0 by norm_num, show ¬ (1 : ℤ) = 0 by norm_num, if_false,
        List.flatMap_cons, hs, slabZ_some, List.append_assoc]
      rw [runC_ctlAux m g src argOf n B ls k tail h3]

theorem srcFrom_of_mono {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    ∀ (j : ℕ) (cur : ℕ), j ≤ n' → (∀ l k, l < j → src l = some k → k ≤ cur) →
      (∀ l k, j ≤ l → l < n' → src l = some k → cur ≤ k) →
      SrcFrom src n ((List.range n').drop j) cur := by
  intro j cur hj hlo hhi
  induction hk : n' - j generalizing j cur with
  | zero =>
    rw [List.drop_of_length_le (by simp; omega)]; trivial
  | succ r ih =>
    have hjn : j < n' := by omega
    rw [List.drop_eq_getElem_cons (by simp; exact hjn)]
    simp only [List.getElem_range]
    unfold SrcFrom
    cases hs : src j with
    | none =>
      exact ih (j + 1) cur (by omega)
        (fun l k hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact hlo l k hl hlk
          · rw [hs] at hlk; cases hlk)
        (fun l k hl hln hlk => hhi l k (by omega) hln hlk) (by omega)
    | some k =>
      refine ⟨hhi j k le_rfl hjn hs, h.1 j hjn k hs, ?_⟩
      exact ih (j + 1) k (by omega)
        (fun l k' hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact h.2 l j k' k hl hjn hlk hs
          · rw [hs] at hlk; cases hlk; exact le_rfl)
        (fun l k' hl hln hlk => h.2 j l k k' (by omega) hln hs hlk) (by omega)

theorem srcFrom_range {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    SrcFrom src n (List.range n') 0 := by
  have := srcFrom_of_mono h 0 0 (Nat.zero_le _) (fun l k hl => absurd hl (Nat.not_lt_zero _))
    (fun _ _ _ _ _ => Nat.zero_le _)
  simpa using this

/-- **One block.** -/
theorem runC_ctlOf (m : ℕ) (g : ℤ → U → ℤ) {n n' : ℕ} {src : ℕ → Option ℕ}
    (hs : MonoSrc n n' src) (argOf : ℕ → ℤ) (B : List U) :
    runC m g (ctlOf n n' src argOf) B =
      (List.range n').flatMap fun l => slabZ B m (src l) (g (argOf l)) := by
  have h := runC_ctlAux m g src argOf n B (List.range n') 0
    (List.replicate (n - (ctlAux src argOf (List.range n') 0).2) dropC) (srcFrom_range hs)
  simp only [zero_mul, List.drop_zero] at h
  unfold ctlOf
  rw [h]
  have e := runC_drops m g (n - (ctlAux src argOf (List.range n') 0).2) []
    (List.drop ((ctlAux src argOf (List.range n') 0).2 * m) B)
  rw [List.append_nil] at e
  rw [e]
  simp [runC]

theorem nDrop_append (a b : List (ℤ × ℤ)) : nDrop (a ++ b) = nDrop a + nDrop b := by
  induction a with
  | nil => simp [nDrop]
  | cons x a ih => obtain ⟨op, _⟩ := x; simp only [List.cons_append, nDrop, ih]; omega

theorem nDrop_drops (j : ℕ) : nDrop (List.replicate j dropC) = j := by
  induction j with
  | zero => rfl
  | succ j ih =>
    rw [List.replicate_succ]
    show (if (-1 : ℤ) < 0 then 1 else 0) + nDrop (List.replicate j dropC) = j + 1
    rw [ih]; simp; omega

theorem nDrop_ctlAux (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), SrcFrom src n ls cur →
      cur + nDrop (ctlAux src argOf ls cur).1 = (ctlAux src argOf ls cur).2
  | [], cur, _ => by simp [ctlAux, nDrop]
  | l :: ls, cur, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs, nDrop, show ¬ (0 : ℤ) < 0 by norm_num, if_false, zero_add]
      exact nDrop_ctlAux src argOf n ls cur h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      simp only [ctlAux, hs, nDrop_append, nDrop_drops, nDrop,
        show ¬ (1 : ℤ) < 0 by norm_num, if_false, zero_add]
      have := nDrop_ctlAux src argOf n ls k h3
      omega

/-- **A block drops exactly its `n` slabs.** -/
theorem nDrop_ctlOf {n n' : ℕ} {src : ℕ → Option ℕ} (hs : MonoSrc n n' src) (argOf : ℕ → ℤ) :
    nDrop (ctlOf n n' src argOf) = n := by
  have h := nDrop_ctlAux src argOf n (List.range n') 0 (srcFrom_range hs)
  have hle := ctlAux_le src argOf n (List.range n') 0 (Nat.zero_le _) (srcFrom_range hs)
  unfold ctlOf
  rw [nDrop_append, nDrop_drops]
  omega

end cmd

/-! ## Slab passes as block outputs -/

section blocks
variable {U : Type*} [Inhabited U]

theorem slabZ_eq (B : List U) (m : ℕ) (src : Option ℕ) (h : U → ℤ) :
    slabZ B m src h = slabOf B m src h := by
  cases src <;> rfl

/-- **The pass is the concatenation of the block outputs.** -/
theorem slabPass_blocks (n n' m pre : ℕ) (hnm : 0 < n * m) (src : ℕ → Option ℕ)
    (g : ℤ → U → ℤ) (argOf : ℕ → ℤ) (xs : List U) (hxs : xs.length = pre * (n * m)) :
    slabPass n n' m src (fun l => g (argOf l)) xs =
      (List.range pre).flatMap fun i =>
        (List.range n').flatMap fun l =>
          slabZ ((xs.drop (i * (n * m))).take (n * m)) m (src l) (g (argOf l)) := by
  unfold slabPass
  rw [(chunk_blocks (n * m) pre hnm xs hxs).1, List.flatMap_map]
  apply List.flatMap_congr
  intro i _
  apply List.flatMap_congr
  intro l _
  rw [slabZ_eq]

end blocks

/-! ## Flattening -/

section flat
variable {α β γ δ : Type*} [Inhabited α] [Inhabited β] [Inhabited γ] [Inhabited δ]

theorem flatMap_replicate2 (ψ : β → List δ) (hψd : ψ default = [default, default]) (k : ℕ) :
    (List.replicate k (default : β)).flatMap ψ = List.replicate (2 * k) default := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [List.replicate_succ, List.flatMap_cons, ih, hψd, show 2 * (k + 1) = 2 * k + 1 + 1 by ring]
    simp [List.replicate_succ]

theorem flatMap_drop2 (φ : α → List γ) (hφ : ∀ x, (φ x).length = 2) (L : List α) (k : ℕ) :
    (L.drop k).flatMap φ = (L.flatMap φ).drop (2 * k) := by
  induction L generalizing k with
  | nil => simp
  | cons x L ih =>
    cases k with
    | zero => simp
    | succ k =>
      rw [List.drop_succ_cons, ih, List.flatMap_cons, show 2 * (k + 1) = 2 + 2 * k by ring,
        ← List.drop_drop, List.drop_left' (hφ x)]

theorem flatMap_take2 (φ : α → List γ) (hφ : ∀ x, (φ x).length = 2) (L : List α) (k : ℕ) :
    (L.take k).flatMap φ = (L.flatMap φ).take (2 * k) := by
  induction L generalizing k with
  | nil => simp
  | cons x L ih =>
    cases k with
    | zero => simp
    | succ k =>
      rw [List.take_succ_cons, List.flatMap_cons, List.flatMap_cons, ih,
        show 2 * (k + 1) = 2 + 2 * k by ring, List.take_append, hφ x,
        List.take_of_length_le (l := φ x) (by rw [hφ x]; omega), Nat.add_sub_cancel_left]

theorem length_flatMap2 (φ : α → List γ) (hφ : ∀ x, (φ x).length = 2) (L : List α) :
    (L.flatMap φ).length = 2 * L.length := by
  induction L with
  | nil => simp
  | cons x L ih => rw [List.flatMap_cons, List.length_append, ih, hφ]; simp; ring

/-- **Flattening commutes with slab passes.** -/
theorem flat_slabPass (φ : α → List γ) (hφ : ∀ x, (φ x).length = 2)
    (hd : φ default = [default, default]) (n n' post pre : ℕ) (hnp : 0 < n * post)
    (src : ℕ → Option ℕ) (h : ℕ → α → β) (ψ : β → List δ) (hψ : ∀ y, (ψ y).length = 2)
    (h' : ℕ → γ → δ) (hh : ∀ l x, ψ (h l x) = (φ x).map (h' l))
    (hψd : ψ default = [default, default]) (hd' : ∀ l, h' l default = default)
    (L : List α) (hL : L.length = pre * (n * post)) :
    (slabPass n n' post src h L).flatMap ψ = slabPass n n' (2 * post) src h' (L.flatMap φ) := by
  have hL2 : (L.flatMap φ).length = pre * (n * (2 * post)) := by
    rw [length_flatMap2 φ hφ, hL]; ring
  unfold slabPass
  rw [(chunk_blocks (n * post) pre hnp L hL).1,
    (chunk_blocks (n * (2 * post)) pre (by rw [show n * (2 * post) = 2 * (n * post) by ring]; omega)
      _ hL2).1, List.flatMap_map, List.flatMap_map, List.flatMap_assoc]
  apply List.flatMap_congr
  intro i _
  rw [List.flatMap_assoc]
  apply List.flatMap_congr
  intro l _
  unfold slabOf
  cases src l with
  | none =>
    simp only []
    exact flatMap_replicate2 ψ hψd post
  | some k =>
    simp only []
    have e1 : (List.map (h l) ((((L.drop (i * (n * post))).take (n * post)).drop (k * post)).take post)).flatMap ψ =
        (((((L.drop (i * (n * post))).take (n * post)).drop (k * post)).take post).flatMap φ).map (h' l) := by
      rw [List.flatMap_map, List.map_flatMap]
      exact List.flatMap_congr (fun x _ => hh l x)
    rw [e1, flatMap_take2 φ hφ, flatMap_drop2 φ hφ, flatMap_take2 φ hφ, flatMap_drop2 φ hφ]
    rw [show 2 * (i * (n * post)) = i * (n * (2 * post)) by ring,
      show 2 * (n * post) = n * (2 * post) by ring, show 2 * (k * post) = k * (2 * post) by ring]

end flat

/-! ## Splitting a command list; validity -/

section valid
variable {U : Type*}

theorem VC_append (n : ℕ) (a b : List (ℤ × ℤ)) (d : ℕ) (ha : VC n a d) (hb : VC n b (d + nDrop a)) :
    VC n (a ++ b) d := by
  induction a generalizing d with
  | nil => simpa [nDrop] using hb
  | cons x a ih =>
    obtain ⟨op, c⟩ := x
    simp only [List.cons_append, VC, nDrop] at ha hb ⊢
    refine ⟨ha.1, ih _ ha.2 ?_⟩
    rw [Nat.add_assoc]; exact hb

theorem VC_drops (n j d : ℕ) (h : d + j ≤ n) : VC n (List.replicate j dropC) d := by
  induction j generalizing d with
  | zero => trivial
  | succ j ih =>
    rw [List.replicate_succ]
    simp only [VC, dropC, show (-1 : ℤ) < 0 by norm_num, if_true]
    exact ⟨fun _ => by omega, ih _ (by omega)⟩

theorem VC_ctlAux (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), SrcFrom src n ls cur → VC n (ctlAux src argOf ls cur).1 cur
  | [], cur, _ => by simp [ctlAux, VC]
  | l :: ls, cur, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs, VC, ne_eq, not_true_eq_false, false_implies, true_and,
        show ¬ (0 : ℤ) < 0 by norm_num, if_false, Nat.add_zero]
      exact VC_ctlAux src argOf n ls cur h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      simp only [ctlAux, hs]
      refine VC_append n _ _ cur (VC_drops n _ cur (by omega)) ?_
      rw [nDrop_drops]
      simp only [VC, show ¬ (1 : ℤ) < 0 by norm_num, if_false, Nat.add_zero]
      refine ⟨fun _ => by omega, ?_⟩
      rw [show cur + (k - cur) = k by omega]
      exact VC_ctlAux src argOf n ls k h3

theorem VC_ctlOf {n n' : ℕ} {src : ℕ → Option ℕ} (hs : MonoSrc n n' src) (argOf : ℕ → ℤ) :
    VC n (ctlOf n n' src argOf) 0 := by
  have h := nDrop_ctlAux src argOf n (List.range n') 0 (srcFrom_range hs)
  have hle := ctlAux_le src argOf n (List.range n') 0 (Nat.zero_le _) (srcFrom_range hs)
  unfold ctlOf
  refine VC_append n _ _ 0 (VC_ctlAux src argOf n _ 0 (srcFrom_range hs)) ?_
  exact VC_drops n _ _ (by omega)

end valid

end J6Seg

end

