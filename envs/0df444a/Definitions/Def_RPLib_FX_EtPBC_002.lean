-- ===== S4.Def_RP_EtPBC_A_CovAs5d =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As5d): substitution data descend to a f.g. subalgebra

* `subst_map`: the four substitution memberships (`hu hv huv hvu` of `presIso`) push along any ring map.
* `mem_push`, `gmap_tiC_bcC`, `gmap_tvC_bcC`: bookkeeping for `tiC`, `tvC`, `bcC`.
* **`desc_subst`**: substitution data `uC vC` between square systems `G₀ G₁` over `C₀ ⊗ B` whose memberships hold
  over `S ⊗ B` (after `tvC`) already satisfy them over `C ⊗ B` for a f.g. `C ≥ C₀` (two `desc_mem` calls, joined
  at `C₁ ⊔ C₂`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section SubstMap

variable {P P' : Type u} [CommRing P] [CommRing P'] {r r' : ℕ}

/-- The substitution memberships push along a ring map. -/
theorem subst_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (hu : ∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g))
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g'))
    (huv : ∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g))
    (hvu : ∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g')) :
    (∀ j, MvPolynomial.bind₁ (fun k => MvPolynomial.map f (u k)) (gmap f g' j) ∈
      Ideal.span (Set.range (gmap f g))) ∧
    (∀ i, MvPolynomial.bind₁ (fun k => MvPolynomial.map f (v k)) (gmap f g i) ∈
      Ideal.span (Set.range (gmap f g'))) ∧
    (∀ i, MvPolynomial.bind₁ (fun k => MvPolynomial.map f (u k)) (MvPolynomial.map f (v i)) -
      MvPolynomial.X i ∈ Ideal.span (Set.range (gmap f g))) ∧
    (∀ j, MvPolynomial.bind₁ (fun k => MvPolynomial.map f (v k)) (MvPolynomial.map f (u j)) -
      MvPolynomial.X j ∈ Ideal.span (Set.range (gmap f g'))) := by
  refine ⟨fun j => ?_, fun i => ?_, fun i => ?_, fun j => ?_⟩
  · have e := span_map_mem f g (hu j)
    rw [MvPolynomial.map_bind₁] at e
    exact e
  · have e := span_map_mem f g' (hv i)
    rw [MvPolynomial.map_bind₁] at e
    exact e
  · have e := span_map_mem f g (huv i)
    rw [map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at e
    exact e
  · have e := span_map_mem f g' (hvu j)
    rw [map_sub, MvPolynomial.map_bind₁, MvPolynomial.map_X] at e
    exact e

end SubstMap

section Desc

end Desc

section BCg

end BCg

end RamanujanPetersson.EtPBC.Cov

end

