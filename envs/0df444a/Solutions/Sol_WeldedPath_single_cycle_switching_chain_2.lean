section
namespace WeldedPath.SingleCycleCounting

open Classical SingleCyclePorts SingleCycleCount

set_option maxHeartbeats 800000

noncomputable def pairResidual {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges) :
    Finset G.weld := Finset.univ.filter fun p => (pairEdge G p).1 ∈ R

noncomputable def residualPairEquiv {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) : R ≃ pairResidual G R where
  toFun e := ⟨(pairEquiv G).symm ⟨e.1, hR e.1 e.2⟩, by
    simp only [pairResidual, Finset.mem_filter, Finset.mem_univ, true_and]
    have h := congrArg Subtype.val ((pairEquiv G).apply_symm_apply ⟨e.1, hR e.1 e.2⟩)
    change (pairEdge G ((pairEquiv G).symm ⟨e.1, hR e.1 e.2⟩)).1 = e.1 at h
    rw [h]
    exact e.2⟩
  invFun p := ⟨(pairEdge G p.1).1, (Finset.mem_filter.mp p.2).2⟩
  left_inv e := by
    classical
    apply Subtype.ext
    exact congrArg (fun x : WeldEdge G => x.1)
      ((pairEquiv G).apply_symm_apply ⟨e.1, hR e.1 e.2⟩)
  right_inv p := by
    classical
    apply Subtype.ext
    exact (pairEquiv G).symm_apply_apply p.1

theorem residualPairEquiv_val {n : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) (e : R) :
    (pairEdge G (residualPairEquiv G R hR e).1).1 = e.1 := by
  classical
  exact congrArg Subtype.val ((residualPairEquiv G R hR).symm_apply_apply e)

theorem residual_weldPerm {n l : ℕ} (G : WeldedInstance n) (R : Finset G.edges)
    (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges) (π₀ : Equiv.Perm G.edges)
    (hπ₀ : G.IsEdgePerm l π₀) (θ : Equiv.Perm R)
    (hθ : G.IsEdgePerm l (residualLift R π₀ θ)) :
    weldPerm G (residualLift R π₀ θ) hθ =
      residualPerm (weldPerm G π₀ hπ₀) (pairResidual G R)
        (transportPerm (residualPairEquiv G R hR) θ) := by
  classical
  let t := residualPairEquiv G R hR
  apply Equiv.ext
  intro p
  apply (pairEdge_bijective G).1
  apply Subtype.ext
  rw [pair_weldPerm]
  by_cases hp : p ∈ pairResidual G R
  · let u : pairResidual G R := ⟨p, hp⟩
    let e : R := t.symm u
    have he : (pairEdge G p).1 = e.1 := rfl
    have ht : t e = u := t.apply_symm_apply u
    rw [he, residualLift_on]
    rw [residualPerm_apply_mem _ _ _ u, pair_weldPerm]
    have htθ : transportPerm t θ u = t (θ e) := by
      classical
      rw [← ht, transportPerm_apply]
    rw [htθ, residualPairEquiv_val]
  · have hpR : (pairEdge G p).1 ∉ R := by
      classical
      simpa only [pairResidual, Finset.mem_filter, Finset.mem_univ, true_and] using hp
    rw [residualLift_off R π₀ θ hpR, residualPerm_apply_other _ _ _ p hp,
      pair_weldPerm]

theorem residual_singleCycle_cap {n l : ℕ} (G : WeldedInstance n) (hG : G.IsWeld)
    (R : Finset G.edges) (hR : ∀ e ∈ R, e.1 ∈ G.weldEdges)
    (π₀ : Equiv.Perm G.edges) (hπ₀ : G.IsEdgePerm l π₀) (hcycle : G.SingleCycle π₀)
    (hpres : ∀ θ : Equiv.Perm R, G.IsEdgePerm l (residualLift R π₀ θ))
    (C : Finset (Equiv.Perm G.edges))
    (hC : ∀ θ : Equiv.Perm R,
      residualLift R π₀ θ ∈ C ↔ G.SingleCycle (residualLift R π₀ θ))
    (u : R) (z : G.edges) :
    (R.card - 1) * (((C.filter fun π => ∀ e ∉ R, π e = π₀ e).filter
      fun π => π u.1 = z).card) ≤
      (C.filter fun π => ∀ e ∉ R, π e = π₀ e).card := by
  classical
  let U := pairResidual G R
  let t : R ≃ U := residualPairEquiv G R hR
  let σ := weldPerm G π₀ hπ₀
  let K := cutGraph hG σ U
  let a : U → K.ConnectedComponent := fun e => K.connectedComponentMk (.inl e.1)
  let b : U → K.ConnectedComponent := fun e => K.connectedComponentMk (.inr (σ e.1))
  have hU : U.Nonempty := ⟨(t u).1, (t u).2⟩
  have hconn : (portGraph hG σ).Preconnected :=
    (port_preconnected_iff G hG π₀ hπ₀).mpr hcycle
  have hports (c : K.ConnectedComponent) :
      (Finset.univ.filter (fun i : R => a (t i) = c)).card +
      (Finset.univ.filter (fun i : R => b (t i) = c)).card = 2 := by
    classical
    rw [filter_card_equiv t (fun i => a i = c), filter_card_equiv t (fun i => b i = c)]
    exact cut_two_port_fibers hG σ hconn U hU c
  apply residual_completion_cap C R π₀ (fun i => a (t i)) (fun i => b (t i))
    hports ?_ u z
  intro θ
  rw [hC, ← port_preconnected_iff G hG _ (hpres θ),
    residual_weldPerm G R hR π₀ hπ₀ θ (hpres θ), residual_preconnected_iff]
  rw [mem_completionSet, matchingGraph_transport t (⊥ : SimpleGraph K.ConnectedComponent) a b θ]

end WeldedPath.SingleCycleCounting
end
-- END Solutions.SingleCycleCountWeldedPorts

-- BEGIN Solutions.SingleCycleCountWelded
section
namespace WeldedPath

open Classical FinitePermutationCoupling SingleCycleCounting SwitchingModel

set_option maxHeartbeats 800000

theorem single_cycle_completion_count_full :
    ∀ n l : ℕ, Even n → 2 ≤ l → l ≤ n - 4 →
    ∀ G : WeldedInstance n, G.IsValid →
    ∀ (D : Finset G.edges) (h : Equiv.Perm G.edges) (e z : G.edges),
      e.1 ∈ G.weldEdges → e ∉ D →
      (((Finset.univ.filter fun f : G.edges =>
          f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) \ D).card - 1) *
        ((exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).filter
            fun π => π e = z).card ≤
        (exposedFiber
          ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h).card := by
  classical
  intro n l _ _ _ G hG D h e z he heD
  let R := (Finset.univ.filter fun f : G.edges =>
    f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) \ D
  let C := exposedFiber
    ((Finset.univ.filter (G.IsEdgePerm l)).filter G.SingleCycle) D h
  have hmemR (f : G.edges) : f ∈ R ↔
      (f.1 ∈ G.weldEdges ∧ G.color f.1 = G.color e.1) ∧ f ∉ D := by
    simp only [R, Finset.mem_sdiff, Finset.mem_filter, Finset.mem_univ, true_and]
  have heR : e ∈ R := (hmemR e).mpr ⟨⟨he, rfl⟩, heD⟩
  have hR (f : G.edges) (hf : f ∈ R) : f.1 ∈ G.weldEdges := ((hmemR f).mp hf).1.1
  have hRblock (f : G.edges) (hf : f ∈ R) (g : G.edges) (hg : g ∈ R) :
      block l G f = block l G g := by
    rw [block_of_weld l G f (hR f hf), block_of_weld l G g (hR g hg),
      ((hmemR f).mp hf).1.2, ((hmemR g).mp hg).1.2]
  apply residual_partition_cap C R e z (R.card - 1)
  intro π₀ hπ₀
  have hπ₀' : (G.IsEdgePerm l π₀ ∧ G.SingleCycle π₀) ∧
      ∀ f ∈ D, π₀ f = h f := by
    simpa only [C, exposedFiber, Finset.mem_filter, Finset.mem_univ, true_and] using hπ₀
  have hblock : π₀ ∈ blockSupport (block l G) := by
    rw [blockSupport_eq]
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hπ₀'.1.1⟩
  have hpres (θ : Equiv.Perm R) : G.IsEdgePerm l (residualLift R π₀ θ) := by
    have hh := residualLift_preserves_block (block l G) R hRblock π₀ hblock θ
    rw [blockSupport_eq] at hh
    exact (Finset.mem_filter.mp hh).2
  have hrecords (θ : Equiv.Perm R) : ∀ f ∈ D, residualLift R π₀ θ f = h f := by
    intro f hf
    have hfR : f ∉ R := fun hfr => ((hmemR f).mp hfr).2 hf
    rw [residualLift_off R π₀ θ hfR]
    exact hπ₀'.2 f hf
  apply residual_singleCycle_cap G hG.1 R hR π₀ hπ₀'.1.1 hπ₀'.1.2 hpres C ?_ ⟨e, heR⟩ z
  intro θ
  simp only [C, exposedFiber, Finset.mem_filter, Finset.mem_univ, true_and,
    hpres θ]
  constructor
  · exact And.left
  · intro hc
    exact ⟨hc, hrecords θ⟩

end WeldedPath
end
-- END Solutions.SingleCycleCountWelded

-- BEGIN Solutions.WeldedPathWeldClasses
section
namespace WeldedPath.WeldClasses

open Classical LoopProof

theorem mem_weld_class {n l : ℕ} {G : WeldedInstance n} (α : Fin 3) (e : Edge) :
    e ∈ G.classEdges l (.wld α) ↔ e ∈ G.weldEdges ∧ G.color e = α := by
  cases e with
  | tree v =>
    by_cases h : n - l ≤ col n v ∧ col n v ≤ n + l <;>
      simp [WeldedInstance.classEdges, WeldedInstance.bEdge, WeldedInstance.weldEdges, h]
  | weld u w =>
    simp [WeldedInstance.classEdges, WeldedInstance.bEdge, WeldedInstance.edges,
      WeldedInstance.treeEdges, WeldedInstance.weldEdges]

theorem weld_classes_disjoint {n l : ℕ} (G : WeldedInstance n) {α β : Fin 3}
    (h : α ≠ β) : Disjoint (G.classEdges l (.wld α)) (G.classEdges l (.wld β)) := by
  apply Finset.disjoint_left.mpr
  intro e he he'
  exact h (((mem_weld_class α e).mp he).2.symm.trans ((mem_weld_class β e).mp he').2)

theorem tail_injective {n l : ℕ} {G : WeldedInstance n} (hG : G.IsProperColoring)
    (α : Fin 3) : Set.InjOn Edge.tail (G.classEdges l (.wld α)) := by
  intro e he e' he' htail
  by_contra hne
  have hc := hG e (Finset.mem_filter.mp he).1 e' (Finset.mem_filter.mp he').1 hne
    ⟨e.tail, Or.inl rfl, Or.inl htail⟩
  exact hc (((mem_weld_class α e).mp he).2.trans ((mem_weld_class α e').mp he').2.symm)

theorem head_injective {n l : ℕ} {G : WeldedInstance n} (hG : G.IsProperColoring)
    (α : Fin 3) : Set.InjOn (Edge.head n) (G.classEdges l (.wld α)) := by
  intro e he e' he' hhead
  by_contra hne
  have hc := hG e (Finset.mem_filter.mp he).1 e' (Finset.mem_filter.mp he').1 hne
    ⟨e.head n, Or.inr rfl, Or.inr hhead⟩
  exact hc (((mem_weld_class α e).mp he).2.trans ((mem_weld_class α e').mp he').2.symm)

theorem left_leaf_bounds {n v : ℕ} (hv : IsVertex n v) (hc : col n v = n) :
    2 ^ n - 1 ≤ v ∧ v < 2 ^ (n + 1) - 1 := by
  have hleft : v < 2 ^ (n + 1) - 1 := by
    by_contra h
    have hh := col_right_ge n v hv (by omega)
    omega
  have hlog : Nat.log 2 (v + 1) = n := by simpa [col, hleft] using hc
  have hh := Nat.pow_log_le_self 2 (by omega : v + 1 ≠ 0)
  rw [hlog] at hh
  exact ⟨by omega, hleft⟩

theorem left_leaf_of_bounds {n v : ℕ} (hn : 1 ≤ n)
    (hlo : 2 ^ n - 1 ≤ v) (hhi : v < 2 ^ (n + 1) - 1) :
    IsVertex n v ∧ col n v = n ∧ parent n v = some ((v - 1) / 2) := by
  have hpow := Nat.two_pow_pos n
  have hroot := pow_root_ge_two n
  have hv : IsVertex n v := by
    rw [IsVertex, numV_eq]
    omega
  have hc : col n v = n := by
    rw [col, if_pos hhi]
    exact Nat.log_eq_of_pow_le_of_lt_pow (by omega) (by omega)
  refine ⟨hv, hc, ?_⟩
  simp [parent, hv, hc, hn]

theorem weld_class_tail_bounds {n l : ℕ} {G : WeldedInstance n} (hG : G.IsWeld)
    {α : Fin 3} {e : Edge} (he : e ∈ G.classEdges l (.wld α)) :
    2 ^ n - 1 ≤ e.tail ∧ e.tail < 2 ^ (n + 1) - 1 := by
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp ((mem_weld_class α e).mp he).1
  have hh := hG.1 p hp
  exact left_leaf_bounds hh.1 hh.2.1

theorem weld_class_card_le {n l : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    (α : Fin 3) : (G.classEdges l (.wld α)).card ≤ 2 ^ n := by
  have hh := Finset.card_le_card_of_injOn Edge.tail
    (s := G.classEdges l (.wld α)) (t := Finset.Ico (2 ^ n - 1) (2 ^ (n + 1) - 1))
    (fun e he => Finset.mem_Ico.mpr (weld_class_tail_bounds hG.1 he))
    (tail_injective hG.2 α)
  have hp := Nat.two_pow_pos n
  have hcard : (Finset.Ico (2 ^ n - 1) (2 ^ (n + 1) - 1)).card = 2 ^ n := by
    rw [Nat.card_Ico, pow_succ]
    omega
  simpa only [hcard] using hh

private theorem three_colors_cover (a b c d : Fin 3) (hab : a ≠ b) (hac : a ≠ c)
    (hbc : b ≠ c) : d = a ∨ d = b ∨ d = c := by
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> simp_all

theorem weld_color_at_leaf {n l v : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    (hn : 1 ≤ n) (hv : IsVertex n v) (hc : col n v = n) (α : Fin 3)
    (htc : G.color (.tree v) ≠ α) :
    ∃ e ∈ G.classEdges l (.wld α), e.tail = v := by
  have hbounds := left_leaf_bounds hv hc
  have hpv := (left_leaf_of_bounds hn hbounds.1 hbounds.2).2.2
  have ht : Edge.tree v ∈ G.edges := tree_mem_iff.mpr ⟨hv, by simp [hpv]⟩
  obtain ⟨p, q, hpq, hs⟩ := Finset.card_eq_two.mp (hG.1.2.1 v ⟨hv, Or.inl hc⟩)
  have hp : p ∈ G.weld ∧ (p.1 = v ∨ p.2 = v) := by
    apply Finset.mem_filter.mp
    rw [hs]
    simp
  have hq : q ∈ G.weld ∧ (q.1 = v ∨ q.2 = v) := by
    apply Finset.mem_filter.mp
    rw [hs]
    simp
  have hpt : p.1 = v := by
    rcases hp.2 with h | h
    · exact h
    · have hh := (hG.1.1 p hp.1).2.2.2
      rw [h, hc] at hh
      omega
  have hqt : q.1 = v := by
    rcases hq.2 with h | h
    · exact h
    · have hh := (hG.1.1 q hq.1).2.2.2
      rw [h, hc] at hh
      omega
  have hep : Edge.weld p.1 p.2 ∈ G.edges := weld_mem_iff.mpr hp.1
  have heq : Edge.weld q.1 q.2 ∈ G.edges := weld_mem_iff.mpr hq.1
  have htp := hG.2 (.tree v) ht (.weld p.1 p.2) hep (by simp)
    ⟨v, Or.inl rfl, Or.inl hpt.symm⟩
  have htq := hG.2 (.tree v) ht (.weld q.1 q.2) heq (by simp)
    ⟨v, Or.inl rfl, Or.inl hqt.symm⟩
  have hpq' : Edge.weld p.1 p.2 ≠ Edge.weld q.1 q.2 := by
    intro h
    exact hpq (Prod.ext (congrArg Edge.tail h) (congrArg (Edge.head n) h))
  have hpqc := hG.2 (.weld p.1 p.2) hep (.weld q.1 q.2) heq hpq'
    ⟨v, Or.inl hpt.symm, Or.inl hqt.symm⟩
  rcases three_colors_cover (G.color (.tree v)) (G.color (.weld p.1 p.2))
      (G.color (.weld q.1 q.2)) α htp htq hpqc with h | h | h
  · exact (htc h.symm).elim
  · refine ⟨.weld p.1 p.2, (mem_weld_class α _).mpr ⟨?_, h.symm⟩, hpt⟩
    exact Finset.mem_image.mpr ⟨p, hp.1, rfl⟩
  · refine ⟨.weld q.1 q.2, (mem_weld_class α _).mpr ⟨?_, h.symm⟩, hqt⟩
    exact Finset.mem_image.mpr ⟨q, hq.1, rfl⟩

theorem weld_class_card_ge {n l : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    (hn : 1 ≤ n) (α : Fin 3) : 2 ^ (n - 1) ≤ (G.classEdges l (.wld α)).card := by
  have hpow : 2 ^ n = 2 * 2 ^ (n - 1) := by
    calc
      2 ^ n = 2 ^ ((n - 1) + 1) := congrArg (2 ^ ·) (by omega)
      _ = 2 * 2 ^ (n - 1) := by rw [pow_succ, Nat.mul_comm]
  have hpow' : 2 ^ (n + 1) = 2 * 2 ^ n := by rw [pow_succ, Nat.mul_comm]
  have hpos := Nat.two_pow_pos (n - 1)
  have hpairs (j : Fin (2 ^ (n - 1))) :
      ∃ e ∈ G.classEdges l (.wld α),
        e.tail = 2 ^ n - 1 + 2 * j.val ∨ e.tail = 2 ^ n - 1 + 2 * j.val + 1 := by
    let u := 2 ^ n - 1 + 2 * j.val
    have hj := j.isLt
    have hu := left_leaf_of_bounds (v := u) hn (by dsimp [u]; omega)
      (by dsimp [u]; omega)
    have hu' := left_leaf_of_bounds (v := u + 1) hn (by dsimp [u]; omega)
      (by dsimp [u]; omega)
    have ht : Edge.tree u ∈ G.edges := tree_mem_iff.mpr ⟨hu.1, by simp [hu.2.2]⟩
    have ht' : Edge.tree (u + 1) ∈ G.edges := tree_mem_iff.mpr ⟨hu'.1, by simp [hu'.2.2]⟩
    have hparent : (u - 1) / 2 = u / 2 := by dsimp [u]; omega
    have hcolors : G.color (.tree u) ≠ G.color (.tree (u + 1)) := by
      apply hG.2 (.tree u) ht (.tree (u + 1)) ht' (by simp)
      refine ⟨(u - 1) / 2, Or.inr ?_, Or.inr ?_⟩
      · simp [Edge.head, hu.2.2]
      · simp [Edge.head, hu'.2.2, hparent]
    by_cases hcu : G.color (.tree u) ≠ α
    · obtain ⟨e, he, htail⟩ := weld_color_at_leaf hG hn hu.1 hu.2.1 α hcu
      exact ⟨e, he, Or.inl htail⟩
    · have hcu' : G.color (.tree (u + 1)) ≠ α := by
        intro h
        exact hcolors ((not_ne_iff.mp hcu).trans h.symm)
      obtain ⟨e, he, htail⟩ := weld_color_at_leaf hG hn hu'.1 hu'.2.1 α hcu'
      exact ⟨e, he, Or.inr htail⟩
  choose f hf using hpairs
  let F : Fin (2 ^ (n - 1)) → G.classEdges l (.wld α) := fun j => ⟨f j, (hf j).1⟩
  have hinj : Function.Injective F := by
    intro j k h
    have heq : f j = f k := congrArg Subtype.val h
    have ht := congrArg Edge.tail heq
    rcases (hf j).2 with hj | hj <;> rcases (hf k).2 with hk | hk <;>
      apply Fin.ext <;> omega
  simpa only [Fintype.card_fin, Fintype.card_coe] using Fintype.card_le_of_injective F hinj

theorem weld_class_card_bounds {n l : ℕ} {G : WeldedInstance n} (hG : G.IsValid)
    (hn : 1 ≤ n) (α : Fin 3) :
    2 ^ (n - 1) ≤ (G.classEdges l (.wld α)).card ∧
      (G.classEdges l (.wld α)).card ≤ 2 ^ n :=
  ⟨weld_class_card_ge hG hn α, weld_class_card_le hG α⟩

end WeldedPath.WeldClasses
end
