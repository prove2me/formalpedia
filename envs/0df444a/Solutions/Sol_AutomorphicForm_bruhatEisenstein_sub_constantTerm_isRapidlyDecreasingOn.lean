section LevelMap

variable {F}
variable (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥)

private def sgen : 𝓞 F := (Submodule.exists_mem_ne_zero_of_ne_bot h𝔫).choose

omit [NumberField F] in
private theorem sgen_mem : sgen 𝔫 h𝔫 ∈ 𝔫 := (Submodule.exists_mem_ne_zero_of_ne_bot h𝔫).choose_spec.1

omit [NumberField F] in
private theorem sgen_ne_zero : sgen 𝔫 h𝔫 ≠ 0 := (Submodule.exists_mem_ne_zero_of_ne_bot h𝔫).choose_spec.2

private def IsCorr (t : 𝔸) (k : F) : Prop :=
  ∃ o ∈ integralFiniteAdeles (𝓞 F) F, t.2 - ιf k = ιf (sgen 𝔫 h𝔫 : F) * o

private theorem exists_isCorr (t : 𝔸) : ∃ k : F, IsCorr 𝔫 h𝔫 t k :=
  exists_sub_eq_mul' (sgen_ne_zero 𝔫 h𝔫) t.2

private theorem fst_algebraMap (k : F) : (ι k).1 = algebraMap F (InfiniteAdeleRing F) k := by
  rw [algebraMap_eq_mkAdele, fst_mkAdele]

private theorem snd_algebraMap (k : F) : (ι k).2 = ιf k := by
  rw [algebraMap_eq_mkAdele]; rfl

private theorem isCorr_unique {t : 𝔸} {k k' : F} (hk : IsCorr 𝔫 h𝔫 t k) (hk' : IsCorr 𝔫 h𝔫 t k') :
    adelicTorusMap F 𝔫 h𝔫 (t - ι k).1 = adelicTorusMap F 𝔫 h𝔫 (t - ι k').1 := by
  obtain ⟨o, ho, he⟩ := hk
  obtain ⟨o', ho', he'⟩ := hk'
  have hdiff : ιf (k' - k) = ιf (sgen 𝔫 h𝔫 : F) * (o - o') := by
    rw [map_sub, mul_sub, ← he, ← he']; abel
  have hmem : o - o' ∈ integralFiniteAdeles (𝓞 F) F := fun v => sub_mem (ho v) (ho' v)
  obtain ⟨a, ha⟩ := exists_eq_mul_coe (sgen_ne_zero 𝔫 h𝔫) hmem hdiff
  rw [← sub_eq_zero, ← map_sub, adelicTorusMap_eq_zero_iff]
  refine ⟨a * sgen 𝔫 h𝔫, Ideal.mul_mem_left _ _ (sgen_mem 𝔫 h𝔫), ?_⟩
  have e1 : (t - ι k).1 - (t - ι k').1 = algebraMap F (InfiniteAdeleRing F) (k' - k) := by
    rw [← fst_algebraMap, map_sub, adele_fst_sub, adele_fst_sub, adele_fst_sub]
    abel
  have e2 : ((a * sgen 𝔫 h𝔫 : 𝓞 F) : F) = k' - k := by
    rw [ha]
    push_cast
    ring
  rw [e1, e2]

private theorem isCorr_add {t t' : 𝔸} {k k' : F} (hk : IsCorr 𝔫 h𝔫 t k) (hk' : IsCorr 𝔫 h𝔫 t' k') :
    IsCorr 𝔫 h𝔫 (t + t') (k + k') := by
  obtain ⟨o, ho, he⟩ := hk
  obtain ⟨o', ho', he'⟩ := hk'
  have hmem : o + o' ∈ integralFiniteAdeles (𝓞 F) F := fun v => add_mem (ho v) (ho' v)
  exact ⟨o + o', hmem, by rw [adele_snd_add, map_add, mul_add, ← he, ← he']; abel⟩

private def levelTorusFun (t : 𝔸) : UnitAddTorus (LevelIndex F 𝔫 h𝔫) :=
  adelicTorusMap F 𝔫 h𝔫 (t - ι (exists_isCorr 𝔫 h𝔫 t).choose).1

private theorem levelTorusFun_eq {t : 𝔸} {k : F} (hk : IsCorr 𝔫 h𝔫 t k) :
    levelTorusFun 𝔫 h𝔫 t = adelicTorusMap F 𝔫 h𝔫 (t - ι k).1 :=
  isCorr_unique 𝔫 h𝔫 (exists_isCorr 𝔫 h𝔫 t).choose_spec hk

private theorem isCorr_zero : IsCorr 𝔫 h𝔫 (0 : 𝔸) 0 :=
  ⟨0, fun v => (v.adicCompletionIntegers F).zero_mem, by rw [adele_snd_zero, map_zero, sub_zero, mul_zero]⟩

private def levelTorusMap : 𝔸 →+ UnitAddTorus (LevelIndex F 𝔫 h𝔫) where
  toFun := levelTorusFun 𝔫 h𝔫
  map_zero' := by rw [levelTorusFun_eq 𝔫 h𝔫 (isCorr_zero 𝔫 h𝔫), map_zero, sub_zero, adele_fst_zero, map_zero]
  map_add' t t' := by
    rw [levelTorusFun_eq 𝔫 h𝔫 (isCorr_add 𝔫 h𝔫 (exists_isCorr 𝔫 h𝔫 t).choose_spec (exists_isCorr 𝔫 h𝔫 t').choose_spec),
      levelTorusFun, levelTorusFun, ← map_add]
    congr 1
    rw [map_add, adele_fst_sub, adele_fst_sub, adele_fst_sub, adele_fst_add, adele_fst_add]
    abel

private theorem levelTorusMap_apply_eq {t : 𝔸} {k : F} (hk : IsCorr 𝔫 h𝔫 t k) :
    levelTorusMap 𝔫 h𝔫 t = adelicTorusMap F 𝔫 h𝔫 (t - ι k).1 :=
  levelTorusFun_eq 𝔫 h𝔫 hk

private theorem levelTorusMap_mkAdele (y : InfiniteAdeleRing F) {u o : FiniteAdeleRing (𝓞 F) F}
    (ho : o ∈ integralFiniteAdeles (𝓞 F) F) (hu : u = ιf (sgen 𝔫 h𝔫 : F) * o) :
    levelTorusMap 𝔫 h𝔫 (mkAdele F y u) = adelicTorusMap F 𝔫 h𝔫 y := by
  have hc : IsCorr 𝔫 h𝔫 (mkAdele F y u) 0 := ⟨o, ho, by rw [snd_mkAdele, map_zero, sub_zero, hu]⟩
  rw [levelTorusMap_apply_eq 𝔫 h𝔫 hc, map_zero, sub_zero, fst_mkAdele]

private theorem zero_mem_integralFiniteAdeles' : (0 : FiniteAdeleRing (𝓞 F) F) ∈ integralFiniteAdeles (𝓞 F) F :=
  fun v => (v.adicCompletionIntegers F).zero_mem

private theorem levelTorusMap_mkAdele_zero (y : InfiniteAdeleRing F) :
    levelTorusMap 𝔫 h𝔫 (mkAdele F y 0) = adelicTorusMap F 𝔫 h𝔫 y :=
  levelTorusMap_mkAdele 𝔫 h𝔫 y zero_mem_integralFiniteAdeles' (by rw [mul_zero])

private theorem levelTorusMap_algebraMap_add (k : F) (t : 𝔸) : levelTorusMap 𝔫 h𝔫 (ι k + t) = levelTorusMap 𝔫 h𝔫 t := by
  obtain ⟨c, o, ho, he⟩ := exists_isCorr 𝔫 h𝔫 t
  have hc' : IsCorr 𝔫 h𝔫 (ι k + t) (c + k) :=
    ⟨o, ho, by rw [adele_snd_add, snd_algebraMap, map_add, ← he]; abel⟩
  rw [levelTorusMap_apply_eq 𝔫 h𝔫 hc', levelTorusMap_apply_eq 𝔫 h𝔫 ⟨o, ho, he⟩]
  congr 1
  rw [map_add, adele_fst_sub, adele_fst_sub, adele_fst_add, adele_fst_add]
  abel

private theorem levelTorusMap_surjective : Surjective (levelTorusMap 𝔫 h𝔫) := fun θ => by
  obtain ⟨y, hy⟩ := adelicTorusMap_surjective F 𝔫 h𝔫 θ
  exact ⟨mkAdele F y 0, by rw [levelTorusMap_mkAdele_zero, hy]⟩

private theorem continuous_levelTorusMap : Continuous (levelTorusMap 𝔫 h𝔫) := by
  apply continuous_of_continuousAt_zero (levelTorusMap 𝔫 h𝔫)
  obtain ⟨w, hw⟩ : IsUnit (ιf (sgen 𝔫 h𝔫 : F)) :=
    (IsUnit.mk0 (sgen 𝔫 h𝔫 : F) (by exact_mod_cast sgen_ne_zero 𝔫 h𝔫)).map _
  set W : Set 𝔸 := Prod.snd ⁻¹' ((fun u : FiniteAdeleRing (𝓞 F) F => (↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) * u) ⁻¹'
    integralFiniteAdeles (𝓞 F) F) with hW
  have hWo : IsOpen W :=
    ((isOpen_integralFiniteAdeles F).preimage (continuous_const.mul continuous_id)).preimage continuous_snd
  have h0 : (0 : 𝔸) ∈ W := by
    show (↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) * (0 : 𝔸).2 ∈ integralFiniteAdeles (𝓞 F) F
    rw [adele_snd_zero, mul_zero]
    exact fun v => (v.adicCompletionIntegers F).zero_mem
  have heq : ∀ t ∈ W, levelTorusMap 𝔫 h𝔫 t = adelicTorusMap F 𝔫 h𝔫 t.1 := fun t ht => by
    have hmem : (↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) * t.2 ∈ integralFiniteAdeles (𝓞 F) F := ht
    have hc : IsCorr 𝔫 h𝔫 t 0 :=
      ⟨(↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) * t.2, hmem, by rw [map_zero, sub_zero, ← mul_assoc, ← hw, Units.mul_inv, one_mul]⟩
    rw [levelTorusMap_apply_eq 𝔫 h𝔫 hc, map_zero, sub_zero]
  refine (((isOpenQuotientMap_adelicTorusMap F 𝔫 h𝔫).continuous.comp continuous_fst).continuousAt).congr_of_eventuallyEq ?_
  exact Filter.eventually_of_mem (hWo.mem_nhds h0) heq

private theorem measurable_levelTorusMap : Measurable (levelTorusMap 𝔫 h𝔫) :=
  (continuous_levelTorusMap 𝔫 h𝔫).measurable

private theorem apply_eq_torusLift_levelTorusMap {h : 𝔸 → ℂ}
    (hF : ∀ (k : F) (t : 𝔸), h (ι k + t) = h t)
    (hU : ∀ n ∈ 𝔫, ∀ o ∈ integralFiniteAdeles (𝓞 F) F, ∀ t : 𝔸, h (t + mkAdele F 0 (ιf ((n : 𝓞 F) : F) * o)) = h t)
    (t : 𝔸) :
    h t = torusLift (adelicTorusMap F 𝔫 h𝔫) (adelicTorusMap_surjective F 𝔫 h𝔫) (archRestrict h) (levelTorusMap 𝔫 h𝔫 t) := by
  obtain ⟨c, o, ho, he⟩ := exists_isCorr 𝔫 h𝔫 t
  have hper : IsKerPeriodic (adelicTorusMap F 𝔫 h𝔫) (archRestrict h) := isKerPeriodic_archRestrict (h𝔫 := h𝔫) hF hU
  rw [levelTorusMap_apply_eq 𝔫 h𝔫 ⟨o, ho, he⟩, torusLift_apply _ hper]
  show h t = h (mkAdele F (t - ι c).1 0)
  have h1 : h t = h (t - ι c) := by
    conv_lhs => rw [show t = ι c + (t - ι c) by abel]
    exact hF c _
