-- title:
--   Finite generation from a finite homogeneous quotient
-- statement:
--   For positive rational variable weights, if a finite family of forms is homogeneous of one positive degree and its generated ideal has finite-dimensional quotient, then the polynomial ring is finite as a module over the algebra generated by those forms. The grading argument bounds the degrees needed for module generators and inducts on degree.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_homogeneous_quotient
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) Complex)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (hquot : Module.Finite Complex
      (MvPolynomial (Fin d) Complex ⧸ Ideal.span (Set.range p))) :
    Module.Finite (Algebra.adjoin Complex (Set.range p)) (MvPolynomial (Fin d) Complex) := by sorry
