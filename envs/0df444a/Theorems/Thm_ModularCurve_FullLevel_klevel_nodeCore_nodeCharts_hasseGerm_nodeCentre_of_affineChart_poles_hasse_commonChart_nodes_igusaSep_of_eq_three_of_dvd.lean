theorem ModularCurve.FullLevel.klevel_nodeCore_nodeCharts_hasseGerm_nodeCentre_of_affineChart_poles_hasse_commonChart_nodes_igusaSep_of_eq_three_of_dvd
    (q : ℕ) [Fact q.Prime] (hq3 : q = 3) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (ℓg : ℕ) (hℓg : ℓg.Prime) (hℓg12 : ℓg % 12 = 11) (hℓgM' : ℓg ∣ M')
