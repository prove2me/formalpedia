-- title:
--   A multiplicative lift GL₂(mathbb F₃)toGL₂(ℤ[√-2])
-- statement:
--   Write $\mathrm{red}\colon\mathbb Z[\sqrt{-2}]\to\mathbb Z/3$ for the ring homomorphism determined by $\sqrt{-2}\mapsto -1$ (legitimate since $(-1)^2=-2$ in $\mathbb Z/3$), and let $S=\begin{pmatrix}-1&1\\-1&0\end{pmatrix}$ and $T=\begin{pmatrix}1&-1\\-\sqrt{-2}&-1+\sqrt{-2}\end{pmatrix}$ be the two explicit matrices in $M_2(\mathbb Z[\sqrt{-2}])$ named [`FLT.ExplicitLift.Slift`](def/LanglandsTunnell_ExplicitLift.html#L21) and [`FLT.ExplicitLift.Tlift`](def/LanglandsTunnell_ExplicitLift.html#L23). The assertion, which has no hypotheses, is that there exists a monoid homomorphism $\Psi$ from the group of units $\mathrm{GL}_2(\mathbb Z/3)$ of $M_2(\mathbb Z/3)$ to $\mathrm{GL}_2(\mathbb Z[\sqrt{-2}])$ with two properties: first, for every $g\in\mathrm{GL}_2(\mathbb Z/3)$, applying $\mathrm{red}$ entrywise to $\Psi(g)$ (as the induced map of general linear groups `Matrix.GeneralLinearGroup.map`) returns $g$ itself, so that $\Psi$ is a homomorphic section of reduction; and second, for every such $g$ the underlying matrix of $\Psi(g)$ lies in the submonoid of $M_2(\mathbb Z[\sqrt{-2}])$ generated by the set $\{S,T\}$.
--
--   This is the characteristic-zero realisation of $\mathrm{GL}_2(\mathbb F_3)$ as the binary octahedral group inside $\mathrm{GL}_2(\mathbb Z[\sqrt{-2}])$, the splitting of reduction modulo the prime of norm $3$ used in the Langlands–Tunnell step to regard a mod $3$ representation as a complex two-dimensional representation. It is invoked in the construction of weight one newforms at level divisible by $3$ and in the production of a lift of the residual representation in the Langlands–Tunnell argument.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_LanglandsTunnell_ExplicitLift_exists_monoidHom_map_red_eq.lean

import Mathlib
import Definitions.Def_LanglandsTunnell_ExplicitLift

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open scoped MatrixGroups

theorem LanglandsTunnell.ExplicitLift.exists_monoidHom_map_red_eq :
    ∃ Ψ : GL (Fin 2) (ZMod 3) →* GL (Fin 2) (ℤ√(-2)),
      (∀ g : GL (Fin 2) (ZMod 3), Matrix.GeneralLinearGroup.map FLT.ExplicitLift.red (Ψ g) = g) ∧
      (∀ g : GL (Fin 2) (ZMod 3), ((Ψ g : GL (Fin 2) (ℤ√(-2))) : Matrix (Fin 2) (Fin 2) (ℤ√(-2))) ∈
        Submonoid.closure
          ({FLT.ExplicitLift.Slift, FLT.ExplicitLift.Tlift} : Set (Matrix (Fin 2) (Fin 2) (ℤ√(-2))))) := by sorry
