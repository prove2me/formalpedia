theorem OAI.MainGap.closedIdeal_comparison {u v : A} (hu : 0 ≤ u) (hv : 0 ≤ v)
    (hpi : ProperlyInfinite v) (h : u ∈ closedIdeal v hv.isSelfAdjoint) :
    ScalarCuntzLE u v := by sorry
