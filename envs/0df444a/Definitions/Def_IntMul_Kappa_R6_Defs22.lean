/-- The local cost constant of a configuration. -/
def MH (c : Cfg) : ℕ := MlocH c.Wr (c.A + gsSz c + 6) c.m

/-- The width bound of a step. -/
def dwStH (c : Cfg) (DWc : ℕ → ℕ) (F : ℕ) (a : HStep (Fin c.Wr) c.m) : ℕ :=
  a.width.elim (dwloc c.Wr c.A) fun s => DWc s + (c.G (s * F) + 2) * c.Wr

/-- The child-cost part of a step. -/
def chCostH (cI : ℕ → ℕ) (a : HStep (Fin c.Wr) c.m) : ℕ := a.width.elim 0 cI

end Step

