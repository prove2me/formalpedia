  rw [normSq_div, normSq_div, normSq_ofReal, ← add_div, ← pow_two, hrad]
  exact div_self hne

private theorem botP_line (z₀ : ℂ) (θ t : ℝ) :
    botP g (z₀ + t * Complex.exp (θ * Complex.I))
      = botP g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 0) := by
  simp only [botP]; ring

private theorem botQ_line (z₀ : ℂ) (θ t : ℝ) :
    botQ g (z₀ + t * Complex.exp (θ * Complex.I))
      = botQ g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 1) := by
  simp only [botQ]; ring

private def argMat (c₀ c₁ : ℂ) : Matrix (Fin 2) (Fin 2) ℝ := !![c₀.im, c₀.re; c₁.im, c₁.re]

private theorem botRow_argMat (c₀ c₁ : ℂ) (u : ℝ) : botRow (argMat c₀ c₁) u = c₀ + u * c₁ := by
  rw [botRow, argMat]
  simp only [Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
    Matrix.cons_val_fin_one, Matrix.of_apply]
  apply Complex.ext <;>
    simp [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]

private theorem det_argMat (c₀ c₁ : ℂ) : (argMat c₀ c₁).det = (c₀ * conj c₁).im := by
  rw [argMat, Matrix.det_fin_two_of, Complex.mul_im, Complex.conj_re, Complex.conj_im]
  ring

private theorem rad_argMat (c₀ c₁ : ℂ) (u : ℝ) : rad (argMat c₀ c₁) u = ‖c₀ + u * c₁‖ := by
  rw [rad, botRow_argMat]

private theorem exp_neg_angle_argMat {c₀ c₁ : ℂ} (h : (argMat c₀ c₁).det ≠ 0) (u : ℝ) :
    Complex.exp (-(angle (argMat c₀ c₁) u * Complex.I)) * (c₀ + u * c₁)
      = (rad (argMat c₀ c₁) u : ℂ) := by
  have h1 := exp_angle_mul_I h u
  rw [botRow_argMat] at h1
  have hr : (0 : ℝ) < rad (argMat c₀ c₁) u := rad_pos h u
  have h2 : c₀ + u * c₁
      = Complex.exp (angle (argMat c₀ c₁) u * Complex.I) * (rad (argMat c₀ c₁) u : ℂ) := by
    rw [h1, div_mul_cancel₀]
    exact Complex.ofReal_ne_zero.2 hr.ne'
  rw [h2, ← mul_assoc, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, one_mul]

private theorem dPhi_mul_mul_dPhi_apply_10 (a b : ℝ) (M : Matrix (Fin 2) (Fin 2) ℂ) :
    (dPhiMat a * M * dPhiMat b) 1 0
      = Complex.exp (-(a * Complex.I)) * M 1 0 * Complex.exp (b * Complex.I) := by
  simp [dPhiMat, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

private theorem dPhi_mul_mul_dPhi_apply_11 (a b : ℝ) (M : Matrix (Fin 2) (Fin 2) ℂ) :
    (dPhiMat a * M * dPhiMat b) 1 1
      = Complex.exp (-(a * Complex.I)) * M 1 1 * Complex.exp (-(b * Complex.I)) := by
  simp [dPhiMat, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two]

private theorem rot_dPhi_rot_apply_10 (θ₁ δ : ℝ) :
    (((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat δ
        * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)) 1 0
      = (Real.cos (2 * θ₁) : ℂ) * (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I := by
  rw [rotGLC_coe, rotGLC_coe]
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.map_apply,
    RealIwasawa.rot_apply_00, RealIwasawa.rot_apply_01,
    RealIwasawa.rot_apply_10, RealIwasawa.rot_apply_11, dPhiMat, Matrix.cons_val',
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one,
    Matrix.of_apply, Real.cos_add_pi_div_two, Real.sin_add_pi_div_two, Complex.coe_algebraMap,
    Complex.ofReal_neg, mul_zero, zero_mul, add_zero, zero_add]
  have hE : Complex.exp ((δ : ℂ) * Complex.I)
      = (Real.cos δ : ℂ) + (Real.sin δ : ℂ) * Complex.I := by
    rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  have hEneg : Complex.exp (-((δ : ℂ) * Complex.I))
      = (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I := by
    rw [show -((δ : ℂ) * Complex.I) = ((-δ : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg,
      Real.sin_neg, Complex.ofReal_neg, neg_mul, ← sub_eq_add_neg]
  rw [hE, hEneg]
  have hpyth : (Real.sin θ₁ : ℂ) ^ 2 + (Real.cos θ₁ : ℂ) ^ 2 = 1 := by
    exact_mod_cast Real.sin_sq_add_cos_sq θ₁
  have hc2 : (Real.cos (2 * θ₁) : ℂ) = (Real.cos θ₁ : ℂ) ^ 2 - (Real.sin θ₁ : ℂ) ^ 2 := by
    rw [two_mul]
    push_cast [Real.cos_add]
    ring
  rw [hc2]
  linear_combination (-(Real.sin δ : ℂ) * Complex.I) * hpyth

private theorem rot_dPhi_rot_apply_11 (θ₁ δ : ℝ) :
    (((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat δ
        * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)) 1 1
      = -((Real.sin (2 * θ₁) : ℂ) * (Real.cos δ : ℂ)) := by
  rw [rotGLC_coe, rotGLC_coe]
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.map_apply,
    RealIwasawa.rot_apply_00, RealIwasawa.rot_apply_01,
    RealIwasawa.rot_apply_10, RealIwasawa.rot_apply_11, dPhiMat, Matrix.cons_val',
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one,
    Matrix.of_apply, Real.cos_add_pi_div_two, Real.sin_add_pi_div_two, Complex.coe_algebraMap,
    Complex.ofReal_neg, mul_zero, zero_mul, add_zero, zero_add]
  have hE : Complex.exp ((δ : ℂ) * Complex.I)
      = (Real.cos δ : ℂ) + (Real.sin δ : ℂ) * Complex.I := by
    rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  have hEneg : Complex.exp (-((δ : ℂ) * Complex.I))
      = (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I := by
    rw [show -((δ : ℂ) * Complex.I) = ((-δ : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg,
      Real.sin_neg, Complex.ofReal_neg, neg_mul, ← sub_eq_add_neg]
  rw [hE, hEneg]
  have hs2 : (Real.sin (2 * θ₁) : ℂ) = 2 * (Real.sin θ₁ : ℂ) * (Real.cos θ₁ : ℂ) := by
    rw [two_mul]
    push_cast [Real.sin_add]
    ring
  rw [hs2]
  ring

private theorem kC_eq_five_factor (hg : g.det ≠ 0) (z : ℂ) {μ θ₁ δ : ℝ}
    (hδ : Real.sin δ = -(botP g z / (radC g z : ℂ)).im)
    (hc : Real.cos (2 * θ₁) * Real.cos δ = (botP g z / (radC g z : ℂ)).re)
    (hs : Real.sin (2 * θ₁) * Real.cos δ = -‖botQ g z / (radC g z : ℂ)‖)
    (hμ : Complex.exp ((μ : ℂ) * Complex.I) * (botQ g z / (radC g z : ℂ))
        = (‖botQ g z / (radC g z : ℂ)‖ : ℂ)) :
    kC g z = dPhiMat (μ / 2) * ((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
        * dPhiMat δ * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
        * dPhiMat (μ / 2) := by
  have hexp2 : Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
      * Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
      = Complex.exp (-((μ : ℂ) * Complex.I)) := by
    rw [← Complex.exp_add]
    push_cast
    ring_nf
  have hQ : botQ g z / (radC g z : ℂ)
      = Complex.exp (-((μ : ℂ) * Complex.I)) * (‖botQ g z / (radC g z : ℂ)‖ : ℂ) := by
    rw [← hμ, ← mul_assoc, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, one_mul]
  have hmem : dPhiMat (μ / 2) * (((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
        * dPhiMat δ * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ))
      * dPhiMat (μ / 2) ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ :=
    mul_mem (mul_mem (dPhiMat_mem_specialUnitaryGroup _)
      (mul_mem (mul_mem (rotC_mem_specialUnitaryGroup _) (dPhiMat_mem_specialUnitaryGroup _))
        (rotC_mem_specialUnitaryGroup _))) (dPhiMat_mem_specialUnitaryGroup _)
  have hcancel : Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
      * Complex.exp ((((μ / 2 : ℝ) : ℂ)) * Complex.I) = 1 := by
    rw [← Complex.exp_add, neg_add_cancel, Complex.exp_zero]
  have h10 : kC g z 1 0
      = (dPhiMat (μ / 2) * (((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
          * dPhiMat δ * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ))
          * dPhiMat (μ / 2)) 1 0 := by
    rw [kC_apply_10, dPhi_mul_mul_dPhi_apply_10, rot_dPhi_rot_apply_10]
    have him : (botP g z / (radC g z : ℂ)).im = -Real.sin δ := by linarith [hδ]
    have hP : botP g z / (radC g z : ℂ)
        = (Real.cos (2 * θ₁) : ℂ) * (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I := by
      apply Complex.ext
      · rw [← hc]
        simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im]
        ring
      · rw [him]
        simp only [Complex.sub_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im]
        ring
    calc botP g z / (radC g z : ℂ)
        = (Real.cos (2 * θ₁) : ℂ) * (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I := hP
      _ = ((Real.cos (2 * θ₁) : ℂ) * (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I)
            * (Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
              * Complex.exp ((((μ / 2 : ℝ) : ℂ)) * Complex.I)) := by rw [hcancel, mul_one]
      _ = Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
            * ((Real.cos (2 * θ₁) : ℂ) * (Real.cos δ : ℂ) - (Real.sin δ : ℂ) * Complex.I)
            * Complex.exp ((((μ / 2 : ℝ) : ℂ)) * Complex.I) := by ring
  have h11 : kC g z 1 1
      = (dPhiMat (μ / 2) * (((rotGLC θ₁ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
          * dPhiMat δ * ((rotGLC (θ₁ + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ))
          * dPhiMat (μ / 2)) 1 1 := by
    rw [kC_apply_11, dPhi_mul_mul_dPhi_apply_11, rot_dPhi_rot_apply_11]
    have hsC : -((Real.sin (2 * θ₁) : ℂ) * (Real.cos δ : ℂ))
        = (‖botQ g z / (radC g z : ℂ)‖ : ℂ) := by
      have hre : -(Real.sin (2 * θ₁) * Real.cos δ) = ‖botQ g z / (radC g z : ℂ)‖ := by
        linarith [hs]
      exact_mod_cast hre
    rw [hsC]
    calc botQ g z / (radC g z : ℂ)
        = Complex.exp (-((μ : ℂ) * Complex.I)) * (‖botQ g z / (radC g z : ℂ)‖ : ℂ) := hQ
      _ = (Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
            * Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I)))
          * (‖botQ g z / (radC g z : ℂ)‖ : ℂ) := by rw [hexp2]
      _ = Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I))
          * (‖botQ g z / (radC g z : ℂ)‖ : ℂ)
          * Complex.exp (-(((μ / 2 : ℝ) : ℂ) * Complex.I)) := by ring
  have key := specialUnitaryGroup_ext_of_row_one (kC_mem_specialUnitaryGroup hg z) hmem h10 h11
  rw [key]
  simp only [mul_assoc]

end ChartMatching
