    (h : q ≤ regFloorG (mixQ (htotal3 2) (n3 2) (m3 2) (mu3 2 1) r) e) :
    ((q : ℚ) : ℝ) ≤
      entropy (fun w ↦
        ((mixQ (htotal3 2) (n3 2) (m3 2) (mu3 2 1) r w : ℚ) : ℝ)) :=
  le_trans (by exact_mod_cast h)
