-- Source module: Solutions.J6SegAxCopy
/-!
# The axis program: the copy `0 → rZ` (after pass 2) and the swap `0 ↔ rZ` (before pass 7)

Both read the count `2·pre·t·post` (the number of integers of an axis array) off the axis
descriptor `descAx6 = [k, pre, post, s, t, …]` on `dA` (restored), on the scratch stacks `1 … 7`.

* `cntRS dA`: pushes `2·(pre·(t·post))` on `CN = 5` (`sp_cnt`);
* `copyAx dA`: `gflat L ++ l` on `0` and `l₂` on `rZ` ↦ `gflat L ++ l₂` on `rZ`, stack `0`
  unchanged (`copyAx_runs`);
* `swapAx dA`: `gflat A ++ l` on `0`, `gflat B ++ l₂` on `rZ` ↦ `gflat B ++ l` on `0`,
  `gflat A ++ l₂` on `rZ` (`swapAx_runs`).

Convention (`FineBody6`): every stack other than `0, dA, rZ` empty; `dA ∉ {0, …, 7, 53}`,
`dA < 56`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.AxC

open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab (rZ)


abbrev cU : Fin HS := 1
abbrev cA1 : Fin HS := 2
abbrev cA2 : Fin HS := 3
abbrev cA3 : Fin HS := 4
abbrev cN : Fin HS := 5
abbrev cT : Fin HS := 6
abbrev cC : Fin HS := 7

/-- The admissible descriptor stacks. -/
structure DAok (dA : Fin HS) : Prop where
  lt : dA.val < 56
  ge : 8 ≤ dA.val
  nZ : dA ≠ rZ

section frame
variable (dA : Fin HS) (f : Fin HS → List ℤ)

/-- The count frame. -/
def CF (u a1 a2 a3 cn d : List ℤ) : Fin HS → List ℤ := fun j =>
  if j = cU then u else if j = cA1 then a1 else if j = cA2 then a2 else if j = cA3 then a3 else
  if j = cN then cn else if j = dA then d else f j

variable {dA} (h : DAok dA) {u a1 a2 a3 cn d : List ℤ}
include h

theorem DAok.ne {j : Fin HS} (hj : j.val < 8) : dA ≠ j := by
  intro e; have := h.ge; rw [e] at this; omega

end frame

/-! ## The count -/

/-- Read `pre, post, t` off the descriptor and push `2·(pre·(t·post))` on `CN`. -/
def cntRS (dA : Fin HS) : RS :=
  .seq (.push cU (.reg dA)) (.seq (.pop dA)
  (.seq (.push cA1 (.reg dA)) (.seq (.push cU (.reg dA)) (.seq (.pop dA)
  (.seq (.push cA2 (.reg dA)) (.seq (.push cU (.reg dA)) (.seq (.pop dA)
  (.seq (.push cU (.reg dA)) (.seq (.pop dA)
  (.seq (.push cA3 (.reg dA))
  (.seq (.push cN (.mul (.lit 2) (.mul (.reg cA1) (.mul (.reg cA3) (.reg cA2)))))
  (.seq (.pop cA1) (.seq (.pop cA2) (.seq (.pop cA3)
  (.seq (.push dA (.reg cU)) (.seq (.pop cU) (.seq (.push dA (.reg cU)) (.seq (.pop cU)
  (.seq (.push dA (.reg cU)) (.seq (.pop cU) (.seq (.push dA (.reg cU)) (.pop cU))))))))))))))))))))))

/-- The cost of the count. -/
def cCnt (B : ℕ) : ℕ := 10 ^ 8 * (B + 2) ^ 2

/-! ## The copy and the swap -/

/-- The copy `0 → rZ`. -/
def copyRS (dA : Fin HS) : RS :=
  .seq (cntRS dA) (.seq (NLogN.mvK 0 cT cC (.reg cN)) (.seq (KR.dupR cT 0 rZ cC cN) (.pop cN)))

/-- The swap `0 ↔ rZ`. -/
def swapRS (dA : Fin HS) : RS :=
  .seq (cntRS dA) (.seq (NLogN.mvK 0 cT cC (.reg cN)) (.seq (NLogN.mvK rZ cU cC (.reg cN))
    (.seq (NLogN.mvK cU 0 cC (.reg cN)) (.seq (NLogN.mvK cT rZ cC (.reg cN)) (.pop cN)))))

/-- The descriptor facts used by the copy and the swap. -/
structure DescB (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k B : ℕ) : Prop where
  two : 2 ≤ B
  bk : zsz (k : ℤ) ≤ B
  bpre : zsz ((preT P n D k : ℕ) : ℤ) ≤ B
  bpost : zsz ((postT P n D k : ℕ) : ℤ) ≤ B
  bs : zsz ((src k : ℕ) : ℤ) ≤ B
  bt : zsz ((tF6 P n k : ℕ) : ℤ) ≤ B
  m1 : zsz ((tF6 P n k : ℤ) * (postT P n D k : ℕ)) ≤ B
  m2 : zsz (((preT P n D k : ℕ) : ℤ) * ((tF6 P n k : ℤ) * (postT P n D k : ℕ))) ≤ B
  m3 : zsz (2 * (((preT P n D k : ℕ) : ℤ) * ((tF6 P n k : ℤ) * (postT P n D k : ℕ)))) ≤ B

end J6Seg.AxC

end

end

section
-- Source module: Solutions.J6SegAxis6
/-!
# B-line axis program (`AxisU6`), part 6: the nine steps of one axis from the components

**`axSteps_at`**: for axis `k ≤ D`, from
* the multiplier `pM`, the chunk kernel `chunkI pM` at `eK`, the `J` kernel `jKprog` at `eJK`;
* `FineBody6` (`eF`, `eB`, `dF`), registers `ρ` admissible for `dT = 49` and `dTJ = 33`;
* the kernel set-ups (`SetupBody6`, B5) and the slab set-ups (`SetupS`, B1);
* the regime (`AxReg`), the value bounds (`ValAt`, the clause of `ValNeed6`), the chunk output
  bound (`ChunkOutAt`), the chunk table bound (`TabAt`, the clause of `ChunkTabBnd6`) and the
  budget (`AxBudgetAt`, S2),

the nine steps hold (`AxStepsAt`) with total cost `8 Cs + 6 Cp + (9 + 6 C₀) Cc`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab

/-! ## Monotonicity of the contracts -/

/-! ## The per-axis facts -/

section facts
variable (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)

/-- The clause of `ValNeed6` at axis `k`. -/
def ValAt : Prop :=
  (∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
      GB (axwd6 P n src k ap) (arrS6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrJ6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrW6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrWp6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY26 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrS6 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrWp6 P n src D k L) ∧
      ∀ b < axpre6 P n D k, ∀ c < axpost6 P n D k,
        axJPre6 P n src k ap (lineAt (axG6 P n src k) (axpost6 P n D k) (arrJ6 P n src D k L) b c)) ∧
    (∀ x : List GI, axJPre6 P n src k ap x →
      GB (axwd6 P n src k ap) (liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k)
        (axl6 P n) (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) x))

/-- The chunk kernel's output bound (S2): `GB wd` on every `AB X` row of length `λ`. -/
def ChunkOutAt : Prop :=
  ∀ q < axnc6 P n k, ∀ x : List GI, x.length = axl6 P n → KR.AB (axX6 P n src k ap) x →
    GB (axwd6 P n src k ap) (liftG (chunkK (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k)
      (axl6 P n) (axα6 P n) q) x)

/-- The clause of `ChunkTabBnd6` at axis `k`. -/
def TabAt : Prop :=
  let T := TT (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)
  let A : ℤ := 2 ^ (axQ6 P n src k + axR6 P n + 2)
  ∀ u < axl6 P n, |T.di u| ≤ A ∧ |T.gi u| ≤ A ∧ |T.gam u| ≤ A ∧ |T.dd u| ≤ A ∧
    ∀ c, |T.am c u| ≤ A ∧ |T.ap c u| ≤ A

end facts

/-! ## The slab control lists of axis `k` -/

section ctl
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)

def ctl1 : List (ℤ × ℤ) :=
  ctlOf (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n) (selSrc (axs6 src k) (axt6 P n k))
    (fun _ => 2 ^ (axQ6 P n src k - axp6 P n - 1))
def ctl3 : List (ℤ × ℤ) :=
  ctlOf (axnc6 P n k * axl6 P n) (axG6 P n src k)
    (jSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ => 0)
def ctl5 : List (ℤ × ℤ) :=
  ctlOf (axG6 P n src k) (axnc6 P n k * axl6 P n)
    (scSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ => 0)
def ctl7 : List (ℤ × ℤ) :=
  ctlOf (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n) (fun l => some l)
    (argO (axp6 P n) (axs6 src k) (axt6 P n k) (axα6 P n))

/-- The slab register files of the four slab passes. -/
def slabV1 : Fin 7 → List ℤ :=
  slabV (ctl1 P n src k) (axpre6 P n D k) (axpost6 P n D k) (axnc6 P n k * axl6 P n) [] []
def slabV3 : Fin 7 → List ℤ :=
  slabV (ctl3 P n src k) (axpre6 P n D k) (axpost6 P n D k) (axG6 P n src k) [] []
def slabV5 : Fin 7 → List ℤ :=
  slabV (ctl5 P n src k) (axpre6 P n D k) (axpost6 P n D k) (axnc6 P n k * axl6 P n) [] []
def slabV7 : Fin 7 → List ℤ :=
  slabV (ctl7 P n src k) (axpre6 P n D k) (axpost6 P n D k) (axnc6 P n k * axl6 P n)
    [(2 : ℤ) ^ (axQ6 P n src k - axp6 P n)] [(2 : ℤ) ^ axp6 P n]

end ctl

/-- The slab bodies. -/
def bodySc {Pp : ℕ} : IStmt HS Pp :=
  passP (.op (.drop 0)) (.op (.mv 0 Slab.rT)) itS (.op (.mv Slab.rT 0))
def bodyId {Pp : ℕ} : IStmt HS Pp :=
  passP (.op (.drop 0)) (.op (.mv 0 Slab.rT)) itI (.op (.mv Slab.rT 0))

end J6Seg.Ax

end

