section
-- Source module: NLogN.HAsym
/-!
# Asymptotics of the recursion: the Fermat-ring products

For `q = mkParams K N` the `3 · 2^{logOuter}` products of `fn + 1`-bit residues made by the three
`fermatW` calls cost at most a quarter of `TT' N` once `K ≥ 10^4` and `N` is large.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Asym

open IntMul NLogN NLogN.Top IntMul.HvdH IntMul.HvdH.Ref

/-- Facts about `mkParams K N` for huge `N`. -/
structure PF (K N : ℕ) : Prop where
  b_eq : (mkParams K N).b = Nat.size N
  zN : zsz (N : ℤ) = (mkParams K N).b
  b_big : 2 ^ (8 * K) < (mkParams K N).b
  N_low : 2 ^ ((mkParams K N).b - 1) ≤ N
  N_high : N < 2 ^ (mkParams K N).b
  Lb : (mkParams K N).L * (mkParams K N).b ≤ N + (mkParams K N).b
  NbL : N ≤ (mkParams K N).b * (mkParams K N).L
  L1 : 1 ≤ (mkParams K N).L
  E8 : 2 ^ (mkParams K N).logT ≤ 8 * (mkParams K N).L
  E4 : 4 * (mkParams K N).L ≤ 2 ^ (mkParams K N).logT
  Eb : (mkParams K N).logT ≤ (mkParams K N).b + 3
  Ke : K * (mkParams K N).e ≤ (mkParams K N).logT + K
  eK : (mkParams K N).logT ≤ K * (mkParams K N).e
  e1 : 2 ≤ (mkParams K N).e
  dh : (mkParams K N).dh < K
  lo : (mkParams K N).logOuter + (mkParams K N).e = (mkParams K N).logT
  P_eq : (mkParams K N).P = 2 * (mkParams K N).p + (mkParams K N).logT + 8
  p_eq : (mkParams K N).p = 2 * (mkParams K N).b + 2 * (mkParams K N).logT +
    6 * K * (mkParams K N).α ^ 2 + 8 * Nat.size (mkParams K N).b + 4 * K + 64
  X64 : 64 * (6 * K * (mkParams K N).α ^ 2) ≤ (mkParams K N).b
  B64 : 64 * (8 * Nat.size (mkParams K N).b + 4 * K + 64) ≤ (mkParams K N).b
  BK : 10 * (K * (Nat.size (mkParams K N).b + 9) + 2) ≤ (mkParams K N).b
  bB : (mkParams K N).b < 2 ^ Nat.size (mkParams K N).b
  bB' : 2 ^ (Nat.size (mkParams K N).b - 1) ≤ (mkParams K N).b
  B8 : 8 * K < Nat.size (mkParams K N).b
  α1 : 2 * K ≤ (mkParams K N).α
  α4 : (mkParams K N).α ^ 4 ≤ 81 * K ^ 4 * (64 * (mkParams K N).b)

end NLogN.Asym

end

section
-- Source module: NLogN.HDec
/-!
# Decoding a Fermat residue into a block of Gaussian integers

`decP` pops `z` (`0 ≤ z < F = 2^(4rP)+1`) from `KZ` and pushes
`gints (decBlk F P r z).reverse` onto `KO`:

1. `x := if F < 2z then z - 1 else z` (so `x ≥ 0` and `x ≡ balMod F z (mod 2^(4rP))`);
2. cut `4r` standard `P`-bit digits off `x` with `split` (`chunkP`);
3. a carry pass `balConv` over the digits gives `kunpack (2^P) (4r) (balMod F z)`;
4. the quarters are folded: real part `d_c + d_{c+r}`, imaginary part `d_{2r+c} + d_{3r+c}`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul IntMul.HvdH IntMul.HvdH.Ref

/-! ## Pure facts -/

/-- The carry after a `balConv` pass. -/
def bcar (B : ℤ) : List ℤ → ℤ → ℤ
  | [], c => c
  | d :: ds, c => bcar B ds (if B ≤ 2 * (d + c) then 1 else 0)

/-- The value cut into digits. -/
def decX (N z : ℤ) : ℤ := if N + 1 + -(z + z) < 0 then z + -1 else z

/-- The folded block from the four quarters. -/
def foldF (q₁ q₂ q₃ q₄ : List ℤ) (c : ℕ) : ℤ × ℤ :=
  (q₁.getD c 0 + q₂.getD c 0, q₃.getD c 0 + q₄.getD c 0)

/-! ## Registers -/

/-- input `z` -/
abbrev KZ : Fin HS := 30
/-- output -/
abbrev KO : Fin HS := 31
/-- `2^P` -/
abbrev KB : Fin HS := 32
/-- `N = 2^(4rP)` -/
abbrev KN : Fin HS := 33
/-- `r` -/
abbrev KR : Fin HS := 34
/-- loop counter -/
abbrev KC : Fin HS := 35
/-- scratch: digits (high on top) -/
abbrev KD : Fin HS := 36
/-- scratch: digits (low on top) -/
abbrev KE : Fin HS := 37
/-- scratch: balanced digits (high on top) -/
abbrev KG : Fin HS := 38
/-- scratch: carry -/
abbrev KY : Fin HS := 39
/-- scratch: quarters -/
abbrev KQ1 : Fin HS := 27
abbrev KQ2 : Fin HS := 28
abbrev KQ3 : Fin HS := 29
abbrev KQ4 : Fin HS := 54

/-! ## The program -/

/-- `x := if F < 2z then z - 1 else z` (with `F = N + 1`). -/
def decXE : Ex HS :=
  .sel (.add (.add (.reg KN) (.lit 1)) (.neg (.add (.reg KZ) (.reg KZ))))
    (.add (.reg KZ) (.lit (-1))) (.reg KZ)

/-- `4r` -/
def fourR : Ex HS := .shl (.reg KR) (.lit 4)

/-- `d + c` -/
def balT : Ex HS := .add (.reg KE) (.reg KY)
/-- `B - 2(d + c) - 1` (negative iff `B ≤ 2(d+c)`) -/
def balCnd : Ex HS := .add (.add (.reg KB) (.neg (.add balT balT))) (.lit (-1))

def balBody : RS :=
  RS.seqL [.push KG (.sel balCnd (.add balT (.neg (.reg KB))) balT),
    .asg KY (.sel balCnd (.lit 1) (.lit 0)), .pop KE]

def balPass : RS := RS.seqL [.push KY (.lit 0), .rep KC fourR balBody, .pop KY]

def foldBody : RS :=
  RS.seqL [.push KO (.add (.reg KQ3) (.reg KQ4)), .push KO (.add (.reg KQ1) (.reg KQ2)),
    .pop KQ1, .pop KQ2, .pop KQ3, .pop KQ4]

def foldPass : RS := .rep KC (.reg KR) foldBody

def decP : RM :=
  RM.seqL [.rs (.asg KZ decXE), chunkP KZ KB KD KC fourR, .rs (.pop KZ),
    .rs (mvList KD KE KC fourR), .rs balPass,
    .rs (mvList KG KQ4 KC (.reg KR)), .rs (mvList KG KQ3 KC (.reg KR)),
    .rs (mvList KG KQ2 KC (.reg KR)), .rs (mvList KG KQ1 KC (.reg KR)), .rs foldPass]

/-! ## The carry pass -/

/-- The state of the carry pass after `k` digits. -/
def balSt (s : IState HS) (B : ℤ) (dl : List ℤ) (RE : List Item) (k : ℕ) : IState HS :=
  ((s.upd KE (ints (dl.drop k) ++ RE)).upd KG
    (ints (balConv B (dl.take k) 0).reverse ++ s.G KG)).upd KY
    (.int (bcar B (dl.take k) 0) :: s.G KY)

/-! ## The fold -/

/-- The state of the fold after `k` output pairs. -/
def foldSt (s : IState HS) (q₁ q₂ q₃ q₄ : List ℤ) (R₁ R₂ R₃ R₄ : List Item) (k : ℕ) :
    IState HS :=
  ((((s.upd KQ1 (ints (q₁.drop k) ++ R₁)).upd KQ2 (ints (q₂.drop k) ++ R₂)).upd KQ3
    (ints (q₃.drop k) ++ R₃)).upd KQ4 (ints (q₄.drop k) ++ R₄)).upd KO
    (gints ((List.range k).map (foldF q₁ q₂ q₃ q₄)).reverse ++ s.G KO)

/-! ## Side conditions of the pieces -/

/-- Expressions built from registers, literals, `add`, `neg`, `sel`. -/
def Ex.Plain : Ex HS → Bool
  | .reg _ | .lit _ => true
  | .add a b => a.Plain && b.Plain
  | .neg a => a.Plain
  | .sel c x y => c.Plain && x.Plain && y.Plain
  | _ => false

/-! ## The whole decoder -/

/-! ## Costs -/

end NLogN

end

section
-- Source module: NLogN.HSort
/-!
# Stable radix sort of fixed-width records on a register stack

* `mvK X Y C n`: move `n` integers from `X` to `Y` (reversed); `mvK_spec`, `mvK_cost`.
* `radixPass k`, `radixSort kb`: the pure stable partition pass / LSD radix sort on the first
  component (the key) of each record; `radixSort_keys`: for keys forming a permutation of
  `0, …, N-1` (with `N ≤ 2^kb`) the record with key `q` ends up at position `q`.
* `passP w`, `sortP w`: the register programs (records of width `w ≥ 1` on stack `0`, record
  count on `1`, key bits `kb` on `2`; scratch `46 … 53`); `sortP_spec`, `sortP_cost`.
All per-element code uses `Ex.Lin` expressions only; costs are bounded with the linear lemmas.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

/-- Move `n` integers from `X` to `Y` one at a time (reversing them), counter on `C`. -/
def mvK (X Y C : Fin HS) (n : Ex HS) : RS := rep C n (NLogN.RS.seq (push Y (.reg X)) (pop X))

def mvSt_s (X Y : Fin HS) (s : IState HS) (L : List ℤ) (R : List Item) (k : ℕ) : IState HS :=
  (s.upd X (ints (L.drop k) ++ R)).upd Y ((ints (L.take k)).reverse ++ s.G Y)

/-! ## Radix sort: pure functions -/

/-- Bit `k` of the key (the first component) of a record; for keys `≥ 0` this is
`Nat.testBit key k`. -/
def keyBit (k : ℕ) (r : List ℤ) : Bool := decide (0 < ((r.headD 0).tdiv (2 ^ k)).tmod 2)

/-- One stable partition pass on bit `k`: records with bit `0` first, then those with bit `1`. -/
def radixPass (k : ℕ) (R : List (List ℤ)) : List (List ℤ) :=
  R.filter (fun r => !keyBit k r) ++ R.filter (keyBit k)

/-- LSD radix sort on the key bits `0, …, kb-1`. -/
def radixSort (kb : ℕ) (R : List (List ℤ)) : List (List ℤ) :=
  (List.range kb).foldl (fun R k => radixPass k R) R

/-! ## One pass as a register program

Registers: data `0`, record count `1`; scratch `46` (ones), `47` (zeros), `48`, `49` (their
element counts), `50` (loop counter), `51` (counter of `mvK`), `52` (holds `2^k`). -/

/-- `-(bit k of the key on top of 0)` for the divisor `2^k` on `52`. -/
def bitE : Ex HS := .neg (.rem (.quo (.reg 0) (.reg 52)) (.lit 2))

def recBody (w : ℕ) : RS :=
  ite bitE (NLogN.RS.seq (mvK 0 46 51 (.lit w)) (asg 48 (.add (.reg 48) (.lit w))))
    (NLogN.RS.seq (mvK 0 47 51 (.lit w)) (asg 49 (.add (.reg 49) (.lit w))))

def passLoop (w : ℕ) : RS := rep 50 (.reg 1) (recBody w)

def passP (w : ℕ) : RS :=
  NLogN.RS.seq (push 48 (.lit 0)) (NLogN.RS.seq (push 49 (.lit 0)) (NLogN.RS.seq (passLoop w)
    (NLogN.RS.seq (mvK 46 0 51 (.reg 48)) (NLogN.RS.seq (mvK 47 0 51 (.reg 49)) (NLogN.RS.seq (pop 49) (pop 48))))))

/-- The state after `j` records of the pass loop (relative to the state `s` before the pass). -/
def passSt (k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (j : ℕ) : IState HS :=
  ((((s.upd 0 (ints (R.drop j).flatten ++ Rest)).upd 46
    (ints (((R.take j).filter (keyBit k)).flatten.reverse) ++ s.G 46)).upd 47
    (ints (((R.take j).filter (fun r => !keyBit k r)).flatten.reverse) ++ s.G 47)).upd 48
    (.int (((R.take j).filter (keyBit k)).flatten.length) :: s.G 48)).upd 49
    (.int (((R.take j).filter (fun r => !keyBit k r)).flatten.length) :: s.G 49)

section
variable (k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (j : ℕ)

end

/-! ## The radix sort program

Data on `0`, record count on `1`, number of key bits on `2`; scratch `46 … 53`. -/

def sortBody (w : ℕ) : RS := NLogN.RS.seq (NLogN.passP w) (asg 52 (.shl (.reg 52) (.lit 2)))

def sortLoop (w : ℕ) : RS := rep 53 (.reg 2) (sortBody w)

/-- Radix sort of the records of width `w` on stack `0` by their first components. -/
def sortP (w : ℕ) : RS := NLogN.RS.seq (push 52 (.lit 1)) (NLogN.RS.seq (sortLoop w) (pop 52))

def sortSt (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (k : ℕ) : IState HS :=
  (s.upd 0 (ints (radixSort k R).flatten ++ Rest)).upd 52 (.int (2 ^ k) :: s.G 52)

/-! ## Costs -/

/-! ## Correctness of radix sort for distinct keys -/

/-- The key of a record. -/
def key (r : List ℤ) : ℤ := r.headD 0

/-- Sorted by the key modulo `2^k`. -/
def SortedMod (k : ℕ) (L : List (List ℤ)) : Prop :=
  L.Pairwise (fun r r' => key r % 2 ^ k ≤ key r' % 2 ^ k)

end NLogN

end

section
-- Source module: NLogN.HTrans
/-!
# Transposition of row-major arrays by radix sort

The `n × m` row-major array of records `D` (each a list of `d` integers) on stack `0` is replaced
by its transpose: the element at `(i, j)` gets the key `j * n + i`, the keyed records are radix
sorted, and the keys are stripped.

Registers: data `0`, `n` on `1`, `m` on `2`, number of key bits `kb` on `3`.
Scratch: `40` (temporary stack), `41` (current key), `42` (row key `i`), `43`, `44` (loop
counters), `45` (item count of `40`), `54` (record count), plus those of `sortP` and `mvK`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

/-- The keyed record for position `p = i * m + j`: key `j * n + i`. -/
def keyRec (n m : ℕ) (D : List (List ℤ)) (p : ℕ) : List ℤ :=
  (((p % m) * n + p / m : ℕ) : ℤ) :: D.getD p []

def kflat (n m : ℕ) (D : List (List ℤ)) (p : ℕ) : List ℤ :=
  ((List.range p).map (keyRec n m D)).flatten

def elemBody (d : ℕ) : RS :=
  NLogN.RS.seq (push 40 (.reg 41)) (NLogN.RS.seq (mvK 0 40 51 (.lit d)) (NLogN.RS.seq (asg 41 (.add (.reg 41) (.reg 1)))
    (NLogN.RS.seq (asg 45 (.add (.reg 45) (.lit (d + 1)))) (asg 54 (.add (.reg 54) (.lit 1))))))

/-- Inner loop states: `j` elements of row `i` done. -/
def innerSt (s u : IState HS) (D : List (List ℤ)) (Rest : List Item) (n m d i j : ℕ) :
    IState HS :=
  ((((u.upd 0 (ints (D.drop (i * m + j)).flatten ++ Rest)).upd 40
    (ints (kflat n m D (i * m + j)).reverse ++ s.G 40)).upd 41
    (.int ((j * n + i : ℕ) : ℤ) :: s.G 41)).upd 45
    (.int (((i * m + j) * (d + 1) : ℕ) : ℤ) :: s.G 45)).upd 54
    (.int ((i * m + j : ℕ) : ℤ) :: s.G 54)

def innerLoop (d : ℕ) : RS := rep 44 (.reg 2) (elemBody d)

def rowBody (d : ℕ) : RS :=
