theorem rest_le_sol_aux (h d w Z VT p T : ℕ) (hVT : VT = 2 * T) (hw : w = p + 2) (hp : 6 ≤ p)
    (hZ : Z ≤ 3 * p) (hdh : d + 1 ≤ 2 ^ h)
    (hT : (d + 2) * (CU * (Z + 1) ^ 2 + 5 * Z + 10 ^ 4) ≤ T) :
