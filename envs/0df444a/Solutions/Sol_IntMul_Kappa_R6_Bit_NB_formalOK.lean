section
-- Source module: Solutions.R6BitNBProjA
/-!
# Round six, bit network: `G`-orthogonal projectors on the point space

On `ℚ^23` the form `B(u, v) = u·v - (Σu)(Σv)/9` (the Gram form `G = I - J/9` of the labels). A
subspace inside a centre hyperplane `{v | Σ v = 3 v_c}` is `B`-positive definite, hence
complemented by its `B`-orthogonal; its `B`-orthogonal projector `P` is characterized by
`P v = v` on the subspace and `P w = 0` on the orthogonal (`IsPrj`). Consequences: `P² = P`,
nesting of subspaces gives both product relations, `rank P = dim`.

Line projectors `Pl T = x_T y_Tᵀ` (`x_T` the triple indicator, `y_T = G x_T / 2`, `y_T·x_T = 1`)
project onto the line of `x_T`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Module R6Chk R6Chk.Bit

/-! ## Projector characterization -/

theorem decomp {V : Submodule ℚ V23} (h : IsCompl V (Bf.orthogonal V)) (u : V23) :
    ∃ a ∈ V, ∃ b ∈ Bf.orthogonal V, u = a + b := by
  have : u ∈ V ⊔ Bf.orthogonal V := by rw [h.sup_eq_top]; trivial
  obtain ⟨a, ha, b, hb, e⟩ := Submodule.mem_sup.1 this
  exact ⟨a, ha, b, hb, e.symm⟩

theorem mat_ext {P Q : Matrix (Fin 23) (Fin 23) ℚ} (h : ∀ u, P *ᵥ u = Q *ᵥ u) : P = Q := by
  apply Matrix.toLin'.injective
  exact LinearMap.ext fun u => by rw [Matrix.toLin'_apply, Matrix.toLin'_apply, h]

theorem IsPrj.eq {V : Submodule ℚ V23} (h : IsCompl V (Bf.orthogonal V)) {P Q : Matrix (Fin 23) (Fin 23) ℚ}
    (hP : IsPrj P V) (hQ : IsPrj Q V) : P = Q := by
  apply mat_ext
  intro u
  obtain ⟨a, ha, b, hb, rfl⟩ := decomp h u
  rw [mulVec_add, mulVec_add, hP.1 a ha, hQ.1 a ha, hP.2 b hb, hQ.2 b hb]

theorem IsPrj.mem {V : Submodule ℚ V23} (h : IsCompl V (Bf.orthogonal V)) {P : Matrix (Fin 23) (Fin 23) ℚ}
    (hP : IsPrj P V) (u : V23) : P *ᵥ u ∈ V ∧ u - P *ᵥ u ∈ Bf.orthogonal V := by
  obtain ⟨a, ha, b, hb, rfl⟩ := decomp h u
  rw [mulVec_add, hP.1 a ha, hP.2 b hb, add_zero, add_sub_cancel_left]
  exact ⟨ha, hb⟩

theorem IsPrj.idem {V : Submodule ℚ V23} (h : IsCompl V (Bf.orthogonal V)) {P : Matrix (Fin 23) (Fin 23) ℚ}
    (hP : IsPrj P V) : P * P = P :=
  IsPrj.eq h ⟨fun v hv => by rw [← mulVec_mulVec, hP.1 v hv, hP.1 v hv],
    fun w hw => by rw [← mulVec_mulVec, hP.2 w hw, mulVec_zero]⟩ hP

/-- Nested subspaces: both product relations. -/
theorem IsPrj.nested {V V' : Submodule ℚ V23} (hVV : V ≤ V') (h : IsCompl V (Bf.orthogonal V))
    (h' : IsCompl V' (Bf.orthogonal V')) {P P' : Matrix (Fin 23) (Fin 23) ℚ} (hP : IsPrj P V)
    (hP' : IsPrj P' V') : P' * P = P ∧ P * P' = P := by
  have horth : Bf.orthogonal V' ≤ Bf.orthogonal V := LinearMap.BilinForm.orthogonal_le hVV
  constructor
  · exact IsPrj.eq h ⟨fun v hv => by rw [← mulVec_mulVec, hP.1 v hv, hP'.1 v (hVV hv)],
      fun w hw => by rw [← mulVec_mulVec, hP.2 w hw, mulVec_zero]⟩ hP
  · refine IsPrj.eq h ⟨fun v hv => by rw [← mulVec_mulVec, hP'.1 v (hVV hv), hP.1 v hv],
      fun w hw => ?_⟩ hP
    rw [← mulVec_mulVec]
    have hm := (IsPrj.mem h' hP' w).2
    have : P' *ᵥ w = w - (w - P' *ᵥ w) := by abel
    rw [this, mulVec_sub, hP.2 w hw, hP.2 _ (horth hm), sub_zero]

theorem IsPrj.rank {V : Submodule ℚ V23} (h : IsCompl V (Bf.orthogonal V)) {P : Matrix (Fin 23) (Fin 23) ℚ}
    (hP : IsPrj P V) : P.rank = finrank ℚ V := by
  have : LinearMap.range P.mulVecLin = V := by
    ext v
    constructor
    · rintro ⟨u, rfl⟩
      exact (IsPrj.mem h hP u).1
    · intro hv
      exact ⟨v, hP.1 v hv⟩
  rw [Matrix.rank, this]

theorem prjM_spec (V : Submodule ℚ V23) (h : IsCompl V (Bf.orthogonal V)) : IsPrj (prjM V h) V := by
  refine ⟨fun v hv => ?_, fun w hw => ?_⟩
  · rw [prjM, LinearMap.toMatrix'_mulVec, ← Submodule.coe_projectionOnto_apply,
      Submodule.projectionOnto_apply_of_mem_left h hv]
  · rw [prjM, LinearMap.toMatrix'_mulVec, ← Submodule.coe_projectionOnto_apply,
      Submodule.projectionOnto_apply_of_mem_right h hw]
    rfl

/-! ## Triples -/

theorem dot_tvQ (i j : ℕ) : tvQ i ⬝ᵥ tvQ j = ((F (tri i) ∩ F (tri j)).card : ℚ) := by
  have : F (tri i) ∩ F (tri j) = Finset.univ.filter
      (fun p : Fin 23 => (tri i).testBit p = true ∧ (tri j).testBit p = true) := by
    ext p; simp [F]
  rw [this, Finset.card_filter, Nat.cast_sum, dotProduct]
  refine Finset.sum_congr rfl fun p _ => ?_
  simp only [tvQ]; split_ifs <;> simp_all

/-- The form on two triples: `|S ∩ T| - 1`. -/
theorem bf_tvQ {i j : ℕ} (hi : i < 1771) (hj : j < 1771) :
    bfF (tvQ i) (tvQ j) = ((F (tri i) ∩ F (tri j)).card : ℚ) - 1 := by
  rw [bfF, dot_tvQ, sum_tvQ hi, sum_tvQ hj]; norm_num

/-! ## Line projectors -/

theorem yv_dot (T : ℕ) (v : V23) : yv T ⬝ᵥ v = bfF (xv T) v / 2 := by
  have : ∀ p, (tvQ T p - (∑ q, tvQ T q) / 9) / 2 * v p =
      (tvQ T p * v p) / 2 - (∑ q, tvQ T q) / 18 * v p := fun p => by ring
  simp only [yv, xv, bfF, dotProduct, this, Finset.sum_sub_distrib, ← Finset.sum_div, ← Finset.mul_sum]
  ring

theorem xv_ne {T : ℕ} (hT : T < 1771) : bfF (xv T) (xv T) = 2 := by
  rw [xv, bf_tvQ hT hT, Finset.inter_self, (tri_spec hT).2]; norm_num

theorem yx {T : ℕ} (hT : T < 1771) : yv T ⬝ᵥ xv T = 1 := by
  rw [yv_dot, xv_ne hT]; norm_num

theorem Pl_mulVec (T : ℕ) (v : V23) : Pl T *ᵥ v = (bfF (xv T) v / 2) • xv T := by
  rw [Pl, vecMulVec_mulVec, yv_dot, op_smul_eq_smul]

theorem Pl_idem {T : ℕ} (hT : T < 1771) : Pl T * Pl T = Pl T := vmv_idem _ _ (yx hT)

theorem Pl_prj {T : ℕ} (hT : T < 1771) : IsPrj (Pl T) (lineS T) := by
  refine ⟨fun v hv => ?_, fun w hw => ?_⟩
  · obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hv
    rw [Pl_mulVec]
    simp only [bfF] at *
    have := xv_ne hT
    simp only [bfF] at this
    rw [show (xv T ⬝ᵥ a • xv T - (∑ p, xv T p) * (∑ p, (a • xv T) p) / 9) =
      a * (xv T ⬝ᵥ xv T - (∑ p, xv T p) * (∑ p, xv T p) / 9) by
        simp only [dotProduct_smul, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum]; ring, this]
    norm_num
  · rw [Pl_mulVec, mem_orth.1 hw (xv T) (Submodule.mem_span_singleton_self _)]
    simp

theorem Pnd_prj {sup : ℕ} (h : HasCentre sup) : IsPrj (Pnd sup) (spanS sup) := by
  rw [Pnd, dif_pos h]; exact prjM_spec _ _

theorem Pnd_idem {sup : ℕ} (h : HasCentre sup) : Pnd sup * Pnd sup = Pnd sup :=
  (Pnd_prj h).idem (compl_spanS h)

theorem Pnd_rank {sup : ℕ} (h : HasCentre sup) : (Pnd sup).rank = finrank ℚ (spanS sup) :=
  (Pnd_prj h).rank (compl_spanS h)

theorem Pnd_nested {a b : ℕ} (ha : HasCentre a) (hb : HasCentre b) (hab : spanS a ≤ spanS b) :
    Pnd b * Pnd a = Pnd a ∧ Pnd a * Pnd b = Pnd a :=
  IsPrj.nested hab (compl_spanS ha) (compl_spanS hb) (Pnd_prj ha) (Pnd_prj hb)

/-- A node orthogonal to the line `T` lies under the hyperplane projector `1 - Pl T`. -/
theorem Pnd_orth {sup T : ℕ} (h : HasCentre sup) (hT : T < 1771)
    (horth : ∀ v ∈ spanS sup, bfF (xv T) v = 0) :
    (1 - Pl T) * Pnd sup = Pnd sup ∧ Pnd sup * (1 - Pl T) = Pnd sup := by
  have hP := Pnd_prj h
  have hc := compl_spanS h
  have h1 : Pl T * Pnd sup = 0 := by
    apply mat_ext; intro u
    rw [← mulVec_mulVec, Pl_mulVec, horth _ (hP.mem hc u).1, zero_mulVec]
    simp
  have h2 : Pnd sup * Pl T = 0 := by
    apply mat_ext; intro u
    rw [← mulVec_mulVec, Pl_mulVec, mulVec_smul, hP.2 (xv T) (mem_orth.2 fun v hv => by
      rw [bfF_comm]; exact horth v hv), smul_zero, zero_mulVec]
  constructor
  · rw [sub_mul, one_mul, h1, sub_zero]
  · rw [mul_sub, mul_one, h2, sub_zero]

/-- The span of a single triple. -/
theorem spanS_single {T : ℕ} : spanS (2 ^ T) = lineS T := by
  rw [spanS, lineS, xv]
  congr 1
  ext v
  simp only [Set.mem_ofPred_eq, Set.mem_singleton_iff, Nat.testBit_two_pow]
  constructor
  · rintro ⟨i, hi, rfl⟩
    rw [decide_eq_true_eq] at hi
    rw [hi]
  · rintro rfl
    exact ⟨T, by simp, rfl⟩

theorem centre_single {T : ℕ} (hT : T < 1771) : HasCentre (2 ^ T) := by
  obtain ⟨p, hp⟩ : (F (tri T)).Nonempty := by
    rw [← Finset.card_pos, (tri_spec hT).2]; norm_num
  refine ⟨p, p.2, fun i hi => ?_⟩
  rw [Nat.testBit_two_pow, decide_eq_true_eq] at hi
  subst hi
  exact ⟨hT, mem_F.1 hp⟩

/-- The leaf projector is the line projector. -/
theorem Pnd_single {T : ℕ} (hT : T < 1771) : Pnd (2 ^ T) = Pl T := by
  have h := centre_single hT
  have hc := compl_spanS h
  apply IsPrj.eq hc (Pnd_prj h)
  rw [spanS_single]
  exact Pl_prj hT

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6ChkBitDim0
/-! Bit round six, h = 23: node dimension records, part 0 of 3 (1522 elements of 8 nodes). Generated by bit_dimexp.py. -/

set_option maxRecDepth 100000
set_option Elab.async false

namespace R6Chk.Bit.Dim0

