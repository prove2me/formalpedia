    (𝓝 : A.Modules) (e : 𝓝 ≅ 𝓜.tensorPow n ⊗ P)
    (hpos : ∀ (k' : Type) [Field k'] [IsAlgClosed k'] (sk : k →+* k'), 0 < Scheme.Modules.geomFibreH0Finrank f 𝓝 k' sk)
    (k' : Type) [Field k'] [IsAlgClosed k'] (sk : k →+* k') :
    0 < Scheme.Modules.geomFibreH0Finrank f 𝓜 k' sk := by
  classical
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  haveI : SmoothOfRelativeDimension g f :=
    GoodReductionJacobian.RelativeGroupLaw.smoothOfRelativeDimension_of_forall_topologicalKrullDim_eq L g hdim
  haveI : CompactSpace ↑A := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨𝒦⟩ := nonempty_orderedAffineCover A

  have hce := Scheme.Modules.geomFibreH0Finrank_comp_eq f 𝓜 h𝓜 k k' (RingHom.id k) sk
  rw [RingHom.comp_id] at hce
  rw [hce]

  obtain ⟨Q, hQ, hsym⟩ := exists_inPicZero_isSymmetric_tensor_of_kernelPts_finite k f L hc hA g hdim 𝓜 h𝓜 hK
  have h𝓜' : Scheme.Modules.IsInvertible (𝓜 ⊗ Q) := h𝓜.tensor_monoidalV2 hQ.1
  have hK' : (kernelPts f L (𝓜 ⊗ Q)).Finite := hK.subset (kernelPts_tensor_subset k f L 𝓜 Q hQ)

  have h𝓜'n : ∀ t : ℕ, Scheme.Modules.IsInvertible ((𝓜 ⊗ Q).tensorPow t) := isInvertible_tensorPow h𝓜'
  have hQn : InPicZero f L (Q.tensorPow n) := inPicZero_tensorPow k f L hQ n
  have hP' : InPicZero f L (Scheme.Modules.dual (Q.tensorPow n) ⊗ P) :=
    InPicZero.tensor k f L (InPicZero.dual k f L hQn) hP
  obtain ⟨-, ⟨eQQ⟩⟩ := hQn.1.dual_monoidalV2

  have e𝓝 : 𝓝 ≅ (𝓜 ⊗ Q).tensorPow n ⊗ (Scheme.Modules.dual (Q.tensorPow n) ⊗ P) :=
    e ≪≫ whiskerRightIso ((ρ_ _).symm ≪≫ whiskerLeftIso _ eQQ.symm ≪≫ (α_ _ _ _).symm ≪≫
      whiskerRightIso (tensorPowTensorIso 𝓜 Q n).symm _) P ≪≫ α_ _ _ _

  have hKn : (kernelPts f L ((𝓜 ⊗ Q).tensorPow n)).Finite :=
    finite_kernelPts_of_iso_tensorPow_of_finite_kernelPts k f L hc hA (𝓜 ⊗ Q) h𝓜' hK' n hn _ (Iso.refl _)
  have hposn : 0 < Scheme.Modules.geomFibreH0Finrank f ((𝓜 ⊗ Q).tensorPow n) k (RingHom.id k) := by
    rw [← geomFibreH0Finrank_tensor_eq_of_inPicZero_of_kernelPts_finite k f L hc hA g hdim _ (h𝓜'n n) hKn _ hP'
      k (RingHom.id k), ← Scheme.Modules.geomFibreH0Finrank_eq_of_locIsoOnBase f (locIsoOnBase_of_iso e𝓝) k (RingHom.id k)]
    exact hpos k (RingHom.id k)
  rw [geomFibreH0Finrank_id k f _ (h𝓜'n n) 𝒦] at hposn

  have hvan : ∀ t : ℕ, 0 < t → ∀ i : ℕ, Subsingleton ((ofModules f ((𝓜 ⊗ Q).tensorPow t)).HSucc 𝒦 i) :=
    fun t ht i => subsingleton_HSucc_of_iso_tensorPow_of_isSymmetric_of_finite_kernelPts_of_exists_finrank_tensorPow_pos
      k f L hc hA (𝓜 ⊗ Q) h𝓜' hsym hK' ⟨n, hn, hposn⟩ t ht _ (Iso.refl _) 𝒦 i

  obtain ⟨χ₁, hχ⟩ := GoodReductionJacobian.AbelianSchemePropertyBundle.exists_forall_eulerChar_tensorPow_eq_mul_pow
    k f L hc hA g 𝒦 (𝓜 ⊗ Q) h𝓜'

