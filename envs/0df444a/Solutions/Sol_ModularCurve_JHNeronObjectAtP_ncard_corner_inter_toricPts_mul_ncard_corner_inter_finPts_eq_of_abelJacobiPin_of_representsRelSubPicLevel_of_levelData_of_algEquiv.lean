    · rintro ⟨v, ⟨hvT, hv⟩, rfl⟩
      exact ⟨⟨hW _ v.2, (hAnn v).mpr hv⟩, (hmemT v).mp hvT⟩
  have hsymdim : Module.finrank (ZMod p) ↥(T ⊓ LinearMap.range εl) = Module.finrank (ZMod p) ↥(T ⊓ LinearMap.range ε') := by
    have e1 : Set.ncard {x : G | x ∈ ((IharaLemma.cornerSubmodule (M := Tm) (e)).toAddSubgroup).map
