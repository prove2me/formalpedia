section Cons2

variable {sh : Shape} {n Q : ℕ}

variable (Λ : Layout sh n Q)

lemma Layout.actIdx_cons2_add (P L k : ℕ) : (Λ.cons2 P L).actIdx (k + 2) = Λ.actIdx k := by
  unfold Layout.actIdx
  congr 1
  funext i
  simp

lemma Layout.actIdx_cons2_lt (P L k : ℕ) (hk : k < 2) : (Λ.cons2 P L).actIdx k = none := by
  unfold Layout.actIdx
  rw [List.find?_eq_none]
  intro i _
  simp only [cons2_pos, beq_iff_eq]
  omega

lemma act_cons2 (P L p r : ℕ) (x : List ℕ) : act (Λ.cons2 P L) (p :: r :: x) = act Λ x := by
  funext i
  simp [act]

lemma setAct_cons2 (P L p r : ℕ) (x : List ℕ) (v : Fin n → ZMod Q) :
    setAct (Λ.cons2 P L) (p :: r :: x) v = p :: r :: setAct Λ x v := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  rw [getElem_setAct]
  rcases k with _ | _ | k
  · rw [Λ.actIdx_cons2_lt P L 0 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_lt P L 1 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_add]
    simp only [List.getElem_cons_succ]
    rw [getElem_setAct]

lemma amap_cons2 (P L p r : ℕ) (x : List ℕ) (M : Matrix (Fin n) (Fin n) (ZMod Q)) :
    amap (Λ.cons2 P L) M (p :: r :: x) = p :: r :: amap Λ M x := by
  simp only [amap, act_cons2, setAct_cons2]

lemma rowLift_amap {P L : ℕ} (M : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : Valid (P :: L :: sh) a) : rowLift (amap Λ M) a = amap (Λ.cons2 P L) M a := by
  obtain ⟨p, r, x, rfl, -⟩ := valid_cons2 ha
  rw [amap_cons2]; rfl

end Cons2

section ShearAction

variable {rest : Shape} {m Q : ℕ} {M : Type*} [AddCommGroup M]

variable (Λ : Layout rest (m + m) Q) (φ : M →+ Matrix (Fin m) (Fin m) (ZMod Q))

/-- Hypothesis `hπv` of `network_interchange_shear`. -/
lemma shearπ_valid [NeZero Q] (a : M) (x : List ℕ) (hx : Valid rest x) :
    Valid rest (shearπ Λ φ a x) :=
  valid_amap Λ _ hx

/-- Hypothesis `hπadd` of `network_interchange_shear`. -/
lemma shearπ_add [NeZero Q] (a b : M) (x : List ℕ) (hx : Valid rest x) :
    shearπ Λ φ (a + b) x = shearπ Λ φ a (shearπ Λ φ b x) := by
  simp only [shearπ]
  rw [amap_shear_comp Λ _ _ hx, map_add, neg_add_rev]

/-- Hypothesis `hπ0` of `network_interchange_shear`. -/
lemma shearπ_zero (x : List ℕ) (hx : Valid rest x) : shearπ Λ φ 0 x = x := by
  simp only [shearπ, map_zero, neg_zero]
  exact amap_shear_zero Λ hx

/-- **The row-split shear network (Prop. 11, the shear `H ← H + D`).** Split the rows into `W`
role streams, run the gate network with the physical frame changes `Φ_a` = pull by the shear
`-φ a` on the `rest` digits of every stream, and merge back undoing `ρ`. If every gate is OK, the
scalar circuit routes `w` to `ρ w`, and `Mout (ρ w) - Min w = I0` with `φ I0 = 1`, the result is
the pull of the whole array by the shear by `-1` (on every row, prefix and row digits fixed),
i.e. the array permutation realizing `H ← H + D` (see `pull_shear_moves`). -/
theorem shear_network {R : Type*} [CommRing R] [NeZero Q] (P W L : ℕ) [NeZero W]
    (gates : List (NGate (Fin W) R M)) (hg : ∀ g ∈ gates, g.OK)
    (ρ : Fin W → Fin W) (hρ : ∀ (v : Fin W → R) w, scalarRun gates v (ρ w) = v w)
    (Min Mout : Fin W → M) (I0 : M) (hI : ∀ w, Mout (ρ w) - Min w = I0) (hφ : φ I0 = 1)
    (xs : List R) :
    rowMerge P W L rest 0 (fun w => List.ofFn
      (netRun (streamΦ P L rest (shearπ Λ φ) (shearπ_valid Λ φ)) gates Min Mout
        (fun w' i => (rowSplit P W L rest w' 0 xs).getD (i : ℕ) 0) (ρ w))) =
      pull (P :: W * L :: rest) (P :: W * L :: rest) (amap (Λ.cons2 P (W * L)) (shearMat (-1)))
        0 xs := by
  rw [network_interchange_shear P W L rest (shearπ Λ φ) (shearπ_valid Λ φ) (shearπ_add Λ φ)
    (shearπ_zero Λ φ) gates hg ρ hρ Min Mout I0 hI xs]
  apply pull_congr
  intro a ha
  rw [shearπ, hφ, rowLift_amap Λ _ ha]

end ShearAction

section Frames

variable {Wr Ω R M : Type*} [CommRing R] [Fintype Wr] [DecidableEq Wr] [AddGroup M]

omit [Fintype Wr] in
lemma netRunF_coe (Φ : M → (Ω → R) →ₗ[R] (Ω → R)) (gates : List (NGate Wr R M))
    (Min Mout : Wr → M) (f : Wr → Ω → R) :
    netRunF (fun a => ⇑(Φ a)) gates Min Mout f = netRun Φ gates Min Mout f := rfl

omit [Fintype Wr] in
lemma foldl_physStepF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (Mout : Wr → M) :
    ∀ (gates : List (NGate Wr R M)) (st : (Wr → M) × (Wr → Ω → R)),
      FramesOK Pr gates st.1 Mout →
      gates.foldl (physStepF Φ₁) st = gates.foldl (physStepF Φ₂) st ∧
        ∀ w, Pr (Mout w - (gates.foldl (physStepF Φ₁) st).1 w) := by
  intro gates
  induction gates with
  | nil => intro st hF; exact ⟨rfl, hF⟩
  | cons g gs ih =>
    intro st hF
    have e : physStepF Φ₁ st g = physStepF Φ₂ st g := by
      simp only [physStepF, Prod.mk.injEq, true_and]
      funext w
      split_ifs
      · exact Finset.sum_congr rfl fun w' hw' => by rw [h _ (hF.1 w' hw')]
      · rfl
    simp only [List.foldl_cons]
    rw [← e]
    exact ih _ hF.2

omit [Fintype Wr] in
/-- Two implementations agreeing on every frame change that occurs give the same network. -/
theorem netRunF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (gates : List (NGate Wr R M)) (Min Mout : Wr → M)
    (hF : FramesOK Pr gates Min Mout) (f : Wr → Ω → R) :
    netRunF Φ₁ gates Min Mout f = netRunF Φ₂ gates Min Mout f := by
  obtain ⟨e, hp⟩ := foldl_physStepF_congr Pr Φ₁ Φ₂ h Mout gates (Min, f) hF
  funext w
  simp only [netRunF]
  rw [← e, h _ (hp w)]

end Frames

section RunChild

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {α : Type*}

/-- If every delegated interchange is correct, `runC` is the array run of the steps. -/
theorem runC_eq_runArr (child : Fin n → Fin n → List α → List α) (d : α)
    (steps : List (Step n Q))
    (hchild : ∀ a b, Step.swap a b ∈ steps → ∀ ys : List α, ys.length = vol sh →
      child a b ys = (Step.swap a b).arr Λ d ys)
    {xs : List α} (hxs : xs.length = vol sh) : runC Λ child d steps xs = AModel.runArr Λ d steps xs := by
  induction steps generalizing xs with
  | nil => rfl
  | cons s rest ih =>
    simp only [runC, AModel.runArr, List.foldl_cons] at ih ⊢
    have e : stepC Λ child d xs s = s.arr Λ d xs := by
      cases s with
      | shift i u c => rfl
      | swap a b => exact hchild a b List.mem_cons_self xs hxs
    rw [e]
    exact ih (fun a b h => hchild a b (List.mem_cons_of_mem _ h)) (by rw [Step.arr, length_pull])

end RunChild

section Chunks

lemma hdPos_castAdd (A B : Shape) (m : ℕ) (i : Fin m) :
    hdPos A B m (Fin.castAdd m i : ℕ) = A.length + i := by
  simp [hdPos]

lemma hdPos_natAdd (A B : Shape) (m : ℕ) (j : Fin m) :
    hdPos A B m (Fin.natAdd m j : ℕ) = A.length + B.length + m + j := by
  simp [hdPos]; omega

lemma vol_replicate (m N : ℕ) : vol (List.replicate m N) = N ^ m := List.prod_replicate m N

lemma vol_hdShape (A B C : Shape) (m N : ℕ) :
    vol (hdShape A B C m N) = vol (swShape A B C (N ^ m)) := by
  simp only [hdShape, swShape, vol_append, vol_cons, vol_replicate]

/-- Merging `r = Y.length` fields starting at `X.length`. -/
lemma mergeShape_append (X Y Z : Shape) {i r : ℕ} (hi : i = X.length) (hr : r = Y.length) :
    mergeShape (X ++ (Y ++ Z)) i r = X ++ (vol Y :: Z) := by
  subst hi hr
  simp [mergeShape, List.drop_append]

/-- Merging both chunks of `P :: L :: hdShape` gives `P :: L :: swShape` with field `N ^ m`. -/
lemma mergeShape2_hdShape (P L : ℕ) (A B C : Shape) (m N : ℕ) :
    mergeShape2 (P :: L :: hdShape A B C m N) (A.length + 2) (A.length + B.length + m + 2) m =
      P :: L :: swShape A B C (N ^ m) := by
  have h1 : P :: L :: hdShape A B C m N =
      (P :: L :: (A ++ (List.replicate m N ++ B))) ++ (List.replicate m N ++ C) := by
    simp [hdShape]
  have h2 : (P :: L :: (A ++ (List.replicate m N ++ B))) ++ (vol (List.replicate m N) :: C) =
      (P :: L :: A) ++ (List.replicate m N ++ (B ++ (N ^ m :: C))) := by
    simp [vol_replicate]
  unfold mergeShape2
  rw [h1, mergeShape_append _ _ _ (by simp; omega) (by simp), h2,
    mergeShape_append _ _ _ (by simp) (by simp)]
  simp [swShape, vol_replicate]

end Chunks

section SwapBlock

variable {sh : Shape} {m Q : ℕ} [NeZero Q] (Λ : Layout sh (m + m) Q)

/-- For contiguous `H` fields at `c, …, c+m-1` and `D` fields at `c', …, c'+m-1`, the chunk
interchange `(H, D) ↦ (D, H)` moves digit blocks: it is `blockSwap c c' m` on valid addresses. -/
theorem amap_swapMat_eq_blockSwap {c c' : ℕ}
    (hc : ∀ i : Fin m, (Λ.pos (Fin.castAdd m i) : ℕ) = c + i)
    (hc' : ∀ j : Fin m, (Λ.pos (Fin.natAdd m j) : ℕ) = c' + j) (hcc : c + m ≤ c')
    {a : List ℕ} (ha : Valid sh a) : amap Λ swapMat a = blockSwap c c' m a := by
  apply List.ext_getElem (by simp [amap])
  intro k h₁ h₂
  rw [getElem_blockSwap]
  simp only [amap] at h₁ ⊢
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none =>
    have hn := Λ.actIdx_none h
    have o1 : ¬ (c ≤ k ∧ k < c + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.castAdd m ⟨k - c, by omega⟩) (by rw [hc]; simp; omega)
    have o2 : ¬ (c' ≤ k ∧ k < c' + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.natAdd m ⟨k - c', by omega⟩) (by rw [hc']; simp; omega)
    rw [bsIdx_out o1 o2, List.getD_eq_getElem]
  | some t =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only
    induction t using Fin.addCases with
    | left i =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.castAdd m i) = act Λ a (Fin.natAdd m i) :=
        congrFun (hv_swapMat (act Λ a)) i
      rw [e1, val_act Λ ha, hc, hc', bsIdx_left hcc i.2]
    | right j =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.natAdd m j) = act Λ a (Fin.castAdd m j) :=
        congrFun (dv_swapMat (act Λ a)) j
      rw [e1, val_act Λ ha, hc, hc', bsIdx_right hcc j.2]

end SwapBlock

section Level

lemma castHom_apply {m : ℕ} (N : ℕ) (X : IMat m) : castHom m N X = castM N X := rfl

lemma castHom_one (m N : ℕ) : castHom m N 1 = 1 :=
  map_one (Int.castRingHom (ZMod N)).mapMatrix

variable {R : Type*} [CommRing R] {m W : ℕ}

variable [NeZero W] (C : Circuit R m W) {N : ℕ} [NeZero N] (P L' : ℕ) (A B Cs : Shape)

omit [NeZero N] in
lemma childOK_swap {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) (steps : List (Step (m + m) N))
    (hsteps : ∀ a b, Step.swap a b ∈ steps →
      ∃ i j : Fin m, a = Fin.castAdd m i ∧ b = Fin.natAdd m j) :
    ∀ a b, Step.swap a b ∈ steps → ∀ ys : List R,
      ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      child a b ys = (Step.swap a b).arr ((hdLayout A B Cs m N).cons2 P L') 0 ys := by
  intro a b hab ys hys
  obtain ⟨i, j, rfl, rfl⟩ := hsteps a b hab
  rw [hch i j ys hys]
  show _ = pull _ _ (swapMap _ _ _) 0 ys
  rw [swapMap_eq_swapPos]
  simp only [Layout.cons2_pos, hdLayout_pos, hdPos_castAdd, hdPos_natAdd]

omit [NeZero W] in
/-- With correct children, the implemented frame change is the abstract one (`streamΦ` of the
concrete shear action), for every label difference with a valid factorization. -/
theorem implΦ_eq {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) (X : IMat m) (hX : FacAt N C.fac X) :
    implΦ C N P L' A B Cs child X =
      ⇑(streamΦ (R := R) P L' (hdShape A B Cs m N) (shearπ (hdLayout A B Cs m N) (castHom m N))
        (shearπ_valid _ _) X) := by
  obtain ⟨hE₁, hE₂, hd₁, hd₂, hW, hA⟩ := hX
  set Λ := hdLayout A B Cs m N
  have hE₁' : ∀ i j, i < j → castM N (C.fac X).1 i j = 0 := fun i j h => by
    simp [castM, hE₁ i j h]
  have hE₂' : ∀ i j, i < j → castM N (C.fac X).2.2 i j = 0 := fun i j h => by
    simp [castM, hE₂ i j h]
  have hd₁' : ∀ i, IsUnit (castM N (C.fac X).1 i i) := fun i => by simpa [castM] using hd₁ i
  have hd₂' : ∀ i, IsUnit (castM N (C.fac X).2.2 i i) := fun i => by simpa [castM] using hd₂ i
  have hW' : ∀ i j, castM N (C.fac X).2.1 i j = 0 ∨ castM N (C.fac X).2.1 i j = 1 := by
    intro i j; rcases hW i j with h | h <;> simp [castM, h]
  have hA' : castM N X = castM N (C.fac X).1 * castM N (C.fac X).2.1 * castM N (C.fac X).2.2 := by
    conv_lhs => rw [hA]
    simp only [castM, Matrix.map_mul]
  funext f i
  have hl : (List.ofFn f).length = vol (P :: L' :: hdShape A B Cs m N) := by simp
  simp only [implΦ, AModel.edgeSteps]
  rw [runC_eq_runArr _ child 0 _ (childOK_swap P L' A B Cs hch _
      (fun a b h => shearSteps_swap_HD h)) hl,
    ← shear_via_pivots_array (Λ.cons2 P L') hE₁' hE₂' hd₁' hd₂' hW' hA' 0 _ hl,
    ← pull_congr (g := rowLift (shearπ Λ (castHom m N) X))
      (fun a ha => by rw [shearπ, castHom_apply, rowLift_amap Λ _ ha]),
    pull_eq_ofFn_funLeft _ _ (fun _ ha => valid_rowLift (shearπ_valid Λ _ X) ha),
    List.getD_eq_getElem _ _ (by simp only [List.length_ofFn]; exact i.2), List.getElem_ofFn]
  simp only [streamΦ, LinearMap.funLeft_apply]
  rw [List.getD_eq_getElem _ _ (by simp only [List.length_ofFn]; exact Fin.isLt _),
    List.getElem_ofFn]

/-- **Inductive step of Prop. 11, chunk form.** With children correct and the circuit
hypotheses at field size `N`, one level realizes the chunk interchange `(H, D) ↦ (D, H)`
(the pull by `amap swapMat`, its own inverse) on `P :: (W L') :: hdShape`. -/
theorem levelR_correct_amap (hOK : C.OK N)
    {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) {xs : List R}
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    levelR C N P L' A B Cs child xs =
      pull (P :: W * L' :: hdShape A B Cs m N) (P :: W * L' :: hdShape A B Cs m N)
        (amap ((hdLayout A B Cs m N).cons2 P (W * L')) swapMat) 0 xs := by
  have hnet := netRunF_congr (FacAt N C.fac) (implΦ C N P L' A B Cs child)
    (fun X => ⇑(streamΦ (R := R) P L' (hdShape A B Cs m N)
      (shearπ (hdLayout A B Cs m N) (castHom m N)) (shearπ_valid _ _) X))
    (fun X hX => implΦ_eq C P L' A B Cs hch X hX) C.gates C.Min C.Mout hOK.frames
  simp only [netRunF_coe] at hnet
  simp only [levelR]
  simp only [hnet]
  rw [shear_network (hdLayout A B Cs m N) (castHom m N) P W L' C.gates hOK.gatesOK C.ρ
    hOK.route C.Min C.Mout 1 hOK.unit (castHom_one m N)]
  exact (interchange_via_shear_array _ _ (fun _ _ => rfl) 0 xs hxs).symm

/-- **Inductive step of Prop. 11, merged form.** On the shape where each chunk is one field of
size `N ^ m` (`P :: (W L') :: swShape A B Cs (N ^ m)`; reshaping is the identity on the list),
one level is the interchange of these two fields (`swapPos`), the same specification the children
satisfy one level down. -/
theorem levelR_correct (hOK : C.OK N)
    {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) {xs : List R}
    (hxs : xs.length = vol (P :: W * L' :: swShape A B Cs (N ^ m))) :
    levelR C N P L' A B Cs child xs =
      pull (P :: W * L' :: swShape A B Cs (N ^ m)) (P :: W * L' :: swShape A B Cs (N ^ m))
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs := by
  have hxs' : xs.length = vol (P :: W * L' :: hdShape A B Cs m N) := by
    rw [hxs]; simp only [vol_cons, vol_hdShape]
  set Λb := (hdLayout A B Cs m N).cons2 P (W * L')
  have hc : ∀ i : Fin m, (Λb.pos (Fin.castAdd m i) : ℕ) = (A.length + 2) + i := fun i => by
    simp only [Λb, Layout.cons2_pos, hdLayout_pos, hdPos_castAdd]; omega
  have hc' : ∀ j : Fin m, (Λb.pos (Fin.natAdd m j) : ℕ) = (A.length + B.length + m + 2) + j :=
    fun j => by simp only [Λb, Layout.cons2_pos, hdLayout_pos, hdPos_natAdd]; omega
  have hsize : ∀ t : Fin (m + m),
      (P :: W * L' :: hdShape A B Cs m N).getD (Λb.pos t) 0 = N := fun t => by
    rw [List.getD_eq_getElem _ _ (Λb.pos t).2]; simpa using Λb.size t
  rw [levelR_correct_amap C P L' A B Cs hOK hch hxs',
    pull_congr (g' := blockSwap (A.length + 2) (A.length + B.length + m + 2) m)
      (fun a ha => amap_swapMat_eq_blockSwap Λb hc hc' (by omega) ha),
    pull_blockSwap (by omega) (by simp [length_hdShape]; omega) (fun k hk => by
      rw [← hc ⟨k, hk⟩, ← hc' ⟨k, hk⟩, hsize, hsize]),
    mergeShape2_hdShape, show A.length + B.length + m + 2 + 1 - m = A.length + B.length + 3 by
      omega]

end Level

section Recursion

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

lemma replicate_split {N i m : ℕ} (hi : i < m) :
    List.replicate m N = List.replicate i N ++ N :: List.replicate (m - 1 - i) N := by
  rw [← List.replicate_succ, ← List.replicate_add]; congr 1; omega

/-- The child's shape is the stream shape. -/
lemma swShape_child (A B Cs : Shape) {m N : ℕ} (i j : Fin m) :
    swShape (A ++ List.replicate i N) (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j N))
      (List.replicate (m - 1 - j) N ++ Cs) N = hdShape A B Cs m N := by
  simp only [swShape, hdShape, List.append_assoc]
  nth_rw 1 [replicate_split (N := N) i.2]
  rw [replicate_split (N := N) j.2]
  simp [List.append_assoc]

/-- **Proposition 11 (array model), denotation.** For every level `k`, if the circuit hypotheses
hold at every field size `q ^ m ^ k'` and the row count is divisible by `W ^ k`, the level-`k`
program is the interchange of the two fields of size `q ^ m ^ k` (chunks of `m ^ k` digits). -/
theorem prog_correct (C : Circuit R m W) {q : ℕ} (hq : 1 ≤ q)
    (hOK : ∀ k, C.OK (q ^ m ^ k)) :
    ∀ (k P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ k ∣ L →
      xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
      AModel.prog C q k P L A B Cs xs =
        pull (P :: L :: swShape A B Cs (q ^ m ^ k)) (P :: L :: swShape A B Cs (q ^ m ^ k))
          (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs := by
  intro k
  induction k with
  | zero => intro P L A B Cs xs _ _; simp [AModel.prog]
  | succ k ih =>
    intro P L A B Cs xs hL hxs
    have : NeZero (q ^ m ^ k) := ⟨by positivity⟩
    obtain ⟨L', rfl⟩ : W ∣ L := (dvd_pow_self W (Nat.succ_ne_zero k)).trans hL
    have hL' : W ^ k ∣ L' := by
      rw [pow_succ'] at hL
      exact Nat.dvd_of_mul_dvd_mul_left (NeZero.pos W) hL
    have hdiv : W * L' / W = L' := Nat.mul_div_cancel_left L' (NeZero.pos W)
    have hpow : (q ^ m ^ k) ^ m = q ^ m ^ (k + 1) := by rw [← pow_mul, ← pow_succ]
    simp only [AModel.prog, hdiv]
    rw [← hpow] at hxs ⊢
    refine levelR_correct C P L' A B Cs (hOK k) ?_ hxs
    intro i j ys hys
    simp only [Fin.val_castAdd, Fin.val_natAdd, Nat.add_sub_cancel_left,
      show m + m - 1 - (m + j) = m - 1 - j by omega]
    rw [ih P L' _ _ _ ys hL' (by rw [swShape_child]; exact hys), swShape_child]
    have := i.2
    congr 2
    · simp
    · simp; omega

end Recursion

section CostDefs

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

lemma netCost_eq (fc : M → ℝ) (v : ℝ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      netCost fc v gates lab Mout = frameSum fc gates lab Mout + v * touched gates := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [netCost, frameSum, touched]
  | cons g gs ih =>
    intro lab Mout
    simp only [netCost, frameSum, touched, List.map_cons, List.sum_cons, Nat.cast_add] at ih ⊢
    rw [ih, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    ring

lemma frameSum_congr {β : Type*} [AddCommMonoid β] (Pr : M → Prop) (f g : M → β)
    (h : ∀ a, Pr a → f a = g a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M), FramesOK Pr gates lab Mout →
      frameSum f gates lab Mout = frameSum g gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout hF; exact Finset.sum_congr rfl fun w _ => h _ (hF w)
  | cons g gs ih =>
    intro lab Mout hF
    simp only [frameSum]
    rw [Finset.sum_congr rfl fun w hw => h _ (hF.1 w hw), ih _ _ hF.2]

lemma frameSum_lin (α β : M → ℝ) (v t : ℝ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum (fun a => α a * v + β a * t) gates lab Mout =
        frameSum α gates lab Mout * v + frameSum β gates lab Mout * t := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum, Finset.sum_add_distrib, Finset.sum_mul]
  | cons g gs ih =>
    intro lab Mout
    simp only [frameSum, ih, Finset.sum_add_distrib, ← Finset.sum_mul]
    ring

lemma frameSum_cast (f : M → ℕ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      ((frameSum f gates lab Mout : ℕ) : ℝ) = frameSum (fun a => (f a : ℝ)) gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum]
  | cons g gs ih => intro lab Mout; simp [frameSum, ih]

lemma frameSum_nonneg (f : M → ℝ) (hf : ∀ a, 0 ≤ f a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M), 0 ≤ frameSum f gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout; exact Finset.sum_nonneg fun w _ => hf _
  | cons g gs ih =>
    intro lab Mout
    exact add_nonneg (Finset.sum_nonneg fun w _ => hf _) (ih _ _)

end CostDefs

section StepCost

variable {n Q : ℕ}

lemma runCost_eq (T : ℝ → ℝ) (v : ℝ) (steps : List (Step n Q)) :
    runCost T v steps = (steps.countP (fun s => !s.isSwap) : ℝ) * v +
      (steps.countP Step.isSwap : ℝ) * T v := by
  induction steps with
  | nil => simp [runCost]
  | cons s l ih =>
    simp only [runCost, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, List.countP_cons, List.countP_cons]
    cases s.isSwap <;> simp <;> ring

lemma countP_not_add (steps : List (Step n Q)) :
    steps.countP (fun s => !s.isSwap) + steps.countP Step.isSwap = steps.length := by
  induction steps with
  | nil => rfl
  | cons s l ih =>
    rw [List.countP_cons, List.countP_cons, List.length_cons]
    cases s.isSwap <;> simp <;> omega

lemma length_revSteps (l : List (Step n Q)) : (revSteps l).length = l.length := by
  simp [revSteps]

variable {m : ℕ}

lemma length_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).length = 4 * m + 3 * (pivots W).length := by
  have h3 : ∀ ps : List (Fin m × Fin m), (addSteps ps : List (Step (m + m) Q)).length =
      3 * ps.length := by
    intro ps
    induction ps with
    | nil => rfl
    | cons p ps ih =>
      have e : (addSteps (p :: ps) : List (Step (m + m) Q)) = pivotSteps p.1 p.2 ++ addSteps ps := by
        simp [addSteps]
      rw [e, List.length_append, ih]; simp [pivotSteps]; ring
  simp only [shearSteps, List.length_append, length_revSteps, h3]
  simp [hSteps, dSteps, hIdx, dIdx]
  ring

end StepCost

section ProgCost

variable {R : Type*} [CommRing R] {m W : ℕ}

lemma countP_edgeSteps (C : Circuit R m W) {N : ℕ} (hN : 1 < N) {A : IMat m}
    (hA : FacAt N C.fac A) : (AModel.edgeSteps C N A).countP Step.isSwap = pivRank C A := by
  have : Fact (1 < N) := ⟨hN⟩
  rw [AModel.edgeSteps, countP_shearSteps, pivRank]
  congr 1
  apply Finset.filter_congr
  intro p _
  rcases hA.2.2.2.2.1 p.1 p.2 with h | h <;> simp [castM, h]

lemma length_edgeSteps (C : Circuit R m W) {N : ℕ} (hN : 1 < N) {A : IMat m}
    (hA : FacAt N C.fac A) : (AModel.edgeSteps C N A).length = 4 * m + 3 * pivRank C A := by
  rw [← countP_edgeSteps C hN hA, AModel.edgeSteps, countP_shearSteps, length_shearSteps, length_pivots]

lemma runCost_edgeSteps (C : Circuit R m W) {N : ℕ} (hN : 1 < N) (T : ℝ → ℝ) (v : ℝ)
    {A : IMat m} (hA : FacAt N C.fac A) :
    runCost T v (AModel.edgeSteps C N A) = (4 * m + 2 * pivRank C A : ℝ) * v + (pivRank C A : ℝ) * T v := by
  have h1 := countP_edgeSteps C hN hA
  have h2 := length_edgeSteps C hN hA
  have h3 := countP_not_add (AModel.edgeSteps C N A)
  have h4 : (AModel.edgeSteps C N A).countP (fun s => !s.isSwap) = 4 * m + 2 * pivRank C A := by omega
  rw [runCost_eq, h4, h1]
  push_cast; ring

/-- **The cost recurrence of Prop. 11 (eq. (12)).** One level costs `C₀ V + s T(V / W)`. -/
theorem levelCost_eq (C : Circuit R m W) {N : ℕ} (hN : 1 < N)
    (hfr : FramesOK (FacAt N C.fac) C.gates C.Min C.Mout) (T : ℝ → ℝ) (V : ℝ) :
    levelCost C N T V = costConst C * V + (rankSum C : ℝ) * T (V / W) := by
  rw [levelCost, netCost_eq,
    frameSum_congr (FacAt N C.fac) _
      (fun X => (4 * m + 2 * pivRank C X : ℝ) * (V / W) + (pivRank C X : ℝ) * T (V / W))
      (fun X hX => runCost_edgeSteps C hN T (V / W) hX) _ _ _ hfr,
    frameSum_lin, rankSum, frameSum_cast, costConst]
  simp only [subSteps, flipSteps, List.length_map, List.length_finRange]
  ring

lemma one_le_costConst (C : Circuit R m W) : 1 ≤ costConst C := by
  have h := frameSum_nonneg (fun A => (4 * m + 2 * pivRank C A : ℝ)) (fun A => by positivity)
    C.gates C.Min C.Mout
  rw [costConst]
  have : 0 ≤ (frameSum (fun A => (4 * m + 2 * pivRank C A : ℝ)) C.gates C.Min C.Mout +
    touched C.gates) / W := by positivity
  have : (0 : ℝ) ≤ m := by positivity
  linarith

/-- **Proposition 11 (array model), cost.** If the frame changes have valid factorizations at
every level and `s / W < m ^ τ` (`s = rankSum C = Σ_e r_e`), the program's cost is
`O(V (m ^ k) ^ τ)`: `T_k(V) ≤ K V e ^ τ` with `e = m ^ k` the chunk length in digits. -/
theorem prog_cost (C : Circuit R m W) {q : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m) (hW : 1 ≤ W)
    (hfr : ∀ k, FramesOK (FacAt (q ^ m ^ k) C.fac) C.gates C.Min C.Mout)
    {τ : ℝ} (hτ : 0 < τ ∧ τ < 1) (hs : (rankSum C : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ k V, 0 ≤ V → progCost C q k V ≤ K * V * ((m : ℝ) ^ k) ^ τ := by
  obtain ⟨K, hK0, hK⟩ := power_width_time m W (rankSum C) τ (costConst C) hm hW hτ hs
    (by linarith [one_le_costConst C])
  refine ⟨K, hK0, hK (progCost C q) (fun V hV => ?_) (fun k V _ => ?_)⟩
  · simp only [progCost]
    nlinarith [one_le_costConst C]
  · have hN : 1 < q ^ m ^ k := Nat.one_lt_pow (by positivity) (by omega)
    simp only [progCost]
    rw [levelCost_eq C hN (hfr k)]

end ProgCost

section Assembled

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- The chunk interchange on the digit shape: if the two chunks are runs of `e` radix-`q`
digits (`P :: L :: hdShape A B Cs e q`), swapping the two merged fields is the block swap of
the two digit runs. -/
theorem pull_swapPos_eq_blockSwap (P L : ℕ) (A B Cs : Shape) (e q : ℕ) (xs : List R) :
    pull (P :: L :: swShape A B Cs (q ^ e)) (P :: L :: swShape A B Cs (q ^ e))
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs =
      pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
        (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs := by
  have hg : ∀ k, k < e + e → (P :: L :: hdShape A B Cs e q).getD (hdPos A B e k + 2) 0 = q :=
    fun k hk => by simpa using hdShape_getD A B Cs e q k hk
  rw [pull_blockSwap (by omega) (by simp [length_hdShape]; omega) (fun k hk => by
      have h1 := hg k (by omega)
      have h2 := hg (e + k) (by omega)
      simp only [hdPos, if_pos hk, if_neg (show ¬ e + k < e by omega)] at h1 h2
      rw [show A.length + 2 + k = A.length + k + 2 by omega, h1,
        show A.length + B.length + e + 2 + k = A.length + B.length + (e + k) + 2 by omega, h2]),
    mergeShape2_hdShape, show A.length + B.length + e + 2 + 1 - e = A.length + B.length + 3 by
      omega]

end Assembled

end AModel

end

section
open AModel
open Matrix
variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]
theorem solution (C : AModel.Circuit R m W) {q : ℕ} (hq : 2 ≤ q) (hm : 2 ≤ m)
    (hOK : ∀ k, C.OK (q ^ m ^ k)) {τ : ℝ} (hτ : 0 < τ ∧ τ < 1)
    (hs : (AModel.rankSum C : ℝ) / W < (m : ℝ) ^ τ) :
    (∀ (k P L : ℕ) (A B Cs : AModel.Shape) (xs : List R), W ^ k ∣ L →
      xs.length = AModel.vol (P :: L :: AModel.hdShape A B Cs (m ^ k) q) →
      AModel.prog C q k P L A B Cs xs =
        AModel.pull (P :: L :: AModel.hdShape A B Cs (m ^ k) q) (P :: L :: AModel.hdShape A B Cs (m ^ k) q)
          (AModel.blockSwap (A.length + 2) (A.length + B.length + m ^ k + 2) (m ^ k)) 0 xs) ∧
    ∃ K : ℝ, 0 ≤ K ∧ ∀ k V, 0 ≤ V → AModel.progCost C q k V ≤ K * V * ((m : ℝ) ^ k) ^ τ := by
  refine ⟨fun k P L A B Cs xs hL hxs => ?_,
    AModel.prog_cost C hq hm (NeZero.pos W) (fun k => (hOK k).frames) hτ hs⟩
  rw [AModel.prog_correct C (by omega) hOK k P L A B Cs xs hL
    (by rw [hxs]; simp only [AModel.vol_cons, AModel.vol_hdShape]), AModel.pull_swapPos_eq_blockSwap]
end
