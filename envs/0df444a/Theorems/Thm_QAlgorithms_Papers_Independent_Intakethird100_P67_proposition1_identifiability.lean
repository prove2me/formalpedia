-- title:
--   Proposition 1: necessary and sufficient identifiability condition
-- statement:
--   Let $S=\{\rho_k\}_{k=1}^K$, $K\ge1$, be density operators in a finite-dimensional complex system. Let $H_{\rm in}$ be the span of their supports and $\Pi$ its orthogonal projector. The complex algebra generated by the samples is understood as the span of nonempty products, whose supported identity is $\Pi$. Then
--
--   $$\operatorname{Alg}_{\mathbb C}(S)=\mathcal L(H_{\rm in})$$
--
--   if and only if every pair of ambient unitaries $U,V$ with $U\rho_kU^\dagger=V\rho_kV^\dagger$ for all $k$ also has $U\rho U^\dagger=V\rho V^\dagger$ for every density operator $\rho$ supported on $H_{\rm in}$. Thus the records determine the supported unitary action up to a global phase. The statement uses density outputs rather than arbitrary choices of vector phases.
-- source:
--   Universal Quantum Emulator, arXiv:1606.02734v2, PDF p. 2, Proposition 1: necessary and sufficient identifiability condition

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P67

noncomputable section

open scoped ComplexConjugate Matrix Matrix.Norms.L2Operator

attribute [local instance] Classical.propDecidable

open MeasureTheory Filter

namespace QAlgorithms.Papers.Independent.Intakethird100.P67

variable {I J K L A : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Fintype K] [DecidableEq K]
  [Fintype L] [DecidableEq L] [Fintype A] [DecidableEq A]

/-- PDF pp.2–3, Proposition 1: equality of sample density outputs identifies precisely
unitary conjugation on every supported state, iff the supported algebra is full. -/
theorem proposition1_identifiability [Nonempty K] (S : K → Matrix I I ℂ)
    (hS : ∀ k, IsDensityMatrix (S k)) :
    Generates S ↔ ∀ U V : Matrix.unitaryGroup I ℂ,
      (∀ k, densityConjugation (U : Matrix I I ℂ) (S k) = densityConjugation (V : Matrix I I ℂ) (S k)) →
      ∀ rho : Matrix I I ℂ, IsDensityMatrix rho → InSampleSupport S rho →
        densityConjugation (U : Matrix I I ℂ) rho = densityConjugation (V : Matrix I I ℂ) rho := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P67

end
