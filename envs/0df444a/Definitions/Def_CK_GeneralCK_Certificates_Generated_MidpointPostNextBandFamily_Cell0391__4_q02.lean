theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨584940185976,600333348766⟩ ⟨674918862952,679602092817⟩ ⟨266655758991,325981008380⟩ := rfl
noncomputable def centerUpper : ℝ := (2062851222757 / 1099511627776)
