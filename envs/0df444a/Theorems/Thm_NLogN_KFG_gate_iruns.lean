theorem NLogN.KFG.gate_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {W m n : ℕ} (T : Butterfly.Op (Fin n)) (as : List Atom) (hok : ∀ a ∈ as, a.Ok W)
    (hts : NoTS as) (e : ℕ → ℕ) (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI)
    (l : List ℤ) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : ScRep e zs x)
    (h0 : f 0 = gflat zs ++ l) (hC : ClP f) (wb Z : ℕ) (hb : NLogN.KFB.GB wb zs)
    (hZ : zsz ((2 * (W * 2 ^ (m * n)) : ℕ) : ℤ) ≤ Z) :
    ∃ zs', ScRep (gateE as e) zs'
        ((P8Lift.RStep.den T (P8Lift.RStep.gate (m := m) (gateMat W as))).mulVec x) ∧
      NLogN.KFB.GB (gateW as e wb) zs' ∧
      IRuns I iprog (fcode (gateP as e (2 ^ (m * n)))) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l))) (cGate as e wb (2 ^ (m * n)) W Z) := by sorry
