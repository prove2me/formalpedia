/-!
# B5 `J` side, part K18: stage 3 — elimination and serialization

`jS3 = (11 := λ+w; 12 := (s-λ-w)⁺; 21 := 2^kJ); elimP; (28 := m; 11; 12); serP` (`Rn.jS3`):
`flatT fs ++ flatB kJ bs` in front of `41`, `22 := nBd bs`, `23 :=` its length.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem den_cbE {v : Vr} {s lam w : ℕ} (h22 : v 22 = s) (h24 : v 24 = lam) (h26 : v 26 = w) :
    cbE.den v = ((s - lam - w : ℕ) : ℤ) := by
  simp only [cbE, den_mx0E, E.den, h22, h24, h26]
  omega

/-- **Stage 3.** -/
theorem Rn.jS3_sol_aux {Q W N s lam w kJ : ℕ} {L : List ℕ} {A : ℕ → ℕ → ℤ} {v : Vr} {c : Cs}
    {a1 a2 a3 a4 : ℤ}
    (hN : N ≤ 2 ^ W) (hN5 : 5 ≤ N) (hW2 : 2 ≤ W) (hv : BV W v)
    (h9 : v 9 = 2 ^ Q) (h10 : v 10 = 2 ^ (Q + 1)) (h22 : v 22 = s) (h24 : v 24 = lam)
    (h26 : v 26 = w) (h28 : v 28 = L.length)
    (hSt : c sSt = [((2 ^ kJ : ℕ) : ℤ), a1, a2, a3, a4]) (hStb : ∀ x ∈ c sSt, |x| ≤ 2 ^ W)
    (h30 : c 30 = L.map (fun j : ℕ => (j : ℤ))) (h31 : c 31 = [(L.length : ℤ)])
    (h14 : c 14 = matL (fun i k => A (Lg L i) (Lg L k)) L.length)
    (hE : ∀ j ∈ ([15, 16, 17, 18, 19, 27, 47, 48, 50, 51] : List (Fin HS)), c j = [])
    (hlwW : lam + w ≤ 2 ^ W) (hsW : s ≤ 2 ^ W)
    (hW8 : 8 * (L.length + 1) ^ 2 ≤ 2 ^ W) (hLb : ∀ j ∈ L, j ≤ 2 ^ W)
    (hMb : ∀ q ≤ L.length, ∀ i < L.length, ∀ k < L.length,
      |Mseq Q (bandS (lam + w) (s - lam - w)) L A q i k| ≤ 2 ^ W) :
    Rn jS3 v c (fun v' => (∀ j ∈ ([9, 10, 20, 24, 25, 26] : List (Fin HS)), v' j = v j) ∧
        v' 21 = ((2 ^ kJ : ℕ) : ℤ) ∧ v' 28 = L.length ∧
        v' 22 = JK.nBd (bsOf Q L (lam + w) (s - lam - w) A) ∧
        v' 23 = ((JK.flatT (fsOf Q L (lam + w) (s - lam - w) A) ++
          JK.flatB kJ (bsOf Q L (lam + w) (s - lam - w) A)).length : ℤ) ∧ BV W v')
      (update (update c 14 (matL (Mseq Q (bandS (lam + w) (s - lam - w)) L A L.length) L.length)) 41
        (JK.flatT (fsOf Q L (lam + w) (s - lam - w) A) ++
          JK.flatB kJ (bsOf Q L (lam + w) (s - lam - w) A) ++ c 41))
      (cJS3 W N L.length) := by
  unfold PJ.jS3 cJS3
  set m := L.length with hm
  set mw := lam + w with hmw
  set cB := s - lam - w with hcB
  have hcBW : cB ≤ 2 ^ W := by omega
  have hmW : m ≤ 2 ^ W := by nlinarith
  -- jC
  set u1 := update (update (update (update v 11 (mw : ℤ)) 12 (cB : ℤ)) 29 0) 21
    ((2 ^ kJ : ℕ) : ℤ) with hu1
  have d12 : cbE.den (update v 11 (mw : ℤ)) = (cB : ℤ) :=
    den_cbE (by rw [update_of_ne (by decide), h22]) (by rw [update_of_ne (by decide), h24])
      (by rw [update_of_ne (by decide), h26])
  have s1 : Ins.run (.a 11 (.add (.r 24) (.r 26))) (v, c) = (update v 11 (mw : ℤ), c) := by
    simp only [Ins.run, E.den, h24, h26, hmw, Nat.cast_add]
  have s2 : Ins.run (.a 12 cbE) (update v 11 (mw : ℤ), c) =
      (update (update v 11 (mw : ℤ)) 12 (cB : ℤ), c) := by simp only [Ins.run, d12]
  have s3 : Ins.run (.rd sSt (.k 0) 21) (update (update v 11 (mw : ℤ)) 12 (cB : ℤ), c) =
      (u1, c) := by
    simp only [Ins.run, E.den, hSt, Int.toNat_zero, List.getD_cons_zero, hu1]
  have eC : runL jC (v, c) = (u1, c) := by simp only [jC, runL]; rw [s1, s2, s3]
  have RC := Rn.insL (c := c) hN jC hv (by
    simp only [jC, OkL, s1, s2]
    refine ⟨?_, ?_, ?_, trivial⟩ <;> simp only [Ins.ok]
    · refine ⟨by decide, rfl, Nat.one_le_two_pow, ?_⟩
      simp only [E.den, h24, h26]
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast hlwW
    · refine ⟨by decide, rfl, by simp only [cbE, mx0E, E.lb]; norm_num <;> exact Nat.one_le_two_pow, ?_⟩
      rw [d12, abs_of_nonneg (by positivity)]; exact_mod_cast hcBW
    · refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl,
        by simp only [E.lb]; norm_num <;> exact Nat.one_le_two_pow, by simp [E.den], by simp [E.den, hSt],
        by simp [hSt]; omega, hStb⟩)
  rw [eC] at RC
  dsimp only at RC
  refine Rn.seq RC (fun w1 ⟨e1, b1⟩ => ?_)
  subst w1
  have q1 : ∀ j : Fin HS, j ≠ 11 → j ≠ 12 → j ≠ 29 → j ≠ 21 → u1 j = v j := fun j a b c' d => by
    rw [hu1, update_of_ne d, update_of_ne c', update_of_ne b, update_of_ne a]
  -- elimination
  have RE := Rn.elimP (Q := Q) (W := W) (B := W) (m := m) (mw := mw) (cB := cB) (L := L) (A := A)
    (v := u1) (c := c) b1
    (by rw [q1 9 (by decide) (by decide) (by decide) (by decide), h9])
    (by rw [q1 10 (by decide) (by decide) (by decide) (by decide), h10])
    (by rw [q1 28 (by decide) (by decide) (by decide) (by decide), h28])
    (by rw [hu1, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide),
      update_self])
    (by rw [hu1, update_of_ne (by decide), update_of_ne (by decide), update_self])
    h30 rfl h14 hE hMb le_rfl (by omega) (by nlinarith) hLb
  refine Rn.seq RE (fun w2 ⟨f2, b2⟩ => ?_)
  set c2 := update c 14 (matL (Mseq Q (bandS mw cB) L A m) m) with hc2
  have r21 : w2 21 = ((2 ^ kJ : ℕ) : ℤ) := by rw [f2 21 (by decide), hu1, update_self]
  have r22 : w2 22 = s := by
