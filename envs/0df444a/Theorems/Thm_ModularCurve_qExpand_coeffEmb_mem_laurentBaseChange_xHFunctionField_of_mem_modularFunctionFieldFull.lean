theorem ModularCurve.qExpand_coeffEmb_mem_laurentBaseChange_xHFunctionField_of_mem_modularFunctionFieldFull
    (L : Type) [Field L] [CharZero L] (M' : ℕ) [NeZero M'] (d : ℕ) [NeZero d] (N : ℕ) (hN : M' * d ∣ N)
    (H : Subgroup (ZMod N)ˣ)
    (g : LaurentSeries ℚ) (hg : g ∈ ModularCurve.modularFunctionFieldFull M') :
    ModularCurve.qExpand L d (ModularCurve.coeffEmb L g) ∈
      ModularCurve.laurentBaseChange L (ModularCurve.xHFunctionField N H) := by sorry
