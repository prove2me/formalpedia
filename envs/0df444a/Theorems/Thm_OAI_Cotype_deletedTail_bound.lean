open OAI OAI.Cotype
open scoped BigOperators
variable {m : ℕ}

theorem OAI.Cotype.deletedTail_bound {f : SignMatrix m → ℝ} {M s u : ℝ} {d : ℕ}
    (hM : 0 ≤ M) (hf : ∀ S, |f S| ≤ M) (hd : 4 ≤ d)
    (hm : (m : ℝ) ≤ (2 : ℝ)^(d-2)) (hs : |s| ≤ 1) (hu : |u| ≤ 1) :
    |deletedTail f d s u| ≤ M := by sorry
