    have h2 := NLogN.KFL.cFrom_le N w
    have hx : (1 : ℝ) ≤ (u : ℝ) ^ τS := Real.one_le_rpow (by exact_mod_cast hu) (by norm_num)
    have hc := NLogN.KFW.cost_comb2 (cto := 2000 * NLogN.KFL.cTo N w) (cfr := 2000 * NLogN.KFL.cFrom N w) (c := c2) (N := N)
      (w := w) (K := K) (x := (u : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS) hK hx (by omega) (by omega)
      (by simpa [N, mul_comm, IntMul.OpenAI.R129.P.NLogN.KFS.τS] using hc2)
    refine le_trans hc (le_of_eq ?_)
    ring
end
