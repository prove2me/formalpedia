  obtain ⟨u, hu, h⟩ := hϖt
  have hqQ : (q : AlgebraicClosure ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hq0
  have hqk : (q : ↥k₀) ≠ 0 := Nat.cast_ne_zero.mpr hq0
  set uk : ↥k₀ := ϖt ^ (q ^ 2 - 1) / (q : ↥k₀) with huk
  have hukval : ((uk : ↥k₀) : AlgebraicClosure ℚ) = (u : AlgebraicClosure ℚ) := by
    rw [huk]; push_cast; rw [h]; field_simp
  have hukA : uk ∈ A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)) := by
    show ((uk : ↥k₀) : AlgebraicClosure ℚ) ∈ A; rw [hukval]; exact u.2
  obtain ⟨w, hw⟩ := hu.exists_right_inv
  have hu0 : (u : AlgebraicClosure ℚ) ≠ 0 := by
    intro h0; have := congrArg (fun z : ↥A => (z : AlgebraicClosure ℚ)) hw; simp [h0] at this
  have hwval : ((w : ↥A) : AlgebraicClosure ℚ) = ((uk⁻¹ : ↥k₀) : AlgebraicClosure ℚ) := by
    push_cast; rw [hukval]
    have := congrArg (fun z : ↥A => (z : AlgebraicClosure ℚ)) hw
    push_cast at this
    exact (eq_inv_of_mul_eq_one_right this)
  have hukinvA : uk⁻¹ ∈ A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)) := by
    show ((uk⁻¹ : ↥k₀) : AlgebraicClosure ℚ) ∈ A; rw [← hwval]; exact w.2
  have huk0 : uk ≠ 0 := fun h0 => hu0 (by rw [← hukval, h0]; rfl)
  refine ⟨⟨uk, hukA⟩, ?_, ?_⟩
  · exact IsUnit.of_mul_eq_one (⟨uk⁻¹, hukinvA⟩ : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) (Subtype.ext (mul_inv_cancel₀ huk0))
  · apply Subtype.ext
    show ϖt ^ (q ^ 2 - 1) = (q : ↥k₀) * uk
    rw [huk]; field_simp

