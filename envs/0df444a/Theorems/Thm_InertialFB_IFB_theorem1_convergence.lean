-- title:
--   Theorem 1: the IFB iterates minimize $\Theta=\Phi+\Psi$ and converge weakly to a minimizer
-- statement:
--   Let $H$ be a real Hilbert space and let Hypothesis H hold: $\Phi : H\to\mathbb R\cup\{+\infty\}$ is proper, lower semicontinuous and convex; $\Psi : H \to \mathbb R$ is differentiable with $L_\Psi$-Lipschitz gradient (not necessarily convex); $a, b > 0$ and $0 < \lambda < \min\{1/a,\ 2(a+b)/(bL_\Psi)\}$; and $\Theta = \Phi + \Psi$ is convex and bounded from below. Let $(u_k, y_k)$ be generated by algorithm (IFB) from an arbitrary initial pair $(u_0, y_0) \in H\times H$. Then
--   $$\lim_{k\to\infty}\Theta(u_k) = \inf\Theta.$$
--   Assume moreover that $\mathcal S = \operatorname{Argmin}\Theta \ne \emptyset$ and that one of the following holds:
--
--   1. $\mathcal S$ is a singleton;
--   2. $\Phi$ is (real-valued and) differentiable and $\nabla\Phi$ is weak-to-weak sequentially continuous;
--   3. $\nabla\Psi$ is weak-to-weak sequentially continuous;
--   4. $\Psi$ is convex.
--
--   Then $u_k \rightharpoonup p$ weakly for some $p \in \mathcal S$. On the other hand, if $\mathcal S = \emptyset$, then $\|u_k\| \to +\infty$.
--
--   This is the main result of the paper: an inertial forward-backward method whose step-size bound $\Lambda$ can exceed the classical $2/L_\Psi$, and which tolerates a nonconvex smooth part $\Psi$ as long as the sum $\Theta$ is convex.
--
--   **Formalization Note** $\Phi$ and $\Theta$ are `EReal`-valued; the limit of $\Theta(u_k)$ is in `EReal`. Case ii) is expressed by a real-valued differentiable $\varphi$ that agrees with $\Phi$ everywhere; weak-to-weak sequential continuity is the predicate `WeakSeqContinuous`. The step size $\lambda$ is written `lam`. The three clauses of the theorem are one conjunction.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 4, Theorem 1

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_InertialFB_IFB_Algorithm
import Definitions.Def_InertialFB_IFB_Lyapunov

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- **Theorem 1** (Attouch–Peypouquet–Redont, p. 4). Let Hypothesis H hold and let `(u_k, y_k)`
be generated by (IFB) from any initial pair. Then `Θ(u_k) → inf Θ`. If moreover
`S = Argmin Θ ≠ ∅` and one of i) `S` is a singleton, ii) `Φ` is differentiable with
weak-to-weak sequentially continuous gradient, iii) `∇Ψ` is weak-to-weak sequentially
continuous, iv) `Ψ` is convex, holds, then `u_k` converges weakly to a point of `S`.
If `S = ∅`, then `‖u_k‖ → +∞`. -/
theorem theorem1_convergence (Φ : H → EReal) (Ψ : H → ℝ) (L a b lam : ℝ)
    (hH : HypothesisH Φ Ψ L a b lam) (u y : ℕ → H) (hIFB : IsIFBSeq Φ Ψ a b lam u y) :
    Tendsto (fun k => theta Φ Ψ (u k)) atTop (𝓝 (⨅ x, theta Φ Ψ x)) ∧
    ((argminSet Φ Ψ).Nonempty →
      ((∃ p : H, argminSet Φ Ψ = {p}) ∨
        (∃ φ : H → ℝ, (∀ x, Φ x = (φ x : EReal)) ∧ Differentiable ℝ φ ∧
          WeakSeqContinuous (gradient φ)) ∨
        WeakSeqContinuous (gradient Ψ) ∨
        ConvexOn ℝ Set.univ Ψ) →
      ∃ p ∈ argminSet Φ Ψ, WeakTendsto u p) ∧
    (argminSet Φ Ψ = ∅ → Tendsto (fun k => ‖u k‖) atTop atTop) := by sorry

end InertialFB.IFB
