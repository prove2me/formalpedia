-- title:
--   Lemma 3 — bounded-product Kazhdan comparison (corrected: vector-first Kazhdan)
-- statement:
--   Let H be generated by S, let $\phi_i:H\to G$ be homomorphisms, and suppose every element of G is a product of at most a positive integer M elements from the union of their images. Every nonnegative Kazhdan lower bound κ for (H,S) gives
--
--   $$
--   K\left(G;\bigcup_i\phi_i(S)\right)\ge\frac{\kappa}{M\sqrt2}.
--   $$
--
--   The lower-bound formulation ranges over arbitrary Hilbert-space representations and retains the source’s factor $1/(M\sqrt2)$.
--
--   Differences from the source:
--   - correction: Definition 4 puts the generator before the unit vector → the generator may depend on the unit vector; reason: for G=(Z/2)^2 and S={a,b}, rho(a)=diag(-1,1,-1), rho(b)=diag(1,-1,-1) has no invariant vector but each generator fixes a unit vector; the printed constant is 0 while the vector-first constant is sqrt(2) and the average squared-displacement constant is 2
--   - encoding: numerical Kazhdan constants and their inequalities → transport of every nonnegative lower bound over all Hilbert representations; reason: this expresses the full bound without an empty real infimum; finite-group averages agree with the irreducible-representation definition
-- source:
--   Guoding Liu, Jonas Helsen, STOC 2027 submission #221 (October 2026), p. 12, Lemma 3. https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/221.pdf

import Definitions.Def_LiuHelsenDesigns_OneD_kazhdanBounds

universe u3

namespace LiuHelsenDesigns.OneD
theorem lemma_3 (H G I : Type u3) [Group H] [Group G]
    (S : Set H) (hgen : Subgroup.closure S = ⊤) (φ : I → H →* G)
    (M : ℕ) (hM : 0 < M)
    (hprod : BoundedProducts {g | ∃ i : I, g ∈ (φ i).range} M)
    (κ : ℝ) (hκ : 0 ≤ κ) (hH : KazhdanLower H S κ) :
    KazhdanLower G {g | ∃ i : I, ∃ s ∈ S, φ i s = g}
      (κ / (M * Real.sqrt 2)) := by sorry
end LiuHelsenDesigns.OneD
