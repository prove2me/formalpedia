theorem NLogN.GL.roundP_all (M : MulSpec) {m Φm : ℕ} (hM : MulBnd M m Φm) (cN : Fin HS) (hcN : IsCnt cN)
    (S2 : ℤ) (c p Q N : ℕ) (s : IState HS) (Y : List (ℤ × ℤ)) (R LN LQ LC LP LR : List Item)
    (hY : s.G gD = gints Y ++ R) (hl : Y.length = N) (hN : s.G cN = .int N :: LN)
    (hQ' : s.G gPQ = .int S2 :: LQ) (hC : s.G gPC = .int (2 ^ (c + 1)) :: LC)
    (hP : s.G gPP = .int (2 ^ p) :: LP) (hR : s.G gPR = .int (2 ^ (p + 1)) :: LR)
    (hYb : GB m Y) (hS : zsz S2 ≤ m) (hBQ : 2 * m + c + p + 6 ≤ Q)
    (hNQ : zsz ((2 * N : ℕ) : ℤ) ≤ Q) :
    (roundP cN).run s = s.upd gD (ints (Y.map (rndF S2 c p)) ++ R) ∧
    (roundP cN).ok M s ∧
    (roundP cN).cost M s ≤ N * (Φm + 200000 * (Q + 2)) + 20000 * (Q + 2) := by sorry
