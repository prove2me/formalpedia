import Definitions.Def_MixingCoefficients

open MeasureTheory MeasurableSpace
open MarkovChainCLT

set_option maxHeartbeats 1000000

/-- The σ-algebra generated by the coordinates up to time `k` is the one pulled back
along the restriction to `Iic k`. -/
theorem solution {X : Type*} [MeasurableSpace X] (k : ℕ) :
    processSigma (fun i (ω : ℕ → X) => ω i) (Set.Iic k)
      = MeasurableSpace.comap
          (fun ω : ℕ → X => fun i : Finset.Iic k => ω i.1) inferInstance := by
  rw [show (inferInstance : MeasurableSpace (Π _i : Finset.Iic k, X)) = ⨆ a : Finset.Iic k,
      MeasurableSpace.comap (fun u : Π _i : Finset.Iic k, X => u a) inferInstance from rfl,
    MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, Function.comp_def]
  refine le_antisymm (iSup₂_le (fun i hi => ?_)) (iSup_le (fun a => ?_))
  · exact le_iSup_of_le ⟨i, Finset.mem_Iic.2 hi⟩ le_rfl
  · exact le_iSup₂_of_le a.1 (Finset.mem_Iic.mp a.2) le_rfl
