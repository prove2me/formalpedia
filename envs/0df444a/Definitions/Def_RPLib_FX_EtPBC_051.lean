section KappaLH

variable (A K : Type) [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K]
  [IsIntegrallyClosed A] [IsNoetherianRing A] (Λ : Type) [CommRing Λ]

/-- **Every class in `H¹(Spec A, Λ)` is `κ(χ)`.** -/
theorem kappaLH_surj (κ : H Λ (unitSh Λ (Spec (CommRingCat.of A))) 1) : ∃ χ : ChL A K Λ, kappaLH A K Λ χ = κ := by
  obtain ⟨c, hc, hcl, rfl⟩ := exists_kappa_eq A K isLisse_unitSh κ
  have hce : ∀ τ, c τ = ((constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom (c τ) : Λ) •
      oneStalk Λ (genPt A) := fun τ => EtPBC.EtMV.eq_smul_oneStalk (genPt A) (c τ)
  have hadd : ∀ a b, (constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom (c (a * b)) =
      (constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom (c a) +
        (constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom (c b) := by
    intro a b
    rw [hc a b, fibRep_unitSh', LinearMap.id_apply, map_add]
  have hl : IsLocallyConstant (fun τ => (constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom (c τ)) :=
    hcl.comp (fun y => (constStalkIso Λ (geomPtAt (genPt A)) (ModuleCat.of Λ Λ)).hom.hom y)
  refine ⟨⟨_, mem_ChL.2 ⟨hadd, hl⟩⟩, ?_⟩
  rw [kappaLH_apply]
  exact kappa_congr A K isLisse_unitSh _ _ _ _ (funext fun τ => (hce τ).symm)

end KappaLH

