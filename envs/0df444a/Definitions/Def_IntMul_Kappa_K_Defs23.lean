section
-- Source module: Solutions.KFMNeed
/-!
# KFM: the uniform interfaces `PhiNeed` and `SwapNeed` (hypotheses of the assembly)

These are stated in the style of `P18IL`. Each one asks for a fixed table `kTable ext`, with
`ext`, the entry points and the descriptor stack `dS` all chosen before any parameter. Every
size-dependent quantity is run-time data on `dS`. The data sit on stack `0` (array on top, then
an arbitrary tail `l`). Every other managed stack is empty (`f j = []` for `j ≠ 0, dS`), so a
procedure may use any stack as scratch as long as it leaves it as it found it. The unmanaged
part `s` underneath is arbitrary and preserved. On exit, `dS` still holds its descriptor.

* **`PhiNeed`**: uniform `Φ` / `Φ⁻¹` of §9.3, with the denotations `KFU.PhiD` / `KFU.PhiInvD`.
  These are KFU's `phi_spec` / `phiInv_spec` with the literals `w, h, d, bL, s_j, μ_j` moved into
  the descriptor `descPhi`. Cost: a constant times KFU's `cPhi` (Lemma 12 constant `1`), plus a
  descriptor term `(d+1)(h+w+size V_S+1)²`.
* **`SwapNeed`**: uniform Lemma 12 on Gaussian (record) arrays: interchange two axes `p < q` of
  equal size `2^u` in an array of any positive shape `sh`. This is KFS's `swAxG_spec`, with
  `w, u, p, q, sh` in the descriptor `descSw`. Records of `r` entries use the shape `sh ++ [r]`.
  Cost: `K (w+1)(V+1) u^τ`, plus a descriptor term `(|sh|+1)(size V+w+u+1)²`. The assembly
  builds the axis exposure (moving an axis innermost before a line map, and back after it)
  from these swaps. A `2^{h+1}` axis is split as `2 × 2^h` by a free reshape.

* **`TransNeed`**: uniform axis rotation (`transposeL t (V/t)`) on padded Gaussian arrays whose
  axes are all `2^h` or `2^{h+1}`. This is the exposure step that replaces nlogn's `transP 2`
  inside `GL.axisP`. Equal-size swaps cannot do it when the sizes are mixed (see the docstring).

The final theorem may take `P18IL ∧ PhiNeed ∧ TransNeed` (and `SwapNeed` if it is used). The tables are merged by relabelling
(`IRuns.relabel`).
-/

namespace NLogN.KFM

open IntMul KIL KFB AModel AModelL12

noncomputable section

/-! ## `Φ` / `Φ⁻¹` -/

/-- The bits `bL 0, …, bL (d-1)` as `0/1`. -/
def bitsZ (d : ℕ) (bL : ℕ → Bool) : List ℤ := (List.range d).map fun j => if bL j then 1 else 0

/-- The descriptor of a `Φ` / `Φ⁻¹` call:
`[w, h, d, bL 0..d-1 (0/1), s_0..s_{d-1}, μ_0..μ_{d-1}]`. -/
def descPhi (w h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) : List ℤ :=
  (w : ℤ) :: (h : ℤ) :: (d : ℤ) ::
    (bitsZ d bL ++ (List.range d).map (fun j => (sF j : ℤ)) ++
      (List.range d).map (fun j => (μ j : ℤ)))

/-- The cost allowed for one `Φ` or `Φ⁻¹` call (`C₀` times this). -/
def cPhiU (w h d : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) : ℝ :=
  KFU.cPhi d w (vol (KFU.shR d (KFU.tP d h bL))) (vol (KFU.shR d (KFU.sP d sF)))
      (vol ((List.range (d - 1)).map sF)) (zsz ((2 * vol (KFU.shR d (KFU.sP d sF)) : ℕ) : ℤ)) 1 h +
    (((d + 1) * (h + w + Nat.size (vol (KFU.shR d (KFU.sP d sF))) + 1) ^ 2 : ℕ) : ℝ)

/-- **`Φ` and `Φ⁻¹` in IL, uniform** (hypothesis of the assembly). Forward entry `eF`: `xs` in
the k-order source shape `shK d (sP d sF)` becomes `PhiD xs` in the padded reversed shape
`shR d (tP d h bL)`. Backward entry `eB`: `ys` in that shape becomes `PhiInvD ys`. -/
def PhiNeed : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eF eB : Fin (7 + E)) (dS : Fin HS) (C₀ : ℝ),
    dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ (Isym : List Sym) (w h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ),
    1 ≤ h → (∀ j < d, 1 ≤ sF j ∧ sF j ≤ 2 ^ (h + if bL j then 1 else 0) ∧ μ j < sF j) →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descPhi w h d bL sF μ →
    (∀ xs : List ℤ, f 0 = xs ++ l → xs.length = vol (KFU.shK d (KFU.sP d sF)) → Bnd w xs →
      ∃ c : ℕ, IRuns Isym (kTable ext) (.call eF) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (KFU.PhiD h d bL sF μ xs ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cPhiU w h d bL sF) ∧
    (∀ ys : List ℤ, f 0 = ys ++ l → ys.length = vol (KFU.shR d (KFU.tP d h bL)) → Bnd w ys →
      ∃ c : ℕ, IRuns Isym (kTable ext) (.call eB) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (KFU.PhiInvD h d bL sF μ ys ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cPhiU w h d bL sF)

/-! ## Axis swaps (Lemma 12 on Gaussian record arrays) -/

/-! ## Axis rotation on padded arrays (the exposure step around the line maps) -/

/-- The padded shape `[2^{h+b_0}, …, 2^{h+b_{k-1}}]` (`b_j ∈ {0,1}`). -/
def shPad (h : ℕ) (bs : List Bool) : Shape := bs.map fun b => 2 ^ (h + if b then 1 else 0)

/-- The descriptor of a rotation call: `[w, h, k, b_0, …, b_{k-1}]` (bits as `0/1`). -/
def descTr (w h : ℕ) (bs : List Bool) : List ℤ :=
  (w : ℤ) :: (h : ℤ) :: (bs.length : ℤ) :: bs.map (fun b => if b then 1 else 0)

/-- **Axis rotation in IL, uniform** (hypothesis of the assembly). A row-major Gaussian array
of the padded shape `t :: rest = shPad h bs` (every axis `2^h` or `2^{h+1}`) is transposed as
`t × vol rest → vol rest × t`. This is nlogn's `transposeL`, the map that `GL.axisP` gets from
`transP 2`. That radix-sort transpose costs `O(V log V)` and is not allowed here. This version
costs `K (k+1)(w+1)(V+1)(h^τ+1)`, as KFU's `rev_spec` does for one reversal. Equal-size Lemma 12
swaps alone (`SwapNeed`) cannot do it cheaply when the sizes are mixed: the extra bits of the
`2^{h+1}` axes have to be moved as in KFU `revC` (`fwdF`/`bwdF`). -/
def TransNeed : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (entry : Fin (7 + E)) (dS : Fin HS) (K : ℝ),
    dS ≠ 0 ∧ 0 ≤ K ∧
  ∀ (Isym : List Sym) (w h : ℕ) (bs : List Bool), 1 ≤ h → bs ≠ [] →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descTr w h bs →
    f 0 = gflat zs ++ l → zs.length = vol (shPad h bs) → NLogN.KFB.GB w zs →
    ∃ c : ℕ, IRuns Isym (kTable ext) (.call entry) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (gflat (IntMul.HvdH.Ref.transposeL ((shPad h bs).headD 1) (vol (shPad h bs).tail) zs) ++ l))) c ∧
      (c : ℝ) ≤ K * (((bs.length + 1 : ℕ) : ℝ) * ((w : ℝ) + 1) * ((vol (shPad h bs) : ℝ) + 1) *
          ((h : ℝ) ^ KFS.τS + 1) + (((bs.length + 1) * (h + w + bs.length + 1) ^ 2 : ℕ) : ℝ))

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSB
/-!
# KFM SB: the `Φ` descriptor

* `bitP dst`: pushes the bits `b_j = [d' ≤ j]` (`t_j = r` exactly when `j ≥ d'`) for `j < d`
  (**`bitP_run`**, **`bitP_cost`**).
* **`descPhiP dst rw`**: pushes `descPhi w (ℓ−1) d bL s μ` (KFMNeed) on `dst`, with `w` read from
  the register `rw` (**`descPhiP_run_n`**, **`descPhiP_cost_n`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- `[d' ≤ j]` for `j = ix`. -/
def bitE (ix : Ex HS) : Ex HS := .sel (.add ix (.neg (.reg zDp))) (.lit 0) (.lit 1)

/-- All bits: `b_{d−1}, …, b_0` pushed on `dst`. -/
def bitP (dst : Fin HS) : RS := .rep mOc (.reg zD) (.push dst (NLogN.KFM.bitE ixO))

/-- `h = ℓ − 1`. -/
def hE : Ex HS := .add (.reg zEl) (.lit (-1))

/-- **The `Φ` descriptor**: `w` from register `rw`. -/
def descPhiP (dst rw : Fin HS) : RS :=
  .seq (muP dst) (.seq (NLogN.KFM.srcP dst) (.seq (bitP dst) (.seq (.push dst (.reg zD))
    (.seq (.push dst NLogN.KFM.hE) (.push dst (.reg rw))))))

/-- The bits of `n`: `t_j = r` exactly when `j ≥ d'`. -/
noncomputable def bLn (n : ℕ) (j : ℕ) : Bool := decide (dpN n ≤ j)

/-- The registers the descriptor code reads, for `n`. -/
structure DescRegs (t : IState HS) (n w : ℕ) (rw : Fin HS) : Prop where
  src : SrcRegs t (dpN n) (srcQ (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n)) (srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n / 2))
    (srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n))
  hD : ∃ L, t.G zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: L
  hEl : ∃ L, t.G zEl = .int (ℓP n : ℤ) :: L
  hW : ∃ L, t.G rw = .int (w : ℤ) :: L

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSC
/-!
# KFM SC: handing a descriptor to a procedure with an arbitrary descriptor stack

The `Need` interfaces fix their descriptor stack `dS` existentially, so `dS` may be any stack
(also one of the setup registers or a scratch stack `≥ 56`). The descriptor is therefore built
on a free stack `X` above a mark and then moved to `dS` with plain `mv` loops, which work on any
stack:

* **`mvLoop X Y`**: `while top X ≠ mark: mv X Y` (reverses the block) (**`mvLoop_runs`**).
* **`dropLoop D`**: `while top D ≠ mark: drop D` (**`dropLoop_runs`**).
* **`xfer X Y D`**: `mark D; mark Y; mvLoop X Y; unmark X; mvLoop Y D; unmark Y`. It moves the
  block above the mark on `X` to `D` in the same order, over a new mark on `D` (**`xfer_runs`**).
* **`unxfer D`**: `dropLoop D; unmark D` removes it again after the call (**`unxfer_runs`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- Not a mark. -/
def notMk : Cls → Bool := fun c => c != .mark

/-- `while top X ≠ mark: mv X Y`. -/
def mvLoop (X Y : Fin HS) : IStmt HS P := .loop X notMk (.op (.mv X Y))

/-- `while top D ≠ mark: drop D`. -/
def dropLoop (D : Fin HS) : IStmt HS P := .loop D notMk (.op (.drop D))

/-- The cost of moving one integer of size `≤ B`. -/
def cMv (B : ℕ) : ℕ := 2 * moveCost B + 49

/-- Move the block above the mark on `X` to `D` (same order), over a new mark on `D`. -/
def xfer (X Y D : Fin HS) : IStmt HS P :=
  .seq (.op (.mark D)) (.seq (.op (.mark Y)) (.seq (mvLoop X Y) (.seq (.op (.unmark X))
    (.seq (mvLoop Y D) (.op (.unmark Y))))))

/-- Remove the block above the mark on `D`, and the mark. -/
def unxfer (D : Fin HS) : IStmt HS P := .seq (dropLoop D) (.op (.unmark D))

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSD
/-!
# KFM SD: the Prop 18 descriptor

`desc18 p ℓ K ts = [p, ℓ, K, D, t_0, …, t_{D−1}]` (KFMP18) with `D = d − 1`, `p = 6b` and
`t_j = r` exactly when `j ≥ d'` (else `r/2`). These are the first `d − 1` axes of the padded
shape `shR d (tP d (ℓ−1) bL)` of `Φ` (the last of the `d` axes is the record axis, `t_{d−1} = r`).

* `tsE`: `t_{j−1}` for `j = ix` (`sel`), so that the push loop over `j = 0..d−1` leaves a junk
  entry `t_{−1}` on top, which `pop` removes.
* **`desc18P dst`** (**`desc18P_run_n`**, **`desc18P_cost_n`** `≤ 10^12 (b+1)^3`). It reads
  `b` from `zB` and `d, K, ℓ, r, d'` from the setup registers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- `t_{ix−1}`: `r/2` if `ix − d' − 1 < 0`, else `r`. -/
def tsE : Ex HS :=
  .sel (.add (.add ixO (.neg (.reg zDp))) (.lit (-1))) (.ndiv (.reg zR) (.lit 2)) (.reg zR)

/-- The axis lengths: `t_0, …, t_{d−2}` on `dst`. -/
def tsP (dst : Fin HS) : RS := .seq (.rep mOc (.reg zD) (.push dst tsE)) (.pop dst)

/-- `p = 6b`. -/
def pE : Ex HS := .mul (.lit 6) (.reg NLogN.KFM.zB)

/-- `D = d − 1`. -/
def dmE : Ex HS := .add (.reg zD) (.lit (-1))

/-- **The Prop 18 descriptor.** -/
def desc18P (dst : Fin HS) : RS :=
  .seq (tsP dst) (.seq (.push dst dmE) (.seq (.push dst (.reg zK)) (.seq (.push dst (.reg zEl))
    (.push dst pE))))

/-- The axis lengths for `n`. -/
noncomputable def tsN (n : ℕ) : List ℕ :=
  (List.range (IntMul.OpenAI.Glue.dP n - 1)).map fun j => if dpN n ≤ j then IntMul.OpenAI.Glue.rP n else IntMul.OpenAI.Glue.rP n / 2

/-- Where `desc18P` may write. -/
structure D18Ok (dst : Fin HS) : Prop where
  lt : dst.val < 56
  ne : dst ≠ mOc ∧ dst ≠ zD ∧ dst ≠ zDp ∧ dst ≠ zR ∧ dst ≠ zK ∧ dst ≠ zEl ∧ dst ≠ NLogN.KFM.zB

/-- The registers `desc18P` reads. -/
structure D18Regs (t : IState HS) (n : ℕ) : Prop where
  hD : ∃ L, t.G zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: L
  hDp : ∃ L, t.G zDp = .int (dpN n : ℤ) :: L
  hR : ∃ L, t.G zR = .int (IntMul.OpenAI.Glue.rP n : ℤ) :: L
  hK : ∃ L, t.G zK = .int (KP n : ℤ) :: L
  hEl : ∃ L, t.G zEl = .int (ℓP n : ℤ) :: L
  hB : ∃ L, t.G NLogN.KFM.zB = .int (bP n : ℤ) :: L

/-- The value pushed for the counter `c` (index `j = c − 1`). -/
def tsV (d' r : ℕ) (j : ℕ) : ℤ := if d' + 1 ≤ j then (r : ℤ) else ((r / 2 : ℕ) : ℤ)

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSE
/-!
# KFM SE: the axis-rotation descriptor (`TransNeed`)

`descTr w h bs = [w, h, k, b_0, …, b_{k−1}]` (KFMNeed). In kmain the array has the padded shape
`[t_0, …, t_{d−1}]` (`t_j = 2^{h + b_j}`, `h = ℓ − 1`, `b_j = [d' ≤ j]`). After `m` rotations
its shape is that list rotated left by `m`, so the descriptor of the next rotation uses the bits
`bR n m j = [d' ≤ (j + m) mod d]`.

* **`descTrP dst rw rm`**: pushes `descTr w (ℓ−1) (bsN n m)` with `w` read from register `rw`
  and `m` from register `rm` (**`descTrP_run_n`**, **`descTrP_cost_n`** `≤ 10^12 (b+1)^3`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- `[d' ≤ (ix + m) mod d]` for `m` on `rm`. -/
def rbitE (rm : Fin HS) : Ex HS :=
  .sel (.add (.nmod (.add ixO (.reg rm)) (.reg zD)) (.neg (.reg zDp))) (.lit 0) (.lit 1)

/-- The rotated bits on `dst`. -/
def rbitP (dst rm : Fin HS) : RS := .rep mOc (.reg zD) (.push dst (rbitE rm))

/-- **The rotation descriptor.** -/
def descTrP (dst rw rm : Fin HS) : RS :=
  .seq (rbitP dst rm) (.seq (.push dst (.reg zD)) (.seq (.push dst NLogN.KFM.hE) (.push dst (.reg rw))))

/-- The rotated bits for `n` after `m` rotations. -/
noncomputable def bsN (n m : ℕ) : List Bool :=
  (List.range (IntMul.OpenAI.Glue.dP n)).map fun j => decide (dpN n ≤ (j + m) % IntMul.OpenAI.Glue.dP n)

/-- Where `descTrP` may write. -/
structure TrOk (dst rw rm : Fin HS) : Prop where
  lt : dst.val < 56
  ne : dst ≠ mOc ∧ dst ≠ zD ∧ dst ≠ zDp ∧ dst ≠ zEl ∧ dst ≠ rw ∧ dst ≠ rm
  rw56 : rw.val < 56
  rm56 : rm.val < 56
  rmO : rm ≠ mOc

/-- The registers `descTrP` reads. -/
structure TrRegs (t : IState HS) (n w m : ℕ) (rw rm : Fin HS) : Prop where
  hD : ∃ L, t.G zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: L
  hDp : ∃ L, t.G zDp = .int (dpN n : ℤ) :: L
  hEl : ∃ L, t.G zEl = .int (ℓP n : ℤ) :: L
  hW : ∃ L, t.G rw = .int (w : ℤ) :: L
  hM : ∃ L, t.G rm = .int (m : ℤ) :: L

end NLogN.KFM

end

section
-- Source module: Solutions.KFMLineNeed
/-!
# KFM: the line-map interface `LineNeed` (hypothesis of the assembly)

Steps 3a (`A` lines) and 3c (`B₀` lines) of the source transform, on the arrays exactly as kmain
holds them, in the style of `P18IL`: one fixed table `kTable ext`, entries `eA`, `eB` and a
descriptor stack `dS` chosen before `n`; all size-dependent data on `dS`.

**Arrays.** After `Φ`, stack `0` holds `gflat zs ++ l`: one Gaussian item per point of the
padded box `∏_{i<d} t_i` (row-major, axis `0` outermost, the shape `shR d (tP d (ℓ−1) bL)` of
`PhiNeed` without its component axis), numerators at scale `2^p`, `p = pP n`. Here
`t_i = tB n i = r` if `d' ≤ i`, else `r/2` (`= 2^{ℓ−1+b_i}`, the axes of `TransNeed`'s `shPad`),
and the source lengths are `s_i = sB n i = srcN n i ≤ t_i`.

* `RepPad p s t zs u`: `zs` holds the `s`-box function `u` padded into the `t`-box: the item at
  a point with every coordinate `< s_i` is `2^p u(point)`, every other item is `0`.
* `RepFull p t zs w`: `zs` holds the `t`-box function `w` (`2^p w(point)` everywhere).

**Forward (`eA`, step 3a).** `RepPad zs u`, `‖u‖ ≤ 1/2` ↦ `RepFull zs' w` with
`‖w − tensCLM (kerA M.A) u‖ ≤ εA · 2^{−p}` for every `M : AxisMaps p α s t` (this is
`chain_concrete`'s `hAt`; `Grid p w` holds because `w` has integer numerators).
**Backward (`eB`, step 3c).** `RepFull ys y`, `‖y‖ ≤ 1` ↦ `RepPad ys' v` with
`‖v − tensCLM (kerB M.B) y‖ ≤ εB · 2^{−p}` (`hBt`).

The error constants are those of `tensor_fp` with Lemma 19's per-axis widths (`AxisMaps.hS`,
`hB0`): `εA = d (6 sWidth p α + 4)`, `εB = Σ_i (jIter p s_i t_i α (10 eWidth p α + 12) + 4)`.

Cost: as `P18IL`, `C₀ · V · Ncost · (log p + 1)^A` (rows `d p^{1/2+δ} α` and `d²(1+ℓ^τ)` with
the polylog slack). Descriptor: `descLine = [p, α, h, d, b_0..b_{d−1}, s_0..s_{d−1}]`,
`h = ℓ − 1`, `b_j = [d' ≤ j]` (0/1). The proof may use `TransNeed` (axis exposure).
-/

namespace NLogN.KFM

open IntMul KIL KFB IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-- The source lengths as a box. -/
def sB (n : ℕ) : Fin (IntMul.OpenAI.Glue.dP n) → ℕ := fun i => srcN n i

/-- The padded lengths as a box (`r` from `d'` on, else `r/2`). -/
def tB (n : ℕ) : Fin (IntMul.OpenAI.Glue.dP n) → ℕ := fun i => if dpN n ≤ i.val then IntMul.OpenAI.Glue.rP n else IntMul.OpenAI.Glue.rP n / 2

/-- Coordinate `i` of the row-major index `x` over the box `t`. -/
def boxIx {d : ℕ} (t : Fin d → ℕ) (x : ℕ) (i : Fin d) : ℕ := digL (List.ofFn t) x i

/-- `zs` holds the `s`-box function `u` padded into the `t`-box (scale `2^p`, zeros outside). -/
def RepPad {d : ℕ} (p : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] (zs : List GI)
    (u : ((i : Fin d) → ZMod (s i)) → ℂ) : Prop :=
  zs.length = (List.ofFn t).prod ∧ ∀ x < (List.ofFn t).prod,
    ((∀ i, boxIx t x i < s i) →
      gC (zs.getD x 0) = 2 ^ p * u (fun i => ((boxIx t x i : ℕ) : ZMod (s i)))) ∧
    ((¬ ∀ i, boxIx t x i < s i) → zs.getD x 0 = 0)

/-- `zs` holds the `t`-box function `w` (scale `2^p`). -/
def RepFull {d : ℕ} (p : ℕ) (t : Fin d → ℕ) [∀ i, NeZero (t i)] (zs : List GI)
    (w : ((i : Fin d) → ZMod (t i)) → ℂ) : Prop :=
  zs.length = (List.ofFn t).prod ∧ ∀ x < (List.ofFn t).prod,
    gC (zs.getD x 0) = 2 ^ p * w (fun i => ((boxIx t x i : ℕ) : ZMod (t i)))

/-- Error constant of the `A` lines. -/
def epsA (p α d : ℕ) : ℝ := (d * (6 * sWidth p α + 4) : ℕ)

/-- Error constant of the `B₀` lines. -/
def epsB {d : ℕ} (p α : ℕ) (s t : Fin d → ℕ) : ℝ :=
  ((∑ i, (jIter p (s i) (t i) α * (10 * eWidth p α + 12) + 4) : ℕ) : ℝ)

/-- The descriptor of a line-map call: `[p, α, h, d, b_0..b_{d−1}, s_0..s_{d−1}]`. -/
def descLine (p α h d : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) : List ℤ :=
  (p : ℤ) :: (α : ℤ) :: (h : ℤ) :: (d : ℤ) ::
    (bitsZ d bL ++ (List.range d).map (fun j => (sF j : ℤ)))

/-- The line-map descriptor for `n`. -/
def descLineN (n : ℕ) : List ℤ :=
  descLine (pP n) (αP n) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n)

/-- The cost allowed for one line-map phase (as `P18IL`). -/
def cLineU (n A : ℕ) : ℝ :=
  VP n * Ncost (6 * (IntMul.lg n : ℝ)) (IntMul.OpenAI.Glue.dP n) (KP n) (ℓP n) (αP n) *
    (Real.log (6 * (IntMul.lg n : ℝ)) + 1) ^ A

/-- **The line maps in IL, uniform** (hypothesis of the assembly). -/
def LineNeed : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eA eB : Fin (7 + E)) (dS : Fin HS) (C₀ : ℝ)
    (A n₁ : ℕ), dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ (Isym : List Sym) (n : ℕ), IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n →
  ∀ [∀ i, NeZero (NLogN.KFM.sB n i)] [∀ i, NeZero (NLogN.KFM.tB n i)],
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descLineN n →
    (∀ (zs : List GI) (u : ((i : Fin (IntMul.OpenAI.Glue.dP n)) → ZMod (NLogN.KFM.sB n i)) → ℂ),
      f 0 = gflat zs ++ l → RepPad (pP n) (NLogN.KFM.sB n) (NLogN.KFM.tB n) zs u → ‖u‖ ≤ 1 / 2 →
      ∃ (zs' : List GI) (w : ((i : Fin (IntMul.OpenAI.Glue.dP n)) → ZMod (NLogN.KFM.tB n i)) → ℂ) (c : ℕ),
        IRuns Isym (kTable ext) (.call eA) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (gflat zs' ++ l))) c ∧
        RepFull (pP n) (NLogN.KFM.tB n) zs' w ∧ NLogN.KFB.GB (pP n + 2) zs' ∧
        (∀ M : AxisMaps (d := IntMul.OpenAI.Glue.dP n) (pP n) (αP n) (NLogN.KFM.sB n) (NLogN.KFM.tB n),
          ‖w - tensCLM (kerA M.A) u‖ ≤ epsA (pP n) (αP n) (IntMul.OpenAI.Glue.dP n) * hp (pP n)) ∧
        (c : ℝ) ≤ C₀ * cLineU n A) ∧
    (∀ (ys : List GI) (y : ((i : Fin (IntMul.OpenAI.Glue.dP n)) → ZMod (NLogN.KFM.tB n i)) → ℂ),
      f 0 = gflat ys ++ l → RepFull (pP n) (NLogN.KFM.tB n) ys y → ‖y‖ ≤ 1 →
      ∃ (ys' : List GI) (v : ((i : Fin (IntMul.OpenAI.Glue.dP n)) → ZMod (NLogN.KFM.sB n i)) → ℂ) (c : ℕ),
        IRuns Isym (kTable ext) (.call eB) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (gflat ys' ++ l))) c ∧
        RepPad (pP n) (NLogN.KFM.sB n) (NLogN.KFM.tB n) ys' v ∧ NLogN.KFB.GB (pP n + 2) ys' ∧
        (∀ M : AxisMaps (d := IntMul.OpenAI.Glue.dP n) (pP n) (αP n) (NLogN.KFM.sB n) (NLogN.KFM.tB n),
          ‖v - tensCLM (kerB M.B) y‖ ≤ epsB (pP n) (αP n) (NLogN.KFM.sB n) (NLogN.KFM.tB n) * hp (pP n)) ∧
        (c : ℝ) ≤ C₀ * cLineU n A)

end

end NLogN.KFM

end


