-- Source module: Solutions.J6SegPart
/-!
# Segmented inverse (S2): the block-partition constructor

`mkBlocks s t lam w`: cut `[0, s)` at `0`, at every multiple of `lam`, and after every wrap step
(`bOf (l+1) ≠ bOf l + (t - s)`); the block of `i` starts at the last cut `≤ i` (`Nat.findGreatest`)
and ends before the next cut (`Nat.find`). All computable.

* `mkBlocks_ok`: `BlocksOK s t (mkBlocks s t lam w)` for `1 ≤ lam`, `w ≤ s`;
* `mkBlocks_len`: every block has length `≤ lam`;
* `Jlist_length_le`: `|J| ≤ s`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf

section part
variable (s t lam : ℕ)

variable {s t lam}

lemma not_cut_of_lt_en {c k : ℕ} (hk : k < enF s t lam c) :
    ¬ cutP s t lam (c + 1 + k) ∧ c + 1 + k < s := by
  have := Nat.find_min (enF_ex s t lam c) hk
  push Not at this
  exact ⟨this.1, this.2⟩

lemma en_le_s {c : ℕ} (hc : c < s) : c + 1 + enF s t lam c ≤ s := by
  have := Nat.find_min' (enF_ex s t lam c) (show cutP s t lam (c + 1 + (s - c - 1)) ∨
    s ≤ c + 1 + (s - c - 1) from Or.inr (by omega))
  unfold enF; omega

end part

end J6Seg

end

section
-- Source module: Solutions.J6SegLn1
/-!
# Segmented inverse (S2), machine side 1: the block solve as list functions

The block solve `blkI` (seven fixed-point stages) on a list `x` of length `n`, with the tables as
lists (`di, gi, gam, dd` of length `≥ n`, the block's `am, ap` of length `≥ n`):

* `dgL c x = zipWith (fmul P) c x` (diagonal stage);
* `convL c x` = the exact lower-triangular Toeplitz sums `∑_{k ≤ u} c_{u-k} x_k` (`u < |x|`),
  `lwL c x = (convL c x).map (rs P)` (one rounding per output);
* `upL c x = (lwL c x.reverse).reverse` (the upper stage is the lower stage on the reversed list);
* `blkL = dgL dd ∘ dgL gi ∘ upL ap ∘ dgL gam ∘ lwL am ∘ dgL gi ∘ dgL di`.

**`blkL_getD`**: `blkL` computes `blkI` entrywise.
-/

open Finset

namespace J6Seg

section lst
variable (P : ℕ)

lemma length_convL (c x : List ℤ) : (convL c x).length = x.length := by simp [convL]

lemma length_lwL (c x : List ℤ) : (lwL P c x).length = x.length := by
  simp [lwL, length_convL]

lemma length_upL (c x : List ℤ) : (upL P c x).length = x.length := by
  simp [upL, length_lwL]

lemma length_dgL {c x : List ℤ} (h : x.length ≤ c.length) : (dgL P c x).length = x.length := by
  simp [dgL]; omega

lemma repL_dg {n : ℕ} {c x : List ℤ} {cf g : ℕ → ℤ} (hc : n ≤ c.length)
    (hcf : ∀ u < n, c.getD u 0 = cf u) (hx : RepL n x g) : RepL n (dgL P c x) (dgI P cf g) := by
  obtain ⟨hl, hg⟩ := hx
  refine ⟨by rw [length_dgL P (by rw [hl]; exact hc)]; exact hl, fun u hu => ?_⟩
  have h1 : u < c.length := by omega
  have h2 : u < x.length := by rw [hl]; exact hu
  simp only [dgL, dgI]
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_zipWith]
  rw [← hcf u hu, ← hg u hu, List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2]

lemma repL_lw {n : ℕ} {c x : List ℤ} {cf g : ℕ → ℤ} (hcf : ∀ u < n, c.getD u 0 = cf u)
    (hx : RepL n x g) : RepL n (lwL P c x) (lwI P cf g) := by
  obtain ⟨hl, hg⟩ := hx
  refine ⟨by rw [length_lwL]; exact hl, fun u hu => ?_⟩
  simp only [lwL, convL, lwI, List.map_map]
  rw [List.getD_eq_getElem _ _ (by simp; omega)]
  simp only [List.getElem_map, List.getElem_range, Function.comp]
  congr 1
  refine Finset.sum_congr rfl (fun k hk => ?_)
  simp only [Finset.mem_range] at hk
  rw [hcf _ (by omega), hg k (by omega)]

lemma repL_up {n : ℕ} {c x : List ℤ} {cf g : ℕ → ℤ} (hcf : ∀ u < n, c.getD u 0 = cf u)
    (hx : RepL n x g) : RepL n (upL P c x) (upI P n cf g) := by
  obtain ⟨hl, hg⟩ := hx
  have hrev : RepL n x.reverse (fun u => g (n - 1 - u)) := by
    refine ⟨by simp [hl], fun u hu => ?_⟩
    have e1 : x.reverse.getD u 0 = x.getD (n - 1 - u) 0 := by
      rw [List.getD_eq_getElem _ _ (by simp [hl]; omega), List.getElem_reverse,
        List.getD_eq_getElem _ _ (by rw [hl]; omega)]
      congr 1; rw [hl]
    rw [e1, hg (n - 1 - u) (by omega)]
  obtain ⟨hl2, hg2⟩ := repL_lw P hcf hrev
  refine ⟨by rw [length_upL]; exact hl, fun u hu => ?_⟩
  have e1 : (upL P c x).getD u 0 = (lwL P c x.reverse).getD (n - 1 - u) 0 := by
    simp only [upL]
    rw [List.getD_eq_getElem _ _ (by rw [List.length_reverse, hl2]; exact hu),
      List.getElem_reverse, List.getD_eq_getElem _ _ (by rw [hl2]; omega)]
    congr 1; rw [hl2]
  rw [e1, hg2 (n - 1 - u) (by omega)]
  simp only [lwI, upI]
  congr 1
  rw [Finset.sum_Ico_eq_sum_range]
  have hm : n - 1 - u + 1 = n - u := by omega
  rw [hm, ← Finset.sum_range_reflect]
  refine Finset.sum_congr rfl (fun k hk => ?_)
  simp only [Finset.mem_range] at hk
  congr 2 <;> omega

/-- **The list block solve computes `blkI`** (tables as lists of sufficient length). -/
theorem blkL_rep (T : Tables) (a n : ℕ) {di gi gam dd am ap x : List ℤ} {g : ℕ → ℤ}
    (h1 : n ≤ di.length) (h2 : n ≤ gi.length) (h3 : n ≤ gam.length) (h4 : n ≤ dd.length)
    (e1 : ∀ u < n, di.getD u 0 = T.di u) (e2 : ∀ u < n, gi.getD u 0 = T.gi u)
    (e3 : ∀ u < n, gam.getD u 0 = T.gam u) (e4 : ∀ u < n, dd.getD u 0 = T.dd u)
    (e5 : ∀ u < n, am.getD u 0 = T.am a u) (e6 : ∀ u < n, ap.getD u 0 = T.ap a u)
    (hx : RepL n x g) :
    RepL n (blkL P di gi gam dd am ap x) (blkI P T a n g) :=
  repL_dg P h4 e4 (repL_dg P h2 e2 (repL_up P e6 (repL_dg P h3 e3 (repL_lw P e5
    (repL_dg P h2 e2 (repL_dg P h1 e1 hx))))))

end lst

end J6Seg

end

