-- title:
--   Lemma 2.2 — support locality
-- statement:
--   For any finite clause set $A$ over $n$ variables, any field $K$ and any Boolean polynomial $f\in B$, reduction modulo the ideal generated by $A$ introduces no variable outside $f$ and the clauses in $A$:
--
--   $$\operatorname{Vars}(R_A(f))\subseteq\operatorname{Vars}(f)\cup N(A).$$
--
--   There is no satisfiability or degree assumption. This locality statement supports the comparison of different clause ideals.
--
--   Differences from the source:
--   - encoding: variables indexed by [n] with Boolean value 1 true → Fin n with true representing 1; reason: the bijection i ↦ i+1 preserves every clause and assignment
--   - encoding: Boolean polynomial quotient with multilinear representatives and fixed degree-lex order → the isomorphic algebra of K-valued Boolean-cube functions, explicit Möbius coefficients, and degree-lex rank with x_(n-1) > ... > x_0; reason: Boolean evaluation identifies exactly the Boolean ideal quotient over every field; the inverse is the multilinear polynomial with these coefficients
-- source:
--   Jonas Conneryd, STOC 2027 submission #332 (October 2026), Lemma 2.2, Equation (6), printed p. 6, PDF p. 8; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/332.pdf

import Definitions.Def_RandomCNFDeficiency_LowerBound_ClauseAlgebra
set_option autoImplicit false

namespace RandomCNFDeficiency.LowerBound

theorem support_locality
    {n : ℕ} {K : Type*} [Field K] (A : CNF n) (f : BooleanAlgebra n K) :
    booleanVars (localReduction A f) ⊆ booleanVars f ∪ neighborhood A := by sorry

end RandomCNFDeficiency.LowerBound
