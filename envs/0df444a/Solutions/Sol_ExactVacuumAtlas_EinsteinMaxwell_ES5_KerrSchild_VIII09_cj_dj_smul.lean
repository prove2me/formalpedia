theorem q3j_smul_apply (k j : ℝ) (x : ℝ) : q3j (k * j) x = k ^ 3 * q3j j x := by
  unfold q3j
  rw [mul_pow]
  ring

theorem r3j_smul_apply (k j : ℝ) (x : ℝ) : r3j (k * j) x = k ^ 3 * r3j j x := by
  unfold r3j
  rw [mul_pow]
  ring

theorem magClass_const_mul {k : ℝ} {b : ℝ → ℝ} (hb : MagClass 3 b) :
    MagClass 3 (fun s => k * b s) := by
  obtain ⟨hc, ⟨η, hη, bt, hbt, heq⟩, C, hC0, Rs, hRs, hdec⟩ := hb
  refine ⟨(contDiffOn_const (c := k)).mul hc, ⟨η, hη, fun s => k * bt s, ?_, ?_⟩, ?_⟩
  · exact (contDiffOn_const (c := k)).mul hbt
  · intro R hR
    simp only [Pi.mul_apply]
    rw [heq hR]
  · refine ⟨|k| * C, by positivity, Rs, hRs, fun R hR => ?_⟩
    obtain ⟨h1, h2⟩ := hdec R hR
    have hd : deriv (fun s => k * b s) R = k * deriv b R := deriv_const_mul_field k
    constructor
    · simp only [Pi.mul_apply, abs_mul]
      calc |k| * |b R| ≤ |k| * (C / R) := mul_le_mul_of_nonneg_left h1 (abs_nonneg k)
        _ = |k| * C / R := by ring
    · rw [hd, abs_mul]
      calc |k| * |deriv b R| ≤ |k| * (C / R ^ 2) := mul_le_mul_of_nonneg_left h2 (abs_nonneg k)
        _ = |k| * C / R ^ 2 := by ring

theorem vClass_const_mul {k : ℝ} {v : ℝ → ℝ} (hv : VClass 3 v) :
    VClass 3 (fun s => k * v s) := by
  obtain ⟨hc, ⟨L, hL⟩, h0⟩ := hv
  refine ⟨(contDiffOn_const (c := k)).mul hc, ⟨k * L, ?_⟩, ?_⟩
  · have h' : Tendsto (fun s : ℝ => k * v s) (𝓝[>] (3:ℝ)) (𝓝 (k * L)) :=
      hL.const_mul k
    simpa using h'
  · have h' : Tendsto (fun s : ℝ => k * v s) atTop (𝓝 (k * 0)) := h0.const_mul k
    simpa using h'

theorem Lmag_const_mul {k : ℝ} {b : ℝ → ℝ} (_hb : ContDiffOn ℝ 2 b (Ioi (3:ℝ))) (R : ℝ) :
    Lmag (fun s => k * b s) R = k * Lmag b R := by
