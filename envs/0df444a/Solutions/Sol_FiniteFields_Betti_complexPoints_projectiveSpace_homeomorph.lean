/-!
# Topologie analytique sur un ouvert affine (A5a)

Pour `x : Spec ℂ ⟶ Y` à valeurs dans un ouvert `U`, `val x U h : Γ(Y, U) →+* ℂ` est l'évaluation
des sections en `x`.

* `val_res` : compatibilité aux restrictions.
* `top_le_basicOpen_iff` : `x` est à valeurs dans `D(g)` si et seulement si `g(x) ≠ 0`.
* `eq_fromSpec` : si `W` est affine, `x = Spec(val x W) ≫ fromSpec`. En particulier `x` est
  déterminé par `val x W`.
* **Plongement** : la topologie de `W(ℂ)` est la topologie faible des sections de `Γ(Y, W)`. Le
  point clé est que toute section `s` sur un ouvert `U` s'écrit `b/gᵏ` au voisinage de chaque point
  de `U ∩ W`, avec `b, g ∈ Γ(Y, W)` (`isLocalization_basicOpen`).
-/

open AlgebraicGeometry CategoryTheory Opposite

namespace FiniteFields.Betti

section Val

variable {Y : Scheme.{0}}

/-- L'évaluation des sections sur `U` en un point complexe `x` à valeurs dans `U`. -/
noncomputable def val (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ U) : Γ(Y, U) →+* ℂ :=
  (x.appLE U ⊤ h ≫ (Scheme.ΓSpecIso (.of ℂ)).hom).hom

theorem val_apply (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ U) (t : Γ(Y, U)) :
    val x U h t = (Scheme.ΓSpecIso (.of ℂ)).hom (x.appLE U ⊤ h t) := rfl

theorem top_le_preimage_iff (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) :
    ⊤ ≤ x ⁻¹ᵁ U ↔ x.base default ∈ U := by
  constructor
  · intro h
    exact h (show default ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
  · intro h p _
    rw [Subsingleton.elim p default]
    exact h

theorem val_res (x : Spec (.of ℂ) ⟶ Y) {U U' : Y.Opens} (hle : U' ≤ U) (h : ⊤ ≤ x ⁻¹ᵁ U)
    (h' : ⊤ ≤ x ⁻¹ᵁ U') (s : Γ(Y, U)) :
    val x U' h' (Y.presheaf.map (homOfLE hle).op s) = val x U h s := by
  simp only [val_apply, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]

theorem top_le_basicOpen_iff (x : Spec (.of ℂ) ⟶ Y) (W : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ W)
    (g : Γ(Y, W)) : ⊤ ≤ x ⁻¹ᵁ Y.basicOpen g ↔ val x W h g ≠ 0 := by
  have e := Scheme.basicOpen_appLE x ⊤ W h g
  rw [top_inf_eq] at e
  rw [← e, val_apply]
  set r := x.appLE W ⊤ h g
  have hr : r = (Scheme.ΓSpecIso (.of ℂ)).inv ((Scheme.ΓSpecIso (.of ℂ)).hom r) := by
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  rw [hr, basicOpen_eq_of_affine, ← hr]
  constructor
  · intro hb h0
    have := hb (show default ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
    rw [h0] at this
    exact this (Ideal.zero_mem _)
  · intro hne p _
    change _ ∉ (p : PrimeSpectrum ℂ).asIdeal
    rw [Subsingleton.elim p default, Scheme.default_asIdeal, Ideal.mem_bot]
    exact hne

variable {W : Y.Opens} (hW : IsAffineOpen W)

include hW in
theorem val_SpecMap_fromSpec (φ : Γ(Y, W) →+* ℂ)
    (h : ⊤ ≤ (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) ⁻¹ᵁ W) :
    val (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) W h = φ := by
  have h1 : hW.fromSpec.appLE W ⊤ (by simp) = (Scheme.ΓSpecIso Γ(Y, W)).inv := by
    rw [Scheme.Hom.appLE, hW.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
    rw [Subsingleton.elim (_ ≫ _) (𝟙 _), CategoryTheory.Functor.map_id, Category.comp_id]
  have h2 : (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top =
      (Spec.map (CommRingCat.ofHom φ)).appTop := by
    simp [Scheme.Hom.appLE]
    rfl
  have key : (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec).appLE W ⊤ h =
      hW.fromSpec.appLE W ⊤ (by simp) ≫ (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top :=
    (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).symm
  ext t
  rw [val_apply, key, h1, h2]
  change ((Scheme.ΓSpecIso Γ(Y, W)).inv ≫ (Spec.map (CommRingCat.ofHom φ)).appTop ≫
    (Scheme.ΓSpecIso (.of ℂ)).hom) t = φ t
  rw [Scheme.ΓSpecIso_naturality]
  erw [Iso.inv_hom_id_assoc]
  rfl

include hW in
/-- Un point complexe à valeurs dans `W` affine est `Spec (val x W) ≫ fromSpec`. -/
theorem eq_fromSpec (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ W) :
    x = Spec.map (CommRingCat.ofHom (val x W h)) ≫ hW.fromSpec := by
  have H : Set.range x.base ⊆ Set.range hW.fromSpec.base := by
    rintro _ ⟨p, rfl⟩
    rw [hW.range_fromSpec]
    exact h (show p ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
  obtain ⟨ψ, hψ⟩ := Spec.map_surjective (IsOpenImmersion.lift hW.fromSpec x H)
  have hx : x = Spec.map ψ ≫ hW.fromSpec := by rw [hψ, IsOpenImmersion.lift_fac]
  have hval : val x W h = ψ.hom := by
    have h' : ⊤ ≤ (Spec.map (CommRingCat.ofHom ψ.hom) ≫ hW.fromSpec) ⁻¹ᵁ W := by
      rw [CommRingCat.ofHom_hom, ← hx]; exact h
    have := val_SpecMap_fromSpec hW ψ.hom h'
    convert this using 2; rw [CommRingCat.ofHom_hom, ← hx]
  rw [hval, CommRingCat.ofHom_hom, ← hx]

include hW in
/-- **Formule locale** : au voisinage d'un point de `U ∩ W`, une section `s ∈ Γ(Y, U)` vaut
`b / gᵏ` avec `b, g ∈ Γ(Y, W)`. -/
theorem exists_local_formula {U : Y.Opens} (s : Γ(Y, U)) (x₀ : Spec (.of ℂ) ⟶ Y)
    (h₀W : ⊤ ≤ x₀ ⁻¹ᵁ W) (h₀U : ⊤ ≤ x₀ ⁻¹ᵁ U) :
    ∃ (g b : Γ(Y, W)) (k : ℕ), val x₀ W h₀W g ≠ 0 ∧
      ∀ (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ W), val x W h g ≠ 0 →
        ∃ hU : ⊤ ≤ x ⁻¹ᵁ U, val x U hU s * val x W h g ^ k = val x W h b := by
  have hp : x₀.base default ∈ U ⊓ W :=
    ⟨(top_le_preimage_iff x₀ U).mp h₀U, (top_le_preimage_iff x₀ W).mp h₀W⟩
  obtain ⟨g, hgle, hg₀⟩ := hW.exists_basicOpen_le (V := U ⊓ W) ⟨_, hp⟩ hp.2
  have := hW.isLocalization_basicOpen g
  have hDU : Y.basicOpen g ≤ U := hgle.trans inf_le_left
  obtain ⟨⟨b, _, ⟨k, rfl⟩⟩, hb⟩ :=
    IsLocalization.surj (Submonoid.powers g) (Y.presheaf.map (homOfLE hDU).op s)
  refine ⟨g, b, k, (top_le_basicOpen_iff x₀ W h₀W g).mp ((top_le_preimage_iff _ _).mpr hg₀),
    fun x h hx ↦ ?_⟩
  have hD := (top_le_basicOpen_iff x W h g).mpr hx
  refine ⟨hD.trans (Scheme.Hom.preimage_mono x hDU), ?_⟩
  have e := congrArg (val x _ hD) hb
  simp only [map_mul, map_pow] at e
  change val x _ hD (Y.presheaf.map (homOfLE hDU).op s) *
      val x _ hD (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op g) ^ k =
    val x _ hD (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op b) at e
  rwa [val_res, val_res, val_res] at e

end Val

section Embedding

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))

theorem isOpen_basicSet {U : Y.Opens} (hU : IsAffineOpen U) (s : Γ(Y, U)) {V : Set ℂ}
    (hV : IsOpen V) : IsOpen (ComplexPoints.basicSet σ π U s V) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨U, hU, s, V, hV, rfl⟩

theorem mem_basicSet_iff {U : Y.Opens} (s : Γ(Y, U)) (V : Set ℂ) (x : ComplexPoints σ π)
    (h : ⊤ ≤ x.1 ⁻¹ᵁ U) : x ∈ ComplexPoints.basicSet σ π U s V ↔ val x.1 U h s ∈ V :=
  ⟨fun ⟨_, hv⟩ ↦ hv, fun hv ↦ ⟨h, hv⟩⟩

variable {W : Y.Opens} (hW : IsAffineOpen W)

/-- `W(ℂ)`. -/
abbrev LW (W : Y.Opens) : Type := {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W}

/-- L'évaluation de toutes les sections de `Γ(Y, W)`. -/
noncomputable def ev (W : Y.Opens) (x : LW σ π W) : Γ(Y, W) → ℂ := fun t ↦ val x.1.1 W x.2 t

include hW in
theorem isOpen_LW : IsOpen {x : ComplexPoints σ π | ⊤ ≤ x.1 ⁻¹ᵁ W} := by
  convert isOpen_basicSet σ π hW 1 isOpen_univ using 1
  ext x
  exact ⟨fun h ↦ ⟨h, trivial⟩, fun ⟨h, _⟩ ↦ h⟩

include hW in
theorem continuous_ev : Continuous (ev σ π W) := by
  refine continuous_pi fun t ↦ continuous_def.mpr fun V hV ↦ ?_
  have : (fun x : LW σ π W ↦ ev σ π W x t) ⁻¹' V =
      Subtype.val ⁻¹' ComplexPoints.basicSet σ π W t V := by
    ext x
    exact (mem_basicSet_iff σ π t V x.1 x.2).symm
  rw [this]
  exact (isOpen_basicSet σ π hW t hV).preimage continuous_subtype_val

include hW in
theorem injective_ev : Function.Injective (ev σ π W) := by
  intro x x' hxx
  have e : val x.1.1 W x.2 = val x'.1.1 W x'.2 := RingHom.ext fun t ↦ congrFun hxx t
  exact Subtype.ext (Subtype.ext (by rw [eq_fromSpec hW x.1.1 x.2, eq_fromSpec hW x'.1.1 x'.2, e]))

include hW in
theorem induced_ev_le :
    TopologicalSpace.induced (ev σ π W) inferInstance ≤ (inferInstance : TopologicalSpace (LW σ π W)) := by
  change _ ≤ TopologicalSpace.induced Subtype.val (TopologicalSpace.generateFrom _)
  rw [induced_generateFrom_eq]
  refine le_generateFrom ?_
  rintro _ ⟨_, ⟨U, -, s, V, hV, rfl⟩, rfl⟩
  let _ : TopologicalSpace (LW σ π W) := TopologicalSpace.induced (ev σ π W) inferInstance
  refine isOpen_iff_forall_mem_open.mpr fun x₀ hx₀ ↦ ?_
  obtain ⟨h₀U, hv₀⟩ := hx₀
  obtain ⟨g, b, k, hg₀, hloc⟩ := exists_local_formula hW s x₀.1.1 x₀.2 h₀U
  let N : Set (Γ(Y, W) → ℂ) := {f | f g ≠ 0} ∩ (fun f ↦ f b / f g ^ k) ⁻¹' V
  have hN : IsOpen N := by
    refine ContinuousOn.isOpen_inter_preimage ?_ (isOpen_ne_fun (continuous_apply g)
      continuous_const) hV
    exact ((continuous_apply b).continuousOn).div ((continuous_apply g).pow k).continuousOn
      fun f hf ↦ pow_ne_zero k hf
  have hsx : ∀ x : LW σ π W, val x.1.1 W x.2 g ≠ 0 →
      ∃ hU : ⊤ ≤ x.1.1 ⁻¹ᵁ U, val x.1.1 U hU s = val x.1.1 W x.2 b / val x.1.1 W x.2 g ^ k := by
    intro x hx
    obtain ⟨hU, e⟩ := hloc x.1.1 x.2 hx
    exact ⟨hU, by rw [← e, mul_div_cancel_right₀ _ (pow_ne_zero k hx)]⟩
  refine ⟨ev σ π W ⁻¹' N, fun x hx ↦ ?_, isOpen_induced hN, ?_⟩
  · obtain ⟨hU, e⟩ := hsx x hx.1
    exact ⟨hU, show val x.1.1 U hU s ∈ V by rw [e]; exact hx.2⟩
  · obtain ⟨hU, e⟩ := hsx x₀ hg₀
    refine ⟨hg₀, ?_⟩
    change val x₀.1.1 W x₀.2 b / val x₀.1.1 W x₀.2 g ^ k ∈ V
    rw [← e]
    exact (mem_basicSet_iff σ π s V x₀.1 hU).mp ⟨h₀U, hv₀⟩

include hW in
/-- **Plongement de `W(ℂ)`** par l'évaluation des sections. -/
theorem isEmbedding_ev : Topology.IsEmbedding (ev σ π W) :=
  ⟨⟨le_antisymm (continuous_ev σ π hW).le_induced (induced_ev_le σ π hW)⟩, injective_ev σ π hW⟩

theorem complexPoints_isEmbedding_of_isAffineOpen_proof {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) (W : Y.Opens) (hW : IsAffineOpen W) :
    IsOpen {x : ComplexPoints σ π | ⊤ ≤ x.1 ⁻¹ᵁ W} ∧
    Topology.IsEmbedding (fun x : {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W} ↦
      fun t : Γ(Y, W) ↦ (Scheme.ΓSpecIso (.of ℂ)).hom (x.1.1.appLE W ⊤ x.2 t)) :=
  ⟨isOpen_LW σ π hW, isEmbedding_ev σ π hW⟩


end Embedding

section Generators

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))
  {W : Y.Opens}

theorem appLE_top_congr {f g : Spec (.of ℂ) ⟶ Spec (.of R)} (hfg : f = g) (e e') :
    f.appLE ⊤ ⊤ e = g.appLE ⊤ ⊤ e' := by
  subst hfg
  rfl

/-- La valeur en un point au-dessus de `σ` de l'image de `r ∈ R` est `σ r`. -/
theorem val_base (x : ComplexPoints σ π) (h : ⊤ ≤ x.1 ⁻¹ᵁ W) (r : R) (e : W ≤ π ⁻¹ᵁ ⊤) :
    val x.1 W h (π.appLE ⊤ W e ((Scheme.ΓSpecIso (.of R)).inv r)) = σ r := by
  have key : (Scheme.ΓSpecIso (.of R)).inv ≫ π.appLE ⊤ W e ≫ x.1.appLE W ⊤ h ≫
      (Scheme.ΓSpecIso (.of ℂ)).hom = CommRingCat.ofHom σ := by
    rw [← Category.assoc (π.appLE ⊤ W e), Scheme.Hom.appLE_comp_appLE x.1 π ⊤ W ⊤ e h,
      appLE_top_congr x.2 _ le_top]
    have h2 : (Spec.map (CommRingCat.ofHom σ)).appLE ⊤ ⊤ le_top =
        (Spec.map (CommRingCat.ofHom σ)).appTop := by
      simp [Scheme.Hom.appLE]
      rfl
    rw [h2, Scheme.ΓSpecIso_naturality]
    erw [Iso.inv_hom_id_assoc]
  exact congrArg (fun f ↦ f.hom r) key

theorem complexPoints_isEmbedding_of_generators_proof {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) (W : Y.Opens) (hW : IsAffineOpen W)
    (m : ℕ) (a : Fin m → Γ(Y, W))
    (ha : Subring.closure (Set.range a ∪
      Set.range fun r : R ↦ π.appLE ⊤ W le_top ((Scheme.ΓSpecIso (.of R)).inv r)) = ⊤) :
    Topology.IsEmbedding (fun x : {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W} ↦
      fun i : Fin m ↦ (Scheme.ΓSpecIso (.of ℂ)).hom (x.1.1.appLE W ⊤ x.2 (a i))) := by
  let eva : LW σ π W → (Fin m → ℂ) := fun x i ↦ ev σ π W x (a i)
  have hF : ∀ t : Γ(Y, W), ∃ F : (Fin m → ℂ) → ℂ, Continuous F ∧
      ∀ x : LW σ π W, ev σ π W x t = F (eva x) := by
    intro t
    have ht : t ∈ Subring.closure (Set.range a ∪
        Set.range fun r : R ↦ π.appLE ⊤ W le_top ((Scheme.ΓSpecIso (.of R)).inv r)) := by
      rw [ha]; trivial
    induction ht using Subring.closure_induction with
    | mem t ht =>
      rcases ht with ⟨i, rfl⟩ | ⟨r, rfl⟩
      · exact ⟨fun v ↦ v i, continuous_apply i, fun x ↦ rfl⟩
      · exact ⟨fun _ ↦ σ r, continuous_const, fun x ↦ val_base σ π x.1 x.2 r le_top⟩
    | zero => exact ⟨fun _ ↦ 0, continuous_const, fun x ↦ map_zero (val x.1.1 W x.2)⟩
    | one => exact ⟨fun _ ↦ 1, continuous_const, fun x ↦ map_one (val x.1.1 W x.2)⟩
    | add t t' _ _ h h' =>
      obtain ⟨F, hF, e⟩ := h
      obtain ⟨F', hF', e'⟩ := h'
      exact ⟨fun v ↦ F v + F' v, hF.add hF', fun x ↦ by
        show ev σ π W x (t + t') = F (eva x) + F' (eva x)
        rw [← e x, ← e' x]; exact map_add (val x.1.1 W x.2) t t'⟩
    | neg t _ h =>
      obtain ⟨F, hF, e⟩ := h
      exact ⟨fun v ↦ -F v, hF.neg, fun x ↦ by
        show ev σ π W x (-t) = -F (eva x)
        rw [← e x]; exact map_neg (val x.1.1 W x.2) t⟩
    | mul t t' _ _ h h' =>
      obtain ⟨F, hF, e⟩ := h
      obtain ⟨F', hF', e'⟩ := h'
      exact ⟨fun v ↦ F v * F' v, hF.mul hF', fun x ↦ by
        show ev σ π W x (t * t') = F (eva x) * F' (eva x)
        rw [← e x, ← e' x]; exact map_mul (val x.1.1 W x.2) t t'⟩
  choose F hFc hFe using hF
  let G : (Fin m → ℂ) → (Γ(Y, W) → ℂ) := fun v t ↦ F t v
  have hG : G ∘ eva = ev σ π W := funext fun x ↦ funext fun t ↦ (hFe t x).symm
  have hemb := isEmbedding_ev σ π hW
  have heva : Continuous eva :=
    continuous_pi fun i ↦ (continuous_apply (a i)).comp hemb.continuous
  refine ⟨Topology.IsInducing.of_comp heva (continuous_pi fun t ↦ hFc t) (hG ▸ hemb.isInducing),
    fun x x' hxx ↦ hemb.injective ?_⟩
  rw [← hG, Function.comp_apply, Function.comp_apply]
  exact congrArg G hxx


end Generators

