    rintro (ℓ | s)
    · exact (hIG ℓ).1
    · exact (hSSc s).1

  have hoff : ∀ x : X₀, (∀ e, x ≠ nd e) → x ∈ toBase₀.smoothLocus := by
    intro x hxnd
    by_cases hx : toBase₀.base x = closedPoint A₀
    · by_cases hnc : ∃ y : X₀, x ⤳ y ∧ y ≠ x
      · obtain ⟨i, rfl⟩ := (hgen_iff x hx).mpr hnc
        exact hgen_sm i
      · have hxc : ∀ y : X₀, x ⤳ y → y = x := fun y hy => by
          by_contra h; exact hnc ⟨y, hy, h⟩
        obtain ⟨i, hi⟩ := hcomp_ex x hx hxc
        rcases i with ℓ | s
        · by_cases hdr : ∃ s : ↥W, gen (Sum.inr s) ⤳ x
          · obtain ⟨s, hs⟩ := hdr
