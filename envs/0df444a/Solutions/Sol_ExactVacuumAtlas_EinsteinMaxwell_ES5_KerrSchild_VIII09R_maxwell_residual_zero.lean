theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    Tendsto (fun ε : ℝ =>
        VII18.maxwellResidual (fE j ε) (mE j ε) (N0 3 1) (aE j ε) (3 / 2) (ε * j) R / ε ^ 3)
      (𝓝[≠] (0:ℝ)) (𝓝 0) := by
  have h := maxwell_residual_limit j hR
  have hz : P R * (Lmag (c3f j) R - q3j j (1 / R) / R ^ 3) = 0 := by
    show P R * (Lmag (cj j) R - q3j j (1 / R) / R ^ 3) = 0
    rw [cj_LmagEq j R (mem_Ioi.mpr hR)]
    ring
  rw [hz] at h
  exact h
