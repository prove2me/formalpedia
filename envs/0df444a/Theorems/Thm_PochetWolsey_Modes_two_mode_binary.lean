-- title:
--   Proposition 12.5 — two-setup sequence characterization
-- statement:
--   Let $Y^{M2-SC}$ consist of setup/startup pairs generated by nonempty repetition-free lists of at most two labels per period, with the last label of one period first in the next. It equals the binary constraint set
--   $$\sum_i(y_i(t)-z_i(t))=1,\qquad \sum_i z_i(t)\le1,\qquad z_i(t)\le y_i(t),$$
--   $$z_i(t+1)\ge y_i(t+1)-y_i(t),\qquad z_i(t+1)+z_i(t)\le y_i(t+1),$$
--   where the last two inequalities apply between adjacent periods. This is an equality of discrete feasible sets, not a convex-hull assertion.
--
--   **Formalization Note** There are $m+1$ labels, including idle label $0$, and $n+1$ periods, numbered $0,\ldots,n$. Thus $m=n=0$ means one idle label and one period, not empty index sets. The initial setup is unrestricted. Eliminating its one-hot value with zero initial startup leaves the displayed first-period conditions; no terminal continuation is prescribed.
-- source:
--   Pochet and Wolsey, Production Planning by Mixed Integer Programming, Springer 2006, p. 379 (PDF 390), Proposition 12.5

import Mathlib

namespace PochetWolsey.Modes

theorem two_mode_binary (m n : ℕ) :
    {p : (Fin (m + 1) → Fin (n + 1) → ℝ) × (Fin (m + 1) → Fin (n + 1) → ℝ) | ∃ s : Fin (n + 1) → List (Fin (m + 1)),
      (∀ t, s t ≠ [] ∧ (s t).Nodup) ∧
      (∀ t : Fin n, (s t.castSucc).getLast? = (s t.succ).head?) ∧ (∀ t, (s t).length ≤ 2) ∧ p = ((fun i t => if i ∈ s t then (1 : ℝ) else 0), (fun i t => if i ∈ (s t).tail then (1 : ℝ) else 0))} =
    {p | (∀ i, (∀ t, p.1 i t = 0 ∨ p.1 i t = 1)) ∧ (∀ i, (∀ t, p.2 i t = 0 ∨ p.2 i t = 1)) ∧
    (∀ t, ∑ i, (p.1 i t - p.2 i t) = 1) ∧
    (∀ t, ∑ i, p.2 i t ≤ 1) ∧
    (∀ i t, p.2 i t ≤ p.1 i t) ∧
    (∀ i (t : Fin n), p.2 i t.succ ≥ p.1 i t.succ - p.1 i t.castSucc) ∧
    (∀ i (t : Fin n), p.2 i t.succ + p.2 i t.castSucc ≤ p.1 i t.succ)} := by sorry

end PochetWolsey.Modes
