    (row : Position width → CompletePhaseCell machine.tm)
    (hholes : ∀ stack : machine.tm.K,
      NoInteriorPaddingHoles machine.tm
        (fullPackedPhaseStackAtoms machine width row stack))
    (hbound : ∀ stack : machine.tm.K,
