-- title:
--   Regular differentials on X₁(M) over ℚ̄ give S₂(Γ₁(M))
-- statement:
--   Let $M$ be a positive natural number (a `NeZero M` instance) and let $\iota_0 : \overline{\mathbb Q} \to \mathbb C$ be a ring homomorphism, used to regard $\mathbb C$ as an $\overline{\mathbb Q}$-algebra. Write $F =$ [`ModularCurve.x1FunctionFieldBar M`](def/ModularCurve_X1.html#L182) for the intermediate field of $\overline{\mathbb Q} \subseteq \overline{\mathbb Q}((q))$ obtained as `laurentBaseChange`, i.e. generated over $\overline{\mathbb Q}$ by the image of the rational $q$-expansion function field [`ModularCurve.x1FunctionField M`](def/ModularCurve_X1.html#L137) under the coefficientwise embedding $\mathbb Q((q)) \hookrightarrow \overline{\mathbb Q}((q))$. Inside $\Omega[F\,/\,\overline{\mathbb Q}]$ let $\Omega_{\mathrm{reg}} =$ [`AlgebraicCurve.regularDifferentials`](def/AlgebraicCurve_RegularDifferentials.html#L26) be the $\overline{\mathbb Q}$-submodule of those $\omega$ such that for every place $v$ of $F$ over $\overline{\mathbb Q}$ — that is, every valuation subring of $F$ containing $\operatorname{im}(\overline{\mathbb Q})$, distinct from $F$ itself and a principal ideal ring — one has $\omega = f \cdot \mathrm{d}\pi_v$ for some $f$ in that valuation subring, where $\pi_v$ is the chosen uniformiser at $v$. Let $\Theta =$ [`ModularCurve.diffQExp`](def/ModularCurve_HeckeDifferential.html#L128) be the $F$-linear map $\Omega[F\,/\,\overline{\mathbb Q}] \to \overline{\mathbb Q}((q))$ obtained by lifting the derivation $q\,\mathrm{d}/\mathrm{d}q$ restricted along $F \hookrightarrow \overline{\mathbb Q}((q))$. The assertion is that there exists a $\mathbb C$-linear isomorphism $e : \mathbb C \otimes_{\overline{\mathbb Q}} \Omega_{\mathrm{reg}} \to S_2(\Gamma_1(M))$, the space of weight-$2$ cusp forms for `CongruenceSubgroup.Gamma1 M`, such that for every $\omega \in \Omega_{\mathrm{reg}}$ the Laurent series $\Theta(\omega)$, pushed forward coefficientwise along $\iota_0$ by [`ModularCurve.coeffMap`](def/ModularCurve_LaurentCoeff.html#L16), coincides with the $q$-expansion of width $1$ of the cusp form $e(1 \otimes \omega)$, viewed as a Laurent series via `HahnSeries.ofPowerSeries`.
--
--   This is the $q$-expansion dictionary identifying the holomorphic differentials of the modular curve $X_1(M)$, in its model over $\overline{\mathbb Q}$ with rational cusp $\infty$, with weight-$2$ cusp forms on $\Gamma_1(M)$ having algebraic Fourier coefficients, these spanning $S_2(\Gamma_1(M))$ over $\mathbb C$ after base change. It is used to transport the Hecke and diamond action from differentials to cusp forms, in particular by the results producing injective ring homomorphisms from the algebra generated by the Hecke and diamond operators into endomorphisms of spaces of cusp forms.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_linearEquiv_tensor_regularDifferentials_x1FunctionFieldBar_cuspForm.lean

import Mathlib
import Definitions.Def_ModularCurve_X1
import Definitions.Def_ModularCurve_HeckeDifferential
import Definitions.Def_AlgebraicCurve_RegularDifferentials

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open scoped TensorProduct

theorem ModularCurve.exists_linearEquiv_tensor_regularDifferentials_x1FunctionFieldBar_cuspForm
    (M : ℕ) [NeZero M] (ι₀ : AlgebraicClosure ℚ →+* ℂ) :
    letI := ι₀.toAlgebra
    ∃ e : ℂ ⊗[AlgebraicClosure ℚ]
          ↥(AlgebraicCurve.regularDifferentials (AlgebraicClosure ℚ)
              ↥(ModularCurve.x1FunctionFieldBar M)) ≃ₗ[ℂ]
        CuspForm (CongruenceSubgroup.Gamma1 M) 2,
      ∀ ω : ↥(AlgebraicCurve.regularDifferentials (AlgebraicClosure ℚ)
          ↥(ModularCurve.x1FunctionFieldBar M)),
        ModularCurve.coeffMap ι₀
            (ModularCurve.diffQExp (ModularCurve.x1FunctionFieldBar M)
              (ω : Ω[↥(ModularCurve.x1FunctionFieldBar M)⁄AlgebraicClosure ℚ])) =
          HahnSeries.ofPowerSeries ℤ ℂ (UpperHalfPlane.qExpansion 1 ⇑(e (1 ⊗ₜ ω))) := by sorry
