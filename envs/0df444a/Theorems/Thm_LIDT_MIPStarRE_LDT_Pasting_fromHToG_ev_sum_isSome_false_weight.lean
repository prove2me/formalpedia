@[expose] public section

open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma LIDT.MIPStarRE.LDT.Pasting.fromHToG_ev_sum_isSome_false_weight
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (ψbi : _root_.LIDT.MIPStarRE.LDT.QuantumState (ι × ι))
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι) (x : _root_.LIDT.MIPStarRE.LDT.Fq params)
    (A S : _root_.LIDT.MIPStarRE.Quantum.Op ι) :
    (∑ g ∈ (Finset.univ : Finset (_root_.LIDT.MIPStarRE.LDT.Pasting.GHatOutcome params)) with g.isSome = false,
        _root_.LIDT.MIPStarRE.LDT.ev ψbi (_root_.LIDT.MIPStarRE.LDT.leftTensor (ι₂ := ι) A *
          _root_.LIDT.MIPStarRE.LDT.rightTensor (ι₁ := ι)
            (S * (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatIdxMeas params family x).outcome g *
              (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatIdxMeas params family x).outcome g))) =
      _root_.LIDT.MIPStarRE.LDT.ev ψbi (_root_.LIDT.MIPStarRE.LDT.leftTensor (ι₂ := ι) A *
        _root_.LIDT.MIPStarRE.LDT.rightTensor (ι₁ := ι) (S * (_root_.LIDT.MIPStarRE.LDT.Pasting.incompletePartSubMeas params family x).total)) := by sorry
