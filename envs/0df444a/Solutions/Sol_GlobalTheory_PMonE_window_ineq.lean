      have h4 := hlt
      have h5 := hper (-1)
      rw [show (-1 : ℤ) + h = (h : ℤ) - 1 by ring] at h5
      rw [h5, mul_div_cancel₀ _ hp0.ne'] at h4
      exact h4
    linarith
  · intro hJ
    apply hdiv
    have h1 := hL J (by omega)
    have h2 : α (-h) ≤ α J := hα hJ
    have h3 := hαper (-h)
    rw [neg_add_cancel] at h3
    linarith
  · intro hJ
