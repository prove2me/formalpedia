section Helpers

theorem isComm_map {R S : Type} [CommRing R] [CommRing S] {g : ℕ} (F : MvFormalGroup g R) [hF : F.IsComm]
    (f : R →+* S) : (F.map f).IsComm := by
  refine ⟨fun i => ?_⟩
  have hsw : MvPowerSeries.HasSubst (Sum.elim (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin g ⊕ Fin g) R))
      fun j => MvPowerSeries.X (Sum.inl j)) :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero (by rintro (j | j) <;> simp [MvPowerSeries.constantCoeff_X])
  have key := congrArg (MvPowerSeries.map f) (hF.comm i)
  rw [MvPowerSeries.map_subst hsw] at key
  have hfun : (fun s => MvPowerSeries.map f (Sum.elim (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin g ⊕ Fin g) R))
      (fun j => MvPowerSeries.X (Sum.inl j)) s)) =
      Sum.elim (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin g ⊕ Fin g) S)) fun j => MvPowerSeries.X (Sum.inl j) := by
    funext s; rcases s with j | j <;> simp
  show MvPowerSeries.subst _ (MvPowerSeries.map f (F.toPowerSeries i)) = MvPowerSeries.map f (F.toPowerSeries i)
  rw [← hfun]; exact key

theorem charP_residueField_of_isNilpotent {q : ℕ} [Fact q.Prime] (B : Type) [CommRing B] [IsLocalRing B]
    (hq : IsNilpotent ((q : ℕ) : B)) : CharP (ResidueField B) q := by
  refine (CharP.charP_iff_prime_eq_zero Fact.out).mpr ?_
  have h := (hq.map (residue B)).eq_zero
  rwa [map_natCast] at h

theorem nilEval_eq_of_map_eq_X
    {B B₁ B'' : Type} [CommRing B] [CommRing B₁] [CommRing B''] [Algebra B B₁] [Algebra B B''] [Algebra B₁ B'']
    [IsScalarTower B B₁ B'']
    {σ : Type} [Fintype σ] [DecidableEq σ] (φ : MvPowerSeries σ B) (i : σ)
    (hφ : MvPowerSeries.map (algebraMap B B₁) φ = MvPowerSeries.X i)
    (J : Ideal B'') (n : ℕ) (hJ : J ^ (n + 1) = ⊥) (s : σ → B'') (hs : ∀ j, s j ∈ J) :
    MvFormalGroup.nilEval n φ s = s i := by
  have hmap : ∀ (N : σ →₀ ℕ), MvPolynomial.map (algebraMap B B₁) (MvPowerSeries.trunc' B N φ) =
      MvPowerSeries.trunc' B₁ N (MvPowerSeries.map (algebraMap B B₁) φ) := by
    intro N
    ext m
    simp only [MvPolynomial.coeff_map, MvPowerSeries.coeff_trunc', MvPowerSeries.coeff_map]
    split_ifs <;> simp
  have key : MvFormalGroup.nilEval n φ s =
      MvFormalGroup.nilEval (B := B₁) n (MvPowerSeries.X i : MvPowerSeries σ B₁) s := by
    unfold MvFormalGroup.nilEval
    rw [MvPolynomial.aeval_def, MvPolynomial.aeval_def, IsScalarTower.algebraMap_eq B B₁ B'',
      ← MvPolynomial.eval₂_map, hmap, hφ]
  rw [key]
  exact MvFormalGroup.nilEval_X_of_mem J n hJ s hs i

