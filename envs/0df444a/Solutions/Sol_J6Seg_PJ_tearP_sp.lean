-- Source module: Solutions.J6SegILPreJC8
/-!
# B5 set-up, part 8: the tear-down (plain `Sp`)

`tearP oN`: pop `oN 0 … oN 8`, pop `|T|` entries of `oN 10` (count on `oN 9`), pop `oN 9`:
from `extend oN V F` back to `F` (`tearP_sp`), for any register file `V` of the `kerRegs` shape.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

/-- **The tear-down.** -/
theorem tearP_sp_sol_aux (s : IState HS) (oN : Fin 19 → Fin HS) (hinj : Injective oN)
    (hlt : ∀ i, (oN i).val < 56) (hC : ∀ i, oN i ≠ cLC)
    (F : Cs) (hFo : ∀ i, F (oN i) = []) (hFC : F cLC = [])
    (V : Fin 19 → List ℤ) (T : List ℤ) (x : Fin 9 → ℤ)
    (hVs : ∀ i : Fin 9, V (Fin.castLE (by omega) i) = [x i])
    (hV9 : V 9 = [(T.length : ℤ)]) (hV10 : V 10 = T) (hVr : ∀ i : Fin 19, 11 ≤ i.val → V i = [])
    (B : ℕ) (hxB : ∀ i, zsz (x i) ≤ B) (hlB : zsz (T.length : ℤ) ≤ B) (hTB : Bnd B T) :
    Sp (tearP oN) (encK s (extend oN V F)) (encK s F) (cTear B T.length) := by
  have hnd : (l9 oN).Nodup := List.nodup_ofFn.mpr (hinj.comp (Fin.castLE_injective _))
  have hNl : ∀ k : Fin 19, 9 ≤ k.val → oN k ∉ l9 oN := by
    intro k hk; rw [mem_l9]; rintro ⟨i, hi⟩
    have := hinj hi; rw [Fin.ext_iff] at this; simp at this; omega
  set G : Cs := update (update F (oN 9) [(T.length : ℤ)]) (oN 10) T with hG
  have e0 : extend oN V F = pushL (l9 oN) (fun j => (extend oN V F j).headD 0) G := by
    funext j
    by_cases hj : ∃ i, oN i = j
    · obtain ⟨i, rfl⟩ := hj
      rw [hinj.extend_apply]
      by_cases ilt : i.val < 9
      · have e : i = Fin.castLE (by omega) (⟨i.val, ilt⟩ : Fin 9) := Fin.ext rfl
        have hm : oN i ∈ l9 oN := mem_l9.mpr ⟨⟨i.val, ilt⟩, by rw [← e]⟩
        simp only [pushL, if_pos hm, hinj.extend_apply]
        rw [e, hVs, hG, update_of_ne (hinj.ne (by rw [Fin.ne_iff_vne]; simp; omega)),
          update_of_ne (hinj.ne (by rw [Fin.ne_iff_vne]; simp; omega)), hFo]
        rfl
      · have hm := hNl i (by omega)
        simp only [pushL, if_neg hm, hG]
        by_cases i10 : i = 10
        · subst i10; rw [update_self, hV10]
        rw [update_of_ne (hinj.ne i10)]
        by_cases i9 : i = 9
        · subst i9; rw [update_self, hV9]
        rw [update_of_ne (hinj.ne i9), hFo, hVr i (by
          have : i.val ≠ 9 := fun h => i9 (Fin.ext h)
          have : i.val ≠ 10 := fun h => i10 (Fin.ext h)
          omega)]
    · have nl : j ∉ l9 oN := by rw [mem_l9]; rintro ⟨i, hi⟩; exact hj ⟨_, hi⟩
      simp only [pushL, if_neg nl, hG]
      rw [extend_apply' _ _ _ hj, update_of_ne (fun h => hj ⟨10, h.symm⟩),
        update_of_ne (fun h => hj ⟨9, h.symm⟩)]
  have hGl : ∀ j ∈ l9 oN, G j = [] := by
    intro j hj
    obtain ⟨i, rfl⟩ := mem_l9.mp hj
    rw [hG, update_of_ne (hinj.ne (by rw [Fin.ne_iff_vne]; simp; omega)),
      update_of_ne (hinj.ne (by rw [Fin.ne_iff_vne]; simp; omega)), hFo]
  have S1 := finiP_sp s (l9 oN) G (fun j => (extend oN V F j).headD 0) B hnd
    (fun j hj => by obtain ⟨i, rfl⟩ := mem_l9.mp hj; exact hlt _)
    (fun j hj => by
      obtain ⟨i, rfl⟩ := mem_l9.mp hj
      simp only [hinj.extend_apply, hVs, List.headD_cons]; exact hxB i)
  rw [← e0] at S1
  have hG9 : G (oN 9) = [(T.length : ℤ)] := by
    rw [hG, update_of_ne (hinj.ne (by decide)), update_self]
  have hGC : ∀ L : List ℤ, update G (oN 10) L cLC = [] := fun L => by
    rw [update_of_ne (hC 10).symm, hG, update_of_ne (hC 10).symm, update_of_ne (hC 9).symm, hFC]
  have S2 := Sp.rep (C := cLC) (n := .reg (oN 9)) (b := .pop (oN 10)) (s := s)
    (F := fun k => update G (oN 10) (T.drop k)) (N := T.length) (B := B) (c := 2 * B + 2)
    (by decide) (fun k => hGC _) (by simp only [RS.writes, List.mem_singleton]; exact fun h => hC 10 h.symm) (clean_reg (hlt 9))
    (ok_reg (by rw [update_of_ne (hinj.ne (by decide))]; exact hG9)) trivial
    (bnd_reg (by rw [update_of_ne (hinj.ne (by decide))]; exact hG9) hlB)
    (by rw [eval_reg (by rw [update_of_ne (hinj.ne (by decide))]; exact hG9)])
    (fun k hk => by
      have h := Sp.pop (i := oN 10) (B := B) s
        (update (update G (oN 10) (T.drop k)) cLC [(T.length : ℤ) - k]) (hlt 10)
        (a := T[k]) (l := T.drop (k + 1))
        (by rw [update_of_ne (hC 10), update_self, List.drop_eq_getElem_cons hk])
        (hTB _ (List.getElem_mem hk))
      simpa only [update_comm (hC 10), update_idem] using h)
  simp only [List.drop_zero] at S2
  have e1 : update G (oN 10) T = G := by rw [hG, update_idem]
  rw [e1, List.drop_length] at S2
  have hG9' : update G (oN 10) [] (oN 9) = (T.length : ℤ) :: [] := by
    rw [update_of_ne (hinj.ne (by decide)), hG9]
  have S3 := Sp.pop (i := oN 9) (B := B) s (update G (oN 10) []) (hlt 9) hG9' hlB
  have e2 : update (update G (oN 10) []) (oN 9) [] = F := by
    funext j
    rw [hG]
    by_cases j9 : j = oN 9
    · subst j9; rw [update_self, hFo]
    rw [update_of_ne j9]
    by_cases j10 : j = oN 10
    · subst j10; rw [update_self, hFo]
    rw [update_of_ne j10, update_of_ne j10, update_of_ne j9]
  rw [e2] at S3
  refine (S1.seq (S2.seq S3)).mono ?_
  simp only [cTear, List.length_ofFn, l9, Ex.size]; omega

end J6Seg.PJ

end

theorem solution : type_of% @J6Seg.PJ.tearP_sp_sol_aux := @J6Seg.PJ.tearP_sp_sol_aux
