open IntMul NLogN RS

theorem bandF_snoc (R : ℤ) (Dl : List ℕ) (W : List ℤ) :
    ∀ (Ws : List (List ℤ)) (X acc : List ℤ),
    bandF R Dl (Ws ++ [W]) X acc = bandRound R (X.drop Ws.length) Dl W (bandF R Dl Ws X acc)
  | [], X, acc => by simp [bandF]
  | Wi :: Ws, X, acc => by
    simp only [List.cons_append, bandF, List.length_cons]
    rw [bandF_snoc R Dl W Ws, List.drop_drop]; congr 2; omega

theorem flatten_drop (Ws : List (List ℤ)) (j : ℕ) (hj : j < Ws.length) :
    (Ws.drop j).flatten = Ws[j] ++ (Ws.drop (j + 1)).flatten := by
  rw [List.drop_eq_getElem_cons hj, List.flatten_cons]

set_option maxHeartbeats 4000000 in
theorem outer_states (s : IState HS) (R : ℤ) (Xl : List ℤ) (Dl : List ℕ) (Ws : List (List ℤ))
    (acc : List ℤ) (RX RW RD RA LR LN LNR : List Item) (n NR : ℕ)
    (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n) (hDl : Dl.length = n)
    (hal : acc.length = n) (hXl : NLogN.Rsp.pre Dl n + NR ≤ Xl.length)
    (hR : s.G BR = .int R :: LR) (hN : s.G BN = .int n :: LN) (hNR : s.G BNR = .int NR :: LNR)
    (hX : s.G NLogN.Rsp.BX = ints Xl ++ RX) (hW : s.G NLogN.Rsp.BW = ints Ws.flatten ++ RW)
    (hD : s.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : s.G BA = ints acc ++ RA) :
    RM.RepStates BCR (.reg BNR) NLogN.Rsp.roundBody s (rSt s R Xl Dl Ws acc RX RW RA) where
  nonneg := by simp [Ex.eval, IState.top, hNR]
  hw := by decide
  h0 := by
    apply IState.ext' _ (by simp [rSt]) (by simp [rSt])
    intro x; simp only [rSt, IState.upd_G]
    split_ifs <;> subst_vars <;> simp_all [bandF]
  hG := fun k => by simp (config := {decide := true}) [rSt]
  step := fun k hk => by
    have e : ((Ex.reg BNR).eval s).toNat = NR := by simp [Ex.eval, IState.top, hNR]
    rw [e] at hk ⊢
    generalize ht : withCtr BCR s NR k (rSt s R Xl Dl Ws acc RX RW RA k) = t
    have tG : ∀ x, x ≠ BCR → t.G x = (rSt s R Xl Dl Ws acc RX RW RA k).G x := fun x hx => by
      rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
    have hkW : k < Ws.length := by omega
    have hlen : (Ws[k]).length = n := hWr _ (List.getElem_mem hkW)
    have hacc : (bandF R Dl (Ws.take k) Xl acc).length = n := by rw [bandF_length, hal]
    have hr := round_run t R (Xl.drop k) Dl Ws[k] (bandF R Dl (Ws.take k) Xl acc) RX
      (ints (Ws.drop (k + 1)).flatten ++ RW) RD RA LR LN n hlen hDl hacc
      (by simp; omega)
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hR])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hN])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, flatten_drop Ws k hkW,
        ints_append])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt, hD])
      (by rw [tG _ (by decide)]; simp (config := {decide := true}) [rSt])
    rw [hr]
    have hsnoc : bandF R Dl (Ws.take (k + 1)) Xl acc =
        bandRound R (Xl.drop k) Dl Ws[k] (bandF R Dl (Ws.take k) Xl acc) := by
      rw [← List.take_concat_get' Ws k hkW, bandF_snoc, List.length_take, min_eq_left hkW.le]
    have hft : (Ws.take (k + 1)).flatten.reverse = Ws[k].reverse ++ (Ws.take k).flatten.reverse := by
      rw [← List.take_concat_get' Ws k hkW, List.flatten_append, List.flatten_singleton,
        List.reverse_append]
    rw [← ht]
    apply IState.ext' _ (by simp [withCtr, rSt]) (by simp [withCtr, rSt])
    intro x
    simp only [withCtr, rSt, IState.upd_G]
    split_ifs <;> subst_vars <;> simp_all (config := {decide := true}) [ints_append, ints_reverse]

theorem flatten_length_eq (Ws : List (List ℤ)) (n : ℕ) (hWr : ∀ W ∈ Ws, W.length = n) :
    Ws.flatten.length = n * Ws.length := by
  induction Ws with
  | nil => simp
  | cons W Ws ih =>
    simp only [List.flatten_cons, List.length_append, List.length_cons]
    rw [hWr W (by simp), ih (fun W' h => hWr W' (by simp [h]))]; ring

/-- **The banded multiply–accumulate program.**  With `X` on `BX`, the deltas `Dl` on `BD`, the
table rows `Ws` (each of length `n`) on `BW`, the accumulator on `BA`, `R` on `BR`, `n` on `BN`,
`NR = Ws.length` on `BNR` and `n · NR` on `BNW`, `bandP` replaces `X` by `X.drop NR` and the
accumulator by `bandF R Dl Ws X acc` (see `bandF_getD`); every other stack is restored. -/
theorem bandP_run (s : IState HS) (R : ℤ) (Xl : List ℤ) (Dl : List ℕ) (Ws : List (List ℤ))
    (acc : List ℤ) (RX RW RD RA LR LN LNR LNW : List Item) (n NR : ℕ)
    (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n) (hDl : Dl.length = n)
    (hal : acc.length = n) (hXl : NLogN.Rsp.pre Dl n + NR ≤ Xl.length)
    (hR : s.G BR = .int R :: LR) (hN : s.G BN = .int n :: LN) (hNR : s.G BNR = .int NR :: LNR)
    (hNW : s.G BNW = .int (n * NR : ℕ) :: LNW)
    (hX : s.G NLogN.Rsp.BX = ints Xl ++ RX) (hW : s.G NLogN.Rsp.BW = ints Ws.flatten ++ RW)
    (hD : s.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : s.G BA = ints acc ++ RA) :
    bandP.run s = (s.upd NLogN.Rsp.BX (ints (Xl.drop NR) ++ RX)).upd BA (ints (bandF R Dl Ws Xl acc) ++ RA) := by
  have H := outer_states s R Xl Dl Ws acc RX RW RD RA LR LN LNR n NR hWs hWr hDl hal hXl hR hN hNR
    hX hW hD hA
  have e : ((Ex.reg BNR).eval s).toNat = NR := by simp [Ex.eval, IState.top, hNR]
  have hrun := H.run
  rw [e] at hrun
  rw [bandP, RM.run_seq, RM.run_rs, hrun]
  have hWt : Ws.take NR = Ws := List.take_of_length_le (by omega)
  have hWd : Ws.drop NR = [] := List.drop_of_length_le (by omega)
  have hm := mvK_spec (X := BWT) (Y := NLogN.Rsp.BW) (C := BCK) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BNW) (RS.clean_of_lt (by decide))
    (rSt s R Xl Dl Ws acc RX RW RA NR) Ws.flatten.reverse (s.G BWT)
    (by simp (config := {decide := true}) [rSt, hWt, ints_reverse])
    (IState.isInt_of (L := LNW) (a := ((n * NR : ℕ) : ℤ)) (by simp (config := {decide := true}) [rSt, hNW]))
    (by simp (config := {decide := true}) [Ex.eval, IState.top, rSt, hNW, flatten_length_eq Ws n hWr, hWs])
  rw [hm.2]
  apply IState.ext' _ (by simp [rSt]) (by simp [rSt])
  intro x; simp only [rSt, IState.upd_G]
  split_ifs <;> subst_vars <;> simp_all (config := {decide := true}) [← ints_reverse]

end NLogN.Rsp

