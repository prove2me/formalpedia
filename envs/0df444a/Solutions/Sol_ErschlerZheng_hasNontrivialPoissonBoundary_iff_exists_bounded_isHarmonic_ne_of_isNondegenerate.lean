/-! ### Item 1: non-degenerate `μ` -/

section Nondegenerate

variable {G : Type*} [Group G]

/-- For non-degenerate `μ`, every element lies in the submonoid generated by the support. -/
theorem mem_closure_support_of_isNondegenerate (μ : G → ℝ) (h : IsNondegenerate μ) (x : G) :
    x ∈ Submonoid.closure (Function.support μ) := by
  have hx : x ∈ Subsemigroup.closure {g | μ g ≠ 0} := by rw [h]; trivial
  have hle : Subsemigroup.closure {g | μ g ≠ 0} ≤
      (Submonoid.closure (Function.support μ)).toSubsemigroup :=
    Subsemigroup.closure_le.mpr Submonoid.subset_closure
  exact hle hx

end Nondegenerate

