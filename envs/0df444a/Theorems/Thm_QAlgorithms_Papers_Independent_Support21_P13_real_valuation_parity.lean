-- title:
--   Parity of the dividing exponent of a real cyclotomic integer
-- statement:
--   Let $a,b\in\mathbb Z$, let $v$ denote the $\sqrt2$ dividing exponent in $\mathbb Z[\omega]$, and let $v_2$ denote the base-two dividing exponent of an integer, including $v_2(0)=\infty$. If $(a,b)\ne(0,0)$, the exponent $d=v(a+\sqrt2b)$ is finite, and
--
--   $$
--   \begin{aligned}
--   d\text{ even}&\ \Longleftrightarrow\ v_2(b)\ge v_2(a),
--   & d\text{ even}&\ \Longrightarrow\ v_2(a)=d/2,\\
--   d\text{ odd}&\ \Longleftrightarrow\ v_2(b)<v_2(a),
--   & d\text{ odd}&\ \Longrightarrow\ v_2(b)=(d-1)/2.
--   \end{aligned}
--   $$
--
--   At $a=b=0$ all three exponents are infinite, and no parity is assigned. This is the finite-parity reading of Proposition 1, with the source's omitted zero branch made explicit. The parity-swapped inclusions printed below the proposition are not used.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 12, Proposition 1: valuation parity of real cyclotomic integers

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Proposition 1, PDF p.12: finite parity is used only off (a,b)=(0,0).
The all-zero branch has infinite valuations. The printed A1/B1 and A2/B2
inclusions below the proposition reverse parity and are not transcribed. -/
theorem real_valuation_parity (a b : ℤ) :
    (a = 0 ∧ b = 0 →
      gde ((a : ℂ) + ((Real.sqrt 2 : ℝ) : ℂ) * (b : ℂ)) = ⊤ ∧
      emultiplicity (2 : ℤ) a = ⊤ ∧ emultiplicity (2 : ℤ) b = ⊤) ∧
    (a ≠ 0 ∨ b ≠ 0 → ∃ d : ℕ,
      gde ((a : ℂ) + ((Real.sqrt 2 : ℝ) : ℂ) * (b : ℂ)) = (d : ℕ∞) ∧
      (Even d ↔ emultiplicity (2 : ℤ) a ≤ emultiplicity (2 : ℤ) b) ∧
      (Odd d ↔ emultiplicity (2 : ℤ) b < emultiplicity (2 : ℤ) a) ∧
      (Even d → emultiplicity (2 : ℤ) a = ((d / 2 : ℕ) : ℕ∞)) ∧
      (Odd d → emultiplicity (2 : ℤ) b = (((d - 1) / 2 : ℕ) : ℕ∞))) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
