theorem solution
    {S : Type u} [CommRing S] {Z : Scheme.{u}} (f : Z ⟶ Spec (CommRingCat.of S))
    (hsm : Smooth f) (hpr : IsProper f)
    (hproj : ∃ (N : ℕ) (ι : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) S)),
      IsClosedImmersion ι ∧ ι ≫ ProjSpace.π S N = f)
    (hconn : ∀ (k : Type u) [Field k] [IsAlgClosed k] (x : S →+* k),
      ConnectedSpace ↥(pullback f (Spec.map (CommRingCat.ofHom x))))
    (ε : SchemeHomOver (𝟙 (Spec (CommRingCat.of S))) f) :
    IsOpen {s : ↥(Spec (CommRingCat.of S)) | ∀ (k : Type u) [Field k] [IsAlgClosed k] (x : S →+* k),
        RingHom.ker x = s.asIdeal →
        Nonempty (RelativeGroupLaw k (pullback.snd f (Spec.map (CommRingCat.ofHom x))))} := by
  classical

  obtain ⟨S₀, hfg, Z₀, f₀, g, hpb, hsm₀, hpr₀, hproj₀, hconn₀, ε₀, hε⟩ :=
    AlgebraicGeometry.exists_fg_subalgebra_isPullback_smooth_isProper_of_isClosedImmersion_proj f hsm hpr hproj hconn ε
  haveI : Algebra.FiniteType ℤ ↥S₀ := ⟨(Subalgebra.fg_top S₀).mpr hfg⟩
  haveI : IsNoetherianRing ↥S₀ := Algebra.FiniteType.isNoetherianRing ℤ ↥S₀
  have hΛ₀ := GoodReductionJacobian.AbelianSchemePropertyBundle.isOpen_setOf_nonempty_relativeGroupLaw_geometricFibre_of_isNoetherianRing
    f₀ hsm₀ hpr₀ hproj₀ hconn₀ ε₀

  set a : ↥S₀ →+* S := algebraMap ↥S₀ S with ha
  have hker : ∀ (s : ↥(Spec (CommRingCat.of S))) {k : Type u} [Field k] (x : S →+* k), RingHom.ker x = s.asIdeal →
      RingHom.ker (x.comp a) = ((Spec.map (CommRingCat.ofHom a)).base s).asIdeal := by
    intro s k _ x hx
    rw [← RingHom.comap_ker, hx]
    rfl

  have hfib : ∀ {k : Type u} [Field k] (x : S →+* k),
      ∃ e : pullback f (Spec.map (CommRingCat.ofHom x)) ≅ pullback f₀ (Spec.map (CommRingCat.ofHom (x.comp a))),
        e.hom ≫ pullback.snd f₀ (Spec.map (CommRingCat.ofHom (x.comp a))) = pullback.snd f (Spec.map (CommRingCat.ofHom x)) := by
    intro k _ x
    have sq := (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom x))).paste_horiz hpb
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp] at sq
    exact ⟨sq.isoPullback, sq.isoPullback_hom_snd⟩

  have hEq : {s : ↥(Spec (CommRingCat.of S)) | ∀ (k : Type u) [Field k] [IsAlgClosed k] (x : S →+* k),
        RingHom.ker x = s.asIdeal →
        Nonempty (RelativeGroupLaw k (pullback.snd f (Spec.map (CommRingCat.ofHom x))))} =
      (Spec.map (CommRingCat.ofHom a)).base ⁻¹' {s₀ : ↥(Spec (CommRingCat.of ↥S₀)) | ∀ (k : Type u) [Field k] [IsAlgClosed k] (x₀ : ↥S₀ →+* k),
        RingHom.ker x₀ = s₀.asIdeal →
        Nonempty (RelativeGroupLaw k (pullback.snd f₀ (Spec.map (CommRingCat.ofHom x₀))))} := by
    ext s
    simp only [Set.mem_setOf_eq, Set.mem_preimage]
    constructor
    · intro hs k₀ _ _ x₀ hx₀

      let K : Type u := AlgebraicClosure s.asIdeal.ResidueField
      let x : S →+* K := (algebraMap s.asIdeal.ResidueField K).comp (algebraMap S s.asIdeal.ResidueField)
      have hx : RingHom.ker x = s.asIdeal := by
        rw [RingHom.ker_comp_of_injective _ (algebraMap s.asIdeal.ResidueField K).injective, Ideal.ker_algebraMap_residueField]
      obtain ⟨L⟩ := hs K x hx
      obtain ⟨e, he⟩ := hfib x
      obtain ⟨L', -, -⟩ := GoodReductionJacobian.RelativeGroupLaw.exists_relativeGroupLaw_mul_comp_hom_eq_of_iso e he L
      exact GoodReductionJacobian.nonempty_relativeGroupLaw_geometricFibre_of_nonempty_of_ker_eq f₀ hproj₀ _ K (x.comp a) (hker s x hx)
        k₀ x₀ hx₀ ⟨L'⟩
    · intro hs₀ k _ _ x hx
      obtain ⟨L₀⟩ := hs₀ k (x.comp a) (hker s x hx)
      obtain ⟨e, he⟩ := hfib x
      have he' : e.symm.hom ≫ pullback.snd f (Spec.map (CommRingCat.ofHom x)) = pullback.snd f₀ (Spec.map (CommRingCat.ofHom (x.comp a))) := by
        rw [Iso.symm_hom, ← he, Iso.inv_hom_id_assoc]
      obtain ⟨L, -, -⟩ := GoodReductionJacobian.RelativeGroupLaw.exists_relativeGroupLaw_mul_comp_hom_eq_of_iso e.symm he' L₀
      exact ⟨L⟩
  rw [hEq]
  exact hΛ₀.preimage (Spec.map (CommRingCat.ofHom a)).continuous

