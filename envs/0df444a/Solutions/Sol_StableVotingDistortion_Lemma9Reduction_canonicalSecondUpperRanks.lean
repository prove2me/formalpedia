noncomputable section

def quickSecondK (p q z : Bounds) :=
  (((quickTotalPrimitiveBox (secondX p q z)).minus (quickTotalPrimitiveBox z)).minus (quickTotalPrimitiveBox q))
def quickSecondA (q z : Bounds) :=
  ((q.plus z).plus (quickTotalScoreBox z)).minus (point lamQ)
def quickSecondP (p q z : Bounds) :=
  (((quickSecondA q z).times (quickTotalPrimitiveSlope p)).plus ((point massE).times (quickSecondK p q z))).minus
    (((point massE).times p).times (quickTotalPrimitiveSlope (secondX p q z)))
def quickSecondQ (p q z : Bounds) :=
  (quickTotalPrimitiveBox p).plus (((point massE).times p).times
    ((quickTotalPrimitiveSlope (secondX p q z)).minus (quickTotalPrimitiveSlope q)))
def quickSecondZ (p q z : Bounds) :=
  ((quickTotalPrimitiveBox p).times ((point 1).plus (totalScoreSlope z))).plus
    (((point massE).times p).times ((quickTotalPrimitiveSlope (secondX p q z)).minus (quickTotalPrimitiveSlope z)))
def quickSecondResidual (p q z : ℚ) : ℚ :=
  (q+z+quickTotalScore z-lamQ)*quickTotalJ p+massE*p*(quickTotalJ (z-p+q)-quickTotalJ z-quickTotalJ q)

def quickSecondRectTest (r : Box 3) : Bool :=
  let b := r 0
  let c := r 1
  let d := r 2
  let s := quickSecondP b c d
  let t := quickSecondQ b c d
  let v := quickSecondZ b c d
  decide (d.hi<b.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨
    quickSecondResidual (anchor b s) (anchor c t) (anchor d v)+deviation b s+deviation c t+deviation d v ≤ 0)

theorem quickSecondRectTest_eq : quickSecondRectTest=secondRectTest := by
  funext r
  apply Bool.eq_iff_iff.mpr
  simp only [quickSecondRectTest,secondRectTest,secondAccept,quickSecondResidual,qSecond,quickTotalScore_eq,quickTotalJ_eq,quickTotalScoreBox_eq,quickTotalPrimitiveBox_eq,quickTotalPrimitiveSlope_eq,
    quickSecondZ,secondZ,quickSecondQ,secondQ,quickSecondP,secondP,quickSecondA,secondA,quickSecondK,secondK,decide_eq_true_eq]
  exact decide_eq_true_iff.symm

end
end StableVotingDistortion.PaperCurve
