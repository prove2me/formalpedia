-- title:
--   (2.4)–(2.5) — G_ω for ω = (012)^∞ is the first Grigorchuk group, and its b, c, d are the generators of the shifts of ω as in (2.5)
-- statement:
--   Let $\omega = (\mathbf{012})^\infty$ (`firstString`). Then $G_\omega$ (`grigorchuk firstString`) is the published first Grigorchuk group `Garrido.GrigorchukGroup`, the subgroup of `Garrido.BinaryTreeAut` generated by $a$, $b = (a, c)$, $c = (a, d)$, $d = (1, b)$; and the generators $b, c, d$ (`Garrido.grigB`, `Garrido.grigC`, `Garrido.grigD`) are the general generators of p. 14 at $\omega$ and its shifts (`gen`, `shiftSeq`):
--   $$b = b_\omega = c_{\mathfrak s^2\omega} = d_{\mathfrak s\omega}, \qquad c = b_{\mathfrak s\omega} = c_\omega = d_{\mathfrak s^2\omega}, \qquad d = b_{\mathfrak s^2\omega} = c_{\mathfrak s\omega} = d_\omega .$$
--   All ten equalities are equalities of tree automorphisms or of subgroups of `Garrido.BinaryTreeAut`; they do not involve the direction of the action.
--
--   Erschler and Zheng, p. 15: “Usually, the recursion on the first Grigorchuk group $G_{012}$ is recorded as (2.4) $a = (id, id)\varepsilon,\ b = (a, c),\ c = (a, d),\ d = (id, b)$.” and p. 16: “Compared with the general notation for $G_\omega$, the following identification is made: $\omega = (\mathbf{012})^\infty$ and (2.5) $b = b_\omega = c_{\mathfrak s^2\omega} = d_{\mathfrak s\omega}$, $c = b_{\mathfrak s\omega} = c_\omega = d_{\mathfrak s^2\omega}$, $d = b_{\mathfrak s^2\omega} = c_{\mathfrak s\omega} = d_\omega$.”
-- source:
--   Erschler, A. and Zheng, T., Growth of periodic Grigorchuk groups, Invent. Math. 219 (2020) 1069–1155, https://doi.org/10.1007/s00222-019-00922-0 (arXiv:1802.09077v2, whose page numbers are used), pp. 14–16, (2.4)–(2.5)

import Mathlib
import Definitions.Def_ErschlerZheng_Grigorchuk

namespace ErschlerZheng

theorem grigorchuk_firstString_eq_grigorchukGroup_and_gen_eq :
    grigorchuk firstString = Garrido.GrigorchukGroup ∧
      (Garrido.grigB = gen firstString .b ∧ Garrido.grigB = gen (shiftSeq firstString 2) .c ∧
        Garrido.grigB = gen (shiftSeq firstString 1) .d) ∧
      (Garrido.grigC = gen (shiftSeq firstString 1) .b ∧ Garrido.grigC = gen firstString .c ∧
        Garrido.grigC = gen (shiftSeq firstString 2) .d) ∧
      (Garrido.grigD = gen (shiftSeq firstString 2) .b ∧ Garrido.grigD = gen (shiftSeq firstString 1) .c ∧
        Garrido.grigD = gen firstString .d) := by
  sorry

end ErschlerZheng
