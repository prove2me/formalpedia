    (hptrbase : s.natReg 96 = (pointerLayout B i.n (scaleCount i) reserve N).pointer)
    (hflagbase : s.natReg 98 = (pointerLayout B i.n (scaleCount i) reserve N).flags)
    (hlimit : s.natReg 212 = B+bankFactor j.val*(2*i.n+1)) :
