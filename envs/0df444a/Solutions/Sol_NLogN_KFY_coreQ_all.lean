  rw [chunkL_eq n m L hn hL] at hx
  simp only [List.mem_map, List.mem_range] at hx
  obtain ⟨i, hi, rfl⟩ := hx
  refine ⟨?_, fun z hz => List.mem_of_mem_drop (List.mem_of_mem_take hz)⟩
  simp only [List.length_take, List.length_drop, hL]
  have : n ≤ m * n - i * n := by
    have : (i + 1) * n ≤ m * n := Nat.mul_le_mul_right _ hi
    rw [Nat.succ_mul] at this; omega
  omega

theorem gints_flatten (X : List (List (ℤ × ℤ))) : gints X.flatten = X.flatMap gints := by
  induction X with
  | nil => rfl
