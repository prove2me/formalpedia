-- title:
--   Remark after Algorithm 1, p. 9 — either ρ_k → ∞, or ρ_k is eventually constant and ‖V^k‖ → 0
-- statement:
--   Let $(x^k,\hat\Lambda^k,\rho_k)_{k\in\mathbb N}$ be generated by Algorithm 1 (the augmented Lagrangian method) for (NCP), with $V^k$ as in (23). Then either
--   $$\rho_k\to\infty,$$
--   or there is $k_0\in\mathbb N$ such that $\rho_k=\rho_{k_0}$ for every $k>k_0$; in the latter case also $\|V^k\|\to0$.
--
--   This dichotomy organizes both convergence proofs into the case of an unbounded and of a bounded penalty parameter.
--
--   **Formalization Note** The two alternatives are joined by an inclusive "or"; the page's "$\rho^k\to\infty$" is the sequence $\rho_k$.
-- source:
--   Andreani, Gómez, Haeser, Mito & Ramos, On Optimality Conditions for Nonlinear Conic Programming, author's manuscript (revised 2021-04-20; Math. Oper. Res. doi:10.1287/moor.2021.1203), paragraph after Algorithm 1, p. 9

import Mathlib
import Definitions.Def_MoreauProx_Decomposition_Cones
import Definitions.Def_NCPSeqOpt_AugLag_Setting

namespace NCPSeqOpt.AugLag

open MoreauProx.Decomposition
open scoped InnerProductSpace
open Filter Topology

theorem step4_dichotomy {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (G : EuclideanSpace ℝ (Fin n) → E) (hG : ContDiff ℝ 1 G)
    (K : Set E) (hK : IsClosedConvexCone K)
    (ε : ℕ → ℝ) (B : Set E) (τ σ ρ₀ : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n))
    (Λhat : ℕ → E) (ρ : ℕ → ℝ) (hrun : IsALRun f G K ε B τ σ ρ₀ x Λhat ρ) :
    Tendsto ρ atTop atTop ∨
      ∃ k₀ : ℕ, (∀ k > k₀, ρ k = ρ k₀) ∧
        Tendsto (fun k => ‖Vk K G ρ x Λhat k‖) atTop (𝓝 0) := by sorry

end NCPSeqOpt.AugLag
