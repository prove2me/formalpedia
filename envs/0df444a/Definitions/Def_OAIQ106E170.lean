def phaseTransform (H : CMatrix) (u v : Coord → ℂ) : CMatrix :=
  fun i j => u i * H i j * v j

def dephase (H : CMatrix) : CMatrix :=
  phaseTransform H (fun i => (H i 0)⁻¹) (fun j => H 0 0 * (H 0 j)⁻¹)

end MUB6

