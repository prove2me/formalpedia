/-- An odd quarter-period forces the half-period product to be the half-period. -/
theorem p2m_local_odd_quarter_half_mul (m : ℕ) (hm : 0 < m) (hmod : m%4=2)
    (r : ZMod (2*m)) (hr : r+r=m) : (m : ZMod (2*m))*r=m := by
  letI : NeZero (2*m) := ⟨by omega⟩
  have he : (2*r.val)%(2*m)=m := by
    have hh := congrArg ZMod.val hr
    simp only [ZMod.val_add,ZMod.val_natCast] at hh
    rw [Nat.mod_eq_of_lt (show m<2*m by omega)] at hh
    simpa only [two_mul] using hh
  have hb := ZMod.val_lt r
  have hv : 2*r.val=m ∨ 2*r.val=3*m := by
    by_cases hlt : 2*r.val<2*m
    · rw [Nat.mod_eq_of_lt hlt] at he
      exact Or.inl he
    · have hs : 2*r.val%(2*m)=(2*r.val-2*m)%(2*m) := Nat.mod_eq_sub_mod (by omega)
      rw [hs,Nat.mod_eq_of_lt (by omega)] at he
      right
      omega
  have hodd : r.val%2=1 := by rcases hv with h|h <;> omega
  obtain ⟨k,hk⟩ : ∃ k : ℕ, r.val=2*k+1 := ⟨r.val/2,by omega⟩
  rw [← ZMod.natCast_zmod_val r,hk]
  push_cast
  have hh := Couret.InterIA.L4.half_add_half m
  calc (m : ZMod (2*m))*(2*(k : ZMod (2*m))+1)=(m+m)*k+m := by ring
       _=m := by rw [hh,zero_mul,zero_add]



end Couret.InterIA.Catalogue.Lifts

