lemma abs_sub_rnd_le (x : ℝ) : |x - rnd x| ≤ 1 / 2 := by
  unfold rnd
  have h1 := Int.floor_le (x + 1 / 2)
  have h2 := Int.lt_floor_add_one (x + 1 / 2)
  rw [abs_le]; constructor <;> linarith

