  have Q := Sp.pop (s := sB) (f := Function.update (Function.update g1 X l) Y (L.reverse ++ g1 Y))
    (i := NLogN.KFV.vT) (a := ((M : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp [hg1, Function.update_of_ne hXT.symm, Function.update_of_ne hYT.symm])
    (zsz_nat_lt hMB)
  have e : Function.update (Function.update (Function.update g1 X l) Y (L.reverse ++ g1 Y)) NLogN.KFV.vT [] =
      Function.update (Function.update g X l) Y (L.reverse ++ g Y) := by
