namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx IntMul.Kappa.R6.IL IntMul.Kappa.R6.IL3

theorem rowUCCP_of_rowUCP' {m : ℕ} {τ : ℝ} {tab : Fin 1 → IStmt HS 1}
    (h : IL2C.RowUCP' m τ tab) : RowUCCP m τ tab := h

/-- **`p14UH'` from a Lemma 12 table with a canonical code** (configuration with
`16 ≤ m ≤ 10⁶`, `0 ≤ τ ≤ θ ≤ lamp ≤ 1`, and the moment condition `hCc`). -/
theorem p14UH'_of_l12 (c : Cfg) (hc : CfgOK c) {τ θ Cc lamp : ℝ} (hτ0 : 0 ≤ τ) (hτθ : τ ≤ θ)
    (hθl : θ ≤ lamp) (hl1 : lamp ≤ 1) (hCc0 : 0 ≤ Cc)
    (hCc : ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) + 18 * c.Wr * c.net.length * 2 ^ τ +
      C1H c ≤ Cc * ((c.W : ℝ) - momH c θ))
    (hm : 16 ≤ c.m) (hm' : c.m ≤ 1000000)
    {tab : Fin 1 → IStmt HS 1} {l12} (hL : IL.L12Canon tab l12 τ) :
    P14UH' tab (EwH c) lamp :=
  p14UH'_of c hc hτ0 hτθ hθl hl1 hCc0 hCc tab
    (rowUCCP_of_rowUCP' (IL2C.rowUCP'_of hm hm' hτ0 (by linarith) hL))

/-- **The guard is polynomial**: `EwH c D ≤ C · D^e` for `D ≥ 1` whenever `c.p ≤ e`
(so `EwOK6 P (EwH c)` holds once `c.p ≤ P.C1`). -/
theorem EwH_poly (c : Cfg) (hc : CfgOK c) {e : ℕ} (he : c.p ≤ e) (D : ℕ) (hD : 1 ≤ D) :
    EwH c D ≤ ((c.Wr + 4) * (1 + c.Aw * 2 ^ c.p) + 4) * D ^ e := by
  have hp := hc.p1
  have h1 : D ≤ D ^ c.p := Nat.le_self_pow (by omega) D
  have h2 : (D + 1) ^ c.p ≤ 2 ^ c.p * D ^ c.p := by
    rw [← Nat.mul_pow]; exact Nat.pow_le_pow_left (by omega) _
  have h3 : D ^ c.p ≤ D ^ e := Nat.pow_le_pow_right hD he
  have hG : c.G D ≤ c.Aw * (D + 1) ^ c.p := Gs_le_pow hc.Aw1 hc.p1
  have h4 : c.Aw * (D + 1) ^ c.p ≤ c.Aw * (2 ^ c.p * D ^ c.p) := Nat.mul_le_mul_left _ h2
  have hA : D + c.G D ≤ (1 + c.Aw * 2 ^ c.p) * D ^ c.p := by
    have : (1 + c.Aw * 2 ^ c.p) * D ^ c.p = D ^ c.p + c.Aw * (2 ^ c.p * D ^ c.p) := by ring
    omega
  have hB : (c.Wr + 4) * (D + c.G D) ≤ (c.Wr + 4) * ((1 + c.Aw * 2 ^ c.p) * D ^ c.p) :=
    Nat.mul_le_mul_left _ hA
  have hX : 1 ≤ D ^ c.p := Nat.one_le_pow _ _ hD
  unfold EwH
  calc (c.Wr + 4) * (D + c.G D) + 4 ≤ ((c.Wr + 4) * (1 + c.Aw * 2 ^ c.p) + 4) * D ^ c.p := by
        have : ((c.Wr + 4) * (1 + c.Aw * 2 ^ c.p) + 4) * D ^ c.p =
          (c.Wr + 4) * ((1 + c.Aw * 2 ^ c.p) * D ^ c.p) + 4 * D ^ c.p := by ring
        omega
    _ ≤ _ := Nat.mul_le_mul_left _ h3

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.RG_IL3CfgG
/-!
# The configuration of a complex network, parametric in `(Wc, mc, hc)`

The round-six `R6IL3Cfg6` with Jain's histogram facts replaced by hypotheses: every child width
`w` of `hc` satisfies `1 ≤ w ≤ wmax ≤ mc`, and the width moment satisfies
`2 · (Σ n_w) · (2 wmax + 1)^e ≤ (2 mc)^e` for every `e ≥ p₀`, with `p₀` below the crude depth
guard `2 + mc · log(histRankSum hc)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx IntMul.Kappa.R6.IL IntMul.Kappa.R6.IL3

/-- Moment monotonicity in the exponent for widths in `[1, m]`. -/
theorem histG_mom_mono (m : ℕ) (hm : 0 < m) {σ θ : ℝ} (hσθ : σ ≤ θ) :
    ∀ h : List (ℕ × ℕ), (∀ p ∈ h, 1 ≤ p.1 ∧ p.1 ≤ m) →
      (h.map fun p => p.2 • (((p.1 : ℕ) : ℝ) / (m : ℝ)) ^ θ).sum ≤ histMoment h m σ
  | [], _ => by simp [histMoment]
  | q :: h, hb => by
    have ih := histG_mom_mono m hm hσθ h (fun p hp => hb p (List.mem_cons_of_mem _ hp))
    unfold histMoment at ih ⊢
    simp only [List.map_cons, List.sum_cons, nsmul_eq_mul]
    simp only [nsmul_eq_mul] at ih
    obtain ⟨h1, h2⟩ := hb q List.mem_cons_self
    have hmR : (0 : ℝ) < m := by exact_mod_cast hm
    have hx0 : (0 : ℝ) < (q.1 : ℝ) / m := div_pos (by exact_mod_cast h1) hmR
    have hx1 : (q.1 : ℝ) / m ≤ 1 := (div_le_one hmR).2 (by exact_mod_cast h2)
    have a : ((q.1 : ℝ) / m) ^ θ ≤ ((q.1 : ℝ) / m) ^ σ :=
      Real.rpow_le_rpow_of_exponent_ge hx0 hx1 hσθ
    have b := mul_le_mul_of_nonneg_left a (Nat.cast_nonneg (α := ℝ) q.2)
    linarith

/-- The width moment in `ℕ`, widths at most `wmax`. -/
theorem histG_pow_le (wmax e : ℕ) :
    ∀ h : List (ℕ × ℕ), (∀ p ∈ h, p.1 ≤ wmax) →
      (h.map fun p => p.2 • (2 * p.1 + 1) ^ e).sum ≤ (h.map Prod.snd).sum * (2 * wmax + 1) ^ e
  | [], _ => by simp
  | q :: h, hb => by
    have ih := histG_pow_le wmax e h (fun p hp => hb p (List.mem_cons_of_mem _ hp))
    simp only [List.map_cons, List.sum_cons, smul_eq_mul, add_mul]
    have h2 := hb q List.mem_cons_self
    have a : (2 * q.1 + 1) ^ e ≤ (2 * wmax + 1) ^ e := Nat.pow_le_pow_left (by omega) e
    have b := Nat.mul_le_mul_left q.2 a
    simp only [smul_eq_mul] at ih
    omega

/-- The depth guard gives `p₀ ≤ C1`. -/
theorem C1G_ge {mc p₀ : ℕ} {hc : List (ℕ × ℕ)}
    (hp₀ : (p₀ : ℝ) ≤ 2 + mc * Real.log (histRankSum hc)) (C1 : ℕ)
    (hC1 : 2 + mc * Real.log (histRankSum hc) ≤ C1) : p₀ ≤ C1 := by
  have : (p₀ : ℝ) ≤ C1 := le_trans hp₀ hC1
  exact_mod_cast this

/-- The configuration before the scale constant. -/
noncomputable def cfg0G (Wc mc : ℕ) (hc : List (ℕ × ℕ)) (P : Prm) {T A : ℕ}
    (J : Prop8IfaceH Wc T mc hc) : Cfg :=
  ⟨Wc, T, mc, A, 0, P.C1, netF J⟩

/-- **The parametric configuration.** -/
noncomputable def cfgG (Wc mc : ℕ) (hc : List (ℕ × ℕ)) (P : Prm) {T : ℕ} (A : ℕ)
    (J : Prop8IfaceH Wc T mc hc) : Cfg :=
  ⟨Wc, T, mc, A,
    2 * cLH (cfg0G Wc mc hc P (A := A) J) + 1 + (netF J).length * dwloc (Wc + T) A +
      2 * (Wc + T) * (chWs (cfg0G Wc mc hc P (A := A) J)).length + 4, P.C1, netF J⟩

section CfgG

variable (Wc mc : ℕ) (hc : List (ℕ × ℕ)) (P : Prm) {T : ℕ} (A : ℕ) (J : Prop8IfaceH Wc T mc hc)

theorem cfgG_m : (cfgG Wc mc hc P A J).m = mc := rfl
theorem cfgG_W : (cfgG Wc mc hc P A J).W = Wc := rfl
theorem cfgG_p : (cfgG Wc mc hc P A J).p = P.C1 := rfl
theorem cfgG_cLH : cLH (cfgG Wc mc hc P A J) = cLH (cfg0G Wc mc hc P (A := A) J) := rfl
theorem cfgG_chWs : chWs (cfgG Wc mc hc P A J) = J.widths := netF_widths J

/-- `momH` of the configuration is the histogram moment-sum. -/
theorem cfgG_momH (θ : ℝ) :
    momH (cfgG Wc mc hc P A J) θ =
      (hc.map fun p => p.2 • (((p.1 : ℕ) : ℝ) / ((mc : ℕ) : ℝ)) ^ θ).sum := by
  unfold momH
  rw [cfgG_chWs, cfgG_m]
  exact J.sum_widths (fun s : ℕ => ((s : ℝ) / ((mc : ℕ) : ℝ)) ^ θ)

theorem cfgG_ok {wmax p₀ : ℕ} (hm1 : 1 ≤ mc) (hW1 : 1 ≤ Wc)
    (hb : ∀ p ∈ hc, 1 ≤ p.1 ∧ p.1 ≤ wmax)
    (hnum : ∀ e, p₀ ≤ e → 2 * ((hc.map Prod.snd).sum * (2 * wmax + 1) ^ e) ≤ (2 * mc) ^ e)
    (hp₀ : (p₀ : ℝ) ≤ 2 + mc * Real.log (histRankSum hc)) (hp1 : 1 ≤ p₀)
    (hG : GClassH J A)
    (hC1 : 2 + mc * Real.log (histRankSum hc) ≤ P.C1) : CfgOK (cfgG Wc mc hc P A J) := by
  have hpC := C1G_ge hp₀ P.C1 hC1
  refine ⟨⟨?_, ?_, ?_⟩, (by show 1 ≤ mc; exact hm1), (by show 1 ≤ Wc; exact hW1),
    ?_, ?_, ?_, ?_, ?_⟩
  · intro G hg
    rcases netF_gate hG hg with ⟨as, h1, h2, h3, h4⟩ | ⟨U, hU⟩
    · exact Or.inl ⟨as, h1, h2, h3, h4⟩
    · exact Or.inr ⟨U, hU⟩
  · intro w S neg h
    exact netF_child J h
  · intro κ _ _ v w' x y
    exact netF_data J κ v w' x y
  · show 1 ≤ 2 * cLH (cfg0G Wc mc hc P (A := A) J) + 1 + _ + _ + 4
    omega
  · show 1 ≤ P.C1
    omega
  · -- the moment of the child widths
    rw [cfgG_chWs, J.sum_widths (fun s => (2 * s + 1) ^ (cfgG Wc mc hc P A J).p), cfgG_p, cfgG_m]
    have a := histG_pow_le wmax P.C1 hc (fun p hp => (hb p hp).2)
    have b := hnum P.C1 hpC
    calc 2 * (hc.map fun p => p.2 • (2 * p.1 + 1) ^ P.C1).sum
        ≤ 2 * ((hc.map Prod.snd).sum * (2 * wmax + 1) ^ P.C1) := Nat.mul_le_mul_left 2 a
      _ ≤ (2 * mc) ^ P.C1 := b
  · rw [cfgG_cLH]
    show 2 * cLH (cfg0G Wc mc hc P (A := A) J) + 1 ≤
      2 * cLH (cfg0G Wc mc hc P (A := A) J) + 1 + _ + _ + 4
    omega
  · show (netF J).length * dwloc (Wc + T) A + 2 * (Wc + T) * (chWs (cfgG Wc mc hc P A J)).length + 4 ≤
      2 * (2 * cLH (cfg0G Wc mc hc P (A := A) J) + 1 + (netF J).length * dwloc (Wc + T) A +
        2 * (Wc + T) * (chWs (cfg0G Wc mc hc P (A := A) J)).length + 4)
    have : chWs (cfgG Wc mc hc P A J) = chWs (cfg0G Wc mc hc P (A := A) J) := rfl
    rw [this]
    omega

end CfgG

/-- `max τ σ ≤ lampOf τ σ`. -/
theorem maxG_le_lampOf (τ σ : ℝ) : max τ σ ≤ lampOf τ σ := by
  unfold lampOf
  have a := le_max_left (max τ σ) (τ + (1 - beta) * max (σ - τ) 0)
  have b := le_max_left (max (max τ σ) (τ + (1 - beta) * max (σ - τ) 0) + 1 / 10 ^ 16)
    (σ + beta * (1 - σ))
  have c : (0 : ℝ) ≤ 1 / 10 ^ 16 := by norm_num
  linarith

/-- **The parametric configuration** of a complex network in the gate class. -/
theorem cfgG_of (Wc mc : ℕ) (hc : List (ℕ × ℕ)) {wmax p₀ : ℕ} (hm1 : 1 ≤ mc) (hW1 : 1 ≤ Wc)
    (hwm : wmax ≤ mc) (hb : ∀ p ∈ hc, 1 ≤ p.1 ∧ p.1 ≤ wmax)
    (hnum : ∀ e, p₀ ≤ e → 2 * ((hc.map Prod.snd).sum * (2 * wmax + 1) ^ e) ≤ (2 * mc) ^ e)
    (hp₀ : (p₀ : ℝ) ≤ 2 + mc * Real.log (histRankSum hc)) (hp1 : 1 ≤ p₀)
    (P : Prm) (hP : P.Ok) {T A : ℕ} (J : Prop8IfaceH Wc T mc hc)
    (hG : GClassH J A) (hmom : histMoment hc mc P.σ < Wc)
    (hC1 : 2 + mc * Real.log (histRankSum hc) ≤ P.C1) :
    ∃ (c : Cfg) (Cc : ℝ), c.m = mc ∧ CfgOK c ∧ 0 ≤ Cc ∧ P.τ ≤ max P.τ P.σ ∧
      max P.τ P.σ ≤ P.lamp ∧
      ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) + 18 * c.Wr * c.net.length * 2 ^ P.τ +
        C1H c ≤ Cc * ((c.W : ℝ) - momH c (max P.τ P.σ)) ∧
      c.p ≤ P.C1 := by
  set c := cfgG Wc mc hc P A J with hcd
  set θ := max P.τ P.σ with hθ
  have hc' : CfgOK c := cfgG_ok Wc mc hc P A J hm1 hW1 hb hnum hp₀ hp1 hG hC1
  have hmono : momH c θ ≤ histMoment hc mc P.σ := by
    rw [hcd, cfgG_momH]
    exact histG_mom_mono mc (by omega) (le_max_right _ _) hc
      (fun p hp => ⟨(hb p hp).1, le_trans (hb p hp).2 hwm⟩)
  have hg : 0 < (c.W : ℝ) - momH c θ := by
    have : (c.W : ℝ) = (Wc : ℝ) := by rw [hcd, cfgG_W]
    rw [this]; linarith
  have hm6 : c.m = mc := rfl
  have hp6 : c.p ≤ P.C1 := le_rfl
  clear_value c
  set L : ℝ := ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) +
    18 * c.Wr * c.net.length * 2 ^ P.τ + C1H c with hL
  have hL0 : 0 ≤ L := by
    have a : (0 : ℝ) ≤ ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) :=
      mul_nonneg (Nat.cast_nonneg _) (by positivity)
    have b : (0 : ℝ) ≤ 18 * c.Wr * c.net.length * (2 : ℝ) ^ P.τ :=
      mul_nonneg (by positivity) (Real.rpow_nonneg (by norm_num) _)
    have d : (0 : ℝ) ≤ C1H c := by
      unfold C1H
      exact mul_nonneg (Nat.cast_nonneg _) (add_nonneg (add_nonneg (mul_nonneg (Nat.cast_nonneg _)
        (Nat.cast_nonneg _)) (Nat.cast_nonneg _)) (by norm_num))
    rw [hL]; linarith
  refine ⟨c, L / ((c.W : ℝ) - momH c θ), hm6, hc', div_nonneg hL0 hg.le, le_max_left _ _,
    le_trans (maxG_le_lampOf _ _) hP.lampOf_le, ?_, hp6⟩
  rw [div_mul_cancel₀ L hg.ne']

/-- **`P14NeedG` holds** at every admissible parameter record, for any complex histogram meeting
the width and moment side conditions. -/
theorem p14NeedG_all_sol_aux (Wc mc wmax p₀ : ℕ) (hc : List (ℕ × ℕ))
    (hm16 : 16 ≤ mc) (hm' : mc ≤ 1000000) (hW1 : 1 ≤ Wc) (hwm : wmax ≤ mc)
    (hb : ∀ p ∈ hc, 1 ≤ p.1 ∧ p.1 ≤ wmax)
    (hnum : ∀ e, p₀ ≤ e → 2 * ((hc.map Prod.snd).sum * (2 * wmax + 1) ^ e) ≤ (2 * mc) ^ e)
    (hp₀ : (p₀ : ℝ) ≤ 2 + mc * Real.log (histRankSum hc)) (hp1 : 1 ≤ p₀)
    (P : Prm) (hP : P.Ok) : P14NeedG Wc mc hc P := by
  intro tab l12 hL T J A hG hmom hC1
