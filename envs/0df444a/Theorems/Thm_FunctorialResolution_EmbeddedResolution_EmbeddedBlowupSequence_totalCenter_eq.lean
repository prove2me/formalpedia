variable {k : Type u} [Field k] [CharZero k] {Y : Scheme.{u}} [AlgebraicGeometry.IsAffine Y]
  {pY : Y ⟶ Spec (CommRingCat.of k)} [AlgebraicGeometry.LocallyOfFiniteType pY]
variable (T : EmbeddedBlowupSequence k Y pY)

theorem FunctorialResolution.EmbeddedResolution.EmbeddedBlowupSequence.totalCenter_eq (i : ℕ) :
    T.totalCenter i =
      Scheme.Hom.ker
        ((T.centerOffDetached i).subschemeι ≫
          (coprod.inl : T.strictTransform i ⟶ T.totalSpace i)) := by sorry
