  rw [AutomorphicForm.HeckeEigensystem.twist_a, AutomorphicForm.HeckeEigensystem.twist_b,
    AutomorphicForm.HeckeEigensystem.map_a, AutomorphicForm.HeckeEigensystem.map_b]
