-- title:
--   Appendix G, Step 1, p. 39 — g^z(s, X^{z,π*}_s, β^z_s) is a martingale (from every start)
-- statement:
--   Assume the hypotheses of Theorem 5.5. Let $z\in\mathbb R$ and $(t_0,x,\beta)\in[0,T]\times\mathbb R^2$, and let $X^{z,\pi^*}$ be the wealth of $\pi^*$ started at $X_{t_0}=x$, $\beta^z_{t_0}=\beta$. Then
--   $$\big\{g^z(s,X^{z,\pi^*}_s,\beta^z_s)\big\}_{s\in[t_0,T]}$$
--   is a martingale with respect to the filtration $\{\mathcal F^W_s\}$ generated by the Brownian increments after $t_0$.
--
--   This is condition (b) of the verification Theorem 4.5; with (5.15) it identifies $g^z$ with the inside expected utility of $\pi^*$.
--
--   **Formalization Note** The paper states the martingale property on $[0,T]$ from the initial state; Appendix B uses it through the Markov property at every start, so it is stated from every start $(t_0,x,\beta)$ (paper.md slip 9). The martingale property is written as integrability, adaptedness and $\int_AY_{s'}=\int_AY_s$ for events $A$ of the filtration at time $s$.
-- source:
--   Guan, Liang, Xia, Equilibrium Portfolio Selection for Smooth Ambiguity Preferences, arXiv:2302.08181v1, p. 39, Appendix G, Step 1

import Mathlib
import Definitions.Def_SmoothAmbEq_Gaussian_Model
import Definitions.Def_SmoothAmbEq_Gaussian_InsideSystem
import Definitions.Def_SmoothAmbEq_Gaussian_Candidate

open MeasureTheory ProbabilityTheory Set Filter
open scoped NNReal ENNReal Topology

namespace SmoothAmbEq.Gaussian

/-- Appendix G, Step 1, p. 39, from every start (paper.md, slip 9). Under the hypotheses of
Theorem 5.5, for every `z ∈ ℝ` and every start `(t₀, x, β) ∈ [0, T] × ℝ²`, if `X` is the wealth
of `π*` started at `(t₀, x, β)`, then `{g^z(s, X_s, β^z_s)}_{s ∈ [t₀, T]}` is a martingale with
respect to the natural filtration of the Brownian increments after `t₀`. -/
theorem step_1_martingale (M : Model) (a : ℝ) (ha : IsAlphaStar M a)
    (hα : max a (1 - 1 / 2 * (M.σ ^ 2 / (M.σ₀ ^ 2 * M.T))) < M.α) (c : Coeffs)
    (hc : SolvesODE510 M c) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (W : ℝ≥0 → Ω → ℝ) (hW : IsBrownianReal W P)
    (z t₀ x β : ℝ) (ht₀ : t₀ ∈ Icc 0 M.T) (X : ℝ → Ω → ℝ)
    (hX : IsInsideWealth M P W (piStar M c) z t₀ x β X) :
    IsMartingaleOn P (shiftFiltration W t₀)
      (fun s ω => gz M c z s (X s ω) (betaZ M W z t₀ β s ω)) t₀ M.T := by sorry

end SmoothAmbEq.Gaussian
