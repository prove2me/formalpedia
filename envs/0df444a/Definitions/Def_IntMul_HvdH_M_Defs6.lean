-- Source module: NLogN.HGl3
/-!
# Gaussian list primitives, part 3: moves, transfers, the zip product program

* `mv_all`: `mvList` as an `RM` step (run / ok / cost in one statement).
* `xferP i j n`: move `n` integers from `i` to `j` keeping their order (via `gZT`).
* `zipP σ cN`: `gD := zipWith (gzF σ p) A U` (`A` consumed from `gZA`), `cN ∈ {gPN, gPM}` holds
  the length.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.GL

open IntMul NLogN

/-- Order-preserving transfer through `gZT`. -/
def xferP (i j : Fin HS) (n : Ex HS) : RM :=
  .seq (.rs (mvList i gZT gCV n)) (.rs (mvList gZT j gCV n))

/-! ## Count expressions -/

def cnt2 (cN : Fin HS) : Ex HS := .add (.reg cN) (.reg cN)

/-- Count stacks are `gPN` or `gPM`. -/
def IsCnt (cN : Fin HS) : Prop := cN = gPN ∨ cN = gPM

/-! ## The zip product program -/

def zipP (σ : Sg) (cN : Fin HS) : RM :=
  .seq (.rep gC1 (.reg cN) (zipBody σ)) (.rs (mvList gZB gD gCV (cnt2 cN)))

end NLogN.GL

end

