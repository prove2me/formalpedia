theorem zsz_cN6 {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1) (x y m : ℕ) (hm : m < Q.S) :
    zsz (cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m : ℤ) ≤ Q.p + 2 := by
  have h1 := cN_le Q.b Q.M x y m
  have h2 := hQ.S_lt_b hD
  have hpb : Q.p = 6 * Q.b := Q.p_eq
  apply KFL.zsz_le_of_abs
  rw [abs_of_nonneg (by positivity)]
  have : cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m < 2 ^ (Q.p + 2) := by
    calc cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m
        ≤ (m + 1) * (2 ^ Q.b * 2 ^ Q.b) := h1
      _ ≤ 2 ^ Q.b * (2 ^ Q.b * 2 ^ Q.b) := Nat.mul_le_mul_right _ (by omega)
      _ = 2 ^ (3 * Q.b) := by ring
      _ < 2 ^ (Q.p + 2) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  exact_mod_cast this

variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

theorem BigCtx6.prodNe (C : BigCtx6 ix Isym tab extM Q D) : NeZero (∏ i, Q.sB D i) :=
  ⟨Finset.prod_ne_zero_iff.2 fun i _ => (instS i).out⟩

theorem BigCtx6.prodNe' (C : BigCtx6 ix Isym tab extM Q D) :
    NeZero (∏ i, sBox (D + 1) Q.src i) :=
  C.prodNe

/-- **The convolution of the digits.** -/
theorem cconv_ubar6 (C : BigCtx6 ix Isym tab extM Q D) (x y m : ℕ) (hm : m < Q.S) :
    haveI := C.prodNe
    cconv (Q.sB D) (ubar6 C x) (ubar6 C y)
      (eB Q.src Q.mu C.H (m : ZMod (∏ i, sBox (D + 1) Q.src i))) =
      (cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m : ℂ) := by
  haveI := C.prodNe
  have hMP : 2 * Q.M ≤ ∏ i, Q.sB D i := by rw [← C.hS]; exact C.hQ.hMS
  have hm' : m < ∏ i, Q.sB D i := by rw [← C.hS]; exact hm
  exact cconv_digits (Q.sB D) (sBox_cop Q.src Q.mu C.H) (fun i => Q.mu i)
    (sBox_mu Q.src Q.mu C.H) (dgt Q.b Q.M x) (dgt Q.b Q.M y) Q.M
    (fun i hi => dgt_zero _ _ _ _ hi) (fun j hj => dgt_zero _ _ _ _ hj) hMP hm'

/-- **The rounded value at one point.** -/
theorem pt_val6 (C : BigCtx6 ix Isym tab extM Q D) (x y : ℕ) (zsZ : List GI)
    (Z : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ)
    (hZ : RepPad Q.p (Q.sB D) (Q.tB D) zsZ Z) (hcl : Close6 C x y Z)
    (k : (i : Fin (D + 1)) → ZMod (Q.sB D i)) :
    rndV Q.p Q.b Q.S (zsZ.getD (encode (List.ofFn (Q.tB D)) (kL k)) 0).1 =
        cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) ((eB Q.src Q.mu C.H).symm k).val ∧
      rndV Q.p Q.b Q.S (-(zsZ.getD (encode (List.ofFn (Q.tB D)) (kL k)) 0).2) = 0 := by
  haveI := C.prodNe
  haveI := C.prodNe'
  set z := zsZ.getD (encode (List.ofFn (Q.tB D)) (kL k)) 0 with hz
  set m := ((eB Q.src Q.mu C.H).symm k).val with hm
  have hmS : m < Q.S := by rw [C.hS]; exact ZMod.val_lt _
  have hk : eB Q.src Q.mu C.H (m : ZMod (∏ i, sBox (D + 1) Q.src i)) = k := by
    rw [hm, ZMod.natCast_zmod_val]; exact (eB Q.src Q.mu C.H).apply_symm_apply k
  have hc : cconv (Q.sB D) (ubar6 C x) (ubar6 C y) k =
      (cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m : ℂ) := by
    have := cconv_ubar6 C x y m hmS
    rw [hk] at this
    exact this
  have h1 := hcl k
  have eS : (((∏ i, (Q.sB D i : ℝ)) : ℝ) : ℂ) = ((Q.S : ℕ) : ℂ) := by
    rw [C.hS]; push_cast; rfl
  have eZ : cnj Z k = starRingEnd ℂ (toC z / 2 ^ Q.p) := by
    rw [RepPad.eq C.hst hZ]; rfl
  rw [eS, eZ, hc] at h1
  exact round_pt Q.p Q.b Q.S C.hQ.hp1 z _ h1

theorem zsWf6_getD (hQ : QOk Q) (zsZ : List GI) (x : ℕ) :
    (zsWf6 Q zsZ).getD x 0 = (rndV Q.p Q.b Q.S (zsZ.getD x 0).1,
      rndV Q.p Q.b Q.S (-(zsZ.getD x 0).2)) := by
  have hp := hQ.hp1
  have g0 : (fun z : GI => (rndV Q.p Q.b Q.S z.1, rndV Q.p Q.b Q.S z.2)) 0 = 0 := by
    simp only [Prod.fst_zero, Prod.snd_zero, gR_zero _ _ _ hp]; rfl
  rw [zsWf6, getD_map0 _ g0, getD_map0 gconj rfl]
  rfl

/-- **All rounded numerators are small.** -/
theorem zsW_GB6 (C : BigCtx6 ix Isym tab extM Q D) (x y : ℕ) (zsZ : List GI)
    (Z : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ)
    (hZ : RepPad Q.p (Q.sB D) (Q.tB D) zsZ Z) (hcl : Close6 C x y Z) :
    GB (Q.p + 2) (zsWf6 Q zsZ) := by
  have hp := C.hQ.hp1
  intro w hw
  obtain ⟨xi, hxi, rfl⟩ := List.getElem_of_mem hw
  have hlen : (zsWf6 Q zsZ).length = zsZ.length := by simp [zsWf6]
  have hxi' : xi < zsZ.length := hlen ▸ hxi
  have hx' : xi < (List.ofFn (Q.tB D)).prod := hZ.1 ▸ hxi'
  rw [← List.getD_eq_getElem _ 0 hxi, zsWf6_getD C.hQ]
  by_cases hs : ∀ i, boxIx (Q.tB D) xi i < Q.sB D i
  · set k : (i : Fin (D + 1)) → ZMod (Q.sB D i) :=
      fun i => ((boxIx (Q.tB D) xi i : ℕ) : ZMod (Q.sB D i)) with hk
    have he : encode (List.ofFn (Q.tB D)) (kL k) = xi := by
      rw [hk, kL_cast _ hs, encode_boxIx _ hx']
    obtain ⟨v1, v2⟩ := pt_val6 C x y zsZ Z hZ hcl k
    rw [he] at v1 v2
    rw [v1, v2]
    haveI := C.prodNe
    haveI := C.prodNe'
    have hmS : ((eB Q.src Q.mu C.H).symm k).val < Q.S := by
      rw [C.hS]; exact ZMod.val_lt _
    exact ⟨zsz_cN6 C.hQ C.hD x y _ hmS, by rw [zsz_zero]; omega⟩
  · have e := (hZ.2 xi hx').2 hs
    rw [e]
    simp only [Prod.fst_zero, Prod.snd_zero, neg_zero, gR_zero _ _ _ hp, zsz_zero]
    omega

set_option maxHeartbeats 8000000 in
/-- **The read-out.** -/
theorem fin_phase6_sol_aux (C : BigCtx6 ix Isym tab extM Q D) (t : IState HS) (hR : Q.Base t) (x y : ℕ)
    (hx : x < 2 ^ Q.n) (hy : y < 2 ^ Q.n) (zsZ : List GI)
    (Z : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ)
    (h0 : t.G 0 = ints (gflat zsZ)) (hZ : RepPad Q.p (Q.sB D) (Q.tB D) zsZ Z)
    (hg : GB (wU6 Q D) zsZ) (hcl : Close6 C x y Z) (hout : t.out = []) :
    ∃ s' c, IRuns Isym (IL.kTableP tab extM) (finP6 ix) t s' c ∧
      s'.out = bin (2 * Q.n) (x * y) ∧ (c : ℝ) ≤ kFin6 C := by
  have hQ := C.hQ
  have hD := C.hD
  have hD' : dP6 Q.P Q.n = D + 1 := hD
  have hb : 64 ≤ Q.b := hQ.hb
  -- the rounding passes
  have hl := len_T6 hQ hD hZ.1
  have r1 := finA_runs6 (I := Isym) (tab := tab) (extM := extM) hQ hD t hR zsZ hl h0 hg
  change IRuns _ _ _ t (t.upd 0 (ints (gflat (zsWf6 Q zsZ)))) _ at r1
  have hWg := zsW_GB6 C x y zsZ Z hZ hcl
  set W := zsWf6 Q zsZ with hW
  set t1 := t.upd 0 (ints (gflat W)) with ht1
  have hR1 : Q.Base t1 := BaseOK6.upd hR 0 (by decide) _
  -- `Φ⁻¹`
  have hWl : W.length = (List.ofFn (Q.tB D)).prod := by simp [hW, zsWf6, hZ.1]
  have eT : ∏ i : Fin (D + 1), KFU.tP (D + 1) Q.h Q.bL i = ∏ i, Q.tB D i :=
    Finset.prod_congr rfl fun i _ => congrFun (hQ.tBox_eq6 hD) i
  have hlen : (gflat W).length = vol (KFU.shR Q.d (KFU.tP Q.d Q.h Q.bL)) := by
    rw [length_gflat, hWl, vol_shR, tP_last, show Q.d = D + 1 from hD,
      ← Fin.prod_univ_eq_prod_range (fun j => KFU.tP (D + 1) Q.h Q.bL j) (D + 1), eT,
      List.prod_ofFn]
    ring
  obtain ⟨c2, r2, hc2⟩ := (phi_phase6 C.hp₂ hQ C.hdΦ C.hΦ C.BΦ C.hBΦ t1 hR1 (gflat W) []
    (by simp [t1]) (KFL.zsz_gflat hWg)).2 hlen
  rw [ht1, IState.upd_upd_same, List.append_nil] at r2
  set Y := KFU.PhiInvD Q.h Q.d Q.bL Q.src Q.mu (gflat W) with hY
  have hYl : Y.length = 2 * Q.S := by
    rw [hY, length_PhiInvD, vol_shK, C.hS, show Q.d = D + 1 from hD,
      ← Fin.prod_univ_eq_prod_range]; rfl
  obtain ⟨cs, hcs⟩ := exists_gflat Y (by rw [hYl]; exact even_two_mul _)
  have hcsl : cs.length = Q.S := by
    have := congrArg List.length hcs; rw [length_gflat, hYl] at this; omega
  -- the values
  have hval : ∀ m < Q.S, cs.getD m 0 =
      (((cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m : ℕ) : ℤ), (0 : ℤ)) := by
    intro m hm
    haveI := sBox_ne Q.src Q.mu C.H
    haveI := C.prodNe
    haveI := C.prodNe'
    have hmS : m < ∏ i, Q.sB D i := by rw [← C.hS]; exact hm
    have hmP : m < OpenAI.RCRT.Ppre Q.src (D + 1) := by rw [← KFU.Ppre_eq_prod]; exact hmS
    have hY' : Y = KFU.PhiInvD Q.h (D + 1) Q.bL Q.src Q.mu (gflat W) := by
      rw [hY, show Q.d = D + 1 from hD]
    have a0 := phiInvD_read Q.h Q.bL Q.src Q.mu C.H (hsw_of6 hQ hD) W (c := 0) hmP (by norm_num)
    have a1 := phiInvD_read Q.h Q.bL Q.src Q.mu C.H (hsw_of6 hQ hD) W (c := 1) hmP (by norm_num)
    simp only [if_pos rfl, if_neg one_ne_zero, add_zero] at a0 a1
    rw [hQ.tBox_eq6 hD, hW, zsWf6_getD hQ] at a0 a1
    set k : (i : Fin (D + 1)) → ZMod (Q.sB D i) :=
      eB Q.src Q.mu C.H (m : ZMod (∏ i, sBox (D + 1) Q.src i)) with hk
    obtain ⟨v1, v2⟩ := pt_val6 C x y zsZ Z hZ hcl k
    have hsym : ((eB Q.src Q.mu C.H).symm k).val = m := by
      rw [hk, AddEquiv.symm_apply_apply]; exact ZMod.val_cast_of_lt hmS
    rw [getD_of_gflat hcs, hY']
    refine Prod.ext ?_ ?_
    · exact a0.trans (v1.trans (by rw [hsym]))
    · exact a1.trans v2
  have hmem : ∀ z ∈ cs, ∃ m < Q.S,
      z = (((cN (dgt Q.b Q.M x) (dgt Q.b Q.M y) m : ℕ) : ℤ), (0 : ℤ)) := by
    intro z hz
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
    refine ⟨i, hcsl ▸ hi, ?_⟩
    rw [← List.getD_eq_getElem _ 0 hi, hval i (hcsl ▸ hi)]
  have hre : ∀ z ∈ cs, 0 ≤ z.1 := fun z hz => by
    obtain ⟨m, -, rfl⟩ := hmem z hz; simp
  have hBc : GB (Q.p + 2) cs := fun z hz => by
    obtain ⟨m, hm, rfl⟩ := hmem z hz
    exact ⟨zsz_cN6 hQ hD x y m hm, by simp [zsz_zero]⟩
  -- carries
  set t2 := t.upd 0 (ints Y) with ht2
  have hR2 : Q.Base t2 := BaseOK6.upd hR 0 (by decide) _
  have hxy : carOut Q.b cs = x * y :=
    carOut_xy Q.b Q.M Q.S x y cs hcsl hQ.hMS
      (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) hQ.le_bM))
      (lt_of_lt_of_le hy (Nat.pow_le_pow_right (by norm_num) hQ.le_bM)) hval
  have r3 : IRuns Isym (IL.kTableP tab extM) carW t2 (t2.upd 0 [.int ((x * y : ℕ) : ℤ)])
      (cCarU Q.b (Q.p + 2) cs.length + cW (Q.S : ℤ) + cW (2 ^ Q.b)) := by
    refine withD_runs (by decide) (by decide) hR2.hB2 ?_
    refine withD_runs (by decide) (by decide) (hR2.hS.upd uB2 (by decide) _) ?_
    rw [← hxy]
    refine carIU_spec Q.b (Q.p + 2) (by omega) cs hre hBc _ [] (t2.G uB2) (t2.G uM) ?_ ?_ ?_
    · simp +decide [IState.upd_G, t2, hcs]
    · simp +decide [IState.upd_G]
    · simp +decide [IState.upd_G, hcsl]
  -- write
  obtain ⟨LW, hLW⟩ := hR2.hO
  have hv : x * y < 2 ^ (2 * Q.n) := by
    rw [two_mul, pow_add]; exact Nat.mul_lt_mul'' hx hy
  have r4 := writeI_spec (I := Isym) (iprog := IL.kTableP tab extM) (A := 0) (W := KFM.rO)
    (by decide) (t2.upd 0 [.int ((x * y : ℕ) : ℤ)]) (x * y) (2 * Q.n) hv [] LW (by simp)
    (by simp +decide [IState.upd_G, hLW])
  refine ⟨_, _, r1.seq (r2.seq (r3.seq r4)), ?_, ?_⟩
  · simp [t2, hout]
  · rw [hcsl]
    unfold kFin6
    push_cast
    linarith

/-! ## One run -/

end

