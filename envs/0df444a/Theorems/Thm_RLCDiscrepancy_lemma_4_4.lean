-- title:
--   Lemma 4.4 — second-moment bound for $\delta_{C,f}$
-- statement:
--   Let $m\le n$, let $f:\mathbb F_q^n\to\mathbb R_{\ge0}$ be normalized, and let $C=\{Gv:v\in\mathbb F_q^m\}$ be the code generated by a uniformly random matrix $G\in\mathbb F_q^{n\times m}$ (of any rank). Then for every $\Delta>q^{-m}|f(0)-1|$,
--
--   $$
--   \Pr_G\big[|\delta_{C,f}|>\Delta\big]\le\frac{q-1}{q^m\big(\Delta-q^{-m}|f(0)-1|\big)^2}\,\|f\|_2^2+\frac{q^{m-n}}{q-1}.
--   $$
--
--   This direct estimate gives failure probability $q^{-\Omega(n)}$ for a single function; the proof of Theorem 2.4 applies it to the self-convolution $F_f$ at every step of the construction.
--
--   Differences from the source:
--   - encoding: F_q and F^n_q → a finite field `F` with q = `Fintype.card F`, and `Fin n → F`; reason: every prime power is the size of a finite field; same instances
--   - encoding: Pr over a uniform random object → the counting ratio `PunctSketch.coinProb` over all outcomes; reason: the paper's law is uniform on a finite space; same values
--   - encoding: C, the linear code generated by G → `rlc G`, the image of `G`; reason: the paper's model; no full-rank condition in either
--   - encoding: q^{−m} and q^{m−n} → `(q ^ m)⁻¹` and the real power `q ^ ((m : ℝ) - n)`; reason: equal values
-- source:
--   Doron, Leonov, Mosheiff, Navas, Resch, Ribeiro, Discrepancy for Random Linear Codes, arXiv:2606.24471 (PDF sha256 f03561c3…), Lemma 4.4, p.25

import Mathlib
import Definitions.Def_RLCDiscrepancy_IsNormalized
import Definitions.Def_RLCDiscrepancy_relDev
import Definitions.Def_RLCDiscrepancy_l2NormSq
import Definitions.Def_PunctSketch_coinProb
import Definitions.Def_RLCDiscrepancy_rlc

namespace RLCDiscrepancy

/-- **Lemma 4.4** (direct second-moment bound). Doron, Leonov, Mosheiff, Navas, Resch, Ribeiro, *Discrepancy for Random Linear Codes*,
arXiv:2606.24471 (PDF sha256 f03561c3…), Lemma 4.4, p.25: "Fix n ∈ N and m ≤ n.
Let f : F^n_q → R≥0 be normalized, and let C be the linear code generated by a uniformly random
matrix G ∈ F^{n×m}_q. Then, for every ∆ > q^{−m}|f(0) − 1|,
Pr_G[|δ_{C,f}| > ∆] ≤ (q − 1)/(q^m (∆ − q^{−m}|f(0) − 1|)²) ∥f∥²_2 + q^{m−n}/(q − 1)."

**Formalization Note.** q = `Fintype.card F`; the probability is the fraction of the q^{nm}
matrices `G` with the (strict) event; C = `rlc G`, the image of `G` with no rank condition;
q^{−m} is `(q ^ m)⁻¹`; q^{m−n} is a real power. -/
theorem lemma_4_4 {F : Type*} [Field F] [Fintype F] (n m : ℕ) (hmn : m ≤ n)
    (f : (Fin n → F) → ℝ) (hf : IsNormalized f) (Δ : ℝ)
    (hΔ : ((Fintype.card F : ℝ) ^ m)⁻¹ * |f 0 - 1| < Δ) :
    PunctSketch.coinProb (fun G : Matrix (Fin n) (Fin m) F => Δ < |relDev (rlc G) f|) ≤
      ((Fintype.card F : ℝ) - 1) /
          ((Fintype.card F : ℝ) ^ m * (Δ - ((Fintype.card F : ℝ) ^ m)⁻¹ * |f 0 - 1|) ^ 2) *
          l2NormSq f +
        (Fintype.card F : ℝ) ^ ((m : ℝ) - n) / ((Fintype.card F : ℝ) - 1) := by sorry

end RLCDiscrepancy
