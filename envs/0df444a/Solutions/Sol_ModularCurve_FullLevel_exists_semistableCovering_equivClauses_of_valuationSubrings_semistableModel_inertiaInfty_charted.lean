private theorem _root_.AlgebraicCurve.ComponentChart.isDiscCoord_comap {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} {z : F}
    (h : R.IsDiscCoord Q D z) :
    (C.comapRP σ).IsDiscCoord Q (RegularProlongation.smulDisc σ⁻¹ D) (σ.symm z) := by
  obtain ⟨hD, hz, hord, hbij, het, hup⟩ := h
  have hmemD : ∀ P, P ∈ RegularProlongation.smulDisc σ⁻¹ D ↔ σ • P ∈ D := fun P => by
    rw [RegularProlongation.mem_smulDisc_iff, inv_inv]

  have hev : ∀ P : Place L F, P.IsRational → P.evalAt (σ.symm z) = (σ • P).evalAt z := fun P hr => by
    have e := Place.Transport.evalAt_smul σ P hr (f := σ.symm z)
    rw [AlgEquiv.apply_symm_apply] at e
    exact e.symm
  have hrat : ∀ P, σ • P ∈ D → P.IsRational := fun P h1 =>
    (Place.Transport.isRational_smul_iff σ P).mp (hD _ h1).1
  have hzσ : σ (σ.symm z) ∈ R.integers := by rw [AlgEquiv.apply_symm_apply]; exact hz
  refine ⟨?_, (C.mem_comapRP_integers_iff R hint σ _).mpr hzσ, ?_, ?_, ?_, ?_⟩
  · intro P hP
    have h1 := (hmemD P).mp hP
    obtain ⟨hr, hm, hv⟩ := hD _ h1
    refine ⟨hrat P h1, (Place.Transport.mem_smul_iff σ P z).mp hm, ?_⟩
    rw [hev P (hrat P h1)]; exact hv
  · rw [C.comapRP_residue_eq R hint hres σ, ← hord]
    congr 2
    exact Subtype.ext (AlgEquiv.apply_symm_apply σ z)
  · intro c hc
    obtain ⟨P, ⟨hP, hPc⟩, huniq⟩ := hbij c hc
    have hPσ : σ • (σ⁻¹ • P) ∈ D := by rw [smul_inv_smul]; exact hP
    refine ⟨σ⁻¹ • P, ⟨(hmemD _).mpr hPσ, ?_⟩, ?_⟩
    · rw [hev _ (hrat _ hPσ), smul_inv_smul, hPc]
    · rintro P' ⟨hP', hP'c⟩
      have h1 := (hmemD P').mp hP'
      have hval : (σ • P').evalAt z = c := by rw [← hev P' (hrat P' h1)]; exact hP'c
      have := huniq (σ • P') ⟨h1, hval⟩
      rw [← this, inv_smul_smul]
  · intro P hP
    have h1 := (hmemD P).mp hP
    have e := het _ h1
    rw [← hev P (hrat P h1)] at e
    rw [← Place.ord_smul σ P, map_sub, AlgEquiv.commutes, AlgEquiv.apply_symm_apply]
    exact e
  · intro f hf hf0
    have hf' : ∀ P ∈ D, P.ord (σ f) = 0 := by
      intro P hP
      have hPσ : σ • (σ⁻¹ • P) ∈ D := by rw [smul_inv_smul]; exact hP
      have := hf0 (σ⁻¹ • P) ((hmemD _).mpr hPσ)
      rw [← Place.ord_smul σ (σ⁻¹ • P), smul_inv_smul] at this
      exact this
    obtain ⟨c, hc0, hc⟩ := hup (σ f) (by simpa using hf) hf'
    refine ⟨c, hc0, fun P hP => ?_⟩
    have h1 := (hmemD P).mp hP
    rw [← Place.Transport.evalAt_smul σ P (hrat P h1)]
    exact hc _ h1

