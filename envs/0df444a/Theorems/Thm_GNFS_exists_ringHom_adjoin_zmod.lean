-- title:
--   Homomorphism $\mathbb{Z}[\theta]\to\mathbb{Z}/n\mathbb{Z}$, $\theta\mapsto m$
-- statement:
--   Let $f \in \mathbb{Z}[x]$ be irreducible in $\mathbb{Z}[x]$, let $\theta \in \mathbb{C}$ be a root of $f$, let $n \in \mathbb{N}$ and $m \in \mathbb{Z}$ with
--   $$n \mid f(m).$$
--   Then there is a ring homomorphism $\varphi : \mathbb{Z}[\theta] \to \mathbb{Z}/n\mathbb{Z}$ with $\varphi(\theta) = m \bmod n$, where $\mathbb{Z}[\theta]$ is the subring of $\mathbb{C}$ generated by $\theta$.
--
--   This homomorphism turns square roots computed in the number field into residues modulo $n$.
--
--   **Formalization Note** Irreducibility in $\mathbb{Z}[x]$ (rather than only over $\mathbb{Q}$) includes primitivity, which is necessary: for $f(x)=2x$ and $n=2$ the conclusion fails for $m=1$. For $n = 0$, $\mathbb{Z}/0\mathbb{Z}$ is $\mathbb{Z}$.
-- source:
--   Wikipedia, "General number field sieve" (revision oldid=1377718368, https://en.wikipedia.org/w/index.php?title=General_number_field_sieve&oldid=1377718368), section 'Method — Postprocessing'

import Mathlib
import Definitions.Def_GNFS_defs
open Polynomial IntermediateField

namespace GNFS
theorem exists_ringHom_adjoin_zmod (f : ℤ[X]) (hf : Irreducible f) (θ : ℂ)
    (hθ : aeval θ f = 0) (n : ℕ) (m : ℤ) (hm : (n : ℤ) ∣ f.eval m) :
    ∃ φ : Algebra.adjoin ℤ ({θ} : Set ℂ) →+* ZMod n,
      φ ⟨θ, Algebra.self_mem_adjoin_singleton ℤ θ⟩ = (m : ZMod n) := by sorry
end GNFS
