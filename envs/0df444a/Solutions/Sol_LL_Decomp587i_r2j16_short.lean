    have h_ig : integrand4 ω φ x ≤ ((5 / 6 : ℝ) / u0 + 1 / 6) / (x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2) :=
      div_le_div_of_nonneg_right henv (le_of_lt hden_pos)
    have ht1 : ((5 / 6 : ℝ) / u0) / (x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2) =
        (5 / 6 : ℝ) * f_smooth BuchstabArithmetic.top x := by
      dsimp [u0, S]; unfold f_smooth
      have hx2_ne : x.2.2.1 ≠ 0 := ne_of_gt q2
      have hrem_pos : 0 < BuchstabArithmetic.top - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2) := by
        rw [BuchstabArithmetic.top_eq]; linarith [h0.2, h1.2, h2.2, h3.2, q2]
      field_simp [ne_of_gt q0, ne_of_gt q1, hx2_ne, ne_of_gt q3, ne_of_gt hrem_pos,
        show BuchstabArithmetic.top - x.1 - x.2.1 - x.2.2.1 - x.2.2.2 ≠ 0 by linarith]
      ring
    have ht2 : (1 / 6 : ℝ) / (x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2) ≤
        (1 / 6 : ℝ) * ((1 / a0) * prod_inv4 x) := by
      have inv2 : 1 / x.2.2.1 ≤ 1 / a0 := one_div_le_one_div_of_le ha0_pos h2.1
      have e_p : (1 / 6 : ℝ) / (x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2) =
