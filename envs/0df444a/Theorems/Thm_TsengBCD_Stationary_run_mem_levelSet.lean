-- title:
--   Proof of Theorem 4.1, p. 481 — the BCD iterates decrease f, stay in X⁰ and are bounded
-- statement:
--   Let $f:\mathbb R^{n_1+\cdots+n_N}\to\mathbb R\cup\{\infty\}$, let $x^0$ satisfy $f(x^0)<\infty$, and assume the level set $X^0=\{x: f(x)\le f(x^0)\}$ is compact. Let $\{x^r\}$ be any sequence generated by the BCD method (2)–(3) from $x^0$ with any choice of blocks. Then for every $r=0,1,\dots$
--   $$f(x^{r+1})\le f(x^r)\qquad\text{and}\qquad x^{r+1}\in X^0,$$
--   and the sequence $\{x^r\}$ is bounded.
--
--   This is the first step of the proof of Theorem 4.1: the method is a descent method, so its iterates are confined to the compact level set.
--
--   **Formalization Note.** Blocks are 0-based and `s r` is the block chosen at iteration $r+1$. Continuity of $f$ is not needed for this step and is not assumed; the existence half ("$x^{r+1}$ is defined") is the separate item `argmin_attained`.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), p. 481, proof of Theorem 4.1, first two sentences

import Mathlib
import Definitions.Def_TsengBCD_Stationary_Setting

namespace TsengBCD.Stationary

open Filter Topology

theorem run_mem_levelSet {N : ℕ} {n : Fin N → ℕ} (f : X n → EReal) (x0 : X n)
    (hx0 : f x0 ≠ ⊤) (hcpt : IsCompact (levelSet f x0))
    (s : ℕ → Fin N) (x : ℕ → X n) (hx : x 0 = x0) (hrun : IsBCDRun f s x) :
    (∀ r, f (x (r + 1)) ≤ f (x r) ∧ x (r + 1) ∈ levelSet f x0) ∧
      Bornology.IsBounded (Set.range x) := by sorry

end TsengBCD.Stationary
