      omega
    have hbn := NLogN.canon_bnd hclo
    have hbn' := NLogN.canon_bnd hchi
    -- segment B: lo from DX to U
    have hB := NLogN.mvH_runs (I := I) (iprog := iprog) (X := NLogN.DX) (Y := NLogN.U) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s1 lo (NLogN.ints hi ++ R) (s.G NLogN.HH)
      (n + 1) (by simp +decide [s1, hX, hAlh, NLogN.ints_append]) (by simp [s1, hlol]) hbn
    set s2 := (s1.upd NLogN.DX (NLogN.ints hi ++ R)).upd NLogN.U ((NLogN.ints lo).reverse ++ s1.G NLogN.U) with hs2
    -- segment C: back from U to V
    have hC := NLogN.mvH_runs (I := I) (iprog := iprog) (X := NLogN.U) (Y := NLogN.V) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s2 lo.reverse (s.G NLogN.U) (s.G NLogN.HH)
      (n + 1) (by simp +decide [s2, s1, NLogN.ints_reverse]) (by simp +decide [s2, s1, hlol])
      (fun a ha => hbn a (List.mem_reverse.mp ha))
    set s3 := (s2.upd NLogN.U (s.G NLogN.U)).upd NLogN.V ((NLogN.ints lo.reverse).reverse ++ s2.G NLogN.V) with hs3
    -- segment D: butterflies
    set s3' := (s3.upd NLogN.W (.int 1 :: s.G NLogN.W)).upd NLogN.CC (.int (h : ℤ) :: s.G NLogN.CC) with hs3'
    have hD1 : NLogN.IRuns I iprog (.seq (.op (.const NLogN.W 1)) (.op (.dup NLogN.HH NLogN.CC))) s3 s3' (1000 * (n + 3)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, s3, s2, s1, NLogN.zsz_one]
      refine ⟨by simp only [hs3', hs3, hs2, hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := NLogN.dupCost_le (NLogN.zsz (h : ℤ)); omega
    have hD2 := NLogN.bflyLoop_runs (I := I) (iprog := iprog) s3' n E lo hi (s.G NLogN.V) R (s.G NLogN.W) (s.G NLogN.CC)
      LE LN LF hn (by omega) (by rw [hlol]; omega) (by rw [hlol]; exact hzh) hclo hchi
      (by simp +decide [s3', s3, s2, s1, NLogN.ints_reverse])
      (by simp +decide [s3', s3, s2, s1])
      (by simp +decide [s3'])
      (by simp +decide [s3', hlol])
      (by simp +decide [s3', s3, s2, s1, hDE])
      (by simp +decide [s3', s3, s2, s1, hN])
      (by simp +decide [s3', s3, s2, s1, hF])
    set s4 := (((s.upd NLogN.HH (.int (h : ℤ) :: s.G NLogN.HH)).upd NLogN.DX R).upd NLogN.P1
      ((NLogN.ints tops).reverse ++ s.G NLogN.P1)).upd NLogN.P2 ((NLogN.ints bots).reverse ++ s.G NLogN.P2) with hs4
    have hD3 : NLogN.IRuns I iprog (.seq (.op (.drop NLogN.CC)) (.op (.drop NLogN.W)))
        (((((((s3'.upd NLogN.V (s.G NLogN.V)).upd NLogN.DX R).upd NLogN.P1
          ((NLogN.ints (NLogN.bflyT (2 ^ n + 1) lo hi)).reverse ++ s3'.G NLogN.P1)).upd NLogN.P2
          ((NLogN.ints (NLogN.bflyB (2 ^ n + 1) E 0 lo hi)).reverse ++ s3'.G NLogN.P2)).upd NLogN.W
            (.int (2 ^ (lo.length * E)) :: s.G NLogN.W)).upd NLogN.CC (.int 0 :: s.G NLogN.CC)))
        s4 (1000 * (n + 3)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.IStmt.run, NLogN.IOp.run, NLogN.zsz_zero, NLogN.zsz_two_pow]
      refine ⟨?_, by rw [hlol, hjE']; omega⟩
      simp only [hs4, hs3', hs3, hs2, hs1, htops, hbots]
      clear * -
      ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
    -- segment E: child parameters
    set s5 := (s4.upd NLogN.DL (.int (h : ℤ) :: .int (2 ^ (j + 1)) :: LL)).upd NLogN.DE
      (.int (2 ^ (2 * E)) :: .int (2 ^ E) :: LE) with hs5
    have hE : NLogN.IRuns I iprog NLogN.difSegE s4 s5 (2000 * (n + 3)) := by
      apply NLogN.IRuns.of_runsTo 0
      have e : (2 : ℤ) ^ E * 2 ^ E = 2 ^ (2 * E) := by ring
      simp +decide [NLogN.difSegE, NLogN.IStmt.run, NLogN.IOp.run, s4, hL, hDE, e]
      refine ⟨by simp only [hs5, hs4]; clear * - hL hDE; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := NLogN.dupCost_le (NLogN.zsz (h : ℤ)); have := NLogN.dupCost_le (NLogN.zsz ((2 : ℤ) ^ E))
      have := NLogN.shlCost_le E; have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ (2 * E)))
      simp only [NLogN.zsz_two_pow] at *
      have : E ≤ n := by nlinarith
      have := hzh
      omega
    -- segment F and the first recursive call
    have hF6 := NLogN.mvH_runs (I := I) (iprog := iprog) (X := NLogN.P2) (Y := NLogN.DX) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s5 bots.reverse (s.G NLogN.P2)
      (s.G NLogN.HH) (n + 1) (by simp +decide [s5, s4, NLogN.ints_reverse]) (by simp +decide [s5, s4, hbl])
      (fun a ha => NLogN.canon_bnd (NLogN.canon_bflyB (by positivity) E 0 lo hi) a (List.mem_reverse.mp ha))
    set s6 := (s5.upd NLogN.P2 (s.G NLogN.P2)).upd NLogN.DX ((NLogN.ints bots.reverse).reverse ++ s5.G NLogN.DX) with hs6
    have hcb : NLogN.Canon (2 ^ n + 1) bots := NLogN.canon_bflyB (by positivity) E 0 lo hi
    have hct : NLogN.Canon (2 ^ n + 1) tops := NLogN.canon_bflyT (by positivity) lo hi
    have hc1 := ih s6 bots R (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF (2 * E)
      (by rw [hbl, hh]) (by right; rw [← hh]; linarith) hcb
      (by simp +decide [s6, s5, s4, NLogN.ints_reverse])
      (by have e3 : ((h : ℕ) : ℤ) = 2 ^ j := by rw [hh]; push_cast; rfl
          simp +decide [s6, s5, e3])
      (by simp +decide [s6, s5])
      (by simp +decide [s6, s5, s4, hN]) (by simp +decide [s6, s5, s4, hF])
    set db := NLogN.difZ (2 ^ n + 1) (2 * E) j bots with hdb
    set s7 := s6.upd NLogN.DX (NLogN.ints db ++ R) with hs7
    -- segment G and the second recursive call
