/-! ## Partial sums and the fixed point -/

theorem SN_succ (N : ℕ) (t : ℝ) : SN (N + 1) t = SN N t + Yfun N t := by
  unfold SN
  rw [Finset.sum_range_succ]

theorem continuousOn_SN (N : ℕ) : ContinuousOn (SN N) (Ici 3) := by
