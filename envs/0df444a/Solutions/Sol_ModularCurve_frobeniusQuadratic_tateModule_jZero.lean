    σ • σ • z - heckeOperatorBar N ⟨ℓ, hℓ⟩ (σ • z) + ℓ • z = 0 := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : CharP (IsLocalRing.ResidueField A) ℓ := A.charP_residueField_of_liesOverPrime_def hℓ hA

  have hred : ReductionInputsModL A N := reductionInputsModL_of_not_dvd N hℓN A hA

  refine eq_zero_of_reductionModL_eq_zero_of_nsmul_eq_zero N hℓN A hA hred m hm _ ?_ ?_
  ·
    have h0 : σ • (0 : JZero N) = 0 := smul_zero (A := JZero N) σ
    have h1 : m • (σ • σ • z) = 0 := by
      rw [smul_comm, smul_comm m σ z, hz, h0, h0]
    have h2 : m • heckeOperatorBar N ⟨ℓ, hℓ⟩ (σ • z) = 0 := by
      rw [← map_nsmul, smul_comm, hz, h0, map_zero]
    have h3 : m • (ℓ • z) = 0 := by
      rw [smul_comm, hz, smul_zero]
    rw [nsmul_add, nsmul_sub, h1, h2, h3, sub_zero, add_zero]
  ·
    exact map_quadratic_eq_zero (reductionModL A N) (σ • ·) (heckeOperatorBar N ⟨ℓ, hℓ⟩)
      (frobeniusPushforwardModL (IsLocalRing.ResidueField A) N ℓ)
      (heckeOperatorModL (IsLocalRing.ResidueField A) N ℓ) ℓ
      (fun w => reductionModL_smul_of_isFrobeniusAt N A hred σ hσ w)
      (fun w => reductionModL_heckeOperatorBar N hℓN A hA hred w)
      (frobenius_frobenius_sub_heckeOperatorModL_frobenius_add_smul_eq_zero
        (IsLocalRing.ResidueField A) N hℓN) z

end ModularCurve.W7RFrobQuad

open _root_.ModularCurve _root_.P2MW.S_ModularCurve_frobeniusQuadratic_tateModule_jZero.ModularCurve in
theorem solution (N p : ℕ) [NeZero N] [Fact p.Prime]
    (hcomm : ModularCurve.HeckeOperatorsCommuteBar N)
    {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓNp : ¬ ℓ ∣ N * p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσ : A.IsFrobeniusAt σ ℓ)
    (x : TateModule p (ModularCurve.JZero N)) :
    letI := ModularCurve.heckeModuleBar N
    TateModule.rep p (ModularCurve.JZero N) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ
        (TateModule.rep p (ModularCurve.JZero N) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ x)
      - TateModule.rep p (ModularCurve.JZero N) ModularCurve.HeckeAlg (ModularCurve.heckeGen ⟨ℓ, hℓ⟩)
          (TateModule.rep p (ModularCurve.JZero N) (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) σ x)
      + ℓ • x = 0 := by
  letI := ModularCurve.heckeModuleBar N
  have hℓN : ¬ ℓ ∣ N := fun h => hℓNp (dvd_mul_of_dvd_left h p)
  have hℓp : ¬ ℓ ∣ p := fun h => hℓNp (dvd_mul_of_dvd_right h N)

  refine Subtype.ext (funext fun n => ?_)
  change σ • σ • (x : ℕ → JZero N) n
      - (heckeGen ⟨ℓ, hℓ⟩ : HeckeAlg) • (σ • (x : ℕ → JZero N) n) + ℓ • (x : ℕ → JZero N) n = 0

  rw [heckeModuleBar_heckeGen_smul hcomm]

  have hz : (p ^ n : ℕ) • (x : ℕ → JZero N) n = 0 := by
    rw [← natCast_zsmul]
    exact TateModule.torsion x n
  have hℓpn : ¬ ℓ ∣ p ^ n := fun h => hℓp (hℓ.dvd_of_dvd_pow h)
  exact W7RFrobQuad.torsion_key N hℓ A hA hℓN σ hσ _ (p ^ n) hℓpn hz

end S_ModularCurve_frobeniusQuadratic_tateModule_jZero
