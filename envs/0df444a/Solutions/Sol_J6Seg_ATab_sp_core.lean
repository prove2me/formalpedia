/-!
# A lines, table set-up, part 9: the core program (fixed layout)

`coreUp = initP rg; parA; phase; tabLoop; finiP rg`.
**`sp_core`**: from a state with the descriptor on `31` and every other stack empty it leaves
the `kerRegs` values `ρ 0 … ρ 8` as the list `vsA …` on `45`, `[|T|]` on `42` and `T.reverse`
on `43` (`coreOut`), every other stack unchanged — the input of B5's `distAll` after one move.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

theorem tabsT_length (f : ℕ → List ℤ) (L : ℕ) (hf : ∀ q, (f q).length = L) :
    ∀ N, (tabsT f N).length = N * (L + 1)
  | 0 => by simp [tabsT]
  | N + 1 => by
    have ih := tabsT_length f L hf N
    simp only [tabsT, List.range_succ, List.flatMap_append, List.length_append] at ih ⊢
    rw [ih]; simp [segT, hf]; ring

theorem tabsA_length (p s t α pk b : ℕ) :
    (tabsT (aTab6 p s t α pk b) (ncA p t α)).length =
      ncA p t α * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α + 18) := by
  rw [tabsT_length _ (4 * J6A.WA p α (HAx p α) + 4 * HAx p α + 17) (aTab6_length p s t α pk b)]

set_option maxHeartbeats 1000000 in
/-- The stacks after the pushes of the phase. -/
theorem pushToC_eq {W pre post s t p α pkA pkC : ℕ} {v : Vr} (hv : J6A.PA.PV pre post s t p α W v)
    {F : Fin HS → List ℤ} (h45 : F 45 = []) (h42 : F 42 = []) (Ln : ℕ)
    (hLn : Ln = ncA p t α * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α + 18)) :
    pushToC v (pushD pkA pkC) F =
      update (update F 45 (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3) pre
        (ncA p t α) post)) 42 [(Ln : ℤ)] := by
  have e8 : (2 : ℕ) ^ (Nat.log 2 (sWidth p α) + 3) = 8 * HAx p α := by
    rw [pow_add]; unfold HAx; ring
  have enc : ((ncA p t α : ℕ) : ℤ) = ↑t / (16 * ↑(HAx p α)) * 8 := by
    simp [ncA, HAx]
  have hH : (J6A.PA.HH p α : ℕ) = HAx p α := rfl
  simp only [pushD, pushToC, update_self, update_idem,
    update_of_ne (show (42 : Fin HS) ≠ 45 by decide), h45, h42, List.append_nil]
  simp only [E.den, hv.r1, hv.r2, hv.r5, hv.r8, hv.r9, hv.r10, hv.r11, hv.r12]
  subst hLn
  rw [vsA, e8]
  simp only [hH, ← enc]
  push_cast
  ring_nf

set_option maxHeartbeats 2000000 in
/-- **The core program.** -/
theorem sp_core_sol_aux {W k pre post s t p α d pkA pkC bA bC : ℕ} (st : IState HS)
    (F : Fin HS → List ℤ) (hF : ∀ j, j ≠ 31 → F j = [])
    (hF31 : F 31 = J6A.PA.dL k pre post s t p α d)
    (hdL : ∀ x ∈ J6A.PA.dL k pre post s t p α d, |x| < 2 ^ W) (hp1 : 1 ≤ p) (hα1 : 1 ≤ α)
    (hmW : sWidth p α + 4 ≤ W) (hP : PBnd W p t α pkA pkC bA bC) (hA : ABnd W p s t α)
    (hrW : 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) < 2 ^ W) :
    Sp (coreUp pkA pkC bA bC) (encK st F)
      (encK st (coreOut F (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3) pre
        (ncA p t α) post) (tabA p s t α (pkA * p + pkC) (bA * p + bC))))
      (cCore W p t α pkA pkC bA bC) := by
  have hlen : (tabA p s t α (pkA * p + pkC) (bA * p + bC)).length =
      ncA p t α * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α + 18) := by
    rw [tabA, tabsA_length]
  have hrg : ∀ j ∈ rg, F j = [] := fun j hj => hF j (by intro e; subst e; exact absurd hj (by decide))
  have s1 := init_sp st F hrg
  obtain ⟨v1, hv1, sp2⟩ := J6A.PA.Rn.parA (c := F) (hF 13 (by decide)) hF31 hdL hp1 hα1 hmW
  obtain ⟨v2, ⟨hL2, h10, hB2⟩, sp3⟩ := Rn.phase hv1 hP hrW (hF 48 (by decide))
  have ec1 := pushToC_eq (pkA := pkA) (pkC := pkC) hv1 (hF 45 (by decide)) (hF 42 (by decide))
    _ hlen
  rw [ec1] at sp3
  have hc1O : update (update F 45 (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3)
      pre (ncA p t α) post)) 42 [((tabA p s t α (pkA * p + pkC) (bA * p + bC)).length : ℤ)]
      cO = [] := by
    rw [update_of_ne (by decide), update_of_ne (by decide)]; exact hF 50 (by decide)
  have hc1I : update (update F 45 (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3)
      pre (ncA p t α) post)) 42 [((tabA p s t α (pkA * p + pkC) (bA * p + bC)).length : ℤ)]
      cI = [] := by
    rw [update_of_ne (by decide), update_of_ne (by decide)]; exact hF 51 (by decide)
  have hc1S : update (update F 45 (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3)
      pre (ncA p t α) post)) 42 [((tabA p s t α (pkA * p + pkC) (bA * p + bC)).length : ℤ)]
      sS = [] := by
    rw [update_of_ne (by decide), update_of_ne (by decide)]; exact hF 43 (by decide)
  obtain ⟨v3, ⟨a3, hB3⟩, sp4⟩ := Rn.tabLoop (pk := pkA * p + pkC) (b := bA * p + bC) hA hL2 h10
    hB2 hc1O hc1I
  rw [hc1S, List.append_nil] at sp4
  have hc2rg : ∀ j ∈ rg, coreOut F (vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3)
      pre (ncA p t α) post) (tabA p s t α (pkA * p + pkC) (bA * p + bC)) j = [] := by
    intro j hj
    have h1 : j ≠ 43 := by intro e; subst e; exact absurd hj (by decide)
    have h2 : j ≠ 42 := by intro e; subst e; exact absurd hj (by decide)
    have h3 : j ≠ 45 := by intro e; subst e; exact absurd hj (by decide)
    rw [coreOut, update_of_ne h1, update_of_ne h2, update_of_ne h3]; exact hrg j hj
  have s7 := fini_sp st _ hc2rg v3 (W := W + 1) (fun j hj => zsz_le_W1 (hB3 j hj))
  exact (s1.seq ((sp2 st).seq ((sp3 st).seq ((sp4 st).seq s7)))).mono (by unfold cCore; omega)

end J6Seg.ATab

