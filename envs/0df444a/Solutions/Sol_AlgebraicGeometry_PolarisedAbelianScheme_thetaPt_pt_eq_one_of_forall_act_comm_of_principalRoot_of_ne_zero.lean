variable {A : Scheme.{0}}

theorem fib_mapComp_inv_app (a b : A ⟶ A) (N : A.Modules) :
    (Scheme.Modules.fibration.mapComp b.op.toLoc a.op.toLoc).inv.toNatTrans.app N =
      (Scheme.Modules.pullbackComp a b).hom.app N := by
  simp [Scheme.Modules.fibration, Scheme.Modules.pseudofunctor, Pseudofunctor.comp, Bicategory.Adj.forget₁,
    LocallyDiscrete.mkPseudofunctor]
  rfl

theorem fib_mapId_inv_app (N : A.Modules) :
    (Scheme.Modules.fibration.mapId ⟨Opposite.op A⟩).inv.toNatTrans.app N = (Scheme.Modules.pullbackId A).inv.app N := by
  simp [Scheme.Modules.fibration, Scheme.Modules.pseudofunctor, Pseudofunctor.comp, Bicategory.Adj.forget₁,
    LocallyDiscrete.mkPseudofunctor]

variable {M : A.Modules}

theorem fiber_comp_eq_of_comp_eq_id (u v : RiemannForm.modulePair (A := A) M ⟶ RiemannForm.modulePair (A := A) M)
    (h : u ≫ v = 𝟙 _) :
    ∃ (Y : M ⟶ (Scheme.Modules.pullback (u.base ≫ v.base)).obj M) (_ : IsIso Y),
      u.fiber ≫ (Scheme.Modules.pullback u.base).map v.fiber ≫ (Scheme.Modules.pullbackComp u.base v.base).hom.app M = Y := by
  have e := Pseudofunctor.CoGrothendieck.Hom.congr h
  simp only [Pseudofunctor.CoGrothendieck.categoryStruct_comp_fiber, Pseudofunctor.CoGrothendieck.categoryStruct_id_fiber,
    RiemannForm.modulePair_base, RiemannForm.modulePair_fiber, Scheme.Modules.fibration_map_toFunctor,
    fib_mapComp_inv_app, fib_mapId_inv_app] at e
  exact ⟨_, by infer_instance, e⟩

theorem isIso_fiber (g : RiemannForm.modulePair (A := A) M ≅ RiemannForm.modulePair (A := A) M) : IsIso g.hom.fiber := by
  obtain ⟨Y, hY, e1⟩ := fiber_comp_eq_of_comp_eq_id g.hom g.inv g.hom_inv_id
  obtain ⟨Y', hY', e2⟩ := fiber_comp_eq_of_comp_eq_id g.inv g.hom g.inv_hom_id

  set ρ : (Scheme.Modules.pullback g.hom.base).obj M ⟶ M :=
    ((Scheme.Modules.pullback g.hom.base).map g.inv.fiber ≫ (Scheme.Modules.pullbackComp g.hom.base g.inv.base).hom.app M) ≫
      inv Y with hρ
  have hsec : g.hom.fiber ≫ ρ = 𝟙 M := by
    rw [hρ, ← Category.assoc, e1, IsIso.hom_inv_id]

  have hsec' : g.inv.fiber ≫ (((Scheme.Modules.pullback g.inv.base).map g.hom.fiber ≫
      (Scheme.Modules.pullbackComp g.inv.base g.hom.base).hom.app M) ≫ inv Y') = 𝟙 M := by
    rw [← Category.assoc, e2, IsIso.hom_inv_id]
  haveI : IsSplitMono g.inv.fiber := IsSplitMono.mk' ⟨_, hsec'⟩
  haveI : IsSplitMono ((Scheme.Modules.pullback g.hom.base).map g.inv.fiber) :=
    IsSplitMono.mk' ⟨(Scheme.Modules.pullback g.hom.base).map (retraction g.inv.fiber), by
      rw [← CategoryTheory.Functor.map_comp, IsSplitMono.id, CategoryTheory.Functor.map_id]⟩
  haveI : Mono ρ := by rw [hρ]; infer_instance
  haveI : IsSplitEpi ρ := IsSplitEpi.mk' ⟨_, hsec⟩
  haveI : IsIso ρ := isIso_of_mono_of_isSplitEpi ρ
  rw [← IsIso.inv_eq_of_inv_hom_id hsec]
  infer_instance

theorem nonempty_iso_of_thetaGroup {k : Type} [Field k] (f : A ⟶ Spec (CommRingCat.of k)) (L : RelativeGroupLaw k f)
    (hc : L.IsCommutative) (γ : RiemannForm.thetaGroup f L hc M) :
    Nonempty ((Scheme.Modules.pullback (RiemannForm.translation f L
      (RelativeGroupLaw.AlgPoints.toPoint (Multiplicative.toAdd (RiemannForm.thetaGroup.pt f L hc M γ))))).obj M ≅ M) := by
  haveI := isIso_fiber γ.1.1
  refine ⟨(Scheme.Modules.pullbackCongr ?_).app M ≪≫ (asIso γ.1.1.hom.fiber).symm⟩
  rw [RiemannForm.thetaGroup.base_eq, RiemannForm.thetaGroup.pt_apply]
  rfl

