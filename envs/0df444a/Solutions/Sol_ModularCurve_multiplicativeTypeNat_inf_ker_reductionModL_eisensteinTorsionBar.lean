theorem solution
    (p : ℕ) [Fact p.Prime] (h2n : 2 ∣ eisensteinNumerator p)
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2)
    (hRI : ReductionInputsModL B p) (m : ℕ)
    (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ)
    (hn : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ m) = 1 → σ ζ = ζ ^ n σ) :
    MultiplicativeTypeNat (B.inertiaSubgroupIn ℚ) n
      (eisensteinTorsionBar p 2 m ⊓ (reductionModL B p).ker) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  cases m with
  | zero => exact KDMUDEngine.multiplicativeTypeNat_m_zero n B
  | succ m' =>
    have h2p := KDMUDN3.two_not_dvd p h2n
    have hQ2A := ModularCurve.exists_finiteFlat_model_jZero_torsion_reductionModL_eq_zero
      p 2 h2p B hB hRI (m' + 1)
    obtain ⟨H, instCR, instHopf, hfin, hflat, hcocomm, e, he_add, he_act, hker⟩ := hQ2A
    haveI := hfin
    haveI := hflat
    haveI := hcocomm
    let M : AddSubgroup (JZero p) :=
      (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ (m' + 1))).toAddSubgroup
    have he_act' : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) f g,
        (∀ h : H, g h = σ (f h)) → ((e g : ↥M) : JZero p) = σ • ((e f : ↥M) : JZero p) := he_act
    obtain ⟨K, hKM, hK, -, hDK⟩ :=
      KDMUDN3.dock p B hB (m' + 1) H e he_add he_act hker
    have htors := KDMUDN3.torsionBy_nsmul_eq_zero p 2 (m' + 1)
    have hM' : eisensteinTorsionBar p 2 (m' + 1) ≤ M :=
      fun x hx => KDMUDN3.eisensteinTorsionBar_le_torsionBy p 2 (m' + 1) hx
    obtain ⟨r, step, hstep0, hstepr, hmono, hstab, hcard, hact⟩ :=
      KDMUDEngine.exists_ambient_chain p m' n hn
    have hmult :=
      GaloisRep.multiplicativeTypeNat_reductionKernel_inf_of_finiteFlatHopf_of_admissibleChain_two
        2 rfl H M e he_add he_act' B hB (m' + 1) n hn htors
        (eisensteinTorsionBar p 2 (m' + 1)) hM'
        r step hstep0 hstepr hmono hstab hcard hact K hKM hK
    exact KDMUDN3.multiplicativeTypeNat_mono hDK hmult

end S_ModularCurve_multiplicativeTypeNat_inf_ker_reductionModL_eisensteinTorsionBar
