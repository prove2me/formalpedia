    Light.Sec3.scanRound.Runs lim ⟨Light.frame [ab, bc, ac, n, a, b, c0, len, c, Light.Sec3.bit hit, wab, rowB, rowA], μ⟩
      (· = ⟨Light.frame [ab, bc, ac, n, a, b, c0, len, (c + 1 : ℕ),
        Light.Sec3.bit (hit || decide (wab + wbc + wac = 0)), wab, rowB, rowA], μ⟩) := by
  rw [abs_le] at leAB leBC leAC
