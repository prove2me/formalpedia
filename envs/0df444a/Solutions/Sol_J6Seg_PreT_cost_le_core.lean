  unfold cE
  have h1 : (B + 2) ^ 2 ≤ (41 * Y) ^ 2 := Nat.pow_le_pow_left hB 2
  have h2 : Y ^ 2 ≤ Y ^ 10 := Nat.pow_le_pow_right hY (by norm_num)
  calc (e.size + 1) * 10 ^ 7 * (B + 2) ^ 2 ≤ 1001 * 10 ^ 7 * (41 * Y) ^ 2 :=
        Nat.mul_le_mul (Nat.mul_le_mul_right _ (by omega)) h1
    _ = 1001 * 10 ^ 7 * 1681 * Y ^ 2 := by ring
    _ ≤ 10 ^ 60 * Y ^ 10 := Nat.mul_le_mul (by norm_num) h2

