theorem inv_hA (hA : ∀ x : L, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A) :
    ∀ x : L, SemilinearAut.baseAut g⁻¹ x ∈ A ↔ x ∈ A := fun x => by
  rw [SemilinearAut.baseAut_inv, ← hA ((SemilinearAut.baseAut g).symm x), RingEquiv.apply_symm_apply]

