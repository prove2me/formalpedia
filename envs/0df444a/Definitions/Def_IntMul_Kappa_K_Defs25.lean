section
-- Source module: Solutions.KFZFull
/-!
# KFZ Full: the whole chirp procedure body

`body j d18 = setupP; T1; …; T7; wP setC (PP j d18); popsL regL`.

**`body_runs`**: from `encK s f` (stack `0` = `gflat xs ++ l`, the chirp descriptor on `cS`, all
other managed stacks empty) the body ends in `encK s (update f 0 (gflat ys ++ l))` with
`ys = Q(Q(H θ̃⁻) ã)`, given the run of the Prop 18 call on its state.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue

/-- The body of the chirp procedure. -/
def body {E : ℕ} (j : Fin (7 + E)) (d18 : Fin HS) : IStmt HS (7 + E) :=
  .seq setupP.code (.seq (T1 E) (.seq (T2 E) (.seq (T3 E) (.seq (T4 E) (.seq (T5 E) (.seq (T6 E)
    (.seq (T7 E) (.seq (NLogN.KFZ.wP NLogN.KFZ.setC (NLogN.KFZ.PP j d18)) (NLogN.KFZ.popsL regL).code))))))))

/-- The empty-elsewhere condition of the input state. -/
def EmptyEx (f : Fin HS → List ℤ) : Prop := ∀ j, j ≠ 0 → j ≠ NLogN.KFZ.cS → f j = []

/-- The register values of the final pops. -/
def vsR (p h d σ K : ℕ) : List (Fin HS × ℤ) :=
  [(rgP, (p : ℤ)), (rgH, (h : ℤ)), (rgD, (d : ℤ)), (rgS, (σ : ℤ)), (rgK, (K : ℤ))]

/-! ## The product-phase state -/

/-- The parameters of the product phase. -/
def vsC (p h d σ : ℕ) : List (Fin HS × ℤ) :=
  [(NLogN.KFM.pR, 2 ^ p), (nX, 2 ^ (d * h + σ)), (nX2, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)), (KFM.rN, 1),
    (rN2, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ))]

/-- The state entering the product phase (parameters pushed). -/
def FC (f : Fin HS → List ℤ) (p h D σ K : ℕ) (sv t : Fin (D + 1) → ℕ) (z : List ℤ) :
    Fin HS → List ℤ :=
  pushF (St f p h (D + 1) σ K [] z [] (gflat (bLz p h D sv t)) (gflat (aLz p h D sv t))
    (gflat (tLz p h D t)) (gflat (iLz p h D t))) (vsC p h (D + 1) σ)

/-- `F = Q(b̃ θ̃)`. -/
def zFz (p h D : ℕ) (sv t : Fin (D + 1) → ℕ) : List GI :=
  List.zipWith (gmulT p) (bLz p h D sv t) (tLz p h D t)

/-- `G = Q(Q(x ã) θ̃)`. -/
def zGz (p h D : ℕ) (sv t : Fin (D + 1) → ℕ) (xs : List GI) : List GI :=
  List.zipWith (gmulT p) (List.zipWith (gmulT p) xs (aLz p h D sv t)) (tLz p h D t)

/-- `y = Q(Q(H θ̃⁻) ã)`. -/
def yz (p h D : ℕ) (sv t : Fin (D + 1) → ℕ) (zh : List GI) : List GI :=
  List.zipWith (gmulT p) (List.zipWith (gmulT p) zh (iLz p h D t)) (aLz p h D sv t)

/-- Cost of the product phase without the Prop 18 call. -/
def cPP (w p N B Bd b len : ℕ) : ℕ :=
  cCmul w p N + (cCmul w p N + (cRepl 1 (2 * N) w + (cCmul w p N +
    (cM B Bd b len + (cCmul w p N + (cCmul w p N + 4 * cMvX (2 * N) w))))))

/-- Cost of the body without the Prop 18 call. -/
def cBody (B Bd b len p h D σ : ℕ) (sv t : Fin (D + 1) → ℕ) : ℕ :=
  10 ^ 10 * (D + 1 + 1) * (B + 2) ^ 2 +
  ((cPush 3 B + (cChirpTabU (dlV p h (D + 1)) (KFM.fmB (2 * (dlV p h (D + 1) + 2))) (NLogN.KFM.axL sv t)
    (∏ i, t i) + cPop 3 B)) +
  ((cPush 4 B + ((2 * cMvX (2 * 2 ^ ((D + 1) * h + σ)) (dlV p h (D + 1) + 3) +
    ((cItem (2 * 2 ^ ((D + 1) * h + σ)) (3000 * (dlV p h (D + 1) + 3 + NLogN.KFZ.gV p h (D + 1) + 3))
      (2 * (dlV p h (D + 1) + 3) + 1) + 2 * cCnt (2 * 2 ^ ((D + 1) * h + σ))) +
    2 * cMvX (2 * 2 ^ ((D + 1) * h + σ)) (p + 2))) + cPop 4 B)) +
  ((cPush 2 B + (cCnj (2 ^ ((D + 1) * h + σ)) (p + 2) + cPop 2 B)) +
  ((cPush 5 B + (cTwGU (dlV p h (D + 1)) (2 ^ (h + 2)) 1 (2 ^ (h + 1))
    (KFM.fmB (2 * (dlV p h (D + 1) + 2))) + cPop 5 B)) +
  ((cPush 4 B + ((2 * cMvX (2 * 2 ^ (h + 1)) (dlV p h (D + 1) + 3) +
    (cItem (2 * 2 ^ (h + 1)) (3000 * (dlV p h (D + 1) + 3 + NLogN.KFZ.gV p h (D + 1) + 3))
      (2 * (dlV p h (D + 1) + 3) + 1) + 2 * cCnt (2 * 2 ^ (h + 1)))) + cPop 4 B)) +
  ((cPush 2 B + ((cRepl (∏ i : Fin D, t i.castSucc) (2 * 2 ^ (h + 1)) (p + 2) +
    cMvX (2 * 2 ^ (h + 1)) (p + 2)) + cPop 2 B)) +
  ((cPush 2 B + (cCnj (2 ^ ((D + 1) * h + σ)) (p + 2) + cPop 2 B)) +
  ((cPush 5 B + (cPP (p + 2) p (2 ^ ((D + 1) * h + σ)) B Bd b len + cPop 5 B)) +
    (5 * (2 * B + 2) + 1)))))))))

section Body

variable {E : ℕ} (ext : Fin E → IStmt HS (7 + E)) {I : List Sym} (s : IState HS)

end Body

end NLogN.KFZ

end

