* `FitSpec6 M`: the per-axis properties of `r6_axisMaps_fit` (`‖B_i‖ ≤ 1/2`, the `S̃` and
  `B̃₀` bounds, `B̃₀ 0 = 0`); `r6_fitSpec`: such `M` exist for `n ≥ n₁`;
* `mapsLine6`: the machine's line maps (`lineB` with `λ = lamP d`, `w = K = wF d`,
  `n_c = t_i/λ`, `R = ⌊p/7⌋`, `P = segPF p d s_i`);
* **`r6_passB`**: for `n ≥ n₁`, every source list, every `M` with `FitSpec6 M` and every
  `RepFull ys y`, `‖y‖ ≤ 1`: the `tensorGo` of the machine's line maps is `RepPad` of a `v`
  with `GB (p+2)` and `‖v − tensCLM (kerB M.B) y‖ ≤ errW6 · 2^{-p}` — the representation and
  error part of the `eB` clause of `LineBody6`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

/-! ## Size of the near-boundary line -/

/-! ## The round-six statement -/

section r6
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ) [∀ i, NeZero (sD6 src D i)]
  [∀ i, NeZero (tD6 P n D i)]

/-- The per-axis properties of the maps fixed by `r6_axisMaps_fit`. -/
def FitSpec6 (M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D)) : Prop :=
  ∀ i : Fin (D + 1), ‖M.B i‖ ≤ 1 / 2 ∧
    (∀ U : ℕ → ℤ × ℤ, (∀ k, ‖IntMul.HvdH.P47.toC (U k)‖ ≤ 2 ^ pP6 P n) →
      ∀ k : ZMod (tD6 P n D i),
      ‖IntMul.HvdH.P47.toC (Sapprox (pP6 P n) (sD6 src D i) (tD6 P n D i) (αN6 P n) U k.val) -
        2 ^ pP6 P n * M.A i (fun j => IntMul.HvdH.P47.toC (U j.val) / 2 ^ pP6 P n) k‖
        ≤ 6 * sWidth (pP6 P n) (αN6 P n) + 4) ∧
    (∀ W : ℕ → ℤ × ℤ, (∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ pP6 P n) →
      ∀ l : ZMod (sD6 src D i),
      ‖IntMul.HvdH.P47.toC (B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i))
          (pP6 P n / 7) (lamP (dP6 P n)) (wF (dP6 P n))
          (sD6 src D i) (tD6 P n D i) (αN6 P n) W l.val) -
        2 ^ pP6 P n * M.B i (fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ pP6 P n) l‖ ≤ 9) ∧
    B0seg (pP6 P n) (segPF (pP6 P n) (dP6 P n) (sD6 src D i)) (pP6 P n / 7)
      (lamP (dP6 P n)) (wF (dP6 P n)) (sD6 src D i) (tD6 P n D i) (αN6 P n)
      (fun _ => (0, 0)) = fun _ => (0, 0)

/-- The machine's `B₀` line maps (axis `i`: `t_i`-lines to `t_i`-lines). -/
noncomputable def mapsLine6 : List (ℕ × (List GI → List GI)) :=
  (List.range (D + 1)).map fun i => ((List.ofFn (tD6 P n D)).getD i 1,
    lineB (pP6 P n) (segPF (pP6 P n) (dP6 P n) ((List.ofFn (sD6 src D)).getD i 1)) (pP6 P n / 7)
      ((List.ofFn (sD6 src D)).getD i 1) ((List.ofFn (tD6 P n D)).getD i 1)
      (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n) (wF (dP6 P n))
      ((List.ofFn (tD6 P n D)).getD i 1 / lamP (dP6 P n)))

end r6

end J6Seg

