-- Source module: Solutions.R6SLib
/-!
# Round-six setup, part 2: register-program lemmas on managed states

All setup states are `encK s f` (`KIL`): the lists `f j` of integers pushed over the state `s`
after the reads. A step is a `Sp p s t c` (ok, run, cost). Every cost is a multiple of the unit
`kU Bb = 10^7 (Bb+2)^2` for a uniform bit bound `Bb`.

* `sp_push`, `sp_asg`, `sp_pop`: single steps.
* `sp_rep`: a counted loop `rep C (reg R) b` through a family of managed states.
* **`sp_cnt`** (`cntR`): `#{x ∈ [1, N] : Pr x}` by a test expression.
* **`sp_sum`** (`sumR`): `Σ_{y=1}^{c} y · [y g ≡ 1 (mod c)]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

theorem kU_ge (Bb : ℕ) : 20000 * (Bb + 2) + 100 ≤ kU Bb := by
  unfold kU; nlinarith

/-! ## Single steps -/

section Steps

variable {s : IState HS} {f : Fin HS → List ℤ} {Bb : ℕ}

theorem sp_push {i : Fin HS} {e : Ex HS} {v : ℤ} (hi : i.val < 56) (hc : e.Clean)
    (hok : e.ok (encK s f)) (hv : e.eval (encK s f) = v) (hB : e.Bnd (encK s f) Bb) :
    Sp (.push i e) (encK s f) (encK s (update f i (v :: f i))) ((e.size + 1) * kU Bb) := by
  have h := Sp.pushQ s f hi hc hok hB
  rw [hv] at h
  exact h.mono (le_of_eq (by unfold kU; ring))

theorem sp_asg {i : Fin HS} {e : Ex HS} {v a : ℤ} {l : List ℤ} (hi : i.val < 56) (hf : f i = a :: l)
    (ha : zsz a ≤ Bb) (hc : e.Clean) (hok : e.ok (encK s f)) (hv : e.eval (encK s f) = v)
    (hB : e.Bnd (encK s f) Bb) :
    Sp (.asg i e) (encK s f) (encK s (update f i (v :: l))) ((e.size + 1) * kU Bb) := by
  refine ⟨⟨hi, hc, hok, isInt_encK hf⟩, ?_, ?_⟩
  · simp only [RS.run]
    rw [← encK_upd]; simp [hf, ints, hv]
  · have := asgCost_le i e _ Bb hB (by rw [top_encK hf]; exact ha)
    simp only [RS.cost]
    exact this.trans (le_of_eq (by unfold kU; ring))

end Steps

/-! ## Counted loops -/

theorem sp_rep {C R : Fin HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ} {N c Bb : ℕ}
    {lR : List ℤ} (hC5 : C.val < 56) (hR5 : R.val < 56) (hC : ∀ k, F k C = [])
    (hw : C ∉ b.writes) (hR : F 0 R = (N : ℤ) :: lR) (hz : zsz (N : ℤ) ≤ Bb)
    (hb : ∀ k < N, Sp b (encK s (update (F k) C [(N : ℤ) - k]))
      (encK s (update (F (k + 1)) C [(N : ℤ) - k])) (c * kU Bb)) :
    Sp (.rep C (.reg R) b) (encK s (F 0)) (encK s (F N)) ((N * (c + 1) + 1) * kU Bb) := by
  have H := Sp.rep (n := .reg R) (B := Bb) (c := c * kU Bb) hC5 hC hw (clean_of_lt hR5)
    (isInt_encK hR) trivial (by simp only [Ex.Bnd, top_encK hR]; exact hz)
    (by simp only [Ex.eval, top_encK hR]) hb
  refine H.mono ?_
  have h1 := kU_ge Bb
  simp only [Ex.size]
  generalize kU Bb = K at h1 ⊢
  have h4 : 8000 * (Bb + 2) + 30 ≤ K := by omega
  have h5 : c * K + 8000 * (Bb + 2) + 30 ≤ (c + 1) * K := by
    have : (c + 1) * K = c * K + K := by ring
    linarith
  have h2 : N * (c * K + 8000 * (Bb + 2) + 30) ≤ N * ((c + 1) * K) := Nat.mul_le_mul_left _ h5
  have h3 : (N * (c + 1) + 1) * K = N * ((c + 1) * K) + K := by ring
  rw [h3]; linarith

/-! ## Counting -/

theorem cnt_acc (g : ℕ → ℤ) (hg : ∀ x, 0 ≤ g x ∧ g x ≤ 1) (N : ℕ) :
    ∀ k, 0 ≤ accSeq (sumG g N) 0 k ∧ accSeq (sumG g N) 0 k ≤ k
  | 0 => by simp [accSeq]
  | k + 1 => by
    have := cnt_acc g hg N k
    have := hg (N - k)
    simp only [accSeq, sumG]; push_cast; constructor <;> linarith

theorem sp_cnt_sol_aux (s : IState HS) (f : Fin HS → List ℤ) (C rd R : Fin HS) (tst : Ex HS)
    (Pr : ℕ → Prop) [DecidablePred Pr] (N Bb : ℕ) (lR : List ℤ)
    (hC5 : C.val < 56) (hd5 : rd.val < 56) (hR5 : R.val < 56) (hCd : C ≠ rd) (hRd : R ≠ rd)
    (hRC : R ≠ C) (hfC : f C = []) (hfR : f R = (N : ℤ) :: lR) (hz : zsz ((N + 1 : ℕ) : ℤ) ≤ Bb)
    (htc : tst.Clean)
    (htst : ∀ x, 1 ≤ x → x ≤ N → ∀ acc : ℤ, 0 ≤ acc → acc ≤ N →
      tst.ok (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) ∧
      (tst.eval (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) < 0 ↔ Pr x) ∧
      tst.Bnd (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) Bb) :
    Sp (cntR C rd R tst) (encK s f)
      (encK s (update f rd ((∑ x ∈ Icc 1 N, if Pr x then (1 : ℤ) else 0) :: f rd)))
      ((N * (tst.size + 7) + 3) * kU Bb) := by
  set g : ℕ → ℤ := fun x => if Pr x then 1 else 0 with hg
  have hg01 : ∀ x, 0 ≤ g x ∧ g x ≤ 1 := fun x => by simp only [hg]; split_ifs <;> norm_num
  have h1 : Sp (.push rd (.lit 0)) (encK s f) (encK s (update f rd (0 :: f rd)))
      (((Ex.lit 0 : Ex HS).size + 1) * kU Bb) :=
    sp_push hd5 (clean_lit 0) trivial rfl (by simp [Ex.Bnd, zsz_zero])
  set F : ℕ → Fin HS → List ℤ := fun k => update f rd (accSeq (sumG g N) 0 k :: f rd) with hF
  have hFC : ∀ k, F k C = [] := fun k => by simp only [hF]; rw [update_of_ne hCd, hfC]
  have hFR : F 0 R = (N : ℤ) :: lR := by simp only [hF]; rw [update_of_ne hRd, hfR]
  have hB1 : 1 ≤ Bb := by
    have h := zsz_mono (show (1 : ℤ).natAbs ≤ ((N + 1 : ℕ) : ℤ).natAbs by
      rw [Int.natAbs_natCast]; simp)
    rw [zsz_one] at h; omega
  have hzN : zsz (N : ℤ) ≤ Bb := le_trans (zsz_mono (by
    rw [Int.natAbs_natCast, Int.natAbs_natCast]; omega)) hz
  have h2 : Sp (.rep C (.reg R) (.asg rd (.add (.reg rd) (.sel tst (.lit 1) (.lit 0)))))
      (encK s (F 0)) (encK s (F N)) ((N * ((tst.size + 6) + 1) + 1) * kU Bb) := by
    refine sp_rep hC5 hR5 hFC (by simp [RS.writes, hCd]) hFR hzN ?_
    intro k hk
    set acc := accSeq (sumG g N) 0 k with hacc
    have hab := cnt_acc g hg01 N k
    set x := N - k with hx
    have hxz : ((N : ℤ) - k) = (x : ℤ) := by omega
    rw [hxz]
    have st : update (F k) C [(x : ℤ)] = update (update f rd (acc :: f rd)) C [(x : ℤ)] := rfl
    rw [st]
    obtain ⟨tok, tev, tB⟩ := htst x (by omega) (by omega) acc hab.1 (by omega)
    have hrd : update (update f rd (acc :: f rd)) C [(x : ℤ)] rd = acc :: f rd := by
      rw [update_of_ne hCd.symm, update_self]
    have hgx : (if tst.eval (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) < 0
        then (1 : ℤ) else 0) = g x := by
      simp only [hg]; by_cases hp : Pr x
      · rw [if_pos (tev.2 hp), if_pos hp]
      · rw [if_neg (fun h => hp (tev.1 h)), if_neg hp]
    have hz1 : zsz acc ≤ Bb := le_trans (zsz_mono (by omega)) hz
    have hz2 : zsz (acc + g x) ≤ Bb := le_trans (zsz_mono (by have := hg01 x; omega)) hz
    have hval : (Ex.add (.reg rd) (.sel tst (.lit 1) (.lit 0))).eval
        (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) = acc + g x := by
      simp only [Ex.eval, top_encK hrd]; rw [← hgx]
    have H := sp_asg (s := s) (Bb := Bb) (e := .add (.reg rd) (.sel tst (.lit 1) (.lit 0))) hd5 hrd
      hz1 (by
        intro j hj
        simp only [Ex.regs, List.mem_append, List.mem_singleton, List.nil_append,
          List.append_nil] at hj
        rcases hj with rfl | hj
        · exact not_zX_of_lt hd5
        · exact htc j hj)
      ⟨isInt_encK hrd, tok, by split_ifs <;> trivial⟩ hval
      ⟨by simp only [Ex.Bnd, top_encK hrd]; exact hz1, ⟨tB, by
        split_ifs
        · simp only [Ex.Bnd, zsz_one]; exact hB1
        · simp [Ex.Bnd, zsz_zero]⟩, by
          have e2 : zsz ((Ex.add (.reg rd) (.sel tst (.lit 1) (.lit 0))).eval
              (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)]))) ≤ Bb := by
            rw [hval]; exact hz2
          exact e2⟩
    refine (H.congr ?_).mono (le_of_eq ?_)
    · congr 1
      rw [update_comm hCd.symm, update_idem, update_comm hCd]
      rfl
    · simp only [Ex.size]; ring
  have h12 := h1.seq ((h2.congr_s (by simp [hF, accSeq])).congr (by
    simp only [hF]; rw [accSeq_sum, zero_add]))
  refine h12.mono (le_of_eq ?_)
  simp only [Ex.size]; ring

