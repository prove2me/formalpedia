      r.level.2.1.map (algebraMap ↥K (LaurentSeries ↥k₀)) = (ModularCurve.cuspData ↥k₀ (q * ℓ') (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ'.Prime).ne_zero)).unit ![(q : ZMod (q * ℓ')), 0] ![0, -(q : ZMod (q * ℓ'))]).variableChange C ∧

      (∃ Px Py Qx Qy : ↥K,
