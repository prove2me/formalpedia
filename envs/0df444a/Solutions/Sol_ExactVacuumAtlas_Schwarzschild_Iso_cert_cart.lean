open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.Iso

@[simp] theorem toCart_0 (x : Pt 4) : toCart x 0 = x 0 := rfl
@[simp] theorem toCart_1 (x : Pt 4) : toCart x 1 = x 1 * sin (x 2) * cos (x 3) := rfl
@[simp] theorem toCart_2 (x : Pt 4) : toCart x 2 = x 1 * sin (x 2) * sin (x 3) := rfl
@[simp] theorem toCart_3 (x : Pt 4) : toCart x 3 = x 1 * cos (x 2) := rfl

theorem rho_toCart {x : Pt 4} (hx : 0 < x 1) : rho (toCart x) = x 1 := by
  unfold rho
  simp only [toCart_1, toCart_2, toCart_3]
  have e : (x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      + (x 1 * cos (x 2)) ^ 2 = x 1 ^ 2 := by
    have h2 := sin_sq_add_cos_sq (x 2)
    have h3 := sin_sq_add_cos_sq (x 3)
    linear_combination (x 1 ^ 2 * sin (x 2) ^ 2) * h3 + (x 1 ^ 2) * h2
  rw [e]
  exact Real.sqrt_sq hx.le

theorem rxy_toCart {x : Pt 4} (hx : 0 < x 1) (hs : 0 < sin (x 2)) :
    rxy (toCart x) = x 1 * sin (x 2) := by
  unfold rxy
  simp only [toCart_1, toCart_2]
  have e : (x 1 * sin (x 2) * cos (x 3)) ^ 2 + (x 1 * sin (x 2) * sin (x 3)) ^ 2
      = (x 1 * sin (x 2)) ^ 2 := by
    have h3 := sin_sq_add_cos_sq (x 3)
    linear_combination (x 1 ^ 2 * sin (x 2) ^ 2) * h3
  rw [e]
  exact Real.sqrt_sq (by positivity)

end ExactVacuumAtlas.Schwarzschild.Iso

