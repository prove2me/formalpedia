lemma bucketList_ordered : bucketList.IsChain ReciprocalMassOrdered.ordered := by decide +kernel

def buckets : Finset Bucket := ReciprocalMassOrdered.finsetOfChain bucketList bucketList_ordered

lemma bucketList_eq : bucketList.toFinset = buckets :=
  ReciprocalMassOrdered.toFinset_eq_finsetOfChain bucketList bucketList_ordered

lemma positive : ∀ b ∈ buckets, 1 ≤ b.lower := by decide +kernel

lemma separated : ∀ a ∈ buckets, ∀ b ∈ buckets, a ≠ b →
    a.upper < b.lower ∨ b.upper < a.lower := by
  rw [← bucketList_eq]
  exact ReciprocalMassOrdered.disjoint_of_chain bucketList (by decide +kernel)

lemma valid_union (S : ℕ) (a b : Finset Bucket)
    (ha : Valid S a) (hb : Valid S b) : Valid S (a ∪ b) := by
  intro x hx
  rcases Finset.mem_union.mp hx with h | h
  · exact ha x h
  · exact hb x h

lemma masses_valid : Valid 100000000 buckets := by
  have ht : bucketList.toFinset = part_0 ∪ part_1 ∪ part_2 ∪ part_3 ∪ part_4 := by
    ext b
    simp only [bucketList, part_0, part_1, part_2, part_3, part_4,
      List.mem_toFinset, List.mem_cons, List.not_mem_nil, Finset.mem_union,
      Finset.mem_insert, Finset.mem_singleton, or_false, or_assoc]
  rw [← bucketList_eq, ht]
  exact valid_union 100000000 (part_0 ∪ part_1 ∪ part_2 ∪ part_3) part_4 (valid_union 100000000 (part_0 ∪ part_1 ∪ part_2) part_3 (valid_union 100000000 (part_0 ∪ part_1) part_2 (valid_union 100000000 (part_0) part_1 (PrimePairSieve.reciprocal_mass_table_50000_0) PrimePairSieve.reciprocal_mass_table_50000_1) PrimePairSieve.reciprocal_mass_table_50000_2) PrimePairSieve.reciprocal_mass_table_50000_3) PrimePairSieve.reciprocal_mass_table_50000_4

lemma log_29308 : Real.log (4*(29308:ℝ)) ≤ (116751/10000) := by
  have h := Real.log_div_le_sum_range_add (x := ((3231/11423):ℝ)) (by norm_num) (by norm_num) 2
  norm_num [Finset.sum_range_succ] at h
  have heq : Real.log (117232:ℝ) = 16*Real.log 2 + Real.log ((7327/4096):ℝ) := by
    rw [show (117232:ℝ) = 2^16*(7327/4096) by norm_num, Real.log_mul (by norm_num) (by norm_num), Real.log_pow]
    norm_num
  norm_num
  rw [heq]
  linarith [Real.log_two_lt_d9]

lemma cell_20000 (z : ℝ) (hl : 20000 ≤ z) (hu : z ≤ 29308) :
    Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant) /
      (1-((z+1)*(Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant))/(16*z^2))) ≤
      ∑ n ∈ Finset.Icc 1 ⌊z⌋₊, ReciprocalBatch.weight n/(1+(n:ℝ)/z) := by
  apply PrimePairSieve.reciprocal_interval_certificate_with_constant (131/100) 20000 29308 (116751/10000) z
    (by norm_num) PrimePairSieve.twin_prime_constant_lower_131 (by norm_num) hl hu log_29308 (by norm_num)
  have hi : endpointSum 20000 buckets = 5203491386 := by decide +kernel
  have hb := PrimePairSieve.reciprocal_mass_endpoint_sound 100000000 20000
    (by norm_num) (by norm_num) buckets positive separated masses_valid
  rw [hi] at hb
  have hr : ((116751/10000):ℝ)^2/(2*(131/100))/(1-((20000+1)/(16*20000^2))*((116751/10000)^2/(2*(131/100)))) ≤ (5203491386:ℝ)/100000000 := by norm_num
  simpa [ReciprocalBatch.weight] using hr.trans hb

