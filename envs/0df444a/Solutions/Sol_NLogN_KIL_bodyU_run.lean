theorem enc2_replicate (v : ℕ) : enc2 (List.replicate v 0) = List.replicate v 0 := by
  simp [enc2]

theorem sumS_enc2 (Y : ℕ → List (ZMod 2)) (v : ℕ) (l : List ℕ) :
    sumS (fun w => enc2 (Y w)) v l = enc2 (sumZ Y (List.replicate v 0) l) := by
  unfold sumS sumZ
  rw [← enc2_replicate]
  generalize List.replicate v (0 : ZMod 2) = a
  induction l generalizing a with
  | nil => rfl
  | cons w l ih => simp only [List.foldl_cons]; rw [zipWith_enc2, ih]

theorem length_sumZ (Y : ℕ → List (ZMod 2)) :
    ∀ (l : List ℕ) (a : List (ZMod 2)), (∀ w ∈ l, (Y w).length = a.length) →
      (sumZ Y a l).length = a.length
  | [], _, _ => rfl
  | w :: l, a, h => by
    simp only [sumZ, List.foldl_cons]
    have e : (List.zipWith (· + ·) a (Y w)).length = a.length := by
      simp [h w List.mem_cons_self]
    rw [← e]
    exact length_sumZ Y l _ (fun w' hw' => by rw [e]; exact h w' (List.mem_cons_of_mem _ hw'))

theorem getD_sumZ (Y : ℕ → List (ZMod 2)) (i : ℕ) :
    ∀ (l : List ℕ) (a : List (ZMod 2)), (∀ w ∈ l, (Y w).length = a.length) → i < a.length →
      (sumZ Y a l).getD i 0 = a.getD i 0 + (l.map fun w => (Y w).getD i 0).sum
  | [], a, _, _ => by simp [sumZ]
  | w :: l, a, h, hi => by
    have hw := h w List.mem_cons_self
    have e : (List.zipWith (· + ·) a (Y w)).length = a.length := by simp [hw]
    have IH := getD_sumZ Y i l (List.zipWith (· + ·) a (Y w))
      (fun w' hw' => by rw [e]; exact h w' (List.mem_cons_of_mem _ hw')) (by rw [e]; exact hi)
    simp only [sumZ, List.foldl_cons] at IH ⊢
    rw [IH, List.map_cons, List.sum_cons, ← add_assoc]
    congr 1
    rw [List.getD_eq_getElem _ _ (by rw [e]; exact hi), List.getElem_zipWith,
      List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ (by rw [hw]; exact hi)]

