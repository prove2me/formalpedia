lemma zip_range_eq {α : Type*} (ps : List α) (n : ℕ) (h : ps.length = n) (z : α) :
    (List.range n).zip ps = (List.range n).map fun i => (i, ps.getD i z) := by
  subst h
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp only [List.getElem_zip, List.getElem_map, List.getElem_range, List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_getElem (by simp at h1; omega)]; rfl

/-- The `y_S` increment of a centre block. -/
lemma centre_sum (sg : ℤ) (srcw : ℕ → ℕ) (Λ : ℕ → Vt) {S : ℕ} (hS : S < NV) :
    ((centreOps d sg srcw).map fun o => if o.1 = yw S then cf o • Λ o.2.1 else 0).sum =
      ((centreL (d.tv S)).map fun p => (((sg * p.2 : ℤ) : ℂ) / 2) • Λ (srcw p.1)).sum := by
  unfold centreOps
  rw [List.map_flatMap, sum_flatMap]
  rw [sum_range_single _ NV hS]
  · simp only [List.map_map]
    congr 1
    apply List.map_congr_left
    intro p _
    simp [cf]
  · intro i _ hne
    simp only [List.map_map]
    apply sum_zero_of
    intro p _
    simp only [Function.comp, if_neg (fun h => hne (yw_inj h))]

/-- The `y_S` increment of a piece block. -/
lemma inj_sum (hlen : d.pieces.length = NV) (sg : ℤ) (Λ : ℕ → Vt) {S : ℕ} (hS : S < NV) :
    ((injOps d sg).map fun o => if o.1 = yw S then cf o • Λ o.2.1 else 0).sum =
      ((d.pieces.getD S []).map fun p => (((sg * p.2 : ℤ) : ℂ) / 2) • Λ (aw p.1)).sum := by
  unfold injOps
  rw [zip_range_eq _ _ hlen [], List.flatMap_map, List.map_flatMap, sum_flatMap]
  rw [sum_range_single _ NV hS]
  · simp only [pieceOpsS, List.map_map]
    congr 1
    apply List.map_congr_left
    intro p _
    simp [cf]
  · intro i _ hne
    simp only [pieceOpsS, List.map_map]
    apply sum_zero_of
    intro p _
    simp only [Function.comp, if_neg (fun h => hne (yw_inj h))]

lemma list_sum_range {β : Type*} [AddCommMonoid β] (f : ℕ → β) :
    ∀ n, ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i
  | 0 => rfl
  | n + 1 => by rw [List.range_succ, List.map_append, List.sum_append, list_sum_range f n,
      Finset.sum_range_succ]; simp

lemma list_sum_finset {α : Type*} (L : List α) (c : α → ℂ) (I : Finset ℕ) (f : α → ℕ → Vt) :
    (L.map fun p => c p • ∑ i ∈ I, f p i).sum = ∑ i ∈ I, (L.map fun p => c p • f p i).sum := by
  induction L with
  | nil => simp
  | cons p L ih => rw [List.map_cons, List.sum_cons, ih, Finset.smul_sum, ← Finset.sum_add_distrib]; simp

lemma list_sum_smul {α : Type*} (L : List α) (g : α → ℂ) (v : Vt) :
    (L.map fun p => g p • v).sum = (L.map g).sum • v := by
  induction L with
  | nil => simp
  | cons p L ih => simp only [List.map_cons, List.sum_cons, ih, add_smul]

/-! ## Junk functions and the gate block -/

lemma slotOps_mem {gl : List (ℕ × ℕ)} {o : ℕ × ℕ × ℤ} (h : o ∈ slotOps gl) :
    ∃ p ∈ gl, o = (aw p.1, aw p.2, 2) := by
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h; exact ⟨p, hp, rfl⟩

lemma negOps_mem {l : List (ℕ × ℕ × ℤ)} {o : ℕ × ℕ × ℤ} (h : o ∈ negOps l) :
    ∃ o' ∈ l, o = (o'.1, o'.2.1, -o'.2.2) := by
  unfold negOps at h
  obtain ⟨o', ho', rfl⟩ := List.mem_map.1 (List.mem_reverse.1 h); exact ⟨o', ho', rfl⟩

lemma runL_G_junk {gl : List (ℕ × ℕ)} (hg : GOK gl) (Λ J : ℕ → Vt) (hJ : OffA J) :
    runL (slotOps gl) (Λ + J) = runL (slotOps gl) Λ + J := by
  rw [runL_add, runL_fix (slotOps gl) J]
  intro o ho
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho
  exact ⟨hJ _ (hg p hp).1, hJ _ (hg p hp).2.1⟩

lemma runL_nG_junk {gl : List (ℕ × ℕ)} (hg : GOK gl) (Λ J : ℕ → Vt) (hJ : OffA J) :
    runL (negOps (slotOps gl)) (Λ + J) = runL (negOps (slotOps gl)) Λ + J := by
  rw [runL_add, runL_fix (negOps (slotOps gl)) J]
  intro o ho
  obtain ⟨o', ho', rfl⟩ := negOps_mem ho
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho'
  exact ⟨hJ _ (hg p hp).1, hJ _ (hg p hp).2.1⟩

lemma runL_G_inv {gl : List (ℕ × ℕ)} (hg : GOK gl) (Λ : ℕ → Vt) :
    runL (negOps (slotOps gl)) (runL (slotOps gl) Λ) = Λ := by
  apply runL_neg
  intro o ho
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho
  exact fun h => (hg p hp).2.2 (aw_inj h)

lemma runL_G_off {gl : List (ℕ × ℕ)} (hg : GOK gl) (Λ : ℕ → Vt) (w : ℕ) (hw : ∀ q < NR, w ≠ aw q) :
    runL (slotOps gl) Λ w = Λ w := by
  apply runL_untouched
  intro h
  obtain ⟨o, ho, rfl⟩ := List.mem_map.1 h
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho
  exact hw _ (hg p hp).1 rfl

