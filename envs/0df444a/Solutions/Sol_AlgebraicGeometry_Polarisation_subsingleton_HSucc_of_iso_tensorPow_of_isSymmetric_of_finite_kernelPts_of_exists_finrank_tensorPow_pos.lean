def tensorPowAddIso {X : Scheme.{0}} (L : X.Modules) (a : ℕ) :
    (b : ℕ) → (L.tensorPow (a + b) ≅ L.tensorPow a ⊗ L.tensorPow b)
  | 0 => (ρ_ (L.tensorPow a)).symm
  | b + 1 => whiskerRightIso (tensorPowAddIso L a b) L ≪≫ α_ _ _ _

def tensorPowMulIso {X : Scheme.{0}} (L : X.Modules) (a : ℕ) :
    (b : ℕ) → (L.tensorPow (a * b) ≅ (L.tensorPow a).tensorPow b)
  | 0 => Iso.refl _
  | b + 1 => tensorPowAddIso L (a * b) a ≪≫ whiskerRightIso (tensorPowMulIso L a b) (L.tensorPow a)

def tensorPowMapIso {X : Scheme.{0}} {L L' : X.Modules} (e : L ≅ L') : (s : ℕ) → (L.tensorPow s ≅ L'.tensorPow s)
  | 0 => Iso.refl _
  | s + 1 => tensorIso (tensorPowMapIso e s) e

def tensorPowResidueIso {X : Scheme.{0}} (L : X.Modules) (r c t : ℕ) :
    L.tensorPow r ⊗ (L.tensorPow c).tensorPow t ≅ L.tensorPow (r + c * t) :=
  (whiskerLeftIso (L.tensorPow r) (tensorPowMulIso L c t).symm) ≪≫ (tensorPowAddIso L r (c * t)).symm

end Ws23P5

