-- title:
--   Definitions for Connections on non-abelian Gerbes and their Holonomy
-- statement:
--   The objects the formalized statements of *Connections on non-abelian Gerbes and their Holonomy* (arXiv:0808.1923) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `actionCommutatorSubgroup`: Section 5.2, PDF p. 50: the ordinary subgroup generated by `h⁻¹ * alpha(g,h)`. This is neither topological nor closed normal generation.
--   - `trivialAction`: Example 5.2.3(a), PDF p. 50: the action of the trivial structure group.
--   - `circleAutomorphismAction`: Example 5.2.3(c), PDF p. 50: the two circle automorphisms, in the additive `ZMod 2` coordinates for the automorphism group.
-- source:
--   Connections on non-abelian Gerbes and their Holonomy, arXiv:0808.1923v3, https://arxiv.org/abs/0808.1923v3

import Mathlib
import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P18

/-!
Statements from Schreiber--Waldorf, arXiv:0808.1923v3, PDF p. 50.
The other planned nodes are explicitly deferred in the unit's HARD.md and GAPS.json.
The imported crossed-module predicate is algebraic; the statements below retain
finite-dimensional smooth Lie-group hypotheses separately.
-/

namespace QAlgorithms.Papers.Independent.Bridge50.P09

open scoped Manifold ContDiff

/-- Section 5.2, PDF p. 50: the ordinary subgroup generated by
`h⁻¹ * alpha(g,h)`. This is neither topological nor closed normal generation. -/
def actionCommutatorSubgroup {G H : Type*} [Group H]
    (alpha : G → H → H) : Subgroup H :=
  Subgroup.closure {x | ∃ (g : G) (h : H), x = h⁻¹ * alpha g h}

/-- Example 5.2.3(a), PDF p. 50: the action of the trivial structure group. -/
def trivialAction {A : Type*} (_ : PUnit) (a : A) : A := a

/-- Sanity: trivial groups generate only the identity subgroup. -/
example : actionCommutatorSubgroup (trivialAction (A := PUnit)) = ⊥ := by
  apply le_antisymm
  · apply (Subgroup.closure_le (⊥ : Subgroup PUnit)).2
    rintro x ⟨g, h, rfl⟩
    simp [trivialAction]
  · exact bot_le

/-- Example 5.2.3(c), PDF p. 50: the two circle automorphisms, in the
additive `ZMod 2` coordinates for the automorphism group. -/
noncomputable def circleAutomorphismAction (a : ZMod 2) (z : Circle) : Circle :=
  if a = 0 then z else z⁻¹

/-- Sanity: the zero automorphism label acts as the identity. -/
example (z : Circle) : circleAutomorphismAction 0 z = z := by
  simp [circleAutomorphismAction]

/-- Sanity: the nonzero automorphism label acts as inversion. -/
example (z : Circle) : circleAutomorphismAction 1 z = z⁻¹ := by
  simp [circleAutomorphismAction]

end QAlgorithms.Papers.Independent.Bridge50.P09


