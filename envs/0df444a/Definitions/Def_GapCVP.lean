    GapCVP.Factor400BinaryConstructiveSourcePlaces.sourceFormulaGrid
      encodingLength formula
  let field :=
    GapCVP.Factor400BinaryConstructiveSourcePlaces.sourceFormulaField
      encodingLength formula
