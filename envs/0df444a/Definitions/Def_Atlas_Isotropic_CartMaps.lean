set_option maxHeartbeats 4000000

/-!
# Isotropic Schwarzschild: spherical → Cartesian map, its Jacobian and the pull-back (ATLAS-II)

`toCart (t, ρ, θ, φ) = (t, ρ sinθ cosφ, ρ sinθ sinφ, ρ cosθ)` on the chart domain
`domIsoChart M = domIso M ∩ {−π < φ < π}`, with image in the slit domain
`domCartSlit M = {ρ > 0, ρ ≠ M/2, r_xy + x > 0}` (`r_xy = √(x² + y²)`; `r_xy + x > 0` is exactly
"off the closed half-plane `y = 0, x ≤ 0`"). Explicit Jacobian `jacCart` with `det = ρ² sinθ`, and the
pull-back identity `Jᵀ gIsoCart(toCart x) J = gIso x`. The inverse map lives in `CartChart.lean`.
-/

open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.Iso

/-- Spherical → Cartesian. -/
noncomputable def toCart (x : Pt 4) : Pt 4 :=
  ![x 0, x 1 * sin (x 2) * cos (x 3), x 1 * sin (x 2) * sin (x 3), x 1 * cos (x 2)]

/-- `r_xy = √(x² + y²)`. -/
noncomputable def rxy (y : Pt 4) : ℝ := Real.sqrt (y 1 ^ 2 + y 2 ^ 2)

/-- Spherical chart domain `domIso M ∩ {−π < φ < π}`. -/
def domIsoChart (M : ℝ) : Set (Pt 4) := {x | x ∈ domIso M ∧ -π < x 3 ∧ x 3 < π}

/-- Cartesian slit domain: `ρ > 0`, `ρ ≠ M/2`, `r_xy + x > 0`. -/
def domCartSlit (M : ℝ) : Set (Pt 4) := {y | 0 < rho y ∧ rho y ≠ M / 2 ∧ 0 < rxy y + y 1}

/-- Jacobian of `toCart` (rows `t, x, y, z`; columns `t, ρ, θ, φ`). -/
noncomputable def jacCart (x : Pt 4) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![1, 0, 0, 0;
     0, sin (x 2) * cos (x 3), x 1 * cos (x 2) * cos (x 3), -(x 1 * sin (x 2) * sin (x 3));
     0, sin (x 2) * sin (x 3), x 1 * cos (x 2) * sin (x 3), x 1 * sin (x 2) * cos (x 3);
     0, cos (x 2), -(x 1 * sin (x 2)), 0]

end ExactVacuumAtlas.Schwarzschild.Iso


