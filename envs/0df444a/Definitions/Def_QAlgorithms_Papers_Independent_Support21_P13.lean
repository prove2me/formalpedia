import Definitions.Def_QAlgorithms_Defs_Circuit
import Definitions.Def_QAlgorithms_Defs_Fourier

/-!
Statements from Kliuchnikov, Maslov and Mosca, arXiv:1206.5236v4.
All arithmetic below is exact complex arithmetic. The main H/T results preserve
absolute phase. The source's separate Appendix-B phase convention is not imposed
on them. See HARD.md for the inventoried conjecture, defective assertions, and
output/resource interfaces deferred by this drafting stage.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/- PDF p.3: use the imported gateT lower diagonal entry directly for omega. -/

/-- The actual complex subring Z[1/sqrt(2),i], PDF pp.2,6. -/
def synthesisRing : Subring ℂ :=
  Subring.closure ({((Real.sqrt 2 : ℝ) : ℂ)⁻¹, Complex.I} : Set ℂ)

/-- The cyclotomic integer subring Z[omega], PDF p.6. -/
def integralRing : Subring ℂ := Subring.closure ({(QAlgorithms.gateT true true)} : Set ℂ)

/-- Omega as a cyclotomic integer, PDF p.6. -/
def omegaInteger : integralRing :=
  ⟨(QAlgorithms.gateT true true), Subring.subset_closure (by simp)⟩

/-- sqrt(2) = omega - omega^3 in Z[omega], PDF p.20, equation (15). -/
def sqrtTwoInteger : integralRing := omegaInteger - omegaInteger ^ 3

/-- Finite least-exponent graph, Definition 1, PDF p.6. Signed integer exponents
are retained; zero has no finite least exponent because every exponent clears it. -/
def IsSDE (z : ℂ) (d : ℤ) : Prop :=
  z * ((Real.sqrt 2 : ℝ) : ℂ) ^ d ∈ integralRing ∧
    ∀ e : ℤ, z * ((Real.sqrt 2 : ℝ) : ℂ) ^ e ∈ integralRing → d ≤ e

/-- Greatest dividing exponent in Z[omega], Definition 2, PDF p.6.
Outside Z[omega] this helper returns infinity; every theorem uses it only on
cyclotomic integers (including squared norms of such integers). -/
def gde (z : ℂ) : ℕ∞ :=
  if hz : z ∈ integralRing then emultiplicity sqrtTwoInteger (⟨z, hz⟩ : integralRing)
  else ⊤

/-- Same valuation with explicit base 2, PDF pp.20-21. -/
def gdeTwo (z : ℂ) : ℕ∞ :=
  if hz : z ∈ integralRing then emultiplicity (2 : integralRing) (⟨z, hz⟩ : integralRing)
  else ⊤

/-- Squared ordinary complex modulus, embedded back into C, PDF p.6. -/
def normSquared (z : ℂ) : ℂ := (Complex.normSq z : ℂ)

/-- Divisibility with quotient in Z[omega], never divisibility in the field C,
PDF p.6. The bases occurring below are sqrt(2) and 2. -/
def DividesIntegral (b z : ℂ) : Prop := ∃ q : integralRing, z = b * (q : ℂ)

/-- Floor of half an extended natural valuation, PDF p.10. Infinity stays infinity. -/
def halfValuation (v : ℕ∞) : ℕ∞ :=
  if v = ⊤ then ⊤ else ((v.toNat / 2 : ℕ) : ℕ∞)

/-- The ordered omega-power coordinates of a cyclotomic integer, PDF pp.6,12. -/
def coordinateValue (a : Fin 4 → ℤ) : ℂ :=
  (a 0 : ℂ) + (a 1 : ℂ) * (QAlgorithms.gateT true true) + (a 2 : ℂ) * (QAlgorithms.gateT true true) ^ 2 + (a 3 : ℂ) * (QAlgorithms.gateT true true) ^ 3

/-- Quadratic form P, PDF p.12, equation (12). -/
def formP (a : Fin 4 → ℤ) : ℤ := a 0 ^ 2 + a 1 ^ 2 + a 2 ^ 2 + a 3 ^ 2

/-- Quadratic form Q, PDF p.12, equation (13). -/
def formQ (a : Fin 4 → ℤ) : ℤ := a 0 * (a 1 - a 3) + a 2 * (a 1 + a 3)

/-- Single-qubit instructions of Theorem 1, PDF p.2. No ancillary wire or phase letter. -/
inductive HTLetter where
  | h | t
  deriving DecidableEq

/-- Exact matrices from PDF pp.1-2. -/
def htMatrix : HTLetter → Matrix Bool Bool ℂ
  | .h => QAlgorithms.hadamard
  | .t => QAlgorithms.gateT

/-- Chronological H/T words: the head acts first, PDF pp.2,5. -/
def htWordMatrix (c : List HTLetter) : Matrix Bool Bool ℂ :=
  (c.map htMatrix).reverse.prod

/-- Membership of every matrix entry in the synthesis ring, PDF p.2. -/
def EntriesInRing {ι : Type*} (U : Matrix ι ι ℂ) : Prop :=
  ∀ a b, U a b ∈ synthesisRing

/-- The multi-qubit Clifford/T generators named on PDF pp.1,3. GateApp supplies
an ordered tuple of distinct wires, so either CNOT orientation is allowed. -/
def cliffordTLibrary : Set QAlgorithms.Gate :=
  {QAlgorithms.Gate.ofMatrix1 QAlgorithms.hadamard,
   QAlgorithms.Gate.ofMatrix1 QAlgorithms.phaseS,
   QAlgorithms.Gate.ofMatrix1 QAlgorithms.gateT,
   QAlgorithms.Gate.ofMatrix2 QAlgorithms.cnot}

/-- Controlled-T in the shared two-wire register convention, PDF p.3. -/
def controlledT : Matrix (QAlgorithms.Qubits 2) (QAlgorithms.Qubits 2) ℂ :=
  (QAlgorithms.Gate.ofMatrix2 (QAlgorithms.controlled QAlgorithms.gateT)).mat

/-- The unitary completion displayed on PDF pp.4-5. -/
def phaseCompletion (z w : ℂ) (k : ℤ) : Matrix Bool Bool ℂ :=
  fun a b => if a then (if b then star z * (QAlgorithms.gateT true true) ^ k else w)
    else (if b then -star w * (QAlgorithms.gateT true true) ^ k else z)

/-- Breadth-first H/T word level, PDF p.7. This enumerates words, not a table
whose correctness is supplied as a premise. -/
def wordsAt : ℕ → List (List HTLetter)
  | 0 => [[]]
  | n + 1 => (wordsAt n).flatMap fun c => [c ++ [.h], c ++ [.t]]

/-- First BFS level containing a matrix, PDF pp.7-8. The fallback 0 is used only
when no exact word exists. Synthesis correctness establishes that this fallback
is never used on a valid base-table input. -/
def baseDepth (U : Matrix Bool Bool ℂ) : ℕ :=
  if h : ∃ n : ℕ, ∃ c ∈ wordsAt n, htWordMatrix c = U then Nat.find h else 0

/-- BFS lookup at its first successful level, PDF pp.7-8. Restricting this function
to height at most 3 is the fixed small-height table; its existence and a uniform
finite BFS cutoff are conclusions of algorithm1_correct, not assumptions. -/
def baseWord (U : Matrix Bool Bool ℂ) : List HTLetter :=
  ((wordsAt (baseDepth U)).find? fun c => decide (htWordMatrix c = U)).getD []

/-- Finite signed exponent when it exists, PDF p.6. The fallback 0 is deliberately
not used in the valuation lemmas, which state the least-exponent graph directly. -/
def finiteExponent (z : ℂ) : ℤ :=
  if h : ∃ d : ℤ, IsSDE z d then Classical.choose h else 0

/-- Squared-entry matrix height of PDF p.7. A zero upper-left entry is the
explicit monomial special case and has height 0, without taking sde(0). -/
def matrixHeight (U : Matrix Bool Bool ℂ) : ℕ :=
  if U false false = 0 then 0 else (finiteExponent (normSquared (U false false))).toNat

/-- One reduction, PDF pp.7-8: V becomes H T^(-k) V. -/
def reduction (U : Matrix Bool Bool ℂ) (k : ℕ) : Matrix Bool Bool ℂ :=
  QAlgorithms.hadamard * star (QAlgorithms.gateT ^ k) * U

/-- Guarded search through k=0,1,2,3 once each, PDF pp.7-8. -/
def reductionChoice (U : Matrix Bool Bool ℂ) : Option ℕ :=
  ([0, 1, 2, 3] : List ℕ).find? fun k => decide (matrixHeight (reduction U k) + 1 = matrixHeight U)

/-- Finite recursion implementing the intended Algorithm 1, PDF pp.7-8.
Printed: an inner `while state=unfound` repeats an unchanged failing test.
Changed: one guarded test per k, as the surrounding p.7 proof requires.
The chronological suffix [H,T,...,T] reconstructs the right inverse of
H T^(-k); residual output therefore precedes that suffix. Exhausted fuel or
no reducing k falls back to BFS; these branches are unreachable above height 3
on a valid input started with its height as fuel. This repair needs independent moderation. -/
def synthesisFuel : ℕ → Matrix Bool Bool ℂ → List HTLetter
  | 0, U => baseWord U
  | fuel + 1, U =>
      if matrixHeight U ≤ 3 then baseWord U
      else match reductionChoice U with
        | none => baseWord U
        | some k => synthesisFuel fuel (reduction U k) ++ [.h] ++ List.replicate k .t

/-- Algorithm 1 with enough fuel for every height reduction, PDF pp.7-8.
Exact equality/comparison on the algebraic input is modeled classically here;
this interface makes no claim about the cost of operations on encodings. -/
def algorithm1 (U : Matrix Bool Bool ℂ) : List HTLetter :=
  synthesisFuel (matrixHeight U) U

/-- A finite execution of the intended Algorithm 1, PDF pp.7-8. Base acceptance
is the result of the actual BFS filter being nonempty; its truth is not an input
assumption of the synthesis theorem. Every reduction follows the guarded search,
and one input-independent bound B suffices for all base lookups. -/
inductive SynthesisTrace (B : ℕ) : Matrix Bool Bool ℂ → List HTLetter → Prop where
  | base {U : Matrix Bool Bool ℂ}
      (low : matrixHeight U ≤ 3) (depth : baseDepth U ≤ B)
      (hit : ((wordsAt (baseDepth U)).find? fun c => decide (htWordMatrix c = U)).isSome = true) :
      SynthesisTrace B U (baseWord U)
  | step {U : Matrix Bool Bool ℂ} {k : ℕ} {c : List HTLetter}
      (high : 3 < matrixHeight U) (choice : reductionChoice U = some k)
      (next : SynthesisTrace B (reduction U k) c) :
      SynthesisTrace B U (c ++ [.h] ++ List.replicate k .t)

example : htWordMatrix [] = 1 := rfl

example : htWordMatrix [.t, .h] = QAlgorithms.hadamard * QAlgorithms.gateT := by
  simp [htWordMatrix, htMatrix]

example : (omegaInteger : ℂ) = (QAlgorithms.gateT true true) := rfl

example : (sqrtTwoInteger : ℂ) = (QAlgorithms.gateT true true) - (QAlgorithms.gateT true true) ^ 3 := rfl

example : normSquared 0 = 0 := by simp [normSquared]

example : (0 : ℂ) ∈ synthesisRing := synthesisRing.zero_mem

example (d : ℤ) : ¬ IsSDE 0 d := by
  rintro ⟨_, hmin⟩
  have h := hmin (d - 1) (by simp)
  exact (not_le_of_gt (sub_lt_self d (show (0 : ℤ) < 1 by decide))) h

example : gde 0 = ⊤ := by
  rw [gde, dif_pos integralRing.zero_mem]
  exact emultiplicity_zero sqrtTwoInteger

example : gdeTwo 0 = ⊤ := by
  rw [gdeTwo, dif_pos integralRing.zero_mem]
  exact emultiplicity_zero (2 : integralRing)

example : DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) 0 := by
  exact ⟨0, by simp⟩

example : halfValuation ⊤ = ⊤ := by simp [halfValuation]

example : halfValuation (5 : ℕ∞) = 2 := by norm_num [halfValuation]

example : formP ![1, 0, 0, 0] = 1 ∧ formQ ![1, 0, 0, 0] = 0 := by
  decide

example : wordsAt 0 = [[]] := rfl

example : matrixHeight (0 : Matrix Bool Bool ℂ) = 0 := by simp [matrixHeight]

example (U : Matrix Bool Bool ℂ) : synthesisFuel 0 U = baseWord U := rfl

example (z w : ℂ) (k : ℤ) : phaseCompletion z w k false false = z := rfl

end QAlgorithms.Papers.Independent.Support21.P13


