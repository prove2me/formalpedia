    have : 1 + c.G 1 ≤ D + c.G D := by have := h.D1; omega
    have := Nat.mul_le_mul_left (c.Wr + 4) this
    omega
  have hpp : (1 + 1) ^ c.p ≤ c.Aw * (1 + 1) ^ c.p := Nat.le_mul_of_pos_left _ hc.Aw1
  have hZc := h.Wr_le_Zc
  have hZp := h.Zc_le_pow
  have hSr : S * r ≤ P * 2 ^ (K * D) * S * r := b2
  have hS : S ≤ S * r := Nat.le_mul_of_pos_right _ h.r1
  have hr : r ≤ S * r := Nat.le_mul_of_pos_left _ h.S1
  have hWN : c.Wr * (P * 2 ^ (K * D) * S * r) ≤ Zc c * (P * 2 ^ (K * D) * S * r) :=
    Nat.mul_le_mul_right _ (by omega)
  have hZN : Zc c * (P * 2 ^ (K * D) * S * r) ≤ 2 ^ Z * 2 ^ Z :=
    calc Zc c * (P * 2 ^ (K * D) * S * r) ≤ 2 ^ Z * (P * 2 ^ (K * D) * S * r) :=
          Nat.mul_le_mul_right _ hZp
      _ ≤ 2 ^ Z * 2 ^ Z := Nat.mul_le_mul_left _ (by omega)
  have hKD1 : K * (D - 1) ≤ K * D := Nat.mul_le_mul_left _ (by omega)
  have hP3 := h.pow3
