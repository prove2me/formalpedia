namespace DecrAlmostLinearSSSP.Decremental.CoreParameters
open Structured
lemma eval_code (b : Core) (K : ℝ) (s : Data) (h : InputCapture.Captured b.input s) (hK : s.realReg 442 = K) :
    ∃ t cost, Eval code s cost t ∧ InputCapture.Captured b.input t ∧ Values b K t ∧
      cost ≤ 4*⌈32*logarithm2 (b.input.size+1)/b.input.accuracy⌉₊+45 ∧
      t.realMem = s.realMem ∧ t.natMem = s.natMem := by
  let x := 32*logarithm2 (b.input.size+1)/b.input.accuracy
  have hh := headed_capture b.input s h
  obtain ⟨u,cost,he,hA,hAR,hcost⟩ := CoreCeiling.code_eval x (headed s) (headed_argument b s h) hh.unit
  have hu : InputCapture.Captured b.input u := hh.frame
    (fun j hj => he.nat_frame (CoreCeiling.nat_frame j (by omega)))
    (fun j hj => he.real_frame (CoreCeiling.real_frame j (by omega)))
  have huH : u.realReg 500 = H b := (he.real_frame (CoreCeiling.real_frame 500 (by decide))).trans (headed_H b s h)
  have huQ : u.realReg 502 = Q b := (he.real_frame (CoreCeiling.real_frame 502 (by decide))).trans (headed_Q b s h)
  have huK : u.realReg 442 = K := (he.real_frame (CoreCeiling.real_frame 442 (by decide))).trans
    (((header_eval s).real_frame (header_real_frame 442 (by decide))).trans hK)
  have huA : u.realReg 526 = A b := hAR
  have hv := finished_values b K u hu huH huQ huA huK
  have heval : Eval code s (18+(cost+23)) (finished u) :=
    Eval.seq (header_eval s) (Eval.seq he (finish_eval u))
  have hmem : NoMemory code := ⟨header_no_memory,CoreCeiling.no_memory,finish_no_memory⟩
  refine ⟨finished u,18+(cost+23),heval,finished_capture b.input u hu,hv,?_,
    (heval.no_memory hmem).1,(heval.no_memory hmem).2⟩
  dsimp [x] at hcost
  omega
end DecrAlmostLinearSSSP.Decremental.CoreParameters
