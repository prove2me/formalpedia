theorem CountingMatroid.Analysis.ProgramExchangeAcceptanceSubkernel.rational_accept_monotone {α : Type} (tape : ℕ → Bool) (trials : ℕ)
    (ratio : ℚ) (state candidate next : α) (start stop : ℕ)
    (h : rationalAccept tape trials ratio state candidate start = some (next, stop)) :
    start ≤ stop := by sorry
