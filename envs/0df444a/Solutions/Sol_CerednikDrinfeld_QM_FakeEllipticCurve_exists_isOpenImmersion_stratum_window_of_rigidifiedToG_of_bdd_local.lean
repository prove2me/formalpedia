    (hpow : ∀ ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E, (∃ k, deg ρ = q ^ k) ∧ (∃ k', deg' ρ = q ^ k'))
    (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (Nc : ℕ) (hN : 2 * ρ.d ≤ Nc + 1) :
