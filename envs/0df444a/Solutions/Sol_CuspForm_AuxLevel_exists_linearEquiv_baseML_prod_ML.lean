variable (N : ℕ) [NeZero N] (S : Set ℕ) (r : ℕ) (𝒪 : Type) [CommRing 𝒪] [IsLocalRing 𝒪]
  (θ : ↥(CuspForm.heckeAlgebra N 2 S) →+* ResidueField 𝒪)
  (hc : OpComm N r S 𝒪)

local notation "𝕜" => IsLocalRing.ResidueField 𝒪
local notation "Γs" => CuspForm.AuxLevel.subgroup N r

