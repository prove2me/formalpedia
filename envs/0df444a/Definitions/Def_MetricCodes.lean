theorem bgg_range_eq_ker_of_coercive_add_adjoint_squares
    {E F G U V : Type*}
    [AddCommGroup E] [Module ℝ E]
    [AddCommGroup F] [Module ℝ F]
    [AddCommGroup G] [Module ℝ G]
    [AddCommGroup U] [Module ℝ U]
    [AddCommGroup V] [Module ℝ V]
    [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]
    [FiniteDimensional ℝ G]
    (cE : InnerProductSpace.Core ℝ E)
    (cF : InnerProductSpace.Core ℝ F)
    (cG : InnerProductSpace.Core ℝ G)
    (cU : InnerProductSpace.Core ℝ U)
    (cV : InnerProductSpace.Core ℝ V)
    (d : F →ₗ[ℝ] E) (dStar : E →ₗ[ℝ] F)
    (e : G →ₗ[ℝ] F) (eStar : F →ₗ[ℝ] G)
    (L : F →ₗ[ℝ] F)
    (B : F →ₗ[ℝ] U) (Bstar : U →ₗ[ℝ] F)
    (C : V →ₗ[ℝ] F) (Cstar : F →ₗ[ℝ] V)
    (hdStar : ∀ x : E, ∀ y : F,
      cF.inner (dStar x) y = cE.inner x (d y))
    (heStar : ∀ x : F, ∀ y : G,
      cG.inner (eStar x) y = cF.inner x (e y))
    (hBstar : ∀ x : U, ∀ y : F,
      cF.inner (Bstar x) y = cU.inner x (B y))
    (hCstar : ∀ x : F, ∀ y : V,
      cV.inner (Cstar x) y = cF.inner x (C y))
    (hchain : d.comp e = 0)
    (hdecomposition :
      dStar.comp d + e.comp eStar =
        L + Bstar.comp B + C.comp Cstar)
    (hL : ∀ x : F, x ≠ 0 → 0 < cF.inner x (L x)) :
    LinearMap.range e = LinearMap.ker d := by
  apply bgg_range_eq_ker_of_fischerCore_hodgeLaplacian_injective
    cE cF cG d dStar e eStar hdStar heStar hchain
  rw [hdecomposition]
  exact fischerCore_injective_of_coercive_add_adjoint_squares
    cU cF cV L B Bstar C Cstar hBstar hCstar hL
end
