section
-- Source module: NLogN.HSt1
/-!
# The recursive step, part 1: state frames, list loops (namespace `NLogN.ST`)

* `W s L`: the state `s` with the lists `L i` pushed on top of every stack `i`.
* `slLoop`: extracts the source lengths `sᵢ` from the CRT records (consuming them).
* `dropN` wrappers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.ST

open IntMul NLogN

/-! ## Frames -/

/-- `s` with `L i` pushed on top of each stack `i`. -/
def W (s : IState HS) (L : Fin HS → List Item) : IState HS :=
  ⟨fun i => L i ++ s.G i, s.ip, s.out⟩

@[simp] theorem W_G (s : IState HS) (L : Fin HS → List Item) (i : Fin HS) :
    (W s L).G i = L i ++ s.G i := rfl
@[simp] theorem W_ip (s : IState HS) (L : Fin HS → List Item) : (W s L).ip = s.ip := rfl
@[simp] theorem W_out (s : IState HS) (L : Fin HS → List Item) : (W s L).out = s.out := rfl

/-! ## Spec helpers -/

open NLogN.FW (Spec)

/-! ## Extracting the source lengths from the CRT records -/

abbrev sR : Fin HS := 4
abbrev sT : Fin HS := 41
abbrev sC : Fin HS := 43

def slBody : RM :=
  RM.seqL [.rs (.pop sR), .rs (.push NLogN.ST.sT (.reg sR)), .rs (.pop sR), .rs (.pop sR), .rs (.pop sR)]

/-- Consume `K` records `[a, x, b, c]` from stack `4`, collecting the `x`s on `41` (reversed). -/
def slLoop (K : ℕ) : RM := .rep sC (.lit K) slBody

/-- Second entries of 4-records. -/
def snd4 (r : List ℤ) : ℤ := r.getD 1 0

def Rec4 (r : List ℤ) : Prop := ∃ a x b c : ℤ, r = [a, x, b, c]

/-- The family of states of `slLoop`. -/
def slSt (w : IState HS) (rs : List (List ℤ)) (R4 : List Item) (k : ℕ) : IState HS :=
  (w.upd sR (ints (rs.drop k).flatten ++ R4)).upd NLogN.ST.sT (ints ((rs.take k).map snd4).reverse ++ w.G NLogN.ST.sT)

end NLogN.ST

end

section
-- Source module: NLogN.HSt2
/-!
# The recursive step, part 2: the Fermat level descriptors (namespace `NLogN.ST`)

`descLoop K` pushes `ints ((descs q.outerAxes 1).flatMap enc8)` onto stack `39`, reading
`r` (`47`), `r/2` (`48`), `K - dh` (`49`), `logOuter` (`51`), `fn` (`54`); scratch `41`, `19`,
counter `52`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.ST

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
open NLogN.FW (Spec Desc descs enc8)

/-! ## The descriptors as an explicit list -/

/-- `Σ_{a ≤ i < a + n} te i`. -/
def jsum (q : Params) (a n : ℕ) : ℕ := ((List.range' a n).map q.te).sum

/-- The descriptor of level `i` (outer axes `0 … n-1`, starting at `a`). -/
def dI (q : Params) (a n i : ℕ) : Desc :=
  (2 ^ jsum q a (i - a), q.te i, 2 * q.fn / 2 ^ q.te i, 2 ^ jsum q (i + 1) (a + n - (i + 1)))

/-! ## The loop -/

abbrev tR : Fin HS := 47
abbrev tRh : Fin HS := 48
abbrev tKd : Fin HS := 49
abbrev tLo : Fin HS := 51
abbrev tFn : Fin HS := 54
abbrev dX : Fin HS := 41
abbrev dB : Fin HS := 19
abbrev dC : Fin HS := 52
abbrev dO : Fin HS := 39

/-- `i < dh` test for `i = ctr - 1`: `ctr - 1 - K + (K - dh) < 0`. -/
def tcE (K : ℕ) : Ex HS := .add (.add (.reg dC) (.reg tKd)) (.lit (-1 - (K : ℤ)))

/-- `2^{te i}`. -/
def tE (K : ℕ) : Ex HS := .sel (tcE K) (.reg tRh) (.reg tR)

def preE : Ex HS := .ndiv (.pow2 (.reg tLo)) (.mul (.reg dX) (.reg NLogN.ST.dB))
def expE : Ex HS := .pow2 (.ndiv (.add (.reg tFn) (.reg tFn)) (.reg dX))

def dPush : List (Fin HS × Ex HS) :=
  [(dO, preE), (dO, .reg dX), (dO, expE), (dO, .reg NLogN.ST.dB), (dO, .reg NLogN.ST.dB), (dO, expE), (dO, .reg dX),
    (dO, preE)]

def dBody (K : ℕ) : RM :=
  RM.seqL [.rs (.push dX (tE K)), .rs (EX.pushes dPush), .rs (.asg NLogN.ST.dB (.mul (.reg NLogN.ST.dB) (.reg dX))),
    .rs (.pop dX)]

def descLoop (K : ℕ) : RM :=
  RM.seqL [.rs (.push NLogN.ST.dB (.lit 1)), .rep dC (.lit ((K : ℤ) - 1)) (dBody K), .rs (.pop NLogN.ST.dB)]

end NLogN.ST

end


