open ExactVacuumAtlas.Variation
variable {n : ℕ}
variable {U : Set (Pt n)} (hU : IsOpen U) {ξ : Fin n → Pt n → ℝ} (hξ : ∀ k, ContDiffOn ℝ ∞ (ξ k) U)
include hU hξ
theorem solution : IsOpen (shiftDom U ξ) := by
  have hS : IsOpen {p : ℝ × Pt n | p.2 ∈ U} := hU.preimage continuous_snd
  have hA : IsOpen ({p : ℝ × Pt n | p.2 ∈ U} ∩ (fun p : ℝ × Pt n => shiftMap ξ p.1 p.2) ⁻¹' U) :=
    (contDiffOn_shiftMap_joint hξ).continuousOn.isOpen_inter_preimage hS hU
  have hdet : ContinuousOn (fun p : ℝ × Pt n => (shiftJac ξ p.1 p.2).det) {p | p.2 ∈ U} :=
    (contDiffOn_det_of (A := fun p : ℝ × Pt n => shiftJac ξ p.1 p.2)
      fun k i => contDiffOn_shiftJac_joint hU hξ k i).continuousOn
  have hB := (hdet.mono Set.inter_subset_left).isOpen_inter_preimage hA (isOpen_compl_singleton (x := (0 : ℝ)))
  convert hB using 1
  ext p
  simp only [shiftDom, Set.mem_ofPred_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_compl_iff,
    Set.mem_singleton_iff, and_assoc]
