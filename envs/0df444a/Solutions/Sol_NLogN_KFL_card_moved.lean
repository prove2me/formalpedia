set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly Finset
variable {K ρ f : ℕ} {g : Geo}
theorem solution (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) :
    NLogN.KFL.nMv (NLogN.KFL.keyR K ρ f g) g.recG.V * 2 ^ K ≤ 80 * (f - 1) * g.recG.V := by
  set M := g.recG.V
  set bad := fun (n i : ℕ) => ¬ (10 ≤ Butterfly.guardN K ρ n i ∧ Butterfly.guardN K ρ n i + 11 ≤ 2 ^ (K - 1))
  have hsub : ((range M).filter fun m => NLogN.KFL.keyR K ρ f g m ≠ m) ⊆
      (range (f - 1)).biUnion fun i =>
        ((range M).filter fun m => bad (NLogN.KFL.gc g.Q g.recG.S1 m) i) ∪
        ((range M).filter fun m => bad (NLogN.KFL.gc g.Q g.recG.S2 m) i) := by
    intro m hm
    obtain ⟨hmM, hκ⟩ := Finset.mem_filter.1 hm
    have hb : NLogN.KFL.badR K ρ f g m := by
      intro hb
      apply hκ
      have := NLogN.KFL.keyR_corrR (K := K) (ρ := ρ) (f := f) hg hQe m
      rwa [NLogN.KFL.corrR_good hg hQe hK hρK hf (not_not.2 hb)] at this
    unfold NLogN.KFL.badR NLogN.KFL.good NLogN.KFL.trOf at hb
    simp only [NLogN.KFL.Geo.recG_Q, NLogN.KFL.guardOK_iff, not_and_or, not_forall] at hb
    rcases hb with ⟨i, hi, hb⟩ | ⟨i, hi, hb⟩
    · exact Finset.mem_biUnion.2 ⟨i, Finset.mem_range.2 hi,
        Finset.mem_union_left _ (Finset.mem_filter.2 ⟨hmM, by simpa only [bad, not_and_or] using hb⟩)⟩
    · exact Finset.mem_biUnion.2 ⟨i, Finset.mem_range.2 hi,
        Finset.mem_union_right _ (Finset.mem_filter.2 ⟨hmM, by simpa only [bad, not_and_or] using hb⟩)⟩
  rw [NLogN.KFL.nMv_card]
  calc ((range M).filter fun m => NLogN.KFL.keyR K ρ f g m ≠ m).card * 2 ^ K
      ≤ (∑ i ∈ range (f - 1), (((range M).filter fun m => bad (NLogN.KFL.gc g.Q g.recG.S1 m) i).card +
          ((range M).filter fun m => bad (NLogN.KFL.gc g.Q g.recG.S2 m) i).card)) * 2 ^ K := by
        apply Nat.mul_le_mul_right
        refine (card_le_card hsub).trans (card_biUnion_le.trans ?_)
        exact Finset.sum_le_sum fun i _ => card_union_le _ _
    _ = ∑ i ∈ range (f - 1), 80 * M := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi' := Finset.mem_range.1 hi
        have hpos := hg.recG
        rw [Nat.add_mul,
          NLogN.KFL.count_dig hK hρK hQe hi' g.recG.S1 (g.Q * g.N1 * g.N0) hpos.s1
            (by simp only [M, NLogN.KFL.Geo.V, NLogN.KFL.Geo.S0, NLogN.KFL.Geo.recG_Q, NLogN.KFL.Geo.recG_N0, NLogN.KFL.Geo.recG_N1]; ring),
          NLogN.KFL.count_dig hK hρK hQe hi' g.recG.S2 (g.N2 * g.Q * g.N1 * g.Q * g.N0) hpos.s2
            (by simp only [M, NLogN.KFL.Geo.V, NLogN.KFL.Geo.S0, NLogN.KFL.Geo.S1, NLogN.KFL.Geo.recG_Q, NLogN.KFL.Geo.recG_N0, NLogN.KFL.Geo.recG_N1, NLogN.KFL.Geo.recG_N2]; ring)]
        ring
    _ = 80 * (f - 1) * M := by rw [Finset.sum_const, card_range, smul_eq_mul]; ring
end
