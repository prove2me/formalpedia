theorem Q_transport_neg_shift_invariant
    {r : ℕ} [Fact r.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
    {E₁ V₁ : Type} [Fintype E₁] [DecidableEq V₁] {D₁ : DegeneracyData E₁ V₁}
    {T : Type} [AddCommGroup T] {galT : S →* AddAut T}
    {actZ : S →* (↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₁))}
    (𝒰' : EquivariantUniformization r D₁ A hA T S scalar actZ galT)
    [Fact (A.DecompositionIsometric ℚ)]
    (σ₀ : S) (hσ₀ : scalar σ₀ = 1)
    {ad bd : ℚ} (Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram (classSetDegeneracyData Rd nd) (e x) (e y) = ribbonGram D₁ x y)
    (hodd : ∀ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
      ((conjAct e actZ σ₀ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) :
        ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
        fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c))
    (x y x' y' : ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (hx' : (x' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
      fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c))
    (hy' : (y' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
      fun c => - (y : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) :
    (pdTransport 𝒰'.P e hiso).Q x' y' = (pdTransport 𝒰'.P e hiso).Q x y := by
  have hact : ∀ (σ : S) (w : ↥(ribbonKernel D₁)), e (actZ σ w) = conjAct e actZ σ (e w) := by
    intro σ w; rw [conjAct_apply, LinearEquiv.symm_apply_apply]
  let 𝒰S := euTransport 𝒰' e hiso (conjAct e actZ) hact
  have hx : x' = conjAct e actZ σ₀ x := Subtype.ext (by rw [hx', hodd x])
  have hy : y' = conjAct e actZ σ₀ y := Subtype.ext (by rw [hy', hodd y])
  have key := 𝒰S.Q_equiv σ₀ AlgEquiv.refl
    (by intro c; rw [hσ₀]; exact (one_smul (↥(A.decompositionSubgroup ℚ)) c).symm) x y
  show 𝒰S.P.Q x' y' = 𝒰S.P.Q x y
  rw [hx, hy]
  have hinjC : Function.Injective (fun k : Additive (↥𝒰S.K)ˣ =>
      (((Additive.toMul k : (↥𝒰S.K)ˣ) : ↥𝒰S.K) : A.valuation.Completion)) := by
    intro k k' h
    exact Additive.toMul.injective (Units.ext (Subtype.ext h))
  exact hinjC key.symm

theorem conjAct_eq_neg_shift
    {S : Type} [Group S] {E₁ V₁ : Type} [Fintype E₁] [DecidableEq V₁] {D₁ : DegeneracyData E₁ V₁}
    {actZ : S →* (↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₁))} (σ : S)
    {ad bd : ℚ} (Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (eE : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → E₁)
    (he_apply : ∀ (x : ↥(ribbonKernel D₁)) (c : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd))),
      ((e x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) c =
        (x : E₁ → ℤ) (eE c))
    (shiftE : E₁ → E₁) (hshiftE : ∀ c, eE (classSetShift _ nd c) = shiftE (eE c))
    (hσ : ∀ x : ↥(ribbonKernel D₁), ((actZ σ x : ↥(ribbonKernel D₁)) : E₁ → ℤ) = fun e' => - (x : E₁ → ℤ) (shiftE e'))
    (x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) :
    ((conjAct e actZ σ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) :
        ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
      fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c) := by
  funext c
  rw [conjAct_apply, he_apply, hσ]
  show -((e.symm x : ↥(ribbonKernel D₁)) : E₁ → ℤ) (shiftE (eE c)) = _
  rw [← hshiftE, ← he_apply, LinearEquiv.apply_symm_apply]

end Qinv
