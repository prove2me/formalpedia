  · obtain ⟨a, ha, hpos, hy⟩ := E8TAxisProd0271EndpointWitnesses.centerA_covers
    have hh := E8TAxisProd0271GraphCenterA.qJetBox_contains ha hpos
    rw [hy] at hh
    exact hh
