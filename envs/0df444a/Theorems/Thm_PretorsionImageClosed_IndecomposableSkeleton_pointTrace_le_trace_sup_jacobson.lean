-- title:
--   Indecomposable Skeleton: point Trace le trace sup jacobson
-- statement:
--   Substituting generation of `Y` by `C` and `X` into all maps
--   `Y → X` shows that the point trace of `Y` in `X` is generated by the
--   trace of `C` and the Jacobson radical of `End(X)`.
--
--   Source: https://github.com/haruhisa-enomoto/pretorsion-image-closed/blob/e803b5d1325bc1ce2b779efbff157b6cd3234bc8/PretorsionImageClosed/IndecomposableClosures/QuotientAntiExchange.lean#L158-L177
-- source:
--   https://github.com/haruhisa-enomoto/pretorsion-image-closed/blob/e803b5d1325bc1ce2b779efbff157b6cd3234bc8/PretorsionImageClosed/IndecomposableClosures/QuotientAntiExchange.lean#L158-L177

module
public import Definitions.Def_PretorsionImageClosed_IndecomposableClosures_EndomorphismRadical
public import Definitions.Def_PretorsionImageClosed_IndecomposableClosures_QuotientAntiExchange
set_option autoImplicit true
@[expose] public section
public section
noncomputable section
open Set
open CategoryTheory CategoryTheory.Limits
open PretorsionImageClosed PretorsionImageClosed.IndecomposableSkeleton
variable {R : Type u} [Ring R] [IsNoetherianRing R]
  {ι : Type v} (σ : IndecomposableSkeleton.{u, v, w} R ι)
attribute [local instance]
  HasFiniteBiproducts.of_hasFiniteCoproducts

theorem PretorsionImageClosed.IndecomposableSkeleton.pointTrace_le_trace_sup_jacobson
    (C : Set ι) {x y : ι} (hxy : x ≠ y)
    (hY :
      σ.trace C (σ.obj y) ⊔
        σ.pointTrace x (σ.obj y) = ⊤) :
    σ.pointTrace y (σ.obj x) ≤
      σ.trace C (σ.obj x) ⊔
        PretorsionImageClosed.idealRange
          (Ring.jacobson (Module.End R (σ.obj x))) := by sorry
