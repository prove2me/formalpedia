variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}

theorem rzE_zero : rzE E0 B 0 = E0 := by
  funext A μ y; simp [rzE]

theorem rzF_zero : rzF F0 f 0 = F0 := by
  funext i j y; simp [rzF]

theorem rzTh_eq_inv {ε : ℝ} {y : Pt 4} (hy : y ∈ U) (C μ : Fin 4) :
    rzTh U E0 Θ0 B ε C μ y = (frMat (rzE E0 B ε) y)⁻¹ C μ := by
  simp [rzTh, hy]

theorem rzGc_eq {ε : ℝ} (y : Pt 4) (μ ν : Fin 4) :
    rzGc U E0 Θ0 B ε μ ν y
      = ((coMat (rzTh U E0 Θ0 B ε) y)ᵀ * etaNull * coMat (rzTh U E0 Θ0 B ε) y) μ ν := by
  rw [quad_eta_apply]; rfl

theorem rzGIc_eq {ε : ℝ} (y : Pt 4) (μ ν : Fin 4) :
    rzGIc E0 B ε μ ν y = (frMat (rzE E0 B ε) y * etaNull * (frMat (rzE E0 B ε) y)ᵀ) μ ν := by
  rw [quad_eta_apply']; rfl

variable (hN : NullFrameData g0 gi0 E0 Θ0 U)
include hN

theorem rzTh_zero : rzTh U E0 Θ0 B 0 = Θ0 := by
  funext C μ y
  by_cases hy : y ∈ U
  · rw [rzTh_eq_inv hy, rzE_zero, Matrix.inv_eq_left_inv (hN.dual y hy)]; rfl
  · simp [rzTh, hy]

theorem cmat_eq_coMat {y : Pt 4} (hy : y ∈ U) :
    cmat g0 y = (coMat Θ0 y)ᵀ * etaNull * coMat Θ0 y := by
  have hc := hN.toFrameData.compl hy
  have hg := hN.gram y hy
  calc cmat g0 y = (frMat E0 y * coMat Θ0 y)ᵀ * cmat g0 y * (frMat E0 y * coMat Θ0 y) := by
        rw [hc]; simp
    _ = (coMat Θ0 y)ᵀ * ((frMat E0 y)ᵀ * cmat g0 y * frMat E0 y) * coMat Θ0 y := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = _ := by rw [← gramM, hg]

theorem rzG_zero : rzG U g0 E0 Θ0 B 0 = g0 := by
  funext μ ν y
  by_cases hy : y ∈ U
  · simp only [rzG, hy, if_true]
    rw [rzGc_eq, rzTh_zero hN, ← cmat_eq_coMat hN hy]
    simp [cmat, metricMatrix]
  · simp [rzG, hy]

theorem rzGI_zero : rzGI U gi0 E0 B 0 = gi0 := by
  funext μ ν y
  by_cases hy : y ∈ U
  · simp only [rzGI, hy, if_true]
    rw [rzGIc_eq, rzE_zero, ← hN.cmat_gi_eq hy]
    simp [cmat, metricMatrix]
  · simp [rzGI, hy]

theorem mem_rzW_zero {y : Pt 4} (hy : y ∈ U) : ((0 : ℝ), y) ∈ rzW U E0 B := by
  refine ⟨hy, ?_⟩
  rw [rzE_zero]
  exact Matrix.det_ne_zero_of_left_inverse (hN.dual y hy)

theorem slice_rzW_zero : {y | ((0 : ℝ), y) ∈ rzW U E0 B} = U := by
  ext y; exact ⟨fun h => h.1, fun hy => mem_rzW_zero hN hy⟩

end props

section family

variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}

variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht

theorem contDiffOn_rzE_joint (A μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzE E0 B p.1 A μ p.2) (rzW U E0 B) := by
  have hs : ∀ {φ : Pt 4 → ℂ}, ContDiffOn ℝ ∞ φ U → ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => φ p.2) (rzW U E0 B) :=
    fun hφ => hφ.comp contDiff_snd.contDiffOn fun p hp => hp.1
  have hfst : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => ((p.1 : ℝ) : ℂ)) (rzW U E0 B) :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn
  exact (hs (hN.smooth_E A μ)).add (hfst.mul (hs (ht.smooth_B A μ)))

theorem contDiffOn_rzTh_joint (C μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzTh U E0 Θ0 B p.1 C μ p.2) (rzW U E0 B) := by
  have hinv := contDiffOn_invC_of (A := fun p : ℝ × Pt 4 => frMat (rzE E0 B p.1) p.2) (s := rzW U E0 B)
    (fun ν A => by simpa only [frMat, Matrix.of_apply] using contDiffOn_rzE_joint hN ht A ν)
    (fun p hp => hp.2) C μ
  exact hinv.congr fun p hp => rzTh_eq_inv hp.1 C μ

theorem contDiffOn_rzG_joint (μ ν : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzG U g0 E0 Θ0 B p.1 μ ν p.2) (rzW U E0 B) := by
  have hc : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzGc U E0 Θ0 B p.1 μ ν p.2) (rzW U E0 B) := by
    simp only [rzGc]
    exact ContDiffOn.sum fun C _ => ContDiffOn.sum fun D _ =>
      ((contDiffOn_rzTh_joint hN ht C μ).mul contDiffOn_const).mul (contDiffOn_rzTh_joint hN ht D ν)
  exact (Complex.reCLM.contDiff.comp_contDiffOn hc).congr fun p hp => by
    simp [rzG, hp.1]

theorem contDiffOn_rzF_joint (hF0s : ∀ i j, ContDiffOn ℝ ∞ (F0 i j) U) (i j : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzF F0 f p.1 i j p.2) (rzW U E0 B) := by
  have hs : ∀ {φ : Pt 4 → ℝ}, ContDiffOn ℝ ∞ φ U → ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => φ p.2) (rzW U E0 B) :=
    fun hφ => hφ.comp contDiff_snd.contDiffOn fun p hp => hp.1
  exact (hs (hF0s i j)).add (contDiff_fst.contDiffOn.mul (hs (ht.smooth_f i j)))

/-- **The realisation family is an `NPFamily`.** -/
theorem rz_family (hR0 : RealPattern E0 U) (hF0s : ∀ i j, ContDiffOn ℝ ∞ (F0 i j) U)
    (hF0a : ∀ y ∈ U, ∀ i j, F0 i j y = -F0 j i y) :
    NPFamily (rzG U g0 E0 Θ0 B) (rzGI U gi0 E0 B) (rzF F0 f) (rzE E0 B) (rzTh U E0 Θ0 B) (rzW U E0 B) where
  fam :=
    { isOpen := isOpen_rzW hN ht
      smooth := contDiffOn_rzG_joint hN ht
      smooth_F := contDiffOn_rzF_joint hN ht hF0s
      inv := fun p hp => rz_inv hN ht hp hR0 }
  smooth_E := contDiffOn_rzE_joint hN ht
  smooth_Θ := contDiffOn_rzTh_joint hN ht
  null := rz_null hN ht hR0
  antisymm := fun p hp i j => by
    simp only [rzF, hF0a p.2 hp.1 i j, ht.antisymm_f p.2 hp.1 i j]; ring

omit hN ht in
theorem rz_hasDerivAt_E (y : Pt 4) (A μ : Fin 4) :
    HasDerivAt (fun ε => rzE E0 B ε A μ y) (B A μ y) 0 := by
  have := ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (B A μ y)).const_add (E0 A μ y)
  simpa [rzE] using this

omit hN ht in
theorem rz_hasDerivAt_F (y : Pt 4) (i j : Fin 4) :
    HasDerivAt (fun ε => rzF F0 f ε i j y) (f i j y) 0 := by
  have := ((hasDerivAt_id (0 : ℝ)).mul_const (f i j y)).const_add (F0 i j y)
  simpa [rzF] using this

/-- **Realisation theorem.** Every compatible real tangent `(h, f, B)` at a real-pattern null frame is the genuine
tangent at `ε = 0` of the realisation family, which is an `NPFamily` reducing to the background at `ε = 0`. -/
theorem realize (hR0 : RealPattern E0 U) (hF0s : ∀ i j, ContDiffOn ℝ ∞ (F0 i j) U)
    (hF0a : ∀ y ∈ U, ∀ i j, F0 i j y = -F0 j i y) :
    NPFamily (rzG U g0 E0 Θ0 B) (rzGI U gi0 E0 B) (rzF F0 f) (rzE E0 B) (rzTh U E0 Θ0 B) (rzW U E0 B) ∧
    NPTangent (rzG U g0 E0 Θ0 B) (rzF F0 f) (rzE E0 B) (rzW U E0 B) h f B ∧
    rzG U g0 E0 Θ0 B 0 = g0 ∧ rzGI U gi0 E0 B 0 = gi0 ∧ rzF F0 f 0 = F0 ∧ rzE E0 B 0 = E0 ∧
    rzTh U E0 Θ0 B 0 = Θ0 ∧ {y | ((0 : ℝ), y) ∈ rzW U E0 B} = U :=
  ⟨rz_family hN ht hR0 hF0s hF0a,
    { tangent :=
        { metric := fun y hy i j => rz_hasDerivAt_G hN ht hR0 hy.1 i j
          field := fun y _ i j => rz_hasDerivAt_F y i j }
      frame := fun y _ A μ => rz_hasDerivAt_E y A μ },
    rzG_zero hN, rzGI_zero hN, rzF_zero, rzE_zero, rzTh_zero hN, slice_rzW_zero hN⟩

end family

