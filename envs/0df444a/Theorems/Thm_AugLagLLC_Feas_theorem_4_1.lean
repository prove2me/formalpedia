-- title:
--   Theorem 4.1, p. 6 — bounded penalties give feasible limit points; otherwise the limit point is KKT for (4.1) or violates CPLD for Ω₂
-- statement:
--   Consider problem (2.1),
--   $$\text{Minimize } f(x)\ \text{ s.t. }\ h_1(x)=0,\ g_1(x)\le0,\ h_2(x)=0,\ g_2(x)\le0,$$
--   with continuously differentiable data, and let $\{x_k\}$ be a sequence generated by Algorithm 3.1 (the safeguarded PHR augmented Lagrangian method that penalizes the upper-level constraints $h_1,g_1$ and keeps the lower-level constraints $h_2,g_2$ in the subproblems), where Step 2 never fails. Let $x_*$ be a limit point of $\{x_k\}$. Then:
--
--   1. if the sequence of penalty parameters $\{\rho_k\}$ is bounded, $x_*$ is feasible, $x_*\in\Omega_1\cap\Omega_2$;
--   2. otherwise at least one of the following holds:
--      - (i) $x_*$ is a KKT point of the problem
--   $$\text{Minimize } \frac12\Big[\sum_{i=1}^{m_1}[h_1(x)]_i^2+\sum_{i=1}^{p_1}\max\{0,[g_1(x)]_i\}^2\Big]\ \text{ subject to } x\in\Omega_2; \tag{4.1}$$
--      - (ii) $x_*$ does not satisfy the CPLD constraint qualification associated with $\Omega_2$.
--
--   Roughly, an infeasible limit point is a stationary point of the upper-level infeasibility subject to the lower-level constraints, unless a degenerate lower-level constraint qualification failure occurs. The result is the feasibility half of the global convergence theory of the method; Theorem 4.2 treats feasible limit points.
--
--   **Formalization Note** "Limit point" is `MapClusterPt`; "bounded" is `BddAbove (Set.range ρ)` and "otherwise" its negation. (i) is `IsKKT` for the objective of (4.1), with the $\tfrac12$, and the constraints $h_2=0$, $g_2\le0$ of $\Omega_2$; its gradient is the true gradient, which exists because $\max\{0,t\}^2$ is $C^1$. (ii) negates CPLD for the family $h_2, g_2$ only. Continuous differentiability "on a sufficiently large open domain" is read as $C^1$ on $\mathbb R^n$.
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, p. 6, Theorem 4.1 and (4.1)

import Mathlib
import Definitions.Def_AugLagLLC_Feas_Setting

open Filter
open scoped Topology

namespace AugLagLLC.Feas
theorem theorem_4_1 {n m1 p1 m2 p2 : ℕ} (P : Problem n m1 p1 m2 p2) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin p1 → ℝ} {ε : ℕ → ℝ}
    (hpar : ValidParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin p1 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin p2 → ℝ}
    (hrun : IsRun P τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    {xs : EuclideanSpace ℝ (Fin n)} (hxs : MapClusterPt xs atTop x) :
    (BddAbove (Set.range ρ) → xs ∈ P.Omega1 ∩ P.Omega2) ∧
    (¬ BddAbove (Set.range ρ) → IsKKT (infeas P) P.h2 P.g2 xs ∨ ¬ CPLDAt P.h2 P.g2 xs) := by sorry
end AugLagLLC.Feas
