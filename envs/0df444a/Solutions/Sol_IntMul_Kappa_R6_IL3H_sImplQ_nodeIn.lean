section Left

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem frOK_leftFr (hN : NodeRH c σ K t S0 r H E e B) (hm : 1 ≤ c.m) (M : ℕ)
    (hM : E + e + K * E + K + c.m + 1 ≤ M) : FrOK σ M 20 (leftFr c) := by
  have hnat : ∀ i ∈ [vk, vE, vK, wF], ∃ n : ℕ, σ i = some (n : ℤ) := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl
    · exact ⟨_, hN.lev.hk⟩
    · exact ⟨_, hN.lev.hE⟩
    · exact ⟨_, hN.lev.hK⟩
    · exact ⟨_, hN.gF⟩
  have hEm : E / c.m ≤ E := Nat.div_le_self _ _
  have hmE : c.m * (E / c.m) ≤ E := Nat.mul_div_le E c.m
  have hKE : K * (c.m * (E / c.m)) ≤ K * E := Nat.mul_le_mul_left _ hmE
