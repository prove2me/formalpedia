theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨569547023187,584940185977⟩ ⟨679588778156,684120213038⟩ ⟨259621083596,317622520986⟩ := rfl
noncomputable def centerUpper : ℝ := (1960734755015 / 1099511627776)
