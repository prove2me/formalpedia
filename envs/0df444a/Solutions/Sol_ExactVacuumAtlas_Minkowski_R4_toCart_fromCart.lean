open ExactVacuumAtlas.Minkowski.R4
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
theorem solution {y : Pt 4} (hy : y ∈ imgCart) : toCart (fromCart y) = y := by
  have hS2 := S2_pos hy
  have hS3 := S3_pos hy
  have hρ3 := rho3_pos hy
  have hρ2 := rho2_pos hy
  have hd := rho2_sub_pos hy
  have hz1 := z_div_rho3_lt_one hy
  have hz2 := neg_one_lt_z_div_rho3 hy
  -- r sin θ = ρ₂
  have hA : √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) * sin (arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)))
      = √(y 1 ^ 2 + y 2 ^ 2) := by
    rw [Real.sin_arccos, div_pow, Real.sq_sqrt hS3.le]
    have h1 : 1 - y 3 ^ 2 / (y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)
        = (y 1 ^ 2 + y 2 ^ 2) / (y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := by
      field_simp
      ring
    rw [h1, Real.sqrt_div hS2.le]
    field_simp
  -- r cos θ = z
  have hB : √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) * cos (arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)))
      = y 3 := by
    rw [Real.cos_arccos hz2.le hz1.le]
    field_simp
  -- the azimuth
  set w : ℝ := -(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1) with hw
  set d : ℝ := √(y 1 ^ 2 + y 2 ^ 2) - y 1 with hd_def
  set ρ : ℝ := √(y 1 ^ 2 + y 2 ^ 2) with hρ_def
  have hρsq : ρ ^ 2 = y 1 ^ 2 + y 2 ^ 2 := Real.sq_sqrt hS2.le
  have hd2 : d ^ 2 + y 2 ^ 2 = 2 * ρ * d := by
    rw [hd_def]; linear_combination (-1 : ℝ) * hρsq
  have hw2 : 1 + w ^ 2 = 2 * ρ / d := by
    have : 1 + w ^ 2 = (d ^ 2 + y 2 ^ 2) / d ^ 2 := by
      rw [hw]; field_simp
    rw [this, hd2]; field_simp
  have hu0 : 0 < 1 + w ^ 2 := by positivity
  have hcos2 : cos (2 * arctan w) = 2 / (1 + w ^ 2) - 1 := by
    rw [Real.cos_two_mul, Real.cos_sq_arctan]; ring
  have hsin2 : sin (2 * arctan w) = 2 * w / (1 + w ^ 2) := by
    rw [Real.sin_two_mul, Real.sin_arctan, Real.cos_arctan]
    have hu : √(1 + w ^ 2) ^ 2 = 1 + w ^ 2 := Real.sq_sqrt hu0.le
    rw [show 2 * (w / √(1 + w ^ 2)) * (1 / √(1 + w ^ 2)) = 2 * w / √(1 + w ^ 2) ^ 2 by ring, hu]
  have hcosφ : cos (π + 2 * arctan w) = y 1 / ρ := by
    rw [show π + 2 * arctan w = 2 * arctan w + π by ring, Real.cos_add_pi, hcos2, hw2]
    field_simp
    rw [hd_def]; ring
  have hsinφ : sin (π + 2 * arctan w) = y 2 / ρ := by
    rw [show π + 2 * arctan w = 2 * arctan w + π by ring, Real.sin_add_pi, hsin2, hw2, hw]
    field_simp
  funext i
  fin_cases i
  · rfl
  · show √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) * sin (arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)))
      * cos (π + 2 * arctan w) = y 1
    rw [hA, hcosφ]; field_simp
  · show √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) * sin (arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)))
      * sin (π + 2 * arctan w) = y 2
    rw [hA, hsinφ]; field_simp
  · exact hB
