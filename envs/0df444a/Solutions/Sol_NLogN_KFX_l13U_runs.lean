theorem wval_lt_pow (A : List Bool) : wval A < 2 ^ A.length := by
  induction A with
  | nil => simp [wval]
  | cons b A ih => simp only [wval, List.length_cons, pow_succ]; cases b <;> simp <;> omega

end NLogN

