theorem sort_reconstruct_get {m n : Nat}
    (cols : Vector (Fin m) n)
    (hinj : Function.Injective (columnTupleVectorFn cols))
    (i : Fin n) :
    cols[i] = (sortInjTuple cols)[(sortInjPerm cols)[i]] := by sorry
