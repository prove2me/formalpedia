theorem PB_max {f g : α → ℕ} (hf : PB S sz f) (hg : PB S sz g) :
    PB S sz (fun a => max (f a) (g a)) :=
  (PB.add hf hg).mono (fun a _ => max_le (Nat.le_add_right _ _) (Nat.le_add_left _ _))

