-- title:
--   Validated finite permutation tables for configurations
-- statement:
--   Arrays describe edge, node and face maps. Exact lengths, range checks and all three cyclic inverse laws justify conversion to permutations. Ring and contract indices are checked before conversion. Out-of-bounds default values do not enter a valid configuration. Formalization note: a purely formal serialization bridge for the fixed source catalogue.
--
--   Notation: $D=\{0,\ldots,n-1\}$ is the dart set, $n = |D|$ its
--   size, and $p = \nu_H$ is the node permutation. Write $e,f$ for the edge and face
--   permutations, with $p(f(e(d)))=d$. Edge, node and face counts $E,N,F$ are numbers
--   of permutation orbits, including singleton orbits. The component count $C$ uses
--   the equivalence generated by all three permutations. Planarity means the exact
--   Euler equality $E+N+F=n+2C$, and connectedness means $C=1$.
--
--   A plain hypermap has a fixed-point-free involution $e$. Cubic means every node
--   orbit has size three; precubic means every node orbit has size at most three.
--   Bridgeless means $d$ and $e(d)$ never lie in the same face orbit. A $k$-coloring
--   is a map $D\to\{0,\ldots,k-1\}$ constant on face orbits and different across
--   each edge step. No requirement uses all available colors. The empty dart set
--   has zero components, is planar, and is colorable, but is not connected.
--
--   An admissible hypermap is planar, bridgeless, plain and precubic. A minimal
--   counterexample is a non-four-colorable admissible hypermap such that every
--   admissible hypermap with fewer darts is four-colorable. Minimality includes
--   all finite carriers through their enumeration by $\operatorname{Fin}(m)$;
--   cubicity, connectedness and lower face-degree bounds are not assumed.
--
--   The fixed catalogue $\mathcal C$ is the ordered list of all 633 literal
--   configuration maps, boundary rings, and selected contracts, decoded from the
--   pinned source. It is shared by reducibility and coverage; it is not an arbitrary
--   or existentially chosen family. The table checker establishes array sizes,
--   index bounds, and inverse/triangle identities only.
--
--   For a configuration $A$, let $R_A$ be its ordered boundary ring, $K_A$ the darts
--   whose faces avoid that ring, and $S_A$ the list containing both darts of every
--   selected contract edge. Geometric admissibility means that the map is planar,
--   bridgeless, plain and connected; $R_A$ is a nonempty node cycle meeting each
--   face at most once; off-ring nodes have arity three; ring faces have arity 3–6;
--   and there is a kernel face having a common adjacent kernel face with every
--   kernel face. Contract validity means that $S_A$ avoids $R_A$, its darts lie
--   in pairwise distinct node orbits, the contract has 1–4 edges, and a four-edge
--   contract has the source's kernel triad (more than two incident selected-face
--   darts and not every selected face adjacent).
--
--   Colors are the Klein-four group $\{0,1,2,3\}$, with bitwise XOR as addition.
--   A boundary trace records sums of consecutive face colors around the reversed
--   ring, including the closing pair. Ordinary traces arise from proper face
--   colorings. Contract traces arise from face-constant colorings with equal colors
--   across exactly the edges selected by $S_A$. A trace set is Kempe-closed if it is
--   closed under all permutations fixing zero and, for each member, contains every
--   trace matching some compatible four-symbol noncrossing-chord word. The stack
--   matcher rejects zero colors and requires an empty final stack. Coclosure of a
--   set consists of traces whose every containing Kempe-closed set meets that set.
--   C-reducibility means contract validity and inclusion of all contract traces in
--   the coclosure of the ordinary traces.
--
--   An occurrence of $A$ in $H$ requires geometric admissibility of $A$ and a map of
--   its darts into $H$ preserving face steps and exact face arities on $K_A$.
--   Every kernel face must contain an edge-preserving dart; such darts obey the
--   explicit ring-link path condition in the definition. A total injective map of
--   all permutations is not required. Occurrence up to reflection means occurrence
--   in $H$ or in its mirror, whose edge, node and face maps are respectively
--   $f\circ p$, $p^{-1}$ and $f^{-1}$.
--
--   The concrete transfer $t_H(y)$ counts, with multiplicity, matches of the 71
--   symmetrized source patterns at $f^{-2}(y)$. Their 38 base entries include repeated
--   entries implementing larger transfers. With $F_H(x)$ the face orbit of $x$ and
--   $a_H(x)=|F_H(x)|$, the score is
--   $$q_H(x)=60-10a_H(x)+\sum_{y\in F_H(x)}(t_H(e(y))-t_H(y)).$$
--   All intervals are inclusive; a missing upper endpoint means no upper bound.
--   Only the positive hub is eventually restricted to degrees 5–11. Neighboring
--   faces are not silently restricted to those degrees.
--
--   Source: Georges Gonthier, A Computer-Checked Proof of the Four Colour Theorem (2005), https://www.microsoft.com/en-us/research/wp-content/uploads/2012/10/4colproof.pdf; Section 3, PDF p. 9, paragraph on PDF p. 9 identifying the 633 configurations; Section 5.2, PDF pp. 26–32, configuration construction and finite checks. Relevant displays are unnumbered. Pinned executable reference: https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfmap.v#L127-L131; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfmap.v#L1140-L1141; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfcontract.v#L903-L905; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/configurations.v#L2076; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/reducibility.v#L16-L20.
-- source:
--   Georges Gonthier, A Computer-Checked Proof of the Four Colour Theorem (2005), https://www.microsoft.com/en-us/research/wp-content/uploads/2012/10/4colproof.pdf; Section 3, PDF p. 9, paragraph on PDF p. 9 identifying the 633 configurations; Section 5.2, PDF pp. 26–32, configuration construction and finite checks. Relevant displays are unnumbered. Pinned executable reference: https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfmap.v#L127-L131; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfmap.v#L1140-L1141; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/cfcontract.v#L903-L905; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/configurations.v#L2076; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/reducibility.v#L16-L20.

import Definitions.Def_FourColor_Configuration

/-!
# Checked finite configuration tables

A serialization boundary for the explicit catalogue in Gonthier's proof:
Gonthier (2005), Section 5.2, PDF pp. 26–32; pinned Rocq `cfmap.v`
(configuration maps) and `cfcontract.v` (contract dart enumeration).
These table validity checks establish finite permutation data only; geometric
embeddability and reducibility remain separate mathematical obligations.
The default-zero lookup is never used out of bounds in a valid table:
all array lengths and every index are checked before conversion.
-/

namespace FourColor

/-- Finite tables whose validity is checked before they are used as a hypermap. -/
structure DartTable where
  dartCount : ℕ
  edge : Array ℕ
  node : Array ℕ
  face : Array ℕ
  deriving Repr

namespace DartTable

def entry (a : Array ℕ) (i : ℕ) : ℕ := a[i]?.getD 0

def Valid (T : DartTable) : Prop :=
  T.edge.size = T.dartCount ∧ T.node.size = T.dartCount ∧ T.face.size = T.dartCount ∧
    ∀ i : Fin T.dartCount,
      entry T.edge i < T.dartCount ∧ entry T.node i < T.dartCount ∧ entry T.face i < T.dartCount ∧
      entry T.node (entry T.face (entry T.edge i)) = i ∧
      entry T.face (entry T.edge (entry T.node i)) = i ∧
      entry T.edge (entry T.node (entry T.face i)) = i

instance (T : DartTable) : Decidable T.Valid := inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

def toHypermap (T : DartTable) (h : T.Valid) : Hypermap T.dartCount := by
  let e : Fin T.dartCount → Fin T.dartCount := fun x ↦ ⟨entry T.edge x, (h.2.2.2 x).1⟩
  let n : Fin T.dartCount → Fin T.dartCount := fun x ↦ ⟨entry T.node x, (h.2.2.2 x).2.1⟩
  let f : Fin T.dartCount → Fin T.dartCount := fun x ↦ ⟨entry T.face x, (h.2.2.2 x).2.2.1⟩
  have h₁ (x) : n (f (e x)) = x := Fin.ext ((h.2.2.2 x).2.2.2.1)
  have h₂ (x) : f (e (n x)) = x := Fin.ext ((h.2.2.2 x).2.2.2.2.1)
  have h₃ (x) : e (n (f x)) = x := Fin.ext ((h.2.2.2 x).2.2.2.2.2)
  exact {
    edge := ⟨e, n ∘ f, h₁, h₃⟩
    node := ⟨n, f ∘ e, h₂, h₁⟩
    face := ⟨f, e ∘ n, h₃, h₂⟩
    edge_node_face := h₁ }

end DartTable

/-- Serialized finite patch data. Invalid table entries cannot construct a configuration. -/
structure ConfigurationTable where
  darts : DartTable
  ring : List ℕ
  contract : List ℕ
  deriving Repr

namespace ConfigurationTable

def Valid (T : ConfigurationTable) : Prop :=
  T.darts.Valid ∧ (∀ x ∈ T.ring, x < T.darts.dartCount) ∧
    (∀ x ∈ T.contract, x < T.darts.dartCount)

instance (T : ConfigurationTable) : Decidable T.Valid :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

/-- All indices and inverse laws are discharged before exposing the semantic value. -/
def toConfiguration (T : ConfigurationTable) (h : T.Valid) : Configuration where
  dartCount := T.darts.dartCount
  map := T.darts.toHypermap h.1
  ring := T.ring.pmap (fun x hx ↦ (⟨x, hx⟩ : Fin T.darts.dartCount)) h.2.1
  contract := T.contract.pmap (fun x hx ↦ (⟨x, hx⟩ : Fin T.darts.dartCount)) h.2.2

end ConfigurationTable
end FourColor

namespace FourColor.DartTable
/-- A Boolean form of the unchanged table laws, avoiding dependent finite quantifier reduction. -/
def validB (T : DartTable) : Bool :=
  (T.edge.size == T.dartCount) && (T.node.size == T.dartCount) &&
    (T.face.size == T.dartCount) && (List.range T.dartCount).all fun i ↦
      decide (entry T.edge i < T.dartCount) && decide (entry T.node i < T.dartCount) &&
      decide (entry T.face i < T.dartCount) &&
      (entry T.node (entry T.face (entry T.edge i)) == i) &&
      (entry T.face (entry T.edge (entry T.node i)) == i) &&
      (entry T.edge (entry T.node (entry T.face i)) == i)
/-- Reflection of every bound and all three inverse laws into the original validity predicate. -/
theorem validB_iff (T : DartTable) : T.validB = true ↔ T.Valid := by
  simp only [validB, Valid, Bool.and_eq_true_iff, beq_iff_eq, List.all_eq_true,
    List.mem_range, decide_eq_true_eq]
  constructor
  · rintro ⟨⟨⟨he, hn⟩, hf⟩, h⟩
    refine ⟨he, hn, hf, ?_⟩
    intro i
    rcases h i.val i.isLt with ⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩
    exact ⟨h1, h2, h3, h4, h5, h6⟩
  · rintro ⟨he, hn, hf, h⟩
    refine ⟨⟨⟨he, hn⟩, hf⟩, ?_⟩
    intro i hi
    rcases h ⟨i, hi⟩ with ⟨h1, h2, h3, h4, h5, h6⟩
    exact ⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩
end FourColor.DartTable
namespace FourColor.ConfigurationTable
/-- Executable validation of the hypermap table and both index lists. -/
def validB (T : ConfigurationTable) : Bool :=
  T.darts.validB && T.ring.all (fun x ↦ decide (x < T.darts.dartCount)) &&
    T.contract.all (fun x ↦ decide (x < T.darts.dartCount))
/-- Kernel-checkable Boolean certificates prove exactly the original table-validity statement. -/
theorem validB_iff (T : ConfigurationTable) : T.validB = true ↔ T.Valid := by
  simp only [validB, Valid, Bool.and_eq_true_iff, List.all_eq_true, decide_eq_true_eq,
    DartTable.validB_iff]
  exact and_assoc
end FourColor.ConfigurationTable


