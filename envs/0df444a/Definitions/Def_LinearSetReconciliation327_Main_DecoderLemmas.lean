  have hsrc : (boundaryState (s.pc + 20) (Function.update s.mem index 0)).mem source = len := by
    simpa [boundaryState, hne] using hm
  rw [copyMeta_spec E _ source counter len hs hc hlen hsrc] <;> rfl

