/-- **One Prop. 11 level as IL code (bit data).** The code `levelC` computes `levelR` on the
bit array (encoded on stack `0`), restores every other stack, and has cost `levelCI`. -/
theorem levelR_run (hN : 1 < N) (hpos : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a)
    (scode : Step (m + m) N → IStmt HS Pp) (ShOK : Step (m + m) N → Prop) (cS c0 Bb : ℕ)
    (hscode : ∀ s, ShOK s → ∀ (t : IState HS) (R : List Item) (ys : List ℤ),
      DOK (P :: L' :: hdShape A B Cs m N) Bb ys →
      IRuns I iprog (scode s) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (s.arr ((hdLayout A B Cs m N).cons2 P L') 0 ys) ++ R)) cS)
    (hfr : FramesOK (FrOK C N ShOK) C.gates C.Min C.Mout)
    (jOf : Fin (m + m) → Fin (m + m) → Fin Pp)
    (child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2))
    (hcall : ∀ (i j : Fin m) (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
      ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      IRuns I iprog (iprog (jOf (Fin.castAdd m i) (Fin.natAdd m j))) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child (Fin.castAdd m i) (Fin.natAdd m j) ys)) ++ R)) c0 ∧
      (child (Fin.castAdd m i) (Fin.natAdd m j) ys).length = vol (P :: L' :: hdShape A B Cs m N))
    (hV : zsz ((vol (P :: W * L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    (t : IState HS) (R : List Item) (xs : List (ZMod 2))
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    IRuns I iprog (levelC C N P L' A B Cs scode jOf) (t.upd 0 (ints (enc2 xs) ++ R))
      (t.upd 0 (ints (enc2 (levelR C N P L' A B Cs child xs)) ++ R)) (levelCI C N P L' A B Cs cS c0 Bb) := by
  set rest := hdShape A B Cs m N with hrest
  set v := vol (P :: L' :: rest) with hv
  set ΛB := (hdLayout A B Cs m N).cons2 P (W * L')
  set ΛS := (hdLayout A B Cs m N).cons2 P L'
  have hW1 : 1 ≤ W := NeZero.pos W
  have hP1 : 1 ≤ P := hpos P List.mem_cons_self
  have hL1 : 1 ≤ L' := hpos L' (List.mem_cons_of_mem _ List.mem_cons_self)
  have hr1 : 1 ≤ vol rest := vol_le_of_pos rest (fun a ha =>
    hpos a (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha)))
  have hposB : ∀ a ∈ P :: W * L' :: rest, 1 ≤ a := by
    intro a ha
    simp only [List.mem_cons] at ha
    rcases ha with rfl | rfl | ha
    · exact hP1
    · exact Nat.mul_pos hW1 hL1
    · exact hpos a (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha))
  have hVv : vol (P :: W * L' :: rest) = W * v := by simp only [hv, vol_cons]; ring
  have hB1 : 1 ≤ Bb := le_trans (by
    have := zsz_natCast_le' (show 1 ≤ 2 * N by omega)
    simpa [zsz_one] using this) hQ2
  have hle : ∀ k : ℕ, k ≤ vol (P :: W * L' :: rest) → zsz (k : ℤ) ≤ Bb := fun k hk =>
    le_trans (zsz_natCast_le' hk) hV
  have hVexp : vol (P :: W * L' :: rest) = P * (W * L') * vol rest := by
    simp only [vol_cons]; ring
  have hWL : W ≤ W * L' := Nat.le_mul_of_pos_right W hL1
  have hPWL : W * L' ≤ P * (W * L') := Nat.le_mul_of_pos_left _ hP1
  have hPWLr : P * (W * L') ≤ P * (W * L') * vol rest := Nat.le_mul_of_pos_right _ hr1
  have zW : zsz (W : ℤ) ≤ Bb := hle W (by rw [hVexp]; omega)
  have zPL : zsz ((P * L' : ℕ) : ℤ) ≤ Bb := hle (P * L') (by
    rw [hVexp]
    have : P * L' ≤ P * (W * L') := Nat.mul_le_mul_left P (Nat.le_mul_of_pos_left L' hW1)
    omega)
  have zr : zsz ((vol rest : ℕ) : ℤ) ≤ Bb := hle (vol rest) (by
    rw [hVexp]; exact Nat.le_mul_of_pos_left _ (Nat.mul_pos hP1 (Nat.mul_pos hW1 hL1)))
  have hTab : TabB W v Bb := ⟨le_trans (zsz_natCast_le' (by omega)) hQ2, by rw [← hVv]; exact hV, NeZero.pos W⟩
  -- Phase 1: D ← D − H
  have H1 := subSteps_il (I := I) (iprog := iprog) ΛB jOf hposB t R Bb hV hQ2 (enc2 xs)
    ⟨by rw [length_enc2]; exact hxs, bnd_enc2 xs hB1⟩
  rw [runArr_enc2] at H1
  set xs1 := AModel.runArr ΛB 0 (subSteps m) xs with hxs1
  have hxs1l : xs1.length = vol (P :: W * L' :: rest) := length_runArr ΛB 0 _ hxs
  -- Phase 2: the row split
  have H2 := withPar_sp bwdP W (P * L') (vol rest) Bb t (enc2 xs1)
    ((List.finRange W).flatMap fun w => rowSplit P W L' rest w 0 (enc2 xs1)) R hB1 zW zPL zr
    (fun u h0 h1 h2 h3 h4 => rowSplit_spec u (enc2 xs1) P W L' rest Bb R (t.G 1) (t.G 2) (t.G 3)
      (t.G 4) (by rw [length_enc2]; exact hxs1l) (bnd_enc2 xs1 hB1) hr1 (Nat.mul_pos hP1 hL1) hW1
      (hle _ (by rw [hVexp]; apply le_of_eq; ring)) h0 h1 h2 h3 h4)
  -- Phase 3: the network
  set Φ : IMat m → List (ZMod 2) → List (ZMod 2) := fun X ys => runC ΛS child 0 (AModel.edgeSteps C N X) ys
  set Y0 : Fin W → Fin v → ZMod 2 := fun w i => (rowSplit P W L' rest w 0 xs1).getD (i : ℕ) 0
  have hsplit : (List.finRange W).flatMap (fun w => rowSplit P W L' rest w 0 (enc2 xs1)) =
      tabR 0 W (tabOf Y0) := by
    rw [flatMap_finRange_tabR]
    congr 1
    funext n
    simp only [liftF, tabOf]
    split_ifs with hn
    · rw [rowSplit_enc2, ofFn_getD_eq]; simp [hv]
    · rfl
  rw [hsplit] at H2
  have hΦl : ∀ X, FrOK C N ShOK X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v :=
    fun X _ ys hys => length_runC ΛS child _ (fun a b hab ys h => by
      obtain ⟨i, j, rfl, rfl⟩ := edgeSteps_swap_HD C N X hab
      exact (hcall i j t R ys h).2) ys hys
  have hE : ∀ X, FrOK C N ShOK X → ∀ ys : List (ZMod 2), ys.length = v →
      ∀ (t' : IState HS) (R' : List Item),
      IRuns I iprog (edgeC C N scode jOf X) (t'.upd 0 (ints (enc2 ys) ++ R'))
        (t'.upd 0 (ints (enc2 (Φ X ys)) ++ R')) (runCostI cS (fun _ _ => c0) (AModel.edgeSteps C N X)) :=
    fun X hX ys hys t' R' => runCode2_spec ΛS scode jOf child t' R' Bb cS hB1 (fun _ _ => c0)
      (AModel.edgeSteps C N X) (fun i u c h ys' hd => hscode _ (hX.2 i u c h) t' R' ys' hd)
      (fun a b hab ys' hl => by
        obtain ⟨i, j, rfl, rfl⟩ := edgeSteps_swap_HD C N X hab
        exact hcall i j t' R' ys' hl) ys hys
  have H3 := netC_runs (I := I) (iprog := iprog) (E := edgeC C N scode jOf)
    (cE := fun X => runCostI cS (fun _ _ => c0) (AModel.edgeSteps C N X)) Φ (FrOK C N ShOK) hΦl hE
    (t.upd 0 R) [] hTab C.Mout C.gates C.Min Y0
    (Function.update (fun _ => []) 0 (tabR 0 W (tabOf Y0) ++ [])) hfr (by simp) (by simp)
  rw [Function.update_idem, List.append_nil, List.append_nil, ← upd_as_encK, ← upd_as_encK] at H3
  set Yn := netRunF (funΦ v Φ) C.gates C.Min C.Mout Y0 with hYn
  -- Phase 4: routing
  have H4 := rebuildC_sp (uni_tabOf Yn) (t.upd 0 R)
    (Function.update (fun _ => []) 0 (tabR 0 W (tabOf Yn) ++ [])) [] (by simp) (by simp) hTab
    (permT_ok C)
  rw [Function.update_idem, List.append_nil, List.append_nil, ← upd_as_encK, ← upd_as_encK] at H4
  set sM : Fin W → List ℤ := fun w => enc2 (List.ofFn (Yn (C.ρ w)))
  have hperm : tabR 0 W (fun n => sumS (tabOf Yn) v (NLogN.KIL.permT C n)) = (List.finRange W).flatMap sM := by
    rw [flatMap_finRange_tabR]
    apply tabR_congr
    intro n _ hn
    simp only [Nat.zero_add] at hn
    simp only [NLogN.KIL.permT, dif_pos hn, liftF]
    rw [sumS_single (uni_tabOf Yn) (C.ρ _).2]
    simp [tabOf, liftF, sM]
  rw [hperm] at H4
  -- Phase 5: the row merge
  have H5 := withPar_sp fwdP W (P * L') (vol rest) Bb t ((List.finRange W).flatMap sM)
    (rowMerge P W L' rest 0 sM) R hB1 zW zPL zr
    (fun u h0 h1 h2 h3 h4 => rowMerge_spec u sM P L' rest Bb R (t.G 1) (t.G 2) (t.G 3)
      (t.G 4) (fun w => by simp only [sM, length_enc2, List.length_ofFn, hv, vol_cons]; ring) (fun w => bnd_enc2 _ hB1) hr1
      (Nat.mul_pos hP1 hL1) (hle _ (by rw [hVexp]; apply le_of_eq; ring)) h0 h1 h2 h3 h4)
  have hmerge : rowMerge P W L' rest 0 sM =
      enc2 (rowMerge P W L' rest 0 fun w => List.ofFn (Yn (C.ρ w))) := rowMerge_enc2 _ _ _ _
  rw [hmerge] at H5
  -- Phase 6: D ← H − D
  set xs5 := rowMerge P W L' rest 0 fun w => List.ofFn (Yn (C.ρ w))
  have hxs5 : xs5.length = vol (P :: W * L' :: rest) := by simp [xs5, rowMerge]
  have H6 := flipSteps_il (I := I) (iprog := iprog) ΛB jOf hposB t R Bb hV hQ2 (enc2 xs5)
    ⟨by rw [length_enc2]; exact hxs5, bnd_enc2 xs5 hB1⟩
  rw [runArr_enc2] at H6
  have H := H1.seq (H2.toIRuns.seq (H3.seq (H4.toIRuns.seq (H5.toIRuns.seq H6))))
  refine H.mono' rfl ?_
  simp only [levelCI, ← hrest, ← hv, ← hVv]
  omega

end Level

section FrameSumNat

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

theorem frameSum_add (f g : M → ℕ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum (fun a => f a + g a) gates lab Mout =
        frameSum f gates lab Mout + frameSum g gates lab Mout
  | [], lab, Mout => by simp [frameSum, Finset.sum_add_distrib]
  | g' :: gs, lab, Mout => by
    simp only [frameSum, frameSum_add f g gs, Finset.sum_add_distrib]; ring

theorem frameSum_mul (f : M → ℕ) (k : ℕ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum (fun a => f a * k) gates lab Mout = frameSum f gates lab Mout * k
  | [], lab, Mout => by simp [frameSum, Finset.sum_mul]
  | g' :: gs, lab, Mout => by
    simp only [frameSum]
    rw [frameSum_mul f k gs, add_mul, Finset.sum_mul]

theorem frameSum_const (k : ℕ) (gates : List (NGate Wr R M)) (lab Mout : Wr → M) :
    frameSum (fun _ => k) gates lab Mout = frameSum (fun _ => 1) gates lab Mout * k := by
  rw [← frameSum_mul]; simp

theorem framesOK_mono {P Q : M → Prop} (h : ∀ a, P a → Q a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      FramesOK P gates lab Mout → FramesOK Q gates lab Mout
  | [], lab, Mout, hF => fun w => h _ (hF w)
  | g :: gs, lab, Mout, hF => ⟨fun w hw => h _ (hF.1 w hw), framesOK_mono h gs _ Mout hF.2⟩

end FrameSumNat

theorem cShiftU_le (n V Bb : ℕ) :
    cShiftU n V Bb ≤ (2 * 10 ^ 8 + 10 ^ 6 * (n + 1)) * ((V + 1) * (Bb + 2) ^ 2) := by
  set X := (V + 1) * (Bb + 2) ^ 2 with hX
  have hb1 : (V + 1) * (Bb + 2) ≤ X := by
    rw [hX, pow_two, ← mul_assoc]; exact Nat.le_mul_of_pos_right _ (by omega)
  have hb2 : (Bb + 2) ^ 2 ≤ X := by rw [hX]; exact Nat.le_mul_of_pos_left _ (by omega)
  unfold cShiftU cShift
  have e1 : 10 ^ 6 * (n + 1) * (V + 1) * (Bb + 2) = 10 ^ 6 * (n + 1) * ((V + 1) * (Bb + 2)) := by
    ring
  have e2 : 10 ^ 7 * (V + 1) * (Bb + 2) = 10 ^ 7 * ((V + 1) * (Bb + 2)) := by ring
  rw [e1, e2]
  have := Nat.mul_le_mul_left (10 ^ 6 * (n + 1)) hb1
  nlinarith

section LevelCost

variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (N : ℕ) [NeZero N] (P L' : ℕ)
  (A B Cs : Shape)

theorem cE_eq (hN : 1 < N) (cS c0 : ℕ) {X : IMat m} (hX : PiOK C.fac X) :
    runCostI cS (fun _ _ => c0) (AModel.edgeSteps C N X) =
      (4 * m + 2 * pivRank C X) * cS + pivRank C X * (c0 + 2) + 1 := by
  have h1 := countP_edgeStepsZ C hN hX
  have h2 : (AModel.edgeSteps C N X).length = 4 * m + 3 * pivRank C X := by
    rw [← h1, AModel.edgeSteps, countP_shearSteps, length_shearSteps, length_pivots]
  have h3 := countP_not_add (AModel.edgeSteps C N X)
  have h4 : (AModel.edgeSteps C N X).countP (fun s => !s.isSwap) = 4 * m + 2 * pivRank C X := by omega
  rw [runCostI_const, h4, h1]

/-- **Cost of one level**: linear part `lvlK · (V + 1) · (Bb + 2)²`, plus `cS` per shift of the
frame changes, plus `c₀ + 2` per child call (`rankSum C` calls). -/
theorem levelCI_le (hN : 1 < N) (hpos : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a)
    (hfr : FramesOK (PiOK C.fac) C.gates C.Min C.Mout) (cS c0 Bb : ℕ) :
    levelCI C N P L' A B Cs cS c0 Bb ≤
      lvlK C (P :: W * L' :: hdShape A B Cs m N).length *
        ((vol (P :: W * L' :: hdShape A B Cs m N) + 1) * (Bb + 2) ^ 2) +
      nShift C * cS + rankSum C * (c0 + 2) := by
  set V := vol (P :: W * L' :: hdShape A B Cs m N) with hVdef
  set nB := (P :: W * L' :: hdShape A B Cs m N).length
  set X := (V + 1) * (Bb + 2) ^ 2 with hX
  have hVv : V = W * vol (P :: L' :: hdShape A B Cs m N) := vol_big N P L' A B Cs
  have hb1 : (V + 1) * (Bb + 2) ≤ X := by
    rw [hX, pow_two, ← mul_assoc]; exact Nat.le_mul_of_pos_right _ (by omega)
  have hb2 : (Bb + 2) ^ 2 ≤ X := by rw [hX]; exact Nat.le_mul_of_pos_left _ (by omega)
  have hb0 : 1 ≤ X := le_trans (by nlinarith) hb2
  -- shifts on the whole array
  have hSU : cShiftU nB V Bb ≤ (2 * 10 ^ 8 + 10 ^ 6 * (nB + 1)) * X := by
    unfold cShiftU cShift
    have e1 : 10 ^ 6 * (nB + 1) * (V + 1) * (Bb + 2) = 10 ^ 6 * (nB + 1) * ((V + 1) * (Bb + 2)) := by
      ring
    have e2 : 10 ^ 7 * (V + 1) * (Bb + 2) = 10 ^ 7 * ((V + 1) * (Bb + 2)) := by ring
    rw [e1, e2]
    have := Nat.mul_le_mul_left (10 ^ 6 * (nB + 1)) hb1
    nlinarith
  -- split / merge
  have hPar : cPar W (P * L') (vol (hdShape A B Cs m N)) Bb ≤ 10 ^ 9 * (W + 1) * X := by
    unfold cPar cMove
    have e : 1 * (W * (P * L' * vol (hdShape A B Cs m N))) = V := by
      rw [hVdef]; simp only [vol_cons]; ring
    rw [e]
    have e2 : 300000 * W * (V + 1) * (Bb + 2) = 300000 * W * ((V + 1) * (Bb + 2)) := by ring
    rw [e2]
    have := Nat.mul_le_mul_left (300000 * W) hb1
    have h3 : Bb + 2 ≤ X := le_trans (by nlinarith) hb2
    nlinarith
  have hOp : cOp V Bb ≤ 50000 * X := by
    unfold cOp; rw [mul_assoc]; exact Nat.mul_le_mul_left _ hb1
  have hReb : cRebuild W V Bb ≤ (W * (6 * W + 2) + 3) * 50000 * X := by
    unfold cRebuild; rw [mul_assoc]; exact Nat.mul_le_mul_left _ hOp
  -- the network
  have hnet : netCI (fun X => runCostI cS (fun _ _ => c0) (AModel.edgeSteps C N X)) V Bb C.Mout C.Min
      C.gates = nShift C * cS + rankSum C * (c0 + 2) + nFr C * (1 + 2 * cOp V Bb) +
        C.gates.length * (cRebuild W V Bb + 1) + 1 := by
    rw [netCI_eq, frameSum_congr (PiOK C.fac) _
      (fun X => (4 * m + 2 * pivRank C X) * cS + pivRank C X * (c0 + 2) + (1 + 2 * cOp V Bb))
      (fun X hX => by rw [cE_eq C N hN cS c0 hX]; ring) _ _ _ hfr,
      frameSum_add, frameSum_add, frameSum_mul, frameSum_mul, frameSum_const]
    rfl
  unfold levelCI
  rw [← hVv, hnet]
  unfold lvlK
  have := Nat.mul_le_mul_left m hSU
  have h5 := Nat.mul_le_mul_left (nFr C) (show 1 + 2 * cOp V Bb ≤ (1 + 100000) * X by
    nlinarith)
  have h6 := Nat.mul_le_mul_left C.gates.length (show cRebuild W V Bb + 1 ≤
    ((W * (6 * W + 2) + 3) * 50000 + 1) * X by nlinarith)
  nlinarith

end LevelCost

end NLogN.KIL

