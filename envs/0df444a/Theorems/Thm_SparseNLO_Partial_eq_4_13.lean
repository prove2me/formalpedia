-- name    : SparseNLO.Partial.eq_4_13
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T15:13:40.236991+00:00
-- url     : https://prove2.me/theorems/032e70fe-2112-4607-b31a-a6473da2f87c
-- title:
--   (4.11)–(4.13), proof of Lemma 4.1 — f(xᵏ) − f(xᵏ⁺¹) ≥ M_s(xᵏ)[max_{I₀}|∇ᵢf(xᵏ)| − L₂M_s(xᵏ)] + xᵏ_{m_k}∇_{m_k}f(xᵏ)
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below, with Lipschitz gradient (Assumption 2), let $0<s<n$, and let $L_2>0$ satisfy the local Lipschitz condition (2.15). Let $(x^k)$ be a sequence generated by the partial sparse-simplex method, let $k$ satisfy $\|x^k\|_0=s$, and let $i^1_k,T^1_k,i^2_k,m_k,T^2_k$ be the selections with which the step from $x^k$ to $x^{k+1}$ is made; in particular $m_k$ minimizes $|x^k_i|$ over the support $I_1(x^k)$. Then
--   $$f(x^k)-f(x^{k+1})\ \ge\ M_s(x^k)\Big[\max_{i\in I_0(x^k)}|\nabla_if(x^k)|-L_2M_s(x^k)\Big]+x^k_{m_k}\nabla_{m_k}f(x^k). \tag{4.13}$$
--
--   This is the second half of the decrease estimate (4.7) for saturated iterates: it controls the partial derivatives off the support of $x^k$, which the swap move of the method targets.
--
--   **Formalization Note** The selections are explicit arguments, because the right-hand side depends on the chosen $m_k$ when several support coordinates tie for the smallest absolute value. The maximum over $I_0(x^k)$ is a supremum in $\mathbb R_{\ge0}$; $I_0(x^k)$ is nonempty because $\|x^k\|_0=s<n$. Assumptions 1 and 2 are kept as standing hypotheses.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 31, §4.2.3, proof of Lemma 4.1, (4.11)–(4.13)

import Mathlib
import Definitions.Def_SparseNLO_Partial_Method

namespace SparseNLO.Partial

/-- (4.11)–(4.13), proof of Lemma 4.1 (p. 31): under Assumption 2, with `L2 > 0` satisfying
(2.15), if `‖xᵏ‖₀ = s` and the step from `xᵏ` to `xᵏ⁺¹` is made with the selections
`i¹_k, T¹_k, i²_k, m_k, T²_k`, then
`f(xᵏ) − f(xᵏ⁺¹) ≥ M_s(xᵏ) [max_{i∈I₀(xᵏ)} |∇ᵢf(xᵏ)| − L2 M_s(xᵏ)] + xᵏ_{m_k} ∇_{m_k} f(xᵏ)`. -/
theorem eq_4_13 {n s : ℕ} (hs : 0 < s) (hsn : s < n)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f) (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x)
    (Lf : NNReal) (hLf : LipschitzWith Lf (gradient f))
    (L2 : ℝ) (hL2pos : 0 < L2) (hL2 : LocalLipschitz f L2)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsPartialRun f s x)
    (k : ℕ) (hk : l0 (x k) = s)
    (i1 : Fin n) (T1 : ℝ) (i2 m : Fin n) (T2 : ℝ)
    (hstep : StepAt f (x k) (x (k + 1)) i1 T1 i2 m T2) :
    Ms s (x k) * (maxAbs (I0 (x k)) (gradient f (x k)) - L2 * Ms s (x k))
        + x k m * gradient f (x k) m ≤ f (x k) - f (x (k + 1)) := by sorry

end SparseNLO.Partial
