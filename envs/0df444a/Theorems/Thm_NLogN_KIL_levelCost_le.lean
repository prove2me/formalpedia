open IntMul RS AModel AModelL12
variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (tpl : IMat m → List (TStep m))

theorem NLogN.KIL.levelCost_le (N P L' : ℕ) (A B Cs : Shape) (cC Bb : ℕ) :
    cEntry W m Bb + (bodyCI C tpl N P L' A B Cs cC Bb + cExit W m Bb) + 25 ≤
      Klev C tpl * ((vol (P :: W * L' :: hdShape A B Cs m N) + 1) * (Bb + 2) ^ 2) +
        SWn C tpl * cC := by sorry
