/-!
# KIL list layer: block transposes and their `pull` denotations

Arrays on `[P, q, M, B]` are described by a record function `r p y m : List ℤ` (each of length
`B`).  `inp r P q M` lists the records in the order `(p, y, m)`, `outF r P q M` in the order
`(p, m, y)`.  Moving the field `q` behind the field `M` maps `inp` to `outF` (and back).
-/

namespace NLogN.KIL

open AModel

/-! ## Generic list lemmas -/

theorem length_fm_const {α β : Type*} (l : List α) (f : α → List β) (w : ℕ)
    (h : ∀ x ∈ l, (f x).length = w) : (l.flatMap f).length = l.length * w := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    rw [h a (by simp), ih (fun x hx => h x (by simp [hx]))]; ring

