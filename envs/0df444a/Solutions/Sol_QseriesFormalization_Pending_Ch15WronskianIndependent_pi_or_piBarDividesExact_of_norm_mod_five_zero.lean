        simpa using hpi.2
      have hmod := (ZMod.intCast_eq_intCast_iff (-2 * a + b) 0 5).mp hm
      simpa using Int.ModEq.eq hmod
  · right
    constructor
    · have hm : (((a - 2 * b : ℤ) : ZMod 5) = (0 : ZMod 5)) := by
