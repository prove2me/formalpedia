section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution (s : NLogN.IState NLogN.HS) (n : ℕ) (hn : 3 ≤ n) (LN : List NLogN.Item)
    (hN : s.G NLogN.KFM.gN = .int ((2 : ℤ) ^ n) :: LN) :
    NLogN.IRuns I iprog NLogN.KFM.lgP s (s.upd NLogN.KFM.gJ (.int (IntMul.lg n : ℤ) :: s.G NLogN.KFM.gJ)) (10 ^ 6 * (n + 1)) := by
  have a := NLogN.KFM.lgInit_runs (I := I) (iprog := iprog) s n LN hN
  have b := NLogN.KFM.lgLoop_runs (I := I) (iprog := iprog) s (s.G NLogN.KFM.gA) (s.G NLogN.KFM.gR) (s.G NLogN.KFM.gP) (s.G NLogN.KFM.gJ) n
  have c := NLogN.KFM.lgPost_runs (I := I) (iprog := iprog) s n hn LN hN
  rw [NLogN.KFM.lgV_eq n hn] at c
  refine (a.seq (b.seq c)).mono' rfl ?_
  set J := Nat.size (n + 1)
  have hJ3 : 1 ≤ J := Nat.lt_size.2 (by norm_num)
  have h1 : 2 ^ (J - 1) ≤ n + 1 := Nat.lt_size.1 (by omega)
  have h2 : 2 ^ J ≤ 2 * (n + 1) := by
    have : 2 ^ J = 2 * 2 ^ (J - 1) := by rw [← pow_succ']; congr 1; omega
    omega
  have h3 := NLogN.KFM.sq_le_two_pow_succ J
  have h4 : J < 2 ^ J := Nat.lt_two_pow_self
  have d := NLogN.dupCost_le (n + 1)
  nlinarith
end
