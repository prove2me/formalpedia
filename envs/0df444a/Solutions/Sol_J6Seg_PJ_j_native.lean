theorem tabB_of {P R s t α lam : ℕ} (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P)
    (hl : 1 ≤ lam) (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P)
