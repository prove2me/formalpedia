lemma HasON_lab' (hh : 7 ≤ h) {j : Fin 3} {S1 S2 : Finset (Fin h)}
    {Ψ1 Ψ2 : Submodule (ZMod 2) (Vh h)} (hS1 : S1.card = 3) (hS2 : S2.card = 3) (h1 : HasON Ψ1)
