theorem nodes_eqv_transport (K₀ : IntermediateField k E) (F₀ : IntermediateField k F) (φ : K₀ ≃ₐ[k] F₀)
    {ι S ΓT : Type*} [SetLike ΓT S] (Γ : ΓT) (Att : S → (E ≃ₐ[k] E) → Prop) (σ : ι → S → F → F)
