-- title:
--   Theorem 3.2 — $(f+g+h)(\bar x^k_g) - (f+g+h)(x^*) = O(1/(k+1))$
-- statement:
--   Let $H$ be a real Hilbert space, $f, g : H \to (-\infty, +\infty]$ closed, proper and convex, and $h : H \to \mathbb R$ convex and differentiable with $\nabla h$ $\beta^{-1}$-Lipschitz, $\beta > 0$. Let $\gamma \in (0, 2\beta)$ and let $(z^k, x^k_g, x^k_f)_{k \ge 0}$ be generated by Algorithm 2 with $\lambda_k \equiv 1$ from $z^0 \in H$:
--   $$x^k_g = \operatorname{prox}_{\gamma g}(z^k),\quad x^k_f = \operatorname{prox}_{\gamma f}\big(2x^k_g - z^k - \gamma\nabla h(x^k_g)\big),\quad z^{k+1} = z^k + x^k_f - x^k_g .$$
--   Let $z^*$ be a fixed point of the associated map $T$, $x^* = \operatorname{prox}_{\gamma g}(z^*)$, and suppose that $f$ is finite and $L$-Lipschitz continuous on the closed ball $B\big(x^*, (1 + \gamma/\beta)\|z^0 - z^*\|\big)$. With the weighted ergodic iterate
--   $$\bar x^k_g = \frac{2}{(k+1)(k+2)} \sum_{i=0}^k (i+1)\, x^i_g ,$$
--   the value $(f+g+h)(x^*)$ is finite and there is a constant $C$, depending on the data but not on $k$, such that
--   $$(f+g+h)(\bar x^k_g) - (f+g+h)(x^*) \le \frac{C}{k+1} \qquad\text{for all } k \ge 0 .$$
--
--   Thus the weighted ergodic iterate attains the objective rate $O(1/(k+1))$, faster than the $o(1/\sqrt{k+1})$ rate of the last iterate $x^k_g$ (Theorem 3.1).
--
--   **Formalization Note** The paper writes $O(1/(k+1))$; this is stated as the existence of a constant $C$ chosen after all data ($f, g, h, \beta, \gamma, L, z^0, z^*$) and before $k$. The printed ball $B(0, \dots)$ is a typo for $B(x^*, \dots)$, the ball of Lemma 3.1 that the proof uses. The inequality is in the extended reals, so it also forces $(f+g+h)(\bar x^k_g) < \infty$.
-- source:
--   Davis and Yin, A Three-Operator Splitting Scheme and its Optimization Applications, Set-Valued Var. Anal. 25 (2017), https://doi.org/10.1007/s11228-017-0421-z, p. 840, Theorem 3.2

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_ThreeOpSplitting_ConvexRates_Algorithm

open InnerProductSpace Filter Topology

namespace ThreeOpSplitting.ConvexRates

/-- Theorem 3.2: if `f` is `L`-Lipschitz on the closed ball `B(x*, (1 + γ/β)‖z⁰ - z*‖)`,
`x* = prox_{γg}(z*)`, then at the weighted ergodic iterate
`x̄^k_g = 2/((k+1)(k+2)) ∑_{i=0}^k (i+1) x^i_g` the objective error is `O(1/(k+1))`: there is a
constant `C` (depending on the data but not on `k`) with
`(f+g+h)(x̄^k_g) ≤ (f+g+h)(x*) + C/(k+1)` for all `k ≥ 0`, and `(f+g+h)(x*)` is finite. -/
theorem weighted_ergodic_rate
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f g : H → EReal) (h : H → ℝ) (β γ : ℝ) (hβ : 0 < β) (hγ : 0 < γ) (hγβ : γ < 2 * β)
    (hf : IsProperClosedConvex f) (hg : IsProperClosedConvex g) (hh : IsSmoothConvex β h)
    (proxf proxg : H → H) (hproxf : IsProx γ f proxf) (hproxg : IsProx γ g proxg)
    (z0 zstar : H) (hfix : splittingOp proxf proxg (gradient h) γ zstar = zstar)
    (L : NNReal)
    (hfin : ∀ x ∈ Metric.closedBall (proxg zstar) ((1 + γ / β) * ‖z0 - zstar‖), f x ≠ ⊤)
    (hLip : LipschitzOnWith L (fun x => (f x).toReal)
      (Metric.closedBall (proxg zstar) ((1 + γ / β) * ‖z0 - zstar‖))) :
    objective f g h (proxg zstar) ≠ ⊤ ∧
      ∃ C : ℝ, ∀ k : ℕ,
        objective f g h (weightedErgodic (algXg proxf proxg (gradient h) γ z0) k) ≤
          objective f g h (proxg zstar) + ((C / ((k : ℝ) + 1) : ℝ) : EReal) := by sorry

end ThreeOpSplitting.ConvexRates
