/-- **All level claims.** -/
theorem lvAllH {c : Cfg} (hc : CfgOK c) {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {jL : Fin Pp} {rowC : IStmt HS Pp} (hj : tbl jL = levCH c jL rowC) {τ Kc θ Cc : ℝ}
    (hRow : RowUCC c.m τ Isym tbl rowC Kc) (hKc : 0 ≤ Kc) (hτ0 : 0 ≤ τ) (hτθ : τ ≤ θ)
    (hCc0 : 0 ≤ Cc)
    (hCc : ((chWs c).length : ℝ) * (10 ^ 14 * (2 * c.m + 1)) + 18 * c.Wr * c.net.length * 2 ^ τ +
