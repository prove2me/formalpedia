/-! ## The wire layout -/

lemma tabS_eqv (st : Fin W ⊕ Fin T → List (ZMod 2)) (x : Fin W ⊕ Fin T) :
    tabS st (eqv x : ℕ) = enc2 (st x) := by
  simp [tabS, liftF]

lemma uni_tabS {v : ℕ} {st : Fin W ⊕ Fin T → List (ZMod 2)} (h : ∀ x, (st x).length = v) :
    Uni (T + W) v (tabS st) := fun n hn => by
  simp only [tabS, liftF, dif_pos hn]
  exact ⟨by rw [length_enc2, h], bits_enc2 _⟩

/-! ## Gates -/

lemma gateApply_len {v : ℕ} (g : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) (ZMod 2))
    (S : Finset (Fin W ⊕ Fin T)) {st : Fin W ⊕ Fin T → List (ZMod 2)}
    (h : ∀ x, (st x).length = v) : ∀ x, (Bit.gateApply v g S st x).length = v := by
  intro x
  simp only [Bit.gateApply]
  split_ifs
  · simp
  · exact h x

/-- **A gate** (fine rebuild of the `T + W` streams). -/
theorem gateH_fsp {v : ℕ} (g : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) (ZMod 2))
    (S : Finset (Fin W ⊕ Fin T)) (st : Fin W ⊕ Fin T → List (ZMod 2))
    (h : ∀ x, (st x).length = v) (s : IState HS) (f : Fin HS → List ℤ) (rest : List ℤ)
    (hf : f 0 = tabR 0 (T + W) (tabS st) ++ rest) (hf21 : f 21 = []) (hR : RegS s f (T + W) v)
    {Bb : ℕ} (hB : TabB (T + W) v Bb) (hv1 : 1 ≤ v) :
    FSp (rebuildCU (T + W) (srcT (ngOf g S))) (encK s f)
      (encK s (Function.update f 0 (tabR 0 (T + W) (tabS (Bit.gateApply v g S st)) ++ rest)))
      (cRebuildF (T + W) ((T + W) * v) Bb) := by
  have H := rebuildCU_fsp (uni_tabS h) s f rest hf hf21 hR hB hv1 (srcOK (ngOf g S))
  refine H.congr ?_
  congr 3
  apply tabR_congr
  intro n _ hn
  exact sumS_gate g S st h n (by omega)

/-! ## The program -/

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- An edge applied in place. -/
theorem edgeH_runs {G0 : Fin HS → List Item} {v : ℕ} (E : IStmt HS Pp)
    (impl : List (ZMod 2) → List (ZMod 2)) (cE : ℕ)
    (hE : ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : IState HS) (R : List Item), Inv G0 t →
      IRuns I iprog E (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (impl ys)) ++ R)) cE)
    (x : Fin W ⊕ Fin T) (st : Fin W ⊕ Fin T → List (ZMod 2)) (h : ∀ x, (st x).length = v)
    (s : IState HS) (hs : Inv G0 s) (f : Fin HS → List ℤ) (hfp : ∀ r, Prot r → f r = [])
    (hR : RegS s f (T + W) v) (rest : List ℤ) (hf : f 0 = tabR 0 (T + W) (tabS st) ++ rest)
    (Bb : ℕ) (hV : zsz (((T + W) * v : ℕ) : ℤ) ≤ Bb) (hv1 : 1 ≤ v) :
    IRuns I iprog (applyCF ((eqv x : Fin (T + W)) : ℕ) E) (encK s f)
      (encK s (Function.update f 0
        (tabR 0 (T + W) (tabS (Function.update st x (impl (st x)))) ++ rest)))
      (cE + 2 * cOF ((T + W) * v) Bb + cPushT Bb + (2 * Bb + 2)) := by
  have H := applyCF_runs (I := I) (iprog := iprog) (G0 := G0) (uni_tabS h) (eqv x).2
    (ys' := enc2 (impl (st x))) (code := E) (c := cE)
    (fun t R ht => by rw [tabS_eqv]; exact hE (st x) (h x) t R ht) s hs f hfp hR rest hf Bb hV hv1
  refine H.mono' ?_ le_rfl
  congr 3
  apply tabR_congr
  intro n _ hn
  simp only [Nat.zero_add] at hn
  by_cases hnx : n = (eqv x : ℕ)
  · subst hnx
    rw [Function.update_self, tabS_eqv, Function.update_self]
  · rw [Function.update_of_ne hnx]
    simp only [tabS, liftF, dif_pos hn]
    congr 2
    rw [Function.update_of_ne]
    intro e
    apply hnx
    rw [← e]; simp

/-- **The program on the stream table.** -/
theorem netH_runs_sol_aux {G0 : Fin HS → List Item} {v : ℕ} (E : Bit.Edge m → IStmt HS Pp)
    (impl : Bit.Edge m → List (ZMod 2) → List (ZMod 2)) (cE : Bit.Edge m → ℕ)
    (s : IState HS) (hs : Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : TabB (T + W) v Bb)
    (hv1 : 1 ≤ v) :
    ∀ (prog : List (Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m)),
      (∀ e ∈ Bit.progEdges prog, ∀ ys : List (ZMod 2), ys.length = v → (impl e ys).length = v) →
      (∀ e ∈ Bit.progEdges prog, ∀ ys : List (ZMod 2), ys.length = v →
        ∀ (t : IState HS) (R : List Item), Inv G0 t →
        IRuns I iprog (E e) (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (impl e ys)) ++ R))
          (cE e)) →
      ∀ (st : Fin W ⊕ Fin T → List (ZMod 2)) (f : Fin HS → List ℤ), (∀ x, (st x).length = v) →
      (∀ r, Prot r → f r = []) → RegS s f (T + W) v →
      f 0 = tabR 0 (T + W) (tabS st) ++ rest → f 21 = [] →
      IRuns I iprog (netH E prog) (encK s f)
        (encK s (Function.update f 0 (tabR 0 (T + W) (tabS (Bit.netRunH v impl prog st)) ++ rest)))
        ((prog.map (instrHC cE ((T + W) * v) Bb)).sum + 1)
  | [], _, _, st, f, _, _, _, hf, _ => by
    simp only [netH, List.map_nil, KIL.seqL, List.sum_nil, Nat.zero_add, Bit.netRunH,
      List.foldl_nil]
    rw [← hf, Function.update_eq_self]; exact IRuns.skip _
  | i :: l, hL, hE, st, f, hst, hfp, hR, hf, hf21 => by
    have hL' : ∀ e ∈ Bit.progEdges l, _ := fun e he =>
      hL e (by rw [Bit.progEdges_cons]; exact List.mem_append_right _ he)
    have hE' : ∀ e ∈ Bit.progEdges l, _ := fun e he =>
      hE e (by rw [Bit.progEdges_cons]; exact List.mem_append_right _ he)
    have key : ∃ c, IRuns I iprog (instrH E i) (encK s f)
        (encK s (Function.update f 0 (tabR 0 (T + W) (tabS (Bit.instrRun v impl st i)) ++ rest)))
        c ∧ c ≤ instrHC cE ((T + W) * v) Bb i ∧ ∀ x, (Bit.instrRun v impl st i x).length = v := by
      cases i with
      | gate g S =>
        refine ⟨_, (gateH_fsp g S st hst s f rest hf hf21 hR hB hv1).irun (fok_rebuildCU _ _),
          le_rfl, ?_⟩
        exact gateApply_len g S hst
      | edge x e =>
        have he : e ∈ Bit.progEdges (Bit.Instr.edge x e :: l) := by
          rw [Bit.progEdges_cons]; simp [Bit.Instr.edgeOf]
        refine ⟨_, edgeH_runs (G0 := G0) (E e) (impl e) (cE e) (hE e he) x st hst s hs f hfp hR
          rest hf Bb hB.vol hv1, le_rfl, fun y => ?_⟩
        simp only [Bit.instrRun]
        by_cases hy : y = x
        · subst hy; rw [Function.update_self]; exact hL e he _ (hst y)
        · rw [Function.update_of_ne hy]; exact hst y
    obtain ⟨c, h1, hc, hlen⟩ := key
    have h2 := netH_runs_sol_aux E impl cE s hs rest hB hv1 l hL' hE' (Bit.instrRun v impl st i)
      (Function.update f 0 (tabR 0 (T + W) (tabS (Bit.instrRun v impl st i)) ++ rest)) hlen
      (KIL.prot_upd0 hfp _) (hR.upd (by decide) _) (by simp) (by simp [hf21])
    have H := h1.seq h2
    refine H.mono' ?_ ?_
    · rw [Function.update_idem]
      simp only [Bit.netRunH, List.foldl_cons]
    · simp only [List.map_cons, List.sum_cons]
      omega

end

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.netH_runs_sol_aux := @IntMul.Kappa.R6.IL.netH_runs_sol_aux
