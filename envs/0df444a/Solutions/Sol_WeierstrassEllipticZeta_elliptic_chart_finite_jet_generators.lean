noncomputable section
namespace TranscendenceTheory
variable {K R : Type*} [CommRing K] [CommRing R] [Algebra K R]

private lemma iter_add (D : Derivation K R R) (n : ℕ) (f g : R) :
    (D^[n]) (f + g) = (D^[n]) f + (D^[n]) g := by
  simpa only [Module.End.pow_apply] using! (D.toLinearMap ^ n).map_add f g

private lemma jets_mul (D : Derivation K R R) (p : Ideal R) (n : ℕ)
    (f : R) (hf : ∀ j < n, (D^[j]) f ∈ p) (a : R) :
    ∀ j < n, (D^[j]) (a * f) ∈ p := by
  induction n generalizing a f with
  | zero => simp
  | succ n ih =>
    intro j hj
    cases j with
    | zero => simpa using p.mul_mem_left a (hf 0 (by omega))
    | succ j =>
      rw [Function.iterate_succ_apply, D.leibniz, smul_eq_mul, smul_eq_mul, iter_add]
      apply p.add_mem
      · apply ih (D f) _ a j (by omega)
        intro k hk
        simpa only [← Function.iterate_succ_apply] using hf (k + 1) (by omega)
      · rw [mul_comm f (D a)]
        exact ih f (fun k hk => hf k (by omega)) (D a) j (by omega)

private lemma span_jets (D : Derivation K R R) (s : Set R) (p : Ideal R) (n : ℕ)
    (hs : ∀ f ∈ s, ∀ k ≤ n, (D^[k]) f ∈ p) :
    ∀ f ∈ Ideal.span s, ∀ k ≤ n, (D^[k]) f ∈ p := by
  intro f hf
  induction hf using Submodule.span_induction with
  | mem f hf => exact hs f hf
  | zero =>
    intro k hk
    simpa only [Module.End.pow_apply] using!
      (show (D.toLinearMap ^ k) 0 ∈ p by simp)
  | add f g _ _ ihf ihg =>
    intro k hk
    rw [iter_add]
    exact p.add_mem (ihf k hk) (ihg k hk)
  | smul a f _ ih =>
    intro k hk
    simpa only [smul_eq_mul] using
      jets_mul D p (n + 1) f (fun j hj => ih j (by omega)) a k (by omega)

/-- If the derivation annihilates the first generator, its entire finite-order
prolongation is generated by that element and the jets of the second generator. -/
theorem prolongation_two_generators (D : Derivation K R R) (F P : R)
    (hF : D F = 0) (T : ℕ) :
    differentialProlongation D (Ideal.span {F} ⊔ Ideal.span {P}) T =
      Ideal.span (Set.range (Fin.cases F (fun k : Fin (T + 1) => (D^[k.val]) P))) := by
  classical
  let J := Ideal.span (Set.range (Fin.cases F (fun k : Fin (T + 1) => (D^[k.val]) P)))
  have hFJ : F ∈ J := Ideal.subset_span ⟨0, rfl⟩
  have hPJ (k : ℕ) (hk : k ≤ T) : (D^[k]) P ∈ J :=
    Ideal.subset_span ⟨(⟨k, by omega⟩ : Fin (T + 1)).succ, rfl⟩
  have hFiter (k : ℕ) : (D^[k]) F ∈ J := by
    cases k with
    | zero => exact hFJ
    | succ k =>
      rw [Function.iterate_succ_apply, hF]
      simpa only [Module.End.pow_apply] using!
        (show (D.toLinearMap ^ k) 0 ∈ J by simp)
  have hbase : Ideal.span {F} ⊔ Ideal.span {P} = Ideal.span ({F} ∪ {P}) :=
    (Ideal.span_union {F} {P}).symm
  apply le_antisymm
  · rw [differentialProlongation]
    apply Ideal.span_le.mpr
    rintro r ⟨f, hf, k, hk, rfl⟩
    rw [hbase] at hf
    apply span_jets D ({F} ∪ {P}) J T _ f hf k hk
    intro r hr j hj
    rcases hr with hr | hr
    · obtain rfl := hr
      exact hFiter j
    · obtain rfl := hr
      exact hPJ j hj
  · apply Ideal.span_le.mpr
    rintro r ⟨j, rfl⟩
    refine Fin.cases ?_ (fun k => ?_) j
    · exact Ideal.subset_span ⟨F, (show Ideal.span {F} ≤ _ from le_sup_left)
        (Ideal.subset_span rfl), 0, Nat.zero_le T, rfl⟩
    · exact Ideal.subset_span ⟨P, (show Ideal.span {P} ≤ _ from le_sup_right)
        (Ideal.subset_span rfl), k.val, by have := k.isLt; omega, rfl⟩

end TranscendenceTheory


