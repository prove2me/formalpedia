      simp +decide [G1, G, P3, Function.update_apply, stkK_succ, mvP, hm]
    have S2 := Sp.pop s G1 (B := Bb) (by decide) g1K (zK k hk)
    set G2 := Function.update G1 sKK (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k ++ G0 sKK)
    have T := S1.seq (FSp.of_norep rfl S2)
    have gF2 : G2 sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
      simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact gF
    have S3 := Sp.pop s G2 (B := Bb) (by decide) gF2 zF
    have I := FSp.iteT hc hok trivial hbd (by rw [hev]; simp [flagV, hm]) T
