theorem NLogN.KFU.PhiInvD_at (h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j)
    (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (ys : List ℤ) (k c : ℕ)
    (hk : k < OpenAI.RCRT.Ppre sF d) (hc : c < 2) :
    (PhiInvD h d bL sF μ ys).getD (2 * k + c) 0 =
      ys.getD (encode (shR d (NLogN.KFU.tP d h bL)) (phiAddr d sF μ k c)) 0 := by sorry
