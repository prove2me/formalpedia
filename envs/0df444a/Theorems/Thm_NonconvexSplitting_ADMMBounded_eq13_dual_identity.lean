-- title:
--   Eq. (13): $\mathcal M^* z^{t+1} = \nabla h(x^{t+1}) + \nabla\phi(x^{t+1}) - \nabla\phi(x^t)$
-- statement:
--   Let $h : \mathbb{R}^n \to \mathbb{R}$ be twice continuously differentiable with bounded Hessian, $P : \mathbb{R}^m \to (-\infty, +\infty]$ proper and lower semicontinuous, $\phi : \mathbb{R}^n \to \mathbb{R}$ twice continuously differentiable and convex, $\mathcal M : \mathbb{R}^n \to \mathbb{R}^m$ linear with adjoint $\mathcal M^*$, and $\beta > 0$. Let $(x^t, y^t, z^t)_{t \ge 0}$ be a sequence generated by the proximal ADMM with penalty $\beta$ and proximal function $\phi$ (initial points $x^0, z^0$ arbitrary, $y^0$ unconstrained).
--
--   Then for every $t \ge 0$,
--   $$
--   \mathcal M^* z^{t+1} = \nabla h(x^{t+1}) + \nabla\phi(x^{t+1}) - \nabla\phi(x^t).
--   $$
--
--   This identity expresses the dual iterate through the primal iterates. It is the starting point of the estimates on the dual variable used in the boundedness proof, in particular Eq. (31).
--
--   **Formalization Note** Assumption 1 is not assumed. The adjoint $\mathcal M^*$ is Mathlib's `ContinuousLinearMap.adjoint`, and $\nabla$ is `gradient`.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 8, Eq. (13)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_IsProxADMMSeq
open NonconvexSplitting.Shared

open Filter Topology
open scoped InnerProductSpace

namespace NonconvexSplitting.ADMMBounded

/-- Eq. (13) of Li–Pong (p. 8): along the proximal ADMM, for every `t`,
`M* z^{t+1} = ∇h(x^{t+1}) + ∇φ(x^{t+1}) - ∇φ(x^t)`. -/
theorem eq13_dual_identity {n m : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ) (P : EuclideanSpace ℝ (Fin m) → EReal)
    (phi : EuclideanSpace ℝ (Fin n) → ℝ) (M : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)) (β : ℝ)
    (hstd : StandingAssumptions h P phi β)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y z : ℕ → EuclideanSpace ℝ (Fin m))
    (hseq : IsProxADMMSeq h P phi M β x y z)
    (t : ℕ) :
    ContinuousLinearMap.adjoint M (z (t + 1)) =
      gradient h (x (t + 1)) + gradient phi (x (t + 1)) - gradient phi (x t) := by sorry

end NonconvexSplitting.ADMMBounded
