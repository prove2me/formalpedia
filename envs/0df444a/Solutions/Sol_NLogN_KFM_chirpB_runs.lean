theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ w → NLogN.zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ : ℕ) (s : NLogN.IState NLogN.HS) (h g c : NLogN.KFB.GI) (R0 RH RK LR : List NLogN.Item)
    (h0 : s.G 0 = .int g.1 :: .int g.2 :: R0) (hH : s.G NLogN.KFM.pH = .int h.1 :: .int h.2 :: RH)
    (hK : s.G NLogN.KFM.pK = .int c.1 :: .int c.2 :: RK) (hR : s.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR)
    (hg : NLogN.KFM.GBnd w g) (hh : NLogN.KFM.GBnd w h) (hc : NLogN.KFM.GBnd w c) (hg' : NLogN.KFM.GBnd w (NLogN.KFM.gmulT Δ g h))
    (hh' : NLogN.KFM.GBnd w (NLogN.KFM.gmulT Δ h c)) :
    NLogN.IRuns I iprog (NLogN.KFM.chirpB pM) s
      (((s.upd 0 (.int (NLogN.KFM.gmulT Δ g h).1 :: .int (NLogN.KFM.gmulT Δ g h).2 :: R0)).upd NLogN.KFM.pH
        (.int (NLogN.KFM.gmulT Δ h c).1 :: .int (NLogN.KFM.gmulT Δ h c).2 :: RH)).upd NLogN.KFM.pV
        (.int g.1 :: .int g.2 :: s.G NLogN.KFM.pV)) (NLogN.KFM.cChirpB φ w Δ) := by
  have c1 := NLogN.KFM.cpyB_runs (I := I) (iprog := iprog) 0 NLogN.KFM.pV (by decide) (by decide) (by decide) s g.1 g.2 _ h0
  set s1 := s.upd NLogN.KFM.pV (.int g.1 :: .int g.2 :: s.G NLogN.KFM.pV) with hs1
  have c2 := NLogN.KFM.cpyB_runs (I := I) (iprog := iprog) NLogN.KFM.pH NLogN.KFM.pW (by decide) (by decide) (by decide) s1 h.1 h.2
    RH (by simp +decide [hs1, hH])
  rw [show s1.G NLogN.KFM.pW = s.G NLogN.KFM.pW by simp +decide [hs1]] at c2
  set s2 := s1.upd NLogN.KFM.pW (.int h.1 :: .int h.2 :: s.G NLogN.KFM.pW) with hs2
  have e1 := NLogN.KFM.entry_runs (I := I) (iprog := iprog) hM hdom hΦ Δ s2 g h R0 (s.G NLogN.KFM.pW) LR
    (by simp +decide [hs2, hs1, h0]) (by simp +decide [hs2]) (by simp +decide [hs2, hs1, hR])
    hg hh
  rw [show s2.G NLogN.KFM.pO = s.G NLogN.KFM.pO by simp +decide [hs2, hs1]] at e1
  set s3 := ((s2.upd 0 R0).upd NLogN.KFM.pW (s.G NLogN.KFM.pW)).upd NLogN.KFM.pO
    (.int (NLogN.KFM.gmulT Δ g h).2 :: .int (NLogN.KFM.gmulT Δ g h).1 :: s.G NLogN.KFM.pO) with hs3
  have c3 := NLogN.KFM.cpyB_runs (I := I) (iprog := iprog) NLogN.KFM.pK NLogN.KFM.pW (by decide) (by decide) (by decide) s3 c.1 c.2
    RK (by simp +decide [hs3, hs2, hs1, hK])
  rw [show s3.G NLogN.KFM.pW = s.G NLogN.KFM.pW by simp +decide [hs3]] at c3
  set s4 := s3.upd NLogN.KFM.pW (.int c.1 :: .int c.2 :: s.G NLogN.KFM.pW) with hs4
  have m1 := NLogN.KFM.mvPB_runs (I := I) (iprog := iprog) NLogN.KFM.pH 0 (by decide) (by decide) (by decide) s4 h.1 h.2
    RH (by simp +decide [hs4, hs3, hs2, hs1, hH])
  rw [show s4.G 0 = R0 by simp +decide [hs4, hs3]] at m1
  set s5 := (s4.upd NLogN.KFM.pH RH).upd 0 (.int h.1 :: .int h.2 :: R0) with hs5
  have e2 := NLogN.KFM.entry_runs (I := I) (iprog := iprog) hM hdom hΦ Δ s5 h c R0 (s.G NLogN.KFM.pW) LR
    (by simp +decide [hs5]) (by simp +decide [hs5, hs4]) (by simp +decide [hs5, hs4, hs3, hs2, hs1, hR])
    hh hc
  rw [show s5.G NLogN.KFM.pO = .int (NLogN.KFM.gmulT Δ g h).2 :: .int (NLogN.KFM.gmulT Δ g h).1 :: s.G NLogN.KFM.pO by
    simp +decide [hs5, hs4, hs3]] at e2
  set s6 := ((s5.upd 0 R0).upd NLogN.KFM.pW (s.G NLogN.KFM.pW)).upd NLogN.KFM.pO
    (.int (NLogN.KFM.gmulT Δ h c).2 :: .int (NLogN.KFM.gmulT Δ h c).1 :: .int (NLogN.KFM.gmulT Δ g h).2 ::
