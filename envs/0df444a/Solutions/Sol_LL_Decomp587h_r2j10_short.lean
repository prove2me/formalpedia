      have hvr : cellValid .tri12 m x0b x1a x1b x1a x1b := ⟨hmp, hm_le, h1p, h1le, h1p, h1le, by simp, fun _ => ⟨rfl, rfl⟩, by simp⟩
      have hsub : cellSet .tri12 ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ⊆
          cellSet .tri12 ((x0a : ℝ) / D_den) ((m : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ∪
          cellSet .tri12 ((m : ℝ) / D_den) ((x0b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) := by
        intro x hx
