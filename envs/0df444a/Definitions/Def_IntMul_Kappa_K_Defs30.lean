variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The row-major index of a box point. -/
def e18rho (x : Fin D → ℕ) : ℕ :=
  encode (binSh (initL D ℓ long).length) (addrS D (initL D ℓ long) x)

/-- The `MSB`-first bits of coordinate `i`. -/
def e18blk (x : Fin D → ℕ) (i : Fin D) : List ℕ :=
  (List.range (al D ℓ long i)).reverse.map fun h => (getBit h (x i) : ℕ)

theorem e18_ts_len : (KFV.ts18 D ℓ long).length = D := by simp [KFV.ts18]

/-- Cyclic difference of box points. -/
def subB (a : Fin D → ℕ) (x k : Fin D → ℕ) : Fin D → ℕ := fun i => (x i + 2 ^ a i - k i) % 2 ^ a i

/-! ## The two `pull`s -/

/-- The box point of row-major index `j`. -/
def e18sig (j : ℕ) : Fin D → ℕ :=
  coordS D (al D ℓ long) (initL D ℓ long) (decode (binSh (initL D ℓ long).length) j)

