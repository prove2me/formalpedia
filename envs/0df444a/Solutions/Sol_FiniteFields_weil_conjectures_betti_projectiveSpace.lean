section

/-!
# Points de `ℙⁿ_R` à valeurs dans un corps

Pour un anneau commutatif `R`, un corps `L` et `σ : R →+* L`, les points `Spec L ⟶ ℙⁿ_R`
au-dessus de `Spec σ` sont en bijection avec les droites de `Lⁿ⁺¹` (`projPointsEquiv`).

* **Recollement** : les points des cartes `i` et `j` définis par `v/vᵢ` et `v/vⱼ` coïncident,
  via la carte `D₊(XᵢXⱼ)` (`SpecMap_awayMap_awayι`).
* **La bijection** `ℙ(Lⁿ⁺¹) → ℙⁿ_R(L)`, `[v] ↦ point de la carte i défini par v/vᵢ`.

Avec `L = ℂ`, c'est la bijection sous-jacente à l'homéomorphisme d'A5b
(`ComplexPointsProj.lean`) ; avec `L = 𝔽_{q^m}`, elle compte les points.
-/

open AlgebraicGeometry CategoryTheory Opposite MvPolynomial HomogeneousLocalization
open scoped LinearAlgebra.Projectivization

namespace FiniteFields.Betti

theorem top_le_preimage_iff_forall {L : Type} [Field L] {Y : Scheme.{0}} (x : Spec (.of L) ⟶ Y)
    (U : Y.Opens) : ⊤ ≤ x ⁻¹ᵁ U ↔ ∀ p, x.base p ∈ U :=
  ⟨fun h p ↦ h (show p ∈ (⊤ : (Spec (.of L)).Opens) from trivial), fun h p _ ↦ h p⟩

section Glue

open ProjCharts

attribute [local instance] MvPolynomial.gradedAlgebra

variable {R : Type} [CommRing R] {L : Type} [Field L] (σ : R →+* L) {n : ℕ}

/-- Évaluation `𝒜_(f) → L`, `a / fᵐ ↦ a(v) / f(v)ᵐ`, pour `f(v) ≠ 0`. -/
noncomputable def evAway (f : MvPolynomial (Fin (n + 1)) R) (v : Fin (n + 1) → L)
    (hv : eval₂ σ v f ≠ 0) : Away (Grading R n) f →+* L :=
  (IsLocalization.Away.lift (S := Localization.Away f) f (g := eval₂Hom σ v)
    (isUnit_iff_ne_zero.mpr hv)).comp
    (algebraMap (Away (Grading R n) f) (Localization.Away f))

theorem evAway_mk (f : MvPolynomial (Fin (n + 1)) R) (v : Fin (n + 1) → L)
    (hv : eval₂ σ v f ≠ 0) {d : ℕ} (hf : f ∈ Grading R n d) (m : ℕ) (a : MvPolynomial (Fin (n + 1)) R)
    (ha : a ∈ Grading R n (m • d)) :
    evAway σ f v hv (Away.mk (Grading R n) hf m a ha) = eval₂ σ v a / eval₂ σ v f ^ m := by
  rw [eq_div_iff (pow_ne_zero m hv)]
  have hs : f ^ m ∈ Submonoid.powers f := ⟨m, rfl⟩
  have key : algebraMap (Away (Grading R n) f) (Localization.Away f)
      (Away.mk (Grading R n) hf m a ha) * algebraMap _ (Localization.Away f) (f ^ m) =
      algebraMap _ (Localization.Away f) a := by
    rw [HomogeneousLocalization.algebraMap_apply, Away.val_mk, Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec _ a ⟨f ^ m, hs⟩
  have := congrArg (IsLocalization.Away.lift (S := Localization.Away f) f (g := eval₂Hom σ v)
    (isUnit_iff_ne_zero.mpr hv)) key
  rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at this
  simpa [evAway] using this

/-- Le vecteur normalisé `v / vᵢ`. -/
noncomputable def nv (i : Fin (n + 1)) (v : Fin (n + 1) → L) : Fin (n + 1) → L := fun k ↦ v k / v i

theorem nv_self {i : Fin (n + 1)} {v : Fin (n + 1) → L} (hv : v i ≠ 0) : nv i v i = 1 :=
  div_self hv

/-- **Compatibilité des cartes** : `evAway (XᵢXⱼ) ∘ awayMap = chartEval i (v/vᵢ)`. -/
theorem evAway_comp_awayMap (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hi : v i ≠ 0)
    (hj : v j ≠ 0) (x : MvPolynomial (Fin (n + 1)) R) (hx : x = X i * X j) :
    (evAway σ x v (by subst hx; simp [hi, hj])).comp
        (awayMap (Grading R n) (X_mem_grading R n j) hx) =
      chartEval σ i (nv i v) (nv_self hi) := by
  refine chart_hom_ext ?_ (chartEval_comp_base σ i _ _) fun k ↦ ?_
  · ext r
    simp only [RingHom.comp_apply, chartBase]
    rw [show (algebraMap (Grading R n 0) (Chart R n i)) = fromZeroRingHom _ _ from rfl,
      awayMap_fromZeroRingHom]
    simp only [evAway, fromZeroRingHom, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
    erw [HomogeneousLocalization.val_mk]
    erw [Localization.mk_one_eq_algebraMap, IsLocalization.Away.lift_eq]
    exact eval₂_C σ v r
  · rw [chartEval_ratio, RingHom.comp_apply, ratio, awayMap_mk, evAway_mk]
    subst hx
    simp only [pow_one, nv, eval₂_mul, eval₂_X]
    field_simp

/-- Le point de la carte `i` de vecteur `w` (`wᵢ = 1`). -/
noncomputable def ptOf' (i : Fin (n + 1)) (w : Fin (n + 1) → L) (hw : w i = 1) :
    Spec (.of L) ⟶ projectiveSpaceOver R n :=
  chartPoint i (chartEval σ i w hw)

/-- Le point de `[v]` vu dans la carte `i` (`vᵢ ≠ 0`). -/
noncomputable def ptOf (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    Spec (.of L) ⟶ projectiveSpaceOver R n :=
  ptOf' σ i (nv i v) (nv_self hv)

theorem ptOf'_congr (i : Fin (n + 1)) {w w' : Fin (n + 1) → L} (h : w = w') (hw : w i = 1)
    (hw' : w' i = 1) : ptOf' σ i w hw = ptOf' σ i w' hw' := by
  subst h
  rfl

/-- **Recollement** : le point ne dépend pas de la carte. -/
theorem ptOf_eq (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hi : v i ≠ 0) (hj : v j ≠ 0) :
    ptOf σ i v hi = ptOf (R := R) σ j v hj := by
  have e1 := evAway_comp_awayMap σ i j v hi hj (X i * X j) rfl
  have e2 := evAway_comp_awayMap σ j i v hj hi (X i * X j) (mul_comm _ _)
  simp only [ptOf, ptOf', chartPoint]
  rw [← e1, ← e2, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
    Category.assoc, Category.assoc, chartι, chartι, Proj.SpecMap_awayMap_awayι,
    Proj.SpecMap_awayMap_awayι]

theorem ptOf_smul (i : Fin (n + 1)) (v : Fin (n + 1) → L) (c : L) (hc : c ≠ 0)
    (h : (c • v) i ≠ 0) (hi : v i ≠ 0) : ptOf σ i (c • v) h = ptOf (R := R) σ i v hi := by
  refine ptOf'_congr σ i (funext fun k ↦ ?_) _ _
  simp [nv, mul_div_mul_left _ _ hc]

theorem ptOf_indep {v w : Fin (n + 1) → L} (c : L) (hc : c ≠ 0) (hw : w = c • v)
    (i j : Fin (n + 1)) (hi : w i ≠ 0) (hj : v j ≠ 0) : ptOf σ i w hi = ptOf (R := R) σ j v hj := by
  subst hw
  have hi' : v i ≠ 0 := fun h ↦ hi (by simp [h])
  rw [ptOf_smul σ i v c hc hi hi']
  exact ptOf_eq σ i j v hi' hj

theorem ptOf_over (i : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    ptOf σ i v hv ≫ projectiveSpaceOver.toSpec R n = Spec.map (CommRingCat.ofHom σ) :=
  (chartPoint_over_iff σ i _).mpr (chartEval_comp_base σ i _ _)

theorem opensRange_chartι (j : Fin (n + 1)) :
    (chartι R n j).opensRange = Proj.basicOpen (Grading R n) (X j : MvPolynomial (Fin (n + 1)) R) :=
  Proj.opensRange_awayι _ _ _ _

theorem ptOf_mem_iff (i j : Fin (n + 1)) (v : Fin (n + 1) → L) (hv : v i ≠ 0) :
    ⊤ ≤ ptOf σ i v hv ⁻¹ᵁ (chartι R n j).opensRange ↔ v j ≠ 0 := by
  obtain ⟨p₀⟩ := (inferInstance : Nonempty (PrimeSpectrum L))
  rw [top_le_preimage_iff_forall, opensRange_chartι]
  simp only [ptOf, ptOf', chartPoint_mem_basicOpen_iff, chartEval_ratio, nv, div_ne_zero_iff]
  exact ⟨fun h ↦ (h p₀).1, fun h _ ↦ ⟨h, hv⟩⟩

end Glue
section Points

open ProjCharts

variable {R : Type} [CommRing R] {L : Type} [Field L] (σ : R →+* L) (n : ℕ)

/-- Les points de `ℙⁿ_R` à valeurs dans `L` au-dessus de `Spec σ`. -/
abbrev ProjPoints : Type :=
  {x : Spec (.of L) ⟶ projectiveSpaceOver R n //
    x ≫ projectiveSpaceOver.toSpec R n = Spec.map (CommRingCat.ofHom σ)}

variable {σ n}

/-- Un indice de coordonnée non nulle. -/
noncomputable def idxL {v : Fin (n + 1) → L} (hv : v ≠ 0) : Fin (n + 1) :=
  Classical.choose (Function.ne_iff.mp hv)

theorem idxL_spec {v : Fin (n + 1) → L} (hv : v ≠ 0) : v (idxL hv) ≠ 0 :=
  Classical.choose_spec (Function.ne_iff.mp hv)

variable (σ) in
/-- **L'application `ℙ(Lⁿ⁺¹) → ℙⁿ_R(L)`.** -/
noncomputable def projPt (p : ℙ L (Fin (n + 1) → L)) : ProjPoints σ n :=
  ⟨ptOf σ (idxL p.rep_nonzero) p.rep (idxL_spec p.rep_nonzero), ptOf_over σ _ _ _⟩

theorem projPt_mk (v : Fin (n + 1) → L) (hv : v ≠ 0) (i : Fin (n + 1)) (hi : v i ≠ 0) :
    (projPt (R := R) σ (Projectivization.mk L v hv)).1 = ptOf σ i v hi := by
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep L v hv
  exact ptOf_indep σ (c : L) c.ne_zero (by rw [← hc, Units.smul_def]) _ i (idxL_spec _) hi

theorem projPt_injective : Function.Injective (projPt (R := R) (n := n) σ) := by
  intro p p' h
  induction p using Projectivization.ind with
  | h v hv =>
  induction p' using Projectivization.ind with
  | h w hw =>
    have h1 := congrArg Subtype.val h
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hv
    obtain ⟨j, hj⟩ := Function.ne_iff.mp hw
    rw [projPt_mk v hv i hi, projPt_mk w hw j hj] at h1
    have hwi : w i ≠ 0 := by
      have := (ptOf_mem_iff σ i i v hi).mpr hi
      rw [h1] at this
      exact (ptOf_mem_iff σ j i w hj).mp this
    rw [← ptOf_eq σ i j w hwi hj] at h1
    have h2 := chartPoint_injective i h1
    have h3 : ∀ k, v k / v i = w k / w i := fun k ↦ by
      have := congrArg (fun φ ↦ φ (ratio i k)) h2
      simpa [chartEval_ratio, nv] using this
    have hi' : v i ≠ 0 := by simpa using hi
    refine (Projectivization.mk_eq_mk_iff' L _ _ _ _).mpr ⟨v i / w i, funext fun k ↦ ?_⟩
    have := h3 k
    rw [div_eq_div_iff hi' hwi] at this
    rw [Pi.smul_apply, smul_eq_mul, div_mul_eq_mul_div, div_eq_iff hwi]
    linear_combination -this

theorem projPt_surjective : Function.Surjective (projPt (R := R) (n := n) σ) := by
  intro x
  obtain ⟨i, hi⟩ := exists_forall_mem_basicOpen x.1
  obtain ⟨φ, hφ⟩ := exists_chartPoint x.1 i hi
  have hbase : φ.comp (chartBase R n i) = σ :=
    (chartPoint_over_iff σ i φ).mp (by rw [hφ]; exact x.2)
  let v : Fin (n + 1) → L := fun j ↦ φ (ratio i j)
  have hvi : v i = 1 := by
    change φ (ratio i i) = 1
    rw [ratio_self]
    exact φ.map_one
  have hv : v ≠ 0 := fun h ↦ one_ne_zero (hvi ▸ congrFun h i)
  refine ⟨Projectivization.mk L v hv, Subtype.ext ?_⟩
  rw [projPt_mk v hv i (by rw [hvi]; exact one_ne_zero), ptOf,
    ptOf'_congr σ i (w' := v) (funext fun k ↦ by simp [nv, hvi]) _ hvi, ptOf', ← hφ]
  congr 1
  exact chart_hom_ext (chartEval_comp_base σ i _ _) hbase fun j ↦ chartEval_ratio σ i _ _ j

variable (σ n) in
/-- **Bijection `ℙ(Lⁿ⁺¹) ≃ ℙⁿ_R(L)`.** -/
noncomputable def projPointsEquiv : ℙ L (Fin (n + 1) → L) ≃ ProjPoints σ n :=
  Equiv.ofBijective (projPt σ) ⟨projPt_injective, projPt_surjective⟩

end Points

end FiniteFields.Betti

end

/-! ## Recopié de `Bridge/Betti/WeilBettiProjectiveSpace.lean` -/

section

/-!
# Jalon `ℙⁿ` de la partie 4 de Weil

* **Points.** Si `X` est la fibre de `ℙⁿ_R` le long de `ρ : R →+* k`, ses points à valeurs dans
  une extension `L` de `k` sont ceux de `ℙⁿ_R` au-dessus de `R → k → L` (propriété universelle
  du produit fibré), donc les droites de `Lⁿ⁺¹` (`projPointsEquiv`). C'est aussi le cas de `ℙⁿ_k`.
  Les deux schémas ont donc la même fonction zêta, calculée par `projectiveSpace_zeta`.
* **Polynômes.** `P_{2i} = 1 - qⁱT` pour `i ≤ n`, `P_{impair} = 1`, et `α_{2i} = {qⁱ}`.
  L'équation fonctionnelle vaut avec `ε = (-1)ⁿ⁺¹` et `χ = n + 1`.
* **Betti.** `ℙⁿ_R(ℂ) ≃ₜ ℂPⁿ` (A5b), donc `b_{2i} = 1` et `b_{impair} = 0` (A3 avec `R = ℚ`).
-/

open AlgebraicGeometry CategoryTheory Polynomial WeilConjectures
open scoped LinearAlgebra.Projectivization

namespace FiniteFields.Betti

section Points

variable {k : Type} [Field k] {R : Type} [CommRing R] (ρ : R →+* k) {n : ℕ}
  {X : Scheme.{0}} {f : X ⟶ Spec (.of k)} {j : X ⟶ projectiveSpaceOver R n}

/-- Les points de la fibre `X` à valeurs dans `L` sont ceux de `ℙⁿ_R` au-dessus de `R → k → L`. -/
noncomputable def fiberPointsEquiv
    (hpb : IsPullback j f (projectiveSpaceOver.toSpec R n) (Spec.map (CommRingCat.ofHom ρ)))
    (L : Type) [Field L] [Algebra k L] :
    {x : Spec (.of L) ⟶ X // x ≫ f = Spec.map (CommRingCat.ofHom (algebraMap k L))} ≃
      ProjPoints ((algebraMap k L).comp ρ) n where
  toFun y := ⟨y.1 ≫ j, by
    rw [Category.assoc, hpb.w, ← Category.assoc, y.2, ← Spec.map_comp, ← CommRingCat.ofHom_comp]⟩
  invFun z := ⟨hpb.lift z.1 (Spec.map (CommRingCat.ofHom (algebraMap k L))) (by
    rw [z.2, ← Spec.map_comp, ← CommRingCat.ofHom_comp]), hpb.lift_snd _ _ _⟩
  left_inv y := Subtype.ext (hpb.hom_ext (by simp) (by simp [y.2]))
  right_inv z := Subtype.ext (hpb.lift_fst _ _ _)

theorem pointsOver_fiber
    (hpb : IsPullback j f (projectiveSpaceOver.toSpec R n) (Spec.map (CommRingCat.ofHom ρ)))
    (L : Type) [Field L] [Algebra k L] :
    pointsOver f L = Nat.card (ℙ L (Fin (n + 1) → L)) :=
  Nat.card_congr ((fiberPointsEquiv ρ hpb L).trans (projPointsEquiv _ n).symm)

theorem pointsOver_projectiveSpace (L : Type) [Field L] [Algebra k L] :
    pointsOver (projectiveSpace.toSpec k n) L = Nat.card (ℙ L (Fin (n + 1) → L)) :=
  Nat.card_congr (projPointsEquiv (R := k) (algebraMap k L) n).symm

theorem zetaFunction_fiber (p : ℕ) [Fact p.Prime] [Finite k] [CharP k p]
    (hpb : IsPullback j f (projectiveSpaceOver.toSpec R n) (Spec.map (CommRingCat.ofHom ρ))) :
    zetaFunction p f = zetaFunction p (projectiveSpace.toSpec k n) := by
  unfold zetaFunction
  congr 1
  funext m
  unfold pointCount
  split_ifs
  · rfl
  · rw [pointsOver_fiber ρ hpb, pointsOver_projectiveSpace]

end Points

section Poly

/-- Les indices pairs `≤ 2n` sont les `2i`, `i ≤ n`. -/
theorem filter_even_range (n : ℕ) :
    (Finset.range (2 * n + 1)).filter Even =
      (Finset.range (n + 1)).map ⟨fun i ↦ 2 * i, fun _ _ h ↦ by simpa using h⟩ := by
  ext i
  simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_map]
  constructor
  · rintro ⟨hi, j, rfl⟩
    exact ⟨j, by omega, show 2 * j = j + j by ring⟩
  · rintro ⟨j, hj, rfl⟩
    exact ⟨show 2 * j < 2 * n + 1 by omega, even_two_mul j⟩

theorem prod_filter_even {M : Type*} [CommMonoid M] (n : ℕ) (g : ℕ → M) :
    ∏ i ∈ (Finset.range (2 * n + 1)).filter Even, g i = ∏ i ∈ Finset.range (n + 1), g (2 * i) := by
  rw [filter_even_range, Finset.prod_map]
  rfl

theorem card_filter_even (n : ℕ) : ((Finset.range (2 * n + 1)).filter Even).card = n + 1 := by
  rw [filter_even_range, Finset.card_map, Finset.card_range]

theorem natDegree_one_sub_C_mul_X {S : Type*} [CommRing S] [Nontrivial S] {c : S} (hc : c ≠ 0) :
    (1 - C c * X : S[X]).natDegree = 1 := by
  have : (1 - C c * X : S[X]) = C (-c) * X + C 1 := by simp; ring
  rw [this, natDegree_linear (neg_ne_zero.mpr hc)]

/-- `∑_{j ≤ n} (n - j) = n (n + 1) / 2`, sous la forme `2 ∑ = n (n + 1)`. -/
theorem sum_range_sub_mul_two (n : ℕ) :
    (∑ j ∈ Finset.range (n + 1), (n - j)) * 2 = n * (n + 1) := by
  have h := Finset.sum_range_reflect (fun j ↦ j) (n + 1)
  simp only [add_tsub_cancel_right] at h
  rw [h, Finset.sum_range_id_mul_two, add_tsub_cancel_right, mul_comm]

/-- **Équation fonctionnelle de `∏_{j ≤ n} (1 - qʲ t)`** :
`E(t) = (-1)ⁿ⁺¹ q^{n(n+1)/2} tⁿ⁺¹ E(1/(qⁿ t))`. -/
theorem prod_one_sub_functional {F : Type*} [Field F] (q t : F) (hq : q ≠ 0) (ht : t ≠ 0) (n : ℕ) :
    ∏ j ∈ Finset.range (n + 1), (1 - q ^ j * t) =
      (-1) ^ (n + 1) * q ^ (∑ j ∈ Finset.range (n + 1), (n - j)) * t ^ (n + 1) *
        ∏ j ∈ Finset.range (n + 1), (1 - q ^ j * (q ^ n * t)⁻¹) := by
  rw [← Finset.prod_range_reflect (fun j ↦ 1 - q ^ j * t) (n + 1), ← Finset.prod_pow_eq_pow_sum]
  have h1 : ((-1 : F)) ^ (n + 1) = ∏ _j ∈ Finset.range (n + 1), (-1 : F) := by simp
  have h2 : t ^ (n + 1) = ∏ _j ∈ Finset.range (n + 1), t := by simp
  rw [h1, h2, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun j hj ↦ ?_
  have hj : j ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
  simp only [add_tsub_cancel_right]
  have hqn : q ^ (n - j) * q ^ j = q ^ n := by rw [← pow_add, Nat.sub_add_cancel hj]
  field_simp
  linear_combination -hqn

end Poly

section Main

/-- Les polynômes de `ℙⁿ` : `P_{2i} = 1 - qⁱT`, `P_{impair} = 1`. -/
noncomputable def projP (q : ℕ) (i : ℕ) : ℤ[X] :=
  if Even i then 1 - C ((q : ℤ) ^ (i / 2)) * X else 1

/-- Les inverses des racines de `P_i` : `α_{2i} = {qⁱ}`, `α_{impair} = ∅`. -/
noncomputable def projα (q : ℕ) (i : ℕ) : Multiset ℂ :=
  if Even i then {(q : ℂ) ^ (i / 2)} else 0

theorem natDegree_projP {q : ℕ} (hq : q ≠ 0) (i : ℕ) :
    (projP q i).natDegree = if Even i then 1 else 0 := by
  unfold projP
  split_ifs
  · exact natDegree_one_sub_C_mul_X (pow_ne_zero _ (by exact_mod_cast hq))
  · exact natDegree_one

theorem projP_two_mul (q j : ℕ) : projP q (2 * j) = 1 - C ((q : ℤ) ^ j) * X := by
  rw [projP, if_pos (even_two_mul j), Nat.mul_div_cancel_left j two_pos]

theorem projP_of_odd (q : ℕ) {i : ℕ} (hi : Odd i) : projP q i = 1 :=
  if_neg (Nat.not_even_iff_odd.mpr hi)

/-- La caractéristique d'Euler `∑ (-1)ⁱ deg P_i = n + 1`. -/
theorem chi_projP {q : ℕ} (hq : q ≠ 0) (n : ℕ) :
    ∑ i ∈ Finset.range (2 * n + 1), (-1 : ℤ) ^ i * ((projP q i).natDegree : ℤ) = n + 1 := by
  rw [← Finset.sum_filter_add_sum_filter_not _ Even]
  have h1 : ∑ i ∈ (Finset.range (2 * n + 1)).filter Even,
      (-1 : ℤ) ^ i * ((projP q i).natDegree : ℤ) =
        ∑ i ∈ (Finset.range (2 * n + 1)).filter Even, (1 : ℤ) :=
    Finset.sum_congr rfl fun i hi ↦ by
      have h := (Finset.mem_filter.mp hi).2
      rw [natDegree_projP hq, if_pos h, h.neg_one_pow]
      simp
  have h2 : ∑ i ∈ (Finset.range (2 * n + 1)).filter (fun i ↦ ¬Even i),
      (-1 : ℤ) ^ i * ((projP q i).natDegree : ℤ) = 0 :=
    Finset.sum_eq_zero fun i hi ↦ by
      have h := (Finset.mem_filter.mp hi).2
      rw [natDegree_projP hq, if_neg h]
      simp
  rw [h1, h2, Finset.sum_const, card_filter_even]
  simp

/-- **Nombres de Betti de `ℙⁿ_R(ℂ)`** : `b_{2i} = 1` pour `i ≤ n`, `b_{impair} = 0`. -/
theorem betti_projectiveSpace (R : Type) [CommRing R] (σ : R →+* ℂ) (n i : ℕ) (hi : i ≤ 2 * n) :
    FiniteDimensional ℚ (rationalHomology i (ComplexPoints σ (projectiveSpaceOver.toSpec R n))) ∧
      bettiNumber i (ComplexPoints σ (projectiveSpaceOver.toSpec R n)) =
        if Even i then 1 else 0 := by
  obtain ⟨h⟩ := FiniteFields.Betti.complexPoints_projectiveSpace_homeomorph R σ n
  let e : rationalHomology i (ComplexPoints σ (projectiveSpaceOver.toSpec R n)) ≅
      Hatcher.Singular.H ℚ i (Hatcher.CP n) :=
    ((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℚ) i).obj
      (ModuleCat.of ℚ ℚ)).mapIso (TopCat.isoOfHomeo h)
  obtain ⟨hodd, heven⟩ := Hatcher.Singular.complexProjectiveSpace_homology ℚ n
  unfold bettiNumber
  split_ifs with he
  · have hi2 : i = 2 * (i / 2) := by have := Nat.even_iff.mp he; omega
    obtain ⟨e'⟩ := heven (i / 2) (by omega)
    rw [← hi2] at e'
    let l := (e ≪≫ e').toLinearEquiv
    exact ⟨LinearEquiv.finiteDimensional l.symm, l.finrank_eq.trans (Module.finrank_self ℚ)⟩
  · have hz := (hodd i (Or.inl (Nat.not_even_iff_odd.mp he))).of_iso e
    have := ModuleCat.subsingleton_of_isZero hz
    exact ⟨inferInstance, Module.finrank_zero_of_subsingleton⟩

end Main

theorem weil_conjectures_betti_projectiveSpace_proof (p : ℕ) [Fact p.Prime] (k : Type) [Field k] [Finite k]
    [CharP k p] (R : Type) [CommRing R] (ρ : R →+* k) (σ : R →+* ℂ) (n : ℕ)
    (X : Scheme.{0}) (f : X ⟶ Spec (.of k)) (j : X ⟶ projectiveSpaceOver R n)
    (hpb : IsPullback j f (projectiveSpaceOver.toSpec R n) (Spec.map (CommRingCat.ofHom ρ))) :
    ∃ (P : ℕ → ℤ[X]) (α : ℕ → Multiset ℂ),
      zetaFunction p f *
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
            ((P i).map (Int.castRingHom ℚ) : PowerSeries ℚ)) =
        ∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
            ((P i).map (Int.castRingHom ℚ) : PowerSeries ℚ) ∧
      P 0 = 1 - Polynomial.X ∧
      P (2 * n) = 1 - C ((Nat.card k : ℤ) ^ n) * Polynomial.X ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 →
        (P i).map (Int.castRingHom ℂ) = ((α i).map fun a => 1 - C a * Polynomial.X).prod ∧
        ∀ a ∈ α i, a ≠ 0) ∧
      (∃ ε : ℂ, (ε = 1 ∨ ε = -1) ∧
        ∀ t : ℂ, t ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even, aeval t (P i)) ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
              aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
                aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) /
              (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
                aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) =
            ε * (((Nat.card k : ℝ) ^ ((n : ℝ) *
                ((∑ i ∈ Finset.range (2 * n + 1), (-1 : ℤ) ^ i * ((P i).natDegree : ℤ) : ℤ) : ℝ)
                  / 2) : ℝ) : ℂ) *
              t ^ (∑ i ∈ Finset.range (2 * n + 1), (-1 : ℤ) ^ i * ((P i).natDegree : ℤ)) *
              ((∏ i ∈ (Finset.range (2 * n + 1)).filter Odd, aeval t (P i)) /
                (∏ i ∈ (Finset.range (2 * n + 1)).filter Even, aeval t (P i)))) ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 →
        α (2 * n - i) = (α i).map fun a => (Nat.card k : ℂ) ^ n / a) ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 → ∀ a ∈ α i,
        ‖a‖ = (Nat.card k : ℝ) ^ ((i : ℝ) / 2)) ∧
      (∀ i, i ≤ 2 * n →
        FiniteDimensional ℚ (rationalHomology i (ComplexPoints σ (projectiveSpaceOver.toSpec R n))) ∧
          (P i).natDegree = bettiNumber i (ComplexPoints σ (projectiveSpaceOver.toSpec R n)))
    := by
  have hq : Nat.card k ≠ 0 := Nat.card_pos.ne'
  have hqC : (Nat.card k : ℂ) ≠ 0 := by exact_mod_cast hq
  have hodd : ∀ g : ℕ → ℂ, (∀ i, Odd i → g i = 1) →
      ∏ i ∈ (Finset.range (2 * n + 1)).filter Odd, g i = 1 := fun g hg ↦
    Finset.prod_eq_one fun i hi ↦ hg i (Finset.mem_filter.mp hi).2
  refine ⟨projP (Nat.card k), projα (Nat.card k), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- la fonction zêta, par `projectiveSpace_zeta`
    have hO1 : ∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
        (((projP (Nat.card k) i).map (Int.castRingHom ℚ) : ℚ[X]) : PowerSeries ℚ) = 1 :=
      Finset.prod_eq_one fun i hi ↦ by rw [projP_of_odd _ (Finset.mem_filter.mp hi).2]; simp
    have hEv : ∏ j ∈ Finset.range (n + 1),
        (((projP (Nat.card k) (2 * j)).map (Int.castRingHom ℚ) : ℚ[X]) : PowerSeries ℚ) =
          ∏ j ∈ Finset.range (n + 1),
            (1 - PowerSeries.C ((Nat.card k : ℚ) ^ j) * PowerSeries.X) :=
      Finset.prod_congr rfl fun j _ ↦ by
        rw [projP_two_mul, Polynomial.map_sub, Polynomial.map_one, Polynomial.map_mul,
          Polynomial.map_C, Polynomial.map_X, Polynomial.coe_sub, Polynomial.coe_one,
          Polynomial.coe_mul, Polynomial.coe_C, Polynomial.coe_X]
        simp
    rw [hO1, prod_filter_even, hEv, zetaFunction_fiber ρ p hpb]
    exact (WeilConjectures.projectiveSpace_zeta p k n).2
  · simp [projP]
  · rw [projP_two_mul]
  · intro i _ _
    unfold projP projα
    split_ifs
    · simp [hq]
    · simp
  · -- équation fonctionnelle, avec `ε = (-1)ⁿ⁺¹`
    refine ⟨(-1) ^ (n + 1), neg_one_pow_eq_or ℂ (n + 1), fun t ht hE hE' ↦ ?_⟩
    have hO : ∀ u : ℂ, ∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
        aeval u (projP (Nat.card k) i) = 1 := fun u ↦
      hodd _ fun i hi ↦ by rw [projP_of_odd _ hi]; simp
    have hEv : ∀ u : ℂ, ∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
        aeval u (projP (Nat.card k) i) =
          ∏ j ∈ Finset.range (n + 1), (1 - (Nat.card k : ℂ) ^ j * u) := fun u ↦ by
      rw [prod_filter_even]
      refine Finset.prod_congr rfl fun j _ ↦ ?_
      rw [projP_two_mul]
      simp
    rw [chi_projP hq] at *
    rw [hO, hO, hEv, hEv] at *
    have hS := sum_range_sub_mul_two n
    have hreal : (n : ℝ) * (((n : ℤ) + 1 : ℤ) : ℝ) / 2 =
        ((∑ j ∈ Finset.range (n + 1), (n - j) : ℕ) : ℝ) := by
      have : ((∑ j ∈ Finset.range (n + 1), (n - j) : ℕ) : ℝ) * 2 = n * (n + 1) := by
        exact_mod_cast hS
      rw [div_eq_iff two_ne_zero, this]
      push_cast
      ring
    rw [hreal, Real.rpow_natCast, show ((n : ℤ) + 1) = ((n + 1 : ℕ) : ℤ) by push_cast; ring,
      zpow_natCast, prod_one_sub_functional _ t hqC ht n]
    push_cast
    field_simp
  · -- dualité
    intro i hi1 hi2
    have he' : Even (2 * n - i) ↔ Even i := by
      rw [Nat.even_sub (by omega)]
      simp
    unfold projα
    by_cases he : Even i
    · rw [if_pos (he'.mpr he), if_pos he, Multiset.map_singleton]
      congr 1
      have := Nat.even_iff.mp he
      rw [eq_div_iff (pow_ne_zero _ hqC), ← pow_add]
      congr 1
      omega
    · rw [if_neg (mt he'.mp he), if_neg he, Multiset.map_zero]
  · -- hypothèse de Riemann
    intro i _ _ a ha
    unfold projα at ha
    split_ifs at ha with he
    · rw [Multiset.mem_singleton] at ha
      subst ha
      rw [norm_pow, Complex.norm_natCast, ← Real.rpow_natCast,
        Nat.cast_div (even_iff_two_dvd.mp he) two_ne_zero]
      norm_num
    · simp at ha
  · -- nombres de Betti
    intro i hi
    obtain ⟨hfin, hb⟩ := betti_projectiveSpace R σ n i hi
    exact ⟨hfin, by rw [natDegree_projP hq, hb]⟩


end FiniteFields.Betti

end

/-! ## Solution (statement copied verbatim) -/

open AlgebraicGeometry CategoryTheory Polynomial FiniteFields.Betti WeilConjectures

namespace FiniteFields

theorem _root_.solution (p : ℕ) [Fact p.Prime] (k : Type) [Field k] [Finite k]
    [CharP k p] (R : Type) [CommRing R] (ρ : R →+* k) (σ : R →+* ℂ) (n : ℕ)
    (X : Scheme.{0}) (f : X ⟶ Spec (.of k)) (j : X ⟶ projectiveSpaceOver R n)
    (hpb : IsPullback j f (projectiveSpaceOver.toSpec R n) (Spec.map (CommRingCat.ofHom ρ))) :
    ∃ (P : ℕ → ℤ[X]) (α : ℕ → Multiset ℂ),
      zetaFunction p f *
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
            ((P i).map (Int.castRingHom ℚ) : PowerSeries ℚ)) =
        ∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
            ((P i).map (Int.castRingHom ℚ) : PowerSeries ℚ) ∧
      P 0 = 1 - Polynomial.X ∧
      P (2 * n) = 1 - C ((Nat.card k : ℤ) ^ n) * Polynomial.X ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 →
        (P i).map (Int.castRingHom ℂ) = ((α i).map fun a => 1 - C a * Polynomial.X).prod ∧
        ∀ a ∈ α i, a ≠ 0) ∧
      (∃ ε : ℂ, (ε = 1 ∨ ε = -1) ∧
        ∀ t : ℂ, t ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even, aeval t (P i)) ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
              aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) ≠ 0 →
          (∏ i ∈ (Finset.range (2 * n + 1)).filter Odd,
                aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) /
              (∏ i ∈ (Finset.range (2 * n + 1)).filter Even,
                aeval (((Nat.card k : ℂ) ^ n * t)⁻¹) (P i)) =
            ε * (((Nat.card k : ℝ) ^ ((n : ℝ) *
                ((∑ i ∈ Finset.range (2 * n + 1), (-1 : ℤ) ^ i * ((P i).natDegree : ℤ) : ℤ) : ℝ)
                  / 2) : ℝ) : ℂ) *
              t ^ (∑ i ∈ Finset.range (2 * n + 1), (-1 : ℤ) ^ i * ((P i).natDegree : ℤ)) *
              ((∏ i ∈ (Finset.range (2 * n + 1)).filter Odd, aeval t (P i)) /
                (∏ i ∈ (Finset.range (2 * n + 1)).filter Even, aeval t (P i)))) ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 →
        α (2 * n - i) = (α i).map fun a => (Nat.card k : ℂ) ^ n / a) ∧
      (∀ i, 1 ≤ i → i ≤ 2 * n - 1 → ∀ a ∈ α i,
        ‖a‖ = (Nat.card k : ℝ) ^ ((i : ℝ) / 2)) ∧
      (∀ i, i ≤ 2 * n →
        FiniteDimensional ℚ (rationalHomology i (ComplexPoints σ (projectiveSpaceOver.toSpec R n))) ∧
          (P i).natDegree = bettiNumber i (ComplexPoints σ (projectiveSpaceOver.toSpec R n))) :=
  Betti.weil_conjectures_betti_projectiveSpace_proof p k R ρ σ n X f j hpb

end FiniteFields
