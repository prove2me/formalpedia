theorem bwdS_zero (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) :
    bwdS P bs bts 0 = ([], []) := by simp [bwdS, bwdF]

theorem bwdS_succ (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) {j : ℕ}
    (hb : j < bs.length) (ht : j < bts.length) :
    bwdS P bs bts (j + 1) = stepB P bs[j] bts[j] (bwdS P bs bts j) := by
  unfold bwdS bwdF
  rw [← List.take_concat_get' bs j hb, ← List.take_concat_get' bts j ht,
    List.zip_append (by simp; omega), List.foldl_append]
  simp

theorem bwdS_length (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) {j : ℕ}
    (hb : j ≤ bs.length) (ht : j ≤ bts.length) : (bwdS P bs bts j).1.length = j := by
  induction j with
  | zero => simp [bwdS_zero]
  | succ j ih =>
    rw [bwdS_succ P bs bts (by omega) (by omega)]
    simp only [stepB, List.length_cons]; rw [ih (by omega) (by omega)]

