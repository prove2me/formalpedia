section
-- Source module: ThreeSumApsp.Filter.OracleScatter
/-!
# The counting oracle (Lemma 4.1): writing the answers to their candidates

`oScatter(out, qi, qj, w, base, n)` copies the `w` answers at `out` to the cells
`base + WI[i] n + WJ[i]`, where `WI` and `WJ` are the rows and the columns of the query pairs, at
`qi` and `qj`.  The answer of a query pair is a function `f` of its place `a n + b`, so a cell that
is written twice gets the same value twice.
-/

@[expose] public section

namespace Light.Filter

variable {lim : Limits} {P : Program} {d : ℕ}

/-- oScatter(out, qi, qj, w, base, n); local 6 is the counter. -/
def oScatterBody : Stmt :=
  Stmt.for 6 (Light.v 3) (.store (Light.v 4 +' Light.M (Light.v 1 +' Light.v 6) *' Light.v 5 +' Light.M (Light.v 2 +' Light.v 6)) (Light.M (Light.v 0 +' Light.v 6)))

/-- The time of oScatter. -/
def tOScatter (w : ℕ) : ℕ := 26 * w + 10

/-- The place of the query pair number `i`. -/
def oAddr (n : ℕ) (WI WJ : List ℕ) (i : ℕ) : ℕ := WI.getD i 0 * n + WJ.getD i 0

/-- What oScatter assumes. -/
structure ScatterPre (lim : Limits) (μ : ℕ → ℤ) (out qi qj w base n : ℕ) (WI WJ : List ℕ)
    (A : List ℤ) (f : ℕ → ℤ) : Prop where
  hw : (lim.space : ℤ) ≤ lim.word
  segI : SegN μ qi WI
  segJ : SegN μ qj WJ
  segA : Seg μ out A
  lenI : WI.length = w
  lenJ : WJ.length = w
  lenA : A.length = w
  ltI : ∀ x ∈ WI, x < n
  ltJ : ∀ x ∈ WJ, x < n
  val : ∀ i < w, A.getD i 0 = f (oAddr n WI WJ i)
  spaceB : base + n * n ≤ lim.space
  spaceI : qi + w ≤ lim.space
  spaceJ : qj + w ≤ lim.space
  spaceA : out + w ≤ lim.space
  apartI : Apart base (n * n) qi w
  apartJ : Apart base (n * n) qj w
  apartA : Apart base (n * n) out w

/-- The cells that the first `j` rounds have written, and no other cell, have changed. -/
def ScatterInv (μ : ℕ → ℤ) (base n : ℕ) (WI WJ : List ℕ) (f : ℕ → ℤ) (j : ℕ) (μ' : ℕ → ℤ) :
    Prop :=
  (∀ i < j, μ' (base + oAddr n WI WJ i) = f (oAddr n WI WJ i)) ∧
    ∀ a, (∀ i < j, a ≠ base + oAddr n WI WJ i) → μ' a = μ a

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.OracleLoop
/-!
# The counting oracle (Lemma 4.1): the loop over the instances

The loop has the shape of the loop of the host of Theorem 17 (`hostLoopBody`), and it reuses its
parts `hostParams` and `hostNext` with their specifications.  For each instance it writes the two
matrices, calls the counting solver, and writes the answers to the cells of their candidates
(`oScatter`).  The local `Found` of the loop of Theorem 17 holds here the place `cnt + j n²` of the
counts of the block `j` of the instance (`oBaseAt`); it moves on by `n²` when the chunks of a block
are done (`oBase`).

`oLoop_spec`: at the end every one of the `h n²` cells from `cnt` holds the count of its candidate,
and no other cell below `x` (the first matrix) has changed.
-/

@[expose] public section

namespace Light.Filter

open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3 Light.Sec3.HostLocal

variable {lim : Limits} {d : ℕ}

/-! ## The procedure -/

/-- The four calls for one instance: the two matrices, the counting solver, the answers. -/
def oCalls (pS pWriteX pWriteY pScat : ℕ) : Stmt :=
  .call pWriteX [Light.v Light.Sec3.HostLocal.MatX, Light.v Light.Sec3.HostLocal.ResAC, Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v Light.Sec3.HostLocal.ThePrime, Light.v Light.Sec3.HostLocal.PieceStart, Light.v Light.Sec3.HostLocal.Len, Light.v Residue]
    Light.Sec3.HostLocal.Unused ;;
  .call pWriteY [Light.v Light.Sec3.HostLocal.MatY, Light.v Light.Sec3.HostLocal.ResBC, Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v Light.Sec3.HostLocal.ThePrime, Light.v Light.Sec3.HostLocal.PieceStart, Light.v Light.Sec3.HostLocal.Len] Light.Sec3.HostLocal.Unused ;;
  .call pS [Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v NumPairs, Light.k 1, Light.v Light.Sec3.HostLocal.MatX, Light.v Light.Sec3.HostLocal.MatY, Light.v Light.Sec3.HostLocal.Rows +' Light.v Light.Sec3.HostLocal.Start, Light.v Light.Sec3.HostLocal.Cols +' Light.v Light.Sec3.HostLocal.Start,
    Light.v Light.Sec3.HostLocal.AdrOut, Light.v Light.Sec3.HostLocal.SolverFree] Light.Sec3.HostLocal.Unused ;;
  .call pScat [Light.v Light.Sec3.HostLocal.AdrOut, Light.v Light.Sec3.HostLocal.Rows +' Light.v Light.Sec3.HostLocal.Start, Light.v Light.Sec3.HostLocal.Cols +' Light.v Light.Sec3.HostLocal.Start, Light.v NumPairs, Light.v Light.Sec3.HostLocal.Found, Light.v Light.Sec3.HostLocal.Size] Light.Sec3.HostLocal.Unused

/-- The place of the counts of the next block, after the last chunk of a block. -/
def oBase : Stmt :=
  .ite (Light.v Light.Sec3.HostLocal.ChunkNo +' Light.k 1 =' Light.v Light.Sec3.HostLocal.NumChunks) (.set Light.Sec3.HostLocal.Found (Light.v Light.Sec3.HostLocal.Found +' Light.v Light.Sec3.HostLocal.Size *' Light.v Light.Sec3.HostLocal.Size)) .skip

/-- One round of the loop. -/
def oRound (pS pWriteX pWriteY pScat : ℕ) : Stmt :=
  hostParams ;; oCalls pS pWriteX pWriteY pScat ;; oBase ;; hostNext

/-- oLoop(n, D, p, q, chunkCount, m, ab, bc, ac, rac, rbc, qi, qj, cr, cl, cw, x, y, out, fr, 0, 0, 0,
cnt). -/
def oLoopBody (pS pWriteX pWriteY pScat : ℕ) : Stmt :=
  .set Light.Sec3.HostLocal.Inst (Light.k 0) ;; .set Light.Sec3.HostLocal.ChunkNo (Light.k 0) ;; .set Light.Sec3.HostLocal.PieceStart (Light.k 0) ;;
  .while (Light.v Light.Sec3.HostLocal.Inst <' Light.v Light.Sec3.HostLocal.NumInst) (oRound pS pWriteX pWriteY pScat)

/-! ## The data -/

/-- The number of candidates, `h n²`. -/
def oLen (X : HostData) : ℕ := X.h * (X.n * X.n)

/-- The place of the counts of the block of instance t. -/
def oBaseAt (X : HostData) (cnt t : ℕ) : ℕ := cnt + t / X.chunkCount * (X.n * X.n)

/-- The count of the candidate e. -/
def oCnt (X : HostData) (e : ℕ) : ℤ := (cntOf X.n X.q X.p X.AB X.BC X.AC e : ℤ)

/-- The candidate e is a query pair of an instance before t. -/
def ODone (X : HostData) (t e : ℕ) : Prop :=
  ∃ t' < t, ∃ i < X.w t', e = t' / X.chunkCount * (X.n * X.n) + X.place t' i

/-- The largest time of the counting solver on an instance with at most cap query pairs. -/
def oSupTime (Tn : List ℕ → ℕ) (n D cap : ℕ) : ℕ :=
  (Finset.range (cap + 1)).sup fun w => Tn [n, D, w]

/-- The time of a round, in the worst case. -/
def tORound (Tn : List ℕ → ℕ) (X : HostData) : ℕ :=
  tWriteX X.n X.D X.q + tWriteY X.n X.D X.q + oSupTime Tn X.n X.D X.cap + tOScatter X.cap + 104

/-- The time of the loop. -/
def tOLoop (Tn : List ℕ → ℕ) (X : HostData) : ℕ := X.m * (4 + tORound Tn X) + 10

/-- The context of the loop: a solver of #Lop-AE-SparseTri, and the procedures writeX, writeY and
oScatter in the program. -/
structure OCtx (P₀ R : Program) (pS pWriteX pWriteY pScat : ℕ) (Tn : List ℕ → ℕ)
    (need : List ℕ → Light.Need) : Prop where
  sol : SolvesN lopCountTask P₀ pS Tn need
  writeX : (P₀ ++ R)[pWriteX]? = some writeXBody
  writeY : (P₀ ++ R)[pWriteY]? = some writeYBody
  scat : (P₀ ++ R)[pScat]? = some oScatterBody

/-- What the loop assumes: what the loop of Theorem 17 assumes, in the first memory μ₀, and the
place of the `h n²` counts meets none of the arrays that the loop reads. -/
structure OSetting (lim : Limits) (d : ℕ) (X : HostData) (U : ℕ) (A : HostAddr)
    (need : List ℕ → Light.Need) (cnt : ℕ) (μ₀ : ℕ → ℤ) : Prop where
  ok : HostOk X U
  mem : HostMem X A μ₀
  lay : HostLay X A
  fits : HostLim lim d X U A need
  apAB : Apart A.ab (X.n * X.n) cnt (oLen X)
  apBC : Apart A.bc (X.n * X.n) cnt (oLen X)
  apAC : Apart A.ac (X.n * X.n) cnt (oLen X)
  lowRAC : cnt + oLen X ≤ A.rac
  lowRBC : cnt + oLen X ≤ A.rbc
  lowQI : cnt + oLen X ≤ A.qi
  lowQJ : cnt + oLen X ≤ A.qj
  lowCR : cnt + oLen X ≤ A.cr
  lowCL : cnt + oLen X ≤ A.cl
  lowCW : cnt + oLen X ≤ A.cw

/-- The memory before instance t: below `x`, only counts have changed, and the counts of the
candidates of the instances before t are written. -/
def OMem (X : HostData) (A : HostAddr) (cnt : ℕ) (μ₀ μ : ℕ → ℤ) (t : ℕ) : Prop :=
  SameOn (fun a => a < A.x ∧ Outside cnt (oLen X) a) μ₀ μ ∧
    ∀ e < oLen X, ODone X t e → μ (cnt + e) = oCnt X e

/-! ## Facts about the data -/

section facts

variable {X : HostData} {U : ℕ} {A : HostAddr} {need : List ℕ → Need} {cnt : ℕ} {μ₀ : ℕ → ℤ}

end facts

/-! ## The parts of a round -/

variable {P₀ R : Program} {pS pWriteX pWriteY pScat : ℕ} {Tn : List ℕ → ℕ}
  {need : List ℕ → Need} {X : HostData} {U : ℕ} {A : HostAddr} {cnt : ℕ} {μ₀ : ℕ → ℤ} {t : ℕ}

/-- The time of the four calls of instance t. -/
def tOCalls (Tn : List ℕ → ℕ) (X : HostData) (t : ℕ) : ℕ :=
  tWriteX X.n X.D (X.len t) + tWriteY X.n X.D (X.len t) + Tn [X.n, X.D, X.w t] +
    tOScatter (X.w t) + 47

/-! ## The loop -/

/-- The invariant of the loop, before instance t. -/
def OInv (X : HostData) (A : HostAddr) (cnt : ℕ) (μ₀ : ℕ → ℤ) (t : ℕ) (σ : State) : Prop :=
  ∃ (len rho lo w res : ℤ) (μ : ℕ → ℤ),
    σ = hostState X A t (t % X.chunkCount) (X.c0 t) (oBaseAt X cnt t : ℕ) len rho lo w res μ ∧
    OMem X A cnt μ₀ μ t

/-- The arguments of the loop. -/
def oLoopArgs (X : HostData) (A : HostAddr) (cnt : ℕ) : List ℤ :=
  hostLoopArgs X A ++ [0, 0, 0, (cnt : ℤ)]

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.OracleCore
/-!
# The counting oracle (Lemma 4.1): the core procedure

The core procedure of the oracle gets its locals in the layout of the host of Theorem 17 (`Et17`),
with the place `cnt` of the counts in the local `ParG` and the block size `s` in `RootD`, so that the
parts of that host can be reused: the addresses (`et17Addr_spec`), the table of doubles and the
residues (`resid_then`), the classes and the chunks (`classes_then`).  Then it runs the loop over
the instances (`oLoop_spec`).

`oCore_spec`: afterwards the place `cnt` holds the counts of all candidates, and no other cell below
the free pointer has changed.
-/

@[expose] public section

namespace Light.Filter

open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3 Light.Sec3.Et17

variable {lim : Limits} {d : ℕ}

/-- The numbers of the procedures of the oracle. -/
structure ONums : Type where
  pS : ℕ
  pCeil : ℕ
  pBitLen : ℕ
  pDbl : ℕ
  pResid : ℕ
  pResidues : ℕ
  pClasses : ℕ
  pChunks : ℕ
  pWriteX : ℕ
  pWriteY : ℕ
  pScat : ℕ
  pLoop : ℕ
  pCore : ℕ

/-- oCore(n, U, ab, bc, ac, fr, D, cnt, s, p, cap, s, h, bits), in the locals of et17. -/
def oCoreBody (ν : ONums) : Stmt :=
  et17Addr ;;
  .call ν.pDbl [Light.v Light.Sec3.Et17.Free, Light.v ThePrime, Light.v Bits] Light.Sec3.Et17.Small ;;
  .call ν.pResidues [Light.v Light.Sec3.Et17.AdrAB, Light.v ResAB, Light.v SizeSq, Light.v Light.Sec3.Et17.Free, Light.v Bits] Light.Sec3.Et17.Small ;;
  .call ν.pResidues [Light.v Light.Sec3.Et17.AdrBC, Light.v ResBC, Light.v SizeSq, Light.v Light.Sec3.Et17.Free, Light.v Bits] Light.Sec3.Et17.Small ;;
  .call ν.pResidues [Light.v Light.Sec3.Et17.AdrAC, Light.v ResAC, Light.v SizeSq, Light.v Light.Sec3.Et17.Free, Light.v Bits] Light.Sec3.Et17.Small ;;
  .call ν.pClasses [Light.v ResAB, Light.v Light.Sec3.Et17.Size, Light.v ThePrime, Light.v Cls, Light.v Light.Sec3.Et17.Cur, Light.v Light.Sec3.Et17.Rows, Light.v Light.Sec3.Et17.Cols] Light.Sec3.Et17.Small ;;
  .call ν.pChunks [Light.v Cls, Light.v ThePrime, Light.v Cap, Light.v TabR, Light.v TabL, Light.v TabW] NumChunks ;;
  .set NumInst (Light.v NumPieces *' Light.v NumChunks) ;;
  .call ν.pLoop [Light.v Light.Sec3.Et17.Size, Light.v ParD, Light.v ThePrime, Light.v PieceLen, Light.v NumChunks, Light.v NumInst, Light.v Light.Sec3.Et17.AdrAB, Light.v Light.Sec3.Et17.AdrBC,
    Light.v Light.Sec3.Et17.AdrAC, Light.v ResAC, Light.v ResBC, Light.v Light.Sec3.Et17.Rows, Light.v Light.Sec3.Et17.Cols, Light.v TabR, Light.v TabL, Light.v TabW, Light.v Light.Sec3.Et17.MatX, Light.v Light.Sec3.Et17.MatY, Light.v AdrOut,
    Light.v Light.Sec3.Et17.SolverFree, Light.k 0, Light.k 0, Light.k 0, Light.v ParG] 0

/-- The context of the core procedure. -/
structure OCoreCtx (P₀ R : Program) (ν : ONums) (Tn : List ℕ → ℕ) (need : List ℕ → Light.Need) :
    Prop where
  loop : OCtx P₀ R ν.pS ν.pWriteX ν.pWriteY ν.pScat Tn need
  hLoop : (P₀ ++ R)[ν.pLoop]? = some (oLoopBody ν.pS ν.pWriteX ν.pWriteY ν.pScat)
  hDbl : (P₀ ++ R)[ν.pDbl]? = some dblTableBody
  hResid : (P₀ ++ R)[ν.pResid]? = some residBody
  hResidues : (P₀ ++ R)[ν.pResidues]? = some (residuesBody ν.pResid)
  hClasses : (P₀ ++ R)[ν.pClasses]? = some classesBody
  hChunks : (P₀ ++ R)[ν.pChunks]? = some chunksBody

/-- The data of the instances of an instance of the oracle. -/
def oDataOf (x : OracleInst) : HostData := oData x.n x.s x.p x.AB x.BC x.AC

/-- The time of the core procedure in a run. -/
def tCoreRun (Tn : List ℕ → ℕ) (X : HostData) (U : ℕ) : ℕ :=
  tDblTable (bitLen U) + 3 * tResidues (X.n * X.n) (bitLen U) + tClasses X.n X.p
    + tChunks X.p X.chunkCount + tOLoop Tn X + 150

/-- The arguments of the core procedure. -/
def oCoreArgs (x : OracleInst) (fr : ℕ) : List ℤ :=
  [(x.n : ℤ), (x.U : ℤ), (x.ab : ℤ), (x.bc : ℤ), (x.ac : ℤ), (fr : ℤ), ((x.s * x.p : ℕ) : ℤ),
    (x.cnt : ℤ), (x.s : ℤ), (x.p : ℤ), (oCap x.n x.p : ℕ), (x.s : ℤ), ((x.n ⌈/⌉ x.s : ℕ) : ℤ),
    ((bitLen x.U : ℕ) : ℤ)]

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.OracleHost
/-!
# The counting oracle (Lemma 4.1) as a host

The top procedure `oracle(n, U, ab, bc, ac, s, p, cnt, fr)` computes `D = s p`, `cap = ⌈n²/p⌉`,
the number `h = ⌈n/s⌉` of blocks and the number of binary digits of `U`, and calls the core
procedure (`oCore_spec`).  With an arbitrary solver of #Lop-AE-SparseTri it solves `oracleTask`
(`oracle_solves`), within the time `oracleTime` and the need `oracleNeed`.

The time: `⌈n/s⌉ · 2p` calls of the solver, each with `n` rows, inner dimension `s p` and at most
`cap` query pairs, so the solver enters only through `oSupTime Tl n (s p) cap`, its largest time on
such instances; besides, writing the matrices (`O(n s p)` per call), the answers (`O(cap)` per
call), the residues (`O(n² log U)`), the classes and the chunks.
-/

@[expose] public section

namespace Light.Filter

open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3

variable {lim : Limits} {d : ℕ}

/-! ## The procedure -/

/-- oracle(n, U, ab, bc, ac, s, p, cnt, fr): locals 9 to 12 are `D`, `cap`, `h` and the number of
binary digits of `U`. -/
def oracleBody (pCeil pBitLen pCore : ℕ) : Stmt :=
  .set 9 (Light.v 5 *' Light.v 6) ;;
  .call pCeil [Light.v 0 *' Light.v 0, Light.v 6] 10 ;;
  .call pCeil [Light.v 0, Light.v 5] 11 ;;
  .call pBitLen [Light.v 1] 12 ;;
  .call pCore [Light.v 0, Light.v 1, Light.v 2, Light.v 3, Light.v 4, Light.v 8, Light.v 9, Light.v 7, Light.v 5, Light.v 6, Light.v 10, Light.v 5, Light.v 11, Light.v 12] 0

/-! ## Time and need -/

/-- **The time of the oracle**, over a solver with the time `Tl`, for `n`, `U`, `s`, `p`. -/
def oTimeAt (Tl : List ℕ → ℕ) (n U s p : ℕ) : ℕ :=
  tCeilDiv (n * n) p + tCeilDiv n s + tBitLen U + tDblTable (bitLen U)
    + 3 * tResidues (n * n) (bitLen U) + tClasses n p + tChunks p (2 * p)
    + (n + s - 1) / s * (2 * p) *
      (tWriteX n (s * p) s + tWriteY n (s * p) s + oSupTime Tl n (s * p) (oCap n p)
        + tOScatter (oCap n p) + 108)
    + 300

/-- The time of the oracle as a function of the parameters `[n, U, s, p]`. -/
def oracleTime (Tl : List ℕ → ℕ) (ps : List ℕ) : ℕ :=
  oTimeAt Tl (ps.getD 0 0) (ps.getD 1 0) (ps.getD 2 0) (ps.getD 3 0)

/-- The cells of the arrays of the oracle, from the free pointer on. -/
def oLayout (n U s p : ℕ) : ℕ :=
  (bitLen U + 1) + 3 * (n * n) + (p + 1) + p + 2 * (n * n) + 3 * (n * n + p) + 2 * (n * (s * p))
    + oCap n p

/-- The largest number that the oracle forms, apart from the solver. -/
def oWord (n U s p : ℕ) : ℕ :=
  (n * n + p + 1) + (n + s + 1) + (2 * U + 2) + s * p + p * (4 * (U + 1)) + (3 * U + 1)
    + (n + s - 1) / s * (2 * p) + 1

/-- The largest need of the solver on an instance with at most cap query pairs. -/
def oSupNeed (need : List ℕ → Light.Need) (n D cap : ℕ) : Need :=
  ⟨(Finset.range (cap + 1)).sup fun w => (need [n, D, w]).word,
    (Finset.range (cap + 1)).sup fun w => (need [n, D, w]).cells,
    (Finset.range (cap + 1)).sup fun w => (need [n, D, w]).depth⟩

/-- The need of the oracle, for `n`, `U`, `s`, `p`. -/
def oNeedAt (need : List ℕ → Light.Need) (n U s p : ℕ) : Need :=
  ⟨oWord n U s p + (oSupNeed need n (s * p) (oCap n p)).word,
    oLayout n U s p + (oSupNeed need n (s * p) (oCap n p)).cells + 1,
    4 + (oSupNeed need n (s * p) (oCap n p)).depth⟩

/-- **The need of the oracle** as a function of the parameters `[n, U, s, p]`. -/
def oracleNeed (need : List ℕ → Light.Need) (ps : List ℕ) : Need :=
  oNeedAt need (ps.getD 0 0) (ps.getD 1 0) (ps.getD 2 0) (ps.getD 3 0)

/-! ## The limits -/

section limits

variable {need : List ℕ → Need} {x : OracleInst} {μ : ℕ → ℤ} {fr : ℕ}

end limits

/-! ## The oracle -/

/-- The context of the oracle: the core and the two small procedures. -/
structure OracleCtx (P₀ R : Program) (ν : ONums) (Tn : List ℕ → ℕ) (need : List ℕ → Light.Need) :
    Prop where
  core : OCoreCtx P₀ R ν Tn need
  hCore : (P₀ ++ R)[ν.pCore]? = some (oCoreBody ν)
  hCeil : (P₀ ++ R)[ν.pCeil]? = some ceilDivBody
  hBitLen : (P₀ ++ R)[ν.pBitLen]? = some bitLenBody

/-! ## The program -/

/-- The numbers of the procedures of the oracle, if its list starts at the number `o`; `pS` is the
solver. -/
def oNumsAt (pS o : ℕ) : ONums where
  pS := pS
  pCeil := o
  pBitLen := o + 1
  pDbl := o + 2
  pResid := o + 3
  pResidues := o + 4
  pClasses := o + 5
  pChunks := o + 6
  pWriteX := o + 7
  pWriteY := o + 8
  pScat := o + 9
  pLoop := o + 10
  pCore := o + 11

/-- **The procedures of the oracle**: procedure number `i` of this list gets the number `o + i`;
the oracle itself is number `o + 12`. -/
def oracleProcs (pS o : ℕ) : Program :=
  let ν := oNumsAt pS o
  [ceilDivBody,                                             -- 0
    bitLenBody,                                             -- 1
    dblTableBody,                                           -- 2
    residBody,                                              -- 3
    residuesBody ν.pResid,                                  -- 4
    classesBody,                                            -- 5
    chunksBody,                                             -- 6
    writeXBody,                                             -- 7
    writeYBody,                                             -- 8
    oScatterBody,                                           -- 9
    oLoopBody ν.pS ν.pWriteX ν.pWriteY ν.pScat,             -- 10
    oCoreBody ν,                                            -- 11
    oracleBody ν.pCeil ν.pBitLen ν.pCore]                   -- 12

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.OracleNeedPoly
/-!
# The counting oracle (Lemma 4.1): the need stays polynomial, and the host

If the need of the solver of #Lop-AE-SparseTri is polynomially bounded in its parameters
`[N, D, w]`, then the need of the oracle is polynomially bounded in `[n, U, s, p]`
(`oracleNeed_poly`): every part of it is at most `2^S Q^K` with `Q = (n + 1)(U + 1)(s + 1)(p + 1)`.

`oracle_host` puts the two together: from an arbitrary solver of #Lop-AE-SparseTri, a solver of the
counting oracle with the time `oracleTime` and the need `oracleNeed`.
-/

@[expose] public section

namespace Light.Filter

open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3

/-- The product of the four parameters, each plus one. -/
def oQ (ps : List ℕ) : ℕ :=
  (ps.getD 0 0 + 1) * (ps.getD 1 0 + 1) * (ps.getD 2 0 + 1) * (ps.getD 3 0 + 1)

section bounds

variable {n U s p : ℕ}

/-- `Q` for `[n, U, s, p]`. -/
abbrev Q4 (n U s p : ℕ) : ℕ := (n + 1) * (U + 1) * (s + 1) * (p + 1)

end bounds

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.Asymp
/-!
# Asymptotics of the filtering parameters

With `k = Nat.size n`, `ℓ = ⌊√k⌋ + 1`, `m = ⌊√ℓ⌋` (so `b = ℓ (m + 1)`), every parameter is a power
of two whose exponent is a polynomial in `m`, `ℓ`, `k`, and `m → ∞` with `n`.

* `rpow_le_two_mul_sOf`, `sOf_le_two_mul_rpow`: `n^σ / 2 ≤ s ≤ 2 n^σ`, `σ = 0.0284225`.
* `RR_le_rpow`, `QOf_le_rpow`, `calls_le_rpow`, `PmaxOf_le`: `R, Q, rounds · (r (Q + 1) + 2)` are
  `n^{o(1)}`, and `Pmax ≤ s n^{o(1)}`.
* `regime`: eventually `2 ≤ s p` and `(s p)^1249 ≤ n^71` for all `1 ≤ p ≤ Pmax`.
* `guard_eventually`: eventually `Guard n U` for all `U ≤ c n^κ`.
-/

@[expose] public section

open Filter

namespace Light.Filter

/-! ## Basic facts -/

/-- `m = ⌊√ℓ⌋`. -/
def mmOf (n : ℕ) : ℕ := Nat.sqrt (ellOf n)

/-- The exponent of `s`: `s = 2^{jOf n}`. -/
def jOf (n : ℕ) : ℕ := 284225 * kOf n / 10 ^ 7

/-! ## Polynomial inequalities, eventually -/

/-! ## The parameters are `n^{o(1)}` -/

/-! ## The regime of the thin product -/

