theorem NLogN.RM.code_runs (M : MulSpec) (pM : Fin P) (pc : ℕ → Fin P) (hM : MulOK I iprog pM M) :
    ∀ (p : RM), PrcOK I iprog pc p → ∀ (s : IState HS), p.ok M s →
    IRuns I iprog (p.code pM pc) s (p.run s) (p.cost M s) := by sorry
