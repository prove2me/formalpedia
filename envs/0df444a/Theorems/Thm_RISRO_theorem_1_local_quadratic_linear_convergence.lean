-- name    : RISRO.theorem_1_local_quadratic_linear_convergence
-- status  : Open
-- author  : @iris
-- created : 2026-10-31T10:34:01.938441+00:00
-- url     : https://prove2.me/theorems/914f6c51-cf0b-4be5-98f5-632dfefd3300
-- title:
--   Theorem 1 — local quadratic-linear and quadratic convergence of RISRO
-- statement:
--   Let $\bar X$ be a stationary point of problem (1) of rank $r$, and $\bar\epsilon=y-\mathcal A(\bar X)$. Suppose that $\mathcal A$ satisfies the $2r$-RIP, that the initialization $X^0$ satisfies
--
--   $$
--   \|X^0-\bar X\|_F\le\Bigl(\frac14\wedge\frac{1-R_{2r}}{4\sqrt5R_{3r}}\Bigr)\sigma_r(\bar X),
--   $$
--
--   and that $\|\mathcal A^*(\bar\epsilon)\|_F\le\frac{1-R_{2r}}{4\sqrt5}\sigma_r(\bar X)$. Then, for the sequence $\{X^t\}$ generated by RISRO (Algorithm 1), for all $t\ge0$:
--
--   1. $\|X^{t+1}-\bar X\|_F\le\frac34\|X^t-\bar X\|_F$;
--   2. with $\|\cdot\|$ the spectral norm,
--
--   $$
--   \|X^{t+1}-\bar X\|_F^2\le\frac{5\|X^t-\bar X\|^2}{(1-R_{2r})^2\sigma_r^2(\bar X)}\Bigl(R_{3r}^2\|X^t-\bar X\|_F^2+4R_{3r}\|\mathcal A^*(\bar\epsilon)\|_F\|X^t-\bar X\|_F+4\|\mathcal A^*(\bar\epsilon)\|_F^2\Bigr);
--   $$
--
--   3. if $\bar\epsilon=0$, then
--
--   $$
--   \|X^{t+1}-\bar X\|_F\le\frac{\sqrt5R_{3r}}{(1-R_{2r})\sigma_r(\bar X)}\|X^t-\bar X\|_F^2 .
--   $$
--
--   The statement covers every run of the algorithm, and a run exists from every factorization $X^0=U^0S^0V^{0\top}$ with $U^0,V^0$ orthonormal.
--
--   This is the main convergence theorem of the paper: the rate is quadratic while the iterate is far from $\bar X$ relative to $\|\mathcal A^*(\bar\epsilon)\|_F$, then linear, and quadratic throughout when $\bar\epsilon=0$.
--
--   Differences from the source:
--   - generalization: the sequence generated by Algorithm 1, with an SVD of X⁰ and QR factors in step 6 → every run of the relation IsRISRORun: any orthonormal factors with X⁰ = U⁰ S⁰ V⁰ᵀ, and any orthonormal U^{t+1}, V^{t+1} with X_U = U^{t+1} R, X_V = V^{t+1} R′; reason: only the spans enter the argument; every SVD and every QR factorization qualify
--   - generalization: no existence claim → an added first conclusion: a run exists from every admissible (U⁰, V⁰, S⁰); reason: it rules out a vacuous reading of the universally quantified conclusion
--   - generalization: R_k defined for 1 ≤ k ≤ min(p₁, p₂) (Definition 1) → ripConst A k for every k; reason: it agrees with Definition 1 where that is defined; the paper uses R_{3r} and Lemma 8 at rank 3r, which may exceed min(p₁, p₂)
--   - encoding: (19) with the minimum of 1/4 and (1 - R_{2r})/(4√5 R_{3r}) → two inequalities, ‖X⁰ - X̄‖_F ≤ σ_r/4 and 4√5 R_{3r} ‖X⁰ - X̄‖_F ≤ (1 - R_{2r}) σ_r; reason: at R_{3r} = 0 the page reads +∞, while Lean gives x/0 = 0; the two forms agree for R_{3r} > 0
--   - encoding: ∇f(X̄)ᵀŪ = 0 and ∇f(X̄)V̄ = 0 → X̄ᵀ∇f(X̄) = 0 and ∇f(X̄)X̄ᵀ = 0 (IsRankRStationary); reason: equivalent for rank X̄ = r, because Σ̄ is invertible
--   - encoding: rank r, r implicitly positive → explicit hypothesis 1 ≤ r; reason: σ_r is undefined at r = 0; this excludes only that undefined case
-- source:
--   Luo, Huang, Li & Zhang, Recursive Importance Sketching for Rank Constrained Least Squares, arXiv:2011.08360v4, Theorem 1, displays (19)-(20), p.11

import Mathlib
import Definitions.Def_IRLSM_Convergence_Basic
import Definitions.Def_RISRO_IsRankRStationary
import Definitions.Def_RISRO_IsRISRORun

open HighDimStat.MatrixRank Matrix IRLSM.Convergence

namespace RISRO

/-- **Theorem 1 (Local Quadratic-Linear and Quadratic Convergence of RISRO).** Let `X̄` be a
stationary point of problem (1) and `ϵ̄ = y - A(X̄)`. Suppose `A` satisfies the `2r`-RIP and `X⁰`
satisfies (19), `‖X⁰ - X̄‖_F ≤ (1/4 ∧ (1 - R_{2r})/(4√5 R_{3r})) σ_r(X̄)`, and
`‖A^*(ϵ̄)‖_F ≤ (1 - R_{2r})/(4√5) σ_r(X̄)`. Then the sequence `{X^t}` generated by RISRO satisfies,
for all `t ≥ 0`, `‖X^{t+1} - X̄‖_F ≤ (3/4) ‖X^t - X̄‖_F`, and (20),
`‖X^{t+1} - X̄‖_F² ≤ 5 ‖X^t - X̄‖² / ((1 - R_{2r})² σ_r²(X̄)) · (R_{3r}² ‖X^t - X̄‖_F²
 + 4 R_{3r} ‖A^*(ϵ̄)‖_F ‖X^t - X̄‖_F + 4 ‖A^*(ϵ̄)‖_F²)`, and, if `ϵ̄ = 0`,
`‖X^{t+1} - X̄‖_F ≤ √5 R_{3r} / ((1 - R_{2r}) σ_r(X̄)) ‖X^t - X̄‖_F²`.

Luo, Huang, Li & Zhang, arXiv:2011.08360v4, Theorem 1, displays (19)–(20), p.11.

Formalization Notes:
* The theorem holds for **every** run of Algorithm 1 from `X⁰` (`IsRISRORun`), and a run exists from
  every admissible factorization `X⁰ = U⁰ S⁰ V⁰ᵀ`, so the statement is not vacuous.
* (19) is written multiplicatively (`h19a`, `h19b`): at `R_{3r} = 0` the page's second argument of
  `∧` is `+∞`, whereas Lean's `x / 0 = 0` would shrink the radius to `0`.
* `R_k` is `ripConst A k`, defined for every `k`; `σ_r` is `sv _ (r - 1)`; the unsubscripted
  `‖X^t - X̄‖` of (20) is the spectral norm `opNorm`. `R_{3r} < 1` is not assumed. -/
theorem theorem_1_local_quadratic_linear_convergence {p₁ p₂ n r : ℕ} (hr : 1 ≤ r) (A : Fin n → Matrix (Fin p₁) (Fin p₂) ℝ) (y : Fin n → ℝ)
    (Xbar X₀ : Matrix (Fin p₁) (Fin p₂) ℝ)
    (hstat : IsRankRStationary A y r Xbar)
    (hRIP : ripConst A (2 * r) < 1)
    (h19a : frobeniusNorm (X₀ - Xbar) ≤ 1 / 4 * sv Xbar (r - 1))
    (h19b : 4 * √5 * ripConst A (3 * r) * frobeniusNorm (X₀ - Xbar) ≤
      (1 - ripConst A (2 * r)) * sv Xbar (r - 1))
    (hres : frobeniusNorm (observationOpAdjoint A (y - observationOp A Xbar)) ≤
      (1 - ripConst A (2 * r)) / (4 * √5) * sv Xbar (r - 1)) :
    (∀ (U₀ : Matrix (Fin p₁) (Fin r) ℝ) (V₀ : Matrix (Fin p₂) (Fin r) ℝ)
        (S₀ : Matrix (Fin r) (Fin r) ℝ),
        U₀ᵀ * U₀ = 1 → V₀ᵀ * V₀ = 1 → X₀ = U₀ * S₀ * V₀ᵀ →
        ∃ (X : ℕ → Matrix (Fin p₁) (Fin p₂) ℝ)
          (U : ℕ → Matrix (Fin p₁) (Fin r) ℝ) (Uc : ℕ → Matrix (Fin p₁) (Fin (p₁ - r)) ℝ)
          (V : ℕ → Matrix (Fin p₂) (Fin r) ℝ) (Vc : ℕ → Matrix (Fin p₂) (Fin (p₂ - r)) ℝ)
          (B : ℕ → Matrix (Fin r) (Fin r) ℝ) (D₁ : ℕ → Matrix (Fin (p₁ - r)) (Fin r) ℝ)
          (D₂ : ℕ → Matrix (Fin (p₂ - r)) (Fin r) ℝ),
          IsRISRORun A y X U Uc V Vc B D₁ D₂ ∧ X 0 = X₀ ∧ U 0 = U₀ ∧ V 0 = V₀) ∧
      ∀ (X : ℕ → Matrix (Fin p₁) (Fin p₂) ℝ)
        (U : ℕ → Matrix (Fin p₁) (Fin r) ℝ) (Uc : ℕ → Matrix (Fin p₁) (Fin (p₁ - r)) ℝ)
        (V : ℕ → Matrix (Fin p₂) (Fin r) ℝ) (Vc : ℕ → Matrix (Fin p₂) (Fin (p₂ - r)) ℝ)
        (B : ℕ → Matrix (Fin r) (Fin r) ℝ) (D₁ : ℕ → Matrix (Fin (p₁ - r)) (Fin r) ℝ)
        (D₂ : ℕ → Matrix (Fin (p₂ - r)) (Fin r) ℝ),
        IsRISRORun A y X U Uc V Vc B D₁ D₂ → X 0 = X₀ → ∀ t : ℕ,
          frobeniusNorm (X (t + 1) - Xbar) ≤ 3 / 4 * frobeniusNorm (X t - Xbar) ∧
          frobeniusNorm (X (t + 1) - Xbar) ^ 2 ≤
            5 * opNorm (X t - Xbar) ^ 2 / ((1 - ripConst A (2 * r)) ^ 2 * sv Xbar (r - 1) ^ 2) *
              (ripConst A (3 * r) ^ 2 * frobeniusNorm (X t - Xbar) ^ 2 +
                4 * ripConst A (3 * r) * frobeniusNorm (observationOpAdjoint A (y - observationOp A Xbar)) * frobeniusNorm (X t - Xbar) +
                4 * frobeniusNorm (observationOpAdjoint A (y - observationOp A Xbar)) ^ 2) ∧
          (y = observationOp A Xbar →
            frobeniusNorm (X (t + 1) - Xbar) ≤
              √5 * ripConst A (3 * r) / ((1 - ripConst A (2 * r)) * sv Xbar (r - 1)) *
                frobeniusNorm (X t - Xbar) ^ 2) := by sorry

end RISRO
