theorem _root_.Prove2MeSourceProof.h_7d28da0da84ad86b2d151781 (Xp : ℝ → Ω → Fin n → ℝ)
    (ℱ : Filtration ℝ ‹MeasurableSpace Ω›)
    (hXadapt : ∀ t : ℝ, Measurable[ℱ t] (Xp t))
    (hleft : ∀ (ω : Ω) (t : ℝ), 0 < t → ∀ i : Fin n,
      ∃ L : ℝ, Tendsto (fun s => Xp s ω i) (𝓝[<] t) (𝓝 L)) :
    Measurable[predictableSigma ℱ] fun p : ℝ × Ω => leftLimPathAtPos Xp p.1 p.2 := by
  classical
  refine (@measurable_pi_iff (ℝ × Ω) (Fin n) (fun _ => ℝ) (LevyStochCalc.Probability.predictableSigma ℱ) inferInstance
    (fun p : ℝ × Ω => LevyStochCalc.Ito.JumpSplitting.leftLimPathAtPos Xp p.1 p.2)).mpr fun i => ?_
  refine LevyStochCalc.Probability.measurable_predictableSigma_of_tendsto_leftGridPoint
    (Z := fun t ω => if 0 < t then Xp t ω i else 0)
    (Y := fun t ω => LevyStochCalc.Ito.JumpSplitting.leftLimPathAtPos Xp t ω i) (fun t => ?_) (fun s ω => ?_)
  · by_cases h : (0 : ℝ) < t
    · have hm : Measurable[ℱ t] fun ω => Xp t ω i := (measurable_pi_apply i).comp (hXadapt t)
      simpa [h] using hm
    · simp only [if_neg h]
      exact measurable_const
  · by_cases hs : (0 : ℝ) < s
    · have hnhds : Tendsto (fun k : ℕ => LevyStochCalc.Probability.leftGridPoint k s) atTop (𝓝 s) :=
        (_root_.Prove2MeSourceProof.h_7933289efea3e77799cfdcda s).mono_right nhdsWithin_le_nhds
      have hev : ∀ᶠ k : ℕ in atTop, 0 < LevyStochCalc.Probability.leftGridPoint k s := hnhds.eventually (lt_mem_nhds hs)
      have hconv : Tendsto (fun k : ℕ => Xp (LevyStochCalc.Probability.leftGridPoint k s) ω i) atTop
          (𝓝 (LevyStochCalc.Ito.JumpSplitting.leftLimPathAt Xp s ω i)) :=
        (LevyStochCalc.Ito.JumpSplitting.tendsto_nhdsLT_leftLimPathAt (hleft ω s hs) i).comp (_root_.Prove2MeSourceProof.h_7933289efea3e77799cfdcda s)
      have hcong : (fun k : ℕ => Xp (LevyStochCalc.Probability.leftGridPoint k s) ω i)
          =ᶠ[atTop] fun k : ℕ =>
            if 0 < LevyStochCalc.Probability.leftGridPoint k s then Xp (LevyStochCalc.Probability.leftGridPoint k s) ω i else 0 := by
        filter_upwards [hev] with k hk
        rw [if_pos hk]
      simpa [LevyStochCalc.Ito.JumpSplitting.leftLimPathAtPos, hs] using hconv.congr' hcong
    · have h0 : ∀ k : ℕ, ¬(0 < LevyStochCalc.Probability.leftGridPoint k s) := fun k hk =>
        hs (lt_trans hk (LevyStochCalc.Probability.leftGridPoint_lt k s))
      have hzero : (fun k : ℕ =>
          if 0 < LevyStochCalc.Probability.leftGridPoint k s then Xp (LevyStochCalc.Probability.leftGridPoint k s) ω i else 0)
          = fun _ : ℕ => (0 : ℝ) := by
        funext k
        exact if_neg (h0 k)
      rw [hzero]
      simp [LevyStochCalc.Ito.JumpSplitting.leftLimPathAtPos, hs]
