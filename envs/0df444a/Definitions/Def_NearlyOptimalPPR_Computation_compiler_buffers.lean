-- Buffer and update interface from Solutions.ExteriorSelfBudget

set_option autoImplicit false
set_option maxRecDepth 10000
open scoped ENNReal
namespace NearlyOptimalPPR.Computation
noncomputable section

def exteriorSelfBudgetMemoryUpdate (I : ℤ → ℤ) (width : ℕ) (vertex : ℕ) (t : ℕ)
    (z flow : ℝ) (i : ℕ) (R : ℤ → ℝ) : ℤ → ℝ :=
  let self := if i ≤ t then Function.update R (vertexRecordAddress width vertex (16*(i+1)+1))
    (R (vertexRecordAddress width vertex (16*(i+1)+1))+(if i < t then -z else -5*z)) else R
  if t ≤ i ∧ 0 < I (levelHeaderAddress i 9) then
    Function.update self (levelHeaderAddress i 4) (self (levelHeaderAddress i 4)+flow) else self

end
end NearlyOptimalPPR.Computation

