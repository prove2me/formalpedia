theorem runArrR_append {α : Type*} (n : ℕ) (d : α) (a b : List LOp) (xs : List α) :
    runArrR n d (a ++ b) xs = runArrR n d a (runArrR n d b xs) := by
  simp [runArrR, List.reverse_append, List.foldl_append]

theorem vol_binSh (n : ℕ) : vol (binSh n) = 2 ^ n := by simp [binSh, vol]

theorem permIdx_id_of {f : ℕ → ℕ} {a : List ℕ} (hf : ∀ k < a.length, f k = k) : permIdx f a = a := by
  apply List.ext_getElem (by simp [permIdx])
  intro k h1 h2
  simp only [permIdx, List.getElem_map, List.getElem_range]
  rw [hf k h2, List.getD_eq_getElem]

theorem pull_idx_inv {α : Type*} {n : ℕ} (d : α) {o : LOp} (h : o.WF n) {xs : List α}
    (hxs : xs.length = 2 ^ n) :
    pull (binSh n) (binSh n) (permIdx o.idx) d (pull (binSh n) (binSh n) (permIdx o.inv) d xs) =
      xs := by
  rw [pull_comp _ _ (fun a ha => valid_binSh_permIdx (fun k hk => o.idx_lt h hk) ha)]
  rw [pull_congr (g := permIdx o.inv ∘ permIdx o.idx) (g' := id) (fun a ha => by
    have hl : a.length = n := by rw [ha.length_eq]; simp [binSh]
    simp only [Function.comp_apply, id_eq]
    rw [permIdx_permIdx (fun k hk => by
      (try simp only [length_permIdx] at hk); (try simp only [length_permIdx])
      have := o.inv_lt h (show k < n by omega); omega)]
    exact permIdx_id_of (fun k hk => o.idx_inv h k))]
  exact pull_id d (by rw [hxs, vol_binSh])

theorem runArrR_runArr {α : Type*} (n : ℕ) (d : α) :
    ∀ ops : List LOp, (∀ o ∈ ops, o.WF n) → ∀ xs : List α, xs.length = 2 ^ n →
      runArrR n d ops (Synth.runArr n d ops xs) = xs
  | [], _, xs, _ => rfl
  | o :: ops, hops, xs, hxs => by
    have ho := hops o (by simp)
    have e : Synth.runArr n d (o :: ops) xs =
        Synth.runArr n d ops (pull (binSh n) (binSh n) (permIdx o.inv) d xs) := by
      simp [Synth.runArr]
    rw [e, runArrR_cons, runArrR_runArr n d ops (fun o' h' => hops o' (by simp [h'])) _
      (by simp [vol_binSh]), pull_idx_inv d ho hxs]

/-- **The backward run is the reverse relabelling.** -/
theorem runArrR_eq_pull {α : Type*} (n : ℕ) (d : α) {init tgt : List ℕ} (hinit : init.Nodup)
    (htgt : tgt.Nodup) (hn : init.length = n) (htl : tgt.length = n)
    (hsub : ∀ nm ∈ tgt, nm ∈ init) (ops : List LOp) (hops : ∀ o ∈ ops, o.WF n)
    (happ : applyN ops init = tgt) {ys : List α} (hys : ys.length = 2 ^ n) :
    runArrR n d ops ys = pull (binSh n) (binSh n) (relabel tgt init) d ys := by
  have h := runArr_eq_pull n d htgt htl ops hops init hn hinit hsub ys
  rw [happ, pull_congr (g := relabel tgt tgt) (g' := id) (fun a ha => relabel_self htgt (by
    rw [ha.length_eq]; simp [binSh, htl])), pull_id d (by rw [hys, vol_binSh])] at h
  conv_lhs => rw [← h]
  exact runArrR_runArr n d ops hops _ (by simp [vol_binSh])

theorem iterL_succ' {α : Type*} (F : ℕ → α → α) :
    ∀ (N : ℕ) (x : α), NLogN.KFV.iterL F (N + 1) x = NLogN.KFV.iterL (fun k => F (k + 1)) N (F 0 x)
  | 0, x => rfl
  | N + 1, x => by
    show F (N + 1) (NLogN.KFV.iterL F (N + 1) x) = F (N + 1) (NLogN.KFV.iterL (fun k => F (k + 1)) N (F 0 x))
    rw [iterL_succ' F N x]

/-- **A `flatMap` schedule backwards is a loop over the reversed index.** -/
theorem runArrR_flatMap_range {α : Type*} (n : ℕ) (d : α) (g : ℕ → List LOp) :
    ∀ (N : ℕ) (xs : List α), runArrR n d ((List.range N).flatMap g) xs =
      NLogN.KFV.iterL (fun k => runArrR n d (g (N - 1 - k))) N xs
  | 0, xs => rfl
  | N + 1, xs => by
    rw [List.range_succ, List.flatMap_append, runArrR_append, runArrR_flatMap_range n d g N,
      iterL_succ']
    have e1 : (fun k => runArrR n d (g (N + 1 - 1 - (k + 1)))) =
        fun k => runArrR (α := α) n d (g (N - 1 - k)) := by
      funext k; rw [show N + 1 - 1 - (k + 1) = N - 1 - k by omega]
    rw [e1, show N + 1 - 1 - 0 = N by omega]
    simp

end NLogN.KFV

