open CirclePackingConstants

theorem vertical_shear_small (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5)
    (hd : ∀ i j k l, (i, j) ≠ (k, l) → (1 : ℝ) / 16 < sqDist (p i j) (p k l)) :
    ∀ (i : Fin 5) (j : Fin 4), |(p i j.succ).1 - (p i j.castSucc).1| ≤ 47 / 400 := by
  let P : ℕ → ℕ → Point := fun i j => if h : i < 5 ∧ j < 5 then p ⟨i, h.1⟩ ⟨j, h.2⟩ else (0, 0)
  have hP : ∀ (i j : ℕ) (hi : i < 5) (hj : j < 5), P i j = p ⟨i, hi⟩ ⟨j, hj⟩ := by
    intro i j hi hj
    simp only [P, dif_pos (And.intro hi hj)]
  have hsep : BuildA.Sep P := by
    intro i j k l hi hj hk hl hne
    rw [hP i j hi hj, hP k l hk hl]
    apply hd
    intro h
    apply hne
    simpa [Prod.ext_iff, Fin.ext_iff] using h
  have h0 : BuildA.Inv P BuildA.R0 := by
    apply BuildA.inv_R0
    intro i j hi hj
    rw [hP i j hi hj]
    exact hc ⟨i, hi⟩ ⟨j, hj⟩
  obtain ⟨S, hS, hf⟩ := BuildA.inv_final P hsep h0
  intro i j
  have := BuildA.shear_of_inv P S hS hf i.val (j.val + 1) j.val i.2 (by omega) (by omega)
  rw [hP _ _ i.2 (by omega), hP _ _ i.2 (by omega)] at this
  exact this



namespace TwentyFiveStruct


/-- If `d ≥ 0`, `|c| ≤ 47/400` and `c² + d² > 1/16`, then `1/4 - d < (100/47) c²`. -/
lemma key (c d : ℝ) (hd0 : 0 ≤ d) (hc : |c| ≤ 47/400) (h : 1/16 < c^2 + d^2) :
    1/4 - d < 100/47 * c^2 := by
  have hc2 : c^2 ≤ (47/400)^2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg c) hc 2
  by_contra hcon
  push Not at hcon
  have hpos : 0 ≤ 1/4 - 100/47*c^2 := by linarith
  have h2 : d^2 ≤ (1/4 - 100/47*c^2)^2 := by nlinarith
  nlinarith [mul_nonneg (sq_nonneg c) (show 0 ≤ (47/400)^2 - c^2 by linarith)]

lemma walls (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5) :
    (∀ j : Fin 5, 0 ≤ (p 0 j).1) ∧ (∀ j : Fin 5, (p 4 j).1 ≤ 1) ∧
    (∀ i : Fin 5, 0 ≤ (p i 0).2) ∧ (∀ i : Fin 5, (p i 4).2 ≤ 1) := by
  refine ⟨fun j => ?_, fun j => ?_, fun i => ?_, fun i => ?_⟩
  · have := (hc 0 j).1; simpa using this
  · have := (hc 4 j).2.1; norm_num at this; linarith
  · have := (hc i 0).2.2.1; simpa using this
  · have := (hc i 4).2.2.2; norm_num at this; linarith

/-- Vertical edges: the vertical gap is nonnegative and the pair is separated. -/
lemma vEdge (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5)
    (hd : ∀ i j k l, (i, j) ≠ (k, l) → (1 : ℝ) / 16 < sqDist (p i j) (p k l)) (i : Fin 5) (j : Fin 4) :
    0 ≤ (p i j.succ).2 - (p i j.castSucc).2 ∧
      1/16 < ((p i j.succ).1 - (p i j.castSucc).1)^2 + ((p i j.succ).2 - (p i j.castSucc).2)^2 := by
  constructor
  · have h1 := (hc i j.succ).2.2.1
    have h2 := (hc i j.castSucc).2.2.2
    simp only [Fin.val_succ, Fin.val_castSucc, Nat.cast_add, Nat.cast_one] at h1 h2
    linarith
  · have := hd i j.succ i j.castSucc (by simp [Fin.ext_iff])
    simpa [sqDist] using this

/-- Horizontal edges: the horizontal gap is nonnegative and the pair is separated. -/
lemma hEdge (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5)
    (hd : ∀ i j k l, (i, j) ≠ (k, l) → (1 : ℝ) / 16 < sqDist (p i j) (p k l)) (i : Fin 4) (j : Fin 5) :
    0 ≤ (p i.succ j).1 - (p i.castSucc j).1 ∧
      1/16 < ((p i.succ j).2 - (p i.castSucc j).2)^2 + ((p i.succ j).1 - (p i.castSucc j).1)^2 := by
  constructor
  · have h1 := (hc i.succ j).1
    have h2 := (hc i.castSucc j).2.1
    simp only [Fin.val_succ, Fin.val_castSucc, Nat.cast_add, Nat.cast_one] at h1 h2
    linarith
  · have := hd i.succ j i.castSucc j (by simp [Fin.ext_iff])
    simp only [sqDist] at this
    linarith

/-- Staircase bound: the vertical offset of a horizontal edge is bounded by four
vertical compressions (telescoping each column to a wall). -/
lemma stairH (p : Fin 5 → Fin 5 → Point)
    (hc : ∀ i j, (i.val : ℝ) / 5 ≤ (p i j).1 ∧ (p i j).1 ≤ ((i.val : ℝ) + 1) / 5 ∧
      (j.val : ℝ) / 5 ≤ (p i j).2 ∧ (p i j).2 ≤ ((j.val : ℝ) + 1) / 5) (K : ℝ)
    (hδ : ∀ (i : Fin 5) (j : Fin 4), 1/4 - ((p i j.succ).2 - (p i j.castSucc).2) < K) :
    ∀ e : Fin 4 × Fin 5, |(p e.1.succ e.2).2 - (p e.1.castSucc e.2).2| < 4 * K := by
  obtain ⟨-, -, hy0, hy4⟩ := walls p hc
  have d_0_0 : 1/4 - ((p 0 1).2 - (p 0 0).2) < K := hδ 0 0
  have d_0_1 : 1/4 - ((p 0 2).2 - (p 0 1).2) < K := hδ 0 1
  have d_0_2 : 1/4 - ((p 0 3).2 - (p 0 2).2) < K := hδ 0 2
  have d_0_3 : 1/4 - ((p 0 4).2 - (p 0 3).2) < K := hδ 0 3
  have d_1_0 : 1/4 - ((p 1 1).2 - (p 1 0).2) < K := hδ 1 0
  have d_1_1 : 1/4 - ((p 1 2).2 - (p 1 1).2) < K := hδ 1 1
  have d_1_2 : 1/4 - ((p 1 3).2 - (p 1 2).2) < K := hδ 1 2
  have d_1_3 : 1/4 - ((p 1 4).2 - (p 1 3).2) < K := hδ 1 3
  have d_2_0 : 1/4 - ((p 2 1).2 - (p 2 0).2) < K := hδ 2 0
  have d_2_1 : 1/4 - ((p 2 2).2 - (p 2 1).2) < K := hδ 2 1
  have d_2_2 : 1/4 - ((p 2 3).2 - (p 2 2).2) < K := hδ 2 2
  have d_2_3 : 1/4 - ((p 2 4).2 - (p 2 3).2) < K := hδ 2 3
  have d_3_0 : 1/4 - ((p 3 1).2 - (p 3 0).2) < K := hδ 3 0
