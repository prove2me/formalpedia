        calc h * (100000 * (n + 3) + 30) ≤ h * (100030 * (n + 3)) :=
              Nat.mul_le_mul_left _ (by omega)
          _ = 100030 * (h * (n + 3)) := by ring
      have hdc : NLogN.difCost n (j + 1) = 2 * NLogN.difCost n j + 800000 * (h * (n + 3)) := by
        simp only [NLogN.difCost, hh, pow_succ]; ring
      have hh3 : n + 3 ≤ h * (n + 3) := Nat.le_mul_of_pos_left _ hh1
