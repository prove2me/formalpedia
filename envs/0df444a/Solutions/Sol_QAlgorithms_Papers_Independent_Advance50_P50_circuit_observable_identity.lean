theorem allBits3_nodup : allBits3.Nodup := by decide

def code3 (x : Fin 3 → Bool) : ℕ :=
  (if x 0 then 4 else 0) + (if x 1 then 2 else 0) + (if x 2 then 1 else 0)

def tbl (L : List (List S110Q4)) : (Fin 3 → Bool) → (Fin 3 → Bool) → S110Q4 :=
  fun x y => (L.getD (code3 x) []).getD (code3 y) zero

theorem eq_of_check (A B : (Fin 3 → Bool) → (Fin 3 → Bool) → S110Q4)
    (h : allBits3.all (fun x => allBits3.all (fun y => decide (A x y = B x y))) = true) : A = B := by
  funext x y
  simp only [List.all_eq_true, decide_eq_true_eq] at h
  exact h x (allBits3_all x) y (allBits3_all y)

def siteQ (j : Fin 3) (a : Bool → Bool → S110Q4) : (Fin 3 → Bool) → (Fin 3 → Bool) → S110Q4 :=
  fun x y => if (decide (j = 0) || x 0 == y 0) && (decide (j = 1) || x 1 == y 1) &&
    (decide (j = 2) || x 2 == y 2) then a (x j) (y j) else zero

def cnotQ (c t : Fin 3) : (Fin 3 → Bool) → (Fin 3 → Bool) → S110Q4 :=
  fun y x => if (y 0 == if (0 : Fin 3) = t then xor (x t) (x c) else x 0) &&
    (y 1 == if (1 : Fin 3) = t then xor (x t) (x c) else x 1) &&
    (y 2 == if (2 : Fin 3) = t then xor (x t) (x c) else x 2) then one else zero

def hQ : Bool → Bool → S110Q4 := fun a b => if a && b then ⟨0, -1/2, 0, 1/2⟩ else ⟨0, 1/2, 0, -1/2⟩
def tQ : Bool → Bool → S110Q4 := fun a b => if a = b then (if a then ⟨0, 1, 0, 0⟩ else one) else zero
def zQ : Bool → Bool → S110Q4 := fun a b => if a = b then (if a then ⟨-1, 0, 0, 0⟩ else one) else zero

