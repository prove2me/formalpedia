-- title:
--   Krull's height theorem
-- statement:
--   **Krull's height theorem.** Let $R$ be a commutative Noetherian ring and $I$ an ideal generated by $n$ elements. Then every prime ideal $\mathfrak p$ minimal over $I$ has height at most $n$.
--
--   This generalises Krull's principal ideal theorem, which is the case $n=1$. It is the foundation of dimension theory for Noetherian rings. It implies that local Noetherian rings have finite Krull dimension, bounded by the number of generators of the maximal ideal.
--
--   **Formalization note.** Mathlib's `Ideal.height_le_spanRank_toENat_of_mem_minimalPrimes`. `I.minimalPrimes` is the set of primes minimal over $I$, and `Submodule.spanRank I` is the least cardinality of a generating set of $I$. It is converted to `ℕ∞` to compare with `Ideal.height`.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `Ideal.height_le_spanRank_toENat_of_mem_minimalPrimes`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

theorem krull_height_theorem {R : Type*} [CommRing R] [IsNoetherianRing R] (I p : Ideal R) (hp : p ∈ I.minimalPrimes) :
    p.height ≤ Cardinal.toENat (Submodule.spanRank I) := by sorry

end FamousTheorems
