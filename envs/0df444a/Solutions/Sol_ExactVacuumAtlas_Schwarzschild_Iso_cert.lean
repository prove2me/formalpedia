open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.Iso

variable (M : ℝ)

/-! ### Domains -/

theorem isOpen_domIsoOut : IsOpen (domIsoOut M) := by
  have h0 : IsOpen {x : Pt 4 | M / 2 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h1 : IsOpen {x : Pt 4 | 0 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h2 : IsOpen {x : Pt 4 | 0 < x 2} := isOpen_lt continuous_const (continuous_apply 2)
  have h3 : IsOpen {x : Pt 4 | x 2 < π} := isOpen_lt (continuous_apply 2) continuous_const
  exact h0.inter (h1.inter (h2.inter h3))

theorem isOpen_domIsoIn : IsOpen (domIsoIn M) := by
  have h0 : IsOpen {x : Pt 4 | 0 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h1 : IsOpen {x : Pt 4 | x 1 < M / 2} := isOpen_lt (continuous_apply 1) continuous_const
  have h2 : IsOpen {x : Pt 4 | 0 < x 2} := isOpen_lt continuous_const (continuous_apply 2)
  have h3 : IsOpen {x : Pt 4 | x 2 < π} := isOpen_lt (continuous_apply 2) continuous_const
  exact h0.inter (h1.inter (h2.inter h3))

theorem isOpen_domStdExt : IsOpen (domStdExt M) := by
  have h0 : IsOpen {x : Pt 4 | 2 * M < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h1 : IsOpen {x : Pt 4 | 0 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h2 : IsOpen {x : Pt 4 | 0 < x 2} := isOpen_lt continuous_const (continuous_apply 2)
  have h3 : IsOpen {x : Pt 4 | x 2 < π} := isOpen_lt (continuous_apply 2) continuous_const
  exact h0.inter (h1.inter (h2.inter h3))

theorem domIsoOut_subset (hM : 0 ≤ M) : domIsoOut M ⊆ domIso M :=
  fun x hx => ⟨hx.2.1, ne_of_gt hx.1, hx.2.2⟩

theorem domIsoIn_subset : domIsoIn M ⊆ domIso M :=
  fun x hx => ⟨hx.1, ne_of_lt hx.2.1, hx.2.2⟩

/-- For `M > 0` the full domain is the disjoint union of the two branches. -/
theorem domIso_eq_union (hM : 0 < M) : domIso M = domIsoOut M ∪ domIsoIn M := by
  ext x
  constructor
  · rintro ⟨h0, hne, h2, h3⟩
    rcases lt_or_gt_of_ne hne with h | h
    · exact Or.inr ⟨h0, h, h2, h3⟩
    · exact Or.inl ⟨h, h0, h2, h3⟩
  · rintro (h | h)
    · exact domIsoOut_subset M hM.le h
    · exact domIsoIn_subset M h

theorem domStdExt_subset_domStd (hM : 0 ≤ M) : domStdExt M ⊆ domStd M :=
  fun x hx => ⟨hx.2.1, ne_of_gt hx.1, hx.2.2⟩

theorem domIsoOut_nonempty (hM : 0 ≤ M) : (domIsoOut M).Nonempty :=
  ⟨equatorPt (M / 2 + 1), by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [equatorPt, pi_pos] <;> linarith⟩

theorem domIsoIn_nonempty (hM : 0 < M) : (domIsoIn M).Nonempty :=
  ⟨equatorPt (M / 4), by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [equatorPt, pi_pos] <;> linarith⟩

theorem domStdExt_nonempty (hM : 0 ≤ M) : (domStdExt M).Nonempty :=
  ⟨equatorPt (2 * M + 1), by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [equatorPt, pi_pos] <;> linarith⟩

/-- `domIso 0 = domEF`. -/
theorem domIso_zero : domIso 0 = domEF := by
  ext x
  simp only [domIso, domEF, Set.mem_setOf_eq, zero_div]
  constructor
  · rintro ⟨h0, _, h2, h3⟩; exact ⟨h0, h2, h3⟩
