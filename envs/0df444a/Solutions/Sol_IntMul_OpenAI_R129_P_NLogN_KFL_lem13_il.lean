    ring
  have e7 : P * ((f + 1) * c ^ 2) = P * (f + 1) * c ^ 2 := by ring
  omega

theorem cRotG_le (K f : ℕ) (g : Geo) (hg : g.Pos) (Bb : ℕ) (hfb : f + 1 ≤ Bb + 2) :
