private theorem torusLift_add_dirFlow (hΘs : Function.Surjective Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H)
    (γ : ℝ →+ A) (c : ι → ℝ) (hγ : ∀ t, Θ (γ t) = dirFlow c t) (a : A) (t : ℝ) :
