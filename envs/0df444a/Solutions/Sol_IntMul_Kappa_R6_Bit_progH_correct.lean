-- Source module: Solutions.R6BitProg
/-!
# Round six, bit side: the recursive interchange program for every width `e`

`progH C q e P L A B Cs` interchanges the two chunks of `e` radix-`q` digits of
`P :: L :: hdShape A B Cs e q`, for **every** `e` (not only `e = m^k`):

* `e < m`: `e` single digit swaps (`tailSwaps`);
* `e = m f + r`, `f ≥ 1`: one level (`levelH`) on the first `m f` digits of each chunk, viewed as
  `m` fields of size `q ^ f`, every run `(i, j, r')` of every edge being a recursive call of width
  `r' f < e`; then the `r` leftover digits by single digit swaps.

`progH_correct`: the denotation is the block swap of the two digit runs, when `C.OK (q ^ f)` for
all `f` and `W ^ depH m e ∣ L` (`depH` = recursion depth).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R]

/-! ## Digit swaps -/

section Tail

lemma foldl_pull_swapPos (sh : Shape) (L : List (ℕ × ℕ))
    (hL : ∀ pr ∈ L, pr.1 < sh.length ∧ pr.2 < sh.length ∧ sh.getD pr.1 0 = sh.getD pr.2 0)
    (g : List ℕ → List ℕ) (xs : List R) :
    L.foldl (fun ys pr => pull sh sh (swapPos pr.1 pr.2) 0 ys) (pull sh sh g 0 xs) =
      pull sh sh (g ∘ chain L) 0 xs := by
  induction L generalizing g with
  | nil => rfl
  | cons pr L ih =>
    obtain ⟨h1, h2, h3⟩ := hL pr List.mem_cons_self
    rw [List.foldl_cons, pull_comp _ _ (fun a ha => valid_swapPos h1 h2 h3 ha),
      ih (fun p hp => hL p (List.mem_cons_of_mem _ hp))]
    rfl

theorem tailSwaps_eq {sh : Shape} {c c' r : ℕ} (hcc : c + r ≤ c') (hlen : c' + r ≤ sh.length)
    (hsz : ∀ k < r, sh.getD (c + k) 0 = sh.getD (c' + k) 0) {xs : List R}
    (hxs : xs.length = vol sh) :
    tailSwaps sh c c' r xs = pull sh sh (blockSwap c c' r) 0 xs := by
  have hL : ∀ pr ∈ runPairs c c' r,
      pr.1 < sh.length ∧ pr.2 < sh.length ∧ sh.getD pr.1 0 = sh.getD pr.2 0 := by
    intro pr hpr
    obtain ⟨k, hk, rfl⟩ := mem_runPairs.1 hpr
    exact ⟨by simp; omega, by simp; omega, hsz k hk⟩
  rw [tailSwaps, ← pull_id 0 hxs, foldl_pull_swapPos sh _ hL, pull_id 0 hxs]
  exact pull_congr (fun a ha => chain_runPairs hcc (by rw [ha.length_eq]; exact hlen)) _ _

/-- Splitting a block swap into a leading part and a tail. -/
lemma blockSwap_split {c c' a b : ℕ} (h : c + a + b ≤ c') {x : List ℕ}
    (hx : c' + a + b ≤ x.length) :
    blockSwap c c' a (blockSwap (c + a) (c' + a) b x) = blockSwap c c' (a + b) x := by
  unfold blockSwap
  rw [permIdx_permIdx (fun k hk => bsIdx_lt (by omega) (by omega) (by simpa using hk))]
  apply permIdx_congr
  intro k _
  simp only [Function.comp_apply, bsIdx]
  split_ifs <;> omega

end Tail

/-! ## Digit shapes -/

section Shapes

lemma hd_digit_H (P L : ℕ) (A B Cs : Shape) (e q k : ℕ) (hk : k < e) :
    (P :: L :: hdShape A B Cs e q).getD (A.length + 2 + k) 0 = q := by
  have := hdShape_getD A B Cs e q k (by omega)
  simp only [hdPos, if_pos hk] at this
  rw [show A.length + 2 + k = (A.length + k) + 1 + 1 by omega]
  simpa using this

lemma hd_digit_D (P L : ℕ) (A B Cs : Shape) (e q k : ℕ) (hk : k < e) :
    (P :: L :: hdShape A B Cs e q).getD (A.length + B.length + e + 2 + k) 0 = q := by
  have := hdShape_getD A B Cs e q (e + k) (by omega)
  simp only [hdPos, if_neg (show ¬ e + k < e by omega)] at this
  rw [show A.length + B.length + e + 2 + k = (A.length + B.length + (e + k)) + 1 + 1 by omega]
  simpa using this

lemma len_hd (P L : ℕ) (A B Cs : Shape) (e q : ℕ) :
    (P :: L :: hdShape A B Cs e q).length = A.length + B.length + e + e + Cs.length + 2 := by
  simp [length_hdShape]; omega

/-- **Fields vs digits.** Swapping two runs of `a` fields of size `q ^ f` is swapping the two
corresponding runs of `a f` radix-`q` digits (the arrays are the same list). -/
theorem field_digit (P L : ℕ) (X Y Z : Shape) (a f q : ℕ) (xs : List R) :
    pull (P :: L :: hdShape X Y Z a (q ^ f)) (P :: L :: hdShape X Y Z a (q ^ f))
        (blockSwap (X.length + 2) (X.length + Y.length + a + 2) a) 0 xs =
      pull (P :: L :: hdShape X Y Z (a * f) q) (P :: L :: hdShape X Y Z (a * f) q)
        (blockSwap (X.length + 2) (X.length + Y.length + a * f + 2) (a * f)) 0 xs := by
  rw [← pull_swapPos_eq_blockSwap P L X Y Z a (q ^ f),
    ← pull_swapPos_eq_blockSwap P L X Y Z (a * f) q, ← pow_mul, mul_comm f a]

lemma hdShape_tail (A B Cs : Shape) (a r q : ℕ) :
    hdShape A B Cs (a + r) q =
      hdShape A (List.replicate r q ++ B) (List.replicate r q ++ Cs) a q := by
  simp only [hdShape, List.replicate_add, List.append_assoc]

lemma hdShape_child (A B Cs : Shape) {m N i j r : ℕ} (hi : i + r ≤ m) (hj : j + r ≤ m) :
    hdShape (A ++ List.replicate i N)
        (List.replicate (m - i - r) N ++ (B ++ List.replicate j N))
        (List.replicate (m - j - r) N ++ Cs) r N = hdShape A B Cs m N := by
  have e1 : ∀ X : List ℕ, List.replicate i N ++ (List.replicate r N ++
      (List.replicate (m - i - r) N ++ X)) = List.replicate m N ++ X := by
    intro X
    rw [← List.append_assoc, ← List.append_assoc, ← List.replicate_add, ← List.replicate_add]
    congr 2; omega
  have e2 : ∀ X : List ℕ, List.replicate j N ++ (List.replicate r N ++
      (List.replicate (m - j - r) N ++ X)) = List.replicate m N ++ X := by
    intro X
    rw [← List.append_assoc, ← List.append_assoc, ← List.replicate_add, ← List.replicate_add]
    congr 2; omega
  simp only [hdShape, List.append_assoc, e1, e2]

lemma vol_hdShape_digits (A B Cs : Shape) (m f q : ℕ) :
    vol (hdShape A B Cs m (q ^ f)) = vol (hdShape A B Cs (m * f) q) := by
  rw [vol_hdShape, vol_hdShape, ← pow_mul, mul_comm f m]

end Shapes

/-! ## Recursion depth -/

section Depth

lemma depH_of_le {m e : ℕ} (h : m ≤ e) (hm : 2 ≤ m) :
    depH m e = depH m ((m - 1) * (e / m)) + 1 := by
  rw [depH, dif_pos ⟨h, hm⟩]

lemma depH_of_not {m e : ℕ} (h : ¬ (m ≤ e ∧ 2 ≤ m)) : depH m e = 0 := by
  rw [depH, dif_neg h]

lemma depH_mono (m : ℕ) : ∀ e e', e ≤ e' → depH m e ≤ depH m e' := by
  intro e e'
  induction e' using Nat.strong_induction_on generalizing e with
  | _ e' ih =>
    intro hle
    by_cases h : m ≤ e ∧ 2 ≤ m
    · rw [depH_of_le h.1 h.2, depH_of_le (e := e') (by omega) h.2]
      have := ih ((m - 1) * (e' / m)) (depH_dec ⟨by omega, h.2⟩) ((m - 1) * (e / m))
        (Nat.mul_le_mul_left _ (Nat.div_le_div_right hle))
      omega
    · rw [depH_of_not h]; exact Nat.zero_le _

lemma depH_child {m e w : ℕ} (hm : 2 ≤ m) (he : m ≤ e) (hw : w < m) :
    depH m (w * (e / m)) + 1 ≤ depH m e := by
  rw [depH_of_le he hm]
  have := depH_mono m (w * (e / m)) ((m - 1) * (e / m)) (Nat.mul_le_mul_right _ (by omega))
  omega

end Depth

