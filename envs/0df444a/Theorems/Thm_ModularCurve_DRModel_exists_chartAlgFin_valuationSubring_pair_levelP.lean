-- title:
--   Two branch valuation rings of ℚ(X₀(p)) above p
-- statement:
--   Let $p$ be a prime and let $F$ denote `modularFunctionFieldFull p`, the subfield of $\mathbb{Q}((q))$ generated over $\mathbb{Q}$ by the divisor expansions of level $p$, with distinguished element $j =$ `IgusaScheme.jFull p`, the Laurent series `jq`. The assertion is that there exist an element $j_p$ of the subalgebra `TwoChartIntegralModel.chartAlgFin ℤ F j`, consisting of those elements of $F$ that are integral over the $\mathbb{Z}$-subalgebra generated by $j$, and two valuation subrings $W_0, W_1$ of $F$, with the following properties. First, the Laurent series underlying $j_p$ is `qExpand ℚ p jq`, the image of $j$ under multiplication by $p$ on exponents. Second, the image of $p$ in $F$ is a nonunit of $W_0$ and of $W_1$, and $W_0 \neq W_1$. Third, for each index $i$ of the pair $(W_0, W_1)$ and each $P \in \mathbb{Z}[X]$ whose reduction modulo $p$ is nonzero, both $P(j)$ and $P(j)^{-1}$ lie in $W_i$. Fourth, any valuation subring $V$ of $F$ in which $p$ is a nonunit and which contains $P(j)^{\pm 1}$ for all such $P$ is equal to $W_0$ or to $W_1$. Fifth, $j_p - j^{p}$ is a nonunit of $W_0$. Finally, every $x \in W_0$ admits $P, Q \in \mathbb{Z}[X]$ with $Q$ nonzero modulo $p$ and $x\,Q(j) - P(j)$ a nonunit of $W_0$, and every $x \in W_1$ admits $P, Q \in \mathbb{Z}[X]$ with $Q$ nonzero modulo $p$ and $x\,Q(j_p) - P(j_p)$ a nonunit of $W_1$.
--
--   This is the valuation-theoretic form of the description of the two branches of the special fibre of $X_0(p)$ at $p$: $W_0$ is the $p$-adic Gauss valuation ring attached to the $q$-expansion at the cusp $\infty$ and $W_1$ its transform under the Atkin–Lehner involution, the congruence $j_p \equiv j^{p}$ singling out the $\infty$-branch, while the last two clauses express that the residue fields are generated over $\mathbb{F}_p$ by the reduction of $j$, respectively of $j_p$. It supplies the local input for the two-chart integral model `DRModel` of level $p$, and is used by the statements about germs and stalks of that model.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_DRModel_exists_chartAlgFin_valuationSubring_pair_levelP.lean

import Mathlib
import Definitions.Def_ModularCurve_DRModelPackage

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open ModularCurve AlgebraicCurve Polynomial

theorem ModularCurve.DRModel.exists_chartAlgFin_valuationSubring_pair_levelP
    (p : ℕ) [Fact p.Prime] [NeZero p] :
    ∃ (jp : ↥(TwoChartIntegralModel.chartAlgFin ℤ ↥(modularFunctionFieldFull p) (IgusaScheme.jFull p)))
      (W₀ W₁ : ValuationSubring ↥(modularFunctionFieldFull p)),

      ((jp : ↥(modularFunctionFieldFull p)) : LaurentSeries ℚ) = qExpand ℚ p jq ∧

      ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ W₀.nonunits ∧
      ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ W₁.nonunits ∧

      W₀ ≠ W₁ ∧

      (∀ i : Fin 2, ∀ P : Polynomial ℤ, P.map (Int.castRingHom (ZMod p)) ≠ 0 →
        Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P
            ∈ (![W₀, W₁] i) ∧
        (Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P)⁻¹
            ∈ (![W₀, W₁] i)) ∧

      (∀ V : ValuationSubring ↥(modularFunctionFieldFull p),
        ((p : ℕ) : ↥(modularFunctionFieldFull p)) ∈ V.nonunits →
        (∀ P : Polynomial ℤ, P.map (Int.castRingHom (ZMod p)) ≠ 0 →
          Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P ∈ V ∧
          (Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P)⁻¹ ∈ V) →
        V = W₀ ∨ V = W₁) ∧

      ((jp : ↥(modularFunctionFieldFull p)) - (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) ^ p) ∈ W₀.nonunits ∧

      (∀ x : ↥(modularFunctionFieldFull p), x ∈ W₀ → ∃ P Q : Polynomial ℤ, Q.map (Int.castRingHom (ZMod p)) ≠ 0 ∧
        x * Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) Q
          - Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (IgusaScheme.jFull p : ↥(modularFunctionFieldFull p)) P
            ∈ W₀.nonunits) ∧

      (∀ x : ↥(modularFunctionFieldFull p), x ∈ W₁ → ∃ P Q : Polynomial ℤ, Q.map (Int.castRingHom (ZMod p)) ≠ 0 ∧
        x * Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (jp : ↥(modularFunctionFieldFull p)) Q
          - Polynomial.eval₂ (algebraMap ℤ ↥(modularFunctionFieldFull p)) (jp : ↥(modularFunctionFieldFull p)) P
            ∈ W₁.nonunits) := by sorry
