section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFY
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
variable {M : MulSpec} {Ctx : IState HS → Prop} {B : ℕ}
set_option maxHeartbeats 4000000
theorem solution (ax : NLogN.GL.Axis M Ctx B) (Bo : ℕ) (s : NLogN.IState NLogN.HS) (Q : ℕ)
    (hr : NLogN.AX.AxReady2 ax Bo s Q) (hC : Ctx s) (L : List (ℤ × ℤ)) (Rest : List NLogN.Item)
    (hD : s.G NLogN.GL.gD = NLogN.gints L ++ Rest) (hL : L.length = ax.m * ax.n) (hLB : NLogN.GL.GB B L) :
    (NLogN.KFY.coreQ ax).run s = s.upd NLogN.GL.gD (NLogN.gints (NLogN.KFY.coreOut ax L) ++ Rest) ∧
    (NLogN.KFY.coreQ ax).ok M s ∧ (NLogN.KFY.coreQ ax).cost M s ≤ NLogN.KFY.coreCost ax Q ∧
    (NLogN.KFY.coreOut ax L).length = ax.m * ax.n' ∧ NLogN.GL.GB Bo (NLogN.KFY.coreOut ax L) := by
  set X := IntMul.HvdH.Ref.chunkL ax.n L with hX
  have hXl : X.length = ax.m := NLogN.GL.chunkL_length ax.n ax.m _ hr.hn hL
  have hc : ∀ x ∈ X, x.length = ax.n ∧ NLogN.GL.GB B x := by
    intro x hx
    obtain ⟨h1, h2⟩ := NLogN.GL.chunkL_mem ax.n ax.m _ hr.hn hL x hx
    exact ⟨h1, fun z hz => hLB z (h2 z hz)⟩
  have hOl : (NLogN.KFY.coreOut ax L).length = ax.m * ax.n' := by
    rw [NLogN.KFY.coreOut, NLogN.AX.flatMap_length_const _ _ ax.n'
      (fun x hx => (hr.hf x (hc x hx).1 (hc x hx).2).1), hXl]
  have hOB : NLogN.GL.GB Bo (NLogN.KFY.coreOut ax L) := by
    intro z hz
    simp only [NLogN.KFY.coreOut, List.mem_flatMap] at hz
    obtain ⟨x, hx, hz⟩ := hz
    exact (hr.hf x (hc x hx).1 (hc x hx).2).2 z hz
  have rf := NLogN.AX.regs_facts2 hr
  obtain ⟨rm1, -, -, rm4⟩ := rf ax.rm (by simp)
  obtain ⟨rt1, -, -, rt4⟩ := rf ax.rtot (by simp)
  obtain ⟨Lm, hLm⟩ := hr.vm
  obtain ⟨Lt, hLt⟩ := hr.vtot
  obtain ⟨-, -, -, -, f5, f6, f7, f8⟩ := NLogN.GL.cnt2_facts' ax.rm (by omega) s ax.m Lm Q hLm hr.bm
  have CB : ∀ x ∈ X, ∀ (t : NLogN.IState NLogN.HS) (r o : List NLogN.Item),
      (∀ j, j ∉ [NLogN.GL.gD, NLogN.GL.gU1, NLogN.GL.gZB, NLogN.GL.gU2, NLogN.GL.gCC] → t.G j = s.G j) →
      t.G NLogN.GL.gD = NLogN.gints x ++ r → t.G NLogN.GL.gZB = o ++ s.G NLogN.GL.gZB →
      (NLogN.GL.chunkBody ax).run t = (t.upd NLogN.GL.gD r).upd NLogN.GL.gZB ((NLogN.gints (ax.f x)).reverse ++ t.G NLogN.GL.gZB) ∧
        (NLogN.GL.chunkBody ax).ok M t ∧
        (NLogN.GL.chunkBody ax).cost M t ≤ ax.C + 3 * (8000 * (Q + 2) + 2 * (ax.n + ax.n') *
          (14000 * (Q + 2) + 30) + 32) := by
    intro x hx t r o hfr ht _
    refine NLogN.AX.chunkBody_all2 ax Bo s Q hr hC t x r ?_ ht (hc x hx).1 (hc x hx).2
    intro j hj
    have h1 : j ∉ [NLogN.GL.gD, NLogN.GL.gU1, NLogN.GL.gZB, NLogN.GL.gU2, NLogN.GL.gCC] := by
      intro h; apply hj; simp only [List.mem_cons, List.not_mem_nil, or_false] at h
      rcases h with h | h | h | h | h <;> subst h <;> decide
    exact hfr j h1
  obtain ⟨Lr, Lo, Lc⟩ := NLogN.GL.loop11 M (NLogN.GL.chunkBody ax) NLogN.GL.gD NLogN.GL.gZB NLogN.GL.gCC NLogN.GL.gU1 NLogN.GL.gU2 NLogN.gints NLogN.gints ax.f s X Rest
    _ ax.m Q (.reg ax.rm) (by decide)
    (by rw [hD, hX, ← NLogN.GL.gints_flatten, NLogN.GL.chunkL_flatten ax.n ax.m _ hr.hn hL]) hXl f5
    (NLogN.GL.chunkBody_writes ax hr.sI hr.sO hr.sW) CB (by decide) f6 f7 trivial f8
  set s2 := (s.upd NLogN.GL.gD Rest).upd NLogN.GL.gZB (((X.map ax.f).flatMap NLogN.gints).reverse ++ s.G NLogN.GL.gZB) with hs2
  have s2t : s2.G ax.rtot = .int (ax.m * ax.n') :: Lt := by
    simp [hs2, (NLogN.GL.notW rt1).1, (NLogN.GL.notW rt1).2.2.2.2.2.1, hLt]
  have hfl : (X.map ax.f).flatMap NLogN.gints = NLogN.gints (NLogN.KFY.coreOut ax L) := by
    rw [NLogN.KFY.coreOut, ← hX, ← NLogN.GL.gints_flatten, List.flatMap_def]
  obtain ⟨r3, o3, c3⟩ := NLogN.GL.mvG_rev M NLogN.GL.gZB NLogN.GL.gD ax.rtot s2 (NLogN.KFY.coreOut ax L) (s.G NLogN.GL.gZB) Lt Q (ax.m * ax.n')
    (by decide) (by decide) (by decide) (by decide) (by decide) (by omega)
    (by simp [hs2, hfl]) hOl s2t hr.btot (hOB.mono hr.bBo)
  refine ⟨?_, ⟨Lo, ?_⟩, ?_, hOl, hOB⟩
  · show (NLogN.RM.rs _).run ((NLogN.RM.rep _ _ _).run s) = _
    rw [Lr, r3]
    apply NLogN.IState.ext' _ (by simp [hs2]) (by simp [hs2])
    intro j
    by_cases j1 : j = NLogN.GL.gD
    · subst j1; simp (config := {decide := true}) [hs2]
    by_cases j2 : j = NLogN.GL.gZB
    · subst j2; simp (config := {decide := true}) [hs2]
    simp [hs2, j1, j2]
  · show (NLogN.RM.rs _).ok M ((NLogN.RM.rep _ _ _).run s)
    rw [Lr]; exact o3
  · show (NLogN.RM.rep _ _ _).cost M s + (NLogN.RM.rs _).cost M ((NLogN.RM.rep _ _ _).run s) ≤ _
    rw [Lr]
    simp only [NLogN.Ex.size, NLogN.KFY.coreCost] at Lc ⊢
    nlinarith
end
