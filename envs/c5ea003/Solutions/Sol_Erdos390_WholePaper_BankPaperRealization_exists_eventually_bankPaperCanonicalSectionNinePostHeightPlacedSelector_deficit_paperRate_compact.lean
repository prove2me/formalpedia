  have hyNatLower : ArithmeticModel.y n / 2 ≤
      (ArithmeticModel.yNat n : ℝ) := by
    have hfloor := Nat.lt_floor_add_one (ArithmeticModel.y n)
    change ArithmeticModel.y n <
