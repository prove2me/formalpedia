section

variable {K : Type*} [Field K]

private theorem range_val : Set.range (Units.val : Kˣ → K) = {0}ᶜ := by
  ext x
  simp only [Set.mem_range, Set.mem_compl_iff, Set.mem_singleton_iff]
  exact ⟨fun ⟨u, hu⟩ => hu ▸ u.ne_zero, fun hx => ⟨Units.mk0 x hx, rfl⟩⟩

section

variable [TopologicalSpace K] [T1Space K] [MeasurableSpace K] [BorelSpace K]

private theorem measurableSet_image_val {s : Set Kˣ} (hs : MeasurableSet s) :
    MeasurableSet (Units.val '' s) := by
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
  rw [Set.image_preimage_eq_inter_range, range_val]
  exact ht.inter (measurableSet_singleton (0 : K)).compl

private theorem measurableEmbedding_val : MeasurableEmbedding (Units.val : Kˣ → K) where
  injective := Units.val_injective
  measurable := comap_measurable Units.val
  measurableSet_image' := fun _ hs => measurableSet_image_val hs

private theorem borelSpace_units [ContinuousInv₀ K] : BorelSpace Kˣ :=
  measurableEmbedding_val.borelSpace Units.isEmbedding_val₀.toIsInducing

end
