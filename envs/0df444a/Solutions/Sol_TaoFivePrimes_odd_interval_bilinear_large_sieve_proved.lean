theorem odd_block_inner_mass_le_of_selberg
    (hLS : SelbergRealEndpointLargeSieveExpCircle)
    (alpha delta M n0 n1 m0 : ℝ)
    (I J : Finset ℕ) (A : ℕ → ℂ) (b : ℕ)
    (hdelta : 0 < delta) (hM : 1 ≤ M)
    (hIodd : ∀ n ∈ I, n.Coprime 2)
    (hJodd : ∀ m ∈ J, m.Coprime 2)
    (hIrange : ∀ n ∈ I, n0 ≤ (n : ℝ) ∧ (n : ℝ) ≤ n1)
    (hJlow : ∀ m ∈ J, m0 ≤ (m : ℝ))
    (hspacing : ∀ j : ℕ, 1 ≤ j → (j : ℝ) ≤ M →
      delta ≤ ‖(((4 * (j : ℝ) * alpha : ℝ)) : AddCircle (1 : ℝ))‖) :
    ∑ m ∈ J.filter (fun m => oddLSBlockIndex m0 M m = b),
        ‖∑ n ∈ I, A n * expCircle (alpha * (n * m))‖ ^ 2 ≤
      ((n1 - n0) / 2 + 1 / delta) * ∑ n ∈ I, ‖A n‖ ^ 2 := by
  have hMpos : 0 < M := lt_of_lt_of_le zero_lt_one hM
  have hdelta1 : delta ≤ 1 := by
    have hs := hspacing 1 (by omega) (by norm_num; exact hM)
    norm_num at hs
    have hn := AddCircle.norm_le_half_period (1 : ℝ)
      (x := (((4 * (1 : ℝ) * alpha : ℝ)) : AddCircle (1 : ℝ))) (by norm_num)
    norm_num at hn
    linarith
  let P : Finset ℕ := I.image oddHalfIndex
  have hfit : ∀ r ∈ P,
      (n0 - 1) / 2 ≤ (r : ℝ) ∧ (r : ℝ) ≤ (n1 - 1) / 2 := by
    intro r hr
    simp only [P, Finset.mem_image] at hr
    obtain ⟨n, hn, rfl⟩ := hr
    rw [oddHalfIndex_cast (hIodd n hn)]
    have hnfit := hIrange n hn
    constructor <;> linarith
  have hspaced : UnitWellSpaced delta
      (J.filter (fun m => oddLSBlockIndex m0 M m = b))
      (fun m => 2 * alpha * (m : ℝ)) :=
    oddBlock_unitWellSpaced b hMpos hJodd hJlow hspacing
  have hb := selbergRealEndpointLargeSieve_closed_left hLS
    (J.filter (fun m => oddLSBlockIndex m0 M m = b))
    (fun m => 2 * alpha * (m : ℝ))
    (fun r => A (2 * r + 1)) P ((n0 - 1) / 2) ((n1 - 1) / 2) delta
    hdelta hdelta1 hfit hspaced
  have hleft :
      (∑ m ∈ J.filter (fun m => oddLSBlockIndex m0 M m = b),
          ‖∑ r ∈ P, A (2 * r + 1) *
            expCircle ((2 * alpha * (m : ℝ)) * r)‖ ^ 2) =
        ∑ m ∈ J.filter (fun m => oddLSBlockIndex m0 M m = b),
          ‖∑ n ∈ I, A n * expCircle (alpha * (n * m))‖ ^ 2 := by
    apply Finset.sum_congr rfl
    intro m hm
    rw [norm_odd_inner_sum_eq alpha m I A hIodd]
  have hmass : ∑ r ∈ P, ‖A (2 * r + 1)‖ ^ 2 = ∑ n ∈ I, ‖A n‖ ^ 2 := by
    exact sum_image_oddHalfIndex I hIodd (fun n => ‖A n‖ ^ 2)
  rw [hleft, hmass] at hb
  convert hb using 1
  ring
theorem odd_interval_bilinear_large_sieve_of_selberg
    (hLS : SelbergRealEndpointLargeSieveExpCircle)
    (alpha delta M n0 n1 m0 m1 : ℝ)
    (I J : Finset ℕ) (A B : ℕ → ℂ)
    (hdelta : 0 < delta) (hM : 1 ≤ M)
    (hIodd : ∀ n ∈ I, n.Coprime 2)
    (hJodd : ∀ m ∈ J, m.Coprime 2)
    (hIrange : ∀ n ∈ I, n0 ≤ (n : ℝ) ∧ (n : ℝ) ≤ n1)
    (hJrange : ∀ m ∈ J, m0 ≤ (m : ℝ) ∧ (m : ℝ) ≤ m1)
    (hIlength : 2 ≤ n1 - n0) (hJlength : 2 ≤ m1 - m0)
    (hspacing : ∀ j : ℕ, 1 ≤ j → (j : ℝ) ≤ M →
      delta ≤ ‖(((4 * (j : ℝ) * alpha : ℝ)) : AddCircle (1 : ℝ))‖) :
    ‖∑ p ∈ J.product I,
        A p.2 * B p.1 * expCircle (alpha * (p.2 * p.1))‖ ≤
      Real.sqrt ((n1 - n0) / 2 + 1 / delta) *
        Real.sqrt ((m1 - m0) / (2 * M) + 1) *
          Real.sqrt (∑ n ∈ I, ‖A n‖ ^ 2) *
            Real.sqrt (∑ m ∈ J, ‖B m‖ ^ 2) := by
  let inner : ℕ → ℂ := fun m =>
    ∑ n ∈ I, A n * expCircle (alpha * (n * m))
  let block : ℕ → ℕ := oddLSBlockIndex m0 M
  let blocks : Finset ℕ := J.image block
  let nfac : ℝ := (n1 - n0) / 2 + 1 / delta
  let mfac : ℝ := (m1 - m0) / (2 * M) + 1
  let amass : ℝ := ∑ n ∈ I, ‖A n‖ ^ 2
  let bmass : ℝ := ∑ m ∈ J, ‖B m‖ ^ 2
