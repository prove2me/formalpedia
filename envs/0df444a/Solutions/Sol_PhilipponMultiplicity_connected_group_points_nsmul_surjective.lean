namespace PhilipponMultiplicity.LocalPrimeDivisibility

/-- In a connected space with separately continuous group operations, a
subgroup with nonempty interior is the whole group. -/
theorem addSubgroup_eq_top_of_nonempty_interior {A : Type*}
    [AddGroup A] [TopologicalSpace A] [SeparatelyContinuousAdd A]
    [PreconnectedSpace A] (H : AddSubgroup A)
    (hH : (interior (H : Set A)).Nonempty) : H = ⊤ := by
  obtain ⟨x, hx⟩ := hH
  have hopen : IsOpen (H : Set A) :=
    H.isOpen_of_mem_nhds (mem_interior_iff_mem_nhds.mp hx)
  have hfull : (H : Set A) = Set.univ :=
    (show IsClopen (H : Set A) from ⟨H.isClosed_of_isOpen hopen, hopen⟩).eq_univ
      ⟨0, H.zero_mem⟩
  exact SetLike.coe_injective hfull

/-- A homomorphism whose image contains a nonempty open set is surjective when
the codomain is connected and its translations are continuous. -/
theorem surjective_of_range_interior_nonempty {A B : Type*}
    [AddGroup A] [AddGroup B] [TopologicalSpace B] [SeparatelyContinuousAdd B]
    [PreconnectedSpace B] (f : A →+ B)
    (hf : (interior (Set.range f)).Nonempty) : Function.Surjective f := by
  have htop : f.range = ⊤ := addSubgroup_eq_top_of_nonempty_interior f.range hf
  intro y
  have hy : y ∈ f.range := by rw [htop]; trivial
  exact hy

/-- Division by each prime suffices for division by every positive integer. -/
theorem nsmul_surjective_of_primes {A : Type*} [AddMonoid A]
    (hprime : ∀ p : ℕ, p.Prime → Function.Surjective (fun x : A => p • x)) :
    ∀ n : ℕ, 0 < n → Function.Surjective (fun x : A => n • x) := by
  apply Nat.recOnMul
  · intro h
    exact False.elim (Nat.lt_irrefl 0 h)
  · intro _ x
    exact ⟨x, one_nsmul x⟩
  · intro p hp _
    exact hprime p hp
  · intro a b ha hb hab x
    have ha' : 0 < a := Nat.pos_of_mul_pos_right hab
    have hb' : 0 < b := Nat.pos_of_mul_pos_left hab
    obtain ⟨y, hy⟩ := ha ha' x
    obtain ⟨z, hz⟩ := hb hb' y
    refine ⟨z, ?_⟩
    change (a * b) • z = x
    change b • z = y at hz
    change a • y = x at hy
    rw [Nat.mul_comm a b, mul_nsmul, hz, hy]

/-- Local prime divisibility propagates first through connectedness and then
through products of positive integers. Joint continuity is not required. -/
theorem nsmul_surjective_of_prime_interior {A : Type*}
    [AddCommGroup A] [TopologicalSpace A] [SeparatelyContinuousAdd A]
    [PreconnectedSpace A]
    (hlocal : ∀ p : ℕ, p.Prime →
      (interior (Set.range (fun x : A => p • x))).Nonempty) :
    ∀ n : ℕ, 0 < n → Function.Surjective (fun x : A => n • x) := by
  apply nsmul_surjective_of_primes
  intro p hp
  let f : A →+ A :=
    { toFun := fun x => p • x
      map_zero' := nsmul_zero p
      map_add' := fun x y => nsmul_add x y p }
  exact surjective_of_range_interior_nonempty f (hlocal p hp)

end PhilipponMultiplicity.LocalPrimeDivisibility
end


