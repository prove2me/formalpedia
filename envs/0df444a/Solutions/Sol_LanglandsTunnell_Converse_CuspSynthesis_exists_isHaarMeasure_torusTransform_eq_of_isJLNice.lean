private theorem t0900 (v : Valuation F ℤᵐ⁰) (π : F) (hπ0 : π ≠ 0)
    (hπ : v π = WithZero.exp (-1 : ℤ)) {A : F} (hA : A ≠ 0) (a : ℤ) (uA : F) (huA : v uA = 1) (hAe : A = π ^ a * uA)
    (x : F) (m n kk : ℤ) (k : GL (Fin 2) v.integer) (hxv : v (A * x) = WithZero.exp (-kk)) (hlt : kk < a + m) :
    ∃ k' : GL (Fin 2) v.integer,
      d101 A hA * (unipotent x * diagZ π hπ0 m * scalarPi π hπ0 ^ n * GeneralLinearGroup.map v.integer.subtype k)
        = unipotent (-(A * x)⁻¹) * diagZ π hπ0 (a + m - 2 * kk) * scalarPi π hπ0 ^ (n + kk) *
            GeneralLinearGroup.map v.integer.subtype k' := by
  have hy0 : A * x ≠ 0 := by
    intro h
    rw [h, map_zero] at hxv
    exact WithZero.exp_ne_zero hxv.symm
  have hu₁ : v (A * x / π ^ kk) = 1 := by
    rw [map_div₀, map_zpow₀, hπ, hxv, ← WithZero.exp_zsmul, smul_eq_mul, mul_neg_one,
      div_eq_one_iff_eq WithZero.exp_ne_zero]
  have htI : π ^ (a + m) / (A * x) ∈ v.integer := by
    rw [Valuation.mem_integer_iff, map_div₀, map_zpow₀, hπ, ← WithZero.exp_zsmul, smul_eq_mul, mul_neg_one,
      div_le_one₀ (by simpa using (Valuation.pos_iff v).mpr hy0), hxv]
    exact WithZero.exp_le_exp.mpr (by linarith)
  refine ⟨d102 v (-(d047 v _ hu₁)⁻¹) (-d047 v _ hu₁) * d103 v ⟨_, htI⟩ *
    d102 v (d047 v uA huA) 1 * k, ?_⟩
  have huA0 : uA ≠ 0 := by rintro rfl; simp at huA
  have hx0 : x ≠ 0 := right_ne_zero_of_mul hy0
  have key : d101 A hA * (unipotent x * diagZ π hπ0 m * scalarPi π hπ0 ^ n)
      = unipotent (-(A * x)⁻¹) * diagZ π hπ0 (a + m - 2 * kk) * scalarPi π hπ0 ^ (n + kk) *
          (GeneralLinearGroup.map v.integer.subtype
              (d102 v (-(d047 v _ hu₁)⁻¹) (-d047 v _ hu₁)) *
            GeneralLinearGroup.map v.integer.subtype (d103 v ⟨_, htI⟩) *
            GeneralLinearGroup.map v.integer.subtype (d102 v (d047 v uA huA) 1)) := by
    subst hAe
    ext i j
    simp only [Units.val_mul, t0428, t0429, t0426, t0427, t0895,
      t0897, t0896, Units.val_neg, Units.val_one, OneMemClass.coe_one, d047]
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, zpow_add₀ hπ0, zpow_sub₀ hπ0, _root_.zpow_neg, two_mul, huA0, hx0] <;>
      (try field_simp) <;> (try ring)
  simp only [map_mul]
  rw [← mul_assoc, key]
  simp only [mul_assoc]

