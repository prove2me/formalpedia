/-! ## Arithmetic -/

theorem sWidth_eq (p α : ℕ) :
    sWidth p α = (if Nat.sqrt p * Nat.sqrt p < p then Nat.sqrt p + 1 else Nat.sqrt p) * α := rfl

theorem HH_pos (p α : ℕ) : 1 ≤ HH p α := Nat.one_le_two_pow

theorem log_lt (m : ℕ) (hm : 1 ≤ m) : Nat.log 2 m < m := Nat.log_lt_self 2 (by omega)

