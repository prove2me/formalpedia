-- title:
--   Partial-Fourier rotation group and its maximal generator
-- statement:
--   Let $n\ge1$. Let $\mathcal F_p$ be the unitary $L^2$ extension of the partial Fourier transform with phase $e^{-ip\cdot\xi_p}$ and normalization $(2\pi)^{-n/2}$. The operator
--   $$
--   U_R(\theta)\Psi=\mathcal F_p^{-1}\big[(\mathcal F_p\Psi)(x\cos\theta+\xi_p\sin\theta,\xi_p\cos\theta-x\sin\theta)\big]
--   $$
--   forms a strongly continuous unitary group, generated by $H_R=\sum_j\partial_{x_j}\partial_{p_j}-x\cdot p$ on its maximal distributional $L^2$ domain. Its full generator graph consists exactly of pairs $(\Psi,\Phi)$ for which $\left.\frac{d}{d\theta}U_R(\theta)\Psi\right|_{\theta=0}=-i\Phi$ in Hilbert norm.
--
--   Fourier integrals specify the transform on Schwartz inputs; arbitrary $L^2$ inputs use its continuous extension.
-- source:
--   Quantum mechanics in phase space: The Schr\"odinger and the Moyal representations, arXiv:1209.1850v1, PDF p. 20, Theorem 5.3

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P20

noncomputable section

attribute [local instance] Classical.propDecidable

open MeasureTheory

open scoped BigOperators

namespace QAlgorithms.Papers.Independent.Next46.P20

open QAlgorithms.Papers.Independent.Claimed50.P10 (Configuration coordinateDot)

open QAlgorithms.Papers.Independent.Claimed50.P05 (restrictGraph)

open QAlgorithms.Papers.Independent.Claimed50.P37 (PhaseCoordinates)

/-- PDF pp.20–21, Theorem 5.3: partial Fourier rotation formula, L2 unitarity,
strongly continuous group, and its full maximal differential generator H_R. -/
theorem rotation_evolution_group {n : ℕ} (hn : 0 < n) :
    RealizesPartialFourier (partialFourier (n := n)) ∧
    unitaryL2 (partialFourier (n := n)) ∧
    (∀ theta : ℝ, RealizesL2Formula (fun f z => f (mixedRotation theta z))
      (coordinatePullback (mixedRotation (n := n) theta))) ∧
    strongUnitaryGroup (rotationEvolution (n := n)) ∧
    generatesGraph (rotationEvolution (n := n)) (weakPhaseGraph rotationTestAction) := by sorry

end QAlgorithms.Papers.Independent.Next46.P20

end
