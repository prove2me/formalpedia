private theorem stdBasis_inl (w : {w : InfinitePlace F // w.IsReal}) :
    stdBasis F (Sum.inl w) = ((Pi.single w (1 : ℝ), 0) : mixedSpace F) := by
  simp [stdBasis]

private theorem stdBasis_inr_fst (w : {w : InfinitePlace F // w.IsComplex}) :
    stdBasis F (Sum.inr (w, 0)) = ((0, Pi.single w (1 : ℂ)) : mixedSpace F) := by
  simp [stdBasis]

private theorem stdBasis_inr_snd (w : {w : InfinitePlace F // w.IsComplex}) :
    stdBasis F (Sum.inr (w, 1)) = ((0, Pi.single w Complex.I) : mixedSpace F) := by
  simp [stdBasis]

private def sigPlace : index F → InfinitePlace F
  | .inl w => w.1
  | .inr (w, _) => w.1

