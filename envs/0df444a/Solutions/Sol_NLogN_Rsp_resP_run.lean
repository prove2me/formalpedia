    NLogN.Rsp.resP.run s0 = s0.upd NLogN.Rsp.CU (NLogN.ints (NLogN.Rsp.resL R Dl Ws u a n) ++ RU) := by
  have hc := NLogN.Rsp.cycP_run s0 u a (u.length + NR) RU LKs LKa LKN hs ha hU hKs hKa hKN
  simp only [NLogN.Rsp.resP, NLogN.RM.seqL, NLogN.RM.run_seq, NLogN.RM.run_rs]
