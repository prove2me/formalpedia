    (Ex.sel c x y).eval s = y.eval s ∧ ((Ex.sel c x y).ok s ↔ c.ok s ∧ y.ok s) ∧
    ((Ex.sel c x y).Bnd s B ↔ c.Bnd s B ∧ y.Bnd s B) := by
  refine ⟨if_neg h, ?_, ?_⟩
  · show (_ ∧ ite _ _ _) ↔ _
    rw [if_neg h]
