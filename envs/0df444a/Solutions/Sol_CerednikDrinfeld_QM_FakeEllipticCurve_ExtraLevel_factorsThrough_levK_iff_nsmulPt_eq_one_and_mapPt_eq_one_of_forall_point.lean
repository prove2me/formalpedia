namespace P8XLKC3

variable {S : Type} [CommRing S]

theorem nsmulPt_eq_nsmul {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (n : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, ← ih]; rfl

theorem nsmulPt_comp {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T T' : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (t' : T' ⟶ Spec (CommRingCat.of S))
    (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (n : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t' n (schemeHomOverComp ψ hψ P) = schemeHomOverComp ψ hψ (nsmulPt L t n P) := by
  rw [nsmulPt_eq_nsmul, nsmulPt_eq_nsmul, L.nsmul_natural]

theorem nsmulPt_comp_eq_one {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T T' : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (t' : T' ⟶ Spec (CommRingCat.of S))
    (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (n : ℕ) (P : SchemeHomOver t f) (hP : nsmulPt L t n P = L.one t) :
    nsmulPt L t' n (schemeHomOverComp ψ hψ P) = L.one t' := by
  rw [nsmulPt_comp, hP]; exact L.one_natural t t' ψ hψ

theorem nsmulPt_unit {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (n : ℕ) : nsmulPt L t n (L.one t) = L.one t := by
  rw [nsmulPt_eq_nsmul]; exact L.nsmul_unit t n

theorem mapPt_schemeHomOverComp {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} {f' : A' ⟶ Spec (CommRingCat.of S)}
    (φ : A ⟶ A') (hφ : φ ≫ f' = f) {T T' : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (t' : T' ⟶ Spec (CommRingCat.of S))
    (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (P : SchemeHomOver t f) :
    mapPt φ hφ (schemeHomOverComp ψ hψ P) = schemeHomOverComp ψ hψ (mapPt φ hφ P) := by
  apply Subtype.ext; simp only [mapPt_coe, schemeHomOverComp_coe, Category.assoc]

theorem map_one {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} {f' : A' ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) (L' : RelativeGroupLaw S f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hhom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) : mapPt φ hφ (L.one t) = L'.one t := by
  have h := hhom t (L.one t) (L.one t)
  rw [L.one_mul] at h
  have := congrArg (L'.mul t (L'.inv t (mapPt φ hφ (L.one t)))) h
  rw [← L'.mul_assoc, L'.inv_mul_cancel, L'.one_mul] at this
  exact this.symm

theorem map_nsmulPt {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} {f' : A' ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) (L' : RelativeGroupLaw S f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hhom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (n : ℕ) (P : SchemeHomOver t f) :
    mapPt φ hφ (nsmulPt L t n P) = nsmulPt L' t n (mapPt φ hφ P) := by
  induction n with
  | zero => exact map_one L L' φ hφ hhom t
  | succ n ih => simp only [nsmulPt]; rw [hhom, ih]

theorem mapPt_mapPt {A A' A'' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} {f' : A' ⟶ Spec (CommRingCat.of S)}
    {f'' : A'' ⟶ Spec (CommRingCat.of S)} (φ : A ⟶ A') (hφ : φ ≫ f' = f) (ψ : A' ⟶ A'') (hψ : ψ ≫ f'' = f')
    {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)} (P : SchemeHomOver t f) :
    mapPt ψ hψ (mapPt φ hφ P) = mapPt (φ ≫ ψ) (by rw [Category.assoc, hψ, hφ]) P := by
  apply Subtype.ext; simp only [mapPt_coe, Category.assoc]

end P8XLKC3

theorem solution
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ} [NeZero N]
    (k₀ : Type) [Field k₀] [IsAlgClosed k₀] (E : FakeEllipticCurve Λ N k₀)
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓk : (ℓ : k₀) ≠ 0)
    (f : E.A ⟶ E.A) (hf : f ≫ E.f = E.f)
    (hf_hom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P Q : SchemeHomOver t E.f),
      mapPt f hf (E.L.mul t P Q) = E.L.mul t (mapPt f hf P) (mapPt f hf Q))
    (K : E.ExtraLevel ℓ)
    (W : ZMod ℓ × ZMod ℓ → SchemeHomOver (𝟙 (Spec (CommRingCat.of k₀))) E.f) (hW_inj : Function.Injective W)
    (hW_mem : ∀ i : ZMod ℓ × ZMod ℓ, FactorsThrough K.levK (W i))
    (hW_kill : ∀ i : ZMod ℓ × ZMod ℓ, mapPt f hf (W i) = E.L.one (𝟙 (Spec (CommRingCat.of k₀))))
    (hW_all : ∀ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of k₀))) E.f,
      nsmulPt E.L (𝟙 (Spec (CommRingCat.of k₀))) ℓ P = E.L.one (𝟙 (Spec (CommRingCat.of k₀))) →
        mapPt f hf P = E.L.one (𝟙 (Spec (CommRingCat.of k₀))) → ∃ i : ZMod ℓ × ZMod ℓ, W i = P) :
    ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P : SchemeHomOver t E.f),
      FactorsThrough K.levK P ↔ (nsmulPt E.L t ℓ P = E.L.one t ∧ mapPt f hf P = E.L.one t) := by
  intro T t P
  classical
  have hO : IsOrder Λ := hΛ.1
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have hℓu : IsUnit ((ℓ : ℕ) : k₀) := Ne.isUnit hℓk
  have hℓΛ : ((ℓ : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    have : ((ℓ : ℚ) : ℍ[ℚ, a, b]) = (ℓ : ℤ) • (1 : ℍ[ℚ, a, b]) := by rw [zsmul_eq_mul, mul_one]; norm_cast
    rw [this]; exact Λ.smul_mem _ hO.one_mem

  obtain ⟨Es, a, ha, a', ha', ha_hom, ha'_hom, ha_lin, ha'_lin, haa', hker, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isLevelIsogeny_of_isUnit Λ hΛ N ℓ hℓ hℓu ⟨E, K⟩
  dsimp only at a ha a' ha' ha_hom ha'_hom ha_lin ha'_lin haa' hker
  obtain ⟨haa'ℓ, ha'aℓ⟩ := haa' hℓΛ

  have hWsurj : ∀ P₀ : SchemeHomOver (𝟙 (Spec (CommRingCat.of k₀))) E.f, FactorsThrough K.levK P₀ →
      ∃ i : ZMod ℓ × ZMod ℓ, W i = P₀ := by
    intro P₀ hP₀
    obtain ⟨eK, -⟩ := K.levK_fibre k₀ (RingHom.id k₀) hℓk
    have hg : geomPoint k₀ (RingHom.id k₀) = 𝟙 (Spec (CommRingCat.of k₀)) := by
      rw [geomPoint, CommRingCat.ofHom_id, Spec.map_id]

    have memAt : ∀ Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of k₀))) E.f, FactorsThrough K.levK Q →
        FactorsThrough K.levK (FakeEllipticCurve.sectionAt Q k₀ (RingHom.id k₀)) := by
      rintro Q ⟨y, hy⟩
      exact ⟨geomPoint k₀ (RingHom.id k₀) ≫ y, by rw [Category.assoc, hy]; rfl⟩
    have secInj : ∀ Q Q' : SchemeHomOver (𝟙 (Spec (CommRingCat.of k₀))) E.f,
        FakeEllipticCurve.sectionAt Q k₀ (RingHom.id k₀) = FakeEllipticCurve.sectionAt Q' k₀ (RingHom.id k₀) → Q = Q' := by
      intro Q Q' h
      have h1 := congrArg Subtype.val h
      change geomPoint k₀ (RingHom.id k₀) ≫ Q.1 = geomPoint k₀ (RingHom.id k₀) ≫ Q'.1 at h1
      rw [hg, Category.id_comp, Category.id_comp] at h1
      exact Subtype.ext h1
    let Φ : ZMod ℓ × ZMod ℓ → {Q : SchemeHomOver (geomPoint k₀ (RingHom.id k₀)) E.f // FactorsThrough K.levK Q} :=
      fun i => ⟨FakeEllipticCurve.sectionAt (W i) k₀ (RingHom.id k₀), memAt _ (hW_mem i)⟩
    have hΦ : Function.Injective Φ := by
      intro i j h
      exact hW_inj (secInj _ _ (congrArg Subtype.val h))
    have hΦs : Function.Surjective Φ := by
      have hinj : Function.Injective (eK.symm ∘ Φ) := eK.symm.injective.comp hΦ
      have hsurj : Function.Surjective (eK.symm ∘ Φ) := Finite.injective_iff_surjective.1 hinj
      intro y
      obtain ⟨i, hi⟩ := hsurj (eK.symm y)
      exact ⟨i, eK.symm.injective hi⟩
    obtain ⟨i, hi⟩ := hΦs ⟨FakeEllipticCurve.sectionAt P₀ k₀ (RingHom.id k₀), memAt _ hP₀⟩
    exact ⟨i, secInj _ _ (congrArg Subtype.val hi)⟩
  constructor
  ·
    intro hPK
    refine ⟨K.levK_torsion t P hPK, ?_⟩
    have haP : mapPt a ha P = Es.L.one t := (hker t P).2 hPK
    refine CerednikDrinfeld.QM.FakeEllipticCurve.forall_mapPt_eq_one_of_forall_rationalPoint k₀ E Es E ℓ hℓk a ha ha_hom ha_lin
      a' ha' ?_ ?_ f hf ?_ t P haP
    · intro T' t' Q
      rw [P8XLKC3.mapPt_mapPt, ← CerednikDrinfeld.QM.FakeEllipticCurve.pushPt_act_natCast_eq_nsmulPt E hO.one_mem ℓ hℓΛ t' Q]
