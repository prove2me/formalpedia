    {IN OUTS : Fin HS} (hIO : (IN = W1 ∧ OUTS = J6Seg.KR.W2) ∨ (IN = J6Seg.KR.W2 ∧ OUTS = W1))
    (P : ℕ) (s : IState HS) (F : Fin HS → List ℤ) (t : List GI) (am lin ldt l1 l2 ln ln2 : List ℤ)
