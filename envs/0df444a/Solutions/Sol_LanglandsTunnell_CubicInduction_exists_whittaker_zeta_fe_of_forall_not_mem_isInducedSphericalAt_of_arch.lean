open IsDedekindDomain NumberField

open LanglandsTunnell.CubicInduction.CharacterComponents (eq_one_of_forall_pow_norm_sub_one_lt)

private def adeleArchCoord : AdeleRing (𝓞 ℚ) ℚ →+ InfiniteAdeleRing ℚ :=
  (RingHom.fst (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)).toAddMonoidHom

private def adeleCoord (v : HeightOneSpectrum (𝓞 ℚ)) : AdeleRing (𝓞 ℚ) ℚ →+ v.adicCompletion ℚ :=
  ((RestrictedProduct.evalRingHom (fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ) v).comp
    (RingHom.snd (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ))).toAddMonoidHom

private theorem adeleArchCoord_apply (x : AdeleRing (𝓞 ℚ) ℚ) : adeleArchCoord x = x.1 := rfl

private theorem adeleCoord_apply (v : HeightOneSpectrum (𝓞 ℚ)) (x : AdeleRing (𝓞 ℚ) ℚ) : adeleCoord v x = x.2 v := rfl

private theorem adeleArchCoord_inl (a : InfiniteAdeleRing ℚ) :
    adeleArchCoord (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) a) = a := rfl

private theorem adeleCoord_inl (v : HeightOneSpectrum (𝓞 ℚ)) (a : InfiniteAdeleRing ℚ) :
    adeleCoord v (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) a) = 0 := by
  rw [adeleCoord_apply]
  rfl

private theorem adeleArchCoord_adeleSingleAt (v : HeightOneSpectrum (𝓞 ℚ)) (t : v.adicCompletion ℚ) :
    adeleArchCoord (StandardAddChar.adeleSingleAt ℚ v t) = 0 := rfl

private theorem adeleCoord_adeleSingleAt_self (v : HeightOneSpectrum (𝓞 ℚ)) (t : v.adicCompletion ℚ) :
    adeleCoord v (StandardAddChar.adeleSingleAt ℚ v t) = t := by
  rw [adeleCoord_apply, StandardAddChar.adeleSingleAt_apply]
  exact StandardAddChar.finAdeleSingleAt_apply_self ℚ v t

private theorem adeleCoord_adeleSingleAt_of_ne {v w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ≠ v) (t : v.adicCompletion ℚ) :
    adeleCoord w (StandardAddChar.adeleSingleAt ℚ v t) = 0 := by
  rw [adeleCoord_apply, StandardAddChar.adeleSingleAt_apply]
  exact StandardAddChar.finAdeleSingleAt_apply_of_ne ℚ v t hw

private theorem psiLoc_eq_apply_adeleSingleAt (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (v : HeightOneSpectrum (𝓞 ℚ))
    (t : v.adicCompletion ℚ) :
    psiLoc ψ v t = ψ (StandardAddChar.adeleSingleAt ℚ v t) := rfl

private theorem addChar_map_sum_eq_prod {ι : Type} (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (s : Finset ι)
    (f : ι → AdeleRing (𝓞 ℚ) ℚ) :
    ψ (∑ i ∈ s, f i) = ∏ i ∈ s, ψ (f i) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp
  · intro a s ha ih
    rw [Finset.sum_insert ha, Finset.prod_insert ha, AddChar.map_add_eq_mul, ih]

private theorem addChar_apply_ne_zero (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (x : AdeleRing (𝓞 ℚ) ℚ) : ψ x ≠ 0 := by
  have h : ψ x * ψ (-x) = 1 := by rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  exact left_ne_zero_of_mul_eq_one h

private def integralAdelesTrivialAt (N : Finset (HeightOneSpectrum (𝓞 ℚ))) : AddSubgroup (AdeleRing (𝓞 ℚ) ℚ) where
  carrier := {x | adeleArchCoord x = 0 ∧ (∀ v ∈ N, adeleCoord v x = 0) ∧
    ∀ v, adeleCoord v x ∈ v.adicCompletionIntegers ℚ}
  zero_mem' := by
    refine ⟨map_zero _, fun v _ => map_zero _, fun v => ?_⟩
    rw [map_zero]
    exact zero_mem _
  add_mem' := by
    intro x y hx hy
    refine ⟨?_, fun v hv => ?_, fun v => ?_⟩
    · rw [map_add, hx.1, hy.1, add_zero]
    · rw [map_add, hx.2.1 v hv, hy.2.1 v hv, add_zero]
    · rw [map_add]
      exact add_mem (hx.2.2 v) (hy.2.2 v)
  neg_mem' := by
    intro x hx
    refine ⟨?_, fun v hv => ?_, fun v => ?_⟩
    · rw [map_neg, hx.1, neg_zero]
    · rw [map_neg, hx.2.1 v hv, neg_zero]
    · rw [map_neg]
      exact neg_mem (hx.2.2 v)

private theorem mem_integralAdelesTrivialAt {N : Finset (HeightOneSpectrum (𝓞 ℚ))} {x : AdeleRing (𝓞 ℚ) ℚ} :
    x ∈ integralAdelesTrivialAt N ↔
      adeleArchCoord x = 0 ∧ (∀ v ∈ N, adeleCoord v x = 0) ∧ ∀ v, adeleCoord v x ∈ v.adicCompletionIntegers ℚ :=
  Iff.rfl

private theorem exists_finset_integralAdelesTrivialAt_subset {U : Set (AdeleRing (𝓞 ℚ) ℚ)}
    (hU : U ∈ nhds (0 : AdeleRing (𝓞 ℚ) ℚ)) :
    ∃ N : Finset (HeightOneSpectrum (𝓞 ℚ)), ∀ x ∈ integralAdelesTrivialAt N, x ∈ U := by
  have hU' : U ∈ nhds (((0 : InfiniteAdeleRing ℚ), (0 : FiniteAdeleRing (𝓞 ℚ) ℚ)) :
      InfiniteAdeleRing ℚ × FiniteAdeleRing (𝓞 ℚ) ℚ) := hU
  obtain ⟨Wi, hWi, Wf, hWf, hsub⟩ := mem_nhds_prod_iff.mp hU'

  have hWf' := ((RestrictedProduct.isEmbedding_structureMap
      (R := fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ)
      (A := fun w : HeightOneSpectrum (𝓞 ℚ) => (w.adicCompletionIntegers ℚ : Set (w.adicCompletion ℚ)))
      (𝓕 := Filter.cofinite)).continuous.continuousAt (x := 0)).preimage_mem_nhds hWf
  rw [nhds_pi, Filter.mem_pi] at hWf'
  obtain ⟨I, hI, t, ht, hIt⟩ := hWf'
  refine ⟨hI.toFinset, fun x hx => ?_⟩
  obtain ⟨hxi, hxN, hxint⟩ := mem_integralAdelesTrivialAt.mp hx
  obtain ⟨z, hz⟩ := RestrictedProduct.exists_structureMap_eq_of_forall
    (fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ)
    (fun w : HeightOneSpectrum (𝓞 ℚ) => (w.adicCompletionIntegers ℚ : Set (w.adicCompletion ℚ))) (x := x.2)
    (fun w => hxint w)
  refine hsub ⟨?_, ?_⟩
  · rw [adeleArchCoord_apply] at hxi
    rw [hxi]
    exact mem_of_mem_nhds hWi
  · rw [← hz]
    refine hIt (Set.mem_pi.mpr fun w hw => ?_)
    have hw' : adeleCoord w x = 0 := hxN w (hI.mem_toFinset.mpr hw)
    have hzw : z w = 0 := by
      have h2 : (z w).1 = x.2 w := by
        rw [← hz]
        rfl
      have h3 : (z w).1 = 0 := by
        rw [h2, ← adeleCoord_apply, hw']
      exact Subtype.ext h3
    rw [hzw]
    exact mem_of_mem_nhds (ht w)

private theorem exists_finset_forall_apply_eq_one (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (hψ : Continuous ψ) :
    ∃ N : Finset (HeightOneSpectrum (𝓞 ℚ)), ∀ x ∈ integralAdelesTrivialAt N, ψ x = 1 := by
  have hV : (fun x => ψ x) ⁻¹' Metric.ball (1 : ℂ) 1 ∈ nhds (0 : AdeleRing (𝓞 ℚ) ℚ) :=
    hψ.continuousAt.preimage_mem_nhds (by
      rw [AddChar.map_zero_eq_one]
      exact Metric.ball_mem_nhds (1 : ℂ) one_pos)
  obtain ⟨N, hN⟩ := exists_finset_integralAdelesTrivialAt_subset hV
  have hsmall : ∀ y ∈ integralAdelesTrivialAt N, ‖ψ y - 1‖ < 1 := fun y hy => by
    have := hN y hy
    simpa [Metric.mem_ball, dist_eq_norm] using this
  refine ⟨N, fun x hx => ?_⟩
  have hu : Units.mk0 (ψ x) (addChar_apply_ne_zero ψ x) = 1 := by
    refine eq_one_of_forall_pow_norm_sub_one_lt _ (fun n => ?_) (fun n => ?_)
    · rw [Units.val_pow_eq_pow_val, Units.val_mk0, ← AddChar.map_nsmul_eq_pow]
      exact hsmall _ (nsmul_mem hx n)
    · rw [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, Units.val_mk0, ← AddChar.map_neg_eq_inv,
        ← AddChar.map_nsmul_eq_pow]
      exact hsmall _ (nsmul_mem (neg_mem hx) n)
  have := congrArg Units.val hu
  rwa [Units.val_mk0, Units.val_one] at this

private def strippedAdd (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (x : AdeleRing (𝓞 ℚ) ℚ) : AdeleRing (𝓞 ℚ) ℚ :=
  x - ∑ v ∈ M, StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x)

private theorem apply_eq_prod_psiLoc_mul_apply_strippedAdd (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ)
    (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (x : AdeleRing (𝓞 ℚ) ℚ) :
    ψ x = (∏ v ∈ M, psiLoc ψ v (adeleCoord v x)) * ψ (strippedAdd M x) := by
  have hx : x = (∑ v ∈ M, StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x)) + strippedAdd M x := by
    unfold strippedAdd
    abel
  have hprod : (∏ v ∈ M, psiLoc ψ v (adeleCoord v x)) =
      ∏ v ∈ M, ψ (StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x)) :=
    Finset.prod_congr rfl fun v _ => psiLoc_eq_apply_adeleSingleAt ψ v _
  calc ψ x = ψ ((∑ v ∈ M, StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x)) + strippedAdd M x) := by rw [← hx]
    _ = ψ (∑ v ∈ M, StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x)) * ψ (strippedAdd M x) :=
        AddChar.map_add_eq_mul ψ _ _
    _ = (∏ v ∈ M, psiLoc ψ v (adeleCoord v x)) * ψ (strippedAdd M x) := by rw [addChar_map_sum_eq_prod, hprod]

private theorem adeleArchCoord_strippedAdd (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (x : AdeleRing (𝓞 ℚ) ℚ) :
    adeleArchCoord (strippedAdd M x) = adeleArchCoord x := by
  unfold strippedAdd
  have h : (∑ v ∈ M, adeleArchCoord (StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x))) = 0 :=
    Finset.sum_eq_zero fun v _ => adeleArchCoord_adeleSingleAt v _
  rw [map_sub, map_sum, h, sub_zero]

open scoped Classical in
private theorem adeleCoord_strippedAdd (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (x : AdeleRing (𝓞 ℚ) ℚ)
    (w : HeightOneSpectrum (𝓞 ℚ)) : adeleCoord w (strippedAdd M x) = if w ∈ M then 0 else adeleCoord w x := by
  unfold strippedAdd
  rw [map_sub, map_sum]
  have h : (∑ v ∈ M, adeleCoord w (StandardAddChar.adeleSingleAt ℚ v (adeleCoord v x))) =
      ∑ v ∈ M, (if w = v then adeleCoord w x else 0) := by
    refine Finset.sum_congr rfl fun v _ => ?_
    by_cases hwv : w = v
    · subst hwv
      rw [adeleCoord_adeleSingleAt_self, if_pos rfl]
    · rw [adeleCoord_adeleSingleAt_of_ne hwv, if_neg hwv]
  rw [h, Finset.sum_ite_eq]
  by_cases hw : w ∈ M <;> simp [hw]

private abbrev ofArchPart (y : InfiniteAdeleRing ℚ) : AdeleRing (𝓞 ℚ) ℚ :=
  AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) y

private theorem exists_finset_apply_eq_mul_prod_psiLoc (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ)
    (hψ : Continuous ψ) :
    ∃ T₀ : Finset (HeightOneSpectrum (𝓞 ℚ)), ∀ T : Finset (HeightOneSpectrum (𝓞 ℚ)), T₀ ⊆ T →
      ∀ x : AdeleRing (𝓞 ℚ) ℚ, (∀ v, v ∉ T → adeleCoord v x ∈ v.adicCompletionIntegers ℚ) →
        ψ x = ψ (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) (adeleArchCoord x)) *
          ∏ v ∈ T, psiLoc ψ v (adeleCoord v x) := by
  obtain ⟨N, hN⟩ := exists_finset_forall_apply_eq_one ψ hψ
  refine ⟨N, fun T hNT x hx => ?_⟩
  set x₁ : AdeleRing (𝓞 ℚ) ℚ := x - ofArchPart (adeleArchCoord x) with hx₁
  have hsplit : x = ofArchPart (adeleArchCoord x) + x₁ := by
    rw [hx₁]
    abel
  have hx₁i : adeleArchCoord x₁ = 0 := by rw [hx₁, map_sub, adeleArchCoord_inl, sub_self]
  have hx₁f : ∀ v, adeleCoord v x₁ = adeleCoord v x := fun v => by rw [hx₁, map_sub, adeleCoord_inl, sub_zero]
  have hpeel := apply_eq_prod_psiLoc_mul_apply_strippedAdd ψ T x₁
  have hprod : (∏ v ∈ T, psiLoc ψ v (adeleCoord v x₁)) = ∏ v ∈ T, psiLoc ψ v (adeleCoord v x) :=
    Finset.prod_congr rfl fun v _ => by rw [hx₁f]
  have hone : ψ (strippedAdd T x₁) = 1 := by
    refine hN _ (mem_integralAdelesTrivialAt.mpr ⟨?_, fun v hv => ?_, fun v => ?_⟩)
    · rw [adeleArchCoord_strippedAdd, hx₁i]
    · rw [adeleCoord_strippedAdd, if_pos (hNT hv)]
    · rw [adeleCoord_strippedAdd]
      by_cases hvT : v ∈ T
      · rw [if_pos hvT]
        exact zero_mem _
      · rw [if_neg hvT, hx₁f]
        exact hx v hvT
  rw [hprod, hone, mul_one] at hpeel
  calc ψ x = ψ (ofArchPart (adeleArchCoord x) + x₁) := by rw [← hsplit]
    _ = ψ (ofArchPart (adeleArchCoord x)) * ψ x₁ := AddChar.map_add_eq_mul ψ _ _
    _ = _ := by rw [hpeel]

end LanglandsTunnell.CubicInduction.AdditiveCharacterComponents

