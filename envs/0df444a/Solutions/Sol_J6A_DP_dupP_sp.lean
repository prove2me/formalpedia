theorem bnd_rev {Bb : ℕ} {G : List ℤ} (h : Bnd Bb G) : Bnd Bb G.reverse :=
  fun x hx => h x (List.mem_reverse.1 hx)

theorem cpBody_sp (s : IState HS) (f : Fin HS → List ℤ) (G : List ℤ) (hT : f T1 = G.reverse)
    (hT2 : f T2 = []) (hC : f CC = []) (h20 : f 20 = [(G.length : ℤ)]) (Bb : ℕ) (hG : Bnd Bb G)
    (hz : zsz (G.length : ℤ) ≤ Bb) :
    Sp cpBody (encK s f) (encK s (Function.update f 0 (G ++ f 0))) (cB G.length Bb) := by
  have h1 := Sp.dupKE (X := T1) (Y := 0) (Z := T2) (C := CC) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s f
    (.reg 20) (clean_reg (by decide)) G.reverse [] (by rw [hT, List.append_nil]) hC Bb
    (bnd_rev hG) (ok_reg h20) trivial (bnd_reg h20 hz) (by rw [eval_reg h20]; simp)
  simp only [List.reverse_reverse, hT2, List.append_nil, List.length_reverse] at h1
  set f1 := Function.update (Function.update (Function.update f T1 []) 0 (G ++ f 0)) T2 G
    with hf1
  have g20 : f1 20 = [(G.length : ℤ)] := by simp [hf1, Function.update_apply, h20]
  have g2 : f1 T2 = G ++ [] := by simp [hf1]
  have gC : f1 CC = [] := by simp [hf1, Function.update_apply, hC]
  have h2 := Sp.mvK (X := T2) (Y := T1) (C := CC) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) s f1 (.reg 20) (clean_reg (by decide)) (ok_reg g20) G []
    g2 (by rw [eval_reg g20]) Bb hG trivial (bnd_reg g20 hz)
  refine (h1.seq h2).congr ?_ |>.mono ?_
  · congr 1
    funext j
    simp only [hf1, Function.update_apply]
    split_ifs <;> simp_all
  · simp only [cB, Ex.size]; omega

theorem rpt_sp (s : IState HS) (f : Fin HS → List ℤ) (G : List ℤ) (hT : f T1 = G.reverse)
    (hT2 : f T2 = []) (hC : f CC = []) (h20 : f 20 = [(G.length : ℤ)]) (Bb : ℕ) (hG : Bnd Bb G)
    (hz : zsz (G.length : ℤ) ≤ Bb) : ∀ k : ℕ,
    Sp (rpt k cpBody) (encK s f) (encK s (Function.update f 0 (J6A.dupL k G ++ f 0)))
      (k * cB G.length Bb + 1)
  | 0 => by
    simp only [rpt, J6A.dupL, List.replicate_zero, List.flatten_nil, List.nil_append,
      Function.update_eq_self]
    exact (Sp.skip _).mono (by omega)
  | k + 1 => by
    have h := rpt_sp s f G hT hT2 hC h20 Bb hG hz k
    set f' := Function.update f 0 (J6A.dupL k G ++ f 0) with hf'
    have hb := cpBody_sp s f' G (by simp [hf', hT, Function.update_apply]) (by simp [hf', hT2, Function.update_apply]) (by simp [hf', hC, Function.update_apply])
      (by simp [hf', h20]) Bb hG hz
    refine (h.seq hb).congr ?_ |>.mono ?_
    · congr 1
      simp only [hf', Function.update_idem, Function.update_self, J6A.dupL, List.replicate_succ,
        List.flatten_cons, List.append_assoc]
    · rw [Nat.succ_mul]; omega

