-- title:
--   Unnumbered explicit multivariate interpolation formula (3.4)
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Fix $J_i\in X_i$ for $1\le i\le n$ with $k[J_1,\ldots,J_n]=X_n$. Define the content scalars by $J_i\epsilon_T=c_T(i)\epsilon_T$ in $A_n$, and put $W_n(i)=\{c_S(i):S\in\operatorname{Tab}(n)\}$ as a set of distinct field elements. For every $T$,
--
--   $$\epsilon_T=\prod_{i=1}^n\prod_{c\in W_n(i),\ c\ne c_T(i)}\frac{J_i-c}{c_T(i)-c}.$$
--
--   Every displayed denominator is nonzero, and the product at $n=0$ is $1$.
--
--   This is the explicit multivariate interpolation formula, rather than an existential polynomial representation.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 13, Unnumbered explicit multivariate interpolation formula (3.4)

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Explicit interpolation (3.4), source PDF pp. 12–13. Weights are a SET over
paths at the final level n. All excluded denominators are nonzero. -/
theorem explicit_multivariate_interpolation (D : Tower k AA) (n : ℕ)
    (J : (i : Fin n) → AA (i.val + 1)) (hJ : ∀ i, J i ∈ towerGTAlgebra D (i.val + 1))
    (hsep : Algebra.adjoin k (Set.range (embeddedSequence D n J)) = towerGTAlgebra D n)
    (t : TowerPath D n) :
    (∀ i c, c ∈ (contentWeights D J i).erase (contentVector D J t i) →
      contentVector D J t i - c ≠ 0) ∧
    pathIdempotent D t = multivariateInterpolant D J t := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
