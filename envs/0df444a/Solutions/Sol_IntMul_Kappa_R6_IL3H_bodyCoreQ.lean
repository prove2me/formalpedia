-- Source module: Solutions.KFWC10
/-!
# KFW C-layer 10: the layer body `S_D ; C ; S_D ; b^D ; Q_p`

With the core registers and the total scale `E = q₀ + lowF ES k D' + ⌊D/2⌋ + D mod 2` on
register `24`, the fixed code `bodyC jT jW` runs the uniform `S_D` (`sdC`), the `C`-layer
(`clC`), `S_D`, the scalar `b^D` (`mdC`), and the truncation `truncU 17 18` (frame
`17 = 2^E`, `18 = 2 N`).

**`bodyQ`**: the output is `prop14Proc … (tens Cm)` (as in `KFM.p14Ph_iruns`), with `GB (p+1)`,
the `√2 · 2^{-p}` error against `layerH`, and cost `cBody`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul RS AModel KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-- `eL` evaluates to `2 n r`. -/
theorem eL_exv {σ : Fin HS → Option ℤ} {K S r H P D ρ k q0 Bp Z : ℕ}
    (hC : CoreR σ K S r H P D ρ k q0 Bp) (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r) (hD : 1 ≤ D)
    (hK : 1 ≤ K) (hZ16 : zsz ((16 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z) :
    ExV σ eL ((2 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) Z := by
  obtain ⟨b1, b2, b3, b4, b5⟩ := layer_bounds (K := K) (D := D) hS hP hr
  set N := P * 2 ^ (K * D) * S * r with hN
  have zb : ∀ x : ℕ, x ≤ 16 * N → zsz (x : ℤ) ≤ Z := fun x hx => le_trans (zsz_natCast_le hx) hZ16
  have hKZ : K * D + 1 ≤ Z := by
    have h1 : 2 ^ (K * D) ≤ 16 * N := by omega
    have h2 := NLogN.lt_two_pow_zsz (16 * N)
    have h3 : 2 ^ (K * D) < 2 ^ Z :=
      lt_of_lt_of_le (lt_of_le_of_lt h1 h2) (Nat.pow_le_pow_right (by norm_num) hZ16)
    have := (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3
    omega
  have hKN : K ≤ N := by have : K ≤ K * D := Nat.le_mul_of_pos_right _ hD; omega
  have hDN : D ≤ N := by have : D ≤ K * D := Nat.le_mul_of_pos_left _ (by omega); omega
  have rK := ExV.reg (B := Z) hC.hK (zb K (by omega))
  have rS := ExV.reg (B := Z) hC.hS (zb S (by have : S ≤ S * r := Nat.le_mul_of_pos_right _ hr; omega))
  have rr := ExV.reg (B := Z) hC.hr (zb r (by have : r ≤ S * r := Nat.le_mul_of_pos_left _ hS; omega))
  have rP := ExV.reg (B := Z) hC.hP (zb P (by omega))
  have rD := ExV.reg (B := Z) hC.hD (zb D (by omega))
  have eKD : ExV σ (.mul (.reg 1) (.reg 22)) ((K * D : ℕ) : ℤ) Z :=
    (ExV.mul rK rD (zszN (n := K * D) (by push_cast; ring) (by omega) hZ16)).congr (by push_cast; ring)
  have ep : ExV σ (.pow2 (.mul (.reg 1) (.reg 22))) ((2 ^ (K * D) : ℕ) : ℤ) Z := by
    have := ExV.pow2 eKD (by positivity) (by rw [Int.toNat_natCast]; exact hKZ)
    rw [Int.toNat_natCast] at this
    exact this.congr (by push_cast; ring)
  have hPt : P * 2 ^ (K * D) ≤ N := by
    rw [hN]; have := Nat.mul_le_mul_left (P * 2 ^ (K * D)) (Nat.mul_le_mul hS hr); nlinarith
  have ePt := (ExV.mul rP ep (zszN (n := P * 2 ^ (K * D)) (by push_cast; ring) (by omega) hZ16)).congr
    (show (P : ℤ) * ((2 ^ (K * D) : ℕ) : ℤ) = ((P * 2 ^ (K * D) : ℕ) : ℤ) by push_cast; ring)
  have eSr := (ExV.mul rS rr (zszN (n := S * r) (by push_cast; ring) (by omega) hZ16)).congr
    (show (S : ℤ) * (r : ℤ) = ((S * r : ℕ) : ℤ) by push_cast; ring)
  have m1 := ExV.mul ePt eSr (zszN (n := N) (by rw [hN]; push_cast; ring) (by omega) hZ16)
  have m2 := ExV.mul (ExV.lit (σ := σ) (c := 2) (zszN (n := 2) (by norm_num) (by omega) hZ16)) m1
    (zszN (n := 2 * N) (by rw [hN]; push_cast; ring) (by omega) hZ16)
  exact m2.congr (by rw [hN]; push_cast; ring)

end NLogN.KFW

end

