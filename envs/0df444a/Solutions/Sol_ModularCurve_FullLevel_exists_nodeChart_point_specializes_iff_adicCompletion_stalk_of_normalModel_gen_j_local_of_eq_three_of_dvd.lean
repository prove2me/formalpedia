  have hforeignSS : ∃ T : Finset ↥F₀, (∀ t ∈ T, t ∈ OA) ∧
      ∀ s' : ↥W, s' ≠ s → ¬ (∀ t ∈ T, ((t : ↥F₀) : ↥(fieldBar q M')) ∈ OSS s') := by
    exact ModularCurve.FullLevel.NodeChart.foreignSS q hq3 M' hqM' A hA W hW hle R₀ hR₀ OSS hSS_over k₀ hκ s F₀' O instLoc hN1const Wx hN3law
  obtain ⟨Tss, hTssO, hTsspole⟩ := hforeignSS

  have hden : ∃ h₁ : ↥F₀, h₁ ∈ BxA ∧ (∀ hh : h₁ ∈ OA, IsUnit (⟨h₁, hh⟩ : ↥OA)) ∧
      (⟨_, hjF₀⟩ : ↥F₀) * h₁ ∈ BxA ∧ ∀ t ∈ Tss, t * h₁ ∈ BxA := by
    obtain ⟨d, hdC, hdu, hd⟩ := NodeSkelG.Subalgebra.common_denominator BxA OA hBxO
      (fun f hf => (hOloc f).mp hf) (insert (⟨_, hjF₀⟩ : ↥F₀) Tss)
      (fun f hf => by rcases Finset.mem_insert.mp hf with rfl | hf; exacts [hĵO, hTssO f hf])
    exact ⟨d, hdC, hdu, hd _ (Finset.mem_insert_self _ _), fun t ht => hd t (Finset.mem_insert_of_mem ht)⟩
  obtain ⟨h₁, hh₁Bx, hh₁unit, hjh₁, hTh₁⟩ := hden
  have hh₁O : h₁ ∈ OA := hBxO hh₁Bx
  have hh₁0 : h₁ ≠ 0 := by
    intro h0; apply (hh₁unit hh₁O).ne_zero; exact Subtype.ext h0
  have hh₁inv : h₁⁻¹ ∈ OA := NodeSkelG.Subalgebra.inv_mem_of_isUnit' OA h₁ hh₁O (hh₁unit hh₁O)
  let B₁ : Subalgebra A₀ ↥F₀ := Algebra.adjoin A₀ ((BxA : Set ↥F₀) ∪ {h₁⁻¹})
  have hBxB₁ : BxA ≤ B₁ := fun x hx => Algebra.subset_adjoin (Set.mem_union_left _ hx)
  have hB₁O : B₁ ≤ OA := Algebra.adjoin_le (Set.union_subset hBxO (Set.singleton_subset_iff.mpr hh₁inv))
  have hh₁invB₁ : h₁⁻¹ ∈ B₁ := Algebra.subset_adjoin (Set.mem_union_right _ rfl)
  have hĵB₁ : (⟨_, hjF₀⟩ : ↥F₀) ∈ B₁ := by
    have : (⟨_, hjF₀⟩ : ↥F₀) = (⟨_, hjF₀⟩ : ↥F₀) * h₁ * h₁⁻¹ := by rw [mul_inv_cancel_right₀ hh₁0]
    rw [this]; exact B₁.mul_mem (hBxB₁ hjh₁) hh₁invB₁
  have hTssB₁ : ∀ t ∈ Tss, t ∈ B₁ := by
    intro t ht
    have : t = t * h₁ * h₁⁻¹ := by rw [mul_inv_cancel_right₀ hh₁0]
    rw [this]; exact B₁.mul_mem (hBxB₁ (hTh₁ t ht)) hh₁invB₁
  have hB₁fg : B₁.FG := NodeSkelG.Subalgebra.fg_adjoin_inv BxA hBxA_fg h₁
  let 𝔪₁ : Ideal ↥B₁ := (maximalIdeal ↥OA).comap (Subalgebra.inclusion hB₁O).toRingHom
  haveI h𝔪₁prime : 𝔪₁.IsPrime := Ideal.comap_isPrime _ _

  have hϖ₀O : ∀ hm : algebraMap A₀ ↥F₀ ϖ₀ ∈ OA, (⟨_, hm⟩ : ↥OA) ∈ maximalIdeal ↥OA := by
    intro hm
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨hπW, hW₀max⟩ := hK2unif
    have hπmax : (⟨_, hπW⟩ : ↥W₀) ∈ maximalIdeal ↥W₀ := by rw [hW₀max]; exact Ideal.subset_span rfl
    apply (IsLocalRing.mem_maximalIdeal _).mp hπmax
    have hincl : OA.toSubring ≤ W₀.toSubring := fun f hf => hN1W f hf
    have hu' := hu.map (Subring.inclusion hincl)
    have he : Subring.inclusion hincl ⟨_, hm⟩ = ⟨_, hπW⟩ := Subtype.ext hϖ₀F
    rw [he] at hu'
    exact hu'
  have hϖ𝔪₁ : Ideal.map (algebraMap A₀ ↥B₁) (maximalIdeal A₀) ≤ 𝔪₁ := by
    rw [hϖ₀, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
    exact hϖ₀O (hO_const ϖ₀)
  obtain ⟨h, hhB₁, hh𝔪₁, hshrink⟩ :=
    Subalgebra.exists_notMem_forall_minimalPrimes_map_le_of_fg B₁ hB₁fg (maximalIdeal A₀) 𝔪₁ hϖ𝔪₁
  have hhO : h ∈ OA := hB₁O hhB₁
  have hhunit : IsUnit (⟨h, hhO⟩ : ↥OA) := by
    by_contra hnu; exact hh𝔪₁ ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
  have hh0 : h ≠ 0 := by
    intro h0; apply hhunit.ne_zero; exact Subtype.ext h0
  have hhinv : h⁻¹ ∈ OA := NodeSkelG.Subalgebra.inv_mem_of_isUnit' OA h hhO hhunit

  let B : Subalgebra A₀ ↥F₀ := Algebra.adjoin A₀ ((B₁ : Set ↥F₀) ∪ {h⁻¹})
  have hB₁B : B₁ ≤ B := fun x hx => Algebra.subset_adjoin (Set.mem_union_left _ hx)
  have hBO : B ≤ OA := Algebra.adjoin_le (Set.union_subset hB₁O (Set.singleton_subset_iff.mpr hhinv))
  let 𝔪 : Ideal ↥B := (maximalIdeal ↥OA).comap (Subalgebra.inclusion hBO).toRingHom

  have hB₁form : ∀ f : ↥F₀, f ∈ B₁ ↔ ∃ b : ↥F₀, b ∈ BxA ∧ ∃ n : ℕ, f * h₁ ^ n = b :=
    NodeSkelG.Subalgebra.mem_adjoin_inv_iff BxA h₁ hh₁Bx hh₁0
  have hBform : ∀ f : ↥F₀, f ∈ B ↔ ∃ b : ↥F₀, b ∈ B₁ ∧ ∃ n : ℕ, f * h ^ n = b :=
    NodeSkelG.Subalgebra.mem_adjoin_inv_iff B₁ h hhB₁ hh0
  have h𝔪unit : ∀ c : ↥B, c ∉ 𝔪 ↔ IsUnit (⟨(c : ↥F₀), hBO c.2⟩ : ↥OA) := by
    intro c
    show ¬ (Subalgebra.inclusion hBO c ∈ maximalIdeal ↥OA) ↔ _
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    rfl
  have hBloc : ∀ f : ↥F₀, f ∈ OA ↔ ∃ b c : ↥B, c ∉ 𝔪 ∧ f * (c : ↥F₀) = (b : ↥F₀) := by
    intro f
    constructor
    · intro hf
      obtain ⟨g, c, hg, hc, hcu, e⟩ := (hOloc f).mp hf
      exact ⟨⟨g, hB₁B (hBxB₁ hg)⟩, ⟨c, hB₁B (hBxB₁ hc)⟩, (h𝔪unit _).mpr (hcu (hBxO hc)), e⟩
    · rintro ⟨b, c, hc, e⟩
      have hcu := (h𝔪unit c).mp hc
      have hc0 : (c : ↥F₀) ≠ 0 := fun h0 => hcu.ne_zero (Subtype.ext h0)
      have hcinv : ((c : ↥F₀))⁻¹ ∈ OA := NodeSkelG.Subalgebra.inv_mem_of_isUnit' OA _ (hBO c.2) hcu
      have : f = (b : ↥F₀) * ((c : ↥F₀))⁻¹ := by rw [← e, mul_inv_cancel_right₀ hc0]
      rw [this]; exact OA.mul_mem (hBO b.2) hcinv
  have h𝔪max : 𝔪.IsMaximal := by
    let φ : ↥B →+* IsLocalRing.ResidueField ↥OA := (IsLocalRing.residue ↥OA).comp (Subalgebra.inclusion hBO).toRingHom
    have hφ : Function.Surjective φ := by
      intro z
      obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨r, hr⟩ := hOres' y.1 y.2
      refine ⟨algebraMap A₀ ↥B r, ?_⟩
      show IsLocalRing.residue ↥OA (Subalgebra.inclusion hBO (algebraMap A₀ ↥B r)) = IsLocalRing.residue ↥OA y
      rw [AlgHom.commutes]
      have h1 : y - algebraMap A₀ ↥OA r ∈ maximalIdeal ↥OA := (IsLocalRing.mem_maximalIdeal _).mpr hr
      have h2 : algebraMap A₀ ↥OA r - y ∈ maximalIdeal ↥OA := by
        rw [← neg_sub]; exact (maximalIdeal ↥OA).neg_mem h1
      exact (Ideal.Quotient.eq (I := maximalIdeal ↥OA)).mpr h2
    have hker : RingHom.ker φ = 𝔪 := by
      show RingHom.ker ((IsLocalRing.residue ↥OA).comp (Subalgebra.inclusion hBO).toRingHom) = 𝔪
      rw [← RingHom.comap_ker, IsLocalRing.ker_residue]
    exact hker ▸ RingHom.ker_isMaximal_of_surjective φ hφ

  have h1 : B.FG := NodeSkelG.Subalgebra.fg_adjoin_inv B₁ hB₁fg h
  have hhinvB : h⁻¹ ∈ B := Algebra.subset_adjoin (Set.mem_union_right _ rfl)

  have hBn𝔪 : ∀ x : ↥F₀, _root_.IsIntegral ↥B x → ∃ b c : ↥B, c ∉ 𝔪 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
    intro x hx
    refine (hBloc x).mp (hOn x ?_)
    obtain ⟨p, hp, hpx⟩ := hx
    refine ⟨p.map (Subalgebra.inclusion hBO).toRingHom, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]; exact hpx
  have h3 : ∀ x : ↥F₀, ∃ b c : ↥F₀, b ∈ B ∧ c ∈ B ∧ c ≠ 0 ∧ x * c = b := fun x => by
    obtain ⟨b, c, hb, hc, hc0, e⟩ := hBxfrac x
    exact ⟨b, c, hB₁B (hBxB₁ hb), hB₁B (hBxB₁ hc), hc0, e⟩

  have hALGJ : ∀ x : ↥F₀, IsAlgebraic ↥(Algebra.adjoin A₀ ({(⟨_, hjF₀⟩ : ↥F₀)} : Set ↥F₀)) x := by
    exact ModularCurve.FullLevel.NodeChart.isAlgebraic_adjoin_j q hq3 M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀ hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀
  have h4 : ∀ 𝔮 : Ideal ↥B, 𝔮.IsPrime → Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔮 → ¬ 𝔮.IsMaximal →
        𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes := fun 𝔮 h𝔮 hle hnm =>
    Subalgebra.mem_minimalPrimes_map_maximalIdeal_of_not_isMaximal_of_fg_of_isAlgebraic_adjoin B h1 _ hALGJ 𝔮 h𝔮 hle hnm

  have hBWx : ∀ b : ↥B, ((b : ↥F₀) : ↥F₀') ∈ Wx := fun b => hOWx _ (hBO b.2)
  have hBW₀ : ∀ b : ↥B, ((b : ↥F₀) : ↥F₀') ∈ W₀ := fun b => hN1W _ (hBO b.2)
  let toWx : ↥B →+* ↥Wx :=
    { toFun := fun b => ⟨(b : ↥F₀), hBWx b⟩, map_one' := rfl, map_mul' := fun _ _ => rfl,
      map_zero' := rfl, map_add' := fun _ _ => rfl }
  let toW₀ : ↥B →+* ↥W₀ :=
    { toFun := fun b => ⟨(b : ↥F₀), hBW₀ b⟩, map_one' := rfl, map_mul' := fun _ _ => rfl,
      map_zero' := rfl, map_add' := fun _ _ => rfl }
  let 𝔮U : Ideal ↥B := (maximalIdeal ↥Wx).comap toWx
  let 𝔮V : Ideal ↥B := (maximalIdeal ↥W₀).comap toW₀
  have h𝔮U : ∀ b : ↥B, b ∈ 𝔮U ↔ ((b : ↥F₀) : ↥F₀') ∈ Wx.nonunits := fun b =>
    (ValuationSubring.coe_mem_nonunits_iff (a := (⟨(b : ↥F₀), hBWx b⟩ : ↥Wx))).symm
  have h𝔮V : ∀ b : ↥B, b ∈ 𝔮V ↔ ((b : ↥F₀) : ↥F₀') ∈ W₀.nonunits := fun b =>
    (ValuationSubring.coe_mem_nonunits_iff (a := (⟨(b : ↥F₀), hBW₀ b⟩ : ↥W₀))).symm
  haveI h𝔮Up : 𝔮U.IsPrime := Ideal.comap_isPrime _ _
  haveI h𝔮Vp : 𝔮V.IsPrime := Ideal.comap_isPrime _ _

  have hunitV : ∀ (V : ValuationSubring ↥F₀') (hOV : O ≤ V.toSubring) (f : ↥F₀) (hf : f ∈ OA),
      IsUnit (⟨f, hf⟩ : ↥OA) → (f : ↥F₀') ∉ V.nonunits := by
    intro V hOV f hf hu
    exact (NodeSkelG.vs_not_mem_nonunits_iff_isUnit V _ (hOV hf)).mpr
      (hu.map (Subring.inclusion (show OA.toSubring ≤ V.toSubring from fun g hg => hOV hg)))

  have hcy𝔪 : (cy : ↥O) ∈ maximalIdeal ↥O := (IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
    hunitV W₀ hN1W _ cy.2 hu hcyW₀'
  have hcx𝔪 : (cx : ↥O) ∈ maximalIdeal ↥O := (IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
    hunitV Wx hOWx _ cx.2 hu hcxWx'
  have hcU_ne : ((maximalIdeal ↥Wx).comap (Subring.inclusion hOWx)) ≠ maximalIdeal ↥O := by
    intro heq
    have : (cy : ↥O) ∈ ((maximalIdeal ↥Wx).comap (Subring.inclusion hOWx)) := by rw [heq]; exact hcy𝔪
    rw [IsLocalRing.UVCrossingNode.mem_centre_iff] at this
    exact hcyWx' this
  have hcV_ne : ((maximalIdeal ↥W₀).comap (Subring.inclusion hN1W)) ≠ maximalIdeal ↥O := by
    intro heq
    have : (cx : ↥O) ∈ ((maximalIdeal ↥W₀).comap (Subring.inclusion hN1W)) := by rw [heq]; exact hcx𝔪
    rw [IsLocalRing.UVCrossingNode.mem_centre_iff] at this
    exact hcxW₀' this
  have hcUV_ne : ((maximalIdeal ↥Wx).comap (Subring.inclusion hOWx)) ≠ ((maximalIdeal ↥W₀).comap (Subring.inclusion hN1W)) := by
    intro heq
    have hcx := (IsLocalRing.UVCrossingNode.mem_centre_iff O Wx hOWx cx).mpr hcxWx'
    rw [heq, IsLocalRing.UVCrossingNode.mem_centre_iff] at hcx; exact hcxW₀' hcx
  have htcU : (⟨_, hπO⟩ : ↥O) ∈ ((maximalIdeal ↥Wx).comap (Subring.inclusion hOWx)) := (IsLocalRing.UVCrossingNode.mem_centre_iff O Wx hOWx _).mpr hπWx'
  have htcV : (⟨_, hπO⟩ : ↥O) ∈ ((maximalIdeal ↥W₀).comap (Subring.inclusion hN1W)) := (IsLocalRing.UVCrossingNode.mem_centre_iff O W₀ hN1W _).mpr hπW₀'

  have hlocBr : ∀ (V : ValuationSubring ↥F₀') (hOV : O ≤ V.toSubring)
      (htV : (⟨_, hπO⟩ : ↥O) ∈ ((maximalIdeal ↥V).comap (Subring.inclusion hOV))) (hVm : ((maximalIdeal ↥V).comap (Subring.inclusion hOV)) ≠ maximalIdeal ↥O)
      (hBV : ∀ b : ↥B, ((b : ↥F₀) : ↥F₀') ∈ V)
      (Q : Ideal ↥B), (∀ b : ↥B, b ∈ Q ↔ (⟨(b : ↥F₀), hBV b⟩ : ↥V) ∈ maximalIdeal ↥V) →
      ∀ f : ↥F₀, f ∈ V ↔ ∃ b c : ↥B, c ∉ Q ∧ f * (c : ↥F₀) = (b : ↥F₀) := by
    intro V hOV htV hVm hBV Q hQ f
    have hQu : ∀ c : ↥B, c ∉ Q ↔ IsUnit (⟨(c : ↥F₀), hBV c⟩ : ↥V) := fun c => by
      rw [hQ, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    constructor
    · intro hf
      obtain ⟨a, t, ht, e⟩ := (IsLocalRing.UVCrossingNode.mem_iff_of_centre _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN hfracO V hOV htV hVm f).mp hf
      obtain ⟨b₁, c₁, hc₁, e₁⟩ := (hBloc (a : ↥F₀')).mp a.2
      obtain ⟨b₂, c₂, hc₂, e₂⟩ := (hBloc (t : ↥F₀')).mp t.2
      have htu : IsUnit (⟨(t : ↥F₀'), hOV t.2⟩ : ↥V) := by
        by_contra hnu
        exact ht ((IsLocalRing.UVCrossingNode.mem_centre_iff O V hOV t).mpr
          ((ValuationSubring.coe_mem_nonunits_iff (a := (⟨(t : ↥F₀'), hOV t.2⟩ : ↥V))).mpr
            ((IsLocalRing.mem_maximalIdeal _).mpr hnu)))
      have hc₁u : IsUnit (⟨(c₁ : ↥F₀), hBV c₁⟩ : ↥V) :=
        ((h𝔪unit c₁).mp hc₁).map (Subring.inclusion (show OA.toSubring ≤ V.toSubring from fun g hg => hOV hg))
      have hc₂u : IsUnit (⟨(c₂ : ↥F₀), hBV c₂⟩ : ↥V) :=
        ((h𝔪unit c₂).mp hc₂).map (Subring.inclusion (show OA.toSubring ≤ V.toSubring from fun g hg => hOV hg))
      refine ⟨b₁ * c₂, b₂ * c₁, ?_, ?_⟩
      · rw [hQu]
        have hb₂ : (⟨((b₂ : ↥B) : ↥F₀), hBV b₂⟩ : ↥V) = ⟨(t : ↥F₀'), hOV t.2⟩ * ⟨(c₂ : ↥F₀), hBV c₂⟩ :=
          Subtype.ext (by exact e₂.symm)
        have : (⟨((b₂ * c₁ : ↥B) : ↥F₀), hBV (b₂ * c₁)⟩ : ↥V) =
            (⟨(t : ↥F₀'), hOV t.2⟩ * ⟨(c₂ : ↥F₀), hBV c₂⟩) * ⟨(c₁ : ↥F₀), hBV c₁⟩ := by
          rw [← hb₂]; rfl
        rw [this]; exact (htu.mul hc₂u).mul hc₁u
      ·
        apply Subtype.ext
        have e' : (f : ↥(fieldBar q M')) * ((t : ↥F₀') : ↥(fieldBar q M')) = ((a : ↥F₀') : ↥(fieldBar q M')) :=
          congrArg Subtype.val e
        have e₁' : ((a : ↥F₀') : ↥(fieldBar q M')) * ((c₁ : ↥F₀) : ↥(fieldBar q M')) = ((b₁ : ↥F₀) : ↥(fieldBar q M')) :=
          congrArg Subtype.val e₁
        have e₂' : ((t : ↥F₀') : ↥(fieldBar q M')) * ((c₂ : ↥F₀) : ↥(fieldBar q M')) = ((b₂ : ↥F₀) : ↥(fieldBar q M')) :=
          congrArg Subtype.val e₂
        show (f : ↥(fieldBar q M')) * (((b₂ : ↥F₀) : ↥(fieldBar q M')) * ((c₁ : ↥F₀) : ↥(fieldBar q M'))) =
          ((b₁ : ↥F₀) : ↥(fieldBar q M')) * ((c₂ : ↥F₀) : ↥(fieldBar q M'))
        rw [← e₂', ← e₁', ← e']; ring
    · rintro ⟨b, c, hc, e⟩
      rw [hQu] at hc
      obtain ⟨u, hu⟩ := hc
      let w : ↥V := ((u⁻¹ : (↥V)ˣ) : ↥V) * ⟨(b : ↥F₀), hBV b⟩
      have e' : (f : ↥(fieldBar q M')) * ((c : ↥F₀) : ↥(fieldBar q M')) = ((b : ↥F₀) : ↥(fieldBar q M')) :=
        congrArg Subtype.val e
      have hinv : ((((u⁻¹ : (↥V)ˣ) : ↥V) : ↥F₀') : ↥(fieldBar q M')) * ((c : ↥F₀) : ↥(fieldBar q M')) = 1 := by
        have := congrArg (fun z : ↥V => ((z : ↥F₀') : ↥(fieldBar q M'))) u.inv_mul
        rw [hu] at this
        exact this
      have hw : ((w : ↥F₀') : ↥(fieldBar q M')) = (f : ↥(fieldBar q M')) := by
        show ((((u⁻¹ : (↥V)ˣ) : ↥V) : ↥F₀') : ↥(fieldBar q M')) * ((b : ↥F₀) : ↥(fieldBar q M')) = (f : ↥(fieldBar q M'))
        rw [← e']
        calc ((((u⁻¹ : (↥V)ˣ) : ↥V) : ↥F₀') : ↥(fieldBar q M')) * ((f : ↥(fieldBar q M')) * ((c : ↥F₀) : ↥(fieldBar q M')))
            = (f : ↥(fieldBar q M')) * (((((u⁻¹ : (↥V)ˣ) : ↥V) : ↥F₀') : ↥(fieldBar q M')) * ((c : ↥F₀) : ↥(fieldBar q M'))) := by ring
          _ = (f : ↥(fieldBar q M')) := by rw [hinv, mul_one]
      have hw' : (w : ↥F₀') = f := Subtype.ext hw
      rw [← hw']; exact w.2
  have hlocU := hlocBr Wx hOWx htcU hcU_ne hBWx 𝔮U (fun b => Iff.rfl)
  have hlocV := hlocBr W₀ hN1W htcV hcV_ne hBW₀ 𝔮V (fun b => Iff.rfl)

  have hϖ₀B : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) = Ideal.span {algebraMap A₀ ↥B ϖ₀} := by
    rw [hϖ₀, Ideal.map_span, Set.image_singleton]
  have hπB : ((algebraMap A₀ ↥B ϖ₀ : ↥B) : ↥F₀) = algebraMap ↥k₀ ↥F₀' π₀ := by
    rw [Subalgebra.coe_algebraMap]; exact hϖ₀F
  have hminclass : ∀ 𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes, 𝔮 = 𝔮U ∨ 𝔮 = 𝔮V := by
    intro 𝔮 h𝔮min
    haveI h𝔮p : 𝔮.IsPrime := h𝔮min.1.1
    have hϖ𝔮 : algebraMap A₀ ↥B ϖ₀ ∈ 𝔮 := by
      have := h𝔮min.1.2; rw [hϖ₀B, Ideal.span_singleton_le_iff_mem] at this; exact this

    have h𝔮𝔪 : 𝔮 ≤ 𝔪 := by
      intro f hf
      obtain ⟨b₁, hb₁, n, hn⟩ := (hBform f).mp f.2
      have hb₁𝔮 : (⟨b₁, hB₁B hb₁⟩ : ↥B) ∈ 𝔮 := by
        have : (⟨b₁, hB₁B hb₁⟩ : ↥B) = f * ⟨h, hB₁B hhB₁⟩ ^ n :=
          Subtype.ext (by rw [Subalgebra.coe_mul, Subalgebra.coe_pow]; exact hn.symm)
        rw [this]; exact 𝔮.mul_mem_right _ hf
      have hb₁𝔪₁ : (⟨b₁, hb₁⟩ : ↥B₁) ∈ 𝔪₁ := hshrink 𝔮 h𝔮min b₁ hb₁ hb₁𝔮
      show Subalgebra.inclusion hBO f ∈ maximalIdeal ↥OA
      have hpow : (h ^ n)⁻¹ ∈ OA := by rw [← inv_pow]; exact OA.pow_mem hhinv n
      have : Subalgebra.inclusion hBO f = Subalgebra.inclusion hB₁O ⟨b₁, hb₁⟩ * ⟨(h ^ n)⁻¹, hpow⟩ :=
        Subtype.ext (by
          show (f : ↥F₀) = b₁ * (h ^ n)⁻¹
          rw [← hn, mul_inv_cancel_right₀ (pow_ne_zero n hh0)])
      rw [this]; exact (maximalIdeal ↥OA).mul_mem_right _ hb₁𝔪₁

    have hUle : 𝔮U ≤ 𝔪 := by
      intro b hb
      by_contra hb'
      exact hunitV Wx hOWx _ (hBO b.2) ((h𝔪unit b).mp hb') ((h𝔮U b).mp hb)
    have hUne : 𝔮U ≠ 𝔪 := by
      obtain ⟨b, c, hc, e⟩ := (hBloc ((cy : ↥O) : ↥F₀')).mp cy.2
      intro heq
      have hb𝔪 : b ∈ 𝔪 := by
        show Subalgebra.inclusion hBO b ∈ maximalIdeal ↥OA
        have : Subalgebra.inclusion hBO b = ⟨((cy : ↥O) : ↥F₀'), cy.2⟩ * Subalgebra.inclusion hBO c :=
          Subtype.ext (by exact e.symm)
        rw [this]
        exact (maximalIdeal ↥OA).mul_mem_right _ ((IsLocalRing.mem_maximalIdeal _).mpr fun hu => hunitV W₀ hN1W _ cy.2 hu hcyW₀')
      rw [← heq] at hb𝔪

      have hcyu : IsUnit (⟨((cy : ↥O) : ↥F₀'), hOWx _ cy.2⟩ : ↥Wx) :=
        (NodeSkelG.vs_not_mem_nonunits_iff_isUnit Wx _ _).mp hcyWx'
      have hcu : IsUnit (⟨(c : ↥F₀), hBWx c⟩ : ↥Wx) :=
        ((h𝔪unit c).mp hc).map (Subring.inclusion (show OA.toSubring ≤ Wx.toSubring from fun g hg => hOWx g hg))
      have : (⟨((b : ↥B) : ↥F₀), hBWx b⟩ : ↥Wx) = ⟨((cy : ↥O) : ↥F₀'), hOWx _ cy.2⟩ * ⟨(c : ↥F₀), hBWx c⟩ :=
        Subtype.ext (by exact e.symm)
      exact (IsLocalRing.mem_maximalIdeal _).mp hb𝔪 (show IsUnit (⟨((b : ↥B) : ↥F₀), hBWx b⟩ : ↥Wx) by rw [this]; exact hcyu.mul hcu)
    have hϖU : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔮U := by
      rw [hϖ₀B, Ideal.span_singleton_le_iff_mem]
      show (⟨_, hBWx _⟩ : ↥Wx) ∈ maximalIdeal ↥Wx
      rw [← ValuationSubring.coe_mem_nonunits_iff]
      show (((algebraMap A₀ ↥B ϖ₀ : ↥B) : ↥F₀) : ↥F₀') ∈ Wx.nonunits
      rw [hπB]; exact hπWx'
    have h𝔪notmin : 𝔪 ∉ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes := fun hmin =>
      hUne (le_antisymm hUle (hmin.2 ⟨h𝔮Up, hϖU⟩ hUle))

    obtain ⟨V, hVle, hBV, hVc⟩ := NodeSkelG.Subalgebra.exists_valuationSubring_centre B 𝔮
    have hOV : O ≤ V.toSubring := by
      intro f hf
      obtain ⟨b, c, hc, e⟩ := (hBloc f).mp hf
      have hc𝔮 : c ∉ 𝔮 := fun h => hc (h𝔮𝔪 h)
      exact hVle ((NodeSkelG.Subalgebra.mem_ofPrime_toSubring_iff B 𝔮 f).mpr ⟨b, c, hc𝔮, e⟩)
    have hVc' : ∀ b : ↥B, b ∈ 𝔮 ↔ (⟨_, hBO b.2⟩ : ↥O) ∈ ((maximalIdeal ↥V).comap (Subring.inclusion hOV)) := fun b =>
      (hVc b).trans (IsLocalRing.UVCrossingNode.mem_centre_iff O V hOV ⟨_, hBO b.2⟩).symm
    have htV : (⟨_, hπO⟩ : ↥O) ∈ ((maximalIdeal ↥V).comap (Subring.inclusion hOV)) := by
      have := (hVc' (algebraMap A₀ ↥B ϖ₀)).mp hϖ𝔮
      have heq : (⟨_, hBO (algebraMap A₀ ↥B ϖ₀).2⟩ : ↥O) = ⟨_, hπO⟩ := Subtype.ext hπB
      rw [heq] at this; exact this
    by_cases hVm : ((maximalIdeal ↥V).comap (Subring.inclusion hOV)) = maximalIdeal ↥O
    ·
      exfalso
      have h𝔪𝔮 : 𝔪 ≤ 𝔮 := by
        intro b hb
        rw [hVc', hVm]
        exact hb
      exact h𝔪notmin (le_antisymm h𝔮𝔪 h𝔪𝔮 ▸ h𝔮min)
    · rcases IsLocalRing.UVCrossingNode.prime_eq_or_eq _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN _ _ hcUV_ne
        htcU htcV hcU_ne hcV_ne (((maximalIdeal ↥V).comap (Subring.inclusion hOV))) htV hVm with heq | heq
      · left; apply Ideal.ext; intro b
        rw [hVc', heq]; exact (IsLocalRing.UVCrossingNode.mem_centre_iff O Wx hOWx ⟨_, hBO b.2⟩).trans (h𝔮U b).symm
      · right; apply Ideal.ext; intro b
        rw [hVc', heq]; exact (IsLocalRing.UVCrossingNode.mem_centre_iff O W₀ hN1W ⟨_, hBO b.2⟩).trans (h𝔮V b).symm

  have hπcoe : ((algebraMap ↥k₀ ↥F₀' π₀ : ↥F₀') : ↥(fieldBar q M')) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
    rw [← hϖ₀F, hj₀, hϖ₀π]
  have coe_inv' : ∀ x : ↥F₀', x ≠ 0 → (((x⁻¹ : ↥F₀')) : ↥(fieldBar q M')) = ((x : ↥F₀') : ↥(fieldBar q M'))⁻¹ := by
    intro x hx
    apply eq_inv_of_mul_eq_one_right
    exact congrArg (Subtype.val : ↥F₀' → ↥(fieldBar q M')) (mul_inv_cancel₀ hx)

  have hIgOver : ∀ ℓ' : CuspidalType.ProjLine q, (∀ f : ↥F₀', f ∈ O → (f : ↥(fieldBar q M')) ∈ OIg ℓ') →
      (∀ f : ↥F₀', (f : ↥(fieldBar q M')) ∈ OIg ℓ' ↔ f ∈ Wx) ∨ (∀ f : ↥F₀', (f : ↥(fieldBar q M')) ∈ OIg ℓ' ↔ f ∈ W₀) := by
    intro ℓ' hOT
    let T : ValuationSubring ↥F₀' := (OIg ℓ').comap F₀'.val.toRingHom
    have hT : ∀ f : ↥F₀', f ∈ T ↔ (f : ↥(fieldBar q M')) ∈ OIg ℓ' := fun f => ValuationSubring.mem_comap
    have hOT' : O ≤ T.toSubring := fun f hf => (hT f).mpr (hOT f hf)
    have htT : (⟨_, hπO⟩ : ↥O) ∈ ((maximalIdeal ↥T).comap (Subring.inclusion hOT')) := by
      rw [IsLocalRing.UVCrossingNode.mem_centre_iff, ValuationSubring.mem_nonunits_iff_or]
      right
      intro h
      apply hπIg ℓ'
      rw [← hπcoe, ← coe_inv' _ hπ₀F0]
      exact (hT _).mp h
    by_cases hTm : ((maximalIdeal ↥T).comap (Subring.inclusion hOT')) = maximalIdeal ↥O
    · exfalso

      have hy : ((⟨_, hĵO⟩ : ↥O) - ⟨_, hc₀O⟩) ∈ ((maximalIdeal ↥T).comap (Subring.inclusion hOT')) := by
        rw [hTm]; exact (IsLocalRing.mem_maximalIdeal _).mpr hjc₀O
      rw [IsLocalRing.UVCrossingNode.mem_centre_iff, ValuationSubring.mem_nonunits_iff_or] at hy
      have hyc : ((((⟨_, hĵO⟩ : ↥O) - ⟨_, hc₀O⟩ : ↥O)) : ↥F₀') = (⟨_, hjF₀⟩ : ↥F₀') - algebraMap ↥k₀ ↥F₀' c₀ := rfl
      rw [hyc] at hy
      have hx0 : ((⟨_, hjF₀⟩ : ↥F₀') - algebraMap ↥k₀ ↥F₀' c₀ : ↥F₀') ≠ 0 := fun h0 =>
        hjc₀ne (hjc₀coe.symm.trans (congrArg Subtype.val h0))
      rcases hy with hy | hy
      · exact hx0 hy
      · apply hy
        rw [hT, coe_inv' _ hx0, hjc₀coe]
        exact (hjc₀Ig ℓ').2
    · rcases IsLocalRing.UVCrossingNode.prime_eq_or_eq _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN _ _ hcUV_ne htcU htcV hcU_ne hcV_ne
          (((maximalIdeal ↥T).comap (Subring.inclusion hOT'))) htT hTm with heq | heq
      · left; intro f
        rw [← hT, IsLocalRing.UVCrossingNode.mem_iff_of_centre _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN hfracO T hOT' htT hTm f,
          IsLocalRing.UVCrossingNode.mem_iff_of_centre _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN hfracO Wx hOWx htcU hcU_ne f]
        try simp only [heq]
      · right; intro f
        rw [← hT, IsLocalRing.UVCrossingNode.mem_iff_of_centre _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN hfracO T hOT' htT hTm f,
          IsLocalRing.UVCrossingNode.mem_iff_of_centre _ hpihatIrr E₀ hE₀ O ιN ⟨_, hπO⟩ htN hfracO W₀ hN1W htcV hcV_ne f]
        try simp only [heq]

  have hIgGauss : ∀ ℓ' : CuspidalType.ProjLine q, ∀ p : Polynomial ↥k₀, p.Monic →
      (∀ i : ℕ, ((p.coeff i : ↥k₀) : (AlgebraicClosure ℚ)) ∈ A) →
      ∀ hp : Polynomial.aeval (⟨_, hjF₀⟩ : ↥F₀') (p.map (algebraMap ↥k₀ ↥F₀')) ∈ (OIg ℓ').comap F₀'.val.toRingHom,
        (⟨_, hp⟩ : ↥((OIg ℓ').comap F₀'.val.toRingHom)) ∉ maximalIdeal ↥((OIg ℓ').comap F₀'.val.toRingHom) := by
    intro ℓ' p hpm hpc hp
    exact ModularCurve.FullLevel.NodeChart.igusa_gauss q hq3 M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀ hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀ k₀ hk₀ F₀' (fun _ => Iff.rfl) ℓ' hjF₀ p hpm hpc hp
  have h6 : ∀ η : X₀, toBase₀.base η = closedPoint A₀ → (∃ y : X₀, η ⤳ y ∧ y ≠ η) →
        (B : Set ↥F₀) ⊆ SemistableModel.localRing X₀ φ₀ η →
          ∃ 𝔮 : Ideal ↥B, 𝔮.IsPrime ∧ ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔
            ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
    intro η hη hnc hBη
    obtain ⟨i, rfl⟩ := (hgen η hη).mpr hnc
    rcases i with ℓ' | s'
    ·
      let T : ValuationSubring ↥F₀' := (OIg ℓ').comap F₀'.val.toRingHom
      have hT : ∀ f : ↥F₀', f ∈ T ↔ (f : ↥(fieldBar q M')) ∈ OIg ℓ' := fun f => ValuationSubring.mem_comap
      by_cases hOT : ∀ f : ↥F₀', f ∈ O → (f : ↥(fieldBar q M')) ∈ OIg ℓ'
      · rcases hIgOver ℓ' hOT with hWU | hWV
        · exact ⟨𝔮U, h𝔮Up, fun x => by rw [hgenIg ℓ' x, hWU x]; exact hlocU x⟩
        · exact ⟨𝔮V, h𝔮Vp, fun x => by rw [hgenIg ℓ' x, hWV x]; exact hlocV x⟩
      ·
        exfalso
        push Not at hOT
        obtain ⟨f₀, hf₀O, hf₀⟩ := hOT
        obtain ⟨b, hbBx, hbpole⟩ := hN5
        have hjT : (⟨_, hjF₀⟩ : ↥F₀') ∈ T := (hT _).mpr ((hgenIg ℓ' _).mp (hBη (hB₁B hĵB₁)))
        refine hbpole T (fun x => ?_) (fun hπV => ?_) hjF₀ hjT (hIgGauss ℓ') ⟨f₀, hf₀O, fun h => hf₀ ((hT _).mp h)⟩ ?_
        · rw [hT]; exact (NodeSkel.algebraMap_mem_igusaRing_iff q M' A ζ OIg hIg_inf hIg ℓ' (x : AlgebraicClosure ℚ)).symm
        · rw [← ValuationSubring.coe_mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]
          right
          intro h
          apply hπIg ℓ'
          rw [← hπcoe, ← coe_inv' _ hπ₀F0]
          exact (hT _).mp h
        · rw [hT]; exact (hgenIg ℓ' _).mp (hBη (hB₁B (hBxB₁ ((hBxA b).mpr hbBx))))
    ·
      have hs' : s' = s := by
        by_contra hs'
        exact hTsspole s' hs' fun t ht => (hgenSS s' t).mp (hBη (hB₁B (hTssB₁ t ht)))
      rw [hs']
      exact ⟨𝔮V, h𝔮Vp, fun x => by rw [hgenSS s x, ← hW₀SS x]; exact hlocV x⟩
  have h7 : ∀ 𝔮 : Ideal ↥B, 𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes →
        ∃ η : X₀, toBase₀.base η = closedPoint A₀ ∧ (∃ y : X₀, η ⤳ y ∧ y ≠ η) ∧
          ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔ ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
    intro 𝔮 h𝔮min
    rcases hminclass 𝔮 h𝔮min with rfl | rfl
    · refine ⟨gen (Sum.inl ℓ), hgen₀ _, (hgen _ (hgen₀ _)).mp ⟨_, rfl⟩, fun x => ?_⟩
      rw [hgenIg ℓ x, ← hNODE_IDENT x]; exact hlocU x
    · refine ⟨gen (Sum.inr s), hgen₀ _, (hgen _ (hgen₀ _)).mp ⟨_, rfl⟩, fun x => ?_⟩
      rw [hgenSS s x, ← hW₀SS x]; exact hlocV x
  have hjB : (⟨_, hjF₀⟩ : ↥F₀) ∈ B := hB₁B hĵB₁
  have hϖ𝔪 : algebraMap A₀ ↥B ϖ₀ ∈ 𝔪 := by
    show Subalgebra.inclusion hBO (algebraMap A₀ ↥B ϖ₀) ∈ maximalIdeal ↥OA
    rw [AlgHom.commutes]
    exact hϖ₀O (hO_const ϖ₀)

  have hval : ∀ η : X₀, toBase₀.base η = closedPoint A₀ → (∃ y : X₀, η ⤳ y ∧ y ≠ η) →
      ∃ V : ValuationSubring ↥F₀, V.toSubring = SemistableModel.localRing X₀ φ₀ η := by
    intro η hη hnc
    obtain ⟨i, rfl⟩ := (hgen η hη).mpr hnc
    rcases i with ℓ' | s'
    · refine ⟨(OIg ℓ').comap F₀.subtype, Subring.ext fun f => ?_⟩
      rw [ValuationSubring.mem_toSubring, ValuationSubring.mem_comap]
      exact (hgenIg ℓ' f).symm
    · refine ⟨(OSS s').comap F₀.subtype, Subring.ext fun f => ?_⟩
      rw [ValuationSubring.mem_toSubring, ValuationSubring.mem_comap]
      exact (hgenSS s' f).symm

  haveI h𝔪prime : 𝔪.IsPrime := h𝔪max.isPrime
  have hϖle : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔪 := by
    rw [hϖ₀, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
    exact hϖ𝔪

  have hofPrime : (LocalSubring.ofPrime B.toSubring 𝔪).toSubring = OA.toSubring :=
    Subring.ext fun f => (NodeSkelG.Subalgebra.mem_ofPrime_toSubring_iff B 𝔪 f).trans (hBloc f).symm
  have hBpn : IsIntegrallyClosed ↥(LocalSubring.ofPrime B.toSubring 𝔪).toSubring := by
    rw [hofPrime]; exact hOic
  obtain ⟨x₀, hx₀⟩ :=
    AlgebraicGeometry.exists_localRing_eq_localization_of_affineModel_of_map_maximalIdeal_le_of_isIntegrallyClosed_ofPrime
      A₀ X₀ toBase₀ hn₀ φ₀ hφ₀ hdim hval B h1 h3 h4 h6 h7 𝔪 hϖle hBpn

  have hLR : SemistableModel.localRing X₀ φ₀ x₀ = OA.toSubring :=
    Subring.ext fun f => (hx₀ f).trans (hBloc f).symm
  have h2 : ∀ x : ↥F₀, _root_.IsIntegral ↥(SemistableModel.localRing X₀ φ₀ x₀) x → x ∈ SemistableModel.localRing X₀ φ₀ x₀ := by
    rw [hLR]; exact hOn
  have hSPEC := AlgebraicGeometry.specializes_iff_localRing_le_of_isSeparated A₀ X₀ toBase₀ φ₀
  have hgenx₀ : gen (Sum.inl ℓ) ⤳ x₀ := by
    rw [hSPEC, hLR]; intro f hf; exact (hgenIg ℓ f).mpr ((hNODE_IDENT f).mp (hOWx f hf))
  have hx₀sp : toBase₀.base x₀ = closedPoint A₀ := by
    have h1 : toBase₀.base (gen (Sum.inl ℓ)) ⤳ toBase₀.base x₀ := hgenx₀.map toBase₀.base.hom.continuous
    rw [hgen₀] at h1
    have hcl : IsClosed ({closedPoint A₀} : Set (Spec (CommRingCat.of A₀))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr (IsLocalRing.maximalIdeal.isMaximal A₀)
    exact Set.mem_singleton_iff.mp (h1.mem_closed hcl (Set.mem_singleton _))
  have hx₀cl : ∀ y : X₀, x₀ ⤳ y → y = x₀ := by
    intro y hy
    by_contra hne'
    obtain ⟨i, hi⟩ := (hgen x₀ hx₀sp).mpr ⟨y, hy, hne'⟩
    obtain ⟨V, hV⟩ := hval x₀ hx₀sp ⟨y, hy, hne'⟩

    have hVO : ∀ f : ↥F₀', f ∈ V ↔ f ∈ O := fun f =>
      Iff.of_eq (congrArg (fun S : Subring ↥F₀ => f ∈ S) (hV.trans hLR))
    have hcxV : ((cx : ↥O) : ↥F₀') ∈ V := (hVO _).mpr cx.2
    have hcyV : ((cy : ↥O) : ↥F₀') ∈ V := (hVO _).mpr cy.2
    have vlt : ∀ (Vr : ValuationSubring ↥F₀') (a b : ↥F₀'), a ∈ Vr.nonunits → b ∈ Vr → a * b ∈ Vr.nonunits := by
      intro Vr a b ha hb
      rw [ValuationSubring.mem_nonunits_iff] at ha ⊢
      calc Vr.valuation (a * b) = Vr.valuation a * Vr.valuation b := map_mul _ _ _
        _ ≤ Vr.valuation a * 1 := mul_le_mul_right ((Vr.valuation_le_one_iff b).mpr hb) _
        _ = Vr.valuation a := mul_one _
        _ < 1 := ha
    obtain ⟨c, hc⟩ := ValuationRing.cond (⟨_, hcxV⟩ : ↥V) ⟨_, hcyV⟩
    have hcO : ((c : ↥V) : ↥F₀) ∈ O := (hVO _).mp c.2
    rcases hc with hc | hc
    ·
      have hprod := vlt Wx _ _ hcxWx' (hOWx _ hcO)
      have e' := congrArg (fun z : ↥V => ((z : ↥F₀) : ↥(fieldBar q M'))) hc
      have heq : ((cx : ↥O) : ↥F₀') * (show ↥F₀' from ((c : ↥V) : ↥F₀)) = ((cy : ↥O) : ↥F₀') := Subtype.ext e'
      exact hcyWx' (heq ▸ hprod)
    ·
      have hprod := vlt W₀ _ _ hcyW₀' (hN1W _ hcO)
      have e' := congrArg (fun z : ↥V => ((z : ↥F₀) : ↥(fieldBar q M'))) hc
      have heq : ((cy : ↥O) : ↥F₀') * (show ↥F₀' from ((c : ↥V) : ↥F₀)) = ((cx : ↥O) : ↥F₀') := Subtype.ext e'
      exact hcxW₀' (heq ▸ hprod)
  have hbr : ∀ i, gen i ⤳ x₀ ↔ (i = Sum.inl ℓ ∨ i = Sum.inr s) := by
    intro i
    rw [hSPEC, hLR]
    constructor
    · intro hle'
      rcases i with ℓ' | s'
      · left
        have hOT : ∀ f : ↥F₀', f ∈ O → (f : ↥(fieldBar q M')) ∈ OIg ℓ' := fun f hf => (hgenIg ℓ' f).mp (hle' hf)
        rcases hIgOver ℓ' hOT with hWU | hWV
        ·
          have : ℓ' = ℓ := ModularCurve.FullLevel.NodeChart.igusaTrace_injective q hq3 M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀ hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀ k₀ F₀' (fun _ => Iff.rfl) ℓ' ℓ
            (fun f => (hWU f).trans (hNODE_IDENT f))
          rw [this]
        ·
          exfalso
