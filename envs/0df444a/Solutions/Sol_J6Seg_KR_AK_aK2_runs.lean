lemma AB_rev {A : ℤ} {u : List GI} (h : AB A u) : AB A u.reverse := fun w hw => h w (List.mem_reverse.1 hw)

lemma gb_AB {pk B : ℕ} {u : List GI} (h : AB (2 ^ pk) u) (hB : pk + 1 ≤ B) : GB B u := by
  intro w hw
  have hlt : ∀ a : ℤ, |a| ≤ 2 ^ pk → zsz a ≤ B := fun a ha =>
