-- Source module: Solutions.J6SegAxA1
/-!
# `A`-line axis program (`AxisUA6`), part 1: sequential composition of steps

* `PassOK.seq`: two `PassOK` steps in sequence are a `PassOK` step for the composed map;
* `axisBodyA6_of_pass`: if procedure `eX` is a statement that is, for every axis `k ≤ D`, a
  `PassOK` step for `pipeA6 P n src D k` (precondition true on every admissible input), then
  `AxisBodyA6` holds (cost `+ 2` for the call).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- **`AxisBodyA6` from one step per axis.** -/
theorem axisBodyA6_of_pass {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {st : IStmt HS Pp} {eX : Fin Pp} {dA : Fin HS} {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ}
    {C : ℝ} (hX : tbl eX = st)
    (hst : ∀ k ≤ D, ∃ (Pre : List GI → Prop) (C' : ℝ),
      PassOK Isym tbl st dA (descAx6 P n src D k) Pre (pipeA6 P n src D k) C' ∧ C' ≤ C ∧
      ∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L → Pre L) :
    AxisBodyA6 P n src D Isym tbl eX dA (C + 2) := by
  intro k hk s F L l hF hd h0 hlen hgb
  obtain ⟨Pre, C', H, hC, hP⟩ := hst k hk
  obtain ⟨c, r, kc⟩ := H s F L l hF hd h0 (hP L hlen hgb)
  exact ⟨c + 2, IRuns.call (by rw [hX]; exact r), by push_cast; linarith⟩

end J6Seg.Ax

end

end

