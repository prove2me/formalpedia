section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2000000
open NLogN
open NLogN.KFV
open NLogN.KFV.S18M
open IntMul KIL RS Function Synth
theorem solution : Setup18Need := by
  refine ⟨fun Pp => (NLogN.KFV.S18M.setupRS.code : NLogN.IStmt NLogN.HS Pp), fun Pp => (NLogN.KFV.S18M.tdRS.code : NLogN.IStmt NLogN.HS Pp),
    100000000000, ?_⟩
  intro Pp Isym tbl p ℓ K ts hℓ hK hL hts s f hf hd
  have hX6 : 6 ≤ ts.length + ℓ + K + NLogN.zsz (p : ℤ) + 2 := by omega
  generalize hXd : ts.length + ℓ + K + NLogN.zsz (p : ℤ) + 2 = X at hX6
  have hA : 2 ≤ 2 ^ (X + 4) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (X + 4) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hAB : (2 ^ (X + 4)) ^ 4 < 2 ^ (4 * (X + 4) + 1) := by
    rw [← pow_mul]; exact Nat.pow_lt_pow_right (by norm_num) (by omega)
  have hmono : ∀ a, a ≤ X + 4 → 2 ^ a ≤ 2 ^ (X + 4) :=
    fun a ha => Nat.pow_le_pow_right (by norm_num) ha
  have hpA : p + 2 ≤ 2 ^ (X + 4) := by
    have h1 := NLogN.lt_two_pow_zsz p
    have h2 := hmono (NLogN.zsz (p : ℤ) + 1) (by omega)
    have h3 : 1 ≤ 2 ^ NLogN.zsz (p : ℤ) := Nat.one_le_two_pow
    rw [pow_succ] at h2
    omega
  have hℓA : 2 ^ ℓ ≤ 2 ^ (X + 4) := hmono ℓ (by omega)
  have hKA : K ≤ 2 ^ (X + 4) := le_trans (NLogN.KFV.S18M.lt2 K).le (hmono K (by omega))
  have hDA : 2 ^ ts.length ≤ 2 ^ (X + 4) := hmono _ (by omega)
  have hnA : NLogN.KFV.n18 ℓ K ts + ℓ + 8 ≤ 2 ^ (X + 4) :=
    le_trans (NLogN.KFV.S18M.n18_bound p ℓ K ts hK (by omega)) (hmono _ (by omega))
  have hcost : ∀ c, c ≤ 100 * (ts.length * NLogN.KFV.S18M.U (4 * (X + 4) + 1)) →
      c ≤ 100000000000 * X ^ 4 := by
    intro c hc
    have hLX : ts.length ≤ X := by omega
    have hBX : 4 * (X + 4) + 1 + 2 ≤ 8 * X := by omega
    have h3 : X ^ 3 ≤ X ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    calc c ≤ 100 * (ts.length * NLogN.KFV.S18M.U (4 * (X + 4) + 1)) := hc
      _ ≤ 100 * (X * (10 ^ 7 * (8 * X) ^ 2)) := by unfold NLogN.KFV.S18M.U; gcongr
      _ = 64000000000 * X ^ 3 := by ring
      _ ≤ 100000000000 * X ^ 4 := by omega
  constructor
  · obtain ⟨c, hc, hr⟩ := (NLogN.KFV.S18M.spSetup s hA hAB p ℓ K ts f hf hℓ hK hts hpA hℓA hKA hDA hnA hL
      hd).irun (I := Isym) (iprog := tbl)
    exact ⟨c, by rw [NLogN.KFV.encK_encK]; exact hr, hcost c hc⟩
  · intro v
    obtain ⟨c, hc, hr⟩ := (NLogN.KFV.S18M.spTd s hA hAB p ℓ K ts f hf hℓ hK hts hpA hℓA hKA hDA hnA hL hd
      v).irun (I := Isym) (iprog := tbl)
    exact ⟨c, by rw [NLogN.KFV.encK_encK]; exact hr, hcost c hc⟩
end
