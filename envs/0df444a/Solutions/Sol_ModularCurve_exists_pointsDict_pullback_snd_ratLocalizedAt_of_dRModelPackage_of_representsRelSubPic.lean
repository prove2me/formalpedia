theorem pointsDict_of_iso (p : ℕ) [Fact p.Prime] (ℓ : ℕ) [Fact ℓ.Prime]
    {G : Scheme.{0}} (g : G ⟶ Spec (CommRingCat.of ℤ)) (Lcan : RelativeGroupLaw ℤ g)
    (pts : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap ℤ (AlgebraicClosure ℚ)))) g)
    (L' : RelativeGroupLaw ↥(GaloisRep.ratLocalizedAt ℓ)
      (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (hL' : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)))
      (x y : SchemeHomOver t (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
      (X Y : SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) g),
      X.1 = x.1 ≫ pullback.fst _ _ → Y.1 = y.1 ≫ pullback.fst _ _ →
      (L'.mul t x y).1 ≫ pullback.fst _ _ = (Lcan.mul _ X Y).1)
    (pts' : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom
      (algebraMap ↥(GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ))))
      (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (hpts' : ∀ x : JZero p, (pts' x).1 ≫ pullback.fst _ _ = (pts x).1)

    {J : Scheme.{0}} (fJ : J ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)))
    (LJ : RelativeGroupLaw ↥(GaloisRep.ratLocalizedAt ℓ) fJ)
    (ptsJ : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom
      (algebraMap ↥(GaloisRep.ratLocalizedAt ℓ) (AlgebraicClosure ℚ)))) fJ)
    (dictJ : ∀ (A : ValuationSubring (AlgebraicClosure ℚ)), A.LiesOverPrime ℓ →
      ∃ (σA : Spec (CommRingCat.of ↥A) ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)))
        (ptsA : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom A.subtype) ≫ σA) fJ)
        (ptsSp : JZeroC (ResidueField ↥A) p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom (residue ↥A)) ≫ σA) fJ),
        (∀ x : JZero p, (ptsA x).1 = (ptsJ x).1) ∧
        (∀ u v : JZeroC (ResidueField ↥A) p, ptsSp (u + v) = LJ.mul _ (ptsSp u) (ptsSp v)) ∧
        (ReductionInputsModL A p → ReductionOfPointsAgreesModL p A fJ σA ptsA ptsSp))

    (θ : SchemeHomOver fJ (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
    (θ' : SchemeHomOver (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) fJ)
    (hθθ' : θ.1 ≫ θ'.1 = 𝟙 _) (hθ'θ : θ'.1 ≫ θ.1 = 𝟙 _)
    (HOM : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))) (x y : SchemeHomOver t fJ),
      ((LJ.mul t x y).1 ≫ θ.1) ≫ pullback.fst _ _ =
        (Lcan.mul _
          (⟨(x.1 ≫ θ.1) ≫ pullback.fst _ _, by
              rw [Category.assoc, Category.assoc, pullback.condition, ← Category.assoc θ.1, θ.2, ← Category.assoc, x.2]⟩ :
            SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))) g)
          ⟨(y.1 ≫ θ.1) ≫ pullback.fst _ _, by
              rw [Category.assoc, Category.assoc, pullback.condition, ← Category.assoc θ.1, θ.2, ← Category.assoc, y.2]⟩).1)
    (PTS : ∀ x : JZero p, (ptsJ x).1 ≫ θ.1 ≫ pullback.fst _ _ = (pts x).1) :
    ∀ (A' : ValuationSubring (AlgebraicClosure ℚ)), A'.LiesOverPrime ℓ →
      ∃ (σA : Spec (CommRingCat.of ↥A') ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ)))
        (ptsA : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom A'.subtype) ≫ σA)
          (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
        (ptsSp : JZeroC (ResidueField ↥A') p ≃
          SchemeHomOver (Spec.map (CommRingCat.ofHom (residue ↥A')) ≫ σA)
            (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))),
        (∀ x : JZero p, (ptsA x).1 = (pts' x).1) ∧
        (∀ u v : JZeroC (ResidueField ↥A') p, ptsSp (u + v) = L'.mul _ (ptsSp u) (ptsSp v)) ∧
        (ReductionInputsModL A' p → ReductionOfPointsAgreesModL p A'
          (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) σA ptsA ptsSp) := by
  intro A' hA'
  obtain ⟨σA, ptsA, ptsSp, hptsA, hadd, hrop⟩ := dictJ A' hA'

  let push : ∀ {T : Scheme.{0}} {s : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))},
      SchemeHomOver s fJ → SchemeHomOver s (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) :=
    fun x => NeronModelInfra.schemeHomOverComp x θ
  let pull : ∀ {T : Scheme.{0}} {s : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))},
      SchemeHomOver s (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) → SchemeHomOver s fJ :=
    fun y => NeronModelInfra.schemeHomOverComp y θ'
  have pull_push : ∀ {T : Scheme.{0}} {s : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))} (x : SchemeHomOver s fJ),
      pull (push x) = x := by
    intro T s x; apply Subtype.ext
    change (x.1 ≫ θ.1) ≫ θ'.1 = x.1
    rw [Category.assoc, hθθ', Category.comp_id]
  have push_pull : ∀ {T : Scheme.{0}} {s : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))} (y : SchemeHomOver s _),
      push (pull y) = y := by
    intro T s y; apply Subtype.ext
    change (y.1 ≫ θ'.1) ≫ θ.1 = y.1
    rw [Category.assoc, hθ'θ, Category.comp_id]

  have hom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ↥(GaloisRep.ratLocalizedAt ℓ))) (x y : SchemeHomOver t fJ),
      push (LJ.mul t x y) = L'.mul t (push x) (push y) := by
    intro T t x y
    apply Subtype.ext
    apply pullback.hom_ext
    · change ((LJ.mul t x y).1 ≫ θ.1) ≫ pullback.fst _ _ = (L'.mul t (push x) (push y)).1 ≫ pullback.fst _ _
      rw [HOM, hL' t (push x) (push y)]
      · rfl
      · rfl
    · change (push (LJ.mul t x y)).1 ≫ pullback.snd _ _ = (L'.mul t (push x) (push y)).1 ≫ pullback.snd _ _
      rw [(push (LJ.mul t x y)).2, (L'.mul t (push x) (push y)).2]

  let ptsA' : JZero p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom A'.subtype) ≫ σA)
      (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) :=
    { toFun := fun x => push (ptsA x), invFun := fun y => ptsA.symm (pull y)
      left_inv := fun x => by simp only [pull_push, Equiv.symm_apply_apply]
      right_inv := fun y => by simp only [Equiv.apply_symm_apply, push_pull] }
  let ptsSp' : JZeroC (ResidueField ↥A') p ≃ SchemeHomOver (Spec.map (CommRingCat.ofHom (residue ↥A')) ≫ σA)
      (pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) :=
    { toFun := fun u => push (ptsSp u), invFun := fun y => ptsSp.symm (pull y)
      left_inv := fun u => by simp only [pull_push, Equiv.symm_apply_apply]
      right_inv := fun y => by simp only [Equiv.apply_symm_apply, push_pull] }
  refine ⟨σA, ptsA', ptsSp', ?_, ?_, ?_⟩
  ·
    intro x
    change (ptsA x).1 ≫ θ.1 = (pts' x).1
    apply pullback.hom_ext
    · rw [Category.assoc, hptsA, PTS, hpts']
    · change (ptsA x).1 ≫ θ.1 ≫ pullback.snd _ _ = (pts' x).1 ≫ pullback.snd _ _
      rw [θ.2, (pts' x).2, ← (ptsJ x).2, ← hptsA]
  ·
    intro u v
    change push (ptsSp (u + v)) = L'.mul _ (push (ptsSp u)) (push (ptsSp v))
    rw [hadd, hom]
  ·
    intro hRIM x
    obtain ⟨xA, h1, h2⟩ := hrop hRIM x
    refine ⟨push xA, ?_, ?_⟩
    · apply Subtype.ext
      change Spec.map (CommRingCat.ofHom A'.subtype) ≫ xA.1 ≫ θ.1 = (ptsA x).1 ≫ θ.1
      rw [← Category.assoc, show Spec.map (CommRingCat.ofHom A'.subtype) ≫ xA.1 = (ptsA x).1 from congrArg Subtype.val h1]
    · apply Subtype.ext
      change Spec.map (CommRingCat.ofHom (residue ↥A')) ≫ xA.1 ≫ θ.1 = (ptsSp (reductionModL A' p x)).1 ≫ θ.1
      rw [← Category.assoc, show Spec.map (CommRingCat.ofHom (residue ↥A')) ≫ xA.1 = (ptsSp (reductionModL A' p x)).1 from
        congrArg Subtype.val h2]

end IgusaSide.Transport

