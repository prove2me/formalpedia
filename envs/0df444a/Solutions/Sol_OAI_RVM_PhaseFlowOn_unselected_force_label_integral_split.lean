lemma normalisedSignedForce_eq {r : ℝ} (a u n b : Vec)
    (hr : r≠0) (hd : 1-dot n u≠0) (hD : 1-dot n a≠0) :
    normalisedSignedForce r a u n b=r^2 • signedForceKernel r a u n b := by
