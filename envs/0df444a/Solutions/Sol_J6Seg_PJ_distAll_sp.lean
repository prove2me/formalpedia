-- Source module: Solutions.J6SegILPreJC5
/-!
# B5 set-up, part 5: distributing values onto output stacks (plain `Sp`)

`distP X l`: for each stack `j` of `l` in turn, move the top of `X` onto `j` (`distP_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem putL_update {k : Fin HS} {x : List ℤ} : ∀ (l : List (Fin HS)) (as : List ℤ) (f : Cs),
    k ∉ l → putL l as (update f k x) = update (putL l as f) k x
  | [], _, _, _ => rfl
  | _ :: _, [], _, _ => rfl
  | j :: l, a :: as, f, hk => by
    simp only [List.mem_cons, not_or] at hk
    simp only [putL]
    rw [update_comm hk.1, putL_update l as _ hk.2]

theorem putL_out {k : Fin HS} : ∀ (l : List (Fin HS)) (as : List ℤ) (f : Cs),
    k ∉ l → putL l as f k = f k
  | [], _, _, _ => rfl
  | _ :: _, [], _, _ => rfl
  | j :: l, a :: as, f, hk => by
    simp only [List.mem_cons, not_or] at hk
    simp only [putL]
    rw [putL_out l as _ hk.2, update_of_ne hk.1]

theorem distP_sp (s : IState HS) (X : Fin HS) (hX5 : X.val < 56) (B : ℕ) :
    ∀ (l : List (Fin HS)) (as rest : List ℤ) (f : Cs), l.length = as.length → X ∉ l →
    (∀ j ∈ l, j.val < 56) → l.Nodup → (∀ j ∈ l, f j = []) → f X = as ++ rest →
    (∀ a ∈ as, zsz a ≤ B) →
    Sp (distP X l) (encK s f) (encK s (update (putL l as f) X rest)) (l.length * (cDist B + 1) + 1)
  | [], as, rest, f, hl, _, _, _, _, hf, _ => by
    have : as = [] := List.eq_nil_of_length_eq_zero hl.symm
    subst this
    have e : update f X rest = f := by simp at hf; rw [← hf]; exact update_eq_self X f
    simp only [putL, distP, e]
    exact (Sp.skip _).mono (by simp)
  | j :: l, [], rest, f, hl, _, _, _, _, _, _ => by simp at hl
  | j :: l, a :: as, rest, f, hl, hX, h56, hnd, he, hf, hB => by
    simp only [List.mem_cons, not_or] at hX
    rw [List.nodup_cons] at hnd
    have hfX : f X = a :: (as ++ rest) := by rw [hf]; rfl
    have h1 := Sp.push (i := j) (e := .reg X) (B := B) s f (h56 j (by simp)) (clean_reg hX5)
      (ok_reg hfX) trivial (bnd_reg hfX (hB a (by simp)))
    rw [eval_reg hfX, he j (by simp)] at h1
    have h2 := Sp.pop (i := X) (B := B) s (update f j [a]) hX5 (a := a) (l := as ++ rest)
      (by rw [update_of_ne hX.1]; exact hfX) (hB a (by simp))
    have h3 := distP_sp s X hX5 B l as rest (update (update f j [a]) X (as ++ rest))
      (by simpa using hl) hX.2 (fun i hi => h56 i (by simp [hi])) hnd.2
      (fun i hi => by
        rw [update_of_ne (by rintro rfl; exact hX.2 hi), update_of_ne (by rintro rfl; exact hnd.1 hi)]
        exact he i (by simp [hi]))
      (by simp) (fun x hx => hB x (by simp [hx]))
    rw [putL_update l as _ hX.2, update_idem] at h3
    refine ((h1.seq (h2.seq h3)).mono ?_)
    simp only [List.length_cons, cDist, Ex.size]; ring_nf; omega

end J6Seg.PJ

