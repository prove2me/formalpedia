namespace NLogN.KFM

open Complex KFB

noncomputable section

theorem norm_exp_phase (x : ℝ) (c : ℂ) (hc : c = (x : ℂ) * I) : ‖exp c‖ ≤ 1 := by
  rw [hc, Complex.norm_exp_ofReal_mul_I]

theorem hRoot_err (P s t : ℕ) (hst : s ≤ t) (ht : 0 < t) :
    ‖vP P (hRoot P s t) - exp (-(Real.pi * I * s / t))‖ ≤ (2 : ℝ)⁻¹ ^ P := by
  have h := vP_twiddle P (2 * t) (2 * t - s) (by omega)
  have htC : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  have e : exp (2 * Real.pi * I * ((2 * t - s : ℕ) : ℂ) / ((2 * t : ℕ) : ℂ)) =
      exp (-(Real.pi * I * s / t)) := by
    rw [Nat.cast_sub (by omega)]
    have : 2 * Real.pi * I * (((2 * t : ℕ) : ℂ) - s) / ((2 * t : ℕ) : ℂ) =
        -(Real.pi * I * s / t) + 2 * Real.pi * I := by
      push_cast; field_simp; ring
    rw [this, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]
  rwa [e] at h

theorem cRoot_err (P s t : ℕ) (hst : s ≤ t) (ht : 0 < t) :
    ‖vP P (cRoot P s t) - exp (-(2 * Real.pi * I * s / t))‖ ≤ (2 : ℝ)⁻¹ ^ P := by
  have h := vP_twiddle P t (t - s) ht
  have htC : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  have e : exp (2 * Real.pi * I * ((t - s : ℕ) : ℂ) / (t : ℂ)) =
      exp (-(2 * Real.pi * I * s / t)) := by
    rw [Nat.cast_sub hst]
    have : 2 * Real.pi * I * ((t : ℂ) - s) / (t : ℂ) =
        -(2 * Real.pi * I * s / t) + 2 * Real.pi * I := by
      field_simp; ring
    rw [this, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]
  rwa [e] at h

end

end NLogN.KFM

