/-! # Partial derivatives: locality, genuine-derivative and smoothness lemmas

Reusable facts about `pd`, `christoffel`, `ricci`:
* locality: they only depend on the fields on an open neighbourhood (`*_congr_of_eqOn`);
* no junk values: on an open set where the fields are `C^∞`, every slice used by `pd` is
  differentiable and `pd` is its true derivative (`hasDerivAt_pd`);
* smoothness propagates: `pd` and `christoffel` of `C^∞` fields are `C^∞` (`contDiffOn_*`).
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

theorem pd_eq_of_hasDerivAt {f : Pt n → ℝ} {x : Pt n} {i : Fin n} {d : ℝ}
    (h : HasDerivAt (fun u : ℝ => f (Function.update x i u)) d (x i)) : pd i f x = d :=
  h.deriv

theorem hasDerivAt_slice {f : Pt n → ℝ} {x : Pt n} (i : Fin n) (hf : DifferentiableAt ℝ f x) :
    HasDerivAt (fun u : ℝ => f (Function.update x i u)) (fderiv ℝ f x (Pi.single i 1)) (x i) := by
  have h1 : HasDerivAt (Function.update x i) (Pi.single i 1) (x i) := hasDerivAt_update x i (x i)
  have h2 : HasFDerivAt f (fderiv ℝ f x) (Function.update x i (x i)) := by
    rw [Function.update_eq_self]; exact hf.hasFDerivAt
  exact HasFDerivAt.comp_hasDerivAt (hl := h2) (hf := h1)

theorem differentiableAt_of_contDiffOn {f : Pt n → ℝ} {U : Set (Pt n)} (hU : IsOpen U)
    (hf : ContDiffOn ℝ ∞ f U) {x : Pt n} (hx : x ∈ U) : DifferentiableAt ℝ f x :=
  (hf.contDiffAt (hU.mem_nhds hx)).differentiableAt (by simp)

/-- No junk value: for `C^∞` fields on an open set, `pd` is the genuine slice derivative. -/
theorem hasDerivAt_pd {f : Pt n → ℝ} {U : Set (Pt n)} (hU : IsOpen U) (hf : ContDiffOn ℝ ∞ f U)
    {x : Pt n} (hx : x ∈ U) (i : Fin n) :
    HasDerivAt (fun u : ℝ => f (Function.update x i u)) (pd i f x) (x i) := by
  have h := hasDerivAt_slice i (differentiableAt_of_contDiffOn hU hf hx)
  rwa [pd_eq_of_hasDerivAt h]

end ExactVacuumAtlas

