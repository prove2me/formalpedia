  simp only [encode, List.headD_cons, List.tail_cons]
  rw [encode_append_len _ _ (AModel.length_decode _ _), encode_decode hm]
  simp only [encode, List.headD_cons, List.tail_cons, encode_decode hc, vol_cons, vol_append, vol_nil]
