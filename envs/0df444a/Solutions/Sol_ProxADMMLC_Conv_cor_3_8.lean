theorem deriv_nonneg_of_min {F : ℝ → ℝ} {D t0 : ℝ} (ht0 : 0 < t0) (hF : HasDerivAt F D 0)
    (hmin : ∀ t ∈ Set.Icc (0:ℝ) t0, F 0 ≤ F t) : 0 ≤ D := by
  have h1 : IsLocalMinOn F (Set.Icc 0 t0) 0 := IsMinOn.localize (isMinOn_iff.mpr hmin)
  have hy : t0 ∈ posTangentConeAt (Set.Icc (0:ℝ) t0) 0 := by
    apply mem_posTangentConeAt_of_segment_subset
    rw [zero_add, segment_eq_Icc ht0.le]
  have h2 := h1.hasFDerivWithinAt_nonneg hF.hasFDerivAt.hasFDerivWithinAt hy
  have h3 : 0 ≤ t0 * D := h2
  by_contra h
  push Not at h
  linarith [mul_neg_of_pos_of_neg ht0 h]

/-- Conic Carathéodory: a nonnegative combination can be rewritten with a linearly
independent support. -/
theorem conic_cara {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (v : ι → V) : ∀ (k : ℕ) (lam : ι → ℝ),
    (Finset.univ.filter (fun i => lam i ≠ 0)).card ≤ k → (∀ i, 0 ≤ lam i) →
    ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ ∑ i, μ i • v i = ∑ i, lam i • v i ∧
      LinearIndepOn ℝ v (↑(Finset.univ.filter (fun i => μ i ≠ 0)) : Set ι) := by
  intro k
  induction k with
  | zero =>
    intro lam hk hlam
    refine ⟨lam, hlam, rfl, ?_⟩
    have : Finset.univ.filter (fun i => lam i ≠ 0) = ∅ := Finset.card_eq_zero.mp (by omega)
    rw [this, Finset.coe_empty]
    exact linearIndepOn_empty ℝ v
  | succ k ih =>
    intro lam hk hlam
    set s := Finset.univ.filter (fun i => lam i ≠ 0) with hs
    by_cases hli : LinearIndepOn ℝ v (↑s : Set ι)
    · exact ⟨lam, hlam, rfl, hli⟩
    obtain ⟨g, hg0, j0, hj0s, hj0⟩ := not_linearIndepOn_finset_iff.mp hli
    -- a dependence supported on `s` with a positive entry
    obtain ⟨c, hcsum, hcsupp, j1, hj1⟩ : ∃ c : ι → ℝ, ∑ i, c i • v i = 0 ∧
        (∀ i, lam i = 0 → c i = 0) ∧ ∃ j, 0 < c j := by
      let c0 : ι → ℝ := fun i => if lam i ≠ 0 then g i else 0
      have hc0 : ∑ i, c0 i • v i = 0 := by
        rw [← hg0, hs, Finset.sum_filter]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [c0]
        split_ifs <;> simp
      have hc0s : ∀ i, lam i = 0 → c0 i = 0 := fun i hi => by simp [c0, hi]
      have hj0' : c0 j0 ≠ 0 := by
        have : lam j0 ≠ 0 := (Finset.mem_filter.mp hj0s).2
        simp [c0, this, hj0]
      rcases lt_or_gt_of_ne hj0' with hneg | hpos
      · refine ⟨fun i => - c0 i, ?_, fun i hi => by simp [hc0s i hi], j0, by linarith⟩
        simp only [neg_smul, Finset.sum_neg_distrib, hc0, neg_zero]
      · exact ⟨c0, hc0, hc0s, j0, hpos⟩
    set S := Finset.univ.filter (fun i => 0 < c i) with hS
    have hSne : S.Nonempty := ⟨j1, by simp [S, hj1]⟩
    obtain ⟨j, hjS, hjmin⟩ := S.exists_min_image (fun i => lam i / c i) hSne
    have hcj : 0 < c j := (Finset.mem_filter.mp hjS).2
    set τ := lam j / c j with hτ
    have hτ0 : 0 ≤ τ := div_nonneg (hlam j) hcj.le
    set lam' : ι → ℝ := fun i => lam i - τ * c i with hlam'def
    have hlam' : ∀ i, 0 ≤ lam' i := by
      intro i
      simp only [lam']
      rcases le_or_gt (c i) 0 with hci | hci
      · nlinarith [hlam i]
      · have h1 : τ ≤ lam i / c i := hjmin i (by simp [S, hci])
        have h2 : τ * c i ≤ lam i := by
          have := mul_le_mul_of_nonneg_right h1 hci.le
          rwa [div_mul_cancel₀ _ hci.ne'] at this
        linarith
    have hsum : ∑ i, lam' i • v i = ∑ i, lam i • v i := by
      simp only [lam', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hcsum,
        smul_zero, sub_zero]
    have hcard : (Finset.univ.filter (fun i => lam' i ≠ 0)).card ≤ k := by
      have hsub : Finset.univ.filter (fun i => lam' i ≠ 0) ⊆ s.erase j := by
        intro i hi
        have hi' : lam' i ≠ 0 := (Finset.mem_filter.mp hi).2
        refine Finset.mem_erase.mpr ⟨?_, ?_⟩
        · rintro rfl
          apply hi'
          simp only [lam', τ]
          field_simp
          ring
        · refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => hi' ?_⟩
          simp [lam', h0, hcsupp i h0]
      have hjs : j ∈ s := by
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => ?_⟩
        have := hcsupp j h0
        linarith
      have := Finset.card_le_card hsub
      rw [Finset.card_erase_of_mem hjs] at this
      omega
    obtain ⟨μ, h1, h2, h3⟩ := ih lam' hcard hlam'
    exact ⟨μ, h1, h2.trans hsum, h3⟩

/-- The cone generated by a finite family. -/
def gcone {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι] (v : ι → V) :
    Set V :=
  {x | ∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ x = ∑ i, lam i • v i}

theorem gcone_closed {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [FiniteDimensional ℝ V] {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) :
    IsClosed (gcone v) := by
  classical
  -- the piece over a linearly independent support
  let P : Finset ι → Set V := fun t =>
    (Fintype.linearCombination ℝ (fun i : t => v i)) '' {μ | ∀ i, 0 ≤ μ i}
  have hP : ∀ t : Finset ι, LinearIndepOn ℝ v (↑t : Set ι) → IsClosed (P t) := by
    intro t ht
    have hker : LinearMap.ker (Fintype.linearCombination ℝ (fun i : t => v i)) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro g hg
      rw [Fintype.linearCombination_apply] at hg
      exact funext (Fintype.linearIndependent_iff.mp ht g hg)
    have hemb := LinearMap.isClosedEmbedding_of_injective hker
    apply hemb.isClosedMap
    have : {μ : t → ℝ | ∀ i, 0 ≤ μ i} = ⋂ i, {μ : t → ℝ | 0 ≤ μ i} := by ext; simp
    rw [this]
    exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))
  have heq : gcone v = ⋃ t ∈ (Finset.univ.filter (fun t : Finset ι =>
      LinearIndepOn ℝ v (↑t : Set ι))), P t := by
    ext x
    simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and, exists_prop]
    constructor
    · rintro ⟨lam, hlam, rfl⟩
      obtain ⟨μ, hμ, hμsum, hli⟩ := conic_cara v _ lam le_rfl hlam
      refine ⟨_, hli, fun i => μ i, fun i => hμ i, ?_⟩
      rw [Fintype.linearCombination_apply, ← hμsum]
      refine (Finset.sum_coe_sort _ (fun i => μ i • v i)).trans ?_
      refine Finset.sum_filter_of_ne (fun i _ hne => ?_)
      intro h0
      exact hne (by rw [h0, zero_smul])
    · rintro ⟨t, -, μ, hμ, rfl⟩
      refine ⟨fun i => if h : i ∈ t then μ ⟨i, h⟩ else 0, fun i => ?_, ?_⟩
      · by_cases h : i ∈ t
        · simp only [h, dite_true]
          exact hμ _
        · simp [h]
      · rw [Fintype.linearCombination_apply]
        rw [← Finset.sum_subset (Finset.subset_univ t) (fun i _ hi => by simp [hi])]
        rw [← Finset.sum_coe_sort t]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp
  rw [heq]
  exact isClosed_biUnion_finset (fun t ht => hP t (Finset.mem_filter.mp ht).2)

/-- Farkas' lemma for a finite family in `ℝⁿ`. -/
theorem farkas {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → E n) (g : E n) :
    (∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ g = ∑ i, lam i • v i) ∨
    ∃ d : E n, (∀ i, 0 ≤ inner ℝ (v i) d) ∧ inner ℝ g d < 0 := by
  by_cases hg : g ∈ gcone v
  · exact Or.inl hg
  right
  have hconv : Convex ℝ (gcone v) := by
    rintro x ⟨lx, hlx, rfl⟩ y ⟨ly, hly, rfl⟩ a b ha hb _
    refine ⟨fun i => a * lx i + b * ly i, fun i => by
      have := hlx i; have := hly i; positivity, ?_⟩
    simp only [Finset.smul_sum, smul_smul, ← Finset.sum_add_distrib, add_smul]
  obtain ⟨f, w, hfw, hwg⟩ := geometric_hahn_banach_closed_point hconv (gcone_closed v) hg
  have h0 : (0 : E n) ∈ gcone v := ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
  have hw : 0 < w := by simpa using hfw 0 h0
  have hfv : ∀ i, f (v i) ≤ 0 := by
    intro i
    by_contra h
    push Not at h
    have hmem : (w / f (v i)) • v i ∈ gcone v := by
      refine ⟨fun j => if j = i then w / f (v i) else 0, fun j => ?_, ?_⟩
      · dsimp only
        split_ifs
        · positivity
        · exact le_rfl
      · simp
    have := hfw _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ h.ne'] at this
    exact lt_irrefl _ this
  refine ⟨(InnerProductSpace.toDual ℝ (E n)).symm (-f), fun i => ?_, ?_⟩
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simpa using hfv i
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simp only [neg_apply]
    linarith

theorem vec_eq_sum {n : ℕ} (x : E n) : x = ∑ i, x i • EuclideanSpace.single i (1:ℝ) := by
  conv_lhs => rw [← (EuclideanSpace.basisFun (Fin n) ℝ).sum_repr x]
  simp [EuclideanSpace.basisFun_apply]

theorem hd_line {n : ℕ} (x d : E n) : HasDerivAt (fun t : ℝ => x + t • d) d 0 := by
  simpa using ((hasDerivAt_id (0:ℝ)).smul_const d).const_add x

theorem hd_f {n : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) (x d : E n) :
    HasDerivAt (fun t : ℝ => f (x + t • d)) (inner ℝ (gradient f x) d) 0 := by
  have h0 : HasFDerivAt f (InnerProductSpace.toDual ℝ (E n) (gradient f x))
      ((fun t : ℝ => x + t • d) 0) := by
    simp only [zero_smul, add_zero]
    exact (hdiff x).hasGradientAt.hasFDerivAt
  exact h0.comp_hasDerivAt (0:ℝ) (hd_line x d)

theorem hd_norm {n : ℕ} (x d z : E n) :
    HasDerivAt (fun t : ℝ => ‖x + t • d - z‖ ^ 2) (2 * inner ℝ (x - z) d) 0 := by
  have := ((hd_line x d).sub_const z).norm_sq
  simpa using this

theorem hd_A {n m : ℕ} (A : E n →L[ℝ] E m) (b : E m) (x d : E n) :
    HasDerivAt (fun t : ℝ => A (x + t • d) - b) (A d) 0 := by
  have := (A.hasFDerivAt.comp_hasDerivAt (0:ℝ) (hd_line x d)).sub_const b
  exact this

theorem hd_K {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) (A : E n →L[ℝ] E m)
    (b : E m) (Γ p : ℝ) (x d z : E n) (y : E m) :
    HasDerivAt (fun t : ℝ => K f A b Γ p (x + t • d) z y)
      (inner ℝ (gradient f x) d + inner ℝ y (A d) + Γ * inner ℝ (A x - b) (A d)
        + p * inner ℝ (x - z) d) 0 := by
  have h1 := hd_f hdiff x d
  have h2 : HasDerivAt (fun t : ℝ => inner ℝ y (A (x + t • d) - b)) (inner ℝ y (A d)) 0 := by
    have := (innerSL ℝ y).hasFDerivAt.comp_hasDerivAt (0:ℝ) (hd_A A b x d)
    exact this
  have h3 := (hd_A A b x d).norm_sq
  have h4 := hd_norm x d z
  have := ((h1.add h2).add (h3.const_mul (Γ / 2))).add (h4.const_mul (p / 2))
  unfold K
  convert this using 1
  all_goals first
    | rfl
    | (simp only [zero_smul, add_zero]; ring)

theorem coord_ev {a l r d : ℝ} (hl : l ≤ a) (hr : a ≤ r)
    (hdl : a = l → 0 ≤ d) (hdr : a = r → d ≤ 0) :
    ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), l ≤ a + t * d ∧ a + t * d ≤ r := by
  have hc : Continuous (fun t : ℝ => a + t * d) := by fun_prop
  have ht := hc.tendsto 0
  rw [zero_mul, add_zero] at ht
  have hpos : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), 0 < t := self_mem_nhdsWithin
  refine Filter.Eventually.and ?_ ?_
  · rcases hl.lt_or_eq with h | h
    · exact ((ht.eventually (lt_mem_nhds h)).filter_mono nhdsWithin_le_nhds).mono
        (fun t ht => ht.le)
    · have hd := hdl h.symm
      exact hpos.mono (fun t htp => by rw [← h]; linarith [mul_nonneg htp.le hd])
  · rcases hr.lt_or_eq with h | h
    · exact ((ht.eventually (gt_mem_nhds h)).filter_mono nhdsWithin_le_nhds).mono
        (fun t ht => ht.le)
    · have hd := hdr h
      exact hpos.mono (fun t htp => by rw [h]; linarith [mul_nonpos_of_nonneg_of_nonpos htp.le hd])

theorem ystar_nonempty {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m)
    (ℓ u : Fin n → ℝ) (hdiff : Differentiable ℝ f) (p : ℝ)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) (z : E n) :
    (Ystar f A ℓ u p xst z).Nonempty := by
  classical
  obtain ⟨⟨hxbox, hxA⟩, hxmin⟩ := hxst z
  set x := xst z with hx
  set G : E n := gradient f x + p • (x - z) with hG
  let v1 : Fin m → E n := fun j => (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
  let v2 : Fin m → E n := fun j => -(ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
  let v3 : Fin n → E n := fun i => if x i = ℓ i then EuclideanSpace.single i 1 else 0
  let v4 : Fin n → E n := fun i => if x i = u i then -EuclideanSpace.single i 1 else 0
  let v := Sum.elim (Sum.elim v1 v2) (Sum.elim v3 v4)
  rcases farkas v G with ⟨lam, hlam, hGsum⟩ | ⟨d, hd, hGd⟩
  · let c : Fin n → ℝ := fun i => if x i = ℓ i then lam (Sum.inr (Sum.inl i)) else 0
    let c' : Fin n → ℝ := fun i => if x i = u i then lam (Sum.inr (Sum.inr i)) else 0
    let S : E n := ∑ j, (lam (Sum.inl (Sum.inl j)) - lam (Sum.inl (Sum.inr j))) • v1 j
    have hS : (ContinuousLinearMap.adjoint A) (∑ j, (lam (Sum.inl (Sum.inr j))
        - lam (Sum.inl (Sum.inl j))) • EuclideanSpace.single j (1:ℝ)) = -S := by
      rw [map_sum, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul]
      simp only [v1]
      module
    have hkey : G = S + WithLp.toLp 2 c - WithLp.toLp 2 c' := by
      rw [hGsum, Fintype.sum_sum_type, Fintype.sum_sum_type, Fintype.sum_sum_type]
      simp only [v, Sum.elim_inl, Sum.elim_inr]
      rw [vec_eq_sum (WithLp.toLp 2 c), vec_eq_sum (WithLp.toLp 2 c')]
      have e12 : ∑ j, lam (Sum.inl (Sum.inl j)) • v1 j + ∑ j, lam (Sum.inl (Sum.inr j)) • v2 j
          = S := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [v2, v1]
        module
      have e3 : ∑ i, lam (Sum.inr (Sum.inl i)) • v3 i
          = ∑ i, (WithLp.toLp 2 c : E n) i • EuclideanSpace.single i (1:ℝ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [v3, c, PiLp.toLp_apply]
        split_ifs <;> simp
      have e4 : ∑ i, lam (Sum.inr (Sum.inr i)) • v4 i
          = -∑ i, (WithLp.toLp 2 c' : E n) i • EuclideanSpace.single i (1:ℝ) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [v4, c', PiLp.toLp_apply]
        split_ifs <;> simp
      rw [e12, e3, e4]
      abel
    refine ⟨∑ j, (lam (Sum.inl (Sum.inr j)) - lam (Sum.inl (Sum.inl j))) •
      EuclideanSpace.single j (1:ℝ), WithLp.toLp 2 c, WithLp.toLp 2 c', ?_, ?_, ?_, ?_⟩
    · rw [← hG, hS, hkey]
      abel
    · intro i
      simp only [c, c']
      constructor
      · split_ifs
        · exact hlam _
        · exact le_rfl
      · split_ifs
        · exact hlam _
        · exact le_rfl
    · intro i
      simp only [c]
      split_ifs with h
      · rw [← hx, h]; ring
      · ring
    · intro i
      simp only [c']
      split_ifs with h
      · rw [← hx, h]; ring
      · ring
  · exfalso
    have hAd : A d = 0 := by
      ext j
      have h1 := hd (Sum.inl (Sum.inl j))
      have h2 := hd (Sum.inl (Sum.inr j))
      simp only [v, v1, v2, Sum.elim_inl, Sum.elim_inr, inner_neg_left,
        ContinuousLinearMap.adjoint_inner_left, EuclideanSpace.inner_single_left, map_one,
        one_mul] at h1 h2
      simp only [PiLp.zero_apply]
      linarith
    have hdl : ∀ i, x i = ℓ i → 0 ≤ d i := by
      intro i hi
      have h := hd (Sum.inr (Sum.inl i))
      simpa [v, v3, hi, EuclideanSpace.inner_single_left] using h
    have hdu : ∀ i, x i = u i → d i ≤ 0 := by
      intro i hi
      have h := hd (Sum.inr (Sum.inr i))
      simpa [v, v4, hi, EuclideanSpace.inner_single_left] using h
    have hev : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0),
        0 < t ∧ ∀ i, ℓ i ≤ x i + t * d i ∧ x i + t * d i ≤ u i :=
      (show ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), 0 < t from self_mem_nhdsWithin).and
        (Filter.eventually_all.mpr
        (fun i => coord_ev (hxbox i).1 (hxbox i).2 (hdl i) (hdu i)))
    obtain ⟨t0, ht0, ht0box⟩ := hev.exists
    have hfeas : ∀ t ∈ Set.Icc (0:ℝ) t0, x + t • d ∈ feas A b ℓ u := by
      rintro t ⟨ht1, ht2⟩
      refine ⟨fun i => ?_, ?_⟩
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
        obtain ⟨h1, h2⟩ := ht0box i
        have h3 := hxbox i
        rcases le_or_gt 0 (d i) with hdi | hdi
        · have : t * d i ≤ t0 * d i := mul_le_mul_of_nonneg_right ht2 hdi
          have h4 := mul_nonneg ht1 hdi
          constructor <;> linarith [h3.1, h3.2]
        · have : t0 * d i ≤ t * d i := mul_le_mul_of_nonpos_right ht2 hdi.le
          have h4 := mul_nonpos_of_nonneg_of_nonpos ht1 hdi.le
          constructor <;> linarith [h3.1, h3.2]
      · show A (x + t • d) = b
        rw [map_add, map_smul, hAd, smul_zero, add_zero]
        exact hxA
    have hmin : ∀ t ∈ Set.Icc (0:ℝ) t0,
        (fun t : ℝ => f (x + t • d) + p / 2 * ‖x + t • d - z‖ ^ 2) 0 ≤
        (fun t : ℝ => f (x + t • d) + p / 2 * ‖x + t • d - z‖ ^ 2) t := by
      intro t ht
      simp only [zero_smul, add_zero]
      exact hxmin _ (hfeas t ht)
    have hder := (hd_f hdiff x d).add ((hd_norm x d z).const_mul (p / 2))
    have h0 := deriv_nonneg_of_min ht0 hder hmin
    have hGd' : inner ℝ G d = inner ℝ (gradient f x) d + p / 2 * (2 * inner ℝ (x - z) d) := by
      rw [hG, inner_add_left, real_inner_smul_left]
      ring
    linarith

theorem box_seg {n : ℕ} {ℓ u : Fin n → ℝ} {x x' : E n} (hx : x ∈ box ℓ u)
    (hx' : x' ∈ box ℓ u) {t : ℝ} (ht : t ∈ Set.Icc (0:ℝ) 1) : x + t • (x' - x) ∈ box ℓ u := by
  intro i
  simp only [PiLp.add_apply, PiLp.smul_apply, PiLp.sub_apply, smul_eq_mul]
  obtain ⟨h1, h2⟩ := hx i
  obtain ⟨h3, h4⟩ := hx' i
  obtain ⟨ht0, ht1⟩ := ht
  have a1 := mul_nonneg (sub_nonneg.mpr ht1) (sub_nonneg.mpr h1)
  have a2 := mul_nonneg ht0 (sub_nonneg.mpr h3)
  have a3 := mul_nonneg (sub_nonneg.mpr ht1) (sub_nonneg.mpr h2)
  have a4 := mul_nonneg ht0 (sub_nonneg.mpr h4)
  constructor <;> nlinarith

theorem vi_xs {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z x' : E n) (hx' : x' ∈ box ℓ u) :
    0 ≤ inner ℝ (gradient f (xs y z)) (x' - xs y z) + inner ℝ y (A (x' - xs y z))
      + Γ * inner ℝ (A (xs y z) - b) (A (x' - xs y z))
      + p * inner ℝ (xs y z - z) (x' - xs y z) := by
  obtain ⟨hbox, hmin⟩ := hxs y z
  refine deriv_nonneg_of_min one_pos (hd_K hdiff A b Γ p (xs y z) (x' - xs y z) z y) ?_
  intro t ht
  simp only [zero_smul, add_zero]
  exact hmin _ (box_seg hbox hx' ht)

end E312Aux

namespace C37Aux

open ProxADMMLC.Conv E312Aux Filter Topology

theorem gradK_sub {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (Γ p : ℝ)
    (x x' z : E n) (y : E m) :
    gradK f A b Γ p x z y - gradK f A b Γ p x' z y
      = (gradient f x - gradient f x') + Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))
        + p • (x - x') := by
  unfold gradK
  simp only [map_sub]
  module

theorem vi_gradK {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z x' : E n) (hx' : x' ∈ box ℓ u) :
    0 ≤ inner ℝ (gradK f A b Γ p (xs y z) z y) (x' - xs y z) := by
  have h := vi_xs hdiff hxs y z x' hx'
  unfold gradK
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left]
  linarith

theorem lip_gradK {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m}
    {ℓ u : Fin n → ℝ} {L Γ p : ℝ}
    (hlip : ∀ x ∈ box ℓ u, ∀ x' ∈ box ℓ u, ‖gradient f x - gradient f x'‖ ≤ L * ‖x - x'‖)
    (hΓ : 0 ≤ Γ) (hp : 0 ≤ p) (z : E n) (y : E m)
    (x x' : E n) (hx : x ∈ box ℓ u) (hx' : x' ∈ box ℓ u) :
    ‖gradK f A b Γ p x z y - gradK f A b Γ p x' z y‖
      ≤ (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p) * ‖x - x'‖ := by
  rw [gradK_sub]
  have h1 := hlip x hx x' hx'
  have h2 : ‖Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))‖
      ≤ Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) * ‖x - x'‖ := by
    rw [norm_smul, Real.norm_of_nonneg hΓ]
    have h3 := (ContinuousLinearMap.adjoint A).le_opNorm (A (x - x'))
    have h4 := A.le_opNorm (x - x')
    have h5 : ‖(ContinuousLinearMap.adjoint A) (A (x - x'))‖
        ≤ ‖ContinuousLinearMap.adjoint A‖ * (‖A‖ * ‖x - x'‖) :=
      h3.trans (mul_le_mul_of_nonneg_left h4 (norm_nonneg _))
    calc Γ * ‖(ContinuousLinearMap.adjoint A) (A (x - x'))‖
        ≤ Γ * (‖ContinuousLinearMap.adjoint A‖ * (‖A‖ * ‖x - x'‖)) :=
          mul_le_mul_of_nonneg_left h5 hΓ
      _ = Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) * ‖x - x'‖ := by ring
  have h3 : ‖p • (x - x')‖ = p * ‖x - x'‖ := by rw [norm_smul, Real.norm_of_nonneg hp]
  have h6 := norm_add_le ((gradient f x - gradient f x')
    + Γ • (ContinuousLinearMap.adjoint A) (A (x - x'))) (p • (x - x'))
  have h7 := norm_add_le (gradient f x - gradient f x')
    (Γ • (ContinuousLinearMap.adjoint A) (A (x - x')))
  linarith

end C37Aux

namespace L34Aux

open Filter Topology

open ProxADMMLC.Conv

theorem box_closed {n : ℕ} (ℓ u : Fin n → ℝ) : IsClosed (box ℓ u) := by
  have : box ℓ u = ⋂ i, ({x : E n | ℓ i ≤ x i} ∩ {x | x i ≤ u i}) := by
    ext x; simp [box]
  rw [this]
  refine isClosed_iInter fun i => ?_
  have hc : Continuous fun x : E n => x i := by fun_prop
  exact (isClosed_le continuous_const hc).inter (isClosed_le hc continuous_const)

theorem box_bounded {n : ℕ} (ℓ u : Fin n → ℝ) : Bornology.IsBounded (box ℓ u) := by
  have hc : Continuous (WithLp.toLp 2 : (Fin n → ℝ) → E n) := by fun_prop
  have hK : IsCompact ((WithLp.toLp 2 : (Fin n → ℝ) → E n) ''
      Set.univ.pi fun i => Set.Icc (ℓ i) (u i)) :=
    (isCompact_univ_pi fun i => isCompact_Icc).image hc
  refine hK.isBounded.subset fun x hx => ⟨WithLp.ofLp x, fun i _ => hx i, rfl⟩

theorem box_compact {n : ℕ} (ℓ u : Fin n → ℝ) : IsCompact (box ℓ u) :=
  Metric.isCompact_of_isClosed_isBounded (box_closed ℓ u) (box_bounded ℓ u)

theorem range_sub_span {n m : ℕ} (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (h0 : (0 : E m) ∈ (fun x => A x - b) '' box ℓ u) (x : E n) :
    A x ∈ affineSpan ℝ ((fun x => A x - b) '' box ℓ u) := by
  set S := (fun x => A x - b) '' box ℓ u with hS
  set c : E n := WithLp.toLp 2 (fun i => (ℓ i + u i) / 2) with hc
  have hev : ∀ᶠ t in 𝓝[>] (0:ℝ), 0 < t ∧ c + t • x ∈ box ℓ u := by
    refine (show ∀ᶠ t in 𝓝[>] (0:ℝ), 0 < t from self_mem_nhdsWithin).and ?_
    have : ∀ i, ∀ᶠ t in 𝓝[>] (0:ℝ), ℓ i ≤ (c + t • x) i ∧ (c + t • x) i ≤ u i := by
      intro i
      have hcont : Continuous (fun t : ℝ => (ℓ i + u i) / 2 + t * x i) := by fun_prop
      have ht := hcont.tendsto 0
      rw [zero_mul, add_zero] at ht
      have h1 : ℓ i < (ℓ i + u i) / 2 := by linarith [hℓu i]
      have h2 : (ℓ i + u i) / 2 < u i := by linarith [hℓu i]
      have e1 := (ht.eventually (gt_mem_nhds h2)).filter_mono
        (nhdsWithin_le_nhds (s := Set.Ioi (0:ℝ)))
      have e2 := (ht.eventually (lt_mem_nhds h1)).filter_mono
        (nhdsWithin_le_nhds (s := Set.Ioi (0:ℝ)))
      refine (e1.and e2).mono (fun t ht => ?_)
      simp only [c, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      exact ⟨ht.2.le, ht.1.le⟩
    exact (Filter.eventually_all.mpr this).mono (fun t ht => ht)
  obtain ⟨t, ht0, htbox⟩ := hev.exists
  have hcbox : c ∈ box ℓ u := by
    intro i
    simp only [c]
    constructor <;> linarith [hℓu i]
  have hm1 : A (c + t • x) - b ∈ affineSpan ℝ S := subset_affineSpan ℝ S ⟨_, htbox, rfl⟩
  have hm2 : A c - b ∈ affineSpan ℝ S := subset_affineSpan ℝ S ⟨_, hcbox, rfl⟩
  have hdir : t • A x ∈ (affineSpan ℝ S).direction := by
    have := AffineSubspace.vsub_mem_direction hm1 hm2
    rw [vsub_eq_sub] at this
    convert this using 1
    rw [map_add, map_smul]
    abel
  have hdir' : A x ∈ (affineSpan ℝ S).direction := by
    have := Submodule.smul_mem _ t⁻¹ hdir
    rwa [smul_smul, inv_mul_cancel₀ ht0.ne', one_smul] at this
  have h0' : (0 : E m) ∈ affineSpan ℝ S := subset_affineSpan ℝ S h0
  have := AffineSubspace.vadd_mem_of_mem_direction hdir' h0'
  simpa using this

theorem rel_ball {n m : ℕ} (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (ha : Assump22a A b ℓ u) :
    ∃ r > 0, ∀ v ∈ LinearMap.range (A : E n →ₗ[ℝ] E m), ‖v‖ ≤ r →
      ∃ x ∈ box ℓ u, A x - b = v := by
  unfold Assump22a at ha
  rw [mem_intrinsicInterior] at ha
  obtain ⟨y0, hy0, hy0eq⟩ := ha
  have h0 : (0 : E m) ∈ (fun x => A x - b) '' box ℓ u := by
    have := interior_subset hy0
    rw [← hy0eq]
    exact this
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (mem_interior_iff_mem_nhds.mp hy0)
  refine ⟨ε / 2, by positivity, fun v hv hvr => ?_⟩
  obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hv
  simp only [ContinuousLinearMap.coe_coe] at hvr ⊢
  have hmem := range_sub_span A b ℓ u hℓu h0 x
  have hin : (⟨A x, hmem⟩ : affineSpan ℝ ((fun x => A x - b) '' box ℓ u)) ∈
      Metric.ball y0 ε := by
    rw [Metric.mem_ball, Subtype.dist_eq, hy0eq, dist_zero_right]
    linarith
  obtain ⟨x', hx', hx'eq⟩ := hball hin
  exact ⟨x', hx', hx'eq⟩

end L34Aux

open Filter Topology ProxADMMLC.Conv in
theorem L34Aux.bdd {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (ha : Assump22a A b ℓ u) (hdiff : Differentiable ℝ f)
    (Γ p : ℝ) (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs) :
    ∀ (y0 : E m) (ys : ℕ → E m) (zs : ℕ → E n),
      (∀ i, ys i - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m)) → (∀ i, zs i ∈ box ℓ u) →
      Tendsto (fun i => ‖A (xs (ys i) (zs i)) - b‖) atTop (𝓝 0) →
      Bornology.IsBounded (Set.range ys) := by
  intro y0 ys zs hys hzs htend
  obtain ⟨r, hr, hball⟩ := L34Aux.rel_ball A b ℓ u hℓu ha
  have hcont : Continuous f := hdiff.continuous
  obtain ⟨M, hM⟩ : ∃ M, ∀ q ∈ box ℓ u ×ˢ box ℓ u, ‖K f A b Γ p q.1 q.2 y0‖ ≤ M := by
    apply ((L34Aux.box_compact ℓ u).prod (L34Aux.box_compact ℓ u)).exists_bound_of_continuousOn
    apply Continuous.continuousOn
    unfold K
    have h1 : Continuous fun q : E n × E n => A q.1 - b :=
      (A.continuous.comp continuous_fst).sub continuous_const
    exact (((hcont.comp continuous_fst).add (continuous_const.inner h1)).add
      (continuous_const.mul (h1.norm.pow 2))).add
      (continuous_const.mul ((continuous_fst.sub continuous_snd).norm.pow 2))
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM (zs 0, zs 0) ⟨hzs 0, hzs 0⟩)
  have hK : ∀ x z y, K f A b Γ p x z y = K f A b Γ p x z y0 + inner ℝ (y - y0) (A x - b) := by
    intro x z y
    unfold K
    rw [inner_sub_left]
    ring
  have hev : ∀ᶠ i in atTop, ‖A (xs (ys i) (zs i)) - b‖ < r / 2 :=
    htend.eventually (gt_mem_nhds (by positivity))
  obtain ⟨N, hN⟩ := eventually_atTop.mp hev
  have h4 : 0 ≤ 4 * M / r := by positivity
  have hbig : ∀ i ≥ N, ‖ys i - y0‖ ≤ 4 * M / r := by
    intro i hi
    by_cases hy : ys i - y0 = 0
    · rw [hy, norm_zero]; exact h4
    have hnorm : 0 < ‖ys i - y0‖ := norm_pos_iff.mpr hy
    have hvr : -(r / ‖ys i - y0‖) • (ys i - y0) ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) :=
      Submodule.smul_mem _ _ (hys i)
    have hvn : ‖-(r / ‖ys i - y0‖) • (ys i - y0)‖ ≤ r := by
      rw [norm_smul, norm_neg, Real.norm_eq_abs, abs_of_pos (by positivity),
        div_mul_cancel₀ _ hnorm.ne']
    obtain ⟨xi, hxi, hxieq⟩ := hball _ hvr hvn
    obtain ⟨hxhbox, hmin⟩ := hxs (ys i) (zs i)
    have h1 := hmin xi hxi
    rw [hK (xs (ys i) (zs i)) (zs i) (ys i), hK xi (zs i) (ys i)] at h1
    have b1 := hM (xs (ys i) (zs i), zs i) ⟨hxhbox, hzs i⟩
    have b2 := hM (xi, zs i) ⟨hxi, hzs i⟩
    rw [Real.norm_eq_abs] at b1 b2
    have b1' := (abs_le.mp b1).1
    have b2' := (abs_le.mp b2).2
    have hinner : inner ℝ (ys i - y0) (A xi - b) = -(r * ‖ys i - y0‖) := by
      rw [hxieq, real_inner_smul_right, real_inner_self_eq_norm_sq]
      have hn := hnorm.ne'
      field_simp
    have hcs : -(‖ys i - y0‖ * ‖A (xs (ys i) (zs i)) - b‖) ≤
        inner ℝ (ys i - y0) (A (xs (ys i) (zs i)) - b) := by
      have := abs_real_inner_le_norm (ys i - y0) (A (xs (ys i) (zs i)) - b)
      have := neg_abs_le (inner ℝ (ys i - y0) (A (xs (ys i) (zs i)) - b))
      linarith
    have hprod : ‖ys i - y0‖ * ‖A (xs (ys i) (zs i)) - b‖ ≤ ‖ys i - y0‖ * (r / 2) :=
      mul_le_mul_of_nonneg_left (hN i hi).le (norm_nonneg _)
    rw [le_div_iff₀ hr]
    linarith
  rw [isBounded_iff_forall_norm_le]
  refine ⟨‖y0‖ + 4 * M / r + ∑ j ∈ Finset.range N, ‖ys j‖, ?_⟩
  rintro _ ⟨i, rfl⟩
  have hsum : 0 ≤ ∑ j ∈ Finset.range N, ‖ys j‖ := Finset.sum_nonneg (fun _ _ => norm_nonneg _)
  by_cases hi : N ≤ i
  · have h1 := hbig i hi
    have h2 := norm_add_le y0 (ys i - y0)
    rw [add_sub_cancel] at h2
    linarith
  · have := Finset.single_le_sum (f := fun j => ‖ys j‖) (fun j _ => norm_nonneg _)
      (Finset.mem_range.mpr (by omega : i < N))
    linarith [norm_nonneg y0]

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace D310Aux

open ProxADMMLC.Conv E312Aux C37Aux Filter Topology

/-- sign pattern of a multiplier vector `m` at a box point `a` -/
def SignAt {n : ℕ} (ℓ u : Fin n → ℝ) (a m : E n) : Prop :=
  ∀ i, (0 < m i → a i = ℓ i) ∧ (m i < 0 → a i = u i)

theorem inner_eq_sum {n : ℕ} (x y : E n) : inner ℝ x y = ∑ i, x i * y i := by
  rw [PiLp.inner_apply]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp [mul_comm]

theorem sign_inner {n : ℕ} {ℓ u : Fin n → ℝ} {a m : E n} (hm : SignAt ℓ u a m)
    {c : E n} (hc : c ∈ box ℓ u) : 0 ≤ inner ℝ m (c - a) := by
  rw [inner_eq_sum]
  refine Finset.sum_nonneg (fun i _ => ?_)
  simp only [PiLp.sub_apply]
  rcases lt_trichotomy (m i) 0 with h | h | h
  · rw [(hm i).2 h]
    exact mul_nonneg_of_nonpos_of_nonpos h.le (by linarith [(hc i).2])
  · rw [h, zero_mul]
  · rw [(hm i).1 h]
    exact mul_nonneg h.le (by linarith [(hc i).1])

theorem cross {n : ℕ} {ℓ u : Fin n → ℝ} {a a' m m' : E n}
    (ha : a ∈ box ℓ u) (ha' : a' ∈ box ℓ u) (hm : SignAt ℓ u a m) (hm' : SignAt ℓ u a' m') :
    inner ℝ (m - m') (a - a') ≤ 0 := by
  have h1 := sign_inner hm ha'
  have h2 := sign_inner hm' ha
  have e : a - a' = -(a' - a) := by abel
  have h3 : inner ℝ m (a - a') = -inner ℝ m (a' - a) := by rw [e, inner_neg_right]
  rw [inner_sub_left, h3]
  linarith

theorem box_upd {n : ℕ} {ℓ u : Fin n → ℝ} {x : E n} (hx : x ∈ box ℓ u) (i : Fin n) {v : ℝ}
    (hv : ℓ i ≤ v ∧ v ≤ u i) : x + (v - x i) • EuclideanSpace.single i (1:ℝ) ∈ box ℓ u := by
  intro j
  by_cases hj : j = i
  · subst hj
    simp only [PiLp.add_apply, PiLp.smul_apply, EuclideanSpace.single_apply, if_true,
      smul_eq_mul, mul_one]
    constructor <;> linarith [hv.1, hv.2]
  · simp only [PiLp.add_apply, PiLp.smul_apply, EuclideanSpace.single_apply, hj, if_false,
      smul_eq_mul, mul_zero, add_zero]
    exact hx j

theorem sign_of_vi {n : ℕ} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {x m : E n}
    (hx : x ∈ box ℓ u) (hvi : ∀ x' ∈ box ℓ u, 0 ≤ inner ℝ m (x' - x)) : SignAt ℓ u x m := by
  have key : ∀ i, ∀ v, ℓ i ≤ v ∧ v ≤ u i → 0 ≤ (v - x i) * m i := by
    intro i v hv
    have h := hvi _ (box_upd hx i hv)
    rw [add_sub_cancel_left, real_inner_smul_right, EuclideanSpace.inner_single_right] at h
    simpa using h
  intro i
  constructor
  · intro hm
    by_contra hne
    have h1 := key i (ℓ i) ⟨le_rfl, (hℓu i).le⟩
    have h2 : ℓ i < x i := lt_of_le_of_ne (hx i).1 (Ne.symm hne)
    have := mul_neg_of_neg_of_pos (sub_neg.mpr h2) hm
    linarith
  · intro hm
    by_contra hne
    have h1 := key i (u i) ⟨(hℓu i).le, le_rfl⟩
    have h2 : x i < u i := lt_of_le_of_ne (hx i).2 hne
    have := mul_neg_of_pos_of_neg (sub_pos.mpr h2) hm
    linarith

theorem sign_xs {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z : E n) :
    SignAt ℓ u (xs y z) (gradK f A b Γ p (xs y z) z y) :=
  sign_of_vi hℓu (hxs y z).1 (fun x' hx' => vi_gradK hdiff hxs y z x' hx')

theorem sign_of_ystar {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {ℓ u : Fin n → ℝ} {p : ℝ}
    {xst : E n → E n} {z : E n} {w : E m} (hw : w ∈ Ystar f A ℓ u p xst z) :
    SignAt ℓ u (xst z)
      (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w) := by
  obtain ⟨μ, ν, heq, hnn, hμ, hν⟩ := hw
  have hm : gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w = μ - ν := by
    rw [← sub_eq_zero, ← heq]; abel
  intro i
  rw [hm, PiLp.sub_apply]
  constructor
  · intro h
    have hpos : μ i ≠ 0 := by intro h0; linarith [(hnn i).2]
    rcases mul_eq_zero.mp (hμ i) with h1 | h1
    · exact absurd h1 hpos
    · linarith
  · intro h
    have hpos : ν i ≠ 0 := by intro h0; linarith [(hnn i).1]
    rcases mul_eq_zero.mp (hν i) with h1 | h1
    · exact absurd h1 hpos
    · linarith

theorem f3 {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) (y : E m) (z : E n) {w : E m}
    (hw : w ∈ Ystar f A ℓ u p xst z) :
    (p + γ) * ‖xs y z - xst z‖ ^ 2 + Γ * ‖A (xs y z) - b‖ ^ 2
      ≤ -inner ℝ (y - w) (A (xs y z) - b) := by
  have hs1 := sign_xs hdiff hℓu hxs y z
  have hs2 := sign_of_ystar hw
  have hc := cross (hxs y z).1 (hxst z).1.1 hs1 hs2
  have hAx : A (xst z) = b := (hxst z).1.2
  have hmono := hγ _ (hxs y z).1 _ (hxst z).1.1
  have hexp : gradK f A b Γ p (xs y z) z y
      - (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w)
      = (gradient f (xs y z) - gradient f (xst z)) + (ContinuousLinearMap.adjoint A) (y - w)
        + Γ • (ContinuousLinearMap.adjoint A) (A (xs y z) - b) + p • (xs y z - xst z) := by
    unfold gradK
    simp only [map_sub]
    module
  have hA : A (xs y z - xst z) = A (xs y z) - b := by rw [map_sub, hAx]
  rw [hexp] at hc
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left,
    hA, real_inner_self_eq_norm_sq] at hc
  linarith

theorem xs_of_ystar {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ)
    (hΓ : 0 ≤ Γ) (hpγ : -γ < p)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) (z : E n) {w : E m}
    (hw : w ∈ Ystar f A ℓ u p xst z) : A (xs w z) = b := by
  have h := f3 hdiff hℓu hγ hxs hxst w z hw
  rw [sub_self, inner_zero_left, neg_zero] at h
  have h1 : 0 ≤ (p + γ) * ‖xs w z - xst z‖ ^ 2 := mul_nonneg (by linarith) (sq_nonneg _)
  have h2 : 0 ≤ ‖xs w z - xst z‖ ^ 2 := sq_nonneg _
  have h3 : ‖xs w z - xst z‖ ^ 2 = 0 := by
    by_contra hne
    have : 0 < (p + γ) * ‖xs w z - xst z‖ ^ 2 :=
      mul_pos (by linarith) (lt_of_le_of_ne h2 (Ne.symm hne))
    nlinarith [mul_nonneg hΓ (sq_nonneg ‖A (xs w z) - b‖)]
  have : xs w z = xst z := by
    rw [← sub_eq_zero, ← norm_eq_zero]; exact pow_eq_zero_iff (by norm_num) |>.mp h3
  rw [this]; exact (hxst z).1.2

theorem ystar_range {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {p : ℝ} {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst)
    (z : E n) : ∃ w ∈ Ystar f A ℓ u p xst z, w ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) := by
  obtain ⟨w, hw⟩ := ystar_nonempty f A b ℓ u hdiff p xst hxst z
  obtain ⟨w1, hw1, w2, hw2, rfl⟩ :=
    (LinearMap.range (A : E n →ₗ[ℝ] E m)).exists_add_mem_mem_orthogonal w
  have hk : (ContinuousLinearMap.adjoint A) w2 = 0 := by
    have h0 : inner ℝ ((ContinuousLinearMap.adjoint A) w2) ((ContinuousLinearMap.adjoint A) w2)
        = 0 := by
      rw [ContinuousLinearMap.adjoint_inner_left]
      rw [real_inner_comm]
      exact (Submodule.mem_orthogonal _ _).mp hw2 _ (LinearMap.mem_range_self _ _)
    exact inner_self_eq_zero.mp h0
  refine ⟨w1, ?_, hw1⟩
  obtain ⟨μ, ν, h1, h2⟩ := hw
  refine ⟨μ, ν, ?_, h2⟩
  rw [map_add, hk, add_zero] at h1
  exact h1

end D310Aux

open ProxADMMLC.Conv E312Aux C37Aux D310Aux Filter Topology in
theorem D310Aux.cor38 {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (ha : Assump22a A b ℓ u) (L : ℝ) (hf : Assump22c f ℓ u L)
    (γ : ℝ) (hγ : MonoConst f ℓ u γ) (Γ p : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hpγ : -γ < p)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) :
    ∀ y0 : E m, ∀ ε > 0, ∃ δ > 0, ∀ z ∈ box ℓ u, ∀ w : E m,
      w - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) → ‖A (xs w z) - b‖ < δ → ‖xs w z - xst z‖ < ε := by
  intro y0 ε hε
  obtain ⟨hdiff, hL, hlip⟩ := hf
  have hpg : 0 < p + γ := by linarith
  by_contra hcon
  push_neg at hcon
  have hk : ∀ k : ℕ, ∃ z, z ∈ box ℓ u ∧ ∃ w : E m, w - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) ∧
      ‖A (xs w z) - b‖ < 1 / ((k : ℝ) + 1) ∧ ε ≤ ‖xs w z - xst z‖ :=
    fun k => hcon _ (by positivity)
  choose Z hZb Y hYr hr hge using hk
  choose W hWy hWr using fun k => ystar_range hdiff hxst (Z k)
  have hWA : ∀ k, A (xs (W k) (Z k)) = b :=
    fun k => xs_of_ystar hdiff hℓu hγ hΓ.le hpγ hxs hxst (Z k) (hWy k)
  have hinv : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hYbdd : Bornology.IsBounded (Set.range Y) :=
    L34Aux.bdd f A b ℓ u hℓu ha hdiff Γ p xs hxs y0 Y Z hYr hZb
      (squeeze_zero (fun k => norm_nonneg _) (fun k => (hr k).le) hinv)
  have hWbdd : Bornology.IsBounded (Set.range W) := by
    refine L34Aux.bdd f A b ℓ u hℓu ha hdiff Γ p xs hxs 0 W Z (fun k => by simpa using hWr k) hZb ?_
    simp only [hWA, sub_self, norm_zero]
    exact tendsto_const_nhds
  obtain ⟨RY, hRY⟩ := isBounded_iff_forall_norm_le.mp hYbdd
  obtain ⟨RW, hRW⟩ := isBounded_iff_forall_norm_le.mp hWbdd
  have hY' : ∀ k, ‖Y k‖ ≤ RY := fun k => hRY _ ⟨k, rfl⟩
  have hW' : ∀ k, ‖W k‖ ≤ RW := fun k => hRW _ ⟨k, rfl⟩
  have hη2 : ∀ k, (p + γ) * ‖xs (Y k) (Z k) - xst (Z k)‖ ^ 2 ≤ (RY + RW) * (1 / ((k : ℝ) + 1)) := by
    intro k
    have h := f3 hdiff hℓu hγ hxs hxst (Y k) (Z k) (hWy k)
    have hcs := abs_real_inner_le_norm (Y k - W k) (A (xs (Y k) (Z k)) - b)
    have hcs2 := neg_abs_le (inner ℝ (Y k - W k) (A (xs (Y k) (Z k)) - b))
    have hyw : ‖Y k - W k‖ ≤ RY + RW := (norm_sub_le _ _).trans (add_le_add (hY' k) (hW' k))
    have hΓr : 0 ≤ Γ * ‖A (xs (Y k) (Z k)) - b‖ ^ 2 := by positivity
    have := mul_le_mul hyw (hr k).le (norm_nonneg _) (by linarith [norm_nonneg (Y k - W k)])
    linarith
  have hlim := hinv.const_mul (RY + RW)
  rw [mul_zero] at hlim
  have hpos : 0 < (p + γ) * ε ^ 2 := by positivity
  obtain ⟨k, hk⟩ := (hlim.eventually (gt_mem_nhds hpos)).exists
  have hsq : ε ^ 2 ≤ ‖xs (Y k) (Z k) - xst (Z k)‖ ^ 2 := pow_le_pow_left₀ hε.le (hge k) 2
  have := mul_le_mul_of_nonneg_left hsq hpg.le
  linarith [hη2 k]

open ProxADMMLC.Conv in
theorem solution {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (ha : Assump22a A b ℓ u) (L : ℝ) (hf : Assump22c f ℓ u L)
    (γ : ℝ) (hγ : MonoConst f ℓ u γ) (Γ p : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hpγ : -γ < p)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) :
    ∀ y0 : E m, ∀ ε > 0, ∃ δ > 0, ∀ z ∈ box ℓ u, ∀ w : E m,
      w - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) → ‖A (xs w z) - b‖ < δ → ‖xs w z - xst z‖ < ε := by
  exact D310Aux.cor38 f A b ℓ u hℓu ha L hf γ hγ Γ p hΓ hp hpγ xs hxs xst hxst
