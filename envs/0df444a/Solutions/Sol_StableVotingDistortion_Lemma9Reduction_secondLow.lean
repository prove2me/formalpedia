theorem mass_checks : ∀ m∈masses,massOK m=true ∧ ∀ s∈segments,capOK m s=true := by
  have join {l r : List MassCell} (hl : ∀ m∈l,(massOK m && segments.all (capOK m)) = true)
      (hr : ∀ m∈r,(massOK m && segments.all (capOK m)) = true) : ∀ m∈l++r,(massOK m && segments.all (capOK m)) = true := by
    intro m hm;rcases List.mem_append.mp hm with h|h;exact hl m h;exact hr m h
  have H : ∀ m∈masses,(massOK m && segments.all (capOK m)) = true := by
    unfold masses;simp only [List.append_assoc]
    apply join (List.all_eq_true.mp mass_tests00)
    apply join (List.all_eq_true.mp mass_tests01)
    apply join (List.all_eq_true.mp mass_tests02)
    apply join (List.all_eq_true.mp mass_tests03)
    apply join (List.all_eq_true.mp mass_tests04)
    apply join (List.all_eq_true.mp mass_tests05)
    apply join (List.all_eq_true.mp mass_tests06)
