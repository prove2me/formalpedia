theorem cyc_char (q m : ℕ) [NeZero q] :
    ∃ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      ∀ σ (ζ : AlgebraicClosure ℚ), ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ := by
  haveI : NeZero (q ^ m) := ⟨pow_ne_zero _ (NeZero.ne q)⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) (q ^ m)
  have hσ : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∃ i < q ^ m, ζ₀ ^ i = σ ζ₀ := fun σ =>
    hζ₀.eq_pow_of_pow_eq_one (by rw [← map_pow, hζ₀.pow_eq_one, map_one])
  choose n hn hn' using hσ
  refine ⟨n, fun σ ζ hζ => ?_⟩
  obtain ⟨k, -, rfl⟩ := hζ₀.eq_pow_of_pow_eq_one hζ
  rw [map_pow, ← hn' σ, ← pow_mul, ← pow_mul, mul_comm]

end P2MHybrid

