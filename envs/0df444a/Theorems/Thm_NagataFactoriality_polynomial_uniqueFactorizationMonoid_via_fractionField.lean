set_option autoImplicit false
open NagataFactoriality
open Polynomial
noncomputable section
variable (R : Type*) [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]
variable {R}
variable (R)

theorem NagataFactoriality.polynomial_uniqueFactorizationMonoid_via_fractionField
    [IsNoetherianRing R] : UniqueFactorizationMonoid R[X] := by sorry
