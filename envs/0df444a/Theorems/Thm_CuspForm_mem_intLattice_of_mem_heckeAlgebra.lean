theorem CuspForm.mem_intLattice_of_mem_heckeAlgebra {N : ℕ} [NeZero N] {k : ℤ} (hk : 1 ≤ k) {S : Set ℕ} {t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) k)} (ht : t ∈ CuspForm.heckeAlgebra N k S) {f : CuspForm (CongruenceSubgroup.Gamma0 N) k} (hf : f ∈ CuspForm.intLattice N k) : t f ∈ CuspForm.intLattice N k := by sorry
