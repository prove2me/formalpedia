/-! ## Scale separation

The edges of the walk attached to a pair at scale `m` have length in
`[Δ^m, 2Δ^{m+1}R)` (Step 5). These windows overlap only boundedly. -/

/-! ## The centre count -/

variable {d : ℕ}

theorem QFS.lattice_scaled_ball_finite {s R : ℝ} (hs : 0 < s)
    (u : EuclideanSpace ℝ (Fin d)) :
    {w : EuclideanSpace ℝ (Fin d) | w ∈ lattice d ∧ ‖s • w - u‖ < s * R}.Finite := by sorry
