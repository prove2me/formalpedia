-- title:
--   The binary density statistic is minimal sufficient
-- statement:
--   Let $P$ and $Q$ be probability measures on an arbitrary measurable space $(X,\mathcal A)$, and set $\mu=P+Q$. Choose a measurable $[0,1]$-valued version of the density
--
--   $$T=\frac{dP}{d\mu}.$$
--
--   Then $T$ is a minimal sufficient statistic for $\{P,Q\}$. More precisely, $\sigma(T)$ is sufficient, and each of its events has a version in every other sufficient sub-$\sigma$-algebra that agrees simultaneously $P$-almost everywhere and $Q$-almost everywhere. This is minimality modulo the experiment's common null sets.
-- source:
--   Sufficiency in quantum statistical inference. A survey with examples, arXiv:quant-ph/0604091v1, PDF p. 6, Example 3: binary Radon–Nikodym statistic is minimal sufficient

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P23

noncomputable section

open MeasureTheory

open scoped BigOperators ENNReal NNReal ComplexOrder MatrixOrder Matrix.Norms.L2Operator

namespace QAlgorithms.Papers.Independent.Renew46.P23

open QAlgorithms.Papers.Independent.Next46.P43
  (SufficientSigmaAlgebra MinimalSufficientSigmaAlgebra IsCStarCoarseGraining)

open QAlgorithms.Papers.Independent.Information100.P60 (copies)

open QAlgorithms.Papers.Independent.Dependency50.P28 (relativeEntropy)

attribute [local instance] Classical.propDecidable Classical.decEq

local instance : MeasurableSpace Bool := ⊤

/-- Example 3, PDF p.6: the binary density statistic is minimal sufficient.
Minimality is modulo the common null sets, not literal containment of the
sigma-algebra generated by an arbitrarily chosen derivative version. -/
theorem binaryDensityMinimal
    {X : Type*} [MeasurableSpace X] (P Q : Measure X)
    [IsProbabilityMeasure P] [IsProbabilityMeasure Q] :
    Measurable (binaryDensityStatistic P Q) ∧
    binaryDensityStatistic P Q =ᵐ[P + Q] P.rnDeriv (P + Q) ∧
    MinimalSufficientSigmaAlgebra (fun b : Bool => if b then P else Q)
      (MeasurableSpace.comap (binaryDensityStatistic P Q) (borel ℝ≥0∞)) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P23

end
