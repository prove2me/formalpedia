lemma r1j13_piece_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (ub : ℕ → ℕ → ℕ)
    (hub : ∀ k0 k1 : ℕ, k0 ≤ k1 → ∀ u : ℝ, tk k0 ≤ u → u ≤ tk (k1 + 1) → ω u ≤ (ub k0 k1 : ℝ) / S_scale)
