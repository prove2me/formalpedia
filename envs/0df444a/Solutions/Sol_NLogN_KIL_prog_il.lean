    have h2 : ((rep u).2.1 + 1) ^ 2 ≤ (D + 1) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have h3 : ((rep u).1 + 1) ^ 2 + ((rep u).2.1 + 1) ^ 2 ≤ 2 * (D + 1) ^ 2 := by omega
    refine Nat.add_le_add (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
      (Nat.mul_le_mul_right _ h3))) ?_
    unfold cShift
    gcongr
