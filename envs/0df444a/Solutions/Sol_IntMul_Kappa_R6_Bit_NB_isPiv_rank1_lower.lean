lemma rk_vec_le {a b : ℕ} (u : Fin a → K) (v : Fin b → K) (B : Matrix (Fin a) (Fin b) K)
    (X Y : ℕ) (hB : ∀ (i : Fin a) (j : Fin b), i.val < X → Y ≤ j.val → B i j = u i * v j) :
    rk B X Y ≤ 1 := by
  unfold rk
  have e : B.submatrix (fun r : {r : Fin a // r.val < X} => r.1)
      (fun c : {c : Fin b // Y ≤ c.val} => c.1) =
      vecMulVec (fun r : {r : Fin a // r.val < X} => u r.1)
        (fun c : {c : Fin b // Y ≤ c.val} => v c.1) := by
    ext r c; simp [vecMulVec_apply, hB r.1 c.1 r.2 c.2]
  rw [e]; exact Matrix.rank_vecMulVec_le _ _

lemma one_le_rk {a b : ℕ} (B : Matrix (Fin a) (Fin b) K) {X Y : ℕ} (i : Fin a) (j : Fin b)
    (hi : i.val < X) (hj : Y ≤ j.val) (h : B i j ≠ 0) : 1 ≤ rk B X Y := by
  unfold rk
  refine le_rank_of_det _ (fun _ => (⟨i, hi⟩ : {r : Fin a // r.val < X}))
    (fun _ => (⟨j, hj⟩ : {c : Fin b // Y ≤ c.val})) ?_
  simpa [det_unique] using h

lemma isPiv_rank1_lower_sol_aux {a b : ℕ} (B : Matrix (Fin a) (Fin b) K) (u : Fin a → K) (v : Fin b → K)
    (hB : ∀ (i : Fin a) (j : Fin b), i.val < j.val → B i j = u i * v j)
    (h0 : 0 < a) (hb : 0 < b) (hu : u ⟨0, h0⟩ ≠ 0) (hv : v ⟨b - 1, by omega⟩ ≠ 0)
    (l : ℕ) (hl1 : 1 ≤ l) (hla : l < a) (hlb : l + 1 < b)
    (hT : B ⟨l, hla⟩ ⟨l, by omega⟩ ≠ u ⟨l, hla⟩ * v ⟨l, by omega⟩) : IsPiv B l l := by
  have r1 : ∀ X Y : ℕ, 1 ≤ X → X ≤ Y → Y < b → rk B X Y = 1 := by
    intro X Y h1 h2 h3
    refine le_antisymm (rk_vec_le u v B X Y fun i j hi hj => hB i j (by omega)) ?_
    refine one_le_rk B ⟨0, h0⟩ ⟨b - 1, by omega⟩ (by simp only; omega) (by simp only; omega) ?_
    rw [hB _ _ (by simp only; omega)]
    exact mul_ne_zero hu hv
  have r2 : rk B (l + 1) l = 2 := by
    refine le_antisymm ?_ ?_
    · unfold rk
      have e : B.submatrix (fun r : {r : Fin a // r.val < l + 1} => r.1)
          (fun c : {c : Fin b // l ≤ c.val} => c.1) =
          vecMulVec (fun r : {r : Fin a // r.val < l + 1} => u r.1)
            (fun c : {c : Fin b // l ≤ c.val} => v c.1) +
          vecMulVec (fun r : {r : Fin a // r.val < l + 1} => if r.1.val = l then (1 : K) else 0)
            (fun c : {c : Fin b // l ≤ c.val} =>
              if c.1.val = l then B ⟨l, hla⟩ ⟨l, by omega⟩ - u ⟨l, hla⟩ * v ⟨l, by omega⟩
              else 0) := by
        ext r c
        simp only [submatrix_apply, Matrix.add_apply, vecMulVec_apply]
        have hr := r.2; have hc := c.2
        by_cases hrl : r.1.val = l
        · by_cases hcl : c.1.val = l
          · have e1 : r.1 = ⟨l, hla⟩ := Fin.ext hrl
            have e2 : c.1 = ⟨l, by omega⟩ := Fin.ext hcl
            rw [e1, e2]; simp
          · rw [hB _ _ (by omega)]; simp [hrl, hcl]
        · rw [hB _ _ (by omega)]; simp [hrl]
      rw [e]
      exact (rank_add_le2 _ _).trans (by
        have := Matrix.rank_vecMulVec_le (fun r : {r : Fin a // r.val < l + 1} => u r.1)
            (fun c : {c : Fin b // l ≤ c.val} => v c.1)
        have := Matrix.rank_vecMulVec_le
          (fun r : {r : Fin a // r.val < l + 1} => if r.1.val = l then (1 : K) else 0)
          (fun c : {c : Fin b // l ≤ c.val} =>
            if c.1.val = l then B ⟨l, hla⟩ ⟨l, by omega⟩ - u ⟨l, hla⟩ * v ⟨l, by omega⟩ else 0)
        omega)
    · unfold rk
      refine le_rank_of_det _
        ![(⟨⟨0, h0⟩, by simp only; omega⟩ : {r : Fin a // r.val < l + 1}), ⟨⟨l, hla⟩, by simp⟩]
        ![(⟨⟨l, by omega⟩, le_rfl⟩ : {c : Fin b // l ≤ c.val}), ⟨⟨b - 1, by omega⟩, by simp only; omega⟩]
        ?_
      rw [det_fin_two]
      simp only [submatrix_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [hB ⟨0, h0⟩ ⟨l, by omega⟩ (by simp only; omega),
        hB ⟨0, h0⟩ ⟨b - 1, by omega⟩ (by simp only; omega),
        hB ⟨l, hla⟩ ⟨b - 1, by omega⟩ (by simp only; omega)]
      have : u ⟨0, h0⟩ * v ⟨l, by omega⟩ * (u ⟨l, hla⟩ * v ⟨b - 1, by omega⟩) -
          u ⟨0, h0⟩ * v ⟨b - 1, by omega⟩ * B ⟨l, hla⟩ ⟨l, by omega⟩ =
          u ⟨0, h0⟩ * v ⟨b - 1, by omega⟩ *
            (u ⟨l, hla⟩ * v ⟨l, by omega⟩ - B ⟨l, hla⟩ ⟨l, by omega⟩) := by ring
      rw [this]
      exact mul_ne_zero (mul_ne_zero hu hv) (sub_ne_zero.2 (Ne.symm hT))
  unfold IsPiv
  rw [r2, r1 l (l + 1) hl1 (by omega) hlb, r1 l l hl1 le_rfl (by omega),
    r1 (l + 1) (l + 1) (by omega) le_rfl hlb]

