theorem zsz_le_of_lt {z : ℤ} {m : ℕ} (h : z.natAbs < 2 ^ m) : zsz z ≤ m := length_nbits_le h

theorem natAbs_lt_zsz (z : ℤ) : z.natAbs < 2 ^ zsz z := by
