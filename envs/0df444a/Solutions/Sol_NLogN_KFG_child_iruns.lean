theorem pow_child {m n : ℕ} (h : Fin m) :
    2 ^ (m * n) = 2 ^ (n * (m - 1 - h.val)) * 2 ^ (n * h.val) * 2 ^ n := by
  rw [← pow_add, ← pow_add]; congr 1
  have := h.isLt
  obtain ⟨k, hk⟩ : ∃ k, m = h.val + 1 + k := ⟨m - h.val - 1, by omega⟩
  rw [show m - 1 - h.val = k by omega]
  generalize h.val = H at hk ⊢
  subst hk; ring

end

