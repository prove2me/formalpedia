namespace ScalarComponents
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField

open LanglandsTunnell.CubicInduction.CharacterComponents

private theorem coe_glScalar {R : Type} [CommRing R] (u : Rˣ) :
    ((Matrix.GeneralLinearGroup.scalar (Fin 3) u : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) =
      Matrix.scalar (Fin 3) (u : R) := rfl

private theorem glScalar_mul_comm {R : Type} [CommRing R] (u : Rˣ) (g : GL (Fin 3) R) :
    Matrix.GeneralLinearGroup.scalar (Fin 3) u * g = g * Matrix.GeneralLinearGroup.scalar (Fin 3) u := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, coe_glScalar]
  exact (Matrix.scalar_commute (u : R) (fun r => Commute.all _ r) (g : Matrix (Fin 3) (Fin 3) R)).eq

private theorem centralGen_eq_glScalar (v : HeightOneSpectrum (𝓞 ℚ)) :
    centralGen v = Matrix.GeneralLinearGroup.scalar (Fin 3) (AdelicLevel.uniformizerUnit ℚ v) := by
  apply Units.ext
  rw [coe_glScalar, Matrix.scalar_apply]
  show Matrix.diagonal ![varpi v, varpi v, varpi v] = Matrix.diagonal fun _ => varpi v
  congr 1
  ext i
  fin_cases i <;> rfl

private theorem componentAt3_centralScalarGL (v : HeightOneSpectrum (𝓞 ℚ)) (z : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    componentAt3 (𝓞 ℚ) ℚ v (centralScalarGL 3 (𝓞 ℚ) ℚ z) = Matrix.GeneralLinearGroup.scalar (Fin 3) (unitsAt v z) := by
  apply Units.ext
  rw [coe_glScalar]
  show ((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)).mapMatrix
      (Matrix.scalar (Fin 3) (z : AdeleRing (𝓞 ℚ) ℚ)) = Matrix.scalar (Fin 3) ((unitsAt v z : (v.adicCompletion ℚ)ˣ) :
        v.adicCompletion ℚ)
  rw [RingHom.mapMatrix_apply, Matrix.scalar_apply, Matrix.scalar_apply, Matrix.diagonal_map (map_zero _)]
  rfl

private theorem archComponent3_centralScalarGL (z : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    archComponent3 (𝓞 ℚ) ℚ (centralScalarGL 3 (𝓞 ℚ) ℚ z) =
      Matrix.GeneralLinearGroup.scalar (Fin 3) (unitsAtInfinity z) := by
  apply Units.ext
  rw [coe_glScalar]
  show (AdelicLevel.adeleArch (𝓞 ℚ) ℚ).mapMatrix (Matrix.scalar (Fin 3) (z : AdeleRing (𝓞 ℚ) ℚ)) =
    Matrix.scalar (Fin 3) ((unitsAtInfinity z : (InfiniteAdeleRing ℚ)ˣ) : InfiniteAdeleRing ℚ)
  rw [RingHom.mapMatrix_apply, Matrix.scalar_apply, Matrix.scalar_apply, Matrix.diagonal_map (map_zero _)]
  rfl

private theorem glScalar_mem_localMaximalCompact3_iff (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) :
    Matrix.GeneralLinearGroup.scalar (Fin 3) t ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v ↔ IsIntegralUnit v t := by
  have hinv : (Matrix.GeneralLinearGroup.scalar (Fin 3) t)⁻¹ = Matrix.GeneralLinearGroup.scalar (Fin 3) t⁻¹ :=
    (map_inv (Matrix.GeneralLinearGroup.scalar (Fin 3)) t).symm
  rw [mem_localMaximalCompact3_iff, hinv, coe_glScalar, coe_glScalar, Matrix.scalar_apply, Matrix.scalar_apply]
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
      simpa using h.1 0 0
    · rw [HeightOneSpectrum.mem_adicCompletionIntegers]
      simpa using h.2 0 0
  · intro h
    refine ⟨fun i j => ?_, fun i j => ?_⟩
    · rw [Matrix.diagonal_apply]
      split_ifs
      · exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp h.1
      · rw [map_zero]
        exact zero_le'
    · rw [Matrix.diagonal_apply]
      split_ifs
      · exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp h.2
      · rw [map_zero]
        exact zero_le'

private theorem valued_eq_one_of_isIntegralUnit {v : HeightOneSpectrum (𝓞 ℚ)} {u : (v.adicCompletion ℚ)ˣ}
    (hu : IsIntegralUnit v u) : Valued.v (u : v.adicCompletion ℚ) = 1 := by
  have h1 : Valued.v (u : v.adicCompletion ℚ) ≤ 1 := (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp hu.1
  have h2 : Valued.v ((u⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) ≤ 1 :=
    (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp hu.2
  rw [Units.val_inv_eq_inv_val, map_inv₀] at h2
  have hne : Valued.v (u : v.adicCompletion ℚ) ≠ 0 := (Valuation.ne_zero_iff _).mpr u.ne_zero
  have hpos : (0 : WithZero (Multiplicative ℤ)) < Valued.v (u : v.adicCompletion ℚ) :=
    lt_of_le_of_ne zero_le' (Ne.symm hne)
  exact le_antisymm h1 ((inv_le_one₀ hpos).mp h2)

private theorem isIntegralUnit_of_valued_eq_one {v : HeightOneSpectrum (𝓞 ℚ)} {u : (v.adicCompletion ℚ)ˣ}
    (hu : Valued.v (u : v.adicCompletion ℚ) = 1) : IsIntegralUnit v u := by
  have hinv : Valued.v ((u⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := by
    rw [Units.val_inv_eq_inv_val, map_inv₀, hu, inv_one]
  exact ⟨(HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hu.le,
    (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hinv.le⟩

private theorem exists_isIntegralUnit_mul_uniformizerUnit_zpow
    (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) :
    ∃ (u : (v.adicCompletion ℚ)ˣ) (m : ℤ), IsIntegralUnit v u ∧ t = u * AdelicLevel.uniformizerUnit ℚ v ^ m := by
  have hne : Valued.v (t : v.adicCompletion ℚ) ≠ 0 := (Valuation.ne_zero_iff _).mpr t.ne_zero
  set m : ℤ := WithZero.log (Valued.v (t : v.adicCompletion ℚ))
  have hvt : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp m := (WithZero.exp_log hne).symm
  refine ⟨t * AdelicLevel.uniformizerUnit ℚ v ^ m, -m, isIntegralUnit_of_valued_eq_one ?_, ?_⟩
  · rw [Units.val_mul, Units.val_zpow_eq_zpow_val, map_mul, map_zpow₀, hvt, AdelicLevel.valued_uniformizerUnit,
      ← WithZero.exp_zsmul, ← WithZero.exp_add]
    rw [← WithZero.exp_zero]
    congr 1
    simp
  · rw [zpow_neg, mul_inv_cancel_right]

private def transformingUnits (v : HeightOneSpectrum (𝓞 ℚ)) (W : LocalGL3 v → ℂ) (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) :
    Subgroup (v.adicCompletion ℚ)ˣ where
  carrier := {t | ∀ g : LocalGL3 v, W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = (χv t : ℂ) * W g}
  one_mem' := by
    intro g
    rw [map_one, one_mul, map_one, Units.val_one, one_mul]
  mul_mem' := by
    intro s t hs ht g
    have hs' : ∀ g : LocalGL3 v, W (Matrix.GeneralLinearGroup.scalar (Fin 3) s * g) = (χv s : ℂ) * W g := hs
    have ht' : ∀ g : LocalGL3 v, W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = (χv t : ℂ) * W g := ht
    rw [map_mul, mul_assoc, hs', ht', map_mul, Units.val_mul, mul_assoc]
  inv_mem' := by
    intro t ht g
    have ht' : ∀ g : LocalGL3 v, W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = (χv t : ℂ) * W g := ht
    have h := ht' (Matrix.GeneralLinearGroup.scalar (Fin 3) t⁻¹ * g)
    rw [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul] at h
    rw [h, map_inv χv t, Units.val_inv_eq_inv_val, ← mul_assoc, inv_mul_cancel₀ (χv t).ne_zero, one_mul]

private theorem mem_transformingUnits
    {v : HeightOneSpectrum (𝓞 ℚ)} {W : LocalGL3 v → ℂ} {χv : (v.adicCompletion ℚ)ˣ →* ℂˣ}
    {t : (v.adicCompletion ℚ)ˣ} :
    t ∈ transformingUnits v W χv ↔
      ∀ g : LocalGL3 v, W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = (χv t : ℂ) * W g :=
  Iff.rfl

private theorem apply_glScalar_mul_eq (v : HeightOneSpectrum (𝓞 ℚ)) (W : LocalGL3 v → ℂ)
    (hinv : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ)
    (hχ : ∀ u, IsIntegralUnit v u → χv u = 1)
    (hgen : ∀ g : LocalGL3 v, W (centralGen v * g) = (χv (AdelicLevel.uniformizerUnit ℚ v) : ℂ) * W g)
    (t : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v) :
    W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = (χv t : ℂ) * W g := by
  have hunits : ∀ u, IsIntegralUnit v u → u ∈ transformingUnits v W χv := by
    intro u hu
    rw [mem_transformingUnits]
    intro g
    rw [glScalar_mul_comm, hinv g _ ((glScalar_mem_localMaximalCompact3_iff v u).mpr hu), hχ u hu, Units.val_one,
      one_mul]
  have hϖ : AdelicLevel.uniformizerUnit ℚ v ∈ transformingUnits v W χv := by
    rw [mem_transformingUnits]
    intro g
    rw [← centralGen_eq_glScalar]
    exact hgen g
  obtain ⟨u, m, hu, rfl⟩ := exists_isIntegralUnit_mul_uniformizerUnit_zpow v t
  exact mem_transformingUnits.mp (mul_mem (hunits u hu) (zpow_mem hϖ m)) g

end LanglandsTunnell.CubicInduction.ScalarComponents

