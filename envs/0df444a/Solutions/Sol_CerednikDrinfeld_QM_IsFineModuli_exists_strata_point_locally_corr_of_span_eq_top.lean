    Rigidification.IsPullbackVia f g hE' (pad hΛℤ ρ s t) (pad hΛℤ ρ' s t) := by
  obtain ⟨ub, uA, hub, hubg, huA, huAg, hdd, hsq⟩ := h
  obtain ⟨-, -, huAact, -⟩ := id huA
  refine ⟨ub, uA, hub, hubg, huA, huAg, by simp only [pad, hdd], ?_⟩
  show ub ≫ ρ.φ ≫ ρ.Ab.act _ = (ρ'.φ ≫ ρ'.Ab.act _) ≫ uA
