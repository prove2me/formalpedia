variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem nsmulPt_eq_nsmul (L : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (n : ℕ) (P : SchemeHomOver t f) : nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rw [RelativeGroupLaw.nsmul_zero]; rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, ← ih]; rfl

theorem nsmulPt_mul (L : RelativeGroupLaw R f) (hc : L.IsCommutative) {T : Scheme.{u}}
    (t : T ⟶ Spec (CommRingCat.of R)) (m : ℕ) (x y : SchemeHomOver t f) :
    nsmulPt L t m (L.mul t x y) = L.mul t (nsmulPt L t m x) (nsmulPt L t m y) := by
  induction m with
  | zero => change L.one t = L.mul t (L.one t) (L.one t); rw [L.one_mul]
  | succ m ih =>
      change L.mul t (nsmulPt L t m (L.mul t x y)) (L.mul t x y) =
        L.mul t (L.mul t (nsmulPt L t m x) x) (L.mul t (nsmulPt L t m y) y)
      rw [ih, L.mul_assoc, L.mul_assoc, ← L.mul_assoc t (nsmulPt L t m y) x y, hc t (nsmulPt L t m y) x,
        L.mul_assoc]

theorem mapPt_schemeNsmul (L : RelativeGroupLaw R f) (n : ℕ) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (P : SchemeHomOver t f) :
    mapPt (L.schemeNsmul n) (L.schemeNsmul_over n) P = nsmulPt L t n P := by
  have hP : schemeHomOverComp P.1 P.2 (RelativeGroupLaw.idPoint (f := f)) = P :=
    Subtype.ext (Category.comp_id _)
  have h := L.nsmul_natural f t P.1 P.2 n RelativeGroupLaw.idPoint
  rw [hP] at h
  rw [nsmulPt_eq_nsmul, ← h]
  rfl

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S : Type u} [CommRing S]

theorem isFinite_flat_lfp_surjective_schemeNsmul (E : FakeEllipticCurve Λ N S) {n : ℕ} (hn : 0 < n) :
    IsFinite (E.L.schemeNsmul n) ∧ Flat (E.L.schemeNsmul n) ∧ LocallyOfFinitePresentation (E.L.schemeNsmul n) ∧
      Surjective (E.L.schemeNsmul n) := by
  refine FakeEllipticCurve.isFinite_flat_surjective_of_mapPt_mapPt_eq_nsmulPt E E
    (E.L.schemeNsmul n) (E.L.schemeNsmul_over n) ?_ (𝟙 E.A) (Category.id_comp _) n hn ?_ ?_
  · intro T t P Q
    rw [mapPt_schemeNsmul, mapPt_schemeNsmul, mapPt_schemeNsmul]
    exact nsmulPt_mul E.L E.comm t n P Q
  · intro T t P
    rw [mapPt_schemeNsmul]
    exact Subtype.ext (Category.comp_id _)
  · intro T t Q
    have : mapPt (𝟙 E.A) (Category.id_comp E.f) Q = Q := Subtype.ext (Category.comp_id _)
    rw [this, mapPt_schemeNsmul]

theorem isFinite_flat_lfp_schemeKerStr (E : FakeEllipticCurve Λ N S) {n : ℕ} (hn : 0 < n) :
    IsFinite (E.L.schemeKerStr n) ∧ Flat (E.L.schemeKerStr n) ∧ LocallyOfFinitePresentation (E.L.schemeKerStr n) := by
  obtain ⟨h1, h2, h3, -⟩ := isFinite_flat_lfp_surjective_schemeNsmul E hn
  haveI := h1; haveI := h2; haveI := h3
  exact ⟨inferInstance, inferInstance, inferInstance⟩

