variable {ι : Type*} [Fintype ι]

theorem NLogN.KFM.phase_err (p : ℕ) (e et x : ι → ℂ) (he : ∀ i, ‖e i‖ ≤ 1)
    (het : ∀ i, ‖et i - e i‖ ≤ 2 * hp p) (het1 : ∀ i, ‖et i‖ ≤ 1) (hx : ‖x‖ ≤ 1) :
    ‖QA p (et * x) - e * x‖ ≤ 4 * hp p ∧ ‖QA p (et * x)‖ ≤ ‖x‖ := by sorry
