/-- Gradient inequality for a differentiable convex function. -/
lemma grad_ineq {n : ℕ} (f : (Fin n → ℝ) → ℝ) (hf : Differentiable ℝ f)
    (hfc : ConvexOn ℝ Set.univ f) (a x : Fin n → ℝ) :
    f a + fderiv ℝ f a (x - a) ≤ f x := by
  set v := x - a
  set g : ℝ → ℝ := fun t => f (a + t • v)
  have hg : ConvexOn ℝ Set.univ g := by
    refine ⟨convex_univ, fun s _ t _ p q hp hq hpq => ?_⟩
    have := hfc.2 (Set.mem_univ (a + s • v)) (Set.mem_univ (a + t • v)) hp hq hpq
    simp only [g, smul_eq_mul] at this ⊢
    convert this using 2
    rw [smul_add, smul_add, add_add_add_comm, ← add_smul, hpq, one_smul, smul_smul, smul_smul,
      ← add_smul]
  have hline : HasDerivAt (fun t : ℝ => a + t • v) v 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add a
  have hgd : HasDerivAt g (fderiv ℝ f a v) 0 := by
    have h0 : HasFDerivAt f (fderiv ℝ f a) (a + (0 : ℝ) • v) := by
      simpa using (hf a).hasFDerivAt
    exact h0.comp_hasDerivAt (0 : ℝ) hline
  have hslope := hg.le_slope_of_hasDerivAt (Set.mem_univ 0) (Set.mem_univ 1) zero_lt_one hgd
  simp only [slope, g, vsub_eq_sub, sub_zero, inv_one, one_smul, zero_smul, add_zero, smul_eq_mul,
    one_mul] at hslope
  have h1 : a + v = x := by simp [v]
  rw [h1] at hslope
  linarith

lemma linear_expand {n : ℕ} (L : (Fin n → ℝ) →L[ℝ] ℝ) (v : Fin n → ℝ) :
    L v = ∑ j, v j * L (Pi.single j 1) := by
  conv_lhs => rw [show v = ∑ j, v j • (Pi.single j (1 : ℝ) : Fin n → ℝ) by
    ext k; simp [Finset.sum_apply, Pi.single_apply]]
  simp [map_sum, map_smul]

/-- A small step along a direction that is nonnegative on the zero set stays nonnegative. -/
lemma exists_step {n : ℕ} (x w : Fin n → ℝ) (hx : 0 ≤ x) (hw : ∀ j, ¬ 0 < x j → 0 ≤ w j) :
    ∃ ε : ℝ, 0 < ε ∧ 0 ≤ x + ε • w := by
  classical
  set P := Finset.univ.filter fun j => 0 < x j
  set M := ∑ j, |w j| + 1
  have hM : 0 < M := by positivity
  by_cases hP : P.Nonempty
  · obtain ⟨k, hkP, hkmin⟩ := P.exists_min_image x hP
    have hxk : 0 < x k := by simpa [P] using hkP
    refine ⟨x k / M, div_pos hxk hM, fun l => ?_⟩
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    by_cases hl : 0 < x l
    · have hxl := hkmin l (by simp [P, hl])
      have hwl : |w l| ≤ M := by
        have := Finset.single_le_sum (f := fun j => |w j|) (fun j _ => abs_nonneg _)
          (Finset.mem_univ l)
        linarith
      have h1 : |x k / M * w l| ≤ x k := by
        rw [abs_mul, abs_of_pos (div_pos hxk hM)]
        calc x k / M * |w l| ≤ x k / M * M := by gcongr
          _ = x k := by field_simp
      linarith [neg_abs_le (x k / M * w l)]
    · have := hw l hl
      have := hx l
      simp only [Pi.zero_apply] at this
      nlinarith [div_pos hxk hM]
  · refine ⟨1, one_pos, fun l => ?_⟩
    have hl : ¬ 0 < x l := fun h => hP ⟨l, by simp [P, h]⟩
    have := hw l hl
    have := hx l
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, one_mul] at *
    linarith

end KKTAux

open Matrix MatousekLP.SmallestBall KKTAux FarkasCore in
theorem solution {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ)
    (f : (Fin n → ℝ) → ℝ) (hfc : ConvexOn ℝ Set.univ f) (hf : ContDiff ℝ 1 f)
    (xstar : Fin n → ℝ) (hxstar : MatousekLP.BFS.IsFeasible A b xstar) :
    IsOptimal f A b xstar ↔
      ∃ y : Fin m → ℝ, ∀ j : Fin n,
        (0 < xstar j → fderiv ℝ f xstar (Pi.single j 1) + (y ᵥ* A) j = 0) ∧
        (¬ 0 < xstar j → 0 ≤ fderiv ℝ f xstar (Pi.single j 1) + (y ᵥ* A) j) := by
  classical
  have hdiff : Differentiable ℝ f := hf.differentiable one_ne_zero
  set L := fderiv ℝ f xstar
  set g : Fin n → ℝ := fun j => L (Pi.single j 1)
  constructor
  · rintro ⟨-, hmin⟩
    -- every feasible direction has nonnegative derivative
    have hdir : ∀ w : Fin n → ℝ, A *ᵥ w = 0 → (∀ j, ¬ 0 < xstar j → 0 ≤ w j) → 0 ≤ L w := by
      intro w hAw hwZ
      obtain ⟨ε, hε, hstep⟩ := exists_step xstar w hxstar.2 hwZ
      set F := {x : Fin n → ℝ | MatousekLP.BFS.IsFeasible A b x}
      have hconv : Convex ℝ F := by
        intro p hp q hq s t hs ht hst
        refine ⟨?_, ?_⟩
        · rw [mulVec_add, mulVec_smul, mulVec_smul, hp.1, hq.1, ← add_smul, hst, one_smul]
        · exact add_nonneg (smul_nonneg hs hp.2) (smul_nonneg ht hq.2)
      have hfeas : xstar + ε • w ∈ F :=
        ⟨by rw [mulVec_add, mulVec_smul, hAw, smul_zero, add_zero, hxstar.1], hstep⟩
      have hloc : IsLocalMinOn f F xstar :=
        (show IsMinOn f F xstar from fun x hx => hmin x hx).localize
      have := hloc.hasFDerivWithinAt_nonneg (hdiff xstar).hasFDerivAt.hasFDerivWithinAt
        (mem_posTangentConeAt_of_segment_subset (hconv.segment_subset hxstar hfeas))
      rw [map_smul, smul_eq_mul] at this
      exact nonneg_of_mul_nonneg_right (by linarith) hε
    -- Farkas: `g = -Aᵀ y⁺ + Aᵀ y⁻ + μ` with `μ` supported on the zero set
    set A' : Matrix (Fin n) (Fin m ⊕ Fin m ⊕ Fin n) ℝ := Matrix.of fun j =>
      Sum.elim (fun i => -A i j)
        (Sum.elim (fun i => A i j) (fun k => if j = k ∧ ¬ 0 < xstar k then 1 else 0)) with hA'
    have hF := (farkas_eq_gen A' g).mpr (by
      intro w hw
      have hAw : A *ᵥ w = 0 := by
        funext i
        have h1 := hw (Sum.inl i)
        have h2 := hw (Sum.inr (Sum.inl i))
        simp only [hA', mulVec, dotProduct, transpose_apply, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Pi.zero_apply, neg_mul, Finset.sum_neg_distrib] at h1 h2 ⊢
        have : ∑ j, A i j * w j = ∑ j, A i j * w j := rfl
        linarith
      have hwZ : ∀ j, ¬ 0 < xstar j → 0 ≤ w j := by
        intro j hj
        have := hw (Sum.inr (Sum.inr j))
        simp only [hA', mulVec, dotProduct, transpose_apply, Matrix.of_apply, Sum.elim_inr,
          Pi.zero_apply] at this
        rwa [Finset.sum_eq_single j (fun k _ hk => by simp [hk]) (by simp),
          if_pos ⟨rfl, hj⟩, one_mul] at this
      have := hdir w hAw hwZ
      rw [linear_expand L w] at this
      simpa [dotProduct, g, mul_comm] using this)
    obtain ⟨z, hz0, hz⟩ := hF
    refine ⟨fun i => z (Sum.inl i) - z (Sum.inr (Sum.inl i)), fun j => ?_⟩
    have hj := congrFun hz j
    simp only [hA', mulVec, dotProduct, Matrix.of_apply, Fintype.sum_sum_type, Sum.elim_inl,
      Sum.elim_inr, neg_mul, Finset.sum_neg_distrib] at hj
    have hμ : ∑ k, (if j = k ∧ ¬ 0 < xstar k then (1 : ℝ) else 0) * z (Sum.inr (Sum.inr k)) =
        if ¬ 0 < xstar j then z (Sum.inr (Sum.inr j)) else 0 := by
      rw [Finset.sum_eq_single j (fun k _ hk => by simp [Ne.symm hk]) (by simp)]
      by_cases h : 0 < xstar j <;> simp [h]
    rw [hμ] at hj
    have hyA : (fun i => z (Sum.inl i) - z (Sum.inr (Sum.inl i))) ᵥ* A = fun j =>
        ∑ i, z (Sum.inl i) * A i j - ∑ i, z (Sum.inr (Sum.inl i)) * A i j := by
      funext j; simp [vecMul, dotProduct, sub_mul, Finset.sum_sub_distrib]
    rw [hyA]
    have hsym : ∀ i, A i j * z (Sum.inl i) = z (Sum.inl i) * A i j := fun i => mul_comm _ _
    have hsym' : ∀ i, A i j * z (Sum.inr (Sum.inl i)) = z (Sum.inr (Sum.inl i)) * A i j :=
      fun i => mul_comm _ _
    simp only [hsym, hsym'] at hj
    refine ⟨fun hpos => ?_, fun hnpos => ?_⟩
    · rw [if_neg (not_not.mpr hpos)] at hj
      show g j + _ = 0
      linarith
    · rw [if_pos hnpos] at hj
      show 0 ≤ g j + _
      have := hz0 (Sum.inr (Sum.inr j))
      simp only [Pi.zero_apply] at this
      linarith
  · rintro ⟨y, hy⟩
    refine ⟨hxstar, fun x hx => ?_⟩
    have hgi := grad_ineq f hdiff hfc xstar x
    suffices 0 ≤ L (x - xstar) by linarith
    rw [linear_expand L]
    -- `∑ (x - x*)_j (yA)_j = y ⬝ A (x - x*) = 0`
    have hzero : ∑ j, (x - xstar) j * (y ᵥ* A) j = 0 := by
      have : y ⬝ᵥ (A *ᵥ (x - xstar)) = 0 := by rw [mulVec_sub, hx.1, hxstar.1, sub_self, dotProduct_zero]
      rw [dotProduct_mulVec] at this
      simpa [dotProduct, mul_comm] using this
    have hsum : ∑ j, (x - xstar) j * L (Pi.single j 1) =
        ∑ j, (x - xstar) j * (L (Pi.single j 1) + (y ᵥ* A) j) := by
      simp only [mul_add, Finset.sum_add_distrib, hzero, add_zero]
    rw [hsum]
    refine Finset.sum_nonneg fun j _ => ?_
    by_cases hj : 0 < xstar j
    · rw [(hy j).1 hj, mul_zero]
    · have hx0 : xstar j = 0 := le_antisymm (not_lt.mp hj) (hxstar.2 j)
      have := (hy j).2 hj
      have hxj : (0 : ℝ) ≤ x j := hx.2 j
      simp only [Pi.sub_apply, hx0, sub_zero]
      exact mul_nonneg hxj this
