      have h1 : ((∑ i, (c i : ℤ_[ℓ]) • w i : TateModule ℓ (E.L.AlgPoints E.comm Ω)) : ℕ → E.L.AlgPoints E.comm Ω) n = ∑ i, (c i) • (w i : ℕ → E.L.AlgPoints E.comm Ω) n := by
