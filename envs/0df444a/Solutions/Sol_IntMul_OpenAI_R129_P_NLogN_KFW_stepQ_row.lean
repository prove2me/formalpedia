  have hne : ∀ p ∈ vl, p.1 ≠ 0 := by
    intro p hp h
    apply h0
    rw [← hfst]
    exact List.mem_map.2 ⟨p, hp, h⟩
  have hag : Agree σ (NLogN.KIL.encK s f) := agree_clean0 hσ0 (hQσ s hq) hC
  have S1 := Sp.pushSeq pl vl σ cp hP (NLogN.KIL.encK s f) hag
  rw [encK_pushSt s f vl (fun p hp => hC p.1 (hne p hp))] at S1
