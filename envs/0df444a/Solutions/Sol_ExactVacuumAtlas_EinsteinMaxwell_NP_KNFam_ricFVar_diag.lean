theorem eq_of_hasDerivAt_sliceR {W : Set (ℝ × Pt 4)} (hW : IsOpen W) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
    {φ ψ : ℝ → ℝ} {L L' : ℝ} (hφ : HasDerivAt φ L 0) (hψ : HasDerivAt ψ L' 0)
    (h : ∀ ε, (ε, x) ∈ W → φ ε = ψ ε) : L = L' := by
