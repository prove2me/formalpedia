        (Spec.map (CommRingCat.ofHom (χa.toRingHom.comp (algebraMap Pet.B₀ CQ))))).1 := by
    intro h0
    have hcompψ : χa.toRingHom.comp (algebraMap Pet.B₀ CQ) = ψet.toRingHom := RingHom.ext hχψ
    have key : ∀ {t t' : base (T := k) ⟶ Spec (CommRingCat.of Pet.B₀)} (_ : t = t'),
