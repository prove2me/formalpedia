theorem solution (R : Type) [CommRing R] (t x : R) :
    ∃ e : TypeDensity.ExceptionalChartLevel R t x 1 ≃+* Polynomial (R ⧸ Ideal.span {t,x}),
        (∀ r : R, e (TypeDensity.levelBase R t x 1 r) = Polynomial.C (Ideal.Quotient.mk (Ideal.span {t,x}) r)) ∧
        e (TypeDensity.levelSlope R t x 1) = Polynomial.X := by
  set I : Ideal R := Ideal.span {t, x}
  have ht : Ideal.Quotient.mk I t = 0 := Ideal.Quotient.eq_zero_iff_mem.2
      (Ideal.subset_span (by simp))
  have hx : Ideal.Quotient.mk I x = 0 := Ideal.Quotient.eq_zero_iff_mem.2
      (Ideal.subset_span (by simp))
  let f0 : Polynomial R →+* Polynomial (R ⧸ I) := Polynomial.mapRingHom (Ideal.Quotient.mk I)
  have hf0 : ∀ a ∈ Ideal.span {TypeDensity.blowupRelation R t x}, f0 a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 ha
    simp [f0, TypeDensity.blowupRelation, ht, hx]
  let f1 : TypeDensity.BlowupChart R t x →+* Polynomial (R ⧸ I) := Ideal.Quotient.lift _ f0 hf0
  have hf1 : ∀ a ∈ TypeDensity.exceptionalLevelIdeal R t x 1, f1 a = 0 := by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 ha
    simp [f1, f0, TypeDensity.chartBase, ht]
  let F : TypeDensity.ExceptionalChartLevel R t x 1 →+* Polynomial (R ⧸ I) := Ideal.Quotient.lift _ f1 hf1
  have hbt : TypeDensity.levelBase R t x 1 t = 0 := by
    simp only [TypeDensity.levelBase, RingHom.comp_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span (by simp))
  have hbx : TypeDensity.levelBase R t x 1 x = 0 := by
    simp only [TypeDensity.levelBase, RingHom.comp_apply, ← TypeDensity.blowup_chart_relation R t x, map_mul]
    have h := hbt
    simp only [TypeDensity.levelBase, RingHom.comp_apply] at h
    rw [h]; exact zero_mul (M₀ := TypeDensity.ExceptionalChartLevel R t x 1) _
  have hb : ∀ a ∈ I, TypeDensity.levelBase R t x 1 a = 0 := fun a ha ↦
    (show I ≤ RingHom.ker (TypeDensity.levelBase R t x 1) from
      Ideal.span_le.2 (by rintro y (rfl | rfl); exacts [hbt, hbx])) ha
  let g0 : R ⧸ I →+* TypeDensity.ExceptionalChartLevel R t x 1 := Ideal.Quotient.lift I (TypeDensity.levelBase R t x 1) hb
  let G : Polynomial (R ⧸ I) →+* TypeDensity.ExceptionalChartLevel R t x 1 := Polynomial.eval₂RingHom g0
      (TypeDensity.levelSlope R t x 1)
  have hFb : ∀ r : R, F (TypeDensity.levelBase R t x 1 r) = Polynomial.C (Ideal.Quotient.mk I r) := by
    intro r; simp [F, f1, f0, TypeDensity.levelBase, TypeDensity.chartBase]
  have hFs : F (TypeDensity.levelSlope R t x 1) = Polynomial.X := by
    simp [F, f1, f0, TypeDensity.levelSlope, TypeDensity.chartSlope]
  have hGF : G.comp F = RingHom.id _ := by
    refine Ideal.Quotient.ringHom_ext <| Ideal.Quotient.ringHom_ext <| Polynomial.ringHom_ext ?_ ?_
    · intro r
      change G (F (TypeDensity.levelBase R t x 1 r)) = TypeDensity.levelBase R t x 1 r
      rw [hFb]; simp [G, g0]
    · change G (F (TypeDensity.levelSlope R t x 1)) = TypeDensity.levelSlope R t x 1
      rw [hFs]; simp [G]
  have hFG : F.comp G = RingHom.id _ := by
    apply Polynomial.ringHom_ext
    · intro r
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
      simp [G, g0, hFb]
    · simp [G, hFs]
  exact ⟨RingEquiv.ofRingHom F G hFG hGF, hFb, hFs⟩
