namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

section line

variable {U : Set (Pt n)} {g gi h : Metric n} {F f : TwoForm n}

theorem contDiffOn_lineMetric (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
    (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (i j : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => lineMetric g h p.1 i j p.2) {p | p.2 ∈ U} :=
  ((hg i j).comp contDiffOn_snd fun _ hp => hp).add
    (contDiffOn_fst.mul ((hh i j).comp contDiffOn_snd fun _ hp => hp))

theorem isOpen_lineDom (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
    (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) : IsOpen (lineDom U g h) := by
  have hS : IsOpen {p : ℝ × Pt n | p.2 ∈ U} := hU.preimage continuous_snd
  have hdet : ContinuousOn (fun p : ℝ × Pt n => (metricMatrix (lineMetric g h p.1) p.2).det) {p | p.2 ∈ U} :=
    (contDiffOn_det_of (A := fun p : ℝ × Pt n => metricMatrix (lineMetric g h p.1) p.2)
      fun i j => contDiffOn_lineMetric hg hh i j).continuousOn
  exact hdet.isOpen_inter_preimage hS (isOpen_compl_singleton (x := (0 : ℝ)))

end line

