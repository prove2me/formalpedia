-- title:
--   Taylor varieties are characterized by cyclic terms
-- statement:
--   $L$ is a signature without relation symbols and $A$ a finite idempotent algebra ($f(a,\dots,a)=a$ for every basic operation), so the variety $V(A)$ generated by $A$ is idempotent and satisfies exactly the identities of $A$. The following are equivalent: (1) $V(A)$ is a Taylor variety, i.e. $A$ satisfies the identities of some Taylor term ($t$ of arity $k$ with, for each $j<k$, $t(\square)\approx t(\triangle)$, $\square,\triangle\in\{x,y\}^k$, $\square_j=x$, $\triangle_j=y$); (2) $A$ has a cyclic term operation of some arity $k\ge2$ (an idempotent term operation with $t(x_0,\dots,x_{k-1})=t(x_1,\dots,x_{k-1},x_0)$); (3) $A$ has a cyclic term operation of arity $p$ for every prime $p>|A|$.
-- source:
--   L. Barto, M. Kozik, Absorbing subalgebras, cyclic terms, and the constraint satisfaction problem, Logical Methods in Computer Science 8(1:07) 2012, https://doi.org/10.2168/LMCS-8(1:7)2012 (arXiv:1201.0557), Thm 4.1

import Definitions.Def_BKAbsorption_defs

universe u v w w'

open FirstOrder FirstOrder.Language

namespace BKAbsorption

variable {L : FirstOrder.Language.{u, v}} [L.IsAlgebraic]

/-- Barto–Kozik, Theorem 4.1.  Let `A` be a finite idempotent algebra (so the variety `V(A)` it
generates is idempotent and satisfies exactly the identities of `A`).  The following are
equivalent:
* `V(A)` is a Taylor variety, i.e. `A` satisfies the identities of some Taylor term;
* `A` has a cyclic term operation (of some arity `k ≥ 2`);
* `A` has a cyclic term operation of arity `p` for every prime `p > |A|`. -/
theorem taylor_iff_cyclic {A : Type w} [L.Structure A] [Finite A] (hid : IsIdempotent L A) :
    ((∃ T : TaylorDatum L, IsTaylorAlg T A) ↔ ∃ k : ℕ, 2 ≤ k ∧ HasCyclicTermOp L A k) ∧
    ((∃ k : ℕ, 2 ≤ k ∧ HasCyclicTermOp L A k) ↔
      ∀ p : ℕ, p.Prime → Nat.card A < p → HasCyclicTermOp L A p) := by sorry

end BKAbsorption
