  apply Real.exp_le_exp.mpr
  have hK := h4_eKz_ge S T hS hST l h
  rw [hk] at hK
  have hK' : ((S : ℝ)) ^ 2 * (((k + w + 1 : ℕ) : ℝ) * (((k + w + 1 : ℕ) : ℝ) - 1)) ≤ (eKz S T l h : ℝ) := by
    exact_mod_cast hK
  have hS2 : (0 : ℝ) < (S : ℝ) ^ 2 := by positivity
  have hdiv : (((k + w + 1 : ℕ) : ℝ) * (((k + w + 1 : ℕ) : ℝ) - 1)) ≤ (eKz S T l h : ℝ) / (S : ℝ) ^ 2 := by
    rw [le_div_iff₀ hS2]; linarith
  have hA' : (2 : ℝ) ≤ A := by exact_mod_cast hA
  have hpa : (1 : ℝ) ≤ π * (A : ℝ) ^ 2 := by nlinarith [Real.pi_gt_three]
  push_cast at hdiv
  have hkk : (w : ℝ) * (w + 1) + k ≤ ((k : ℝ) + w + 1) * ((k : ℝ) + w + 1 - 1) := by
    have : (0:ℝ) ≤ k := by positivity
    have : (0:ℝ) ≤ w := by positivity
    nlinarith
  have hk0 : (0 : ℝ) ≤ k := by positivity
  have e : π * (A : ℝ) ^ 2 * (eKz S T l h : ℝ) / (S : ℝ) ^ 2 = π * (A : ℝ) ^ 2 * ((eKz S T l h : ℝ) / (S : ℝ) ^ 2) := by ring
  rw [e]
  have hpa0 : (0 : ℝ) ≤ π * (A : ℝ) ^ 2 := by linarith
  have := mul_le_mul_of_nonneg_left (hkk.trans hdiv) hpa0
