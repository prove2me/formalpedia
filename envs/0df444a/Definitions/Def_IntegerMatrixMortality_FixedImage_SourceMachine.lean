def U2 (q : ℕ) : MachineInstruction := if q = 0 then .halt else u2Table[q-1]?.getD .halt

def U (q : ℕ) : MachineInstruction := mapInstruction mergeState (U2 (mergeState q))

def uStates : Finset ℕ := ((Finset.range 278).image (fun q => mergeState (q + 1)))

def instructionCounts (M : TwoCounterMachine) (states : Finset ℕ) : ℕ × ℕ × ℕ × ℕ :=
  (((states.sort (· ≤ ·)).filter (fun q => match M q with | .inc .zero _ => true | _ => false)).length,
   ((states.sort (· ≤ ·)).filter (fun q => match M q with | .inc .one _ => true | _ => false)).length,
   ((states.sort (· ≤ ·)).filter (fun q => match M q with | .dec .zero _ _ => true | _ => false)).length,
   ((states.sort (· ≤ ·)).filter (fun q => match M q with | .dec .one _ _ => true | _ => false)).length)

