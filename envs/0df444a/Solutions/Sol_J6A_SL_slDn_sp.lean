theorem popL_sp (K : KS) (T W : List ℤ) (hT : Bnd Bb T) (hM : zsz (T.length : ℤ) ≤ Bb) :
    Sp (.rep 31 (.lit T.length) (.pop 14)) (encK s (toF {K with w := T ++ W, k1 := []}))
      (encK s (toF {K with w := W, k1 := []}))
      ((1 + 1) * 2000 * (Bb + 2) + T.length * ((2 * Bb + 2) + 8000 * (Bb + 2) + 30) + 32) := by
  have H := Sp.rep (C := 31) (n := .lit (T.length : ℤ)) (b := .pop 14) (s := s)
    (F := fun k => toF {K with w := T.drop k ++ W, k1 := []})
    (N := T.length) (B := Bb) (c := 2 * Bb + 2) (by decide) (fun _ => rfl) (by decide)
    (clean_lit _) trivial trivial hM rfl (fun k hk => by
      rw [upd_k1, upd_k1]
      dsimp only
      have hd := List.drop_eq_getElem_cons hk
      have := Sp.pop (i := 14) s (toF {K with w := T.drop k ++ W, k1 := [(T.length : ℤ) - k]})
        (a := T[k]) (l := T.drop (k + 1) ++ W) (B := Bb) (by decide)
        (by show T.drop k ++ W = _; rw [hd]; rfl) (hT _ (List.getElem_mem hk))
      rw [upd_w] at this
      exact this)
  simpa [Ex.size] using H

