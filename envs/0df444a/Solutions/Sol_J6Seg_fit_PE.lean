set_option maxHeartbeats 1000000 in
set_option linter.unusedVariables false in
theorem fit_PE_sol_aux (p d s t α lam : ℕ) [NeZero s] [NeZero t] (hst : s < t)
    (hcop : Nat.Coprime s t) (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx3 : 3 * s ≤ α ^ 2 * (t - s))
    (hd : 2 ≤ d) (h6d : 6 * d ^ 2 ≤ s) (h48 : 48 ≤ α ^ 2) (hpα : p < 48 * d * (α + 1) ^ 2)
    (hθ : 3 * d ^ 2 * (t - s) ≤ s) (h48d : 48 * d * α ^ 2 ≤ p) (hp : 100 ≤ p)
    (hl1 : 1 ≤ lam) (hlF : lam ≤ lamF d) (hDle' : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ (p / 7)) :
    1000 * fullG lam (wF d) s t α (1 / 2) ≤ 2 ^ segPF p d s ∧
      200 * segE p (segPF p d s) lam (wF d) s t α ≤ 2 ^ p ∧
      segE p (segPF p d s) lam (wF d) s t α ≤ 3 := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  obtain ⟨hk1, hk2⟩ := kF_sq d (by omega)
  set k := kF d with hkdef
  have hk0 : 1 ≤ k := by rw [hkdef]; unfold kF; omega
  have hlam : lamF d = d * k := rfl
  have hw : wF d = 7 * k := rfl
  have hws : wF d ≤ s := by
    rw [hw]
    have : k ≤ d + 1 := by nlinarith
    nlinarith
  -- `D_{λ-1} ≤ 2^R`
  obtain ⟨R, hR⟩ : ∃ R, R = p / 7 := ⟨_, rfl⟩
  have hR7 : (p : ℝ) - 6 ≤ 7 * R := by
    have : p ≤ 7 * R + 6 := by rw [hR]; omega
    have : (p : ℝ) ≤ 7 * R + 6 := by exact_mod_cast this
    linarith
  have hDle : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R := by rw [hR]; exact hDle'
  -- the budget
  obtain ⟨N, hN⟩ : ∃ N, N = NF d s := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K, K = Nat.size N := ⟨_, rfl⟩
  have hNR : (N : ℝ) < 2 ^ K := by
    have hNK : N < 2 ^ K := hK ▸ Nat.lt_size_self N
    exact_mod_cast hNK
  have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg _
  have hPdef : segPF p d s = p + 1 + R + K := by rw [hK, hN, hR]; rfl
  have hD1 : 1 ≤ ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) :=
    one_le_ddR (sigma_ge hs hst.le) _
  have hG : 1000 * fullG lam (wF d) s t α (1 / 2) ≤
      ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * N := by
    have hD0 : 0 ≤ ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) := by linarith
    have hlR : (lam : ℝ) ≤ (lamF d : ℝ) := by exact_mod_cast hlF
    have hl0 : (0 : ℝ) ≤ lam := Nat.cast_nonneg _
    have h1 : ((lam : ℝ) + 1) * (3 * lam + 3) + 1 ≤ ((lamF d : ℝ) + 1) * (3 * lamF d + 3) + 1 := by
      nlinarith
    have h2 : (((lam : ℝ) + 1) * (3 * lam + 3) + 1) * ((lam : ℝ) + 1) ≤
        (((lamF d : ℝ) + 1) * (3 * lamF d + 3) + 1) * ((lamF d : ℝ) + 1) :=
      mul_le_mul h1 (by linarith) (by positivity) (by positivity)
    calc 1000 * fullG lam (wF d) s t α (1 / 2)
        = ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * (1500 * ((((lam : ℝ) + 1) * (3 * lam + 3) + 1) *
          ((lam : ℝ) + 1)) * ((2 * ((wF d : ℕ) : ℝ) + 1) * ((s : ℝ) + 1) ^ 2)) := by
          unfold fullG; ring
      _ ≤ ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * (1500 * ((((lamF d : ℝ) + 1) *
          (3 * lamF d + 3) + 1) * ((lamF d : ℝ) + 1)) * ((2 * ((wF d : ℕ) : ℝ) + 1) *
            ((s : ℝ) + 1) ^ 2)) := by gcongr
      _ = ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * N := by rw [hN]; unfold NF; push_cast; ring
  have hpR : (0 : ℝ) < 2 ^ p := by positivity
  have h2P : (2 : ℝ) ^ segPF p d s = 2 ^ p * 2 * (2 ^ R * 2 ^ K) := by
    rw [hPdef, pow_add, pow_add, pow_succ]; ring
  have hDN : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * N ≤ 2 ^ R * 2 ^ K := by
    calc ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * N ≤ 2 ^ R * N :=
          mul_le_mul_of_nonneg_right hDle hN0
      _ ≤ 2 ^ R * 2 ^ K := mul_le_mul_of_nonneg_left hNR.le (by positivity)
  have hRK : (0 : ℝ) < 2 ^ R * 2 ^ K := by positivity
  have hP : 1000 * fullG lam (wF d) s t α (1 / 2) ≤ 2 ^ segPF p d s := by
    refine hG.trans ?_
    rw [h2P]
    have : (1 : ℝ) ≤ 2 ^ p * 2 := by
      have := one_le_pow₀ (n := p) (by norm_num : (1 : ℝ) ≤ 2); linarith
    have h2 : (2 : ℝ) ^ R * 2 ^ K ≤ 2 ^ p * 2 * (2 ^ R * 2 ^ K) := le_mul_of_one_le_left hRK.le this
    linarith
  -- the Gaussian tail
  have hα7 : 7 ≤ α := by nlinarith
  have hkeyN : 49 * p ≤ 3072 * d * α ^ 2 := by
    have h1 : 49 * (α + 1) ^ 2 ≤ 64 * α ^ 2 := by nlinarith
    have h2 : 49 * (48 * d * (α + 1) ^ 2) ≤ 48 * d * (64 * α ^ 2) := by
      have := Nat.mul_le_mul_left (48 * d) h1; nlinarith
    nlinarith
  have hkeyR : (49 : ℝ) * p ≤ 3072 * d * α ^ 2 := by exact_mod_cast hkeyN
  have hww : (49 : ℝ) * d ≤ ((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1) := by
    have h1 : 49 * d ≤ wF d * wF d := by rw [hw]; nlinarith
    have h2 : (49 * d : ℝ) ≤ ((wF d * wF d : ℕ) : ℝ) := by exact_mod_cast h1
    push_cast at h2
    have : (0 : ℝ) ≤ ((wF d : ℕ) : ℝ) := Nat.cast_nonneg _
    nlinarith
  have hx2 : 2 * (p : ℝ) ≤ π * (α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1)) := by
    have hπ := Real.pi_gt_three
    have hα0 : (0 : ℝ) ≤ (α : ℝ) ^ 2 := by positivity
    have hdα : (0 : ℝ) ≤ (d : ℝ) * (α : ℝ) ^ 2 := by positivity
    have h1 : (α : ℝ) ^ 2 * (49 * d) ≤ (α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left hww hα0
    have h2 : 3 * ((α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))) ≤
        π * ((α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))) :=
      mul_le_mul_of_nonneg_right hπ.le (by positivity)
    have e : π * (α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1)) =
        π * ((α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))) := by ring
    rw [e]; nlinarith
  have hexp : 2 ^ p * (18 * Real.exp (-(π * (α : ℝ) ^ 2 *
      (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))))) ≤ 1 := by
    have h1 : Real.exp (-(π * (α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1)))) ≤
        Real.exp (-(2 * (p : ℝ))) := Real.exp_le_exp.2 (by linarith)
    have h2 : (3 : ℝ) ^ p ≤ Real.exp (2 * (p : ℝ)) := by
      have : (3 : ℝ) ≤ Real.exp 2 := by have := Real.add_one_le_exp 2; linarith
      calc (3 : ℝ) ^ p ≤ Real.exp 2 ^ p := pow_le_pow_left₀ (by norm_num) this p
        _ = Real.exp (2 * (p : ℝ)) := by rw [← Real.exp_nat_mul]; ring_nf
    have h3 : (18 : ℝ) * 2 ^ p ≤ 3 ^ p := by exact_mod_cast pow_three_ge p (by omega)
    have h4 : Real.exp (-(2 * (p : ℝ))) = (Real.exp (2 * (p : ℝ)))⁻¹ := Real.exp_neg _
    have h5 : 0 < Real.exp (2 * (p : ℝ)) := Real.exp_pos _
    rw [h4] at h1
    have h6 : 2 ^ p * (18 * Real.exp (-(π * (α : ℝ) ^ 2 *
        (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))))) ≤
        2 ^ p * (18 * (Real.exp (2 * (p : ℝ)))⁻¹) := by gcongr
    refine h6.trans ?_
    rw [← mul_assoc, mul_comm _ (18 : ℝ), ← div_eq_mul_inv, div_le_one h5]
    linarith
  have hE3 : segE p (segPF p d s) lam (wF d) s t α ≤ 3 := by
    unfold segE
    have hfrac : 2 ^ p * (60 * fullG lam (wF d) s t α (1 / 2) / 2 ^ segPF p d s) ≤ 1 := by
      rw [h2P]
      have e : 2 ^ p * (60 * fullG lam (wF d) s t α (1 / 2) / (2 ^ p * 2 * (2 ^ R * 2 ^ K))) =
          60 * fullG lam (wF d) s t α (1 / 2) / (2 * (2 ^ R * 2 ^ K)) := by
        field_simp
      rw [e, div_le_one (by positivity)]
      linarith
    have e2 : 2 ^ p * (60 * fullG lam (wF d) s t α (1 / 2) / 2 ^ segPF p d s +
        3 * (4 * Real.exp (-(π * (α : ℝ) ^ 2 * (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))))) *
          (1 / 2 + 1)) =
        2 ^ p * (60 * fullG lam (wF d) s t α (1 / 2) / 2 ^ segPF p d s) +
        2 ^ p * (18 * Real.exp (-(π * (α : ℝ) ^ 2 *
          (((wF d : ℕ) : ℝ) * (((wF d : ℕ) : ℝ) + 1))))) := by ring
    rw [e2]; linarith
  have hp2 : (1024 : ℝ) ≤ 2 ^ p := by
    have : (2 : ℝ) ^ 10 ≤ 2 ^ p := pow_le_pow_right₀ (by norm_num) (by omega)
    norm_num at this; linarith
  have hE : 200 * segE p (segPF p d s) lam (wF d) s t α ≤ 2 ^ p := by linarith
  exact ⟨hP, hE, hE3⟩

