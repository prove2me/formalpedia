theorem pdM_comp {V : Set (Pt n)} (hV : IsOpen V) {B : Pt n → Matrix (Fin n) (Fin n) ℝ}
    (hB : SmoothOn B V) {Φ : Pt n → Pt n} {J : Pt n → Matrix (Fin n) (Fin n) ℝ} {y : Pt n}
