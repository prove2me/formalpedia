abbrev aO : Fin HS := 45
abbrev aK2 : Fin HS := 46
abbrev aP : Fin HS := 48
abbrev aWd : Fin HS := 51
abbrev aBe : Fin HS := 52

/-- Relocation of `sapP`. -/
def σS : Equiv.Perm (Fin HS) :=
  swapsPerm [(21, 33), (30, 34), (13, 35), (14, 36), (15, 37), (16, 38), (6, 39), (8, 40), (9, 41)]

/-- The `sapL` slice program: `sapP` in place on `aI`, then transfer to `aO`. -/
def sapSlP : RM := .seq (RM.ren σS sapP) (xferP aI aO (cnt2 aT))

