variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) {x : Pt 5}
    (hx : x ∈ esDomain I)
    (hEin : ∀ i j, einsteinMaxwellD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) i j x = 0)
    (k : Fin 5 → ℝ) :
    contract2 (ricciOf (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
        (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)) x k +
      (fieldSq (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) x / 3 +
        2 * alphaSq f m N w p a (x 1)) *
        contract2 (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x k =
      nullSOS f m N w p a x k := by
  obtain ⟨hf, hD, hA, hH, hu, hv⟩ := frame_factors_ne hP hx
  have hric := ricci_contract2 hP.toESData hx hEin k
  have hee : deriv p (x 1) + w (x 1) * deriv a (x 1) = eFun w p a (x 1) := rfl
  rw [hee] at hric
  have hsos := frame_sum_of_squares hf hD hA hH hu hv (eFun w p a (x 1)) (deriv a (x 1))
    (a (x 1)) (frameInv w x k)
  have hq := contract2_esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w x k
  have hframe := alphaSq_eq_frame w p a (hP.nf _ hx.1) (hP.nm _ hx.1) (hP.nN _ hx.1)
  rw [← hframe] at hsos
  rw [hric, hq]
  simp only [nullSOS, coeff0, coeff2, coeff4, resL, betaSq]
  linear_combination 2 * hsos
