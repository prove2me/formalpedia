theorem flat_stalkMap_at
    {r r' : ℕ} [Fact r.Prime] [Fact r'.Prime] (hrr' : r' ≠ r) (hB : IsIndefiniteRamifiedExactlyAt a b r r')
    (hΛ : IsMaximalOrder Λ) [NeZero N] (hm : 3 ≤ m)
    {M₀ : Scheme.{0}} {π₀ : M₀ ⟶ Spec (CommRingCat.of (Zaway N m))}
    {ptF₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Zaway N m))),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s π₀}
    (hM₀ : IsFineModuli Λ N m M₀ π₀ ptF₀) (x : M₀) (hx : ((r : ℕ) : Zaway N m) ∈ (π₀ x).asIdeal) :
    (π₀.stalkMap x).hom.Flat := by
  haveI : IsDedekindDomain (Zaway N m) := isDedekindDomain_Zaway N m hm

  have hrNm : ¬ r ∣ N * m := by
    intro hdvd
    have hu : IsUnit ((r : ℕ) : Zaway N m) := by
      have h := isUnit_natCast_NM N m
      rw [← Nat.cast_mul] at h
      exact isUnit_of_dvd_unit (Nat.cast_dvd_cast hdvd) h
    exact (π₀ x).isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
  have hrN : ¬ r ∣ N := fun h => hrNm (h.mul_right m)
  have hrm : ¬ r ∣ m := fun h => hrNm (h.mul_left N)

  have hr2 : ¬ r ∣ 2 := by
    intro hdvd
    have hu : IsUnit ((r : ℕ) : Zaway N m) := isUnit_of_dvd_unit (Nat.cast_dvd_cast hdvd) (isUnit_natCast_two N m)
    exact (π₀ x).isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
  have hN' : IsUnit ((N : ℕ) : ℤ_[r]) := isUnit_natCast_padicInt hrN
  have hm' : IsUnit ((m : ℕ) : ℤ_[r]) := isUnit_natCast_padicInt hrm
  have h2' : IsUnit ((2 : ℕ) : ℤ_[r]) := isUnit_natCast_padicInt hr2

  have hr3 : ¬ r ∣ 3 := by
    intro hdvd
    have hu : IsUnit ((r : ℕ) : Zaway N m) := isUnit_of_dvd_unit (Nat.cast_dvd_cast hdvd) (isUnit_natCast_three N m)
    exact (π₀ x).isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hu)
  have h3' : IsUnit ((3 : ℕ) : ℤ_[r]) := isUnit_natCast_padicInt hr3
  let β : Zaway N m →+* ℤ_[r] := toRing N m ℤ_[r] hN' hm' h2' h3'
  have hβinj : Function.Injective β := toRing_injective N m hm ℤ_[r] hN' hm' h2' h3'
  have hβf : β.Flat := ringHom_flat_of_injective β hβinj
  haveI hβflat : Flat (Spec.map (CommRingCat.ofHom β)) := Flat.SpecMap_iff.mpr hβf

  obtain ⟨ptF', hM', -⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isFineModuli_of_isPullback β hM₀
      (pullback.snd π₀ (Spec.map (CommRingCat.ofHom β))) (pullback.fst π₀ (Spec.map (CommRingCat.ofHom β)))
      (IsPullback.of_hasPullback π₀ (Spec.map (CommRingCat.ofHom β)))
  haveI : Flat (pullback.snd π₀ (Spec.map (CommRingCat.ofHom β))) :=
    CerednikDrinfeld.QM.IsFineModuli.flat_padicInt_of_isUnit_of_isUnit_two_of_isUnit_three hrr' hB Λ hΛ N m hm hN' hm' h2' h3' hM'

  refine flat_stalkMap_of_flat_pullback π₀ (Spec.map (CommRingCat.ofHom β)) x
    ⟨⟨IsLocalRing.maximalIdeal ℤ_[r], inferInstance⟩, ?_⟩
  apply PrimeSpectrum.ext
  rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, CommRingCat.hom_ofHom]
  refine ideal_eq_of_natPrime_mem N m (Fact.out : r.Prime) _ _ ?_ hx
  rw [Ideal.mem_comap, map_natCast]
  change ((r : ℕ) : ℤ_[r]) ∈ IsLocalRing.maximalIdeal ℤ_[r]
  rw [PadicInt.maximalIdeal_eq_span_p]
  exact Ideal.mem_span_singleton_self _

theorem isUnit_natCast_of_algebra {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (n : ℕ)
    (h : IsUnit ((n : ℕ) : R)) : IsUnit ((n : ℕ) : S) := by
  have h' := h.map (algebraMap R S)
  rwa [map_natCast] at h'

theorem isUnit_natCast_localizationAway {R : Type*} [CommRing R] (n : ℕ) :
    IsUnit ((n : ℕ) : Localization.Away ((n : ℕ) : R)) := by
  have h := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away ((n : ℕ) : R)) ((n : ℕ) : R)
  rwa [map_natCast] at h

abbrev ZawayDisc (q q' N m : ℕ) : Type := Localization.Away ((q * q' : ℕ) : Zaway N m)

theorem flatAway_of_isUnit_two_of_isUnit_three
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N m : ℕ) [NeZero N] (hm : 3 ≤ m)
    (𝒪 : Type) [CommRing 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪))
    (h2 : IsUnit ((2 : ℕ) : 𝒪)) (h3 : IsUnit ((3 : ℕ) : 𝒪))
    (hqq'u : IsUnit ((q * q' : ℕ) : 𝒪))
    {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of 𝒪)}
    {ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM}
    (hM : IsFineModuli Λ N m M πM ptF) :
    Flat πM := by
  obtain ⟨M', π', ptF', hM', -, -, -, -, hsm⟩ :=
    CerednikDrinfeld.QM.exists_isFineModuli_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm 𝒪 hN hm' h2 h3
  have hsm' : SmoothOfRelativeDimension 1 π' := hsm hqq'u
  obtain ⟨e, he, -, -⟩ := CerednikDrinfeld.QM.IsFineModuli.exists_iso_of_isFineModuli Λ N m hM hM'
  have hsmM : SmoothOfRelativeDimension 1 πM := by
    rw [← he]
    exact (MorphismProperty.cancel_left_of_respectsIso (@SmoothOfRelativeDimension 1) e.hom _).mpr hsm'
  haveI : Smooth πM := hsmM.smooth
  infer_instance

theorem flat_stalkMap_away
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (hΛ : IsMaximalOrder Λ) [NeZero N] (hm : 3 ≤ m)
    {M₀ : Scheme.{0}} {π₀ : M₀ ⟶ Spec (CommRingCat.of (Zaway N m))}
    {ptF₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Zaway N m))),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s π₀}
    (hM₀ : IsFineModuli Λ N m M₀ π₀ ptF₀) (x : M₀) (hx : ((q * q' : ℕ) : Zaway N m) ∉ (π₀ x).asIdeal) :
    (π₀.stalkMap x).hom.Flat := by

  haveI hβflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m)))) := inferInstance
  obtain ⟨ptF', hM', -⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isFineModuli_of_isPullback (algebraMap (Zaway N m) (ZawayDisc q q' N m)) hM₀
      (pullback.snd π₀ (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m)))))
      (pullback.fst π₀ (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m)))))
      (IsPullback.of_hasPullback π₀ (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m)))))
  have hN' : IsUnit ((N : ℕ) : ZawayDisc q q' N m) :=
    isUnit_natCast_of_algebra (R := Zaway N m) (S := ZawayDisc q q' N m) N (isUnit_natCast_N N m)
  have hm'' : IsUnit ((m : ℕ) : ZawayDisc q q' N m) :=
    isUnit_natCast_of_algebra (R := Zaway N m) (S := ZawayDisc q q' N m) m (isUnit_natCast_m N m)
  have hqq'u : IsUnit ((q * q' : ℕ) : ZawayDisc q q' N m) :=
    isUnit_natCast_localizationAway (R := Zaway N m) (q * q')
  have h2'' : IsUnit ((2 : ℕ) : ZawayDisc q q' N m) :=
    isUnit_natCast_of_algebra (R := Zaway N m) (S := ZawayDisc q q' N m) 2 (isUnit_natCast_two N m)
  haveI : Flat (pullback.snd π₀ (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m))))) :=
    flatAway_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm (ZawayDisc q q' N m) hN' hm'' h2''
      (isUnit_natCast_of_algebra (R := Zaway N m) (S := ZawayDisc q q' N m) 3 (isUnit_natCast_three N m)) hqq'u hM'
  refine flat_stalkMap_of_flat_pullback π₀
    (Spec.map (CommRingCat.ofHom (algebraMap (Zaway N m) (ZawayDisc q q' N m)))) x ?_
  have hmem : π₀ x ∈ (PrimeSpectrum.basicOpen ((q * q' : ℕ) : Zaway N m) : Set (PrimeSpectrum (Zaway N m))) := hx
  rw [← PrimeSpectrum.localization_away_comap_range (ZawayDisc q q' N m) ((q * q' : ℕ) : Zaway N m)] at hmem
  obtain ⟨y, hy⟩ := hmem
  exact ⟨y, hy⟩

theorem flat_model
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (hΛ : IsMaximalOrder Λ) [NeZero N] (hm : 3 ≤ m)
    {M₀ : Scheme.{0}} {π₀ : M₀ ⟶ Spec (CommRingCat.of (Zaway N m))}
    {ptF₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Zaway N m))),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s π₀}
    (hM₀ : IsFineModuli Λ N m M₀ π₀ ptF₀) : Flat π₀ := by
  refine Flat.of_stalkMap π₀ (fun x ↦ ?_)
  by_cases hx : ((q * q' : ℕ) : Zaway N m) ∈ (π₀ x).asIdeal
  · have hor : ((q : ℕ) : Zaway N m) ∈ (π₀ x).asIdeal ∨ ((q' : ℕ) : Zaway N m) ∈ (π₀ x).asIdeal := by
      have hmul : ((q * q' : ℕ) : Zaway N m) = ((q : ℕ) : Zaway N m) * ((q' : ℕ) : Zaway N m) := Nat.cast_mul q q'
      rw [hmul] at hx
      exact (π₀ x).isPrime.mem_or_mem hx
    rcases hor with h | h
    · exact flat_stalkMap_at Λ N m hqq' hB hΛ hm hM₀ x h
    · exact flat_stalkMap_at Λ N m (Ne.symm hqq') (isIndefiniteRamifiedExactlyAt_symm hB) hΛ hm hM₀ x h
  · exact flat_stalkMap_away Λ N m hqq' hB hΛ hm hM₀ x hx

