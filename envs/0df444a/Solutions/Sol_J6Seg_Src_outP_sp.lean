theorem enc_base (s0 : IState HS) (F : Fin HS → List ℤ) :
    encK s0 F = encK (b43 s0 F) (bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) [] (F 44)) := by
  rw [encK_rebase s0 F 43, b43]
  congr 1
  conv_lhs => rw [← bS_self F]
  rw [bS_upd_43]

theorem bS_under44 (G : Fin HS → List ℤ) (v a13 a14 a15 a30 a31 a32 a33 a43 a44 : List ℤ) :
    bS (update G 44 v) a13 a14 a15 a30 a31 a32 a33 a43 a44 = bS G a13 a14 a15 a30 a31 a32 a33 a43 a44 := by
  funext x; by_cases hx : x = 44
  · subst hx; simp +decide [bS]
  · simp [bS, update_apply, hx]

theorem enc_base44 (s0 : IState HS) (F : Fin HS → List ℤ) (X : List ℤ) :
    encK s0 (update F 44 X) =
      encK (b43 s0 F) (bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) [] X) := by
  rw [enc_base s0 (update F 44 X), bS_under44]
  have e : b43 s0 (update F 44 X) = b43 s0 F := by
    simp only [b43, update_of_ne (show (43 : Fin HS) ≠ 44 by decide)]
  rw [e]
  simp only [update_self, update_of_ne (show (13 : Fin HS) ≠ 44 by decide),
    update_of_ne (show (14 : Fin HS) ≠ 44 by decide), update_of_ne (show (15 : Fin HS) ≠ 44 by decide),
    update_of_ne (show (30 : Fin HS) ≠ 44 by decide), update_of_ne (show (31 : Fin HS) ≠ 44 by decide),
    update_of_ne (show (32 : Fin HS) ≠ 44 by decide), update_of_ne (show (33 : Fin HS) ≠ 44 by decide)]

