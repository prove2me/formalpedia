-- ===== S4.Def_RP_CdOne_Trans =====
section

/-!
# S4-PD (3)(iii), part T: transport of `HypL` to `π₁^geo`

* `hypL_of_equiv`: `HypL` transports along an isomorphism of topological groups;
* `geoEquiv A K q : π₁^geo ≃* Gal(K_U / E₀)` with `E₀ = constFieldU A K q` the field generated by the constants
  (`fixingSubgroup_constFieldU`); it is a homeomorphism (`geoEquiv_continuous`, `geoEquiv_symm_continuous`:
  compact to Hausdorff);
* `hypL_pi1geo`: `HypL l Gal(K_U/E₀) → HypL l π₁^geo`;
* `exists_zeta_constFieldU`: `E₀` contains a primitive `N`-th root of unity (`N` prime to `p`);
* `AllC1 E₀ Ω`, `KumClosure l E₀ Ω`: the two field hypotheses of `hypL_of_field`, as named propositions;
* `hypL_pi1geo_of_field`: `HypL l π₁^geo` from `AllC1` and `KumClosure` for `K_U / E₀`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IntermediateField RamanujanPetersson.Tsen Topology RamanujanPetersson.CurveCoh RamanujanPetersson.Kummer

/-- `HypL` transports along an isomorphism of topological groups. -/
theorem hypL_of_equiv (l : ℕ) {P P' : Type*} [Group P] [TopologicalSpace P] [Group P'] [TopologicalSpace P']
    (e : P ≃* P') (he : Continuous e) (he' : Continuous e.symm) (hL : HypL l P') : HypL l P := by
  intro Q N hQ hN hNQ hnorm hlq f hf hc hinv
  let Q' : Subgroup P' := Q.comap e.symm.toMonoidHom
  let N' : Subgroup P' := N.comap e.symm.toMonoidHom
  obtain ⟨γ, hγ, hγf⟩ := hL Q' N' (he'.isOpen_preimage _ hQ) (he'.isOpen_preimage _ hN) (fun x hx => hNQ hx)
    (fun q hq n hn => by
      show e.symm (q * n * q⁻¹) ∈ N
      rw [map_mul, map_mul, map_inv]
      exact hnorm _ hq _ hn)
    (fun q hq => by
      obtain ⟨k, hk⟩ := hlq _ hq
      exact ⟨k, show e.symm (q ^ l ^ k) ∈ N by rw [map_pow]; exact hk⟩)
    (fun x => f (e.symm x.1, e.symm x.2)) (hf.comp_continuous (he'.prodMap he'))
    (fun g hg h hh j hj => by
      show f (e.symm (g * h), e.symm j) + f (e.symm g, e.symm h) =
        f (e.symm h, e.symm j) + f (e.symm g, e.symm (h * j))
      rw [map_mul, map_mul]
      exact hc _ hg _ hh _ hj)
    (fun g hg h hh n hn n' hn' => by
      show f (e.symm (g * n), e.symm (h * n')) = f (e.symm g, e.symm h)
      rw [map_mul, map_mul]
      exact hinv _ hg _ hh _ hn _ hn')
  refine ⟨fun x => γ (e x), hγ.comp_continuous he, fun g hg h hh => ?_⟩
  have hg' : e g ∈ Q' := show e.symm (e g) ∈ Q by rw [MulEquiv.symm_apply_apply]; exact hg
  have hh' : e h ∈ Q' := show e.symm (e h) ∈ Q by rw [MulEquiv.symm_apply_apply]; exact hh
  have h1 := hγf (e g) hg' (e h) hh'
  simp only [MulEquiv.symm_apply_apply] at h1
  rw [h1]
  simp only [map_mul]

/-- The C1 hypothesis of `hypL_of_field`: every finite subextension of `Ω/E₀` is C1. -/
def AllC1 (E₀ Ω : Type*) [Field E₀] [Field Ω] [Algebra E₀ Ω] : Prop :=
  ∀ E : IntermediateField E₀ Ω, FiniteDimensional E₀ E → IsC1 E

set_option synthInstance.maxHeartbeats 400000 in
/-- The Kummer-closure hypothesis of `hypL_of_field`. -/
def KumClosure (l : ℕ) (E₀ Ω : Type*) [Field E₀] [Field Ω] [Algebra E₀ Ω] : Prop :=
  ∀ (E : IntermediateField E₀ Ω) (L : IntermediateField E Ω), FiniteDimensional E₀ E →
    FiniteDimensional E L → IsGalois E L → ∀ b : Lˣ, (∀ σ : Gal(L/E), ∃ c : Lˣ, σ • b / b = c ^ l) →
    ∃ a : E, a ≠ 0 ∧ ∃ y : Ω, y ^ l = algebraMap E Ω a * ((b : L) : Ω)

section Geo

variable (A K : Type) [CommRing A] [Field K] [Algebra A K] (q : ℕ)

variable {p : ℕ} [Fact p.Prime] [CharP K p]

/-- `E₀` contains a primitive `N`-th root of unity for `N` prime to `p`. -/
theorem exists_zeta_constFieldU {e : ℕ} (he : 0 < e) (N : ℕ) [NeZero N] (hN : (N : K) ≠ 0) :
    ∃ ζ : constFieldU A K (p ^ e), IsPrimitiveRoot ζ N := by
  obtain ⟨ζ, hζ, hc⟩ := Kummer.exists_zeta A K p he N hN
  have hmem : ζ ∈ constFieldU A K (p ^ e) := IntermediateField.subset_adjoin _ _ hc
  exact ⟨⟨ζ, hmem⟩, (IsPrimitiveRoot.map_iff_of_injective (ζ := (⟨ζ, hmem⟩ : constFieldU A K (p ^ e)))
    (f := (constFieldU A K (p ^ e)).val) Subtype.val_injective).1 hζ⟩

end Geo

end RamanujanPetersson.CdOne


