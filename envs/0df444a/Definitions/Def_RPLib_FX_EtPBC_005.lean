-- ===== S4.Def_RP_EtPBC_A_O2Dg =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Dg): constant degree after shrinking a one-point presentation

* `card_fib_etPull`: `#(g^* R)_ȳ = #R_{g(y)}‾` for etale `g`;
* `exists_nbhd_card_le`: the geometric fibre size of a separated quasi-compact etale `W` is lower semicontinuous;
* `exists_away_deg`: a lower semicontinuous `δ` on `Spec B` (`B` a noetherian domain) is constant on
  `D(f) ∩ D(t)` for some `f` with `t ∤ f`;
* **`isLocAff_deg`**: an affine Dedekind presentation can be shrunk so that `R` has constant geometric fibre
  size over every point of `Spec B` off the special fibre; **`card_fib_prd`**: then `(D ×_P Uo) ×_P R ⟶ D ×_P Uo`
  has constant degree (the hypothesis of `shapFree`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtDeg

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV

universe u

section Card

/-- Geometric fibres of a pullback along an etale map. -/
theorem card_fib_etPull {U X : Scheme.{u}} (g : U ⟶ X) [Etale g] (R : X.Etale) (y : U) :
    Nat.card ((geomPtAt y).point.fiber.obj ((etPull g).obj R)) =
      Nat.card ((geomPtAt (g y)).point.fiber.obj R) := by
  let F : (geomPtAt (g y)).point.fiber ≅ ((geomPtAt y).map g).point.fiber :=
    Functor.isoWhiskerLeft (Scheme.Etale.forget X) (coyoneda.mapIso (GalTrE.eE g y).op)
  exact (Nat.card_congr ((fiberMapIso g (geomPtAt y)).app R).toEquiv.symm).trans
    (Nat.card_congr (F.app R).toEquiv.symm)

end Card

section Ring

end Ring

section Aff

variable {k : Type u} [Field k] {Λ : Type u} [CommRing Λ] {P : Scheme.{u}} (c : A1 k ⟶ P) [IsOpenImmersion c]
  {B : CommRingCat.{u}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)] (f : B)

/-- `B ⟶ B_f`. -/
abbrev locF : B ⟶ CommRingCat.of (Localization.Away f) := CommRingCat.ofHom (algebraMap _ _)

theorem spec_locF_comp : Spec.map (φ ≫ locF f) ≫ c = Spec.map (locF f) ≫ Spec.map φ ≫ c := by
  rw [Spec.map_comp, Category.assoc]

instance etale_locF : Etale (Spec.map (φ ≫ locF f) ≫ c) := by
  rw [spec_locF_comp]; infer_instance

/-- `Spec B_f ⟶ Spec B` over `P`. -/
def toDF : chEt c (φ ≫ locF f) ⟶ chEt c φ :=
  MorphismProperty.Over.homMk (Spec.map (locF f)) (spec_locF_comp c φ f).symm

instance mono_toDF : Mono (toDF c φ f).left :=
  show Mono (Spec.map (locF f)) from inferInstance

theorem toDF_apply (v : Spec (CommRingCat.of (Localization.Away f))) :
    (chEt c (φ ≫ locF f)).hom v = (chEt c φ).hom ((toDF c φ f).left v) := by
  show (Spec.map (φ ≫ locF f) ≫ c) v = (Spec.map φ ≫ c) (Spec.map (locF f) v)
  rw [spec_locF_comp]
  rfl

theorem toDF_left_asIdeal (v : Spec (CommRingCat.of (Localization.Away f))) :
    ((toDF c φ f).left v).asIdeal = v.asIdeal.comap (algebraMap B (Localization.Away f)) := rfl

end Aff

end RamanujanPetersson.EtPBC.EtDeg

