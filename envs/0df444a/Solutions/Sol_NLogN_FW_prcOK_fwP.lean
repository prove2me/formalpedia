      A.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) A →
      t.G (ssH DX) = ints A ++ R → t.G (ssH DL) = .int (2 ^ j) :: LL →
