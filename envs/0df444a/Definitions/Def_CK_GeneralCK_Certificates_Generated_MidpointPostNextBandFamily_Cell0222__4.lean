      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(38743/2500000:ℝ)^2/24 < 2*(899/5000:ℝ)/(1-(899/5000:ℝ)^2)^2)
