/-- a chunk of the walk: the same step checks as `walk`, ending in the given state `(m', c', e')`
(no final check); chunks are checked by separate `decide +kernel` lemmas -/
def seg (K C lo m' c' e' : ℕ) : ℕ → ℕ → ℕ → List (ℕ × ℕ) → Bool
  | m, c, e, [] => Nat.beq m m' && Nat.beq c c' && Nat.beq e e'
  | m, c, e, (de, G) :: l =>
      let sr := dec 1 c G 100000
      Nat.ble 1 m && (Nat.ble sr.2 lo || stepOK K C c (bits m e) sr.2) &&
        Nat.beq (Nat.gcd sr.1 (pool sr.2)) 1 && Nat.ble sr.2 10000000000 &&
        seg K C lo m' c' e' (Nat.shiftRight (Nat.mul m sr.1) de) sr.2 (e + de) l

theorem seg_append (K C N Cb j bb lo m' c' e' : ℕ) (r : List (ℕ × ℕ))
    (hr : walk K C N Cb j bb lo m' c' e' r = true) :
    ∀ (l : List (ℕ × ℕ)) (m c e : ℕ), seg K C lo m' c' e' m c e l = true →
      walk K C N Cb j bb lo m c e (l ++ r) = true := by
