theorem MIPStarRE.QPBT.restrictedDLineDist_eq_map_prod (L : _root_.MIPStarRE.QPBT.LdParams) (i : Fin L.m) :
    _root_.MIPStarRE.QPBT.restrictedDLineDist L i =
      (_root_.MIPStarRE.QPBT.Distribution.prod (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (Fin L.m → _root_.MIPStarRE.QPBT.ScalarQ L))
          (_root_.MIPStarRE.QPBT.freshDiagonalPairDist L i)).map
        (fun w => (_root_.MIPStarRE.QPBT.dLineDescOfBlock L w, w.1)) := by sorry
