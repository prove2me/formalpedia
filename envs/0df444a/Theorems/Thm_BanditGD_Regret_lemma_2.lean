-- title:
--   Lemma 2, p. 6 — gradient descent with unbiased gradient estimates has expected regret ≤ RG√n
-- statement:
--   Let $S\subseteq\mathbb R^d$ be a closed convex set with $0\in S\subseteq R\mathbb B$ for some $R>0$. Let $c_1,c_2,\dots:\mathbb R^d\to\mathbb R$ be functions that are convex on $S$ and differentiable at every point of $S$, with gradient $\nabla c_t(x)$. Fix $n\ge1$, $G>0$ and
--   $$\eta=\frac{R}{G\sqrt n}.$$
--   On a probability space let $g_1,g_2,\dots$ be random vectors with $\|g_t\|\le G$, and let $x_1,x_2,\dots$ be the expected-gradient-descent run $x_1=0$, $x_{t+1}=P_S(x_t-\eta g_t)$. Suppose that for every $t\ge1$
--   $$\mathbb E[g_t\mid x_t]=\nabla c_t(x_t)\quad\text{almost surely.}$$
--   Then
--   $$\mathbb E\Big[\sum_{t=1}^n c_t(x_t)\Big]-\min_{x\in S}\sum_{t=1}^n c_t(x)\le RG\sqrt n .$$
--
--   This is Zinkevich's online gradient descent bound with the exact gradient replaced by a conditionally unbiased estimate; the bandit algorithm is reduced to it by taking $g_t$ to be the one-point estimate of Lemma 1.
--
--   **Formalization Note** $\mathbb E[g_t\mid x_t]$ is the conditional expectation given the σ-algebra generated by $x_t$; the $g_t$ and $x_t$ are assumed measurable (measurability of $x_t$ follows from that of the $g_t$, and is stated so that this σ-algebra is a sub-σ-algebra). "Differentiable on $S$" is read as differentiability of $c_t$ (a function on $\mathbb R^d$) at every point of $S$, including boundary points. The paper's standing assumption $r\mathbb B\subseteq S$ enters this lemma only through $x_1=0\in S$, so the lemma assumes $0\in S$ instead. The minimum is written as an infimum over $S$, which is attained here ($S$ is compact and each $c_t$ continuous on $S$). The hypotheses on $g_t$ are required for every $t\ge1$; only $t\le n$ matter, and any finite family extends.
-- source:
--   Flaxman, Kalai, McMahan, arXiv:cs/0408007v1, p. 6, Lemma 2

import Mathlib
import Definitions.Def_RegretBandits_Nonlinear_OSGD
import Definitions.Def_BanditGD_Regret_Setting
open MeasureTheory

namespace BanditGD.Regret

theorem lemma_2 {d : ℕ} (S : Set (EuclideanSpace ℝ (Fin d))) (hSconv : Convex ℝ S) (hSclosed : IsClosed S)
    (R : ℝ) (hR : 0 < R) (h0S : (0 : EuclideanSpace ℝ (Fin d)) ∈ S) (hSR : S ⊆ Metric.closedBall 0 R)
    (c : ℕ → EuclideanSpace ℝ (Fin d) → ℝ) (gc : ℕ → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (hcconv : ∀ t, ConvexOn ℝ S (c t)) (hcgrad : ∀ t, ∀ x ∈ S, HasGradientAt (c t) (gc t x) x)
    (n : ℕ) (hn : 1 ≤ n) (G η : ℝ) (hG : 0 < G) (hη : η = R / (G * Real.sqrt n))
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (g x : ℕ → Ω → EuclideanSpace ℝ (Fin d)) (hgm : ∀ t, Measurable (g t)) (hxm : ∀ t, Measurable (x t))
    (hgG : ∀ t ω, ‖g t ω‖ ≤ G)
    (hrun : ∀ ω, IsExpectedGDRun S η (fun t => g t ω) (fun t => x t ω))
    (hunb : ∀ t, 1 ≤ t →
      P[g t | MeasurableSpace.comap (x t) inferInstance] =ᵐ[P] fun ω => gc t (x t ω)) :
    RegretBandits.Nonlinear.pseudoRegret S c P x n ≤ R * G * Real.sqrt n := by sorry

end BanditGD.Regret
