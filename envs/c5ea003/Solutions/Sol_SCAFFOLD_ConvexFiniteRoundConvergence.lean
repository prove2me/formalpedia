section SCAFFOLDBundleModule17
/-!
Retained option II oracle-error moments for Karimireddy et al., SCAFFOLD,
arXiv:1910.06378v4, Section 5; Appendix B.1, PDF p. 14, A4; Appendix E,
PDF pp. 25-28, equations (18)-(24), Lemmas 12-13; warm initialization on
PDF p. 35. The decomposition bounds the stored error, not the whole control.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

theorem Run.averageOracle_sub_signal_eq_noise (A : Run P ν S K T ηl ηg init)
    (r : ℕ) (i : Fin N) (ω : Ω) :
    averageOracle A r i ω - averageSignal A r i ω = averageNoise A r i ω := by
  rw [A.averageOracle_sub_averageSignal]
  simp only [averageNoise]
  rw [Fin.sum_univ_eq_sum_range (fun k ↦ clientNoise A r k i ω)]

theorem Run.storedError_noise_update (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    storedError A (r + 1) i =ᵐ[ν] fun ω ↦ if i ∈ A.sample r ω then
      averageNoise A r i ω else storedError A r i ω := by
  filter_upwards [A.storedError_update hr i] with ω hω
  simpa only [A.averageOracle_sub_signal_eq_noise] using hω

theorem Run.averageWarmNoise_eq (A : Run P ν S K T ηl ηg init)
    (i : Fin N) (ω : Ω) :
    averageWarmNoise A i ω =
      (K : ℝ)⁻¹ • ∑ k ∈ Finset.range K, A.warm k i ω - gradient (P.f i) P.x0 := by
  have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
  simp [averageWarmNoise, warmNoise, Finset.sum_sub_distrib,
    smul_sub, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hK]
  exact Fin.sum_univ_eq_sum_range (fun k ↦ A.warm k i ω) K

theorem Run.storedError_initial_warm (A : Run P ν S K T ηl ηg none) (i : Fin N) :
    storedError A 0 i =ᵐ[ν] averageWarmNoise A i := by
  filter_upwards [A.initial_c i] with ω hω
  simp only [storedError, storedSignal, hω, A.averageWarmNoise_eq]

theorem Run.storedError_initial_second_moment_le (A : Run P ν S K T ηl ηg init)
    (i : Fin N) : ∫ ω, ‖storedError A 0 i ω‖ ^ 2 ∂ν ≤ P.σ ^ 2 / K := by
  cases init with
  | none =>
    have h := integral_congr_ae ((A.storedError_initial_warm i).fun_comp
      (fun x : Space d ↦ ‖x‖ ^ 2))
    exact h.le.trans (A.averageWarmNoise_second_moment_le i)
  | some c0 =>
    have h := integral_congr_ae ((A.storedError_initial_deterministic i).fun_comp
      (fun x : Space d ↦ ‖x‖ ^ 2))
    simp only [Function.comp_apply, Pi.zero_apply, norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0),
      integral_zero] at h
    rw [h]
    positivity

theorem Run.storedError_second_moment_step (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (i : Fin N) :
    (∫ ω, ‖storedError A (r + 1) i ω‖ ^ 2 ∂ν) =
      ((S : ℝ) / N) * (∫ ω, ‖averageNoise A r i ω‖ ^ 2 ∂ν) +
      (1 - (S : ℝ) / N) * (∫ ω, ‖storedError A r i ω‖ ^ 2 ∂ν) := by
  have heq : (fun ω ↦ ‖storedError A (r + 1) i ω‖ ^ 2) =ᵐ[ν]
      fun ω ↦ if i ∈ A.sample r ω then ‖averageNoise A r i ω‖ ^ 2
        else ‖storedError A r i ω‖ ^ 2 := by
    filter_upwards [A.storedError_noise_update hr i] with ω hω
    rw [hω]
    split <;> rfl
  have herror := ((A.storedError_adapted hr.le i).mono
    (A.history.mono (Nat.le_add_right (roundTime K r) K))).aestronglyMeasurable (μ := ν)
  exact (integral_congr_ae heq).trans (A.refresh_integral hr i
    (fun ω ↦ ‖averageNoise A r i ω‖ ^ 2) (fun ω ↦ ‖storedError A r i ω‖ ^ 2)
    (A.averageNoise_memLp hr i).norm.integrable_sq
    (A.storedError_memLp hr.le i).norm.integrable_sq
    (((continuous_norm : Continuous (fun x : Space d ↦ ‖x‖)).pow 2).comp_aestronglyMeasurable
      (A.averageNoise_adapted hr i))
    (((continuous_norm : Continuous (fun x : Space d ↦ ‖x‖)).pow 2).comp_aestronglyMeasurable
      herror))

theorem Run.storedError_second_moment_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r ≤ T) (i : Fin N) :
    ∫ ω, ‖storedError A r i ω‖ ^ 2 ∂ν ≤ P.σ ^ 2 / K := by
  have hp : 0 ≤ (S : ℝ) / N := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hp1 : (S : ℝ) / N ≤ 1 := (div_le_one (by exact_mod_cast P.clients_pos)).mpr
    (by exact_mod_cast A.sample_le)
  induction r with
  | zero => exact A.storedError_initial_second_moment_le i
  | succ r ih =>
    have hrt : r < T := Nat.lt_of_succ_le hr
    rw [A.storedError_second_moment_step hrt i]
    calc
      _ ≤ ((S : ℝ) / N) * (P.σ ^ 2 / K) +
          (1 - (S : ℝ) / N) * (P.σ ^ 2 / K) :=
        add_le_add (mul_le_mul_of_nonneg_left (A.averageNoise_second_moment_le hrt i) hp)
          (mul_le_mul_of_nonneg_left (ih hrt.le) (sub_nonneg.mpr hp1))
      _ = _ := by ring

theorem Run.storedError_averageNoise_inner_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (i j : Fin N) :
    ν[fun ω ↦ inner ℝ (storedError A r i ω) (averageNoise A r j ω) |
      A.history (roundTime K r)] =ᵐ[ν] 0 :=
  FedAvg.condExp_inner_zero (A.storedError_memLp hr.le i) (A.averageNoise_memLp hr j)
    (A.storedError_adapted hr.le i).aestronglyMeasurable (A.averageNoise_roundStart_zero hr j)

theorem Run.storedError_averageNoise_inner_integral_zero
    (A : Run P ν S K T ηl ηg init) {r : ℕ} (hr : r < T) (i j : Fin N) :
    ∫ ω, inner ℝ (storedError A r i ω) (averageNoise A r j ω) ∂ν = 0 := by
  have h := integral_congr_ae (A.storedError_averageNoise_inner_zero hr i j)
  rw [integral_condExp (A.history.le _)] at h
  simpa using h

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule17
