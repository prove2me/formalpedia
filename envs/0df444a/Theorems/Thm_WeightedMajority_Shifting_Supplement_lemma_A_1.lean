-- title:
--   Lemma A.1 — indicator conditional-expectation identity
-- statement:
--   On an arbitrary probability space, let $\xi$ be an integrable real random variable and $\eta$ a measurable binary random variable. Let $G$ be any finite sub-sigma-algebra of the ambient sigma algebra and put $H=G\vee\sigma(\eta)$. Then
--
--   $$\eta\,P[\eta\xi\mid G]=P[\eta\mid G]\,P[\eta\xi\mid H]\quad\text{almost surely}.$$
--
--   This identity conditions a product with an indicator on the extension generated by that indicator. It assumes no independence and does not require a finite underlying probability space.
--
--   Differences from the source:
--   - encoding: finite sigma algebra G → the set of G-measurable subsets is finite; reason: finiteness concerns the sigma algebra rather than the sample space
--   - generalization: a {0, 1}-valued random variable → a measurable real function that is {0, 1}-valued almost surely; reason: every {0, 1}-valued random variable qualifies, and the almost-sure identity is insensitive to null sets
-- source:
--   Littlestone, Warmuth, The Weighted Majority Algorithm, Inform. and Comput. 108 (1994), DOI 10.1006/inco.1994.1009, p. 257, Lemma A.1

import Mathlib

open MeasureTheory

namespace WeightedMajority.Shifting.Supplement

theorem lemma_A_1 {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ξ η : Ω → ℝ) (hξ : Integrable ξ P) (hη : Measurable η)
    (hbinary : ∀ᵐ ω ∂P, η ω = 0 ∨ η ω = 1)
    (G : MeasurableSpace Ω) (hG : G ≤ mΩ) (hfinite : Set.Finite {s : Set Ω | @MeasurableSet Ω G s}) :
    (fun ω => η ω * P[(fun z => η z * ξ z) | G] ω) =ᵐ[P]
      (fun ω => P[η | G] ω *
        P[(fun z => η z * ξ z) | G ⊔ MeasurableSpace.comap η inferInstance] ω) := by sorry

end WeightedMajority.Shifting.Supplement
