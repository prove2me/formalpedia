-- Round-six κ development (integer-multiplication-kappa), generated by skeleton subtraction.

import Definitions.Def_IntMul_Kappa_R6_Defs1
import Theorems.Thm_J6Sieve_greedy

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Sieve
open Finset

lemma j6_rough_odd (d X n : ℕ) (h : rough (zz d X) n) : Odd n := by
  have h2 : (2 : ℕ) ∈ P (zz d X) := by
    unfold P zz
    simp only [Finset.mem_filter, Finset.mem_range]
    exact ⟨by omega, Nat.prime_two⟩
  have := h 2 h2
  exact Nat.odd_iff.mpr (by omega)

theorem solution (d X H : ℕ) (A : Fin d → ℕ) (hA : ∀ i, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∃ s : Fin d → ℕ, (∀ i, Odd (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      Pairwise (fun i j => Nat.Coprime (s i) (s j)) := by
  let A' : ℕ → ℕ := fun i => if h : i < d then A ⟨i, h⟩ else 0
  have hA' : ∀ i < d, A' i + H ≤ X := by
    intro i hi; simp only [A', dif_pos hi]; exact hA _
  obtain ⟨s, hs1, hs2⟩ := J6Sieve.greedy d X H A' hA' hH d le_rfl
  refine ⟨fun i => s i.val, fun i => ?_, fun i j hij => ?_⟩
  · obtain ⟨h1, h2, h3⟩ := hs1 i.val i.isLt
    simp only [A', dif_pos i.isLt] at h2 h3
    exact ⟨j6_rough_odd d X _ h1, h2, h3⟩
  · exact hs2 i.val i.isLt j.val j.isLt (fun h => hij (Fin.ext h))
