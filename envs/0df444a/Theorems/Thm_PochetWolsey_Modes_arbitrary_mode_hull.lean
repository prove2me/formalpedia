-- title:
--   Proposition 12.7 — arbitrary-count setup sequence hull
-- statement:
--   Let $Y^{M\infty-SC}$ consist of setup, startup and switch-off triples generated by nonempty lists of distinct items in each period. The last item of each period is the first of the next; $y$ indicates membership, $z$ membership except the first item, and $w$ membership except the last item. Let $P$ be the following unit-box extension in $(y,z,w,\phi)$:
--   $$\sum_j(y_j(t)-z_j(t))=1,\qquad y_i(t+1)-z_i(t+1)=y_i(t)-w_i(t),$$
--   $$y_i(t)-z_i(t)\ge\phi_i(t),\quad y_i(t)-w_i(t)\ge\phi_i(t),\quad\phi_i(t)\ge y_i(t)-z_i(t)-w_i(t),$$
--   $$y_i(t)+\sum_{j\ne i}\phi_j(t)\le1.$$
--   The continuity equation applies between adjacent periods and all other inequalities in every period. The printed claim is
--   $$\operatorname{conv}(Y^{M\infty-SC})=\{(y,z,w):\exists\phi,\ (y,z,w,\phi)\in P\}.$$
--   This asserts an exact projection formula without a bound on the number of distinct items within a period. Finding F2 records a terminal counterexample to the printed system under the ordered-list semantics; the faithful claim is retained for disproof rather than silently repaired.
--
--   **Formalization Note** There are $m+1$ labels, including idle label $0$, and $n+1$ periods, numbered $0,\ldots,n$. Thus $m=n=0$ means one idle label and one period, not empty index sets. The final item is retained as the last setup. No equation $\sum_i(y_i(n)-w_i(n))=1$ is added to the printed right-hand side. Only the diagonal auxiliary coordinates are present.
-- source:
--   Pochet and Wolsey, Production Planning by Mixed Integer Programming, Springer 2006, p. 381 (PDF 392), Proposition 12.7

import Mathlib

namespace PochetWolsey.Modes

theorem arbitrary_mode_hull (m n : ℕ) :
    convexHull ℝ ({p : ((Fin (m + 1) → Fin (n + 1) → ℝ) × (Fin (m + 1) → Fin (n + 1) → ℝ) × (Fin (m + 1) → Fin (n + 1) → ℝ)) | ∃ s : Fin (n + 1) → List (Fin (m + 1)),
      (∀ t, s t ≠ [] ∧ (s t).Nodup) ∧
      (∀ t : Fin n, (s t.castSucc).getLast? = (s t.succ).head?) ∧ p = ((fun i t => if i ∈ s t then (1 : ℝ) else 0), (fun i t => if i ∈ (s t).tail then (1 : ℝ) else 0), (fun i t => if i ∈ (s t).dropLast then (1 : ℝ) else 0))}) =
    {p | ∃ φ : (Fin (m + 1) → Fin (n + 1) → ℝ),
    (∀ i, (∀ t, 0 ≤ p.1 i t ∧ p.1 i t ≤ 1)) ∧
  (∀ i, (∀ t, 0 ≤ p.2.1 i t ∧ p.2.1 i t ≤ 1)) ∧
  (∀ i, (∀ t, 0 ≤ p.2.2 i t ∧ p.2.2 i t ≤ 1)) ∧
  (∀ i, (∀ t, 0 ≤ φ i t ∧ φ i t ≤ 1)) ∧
  (∀ t, ∑ j, (p.1 j t - p.2.1 j t) = 1) ∧
  (∀ i (t : Fin n), p.1 i t.succ - p.2.1 i t.succ =
    p.1 i t.castSucc - p.2.2 i t.castSucc) ∧
  (∀ i t, p.1 i t - p.2.1 i t ≥ φ i t) ∧
  (∀ i t, p.1 i t - p.2.2 i t ≥ φ i t) ∧
  (∀ i t, φ i t ≥ p.1 i t - p.2.1 i t - p.2.2 i t) ∧
  (∀ i t, p.1 i t + ∑ j ∈ Finset.univ.erase i, φ j t ≤ 1)} := by sorry

end PochetWolsey.Modes
