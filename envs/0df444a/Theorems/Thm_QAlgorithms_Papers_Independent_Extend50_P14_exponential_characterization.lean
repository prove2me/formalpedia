-- title:
--   Corollary 1: exponential characterization
-- statement:
--   Fix n≥1 positive-dimensional sites, an on-site symmetry representation, and 1≤k≤n. For any matrix V on the physical register,
--
--   $$V\in V_k\quad\Longleftrightarrow\quad\exists C\in h_k,\ V=e^C.$$
--
--   Here h_k is generated by local invariant skew-Hermitian matrices, so there is no additional factor -i in this exponential. This describes individual reachable unitaries.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 14, Corollary 1: the exponential characterization

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

section General

variable {G : Type*} [Group G] {n : ℕ} {D : Fin n → Type*}

variable [∀ j, Fintype (D j)] [∀ j, DecidableEq (D j)] [hD : ∀ j, Nonempty (D j)]

-- Positive local dimensions are a physical standing assumption even when unused
-- in the displayed formula; include it in each theorem's elaborated binders.

include hD

/-- PDF p.14, Corollary 1: the exponent is itself skew-Hermitian, with no -i. -/
theorem exponential_characterization (hn : 1 ≤ n) (r : OnSite G D)
    (k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (V : Mat (SiteBasis D)) :
    V ∈ symmetricLocalGroup r.total k ↔ ∃ C ∈ symmetricLocalLie r.total k, V = NormedSpace.exp C := by sorry

end General

end QAlgorithms.Papers.Independent.Extend50.P14

end
