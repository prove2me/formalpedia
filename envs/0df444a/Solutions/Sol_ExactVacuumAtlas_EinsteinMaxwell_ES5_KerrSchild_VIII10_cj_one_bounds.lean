/-! ## The constant reference source -/

/-- **M3, upper bound on the real response**: for every `R > 3`, `cj 1 R ≤ 1/(8 R)`. -/
theorem cj_one_le {R : ℝ} (hR : 3 < R) : cj 1 R ≤ 1 / (8 * R) := by
  have h := cj_bound_one 1 R hR
  have h1 : |(1:ℝ)| = 1 := abs_one
  rw [h1, one_pow] at h
  have hup := (abs_le.mp h).2
  have hR0 : (0:ℝ) < R := by linarith
  have hval : 1 / (8 * R) = (1 / 8) / R := by field_simp
  rw [hval, le_div_iff₀ hR0]
  linarith

