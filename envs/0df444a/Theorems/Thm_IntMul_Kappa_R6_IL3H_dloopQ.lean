variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

theorem IntMul.Kappa.R6.IL3H.dloopQ {m W : ℕ} (hm : 1 ≤ m) (hW : 1 ≤ W) {jD : Fin Pp} {cont : IStmt HS Pp}
    (hj : tbl jD = dloopC m W jD cont) {P K D S ρ r w G Mb Bz : ℕ} (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hM : W ^ (dep m D + 1) + m * D + 2 * m + D + 2 ≤ Mb)
    {f g : Fin HS → List ℤ} (hf : Clean0 f) (hg : Clean0 g) {cc : ℕ}
    (Cont : ∀ σ, DescR σ P K D S ρ r w → σ vG = some (G : ℤ) →
      σ 12 = some (dep m D : ℤ) → σ 13 = some ((W ^ dep m D : ℕ) : ℤ) →
      RunQ Isym tbl σ cont f g cc) :
    ∀ n σ, (DescR σ P K D S ρ r w ∧ σ vG = some (G : ℤ) ∧ ∃ x j : ℕ, σ 11 = some (x : ℤ) ∧
      σ 12 = some (j : ℤ) ∧ σ 13 = some ((W ^ j : ℕ) : ℤ) ∧ x ≤ D ∧ dep m x = n ∧
      j + n = dep m D) →
      RunQ Isym tbl σ (.call jD) f g (cc + (n + 1) * cLoop 3 Bz) := by sorry
