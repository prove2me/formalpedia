-- url     : https://prove2.me/theorems/b291ca87-ba7b-4998-85c9-b628a1be31c6
-- title:
--   §2–§3 — value recursion and unrestricted policy costs
-- statement:
--   For a terminal cost $W_0$ and discounted fixed cost $K$, the finite-stage transformed cost is generated by
--
--   $$G_n(i,y)=G^+(i,y)+\beta\lambda_i c+\beta\left[\lambda_iW_{n-1}(i,y-1)+\sum_{j\ne i}q_{ij}W_{n-1}(j,y)+(\mu-\lambda_i-q_i)W_{n-1}(i,y)\right],$$
--   $$W_n(i,x)=\min_{y\ge x}\{K\delta(y-x)+G_n(i,y)\}.$$
--
--   The linear-cost iterates use $K=0$ and $W_0=0$. A policy may depend on the whole sequence of previously observed world states and inventory positions. Its infinite-horizon cost is the supremum of finite-horizon nonnegative costs in the uniformized model of equation (1); optimality compares it with every feasible policy from every initial state. The basestock policy orders to $\max(x,y(i))$ in state $(i,x)$.
--
--   **Formalization Note** Randomized policies are excluded; they cannot improve expected nonnegative costs on this countable state space. The real infima and series in the displayed recursion are finite under the standing hypotheses by Lemma 4 and Theorem 1.
-- source:
--   Song and Zipkin, Inventory Control in a Fluctuating Demand Environment, Oper. Res. 41(2):351–370 (1993), DOI 10.1287/opre.41.2.351, pp. 355–357, (1), (2), (10), (13)

import Mathlib
import Definitions.Def_SongZipkinFluct_Linear_Model

open scoped ENNReal

namespace SongZipkinFluct.Linear

variable {I : Type*} [Countable I] [Nonempty I] [DecidableEq I]

/-- The right-hand side of `G_n`, display (10), p. 356. The series is
summable for the paper's value iterates by Lemma 4; no convergence is inserted
as an assumption into the model. -/
noncomputable def Model.contG (M : Model I) (U : I → ℤ → ℝ) (i : I) (y : ℤ) : ℝ :=
  M.Gplus i y + M.beta * M.lam i * M.c +
  M.beta * (M.lam i * U i (y - 1) +
    (∑' j : {j : I // j ≠ i}, M.Q i j.1 * U j.1 y) +
    (M.μ - M.lam i + M.Q i i) * U i y)

/-- `W_n` of (10), p. 356. At `n=0` this is the supplied terminal
cost; at each successor it minimizes over all feasible order-up-to levels.
The paper's linear-cost subsection fixes `K=0` and `W₀=0`. -/
noncomputable def Model.W (M : Model I) (K : ℝ) (W₀ : I → ℤ → ℝ) :
    ℕ → I → ℤ → ℝ
  | 0, i, x => W₀ i x
  | n + 1, i, x =>
      ⨅ y : {y : ℤ // x ≤ y},
        K * delta (y.1 - x) + M.contG (M.W K W₀ n) i y.1

/-- `G_n` of (10), p. 356. The formula is used only for `n≥1`; Lean's
value at `n=0` is set to zero. -/
noncomputable def Model.G (M : Model I) (K : ℝ) (W₀ : I → ℤ → ℝ)
    (n : ℕ) (i : I) (y : ℤ) : ℝ :=
  if n = 0 then 0 else M.contG (M.W K W₀ (n - 1)) i y

/-- Linear-cost value iterates, display (13), p. 357. -/
noncomputable def Model.Wlin (M : Model I) (n : ℕ) (i : I) (x : ℤ) : ℝ :=
  M.W 0 (fun _ _ => 0) n i x

/-- Linear-cost auxiliary iterates, display (13), p. 357. -/
noncomputable def Model.Glin (M : Model I) (n : ℕ) (i : I) (y : ℤ) : ℝ :=
  M.G 0 (fun _ _ => 0) n i y

/-- Pointwise supremum of `W_n`, Theorem 2(a), p. 357. Theorem 1(d)
and Lemma 4 make this the finite pointwise limit. -/
noncomputable def Model.Winf (M : Model I) (i : I) (x : ℤ) : ℝ :=
  ⨆ n : ℕ, M.Wlin n i x

/-- Pointwise supremum of the positive-stage `G_n`, Theorem 2(b),
p. 357. Theorem 1(e) and Lemma 4 make this the finite limit. -/
noncomputable def Model.Ginf (M : Model I) (i : I) (y : ℤ) : ℝ :=
  ⨆ n : ℕ, M.Glin (n + 1) i y

/-- World state and inventory position in the uniformized MDP, §2 p. 355. -/
abbrev State (I : Type*) := I × ℤ

/-- A deterministic history-dependent policy: a past list of states and
the current state determine the post-order inventory position. -/
abbrev Policy (I : Type*) := List (State I) → State I → ℤ

/-- All orders are nonnegative in size, §2 p. 355. -/
def Feasible (σ : Policy I) : Prop :=
  ∀ h s, s.2 ≤ σ h s

/-- The nonnegative stage cost in the V-form of (1), p. 355. Under the
standing model assumptions the real argument is nonnegative. -/
noncomputable def Model.stageCost (M : Model I) (K : ℝ)
    (i : I) (x y : ℤ) : ℝ≥0∞ :=
  ENNReal.ofReal (K * delta (y - x) + M.c * ((y - x : ℤ) : ℝ) + M.beta * M.C i y)

/-- The one-event expected continuation cost in equation (1), p. 355.
The three branches are a unit demand, a world jump, and a self-loop. -/
noncomputable def Model.nextCost (M : Model I) (U : State I → ℝ≥0∞)
    (i : I) (y : ℤ) : ℝ≥0∞ :=
  ENNReal.ofReal (M.lam i / M.μ) * U (i, y - 1) +
  (∑' j : {j : I // j ≠ i}, ENNReal.ofReal (M.Q i j.1 / M.μ) * U (j.1, y)) +
  ENNReal.ofReal (1 - (M.lam i + -M.Q i i) / M.μ) * U (i, y)

/-- Finite-horizon cost of a history-dependent policy, starting with history
`h`, as the nonnegative recursion of equation (1), p. 355. -/
noncomputable def Model.cost (M : Model I) (K : ℝ) (σ : Policy I) :
    ℕ → List (State I) → State I → ℝ≥0∞
  | 0, _, _ => 0
  | n + 1, h, s =>
      let y := σ h s
      M.stageCost K s.1 s.2 y +
      ENNReal.ofReal M.gamma *
        M.nextCost (fun s' => M.cost K σ n (h ++ [s]) s') s.1 y

/-- Infinite-horizon cost, defined as the supremum of finite-horizon
nonnegative costs. A history is passed explicitly so all policies remain
history-dependent. -/
noncomputable def Model.policyCost (M : Model I) (K : ℝ)
    (σ : Policy I) (h : List (State I)) (s : State I) : ℝ≥0∞ :=
  ⨆ n : ℕ, M.cost K σ n h s

/-- Optimality from every initial state against every feasible deterministic
history-dependent policy, §2 p. 355 and Theorem 2(e), p. 358. -/
def Model.IsOptimal (M : Model I) (K : ℝ) (σ : Policy I) : Prop :=
  Feasible σ ∧ ∀ σ' : Policy I, Feasible σ' → ∀ s : State I,
    M.policyCost K σ [] s ≤ M.policyCost K σ' [] s

/-- The stationary world-dependent basestock policy `π(y)`, §1 p. 354. -/
def baseStock (y : I → ℤ) : Policy I :=
  fun _ s => max s.2 (y s.1)

end SongZipkinFluct.Linear


