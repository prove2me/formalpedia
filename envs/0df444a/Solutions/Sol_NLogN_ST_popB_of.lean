  apply Nat.pow_le_pow_right (by norm_num)
  generalize hF : (256 * K ^ 2).factorial = F
  have hF1 : 1 ≤ F := by rw [← hF]; exact Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have h1 : 8 * K ≤ K * (64 * K ^ 2 * F) + 3 := by
    rcases Nat.eq_zero_or_pos K with rfl | hK
    · simp
    · have : 1 ≤ K ^ 2 := Nat.one_le_pow _ _ hK
      have : 8 ≤ 64 * K ^ 2 * F := by nlinarith
      nlinarith
  calc 2 ^ (8 * K) + 1 ≤ 2 ^ (8 * K) + 2 ^ (8 * K) := by have := Nat.one_le_two_pow (n := 8 * K); omega
    _ = 2 ^ (8 * K + 1) := by ring
    _ ≤ 2 ^ (K * (64 * K ^ 2 * F) + 4) := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem s_le_t (K N : ℕ) (hK : 1 ≤ K) (hN : n0K K ≤ N) (i : ℕ) (hi : i < K) :
    (mkParams K N).s.getD i 1 ≤ 2 ^ (mkParams K N).te i := by
  have h := ((mkParams_s_spec K hK N hN).2.2.2 i hi).2
  have h2 : (4 * K - 1) * 2 ^ (mkParams K N).te i ≤ 4 * K * 2 ^ (mkParams K N).te i :=
    Nat.mul_le_mul_right _ (by omega)
  exact Nat.le_of_mul_le_mul_left (h.trans h2) (by omega)

/-- `q.s` as a map over `range K`. -/
theorem s_eq_map (K N : ℕ) (hK : 1 ≤ K) (hN : n0K K ≤ N) :
    (mkParams K N).s = (List.range K).map fun i => (mkParams K N).s.getD i 1 := by
  have hl : (mkParams K N).s.length = K := (mkParams_s_spec K hK N hN).1
  apply List.ext_getElem (by simp [hl])
  intro i h1 h2
  simp only [List.getElem_map, List.getElem_range]
  rw [List.getD_eq_getElem _ _ h1]

theorem tdims_eq (K N : ℕ) :
    (mkParams K N).tdims = (List.range K).map fun i => 2 ^ (mkParams K N).te i := rfl

theorem S_le_T (K N : ℕ) (hK : 1 ≤ K) (hN : n0K K ≤ N) :
    (mkParams K N).S ≤ 2 ^ (mkParams K N).logT := by
  rw [← CR.T_eq, Params.S, s_eq_map K N hK hN, tdims_eq]
  apply List.prod_le_prod'
  intro i hi
  exact s_le_t K N hK hN i (List.mem_range.1 hi)

theorem bern (K : ℕ) (hK : 1 ≤ K) : (4 * K) ^ K ≤ 2 * (4 * K - 2) ^ K := by
  have hK' : (0 : ℝ) < K := by exact_mod_cast hK
  have h := one_add_mul_le_pow (a := -(1 / (2 * (K : ℝ)))) (by
    have : 1 / (2 * (K : ℝ)) ≤ 1 := by
      rw [div_le_one (by positivity)]; have : (1 : ℝ) ≤ K := by exact_mod_cast hK
      linarith
    linarith) K
  have e1 : (1 : ℝ) + K * -(1 / (2 * K)) = 1 / 2 := by field_simp; ring
  have e2 : (1 : ℝ) + -(1 / (2 * K)) = ((4 * K - 2 : ℕ) : ℝ) / (4 * K) := by
    rw [Nat.cast_sub (by omega)]; push_cast; field_simp; ring
  rw [e1, e2, div_pow] at h
  have hp : (0 : ℝ) < (4 * K) ^ K := by positivity
  rw [le_div_iff₀ hp] at h
  have : ((4 * K) ^ K : ℝ) ≤ 2 * ((4 * K - 2 : ℕ) : ℝ) ^ K := by linarith
  exact_mod_cast this

theorem T_le_2S (K N : ℕ) (hK : 1 ≤ K) (hN : n0K K ≤ N) :
    2 ^ (mkParams K N).logT ≤ 2 * (mkParams K N).S := by
  have hsp := mkParams_s_spec K hK N hN
  have h1 : ((List.range K).map fun i => (4 * K - 2) * 2 ^ (mkParams K N).te i).prod ≤
      ((List.range K).map fun i => 4 * K * (mkParams K N).s.getD i 1).prod := by
    apply List.prod_le_prod'
    intro i hi
    exact (hsp.2.2.2 i (List.mem_range.1 hi)).1.le
  rw [List.prod_map_mul, List.prod_map_mul, List.map_const', List.map_const', List.prod_replicate,
    List.prod_replicate, List.length_range, ← s_eq_map K N hK hN, ← tdims_eq K N, CR.T_eq] at h1
  have hb := bern K hK
  have hpos : 0 < (4 * K) ^ K := by positivity
  -- (4K)^K * T ≤ 2 (4K-2)^K T ≤ 2 (4K)^K S
  have : (4 * K) ^ K * 2 ^ (mkParams K N).logT ≤ (4 * K) ^ K * (2 * (mkParams K N).S) := by
    calc (4 * K) ^ K * 2 ^ (mkParams K N).logT ≤ 2 * (4 * K - 2) ^ K * 2 ^ (mkParams K N).logT :=
          Nat.mul_le_mul_right _ hb
      _ = 2 * ((4 * K - 2) ^ K * 2 ^ (mkParams K N).logT) := by ring
      _ ≤ 2 * ((4 * K) ^ K * (mkParams K N).s.prod) := Nat.mul_le_mul_left _ (by simpa [Params.S] using h1)
      _ = (4 * K) ^ K * (2 * (mkParams K N).S) := by simp [Params.S]; ring
  exact Nat.le_of_mul_le_mul_left this hpos

theorem bf (K N : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) : BF K N := by
  have hK1 : 1 ≤ K := by omega
  have pf := Asym.pf_of_large K hK N ((n0K_big K).trans hN)
  have hlo := pf.lo
  refine ⟨hK, pf, S_le_T K N hK1 hN, T_le_2S K N hK1 hN, CR.T_eq _, rfl, by omega, rfl, ?_, ?_, rfl⟩
  · intro x hx
    rw [s_eq_map K N hK1 hN] at hx
    obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hx
    refine (s_le_t K N hK1 hN i (List.mem_range.1 hi)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    unfold Params.te; split_ifs <;> omega
  · have hp := pf.p_eq
    have : (mkParams K N).α ≤ (mkParams K N).α ^ 2 := by nlinarith [pf.α1]
    have : (mkParams K N).α ^ 2 ≤ 6 * K * (mkParams K N).α ^ 2 := by nlinarith
    omega

theorem two_pow_split (A B : ℕ) (h : A ≤ B) : (2 : ℕ) ^ B = 2 ^ A * 2 ^ (B - A) := by
  rw [← pow_add]; congr 1; omega

theorem LS_of (K N : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) :
    2 * (mkParams K N).L - 1 ≤ (mkParams K N).S := by
  have h := bf K N hK hN
  have := h.pf.E4; have := h.T_le; omega

/-- `x ≤ X`, `X ≥ 1`, `c < 2^D`: a polynomial in `X` with small coefficients is below `X² 2^D`. -/
theorem lt_Bc (K N : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) {v : ℕ}
    (hv : ∀ X : ℕ, X = 2 ^ (mkParams K N).logT → v ≤ 16 * (X * X) + 4 * K + 8) : v < 2 ^ BcK K N := by
  have h := bf K N hK hN
  set X := 2 ^ (mkParams K N).logT with hX
  have hX1 : 1 ≤ X := Nat.one_le_two_pow
  have e := two_pow_split (2 * (mkParams K N).logT) (BcK K N) (by unfold BcK; omega)
  have hD : 4 * K + 64 ≤ BcK K N - 2 * (mkParams K N).logT := by unfold BcK; omega
  have hD2 : 4 * K + 64 < 2 ^ (BcK K N - 2 * (mkParams K N).logT) :=
    lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_right (by norm_num) hD)
  have hXX : 2 ^ (2 * (mkParams K N).logT) = X * X := by rw [two_mul, pow_add]
  rw [e, hXX]
  have := hv X rfl
  have : 1 ≤ X * X := Nat.one_le_iff_ne_zero.2 (by positivity)
  nlinarith

theorem SB_of (K N : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) : (mkParams K N).S < 2 ^ BcK K N := by
  have h := bf K N hK hN
  apply lt_Bc K N hK hN; intro X hX
  have := h.S_le; subst hX
  have := Nat.le_mul_self (2 ^ (mkParams K N).logT)
  omega

theorem zB {K N x : ℕ} (h : x < 2 ^ BcK K N) : zsz (x : ℤ) ≤ BcK K N + N := (zle h).trans (by omega)

theorem lt_BcK_of_le {K N x : ℕ} (h : x ≤ BcK K N) : x < 2 ^ BcK K N := lt_of_le_of_lt h Nat.lt_two_pow_self

theorem pow_lt_BcK {K N x : ℕ} (h : x < BcK K N) : 2 ^ x < 2 ^ BcK K N := Nat.pow_lt_pow_right (by norm_num) h

end NLogN.ST

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.ST
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
theorem solution (K N : ℕ) (hK : 20 ≤ K) (hN : NLogN.ST.n0K K ≤ N) :
    ∀ r ∈ NLogN.ST.parRegs, NLogN.zsz (NLogN.ST.parV K N r) ≤ NLogN.ST.BcK K N + N := by
  have h := NLogN.ST.bf K N hK hN
  have hP := h.pf.P_eq; have hp := h.pf.p_eq; have hlo := h.pf.lo; have he := h.pf.e1
  have hαp := h.α_le; have hdh := h.pf.dh; have hel := h.e_le
  have hqK : (mkParams K N).K = K := rfl
  have hS := NLogN.ST.SB_of K N hK hN
  have hLS := NLogN.ST.LS_of K N hK hN
  have hL1 := h.pf.L1
  have hlT := NLogN.CR.par_logT K N (by omega) (by
    have := h.pf.N_low; have : 1 ≤ 2 ^ ((mkParams K N).b - 1) := Nat.one_le_two_pow; omega)
  have hBc : (mkParams K N).P + (mkParams K N).logT + 2 ≤ NLogN.ST.BcK K N := by unfold NLogN.ST.BcK; omega
  intro r hr
  simp only [NLogN.ST.parRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl <;> simp (config := {decide := true}) only [NLogN.ST.parV, if_true, if_false]
  · exact NLogN.ST.zB hS
  · -- fn
    apply NLogN.ST.zB
    rw [h.fn_eq]
    have : (mkParams K N).P < 2 ^ (mkParams K N).P := Nat.lt_two_pow_self
    calc 4 * 2 ^ (mkParams K N).e * (mkParams K N).P < 2 ^ 2 * 2 ^ (mkParams K N).e * 2 ^ (mkParams K N).P := by
          have : 0 < 2 ^ (mkParams K N).e := by positivity
          norm_num; nlinarith
      _ = 2 ^ (2 + (mkParams K N).e + (mkParams K N).P) := by rw [pow_add, pow_add]
      _ ≤ 2 ^ NLogN.ST.BcK K N := Nat.pow_le_pow_right (by norm_num) (by omega)
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (lt_of_le_of_lt hLS hS)
  · exact NLogN.ST.zB (NLogN.ST.pow_lt_BcK (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · rw [h.TT]; exact NLogN.ST.zB (NLogN.ST.pow_lt_BcK (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.pow_lt_BcK (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.pow_lt_BcK (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.pow_lt_BcK (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · rw [← hlT]; exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact NLogN.ST.zB (lt_of_le_of_lt (by omega) hS)
  · exact NLogN.ST.zB (NLogN.ST.lt_BcK_of_le (by unfold NLogN.ST.BcK; omega))
  · exact (NLogN.zsz_natCast_le_self' N).trans (by omega)
  · exact (NLogN.zsz_natCast_le_self' _).trans ((NLogN.zsz_natCast_le_self' N).trans (by omega))
end
