  have htop : σ.top i = some (hdOf a) := by simp [St.top_eq, hi, Item.enc]
  refine (Runs.caseTop (c := catCost m - 17) ?_).mono (by simp only [catCost]; omega)
  rw [htop]
  simp only [hdOf_sel]
  have hbl := length_nbits_le hb
  have h1 := Runs.pop (I := I) (prog := prog) σ i
  set σ1 := σ.pop i
  have h2 := Runs.pop (I := I) (prog := prog) σ1 j
  set σ2 := σ1.pop j
  have h3 := Runs.move (I := I) (prog := prog) (g := g0) hqj hqt2 hjt2 σ2
    (List.replicate m 0) (1 :: Rj)
    (by simp [σ2, σ1, Ne.symm hij, hj, ruler_enc]) (g0_isSome_rep m) (g0_one Rj)
  rw [filterMap_g0, List.reverse_replicate, List.length_replicate] at h3
  set σ3 := (σ2.set j (1 :: Rj)).set t2 (List.replicate m 0 ++ σ2.stk t2)
  have h4 := Runs.pop (I := I) (prog := prog) σ3 k
  set σ4 := σ3.pop k
  have h5 := Runs.zip (I := I) (prog := prog) (q := q) (a := k) (b := t2) (d := t1) (e := j)
    hqk hqt2 hqt1 hqj hkt2 hkt1 (Ne.symm hjk) (Ne.symm ht12) (Ne.symm hjt2) (Ne.symm hjt1)
    true fFst finNone Rk (σ.stk t2) hRk ht2 0 (fun _ => le_rfl) σ4 (nbits b)
    (List.replicate m false) false
    (by
      have : (b : ℤ).natAbs = b := by simp
      simp [σ4, σ3, σ2, σ1, Ne.symm hik, Ne.symm hjk, hkt2, hk, Item.enc, zbits, this,
        show hdOf (b : ℤ) = hdPos by unfold hdOf; simp])
    (by simp [σ4, σ3, σ2, σ1, codeBit_replicate, Ne.symm hit2, Ne.symm hjt2, Ne.symm hkt2, codeBit_false])
  rw [zipL_fst _ _ hbl] at h5
  set σ5 := (((σ4.set k Rk).set t2 (σ.stk t2)).set t1
    (pushAll (finNone false) (((padL (nbits b) m).map codeBit).reverse ++ σ4.stk t1))).set j
    (if true = true then ((List.replicate m false).map codeBit).reverse ++ σ4.stk j else σ4.stk j)
  have h6 := Runs.push (I := I) (prog := prog) σ5 j hdPos
  have h7 := Runs.moveBits (I := I) (prog := prog) (q := q) (src := t1) (dst := i) hqt1 hqi
    (Ne.symm hit1) (σ5.push j hdPos) (padL (nbits b) m).reverse (σ.stk t1)
    (by simp [σ5, σ4, σ3, σ2, σ1, finNone, pushAll, List.map_reverse, hqi, hqj, hqk, hqt1, hqt2, hij, hik, hit1, hit2, hjk, hjt1, hjt2, hkt1, hkt2, ht12, hqi', hqj', hqk', hqt1', hqt2', hij', hik', hit1', hit2', hjk', hjt1', hjt2', hkt1', hkt2', ht12']) ht1
  set σ6 := ((σ5.push j hdPos).set t1 (σ.stk t1)).set i
    (((padL (nbits b) m).reverse.map codeBit).reverse ++ (σ5.push j hdPos).stk i)
  have h8 := Runs.push (I := I) (prog := prog) σ6 i (hdOf a)
  refine Runs.mono' (Runs.seq h1 (Runs.seq h2 (Runs.seq h3 (Runs.seq h4 (Runs.seq h5
    (Runs.seq h6 (Runs.seq h7 h8))))))) ?_ ?_
  · clear h1 h2 h3 h4 h5 h6 h7 h8
    have hz : a.natAbs * 2 ^ m + b ≠ 0 := by
      have : a.natAbs ≠ 0 := by omega
      positivity
    rw [St.ext_iff']; refine ⟨fun x => ?_, rfl, rfl⟩
    by_cases hxi : x = i
    · subst hxi
      simp [σ6, σ5, σ4, σ3, σ2, σ1, Item.enc, hi, List.map_reverse, hqi, hqj, hqk, hqt1, hqt2, hij, hik, hit1, hit2, hjk, hjt1, hjt2, hkt1, hkt2, ht12, hqi', hqj', hqk', hqt1', hqt2', hij', hik', hit1', hit2', hjk', hjt1', hjt2', hkt1', hkt2', ht12',
        zbits_sg, hdOf_sg, hz, nbits_cat (show a.natAbs ≠ 0 by omega) hb, zbits, natAbs_sg_eq, ha]
    by_cases hxk : x = k
    · subst hxk
