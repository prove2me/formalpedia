lemma tag_nat_frame (tag k : ℕ) (h630 : k ≠ 630) (h632 : k ≠ 632) : NatFrame (tagCode tag) k := by
  exact ⟨by simp [NatFrame,natural,writesNat,Ne.symm h632],nat_frame 5 632 k h630⟩
lemma tag_real_frame (tag k : ℕ) : RealFrame (tagCode tag) k := by
  exact ⟨by simp [RealFrame,natural,writesReal],nat_real_frame 5 632 k⟩
lemma ratio_eval {n k : ℕ} (B R N : ℕ) (p : Program) (g : Machine) (s : Data)
    (h : CoreSource.Image B R N g s) (hodd : ∃ r, R = B+2*r+1) :
    ∃ t, Eval ratioCode s 4 t ∧ CoreSource.Image B R N (cutRequest p g (CutOp.ratio (n := n) (k := k))) t := by
  have hi := (h.resume B R N p.update g s).tagged B R N 3 _ s hodd
  exact ⟨tagged 3 s,tag_eval 3 s,by simpa only [cutRequest,resume] using hi⟩
lemma erase_eval {n k : ℕ} (B R N : ℕ) (p : Program) (g : Machine) (s : Data) (e : Fin k)
    (h : CoreSource.Image B R N g s) (hodd : ∃ r, R = B+2*r+1) (hv : s.natReg 560 = 2*e.val) :
    ∃ t, Eval eraseCode s 7 t ∧ CoreSource.Image B R N (cutRequest p g (CutOp.erase (n := n) e)) t := by
  let u := tagged 1 s
  have hu : Eval (tagCode 1) s 4 u := tag_eval 1 s
  have hi := (h.resume B R N p.update g s).tagged B R N 1 _ s hodd
  have huv : u.natReg 560 = 2*e.val := (hu.nat_frame (tag_nat_frame 1 560 (by omega) (by omega))).trans hv
  have hj := hi.nat_patch B R N 6 560 e.val _ u hodd (by omega) huv
  refine ⟨natResult 6 560 u,Eval.seq hu (nat_eval 6 560 u),?_⟩
  simpa only [erase_machine,resume] using hj
lemma query_eval {n k : ℕ} (B R N source : ℕ) (p : Program) (g : Machine) (s : Data) (v : Fin n)
    (h : CoreSource.Image B R N g s) (hodd : ∃ r, R = B+2*r+1)
    (h630 : source ≠ 630) (h632 : source ≠ 632) (hv : s.natReg source = 2*v.val) :
    ∃ t, Eval (queryCode source) s 7 t ∧ CoreSource.Image B R N (cutRequest p g (CutOp.queryY (k := k) v)) t := by
  let u := tagged 5 s
  have hu : Eval (tagCode 5) s 4 u := tag_eval 5 s
  have hi := (h.resume B R N p.update g s).tagged B R N 5 _ s hodd
  have huv : u.natReg source = 2*v.val := (hu.nat_frame (tag_nat_frame 5 source h630 h632)).trans hv
  have hj := hi.nat_patch B R N 6 source v.val _ u hodd h630 huv
  refine ⟨natResult 6 source u,Eval.seq hu (nat_eval 6 source u),?_⟩
  simpa only [query_machine,resume] using hj
end DecrAlmostLinearSSSP.Decremental.CoreRequest
