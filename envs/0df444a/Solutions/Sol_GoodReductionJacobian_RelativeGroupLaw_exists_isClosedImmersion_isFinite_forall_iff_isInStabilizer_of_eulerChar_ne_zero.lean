    have hb : Function.Bijective (fun r : B =>
        ((pullback.snd f (Scheme.TwoAffineOpenCover.specMap K B)).appLE ⊤ ⊤ le_top).hom
          ((Scheme.ΓSpecIso (.of B)).inv.hom r)) := hA.bijective_algebraMap_sections_pullback B
    have hι : Function.Bijective (fun r : B => (Scheme.ΓSpecIso (.of B)).inv.hom r) := by
      refine Function.bijective_iff_has_inverse.mpr ⟨fun s => (Scheme.ΓSpecIso (.of B)).hom.hom s, fun r => ?_, fun s => ?_⟩
      · have h := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso (CommRingCat.of B)).inv_hom_id
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.coe_comp, Function.comp_apply, RingHom.id_apply] using h
      · have h := congrArg (fun φ => φ.hom s) (Scheme.ΓSpecIso (CommRingCat.of B)).hom_inv_id
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.coe_comp, Function.comp_apply, RingHom.id_apply] using h
    have happ : Function.Bijective (fun s =>
        ((pullback.snd f (Scheme.TwoAffineOpenCover.specMap K B)).appLE ⊤ ⊤ le_top).hom s) :=
      (Function.Bijective.of_comp_iff _ hι).mp hb
    have heq : (pullback.snd f (Scheme.TwoAffineOpenCover.specMap K B)).appLE ⊤ ⊤ le_top =
