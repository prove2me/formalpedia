variable (K : Type) [Field K] (G : Type) [Group G] (M : Type) [CommRing M] [Algebra K M]
  [MulSemiringAction G M] [SMulCommClass G K M] [IsDomain M]

theorem image_fracAct_range_algebraMap (g : G) :
    (fracAct G M g).toRingHom '' Set.range (algebraMap K (FractionRing M)) = Set.range (algebraMap K (FractionRing M)) := by
  ext y
  simp only [Set.mem_image, Set.mem_range, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
  constructor
  · rintro ⟨x, ⟨c, rfl⟩, rfl⟩
    exact ⟨c, by rw [← frac_smul_def, smul_algebraMap_const]⟩
  · rintro ⟨c, rfl⟩
    exact ⟨algebraMap K (FractionRing M) c, ⟨c, rfl⟩, by rw [← frac_smul_def, smul_algebraMap_const]⟩

theorem map_fracAct_closure_range_union (g : G) (T : Set (FractionRing M)) :
    (Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ T)).map (fracAct G M g).toRingHom =
      Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ (fun x => g • x) '' T) := by
  rw [RingHom.map_field_closure, Set.image_union, image_fracAct_range_algebraMap K G M g]
  rfl

theorem closure_image_closure_eq
    (Γ : Subgroup G) (s : G) {F Fℓ : Type} [Field F] [Field Fℓ]
    (φ₀ φ₁ : F → Fℓ) (ιN : F →+* FractionRing M) (ιℓ : Fℓ →+* FractionRing M)
    (h0 : ∀ x : F, ιℓ (φ₀ x) = ιN x) (h1 : ∀ x : F, ιℓ (φ₁ x) = s • ιN x)
    (hN : Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ Set.range ιN) = invariantFieldOf K G M Γ)
    (hsup : invariantFieldOf K G M Γ ⊔ invariantFieldOf K G M (Γ.map (MulAut.conj s).toMonoidHom) =
      invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom)) :
    Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪
        ιℓ '' (Subfield.closure (Set.range φ₀ ∪ Set.range φ₁) : Set Fℓ)) =
      invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom) := by

  have hr : Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪
        ιℓ '' (Subfield.closure (Set.range φ₀ ∪ Set.range φ₁) : Set Fℓ)) =
      Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ ιℓ '' (Set.range φ₀ ∪ Set.range φ₁)) := by
    apply le_antisymm
    · apply Subfield.closure_le.mpr
      rintro y (hy | ⟨x, hx, rfl⟩)
      · exact Subfield.subset_closure (Or.inl hy)
      · have hx' : ιℓ x ∈ (Subfield.closure (Set.range φ₀ ∪ Set.range φ₁)).map ιℓ := ⟨x, hx, rfl⟩
        rw [RingHom.map_field_closure] at hx'
        exact Subfield.closure_mono Set.subset_union_right hx'
    · apply Subfield.closure_mono
      rintro y (hy | ⟨x, hx, rfl⟩)
      · exact Or.inl hy
      · exact Or.inr ⟨x, Subfield.subset_closure hx, rfl⟩

  have e0 : ιℓ '' Set.range φ₀ = Set.range ιN := by
    ext y; constructor
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩; exact ⟨x, (h0 x).symm⟩
    · rintro ⟨x, rfl⟩; exact ⟨_, ⟨x, rfl⟩, h0 x⟩
  have e1 : ιℓ '' Set.range φ₁ = (fun y => s • y) '' Set.range ιN := by
    ext y; constructor
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩; exact ⟨_, ⟨x, rfl⟩, (h1 x).symm⟩
    · rintro ⟨_, ⟨x, rfl⟩, rfl⟩; exact ⟨_, ⟨x, rfl⟩, h1 x⟩

  rw [hr, Set.image_union, e0, e1, Set.union_union_distrib_left, Subfield.closure_union,
    ← map_fracAct_closure_range_union K G M s (Set.range ιN), hN,
    ← CerednikDrinfeld.Mumford.invariantFieldOf_map_conj_eq_map_fracAct K G M s Γ, hsup]

theorem closure_range_level_eq
    (Γ : Subgroup G) (s : G) {F Fℓ : Type} [Field F] [Field Fℓ]
    (φ₀ φ₁ : F → Fℓ) (ιN : F →+* FractionRing M) (ιℓ : Fℓ →+* FractionRing M)
    (hgen : Subfield.closure (Set.range φ₀ ∪ Set.range φ₁) = ⊤)
    (h0 : ∀ x : F, ιℓ (φ₀ x) = ιN x) (h1 : ∀ x : F, ιℓ (φ₁ x) = s • ιN x)
    (hN : Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ Set.range ιN) = invariantFieldOf K G M Γ)
    (hsup : invariantFieldOf K G M Γ ⊔ invariantFieldOf K G M (Γ.map (MulAut.conj s).toMonoidHom) =
      invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom)) :
    Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ Set.range ιℓ) =
      invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom) := by
  rw [← closure_image_closure_eq K G M Γ s φ₀ φ₁ ιN ιℓ h0 h1 hN hsup, hgen, Subfield.coe_top, Set.image_univ]

theorem closure_range_union_eq_top
    (Γ : Subgroup G) (s : G)
    (k : Type) [Field k] {F Fℓ : Type} [Field F] [Field Fℓ] [Algebra F Fℓ] [Module.Finite F Fℓ]
    [Algebra k F] [Algebra k Fℓ] [IsScalarTower k F Fℓ]
    [Algebra k K] [Algebra k (FractionRing M)] [IsScalarTower k K (FractionRing M)]
    (φ₁ : F → Fℓ) (ιN : F →+* FractionRing M) (ιℓ : Fℓ →+* FractionRing M)
    (h0 : ∀ x : F, ιℓ (algebraMap F Fℓ x) = ιN x) (h1 : ∀ x : F, ιℓ (φ₁ x) = s • ιN x)
    (hN : Subfield.closure (Set.range (algebraMap K (FractionRing M)) ∪ Set.range ιN) = invariantFieldOf K G M Γ)
    (hsup : invariantFieldOf K G M Γ ⊔ invariantFieldOf K G M (Γ.map (MulAut.conj s).toMonoidHom) =
      invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom))
    (hdeg : Module.finrank F Fℓ ≤ Subfield.relfinrank (invariantFieldOf K G M Γ)
      (invariantFieldOf K G M (Γ ⊓ Γ.map (MulAut.conj s).toMonoidHom))) :
    Subfield.closure (Set.range (algebraMap F Fℓ) ∪ Set.range φ₁) = ⊤ := by
  set E' : IntermediateField F Fℓ := IntermediateField.adjoin F (Set.range φ₁) with hE'
  have hE'sub : E'.toSubfield = Subfield.closure (Set.range (algebraMap F Fℓ) ∪ Set.range φ₁) :=
    IntermediateField.adjoin_toSubfield F (Set.range φ₁)

  let ι' : E' →+* FractionRing M := ιℓ.comp E'.toSubfield.subtype
  have hι' : ∀ x : F, ι' (algebraMap F E' x) = ιN x := fun x => h0 x
  have hrange : Set.range ι' = ιℓ '' (Subfield.closure (Set.range (algebraMap F Fℓ) ∪ Set.range φ₁) : Set Fℓ) := by
    rw [← hE'sub]
    ext y; constructor
    · rintro ⟨x, rfl⟩; exact ⟨x, x.2, rfl⟩
    · rintro ⟨x, hx, rfl⟩; exact ⟨⟨x, hx⟩, rfl⟩

  have hL3' := Subfield.relfinrank_closure_le_finrank_of_comp k F E' K (FractionRing M) ιN ι' hι'
  rw [hrange, closure_image_closure_eq K G M Γ s (algebraMap F Fℓ) φ₁ ιN ιℓ h0 h1 hN hsup, hN] at hL3'

  haveI : FiniteDimensional F (⊤ : IntermediateField F Fℓ) :=
    Module.Finite.equiv (IntermediateField.topEquiv (F := F) (E := Fℓ)).symm.toLinearEquiv
  have htop : E' = ⊤ := IntermediateField.eq_of_le_of_finrank_le le_top
    (by rw [IntermediateField.finrank_top']; exact hdeg.trans hL3')
  rw [← hE'sub, htop]
  exact IntermediateField.top_toSubfield

theorem mem_map_subtype_iff {G' : Type} [Group G'] (K' : Subgroup G') (H : Subgroup K') (x : K') :
    (x : G') ∈ H.map K'.subtype ↔ x ∈ H := by
  constructor
  · rintro ⟨y, hy, hyx⟩; rwa [← Subtype.ext hyx]
  · exact fun h => ⟨x, h, rfl⟩

theorem exists_normal_finiteIndex_le {G' : Type} [Group G'] (Γ H : Subgroup G') (hH : H.relIndex Γ ≠ 0) :
    ∃ Nm : Subgroup G', Nm ≤ H ∧ Nm ≤ Γ ∧ (∀ γ ∈ Γ, ∀ n ∈ Nm, γ * n * γ⁻¹ ∈ Nm) ∧ Nm.relIndex Γ ≠ 0 ∧
      (∀ z ∈ Γ, z ∈ H → (∀ b ∈ Γ, b * z * b⁻¹ = z) → z ∈ Nm) := by
  haveI : (H.subgroupOf Γ).FiniteIndex := ⟨hH⟩
  have hsub : ((H.subgroupOf Γ).normalCore.map Γ.subtype).subgroupOf Γ = (H.subgroupOf Γ).normalCore := by
    ext y; exact (Subgroup.mem_subgroupOf).trans (mem_map_subtype_iff _ _ y)
  refine ⟨(H.subgroupOf Γ).normalCore.map Γ.subtype, ?_, ?_, ?_, ?_, ?_⟩
  · rintro x ⟨y, hy, rfl⟩
    exact Subgroup.mem_subgroupOf.1 (Subgroup.normalCore_le _ hy)
  · rintro x ⟨y, -, rfl⟩; exact y.2
  · rintro γ hγ n ⟨y, hy, rfl⟩
    exact ⟨⟨γ, hγ⟩ * y * ⟨γ, hγ⟩⁻¹, (Subgroup.normalCore_normal _).conj_mem y hy ⟨γ, hγ⟩, rfl⟩
  · change (Subgroup.subgroupOf _ Γ).index ≠ 0
    rw [hsub]; exact Subgroup.FiniteIndex.index_ne_zero
  · intro z hzΓ hzH hcent
    refine (mem_map_subtype_iff _ _ ⟨z, hzΓ⟩).2 fun b => ?_
    rw [Subgroup.mem_subgroupOf]
    have hb : ((b * ⟨z, hzΓ⟩ * b⁻¹ : ↥Γ) : G') = z := hcent b b.2
    rw [hb]; exact hzH

theorem smul_mem_invariantFieldOf_of_normalizes {Γ : Subgroup G} {u : G}
    (hun : ∀ γ ∈ Γ, u⁻¹ * γ * u ∈ Γ) {z : FractionRing M} (hz : z ∈ invariantFieldOf K G M Γ) :
    u • z ∈ invariantFieldOf K G M Γ := by
  intro γ hγ
  have h := hz (u⁻¹ * γ * u) (hun γ hγ)
  calc γ • u • z = u • ((u⁻¹ * γ * u) • z) := by
        rw [← mul_smul, ← mul_smul]; congr 1; group
    _ = u • z := by rw [h]

theorem ringHom_level_intertwining
    (Γ : Subgroup G) (s u uℓ : G) {F Fℓ : Type} [Field F] [Field Fℓ]
    (φ₀ φ₁ : F → Fℓ) (ιN : F →+* FractionRing M) (ιℓ : Fℓ →+* FractionRing M)
    (hgen : Subfield.closure (Set.range φ₀ ∪ Set.range φ₁) = ⊤)
    (h0 : ∀ x : F, ιℓ (φ₀ x) = ιN x) (h1 : ∀ x : F, ιℓ (φ₁ x) = s • ιN x)
    (hN : ∀ x : F, ιN x ∈ invariantFieldOf K G M Γ)
    (gN : F → F) (gℓ : Fℓ →+* Fℓ) (hg0 : ∀ x : F, gℓ (φ₀ x) = φ₀ (gN x)) (hg1 : ∀ x : F, gℓ (φ₁ x) = φ₁ (gN x))
    (σ : FractionRing M →+* FractionRing M) (hσ : ∀ (g : G) (y : FractionRing M), σ (g • y) = g • σ y)
    (hIN : ∀ x : F, ιN (gN x) = u • σ (ιN x))
    (hun : ∀ γ ∈ Γ, u⁻¹ * γ * u ∈ Γ) (h6 : uℓ * u⁻¹ ∈ Γ) (h8 : s⁻¹ * uℓ * s * u⁻¹ ∈ Γ) :
    ∀ x : Fℓ, ιℓ (gℓ x) = uℓ • σ (ιℓ x) := by

  let f : Fℓ →+* FractionRing M := ιℓ.comp gℓ
  let g : Fℓ →+* FractionRing M := (MulSemiringAction.toRingHom G (FractionRing M) uℓ).comp (σ.comp ιℓ)
  have hf : ∀ x, f x = ιℓ (gℓ x) := fun x => rfl
  have hg : ∀ x, g x = uℓ • σ (ιℓ x) := fun x => rfl

  have hσN : ∀ x : F, σ (ιN x) ∈ invariantFieldOf K G M Γ := by
    intro x γ hγ
    rw [← hσ, hN x γ hγ]

  have huz : ∀ x : F, u • σ (ιN x) ∈ invariantFieldOf K G M Γ := fun x =>
    smul_mem_invariantFieldOf_of_normalizes K G M hun (hσN x)

  have hagree : (Set.range φ₀ ∪ Set.range φ₁).EqOn f g := by
    rintro y (⟨x, rfl⟩ | ⟨x, rfl⟩)
    ·
      show f (φ₀ x) = g (φ₀ x)
      rw [hf, hg, hg0, h0, h0, hIN]
      have : uℓ = (uℓ * u⁻¹) * u := by group
      conv_rhs => rw [this, mul_smul, (huz x) (uℓ * u⁻¹) h6]
    ·
      show f (φ₁ x) = g (φ₁ x)
      rw [hf, hg, hg1, h1, h1, hIN, hσ]
      have key : (s⁻¹ * uℓ * s * u⁻¹) • u • σ (ιN x) = u • σ (ιN x) := (huz x) _ h8
      calc s • u • σ (ιN x) = s • ((s⁻¹ * uℓ * s * u⁻¹) • u • σ (ιN x)) := by rw [key]
        _ = (s * (s⁻¹ * uℓ * s * u⁻¹) * u) • σ (ιN x) := by simp only [mul_smul]
        _ = (uℓ * s) • σ (ιN x) := by congr 1; group
        _ = uℓ • s • σ (ιN x) := mul_smul _ _ _
  have hfg : f = g := RingHom.eq_of_eqOn_of_field_closure_eq_top hgen hagree
  intro x
  rw [← hf, ← hg, hfg]

end CerednikDrinfeld.LevelUp

