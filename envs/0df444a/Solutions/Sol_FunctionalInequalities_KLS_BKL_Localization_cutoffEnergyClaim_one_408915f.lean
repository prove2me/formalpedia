  apply Covariance.inner_operator_self_pos_of_affineSupport_eq_top_408915f (compactPosterior μ hc c Q)
    (compactPosterior_memLp_id_two μ hc c Q) ?_ hv
  rw [compactPosterior_affineSupport, hfull]
