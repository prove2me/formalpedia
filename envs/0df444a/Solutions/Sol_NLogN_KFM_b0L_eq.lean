theorem solution (p s t α : ℕ) (hs : 0 < s) (hst : s ≤ t) (V : List (ℤ × ℤ)) :
    NLogN.KFM.b0L p s t α V = NLogN.Rsp.dapL p s t α (NLogN.Rsp.japL p s t α (NLogN.Rsp.cselL s t V)) := by
  unfold NLogN.KFM.b0L NLogN.Rsp.dapL
  apply List.map_congr_left
  intro l hl
  rw [List.mem_range] at hl
  simp only [NLogN.KFM.B0approx, IntMul.HvdH.Dapprox]
  have hJ : (NLogN.Rsp.japL p s t α (NLogN.Rsp.cselL s t V)).getD l (0, 0) =
      IntMul.HvdH.Japprox p s t α (IntMul.HvdH.cSel s t fun j => V.getD j (0, 0)) l := by
    rw [List.getD_eq_getElem _ _ (by simp [NLogN.Rsp.japL_length]; exact hl)]
    simp only [NLogN.Rsp.japL, List.getElem_map, List.getElem_range]
    apply NLogN.Rsp.Japprox_congr p s t α hs _ _ _ l hl
    intro i hi
    rw [List.getD_eq_getElem _ _ (by simp [NLogN.Rsp.cselL_length]; exact hi)]
    have hc := NLogN.Rsp.cR_lt s t i hs hst hi
    simp only [NLogN.Rsp.cselL, List.getElem_map, List.getElem_range, IntMul.HvdH.cSel, Nat.mod_eq_of_lt hi]
    rw [ZMod.val_natCast, Nat.mod_eq_of_lt (by unfold NLogN.Rsp.cR at hc; exact hc)]
    rfl
  rw [hJ]
