theorem QFS.limsup_lintegral_le_of_dominant {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {g G : ℕ → X → ℝ≥0∞} {gl Gl : X → ℝ≥0∞}
    (hgm : ∀ n, Measurable (g n)) (hGm : ∀ n, Measurable (G n)) (hglm : Measurable gl)
    (hGlm : Measurable Gl)
    (hle : ∀ n, g n ≤ G n)
    (hgt : ∀ᵐ a ∂μ, Tendsto (fun n => g n a) atTop (𝓝 (gl a)))
    (hGt : ∀ᵐ a ∂μ, Tendsto (fun n => G n a) atTop (𝓝 (Gl a)))
    (hGeq : ∀ n, ∫⁻ a, G n a ∂μ = ∫⁻ a, Gl a ∂μ)
    (hfin : ∫⁻ a, Gl a ∂μ ≠ ∞) :
    limsup (fun n => ∫⁻ a, g n a ∂μ) atTop ≤ ∫⁻ a, gl a ∂μ := by sorry
