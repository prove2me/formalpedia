theorem sU {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (hR : Rd c e) (hc : e.Clean)
    (ho : okR v c e) {V B : ℕ} (hv : ∀ j ∈ e.regs, |tp v c j| ≤ V) (hm : mg V e < 2 ^ B) :
    Sp (.push i e) (encK s (RF v c)) (encK s (RF v (Function.update c i (ev v c e :: c i))))
      (cE e B) := by
