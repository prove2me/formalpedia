theorem solution
    (p : ℕ) [Fact p.Prime] (𝔛 : DRModelPackage p) :
    ∃ 𝔉 : SmoothProperCurve.FiniteMapData
        (baseChange ℤ (DRModel.toBase p) (Localization.Away (p : ℤ)))
        (sectionBaseChange (Localization.Away (p : ℤ)) 𝔛.εinf),
      1 ≤ 𝔉.m := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  haveI : IsProper (DRModel.toBase p) := 𝔛.isProper
  haveI : IsProper (baseChange ℤ (DRModel.toBase p) (Localization.Away (p : ℤ))) := inferInstance
  haveI := ModularCurve.L3T.smoothOfRelativeDimension_one_baseChange_away p 𝔛
  haveI : GeometricallyIntegral (baseChange ℤ (DRModel.toBase p) (Localization.Away (p : ℤ))) :=
    ModularCurve.geometricallyIntegral_baseChangeToBase_twoChartIntegralModel_away p

  obtain ⟨𝒱₀, -, -⟩ := AlgebraicCurve.TwoChartIntegralModel.exists_twoAffineOpenCover_U0_eq_chartFinOpen ℤ
    ↥(modularFunctionFieldFull p) (IgusaScheme.jFull p)
  let 𝒱 : (pullback (DRModel.toBase p) (specMap ℤ (Localization.Away (p : ℤ)))).TwoAffineOpenCover :=
    𝒱₀.pullback (DRModel.toBase p) (Localization.Away (p : ℤ))

