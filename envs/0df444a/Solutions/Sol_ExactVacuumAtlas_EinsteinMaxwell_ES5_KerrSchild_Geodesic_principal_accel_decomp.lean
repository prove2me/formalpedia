variable (B D A H W : ℝ → ℝ)

/-- Actual lowering of an aligned vector `(0, c₁, 0, c₃, c₃)`. -/
theorem esMetric_mulVec_aligned (y : Pt 5) (c1 c3 : ℝ) :
    metricMatrix (esMetric B D A H W) y *ᵥ ![0, c1, 0, c3, c3] =
      ![-(H (y 1) * W (y 1) * c3), D (y 1) * c1, 0, H (y 1) * y 2 * c3,
        H (y 1) * (1 - y 2) * c3] := by
  funext b
  fin_cases b <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_five, metricMatrix, esMetric] <;>
    ring

variable {B D A H W}

/-- Upper-index vectors are determined by their actual lowering on the actual domain. -/
theorem esMetric_mulVec_injective {R : Set ℝ} {Φ Ψ : ℝ → ℝ} (hE : ESData R B D A H W Φ Ψ)
    {x : Pt 5} (hx : x ∈ esDomain R) {v v' : Fin 5 → ℝ}
    (h : metricMatrix (esMetric B D A H W) x *ᵥ v = metricMatrix (esMetric B D A H W) x *ᵥ v') :
    v = v' := by
  obtain ⟨hB, hD, hA, hH, hu, hv⟩ := hE.nz hx
  have hinv := esInverse_mul B D A H W x hB hD hA hH hu hv
  calc v = (metricMatrix (esInverse B D A H W) x * metricMatrix (esMetric B D A H W) x) *ᵥ v := by
        rw [hinv, Matrix.one_mulVec]
    _ = (metricMatrix (esInverse B D A H W) x * metricMatrix (esMetric B D A H W) x) *ᵥ v' := by
        rw [← Matrix.mulVec_mulVec, h, Matrix.mulVec_mulVec]
    _ = v' := by rw [hinv, Matrix.one_mulVec]

end ES5

