    have h2 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.C (σ₁ (ϖt ^ (q + 1))) * v₁ - f₁ * u₁})) h1
    rw [Ideal.map_span] at h2
    refine Ideal.span_mono ?_ h2
    rintro _ ⟨x, hx, rfl⟩
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)
  have hiJ : iC ∈ J := by
