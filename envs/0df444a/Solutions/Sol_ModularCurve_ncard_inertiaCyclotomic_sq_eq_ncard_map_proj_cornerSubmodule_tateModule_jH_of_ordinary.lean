  have h0 : PadicInt.toZMod (a p σ) = 1 := by
    have := toZMod_eq_zero_of_dvd p hdvd
    rwa [map_sub, map_one, sub_eq_zero] at this
  rw [h0] at hmod

  have h5 : ((1 : ℕ) : ZMod p) = ((p - 1 : ℕ) : ZMod p) := by simpa using hmod
  rw [ZMod.natCast_eq_natCast_iff'] at h5
  rw [Nat.mod_eq_of_lt hp.one_lt, Nat.mod_eq_of_lt (Nat.sub_lt hp.pos Nat.one_pos)] at h5
