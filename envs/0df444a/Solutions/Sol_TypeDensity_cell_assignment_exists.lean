theorem solution (k : Type) [Field k] [Finite k] (s : TypeDensity.State) (hs : s.Valid)
    (P : TypeDensity.TangentPattern s.degree) (hP : TypeDensity.Allowed s P) (Dv : TypeDensity.ExceptionalDivisor k)
    (hDv : TypeDensity.HasPattern k s Dv P) :
    Nonempty (TypeDensity.CellAssignment k s P Dv) := by
  classical
  let g' : TypeDensity.ClosedDirection k → ℕ × TypeDensity.State :=
    fun Q ↦ (TypeDensity.directionDegree k Q, TypeDensity.pointChildState k s P.d.val Dv Q)
  let g : {Q // 0 < Dv Q} → ℕ × TypeDensity.State := fun Q ↦ g' Q.1
  have : Finite {Q // 0 < Dv Q} :=
    (Dv.support.finite_toSet.subset fun Q hQ ↦
      Finsupp.mem_support_iff.2 (Nat.pos_iff_ne_zero.1 hQ)).to_subtype
  have hlist (b : Prop) [Decidable b] (x c : ℕ × TypeDensity.State) :
      (if b then [] else [x]).count c = if (¬ b ∧ x = c) then 1 else 0 := by
    by_cases hb : b <;> by_cases hx : x = c <;> simp [hb, hx]
  have hnz : TypeDensity.zeroDirection k ≠ TypeDensity.infinityDirection k := by simp [TypeDensity.zeroDirection, TypeDensity.infinityDirection]
  have key : ∀ c, (TypeDensity.children s P).count c = (Dv.support.filter (fun Q ↦ g' Q = c)).card := by
    intro c
    rw [← Finset.card_filter_add_card_filter_not (s := Dv.support.filter (fun Q ↦ g' Q = c))
      (fun Q ↦ Q ∈ TypeDensity.boundaryDirections k s), Finset.filter_filter, Finset.filter_filter]
    have hB := TypeDensity.otherChildren_count_eq_card k s P Dv hDv s.weight ?_ c
    rotate_left
    · intro Q hQ
      cases s <;> simp_all [TypeDensity.pointChildState, TypeDensity.boundaryDirections, TypeDensity.State.weight]
    rw [← hB]
    have hA : ∀ (T : Finset (TypeDensity.ClosedDirection k)), (∀ Q, Q ∈ TypeDensity.boundaryDirections k s ↔ Q ∈ T) →
        (Dv.support.filter (fun Q ↦ g' Q = c ∧ Q ∈ TypeDensity.boundaryDirections k s)).card =
          ∑ Q ∈ T, if (0 < Dv Q ∧ g' Q = c) then 1 else 0 := by
      intro T hT
      rw [← Finset.card_filter]
      congr 1
      ext Q
      simp only [Finset.mem_filter, Finsupp.mem_support_iff, hT, Nat.pos_iff_ne_zero]
      tauto
    obtain ⟨hdeg, hrt, hrx, -⟩ := hDv
    cases s with
    | single a c0 =>
      rw [hA {TypeDensity.infinityDirection k} (by intro Q; simp [TypeDensity.boundaryDirections])]
      simp only [TypeDensity.children, List.count_append, hlist, Finset.sum_singleton]
      congr 1
      simp only [g', TypeDensity.pointChildState, if_true, hrt]
      simp only [TypeDensity.infinityDirection, TypeDensity.directionDegree] at hrt ⊢
      simp only [Nat.pos_iff_ne_zero]
    | crossing a b c0 h0 =>
      rw [hA {TypeDensity.infinityDirection k, TypeDensity.zeroDirection k} (by intro Q; simp [TypeDensity.boundaryDirections]),
        Finset.sum_pair hnz.symm]
      simp only [TypeDensity.children, List.count_append, hlist]
      simp only at hrx
      congr 1
      have hzi : TypeDensity.zeroDirection k = TypeDensity.infinityDirection k ↔ False := ⟨hnz, False.elim⟩
      simp only [g', TypeDensity.pointChildState, if_true, hzi, if_false, hrt, hrx]
      simp only [TypeDensity.infinityDirection, TypeDensity.directionDegree, TypeDensity.zeroDirection, Polynomial.natDegree_X,
        Nat.pos_iff_ne_zero]
  obtain ⟨e, he⟩ := TypeDensity.equiv_of_fiber_card_eq (Fin (TypeDensity.children s P).length) {Q // 0 < Dv Q} (ℕ × TypeDensity.State)
    (TypeDensity.children s P).get g (fun c ↦ by
      rw [TypeDensity.list_get_fiber_card_count]
      refine Eq.trans (by rw [TypeDensity.beq_inst_eq]) ((key c).trans ?_)
      rw [Nat.card_congr
          (Equiv.subtypeSubtypeEquivSubtypeInter (fun Q ↦ 0 < Dv Q) (fun Q ↦ g' Q = c)),
        TypeDensity.natCard_subtype_eq_filter_card Dv.support _
          (fun Q hQ ↦ Finsupp.mem_support_iff.mpr (by omega))]
      congr 1
      ext Q
      simp only [Finset.mem_filter, Finsupp.mem_support_iff, Nat.pos_iff_ne_zero]
      tauto)
  exact ⟨{ pt := fun j ↦ (e j).1
           inj := fun i j hij ↦ e.injective (Subtype.ext hij)
           supp := fun Q ↦ ⟨fun hQ ↦ ⟨e.symm ⟨Q, hQ⟩, by simp⟩, by rintro ⟨j, rfl⟩; exact (e j).2⟩
           deg := fun j ↦ congrArg Prod.fst (he j)
           state := fun j ↦ (congrArg Prod.snd (he j)).symm }⟩
