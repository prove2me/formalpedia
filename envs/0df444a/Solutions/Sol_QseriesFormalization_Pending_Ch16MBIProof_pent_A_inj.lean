private theorem even_pent_A_succ (a : ℕ) :
    2 ∣ (a + 1) * (3 * a + 2) := by
  induction a with
  | zero => exact ⟨1, by decide⟩
  | succ n ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m + 3 * n + 4, by nlinarith⟩

