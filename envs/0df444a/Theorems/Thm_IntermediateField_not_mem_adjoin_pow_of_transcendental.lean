theorem IntermediateField.not_mem_adjoin_pow_of_transcendental
    (K : Type u) [Field K] (L : Type v) [Field L] [Algebra K L] (y : L) (hy : Transcendental K y)
    (n : ℕ) (hn : 2 ≤ n) :
    y ∉ IntermediateField.adjoin K ({y ^ n} : Set L) := by sorry
