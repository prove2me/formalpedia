theorem reductionModL_smul_eq_zero (t : HeckeAlg) (z : JZero p)
    (hz : reductionModL B p z = 0) :
    reductionModL B p (letI := heckeModuleBar p; t • z) = 0 := by
  letI := heckeModuleBar p
  have hcomm := heckeOperatorsCommuteBar p
  induction t using MvPolynomial.induction_on generalizing z with
  | C a =>
    rw [heckeModuleBar_C_smul, map_zsmul, hz, zsmul_zero]
  | add f g hf hg =>
    rw [add_smul, map_add, hf z hz, hg z hz, add_zero]
  | mul_X f ℓ hf =>
    rw [mul_smul]
    have hX : ((MvPolynomial.X ℓ : HeckeAlg) • z) = heckeOperatorBar p ℓ z :=
      heckeModuleBar_heckeGen_smul hcomm ℓ z
    rw [hX]
    exact hf _ (reductionModL_heckeOperatorBar_eq_zero p h2n B hB ℓ z hz)

