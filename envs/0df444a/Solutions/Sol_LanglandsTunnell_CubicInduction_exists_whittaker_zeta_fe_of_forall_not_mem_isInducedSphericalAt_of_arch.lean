variable (K : Type) [Field K] [NumberField K]
variable (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)

variable (hdeg : Module.finrank ℚ K = 3) (v : HeightOneSpectrum (𝓞 ℚ))
  (he : ∀ 𝔓 ∈ primeFibre ℚ K v, v.asIdeal.ramificationIdx' 𝔓.asIdeal = 1)

include hdeg he in

private theorem sum_inertiaDeg_eq_three :
    ∑ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset, v.asIdeal.inertiaDeg' 𝔓.asIdeal = 3 := by
  rw [← hdeg, ← FibreDegree.sum_toFinset_ramificationIdx_mul_inertiaDeg K v]
  refine sum_congr rfl fun 𝔓 h𝔓 => ?_
  rw [he 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓), one_mul]

include hdeg he in

private theorem inertiaDeg_le_three_of_mem (𝔓 : HeightOneSpectrum (𝓞 K)) (h𝔓 : 𝔓 ∈ primeFibre ℚ K v) :
    v.asIdeal.inertiaDeg' 𝔓.asIdeal ≤ 3 := by
  rw [← sum_inertiaDeg_eq_three K hdeg v he]
  exact single_le_sum (f := fun 𝔓 : HeightOneSpectrum (𝓞 K) => v.asIdeal.inertiaDeg' 𝔓.asIdeal)
    (fun _ _ => Nat.zero_le _) ((FibreDegree.primeFibre_finite K v).mem_toFinset.mpr h𝔓)

include hdeg he in

private theorem inducedE3_eq (c : HeightOneSpectrum (𝓞 K) → ℂ) :
    inducedE3 ℚ c v =
      (-1) ^ ((FibreDegree.primeFibre_finite K v).toFinset.card + 1) *
        ∏ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset, c 𝔓 := by
  have hcoeff : ∀ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset,
      (inducedFactor ℚ c 𝔓).coeff (v.asIdeal.inertiaDeg' 𝔓.asIdeal) = -c 𝔓 := by
    intro 𝔓 h𝔓
    have hv : 𝔓.under (𝓞 ℚ) = v := (FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓
    have hf0 := FibreDegree.inertiaDeg_pos_of_mem_primeFibre K v 𝔓
      ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓)
    rw [inducedFactor, hv, coeff_sub, coeff_C, if_neg hf0.ne', coeff_C_mul_X_pow, if_pos rfl, zero_sub]
  have hdegle : ∀ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset,
      (inducedFactor ℚ c 𝔓).natDegree ≤ v.asIdeal.inertiaDeg' 𝔓.asIdeal := by
    intro 𝔓 h𝔓
    have hv : 𝔓.under (𝓞 ℚ) = v := (FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓
    have := FibreDegree.natDegree_inducedFactor_le K c 𝔓
    rwa [hv] at this
  rw [inducedE3, inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ (FibreDegree.primeFibre_finite K v),
    ← sum_inertiaDeg_eq_three K hdeg v he, coeff_prod_sum_of_natDegree_le _ _ _ hdegle, prod_congr rfl hcoeff,
    prod_congr rfl fun 𝔓 _ => neg_eq_neg_one_mul (c 𝔓), prod_mul_distrib, prod_const, pow_succ]
  ring

section

variable [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem stdRootNumberAt_twist_eq (p : HeightOneSpectrum (𝓞 ℚ)) (𝔓 : HeightOneSpectrum (𝓞 K))
    (hv : 𝔓.under (𝓞 ℚ) = p) (hep : p.asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hf : p.asIdeal.inertiaDeg' 𝔓.asIdeal ≤ 3) (hf0 : 0 < p.asIdeal.inertiaDeg' 𝔓.asIdeal)
    (hμ : IsUnramifiedCharAt μ 𝔓) (hμu : IsUnitaryChar (𝓞 K) K μ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (a : ℕ)
    (ha : HasConductorExponentAt ℚ p (localChar χ p) a) :
    stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      ((localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂˣ) : ℂ) ^ a *
        ((-1) ^ (a * (p.asIdeal.inertiaDeg' 𝔓.asIdeal + 1)) *
          stdRootNumberAt ℚ p (localChar χ p) ^ p.asIdeal.inertiaDeg' 𝔓.asIdeal) := by
  subst hv
  have hsplit := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
  have hχϖ := norm_localChar_apply_eq_one hχu (𝔓.under (𝓞 ℚ)) (uniformizerUnit ℚ (𝔓.under (𝓞 ℚ)))
  have hcases : (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal = 1 ∨ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal = 2 ∨
      (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal = 3 := by omega
  rcases hcases with h1 | h2 | h3
  · have hrow := stdRootNumberAt_comp_norm_of_inertiaDeg_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ hep h1 _ a ha hχϖ
    rw [TwistConstants.stdRootNumberAt_mul_comp_idelicNorm K μ χ 𝔓 hμ hep a _ hsplit hrow.1 (hχu _) (hμu _),
      addCharLevel_psiLocal_rat, add_zero, zpow_natCast, show stdRootNumberAt K 𝔓 _ = _ from hrow.2, h1, pow_mul']
    norm_num
  · have hrow := stdRootNumberAt_comp_norm_of_inertiaDeg_eq_two ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ hep h2 _ a ha hχϖ
    rw [TwistConstants.stdRootNumberAt_mul_comp_idelicNorm K μ χ 𝔓 hμ hep a _ hsplit hrow.1 (hχu _) (hμu _),
      addCharLevel_psiLocal_rat, add_zero, zpow_natCast, show stdRootNumberAt K 𝔓 _ = _ from hrow.2, h2, pow_mul']
    norm_num
  · have hrow := stdRootNumberAt_comp_norm_of_inertiaDeg_eq_three ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ hep h3 _ a ha hχϖ
    rw [TwistConstants.stdRootNumberAt_mul_comp_idelicNorm K μ χ 𝔓 hμ hep a _ hsplit hrow.1 (hχu _) (hμu _),
      addCharLevel_psiLocal_rat, add_zero, zpow_natCast, show stdRootNumberAt K 𝔓 _ = _ from hrow.2, h3, pow_mul']
    norm_num

include hdeg he in

private theorem prod_stdRootNumberAt_twist_eq (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (hμu : IsUnitaryChar (𝓞 K) K μ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (a : ℕ)
    (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∏ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset,
        stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      (∏ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset, ((localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂˣ) : ℂ)) ^ a *
        ((-1) ^ (a * (3 + (FibreDegree.primeFibre_finite K v).toFinset.card)) *
          stdRootNumberAt ℚ v (localChar χ v) ^ 3) := by
  rw [prod_congr rfl fun 𝔓 h𝔓 => stdRootNumberAt_twist_eq K μ χ v 𝔓
      ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓)
      (he 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓))
      (inertiaDeg_le_three_of_mem K hdeg v he 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓))
      (FibreDegree.inertiaDeg_pos_of_mem_primeFibre K v 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓))
      (hμ 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓)) hμu hχu a ha,
    prod_mul_distrib, prod_mul_distrib, prod_pow, prod_pow_eq_pow_sum, prod_pow_eq_pow_sum, ← mul_sum,
    sum_inertiaDeg_eq_three K hdeg v he]
  have hs : ∑ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset, (v.asIdeal.inertiaDeg' 𝔓.asIdeal + 1) =
      3 + (FibreDegree.primeFibre_finite K v).toFinset.card := by
    rw [sum_add_distrib, sum_inertiaDeg_eq_three K hdeg v he]
    simp
  rw [hs]

include hdeg he in

private theorem prod_stdRootNumberAt_twist_eq_inducedE3_pow_mul (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓)
    (hμu : IsUnitaryChar (𝓞 K) K μ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (a : ℕ)
    (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∏ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset,
        stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      inducedE3 ℚ (inducedCoeff K μ) v ^ a * stdRootNumberAt ℚ v (localChar χ v) ^ 3 := by
  rw [prod_stdRootNumberAt_twist_eq K μ χ hdeg v he hμ hμu hχu a ha, inducedE3_eq K hdeg v he,
    prod_congr rfl fun 𝔓 h𝔓 =>
      (by rw [inducedCoeff, if_pos (hμ 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓))]; rfl :
        inducedCoeff K μ 𝔓 = ((localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂˣ) : ℂ)),
    mul_pow, show a * (3 + (FibreDegree.primeFibre_finite K v).toFinset.card) =
      ((FibreDegree.primeFibre_finite K v).toFinset.card + 1) * a + 2 * a by ring,
    pow_add, pow_mul (-1 : ℂ) 2, neg_one_sq, one_pow, mul_one, pow_mul]
  ring

include hdeg he in

private theorem finsum_inertiaDeg_mul_pinnedExp_twist_eq (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓) (a : ℕ)
    (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∑ᶠ 𝔓 ∈ primeFibre ℚ K v,
        (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      3 * a := by
  rw [finsum_mem_eq_finite_toFinset_sum _ (FibreDegree.primeFibre_finite K v)]
  have hpin : ∀ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset,
      (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
        (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * a := by
    intro 𝔓 h𝔓
    have hmem := (FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓
    have hv : 𝔓.under (𝓞 ℚ) = v := hmem
    subst hv
    rw [TwistConstants.pinnedExp_mul_comp_idelicNorm K μ χ 𝔓 (hμ 𝔓 hmem) (he 𝔓 hmem) a ha, addCharLevel_psiLocal_rat,
      add_zero]
  have h3 : ∑ 𝔓 ∈ (FibreDegree.primeFibre_finite K v).toFinset, (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) = 3 := by
    exact_mod_cast sum_inertiaDeg_eq_three K hdeg v he
  rw [sum_congr rfl hpin, ← sum_mul, h3]

end

