theorem pmSeq_eq (s : ℕ) (g : ℕ → ℕ) (hs : 2 ≤ s) :
    ∀ k, pmSeq s g k = (∏ t ∈ Finset.range k, g t) % s
  | 0 => by simp [pmSeq, Nat.mod_eq_of_lt (by omega : 1 < s)]
  | k + 1 => by
    rw [pmSeq, pmSeq_eq s g hs k, Finset.prod_range_succ, Nat.mod_mul_mod]

