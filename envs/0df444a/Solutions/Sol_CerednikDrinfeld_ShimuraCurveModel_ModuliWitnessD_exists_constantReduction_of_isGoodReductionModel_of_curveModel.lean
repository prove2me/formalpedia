theorem isPullback_LR {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    IsPullback (pullback.fst (pullback.snd f (Spec.map (CommRingCat.ofHom i))) (Spec.map (CommRingCat.ofHom φ)) ≫
        pullback.fst f (Spec.map (CommRingCat.ofHom i)))
      (pullback.snd (pullback.snd f (Spec.map (CommRingCat.ofHom i))) (Spec.map (CommRingCat.ofHom φ)))
      f (Spec.map (CommRingCat.ofHom (φ.comp i))) := by
  have h := ((IsPullback.of_hasPullback (pullback.snd f (Spec.map (CommRingCat.ofHom i))) (Spec.map (CommRingCat.ofHom φ))).paste_horiz
    (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom i))))
  rw [CommRingCat.ofHom_comp, Spec.map_comp]
  exact h

noncomputable def isoLR {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    pullback (pullback.snd f (Spec.map (CommRingCat.ofHom i))) (Spec.map (CommRingCat.ofHom φ)) ≅
      pullback f (Spec.map (CommRingCat.ofHom (φ.comp i))) :=
  (isPullback_LR f i φ).isoPullback

@[scoped simp] theorem isoLR_hom_fst {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    (isoLR f i φ).hom ≫ pullback.fst f (Spec.map (CommRingCat.ofHom (φ.comp i))) =
      pullback.fst _ _ ≫ pullback.fst f (Spec.map (CommRingCat.ofHom i)) :=
  (isPullback_LR f i φ).isoPullback_hom_fst

@[scoped simp] theorem isoLR_hom_snd {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    (isoLR f i φ).hom ≫ pullback.snd f (Spec.map (CommRingCat.ofHom (φ.comp i))) = pullback.snd _ _ :=
  (isPullback_LR f i φ).isoPullback_hom_snd

@[scoped simp] theorem isoLR_inv_fst {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    (isoLR f i φ).inv ≫ pullback.fst _ _ ≫ pullback.fst f (Spec.map (CommRingCat.ofHom i)) =
      pullback.fst f (Spec.map (CommRingCat.ofHom (φ.comp i))) := by
  rw [← Category.assoc]; exact (isPullback_LR f i φ).isoPullback_inv_fst

@[scoped simp] theorem isoLR_inv_snd {X₁ : Scheme.{0}} {R₀ : Type} [CommRing R₀] (f : X₁ ⟶ Spec (CommRingCat.of R₀))
    {O T : Type} [CommRing O] [CommRing T] (i : R₀ →+* O) (φ : O →+* T) :
    (isoLR f i φ).inv ≫ pullback.snd _ _ = pullback.snd f (Spec.map (CommRingCat.ofHom (φ.comp i))) :=
  (isPullback_LR f i φ).isoPullback_inv_snd

theorem isUnit_of_isUnit_map_of_dvr {O₀ : Type} [CommRing O₀] [IsDomain O₀] [IsDiscreteValuationRing O₀]
    {B : Type} [CommRing B] (j : O₀ →+* B) (t : O₀) (ht0 : t ≠ 0) (ht : ¬ IsUnit (j t))
    (x : O₀) (hx : IsUnit (j x)) : IsUnit x := by
  by_contra hxu
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O₀
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [map_zero, isUnit_zero_iff] at hx
    haveI : Subsingleton B := subsingleton_of_zero_eq_one hx
    exact ht (isUnit_of_subsingleton _)
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hϖ
  have hn : n ≠ 0 := by
    rintro rfl
    exact hxu (by simpa using Units.isUnit u)
  have hϖu : IsUnit (j ϖ) := by
    rw [map_mul, map_pow] at hx
    exact (isUnit_pow_iff hn).mp (isUnit_of_mul_isUnit_right hx)
  obtain ⟨m, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ht0 hϖ
  apply ht
  rw [map_mul, map_pow]
  exact ((Units.isUnit v).map j).mul (hϖu.pow m)

