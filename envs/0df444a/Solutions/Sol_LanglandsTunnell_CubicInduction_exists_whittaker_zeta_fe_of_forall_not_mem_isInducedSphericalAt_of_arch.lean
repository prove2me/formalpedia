variable {H G : Type*} [Group H] [Group G] {φ : H →* G} (hφ : Function.Injective φ)

private theorem map_mem_doubleCoset_map {U : Subgroup H} {t : H} {x : H} (hx : x ∈ HeckePair.doubleCoset U t) :
    φ x ∈ HeckePair.doubleCoset (U.map φ) (φ t) := by
  obtain ⟨u, hu, w, hw, rfl⟩ := HeckePair.mem_doubleCoset_iff.mp hx
  exact HeckePair.mem_doubleCoset_iff.mpr
    ⟨φ u, Subgroup.mem_map.mpr ⟨u, hu, rfl⟩, φ w, Subgroup.mem_map.mpr ⟨w, hw, rfl⟩, by rw [map_mul, map_mul]⟩

private theorem exists_mem_doubleCoset_of_mem_doubleCoset_map {U : Subgroup H} {t : H} {y : G}
    (hy : y ∈ HeckePair.doubleCoset (U.map φ) (φ t)) : ∃ x ∈ HeckePair.doubleCoset U t, φ x = y := by
  obtain ⟨u', hu', w', hw', rfl⟩ := HeckePair.mem_doubleCoset_iff.mp hy
  obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp hu'
  obtain ⟨w, hw, rfl⟩ := Subgroup.mem_map.mp hw'
  exact ⟨u * t * w, HeckePair.mem_doubleCoset_iff.mpr ⟨u, hu, w, hw, rfl⟩, by rw [map_mul, map_mul]⟩

include hφ in

private theorem mk_eq_mk_iff_map {U : Subgroup H} {x y : H} :
    (QuotientGroup.mk x : H ⧸ U) = QuotientGroup.mk y ↔
      (QuotientGroup.mk (φ x) : G ⧸ U.map φ) = QuotientGroup.mk (φ y) := by
  rw [QuotientGroup.eq, QuotientGroup.eq, ← map_inv, ← map_mul]
  constructor
  · intro h
    exact Subgroup.mem_map.mpr ⟨_, h, rfl⟩
  · intro h
    obtain ⟨z, hz, hzx⟩ := Subgroup.mem_map.mp h
    rwa [← hφ hzx]

include hφ in

private theorem exists_isHeckeCosetSystem_of_map {U : Subgroup H} {t : H} {ι : Type*} {reps : ι → G}
    (hsys : HeckeIntegralSeam.IsHeckeCosetSystem (U.map φ) (φ t) reps) :
    ∃ lifts : ι → H, (∀ i, φ (lifts i) = reps i) ∧ HeckeIntegralSeam.IsHeckeCosetSystem U t lifts := by
  choose lifts hmem hlift using fun i => exists_mem_doubleCoset_of_mem_doubleCoset_map (hsys.mem_doubleCoset i)
  refine ⟨lifts, hlift, ⟨hmem, fun x hx => ?_, fun i j hij => ?_⟩⟩
  · obtain ⟨i, hi⟩ := hsys.covers (φ x) (map_mem_doubleCoset_map hx)
    refine ⟨i, (mk_eq_mk_iff_map hφ).mpr ?_⟩
    rw [hlift i]
    exact hi
  · have hij' : (QuotientGroup.mk (lifts i) : H ⧸ U) = QuotientGroup.mk (lifts j) := hij
    refine hsys.mk_injective ?_
    show (QuotientGroup.mk (reps i) : G ⧸ U.map φ) = QuotientGroup.mk (reps j)
    rw [← hlift i, ← hlift j]
    exact (mk_eq_mk_iff_map hφ).mp hij'

end
