theorem NLogN.AX.sapSl_all (M : MulSpec) (p s t α Bi Bo mm Φ Bacc Q : ℕ) (hM : MulBnd M mm Φ)
    (H : SapHyp p s t α Bi Bo mm Bacc Q) (st : IState HS) (x : List (ℤ × ℤ)) (R : List Item)
    (hC : CtxS p s t α st) (hx : x.length = s ∧ GB Bi x) (hI : st.G aI = gints x ++ R) :
