    ∀ x ∈ eRegs, σ.G x = s1.G x := by
  intro x hx
  rw [hσ x hx]
  simp only [eRegs, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp (config := {decide := true}) [withCtr, jSt]

