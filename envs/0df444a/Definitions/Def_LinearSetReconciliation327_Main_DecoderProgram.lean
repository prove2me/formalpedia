section ReadInt

/-- The integer the machine reads out of the packed payload for coordinate `j`: the `w` bits of the
payload starting at position `j * w`, little-endian. -/
noncomputable def syndromeInt (w : ℕ) {M : ℕ} (y : Fin M → ZMod 2) (j : ℕ) : ℕ :=
  ∑ k ∈ Finset.range w, payloadBit y (j * w + k) * 2 ^ k

end ReadInt

section ReadLoop

/-- The memory during the read loop: the packed payload below `S0`, the syndrome entries at
`S0 + 2i` for `i < k`, and `0` elsewhere. -/
noncomputable def readMem {M : ℕ} (S0 w : ℕ) (y : Fin M → ZMod 2) (k : ℕ) : ℕ → ℕ :=
  fun addr =>
    if addr < S0 then packMem (8 * w) y addr
    else if (addr - S0) % 2 = 0 ∧ (addr - S0) / 2 < k then syndromeInt w y ((addr - S0) / 2)
    else 0

/-- The loop-head state of the read loop after `k` coordinates: the loop counter holds `k`, the
constants sit in their registers, and the scratch registers are clear. -/
noncomputable def readState (base S0 w t : ℕ) (y : Fin (t * w) → ZMod 2) (k : ℕ) : RAMState where
  pc := base
  regs := ![t, w, S0, 2 ^ w - 1, detSqBase w, k, 0, 0, 1, 0, 0, 0, 0, 0, 0, 8 * w]
  mem := readMem S0 w y k

/-- The body of the read loop: read coordinate `k` out of the packed payload, store `P_{2k+1}` at
`S0 + 2k`, advance the counter, and clear the scratch registers. -/
def readBody : List Instr :=
  mulR r7 r5 r1 ++ divR r9 r7 r15 ++ modR r10 r7 r15 ++ ld r11 r9 ++ shrR r11 r11 r10 ++
  bandR r11 r11 r3 ++ addR r6 r5 r5 ++ addR r6 r6 r2 ++ st r6 r11 ++ addR r5 r5 r8 ++
  movI r6 0 ++ movI r7 0 ++ movI r9 0 ++ movI r10 0 ++ movI r11 0 ++ movI r14 0

/-- The read loop, placed at address `base`: while `j < t`, read coordinate `j`. -/
def readLoopAt (base : ℕ) : List Instr := [iLt r14 r5 r0, iJz r14 (base + 19)] ++ readBody ++ [iJmp base]

end ReadLoop

