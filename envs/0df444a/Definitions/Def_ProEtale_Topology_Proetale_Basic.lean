/-!
# The pro-étale site of a scheme

-/

universe u

open CategoryTheory MorphismProperty

namespace AlgebraicGeometry
namespace Scheme

namespace ProEt

variable (X : Scheme.{u})

set_option backward.isDefEq.respectTransparency.types false in
/-- The pro-étale topology on `X.ProEt` is the topology restricted from the big pro-étale site
(as in leanprover-community/mathlib4#41730). -/
lemma topology_eq_restrictedTopology :
    topology X = (ProEt.forget X).restrictedTopology (proetaleTopology.over X) :=
  MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology
    _ proetalePrecoverage_le_precoverage_weaklyEtale

def zariskiTopology : GrothendieckTopology X.ProEt :=
  smallGrothendieckTopology (Q := @WeaklyEtale) @IsOpenImmersion X


instance inst_TopologyProetaleBasic_L70 : (precoverage X).HasIsos := by
  dsimp [precoverage]
  infer_instance

instance inst_TopologyProetaleBasic_L74 : (precoverage X).IsStableUnderComposition := by
  dsimp [precoverage]
  infer_instance

instance inst_TopologyProetaleBasic_L78 : (precoverage X).IsStableUnderBaseChange := by
  dsimp [precoverage]
  infer_instance

variable {S : Scheme.{u}}

instance inst_TopologyProetaleBasic_L84 {X Y : S.ProEt} (f : X ⟶ Y) : WeaklyEtale f.left :=
  have : WeaklyEtale (f.left ≫ Y.hom) := by simp [X.prop]
  .of_comp _ Y.hom

end ProEt

end Scheme
end AlgebraicGeometry


