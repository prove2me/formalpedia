      14000000 * (N : ℝ) * (w + 1) := by exact_mod_cast hW2
  -- total
  have hNR : (N : ℝ) = (vol (Butterfly.layerShape P K D S) : ℝ) * r := by simp [hN]
  push_cast
  have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg _
  have hw0 : (0 : ℝ) ≤ (w : ℝ) + 1 := by positivity
  have hNW : (0 : ℝ) ≤ (N : ℝ) * (w + 1) := by positivity
  have hk6 : (kCw : ℝ) ≤ 6 * CF * ((N : ℝ) * (w + 1)) * (D : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 54) := by
    refine hkC'.trans (le_of_eq ?_); rw [hNR]; ring
  have hWR' : (cWrapPh P K D S r E (zsz ((16 * N : ℕ) : ℤ)) w dC : ℝ) ≤
      14000000 * ((N : ℝ) * (w + 1)) := by linarith
  have hY : 14000000 * ((N : ℝ) * (w + 1)) ≤
      14000000 * ((N : ℝ) * (w + 1)) * (D : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 54) :=
    le_mul_of_one_le_right (by positivity) hDl
  have hsum := add_le_add hk6 (hWR'.trans hY)
  refine le_trans ?_ (le_trans hsum (le_of_eq (by ring)))
  push_cast; exact le_rfl

end NLogN.KFM

