    rw [locRes_comp_mkLinearMap, ← hc]
    exact localizedModuleIsLocalizedModule _
  have h3 : IsLocalizedModule.Away (xProd R (s \ {i})) (locRes X M hsub) :=
    isLocalizedModule_away_of_comp (b := xProd R {i})
