  have c4 := NLogN.CR.scanLoop_cost t3 Z hZw Rest (0, 0) (t.G NLogN.CR.hCa) (t.G NLogN.CR.hCb) (t.G 1)
    (by simp +decide [ht3, ht3a, ht2]) (by simp +decide [ht3, ht3a])
    (by simp +decide [ht3]) (by simp +decide [ht3, ht3a, ht2, ht1, hZl]) B hB2 hZB
    (by simp [NLogN.zsz_zero]) (by simp [NLogN.zsz_zero]) (by rw [hZl]; exact zb _ (by omega))
  rw [hZl] at c4
  obtain ⟨zc1, zc2⟩ := NLogN.CR.curF_bnd B Z (0, 0) hZB (by simp [NLogN.zsz_zero]) (by simp [NLogN.zsz_zero])
  have c5a : (NLogN.RS.pop NLogN.CR.hCa).cost t4 ≤ 2 * B + 2 := by
    simp +decide [NLogN.RS.cost, NLogN.IState.top, ht4]; omega
  have c5b : (NLogN.RS.pop NLogN.CR.hCb).cost (t4.upd NLogN.CR.hCa (t.G NLogN.CR.hCa)) ≤ 2 * B + 2 := by
    simp +decide [NLogN.RS.cost, NLogN.IState.top, ht4]; omega
  have c5c : (NLogN.RS.pop 1).cost ((t4.upd NLogN.CR.hCa (t.G NLogN.CR.hCa)).upd NLogN.CR.hCb (t.G NLogN.CR.hCb)) ≤ 2 * B + 2 := by
    have := zb (R + T) (by omega)
    simp +decide [NLogN.RS.cost, NLogN.IState.top, ht4, ht3, ht3a, ht2, ht1]
    push_cast at this ⊢; omega
  have hEB : ∀ e ∈ E, NLogN.zsz e.1 ≤ B ∧ NLogN.zsz e.2.1 ≤ B ∧ NLogN.zsz e.2.2 ≤ B := by
    intro e he
    rw [hEe] at he
    simp only [List.mem_map] at he
    obtain ⟨x, hx, rfl⟩ := he
    have hxT : x < T := by simpa using hKp.subset hx
    exact ⟨zb x (by omega), (hv _ (hκ x hxT)).1, (hv _ (hκ x hxT)).2⟩
  have c6 := NLogN.mvK_cost (X := NLogN.CR.hOut) (Y := 0) (C := NLogN.CR.hI) (by decide) (by decide) (by decide)
    (.add (.reg NLogN.CR.hTT) (.reg NLogN.CR.hTT)) t5 (NLogN.CR.outRev E) (t.G NLogN.CR.hOut) (by simp +decide [ht5])
    (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t5T, NLogN.CR.outRev_length, hEl]; ring) B (by
      intro y hy
      simp only [NLogN.CR.outRev, List.mem_reverse, List.mem_flatten, List.mem_map] at hy
      obtain ⟨_, ⟨e, he, rfl⟩, hy⟩ := hy
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
      rcases hy with rfl | rfl
      · exact (hEB e he).2.1
      · exact (hEB e he).2.2) ⟨trivial, trivial⟩
    (by simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t5T]
        exact ⟨zb T (by omega), zb T (by omega), by exact_mod_cast zb (T + T) (by omega)⟩)
  rw [NLogN.CR.outRev_length, hEl] at c6
  have c7 := NLogN.mvK_cost (X := NLogN.CR.hKs) (Y := 3) (C := NLogN.CR.hI) (by decide) (by decide) (by decide)
    (.reg NLogN.CR.hTT) t6 (NLogN.CR.keysRev E) (t.G NLogN.CR.hKs) (by simp +decide [ht6, ht5])
    (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t6T, NLogN.CR.keysRev, hEl]) B (by
      intro y hy
      simp only [NLogN.CR.keysRev, List.mem_reverse, List.mem_map] at hy
      obtain ⟨e, he, rfl⟩ := hy
      exact (hEB e he).1) trivial (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t6T]; exact zb T (by omega))
  have hkl : (NLogN.CR.keysRev E).length = T := by simp [NLogN.CR.keysRev, hEl]
  rw [hkl] at c7
  have c8 : (NLogN.RS.push 1 (.reg NLogN.CR.hTT)).cost t7 ≤ 2 * 3000 * (B + 2) := by
    have := NLogN.CR.cost_le_linB B (NLogN.RS.push 1 (.reg NLogN.CR.hTT)) t7 (by
      simp only [NLogN.CR.LinB, NLogN.Ex.Lin, NLogN.Ex.Bnd, NLogN.IState.top_eq t7T]; exact ⟨trivial, zb T (by omega)⟩)
    simpa [NLogN.CR.lsz, NLogN.Ex.size] using this
  have c9 := NLogN.permP_cost 2 T kb B Kl D Rest (t.G 3) t8 hKlen hKp (by rw [hD, List.length_map, hKlen])
    (by intro r hr; rw [hD] at hr; simp only [List.mem_map] at hr; obtain ⟨x, _, rfl⟩ := hr; rfl)
    hTk (t7.G 1) L2 (by simp +decide [ht8, ht7, ht6, ht5, NLogN.CR.outRev_rev]) (by simp [ht8])
    (by simp +decide [ht8, ht7, ht6, ht5, h2]) (by simp +decide [ht8, ht7, ht6, ht5]) (by
      intro r hr y hy
      rw [hD] at hr
      simp only [List.mem_map] at hr
      obtain ⟨x, hx, rfl⟩ := hr
      have hxT : x < T := by simpa using hKp.subset hx
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
      rcases hy with rfl | rfl
      · exact (hv _ (hκ x hxT)).1
      · exact (hv _ (hκ x hxT)).2)
  have c10 : (NLogN.RS.pop 1).cost t9 ≤ 2 * B + 2 := by
    have := zb T (by omega)
    simp +decide [NLogN.RS.cost, NLogN.IState.top, ht9, ht8]; omega
  have c11 := NLogN.CR.dropN_cost 3 NLogN.CR.hI (by decide) (.reg NLogN.CR.hTT) (t9.upd 1 (t7.G 1)) (Kl.map (Nat.cast : ℕ → ℤ))
    (t.G 3) (by simp +decide [ht9, ht8, ht7, ht6, ht5, NLogN.natInts])
    (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t10T, hKlen]) B trivial
    (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t10T]; exact zb T (by omega)) (by
      intro y hy
      simp only [List.mem_map] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      have hxT : x < T := by simpa using hKp.subset hx
      exact zb x (by omega))
  simp only [List.length_map, hKlen] at c11
  have tot := NLogN.CR.seq_cost r1 c1 (NLogN.CR.seq_cost r2 c2 (NLogN.CR.seq_cost r3a.2 c3a (NLogN.CR.seq_cost r3b.2 c3b
    (NLogN.CR.seq_cost r4 c4 (NLogN.CR.seq_cost r5a.2 c5a (NLogN.CR.seq_cost r5b.2 c5b (NLogN.CR.seq_cost r5c.2 c5c
    (NLogN.CR.seq_cost r6 c6 (NLogN.CR.seq_cost r7 c7 (NLogN.CR.seq_cost r8.2 c8 (NLogN.CR.seq_cost r9 c9 (NLogN.CR.seq_cost r10.2 c10
    c11))))))))))))
  refine le_trans tot ?_
  simp only [NLogN.Ex.size]
  clear * -
  have hY : B + 2 ≤ B + kb + 6 := by omega
  have hT : T + 1 ≤ R + T + 1 := by omega
  have hA : 1 ≤ kb + 1 := by omega
  have P1 : (R + T + 1) * (B + 2) ≤ (kb + 1) * (R + T + 1) * (B + kb + 6) := by
    calc (R + T + 1) * (B + 2) ≤ (R + T + 1) * (B + kb + 6) := Nat.mul_le_mul_left _ hY
      _ = 1 * ((R + T + 1) * (B + kb + 6)) := by ring
      _ ≤ (kb + 1) * ((R + T + 1) * (B + kb + 6)) := Nat.mul_le_mul_right _ hA
      _ = _ := by ring
  have P2 : (kb + 1) * ((R + T) * 3 + 1) * (B + 2) ≤ 3 * ((kb + 1) * (R + T + 1) * (B + kb + 6)) := by
    have : (kb + 1) * ((R + T) * 3 + 1) * (B + 2) ≤ (kb + 1) * (3 * (R + T + 1)) * (B + kb + 6) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) hY
    linarith
  have P3 : (kb + 1) * (T + 1) * (2 + 1) * (B + kb + 2 + 4) ≤ 3 * ((kb + 1) * (R + T + 1) * (B + kb + 6)) := by
    have : (kb + 1) * (T + 1) * (B + kb + 6) ≤ (kb + 1) * (R + T + 1) * (B + kb + 6) :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hT)
    have e : (kb + 1) * (T + 1) * (2 + 1) * (B + kb + 2 + 4) = 3 * ((kb + 1) * (T + 1) * (B + kb + 6)) := by ring
    omega
  have P4 : T * (B + 2) ≤ (kb + 1) * (R + T + 1) * (B + kb + 6) := by
    have : T * (B + 2) ≤ (R + T + 1) * (B + 2) := Nat.mul_le_mul_right _ (by omega)
    omega
  have P5 : B + 2 ≤ (kb + 1) * (R + T + 1) * (B + kb + 6) := by
    have : B + 2 ≤ (R + T + 1) * (B + 2) := Nat.le_mul_of_pos_left _ (by omega)
    omega
  nlinarith [P1, P2, P3, P4, P5]
