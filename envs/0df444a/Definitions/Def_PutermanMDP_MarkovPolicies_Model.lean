-- title:
--   Stationary MDPs, admissible history policies, and state-action laws
-- statement:
--   Let $S$ be the state set and $A$ the ambient discrete action set. A stationary model assigns a nonempty finite or countable set $A_s$ of available actions to each state, a probability distribution $p(\cdot\mid s,a)$ on next states for each available action, and a real reward $r(s,a)$. A history consists of the past state-action pairs and the current state. A randomized history policy assigns a probability distribution on available actions to every history; a randomized Markov policy assigns such a distribution using only time and current state.
--
--   Starting from an initial distribution $\mu$, the history law is generated by choosing an action under the policy and then a next state under $p$. Its state-action marginal is
--   $$m_n^{\pi,\mu}(j,a)=\Pr_\mu^\pi(X_{n+1}=j,Y_{n+1}=a).$$
--
--   These definitions supply actual controlled stochastic dynamics, without any assumption of marginal equivalence or optimality.
--
--   **Formalization Note** Probabilities are PMFs; the ambient action type may be arbitrary, but each available action set is finite or countable, as required by §2.1.2 (printed p. 18 / PDF 34). Randomization ranges over all distributions on that set. The theorems assume nonempty finite or countable states. Past pairs are stored newest first. Lean time $n=0$ is the book's epoch $1$. Histories of zero probability still have admissible decision rules. No boundedness of rewards is built into the model.
-- source:
--   Puterman, Markov Decision Processes, Wiley, 1994, pp. 119–120, 134–135 (PDF 135–136, 150–151), §§5.1, 5.5; action-set, history and policy conventions in §2.1, pp. 18–24 (PDF 34–40)

import Mathlib

namespace PutermanMDP.MarkovPolicies

/-- Stationary discrete MDP data. Bounds on rewards are separate hypotheses. -/
structure Model (S A : Type*) where
  actions : S → Set A
  actions_nonempty : ∀ s, (actions s).Nonempty
  /-- The standing discrete-action assumption of §2.1.2 (printed p. 18). -/
  actions_countable : ∀ s, (actions s).Countable
  transition : (s : S) → {a : A // a ∈ actions s} → PMF S
  reward : S → A → ℝ

/-- Past state-action pairs, newest first, followed by the current state. -/
def History (S A : Type*) := List (S × A) × S

/-- An admissible randomized rule at every observable finite history. -/
def HistoryPolicy {S A : Type*} (M : Model S A) :=
  (h : History S A) → PMF {a : A // a ∈ M.actions h.2}

/-- Time-dependent randomized Markov rules; time zero is the book's epoch one. -/
def MarkovPolicy {S A : Type*} (M : Model S A) :=
  ℕ → (s : S) → PMF {a : A // a ∈ M.actions s}

def MarkovPolicy.toHistory {S A : Type*} {M : Model S A}
    (π : MarkovPolicy M) : HistoryPolicy M :=
  fun h => π h.1.length h.2

/-- The finite-history laws generated by the policy and transition probabilities. -/
noncomputable def historyLaw {S A : Type*} (M : Model S A)
    (π : HistoryPolicy M) (μ : PMF S) : ℕ → PMF (History S A)
  | 0 => μ.map (fun s => ([], s))
  | n + 1 => (historyLaw M π μ n).bind fun h =>
      (π h).bind fun a => (M.transition h.2 a).map fun j =>
        ((h.2, a.val) :: h.1, j)

/-- Joint law of the state and chosen action, at epoch n+1. -/
noncomputable def stateActionLaw {S A : Type*} (M : Model S A)
    (π : HistoryPolicy M) (μ : PMF S) (n : ℕ) : PMF (S × A) :=
  (historyLaw M π μ n).bind fun h => (π h).map fun a => (h.2, a.val)

end PutermanMDP.MarkovPolicies


