attribute [local instance] Classical.propDecidable Classical.decEq

theorem solution {d n : ℕ} (target : FineResolution d) (hn : 0 < n)
    (rho : Fin n → Matrix (Fin d) (Fin d) ℂ) (hrho : ∀ i, IsDensityMatrix (rho i))
    (delta epsilon : ℝ) (hdelta : 0 < delta) (hepsilon : 0 < epsilon)
    (hclose : complexOperatorNorm (((1 / (n : ℝ) : ℝ) : ℂ) • (∑ i, rho i) - target.state) ≤ epsilon) :
    effectProb (wordTensor rho) (constantProjector target n (delta + epsilon * Real.sqrt n)) ≥
      1 - 1 / delta^2 := by
  set U := (target.basis : Matrix (Fin d) (Fin d) ℂ)
  set q : Fin n → Fin d → ℝ := fun i j => (rho i * target.atom j).trace.re
  have hqC : ∀ i j, (rho i * target.atom j).trace = (q i j : ℂ) := by
    intro i j
    have h := (hrho i).1.dotProduct_mulVec_nonneg (fun a => U a j)
    rw [← atom_trace] at h
    apply Complex.ext
    · simp [q]
    · simp only [Complex.ofReal_im]; exact (Complex.nonneg_iff.mp h).2.symm
  have hq0 : ∀ i j, 0 ≤ q i j := by
    intro i j
    have h := (hrho i).1.dotProduct_mulVec_nonneg (fun a => U a j)
    rw [← atom_trace] at h
    exact (Complex.nonneg_iff.mp h).1
  have hq1 : ∀ i, ∑ j, q i j = 1 := by
    intro i
    have : ∑ j, (rho i * target.atom j).trace = 1 := by
      rw [← Matrix.trace_sum, ← Matrix.mul_sum, atom_sum, Matrix.mul_one, (hrho i).2]
    have := congrArg Complex.re this
    rw [Complex.re_sum] at this
    simpa using this
  have hlaw : ∀ j, ((target.law j).toReal) = target.weight j := by
    intro j
    simp [FineResolution.law, PMF.ofFintype_apply, ENNReal.toReal_ofReal (target.nonneg j)]
  -- mean deviation from the operator norm closeness
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hmean : ∀ j, |∑ k, q k j - n * (target.law j).toReal| ≤ epsilon * n := by
    intro j
    set X := (((1 / (n : ℝ) : ℝ) : ℂ) • (∑ i, rho i) - target.state)
    have h0 : ‖(X * target.atom j).trace‖ ≤ complexOperatorNorm X := by
      rw [atom_trace]; exact opnorm_bound X _ (col_norm target j)
    have h1 : ‖(X * target.atom j).trace‖ ≤ epsilon := h0.trans hclose
    have h2 : (X * target.atom j).trace.re = (1 / (n : ℝ)) * ∑ k, q k j - target.weight j := by
      simp only [X, Matrix.sub_mul, Matrix.trace_sub, Matrix.smul_mul, Matrix.trace_smul,
        Matrix.sum_mul, Matrix.trace_sum, state_atom, hqC, smul_eq_mul]
      simp [Complex.re_sum]
    have h3 : |(X * target.atom j).trace.re| ≤ epsilon :=
      (Complex.abs_re_le_norm _).trans h1
    rw [h2] at h3
    rw [hlaw]
    have : ∑ k, q k j - n * target.weight j = n * ((1 / (n : ℝ)) * ∑ k, q k j - target.weight j) := by
      field_simp
    rw [this, abs_mul, abs_of_pos hn']
    nlinarith
  -- the effect probability as a sum over words
  have hprob : effectProb (wordTensor rho) (constantProjector target n (delta + epsilon * Real.sqrt n)) =
      ∑ w ∈ Finset.univ.filter (fun w : Fin n → Fin d => ∀ j,
        |(count w j : ℝ) - n * (target.law j).toReal| ≤ (delta + epsilon * Real.sqrt n) * Real.sqrt n),
        ∏ m, q m (w m) := by
    unfold effectProb constantProjector
    rw [Matrix.mul_sum, Matrix.trace_sum, Complex.re_sum]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [wt_mul, wt_trace]
    simp only [hqC]
    rw [← Complex.ofReal_prod, Complex.ofReal_re]
  rw [hprob, ge_iff_le]
  refine (concentration hn q hq0 hq1 delta hdelta).trans ?_
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun w _ _ => W_nonneg q hq0 w)
  intro w hw
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hw ⊢
  intro j
  have h1 := hw j
  have h2 := hmean j
  have hs : epsilon * Real.sqrt n * Real.sqrt n = epsilon * n := by
    rw [mul_assoc, Real.mul_self_sqrt hn'.le]
  calc |(count w j : ℝ) - n * (target.law j).toReal|
      = |((count w j : ℝ) - ∑ k, q k j) + (∑ k, q k j - n * (target.law j).toReal)| := by ring_nf
    _ ≤ |(count w j : ℝ) - ∑ k, q k j| + |∑ k, q k j - n * (target.law j).toReal| := abs_add_le _ _
    _ ≤ delta * Real.sqrt n + epsilon * n := add_le_add h1 h2
    _ = (delta + epsilon * Real.sqrt n) * Real.sqrt n := by rw [add_mul, hs]
