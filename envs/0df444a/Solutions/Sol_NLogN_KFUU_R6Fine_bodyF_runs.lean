theorem cStep_le {q M B Bb : ℕ} (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) :
    cStep q M B Bb ≤ 70000 * (q * (M * B)) * (Bb + 2) := by
  unfold cStep
  have hM : M ≤ q * (M * B) := le_trans (Nat.le_mul_of_pos_right _ hB1) (Nat.le_mul_of_pos_left _ hq1)
  have h1 : 1 ≤ q * (M * B) := le_trans hM1 hM
  have e : M * (q * B * (14000 * (Bb + 2))) = 14000 * (q * (M * B)) * (Bb + 2) := by ring
  have h2 : M * (Bb + 2) ≤ q * (M * B) * (Bb + 2) := Nat.mul_le_mul_right _ hM
  have h3 : (Bb + 2) ≤ q * (M * B) * (Bb + 2) := by nlinarith
  nlinarith

theorem cBlk_le {q M B Bb : ℕ} (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) :
    cBlk q M B Bb ≤ 110000 * q * (q * (M * B)) * (Bb + 2) := by
  unfold cBlk
  have hs := cStep_le (Bb := Bb) hB1 hM1 hq1
  have hM : M ≤ q * (M * B) := le_trans (Nat.le_mul_of_pos_right _ hB1) (Nat.le_mul_of_pos_left _ hq1)
  have h1 : 1 ≤ q * (M * B) := le_trans hM1 hM
  have h3 : (Bb + 2) ≤ q * (M * B) * (Bb + 2) := by nlinarith
  have h4 : q * (M * B) * (Bb + 2) ≤ q * (q * (M * B) * (Bb + 2)) := Nat.le_mul_of_pos_left _ hq1
  have h5 : q * (cStep q M B Bb + 8000 * (Bb + 2) + 30) ≤
      q * (70000 * (q * (M * B)) * (Bb + 2) + 8000 * (Bb + 2) + 30) := by gcongr
  nlinarith

theorem cFwd_le {P q M B Bb : ℕ} (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) :
    cFwd P q M B Bb ≤ 200000 * q * (P * (q * (M * B)) + 1) * (Bb + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  unfold cFwd
  have hb := cBlk_le (Bb := Bb) hB1 hM1 hq1
  have h5 : P * (cBlk q M B Bb + 8000 * (Bb + 2) + 30) ≤
      P * (110000 * q * (q * (M * B)) * (Bb + 2) + 8000 * (Bb + 2) + 30) := by gcongr
  have hM : M ≤ q * (M * B) := le_trans (Nat.le_mul_of_pos_right _ hB1) (Nat.le_mul_of_pos_left _ hq1)
  have h1 : 1 ≤ q * (M * B) := le_trans hM1 hM
  have h6 : P * (Bb + 2) ≤ P * (q * (M * B)) * (Bb + 2) := by
    have := Nat.mul_le_mul_left P h1; nlinarith
  have h7 : P * (q * (M * B)) * (Bb + 2) ≤ q * (P * (q * (M * B)) * (Bb + 2)) :=
    Nat.le_mul_of_pos_left _ hq1
  have h8 : (Bb + 2) ≤ q * (Bb + 2) := Nat.le_mul_of_pos_left _ hq1
  nlinarith

