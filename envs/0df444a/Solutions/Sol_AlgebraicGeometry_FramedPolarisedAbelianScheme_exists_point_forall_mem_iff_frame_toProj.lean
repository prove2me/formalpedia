theorem solution
    (g N n : ℕ)
    (hP : ∃ (K : Type) (_ : Field K) (I : Ideal (MvPolynomial (Fin (N + 1)) K)),
      (∀ p ∈ I, ∀ d : ℕ, homogeneousComponent d p ∈ I) ∧
      ∃ d₁ : ℕ, ∀ d : ℕ, d₁ ≤ d → (Module.finrank K (piece I d) : ℚ) =
        (Polynomial.C ((N : ℚ) + 1) * Polynomial.X ^ g).eval (d : ℚ)) :
    ∃ D : ℕ, ∀ m : ℕ, D ≤ m → ∀ (R : Type) [CommRing R] (Xf : FramedPolarisedAbelianScheme g N n R),
      ∃ q : Point R N (hilbertFunctionOf N (Polynomial.C ((N : ℚ) + 1) * Polynomial.X ^ g) m), ∀ (d : ℕ), m ≤ d →
        ∀ (F : MvPolynomial (Fin (N + 1)) R) (hF : F.IsHomogeneous d),
          (F ∈ q.I ↔ ∀ i : Fin (N + 1),
            Xf.frame.toProj.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
              ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) (X i))
                (HomogeneousLocalization.mk
                  { deg := d
                    num := ⟨F, (MvPolynomial.mem_homogeneousSubmodule d F).mpr hF⟩
                    den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
                    den_mem := ⟨d, rfl⟩ })) = 0) := by
  classical
  obtain ⟨D₀, h17⟩ :=
    AlgebraicGeometry.HilbertFunctor.exists_point_I_eq_span_of_isClosedImmersion_of_flat_of_locallyOfFinitePresentation N _ hP
  obtain ⟨D₂, hFD⟩ :=
    AlgebraicGeometry.HilbertFunctor.exists_point_forall_mem_iff_of_isClosedImmersion_of_forall_geomFibreH0Finrank_eq_eval N _ hP
  refine ⟨max D₀ D₂, fun m hm R _ Xf => ?_⟩
  haveI : Smooth Xf.f := Xf.bundle.smooth
  have hflat : Flat (Xf.frame.toProj ≫ ProjSpace.π R N) := by rw [Xf.frame.toProj_π]; infer_instance
  have hlfp : LocallyOfFinitePresentation (Xf.frame.toProj ≫ ProjSpace.π R N) := by rw [Xf.frame.toProj_π]; infer_instance
  obtain ⟨p, hp⟩ := h17 m (le_trans (le_max_left _ _) hm) R Xf.A Xf.frame.toProj Xf.frame_isClosedImmersion hflat hlfp (by
    intro k _ _ _ Zk ιk e hιk he hcomp
    obtain ⟨𝓛, 𝔓, h𝔓, hloc⟩ := AlgebraicGeometry.ProjSpace.exists_projPresentation_toProj_eq_and_locallyTrivial ιk
    have h𝓛 : Scheme.Modules.IsInvertible 𝓛 := ⟨hloc⟩
    refine hFD m (le_trans (le_max_right _ _) hm) k Zk ιk hιk 𝓛 h𝓛 𝔓 h𝔓 ⟨1, fun d hd => ?_⟩
    rw [AlgebraicGeometry.FramedPolarisedAbelianScheme.geomFibreH0Finrank_natRec_tensor_eq_of_realisation g N n R Xf k Zk ιk e hιk he hcomp 𝓛 h𝓛 𝔓 h𝔓 d hd]
    push_cast
    simp [Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X])
  refine ⟨p, fun d hd F hF => ?_⟩
  constructor
  · intro hFI
    rw [hp] at hFI
    exact vanishes_of_mem_span Xf.frame.toProj m d F hF hFI
  · intro hv
    rw [hp]
    exact Ideal.subset_span ⟨d, hF, hd, hv⟩

