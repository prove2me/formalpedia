/-- **A uniform table rotation on the records.** -/
theorem rotRec_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ} (hT : SegTR T tf Bb Tm Rv)
    (sgn : ℤ) (hs : sgn = 1 ∨ sgn = -1) (hfok : fok (tabGenR sgn T) = true)
    {Q d1 d2 n : ℕ} {ru rv rw w0 : ℤ} (hv : TVal Q d1 d2 ru rv rw w0 Tm n Bb)
    (P S B w : ℕ) (hS : 0 < S) (hB : 0 < B) (zP : zsz (P : ℤ) ≤ Bb)
    (t : IState HS) {recs : ℕ → List ℤ} (hlen : ∀ m, (recs m).length = B)
    (hbw : Bnd w (flR recs (P * Q * S))) (R0 : List Item)
    (h0 : t.G 0 = ints (flR recs (P * Q * S)) ++ R0)
    {eP eQ eB e1 e2 eu ev ew e0 en eR : Ex HS}
    (hsz : ((rotPlR eP eQ eB e1 e2 eu ev ew e0 en eR).map fun p => p.2.size + 1).sum ≤ 200)
    (hlow : ∀ p ∈ rotPlR eP eQ eB e1 e2 eu ev ew e0 en eR, KFX.NoLow p.2)
    (EP : ESp eP t Bb (P : ℤ)) (EQ : ESp eQ t Bb (Q : ℤ)) (EB : ESp eB t Bb ((S * B : ℕ) : ℤ))
    (E1 : ESp e1 t Bb (d1 : ℤ)) (E2 : ESp e2 t Bb (d2 : ℤ)) (Eu : ESp eu t Bb ru)
    (Ev : ESp ev t Bb rv) (Ew : ESp ew t Bb rw) (E0 : ESp e0 t Bb w0)
    (En : ESp en t Bb (n : ℤ)) (ER : ESp eR t Bb Rv) :
    IRuns I iprog (rotR sgn T eP eQ eB e1 e2 eu ev ew e0 en eR) t
      (t.upd 0 (ints (flR (fun m => recs (rotP Q S (tabE sgn tf ru rv rw w0 d1 d2 Q n) m))
        (P * Q * S)) ++ R0))
      (cRotR T Bb n P Q (S * B) w) := by
  have W := rotR_runs (I := I) (iprog := iprog) hT sgn hs hfok hv P (S * B) w zP t
    (flR recs (P * Q * S)) R0 (by rw [length_flR hlen]; ring) hbw h0 hsz hlow EP EQ EB E1 E2 Eu
    Ev Ew E0 En ER
  rwa [rot_flR hv.hQ hS hB _ hlen] at W

