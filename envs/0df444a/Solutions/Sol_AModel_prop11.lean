section Pivot

variable {m Q : ℕ}

lemma sum_single_mul {n : ℕ} (a : Fin n) (y : Fin n → ZMod Q) :
    ∑ l, (Pi.single a (1 : ZMod Q) : Fin n → ZMod Q) l * y l = y a := by
  simp [Pi.single_apply]

lemma runVec_pivotSteps (i j : Fin m) (x : Fin (m + m) → ZMod Q) :
    runVec (pivotSteps i j) x = Function.update x (Fin.castAdd m i)
      (x (Fin.castAdd m i) + x (Fin.natAdd m j)) := by
  have hne := castAdd_ne_natAdd i j
  show shiftVec (Fin.natAdd m j) (-1) (Pi.single (Fin.castAdd m i) 1)
    (shiftVec (Fin.natAdd m j) 1 (Pi.single (Fin.castAdd m i) 1) x ∘
      Equiv.swap (Fin.castAdd m i) (Fin.natAdd m j)) = _
  simp only [shiftVec, sum_single_mul]
  funext k
  by_cases hkD : k = Fin.natAdd m j
  · subst hkD
    simp [hne, hne.symm, -Fin.natAdd_eq_addNat]
  · by_cases hkH : k = Fin.castAdd m i
    · subst hkH
      simp [hne, -Fin.natAdd_eq_addNat]
      ring
    · simp [Function.update_apply, Equiv.swap_apply_def, hkD, hkH, -Fin.natAdd_eq_addNat]

lemma pivotSteps_WF (i j : Fin m) : ∀ s ∈ (pivotSteps i j : List (Step (m + m) Q)), s.WF := by
  have hlt := castAdd_lt_natAdd i j
  have hc : ∀ l : Fin (m + m), Fin.natAdd m j ≤ l →
      (Pi.single (Fin.castAdd m i) (1 : ZMod Q) : Fin (m + m) → ZMod Q) l = 0 := by
    intro l hl
    rw [Pi.single_apply, if_neg]
    rintro rfl; exact absurd hl (not_le.2 hlt)
  intro s hs
  simp only [pivotSteps, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl | rfl
  · exact ⟨isUnit_one, hc⟩
  · trivial
  · exact ⟨isUnit_one.neg, hc⟩

lemma countP_pivotSteps (i j : Fin m) :
    (pivotSteps i j : List (Step (m + m) Q)).countP Step.isSwap = 1 := rfl

lemma runVec_addSteps (ps : List (Fin m × Fin m)) (x : Fin (m + m) → ZMod Q) :
    hv (runVec (addSteps ps) x) =
      hv x + (fun i => (ps.map fun p => if p.1 = i then dv x p.2 else 0).sum) ∧
    dv (runVec (addSteps ps) x) = dv x := by
  induction ps generalizing x with
  | nil => simp [addSteps, runVec]; rfl
  | cons p ps ih =>
    have e : (addSteps (p :: ps) : List (Step (m + m) Q)) = pivotSteps p.1 p.2 ++ addSteps ps := by
      simp [addSteps]
    rw [e, runVec_append, runVec_pivotSteps]
    set y := Function.update x (Fin.castAdd m p.1) (x (Fin.castAdd m p.1) + x (Fin.natAdd m p.2))
    have hy : hv y = hv x + fun i => if p.1 = i then dv x p.2 else 0 := by
      funext i
      by_cases h : p.1 = i
      · subst h; simp [y, hv, dv]
      · have : Fin.castAdd m i ≠ Fin.castAdd m p.1 := fun h' => h (Fin.castAdd_injective _ _ h').symm
        simp [y, hv, h, this]
    have hdy : dv y = dv x := by
      funext j; exact Function.update_of_ne (castAdd_ne_natAdd p.1 j).symm _ _
    obtain ⟨h1, h2⟩ := ih y
    refine ⟨?_, h2.trans hdy⟩
    rw [h1, hy, hdy]
    funext i
    simp only [Pi.add_apply, List.map_cons, List.sum_cons]
    ring

lemma addSteps_WF (ps : List (Fin m × Fin m)) : ∀ s ∈ (addSteps ps : List (Step (m + m) Q)), s.WF := by
  intro s hs
  simp only [addSteps, List.mem_flatMap] at hs
  obtain ⟨p, -, hs⟩ := hs
  exact pivotSteps_WF p.1 p.2 s hs

lemma countP_addSteps (ps : List (Fin m × Fin m)) :
    (addSteps ps : List (Step (m + m) Q)).countP Step.isSwap = ps.length := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    have e : (addSteps (p :: ps) : List (Step (m + m) Q)) = pivotSteps p.1 p.2 ++ addSteps ps := by
      simp [addSteps]
    rw [e, List.countP_append, ih, countP_pivotSteps, List.length_cons]; ring

lemma pivots_nodup (W : Matrix (Fin m) (Fin m) (ZMod Q)) : (pivots W).Nodup :=
  ((List.nodup_finRange m).product (List.nodup_finRange m)).filter _

lemma pivots_toFinset (W : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (pivots W).toFinset = Finset.univ.filter fun p : Fin m × Fin m => W p.1 p.2 = 1 := by
  ext ⟨a, b⟩
  simp only [pivots, List.mem_toFinset, List.mem_filter, List.mem_product, List.mem_finRange,
    true_and, Finset.mem_filter, Finset.mem_univ, decide_eq_true_eq]

lemma length_pivots (W : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (pivots W).length = (Finset.univ.filter fun p : Fin m × Fin m => W p.1 p.2 = 1).card := by
  rw [← pivots_toFinset, List.toFinset_card_of_nodup (pivots_nodup W)]

lemma sum_pivots {W : Matrix (Fin m) (Fin m) (ZMod Q)} (hW : ∀ i j, W i j = 0 ∨ W i j = 1)
    (d : Fin m → ZMod Q) :
    (fun i => ((pivots W).map fun p => if p.1 = i then d p.2 else 0).sum) = W *ᵥ d := by
  funext i
  rw [← List.sum_toFinset _ (pivots_nodup W), pivots_toFinset, Finset.sum_filter,
    Fintype.sum_prod_type]
  have h1 : ∀ a b, (if W a b = 1 then (if a = i then d b else 0) else 0) =
      if a = i then (if W i b = 1 then d b else 0) else 0 := by
    intro a b; by_cases h : a = i
    · subst h; simp
    · simp [h]
  simp only [h1]
  rw [Finset.sum_comm]
  simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true, mulVec, dotProduct]
  refine Finset.sum_congr rfl fun b _ => ?_
  by_cases h : W i b = 1
  · simp [h]
  · rcases hW i b with h' | h'
    · rw [if_neg h, h', zero_mul]
    · exact absurd h' h

end Pivot

section Shear

variable {m Q : ℕ}

variable {E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)}

theorem runVec_shearSteps (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i))
    (hW : ∀ i j, W i j = 0 ∨ W i j = 1) (x : Fin (m + m) → ZMod Q) :
    runVec (shearSteps E₁ W E₂) x = shearMat (E₁ * W * E₂) *ᵥ x := by
  simp only [shearSteps, runVec_append]
  have hx2 : runVec (hSteps E₁) (runVec (revSteps (hSteps E₁)) (runVec (dSteps E₂) x)) =
      runVec (dSteps E₂) x := runVec_runVec_revSteps (hSteps_WF hd₁) _
  have key : runVec (hSteps E₁) (runVec (addSteps (pivots W))
      (runVec (revSteps (hSteps E₁)) (runVec (dSteps E₂) x))) =
      runVec (dSteps E₂) (shearMat (E₁ * W * E₂) *ᵥ x) := by
    obtain ⟨a1, a2⟩ := runVec_dSteps hE₂ x
    obtain ⟨b1, b2⟩ := runVec_hSteps hE₁ (runVec (revSteps (hSteps E₁)) (runVec (dSteps E₂) x))
    rw [hx2] at b1 b2
    obtain ⟨c1, c2⟩ := runVec_addSteps (Q := Q) (pivots W)
      (runVec (revSteps (hSteps E₁)) (runVec (dSteps E₂) x))
    rw [sum_pivots hW] at c1
    obtain ⟨d1, d2⟩ := runVec_hSteps hE₁ (runVec (addSteps (pivots W))
      (runVec (revSteps (hSteps E₁)) (runVec (dSteps E₂) x)))
    obtain ⟨e1, e2⟩ := runVec_dSteps hE₂ (shearMat (E₁ * W * E₂) *ᵥ x)
    apply vec_ext
    · rw [d1, e1, c1, hv_shearMat, mulVec_add, ← b1, a1, ← b2, a2]
      simp only [mulVec_mulVec, Matrix.mul_assoc]
    · rw [d2, e2, c2, ← b2, a2, dv_shearMat]
  rw [key, runVec_revSteps_runVec (dSteps_WF hd₂)]

theorem shearSteps_WF (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i)) :
    ∀ s ∈ shearSteps E₁ W E₂, s.WF := by
  intro s hs
  simp only [shearSteps, List.mem_append] at hs
  rcases hs with (((hs | hs) | hs) | hs) | hs
  · exact dSteps_WF hd₂ s hs
  · exact revSteps_WF (hSteps_WF hd₁) s hs
  · exact addSteps_WF _ s hs
  · exact hSteps_WF hd₁ s hs
  · exact revSteps_WF (dSteps_WF hd₂) s hs

/-- Exactly one field interchange per one of `W`. -/
theorem countP_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).countP Step.isSwap =
      (Finset.univ.filter fun p : Fin m × Fin m => W p.1 p.2 = 1).card := by
  simp only [shearSteps, List.countP_append, countP_revSteps, countP_hSteps, countP_dSteps,
    countP_addSteps, length_pivots]
  ring

lemma swap_not_mem_of_shifts {n : ℕ} {l : List (Step n Q)} (hl : ∀ s ∈ l, s.isSwap = false)
    {a b : Fin n} : Step.swap a b ∉ l := fun h => by simpa [Step.isSwap] using hl _ h

lemma hSteps_shift (E : Matrix (Fin m) (Fin m) (ZMod Q)) : ∀ s ∈ hSteps E, s.isSwap = false := by
  intro s hs
  simp only [hSteps, List.mem_map] at hs
  obtain ⟨_, -, rfl⟩ := hs; rfl

lemma dSteps_shift (E : Matrix (Fin m) (Fin m) (ZMod Q)) : ∀ s ∈ dSteps E, s.isSwap = false := by
  intro s hs
  simp only [dSteps, List.mem_map] at hs
  obtain ⟨_, -, rfl⟩ := hs; rfl

lemma revSteps_shift {n : ℕ} {l : List (Step n Q)} (hl : ∀ s ∈ l, s.isSwap = false) :
    ∀ s ∈ revSteps l, s.isSwap = false := by
  intro s hs
  simp only [revSteps, List.mem_reverse, List.mem_map] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  have := hl t ht
  cases t with
  | shift i u c => rfl
  | swap i j => simp [Step.isSwap] at this

/-- Every interchange of `shearSteps` exchanges an `H` field with a `D` field. -/
theorem shearSteps_swap_HD {a b : Fin (m + m)} (h : Step.swap a b ∈ shearSteps E₁ W E₂) :
    ∃ i j : Fin m, a = Fin.castAdd m i ∧ b = Fin.natAdd m j := by
  simp only [shearSteps, List.mem_append] at h
  rcases h with (((h | h) | h) | h) | h
  · exact absurd h (swap_not_mem_of_shifts (dSteps_shift E₂))
  · exact absurd h (swap_not_mem_of_shifts (revSteps_shift (hSteps_shift E₁)))
  · simp only [addSteps, List.mem_flatMap] at h
    obtain ⟨p, -, hp⟩ := h
    simp only [pivotSteps, List.mem_cons, List.not_mem_nil, or_false, reduceCtorEq, false_or,
      or_false, Step.swap.injEq] at hp
    exact ⟨p.1, p.2, hp.1, hp.2⟩
  · exact absurd h (swap_not_mem_of_shifts (hSteps_shift E₁))
  · exact absurd h (swap_not_mem_of_shifts (revSteps_shift (dSteps_shift E₂)))

variable {sh : Shape} (Λ : Layout sh (m + m) Q) [NeZero Q]

/-- **Lemma 10 (array model).** For `A = E₁ W E₂` with `E₁, E₂` lower triangular with unit
diagonal and `W` a `0/1` matrix, the shear address map `(H, D) ↦ (H + A D, D)` is the run of
`shearSteps E₁ W E₂`. -/
theorem shear_via_pivots {A : Matrix (Fin m) (Fin m) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i))
    (hW : ∀ i j, W i j = 0 ∨ W i j = 1) (hA : A = E₁ * W * E₂) :
    (∀ a, Valid sh a → amap Λ (shearMat A) a = run Λ (shearSteps E₁ W E₂) a) ∧
    (∀ s ∈ shearSteps E₁ W E₂, s.WF) ∧
    (shearSteps E₁ W E₂).countP Step.isSwap =
      (Finset.univ.filter fun p : Fin m × Fin m => W p.1 p.2 = 1).card ∧
    (∀ a b, Step.swap a b ∈ shearSteps E₁ W E₂ →
      ∃ i j : Fin m, a = Fin.castAdd m i ∧ b = Fin.natAdd m j) := by
  refine ⟨fun a ha => ?_, shearSteps_WF hd₁ hd₂, countP_shearSteps E₁ W E₂,
    fun a b h => shearSteps_swap_HD h⟩
  rw [run_eq_vmap Λ _ ha, amap_eq_vmap, hA]
  congr 1; funext x
  exact (runVec_shearSteps hE₁ hE₂ hd₁ hd₂ hW x).symm

/-- **Lemma 10, array version.** The array permutation of the shear by `A` (the pull by its
inverse address map, the shear by `-A`) is the array run of `shearSteps E₁ W E₂`. -/
theorem shear_via_pivots_array {A : Matrix (Fin m) (Fin m) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i))
    (hW : ∀ i j, W i j = 0 ∨ W i j = 1) (hA : A = E₁ * W * E₂)
    {α : Type*} (d : α) (xs : List α) (hxs : xs.length = vol sh) :
    pull sh sh (amap Λ (shearMat (-A))) d xs = AModel.runArr Λ d (shearSteps E₁ W E₂) xs := by
  obtain ⟨hrun, hWF, -, -⟩ := shear_via_pivots Λ hE₁ hE₂ hd₁ hd₂ hW hA
  rw [AModel.runArr_eq_pull Λ d _ hxs]
  apply pull_congr
  intro b hb
  have hb' := valid_amap Λ (shearMat (-A)) hb
  have e : amap Λ (shearMat A) (amap Λ (shearMat (-A)) b) = b := by
    rw [amap_shear_comp Λ _ _ hb, neg_add_cancel, amap_shear_zero Λ hb]
  calc amap Λ (shearMat (-A)) b
      = invChain Λ (shearSteps E₁ W E₂) (run Λ (shearSteps E₁ W E₂) (amap Λ (shearMat (-A)) b)) :=
        (invChain_run Λ hWF hb').symm
    _ = invChain Λ (shearSteps E₁ W E₂) b := by rw [← hrun _ hb', e]

end Shear

section Interchange

variable {m Q : ℕ}

lemma dhStep_WF {u : ZMod Q} (hu : IsUnit u) (c : ZMod Q) (j : Fin m) : (dhStep u c j).WF := by
  refine ⟨hu, fun l hl => ?_⟩
  rw [Pi.single_apply, if_neg]
  rintro rfl; exact absurd hl (not_le.2 (castAdd_lt_natAdd j j))

lemma runVec_dhSteps (u c : ZMod Q) (l : List (Fin m)) (hl : l.Nodup) (x : Fin (m + m) → ZMod Q) :
    hv (runVec (l.map (dhStep u c)) x) = hv x ∧
    dv (runVec (l.map (dhStep u c)) x) =
      fun j => if j ∈ l then u * dv x j + c * hv x j else dv x j := by
  induction l generalizing x with
  | nil => exact ⟨rfl, by funext j; simp only [List.not_mem_nil, if_false]; rfl⟩
  | cons j l ih =>
    rw [List.nodup_cons] at hl
    rw [List.map_cons, runVec_cons]
    set y := (dhStep u c j).vec x with hy
    have hyv : y = Function.update x (Fin.natAdd m j)
        (u * x (Fin.natAdd m j) + c * x (Fin.castAdd m j)) := by
      simp only [hy, dhStep, Step.vec, shiftVec]
      congr 2
      simp [Pi.single_apply]
    have h1 : hv y = hv x := by
      funext i; rw [hyv]; exact Function.update_of_ne (castAdd_ne_natAdd i j) _ _
    have h2 : dv y = fun j' => if j' = j then u * dv x j + c * hv x j else dv x j' := by
      funext j'; rw [hyv]
      by_cases h : j' = j
      · subst h; simp [dv, hv, -Fin.natAdd_eq_addNat]
      · simp [dv, h, -Fin.natAdd_eq_addNat]
    obtain ⟨i1, i2⟩ := ih hl.2 y
    refine ⟨i1.trans h1, ?_⟩
    rw [i2, h1, h2]
    funext j'
    by_cases h : j' = j
    · subst h; simp [hl.1]
    · simp [h]

lemma runVec_subSteps (x : Fin (m + m) → ZMod Q) :
    hv (runVec (subSteps (Q := Q) m) x) = hv x ∧
    dv (runVec (subSteps (Q := Q) m) x) = dv x - hv x := by
  obtain ⟨h1, h2⟩ := runVec_dhSteps (1 : ZMod Q) (-1) _ (List.nodup_finRange m) x
  refine ⟨h1, ?_⟩
  rw [subSteps, h2]; funext j; simp [sub_eq_add_neg]

lemma runVec_flipSteps (x : Fin (m + m) → ZMod Q) :
    hv (runVec (flipSteps (Q := Q) m) x) = hv x ∧
    dv (runVec (flipSteps (Q := Q) m) x) = hv x - dv x := by
  obtain ⟨h1, h2⟩ := runVec_dhSteps (-1 : ZMod Q) 1 _ (List.nodup_finRange m) x
  refine ⟨h1, ?_⟩
  rw [flipSteps, h2]; funext j; simp; ring

lemma subSteps_WF : ∀ s ∈ subSteps (Q := Q) m, s.WF := by
  intro s hs
  simp only [subSteps, List.mem_map] at hs
  obtain ⟨j, -, rfl⟩ := hs
  exact dhStep_WF isUnit_one _ j

lemma flipSteps_WF : ∀ s ∈ flipSteps (Q := Q) m, s.WF := by
  intro s hs
  simp only [flipSteps, List.mem_map] at hs
  obtain ⟨j, -, rfl⟩ := hs
  exact dhStep_WF isUnit_one.neg _ j

lemma hv_swapMat (x : Fin (m + m) → ZMod Q) : hv (swapMat *ᵥ x) = dv x := by
  simp [swapMat, (blk_mulVec _ _ _ _ x).1]

lemma dv_swapMat (x : Fin (m + m) → ZMod Q) : dv (swapMat *ᵥ x) = hv x := by
  simp [swapMat, (blk_mulVec _ _ _ _ x).2]

/-- Vector form: `(H, D) ↦ (D, H)` is `D ← D − H`, shear by `1`, `D ← H − D`. -/
theorem runVec_interchange (x : Fin (m + m) → ZMod Q) :
    runVec (flipSteps m) (shearMat 1 *ᵥ runVec (subSteps m) x) = swapMat *ᵥ x := by
  obtain ⟨a1, a2⟩ := runVec_subSteps (Q := Q) (m := m) x
  obtain ⟨b1, b2⟩ := runVec_flipSteps (Q := Q) (m := m) (shearMat 1 *ᵥ runVec (subSteps m) x)
  apply vec_ext
  · rw [b1, hv_shearMat, hv_swapMat, a1, a2, one_mulVec]; abel
  · rw [b2, hv_shearMat, dv_shearMat, dv_swapMat, a1, a2, one_mulVec]; abel

lemma swapMat_mul_self : (swapMat : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod Q)) * swapMat = 1 := by
  rw [swapMat, blk_mul]
  simpa [shearMat] using (shearMat_zero (m := m) (Q := Q))

variable {sh : Shape} (Λ : Layout sh (m + m) Q) [NeZero Q]

/-- **Interchange from a shear.** For any address map `S` agreeing with the shear by `1`
(`(H, D) ↦ (H + D, D)`) on valid addresses, the block interchange `(H, D) ↦ (D, H)` equals:
the shifts `D ← D − H`, then `S`, then the shifts `D ← H − D`. -/
theorem interchange_via_shear (S : List ℕ → List ℕ)
    (hS : ∀ a, Valid sh a → S a = amap Λ (shearMat 1) a) :
    ∀ a, Valid sh a → amap Λ swapMat a = run Λ (flipSteps m) (S (run Λ (subSteps m) a)) := by
  intro a ha
  rw [hS _ (valid_run Λ _ ha), run_eq_vmap Λ _ ha, amap_eq_vmap,
    run_eq_vmap Λ _ (valid_amap Λ _ (valid_vmap Λ _ ha)), amap_eq_vmap,
    vmap_vmap Λ _ _ ha, vmap_vmap Λ _ _ ha]
  congr 1; funext x
  exact (runVec_interchange x).symm

/-- **Interchange from a shear, array version.** If `S'` is the pull map of the black-box
shear (it agrees with the shear by `-1`, the inverse of the shear by `1`), then the array
permutation of the interchange (pull by `amap swapMat`, which is its own inverse) is: the array
run of `D ← D − H`, then the pull by `S'`, then the array run of `D ← H − D`. -/
theorem interchange_via_shear_array (S' : List ℕ → List ℕ)
    (hS' : ∀ a, Valid sh a → S' a = amap Λ (shearMat (-1)) a)
    {α : Type*} (d : α) (xs : List α) (hxs : xs.length = vol sh) :
    pull sh sh (amap Λ swapMat) d xs =
      AModel.runArr Λ d (flipSteps m) (pull sh sh S' d (AModel.runArr Λ d (subSteps m) xs)) := by
  rw [AModel.runArr_eq_pull Λ d _ hxs,
    pull_comp _ _ (fun a ha => by rw [hS' a ha]; exact valid_amap Λ _ ha), runArr_pull]
  apply pull_congr
  intro b hb
  have hc := valid_amap Λ swapMat hb
  have hfwd := interchange_via_shear Λ (amap Λ (shearMat 1)) (fun _ _ => rfl) _ hc
  rw [amap_mul Λ _ _ hb, swapMat_mul_self, amap_one Λ hb] at hfwd
  have hr := valid_run Λ (subSteps m) hc
  simp only [Function.comp_apply]
  have h1 : invChain Λ (flipSteps m) b = amap Λ (shearMat 1) (run Λ (subSteps m) (amap Λ swapMat b)) := by
    conv_lhs => rw [hfwd]
    exact invChain_run Λ flipSteps_WF (valid_amap Λ _ hr)
  rw [h1, hS' _ (valid_amap Λ _ hr),
    amap_shear_comp Λ _ _ hr, add_neg_cancel, amap_shear_zero Λ hr, invChain_run Λ subSteps_WF hc]

end Interchange

end AModel

end

section
-- Source module: Solutions.AModelNet
namespace AModel

open Matrix

section RowSplit

variable {α : Type*}

@[simp] lemma length_rowMerge (P W L : ℕ) [NeZero W] (rest : Shape) (d : α)
    (s : Fin W → List α) : (rowMerge P W L rest d s).length = vol (P :: W * L :: rest) := by
  simp [rowMerge]

lemma valid_rowSplitAddr {P W L : ℕ} {rest : Shape} {w : ℕ} (hw : w < W) {a : List ℕ}
    (ha : Valid (P :: L :: rest) a) : Valid (P :: W * L :: rest) (rowSplitAddr W w a) := by
  obtain ⟨p, q, x, rfl, hp, hq, hx⟩ := valid_cons2 ha
  refine valid_cons2_mk hp ?_ hx
  simp only [List.tail_cons, List.headD_cons]
  have := Nat.mul_le_mul_left W (show q + 1 ≤ L from hq)
  rw [Nat.mul_succ] at this
  omega

lemma valid_rowMergeAddr {P W L : ℕ} [NeZero W] {rest : Shape} {a : List ℕ}
    (ha : Valid (P :: W * L :: rest) a) : Valid (P :: L :: rest) (rowMergeAddr W a) := by
  obtain ⟨p, q, x, rfl, hp, hq, hx⟩ := valid_cons2 ha
  refine valid_cons2_mk hp ?_ hx
  exact (Nat.div_lt_iff_lt_mul (NeZero.pos W)).2 (by rw [Nat.mul_comm]; exact hq)

lemma rowSplitAddr_rowMergeAddr {W : ℕ} [NeZero W] (a : List ℕ) (ha : 2 ≤ a.length) :
    rowSplitAddr W (rowIdx W a) (rowMergeAddr W a) = a := by
  match a, ha with
  | p :: q :: x, _ => simp [rowSplitAddr, rowMergeAddr, rowIdx, Nat.div_add_mod]

lemma two_le_length_of_valid {P Q : ℕ} {sh : Shape} {a : List ℕ}
    (h : Valid (P :: Q :: sh) a) : 2 ≤ a.length := by
  obtain ⟨p, q, x, rfl, -⟩ := valid_cons2 h
  simp

/-- merge ∘ split = id. -/
theorem rowMerge_rowSplit (P W L : ℕ) [NeZero W] (rest : Shape) (d : α) {xs : List α}
    (hxs : xs.length = vol (P :: W * L :: rest)) :
    rowMerge P W L rest d (fun w => rowSplit P W L rest w d xs) = xs := by
  apply List.ext_getElem (by simp [hxs])
  intro j h₁ h₂
  simp only [length_rowMerge] at h₁
  have hv := valid_decode h₁
  have hm := valid_rowMergeAddr hv
  have hlt := encode_lt hm
  simp only [rowMerge, List.getElem_map, List.getElem_range]
  simp only [rowSplit]
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), getElem_pull, decode_encode hm,
    rowSplitAddr_rowMergeAddr _ (two_le_length_of_valid hv), encode_decode h₁,
    List.getD_eq_getElem]

/-- `rowSplit` commutes with a pull acting only on the `rest` digits. -/
theorem rowSplit_pull_rowLift (P W L : ℕ) (rest : Shape) (w : Fin W) (g : List ℕ → List ℕ)
    (hg : ∀ x, Valid rest x → Valid rest (g x)) (d : α) (xs : List α) :
    rowSplit P W L rest w d (pull (P :: W * L :: rest) (P :: W * L :: rest) (rowLift g) d xs) =
      pull (P :: L :: rest) (P :: L :: rest) (rowLift g) d (rowSplit P W L rest w d xs) := by
  unfold rowSplit
  rw [pull_comp _ _ (fun a ha => valid_rowSplitAddr w.isLt ha),
    pull_comp _ _ (fun a ha => valid_rowLift hg ha)]
  rfl

end RowSplit

section Network

variable {Wr Ω R M : Type*} [CommRing R] [Fintype Wr] [DecidableEq Wr] [AddGroup M]

/-- **Network theorem.** If the scalar circuit routes wire `w` to wire `ρ w` unchanged and
`Mout (ρ w) - Min w = I0` for all `w`, then the physical network outputs `Φ I0 (f w)` on
wire `ρ w`. -/
theorem network_realizes (Φ : M → (Ω → R) →ₗ[R] (Ω → R))
    (hadd : ∀ a b x, Φ (a + b) x = Φ a (Φ b x)) (hzero : ∀ x, Φ 0 x = x)
    (gates : List (NGate Wr R M)) (hg : ∀ g ∈ gates, g.OK)
    (ρ : Wr → Wr) (hρ : ∀ (v : Wr → R) w, scalarRun gates v (ρ w) = v w)
    (Min Mout : Wr → M) (I0 : M) (hI : ∀ w, Mout (ρ w) - Min w = I0) (f : Wr → Ω → R) :
    ∀ w, netRun Φ gates Min Mout f (ρ w) = Φ I0 (f w) := by
  intro w
  have hinv := physRun_inv Φ hadd gates hg (Min, f) (fun w => Φ (-Min w) (f w))
    (fun w => by simp [← hadd, hzero]) (ρ w)
  have hlog : gates.foldl logStep (fun w => Φ (-Min w) (f w)) (ρ w) = Φ (-Min w) (f w) := by
    funext ω
    rw [logRun_apply, hρ]
  simp only [netRun]
  rw [hinv, hlog, ← hadd, sub_add_cancel, ← hadd, ← sub_eq_add_neg, hI]

end Network

section Combine

/-- Pull by a valid-preserving address map is precomposition with `addrPerm`. -/
theorem pull_eq_ofFn_funLeft {R : Type*} [CommRing R] (sh : Shape) (G : List ℕ → List ℕ)
    (hG : ∀ a, Valid sh a → Valid sh (G a)) (l : List R) :
    pull sh sh G 0 l =
      List.ofFn (LinearMap.funLeft R R (addrPerm sh G hG) (fun i => l.getD (i : ℕ) 0)) := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  rw [getElem_pull, List.getElem_ofFn]
  rfl

lemma streamΦ_add {R M : Type*} [CommRing R] [AddCommGroup M] (P L : ℕ) (rest : Shape)
    (π : M → List ℕ → List ℕ) (hπv : ∀ m x, Valid rest x → Valid rest (π m x))
    (hπadd : ∀ a b x, Valid rest x → π (a + b) x = π a (π b x)) (a b : M) (x) :
    streamΦ (R := R) P L rest π hπv (a + b) x =
      streamΦ P L rest π hπv a (streamΦ P L rest π hπv b x) := by
  funext j
  simp only [streamΦ, LinearMap.funLeft_apply, addrPerm]
  congr 1
  apply Fin.ext
  simp only
  have hv := valid_decode j.isLt
  obtain ⟨p, q, y, hy, hp, hq, hx⟩ := valid_cons2 hv
  have hv' := valid_rowLift (hπv a) hv
  rw [decode_encode hv', hy]
  simp only [rowLift, List.headD_cons, List.tail_cons]
  rw [add_comm, hπadd b a y hx]

lemma streamΦ_zero {R M : Type*} [CommRing R] [AddCommGroup M] (P L : ℕ) (rest : Shape)
    (π : M → List ℕ → List ℕ) (hπv : ∀ m x, Valid rest x → Valid rest (π m x))
    (hπ0 : ∀ x, Valid rest x → π 0 x = x) (x) :
    streamΦ (R := R) P L rest π hπv 0 x = x := by
  funext j
  simp only [streamΦ, LinearMap.funLeft_apply, addrPerm]
  congr 1
  apply Fin.ext
  simp only
  have hv := valid_decode j.isLt
  obtain ⟨p, q, y, hy, hp, hq, hx⟩ := valid_cons2 hv
  have : rowLift (π 0) (decode (P :: L :: rest) j) = decode (P :: L :: rest) j := by
    rw [hy]; simp [rowLift, hπ0 y hx]
  rw [this, encode_decode j.isLt]

/-- **Interchange via the network.** Split the rows of `xs` into `W` role streams, run the
network on them with frames `Φ_M` = pull by `π M` on the `rest` digits, and merge back, returning
output role `ρ w` to the rows of role `w`. The result is the pull of the whole array by `π I0` on
the `rest` digits (prefix and row digits fixed). -/
theorem network_interchange_shear {R M : Type*} [CommRing R] [AddCommGroup M]
    (P W L : ℕ) [NeZero W] (rest : Shape) (π : M → List ℕ → List ℕ)
    (hπv : ∀ m x, Valid rest x → Valid rest (π m x))
    (hπadd : ∀ a b x, Valid rest x → π (a + b) x = π a (π b x))
    (hπ0 : ∀ x, Valid rest x → π 0 x = x)
    (gates : List (NGate (Fin W) R M)) (hg : ∀ g ∈ gates, g.OK)
    (ρ : Fin W → Fin W) (hρ : ∀ (v : Fin W → R) w, scalarRun gates v (ρ w) = v w)
    (Min Mout : Fin W → M) (I0 : M) (hI : ∀ w, Mout (ρ w) - Min w = I0) (xs : List R) :
    rowMerge P W L rest 0 (fun w => List.ofFn
      (netRun (streamΦ P L rest π hπv) gates Min Mout
        (fun w' i => (rowSplit P W L rest w' 0 xs).getD (i : ℕ) 0) (ρ w))) =
      pull (P :: W * L :: rest) (P :: W * L :: rest) (rowLift (π I0)) 0 xs := by
  have key : ∀ w, List.ofFn (netRun (streamΦ P L rest π hπv) gates Min Mout
      (fun w' i => (rowSplit P W L rest w' 0 xs).getD (i : ℕ) 0) (ρ w)) =
      rowSplit P W L rest w 0
        (pull (P :: W * L :: rest) (P :: W * L :: rest) (rowLift (π I0)) 0 xs) := by
    intro w
    rw [network_realizes _ (streamΦ_add P L rest π hπv hπadd) (streamΦ_zero P L rest π hπv hπ0)
      gates hg ρ hρ Min Mout I0 hI, rowSplit_pull_rowLift _ _ _ _ _ _ (hπv I0),
      pull_eq_ofFn_funLeft _ _ (fun _ ha => valid_rowLift (hπv I0) ha)]
    rfl
  simp only [key]
  exact rowMerge_rowSplit P W L rest 0 (by simp)

end Combine

end AModel

