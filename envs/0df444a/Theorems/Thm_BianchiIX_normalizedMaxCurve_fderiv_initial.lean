theorem BianchiIX.normalizedMaxCurve_fderiv_initial {x : NormalizedState} {t₀ t : ℝ}
    (ht : t ∈ normalizedMaxDomain x t₀) :
    (fderiv ℝ (fun z : NormalizedState × ℝ => normalizedMaxCurve z.1 t₀ z.2) (x, t)).comp
      (ContinuousLinearMap.inl ℝ NormalizedState ℝ) = normalizedFlowDifferential x t₀ t := by sorry
