theorem NLogN.KFG.gate_fsp {W L : ℕ} (s : IState HS) (l : List ℤ) (Z : ℕ)
    (hZ : zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (as : List Atom), (∀ a ∈ as, a.Ok W) → NoTS as →
    ∀ (e : ℕ → ℕ) (f : Fin HS → List ℤ) (zs : List GI) (y : ℕ → ℕ → ℂ) (w : ℕ),
      Enc W L e zs y → f 0 = gflat zs ++ l → ClP f → NLogN.KFB.GB w zs →
      Enc W L (gateE as e) (gateL as e L zs) (gateY as y) ∧ NLogN.KFB.GB (gateW as e w) (gateL as e L zs) ∧
      FSp (gateP as e L) (encK s f) (encK s (Function.update f 0 (gflat (gateL as e L zs) ++ l)))
        (cGate as e w L W Z) := by sorry
