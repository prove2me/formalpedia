  have hT2 : IntMul.OpenAI.Glue.TP n < 2 ^ IntMul.OpenAI.Glue.bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  set VT := AModel.vol (NLogN.KFU.shR (IntMul.OpenAI.Glue.dP n) (NLogN.KFU.tP (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n))) with hVTd
  set VS := AModel.vol (NLogN.KFU.shR (IntMul.OpenAI.Glue.dP n) (NLogN.KFU.sP (IntMul.OpenAI.Glue.dP n) (NLogN.KFM.srcN n))) with hVSd
  set PM := AModel.vol ((List.range (IntMul.OpenAI.Glue.dP n - 1)).map (NLogN.KFM.srcN n)) with hPMd
  have hBb : NLogN.zsz ((2 * VS : ℕ) : ℤ) ≤ IntMul.OpenAI.Glue.bP n + 3 :=
    NLogN.KFM.zsz_lt_pow (by
      calc 2 * VS ≤ 4 * IntMul.OpenAI.Glue.TP n := by omega
