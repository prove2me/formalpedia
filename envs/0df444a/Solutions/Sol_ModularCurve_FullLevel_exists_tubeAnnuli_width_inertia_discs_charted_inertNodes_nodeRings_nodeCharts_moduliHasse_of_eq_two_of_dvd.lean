noncomputable def placeComap {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]
    (ι : F₁ ≃ₐ[K] F₂) (v : Place K F₂) : Place K F₁ where
  toValuationSubring := v.toValuationSubring.comap ι.toAlgHom.toRingHom
  algebraMap_mem' a := by
    show ι.toAlgHom.toRingHom (algebraMap K F₁ a) ∈ v.toValuationSubring
    simpa using v.algebraMap_mem' a
  ne_top' h := v.ne_top' <| by
    ext y
    refine ⟨fun _ => ValuationSubring.mem_top y, fun _ => ?_⟩
    have : ι.symm y ∈ v.toValuationSubring.comap ι.toAlgHom.toRingHom := h ▸ ValuationSubring.mem_top _
    simpa [ValuationSubring.mem_comap] using this
  isPrincipalIdealRing' := by
    let e : ↥(v.toValuationSubring.comap ι.toAlgHom.toRingHom) ≃+* ↥v.toValuationSubring :=
      { toFun := fun x => ⟨ι x, x.2⟩
        invFun := fun y => ⟨ι.symm y, by
          show ι.toAlgHom.toRingHom (ι.symm y) ∈ v.toValuationSubring
          simpa using y.2⟩
        left_inv := fun x => by ext; simp
        right_inv := fun y => by ext; simp
        map_mul' := fun x y => by ext; change ι ((x : F₁) * (y : F₁)) = ι x * ι y; exact map_mul ι _ _
        map_add' := fun x y => by ext; change ι ((x : F₁) + (y : F₁)) = ι x + ι y; exact map_add ι _ _ }
    exact IsPrincipalIdealRing.of_surjective e.symm.toRingHom e.symm.surjective

theorem mem_placeComap {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]
    (ι : F₁ ≃ₐ[K] F₂) (v : Place K F₂) (x : F₁) :
    x ∈ (placeComap ι v).toValuationSubring ↔ ι x ∈ v.toValuationSubring := Iff.rfl

end RedII

