theorem candidateTotalCap_bound (T : Tournament k) (label : Fin k → Fin k → Fin 2)
    (hCaps : LabelCaps T label) (F : Fin n → (I → Bool) → Bool) (hF : NestedFamily F)
    (t g : Fin n) (hgt : g ≤  t) (q : ℕ) (hq : 4 ≤  q) (hq8 : q ≤  8)
    (x : ((Fin k × Fin 2) × I) → Bool) :
    (tolerantTargets T label F t g q x).card ≤ 
      candidateTotalCap q (tolerantGuards T label F t g q x).card
        (positiveTargets T label F t g q x (by decide)).card := by
  let C := tolerantTargets T label F t g q x
  let G := tolerantGuards T label F t g q x
  let P := positiveTargets T label F t g q x (by decide)
  have hordinary := targets_card_of_exclusion T label F hF t g hgt q (cutoff q)
    (hCaps.ordinary q hq hq8) x
  change C.card <  cutoff q at hordinary
  have hord : C.card ≤  cutoff q-1 := by omega
  have hg : C.card+G.card ≤  cutoff q := targets_guards_card_of_exclusion
    T label F hF t g hgt q (cutoff q) (hCaps.ordinary q hq hq8) x
  have hguard : 0 <  G.card → C.card ≤  guardCap q := by
    intro hgn
    by_cases he : q=4
    · subst q
      have hc := targets_card_guard_marked T label F hF t g hgt 4 1 45 hCaps.one_four x hgn
      change C.card <  45 at hc
      change C.card ≤  44
      omega
    · have hq5 : 5 ≤  q := by omega
      have hh : guardCap q = cutoff q-1 := by interval_cases q <;> decide
      rw [hh]
      exact hord
  have hpositive : 0 <  P.card → C.card ≤  targetCap q := by
    intro hpn
    by_cases he : q=4
    · subst q
      have hc := targets_card_positive_marked T label F hF t g hgt 4 1 45 hCaps.one_four x hpn
      change C.card <  45+1 at hc
      change C.card ≤  45
      omega
    · have hq5 : 5 ≤  q := by omega
      have hh : targetCap q = cutoff q-1 := by interval_cases q <;> decide
      rw [hh]
      exact hord
  let base := if 0< G.card then min (cutoff q-G.card) (guardCap q) else cutoff q-1
  have hb : C.card ≤  base := by
    dsimp only [base]
    split_ifs with hgn
    · exact le_min (by omega) (hguard hgn)
    · exact hord
  change C.card ≤  if 0< P.card then min base (targetCap q) else base
  split_ifs with hpn
  · exact le_min hb (hpositive hpn)
  · exact hb





