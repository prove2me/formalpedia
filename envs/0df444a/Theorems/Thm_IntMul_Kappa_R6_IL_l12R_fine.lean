open IntMul IntMul.Kappa IntMul.Kappa.R6 IntMul.Kappa.R6.IL
open IntMul NLogN NLogN.RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset
variable {W T m : ℕ} [NeZero W]

theorem IntMul.Kappa.R6.IL.l12R_fine (C : Bit.QHNet (ZMod 2) W T m) (hm : 2 ≤ m) (hruns : C.RunsOK) {τ : ℝ}
    (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) (hmom : histMoment C.hist m τ < W)
    {cW : ℕ} (hcW : ∀ k, Bit.depH m (m ^ k) ≤ cW * k) {q : ℕ} (hq : q.Prime)
    (hOK : ∀ f, C.OK (q ^ f)) {tab : Fin 1 → IStmt HS 1} {T₀ c₁ : ℕ} {K₁ K₂ : ℝ}
    (hK₁ : 0 ≤ K₁) (hK₂ : 0 ≤ K₂) (hIL : ILProp11 tab C q T₀ c₁ K₁ K₂) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : Shape) (Bb : ℕ), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      zsz (((8 + m + W ^ cW + 4 * T₀) * (q ^ 2 * vol (binShape Pre G Suf (2 ^ u)) + 1) ^ 2 : ℕ) :
        ℤ) ≤ Bb → 1 ≤ Bb →
      ∀ (I : List Sym) (s : IState HS) (F : Fin HS → List ℤ) (xs : List (ZMod 2))
        (LP LG LS LU : List ℤ),
      F KIL.kP = (vol Pre : ℤ) :: LP → F KIL.kG = (vol G : ℤ) :: LG →
      F KIL.kS = (vol Suf : ℤ) :: LS → F KIL.aU = (u : ℤ) :: LU → F 0 = enc2 xs →
      F 8 = [] → F 9 = [] → F 10 = [] → F 11 = [] → F 15 = [] → F 20 = [] → F 21 = [] →
      F 23 = [] → F 24 = [] →
      xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      ∃ c : ℕ, IRuns I tab (l12F q m (W ^ cW)) (encK s F)
        (encK s (Function.update F 0 (enc2 (pull (binShape Pre G Suf (2 ^ u))
          (binShape Pre G Suf (2 ^ u)) (swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs))))
        c ∧
        (c : ℝ) ≤ K * (((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ +
          ((u : ℝ) + 1) ^ (c₁ + 1) * ((Bb : ℝ) + 2) ^ 2) := by sorry
