section GlueVertices

open scoped Classical

variable {I : Type} {r : I → ℕ} {t m : ℕ}
variable (F : (i : I) → RootedTest (r i) t) (η : (i : I) → Fin (r i) → Fin m)

def GlueRootRel (a b : Fin m) : Prop :=
  ∃ i j l, a = η i j ∧ b = η i l ∧ (F i).roots j = (F i).roots l

def GlueRoot := Quot (GlueRootRel F η)

noncomputable instance glueRootFintype : Fintype (GlueRoot F η) :=
  Fintype.ofSurjective (Quot.mk (GlueRootRel F η))
    (fun q => Quot.inductionOn q (fun a => ⟨a, rfl⟩))

abbrev GlueInternal (i : I) := {a : (F i).Vertex // ¬ ∃ j, (F i).roots j = a}

abbrev GlueVertex := GlueRoot F η ⊕ ((i : I) × GlueInternal F i)

noncomputable local instance : DecidableEq (GlueVertex F η) := Classical.decEq _

noncomputable def glueRoot (j : Fin m) : GlueVertex F η := .inl (Quot.mk _ j)

noncomputable def glueMap (i : I) (a : (F i).Vertex) : GlueVertex F η :=
  if h : ∃ j, (F i).roots j = a then
    .inl (Quot.mk _ (η i h.choose)) else .inr ⟨i, ⟨a, h⟩⟩

lemma glueMap_root (i : I) (j : Fin (r i)) :
    glueMap F η i ((F i).roots j) = glueRoot F η (η i j) := by
  unfold glueMap glueRoot
  split_ifs with h
  · apply congrArg Sum.inl
    apply Quot.sound
    exact ⟨i, h.choose, j, rfl, rfl, h.choose_spec⟩
  · exact (h ⟨j, rfl⟩).elim

lemma glueMap_internal (i : I) (a : GlueInternal F i) :
    glueMap F η i a = .inr ⟨i, a⟩ := by
  simp only [glueMap, dite_eq_right a.2]

lemma glueMap_eq_inl (i : I) (a : (F i).Vertex) (q : GlueRoot F η)
    (h : glueMap F η i a = .inl q) : ∃ j, (F i).roots j = a := by
  by_contra hn
  simp only [glueMap, dite_eq_right hn] at h
  cases h

lemma glueMap_eq_internal (i j : I) (a : (F i).Vertex) (b : GlueInternal F j)
    (h : glueMap F η i a = .inr ⟨j, b⟩) :
    ∃ e : i = j, e ▸ a = b.1 := by
  by_cases ha : ∃ j, (F i).roots j = a
  · simp only [glueMap, dite_eq_left ha] at h
    cases h
  · simp only [glueMap, dite_eq_right ha] at h
    have he := Sum.inr.inj h
    have hij : i = j := congrArg Sigma.fst he
    subst i
    refine ⟨rfl, ?_⟩
    have hab : (⟨a, ha⟩ : GlueInternal F j) = b := by
      simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using he
    exact congrArg Subtype.val hab

noncomputable def glueBag : GlueNode F → Finset (GlueVertex F η)
  | none => Finset.univ.image (glueRoot F η)
  | some ⟨i, n⟩ => ((F i).tree.bag n).image (glueMap F η i)

lemma glueBag_root_mem (q : GlueRoot F η) :
    Sum.inl q ∈ glueBag F η none := by
  induction q using Quot.inductionOn with
  | h j => exact Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩

lemma glueMap_mem_bag (i : I) (n : (F i).Node) {a : (F i).Vertex}
    (ha : a ∈ (F i).tree.bag n) :
    glueMap F η i a ∈ glueBag F η (glueNodeMap F i n) := by
  by_cases hn : n = (F i).tree.root
  · subst n
    rw [(F i).root_bag] at ha
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp ha
    rw [glueNodeMap_root, glueMap_root]
    exact glueBag_root_mem F η _
  · rw [glueNodeMap_nonroot F i n hn]
    exact Finset.mem_image.mpr ⟨a, ha, rfl⟩

lemma glueBag_internal {i : I} (a : GlueInternal F i) (n : GlueNode F) :
    Sum.inr ⟨i, a⟩ ∈ glueBag F η n ↔
      ∃ b : {n : (F i).Node // n ≠ (F i).tree.root},
        n = some ⟨i, b⟩ ∧ a.1 ∈ (F i).tree.bag b := by
  cases n with
  | none =>
    constructor
    · intro h
      obtain ⟨j, _, he⟩ := Finset.mem_image.mp h
      cases he
    · rintro ⟨b, hb, _⟩
      cases hb
  | some q =>
    rcases q with ⟨j, n⟩
    constructor
    · intro h
      obtain ⟨b, hb, he⟩ := Finset.mem_image.mp h
      obtain ⟨hji, hba⟩ := glueMap_eq_internal F η j i b a he
      subst j
      change b = a.1 at hba
      subst b
      exact ⟨n, rfl, hb⟩
    · rintro ⟨b, hb, ha⟩
      have hji : j = i := congrArg Sigma.fst (Option.some.inj hb)
      subst j
      have hnb : n = b := by
        simpa only [Option.some.injEq, Sigma.mk.inj_iff, heq_eq_eq, true_and] using hb
      subst n
      exact Finset.mem_image.mpr ⟨a.1, ha, glueMap_internal F η i a⟩

lemma glueBag_root_ancestor (q : GlueRoot F η) {n l : GlueNode F}
    (hnl : (glueTree F).Ancestor n l) (hql : Sum.inl q ∈ glueBag F η l) :
    Sum.inl q ∈ glueBag F η n := by
  cases n with
  | none => exact glueBag_root_mem F η q
  | some p =>
    rcases p with ⟨i, n⟩
    obtain ⟨b, rfl, hnb⟩ := glueTree_ancestor_from_some F hnl
    obtain ⟨a, hab, he⟩ := Finset.mem_image.mp hql
    have har := glueMap_eq_inl F η i a q he
    exact Finset.mem_image.mpr ⟨a, rooted_mem_ancestor F i har hnb hab, he⟩

lemma glueBag_internal_same {i : I} (a : GlueInternal F i)
    (n : {n : (F i).Node // n ≠ (F i).tree.root}) :
    Sum.inr ⟨i, a⟩ ∈ glueBag F η (some ⟨i, n⟩) ↔ a.1 ∈ (F i).tree.bag n := by
  rw [glueBag_internal]
  constructor
  · rintro ⟨b, hb, ha⟩
    have hnb : n = b := by
      simpa only [Option.some.injEq, Sigma.mk.inj_iff, heq_eq_eq, true_and] using hb
    rwa [hnb]
  · intro ha
    exact ⟨n, rfl, ha⟩

lemma internal_top_nonroot (i : I) (a : GlueInternal F i) :
    (F i).tree.top a.1 ≠ (F i).tree.root := by
  intro he
  have ha := (F i).tree.top_mem a.1
  rw [he, (F i).root_bag] at ha
  exact a.2 (by simpa only [Finset.mem_image, Finset.mem_univ, true_and] using ha)

noncomputable def glueTop : GlueVertex F η → GlueNode F
  | .inl _ => none
  | .inr ⟨i, a⟩ => glueNodeMap F i ((F i).tree.top a)

lemma glueTop_mem (a : GlueVertex F η) : a ∈ glueBag F η (glueTop F η a) := by
  cases a with
  | inl q => exact glueBag_root_mem F η q
  | inr p =>
    rcases p with ⟨i, a⟩
    change Sum.inr ⟨i, a⟩ ∈ glueBag F η (glueNodeMap F i ((F i).tree.top a))
    rw [← glueMap_internal F η i a]
    exact glueMap_mem_bag F η i _ ((F i).tree.top_mem a)

lemma glueTop_ancestor (a : GlueVertex F η) (n : GlueNode F)
    (ha : a ∈ glueBag F η n) : (glueTree F).Ancestor (glueTop F η a) n := by
  cases a with
  | inl q => exact (glueTree F).root_ancestor n
  | inr p =>
    rcases p with ⟨i, a⟩
    obtain ⟨b, rfl, hab⟩ := (glueBag_internal F η a n).mp ha
    have hh := glueTree_map_ancestor F i ((F i).tree.top_ancestor a.1 b.1 hab)
    rwa [glueNodeMap_nonroot F i b.1 b.2] at hh

lemma glueInterval_mem (a : GlueVertex F η) (n l : GlueNode F)
    (hn : (glueTree F).Ancestor (glueTop F η a) n)
    (hnl : (glueTree F).Ancestor n l) (ha : a ∈ glueBag F η l) :
    a ∈ glueBag F η n := by
  cases a with
  | inl q => exact glueBag_root_ancestor F η q hnl ha
  | inr p =>
    rcases p with ⟨i, a⟩
    change (glueTree F).Ancestor (glueNodeMap F i ((F i).tree.top a.1)) n at hn
    rw [glueNodeMap_nonroot F i _ (internal_top_nonroot F i a)] at hn
    obtain ⟨b, rfl, htb⟩ := glueTree_ancestor_from_some F hn
    obtain ⟨c, rfl, hbc⟩ := glueTree_ancestor_from_some F hnl
    rw [glueBag_internal_same] at ha ⊢
    exact (F i).tree.interval_mem a.1 b.1 c.1 htb hbc ha

lemma glueIntersection_sub (i : I) (n : {n : (F i).Node // n ≠ (F i).tree.root}) :
    glueBag F η (some ⟨i, n⟩) ∩ glueBag F η ((glueTree F).parent (some ⟨i, n⟩)) ⊆
      ((F i).tree.bag n ∩ (F i).tree.bag ((F i).tree.parent n)).image (glueMap F η i) := by
  intro a ha
  obtain ⟨han, hap⟩ := Finset.mem_inter.mp ha
  obtain ⟨b, hbn, rfl⟩ := Finset.mem_image.mp han
  refine Finset.mem_image.mpr ⟨b, Finset.mem_inter.mpr ⟨hbn, ?_⟩, rfl⟩
  by_cases hb : ∃ j, (F i).roots j = b
  · exact rooted_mem_ancestor F i hb (.step n.2 .refl) hbn
  · have he := glueMap_internal F η i ⟨b, hb⟩
    rw [he] at hap
    change Sum.inr ⟨i, (⟨b, hb⟩ : GlueInternal F i)⟩ ∈
      glueBag F η (glueNodeMap F i ((F i).tree.parent n)) at hap
    by_cases hp : (F i).tree.parent n = (F i).tree.root
    · rw [hp, glueNodeMap_root] at hap
      obtain ⟨j, _, hj⟩ := Finset.mem_image.mp hap
      cases hj
    · rw [glueNodeMap_nonroot F i _ hp, glueBag_internal_same] at hap
      exact hap

def glueRelation (a b : GlueVertex F η) : Prop :=
  ∃ i u v, (F i).relation u v ∧ glueMap F η i u = a ∧ glueMap F η i v = b

lemma glueRelation_symm : Std.Symm (glueRelation F η) := by
  refine ⟨?_⟩
  rintro a b ⟨i, u, v, huv, rfl, rfl⟩
  exact ⟨i, v, u, (F i).symmetric.symm u v huv, rfl, rfl⟩

noncomputable def glueBagTree (hm : m ≤ t) :
    RankedBagTree (N := GlueNode F) (glueRelation F η) t where
  toRankedTree := glueTree F
  bag := glueBag F η
  top := glueTop F η
  top_mem := glueTop_mem F η
  top_ancestor := glueTop_ancestor F η
  interval_mem := glueInterval_mem F η
  edge_cover := by
    rintro a b ⟨i, u, v, huv, rfl, rfl⟩
    obtain ⟨n, hun, hvn⟩ := (F i).tree.edge_cover u v huv
    exact ⟨glueNodeMap F i n, glueMap_mem_bag F η i n hun,
      glueMap_mem_bag F η i n hvn⟩
  width := by
    intro n
    cases n with
    | none =>
      exact le_trans (Finset.card_image_le) (by simpa only [Finset.card_univ,
        Fintype.card_fin] using hm)
    | some q => exact le_trans Finset.card_image_le ((F q.1).tree.width q.2)
  intersection := by
    intro n hn
    cases n with
    | none => exact (hn rfl).elim
    | some q =>
      rcases q with ⟨i, n⟩
      exact lt_of_le_of_lt ((Finset.card_le_card (glueIntersection_sub F η i n)).trans
        Finset.card_image_le) ((F i).tree.intersection n.1 n.2)

noncomputable def glueTest [Fintype I] (hm : m ≤ t) : RootedTest m t where
  Vertex := GlueVertex F η
  vertexFintype := inferInstance
  relation := glueRelation F η
  symmetric := glueRelation_symm F η
  roots := glueRoot F η
  Node := GlueNode F
  nodeFintype := inferInstance
  tree := glueBagTree F η hm
  root_bag := rfl

variable {V : Type} (G : SimpleGraph V) (x : Fin m → V)

noncomputable def glueValue (g : (i : I) → (F i).Maps G (x ∘ η i)) :
    GlueVertex F η → V
  | .inl q => Quot.lift x (by
      rintro a b ⟨i, j, l, rfl, rfl, hjl⟩
      exact (g i).2 j |>.symm.trans (by
        rw [hjl]
        exact (g i).2 l)) q
  | .inr ⟨i, a⟩ => (g i).1.1 a

lemma glueValue_root (g : (i : I) → (F i).Maps G (x ∘ η i)) (j : Fin m) :
    glueValue F η G x g (glueRoot F η j) = x j := rfl

lemma glueValue_map (g : (i : I) → (F i).Maps G (x ∘ η i))
    (i : I) (a : (F i).Vertex) : glueValue F η G x g (glueMap F η i a) = (g i).1.1 a := by
  by_cases ha : ∃ j, (F i).roots j = a
  · obtain ⟨j, rfl⟩ := ha
    rw [glueMap_root, glueValue_root]
    exact ((g i).2 j).symm
  · rw [glueMap_internal F η i ⟨a, ha⟩]
    rfl

noncomputable def glueMapsEquiv [Fintype I] (hm : m ≤ t) :
    (glueTest F η hm).Maps G x ≃ ((i : I) → (F i).Maps G (x ∘ η i)) where
  toFun f i :=
    ⟨⟨fun a => f.1.1 (glueMap F η i a), fun a b hab =>
      f.1.2 _ _ ⟨i, a, b, hab, rfl, rfl⟩⟩,
      fun j => by
        change f.1.1 (glueMap F η i ((F i).roots j)) = x (η i j)
        rw [glueMap_root]
        exact f.2 (η i j)⟩
  invFun g :=
    ⟨⟨glueValue F η G x g, by
        rintro a b ⟨i, u, v, huv, rfl, rfl⟩
        rw [glueValue_map, glueValue_map]
        exact (g i).1.2 u v huv⟩,
      glueValue_root F η G x g⟩
  left_inv f := by
    apply Subtype.ext
    apply Subtype.ext
    funext a
    cases a with
    | inl q =>
      induction q using Quot.inductionOn with
      | h j => exact (f.2 j).symm
    | inr p =>
      rcases p with ⟨i, a⟩
      change f.1.1 (glueMap F η i a.1) = f.1.1 (.inr ⟨i, a⟩)
      rw [glueMap_internal]
  right_inv g := by
    funext i
    apply Subtype.ext
    apply Subtype.ext
    funext a
    exact glueValue_map F η G x g i a

lemma glueTest_count [Fintype I] [Fintype V] (hm : m ≤ t) :
    (glueTest F η hm).count G x = ∏ i : I, (F i).count G (x ∘ η i) := by
  unfold RootedTest.count
  rw [Fintype.card_congr (glueMapsEquiv F η G x hm), Fintype.card_pi, Nat.cast_prod]

