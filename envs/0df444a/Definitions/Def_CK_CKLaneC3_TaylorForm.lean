  have h0 : ∀ u ∈ Icc (0 : ℝ) 1, HasDerivAt (fun u : ℝ => j.d1 (ys + u * (y - ys)) * (y - ys) ^ 0)
      (j.d2 (ys + u * (y - ys)) * (y - ys) ^ (0 + 1)) u := by
    intro u hu
