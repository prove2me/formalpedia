/-- Rule-match count transferred from the face of `x` to that of `edge x`. -/
def transferCount {n : ℕ} (H : Hypermap n) (x : Fin n) : ℕ :=
  rules.countP (fun p ↦ p.matchBool H (H.face.symm (H.face.symm x)))

def transfer {n : ℕ} (H : Hypermap n) (x : Fin n) : ℚ :=
  transferCount H x

noncomputable def score {n : ℕ} (H : Hypermap n) (x : Fin n) : ℚ :=
  H.faceCharge (transfer H) x
