  change ν[clientNoise A r k i | A.history (roundTime K r + k)] ω = 0
  change ν[clientNoise A r k i | A.history (roundTime K r + k)] ω =
    ν[A.g r k i | A.history (roundTime K r + k)] ω -
    ν[clientGradient A r k i | A.history (roundTime K r + k)] ω at hs
  rw [hs, hm, hu]
  exact sub_self _

lemma Run.meanControl_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ} (hr : r ≤ T) :
    MemLp (meanControl A r) 2 ν :=
  (memLp_finsetSum Finset.univ (fun i _ ↦ A.c_memLp r hr i)).const_smul (N : ℝ)⁻¹

lemma Run.meanControl_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) : StronglyMeasurable[A.history (roundTime K r)] (meanControl A r) :=
  (Finset.stronglyMeasurable_fun_sum Finset.univ
    (fun i _ ↦ A.c_adapted r hr i)).const_smul (N : ℝ)⁻¹

lemma Run.averageOracle_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) : MemLp (averageOracle A r i) 2 ν :=
  (memLp_finsetSum (Finset.range K)
    (fun k hk ↦ A.g_memLp r hr k (Finset.mem_range.mp hk) i)).const_smul (K : ℝ)⁻¹

lemma Run.averageOracle_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r + K)] (averageOracle A r i) := by
  change StronglyMeasurable[A.history (roundTime K r + K)]
    ((K : ℝ)⁻¹ • fun ω ↦ ∑ k ∈ Finset.range K, A.g r k i ω)
  apply StronglyMeasurable.const_smul
  apply Finset.stronglyMeasurable_fun_sum
  intro k hk
  exact (A.g_adapted r hr k (Finset.mem_range.mp hk) i).mono
    (A.history.mono (Nat.add_le_add_left (Nat.succ_le_of_lt (Finset.mem_range.mp hk)) _))

lemma Run.expectedGap_nonneg (A : Run P ν S K T ηl ηg init) {xstar : Space d}
    (hx : IsMinimizer P xstar) (r : ℕ) : 0 ≤ expectedGap A xstar r :=
  integral_nonneg (fun ω ↦ sub_nonneg.mpr (hx (A.x r ω)))

lemma Run.gap_integrable (A : Run P ν S K T ηl ηg init) (xstar : Space d)
    {r : ℕ} (hr : r ≤ T) :
    Integrable (fun ω ↦ objective P.f (A.x r ω) - objective P.f xstar) ν :=
  (P.objective_integrable_comp (A.x_memLp r hr)).sub (integrable_const _)

lemma Run.noise_second_moment_le (A : Run P ν S K T ηl ηg init) {r k : ℕ}
    (hr : r < T) (hk : k < K) (i : Fin N) :
    ∫ ω, ‖clientNoise A r k i ω‖ ^ 2 ∂ν ≤ P.σ ^ 2 := by
  have h := integral_mono_ae integrable_condExp (integrable_const (P.σ ^ 2))
    (A.variance r hr k hk i)
  rw [integral_condExp (A.history.le _), integral_const] at h
  simpa [clientNoise, clientGradient] using h

lemma Run.sample_eq_measurableSet (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (s : Finset (Fin N)) :
    MeasurableSet[A.history (roundTime K (r + 1))] {ω | A.sample r ω = s} := by
  have h := (A.sample_adapted r hr s).measurable (measurableSet_singleton (1 : ℝ))
  convert h using 1
  ext ω
  by_cases hs : A.sample r ω = s <;> simp [hs]

lemma Run.sample_mem_measurableSet (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    MeasurableSet[A.history (roundTime K (r + 1))] {ω | i ∈ A.sample r ω} := by
  have heq : {ω | i ∈ A.sample r ω} =
      ⋃ s : Finset (Fin N), ⋃ (_ : i ∈ s), {ω | A.sample r ω = s} := by
    ext ω
    simp
  rw [heq]
  exact MeasurableSet.iUnion (fun s ↦ MeasurableSet.iUnion
    (fun _ ↦ A.sample_eq_measurableSet hr s))

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule3
/- END Definitions.SCAFFOLD.RunMoments -/

/- BEGIN Definitions.SCAFFOLD.StoredControls -/
section SCAFFOLDBundleModule4
/-!
Source-derived decomposition of stored option II controls into true-gradient
averages and retained oracle errors. Source: SCAFFOLD Appendix E, PDF pp. 25-28,
equations (18)-(24) and Lemmas 12-13. The decomposition makes the noise
conditioning precise without assuming an unconditional variance bound on c_i.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def averageSignal (A : Run P ν S K T ηl ηg init) (r : ℕ) (i : Fin N)
    (ω : Ω) : Space d :=
  (K : ℝ)⁻¹ • ∑ k ∈ Finset.range K, clientGradient A r k i ω

def storedSignal (A : Run P ν S K T ηl ηg init) : ℕ → Fin N → Ω → Space d
  | 0, i, _ => match init with
    | some c0 => c0 i
    | none => gradient (P.f i) P.x0
  | r + 1, i, ω => if i ∈ A.sample r ω then averageSignal A r i ω
      else storedSignal A r i ω

def storedError (A : Run P ν S K T ηl ηg init) (r : ℕ) (i : Fin N)
    (ω : Ω) : Space d := A.c r i ω - storedSignal A r i ω

/-- Query points retained together with each option II control, as in (26)-(27). -/
def storedQuery (A : Run P ν S K T ηl ηg init) : ℕ → ℕ → Fin N → Ω → Space d
  | 0, _, _, _ => P.x0
  | r + 1, k, i, ω => if i ∈ A.sample r ω then A.y r k i ω
      else storedQuery A r k i ω

def controlEnergy (A : Run P ν S K T ηl ηg init) (xstar : Space d) (r : ℕ) : ℝ :=
  (N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖storedSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν

def lagEnergy (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  ((N : ℝ) * (K : ℝ))⁻¹ * ∑ i, ∑ k ∈ Finset.range K,
    ∫ ω, ‖storedQuery A r k i ω - A.x r ω‖ ^ 2 ∂ν

theorem Problem.gradient_lipschitz (P : Problem d N) (i : Fin N) :
    LipschitzWith ⟨P.β, P.smoothness_pos.le⟩ (gradient (P.f i)) :=
  lipschitzWith_iff_norm_sub_le.mpr (P.smooth i)

theorem Run.averageSignal_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) : MemLp (averageSignal A r i) 2 ν :=
  (memLp_finsetSum (Finset.range K)
    (fun k hk ↦ A.gradient_memLp hr (Finset.mem_range.mp hk) i)).const_smul (K : ℝ)⁻¹

theorem Run.averageSignal_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r + K)] (averageSignal A r i) := by
  change StronglyMeasurable[A.history (roundTime K r + K)]
    ((K : ℝ)⁻¹ • fun ω ↦ ∑ k ∈ Finset.range K, clientGradient A r k i ω)
  apply StronglyMeasurable.const_smul
  apply Finset.stronglyMeasurable_fun_sum
  intro k hk
  exact (P.gradient_lipschitz i).continuous.comp_stronglyMeasurable
    ((A.y_adapted r hr k (Finset.mem_range.mp hk).le i).mono
      (A.history.mono (Nat.add_le_add_left (Finset.mem_range.mp hk).le _)))

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
private lemma memLp_ite {p : Ω → Prop} [DecidablePred p] {f g : Ω → Space d}
    (hp : MeasurableSet {ω | p ω}) (hf : MemLp f 2 ν) (hg : MemLp g 2 ν) :
    MemLp (fun ω ↦ if p ω then f ω else g ω) 2 ν := by
  convert (MemLp.indicator hp hf).add (MemLp.indicator hp.compl hg) using 1
  ext ω
  by_cases h : p ω <;> simp [Set.indicator, h]

theorem Run.storedSignal_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) : MemLp (storedSignal A r i) 2 ν := by
  induction r with
  | zero =>
    cases init <;> exact memLp_const _
  | succ r ih =>
    exact memLp_ite ((A.history.le _) _
      (A.sample_mem_measurableSet (Nat.lt_of_succ_le hr) i))
      (A.averageSignal_memLp (Nat.lt_of_succ_le hr) i)
      (ih (Nat.le_of_succ_le hr))

theorem Run.storedError_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) : MemLp (storedError A r i) 2 ν :=
  (A.c_memLp r hr i).sub (A.storedSignal_memLp hr i)

theorem Run.storedSignal_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r)] (storedSignal A r i) := by
  induction r with
  | zero => cases init <;> exact stronglyMeasurable_const
  | succ r ih =>
    have htime : roundTime K r + K ≤ roundTime K (r + 1) := by
      simp only [roundTime, Nat.add_mul, Nat.one_mul]
      omega
    have hold : roundTime K r ≤ roundTime K (r + 1) :=
      (Nat.le_add_right _ _).trans htime
    exact StronglyMeasurable.ite (A.sample_mem_measurableSet (Nat.lt_of_succ_le hr) i)
      ((A.averageSignal_adapted (Nat.lt_of_succ_le hr) i).mono (A.history.mono htime))
      ((ih (Nat.le_of_succ_le hr)).mono (A.history.mono hold))

theorem Run.storedError_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r)] (storedError A r i) :=
  (A.c_adapted r hr i).sub (A.storedSignal_adapted hr i)

theorem Run.storedError_update (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    storedError A (r + 1) i =ᵐ[ν] fun ω ↦ if i ∈ A.sample r ω then
      averageOracle A r i ω - averageSignal A r i ω else storedError A r i ω := by
  filter_upwards [A.control_update r hr i] with ω hω
  dsimp [storedError, storedSignal]
  rw [hω]
  by_cases h : i ∈ A.sample r ω <;> simp [h, averageOracle]

theorem Run.storedError_initial_deterministic {c0 : Fin N → Space d}
    (A : Run P ν S K T ηl ηg (some c0)) (i : Fin N) :
    storedError A 0 i =ᵐ[ν] 0 := by
  filter_upwards [A.initial_c i] with ω hω
  simp only [storedError, storedSignal, hω, sub_self, Pi.zero_apply]

theorem Run.averageOracle_sub_averageSignal (A : Run P ν S K T ηl ηg init)
    (r : ℕ) (i : Fin N) (ω : Ω) :
    averageOracle A r i ω - averageSignal A r i ω =
      (K : ℝ)⁻¹ • ∑ k ∈ Finset.range K, clientNoise A r k i ω := by
  simp only [averageOracle, averageSignal, clientNoise, Finset.sum_sub_distrib, smul_sub]

theorem Run.storedQuery_memLp (A : Run P ν S K T ηl ηg init) {r k : ℕ}
    (hr : r ≤ T) (hk : k ≤ K) (i : Fin N) : MemLp (storedQuery A r k i) 2 ν := by
  induction r with
  | zero => exact memLp_const _
  | succ r ih =>
    exact memLp_ite ((A.history.le _) _
      (A.sample_mem_measurableSet (Nat.lt_of_succ_le hr) i))
      (A.y_memLp r (Nat.lt_of_succ_le hr) k hk i) (ih (Nat.le_of_succ_le hr))

theorem Run.storedQuery_adapted (A : Run P ν S K T ηl ηg init) {r k : ℕ}
    (hr : r ≤ T) (hk : k ≤ K) (i : Fin N) :
    StronglyMeasurable[A.history (roundTime K r)] (storedQuery A r k i) := by
  induction r with
  | zero => exact stronglyMeasurable_const
  | succ r ih =>
    have htime : roundTime K r + k ≤ roundTime K (r + 1) := by
      simp only [roundTime, Nat.add_mul, Nat.one_mul]
      omega
    have hold : roundTime K r ≤ roundTime K (r + 1) :=
      (Nat.le_add_right _ _).trans htime
    exact StronglyMeasurable.ite (A.sample_mem_measurableSet (Nat.lt_of_succ_le hr) i)
      ((A.y_adapted r (Nat.lt_of_succ_le hr) k hk i).mono (A.history.mono htime))
      ((ih (Nat.le_of_succ_le hr)).mono (A.history.mono hold))

theorem Run.storedSignal_eq_queryMean (A : Run P ν S K T ηl ηg none)
    (r : ℕ) (i : Fin N) (ω : Ω) :
    storedSignal A r i ω = (K : ℝ)⁻¹ • ∑ k ∈ Finset.range K,
      gradient (P.f i) (storedQuery A r k i ω) := by
  induction r with
  | zero =>
    have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
    simp [storedSignal, storedQuery, ← Nat.cast_smul_eq_nsmul ℝ, smul_smul, hK]
  | succ r ih =>
    by_cases h : i ∈ A.sample r ω
    · simp [storedSignal, storedQuery, h, averageSignal, clientGradient]
    · simpa only [storedSignal, storedQuery, h, if_false] using ih

theorem controlEnergy_nonneg (A : Run P ν S K T ηl ηg init)
    (xstar : Space d) (r : ℕ) : 0 ≤ controlEnergy A xstar r := by
  exact mul_nonneg (by positivity) (Finset.sum_nonneg
    (fun i _ ↦ integral_nonneg (fun _ ↦ sq_nonneg _)))

theorem lagEnergy_nonneg (A : Run P ν S K T ηl ηg init) (r : ℕ) :
    0 ≤ lagEnergy A r := by
  exact mul_nonneg (by positivity) (Finset.sum_nonneg (fun i _ ↦
    Finset.sum_nonneg (fun k _ ↦ integral_nonneg (fun _ ↦ sq_nonneg _))))

theorem Run.controlEnergy_initial {c0 : Fin N → Space d}
    (A : Run P ν S K T ηl ηg (some c0)) (xstar : Space d) :
    controlEnergy A xstar 0 = initialControlError P c0 xstar := by
  simp [controlEnergy, storedSignal, initialControlError]

theorem Run.lagEnergy_initial (A : Run P ν S K T ηl ηg init) : lagEnergy A 0 = 0 := by
  have heq (i : Fin N) (k : ℕ) :
      (fun ω ↦ ‖storedQuery A 0 k i ω - A.x 0 ω‖ ^ 2) =ᵐ[ν] 0 := by
    filter_upwards [A.initial_x] with ω hω
    simp [storedQuery, hω]
  simp only [lagEnergy, integral_congr_ae (heq _ _), Pi.zero_apply, integral_zero,
    Finset.sum_const_zero, mul_zero]

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule4
/- END Definitions.SCAFFOLD.StoredControls -/

/- BEGIN Definitions.SCAFFOLD.SmoothAnalysis -/
section SCAFFOLDBundleModule5
/-! Reusable smooth-analysis proofs extracted from the accepted GradientGrowth solution.
SCAFFOLD, Appendix B.1, PDF p. 14, equations (7)-(9). -/

noncomputable section
open scoped BigOperators InnerProductSpace
open Set
namespace SCAFFOLD

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

theorem gradient_line_deriv {f : E → ℝ}
    (hf : ∀ x, HasGradientAt f (gradient f x) x) (x y : E) (t : ℝ) :
    HasDerivAt (f ∘ AffineMap.lineMap x y)
      ⟪gradient f (AffineMap.lineMap x y t), y - x⟫_ℝ t := by
  exact (hf _).hasFDerivAt.comp_hasDerivAt t AffineMap.hasDerivAt_lineMap

theorem smooth_descent {f : E → ℝ} {L : ℝ}
    (hf : ∀ x, HasGradientAt f (gradient f x) x)
    (hs : ∀ x y, ‖gradient f x - gradient f y‖ ≤ L * ‖x - y‖)
    (x y : E) :
    f y ≤ f x + ⟪gradient f x, y - x⟫_ℝ + L / 2 * ‖y - x‖ ^ 2 := by
  let a := ⟪gradient f x, y - x⟫_ℝ
  let b := L / 2 * ‖y - x‖ ^ 2
  let B : ℝ → ℝ := fun t ↦ f x + t * a + t ^ 2 * b
  have hBder (t : ℝ) : HasDerivAt B (a + 2 * t * b) t := by
    convert (((hasDerivAt_id t).mul_const a).const_add (f x)).add
      (((hasDerivAt_id t).pow 2).mul_const b) using 1
    simp
  have hbound (t : ℝ) (ht : t ∈ Ico (0 : ℝ) 1) :
      ⟪gradient f (AffineMap.lineMap x y t), y - x⟫_ℝ ≤ a + 2 * t * b := by
    have hn : ‖AffineMap.lineMap x y t - x‖ = t * ‖y - x‖ := by
      simp [AffineMap.lineMap_apply_module', norm_smul, abs_of_nonneg ht.1]
    have hgrad := mul_le_mul_of_nonneg_right (hs (AffineMap.lineMap x y t) x)
      (norm_nonneg (y - x))
    have hi := real_inner_le_norm (gradient f (AffineMap.lineMap x y t) - gradient f x)
      (y - x)
    rw [hn] at hgrad
    rw [inner_sub_left] at hi
    dsimp [a, b]
    nlinarith
  have hfinal := image_le_of_deriv_right_le_deriv_boundary
    (f := f ∘ AffineMap.lineMap x y)
    (f' := fun t ↦ ⟪gradient f (AffineMap.lineMap x y t), y - x⟫_ℝ)
    (a := 0) (b := 1)
    (by exact (continuous_iff_continuousAt.mpr fun t ↦
      (gradient_line_deriv hf x y t).continuousAt).continuousOn)
    (fun t _ ↦ (gradient_line_deriv hf x y t).hasDerivWithinAt)
    (B := B) (B' := fun t ↦ a + 2 * t * b)
    (by simp [B])
    (by exact (continuous_iff_continuousAt.mpr fun t ↦ (hBder t).continuousAt).continuousOn)
    (fun t _ ↦ (hBder t).hasDerivWithinAt) hbound
    (x := 1) (by simp)
  simpa [B, a, b] using hfinal

theorem smooth_convex_gap {f : E → ℝ} {L : ℝ}
    (hf : ∀ x, HasGradientAt f (gradient f x) x)
    (hc : ∀ x y, f x + ⟪gradient f x, y - x⟫_ℝ ≤ f y) (hL : 0 < L)
    (hs : ∀ x y, ‖gradient f x - gradient f y‖ ≤ L * ‖x - y‖)
    (x y : E) :
    ‖gradient f x - gradient f y‖ ^ 2 ≤
      2 * L * (f x - f y - ⟪gradient f y, x - y⟫_ℝ) := by
  let v := gradient f x - gradient f y
  let z := x - L⁻¹ • v
  have hzx : z - x = -(L⁻¹ • v) := by dsimp [z]; abel
  have hzy : z - y = (x - y) - L⁻¹ • v := by dsimp [z]; abel
  have hdes := smooth_descent hf hs x z
  have hlo := hc y z
  rw [hzx, inner_neg_right, inner_smul_right, norm_neg, norm_smul, Real.norm_eq_abs,
    abs_of_pos (inv_pos.mpr hL)] at hdes
  rw [hzy, inner_sub_right, inner_smul_right] at hlo
  have hv : ⟪gradient f x, v⟫_ℝ - ⟪gradient f y, v⟫_ℝ = ‖v‖ ^ 2 := by
    rw [← inner_sub_left]
    exact real_inner_self_eq_norm_sq v
  have heq : -(L⁻¹ * ⟪gradient f x, v⟫_ℝ) + L / 2 * (L⁻¹ * ‖v‖) ^ 2 +
      L⁻¹ * ⟪gradient f y, v⟫_ℝ = -(‖v‖ ^ 2 / (2 * L)) := by
    field_simp
    nlinarith [hv]
  have hgap : ‖v‖ ^ 2 / (2 * L) ≤ f x - f y - ⟪gradient f y, x - y⟫_ℝ := by
    linarith
  have hh := (div_le_iff₀ (by positivity : 0 < 2 * L)).mp hgap
  simpa only [mul_comm] using hh

theorem objective_hasGradient {d N : ℕ} (P : Problem d N) (x : Space d) :
    HasGradientAt (objective P.f) ((N : ℝ)⁻¹ • ∑ i, gradient (P.f i) x) x := by
  rw [hasGradientAt_iff_hasFDerivAt]
  simpa only [objective, map_smul, map_sum] using
    (HasFDerivAt.fun_sum (u := Finset.univ) (fun i _ ↦
      (P.hasGradient i x).hasFDerivAt)).const_mul (N : ℝ)⁻¹


theorem Problem.gradient_objective {d N : ℕ} (P : Problem d N) (x : Space d) :
    gradient (objective P.f) x = (N : ℝ)⁻¹ • ∑ i, gradient (P.f i) x :=
  (objective_hasGradient P x).gradient

theorem Problem.smooth_objective {d N : ℕ} (P : Problem d N) (x y : Space d) :
    ‖gradient (objective P.f) x - gradient (objective P.f) y‖ ≤ P.β * ‖x - y‖ := by
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
  rw [P.gradient_objective, P.gradient_objective, ← smul_sub, ← Finset.sum_sub_distrib]
  calc
    ‖(N : ℝ)⁻¹ • ∑ i, (gradient (P.f i) x - gradient (P.f i) y)‖
        = (N : ℝ)⁻¹ * ‖∑ i, (gradient (P.f i) x - gradient (P.f i) y)‖ := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    _ ≤ (N : ℝ)⁻¹ * ∑ i, ‖gradient (P.f i) x - gradient (P.f i) y‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (N : ℝ)⁻¹ * ∑ _i : Fin N, P.β * ‖x - y‖ :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun i _ ↦ P.smooth i x y))
        (by positivity)
    _ = P.β * ‖x - y‖ := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      field_simp

theorem Problem.objective_descent {d N : ℕ} (P : Problem d N) (x y : Space d) :
    objective P.f y ≤ objective P.f x +
      inner ℝ (gradient (objective P.f) x) (y - x) + P.β / 2 * ‖y - x‖ ^ 2 := by
  exact smooth_descent (fun z ↦ (objective_hasGradient P z).gradient ▸
    objective_hasGradient P z) P.smooth_objective x y

open MeasureTheory in
theorem Problem.gradient_memLp_comp {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    {ν : Measure Ω} [IsProbabilityMeasure ν] (P : Problem d N) (i : Fin N)
    {X : Ω → Space d} (hX : MemLp X 2 ν) :
    MemLp (fun ω ↦ gradient (P.f i) (X ω)) 2 ν := by
  have hLip : LipschitzWith ⟨P.β, P.smoothness_pos.le⟩ (gradient (P.f i)) :=
    lipschitzWith_iff_norm_sub_le.mpr (P.smooth i)
  have hb : MemLp (fun ω ↦ P.β * ‖X ω‖ + ‖gradient (P.f i) 0‖) 2 ν :=
    (hX.norm.const_mul P.β).add (memLp_const _)
  exact hb.mono' (hLip.continuous.comp_aestronglyMeasurable hX.aestronglyMeasurable)
    (Filter.Eventually.of_forall (fun ω ↦ P.norm_gradient_le i (X ω)))

open MeasureTheory in
theorem Problem.objectiveGradient_memLp_comp {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    {ν : Measure Ω} [IsProbabilityMeasure ν] (P : Problem d N)
    {X : Ω → Space d} (hX : MemLp X 2 ν) :
    MemLp (fun ω ↦ gradient (objective P.f) (X ω)) 2 ν := by
  simp only [P.gradient_objective]
  exact (memLp_finsetSum Finset.univ
    (fun i _ ↦ P.gradient_memLp_comp i hX)).const_smul (N : ℝ)⁻¹

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule5
