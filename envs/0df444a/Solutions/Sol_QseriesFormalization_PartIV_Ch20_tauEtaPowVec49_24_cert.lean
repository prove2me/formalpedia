/-! #### Certified fast evaluation of the coefficients of `η²⁴` up to `q⁴⁹`

`tauEtaPowVec 49 24` performs 24 truncated convolutions over `Vector`/`Fin` sums, which the
kernel evaluates slowly. Below, the same coefficients are computed by repeated squaring on plain
integer lists (`η² , η⁴, η⁸, η¹⁶`, then `η¹⁶ · η⁸`), five truncated products in all. Each list
product is proved to compute the coefficients of the power-series product
(`tauListMul_getD`), so the list for `η²⁴` equals the coefficients of `(etaPS ℤ)^24`; the vector
side equals them by `tauEtaPowVec_spec`. Only the final 50-entry comparison of the fast list with
the stated table is a kernel computation. -/

theorem tauListDot_eq_sum (xs ys : List Int) :
    tauListDot xs ys = ∑ i ∈ Finset.range ys.length, xs.getD i 0 * ys.getD i 0 := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp [tauListDot]
  | cons x xs ih =>
      cases ys with
      | nil => simp [tauListDot]
      | cons y ys =>
          rw [tauListDot, ih, List.length_cons, Finset.sum_range_succ']
          simp [add_comm]

theorem tauList_getD_reverse_take (b : List Int) {j i : Nat} (hb : j < b.length) (hi : i ≤ j) :
    (b.take (j + 1)).reverse.getD i 0 = b.getD (j - i) 0 := by
  have hlen : (b.take (j + 1)).length = j + 1 := by simp; omega
  rw [List.getD_eq_getElem?_getD, List.getElem?_reverse (by omega), hlen,
    List.getD_eq_getElem?_getD]
  rw [show j + 1 - 1 - i = j - i by omega, List.getElem?_take_of_lt (by omega)]

theorem tauList_getD_map_range (F : ℕ → ℤ) {n j : ℕ} (h : j < n) :
    ((List.range n).map F).getD j 0 = F j := by
  simp [List.getD_eq_getElem?_getD, h]

theorem tauListMul_length (N : Nat) (a b : List Int) : (tauListMul N a b).length = N + 1 := by
  simp [tauListMul]

/-- The truncated list product computes the coefficients `0..N` of the power-series product,
whenever the inputs do and the second input has exactly `N + 1` entries. -/
theorem tauListMul_getD {N : Nat} {a b : List Int} {f g : ℤ⟦X⟧}
    (ha : ∀ i ≤ N, a.getD i 0 = f.coeff i) (hb : ∀ i ≤ N, b.getD i 0 = g.coeff i)
    (hblen : b.length = N + 1) :
    ∀ j ≤ N, (tauListMul N a b).getD j 0 = (f * g).coeff j := by
  intro j hj
  unfold tauListMul
  have hlen : (b.take (j + 1)).reverse.length = j + 1 := by simp; omega
  rw [tauList_getD_map_range _ (by omega), tauListDot_eq_sum, hlen, PowerSeries.coeff_mul,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun a b => f.coeff a * g.coeff b) j]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  rw [tauList_getD_reverse_take b (by omega) (by omega), ha i (by omega), hb (j - i) (by omega)]

theorem tauListMul_pow_getD {N m n : Nat} {a b : List Int}
    (ha : ∀ i ≤ N, a.getD i 0 = ((etaPS ℤ) ^ m).coeff i)
    (hb : ∀ i ≤ N, b.getD i 0 = ((etaPS ℤ) ^ n).coeff i) (hblen : b.length = N + 1) :
    ∀ j ≤ N, (tauListMul N a b).getD j 0 = ((etaPS ℤ) ^ (m + n)).coeff j := by
  rw [pow_add]
  exact tauListMul_getD ha hb hblen

theorem tauEtaList_getD (N : Nat) :
    ∀ i ≤ N, (tauEtaList N).getD i 0 = ((etaPS ℤ) ^ 1).coeff i := by
  intro i hi
  rw [tauEtaList, tauList_getD_map_range _ (by omega), pow_one, coeff_etaPS_eq_tauEtaCoeffZ,
    Int.cast_id]

/-- The fast list computes the coefficients `0..N` of `(q;q)_∞^24`. -/
theorem tauEta24List_getD (N : Nat) :
    ∀ j ≤ N, (tauEta24List N).getD j 0 = ((etaPS ℤ) ^ 24).coeff j := by
  have l1 : (tauEtaList N).length = N + 1 := by simp [tauEtaList]
  have h1 := tauEtaList_getD N
  have h2 := tauListMul_pow_getD h1 h1 l1
  have h4 := tauListMul_pow_getD h2 h2 (tauListMul_length _ _ _)
  have h8 := tauListMul_pow_getD h4 h4 (tauListMul_length _ _ _)
  have h16 := tauListMul_pow_getD h8 h8 (tauListMul_length _ _ _)
  exact tauListMul_pow_getD h16 h8 (tauListMul_length _ _ _)

/-- The only kernel computation: five truncated list products of length 50 against the table. -/
theorem tauEta24List_49_eq : tauEta24List 49 = tauEtaPowVec49_24_coeffs := by
  decide +kernel

