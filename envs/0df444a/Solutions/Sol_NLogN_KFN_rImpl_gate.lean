section Scales

theorem NoTS.tail {a : KFG.Atom} {as : List KFG.Atom} (h : NoTS (a :: as)) : NoTS as :=
  fun b hb c hc => h b (List.mem_cons_of_mem _ hb) c (List.mem_cons_of_mem _ hc)

/-- Sources keep their scales. -/
theorem sc_src {a : KFG.Atom} {as : List KFG.Atom} (h : NoTS (a :: as)) (e : ℕ → ℕ) {b : KFG.Atom}
    (hb : b ∈ as) : a.sc e b.s = e b.s := by
  simp only [KFG.Atom.sc]
  rw [Function.update_of_ne (Ne.symm (h a List.mem_cons_self b (List.mem_cons_of_mem _ hb)))]

theorem gateE_ge : ∀ (as : List KFG.Atom) (e : ℕ → ℕ) (t : ℕ), e t ≤ gateE as e t
  | [], _, _ => le_rfl
  | a :: as, e, t => by
    refine le_trans ?_ (gateE_ge as (a.sc e) t)
    simp only [KFG.Atom.sc, Function.update_apply, KFG.Atom.E]
    split_ifs with h
    · subst h; exact le_max_left _ _
    · exact le_rfl

/-- Scales stay in `[G, G + 1]`. -/
theorem gateE_bnd (G : ℕ) : ∀ (as : List KFG.Atom) (e : ℕ → ℕ), NoTS as →
    (∀ a ∈ as, e a.s + a.h ≤ G + 1) → (∀ t, G ≤ e t ∧ e t ≤ G + 1) →
    ∀ t, G ≤ gateE as e t ∧ gateE as e t ≤ G + 1
  | [], _, _, _, he => he
  | a :: as, e, hts, hs, he => by
    refine gateE_bnd G as (a.sc e) (NoTS.tail hts) (fun b hb => ?_) (fun t => ?_)
    · rw [sc_src hts e hb]; exact hs b (List.mem_cons_of_mem _ hb)
    · simp only [KFG.Atom.sc, Function.update_apply, KFG.Atom.E]
      split_ifs with h
      · have := hs a List.mem_cons_self; have := he a.t
        constructor <;> omega
      · exact he t

theorem gateE_top (G : ℕ) : ∀ (as : List KFG.Atom) (e : ℕ → ℕ), NoTS as →
    (∀ a ∈ as, e a.s + a.h ≤ G + 1) → (∀ t, G ≤ e t ∧ e t ≤ G + 1) →
    ∀ a0 ∈ as, e a0.s + a0.h = G + 1 → gateE as e a0.t = G + 1
  | [], _, _, _, _, a0, ha0, _ => by simp at ha0
  | a :: as, e, hts, hs, he, a0, ha0, h1 => by
    have hs' : ∀ b ∈ as, a.sc e b.s + b.h ≤ G + 1 := fun b hb => by
      rw [sc_src hts e hb]; exact hs b (List.mem_cons_of_mem _ hb)
    have he' : ∀ t, G ≤ a.sc e t ∧ a.sc e t ≤ G + 1 := by
      intro t
      simp only [KFG.Atom.sc, Function.update_apply, KFG.Atom.E]
      split_ifs with h
      · have := hs a List.mem_cons_self; have := he a.t
        constructor <;> omega
      · exact he t
    have hb := gateE_bnd G as (a.sc e) (NoTS.tail hts) hs' he'
    rcases List.mem_cons.1 ha0 with rfl | ha0
    · refine le_antisymm (hb _).2 (le_trans ?_ (gateE_ge as _ _))
      simp only [KFG.Atom.sc, Function.update_self, KFG.Atom.E]
      omega
    · exact gateE_top G as (a.sc e) (NoTS.tail hts) hs' he' a0 ha0 (by rw [sc_src hts e ha0]; exact h1)

theorem gateE_zero (G : ℕ) : ∀ (as : List KFG.Atom) (e : ℕ → ℕ), (∀ a ∈ as, a.h = 0) →
