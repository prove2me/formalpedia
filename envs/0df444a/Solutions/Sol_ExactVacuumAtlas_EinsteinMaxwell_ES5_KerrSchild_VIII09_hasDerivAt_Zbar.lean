theorem solution {x : ℝ} (hx : x ∈ UG) : HasDerivAt Zbar (ZbarD x) x := by
  have hG := hasDerivAt_Gc hx
  have hGd := hasDerivAt_GcD hx
  have hH := hasDerivAt_Hc hx
  have hHd := hasDerivAt_HcD hx
  have hlin : HasDerivAt (fun y : ℝ => 4 + 3 * y) (3:ℝ) x := by
    have hh := (hasDerivAt_const (x := x) (4:ℝ)).add ((hasDerivAt_id x).const_mul 3)
    convert hh using 1 <;> first
      | rfl | (funext y; simp [Pi.add_apply, Pi.mul_apply, id]) | ring
  have hquad : HasDerivAt (fun y : ℝ => 3 * y ^ 2 / 16) (3 * (2 * x) / 16) x := by
    have hh := ((hasDerivAt_pow 2 x).const_mul 3).div_const 16
    convert hh using 1 <;> first | rfl | (funext y; simp [Pi.mul_apply]) | norm_num | ring
  have hneg : HasDerivAt (fun y : ℝ => -Gc y / 24) (-GcD x / 24) x := by
    have hh := hG.neg.div_const 24
    convert hh using 1 <;> first | rfl | (funext y; simp [Pi.neg_apply]) | ring
  have hbuild := ((((hneg.add ((hlin.mul hH).div_const 72)).sub_const (1 / 12)).sub
    ((hasDerivAt_id x).div_const 4)).add hquad)
  have hval : (-GcD x / 24 + (3 * Hc x + (4 + 3 * x) * HcD x) / 72 - 1 / 4
      + 3 * (2 * x) / 16) = ZbarD x := by
    unfold ZbarD; ring
  rw [hval] at hbuild
  convert hbuild using 1 <;> first
    | rfl
    | (funext y; simp [Pi.mul_apply, Pi.div_apply, Pi.sub_apply, Pi.add_apply, Pi.pow_apply,
        Pi.neg_apply, id])
    | ring
    | (funext y; unfold Zbar; ring)
