  have hj : j < 91 := by simpa [hexp] using htest
  have hnext : D ^ j * D ≤ 4 * D + X * D := by
    rcases hle with rfl | hle
    · simp
      omega
    · exact (Nat.mul_le_mul_right D hle).trans (Nat.le_add_left _ _)
  have hsucc : D ^ (j + 1) = D ^ j * D := pow_succ D j
  have hmono : D ^ (j + 1) ≤ D ^ 91 := Nat.pow_le_pow_right hD hj
  generalize D ^ j = q at *
  have hnextZ : (q : ℤ) * D ≤ 4 * D + X * D := by exact_mod_cast hnext
  have hq0 : (0 : ℤ) ≤ (q : ℤ) * D := by positivity
  have hsafe : (Light.v 0 <' Light.v 7 *' Light.v 1).Safe lim ⟨loc', μ'⟩ := by
    simp [hpow, hDloc, abs_le, -abs_mul]
    omega
  by_cases hlt : X < q * D
  · have hltZ : (X : ℤ) < q * D := by exact_mod_cast hlt
    refine Ends.block (.ite_pos ⟨by simp; omega, ⟨rfl, fun x hx => ?_,
      Or.inr ⟨by simp, by simp, by omega⟩⟩, by simp [hexp]; omega⟩
      (by simp [hN, hpow, hDloc]; omega) hsafe)
    simp only [Stmt.after, Function.update_apply]
    split_ifs <;> first | omega | exact hkept x hx
  · have hgeZ : (q : ℤ) * D ≤ X := by exact_mod_cast not_lt.1 hlt
    refine Ends.block (.ite_neg ⟨by (( (try have := Light.Std.space_le (by assumption))
                                       (try have := Light.Std.const_le (by assumption))
                                       (simp [Light.Limits.Addr, abs_le, -abs_mul, hpow, hDloc, hexp] <;> omega))),
      ⟨rfl, fun x hx => ?_, Or.inl ⟨j + 1, hj, by simp [hexp], by simp [hok],
        by simp [hpow, hDloc, hsucc], Or.inr (by omega)⟩⟩, by simp [hexp]; omega⟩
      (by simp [hN, hpow, hDloc]; omega) hsafe)
    simp only [Stmt.after, Function.update_apply]
    split_ifs <;> first | omega | exact hkept x hx

/-- regimePow91 leaves the memory and the locals below 7 as they are.  Afterwards local 9 is 1 if
D^91 ≤ X and 0 if not. -/
theorem regimePow91_spec (X D : ℕ) (hD : 1 ≤ D)
    (hword : ((4 * D + X * D + 100 : ℕ) : ℤ) ≤ lim.word) (μ : ℕ → ℤ) (loc : ℕ → ℤ)
    (e0 : loc 0 = X) (e1 : loc 1 = D) :
    Ends lim P d regimePow91 ⟨loc, μ⟩ 1648 fun σ' =>
      σ'.mem = μ ∧ (∀ x < 7, σ'.loc x = loc x) ∧
        ((σ'.loc 9 = 1 ∧ D ^ 91 ≤ X) ∨ (σ'.loc 9 = 0 ∧ X < D ^ 91)) := by
  push_cast at hword
  have hND : (0 : ℤ) ≤ (X : ℤ) * D := by positivity
  unfold regimePow91
  refine Ends.setThen (Ends.setThen (Ends.setThen ?_))
  refine Ends.whileVariant (PowInv91 X D loc μ) (fun σ => 91 - (σ.loc 8).toNat) 14
    ?start ?safe (fun σ => regimePow91Round_spec hD hword e0 e1) ?done (by simp)
  case start =>
    refine ⟨rfl, fun x hx => ?_, Or.inl ⟨0, by omega, by simp, by simp, by simp, Or.inl rfl⟩⟩
    simp only [Function.update_apply]
    split_ifs <;> omega
  case safe =>
    rintro σ -
    (( (try have := Light.Std.space_le (by assumption))
       (try have := Light.Std.const_le (by assumption))
       (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
  case done =>
    rintro ⟨loc', μ'⟩ ⟨hmem, hkept, hcase⟩ htest
    dsimp only at hmem hkept hcase
    obtain ⟨j, hj, hexp, hok, -, hle⟩ | ⟨-, hok, hlt⟩ := hcase
    · obtain rfl : j = 91 := by
        have : ¬ j < 91 := by simpa [hexp] using htest
        omega
      exact ⟨hmem, hkept, Or.inl ⟨hok, by omega⟩⟩
    · exact ⟨hmem, hkept, Or.inr ⟨hok, hlt⟩⟩

/-- regimeTestP(N, D) returns 1 if D^91 ≤ N^5 and 0 if not, and changes no cell. -/
theorem regimeTestP_ends (N D : ℕ) (hD : 1 ≤ D)
    (hword : ((4 * D + N ^ 5 * D + N ^ 5 + 100 : ℕ) : ℤ) ≤ lim.word) (μ : ℕ → ℤ) :
    Ends lim P d regimeTestPBody ⟨frame [(N : ℤ), (D : ℤ)], μ⟩ 1700 fun σ' =>
      σ'.mem = μ ∧ ((σ'.loc 0 = 1 ∧ D ^ 91 ≤ N ^ 5) ∨ (σ'.loc 0 = 0 ∧ N ^ 5 < D ^ 91)) := by
  have h2 : N * N ≤ N ^ 5 := by
    rcases Nat.eq_zero_or_pos N with rfl | hN
    · simp
    · rw [← pow_two]; exact Nat.pow_le_pow_right hN (by norm_num)
  have h4 : N * N * (N * N) ≤ N ^ 5 := by
    rcases Nat.eq_zero_or_pos N with rfl | hN
    · simp
    · rw [show N * N * (N * N) = N ^ 4 by ring]; exact Nat.pow_le_pow_right hN (by norm_num)
  have h5 : N * N * (N * N) * N = N ^ 5 := by ring
  have hw5 : ((N ^ 5 : ℕ) : ℤ) ≤ lim.word := le_trans (by push_cast; nlinarith [
    (by positivity : (0 : ℤ) ≤ (N : ℤ) ^ 5 * D)]) hword
  have hw2 : ((N * N : ℕ) : ℤ) ≤ lim.word := le_trans (by exact_mod_cast h2) hw5
  have hw4 : ((N * N * (N * N) : ℕ) : ℤ) ≤ lim.word := le_trans (by exact_mod_cast h4) hw5
  have hw5' : ((N * N * (N * N) * N : ℕ) : ℤ) ≤ lim.word := h5 ▸ hw5
  push_cast at hw2 hw4 hw5'
  unfold regimeTestPBody
  refine Ends.setThen (Ends.setThen (Ends.setThen ?_ ?_) ?_) ?_
  · refine Ends.pieceThen (regimePow91_spec (N ^ 5) D hD (by
      push_cast at hword ⊢; linarith [pow_nonneg (Nat.cast_nonneg N : (0 : ℤ) ≤ N) 5]) μ _
      ?_ ?_) (fun σ' h => ?_)
    · simp [Expr.val, Op.eval, frame]
      ring
    · simp [Expr.val, Op.eval, frame]
    · obtain ⟨loc', μ'⟩ := σ'
      obtain ⟨hmem, -, hres⟩ := h
      dsimp only at hmem hres
      refine Ends.setLast ⟨hmem, ?_⟩
      simpa using hres
  all_goals (simp [Expr.Safe, Expr.val, Op.eval, frame]; assumption)

/-- The procedure regimeTestP returns 1 if D^91 ≤ N^5 and 0 if not, and changes no cell. -/
theorem regimeTestP_meets (n : ℕ) (hP : P[n]? = some regimeTestPBody)
    (N D : ℕ) (hD : 1 ≤ D) (hword : ((4 * D + N ^ 5 * D + N ^ 5 + 100 : ℕ) : ℤ) ≤ lim.word)
    (μ : ℕ → ℤ) :
    Meets lim P n d [N, D] μ 1700 fun r μ' =>
      μ' = μ ∧ ((r = 1 ∧ D ^ 91 ≤ N ^ 5) ∨ (r = 0 ∧ N ^ 5 < D ^ 91)) :=
  .of_body hP (regimeTestP_ends N D hD hword μ)

end Light.Sec4
end
