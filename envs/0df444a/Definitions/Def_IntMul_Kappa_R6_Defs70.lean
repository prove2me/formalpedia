section
-- Source module: Solutions.R6FineRun
/-!
# Fine-bit exposure §2: the procedures `fineF` / `fineB` in IL

* `bodyF`: `qX /= 2`, one `mvFU` move, `qZ *= 2`; `bodyB`: `qZ /= 2`, one `mvBU` move, `qX *= 2`.
  **`loopF_runs`** / **`loopB_runs`**: `f` iterations (`rptX nR`) take stage `0` to stage `f`.
* `coreF` / `coreB`: with `y` on `dP` and `a, f` in `rCZ, rU`, set `qB = y`, `qX`, `qZ`, `nR = f`,
  `tq = 2`, run the loop, clear. **`coreF_runs`** / **`coreB_runs`**.
* `fineE core`: pop `w, f, a` from `dP` (into `rW, rU, rCZ`), run `core` if `a > 0`, push them
  back. **`fineE_runs`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Fine

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU IntMul.Kappa.R6

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## The loop bodies -/

def bodyF : IStmt HS P := .seq (divE qX tq tq2) (.seq mvFU (.op (.shl qZ tq)))

def bodyB : IStmt HS P := .seq (divE qZ tq tq2) (.seq mvBU (.op (.shl qX tq)))

/-- The cost bound of one loop iteration (`V` the number of Gaussian entries). -/
def cIt (w V Z : ℕ) : ℕ := 44 * (kap w * V) + 8000 * V + 9000 + 8 * cU Z

/-! ## The forward loop -/

/-- The state after `k` forward iterations. -/
def stLF (a f y : ℕ) (xs : List ℤ) (t : IState HS) (R LX LZ : List Item) (k : ℕ) : IState HS :=
  ((t.upd 0 (ints (stF a (2 ^ f) y (2 ^ (f - k)) (2 ^ k) xs) ++ R)).upd
    qX (.int ((a * 2 ^ (f - k) : ℕ) : ℤ) :: LX)).upd qZ (.int ((2 ^ k * 2 : ℕ) : ℤ) :: LZ)

/-! ## The forward core -/

def coreF : IStmt HS P :=
  .seq (.op (.mv dP qB)) (.seq (.op (.dup rCZ qX)) (.seq (.op (.dup rU nR))
  (.seq (.op (.const tq 2)) (.seq (rptX nR lA lC lD (.op (.shl qX tq)))
  (.seq (.op (.const qZ 2)) (.seq (rptX nR lA lC lD bodyF)
  (.seq (.op (.drop qZ)) (.seq (.op (.drop tq)) (.seq (.op (.drop nR)) (.seq (.op (.drop qX))
    (.op (.mv qB dP))))))))))))

/-- The cost bound of a core. -/
def cCore (w f V Z : ℕ) : ℕ := 12 * cU Z + (f + 1) * (cIt w V Z + 6400)

/-! ## The backward loop -/

/-- The state after `k` backward iterations. -/
def stLB (a f y : ℕ) (xs : List ℤ) (t : IState HS) (R LX LZ : List Item) (k : ℕ) : IState HS :=
  ((t.upd 0 (ints (stB a (2 ^ f) y (2 ^ k) (2 ^ (f - k)) xs) ++ R)).upd
    qX (.int ((a * 2 ^ k : ℕ) : ℤ) :: LX)).upd qZ (.int ((2 ^ (f - k) * 2 : ℕ) : ℤ) :: LZ)

/-! ## The backward core -/

def coreB : IStmt HS P :=
  .seq (.op (.mv dP qB)) (.seq (.op (.dup rCZ qX)) (.seq (.op (.dup rU nR))
  (.seq (.op (.const tq 2)) (.seq (.op (.const qZ 2)) (.seq (rptX nR lA lC lD (.op (.shl qZ tq)))
  (.seq (rptX nR lA lC lD bodyB)
  (.seq (.op (.drop qZ)) (.seq (.op (.drop tq)) (.seq (.op (.drop nR)) (.seq (.op (.drop qX))
    (.op (.mv qB dP))))))))))))

/-! ## The wrapper -/

def fineE (core : IStmt HS P) : IStmt HS P :=
  .seq (.op (.mv dP rW)) (.seq (.op (.mv dP rU)) (.seq (.op (.mv dP rCZ))
  (.seq (.ite rCZ NLogN.KFUU.isPos core .skip)
  (.seq (.op (.mv rCZ dP)) (.seq (.op (.mv rU dP)) (.op (.mv rW dP)))))))

end Gen

end NLogN.KFUU.R6Fine

end

