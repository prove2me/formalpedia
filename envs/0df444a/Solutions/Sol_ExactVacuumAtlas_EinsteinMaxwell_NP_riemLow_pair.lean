variable {n : ℕ}
variable {g gi : Metric n} {U : Set (Pt n)}
theorem solution (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (a b c d : Fin n) :
    riemLow g gi c d a b y = riemLow g gi a b c d y := by
  have hQ : quadQ g gi c d a b y = quadQ g gi a b c d y := by
    have h0 : quadQ g gi c d a b y - quadQ g gi a b c d y = 0 := by
      unfold quadQ
      simp only [← Finset.sum_sub_distrib]
      refine sum_sum_antisymm_eq_zero fun e f => ?_
      simp only [gi_symm hm hy f e, chr1_symm hm hy f b c, chr1_symm hm hy e b c, chr1_symm hm hy f a d,
        chr1_symm hm hy e a d, chr1_symm hm hy f a c, chr1_symm hm hy e a c, chr1_symm hm hy f b d,
        chr1_symm hm hy e b d]
      ring
    linarith
  rw [riemLow_expl hm hy, riemLow_expl hm hy, hQ, hessG_symm_ij hm hy a d c b,
    hessG_symm_ij hm hy a c b d, hessG_symm_kl hm hy c a b d, hessG_symm_ij hm hy b d c a,
    hessG_symm_kl hm hy d b c a, hessG_symm_ij hm hy b c a d]
  ring
