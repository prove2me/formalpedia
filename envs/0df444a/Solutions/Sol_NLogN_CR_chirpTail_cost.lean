    have zm' : zsz (-(k0.tmod 2)) ≤ B := by rw [zsz_neg]; exact zm
    rw [Int.tmod_eq_emod_of_nonneg hk0] at zm zm'
    rcases hmod with h | h
    · simp +decide only [scanBody, scanPre, scanPost, LinB, RS.run, Ex.Lin, Ex.Bnd, Ex.eval,
        IState.top, IState.upd_G, h0, hA, hB, if_true, if_false, List.tail_cons, parE, emitP, setP,
        true_and, and_true, Int.tmod_eq_emod_of_nonneg hk0, h, neg_zero, lt_irrefl]
      rw [h] at zm zm'
      constructorm* _ ∧ _ <;> assumption
    · simp +decide only [scanBody, scanPre, scanPost, LinB, RS.run, Ex.Lin, Ex.Bnd, Ex.eval,
        IState.top, IState.upd_G, h0, hA, hB, if_true, if_false, List.tail_cons, parE, emitP, setP,
        true_and, and_true, Int.tmod_eq_emod_of_nonneg hk0, h, show (-1 : ℤ) < 0 by decide]
