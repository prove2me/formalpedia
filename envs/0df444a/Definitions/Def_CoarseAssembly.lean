def fiberReindexRoeHom :
    (letI := OAI.CoarseAssembly.separatedMetric OAI.CoarseAssembly.fiberBoundaryBase;
      OAI.CoarseAssembly.DiscreteRoe.algebra (X := Sigma OAI.CoarseAssembly.FiberVertex) (H := OAI.CoarseAssembly.AmpleSpace)) →⋆ₙₐ[ℂ] OAI.CoarseAssembly.TotalRoe := by
  classical

  let := OAI.CoarseAssembly.separatedMetric OAI.CoarseAssembly.fiberBoundaryBase
  exact OAI.CoarseAssembly.DiscreteRoe.inclusionHom (X := Sigma OAI.CoarseAssembly.FiberVertex) (Y := OAI.CoarseAssembly.VertexUnion) (H := OAI.CoarseAssembly.AmpleSpace) OAI.CoarseAssembly.totalToFiber.symm.toEmbedding
    (fun x y => (((
  let local_proof {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] (e : X ≃ Y) (he : Isometry e) : Isometry e.symm :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
      open Analytic in
      by
        apply Isometry.of_dist_eq
        intro x y
        simpa only [Equiv.apply_symm_apply] using (he.dist_eq (e.symm x) (e.symm y)).symm
  local_proof) OAI.CoarseAssembly.totalToFiber (Isometry.of_dist_eq (
  let local_proof (x y : OAI.CoarseAssembly.VertexUnion) : dist (OAI.CoarseAssembly.totalToFiber x) (OAI.CoarseAssembly.totalToFiber y) = dist x y :=
    open OAI OAI.CoarseAssembly in
      open Congruence Rips Analytic in
      rfl
  local_proof))).dist_eq x y).le)

def constructedTotalIndex : CompatibleIndexFamily (coarsening VertexUnion) TotalRoe :=
  (separatedIndexFamily (Q := FiberVertex) fiberBoundaryBase).transport totalToFiberCoarsening fiberReindexRoeHom

