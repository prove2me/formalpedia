variable (F : Type) [Field F] [NumberField F] (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥)

private def idealUnit : (FractionalIdeal (𝓞 F)⁰ F)ˣ :=
  Units.mk0 ((𝔫 : FractionalIdeal (𝓞 F)⁰ F)) (FractionalIdeal.coeIdeal_ne_zero.mpr h𝔫)

private abbrev LevelIndex : Type := Module.Free.ChooseBasisIndex ℤ (idealUnit F 𝔫 h𝔫)

private def adelicTorusMap : InfiniteAdeleRing F →+ UnitAddTorus (LevelIndex F 𝔫 h𝔫) :=
  (torusMap (fractionalIdealLatticeBasis F (idealUnit F 𝔫 h𝔫))).comp (ringEquiv_mixedSpace F).toAddMonoidHom

private theorem adelicTorusMap_apply (y : InfiniteAdeleRing F) :
    adelicTorusMap F 𝔫 h𝔫 y = torusMap (fractionalIdealLatticeBasis F (idealUnit F 𝔫 h𝔫)) (ringEquiv_mixedSpace F y) := rfl

private theorem continuous_adelicTorusMap : Continuous (adelicTorusMap F 𝔫 h𝔫) :=
  (continuous_torusMap _).comp (continuous_ringEquiv_mixedSpace F)

private theorem adelicTorusMap_surjective : Surjective (adelicTorusMap F 𝔫 h𝔫) :=
  (torusMap_surjective _).comp (ringEquiv_mixedSpace F).surjective

private theorem isOpenQuotientMap_adelicTorusMap : IsOpenQuotientMap (adelicTorusMap F 𝔫 h𝔫) := by
  haveI : ∀ v : InfinitePlace F, SecondCountableTopology v.Completion := fun v => by
    by_cases hv : v.IsReal
    · exact (InfinitePlace.Completion.isometryEquivRealOfIsReal hv).toHomeomorph.secondCountableTopology
    · exact (InfinitePlace.Completion.isometryEquivComplexOfIsComplex
        (InfinitePlace.not_isReal_iff_isComplex.mp hv)).toHomeomorph.secondCountableTopology
  haveI : SecondCountableTopology (InfiniteAdeleRing F) :=
    inferInstanceAs (SecondCountableTopology ((v : InfinitePlace F) → v.Completion))
  haveI : SigmaCompactSpace (InfiniteAdeleRing F) := inferInstance
  refine IsOpenQuotientMap.of_isOpenMap_isQuotientMap ?_ ?_
  · exact AddMonoidHom.isOpenMap_of_sigmaCompact _ (adelicTorusMap_surjective F 𝔫 h𝔫) (continuous_adelicTorusMap F 𝔫 h𝔫)
  · exact IsOpenMap.isQuotientMap
      (AddMonoidHom.isOpenMap_of_sigmaCompact _ (adelicTorusMap_surjective F 𝔫 h𝔫) (continuous_adelicTorusMap F 𝔫 h𝔫))
      (continuous_adelicTorusMap F 𝔫 h𝔫) (adelicTorusMap_surjective F 𝔫 h𝔫)

private theorem adelicTorusMap_eq_zero_iff (y : InfiniteAdeleRing F) :
    adelicTorusMap F 𝔫 h𝔫 y = 0 ↔ ∃ k : 𝓞 F, k ∈ 𝔫 ∧ algebraMap F (InfiniteAdeleRing F) (k : F) = y := by
  rw [adelicTorusMap_apply, torusMap_eq_zero_iff, mem_span_fractionalIdealLatticeBasis]
  constructor
  · rintro ⟨x, hx, hxy⟩
    have hx' : x ∈ ((idealUnit F 𝔫 h𝔫 : FractionalIdeal (𝓞 F)⁰ F) : Set F) := hx
    rw [idealUnit, Units.val_mk0, SetLike.mem_coe, FractionalIdeal.mem_coeIdeal] at hx'
    obtain ⟨k, hk, rfl⟩ := hx'
    refine ⟨k, hk, (ringEquiv_mixedSpace F).injective ?_⟩
    rw [← mixedEmbedding_eq_algebraMap_comp]
    exact hxy
  · rintro ⟨k, hk, rfl⟩
