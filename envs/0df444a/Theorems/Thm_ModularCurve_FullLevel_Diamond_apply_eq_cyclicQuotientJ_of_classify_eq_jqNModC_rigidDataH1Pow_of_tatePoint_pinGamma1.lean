    (ξ : ↥k₀) (hξ : IsPrimitiveRoot ξ (q * ℓg))
    (hιξ : ∃ ι : ↥k₀ →+* ℂ, ι ξ = Complex.exp (2 * Real.pi * Complex.I / (q * ℓg)))
