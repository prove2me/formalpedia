  have hreg : ∀ x : AdjoinRoot Φ, algebraMap O (AdjoinRoot Φ) ϖ * x = 0 → x = 0 :=
    fun x hx => (mul_eq_zero.mp hx).resolve_left (hirr ϖ hϖ).ne_zero
  have hcop := (TypeDensity.conjugate_roots_distinct O Φ hΦ).2.2.2.2.2
  constructor
  · intro h j
    have := TypeDensity.hensel_family_unique_mod_pow (AdjoinRoot Φ) (Fin Φ.natDegree) _ hspan hreg B B' hBm
      hBm' (fun i => TypeDensity.map_residue_eq_of_map_baseReduce_eq hmax (by rw [hBr, hBr']))
      (fun i j hij => TypeDensity.isCoprime_map_residue hmax (by rw [hBr, hBr]; exact (hcop i j hij).pow)) L
      (by rw [hBp, hBp', hmax]; exact h) ⟨0, hδ⟩ j
    rwa [hmax] at this
  · intro h
    have h0 : ∀ j, (B ⟨0, hδ⟩).coeff j - (B' ⟨0, hδ⟩).coeff j ∈ (TypeDensity.baseIdeal O Φ) ^ L :=
      (TypeDensity.monic_coeff_sub_mem_iff _ _ _ _ (hBm _) (hBm' _) (hBd _) (hBd' _)).1 h
    have hconj := TypeDensity.block_conjugates O Φ hΦ r a hδ B hBm hBr hBp
