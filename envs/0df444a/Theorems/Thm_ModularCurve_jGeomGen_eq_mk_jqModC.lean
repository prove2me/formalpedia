open ModularCurve

theorem ModularCurve.jGeomGen_eq_mk_jqModC (K : Type*) [Field K] (N : ℕ) [NeZero N] :
    jGeomGen K N = ⟨jqModC K, jqModC_mem K N⟩ := by sorry
