theorem median_miss_majority {k : ℕ} (h : Bool) (t : ℚ) (price : Calls k → ℚ)
    (hm : misses h t (oddMedian price) = true) :
    1/2 ≤ weighted (uniform k) (fun b => if misses h t (price b) then 1 else 0) := by sorry
