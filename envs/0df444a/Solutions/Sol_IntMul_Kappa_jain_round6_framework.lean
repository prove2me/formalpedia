-- Source module: Solutions.J6SegAxBud9
/-!
# B-line axis budget 9: **`axBudget6_all`**, **`axBudget6_ap6`**

`AxBudget6 P ap` for every `P.Ok` and every plan with `ValCond6`, `ChunkPlan6`, `ChunkPlanB`
(side costs: `Side.sideCost6_all`; `J` pass: `Side.jBudget6_all`; chunk pass:
`ChB.chunkBudget6_all`); in particular at Track D's plan `ap6` (the `hBud` leaf of
`jain_round6_framework_leaf`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.ChB
open IntMul.Kappa.R6 J6Seg

theorem axBudget6_all (P : Prm) (hP : P.Ok) (ap : AxPlan6) (hc : Val.ValCond6 ap)
    (hc' : AxCh.ChunkPlan6 ap) (hcb : ChunkPlanB ap) : AxBudget6 P ap :=
  axBudget6_of P hP ap (Side.sideCost6_all P hP ap hc hc') (Side.jBudget6_all P hP ap hc hc')
    (chunkBudget6_all P hP ap hc' hcb)

theorem ap6_chunkB : ChunkPlanB ap6 := by
  unfold ChunkPlanB ap6; decide

/-- **The `hBud` leaf at `ap6`.** -/
theorem axBudget6_ap6 : ∀ P : Prm, P.Ok → AxBudget6 P ap6 := fun P hP =>
  axBudget6_all P hP ap6 ap6_val ap6_chunk ap6_chunkB

end J6Seg.ChB

end

