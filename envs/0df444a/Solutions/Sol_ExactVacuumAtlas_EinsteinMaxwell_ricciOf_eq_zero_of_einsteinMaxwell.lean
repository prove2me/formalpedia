theorem solution {g ginv : Metric 4} {F : TwoForm 4} {x : Pt 4}
    (hs : ∀ i j, g i j x = g j i x) (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hF : ∀ i j, F i j x = 0) (hE : ∀ i j, einsteinMaxwell g ginv F i j x = 0) (i j : Fin 4) :
    ricciOf g ginv i j x = 0 := by
  have hR : ∀ a b, ricciOf g ginv a b x = g a b x * ricciScalar g ginv x / 2 := by
    intro a b
    have e := hE a b
    rw [einsteinMaxwell_of_zero hF] at e
