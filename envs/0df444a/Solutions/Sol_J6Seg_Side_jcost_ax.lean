/-!
# J cost 3: the axis facts of the `J` pass, and the window bound on an axis

* `AxJ P n src D k`: `AxNum` plus `0 < s ≤ t`, `8d² ≤ t`, `8d²(t-s) ≤ 2t`, the `SegReg` of the
  line, `t ≤ 2^ℓ`, `ℓ d ≤ 2p`, `w ≤ |LJ|`; **`axJ_ev`**: eventually on every axis.
* **`win_ax`**, `bd_ax`: on an axis, every window `[x, x + λ + w]` of `LJ` (index form), and
  the border `[c, s)`, hold at most `182 w` positions.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

open Finset

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-! ## The window bound on an axis -/

theorem idx_card_le {L : List ℕ} (hnd : L.Nodup) (p : ℕ → Prop) [DecidablePred p] :
    ((range L.length).filter (fun q => p (L.getD q 0))).card ≤ (L.toFinset.filter p).card := by
  apply card_le_card_of_injOn (fun q => L.getD q 0)
  · intro q hq
    simp only [coe_filter, mem_range, Set.mem_setOf_eq] at hq
    simp only [coe_filter, List.mem_toFinset, Set.mem_setOf_eq]
    refine ⟨?_, hq.2⟩
    rw [List.getD_eq_getElem _ _ hq.1]; exact List.getElem_mem _
  · intro a ha b hb hab
    simp only [coe_filter, mem_range, Set.mem_setOf_eq] at ha hb
    simp only at hab
    rw [List.getD_eq_getElem _ _ ha.1, List.getD_eq_getElem _ _ hb.1] at hab
    exact (hnd.getElem_inj_iff).1 hab

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (h : AxJ P n src D k)
include h

theorem win_ax (x : ℕ) :
    ((range (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length).filter (fun q =>
      x ≤ (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).getD q 0 ∧
      (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).getD q 0 ≤
        x + (axl6 P n + axw6 P n))).card ≤ 182 * axw6 P n :=
  (idx_card_le (LJ_nodup _ _ _ _) (fun j => x ≤ j ∧ j ≤ x + (axl6 P n + axw6 P n))).trans
    (win_num h.base.d1 h.s0 h.st h.t8 h.ts x)

theorem bd_ax :
    ((range (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length).filter (fun q =>
      axs6 src k - axl6 P n - axw6 P n ≤
        (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).getD q 0)).card ≤ 182 * axw6 P n := by
  refine le_trans (card_le_card ?_) (win_ax h (axs6 src k - axl6 P n - axw6 P n))
  intro q hq
  simp only [mem_filter, mem_range] at hq ⊢
  refine ⟨hq.1, hq.2, ?_⟩
  have hmem : (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).getD q 0 ∈
      LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n) := by
    rw [List.getD_eq_getElem _ _ hq.1]; exact List.getElem_mem _
  have : (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).getD q 0 < axs6 src k := by
    unfold LJ Jlist at hmem
    rw [List.mem_filter, List.mem_range] at hmem
    exact hmem.1
  omega

end ax

end J6Seg.Side
end

end

