theorem eval_nat_mono (p : Polynomial ℕ) ⦃a b : ℕ⦄ (hab : a ≤ b) : p.eval a ≤ p.eval b := by
  rw [Polynomial.eval_eq_sum,Polynomial.eval_eq_sum]
