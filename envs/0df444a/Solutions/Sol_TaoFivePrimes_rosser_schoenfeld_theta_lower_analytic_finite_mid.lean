import Mathlib

/-! Five Primes: a Rosser-Schoenfeld theta lower bound on `[10^4, 10^6]` by a kernel-checked certificate.
* `θ c = log c#` (`Chebyshev.theta_eq_log_primorial`); the certificate walks checkpoints `c₀ < c₁ < ...`
  (the last `≥ N`) keeping a 128-bit mantissa `m` with `m * 2 ^ (a - 127) ≤ c#`, so `a * log 2 ≤ θ c`.
* Step `i` codes the primes of `(cᵢ₋₁, cᵢ]` as the base-64 digits of one number `G` (digit `d` is a
  prime gap `2 d + 2`); `dec` decodes them, proves each prime by one gcd with `1000!` (valid below
  `1001²`), multiplies them in, and the walk drops `da` low bits (`Nat.shiftRight`), so all kernel
  arithmetic stays small. Soundness only needs the listed numbers to be distinct primes in the range.
* On `[cᵢ, cᵢ₊₁)` theta is at least `θ cᵢ` while the left side is at most its value at `cᵢ₊₁`, so one
  integer inequality per step (`cond`) suffices; `Real.log_two_gt_d9` turns `a` into a real bound.
* Everything integer is checked by one `decide +kernel` (plain kernel reduction). -/

set_option autoImplicit false

namespace TFPThetaM1


/-- `1000!`, the factor pool for the primality test above `10200` -/
def F1000 : ℕ := Nat.factorial 1000

theorem F1000_eq : F1000 = Nat.factorial 1000 := rfl

/-- factor pool for the primality test of `n`: `(min (n - 1) 100)!` up to `10200`, else `1000!` -/
def fB (n : ℕ) : ℕ := cond (Nat.ble n 10200) (Nat.factorial (min (n - 1) 100)) F1000

/-- the primality test: `gcd n (fB n) = 1` with `2 ≤ n ≤ 1002000` makes `n` prime -/
theorem prime_of_gcd (p : ℕ) (h2' : 2 ≤ p) (hlt' : p ≤ 1002000) (hg' : Nat.gcd p (fB p) = 1) :
    p.Prime := by
  by_contra hnp
  have hp1 : p ≠ 1 := by omega
  have hmp := Nat.minFac_prime hp1
  have hsq := Nat.minFac_sq_le_self (by omega) hnp
  have hsq' : p.minFac * p.minFac ≤ p := by rw [← pow_two]; exact hsq
  have h2m := hmp.two_le
  have hmle : p.minFac ≤ p := Nat.minFac_le (by omega)
  have hmne : p.minFac ≠ p := fun he => hnp (he ▸ hmp)
  have hdf : p.minFac ∣ fB p := by
    unfold fB
    cases hb : Nat.ble p 10200
    · rw [cond_false, F1000_eq]
      have h1000 : p.minFac ≤ 1000 := by
        by_contra hc
        have h1001 : 1001 ≤ p.minFac := by omega
        have h3 := le_trans (Nat.mul_le_mul h1001 h1001) hsq'
        omega
      exact Nat.dvd_factorial (by omega) h1000
    · rw [cond_true]
      have hb' := Nat.le_of_ble_eq_true hb
      have h100 : p.minFac ≤ 100 := by
        by_contra hc
        have h101 : 101 ≤ p.minFac := by omega
        have h3 := le_trans (Nat.mul_le_mul h101 h101) hsq'
        omega
      exact Nat.dvd_factorial (by omega) (by omega)
  have hd : p.minFac ∣ Nat.gcd p (fB p) := Nat.dvd_gcd (Nat.minFac_dvd p) hdf
  rw [hg'] at hd
  have := Nat.le_of_dvd one_pos hd
  omega

/-- `dec acc p G k` decodes the primes after `p` from the base-64 digits of `G` (digit `d` is a gap
of `2 d + 2`; the leading digit `1` ends the list), checks each one with the gcd test and multiplies it
into `acc`; it returns the product and the last prime, or product `0` on failure (`k` is fuel) -/
def dec (acc p G : ℕ) : ℕ → ℕ × ℕ
  | 0 => (0, p)
  | k + 1 =>
    cond (Nat.ble G 1) (acc, p)
      (let q := Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2)
       let a := Nat.mul acc q
       cond (Nat.beq (Nat.gcd q (fB q)) 1)
         (cond (Nat.beq a 0) (0, p) (dec a q (Nat.div G 64) k)) (0, p))

theorem dec_mono : ∀ (k acc p G : ℕ), p ≤ (dec acc p G k).2 := by
  intro k
  induction k with
  | zero => intro acc p G; simp [dec]
  | succ k ih =>
    intro acc p G
    simp only [dec]
    cases h1 : Nat.ble G 1
    · simp only [cond_false]
      cases h2 : Nat.beq (Nat.gcd (Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2))
          (fB (Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2)))) 1
      · simp
      · simp only [cond_true]
        cases h3 : Nat.beq (Nat.mul acc (Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2))) 0
        · simp only [cond_false]
          have := ih (Nat.mul acc (Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2)))
            (Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2)) (Nat.div G 64)
          have e : Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2) = p + (2 * (G % 64) + 2) := rfl
          omega
        · simp
    · simp

theorem primorial_succ_prime (n : ℕ) (h : (n + 1).Prime) :
    primorial (n + 1) = (n + 1) * primorial n := by
  unfold primorial
  rw [Finset.range_add_one, Finset.filter_insert, if_pos h, Finset.prod_insert]
  simp

theorem primorial_le_of_prime (p q : ℕ) (hpq : p < q) (hq : q.Prime) :
    q * primorial p ≤ primorial q := by
  obtain ⟨r, rfl⟩ : ∃ r, q = r + 1 := ⟨q - 1, by omega⟩
  rw [primorial_succ_prime r hq]
  exact Nat.mul_le_mul_left _ (primorial_mono (by omega))

theorem dec_le (Y : ℕ) : ∀ (k acc p G : ℕ), 1 ≤ p → acc * Y ≤ primorial p →
    (dec acc p G k).2 ≤ 1002000 → (dec acc p G k).1 * Y ≤ primorial (dec acc p G k).2 := by
  intro k
  induction k with
  | zero => intro acc p G _ _ _; simp [dec]
  | succ k ih =>
    intro acc p G hp h hr
    simp only [dec] at hr ⊢
    cases h1 : Nat.ble G 1
    · simp only [h1, cond_false] at hr ⊢
      set q := Nat.add p (Nat.add (Nat.mul 2 (Nat.mod G 64)) 2) with hqdef
      have hq : q = p + (2 * (G % 64) + 2) := rfl
      cases h2 : Nat.beq (Nat.gcd q (fB q)) 1
      · simp
      · simp only [h2, cond_true] at hr ⊢
        cases h3 : Nat.beq (Nat.mul acc q) 0
        · simp only [h3, cond_false] at hr ⊢
          have hmono := dec_mono k (Nat.mul acc q) q (Nat.div G 64)
          have hprime : q.Prime :=
            prime_of_gcd q (by omega) (by omega) (Nat.eq_of_beq_eq_true h2)
          apply ih _ q _ (by omega) _ hr
          have hpq := primorial_le_of_prime p q (by omega) hprime
          show acc * q * Y ≤ primorial q
          calc acc * q * Y = q * (acc * Y) := by ring
            _ ≤ q * primorial p := Nat.mul_le_mul_left _ h
            _ ≤ primorial q := hpq
        · simp
    · simpa [h1] using h

theorem theta_ge_of_le (c a : ℕ) (h : 2 ^ a ≤ primorial c) :
    (a : ℝ) * Real.log 2 ≤ Chebyshev.theta c := by
  rw [Chebyshev.theta_eq_log_primorial, Nat.floor_natCast]
  have h2 : ((2 ^ a : ℕ) : ℝ) ≤ (primorial c : ℝ) := by exact_mod_cast h
  rw [← Real.log_pow]
  push_cast at h2
  exact Real.log_le_log (by positivity) h2

/-- shifting right by `s` and scaling by `2 ^ s` loses nothing on the upper bound -/
theorem shift_le (q e s P : ℕ) (h : q * 2 ^ e ≤ P) : Nat.shiftRight q s * 2 ^ (e + s) ≤ P := by
  have hsr : Nat.shiftRight q s = q / 2 ^ s := Nat.shiftRight_eq_div_pow _ _
  rw [hsr, pow_add]
  calc q / 2 ^ s * (2 ^ e * 2 ^ s) = (q / 2 ^ s * 2 ^ s) * 2 ^ e := by ring
    _ ≤ q * 2 ^ e := Nat.mul_le_mul_right _ (Nat.div_mul_le_self _ _)
    _ ≤ P := h

theorem pow_le_of_mant (m a P : ℕ) (ha : 127 ≤ a) (hm : 2 ^ 127 ≤ m) (h : m * 2 ^ (a - 127) ≤ P) :
    2 ^ a ≤ P := by
  have e2 : 2 ^ a = 2 ^ 127 * 2 ^ (a - 127) := by
    rw [← pow_add, Nat.add_sub_cancel' ha]
  exact le_trans (le_of_eq e2) (le_trans (Nat.mul_le_mul_right _ hm) h)

/-- the walk: state `(m, c, a)` with `m * 2 ^ (a - 127) ≤ c#` and `2 ^ a ≤ c#`; each step
`(dc, da, G, x)` moves to `c + dc`, multiplies the primes coded by `G` into `m`, drops `da` bits -/
def walk (cnd : ℕ → ℕ → ℕ → ℕ → Bool) (N : ℕ) :
    ℕ → ℕ → ℕ → List (ℕ × ℕ × ℕ × ℕ) → Bool
  | _, c, _, [] => Nat.ble N c
  | m, c, a, (dc, da, G, x) :: l =>
      let sr := dec 1 c G dc
      let m' := Nat.shiftRight (Nat.mul m sr.1) da
      cnd c a (c + dc) x && Nat.ble sr.2 (c + dc) && Nat.ble (c + dc) 1002000 &&
        Nat.ble (2 ^ 127) m' && walk cnd N m' (c + dc) (a + da) l

theorem walk_sound (cnd : ℕ → ℕ → ℕ → ℕ → Bool) (N : ℕ) (Q : ℕ → Prop)
    (hcond : ∀ c a c' x, cnd c a c' x = true → (a : ℝ) * Real.log 2 ≤ Chebyshev.theta c →
      ∀ m, c ≤ m → m < c' → Q m) :
    ∀ (l : List (ℕ × ℕ × ℕ × ℕ)) (m c a : ℕ), walk cnd N m c a l = true → 127 ≤ a → 1 ≤ c →
      m * 2 ^ (a - 127) ≤ primorial c → 2 ^ a ≤ primorial c → ∀ n, c ≤ n → n < N → Q n := by
  intro l
  induction l with
  | nil =>
    intro m c a h _ _ _ _ n h1 h2
    have := Nat.le_of_ble_eq_true h
    omega
  | cons e l ih =>
    obtain ⟨dc, da, G, x⟩ := e
    intro m c a h ha hc1 hP h2a n h1 h2
    simp only [walk, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨hc, hr⟩, hN⟩, hb⟩, hw⟩ := h
    by_cases hn : n < c + dc
    · exact hcond c a (c + dc) x hc (theta_ge_of_le c a h2a) n h1 hn
    · have hr' := Nat.le_of_ble_eq_true hr
      have hN' := Nat.le_of_ble_eq_true hN
      have hb' := Nat.le_of_ble_eq_true hb
      have hd := dec_le (m * 2 ^ (a - 127)) dc 1 c G hc1 (by rw [one_mul]; exact hP) (by omega)
      have hd' : Nat.mul m (dec 1 c G dc).1 * 2 ^ (a - 127) ≤ primorial (c + dc) := by
        have := le_trans hd (primorial_mono hr')
        show m * (dec 1 c G dc).1 * 2 ^ (a - 127) ≤ primorial (c + dc)
        calc m * (dec 1 c G dc).1 * 2 ^ (a - 127) = (dec 1 c G dc).1 * (m * 2 ^ (a - 127)) := by
              ring
          _ ≤ primorial (c + dc) := this
      have hs := shift_le _ (a - 127) da _ hd'
      rw [show a - 127 + da = a + da - 127 by omega] at hs
      exact ih _ (c + dc) (a + da) hw (by omega) (by omega) hs
        (pow_le_of_mant _ _ _ (by omega) hb' hs) n (by omega) h2

theorem primorial_three : primorial 3 = 6 := by
  rw [show (3 : ℕ) = 2 + 1 by rfl, primorial_succ_prime 2 Nat.prime_three, primorial_two]

/-- the whole certificate: the start state is the product `6 ⋅ (primes in (3, c₀] coded by G₀)` -/
def certB (cnd : ℕ → ℕ → ℕ → ℕ → Bool) (N c₀ a₀ G₀ : ℕ) (l : List (ℕ × ℕ × ℕ × ℕ)) : Bool :=
  let sr := dec 6 3 G₀ c₀
  let m := Nat.shiftRight sr.1 (a₀ - 127)
  Nat.ble 3 c₀ && Nat.ble sr.2 c₀ && Nat.ble c₀ 1002000 && Nat.ble 127 a₀ &&
    Nat.ble (2 ^ 127) m && walk cnd N m c₀ a₀ l

theorem certB_sound (cnd : ℕ → ℕ → ℕ → ℕ → Bool) (N : ℕ) (Q : ℕ → Prop)
    (hcond : ∀ c a c' x, cnd c a c' x = true → (a : ℝ) * Real.log 2 ≤ Chebyshev.theta c →
      ∀ m, c ≤ m → m < c' → Q m)
    (c₀ a₀ G₀ : ℕ) (l : List (ℕ × ℕ × ℕ × ℕ))
    (h : certB cnd N c₀ a₀ G₀ l = true) : ∀ n, c₀ ≤ n → n < N → Q n := by
  simp only [certB, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨⟨h3, hr⟩, hN⟩, h127⟩, hb⟩, hw⟩ := h
  have h3' := Nat.le_of_ble_eq_true h3
  have hr' := Nat.le_of_ble_eq_true hr
  have hN' := Nat.le_of_ble_eq_true hN
  have h127' := Nat.le_of_ble_eq_true h127
  have hb' := Nat.le_of_ble_eq_true hb
  have hd := dec_le 1 c₀ 6 3 G₀ (by norm_num) (by rw [primorial_three]) (by omega)
  rw [mul_one] at hd
  have hd' : (dec 6 3 G₀ c₀).1 * 2 ^ 0 ≤ primorial c₀ := by
    rw [pow_zero, mul_one]; exact le_trans hd (primorial_mono hr')
  have hs := shift_le _ 0 (a₀ - 127) _ hd'
  rw [Nat.zero_add] at hs
  exact walk_sound cnd N Q hcond l _ c₀ a₀ hw h127' (by omega) hs
    (pow_le_of_mant _ _ _ h127' hb' hs)

theorem lo_le (a : ℕ) : (a : ℝ) * 6931471803 / 10000000000 ≤ a * Real.log 2 := by
  have h := Real.log_two_gt_d9
  norm_num at h
  have ha : (0 : ℝ) ≤ a := by positivity
  nlinarith

/-- step condition for `t (1 - 1/(2 Real.log t)) < θ t`, with `x = 64 b + j`: from `c' ^ j ≤ 2 ^ b`
(so `Real.log c' ≤ (b / j) * 0.6931471808`), require `c' (1 - j / (2 b 0.6931471808)) < a * 0.6931471803` -/
def cond1 (c a c' x : ℕ) : Bool :=
  Nat.ble 1 c && Nat.ble 1 (x % 64) && Nat.ble (c' ^ (x % 64)) (2 ^ (x / 64)) &&
    Nat.ble ((x % 64) * 10000000000) (2 * (x / 64) * 6931471808) &&
    Nat.blt (c' * (2 * (x / 64) * 6931471808 - (x % 64) * 10000000000) * 10000000000)
      (a * 6931471803 * (2 * (x / 64) * 6931471808))

theorem g_mono {s y : ℝ} (hs : 2 ≤ s) (hsy : s ≤ y) :
    s * (1 - 1 / (2 * Real.log s)) ≤ y * (1 - 1 / (2 * Real.log y)) := by
  have hl2 : (1 : ℝ) / 2 < Real.log 2 := by
    have := Real.log_two_gt_d9
    norm_num at this
    linarith
  have hls : Real.log 2 ≤ Real.log s := Real.log_le_log (by norm_num) hs
  have hly : Real.log s ≤ Real.log y := Real.log_le_log (by linarith) hsy
  have h1 : 0 ≤ 1 - 1 / (2 * Real.log s) := by
    rw [sub_nonneg, div_le_one (by linarith)]
    linarith
  have h2 : 1 - 1 / (2 * Real.log s) ≤ 1 - 1 / (2 * Real.log y) := by
    have : 1 / (2 * Real.log y) ≤ 1 / (2 * Real.log s) :=
      one_div_le_one_div_of_le (by linarith) (by linarith)
    linarith
  exact mul_le_mul hsy h2 h1 (by linarith)

theorem g_lt (y j b a : ℕ) (hy : 2 ≤ y) (hj : 1 ≤ j) (hyb : y ^ j ≤ 2 ^ b)
    (hjb : j * 10000000000 ≤ 2 * b * 6931471808)
    (hmain : y * (2 * b * 6931471808 - j * 10000000000) * 10000000000 + 1 ≤
      a * 6931471803 * (2 * b * 6931471808)) :
    (y : ℝ) * (1 - 1 / (2 * Real.log y)) < a * 6931471803 / 10000000000 := by
  have hb : 1 ≤ b := by omega
  have hlt2 := Real.log_two_lt_d9
  norm_num at hlt2
  have hyR : (2 : ℝ) ≤ y := by exact_mod_cast hy
  have hjR : (1 : ℝ) ≤ j := by exact_mod_cast hj
  have hbR : (1 : ℝ) ≤ b := by exact_mod_cast hb
  have hlogy : 0 < Real.log (y : ℝ) := Real.log_pos (by linarith)
  have h1 : (j : ℝ) * Real.log y ≤ b * Real.log 2 := by
    rw [← Real.log_pow, ← Real.log_pow]
    exact Real.log_le_log (by positivity) (by exact_mod_cast hyb)
  have hmR : ((y * (2 * b * 6931471808 - j * 10000000000) * 10000000000 + 1 : ℕ) : ℝ) ≤
      ((a * 6931471803 * (2 * b * 6931471808) : ℕ) : ℝ) := by exact_mod_cast hmain
  push_cast [Nat.cast_sub hjb] at hmR
  have hK : (0 : ℝ) < 2 * b * 6931471808 := by positivity
  have hq : (j : ℝ) * 10000000000 / (2 * b * 6931471808) < 1 / (2 * Real.log y) := by
    rw [div_lt_div_iff₀ hK (by positivity)]
    nlinarith
