-- Source module: NLogN.HBd1
/-!
# Crude magnitude bounds, part 1: scalars and the one-dimensional maps

All bounds are on `Int.natAbs` of each component.  `ZB z B` says both components of the
Gaussian integer `z` are at most `B` in absolute value; `LB L B` says this for every entry of a
list, `FB f B` for every value of a function `ℕ → ℤ × ℤ`.

Main results:
* `expNegFix_natAbs_le`: `|expNegFix n M X| ≤ (2M+15) 2^n` for **every** `X`;
  hence `expNeg_natAbs_le`, `expPos_natAbs_le`, `dTilde_natAbs_le`: `≤ (4p+35) 2^p`.
* `twD_ZB`: `twD p n j` has both components `≤ 2^p` (it is `scaleZ`'d into the disc).
* `Sapprox_FB`, `Eapprox_FB`, `vIter_FB`, `Japprox_FB`, `Dapprox_FB`, `Bapprox_FB`,
  `sapL_LB`, `bapL_LB` (and the lengths `sapL_length`, `bapL_length`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN.BD

open IntMul.HvdH IntMul.HvdH.Ref

/-! ## Bound predicates -/

/-- The sup norm of a Gaussian integer. -/
def gB (z : ℤ × ℤ) : ℕ := max z.1.natAbs z.2.natAbs

/-- Both components of `z` are at most `B` in absolute value. -/
def ZB (z : ℤ × ℤ) (B : ℕ) : Prop := z.1.natAbs ≤ B ∧ z.2.natAbs ≤ B

/-- Every entry of `L` is bounded by `B`. -/
def LB (L : List (ℤ × ℤ)) (B : ℕ) : Prop := ∀ z ∈ L, z.1.natAbs ≤ B ∧ z.2.natAbs ≤ B

/-- Every entry of an integer list is bounded by `B`. -/
def LBz (L : List ℤ) (B : ℕ) : Prop := ∀ a ∈ L, a.natAbs ≤ B

/-- Every value of `f` is bounded by `B`. -/
def FB (f : ℕ → ℤ × ℤ) (B : ℕ) : Prop := ∀ j, (f j).1.natAbs ≤ B ∧ (f j).2.natAbs ≤ B

/-! ## Arithmetic helpers -/

/-! ## `log2Bits M ≤ 2^M` -/

/-! ## `expNegFix` -/

/-! ## Roots of unity -/

/-! ## Products -/

/-! ## The one-dimensional maps -/

/-- The factor of `S̃`: `(2m+1)(4p+35)`, `m = sWidth p α`. -/
def cS1 (p α : ℕ) : ℕ := (2 * sWidth p α + 1) * (4 * p + 35)

/-- The factor of `Ẽ`: `(2m+1)(4p+35)`, `m = eWidth p α`. -/
def cE1 (p α : ℕ) : ℕ := (2 * eWidth p α + 1) * (4 * p + 35)

/-- The factor of `B̃` for a given number of Neumann terms `J`. -/
def cB1 (p α J : ℕ) : ℕ := (4 * p + 35) * (J * cE1 p α ^ J)

/-! ## The list forms -/

end NLogN.BD

end

