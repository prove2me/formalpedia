-- title:
--   Explicit cubic base for the first Weierstrass chart
-- statement:
--   Let $R=\mathbb C[t,x,y,u]$. In chart $c=0$, replace the ideal of polynomial relations on the available analytic orbit by the principal ideal generated by
--
--   $$F_0=y^2-4x^3+g_2x+g_3.$$
--
--   Adjoin the normalized auxiliary polynomial $Q_0$. In chart $c=1$, retain the previously defined global orbit kernel and adjoin $Q_1$. This defines `extensionFirstCubicChartBaseIdeal` for both chart labels. Its equality with the previous base is a theorem obligation, not part of the definition.
--
--   `FirstCubicChartBaseBudget` retains the chart, a point of the specified finite set with nonzero chart denominator, and the same local-length condition as `GlobalChartBaseBudget`: for every prime through that point which is minimal at both adjacent stages $iT$ and $(i+1)T$, its localized quotient at the earlier stage has length at most the supplied natural integer $e$.
--
--   The definition contains no degree estimate, existence assertion, chart-gluing assertion or identification of the second-chart relation ideal.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 5, pp. 380-382: ambient algebraic-group ideals in the global zero-estimate argument. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. The new proof identifies the first affine chart orbit ideal exactly with the principal Weierstrass cubic ideal, by polynomial normal form, period/quasiperiod saturation, parity and the infinite regular wp image. It replaces that chart's base by the cubic plus normalized Q. Second-chart ideal identification, chart gluing, locus and coset/component selection, and the uniform total-degree estimate remain open.

import Definitions.Def_WeierstrassEllipticZeta_GlobalChartBase

noncomputable section
namespace WeierstrassEllipticZeta
open TranscendenceTheory

/-- Replace the first chart orbit kernel by its explicit cubic ideal.
The second chart is still described by its global orbit kernel. -/
def extensionFirstCubicChartBaseIdeal (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (c : Fin 2) : Ideal (MvPolynomial (Fin 4) ℂ) :=
  (if c = 0 then Ideal.span {extensionChartCubic L.g₂ L.g₃ 0}
    else extensionGlobalChartKernel S c) ⊔ Ideal.span {extensionChartNormalize c Q}

structure FirstCubicChartBaseBudget (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T e : ℕ) (Z : Finset ℂ) where
  chart : Fin 2
  z : ℂ
  z_mem : z ∈ Z
  chart_ne : S (extensionChartDenominator chart) z ≠ 0
  length_le : ∀ (i : Fin 3) (p : Ideal (MvPolynomial (Fin 4) ℂ)) [p.IsPrime],
    p ≤ RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S chart z)) →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionFirstCubicChartBaseIdeal L S Q chart) (i.val * T)).minimalPrimes →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionFirstCubicChartBaseIdeal L S Q chart) ((i.val + 1) * T)).minimalPrimes →
    Module.length (Localization.AtPrime p)
      ((Localization.AtPrime p) ⧸ (differentialProlongation
        (extensionChartDerivation L.g₂ L.g₃ chart)
        (extensionFirstCubicChartBaseIdeal L S Q chart) (i.val * T)).map
        (algebraMap (MvPolynomial (Fin 4) ℂ) (Localization.AtPrime p))) ≤ (e : ℕ∞)

end WeierstrassEllipticZeta


