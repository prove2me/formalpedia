theorem NLogN.KFR.xor_mask_sub {K ρ f L Y X : ℕ} (hK : 1 ≤ K) (hρ : ρ < K) (hL : f * K ≤ L)
    (hY : Y < 2 ^ L) (hX : X < 2 ^ L) :
    ((Y ^^^ (X &&& KFH.selMask K ρ f) : ℕ) : ℤ) - Y =
      ∑ u ∈ Finset.range f, (bitZ (Y ^^^ X) (ρ + u * K) - bitZ Y (ρ + u * K)) * 2 ^ (ρ + u * K) := by sorry
