def tableNext (i : StateId) (g : Symbol) : StateId := ⟨nextNat i g % 147, Nat.mod_lt _ (by decide)⟩
def classOf (i : StateId) : ClassId := ⟨classNat i % 101, Nat.mod_lt _ (by decide)⟩
def quotientNext (i : ClassId) (g : Symbol) : ClassId := ⟨quotientNextNat i g % 101, Nat.mod_lt _ (by decide)⟩
def representative (i : ClassId) : StateId := ⟨representativeNat i % 147, Nat.mod_lt _ (by decide)⟩
def wordOfList (xs : List Nat) : Word Symbol := xs.foldl (fun w g => .snoc w ⟨g % 8,Nat.mod_lt _ (by decide)⟩) .empty
def reachWord (i : StateId) : Word Symbol := wordOfList (reachList i)
def separatingWord (c d : ClassId) : Word Symbol :=
  wordOfList (separatingList c d)
def tableRun (i : StateId) : Word Symbol → StateId
  | .empty => i
  | .snoc w g => tableNext (tableRun i w) g
def quotientRun (i : ClassId) : Word Symbol → ClassId
  | .empty => i
  | .snoc w g => quotientNext (quotientRun i w) g
def wordLength : Word Symbol → Nat
  | .empty => 0
  | .snoc w _ => wordLength w + 1
instance (w : Word Symbol) : Decidable w.nonempty := by
  cases w <;> unfold Word.nonempty <;> infer_instance

def StateFacts (i : StateId) : Prop :=
  (∀ g : Symbol, nextNat i g < 147) ∧
  classNat i < 101 ∧
  locateState (entry i) = i ∧
  (entry i = none ↔ i = 0) ∧
  (∀ g : Symbol, StepValid (entry i) (entry (tableNext i g)) g) ∧
  tableRun 0 (reachWord i) = i ∧
  (i ≠ 0 → (reachWord i).nonempty) ∧
  tableOutput i = outputMask (entry i) ∧
  tableOutput i = presenceCount (entry i) ∧
  (∀ g : Symbol, classOf (tableNext i g) = quotientNext (classOf i) g) ∧
  tableOutput i = quotientOutput (classOf i)
instance (i : StateId) : Decidable (StateFacts i) := by unfold StateFacts; infer_instance

def ClassFacts (c : ClassId) : Prop :=
  (∀ g : Symbol, quotientNextNat c g < 101) ∧
  representativeNat c < 147 ∧
  classOf (representative c) = c ∧
  (∀ d : ClassId, c ≠ d → quotientOutput (quotientRun c (separatingWord c d)) ≠ quotientOutput (quotientRun d (separatingWord c d))) ∧
  (∀ d : ClassId, wordLength (separatingWord c d) ≤ 2)
instance (c : ClassId) : Decidable (ClassFacts c) := by unfold ClassFacts; infer_instance

