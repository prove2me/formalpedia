variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
variable (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)

private theorem prod_stdRootNumberAt_twist_eq_inducedE3_pow_mul'
    (hdeg : Module.finrank ℚ K = 3) (v : HeightOneSpectrum (𝓞 ℚ))
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, v.asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓) (hμu : IsUnitaryChar (𝓞 K) K μ)
    (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (a : ℕ) (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∏ᶠ 𝔓 ∈ primeFibre ℚ K v, stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      inducedE3 ℚ (inducedCoeff K μ) v ^ a * stdRootNumberAt ℚ v (localChar χ v) ^ 3 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  rw [finprod_mem_eq_finite_toFinset_prod _ (FibreDegree.primeFibre_finite K v)]
  exact prod_stdRootNumberAt_twist_eq_inducedE3_pow_mul K μ χ hdeg v he hμ hμu hχu a ha

private theorem finsum_inertiaDeg_mul_pinnedExp_twist_eq' (hdeg : Module.finrank ℚ K = 3) (v : HeightOneSpectrum (𝓞 ℚ))
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, v.asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓) (a : ℕ) (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∑ᶠ 𝔓 ∈ primeFibre ℚ K v,
        (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      3 * a := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  exact finsum_inertiaDeg_mul_pinnedExp_twist_eq K μ χ hdeg v he hμ a ha

private theorem prod_stdRootNumberAt_twist_of_not_isBadPlace (hdeg : Module.finrank ℚ K = 3)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ¬ IsBadPlace K μ v) (hμu : IsUnitaryChar (𝓞 K) K μ)
    (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ) (a : ℕ) (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∏ᶠ 𝔓 ∈ primeFibre ℚ K v, stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      inducedE3 ℚ (inducedCoeff K μ) v ^ a * stdRootNumberAt ℚ v (localChar χ v) ^ 3 :=
  prod_stdRootNumberAt_twist_eq_inducedE3_pow_mul' K μ χ hdeg v
    (BadPlaceBridges.ramificationIdx_eq_one_of_not_isBadPlace K μ v hv)
    (BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hv) hμu hχu a ha

private theorem finsum_inertiaDeg_mul_pinnedExp_twist_of_not_isBadPlace (hdeg : Module.finrank ℚ K = 3)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ¬ IsBadPlace K μ v) (a : ℕ)
    (ha : HasConductorExponentAt ℚ v (localChar χ v) a) :
    ∑ᶠ 𝔓 ∈ primeFibre ℚ K v,
        (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      3 * a :=
  finsum_inertiaDeg_mul_pinnedExp_twist_eq' K μ χ hdeg v
    (BadPlaceBridges.ramificationIdx_eq_one_of_not_isBadPlace K μ v hv)
    (BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hv) a ha

end

