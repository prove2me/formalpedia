    SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X
  by_cases hb : ℓ ∈ badPrimes M s q'
  · rcases mem_badPrimes_cases M s q' hs ℓ hb with h | h | h
    ·
      have hℓs : ℓ ≠ ⟨s, hs⟩ := by
        intro e
        apply hsM
        have : (ℓ : ℕ) = s := congrArg Subtype.val e
        rw [← this]; exact h
      rw [mem_characterLattice_iff_pushforward X.degeneracyData.a]
      have hj : pushforward X.degeneracyData.a ((adjE M s q' A X ℓ).mulVec x) =
          jointDelta X.degeneracyData 0 ((adjE M s q' A X ℓ).mulVecLin x) := rfl
      rw [hj, eqvAdj M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hℓs 0 x, Matrix.mulVecLin_apply]
      refine degAdjV M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ _ ?_
      exact (mem_characterLattice_iff_pushforward X.degeneracyData.a x).1 hx
    · have hℓ : ℓ = ⟨q', Fact.out⟩ := Subtype.ext h
      subst hℓ
      obtain ⟨σ, τ, hE, -, -⟩ := exists_perm_char M s q' hs hq5 hsq' hq'M hsM A X hPD
      rw [adjE_char M s q' hs hq5 hsq' hq'M hsM A X hPD _ rfl, hE]
