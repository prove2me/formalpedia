section FiniteField

variable (k : Type) [Field k] [TopologicalSpace k] [DiscreteTopology k]

/-- `k⟦X⟧` is complete for its maximal ideal `(X)`. -/
instance instIsAdicCompletePowerSeriesMaximalIdeal_tests : IsAdicComplete (maximalIdeal k⟦X⟧) k⟦X⟧ := by
  rw [PowerSeries.maximalIdeal_eq_span_X]; infer_instance

/-- The residue field of `k⟦X⟧` is `k`, hence finite when `k` is. -/
instance instFiniteResidueFieldPowerSeries_tests [Finite k] : Finite (ResidueField k⟦X⟧) :=
  .of_equiv k (residueFieldOfPowerSeries (k := k)).symm.toEquiv

/-- Tychonoff: `k⟦X⟧ = k^ℕ` is compact for finite discrete `k`. -/
instance instCompactSpacePowerSeriesOfFinite_tests [Finite k] : CompactSpace k⟦X⟧ := inferInstanceAs (CompactSpace ((Unit →₀ ℕ) → k))

/-- A countable product of finite discrete spaces is second countable. -/
instance instSecondCountableTopologyPowerSeriesOfFinite_tests [Finite k] : SecondCountableTopology k⟦X⟧ :=
  inferInstanceAs (SecondCountableTopology ((Unit →₀ ℕ) → k))

/-- The Borel σ-algebra on `k⟦X⟧`. -/
instance instMeasurableSpacePowerSeries_tests : MeasurableSpace k⟦X⟧ := borel _

/-- The Borel σ-algebra makes `k⟦X⟧` a Borel space. -/
instance instBorelSpacePowerSeries_tests : BorelSpace k⟦X⟧ := ⟨rfl⟩

end FiniteField

