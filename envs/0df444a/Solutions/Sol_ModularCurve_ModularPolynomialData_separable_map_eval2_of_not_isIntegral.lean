theorem Polynomial.isCoprime_of_isCoprime_map_of_field {K L : Type*} [Field K] [Field L]
    (ι : K →+* L) {p q : K[X]} (h : IsCoprime (p.map ι) (q.map ι)) :
    IsCoprime p q := by
  classical
  rw [← EuclideanDomain.gcd_isUnit_iff] at h ⊢
  have hdvd : (EuclideanDomain.gcd p q).map ι ∣ EuclideanDomain.gcd (p.map ι) (q.map ι) :=
    EuclideanDomain.dvd_gcd
      (Polynomial.map_dvd ι (EuclideanDomain.gcd_dvd_left p q))
      (Polynomial.map_dvd ι (EuclideanDomain.gcd_dvd_right p q))
  have huL : IsUnit ((EuclideanDomain.gcd p q).map ι) := isUnit_of_dvd_unit hdvd h
  have hdeg : (EuclideanDomain.gcd p q).degree = 0 := by
    have hL := Polynomial.degree_eq_zero_of_isUnit huL
    rwa [Polynomial.degree_map_eq_of_injective ι.injective] at hL
  exact Polynomial.isUnit_iff_degree_eq_zero.mpr hdeg

theorem solution
    {F : Type*} [Field F] [CharZero F] (p : ℕ) [Fact p.Prime]
    (data : ModularPolynomialData p) (jv : F) (hjv : ¬ _root_.IsIntegral ℤ jv) :
    (data.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom F) jv)).Separable := by
  classical
  let L := AlgebraicClosure F
  let ι : F →+* L := algebraMap F L
  have hι : Function.Injective ι := (algebraMap F L).injective
  haveI : CharZero L := (RingHom.charZero_iff hι).mp inferInstance
  have hjv' : ¬ _root_.IsIntegral ℤ (ι jv) := fun h ↦ hjv ((isIntegral_algebraMap_iff hι).mp h)
  have key := ModularCurve.ModularPolynomialData.separable_map_eval2_of_not_isIntegral_of_isAlgClosed
                (F := L) p data (ι jv) hjv'
  have hcomp : (Polynomial.eval₂RingHom (Int.castRingHom L) (ι jv))
             = ι.comp (Polynomial.eval₂RingHom (Int.castRingHom F) jv) := by
    apply Polynomial.ringHom_ext
    · intro a
      show Polynomial.eval₂ (Int.castRingHom L) (ι jv) (C a)
         = ι (Polynomial.eval₂ (Int.castRingHom F) jv (C a))
      simp only [Polynomial.eval₂_C, Int.coe_castRingHom, map_intCast]
    · show Polynomial.eval₂ (Int.castRingHom L) (ι jv) X
         = ι (Polynomial.eval₂ (Int.castRingHom F) jv X)
      simp only [Polynomial.eval₂_X]
  have hmap : (data.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom L) (ι jv)))
            = (data.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom F) jv)).map ι := by
    rw [hcomp, ← Polynomial.map_map]
  rw [hmap] at key
  rw [Polynomial.separable_def] at key ⊢
  rw [Polynomial.derivative_map] at key
  exact Polynomial.isCoprime_of_isCoprime_map_of_field ι key

