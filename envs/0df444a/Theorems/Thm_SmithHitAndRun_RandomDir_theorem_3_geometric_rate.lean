-- title:
--   Theorem 3 — $|P(X_m\in A\mid X_0=x)-\lambda(A)|<(1-\gamma/n2^{n-1})^{m-1}$ for the Random Directions Algorithm
-- statement:
--   Let $n\ge2$ and let $S\subseteq\mathbb R^n$ be an open bounded region. Let $X_0,X_1,X_2,\dots$ be the Markov chain generated by the Random Directions Algorithm over $S$ (from the current point, choose a direction uniformly on the unit sphere and move to a uniformly distributed point of the line set of $S$ through the current point in that direction), and let $\lambda(A)=V(A)/V(S)$ be the uniform distribution over $S$. Let $\gamma$ be the ratio of the $n$-dimensional content of $S$ to the $n$-dimensional content of the smallest ball containing $S$. Then for every starting point $x\in S$, every measurable $A\subseteq S$ and every $m\ge1$,
--   $$\bigl|P(X_m\in A\mid X_0=x)-\lambda(A)\bigr|<\Bigl(1-\frac{\gamma}{n\,2^{n-1}}\Bigr)^{m-1}.$$
--
--   The theorem gives an explicit, starting-point-free geometric rate of convergence of hit-and-run to the uniform distribution, depending on $S$ only through its dimension and the fraction $\gamma$ of its smallest enclosing ball it fills.
--
--   **Formalization Note** The hypothesis $n\ge2$ is added: for $n=1$ the printed strict inequality fails (for an interval, $X_1$ is already uniform and $\gamma=1$, so both sides vanish for $m\ge2$), while the non-strict version holds. Boundedness of $S$ is the paper's standing assumption ("bounded regions"). The exponent $m-1$ is a natural-number subtraction and $m\ge1$ is assumed. $P(X_m\in A\mid X_0=x)$ is the $m$-step kernel `MarkovChainCLT.iterKernel (rdKernel S) m x A`.
-- source:
--   Smith, Efficient Monte Carlo Procedures for Generating Points Uniformly Distributed over Bounded Regions, Oper. Res. 32(6) (1984), p. 1304, Theorem 3

import Mathlib
import Definitions.Def_MarkovIterKernel
import Definitions.Def_SmithHitAndRun_RandomDir_RandomDirectionsKernel
import Definitions.Def_SmithHitAndRun_RandomDir_UniformLaw
import Definitions.Def_SmithHitAndRun_RandomDir_RateConstants

open MeasureTheory ProbabilityTheory

namespace SmithHitAndRun.RandomDir

/-- Smith 1984, p. 1304, Theorem 3: let `X_0, X_1, …` be the Markov chain generated by the Random
Directions Algorithm over an open bounded region `S ⊆ ℝⁿ`, `n ≥ 2`. Then for every `x ∈ S`, every
measurable `A ⊆ S` and every `m ≥ 1`,
`|P(X_m ∈ A | X_0 = x) − λ(A)| < (1 − γ / (n 2^{n−1}))^{m−1}`, where `γ` is the ratio of the
`n`-dimensional content of `S` to that of the smallest ball containing `S`. -/
theorem theorem_3_geometric_rate {n : ℕ} (hn : 2 ≤ n)
    (S : Set (EuclideanSpace ℝ (Fin n))) (hSo : IsOpen S) (hSb : Bornology.IsBounded S)
    (x : EuclideanSpace ℝ (Fin n)) (hx : x ∈ S)
    (A : Set (EuclideanSpace ℝ (Fin n))) (hA : MeasurableSet A) (hAS : A ⊆ S)
    (m : ℕ) (hm : 1 ≤ m) :
    |(MarkovChainCLT.iterKernel (rdKernel S) m x A).toReal - (unif S A).toReal| <
      (1 - gammaRatio S / ((n : ℝ) * 2 ^ (n - 1))) ^ (m - 1) := by sorry

end SmithHitAndRun.RandomDir
