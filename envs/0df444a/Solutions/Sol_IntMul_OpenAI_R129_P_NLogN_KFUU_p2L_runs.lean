namespace IRuns

theorem shl {s : IState S} {i j : Fin S} {a : ℤ} {m : ℕ} {Li Lj : List Item} (hij : i ≠ j)
    (hi : s.G i = .int a :: Li) (hj : s.G j = .int (2 ^ m) :: Lj) :
    IRuns I iprog (.op (.shl i j)) s (s.upd i (.int (a * 2 ^ m) :: Li)) (shlCost m) :=
  NLogN.IRuns.op (.shl hij hi hj)

end IRuns

