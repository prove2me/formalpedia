theorem solution
    (p : ℕ) [Fact p.Prime] :
    ∀ (m M : ℕ) (x₀ : JZero p), x₀ ∈ eisensteinTorsionBar p 2 M → 2 ^ m • x₀ = 0 →
      ∃ x : TateModule 2 (JZero p),
        (∀ n : ℕ, ∃ M' : ℕ, (x : ℕ → JZero p) n ∈ eisensteinTorsionBar p 2 M') ∧
        (x : ℕ → JZero p) m = x₀ := by

  intro m M x₀ hx₀ h2m
  classical

  let V : Type := Σ' (M' : ℕ) (y : JZero p), y ∈ eisensteinTorsionBar p 2 M'
  have hdiv := ModularCurve.exists_two_nsmul_eq_of_mem_eisensteinTorsionBar_two p
  let half : V → V := fun v =>
    ⟨(hdiv v.1 v.2.1 v.2.2).choose, (hdiv v.1 v.2.1 v.2.2).choose_spec.choose,
      (hdiv v.1 v.2.1 v.2.2).choose_spec.choose_spec.1⟩
  have hhalf : ∀ v : V, 2 • (half v).2.1 = v.2.1 := fun v =>
    (hdiv v.1 v.2.1 v.2.2).choose_spec.choose_spec.2

  let chain : ℕ → V := fun k => Nat.rec (⟨M, x₀, hx₀⟩ : V) (fun _ v => half v) k
  have chain_zero : chain 0 = ⟨M, x₀, hx₀⟩ := rfl
  have chain_succ : ∀ k, chain (k + 1) = half (chain k) := fun _ => rfl
  have hstep : ∀ k, 2 • (chain (k + 1)).2.1 = (chain k).2.1 := fun k => by
    rw [chain_succ]
    exact hhalf _
  have hpow : ∀ k, 2 ^ k • (chain k).2.1 = x₀ := by
    intro k
    induction k with
    | zero => rw [pow_zero, one_nsmul, chain_zero]
    | succ k ih => rw [pow_succ', mul_nsmul, hstep, ih]

  let seq : ℕ → JZero p := fun n => if n ≤ m then 2 ^ (m - n) • x₀ else (chain (n - m)).2.1
  have seq_le : ∀ n, n ≤ m → seq n = 2 ^ (m - n) • x₀ := fun n hn => if_pos hn
  have seq_gt : ∀ n, m < n → seq n = (chain (n - m)).2.1 := fun n hn => if_neg (not_le.mpr hn)
  have seq_m : seq m = x₀ := by rw [seq_le m le_rfl, Nat.sub_self, pow_zero, one_nsmul]

  have seq_gt' : ∀ k, seq (m + k + 1) = (chain (k + 1)).2.1 := fun k => by
    rw [seq_gt _ (by omega)]
    have hk : m + k + 1 - m = k + 1 := by omega
    rw [hk]
  have htors : ∀ n, 2 ^ n • seq n = 0 := by
    intro n
    rcases le_or_gt n m with hn | hn
    · rw [seq_le n hn, ← mul_nsmul, ← pow_add, Nat.sub_add_cancel hn, h2m]
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hn
      rw [seq_gt' k, show m + k + 1 = (k + 1) + m by omega, pow_add, mul_nsmul, hpow, h2m]
  have hcompat : ∀ n, 2 • seq (n + 1) = seq n := by
    intro n
    rcases lt_or_ge n m with hn | hn
    ·
      rw [seq_le (n + 1) hn, seq_le n hn.le, ← mul_nsmul, ← pow_succ,
        show m - (n + 1) + 1 = m - n by omega]
    · rcases hn.eq_or_lt with rfl | hlt
      ·
        show 2 • seq (m + 0 + 1) = seq m
        calc 2 • seq (m + 0 + 1) = 2 • (chain (0 + 1)).2.1 := by rw [seq_gt' 0]
          _ = (chain 0).2.1 := hstep 0
          _ = x₀ := by rw [chain_zero]
          _ = seq m := seq_m.symm
      · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_lt hlt
        show 2 • seq (m + (k + 1) + 1) = seq (m + k + 1)
        calc 2 • seq (m + (k + 1) + 1) = 2 • (chain (k + 1 + 1)).2.1 := by rw [seq_gt' (k + 1)]
          _ = (chain (k + 1)).2.1 := hstep (k + 1)
          _ = seq (m + k + 1) := (seq_gt' k).symm
  refine ⟨⟨seq, fun n => ⟨?_, ?_⟩⟩, ?_, ?_⟩
  · rw [natCast_zsmul]
    exact htors n
  · rw [natCast_zsmul]
    exact hcompat n
  · intro n
    show ∃ M', seq n ∈ eisensteinTorsionBar p 2 M'
    rcases le_or_gt n m with hn | hn
    · exact ⟨M, by rw [seq_le n hn]; exact AddSubgroup.nsmul_mem _ hx₀ _⟩
    · exact ⟨(chain (n - m)).1, by rw [seq_gt n hn]; exact (chain (n - m)).2.2⟩
  · exact seq_m

end S_ModularCurve_exists_tateModule_apply_eq_of_mem_eisensteinTorsionBar_two
