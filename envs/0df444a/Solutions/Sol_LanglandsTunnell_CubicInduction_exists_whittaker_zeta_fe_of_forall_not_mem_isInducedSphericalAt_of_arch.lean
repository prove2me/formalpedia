variable {Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ} {T : Finset (HeightOneSpectrum (𝓞 ℚ))}

section

variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ)
  {ψv : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ} {g : AdelicGL 3 (𝓞 ℚ) ℚ}

private theorem valued_unitsAt (v : HeightOneSpectrum (𝓞 ℚ)) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    Valued.v ((unitsAt v a : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) =
      WithZero.exp (-(NumberField.Idele.ord ℚ v a)) := by
  rw [unitsAt_val]
  exact NumberField.Idele.valued_snd_eq_exp_neg_ord ℚ v a

private theorem isIntegralUnit_unitsAt_of_mem {S : Set (HeightOneSpectrum (𝓞 ℚ))} {a : (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (ha : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ S) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ S) :
    IsIntegralUnit v (unitsAt v a) := by
  rw [NumberField.AdeleRing.mem_unitIdelesOutside_iff,
    IsDedekindDomain.FiniteAdeleRing.mem_unitIdelesOutside_iff] at ha
  exact ha v hv

private theorem unitsAt_partAt_of_not_mem (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) {v : HeightOneSpectrum (𝓞 ℚ)}
    (hv : v ∉ T) : unitsAt v (NumberField.Idele.partAt ℚ T a) = 1 :=
  Units.ext (by simp only [unitsAt_val, NumberField.Idele.partAt_snd_of_not_mem ℚ T a hv, Units.val_one])

private theorem unitsAt_partAt_of_mem (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∈ T) :
    unitsAt v (NumberField.Idele.partAt ℚ T a) = unitsAt v a :=
  Units.ext (by simp only [unitsAt_val, NumberField.Idele.partAt_snd_of_mem ℚ T a hv])

private theorem unitsAtInfinity_partAt (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    unitsAtInfinity (NumberField.Idele.partAt ℚ T a) = unitsAtInfinity a :=
  Units.ext (by simp only [unitsAtInfinity_val, NumberField.Idele.partAt_fst ℚ T a])

private theorem iotaGL_diagUnitGL2_one (v : HeightOneSpectrum (𝓞 ℚ)) :
    iotaGL (diagUnitGL2 (1 : (v.adicCompletion ℚ)ˣ)) = 1 :=
  map_one (iotaGL.comp diagHom)

variable (hone : ∀ v, v ∉ T → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)
  (hg : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v)

include hg in

private theorem apply_iotaGL_diagUnitGL2_unitsAt_mul_eq_torusValue
    (hwhit : ∀ v, v ∉ T → IsGL3PsiWhittakerFn (ψv v) (Wloc v))
    (hinv : ∀ v, v ∉ T → IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (Wloc v))
    (hlevel : ∀ v, v ∉ T → ∀ (t : (v.adicCompletion ℚ)ˣ) (m : ℤ), m < 0 →
      Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m) →
        ∃ y : v.adicCompletion ℚ, Valued.v (((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * y) ≤ 1 ∧
          ψv v y ≠ 1)
    {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ T) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    Wloc v (iotaGL (diagUnitGL2 (unitsAt v a)) * componentAt3 (𝓞 ℚ) ℚ v g) =
      torusValue (Wloc v) (NumberField.Idele.ord ℚ v a) :=
  apply_iotaGL_diagUnitGL2_mul_eq_torusValue (hwhit v hv) (hinv v hv) (hlevel v hv) (valued_unitsAt v a) (hg v hv)

include hg in

private theorem componentAt3_iotaGL_diagUnitGL2_mul_mem {S : Set (HeightOneSpectrum (𝓞 ℚ))}
    (hTS : (T : Set (HeightOneSpectrum (𝓞 ℚ))) ⊆ S) {a : (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (ha : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ S) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ S) :
    componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 a) * g) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  simp only [componentAt3_iotaGL_diagUnitGL2_mul]
  exact mul_mem (iotaGL_diagUnitGL2_mem_localMaximalCompact3 v (isIntegralUnit_unitsAt_of_mem ha hv))
    (hg v fun hvT => hv (hTS hvT))

include hg in

private theorem componentAt3_iotaGL_diagUnitGL2_partAt_mul_mem (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∉ T) :
    componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g) ∈
      localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  simp only [componentAt3_iotaGL_diagUnitGL2_mul, unitsAt_partAt_of_not_mem a hv, iotaGL_diagUnitGL2_one, one_mul]
  exact hg v hv

include hone hg in

private theorem adelicProduct_iotaGL_diagUnitGL2_mul_eq
    (hinv : ∀ v, v ∉ T → IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (Wloc v))
    (hwhit : ∀ v, v ∉ T → IsGL3PsiWhittakerFn (ψv v) (Wloc v))
    (hlevel : ∀ v, v ∉ T → ∀ (t : (v.adicCompletion ℚ)ˣ) (m : ℤ), m < 0 →
      Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m) →
        ∃ y : v.adicCompletion ℚ, Valued.v (((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * y) ≤ 1 ∧
          ψv v y ≠ 1)
    (L : List (HeightOneSpectrum (𝓞 ℚ))) (hLT : ∀ v ∈ L, v ∉ T) (hL : L.Nodup) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (ha : a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T ∪ {v | v ∈ L})) :
    adelicProduct Warch Wloc (iotaGL (diagUnitGL2 a) * g) =
      adelicProduct Warch Wloc (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g) *
        (L.map fun v => torusValue (Wloc v) (NumberField.Idele.ord ℚ v a)).prod := by
  classical
  have hTS : (T : Set (HeightOneSpectrum (𝓞 ℚ))) ⊆ ↑T ∪ {v | v ∈ L} := Set.subset_union_left
  have hsub : T ⊆ T ∪ L.toFinset := Finset.subset_union_left
  have hout : ∀ v, v ∉ T ∪ L.toFinset → v ∉ (↑T ∪ {v | v ∈ L} : Set (HeightOneSpectrum (𝓞 ℚ))) := by
    intro v hv hv'
    rcases hv' with hvT | hvL
    · exact hv (Finset.mem_union_left _ hvT)
    · exact hv (Finset.mem_union_right _ (List.mem_toFinset.mpr hvL))
  have hnotT : ∀ v, v ∉ T ∪ L.toFinset → v ∉ T := fun v hv hvT => hv (Finset.mem_union_left _ hvT)
  have hdisj : Disjoint T L.toFinset :=
    Finset.disjoint_left.mpr fun v hvT hvL => hLT v (List.mem_toFinset.mp hvL) hvT

  have h₁ := adelicProduct_eq_prod Warch hone (iotaGL (diagUnitGL2 a) * g) (T ∪ L.toFinset) hsub
    fun v hv => componentAt3_iotaGL_diagUnitGL2_mul_mem hg hTS ha (hout v hv)
  have h₂ := adelicProduct_eq_prod Warch hone (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g)
    (T ∪ L.toFinset) hsub fun v hv => componentAt3_iotaGL_diagUnitGL2_partAt_mul_mem hg a (hnotT v hv)

  have harch : archComponent3 (𝓞 ℚ) ℚ (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g) =
      archComponent3 (𝓞 ℚ) ℚ (iotaGL (diagUnitGL2 a) * g) := by
    simp only [archComponent3_iotaGL_diagUnitGL2_mul, unitsAtInfinity_partAt]
  have hT : ∏ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g)) =
      ∏ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 a) * g)) :=
    Finset.prod_congr rfl fun v hv => by simp only [componentAt3_iotaGL_diagUnitGL2_mul, unitsAt_partAt_of_mem a hv]
  have hLleft : L.map (fun v => Wloc v (componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 a) * g))) =
      L.map fun v => torusValue (Wloc v) (NumberField.Idele.ord ℚ v a) :=
    List.map_congr_left fun v hv => by
      simp only [componentAt3_iotaGL_diagUnitGL2_mul]
      exact apply_iotaGL_diagUnitGL2_unitsAt_mul_eq_torusValue hg hwhit hinv hlevel (hLT v hv) a
  have hLright : (L.map fun v =>
      Wloc v (componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 (NumberField.Idele.partAt ℚ T a)) * g))).prod = 1 :=
    List.prod_eq_one fun x hx => by
      obtain ⟨v, hv, rfl⟩ := List.mem_map.mp hx
      simp only [componentAt3_iotaGL_diagUnitGL2_mul, unitsAt_partAt_of_not_mem a (hLT v hv), iotaGL_diagUnitGL2_one,
        one_mul]
      exact hone v (hLT v hv) _ (hg v (hLT v hv))
  simp only [h₁, h₂, Finset.prod_union hdisj, List.prod_toFinset _ hL, harch, hT, hLleft, hLright]
  ring

end
