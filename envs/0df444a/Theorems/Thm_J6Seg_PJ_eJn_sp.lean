theorem J6Seg.PJ.eJn_sp (kA kC wA wC : ℕ) {k pre post s t p α d W N B : ℕ} {Zn : Fin HS}
    (hZ : Zn ∉ rg) (hZ5 : Zn.val < 56) (hZT : Zn ≠ sTmp) (hZC : Zn ≠ cRdC)
    (hZv : Zn.val = 49 ∨ Zn.val = 55)
    (oN : Fin 19 → Fin HS) (hinj : Injective oN) (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC) (hZo : ∀ i, oN i ≠ Zn)
    (hW : parBig kA kC wA wC k pre post s t p α d < 2 ^ W)
    (hNW : N < 2 ^ W) (hW4 : 4 ≤ W) (hN5 : 5 ≤ N)
    (hs : 0 < s) (hws : wF d ≤ s) (hQW : segPF p d s ≤ W)
    (hsN : s ≤ N) (hlN : lamP d ≤ N) (hNMN : lamP d * (2 * wF d + 1) ≤ N)
    (hmm : (LJ s t (lamP d) (wF d)).length * (LJ s t (lamP d) (wF d)).length ≤ N)
    (hmc : (LJ s t (lamP d) (wF d)).length * (2 * wF d + 2) ≤ N)
    (bss : s * s ≤ 2 ^ W) (hlw : lamP d + wF d ≤ 2 ^ W)
    (hW8 : 8 * ((LJ s t (lamP d) (wF d)).length + 1) ^ 2 ≤ 2 ^ W)
    (hJB : JB (segPF p d s) (p / 7) W s t α (lamP d) (wF d))
    (hMb : ∀ q ≤ (LJ s t (lamP d) (wF d)).length, ∀ i < (LJ s t (lamP d) (wF d)).length,
      ∀ k < (LJ s t (lamP d) (wF d)).length,
      |Mseq (segPF p d s) (bandS (lamP d + wF d) (s - lamP d - wF d)) (LJ s t (lamP d) (wF d))
        (capI (segPF p d s) (mkTables (segPF p d s) (p / 7) s t α) (mkBlocks s t (lamP d) (wF d)))
        q i k| ≤ 2 ^ W)
    (hbl : (JK.jBody (kA * segPF p d s + kC) (JK.jFs (segPF p d s) (p / 7) s t (lamP d) (wF d) α)
      (JK.jBs (segPF p d s) (p / 7) s t (lamP d) (wF d) α)
      (JK.jCc (segPF p d s) (p / 7) s t (lamP d) (wF d) α (wF d))).length ≤ 2 ^ W)
    (hvB : ∀ a ∈ cVals (wA * segPF p d s + wC) (Nat.clog 2 (LJ s t (lamP d) (wF d)).length) pre 1
      post, zsz a ≤ B)
    (hlB : zsz ((tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
      (kA * segPF p d s + kC)) 1).length : ℤ) ≤ B)
    (hTB : Bnd B (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
      (kA * segPF p d s + kC)) 1))
    (s0 : IState HS) :
    Sp (eJn kA kC wA wC Zn oN) (encK s0 (F0 Zn (dsc k pre post s t p α d)))
      (encK s0 (extend oN (kerRegs (wA * segPF p d s + wC) (wA * segPF p d s + wC)
        (Nat.clog 2 (LJ s t (lamP d) (wF d)).length) pre 1 post
        (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
          (kA * segPF p d s + kC)) 1))
        (F0 Zn (dsc k pre post s t p α d))))
      (cEJn kA kC wA wC W N d s p (LJ s t (lamP d) (wF d)).length B
        (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
          (kA * segPF p d s + kC)) 1).length) := by sorry
