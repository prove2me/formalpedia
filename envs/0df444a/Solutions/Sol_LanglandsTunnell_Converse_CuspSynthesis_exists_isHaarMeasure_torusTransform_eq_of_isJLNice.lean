open NumberField.InfinitePlace.Completion

variable {K : Type} [Field K] [NumberField K]
variable {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}
variable {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ} {ω : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}

private theorem t0872 (d : JLData K S epsS ω) (w : InfinitePlace K)
    (hw : w.IsReal) (g : AdelicGL2 (𝓞 K) K) :
    Real.sqrt |(realComponent w hw (globalPoints (𝓞 K) K (weylA d) * g)).det|
      = Real.sqrt |ringEquivRealOfIsReal hw (algebraMap K w.Completion (d.A : K))|
          * Real.sqrt |(realComponent w hw g).det| := by
  rw [t0853 d w hw g, Matrix.det_mul, ArchUnfold.t0401, one_mul, t0211,
    abs_mul, abs_neg, Real.sqrt_mul (abs_nonneg _)]

private theorem t0873 (d : JLData K S epsS ω) (w : InfinitePlace K)
    (hw : w.IsComplex) (g : AdelicGL2 (𝓞 K) K) :
    ‖(complexComponent w hw (globalPoints (𝓞 K) K (weylA d) * g)).det‖
      = ‖ringEquivComplexOfIsComplex hw (algebraMap K w.Completion (d.A : K))‖ * ‖(complexComponent w hw g).det‖ := by
  have hweyl : ArchC.weyl.det = 1 := by simp [ArchC.weyl, Matrix.det_fin_two_of]
  rw [t0854 d w hw g, Matrix.det_mul, hweyl, one_mul, t0212, norm_mul,
    norm_neg]

private theorem t0874 (d : JLData K S epsS ω) (g₀ : AdelicGL2 (𝓞 K) K) :
    d086 (d087 (globalPoints (𝓞 K) K (weylA d) * g₀))
      = ((∏ v : {w : InfinitePlace K // w.IsReal},
            ((Real.sqrt |ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))| : ℝ) : ℂ)⁻¹)
            * ∏ v : {w : InfinitePlace K // w.IsComplex},
                ((‖ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))‖ : ℝ) : ℂ)⁻¹)
          * d086 (d087 g₀) := by
  simp only [d087, map_one, one_mul]
  unfold d086
  simp only [t0872, t0873,
    Complex.ofReal_mul, _root_.mul_inv, Finset.prod_mul_distrib]
  ring

