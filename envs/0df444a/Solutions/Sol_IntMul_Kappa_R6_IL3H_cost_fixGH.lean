-- Source module: Solutions.KFWCost2
/-!
# KFW: cost bounds of the local steps, the wrapper and the leaf

With `P = (W n) · Yu r Z H` (`n` records per role, `W` roles):

* `cWrapQ_Y`: the role wrapper adds `≤ 10^12 (W + 2) P`;
* `cost_gate`, `cost_perm`, `cost_phase`, `cost_fixG`: every local step costs `≤ Mloc P`;
* `cost_leaf`: the leaf costs `≤ 10^12 n Yu`;
* `costL_win`: a windowed sum of step costs.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- A windowed sum of step costs. -/
theorem costL_win {α : Type*} (cost : α → ℕ → ℕ) (dw : α → ℕ) (b : α → ℕ) (H : ℕ) :
    ∀ l : List α, (∀ a ∈ l, ∀ x, x + dw a ≤ H → cost a x ≤ b a) →
      ∀ x, x + (l.map dw).sum ≤ H → costL cost dw l x ≤ (l.map b).sum + 1
  | [], _, x, _ => by simp [costL]
  | a :: l, h, x, hx => by
    simp only [costL, List.map_cons, List.sum_cons] at hx ⊢
    have h1 := h a List.mem_cons_self x (by omega)
    have h2 := costL_win cost dw b H l (fun c hc => h c (List.mem_cons_of_mem _ hc)) (x + dw a)
      (by omega)
    omega

end NLogN.KFW

end

