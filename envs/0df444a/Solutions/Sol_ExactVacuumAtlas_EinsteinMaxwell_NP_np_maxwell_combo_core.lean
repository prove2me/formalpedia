-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) {f : Pt 4 → ℂ}
    (hf : ContDiffOn ℝ ∞ f U) :
    (fdir E 2 (fun z => fdir E 0 f z - 2 * npRho g gi E Θ z * f z) x
        + (npPiB g gi E Θ x - npBeta g gi E Θ x - npAlphaB g gi E Θ x - 2 * npTau g gi E Θ x)
          * (fdir E 0 f x - 2 * npRho g gi E Θ x * f x))
      - (fdir E 0 (fun z => fdir E 2 f z - 2 * npTau g gi E Θ z * f z) x
        + (npEpsB g gi E Θ x - npEps g gi E Θ x - npRhoB g gi E Θ x - 2 * npRho g gi E Θ x)
          * (fdir E 2 f x - 2 * npTau g gi E Θ x * f x))
      = 2 * f x * (2 * psi1 g gi E x + fdir E 1 (omL g gi E Θ 0 0 2) x - fdir E 3 (omL g gi E Θ 0 2 2) x
          + (npTauB g gi E Θ x + npPi g gi E Θ x + 3 * npAlpha g gi E Θ x - npBetaB g gi E Θ x)
            * npSigma g gi E Θ x
          - (3 * npGamma g gi E Θ x + npGammaB g gi E Θ x + npMu g gi E Θ x - npMuB g gi E Θ x)
            * npKappa g gi E Θ x)
        + npKappa g gi E Θ x * fdir E 1 f x - npSigma g gi E Θ x * fdir E 3 f x := by
  have hF := hN.toFrameData
  have hrho : ContDiffOn ℝ ∞ (fun z => npRho g gi E Θ z) U := contDiffOn_omL hN 0 3 2
  have htau : ContDiffOn ℝ ∞ (fun z => npTau g gi E Θ z) U := contDiffOn_omL hN 0 1 2
  rw [fdir_sub_two_mul hN hx (hF.contDiffOn_fdir 0 hf) hrho hf 2,
    fdir_sub_two_mul hN hx (hF.contDiffOn_fdir 2 hf) htau hf 0]
  have hc := np_comm_ml hN hx hf
  have hRc := np_ricci_c hN hx
  have hRk := np_ricci_k hN hx
  have e1 : fdir E 2 (fun z => npRho g gi E Θ z) x = fdir E 2 (omL g gi E Θ 0 3 2) x := rfl
  have e2 : fdir E 0 (fun z => npTau g gi E Θ z) x = fdir E 0 (omL g gi E Θ 0 1 2) x := rfl
  rw [e1, e2]
  linear_combination hc + 2 * f x * (hRc - hRk)
