open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.SmoothExt
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII13FiniteBranchSpec
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.FiniteRegularity13
set_option autoImplicit false
variable {ε h Q J : ℝ} {F b A : ℝ → ℝ}
theorem solution (hε : 0 < ε)
    (cF : ContDiffOn ℝ 6 F (Set.Ioo (-ε) ε)) (cb : ContDiffOn ℝ 6 b (Set.Ioo (-ε) ε))
    (cA : ContDiffOn ℝ 6 A (Set.Ioo (-ε) ε))
    (hPM : ∀ x ∈ Set.Ioo 0 ε, realPM h Q J F b A x = 0)
    (hPA : ∀ x ∈ Set.Ioo 0 ε, realPA h Q J F b A x = 0)
    (hPC : ∀ x ∈ Set.Ioo 0 ε, realPC h Q J F b A x = 0) :
    SelectedRows h Q J (jet4 F) (jet4 b) (jet4 A) := by
  have h0 := zero_mem_Ioo6 hε
  have mM := matchesC4_realPM (contDiffAt6_of_Ioo cF h0) (contDiffAt6_of_Ioo cb h0)
    (contDiffAt6_of_Ioo cA h0) h Q J
  have mA := matchesC4_realPA (contDiffAt6_of_Ioo cF h0) (contDiffAt6_of_Ioo cb h0)
    (contDiffAt6_of_Ioo cA h0) h Q J
  have mC := matchesC4_realPC (contDiffAt6_of_Ioo cF h0) (contDiffAt6_of_Ioo cb h0)
    (contDiffAt6_of_Ioo cA h0) h Q J
  exact ⟨Matches4C4.coeff_zero_of_right_zero mC hε hPC (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mM hε hPM (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mC hε hPC (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mA hε hPA (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mA hε hPA (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mM hε hPM (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mC hε hPC (by norm_num),
    Matches4C4.coeff_zero_of_right_zero mA hε hPA (by norm_num)⟩
