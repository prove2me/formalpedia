theorem cS_le (s t k : ℕ) (hk : k < t) : NLogN.Rsp.cS s t k ≤ s := by
  unfold NLogN.Rsp.cS
  have h1 : s * k ≤ s * (t - 1) := Nat.mul_le_mul_left s (by omega)
  have h2 : s * (t - 1) + s = s * t := by
    rw [← Nat.mul_succ]; congr 1; omega
  have : (s * k + t - 1) / t < s + 1 := by
    rw [Nat.div_lt_iff_lt_mul (by omega)]
    rw [Nat.add_mul, Nat.mul_comm s t] at *
    generalize s * k = A at *; generalize s * (t - 1) = B at *; generalize t * s = C at *
    omega
  omega

