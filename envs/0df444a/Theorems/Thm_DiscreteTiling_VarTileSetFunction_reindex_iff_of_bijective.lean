theorem DiscreteTiling.VarTileSetFunction.reindex_iff_of_bijective {f : VarTileSetFunction Y ps Prop H} {y : Y} {t : TileSet ps ιᵤ}
    {e : ιᵤ' → ιᵤ} (h : Bijective e) : f y (t.reindex e) ↔ f y t := by sorry
