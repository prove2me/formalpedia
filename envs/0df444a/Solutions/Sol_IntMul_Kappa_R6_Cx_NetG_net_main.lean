section
-- Source module: Solutions.R6CxNetScal
/-!
# The scalar effect of the local stage programs

Local ops `(dst, src, k)` act by `z_dst += (k/2) z_src` (`runL`). Generic facts: linearity,
commuting with linear maps, inverses (`negOps`), parallel blocks (`padd`), relabelling to global
roles (`runOps_map`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetScal

open NetSpec NetMask Finset

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

/-! ## Relabelling to global roles -/

variable {R : Type} [DecidableEq R]

theorem runOps_map (nl : ℕ) (ι : ℕ → R) (hinj : ∀ w < nl, ∀ w' < nl, ι w = ι w' → w = w') :
    ∀ (l : List (ℕ × ℕ × ℤ)) (Λ : R → Vt), (∀ o ∈ l, o.1 < nl ∧ o.2.1 < nl) →
      (∀ w < nl, runOps (l.map (toG ι)) Λ (ι w) = runL l (fun w => Λ (ι w)) w) ∧
      (∀ r, (∀ w < nl, ι w ≠ r) → runOps (l.map (toG ι)) Λ r = Λ r)
  | [], Λ, _ => ⟨fun _ _ => rfl, fun _ _ => rfl⟩
  | o :: l, Λ, h => by
    have h0 := h o List.mem_cons_self
    have e : (fun w => runOp Λ (toG ι o) (ι w)) = fun w => if w < nl then stepL (fun w => Λ (ι w)) o w
        else runOp Λ (toG ι o) (ι w) := by
      funext w
      split_ifs with hw
      · simp only [runOp, stepL, toG]
        by_cases e1 : w = o.1
        · subst e1; simp
        · rw [Function.update_of_ne (fun e => e1 (hinj w hw o.1 h0.1 e)), Function.update_of_ne e1]
      · rfl
    obtain ⟨k1, k2⟩ := runOps_map nl ι hinj l (runOp Λ (toG ι o)) fun o' h' => h o' (List.mem_cons_of_mem _ h')
    refine ⟨fun w hw => ?_, fun r hr => ?_⟩
    · show runOps (l.map (toG ι)) (runOp Λ (toG ι o)) (ι w) = runL l (stepL (fun w => Λ (ι w)) o) w
      rw [k1 w hw]
      -- the two states agree on all local wires `< nl` used by `l`
      have hag : ∀ w' < nl, runOp Λ (toG ι o) (ι w') = stepL (fun w => Λ (ι w)) o w' := fun w' hw' => by
        have := congrFun e w'; rw [if_pos hw'] at this; exact this
      exact runL_congr_lt nl l _ _ hag (fun o' h' => h o' (List.mem_cons_of_mem _ h')) w hw
    · show runOps (l.map (toG ι)) (runOp Λ (toG ι o)) r = Λ r
      rw [k2 r hr, runOp, toG, Function.update_of_ne (Ne.symm (hr _ h0.1))]
where
  runL_congr_lt (nl : ℕ) : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ Λ' : ℕ → Vt), (∀ w < nl, Λ w = Λ' w) →
      (∀ o ∈ l, o.1 < nl ∧ o.2.1 < nl) → ∀ w < nl, runL l Λ w = runL l Λ' w
    | [], _, _, h, _, w, hw => h w hw
    | o :: l, Λ, Λ', h, hl, w, hw => by
      have h0 := hl o List.mem_cons_self
      refine runL_congr_lt nl l _ _ (fun w' hw' => ?_) (fun o' h' => hl o' (List.mem_cons_of_mem _ h')) w hw
      simp only [stepL]
      by_cases e : w' = o.1
      · subst e; rw [Function.update_self, Function.update_self, h _ h0.1, h _ h0.2]
      · rw [Function.update_of_ne e, Function.update_of_ne e, h w' hw']

end IntMul.Kappa.R6.Cx.NetScal

end

