  have hT1 : (1 : ℝ) ≤ Q.T := by have : 1 ≤ Q.T := Nat.one_le_two_pow; exact_mod_cast this
  have hC : (0 : ℝ) ≤ Cfm := by positivity
  have k' : (cBody (BN6 Q) (BN6 Q) (Q.p / 6) (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length Q.p Q.h D
      (σ6 Q) (Q.sB D) (Q.tB D) : ℝ) ≤ 10 ^ 30 * (((Q.T : ℝ) + 1) *
        ((KFM.fmB (8 * BN6 Q) : ℝ) + BN6 Q + 1) + ((BN6 Q : ℝ) + 31) ^ 6) := by
    exact_mod_cast k
  have hF0 : (0 : ℝ) ≤ (KFM.fmB (8 * BN6 Q) : ℝ) := Nat.cast_nonneg _
  generalize (KFM.fmB (8 * BN6 Q) : ℝ) = F at hF hF0 k'
  generalize (Cfm : ℝ) = C at hF hC ⊢
  -- the polynomial part
  have h6 : ((BN6 Q : ℝ) + 31) ^ 6 ≤ 6 ^ 12 * (Q.T : ℝ) := by
