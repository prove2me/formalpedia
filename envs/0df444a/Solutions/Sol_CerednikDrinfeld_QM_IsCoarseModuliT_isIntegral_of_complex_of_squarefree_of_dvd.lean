theorem preconnectedSpace_of_charts {X H : Type*} [TopologicalSpace X] [TopologicalSpace H] [PreconnectedSpace H]
    (cl : H → X) (hdense : ∀ U : Set X, IsOpen U → U.Nonempty → ∃ t, cl t ∈ U)
    (hloc : ∀ t₀ : H, ∃ W ∈ 𝓝 t₀, ∃ Z : Set X, _root_.IsConnected Z ∧ ∀ t ∈ W, cl t ∈ Z) : PreconnectedSpace X := by
  constructor
  intro u v hu hv huv hune hvne
  by_contra hempty
  rw [Set.univ_inter, Set.not_nonempty_iff_eq_empty] at hempty
  have hdisj : Disjoint u v := Set.disjoint_iff_inter_eq_empty.2 hempty

  have hopen : ∀ w : Set X, IsOpen w → (w = u ∨ w = v) → IsOpen {t : H | cl t ∈ w} := by
    intro w hw hwuv
    rw [isOpen_iff_mem_nhds]
    intro t₀ ht₀
    obtain ⟨W, hW, Z, hZ, hWZ⟩ := hloc t₀
    have hZsub : Z ⊆ u ∪ v := fun z _ => huv (Set.mem_univ z)
    have hcl₀ : cl t₀ ∈ Z := hWZ t₀ (mem_of_mem_nhds hW)
    rcases hZ.isPreconnected.subset_or_subset hu hv hdisj hZsub with hZu | hZv
    · rcases hwuv with rfl | rfl
      · exact Filter.mem_of_superset hW fun t ht => hZu (hWZ t ht)
      · exact absurd (Set.disjoint_left.1 hdisj (hZu hcl₀)) (not_not.2 ht₀)
    · rcases hwuv with rfl | rfl
      · exact absurd (Set.disjoint_right.1 hdisj (hZv hcl₀)) (not_not.2 ht₀)
      · exact Filter.mem_of_superset hW fun t ht => hZv (hWZ t ht)
  have hu' := hopen u hu (Or.inl rfl)
  have hv' := hopen v hv (Or.inr rfl)
  obtain ⟨tu, htu⟩ := hdense u hu (Set.univ_inter u ▸ hune)
  obtain ⟨tv, htv⟩ := hdense v hv (Set.univ_inter v ▸ hvne)
  have hcov : (Set.univ : Set H) ⊆ {t | cl t ∈ u} ∪ {t | cl t ∈ v} := fun t _ => huv (Set.mem_univ (cl t))
  obtain ⟨t, -, htu', htv'⟩ := PreconnectedSpace.isPreconnected_univ (α := H) _ _ hu' hv' hcov ⟨tu, trivial, htu⟩ ⟨tv, trivial, htv⟩
  exact Set.disjoint_left.1 hdisj htu' htv'

