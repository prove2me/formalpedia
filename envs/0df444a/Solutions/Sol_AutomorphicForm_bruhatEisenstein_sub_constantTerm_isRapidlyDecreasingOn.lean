private theorem max_one_norm_add_le_of_le {E : Type*} [SeminormedAddCommGroup E] (p q : E) {R : ℝ}
    (hR : 0 ≤ R) (hq : ‖q‖ ≤ R) : max 1 ‖p + q‖ ≤ (1 + R) * max 1 ‖p‖ := by
  have h1R : (1 : ℝ) ≤ 1 + R := by linarith
  refine max_le (le_trans h1R (le_mul_of_one_le_right (by linarith) (le_max_left _ _))) ?_
  calc ‖p + q‖ ≤ ‖p‖ + ‖q‖ := norm_add_le p q
    _ ≤ ‖p‖ + R := by linarith
    _ ≤ max 1 ‖p‖ + R * max 1 ‖p‖ :=
        add_le_add (le_max_right _ _) (le_mul_of_one_le_right hR (le_max_left _ _))
    _ = (1 + R) * max 1 ‖p‖ := by ring

private theorem prod_max_one_norm_translate_le_of_le (x u : 𝔸) {R : ℝ} (hR : 0 ≤ R)
    (hu : ∀ w, ‖u.1 w‖ ≤ R) :
    ∏ w : InfinitePlace F, (max 1 ‖(x + u).1 w‖) ^ w.mult ≤
      (1 + R) ^ (∑ w : InfinitePlace F, w.mult) * ∏ w : InfinitePlace F, (max 1 ‖x.1 w‖) ^ w.mult := by
  rw [← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
  refine Finset.prod_le_prod (fun w _ => pow_nonneg (zero_le_one.trans (le_max_left _ _)) _) fun w _ => ?_
  rw [← mul_pow]
  exact pow_le_pow_left₀ (zero_le_one.trans (le_max_left _ _)) (max_one_norm_add_le_of_le (x.1 w) (u.1 w) hR (hu w)) _

private theorem Dy_translate_le_of_le (x u : 𝔸) {R : ℝ} (hR : 0 ≤ R)
    (hu1 : ∀ w, ‖u.1 w‖ ≤ R) (hu2 : u.2 ∈ integralFiniteAdeles (𝓞 F) F) :
    Dy F (x + u) ≤ (1 + R) ^ (∑ w : InfinitePlace F, w.mult) * Dy F x := by
  rw [Dy_eq_prod_mul_relIndex, Dy_eq_prod_mul_relIndex, dilate_finPart_translate F x u hu2, ← mul_assoc]
  exact mul_le_mul_of_nonneg_right (prod_max_one_norm_translate_le_of_le F x u hR hu1) (Nat.cast_nonneg _)

omit [NumberField F] in

private theorem rpow_neg_le_of_div_le {A B c : ℝ} (hA : 0 < A) (hc : 0 < c) (h : A / c ≤ B)
    {a : ℝ} (ha : 0 ≤ a) : B ^ (-a) ≤ c ^ a * A ^ (-a) := by
  have hB : 0 < B := lt_of_lt_of_le (div_pos hA hc) h
  have hAcB : A ≤ c * B := (div_le_iff₀ hc).mp h |>.trans_eq (mul_comm B c)
  have hr := Real.rpow_le_rpow hA.le hAcB ha
  rw [Real.mul_rpow hc.le hB.le] at hr
  have hca : (0:ℝ) < c ^ a := Real.rpow_pos_of_pos hc a
  calc B ^ (-a) = c ^ a * (c ^ a)⁻¹ * B ^ (-a) := by rw [mul_inv_cancel₀ hca.ne', one_mul]
    _ = c ^ a * (c ^ a * B ^ a)⁻¹ := by
        rw [mul_assoc, Real.rpow_neg hB.le, mul_inv, mul_comm (c^a)⁻¹]
    _ ≤ c ^ a * (A ^ a)⁻¹ :=
        mul_le_mul_of_nonneg_left (inv_anti₀ (Real.rpow_pos_of_pos hA a) hr) hca.le
    _ = c ^ a * A ^ (-a) := by rw [Real.rpow_neg hA.le]

omit [NumberField F] in

private theorem div_max_one_le_max_one_div {a t : ℝ} (ha : 0 ≤ a) (ht : 0 < t) :
    max 1 a / max 1 t ≤ max 1 (a / t) := by
  rw [div_le_iff₀ (lt_of_lt_of_le zero_lt_one (le_max_left _ _))]
  rcases le_or_gt t 1 with ht1 | ht1
  · rw [max_eq_left ht1, mul_one]
    exact max_le_max le_rfl (le_div_self ha ht ht1)
  · rw [max_eq_right ht1.le]
    have h1t : (1:ℝ) ≤ max 1 (a / t) * t :=
      ht1.le.trans ((one_mul t).symm.trans_le (mul_le_mul_of_nonneg_right (le_max_left _ _) ht.le))
    refine max_le h1t ?_
    rcases le_or_gt a t with hat | hat
    · exact hat.trans (le_mul_of_one_le_left ht.le (le_max_left _ _))
    · rw [max_eq_right ((one_lt_div ht).mpr hat).le, div_mul_cancel₀ _ ht.ne']

private theorem prod_max_one_norm_div_ge (a : 𝔸∞) (t : InfinitePlace F → ℝ) (ht : ∀ w, 0 < t w) :
    (∏ w : InfinitePlace F, max 1 ‖a w‖ ^ w.mult) / (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult)
      ≤ ∏ w : InfinitePlace F, max 1 (‖a w‖ / t w) ^ w.mult := by
  rw [← Finset.prod_div_distrib]
  refine Finset.prod_le_prod (fun w _ => ?_) fun w _ => ?_
  · positivity
  · rw [← div_pow]
    exact pow_le_pow_left₀ (by positivity) (div_max_one_le_max_one_div (norm_nonneg _) (ht w)) _

private theorem Dy_archScale_ge (x : 𝔸) (t : InfinitePlace F → ℝ) (ht : ∀ w, 0 < t w)
    (y : 𝔸) (hy1 : ∀ w, ‖y.1 w‖ = ‖x.1 w‖ / t w) (hy2 : y.2 = x.2) :
    Dy F x / (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ≤ Dy F y := by
  have hHpos : (0:ℝ) < ∏ w : InfinitePlace F, max 1 (t w) ^ w.mult := by positivity
  have harch : (∏ w : InfinitePlace F, max 1 ‖x.1 w‖ ^ w.mult) / (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult)
      ≤ ∏ w : InfinitePlace F, max 1 ‖y.1 w‖ ^ w.mult :=
    (prod_max_one_norm_div_ge F x.1 t ht).trans_eq (Finset.prod_congr rfl fun w _ => by rw [hy1])
  rw [Dy_eq_prod_mul_relIndex, Dy_eq_prod_mul_relIndex, dilate_finPart_of_snd_eq F x y hy2, mul_div_right_comm]
  exact mul_le_mul_of_nonneg_right harch (Nat.cast_nonneg _)

private theorem rpow_Dy_le_archScale_translate {a : ℝ} (ha : 0 ≤ a) (ξ : F)
    (t : InfinitePlace F → ℝ) (ht : ∀ w, 0 < t w)
    {R : ℝ} (hR : 0 ≤ R) (u : 𝔸) (hu1 : ∀ w, ‖u.1 w‖ ≤ R) (hu2 : u.2 ∈ integralFiniteAdeles (𝓞 F) F)
    (z : 𝔸) (hz1 : ∀ w, ‖z.1 w‖ = ‖(ι ξ + u).1 w‖ / t w) (hz2 : z.2 = (ι ξ + u).2) :
    Dy F z ^ (-a) ≤
      (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ^ a * ((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ^ a *
        Dy F (ι ξ) ^ (-a) := by
  have hHpos : (0:ℝ) < ∏ w : InfinitePlace F, max 1 (t w) ^ w.mult := by positivity
  have hCpos : (0:ℝ) < (1 + R) ^ (∑ w : InfinitePlace F, w.mult) := by positivity

  have hA : (0:ℝ) < Dy F (ι ξ + u) := Dy_pos F (ι ξ + u)
  have hD : (0:ℝ) < Dy F (ι ξ) := Dy_pos F (ι ξ)

  have hscale : Dy F (ι ξ + u) / (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ≤ Dy F z :=
    Dy_archScale_ge F (ι ξ + u) t ht z hz1 hz2
  have h1 : Dy F z ^ (-a) ≤ (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ^ a * Dy F (ι ξ + u) ^ (-a) :=
    rpow_neg_le_of_div_le hA hHpos hscale ha

  have hnu1 : ∀ w, ‖(-u).1 w‖ ≤ R := fun w => by show ‖-(u.1 w)‖ ≤ R; rw [norm_neg]; exact hu1 w
  have hnu2 : (-u).2 ∈ integralFiniteAdeles (𝓞 F) F := fun v => by
    show -(u.2 v) ∈ _; exact neg_mem (hu2 v)
  have hge : Dy F (ι ξ) / ((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ≤ Dy F (ι ξ + u) := by
    rw [div_le_iff₀ hCpos]
    calc Dy F (ι ξ) = Dy F (ι ξ + u + -u) := by rw [add_neg_cancel_right]
      _ ≤ (1+R) ^ (∑ w : InfinitePlace F, w.mult) * Dy F (ι ξ + u) :=
          Dy_translate_le_of_le F (ι ξ + u) (-u) hR hnu1 hnu2
      _ = Dy F (ι ξ + u) * ((1+R) ^ (∑ w : InfinitePlace F, w.mult)) := mul_comm _ _
  have h2 : Dy F (ι ξ + u) ^ (-a) ≤ ((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * Dy F (ι ξ) ^ (-a) :=
    rpow_neg_le_of_div_le hD hCpos hge ha
  calc Dy F z ^ (-a)
      ≤ (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ^ a * Dy F (ι ξ + u) ^ (-a) := h1
    _ ≤ (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ^ a *
          (((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * Dy F (ι ξ) ^ (-a)) :=
        mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hHpos.le a)
    _ = _ := by ring

private theorem summable_rpow_Dy_archScale_translate {a : ℝ} (ha : 2 < a)
    (t : InfinitePlace F → ℝ) (ht : ∀ w, 0 < t w)
    {R : ℝ} (hR : 0 ≤ R) (u : 𝔸) (hu1 : ∀ w, ‖u.1 w‖ ≤ R) (hu2 : u.2 ∈ integralFiniteAdeles (𝓞 F) F)
    (z : F → 𝔸) (hz1 : ∀ ξ w, ‖(z ξ).1 w‖ = ‖(ι ξ + u).1 w‖ / t w) (hz2 : ∀ ξ, (z ξ).2 = (ι ξ + u).2) :
    Summable (fun ξ : F => Dy F (z ξ) ^ (-a)) := by
  have ha' : (0:ℝ) ≤ a := by linarith
  set C : ℝ := (∏ w : InfinitePlace F, max 1 (t w) ^ w.mult) ^ a *
    ((1 + R) ^ (∑ w : InfinitePlace F, w.mult)) ^ a with hC
  refine ((summable_rpow_Dy_algebraMap F ha).mul_left C).of_nonneg_of_le
    (fun ξ => Real.rpow_nonneg (Dy_pos F _).le _) (fun ξ => ?_)
  exact rpow_Dy_le_archScale_translate F ha' ξ t ht hR u hu1 hu2 (z ξ) (hz1 ξ) (hz2 ξ)

