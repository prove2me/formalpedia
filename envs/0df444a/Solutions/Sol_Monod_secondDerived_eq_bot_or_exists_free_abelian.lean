open Filter Topology OnePoint Matrix

set_option linter.unusedSimpArgs false

namespace Monod.Dev.Alg

/-- The homomorphism `ℤ² → G` given by two commuting elements. -/
def pairHom {G : Type*} [Group G] (u v : G) (h : Commute u v) : Multiplicative (ℤ × ℤ) →* G where
  toFun x := u ^ (Multiplicative.toAdd x).1 * v ^ (Multiplicative.toAdd x).2
  map_one' := by simp
  map_mul' x y := by
    simp only [toAdd_mul, Prod.fst_add, Prod.snd_add, _root_.zpow_add, mul_assoc]
    rw [← mul_assoc (u ^ _) (v ^ _) (v ^ _), (h.zpow_zpow _ _).eq]
    simp only [mul_assoc]

lemma pairHom_apply {G : Type*} [Group G] (u v : G) (h : Commute u v) (x : Multiplicative (ℤ × ℤ)) :
    pairHom u v h x = u ^ (Multiplicative.toAdd x).1 * v ^ (Multiplicative.toAdd x).2 := rfl

lemma secondDerived_le {G : Type*} [Group G] (Γ : Subgroup G) : ⁅⁅Γ, Γ⁆, ⁅Γ, Γ⁆⁆ ≤ Γ := by
  have hΓ' : ⁅Γ, Γ⁆ ≤ Γ := by
    rw [Subgroup.commutator_le]
    intro a ha b hb
    rw [commutatorElement_def]
    exact Γ.mul_mem (Γ.mul_mem (Γ.mul_mem ha hb) (Γ.inv_mem ha)) (Γ.inv_mem hb)
  rw [Subgroup.commutator_le]
  intro a ha b hb
  rw [commutatorElement_def]
  exact Γ.mul_mem (Γ.mul_mem (Γ.mul_mem (hΓ' ha) (hΓ' hb)) (Γ.inv_mem (hΓ' ha)))
    (Γ.inv_mem (hΓ' hb))

theorem secondDerived_eq_bot_or_exists_free_abelian_direct {f g : OnePoint ℝ ≃ₜ OnePoint ℝ}
    (hf : f ∈ H ⊤) (hg : g ∈ H ⊤) :
    ⁅⁅Subgroup.closure {f, g}, Subgroup.closure {f, g}⁆,
        ⁅Subgroup.closure {f, g}, Subgroup.closure {f, g}⁆⁆ = ⊥ ∨
      ∃ φ : Multiplicative (ℤ × ℤ) →* (OnePoint ℝ ≃ₜ OnePoint ℝ),
        Function.Injective φ ∧ φ.range ≤ Subgroup.closure {f, g} := by
  classical
  set Γ := Subgroup.closure ({f, g} : Set (OnePoint ℝ ≃ₜ OnePoint ℝ)) with hΓdef
  by_cases hbot : ⁅⁅Γ, Γ⁆, ⁅Γ, Γ⁆⁆ = ⊥
  · exact Or.inl hbot
  right
  obtain ⟨⟨w, hw⟩, hwne⟩ := (Subgroup.ne_bot_iff_exists_ne_one).1 hbot
  have hw1 : w ≠ 1 := fun h => hwne (Subtype.ext h)
  set fH : H ⊤ := ⟨f, hf⟩
  set gH : H ⊤ := ⟨g, hg⟩
  set ΓH := Subgroup.closure ({fH, gH} : Set (H ⊤))
  have hmap1 : ΓH.map (H ⊤).subtype = Γ := by
    rw [MonoidHom.map_closure, Set.image_pair]; rfl
  have hmap2 : ΓH.map ψ = Subgroup.closure ({ψ fH, ψ gH} : Set (ℝ ≃o ℝ)) := by
    rw [MonoidHom.map_closure, Set.image_pair]
  have hwΓ : w ∈ Γ := secondDerived_le Γ hw
  rw [← hmap1] at hwΓ
  obtain ⟨wH, hwH, rfl⟩ := hwΓ
  set w₁ := ψ wH
  have hw₁K : w₁ ∈ Subgroup.closure ({ψ fH, ψ gH} : Set (ℝ ≃o ℝ)) := by
    rw [← hmap2]; exact Subgroup.mem_map_of_mem _ hwH
  have hw₁ne : w₁ ≠ 1 := by
    intro h
    apply hw1
    have : wH = 1 := ψ_injective (by rw [map_one]; exact h)
    rw [this]; rfl
  have hval : ∀ y : ℝ, ((w₁ y : ℝ) : OnePoint ℝ) = (wH : OnePoint ℝ ≃ₜ OnePoint ℝ) y :=
    fun y => coe_ψ wH y
  -- Lemma 13 at `∞`: the support is bounded
  have hinf := eventually_eq_self_of_mem_second_derived' hf hg (mem_H_top_fix hf)
    (mem_H_top_fix hg) hw
  have hev : ∀ᶠ y : ℝ in atBot ⊔ atTop, w₁ y = y := by
    have := (Filter.tendsto_map : Tendsto ((↑) : ℝ → OnePoint ℝ) (atBot ⊔ atTop)
      (Filter.map ((↑) : ℝ → OnePoint ℝ) (atBot ⊔ atTop))).mono_right map_coe_cocompact_le
    filter_upwards [this.eventually hinf] with y hy
    apply OnePoint.coe_injective
    rw [hval]; exact hy
  rw [Filter.eventually_sup] at hev
  obtain ⟨M₁, hM₁⟩ := Filter.eventually_atBot.1 hev.1
  obtain ⟨M₂, hM₂⟩ := Filter.eventually_atTop.1 hev.2
  have hsuppIcc : BS.supp w₁ ⊆ Set.Icc M₁ M₂ := by
    intro y hy
    refine ⟨?_, ?_⟩
    · by_contra h; exact hy (hM₁ y (le_of_lt (not_le.1 h)))
    · by_contra h; exact hy (hM₂ y (le_of_lt (not_le.1 h)))
  have hcpt : IsCompact (closure (BS.supp w₁)) :=
    isCompact_Icc.of_isClosed_subset isClosed_closure
      (isClosed_Icc.closure_subset_iff.2 hsuppIcc)
  -- Lemma 13 at the common fixed points on the line
  have hsub : closure (BS.supp w₁) ⊆ BS.supp (ψ fH) ∪ BS.supp (ψ gH) := by
    intro x hx
    by_contra hxU
    simp only [Set.mem_union, BS.supp, Set.mem_ofPred_eq, not_or, not_not] at hxU
    have hfx : f x = x := by rw [← coe_ψ fH, hxU.1]
    have hgx : g x = x := by rw [← coe_ψ gH, hxU.2]
    have hloc := eventually_eq_self_of_mem_second_derived' hf hg hfx hgx hw
    have hloc' : ∀ᶠ y : ℝ in 𝓝 x, w₁ y = y := by
      filter_upwards [(OnePoint.continuous_coe.tendsto x).eventually hloc] with y hy
      apply OnePoint.coe_injective
      rw [hval]; exact hy
    obtain ⟨y, hy1, hy2⟩ := mem_closure_iff_nhds.1 hx _ hloc'
    exact hy2 hy1
  obtain ⟨u', hu', v', hv', hcomm', hinj'⟩ :=
    BS.zsq_of_compact (ψ fH) (ψ gH) w₁ hw₁K hw₁ne hcpt hsub
  rw [← hmap2] at hu' hv'
  obtain ⟨uH, huH, rfl⟩ := hu'
  obtain ⟨vH, hvH, rfl⟩ := hv'
  have hcommH : uH * vH = vH * uH := ψ_injective (by rw [map_mul, map_mul, hcomm'])
  have hcomm : Commute (uH : OnePoint ℝ ≃ₜ OnePoint ℝ) (vH : OnePoint ℝ ≃ₜ OnePoint ℝ) := by
    show (uH : OnePoint ℝ ≃ₜ OnePoint ℝ) * vH = vH * uH
    rw [← Subgroup.coe_mul, hcommH, Subgroup.coe_mul]
  refine ⟨pairHom _ _ hcomm, ?_, ?_⟩
  · intro x y hxy
    rw [pairHom_apply, pairHom_apply] at hxy
    have hH : uH ^ (Multiplicative.toAdd x).1 * vH ^ (Multiplicative.toAdd x).2 =
        uH ^ (Multiplicative.toAdd y).1 * vH ^ (Multiplicative.toAdd y).2 := by
      apply Subtype.ext
      simpa only [Subgroup.coe_mul, Subgroup.coe_zpow] using hxy
    have := congrArg ψ hH
    simp only [map_mul, map_zpow] at this
    exact Multiplicative.toAdd.injective (hinj' this)
  · rintro _ ⟨x, rfl⟩
    rw [pairHom_apply]
    have hu : (uH : OnePoint ℝ ≃ₜ OnePoint ℝ) ∈ Γ := by
      rw [← hmap1]; exact Subgroup.mem_map_of_mem _ huH
    have hv : (vH : OnePoint ℝ ≃ₜ OnePoint ℝ) ∈ Γ := by
      rw [← hmap1]; exact Subgroup.mem_map_of_mem _ hvH
    exact Γ.mul_mem (Γ.zpow_mem hu _) (Γ.zpow_mem hv _)

end Monod.Dev.Alg
end

