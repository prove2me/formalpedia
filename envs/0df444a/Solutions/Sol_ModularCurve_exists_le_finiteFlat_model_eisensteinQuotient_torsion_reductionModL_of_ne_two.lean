namespace TorsionAction

variable {G V : Type*} [Monoid G] [AddCommGroup V] [DistribMulAction G V] (n : ℤ)

theorem smul_mem_torsionBy (g : G) (v : V) (hv : v ∈ Submodule.torsionBy ℤ V n) :
    g • v ∈ Submodule.torsionBy ℤ V n := by
  rw [Submodule.mem_torsionBy_iff] at hv ⊢
  have h : n • g • v = g • (n • v) := (map_zsmul (DistribSMul.toAddMonoidHom V g) n v).symm
  rw [h, hv, smul_zero]

scoped instance instSMul : SMul G ↥(Submodule.torsionBy ℤ V n) :=
  ⟨fun g v => ⟨g • (v : V), smul_mem_torsionBy n g (v : V) v.2⟩⟩

@[scoped simp] theorem coe_smul (g : G) (v : ↥(Submodule.torsionBy ℤ V n)) :
    ((g • v : ↥(Submodule.torsionBy ℤ V n)) : V) = g • (v : V) := rfl

scoped instance instDistribMulAction : DistribMulAction G ↥(Submodule.torsionBy ℤ V n) where
  one_smul v := Subtype.ext (one_smul G (v : V))
  mul_smul g h v := Subtype.ext (mul_smul g h (v : V))
  smul_zero g := Subtype.ext (smul_zero g)
  smul_add g v w := Subtype.ext (smul_add g (v : V) (w : V))

end TorsionAction
