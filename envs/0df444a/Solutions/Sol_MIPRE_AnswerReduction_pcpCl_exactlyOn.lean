theorem ExactlyOn.downsize (b : Module.Basis κ K F) {P : CLFun F ι ℓ} {T : Finset ι}
    (hP : P.ExactlyOn T) : (P.downsize b).ExactlyOn (T ×ˢ Finset.univ) := by
