open TaoFivePrimes.TypeISharpVinogradov
theorem firstTail_location_sensitive_block_bound
    (a q : ℕ) (beta C B : ℝ) (hq : 4 ≤ q) (haq : Nat.Coprime a q)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hC : 0 ≤ C) (hB : 0 ≤ B) :
    (∑ j ∈ Finset.range q,
      safeCappedCosecant
        (C / (firstTailPoint q j : ℝ) + B) B
        (Real.pi * perturbedPhase a q beta (firstTailPhi a q beta) j)) ≤
      C / (q : ℝ) +
        B * ((2 / Real.pi) * (q : ℝ) * Real.log (4 * (q : ℝ)) +
          4 * (q : ℝ)) := by sorry
end TaoFivePrimes.TypeIFirstTailLocationSensitive
