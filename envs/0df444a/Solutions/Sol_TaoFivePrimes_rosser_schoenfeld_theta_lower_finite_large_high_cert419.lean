theorem leaf (C Cb a c₀ N j bb : ℕ) (l : List (ℕ × ℕ)) (h : walk C N Cb j bb 1 c₀ 0 l = true)
    (hc₀ : primorial a ≤ primorial c₀) (hbase : (C : ℝ) / 2 ^ 40 ≤ Chebyshev.theta (a : ℝ)) :
