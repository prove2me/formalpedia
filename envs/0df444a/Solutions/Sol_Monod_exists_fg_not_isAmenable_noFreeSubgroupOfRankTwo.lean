/-! # Monod, Corollary 3, as a reduction to Theorem 1 and Theorem 5 -/

namespace Monod.Dev.Red

open Monod

/-- A group all of whose finitely generated subgroups are amenable is amenable. -/
theorem isAmenable_of_forall_fg {G : Type*} [Group G]
    (h : ∀ K : Subgroup G, K.FG → Garrido.IsAmenable K) : Garrido.IsAmenable G := by
  refine Garrido.isAmenable_of_directed (ι := {K : Subgroup G // K.FG}) (fun K => K.1) ?_ ?_
    (fun K => h K.1 K.2)
  · rintro ⟨K, hK⟩ ⟨L, hL⟩
    exact ⟨⟨K ⊔ L, hK.sup hL⟩, le_sup_left, le_sup_right⟩
  · rw [eq_top_iff]
    intro x _
    have hx : (Subgroup.zpowers x).FG := ⟨{x}, by simp [Subgroup.zpowers_eq_closure]⟩
    exact Subgroup.mem_iSup_of_mem (⟨Subgroup.zpowers x, hx⟩ : {K : Subgroup G // K.FG})
      (Subgroup.mem_zpowers x)

theorem exists_fg_not_isAmenable_noFreeSubgroupOfRankTwo_of
    (h_not_isAmenable_H : ∀ {A : Subring ℝ}, A ≠ ⊥ → ¬ Garrido.IsAmenable (H A))
    (h_noFree : Chou.NoFreeSubgroupOfRankTwo (H ⊤) ∧
      ∀ A : Subring ℝ, Chou.NoFreeSubgroupOfRankTwo (H A))
    {A : Subring ℝ} (hA : A ≠ ⊥) :
    ∃ K : Subgroup (H A), K.FG ∧ ¬ Garrido.IsAmenable K ∧ Chou.NoFreeSubgroupOfRankTwo K := by
  by_contra hcon
  apply h_not_isAmenable_H hA
  refine isAmenable_of_forall_fg fun K hK => ?_
  by_contra hna
  refine hcon ⟨K, hK, hna, fun f hf => ?_⟩
  exact h_noFree.2 A (K.subtype.comp f) (Subtype.val_injective.comp hf)

end Monod.Dev.Red
end

open Monod in
theorem solution {A : Subring ℝ} (hA : A ≠ ⊥) :
    ∃ K : Subgroup (H A), K.FG ∧ ¬ Garrido.IsAmenable K ∧ Chou.NoFreeSubgroupOfRankTwo K :=
  Monod.Dev.Red.exists_fg_not_isAmenable_noFreeSubgroupOfRankTwo_of not_isAmenable_H
    (Gpp_eq_G_top_and_Hpp_eq_H_top.2 ▸ noFreeSubgroupOfRankTwo_Hpp) hA
