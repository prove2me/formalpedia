theorem bnd_bits {zs : List ℤ} (h : Bits zs) : Bnd 1 zs := by
  intro z hz; rcases h z hz with rfl | rfl
  · rw [zsz_zero]; omega
  · rw [zsz_one]

theorem TV_lineP {K ρ f : ℕ} (l : Line) (c : Tr) (hc : TV (2 ^ (f * K)) c) :
    TV (2 ^ (f * K)) (lineP K ρ f l c) := by
  have hQ : 0 < 2 ^ (f * K) := by positivity
  unfold lineP
  split_ifs
  · exact ⟨hc.1, Nat.mod_lt _ hQ, hc.2.2⟩
  · exact ⟨hc.1, hc.2.1, Nat.mod_lt _ hQ⟩

theorem TV_foldr {K ρ f : ℕ} (ls : List Line) (c : Tr) (hc : TV (2 ^ (f * K)) c) :
    TV (2 ^ (f * K)) (ls.foldr (fun l c => lineP K ρ f l c) c) := by
  induction ls with
  | nil => exact hc
  | cons l ls ih => exact TV_lineP l _ ih

theorem cRot_le_G (K f : ℕ) (g : Geo) (Bb : ℕ) (b : ℤ) (hb : b = 0 ∨ b = 1) :
    cRot K f b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 1 Bb ≤ cRotG K f g Bb := by
  unfold cRotG; rcases hb with rfl | rfl <;> omega
