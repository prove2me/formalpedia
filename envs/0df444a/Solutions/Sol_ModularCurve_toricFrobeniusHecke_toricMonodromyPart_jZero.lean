  have hcmpAll := ModularCurve.map_finPts_jHNeronObjectAtP_top_eq_and_map_toricPts_eq_of_pic0Congr_of_bridge N₀ p hpN₀ hpM hpM2 A hA hj 𝔛 θ hθ hwgen ρ hρ ΛT OT hD hΛ hσT hDQT hsepT ajQT kQT
    ajbarT εbarT HAJ Λ hJ O 𝔓 H hF φ hφ₁ hφ₂ hφ₃ e he

