theorem isLocallyConstant_prodMk {X Y Z : Type*} [TopologicalSpace X] {f : X → Y} {g : X → Z}
    (hf : IsLocallyConstant f) (hg : IsLocallyConstant g) : IsLocallyConstant fun x => (f x, g x) := by
  rw [IsLocallyConstant.iff_exists_open] at hf hg ⊢
  intro x
  obtain ⟨U, hU, hxU, hU'⟩ := hf x
  obtain ⟨V, hV, hxV, hV'⟩ := hg x
  exact ⟨U ∩ V, hU.inter hV, ⟨hxU, hxV⟩, fun x' hx' => Prod.ext (hU' x' hx'.1) (hV' x' hx'.2)⟩

