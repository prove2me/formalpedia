      ¬ ((Ideal.span {(((AlgebraicCurve.TwoChartIntegralModel A (↥K) j).presheaf.germ ⊤ ((pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base x) trivial).hom (((AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j).appTop).hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom ϖ)))} :
