def lowerGuardCatalogValid : Prop :=
  lowerGuardPrintedRows.length = 33 ∧ lowerGuardCases.length = 422 ∧
  ((lowerGuardCases.map fun c => c.labels.length).sum = 2202) ∧
  (lowerGuardPrintedRows.flatMap lowerGuardExpand).toFinset = lowerGuardCases.toFinset
def lowerGuardAllChecks : Prop := ∀ c ∈ lowerGuardCases, lowerGuardCaseValid c
noncomputable def lowerGuardAllowed (p : LowerPair) (l : LowerLabel) : Prop :=
  (∃ c ∈ lowerGuardCases, lowerGuardFits c p ∧ l ∈ c.labels) ∨
  (lowerRunOffered p ∧ ∃ k : ℕ, 3 ≤ k ∧ l = (List.replicate k 3,List.replicate k 3))
end Freiman


