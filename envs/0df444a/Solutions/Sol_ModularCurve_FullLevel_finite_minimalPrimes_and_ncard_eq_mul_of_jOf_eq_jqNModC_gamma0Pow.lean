    have h0 : s ∈ Ideal.comap (algebraMap ↥S P₀.B₀) 𝔭x := hb
    rw [hdom 𝔭x h𝔭x, Ideal.mem_bot] at h0
    exact (mem_nonZeroDivisors_iff_ne_zero.mp hsM) h0
  have h𝔓x_prime : 𝔓x.IsPrime := by
    letI : Algebra P₀.B₀ R := Algebra.TensorProduct.rightAlgebra
    haveI : IsLocalization (Algebra.algebraMapSubmonoid P₀.B₀ (nonZeroDivisors ↥S)) R :=
      IsLocalization.tensorRight (R := ↥S) (S := P₀.B₀) F (nonZeroDivisors ↥S)
    have h := IsLocalization.isPrime_of_isPrime_disjoint (Algebra.algebraMapSubmonoid P₀.B₀ (nonZeroDivisors ↥S)) R 𝔭x h𝔭xP hdisj
    exact h
  have h𝔓x_comap : Ideal.comap ιR 𝔓x = 𝔭x := by
    letI : Algebra P₀.B₀ R := Algebra.TensorProduct.rightAlgebra
    haveI : IsLocalization (Algebra.algebraMapSubmonoid P₀.B₀ (nonZeroDivisors ↥S)) R :=
      IsLocalization.tensorRight (R := ↥S) (S := P₀.B₀) F (nonZeroDivisors ↥S)
    have h := IsLocalization.under_map_of_isPrime_disjoint (Algebra.algebraMapSubmonoid P₀.B₀ (nonZeroDivisors ↥S)) R h𝔭xP hdisj
    exact h
  have h𝔓x_rank : Module.finrank F (R ⧸ 𝔓x) =
      (∏ p ∈ M'.primeFactors, p ^ (M'.factorization p - 1) * (p + 1)) *
        (q * (q ^ 2 - 1)) * (ℓ * (ℓ ^ 2 - 1)) / 2 := by
