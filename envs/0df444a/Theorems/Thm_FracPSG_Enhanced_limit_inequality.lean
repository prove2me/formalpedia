-- title:
--   Proof of Theorem 6.1(iii) — limit inequality at a cluster point (display after (33))
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 under Assumptions 1 and 2′ with $S_0$ bounded, and suppose $\bar\tau:=\liminf_{n\to+\infty}\tau_n>0$. Let $\bar x$ be a cluster point of $(x_n)$. Then $f(\bar x)<+\infty$ and, for every $i\in I_0(\bar x)$ and every $x\in S$,
--   $$f(\bar x)\ \le\ f(x)+\Big(\frac1{2\bar\tau}+\frac\ell2\Big)\|x-\bar x\|^2+\frac{f(\bar x)}{g(\bar x)}\,\langle\nabla g_i(\bar x),\,\bar x-x\rangle .$$
--
--   The inequality says that $\bar x$ minimizes $x\mapsto f(x)+(\frac1{2\bar\tau}+\frac\ell2)\|x-\bar x\|^2-\frac{f(\bar x)}{g(\bar x)}\langle\nabla g_i(\bar x),x\rangle$ over $S$, for every active index $i$.
--
--   **Formalization Note** $\bar\tau$ is `Filter.liminf τ atTop`, which is the true lower limit because $0<\tau_n\le1/\delta$ for every run. $I_0(\bar x)$ is the $0$-active set at the cluster point, not the $\varepsilon$-active set used by the algorithm.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 24, display after (33) (proof of Theorem 6.1(iii))

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Limit inequality (Boţ–Dao–Li, arXiv:2003.04124v2, p. 24, proof of Theorem 6.1(iii), display
after (33)): under the hypotheses of Theorem 6.1 and `τ̄ = liminf τₙ > 0`, for every cluster point
`x̄` of the iterates, `f(x̄) < +∞` and, for every `i ∈ I₀(x̄)` and every `x ∈ S`,
`f(x̄) ≤ f(x) + (1/(2τ̄) + ℓ/2)‖x − x̄‖² + (f(x̄)/g(x̄))⟨∇gᵢ(x̄), x̄ − x⟩`. -/
theorem limit_inequality
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0)))
    (hτ : 0 < Filter.liminf τ atTop) :
    ∀ xbar : EuclideanSpace ℝ (Fin N), MapClusterPt xbar atTop x →
      FracPSG.Subseq.objF fs fn xbar ≠ ⊤ ∧
      ∀ i ∈ activeSet 0 gi xbar, ∀ y ∈ S,
        FracPSG.Subseq.objF fs fn xbar ≤ FracPSG.Subseq.objF fs fn y
          + (((1 / (2 * Filter.liminf τ atTop) + ℓ / 2) * ‖y - xbar‖ ^ 2
            + FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) xbar * ⟪gradient (gi i) xbar, xbar - y⟫_ℝ : ℝ) :
              EReal) := by sorry

end FracPSG.Enhanced
