variable {n : ℕ}
theorem solution {E : ℝ → Fin n → Fin n → Pt n → ℂ} {B : Fin n → Fin n → Pt n → ℂ}
    {Φ : ℝ → Pt n → ℂ} {ψ : Pt n → ℂ} {W : Set (ℝ × Pt n)} {A : Fin n} (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => Φ p.1 p.2) W) {x : Pt n} (hx : ((0 : ℝ), x) ∈ W)
    (hB : ∀ μ, HasDerivAt (fun ε => E ε A μ x) (B A μ x) 0)
    (hψ : ∀ y, ((0 : ℝ), y) ∈ W → HasDerivAt (fun ε => Φ ε y) (ψ y) 0) :
    HasDerivAt (fun ε => fdir (E ε) A (Φ ε) x)
      (∑ μ, (B A μ x * cpdC μ (Φ 0) x + E 0 A μ x * cpdC μ ψ x)) 0 := by
  simp only [fdir]
  exact HasDerivAt.fun_sum fun μ _ => (hB μ).mul (hasDerivAt_cpdC_param hW hΦ hx hψ μ)
