theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨295218872057,297417895314⟩ ⟨741612419121,741930501814⟩ ⟨134969175478,161349208208⟩ := rfl
noncomputable def centerUpper : ℝ := (664102986831 / 1099511627776)
