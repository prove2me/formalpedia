    have h := FiniteWhittaker.t0091 a ε Winf dF.Wf u 1 1 1
      (fun y => by rw [hε, FiniteWhittaker.t0088 hu.trivial_on])
      (fun y => by rw [hblind u hu.arch, one_mul])
      (fun y => by
