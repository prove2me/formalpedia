/-- Formalization-only auxiliary lemma: applying a product of operators agrees
with successive application. It supports the ground-slice transfer of the Magic
Square rigidity bounds in `thm:ms-rigidity`; see blueprint
`blueprint/src/chapter/ch13_qpbt_test.tex:268-290` and paper
`references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:612-652`. -/
theorem applyOperatorToState_mul {ι : Type*}
    [Fintype ι] [DecidableEq ι]
    (M N : _root_.LIDT.MIPStarRE.Quantum.Op ι) (v : EuclideanSpace ℂ ι) :
    _root_.MIPStarRE.QPBT.applyOperatorToState (M * N) v =
      _root_.MIPStarRE.QPBT.applyOperatorToState M (_root_.MIPStarRE.QPBT.applyOperatorToState N v) := by
  unfold _root_.MIPStarRE.QPBT.applyOperatorToState
  simp [Matrix.toEuclideanLin, Matrix.toLpLin_mul_same]









/-- Formalization-only auxiliary lemma for the projective-sum estimate at paper
lines 364--380: distinct effects of a projective measurement are orthogonal. -/
theorem projective_effect_mul_effect_eq_zero {α ι : Type*}
    [Fintype α] [Fintype ι] [DecidableEq ι]
    (M : _root_.LIDT.MIPStarRE.Quantum.Measurement α ι)
    (hM : _root_.MIPStarRE.QPBT.Measurement.IsProjective M)
    {a b : α} (hab : a ≠ b) :
    M.effect a * M.effect b = 0 := by
  classical
  cases isEmpty_or_nonempty ι with
  | inl hι =>
      letI := hι
      exact Subsingleton.elim _ _
  | inr hι =>
      letI := hι
      let H : _root_.LIDT.MIPStarRE.LDT.MakingMeasurementsProjective.FiniteHilbertSpace :=
        { carrier := ι
          instFintype := inferInstance
          instDecidableEq := inferInstance
          instNonempty := inferInstance }
      let P : _root_.LIDT.MIPStarRE.LDT.ProjMeas α ι :=
        { toMeasurement := _root_.LIDT.MIPStarRE.LDT.MakingMeasurementsProjective.MatrixMeasurement.toMeasurement (H := H) M
          proj := fun a => (hM a).isIdempotentElem.eq }
      simpa [P, H] using P.outcome_orthogonal a b hab





/-- Formalization-only definition for the agreement facts (Facts 4.13 and 4.14):
the real quadratic form of an operator evaluated in a state vector. -/
noncomputable def stateQForm {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ψ : EuclideanSpace ℂ ι) (M : _root_.LIDT.MIPStarRE.Quantum.Op ι) : ℝ :=
  (inner ℂ ψ (_root_.MIPStarRE.QPBT.applyOperatorToState M ψ)).re

/-- Tensor placement is additive over finite sums in the left factor. This is
the formalization-only identity `lem:distance-tensor-sum-left`, used to expand
the relabeled overlaps in `lem:ld-sandwich`; detailed source proof
`references/neexp-paper/05_quantum_preliminaries.tex:952-999`. -/
theorem heteroKron_finset_sum_left {β ιA ιB : Type*} (s : Finset β)
    (A : β → _root_.LIDT.MIPStarRE.Quantum.Op ιA) (C : _root_.LIDT.MIPStarRE.Quantum.Op ιB) :
    _root_.MIPStarRE.QPBT.heteroKron (∑ b ∈ s, A b) C = ∑ b ∈ s, _root_.MIPStarRE.QPBT.heteroKron (A b) C := by
  ext p q
  simp [_root_.MIPStarRE.QPBT.heteroKron, Matrix.kronecker, Matrix.sum_apply, Finset.sum_mul]

/-- Tensor placement is additive over finite sums in the right factor. This is
the formalization-only identity `lem:distance-tensor-sum-right`, used to expand
the relabeled overlaps in `lem:ld-sandwich`; detailed source proof
`references/neexp-paper/05_quantum_preliminaries.tex:952-999`. -/
theorem heteroKron_finset_sum_right {β ιA ιB : Type*} (s : Finset β)
    (A : _root_.LIDT.MIPStarRE.Quantum.Op ιA) (C : β → _root_.LIDT.MIPStarRE.Quantum.Op ιB) :
    _root_.MIPStarRE.QPBT.heteroKron A (∑ b ∈ s, C b) = ∑ b ∈ s, _root_.MIPStarRE.QPBT.heteroKron A (C b) := by
  ext p q
  simp [_root_.MIPStarRE.QPBT.heteroKron, Matrix.kronecker, Matrix.sum_apply, Finset.mul_sum]

















/-- Formalization-only auxiliary lemma for the agreement facts (Facts 4.13 and
4.14): every positive measurement effect is Hermitian. -/
theorem measurement_effect_hermitian {α ι : Type*} [Fintype α]
    [Fintype ι] [DecidableEq ι]
    (M : _root_.LIDT.MIPStarRE.Quantum.Measurement α ι) (a : α) :
    (M.effect a)ᴴ = M.effect a :=
  (Matrix.nonneg_iff_posSemidef.mp (M.pos a)).isHermitian.eq



























/-- Regard a unit Euclidean vector as an LDT pure state. -/
 noncomputable def pureStateOfUnitVector {ι : Type*}
    [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (ψ : EuclideanSpace ℂ ι) (hψ : ‖ψ‖ = 1) : _root_.LIDT.MIPStarRE.LDT.PureState ι where
  vector := ψ.ofLp
  unit := by
    calc
      star ψ.ofLp ⬝ᵥ ψ.ofLp = ψ.ofLp ⬝ᵥ star ψ.ofLp := dotProduct_comm _ _
      _ = inner ℂ ψ ψ := (EuclideanSpace.inner_eq_star_dotProduct ψ ψ).symm
      _ = (‖ψ‖ ^ 2 : ℂ) := inner_self_eq_norm_sq_to_K ψ
      _ = 1 := by rw [hψ]; norm_num

/-- View the coordinate function of an LDT pure state as a Euclidean vector.

This construction sends a pure state to its Euclidean coordinate vector, and
`pureStateOfUnitVector` above reads a unit Euclidean vector as a pure state.
The theorem `pureState_stateQForm_eq_ev` below identifies the
quadratic form of that vector with evaluation in the associated density state.
Both constructions and that identity are stated here for an arbitrary finite
index type, and are used both by the distance calculus and by the low-degree
consistency transport; the two formulations of consistency they relate are
`references/qpbt-paper/06_nonlocal_games_and_mipstar.tex:295-395` and
`references/ldt-paper/preliminaries.tex:649-666`. -/
noncomputable def pureStateEuclideanVector {ι : Type*}
    [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (ψ : _root_.LIDT.MIPStarRE.LDT.PureState ι) : EuclideanSpace ℂ ι :=
  (EuclideanSpace.equiv ι ℂ).symm ψ.vector

@[simp] theorem pureStateEuclideanVector_apply {ι : Type*}
    [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (ψ : _root_.LIDT.MIPStarRE.LDT.PureState ι) (i : ι) :
    _root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ i = ψ.vector i :=
  rfl

/-- The Euclidean vector associated with an LDT pure state has norm one. -/
theorem pureStateEuclideanVector_norm {ι : Type*}
    [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (ψ : _root_.LIDT.MIPStarRE.LDT.PureState ι) : ‖_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ‖ = 1 := by
  have hsquareComplex :
      ((‖_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ‖ ^ 2 : ℝ) : ℂ) = 1 := by
    calc
      ((‖_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ‖ ^ 2 : ℝ) : ℂ) =
          (‖_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ‖ : ℂ) ^ 2 := by norm_cast
      _ = inner ℂ (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ)
          (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ) :=
        (inner_self_eq_norm_sq_to_K (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ)).symm
      _ = ψ.vector ⬝ᵥ star ψ.vector :=
        EuclideanSpace.inner_eq_star_dotProduct _ _
      _ = star ψ.vector ⬝ᵥ ψ.vector := dotProduct_comm _ _
      _ = 1 := ψ.unit
  have hsquare : ‖_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ‖ ^ 2 = (1 : ℝ) := by
    exact_mod_cast hsquareComplex
  nlinarith [norm_nonneg (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ)]

/-- Evaluation in a pure LDT density state is the quadratic form of its
Euclidean vector.  This identity relates the density formulation of consistency
to the vector formulation; see
`references/qpbt-paper/06_nonlocal_games_and_mipstar.tex:295-395`. -/
theorem pureState_stateQForm_eq_ev {ι : Type*}
    [Fintype ι] [DecidableEq ι] [Nonempty ι]
    (ψ : _root_.LIDT.MIPStarRE.LDT.PureState ι) (T : _root_.LIDT.MIPStarRE.Quantum.Op ι) :
    _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ) T = _root_.LIDT.MIPStarRE.LDT.ev (ψ : _root_.LIDT.MIPStarRE.LDT.QuantumState ι) T := by
  rw [_root_.LIDT.MIPStarRE.LDT.PureState.ev_eq_re_inner]
  unfold _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm _root_.MIPStarRE.QPBT.applyOperatorToState
  change (inner ℂ (_root_.MIPStarRE.QPBT.DistanceCalculus.pureStateEuclideanVector ψ)
      (WithLp.toLp 2 (T *ᵥ ψ.vector))).re =
    (star ψ.vector ⬝ᵥ T *ᵥ ψ.vector).re
  rw [EuclideanSpace.inner_eq_star_dotProduct, dotProduct_comm]
  rfl











