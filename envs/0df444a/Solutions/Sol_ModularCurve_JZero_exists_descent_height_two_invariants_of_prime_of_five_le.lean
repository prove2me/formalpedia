private theorem HT2.finiteIndex_range_nsmul_mul {G : Type*} [AddCommGroup G] {m n : ℕ}
    (hm : (nsmulAddMonoidHom m : G →+ G).range.FiniteIndex)
    (hn : (nsmulAddMonoidHom n : G →+ G).range.FiniteIndex) :
    (nsmulAddMonoidHom (m * n) : G →+ G).range.FiniteIndex := by
  have hcomp : (nsmulAddMonoidHom (m * n) : G →+ G)
      = (nsmulAddMonoidHom m).comp (nsmulAddMonoidHom n) := by
    ext x; simp [nsmulAddMonoidHom_apply, mul_smul]
  rw [hcomp, AddMonoidHom.range_comp, AddSubgroup.finiteIndex_iff, AddSubgroup.index_map]
  haveI := hn
  exact mul_ne_zero (AddSubgroup.finiteIndex_of_le le_sup_left).index_ne_zero hm.index_ne_zero

private theorem HT2.finiteIndex_range_nsmul_pow {G : Type*} [AddCommGroup G] {n : ℕ}
    (hn : (nsmulAddMonoidHom n : G →+ G).range.FiniteIndex) (k : ℕ) :
    (nsmulAddMonoidHom (n ^ k) : G →+ G).range.FiniteIndex := by
  induction k with
  | zero =>
    have h1 : (nsmulAddMonoidHom (n ^ 0) : G →+ G).range = ⊤ := by
      rw [pow_zero, AddMonoidHom.range_eq_top]
      exact fun x => ⟨x, one_nsmul x⟩
    exact h1 ▸ inferInstance
  | succ k ih => exact pow_succ n k ▸ HT2.finiteIndex_range_nsmul_mul ih hn

private theorem HT2.finiteIndex_range_nsmul_two_pow (G : Type) [AddCommGroup G]
    (hW : (nsmulAddMonoidHom 2 : G →+ G).range.FiniteIndex) (k : ℕ) :
    (nsmulAddMonoidHom (2 ^ k) : G →+ G).range.FiniteIndex :=
  HT2.finiteIndex_range_nsmul_pow hW k

private theorem ht2_list_of_fg (G : Type) [AddCommGroup G] (hG : AddGroup.FG G) :
    ∃ (h : G → ℝ) (a b c₀ : ℝ) (c : G → ℝ), 0 ≤ a ∧ a < b ∧
      (∀ g x, h x ≤ a * h (g + x) + c g) ∧ (∀ x, b * h x - c₀ ≤ h (2 • x)) ∧ Northcott h := by
  classical
  obtain ⟨n, ι, fι, p, hp, e, ⟨f⟩⟩ := @AddCommGroup.equiv_free_prod_directSum_zmod G _ hG
  refine ⟨fun x => ∑ i : Fin n, (((f x).1 i : ℤ) : ℝ) ^ 2, 2, 4, 0,
    fun g => 2 * ∑ i : Fin n, (((f g).1 i : ℤ) : ℝ) ^ 2, by norm_num, by norm_num, ?_, ?_, ?_⟩
  ·
    intro g x
    have hx : ∀ i, (((f x).1 i : ℤ) : ℝ) = (((f (g + x)).1 i : ℤ) : ℝ) - (((f g).1 i : ℤ) : ℝ) :=
      fun i => by
        simp only [map_add, Prod.fst_add, Finsupp.coe_add, Pi.add_apply, Int.cast_add]
        ring
    simp only [hx]
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun i _ => ?_
    nlinarith [sq_nonneg ((((f (g + x)).1 i : ℤ) : ℝ) + (((f g).1 i : ℤ) : ℝ)),
      sq_nonneg ((((f (g + x)).1 i : ℤ) : ℝ) - (((f g).1 i : ℤ) : ℝ))]
  ·
    intro x
    have h2 : ∀ i, (((f (2 • x)).1 i : ℤ) : ℝ) = 2 * (((f x).1 i : ℤ) : ℝ) := fun i => by
      simp only [map_nsmul, Prod.smul_fst, Finsupp.coe_smul, Pi.smul_apply, nsmul_eq_mul]
      push_cast
      ring
    simp only [h2]
    rw [sub_zero, Finset.mul_sum]
    exact le_of_eq (Finset.sum_congr rfl fun i _ => by ring)
  ·
    haveI : Fintype ι := fι
    haveI : ∀ i, NeZero (p i ^ e i) := fun i => ⟨pow_ne_zero _ (hp i).ne_zero⟩
    haveI : Finite (DirectSum ι fun i => ZMod (p i ^ e i)) :=
      Finite.of_equiv (∀ i, ZMod (p i ^ e i)) DFinsupp.equivFunOnFintype.symm
    have hφ : Function.Injective (fun x : G => ((⇑(f x).1 : Fin n → ℤ), (f x).2)) := by
      intro x y hxy
      dsimp only at hxy
      obtain ⟨h1, h2⟩ := Prod.mk.inj hxy
      exact f.injective (Prod.ext (DFunLike.coe_injective h1) h2)
    refine ⟨fun B => Set.Finite.subset (Set.Finite.preimage hφ.injOn
      (Set.Finite.prod (Set.Finite.pi fun _ : Fin n => Set.finite_Icc (⌈-B⌉) (⌊B⌋))
        Set.finite_univ)) ?_⟩
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    simp only [Set.mem_preimage, Set.mem_prod, Set.mem_univ, and_true, Set.mem_univ_pi,
      Set.mem_Icc]
    intro i
    have h1 : (((f x).1 i : ℤ) : ℝ) ^ 2 ≤ B :=
      le_trans (Finset.single_le_sum (fun j _ => sq_nonneg ((((f x).1 j : ℤ) : ℝ)))
        (Finset.mem_univ i)) hx
    have h2 : (((f x).1 i : ℤ) : ℝ) ≤ (((f x).1 i : ℤ) : ℝ) ^ 2 := by
      exact_mod_cast Int.le_self_sq ((f x).1 i)
    have h3 : -(((f x).1 i : ℤ) : ℝ) ≤ (((f x).1 i : ℤ) : ℝ) ^ 2 := by
      have := Int.le_self_sq (-(f x).1 i)
      rw [neg_sq] at this
      exact_mod_cast this
    exact ⟨Int.ceil_le.mpr (by linarith), Int.le_floor.mpr (by linarith)⟩

theorem solution (N : ℕ) [NeZero N] (hN : N.Prime) (hN5 : 5 ≤ N)
    (K : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ K] :
    ∃ (h : ↥(JZero N ^+ ↥K.fixingSubgroup) → ℝ) (a b c₀ : ℝ) (c : ↥(JZero N ^+ ↥K.fixingSubgroup) → ℝ),
      0 ≤ a ∧ a < b ∧ (∀ g x, h x ≤ a * h (g + x) + c g) ∧ (∀ x, b * h x - c₀ ≤ h (2 • x)) ∧ Northcott h := by

  obtain ⟨L', hFD, hKL, h2tor⟩ := JZero.exists_finiteDimensional_torsion_two_le_invariants N K
  haveI := hFD

  obtain ⟨g', hR⟩ := ModularCurve.exists_riemannConstant_modularFunctionFieldBar N

  have hW := JZero.finiteIndex_range_nsmul_two_invariants N L' h2tor

  obtain ⟨k, a, b, c₀, c, ha, hab, h1, h2'⟩ := JZero.naiveHeight_descent_of_prime_of_five_le N hN hN5 L' g' hR

  haveI := JZero.naiveHeight_northcott N L' g' hR

  have hFGL' : AddGroup.FG ↥(JZero N ^+ ↥L'.fixingSubgroup) :=
    AddCommGroup.fg_of_descent ha hab (HT2.finiteIndex_range_nsmul_two_pow _ hW k) h1 h2'

  have hle := JZero.invariants_le_invariants_of_le N K L' hKL
  have hFGK : AddGroup.FG ↥(JZero N ^+ ↥K.fixingSubgroup) :=
    AddSubgroup.addGroup_fg_of_le_of_addGroup_fg hle hFGL'

  exact ht2_list_of_fg _ hFGK

