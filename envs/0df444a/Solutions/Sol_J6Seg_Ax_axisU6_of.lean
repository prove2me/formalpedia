  have := hTk u hu
  rw [show axQ6 P n src k + (axR6 P n + 2) = Q6 (pP6 P n) (dP6 P n) (src k) + R6 (pP6 P n) + 2
    from by unfold axQ6 axR6 axp6 axd6 axs6; ring]
  exact this

end J6Seg.Val
