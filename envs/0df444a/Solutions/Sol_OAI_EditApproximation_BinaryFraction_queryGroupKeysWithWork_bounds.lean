theorem queryCellScan_bounds {n : ℕ} (F b exponent B : ℕ)
    (value : BinaryFraction) (q : TargetInterval n)
    (hF : 1 ≤ F) (hb : 1 ≤ b) (hbs : Nat.size b ≤ B + 1)
