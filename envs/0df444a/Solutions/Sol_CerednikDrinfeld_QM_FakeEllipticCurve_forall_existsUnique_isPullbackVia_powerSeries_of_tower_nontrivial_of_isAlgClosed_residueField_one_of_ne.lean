theorem Gpt.exists_lift (φ : B' →+* B) (hφ : φ.comp ψ' = ψ) (hφs : Function.Surjective φ)
    (hφ2 : RingHom.ker φ * RingHom.ker φ = ⊥) (χ : Gpt B ψ) :
    ∃ χ' : Gpt B' ψ', φ.comp χ'.1 = χ.1 := by
  obtain ⟨s, hs⟩ := hφs (χ.1 PowerSeries.X)
  obtain ⟨k, hk⟩ := χ.2.2

  have hsk : s ^ k ∈ RingHom.ker φ := by rw [RingHom.mem_ker, map_pow, hs, hk]
  have hs2k : s ^ (k + k) = 0 := by
    rw [pow_add, ← Ideal.mem_bot, ← hφ2]
    exact Ideal.mul_mem_mul hsk hsk
  have hsN : s ^ (k + k + 2) = 0 := by rw [pow_add, hs2k, zero_mul]
  refine ⟨⟨truncEval ψ' s (k + k) hsN, truncEval_comp_algebraMap ψ' s (k + k) hsN, ?_⟩, ?_⟩
  · rw [truncEval_X]; exact ⟨k + k + 2, hsN⟩
  ·
    have hχN : χ.1 PowerSeries.X ^ (k + k + 2) = 0 := by
      rw [pow_add, pow_add, hk, zero_mul, zero_mul]
    have h1 : (φ.comp (truncEval ψ' s (k + k) hsN)) PowerSeries.X ^ (k + k + 2) = 0 := by
      rw [RingHom.comp_apply, truncEval_X, hs]; exact hχN
    rw [eq_truncEval_of_pow_eq_zero (k + k) _ h1, eq_truncEval_of_pow_eq_zero (k + k) χ.1 hχN]
    congr 1
    · rw [RingHom.comp_assoc, truncEval_comp_algebraMap, hφ, χ.2.1]
    · rw [RingHom.comp_apply, truncEval_X, hs]

theorem Adm.comap_injective (φ : B' →+* B) (hφ : φ.comp ψ' = ψ) (hφs : Function.Surjective φ) :
    Function.Injective (Adm.comap φ hφ : Adm B ψ → Adm B' ψ') := by
  intro ρ₁ ρ₂ h
  apply Subtype.ext
  apply RingHom.ext
  intro x
  obtain ⟨y, rfl⟩ := hφs x
  have e := congrArg (fun σ : Adm B' ψ' => σ.1 y) h
  simpa only [Adm.comap_val, RingHom.comp_apply] using e

theorem hG_lift' (φ : B' →+* B) (hφ : φ.comp ψ' = ψ) (hφs : Function.Surjective φ) (hφ2 : RingHom.ker φ * RingHom.ker φ = ⊥)
    (x : Gobj B ψ) : ∃ x' : Gobj B' ψ', Gmap φ hφ x' = x := by
  classical
  let x' : Gobj B' ψ' := fun ρ' =>
    if h : ∃ ρ : Adm B ψ, Adm.comap φ hφ ρ = ρ' then
      Classical.choose (Gpt.exists_lift φ hφ hφs hφ2 (x (Classical.choose h)))
    else Gpt.const ψ'
  have key : ∀ ρ : Adm B ψ, φ.comp (x' (Adm.comap φ hφ ρ)).1 = (x ρ).1 := by
    intro ρ
    have h : ∃ ρ₀ : Adm B ψ, Adm.comap φ hφ ρ₀ = Adm.comap φ hφ ρ := ⟨ρ, rfl⟩
    have hρ : Classical.choose h = ρ := Adm.comap_injective φ hφ hφs (Classical.choose_spec h)
    simp only [x', dif_pos h]
    rw [Classical.choose_spec (Gpt.exists_lift φ hφ hφs hφ2 (x (Classical.choose h))), hρ]
  exact ⟨x', funext fun ρ => Subtype.ext (key ρ)⟩

end LiftWs40
