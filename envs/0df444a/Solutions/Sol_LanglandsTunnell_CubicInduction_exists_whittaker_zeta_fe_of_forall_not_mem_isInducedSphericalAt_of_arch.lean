variable {K : Type} [Field K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem isInducedSphericalAt_transported (t : GL (Fin 3) ℚ) {a : ℚ}
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) {c : HeightOneSpectrum (𝓞 K) → ℂ}
    {v : HeightOneSpectrum (𝓞 ℚ)} {U : Subgroup (LocalGL3 v)} {W : LocalGL3 v → ℂ}
    (hW : IsInducedSphericalAt c v U W) : IsInducedSphericalAt c v U (transported t W) :=
  ⟨isRightInvariant_transported t v hW.1, isCosetEigenfunction_transported t v hW.2.1,
    isCosetEigenfunction_transported t v hW.2.2.1, transported_centralGen_mul t v ht hW.2.2.2⟩

end
