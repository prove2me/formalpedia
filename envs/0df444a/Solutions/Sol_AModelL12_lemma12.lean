    (pull sh sh' g d xs).length = vol sh' := by simp [pull]

lemma getElem_pull (sh sh' : Shape) (g : List ℕ → List ℕ) (d : α) (xs : List α) (j : ℕ)
    (hj : j < (pull sh sh' g d xs).length) :
