    have := Nat.mod_lt e (by omega : 0 < K); have := Nat.mod_le e K; omega
  have hZec : NLogN.zsz ((ec + t + K + NLogN.KFW.mC ^ k : ℕ) : ℤ) ≤ Z :=
    le_trans (NLogN.zsz_natCast_le (by omega)) hZe
  have hσc0 : σc 0 = none := (NLogN.KFW.levR_child hN h).off 0 (by decide)
  have hPc := NLogN.KFW.phr_child hN h
  have hsl : NLogN.KFN.SLaws (fun c : Fin (NLogN.KFW.mC ^ k) => 2 ^ (ec - K * c.val) * S0) (NLogN.KFW.nN Bn t S0) :=
    NLogN.KFN.slaws_pow (fun c : Fin (NLogN.KFW.mC ^ k) => ec - K * c.val) (NLogN.KFW.pos_inj hK hKec) t S0 Bn
      (fun c => by omega)
  have IHc := NLogN.KFW.sImplQ_call (I := Isym) (lo := 0) (hi := H) hj IH
  -- the code inside the frame
  have Hin : NLogN.KFW.SImplQ Isym tbl (fun s => NLogN.KFW.Agree σc s) lo hi r
