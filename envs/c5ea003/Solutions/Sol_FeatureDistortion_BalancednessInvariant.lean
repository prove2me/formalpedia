lemma balance_gradient_cancellation {n d k : ℕ} (X : Vec d →L[ℝ] Vec n)
    (Y : Vec n) (v : Vec k) (B : Features d k) :
    InnerProductSpace.rankOne ℝ v (-headGradient X Y v B) +
        InnerProductSpace.rankOne ℝ (-headGradient X Y v B) v -
      ((-featureGradient X Y v B).comp B.adjoint +
        B.comp (-featureGradient X Y v B).adjoint) = 0 := by
  apply ContinuousLinearMap.ext
  intro z
  have hadj : (-featureGradient X Y v B).adjoint z =
      -((2 : ℝ) • (inner ℝ v z • X.adjoint (residual X Y v B))) := by
    apply ext_inner_right ℝ
    intro y
    rw [ContinuousLinearMap.adjoint_inner_left]
    simp [featureGradient, inner_smul_left, inner_smul_right, real_inner_comm, mul_comm]
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply]
  rw [hadj]
  let q := X.adjoint (residual X Y v B)
  change (inner ℝ (-((2 : ℝ) • B q)) z • v +
      inner ℝ v z • (-((2 : ℝ) • B q))) -
    (-((2 : ℝ) • (inner ℝ q (B.adjoint z) • v)) +
      B (-((2 : ℝ) • (inner ℝ v z • q)))) = 0
  rw [inner_neg_left, real_inner_smul_left, B.adjoint_inner_right]
  simp only [map_neg B, ContinuousLinearMap.map_smul, smul_smul, smul_neg, neg_smul]
  simp only [mul_comm (inner ℝ v z) (2 : ℝ)]
