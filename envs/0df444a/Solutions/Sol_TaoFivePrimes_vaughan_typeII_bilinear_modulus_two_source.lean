          ∫ W : ℝ in Set.Icc V (x / U),
            G W * Real.log W * (1 / W) := by
        rw [MeasureTheory.integral_const_mul]
  have henv :
      (∫ W : ℝ in Set.Icc V (x / U),
          G W * Real.log W * (1 / W)) ≤
        (1 / 2 : ℝ) *
            ((1 / (2 * Real.sqrt 2) : ℝ) * (x / Real.sqrt q) +
