theorem OAI.MatrixMultiplication.AuxiliarySeparation.exists_detecting_character.{u_1} :
    ∀ {𝕜 : Type u_1} [inst : Field 𝕜] {d k : ℕ},
  2 ≤ d →
    ↑k < HPow.hPow (α := ℝ) (↑d) (OAI.MatrixMultiplication.AuxiliarySeparation.exactRankExponent 𝕜) →
      ∃ (χ : OAI.MatrixMultiplication.AuxiliarySeparation.Character 𝕜),
        ↑k ≤ χ.value (OAI.MatrixMultiplication.Foundation.Tensor.matrixMultiplication d d d)
:= by sorry
