noncomputable def fieldBase : Nat := 2^160
noncomputable def bias : Int := 2^159
noncomputable def holds (n : Nat) (v : Record) (p : Nat) : Prop :=
  RHBatch01DirichletArithmetic.guard n v=true ∧ 2*(delta n).natAbs+2^100≤D ∧ bin n≤928 ∧
  v.gammaRe=((p%fieldBase:Nat):Int)-bias ∧
  v.gammaIm=((p/fieldBase%fieldBase:Nat):Int)-bias ∧
  delta n=((p/fieldBase^2%fieldBase:Nat):Int)-bias ∧ bin n=p/fieldBase^3
noncomputable instance holdsDecidable (n : Nat) (v : Record) (p : Nat) : Decidable (holds n v p) := by unfold holds;infer_instance
noncomputable def check (n : Nat) : List Record→List Nat→Bool
  | [],[] => true
  | v::vs,p::ps => decide (RHBatch01DirichletArithmetic.compute n=v) &&
      decide (holds n v p) && check (n+1) vs ps
  | _,_ => false
lemma sound (vs : List Record) (ps : List Nat) (start j : Nat)
    (hj:j<vs.length) (h:check start vs ps=true) :
    holds (start+j) (RHBatch01DirichletArithmetic.compute (start+j)) ((ps[j]?).getD 0) := by
  induction vs generalizing start j ps with
  | nil => simp at hj
  | cons v vs ih =>
    cases ps with
    | nil => simp [check] at h
    | cons p ps =>
      simp only [check,Bool.and_eq_true,decide_eq_true_eq] at h
      cases j with
      | zero => simpa only [Nat.add_zero,List.getElem?_cons_zero,Option.getD_some,h.1.1] using h.1.2
      | succ j =>
        have hh:=ih ps (start+1) j (by simpa using hj) h.2
        simpa only [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm,List.getElem?_cons_succ] using hh
