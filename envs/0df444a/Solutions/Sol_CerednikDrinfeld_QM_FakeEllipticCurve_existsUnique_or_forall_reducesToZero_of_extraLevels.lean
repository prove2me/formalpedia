theorem mapPt_schemeNsmul {S : Type} [CommRing S] (E : FakeEllipticCurve Λ N S) (n : ℕ)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f) :
    mapPt (E.L.schemeNsmul n) (E.L.schemeNsmul_over n) P = nsmulPt E.L t n P := by
  have h := E.L.nsmul_natural E.f t P.1 P.2 n RelativeGroupLaw.idPoint
  have hid : GoodReductionJacobian.schemeHomOverComp P.1 P.2 (RelativeGroupLaw.idPoint (f := E.f)) = P :=
    Subtype.ext (Category.comp_id _)
  rw [hid] at h
  have hn : ∀ k : ℕ, E.L.nsmul t k P = nsmulPt E.L t k P := by
    intro k; induction k with
    | zero => rfl
    | succ k ih => rw [RelativeGroupLaw.nsmul_succ, ih]; rfl
  apply Subtype.ext
  show P.1 ≫ (E.L.nsmul E.f n RelativeGroupLaw.idPoint).1 = (nsmulPt E.L t n P).1
  rw [← hn n, ← h]
  rfl
