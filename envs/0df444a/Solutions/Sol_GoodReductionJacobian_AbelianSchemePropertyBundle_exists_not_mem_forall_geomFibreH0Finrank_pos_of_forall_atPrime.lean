theorem subsingleton_HSucc_fibre
    (hpos : 0 < Scheme.Modules.geomFibreH0Finrank f 𝓛 k (algebraMap S k))
    (𝒰' : (pullback f (Scheme.TwoAffineOpenCover.specMap S k)).OrderedAffineCover) (i : ℕ) :
    Subsingleton ((OModulePresheaf.ofModules (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k))
      ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S k))).obj 𝓛)).HSucc 𝒰' i) := by
  have hAk := hA.baseChange_of_field (Scheme.TwoAffineOpenCover.specMap S k)
