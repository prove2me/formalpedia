theorem GlobalTheory.CollapseCompare.frame_conj_apply (b : ℕ → kˣ) (u : GL (n ⊕ Fin c) k) (r s : n ⊕ Fin c) :
    (frame n c b * u * (frame n c b)⁻¹).val r s =
      Sum.elim (fun _ : n => (1 : k)) (fun i : Fin c => (b (i.val + 1) : k)) r *
        Sum.elim (fun _ : n => (1 : k)) (fun i : Fin c => (b (i.val + 1) : k)⁻¹) s * u.val r s := by sorry
