-- Source module: Solutions.J6SegRes
/-!
# Segmented inverse (S2): the exact Woodbury residual identity (abstract form)

Abstract setting on positions `ℕ` (a position set `I`): a block-diagonal matrix `M` given by its
blocks `bl i` and entries `Mx`, its block inverse `Mi`, and a sparse coupling `Δ` given row-wise
by offsets `Hs i`, columns `cl i h` and coefficients `cf i h`, with every coupling column in the
capacitance index set `J`.

`res_bound` (report L8 + L10, residual form): if the four fixed-point stages of the segmented
inverse are accurate,
* `y ≈ M⁻¹ u` (`ε₁`), `W ≈ Δ z` (`ε₃`), `y₂ ≈ M⁻¹ W` (`ε₂`),
* `z + (M⁻¹ Δ z)|_J ≈ y|_J` (`ε₄`, the capacitance solve),

then `x = y - y₂` satisfies `|((M + Δ) x - u)_i| ≤ A(ε₁+ε₂) + ε₃ + d(ε₄ + μ ε₃ + ε₂)`
(`A`, `d`, `μ` bound `‖M‖`, `‖Δ‖`, `‖M⁻¹‖` row-wise). No exact intermediate solution is needed.
`Miv_bound`: `‖M⁻¹‖ ≤ 1/(1-m)` from `M M⁻¹ = I` and `‖M - I‖ ≤ m < 1` (via `near_id`).
-/

open Finset

namespace J6Seg

section res
variable (bl : ℕ → Finset ℕ) (Mx : ℕ → ℕ → ℝ) (Hs : ℕ → Finset ℤ) (cl : ℕ → ℤ → ℕ)
  (cf : ℕ → ℤ → ℝ)

lemma Mv_sub (f g : ℕ → ℝ) (i : ℕ) :
    Mv bl Mx (fun k => f k - g k) i = Mv bl Mx f i - Mv bl Mx g i := by
  simp only [Mv, ← sum_sub_distrib]; exact sum_congr rfl fun _ _ => by ring

lemma Mv_add (f g : ℕ → ℝ) (i : ℕ) :
    Mv bl Mx (fun k => f k + g k) i = Mv bl Mx f i + Mv bl Mx g i := by
  simp only [Mv, ← sum_add_distrib]; exact sum_congr rfl fun _ _ => by ring

lemma Dv_sub (f g : ℕ → ℝ) (i : ℕ) :
    Dv Hs cl cf (fun k => f k - g k) i = Dv Hs cl cf f i - Dv Hs cl cf g i := by
  simp only [Dv, ← sum_sub_distrib]; exact sum_congr rfl fun _ _ => by ring

lemma Dv_congr {J : Finset ℕ} {f g : ℕ → ℝ} {i : ℕ} (hcl : ∀ h ∈ Hs i, cl i h ∈ J)
    (hfg : ∀ k ∈ J, f k = g k) : Dv Hs cl cf f i = Dv Hs cl cf g i :=
  sum_congr rfl fun h hh => by rw [hfg _ (hcl h hh)]

lemma abs_sum_mul_le {S : Finset ℕ} {a f : ℕ → ℝ} {A F : ℝ} (hA : ∑ k ∈ S, |a k| ≤ A)
    (hF : ∀ k ∈ S, |f k| ≤ F) (hF0 : 0 ≤ F) : |∑ k ∈ S, a k * f k| ≤ A * F := by
  refine (abs_sum_le_sum_abs _ _).trans ?_
  calc ∑ k ∈ S, |a k * f k| ≤ ∑ k ∈ S, |a k| * F := sum_le_sum fun k hk => by
        rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hF k hk) (abs_nonneg _)
    _ = (∑ k ∈ S, |a k|) * F := by rw [sum_mul]
    _ ≤ A * F := mul_le_mul_of_nonneg_right hA hF0

lemma Mv_abs {f : ℕ → ℝ} {i : ℕ} {A F : ℝ} (hA : ∑ k ∈ bl i, |Mx i k| ≤ A)
    (hF : ∀ k ∈ bl i, |f k| ≤ F) (hF0 : 0 ≤ F) : |Mv bl Mx f i| ≤ A * F :=
  abs_sum_mul_le hA hF hF0

lemma Dv_abs {f : ℕ → ℝ} {i : ℕ} {J : Finset ℕ} {d F : ℝ} (hd : ∑ h ∈ Hs i, |cf i h| ≤ d)
    (hcl : ∀ h ∈ Hs i, cl i h ∈ J) (hF : ∀ k ∈ J, |f k| ≤ F) (hF0 : 0 ≤ F) :
    |Dv Hs cl cf f i| ≤ d * F := by
  refine (abs_sum_le_sum_abs _ _).trans ?_
  calc ∑ h ∈ Hs i, |cf i h * f (cl i h)| ≤ ∑ h ∈ Hs i, |cf i h| * F := sum_le_sum fun h hh => by
        rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hF _ (hcl h hh)) (abs_nonneg _)
    _ = (∑ h ∈ Hs i, |cf i h|) * F := by rw [sum_mul]
    _ ≤ d * F := mul_le_mul_of_nonneg_right hd hF0

/-- **Residual of the segmented inverse** (exact Woodbury, all four stages perturbed). -/
theorem res_bound_sol_aux (Mi : ℕ → ℕ → ℝ) {I J : Finset ℕ} {u W y y₂ x z : ℕ → ℝ}
    {ε₁ ε₂ ε₃ ε₄ A d μ : ℝ} (hJI : J ⊆ I) (hblI : ∀ i ∈ I, bl i ⊆ I)
    (hcl : ∀ i ∈ I, ∀ h ∈ Hs i, cl i h ∈ J)
    (hMM : ∀ i ∈ I, ∀ f : ℕ → ℝ, Mv bl Mx (Mv bl Mi f) i = f i)
    (hMi : ∀ (f : ℕ → ℝ) (F : ℝ), (∀ k ∈ I, |f k| ≤ F) → ∀ i ∈ I, |Mv bl Mi f i| ≤ μ * F)
    (hA : ∀ i ∈ I, ∑ k ∈ bl i, |Mx i k| ≤ A) (hd : ∀ i ∈ I, ∑ h ∈ Hs i, |cf i h| ≤ d)
    (hd0 : 0 ≤ d) (hμ : 0 ≤ μ) (hε₂ : 0 ≤ ε₂) (hε₃ : 0 ≤ ε₃) (hε₄ : 0 ≤ ε₄)
    (hx : ∀ i, x i = y i - y₂ i)
    (h1 : ∀ i ∈ I, |y i - Mv bl Mi u i| ≤ ε₁)
    (h2 : ∀ i ∈ I, |y₂ i - Mv bl Mi W i| ≤ ε₂)
    (h3 : ∀ i ∈ I, |W i - Dv Hs cl cf z i| ≤ ε₃)
    (h4 : ∀ a ∈ J, |z a + Mv bl Mi (Dv Hs cl cf z) a - y a| ≤ ε₄) :
    ∀ i ∈ I, |Mv bl Mx x i + Dv Hs cl cf x i - u i| ≤
      A * (ε₁ + ε₂) + ε₃ + d * (ε₄ + μ * ε₃ + ε₂) := by
  intro i hi
  set e1 : ℕ → ℝ := fun k => y k - Mv bl Mi u k
  set e2 : ℕ → ℝ := fun k => y₂ k - Mv bl Mi W k
  set e3 : ℕ → ℝ := fun k => W k - Dv Hs cl cf z k
  set e4 : ℕ → ℝ := fun k => z k + Mv bl Mi (Dv Hs cl cf z) k - y k
  set g : ℕ → ℝ := fun k => e4 k + Mv bl Mi e3 k + e2 k
  -- `M x = u + M(e₁ - e₂) - W`
  have hMx : Mv bl Mx x i = u i + Mv bl Mx (fun k => e1 k - e2 k) i - W i := by
    have ex : x = fun k => (Mv bl Mi u k - Mv bl Mi W k) + (e1 k - e2 k) := by
      funext k; rw [hx k]; simp only [e1, e2]; ring
    rw [ex, Mv_add, Mv_sub, hMM i hi, hMM i hi]; ring
  -- `Δ x = Δ z - Δ g` because `x = z - g` on `J`
  have hDx : Dv Hs cl cf x i = Dv Hs cl cf z i - Dv Hs cl cf g i := by
    rw [← Dv_sub]
    apply Dv_congr Hs cl cf (hcl i hi)
    intro k hk
    have eW : Mv bl Mi W k = Mv bl Mi (Dv Hs cl cf z) k + Mv bl Mi e3 k := by
      rw [← Mv_add]; unfold Mv; exact sum_congr rfl fun _ _ => by simp only [e3]; ring
    simp only [g, e4, e2, hx k]; rw [eW]; ring
  have hres : Mv bl Mx x i + Dv Hs cl cf x i - u i =
      Mv bl Mx (fun k => e1 k - e2 k) i - e3 i - Dv Hs cl cf g i := by
    rw [hMx, hDx]; simp only [e3]; ring
  rw [hres]
  have b12 : |Mv bl Mx (fun k => e1 k - e2 k) i| ≤ A * (ε₁ + ε₂) := by
    have hF0 : 0 ≤ ε₁ + ε₂ := by
      have := h1 i hi; have := h2 i hi; have := abs_nonneg (y i - Mv bl Mi u i); linarith
    apply Mv_abs bl Mx (hA i hi) _ hF0
    intro k hk
    have hkI := hblI i hi hk
    have := abs_sub (e1 k) (e2 k)
    have := h1 k hkI; have := h2 k hkI
    linarith
  have hμ3 : ∀ k ∈ I, |Mv bl Mi e3 k| ≤ μ * ε₃ := hMi e3 ε₃ (fun k hk => h3 k hk)
  have bg : |Dv Hs cl cf g i| ≤ d * (ε₄ + μ * ε₃ + ε₂) := by
    apply Dv_abs Hs cl cf (hd i hi) (hcl i hi) _ (by positivity)
    intro k hk
    have hkI := hJI hk
    have := abs_add_le (e4 k + Mv bl Mi e3 k) (e2 k)
    have := abs_add_le (e4 k) (Mv bl Mi e3 k)
    have := h4 k hk; have := hμ3 k hkI; have := h2 k hkI
    simp only [g]; linarith
  have := abs_sub (Mv bl Mx (fun k => e1 k - e2 k) i - e3 i) (Dv Hs cl cf g i)
  have := abs_sub (Mv bl Mx (fun k => e1 k - e2 k) i) (e3 i)
  have := h3 i hi
  linarith

end res

end J6Seg

end

theorem solution : type_of% @J6Seg.res_bound_sol_aux := @J6Seg.res_bound_sol_aux
