theorem solution {Rh Ri : ℝ} (hRh : 0 < Rh) {h : ℝ → ℝ} (hh : HorizonC1 Rh h) :
    Tendsto (energy Rh Ri h) (𝓝[>] Rh) (𝓝 0) := by
  obtain ⟨η, hη, bt, hc, he⟩ := hh
  have hU : Rh ∈ Ioo (Rh - η) (Rh + η) := ⟨by linarith, by linarith⟩
  have hn : Ioo (Rh - η) (Rh + η) ∈ 𝓝 Rh := isOpen_Ioo.mem_nhds hU
  have cb : ContinuousAt bt Rh := hc.continuousOn.continuousAt hn
  have cd : ContinuousAt (deriv bt) Rh :=
    (hc.continuousOn_deriv_of_isOpen isOpen_Ioo le_rfl).continuousAt hn
  have cP : ContinuousAt (Pc Rh Ri) Rh := (hasDerivAt_Pc Rh Ri hRh.ne').continuousAt
  have cF : ContinuousAt (fun s => Pc Rh Ri s * bt s * deriv bt s) Rh := (cP.mul cb).mul cd
  have hP0 : Pc Rh Ri Rh = 0 := by unfold Pc N0; simp
  have hF : Tendsto (fun s => Pc Rh Ri s * bt s * deriv bt s) (𝓝[>] Rh) (𝓝 0) := by
    have := cF.tendsto
    rw [hP0, zero_mul, zero_mul] at this
    exact tendsto_nhdsWithin_of_tendsto_nhds this
  refine hF.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT (show Rh < Rh + η by linarith)] with s hs
  have hev : bt =ᶠ[𝓝 s] h := Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds hs) he
  unfold energy
  rw [he hs, hev.deriv_eq]
