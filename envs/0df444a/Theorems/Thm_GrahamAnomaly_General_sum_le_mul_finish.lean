-- title:
--   (5), proof of Theorem 1, p. 420 — total work is at most n times the finishing time
-- statement:
--   If tasks of positive durations $\mu(T_j)$ run feasibly without interruption on $n$ identical processors and finish at time $\omega$, then
--
--   $$\sum_j\mu(T_j)\le n\omega.$$
--
--   This is the work-volume estimate used in the upper-bound step of Graham's display (5): no processor can execute more than $\omega$ units of tasks before all tasks finish.
--
--   **Formalization Note** The estimate is stated for every feasible schedule, including one not generated by the priority-list rule. The empty task case has both sides zero.
-- source:
--   Graham, Bounds on multiprocessing timing anomalies, SIAM J. Appl. Math. 17 (1969), p. 420, work-volume step in display (5), proof of Theorem 1; https://doi.org/10.1137/0117039

import Mathlib
import Definitions.Def_GrahamAnomaly_General_Model

namespace GrahamAnomaly.General

/-- The work-volume step used in display (5): `n` processors provide at most
`n * ω` units of processing before the finish. -/
theorem sum_le_mul_finish {r n : ℕ}
    (μ : Fin r → ℝ) (hμ : ∀ j, 0 < μ j)
    (prec : Fin r → Fin r → Prop) (G : Schedule n μ prec) :
    ∑ j, μ j ≤ (n : ℝ) * G.finish := by sorry

end GrahamAnomaly.General
