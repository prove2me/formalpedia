    let σ₂ : B (e j').1 →ₐ[S] C₀ := IsLocalization.liftAlgHom (M := Submonoid.powers (r (e j').1)) (f := Algebra.ofId S C₀)
      (hunit (r (e j').1) (r (e j).1 * r (e j').1) C₀ (dvd_mul_left _ _))
    have hdvd : r (e j).1 * r (e j').1 ∣ r' j * r' j' := by
      show r (e j).1 * r (e j').1 ∣ (r (e j).1 * a j) * (r (e j').1 * a j')
      exact ⟨a j * a j', by ring⟩
    let τ : C₀ →ₐ[S] C := IsLocalization.liftAlgHom (M := Submonoid.powers (r (e j).1 * r (e j').1)) (f := Algebra.ofId S C)
      (hunit (r (e j).1 * r (e j').1) (r' j * r' j') C hdvd)
    obtain ⟨w₁, hw₁⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback σ₁.toRingHom (u (e j).1)
    obtain ⟨w₂, hw₂⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback σ₂.toRingHom (u (e j').1)
    have hw : PolarisedAbelianScheme.Iso w₁ w₂ := hu (e j).1 (e j').1 C₀ σ₁ σ₂ w₁ w₂ hw₁ hw₂
    obtain ⟨w₁', hw₁'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback τ.toRingHom w₁
    obtain ⟨w₂', hw₂'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback τ.toRingHom w₂
    have hw' : PolarisedAbelianScheme.Iso w₁' w₂' := AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange τ.toRingHom w₁ w₂ w₁' w₂' hw hw₁' hw₂'

    have heq₁ : ρ₁.toRingHom.comp (algebraMap (B (e j).1) (B' j)) = τ.toRingHom.comp σ₁.toRingHom := by
      have := @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (Submonoid.powers (r (e j).1)) (S := B (e j).1) (P := C))
        (ρ₁.comp (IsScalarTower.toAlgHom S (B (e j).1) (B' j))) (τ.comp σ₁)
      exact congrArg AlgHom.toRingHom this
    have heq₂ : ρ₂.toRingHom.comp (algebraMap (B (e j').1) (B' j')) = τ.toRingHom.comp σ₂.toRingHom := by
      have := @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (Submonoid.powers (r (e j').1)) (S := B (e j').1) (P := C))
        (ρ₂.comp (IsScalarTower.toAlgHom S (B (e j').1) (B' j'))) (τ.comp σ₂)
      exact congrArg AlgHom.toRingHom this
    have hv₁' : PolarisedAbelianScheme.IsPullback (τ.toRingHom.comp σ₁.toRingHom) (u (e j).1) v₁ := by
      rw [← heq₁]; exact AlgebraicGeometry.PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ (hu' j) hv₁
    have hv₂' : PolarisedAbelianScheme.IsPullback (τ.toRingHom.comp σ₂.toRingHom) (u (e j').1) v₂ := by
      rw [← heq₂]; exact AlgebraicGeometry.PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ (hu' j') hv₂
    have i₁ : PolarisedAbelianScheme.Iso v₁ w₁' :=
      AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange _ _ _ v₁ w₁' ((RST _ _).1 _) hv₁' (AlgebraicGeometry.PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hw₁ hw₁')
    have i₂ : PolarisedAbelianScheme.Iso v₂ w₂' :=
      AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange _ _ _ v₂ w₂' ((RST _ _).1 _) hv₂' (AlgebraicGeometry.PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hw₂ hw₂')
    exact (RST _ _).2.2 _ _ _ i₁ ((RST _ _).2.2 _ _ _ hw' ((RST _ _).2.1 _ _ i₂))

  obtain ⟨u₀, hu₀⟩ := H r' hr' B' u' htriv' hov'
  refine ⟨u₀, fun i v hv => ?_⟩

  have hnB : IsUnit ((n : ℕ) : B i) := by have := hn'.map (algebraMap S (B i)); rwa [map_natCast] at this
  have main : ∀ (p : J) (v : PolarisedAbelianScheme g d n (B p.1)),
      PolarisedAbelianScheme.IsPullback (algebraMap S (B p.1)) u₀ v →
      ∀ (w w' : PolarisedAbelianScheme g d n (Localization.Away (s p.1 p.2))),
      PolarisedAbelianScheme.IsPullback (algebraMap (B p.1) (Localization.Away (s p.1 p.2))) v w →
      PolarisedAbelianScheme.IsPullback (algebraMap (B p.1) (Localization.Away (s p.1 p.2))) (u p.1) w' →
      PolarisedAbelianScheme.Iso w w' := by
    intro p v hv w w' hw hw'
    obtain ⟨j, rfl⟩ : ∃ j, e j = p := ⟨e.symm p, e.apply_symm_apply p⟩
    have hwS : PolarisedAbelianScheme.IsPullback (algebraMap S (B' j)) u₀ w := by
      rw [IsScalarTower.algebraMap_eq S (B (e j).1) (B' j)]
      exact AlgebraicGeometry.PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hv hw
    have i₁ : PolarisedAbelianScheme.Iso w (u' j) := hu₀ j w hwS
    have i₂ : PolarisedAbelianScheme.Iso (u' j) w' := AlgebraicGeometry.PolarisedAbelianScheme.Iso.baseChange _ _ _ (u' j) w' ((RST _ _).1 _) (hu' j) hw'
    exact (RST _ _).2.2 _ _ _ i₁ i₂
  exact AlgebraicGeometry.PolarisedAbelianScheme.iso_of_forall_isPullback_iso_of_three_le hn hnB (s i) (hs i) (fun m => Localization.Away (s i m)) v (u i)
    (fun m w w' hw hw' => main ⟨i, m⟩ v hv w w' hw hw')

