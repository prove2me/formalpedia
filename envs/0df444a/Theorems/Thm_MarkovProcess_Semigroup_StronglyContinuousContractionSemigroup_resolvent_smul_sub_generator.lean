variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (S : StronglyContinuousContractionSemigroup E)












open MarkovProcess.Semigroup.StronglyContinuousContractionSemigroup in

theorem MarkovProcess.Semigroup.StronglyContinuousContractionSemigroup.resolvent_smul_sub_generator (μ : PositiveShift) (f : S.generatorDomain) :
    S.resolvent μ ((μ : ℝ) • (f : E) - S.generator f) = f := by sorry
