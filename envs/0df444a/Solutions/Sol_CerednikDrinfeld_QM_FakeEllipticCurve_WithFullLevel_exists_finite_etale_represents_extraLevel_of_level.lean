  induction m with
  | zero => rw [Nat.zero_mul, RelativeGroupLaw.nsmul_zero, RelativeGroupLaw.nsmul_zero]
  | succ m ih => rw [Nat.succ_mul, nsmul_add', ih, RelativeGroupLaw.nsmul_succ]

