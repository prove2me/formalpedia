  choose star hstar using hnorm μ hμ
  obtain ⟨β, hβ⟩ := QuaternionAlgebra.IsMaximalOrder.exists_forall_existsUnique_eq_sum_zsmul Λ hΛ
  haveI h66 : ∀ i : Fin 2, NeZero ((![6, 6] : Fin 2 → ℕ) i) := by
