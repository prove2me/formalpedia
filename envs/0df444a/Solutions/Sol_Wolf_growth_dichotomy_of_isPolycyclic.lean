/-!
# Chou §3, p. 399: the growth rate of a finitely generated group

Milnor's observation that `|B(n)|^{1/n}` converges, and Wolf's observation that exponential
growth does not depend on the choice of finite generating set.  Both come from Fekete's lemma
applied to the subadditive sequence `n ↦ log |B(n)|`: Mathlib's `Subadditive.lim` is *defined*
as the infimum of `u n / n` over `n ≥ 1`, so the limit `v` satisfies `v ^ n ≤ |B(n)|` for
**every** `n`, not merely eventually — which is what the `∀ n` in `HasExponentialGrowth` needs.
-/

namespace Chou
namespace Lib

open Chou

variable {G : Type*} [Group G]

/-! ### Elementary properties of word balls -/

lemma one_mem_wordBall (S : Set G) (n : ℕ) : (1 : G) ∈ wordBall S n :=
  ⟨[], by simp, by simp, by simp⟩

lemma wordBall_mono (S : Set G) {m n : ℕ} (h : m ≤ n) : wordBall S m ⊆ wordBall S n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen.trans h, hmem, rfl⟩

lemma mul_mem_wordBall {S : Set G} {a b : G} {m n : ℕ} (ha : a ∈ wordBall S m)
    (hb : b ∈ wordBall S n) : a * b ∈ wordBall S (m + n) := by
  obtain ⟨l₁, h₁, hm₁, rfl⟩ := ha
  obtain ⟨l₂, h₂, hm₂, rfl⟩ := hb
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · simpa using Nat.add_le_add h₁ h₂
  · intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hm₁ x h
    · exact hm₂ x h
  · simp

lemma inv_mem_wordBall {S : Set G} {a : G} {n : ℕ} (ha : a ∈ wordBall S n) :
    a⁻¹ ∈ wordBall S n := by
  obtain ⟨l, hlen, hmem, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, ?_, (List.prod_inv_reverse l).symm⟩
  · simpa using hlen
  · intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hmem y hy with h | h
    · exact Or.inr (by simpa using h)
    · exact Or.inl h

/-- Every element of the subgroup generated by `T` lies in some `T`-ball. -/
lemma exists_mem_wordBall_of_mem_closure {T : Set G} {g : G} (hg : g ∈ Subgroup.closure T) :
    ∃ m : ℕ, g ∈ wordBall T m := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, [x], by simp, by simpa using Or.inl hx, by simp⟩
  | one => exact ⟨0, one_mem_wordBall T 0⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨m, hm⟩ := ihx
      obtain ⟨n, hn⟩ := ihy
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv x _ ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m, inv_mem_wordBall hm⟩

/-- Comparison of balls for two generating sets: if every element of `T` is an `S`-word of
length at most `k`, then the `T`-ball of radius `n` sits inside the `S`-ball of radius `k * n`. -/
lemma wordBall_subset_wordBall_of_forall_mem {S T : Set G} {k : ℕ}
    (h : ∀ t ∈ T, t ∈ wordBall S k) (n : ℕ) : wordBall T n ⊆ wordBall S (k * n) := by
  have hstep : ∀ x : G, (x ∈ T ∨ x⁻¹ ∈ T) → x ∈ wordBall S k := by
    rintro x (hx | hx)
    · exact h x hx
    · simpa using inv_mem_wordBall (h _ hx)
  have main : ∀ l : List G, (∀ x ∈ l, x ∈ wordBall S k) →
      l.prod ∈ wordBall S (k * l.length) := by
    intro l
    induction l with
    | nil => intro _; simpa using one_mem_wordBall S 0
    | cons a t ih =>
        intro hl
        have harith : k * (a :: t).length = k + k * t.length := by
          simp only [List.length_cons]; ring
        rw [List.prod_cons, harith]
        exact mul_mem_wordBall (hl a (by simp)) (ih fun x hx => hl x (List.mem_cons_of_mem _ hx))
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact wordBall_mono S (Nat.mul_le_mul le_rfl hlen) (main l fun x hx => hstep x (hmem x hx))

/-! ### Finiteness and cardinality of balls -/

/-- For a finite generating set the balls are finite. -/
lemma finite_wordBall (S : Finset G) (n : ℕ) : (wordBall (S : Set G) n).Finite := by
  classical
  set T : Finset G := S ∪ S.image (fun x => x⁻¹) with hT
  have key : wordBall (S : Set G) n ⊆
      (fun l : List T => (l.map Subtype.val).prod) '' {l : List T | l.length ≤ n} := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    have hmemT : ∀ x ∈ l, x ∈ T := by
      intro x hx
      rcases hmem x hx with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, h, by simp⟩)
    refine ⟨l.attach.map (fun x => (⟨x.1, hmemT x.1 x.2⟩ : T)), ?_, ?_⟩
    · simpa using hlen
    · simp
  exact Set.Finite.subset (Set.Finite.image _ (List.finite_length_le _ n)) key

lemma one_le_card_wordBall (S : Finset G) (n : ℕ) : 1 ≤ Nat.card (wordBall (S : Set G) n) := by
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_pos (finite_wordBall S n)).2 ⟨1, one_mem_wordBall _ _⟩

lemma card_wordBall_pos (S : Finset G) (n : ℕ) :
    (0 : ℝ) < (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  exact_mod_cast one_le_card_wordBall S n

/-- Submultiplicativity of the ball sizes: a word of length `≤ m + n` splits as a word of
length `≤ m` times a word of length `≤ n`. -/
lemma card_wordBall_add_le (S : Finset G) (m n : ℕ) :
    Nat.card (wordBall (S : Set G) (m + n)) ≤
      Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
  have hfin : (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n).Finite :=
    (finite_wordBall S m).prod (finite_wordBall S n)
  have hsub : wordBall (S : Set G) (m + n) ⊆
      (fun p : G × G => p.1 * p.2) ''
        (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    refine ⟨((l.take m).prod, (l.drop m).prod), ⟨⟨l.take m, ?_, ?_, rfl⟩,
      ⟨l.drop m, ?_, ?_, rfl⟩⟩, ?_⟩
    · simp
    · exact fun x hx => hmem x (List.mem_of_mem_take hx)
    · have hd : (l.drop m).length = l.length - m := List.length_drop ..
      omega
    · exact fun x hx => hmem x (List.mem_of_mem_drop hx)
    · simp [← List.prod_append, List.take_append_drop]
  calc Nat.card (wordBall (S : Set G) (m + n))
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_prod

lemma card_wordBall_le_of_subset {S T : Finset G} {m n : ℕ}
    (h : wordBall (S : Set G) m ⊆ wordBall (T : Set G) n) :
    Nat.card (wordBall (S : Set G) m) ≤ Nat.card (wordBall (T : Set G) n) := by
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard h (finite_wordBall T n)

/-! ### Fekete's lemma applied to `log |B(n)|` -/

/-- The logarithm of the size of the ball of radius `n`. -/
noncomputable def logBall (S : Finset G) (n : ℕ) : ℝ :=
  Real.log (Nat.card (wordBall (S : Set G) n))

lemma logBall_nonneg (S : Finset G) (n : ℕ) : 0 ≤ logBall S n :=
  Real.log_nonneg (by exact_mod_cast one_le_card_wordBall S n)

lemma exp_logBall (S : Finset G) (n : ℕ) :
    Real.exp (logBall S n) = (Nat.card (wordBall (S : Set G) n) : ℝ) :=
  Real.exp_log (card_wordBall_pos S n)

lemma subadditive_logBall (S : Finset G) : Subadditive (logBall S) := by
  intro m n
  have h1 := card_wordBall_pos S m
  have h2 := card_wordBall_pos S n
  have hle : (Nat.card (wordBall (S : Set G) (m + n)) : ℝ) ≤
      (Nat.card (wordBall (S : Set G) m) : ℝ) * (Nat.card (wordBall (S : Set G) n) : ℝ) := by
    exact_mod_cast card_wordBall_add_le S m n
  calc logBall S (m + n)
      ≤ Real.log ((Nat.card (wordBall (S : Set G) m) : ℝ) *
          (Nat.card (wordBall (S : Set G) n) : ℝ)) :=
        Real.log_le_log (card_wordBall_pos S (m + n)) hle
    _ = logBall S m + logBall S n := Real.log_mul h1.ne' h2.ne'

lemma bddBelow_logBall_div (S : Finset G) :
    BddBelow (Set.range fun n : ℕ => logBall S n / n) := by
  refine ⟨0, ?_⟩
  rintro x ⟨n, rfl⟩
  exact div_nonneg (logBall_nonneg S n) (Nat.cast_nonneg n)

/-- The growth rate of `G` with respect to the finite generating set `S`:
`exp` of Fekete's limit of `log |B(n)| / n`. -/
noncomputable def growthRate (S : Finset G) : ℝ := Real.exp (subadditive_logBall S).lim

lemma growthRate_eq (S : Finset G) : growthRate S = Real.exp (subadditive_logBall S).lim := rfl

lemma growthRate_pos (S : Finset G) : 0 < growthRate S := Real.exp_pos _

lemma tendsto_logBall_div (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => logBall S n / n) Filter.atTop
      (nhds (subadditive_logBall S).lim) :=
  (subadditive_logBall S).tendsto_lim (bddBelow_logBall_div S)

lemma card_wordBall_rpow_eq_exp (S : Finset G) (n : ℕ) :
    (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) = Real.exp (logBall S n / n) := by
  rw [Real.rpow_def_of_pos (card_wordBall_pos S n), mul_one_div]
  rfl

/-- Milnor, p. 399: `|B(n)|^{1/n}` converges to `growthRate S`. -/
theorem tendsto_card_wordBall_rpow_inv (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds (growthRate S)) := by
  refine Filter.Tendsto.congr (fun n => (card_wordBall_rpow_eq_exp S n).symm) ?_
  exact (Real.continuous_exp.tendsto _).comp (tendsto_logBall_div S)

/-- **The infimum characterisation.**  `Subadditive.lim` is an infimum, so the growth rate is a
*lower* bound for every `|B(n)|^{1/n}` with `n ≥ 1`, not merely a limit. -/
theorem growthRate_le_card_wordBall_rpow_inv (S : Finset G) {n : ℕ} (hn : n ≠ 0) :
    growthRate S ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) := by
  rw [card_wordBall_rpow_eq_exp]
  exact Real.exp_le_exp.2 ((subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn)

/-- The form in which the infimum characterisation is used: `v ^ n ≤ |B(n)|` for **every** `n`. -/
theorem growthRate_pow_le_card_wordBall (S : Finset G) (n : ℕ) :
    growthRate S ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simpa using (by exact_mod_cast one_le_card_wordBall S 0 :
      (1 : ℝ) ≤ (Nat.card (wordBall (S : Set G) 0) : ℝ))
  · have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hle := (subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn.ne'
    rw [le_div_iff₀ hn'] at hle
    have h1 : growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) :=
      (Real.exp_nat_mul _ n).symm
    calc growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) := h1
      _ ≤ Real.exp (logBall S n) := Real.exp_le_exp.2 (by linarith)
      _ = (Nat.card (wordBall (S : Set G) n) : ℝ) := exp_logBall S n

/-! ### The two theorems -/

/-- p. 399, Milnor's theorem as Chou states it: for a finite generating set `S`, the growth rate
`lim |B(n)|^{1/n}` exists. -/
theorem exists_tendsto_card_wordBall_rpow_inv' {G : Type*} [Group G] (S : Finset G)
    (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ v : ℝ, Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds v) :=
  ⟨growthRate S, tendsto_card_wordBall_rpow_inv S⟩

/-- Every `S`-ball sits inside a `T`-ball of a uniformly rescaled radius, when `T` generates. -/
lemma exists_wordBall_subset (S T : Finset G) (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (S : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  classical
  have H : ∀ s ∈ S, ∃ m : ℕ, s ∈ wordBall (T : Set G) m := fun s _ =>
    exists_mem_wordBall_of_mem_closure (by rw [hT]; trivial)
  choose f hf using H
  refine ⟨(S.attach.sup fun s => f s.1 s.2) + 1, Nat.succ_pos _, fun n => ?_⟩
  refine wordBall_subset_wordBall_of_forall_mem (fun s hs => ?_) n
  have hs' : s ∈ S := hs
  refine wordBall_mono _ ?_ (hf s hs')
  have hsup : f s hs' ≤ S.attach.sup fun s : {x // x ∈ S} => f s.1 s.2 :=
    Finset.le_sup (f := fun s : {x // x ∈ S} => f s.1 s.2) (Finset.mem_attach S ⟨s, hs'⟩)
  omega

/-- p. 399 (Wolf): exponential growth does not depend on the choice of the finite generating
set. -/
theorem hasExponentialGrowth_iff_forall' {G : Type*} [Group G] [Group.FG G] :
    HasExponentialGrowth G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ →
        ∃ c : ℝ, 1 < c ∧ ∀ n : ℕ, c ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  constructor
  · rintro ⟨S, -, c, hc, hcn⟩ T hT
    obtain ⟨k, hk, hkn⟩ := exists_wordBall_subset S T hT
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    -- the `T`-balls of radius `k * n` are at least as big as the `S`-balls of radius `n`
    have hball : ∀ n : ℕ, (c : ℝ) ^ n ≤ (Nat.card (wordBall (T : Set G) (k * n)) : ℝ) := by
      intro n
      refine (hcn n).trans ?_
      exact_mod_cast card_wordBall_le_of_subset (hkn n)
    -- hence `log c / k` is a lower bound along the subsequence `k * n`
    have hdiv : ∀ n : ℕ, 1 ≤ n → Real.log c / k ≤ logBall T (k * n) / ((k * n : ℕ) : ℝ) := by
      intro n hn
      have hnR : (0 : ℝ) < n := by exact_mod_cast hn
      have h1 : (n : ℝ) * Real.log c ≤ logBall T (k * n) := by
        have hlog := Real.log_le_log (by positivity : (0 : ℝ) < c ^ n) (hball n)
        rwa [Real.log_pow] at hlog
      rw [div_le_div_iff₀ hkR (by push_cast; positivity)]
      have h2 : (k : ℝ) * ((n : ℝ) * Real.log c) ≤ (k : ℝ) * logBall T (k * n) :=
        mul_le_mul_of_nonneg_left h1 hkR.le
      push_cast
      linarith
    -- Fekete's limit is at least `log c / k`
    have hmul : Filter.Tendsto (fun n : ℕ => k * n) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_mul_of_pos_left n hk) Filter.tendsto_id
    have hsubseq : Filter.Tendsto (fun n : ℕ => logBall T (k * n) / ((k * n : ℕ) : ℝ))
        Filter.atTop (nhds (subadditive_logBall T).lim) := (tendsto_logBall_div T).comp hmul
    have hge : Real.log c / k ≤ (subadditive_logBall T).lim :=
      ge_of_tendsto hsubseq (Filter.eventually_atTop.2 ⟨1, fun n hn => hdiv n hn⟩)
    refine ⟨growthRate T, ?_, growthRate_pow_le_card_wordBall T⟩
    have hpos : (0 : ℝ) < Real.log c / k := div_pos (Real.log_pos hc) hkR
    calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
      _ < Real.exp (subadditive_logBall T).lim := Real.exp_lt_exp.2 (lt_of_lt_of_le hpos hge)
      _ = growthRate T := (growthRate_eq T).symm
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    obtain ⟨c, hc, hcn⟩ := h S hS
    exact ⟨S, hS, c, hc, hcn⟩

end Lib
end Chou

/-!
# Polycyclic groups (Wolf, Proposition 4.1 (1), p. 433)

Basic closure properties of `MilnorWolf.IsPolycyclic`: trivial groups and cyclic groups are
polycyclic, the notion is invariant under isomorphism, finitely generated abelian groups are
polycyclic, and an extension of a polycyclic group by a polycyclic group is polycyclic
(Rosenblatt's Remark 4.3).  Polycyclic groups are finitely generated and finitely presented.

The `Fin (t + 1)`-indexed normal series of the published definition is replaced, for the duration
of the proofs, by the `ℕ`-indexed characterisation `MilnorWolf.Lib.IsPolyChain`: a chain
`A : ℕ → Subgroup G` with `A 0 = ⊤`, eventually `⊥`, and each step normal with cyclic quotient.
-/

universe u v

namespace MilnorWolf
namespace Lib

open Function Subgroup

/-! ### One step of a normal series -/

/-- One step `H ⊆ K` of a normal series: `H ≤ K`, `H` is normal in `K`, and `K/H` is cyclic. -/
def IsCyclicStep {G : Type*} [Group G] (H K : Subgroup G) : Prop :=
  H ≤ K ∧ ∃ _ : (H.subgroupOf K).Normal, IsCyclic (K ⧸ H.subgroupOf K)

/-- Transport of "normal with cyclic quotient" along a surjection, by pulling the subgroup back. -/
theorem normal_isCyclic_comap {A B : Type*} [Group A] [Group B] (φ : A →* B)
    (hφ : Surjective φ) {Q : Subgroup B} (hn : Q.Normal) (hc : IsCyclic (B ⧸ Q)) :
    ∃ _ : (Q.comap φ).Normal, IsCyclic (A ⧸ Q.comap φ) := by
  have : Q.Normal := hn
  have hn' : (Q.comap φ).Normal := hn.comap φ
  refine ⟨hn', ?_⟩
  have hker : Q.comap φ = ((QuotientGroup.mk' Q).comp φ).ker := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
  have hs : Surjective ((QuotientGroup.mk' Q).comp φ) :=
    (QuotientGroup.mk'_surjective Q).comp hφ
  have e : A ⧸ Q.comap φ ≃* B ⧸ Q :=
    (QuotientGroup.quotientMulEquivOfEq hker).trans
      (QuotientGroup.quotientKerEquivOfSurjective _ hs)
  exact isCyclic_of_surjective e.symm e.symm.surjective

/-- The restriction of `f : G →* H` to the preimage of `K`. -/
def restrictComap {G H : Type*} [Group G] [Group H] (f : G →* H) (K : Subgroup H) :
    ↥(K.comap f) →* ↥K :=
  (f.comp (K.comap f).subtype).codRestrict K (fun x => Subgroup.mem_comap.mp x.2)

@[simp] theorem restrictComap_coe {G H : Type*} [Group G] [Group H] (f : G →* H) (K : Subgroup H)
    (x : ↥(K.comap f)) : ((restrictComap f K x : ↥K) : H) = f (x : G) := rfl

theorem restrictComap_surjective {G H : Type*} [Group G] [Group H] {f : G →* H}
    (hf : Surjective f) (K : Subgroup H) : Surjective (restrictComap f K) := by
  rintro ⟨y, hy⟩
  obtain ⟨x, rfl⟩ := hf y
  exact ⟨⟨x, by simpa using hy⟩, rfl⟩

/-- A step of a normal series pulls back along a surjection. -/
theorem IsCyclicStep.comap {G H : Type*} [Group G] [Group H] {f : G →* H} (hf : Surjective f)
    {K₂ K₁ : Subgroup H} (h : IsCyclicStep K₂ K₁) :
    IsCyclicStep (K₂.comap f) (K₁.comap f) := by
  obtain ⟨hle, hnorm, hcyc⟩ := h
  refine ⟨Subgroup.comap_mono hle, ?_⟩
  have hkey : (K₂.subgroupOf K₁).comap (restrictComap f K₁) =
      (K₂.comap f).subgroupOf (K₁.comap f) := by
    ext x
    simp [Subgroup.mem_subgroupOf]
  have := normal_isCyclic_comap (restrictComap f K₁) (restrictComap_surjective hf K₁)
    hnorm hcyc
  rwa [hkey] at this

/-- A step of a normal series pushes forward along an injection. -/
theorem IsCyclicStep.map {G H : Type*} [Group G] [Group H] {f : G →* H} (hf : Injective f)
    {H₂ H₁ : Subgroup G} (h : IsCyclicStep H₂ H₁) :
    IsCyclicStep (H₂.map f) (H₁.map f) := by
  obtain ⟨hle, hnorm, hcyc⟩ := h
  refine ⟨Subgroup.map_mono hle, ?_⟩
  have hcoe : ∀ x : ↥(H₁.map f),
      f (((Subgroup.equivMapOfInjective H₁ f hf).symm x : ↥H₁) : G) = (x : H) := by
    intro x
    conv_rhs => rw [← MulEquiv.apply_symm_apply (Subgroup.equivMapOfInjective H₁ f hf) x]
    exact (Subgroup.coe_equivMapOfInjective_apply H₁ f hf _).symm
  have hkey : (H₂.subgroupOf H₁).comap
      ((Subgroup.equivMapOfInjective H₁ f hf).symm : ↥(H₁.map f) →* ↥H₁) =
      (H₂.map f).subgroupOf (H₁.map f) := by
    ext x
    simp only [Subgroup.mem_comap, Subgroup.mem_subgroupOf]
    rw [← hcoe x]
    exact (Subgroup.mem_map_iff_mem hf).symm
  have := normal_isCyclic_comap
    ((Subgroup.equivMapOfInjective H₁ f hf).symm : ↥(H₁.map f) →* ↥H₁)
    (Subgroup.equivMapOfInjective H₁ f hf).symm.surjective hnorm hcyc
  rwa [hkey] at this

theorem IsCyclicStep.congr {G : Type*} [Group G] {H K H' K' : Subgroup G} (h : IsCyclicStep H K)
    (e₁ : H = H') (e₂ : K = K') : IsCyclicStep H' K' := e₁ ▸ e₂ ▸ h

/-- The trivial step `⊥ ⊆ ⊥`. -/
theorem isCyclicStep_of_eq_bot {G : Type*} [Group G] {H K : Subgroup G} (hH : H = ⊥)
    (hK : K = ⊥) : IsCyclicStep H K := by
  subst hH; subst hK
  have hn : ((⊥ : Subgroup G).subgroupOf ⊥).Normal := by
    rw [Subgroup.subgroupOf_bot_eq_top]; infer_instance
  exact ⟨le_rfl, hn,
    isCyclic_of_surjective (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)⟩

/-- The step `⊥ ⊆ ⊤` of a cyclic group. -/
theorem isCyclicStep_bot_top {G : Type*} [Group G] [IsCyclic G] :
    IsCyclicStep (⊥ : Subgroup G) ⊤ := by
  have hn : ((⊥ : Subgroup G).subgroupOf ⊤).Normal := by
    rw [Subgroup.bot_subgroupOf]; infer_instance
  exact ⟨bot_le, hn,
    isCyclic_of_surjective (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)⟩

/-! ### An `ℕ`-indexed characterisation of `IsPolycyclic` -/

/-- A normal series of `G` indexed by `ℕ`: `A 0 = ⊤`, some `A t = ⊥`, and every step
`A (i+1) ⊆ A i` is normal with cyclic quotient. -/
def IsPolyChain {G : Type*} [Group G] (A : ℕ → Subgroup G) : Prop :=
  A 0 = ⊤ ∧ (∃ t, A t = ⊥) ∧ ∀ i, IsCyclicStep (A (i + 1)) (A i)

theorem isPolycyclic_of_chain {G : Type*} [Group G] {A : ℕ → Subgroup G} (h : IsPolyChain A) :
    IsPolycyclic G := by
  obtain ⟨h0, ⟨t, ht⟩, hstep⟩ := h
  exact ⟨t, fun i => A i.val, h0, ht, fun i => hstep i.val⟩

theorem exists_chain_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) :
    ∃ A : ℕ → Subgroup G, IsPolyChain A := by
  obtain ⟨t, A, h0, hlast, hstep⟩ := h
  have hbot : ∀ m, t ≤ m →
      A ⟨min m t, Nat.lt_succ_of_le (min_le_right m t)⟩ = ⊥ := by
    intro m hm
    rw [← hlast]
    exact congrArg A (Fin.ext (by simp [Fin.val_last]; omega))
  refine ⟨fun n => A ⟨min n t, Nat.lt_succ_of_le (min_le_right n t)⟩, ?_, ⟨t, ?_⟩, ?_⟩
  · rw [← h0]; exact congrArg A (Fin.ext (by simp))
  · exact hbot t le_rfl
  · intro i
    rcases lt_or_ge i t with hi | hi
    · refine IsCyclicStep.congr (hstep ⟨i, hi⟩) (congrArg A (Fin.ext ?_))
        (congrArg A (Fin.ext ?_))
      · simp only [Fin.val_succ]; omega
      · simp only [Fin.val_castSucc]; omega
    · exact isCyclicStep_of_eq_bot (hbot (i + 1) (by omega)) (hbot i hi)

theorem isPolycyclic_iff_exists_chain {G : Type*} [Group G] :
    IsPolycyclic G ↔ ∃ A : ℕ → Subgroup G, IsPolyChain A :=
  ⟨exists_chain_of_isPolycyclic, fun ⟨_, h⟩ => isPolycyclic_of_chain h⟩

/-! ### The basic examples -/

/-- A trivial group is polycyclic. -/
theorem isPolycyclic_of_subsingleton {G : Type*} [Group G] [Subsingleton G] :
    IsPolycyclic G := by
  have hbot : (⊥ : Subgroup G) = ⊤ := by
    ext x
    simp [Subsingleton.elim x 1]
  exact isPolycyclic_of_chain (A := fun _ => ⊥)
    ⟨hbot, ⟨0, rfl⟩, fun _ => isCyclicStep_of_eq_bot rfl rfl⟩

/-- Being polycyclic is invariant under isomorphism. -/
theorem isPolycyclic_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (h : IsPolycyclic G) : IsPolycyclic H := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  refine isPolycyclic_of_chain (A := fun n => (A n).map (e : G →* H)) ⟨?_, ⟨t, ?_⟩, ?_⟩
  · show (A 0).map (e : G →* H) = ⊤
    rw [h0]; exact Subgroup.map_top_of_surjective _ e.surjective
  · show (A t).map (e : G →* H) = ⊥
    rw [ht]; exact Subgroup.map_bot _
  · exact fun i => (hstep i).map (EquivLike.injective e)

/-- A cyclic group is polycyclic. -/
theorem isPolycyclic_of_isCyclic {G : Type*} [Group G] [IsCyclic G] : IsPolycyclic G := by
  refine isPolycyclic_of_chain (A := fun n => if n = 0 then ⊤ else ⊥) ⟨rfl, ⟨1, rfl⟩, ?_⟩
  intro i
  match i with
  | 0 => exact isCyclicStep_bot_top
  | (j + 1) => exact isCyclicStep_of_eq_bot rfl rfl

/-! ### Extensions -/

/-- Rosenblatt's Remark 4.3: an extension of a polycyclic group by a polycyclic group is
polycyclic. -/
theorem isPolycyclic_of_extension {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (hN : IsPolycyclic N) (hQ : IsPolycyclic (G ⧸ N)) : IsPolycyclic G := by
  obtain ⟨C, hC0, ⟨a, hCa⟩, hCstep⟩ := exists_chain_of_isPolycyclic hN
  obtain ⟨B, hB0, ⟨b0, hBb0⟩, hBstep⟩ := exists_chain_of_isPolycyclic hQ
  obtain ⟨b, hb1, hBb⟩ : ∃ b, 1 ≤ b ∧ B b = ⊥ :=
    ⟨b0 + 1, by omega, le_bot_iff.mp (by rw [← hBb0]; exact (hBstep b0).1)⟩
  have hmkN : (B b).comap (QuotientGroup.mk' N) = N := by
    rw [hBb, MonoidHom.comap_bot, QuotientGroup.ker_mk']
  have hsubN : (C 0).map N.subtype = N := by
    rw [hC0, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  refine isPolycyclic_of_chain
    (A := fun i => if i < b then (B i).comap (QuotientGroup.mk' N)
      else (C (i - b)).map N.subtype) ⟨?_, ⟨b + a, ?_⟩, ?_⟩
  · show (if (0 : ℕ) < b then (B 0).comap (QuotientGroup.mk' N)
      else (C (0 - b)).map N.subtype) = ⊤
    rw [if_pos (by omega : (0 : ℕ) < b), hB0, Subgroup.comap_top]
  · show (if b + a < b then (B (b + a)).comap (QuotientGroup.mk' N)
      else (C (b + a - b)).map N.subtype) = ⊥
    rw [if_neg (by omega), show b + a - b = a by omega, hCa, Subgroup.map_bot]
  · intro i
    show IsCyclicStep
      (if i + 1 < b then (B (i + 1)).comap (QuotientGroup.mk' N)
        else (C (i + 1 - b)).map N.subtype)
      (if i < b then (B i).comap (QuotientGroup.mk' N) else (C (i - b)).map N.subtype)
    rcases lt_or_ge (i + 1) b with h1 | h1
    · rw [if_pos h1, if_pos (by omega : i < b)]
      exact (hBstep i).comap (QuotientGroup.mk'_surjective N)
    · rcases lt_or_ge i b with hi | hi
      · have hib : i + 1 = b := by omega
        rw [if_neg (by omega), if_pos hi, show i + 1 - b = 0 by omega]
        refine IsCyclicStep.congr ((hBstep i).comap (QuotientGroup.mk'_surjective N)) ?_ rfl
        rw [hib, hmkN, hsubN]
      · rw [if_neg (by omega), if_neg (by omega), show i + 1 - b = (i - b) + 1 by omega]
        exact (hCstep (i - b)).map (Subgroup.subtype_injective N)

/-! ### Finitely generated abelian groups -/

theorem isPolycyclic_of_top_eq_bot {G : Type*} [Group G] (h : (⊤ : Subgroup G) = ⊥) :
    IsPolycyclic G := by
  have : Subsingleton G := ⟨fun x y => by
    have hx : x ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top x
    have hy : y ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top y
    rw [Subgroup.mem_bot] at hx hy
    rw [hx, hy]⟩
  exact isPolycyclic_of_subsingleton

/-- Induction on the size of a generating family: an abelian group generated by `n` elements is
polycyclic. -/
theorem isPolycyclic_commGroup_aux (n : ℕ) : ∀ (G : Type u) [CommGroup G] (s : Fin n → G),
    Subgroup.closure (Set.range s) = ⊤ → IsPolycyclic G := by
  induction n with
  | zero =>
    intro G _ s hgen
    refine isPolycyclic_of_top_eq_bot ?_
    rw [← hgen, Set.range_eq_empty, Subgroup.closure_empty]
  | succ n ih =>
    intro G _ s hgen
    set s' : Fin n → G := fun i => s i.succ with hs'
    set N : Subgroup G := Subgroup.closure (Set.range s') with hNdef
    have hmem : ∀ i : Fin n, s' i ∈ N := fun i => Subgroup.subset_closure ⟨i, rfl⟩
    have hNpoly : IsPolycyclic N := by
      refine ih N (fun i => (⟨s' i, hmem i⟩ : ↥N)) ?_
      apply Subgroup.map_injective (Subgroup.subtype_injective N)
      rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
      have himg : (N.subtype : ↥N → G) ''
          Set.range (fun i => (⟨s' i, hmem i⟩ : ↥N)) = Set.range s' := by
        rw [← Set.range_comp]; rfl
      rw [himg, ← hNdef]
    have hgen' : Subgroup.closure ((QuotientGroup.mk' N) '' Set.range s) = ⊤ := by
      rw [← MonoidHom.map_closure, hgen]
      exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)
    have hsub : (QuotientGroup.mk' N) '' Set.range s ⊆
        (Subgroup.zpowers ((QuotientGroup.mk' N) (s 0)) : Set (G ⧸ N)) := by
      rintro _ ⟨x, ⟨i, rfl⟩, rfl⟩
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
      · exact Subgroup.mem_zpowers _
      · have h1 : (QuotientGroup.mk' N) (s j.succ) = 1 :=
          (QuotientGroup.eq_one_iff _).2 (hmem j)
        rw [h1]
        exact Subgroup.one_mem _
    have hle : (⊤ : Subgroup (G ⧸ N)) ≤ Subgroup.zpowers ((QuotientGroup.mk' N) (s 0)) := by
      rw [← hgen']
      exact (Subgroup.closure_le _).2 hsub
    have hcyc : IsCyclic (G ⧸ N) :=
      ⟨⟨(QuotientGroup.mk' N) (s 0), fun x => hle (Subgroup.mem_top x)⟩⟩
    exact isPolycyclic_of_extension N hNpoly isPolycyclic_of_isCyclic

/-- A finitely generated abelian group is polycyclic. -/
theorem isPolycyclic_of_commGroup_of_fg {G : Type*} [CommGroup G] [Group.FG G] :
    IsPolycyclic G := by
  obtain ⟨S, hS⟩ := Group.fg_def.mp ‹Group.FG G›
  have hrange : Set.range (fun i : Fin S.card => ((S.equivFin.symm i : {x // x ∈ S}) : G))
      = (S : Set G) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (S.equivFin.symm i).2
    · intro hy
      exact ⟨S.equivFin ⟨y, hy⟩, by simp⟩
  exact isPolycyclic_commGroup_aux S.card G _ (by rw [hrange]; exact hS)

/-! ### Polycyclic groups are finitely generated -/

theorem fg_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B) (h : Group.FG A) :
    Group.FG B := by
  have := h
  exact Group.fg_of_surjective (f := (e : A →* B)) (fun b => ⟨e.symm b, by simp⟩)

theorem fg_of_isCyclic {C : Type*} [Group C] [IsCyclic C] : Group.FG C := by
  obtain ⟨g, hg⟩ := ‹IsCyclic C›.exists_generator
  refine Group.fg_iff.mpr ⟨{g}, ?_, Set.finite_singleton g⟩
  rw [← Subgroup.zpowers_eq_closure]
  exact eq_top_iff.2 fun x _ => hg x

/-- `Group.FG` is closed under extensions. -/
theorem fg_of_extension {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (hN : Group.FG N) (hQ : Group.FG (G ⧸ N)) : Group.FG G := by
  obtain ⟨S, hS⟩ := (Group.fg_iff_subgroup_fg N).mp hN
  obtain ⟨T0, hT0, hT0fin⟩ := Group.fg_iff.mp hQ
  set T : Set G := (Function.surjInv (QuotientGroup.mk'_surjective N)) '' T0 with hTdef
  have hTfin : T.Finite := hT0fin.image _
  have hTimg : (QuotientGroup.mk' N) '' T = T0 := by
    rw [hTdef, ← Set.image_comp]
    refine Set.image_congr ?_ |>.trans (Set.image_id _)
    intro x _
    exact Function.surjInv_eq (QuotientGroup.mk'_surjective N) x
  have hNle : N ≤ Subgroup.closure ((S : Set G) ∪ T) := by
    rw [← hS]; exact Subgroup.closure_mono Set.subset_union_left
  have hTle : Subgroup.closure T ≤ Subgroup.closure ((S : Set G) ∪ T) :=
    Subgroup.closure_mono Set.subset_union_right
  refine Group.fg_iff.mpr ⟨(S : Set G) ∪ T, ?_, (S.finite_toSet).union hTfin⟩
  rw [eq_top_iff]
  intro x _
  have hx : (QuotientGroup.mk' N) x ∈ (Subgroup.closure T).map (QuotientGroup.mk' N) := by
    rw [MonoidHom.map_closure, hTimg, hT0]
    exact Subgroup.mem_top _
  obtain ⟨y, hy, hxy⟩ := hx
  have hmem : y⁻¹ * x ∈ N := QuotientGroup.eq.mp hxy
  have hfac : x = y * (y⁻¹ * x) := by group
  rw [hfac]
  exact Subgroup.mul_mem _ (hTle hy) (hNle hmem)

/-- A polycyclic group is finitely generated. -/
theorem fg_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) : Group.FG G := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  have key : ∀ j : ℕ, Group.FG ↥(A (t - j)) := by
    intro j
    induction j with
    | zero =>
      rw [Nat.sub_zero, ht]
      exact (Group.fg_iff_subgroup_fg _).mpr Subgroup.FG.bot
    | succ j ihj =>
      rcases le_or_gt t j with hj | hj
      · have hjj : t - (j + 1) = t - j := by omega
        rw [hjj]; exact ihj
      · have he : t - j = (t - (j + 1)) + 1 := by omega
        rw [he] at ihj
        set i := t - (j + 1) with hi
        obtain ⟨hle, hnorm, hcyc⟩ := hstep i
        have hFGP : Group.FG ↥((A (i + 1)).subgroupOf (A i)) :=
          fg_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hle).symm ihj
        have hn := hnorm
        have hc := hcyc
        have hFGQ : Group.FG (↥(A i) ⧸ (A (i + 1)).subgroupOf (A i)) := fg_of_isCyclic
        exact fg_of_extension ((A (i + 1)).subgroupOf (A i)) hFGP hFGQ
  have hfg0 : Group.FG ↥(A 0) := by simpa using key t
  rw [h0] at hfg0
  exact fg_of_mulEquiv Subgroup.topEquiv hfg0

/-! ### Polycyclic groups are finitely presented -/

/-- Freeness: any homomorphism out of a free group lifts along a surjection. -/
theorem exists_lift_of_surjective {α : Type*} {A B : Type*} [Group A] [Group B]
    {f : A →* B} (hf : Function.Surjective f) (g : FreeGroup α →* B) :
    ∃ θ : FreeGroup α →* A, f.comp θ = g := by
  refine ⟨FreeGroup.lift (fun a => Function.surjInv hf (g (FreeGroup.of a))), ?_⟩
  apply FreeGroup.ext_hom
  intro a
  simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of]
  exact Function.surjInv_eq hf _

/-- Tietze / change of generators: the kernel of *any* surjection from a finite-rank free group
onto a finitely presented group is finitely normally generated. -/
theorem ker_isFinitelyNormallyGenerated {C : Type*} [Group C]
    [Group.IsFinitelyPresented C] {n : ℕ} (χ : FreeGroup (Fin n) →* C)
    (hχ : Function.Surjective χ) : χ.ker.IsFinitelyNormallyGenerated := by
  obtain ⟨m, ψ, hψ, R, hRfin, hR⟩ := ‹Group.IsFinitelyPresented C›.out
  obtain ⟨θ, hθ⟩ := exists_lift_of_surjective hψ χ
  obtain ⟨σ, hσ⟩ := exists_lift_of_surjective hχ ψ
  have hθapp : ∀ w, ψ (θ w) = χ w := fun w => DFunLike.congr_fun hθ w
  have hσapp : ∀ w, χ (σ w) = ψ w := fun w => DFunLike.congr_fun hσ w
  set S : Set (FreeGroup (Fin n)) :=
    σ '' R ∪ Set.range (fun i : Fin n => (FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i))) with hSdef
  refine ⟨S, (hRfin.image _).union (Set.finite_range _), ?_⟩
  set K : Subgroup (FreeGroup (Fin n)) := Subgroup.normalClosure S with hKdef
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro x (⟨r, hr, rfl⟩ | ⟨i, rfl⟩)
    · have hrk : r ∈ ψ.ker := by rw [← hR]; exact Subgroup.subset_normalClosure hr
      show χ (σ r) = 1
      rw [hσapp]
      exact hrk
    · show χ ((FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i))) = 1
      rw [map_mul, map_inv, hσapp, hθapp, inv_mul_cancel]
  · have key : (QuotientGroup.mk' K).comp (σ.comp θ) = QuotientGroup.mk' K := by
      apply FreeGroup.ext_hom
      intro i
      have hmem : (FreeGroup.of i)⁻¹ * σ (θ (FreeGroup.of i)) ∈ K :=
        Subgroup.subset_normalClosure (Or.inr ⟨i, rfl⟩)
      simp only [MonoidHom.comp_apply, QuotientGroup.mk'_apply]
      rw [eq_comm, ← inv_mul_eq_one, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
      exact (QuotientGroup.eq_one_iff _).2 hmem
    intro w hw
    have hθw : θ w ∈ ψ.ker := by
      show ψ (θ w) = 1
      rw [hθapp]
      exact hw
    have hmapped : σ (θ w) ∈ K := by
      have h1 : σ (θ w) ∈ (Subgroup.normalClosure R).map σ := ⟨θ w, by rw [hR]; exact hθw, rfl⟩
      have h2 : σ (θ w) ∈ Subgroup.normalClosure (σ '' R) :=
        Subgroup.map_normalClosure_le R σ h1
      exact Subgroup.normalClosure_mono (fun x hx => Or.inl hx) h2
    have hcong : (QuotientGroup.mk' K) (σ (θ w)) = (QuotientGroup.mk' K) w :=
      DFunLike.congr_fun key w
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply,
      (QuotientGroup.eq_one_iff _).2 hmapped] at hcong
    exact (QuotientGroup.eq_one_iff w).1 hcong.symm

theorem fg_of_isFinitelyPresented {A : Type*} [Group A] [h : Group.IsFinitelyPresented A] :
    Group.FG A := by
  obtain ⟨m, φ, hφ, _⟩ := h.out
  exact Group.fg_of_surjective hφ

theorem exists_freeGroup_fin_surjective {A : Type*} [Group A] [Group.FG A] :
    ∃ (m : ℕ) (φ : FreeGroup (Fin m) →* A), Function.Surjective φ := by
  obtain ⟨α, hα, φ₀, hφ₀⟩ := Group.fg_iff_exists_freeGroup_hom_surjective_finite.mp ‹Group.FG A›
  obtain ⟨m, ⟨e⟩⟩ := Finite.exists_equiv_fin α
  exact ⟨m, φ₀.comp (FreeGroup.freeGroupCongr e).symm.toMonoidHom,
    hφ₀.comp (FreeGroup.freeGroupCongr e).symm.surjective⟩

/-- A cyclic group is finitely presented. -/
theorem isFinitelyPresented_of_isCyclic {C : Type*} [Group C] [IsCyclic C] :
    Group.IsFinitelyPresented C := by
  obtain ⟨g, hg⟩ := ‹IsCyclic C›.exists_generator
  have hsurj : Function.Surjective (zpowersHom C g) := by
    intro x
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg x)
    exact ⟨Multiplicative.ofAdd m, by simpa using hm⟩
  refine Group.IsFinitelyPresented.of_surjective (zpowersHom C g) hsurj ?_
  have : Group.FG ↥(zpowersHom C g).ker := fg_of_isCyclic
  exact Subgroup.IsFinitelyNormallyGenerated.of_FG _

/-- P. Hall: an extension of a finitely presented group by a finitely presented group is
finitely presented. -/
theorem isFinitelyPresented_of_extension {G : Type*} [Group G] (N : Subgroup G)
    [hNnormal : N.Normal]
    (hN : Group.IsFinitelyPresented N) (hQ : Group.IsFinitelyPresented (G ⧸ N)) :
    Group.IsFinitelyPresented G := by
  have hNfg : Group.FG N := fg_of_isFinitelyPresented
  have hQfg : Group.FG (G ⧸ N) := fg_of_isFinitelyPresented
  have hGfg : Group.FG G := fg_of_extension N hNfg hQfg
  obtain ⟨n, φ, hφ⟩ := exists_freeGroup_fin_surjective (A := G)
  refine ⟨n, φ, hφ, ?_⟩
  -- `M = φ⁻¹ N` is finitely normally generated in the free group
  have hχ : Function.Surjective ((QuotientGroup.mk' N).comp φ) :=
    (QuotientGroup.mk'_surjective N).comp hφ
  have hMker : ((QuotientGroup.mk' N).comp φ).ker = N.comap φ := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
  obtain ⟨R, hRfin, hR⟩ : (N.comap φ).IsFinitelyNormallyGenerated := by
    rw [← hMker]; exact ker_isFinitelyNormallyGenerated _ hχ
  -- a presentation of `N`, and lifts of its generators to the free group
  obtain ⟨k, ρ₀, hρ₀⟩ := exists_freeGroup_fin_surjective (A := (↥N))
  obtain ⟨S, hSfin, hS⟩ := ker_isFinitelyNormallyGenerated ρ₀ hρ₀
  set ρ : FreeGroup (Fin k) →* G := N.subtype.comp ρ₀ with hρdef
  have hρker : ρ.ker = ρ₀.ker := by
    rw [hρdef]
    ext x
    exact ⟨fun h => Subtype.ext h, fun h => by
      show ((ρ₀ x : ↥N) : G) = 1
      rw [h]; rfl⟩
  have hρrange : ρ.range = N := by
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      exact (ρ₀ z).2
    · intro y hy
      obtain ⟨z, hz⟩ := hρ₀ ⟨y, hy⟩
      exact ⟨z, by rw [hρdef]; simp [hz]⟩
  set μ : Fin k → FreeGroup (Fin n) := fun j => Function.surjInv hφ (ρ (FreeGroup.of j)) with hμdef
  have hμφ : ∀ j, φ (μ j) = ρ (FreeGroup.of j) := fun j => Function.surjInv_eq hφ _
  set lam : FreeGroup (Fin k) →* FreeGroup (Fin n) := FreeGroup.lift μ with hlamdef
  have hlamof : ∀ j, lam (FreeGroup.of j) = μ j := by
    intro j; rw [hlamdef]; simp
  have hlam : ∀ z, φ (lam z) = ρ z := by
    have hcomp : φ.comp lam = ρ := by
      apply FreeGroup.ext_hom
      intro j
      simp only [MonoidHom.comp_apply, hlamof j, hμφ j]
    exact fun z => DFunLike.congr_fun hcomp z
  set Msub : Subgroup (FreeGroup (Fin n)) := Subgroup.closure (Set.range μ) with hMsubdef
  have hMsubmap : Msub.map φ = N := by
    have h1 : φ '' Set.range μ = ρ '' Set.range FreeGroup.of := by
      rw [← Set.range_comp, ← Set.range_comp]
      exact congrArg Set.range (funext hμφ)
    rw [hMsubdef, MonoidHom.map_closure, h1, ← MonoidHom.map_closure,
      FreeGroup.closure_range_of, ← MonoidHom.range_eq_map, hρrange]
  -- a choice of `Msub`-representative for every element whose image lies in `N`
  have hex : ∀ x : FreeGroup (Fin n), ∃ u : FreeGroup (Fin n),
      φ x ∈ N → (u ∈ Msub ∧ φ u = φ x) := by
    intro x
    by_cases hx : φ x ∈ N
    · rw [← hMsubmap] at hx
      obtain ⟨u, hu, hux⟩ := hx
      exact ⟨u, fun _ => ⟨hu, hux⟩⟩
    · exact ⟨1, fun h => absurd h hx⟩
  choose c hc using hex
  have hμN : ∀ j, φ (μ j) ∈ N := by
    intro j
    rw [hμφ j, ← hρrange]
    exact ⟨FreeGroup.of j, rfl⟩
  have hconjN : ∀ (i : Fin n) (j : Fin k),
      φ (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹) ∈ N := by
    intro i j
    simp only [map_mul, map_inv]
    exact hNnormal.conj_mem _ (hμN j) _
  have hconjN' : ∀ (i : Fin n) (j : Fin k),
      φ ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i) ∈ N := by
    intro i j
    simp only [map_mul, map_inv]
    exact hNnormal.conj_mem' _ (hμN j) _
  have hRsub : ∀ r ∈ R, φ r ∈ N := by
    intro r hr
    have hrm : r ∈ N.comap φ := by rw [← hR]; exact Subgroup.subset_normalClosure hr
    exact hrm
  -- the finite set of relations
  set T : Set (FreeGroup (Fin n)) :=
    ((fun x => x * (c x)⁻¹) '' R ∪
      Set.range (fun p : Fin n × Fin k =>
        (FreeGroup.of p.1 * μ p.2 * (FreeGroup.of p.1)⁻¹) *
          (c (FreeGroup.of p.1 * μ p.2 * (FreeGroup.of p.1)⁻¹))⁻¹) ∪
      Set.range (fun p : Fin n × Fin k =>
        ((FreeGroup.of p.1)⁻¹ * μ p.2 * FreeGroup.of p.1) *
          (c ((FreeGroup.of p.1)⁻¹ * μ p.2 * FreeGroup.of p.1))⁻¹)) ∪
      lam '' S with hTdef
  have hTfin : T.Finite :=
    (((hRfin.image _).union (Set.finite_range _)).union (Set.finite_range _)).union
      (hSfin.image _)
  refine ⟨T, hTfin, ?_⟩
  set L : Subgroup (FreeGroup (Fin n)) := Subgroup.normalClosure T with hLdef
  have hmemT : ∀ x ∈ T, x ∈ L := fun x hx => Subgroup.subset_normalClosure hx
  have hker_c : ∀ x, φ x ∈ N → x * (c x)⁻¹ ∈ φ.ker := by
    intro x hx
    simp [MonoidHom.mem_ker, (hc x hx).2]
  -- one inclusion: every relation lies in the kernel
  have hLK : L ≤ φ.ker := by
    rw [hLdef]
    apply Subgroup.normalClosure_le_normal
    rintro x (((⟨r, hr, rfl⟩ | ⟨⟨i, j⟩, rfl⟩) | ⟨⟨i, j⟩, rfl⟩) | ⟨s, hs, rfl⟩)
    · exact hker_c r (hRsub r hr)
    · exact hker_c _ (hconjN i j)
    · exact hker_c _ (hconjN' i j)
    · have hsk : s ∈ ρ₀.ker := by rw [← hS]; exact Subgroup.subset_normalClosure hs
      show φ (lam s) = 1
      rw [hlam s, ← hρker] at *
      exact hsk
  refine le_antisymm hLK ?_
  -- the other inclusion
  set π : FreeGroup (Fin n) →* FreeGroup (Fin n) ⧸ L := QuotientGroup.mk' L with hπdef
  have hπsurj : Function.Surjective π := QuotientGroup.mk'_surjective L
  set P : Subgroup (FreeGroup (Fin n) ⧸ L) := Msub.map π with hPdef
  have hP_eq : P = Subgroup.closure (Set.range (fun j => π (μ j))) := by
    rw [hPdef, hMsubdef, MonoidHom.map_closure, ← Set.range_comp]
    rfl
  have hpi_eq : ∀ x, x * (c x)⁻¹ ∈ L → π x = π (c x) := by
    intro x hx
    have h1 : π (x * (c x)⁻¹) = 1 := (QuotientGroup.eq_one_iff _).2 hx
    rw [map_mul, map_inv, mul_inv_eq_one] at h1
    exact h1
  have hcP : ∀ x, φ x ∈ N → π (c x) ∈ P := by
    intro x hx
    exact ⟨c x, (hc x hx).1, rfl⟩
  have hconjP : ∀ (i : Fin n) (j : Fin k),
      π (FreeGroup.of i) * π (μ j) * (π (FreeGroup.of i))⁻¹ ∈ P := by
    intro i j
    have hT : (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹) *
        (c (FreeGroup.of i * μ j * (FreeGroup.of i)⁻¹))⁻¹ ∈ T :=
      Or.inl (Or.inl (Or.inr ⟨(i, j), rfl⟩))
    have heq := hpi_eq _ (hmemT _ hT)
    rw [map_mul, map_mul, map_inv] at heq
    rw [heq]
    exact hcP _ (hconjN i j)
  have hconjP' : ∀ (i : Fin n) (j : Fin k),
      (π (FreeGroup.of i))⁻¹ * π (μ j) * π (FreeGroup.of i) ∈ P := by
    intro i j
    have hT : ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i) *
        (c ((FreeGroup.of i)⁻¹ * μ j * FreeGroup.of i))⁻¹ ∈ T :=
      Or.inl (Or.inr ⟨(i, j), rfl⟩)
    have heq := hpi_eq _ (hmemT _ hT)
    rw [map_mul, map_mul, map_inv] at heq
    rw [heq]
    exact hcP _ (hconjN' i j)
  have hconj_into : ∀ g : FreeGroup (Fin n) ⧸ L,
      (∀ j, g * π (μ j) * g⁻¹ ∈ P) → ∀ h ∈ P, g * h * g⁻¹ ∈ P := by
    intro g hg h hh
    have hsub : Subgroup.closure (Set.range (fun j => π (μ j))) ≤
        P.comap ((MulAut.conj g : _ ≃* _) : _ →* _) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, rfl⟩
      simpa [MulAut.conj_apply] using hg j
    have := hsub (hP_eq.le hh)
    simpa [MulAut.conj_apply] using this
  have hnormalizer : ∀ i : Fin n,
      π (FreeGroup.of i) ∈ Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L)) := by
    intro i
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · exact fun hh => hconj_into _ (fun j => hconjP i j) h hh
    · intro hh
      have h2 := hconj_into (π (FreeGroup.of i))⁻¹
        (by intro j; rw [inv_inv]; exact hconjP' i j) _ hh
      have e : (π (FreeGroup.of i))⁻¹ * (π (FreeGroup.of i) * h * (π (FreeGroup.of i))⁻¹) *
          (π (FreeGroup.of i))⁻¹⁻¹ = h := by group
      rwa [e] at h2
  have hnormtop : Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L)) = ⊤ := by
    have hc2 : (Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))).comap π = ⊤ := by
      rw [eq_top_iff, ← FreeGroup.closure_range_of (Fin n), Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact hnormalizer i
    calc Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))
        = ((Subgroup.normalizer (P : Set (FreeGroup (Fin n) ⧸ L))).comap π).map π :=
          (Subgroup.map_comap_eq_self_of_surjective hπsurj _).symm
      _ = ⊤ := by rw [hc2]; exact Subgroup.map_top_of_surjective _ hπsurj
  have hPnormal : P.Normal := Subgroup.normalizer_eq_top_iff.mp hnormtop
  have hMle : (N.comap φ).map π ≤ P := by
    rw [← hR]
    refine le_trans (Subgroup.map_normalClosure_le R π) (Subgroup.normalClosure_le_normal ?_)
    rintro _ ⟨r, hr, rfl⟩
    have hT : r * (c r)⁻¹ ∈ T := Or.inl (Or.inl (Or.inl ⟨r, hr, rfl⟩))
    have heq := hpi_eq _ (hmemT _ hT)
    rw [heq]
    exact hcP _ (hRsub r hr)
  have hPrange : P = (π.comp lam).range := by
    rw [hP_eq, MonoidHom.range_eq_map, ← FreeGroup.closure_range_of (Fin k),
      MonoidHom.map_closure, ← Set.range_comp]
    exact congrArg Subgroup.closure (congrArg Set.range (funext fun j => by
      simp [hlamof j]))
  intro w hw
  have hwM : w ∈ N.comap φ := by
    have : φ w = 1 := hw
    simp [Subgroup.mem_comap, this]
  have hwP : π w ∈ P := hMle ⟨w, hwM, rfl⟩
  rw [hPrange] at hwP
  obtain ⟨z, hz⟩ := hwP
  have hdiff : (lam z)⁻¹ * w ∈ L := QuotientGroup.eq.mp hz
  have hφd : φ ((lam z)⁻¹ * w) = 1 := hLK hdiff
  have hrz : ρ z = 1 := by
    rw [← hlam z]
    have hw1 : φ w = 1 := hw
    rw [map_mul, map_inv, hw1, mul_one, inv_eq_one] at hφd
    exact hφd
  have hzker : z ∈ Subgroup.normalClosure S := by
    rw [hS, ← hρker]
    exact hrz
  have hlamz : lam z ∈ L := by
    have h1 : lam z ∈ (Subgroup.normalClosure S).map lam := ⟨z, hzker, rfl⟩
    have h2 : lam z ∈ Subgroup.normalClosure (lam '' S) :=
      Subgroup.map_normalClosure_le S lam h1
    exact Subgroup.normalClosure_le_normal (fun x hx => hmemT x (Or.inr hx)) h2
  have hπw : π w = 1 := by
    rw [← hz]
    exact (QuotientGroup.eq_one_iff _).2 hlamz
  exact (QuotientGroup.eq_one_iff w).1 hπw

/-- A polycyclic group is finitely presented. -/
theorem isFinitelyPresented_of_isPolycyclic {G : Type*} [Group G] (h : IsPolycyclic G) :
    Group.IsFinitelyPresented G := by
  obtain ⟨A, h0, ⟨t, ht⟩, hstep⟩ := exists_chain_of_isPolycyclic h
  have key : ∀ j : ℕ, Group.IsFinitelyPresented ↥(A (t - j)) := by
    intro j
    induction j with
    | zero =>
      rw [Nat.sub_zero, ht]
      have : Finite ↥(⊥ : Subgroup G) := inferInstance
      infer_instance
    | succ j ihj =>
      rcases le_or_gt t j with hj | hj
      · have hjj : t - (j + 1) = t - j := by omega
        rw [hjj]; exact ihj
      · have he : t - j = (t - (j + 1)) + 1 := by omega
        rw [he] at ihj
        set i := t - (j + 1) with hi
        obtain ⟨hle, hnorm, hcyc⟩ := hstep i
        have hFPP : Group.IsFinitelyPresented ↥((A (i + 1)).subgroupOf (A i)) := by
          have := ihj
          exact Group.IsFinitelyPresented.equiv (Subgroup.subgroupOfEquivOfLe hle).symm
        have hn := hnorm
        have hc := hcyc
        have hFPQ : Group.IsFinitelyPresented (↥(A i) ⧸ (A (i + 1)).subgroupOf (A i)) :=
          isFinitelyPresented_of_isCyclic
        exact isFinitelyPresented_of_extension ((A (i + 1)).subgroupOf (A i)) hFPP hFPQ
  have hfp0 : Group.IsFinitelyPresented ↥(A 0) := by
    have hkt := key t
    rwa [Nat.sub_self] at hkt
  rw [h0] at hfp0
  have := hfp0
  exact Group.IsFinitelyPresented.equiv Subgroup.topEquiv

end Lib
end MilnorWolf

/-!
# Word balls: images under a homomorphism, and comparison against a non-generating set

Two additions to the ball API of the Chou development.  A ball on the image of a set is the
image of the ball, which is what identifies the balls of a subgroup with the balls of its image
in the ambient group; and balls can be compared against a set that generates only a subgroup,
which is the form needed when the comparison happens inside a finite-index subgroup rather than
in the whole group.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-- A ball on the image of a set is the image of the ball: a word on `f '' V` is `f` of the
corresponding word on `V`. -/
theorem wordBall_image {K : Type*} [Group K] (f : G →* K) (V : Set G) (n : ℕ) :
    wordBall (f '' V) n = f '' wordBall V n := by
  have lift : ∀ l : List K, (∀ x ∈ l, x ∈ f '' V ∨ x⁻¹ ∈ f '' V) →
      ∃ p : G, p ∈ wordBall V l.length ∧ f p = l.prod := by
    intro l
    induction l with
    | nil => exact fun _ => ⟨1, one_mem_wordBall V 0, by simp⟩
    | cons a t ih =>
        intro hmem
        obtain ⟨p, hp, hfp⟩ := ih (fun x hx => hmem x (List.mem_cons_of_mem _ hx))
        obtain ⟨b, hb, hfb⟩ : ∃ b : G, (b ∈ V ∨ b⁻¹ ∈ V) ∧ f b = a := by
          rcases hmem a (by simp) with ⟨v, hv, hva⟩ | ⟨v, hv, hva⟩
          · exact ⟨v, Or.inl hv, hva⟩
          · exact ⟨v⁻¹, Or.inr (by simpa using hv), by rw [map_inv, hva, inv_inv]⟩
        obtain ⟨lp, hlp, hmp, rfl⟩ := hp
        refine ⟨b * lp.prod, ⟨b :: lp, by simpa using hlp, ?_, by simp⟩, ?_⟩
        · intro x hx
          rcases List.mem_cons.1 hx with rfl | hx
          · exact hb
          · exact hmp x hx
        · rw [List.prod_cons, map_mul, hfb, hfp]
  apply Set.eq_of_subset_of_subset
  · rintro y ⟨l, hlen, hmem, rfl⟩
    obtain ⟨p, hp, hfp⟩ := lift l hmem
    exact ⟨p, wordBall_mono V hlen hp, hfp⟩
  · rintro y ⟨x, ⟨l, hlen, hmem, rfl⟩, rfl⟩
    refine ⟨l.map f, by simpa using hlen, ?_, by rw [← map_list_prod f l]⟩
    intro z hz
    obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    rcases hmem w hw with h | h
    · exact Or.inl ⟨w, h, rfl⟩
    · exact Or.inr ⟨w⁻¹, h, by simp⟩

theorem wordBall_mono_set {A B : Set G} (h : A ⊆ B) (n : ℕ) :
    wordBall A n ⊆ wordBall B n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen, fun x hx => (hmem x hx).imp (fun hh => h hh) (fun hh => h hh), rfl⟩

theorem mem_wordBall_one {U : Set G} {u : G} (hu : u ∈ U) : u ∈ wordBall U 1 :=
  ⟨[u], by simp, by simpa using Or.inl hu, by simp⟩

/-- Finitely many elements of a generated subgroup are words of a single bounded length. -/
theorem exists_forall_mem_wordBall (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ u ∈ U, u ∈ wordBall (T : Set G) k := by
  classical
  have H : ∀ u ∈ U, ∃ m : ℕ, u ∈ wordBall (T : Set G) m := fun u hu =>
    exists_mem_wordBall_of_mem_closure (hU u hu)
  choose f hf using H
  refine ⟨(U.attach.sup fun u => f u.1 u.2) + 1, Nat.succ_pos _, fun u hu => ?_⟩
  have hu' : u ∈ U := hu
  refine wordBall_mono _ ?_ (hf u hu')
  have hsup : f u hu' ≤ U.attach.sup fun u : {x // x ∈ U} => f u.1 u.2 :=
    Finset.le_sup (f := fun u : {x // x ∈ U} => f u.1 u.2) (Finset.mem_attach U ⟨u, hu'⟩)
  omega

/-- If every element of `U` lies in the subgroup generated by `T`, the `U`-balls sit inside the
`T`-balls at a linear cost.  Unlike `Chou.Lib.exists_wordBall_subset`, `T` is not required to
generate the ambient group. -/
theorem exists_wordBall_subset_of_mem_closure (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (U : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  obtain ⟨k, hk, hmem⟩ := exists_forall_mem_wordBall U T hU
  exact ⟨k, hk, fun n => wordBall_subset_wordBall_of_forall_mem (fun u hu => hmem u hu) n⟩

end Lib
end Wolf

/-!
# Schreier rewriting, with the word length carried along

Mathlib's `Subgroup.closure_mul_image_eq` is Schreier's lemma in the form "the Schreier set
generates `H`".  Wolf's Theorem 3.11 needs more: that a word of length `p` on a generating set of
the ambient group, whose value happens to lie in `H`, is a word of length `p` on the Schreier
set.  That bound is what turns a growth estimate for `H` into one for the whole group.

The rewriting is the usual telescoping.  Writing a word as `x₁ ⋯ x_p` and letting `ρ(g)` be the
representative of the left coset `gH`, the suffix products `t_i = x_{i+1} ⋯ x_p` satisfy
`t_{i-1} = x_i t_i`, so the elements `ρ(t_{i-1})⁻¹ x_i ρ(t_i)` all lie in `H` and their product
telescopes to `ρ(h)⁻¹ h ρ(1)`.  For `h ∈ H` the two outer representatives coincide, and the one
that survives is itself an element of `H`, so it costs two extra letters.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-! ### The coset representative -/

/-- The representative of the left coset `g H` picked out by the quotient. -/
noncomputable def rep (H : Subgroup G) (g : G) : G := Quotient.out (QuotientGroup.mk g : G ⧸ H)

theorem inv_rep_mul_mem (H : Subgroup G) (g : G) : (rep H g)⁻¹ * g ∈ H := by
  rw [← QuotientGroup.eq]
  exact Quotient.out_eq' _

theorem rep_mem_range (H : Subgroup G) (g : G) :
    rep H g ∈ Set.range (fun q : G ⧸ H => Quotient.out q) := ⟨_, rfl⟩

theorem rep_eq_rep_one (H : Subgroup G) {h : G} (hh : h ∈ H) : rep H h = rep H 1 := by
  have hq : (QuotientGroup.mk h : G ⧸ H) = QuotientGroup.mk 1 := by
    rw [QuotientGroup.eq]
    simpa using H.inv_mem hh
  rw [rep, rep, hq]

theorem rep_one_mem (H : Subgroup G) : rep H 1 ∈ H := by
  have h := inv_rep_mul_mem H 1
  rw [mul_one] at h
  simpa using H.inv_mem h

/-! ### The rewriting -/

/-- **Schreier rewriting with a length bound.**  A word of length `p` whose value lies in `H`
becomes, after conjugating by the representative of `H` itself, a word of length `p` on the
Schreier set `Uf`. -/
theorem schreier_rewrite (H : Subgroup G) (S Rf Uf : Finset G)
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (l : List G) (hl : ∀ x ∈ l, x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) :
    (rep H l.prod)⁻¹ * l.prod * rep H 1 ∈ wordBall (Uf : Set G) l.length := by
  induction l with
  | nil =>
      simpa using one_mem_wordBall (Uf : Set G) 0
  | cons a t ih =>
      have hrest := ih fun x hx => hl x (List.mem_cons_of_mem _ hx)
      set b : G := (rep H (a * t.prod))⁻¹ * a * rep H t.prod with hb
      have hbH : b ∈ H := by
        have h1 : (rep H (a * t.prod))⁻¹ * (a * t.prod) ∈ H := inv_rep_mul_mem H _
        have h2 : (t.prod)⁻¹ * rep H t.prod ∈ H := by
          simpa using H.inv_mem (inv_rep_mul_mem H t.prod)
        have := H.mul_mem h1 h2
        rw [hb]
        convert this using 1
        group
      have hbU : b ∈ Uf := hU _ _ (hR _) (hR _) a (hl a (by simp)) hbH
      have hsplit : (rep H (a :: t).prod)⁻¹ * (a :: t).prod * rep H 1 =
          b * ((rep H t.prod)⁻¹ * t.prod * rep H 1) := by
        rw [hb, List.prod_cons]
        group
      rw [hsplit]
      have : b * ((rep H t.prod)⁻¹ * t.prod * rep H 1) ∈ wordBall (Uf : Set G) (1 + t.length) :=
        mul_mem_wordBall (mem_wordBall_one (by exact_mod_cast hbU)) hrest
      simpa [Nat.add_comm] using this

variable (H : Subgroup G) (S Rf Uf Vf : Finset G)

/-- An element of `H` that is an `S`-word of length `≤ n` is a word of length `≤ n + 2` on the
Schreier set enlarged by the representative of `H` itself. -/
theorem mem_wordBall_schreierSet
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (hUV : (Uf : Set G) ⊆ (Vf : Set G)) (heV : rep H 1 ∈ Vf)
    {h : G} (hh : h ∈ H) {n : ℕ} (hn : h ∈ wordBall (S : Set G) n) :
    h ∈ wordBall (Vf : Set G) (n + 2) := by
  obtain ⟨l, hlen, hmem, rfl⟩ := hn
  have key := schreier_rewrite H S Rf Uf hR hU l hmem
  rw [rep_eq_rep_one H hh] at key
  have hmid : (rep H 1)⁻¹ * l.prod * rep H 1 ∈ wordBall (Vf : Set G) n :=
    wordBall_mono _ hlen (wordBall_mono_set hUV _ key)
  have h1 : rep H 1 ∈ wordBall (Vf : Set G) 1 := mem_wordBall_one (by exact_mod_cast heV)
  have h2 : (rep H 1)⁻¹ ∈ wordBall (Vf : Set G) 1 := inv_mem_wordBall h1
  have hprod := mul_mem_wordBall (mul_mem_wordBall h1 hmid) h2
  have heq : rep H 1 * ((rep H 1)⁻¹ * l.prod * rep H 1) * (rep H 1)⁻¹ = l.prod := by group
  rw [heq] at hprod
  exact wordBall_mono _ (by omega) hprod

/-- **The covering count.**  Every element of the `S`-ball of radius `m` is a coset
representative times an element of `H` of controlled length, so the ball is covered by `[G : H]`
translates of a Schreier ball. -/
theorem card_wordBall_le_mul
    (hR : ∀ g : G, rep H g ∈ Rf)
    (hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G, (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) →
        r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf)
    (hUV : (Uf : Set G) ⊆ (Vf : Set G)) (heV : rep H 1 ∈ Vf)
    (L : ℕ) (hL : ∀ r ∈ Rf, r ∈ wordBall (S : Set G) L) (m : ℕ) :
    Nat.card (wordBall (S : Set G) m) ≤
      Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := by
  classical
  have hfin : ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)).Finite :=
    (Rf.finite_toSet).prod (finite_wordBall _ _)
  have hsub : wordBall (S : Set G) m ⊆
      (fun p : G × G => p.1 * p.2) ''
        ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)) := by
    intro g hg
    refine ⟨(rep H g, (rep H g)⁻¹ * g), ⟨hR g, ?_⟩, by simp⟩
    refine mem_wordBall_schreierSet H S Rf Uf Vf hR hU hUV heV (inv_rep_mul_mem H g) ?_
    exact mul_mem_wordBall (inv_mem_wordBall (hL _ (hR g))) hg
  calc Nat.card (wordBall (S : Set G) m)
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2))) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card ((Rf : Set G) ×ˢ wordBall (Vf : Set G) (L + m + 2)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := by
        simp only [Nat.card_coe_set_eq]
        rw [Set.ncard_prod, Set.ncard_coe_finset]

end Lib
end Wolf

/-!
# Wolf's Lemma 3.4 (p. 426): rescaling a polynomial lower bound

Two upgrades of a lower bound on the growth function, both of which Theorem 3.2 uses.  A bound
`c (m - r)^q` becomes `c' m^q`, because `(m - r)/m ≥ 1/(r+1)` once `m ≥ r + 1`, and below that the
ball already has at least one element.  A bound along the multiples of `l` becomes a bound for
every `m`, by dropping from `m` to the largest multiple `l ⌊m/l⌋` below it, which is at least
`m / l` once `m ≥ l`.

Wolf takes the constant to be a minimum over the finitely many small values of the growth
function; since every ball contains the identity, `min c 1` divided by `(r+1)^q`, resp. `l^q`,
serves in both ranges at once.  The second half is proved directly rather than, as Wolf does, by
reducing it to the first.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

theorem one_le_growthFunction (S : Finset Γ) (m : ℕ) :
    (1 : ℝ) ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  exact_mod_cast one_le_card_wordBall S m

theorem growthFunction_mono (S : Finset Γ) {a b : ℕ} (h : a ≤ b) :
    (MilnorWolf.growthFunction S a : ℝ) ≤ (MilnorWolf.growthFunction S b : ℝ) := by
  exact_mod_cast card_wordBall_le_of_subset (wordBall_mono (S : Set Γ) h)

/-- **Wolf's Lemma 3.4, first half.**  A lower bound shifted by `r` upgrades to an unshifted one:
for `m ≥ r + 1` the ratio `(m - r)/m` is at least `1/(r+1)`, and below that the ball already has
at least one element. -/
theorem exists_const_of_le_sub (S : Finset Γ) (r q : ℕ) (c : ℝ) (hc : 0 < c)
    (h : ∀ m : ℕ, 1 ≤ m → c * ((m : ℝ) - (r : ℝ)) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) :
    ∃ c' : ℝ, 0 < c' ∧ ∀ m : ℕ, 1 ≤ m →
      c' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  have hr1 : (0 : ℝ) < (r : ℝ) + 1 := by positivity
  refine ⟨min c 1 / ((r : ℝ) + 1) ^ q, by positivity, ?_⟩
  intro m hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  by_cases hcase : r + 1 ≤ m
  · -- the main range
    have hmr : (m : ℝ) / ((r : ℝ) + 1) ≤ (m : ℝ) - (r : ℝ) := by
      rw [div_le_iff₀ hr1]
      have : (r : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hcase
      nlinarith [Nat.cast_nonneg (α := ℝ) r]
    have hpow : ((m : ℝ) / ((r : ℝ) + 1)) ^ q ≤ ((m : ℝ) - (r : ℝ)) ^ q :=
      pow_le_pow_left₀ (by positivity) hmr q
    calc min c 1 / ((r : ℝ) + 1) ^ q * (m : ℝ) ^ q
        = min c 1 * ((m : ℝ) / ((r : ℝ) + 1)) ^ q := by rw [div_pow]; ring
      _ ≤ c * ((m : ℝ) - (r : ℝ)) ^ q := by
          refine mul_le_mul (min_le_left _ _) hpow (by positivity) hc.le
      _ ≤ (MilnorWolf.growthFunction S m : ℝ) := h m hm
  · -- the small range: the ball already has at least one element
    have hmr : (m : ℝ) ≤ (r : ℝ) + 1 := by
      have : m ≤ r + 1 := by omega
      exact_mod_cast this
    have hpow : (m : ℝ) ^ q ≤ ((r : ℝ) + 1) ^ q := pow_le_pow_left₀ hm0 hmr q
    have hle : min c 1 / ((r : ℝ) + 1) ^ q * (m : ℝ) ^ q ≤ 1 := by
      rw [div_mul_eq_mul_div, div_le_one (by positivity)]
      calc min c 1 * (m : ℝ) ^ q ≤ 1 * ((r : ℝ) + 1) ^ q := by
            refine mul_le_mul (min_le_right _ _) hpow (by positivity) zero_le_one
        _ = ((r : ℝ) + 1) ^ q := one_mul _
    exact hle.trans (one_le_growthFunction S m)

/-- **Wolf's Lemma 3.4, second half.**  A lower bound along the multiples of `l` upgrades to all
`m`: drop from `m` to `l ⌊m/l⌋`, which is at least `m / l` once `m ≥ l`. -/
theorem exists_const_of_le_mul (S : Finset Γ) (l q : ℕ) (c : ℝ) (hl : 0 < l) (hc : 0 < c)
    (h : ∀ m : ℕ, 1 ≤ m →
      c * ((l * m : ℕ) : ℝ) ^ q ≤ (MilnorWolf.growthFunction S (l * m) : ℝ)) :
    ∃ c'' : ℝ, 0 < c'' ∧ ∀ m : ℕ, 1 ≤ m →
      c'' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast hl
  refine ⟨min c 1 / (l : ℝ) ^ q, by positivity, ?_⟩
  intro m hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  by_cases hcase : l ≤ m
  · -- drop to the largest multiple of `l` below `m`
    set a : ℕ := m / l with ha
    have ha1 : 1 ≤ a := (Nat.one_le_div_iff hl).2 hcase
    have hal : l * a ≤ m := by rw [ha]; exact Nat.mul_div_le m l
    have h1 : m + 1 ≤ a * l + l := by
      have h2 : m / l < a + 1 := by rw [← ha]; exact Nat.lt_succ_self a
      have h3 : m < (a + 1) * l := (Nat.div_lt_iff_lt_mul hl).1 h2
      rw [add_one_mul] at h3
      omega
    have hbig : (m : ℝ) / (l : ℝ) ≤ ((l * a : ℕ) : ℝ) := by
      have hb : (m : ℝ) + 1 ≤ (a : ℝ) * (l : ℝ) + (l : ℝ) := by exact_mod_cast h1
      have hlm : (l : ℝ) ≤ (m : ℝ) := by exact_mod_cast hcase
      have hl1 : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
      rw [div_le_iff₀ hl0]
      push_cast
      nlinarith [mul_nonneg (sub_nonneg.2 hl1) (sub_nonneg.2 hlm),
        mul_le_mul_of_nonneg_left hb hl0.le]
    have hpow : ((m : ℝ) / (l : ℝ)) ^ q ≤ ((l * a : ℕ) : ℝ) ^ q :=
      pow_le_pow_left₀ (by positivity) hbig q
    calc min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q
        = min c 1 * ((m : ℝ) / (l : ℝ)) ^ q := by rw [div_pow]; ring
      _ ≤ c * ((l * a : ℕ) : ℝ) ^ q := by
          refine mul_le_mul (min_le_left _ _) hpow (by positivity) hc.le
      _ ≤ (MilnorWolf.growthFunction S (l * a) : ℝ) := h a ha1
      _ ≤ (MilnorWolf.growthFunction S m : ℝ) := growthFunction_mono S hal
  · -- the small range
    have hml : (m : ℝ) ≤ (l : ℝ) := by
      have : m ≤ l := by omega
      exact_mod_cast this
    have hpow : (m : ℝ) ^ q ≤ (l : ℝ) ^ q := pow_le_pow_left₀ hm0 hml q
    have hle : min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q ≤ 1 := by
      rw [div_mul_eq_mul_div, div_le_one (by positivity)]
      calc min c 1 * (m : ℝ) ^ q ≤ 1 * (l : ℝ) ^ q := by
            refine mul_le_mul (min_le_right _ _) hpow (by positivity) zero_le_one
        _ = (l : ℝ) ^ q := one_mul _
    exact hle.trans (one_le_growthFunction S m)

/-- **Wolf's Lemma 3.4** (p. 426), both halves. -/
theorem exists_const_pow_le_growthFunction_of_le_sub_and_of_le_mul' (S : Finset Γ) :
    (∀ (r q : ℕ) (c : ℝ), 0 < c →
        (∀ m : ℕ, 1 ≤ m → c * ((m : ℝ) - (r : ℝ)) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) →
        ∃ c' : ℝ, 0 < c' ∧ ∀ m : ℕ, 1 ≤ m →
          c' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) ∧
      (∀ (l q : ℕ) (c : ℝ), 0 < l → 0 < c →
        (∀ m : ℕ, 1 ≤ m →
          c * ((l * m : ℕ) : ℝ) ^ q ≤ (MilnorWolf.growthFunction S (l * m) : ℝ)) →
        ∃ c'' : ℝ, 0 < c'' ∧ ∀ m : ℕ, 1 ≤ m →
          c'' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) :=
  ⟨fun r q c hc h => exists_const_of_le_sub S r q c hc h,
   fun l q c hl hc h => exists_const_of_le_mul S l q c hl hc h⟩

/-- **Wolf's Lemma 3.5** (p. 427): two-sided polynomial bounds on the growth function transfer
between finite generating sets.  Each generating set is a bounded-length word in the other, which
rescales the upper bound directly and the lower bound along the multiples of `l`, where Lemma 3.4
takes over. -/
theorem exists_const_polynomial_bounds_of_generating' (S T : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) (hT : Subgroup.closure (T : Set Γ) = ⊤)
    (b₁ b₂ : ℝ) (hb₁ : 0 < b₁) (hb : b₁ ≤ b₂) (p q : ℕ) (hpq : p ≤ q)
    (hbounds : ∀ m : ℕ, 1 ≤ m →
      b₁ * (m : ℝ) ^ p ≤ (MilnorWolf.growthFunction T m : ℝ) ∧
        (MilnorWolf.growthFunction T m : ℝ) ≤ b₂ * (m : ℝ) ^ q) :
    ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
      c₁ * (m : ℝ) ^ p ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
        (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ q := by
  obtain ⟨k, hk, hkball⟩ := exists_wordBall_subset S T hT
  obtain ⟨l, hl, hlball⟩ := exists_wordBall_subset T S hS
  have hb₂ : 0 < b₂ := lt_of_lt_of_le hb₁ hb
  have hk0 : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast hl
  -- the upper bound
  set c₂ : ℝ := b₂ * (k : ℝ) ^ q with hc₂
  have hc₂pos : 0 < c₂ := by positivity
  have hupper : ∀ m : ℕ, 1 ≤ m →
      (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ q := by
    intro m hm
    have hsub : (MilnorWolf.growthFunction S m : ℝ) ≤
        (MilnorWolf.growthFunction T (k * m) : ℝ) := by
      exact_mod_cast card_wordBall_le_of_subset (hkball m)
    have hkm : 1 ≤ k * m := Nat.one_le_iff_ne_zero.2 (by positivity)
    refine hsub.trans (((hbounds (k * m) hkm).2).trans (le_of_eq ?_))
    push_cast
    rw [hc₂, mul_pow]
    ring
  -- the lower bound, along the multiples of `l`, then Lemma 3.4
  have hlow : ∀ m : ℕ, 1 ≤ m →
      (b₁ / (l : ℝ) ^ p) * ((l * m : ℕ) : ℝ) ^ p ≤
        (MilnorWolf.growthFunction S (l * m) : ℝ) := by
    intro m hm
    have hsub : (MilnorWolf.growthFunction T m : ℝ) ≤
        (MilnorWolf.growthFunction S (l * m) : ℝ) := by
      exact_mod_cast card_wordBall_le_of_subset (hlball m)
    refine le_trans (le_of_eq ?_) (le_trans (hbounds m hm).1 hsub)
    push_cast
    rw [mul_pow]
    field_simp
  obtain ⟨c'', hc''pos, hc''⟩ :=
    exists_const_of_le_mul S l p (b₁ / (l : ℝ) ^ p) hl (by positivity) hlow
  refine ⟨min c'' c₂, c₂, lt_min hc''pos hc₂pos, min_le_right _ _, fun m hm => ?_⟩
  refine ⟨?_, hupper m hm⟩
  exact le_trans (mul_le_mul_of_nonneg_right (min_le_left _ _) (by positivity)) (hc'' m hm)

end Lib
end Wolf

/-!
# Wolf's Theorem 3.11 (p. 431)

“Let `Σ` be a finitely generated group, and `Γ` a subgroup of finite index.  1. `Γ` is finitely
generated.  2. If `Γ` has polynomial growth of degree `≤ E`, then `Σ` has polynomial growth of
degree `≤ E`.  3. If `Γ` is nilpotent and has polynomial growth of degree `≤ E`, then `Σ` has
polynomial growth of degree `≤ min {E, E₂(Γ)}`.”

Part 1 is Schreier's lemma, which Mathlib has.  Part 2 is the content: the ball of radius `m` in
`Σ` is covered by the `[Σ : Γ]` translates of a ball in `Γ` of radius linear in `m`, the radius
being controlled by Schreier rewriting.  Wolf first reduces to the case of a normal subgroup, by
passing to the intersection `Ψ` of the conjugates of `Γ`; that reduction is not needed here,
since the rewriting argument never uses normality.  Part 3 combines part 2 with the upper bound
of Theorem 3.2, which Wolf quotes immediately before stating 3.11.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-- The image in `G` of a generating set of `H` generates `H`. -/
theorem closure_image_eq [DecidableEq G] (H : Subgroup G) (T : Finset ↥H)
    (hT : Subgroup.closure (T : Set ↥H) = ⊤) :
    Subgroup.closure (((T.image H.subtype : Finset G)) : Set G) = H := by
  rw [Finset.coe_image, ← MonoidHom.map_closure, hT, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype]

/-- Balls on the image of a generating set have the same size as balls upstairs. -/
theorem card_wordBall_image [DecidableEq G] (H : Subgroup G) (T : Finset ↥H) (n : ℕ) :
    Nat.card (wordBall (((T.image H.subtype : Finset G)) : Set G) n) =
      Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) n) := by
  rw [Finset.coe_image, wordBall_image H.subtype]
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_image_of_injective _ (Subgroup.subtype_injective H)

/-- The upper bound behind Wolf's Theorem 3.11 (2), for a **given** finite generating set of `G`.
The proof produces the constant for whichever generating set it is handed; Theorem 3.11 only
needs some one of them, but Theorem 4.3 needs the set it is given, so the argument is stated in
this form and 3.11 is read off from it. -/
theorem exists_const_upper_of_finiteIndex (H : Subgroup G) [Group.FG G] [H.FiniteIndex]
    (E : ℕ) (hH : MilnorWolf.HasPolynomialGrowthOfDegreeLE ↥H E)
    (S : Finset G) (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ, 1 ≤ m →
      (MilnorWolf.growthFunction S m : ℝ) ≤ c * (m : ℝ) ^ E := by
  classical
  obtain ⟨T, hT, c, hc, hbd⟩ := hH
  -- the transversal
  have hqfin : Finite (G ⧸ H) := H.finite_quotient_of_finiteIndex
  have hRfin : (Set.range (fun q : G ⧸ H => Quotient.out q)).Finite := Set.finite_range _
  set Rf : Finset G := hRfin.toFinset with hRf
  have hR : ∀ g : G, rep H g ∈ Rf := by
    intro g
    rw [hRf, Set.Finite.mem_toFinset]
    exact rep_mem_range H g
  -- the Schreier set
  set Sy : Finset G := S ∪ S.image (fun x => x⁻¹) with hSy
  set Uf : Finset G :=
    ((Rf ×ˢ Sy ×ˢ Rf).image (fun p : G × G × G => p.1⁻¹ * p.2.1 * p.2.2)).filter
      (fun u => u ∈ H) with hUf
  have hU : ∀ r r' : G, r ∈ Rf → r' ∈ Rf → ∀ x : G,
      (x ∈ (S : Set G) ∨ x⁻¹ ∈ (S : Set G)) → r⁻¹ * x * r' ∈ H → r⁻¹ * x * r' ∈ Uf := by
    intro r r' hr hr' x hx hmem
    have hxSy : x ∈ Sy := by
      rcases hx with h | h
      · exact Finset.mem_union_left _ (by exact_mod_cast h)
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, by exact_mod_cast h, by simp⟩)
    rw [hUf, Finset.mem_filter]
    refine ⟨Finset.mem_image.2 ⟨(r, x, r'), ?_, rfl⟩, hmem⟩
    simp only [Finset.mem_product]
    exact ⟨hr, hxSy, hr'⟩
  set Vf : Finset G := insert (rep H 1) Uf with hVf
  have hUV : (Uf : Set G) ⊆ (Vf : Set G) := by
    rw [hVf, Finset.coe_insert]; exact Set.subset_insert _ _
  have heV : rep H 1 ∈ Vf := by rw [hVf]; exact Finset.mem_insert_self _ _
  -- lengths of the transversal elements
  obtain ⟨L, _, hL⟩ := exists_forall_mem_wordBall Rf S (fun r _ => by rw [hS]; trivial)
  -- the Schreier set lies in H, which is generated by the image of T
  set T' : Finset G := T.image H.subtype with hT'
  have hclos : Subgroup.closure ((T' : Finset G) : Set G) = H := closure_image_eq H T hT
  have hVH : ∀ v ∈ Vf, v ∈ Subgroup.closure ((T' : Finset G) : Set G) := by
    intro v hv
    rw [hclos]
    rw [hVf, Finset.mem_insert] at hv
    rcases hv with rfl | hv
    · exact rep_one_mem H
    · rw [hUf, Finset.mem_filter] at hv; exact hv.2
  obtain ⟨k, hk, hkball⟩ := exists_wordBall_subset_of_mem_closure Vf T' hVH
  -- assemble the estimate
  refine ⟨(Rf.card : ℝ) * c * ((k * (L + 3) : ℕ) : ℝ) ^ E, ?_, ?_⟩
  · have hRpos : 0 < Rf.card := Finset.card_pos.2 ⟨rep H 1, hR 1⟩
    have h1 : (0 : ℝ) < (Rf.card : ℝ) := by exact_mod_cast hRpos
    have h2 : (0 : ℝ) < ((k * (L + 3) : ℕ) : ℝ) := by
      have : 0 < k * (L + 3) := Nat.mul_pos hk (by omega)
      exact_mod_cast this
    positivity
  · intro m hm
    set N : ℕ := k * (L + m + 2) with hN
    have hN1 : 1 ≤ N := by
      have : 0 < k * (L + m + 2) := Nat.mul_pos hk (by omega)
      omega
    have step1 : Nat.card (wordBall (S : Set G) m) ≤
        Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) :=
      card_wordBall_le_mul H S Rf Uf Vf hR hU hUV heV L hL m
    have step2 : Nat.card (wordBall (Vf : Set G) (L + m + 2)) ≤
        Nat.card (wordBall ((T' : Finset G) : Set G) N) := by
      simp only [Nat.card_coe_set_eq]
      exact Set.ncard_le_ncard (hkball _) (finite_wordBall T' N)
    have step3 : Nat.card (wordBall ((T' : Finset G) : Set G) N) =
        Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := card_wordBall_image H T N
    have hchain : (MilnorWolf.growthFunction S m : ℝ) ≤
        (Rf.card : ℝ) * (MilnorWolf.growthFunction T N : ℝ) := by
      have : Nat.card (wordBall (S : Set G) m) ≤
          Rf.card * Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := by
        calc Nat.card (wordBall (S : Set G) m)
            ≤ Rf.card * Nat.card (wordBall (Vf : Set G) (L + m + 2)) := step1
          _ ≤ Rf.card * Nat.card (wordBall ((T' : Finset G) : Set G) N) :=
              Nat.mul_le_mul_left _ step2
          _ = Rf.card * Nat.card (wordBall ((T : Finset ↥H) : Set ↥H) N) := by rw [step3]
      exact_mod_cast this
    have hTb : (MilnorWolf.growthFunction T N : ℝ) ≤ c * (N : ℝ) ^ E := hbd N hN1
    have hRnn : (0 : ℝ) ≤ (Rf.card : ℝ) := by positivity
    have hNle : N ≤ k * (L + 3) * m := by
      have : L + m + 2 ≤ (L + 3) * m := by nlinarith
      calc N = k * (L + m + 2) := hN
        _ ≤ k * ((L + 3) * m) := Nat.mul_le_mul_left _ this
        _ = k * (L + 3) * m := by ring
    have hpow : (N : ℝ) ^ E ≤ ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by
      have hcast : (N : ℝ) ≤ ((k * (L + 3) : ℕ) : ℝ) * (m : ℝ) := by
        have := hNle
        push_cast
        exact_mod_cast this
      calc (N : ℝ) ^ E ≤ (((k * (L + 3) : ℕ) : ℝ) * (m : ℝ)) ^ E :=
            pow_le_pow_left₀ (by positivity) hcast E
        _ = ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by rw [mul_pow]
    calc (MilnorWolf.growthFunction S m : ℝ)
        ≤ (Rf.card : ℝ) * (MilnorWolf.growthFunction T N : ℝ) := hchain
      _ ≤ (Rf.card : ℝ) * (c * (N : ℝ) ^ E) := mul_le_mul_of_nonneg_left hTb hRnn
      _ ≤ (Rf.card : ℝ) * (c * (((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow hc.le) hRnn
      _ = (Rf.card : ℝ) * c * ((k * (L + 3) : ℕ) : ℝ) ^ E * (m : ℝ) ^ E := by ring

/-- **Wolf's Theorem 3.11 (2).**  Polynomial growth of degree `≤ E` passes from a subgroup of
finite index to the whole group. -/
theorem hasPolynomialGrowth_of_finiteIndex (H : Subgroup G) [Group.FG G] [H.FiniteIndex]
    (E : ℕ) (hH : MilnorWolf.HasPolynomialGrowthOfDegreeLE ↥H E) :
    MilnorWolf.HasPolynomialGrowthOfDegreeLE G E := by
  classical
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := G)).1 inferInstance
  obtain ⟨c, hc, hbd⟩ := exists_const_upper_of_finiteIndex H E hH S hS
  exact ⟨S, hS, c, hc, hbd⟩

/-- A finitely generated nilpotent group has polynomial growth of degree `≤ E₂`: the upper bound
of Wolf's Theorem 3.2, quoted just before Theorem 3.11 in the paper. -/
theorem hasPolynomialGrowth_of_isNilpotent (Δ : Type*) [Group Δ] [Group.FG Δ]
    [Group.IsNilpotent Δ] :
    MilnorWolf.HasPolynomialGrowthOfDegreeLE Δ (MilnorWolf.growthExponentTwo Δ) := by
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := Δ)).1 inferInstance
  obtain ⟨c₁, c₂, hc₁, hc₁₂, hbd⟩ :=
    (_root_.Wolf.fg_lcsFactor_and_growth_bounds_of_isNilpotent S hS).2
  exact ⟨S, hS, c₂, lt_of_lt_of_le hc₁ hc₁₂, fun m hm => (hbd m hm).2⟩

/-- **Wolf's Theorem 3.11** (p. 431). -/
theorem fg_and_polynomial_growth_of_finiteIndex' {G : Type*} [Group G] [Group.FG G]
    (H : Subgroup G) [H.FiniteIndex] :
    Group.FG H ∧
      (∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G E) ∧
      (Group.IsNilpotent H → ∀ E : ℕ, MilnorWolf.HasPolynomialGrowthOfDegreeLE H E →
        MilnorWolf.HasPolynomialGrowthOfDegreeLE G
          (min E (MilnorWolf.growthExponentTwo H))) := by
  refine ⟨inferInstance, fun E hE => hasPolynomialGrowth_of_finiteIndex H E hE, ?_⟩
  intro hnil E hE
  have : Group.IsNilpotent ↥H := hnil
  rcases le_total E (MilnorWolf.growthExponentTwo ↥H) with h | h
  · rw [min_eq_left h]
    exact hasPolynomialGrowth_of_finiteIndex H E hE
  · rw [min_eq_right h]
    exact hasPolynomialGrowth_of_finiteIndex H _ (hasPolynomialGrowth_of_isNilpotent ↥H)

end Lib
end Wolf

/-!
# Wolf's Theorem 4.3 (p. 434): the growth dichotomy for polycyclic groups

“Let `Γ` be a polycyclic group, and `S` a finite set of generators.  1. If `Γ` has a nilpotent
subgroup `Δ` of finite index, then there are constants `0 < c₁ < c₂` such that
`c₁ m^{E₁(Δ)} ≤ g_S(m) ≤ c₂ m^{E₂(Δ)}` for every integer `m ≥ 1`; in particular `Γ` is of
polynomial growth of degree `≤ E₂(Δ)`.  2. If `Γ` does not have a nilpotent subgroup of finite
index, then there is a constant `v > 1` such that `v^m ≤ g_S(m) ≤ g_S(1)^m` for every integer
`m ≥ 1`; in particular `Γ` is of exponential growth.”

Part 1 follows Wolf's own proof.  Theorems 3.2 and 3.11 give the upper bound; for the lower
bound, take a finite generating set `T` of `Δ`, note that `g_T ≤ g_{T ∪ S}` because a `T`-word is
a `T ∪ S`-word, and let Lemma 3.5 carry the bound from `T ∪ S` to `S`.  The one adjustment
Wolf's phrasing needs is that Lemma 3.5 transfers *two-sided* bounds, so the upper bound is also
taken on `T ∪ S` rather than on an unspecified generating set; that is why the Theorem 3.11
estimate is stated here for a given generating set.

In part 2 the upper bound `g_S(m) ≤ g_S(1)^m` is elementary and is proved here, as is the
passage from the lower bound to `Chou.HasExponentialGrowth`.  The lower bound itself — that a
polycyclic group with no nilpotent subgroup of finite index has a constant `v > 1` with
`v^m ≤ g_S(m)` — is Wolf's hard half, resting on Proposition 4.4, and enters as a hypothesis.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

/-- `E₁(Δ) ≤ E₂(Δ)`, termwise from `k + 1 ≤ 2 ^ k`. -/
theorem growthExponentOne_le_growthExponentTwo (Δ : Type*) [Group Δ] :
    MilnorWolf.growthExponentOne Δ ≤ MilnorWolf.growthExponentTwo Δ := by
  refine Finset.sum_le_sum fun k _ => Nat.mul_le_mul_right _ ?_
  exact Nat.lt_two_pow_self

/-- The trivial upper bound of Wolf's part 2: the ball of radius `m` is contained in the `m`-fold
product of the ball of radius `1`. -/
theorem growthFunction_le_pow (S : Finset Γ) (m : ℕ) :
    (MilnorWolf.growthFunction S m : ℝ) ≤ (MilnorWolf.growthFunction S 1 : ℝ) ^ m := by
  have hnat : ∀ n : ℕ, MilnorWolf.growthFunction S n ≤ MilnorWolf.growthFunction S 1 ^ n := by
    intro n
    induction n with
    | zero =>
        have hball : wordBall (S : Set Γ) 0 = {1} := by
          ext g
          constructor
          · rintro ⟨l, hlen, -, rfl⟩
            have hl : l = [] := List.eq_nil_of_length_eq_zero (by omega)
            simp [hl]
          · rintro rfl
            exact one_mem_wordBall _ _
        have : MilnorWolf.growthFunction S 0 = 1 := by
          simp [MilnorWolf.growthFunction, hball]
        simp [this]
    | succ p ih =>
        calc MilnorWolf.growthFunction S (p + 1)
            ≤ MilnorWolf.growthFunction S p * MilnorWolf.growthFunction S 1 :=
              card_wordBall_add_le S p 1
          _ ≤ MilnorWolf.growthFunction S 1 ^ p * MilnorWolf.growthFunction S 1 :=
              Nat.mul_le_mul_right _ ih
          _ = MilnorWolf.growthFunction S 1 ^ (p + 1) := by ring
  exact_mod_cast hnat m

/-- An exponential lower bound on one generating set is exponential growth. -/
theorem hasExponentialGrowth_of_exists_pow_le (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) (v : ℝ) (hv : 1 < v)
    (hbd : ∀ m : ℕ, 1 ≤ m → v ^ m ≤ (MilnorWolf.growthFunction S m : ℝ)) :
    Chou.HasExponentialGrowth Γ := by
  refine ⟨S, hS, v, hv, fun n => ?_⟩
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have : (1 : ℕ) ≤ Nat.card (wordBall (S : Set Γ) 0) := one_le_card_wordBall S 0
    have h1 : (1 : ℝ) ≤ (Nat.card (wordBall (S : Set Γ) 0) : ℝ) := by exact_mod_cast this
    simpa using h1
  · exact hbd n hn

/-- **Theorem 4.3, part 1.** -/
theorem exists_const_bounds_of_finiteIndex_isNilpotent
    (h : MilnorWolf.IsPolycyclic Γ) (S : Finset Γ) (hS : Subgroup.closure (S : Set Γ) = ⊤)
    (Δ : Subgroup Γ) (hnil : Group.IsNilpotent ↥Δ) (hfi : Δ.FiniteIndex) :
    (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
        c₁ * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
          (MilnorWolf.growthFunction S m : ℝ) ≤
            c₂ * (m : ℝ) ^ (MilnorWolf.growthExponentTwo ↥Δ)) ∧
      MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo ↥Δ) := by
  classical
  haveI : Group.FG Γ := MilnorWolf.Lib.fg_of_isPolycyclic h
  haveI : Δ.FiniteIndex := hfi
  haveI : Group.FG ↥Δ := inferInstance
  haveI : Group.IsNilpotent ↥Δ := hnil
  -- polynomial growth of `Δ`, and of `Γ`, of degree `≤ E₂(Δ)`
  have hpolyΔ : MilnorWolf.HasPolynomialGrowthOfDegreeLE ↥Δ (MilnorWolf.growthExponentTwo ↥Δ) :=
    hasPolynomialGrowth_of_isNilpotent ↥Δ
  have hpolyΓ : MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo ↥Δ) :=
    hasPolynomialGrowth_of_finiteIndex Δ _ hpolyΔ
  refine ⟨?_, hpolyΓ⟩
  -- a finite generating set of `Δ`, and its image in `Γ`
  obtain ⟨_, T, _, hT⟩ := (Group.fg_iff' (G := ↥Δ)).1 inferInstance
  set T' : Finset Γ := T.image Δ.subtype with hT'def
  -- the two-sided bounds on `Δ` from Theorem 3.2
  obtain ⟨_, b₁, b₂, hb₁, _, hbd⟩ := _root_.Wolf.fg_lcsFactor_and_growth_bounds_of_isNilpotent T hT
  -- the comparison set `U = T' ∪ S`, which generates `Γ`
  set U : Finset Γ := T' ∪ S with hUdef
  have hU : Subgroup.closure (U : Set Γ) = ⊤ := by
    refine top_le_iff.1 ?_
    rw [← hS]
    refine Subgroup.closure_mono ?_
    rw [hUdef, Finset.coe_union]
    exact Set.subset_union_right
  -- the upper bound on `U`
  obtain ⟨c, hc, hup⟩ :=
    exists_const_upper_of_finiteIndex Δ (MilnorWolf.growthExponentTwo ↥Δ) hpolyΔ U hU
  -- the lower bound on `U`: a `T`-word is a `T ∪ S`-word
  have hlow : ∀ m : ℕ, 1 ≤ m →
      min b₁ c * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) ≤
        (MilnorWolf.growthFunction U m : ℝ) := by
    intro m hm
    have hsub : MilnorWolf.growthFunction T' m ≤ MilnorWolf.growthFunction U m :=
      card_wordBall_le_of_subset
        (wordBall_mono_set (by rw [hUdef, Finset.coe_union]; exact Set.subset_union_left) m)
    have himg : MilnorWolf.growthFunction T' m = MilnorWolf.growthFunction T m :=
      card_wordBall_image Δ T m
    have hb := (hbd m hm).1
    have hmin : min b₁ c * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) ≤
        b₁ * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) := by
      have : min b₁ c ≤ b₁ := min_le_left _ _
      have hpow : (0 : ℝ) ≤ (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) := by positivity
      exact mul_le_mul_of_nonneg_right this hpow
    have hcast : (MilnorWolf.growthFunction T m : ℝ) ≤ (MilnorWolf.growthFunction U m : ℝ) := by
      rw [← himg]; exact_mod_cast hsub
    linarith [hb, hcast, hmin]
  -- Lemma 3.5 carries the two-sided bounds from `U` to `S`
  refine exists_const_polynomial_bounds_of_generating' S U hS hU (min b₁ c) c
    (lt_min hb₁ hc) (min_le_right _ _) _ _ (growthExponentOne_le_growthExponentTwo ↥Δ)
    (fun m hm => ⟨hlow m hm, hup m hm⟩)

/-- **Wolf's Theorem 4.3**, with the hard half of part 2 as a hypothesis: for a polycyclic group
with no nilpotent subgroup of finite index, an exponential lower bound on the given generating
set.  That is the assertion resting on Wolf's Proposition 4.4. -/
theorem growth_dichotomy_of_isPolycyclic_of_exists
    (h : MilnorWolf.IsPolycyclic Γ) (S : Finset Γ) (hS : Subgroup.closure (S : Set Γ) = ⊤)
    (hard : (¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent ↥Δ ∧ Δ.FiniteIndex) →
      ∃ v : ℝ, 1 < v ∧ ∀ m : ℕ, 1 ≤ m → v ^ m ≤ (MilnorWolf.growthFunction S m : ℝ)) :
    (∀ Δ : Subgroup Γ, Group.IsNilpotent ↥Δ → Δ.FiniteIndex →
        (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
            c₁ * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) ≤
                (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤
                c₂ * (m : ℝ) ^ (MilnorWolf.growthExponentTwo ↥Δ)) ∧
          MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo ↥Δ)) ∧
      ((¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent ↥Δ ∧ Δ.FiniteIndex) →
        (∃ v : ℝ, 1 < v ∧ ∀ m : ℕ, 1 ≤ m →
            v ^ m ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤ (MilnorWolf.growthFunction S 1 : ℝ) ^ m) ∧
          Chou.HasExponentialGrowth Γ) := by
  refine ⟨fun Δ hnil hfi => exists_const_bounds_of_finiteIndex_isNilpotent h S hS Δ hnil hfi, ?_⟩
  intro hno
  obtain ⟨v, hv, hbd⟩ := hard hno
  exact ⟨⟨v, hv, fun m hm => ⟨hbd m hm, growthFunction_le_pow S m⟩⟩,
    hasExponentialGrowth_of_exists_pow_le S hS v hv hbd⟩

/-- **Wolf's Theorem 4.3** (p. 434).  The hypothesis of the previous theorem is now discharged by
the published statement of its second part, so this is the theorem as Wolf states it. -/
theorem growth_dichotomy_of_isPolycyclic' (h : MilnorWolf.IsPolycyclic Γ) (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) :
    (∀ Δ : Subgroup Γ, Group.IsNilpotent ↥Δ → Δ.FiniteIndex →
        (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
            c₁ * (m : ℝ) ^ (MilnorWolf.growthExponentOne ↥Δ) ≤
                (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤
                c₂ * (m : ℝ) ^ (MilnorWolf.growthExponentTwo ↥Δ)) ∧
          MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo ↥Δ)) ∧
      ((¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent ↥Δ ∧ Δ.FiniteIndex) →
        (∃ v : ℝ, 1 < v ∧ ∀ m : ℕ, 1 ≤ m →
            v ^ m ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤ (MilnorWolf.growthFunction S 1 : ℝ) ^ m) ∧
          Chou.HasExponentialGrowth Γ) :=
  growth_dichotomy_of_isPolycyclic_of_exists h S hS (fun hno =>
    _root_.Wolf.exists_pow_le_growthFunction_of_isPolycyclic_of_not_exists_nilpotent_finiteIndex
      h hno S hS)

end Lib
end Wolf

open Wolf

theorem solution {Γ : Type*} [Group Γ] (h : MilnorWolf.IsPolycyclic Γ)
    (S : Finset Γ) (hS : Subgroup.closure (S : Set Γ) = ⊤) :
    (∀ Δ : Subgroup Γ, Group.IsNilpotent Δ → Δ.FiniteIndex →
        (∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
            c₁ * (m : ℝ) ^ (MilnorWolf.growthExponentOne Δ) ≤
                (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤
                c₂ * (m : ℝ) ^ (MilnorWolf.growthExponentTwo Δ)) ∧
          MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo Δ)) ∧
      ((¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent Δ ∧ Δ.FiniteIndex) →
        (∃ v : ℝ, 1 < v ∧ ∀ m : ℕ, 1 ≤ m →
            v ^ m ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
              (MilnorWolf.growthFunction S m : ℝ) ≤ (MilnorWolf.growthFunction S 1 : ℝ) ^ m) ∧
          Chou.HasExponentialGrowth Γ) :=
  Wolf.Lib.growth_dichotomy_of_isPolycyclic' h S hS
