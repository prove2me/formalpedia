lemma LIDT.MIPStarRE.LDT.Pasting.hAConsistency_error_le_nu_of_pos
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    (eps delta gamma zeta : _root_.LIDT.MIPStarRE.LDT.Error)
    (k : ℕ)
    (hk_pos : 1 ≤ k)
    (heps_nonneg : 0 ≤ eps)
    (hdelta_nonneg : 0 ≤ delta)
    (hgamma_nonneg : 0 ≤ gamma)
    (hzeta_nonneg : 0 ≤ zeta) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.hBConsistencyError params eps delta gamma zeta k +
        Real.sqrt (8 * (params.m : _root_.LIDT.MIPStarRE.LDT.Error) * min eps 1 + 4 * min delta 1)
      ≤ _root_.LIDT.MIPStarRE.LDT.MainInductionStep.ldPastingInInductionNu params k eps delta gamma zeta := by sorry
