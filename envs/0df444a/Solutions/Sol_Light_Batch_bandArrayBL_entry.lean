    (hx : l.getD i d = x) : (l.take i).count x < l.count x := by
  have hle : (l.take (i + 1)).count x ≤ l.count x := (List.take_sublist _ _).count_le _
  rw [count_take_succ_getD l x hi d, if_pos hx] at hle
