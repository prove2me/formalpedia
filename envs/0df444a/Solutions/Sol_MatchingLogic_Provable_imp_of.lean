theorem _root_.solution {Gamma : Set (Pattern S Var)}
    {phi psi : Pattern S Var} (h : Provable Gamma phi) : Provable Gamma (.imp psi phi) := by
  have ht : Provable Gamma (.imp phi (.imp psi phi)) := by
