section
-- Source module: Solutions.R6CxNetChkI
/-!
# Kernel checks of the boundary states and of the triple data

* `chkW`: the snapshot trees are well formed;
* `chkI1` / `chkI2`: the initial snapshots hold `init1` / `init2`;
* `chkF1` / `chkF2`: the final codes of the `x`, `y`, `a` wires;
* `chkTV`: every triple mask has three bits and its line code is `psp a b {c}` with `{a,b,c}` the triple;
* `chkG`: every gate has an input.
-/

set_option Elab.async false

namespace IntMul.Kappa.R6.Cx.NetData

open NetBT NetLoc NetSpec NetFast NetRaw NetMask

theorem allN_spec (f : ℕ → Bool) : ∀ n, allN f n = true → ∀ x < n, f x = true := by
  intro n
  induction n with
  | zero => intro _ x hx; omega
  | succ n ih =>
    intro h x hx
    have h' : (f n && allN f n) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.1 hx with hx | rfl
    · exact ih h'.2 x hx
    · exact h'.1

end IntMul.Kappa.R6.Cx.NetData

end

section
-- Source module: Solutions.R6CxNetInvoc
/-!
# One stage invocation in global terms

* `triOK`, `dataOK`: the data facts (from the kernel checks);
* `G1 b` / `G2 a`: the global chunk programs of stage-one invocation `b` / stage-two invocation `a`
  (the checked local program mapped by `ι1 b` / `ι2 a` with the frames of `R6CxNetFrame`);
* `inv1` / `inv2`: validity and labels (from `prog_valid`);
* `log1` / `log2`: the logical effect (from `NetEff.stage1/2` via `runOps_map`);
* `wid1` / `wid2`: the child widths are the nonzero checked move widths (independent of `b`/`a`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

/-! ## Data facts -/

lemma psp_line {a b C : ℕ} (hp : PspOK a b C) (h1 : pc24 C = 1) :
    pspSp a b C = lineM (bitv (2 ^ a ||| 2 ^ b ||| C)) := by
  have h1' := h1
  rw [pc24_eq, ← card_filter_testBit] at h1'
  obtain ⟨c0, hc0⟩ := Finset.card_eq_one.1 h1'
  have hc0m : c0 ∈ univ.filter (fun i : Fin 24 => C.testBit i) := by rw [hc0]; exact Finset.mem_singleton_self _
  have hc0b : C.testBit c0 = true := (Finset.mem_filter.1 hc0m).2
  rw [pspSp, lineM]
  congr 1
  ext v
  rw [Finset.mem_coe, gP, Finset.mem_image, Set.mem_singleton_iff]
  constructor
  · rintro ⟨c, hc, rfl⟩
    exact line_gen hp h1 c (Finset.mem_filter.1 hc).2
  · rintro rfl
    exact ⟨c0, hc0m, line_gen hp h1 c0 hc0b⟩

lemma line_of_ok {t : ℕ} (h : lineOK t = true) :
    NetF2.dec (Code.ofNat (dat.lc t)) = lineM (bitv (dat.tv t)) := by
  unfold lineOK at h
  simp only [Bool.and_eq_true, Nat.beq_eq, Nat.blt_eq, Bool.not_eq_true'] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hc, ha⟩, hb⟩, hab⟩, hpc⟩, hCa⟩, hCb⟩, htv⟩ := h
  have hc' : dat.lc t % 4 = 1 := hc
  have hcode : Code.ofNat (dat.lc t) =
      .psp (dat.lc t / 4 % 32) (dat.lc t / 128 % 32) (dat.lc t / 4096) := by
    unfold Code.ofNat
    rw [show Nat.beq (dat.lc t % 4) 0 = false by rw [hc']; rfl,
      show Nat.beq (dat.lc t % 4) 1 = true by rw [hc']; rfl]
    rfl
  rw [hcode]
  have hp : PspOK (dat.lc t / 4 % 32) (dat.lc t / 128 % 32) (dat.lc t / 4096) :=
    ⟨ha, hb, Nat.ne_of_beq_eq_false hab, hCa, hCb⟩
  have := psp_line hp hpc
  rw [htv]
  exact this

theorem triOK : TriOK dat where
  pc := fun S hS => by
    have h := allN_spec _ NV chkTV S hS
    simp only [Bool.and_eq_true, Nat.beq_eq] at h
    rw [← pc24_eq, ← pcR_eq]; exact h.1
  line := fun S hS => by
    have h := allN_spec _ NV chkTV S hS
    simp only [Bool.and_eq_true] at h
    exact line_of_ok h.2

theorem dataOK : DataOK dat := by
  obtain ⟨_, hg, hsrc, hR, hlen⟩ := maskAll
  refine ⟨hg, hsrc, hR, hlen, fun g hg' => ?_⟩
  have := allR_spec chkG g hg'
  simpa using this

theorem maskOK : MaskOK dat := maskAll.1

lemma wf10 : S1_0.wf 8 = true := by
  have := chkW; simp only [Bool.and_eq_true] at this; exact this.1
lemma wf20 : S2_0.wf 8 = true := by
  have := chkW; simp only [Bool.and_eq_true] at this; exact this.2

/-! ## Local-to-global plumbing -/

lemma progRun_ops : ∀ (ss : List Spec) (t : BT), (progRun ss t).1.flatMap LChunk.ops = ss.flatMap Spec.ops
  | [], _ => rfl
  | s :: ss, t => by
    simp only [progRun, List.flatMap_cons]
    rw [progRun_ops ss]

lemma progChk_ops_lt {nl : ℕ} {mvOK : ℕ → ℕ → ℕ → Bool} {wd : ℕ → ℕ → ℕ → ℕ} :
    ∀ (ss : List Spec) (t : BT), (progChk nl mvOK wd ss t).1 = true →
      ∀ o ∈ ss.flatMap Spec.ops, o.1 < nl ∧ o.2.1 < nl
  | [], _, _, o, ho => by simp at ho
  | s :: ss, t, h, o, ho => by
    simp only [progChk, Bool.and_eq_true] at h
    obtain ⟨hc, hr⟩ := h
    rw [List.flatMap_cons] at ho
    rcases List.mem_append.1 ho with ho | ho
    · simp only [chunkOK, Bool.and_eq_true, List.all_eq_true, Nat.blt_eq] at hc
      have := hc.2 o ho
      exact ⟨this.1.1.1, this.1.1.2⟩
    · exact progChk_ops_lt ss _ hr o ho

lemma progOps_mapProg {R : Type} [DecidableEq R] (ι : ℕ → R) (labV : ℕ → Lab 576) (lab : ℕ → ℕ → Lab 576)
    (cs : List LChunk) : progOps (mapProg ι labV lab cs) = (cs.flatMap LChunk.ops).map (toG ι) := by
  induction cs with
  | nil => rfl
  | cons C cs ih =>
    simp only [mapProg, progOps, List.map_cons, List.flatMap_cons, List.map_append] at ih ⊢
    rw [← ih]
    rfl

/-! ## Role lemmas -/

lemma ι1_x {b t : ℕ} (ht : t < NV) : ι1 b (xw t) = Xr t b := by
  rw [ι1, xw, if_pos ht]
lemma ι1_y {b S : ℕ} (hS : S < NV) : ι1 b (yw S) = Yr S b := by
  rw [ι1, yw_eq, if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]
lemma ι1_a {b q : ℕ} (hq : q < NR) : ι1 b (aw q) = A1r b q := by
  rw [ι1, aw_eq, if_neg (by omega), if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]
lemma ι1_m {b j : ℕ} : ι1 b (mw j) = M1r b j := by
  rw [ι1, mw_eq, if_neg (by omega), if_neg (by omega), if_neg (by omega), Nat.add_sub_cancel_left]

lemma ι2_x {a t : ℕ} (ht : t < NV) : ι2 a (xw t) = Yr a t := by
  rw [ι2, xw, if_pos ht]
lemma ι2_y {a S : ℕ} (hS : S < NV) : ι2 a (yw S) = Xr a S := by
  rw [ι2, yw_eq, if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]
lemma ι2_a {a q : ℕ} (hq : q < NR) : ι2 a (aw q) = A2r a q := by
  rw [ι2, aw_eq, if_neg (by omega), if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]
lemma ι2_m {a j : ℕ} : ι2 a (mw j) = M2r a j := by
  rw [ι2, mw_eq, if_neg (by omega), if_neg (by omega), if_neg (by omega), Nat.add_sub_cancel_left]

/-! ## The two invocation programs -/

lemma seg1 : (progChk NL mvOK1 wd1 (specs1 dat) S1_0).1 = true ∧ (progRun (specs1 dat) S1_0).2 = S1_14 := by
  obtain ⟨⟨h1, -, -, h4⟩, -⟩ := stage1Seg dataOK wf10
  exact ⟨h1, h4⟩

lemma seg2 : (progChk NL (mvOK2 dat) wd2 (specs2 dat) S2_0).1 = true ∧ (progRun (specs2 dat) S2_0).2 = S2_14 := by
  obtain ⟨⟨h1, -, -, h4⟩, -⟩ := stage2Seg dataOK wf20
  exact ⟨h1, h4⟩

theorem inv1 {b : ℕ} (hb : b < NV) (g : Rl → Lab 576)
    (hC : Corr NL (ι1 b) (fun _ c => labV1 dat b c) S1_0 g) :
    ProgValid (G1 b) g ∧ Corr NL (ι1 b) (fun _ c => labV1 dat b c) S1_14 (progLab (G1 b) g) ∧
      ∀ r, (∀ w < NL, ι1 b w ≠ r) → progLab (G1 b) g r = g r := by
  have := prog_valid (frame1 triOK hb (ι1_inj hb)) wd1 (specs1 dat) S1_0 g wf10 seg1.1 hC
  rw [seg1.2] at this
  exact this

theorem inv2 {a : ℕ} (ha : a < NV) (g : Rl → Lab 576)
    (hC : Corr NL (ι2 a) (lab2 dat a) S2_0 g) :
    ProgValid (G2 a) g ∧ Corr NL (ι2 a) (lab2 dat a) S2_14 (progLab (G2 a) g) ∧
      ∀ r, (∀ w < NL, ι2 a w ≠ r) → progLab (G2 a) g r = g r := by
  have := prog_valid (frame2 triOK ha (ι2_inj ha)) wd2 (specs2 dat) S2_0 g wf20 seg2.1 hC
  rw [seg2.2] at this
  exact this

section Log

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

theorem log1 {b : ℕ} (hb : b < NV) (Λ : Rl → Vt) (hm : ∀ j < 24, Λ (M1r b j) = 0) :
    (∀ S < NV, runOps (progOps (G1 b)) Λ (Yr S b) = Λ (Yr S b) + Λ (Xr S b)) ∧
    (∀ q < NR, runOps (progOps (G1 b)) Λ (A1r b q) = Λ (A1r b q)) ∧
    (∀ t < NV, runOps (progOps (G1 b)) Λ (Xr t b) = Λ (Xr t b)) ∧
    (∀ r, (∀ w < NL, ι1 b w ≠ r) → runOps (progOps (G1 b)) Λ r = Λ r) := by
  rw [G1, progOps_mapProg, cs1, progRun_ops]
  obtain ⟨k1, k2⟩ := runOps_map NL (ι1 b) (ι1_inj hb) ((specs1 dat).flatMap Spec.ops) Λ
    (progChk_ops_lt _ _ seg1.1)
  obtain ⟨s1, s2, s3⟩ := stage1 dat dataOK.gok dataOK.len dataOK.src dataOK.rd maskOK
    (fun w => Λ (ι1 b w)) (fun j hj => by simp only [ι1_m]; exact hm j hj)
  refine ⟨fun S hS => ?_, fun q hq => ?_, fun t ht => ?_, k2⟩
  · have e := k1 (yw S) (by simp only [yw_eq, NL, NV] at *; omega)
    rw [ι1_y hS] at e
    rw [e, s1 S hS, ι1_y hS, ι1_x hS]
  · have e := k1 (aw q) (by simp only [aw_eq, NL, NV, NR] at *; omega)
    rw [ι1_a hq] at e
    rw [e, s2 q hq, ι1_a hq]
  · have e := k1 (xw t) (by simp only [xw, NL, NV] at *; omega)
    rw [ι1_x ht] at e
    rw [e, s3 t ht, ι1_x ht]

theorem log2 {a : ℕ} (ha : a < NV) (Λ : Rl → Vt) (hm : ∀ j < 24, Λ (M2r a j) = 0) :
    (∀ S < NV, runOps (progOps (G2 a)) Λ (Xr a S) = Λ (Xr a S) - Λ (Yr a S)) ∧
    (∀ q < NR, runOps (progOps (G2 a)) Λ (A2r a q) = Λ (A2r a q)) ∧
    (∀ t < NV, runOps (progOps (G2 a)) Λ (Yr a t) = Λ (Yr a t)) ∧
    (∀ r, (∀ w < NL, ι2 a w ≠ r) → runOps (progOps (G2 a)) Λ r = Λ r) := by
  rw [G2, progOps_mapProg, cs2, progRun_ops]
  obtain ⟨k1, k2⟩ := runOps_map NL (ι2 a) (ι2_inj ha) ((specs2 dat).flatMap Spec.ops) Λ
    (progChk_ops_lt _ _ seg2.1)
  obtain ⟨s1, s2, s3⟩ := stage2 dat dataOK.gok dataOK.len dataOK.src dataOK.rd maskOK
    (fun w => Λ (ι2 a w)) (fun j hj => by simp only [ι2_m]; exact hm j hj)
  refine ⟨fun S hS => ?_, fun q hq => ?_, fun t ht => ?_, k2⟩
  · have e := k1 (yw S) (by simp only [yw_eq, NL, NV] at *; omega)
    rw [ι2_y hS] at e
    rw [e, s1 S hS, ι2_y hS, ι2_x hS]
  · have e := k1 (aw q) (by simp only [aw_eq, NL, NV, NR] at *; omega)
    rw [ι2_a hq] at e
    rw [e, s2 q hq, ι2_a hq]
  · have e := k1 (xw t) (by simp only [xw, NL, NV] at *; omega)
    rw [ι2_x ht] at e
    rw [e, s3 t ht, ι2_x ht]

end Log

