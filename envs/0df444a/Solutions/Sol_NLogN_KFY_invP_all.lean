section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFY
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
open NLogN.KFM (shPad bsN)
set_option maxHeartbeats 4000000
theorem solution (u : NLogN.IState NLogN.HS) (s t : ℕ) (LT LS : List NLogN.Item)
    (hT : u.G NLogN.KFY.yT = .int (t : ℤ) :: LT) (hS : u.G NLogN.KFY.yS = .int (s : ℤ) :: LS) (ht : 2 ≤ t)
    (hc : Nat.Coprime s t) (A B : ℕ) (hE : NLogN.KFM.CostEnv A B) (htt : t * t ≤ A) (hsA : s ≤ A) :
    NLogN.KFY.RSAll NLogN.KFY.invP u (u.upd NLogN.KFY.yU (.int (((s : ZMod t)⁻¹).val : ℤ) :: u.G NLogN.KFY.yU)) (NLogN.KFY.invC t B) := by
  have hB1 := hE.B1
  have htA : t ≤ A := le_trans (Nat.le_mul_of_pos_left t (by omega)) htt
  have hzs : ∀ x : ℕ, x ≤ A → NLogN.zsz (x : ℤ) ≤ B := fun x hx => hE.zsz_nat hx
  set v : ℕ := ((s : ZMod t)⁻¹).val with hvd
  have hvt : v < t := by haveI : NeZero t := ⟨by omega⟩; exact ZMod.val_lt _
  -- pushes
  have h1 := NLogN.KFY.RSAll.push1 NLogN.KFM.mS (.reg NLogN.KFY.yT) rfl u B (by decide) (NLogN.KFY.clean_regs _ (by decide))
    (NLogN.IState.isInt_of hT) (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq hT]; exact hzs _ htA)
  simp only [NLogN.Ex.eval, NLogN.IState.top_eq hT] at h1
  set u1 := u.upd NLogN.KFM.mS (.int (t : ℤ) :: u.G NLogN.KFM.mS) with hu1
  have u1S : u1.G NLogN.KFY.yS = .int (s : ℤ) :: LS := by simp +decide [hu1, hS]
  have h2 := NLogN.KFY.RSAll.push1 NLogN.KFM.mP (.reg NLogN.KFY.yS) rfl u1 B (by decide) (NLogN.KFY.clean_regs _ (by decide))
    (NLogN.IState.isInt_of u1S) (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq u1S]; exact hzs _ hsA)
  simp only [NLogN.Ex.eval, NLogN.IState.top_eq u1S] at h2
  set u2 := u1.upd NLogN.KFM.mP (.int (s : ℤ) :: u1.G NLogN.KFM.mP) with hu2
  have h3 := NLogN.KFY.RSAll.push1 NLogN.KFM.mM (.lit 0) rfl u2 B (by decide) (NLogN.KFY.clean_regs _ (by decide))
    trivial (by simp only [NLogN.Ex.Bnd, NLogN.zsz_zero]; omega)
  simp only [NLogN.Ex.eval] at h3
  set u3 := u2.upd NLogN.KFM.mM (.int 0 :: u2.G NLogN.KFM.mM) with hu3
  have u3S : u3.G NLogN.KFM.mS = .int (t : ℤ) :: u.G KFM.mS := by simp +decide [hu3, hu2, hu1]
  have u3P : u3.G NLogN.KFM.mP = .int (s : ℤ) :: u1.G KFM.mP := by simp +decide [hu3, hu2]
  have u3M : u3.G NLogN.KFM.mM = .int 0 :: u2.G KFM.mM := by simp +decide [hu3]
  -- the sum loop
  obtain ⟨o4, r4⟩ := NLogN.KFM.sumLoop_run u3 t s _ _ _ u3S u3P u3M ht
  have c4 := NLogN.KFM.sumLoop_cost u3 t s _ _ _ u3S u3P u3M ht A B hE htt hsA
  rw [NLogN.KFY.inv_sum s t ht hc] at r4
  set u4 := u3.upd NLogN.KFM.mM (.int (v : ℤ) :: u2.G NLogN.KFM.mM) with hu4
  have h4 : NLogN.KFY.RSAll (.rep NLogN.KFM.mIc (.reg NLogN.KFM.mS) NLogN.KFM.sumB) u3 u4
      ((t + 1) * 40 * (10 ^ 7 * (B + 2) ^ 2)) := ⟨o4, r4, c4⟩
  have u4M : u4.G NLogN.KFM.mM = .int (v : ℤ) :: u2.G KFM.mM := by simp +decide [hu4]
  have h5 := NLogN.KFY.RSAll.push1 NLogN.KFY.yU (.reg NLogN.KFM.mM) rfl u4 B (by decide) (NLogN.KFY.clean_regs _ (by decide))
    (NLogN.IState.isInt_of u4M) (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq u4M]; exact hzs _ (by omega))
  simp only [NLogN.Ex.eval, NLogN.IState.top_eq u4M] at h5
  set u5 := u4.upd NLogN.KFY.yU (.int (v : ℤ) :: u4.G NLogN.KFY.yU) with hu5
  have h6 := NLogN.KFY.RSAll.pop NLogN.KFM.mM u5 (v : ℤ) (u2.G NLogN.KFM.mM) B (by decide) (by simp +decide [hu5, hu4])
    (hzs _ (by omega))
  set u6 := u5.upd NLogN.KFM.mM (u2.G NLogN.KFM.mM) with hu6
  have h7 := NLogN.KFY.RSAll.pop NLogN.KFM.mP u6 (s : ℤ) (u1.G NLogN.KFM.mP) B (by decide)
    (by simp +decide [hu6, hu5, hu4, hu3, hu2]) (hzs _ hsA)
  set u7 := u6.upd NLogN.KFM.mP (u1.G NLogN.KFM.mP) with hu7
  have h8 := NLogN.KFY.RSAll.pop NLogN.KFM.mS u7 (t : ℤ) (u.G NLogN.KFM.mS) B (by decide)
    (by simp +decide [hu7, hu6, hu5, hu4, hu3, hu2, hu1]) (hzs _ htA)
  have hfin : u7.upd NLogN.KFM.mS (u.G NLogN.KFM.mS) =
      u.upd NLogN.KFY.yU (.int (v : ℤ) :: u.G NLogN.KFY.yU) := by
    apply NLogN.IState.ext' _ (by simp +decide [hu7, hu6, hu5, hu4, hu3, hu2, hu1])
      (by simp +decide [hu7, hu6, hu5, hu4, hu3, hu2, hu1])
    intro j
    by_cases j1 : j = NLogN.KFM.mS
    · subst j1; simp +decide
    by_cases j2 : j = NLogN.KFM.mP
    · subst j2; simp +decide [hu7, hu1]
    by_cases j3 : j = NLogN.KFM.mM
    · subst j3; simp +decide [hu7, hu6, hu2, hu1]
    by_cases j4 : j = NLogN.KFY.yU
    · subst j4; simp +decide [hu7, hu6, hu5, hu4, hu3, hu2, hu1]
    simp +decide [hu7, hu6, hu5, hu4, hu3, hu2, hu1, j1, j2, j3, j4]
  rw [hfin] at h8
  have H := h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq h8))))))
  refine H.mono ?_
  unfold NLogN.KFY.invC
  generalize 10 ^ 7 * (B + 2) ^ 2 = K
  omega
end
