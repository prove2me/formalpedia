private theorem splitFragmentObligations {n N : ℕ} {codes : ℕ → CycleCode}
    {Γ : List (LinearAtom n)} {i : Fin n} {p q : ℕ} {st : Bool}
    {l r : LinearFragment n} (hq : 0 < q)
    (hl : fragmentObligations N codes (upperAtom i p q st :: Γ) l)
    (hr : fragmentObligations N codes (complementAtom (upperAtom i p q st) :: Γ) r) :
    fragmentObligations N codes Γ (.split i p q st l r) := ⟨hq, hl, hr⟩

