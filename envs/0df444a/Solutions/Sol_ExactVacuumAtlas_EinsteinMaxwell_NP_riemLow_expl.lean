-- ==== solution ====
open scoped ContDiff
open Matrix
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {U : Set (Pt n)}
theorem solution (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (a b c d : Fin n) :
    riemLow g gi a b c d y = (hessG g c b a d y - hessG g c a d b y - hessG g d b a c y
      + hessG g d a c b y) / 2 + quadQ g gi a b c d y := by
  have hq : ∀ c d : Fin n, ∑ e, chr1 g e c a y * christoffel g gi e d b y
      = ∑ e, ∑ f, gi e f y * (chr1 g e c a y * chr1 g f d b y) := by
    intro c d
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [christoffel_eq_sum_chr1, Finset.mul_sum]
    exact Finset.sum_congr rfl fun f _ => by ring
  have hQ : quadQ g gi a b c d y = ∑ e, ∑ f, gi e f y * (chr1 g e d a y * chr1 g f c b y)
      - ∑ e, ∑ f, gi e f y * (chr1 g e c a y * chr1 g f d b y) := by
    simp only [quadQ, mul_sub, Finset.sum_sub_distrib]
  rw [riemLow_formula hm hy, pd_chr1 hm hy, pd_chr1 hm hy, hq c d, hq d c, hQ,
    hessG_symm_ij hm hy d c a b]
  ring
