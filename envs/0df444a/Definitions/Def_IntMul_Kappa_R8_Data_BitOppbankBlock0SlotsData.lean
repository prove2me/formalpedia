theorem map_append_4 {α β : Type} (f : α → β) (A B : List α) :
    (A ++ B).map f = A.map f ++ B.map f :=
  List.map_append

theorem forall_of_map_eq {α : Type} {f g : α → Nat} {A : List α}
    (h : A.map f = A.map g) : ∀ p ∈ A, f p = g p := by
  intro p hp
  induction A with
  | nil => cases hp
  | cons a A ih =>
    simp only [List.map_cons, List.cons.injEq, List.mem_cons] at h hp
    rcases hp with rfl | hp
    · exact h.1
    · exact ih h.2 hp

theorem forall_mem_append {α : Type} {P : α → Prop} {A B : List α}
    (hA : ∀ p ∈ A, P p) (hB : ∀ p ∈ B, P p) : ∀ p ∈ A ++ B, P p := by
  intro p hp
  rcases List.mem_append.mp hp with h | h
  · exact hA p h
  · exact hB p h

