theorem tVadj_comm (ℓ ℓ' : Nat.Primes) (x : ↥(characterLattice V)) : Q.tVadj ℓ (Q.tVadj ℓ' x) = Q.tVadj ℓ' (Q.tVadj ℓ x) := by
