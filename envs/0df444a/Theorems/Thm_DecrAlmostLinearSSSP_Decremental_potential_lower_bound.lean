-- title:
--   Lemma 3.6 — Global potential lower bound
-- statement:
--   On the normalized core and return graph with the §3.1 costs, coefficients and parameters, every real label vector $p$ normalized by $p_s=0$ satisfies
--
--   $$\Psi(p)\ge0.$$
--
--   This includes arbitrary infeasible labels and negative logical slacks, as well as every possible active subset of original edges. There is no assumption that the vector was generated by repair or that its slacks are positive. The global floor makes the total descent budget meaningful.
--
--   Differences from the source:
--   - encoding: the shared §3.1 graph, parameters and all real source-normalized labels → finite labelled edge sets and the same real clipped potential; reason: finite reindexing preserves the edge sum and every real label vector; no feasibility or positivity hypothesis is imposed
-- source:
--   Bin Cui, Hanqing Li, Xupeng Miao, Haoze Wang, STOC 2027 submission #912 (October 2026), p. 15, Lemma 3.6; pp. 7–8, §3.1 standing assumptions; pinned PDF: https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/912.pdf

import Mathlib
import Definitions.Def_DecrAlmostLinearSSSP_Decremental_Potential

set_option autoImplicit false
open scoped ENNReal NNReal

namespace DecrAlmostLinearSSSP.Decremental

/-- Lemma 3.6 is global, with no feasibility or execution invariant on p. -/
theorem potential_lower_bound (b : Core) (active : Finset (Fin b.input.k))
    (p : Fin b.input.n → ℝ) (hs : p b.input.source = 0) :
    0 ≤ potential b active p := by sorry

end DecrAlmostLinearSSSP.Decremental
