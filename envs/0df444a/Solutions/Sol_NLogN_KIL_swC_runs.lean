    r = rJ1 ∨ r = rLp ∨ r = rVA ∨ r = sQQ ∨ r = rVB ∨ r = rVC := by
  intro p hp r hr
  simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl <;> simp only [Ex.regs, List.mem_append,
    List.mem_cons, List.not_mem_nil, or_false] at hr
  · simp [hr]
  · simp [hr]
  · rcases hr with h | h
    · simp [h]
    · simp [powE_sQQ_regs _ r h]
  · rcases hr with h | h | h
    · simp [powE_sQQ_regs _ r h]
    · simp [h]
    · simp [powE_sQQ_regs _ r h]
  · rcases hr with h | h
    · simp [powE_sQQ_regs _ r h]
    · simp [h]

end Call

end NLogN.KIL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KIL
open IntMul RS AModel
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {q m k P L' N : ℕ} {A B Cs : AModel.Shape} (a b : ℕ) (ha : a < m) (hb : m ≤ b)
    (hb' : b < m + m) (j0 : Fin Pp) (ch : List (ZMod 2) → List (ZMod 2)) (c0 : ℕ)
    (hrec : ∀ (t' : NLogN.IState NLogN.HS) (R' : List NLogN.Item) (ys : List (ZMod 2)),
      NLogN.KIL.DescIn t' q m k P L' (A ++ List.replicate a N)
        (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
        (List.replicate (m + m - 1 - b) N ++ Cs) →
      ys.length = AModel.vol (P :: L' :: AModel.hdShape A B Cs m N) →
      NLogN.IRuns I iprog (iprog j0) (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R'))
        (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R')) c0)
    (Bb : ℕ) (hN : 1 ≤ N) (hpos : ∀ x ∈ P :: L' :: AModel.hdShape A B Cs m N, 1 ≤ x)
    (hV : NLogN.zsz ((AModel.vol (P :: L' :: AModel.hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb) (hk : NLogN.zsz (k : ℤ) ≤ Bb)
    (t : NLogN.IState NLogN.HS) {L1 L2 L3 L4 L5 L6 L7 L8 : List NLogN.Item}
    (hJ1 : t.G NLogN.KIL.rJ1 = .int (k : ℤ) :: L1) (hLp : t.G NLogN.KIL.rLp = .int (L' : ℤ) :: L2)
    (hVA : t.G NLogN.KIL.rVA = .int ((AModel.vol A : ℕ) : ℤ) :: L3) (hVB : t.G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: L4)
    (hVC : t.G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: L5) (hQQ : t.G NLogN.KIL.sQQ = .int (N : ℤ) :: L6)
    (hP : t.G NLogN.KIL.dP = .int (P : ℤ) :: L7) (hT : t.G NLogN.KIL.dT = NLogN.ints (NLogN.KIL.towerL q m k) ++ L8)
    (R : List NLogN.Item) (ys : List (ZMod 2)) (hys : ys.length = AModel.vol (P :: L' :: AModel.hdShape A B Cs m N)) :
    NLogN.IRuns I iprog (NLogN.KIL.swC m j0 a b) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R))
      (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R)) (NLogN.KIL.cSwC m a b Bb c0) := by
  set t0 := t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R)
  have g : ∀ r : Fin NLogN.HS, r ≠ 0 → t0.G r = t.G r := fun r hr => by simp [t0, hr]
  have hJ1' := (g NLogN.KIL.rJ1 (by decide)).trans hJ1
  have hLp' := (g NLogN.KIL.rLp (by decide)).trans hLp
  have hVA' := (g NLogN.KIL.rVA (by decide)).trans hVA
  have hVB' := (g NLogN.KIL.rVB (by decide)).trans hVB
  have hVC' := (g NLogN.KIL.rVC (by decide)).trans hVC
  have hQQ' := (g NLogN.KIL.sQQ (by decide)).trans hQQ
  -- the sizes
  set V := AModel.vol (P :: L' :: AModel.hdShape A B Cs m N)
  have hP1 := hpos P (by simp)
  have hL1 := hpos L' (by simp)
  have hA1 : 1 ≤ AModel.vol A := NLogN.KIL.vol_pos_of (fun x hx => hpos x (by simp [AModel.hdShape, hx]))
  have hB1 : 1 ≤ AModel.vol B := NLogN.KIL.vol_pos_of (fun x hx => hpos x (by simp [AModel.hdShape, hx]))
  have hC1 : 1 ≤ AModel.vol Cs := NLogN.KIL.vol_pos_of (fun x hx => hpos x (by simp [AModel.hdShape, hx]))
  have hVe : V = P * L' * (AModel.vol A * N ^ a * N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B *
      N ^ (m + m - 1 - b + 1) * AModel.vol Cs) := by
    simp only [V, AModel.hdShape, AModel.vol_cons, AModel.vol_append, AModel.vol_replicate]
    have e1 : m = a + (m - 1 - a + 1) := by omega
    have e2 : m = (b - m) + (m + m - 1 - b + 1) := by omega
    conv_lhs => rw [show N ^ m * (AModel.vol B * (N ^ m * AModel.vol Cs)) = N ^ m * AModel.vol B * N ^ m * AModel.vol Cs by ring]
    conv_lhs => rw [show (N ^ m : ℕ) = N ^ m from rfl]
    rw [show AModel.vol A * (N ^ m * AModel.vol B * N ^ m * AModel.vol Cs) =
      AModel.vol A * N ^ m * AModel.vol B * N ^ m * AModel.vol Cs by ring]
    nth_rewrite 1 [e1]
    nth_rewrite 2 [e2]
    rw [pow_add, pow_add, pow_add, pow_add]
    ring
  have hle : ∀ x : ℕ, x ≤ V → NLogN.zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (NLogN.KIL.zsz_nat_le hx) hV
  have hNp : ∀ e : ℕ, 1 ≤ N ^ e := fun e => Nat.one_le_pow _ _ hN
  -- bounds of the pushed values
  have lA : AModel.vol A * N ^ a ≤ V := by
    rw [hVe]
    calc AModel.vol A * N ^ a ≤ AModel.vol A * N ^ a * (N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B *
        N ^ (m + m - 1 - b + 1) * AModel.vol Cs) := Nat.le_mul_of_pos_right _ (by
          have := hNp (m - 1 - a + 1 + (b - m)); have := hNp (m + m - 1 - b + 1); positivity)
      _ ≤ _ := by
        rw [show AModel.vol A * N ^ a * N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B *
          N ^ (m + m - 1 - b + 1) * AModel.vol Cs = AModel.vol A * N ^ a * (N ^ (m - 1 - a + 1 + (b - m)) *
          AModel.vol B * N ^ (m + m - 1 - b + 1) * AModel.vol Cs) by ring]
        exact Nat.le_mul_of_pos_left _ (Nat.mul_pos hP1 hL1)
  have lB : N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) ≤ V := by
    rw [hVe, pow_add, pow_add, pow_one]
    have := hNp a; have := hNp (m + m - 1 - b + 1)
    have e : P * L' * (AModel.vol A * N ^ a * (N ^ (m - 1 - a) * N * N ^ (b - m)) * AModel.vol B *
        N ^ (m + m - 1 - b + 1) * AModel.vol Cs) = (N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m))) *
        (P * L' * AModel.vol A * N ^ a * N * N ^ (m + m - 1 - b + 1) * AModel.vol Cs) := by ring
    rw [e]; exact Nat.le_mul_of_pos_right _ (by positivity)
  have lC : N ^ (m + m - 1 - b) * AModel.vol Cs ≤ V := by
    rw [hVe, pow_succ N (m + m - 1 - b)]
    have := hNp a; have := hNp (m - 1 - a + 1 + (b - m))
    have e : P * L' * (AModel.vol A * N ^ a * N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B *
        (N ^ (m + m - 1 - b) * N) * AModel.vol Cs) = (N ^ (m + m - 1 - b) * AModel.vol Cs) *
        (P * L' * AModel.vol A * N ^ a * N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B * N) := by ring
    rw [e]; exact Nat.le_mul_of_pos_right _ (by positivity)
  have lL : L' ≤ V := by
    rw [hVe]
    rw [show P * L' * (AModel.vol A * N ^ a * N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B *
        N ^ (m + m - 1 - b + 1) * AModel.vol Cs) = L' * (P * AModel.vol A * N ^ a *
        N ^ (m - 1 - a + 1 + (b - m)) * AModel.vol B * N ^ (m + m - 1 - b + 1) * AModel.vol Cs) by ring]
    have := hNp a; have := hNp (m - 1 - a + 1 + (b - m)); have := hNp (m + m - 1 - b + 1)
    exact Nat.le_mul_of_pos_right _ (by positivity)
  -- the push list
  have pQ : NLogN.KIL.PosE t0 (.reg NLogN.KIL.sQQ) := NLogN.KIL.posE_reg hQQ' (by exact_mod_cast hN)
  have rdQ : NLogN.KIL.RdOK sQQ := Or.inl rfl
  have gJ := NLogN.KIL.goodE_reg (NLogN.KIL.rd_reg' (r := NLogN.KIL.rJ1) ⟨by decide, by decide⟩) hJ1' hk
  have gL := NLogN.KIL.goodE_reg (NLogN.KIL.rd_reg' (r := NLogN.KIL.rLp) ⟨by decide, by decide⟩) hLp' (hle _ lL)
  have eA : (NLogN.Ex.mul (.reg NLogN.KIL.rVA) (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) a) : NLogN.Ex NLogN.HS).eval t0 = ((AModel.vol A * N ^ a : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval, NLogN.KIL.powE_eval]; rw [NLogN.IState.top_eq hVA', NLogN.IState.top_eq hQQ']; push_cast; ring
  have eB : (NLogN.Ex.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m - 1 - a)) (.mul (.reg NLogN.KIL.rVB) (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (b - m))) :
      NLogN.Ex NLogN.HS).eval t0 = ((N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval, NLogN.KIL.powE_eval]; rw [NLogN.IState.top_eq hVB', NLogN.IState.top_eq hQQ']; push_cast; ring
  have eC : (NLogN.Ex.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m + m - 1 - b)) (.reg NLogN.KIL.rVC) : NLogN.Ex NLogN.HS).eval t0 =
      ((N ^ (m + m - 1 - b) * AModel.vol Cs : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval, NLogN.KIL.powE_eval]; rw [NLogN.IState.top_eq hVC', NLogN.IState.top_eq hQQ']; push_cast; ring
  have gA : NLogN.KIL.GoodE t0 Bb (.mul (.reg NLogN.KIL.rVA) (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) a)) :=
    NLogN.KIL.goodE_pos ⟨NLogN.KIL.posE_reg hVA' (by exact_mod_cast hA1), NLogN.KIL.powE_pos pQ a⟩
      (fun r hr => by
        simp only [NLogN.Ex.regs, List.mem_append] at hr
        rcases hr with h | h
        · simp at h; rw [h]; exact NLogN.KIL.rd_reg' ⟨by decide, by decide⟩
        · exact NLogN.KIL.powE_regs _ a (NLogN.KIL.rd_reg rdQ) r h) (le_of_eq eA) (hle _ lA)
  have gB : NLogN.KIL.GoodE t0 Bb (.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m - 1 - a)) (.mul (.reg NLogN.KIL.rVB) (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (b - m)))) :=
    NLogN.KIL.goodE_pos ⟨NLogN.KIL.powE_pos pQ _, NLogN.KIL.posE_reg hVB' (by exact_mod_cast hB1), NLogN.KIL.powE_pos pQ _⟩
      (fun r hr => by
        simp only [NLogN.Ex.regs, List.mem_append] at hr
        rcases hr with h | h | h
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h
        · simp at h; rw [h]; exact NLogN.KIL.rd_reg' ⟨by decide, by decide⟩
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h) (le_of_eq eB) (hle _ lB)
  have gC : NLogN.KIL.GoodE t0 Bb (.mul (NLogN.KIL.powE (.reg NLogN.KIL.sQQ) (m + m - 1 - b)) (.reg NLogN.KIL.rVC)) :=
    NLogN.KIL.goodE_pos ⟨NLogN.KIL.powE_pos pQ _, NLogN.KIL.posE_reg hVC' (by exact_mod_cast hC1)⟩
      (fun r hr => by
        simp only [NLogN.Ex.regs, List.mem_append] at hr
        rcases hr with h | h
        · exact NLogN.KIL.powE_regs _ _ (NLogN.KIL.rd_reg rdQ) r h
        · simp at h; rw [h]; exact NLogN.KIL.rd_reg' ⟨by decide, by decide⟩) (le_of_eq eC) (hle _ lC)
  have hgood : ∀ p ∈ NLogN.KIL.chL m a b, NLogN.KIL.GoodE t0 Bb p.2 := by
    intro p hp
    simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl <;> assumption
  have hPO : NLogN.KIL.PushOK t0 Bb (NLogN.KIL.chL m a b) := by
    intro p hp
    have gp := hgood p hp
    refine ⟨?_, NLogN.KIL.clean_of_rd gp.rd, ?_, gp.ok, gp.bnd⟩
    · simp only [NLogN.KIL.chL, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)
    · intro r hr hm
      have hr' := NLogN.KIL.regs_chL p hp r hr
      simp only [NLogN.KIL.chL, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
        or_false] at hm
      rcases hr' with h | h | h | h | h | h <;> subst h <;>
        rcases hm with h | h | h | h | h <;> exact absurd h (by decide)
  have S1 := NLogN.KIL.Sp.pushes Bb (NLogN.KIL.chL m a b) t0 hPO
  set t1 := NLogN.KIL.pushSt t0 ((NLogN.KIL.chL m a b).map fun p => (p.1, p.2.eval t0))
  -- the evaluated push list
  have eJ : (NLogN.Ex.reg NLogN.KIL.rJ1 : NLogN.Ex NLogN.HS).eval t0 = (k : ℤ) := NLogN.KIL.eval_reg' hJ1'
  have eL : (NLogN.Ex.reg NLogN.KIL.rLp : NLogN.Ex NLogN.HS).eval t0 = (L' : ℤ) := NLogN.KIL.eval_reg' hLp'
  have hev : (NLogN.KIL.chL m a b).map (fun p => (p.1, p.2.eval t0)) =
      [(NLogN.KIL.dJ, (k : ℤ)), (NLogN.KIL.dL, (L' : ℤ)), (NLogN.KIL.dA, ((AModel.vol A * N ^ a : ℕ) : ℤ)),
        (NLogN.KIL.dB, ((N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) : ℕ) : ℤ)),
        (NLogN.KIL.dC, ((N ^ (m + m - 1 - b) * AModel.vol Cs : ℕ) : ℤ))] := by
    simp only [NLogN.KIL.chL, List.map_cons, List.map_nil, eJ, eL, eA, eB, eC]
  -- the descriptor of the child
  have hD : NLogN.KIL.DescIn t1 q m k P L' (A ++ List.replicate a N)
      (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
      (List.replicate (m + m - 1 - b) N ++ Cs) := by
    simp only [t1, hev, NLogN.KIL.pushSt]
    refine ⟨⟨t0.G NLogN.KIL.dJ, by simp +decide [NLogN.IState.upd_G]⟩, ⟨L7, ?_⟩,
      ⟨t0.G NLogN.KIL.dL, by simp +decide [NLogN.IState.upd_G]⟩,
      ⟨t0.G NLogN.KIL.dA, ?_⟩, ⟨t0.G NLogN.KIL.dB, ?_⟩, ⟨t0.G NLogN.KIL.dC, ?_⟩, ⟨L8, ?_⟩⟩
    · simp +decide [NLogN.IState.upd_G, t0, hP]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, AModel.vol_append, AModel.vol_replicate]
    · simp +decide [NLogN.IState.upd_G, t0, hT]
  set evl : List (Fin NLogN.HS × ℤ) := [(NLogN.KIL.dJ, (k : ℤ)), (NLogN.KIL.dL, (L' : ℤ)), (NLogN.KIL.dA, ((AModel.vol A * N ^ a : ℕ) : ℤ)),
        (NLogN.KIL.dB, ((N ^ (m - 1 - a) * (AModel.vol B * N ^ (b - m)) : ℕ) : ℤ)),
        (NLogN.KIL.dC, ((N ^ (m + m - 1 - b) * AModel.vol Cs : ℕ) : ℤ))] with hevl
  have ht1 : t1 = NLogN.KIL.pushSt t0 evl := by simp only [t1, hev, evl]
  have h0n : (0 : Fin NLogN.HS) ∉ evl.map Prod.fst := by simp +decide [evl]
  have h0t1 : t1.G 0 = NLogN.ints (NLogN.KIL.enc2 ys) ++ R := by
    rw [ht1, NLogN.KIL.pushSt_G_of_not_mem _ _ _ h0n]; simp [t0]
  have h2 := hrec t1 R ys hD hys
  rw [show t1.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R) = t1 by rw [← h0t1, NLogN.IState.upd_self]] at h2
  have e2 : t1.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R) =
      NLogN.KIL.pushSt (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R)) evl := by
    rw [ht1, show t0 = t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R) from rfl, NLogN.KIL.pushSt_upd_comm _ _ _ _ h0n,
      NLogN.KIL.pushSt_upd_comm _ _ _ _ h0n, NLogN.IState.upd_upd_same]
  rw [e2] at h2
  have S3 := NLogN.KIL.Sp.popsR Bb evl (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (ch ys)) ++ R)) (by
    intro p hp
    simp only [evl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl
    · exact ⟨by dsimp only; decide, hk⟩
    · exact ⟨by dsimp only; decide, hle _ lL⟩
    · exact ⟨by dsimp only; decide, hle _ lA⟩
    · exact ⟨by dsimp only; decide, hle _ lB⟩
    · exact ⟨by dsimp only; decide, hle _ lC⟩)
  have hfst : evl.map Prod.fst = [NLogN.KIL.dJ, NLogN.KIL.dL, NLogN.KIL.dA, NLogN.KIL.dB, NLogN.KIL.dC] := rfl
  rw [hfst] at S3
  rw [ht1] at S1
  rw [← ht1] at S1
  have H := S1.toIRuns (I := I) (iprog := iprog) |>.seq ((NLogN.IRuns.call h2).seq S3.toIRuns)
  refine H.mono' rfl ?_
  simp only [NLogN.KIL.cSwC, hevl, List.length_cons, List.length_nil]
  omega
end
