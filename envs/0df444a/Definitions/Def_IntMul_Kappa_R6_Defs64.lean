abbrev BC : Fin HS := 25
abbrev CN : Fin HS := 24
abbrev TU : Fin HS := 44
/-- The four stage tables. -/
abbrev TDI : Fin HS := 40
abbrev TGI : Fin HS := 41
abbrev TGA : Fin HS := 42
