theorem ModularCurve.isIntegral_inclusion_adjoin_jqNModC
    (K : Type*) [Field K] (p : ℕ) [Fact p.Prime]
    (hle : IntermediateField.adjoin K ({ModularCurve.jqNModC K p} : Set (LaurentSeries K)) ≤
      ModularCurve.modularFunctionFieldC K p) :
    (IntermediateField.inclusion hle).toRingHom.IsIntegral := by sorry
