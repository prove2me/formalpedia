open Real Complex
open scoped ComplexConjugate
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN faradayKN domReg domReg_S isOpen_domReg)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable {M a Q : ℝ} {x : Pt 4}
theorem solution (hx : x ∈ domReg M a Q) :
    fdir (knE M a Q) 0 (omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q) 0 2 1) x
      = -(-(I * ((a * Real.sin (x 2) : ℝ) : ℂ)) * (((Real.sqrt 2 : ℝ) : ℂ) * (2 * qK a x)))
        / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x ^ 2) ^ 2 := by
  set F : ℝ → ℝ → ℂ := fun r θ => -(I * ((a * Real.sin θ : ℝ) : ℂ)) / (((Real.sqrt 2 : ℝ) : ℂ) * qrt a r θ ^ 2)
  have heq : Set.EqOn (omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q) 0 2 1) (fun y => F (y 1) (y 2))
      (domReg M a Q) := fun y hy => by simp only [F]; rw [(omL_KN_m hy).1, qK_qrt]
  rw [fdir_congr_of_eqOn (isOpen_domReg M a Q) hx heq, fdir_KN_rt (F := F) (fun _ => rfl), knE_0_1, knE_0_2,
    zero_mul, add_zero, one_mul, qK_qrt]
  refine cpdC_r (F := F) (fun _ => rfl) x ?_
  have hne : ((Real.sqrt 2 : ℝ) : ℂ) * qrt a (x 1) (x 2) ^ 2 ≠ 0 :=
    mul_ne_zero sqrt2C_ne_zero (pow_ne_zero 2 (qrt_ne_zero hx))
  exact ((hasDerivAt_const (x 1) _).div (((hd_q_r a (x 2) (x 1)).pow 2).const_mul _) hne).congr_deriv
    (by norm_num)
