variable (v : HeightOneSpectrum (𝓞 ℚ))

private abbrev instBorelAt : MeasurableSpace (v.adicCompletion ℚ) := localBorel ℚ v

attribute [local instance] instBorelAt

private theorem borelSpace_at : BorelSpace (v.adicCompletion ℚ) := borelSpace_localBorel ℚ v

attribute [local instance] borelSpace_at

private theorem continuous_modulus_adicCompletion : Continuous fun x : v.adicCompletion ℚ => modulus x := by
  have h : (fun x : v.adicCompletion ℚ => modulus x) = fun x => ‖x‖₊ :=
    funext fun x => modulus_adicCompletion_eq_nnnorm ℚ v x
  rw [h]
  exact continuous_nnnorm

private theorem scalar_ne_zero :
    ((Ideal.absNorm v.asIdeal : ℝ≥0) ^ (-(addCharLevel (NumberField.StandardAddChar.psiLocal ℚ v) : ℝ) / 2)) ≠ 0 := by
  apply (NNReal.rpow_pos _).ne'
  have hN : Ideal.absNorm v.asIdeal ≠ 0 := fun h => v.ne_bot (Ideal.absNorm_eq_zero_iff.mp h)
  exact_mod_cast Nat.pos_of_ne_zero hN

private theorem isAddHaarMeasure_selfDualHaarAt : (selfDualHaarAt ℚ v).IsAddHaarMeasure := by
  unfold selfDualHaarAt
  exact Measure.IsAddHaarMeasure.nnreal_smul _ (scalar_ne_zero v)

private theorem regular_selfDualHaarAt : (selfDualHaarAt ℚ v).Regular := by
