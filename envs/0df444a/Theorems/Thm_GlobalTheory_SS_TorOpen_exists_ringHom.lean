theorem GlobalTheory.SS.TorOpen.exists_ringHom (k : Type) [Field k] (q : Polynomial k) :
    ∃ ψ : AddMonoidAlgebra k (ULift.{0} ℤ) →+* Localization.Away (Polynomial.X * q),
      IsOpenImmersion (Spec.map (CommRingCat.ofHom ψ)) ∧
      ψ.comp (algebraMap k _) = algebraMap k _ ∧
      ψ (AddMonoidAlgebra.single (ULift.up 1) 1) = algebraMap (Polynomial k) _ Polynomial.X := by sorry
