section s200
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CorePending
open Structured
attribute [local instance] Classical.propDecidable
lemma address_injective {l : ℕ} (B : ℕ) (e f : Fin l) (a c : ℕ) (ha : a < 5) (hc : c < 5)
    (h : address B e a = address B f c) : e = f ∧ a = c := by
  have hv : e.val = f.val := by dsimp [address] at h; omega
  exact ⟨Fin.ext hv,by dsimp [address] at h;omega⟩
lemma prefix_eval (s : Data) : Eval prefixCode s 6 (prefixData s) := eval_sequence_atoms prefixAtoms s
lemma prefix_fields (s : Data) :
    (prefixData s).natReg 568 = s.natReg 552+5*s.natReg 560 ∧
    (prefixData s).natReg 570 = s.natMem (s.natReg 552+5*s.natReg 560) ∧
    (prefixData s).natReg 572 = s.natReg 552+5*s.natReg 560+s.natReg 14 ∧
    (∀ k, k ≠ 562 → k ≠ 564 → k ≠ 566 → k ≠ 568 → k ≠ 570 → k ≠ 572 →
      (prefixData s).natReg k = s.natReg k) := by
  simp [prefixData,prefixAtoms,Atom.effect,instructionEffect,data,Data.machine]
  refine ⟨by omega,?_,by omega,?_⟩
  · congr 1 <;> omega
  · intro k h1 h2 h3 h4 h5 h6
    simp [h1,h2,h3,h4,h5,h6]
lemma prefix_memory (s : Data) : (prefixData s).natMem = s.natMem ∧ (prefixData s).realMem = s.realMem := ⟨rfl,rfl⟩
lemma insert_eval (s : Data) (h1 : s.natReg 26 = 1) (h2 : s.natReg 14 = 2) :
    Eval insertCode s 3 (inserted s) := by
  have hh := Eval.seq (eval_storeN s 572 546) (Eval.seq (eval_storeN _ 568 26)
    (Eval.seq (eval_nadd _ 546 560 14) (Eval.skip _)))
  simpa only [insertCode,Structured.sequence,inserted,h1,h2] using hh
lemma enqueue {l : ℕ} (B : ℕ) (xs : List (Fin l)) (s : Data) (e : Fin l)
    (hv : View B xs s) (hb : s.natReg 552 = B+1) (he : s.natReg 560 = 2*e.val)
    (h1 : s.natReg 26 = 1) (h2 : s.natReg 14 = 2) :
    ∃ cost t ys, Eval code s cost t ∧ cost ≤ 10 ∧
      ys = (if e ∈ xs then xs else e::xs) ∧ View B ys t ∧
      ys.length ≤ l ∧ t.realMem = s.realMem ∧
      (∀ a, a ≠ address B e 0 → a ≠ address B e 1 → t.natMem a = s.natMem a) := by
  let a := prefixData s
  obtain ⟨ha0,ham,ha1,hreg⟩ := prefix_fields s
  have hr (k : ℕ) (hk : k ≠ 562 ∧ k ≠ 564 ∧ k ≠ 566 ∧ k ≠ 568 ∧ k ≠ 570 ∧ k ≠ 572) :
      a.natReg k = s.natReg k := hreg k hk.1 hk.2.1 hk.2.2.1 hk.2.2.2.1 hk.2.2.2.2.1 hk.2.2.2.2.2
  have ha26 : a.natReg 26 = 1 := (hr 26 (by omega)).trans h1
  have ha14 : a.natReg 14 = 2 := (hr 14 (by omega)).trans h2
  have ha560 : a.natReg 560 = 2*e.val := (hr 560 (by omega)).trans he
  have ha546 : a.natReg 546 = token xs := (hr 546 (by omega)).trans hv.head
  have ha568 : a.natReg 568 = address B e 0 := by dsimp [address];rw [ha0,hb,he];omega
  have ha572 : a.natReg 572 = address B e 1 := by dsimp [address];rw [ha1,hb,he,h2];omega
  have haf : a.natReg 570 = if e ∈ xs then 1 else 0 := by
    rw [ham,hb,he]
    convert hv.flags e using 1 <;> congr 1 <;> dsimp [address] <;> omega
  have hmem : a.natMem = s.natMem := (prefix_memory s).1
  by_cases hx : e ∈ xs
  · have ht : ¬ (Test.natLess 570 26).holds a := by simp [Test.holds,haf,ha26,hx]
    have hv' : View B xs a := ⟨hv.nodup,by simpa only [hmem] using hv.flags,ha546,by simpa only [hmem] using hv.links⟩
    exact ⟨8,a,xs,Eval.seq (prefix_eval s) (Eval.branchNo ht (.skip a)),by omega,
      by simp [hx],hv',by simpa using hv.nodup.length_le_card,(prefix_memory s).2,fun _ _ _ => congrFun hmem _⟩
  · have ht : (Test.natLess 570 26).holds a := by simp [Test.holds,haf,ha26,hx]
    have hm (j : ℕ) : (inserted a).natMem j =
        Function.update (Function.update s.natMem (address B e 1) (token xs)) (address B e 0) 1 j := by
      simp only [inserted,ha568,ha572,ha546,hmem]
    have hnd : (e::xs).Nodup := List.nodup_cons.mpr ⟨hx,hv.nodup⟩
    have hv' : View B (e::xs) (inserted a) := by
      refine ⟨hnd,?_,?_,?_⟩
      · intro f
        have h01 : address B f 0 ≠ address B e 1 := by intro hh;have hh' := address_injective B f e 0 1 (by omega) (by omega) hh;omega
        rw [hm]
        by_cases hf : f = e
        · subst f;simp
        · have h00 : address B f 0 ≠ address B e 0 := fun hh => hf (address_injective B f e 0 0 (by omega) (by omega) hh).1
          rw [Function.update_of_ne h00,Function.update_of_ne h01,hv.flags f]
          simp [hf]
      · simp only [inserted,Function.update_self,ha560,token]
      · change (inserted a).natMem (address B e 1) = token xs ∧ Links B xs (inserted a).natMem
        constructor
        · rw [hm,Function.update_of_ne (show address B e 1 ≠ address B e 0 by dsimp [address];omega),Function.update_self]
        · apply hv.links.congr
          intro f hf
          have hfe : f ≠ e := by intro hh;subst f;exact hx hf
          have h10 : address B f 1 ≠ address B e 0 := by intro hh;have hh' := address_injective B f e 1 0 (by omega) (by omega) hh;omega
          have h11 : address B f 1 ≠ address B e 1 := fun hh => hfe (address_injective B f e 1 1 (by omega) (by omega) hh).1
          rw [hm,Function.update_of_ne h10,Function.update_of_ne h11]
    refine ⟨10,inserted a,e::xs,Eval.seq (prefix_eval s) (Eval.branchYes ht (insert_eval a ha26 ha14)),le_rfl,
      by simp [hx],hv',by simpa using hnd.length_le_card,(prefix_memory s).2,?_⟩
    intro j h0 h1
    rw [hm,Function.update_of_ne h0,Function.update_of_ne h1]
end DecrAlmostLinearSSSP.Decremental.CorePending
end s200
