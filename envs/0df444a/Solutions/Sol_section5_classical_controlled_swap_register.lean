theorem solution (w : ℕ) :
    ∃ c : Circuit gatesRev (1+w+w), c.size ≤ 7*w ∧
      ∀ z : Qubits (1+w+w), act c.unitary (ket z)=ket (cswapRegFn w z) := by
  obtain ⟨c,hc,hcu⟩ := section5_rev_controlled_swap_register w
  refine ⟨c,hc.trans (Aux_w54_arith.cswapRegCircuit_size w).le,?_⟩
  intro z
  rw [hcu]
  have hh := act_ket_of_implementsOnClean_perm (Aux_w54_arith.cswapRegCircuit_implements w) z
  have hpad (x : Qubits (1+w+w)) : padZero (1+w+w) 0 x=x := by
    funext i
    simp
  simpa only [hpad] using hh
