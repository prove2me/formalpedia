variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ}

/-- Entries of the actual `esFaraday` on the domain (VI table `bind_F`). -/
theorem esFaraday_apply (hE : ESData R B D A H W Φ Ψ) {x : Pt 5} (hx : x ∈ esDomain R)
    (i j : Fin 5) :
    esFaraday Φ Ψ i j x =
      (!![0, -1 * deriv Φ (x 1), 0, 0, 0;
         1 * deriv Φ (x 1), 0, 0, 1 * deriv Ψ (x 1) * x 2,
           -1 * deriv Ψ (x 1) * x 2 + 1 * deriv Ψ (x 1);
         0, 0, 0, 1 * Ψ (x 1), -1 * Ψ (x 1);
         0, -1 * deriv Ψ (x 1) * x 2, -1 * Ψ (x 1), 0, 0;
         0, 1 * deriv Ψ (x 1) * x 2 + -1 * deriv Ψ (x 1), 1 * Ψ (x 1), 0, 0] :
