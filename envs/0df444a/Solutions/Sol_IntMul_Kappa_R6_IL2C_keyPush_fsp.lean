theorem gcv (k S Q : ℕ) : ((k : ℤ) / (S : ℤ)) % (Q : ℤ) = ((gc Q S k : ℕ) : ℤ) := by
  unfold gc; push_cast; rfl

section Ex

variable {t : IState HS} {Bb : ℕ}

theorem eGc {rk rS rQ : Fin HS} {S Q k : ℕ} {Lk LS LQ : List Item}
    (hk : t.G rk = .int (k : ℤ) :: Lk) (hS : t.G rS = .int (S : ℤ) :: LS)
    (hQ : t.G rQ = .int (Q : ℤ) :: LQ) (hS0 : 0 < S) (hQ0 : 0 < Q)
    (hrk : rk.val < 56) (hrS : rS.val < 56) (hrQ : rQ.val < 56)
    (zk : zsz (k : ℤ) ≤ Bb) (zS : zsz (S : ℤ) ≤ Bb) (zQ : zsz (Q : ℤ) ≤ Bb) :
    ESp (gcK rk rS rQ) t Bb ((gc Q S k : ℕ) : ℤ) := by
  rw [← gcv]
  have E1 := ESp.ndiv (ESp.ofG' hk hrk zk) (ESp.ofG' hS hrS zS) (by positivity)
    (by exact_mod_cast hS0) (by
      have : ((k : ℤ) / (S : ℤ)) = ((k / S : ℕ) : ℤ) := by push_cast; rfl
      rw [this]; exact le_trans (KIL.zsz_nat_le (Nat.div_le_self _ _)) zk)
  exact ESp.nmod E1 (ESp.ofG' hQ hrQ zQ) (by positivity) (by exact_mod_cast hQ0) (by
    rw [gcv]; exact le_trans (KIL.zsz_nat_le (le_of_lt (gc_lt hQ0 _))) zQ)

end Ex

