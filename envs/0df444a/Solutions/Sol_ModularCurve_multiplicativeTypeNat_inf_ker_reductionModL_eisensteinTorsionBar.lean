theorem two_not_dvd (p : ℕ) [hp : Fact p.Prime] (h2n : 2 ∣ eisensteinNumerator p) : ¬ 2 ∣ p := by
  intro h2p
  have h1 : 2 ∣ p - 1 := h2n.trans (eisensteinNumerator_dvd p)
  have hp1 : 1 < p := hp.out.one_lt
  obtain ⟨a, ha⟩ := h2p
  obtain ⟨b, hb⟩ := h1
  omega

theorem multiplicativeTypeNat_mono {G : Type*} [Group G] {J : Type*} [AddCommGroup J]
    [DistribMulAction G J] {I : Subgroup G} {n : G → ℕ} {W W' : AddSubgroup J} (h : W' ≤ W)
    (hW : MultiplicativeTypeNat I n W) : MultiplicativeTypeNat I n W' :=
  fun σ hσ x hx => hW σ hσ x (h hx)

theorem torsionBy_nsmul_eq_zero (p q m : ℕ)
    (y : ↥(Submodule.torsionBy ℤ (JZero p) ((q : ℤ) ^ m)).toAddSubgroup) : q ^ m • y = 0 := by
  apply Subtype.ext
  have hy := (Submodule.mem_torsionBy_iff _ _).mp y.2
  show (((q ^ m • y :
      ↥(Submodule.torsionBy ℤ (JZero p) ((q : ℤ) ^ m)).toAddSubgroup)) : JZero p) = 0
  rw [AddSubgroupClass.coe_nsmul, ← natCast_zsmul, Nat.cast_pow]
  exact hy

variable (p : ℕ) [Fact p.Prime]

theorem eisensteinTorsionBar_le_torsionBy (q m : ℕ) {x : JZero p}
    (hx : x ∈ eisensteinTorsionBar p q m) :
    x ∈ Submodule.torsionBy ℤ (JZero p) ((q : ℤ) ^ m) := by
  letI := heckeModuleBar p
  have hq : ((q : HeckeAlg) ^ m) ∈ (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg) :=
    Ideal.pow_mem_pow (natCast_mem_eisensteinMaximalIdeal p q) m
  have h0 : ((q : HeckeAlg) ^ m) • x = 0 := (Submodule.mem_torsionBySet_iff _ _).mp hx ⟨_, hq⟩
  have h1 : ((q : HeckeAlg) ^ m) • x = ((q : ℤ) ^ m) • x := by
    rw [show ((q : HeckeAlg) ^ m) = MvPolynomial.C ((q : ℤ) ^ m) by simp, heckeModuleBar_C_smul]
  rw [Submodule.mem_torsionBy_iff, ← h1, h0]

theorem dock (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) (m : ℕ)
    (H : Type) [CommRing H] [HopfAlgebra (GaloisRep.ratLocalizedAt 2) H]
    [Module.Finite (GaloisRep.ratLocalizedAt 2) H] [Module.Flat (GaloisRep.ratLocalizedAt 2) H]
    [Coalgebra.IsCocomm (GaloisRep.ratLocalizedAt 2) H]
    (e : WithConv (H →ₐ[GaloisRep.ratLocalizedAt 2] AlgebraicClosure ℚ) ≃
      ↥(Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)))
    (he_add : ∀ f g, e (f * g) = e f + e g)
    (he_act : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
      (f g : WithConv (H →ₐ[GaloisRep.ratLocalizedAt 2] AlgebraicClosure ℚ)),
      (∀ h : H, g h = σ (f h)) → ((e g : JZero p)) = σ • (e f : JZero p))
    (hker : ∀ f : WithConv (H →ₐ[GaloisRep.ratLocalizedAt 2] AlgebraicClosure ℚ),
      reductionModL B p (e f : JZero p) = 0 →
      ∀ h : H, B.valuation (f h - algebraMap (GaloisRep.ratLocalizedAt 2) (AlgebraicClosure ℚ)
        (Coalgebra.counit h)) < 1) :
    ∃ K : AddSubgroup (JZero p),
      K ≤ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ∧
      (∀ f : WithConv (H →ₐ[GaloisRep.ratLocalizedAt 2] AlgebraicClosure ℚ),
        ((e f : ↥(Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup) : JZero p) ∈ K ↔
          ∀ h : H, B.valuation (f h
            - algebraMap (GaloisRep.ratLocalizedAt 2) (AlgebraicClosure ℚ) (Coalgebra.counit h)) < 1) ∧
      (∀ σ ∈ B.inertiaSubgroupIn ℚ,
        ∀ x ∈ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup, σ • x - x ∈ K) ∧
      eisensteinTorsionBar p 2 m ⊓ (reductionModL B p).ker ≤ K ⊓ eisensteinTorsionBar p 2 m := by
  let M : AddSubgroup (JZero p) := (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup
  have he_act' : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) f g,
      (∀ h : H, g h = σ (f h)) → ((e g : ↥M) : JZero p) = σ • ((e f : ↥M) : JZero p) := he_act
  obtain ⟨K, hKM, hK, hdisp, -⟩ :=
    GaloisRep.exists_addSubgroup_natCard_quotient_eq_natCard_ringHom_algClosure_of_finiteFlatHopf
      2 H M e he_add he_act' B hB
  refine ⟨K, hKM, hK, hdisp, ?_⟩
  rintro x ⟨hxBar, hxker⟩
  refine ⟨?_, hxBar⟩
  have hxM : x ∈ M := eisensteinTorsionBar_le_torsionBy p 2 m hxBar
  have hx0 : reductionModL B p x = 0 := hxker
  have hval := hker (e.symm ⟨x, hxM⟩) (by rw [Equiv.apply_symm_apply]; exact hx0)
  have hmem := (hK (e.symm ⟨x, hxM⟩)).mpr hval
  rw [Equiv.apply_symm_apply] at hmem
  exact hmem

end KDMUDN3

