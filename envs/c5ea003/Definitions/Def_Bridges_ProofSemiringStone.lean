/-! ## Finite Presentation (Prime Separation) -/

/-- A commutative semiring has **finite presentation** if any two distinct elements
can be separated by a prime congruence. This is the algebraic-logical completeness
principle: proof values are determined by truth evaluations at primes. -/
class FinitePresentation (P : Type u) [CommSemiring P] : Prop where
  prime_separation : ∀ {x y : P}, x ≠ y → ∃ p : PrimeConSpec P, ¬ p.con x y





/-! ## Spectral Completeness and Surjectivity -/

/-- A commutative semiring is **spectrally complete** if:
1. Elements identified at all primes are equal (radical reconstruction).
2. Every locally representable section is globally representable. -/
class SpectrallyComplete (P : Type u) [CommSemiring P] : Prop where
  radical_reconstruct : ∀ {x y : P}, (∀ p : PrimeConSpec P, p.con x y) → x = y
  section_reconstruction : ∀ f : StalkProduct P, IsLocallyRepresentable f →
    ∃ a : P, ∀ p : PrimeConSpec P, f p = p.con.toQuotient a

/-- Spectral completeness implies finite presentation. -/
noncomputable instance [SpectrallyComplete P] : FinitePresentation P where
  prime_separation := by
    intro x y hne; by_contra h; push_neg at h
    exact hne (SpectrallyComplete.radical_reconstruct (fun p => h p))


