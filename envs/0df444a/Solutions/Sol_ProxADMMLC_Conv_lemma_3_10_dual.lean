set_option linter.unusedVariables false

namespace D310Aux

open ProxADMMLC.Conv E312Aux C37Aux Filter Topology

/-- sign pattern of a multiplier vector `m` at a box point `a` -/
def SignAt {n : ℕ} (ℓ u : Fin n → ℝ) (a m : E n) : Prop :=
  ∀ i, (0 < m i → a i = ℓ i) ∧ (m i < 0 → a i = u i)

theorem inner_eq_sum {n : ℕ} (x y : E n) : inner ℝ x y = ∑ i, x i * y i := by
  rw [PiLp.inner_apply]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp [mul_comm]

theorem sign_inner {n : ℕ} {ℓ u : Fin n → ℝ} {a m : E n} (hm : SignAt ℓ u a m)
    {c : E n} (hc : c ∈ box ℓ u) : 0 ≤ inner ℝ m (c - a) := by
  rw [inner_eq_sum]
  refine Finset.sum_nonneg (fun i _ => ?_)
  simp only [PiLp.sub_apply]
  rcases lt_trichotomy (m i) 0 with h | h | h
  · rw [(hm i).2 h]
    exact mul_nonneg_of_nonpos_of_nonpos h.le (by linarith [(hc i).2])
  · rw [h, zero_mul]
  · rw [(hm i).1 h]
    exact mul_nonneg h.le (by linarith [(hc i).1])

theorem cross {n : ℕ} {ℓ u : Fin n → ℝ} {a a' m m' : E n}
    (ha : a ∈ box ℓ u) (ha' : a' ∈ box ℓ u) (hm : SignAt ℓ u a m) (hm' : SignAt ℓ u a' m') :
    inner ℝ (m - m') (a - a') ≤ 0 := by
  have h1 := sign_inner hm ha'
  have h2 := sign_inner hm' ha
  have e : a - a' = -(a' - a) := by abel
  have h3 : inner ℝ m (a - a') = -inner ℝ m (a' - a) := by rw [e, inner_neg_right]
  rw [inner_sub_left, h3]
  linarith

theorem box_upd {n : ℕ} {ℓ u : Fin n → ℝ} {x : E n} (hx : x ∈ box ℓ u) (i : Fin n) {v : ℝ}
    (hv : ℓ i ≤ v ∧ v ≤ u i) : x + (v - x i) • EuclideanSpace.single i (1:ℝ) ∈ box ℓ u := by
  intro j
  by_cases hj : j = i
  · subst hj
    simp only [PiLp.add_apply, PiLp.smul_apply, EuclideanSpace.single_apply, if_true,
      smul_eq_mul, mul_one]
    constructor <;> linarith [hv.1, hv.2]
  · simp only [PiLp.add_apply, PiLp.smul_apply, EuclideanSpace.single_apply, hj, if_false,
      smul_eq_mul, mul_zero, add_zero]
    exact hx j

theorem sign_of_vi {n : ℕ} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {x m : E n}
    (hx : x ∈ box ℓ u) (hvi : ∀ x' ∈ box ℓ u, 0 ≤ inner ℝ m (x' - x)) : SignAt ℓ u x m := by
  have key : ∀ i, ∀ v, ℓ i ≤ v ∧ v ≤ u i → 0 ≤ (v - x i) * m i := by
    intro i v hv
    have h := hvi _ (box_upd hx i hv)
    rw [add_sub_cancel_left, real_inner_smul_right, EuclideanSpace.inner_single_right] at h
    simpa using h
  intro i
  constructor
  · intro hm
    by_contra hne
    have h1 := key i (ℓ i) ⟨le_rfl, (hℓu i).le⟩
    have h2 : ℓ i < x i := lt_of_le_of_ne (hx i).1 (Ne.symm hne)
    have := mul_neg_of_neg_of_pos (sub_neg.mpr h2) hm
    linarith
  · intro hm
    by_contra hne
    have h1 := key i (u i) ⟨(hℓu i).le, le_rfl⟩
    have h2 : x i < u i := lt_of_le_of_ne (hx i).2 hne
    have := mul_neg_of_pos_of_neg (sub_pos.mpr h2) hm
    linarith

theorem sign_xs {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z : E n) :
    SignAt ℓ u (xs y z) (gradK f A b Γ p (xs y z) z y) :=
  sign_of_vi hℓu (hxs y z).1 (fun x' hx' => vi_gradK hdiff hxs y z x' hx')

theorem sign_of_ystar {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {ℓ u : Fin n → ℝ} {p : ℝ}
    {xst : E n → E n} {z : E n} {w : E m} (hw : w ∈ Ystar f A ℓ u p xst z) :
    SignAt ℓ u (xst z)
      (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w) := by
  obtain ⟨μ, ν, heq, hnn, hμ, hν⟩ := hw
  have hm : gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w = μ - ν := by
    rw [← sub_eq_zero, ← heq]; abel
  intro i
  rw [hm, PiLp.sub_apply]
  constructor
  · intro h
    have hpos : μ i ≠ 0 := by intro h0; linarith [(hnn i).2]
    rcases mul_eq_zero.mp (hμ i) with h1 | h1
    · exact absurd h1 hpos
    · linarith
  · intro h
    have hpos : ν i ≠ 0 := by intro h0; linarith [(hnn i).1]
    rcases mul_eq_zero.mp (hν i) with h1 | h1
    · exact absurd h1 hpos
    · linarith

theorem ystar_of_sign {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {ℓ u : Fin n → ℝ} {p : ℝ}
    {xst : E n → E n} {z : E n} {w : E m}
    (hs : SignAt ℓ u (xst z)
      (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w)) :
    w ∈ Ystar f A ℓ u p xst z := by
  set M := gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w with hM
  refine ⟨WithLp.toLp 2 (fun i => max (M i) 0), WithLp.toLp 2 (fun i => max (-M i) 0), ?_, ?_, ?_, ?_⟩
  · rw [← hM]
    ext i
    simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.toLp_apply, PiLp.zero_apply]
    rw [sub_add_eq_add_sub, sub_eq_zero]
    have := max_zero_sub_max_neg_zero_eq_self (M i)
    linarith
  · intro i
    simp only [PiLp.toLp_apply]
    exact ⟨le_max_right _ _, le_max_right _ _⟩
  · intro i
    simp only [PiLp.toLp_apply]
    rcases lt_or_ge 0 (M i) with h | h
    · rw [(hs i).1 h, sub_self, mul_zero]
    · rw [max_eq_right h, zero_mul]
  · intro i
    simp only [PiLp.toLp_apply]
    rcases lt_or_ge (M i) 0 with h | h
    · rw [(hs i).2 h, sub_self, mul_zero]
    · rw [max_eq_right (by linarith), zero_mul]

theorem sign_of_kkt {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    {x : E n} {y : E m} {μ ν : E n} (h : IsKKT f A b ℓ u x y μ ν) :
    SignAt ℓ u x (gradient f x + (ContinuousLinearMap.adjoint A) y) := by
  obtain ⟨heq, -, -, hμ, hν, hcμ, hcν⟩ := h
  have hm : gradient f x + (ContinuousLinearMap.adjoint A) y = μ - ν := by
    rw [← sub_eq_zero, ← heq]; abel
  intro i
  rw [hm, PiLp.sub_apply]
  constructor
  · intro h
    have hpos : μ i ≠ 0 := by intro h0; linarith [hν i]
    rcases mul_eq_zero.mp (hcμ i) with h1 | h1
    · exact absurd h1 hpos
    · linarith
  · intro h
    have hpos : ν i ≠ 0 := by intro h0; linarith [hμ i]
    rcases mul_eq_zero.mp (hcν i) with h1 | h1
    · exact absurd h1 hpos
    · linarith

theorem kkt_of_sign {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    {x : E n} {y : E m} (hx : x ∈ box ℓ u) (hAx : A x = b)
    (hs : SignAt ℓ u x (gradient f x + (ContinuousLinearMap.adjoint A) y)) :
    IsKKT f A b ℓ u x y
      (WithLp.toLp 2 (fun i => max ((gradient f x + (ContinuousLinearMap.adjoint A) y) i) 0))
      (WithLp.toLp 2 (fun i => max (-(gradient f x + (ContinuousLinearMap.adjoint A) y) i) 0)) := by
  set M := gradient f x + (ContinuousLinearMap.adjoint A) y with hM
  refine ⟨?_, hAx, hx, ?_, ?_, ?_, ?_⟩
  · rw [← hM]
    ext i
    simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.toLp_apply, PiLp.zero_apply]
    rw [sub_add_eq_add_sub, sub_eq_zero]
    have := max_zero_sub_max_neg_zero_eq_self (M i)
    linarith
  · intro i; simp only [PiLp.toLp_apply]; exact le_max_right _ _
  · intro i; simp only [PiLp.toLp_apply]; exact le_max_right _ _
  · intro i
    simp only [PiLp.toLp_apply]
    rcases lt_or_ge 0 (M i) with h | h
    · rw [(hs i).1 h, sub_self, mul_zero]
    · rw [max_eq_right h, zero_mul]
  · intro i
    simp only [PiLp.toLp_apply]
    rcases lt_or_ge (M i) 0 with h | h
    · rw [(hs i).2 h, sub_self, mul_zero]
    · rw [max_eq_right (by linarith), zero_mul]

/-- strict complementarity at a limit KKT point built from a sign pattern -/
theorem sc_strict {n m : ℕ} {f : E n → ℝ} {A : E n →L[ℝ] E m} {b : E m} {ℓ u : Fin n → ℝ}
    (hsc : StrictCompl f A b ℓ u) {x : E n} {y : E m} (hx : x ∈ box ℓ u) (hAx : A x = b)
    (hs : SignAt ℓ u x (gradient f x + (ContinuousLinearMap.adjoint A) y)) (i : Fin n) :
    (x i = ℓ i → 0 < (gradient f x + (ContinuousLinearMap.adjoint A) y) i) ∧
    (x i = u i → (gradient f x + (ContinuousLinearMap.adjoint A) y) i < 0) := by
  have h := hsc _ _ _ _ (kkt_of_sign hx hAx hs) i
  simp only [PiLp.toLp_apply] at h
  obtain ⟨h1, h2⟩ := h
  constructor
  · intro hxi
    rcases h1 with ⟨-, hn⟩ | ⟨-, hn⟩
    · exact absurd (by rw [hxi, sub_self]) hn
    · by_contra hle
      exact hn (max_eq_right (not_lt.mp hle))
  · intro hxi
    rcases h2 with ⟨-, hn⟩ | ⟨-, hn⟩
    · exact absurd (by rw [hxi, sub_self]) hn
    · by_contra hle
      exact hn (max_eq_right (by linarith [not_lt.mp hle]))

theorem f3 {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) (y : E m) (z : E n) {w : E m}
    (hw : w ∈ Ystar f A ℓ u p xst z) :
    (p + γ) * ‖xs y z - xst z‖ ^ 2 + Γ * ‖A (xs y z) - b‖ ^ 2
      ≤ -inner ℝ (y - w) (A (xs y z) - b) := by
  have hs1 := sign_xs hdiff hℓu hxs y z
  have hs2 := sign_of_ystar hw
  have hc := cross (hxs y z).1 (hxst z).1.1 hs1 hs2
  have hAx : A (xst z) = b := (hxst z).1.2
  have hmono := hγ _ (hxs y z).1 _ (hxst z).1.1
  have hexp : gradK f A b Γ p (xs y z) z y
      - (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w)
      = (gradient f (xs y z) - gradient f (xst z)) + (ContinuousLinearMap.adjoint A) (y - w)
        + Γ • (ContinuousLinearMap.adjoint A) (A (xs y z) - b) + p • (xs y z - xst z) := by
    unfold gradK
    simp only [map_sub]
    module
  have hA : A (xs y z - xst z) = A (xs y z) - b := by rw [map_sub, hAx]
  rw [hexp] at hc
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left,
    hA, real_inner_self_eq_norm_sq] at hc
  linarith

theorem xs_of_ystar {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ)
    (hΓ : 0 ≤ Γ) (hpγ : -γ < p)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) (z : E n) {w : E m}
    (hw : w ∈ Ystar f A ℓ u p xst z) : A (xs w z) = b := by
  have h := f3 hdiff hℓu hγ hxs hxst w z hw
  rw [sub_self, inner_zero_left, neg_zero] at h
  have h1 : 0 ≤ (p + γ) * ‖xs w z - xst z‖ ^ 2 := mul_nonneg (by linarith) (sq_nonneg _)
  have h2 : 0 ≤ ‖xs w z - xst z‖ ^ 2 := sq_nonneg _
  have h3 : ‖xs w z - xst z‖ ^ 2 = 0 := by
    by_contra hne
    have : 0 < (p + γ) * ‖xs w z - xst z‖ ^ 2 :=
      mul_pos (by linarith) (lt_of_le_of_ne h2 (Ne.symm hne))
    nlinarith [mul_nonneg hΓ (sq_nonneg ‖A (xs w z) - b‖)]
  have : xs w z = xst z := by
    rw [← sub_eq_zero, ← norm_eq_zero]; exact pow_eq_zero_iff (by norm_num) |>.mp h3
  rw [this]; exact (hxst z).1.2

theorem ystar_range {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {p : ℝ} {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst)
    (z : E n) : ∃ w ∈ Ystar f A ℓ u p xst z, w ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) := by
  obtain ⟨w, hw⟩ := ystar_nonempty f A b ℓ u hdiff p xst hxst z
  obtain ⟨w1, hw1, w2, hw2, rfl⟩ :=
    (LinearMap.range (A : E n →ₗ[ℝ] E m)).exists_add_mem_mem_orthogonal w
  have hk : (ContinuousLinearMap.adjoint A) w2 = 0 := by
    have h0 : inner ℝ ((ContinuousLinearMap.adjoint A) w2) ((ContinuousLinearMap.adjoint A) w2)
        = 0 := by
      rw [ContinuousLinearMap.adjoint_inner_left]
      rw [real_inner_comm]
      exact (Submodule.mem_orthogonal _ _).mp hw2 _ (LinearMap.mem_range_self _ _)
    exact inner_self_eq_zero.mp h0
  refine ⟨w1, ?_, hw1⟩
  obtain ⟨μ, ν, h1, h2⟩ := hw
  refine ⟨μ, ν, ?_, h2⟩
  rw [map_add, hk, add_zero] at h1
  exact h1

/-- `xst z` stays close to any stationary point `ζ`. -/
theorem xst_near {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {γ p : ℝ} (hγ : MonoConst f ℓ u γ) (hp : 0 ≤ p)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) (z : E n) {ζ : E n}
    (hζ : ζ ∈ Xstar f A b ℓ u) : (p + γ) * ‖xst z - ζ‖ ≤ p * ‖z - ζ‖ := by
  obtain ⟨y, μ, ν, hk⟩ := hζ
  obtain ⟨w, hw⟩ := ystar_nonempty f A b ℓ u hdiff p xst hxst z
  have hs1 := sign_of_ystar hw
  have hs2 := sign_of_kkt hk
  have hζb : ζ ∈ box ℓ u := hk.2.2.1
  have hAζ : A ζ = b := hk.2.1
  have hc := cross (hxst z).1.1 hζb hs1 hs2
  have hAx : A (xst z) = b := (hxst z).1.2
  have hmono := hγ _ (hxst z).1.1 _ hζb
  have hexp : (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w)
      - (gradient f ζ + (ContinuousLinearMap.adjoint A) y)
      = (gradient f (xst z) - gradient f ζ) + (ContinuousLinearMap.adjoint A) (w - y)
        + p • (xst z - ζ) + p • (ζ - z) := by
    simp only [map_sub]
    module
  have hA : A (xst z - ζ) = 0 := by rw [map_sub, hAx, hAζ, sub_self]
  rw [hexp] at hc
  simp only [inner_add_left, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left,
    hA, inner_zero_right, real_inner_self_eq_norm_sq] at hc
  have hcs : -(‖ζ - z‖ * ‖xst z - ζ‖) ≤ inner ℝ (ζ - z) (xst z - ζ) := by
    have := abs_real_inner_le_norm (ζ - z) (xst z - ζ)
    have := neg_abs_le (inner ℝ (ζ - z) (xst z - ζ))
    linarith
  have hzz : ‖ζ - z‖ = ‖z - ζ‖ := norm_sub_rev _ _
  rw [hzz] at hcs
  have hd0 := norm_nonneg (xst z - ζ)
  have key : ((p + γ) * ‖xst z - ζ‖) * ‖xst z - ζ‖ ≤ (p * ‖z - ζ‖) * ‖xst z - ζ‖ := by
    have := mul_le_mul_of_nonneg_left hcs hp
    nlinarith
  rcases eq_or_lt_of_le hd0 with h0 | h0
  · rw [← h0, mul_zero]; exact mul_nonneg hp (norm_nonneg _)
  · exact le_of_mul_le_mul_right key h0

theorem xstar_nonempty {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (ha : Assump22a A b ℓ u) {p : ℝ} (hp : 0 < p)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst) : (Xstar f A b ℓ u).Nonempty := by
  have hfeas : (feas A b ℓ u).Nonempty := by
    obtain ⟨x, hx, hx0⟩ := intrinsicInterior_subset ha
    exact ⟨x, hx, sub_eq_zero.mp hx0⟩
  have hcpt : IsCompact (feas A b ℓ u) :=
    (L34Aux.box_compact ℓ u).inter_right (isClosed_eq A.continuous continuous_const)
  obtain ⟨z0, hz0, hmin⟩ := hcpt.exists_isMinOn hfeas hdiff.continuous.continuousOn
  have hfix : xst z0 = z0 := by
    obtain ⟨hmem, hle⟩ := hxst z0
    have h1 := hle z0 hz0
    have h2 := (isMinOn_iff.mp hmin) _ hmem
    rw [sub_self, norm_zero] at h1
    have h3 : ‖xst z0 - z0‖ ^ 2 = 0 := by
      have := sq_nonneg ‖xst z0 - z0‖
      nlinarith
    rw [← sub_eq_zero, ← norm_eq_zero]
    exact (pow_eq_zero_iff (by norm_num)).mp h3
  obtain ⟨w, μ, ν, heq, hnn, hμ, hν⟩ := ystar_nonempty f A b ℓ u hdiff p xst hxst z0
  rw [hfix] at heq hμ hν
  rw [sub_self, smul_zero, add_zero] at heq
  refine ⟨z0, w, μ, ν, heq, hz0.2, hz0.1, fun i => (hnn i).1, fun i => (hnn i).2, fun i => ?_,
    fun i => hν i⟩
  have := hμ i
  rw [show ℓ i - z0 i = -(z0 i - ℓ i) by ring, mul_neg, this, neg_zero]

theorem norm_le_of_coord {n : ℕ} (a c : E n) (h : ∀ i, |a i| ≤ |c i|) : ‖a‖ ≤ ‖c‖ := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  apply Real.sqrt_le_sqrt
  apply Finset.sum_le_sum
  intro i _
  simp only [Real.norm_eq_abs]
  exact pow_le_pow_left₀ (abs_nonneg _) (h i) 2

theorem coord_tendsto {n : ℕ} (v : ℕ → E n) (v0 : E n) (hv : Tendsto v atTop (𝓝 v0)) (i : Fin n) :
    Tendsto (fun k => v k i) atTop (𝓝 (v0 i)) := by
  rw [tendsto_iff_norm_sub_tendsto_zero] at hv ⊢
  refine squeeze_zero (fun _ => norm_nonneg _) (fun k => ?_) hv
  have := PiLp.norm_apply_le (v k - v0) i
  simpa using this

theorem limsign {n : ℕ} {ℓ u : Fin n → ℝ} (a mm : ℕ → E n) (a0 m0 : E n)
    (ha : Tendsto a atTop (𝓝 a0)) (hm : Tendsto mm atTop (𝓝 m0))
    (hs : ∀ k, SignAt ℓ u (a k) (mm k)) : SignAt ℓ u a0 m0 := by
  intro i
  have hai := coord_tendsto a a0 ha i
  have hmi := coord_tendsto mm m0 hm i
  constructor
  · intro hpos
    have hev : ∀ᶠ k in atTop, a k i = ℓ i :=
      (hmi.eventually (lt_mem_nhds hpos)).mono fun k hk => (hs k i).1 hk
    exact tendsto_nhds_unique hai
      (Tendsto.congr' (hev.mono fun k hk => hk.symm) tendsto_const_nhds)
  · intro hneg
    have hev : ∀ᶠ k in atTop, a k i = u i :=
      (hmi.eventually (gt_mem_nhds hneg)).mono fun k hk => (hs k i).2 hk
    exact tendsto_nhds_unique hai
      (Tendsto.congr' (hev.mono fun k hk => hk.symm) tendsto_const_nhds)

set_option maxHeartbeats 1000000 in
/-- the quantitative step once the active sets are identified -/
theorem step {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} (hℓu : ∀ i, ℓ i < u i) {L : ℝ} (hL : 0 ≤ L)
    (hlip : ∀ x ∈ box ℓ u, ∀ x' ∈ box ℓ u, ‖gradient f x - gradient f x'‖ ≤ L * ‖x - x'‖)
    {γ Γ p : ℝ} (hγ : MonoConst f ℓ u γ) (hΓ : 0 ≤ Γ) (hp : 0 ≤ p) (hpg : 0 < p + γ)
    {xs : E m → E n → E n} (hxs : IsXSel f A b ℓ u Γ p xs)
    {xst : E n → E n} (hxst : IsXStarSel f A b ℓ u p xst)
    (J : Fin n → Prop) [DecidablePred J] {C : ℝ} (hC : 0 < C)
    (hpre : ∀ v : E m, ∃ δ : E m,
      (∀ i, J i → (ContinuousLinearMap.adjoint A) δ i = (ContinuousLinearMap.adjoint A) v i) ∧
      ‖δ‖ ≤ C * ‖(WithLp.toLp 2 (fun i => if J i then (ContinuousLinearMap.adjoint A) v i else 0)
        : E n)‖)
    (y : E m) (z : E n) {w : E m} (hw : w ∈ Ystar f A ℓ u p xst z)
    (hJ : ∀ i, J i → gradK f A b Γ p (xs y z) z y i = 0 ∧
      (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w) i = 0)
    (hlow : ∀ i, ¬ J i →
      (xst z i = ℓ i ∧ (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p)
          * (1 + ‖ContinuousLinearMap.adjoint A‖ * C) * ‖xs y z - xst z‖
        ≤ gradK f A b Γ p (xs y z) z y i) ∨
      (xst z i = u i ∧ gradK f A b Γ p (xs y z) z y i ≤
        -((L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p)
          * (1 + ‖ContinuousLinearMap.adjoint A‖ * C) * ‖xs y z - xst z‖))) :
    (p + γ) * Metric.infDist y (Ystar f A ℓ u p xst z)
      ≤ (C * (L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p)) ^ 2 * ‖A (xs y z) - b‖ := by
  obtain ⟨LK, hLK⟩ : ∃ LK, LK = L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p := ⟨_, rfl⟩
  rw [← hLK] at hlow ⊢
  have hLK0 : 0 ≤ LK := by rw [hLK]; positivity
  have hAxx : A (xst z) = b := (hxst z).1.2
  obtain ⟨D, hDdef⟩ : ∃ D, D = gradK f A b Γ p (xs y z) z 0 - gradK f A b Γ p (xst z) z 0 :=
    ⟨_, rfl⟩
  have hD : ‖D‖ ≤ LK * ‖xs y z - xst z‖ := by
    rw [hDdef, hLK]
    exact lip_gradK hlip hΓ hp z 0 _ _ (hxs y z).1 (hxst z).1.1
  have hDeq : gradK f A b Γ p (xs y z) z y - (ContinuousLinearMap.adjoint A) y
      - ((gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) w)
        - (ContinuousLinearMap.adjoint A) w) = D := by
    rw [hDdef]
    unfold gradK
    simp only [hAxx, sub_self, map_zero, smul_zero, add_zero]
    abel
  obtain ⟨δ, hδJ, hδn⟩ := hpre (w - y)
  have hmask : ‖(WithLp.toLp 2 (fun i => if J i then (ContinuousLinearMap.adjoint A) (w - y) i
      else 0) : E n)‖ ≤ ‖D‖ := by
    apply norm_le_of_coord
    intro i
    simp only [PiLp.toLp_apply]
    split_ifs with hi
    · have h2 := congrArg (fun v => v i) hDeq
      simp only [PiLp.sub_apply, PiLp.add_apply] at h2
      obtain ⟨hM0, hN0⟩ := hJ i hi
      simp only [PiLp.add_apply] at hN0
      rw [map_sub, PiLp.sub_apply]
      have : (ContinuousLinearMap.adjoint A) w i - (ContinuousLinearMap.adjoint A) y i = D i := by
        linarith
      rw [this]
    · simp
  have hδ : ‖δ‖ ≤ C * (LK * ‖xs y z - xst z‖) :=
    hδn.trans (mul_le_mul_of_nonneg_left (hmask.trans hD) hC.le)
  have hNω : gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) (y + δ)
      = gradK f A b Γ p (xs y z) z y - D + (ContinuousLinearMap.adjoint A) δ := by
    rw [← hDeq, map_add]
    abel
  have hsign : SignAt ℓ u (xst z)
      (gradient f (xst z) + p • (xst z - z) + (ContinuousLinearMap.adjoint A) (y + δ)) := by
    rw [hNω]
    intro i
    simp only [PiLp.add_apply, PiLp.sub_apply]
    have hAδ : |(ContinuousLinearMap.adjoint A) δ i| ≤ ‖ContinuousLinearMap.adjoint A‖ * ‖δ‖ := by
      have := PiLp.norm_apply_le ((ContinuousLinearMap.adjoint A) δ) i
      rw [Real.norm_eq_abs] at this
      exact this.trans (ContinuousLinearMap.le_opNorm _ _)
    have hDi : |D i| ≤ LK * ‖xs y z - xst z‖ := by
      have := PiLp.norm_apply_le D i
      rw [Real.norm_eq_abs] at this
      exact this.trans hD
    have hAδ' : ‖ContinuousLinearMap.adjoint A‖ * ‖δ‖
        ≤ ‖ContinuousLinearMap.adjoint A‖ * (C * (LK * ‖xs y z - xst z‖)) :=
      mul_le_mul_of_nonneg_left hδ (norm_nonneg _)
    have hK0 : LK * (1 + ‖ContinuousLinearMap.adjoint A‖ * C) * ‖xs y z - xst z‖
        = LK * ‖xs y z - xst z‖
          + ‖ContinuousLinearMap.adjoint A‖ * (C * (LK * ‖xs y z - xst z‖)) := by ring
    by_cases hJi : J i
    · have h0 : gradK f A b Γ p (xs y z) z y i - D i + (ContinuousLinearMap.adjoint A) δ i = 0 := by
        have h1 := hδJ i hJi
        rw [map_sub, PiLp.sub_apply] at h1
        have h2 := congrArg (fun v => v i) hDeq
        simp only [PiLp.sub_apply, PiLp.add_apply] at h2
        obtain ⟨hM0, hN0⟩ := hJ i hJi
        simp only [PiLp.add_apply] at hN0
        linarith
      rw [h0]
      exact ⟨fun h => absurd h (lt_irrefl 0), fun h => absurd h (lt_irrefl 0)⟩
    · rcases hlow i hJi with ⟨hxl, hMl⟩ | ⟨hxu, hMu⟩
      · refine ⟨fun _ => hxl, fun hneg => ?_⟩
        exfalso
        linarith [(abs_le.mp hAδ).1, (abs_le.mp hDi).2]
      · refine ⟨fun hpos => ?_, fun _ => hxu⟩
        exfalso
        linarith [(abs_le.mp hAδ).2, (abs_le.mp hDi).1]
  have hω : y + δ ∈ Ystar f A ℓ u p xst z := ystar_of_sign hsign
  have hdist : Metric.infDist y (Ystar f A ℓ u p xst z) ≤ ‖δ‖ := by
    refine (Metric.infDist_le_dist_of_mem hω).trans (le_of_eq ?_)
    rw [dist_eq_norm, show y - (y + δ) = -δ by abel, norm_neg]
  have hf3 := f3 hdiff hℓu hγ hxs hxst y z hω
  rw [show y - (y + δ) = -δ by abel, inner_neg_left, neg_neg] at hf3
  have hcs := real_inner_le_norm δ (A (xs y z) - b)
  have hΓr : 0 ≤ Γ * ‖A (xs y z) - b‖ ^ 2 := by positivity
  have hCL : 0 ≤ C * LK := mul_nonneg hC.le hLK0
  have h1 : (p + γ) * ‖xs y z - xst z‖ ^ 2 ≤ C * LK * ‖xs y z - xst z‖ * ‖A (xs y z) - b‖ := by
    have := mul_le_mul_of_nonneg_right hδ (norm_nonneg (A (xs y z) - b))
    nlinarith
  have h2 : (p + γ) * ‖xs y z - xst z‖ ≤ C * LK * ‖A (xs y z) - b‖ := by
    rcases eq_or_lt_of_le (norm_nonneg (xs y z - xst z)) with h0 | h0
    · rw [← h0, mul_zero]; exact mul_nonneg hCL (norm_nonneg _)
    · have h3 : ((p + γ) * ‖xs y z - xst z‖) * ‖xs y z - xst z‖
          ≤ (C * LK * ‖A (xs y z) - b‖) * ‖xs y z - xst z‖ := by nlinarith [h1]
      exact le_of_mul_le_mul_right h3 h0
  calc (p + γ) * Metric.infDist y (Ystar f A ℓ u p xst z) ≤ (p + γ) * ‖δ‖ :=
        mul_le_mul_of_nonneg_left hdist hpg.le
    _ ≤ (p + γ) * (C * (LK * ‖xs y z - xst z‖)) := mul_le_mul_of_nonneg_left hδ hpg.le
    _ = C * LK * ((p + γ) * ‖xs y z - xst z‖) := by ring
    _ ≤ C * LK * (C * LK * ‖A (xs y z) - b‖) := mul_le_mul_of_nonneg_left h2 hCL
    _ = (C * LK) ^ 2 * ‖A (xs y z) - b‖ := by ring

end D310Aux

set_option maxHeartbeats 1000000 in
open ProxADMMLC.Conv E312Aux C37Aux D310Aux Filter Topology in
theorem D310Aux.main {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (L : ℝ) (hA : Assumption22 f A b ℓ u L) (γ : ℝ)
    (hγ : MonoConst f ℓ u γ) (Γ p : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hpγ : -γ < p)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) :
    ∀ y0 : E m, ∃ Δ σ5 : ℝ, 0 < Δ ∧ 0 < σ5 ∧ ∀ (y : E m) (z : E n),
      y - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) → z ∈ box ℓ u → ‖A (xs y z) - b‖ ≤ Δ →
        Metric.infDist z (Xstar f A b ℓ u) ≤ Δ →
          Metric.infDist y (Ystar f A ℓ u p xst z) ≤ σ5 * ‖A (xs y z) - b‖ := by
  classical
  haveI hcs1 : ContinuousConstSMul ℝ (E n) := inferInstance
  intro y0
  obtain ⟨ha, hsc, hdiff, hL, hlip⟩ := hA
  have hpg : 0 < p + γ := by linarith
  by_contra hcon
  push_neg at hcon
  have hk : ∀ k : ℕ, ∃ (y : E m) (z : E n), y - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) ∧
      z ∈ box ℓ u ∧ ‖A (xs y z) - b‖ ≤ 1 / ((k : ℝ) + 1) ∧
      Metric.infDist z (Xstar f A b ℓ u) ≤ 1 / ((k : ℝ) + 1) ∧
      ((k : ℝ) + 1) * ‖A (xs y z) - b‖ < Metric.infDist y (Ystar f A ℓ u p xst z) :=
    fun k => hcon _ _ (by positivity) (by positivity)
  choose Y Z hYr hZb hr hd hgap using hk
  choose W hWy hWr using fun k => ystar_range hdiff hxst (Z k)
  have hWA : ∀ k, A (xs (W k) (Z k)) = b :=
    fun k => xs_of_ystar hdiff hℓu hγ hΓ.le hpγ hxs hxst (Z k) (hWy k)
  have hinv : Tendsto (fun k : ℕ => 1 / ((k : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hYbdd : Bornology.IsBounded (Set.range Y) :=
    L34Aux.bdd f A b ℓ u hℓu ha hdiff Γ p xs hxs y0 Y Z hYr hZb
      (squeeze_zero (fun k => norm_nonneg _) hr hinv)
  have hWbdd : Bornology.IsBounded (Set.range W) := by
    refine L34Aux.bdd f A b ℓ u hℓu ha hdiff Γ p xs hxs 0 W Z (fun k => by simpa using hWr k) hZb ?_
    simp only [hWA, sub_self, norm_zero]
    exact tendsto_const_nhds
  obtain ⟨RY, hRY⟩ := isBounded_iff_forall_norm_le.mp hYbdd
  obtain ⟨RW, hRW⟩ := isBounded_iff_forall_norm_le.mp hWbdd
  obtain ⟨RZ, hRZ⟩ := isBounded_iff_forall_norm_le.mp (L34Aux.box_bounded ℓ u)
  have hY' : ∀ k, ‖Y k‖ ≤ RY := fun k => hRY _ ⟨k, rfl⟩
  have hW' : ∀ k, ‖W k‖ ≤ RW := fun k => hRW _ ⟨k, rfl⟩
  have hZ' : ∀ k, ‖Z k‖ ≤ RZ := fun k => hRZ _ (hZb k)
  -- primal gap -> 0
  have hη2 : ∀ k, (p + γ) * ‖xs (Y k) (Z k) - xst (Z k)‖ ^ 2 ≤ (RY + RW) * (1 / ((k : ℝ) + 1)) := by
    intro k
    have h := f3 hdiff hℓu hγ hxs hxst (Y k) (Z k) (hWy k)
    have hcs := abs_real_inner_le_norm (Y k - W k) (A (xs (Y k) (Z k)) - b)
    have hcs2 := neg_abs_le (inner ℝ (Y k - W k) (A (xs (Y k) (Z k)) - b))
    have hyw : ‖Y k - W k‖ ≤ RY + RW := (norm_sub_le _ _).trans (add_le_add (hY' k) (hW' k))
    have hΓr : 0 ≤ Γ * ‖A (xs (Y k) (Z k)) - b‖ ^ 2 := by positivity
    have := mul_le_mul hyw (hr k) (norm_nonneg _) (by linarith [norm_nonneg (Y k - W k)])
    linarith
  have hη : Tendsto (fun k => ‖xs (Y k) (Z k) - xst (Z k)‖) atTop (𝓝 0) := by
    have h2 : Tendsto (fun k => ‖xs (Y k) (Z k) - xst (Z k)‖ ^ 2) atTop (𝓝 0) := by
      have hup := hinv.const_mul ((RY + RW) / (p + γ))
      rw [mul_zero] at hup
      refine squeeze_zero (fun k => sq_nonneg _) (fun k => ?_) hup
      rw [div_mul_eq_mul_div, le_div_iff₀ hpg, mul_comm]
      exact hη2 k
    have := (Real.continuous_sqrt.tendsto 0).comp h2
    simpa [Function.comp_def, Real.sqrt_sq (norm_nonneg _)] using this
  -- xst Z - Z -> 0
  have hXne := xstar_nonempty hdiff ha hp hxst
  have hxz : ∀ k, ‖xst (Z k) - Z k‖ ≤ ((p / (p + γ) + 1) * 2) * (1 / ((k : ℝ) + 1)) := by
    intro k
    have hlt : Metric.infDist (Z k) (Xstar f A b ℓ u) < 2 / ((k : ℝ) + 1) := by
      have h1 := hd k
      have h2 : 1 / ((k : ℝ) + 1) < 2 / ((k : ℝ) + 1) := by
        apply div_lt_div_of_pos_right (by norm_num) (by positivity)
      linarith
    obtain ⟨ζ, hζX, hζd⟩ := (Metric.infDist_lt_iff hXne).mp hlt
    have h1 := xst_near hdiff hγ hp.le hxst (Z k) hζX
    rw [dist_eq_norm] at hζd
    have h2 : ‖xst (Z k) - ζ‖ ≤ p / (p + γ) * ‖Z k - ζ‖ := by
      rw [div_mul_eq_mul_div, le_div_iff₀ hpg]; linarith
    have h3 : ‖xst (Z k) - Z k‖ ≤ ‖xst (Z k) - ζ‖ + ‖Z k - ζ‖ := by
      calc ‖xst (Z k) - Z k‖ = ‖(xst (Z k) - ζ) - (Z k - ζ)‖ := by congr 1; abel
        _ ≤ _ := norm_sub_le _ _
    have hpp : 0 ≤ p / (p + γ) := div_nonneg hp.le hpg.le
    have h4 := mul_le_mul_of_nonneg_left hζd.le hpp
    have e : 2 / ((k : ℝ) + 1) = 2 * (1 / ((k : ℝ) + 1)) := by ring
    rw [e] at h4 hζd
    nlinarith
  have hxzT : Tendsto (fun k => ‖xst (Z k) - Z k‖) atTop (𝓝 0) := by
    have hup := hinv.const_mul ((p / (p + γ) + 1) * 2)
    rw [mul_zero] at hup
    exact squeeze_zero (fun _ => norm_nonneg _) hxz hup
  -- compactness
  have hT : ∀ k, (Y k, W k, Z k) ∈ Metric.closedBall (0 : E m × E m × E n) (max RY (max RW RZ)) := by
    intro k
    rw [mem_closedBall_zero_iff, norm_prod_le_iff, norm_prod_le_iff]
    exact ⟨(hY' k).trans (le_max_left _ _),
      (hW' k).trans ((le_max_left _ _).trans (le_max_right _ _)),
      (hZ' k).trans ((le_max_right _ _).trans (le_max_right _ _))⟩
  obtain ⟨T, -, φ, hφ, hTlim⟩ := tendsto_subseq_of_bounded Metric.isBounded_closedBall hT
  have hφt : Tendsto φ atTop atTop := hφ.tendsto_atTop
  have hYl : Tendsto (fun k => Y (φ k)) atTop (𝓝 T.1) := (continuous_fst.tendsto T).comp hTlim
  have hWl : Tendsto (fun k => W (φ k)) atTop (𝓝 T.2.1) :=
    ((continuous_fst.comp continuous_snd).tendsto T).comp hTlim
  have hZl : Tendsto (fun k => Z (φ k)) atTop (𝓝 T.2.2) :=
    ((continuous_snd.comp continuous_snd).tendsto T).comp hTlim
  have hzb : T.2.2 ∈ box ℓ u :=
    (L34Aux.box_closed ℓ u).mem_of_tendsto hZl (Eventually.of_forall fun k => hZb (φ k))
  have hXSl : Tendsto (fun k => xst (Z (φ k))) atTop (𝓝 T.2.2) := by
    have h1 : Tendsto (fun k => xst (Z (φ k)) - Z (φ k)) atTop (𝓝 0) :=
      tendsto_zero_iff_norm_tendsto_zero.mpr (hxzT.comp hφt)
    simpa using h1.add hZl
  have hXl : Tendsto (fun k => xs (Y (φ k)) (Z (φ k))) atTop (𝓝 T.2.2) := by
    have h1 : Tendsto (fun k => xs (Y (φ k)) (Z (φ k)) - xst (Z (φ k))) atTop (𝓝 0) :=
      tendsto_zero_iff_norm_tendsto_zero.mpr (hη.comp hφt)
    simpa using h1.add hXSl
  have hAz : A T.2.2 = b := by
    have h1 : Tendsto (fun k => A (xst (Z (φ k)))) atTop (𝓝 (A T.2.2)) :=
      (A.continuous.tendsto _).comp hXSl
    have h2 : (fun k => A (xst (Z (φ k)))) = fun _ => b := funext fun k => (hxst _).1.2
    rw [h2] at h1
    exact (tendsto_nhds_unique tendsto_const_nhds h1).symm
  have hgl : ∀ v : ℕ → E n, (∀ k, v k ∈ box ℓ u) → Tendsto v atTop (𝓝 T.2.2) →
      Tendsto (fun k => gradient f (v k)) atTop (𝓝 (gradient f T.2.2)) := by
    intro v hv hvl
    rw [tendsto_iff_norm_sub_tendsto_zero] at hvl ⊢
    have := hvl.const_mul L
    rw [mul_zero] at this
    exact squeeze_zero (fun _ => norm_nonneg _) (fun k => hlip _ (hv k) _ hzb) this
  have hMl : Tendsto (fun k => gradK f A b Γ p (xs (Y (φ k)) (Z (φ k))) (Z (φ k)) (Y (φ k)))
      atTop (𝓝 (gradient f T.2.2 + (ContinuousLinearMap.adjoint A) T.1)) := by
    have e : gradient f T.2.2 + (ContinuousLinearMap.adjoint A) T.1
        = gradient f T.2.2 + (ContinuousLinearMap.adjoint A) T.1
          + Γ • (ContinuousLinearMap.adjoint A) (A T.2.2 - b) + p • (T.2.2 - T.2.2) := by
      rw [hAz, sub_self, map_zero, smul_zero, sub_self, smul_zero, add_zero, add_zero]
    rw [e]
    unfold gradK
    have t1 := hgl _ (fun k => (hxs _ _).1) hXl
    have t2 := ((ContinuousLinearMap.adjoint A).continuous.tendsto _).comp hYl
    have t3 := (((ContinuousLinearMap.adjoint A).continuous.tendsto _).comp
      (((A.continuous.tendsto _).comp hXl).sub_const b)).const_smul Γ
    have t4 := (hXl.sub hZl).const_smul p
    exact ((t1.add t2).add t3).add t4
  have hM'l : Tendsto (fun k => gradient f (xst (Z (φ k))) + p • (xst (Z (φ k)) - Z (φ k))
      + (ContinuousLinearMap.adjoint A) (W (φ k)))
      atTop (𝓝 (gradient f T.2.2 + (ContinuousLinearMap.adjoint A) T.2.1)) := by
    have e : gradient f T.2.2 + (ContinuousLinearMap.adjoint A) T.2.1
        = gradient f T.2.2 + p • (T.2.2 - T.2.2) + (ContinuousLinearMap.adjoint A) T.2.1 := by
      rw [sub_self, smul_zero, add_zero]
    rw [e]
    have t1 := hgl _ (fun k => (hxst _).1.1) hXSl
    have t2 := ((ContinuousLinearMap.adjoint A).continuous.tendsto _).comp hWl
    have t4 := (hXSl.sub hZl).const_smul p
    exact (t1.add t4).add t2
  have hS1 := limsign _ _ _ _ hXl hMl (fun k => sign_xs hdiff hℓu hxs (Y (φ k)) (Z (φ k)))
  have hS2 := limsign _ _ _ _ hXSl hM'l (fun k => sign_of_ystar (hWy (φ k)))
  have hSC1 := sc_strict hsc hzb hAz hS1
  have hSC2 := sc_strict hsc hzb hAz hS2
  -- the masked adjoint and its open-mapping constant
  let J : Fin n → Prop := fun i => ℓ i < T.2.2 i ∧ T.2.2 i < u i
  let B : E m →ₗ[ℝ] E n :=
    { toFun := fun w => WithLp.toLp 2 (fun i => if J i then (ContinuousLinearMap.adjoint A) w i else 0)
      map_add' := by
        intro v w; ext i; by_cases h : J i <;> simp [h]
      map_smul' := by
        intro c v; ext i; by_cases h : J i <;> simp [h] }
  have hBapp : ∀ w i, B w i = if J i then (ContinuousLinearMap.adjoint A) w i else 0 :=
    fun w i => rfl
  obtain ⟨C, hC, hCpre⟩ :=
    (LinearMap.toContinuousLinearMap B.rangeRestrict).exists_preimage_norm_le
      (LinearMap.surjective_rangeRestrict B)
  have hpre : ∀ v : E m, ∃ δ : E m,
      (∀ i, J i → (ContinuousLinearMap.adjoint A) δ i = (ContinuousLinearMap.adjoint A) v i) ∧
      ‖δ‖ ≤ C * ‖(WithLp.toLp 2 (fun i => if J i then (ContinuousLinearMap.adjoint A) v i else 0)
        : E n)‖ := by
    intro v
    obtain ⟨δ, hδ1, hδ2⟩ := hCpre ⟨B v, LinearMap.mem_range_self B v⟩
    have hBδ : B δ = B v := congrArg Subtype.val hδ1
    refine ⟨δ, fun i hi => ?_, hδ2⟩
    have := congrArg (fun q => q i) hBδ
    simp only [hBapp, if_pos hi] at this
    exact this
  obtain ⟨Xf, hXf⟩ : ∃ Xf : ℕ → E n, Xf = fun k => xs (Y (φ k)) (Z (φ k)) := ⟨_, rfl⟩
  obtain ⟨Sf, hSf⟩ : ∃ Sf : ℕ → E n, Sf = fun k => xst (Z (φ k)) := ⟨_, rfl⟩
  obtain ⟨Mf, hMf⟩ : ∃ Mf : ℕ → E n,
      Mf = fun k => gradK f A b Γ p (xs (Y (φ k)) (Z (φ k))) (Z (φ k)) (Y (φ k)) := ⟨_, rfl⟩
  obtain ⟨Nf, hNf⟩ : ∃ Nf : ℕ → E n, Nf = fun k => gradient f (xst (Z (φ k)))
      + p • (xst (Z (φ k)) - Z (φ k)) + (ContinuousLinearMap.adjoint A) (W (φ k)) := ⟨_, rfl⟩
  rw [← hXf] at hXl
  rw [← hSf] at hXSl
  rw [← hMf] at hMl
  rw [← hNf] at hM'l
  have hsX : ∀ k, SignAt ℓ u (Xf k) (Mf k) := fun k => by
    rw [hXf, hMf]; exact sign_xs hdiff hℓu hxs _ _
  have hsS : ∀ k, SignAt ℓ u (Sf k) (Nf k) := fun k => by
    rw [hSf, hNf]; exact sign_of_ystar (hWy (φ k))
  have hηl : Tendsto (fun k => ‖Xf k - Sf k‖) atTop (𝓝 0) := by
    rw [hXf, hSf]; exact hη.comp hφt
  obtain ⟨LK, hLK⟩ : ∃ LK, LK = L + Γ * (‖ContinuousLinearMap.adjoint A‖ * ‖A‖) + p := ⟨_, rfl⟩
  obtain ⟨K0, hK0⟩ : ∃ K0, K0 = LK * (1 + ‖ContinuousLinearMap.adjoint A‖ * C) := ⟨_, rfl⟩
  have hev1 : ∀ i, ∀ᶠ k in atTop, (J i → Mf k i = 0 ∧ Nf k i = 0) ∧
      (T.2.2 i = ℓ i → Sf k i = ℓ i ∧ K0 * ‖Xf k - Sf k‖ ≤ Mf k i) ∧
      (T.2.2 i = u i → Sf k i = u i ∧ Mf k i ≤ -(K0 * ‖Xf k - Sf k‖)) := by
    intro i
    have hXi := coord_tendsto _ _ hXl i
    have hSi := coord_tendsto _ _ hXSl i
    have hMi := coord_tendsto _ _ hMl i
    have hNi := coord_tendsto _ _ hM'l i
    refine Eventually.and ?_ (Eventually.and ?_ ?_)
    · by_cases hJ : J i
      · have h1 := hXi.eventually (Ioo_mem_nhds hJ.1 hJ.2)
        have h2 := hSi.eventually (Ioo_mem_nhds hJ.1 hJ.2)
        filter_upwards [h1, h2] with k hk1 hk2
        intro _
        constructor
        · rcases lt_trichotomy (Mf k i) 0 with h | h | h
          · exact absurd ((hsX k i).2 h) (ne_of_lt hk1.2)
          · exact h
          · exact absurd ((hsX k i).1 h) (ne_of_gt hk1.1)
        · rcases lt_trichotomy (Nf k i) 0 with h | h | h
          · exact absurd ((hsS k i).2 h) (ne_of_lt hk2.2)
          · exact h
          · exact absurd ((hsS k i).1 h) (ne_of_gt hk2.1)
      · exact Eventually.of_forall fun k h => absurd h hJ
    · by_cases hl : T.2.2 i = ℓ i
      · have hpos1 := (hSC1 i).1 hl
        have hpos2 := (hSC2 i).1 hl
        have h1 := hNi.eventually (lt_mem_nhds hpos2)
        have hlim := hMi.sub (hηl.const_mul K0)
        rw [mul_zero, sub_zero] at hlim
        have h2 := hlim.eventually (lt_mem_nhds hpos1)
        filter_upwards [h1, h2] with k hk1 hk2
        intro _
        exact ⟨(hsS k i).1 hk1, by linarith⟩
      · exact Eventually.of_forall fun k h => absurd h hl
    · by_cases hu : T.2.2 i = u i
      · have hneg1 := (hSC1 i).2 hu
        have hneg2 := (hSC2 i).2 hu
        have h1 := hNi.eventually (gt_mem_nhds hneg2)
        have hlim := hMi.add (hηl.const_mul K0)
        rw [mul_zero, add_zero] at hlim
        have h2 := hlim.eventually (gt_mem_nhds hneg1)
        filter_upwards [h1, h2] with k hk1 hk2
        intro _
        exact ⟨(hsS k i).2 hk1, by linarith⟩
      · exact Eventually.of_forall fun k h => absurd h hu
  have hev2 : ∀ᶠ k in atTop, (C * LK) ^ 2 ≤ (p + γ) * ((φ k : ℝ) + 1) := by
    have h1 : Tendsto (fun k => (p + γ) * ((φ k : ℝ) + 1)) atTop atTop := by
      apply Tendsto.const_mul_atTop hpg
      exact tendsto_atTop_add_const_right _ 1 (tendsto_natCast_atTop_atTop.comp hφt)
    exact h1.eventually_ge_atTop _
  obtain ⟨k, hk1, hk2⟩ := ((eventually_all.mpr hev1).and hev2).exists
  have hstep := step hdiff hℓu hL.le hlip hγ hΓ.le hp.le hpg hxs hxst J hC hpre (Y (φ k)) (Z (φ k))
    (hWy (φ k)) (fun i hi => by
      have := (hk1 i).1 hi
      rw [hMf, hNf] at this
      exact this) (fun i hi => by
      rw [← hLK, ← hK0]
      have hb := hzb i
      have hcase : T.2.2 i = ℓ i ∨ T.2.2 i = u i := by
        by_contra hc
        push_neg at hc
        exact hi ⟨lt_of_le_of_ne hb.1 (Ne.symm hc.1), lt_of_le_of_ne hb.2 hc.2⟩
      rcases hcase with hc | hc
      · left
        have := (hk1 i).2.1 hc
        rw [hMf, hSf, hXf] at this
        exact this
      · right
        have := (hk1 i).2.2 hc
        rw [hMf, hSf, hXf] at this
        exact this)
  rw [← hLK] at hstep
  have hg := hgap (φ k)
  have hrn := norm_nonneg (A (xs (Y (φ k)) (Z (φ k))) - b)
  have := mul_lt_mul_of_pos_left hg hpg
  have := mul_le_mul_of_nonneg_right hk2 hrn
  nlinarith

open ProxADMMLC.Conv in
theorem solution {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (L : ℝ) (hA : Assumption22 f A b ℓ u L) (γ : ℝ)
    (hγ : MonoConst f ℓ u γ) (Γ p : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hpγ : -γ < p)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) :
    ∀ y0 : E m, ∃ Δ σ5 : ℝ, 0 < Δ ∧ 0 < σ5 ∧ ∀ (y : E m) (z : E n),
      y - y0 ∈ LinearMap.range (A : E n →ₗ[ℝ] E m) → z ∈ box ℓ u → ‖A (xs y z) - b‖ ≤ Δ →
        Metric.infDist z (Xstar f A b ℓ u) ≤ Δ →
          Metric.infDist y (Ystar f A ℓ u p xst z) ≤ σ5 * ‖A (xs y z) - b‖ := by
  exact D310Aux.main f A b ℓ u hℓu L hA γ hγ Γ p hΓ hp hpγ xs hxs xst hxst
