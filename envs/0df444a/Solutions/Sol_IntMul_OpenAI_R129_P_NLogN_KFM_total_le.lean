section Passes
variable {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hn hD
theorem eT2 : 2 ^ (IntMul.OpenAI.Glue.LP n + 1) = 2 * IntMul.OpenAI.Glue.TP n := by rw [pow_succ]; unfold IntMul.OpenAI.Glue.TP; ring

theorem fmB_le8 {m : ℕ} (hm : m ≤ 8 * pP n) : fmB m ≤ fmB (8 * pP n) := fmB_mono hm

theorem kShl_le : kShl n D ≤ 10 ^ 6 * (IntMul.OpenAI.Glue.TP n * (pP n + 1) + pP n + 1) := by
  have hW := wU_le hn hD
  have hb := (setup_facts hn).1
  unfold kShl
  have c1 := cItem_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (1000 * (pP n + 2 + 2 * (D + 1) * αP n ^ 2 + 2))
    (pP n + 2 + 2 * (D + 1) * αP n ^ 2 + 1)
  have c2 := cCnt_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1))
  have c3 := cW_pow (2 * (D + 1) * αP n ^ 2)
  have c4 := cW_nat (2 ^ (IntMul.OpenAI.Glue.LP n + 1))
  rw [IntMul.OpenAI.R129.P.NLogN.KFM.eT2 hn hD] at c1 c2 c4 ⊢
  unfold IntMul.OpenAI.R129.P.NLogN.KFM.wU at hW
  set X := 2 * (D + 1) * αP n ^ 2 with hX
  set T := IntMul.OpenAI.Glue.TP n
  have hX' : X ≤ pP n := by omega
  have m1 := Nat.mul_le_mul_left (2 * T) hX'
  have m2 := Nat.mul_le_mul_left (2 * T + 1) hX'
  nlinarith

theorem kGm_le : kGm n D ≤ 10 ^ 8 * (IntMul.OpenAI.Glue.TP n * (pP n + 1 + fmB (8 * pP n)) + pP n + 1) := by
  have hW := wU_le hn hD
  have hF := fmB_le8 hn hD (m := 2 * IntMul.OpenAI.R129.P.NLogN.KFM.wU n D) (by omega)
  unfold kGm
  have c2 := cCnt_le (2 * 2 ^ IntMul.OpenAI.Glue.LP n)
  have c3 := cW_pow (pP n)
  have c4 := cW_nat (2 * 2 ^ IntMul.OpenAI.Glue.LP n)
  have c5 := cW_nat (2 ^ IntMul.OpenAI.Glue.LP n)
  have eT : 2 ^ IntMul.OpenAI.Glue.LP n = IntMul.OpenAI.Glue.TP n := rfl
  rw [eT] at c2 c4 c5 ⊢
  set T := IntMul.OpenAI.Glue.TP n
  have m1 := Nat.mul_le_mul_left (4 * T) hF
  have m2 := Nat.mul_le_mul_left (T + 1) hW
  nlinarith

theorem kCj_le {B : ℕ} (hB : B ≤ 3 * pP n) : kCj n B ≤ 10 ^ 6 * (IntMul.OpenAI.Glue.TP n * (pP n + 1) + pP n + 1) := by
  unfold kCj
  have c1 := cConj_le (2 ^ IntMul.OpenAI.Glue.LP n) B
  have c4 := cW_nat (2 * 2 ^ IntMul.OpenAI.Glue.LP n)
  have c5 := cW_nat (2 ^ IntMul.OpenAI.Glue.LP n)
  have eT : 2 ^ IntMul.OpenAI.Glue.LP n = IntMul.OpenAI.Glue.TP n := rfl
  rw [eT] at c1 c4 c5 ⊢
  set T := IntMul.OpenAI.Glue.TP n
  set p := pP n
  have m2 := Nat.mul_le_mul_left (T + 1) hB
  have e1 : (T + 1) * (3 * p) = 3 * (T * p) + 3 * p := by ring
  have e2 : T * (p + 1) = T * p + T := by ring
  have e3 : 10000 * (T + 1) * (B + 2) = 10000 * ((T + 1) * B) + 20000 * T + 20000 := by ring
  rw [e3] at c1; rw [e1] at m2; rw [e2]
  omega

theorem cCarU_le' : cCarU (bP n) (pP n + 2) (sCmp n) ≤
    10 ^ 7 * (IntMul.OpenAI.Glue.TP n * (pP n + 1) + pP n + 1) := by
  have hS := sCmp_le_T hn hD
  have hb := (setup_facts hn).1
  unfold cCarU
  have c1 := cCar_le (bP n) (pP n + 2) (sCmp n)
  have c2 := cCnt_le (sCmp n)
  have d1 : dupCost (bP n + 1) + 17 ≤ 135 * (bP n + 3) := by
    simp only [dupCost, zipCost, moveCost]; omega
  have hbp : bP n ≤ pP n := by unfold pP; omega
  set T := IntMul.OpenAI.Glue.TP n
  have m1 := Nat.mul_le_mul_right (pP n + 2 + bP n + 1) (Nat.succ_le_succ hS)
  have m2 := Nat.mul_le_mul_left (T + 1) hbp
  nlinarith

theorem kDig_le : kDig n ≤ 10 ^ 7 * (IntMul.OpenAI.Glue.TP n * (pP n + 1) + n + pP n + 1) := by
  have hS := sCmp_le_T hn hD
  have hb := (setup_facts hn).1
  have hM := mN_le n (by omega) (by have := n0_ge3 hn; omega)
  have hMb : NLogN.KFM.mN n * bP n ≤ n + bP n := by
    unfold NLogN.KFM.mN; have := Nat.div_mul_le_self (n + bP n - 1) (bP n); omega
  unfold kDig
  have c1 := cDigU_le (bP n) (NLogN.KFM.eN n) (NLogN.KFM.mN n) (sCmp n)
  have w1 := cW_pow (NLogN.KFM.eN n)
  have w2 := cW_nat (2 * (sCmp n - NLogN.KFM.mN n))
  have w3 := cW_nat (NLogN.KFM.mN n)
  have w4 := cW_pow (bP n)
  have he : NLogN.KFM.eN n ≤ 5 * bP n := by unfold NLogN.KFM.eN pP; omega
  have hp : pP n = 6 * bP n := rfl
  set T := IntMul.OpenAI.Glue.TP n
  have m1 : (NLogN.KFM.mN n + 1) * (bP n + NLogN.KFM.eN n + 1) ≤ 7 * (n + bP n) + 6 * bP n + 1 + 7 * NLogN.KFM.mN n := by
    have : (NLogN.KFM.mN n + 1) * (bP n + NLogN.KFM.eN n + 1) ≤ (NLogN.KFM.mN n + 1) * (6 * bP n + 1) :=
      Nat.mul_le_mul_left _ (by omega)
    nlinarith
  have hpT : 1 ≤ T := Nat.one_le_two_pow
  have hsub := Nat.sub_le (sCmp n) (NLogN.KFM.mN n)
  nlinarith

end Passes

end
