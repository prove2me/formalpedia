lemma rpow_le_add_one {y t : ℝ} (hy : 0 ≤ y) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) : y ^ t ≤ y + 1 := by
  rcases le_or_gt y 1 with h | h
  · have := Real.rpow_le_one hy h ht0; linarith
  · have : y ^ t ≤ y ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le h.le ht1
    rw [Real.rpow_one] at this; linarith

/-- **Row-by-row bound.** -/
theorem Ncost6R_le_sol_aux (P : Prm) (hP : P.Ok) (B p d ℓ : ℝ) (hB : 1 ≤ B) (hp1 : 1 ≤ p)
    (hp : p ≤ 6 * B ^ ((1 : ℝ) + P.x)) (hd1 : B ^ P.ε / 2 ≤ d) (hd2 : d ≤ B ^ P.ε)
    (hℓ0 : 0 ≤ ℓ) (hℓ : ℓ ≤ 4 * B ^ (1 - P.ε)) :
    Ncost6R P p d ℓ ≤ Cst P * B ^ (1 - P.gap) * (Real.log B + 1) := by
  have hB0 : 0 < B := by linarith
  have hp0 : 0 < p := by linarith
  have hd0 : 0 ≤ d := le_trans (by have := Real.rpow_pos_of_pos hB0 P.ε; positivity) hd1
  have hx0 : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  have hδ0 := hP.delta_pos
  have hpoly0 : 0 ≤ P.poly := by unfold Prm.poly; positivity
  set g := P.gap with hg
  have g1 : g ≤ 1 - P.ε := P.gap_le_one_sub
  have g2 : g ≤ P.ε * (1 - P.lamp) := P.gap_le_lamp
  have g3 : g ≤ 1 - P.ε - P.poly := P.gap_le_poly
  have g4 : g ≤ P.ε := P.gap_le_eps
  have g5 : g ≤ P.ε * (1 - P.τ) := by
    have := P.gap_le_tau
    have hm : max P.ε (1 - P.ε) = P.ε := max_eq_left (by linarith [hP.eps_ge])
    rwa [hm] at this
  set E := B ^ (1 - g) with hE
  have hE1 : 1 ≤ E := Real.one_le_rpow hB (by linarith [hP.eps_ge])
  have hlB : 0 ≤ Real.log B := Real.log_nonneg hB
  set Λ := Real.log B + 1 with hΛ
  have hΛ1 : 1 ≤ Λ := by linarith
  have pw : ∀ a : ℝ, a ≤ 1 - g → B ^ a ≤ E := fun a ha => Real.rpow_le_rpow_of_exponent_le hB ha
  have mulB : ∀ a c : ℝ, B ^ a * B ^ c = B ^ (a + c) := fun a c => (Real.rpow_add hB0 a c).symm
  -- p^δ ≤ 6 B^poly
  have hpδ : p ^ P.δ ≤ 6 * B ^ P.poly := by
    have h1 : p ^ P.δ ≤ (6 * B ^ ((1 : ℝ) + P.x)) ^ P.δ := Real.rpow_le_rpow hp0.le hp hδ0.le
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg hB0.le _), ← Real.rpow_mul hB0.le] at h1
    have h6 : (6 : ℝ) ^ P.δ ≤ 6 := by
      calc (6 : ℝ) ^ P.δ ≤ 6 ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith [hP.delta_lt])
        _ = 6 := Real.rpow_one 6
    have : ((1 : ℝ) + P.x) * P.δ = P.poly := rfl
    rw [this] at h1
    have := Real.rpow_nonneg hB0.le P.poly
    nlinarith
  -- log p ≤ 6 + (1+x) log B ≤ (6 + x) Λ
  have hlogp : Real.log p ≤ (6 + P.x) * Λ := by
    have h1 : Real.log p ≤ Real.log (6 * B ^ ((1 : ℝ) + P.x)) := Real.log_le_log hp0 hp
    rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hB0 _).ne', Real.log_rpow hB0] at h1
    have h6 : Real.log 6 ≤ 5 := by
      have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 6 by norm_num); linarith
    nlinarith
  have hlogp0 : 0 ≤ Real.log p := Real.log_nonneg hp1
  -- rows
  have r1 : d ≤ E := hd2.trans (pw _ (by linarith))
  have r2 : ℓ * d ^ P.lamp ≤ 4 * E := by
    have h1 : d ^ P.lamp ≤ (B ^ P.ε) ^ P.lamp := Real.rpow_le_rpow hd0 hd2 hP.lamp_pos.le
    rw [← Real.rpow_mul hB0.le] at h1
    calc ℓ * d ^ P.lamp ≤ (4 * B ^ (1 - P.ε)) * B ^ (P.ε * P.lamp) :=
          mul_le_mul hℓ h1 (Real.rpow_nonneg hd0 _) (by positivity)
      _ = 4 * B ^ (1 - P.ε + P.ε * P.lamp) := by rw [mul_assoc, mulB]
      _ ≤ 4 * E := by gcongr; exact pw _ (by nlinarith)
  have r3 : d * p ^ P.δ ≤ 6 * E := by
    calc d * p ^ P.δ ≤ B ^ P.ε * (6 * B ^ P.poly) :=
          mul_le_mul hd2 hpδ (Real.rpow_nonneg hp0.le _) (Real.rpow_nonneg hB0.le _)
      _ = 6 * B ^ (P.ε + P.poly) := by rw [← mulB]; ring
      _ ≤ 6 * E := by gcongr; exact pw _ (by linarith)
  have r4a : ℓ ≤ 4 * E := hℓ.trans (by gcongr; exact pw _ (by linarith))
  have r4b : Real.logb 2 p ≤ 2 * (6 + P.x) * (E * Λ) := by
    have hl2 := Real.log_two_gt_d9
    rw [Real.logb, div_le_iff₀ (by linarith)]
    have h1 : Λ ≤ E * Λ := by nlinarith
    have h2 : Real.log p ≤ (6 + P.x) * (E * Λ) :=
      hlogp.trans (mul_le_mul_of_nonneg_left h1 (by positivity))
    have h3 : 0 ≤ (6 + P.x) * (E * Λ) := by positivity
    nlinarith
  have r5 : p ^ P.δ ≤ 6 * E :=
    hpδ.trans (by gcongr; exact pw _ (by linarith [hP.eps_ge]))
  have r6 : ℓ * (d * Real.log p) ^ P.τ ≤ 4 * (7 + P.x) * (E * Λ) := by
    rw [Real.mul_rpow hd0 hlogp0]
    have h1 : d ^ P.τ ≤ (B ^ P.ε) ^ P.τ := Real.rpow_le_rpow hd0 hd2 hP.tau_pos.le
    rw [← Real.rpow_mul hB0.le] at h1
    have h2 : ℓ * d ^ P.τ ≤ 4 * E := by
      calc ℓ * d ^ P.τ ≤ (4 * B ^ (1 - P.ε)) * B ^ (P.ε * P.τ) :=
            mul_le_mul hℓ h1 (Real.rpow_nonneg hd0 _) (by positivity)
        _ = 4 * B ^ (1 - P.ε + P.ε * P.τ) := by rw [mul_assoc, mulB]
        _ ≤ 4 * E := by gcongr; exact pw _ (by nlinarith)
    have h3 : Real.log p ^ P.τ ≤ (7 + P.x) * Λ := by
      have := rpow_le_add_one hlogp0 hP.tau_pos.le hP.tau_le
      nlinarith
    have h4 : 0 ≤ ℓ * d ^ P.τ := mul_nonneg hℓ0 (Real.rpow_nonneg hd0 _)
    calc ℓ * (d ^ P.τ * Real.log p ^ P.τ) = (ℓ * d ^ P.τ) * Real.log p ^ P.τ := by ring
      _ ≤ (4 * E) * ((7 + P.x) * Λ) :=
          mul_le_mul h2 h3 (Real.rpow_nonneg hlogp0 _) (by positivity)
      _ = 4 * (7 + P.x) * (E * Λ) := by ring
  have hEΛ : E ≤ E * Λ := by nlinarith
  unfold Ncost6R Cst
  have : (64 + 6 * (P.x : ℝ)) * E * Λ = (64 + 6 * P.x) * (E * Λ) := by ring
  rw [this]
  nlinarith

end

