    (result s).natMem j = s.natMem j ∧ (result s).realMem j = s.realMem j := by
  simp [result,atoms,Atom.effect,instructionEffect,data,Data.machine,h.root,h.next,h.tail,h.head,h.flag,
    Function.update_of_ne h0,Function.update_of_ne h1,Function.update_of_ne h2,
    Function.update_of_ne h3,Function.update_of_ne h4]
