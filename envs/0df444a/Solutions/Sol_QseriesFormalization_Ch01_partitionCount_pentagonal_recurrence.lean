theorem solution {n : Nat} (hn : 1 ≤ n) :
    (partitionCount n : ℤ) =
      ∑ j ∈ Finset.range n, (-1 : ℤ) ^ j *
        ((if pentagonalLower (j + 1) ≤ n then (partitionCount (n - pentagonalLower (j + 1)) : ℤ)
            else 0) +
          (if pentagonalUpper (j + 1) ≤ n then (partitionCount (n - pentagonalUpper (j + 1)) : ℤ)
            else 0)) := by
  have h := congrArg (PowerSeries.coeff n) partitionSeries_mul_pentagonalSeries
  rw [mul_comm, PowerSeries.coeff_mul, PowerSeries.coeff_one, if_neg (show n ≠ 0 by omega),
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at h
  simp only [PowerSeries.coeff_mk] at h
  have hexp : ∀ k ∈ Finset.range n.succ,
      PowerSeries.coeff k (PowerSeries.pentagonalSeries ℤ) * (partitionCount (n - k) : ℤ) =
        (if k = 0 then (partitionCount (n - k) : ℤ) else 0) +
        ∑ j ∈ Finset.range n, (-1 : ℤ) ^ (j + 1) *
          ((if k = pentagonalLower (j + 1) then (partitionCount (n - k) : ℤ) else 0) +
            (if k = pentagonalUpper (j + 1) then (partitionCount (n - k) : ℤ) else 0)) := by
    intro k hk
    rw [coeff_pentagonalSeries_eq_sum (m := n) (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)),
      add_mul, Finset.sum_mul]
    congr 1
    · split_ifs <;> simp
    · refine Finset.sum_congr rfl fun j _ => ?_
      split_ifs <;> ring
  rw [Finset.sum_congr rfl hexp, Finset.sum_add_distrib, Finset.sum_comm] at h
  simp only [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_ite_eq',
    Finset.mem_range, Nat.lt_succ_iff, Nat.zero_le, ↓reduceIte, Nat.sub_zero, pow_succ,
    mul_neg_one, neg_mul, Finset.sum_neg_distrib] at h
  linarith
