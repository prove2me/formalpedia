section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem secondCountableTopology_adicCompletion : SecondCountableTopology (v.adicCompletion ℚ) := by
  have hϖ : Valued.v (((NumberField.AdelicLevel.uniformizerUnit ℚ v)⁻¹ : (v.adicCompletion ℚ)ˣ) :
      v.adicCompletion ℚ) = (WithZero.exp (-1 : ℤ))⁻¹ := by
    rw [Units.val_inv_eq_inv_val, map_inv₀, NumberField.AdelicLevel.valued_uniformizerUnit ℚ v]
  letI : NontriviallyNormedField (v.adicCompletion ℚ) :=
    { (inferInstance : NormedField (v.adicCompletion ℚ)) with
      non_trivial := ⟨_, by
        rw [IdeleNormSplit.norm_eq_of_valued_eq v (n := -1) hϖ, zpow_neg_one, inv_inv]
        exact_mod_cast NumberField.HeightOneSpectrum.one_lt_absNorm (v := v)⟩ }
  haveI : ProperSpace (v.adicCompletion ℚ) :=
    ProperSpace.of_nontriviallyNormedField_of_weaklyLocallyCompactSpace _
  infer_instance

private theorem borelSpace_units_adicCompletion :
    letI := localBorel ℚ v
    BorelSpace (v.adicCompletion ℚ)ˣ := by
  letI := localBorel ℚ v
  haveI : BorelSpace (v.adicCompletion ℚ) := borelSpace_localBorel ℚ v
  exact borelSpace_units

private theorem secondCountableTopology_units_adicCompletion : SecondCountableTopology (v.adicCompletion ℚ)ˣ := by
  haveI := secondCountableTopology_adicCompletion v
  exact secondCountableTopology_units

end
