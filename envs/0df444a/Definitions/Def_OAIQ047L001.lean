namespace OAI

namespace Laughlin.Fock
open scoped BigOperators

noncomputable def sliceOrbital (Q z : ℕ) (hz : z ≤ Q) (p : Fin (z+1)) : Fin (Q+1) :=
  ⟨z-p.val,by omega⟩

noncomputable def threeBodyGramSlice (Q z : ℕ) (hz : z ≤ Q)
    (p q : Fin (z+1)) : ℝ :=
