               ⟨hhk, hDk, hyk⟩⟩ : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Raw k) : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Pt k)) ∧
      (∀ F : FormalGroup k, F.toPowerSeries = (xet.curve.map ψet.toRingHom).formalGroupLawFixed →
        ∃ u : PowerSeries k, IsUnit u ∧ F.nthSeries q = u * PowerSeries.X ^ q) ∧
      Spec.map (CommRingCat.ofHom χ) ≫ Qu.1 ≠
        (((𝒢.restrictScalars W₀) Pet.B₀ xet.curve xet.isUnit_Δ).one
          (Spec.map (CommRingCat.ofHom (χ.comp (algebraMap Pet.B₀ CQ))))).1 := by
