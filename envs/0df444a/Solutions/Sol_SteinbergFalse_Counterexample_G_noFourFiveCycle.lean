/-- adjacency matrix of `G` as one bit string: bit `u * 166 + v` is set iff `u ~ v` -/
def ADJ : ℕ := 

/-- neighbourhood bit mask of the vertex `x` -/
def msk (x : ℕ) : ℕ := (ADJ >>> (x * 166)) % 2 ^ 166

theorem beqT {a b : ℕ} (h : Nat.beq a b = true) : a = b := by simpa only [Nat.beq_eq] using h

theorem adj_bits : EGs.all (fun s => Sym2.lift ⟨fun u v : Fin 166 =>
    ADJ.testBit (u.val * 166 + v.val) && ADJ.testBit (v.val * 166 + u.val),
    fun _ _ => Bool.and_comm _ _⟩ s) = true := by decide +kernel

theorem adj_msk {u v : Fin 166} (h : G.Adj u v) : (msk u.val).testBit v.val = true := by
  have h1 := List.all_eq_true.1 adj_bits _ (G_adj_mem h)
  simp only [Sym2.lift_mk, Bool.and_eq_true] at h1
  rw [msk, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]
  simp only [v.isLt, decide_true, Bool.true_and]
  exact h1.1

def orF : List ℕ → ℕ
  | [] => 0
  | x :: xs => 2 ^ x ||| orF xs

theorem orF_mem : ∀ {l : List ℕ} {y : ℕ}, (orF l).testBit y = true → y ∈ l
  | [], y, h => by simp only [orF, Nat.zero_testBit] at h; exact absurd h (by decide)
  | x :: xs, y, h => by
    rw [orF, Nat.testBit_lor, Bool.or_eq_true, Nat.testBit_two_pow] at h
    rcases h with h | h
    · exact List.mem_cons.2 (Or.inl (of_decide_eq_true h).symm)
    · exact List.mem_cons_of_mem _ (orF_mem h)

def sub1 (m c : ℕ) : Bool := Nat.beq (m ||| 2 ^ c) (2 ^ c)
def sub2 (m c d : ℕ) : Bool := Nat.beq (m ||| (2 ^ c ||| 2 ^ d)) (2 ^ c ||| 2 ^ d)

theorem sub1_sound {m c x : ℕ} (h : sub1 m c = true) (hx : m.testBit x = true) : x = c := by
  have h' : m ||| 2 ^ c = 2 ^ c := beqT h
  have hK : (2 ^ c).testBit x = true := by
    rw [← congrArg (fun z => z.testBit x) h']
    simp only [Nat.testBit_lor, hx, Bool.true_or]
  rw [Nat.testBit_two_pow] at hK
  exact (of_decide_eq_true hK).symm

theorem sub2_sound {m c d x : ℕ} (h : sub2 m c d = true) (hx : m.testBit x = true) :
    x = c ∨ x = d := by
  have h' : m ||| (2 ^ c ||| 2 ^ d) = 2 ^ c ||| 2 ^ d := beqT h
  have hK : (2 ^ c ||| 2 ^ d).testBit x = true := by
    rw [← congrArg (fun z => z.testBit x) h']
    simp only [Nat.testBit_lor, hx, Bool.true_or]
  rw [Nat.testBit_lor, Nat.testBit_two_pow, Nat.testBit_two_pow, Bool.or_eq_true] at hK
  rcases hK with hK | hK
  · exact Or.inl (of_decide_eq_true hK).symm
  · exact Or.inr (of_decide_eq_true hK).symm

/-- row check for the vertex `c`; a row lists every neighbour `d` of `c` with the neighbours of `d` -/
def rowOK (c : ℕ) (r : List (ℕ × List ℕ)) : Bool :=
  Nat.beq (orF (r.map Prod.fst)) (msk c) &&
  r.all (fun q => Nat.beq (orF q.2) (msk q.1)) &&
  r.all (fun q => r.all (fun q' => Nat.beq q.1 q'.1 || sub1 (msk q.1 &&& msk q'.1) c)) &&
  r.all (fun q => !(Nat.blt c q.1) || r.all (fun q' => Nat.beq q'.1 q.1 ||
    q.2.all (fun e => Nat.beq e c || Nat.beq e q'.1 || sub2 (msk q'.1 &&& msk e) c q.1)))

def allOK : ℕ → List (List (ℕ × List ℕ)) → Bool
  | _, [] => true
  | i, r :: rs => rowOK i r && allOK (i + 1) rs

theorem allOK_get : ∀ (i : ℕ) (T : List (List (ℕ × List ℕ))), allOK i T = true →
    ∀ j, j < T.length → rowOK (i + j) (T.getD j []) = true
  | _, [], _, j, hj => by simp at hj
  | i, r :: rs, h, 0, _ => by
    simp only [allOK, Bool.and_eq_true] at h
    simpa using h.1
  | i, r :: rs, h, j + 1, hj => by
    simp only [allOK, Bool.and_eq_true] at h
    have := allOK_get (i + 1) rs h.2 j (by simp only [List.length_cons] at hj; omega)
    rw [show i + (j + 1) = i + 1 + j by omega]
    simpa using this

