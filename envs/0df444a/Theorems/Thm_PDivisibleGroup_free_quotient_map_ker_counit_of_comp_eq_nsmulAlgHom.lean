-- url     : https://prove2.me/theorems/1d78f5c4-4a02-55d7-a9a8-aabb5e30db04
-- title:
--   Kernels of quasi-inverse isogenies: freeness and degree product p^{wh}
-- statement:
--   Let $O$ be a local commutative integral domain, $p$ a prime and $h$ a natural number. Let $L$ and $L'$ be two $\mathbb{N}$-indexed families of commutative rings, each $L v$ and $L' v$ carrying a Hopf algebra structure over $O$ with cocommutative comultiplication and finite free underlying $O$-module. Assume given bialgebra maps $t_v \colon L(v+1) \to L v$ and $t'_v \colon L'(v+1) \to L' v$, all surjective, with $\operatorname{finrank}_O L v = \operatorname{finrank}_O L' v = p^{vh}$ for every $v$, and with $\ker t_v$ equal to the image of the augmentation ideal $\ker(\varepsilon_{L(v+1)})$ under the algebra endomorphism $\operatorname{nsmulAlgHom}$ attached to $p^{v}$ (the $p^{v}$-th convolution power of the identity), and likewise for $t'_v$. Assume further given bialgebra maps $f_v \colon L' v \to L v$ and $g_v \colon L v \to L' v$ commuting with the transition maps, i.e. $f_u \circ t'_u = t_u \circ f_{u+1}$ and $g_u \circ t_u = t'_u \circ g_{u+1}$ for all $u$, and a natural number $w$ such that, at every level $u$, the composite of $g_u$ followed by $f_u$ is the $p^{w}$-th convolution power of the identity on $L u$ and the composite of $f_u$ followed by $g_u$ is the corresponding map on $L' u$. Then for every $v \ge w$: the $O$-module $L v / (f_v(\ker \varepsilon_{L' v}))$ is free, the $O$-module $L' v / (g_v(\ker \varepsilon_{L v}))$ is free, and the product of their $O$-ranks equals $p^{wh}$ (the ideals being the ideals generated by the images of the respective augmentation ideals).
--
--   In the classical language, the two towers are $p$-divisible groups of height $h$ over $O$ in Tate's sense, presented by their coordinate rings, and $f$, $g$ are mutually quasi-inverse isogenies with $g \circ f = p^w$ and $f \circ g = p^w$; the assertion is that the scheme-theoretic kernels of $f_v$ and $g_v$ at any level $v \ge w$ are finite free over $O$ and that their degrees multiply to $p^{wh}$. The proof reduces to the corresponding rank identity over a field, [`PDivisibleGroup.finrank_quotient_map_ker_counit_mul_eq_pow_of_comp_eq_nsmulAlgHom`](thm.html#PDivisibleGroup.finrank_quotient_map_ker_counit_mul_eq_pow_of_comp_eq_nsmulAlgHom), applied to the residue field and the fraction field of $O$; the result feeds into the construction of $p$-divisible towers used in the deformation-theoretic part of the argument.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_PDivisibleGroup_free_quotient_map_ker_counit_of_comp_eq_nsmulAlgHom.lean

import Mathlib
import Definitions.Def_PDivisibleGroup_Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u v w

theorem PDivisibleGroup.free_quotient_map_ker_counit_of_comp_eq_nsmulAlgHom
    (O : Type u) [CommRing O] [IsDomain O] [IsLocalRing O] (p : ℕ) [Fact p.Prime] (h : ℕ)
    (L : ℕ → Type v) [∀ v, CommRing (L v)] [∀ v, HopfAlgebra O (L v)]
    [∀ v, Coalgebra.IsCocomm O (L v)] [∀ v, Module.Free O (L v)] [∀ v, Module.Finite O (L v)]
    (t : ∀ v, L (v + 1) →ₐc[O] L v) (ht : ∀ v, Function.Surjective (t v))
    (hrankL : ∀ v, Module.finrank O (L v) = p ^ (v * h))
    (hkerL : ∀ v, RingHom.ker (t v) = PDivisibleGroup.Hopf.torsionIdeal O (L (v + 1)) (p ^ v))
    (L' : ℕ → Type w) [∀ v, CommRing (L' v)] [∀ v, HopfAlgebra O (L' v)]
    [∀ v, Coalgebra.IsCocomm O (L' v)] [∀ v, Module.Free O (L' v)] [∀ v, Module.Finite O (L' v)]
    (t' : ∀ v, L' (v + 1) →ₐc[O] L' v) (ht' : ∀ v, Function.Surjective (t' v))
    (hrankL' : ∀ v, Module.finrank O (L' v) = p ^ (v * h))
    (hkerL' : ∀ v, RingHom.ker (t' v) = PDivisibleGroup.Hopf.torsionIdeal O (L' (v + 1)) (p ^ v))
    (f : ∀ v, L' v →ₐc[O] L v) (hf : ∀ u, (f u).comp (t' u) = (t u).comp (f (u + 1)))
    (g : ∀ v, L v →ₐc[O] L' v) (hg : ∀ u, (g u).comp (t u) = (t' u).comp (g (u + 1)))
    (w : ℕ)
    (hgf : ∀ u, (f u : L' u →ₐ[O] L u).comp (g u : L u →ₐ[O] L' u) =
      PDivisibleGroup.Hopf.nsmulAlgHom O (L u) (p ^ w))
    (hfg : ∀ u, (g u : L u →ₐ[O] L' u).comp (f u : L' u →ₐ[O] L u) =
      PDivisibleGroup.Hopf.nsmulAlgHom O (L' u) (p ^ w))
    (v : ℕ) (hv : w ≤ v) :
    Module.Free O (L v ⧸ Ideal.map (f v : L' v →ₐ[O] L v)
        (RingHom.ker (Bialgebra.counitAlgHom O (L' v)))) ∧
    Module.Free O (L' v ⧸ Ideal.map (g v : L v →ₐ[O] L' v)
        (RingHom.ker (Bialgebra.counitAlgHom O (L v)))) ∧
    Module.finrank O (L v ⧸ Ideal.map (f v : L' v →ₐ[O] L v)
        (RingHom.ker (Bialgebra.counitAlgHom O (L' v)))) *
      Module.finrank O (L' v ⧸ Ideal.map (g v : L v →ₐ[O] L' v)
        (RingHom.ker (Bialgebra.counitAlgHom O (L v)))) = p ^ (w * h) := by sorry
