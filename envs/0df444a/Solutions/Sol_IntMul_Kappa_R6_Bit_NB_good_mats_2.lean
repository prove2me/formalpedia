-- Source module: Solutions.R6BitNBPrime
/-!
# Round six, bit network: good primes

Finitely many rationals have denominators coprime to every power of every prime `q > q₀`, and the
nonzero ones are units mod `q ^ f`. Consequently a finite set of edges with `EdgeQ` data
is `EdgeOK (q ^ f)` for all large primes `q` and all `f`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset AModelFac

/-- Good primes for a finite set of rationals. -/
theorem good_rats (L : Finset ℚ) : ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f : ℕ, ∀ r ∈ L,
    Nat.Coprime r.den (q ^ f) ∧ (r ≠ 0 → IsUnit (redQ (q ^ f) r)) := by
  refine ⟨∑ r ∈ L, (r.den + r.num.natAbs), fun q hq hlt f r hr => ?_⟩
  have hle : r.den + r.num.natAbs ≤ ∑ r ∈ L, (r.den + r.num.natAbs) :=
    Finset.single_le_sum (f := fun r : ℚ => r.den + r.num.natAbs) (fun _ _ => Nat.zero_le _) hr
  have hd : Nat.Coprime r.den (q ^ f) :=
    Nat.Coprime.pow_right f (coprime_of_lt hq (Rat.den_pos _) (by omega))
  refine ⟨hd, fun hr0 => isUnit_redQ hd ?_⟩
  exact Nat.Coprime.pow_right f
    (coprime_of_lt hq (Int.natAbs_pos.2 (Rat.num_ne_zero.2 hr0)) (by omega))

lemma mem_entriesOf {ι κ : Type*} [Fintype ι] [Fintype κ] {S : Finset (Matrix ι κ ℚ)} {A : Matrix ι κ ℚ}
    (hA : A ∈ S) (i : ι) (j : κ) : A i j ∈ entriesOf S := by
  classical
  simp only [entriesOf, Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ, true_and]
  exact ⟨A, hA, (i, j), rfl⟩

/-- Good primes for finitely many rational matrices: all denominators coprime to `q ^ f`. -/
theorem good_mats_sol_aux {ι κ : Type*} [Fintype ι] [Fintype κ] (S : Finset (Matrix ι κ ℚ)) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f : ℕ, ∀ A ∈ S, ∀ i j,
      Nat.Coprime (A i j).den (q ^ f) ∧ (A i j ≠ 0 → IsUnit (redQ (q ^ f) (A i j))) := by
  obtain ⟨q₀, hq⟩ := good_rats (entriesOf S)
  exact ⟨q₀, fun q hp hlt f A hA i j => hq q hp hlt f _ (mem_entriesOf hA i j)⟩

end IntMul.Kappa.R6.Bit.NB

end

