section
-- Source module: NLogN.HCrChirpMath
/-!
# Pure facts for the chirp table (namespace `NLogN.CR`)

* `unrk_snoc`, `wsum_snoc`: peeling the last axis of a row-major index.
* `axIt`: one step of the per-axis accumulation loop; `axIt_iter`: `n` steps over `n` equal axes.
* `chirpKey`: the chirp index mod `2r` of row-major position `q`; `chirpL_eq`.
* `scanF`: the merge scan over the sorted table/request records; `scanF_sorted`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul IntMul.HvdH IntMul.HvdH.Ref

/-! ## Row-major indices: the last axis -/

/-- `∑ᵢ uᵢ · jᵢ²` for the box index `j` of row-major position `q`. -/
def wsum (ts : List ℕ) (u : ℕ → ℕ) (q : ℕ) : ℕ :=
  ((List.range ts.length).map fun i => u i * unrk ts q i ^ 2).sum

/-! ## The accumulation loop over equal axes -/

/-- One step: add `u · (x mod t)²` to the accumulator (mod `M`), divide `x` by `t`. -/
def axIt (t u M : ℕ) (z : ℕ × ℕ) : ℕ × ℕ := ((z.1 + u * (z.2 % t) ^ 2) % M, z.2 / t)

/-! ## The chirp index -/

/-- The weights `r / tᵢ`. -/
def uW (q : Params) (i : ℕ) : ℕ := q.r / 2 ^ q.te i

/-- The key of the chirp entry at row-major position `x`: the chirp index mod `2r`. -/
def chirpKey (q : Params) (x : ℕ) : ℕ := wsum q.tdims (uW q) x % (2 * q.r)

/-! ## The merge scan -/

/-- Table record `[2c, re, im]`. -/
def tabRec (v : ℕ → ℤ × ℤ) (c : ℕ) : List ℤ := [2 * (c : ℤ), (v c).1, (v c).2]

/-- Request record `[2κ(x)+1, x, 0]`. -/
def reqRec (κ : ℕ → ℕ) (x : ℕ) : List ℤ := [2 * (κ x : ℤ) + 1, x, 0]

/-- The scan: a table record sets the current value, a request emits `(x, current)`. -/
def scanF (cur : ℤ × ℤ) : List (List ℤ) → List (ℤ × (ℤ × ℤ))
  | [] => []
  | r :: Z => if r.headD 0 % 2 = 1 then (r.getD 1 0, cur) :: scanF cur Z
      else scanF (r.getD 1 0, r.getD 2 0) Z

/-- The current value after scanning. -/
def curF (cur : ℤ × ℤ) : List (List ℤ) → ℤ × ℤ
  | [] => cur
  | r :: Z => if r.headD 0 % 2 = 1 then curF cur Z else curF (r.getD 1 0, r.getD 2 0) Z

/-- The request indices of `Z`, in order. -/
def reqXs (Z : List (List ℤ)) : List ℕ :=
  (Z.filter fun r => r.headD 0 % 2 = 1).map fun r => (r.getD 1 0).toNat

def IsRec (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (r : List ℤ) : Prop :=
  (∃ c, r = tabRec v c) ∨ (∃ x, r = reqRec κ x)

/-- Every request finds its table entry in the rest, or it is the current value and every
remaining table entry comes later. -/
def Good (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (cur : ℤ × ℤ) (Z : List (List ℤ)) : Prop :=
  ∀ x, reqRec κ x ∈ Z → tabRec v (κ x) ∈ Z ∨ (cur = v (κ x) ∧ ∀ c, tabRec v c ∈ Z → κ x < c)

/-! ## Gathering through the sorted merge -/

/-- All table records `c < R` followed by all requests `x < T`. -/
def mergeL (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) : List (List ℤ) :=
  (List.range R).map (tabRec v) ++ (List.range T).map (reqRec κ)

end NLogN.CR

end

section
-- Source module: NLogN.HCrChirp
/-!
# The chirp table program, part 1: the request keys (namespace `NLogN.CR`)

Registers (inputs, read only): `hM2` = `2r`, `hRr` = `r`, `hRh` = `r/2`, `hNa` = `K - dh`,
`hNb` = `dh`, `hTT` = `T`.  Scratch: `hQ`, `hI`, `hXq`, `hAc`.

`reqGen` pushes onto stack `0` the request records `[2·chirpKey x + 1, x, 0]` for `x < T`
(record `0` on top).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

abbrev hI : Fin HS := 11
abbrev hXq : Fin HS := 12
abbrev hAc : Fin HS := 13

/-! ## One axis step -/

def fE (t : Fin HS) : Ex HS := .rem (.reg hXq) (.reg t)

def axE (t : Fin HS) (u : ℤ) : Ex HS :=
  .rem (.add (.reg hAc) (.mul (.lit u) (.mul (fE t) (fE t)))) (.reg hM2)

def axStep (t : Fin HS) (u : ℤ) : RS :=
  NLogN.RS.seq (asg hAc (axE t u)) (asg hXq (.quo (.reg hXq) (.reg t)))

def axLoop (t : Fin HS) (u : ℤ) (cnt : Fin HS) : RS := rep NLogN.CR.hI (.reg cnt) (axStep t u)

def axSt (s : IState HS) (LA LX : List Item) (z : ℕ × ℕ) : IState HS :=
  (s.upd hAc (.int z.1 :: LA)).upd hXq (.int z.2 :: LX)

/-! ## One request record -/

def reqBody : RS :=
  NLogN.RS.seq (push hXq (.add (.reg hQ) (.lit (-1))))
  (NLogN.RS.seq (push hAc (.lit 0))
  (NLogN.RS.seq (axLoop hRr 1 hNa)
  (NLogN.RS.seq (axLoop hRh 2 hNb)
  (NLogN.RS.seq (push 0 (.lit 0))
  (NLogN.RS.seq (push 0 (.add (.reg hQ) (.lit (-1))))
  (NLogN.RS.seq (push 0 (.add (.add (.reg hAc) (.reg hAc)) (.lit 1)))
  (NLogN.RS.seq (pop hAc) (pop hXq))))))))

/-- The register contents the chirp programs read. -/
structure ChirpRegs (q : Params) (w : IState HS) : Prop where
  m2 : ∃ L, w.G hM2 = .int ((2 ^ (q.e + 1) : ℕ) : ℤ) :: L
  rr : ∃ L, w.G hRr = .int ((2 ^ q.e : ℕ) : ℤ) :: L
  rh : ∃ L, w.G hRh = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L
  na : ∃ L, w.G hNa = .int ((q.K - q.dh : ℕ) : ℤ) :: L
  nb : ∃ L, w.G hNb = .int (q.dh : ℤ) :: L
  tt : ∃ L, w.G hTT = .int (q.tdims.prod : ℤ) :: L

/-! ## All request records -/

def reqGen : RS := rep hQ (.reg hTT) reqBody

/-- The last `k` request records (record `T - k` first). -/
def reqTail (κ : ℕ → ℕ) (T k : ℕ) : List (List ℤ) :=
  (List.range k).map fun j => reqRec κ (T - k + j)

end NLogN.CR

end

section
-- Source module: NLogN.HCrChirp2
/-!
# The chirp table program, part 2: the twiddle table (namespace `NLogN.CR`)

The twiddle program `tw` is abstract (`TwSpec`): from `c < R` on `hC`, `p` on `hPp` and `R` on
`hM2` it pushes `(twD p R c).1` onto `hVA` and `(twD p R c).2` onto `hVB`, and nothing else.
`tabGen tw` pushes the table records `[2c, re, im]` for `c < R` (record `0` on top).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

abbrev hC : Fin HS := 14
abbrev hVA : Fin HS := 15
abbrev hVB : Fin HS := 16

/-- The abstract twiddle program (relocated by the caller): it reads `c` on `hC`, `p` on `hPp`
and `R` on `hM2`, pushes `twD p R c` onto `hVA`, `hVB`, does not write the loop counter `hQ`,
and costs at most `Ctw`. -/
def TwSpec (M : MulSpec) (tw : RM) (p R Ctw : ℕ) : Prop :=
  hQ ∉ tw.writes ∧ ∀ (t : IState HS) (c : ℕ) (L LP LM : List Item), t.G hC = .int c :: L →
    t.G hPp = .int p :: LP → t.G hM2 = .int R :: LM → c < R →
    tw.ok M t ∧ tw.run t = (t.upd hVA (.int (twD p R c).1 :: t.G hVA)).upd hVB
      (.int (twD p R c).2 :: t.G hVB) ∧ tw.cost M t ≤ Ctw

def tabPush : RS :=
  NLogN.RS.seq (push 0 (.reg hVB)) (NLogN.RS.seq (push 0 (.reg hVA)) (NLogN.RS.seq (push 0 (.add (.reg hC) (.reg hC)))
    (NLogN.RS.seq (pop hVA) (NLogN.RS.seq (pop hVB) (pop hC)))))

def tabBody (tw : RM) : RM :=
  .seq (.rs (push hC (.add (.reg hQ) (.lit (-1))))) (.seq tw (.rs tabPush))

def tabGen (tw : RM) : RM := .rep hQ (.reg hM2) (tabBody tw)

/-- The last `k` table records (record `R - k` first). -/
def tabTail (v : ℕ → ℤ × ℤ) (R k : ℕ) : List (List ℤ) :=
  (List.range k).map fun j => tabRec v (R - k + j)

end NLogN.CR

end

section
-- Source module: NLogN.HCrChirp3
/-!
# The chirp table program, part 3: the merge scan (namespace `NLogN.CR`)

`scanLoop` consumes `n` (on stack `1`) records `[k, a, b]` from stack `0`: a record with even
key sets the current value `(a, b)` (registers `hCa`, `hCb`); a record with odd key emits the
current value onto `hOut` and `a` onto `hKs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

abbrev hK : Fin HS := 18
abbrev hXx : Fin HS := 19
abbrev hYy : Fin HS := 21
abbrev hCa : Fin HS := 22
abbrev hCb : Fin HS := 23
abbrev hOut : Fin HS := 24
abbrev hKs : Fin HS := 25

def parE : Ex HS := .neg (.rem (.reg NLogN.CR.hK) (.lit 2))

def emitP : RS := NLogN.RS.seq (push hOut (.reg hCa)) (NLogN.RS.seq (push hOut (.reg hCb)) (push hKs (.reg hXx)))

def setP : RS := NLogN.RS.seq (asg hCa (.reg hXx)) (asg hCb (.reg hYy))

def scanPre : RS :=
  NLogN.RS.seq (push NLogN.CR.hK (.reg 0)) (NLogN.RS.seq (pop 0) (NLogN.RS.seq (push hXx (.reg 0)) (NLogN.RS.seq (pop 0)
  (NLogN.RS.seq (push hYy (.reg 0)) (pop 0)))))

def scanPost : RS := NLogN.RS.seq (pop NLogN.CR.hK) (NLogN.RS.seq (pop hXx) (pop hYy))

def scanBody : RS := NLogN.RS.seq scanPre (NLogN.RS.seq (ite parE emitP setP) scanPost)

def scanLoop : RS := rep hQ (.reg 1) scanBody

/-! ## The scan loop -/

def outRev (E : List (ℤ × (ℤ × ℤ))) : List ℤ := ((E.map fun e => [e.2.1, e.2.2]).flatten).reverse

def keysRev (E : List (ℤ × (ℤ × ℤ))) : List ℤ := (E.map Prod.fst).reverse

/-- A record `[k, a, b]` with `k ≥ 0`. -/
def Rec3 (r : List ℤ) : Prop := ∃ k a b : ℤ, r = [k, a, b] ∧ 0 ≤ k

def scSt (s : IState HS) (Z : List (List ℤ)) (Rst : List Item) (cur0 : ℤ × ℤ) (LA LB : List Item)
    (k : ℕ) : IState HS :=
  ((((s.upd 0 (ints (Z.drop k).flatten ++ Rst)).upd hCa (.int (curF cur0 (Z.take k)).1 :: LA)).upd
    hCb (.int (curF cur0 (Z.take k)).2 :: LB)).upd hOut
    (ints (outRev (scanF cur0 (Z.take k))) ++ s.G hOut)).upd hKs
    (ints (keysRev (scanF cur0 (Z.take k))) ++ s.G hKs)

end NLogN.CR

end

section
-- Source module: NLogN.HCrChirp4
/-!
# The chirp table program, part 4: sort, scan, gather (namespace `NLogN.CR`)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

/-- Sort the merged records, scan them, and gather the emitted values by the request indices. -/
def chirpTail : RS :=
  NLogN.RS.seq (push 1 (.add (.reg hM2) (.reg hTT)))
  (NLogN.RS.seq (sortP 3)
  (NLogN.RS.seq (push hCa (.lit 0)) (NLogN.RS.seq (push hCb (.lit 0))
  (NLogN.RS.seq scanLoop
  (NLogN.RS.seq (pop hCa) (NLogN.RS.seq (pop hCb) (NLogN.RS.seq (pop 1)
  (NLogN.RS.seq (mvK hOut 0 NLogN.CR.hI (.add (.reg hTT) (.reg hTT)))
  (NLogN.RS.seq (mvK hKs 3 NLogN.CR.hI (.reg hTT))
  (NLogN.RS.seq (push 1 (.reg hTT))
  (NLogN.RS.seq (permP 2)
  (NLogN.RS.seq (pop 1)
  (dropN 3 NLogN.CR.hI (.reg hTT))))))))))))))

/-! ## The whole chirp table -/

/-- **The chirp table.**  Requests, twiddle table, sort, scan, gather. -/
def chirpP (tw : RM) : RM := .seq (.rs reqGen) (.seq (tabGen tw) (.rs chirpTail))

end NLogN.CR

end

section
-- Source module: NLogN.HCrChirpCost
/-!
# Costs of the chirp table program (namespace `NLogN.CR`)

`QB B p s`: every expression of the loop-free program `p` evaluated from `s` has all
intermediate values of at most `B` bits; then `p.cost s ≤ qsz p · 10^8 · (B + 2)^2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

def QB (B : ℕ) : RS → IState HS → Prop
  | .skip, _ => True
  | .asg i e, s => e.Bnd s B ∧ zsz (s.top i) ≤ B
  | .push _ e, s => e.Bnd s B
  | .pop i, s => zsz (s.top i) ≤ B
  | .seq a b, s => QB B a s ∧ QB B b (a.run s)
  | .ite c a b, s => c.Bnd s B ∧ (if c.eval s < 0 then QB B a s else QB B b s)
  | .rep _ _ _, _ => False

def qsz : RS → ℕ
  | .skip => 1
  | .asg _ e | .push _ e => e.size + 1
  | .pop _ => 1
  | .seq a b => qsz a + qsz b
  | .ite c a b => c.size + 1 + qsz a + qsz b
  | .rep _ _ _ => 0

/-! ## The axis step and loop -/

/-! ## One request record -/

def reqPost : RS := NLogN.RS.seq (push 0 (.lit 0)) (NLogN.RS.seq (push 0 (.add (.reg hQ) (.lit (-1))))
  (NLogN.RS.seq (push 0 (.add (.add (.reg hAc) (.reg hAc)) (.lit 1))) (NLogN.RS.seq (pop hAc) (pop hXq))))

/-- The bit bound used for all register values of the chirp programs. -/
def ChirpB (q : Params) (B : ℕ) : Prop := 4 * (q.r * q.r) + 4 * q.r + q.tdims.prod + q.K + 8 < 2 ^ B

/-! ## The twiddle table -/

/-- All table values have at most `B` bits. -/
def TwB (p R B : ℕ) : Prop := ∀ c < R, zsz (twD p R c).1 ≤ B ∧ zsz (twD p R c).2 ≤ B

/-! ## The scan -/

/-! ## Sort, scan, gather -/

/-! ## The whole chirp table -/

end NLogN.CR

end

section
-- Source module: NLogN.HCrPar6
/-!
# Parameter computation, part 6: cost of stage D and of `parP` (namespace `NLogN.CR`)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

def bndA (K N nb : ℕ) : ℕ := 16 * N + 4 * nb + 4 * K + 16
def bndB (K N : ℕ) : ℕ :=
  2 ^ ((mkParams K N).b + 1) + 4 * 2 ^ (mkParams K N).e * (mkParams K N).P +
    (mkParams K N).b * (mkParams K N).b + 2 * (mkParams K N).b + 1
def bndC (K N : ℕ) : ℕ :=
  2 * (facN K).factorial * facN K + 8 * K * copQ K (2 ^ (mkParams K N).e) +
    4 * K * 2 ^ (mkParams K N).e + 8 * K + 8
def bndD (K N : ℕ) : ℕ :=
  K + (mkParams K N).dh + m1V K (2 ^ (mkParams K N).e) + m2V K (2 ^ (mkParams K N).e) +
    copQ K (2 ^ (mkParams K N).e) * m1V K (2 ^ (mkParams K N).e) +
    copQ K (2 ^ (mkParams K N).e) * m2V K (2 ^ (mkParams K N).e) +
    copQ K (2 ^ (mkParams K N).e) + 3 * (copS K (mkParams K N).dh (2 ^ (mkParams K N).e)).prod + 2

/-- The bit bound for `parP`: every value computed has at most `B` bits when `parBnd K N nb < 2^B`.
With `q = mkParams K N`, `r = 2^q.e`: `parBnd = O(N + 2^e·P + (256K²)!·K²·(r+1) + q.S)`. -/
def parBnd (K N nb : ℕ) : ℕ := bndA K N nb + bndB K N + bndC K N + bndD K N

/-! ## Register contents after `parP` -/

end NLogN.CR

end

section
-- Source module: NLogN.HNumAtan
/-!
# `atanInv` / `atanhInv` as a register program

Inputs `N` on register `0`, `K` on register `1`; the result is pushed on register `2`.
Scratch registers `40 … 45`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

/-- The loop invariant, relative to the state `s0` before the pushes. -/
def atanInv' (x N K : ℕ) (σ : ℤ) (s0 : IState HS) (k : ℕ) (t : IState HS) : Prop :=
  t.G 40 = .int (atanSum x N σ k) :: s0.G 40 ∧
  t.G 41 = .int ((x : ℤ) ^ (2 * k + 1)) :: s0.G 41 ∧
  t.G 42 = .int k :: s0.G 42 ∧
  t.G 43 = .int (σ ^ k) :: s0.G 43 ∧
  t.G 44 = .int (2 ^ N) :: s0.G 44 ∧
  t.G 45 = .int ((K : ℤ) - k) :: s0.G 45 ∧
  ∀ j : Fin HS, j.val < 40 ∨ 45 < j.val → t.G j = s0.G j

def atanBody (x : ℕ) (σ : ℤ) : RS :=
  NLogN.RS.seqL [
      asg 40 (.add (.reg 40) (.mul (.reg 43) (.ndiv (.reg 44)
        (.mul (.add (.add (.reg 42) (.reg 42)) (.lit 1)) (.reg 41))))),
      asg 41 (.mul (.reg 41) (.lit ((x : ℤ) * x))),
      asg 42 (.add (.reg 42) (.lit 1)),
      asg 43 (.mul (.reg 43) (.lit σ))]

def atanPre : RS :=
  NLogN.RS.seqL [push 40 (.lit 0), push 41 (.lit 0), push 42 (.lit 0), push 43 (.lit 1),
    push 44 (.pow2 (.reg 0))]

def atanPost : RS := NLogN.RS.seqL [push 2 (.reg 40), pop 44, pop 43, pop 42, pop 41, pop 40]

/-- `Σ_{k<K} σ^k ⌊2^N / ((2k+1) x^{2k+1})⌋`, for `N` on register `0` and `K` on register `1`,
pushed on register `2`. -/
def atanP (x : ℕ) (σ : ℤ) : RS :=
  NLogN.RS.seq (NLogN.RS.seq atanPre (asg 41 (.lit x))) (NLogN.RS.seq (NLogN.RS.rep 45 (.reg 1) (atanBody x σ)) atanPost)

end NLogN

namespace NLogN
open IntMul RS

/-- The size parameter of `atanP`. -/
def atanB (x N K : ℕ) : ℕ := N + (2 * K + 3) * (x + 1) + 2

def atanM (x N K : ℕ) : ℕ := 2 ^ N * (2 * K + 3) * x ^ (2 * K + 3)

end NLogN

end

