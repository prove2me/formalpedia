-- Source module: Solutions.J6SegAxis11
/-!
# B-line axis program (`AxisU6`), part 11: **`axisU6_of`**

`AxisU6 P tab` for every table with the facts of `LineNeed6` (`SwapNeedτ`, `RowUCP`, `FineU6`),
from
* `PreNeed6 P ap.pl` (B5: the kernel-pass set-ups),
* `SlabNeed6 P` (B1: the slab set-ups — source-table producers and `ctlB`),
* `AxBudget6 P ap` (S2: plan constants and the closed-form cost),
* the plan conditions `ValCond6 ap` (value bounds, `valNeed6_all'`) and `ChunkPlan6 ap` (chunk
  output, `chunkOut6_all`); the chunk table bound is `chunkTabBnd6_all`.

The family: `FineU6`'s, `PreU6`'s and `SlabNeed6`'s procedures, then the chunk kernel
`chunkI pMul`, the `J` kernel `jKprog`, and the axis body `axBody` (descriptor stack `8`,
kernel registers `ρK dF`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab (passP drP rdP itO bkP)

/-- The machine's own procedures: the chunk kernel, the `J` kernel, the axis body. -/
def ownV (nF nP nS : ℕ) (eF eB : Fin nF) (eC eCd eJ eJd : Fin nP)
    (e1u e1d e3u e3d e5u e5d e7u e7d : Fin nS) (dF : Fin HS) (E : ℕ)
    (idx : Fin (nF + (nP + nS) + 3) → Fin (7 + E)) (i : Fin 3) : IStmt HS (7 + E) :=
  let iF : Fin nF → Fin (7 + E) := fun j => idx (Fin.castAdd 3 (Fin.castAdd (nP + nS) j))
  let iP : Fin nP → Fin (7 + E) := fun j =>
    idx (Fin.castAdd 3 (Fin.natAdd nF (Fin.castAdd nS j)))
  let iS : Fin nS → Fin (7 + E) := fun j =>
    idx (Fin.castAdd 3 (Fin.natAdd nF (Fin.natAdd nP j)))
  let pM := NLogN.KFM.pMul E
  if i.val = 0 then KR.chunkI2 pM
  else if i.val = 1 then JK.jKprog.code pM (fun _ => pM)
  else axBody dAx dF (ρK dF) (iF eF) (iF eB) (idx (Fin.natAdd _ 0)) (idx (Fin.natAdd _ 1))
    (iP eC) (iP eCd) (iP eJ) (iP eJd) pM (.call (iS e1u)) (.call (iS e1d)) (.call (iS e3u))
    (.call (iS e3d)) (.call (iS e5u)) (.call (iS e5d)) (.call (iS e7u)) (.call (iS e7d))

end J6Seg.Ax

end

end

