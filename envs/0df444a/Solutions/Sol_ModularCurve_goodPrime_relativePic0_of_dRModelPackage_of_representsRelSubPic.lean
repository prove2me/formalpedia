set_option autoImplicit false

namespace L3GProof
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra GoodReductionJacobian

universe u

variable {R : Type u} [CommRing R] {S : Type u} [CommRing S] [Algebra R S]
  {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}

local notation "bRS" => Spec.map (CommRingCat.ofHom (algebraMap R S))

noncomputable def ptDown {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of S)}
    (x : SchemeHomOver t (pullback.snd f bRS)) : SchemeHomOver (t ≫ bRS) f :=
  ⟨x.1 ≫ pullback.fst f bRS, by rw [Category.assoc, pullback.condition, ← Category.assoc, x.2]⟩

noncomputable def ptUp {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S))
    (X : SchemeHomOver (t ≫ bRS) f) : SchemeHomOver t (pullback.snd f bRS) :=
  ⟨pullback.lift X.1 t X.2, pullback.lift_snd _ _ _⟩

@[scoped simp] theorem ptDown_val {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of S)}
    (x : SchemeHomOver t (pullback.snd f bRS)) : (ptDown x).1 = x.1 ≫ pullback.fst f bRS := rfl

@[scoped simp] theorem ptUp_val_fst {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S))
    (X : SchemeHomOver (t ≫ bRS) f) : (ptUp t X).1 ≫ pullback.fst f bRS = X.1 := pullback.lift_fst _ _ _

theorem ptDown_ptUp {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (X : SchemeHomOver (t ≫ bRS) f) :
    ptDown (ptUp t X) = X := Subtype.ext (ptUp_val_fst t X)

theorem ptUp_ptDown {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of S)} (x : SchemeHomOver t (pullback.snd f bRS)) :
    ptUp t (ptDown x) = x := by
  apply Subtype.ext
  apply pullback.hom_ext
  · exact pullback.lift_fst _ _ _
  · change pullback.lift _ t _ ≫ _ = _
    rw [pullback.lift_snd]; exact x.2.symm

theorem ptDown_injective {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of S)} :
    Function.Injective (ptDown (f := f) (t := t)) := fun x y h => by
  rw [← ptUp_ptDown x, ← ptUp_ptDown y, h]

noncomputable def baseChangeLaw (L : RelativeGroupLaw R f) : RelativeGroupLaw S (pullback.snd f bRS) where
  mul t x y := ptUp t (L.mul _ (ptDown x) (ptDown y))
  one t := ptUp t (L.one _)
  inv t x := ptUp t (L.inv _ (ptDown x))
  mul_assoc t x y z := by
    apply ptDown_injective; simp only [ptDown_ptUp]; exact L.mul_assoc _ _ _ _
  one_mul t x := by
    apply ptDown_injective; simp only [ptDown_ptUp]; exact L.one_mul _ _
  mul_one t x := by
    apply ptDown_injective; simp only [ptDown_ptUp]; exact L.mul_one _ _
  inv_mul_cancel t x := by
    apply ptDown_injective; simp only [ptDown_ptUp]; exact L.inv_mul_cancel _ _
  mul_natural t t' ψ hψ x y := by
    apply ptDown_injective

    have h1 : ∀ z : SchemeHomOver t (pullback.snd f bRS),
        ptDown (GoodReductionJacobian.schemeHomOverComp ψ hψ z) = GoodReductionJacobian.schemeHomOverComp ψ (by rw [← Category.assoc, hψ]) (ptDown z) := by
      intro z; apply Subtype.ext; simp [ptDown, GoodReductionJacobian.schemeHomOverComp]
    rw [h1, ptDown_ptUp, ptDown_ptUp, L.mul_natural, h1, h1]

theorem baseChangeLaw_mul_fst (L : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S))
    (x y : SchemeHomOver t (pullback.snd f bRS)) :
    ((baseChangeLaw L).mul t x y).1 ≫ pullback.fst f bRS = (L.mul _ (ptDown x) (ptDown y)).1 :=
  ptUp_val_fst t _

theorem baseChangeLaw_isCommutative (L : RelativeGroupLaw R f) (hc : L.IsCommutative) :
    (baseChangeLaw (S := S) L).IsCommutative := by
  intro T t x y
  apply ptDown_injective
  change ptDown (ptUp t _) = ptDown (ptUp t _)
  rw [ptDown_ptUp, ptDown_ptUp]
  exact hc _ _ _

end L3GProof
