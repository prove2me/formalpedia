      χ (xOverZ W) = a ∧ χ (yOverZ W) = b := by
  subst e
  simp only [eqToHom_refl, Category.id_comp] at hSS'
  obtain ⟨χ', hχ', hx, hy⟩ := hS'
  obtain ⟨α, hα, hαx, hαy⟩ :=
    WeierstrassCurve.DrinfeldGlobal.exists_zChartIota_comp_projMap_eq_specMap_comp_zChartIota W f φ hφ hcoef
  refine ⟨χ'.comp α, ?_, by simp [hαx, affX, ← hx], by simp [hαy, affY, ← hy]⟩
  rw [← hSS', show S'.1 = _ from hχ', Category.assoc, hα, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]

