/-! ## List sums -/

lemma sum_flatMap {α β : Type*} [AddCommMonoid β] (l : List α) (f : α → List β) :
    (l.flatMap f).sum = (l.map fun a => (f a).sum).sum := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [List.flatMap_cons, List.sum_append, ih]

lemma sum_range_single {β : Type*} [AddCommMonoid β] (f : ℕ → β) {S : ℕ} :
    ∀ n, S < n → (∀ i < n, i ≠ S → f i = 0) → ((List.range n).map f).sum = f S
  | 0, h, _ => absurd h (Nat.not_lt_zero _)
  | n + 1, h, hz => by
    rw [List.range_succ, List.map_append, List.sum_append]
    by_cases e : S = n
    · subst e
      rw [List.sum_eq_zero, zero_add]
      · simp
      · intro x hx
        obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hx
        have := List.mem_range.1 hi
        exact hz i (by omega) (by omega)
    · rw [sum_range_single f n (by omega) (fun i hi hne => hz i (by omega) hne)]
      simp [hz n (by omega) (Ne.symm e)]

lemma sum_zero_of {β : Type*} [AddCommMonoid β] {α : Type*} (l : List α) (f : α → β)
    (h : ∀ a ∈ l, f a = 0) : (l.map f).sum = 0 :=
  List.sum_eq_zero fun x hx => by obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hx; exact h a ha

/-! ## Wires -/

lemma aw_inj {q q' : ℕ} (h : aw q = aw q') : q = q' := by simp only [aw_eq] at h; omega
lemma yw_inj {S S' : ℕ} (h : yw S = yw S') : S = S' := by simp only [yw_eq] at h; omega
lemma mw_inj {j j' : ℕ} (h : mw j = mw j') : j = j' := by simp only [mw_eq] at h; omega
lemma aw_ne_yw {q S : ℕ} (hS : S < NV) : aw q ≠ yw S := by simp only [aw_eq, yw_eq]; omega
lemma aw_ne_xw {q t : ℕ} (ht : t < NV) : aw q ≠ xw t := by simp only [aw_eq, xw]; omega
lemma yw_ne_xw {S t : ℕ} (ht : t < NV) : yw S ≠ xw t := by simp only [yw_eq, xw]; omega
lemma mw_ne_yw {j S : ℕ} (hS : S < NV) : mw j ≠ yw S := by simp only [mw_eq, yw_eq, NR]; omega
lemma mw_ne_xw {j t : ℕ} (ht : t < NV) : mw j ≠ xw t := by simp only [mw_eq, xw, NR]; omega
lemma aw_ne_mw {q j : ℕ} (hq : q < NR) : aw q ≠ mw j := by simp only [aw_eq, mw_eq]; omega

/-! ## Placement -/

lemma place_apply (src : ℕ → ℕ) : ∀ n q t, place src n q t = if t < n ∧ src t = q then 1 else 0
  | 0, q, t => by simp [place]
  | n + 1, q, t => by
    simp only [place]
    by_cases e : q = src n
    · subst e
      rw [Function.update_self]
      simp only [Pi.add_apply, place_apply src n]
      by_cases ht : t = n
      · subst ht; simp
      · split_ifs <;> omega
    · rw [Function.update_of_ne e, place_apply src n]
      by_cases ht : t = n
      · subst ht; simp [Ne.symm e]
      · split_ifs <;> omega

/-! ## Gate ops on coefficient vectors -/

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

lemma Lops_eq (gs : List Gate) : Lops gs = slotOps (gs.flatMap gq) := by
  unfold Lops slotOps
  rw [List.map_flatMap]
  congr 1; funext g; exact gops_eq g

/-- **Coefficient form of the gate run**: if `a_q = ∑_i C q i • X i` on the slots `< NR`, then after
the slot ops (slots `< NR`) `a_q = ∑_i (runP ops C) q i • X i`. -/
theorem runL_slots (I : Finset ℕ) (X : ℕ → Vt) :
    ∀ (l : List (ℕ × ℕ)) (Λ : ℕ → Vt) (C : ℕ → ℕ → ℕ), (∀ o ∈ l, o.1 < NR ∧ o.2 < NR) →
      (∀ q < NR, Λ (aw q) = ∑ i ∈ I, (C q i : ℂ) • X i) →
      ∀ q < NR, runL (slotOps l) Λ (aw q) = ∑ i ∈ I, (runP l C q i : ℂ) • X i
  | [], Λ, C, _, h, q, hq => h q hq
  | o :: l, Λ, C, hl, h, q, hq => by
    have h0 := hl o List.mem_cons_self
    show runL (slotOps l) (stepL Λ (aw o.1, aw o.2, 2)) (aw q) = ∑ i ∈ I, (runP l _ q i : ℂ) • X i
    refine runL_slots I X l _ _ (fun o' h' => hl o' (List.mem_cons_of_mem _ h')) (fun q' hq' => ?_) q hq
    simp only [stepL, cf]
    by_cases e : q' = o.1
    · subst e
      rw [Function.update_self, Function.update_self, h _ hq', h _ h0.2]
      simp only [Int.cast_ofNat, div_self (two_ne_zero : (2 : ℂ) ≠ 0), one_smul, ← Finset.sum_add_distrib,
        Pi.add_apply, Nat.cast_add, add_smul]
    · rw [Function.update_of_ne (fun h' => e (aw_inj h')), Function.update_of_ne e, h _ hq']

