open ModularCurve

theorem CuspForm.exists_qIntegral_eisenstein_eigen_mod_of_injective (p m : ℕ) [Fact p.Prime] (hm : 2 ≤ m) (hIB : CuspForm.HasIntegralBasis p) (hinj : ∀ c : ℤ, algebraMap ℤ (CuspForm.heckeAlgebra p 2 ∅) c ∈ Ideal.map (heckeProj p) (eisensteinIdeal p) ⊔ Ideal.span {((m : ℕ) : CuspForm.heckeAlgebra p 2 ∅)} → (m : ℤ) ∣ c) : ∃ f ∈ CuspForm.qIntegralSet p, ∃ af : ℕ → ℤ, (∀ n : ℕ, (af n : ℂ) = ModularFormClass.qCoeff f n) ∧ IsCoprime (af 1) (m : ℤ) ∧ (∀ ℓ : ℕ, ℓ.Prime → ℓ ≠ p → ∀ n : ℕ, n ≠ 0 → (m : ℤ) ∣ af (n * ℓ) + (if ℓ ∣ n then (ℓ : ℤ) * af (n / ℓ) else 0) - (1 + ℓ) * af n) ∧ (∀ n : ℕ, n ≠ 0 → (m : ℤ) ∣ af (n * p) - af n) := by sorry
