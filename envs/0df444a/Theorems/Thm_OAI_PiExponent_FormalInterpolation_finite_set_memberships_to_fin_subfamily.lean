-- title:
--   Aggregate finite index sets into one finite subfamily
-- statement:
--   For finitely many elements, if each belongs to the ideal generated by the image of some finite set of indices, then a single finite indexed subfamily suffices for all of them.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.Ideal.Operations

theorem OAI.PiExponent.FormalInterpolation.finite_set_memberships_to_fin_subfamily
    {R α ι : Type} [CommSemiring R] [Fintype α]
    (x : α → R) (g : ι → R)
    (h : ∀ a, ∃ s : Finset ι, x a ∈ Ideal.span (g '' (s : Set ι))) :
    ∃ n : Nat, ∃ f : Fin n → ι,
      ∀ a, x a ∈ Ideal.span (Set.range (fun j => g (f j))) := by sorry
