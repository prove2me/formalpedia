/-! ## The certificate of one prime `q`

A record gives `a`, `R` and the explicit prime powers `f_i ^ e_i`; then `F = (q - 1) / R` and the last
prime `fr = F / ∏ f_i ^ e_i`. -/

def prodP : List (ℕ × ℕ) → ℕ
  | [] => 1
  | pr :: l => Nat.mul (Nat.pow pr.1 pr.2) (prodP l)

theorem prime_dvd_prodP (f : ℕ) (hf : f.Prime) :
    ∀ l : List (ℕ × ℕ), (∀ pr ∈ l, pr.1.Prime) → f ∣ prodP l → ∃ pr ∈ l, f = pr.1 := by
  intro l
  induction l with
  | nil =>
    intro _ h
    simp only [prodP] at h
    exact absurd (Nat.le_of_dvd one_pos h) (by have := hf.two_le; omega)
  | cons pr l ih =>
    intro hl h
    simp only [prodP] at h
    show _
    rcases (Nat.Prime.dvd_mul hf).1 h with h' | h'
    · have hp1 := hl pr (List.mem_cons_self ..)
      have := (Nat.prime_dvd_prime_iff_eq hf hp1).1 (hf.dvd_of_dvd_pow h')
      exact ⟨pr, List.mem_cons_self .., this⟩
    · obtain ⟨pr', hm, he⟩ := ih (fun x hx => hl x (List.mem_cons_of_mem _ hx)) h'
      exact ⟨pr', List.mem_cons_of_mem _ hm, he⟩

def zOK (q y F f : ℕ) : Bool := Nat.beq (Nat.gcd (Nat.sub (Nat.add (pw6 q y (Nat.div F f)) q) 1) q) 1

def certOK (q a R : ℕ) (ps : List (ℕ × ℕ)) : Bool :=
  Nat.ble 1 R && Nat.blt R 16777216 && Nat.blt q 281474976710656 &&
    Nat.beq (Nat.add (Nat.mul R (Nat.div (Nat.sub q 1) R)) 1) q &&
    Nat.beq (Nat.mul (prodP ps) (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps))) (Nat.div (Nat.sub q 1) R) &&
    Nat.blt q (Nat.mul (Nat.add (Nat.div (Nat.sub q 1) R) 1) (Nat.add (Nat.div (Nat.sub q 1) R) 1)) &&
    fOK (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps)) && ps.all (fun pr => fOK pr.1) &&
    Nat.beq (pw6 q (pw3 q a R) (Nat.div (Nat.sub q 1) R)) 1 &&
    zOK q (pw3 q a R) (Nat.div (Nat.sub q 1) R) (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps)) &&
    ps.all (fun pr => zOK q (pw3 q a R) (Nat.div (Nat.sub q 1) R) pr.1)

theorem certOK_prime (q a R : ℕ) (ps : List (ℕ × ℕ)) (h : certOK q a R ps = true) : q.Prime := by
  simp only [certOK, Bool.and_eq_true, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hR, hR24⟩, hq48⟩, hRF⟩, hPF⟩, hlt⟩, hfr⟩, hfs⟩, h1⟩, hzr⟩, hzs⟩ := h
  set F := Nat.div (Nat.sub q 1) R with hFdef
  set P := prodP ps with hPdef
  set fr := Nat.div F P with hfrdef
  set y := pw3 q a R with hydef
  have hR' : 0 < R := Nat.le_of_ble_eq_true hR
  have hq' : q < 281474976710656 := Nat.le_of_ble_eq_true hq48
  have hRF' : R * F + 1 = q := Nat.eq_of_beq_eq_true hRF
  have hPF' : P * fr = F := Nat.eq_of_beq_eq_true hPF
  have hlt' : q < (F + 1) * (F + 1) := Nat.le_of_ble_eq_true hlt
  have hfrp : fr.Prime := fOK_prime fr hfr
  have hpsp : ∀ pr ∈ ps, pr.1.Prime := fun pr hm => fOK_prime pr.1 (hfs pr hm)
  have hF1 : 1 ≤ F := by
    by_contra hc
    have hF0 : F = 0 := by omega
    rw [hF0] at hRF' hlt'
    omega
  have hRq : R < 281474976710656 := by
    have : R ≤ R * F := Nat.le_mul_of_pos_right R hF1
    omega
  have hFq : F < 281474976710656 := by
    have : F ≤ R * F := Nat.le_mul_of_pos_left F hR'
    omega
  have hy : y ≡ a ^ R [MOD q] := pw3_pow q a R (Nat.le_of_ble_eq_true hR24)
  have hpow : ∀ e : ℕ, e < 281474976710656 → pw6 q y e ≡ (a ^ R) ^ e [MOD q] := by
    intro e he
    exact (pw6_pow q y e he).trans (Nat.ModEq.pow _ hy)
  apply pock q F R a hR' hRF' hlt'
  · have := hpow F hFq
    rw [Nat.eq_of_beq_eq_true h1] at this
    exact this.symm
  · intro f hf hfF
    have hFf : F / f < 281474976710656 := lt_of_le_of_lt (Nat.div_le_self _ _) hFq
