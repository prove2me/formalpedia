-- Source module: NLogN.HCrLin
/-!
# Linear cost bounds for straight-line register code (namespace `NLogN.CR`)

`LinB B p s`: every expression evaluated by the loop-free program `p` from `s` is an `Ex.Lin`
expression whose values have at most `B` bits.  Then `p.cost s ≤ lsz p · 3000 · (B + 2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS

def LinB (B : ℕ) : RS → IState HS → Prop
  | .skip, _ => True
  | .asg i e, s => e.Lin ∧ e.Bnd s B ∧ zsz (s.top i) ≤ B
  | .push _ e, s => e.Lin ∧ e.Bnd s B
  | .pop i, s => zsz (s.top i) ≤ B
  | .seq a b, s => LinB B a s ∧ LinB B b (a.run s)
  | .ite c a b, s => c.Lin ∧ c.Bnd s B ∧ (if c.eval s < 0 then LinB B a s else LinB B b s)
  | .rep _ _ _, _ => False

def lsz : RS → ℕ
  | .skip => 1
  | .asg _ e | .push _ e => e.size + 1
  | .pop _ => 1
  | .seq a b => lsz a + lsz b
  | .ite c a b => c.size + 1 + lsz a + lsz b
  | .rep _ _ _ => 0

end NLogN.CR

end

