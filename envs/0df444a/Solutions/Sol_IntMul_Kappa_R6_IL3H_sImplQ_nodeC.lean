# Round six, item language (I3): a node level

**`sImplQ_nodeC`**: for `E ≥ 2m`, `nodeC c jL rowC` (node frames, the steps of the network, the
leftover call, the scale pad) implements `tens Cm` on the `E` bits, scale `Gs E`, width
`∑ dwStH + DWR + 2 (δ + 2)`, at cost
`≤ ∑_{children s} cI s + cR + (L (MH + Γ_F) + CnN) · W' n' Y`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

theorem chWs_lt {c : Cfg} (hok : NetOK c) : ∀ s ∈ chWs c, s < c.m := by
  intro s hs
  simp only [chWs, List.mem_filterMap] at hs
  obtain ⟨a, ha, hw⟩ := hs
  cases a with
  | child w S neg =>
    simp only [HStep.width, Option.some.injEq] at hw
    subst hw
    exact (hok.child w S neg ha).2.2
  | _ => simp [HStep.width] at hw

theorem sum_chCostH {c : Cfg} (cI : ℕ → ℕ) : ∀ l : List (HStep (Fin c.Wr) c.m),
    (l.map (chCostH cI)).sum = ((l.filterMap HStep.width).map cI).sum
  | [] => rfl
  | a :: l => by
    rw [List.map_cons, List.sum_cons, List.filterMap_cons, sum_chCostH cI l]
    cases h : a.width <;> simp [chCostH, h]

theorem sum_le_aff {α : Type*} (f g : α → ℕ) (k : ℝ) : ∀ l : List α,
    (∀ a ∈ l, (f a : ℝ) ≤ (g a : ℝ) + k) →
      (((l.map f).sum : ℕ) : ℝ) ≤ (((l.map g).sum : ℕ) : ℝ) + (l.length : ℝ) * k
  | [], _ => by simp
  | a :: l, h => by
    have ih := sum_le_aff f g k l (fun b hb => h b (List.mem_cons_of_mem _ hb))
    have ha := h a List.mem_cons_self
    simp only [List.map_cons, List.sum_cons, List.length_cons, Nat.cast_add, Nat.cast_succ] at ih ⊢
    nlinarith

/-- The node frame overhead. -/
theorem cost_nodeFrH (c : Cfg) {r Zr H δ x : ℕ} (hδH : δ ≤ H) (hδZ : zsz (δ : ℤ) ≤ Zr)
    (hZr : Zr + 2 ≤ r) :
    cFrame 6 5 Zr + (cNF2 c Zr δ + x + (6 * (2 * (Zr + δ + 1) + 2) + 1)) + (6 * (2 * Zr + 2) + 1) ≤
      x + 10 ^ 9 * ((δNE c).size + 100) * Yu r Zr H := by
  unfold cNF2
  have h1 := cFrame_Y 6 5 r Zr H
  have h2 := cFrame_Y 5 12 r Zr H
  have h3 := pow2Cost_Y hδH hδZ hZr
  have h4 := moveCost_Y Zr r H
  have h5 := NLogN.moveIntCost_le (Zr + δ + 1)
  have h6 := yu_z2 r Zr H
  have h7 := yu_z1 r Zr H
  have h8 := yu_r r Zr H
  have hH : H ≤ r * (2 * H + 21) := le_trans (by omega) (Nat.le_mul_of_pos_left _ (by omega))
  set Y := Yu r Zr H
  have a : (δNE c).size * 10 ^ 7 * (Zr + 2) ^ 2 ≤ (δNE c).size * 10 ^ 7 * Y :=
    Nat.mul_le_mul_left _ h6
  generalize (δNE c).size = sz at a ⊢
  generalize (Zr + 2) ^ 2 = z2 at a h6
  generalize cFrame 6 5 Zr = f1 at h1 ⊢
  generalize cFrame 5 12 Zr = f2 at h2 ⊢
  generalize pow2Cost δ = p2 at h3 ⊢
  have e : 10 ^ 9 * (sz + 100) * Y = 10 ^ 9 * sz * Y + 10 ^ 11 * Y := by ring
  have e2 : sz * 10 ^ 7 * Y ≤ 10 ^ 9 * sz * Y := by
    have : sz * 10 ^ 7 * Y = 10 ^ 7 * (sz * Y) := by ring
    have : 10 ^ 9 * sz * Y = 10 ^ 9 * (sz * Y) := by ring
    omega
  omega

