    IsOpen O → IsPreconnected O → O ⊆ B → (∀ s ∈ O, δ s ≠ 0) →
    (∀ s ∈ O, (Polynomial.X ^ N + ∑ j, Polynomial.C (a j s) * Polynomial.X ^ (j : ℕ) : Polynomial ℂ).Separable) →
