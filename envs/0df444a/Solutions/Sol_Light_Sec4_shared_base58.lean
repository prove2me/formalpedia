               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => omega)
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (on_goal -1 =>
         ((rintro r₁ μ₁
               ⟨hstep, same₁⟩
                   -- Res := encodeP(L, scr, out + lam 10^L, scr + 7^L, tab, p7, p10, b)
                   );
           (try with_unfolding_none refine Light.Ends.skip ?_))))
  -- Res := encodeP(L, scr, out + lam 10^L, scr + 7^L, tab, p7, p10, b)
  obtain ⟨hbs, hbv⟩ := hb ⟨Light.frame (EncodeP.locals L src out scr tab p7 p10 rb lam r₁), μ₁⟩ rfl
  refine Ends.callTo (hrec _ _ _ _ _ _ r₀ (pre.toRecP hlam h.2 hstep same₁)) ?_ ?_ hd ?_
  · exact fun r₂ μ₂ hpost => ⟨r₂, μ₂, rfl, h.step pre.lay hlam hr same₁ hpost⟩
  · change (∀ e ∈ _, Expr.Safe lim ⟨Light.frame (EncodeP.locals L src out scr tab p7 p10 rb lam r₁), μ₁⟩
      e) ∧ List.map (Expr.val ⟨Light.frame (EncodeP.locals L src out scr tab p7 p10 rb lam r₁), μ₁⟩) _ = _
    (( (try have := Light.Std.space_le (by assumption))
       (try have := Light.Std.const_le (by assumption))
       (simp [Light.Limits.Addr, abs_le, -abs_mul, hbs, hbv] <;> omega)))
  · (first
     | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
             List.sum_cons, List.sum_nil, ])
         (first
           | omega
           | ((ring_nf); (omega))))
     | omega
