namespace Erdos195

instance instDecidableRel_treeLt (θ : ℕ → ℤ → Bool) : DecidableRel (treeLt θ) := by
  intro x y
  dsimp [treeLt, bitOne]
  infer_instance

/-- Prefer the two's-complement bits of `p` at every level (independent of residue). -/
private def preferBits (p : ℤ) : ℕ → ℤ → Bool :=
  fun k _ => decide (p / 2 ^ k % 2 = 1)

/-- The non-strict order generated by `preferBits p`. -/
private def lePrefer (p : ℤ) : ℤ → ℤ → Prop :=
  fun x y => treeLt (preferBits p) x y ∨ x = y

instance instDecidableRel_lePrefer (p : ℤ) : DecidableRel (lePrefer p) := by
  intro x y
  dsimp [lePrefer]
  infer_instance

private lemma instPrimeTwo : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

private lemma preferBits_true_iff (p : ℤ) (k : ℕ) (r : ℤ) :
    preferBits p k r = true ↔ bitOne p k := by
  simp [preferBits, bitOne]

private lemma treeLt_prefer_p {p x : ℤ} (h : x ≠ p) :
    treeLt (preferBits p) p x := by
  refine ⟨h.symm, ?_⟩
  rw [preferBits_true_iff]

/-- At the first bit where `x` and `y` differ, their bits are complementary. -/
private lemma bitOne_flip {x y : ℤ} (h : x ≠ y) :
    bitOne y (padicValInt 2 (y - x)) ↔ ¬ bitOne x (padicValInt 2 (y - x)) := by
  haveI := instPrimeTwo
  set k := padicValInt 2 (y - x)
  have hne : y - x ≠ 0 := sub_ne_zero.mpr h.symm
  have hdvd : (2 : ℤ) ^ k ∣ y - x := padicValInt_dvd (p := 2) (y - x)
  have hndvd : ¬ (2 : ℤ) ^ (k + 1) ∣ y - x := by
    intro hpow
    have hk : k + 1 ≤ padicValInt 2 (y - x) :=
      ((padicValInt_dvd_iff (p := 2) (k + 1) (y - x)).mp hpow).resolve_left hne
    omega
  obtain ⟨m, hm⟩ := hdvd
  have hmodd : ¬ (2 : ℤ) ∣ m := by
    intro h2
    obtain ⟨t, ht⟩ := h2
    refine hndvd ⟨t, ?_⟩
    rw [hm, ht, pow_succ]
    ring
  have hy : y = x + 2 ^ k * m := by omega
  have hpow0 : (2 : ℤ) ^ k ≠ 0 := pow_ne_zero _ (by decide)
  have hpowpos : (0 : ℤ) < 2 ^ k := pow_pos (by decide) k
  have hxdecomp : x % 2 ^ k + (x / 2 ^ k) * 2 ^ k = x := Int.emod_add_ediv_mul x (2 ^ k)
  have hydecomp : x % 2 ^ k + (x / 2 ^ k + m) * 2 ^ k = y := by
    calc
      x % 2 ^ k + (x / 2 ^ k + m) * 2 ^ k
          = x % 2 ^ k + (x / 2 ^ k) * 2 ^ k + m * 2 ^ k := by ring
      _ = x + m * 2 ^ k := by rw [hxdecomp]
      _ = x + 2 ^ k * m := by ring
      _ = y := hy.symm
  have hydecomp' : x % 2 ^ k + 2 ^ k * (x / 2 ^ k + m) = y := by
    rw [← hydecomp]
    ring
  have hrmod0 : 0 ≤ x % 2 ^ k := Int.emod_nonneg _ hpow0
  have hrmod1 : x % 2 ^ k < 2 ^ k := Int.emod_lt_of_pos _ hpowpos
  have hquot : y / 2 ^ k = x / 2 ^ k + m := by
    have hunq := (Int.ediv_emod_unique (a := y) (b := (2 : ℤ) ^ k) (r := x % 2 ^ k)
      (q := x / 2 ^ k + m) hpowpos).2
    exact (hunq ⟨hydecomp', hrmod0, hrmod1⟩).1
  have hm1 : m % 2 = 1 := by
    rcases Int.emod_two_eq m with hm0 | hm1
    · exact (hmodd (Int.dvd_of_emod_eq_zero hm0)).elim
    · exact hm1
  have hadd : (x / 2 ^ k + m) % 2 = (x / 2 ^ k % 2 + m % 2) % 2 := Int.add_emod _ _ _
  simp only [bitOne, hquot]
  rcases Int.emod_two_eq (x / 2 ^ k) with hx0 | hx1
  · simp [hx0, hm1, hadd]
  · simp [hx1, hm1, hadd]

private lemma lePrefer_total (p : ℤ) : Std.Total (lePrefer p) := by
  have hord : IsStrictTotalOrder ℤ (treeLt (preferBits p)) :=
    (treeLt_order_props (preferBits p)).1
  refine ⟨fun x y => ?_⟩
  rcases trichotomous_of (treeLt (preferBits p)) x y with h | rfl | h
  · exact Or.inl (Or.inl h)
  · exact Or.inl (Or.inr rfl)
  · exact Or.inr (Or.inl h)

private lemma lePrefer_trans (p : ℤ) : IsTrans ℤ (lePrefer p) := by
  have hord : IsStrictTotalOrder ℤ (treeLt (preferBits p)) :=
    (treeLt_order_props (preferBits p)).1
  refine ⟨fun x y z hxy hyz => ?_⟩
  rcases hxy with hxy | rfl
  · rcases hyz with hyz | rfl
    · exact Or.inl (IsTrans.trans _ _ _ hxy hyz)
    · exact Or.inl hxy
  · exact hyz

private lemma pairwise_idxOf {r : ℤ → ℤ → Prop} {L : List ℤ} {a b : ℤ}
    (hp : L.Pairwise r) (ha : a ∈ L) (hb : b ∈ L)
    (h : L.idxOf a < L.idxOf b) : r a b := by
  have ha_lt : L.idxOf a < L.length := List.idxOf_lt_length_of_mem ha
  have hb_lt : L.idxOf b < L.length := List.idxOf_lt_length_of_mem hb
  have hae : L.get ⟨L.idxOf a, ha_lt⟩ = a := List.idxOf_get ha_lt
  have hbe : L.get ⟨L.idxOf b, hb_lt⟩ = b := List.idxOf_get hb_lt
  have := (List.pairwise_iff_get.mp hp) ⟨L.idxOf a, ha_lt⟩ ⟨L.idxOf b, hb_lt⟩ h
  simpa [hae, hbe] using this

private lemma treeLt_of_sorted {p : ℤ} {L : List ℤ} {a b : ℤ}
    (hpair : L.Pairwise (lePrefer p)) (ha : a ∈ L) (hb : b ∈ L)
    (h : L.idxOf a < L.idxOf b) :
    treeLt (preferBits p) a b := by
  have hle := pairwise_idxOf hpair ha hb h
  rcases hle with hlt | rfl
  · exact hlt
  · omega

theorem specified_first_safe_order (X : Finset ℤ) (p : ℤ) (hp : p ∈ X) :
    ∃ L : List ℤ, L.Nodup ∧ (∀ x, x ∈ L ↔ x ∈ X) ∧ L.head? = some p ∧
      ∃ θ : ℕ → ℤ → Bool, Safe (treeLt θ) L := by
  classical
  let others : List ℤ := (X.erase p).toList
  let instTotal : Std.Total (lePrefer p) := lePrefer_total p
  let instTrans : IsTrans ℤ (lePrefer p) := lePrefer_trans p
  let sorted : List ℤ := others.insertionSort (lePrefer p)
  let L : List ℤ := p :: sorted
  have hperm : sorted.Perm others := List.perm_insertionSort (lePrefer p) others
  have hnodup_others : others.Nodup := (X.erase p).nodup_toList
  have hnodup_sorted : sorted.Nodup := (List.Perm.nodup_iff hperm).mpr hnodup_others
  have hp_not : p ∉ others := by
    simp [others]
  have hp_not_sorted : p ∉ sorted := by
    simpa [List.Perm.mem_iff hperm] using hp_not
  have hnodup : L.Nodup := (List.nodup_cons).2 ⟨hp_not_sorted, hnodup_sorted⟩
  have hmem : ∀ x, x ∈ L ↔ x ∈ X := by
    intro x
    constructor
    · intro hxL
      rcases List.mem_cons.mp hxL with rfl | hx
      · exact hp
      · have hxO : x ∈ others := (List.Perm.mem_iff hperm).mp hx
        exact (Finset.mem_erase.mp ((Finset.mem_toList (s := X.erase p)).mp hxO)).2
    · intro hx
      by_cases hxp : x = p
      · subst hxp
        exact List.mem_cons_self
      · refine List.mem_cons_of_mem _ ?_
        exact (List.Perm.mem_iff hperm).mpr
          ((Finset.mem_toList (s := X.erase p)).mpr (Finset.mem_erase.mpr ⟨hxp, hx⟩))
  have hhead : L.head? = some p := rfl
  have hsort : sorted.Pairwise (lePrefer p) := by
    haveI := instTotal
    haveI := instTrans
    exact List.pairwise_insertionSort (lePrefer p) others
  have hmin : ∀ x ∈ sorted, lePrefer p p x := by
    intro x hx
    have hne : x ≠ p := by
      intro h
      subst h
      exact hp_not_sorted hx
    exact Or.inl (treeLt_prefer_p hne)
  have hpair : L.Pairwise (lePrefer p) := List.Pairwise.cons hmin hsort
  have hno3 : No3AP (treeLt (preferBits p)) :=
    (treeLt_order_props (preferBits p)).2.1
  refine ⟨L, hnodup, hmem, hhead, ?_⟩
  rw [exists_treeLt_safe_iff]
  refine ⟨?hcont, ?hop⟩
  · intro a b ha hb hmid hord1 hord2
    exfalso
    have hab := treeLt_of_sorted hpair ha hb hord1
    have hbc := treeLt_of_sorted hpair hb hmid hord2
    have hr : b - a ≠ 0 := by
      intro h0
      have : a = b := by omega
      subst this
      exact hab.1 rfl
    have h1 : treeLt (preferBits p) a (a + (b - a)) := by
      have : a + (b - a) = b := by omega
      simpa [this] using hab
    have h2 : treeLt (preferBits p) (a + (b - a)) (a + 2 * (b - a)) := by
      have hb' : a + (b - a) = b := by omega
      have hc' : a + 2 * (b - a) = 2 * b - a := by omega
      simpa [hb', hc'] using hbc
    exact hno3 a (b - a) hr ⟨h1, h2⟩
  · intro a b a' b' ha hb hord _ _ ha' hb' hord' _ _ hval _
    have hab := treeLt_of_sorted hpair ha hb hord
    have hab' := treeLt_of_sorted hpair ha' hb' hord'
    have force {x y : ℤ} (hxy : treeLt (preferBits p) x y) :
        bitOne y (padicValInt 2 (y - x)) ↔ ¬ bitOne p (padicValInt 2 (y - x)) := by
      have hx := hxy.2
      have hpref :
          preferBits p (padicValInt 2 (y - x)) (x % 2 ^ padicValInt 2 (y - x)) = true ↔
            bitOne p (padicValInt 2 (y - x)) := preferBits_true_iff _ _ _
      have hdiff := bitOne_flip hxy.1
      constructor
      · intro hy hpbit
        have hxbit : bitOne x (padicValInt 2 (y - x)) := (hx.trans hpref).mpr hpbit
        exact hdiff.mp hy hxbit
      · intro hnp
        have hxbit : ¬ bitOne x (padicValInt 2 (y - x)) := by
          intro hx'
          exact hnp (hpref.mp (hx.mp hx'))
        exact hdiff.mpr hxbit
    have hbF := force hab
    have hbF' := force hab'
    have hval' : padicValInt 2 (b' - a') = padicValInt 2 (b - a) := hval.symm
    have hbF'' : bitOne b' (padicValInt 2 (b - a)) ↔ ¬ bitOne p (padicValInt 2 (b - a)) := by
      simpa [hval'] using hbF'
    exact hbF.trans hbF''.symm

end Erdos195

theorem solution (X : Finset ℤ) (p : ℤ) (hp : p ∈ X) :
    ∃ L : List ℤ, L.Nodup ∧ (∀ x, x ∈ L ↔ x ∈ X) ∧ L.head? = some p ∧
      ∃ θ : ℕ → ℤ → Bool, Erdos195.Safe (Erdos195.treeLt θ) L :=
  Erdos195.specified_first_safe_order X p hp
