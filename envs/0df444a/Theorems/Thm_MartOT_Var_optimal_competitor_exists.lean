-- title:
--   Proof of Lemma 1.11, p. 18 — the cost-minimizing competitor α′_p of the uniform α_p exists and can be chosen measurably in p
-- statement:
--   Let $c:\mathbb R\times\mathbb R\to\mathbb R$ be Borel measurable and fix $n\in\mathbb N$. For an $n$-tuple $p=((x_1,y_1),\dots,(x_n,y_n))\in(\mathbb R\times\mathbb R)^n$ let $\alpha_p$ be the measure uniformly distributed on the set $\{(x_1,y_1),\dots,(x_n,y_n)\}$, i.e. mass $1/k$ at each of its $k$ distinct points. Then the problem
--   $$\text{Minimize }\int_{\mathbb R\times\mathbb R} c(x,y)\,d\beta(x,y)\quad\text{over competitors }\beta\text{ of }\alpha_p$$
--   has an optimizer $\alpha'_p$ for every $p$, and the optimizers can be chosen so that $p\mapsto\alpha'_p$ is a measurable map from $(\mathbb R\times\mathbb R)^n$ to the space of measures on $\mathbb R\times\mathbb R$.
--
--   In the proof of the variational lemma the improved measure $\omega'=\int\alpha'_p\,d\gamma(p)$ is assembled from these optimizers, which is why measurability in $p$ is needed.
--
--   **Formalization Note** The space of measures carries Mathlib's standard σ-algebra (generated by $\beta\mapsto\beta(A)$ for Borel $A$). For $n=0$ the set is empty and $\alpha_p=0$. The uniform measure on the set (not the empirical measure counting repeated points) is the page's $\alpha_p$.
-- source:
--   arXiv:1208.1509v2, §3, proof of Lemma 1.11, p. 18 ("For each p ∈ (R × R)^n, let α′_p be an optimizer …")

import Mathlib
import Definitions.Def_MartOT_Var_Setting

namespace MartOT.Var

open MeasureTheory

theorem optimal_competitor_exists (c : ℝ → ℝ → ℝ) (hc : Measurable (Function.uncurry c))
    (n : ℕ) :
    ∃ αopt : (Fin n → ℝ × ℝ) → Measure (ℝ × ℝ), Measurable αopt ∧
      ∀ p : Fin n → ℝ × ℝ,
        IsCompetitor (((Finset.univ.image p).card : ENNReal)⁻¹ •
            ∑ q ∈ Finset.univ.image p, Measure.dirac q) (αopt p) ∧
        ∀ β : Measure (ℝ × ℝ),
          IsCompetitor (((Finset.univ.image p).card : ENNReal)⁻¹ •
              ∑ q ∈ Finset.univ.image p, Measure.dirac q) β →
          cost c (αopt p) ≤ cost c β := by sorry

end MartOT.Var
