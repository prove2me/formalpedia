-- Source module: Solutions.R6IL3Hyps
/-!
# Round six, item language (I3): the extra hypotheses of `P14NeedH'` at round-six parameters

`p14_hyps_r6`: for `P.Ok`, any constant `K₀` and all large `n`, the round-six values
`K = KP6 = ℓ - 1`, `D = dP6 = ⌊b^ε⌋`, `p = pP6 = 6 b^(1+x)` satisfy

1. `zsz N ≤ p` for every `N < 2^(6b)` (and `n ≤ 2^b`, `V ≤ 48 n`, so every local size of the
   caller is far below);
2. `(p + K₀)^5 ≤ 2^K`;
3. `K₀ D (zsz p + 1) ≤ K D^lamp` (this is `ε (2 - lamp) < 1`, `Prm.Ok.eps_two_sub`);

and also `6 ≤ K`.
-/

open Real

namespace IntMul.Kappa.R6.IL3

open IntMul.Kappa.R6 NLogN

noncomputable section

/-- `b^(1-ε) ≤ 2 ℓ`. -/
lemma b_rpow_le_two_ell (P : Prm) {n : ℕ} (hG : Good P n) :
    (bP6 n : ℝ) ^ (1 - P.ε) ≤ 2 * ℓP6 P n := by
  have hb0 : (0 : ℝ) < bP6 n := by exact_mod_cast (show 0 < bP6 n by have := hG.b_ge; omega)
  have hd0 : (0 : ℝ) < dP6 P n := by exact_mod_cast (show 0 < dP6 P n by have := hG.d_pos; omega)
  have he : (0 : ℝ) < (bP6 n : ℝ) ^ P.ε := Real.rpow_pos_of_pos hb0 _
  have hsplit : (bP6 n : ℝ) ^ (1 - P.ε) = (bP6 n : ℝ) / (bP6 n : ℝ) ^ P.ε := by
    rw [Real.rpow_sub hb0, Real.rpow_one]
  have h1 : (bP6 n : ℝ) / (bP6 n : ℝ) ^ P.ε ≤ (bP6 n : ℝ) / dP6 P n :=
    div_le_div_of_nonneg_left hb0.le hd0 hG.d_le
  have h2 := hG.ell_ge
  have h3 : (bP6 n : ℝ) / (2 * dP6 P n) = (bP6 n : ℝ) / dP6 P n / 2 := by ring
  rw [hsplit]; linarith

lemma mExp_pos (P : Prm) (hP : P.Ok) : 1 ≤ mExp P := by
  have h : 0 < 1 - P.ε := by linarith [hP.eps_lt]
  unfold mExp
  exact Nat.one_le_iff_ne_zero.mpr (by
    intro h0; rw [Nat.ceil_eq_zero] at h0; have : 0 < 1 / (1 - P.ε) := by positivity
    linarith)

/-- `b ≤ (2ℓ)^m`. -/
lemma b_le_ell_pow (P : Prm) (hP : P.Ok) {n : ℕ} (hG : Good P n) :
    bP6 n ≤ (2 * ℓP6 P n) ^ mExp P := by
  have hpos : 0 < 1 - P.ε := by linarith [hP.eps_lt]
  have hb1 : (1 : ℝ) ≤ bP6 n := by exact_mod_cast (show 1 ≤ bP6 n by have := hG.b_ge; omega)
  have hm : 1 ≤ (1 - P.ε) * (mExp P : ℝ) := by
    have : 1 / (1 - P.ε) ≤ (mExp P : ℝ) := Nat.le_ceil _
    rw [div_le_iff₀ hpos] at this; linarith
  have h1 : (bP6 n : ℝ) ≤ (bP6 n : ℝ) ^ ((1 - P.ε) * (mExp P : ℝ)) := by
    calc (bP6 n : ℝ) = (bP6 n : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hb1 hm
  have h2 : (bP6 n : ℝ) ^ ((1 - P.ε) * (mExp P : ℝ)) = ((bP6 n : ℝ) ^ (1 - P.ε)) ^ (mExp P) := by
    rw [Real.rpow_mul (by linarith), Real.rpow_natCast]
  have h3 : ((bP6 n : ℝ) ^ (1 - P.ε)) ^ (mExp P) ≤ (2 * (ℓP6 P n : ℝ)) ^ (mExp P) :=
    pow_le_pow_left₀ (Real.rpow_nonneg (by linarith) _) (b_rpow_le_two_ell P hG) _
  have : (bP6 n : ℝ) ≤ ((2 * ℓP6 P n) ^ mExp P : ℕ) := by push_cast; linarith
  exact_mod_cast this

/-- `ℓ ≥ T` once `(2T)^m ≤ b`. -/
lemma ell_ge_of (P : Prm) (hP : P.Ok) {n : ℕ} (hG : Good P n) (T : ℕ)
    (hb : (2 * T) ^ mExp P ≤ bP6 n) : T ≤ ℓP6 P n := by
  by_contra h
  push Not at h
  have h1 := b_le_ell_pow P hP hG
  have h2 : (2 * ℓP6 P n) ^ mExp P < (2 * T) ^ mExp P :=
    Nat.pow_lt_pow_left (by omega) (by have := mExp_pos P hP; omega)
  omega

/-- `b ≤ (⌊b^g⌋ + 1)^q` for `q = ⌈1/g⌉`, `g > 0`. -/
lemma b_le_floor_pow {g : ℝ} (hg : 0 < g) {b : ℕ} (hb : 1 ≤ b) :
    b ≤ (⌊(b : ℝ) ^ g⌋₊ + 1) ^ ⌈1 / g⌉₊ := by
  have hb1 : (1 : ℝ) ≤ b := by exact_mod_cast hb
  have hq : 1 ≤ g * (⌈1 / g⌉₊ : ℝ) := by
    have : 1 / g ≤ (⌈1 / g⌉₊ : ℝ) := Nat.le_ceil _
    rw [div_le_iff₀ hg] at this; linarith
  have h1 : (b : ℝ) ≤ (b : ℝ) ^ (g * (⌈1 / g⌉₊ : ℝ)) := by
    calc (b : ℝ) = (b : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hb1 hq
  have h2 : (b : ℝ) ^ (g * (⌈1 / g⌉₊ : ℝ)) = ((b : ℝ) ^ g) ^ ⌈1 / g⌉₊ := by
    rw [Real.rpow_mul (by linarith), Real.rpow_natCast]
  have h3 : ((b : ℝ) ^ g) ^ ⌈1 / g⌉₊ ≤ ((⌊(b : ℝ) ^ g⌋₊ : ℝ) + 1) ^ ⌈1 / g⌉₊ :=
    pow_le_pow_left₀ (Real.rpow_nonneg (by linarith) _) (Nat.lt_floor_add_one _).le _
  have : (b : ℝ) ≤ (((⌊(b : ℝ) ^ g⌋₊ + 1) ^ ⌈1 / g⌉₊ : ℕ) : ℝ) := by push_cast; linarith
  exact_mod_cast this

/-- A polynomial in `s` with a fixed coefficient is eventually below `2^(s-1)`: if
`2^(s-1) ≤ 6 C (s+1)^j` then `s < S₀`. -/
lemma small_of_pow_le (C j : ℕ) : ∃ S₀ : ℕ, ∀ s : ℕ, S₀ ≤ s → 6 * C * (s + 1) ^ j < 2 ^ (s - 1) := by
  obtain ⟨B₁, hB₁⟩ := poly_le_two_pow_half (j + 1)
  refine ⟨B₁ + C + 3, fun s hs => ?_⟩
  have hB := hB₁ (s + 1) (by omega)
  have hBs : 2 ^ ((s + 1) / 2) ≤ 2 ^ (s - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hpos : 0 < (s + 1) ^ j := by positivity
  have h1 : (s + 1) ^ (j + 1) = (s + 1) ^ j * (s + 1) := pow_succ _ _
  have h2 : 6 * C * (s + 1) ^ j < 8 * (s + 1) * (s + 1) ^ j :=
    Nat.mul_lt_mul_of_pos_right (by omega) hpos
  nlinarith

end

end IntMul.Kappa.R6.IL3

