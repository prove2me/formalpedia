theorem setup_call {Pp m : ℕ} {I : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eu ed : Fin Pp}
    {U Dn : IStmt HS Pp} {ρ : Fin m → Fin HS} {dA : Fin HS} {desc : List ℤ} {V : Fin m → List ℤ}
    {C C' : ℝ} (hu : tbl eu = U) (hd : tbl ed = Dn) (h : SetupS I tbl U Dn ρ dA desc V C)
