  have hz0 : ∀ (s : ↥SS), ∀ P ∈ (An s).dom, P.evalAt (An s).param ≠ 0 := fun s P hP => ((An s).mem_dom P hP).2.2.2.1
  have hvz0 : ∀ (s : ↥SS), ∀ P ∈ (An s).dom, A.valuation (P.evalAt (An s).param) ≠ 0 := fun s P hP =>
    (map_ne_zero A.valuation).mpr (hz0 s P hP)

  have hφinj : Function.Injective (qExpFrobeniusPlaceModL (ResidueField ↥A) (JHNeronObjectAtP.ΓN p M H hpM) p) :=
