/-- Exact minimal criterion for the six separations when 2h=0:
both d+d=0 and d+d=h must be excluded. -/
theorem p2m_local_abelianSixSeparations_iff_double_ne
    (a d h : G) (hhalf : h + h = 0) :
    (a ≠ a + d ∧ a ≠ (a + d) + h ∧
      a ≠ a - d ∧ a ≠ (a - d) + h ∧
      a + d ≠ a - d ∧ a + d ≠ (a - d) + h) ↔
        d + d ≠ 0 ∧ d + d ≠ h := by
  constructor
  · rintro ⟨_, _, _, _, hc1, hc2⟩
    constructor
    · intro he
      apply hc1
      apply sub_eq_zero.mp
      calc
        (a + d) - (a - d) = d + d := by abel
        _ = 0 := he
    · intro he
      apply hc2
      apply sub_eq_zero.mp
      calc
        (a + d) - ((a - d) + h) = (d + d) - h := by abel
        _ = 0 := by rw [he]; simp
  · rintro ⟨h2zero, h2half⟩
    exact abelianSixSeparations_of_double_ne a d h hhalf h2zero h2half



























