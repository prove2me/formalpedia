section Leaf

variable {P K D S ρ : ℕ}

theorem sImpl_of_limpl (hρ : ρ < K) {r : ℕ} {T : Butterfly.Op (Fin D)} {code : RS} {e dw : ℕ}
    {cost : ℕ → ℕ} (h : LImpl (P := P) (S := S) hρ r T code e dw cost) :
    SImpl r (fun i : Fin D => KFH.stT K D S ρ i) (vol (Butterfly.layerShape P K D S)) T code e dw
      cost := by
  intro s f zs l xs F w hC h0 hx hl hb
  obtain ⟨zs', h1, h2, h3⟩ := h s f zs l xs F w hC.cl h0 hx hl hb
  refine ⟨zs', ?_, h2, h3⟩
  rw [← selOp_eq_selOpF (strideSel_layer hρ)]
  exact h1

end Leaf

end NLogN.KFN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp} {P K D S ρ : ℕ}
theorem solution (hρ : ρ < K) (hD : 1 ≤ D) {r p w : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S)
    (hP : 1 ≤ P) {Cc : ℕ → NLogN.IStmt NLogN.HS Pp} {E dC : ℕ} {kC : ℕ → ℕ}
    (hCimpl : NLogN.KFN.SImplI Isym iprog r (fun i : Fin D => NLogN.KFH.stT K D S ρ i)
      (AModel.vol (Butterfly.layerShape P K D S)) (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) Cc E dC kC)
    (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : NLogN.KFH.RecRep r p zs xs) (hl : xs.length = AModel.vol (Butterfly.layerShape P K D S))
    (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hC : NLogN.KFN.ClN f) (hb : NLogN.KFB.GB w zs)
    (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', NLogN.KFH.RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) ∧
      NLogN.KFB.GB (p + 1) zs' ∧
      (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p
          (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs).length)
        (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
        ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p
          (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)[j] c -
          (Butterfly.layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
      NLogN.IRuns Isym iprog (NLogN.KFN.p14WithI P K D S ρ r E Cc w) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs' ++ l)))
        (kC (w + 2 * D) + NLogN.KFN.cWrapE D E (AModel.vol (Butterfly.layerShape P K D S) * r)
          (NLogN.zsz ((12 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w dC) := by
  set N := AModel.vol (Butterfly.layerShape P K D S) * r
  set Z := NLogN.zsz ((12 * N : ℕ) : ℤ)
  have hZ : NLogN.zsz ((12 * N : ℕ) : ℤ) ≤ Z := le_rfl
  have hsL : NLogN.KFN.SLaws (fun i : Fin D => NLogN.KFH.stT K D S ρ i) (AModel.vol (Butterfly.layerShape P K D S)) :=
    NLogN.KFN.slaws_of_strideSel (NLogN.KFN.strideSel_layer (P := P) (D := D) (S := S) hρ)
  have L1 := (NLogN.KFN.sImpl_of_limpl hρ (NLogN.KFH.limpl_tens (P := P) (S := S) (D := D) hρ hr hS hP NLogN.KFH.MS_ok
    NLogN.KFH.kerOk_MS Z hZ)).toI (I := Isym) (iprog := iprog) (NLogN.KFH.fok_kersP _ _ _ _ _ _ _ _)
  have L4 := (NLogN.KFN.sImpl_of_limpl hρ (NLogN.KFH.limpl_ker (P := P) (S := S) hρ ⟨0, hD⟩ hr hS hP (M := NLogN.KFH.MD D)
    ⟨NLogN.KFH.Sm_gD D, NLogN.KFB.Sm_zero, NLogN.KFB.Sm_zero, NLogN.KFH.Sm_gD D⟩ (NLogN.KFH.kerOk_MD D) Z hZ)).toI (I := Isym) (iprog := iprog)
    (NLogN.KFH.fok_kerP _ _ _ _ _ _ _ _)
  have L := ((L1.comp hsL hCimpl).comp hsL L1).comp hsL L4
  obtain ⟨zs1, r1, b1, f1⟩ := L s f zs l xs p w hC h0 hx hl hb
  rw [← NLogN.KFN.selOp_eq_selOpF (NLogN.KFN.strideSel_layer hρ)] at r1
  have hT : Butterfly.tensF (Butterfly.kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : Butterfly.M2))) *
      (Butterfly.tens Butterfly.Sm * (Butterfly.tens Butterfly.Cm * Butterfly.tens Butterfly.Sm)) =
      (Butterfly.tens Butterfly.H0 : Butterfly.Op (Fin D)) := by
    rw [NLogN.KFH.tensF_kerAt_smul_one, Butterfly.tens_H0, Butterfly.tens_Sm, Fintype.card_fin, smul_mul_assoc,
      one_mul, mul_assoc]
  rw [hT] at r1
  have r1' : NLogN.KFH.RecRep r (p + (E + (D / 2 + D % 2))) zs1 (Butterfly.layerH P K D S ρ hρ xs) := by
    have e : p + (0 * D + E + 0 * D + (D / 2 + D % 2)) = p + (E + (D / 2 + D % 2)) := by ring
    rw [e] at r1; exact r1
  have hz1 : zs1.length = N := by rw [r1'.1, Butterfly.layerH, Butterfly.butterflyLayer,
    Butterfly.length_selOp]
  obtain ⟨rT, bT, fT⟩ := NLogN.KFH.truncP_rec s (Function.update f 0 (NLogN.KFB.gflat zs1 ++ l)) zs1 _ l r1'
    (by simp) (hC.upd0 _).cl (w := w + 4 * D + dC + 2)
    (b1.mono (by omega)) Z (by rw [hz1]; exact NLogN.zsz_natCast_le' (by omega))
  obtain ⟨hout, hdisk', herr⟩ := Butterfly.prop14_output (P := P) (S := S) hρ p
    (Butterfly.tens Butterfly.Cm) rfl xs hdisk
  rw [← hout] at rT
  refine ⟨_, rT, NLogN.KFH.GB_trunc_disk rT (fun j hj c => hdisk' j hj c), herr, ?_⟩
  have F := f1.seq (fT.irun (I := Isym) (iprog := iprog) (NLogN.KFH.fok_truncP _ _))
  rw [Function.update_idem, hz1] at F
  refine F.mono (le_of_eq ?_)
  unfold NLogN.KFN.cWrapE; ring
end
