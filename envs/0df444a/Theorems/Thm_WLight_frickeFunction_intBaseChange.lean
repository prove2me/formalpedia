-- title:
--   Descent of level-N integral fractions to ℚ(ζ_N)
-- statement:
--   Let $N$ be a positive integer, and let $L$ assign to each $\tau$ in the upper half-plane $\mathbb{H}$ a period pair with $\omega_1 = \tau$ and $\omega_2 = 1$. Let $W$ satisfy $W_v(\tau) = (2\pi i)^{-2}\,\wp_{L(\tau)}\bigl((\tilde v_0\tau + \tilde v_1)/N\bigr)$ for all $v \in (\mathbb{Z}/N)^2$ and $\tau$, where $\tilde v_k$ denotes the canonical integer representative of $v_k$, let $\mathrm{fricke}$ satisfy $\mathrm{fricke}_v(\tau) = -\bigl(E_4(\tau)E_6(\tau)/\Delta(\tau)\bigr)/2592 \cdot W_v(\tau)$, and let $jf(\tau) = E_4(\tau)^3/\Delta(\tau)$. Let $G, a, b : \mathbb{H} \to \mathbb{C}$ with $G$ holomorphic (complex $C^\infty$ in the sense of `MDifferentiable` for the model $\mathcal{I}(\mathbb{C})$), with $a$ and $b$ in the $\mathbb{C}$-subalgebra of $\mathbb{H} \to \mathbb{C}$ generated by $jf$ together with all $\mathrm{fricke}_v$ for $v \neq 0$, with $b \neq 0$ and $G\cdot b = a$, and suppose that for some $d$ and polynomials $p_0,\dots,p_{d-1} \in \mathbb{C}[X]$ one has $G(\tau)^d + \sum_{i<d} p_i(jf(\tau))G(\tau)^i = 0$ for all $\tau$. Put $k_N = \mathbb{Q}\bigl(e^{2\pi i/N}\bigr) \subseteq \mathbb{C}$. Then there are finitely many scalars $\lambda_i \in \mathbb{C}$ and functions $G_i$ with $G = \sum_i \lambda_i G_i$, each $G_i$ holomorphic, each $G_i$ of the form $G_i Q_i = P_i$ with $P_i, Q_i$ in the $k_N$-subalgebra generated by $jf$ and the $\mathrm{fricke}_v$ ($v \neq 0$) and $Q_i \neq 0$, and each $G_i$ satisfying a monic relation $G_i(\tau)^{d_i} + \sum_{k<d_i} p_{i,k}(jf(\tau))G_i(\tau)^k = 0$ for all $\tau$, where every coefficient of every $p_{i,k}$ lies in $k_N$.
--
--   This is the base-change step in the study of the field of modular functions of level $N$ and its field of constants: an element of that field which is holomorphic on $\mathbb{H}$ and integral over $\mathbb{C}[j]$ is exhibited as a $\mathbb{C}$-linear combination of functions of the same shape but with coefficients in the cyclotomic field $\mathbb{Q}(\zeta_N)$. It is used in the $q$-expansion arguments for cusp forms and Fricke functions, for instance in the spanning and transport statements for $\mathbb{Q}(\zeta_N)$-rational Fricke expressions; the proof cites the modularity and orbit packages for the Fricke functions, the existence of a holomorphic quotient under a monic relation, and the two single-constant descent theorems for integral elements (algebraic and transcendental constant).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WLight_frickeFunction_intBaseChange.lean

import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
import Mathlib.NumberTheory.ModularForms.Discriminant
import Mathlib.Geometry.Manifold.Notation
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Adjoin.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open Complex Real UpperHalfPlane
open scoped Manifold MatrixGroups ModularForm

theorem WLight.frickeFunction_intBaseChange
    (N : ℕ) [NeZero N]
    (L : ℍ → PeriodPair) (hL : ∀ τ : ℍ, (L τ).ω₁ = (τ : ℂ) ∧ (L τ).ω₂ = 1)
    (W : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hW : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), W v τ = ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
      PeriodPair.weierstrassP (L τ) ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ)))
    (fricke : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hfricke : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), fricke v τ =
      -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 * W v τ)
    (jf : ℍ → ℂ)
    (hjf : ∀ τ : ℍ, jf τ = ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ)
    {G a b : ℍ → ℂ} (hG : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) G)
    (ha : a ∈ Algebra.adjoin ℂ
      (insert jf {g : ℍ → ℂ | ∃ v : Fin 2 → ZMod N, v ≠ 0 ∧ g = fricke v}))
    (hb : b ∈ Algebra.adjoin ℂ
      (insert jf {g : ℍ → ℂ | ∃ v : Fin 2 → ZMod N, v ≠ 0 ∧ g = fricke v}))
    (hb0 : b ≠ 0) (hGb : G * b = a)
    {d : ℕ} (p : Fin d → Polynomial ℂ)
    (hprel : ∀ τ : ℍ, G τ ^ d + ∑ i : Fin d, (p i).eval (jf τ) * G τ ^ (i : ℕ) = 0) :
    letI kN : IntermediateField ℚ ℂ :=
      IntermediateField.adjoin ℚ {Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ))}
    ∃ (n : ℕ) (lam : Fin n → ℂ) (Gi : Fin n → (ℍ → ℂ))
      (Pi Qi : Fin n → (ℍ → ℂ))
      (di : Fin n → ℕ) (pi : ∀ i, Fin (di i) → Polynomial ℂ),
      (G = ∑ i, lam i • Gi i) ∧
      (∀ i, MDifferentiable 𝓘(ℂ) 𝓘(ℂ) (Gi i)) ∧
      (∀ i, Pi i ∈ Algebra.adjoin ↥kN
          (insert jf {g : ℍ → ℂ | ∃ v : Fin 2 → ZMod N, v ≠ 0 ∧ g = fricke v}) ∧
        Qi i ∈ Algebra.adjoin ↥kN
          (insert jf {g : ℍ → ℂ | ∃ v : Fin 2 → ZMod N, v ≠ 0 ∧ g = fricke v}) ∧
        Qi i ≠ 0 ∧ Gi i * Qi i = Pi i) ∧
      (∀ i k m, (pi i k).coeff m ∈ kN) ∧
      (∀ i τ, Gi i τ ^ di i +
        ∑ k : Fin (di i), (pi i k).eval (jf τ) * Gi i τ ^ (k : ℕ) = 0) := by sorry
