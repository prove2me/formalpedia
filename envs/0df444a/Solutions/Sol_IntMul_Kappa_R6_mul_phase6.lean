open IntMul KFC KFB KFT KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- A block moved twice arrives in order. -/
theorem mv2_runs {Cn X Y Z : Fin HS} (h1 : MvOk Cn X Y) (h2 : MvOk Cn Y Z) (hXZ : X ≠ Z)
    (L : List ℤ) (B : ℕ) (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (LX LC : List Item)
    (hX : s.G X = ints L ++ LX) (hC : s.G Cn = .int (L.length : ℤ) :: LC) :
    IRuns I iprog (.seq (mvNU Cn X Y) (mvNU Cn Y Z)) s
      ((s.upd X LX).upd Z (ints L ++ s.G Z)) (2 * cMvN L.length B) := by
  have r1 := mvNU_runs (I := I) (iprog := iprog) h1 L B hB s LX LC hX hC
  have hB' : ∀ x ∈ L.reverse, zsz x ≤ B := fun x hx => hB x (List.mem_reverse.1 hx)
  have r2 := mvNU_runs (I := I) (iprog := iprog) h2 L.reverse B hB'
    ((s.upd X LX).upd Y (ints L.reverse ++ s.G Y)) (s.G Y) LC (by simp)
    (by simp [IState.upd_G, h1.c.2.1, h1.c.2.2, hC])
  rw [List.length_reverse] at r2
  have a1 := h1.xy; have a2 := h2.xy
  refine (r1.seq r2).mono' ?_ (by omega)
  apply IState.ext' <;> intros <;>
    simp only [IState.upd_G, IState.upd_ip, IState.upd_out, List.reverse_reverse] <;>
    split_ifs <;> simp_all

