/-!
# Array model, Stage 2: runs of pivots as single interchanges of merged fields

Builds on `Solutions/AModel.lean` (whose definitions are unchanged).

* §1 Reshape (`mergeShape`, `mergeAddr`, `splitAddr`): merging adjacent fields is free —
  `pull_merge`, `pull_split`, general `pull_reshape`.
* §2 Block swap (`blockSwap`): it is the composition of the single position swaps
  (`chain_runPairs`), and after merging both runs it is one swap of two merged fields
  (`merge2_blockSwap`, `pull_blockSwap`).
* §3 A run of `r` consecutive pivots on contiguous active fields acts on arrays as that block swap
  (`runArr_pivotRun`), hence as one merged-field interchange (`runArr_pivotRun_merged`).
* §4 A pivot list splits into `numRuns` maximal runs (`groupRuns`, `flatMap_groupRuns`), and
  `runArr` over its swaps is the composition of one merged-field swap per run
  (`runArr_swapSteps_runs`).
-/

namespace AModel

/-! ## 1. Reshape -/

section Reshape

set_option linter.unnecessarySimpa false in
lemma encode_congr {A : Shape} {c c' : List ℕ} (h : ∀ k < A.length, c.getD k 0 = c'.getD k 0) :
    encode A c = encode A c' := by
  induction A generalizing c c' with
  | nil => rfl
  | cons q A ih =>
    simp only [encode]
    have h0 := h 0 (by simp)
    have ht : encode A c.tail = encode A c'.tail := by
      apply ih; intro k hk
      have := h (k + 1) (by simp; omega)
      rcases c with _ | ⟨x, c⟩ <;> rcases c' with _ | ⟨y, c'⟩ <;>
        simpa [List.getD_eq_getElem?_getD] using this
    have hh : c.headD 0 = c'.headD 0 := by
      rcases c with _ | ⟨x, c⟩ <;> rcases c' with _ | ⟨y, c'⟩ <;>
        simpa [List.getD_eq_getElem?_getD] using h0
    rw [ht, hh]

lemma encode_append (A B : Shape) (c : List ℕ) :
    encode (A ++ B) c = encode A c * vol B + encode B (c.drop A.length) := by
  induction A generalizing c with
  | nil => simp [encode]
  | cons q A ih =>
    simp only [List.cons_append, encode, ih, vol_append, List.length_cons]
    rw [show c.drop (A.length + 1) = c.tail.drop A.length by cases c <;> simp]
    ring

lemma valid_append {A B : Shape} {a b : List ℕ} (ha : Valid A a) (hb : Valid B b) :
    Valid (A ++ B) (a ++ b) := List.rel_append ha hb

end Reshape

