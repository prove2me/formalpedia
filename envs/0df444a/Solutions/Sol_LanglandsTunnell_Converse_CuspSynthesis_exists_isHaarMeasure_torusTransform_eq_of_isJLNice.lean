  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0853 (d : JLData K S epsS ω) (w : InfinitePlace K) (hw : w.IsReal)
    (g : AdelicGL2 (𝓞 K) K) :
    realComponent w hw (globalPoints (𝓞 K) K (weylA d) * g) =
      ArchR.weyl * (ArchR.diagOne (-(ringEquivRealOfIsReal hw (algebraMap K w.Completion (d.A : K)))) *
        realComponent w hw g) := by
  have hW : ∀ h : AdelicGL2 (𝓞 K) K,
      realComponent w hw (globalPoints (𝓞 K) K (weylGL2 K) * h) = ArchR.weyl * realComponent w hw h := by
    intro h
    rw [t0142, t0142, map_mul, map_mul, Units.val_mul, Matrix.map_mul]
    congr 1
    have h0 : ((0 : AdeleRing (𝓞 K) K).1 w) = 0 := rfl
    have h1 : ((1 : AdeleRing (𝓞 K) K).1 w) = 1 := rfl
    have hneg : ∀ z : AdeleRing (𝓞 K) K, (-z).1 w = -(z.1 w) := fun _ => rfl
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [ArchR.weyl, Matrix.map_apply, archComponent_apply, glArch_apply, globalPoints, weylGL2_coe, h0, h1, hneg]
  rw [weylA, map_mul, mul_assoc, hW, t0219, Units.val_neg, map_neg, map_neg]

private theorem t0854 (d : JLData K S epsS ω) (w : InfinitePlace K)
    (hw : w.IsComplex) (g : AdelicGL2 (𝓞 K) K) :
    complexComponent w hw (globalPoints (𝓞 K) K (weylA d) * g) =
      ArchC.weyl * (ArchC.diagOne (-(ringEquivComplexOfIsComplex hw (algebraMap K w.Completion (d.A : K)))) *
        complexComponent w hw g) := by
  have hW : ∀ h : AdelicGL2 (𝓞 K) K,
      complexComponent w hw (globalPoints (𝓞 K) K (weylGL2 K) * h) = ArchC.weyl * complexComponent w hw h := by
    intro h
    rw [t0143, t0143, map_mul, map_mul, Units.val_mul, Matrix.map_mul]
    congr 1
    have h0 : ((0 : AdeleRing (𝓞 K) K).1 w) = 0 := rfl
    have h1 : ((1 : AdeleRing (𝓞 K) K).1 w) = 1 := rfl
    have hneg : ∀ z : AdeleRing (𝓞 K) K, (-z).1 w = -(z.1 w) := fun _ => rfl
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [ArchC.weyl, Matrix.map_apply, archComponent_apply, glArch_apply, globalPoints, weylGL2_coe, h0, h1, hneg]
  rw [weylA, map_mul, mul_assoc, hW, t0220, Units.val_neg, map_neg, map_neg]

private theorem t0855 {P : RealArchParam} (D : ArchDatumR P) {a : ℝ} (ha : a ≠ 0)
    {M : Matrix (Fin 2) (Fin 2) ℝ} (hM : M.det ≠ 0) (u : ℂ) (b : ZMod 2) (s : ℂ) :
    D.zetaEntire (ArchR.weyl * (ArchR.diagOne a * M)) (-(u + P.centralExponent)) (b + P.centralSign) (1 - s) =
      (P.twist u b).epsilonFactor * D.zetaEntire (ArchR.diagOne a * M) u b s := by
  refine D.functional_equation _ u b s ?_
  rw [Matrix.det_mul]
  refine mul_ne_zero ?_ hM
  simp [ArchR.diagOne, Matrix.det_fin_two_of, ha]

private theorem t0856 {P : ComplexArchParam} (D : ArchDatumC P) {a : ℂ}
    (ha : a ≠ 0) {M : Matrix (Fin 2) (Fin 2) ℂ} (hM : M.det ≠ 0) (u : ℂ) (k : ℤ) (s : ℂ) :
    D.zetaEntire (ArchC.weyl * (ArchC.diagOne a * M)) (-(u + P.centralExponent)) (-(k + P.centralTwist)) (1 - s) =
      (P.twist u k).epsilonFactor * D.zetaEntire (ArchC.diagOne a * M) u k s := by
  refine D.functional_equation _ u k s ?_
  rw [Matrix.det_mul]
  refine mul_ne_zero ?_ hM
  simp [ArchC.diagOne, Matrix.det_fin_two_of, ha]

private theorem t0857 {μ ν : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K} {u u' : ℂ} {m m' : ℤ}
    (hμ : IsArchCompAt K μ w u m) (hν : IsArchCompAt K ν w u' m') : IsArchCompAt K (μ * ν) w (u + u') (m + m') := by
  intro x
  have hx : ((‖(x : w.Completion)‖ : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (norm_ne_zero_iff.mpr x.ne_zero)
  have he : extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ) ≠ 0 :=
    div_ne_zero ((map_ne_zero _).mpr x.ne_zero) hx
  have h : archLocalChar (μ * ν) w x = archLocalChar μ w x * archLocalChar ν w x := rfl
  rw [h, Units.val_mul, hμ x, hν x, mul_add, Complex.cpow_add _ _ hx, zpow_add₀ he]
  ring

private theorem t0858 {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K} {u : ℂ} {m : ℤ}
    (hμ : IsArchCompAt K μ w u m) : IsArchCompAt K μ⁻¹ w (-u) (-m) := by
  intro x
  have hx : ((‖(x : w.Completion)‖ : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (norm_ne_zero_iff.mpr x.ne_zero)
  have h : archLocalChar μ⁻¹ w x = (archLocalChar μ w x)⁻¹ := rfl
  rw [h, Units.val_inv_eq_inv_val, hμ x, mul_neg, Complex.cpow_neg, zpow_neg, mul_inv]

private theorem t0859 {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K}
    (hw : w.IsReal) {u : ℂ} {m m' : ℤ} (hμ : IsArchCompAt K μ w u m) (hmm : m % 2 = m' % 2) :
    IsArchCompAt K μ w u m' := by
  intro x
  rw [hμ x]
  congr 1
  have hsq : (extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ)) ^ (2 : ℤ) = 1 := by
    have hr : (extensionEmbeddingOfIsReal hw (x : w.Completion) : ℂ) = extensionEmbedding w (x : w.Completion) :=
      extensionEmbeddingOfIsReal_apply hw _
    have hn : ‖(x : w.Completion)‖ = |extensionEmbeddingOfIsReal hw (x : w.Completion)| := by
      rw [← Real.norm_eq_abs, (isometry_extensionEmbeddingOfIsReal hw).norm_map_of_map_zero (map_zero _)]
    have hne : extensionEmbeddingOfIsReal hw (x : w.Completion) ≠ 0 := (map_ne_zero _).mpr x.ne_zero
    rw [← hr, hn, zpow_ofNat]
    rw [div_pow, ← Complex.ofReal_pow, ← Complex.ofReal_pow, sq_abs, div_self]
    exact_mod_cast pow_ne_zero 2 hne
  obtain ⟨t, ht⟩ : ∃ t : ℤ, m' = m + 2 * t := ⟨(m' - m) / 2, by omega⟩
  have he : extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ) ≠ 0 :=
    div_ne_zero ((map_ne_zero _).mpr x.ne_zero)
      (by exact_mod_cast (norm_ne_zero_iff.mpr x.ne_zero))
  rw [ht, zpow_add₀ he, zpow_mul, hsq, one_zpow, mul_one]

private theorem t0860 {μ η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K}
    (hw : w.IsReal) {e u : ℂ} {c a : ZMod 2} (hμ : IsArchCompAt K μ w e (c.val : ℤ))
    (hη : IsArchCompAt K η w u (a.val : ℤ)) :
    IsArchCompAt K (μ * η)⁻¹ w (-(u + e)) ((a + c).val : ℤ) := by
  have h := t0858 (t0857 hμ hη)
  rw [add_comm e u] at h
  refine t0859 hw h ?_
  have hc := ZMod.val_lt c
  have ha := ZMod.val_lt a
  rw [ZMod.val_add]
  omega

private theorem t0861 {μ η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K} {e u : ℂ}
    {c k : ℤ} (hμ : IsArchCompAt K μ w e c) (hη : IsArchCompAt K η w u k) :
    IsArchCompAt K (μ * η)⁻¹ w (-(u + e)) (-(k + c)) := by
  have h := t0858 (t0857 hμ hη)
  rwa [add_comm e u, add_comm c k] at h

private theorem t0862 (P : RealArchParam) (u : ℂ) (a : ZMod 2) :
    (P.twist (-(u + P.centralExponent)) (a + P.centralSign)).gammaR = (P.dual.twist (-u) a).gammaR := by
  cases P with
  | principal u₁ a₁ u₂ a₂ =>
    have h₁ : a₁ + (a + (a₁ + a₂)) = a₂ + a := by revert a a₁ a₂; decide
    have h₂ : a₂ + (a + (a₁ + a₂)) = a₁ + a := by revert a a₁ a₂; decide
    simp only [RealArchParam.twist, RealArchParam.dual, RealArchParam.centralExponent, RealArchParam.centralSign,
      RealArchParam.gammaR, h₁, h₂]
    rw [Multiset.pair_comm]
    congr 2 <;> ring
  | discrete u₀ k hk =>
    simp only [RealArchParam.twist, RealArchParam.dual, RealArchParam.gammaR]

private theorem t0863 (P : RealArchParam) (u : ℂ) (a : ZMod 2) :
    (P.twist (-(u + P.centralExponent)) (a + P.centralSign)).gammaC = (P.dual.twist (-u) a).gammaC := by
  cases P with
  | principal u₁ a₁ u₂ a₂ =>
    simp only [RealArchParam.twist, RealArchParam.dual, RealArchParam.gammaC]
  | discrete u₀ k hk =>
    simp only [RealArchParam.twist, RealArchParam.dual, RealArchParam.centralExponent, RealArchParam.gammaC]
    congr 2
    ring

private theorem t0864 (P : ComplexArchParam) (u : ℂ) (k : ℤ) :
    (P.twist (-(u + P.centralExponent)) (-(k + P.centralTwist))).gammaC = (P.dual.twist (-u) (-k)).gammaC := by
  simp only [ComplexArchParam.twist, ComplexArchParam.dual, ComplexArchParam.centralExponent,
    ComplexArchParam.centralTwist, ComplexArchParam.gammaC]
  rw [Multiset.pair_comm]
  have h₁ : (P.k₁ + -(k + (P.k₁ + P.k₂))).natAbs = (-P.k₂ + -k).natAbs := by omega
  have h₂ : (P.k₂ + -(k + (P.k₁ + P.k₂))).natAbs = (-P.k₁ + -k).natAbs := by omega
  rw [h₁, h₂]
  congr 2 <;> ring

private theorem t0865 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ)
    (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2) (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ)
    (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) (s : ℂ) :
    (twistedDatum K Pi S archR archC χ uR aR uC kC).archFactorDual s =
      (∏ v : {w : InfinitePlace K // w.IsReal},
          ((archR v.1 v.2).twist (-(uR v.1 v.2 + (archR v.1 v.2).centralExponent))
            (aR v.1 v.2 + (archR v.1 v.2).centralSign)).archFactor s) *
        ∏ v : {w : InfinitePlace K // w.IsComplex},
          ((archC v.1 v.2).twist (-(uC v.1 v.2 + (archC v.1 v.2).centralExponent))
            (-(kC v.1 v.2 + (archC v.1 v.2).centralTwist))).archFactor s := by
  show ((twistedGammaR K (fun w hw => (archR w hw).dual) (fun w hw => -uR w hw) aR).map
        fun μ => Complex.Gammaℝ (s + μ)).prod *
      ((twistedGammaC K (fun w hw => (archR w hw).dual) (fun w hw => (archC w hw).dual) (fun w hw => -uR w hw) aR
        (fun w hw => -uC w hw) (fun w hw => -kC w hw)).map fun μ => Complex.Gammaℂ (s + μ)).prod = _
  unfold twistedGammaR twistedGammaC RealArchParam.archFactor ComplexArchParam.archFactor
  simp only [t0862, t0863,
    t0864]
  rw [t0581, Multiset.prod_sum, Multiset.map_add, Multiset.prod_add, t0581,
    Multiset.prod_sum, t0581, Multiset.prod_sum, Finset.prod_mul_distrib]
  ring

private theorem t0866 (d : JLData K S epsS ω)
    (g₀ : AdelicGL2 (𝓞 K) K) (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ)
    (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2) (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ)
    (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) (s : ℂ) :
    (∏ v : {w : InfinitePlace K // w.IsReal},
        (dR v.1 v.2).zetaEntire (realComponent v.1 v.2 (globalPoints (𝓞 K) K (weylA d) * g₀))
          (-(uR v.1 v.2 + (archR v.1 v.2).centralExponent)) (aR v.1 v.2 + (archR v.1 v.2).centralSign) (1 - s)) *
      ∏ v : {w : InfinitePlace K // w.IsComplex},
        (dC v.1 v.2).zetaEntire (complexComponent v.1 v.2 (globalPoints (𝓞 K) K (weylA d) * g₀))
          (-(uC v.1 v.2 + (archC v.1 v.2).centralExponent)) (-(kC v.1 v.2 + (archC v.1 v.2).centralTwist)) (1 - s) =
      archRootNumber K archR archC uR aR uC kC *
        ((∏ v : {w : InfinitePlace K // w.IsReal},
            (ArchR.quasiChar (uR v.1 v.2) (aR v.1 v.2)
                (-(ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
              ((|ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))| : ℝ) : ℂ) ^ (1 - s)) *
          ∏ v : {w : InfinitePlace K // w.IsComplex},
            (ArchC.quasiChar (uC v.1 v.2) (kC v.1 v.2)
                (-(ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
              ((‖ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))‖ ^ 2 : ℝ) : ℂ) ^ (1 - s)) *
        ((∏ v : {w : InfinitePlace K // w.IsReal},
            (dR v.1 v.2).zetaEntire (realComponent v.1 v.2 g₀) (uR v.1 v.2) (aR v.1 v.2) s) *
          ∏ v : {w : InfinitePlace K // w.IsComplex},
            (dC v.1 v.2).zetaEntire (complexComponent v.1 v.2 g₀) (uC v.1 v.2) (kC v.1 v.2) s) := by
  have hA : (d.A : K) ≠ 0 := d.A.ne_zero
  have hreal : ∀ v : {w : InfinitePlace K // w.IsReal},
      (dR v.1 v.2).zetaEntire (realComponent v.1 v.2 (globalPoints (𝓞 K) K (weylA d) * g₀))
          (-(uR v.1 v.2 + (archR v.1 v.2).centralExponent)) (aR v.1 v.2 + (archR v.1 v.2).centralSign) (1 - s) =
        ((archR v.1 v.2).twist (uR v.1 v.2) (aR v.1 v.2)).epsilonFactor *
          ((ArchR.quasiChar (uR v.1 v.2) (aR v.1 v.2)
              (-(ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
            ((|ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))| : ℝ) : ℂ) ^ (1 - s) *
            (dR v.1 v.2).zetaEntire (realComponent v.1 v.2 g₀) (uR v.1 v.2) (aR v.1 v.2) s) := by
    intro v
    have ha : -(ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))) ≠ 0 :=
      neg_ne_zero.2 ((map_ne_zero _).mpr ((map_ne_zero _).mpr hA))
    rw [t0853 d v.1 v.2 g₀,
      t0855 (dR v.1 v.2) ha (t0144 v.1 v.2 g₀),
      ArchDatumR.zetaEntire_diagOne_mul (dR v.1 v.2) _ _ _ _ _ ha (t0144 v.1 v.2 g₀), abs_neg]
  have hcomplex : ∀ v : {w : InfinitePlace K // w.IsComplex},
      (dC v.1 v.2).zetaEntire (complexComponent v.1 v.2 (globalPoints (𝓞 K) K (weylA d) * g₀))
          (-(uC v.1 v.2 + (archC v.1 v.2).centralExponent)) (-(kC v.1 v.2 + (archC v.1 v.2).centralTwist)) (1 - s) =
        ((archC v.1 v.2).twist (uC v.1 v.2) (kC v.1 v.2)).epsilonFactor *
          ((ArchC.quasiChar (uC v.1 v.2) (kC v.1 v.2)
              (-(ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
            ((‖ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))‖ ^ 2 : ℝ) : ℂ) ^ (1 - s) *
            (dC v.1 v.2).zetaEntire (complexComponent v.1 v.2 g₀) (uC v.1 v.2) (kC v.1 v.2) s) := by
    intro v
    have ha : -(ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))) ≠ 0 :=
      neg_ne_zero.2 ((map_ne_zero _).mpr ((map_ne_zero _).mpr hA))
    rw [t0854 d v.1 v.2 g₀,
      t0856 (dC v.1 v.2) ha (t0145 v.1 v.2 g₀),
      ArchDatumC.zetaEntire_diagOne_mul (dC v.1 v.2) _ _ _ _ _ ha (t0145 v.1 v.2 g₀),
      norm_neg]
  rw [Finset.prod_congr rfl fun v _ => hreal v, Finset.prod_congr rfl fun v _ => hcomplex v]
  simp only [Finset.prod_mul_distrib]
  unfold archRootNumber
  ring

private theorem t0867 {ι : Type*} (t : Finset ι) (f : ι → ℝ) (hf : ∀ i, 0 ≤ f i) (r : ℂ) :
    ((∏ i ∈ t, f i : ℝ) : ℂ) ^ r = ∏ i ∈ t, ((f i : ℝ) : ℂ) ^ r := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | insert a t ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, Complex.ofReal_mul,
      Complex.mul_cpow_ofReal_nonneg (hf a) (Finset.prod_nonneg fun i _ => hf i) r, ih]

private theorem t0868 (d : JLData K S epsS ω) (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ)
    (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2) (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ)
    (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) (s : ℂ) :
    (∏ v : {w : InfinitePlace K // w.IsReal},
        (ArchR.quasiChar (uR v.1 v.2) (aR v.1 v.2)
                (-(ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
          ((|ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))| : ℝ) : ℂ) ^ (1 - s)) *
      ∏ v : {w : InfinitePlace K // w.IsComplex},
        (ArchC.quasiChar (uC v.1 v.2) (kC v.1 v.2)
                (-(ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K)))))⁻¹ *
          ((‖ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))‖ ^ 2 : ℝ) : ℂ) ^ (1 - s)
      = ((∏ v : {w : InfinitePlace K // w.IsReal},
            (ArchR.quasiChar (uR v.1 v.2) (aR v.1 v.2)
                (-(ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K)))))) *
          ∏ v : {w : InfinitePlace K // w.IsComplex},
            (ArchC.quasiChar (uC v.1 v.2) (kC v.1 v.2)
                (-(ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))))))⁻¹ *
        ((((∏ v : {w : InfinitePlace K // w.IsReal},
              |ringEquivRealOfIsReal v.2 (algebraMap K v.1.Completion (d.A : K))|) *
            ∏ v : {w : InfinitePlace K // w.IsComplex},
              ‖ringEquivComplexOfIsComplex v.2 (algebraMap K v.1.Completion (d.A : K))‖ ^ 2 : ℝ)) : ℂ) ^ (1 - s) := by
  rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_inv_distrib, Finset.prod_inv_distrib,
    Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (Finset.prod_nonneg fun v _ => abs_nonneg _)
      (Finset.prod_nonneg fun v _ => sq_nonneg _) (1 - s),
    t0867 _ _ (fun v => abs_nonneg _), t0867 _ _ (fun v => sq_nonneg _),
    mul_inv]
  ring

