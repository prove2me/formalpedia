/-! ## Expression values and frames -/

/-- No expression of the frame reads a register pushed earlier in the frame. -/
def NoRd : List (Fin HS) → List (Fin HS × Ex HS × ℤ) → Prop
  | _, [] => True
  | pre, x :: l => (∀ j ∈ x.2.1.regs, j ∉ pre) ∧ NoRd (x.1 :: pre) l

