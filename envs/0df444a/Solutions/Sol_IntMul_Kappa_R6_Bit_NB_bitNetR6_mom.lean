-- Source module: Solutions.R6BitNBProjB
/-!
# Round six, bit network: projectors of the codes

The codes of the local generator name projectors on `ℚ^23` (`Pc`): `LOW = 0`, `HIGH = 1`,
`PT T = 1 - Pl T` (the hyperplane `B`-orthogonal to triple `T`), `ND n` the `B`-orthogonal projector
onto the span of the triples of node `n` (`Pnd (supG n)`). The dimension records certify both the
dimension of every node span and a common point (centre) of its triples, so `Pnd` is a projector of
rank `dimN n`. A move allowed by `nestOK` is between nested projectors; its difference `Dm` is an
idempotent of rank `rkC` with `Dm + P_old - 2 Dm P_old = P_new`.
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Module R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-! ## Dimension records: dimension and centre -/

theorem recBody_centre {sup c d md Q P : ℕ} {L : List (ℕ × ℕ × ℕ)} {I : List ℕ}
    (h : recBody sup c d md Q L I P = true) : HasCentre sup := by
  simp only [recBody, Bool.and_eq_true, blt_dec, decide_eq_true_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hc, -⟩, -⟩, -⟩, -⟩, halw⟩, -⟩, -⟩ := h
  refine ⟨c, hc, fun i hi => ?_⟩
  have ha : (alw c L).testBit i = true := by
    have := congrArg (fun z => z.testBit i) halw
    simp only [nland, Nat.testBit_and, hi, Bool.true_and] at this
    exact this
  rw [alw, nland, Nat.testBit_and, Bool.and_eq_true] at ha
  exact star_bit hc ha.1

theorem recChk_full {sup R : ℕ} (h : recChk sup R = true) :
    finrank ℚ (spanS sup) = fieldOf R 8 1 ∧ HasCentre sup :=
  ⟨recChk_sound h, recBody_centre h⟩

theorem recsChk_full (sg : ℕ → ℕ) : ∀ cnt k s, recsChk sg cnt k s = true →
    ∀ p ∈ R6Chk.Bit.recsDec cnt k s, finrank ℚ (spanS (sg p.1)) = p.2 ∧ HasCentre (sg p.1)
  | 0, _, _, _, p, hp => by simp [R6Chk.Bit.recsDec] at hp
  | cnt + 1, k, s, h, p, hp => by
    have h' : recChk (sg k) s = true ∧ recsChk sg cnt (Nat.succ k) (Nat.shiftRight s (recLen s)) = true := by
      simpa [recsChk] using h
    have hp' : p = (k, fieldOf s 8 1) ∨
        p ∈ R6Chk.Bit.recsDec cnt (Nat.succ k) (Nat.shiftRight s (recLen s)) := by
      simpa [R6Chk.Bit.recsDec] using hp
    rcases hp' with rfl | hp'
    · exact recChk_full h'.1
    · exact recsChk_full sg cnt _ _ h'.2 p hp'

theorem dimAll_full : ∀ p ∈ dimAll, finrank ℚ (spanS (supG p.1)) = p.2 ∧ HasCentre (supG p.1) := by
  intro p hp
  simp only [dimAll, dimChunks, List.mem_flatMap, List.mem_append] at hp
  obtain ⟨c, hc, G, hG, hp⟩ := hp
  have hok : allL (dimChk supG) c = true := by
    rcases hc with (hc | hc) | hc
    · exact Dim0.chunks_ok c hc
    · exact Dim1.chunks_ok c hc
    · exact Dim2.chunks_ok c hc
  exact recsChk_full supG _ _ _ (allL_spec hok G hG) p hp

theorem covFold : ∀ (l : List (ℕ × ℕ)) (j : ℕ),
    (l.foldl covStep (true, j)).1 = true →
      (l.foldl covStep (true, j)).2 = j + l.length ∧
        ∀ i (hi : i < l.length), l[i].1 = j + i ∧ dimN l[i].1 = l[i].2
  | [], j, _ => ⟨rfl, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  | p :: l, j, h => by
    have hflag : ∀ (l : List (ℕ × ℕ)) (a : Bool × ℕ), (l.foldl covStep a).1 = true → a.1 = true := by
      intro l
      induction l with
      | nil => intro a h; exact h
      | cons q l ih => intro a h; have := ih _ h; simp only [covStep, Bool.and_eq_true] at this; exact this.1.1
    have hstep := hflag l _ h
    simp only [List.foldl_cons] at h ⊢
    simp only [covStep, Bool.and_eq_true, Nat.beq_eq] at hstep
    obtain ⟨⟨-, h1⟩, h2⟩ := hstep
    have e : covStep (true, j) p = (true, j + 1) := by
      simp [covStep, h1, ← h2]
    rw [e] at h ⊢
    obtain ⟨ih1, ih2⟩ := covFold l (j + 1) h
    refine ⟨by rw [ih1]; simp; omega, fun i hi => ?_⟩
    cases i with
    | zero => exact ⟨by simpa using h1, h2⟩
    | succ i =>
      obtain ⟨a, b⟩ := ih2 i (by simpa using hi)
      exact ⟨by simp only [List.getElem_cons_succ]; rw [a]; omega, by simpa using b⟩

/-- **Node spans**: dimension `dimN n` and a centre, for every node `n < 36513`. -/
theorem node_facts {n : ℕ} (hn : n < 36513) :
    finrank ℚ (spanS (supG n)) = dimN n ∧ HasCentre (supG n) := by
  have hc := cov_chk
  simp only [Bool.and_eq_true, Nat.ble_eq] at hc
  obtain ⟨hb, hlen⟩ := hc
  obtain ⟨e1, e2⟩ := covFold dimAll 0 hb
  have hn' : n < dimAll.length := by rw [e1] at hlen; omega
  obtain ⟨a, b⟩ := e2 n hn'
  have hmem := dimAll_full _ (List.getElem_mem hn')
  rw [a, zero_add] at hmem b
  rw [b]; exact hmem

/-! ## Table lookups -/

theorem dimF_eq (n : ℕ) (hn : n < 65536) : dimF n = dimN n := by
  have e1 : Nat.shiftRight n 13 = n / 8192 := by rw [nshr, Nat.shiftRight_eq_div_pow]
  have e2 : Nat.land n 8191 = n % 8192 := by
    rw [nland, show (8191 : ℕ) = 2 ^ 13 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]
  rw [dimF, dimTr, e1, e2, ltGet_mkTree, show (40960 : ℕ) = 5 * 2 ^ 13 from rfl,
    fieldOf_fieldOf DIMT 5 13 _ (n % 8192) (by have := Nat.mod_lt n (show 8192 > 0 by norm_num); simpa using this),
    dimN]
  congr 1
  have : n / 8192 < 8 := by omega
  rw [Nat.mod_eq_of_lt (show n / 8192 < 2 ^ 3 by simpa using this)]
  simp only [show (2 : ℕ) ^ 13 = 8192 from rfl, show (2 : ℕ) ^ 3 = 8 from rfl]
  omega

/-! ## Arguments of gates -/

theorem argF_small {n : ℕ} (hn : n < 1772) : argF n = 0 := by
  have h := argChk_ok
  simp only [argChk, Bool.and_eq_true, List.all_eq_true, List.mem_range, Nat.beq_eq] at h
  exact h.2 n hn

theorem argF_gate_aux (l : List (ℕ × ℕ × ℕ)) (hlen : l.length = 34741)
    (hall : ∀ x ∈ l.zip (List.range' 1772 34741), argOK x = true) {n : ℕ} (h1 : 1772 ≤ n) (h2 : n < 36513) :
    ∃ a b, (n, a, b) ∈ l ∧ a < 65536 ∧ b < 65536 ∧ argF n = a + 65536 * b := by
  have hk : n - 1772 < (l.zip (List.range' 1772 34741)).length := by
    simp only [List.length_zip, hlen, List.length_range']; omega
  have hok := hall _ (List.getElem_mem hk)
  rw [List.getElem_zip] at hok
  simp only [argOK, Bool.and_eq_true, Nat.beq_eq, blt_dec, decide_eq_true_eq, List.getElem_range'] at hok
  obtain ⟨⟨⟨e1, e2⟩, e3⟩, e4⟩ := hok
  have hn : 1772 + 1 * (n - 1772) = n := by omega
  rw [hn] at e1 e4
  have hl : n - 1772 < l.length := by rw [hlen]; omega
  refine ⟨_, _, ?_, e2, e3, e4⟩
  have := List.getElem_mem hl
  rwa [show l[n - 1772] = (n, (l[n - 1772]).2.1, (l[n - 1772]).2.2) from Prod.ext e1 rfl] at this

theorem argF_gate {n : ℕ} (h1 : 1772 ≤ n) (h2 : n < 36513) :
    ∃ a b, (n, a, b) ∈ dagGL ∧ a < 65536 ∧ b < 65536 ∧ argF n = a + 65536 * b := by
  obtain ⟨l, hl⟩ : ∃ l, l = dagGL := ⟨_, rfl⟩
  have h := argChk_ok
  rw [argChk, ← hl] at h
  simp only [Bool.and_eq_true, List.all_eq_true, Nat.beq_eq] at h
  rw [← hl]
  exact argF_gate_aux l h.1.1 h.1.2 h1 h2

theorem spanS_zero : spanS 0 = ⊥ := by
  rw [spanS, Submodule.span_eq_bot]
  rintro v ⟨i, hi, -⟩
  simp at hi

/-- **Argument nesting.** -/
theorem argRel_sound {a n : ℕ} (hn : n < 36513) (h : argRel a n = true) :
    spanS (supG a) ≤ spanS (supG n) := by
  simp only [argRel, Bool.or_eq_true, Nat.beq_eq] at h
  by_cases hs : n < 1772
  · rw [argF_small hs] at h
    have ha : a = 0 := by
      rcases h with h | h
      · rw [← h]; rfl
      · rw [← h]; rfl
    subst ha
    rw [supG_zero, spanS_zero]; exact bot_le
  · obtain ⟨a1, a2, hg, h1, h2, e⟩ := argF_gate (by omega) hn
    have hgate := gate_nest (gateOK_of_mem_dagGL hg)
    rw [e] at h
    have l1 : Nat.land (a1 + 65536 * a2) 65535 = a1 := by
      rw [nland, show (65535 : ℕ) = 2 ^ 16 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]; omega
    have l2 : Nat.shiftRight (a1 + 65536 * a2) 16 = a2 := by
      rw [nshr, Nat.shiftRight_eq_div_pow]; norm_num; omega
    rw [l1, l2] at h
    rcases h with rfl | rfl
    · exact hgate.1
    · exact hgate.2

/-! ## Orthogonality to a triple -/

theorem tri_pts {T : ℕ} (hT : T < 1771) :
    pts T 0 < 23 ∧ pts T 1 < 23 ∧ pts T 2 < 23 ∧
      ∀ p, (tri T).testBit p = (decide (pts T 0 = p) || decide (pts T 1 = p) || decide (pts T 2 = p)) := by
  have h := ptsChk_ok
  simp only [ptsChk, List.all_eq_true, List.mem_range, Bool.and_eq_true, blt_dec, decide_eq_true_eq,
    Nat.beq_eq] at h
  obtain ⟨⟨⟨h0, h1⟩, h2⟩, e⟩ := h T hT
  refine ⟨h0, h1, h2, fun p => ?_⟩
  rw [e, nlor', nlor', shl1, shl1, shl1, Nat.testBit_or, Nat.testBit_or, Nat.testBit_two_pow,
    Nat.testBit_two_pow, Nat.testBit_two_pow]

theorem exclT_bit {c t1 t2 i : ℕ} :
    (exclT c t1 t2).testBit i =
      ((Bit.star c).testBit i && !((Bit.star t1).testBit i || (Bit.star t2).testBit i)) := by
  rw [exclT, nxor, nland, nlor', Nat.testBit_xor, Nat.testBit_and, Nat.testBit_or]
  cases (Bit.star c).testBit i <;> cases (Bit.star t1).testBit i <;> cases (Bit.star t2).testBit i <;> rfl

theorem not_tri_of_star {c i : ℕ} (hc : c < 23) (hi : i < 1771) (h : (Bit.star c).testBit i = false) :
    (tri i).testBit c = false := by
  by_contra h'
  rw [Bool.not_eq_false] at h'
  rw [star_of_tri hc hi h'] at h
  exact absurd h (by decide)

theorem orth_excl {T i k0 k1 k2 : ℕ} (hT : T < 1771) (hk : ∀ p, pts T 0 = p ∨ pts T 1 = p ∨ pts T 2 = p ↔
      p = k0 ∨ p = k1 ∨ p = k2) (h0 : k0 < 23) (h1 : k1 < 23) (h2 : k2 < 23)
    (h : (exclT k0 k1 k2).testBit i = true) : i < 1771 ∧ bfF (xv T) (tvQ i) = 0 := by
  rw [exclT_bit, Bool.and_eq_true, Bool.not_eq_true', Bool.or_eq_false_iff] at h
  obtain ⟨ha, hb, hc⟩ := h
  obtain ⟨hi, ha'⟩ := star_bit h0 ha
  have hb' := not_tri_of_star h1 hi hb
  have hc' := not_tri_of_star h2 hi hc
  refine ⟨hi, ?_⟩
  obtain ⟨-, -, -, htri⟩ := tri_pts hT
  have hset : F (tri T) ∩ F (tri i) = {⟨k0, h0⟩} := by
    ext p
    simp only [Finset.mem_inter, mem_F, Finset.mem_singleton, htri, Bool.or_eq_true,
      decide_eq_true_eq]
    rw [or_assoc, hk p.val]
    constructor
    · rintro ⟨hp | hp | hp, hq⟩
      · exact Fin.ext hp
      · rw [hp] at hq; rw [hq] at hb'; exact absurd hb' (by decide)
      · rw [hp] at hq; rw [hq] at hc'; exact absurd hc' (by decide)
    · rintro rfl; exact ⟨Or.inl rfl, ha'⟩
  rw [xv, bf_tvQ hT hi, hset]; simp

theorem orthT_bit {T i : ℕ} (hT : T < 1771) (h : (orthT T).testBit i = true) :
    i < 1771 ∧ bfF (xv T) (tvQ i) = 0 := by
  obtain ⟨p0, p1, p2, -⟩ := tri_pts hT
  rw [orthT, nlor', nlor', Nat.testBit_or, Nat.testBit_or, Bool.or_eq_true, Bool.or_eq_true] at h
  rcases h with (h | h) | h
  · exact orth_excl hT (fun p => by constructor <;> intro h <;> omega) p0 p1 p2 h
  · exact orth_excl hT (fun p => by constructor <;> intro h <;> omega) p1 p0 p2 h
  · exact orth_excl hT (fun p => by constructor <;> intro h <;> omega) p2 p0 p1 h

theorem spanS_orth {sup T : ℕ} (h : ∀ i, sup.testBit i = true → bfF (xv T) (tvQ i) = 0) :
    ∀ v ∈ spanS sup, bfF (xv T) v = 0 := by
  have hle : spanS sup ≤ LinearMap.ker (Bf (xv T)) := by
    rw [spanS, Submodule.span_le]
    rintro v ⟨i, hi, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, Bf_apply]
    exact h i hi
  intro v hv
  have := hle hv
  rwa [LinearMap.mem_ker, Bf_apply] at this

theorem orthOK_sound {n T : ℕ} (hT : T < 1771) (h : orthOK n T = true) :
    ∀ v ∈ spanS (supG n), bfF (xv T) v = 0 := by
  apply spanS_orth
  intro i hi
  simp only [orthOK, Nat.beq_eq] at h
  have : (supG n &&& orthT T).testBit i = true := by rw [← nland, h]; exact hi
  rw [Nat.testBit_and, Bool.and_eq_true] at this
  exact (orthT_bit hT this.2).2

/-! ## Ranks of idempotents -/

theorem rank_idem {n : ℕ} {P : Matrix (Fin n) (Fin n) ℚ} (h : P * P = P) : (P.rank : ℚ) = P.trace := by
  have he : IsIdempotentElem (Matrix.toLin' P) := by
    unfold IsIdempotentElem
    rw [Module.End.mul_eq_comp, ← Matrix.toLin'_mul, h]
  have := LinearMap.IsProj.trace (LinearMap.IsIdempotentElem.isProj_range _ he)
  rw [Matrix.trace_toLin'_eq] at this
  rw [this]; rfl

theorem le_sub_idem {n : ℕ} {A B : Matrix (Fin n) (Fin n) ℚ} (hA : A * A = A) (hB : B * B = B)
    (h : Le A B) : (B - A) * (B - A) = B - A := by
  obtain ⟨h1, h2⟩ := h
  rw [sub_mul, mul_sub, mul_sub, hA, hB, h1, h2]; abel

theorem le_rank {n : ℕ} {A B : Matrix (Fin n) (Fin n) ℚ} (hA : A * A = A) (hB : B * B = B)
    (h : Le A B) : A.rank ≤ B.rank ∧ (B - A).rank = B.rank - A.rank := by
  have hD := le_sub_idem hA hB h
  have e := rank_idem hD
  rw [Matrix.trace_sub, ← rank_idem hA, ← rank_idem hB] at e
  have hle : A.rank ≤ B.rank := by
    have : (0 : ℚ) ≤ (B.rank : ℚ) - A.rank := by rw [← e]; positivity
    exact_mod_cast (sub_nonneg.1 this)
  refine ⟨hle, ?_⟩
  have : ((B - A).rank : ℚ) = ((B.rank - A.rank : ℕ) : ℚ) := by rw [e, Nat.cast_sub hle]
  exact_mod_cast this

theorem le_eq_of_rank {n : ℕ} {A B : Matrix (Fin n) (Fin n) ℚ} (hA : A * A = A) (hB : B * B = B)
    (h : Le A B) (hr : B.rank ≤ A.rank) : B = A := by
  have h0 : (B - A).rank = 0 := by rw [(le_rank hA hB h).2]; omega
  have h1 : LinearMap.range (B - A).mulVecLin = ⊥ := Submodule.finrank_eq_zero.1 h0
  have h2 : (B - A).mulVecLin = 0 := LinearMap.range_eq_bot.1 h1
  have : B - A = 0 := by
    ext i j
    have := congrArg (fun f => f (Pi.single j 1) i) h2
    simpa [Matrix.mulVec_single] using this
  exact sub_eq_zero.1 this

/-! ## The code projectors -/

theorem Pc_low : Pc 0 = 0 := by simp [Pc]
theorem Pc_high : Pc 1 = 1 := by simp [Pc]

theorem Pl_rank {T : ℕ} (hT : T < 1771) : (Pl T).rank = 1 := by
  have := rank_idem (Pl_idem hT)
  rw [Pl, Matrix.trace_vecMulVec, dotProduct_comm, yx hT] at this
  exact_mod_cast this

theorem one_sub_idem {n : ℕ} {P : Matrix (Fin n) (Fin n) ℚ} (h : P * P = P) : (1 - P) * (1 - P) = 1 - P := by
  rw [sub_mul, mul_sub, mul_sub, h]; simp

theorem compl_rank {T : ℕ} (hT : T < 1771) : (1 - Pl T).rank = 22 := by
  have := rank_idem (one_sub_idem (Pl_idem hT))
  rw [Matrix.trace_sub, Matrix.trace_one, ← rank_idem (Pl_idem hT), Pl_rank hT] at this
  simp at this; norm_num at this
  exact_mod_cast this

theorem nd_facts {c : ℕ} (h1 : 1773 ≤ c) (h2 : c < 38286) :
    Pc c = Pnd (supG (c - 1773)) ∧ HasCentre (supG (c - 1773)) ∧ (Pc c).rank = dimCF c := by
  have hP : Pc c = Pnd (supG (c - 1773)) := by
    rw [Pc, if_neg (by omega), if_neg (by omega), if_neg (by omega)]
  obtain ⟨hd, hc⟩ := node_facts (n := c - 1773) (by omega)
  refine ⟨hP, hc, ?_⟩
  rw [hP, Pnd_rank hc, hd, dimCF]
  have : Nat.beq c 0 = false := Bool.eq_false_iff.2 (fun e => by rw [Nat.beq_eq] at e; omega)
  have : Nat.beq c 1 = false := Bool.eq_false_iff.2 (fun e => by rw [Nat.beq_eq] at e; omega)
  have : Nat.blt c 1773 = false := Bool.eq_false_iff.2 (fun e => by rw [Nat.blt_eq] at e; omega)
  simp only [*, cond_false, nsub]
  rw [dimF_eq _ (by omega)]

theorem pt_facts {c : ℕ} (h1 : 2 ≤ c) (h2 : c < 1773) :
    Pc c = 1 - Pl (c - 2) ∧ c - 2 < 1771 ∧ (Pc c).rank = dimCF c := by
  have hP : Pc c = 1 - Pl (c - 2) := by
    rw [Pc, if_neg (by omega), if_neg (by omega), if_pos h2]
  refine ⟨hP, by omega, ?_⟩
  rw [hP, compl_rank (by omega), dimCF]
  have : Nat.beq c 0 = false := Bool.eq_false_iff.2 (fun e => by rw [Nat.beq_eq] at e; omega)
  have : Nat.beq c 1 = false := Bool.eq_false_iff.2 (fun e => by rw [Nat.beq_eq] at e; omega)
  have : Nat.blt c 1773 = true := by rw [Nat.blt_eq]; exact h2
  simp only [*, cond_false, cond_true]

theorem Pc_idem {c : ℕ} (hc : c < 38286) : Pc c * Pc c = Pc c := by
  by_cases h0 : c = 0
  · subst h0; simp [Pc]
  by_cases h1 : c = 1
  · subst h1; simp [Pc]
  by_cases h2 : c < 1773
  · rw [(pt_facts (by omega) h2).1]; exact one_sub_idem (Pl_idem (by omega))
  · obtain ⟨e, hc', -⟩ := nd_facts (by omega) hc
    rw [e]; exact Pnd_idem hc'

theorem Pc_rank {c : ℕ} (hc : c < 38286) : (Pc c).rank = dimCF c := by
  by_cases h0 : c = 0
  · subst h0; simp [Pc, dimCF]
  by_cases h1 : c = 1
  · subst h1; rw [Pc_high, Matrix.rank_one, Fintype.card_fin]; rfl
  by_cases h2 : c < 1773
  · exact (pt_facts (by omega) h2).2.2
  · exact (nd_facts (by omega) hc).2.2

/-! ## Moves -/

theorem le_zero {n : ℕ} (B : Matrix (Fin n) (Fin n) ℚ) : Le 0 B := by simp [Le]
theorem le_one {n : ℕ} (A : Matrix (Fin n) (Fin n) ℚ) : Le A 1 := by simp [Le]

/-- **Nesting of the moves allowed by `nestOK`.** -/
theorem nest_sound {o c : ℕ} (ho : o < 38286) (hc : c < 38286) (h : nestOK o c = true) :
    Le (Pc o) (Pc c) ∨ Le (Pc c) (Pc o) := by
  simp only [nestOK, isND, isPT, Bool.or_eq_true, Bool.and_eq_true, Nat.ble_eq, blt_dec,
    decide_eq_true_eq] at h
  rcases h with (((ho1 | hc1) | ⟨⟨⟨ho1, -⟩, hc1, -⟩, ha⟩) | ⟨⟨⟨ho1, -⟩, hc1, hc2⟩, hor⟩) | ⟨⟨⟨ho1, ho2⟩, hc1, -⟩, hor⟩
  · rcases (show o = 0 ∨ o = 1 by omega) with rfl | rfl
    · left; rw [Pc_low]; exact le_zero _
    · right; rw [Pc_high]; exact le_one _
  · rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl
    · right; rw [Pc_low]; exact le_zero _
    · left; rw [Pc_high]; exact le_one _
  · obtain ⟨eo, hco, -⟩ := nd_facts ho1 ho
    obtain ⟨ec, hcc, -⟩ := nd_facts hc1 hc
    rw [eo, ec]
    rcases ha with ha | ha
    · left
      exact Pnd_nested hco hcc (argRel_sound (by omega) (by simpa [nsub] using ha))
    · right
      exact Pnd_nested hcc hco (argRel_sound (by omega) (by simpa [nsub] using ha))
  · obtain ⟨eo, hco, -⟩ := nd_facts ho1 ho
    obtain ⟨ec, hT, -⟩ := pt_facts hc1 hc2
    rw [eo, ec]; left
    exact Pnd_orth hco hT (orthOK_sound hT (by simpa [nsub] using hor))
  · obtain ⟨ec, hcc, -⟩ := nd_facts hc1 hc
    obtain ⟨eo, hT, -⟩ := pt_facts ho1 ho2
    rw [eo, ec]; right
    exact Pnd_orth hcc hT (orthOK_sound hT (by simpa [nsub] using hor))

/-- **Move facts**: `Dm` is an idempotent of rank `rkC`, and `Dm + P_o - 2 Dm P_o = P_c`. -/
theorem move_facts {o c : ℕ} (ho : o < 38286) (hc : c < 38286) (h : nestOK o c = true) :
    Dm o c * Dm o c = Dm o c ∧ Dm o c + Pc o - 2 * (Dm o c * Pc o) = Pc c ∧
      (Dm o c).rank = rkC o c := by
  have hio := Pc_idem ho
  have hic := Pc_idem hc
  have hrk : rkC o c = if dimCF o < dimCF c then dimCF c - dimCF o else dimCF o - dimCF c := by
    simp only [rkC]
    by_cases h' : dimCF o < dimCF c
    · rw [if_pos h', show Nat.blt (dimCF o) (dimCF c) = true by rw [Nat.blt_eq]; exact h']; rfl
    · rw [if_neg h', show Nat.blt (dimCF o) (dimCF c) = false from
        Bool.eq_false_iff.2 (fun e => by rw [Nat.blt_eq] at e; exact h' e)]; rfl
  rcases nest_sound ho hc h with hle | hle
  · obtain ⟨hr, hD⟩ := le_rank hio hic hle
    rw [Pc_rank ho, Pc_rank hc] at hr hD
    rw [Dm, if_pos hr]
    refine ⟨le_sub_idem hio hic hle, ?_, ?_⟩
    · rw [sub_mul, hle.1, hio, sub_self, mul_zero, sub_zero, sub_add_cancel]
    · rw [hD, hrk]; split_ifs <;> omega
  · obtain ⟨hr, hD⟩ := le_rank hic hio hle
    rw [Pc_rank ho, Pc_rank hc] at hr hD
    by_cases heq : dimCF o ≤ dimCF c
    · have e : Pc o = Pc c := le_eq_of_rank hic hio hle (by rw [Pc_rank ho, Pc_rank hc]; exact heq)
      rw [Dm, if_pos heq, e]
      refine ⟨by simp, by simp, ?_⟩
      rw [sub_self, Matrix.rank_zero, hrk]; split_ifs <;> omega
    · rw [Dm, if_neg heq]
      refine ⟨le_sub_idem hic hio hle, ?_, ?_⟩
      · rw [sub_mul, hle.2, hio, two_mul]; abel
      · rw [hD, hrk]; split_ifs <;> omega

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBRed
/-!
# Round six, bit network: reduction mod `N` of good rational matrices

`GoodM N A`: all entries of `A` have denominators coprime to `N`. Good matrices form a ring and
`redM N` is multiplicative and additive on them. Partial swaps over `ℚ` multiply as over
`ZMod N` (`pswQ_mul`), and an edge with rational Bruhat data (`EdgeQ e q`, good factors) has
frame matrix `redM N (pswQ q)` (`edgeMat_eq`).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

namespace NB

open Matrix AModelFac AModel

variable {l n p : Type*} [Fintype n] [DecidableEq n]

theorem goodM_mul {N : ℕ} {A : Matrix l n ℚ} {B : Matrix n p ℚ} (hA : GoodM N A) (hB : GoodM N B) :
    GoodM N (A * B) := by
  intro i j
  rw [Matrix.mul_apply]
  exact (goodSub N).sum_mem fun k _ => (goodSub N).mul_mem (hA i k) (hB k j)

theorem toG_val {N : ℕ} {A : Matrix n n ℚ} (hA : GoodM N A) :
    (goodSub N).subtype.mapMatrix (toG N A) = A := by
  ext i j; simp [toG, toGood_val (hA i j)]

theorem toG_mul {N : ℕ} {A B : Matrix n n ℚ} (hA : GoodM N A) (hB : GoodM N B) :
    toG N (A * B) = toG N A * toG N B := by
  apply Matrix.map_injective (f := ((↑) : goodSub N → ℚ)) Subtype.val_injective
  change (goodSub N).subtype.mapMatrix _ = (goodSub N).subtype.mapMatrix _
  rw [map_mul, toG_val hA, toG_val hB, toG_val (goodM_mul hA hB)]

theorem redMap_eq (N : ℕ) (A : Matrix n n ℚ) : A.map (redQ N) = (redHom N).mapMatrix (toG N A) := by
  ext i j; rfl

/-- **Reduction is multiplicative on good matrices.** -/
theorem redMap_mul {N : ℕ} {A B : Matrix n n ℚ} (hA : GoodM N A) (hB : GoodM N B) :
    (A * B).map (redQ N) = A.map (redQ N) * B.map (redQ N) := by
  rw [redMap_eq, redMap_eq, redMap_eq, toG_mul hA hB, map_mul]

theorem redMap_perm (N : ℕ) (σ : Equiv.Perm n) :
    (σ.permMatrix ℚ).map (redQ N) = σ.permMatrix (ZMod N) := by
  ext i j
  simp only [Matrix.map_apply, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply,
    Option.mem_def, Option.some.injEq]
  split_ifs
  · simpa using redQ_intCast N 1
  · exact redQ_zero N

theorem goodM_perm (N : ℕ) (σ : Equiv.Perm n) : GoodM N (σ.permMatrix ℚ) := by
  intro i j
  simp only [Equiv.Perm.permMatrix, PEquiv.toMatrix_apply]
  split_ifs <;> simp

end NB

section Psw

variable {m : ℕ}

open Matrix NB AModel AModelFac

theorem pswQ_zero : pswQ (0 : Matrix (Fin m) (Fin m) ℚ) = 1 := by
  unfold pswQ
  rw [sub_zero, Matrix.fromBlocks_one, Matrix.submatrix_one_equiv]

