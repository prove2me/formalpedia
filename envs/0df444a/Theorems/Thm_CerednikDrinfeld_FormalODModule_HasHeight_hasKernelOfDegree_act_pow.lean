open CerednikDrinfeld CerednikDrinfeld.SpecialFormal

theorem CerednikDrinfeld.FormalODModule.HasHeight.hasKernelOfDegree_act_pow
    {p : ℕ} [Fact p.Prime] {B : Type} [CommRing B] [IsNoetherianRing B]
    {X : FormalODModule p B} {h : ℕ} (hX : X.HasHeight h) (m : ℕ) :
    FormalODModule.HasKernelOfDegree (X.act ((p : Zp2 p) ^ m)) (p ^ (h * m)) := by sorry
