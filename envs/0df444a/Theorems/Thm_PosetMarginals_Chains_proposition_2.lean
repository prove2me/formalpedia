-- title:
--   Proposition 2 — invariants and well-definedness of Algorithm 1
-- statement:
--   Under the finite nonempty poset and standing parameter conditions, every reached state of Algorithm 1 has four properties. First, for every maximal chain $C$, its residual slack is $\delta^k_C=\sum_{x\in C}\rho^k_x-\pi^k_C$, and active chains have nonnegative slack. Second, the active chain family remains closed under splices at points of $X^{k-1}$. Third, the residual targets satisfy the same conservation equation at each such splice. Fourth, the relation generated by the active zero-slack chains is a partial order on $X^k$.
--
--   In symbols, the first and third assertions include
--   $$\delta^k_C=\sum_{x\in C}\rho^k_x-\pi^k_C,\qquad\pi^k_{C^1}+\pi^k_{C^2}=\pi^k_{C^2_1}+\pi^k_{C^1_2}.$$
--
--   These invariants justify the algorithm's construction of a subposet and its next update.
--
--   **Formalization Note** Lean state $k$ is paper stage $k+1$, so the theorem requires all earlier supports to be nonempty; this is the paper's stage range $\llbracket1,n^*+1\rrbracket$. Every common point of two active chains in the previous support is quantified, as in condition (3).
-- source:
--   Dahan, Amin & Jaillet, arXiv:1811.08516v3, p. 13, Proposition 2, eqs. (10)–(12); proof pp. 14–15

import Mathlib
import Definitions.Def_PosetMarginals_Chains_Algorithm

open Classical

namespace PosetMarginals.Chains

/-- Dahan, Amin and Jaillet, Proposition 2, p. 13. Lean state `k` is paper stage `k+1`. -/
theorem proposition_2 {α : Type*} [PartialOrder α] [Fintype α] [Nonempty α]
    (ρ : α → ℝ) (π : Finset α → ℝ) (h : Standing ρ π)
    (k : ℕ) (hk : ∀ j < k, (iter ρ π j).X.Nonempty) :
    let s := iter ρ π k
    (∀ C ∈ maxChains α, s.δ C = ∑ x ∈ C, s.ρ x - s.π C) ∧
    (∀ C ∈ s.chains, 0 ≤ s.δ C) ∧
    PreservesDecomp s.prevX s.chains ∧
    (∀ C1 ∈ s.chains, ∀ C2 ∈ s.chains, ∀ x ∈ C1 ∩ C2 ∩ s.prevX,
      s.π C1 + s.π C2 = s.π (splice C1 C2 x) + s.π (splice C2 C1 x)) ∧
    IsPosetOn s.X s.tight := by sorry

end PosetMarginals.Chains
