namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- **A gate of atoms.** -/
theorem cost_gateH_sol_aux {W A m n r Z H x : ℕ} (hW : 1 ≤ W) (hn : 1 ≤ n) (as : List KFG.Atom)
    (hA : as.length ≤ A)
    (hok : ∀ a ∈ as, a.Ok W ∧ a.h ≤ 1) (hx : x + (3 * as.length + 3 * W) ≤ H) :
    400 * (cGateC W (n * r) Z as.length x + xGateH W as Z) ≤
      MlocH W A m * ((W * n) * Yu r Z H) := by
  have hlev := (levOf_props hok).2.2.2
  unfold cGateC xGateH MlocH
  have h1 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x + 3 * as.length) (D := 1) hW hn
    (by omega)
  have h2 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x + 3 * as.length + 3 * W) (D := 1) hW hn
    (by omega)
  have h3 := xp_Y r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : 1000000 * (W * n) * Y = 1000000 * P := by rw [hP]; ring
  rw [e1] at h1 h2
  set L := as.length
  set V := (levOf W as).length
  set c1 := cAtom (x + 3 * L) 1 (n * r) W Z
  set c2 := cAtom (x + 3 * L + 3 * W) 1 (n * r) W Z
  have k1 : L * c1 ≤ A * (1000000 * P) := Nat.mul_le_mul hA h1
  have k2 : W * c2 ≤ W * (1000000 * P) := Nat.mul_le_mul_left _ h2
  have k3 : L * Xp Z + V * Xp Z ≤ (A + W) * (90000000 * P) := by
    have : L * Xp Z + V * Xp Z = (L + V) * Xp Z := by ring
    rw [this]
    exact Nat.mul_le_mul (by omega) (h3.trans (Nat.mul_le_mul_left _ hYP))
  have k4 : 400 * (L * c1 + W * c2 + 2 + (L * Xp Z + V * Xp Z)) ≤
      400 * (100000000 * ((A + W + 1) * P)) := by
    apply Nat.mul_le_mul_left
    have : 1 ≤ P := le_trans (by omega) hYP
    have e : 100000000 * ((A + W + 1) * P) = 100000000 * (A * P) + 100000000 * (W * P) +
      100000000 * P := by ring
    have e2 : A * (1000000 * P) = 1000000 * (A * P) := by ring
    have e3 : W * (1000000 * P) = 1000000 * (W * P) := by ring
    have e4 : (A + W) * (90000000 * P) = 90000000 * (A * P) + 90000000 * (W * P) := by ring
    omega
  refine k4.trans ?_
  have : 400 * (100000000 * ((A + W + 1) * P)) = (4 * 10 ^ 10 * (A + W + 1)) * P := by ring
  rw [this]
  apply Nat.mul_le_mul_right
  have h5 : A + W + 1 ≤ (W + A + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + A + 10))
  calc 4 * 10 ^ 10 * (A + W + 1) ≤ 10 ^ 13 * 1 * (W + A + 10) ^ 2 := by
        have := Nat.mul_le_mul_left (4 * 10 ^ 10) h5
        nlinarith
    _ ≤ 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_left; omega

end IntMul.Kappa.R6.IL3H

