theorem solution (n : ℕ) (hn : IntMul.OpenAI.Glue.n0 ≤ n) (s : NLogN.IState NLogN.HS) (LD LR : List NLogN.Item)
    (hD : s.G NLogN.KFM.zD = .int (IntMul.OpenAI.R154.dP n : ℤ) :: LD) (hR : s.G NLogN.KFM.zR = .int (IntMul.OpenAI.R154.rP n : ℤ) :: LR) :
    NLogN.KFM.setupC.ok s ∧ NLogN.KFM.setupC.run s = ((s.upd NLogN.KFM.zQ (.int (NLogN.KFM.srcQ (IntMul.OpenAI.R154.dP n) (IntMul.OpenAI.R154.rP n) : ℤ) :: s.G NLogN.KFM.zQ)).upd NLogN.KFM.zMh
      (.int (NLogN.KFM.srcM (IntMul.OpenAI.R154.dP n) (IntMul.OpenAI.R154.rP n) (IntMul.OpenAI.R154.rP n / 2) : ℤ) :: s.G NLogN.KFM.zMh)).upd NLogN.KFM.zMf
      (.int (NLogN.KFM.srcM (IntMul.OpenAI.R154.dP n) (IntMul.OpenAI.R154.rP n) (IntMul.OpenAI.R154.rP n) : ℤ) :: s.G NLogN.KFM.zMf) := by
  obtain ⟨-, -, -, hd1, -, -, -, -, -, -, -, -, hbig, -⟩ := IntMul.OpenAI.R154.P.IntMul.OpenAI.Glue.params_ok hn
  set d := IntMul.OpenAI.R154.dP n with hdd
  set r := IntMul.OpenAI.R154.rP n with hrr
  set D := 256 * d ^ 2 with hDd
  have hF1 : 1 ≤ D.factorial := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have hD1 : 1 ≤ D := by have : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd1; omega
  have hr64 : 64 ≤ r := by
    have : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd1
    have : 64 ≤ 64 * d ^ 2 * D.factorial := by nlinarith
    omega
  -- F = D!
  have hDe : NLogN.KFM.DE.eval s = (D : ℤ) := by
    simp only [NLogN.KFM.DE, NLogN.Ex.eval, NLogN.IState.top_eq hD, hDd]; push_cast; ring
  obtain ⟨k1, r1⟩ := NLogN.KFM.prodP_run NLogN.KFM.DE NLogN.KFM.zQ s D (by decide) (by decide) (NLogN.KFM.clean_of_regs _ (by decide))
    (by decide) (by simp [NLogN.KFM.DE, NLogN.Ex.ok, NLogN.IState.isInt_of hD]) hDe
  set t1 := s.upd NLogN.KFM.zQ (.int (D.factorial : ℤ) :: s.G NLogN.KFM.zQ) with ht1
  have t1Q : t1.G NLogN.KFM.zQ = .int (D.factorial : ℤ) :: s.G zQ := by simp [ht1]
  have t1D : t1.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht1, NLogN.IState.upd_G, hD]
  have t1R : t1.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht1, NLogN.IState.upd_G, hR]
  have hDe1 : NLogN.KFM.DE.eval t1 = (D : ℤ) := by
    simp only [NLogN.KFM.DE, NLogN.Ex.eval, NLogN.IState.top_eq t1D, hDd]; push_cast; ring
  -- Q
  have hQe : NLogN.KFM.QE.eval t1 = (NLogN.KFM.srcQ d r : ℤ) := by
    simp only [NLogN.KFM.QE, NLogN.Ex.eval, NLogN.IState.top_eq t1Q, NLogN.IState.top_eq t1R, hDe1, NLogN.KFM.srcQ, ← hDd]
    norm_cast
  have k2 : (NLogN.RS.asg NLogN.KFM.zQ NLogN.KFM.QE).ok t1 := ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), by
    simp only [NLogN.KFM.QE, NLogN.Ex.ok]
    refine ⟨by simp [NLogN.Ex.ok, NLogN.IState.isInt_of t1Q], ⟨NLogN.IState.isInt_of t1R, by
      simp [NLogN.KFM.DE, NLogN.Ex.ok, NLogN.IState.isInt_of t1Q, NLogN.IState.isInt_of t1D], by
      simp only [NLogN.Ex.eval, NLogN.IState.top_eq t1R]; positivity, by
      simp only [NLogN.Ex.eval, NLogN.IState.top_eq t1Q, hDe1]
      have : (1 : ℤ) ≤ D.factorial := by exact_mod_cast hF1
      have : (1 : ℤ) ≤ D := by exact_mod_cast hD1
      positivity⟩, trivial⟩, NLogN.IState.isInt_of t1Q⟩
  set t2 := s.upd NLogN.KFM.zQ (.int (NLogN.KFM.srcQ d r : ℤ) :: s.G NLogN.KFM.zQ) with ht2
  have r2 : (NLogN.RS.asg NLogN.KFM.zQ NLogN.KFM.QE).run t1 = t2 := by
    simp only [NLogN.RS.run, hQe, t1Q, List.tail_cons]; rw [ht1, NLogN.IState.upd_upd_same]
  have t2Q : t2.G NLogN.KFM.zQ = .int (NLogN.KFM.srcQ d r : ℤ) :: s.G zQ := by simp [ht2]
  have t2D : t2.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht2, NLogN.IState.upd_G, hD]
  have t2R : t2.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht2, NLogN.IState.upd_G, hR]
  have hQ1 : 1 ≤ NLogN.KFM.srcQ d r := by
    have : 0 < NLogN.KFM.srcQ d r := by unfold NLogN.KFM.srcQ; positivity
    omega
  -- M_{r/2}
  have hh2 : (NLogN.Ex.ndiv (.reg NLogN.KFM.zR) (.lit 2)).eval t2 = ((r / 2 : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval, NLogN.IState.top_eq t2R]; norm_cast
  have k3 : (NLogN.RS.push NLogN.KFM.zMh (NLogN.KFM.ME (.ndiv (.reg NLogN.KFM.zR) (.lit 2)))).ok t2 := ⟨by decide,
    NLogN.KFM.clean_of_regs _ (by decide), NLogN.KFM.ME_ok t2 _ d _ _ LD _ t2D t2Q hh2
      ⟨NLogN.IState.isInt_of t2R, trivial, by simp only [NLogN.Ex.eval, NLogN.IState.top_eq t2R]; positivity,
        by simp [NLogN.Ex.eval]⟩ hd1 hQ1 (NLogN.KFM.ME_h4 d r _ hd1 hr64 le_rfl)⟩
  set t3 := t2.upd NLogN.KFM.zMh (.int (NLogN.KFM.srcM d r (r / 2) : ℤ) :: t2.G NLogN.KFM.zMh) with ht3
  have r3 : (NLogN.RS.push NLogN.KFM.zMh (NLogN.KFM.ME (.ndiv (.reg NLogN.KFM.zR) (.lit 2)))).run t2 = t3 := by
    simp only [NLogN.RS.run, NLogN.KFM.ME_eval t2 _ d _ _ LD _ t2D t2Q hh2 hd1 (NLogN.KFM.ME_h4 d r _ hd1 hr64 le_rfl), ht3,
      NLogN.KFM.srcM]
  have t3Q : t3.G NLogN.KFM.zQ = .int (NLogN.KFM.srcQ d r : ℤ) :: s.G zQ := by
    simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2Q]
  have t3D : t3.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2D]
  have t3R : t3.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2R]
  -- M_r
  have hhr : (NLogN.Ex.reg NLogN.KFM.zR).eval t3 = (r : ℤ) := by simp only [NLogN.Ex.eval, NLogN.IState.top_eq t3R]
  have hr2 : r / 2 ≤ r := Nat.div_le_self _ _
  have k4 : (NLogN.RS.push NLogN.KFM.zMf (NLogN.KFM.ME (.reg NLogN.KFM.zR))).ok t3 := ⟨by decide, NLogN.KFM.clean_of_regs _ (by decide),
    NLogN.KFM.ME_ok t3 _ d _ _ LD _ t3D t3Q hhr (NLogN.IState.isInt_of t3R) hd1 hQ1 (NLogN.KFM.ME_h4 d r _ hd1 hr64 hr2)⟩
  have r4 : (NLogN.RS.push NLogN.KFM.zMf (NLogN.KFM.ME (.reg NLogN.KFM.zR))).run t3 =
      t3.upd NLogN.KFM.zMf (.int (NLogN.KFM.srcM d r r : ℤ) :: t3.G NLogN.KFM.zMf) := by
    simp only [NLogN.RS.run, NLogN.KFM.ME_eval t3 _ d _ _ LD _ t3D t3Q hhr hd1 (NLogN.KFM.ME_h4 d r _ hd1 hr64 hr2), NLogN.KFM.srcM]
  refine ⟨⟨k1, by rw [r1]; exact ⟨k2, by rw [r2]; exact ⟨k3, by rw [r3]; exact k4⟩⟩⟩, ?_⟩
  simp only [NLogN.KFM.setupC, NLogN.RS.run_seq]
  rw [r1, r2, r3, r4]
  simp (config := {decide := true}) [ht3, ht2, NLogN.IState.upd_G]
end
