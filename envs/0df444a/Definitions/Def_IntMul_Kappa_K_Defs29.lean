-- Source module: Solutions.KFV10Rec
/-!
# KFV §14: the uniform record product `recU`

`recU pM` is `recI pM b r Δ c KG` (`KFV6Rec`) with every size read at run time from six
parameter stacks (`kc = 50 … kD = 55`):

| stack | value |
|---|---|
| `kc = 50` | `c = 2^p` |
| `kr = 51` | `r` |
| `kK = 52` | `KG = kG b r c` |
| `kB = 53` | `2^b` |
| `kJ = 54` | `(2^b)^(2r)` |
| `kD = 55` | `2^Δ` |

Derived literals are expressions over them: `2r = r + r`, `-KG`, `H = 2^b / 2`, `-H`.
The pieces are related to those of `recI` by `ISim` (`KFV8Sim`/`KFV9Gen`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Parameters -/

abbrev kc : Fin HS := 50
abbrev kr : Fin HS := 51
abbrev kK : Fin HS := 52
abbrev kB : Fin HS := 53
abbrev kJ : Fin HS := 54
abbrev kD : Fin HS := 55

/-- The parameter map of a record product. -/
def πR (c r KG B BJ D2 : ℤ) : PMap :=
  pmOf [(kc, c), (kr, r), (kK, KG), (kB, B), (kJ, BJ), (kD, D2)]

/-! ## Literal expressions -/

/-- `2r = r + r`. -/
def exTwoR : Ex HS := .add (.reg kr) (.reg kr)
/-- `H = 2^b / 2`. -/
def exHalf : Ex HS := .quo (.reg kB) (.lit 2)

/-! ## Write conditions -/

/-! ## Uniform pieces -/

def unzBU (X SA SB : Fin HS) : RS :=
  .seq (.push SA (.add (.reg X) (.reg kc))) (.seq (.push SA (.lit 0)) (.seq (.pop X)
    (.seq (.push SB (.add (.reg X) (.reg kc))) (.seq (.push SB (.lit 0)) (.pop X)))))

def unzU (X SA SB C : Fin HS) : RS := .rep C (.reg kr) (unzBU X SA SB)

/-- `rpt` with the count read from stack `R`. -/
def rptR (R A C D : Fin HS) (b : IStmt HS Pp) : IStmt HS Pp :=
  .seq (.op (.dup R A)) (.seq (pro A C D) (.seq (uloop C D b) (.seq (epi C D) (.op (.drop A)))))

/-- `rpt` with the count `e`. -/
def rptE (e : Ex HS) (A C D : Fin HS) (b : IStmt HS Pp) : IStmt HS Pp :=
  .seq (pushE e A) (.seq (pro A C D) (.seq (uloop C D b) (.seq (epi C D) (.op (.drop A)))))

/-- `rpt` with count `0`. -/
def rptZ (A C D : Fin HS) (b : IStmt HS Pp) : IStmt HS Pp :=
  .seq (.op (.const A 0)) (.seq (pro A C D) (.seq (uloop C D b) (.seq (epi C D) (.op (.drop A)))))

/-- Uniform `carI b r`. -/
def carU : IStmt HS Pp :=
  .seq (.op (.dup kB tR)) (.seq (.op (.const tY 0)) (.seq (rptR kr tA tC NLogN.KFT.tD c1B)
    (.seq (.op (.const NLogN.KFT.tP 1)) (.seq (.op (.add tY NLogN.KFT.tP tY)) (.seq (.op (.const NLogN.KFT.tP 1))
    (.seq (rptR kr tA tC NLogN.KFT.tD c2B) (.seq (.op (.neg NLogN.KFT.tP)) (.seq (.op (.add tY NLogN.KFT.tP 0))
    (.op (.drop tR))))))))))

/-- Uniform `digI b 0 (2r) (2r)`. -/
def digU : IStmt HS Pp :=
  .seq (.op (.dup kB tR)) (.seq (rptE exTwoR tA tC NLogN.KFT.tD cutB) (.seq (.op (.drop tX))
    (.seq (rptZ tA tC NLogN.KFT.tD KFT.zB) (.seq (.op (.const NLogN.KFT.tE (2 ^ 0)))
    (.seq (rptE exTwoR tA tC NLogN.KFT.tD putB) (.seq (.op (.drop NLogN.KFT.tE)) (.op (.drop tR))))))))

/-- Boolean check: no stack of `50 … 55`. -/
def allLow (L : List (Fin HS)) : Bool := L.all fun i => decide (i.val < 50 ∨ 55 < i.val)

/-! ## Packing, extraction and interleaving -/

/-- Uniform `packI S P b r KG`. -/
def packU (S P : Fin HS) : IStmt HS Pp :=
  .seq (fcode (NLogN.mvK S 0 NLogN.KFV.vL exTwoR))
    (.seq carU (fcode (.seq (.push P (.add (.reg 0) (.neg (.reg kK)))) (.pop 0))))

def xHU : Ex HS := .add (.add (.reg 0) (.reg vRH)) exHalf

def carBU : RS :=
  .seq (.push NLogN.KFV.vT (.add (.rem xHU (.reg kB)) (.neg exHalf)))
    (.seq (.asg vRH (.quo xHU (.reg kB))) (.seq (.pop 0) (.pop 0)))

def carLU : RS := .seq (.push vRH (.lit 0)) (.seq (.rep NLogN.KFV.vL exTwoR carBU) (.pop vRH))

def fldBU (O : Fin HS) : RS :=
  .seq (.push O (.quo (.add (.reg NLogN.KFV.vT) (.neg (.reg vT4))) (.reg kD))) (.seq (.pop NLogN.KFV.vT) (.pop vT4))

def fldPU (O : Fin HS) : RS := .rep NLogN.KFV.vL (.reg kr) (fldBU O)

/-- Uniform `extI e O b r Δ`. -/
def extU (e : Ex HS) (O : Fin HS) : IStmt HS Pp :=
  .seq (fcode (.push vZ (.sel e (.add e (.reg kJ)) e))) <|
  .seq (.op (.mv vZ tX)) <|
  .seq digU <|
  .seq (fcode carLU) <|
  .seq (fcode (NLogN.mvK NLogN.KFV.vT vT2 NLogN.KFV.vL (.reg kr))) <|
  .seq (fcode (NLogN.mvK vT2 vT4 NLogN.KFV.vL (.reg kr))) <|
  fcode (fldPU O)

def ilvU : RS := .rep NLogN.KFV.vL (.reg kr) ilvB

/-- **The uniform record product.** -/
def recU (pM : Fin Pp) : IStmt HS Pp :=
  .seq (fcode (unzU NLogN.KFV.vX vA NLogN.KFV.vB NLogN.KFV.vL)) <| .seq (fcode (unzU NLogN.KFV.vY vC NLogN.KFV.vE NLogN.KFV.vL)) <|
  .seq (packU vA vPA) <| .seq (packU NLogN.KFV.vB vPB) <|
  .seq (packU vC vPC) <| .seq (packU NLogN.KFV.vE vPE) <|
  .seq (KFM.mulC pM vM1 vPA vPC) <| .seq (KFM.mulC pM vM2 vPB vPE) <|
  .seq (KFM.mulC pM vM3 vPA vPE) <| .seq (KFM.mulC pM vM4 vPB vPC) <|
  .seq (extU subE vOR) <| .seq (extU addE vOI) <|
  .seq (fcode ilvU) <| fcode dropsP

section Sims

variable {c KG : ℤ} {b r : ℕ} {BJ D2 : ℤ}

/-- The parameter map of a record product with the given sizes. -/
abbrev πr (c KG : ℤ) (b r : ℕ) (BJ D2 : ℤ) : PMap := πR c r KG ((2 : ℤ) ^ b) BJ D2

end Sims

/-! ## The run -/

/-- Parameter stacks are empty in the managed part. -/
def PZ (π : PMap) (g : Fin HS → List ℤ) : Prop := ∀ i v, π i = some v → g i = []

/-- Boolean check: a register program writes only stacks below `50`. -/
def lowW (p : RS) : Bool := p.writes.all fun j => decide (j.val < 50)

end NLogN.KFV

end

