-- title:
--   C-fixed differentials on a curve are logarithmic
-- statement:
--   Let $K$ and $F$ be fields with $F$ a $K$-algebra satisfying [`AlgebraicCurve.IsCurveOver K F`](def/AlgebraicCurve_IsCurveOver.html#L15), that is: every nonzero $f \in F$ admits a divisor $D$ on the places of $F$ over $K$ with $D(v) = \operatorname{ord}_v(f)$ at every place $v$ and $\deg D = 0$; every place has residue field finite-dimensional over $K$; and the module of Kähler differentials $\Omega[F/K]$ is free of rank one over $F$. Let $p$ be a prime, assume $K$ has characteristic $p$ and is perfect, and let $x \in F$ be such that $F$ is finite-dimensional over the intermediate field $K(x)$ generated by $x$. Let $C \colon \Omega[F/K] \to \Omega[F/K]$ be an additive map subject to the three Cartier laws: $C(f^p \cdot \omega) = f \cdot C(\omega)$ for all $f \in F$ and $\omega \in \Omega[F/K]$; $C(df) = 0$ for all $f \in F$; and $C(f^{p-1} \cdot df) = df$ for all $f \in F$, where $d$ denotes the universal derivation $K$-derivation of $F$. Then for every $w \in \Omega[F/K]$ with $C(w) = w$ there exists $h \in F$ with $h \neq 0$ and $w = h^{-1} \cdot dh$.
--
--   This is the converse half of Cartier's characterisation of logarithmic differentials in characteristic $p$: together with the computation $C(dh/h) = dh/h$ it identifies the fixed points of the Cartier operator on a one-variable function field over a perfect field with the image of $d\log$ on $F^{\times}$. It is used in the description of the degree-zero divisor class group as the Cartier-fixed regular differentials, and in the study of differentials on modular curves in characteristic $p$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_exists_dlog_of_cartierOperator_fixed.lean

import Definitions.Def_AlgebraicCurve_IsCurveOver

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
universe u v

theorem AlgebraicCurve.exists_dlog_of_cartierOperator_fixed {K : Type u} {F : Type v}
    [Field K] [Field F] [Algebra K F] [AlgebraicCurve.IsCurveOver K F] (p : ℕ)
    [Fact p.Prime] [CharP K p] [PerfectField K] (x : F)
    [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F]
    (C : Ω[F⁄K] →+ Ω[F⁄K])
    (hsemi : ∀ (f : F) (ω : Ω[F⁄K]), C (f ^ p • ω) = f • C ω)
    (hker : ∀ f : F, C (KaehlerDifferential.D K F f) = 0)
    (hlog : ∀ f : F, C (f ^ (p - 1) • KaehlerDifferential.D K F f) = KaehlerDifferential.D K F f)
    (w : Ω[F⁄K]) (hfix : C w = w) :
    ∃ h : F, h ≠ 0 ∧ w = h⁻¹ • KaehlerDifferential.D K F h := by sorry
