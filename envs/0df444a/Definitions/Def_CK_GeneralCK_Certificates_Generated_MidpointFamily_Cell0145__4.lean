theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨197472288348,197692190675⟩ ⟨753187721879,753208579064⟩ ⟨97747683220,99834556291⟩ := rfl
noncomputable def centerUpper : ℝ := (411440079015 / 1099511627776)
