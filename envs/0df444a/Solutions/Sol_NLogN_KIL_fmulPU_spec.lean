    (hAs : t.G sPA = .int P :: LA) (hVs : t.G sVV = .int ((P * (Q * B) : ℕ) : ℤ) :: LV)
    (hQBs : t.G sQB = .int ((Q * B : ℕ) : ℤ) :: LQB) :
    Sp (mulPgU c) t (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (mulAddr Q c) 0 xs) ++ R))
      (cMulPgU P Q c B Bb) := by
  set t1 := t.upd sRR (.int ((Q % c : ℕ) : ℤ) :: t.G sRR)
  have B1 := mulPgR_spec t1 xs P Q c B Bb R hlen hb hc2 hQc zB zc zQ zQB zP zV
    (by simp (config := {decide := true}) [t1, h0])
    (LQ := LQ) (LB := LB) (LA := LA) (LV := LV) (LQB := LQB)
    (by simp (config := {decide := true}) [t1, hQs]) (by simp (config := {decide := true}) [t1, hBs])
    (by simp (config := {decide := true}) [t1, hAs]) (by simp (config := {decide := true}) [t1, hVs])
    (by simp (config := {decide := true}) [t1, hQBs])
  have H := Sp.resSel (c := c) (by omega) (fun r => mulPgR r c) hQs zQ zc B1
    (by simp (config := {decide := true}) [t1])
  rw [upd_restore (by decide)] at H
  exact H

end NLogN.KIL

