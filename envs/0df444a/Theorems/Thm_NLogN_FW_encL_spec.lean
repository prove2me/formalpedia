theorem NLogN.FW.encL_spec (M : MulSpec) (s : IState HS) (P r N W : ℕ) (U : List (ℤ × ℤ))
    (RU LR LM LW LF LN : List Item) (hU : s.G GU = gints U ++ RU) (hUl : U.length = N * r)
    (hb : ∀ z ∈ U, |z.1| < 2 ^ P ∧ |z.2| < 2 ^ P) (hP : 1 ≤ P) (hr : 1 ≤ r)
    (hR : s.G CR = .int (2 ^ P) :: LR) (hM : s.G CM = .int (r : ℤ) :: LM)
    (hW : s.G RW = .int (2 ^ (2 * r * P)) :: LW) (hF : s.G FR = .int (2 ^ (4 * r * P) + 1) :: LF)
    (hN : s.G NN = .int (N : ℤ) :: LN)
    (Q : ℕ) (hPQ : P ≤ Q) (hrQ : zsz (r : ℤ) ≤ Q) (hFW : 4 * r * P + 1 ≤ W) (hNW : zsz (N : ℤ) ≤ W) :
    Spec M encL s ((s.upd GU RU).upd XD
      (ints ((Ref.chunkL r U).map (encRes P r)) ++ s.G XD)) (encCost N r P Q W) := by sorry
