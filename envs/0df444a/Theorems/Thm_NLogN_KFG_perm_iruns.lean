theorem NLogN.KFG.perm_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {W m n : ℕ} (T : Butterfly.Op (Fin n)) (σ : Equiv.Perm (Fin W)) (e : ℕ → ℕ) (s : IState HS)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ)
    (hx : ScRep e zs x) (h0 : f 0 = gflat zs ++ l) (hC : ClP f) (wb Z : ℕ) (hb : NLogN.KFB.GB wb zs)
    (hZ : zsz ((2 * (W * 2 ^ (m * n)) : ℕ) : ℤ) ≤ Z) :
    ∃ zs', ScRep (e ∘ pf σ⁻¹) zs'
        ((P8Lift.RStep.den T (P8Lift.RStep.perm (m := m) σ)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      IRuns I iprog (fcode (swapsP (2 ^ (m * n)) (permSw σ))) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l))) (W * cAtom wb 0 (2 ^ (m * n)) W Z + 1) := by sorry
