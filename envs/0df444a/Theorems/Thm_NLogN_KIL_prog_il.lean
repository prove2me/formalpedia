--       (hV : zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb)
--       (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2))
