      (prepCost N n k) := by
  set K := 2 ^ k with hK
  have hzK : zsz (K : ℤ) ≤ n := by
    have : ((K : ℕ) : ℤ) = (2 : ℤ) ^ k := by rw [hK]; push_cast; rfl
    rw [this, zsz_two_pow]; omega
  -- prologue
  set s1 := (((s.upd ARG LA).upd XA (.int x :: s.G XA)).upd W (.int 1 :: s.G W)).upd CC
    (.int (K : ℤ) :: s.G CC) with hs1
  have h1 : IRuns I iprog (.seq (.op (.mv ARG XA)) (.seq (.op (.const W 1)) (.op (.dup DL CC))))
      s s1 (1000 * (N + n + 2)) := by
    apply IRuns.of_runsTo 0
    have e : ((2 : ℤ) ^ k) = ((K : ℕ) : ℤ) := by rw [hK]; push_cast; rfl
    simp +decide [IStmt.run, IOp.run, hA, hDL, e]
    refine ⟨by rw [hs1]; try (clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := moveIntCost_le (zsz x); have := dupCost_le (zsz (K : ℤ)); rw [zsz_one]
    omega
  have h2 := prepLoop_runs (I := I) (iprog := iprog) s1 n M Q K x (s.G XA) (s.G W) (s.G CC) LM LQ
    LN LF hKQ hM hQ hzK (by simp +decide [s1]) (by simp +decide [s1]) (by simp +decide [s1])
    (by simp +decide [s1, hRM]) (by simp +decide [s1, hRQ]) (by simp +decide [s1, hN])
    (by simp +decide [s1, hF])
  set A' := wtZ (2 ^ n + 1) Q 0 (pcs M K x) with hA'
  have hq0 := qit_zero_of_lt M K x hx
  set s3 := (s.upd ARG LA).upd QS ((ints A').reverse ++ s.G QS) with hs3
  have h3 : IRuns I iprog (.seq (.op (.drop CC)) (.seq (.op (.drop W)) (.op (.drop XA))))
      ((((s1.upd XA (.int (qit M K x) :: s.G XA)).upd QS ((ints A').reverse ++ s1.G QS)).upd W
        (.int (2 ^ n) :: s.G W)).upd CC (.int 0 :: s.G CC)) s3 (1000 * (n + 2)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hq0, zsz_zero, zsz_two_pow]
    refine ⟨by rw [hs3, hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), by omega⟩
  have hlen : A'.reverse.length = K := by
    rw [List.length_reverse, hA', length_wtZ, length_pcs]
  have hcan : Canon (2 ^ n + 1) A' := canon_wtZ (by positivity) Q 0 _
  have h4 := mvK_runs (I := I) (iprog := iprog) (X := QS) (Y := DX) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s3 A'.reverse (s.G QS) LL (n + 1)
    (by simp +decide [s3, ints_reverse]) (by rw [hlen, hK]; simp +decide [s3, hDL])
    (fun a ha => canon_bnd hcan a (List.mem_reverse.mp ha))
  set s4 := (s3.upd QS (s.G QS)).upd DX ((ints A'.reverse).reverse ++ s3.G DX) with hs4
  have hlA : A'.length = 2 ^ k := by rw [hA', length_wtZ, length_pcs]
  have h5 := dif_runs (I := I) pD hPD n hn k s4 A' R LL LE LN LF (2 * Q) hlA
    (by right; rw [← hKQ]; ring) hcan
    (by simp +decide [s4, s3, hX, ints_reverse]) (by simp +decide [s4, s3, hDL])
    (by simp +decide [s4, s3, hDE]) (by simp +decide [s4, s3, hN]) (by simp +decide [s4, s3, hF])
  have hall := IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 h5)))
  rw [hlen] at hall
  refine hall.mono' ?_ ?_
  · simp only [hs4, hs3]
    have hQS : s.G QS = s.G QS := rfl
    clear * -
    apply IState.ext'
    · intro x; fin_cases x <;> simp +decide [IState.upd_G, ints_reverse] <;> rfl
    · simp
    · simp
  · have hm1 : K * (1000 * (n + 1 + zsz (K : ℤ) + 3)) ≤ 2000 * (K * (n + 3)) :=
      calc K * (1000 * (n + 1 + zsz (K : ℤ) + 3)) ≤ K * (2000 * (n + 3)) :=
            Nat.mul_le_mul_left _ (by omega)
        _ = 2000 * (K * (n + 3)) := by ring
    have hm2 : K * (30000 * (n + 3) + 30) ≤ 30030 * (K * (n + 3)) :=
      calc K * (30000 * (n + 3) + 30) ≤ K * (30030 * (n + 3)) := Nat.mul_le_mul_left _ (by omega)
        _ = 30030 * (K * (n + 3)) := by ring
    have : 40000 * 2 ^ k * (n + 3) = 40000 * (K * (n + 3)) := by rw [hK]; ring
    have hK1 : 1 ≤ K := Nat.one_le_two_pow
    have : n + 3 ≤ K * (n + 3) := Nat.le_mul_of_pos_left _ hK1
    simp only [prepCost]
    omega
end
