import Mathlib
import Definitions.Def_LimitedBFGS_SQN_pcgIter
import Theorems.Thm_LimitedBFGS_SQN_pcg_joint_prefix_invariants

open Matrix
open LimitedBFGS.SQN

/-- Full-index `A`-conjugacy of the directions generated by the preconditioned conjugate
gradient iteration (13) of Nocedal 1980, p. 777, with fixed preconditioner `H0` and
exact line searches: `d_p ᵀ A d_q = 0` for all `p ≠ q`.

**Reduction.** This is the one-sided prefix invariant `C` of
`pcg_joint_prefix_invariants`, read in both orientations. `C(k)` supplies
`d_k ⬝ᵥ (A *ᵥ d_j) = 0` for `j < k`, so the case `q < p` is exactly `C` and the case
`p < q` is `C` with the two arguments exchanged through the symmetry of `A`.

Symmetry of `A` comes from `hA : A.PosDef`, which makes `A` Hermitian and therefore
symmetric, together with `dotProduct_transpose_mulVec`. No part of the direction
recurrence is used here. -/
theorem solution {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : A.PosDef)
    (b : Fin n → ℝ) (H₀ : Matrix (Fin n) (Fin n) ℝ) (hH₀ : H₀.PosDef) (x₀ : Fin n → ℝ) :
    ∀ p q : ℕ, p ≠ q →
      (pcgIter A b H₀ x₀ p).d ⬝ᵥ (A *ᵥ (pcgIter A b H₀ x₀ q).d) = 0 := by
  classical
  have hA_tr : Aᵀ = A := (isHermitian_iff_isSymm.mp hA.isHermitian).eq
  have pair_comm_A : ∀ u v : Fin n → ℝ, u ⬝ᵥ (A *ᵥ v) = v ⬝ᵥ (A *ᵥ u) := by
    intro u v
    have h := dotProduct_transpose_mulVec (A := A) (x := u) (y := v)
    rwa [hA_tr] at h
  intro p q hpq
  rcases lt_trichotomy q p with hlt | heq | hgt
  · exact (pcg_joint_prefix_invariants A hA b H₀ hH₀ x₀ p).2.2 q hlt
  · exact absurd heq (Ne.symm hpq)
  · calc (pcgIter A b H₀ x₀ p).d ⬝ᵥ (A *ᵥ (pcgIter A b H₀ x₀ q).d)
      = (pcgIter A b H₀ x₀ q).d ⬝ᵥ (A *ᵥ (pcgIter A b H₀ x₀ p).d) := pair_comm_A _ _
    _ = 0 := (pcg_joint_prefix_invariants A hA b H₀ hH₀ x₀ q).2.2 p hgt
