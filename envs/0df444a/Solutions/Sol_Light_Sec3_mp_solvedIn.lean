      (by simp [Limits.Addr, abs_le, hreadQ]; omega)
    -- mem[ArrR + Idx] := Twice
    (focus
       ((first
           | refine Light.Ends.seqSelf ?_
           | refine Light.Ends.skipLast ?_);
         (repeat
             with_unfolding_none
               first
               | refine Light.Ends.seqAssoc ?_
               | refine Light.Ends.skipThen ?_))
       (refine Light.Ends.storeToThen (r + j) (2 * y) ?_ ?_ ?_)
