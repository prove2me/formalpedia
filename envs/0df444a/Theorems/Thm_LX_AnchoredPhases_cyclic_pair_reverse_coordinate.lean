theorem LX.AnchoredPhases.cyclic_pair_reverse_coordinate (p : State n) (a i : Fin n) (k : ℕ)
    (hk0 : 0 < k) (hkn : k < n) (hpair : permutation p a (permutation p a i)=i)
    (hi : permutation p a i=i+(k : Fin n)) :
