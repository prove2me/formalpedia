/-!
# Register programs

`RS` is a small structured language over the register stacks `0 … 55`: assignments of
expressions, pushes and pops, conditionals and counted loops.  `RS.run` is its functional
semantics on `IState`s, and `RS.code_runs` shows that the compiled `IStmt` realises it with cost
`RS.cost`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RS

/-! ## Frame -/

/-! ## Compilation -/

/-! ## Sequences and reasoning lemmas -/

/-! ## Cost bounds -/

theorem asgCost_le (i : Fin HS) (e : Ex HS) (s : IState HS) (B : ℕ) (h : e.Bnd s B)
    (hi : zsz (s.top i) ≤ B) : asgCost i e s ≤ (e.size + 1) * 10 ^ 7 * (B + 2) ^ 2 := by
  have h1 := Ex.cost_le s B e h
  have h2 := Ex.zsz_eval_le s B e h
  simp only [asgCost, moveCost]; nlinarith

theorem rep_cost_le (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (B C : ℕ)
    (hn : n.Bnd s B)
    (hb : ∀ k < (n.eval s).toNat, b.cost (repSt i n b s k) +
      asgCost i (decE i) (b.run (repSt i n b s k)) ≤ C) :
    (rep i n b).cost s ≤ (n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (n.eval s).toNat * (C + 30) + 32 := by
  have h1 := pushCost_le n s B hn
  have h2 : ∑ k ∈ Finset.range (n.eval s).toNat, (b.cost (repSt i n b s k) +
      asgCost i (decE i) (b.run (repSt i n b s k)) + 30) ≤ (n.eval s).toNat * (C + 30) := by
    have := Finset.sum_le_sum (s := Finset.range (n.eval s).toNat)
      (f := fun k => b.cost (repSt i n b s k) + asgCost i (decE i) (b.run (repSt i n b s k)) + 30)
      (g := fun _ => C + 30) (fun k hk => by have := hb k (Finset.mem_range.1 hk); omega)
    simpa using this
  simp only [cost]; omega

/-- Invariant reasoning for counted loops. -/
theorem repSt_inv (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (Inv : ℕ → IState HS → Prop)
    (h0 : Inv 0 (s.upd i (.int (n.eval s) :: s.G i)))
    (hs : ∀ k < (n.eval s).toNat, Inv k (repSt i n b s k) →
      Inv (k + 1) (decSt i (b.run (repSt i n b s k)))) :
    ∀ k ≤ (n.eval s).toNat, Inv k (repSt i n b s k) := by
  intro k; induction k with
  | zero => intro _; exact h0
  | succ k ih =>
    intro hk
    have := hs k (by omega) (ih (by omega))
    simpa [repSt, Function.iterate_succ_apply'] using this

@[simp] theorem decSt_G (i : Fin HS) (t : IState HS) (j : Fin HS) :
    (decSt i t).G j = if j = i then .int (t.top i - 1) :: (t.G i).tail else t.G j := by
  simp [decSt, IState.upd_G]

end RS

end NLogN

end

