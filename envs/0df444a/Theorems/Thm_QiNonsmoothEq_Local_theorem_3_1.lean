-- title:
--   Theorem 3.1, p. 234 — at a semismooth, strongly BD-regular zero, the ∂_B Newton method (3.2) is well defined and converges superlinearly, and ‖F‖ decreases superlinearly
-- statement:
--   Let $F:\mathbb R^n\to\mathbb R^n$ be locally Lipschitz, let $x^*$ be a solution of $F(x)=0$, and let $F$ be semismooth and strongly BD-regular at $x^*$ (every $V\in\partial_B F(x^*)$ is nonsingular). Consider the Newton method
--   $$x^{k+1}=x^k-V_k^{-1}F(x^k),\qquad V_k\in\partial_B F(x^k). \tag{3.2}$$
--   Then there is $\delta>0$ such that:
--
--   1. **(well defined)** for every $y$ with $\|y-x^*\|<\delta$, every $V\in\partial_B F(y)$ is nonsingular, and the Newton point $y-V^{-1}F(y)$ again satisfies $\|y-V^{-1}F(y)-x^*\|<\delta$;
--   2. **(superlinear convergence)** every sequence generated by (3.2) from $\|x^0-x^*\|<\delta$, for any choice of $V_k\in\partial_B F(x^k)$, has all $V_k$ nonsingular, converges to $x^*$, and
--   $$\|x^{k+1}-x^*\|=o(\|x^k-x^*\|)\qquad(k\to\infty);$$
--   3. **(superlinear decrease of $\|F\|$)** if moreover $F(x^k)\neq 0$ for all $k$, then
--   $$\lim_{k\to\infty}\frac{\|F(x^{k+1})\|}{\|F(x^k)\|}=0. \tag{1.9}$$
--
--   Restricting the Newton matrices to the B-subdifferential instead of Clarke's generalized Jacobian replaces the nonsingularity of all of $\partial F(x^*)$ by the weaker strong BD-regularity; the theorem shows that local superlinear convergence survives, and (1.9) makes the method a descent method for $\|F\|$ near the zero.
--
--   **Formalization Note** A run of (3.2) is a pair of sequences with $V_k\in\partial_B F(x^k)$ and $V_k(x^{k+1}-x^k)=-F(x^k)$; nonsingularity of each $V_k$ is part of the conclusion. The radius $\delta$ is fixed before the run and serves every starting point and every choice of $V_k$. The little-$o$ is Mathlib's `IsLittleO` along `atTop`. Local Lipschitz continuity is the paper's standing assumption (§1). The second paragraph of the theorem (quadratic convergence) is the separate item `theorem_3_1_quadratic`.
-- source:
--   Qi, Convergence analysis of some algorithms for solving nonsmooth equations, Math. Oper. Res. 18 (1993), p. 234, Theorem 3.1 (first paragraph), with (1.9) (p. 228)

import Mathlib
import Definitions.Def_NonsmoothNewton_Shared_clarkeJac
import Definitions.Def_NonsmoothNewton_Local_dirDeriv
import Definitions.Def_NonsmoothNewton_Local_SemismoothAt
import Definitions.Def_QiNonsmoothEq_Local_Setting
open Filter Topology

namespace QiNonsmoothEq.Local

/-- Qi (1993), Theorem 3.1 (Local Convergence), first paragraph, p. 234. Let `x*` be a zero of
`F`, and let `F` be semismooth and strongly BD-regular at `x*`. Then there is `δ > 0` such that:
(1) for every `y` with `‖y - x*‖ < δ`, every `V ∈ ∂_B F(y)` is nonsingular and the Newton point
`y - V⁻¹F(y)` is again within `δ` of `x*` (the method (3.2) is well defined);
(2) every run of (3.2), `x^{k+1} = x^k - V_k⁻¹F(x^k)` with `V_k ∈ ∂_B F(x^k)` arbitrary, started
with `‖x^0 - x*‖ < δ`, has every `V_k` nonsingular, converges to `x*`, and superlinearly:
`‖x^{k+1} - x*‖ = o(‖x^k - x*‖)`;
(3) if moreover `F(x^k) ≠ 0` for all `k`, then `‖F(x^{k+1})‖ / ‖F(x^k)‖ → 0` (1.9). -/
theorem theorem_3_1 {n : ℕ} (F : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hF : LocallyLipschitz F) (xstar : EuclideanSpace ℝ (Fin n)) (hzero : F xstar = 0)
    (hss : NonsmoothNewton.Local.SemismoothAt F xstar) (hreg : StronglyBDRegularAt F xstar) :
    ∃ δ > 0,
      (∀ y : EuclideanSpace ℝ (Fin n), ‖y - xstar‖ < δ →
        ∀ V ∈ NonsmoothNewton.Shared.bJac F y,
          (∃ W : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n), IsInverse V W) ∧
          ∀ W : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n), IsInverse V W →
            ‖y - W (F y) - xstar‖ < δ) ∧
      (∀ (x : ℕ → EuclideanSpace ℝ (Fin n))
          (V : ℕ → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n)),
        IsBDNewtonRun F x V → ‖x 0 - xstar‖ < δ →
          (∀ k, ∃ W : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n),
            IsInverse (V k) W) ∧
          Tendsto x atTop (𝓝 xstar) ∧
          (fun k => x (k + 1) - xstar) =o[atTop] (fun k => x k - xstar) ∧
          ((∀ k, F (x k) ≠ 0) →
            Tendsto (fun k => ‖F (x (k + 1))‖ / ‖F (x k)‖) atTop (𝓝 0))) := by sorry

end QiNonsmoothEq.Local
