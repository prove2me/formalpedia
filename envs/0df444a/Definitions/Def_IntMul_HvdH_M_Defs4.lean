section
-- Source module: NLogN.HCrPar
/-!
# Parameter computation, part 1: search loops and the factorial loop (namespace `NLogN.CR`)

* `srch m C n c`: `m := 0`, then `n` times `m := m + (c < 0 ? 0 : 1)`.  If `c < 0` exactly when
  `m ≥ μ` (and `μ ≤ n`), the result is `μ` (`srch_spec`).  Instances: `Nat.size`, `Nat.clog 2`,
  `ceilSqrt`.
* `facP f C n`: `f := 1`, then `f := f · C` for `C = n, …, 1`: `n!`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

/-! ## Search loops -/

def srchBody (m : Fin HS) (c : Ex HS) : RS := asg m (.add (.reg m) (.sel c (.lit 0) (.lit 1)))

def srch (m C : Fin HS) (n c : Ex HS) : RS := NLogN.RS.seq (push m (.lit 0)) (rep C n (srchBody m c))

/-! ## The factorial loop -/

def facP (f C : Fin HS) (n : Ex HS) : RS :=
  NLogN.RS.seq (push f (.lit 1)) (rep C n (asg f (.mul (.reg f) (.reg C))))

end NLogN.CR

end

