      have hsp : (lim.space : ℤ) ≤ lim.word := pre.hw
      have hb' : ((base + oAddr n WI WJ j : ℕ) : ℤ) < lim.space := by exact_mod_cast hb
      have hqi : ((qi + j : ℕ) : ℤ) < lim.space := by exact_mod_cast (show qi + j < lim.space by omega)
      have hqj : ((qj + j : ℕ) : ℤ) < lim.space := by exact_mod_cast (show qj + j < lim.space by omega)
      have hout : ((out + j : ℕ) : ℤ) < lim.space := by
        exact_mod_cast (show out + j < lim.space by omega)
      push_cast at hb' hqi hqj hout
      generalize WI.getD j 0 = a at hrI hval
      generalize WJ.getD j 0 = b at hrJ hval
