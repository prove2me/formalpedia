    rw [Finset.sum_range_succ]
    have := sum_cLgB_le J
    have hc : cLgB J + 30 = 10 ^ 4 * (2 ^ J + J + 2) + 30 := rfl
    have e1 : 2 ^ (J + 1) = 2 * 2 ^ J := by ring
    have e2 : (J + 1) * (J + 1) = J * J + 2 * J + 1 := by ring
    rw [hc, e1, e2]
    omega

theorem lgLoop_runs (s : IState HS) (LA LR LP LJ : List Item) (n : ℕ) :
    IRuns I iprog lgLoop (lgS s LA LR LP LJ n 0) (lgS s LA LR LP LJ n (Nat.size (n + 1)))
      (10 ^ 4 * (2 ^ Nat.size (n + 1) + Nat.size (n + 1) * Nat.size (n + 1) + 3 * Nat.size (n + 1)) + 30) := by
  have h := IRuns.loop (I := I) (iprog := iprog) (i := gA) (f := isPosC) (p := lgB)
    (fun k => lgS s LA LR LP LJ n k) cLgB (Nat.size (n + 1))
    (by
      intro k hk
      have h2 : 2 ^ k ≤ n + 1 := Nat.lt_size.1 hk
      have hp : (2 : ℤ) ^ (n + 1 - 2 ^ k) ≠ 0 := by positivity
      have hp' : ¬ (2 : ℤ) ^ (n + 1 - 2 ^ k) < 0 := by rw [not_lt]; positivity
      simp +decide [lgS, IState.cl_def, cls, isPosC, aK, if_pos h2, hp, hp'])
    (by
      have h2 : ¬ 2 ^ Nat.size (n + 1) ≤ n + 1 := not_le.2 (Nat.lt_size_self _)
      simp +decide [lgS, IState.cl_def, cls, isPosC, aK, if_neg h2])
    (fun k hk => lgB_runs s LA LR LP LJ n k (Nat.lt_size.1 hk))
  refine h.mono ?_
  have := sum_cLgB_le (Nat.size (n + 1))
  omega

theorem lgV_eq (n : ℕ) (hn : 3 ≤ n) : lgV n = lg n := by
  set J := Nat.size (n + 1) with hJ
  have h1 : n + 1 < 2 ^ J := Nat.lt_size_self _
  have hJ3 : 3 ≤ J := Nat.lt_size.2 (by omega)
  have h2 : 2 ^ (J - 1) ≤ n + 1 := Nat.lt_size.1 (by omega)
  have e1 : 2 ^ J = 2 * 2 ^ (J - 1) := by rw [← pow_succ']; congr 1; omega
  have e2 : 2 ^ (J - 1) = 2 * 2 ^ (J - 2) := by rw [← pow_succ']; congr 1; omega
  have e3 : 2 ≤ 2 ^ (J - 2) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (J - 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
  unfold lgV lg
  rw [← hJ]
  split_ifs with h
  · have : Nat.clog 2 n = J := by
      apply le_antisymm
      · exact (Nat.clog_le_iff_le_pow (by norm_num)).2 (by omega)
      · have := (Nat.lt_clog_iff_pow_lt (b := 2) (by norm_num) (x := n) (y := J - 1)).2 (by omega)
        omega
    rw [this]; omega
  · have : Nat.clog 2 n = J - 1 := by
      apply le_antisymm
      · exact (Nat.clog_le_iff_le_pow (by norm_num)).2 (by omega)
      · have := (Nat.lt_clog_iff_pow_lt (b := 2) (by norm_num) (x := n) (y := J - 2)).2 (by omega)
        omega
    rw [this]; omega

theorem lgS_zero (s : IState HS) (LA LR LP LJ : List Item) (n : ℕ) :
    lgS s LA LR LP LJ n 0 = (((s.upd gA (.int ((2 : ℤ) ^ n) :: LA)).upd gR (.int 2 :: LR)).upd gP
      (.int 0 :: LP)).upd gJ (.int 0 :: LJ) := by
  simp [lgS, aK, prvK]

theorem lgInit_runs (s : IState HS) (n : ℕ) (LN : List Item) (hN : s.G gN = .int ((2 : ℤ) ^ n) :: LN) :
    IRuns I iprog lgInit s (lgS s (s.G gA) (s.G gR) (s.G gP) (s.G gJ) n 0) (dupCost (n + 1) + 17 + 9) := by
  rw [lgS_zero]
  have i1 := IRuns.dup (I := I) (iprog := iprog) (s := s) (i := gN) (j := gA) (a := (2 : ℤ) ^ n)
    (L := LN) (by decide) hN
  have i2 := IRuns.const (I := I) (iprog := iprog) (s := s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)) gR 2
  have i3 := IRuns.const (I := I) (iprog := iprog)
    (s := (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).upd gR
      (.int 2 :: (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).G gR)) gP 0
  have i4 := IRuns.const (I := I) (iprog := iprog)
    (s := ((s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).upd gR
      (.int 2 :: (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).G gR)).upd gP (.int 0 ::
        ((s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).upd gR
          (.int 2 :: (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).G gR)).G gP)) gJ 0
  refine (i1.seq (i2.seq (i3.seq i4))).mono' ?_ ?_
  · clear i1 i2 i3 i4; ((apply NLogN.IState.ext' <;> intros <;>
                                simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                              split_ifs <;>
                            simp_all +decide))
  · rw [NLogN.zsz_two_pow]; simp only [zsz_zero]
    have : zsz (2 : ℤ) = 2 := by simpa using NLogN.zsz_two_pow 1
    omega

set_option maxHeartbeats 2000000 in
theorem lgPost_runs (s : IState HS) (n : ℕ) (hn : 3 ≤ n) (LN : List Item)
    (hN : s.G gN = .int ((2 : ℤ) ^ n) :: LN) :
    IRuns I iprog lgPost (lgS s (s.G gA) (s.G gR) (s.G gP) (s.G gJ) n (Nat.size (n + 1)))
      (s.upd gJ (.int (lgV n : ℤ) :: s.G gJ)) (10 ^ 4 * (n + 2 ^ Nat.size (n + 1) + Nat.size (n + 1) + 10)) := by
  set J := Nat.size (n + 1) with hJ
  have hJ3 : 3 ≤ J := Nat.lt_size.2 (by omega)
  have hJ1 : 2 ^ (J - 1) ≤ n + 1 := Nat.lt_size.1 (by omega)
  have haJ : aK n J = 0 := by
    have : ¬ 2 ^ J ≤ n + 1 := not_le.2 (Nat.lt_size_self _)
    simp [aK, this]
  have hpJ : ((prvK J : ℕ) : ℤ) = (2 : ℤ) ^ (2 ^ (J - 1)) := by
    simp [prvK, show J ≠ 0 by omega]
  obtain ⟨LA, hLA⟩ : ∃ L, s.G gA = L := ⟨_, rfl⟩
  obtain ⟨LR, hLR⟩ : ∃ L, s.G gR = L := ⟨_, rfl⟩
  obtain ⟨LP, hLP⟩ : ∃ L, s.G gP = L := ⟨_, rfl⟩
  obtain ⟨LJ, hLJ⟩ : ∃ L, s.G gJ = L := ⟨_, rfl⟩
  obtain ⟨LT, hLT⟩ : ∃ L, s.G gT = L := ⟨_, rfl⟩
  rw [hLA, hLR, hLP, hLJ]
  set m := 2 ^ (J - 1) + 1 with hm
  -- states
  set u0 := lgS s LA LR LP LJ n J with hu0
  set u1 := ((s.upd gR LR).upd gP (.int ((2 : ℤ) ^ (2 ^ (J - 1))) :: LP)).upd gJ (.int (J : ℤ) :: LJ)
    with hu1
  have p12 : IRuns I iprog (.seq (.op (.drop gA)) (.op (.drop gR))) u0 (u1.upd gA LA)
      (2 + (2 * (2 ^ J + 1) + 2)) := by
    have a1 := IRuns.drop (I := I) (iprog := iprog) (s := u0) (i := gA) (a := (0 : ℤ)) (L := LA)
      (by simp +decide [hu0, lgS, haJ])
    have a2 := IRuns.drop (I := I) (iprog := iprog) (s := u0.upd gA LA) (i := gR)
      (a := (2 : ℤ) ^ (2 ^ J)) (L := LR) (by simp +decide [hu0, lgS])
    refine (a1.seq a2).mono' ?_ ?_
    · simp only [hu0, hu1, lgS, hpJ]; clear a1 a2; ((apply NLogN.IState.ext' <;> intros <;>
                                                            simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                                          split_ifs <;>
                                                        simp_all +decide))
    · rw [NLogN.zsz_two_pow]; simp [zsz_zero]
  -- shl the previous ruler by 2
  have p35 : IRuns I iprog (.seq (.op (.const gT 2)) (.seq (.op (.shl gP gT)) (.op (.drop gT))))
      (u1.upd gA LA) ((u1.upd gA LA).upd gP (.int ((2 : ℤ) ^ m) :: LP)) 1000 := by
    have a3 := IRuns.const (I := I) (iprog := iprog) (s := u1.upd gA LA) gT 2
    have a4 := IRuns.shl (I := I) (iprog := iprog)
      (s := (u1.upd gA LA).upd gT (.int 2 :: (u1.upd gA LA).G gT)) (i := gP) (j := gT)
      (a := (2 : ℤ) ^ (2 ^ (J - 1))) (m := 1) (Li := LP) (Lj := (u1.upd gA LA).G gT) (by decide)
      (by simp +decide [hu1]) (by simp)
    have a5 := IRuns.drop (I := I) (iprog := iprog)
      (s := ((u1.upd gA LA).upd gT (.int 2 :: (u1.upd gA LA).G gT)).upd gP
        (.int ((2 : ℤ) ^ (2 ^ (J - 1)) * 2 ^ 1) :: LP)) (i := gT) (a := 2)
      (L := (u1.upd gA LA).G gT) (by simp +decide)
    refine (a3.seq (a4.seq a5)).mono' ?_ ?_
    · have : (2 : ℤ) ^ (2 ^ (J - 1)) * 2 ^ 1 = 2 ^ m := by rw [hm, pow_succ]; ring
      rw [this]; clear a3 a4 a5; ((apply NLogN.IState.ext' <;> intros <;>
                                          simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                        split_ifs <;>
                                      simp_all +decide))
    · have : zsz (2 : ℤ) = 2 := by simpa using NLogN.zsz_two_pow 1
      have := shlCost_le 1
      omega
  set u2 := (u1.upd gA LA).upd gP (.int ((2 : ℤ) ^ m) :: LP) with hu2
  -- copy 2^n and split
  have p6 := IRuns.dup (I := I) (iprog := iprog) (s := u2) (i := gN) (j := gA) (a := (2 : ℤ) ^ n)
    (L := LN) (by decide) (by simp +decide [hu2, hu1, hN])
  rw [show u2.G gA = LA by simp +decide [hu2]] at p6
  set q : ℕ := 2 ^ n / 2 ^ m with hq
  have p7 := IRuns.split (I := I) (iprog := iprog) (s := u2.upd gA (.int ((2 : ℤ) ^ n) :: LA))
    (i := gA) (j := gP) (k := gT) (a := (2 : ℤ) ^ n) (m := m) (Li := LA) (Lj := LP)
    (by decide) (by decide) (by decide) (by simp) (by simp +decide [hu2])
  have eq1 : sg ((2 : ℤ) ^ n) (((2 : ℤ) ^ n).natAbs / 2 ^ m) = (q : ℤ) := by
    rw [show ((2 : ℤ) ^ n) = ((2 ^ n : ℕ) : ℤ) by push_cast; rfl, Int.natAbs_natCast, sg_nat']
  set rr : ℕ := 2 ^ n % 2 ^ m with hrr
  have eq2 : sg ((2 : ℤ) ^ n) (((2 : ℤ) ^ n).natAbs % 2 ^ m) = (rr : ℤ) := by
    rw [show ((2 : ℤ) ^ n) = ((2 ^ n : ℕ) : ℤ) by push_cast; rfl, Int.natAbs_natCast, sg_nat']
  rw [eq1, eq2, show (u2.upd gA (.int ((2 : ℤ) ^ n) :: LA)).G gT = LT by simp +decide [hu2, hu1, hLT],
    IState.upd_upd_same] at p7
  set u3 := u2.upd gA (.int (q : ℤ) :: LA) with hu3
  have p8 := IRuns.drop (I := I) (iprog := iprog) (s := u3.upd gT (.int (rr : ℤ) :: LT)) (i := gT)
    (a := (rr : ℤ)) (L := LT) (by simp)
  rw [IState.upd_upd_same, show u3.upd gT LT = u3 by simp +decide [hu3, hu2, hu1, hLT]] at p8
  -- the test
  have p9 : IRuns I iprog (.ite gA isPosC .skip (.seq (.op (.const gT (-1))) (.op (.add gJ gT gJ)))) u3
      (u3.upd gJ (.int (lgV n : ℤ) :: LJ)) (500 * (zsz (J : ℤ) + 4)) := by
    by_cases hmn : m ≤ n
    · have hq0 : 0 < q := Nat.div_pos (Nat.pow_le_pow_right (by norm_num) hmn) (by positivity)
      have hv : lgV n = J := by simp [lgV, ← hJ, show 2 ^ (J - 1) + 1 ≤ n by omega]
      have t := IRuns.iteT (I := I) (iprog := iprog) (i := gA) (f := isPosC)
        (p := (.skip : IStmt HS P)) (q := .seq (.op (.const gT (-1))) (.op (.add gJ gT gJ)))
        (s := u3) (by
          have hq' : ¬ (q : ℤ) = 0 := by exact_mod_cast hq0.ne'
          have hq'' : ¬ (q : ℤ) < 0 := not_lt.2 (by positivity)
          rw [IState.cl_def, show u3.G gA = .int (q : ℤ) :: LA by simp [hu3]]
          simp [cls, isPosC, hq', hq'', hq0.ne']) (IRuns.skip u3)
      refine t.mono' ?_ (by omega)
      rw [hv]; simp +decide [hu3, hu2, hu1]
    · have hq0 : q = 0 := Nat.div_eq_of_lt (Nat.pow_lt_pow_right (by norm_num) (by omega))
      have hv : lgV n = J - 1 := by simp [lgV, ← hJ, show ¬ 2 ^ (J - 1) + 1 ≤ n by omega]
      have c1 := IRuns.const (I := I) (iprog := iprog) (s := u3) gT (-1)
      have c2 := IRuns.add (I := I) (iprog := iprog) (s := u3.upd gT (.int (-1) :: u3.G gT)) (i := gJ)
        (j := gT) (k := gJ) (a := (J : ℤ)) (b := -1) (Li := LJ) (Lj := u3.G gT) (by decide)
        (by simp +decide [hu3, hu2, hu1]) (by simp)
      have t := IRuns.iteF (I := I) (iprog := iprog) (i := gA) (f := isPosC)
        (p := (.skip : IStmt HS P)) (q := .seq (.op (.const gT (-1))) (.op (.add gJ gT gJ)))
        (s := u3) (by
          rw [IState.cl_def, show u3.G gA = .int (q : ℤ) :: LA by simp [hu3], hq0]
          simp [cls, isPosC]) (c1.seq c2)
      refine t.mono' ?_ ?_
      · rw [hv]
        have : ((J - 1 : ℕ) : ℤ) = (J : ℤ) + -1 := by push_cast [show 1 ≤ J by omega]; ring
        rw [this]; clear t c1 c2; ((apply NLogN.IState.ext' <;> intros <;>
                                           simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                         split_ifs <;>
                                       simp_all +decide))
      · have := addIntCost_le (zsz (J : ℤ) + zsz (-1 : ℤ))
        have : zsz (-1 : ℤ) = 1 := by rw [zsz_neg, zsz_one]
        omega
  -- drop the quotient and the ruler
  have p10 := IRuns.drop (I := I) (iprog := iprog) (s := u3.upd gJ (.int (lgV n : ℤ) :: LJ)) (i := gA)
    (a := (q : ℤ)) (L := LA) (by simp +decide [hu3])
  have p11 := IRuns.drop (I := I) (iprog := iprog)
    (s := (u3.upd gJ (.int (lgV n : ℤ) :: LJ)).upd gA LA) (i := gP)
    (a := (2 : ℤ) ^ m) (L := LP) (by simp +decide [hu3, hu2])
  refine (p12.seq (p35.seq (p6.seq (p7.seq (p8.seq (p9.seq (p10.seq p11))))))).mono' ?_ ?_
  · simp only [hu3, hu2, hu1]
    rw [← hLA, ← hLR, ← hLP, ← hLJ]
    clear p12 p35 p6 p7 p8 p9 p10 p11 eq1 eq2
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have hq1 : zsz (q : ℤ) ≤ n + 1 := by
      have : q ≤ 2 ^ n := Nat.div_le_self _ _
      exact zsz_le_iff.2 (by simpa using lt_of_le_of_lt this (Nat.pow_lt_pow_right (by norm_num) (by omega)))
    have hr1 : zsz (rr : ℤ) ≤ m := zsz_le_iff.2 (by simpa using Nat.mod_lt (2 ^ n) (by positivity : 0 < 2 ^ m))
    have z1 : zsz ((2 : ℤ) ^ n) = n + 1 := NLogN.zsz_two_pow n
    have z2 : zsz ((2 : ℤ) ^ m) = m + 1 := NLogN.zsz_two_pow m
    have d1 := NLogN.dupCost_le (n + 1)
    have sp := splitCost_le m
    have zJ := zsz_natCast_le_self' J
    have hm2 : m ≤ 2 ^ J := by
      have : 2 ^ (J - 1) < 2 ^ J := Nat.pow_lt_pow_right (by norm_num) (by omega)
      omega
    rw [z1, z2]
    omega

theorem sq_le_two_pow_succ : ∀ J : ℕ, J * J ≤ 2 ^ J + 1
  | 0 => by norm_num
  | 1 => by norm_num
  | 2 => by norm_num
  | 3 => by norm_num
  | J + 4 => by
    have ih := sq_le_two_pow_succ (J + 3)
    have h : 2 * (J + 3) + 1 ≤ 2 ^ (J + 3) := by
      have : J < 2 ^ J := Nat.lt_two_pow_self
      rw [pow_add]; norm_num; omega
    rw [pow_succ]; nlinarith

end IL

