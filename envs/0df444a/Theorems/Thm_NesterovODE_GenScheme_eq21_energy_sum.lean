-- created : 2026-10-09T00:51:06.598192+00:00
-- url     : https://prove2.me/theorems/dd6e09b0-002c-43b6-8e5f-7c961a64d398
-- title:
--   (21), p. 14 — E(k) + Σ_{i=1}^{k−1} (2s[(r − 3)(i + r − 1) + 1]/(r − 1))(f(x_i) − f⋆) ≤ (r − 1)‖x₀ − x⋆‖²
-- statement:
--   Under the assumptions of (20) — $f=g+h$ on a real Hilbert space with $g$ convex, $C^1$, $\nabla g$ $L$-Lipschitz ($L>0$), $h$ proper, lower semicontinuous and convex, $0<s\le1/L$, $r>3$, $(x_k)$ generated by the generalized Nesterov scheme (19) from $y_0=x_0$, $x^\star$ a minimizer of $f$ — the discrete energy $\mathcal E(k)=\frac{2(k+r-2)^2s}{r-1}(f(x_k)-f^\star)+(r-1)\|z_k-x^\star\|^2$ satisfies, for every $k\ge1$,
--
--   $$
--   \mathcal E(k)+\sum_{i=1}^{k-1}\frac{2s\big[(r-3)(i+r-1)+1\big]}{r-1}\big(f(x_i)-f^\star\big)\le (r-1)\|x_0-x^\star\|^2 .
--   $$
--
--   Both terms on the left are nonnegative, so this single estimate yields the pointwise rate $f(x_k)-f^\star\le\frac{(r-1)^2\|x_0-x^\star\|^2}{2s(k+r-2)^2}$ and the summability bound of Theorem 6.
--
--   **Formalization Note.** $\mathcal E(k)$ is the published `NesterovFB.Rates.energy`, and the sum is a finite sum over $i\in\{1,\dots,k-1\}$ in `EReal`, empty at $k=1$. The statement is for $k\ge1$: at $k=0$ the left side would be $\mathcal E(0)$, which contains $f(x_0)-f^\star$ and is not bounded by the right side. The right side does not involve $f(x_0)$, so $x_0$ may lie outside the domain of $h$. The proximal map is any $P$ with `IsProx s h P` for closed $h$; $s\le1/L$ is written $sL\le1$.
-- source:
--   Su, Boyd, Candès, A Differential Equation for Modeling Nesterov's Accelerated Gradient Method, arXiv:1503.01243v2, p. 14, (21)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_NesterovODE_GenScheme_Run

open InnerProductSpace NesterovFB.Rates ThreeOpSplitting.ConvexRates

namespace NesterovODE.GenScheme

theorem eq21_energy_sum {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s r : ℝ) (P : H → H) (x : ℕ → H) (xstar : H)
    (hΨ : IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL0 : 0 < L) (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L ≤ 1)
    (hP : IsProx s Ψ P)
    (hr : 3 < r)
    (hrun : IsGenNesterovRun Φ P r s x)
    (hmin : ∀ y : H, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k →
      energy Ψ Φ r s x xstar k
        + ∑ i ∈ Finset.Icc 1 (k - 1),
            ((2 * s * ((r - 3) * ((i : ℝ) + r - 1) + 1) / (r - 1) : ℝ) : EReal)
              * (theta Ψ Φ (x i) - theta Ψ Φ xstar)
        ≤ (((r - 1) * ‖x 0 - xstar‖ ^ 2 : ℝ) : EReal) := by sorry

end NesterovODE.GenScheme
