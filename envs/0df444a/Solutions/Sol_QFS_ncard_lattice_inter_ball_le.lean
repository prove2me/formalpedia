variable {V : Type*} {G : SimpleGraph V}
variable {d : ℕ}

/-- The lattice-point count, for open balls and in `ncard` form. -/
lemma solution (a : EuclideanSpace ℝ (Fin d)) (R : ℝ) :
    (ball a R ∩ QFS.lattice d).ncard ≤ (2 * ⌈R⌉₊ + 1) ^ d := by
  have hfin : (ball a R ∩ QFS.lattice d).Finite :=
    (QFS.lattice_inter_closedBall_finite a R).subset
      (fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩)
  have hsub : ball a R ∩ QFS.lattice d ⊆ QFS.lattice d ∩ closedBall a R :=
    fun x hx => ⟨hx.2, ball_subset_closedBall hx.1⟩
  have hle : (ball a R ∩ QFS.lattice d).encard ≤ (((2 * ⌈R⌉₊ + 1) ^ d : ℕ) : ℕ∞) :=
    le_trans (Set.encard_mono hsub) (QFS.encard_lattice_inter_closedBall_le a R)
  rw [← hfin.cast_ncard_eq] at hle
  exact_mod_cast hle
