-- title:
--   Representative vectors, extended vectors and their matching (Definitions 5.2, 5.6–5.8)
-- statement:
--   Fix a group restriction $(z,Y,g,F,\rho)$ of a class-2 $p$-group $G$ with parameters $\zeta,\gamma,\kappa,\tau$; $K=\langle F,Z(G)\rangle/Z(G)$, $t=\psi+\zeta_0$.
--
--   A **representative vector** $\vec r=(r_1,\dots,r_{\psi+\zeta_0+\eta})$ (Definition 5.2): (1) $r_i=y_iy'_i$ ($i\le\psi$) with $Y=\bigoplus\langle y_i\rangle$, $\mathrm{ord}(y_1)\le\cdots\le\mathrm{ord}(y_\psi)$, and $y'_i$ of order at most $p$ in the span of the $z_k$ of order greater than $p$; (2) $r_{\psi+i}=xx'$ ($i\le\zeta_0$), $x$ a power of $w=z^{\max\{1,\mathrm{ord}(z)/p^\tau\}}$ for the $i$-th $z$ of order greater than $p$, $\mathrm{ord}(r_{\psi+i})=\mathrm{ord}(w)$, $x'$ as in (1); (3) $K=\bigoplus_{i\le\eta}\langle\tilde r_{t+i}\rangle$ with nondecreasing orders, $r_{t+i}\in F$; (4) the vector $(\rho(r_{t+1}^{p^{\tau-1}}),\dots,\rho(r_{t+1}),\dots,\rho(r_{t+\eta}))$ is lexicographically smallest among all vectors satisfying (1)–(3).
--
--   **Coefficients** (Definition 5.6): with $g_{\gamma+s}=a_s$ and $s_\ell$ the $Y$-part of $a_\ell$, $[g_i,g_j]=\prod z_k^{\alpha_{i,j,k}}\prod s_\ell^{\beta_{i,j,\ell}}$ and $g_i^{\mathrm{ord}(\tilde g_i)}=\prod z_k^{\xi_{i,k}}\prod s_\ell^{\pi_{i,\ell}}$.
--
--   $S=K^p$ (generated by elements with a $p$-th root in $K$), $\ker\rho=\{\tilde g:g\in F,\rho(g)=0\}$, $K_i$ generated by the elements of $K$ of order at most $p^i$, $S_i=\langle K_{i-1},S\cap K_i\rangle\cap\ker\rho$, $\sigma_i=\mathrm{rank}\,S_i/(K_{i-1}\cap S_i)$, $\sigma=\sum_{i\le\tau}\sigma_i$. An **extended vector** (Definition 5.8) $(a_1,\dots,a_\phi)$, $\phi=\psi+\zeta_0+\eta+\sigma$, begins with a representative vector and continues with $w_{i,1},\dots,w_{i,\sigma_i}\in F$ ($i=1,\dots,\tau$) whose images decompose $S_i/(K_{i-1}\cap S_i)$.
--
--   Two extended vectors **match** (Definitions 5.7–5.8) if the restrictions have the same $\psi,\zeta_0,\eta$ and length $\phi$, $\alpha,\beta,\pi$ agree for all indices in $[\gamma+\phi]$, $\xi_{i,k}\equiv\xi'_{i,k}\pmod{\mathrm{ord}(z_k)/p}$, and $\rho(a_i)=\rho'(b_i)$ for all $i$.
--
--   The **standing assumptions of Section 5** are bundled as `Sec5Standing`: $\psi,\eta$ equal, $Y\cong X$, $K\cong K'$, $\mathrm{ord}(z_i)=\mathrm{ord}(z'_i)$, $\mathrm{ord}(\tilde g_i)=\mathrm{ord}(\tilde g'_i)$, equal $z$-coefficients of $[g_i,g_j]$ and $g_i^{\mathrm{ord}(\tilde g_i)}$ for $i,j\le\gamma$ ((7)), and $\tau\ge2$.
--
--   **Formalization Note** Elements of $R$ are compared lexicographically through their representatives in $[0,p^\tau)$. Vectors are `Fin n → G` read one-based through `at1`.
--
--   `Sec5Standing` also includes p ≤ ord(z_i), the nontrivial central cyclic factors implicit in the reindexing on PDF p. 29.
-- source:
--   Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), Definitions 5.2, 5.6–5.8, pp. 27–32 (PDF 29–34); pp. 13–14 (PDF 15–16)

import Mathlib
import Definitions.Def_SunGroupIso_Class2_Restriction

set_option autoImplicit false

noncomputable section

open scoped Classical commutatorElement

namespace SunGroupIso.Class2

variable {G H : Type*} [Group G] [Group H] {p ζ γ κ τ : ℕ}

/-- **Conditions 1–3 of a representative vector** (Definition 5.2, p. 27, PDF p. 29), for
`v⃗ = (v_1, …, v_{ψ+ζ_0+η})` (one-based on the page):
1. `v_i = y_i · y'_i` (`i ≤ ψ`) with `Y = ⊕ ⟨y_i⟩`, `ord(y_1) ≤ ⋯ ≤ ord(y_ψ)`, and `y'_i` an element of
   order at most `p` in the span of the `z_k` of order greater than `p`;
2. `v_{ψ+i} = x · x'` (`i ≤ ζ_0`) with `x` a power of `w = z^{max{1, ord(z)/p^τ}}`, `z` the `i`-th
   generator of order greater than `p`, `ord(v_{ψ+i}) = ord(w)`, and `x'` of order at most `p` in that span;
3. `⟨F, Z(G)⟩/Z(G) = ⊕_{i=1}^{η} ⟨ṽ_{ψ+ζ_0+i}⟩` with nondecreasing orders; these `v_{ψ+ζ_0+i}` lie in
   `F`, the domain of `ρ` (condition 4 evaluates `ρ` on them). -/
def RepConds (r : Restriction G p ζ γ κ τ) {n : ℕ} (v : Fin n → G) : Prop :=
  n = r.psi + r.zeta0 + r.eta ∧
  (∃ y : Fin r.psi → G, DecompWith r.Y y ⊥ ∧ Monotone (fun i => orderOf (y i)) ∧
    ∀ i : Fin r.psi, (y i)⁻¹ * at1 v (i.val + 1) ∈ r.Zbig ∧
      orderOf ((y i)⁻¹ * at1 v (i.val + 1)) ≤ p) ∧
  (∀ i : ℕ, 1 ≤ i → i ≤ r.zeta0 →
    ∃ c : ℕ, ∃ x' ∈ r.Zbig, orderOf x' ≤ p ∧
      at1 v (r.psi + i) = (r.zBig i ^ max 1 (orderOf (r.zBig i) / p ^ τ)) ^ c * x' ∧
      orderOf (at1 v (r.psi + i)) = orderOf (r.zBig i ^ max 1 (orderOf (r.zBig i) / p ^ τ))) ∧
  (∀ i : ℕ, 1 ≤ i → i ≤ r.eta → at1 v (r.psi + r.zeta0 + i) ∈ r.F) ∧
  DecompWith r.Kq (fun i : Fin r.eta => tl (at1 v (r.psi + r.zeta0 + i.val + 1))) ⊥ ∧
  Monotone (fun i : Fin r.eta => orderOf (tl (at1 v (r.psi + r.zeta0 + i.val + 1))))

/-- The lexicographic key of condition 4 of Definition 5.2: the vector
`(ρ(v_{t+1}^{p^{τ−1}}), …, ρ(v_{t+1}), …, ρ(v_{t+η}^{p^{τ−1}}), …, ρ(v_{t+η})) ∈ R^{η·τ·κ}`, `t = ψ + ζ_0`,
each coordinate read as its representative in `[0, p^τ)`. -/
def repKey (r : Restriction G p ζ γ κ τ) {n : ℕ} (v : Fin n → G) : List ℕ :=
  (List.range r.eta).flatMap fun i =>
    (List.range τ).reverse.flatMap fun j =>
      List.ofFn fun s : Fin κ => (r.ρ (at1 v (r.psi + r.zeta0 + i + 1) ^ (p ^ j)) s).val

/-- **Representative vector** (Definition 5.2, p. 27, PDF p. 29): conditions 1–3, and (4) its key is
lexicographically smallest among all vectors satisfying 1–3. -/
def IsRepVec (r : Restriction G p ζ γ κ τ) {n : ℕ} (v : Fin n → G) : Prop :=
  RepConds r v ∧ ∀ v' : Fin n → G, RepConds r v' → repKey r v ≤ repKey r v'

/-- `g_1, …, g_γ` followed by the vector: `g_{γ+s} = a_s` (Definitions 5.6 and 5.8), one-based. -/
def gAll (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (i : ℕ) : G :=
  if i ≤ γ then at1 r.g i else at1 a (i - γ)

/-- `s_ℓ`, the `Y`-component of `a_ℓ` in `Z(G) = ⟨z_1⟩ ⊕ ⋯ ⊕ ⟨z_ζ⟩ ⊕ Y` (Definition 5.6, p. 30). -/
def sVec (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) : Fin r.psi → G :=
  fun l => partWith r.z r.Y (at1 a (l.val + 1))

/-- Coefficients of a central element with respect to `z_1, …, z_ζ, s_1, …, s_ψ`. -/
def cenCo (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (x : G) : Fin (ζ + r.psi) → ℕ :=
  coeffsWith (Fin.append r.z (sVec r a)) ⊥ x

/-- `α_{i,j,k}` (Definition 5.6 (5), one-based): the `z_k`-coefficient of `[g_i, g_j]`. -/
def alphaC (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (i j k : ℕ) : ℕ :=
  atN (cenCo r a ⁅gAll r a i, gAll r a j⁆) (k - 1)

/-- `β_{i,j,ℓ}` (Definition 5.6 (5)): the `s_ℓ`-coefficient of `[g_i, g_j]`. -/
def betaC (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (i j l : ℕ) : ℕ :=
  atN (cenCo r a ⁅gAll r a i, gAll r a j⁆) (ζ + l - 1)

/-- `ξ_{i,k}` (Definition 5.6 (6)): the `z_k`-coefficient of `g_i^{ord(g̃_i)}`. -/
def xiC (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (i k : ℕ) : ℕ :=
  atN (cenCo r a (gAll r a i ^ orderOf (tl (gAll r a i)))) (k - 1)

/-- `π_{i,ℓ}` (Definition 5.6 (6)): the `s_ℓ`-coefficient of `g_i^{ord(g̃_i)}`. -/
def piC (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) (i l : ℕ) : ℕ :=
  atN (cenCo r a (gAll r a i ^ orderOf (tl (gAll r a i)))) (ζ + l - 1)

/-- `S = K^p`: the subgroup of `K = ⟨F, Z(G)⟩/Z(G)` generated by its elements with a `p`-th root in `K`
(§5.2, p. 31, PDF p. 33). -/
def Restriction.Kp (r : Restriction G p ζ γ κ τ) : Subgroup (Qt G) :=
  Subgroup.closure {x | x ∈ r.Kq ∧ ∃ y ∈ r.Kq, y ^ p = x}

/-- `ker(ρ) = {g̃ ∈ K : ρ(g̃) = 0}`, with `ρ(g̃) = ρ(g)` for `g ∈ F` (p. 31). -/
def Restriction.kerRho (r : Restriction G p ζ γ κ τ) : Subgroup (Qt G) :=
  Subgroup.closure {x | ∃ g ∈ r.F, tl g = x ∧ r.ρ g = 0}

/-- `K_i`: the subgroup generated by the elements of `K` of order at most `p^i` (`K_0` is trivial). -/
def Restriction.Kfil (r : Restriction G p ζ γ κ τ) (i : ℕ) : Subgroup (Qt G) :=
  Subgroup.closure {x | x ∈ r.Kq ∧ orderOf x ≤ p ^ i}

/-- `S_i = ⟨K_{i−1}, S ∩ K_i⟩ ∩ ker(ρ)` (for `i = 1` this is `S ∩ K_1 ∩ ker(ρ)`, as `K_0` is trivial). -/
def Restriction.Sfil (r : Restriction G p ζ γ κ τ) (i : ℕ) : Subgroup (Qt G) :=
  (r.Kfil (i - 1) ⊔ (r.Kp ⊓ r.Kfil i)) ⊓ r.kerRho

/-- `σ_i = rank S_i/(K_{i−1} ∩ S_i)`. -/
def Restriction.sigmaI (r : Restriction G p ζ γ κ τ) (i : ℕ) : ℕ :=
  relRank (r.Sfil i) (r.Kfil (i - 1) ⊓ r.Sfil i)

/-- `σ_1 + ⋯ + σ_{i−1}`. -/
def Restriction.sigmaOff (r : Restriction G p ζ γ κ τ) (i : ℕ) : ℕ :=
  ∑ i' ∈ Finset.Ico 1 i, r.sigmaI i'

/-- `σ = σ_1 + ⋯ + σ_τ`. -/
def Restriction.sigma (r : Restriction G p ζ γ κ τ) : ℕ := ∑ i ∈ Finset.Icc 1 τ, r.sigmaI i

/-- **Extended (representative) vector** (Definition 5.8, pp. 31–32, PDF pp. 33–34):
`a⃗ = (a_1, …, a_ϕ)`, `ϕ = ψ + ζ_0 + η + σ`; its first `ψ + ζ_0 + η` entries form a representative
vector, and the rest are `w_{1,1}, …, w_{1,σ_1}, …, w_{τ,1}, …, w_{τ,σ_τ} ∈ F` with
`S_i/(K_{i−1} ∩ S_i) = ⊕_j ⟨w̃_{i,j} (K_{i−1} ∩ S_i)⟩`. -/
def IsExtVec (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G) : Prop :=
  n = r.psi + r.zeta0 + r.eta + r.sigma ∧
  IsRepVec r (fun i : Fin (r.psi + r.zeta0 + r.eta) => at1 a (i.val + 1)) ∧
  ∀ i : ℕ, 1 ≤ i → i ≤ τ →
    (∀ j : ℕ, 1 ≤ j → j ≤ r.sigmaI i →
      at1 a (r.psi + r.zeta0 + r.eta + r.sigmaOff i + j) ∈ r.F) ∧
    DecompMod (r.Sfil i) (r.Kfil (i - 1) ⊓ r.Sfil i)
      (fun j : Fin (r.sigmaI i) => tl (at1 a (r.psi + r.zeta0 + r.eta + r.sigmaOff i + j.val + 1)))

/-- **Matching extended vectors** (Definitions 5.7 and 5.8, pp. 31–32): the two restrictions have the
same parameters (`ψ, ζ_0, η` and the length `ϕ`); for all `i, j ∈ [γ+ϕ]`, `k ∈ [ζ]`, `ℓ ∈ [ψ]`:
`α_{i,j,k} = α'_{i,j,k}`, `β_{i,j,ℓ} = β'_{i,j,ℓ}`, `π_{i,ℓ} = π'_{i,ℓ}`,
`ξ_{i,k} ≡ ξ'_{i,k} (mod ord(z_k)/p)`; and `ρ(a_i) = ρ'(b_i)` for `i ∈ [ϕ]`. -/
def Matches (r : Restriction G p ζ γ κ τ) {n : ℕ} (a : Fin n → G)
    (r' : Restriction H p ζ γ κ τ) {n' : ℕ} (b : Fin n' → H) : Prop :=
  r.psi = r'.psi ∧ r.zeta0 = r'.zeta0 ∧ r.eta = r'.eta ∧ n = n' ∧
  (∀ i j k : ℕ, 1 ≤ i → i ≤ γ + n → 1 ≤ j → j ≤ γ + n → 1 ≤ k → k ≤ ζ →
    alphaC r a i j k = alphaC r' b i j k) ∧
  (∀ i j l : ℕ, 1 ≤ i → i ≤ γ + n → 1 ≤ j → j ≤ γ + n → 1 ≤ l → l ≤ r.psi →
    betaC r a i j l = betaC r' b i j l) ∧
  (∀ i l : ℕ, 1 ≤ i → i ≤ γ + n → 1 ≤ l → l ≤ r.psi → piC r a i l = piC r' b i l) ∧
  (∀ i k : ℕ, 1 ≤ i → i ≤ γ + n → 1 ≤ k → k ≤ ζ →
    xiC r a i k ≡ xiC r' b i k [MOD orderOf (at1 r.z k) / p]) ∧
  (∀ i : ℕ, 1 ≤ i → i ≤ n → r.ρ (at1 a i) = r'.ρ (at1 b i))

/-- **The standing assumptions of Section 5** (pp. 13–14, PDF pp. 15–16; (7), p. 31; `τ ≥ 2`, proof of
Lemma 5.15): the parameters `ψ, η` agree; `Y ≅ X`; `⟨F,Z(G)⟩/Z(G) ≅ ⟨E,Z(H)⟩/Z(H)`;
`ord(z_i) = ord(z'_i)`; `ord(g̃_i) = ord(g̃'_i)`; for `i, j ≤ γ` the `z`-coefficients of `[g_i, g_j]` and
of `g_i^{ord(g̃_i)}` agree with those of `[g'_i, g'_j]` and `g'_i^{ord(g̃'_i)}`; and `τ ≥ 2`; the central cyclic factors are nontrivial as in the reindexing on PDF p. 29. -/
def Sec5Standing (r : Restriction G p ζ γ κ τ) (r' : Restriction H p ζ γ κ τ) : Prop :=
  2 ≤ τ ∧ (∀ i, p ≤ orderOf (r.z i)) ∧ r.psi = r'.psi ∧ r.eta = r'.eta ∧ Nonempty (r.Y ≃* r'.Y) ∧ Nonempty (r.Kq ≃* r'.Kq) ∧
  (∀ i, orderOf (r.z i) = orderOf (r'.z i)) ∧
  (∀ i, orderOf (tl (r.g i)) = orderOf (tl (r'.g i))) ∧
  (∀ i j, r.zCo ⁅r.g i, r.g j⁆ = r'.zCo ⁅r'.g i, r'.g j⁆) ∧
  (∀ i, r.zCo (r.g i ^ orderOf (tl (r.g i))) = r'.zCo (r'.g i ^ orderOf (tl (r'.g i))))

end SunGroupIso.Class2


