variable {𝒪 : Type} [CommRing 𝒪] {M : Scheme.{0}} (fM : M ⟶ Spec (CommRingCat.of 𝒪))
  (C : Type) [CommRing C] [Algebra 𝒪 C]

noncomputable abbrev MC : Scheme.{0} := pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))

noncomputable abbrev fC : MC fM C ⟶ Spec (CommRingCat.of C) :=
  pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))

theorem specMap_mk_comp_specMap_algebraMap (J : Ideal C) :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)) =
      Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ J))) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Ideal.Quotient.mk_comp_algebraMap]

noncomputable def pasteIso (J : Ideal C) :
    pullback (fC fM C) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) ≅
      pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ J)))) :=
  pullbackLeftPullbackSndIso fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) ≪≫
    pullback.congrHom rfl (specMap_mk_comp_specMap_algebraMap C J)

@[reassoc]
theorem pasteIso_hom_fst (J : Ideal C) :
    (pasteIso fM C J).hom ≫ pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ J)))) =
      pullback.fst (fC fM C) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) ≫
        pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) := by
  rw [pasteIso, Iso.trans_hom, Category.assoc, pullback.congrHom_hom]
  erw [pullback.lift_fst]
  rw [Category.comp_id, pullbackLeftPullbackSndIso_hom_fst]

@[reassoc]
theorem pasteIso_hom_snd (J : Ideal C) :
    (pasteIso fM C J).hom ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ J)))) =
      pullback.snd (fC fM C) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) := by
  rw [pasteIso, Iso.trans_hom, Category.assoc, pullback.congrHom_hom]
  erw [pullback.lift_snd]
  rw [Category.comp_id, pullbackLeftPullbackSndIso_hom_snd]

noncomputable abbrev redMap (J : Ideal C) :
    pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ J)))) ⟶ MC fM C :=
  (pasteIso fM C J).inv ≫ pullback.fst (fC fM C) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))

theorem isNilpotent_span_singleton {a : C} (ha : IsNilpotent a) : IsNilpotent (Ideal.span ({a} : Set C)) := by
  obtain ⟨n, hn⟩ := ha
  exact ⟨n, by rw [Ideal.span_singleton_pow, hn, Ideal.span_singleton_eq_bot.mpr rfl]; rfl⟩

theorem exists_etale_lift_of_etale_reduction (π : 𝒪) (hC : IsNilpotent (algebraMap 𝒪 C π))
    {Xbar : Scheme.{0}}
    (ξ : Xbar ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ Ideal.span {algebraMap 𝒪 C π})))))
    [Etale ξ] :
    ∃ (X : Scheme.{0}) (q : X ⟶ MC fM C) (_ : Etale q) (j : Xbar ⟶ X)
      (_ : IsPullback j ξ q (redMap fM C (Ideal.span {algebraMap 𝒪 C π}))),
      ∀ (B : Type) [CommRing B] [Algebra C B] (t : Spec (CommRingCat.of B) ⟶ MC fM C),
        t ≫ fC fM C = Spec.map (CommRingCat.ofHom (algebraMap C B)) →
        ∀ (s₀ : Spec (CommRingCat.of (B ⧸ (Ideal.span {algebraMap 𝒪 C π}).map (algebraMap C B))) ⟶ Xbar),
          s₀ ≫ ξ ≫ redMap fM C (Ideal.span {algebraMap 𝒪 C π}) =
            Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((Ideal.span {algebraMap 𝒪 C π}).map (algebraMap C B)))) ≫ t →
          ∃! s : Spec (CommRingCat.of B) ⟶ X, s ≫ q = t ∧
            Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((Ideal.span {algebraMap 𝒪 C π}).map (algebraMap C B)))) ≫ s =
              s₀ ≫ j := by
  have hJn : IsNilpotent (Ideal.span ({algebraMap 𝒪 C π} : Set C)) := isNilpotent_span_singleton C hC
  haveI : Etale (ξ ≫ (pasteIso fM C (Ideal.span {algebraMap 𝒪 C π})).inv) := inferInstance
  obtain ⟨Y, q, hq, j, hpb, H⟩ :=
    AlgebraicGeometry.exists_etale_isPullback_forall_existsUnique_comp_eq_of_isNilpotent C
      (Ideal.span {algebraMap 𝒪 C π}) hJn (fC fM C) (ξ ≫ (pasteIso fM C (Ideal.span {algebraMap 𝒪 C π})).inv)
  refine ⟨Y, q, hq, j, ?_, ?_⟩
  ·
    refine hpb.of_iso (Iso.refl _) (Iso.refl _) (pasteIso fM C (Ideal.span {algebraMap 𝒪 C π})) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp
    · simp [redMap]
  · intro B _ _ t ht s₀ hs₀
    refine H B t ht s₀ ?_
    simpa only [redMap, Category.assoc] using hs₀

theorem span_singleton_map_algebraMap (B : Type) [CommRing B] [Algebra C B] (p : C) :
    (Ideal.span ({p} : Set C)).map (algebraMap C B) = Ideal.span {algebraMap C B p} := by
  rw [Ideal.map_span, Set.image_singleton]

noncomputable abbrev quotCmp (B : Type) [CommRing B] [Algebra C B] (p : C) :
    Spec (CommRingCat.of (B ⧸ (Ideal.span ({p} : Set C)).map (algebraMap C B))) ⟶
      Spec (CommRingCat.of (B ⧸ Ideal.span ({algebraMap C B p} : Set B))) :=
  Spec.map (CommRingCat.ofHom (Ideal.quotEquivOfEq (span_singleton_map_algebraMap C B p).symm).toRingHom)

theorem quotCmp_comp_specMap_mk (B : Type) [CommRing B] [Algebra C B] (p : C) :
    quotCmp C B p ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap C B p} : Set B)))) =
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk ((Ideal.span ({p} : Set C)).map (algebraMap C B)))) := by
  rw [quotCmp, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rfl

scoped instance (B : Type) [CommRing B] [Algebra C B] (p : C) : IsIso (quotCmp C B p) := by
  change IsIso (Spec.map (RingEquiv.toCommRingCatIso (Ideal.quotEquivOfEq (span_singleton_map_algebraMap C B p).symm)).hom)
  infer_instance

theorem exists_etale_lift_of_etale_reduction' (π : 𝒪) (hC : IsNilpotent (algebraMap 𝒪 C π))
    {Xbar : Scheme.{0}}
    (ξ : Xbar ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ Ideal.span {algebraMap 𝒪 C π})))))
    [Etale ξ] :
    ∃ (X : Scheme.{0}) (q : X ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
      (_ : Etale q) (j : Xbar ⟶ X)
      (_ : IsPullback j ξ q (redMap fM C (Ideal.span {algebraMap 𝒪 C π}))) (_ : Mono j),
      (∀ (T : Type) [CommRing T] [Algebra C T], algebraMap C T (algebraMap 𝒪 C π) = 0 →
        ∀ s : Spec (CommRingCat.of T) ⟶ X,
          s ≫ q ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
            Spec.map (CommRingCat.ofHom (algebraMap C T)) →
          ∃ s₀ : Spec (CommRingCat.of T) ⟶ Xbar, s₀ ≫ j = s) ∧
      (∀ (B : Type) [CommRing B] [Algebra C B]
        (t : Spec (CommRingCat.of B) ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))),
        t ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
          Spec.map (CommRingCat.ofHom (algebraMap C B)) →
        ∀ (s₀ : Spec (CommRingCat.of (B ⧸ Ideal.span {algebraMap C B (algebraMap 𝒪 C π)})) ⟶ Xbar),
          s₀ ≫ ξ ≫ redMap fM C (Ideal.span {algebraMap 𝒪 C π}) =
            Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B (algebraMap 𝒪 C π)}))) ≫ t →
          ∃! s : Spec (CommRingCat.of B) ⟶ X, s ≫ q = t ∧
            Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B (algebraMap 𝒪 C π)}))) ≫ s =
              s₀ ≫ j) := by
  obtain ⟨X, q, hq, j, hpb, H⟩ := exists_etale_lift_of_etale_reduction fM C π hC ξ

  haveI : Mono (redMap fM C (Ideal.span {algebraMap 𝒪 C π})) := by
    dsimp only [redMap]
    have hci : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap 𝒪 C π} : Set C))))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    haveI : IsClosedImmersion (pullback.fst (fC fM C)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap 𝒪 C π} : Set C)))))) :=
      MorphismProperty.pullback_fst _ _ hci
    haveI : Mono (pullback.fst (fC fM C)
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap 𝒪 C π} : Set C)))))) :=
      inferInstance
    exact mono_comp _ _
  have hmono : Mono j := hpb.mono_fst_of_mono
  refine ⟨X, q, hq, j, hpb, hmono, ?_, ?_⟩
  ·
    intro T _ _ hT s hs
    have hle : ∀ a ∈ Ideal.span ({algebraMap 𝒪 C π} : Set C), algebraMap C T a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      obtain ⟨b, rfl⟩ := ha
      simp [hT]
    set lamT : C ⧸ Ideal.span ({algebraMap 𝒪 C π} : Set C) →+* T :=
      Ideal.Quotient.lift (Ideal.span {algebraMap 𝒪 C π}) (algebraMap C T) hle with hlam
    have hfac : CommRingCat.ofHom (algebraMap C T) =
        CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap 𝒪 C π} : Set C))) ≫ CommRingCat.ofHom lamT := by
      ext x; rfl
    set u : Spec (CommRingCat.of T) ⟶
        pullback (fC fM C) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({algebraMap 𝒪 C π} : Set C))))) :=
      pullback.lift (s ≫ q) (Spec.map (CommRingCat.ofHom lamT))
        (by rw [Category.assoc, hs, hfac, Spec.map_comp]) with hu
    refine ⟨hpb.lift s (u ≫ (pasteIso fM C (Ideal.span {algebraMap 𝒪 C π})).hom) ?_, IsPullback.lift_fst _ _ _ _⟩
    simp only [redMap, Category.assoc, Iso.hom_inv_id_assoc, hu, pullback.lift_fst]
  ·
    intro B _ _ t ht s₀ hs₀
    have hemk := quotCmp_comp_specMap_mk C B (algebraMap 𝒪 C π)
    obtain ⟨s, ⟨hs1, hs2⟩, huniq⟩ := H B t ht (quotCmp C B (algebraMap 𝒪 C π) ≫ s₀) (by
      rw [Category.assoc, hs₀, ← Category.assoc, hemk])
    refine ⟨s, ⟨hs1, ?_⟩, fun s' hs' => huniq s' ⟨hs'.1, ?_⟩⟩
    · rw [← hemk] at hs2
      simpa only [Category.assoc, cancel_epi] using hs2
    · rw [← hemk]
      simp only [Category.assoc, hs'.2]

theorem exists_chart_lift (π : 𝒪) (hC : IsNilpotent (algebraMap 𝒪 C π))
    {Xb : Scheme.{0}}
    (ξ : Xb ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ Ideal.span {algebraMap 𝒪 C π})))))
    [Etale ξ] :
