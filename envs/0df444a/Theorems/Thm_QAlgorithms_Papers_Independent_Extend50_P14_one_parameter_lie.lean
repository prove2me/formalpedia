-- title:
--   Proposition 1: exact one-parameter reachability
-- statement:
--   Let n≥1 positive-dimensional sites carry on-site unitary representations of a group G, and let 1≤k≤n. Let V_k be their finite-product symmetric local gate group and let h_k be the real Lie algebra generated by k-local invariant skew-Hermitian matrices. For any Hermitian H,
--
--   $$\left(\forall t\in\mathbb R,\ e^{-itH}\in V_k\right)\quad\Longleftrightarrow\quad iH\in h_k.$$
--
--   This characterizes the whole one-parameter family, rather than one endpoint.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 13, Proposition 1: the local symmetric generated Lie algebra

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

section General

variable {G : Type*} [Group G] {n : ℕ} {D : Fin n → Type*}

variable [∀ j, Fintype (D j)] [∀ j, DecidableEq (D j)] [hD : ∀ j, Nonempty (D j)]

-- Positive local dimensions are a physical standing assumption even when unused
-- in the displayed formula; include it in each theorem's elaborated binders.

include hD

/-- PDF p.13, Proposition 1/A6: the quantifier over every real time is inside
this equivalence; one exponential at one fixed time is insufficient. -/
theorem one_parameter_lie (hn : 1 ≤ n) (r : OnSite G D)
    (k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) (H : Mat (SiteBasis D))
    (hH : H.IsHermitian) :
    (∀ t : ℝ, schrodingerEvolution H t ∈ symmetricLocalGroup r.total k) ↔ Complex.I • H ∈ symmetricLocalLie r.total k := by sorry

end General

end QAlgorithms.Papers.Independent.Extend50.P14

end
