-- ===== S4.Def_RP_EtPBC_A_O2L8a =====
section

/-!
# S4-EtPBC-A, O2 L8a: finite coproducts, and the transport `TrG` for every sheaf on `P¹_S`
* **`Delta.surjAt_coprod`**: surjectivity on germs passes to finite coproducts (`ι : Type`, finite);
* `wGIso`, `wG`, `wG_natural`: `e^* ιP^* G ≅ ι^* G` (`e = fibToP1`, `e ≫ ιP = ι`), natural in `G`;
* **`TrG`** `G x = u ∘ e^*x ∘ wG`: `Ext²(Λ[P¹_K], ιP^*G) → Ext²(Λ_{P_s}, ι^*G)`; `TrGh` (additive, `rfl`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.Delta

universe w v₁ u₁ v₂ u₂ v₃ u₃

variable {C : Type u₁} [Category.{v₁} C] [Abelian C] [HasExt.{w} C]
  {D : Type u₂} [Category.{v₂} D] [Abelian D] [HasExt.{w} D]
  {J : Type u₃} [Category.{v₃} J]
  {L : C ⥤ D} [L.Additive] [PreservesFiniteLimits L] [PreservesFiniteColimits L]
  {A : J ⥤ C} {B : D} {u : ∀ j, B ⟶ L.obj (A.obj j)}

/-- **Surjectivity on germs passes to finite coproducts.** -/
theorem surjAt_coprod [IsCofiltered J] (hu : ∀ {j j' : J} (a : j' ⟶ j), u j' ≫ L.map (A.map a) = u j)
    (q : ℕ) {ι : Type} [Finite ι] (f : ι → C) (h : ∀ i, SurjAt L A B u q (f i)) :
    SurjAt L A B u q (∐ f) := by
  classical
  have := Fintype.ofFinite ι
  have : HasFiniteBiproducts C := Abelian.hasFiniteBiproducts
  intro β
  let e := biproduct.isoCoproduct f
  have hmem : ∀ t : Finset ι, β.comp (Ext.mk₀ (L.map (∑ i ∈ t, (e.inv ≫ biproduct.π f i) ≫
      (biproduct.ι f i ≫ e.hom)))) (add_zero q) ∈ bcImg L A B u hu (∐ f) q := by
    intro t
    induction t using Finset.induction_on with
    | empty => rw [Finset.sum_empty, L.map_zero, Ext.mk₀_zero, Ext.comp_zero]; exact zero_mem _
    | insert i t hi ih =>
      rw [Finset.sum_insert hi, L.map_add, Ext.mk₀_add, Ext.comp_add]
      refine add_mem ?_ ih
      obtain ⟨j, α, hα⟩ := h i (β.comp (Ext.mk₀ (L.map (e.inv ≫ biproduct.π f i))) (add_zero q))
      refine ⟨j, α.comp (Ext.mk₀ (biproduct.ι f i ≫ e.hom)) (add_zero q), ?_⟩
      rw [bc_comp_mk₀, hα, Ext.comp_assoc_of_second_deg_zero, Ext.mk₀_comp_mk₀, ← L.map_comp]
  have htot : ∑ i ∈ Finset.univ, (e.inv ≫ biproduct.π f i) ≫ (biproduct.ι f i ≫ e.hom) = 𝟙 (∐ f) := by
    calc ∑ i ∈ Finset.univ, (e.inv ≫ biproduct.π f i) ≫ (biproduct.ι f i ≫ e.hom)
        = e.inv ≫ (∑ i, biproduct.π f i ≫ biproduct.ι f i) ≫ e.hom := by
          rw [Preadditive.sum_comp, Preadditive.comp_sum]; simp only [Category.assoc]
      _ = 𝟙 _ := by rw [biproduct.total, Category.id_comp, Iso.inv_hom_id]
  have h1 := hmem Finset.univ
  rw [htot, L.map_id, Ext.comp_mk₀_id] at h1
  exact h1

end RamanujanPetersson.EtPBC.Delta

