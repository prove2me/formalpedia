  rw [hne', Int.toNat_natCast] at c1
  rw [srch, RS.cost_seq']
  have r0 : (push m (.lit 0)).run s = s.upd m (.int 0 :: s.G m) := by simp [RS.run, Ex.eval]
  rw [r0]
  have hX : 4 ≤ (B + 2) ^ 2 := by nlinarith [Nat.zero_le B]
