/-- `n1 = -(R_h + R_i)`. -/
def n1 (Rh Ri : ℝ) : ℝ := -(Rh + Ri)
/-- `n0 = R_h R_i`. -/
def n0 (Rh Ri : ℝ) : ℝ := Rh * Ri
/-- `N0(R) = (R - R_h)(R - R_i)`. -/
def N0 (Rh Ri : ℝ) (R : ℝ) : ℝ := (R - Rh) * (R - Ri)
/-- `N0'(R) = 2R - R_h - R_i`. -/
def N0d (Rh Ri : ℝ) (R : ℝ) : ℝ := 2 * R - Rh - Ri
/-- `f0 = N0/R²`. -/
noncomputable def f0 (Rh Ri : ℝ) (R : ℝ) : ℝ := N0 Rh Ri R / R ^ 2
/-- `m0 = N0/R`. -/
noncomputable def m0 (Rh Ri : ℝ) (R : ℝ) : ℝ := N0 Rh Ri R / R
/-- `p0 = Q/R`. -/
noncomputable def p0 (Q : ℝ) (R : ℝ) : ℝ := Q / R
/-- `P = N0/R` (the same function as `m0`; `Pc_eq_m0`). -/
noncomputable def Pc (Rh Ri : ℝ) (R : ℝ) : ℝ := N0 Rh Ri R / R
/-- `V = 1/R + 4Q²/R³`. -/
noncomputable def Vc (Q : ℝ) (R : ℝ) : ℝ := 1 / R + 4 * Q ^ 2 / R ^ 3

