theorem κκ_gA₁ (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S)) (i j : Fin k)
    (κ : (v₁ S B u i j).A ⟶ (v₁ S B u j i).A) (hκ : κ ≫ gA₁ S B u j i = (e S r B u hover i j).hom ≫ gA₂ S B u i j)
    (hκpb : IsPullback κ (v₁ S B u i j).f (v₁ S B u j i).f (Spec.map (CommRingCat.ofHom (flip S B i j))))
    (hκmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f),
        ((v₁ S B u i j).L.mul t' x y).1 ≫ κ =
          ((v₁ S B u j i).L.mul (t' ≫ Spec.map (CommRingCat.ofHom (flip S B i j)))
            ⟨x.1 ≫ κ, by rw [Category.assoc, hκpb.w, ← Category.assoc, x.2]⟩
            ⟨y.1 ≫ κ, by rw [Category.assoc, hκpb.w, ← Category.assoc, y.2]⟩).1)
    (hκP : ∀ m, ((v₁ S B u i j).P m).1 ≫ κ = Spec.map (CommRingCat.ofHom (flip S B i j)) ≫ ((v₁ S B u j i).P m).1)
    (hκpol : LocIsoOnBase (v₁ S B u i j).f ((Scheme.Modules.pullback κ).obj (v₁ S B u j i).pol) (v₁ S B u i j).pol)
    (κ' : (v₁ S B u j i).A ⟶ (v₁ S B u i j).A)
    (hκ'pb : IsPullback κ' (v₁ S B u j i).f (v₁ S B u i j).f (Spec.map (CommRingCat.ofHom (flip S B j i))))
    (hκ'mul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B j i))) (x y : SchemeHomOver t' (v₁ S B u j i).f),
        ((v₁ S B u j i).L.mul t' x y).1 ≫ κ' =
          ((v₁ S B u i j).L.mul (t' ≫ Spec.map (CommRingCat.ofHom (flip S B j i)))
            ⟨x.1 ≫ κ', by rw [Category.assoc, hκ'pb.w, ← Category.assoc, x.2]⟩
            ⟨y.1 ≫ κ', by rw [Category.assoc, hκ'pb.w, ← Category.assoc, y.2]⟩).1)
    (hκ'P : ∀ m, ((v₁ S B u j i).P m).1 ≫ κ' = Spec.map (CommRingCat.ofHom (flip S B j i)) ≫ ((v₁ S B u i j).P m).1)
    (hκ'pol : LocIsoOnBase (v₁ S B u j i).f ((Scheme.Modules.pullback κ').obj (v₁ S B u i j).pol) (v₁ S B u j i).pol) :
    κ ≫ κ' ≫ gA₁ S B u i j = gA₁ S B u i j := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u i j).choose_spec

  have a₁ := compg_isPullback (gA₁ S B u i j) hpb₁ κ' hκ'pb
  have a₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B j i))) (x y : SchemeHomOver t' (v₁ S B u j i).f), _ :=
    fun t' x y => compg_mul (gA₁ S B u i j) hpb₁ hmul₁ κ' hκ'pb hκ'mul t' x y
  have a₃ := compg_P (gA := gA₁ S B u i j) (hP := hP₁) (c := κ') (hcP := hκ'P)
  have a₄ : LocIsoOnBase (v₁ S B u j i).f ((Scheme.Modules.pullback (κ' ≫ gA₁ S B u i j)).obj (u i).pol) (v₁ S B u j i).pol :=
    pol_local_comp (gA₁ S B u i j) κ' hκ'pb.w (locIsoOnBase_of_iso _ hpol₁.some) hκ'pol

  have b₁ := compg_isPullback (κ' ≫ gA₁ S B u i j) a₁ κ hκpb
  have b₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f), _ :=
    fun t' x y => compg_mul (κ' ≫ gA₁ S B u i j) a₁ a₂ κ hκpb hκmul t' x y
  have b₃ := compg_P (gA := κ' ≫ gA₁ S B u i j) (hP := a₃) (c := κ) (hcP := hκP)
  have b₄ : LocIsoOnBase (v₁ S B u i j).f ((Scheme.Modules.pullback (κ ≫ κ' ≫ gA₁ S B u i j)).obj (u i).pol) (v₁ S B u i j).pol :=
    pol_local_comp (κ' ≫ gA₁ S B u i j) κ hκpb.w a₄ hκpol
  have hρ : (ρ₁ S B i j).toRingHom = ((flip S B i j).comp ((flip S B j i).comp (ρ₁ S B i j).toRingHom)) :=
    RingHom.ext fun _ => rfl
  obtain ⟨c₁, c₂, c₃⟩ := clauses_congr (κ ≫ κ' ≫ gA₁ S B u i j) hρ b₁ b₂ b₃
  have hnC : IsUnit ((n : ℕ) : C S B i j) := by simpa using hn'.map (algebraMap S (C S B i j))
  symm
  exact AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hn
    (ρ₁ S B i j).toRingHom hnC (u i) (v₁ S B u i j) (gA₁ S B u i j) (κ ≫ κ' ≫ gA₁ S B u i j)
    hpb₁ hmul₁ hP₁ (fun s => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso hpol₁.some⟩⟩) c₁ c₂ c₃ b₄

