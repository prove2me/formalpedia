theorem hitpack_chunks_len : HITPACK.length = 242 := rfl

def hitOf (s : ℕ) : ℕ × ℕ × ℕ :=
  (Nat.land s 0x1FFFF,
   Nat.land (Nat.shiftRight s 17) 0xFFFF,
   Nat.land (Nat.shiftRight s 33) 0xFFFF)

def hitsDec (cnt : ℕ) : ℕ → List (ℕ × ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => hitOf s :: ih (Nat.shiftRight s 49)) cnt

def hitChunkDec (X : ℕ) : List (ℕ × ℕ × ℕ) :=
  hitsDec (Nat.land X 65535) (Nat.shiftRight X 16)

/-- Sparse single-wire preloads, decoded from HITPACK. Do not `rfl` the length. -/
def preloadHits : List (ℕ × ℕ × ℕ) := HITPACK.flatMap hitChunkDec

/-- Insert single-wire preloads `(idx, code, w)` before `base[idx]` (idx in segsH). -/
def splice (base : List LInstr) (hits : List (ℕ × ℕ × ℕ)) : List LInstr :=
  let rec go (i : ℕ) (rest : List LInstr) (hs : List (ℕ × ℕ × ℕ)) : List LInstr :=
    match rest, hs with
    | [], _ => hs.map fun h => (h.2.1, [h.2.2], [])
    | x :: xs, [] => x :: xs
    | x :: xs, h :: ht =>
      if h.1 = i then
        (h.2.1, [h.2.2], []) :: go i (x :: xs) ht
      else
        x :: go (i+1) xs (h :: ht)
  go 0 base hits

@[irreducible] def segsR : List LInstr := splice segsH preloadHits

/-- Variant R stage-one word. -/
@[irreducible] def W1F : List LInstr := preF ++ copyoND ++ segsR ++ suffix

