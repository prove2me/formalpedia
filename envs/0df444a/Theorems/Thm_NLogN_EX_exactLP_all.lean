theorem NLogN.EX.exactLP_all (fw : LProg2 M Ctx PreW (fermatW q) CW) (hfw : FwOK fw) {m Φm : ℕ}
    (hM : MulBnd M m Φm) {kb mm Φ Bacc Qa Bq Bx CS CB Q : ℕ} {BS BB : ℕ → ℕ}
