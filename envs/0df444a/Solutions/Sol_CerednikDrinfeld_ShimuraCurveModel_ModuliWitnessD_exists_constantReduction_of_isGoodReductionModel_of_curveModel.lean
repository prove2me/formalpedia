  have he_fst : e ≫ pullback.fst _ _ = e𝔐 ≫ pullback.fst w.πX w.sbar := by
    rw [Category.assoc, hec_fst]
  have he : e ≫ pullback.snd w.πX (Spec.map (CommRingCat.ofHom (𝔅.subtype.comp i))) = 𝔐.toBase := by
    rw [Category.assoc, hec_snd, he𝔐base]
  haveI : IsIso e := IsIso.comp_isIso
  have hkey : ∀ P : Place (AlgebraicClosure ℚ) M.Fbar,
