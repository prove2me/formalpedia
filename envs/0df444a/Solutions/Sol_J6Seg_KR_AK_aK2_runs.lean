    simp only [F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hYC.symm]
    by_cases h2 : j = Y
    · subst h2; simp [hYC, List.replicate_succ]
    · simp [h1, h2]
  have H := Sp.rep (C := C) (n := .reg R) (b := .push Y (.lit 0)) (s := s) (F := F) (N := N) (B := B)
    (c := 30000 * (B + 2)) hC5 hFC (by simp [RS.writes, hYC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
