-- title:
--   (1), pp. 1–2; p. 4 — linear multistage program, r and r′, F, X(ξ), v(ξ), (A1)–(A2), level sets, D_t of (9)
-- statement:
--   This file sets up the linear multistage stochastic program (1) of Heitsch, Römisch and Strugarek and the objects in which their stability theorem is stated.
--
--   **Data.** There are $T$ stages, indexed $t = 1,\dots,T$. The input at stage $t$ is a random vector $\xi_t \in \mathbb R^d$ on a probability space $(\Omega,\mathcal F,\mathbb P)$, and the decision at stage $t$ is $x_t \in \mathbb R^{m_t}$. The deterministic data are:
--
--   1. the polyhedral first-stage set $X_1 = \{x \in \mathbb R^{m_1} : \langle g_i, x\rangle \le \gamma_i,\ i = 1,\dots,k_1\}$;
--   2. for $t \ge 2$ the polyhedral cones $X_t = \{x \in \mathbb R^{m_t} : \langle c_{t,i}, x\rangle \le 0,\ i = 1,\dots,k_t\}$;
--   3. fixed linear maps $A_{t,0} : \mathbb R^{m_t} \to \mathbb R^{n_t}$ and $A_{t,1} : \mathbb R^{m_{t-1}} \to \mathbb R^{n_t}$;
--   4. costs $b_t(y) = b_t^0 + B_t y$ and right-hand sides $h_t(y) = h_t^0 + H_t y$, both affine in the current input $y = \xi_t$.
--
--   **Randomness pattern.** The table on p. 4 fixes two exponents. If only the costs are random ($H_t = 0$ for all $t$), then $r = 1$, $r' = \infty$; if only the right-hand sides are random ($B_t = 0$ for all $t$), then $r = r' = 1$; otherwise $r = r' = 2$.
--
--   **Filtration and inputs.** $\mathcal F_t = \sigma(\xi_1,\dots,\xi_t)$ is the σ-field generated by $\xi^t = (\xi_1,\dots,\xi_t)$. An input $\xi$ is admissible if each $\xi_t$ is measurable and in $L_r(\Omega;\mathbb R^d)$, and $\xi_1$ is deterministic ($\mathcal F_1 = \{\emptyset,\Omega\}$). The distance of two inputs is
--   $$\|\xi - \tilde\xi\|_r = \Big\| \Big(\textstyle\sum_{t=1}^T \|\xi_t - \tilde\xi_t\|^2\Big)^{1/2} \Big\|_{L_r(\mathbb P)} .$$
--
--   **Program (1).** The feasible set $\mathcal X(\xi)$ consists of the policies $x = (x_t)$ such that $x_1$ is a deterministic point of $X_1$; for $t = 2,\dots,T$, $x_t$ is $\mathcal F_t$-measurable and almost surely
--   $$x_t \in X_t,\qquad A_{t,0}x_t + A_{t,1}x_{t-1} = h_t(\xi_t);$$
--   and every $x_t$ lies in $L_{r'}(\Omega;\mathbb R^{m_t})$. The objective is $F(\xi,x) = \mathbb E\big[\sum_{t=1}^T \langle b_t(\xi_t), x_t\rangle\big]$ and the optimal value is $v(\xi) = \inf\{F(\xi,x) : x \in \mathcal X(\xi)\}$, an extended real ($+\infty$ if $\mathcal X(\xi)$ is empty).
--
--   **Level sets and the filtration distance.** For $c \in \mathbb R$, $\{x \in \mathcal X(\xi) : F(\xi,x) \le c\}$ is the level set at threshold $c$. For $\alpha > 0$ the filtration distance of (9) is
--   $$D_t(\mathcal F_t,\tilde{\mathcal F}_t) = \max\Big\{ \sup_{x} \|x_t - \mathbb E[x_t \mid \tilde{\mathcal F}_t]\|_{r'},\ \sup_{\tilde x} \|\tilde x_t - \mathbb E[\tilde x_t \mid \mathcal F_t]\|_{r'} \Big\},$$
--   the first supremum over the level set of $F(\xi,\cdot)$ and the second over the level set of $F(\tilde\xi,\cdot)$, both at threshold $v(\xi) + \alpha$, as (A2) defines $l_\alpha$.
--
--   **Conditions.** (A1), complete fixed recourse: $A_{t,0}X_t = \mathbb R^{n_t}$ for $t = 2,\dots,T$. (A2): $v(\xi)$ is finite, and for some $\alpha > 0$ there are $\delta > 0$ and $R \ge 0$ such that for every admissible $\tilde\xi$ with $\|\tilde\xi - \xi\|_r \le \delta$ the level set $\{\tilde x \in \mathcal X(\tilde\xi) : F(\tilde\xi,\tilde x) \le v(\xi) + \alpha\}$ is nonempty and every element has $\|\tilde x_t\|_{r'} \le R$ for all $t$.
--
--   These definitions are the common vocabulary of the stability theorem (Theorem 2.1) and of every step of its proof.
--
--   **Formalization Note** Polyhedral sets and cones are given by finitely many linear inequalities, so "polyhedral" is built in. The optimal value lives in `EReal`; norms, suprema and the input distance live in `ℝ≥0∞`, so no junk values occur. The Euclidean norm on $\mathbb R^{Td}$ and the componentwise reading of "bounded in $L_{r'}$" are fixed choices; the paper leaves the norm on $\mathbb R^{Td}$ unspecified, and boundedness of all components is equivalent to boundedness in the paper's norm $\|x\|_{r'}$. The pattern "otherwise" ($r = r' = 2$) places no restriction on the data. Stages are natural numbers $1,\dots,T$; data at other indices are unused.
-- source:
--   Heitsch, Römisch & Strugarek, Stability of multistage stochastic programs, author manuscript (edoc.hu-berlin.de, c. 2005), pp. 1–2, (1); p. 4, (r, r′) table, F, X(ξ), v(ξ), (A1)–(A3); p. 5, (9)

import Mathlib

namespace MultistageStab.Value

open MeasureTheory ProbabilityTheory
open scoped ENNReal

/-- `E k` is the Euclidean space `ℝ^k`. -/
abbrev E (k : ℕ) : Type := EuclideanSpace ℝ (Fin k)

/-- The deterministic data of the linear multistage program (1), pp. 1–2.
Every field is indexed by the paper's 1-based stage `t : ℕ`; only `t ∈ {1, …, T}` is used.
* `X_1 = {x ∈ ℝ^{m_1} | ⟪G₁ i, x⟫ ≤ g₁ i ∀ i}` (polyhedral);
* `X_t = {x ∈ ℝ^{m_t} | ⟪C t i, x⟫ ≤ 0 ∀ i}` for `t ≥ 2` (polyhedral cones);
* `A₀ t : ℝ^{m_t} → ℝ^{n_t}` and `A₁ t : ℝ^{m_{t-1}} → ℝ^{n_t}` (fixed matrices);
* `b_t(y) = b₀ t + B t y` and `h_t(y) = h₀ t + H t y` (affine in `ξ_t ∈ ℝ^d`). -/
structure Data where
  T : ℕ
  d : ℕ
  m : ℕ → ℕ
  n : ℕ → ℕ
  k₁ : ℕ
  G₁ : Fin k₁ → E (m 1)
  g₁ : Fin k₁ → ℝ
  k : ℕ → ℕ
  C : (t : ℕ) → Fin (k t) → E (m t)
  A₀ : (t : ℕ) → E (m t) →L[ℝ] E (n t)
  A₁ : (t : ℕ) → E (m (t - 1)) →L[ℝ] E (n t)
  b₀ : (t : ℕ) → E (m t)
  B : (t : ℕ) → E d →L[ℝ] E (m t)
  h₀ : (t : ℕ) → E (n t)
  H : (t : ℕ) → E d →L[ℝ] E (n t)

/-- The polyhedral first-stage set `X_1`. -/
def X1 (D : Data) : Set (E (D.m 1)) := {x | ∀ i, inner ℝ (D.G₁ i) x ≤ D.g₁ i}

/-- The polyhedral cone `X_t` (`t ≥ 2`). -/
def Xc (D : Data) (t : ℕ) : Set (E (D.m t)) := {x | ∀ i, inner ℝ (D.C t i) x ≤ 0}

/-- The cost vector `b_t(y) = b⁰_t + B_t y`. -/
def b (D : Data) (t : ℕ) (y : E D.d) : E (D.m t) := D.b₀ t + D.B t y

/-- The right-hand side `h_t(y) = h⁰_t + H_t y`. -/
def h (D : Data) (t : ℕ) (y : E D.d) : E (D.n t) := D.h₀ t + D.H t y

/-- The three rows of the `(r, r′)` table on p. 4. -/
inductive Pattern
  | costs
  | rhs
  | both
  deriving DecidableEq

/-- The integrability exponent `r` of the input: `1, 1, 2`. -/
def r : Pattern → ℝ≥0∞
  | .costs => 1
  | .rhs => 1
  | .both => 2

/-- The integrability exponent `r′` of the decisions: `∞, 1, 2`. -/
def r' : Pattern → ℝ≥0∞
  | .costs => ⊤
  | .rhs => 1
  | .both => 2

/-- Which pattern of randomness the data has: `costs` means the right-hand sides do not depend on
`ξ` (only costs random), `rhs` means the costs do not depend on `ξ` (only right-hand sides random),
`both` places no restriction. -/
def Pattern.Holds : Pattern → Data → Prop
  | .costs, D => ∀ t, D.H t = 0
  | .rhs, D => ∀ t, D.B t = 0
  | .both, _ => True

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The σ-field `F_t = σ(ξ_1, …, ξ_t)` generated by `ξ^t`. -/
def sigmaGen {d : ℕ} (ξ : ℕ → Ω → E d) (t : ℕ) : MeasurableSpace Ω :=
  ⨆ τ ∈ Finset.Icc 1 t, MeasurableSpace.comap (ξ τ) inferInstance

/-- Admissible inputs of (1): measurable stages, `ξ ∈ L_r(Ω; ℝ^{Td})`, and `ξ_1` deterministic
(`F_1 = {∅, Ω}`). -/
def Admissible (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d) : Prop :=
  (∀ t ∈ Finset.Icc 1 D.T, Measurable (ξ t)) ∧
  (∀ t ∈ Finset.Icc 1 D.T, MemLp (ξ t) (r pat) P) ∧
  (∃ c, ∀ ω, ξ 1 ω = c)

/-- `‖ξ − ξ'‖_r`, the `L_r` norm of the `ℝ^{Td}`-valued difference with the Euclidean norm. -/
noncomputable def inputDist (P : Measure Ω) (D : Data) (pat : Pattern)
    (ξ ξ' : ℕ → Ω → E D.d) : ℝ≥0∞ :=
  eLpNorm (fun ω => Real.sqrt (∑ t ∈ Finset.Icc 1 D.T, ‖ξ t ω - ξ' t ω‖ ^ 2)) (r pat) P

/-- Decision policies `x = (x_t)_t`, `x_t : Ω → ℝ^{m_t}`. -/
abbrev Policy (D : Data) (Ω : Type*) := (t : ℕ) → Ω → E (D.m t)

/-- The feasible set `X(ξ)` of (1). -/
def feasible (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d) :
    Set (Policy D Ω) :=
  {x | (∃ c ∈ X1 D, ∀ ω, x 1 ω = c) ∧
    (∀ t ∈ Finset.Icc 2 D.T, StronglyMeasurable[sigmaGen ξ t] (x t) ∧
      ∀ᵐ ω ∂P, x t ω ∈ Xc D t ∧
        D.A₀ t (x t ω) + D.A₁ t (x (t - 1) ω) = h D t (ξ t ω)) ∧
    (∀ t ∈ Finset.Icc 1 D.T, MemLp (x t) (r' pat) P)}

/-- The objective `F(ξ, x) = E[∑_{t=1}^T ⟨b_t(ξ_t), x_t⟩]`. -/
noncomputable def objective (P : Measure Ω) (D : Data) (ξ : ℕ → Ω → E D.d) (x : Policy D Ω) : ℝ :=
  ∫ ω, ∑ t ∈ Finset.Icc 1 D.T, inner ℝ (b D t (ξ t ω)) (x t ω) ∂P

/-- The optimal value `v(ξ)` of (1), in `EReal` (`⊤` if infeasible). -/
noncomputable def value (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d) : EReal :=
  ⨅ x ∈ feasible P D pat ξ, ((objective P D ξ x : ℝ) : EReal)

/-- The level set `{x ∈ X(ξ) : F(ξ, x) ≤ c}`. -/
def levelSet (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d) (c : ℝ) :
    Set (Policy D Ω) :=
  {x | x ∈ feasible P D pat ξ ∧ objective P D ξ x ≤ c}

/-- The filtration distance `D_t(F_t, F̃_t)` of (9); both level sets use the threshold
`v(ξ) + α` of (A2). -/
noncomputable def filtDist (P : Measure Ω) (D : Data) (pat : Pattern) (ξ ξ' : ℕ → Ω → E D.d)
    (α : ℝ) (t : ℕ) : ℝ≥0∞ :=
  max (⨆ x ∈ levelSet P D pat ξ ((value P D pat ξ).toReal + α),
        eLpNorm (x t - P[x t | sigmaGen ξ' t]) (r' pat) P)
      (⨆ x ∈ levelSet P D pat ξ' ((value P D pat ξ).toReal + α),
        eLpNorm (x t - P[x t | sigmaGen ξ t]) (r' pat) P)

/-- (A1) complete fixed recourse: `A_{t,0} X_t = ℝ^{n_t}` for `t = 2, …, T`. -/
def CompleteRecourse (D : Data) : Prop :=
  ∀ t ∈ Finset.Icc 2 D.T, ∀ u : E (D.n t), ∃ x ∈ Xc D t, D.A₀ t x = u

/-- The level-boundedness part of (A2) with explicit `α`, `δ` and bound `R`. -/
def LevelBoundedWith (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d)
    (α δ : ℝ) (R : NNReal) : Prop :=
  ∀ ξ' : ℕ → Ω → E D.d, Admissible P D pat ξ' → inputDist P D pat ξ ξ' ≤ ENNReal.ofReal δ →
    (levelSet P D pat ξ' ((value P D pat ξ).toReal + α)).Nonempty ∧
    ∀ x ∈ levelSet P D pat ξ' ((value P D pat ξ).toReal + α),
      ∀ t ∈ Finset.Icc 1 D.T, eLpNorm (x t) (r' pat) P ≤ R

/-- (A2): `v(ξ)` finite and `F` level-bounded locally uniformly at `ξ`. -/
def A2 (P : Measure Ω) (D : Data) (pat : Pattern) (ξ : ℕ → Ω → E D.d) : Prop :=
  value P D pat ξ ≠ ⊥ ∧ value P D pat ξ ≠ ⊤ ∧
    ∃ α > 0, ∃ δ > 0, ∃ R : NNReal, LevelBoundedWith P D pat ξ α δ R

end MultistageStab.Value


