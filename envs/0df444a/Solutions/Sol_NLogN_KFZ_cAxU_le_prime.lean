theorem cCnt_le (x : ℕ) : cCnt x ≤ 135 * (x + 2) := by
  have := zsz_natCast_le_self' x; unfold cCnt; simp only [dupCost, zipCost, moveCost]; omega

theorem cAxU_le (Δ s t φ : ℕ) : cAxU Δ s t φ ≤ cAx Δ s t φ + 10 ^ 4 * (Δ + t + 3) := by
  have h1 := cCnt_le (Δ + 2 * t + (2 * t - s)); have h2 := cCnt_le (Δ + t + (t - s))
  have h3 := cCnt_le t
  have hd : dupCost (Δ + 1) + 17 ≤ 135 * (Δ + 3) := by simp only [dupCost, zipCost, moveCost]; omega
  unfold cAxU cAx cTwU; omega

end IL

end NLogN.KFM

