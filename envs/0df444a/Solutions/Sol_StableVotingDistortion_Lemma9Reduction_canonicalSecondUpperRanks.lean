private def slopeLayer27 (x : Bounds) : Bounds := if x=⟨(391/400),1⟩ then ⟨(-11857041976524459/1893376000000000),(-7489302845367526917/1302642688000000000)⟩ else slopeLayer26 x
private theorem slopeLayer27_eq : slopeLayer27=totalScoreSlope := by
  funext x
  by_cases h : x=⟨(391/400),1⟩
  · rw [slopeLayer27,if_pos h,h]; exact cachedSlope_27
  · rw [slopeLayer27,if_neg h]; first | exact congrFun slopeLayer26_eq x | rfl
private def slopeLayer28 (x : Bounds) : Bounds := if x=⟨(791/800),(1591/1600)⟩ then ⟨(-31962237484914010293/5210570752000000000),(-15646947725216354709/2605285376000000000)⟩ else slopeLayer27 x
private theorem slopeLayer28_eq : slopeLayer28=totalScoreSlope := by
  funext x
  by_cases h : x=⟨(791/800),(1591/1600)⟩
  · rw [slopeLayer28,if_pos h,h]; exact cachedSlope_28
  · rw [slopeLayer28,if_neg h]; first | exact congrFun slopeLayer27_eq x | rfl
private def slopeLayer29 (x : Bounds) : Bounds := if x=⟨(791/800),1⟩ then ⟨(-11857041976524459/1893376000000000),(-15646947725216354709/2605285376000000000)⟩ else slopeLayer28 x
private theorem slopeLayer29_eq : slopeLayer29=totalScoreSlope := by
  funext x
  by_cases h : x=⟨(791/800),1⟩
  · rw [slopeLayer29,if_pos h,h]; exact cachedSlope_29
  · rw [slopeLayer29,if_neg h]; first | exact congrFun slopeLayer28_eq x | rfl
private def canonicalSlopeCache (x : Bounds) : Bounds := if x=⟨(1591/1600),1⟩ then ⟨(-11857041976524459/1893376000000000),(-31962237484914010293/5210570752000000000)⟩ else slopeLayer29 x
private theorem canonicalSlopeCache_eq : canonicalSlopeCache=totalScoreSlope := by
  funext x
  by_cases h : x=⟨(1591/1600),1⟩
  · rw [canonicalSlopeCache,if_pos h,h]; exact cachedSlope_30
  · rw [canonicalSlopeCache,if_neg h]; first | exact congrFun slopeLayer29_eq x | rfl
def canonicalCachedZ (p q z : Bounds) :=
  ((quickTotalPrimitiveBox p).times ((point 1).plus (canonicalSlopeCache z))).plus
    (((point massE).times p).times ((quickTotalPrimitiveSlope (secondX p q z)).minus (quickTotalPrimitiveSlope z)))
def canonicalCachedTest (r : Box 3) : Bool :=
  let b := r 0
  let c := r 1
  let d := r 2
  let s := quickSecondP b c d
  let t := quickSecondQ b c d
  let v := canonicalCachedZ b c d
  decide (d.hi<b.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨
    quickSecondResidual (anchor b s) (anchor c t) (anchor d v)+deviation b s+deviation c t+deviation d v ≤ 0)


private theorem canonicalCachedTest_eq : canonicalCachedTest=quickSecondRectTest := by
  funext r
  unfold canonicalCachedTest quickSecondRectTest canonicalCachedZ quickSecondZ
  rw [canonicalSlopeCache_eq]
end StableVotingDistortion.PaperCurve

