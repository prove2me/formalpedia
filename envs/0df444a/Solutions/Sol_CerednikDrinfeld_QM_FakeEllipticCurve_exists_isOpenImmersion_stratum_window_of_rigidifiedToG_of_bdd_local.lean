  (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)

abbrev zΛ (m : ℕ) : ↥Λ := ⟨(((m : ℕ) : ℤ) : ℚ), hΛℤ _⟩

theorem intCast_mul_mem (m : ℤ) (x : ↥Λ) : ((m : ℚ) : ℍ[ℚ, a, b]) * (x : ℍ[ℚ, a, b]) ∈ Λ := by
  rw [QuaternionAlgebra.coe_mul_eq_smul, Int.cast_smul_eq_zsmul]; exact Λ.smul_mem m x.2

theorem mul_intCast_mem (m : ℤ) (x : ↥Λ) : (x : ℍ[ℚ, a, b]) * ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
  rw [← QuaternionAlgebra.coe_commutes]; exact intCast_mul_mem m x

theorem act_comm_act_zΛ (E : FakeEllipticCurve Λ N S) (m : ℕ) (x : ↥Λ) :
    E.act x ≫ E.act (zΛ hΛℤ m) = E.act (zΛ hΛℤ m) ≫ E.act x := by
  have h2 := E.act_mul (zΛ hΛℤ m) x (intCast_mul_mem (m : ℤ) x)
  have h1 := E.act_mul x (zΛ hΛℤ m) (mul_intCast_mem (m : ℤ) x)
  have he : (⟨((zΛ hΛℤ m : ↥Λ) : ℍ[ℚ, a, b]) * (x : ℍ[ℚ, a, b]), intCast_mul_mem (m : ℤ) x⟩ : ↥Λ) =
      ⟨(x : ℍ[ℚ, a, b]) * ((zΛ hΛℤ m : ↥Λ) : ℍ[ℚ, a, b]), mul_intCast_mem (m : ℤ) x⟩ :=
    Subtype.ext (QuaternionAlgebra.coe_commutes _ _)
  rw [← h2, he, h1]

theorem isIsogenyPair_act_zΛ (E : FakeEllipticCurve Λ N S) (m₁ m₂ : ℕ) :
    FakeEllipticCurve.IsIsogenyPair (m₁ * m₂) E E (E.act (zΛ hΛℤ m₁)) (E.act (zΛ hΛℤ m₂)) := by
  refine ⟨E.act_over _, E.act_over _, fun t P Q => E.act_hom _ t P Q, fun t P Q => E.act_hom _ t P Q,
    fun x => act_comm_act_zΛ hΛℤ E m₁ x, fun x => act_comm_act_zΛ hΛℤ E m₂ x, fun hd => ?_⟩
  have k12 : (⟨_, mul_intCast_mem (m₁ : ℤ) (zΛ hΛℤ m₂)⟩ : ↥Λ) = ⟨(((m₁ * m₂ : ℕ) : ℚ) : ℍ[ℚ, a, b]), hd⟩ :=
    Subtype.ext (by
      show (((((m₂ : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b])) * ((((m₁ : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) = (((m₁ * m₂ : ℕ) : ℚ) : ℍ[ℚ, a, b])
      rw [← QuaternionAlgebra.coe_mul]; congr 1; push_cast; ring)
  have k21 : (⟨_, mul_intCast_mem (m₂ : ℤ) (zΛ hΛℤ m₁)⟩ : ↥Λ) = ⟨(((m₁ * m₂ : ℕ) : ℚ) : ℍ[ℚ, a, b]), hd⟩ :=
    Subtype.ext (by
      show (((((m₁ : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b])) * ((((m₂ : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) = (((m₁ * m₂ : ℕ) : ℚ) : ℍ[ℚ, a, b])
      rw [← QuaternionAlgebra.coe_mul]; congr 1; push_cast; ring)
  constructor
  · rw [← E.act_mul (zΛ hΛℤ m₂) (zΛ hΛℤ m₁) (mul_intCast_mem (m₁ : ℤ) (zΛ hΛℤ m₂)), k12]
  · rw [← E.act_mul (zΛ hΛℤ m₁) (zΛ hΛℤ m₂) (mul_intCast_mem (m₂ : ℤ) (zΛ hΛℤ m₁)), k21]

theorem act_zΛ_one (E : FakeEllipticCurve Λ N S) : E.act (zΛ hΛℤ 1) = 𝟙 E.A := by
  have hmem : (1 : ℍ[ℚ, a, b]) ∈ Λ := by have := hΛℤ 1; push_cast at this; exact this
  have : zΛ hΛℤ 1 = ⟨1, hmem⟩ := Subtype.ext (by push_cast; rfl)
  rw [this, E.act_one hmem]

variable {r : ℕ} {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
