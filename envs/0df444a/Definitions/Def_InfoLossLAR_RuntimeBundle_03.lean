def markedStep (state : _root_.Integration9_9.LARPlatformEncoding.MarkedState) (bit : Bool) : _root_.Integration9_9.LARPlatformEncoding.MarkedState :=
  if state.1.1 then ((true,state.1.2),(state.2.1,bit::state.2.2))
  else if state.1.2 then ((false,false),(bit::state.2.1,state.2.2))
  else if bit then ((false,true),state.2)
  else ((true,false),state.2)







/-- The parser consumes all supplied input once; it does not expand any decoded integer. -/
def readMarked (xs : Str) : Str × Str :=
  let state := xs.foldl _root_.Integration9_9.LARPlatformEncoding.markedStep ((false,false),([],[]))
  (state.2.2.reverse,state.2.1.reverse)



