    nlinarith

theorem dupR_runs (X : Fin HS) (hX : X ≠ pR) (Δ : ℕ) (st : IState HS) (LR : List Item)
    (hR : st.G pR = .int (2 ^ Δ) :: LR) :
    IRuns I iprog (.seq (.op (.const X 0)) (.op (.dup pR X))) st
      ((st.upd X (.int 0 :: st.G X)).upd X (.int (2 ^ Δ) :: (st.upd X (.int 0 :: st.G X)).G X))
      (2 + (dupCost (Δ + 1) + 17)) := by
  have k1 := IRuns.const (I := I) (iprog := iprog) (s := st) X 0
  have k2 := IRuns.dup (I := I) (iprog := iprog) (s := st.upd X (.int 0 :: st.G X)) (i := pR) (j := X)
    (a := 2 ^ Δ) (L := LR) hX.symm (by simp [IState.upd_G, hX.symm, hR])
  refine (k1.seq k2).mono' rfl ?_
  have := dupCost_mono' (zsz_two_pow Δ)
  simp only [zsz_zero]; omega

end IL

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT KIL
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {Δ φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ Δ + 2 → NLogN.zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (k j n : ℕ)
    (hk : 0 < k) (hu : (4 * (n : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1)
    (st : NLogN.IState NLogN.HS) (LR L1 L3 L4 L5 : List NLogN.Item) (hR : st.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR)
    (hD : st.G NLogN.KFM.rDl = .int (Δ : ℤ) :: L1) (hJ1 : st.G NLogN.KFM.rJ1 = .int (k : ℤ) :: L3)
    (hX : st.G NLogN.KFM.nX = .int (n : ℤ) :: L4) (hJ2 : st.G NLogN.KFM.rJ2 = .int (j : ℤ) :: L5) :
    NLogN.IRuns I iprog (NLogN.KFM.twGU pM) st (st.upd NLogN.KFM.pW (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.twTab Δ k j n)) ++ st.G NLogN.KFM.pW))
      (NLogN.KFM.cTwGU Δ k j n φ) := by
  have k12 := NLogN.KFM.dupR_runs (I := I) (iprog := iprog) 0 (by decide) Δ st LR hR
  set s2 := (st.upd 0 (.int 0 :: st.G 0)).upd 0 (.int (2 ^ Δ) :: (st.upd 0 (.int 0 :: st.G 0)).G 0)
    with hs2
  have t1 := NLogN.KFM.twCU_runs (I := I) (iprog := iprog) NLogN.KFM.rDl NLogN.KFM.rJ1 NLogN.KFM.rJ2 NLogN.KFM.pH Δ k j hk
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) s2 L1 L3 L5 (by simp +decide [hs2, hD])
    (by simp +decide [hs2, hJ1]) (by simp +decide [hs2, hJ2])
  rw [show s2.G NLogN.KFM.pH = st.G NLogN.KFM.pH by simp +decide [hs2]] at t1
  set s3 := s2.upd NLogN.KFM.pH (.int (IntMul.HvdH.twiddle Δ k j).1 :: .int (IntMul.HvdH.twiddle Δ k j).2 :: st.G NLogN.KFM.pH)
    with hs3
  have k34 := NLogN.KFM.dupR_runs (I := I) (iprog := iprog) NLogN.KFM.pK (by decide) Δ s3 LR
    (by simp +decide [hs3, hs2, hR])
  set s4 := (s3.upd NLogN.KFM.pK (.int 0 :: s3.G NLogN.KFM.pK)).upd NLogN.KFM.pK (.int (2 ^ Δ) :: (s3.upd NLogN.KFM.pK (.int 0 :: s3.G NLogN.KFM.pK)).G NLogN.KFM.pK)
    with hs4
  have hW : ‖Complex.exp (2 * Real.pi * Complex.I * j / k)‖ ≤ 1 :=
    NLogN.KFM.norm_exp_phase (2 * Real.pi * j / k) _ (by push_cast; ring)
  have hB := NLogN.KFM.cst_bnd Δ n (NLogN.KFM.oneP Δ) (IntMul.HvdH.twiddle Δ k j) 1 _ (by simp) hW (by simp [NLogN.KFM.vP_oneP])
    (NLogN.KFM.vP_twiddle Δ k j hk) hu
  have hcb : NLogN.KFM.GBnd (Δ + 2) (NLogN.KFM.oneP Δ) := by
    have := NLogN.KFM.zsz_two_pow Δ; exact ⟨by simp only [NLogN.KFM.oneP]; omega, by simp [NLogN.KFM.oneP, NLogN.zsz_zero]⟩
  have g := NLogN.KFM.chirpGU_runs (I := I) (iprog := iprog) hM hdom hΦ Δ n s4 (IntMul.HvdH.twiddle Δ k j) (NLogN.KFM.oneP Δ)
    (NLogN.KFM.oneP Δ) (st.G 0) (st.G NLogN.KFM.pH) (st.G NLogN.KFM.pK) LR L4 (by simp +decide [hs4, hs3, hs2, NLogN.KFM.oneP])
    (by simp +decide [hs4, hs3]) (by simp +decide [hs4, hs3, hs2, NLogN.KFM.oneP])
    (by simp +decide [hs4, hs3, hs2, hR]) (by simp +decide [hs4, hs3, hs2, hX]) hB hcb
  rw [show s4.G NLogN.KFM.pW = st.G NLogN.KFM.pW by simp +decide [hs4, hs3, hs2]] at g
  refine (k12.seq (t1.seq (k34.seq g))).mono' ?_ ?_
  · rw [NLogN.KFM.twTab, NLogN.KFM.geoL_eq_chirpL]
    simp only [hs4, hs3, hs2]
    clear k12 t1 k34 g
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · unfold NLogN.KFM.cTwGU; omega
end
