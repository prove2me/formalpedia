     (on_goal -1 => ((rintro _ _ ⟨rfl, rfl⟩); (try with_unfolding_none refine Light.Ends.skip ?_))))
  have hval : flag (scanHit x.n x.AB x.BC x.AC a b 0 x.n = true) =
      Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC (a * x.n + b)) := by
    have hdiv : (a * x.n + b) / x.n = a := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hb, Nat.zero_add]
    have hmod : (a * x.n + b) % x.n = b := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hb]
    rw [flag_eq_bit, aeHit, hdiv, hmod]
  rw [hval]
  -- out[a n + b] := res
  refine Ends.storeTo (x.out + (a * x.n + b)) (Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC (a * x.n + b)))
    ⟨Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC (a * x.n + b)), ?_⟩ (by (( (try have := Light.Std.space_le (by assumption))
                                                                         (try have := Light.Std.const_le (by assumption))
                                                                         (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))) (by (first
                                                                                                                                          | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                                                                                                                                  List.sum_cons, List.sum_nil, ])
                                                                                                                                              (first
                                                                                                                                                | omega
                                                                                                                                                | ((ring_nf); (omega))))
                                                                                                                                          | omega
                                                                                                                                          |
                                                                                                                                            (simp [] <;>
                                                                                                                                                first
                                                                                                                                                | omega
                                                                                                                                                | ((ring_nf); (omega)))))
