/-- **All parameter conditions hold for large `n`.** -/
theorem params6_ok_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → Good P n := by
  obtain ⟨B₀, hB₀⟩ := poly_le_two_pow_half (1 + P.x)
  refine ⟨2 ^ (max B₀ 4), fun n hn => good_of P hP ?_ ?_⟩
  · exact (le_max_right _ _).trans (lg_ge _ hn)
  · exact hB₀ _ ((le_max_left _ _).trans (lg_ge _ hn))

