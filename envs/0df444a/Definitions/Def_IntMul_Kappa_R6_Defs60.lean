section
-- Source module: Solutions.J6AMath1
/-!
# A lines (PR #5 block chirp), part 1: the block-chirp `S'` map and its error

The output axis (length `t`) is cut into blocks of `B = 2H` consecutive indices. For an output `k`
the block centre is `k_c = ⌊k/B⌋ B + H`, the offset `κ = k - k_c ∈ [-H, H)`, and the input centre
is `j_c = round(s k_c / t)`. With `A = t j - s k_c` the exponent of the Gaussian weight splits as

`(j - s k/t)² = ((t-s) A² + s (A - t κ)²) / t³ - s (t-s) κ² / t²`   (`expo_split`)

so `e^{-π(j - sk/t)²/α²} = a · g · C` with an input scaling `a` (per block), a correlation kernel
`g` (per block, a function of `j - κ`), and an output scaling `C = e^{π s(t-s)κ²/(t²α²)}` that is the
same for every block (`ew_split`). The machine computes, for every output,

`chirpA U k = (Σ_{|j - j_c| < W} aT_j gT_{j-κ} U_{j mod s}) · cT_κ  tdiv  2^{3P-σ}`

with `aT ≈ 2^P a`, `gT ≈ 2^P g` (`expNeg`) and `cT ≈ 2^{P-σ} C / (2α)` (`expPos`, `betaT`).

**`chirpA_err`**: for every input in the disc and every `k`,
`‖chirpA U k - 2^p S'(U/2^p)_k‖ ≤ 12 W 2^{p+σ} / 2^P + 2`, as soon as the window contains the
`Sapprox` window (`H + m + 3 ≤ W`) and `e^{π s(t-s)H²/(t²α²)} ≤ 2^σ`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open Complex

namespace J6A

open IntMul.HvdH IntMul.HvdH.SPf

/-! ## 1. Block geometry and tables -/

/-- The centre of the block of `k` (blocks of length `2H`). -/
def kcB (H k : ℕ) : ℕ := k / (2 * H) * (2 * H) + H

/-- The offset `κ = k - k_c` of `k` in its block. -/
def kapB (H k : ℕ) : ℤ := (k : ℤ) - kcB H k

/-- The input centre `round(s k_c / t)` of the block of `k`. -/
def jcB (s t H k : ℕ) : ℤ := (((2 * s * kcB H k + t) / (2 * t) : ℕ) : ℤ)

/-- Numerator of the input-scaling exponent: `(t-s) (t j - s k_c)²` (denominator `t³α²`). -/
def aNum (s t H k : ℕ) (j : ℤ) : ℕ := (t - s) * ((t : ℤ) * j - s * kcB H k).natAbs ^ 2

/-- Numerator of the kernel exponent: `s (t (j - κ) - s k_c)²` (denominator `t³α²`). -/
def gNum (s t H k : ℕ) (j : ℤ) : ℕ := s * ((t : ℤ) * (j - kapB H k) - s * kcB H k).natAbs ^ 2

/-- Numerator of the output-scaling exponent: `s (t-s) κ²` (denominator `t²α²`). -/
def cNum (s t H k : ℕ) : ℕ := s * (t - s) * (kapB H k).natAbs ^ 2

/-- `≈ 2^P e^{-π (t-s)(tj - s k_c)²/(t³α²)}`. -/
def aT (P s t α H k : ℕ) (j : ℤ) : ℤ := expNeg P (t ^ 3 * α ^ 2) (aNum s t H k j)

/-- `≈ 2^P e^{-π s(t(j-κ) - s k_c)²/(t³α²)}`. -/
def gT (P s t α H k : ℕ) (j : ℤ) : ℤ := expNeg P (t ^ 3 * α ^ 2) (gNum s t H k j)

/-- `≈ 2^{P-σ} e^{π s(t-s)κ²/(t²α²)} / (2α)`. -/
def cT (P σ s t α H k : ℕ) : ℤ :=
  (expPos P (t ^ 2 * α ^ 2) (cNum s t H k) σ * betaT P α).tdiv (2 ^ P)

/-- One term `aT_j gT_{j-κ} U_{j mod s}` (before the output scaling). -/
def cTerm (P s t α H k : ℕ) (U : ℕ → ℤ × ℤ) (j : ℤ) : ℤ × ℤ :=
  let w := aT P s t α H k j * gT P s t α H k j
  let V := U (j % s).toNat
  (w * V.1, w * V.2)

/-- **The block-chirp `S'` map** (window `|j - j_c| < W`, precision `P`, scaling exponent `σ`). -/
def chirpA (P σ W s t α H : ℕ) (U : ℕ → ℤ × ℤ) (k : ℕ) : ℤ × ℤ :=
  let c := cT P σ s t α H k
  let jc := jcB s t H k
  (J6Seg.fmul (3 * P - σ) c (∑ i ∈ Finset.range (2 * W), (cTerm P s t α H k U (jc - W + i)).1),
    J6Seg.fmul (3 * P - σ) c (∑ i ∈ Finset.range (2 * W), (cTerm P s t α H k U (jc - W + i)).2))

/-! ## 2. Geometry facts -/

/-! ## 3. The exponent split -/

/-! ## 4. One term -/

end J6A

end

