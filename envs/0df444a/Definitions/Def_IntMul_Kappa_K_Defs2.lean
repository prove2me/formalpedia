/-! ## 3. Dyadic depth invariant -/

/-! ## 4. Final truncation toward zero -/

/-- Truncation of a real toward zero to the grid `2^{-p} ℤ`, as an integer numerator. -/
noncomputable def truncNum (p : ℕ) (x : ℝ) : ℤ := if 0 ≤ x then ⌊x * 2 ^ p⌋ else ⌈x * 2 ^ p⌉

/-- `Q_p` on a real component. -/
noncomputable def truncR (p : ℕ) (x : ℝ) : ℝ := truncNum p x / 2 ^ p

/-- `Q_p` on a complex coefficient: truncate both components toward zero. -/
noncomputable def Qp (p : ℕ) (z : ℂ) : ℂ := ⟨truncR p z.re, truncR p z.im⟩

/-! ## 5. Width bookkeeping in the proof of Proposition 14 -/

