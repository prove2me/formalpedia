private theorem apply_eq_one_of_isInducedSphericalAt
    {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ))
    {W : LocalGL3 v → ℂ} (hW : IsInducedSphericalAt c v (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (h1 : W 1 = 1)
    (k : LocalGL3 v) (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) : W k = 1 := by
  have h := hW.1 1 k hk
  rw [one_mul] at h
  rw [h, h1]

private theorem localChar_uniformizerUnit_eq
    {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (c : HeightOneSpectrum (𝓞 K) → ℂ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hunr : TateGlobal.IsUnramifiedCharAt ω v)
    (heul : eulerCoeff ℚ ω v = inducedE3 ℚ c v) :
    ((TateGlobal.localChar ω v (AdelicLevel.uniformizerUnit ℚ v) : ℂˣ) : ℂ) = inducedE3 ℚ c v := by
  rw [← heul, eulerCoeff, if_pos hunr]
  rfl

private theorem apply_glScalar_mul_eq_localChar_mul
    {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (c : HeightOneSpectrum (𝓞 K) → ℂ)
    (v : HeightOneSpectrum (𝓞 ℚ)) {W : LocalGL3 v → ℂ}
    (hW : IsInducedSphericalAt c v (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (hunr : TateGlobal.IsUnramifiedCharAt ω v)
    (heul : eulerCoeff ℚ ω v = inducedE3 ℚ c v) (t : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v) :
    W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = ((TateGlobal.localChar ω v t : ℂˣ) : ℂ) * W g :=
  apply_glScalar_mul_eq v W hW.1 (TateGlobal.localChar ω v) (fun u hu => hunr u hu.1 hu.2)
    (fun h => by rw [hW.2.2.2 h, localChar_uniformizerUnit_eq ω c v hunr heul]) t g

private theorem isUnramifiedCharAt_and_eulerCoeff_eq
    {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K = 3) (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hω : ∀ p : HeightOneSpectrum (𝓞 ℚ), ¬ IsBadPlace K μ p →
      TateGlobal.IsUnramifiedCharAt ω p ∧ eulerCoeff ℚ ω p = inducedE3 ℚ (inducedCoeff K μ) p)
    (v : HeightOneSpectrum (𝓞 ℚ)) {W : LocalGL3 v → ℂ}
    (hW : IsInducedSphericalAt (inducedCoeff K μ) v (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (h1 : W 1 = 1) :
    TateGlobal.IsUnramifiedCharAt ω v ∧ eulerCoeff ℚ ω v = inducedE3 ℚ (inducedCoeff K μ) v :=
  hω v (not_isBadPlace_of_isInducedSphericalAt_of_apply_one_eq_one K hdeg μ v _ W hW h1)

private theorem apply_glScalar_mul_eq_localChar_mul_of_forall
    {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hω : ∀ p : HeightOneSpectrum (𝓞 ℚ), ¬ IsBadPlace K μ p →
      TateGlobal.IsUnramifiedCharAt ω p ∧ eulerCoeff ℚ ω p = inducedE3 ℚ (inducedCoeff K μ) p)
    (v : HeightOneSpectrum (𝓞 ℚ)) {W : LocalGL3 v → ℂ}
    (hW : IsInducedSphericalAt (inducedCoeff K μ) v (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (h1 : W 1 = 1)
    (t : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v) :
    W (Matrix.GeneralLinearGroup.scalar (Fin 3) t * g) = ((TateGlobal.localChar ω v t : ℂˣ) : ℂ) * W g :=
  have h := isUnramifiedCharAt_and_eulerCoeff_eq hdeg μ ω hω v hW h1
  apply_glScalar_mul_eq_localChar_mul ω (inducedCoeff K μ) v hW h.1 h.2 t g

end LanglandsTunnell.CubicInduction.InducedFactorLaws
