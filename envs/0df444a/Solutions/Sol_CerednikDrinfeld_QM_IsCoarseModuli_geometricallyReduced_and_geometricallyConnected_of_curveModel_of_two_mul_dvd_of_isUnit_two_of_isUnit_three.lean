theorem P5GenFibre.coarsePtsBij
    {Rb : Type} [CommRing Rb]
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (X : Scheme.{0}) (πX : X ⟶ Spec (CommRingCat.of Rb))
    (pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of Rb)),
      FakeEllipticCurve Λ N S → SchemeHomOver s πX)
    (pt_iso : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of Rb))
      (E E' : FakeEllipticCurve Λ N S), FakeEllipticCurve.Iso E E' → pt S s E = pt S s E')
    (pt_pullback : ∀ (S S' : Type) [CommRing S] [CommRing S'] (φ : S →+* S')
      (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of Rb))
      (s' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of Rb)),
      Spec.map (CommRingCat.ofHom φ) ≫ s = s' → ∀ (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N S'),
      FakeEllipticCurve.IsPullback φ E E' → (pt S' s' E').1 = Spec.map (CommRingCat.ofHom φ) ≫ (pt S s E).1)
    (pt_surjective : ∀ (k : Type) [Field k] [IsAlgClosed k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of Rb))
      (x : SchemeHomOver s πX), ∃ E : FakeEllipticCurve Λ N k, pt k s E = x)
    (pt_injective : ∀ (k : Type) [Field k] [IsAlgClosed k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of Rb))
      (E E' : FakeEllipticCurve Λ N k), pt k s E = pt k s E' → FakeEllipticCurve.Iso E E')

    (𝒪₀ : Type) [CommRing 𝒪₀] [IsDomain 𝒪₀] [CharZero 𝒪₀]
    (hN₀ : IsUnit ((N : ℕ) : 𝒪₀)) (h2₀ : IsUnit ((2 : ℕ) : 𝒪₀)) (h3₀ : IsUnit ((3 : ℕ) : 𝒪₀)) (m₀ : ℕ) (hm₀ : 3 ≤ m₀) (hm₀u : IsUnit ((m₀ : ℕ) : 𝒪₀))
    (𝒳₀ : Scheme.{0}) (f₀ : 𝒳₀ ⟶ Spec (CommRingCat.of 𝒪₀))
    (pt₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪₀)), FakeEllipticCurve Λ N S → SchemeHomOver s f₀)
    (h𝒳₀ : IsCoarseModuli Λ N 𝒳₀ f₀ pt₀)
    [IsSeparated f₀] [LocallyOfFiniteType f₀]
    (k : Type) [Field k] [IsAlgClosed k] (i : 𝒪₀ →+* k) (hi : Function.Injective i)
    (σ : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of Rb))
    {T : Scheme.{0}} (p : T ⟶ 𝒳₀) (fT : T ⟶ Spec (CommRingCat.of k))
    (hT : IsPullback p fT f₀ (Spec.map (CommRingCat.ofHom i))) :
    ∃ u : T ⟶ Limits.pullback πX σ, u ≫ Limits.pullback.snd πX σ = fT ∧
      ∀ y : Spec (CommRingCat.of k) ⟶ Limits.pullback πX σ, y ≫ Limits.pullback.snd πX σ = 𝟙 _ →
        ∃! x : Spec (CommRingCat.of k) ⟶ T, x ≫ fT = 𝟙 _ ∧ x ≫ u = y := by
  classical

  obtain ⟨ptk, hk⟩ := CerednikDrinfeld.QM.IsCoarseModuli.exists_isCoarseModuli_pullback_of_injective_of_isUnit_of_isUnit_two_of_isUnit_three
    hqq' hB Λ hΛ N 𝒪₀ hN₀ h2₀ h3₀ m₀ hm₀ hm₀u h𝒳₀ inferInstance inferInstance k i hi

  let e : T ≅ Limits.pullback f₀ (Spec.map (CommRingCat.ofHom i)) := hT.isoPullback
  have he : e.hom ≫ Limits.pullback.snd f₀ (Spec.map (CommRingCat.ofHom i)) = fT := hT.isoPullback_hom_snd
  have he' : e.inv ≫ fT = Limits.pullback.snd f₀ (Spec.map (CommRingCat.ofHom i)) := by
    rw [← he, Iso.inv_hom_id_assoc]

  let Y := Limits.pullback πX σ
  let pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k)),
      FakeEllipticCurve Λ N S → SchemeHomOver s (Limits.pullback.snd πX σ) := fun S _ s E =>
    ⟨Limits.pullback.lift (pt S (s ≫ σ) E).1 s (by rw [(pt S (s ≫ σ) E).2]), Limits.pullback.lift_snd _ _ _⟩
  have hpt'_fst : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k))
      (E : FakeEllipticCurve Λ N S), (pt' S s E).1 ≫ Limits.pullback.fst πX σ = (pt S (s ≫ σ) E).1 := by
    intro S _ s E
    exact Limits.pullback.lift_fst _ _ _
  have hpt'_iso : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k))
      (E E' : FakeEllipticCurve Λ N S), FakeEllipticCurve.Iso E E' → pt' S s E = pt' S s E' := by
    intro S _ s E E' hEE'
    apply Subtype.ext
    apply Limits.pullback.hom_ext
    · rw [hpt'_fst, hpt'_fst, pt_iso S (s ≫ σ) E E' hEE']
    · rw [(pt' S s E).2, (pt' S s E').2]
  have hpt'_pb : ∀ (S S' : Type) [CommRing S] [CommRing S'] (φ : S →+* S')
      (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k)) (s' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of k)),
      Spec.map (CommRingCat.ofHom φ) ≫ s = s' → ∀ (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N S'),
      FakeEllipticCurve.IsPullback φ E E' → (pt' S' s' E').1 = Spec.map (CommRingCat.ofHom φ) ≫ (pt' S s E).1 := by
    intro S S' _ _ φ s s' hss' E E' hEE'
    apply Limits.pullback.hom_ext
    · rw [hpt'_fst, Category.assoc, hpt'_fst]
      exact pt_pullback S S' φ (s ≫ σ) (s' ≫ σ) (by rw [← Category.assoc, hss']) E E' hEE'
    · rw [(pt' S' s' E').2, Category.assoc, (pt' S s E).2, hss']

  obtain ⟨g₀, ⟨hg₀, hg₀pt⟩, -⟩ := hk.univ Y (Limits.pullback.snd πX σ) pt' hpt'_iso hpt'_pb
  refine ⟨e.hom ≫ g₀, by rw [Category.assoc, hg₀, he], ?_⟩
  intro y hy

  have hy₁ : (y ≫ Limits.pullback.fst πX σ) ≫ πX = 𝟙 _ ≫ σ := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hy]
