theorem finiteAlong_beta (ℓ : ℕ) [NeZero ℓ] : FiniteAlong Qb (heckeBetaHBar Qb M H ℓ) := by
  haveI : NeZero (M * ℓ) := ⟨mul_ne_zero (NeZero.ne M) (NeZero.ne ℓ)⟩
