-- Source module: Solutions.NetProp7Num
/-!
# Prop. 7, part 7: the concrete bit network (`h = 100`) and Prop. 11

`T₀` = card-3 subsets of `Fin 100` (`v = 161700`), each with `z_b = 3·C(97,2) = 13968`
neighbours, `W_b = 177176569091445000000` wires, `m = 10⁶`, and the rank sum
`s_b = W_b m − N + 2L_b = 177176569088785861287000000`.
With `τ = 1 − 2^{−50}`: `s_b / W_b < m^τ` (`hs_bit`), since `m^τ ≥ m (1 − 20·2^{−50})`
(`log m < 20`). Then `prop7_prop11` applies `AModelRat.prop11_ratLabels`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option synthInstance.maxSize 512

namespace NetProp7

open Matrix Finset AModel NetScalar AModelRat AModelFac

/-! ## 1. Counting -/

/-- Neighbours of a triple: `#{U : |U| = 3, |S ∩ U| = 1} = 3 · C(n − 3, 2)`. -/
lemma count_nb {n : ℕ} (S : Finset (Fin n)) (hS : S.card = 3) :
    (univ.filter fun U : Finset (Fin n) => U.card = 3 ∧ (S ∩ U).card = 1).card =
      3 * (n - 3).choose 2 := by
  have hc : (S ×ˢ powersetCard 2 Sᶜ).card = 3 * (n - 3).choose 2 := by
    rw [card_product, card_powersetCard, card_compl, hS, Fintype.card_fin]
  rw [← hc]
  symm
  apply Finset.card_bij (fun x _ => insert x.1 x.2)
  · rintro ⟨x, D⟩ hx
    simp only [mem_product, mem_powersetCard] at hx
    obtain ⟨hxS, hDS, hD⟩ := hx
    have hxD : x ∉ D := fun h => (Finset.mem_compl.1 (hDS h)) hxS
    simp only [mem_filter, mem_univ, true_and]
    refine ⟨by rw [card_insert_of_notMem hxD, hD], ?_⟩
    rw [Finset.card_eq_one]
    refine ⟨x, ?_⟩
    ext y
    simp only [mem_inter, mem_insert, mem_singleton]
    constructor
    · rintro ⟨hy, rfl | hy'⟩
      · rfl
      · exact absurd hy (Finset.mem_compl.1 (hDS hy'))
    · rintro rfl; exact ⟨hxS, Or.inl rfl⟩
  · rintro ⟨x, D⟩ hx ⟨x', D'⟩ hx' e
    simp only [mem_product, mem_powersetCard] at hx hx'
    have key : ∀ (x : Fin n) (D : Finset (Fin n)), x ∈ S → D ⊆ Sᶜ →
        S ∩ insert x D = {x} ∧ insert x D \ S = D := by
      intro x D hxS hDS
      constructor
      · ext y
        simp only [mem_inter, mem_insert, mem_singleton]
        constructor
        · rintro ⟨hy, rfl | hy'⟩
          · rfl
          · exact absurd hy (Finset.mem_compl.1 (hDS hy'))
        · rintro rfl; exact ⟨hxS, Or.inl rfl⟩
      · ext y
        simp only [mem_sdiff, mem_insert]
        constructor
        · rintro ⟨rfl | hy, hyS⟩
          · exact absurd hxS hyS
          · exact hy
        · intro hy; exact ⟨Or.inr hy, Finset.mem_compl.1 (hDS hy)⟩
    have k1 := key x D hx.1 hx.2.1
    have k2 := key x' D' hx'.1 hx'.2.1
    simp only at e
    rw [e] at k1
    have hxx : x = x' := by
      have := k1.1.symm.trans k2.1
      exact Finset.singleton_injective this
    have hDD : D = D' := k1.2.symm.trans k2.2
    rw [hxx, hDD]
  · intro U hU
    simp only [mem_filter, mem_univ, true_and] at hU
    obtain ⟨hU3, hU1⟩ := hU
    obtain ⟨x, hx⟩ := Finset.card_eq_one.1 hU1
    have hxSU : x ∈ S ∩ U := by rw [hx]; exact mem_singleton_self x
    rw [mem_inter] at hxSU
    refine ⟨(x, U \ S), ?_, ?_⟩
    · simp only [mem_product, mem_powersetCard]
      refine ⟨hxSU.1, fun y hy => Finset.mem_compl.2 (Finset.mem_sdiff.1 hy).2, ?_⟩
      have := Finset.card_sdiff_add_card_inter U S
      rw [Finset.inter_comm, hU1, hU3] at this
      omega
    · ext y
      simp only [mem_insert, mem_sdiff]
      constructor
      · rintro (rfl | ⟨hy, -⟩)
        · exact hxSU.2
        · exact hy
      · intro hy
        by_cases hyS : y ∈ S
        · left
          have : y ∈ S ∩ U := mem_inter.2 ⟨hyS, hy⟩
          rw [hx] at this
          exact mem_singleton.1 this
        · exact Or.inr ⟨hy, hyS⟩

/-- The triples of `Fin 100`. -/
abbrev T₀ := {S : Finset (Fin 100) // S.card = 3}

/-- The indicator map of the triple family. -/
def ind₀ : NetProp7.T₀ → Finset (Fin 100) := Subtype.val

lemma card_T₀ : Fintype.card NetProp7.T₀ = 161700 := by
  rw [Fintype.card_finset_len, Fintype.card_fin, Nat.choose_eq_descFactorial_div_factorial]
  norm_num [Nat.descFactorial, Nat.factorial]

lemma card_nbr (S : NetProp7.T₀) :
    Fintype.card {U : NetProp7.T₀ // (NetProp7.ind₀ S ∩ NetProp7.ind₀ U).card = 1} = 13968 := by
  show Fintype.card {U : NetProp7.T₀ // (S.1 ∩ U.1).card = 1} = 13968
  rw [Fintype.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter
    (fun U : Finset (Fin 100) => U.card = 3) (fun U => (S.1 ∩ U).card = 1)),
    Fintype.card_subtype, count_nb S.1 S.2, Nat.choose_eq_descFactorial_div_factorial]
  norm_num [Nat.descFactorial, Nat.factorial]

lemma card_Nb₀ : Fintype.card (NetScalar.Nb NetProp7.ind₀) = 161700 * 13968 := by
  rw [Fintype.card_subtype, Finset.card_filter, Fintype.sum_prod_type]
  have : ∀ S : NetProp7.T₀, (∑ U : NetProp7.T₀, if (NetProp7.ind₀ (S, U).1 ∩ NetProp7.ind₀ (S, U).2).card = 1 then 1 else 0) =
      13968 := by
    intro S
    rw [← card_nbr S, Fintype.card_subtype, Finset.card_filter]
  simp only [this, Finset.sum_const, Finset.card_univ, NetProp7.card_T₀, smul_eq_mul]

/-! ## 2. The numbers -/

lemma card_Wr₀ : Fintype.card (NetScalar.Wr NetProp7.ind₀) = 177176569091445000000 := by
  have := card_Wr NetProp7.ind₀
  rw [NetProp7.card_T₀, NetProp7.card_Nb₀] at this
  have h2 : (Fintype.card (NetScalar.Wr NetProp7.ind₀) : ℚ) = ((177176569091445000000 : ℕ) : ℚ) := by
    rw [this]; norm_num
  exact Nat.cast_injective h2

instance : NeZero (Fintype.card (NetScalar.Wr NetProp7.ind₀)) := ⟨by rw [NetProp7.card_Wr₀]; norm_num⟩

