      (uniqueWords n k).card := by
  have h : (((1 - (n.choose 2 : ℚ) / (2 : ℚ) ^ k) * (2 : ℚ) ^ n : ℚ) : ℝ) ≤
      (((uniqueWords n k).card : ℚ) : ℝ) := by
