theorem NLogN.KFV.runArrR_cons {α : Type*} (n : ℕ) (d : α) (o : LOp) (ops : List LOp) (xs : List α) :
    runArrR n d (o :: ops) xs = pull (binSh n) (binSh n) (permIdx o.idx) d (runArrR n d ops xs) := by sorry
