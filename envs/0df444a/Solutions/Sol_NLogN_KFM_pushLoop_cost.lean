/-!
# Register programs with multiplication calls

`RM` extends the register programs `RS` by `mul k i j`, which pushes `top j * top i` onto `k`
by calling the multiplication procedure `pM` with the calling convention

  `ARG = 55 : a :: b :: L  ↦  (a * b) :: L`,

all other stacks unchanged.  The cost of a call and the inputs on which it may be used are a
parameter `M : MulSpec`; `RM.code_runs` holds whenever the procedure meets `MulOK M`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RM

open RS (decSt decE asgCost)

/-! ## Frame -/

/-! ## Reasoning lemmas -/

theorem rep_cost_le (M : MulSpec) (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (B C : ℕ)
    (hn : n.Bnd s B)
    (hb : ∀ k < (n.eval s).toNat, b.cost M (repSt i n b s k) +
      asgCost i (decE i) (b.run (repSt i n b s k)) ≤ C) :
    (rep i n b).cost M s ≤ (n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (n.eval s).toNat * (C + 30) + 32 := by
  have h1 := RS.pushCost_le n s B hn
  have h2 : ∑ k ∈ Finset.range (n.eval s).toNat, (b.cost M (repSt i n b s k) +
      asgCost i (decE i) (b.run (repSt i n b s k)) + 30) ≤ (n.eval s).toNat * (C + 30) := by
    have := Finset.sum_le_sum (s := Finset.range (n.eval s).toNat)
      (f := fun k => b.cost M (repSt i n b s k) + asgCost i (decE i) (b.run (repSt i n b s k)) + 30)
      (g := fun _ => C + 30) (fun k hk => by have := hb k (Finset.mem_range.1 hk); omega)
    simpa using this
  simp only [cost]; omega

