section

/-!
# Topologie faible sur `Pts A` et propreté de la projection (A6)

* `Pts A` porte la topologie faible des évaluations `φ ↦ φ(a)` (instance locale `ptsTop`).
* `norm_le_rootBound` : borne de Cauchy, continue en `z`, sur les racines de `F(z, ·)`.
* `exists_tendsto_subseq` : une suite de points dont les projections convergent a une
  sous-suite convergente (Bolzano–Weierstrass sur des générateurs `bⱼ` de `A`, puis passage à
  la limite dans les identités d'anneau).
* `isClosedMap_proj` : la projection de Noether est fermée.
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

section Top

variable {A : Type} [CommRing A] [Algebra ℂ A]

/-- La topologie faible sur `Pts A`. -/
noncomputable scoped instance ptsTop : TopologicalSpace (Pts A) :=
  TopologicalSpace.induced (fun φ : Pts A ↦ (⇑φ : A → ℂ)) inferInstance

theorem isEmbedding_coe_pts : Topology.IsEmbedding (fun φ : Pts A ↦ (⇑φ : A → ℂ)) :=
  ⟨⟨rfl⟩, DFunLike.coe_injective⟩

instance : T2Space (Pts A) := isEmbedding_coe_pts.t2Space

theorem continuous_apply_pts (a : A) : Continuous fun φ : Pts A ↦ φ a :=
  (continuous_apply a).comp isEmbedding_coe_pts.continuous

theorem continuous_pts_iff {Y : Type*} [TopologicalSpace Y] (f : Y → Pts A) :
    Continuous f ↔ ∀ a, Continuous fun y ↦ f y a := by
  rw [isEmbedding_coe_pts.isInducing.continuous_iff, continuous_pi_iff]
  rfl

theorem tendsto_pts_iff {ι : Type*} {l : Filter ι} (f : ι → Pts A) (φ : Pts A) :
    Tendsto f l (𝓝 φ) ↔ ∀ a, Tendsto (fun i ↦ f i a) l (𝓝 (φ a)) := by
  rw [isEmbedding_coe_pts.isInducing.tendsto_nhds_iff, tendsto_pi_nhds]
  rfl

end Top

variable {n : ℕ} {A : Type} [CommRing A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A]

theorem continuous_proj : Continuous (proj (n := n) (A := A)) :=
  continuous_pi fun _ ↦ continuous_apply_pts _

/-! ### Borne de Cauchy -/

/-- Borne continue en `z` sur les racines de `F(z, ·)`. -/
noncomputable def rootBound (F : (Sn n)[X]) (z : Fin n → ℂ) : ℝ :=
  1 + ∑ i ∈ Finset.range (F.natDegree + 1), ‖MvPolynomial.eval z (F.coeff i)‖

theorem continuous_rootBound (F : (Sn n)[X]) : Continuous (rootBound F) := by
  unfold rootBound
  refine continuous_const.add (continuous_finsetSum _ fun i _ ↦ ?_)
  exact (MvPolynomial.continuous_eval _).norm

theorem norm_le_rootBound {F : (Sn n)[X]} (hF : F.Monic) (z : Fin n → ℂ) {t : ℂ}
    (ht : (specz F z).IsRoot t) : ‖t‖ ≤ rootBound F z := by
  have hm : (specz F z).Monic := hF.map _
  have hlt : ‖t‖₊ < cauchyBound (specz F z) := ht.norm_lt_cauchyBound hm.ne_zero
  have hsup : (Finset.range (specz F z).natDegree).sup (‖(specz F z).coeff ·‖₊) ≤
      ∑ i ∈ Finset.range (F.natDegree + 1), ‖MvPolynomial.eval z (F.coeff i)‖₊ := by
    refine Finset.sup_le fun i hi ↦ ?_
    rw [specz, coeff_map]
    refine Finset.single_le_sum (f := fun i ↦ ‖MvPolynomial.eval z (F.coeff i)‖₊)
      (fun _ _ ↦ zero_le) ?_
    rw [show (specz F z).natDegree = F.natDegree from hF.natDegree_map _] at hi
    simp only [Finset.mem_range] at hi ⊢
    omega
  have hcb : (cauchyBound (specz F z) : ℝ) ≤ rootBound F z := by
    rw [cauchyBound, hm.leadingCoeff, nnnorm_one, div_one, NNReal.coe_add, NNReal.coe_one,
      rootBound, add_comm]
    gcongr
    refine (NNReal.coe_le_coe.mpr hsup).trans_eq ?_
    simp
  calc ‖t‖ = (‖t‖₊ : ℝ) := rfl
    _ ≤ cauchyBound (specz F z) := NNReal.coe_le_coe.mpr hlt.le
    _ ≤ rootBound F z := hcb

/-! ### Propreté -/

section Limit

variable [Module.Finite (Sn n) A]

/-- **Bolzano–Weierstrass dans `Pts A`.** -/
theorem exists_tendsto_subseq (φ : ℕ → Pts A) {z : Fin n → ℂ}
    (hz : Tendsto (fun k ↦ proj (φ k)) atTop (𝓝 z)) :
    ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ φ₀ : Pts A, Tendsto (φ ∘ ψ) atTop (𝓝 φ₀) := by
  classical
  obtain ⟨r, b, hb⟩ := Module.Finite.exists_fin (R := Sn n) (M := A)
  let w : ℕ → (Fin r → ℂ) := fun k j ↦ φ k (b j)
  -- les coordonnées `φₖ(bⱼ)` sont bornées
  have hM : ∀ j, ∃ M, ∀ k, rootBound (minpoly (Sn n) (b j)) (proj (φ k)) ≤ M := fun j ↦ by
    have ht := ((continuous_rootBound (minpoly (Sn n) (b j))).tendsto z).comp hz
    obtain ⟨M, hM⟩ := (Metric.isBounded_range_of_tendsto _ ht).bddAbove
    exact ⟨M, fun k ↦ hM ⟨k, rfl⟩⟩
  choose M hM using hM
  have hbd : Bornology.IsBounded (Set.range w) := by
    refine isBounded_iff_forall_norm_le.mpr ⟨∑ j, |M j|, ?_⟩
    rintro _ ⟨k, rfl⟩
    refine (pi_norm_le_iff_of_nonneg (by positivity)).mpr fun j ↦ ?_
    have h1 := norm_le_rootBound (minpoly.monic (Algebra.IsIntegral.isIntegral (R := Sn n) (b j)))
      (proj (φ k)) (isRoot_apply (φ k))
    calc ‖w k j‖ ≤ M j := h1.trans (hM j k)
      _ ≤ |M j| := le_abs_self _
      _ ≤ ∑ j, |M j| := Finset.single_le_sum (f := fun j ↦ |M j|) (fun _ _ ↦ abs_nonneg _)
          (Finset.mem_univ j)
  obtain ⟨w₀, -, ψ, hψ, hw⟩ := tendsto_subseq_of_bounded hbd fun k ↦ Set.mem_range_self k
  refine ⟨ψ, hψ, ?_⟩
  -- passage à la limite dans chaque évaluation
  have hcoef : ∀ a : A, ∃ s : Fin r → Sn n, ∑ j, s j • b j = a := fun a ↦
    (Submodule.mem_span_range_iff_exists_fun _).mp (hb ▸ Submodule.mem_top)
  choose s hs using hcoef
  have hz' := hz.comp hψ.tendsto_atTop
  let L : A → ℂ := fun a ↦ ∑ j, MvPolynomial.eval z (s a j) * w₀ j
  have hL : ∀ a, Tendsto (fun k ↦ φ (ψ k) a) atTop (𝓝 (L a)) := fun a ↦ by
    have hform : ∀ k, φ (ψ k) a = ∑ j, MvPolynomial.eval (proj (φ (ψ k))) (s a j) *
        φ (ψ k) (b j) := fun k ↦ by
      conv_lhs => rw [← hs a]
      rw [map_sum]
      exact Finset.sum_congr rfl fun j _ ↦ apply_smul _ _ _
    simp_rw [hform]
    refine tendsto_finsetSum _ fun j _ ↦ ?_
    refine Tendsto.mul (((MvPolynomial.continuous_eval _).tendsto z).comp hz') ?_
    exact ((continuous_apply j).tendsto w₀).comp hw
  let φ₀ : Pts A :=
    { toFun := L
      map_one' := tendsto_nhds_unique (hL 1) (by simp)
      map_mul' := fun a a' ↦ tendsto_nhds_unique (hL (a * a'))
        (by simpa only [map_mul] using (hL a).mul (hL a'))
      map_zero' := tendsto_nhds_unique (hL 0) (by simp)
      map_add' := fun a a' ↦ tendsto_nhds_unique (hL (a + a'))
        (by simpa only [map_add] using (hL a).add (hL a'))
      commutes' := fun c ↦ tendsto_nhds_unique (hL (algebraMap ℂ A c)) (by simp) }
  exact ⟨φ₀, (tendsto_pts_iff _ _).mpr hL⟩

/-- **La projection de Noether est fermée.** -/
theorem isClosedMap_proj : IsClosedMap (proj (n := n) (A := A)) := by
  intro C hC
  refine isClosed_of_closure_subset fun z hz ↦ ?_
  obtain ⟨zs, hzs, hlim⟩ := mem_closure_iff_seq_limit.mp hz
  choose φ hφC hφz using hzs
  have hlim' : Tendsto (fun k ↦ proj (φ k)) atTop (𝓝 z) := by simpa [hφz] using hlim
  obtain ⟨ψ, hψ, φ₀, hφ₀⟩ := exists_tendsto_subseq φ hlim'
  refine ⟨φ₀, hC.mem_of_tendsto hφ₀ (Eventually.of_forall fun k ↦ hφC (ψ k)), ?_⟩
  exact tendsto_nhds_unique ((continuous_proj.tendsto φ₀).comp hφ₀)
    (hlim'.comp hψ.tendsto_atTop)

end Limit

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/ComplexPointsAffine.lean` -/

section

/-!
# Topologie analytique sur un ouvert affine (A5a)

Pour `x : Spec ℂ ⟶ Y` à valeurs dans un ouvert `U`, `val x U h : Γ(Y, U) →+* ℂ` est l'évaluation
des sections en `x`.

* `val_res` : compatibilité aux restrictions.
* `top_le_basicOpen_iff` : `x` est à valeurs dans `D(g)` si et seulement si `g(x) ≠ 0`.
* `eq_fromSpec` : si `W` est affine, `x = Spec(val x W) ≫ fromSpec`. En particulier `x` est
  déterminé par `val x W`.
* **Plongement** : la topologie de `W(ℂ)` est la topologie faible des sections de `Γ(Y, W)`. Le
  point clé est que toute section `s` sur un ouvert `U` s'écrit `b/gᵏ` au voisinage de chaque point
  de `U ∩ W`, avec `b, g ∈ Γ(Y, W)` (`isLocalization_basicOpen`).
-/

open AlgebraicGeometry CategoryTheory Opposite

namespace FiniteFields.Betti

section Val

variable {Y : Scheme.{0}}

/-- L'évaluation des sections sur `U` en un point complexe `x` à valeurs dans `U`. -/
noncomputable def val (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ U) : Γ(Y, U) →+* ℂ :=
  (x.appLE U ⊤ h ≫ (Scheme.ΓSpecIso (.of ℂ)).hom).hom

theorem val_apply (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ U) (t : Γ(Y, U)) :
    val x U h t = (Scheme.ΓSpecIso (.of ℂ)).hom (x.appLE U ⊤ h t) := rfl

theorem top_le_preimage_iff (x : Spec (.of ℂ) ⟶ Y) (U : Y.Opens) :
    ⊤ ≤ x ⁻¹ᵁ U ↔ x.base default ∈ U := by
  constructor
  · intro h
    exact h (show default ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
  · intro h p _
    rw [Subsingleton.elim p default]
    exact h

theorem val_res (x : Spec (.of ℂ) ⟶ Y) {U U' : Y.Opens} (hle : U' ≤ U) (h : ⊤ ≤ x ⁻¹ᵁ U)
    (h' : ⊤ ≤ x ⁻¹ᵁ U') (s : Γ(Y, U)) :
    val x U' h' (Y.presheaf.map (homOfLE hle).op s) = val x U h s := by
  simp only [val_apply, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]

theorem top_le_basicOpen_iff (x : Spec (.of ℂ) ⟶ Y) (W : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ W)
    (g : Γ(Y, W)) : ⊤ ≤ x ⁻¹ᵁ Y.basicOpen g ↔ val x W h g ≠ 0 := by
  have e := Scheme.basicOpen_appLE x ⊤ W h g
  rw [top_inf_eq] at e
  rw [← e, val_apply]
  set r := x.appLE W ⊤ h g
  have hr : r = (Scheme.ΓSpecIso (.of ℂ)).inv ((Scheme.ΓSpecIso (.of ℂ)).hom r) := by
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
  rw [hr, basicOpen_eq_of_affine, ← hr]
  constructor
  · intro hb h0
    have := hb (show default ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
    rw [h0] at this
    exact this (Ideal.zero_mem _)
  · intro hne p _
    change _ ∉ (p : PrimeSpectrum ℂ).asIdeal
    rw [Subsingleton.elim p default, Scheme.default_asIdeal, Ideal.mem_bot]
    exact hne

variable {W : Y.Opens} (hW : IsAffineOpen W)

include hW in
theorem val_SpecMap_fromSpec (φ : Γ(Y, W) →+* ℂ)
    (h : ⊤ ≤ (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) ⁻¹ᵁ W) :
    val (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec) W h = φ := by
  have h1 : hW.fromSpec.appLE W ⊤ (by simp) = (Scheme.ΓSpecIso Γ(Y, W)).inv := by
    rw [Scheme.Hom.appLE, hW.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
    rw [Subsingleton.elim (_ ≫ _) (𝟙 _), CategoryTheory.Functor.map_id, Category.comp_id]
  have h2 : (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top =
      (Spec.map (CommRingCat.ofHom φ)).appTop := by
    simp [Scheme.Hom.appLE]
    rfl
  have key : (Spec.map (CommRingCat.ofHom φ) ≫ hW.fromSpec).appLE W ⊤ h =
      hW.fromSpec.appLE W ⊤ (by simp) ≫ (Spec.map (CommRingCat.ofHom φ)).appLE ⊤ ⊤ le_top :=
    (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).symm
  ext t
  rw [val_apply, key, h1, h2]
  change ((Scheme.ΓSpecIso Γ(Y, W)).inv ≫ (Spec.map (CommRingCat.ofHom φ)).appTop ≫
    (Scheme.ΓSpecIso (.of ℂ)).hom) t = φ t
  rw [Scheme.ΓSpecIso_naturality]
  erw [Iso.inv_hom_id_assoc]
  rfl

include hW in
/-- Un point complexe à valeurs dans `W` affine est `Spec (val x W) ≫ fromSpec`. -/
theorem eq_fromSpec (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ W) :
    x = Spec.map (CommRingCat.ofHom (val x W h)) ≫ hW.fromSpec := by
  have H : Set.range x.base ⊆ Set.range hW.fromSpec.base := by
    rintro _ ⟨p, rfl⟩
    rw [hW.range_fromSpec]
    exact h (show p ∈ (⊤ : (Spec (.of ℂ)).Opens) from trivial)
  obtain ⟨ψ, hψ⟩ := Spec.map_surjective (IsOpenImmersion.lift hW.fromSpec x H)
  have hx : x = Spec.map ψ ≫ hW.fromSpec := by rw [hψ, IsOpenImmersion.lift_fac]
  have hval : val x W h = ψ.hom := by
    have h' : ⊤ ≤ (Spec.map (CommRingCat.ofHom ψ.hom) ≫ hW.fromSpec) ⁻¹ᵁ W := by
      rw [CommRingCat.ofHom_hom, ← hx]; exact h
    have := val_SpecMap_fromSpec hW ψ.hom h'
    convert this using 2; rw [CommRingCat.ofHom_hom, ← hx]
  rw [hval, CommRingCat.ofHom_hom, ← hx]

include hW in
/-- **Formule locale** : au voisinage d'un point de `U ∩ W`, une section `s ∈ Γ(Y, U)` vaut
`b / gᵏ` avec `b, g ∈ Γ(Y, W)`. -/
theorem exists_local_formula {U : Y.Opens} (s : Γ(Y, U)) (x₀ : Spec (.of ℂ) ⟶ Y)
    (h₀W : ⊤ ≤ x₀ ⁻¹ᵁ W) (h₀U : ⊤ ≤ x₀ ⁻¹ᵁ U) :
    ∃ (g b : Γ(Y, W)) (k : ℕ), val x₀ W h₀W g ≠ 0 ∧
      ∀ (x : Spec (.of ℂ) ⟶ Y) (h : ⊤ ≤ x ⁻¹ᵁ W), val x W h g ≠ 0 →
        ∃ hU : ⊤ ≤ x ⁻¹ᵁ U, val x U hU s * val x W h g ^ k = val x W h b := by
  have hp : x₀.base default ∈ U ⊓ W :=
    ⟨(top_le_preimage_iff x₀ U).mp h₀U, (top_le_preimage_iff x₀ W).mp h₀W⟩
  obtain ⟨g, hgle, hg₀⟩ := hW.exists_basicOpen_le (V := U ⊓ W) ⟨_, hp⟩ hp.2
  have := hW.isLocalization_basicOpen g
  have hDU : Y.basicOpen g ≤ U := hgle.trans inf_le_left
  obtain ⟨⟨b, _, ⟨k, rfl⟩⟩, hb⟩ :=
    IsLocalization.surj (Submonoid.powers g) (Y.presheaf.map (homOfLE hDU).op s)
  refine ⟨g, b, k, (top_le_basicOpen_iff x₀ W h₀W g).mp ((top_le_preimage_iff _ _).mpr hg₀),
    fun x h hx ↦ ?_⟩
  have hD := (top_le_basicOpen_iff x W h g).mpr hx
  refine ⟨hD.trans (Scheme.Hom.preimage_mono x hDU), ?_⟩
  have e := congrArg (val x _ hD) hb
  simp only [map_mul, map_pow] at e
  change val x _ hD (Y.presheaf.map (homOfLE hDU).op s) *
      val x _ hD (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op g) ^ k =
    val x _ hD (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op b) at e
  rwa [val_res, val_res, val_res] at e

end Val

section Embedding

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))

theorem isOpen_basicSet {U : Y.Opens} (hU : IsAffineOpen U) (s : Γ(Y, U)) {V : Set ℂ}
    (hV : IsOpen V) : IsOpen (ComplexPoints.basicSet σ π U s V) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨U, hU, s, V, hV, rfl⟩

theorem mem_basicSet_iff {U : Y.Opens} (s : Γ(Y, U)) (V : Set ℂ) (x : ComplexPoints σ π)
    (h : ⊤ ≤ x.1 ⁻¹ᵁ U) : x ∈ ComplexPoints.basicSet σ π U s V ↔ val x.1 U h s ∈ V :=
  ⟨fun ⟨_, hv⟩ ↦ hv, fun hv ↦ ⟨h, hv⟩⟩

variable {W : Y.Opens} (hW : IsAffineOpen W)

/-- `W(ℂ)`. -/
abbrev LW (W : Y.Opens) : Type := {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W}

/-- L'évaluation de toutes les sections de `Γ(Y, W)`. -/
noncomputable def ev (W : Y.Opens) (x : LW σ π W) : Γ(Y, W) → ℂ := fun t ↦ val x.1.1 W x.2 t

include hW in
theorem isOpen_LW : IsOpen {x : ComplexPoints σ π | ⊤ ≤ x.1 ⁻¹ᵁ W} := by
  convert isOpen_basicSet σ π hW 1 isOpen_univ using 1
  ext x
  exact ⟨fun h ↦ ⟨h, trivial⟩, fun ⟨h, _⟩ ↦ h⟩

include hW in
theorem continuous_ev : Continuous (ev σ π W) := by
  refine continuous_pi fun t ↦ continuous_def.mpr fun V hV ↦ ?_
  have : (fun x : LW σ π W ↦ ev σ π W x t) ⁻¹' V =
      Subtype.val ⁻¹' ComplexPoints.basicSet σ π W t V := by
    ext x
    exact (mem_basicSet_iff σ π t V x.1 x.2).symm
  rw [this]
  exact (isOpen_basicSet σ π hW t hV).preimage continuous_subtype_val

include hW in
theorem injective_ev : Function.Injective (ev σ π W) := by
  intro x x' hxx
  have e : val x.1.1 W x.2 = val x'.1.1 W x'.2 := RingHom.ext fun t ↦ congrFun hxx t
  exact Subtype.ext (Subtype.ext (by rw [eq_fromSpec hW x.1.1 x.2, eq_fromSpec hW x'.1.1 x'.2, e]))

include hW in
theorem induced_ev_le :
    TopologicalSpace.induced (ev σ π W) inferInstance ≤ (inferInstance : TopologicalSpace (LW σ π W)) := by
  change _ ≤ TopologicalSpace.induced Subtype.val (TopologicalSpace.generateFrom _)
  rw [induced_generateFrom_eq]
  refine le_generateFrom ?_
  rintro _ ⟨_, ⟨U, -, s, V, hV, rfl⟩, rfl⟩
  let _ : TopologicalSpace (LW σ π W) := TopologicalSpace.induced (ev σ π W) inferInstance
  refine isOpen_iff_forall_mem_open.mpr fun x₀ hx₀ ↦ ?_
  obtain ⟨h₀U, hv₀⟩ := hx₀
  obtain ⟨g, b, k, hg₀, hloc⟩ := exists_local_formula hW s x₀.1.1 x₀.2 h₀U
  let N : Set (Γ(Y, W) → ℂ) := {f | f g ≠ 0} ∩ (fun f ↦ f b / f g ^ k) ⁻¹' V
  have hN : IsOpen N := by
    refine ContinuousOn.isOpen_inter_preimage ?_ (isOpen_ne_fun (continuous_apply g)
      continuous_const) hV
    exact ((continuous_apply b).continuousOn).div ((continuous_apply g).pow k).continuousOn
      fun f hf ↦ pow_ne_zero k hf
  have hsx : ∀ x : LW σ π W, val x.1.1 W x.2 g ≠ 0 →
      ∃ hU : ⊤ ≤ x.1.1 ⁻¹ᵁ U, val x.1.1 U hU s = val x.1.1 W x.2 b / val x.1.1 W x.2 g ^ k := by
    intro x hx
    obtain ⟨hU, e⟩ := hloc x.1.1 x.2 hx
    exact ⟨hU, by rw [← e, mul_div_cancel_right₀ _ (pow_ne_zero k hx)]⟩
  refine ⟨ev σ π W ⁻¹' N, fun x hx ↦ ?_, isOpen_induced hN, ?_⟩
  · obtain ⟨hU, e⟩ := hsx x hx.1
    exact ⟨hU, show val x.1.1 U hU s ∈ V by rw [e]; exact hx.2⟩
  · obtain ⟨hU, e⟩ := hsx x₀ hg₀
    refine ⟨hg₀, ?_⟩
    change val x₀.1.1 W x₀.2 b / val x₀.1.1 W x₀.2 g ^ k ∈ V
    rw [← e]
    exact (mem_basicSet_iff σ π s V x₀.1 hU).mp ⟨h₀U, hv₀⟩

include hW in
/-- **Plongement de `W(ℂ)`** par l'évaluation des sections. -/
theorem isEmbedding_ev : Topology.IsEmbedding (ev σ π W) :=
  ⟨⟨le_antisymm (continuous_ev σ π hW).le_induced (induced_ev_le σ π hW)⟩, injective_ev σ π hW⟩

theorem complexPoints_isEmbedding_of_isAffineOpen_proof {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) (W : Y.Opens) (hW : IsAffineOpen W) :
    IsOpen {x : ComplexPoints σ π | ⊤ ≤ x.1 ⁻¹ᵁ W} ∧
    Topology.IsEmbedding (fun x : {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W} ↦
      fun t : Γ(Y, W) ↦ (Scheme.ΓSpecIso (.of ℂ)).hom (x.1.1.appLE W ⊤ x.2 t)) :=
  ⟨isOpen_LW σ π hW, isEmbedding_ev σ π hW⟩


end Embedding

section Generators

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))
  {W : Y.Opens}

theorem appLE_top_congr {f g : Spec (.of ℂ) ⟶ Spec (.of R)} (hfg : f = g) (e e') :
    f.appLE ⊤ ⊤ e = g.appLE ⊤ ⊤ e' := by
  subst hfg
  rfl

/-- La valeur en un point au-dessus de `σ` de l'image de `r ∈ R` est `σ r`. -/
theorem val_base (x : ComplexPoints σ π) (h : ⊤ ≤ x.1 ⁻¹ᵁ W) (r : R) (e : W ≤ π ⁻¹ᵁ ⊤) :
    val x.1 W h (π.appLE ⊤ W e ((Scheme.ΓSpecIso (.of R)).inv r)) = σ r := by
  have key : (Scheme.ΓSpecIso (.of R)).inv ≫ π.appLE ⊤ W e ≫ x.1.appLE W ⊤ h ≫
      (Scheme.ΓSpecIso (.of ℂ)).hom = CommRingCat.ofHom σ := by
    rw [← Category.assoc (π.appLE ⊤ W e), Scheme.Hom.appLE_comp_appLE x.1 π ⊤ W ⊤ e h,
      appLE_top_congr x.2 _ le_top]
    have h2 : (Spec.map (CommRingCat.ofHom σ)).appLE ⊤ ⊤ le_top =
        (Spec.map (CommRingCat.ofHom σ)).appTop := by
      simp [Scheme.Hom.appLE]
      rfl
    rw [h2, Scheme.ΓSpecIso_naturality]
    erw [Iso.inv_hom_id_assoc]
  exact congrArg (fun f ↦ f.hom r) key

theorem complexPoints_isEmbedding_of_generators_proof {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) (W : Y.Opens) (hW : IsAffineOpen W)
    (m : ℕ) (a : Fin m → Γ(Y, W))
    (ha : Subring.closure (Set.range a ∪
      Set.range fun r : R ↦ π.appLE ⊤ W le_top ((Scheme.ΓSpecIso (.of R)).inv r)) = ⊤) :
    Topology.IsEmbedding (fun x : {x : ComplexPoints σ π // ⊤ ≤ x.1 ⁻¹ᵁ W} ↦
      fun i : Fin m ↦ (Scheme.ΓSpecIso (.of ℂ)).hom (x.1.1.appLE W ⊤ x.2 (a i))) := by
  let eva : LW σ π W → (Fin m → ℂ) := fun x i ↦ ev σ π W x (a i)
  have hF : ∀ t : Γ(Y, W), ∃ F : (Fin m → ℂ) → ℂ, Continuous F ∧
      ∀ x : LW σ π W, ev σ π W x t = F (eva x) := by
    intro t
    have ht : t ∈ Subring.closure (Set.range a ∪
        Set.range fun r : R ↦ π.appLE ⊤ W le_top ((Scheme.ΓSpecIso (.of R)).inv r)) := by
      rw [ha]; trivial
    induction ht using Subring.closure_induction with
    | mem t ht =>
      rcases ht with ⟨i, rfl⟩ | ⟨r, rfl⟩
      · exact ⟨fun v ↦ v i, continuous_apply i, fun x ↦ rfl⟩
      · exact ⟨fun _ ↦ σ r, continuous_const, fun x ↦ val_base σ π x.1 x.2 r le_top⟩
    | zero => exact ⟨fun _ ↦ 0, continuous_const, fun x ↦ map_zero (val x.1.1 W x.2)⟩
    | one => exact ⟨fun _ ↦ 1, continuous_const, fun x ↦ map_one (val x.1.1 W x.2)⟩
    | add t t' _ _ h h' =>
      obtain ⟨F, hF, e⟩ := h
      obtain ⟨F', hF', e'⟩ := h'
      exact ⟨fun v ↦ F v + F' v, hF.add hF', fun x ↦ by
        show ev σ π W x (t + t') = F (eva x) + F' (eva x)
        rw [← e x, ← e' x]; exact map_add (val x.1.1 W x.2) t t'⟩
    | neg t _ h =>
      obtain ⟨F, hF, e⟩ := h
      exact ⟨fun v ↦ -F v, hF.neg, fun x ↦ by
        show ev σ π W x (-t) = -F (eva x)
        rw [← e x]; exact map_neg (val x.1.1 W x.2) t⟩
    | mul t t' _ _ h h' =>
      obtain ⟨F, hF, e⟩ := h
      obtain ⟨F', hF', e'⟩ := h'
      exact ⟨fun v ↦ F v * F' v, hF.mul hF', fun x ↦ by
        show ev σ π W x (t * t') = F (eva x) * F' (eva x)
        rw [← e x, ← e' x]; exact map_mul (val x.1.1 W x.2) t t'⟩
  choose F hFc hFe using hF
  let G : (Fin m → ℂ) → (Γ(Y, W) → ℂ) := fun v t ↦ F t v
  have hG : G ∘ eva = ev σ π W := funext fun x ↦ funext fun t ↦ (hFe t x).symm
  have hemb := isEmbedding_ev σ π hW
  have heva : Continuous eva :=
    continuous_pi fun i ↦ (continuous_apply (a i)).comp hemb.continuous
  refine ⟨Topology.IsInducing.of_comp heva (continuous_pi fun t ↦ hFc t) (hG ▸ hemb.isInducing),
    fun x x' hxx ↦ hemb.injective ?_⟩
  rw [← hG, Function.comp_apply, Function.comp_apply]
  exact congrArg G hxx


end Generators

end FiniteFields.Betti

end

/-! ## Recopié de `Bridge/Betti/Connected/Global.lean` -/

section

/-!
# Globalisation : `ComplexPoints σ π` est connexe par arcs (A6)

* **Réduction à `ℂ`** : `P = Y ×_R ℂ`. L'application `s ↦ s ≫ pr₁` des points complexes de
  `P → Spec ℂ` vers ceux de `Y → Spec R` est continue et surjective (`toY`).
* **Au-dessus de `ℂ`** : pour `O ⊆ P` affine, `O(ℂ)` est image continue de
  `Hom_ℂ(Γ(O)_red, ℂ)`, connexe par arcs (cœur affine) car `Γ(O)_red` est intègre (`O` ouvert de
  l'irréductible `P`) et de type fini. Deux tels `O(ℂ)` non vides se rencontrent (irréductibilité,
  un ouvert affine non vide ayant un point complexe).
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti

/-! ### Valeurs et composition -/

theorem val_comp {X Y : Scheme.{0}} (x : Spec (.of ℂ) ⟶ X) (g : X ⟶ Y) (U : Y.Opens)
    (h : ⊤ ≤ (x ≫ g) ⁻¹ᵁ U) (t : Γ(Y, U)) :
    val (x ≫ g) U h t = val x (g ⁻¹ᵁ U) h (g.app U t) := by
  simp only [val_apply, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
  rfl

/-- L'homomorphisme `R → ℂ` d'un morphisme `Spec ℂ ⟶ Spec R`. -/
noncomputable def rho {R : CommRingCat.{0}} (g : Spec (.of ℂ) ⟶ Spec R) : R →+* ℂ :=
  (val g ⊤ le_rfl).comp (Scheme.ΓSpecIso R).inv.hom

theorem rho_SpecMap {R : CommRingCat.{0}} (f : R ⟶ CommRingCat.of ℂ) : rho (Spec.map f) = f.hom := by
  ext r
  change (Scheme.ΓSpecIso (.of ℂ)).hom ((Spec.map f).appLE ⊤ ((Spec.map f) ⁻¹ᵁ ⊤) le_rfl
    ((Scheme.ΓSpecIso R).inv r)) = f r
  rw [Scheme.Hom.appLE_eq_app]
  change ((Scheme.ΓSpecIso R).inv ≫ (Spec.map f).appTop ≫ (Scheme.ΓSpecIso _).hom) r = f r
  rw [Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]

theorem eq_of_rho {R : CommRingCat.{0}} {g₁ g₂ : Spec (.of ℂ) ⟶ Spec R} (h : rho g₁ = rho g₂) :
    g₁ = g₂ := by
  obtain ⟨f₁, rfl⟩ := Spec.map_surjective g₁
  obtain ⟨f₂, rfl⟩ := Spec.map_surjective g₂
  rw [rho_SpecMap, rho_SpecMap] at h
  congr 1
  exact CommRingCat.hom_ext h

theorem rho_comp {R : CommRingCat.{0}} {Y : Scheme.{0}} (x : Spec (.of ℂ) ⟶ Y)
    (π : Y ⟶ Spec R) (W : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ W) (e : W ≤ π ⁻¹ᵁ ⊤) (r : R) :
    rho (x ≫ π) r = val x W h (π.appLE ⊤ W e ((Scheme.ΓSpecIso R).inv r)) := by
  have hle : ⊤ ≤ x ⁻¹ᵁ (π ⁻¹ᵁ ⊤) := h.trans (Scheme.Hom.preimage_mono x e)
  rw [rho, RingHom.comp_apply, val_comp x π ⊤ hle, ← val_res x e hle h]
  rfl

/-- **Critère « au-dessus de `σ` »** pour un point à valeurs dans `W`. -/
theorem comp_eq_SpecMap_iff {R : CommRingCat.{0}} {Y : Scheme.{0}} (x : Spec (.of ℂ) ⟶ Y)
    (π : Y ⟶ Spec R) (σ : R ⟶ CommRingCat.of ℂ) (W : Y.Opens) (h : ⊤ ≤ x ⁻¹ᵁ W)
    (e : W ≤ π ⁻¹ᵁ ⊤) :
    x ≫ π = Spec.map σ ↔ ∀ r, val x W h (π.appLE ⊤ W e ((Scheme.ΓSpecIso R).inv r)) = σ r := by
  constructor
  · intro hx r
    rw [← rho_comp x π W h e, hx, rho_SpecMap]
  · intro hx
    refine eq_of_rho (RingHom.ext fun r ↦ ?_)
    rw [rho_comp x π W h e, rho_SpecMap, hx]

/-! ### Réduction à la base `ℂ` -/

section Reduction

variable {R : Type} [CommRing R] (σ : R →+* ℂ) {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R))

/-- `P = Y ×_R ℂ` et sa projection vers `Spec ℂ`. -/
noncomputable abbrev pr₂ := pullback.snd π (Spec.map (CommRingCat.ofHom σ))

/-- La projection `P → Y`. -/
noncomputable abbrev pr₁ := pullback.fst π (Spec.map (CommRingCat.ofHom σ))

theorem SpecMap_id : Spec.map (CommRingCat.ofHom (RingHom.id ℂ)) = 𝟙 (Spec (.of ℂ)) := by
  rw [show CommRingCat.ofHom (RingHom.id ℂ) = 𝟙 (CommRingCat.of ℂ) from rfl, Spec.map_id]

/-- Les points complexes de `P` donnent ceux de `Y`. -/
noncomputable def toY (s : ComplexPoints (RingHom.id ℂ) (pr₂ σ π)) : ComplexPoints σ π :=
  ⟨s.1 ≫ pr₁ σ π, by
    rw [Category.assoc, pullback.condition, ← Category.assoc, s.2, SpecMap_id, Category.id_comp]⟩

theorem toY_surjective : Function.Surjective (toY σ π) := by
  intro x
  refine ⟨⟨pullback.lift x.1 (𝟙 _) (by rw [x.2, Category.id_comp]), ?_⟩, ?_⟩
  · rw [pullback.lift_snd, SpecMap_id]
  · exact Subtype.ext (pullback.lift_fst _ _ _)

set_option backward.isDefEq.respectTransparency.types false in
theorem continuous_toY : Continuous (toY σ π) := by
  have : IsAffineHom (pr₁ σ π) :=
    MorphismProperty.pullback_fst _ _ (inferInstance : IsAffineHom (Spec.map (CommRingCat.ofHom σ)))
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨U, hU, t, V, hV, rfl⟩
  have hpre : toY σ π ⁻¹' ComplexPoints.basicSet σ π U t V =
      ComplexPoints.basicSet (RingHom.id ℂ) (pr₂ σ π) (pr₁ σ π ⁻¹ᵁ U) ((pr₁ σ π).app U t) V := by
    ext s'
    constructor
    · rintro ⟨h, hv⟩
      exact ⟨h, by convert hv using 1; exact (val_comp s'.1 (pr₁ σ π) U h t).symm⟩
    · rintro ⟨h, hv⟩
      exact ⟨h, by convert hv using 1; exact val_comp s'.1 (pr₁ σ π) U h t⟩
  rw [hpre]
  exact isOpen_basicSet _ _ (hU.preimage _) _ hV

end Reduction

/-! ### Au-dessus de `ℂ` : les ouverts affines -/

section OverC

open Connected

variable {P : Scheme.{0}} (p : P ⟶ Spec (.of ℂ))

/-- La structure de ℂ-algèbre de `Γ(P, O)`. -/
noncomputable def algO (O : P.Opens) : ℂ →+* Γ(P, O) :=
  (p.appLE ⊤ O le_top).hom.comp (Scheme.ΓSpecIso (.of ℂ)).inv.hom

/-- `Γ(P, O)_red`, muni de la structure de ℂ-algèbre venant de `p`. -/
def RedO (_p : P ⟶ Spec (.of ℂ)) (O : P.Opens) : Type := Γ(P, O) ⧸ nilradical Γ(P, O)

noncomputable instance (O : P.Opens) : CommRing (RedO p O) :=
  inferInstanceAs (CommRing (Γ(P, O) ⧸ nilradical Γ(P, O)))

/-- La projection `Γ(P, O) → Γ(P, O)_red`. -/
noncomputable def mkO (O : P.Opens) : Γ(P, O) →+* RedO p O := Ideal.Quotient.mk _

theorem mkO_surjective (O : P.Opens) : Function.Surjective (mkO p O) :=
  Ideal.Quotient.mk_surjective

noncomputable instance (O : P.Opens) : Algebra ℂ (RedO p O) :=
  ((mkO p O).comp (algO p O)).toAlgebra

/-- Le morphisme `Γ(P, O) → ℂ` d'un point de `Hom_ℂ(Γ(P, O)_red, ℂ)`. -/
noncomputable def phiO (O : P.Opens) (ψ : Pts (RedO p O)) : Γ(P, O) →+* ℂ :=
  ψ.toRingHom.comp (mkO p O)

theorem phiO_algO (O : P.Opens) (ψ : Pts (RedO p O)) (r : ℂ) :
    phiO p O ψ (algO p O r) = r :=
  ψ.commutes r

section Theta

variable {O : P.Opens} (hO : IsAffineOpen O)

/-- Le point `Spec ℂ → Spec Γ(O) → P` défini par `ψ`. -/
noncomputable def thetaPt (ψ : Pts (RedO p O)) : Spec (.of ℂ) ⟶ P :=
  Spec.map (CommRingCat.ofHom (phiO p O ψ)) ≫ hO.fromSpec

theorem thetaPt_mem (ψ : Pts (RedO p O)) : ⊤ ≤ thetaPt p hO ψ ⁻¹ᵁ O := by
  rw [top_le_preimage_iff]
  change (thetaPt p hO ψ).base default ∈ (O : Set P)
  rw [← hO.range_fromSpec]
  exact ⟨(Spec.map (CommRingCat.ofHom (phiO p O ψ))).base default, rfl⟩

theorem thetaPt_over (ψ : Pts (RedO p O)) :
    thetaPt p hO ψ ≫ p = Spec.map (CommRingCat.ofHom (RingHom.id ℂ)) := by
  refine (comp_eq_SpecMap_iff _ p _ O (thetaPt_mem p hO ψ) le_top).mpr fun r ↦ ?_
  rw [show val (thetaPt p hO ψ) O (thetaPt_mem p hO ψ) = phiO p O ψ from
    val_SpecMap_fromSpec hO _ _]
  exact phiO_algO p O ψ r

/-- `Θ : Hom_ℂ(Γ(O)_red, ℂ) → O(ℂ)`. -/
noncomputable def theta (ψ : Pts (RedO p O)) : LW (RingHom.id ℂ) p O :=
  ⟨⟨thetaPt p hO ψ, thetaPt_over p hO ψ⟩, thetaPt_mem p hO ψ⟩

theorem continuous_theta : Continuous (theta p hO) := by
  refine (isEmbedding_ev (RingHom.id ℂ) p hO).continuous_iff.mpr (continuous_pi fun t ↦ ?_)
  have : (fun ψ : Pts (RedO p O) ↦ ev (RingHom.id ℂ) p O (theta p hO ψ) t) =
      fun ψ ↦ ψ (mkO p O t) := by
    funext ψ
    change val (thetaPt p hO ψ) O (thetaPt_mem p hO ψ) t = _
    rw [show val (thetaPt p hO ψ) O (thetaPt_mem p hO ψ) = phiO p O ψ from
      val_SpecMap_fromSpec hO _ _]
    rfl
  rw [Function.comp_def, this]
  exact continuous_apply_pts _

theorem theta_surjective : Function.Surjective (theta p hO) := by
  intro x
  set φ := val x.1.1 O x.2
  have : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
  have hker : nilradical Γ(P, O) ≤ RingHom.ker φ := nilradical_le_prime _
  let ψ : Pts (RedO p O) :=
    { toRingHom := Ideal.Quotient.lift (nilradical Γ(P, O)) φ fun a ha ↦ hker ha
      commutes' := fun r ↦ by
        change Ideal.Quotient.lift (nilradical Γ(P, O)) φ _ (mkO p O (algO p O r)) = r
        exact val_base (RingHom.id ℂ) p x.1 x.2 r le_top }
  refine ⟨ψ, Subtype.ext (Subtype.ext ?_)⟩
  have hφ : phiO p O ψ = φ := RingHom.ext fun a ↦ rfl
  change Spec.map (CommRingCat.ofHom (phiO p O ψ)) ≫ hO.fromSpec = x.1.1
  rw [hφ]
  exact (eq_fromSpec hO x.1.1 x.2).symm

end Theta

section Props

variable {O : P.Opens} (hO : IsAffineOpen O)

include hO in
theorem finiteType_RedO [LocallyOfFiniteType p] : Algebra.FiniteType ℂ (RedO p O) := by
  have hft : (p.appLE ⊤ O le_top).hom.FiniteType :=
    HasRingHomProperty.appLE (P := @LocallyOfFiniteType) p ‹_› ⟨⊤, isAffineOpen_top _⟩ ⟨O, hO⟩
      le_top
  have hiso : (Scheme.ΓSpecIso (.of ℂ)).inv.hom.FiniteType :=
    RingHom.FiniteType.of_surjective _ (fun y ↦ ⟨(Scheme.ΓSpecIso (.of ℂ)).hom y, by simp⟩)
  have h1 : (algO p O).FiniteType := hft.comp hiso
  exact (RingHom.FiniteType.of_surjective _ (mkO_surjective p O)).comp h1

include hO in
theorem isDomain_RedO [IrreducibleSpace P] (hne : (O : Set P).Nonempty) : IsDomain (RedO p O) := by
  have hirr : IsIrreducible (O : Set P) :=
    ⟨hne, (IrreducibleSpace.isIrreducible_univ P).isPreirreducible.open_subset O.isOpen
      (Set.subset_univ _)⟩
  have : IrreducibleSpace (O : Set P) := Subtype.irreducibleSpace hirr
  let h := TopCat.homeoOfIso (Scheme.forgetToTop.mapIso hO.isoSpec)
  have hspec : IrreducibleSpace (PrimeSpectrum Γ(P, O)) := by
    rw [irreducibleSpace_def]
    have hX : IrreducibleSpace (Scheme.forgetToTop.obj (O : Scheme)) := this
    have := (IrreducibleSpace.isIrreducible_univ _).image h h.continuous.continuousOn
    rw [Set.image_univ_of_surjective h.surjective] at this
    exact this
  have hprime := PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical.mp hspec
  exact Ideal.Quotient.isDomain_iff_prime _ |>.mpr hprime

end Props

/-- `O(ℂ)` pour `O` affine non vide : connexe par arcs et non vide. -/
theorem isPathConnected_LW [LocallyOfFiniteType p] [IrreducibleSpace P] {O : P.Opens}
    (hO : IsAffineOpen O) (hne : (O : Set P).Nonempty) :
    IsPathConnected {x : ComplexPoints (RingHom.id ℂ) p | ⊤ ≤ x.1 ⁻¹ᵁ O} := by
  have := finiteType_RedO p hO
  have := isDomain_RedO p hO hne
  have := FiniteFields.Betti.pathConnectedSpace_algHom (RedO p O)
  have hrange : Set.range (fun ψ ↦ (theta p hO ψ).1) =
      {x : ComplexPoints (RingHom.id ℂ) p | ⊤ ≤ x.1 ⁻¹ᵁ O} := by
    ext x
    constructor
    · rintro ⟨ψ, rfl⟩
      exact (theta p hO ψ).2
    · intro hx
      obtain ⟨ψ, hψ⟩ := theta_surjective p hO ⟨x, hx⟩
      exact ⟨ψ, congrArg Subtype.val hψ⟩
  rw [← hrange]
  exact isPathConnected_range (continuous_subtype_val.comp (continuous_theta p hO))

/-- **Points complexes d'un ℂ-schéma irréductible localement de type fini.** -/
theorem pathConnectedSpace_overC [LocallyOfFiniteType p] [IrreducibleSpace P] :
    PathConnectedSpace (ComplexPoints (RingHom.id ℂ) p) := by
  have hcover : ∀ q : P, ∃ O : P.Opens, IsAffineOpen O ∧ q ∈ O := fun q ↦ by
    obtain ⟨_, ⟨O, hO, rfl⟩, hqO, -⟩ :=
      P.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ q) isOpen_univ
    exact ⟨O, hO, hqO⟩
  have hmem : ∀ x : ComplexPoints (RingHom.id ℂ) p, ∃ O : P.Opens, IsAffineOpen O ∧
      ⊤ ≤ x.1 ⁻¹ᵁ O := fun x ↦ by
    obtain ⟨O, hO, hxO⟩ := hcover (x.1.base default)
    exact ⟨O, hO, (top_le_preimage_iff _ _).mpr hxO⟩
  obtain ⟨q⟩ := (inferInstance : Nonempty P)
  obtain ⟨O₀, hO₀, hqO₀⟩ := hcover q
  obtain ⟨x₀, hx₀, -⟩ := isPathConnected_LW p hO₀ ⟨q, hqO₀⟩
  refine ⟨⟨x₀⟩, fun x₁ x₂ ↦ ?_⟩
  obtain ⟨O₁, hO₁, h₁⟩ := hmem x₁
  obtain ⟨O₂, hO₂, h₂⟩ := hmem x₂
  have hn₁ : (O₁ : Set P).Nonempty := ⟨_, (top_le_preimage_iff _ _).mp h₁⟩
  have hn₂ : (O₂ : Set P).Nonempty := ⟨_, (top_le_preimage_iff _ _).mp h₂⟩
  obtain ⟨q', hq'⟩ := nonempty_preirreducible_inter O₁.isOpen O₂.isOpen hn₁ hn₂
  obtain ⟨_, ⟨O₃, hO₃, rfl⟩, hq'O₃, hO₃sub⟩ :=
    P.isBasis_affineOpens.exists_subset_of_mem_open hq' (O₁.isOpen.inter O₂.isOpen)
  obtain ⟨y, hy, -⟩ := isPathConnected_LW p hO₃ ⟨q', hq'O₃⟩
  have hy₁ : ⊤ ≤ y.1 ⁻¹ᵁ O₁ := hy.trans (Scheme.Hom.preimage_mono _ fun a ha ↦ (hO₃sub ha).1)
  have hy₂ : ⊤ ≤ y.1 ⁻¹ᵁ O₂ := hy.trans (Scheme.Hom.preimage_mono _ fun a ha ↦ (hO₃sub ha).2)
  have j₁ := ((isPathConnected_LW p hO₁ hn₁).joinedIn x₁ h₁ y hy₁).joined
  have j₂ := ((isPathConnected_LW p hO₂ hn₂).joinedIn y hy₂ x₂ h₂).joined
  exact j₁.trans j₂

end OverC

end FiniteFields.Betti

end

/-! ## Recopié de `Bridge/Betti/Connected/Final.lean` -/

section

/-!
# A6 : `Y(ℂ)` est connexe par arcs, et `b₀ = 1`

`P = Y ×_R ℂ` est irréductible (irréductibilité géométrique) et localement de type fini
sur `ℂ` ; ses points complexes forment un espace connexe par arcs (`pathConnectedSpace_overC`),
qui se surjecte continûment sur `ComplexPoints σ π` (`toY`). Enfin `H₀(T; ℚ) ≅ ℚ` pour `T`
connexe par arcs (augmentation de Mathlib) : voir `BettiZero.lean`.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

namespace FiniteFields.Betti

set_option backward.isDefEq.respectTransparency.types false in
theorem complexPoints_pathConnected_proof {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) [LocallyOfFiniteType π] [GeometricallyIrreducible π] :
    PathConnectedSpace (ComplexPoints σ π) := by
  have hirr : IrreducibleSpace ((pullback π (Spec.map (CommRingCat.ofHom σ)) : Scheme.{0})) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := π) (K := ℂ)
      (Spec.map (CommRingCat.ofHom σ)) _ _ (IsPullback.of_hasPullback _ _)
  have : LocallyOfFiniteType (pr₂ σ π) := MorphismProperty.pullback_snd _ _ ‹_›
  have := pathConnectedSpace_overC (pr₂ σ π)
  exact (toY_surjective σ π).pathConnectedSpace (continuous_toY σ π)


end FiniteFields.Betti

end

/-! ## Solution (statement copied verbatim) -/

open AlgebraicGeometry CategoryTheory

namespace FiniteFields.Betti

theorem _root_.solution {R : Type} [CommRing R] (σ : R →+* ℂ)
    {Y : Scheme.{0}} (π : Y ⟶ Spec (.of R)) [LocallyOfFiniteType π] [GeometricallyIrreducible π] :
    PathConnectedSpace (ComplexPoints σ π) :=
  complexPoints_pathConnected_proof σ π

end FiniteFields.Betti
