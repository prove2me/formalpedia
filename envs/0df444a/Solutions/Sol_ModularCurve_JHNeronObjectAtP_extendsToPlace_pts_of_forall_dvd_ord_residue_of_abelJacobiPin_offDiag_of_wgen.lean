  have hc0 : ∀ i, Psp.IsStrictFst α (θ.toAlgHom.comp α) hα hβ δ (W i) → c i = 0 := fun i h => if_pos h
  have hc1 : ∀ i, Psp.IsStrictSnd α (θ.toAlgHom.comp α) hα hβ δ (W i) → c i = 1 := fun i h =>
