      (inducedCoeff K μ) v hfinF he hc
    have h := hzd0 rfl s hs
    rw [hV, Complex.ofReal_one, inv_one, one_mul, ← hE.1, ← hE.2.1, ← hE.2.2, hϖ,
      LanglandsTunnell.CubicInduction.EulerMatch.eval_gl3LFactorPoly_scaled_eq_eval_inducedEulerPoly K hdeg.le
        (fun 𝔓 => (inducedCoeff K μ 𝔓)⁻¹) v] at h
    rw [h, hω1, hχTdef,
      LanglandsTunnell.CubicInduction.DualEulerMatch.inducedEulerPoly_inv_inducedCoeff_mul_comp_idelicNorm_eq_comp μ χ
        v hfinF hμv he hun,
      Polynomial.eval_comp, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, pow_zero, hε, one_pow,
      Nat.cast_zero, mul_zero, zero_mul, Complex.cpow_zero]
