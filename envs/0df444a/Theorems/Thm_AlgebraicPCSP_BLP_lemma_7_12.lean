-- title:
--   Lemma 7.12 — (A, LP(A)) is a relaxation of a pp-power of Q_conv
-- statement:
--   Let $\mathbf A$ be a finite relational structure with nonempty universe, and let $\mathrm{LP}(\mathbf A)$ be the structure of Definition 7.10 (isomorphic to the free structure of $\mathcal Q_{\mathrm{conv}}$ generated by $\mathbf A$). Then $(\mathbf A,\mathrm{LP}(\mathbf A))$ is a relaxation of a pp-power of $\mathbf Q_{\mathrm{conv}}$: there are $n\ge 0$ and an $n$-th pp-power $(\mathbf P,\mathbf P')$ of the template $(\mathbf Q_{\mathrm{conv}},\mathbf Q_{\mathrm{conv}})$, over the signature of $\mathbf A$, together with homomorphisms
--   $$\mathbf A\to\mathbf P\qquad\text{and}\qquad \mathbf P'\to\mathrm{LP}(\mathbf A).$$
--
--   This is the infinite analogue of Lemma 4.11 and gives the implication from "$\mathrm{LP}(\mathbf A)\to\mathbf B$" to item (4) of Theorem 7.9.
--
--   **Formalization Note** Both structures of the power are defined by the same formulas in the same structure $\mathbf Q_{\mathrm{conv}}$, so they coincide; the statement asserts the existence of the pair. Nonemptiness of $A$ is the field's standing convention (the paper writes $A=[n]$); it is needed, because for $A=\emptyset$ the structure $\mathrm{LP}(\mathbf A)$ is empty and no map from $\mathbb Q^n$ to it exists. The pp-formulas may use any inequalities of $\mathbf Q_{\mathrm{conv}}$.
-- source:
--   L. Barto, J. Bulín, A. Krokhin, J. Opršal, Algebraic approach to promise constraint satisfaction, arXiv:1811.00970v3, p. 47, Lemma 7.12

import Mathlib
import Definitions.Def_PCSPBLPAff_Symmetric_Setting
import Definitions.Def_AlgebraicPCSP_BLP_PPConstruction
import Definitions.Def_AlgebraicPCSP_BLP_Qconv
import Definitions.Def_AlgebraicPCSP_BLP_LP

namespace AlgebraicPCSP.BLP

open PCSPBLPAff.Symmetric

/-- Lemma 7.12 (arXiv:1811.00970v3, p. 47): for a finite (nonempty) structure `𝔸`, the template
`(𝔸, LP(𝔸))` is a relaxation of a pp-power of `Q_conv`: there are `n` and an `n`-th pp-power
`(𝔸', 𝔹')` of the template `(Q_conv, Q_conv)` with the signature of `𝔸`, a homomorphism
`𝔸 → 𝔸'` and a homomorphism `𝔹' → LP(𝔸)`. -/
theorem lemma_7_12 {τ : Type} {ar : τ → ℕ} {A : Type} [Fintype A] [DecidableEq A]
    [Nonempty A] (𝔸 : RelStruct τ ar A) :
    ∃ (n : ℕ) (𝔸' 𝔹' : RelStruct τ ar (Fin n → ℚ)),
      AlgebraicPCSP.Theory.IsPPPower n Qconv Qconv 𝔸' 𝔹' ∧ AlgebraicPCSP.Theory.IsRelaxation 𝔸' 𝔹' 𝔸 (LP 𝔸) := by sorry

end AlgebraicPCSP.BLP
