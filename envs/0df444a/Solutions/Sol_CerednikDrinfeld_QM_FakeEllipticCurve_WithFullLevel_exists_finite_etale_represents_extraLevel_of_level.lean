section Fibre

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n : ℕ)
  [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)]
  (U : (L.schemeKer n).Opens)

theorem nsmul_eq_one_iff_range_subset_Td {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of R)}
    (P : SchemeHomOver t f) (x : T ⟶ L.schemeKer n) (hx : x ≫ KerOps.ι L n = P.1) (d : ℕ) :
    L.nsmul t d P = L.one t ↔ Set.range x ⊆ (Td L hc n d : Set ↥(L.schemeKer n)) := by
  have hxs : x ≫ L.schemeKerStr n = t := KerOps.comp_str_of_comp_ι L n P x hx
  have hP : P = KerOps.toPt L n x hxs := Subtype.ext hx.symm
  have e1 : (x ≫ mulBy L hc n d) ≫ KerOps.ι L n = (L.nsmul t d P).1 := by
    rw [KerOps.comp_endK_ι L n _ _ (isHomPt_schemeNsmul L hc d) x hxs, ← hP]
    rw [CerednikDrinfeld.QM.mapPt_coe, RelativeGroupLaw.coe_nsmul_eq_comp_schemeNsmul]
  have e2 : (x ≫ L.schemeKerStr n ≫ KerOps.oneK L n) ≫ KerOps.ι L n = (L.one t).1 := by
    rw [← Category.assoc, hxs, KerOps.comp_oneK_ι]
  rw [range_subset_Td_iff]
  constructor
  · intro h
    apply KerOps.lift_unique L n
    rw [e1, e2, h]
  · intro h
    apply Subtype.ext
    rw [← e1, ← e2, h]

variable (k : Type) [Field k] [IsAlgClosed k] (sk : R →+* k)

def pieceEquiv (d : ℕ) :
    {w : Spec (CommRingCat.of k) ⟶ ↑(U ⊓ Td L hc n d) //
        w ≫ ((U ⊓ Td L hc n d).ι ≫ L.schemeKerStr n) = Spec.map (CommRingCat.ofHom sk)} ≃
    {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f //
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P ∧
          L.nsmul (CerednikDrinfeld.QM.geomPoint k sk) d P = L.one _} where
  toFun w := by
    have hmem : ∀ y, (U ⊓ Td L hc n d).ι y ∈ (U : Set ↥(L.schemeKer n)) ∩ (Td L hc n d : Set ↥(L.schemeKer n)) := by
      intro y
      rw [← TopologicalSpace.Opens.coe_inf, ← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
    refine ⟨KerOps.toPt L n (w.1 ≫ (U ⊓ Td L hc n d).ι) (by rw [Category.assoc]; exact w.2), ?_, ?_⟩
    · rw [Bridge.factorsThrough_iff_of_lift L n U _ (w.1 ≫ (U ⊓ Td L hc n d).ι) rfl]
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Hom.comp_apply]; exact (hmem (w.1 p)).1
    · rw [nsmul_eq_one_iff_range_subset_Td L hc n _ (w.1 ≫ (U ⊓ Td L hc n d).ι) rfl]
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Hom.comp_apply]; exact (hmem (w.1 p)).2
  invFun P := by
    have hx := (Bridge.factorsThrough_iff L n U P.1).mp P.2.1
    let x := hx.choose
    have hrange : Set.range x ⊆ ((U ⊓ Td L hc n d : (L.schemeKer n).Opens) : Set ↥(L.schemeKer n)) := by
      intro y hy
      exact ⟨hx.choose_spec.2 hy, (nsmul_eq_one_iff_range_subset_Td L hc n P.1 x hx.choose_spec.1 d).mp P.2.2 hy⟩
    refine ⟨IsOpenImmersion.lift (U ⊓ Td L hc n d).ι x (by rw [Scheme.Opens.range_ι]; exact hrange), ?_⟩
    rw [← Category.assoc, IsOpenImmersion.lift_fac]
    exact KerOps.comp_str_of_comp_ι L n P.1 x hx.choose_spec.1
  left_inv w := by
    apply Subtype.ext
    apply (cancel_mono (U ⊓ Td L hc n d).ι).mp
    rw [IsOpenImmersion.lift_fac]
    apply KerOps.lift_unique L n
    generalize_proofs h₁ h₂
    exact (Exists.choose_spec (p := fun x => x ≫ KerOps.ι L n = _ ∧ _) _).1
  right_inv P := by
    apply Subtype.ext; apply Subtype.ext
    simp only [KerOps.toPt_coe, IsOpenImmersion.lift_fac]
    generalize_proofs
    exact (Exists.choose_spec (p := fun x => x ≫ KerOps.ι L n = _ ∧ _) _).1

theorem natCard_torsion_eq_finrank (hU : IsClosed (U : Set ↥(L.schemeKer n))) (d : ℕ) :
    Nat.card {P : SchemeHomOver (CerednikDrinfeld.QM.geomPoint k sk) f //
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P ∧
          L.nsmul (CerednikDrinfeld.QM.geomPoint k sk) d P = L.one _} =
      ((U ⊓ Td L hc n d).ι ≫ L.schemeKerStr n).finrank
        (Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k)) := by
  haveI : IsFinite ((U ⊓ Td L hc n d).ι ≫ L.schemeKerStr n) :=
    isFinite_piece _ _ (hU.inter (Td_closed L hc n d))
  rw [AlgebraicGeometry.finrank_eq_natCard_of_isFinite_of_etale_of_isAlgClosed _ k sk,
    Nat.card_congr (pieceEquiv L hc n U k sk d)]

end Fibre
