/-! ## Ops as KFG atoms -/

open IntMul.Kappa.R6.IL3H

lemma rc_lt (r : Rl) : rc r < Wn + Tn := by
  rcases r with w | n
  · exact Nat.lt_of_lt_of_le w.isLt (Nat.le_add_right _ _)
  · simp only [rc]; have := n.isLt; omega

lemma roleEqv_val (r : Rl) : (roleEqv Wn Tn r).val = rc r := by
  rcases r with w | n
  · simp [roleEqv, rc]
  · simp [roleEqv, rc]

lemma sign_natAbs_le (k : ℤ) : k.sign.natAbs ≤ 1 := by
  rcases Int.sign_trichotomy k with h | h | h <;> rw [h] <;> decide

lemma mat_atoms (d s : Rl) (k : ℤ) (hne : d ≠ s) :
    (GOp.mat ⟨d, s, (k : ℂ) / 2⟩ : Matrix Rl Rl ℂ) =
      (NLogN.KFG.gateMat (Wn + Tn) (List.replicate k.natAbs (atK d s k))).submatrix
        (roleEqv Wn Tn) (roleEqv Wn Tn) := by
  ext p q
  simp only [GOp.mat, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply, Matrix.submatrix_apply,
    NLogN.KFG.gateMat, List.map_replicate, List.sum_replicate, atK, roleEqv_val,
    (roleEqv Wn Tn).apply_eq_iff_eq]
  congr 1
  have e : (rc d = rc p ∧ rc s = rc q) ↔ (d = p ∧ s = q) :=
    ⟨fun h => ⟨rc_inj h.1, rc_inj h.2⟩, fun h => ⟨congrArg rc h.1, congrArg rc h.2⟩⟩
  by_cases h : d = p ∧ s = q
  · rw [if_pos h, if_pos (e.2 h), nsmul_eq_mul]
    have hk : ((k.natAbs : ℂ) * (k.sign : ℂ)) = (k : ℂ) := by
      have h0 : ((k.natAbs : ℤ) * k.sign : ℤ) = k := by rw [mul_comm]; exact Int.sign_mul_natAbs k
      have := congrArg (fun z : ℤ => (z : ℂ)) h0
      simp only [Int.cast_mul, Int.cast_natCast] at this
      exact this
    simp only [NLogN.KFB.toC, Int.cast_zero, zero_mul, add_zero, pow_one]
    rw [← hk]; ring
  · rw [if_neg h, if_neg (fun h' => h (e.1 h')), smul_zero]

lemma diag_C3 (X : Rl) :
    (GOp.mat ⟨X, X, -2⟩ : Matrix Rl Rl ℂ) = Matrix.diagonal fun w => if w ∈ ({X} : Finset Rl) then -1 else 1 := by
  ext p q
  simp only [GOp.mat, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply, Matrix.diagonal_apply,
    Finset.mem_singleton]
  by_cases h1 : p = q
  · subst h1
    by_cases h2 : p = X
    · subst h2; simp; norm_num
    · simp [h2, Ne.symm h2]
  · simp only [if_neg h1]
    by_cases h2 : X = p
    · subst h2; simp [Ne.symm h1, h1]
    · simp [h2]

lemma GP_mono {o : GOp Rl} {A B : ℕ} (h : A ≤ B) (hA : GP o A) : GP o B := by
  rcases hA with ⟨as, h1, h2⟩ | h
  · exact Or.inl ⟨as, h1.trans h, h2⟩
  · exact Or.inr h

lemma GP_of_opK {o : GOp Rl} (h : OpK o) : ∃ A, GP o A := by
  obtain ⟨d, s, c⟩ := o
  rcases h with ⟨hne, k, hk⟩ | ⟨he, hc⟩
  · simp only at hne hk
    subst hk
    refine ⟨k.natAbs, Or.inl ⟨List.replicate k.natAbs (atK d s k), by simp, fun a ha => ?_, ?_,
      mat_atoms d s k hne⟩⟩
    · rw [List.eq_of_mem_replicate ha]
      exact ⟨⟨rc_lt d, rc_lt s, fun e => hne (rc_inj e), sign_natAbs_le k, Nat.zero_le _⟩, le_rfl⟩
    · intro a ha b hb
      rw [List.eq_of_mem_replicate ha, List.eq_of_mem_replicate hb]
      exact fun e => hne (rc_inj e)
  · simp only at he hc
    subst he hc
    exact ⟨0, Or.inr ⟨{d}, diag_C3 d⟩⟩

lemma exists_bound {α : Type*} (P : α → ℕ → Prop) (hm : ∀ a k k', k ≤ k' → P a k → P a k') :
    ∀ l : List α, (∀ a ∈ l, ∃ k, P a k) → ∃ A, ∀ a ∈ l, P a A
  | [], _ => ⟨0, by simp⟩
  | a :: l, h => by
    obtain ⟨k, hk⟩ := h a List.mem_cons_self
    obtain ⟨A, hA⟩ := exists_bound P hm l fun b hb => h b (List.mem_cons_of_mem _ hb)
    refine ⟨max k A, fun b hb => ?_⟩
    rcases List.mem_cons.1 hb with rfl | hb
    · exact hm _ _ _ (le_max_left _ _) hk
    · exact hm _ _ _ (le_max_right _ _) (hA b hb)

theorem JG_gclass (J : Prop8IfaceH 207387136 Tn 576 IntMul.Kappa.Jain.cxR6) (hJ : J.net = netG) :
    ∃ A, GClassH J A := by
  obtain ⟨A, hA⟩ := exists_bound GP (fun _ _ _ h hk => GP_mono h hk) (progOps CH)
    (fun o ho => GP_of_opK (opK_CH o ho))
  refine ⟨A, fun G hG => ?_⟩
  rw [hJ] at hG
  obtain ⟨o, ho, rfl⟩ := netG_gate hG
  exact hA o ho

end IntMul.Kappa.R6.Cx.NetG

