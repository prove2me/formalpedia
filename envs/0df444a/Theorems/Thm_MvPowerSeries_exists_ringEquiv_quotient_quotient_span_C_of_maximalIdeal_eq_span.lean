-- title:
--   Special fibre of W[[X_σ]]/(g) modulo π
-- statement:
--   Let $W$ be a commutative local ring whose maximal ideal is principal, generated by an element $\pi$, so that $\mathfrak m_W = (\pi)$; let $\sigma$ be an arbitrary index type and let $g \in W[[X_\sigma]] =$ `MvPowerSeries σ W`. Write $\kappa =$ `IsLocalRing.ResidueField W` and let $\bar{\,\cdot\,} : W[[X_\sigma]] \to \kappa[[X_\sigma]]$ be coefficientwise reduction, `MvPowerSeries.map (IsLocalRing.residue W)`. The assertion is the existence of a ring isomorphism
--   $$e : \bigl(W[[X_\sigma]]/(g)\bigr)\big/\bigl(\,\overline{\phantom{x}}^{\,J}(C\,\pi)\,\bigr) \;\xrightarrow{\ \sim\ }\; \kappa[[X_\sigma]]/(\bar g),$$
--   where $J = (g)$ is the ideal of $W[[X_\sigma]]$ generated by $g$, the ideal divided out on the left is generated by the class modulo $J$ of the constant power series $C\,\pi$, and $(\bar g)$ is the ideal of $\kappa[[X_\sigma]]$ generated by the reduction of $g$; moreover $e$ is compatible with the canonical maps from $W[[X_\sigma]]$, in the sense that for every $p \in W[[X_\sigma]]$ the element $e$ sends the class of the class of $p$ to the class of $\bar p$ in $\kappa[[X_\sigma]]/(\bar g)$. No completeness, noetherianity or finiteness hypothesis on $\sigma$ is imposed, and $g$ is arbitrary.
--
--   This identifies the special fibre of the hypersurface $W[[X_\sigma]]/(g)$, i.e. its reduction modulo the uniformiser, with the corresponding hypersurface over the residue field; it is the third isomorphism theorem applied to the pair of ideals $(g)$ and $(\pi)$ inside a multivariate power series ring. It is used in the local analysis of the Drinfeld-type curve charts, for instance in establishing primality and radicality properties of the ideals cut out by $\pi$ and by the branch primes.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPowerSeries_exists_ringEquiv_quotient_quotient_span_C_of_maximalIdeal_eq_span.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

open MvPowerSeries

theorem MvPowerSeries.exists_ringEquiv_quotient_quotient_span_C_of_maximalIdeal_eq_span
    {W : Type u} [CommRing W] [IsLocalRing W] (π : W) (hπ : IsLocalRing.maximalIdeal W = Ideal.span {π})
    {σ : Type v} (g : MvPowerSeries σ W) :
    ∃ e : ((MvPowerSeries σ W ⧸ Ideal.span {g}) ⧸
          Ideal.span {Ideal.Quotient.mk (Ideal.span {g}) (C π)}) ≃+*
        (MvPowerSeries σ (IsLocalRing.ResidueField W) ⧸ Ideal.span {MvPowerSeries.map (IsLocalRing.residue W) g}),
      ∀ p : MvPowerSeries σ W,
        e (Ideal.Quotient.mk _ (Ideal.Quotient.mk (Ideal.span {g}) p)) =
          Ideal.Quotient.mk _ (MvPowerSeries.map (IsLocalRing.residue W) p) := by sorry
