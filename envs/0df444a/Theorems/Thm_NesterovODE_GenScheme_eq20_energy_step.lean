-- url     : https://prove2.me/theorems/0ad946ae-62cc-41f8-9e9d-5d27d5d301e5
-- title:
--   (20), p. 14 — E(k) + (2s[(r − 3)(k + r − 2) + 1]/(r − 1))(f(x_{k−1}) − f⋆) ≤ E(k − 1)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space and $f=g+h$ with $g:\mathcal H\to\mathbb R$ convex, continuously differentiable, with $L$-Lipschitz gradient ($L>0$), and $h:\mathcal H\to\mathbb R\cup\{+\infty\}$ proper, lower semicontinuous and convex. Let $0<s\le1/L$, $r>3$, let $(x_k)$ be generated by the generalized Nesterov scheme (19) from $y_0=x_0$, and let $x^\star$ minimize $f$, $f^\star=f(x^\star)$. Define the discrete energy
--
--   $$
--   \mathcal E(k)=\frac{2(k+r-2)^2 s}{r-1}\big(f(x_k)-f^\star\big)+(r-1)\|z_k-x^\star\|^2,\qquad z_k=\frac{k+r-1}{r-1}y_k-\frac{k}{r-1}x_k .
--   $$
--
--   Then for every $k\ge1$,
--
--   $$
--   \mathcal E(k)+\frac{2s\big[(r-3)(k+r-2)+1\big]}{r-1}\big(f(x_{k-1})-f^\star\big)\le\mathcal E(k-1).
--   $$
--
--   Since $r>3$ the added term is nonnegative, so the energy is non-increasing and its decrease controls a weighted optimality gap; summing over $k$ gives (21) and hence both bounds of Theorem 6.
--
--   **Formalization Note.** $\mathcal E(k)$ is the published `NesterovFB.Rates.energy h g r s x xstar k`, whose auxiliary point `zSeq r x k` $=x_k+\frac{k-1}{r-1}(x_k-x_{k-1})$ coincides with the paper's $z_k$ for $k\ge1$ by (19) and equals $x_0=z_0$ at $k=0$. Values lie in `EReal`; at $k=1$ both sides involve $f(x_0)$, which may be $+\infty$, and the inequality then reads $+\infty\le+\infty$, as on the page. The proximal map is any $P$ with `IsProx s h P` for closed $h$; $s\le1/L$ is written $sL\le1$.
-- source:
--   Su, Boyd, Candès, A Differential Equation for Modeling Nesterov's Accelerated Gradient Method, arXiv:1503.01243v2, p. 14, (20)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_NesterovODE_GenScheme_Run

open InnerProductSpace NesterovFB.Rates ThreeOpSplitting.ConvexRates

namespace NesterovODE.GenScheme

theorem eq20_energy_step {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s r : ℝ) (P : H → H) (x : ℕ → H) (xstar : H)
    (hΨ : IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL0 : 0 < L) (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L ≤ 1)
    (hP : IsProx s Ψ P)
    (hr : 3 < r)
    (hrun : IsGenNesterovRun Φ P r s x)
    (hmin : ∀ y : H, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k →
      energy Ψ Φ r s x xstar k
        + ((2 * s * ((r - 3) * ((k : ℝ) + r - 2) + 1) / (r - 1) : ℝ) : EReal)
          * (theta Ψ Φ (x (k - 1)) - theta Ψ Φ xstar)
        ≤ energy Ψ Φ r s x xstar (k - 1) := by sorry

end NesterovODE.GenScheme
