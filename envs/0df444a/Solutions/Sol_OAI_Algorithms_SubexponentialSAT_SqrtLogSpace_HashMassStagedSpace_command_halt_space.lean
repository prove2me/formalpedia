/-! Exact finite staging extracted from `SqrtLog.LeafOuterNativeStage` for the
space-aware hash pipeline. Semantic query provenance remains in the original
module, while these declarations live in the stronger development's namespace. -/
namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.LeafOuterNative
open OAI BitProgram StructuredCalls SqrtLog.LeafOuterProgram
open Subexp

theorem finalStaged_sources (a : Data) :
    (finalStaged a).stacks 700=a.stacks 784 ∧
    (finalStaged a).stacks 701=a.stacks 777 ∧
    (finalStaged a).stacks 707=a.stacks 782 ∧
    (finalStaged a).stacks 708=a.stacks 783 ∧
    (finalStaged a).stacks 709=a.stacks 785 := by
  simp [finalStaged,masterRoutes,routesState,routed]

theorem finalStaged_frame (a : Data) (i : Fin 896)
    (h0 : i≠700) (h1 : i≠701) (h7 : i≠707) (h8 : i≠708) (h9 : i≠709) :
    (finalStaged a).stacks i=a.stacks i := by
  apply routes_frame
  intro p hp
  simp only [masterRoutes,List.mem_cons,List.not_mem_nil,or_false] at hp
  rcases hp with rfl|rfl|rfl|rfl|rfl
  · exact Ne.symm h0
  · exact Ne.symm h7
  · exact Ne.symm h8
  · exact Ne.symm h9
  · exact Ne.symm h1

theorem prefixed_rows (a : Data) :
    (prefixed a).stacks 701=true::(Encoding.frame (a.stacks 768).reverse++a.stacks 701) := by
  simp [prefixed,trialPorts,TupleProgram.pushedState,routed,
    TupleProgram.frame_eq_escaped,List.append_assoc]

theorem prefixed_scratch (a : Data) : (prefixed a).stacks 702=[] := by
  simp [prefixed,trialPorts,TupleProgram.pushedState,routed]

theorem prefixed_frame (a : Data) (i : Fin 896) (h1 : i≠701) (h2 : i≠702) :
    (prefixed a).stacks i=a.stacks i := by
  simp [prefixed,trialPorts,TupleProgram.pushedState,routed,h1,h2]

theorem trialStaged_sources (a : Data) :
    (trialStaged a).stacks 700=a.stacks 784 ∧
    (trialStaged a).stacks 701=true::(Encoding.frame (a.stacks 768).reverse++a.stacks 777) ∧
    (trialStaged a).stacks 707=a.stacks 782 ∧
    (trialStaged a).stacks 708=a.stacks 783 ∧
    (trialStaged a).stacks 709=a.stacks 785 := by
  have h := finalStaged_sources a
  refine ⟨?_,?_,?_,?_,?_⟩
  · exact (prefixed_frame _ 700 (by decide) (by decide)).trans h.1
  · rw [trialStaged,prefixed_rows,h.2.1,
      finalStaged_frame a 768 (by decide) (by decide) (by decide) (by decide) (by decide)]
  · exact (prefixed_frame _ 707 (by decide) (by decide)).trans h.2.2.1
  · exact (prefixed_frame _ 708 (by decide) (by decide)).trans h.2.2.2.1
  · exact (prefixed_frame _ 709 (by decide) (by decide)).trans h.2.2.2.2

theorem trialStaged_frame (a : Data) (i : Fin 896)
    (h0 : i≠700) (h1 : i≠701) (h2 : i≠702) (h7 : i≠707) (h8 : i≠708) (h9 : i≠709) :
    (trialStaged a).stacks i=a.stacks i :=
  (prefixed_frame _ i h1 h2).trans (finalStaged_frame a i h0 h1 h7 h8 h9)

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.LeafOuterNative
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_HashMassStaged
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! Paid physical source assembly precedes all marked queries. The candidate
is prepended to a copied history stream; neither retained word is changed.
The temporary source masters are cleared after the complete natural mass. -/
namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStaged

open BitProgram StructuredCalls RecordPrograms SqrtLog LeafProgram LeafOuterProgram
open HashMassAdapter

theorem cleanup_eval (a : State 40 896) (ht : a.stacks 767 = []) :
    Eval cleanup (cleanupCost a) a (cleaned a) := by
  simpa only [cleanup, cleanupCost, cleaned, stagedPorts, List.length_cons, List.length_nil] using
    BankRoutines.clear_eval (767 : Fin 896) (0 : Fin 40) 1 stagedPorts (by decide) a.regs a.stacks ht

theorem staged_frame (a : State 40 896) (i : Fin 896) (hi : i ∉ stagedPorts) :
    (LeafOuterNative.trialStaged a).stacks i = a.stacks i := by
  have hne : i ≠ 700 ∧ i ≠ 701 ∧ i ≠ 702 ∧ i ≠ 707 ∧ i ≠ 708 ∧ i ≠ 709 := by
    simpa [stagedPorts] using hi
  exact LeafOuterNative.trialStaged_frame a i hne.1 hne.2.1 hne.2.2.1
    hne.2.2.2.1 hne.2.2.2.2.1 hne.2.2.2.2.2

theorem staged_stack_bound (a : State 40 896) (L : ℕ)
    (ha : ∀ i, (a.stacks i).length ≤ L) :
    ∀ i, ((LeafOuterNative.trialStaged a).stacks i).length ≤ 3 * L + 2 := by
  intro i
  have hsrc := LeafOuterNative.trialStaged_sources a
  by_cases hi : i ∈ stagedPorts
  · simp only [stagedPorts, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl|rfl|rfl|rfl|rfl|rfl
    · rw [hsrc.1]; have := ha 784; omega
    · rw [hsrc.2.1]
      simp only [List.length_cons,List.length_append,Encoding.length_frame,List.length_reverse]
      have := ha 768
      have := ha 777
      omega
    · rw [show (LeafOuterNative.trialStaged a).stacks 702 = [] from
        LeafOuterNative.prefixed_scratch _]
      simp
    · rw [hsrc.2.2.1]; have := ha 782; omega
    · rw [hsrc.2.2.2.1]; have := ha 783; omega
    · rw [hsrc.2.2.2.2]; have := ha 785; omega
  · rw [staged_frame a i hi]
    have := ha i
    omega

theorem stage_cost_le (a : State 40 896) (L : ℕ)
    (ha : ∀ i, (a.stacks i).length ≤ L) :
    LeafOuterNative.stageTrialCost a ≤ 59 * L + 58 := by
  have hf := routes_cost_bound LeafOuterNative.masterRoutes a L ha
  have h702 := LeafOuterNative.finalStaged_frame a 702 (by decide) (by decide)
    (by decide) (by decide) (by decide)
  have h768 := LeafOuterNative.finalStaged_frame a 768 (by decide) (by decide)
    (by decide) (by decide) (by decide)
  have h1 := ha 702
  have h2 := ha 768
  unfold LeafOuterNative.stageTrialCost LeafOuterNative.stageFinalCost
    LeafOuterNative.prefixCost routeCost
  rw [h702,h768]
  simp only [LeafOuterNative.masterRoutes,List.length_cons,List.length_nil] at hf ⊢
  omega

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStaged
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_HashMassStagedSpace
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! Physical staging, all marked counts, and actual source cleanup share one
prefix bound. Cleanup only removes bits, so it does not amplify the query's
transient cap into the next boundary allowance. -/
namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStagedSpace

open BitProgram StructuredCalls RecordPrograms SqrtLog LeafProgram
open HashGreedyProgram HashGreedyProgram.NativeRound HashMassAdapter HashMassStaged

theorem command_halt_space_oai (query : Cmd 40 896) (count queryCost width : List Bool → ℕ)
    (valid : List Bool → Prop) (a : State 40 896) (m L K : ℕ)
    (ha : ReferencesReady a) (hm : CounterPrograms.value (a.stacks 782) = m)
    (hL : ∀ i, (a.stacks i).length ≤ L)
    (hcollector : ∀ i : Fin 896, 321 ≤ i.val → i.val ≤ 324 → a.stacks i = [])
    (hvalid : ∀ e : Fin m, valid (Encoding.encodeNat e.val))
    (href : (Encoding.encodeList id (RowSelectionProgram.Index.alphabet m)).length ≤ 3 * L + 2)
    (hgrowth : outputGrowth width (RowSelectionProgram.Index.alphabet m) ≤ 3 * L + 2)
    (hq : ∀ bits tail (base : State 40 896), valid bits →
      Ready (fun words => words = workspace (LeafOuterNative.trialStaged a)) base →
      ∃ n middle, n ≤ queryCost bits ∧ workspace middle = workspace (LeafOuterNative.trialStaged a) ∧
        read middle = read base ∧ BinaryArithmetic.toNat (middle.stacks 323) = count bits ∧
        (middle.stacks 323).length ≤ width bits ∧ middle.stacks 324 = [] ∧
        Eval query n (state recordPorts base false true false tail bits.reverse)
          (state recordPorts middle false true false tail []))
    (hspace : ∀ bits tail base n middle, valid bits →
      Ready (fun words => words = workspace (LeafOuterNative.trialStaged a)) base →
      (read base).length ≤ 3 * L + 2 → tail.length ≤ 3 * L + 2 →
      bits.length ≤ 3 * L + 2 → width bits ≤ 3 * L + 2 →
      Eval query n (state recordPorts base false true false tail bits.reverse)
        (state recordPorts middle false true false tail []) →
      StageSpace query n (state recordPorts base false true false tail bits.reverse) K)
    {steps : ℕ} {result : State 40 896} (he : Eval (HashMassStaged.command query) steps a result) :
    StageSpace (HashMassStaged.command query) (steps + 1) a (spaceBudget a L K) := by
  let s := LeafOuterNative.trialStaged a
  have hs : ReferencesReady s := by
    constructor
    · rw [staged_frame a 767 (by decide)]
      exact ha.scratch
    · intro i hi
      have hne : i ∉ stagedPorts := by
        simp only [stagedPorts, List.mem_cons, List.not_mem_nil, or_false] at *
        rcases hi with hi | rfl
        · intro hh
          rcases hh with rfl | rfl | rfl | rfl | rfl | rfl <;> omega
        · decide
      rw [staged_frame a i hne]
      exact ha.empty i hi
  obtain ⟨nc, _, c, hc, hout⟩ := mass_eval query count queryCost width valid s m hs
    (by rw [staged_frame a 782 (by decide)]; exact hm)
    (by rw [staged_frame a 321 (by decide)]; exact hcollector 321 (by decide) (by decide))
    (by rw [staged_frame a 322 (by decide)]; exact hcollector 322 (by decide) (by decide))
    (by rw [staged_frame a 323 (by decide)]; exact hcollector 323 (by decide) (by decide))
    (by rw [staged_frame a 324 (by decide)]; exact hcollector 324 (by decide) (by decide)) hvalid hq
  have hmassSpace := HashMassSpace.mass_halt_space query count queryCost width valid s m
    (3 * L + 2) K hs (by rw [staged_frame a 782 (by decide)]; exact hm)
    (staged_stack_bound a L hL)
    (by rw [staged_frame a 321 (by decide)]; exact hcollector 321 (by decide) (by decide))
    (by rw [staged_frame a 322 (by decide)]; exact hcollector 322 (by decide) (by decide))
    (by rw [staged_frame a 323 (by decide)]; exact hcollector 323 (by decide) (by decide))
    (by rw [staged_frame a 324 (by decide)]; exact hcollector 324 (by decide) (by decide))
    hvalid href hgrowth hq hspace hc
  have hmass : StageSpace (mass query) (nc + 1) s (spaceBudget a L K) := by
    constructor
    intro k state hk ht i
    have h := hmassSpace.bound k state hk ht i
    have hroute : LeafOuterProgram.routeCost (782,0) s = LeafOuterProgram.routeCost (782,0) a := by
      dsimp only [s]
      simp only [LeafOuterProgram.routeCost, staged_frame a 0 (by decide),
        staged_frame a 782 (by decide)]
    have h782 : s.stacks 782 = a.stacks 782 := staged_frame a 782 (by decide)
    rw [hroute, h782] at h
    unfold spaceBudget
    omega
  have hcBound : ∀ i, (c.stacks i).length ≤ spaceBudget a L K := by
    intro i
    exact hmass.bound (nc + 1) (c.withPC none) le_rfl (compiled_halt_trace hc 778 777) i
  have hc767 : c.stacks 767 = [] := by simp [hout, hs.scratch]
  have hclean := cleanup_eval c hc767
  have hcleanSpace : StageSpace cleanup (cleanupCost c) c (spaceBudget a L K) := by
    constructor
    simpa only [cleanup, cleanupCost, stagedPorts, List.length_cons, List.length_nil] using
      HighQuerySpace.clear_bank_bound (767 : Fin 896) (0 : Fin 40) 1 stagedPorts
        (by decide) c hc767 (spaceBudget a L K) hcBound 778 777
  have hstage := LeafOuterNative.stageTrial_eval a ha.scratch
  have hstageSpace : StageSpace LeafOuterNative.stageTrial (LeafOuterNative.stageTrialCost a) a
      (spaceBudget a L K) := by
    constructor
    intro k state hk ht i
    have h := StructuredSpace.local_stack_bound (compiled LeafOuterNative.stageTrial 778 777)
      (StreamResources.dataBits_le_mul _ hL) k state (hk.trans (stage_cost_le a L hL)) ht i
    unfold spaceBudget
    omega
  have hmassNoHalt : StageSpace (mass query) nc s (spaceBudget a L K) := by
    constructor
    intro k state hk ht i
    exact hmass.bound k state (by omega) ht i
  have hfull := hstage.seq (hc.seq hclean)
  have hfullSpace := StageSpace.seq hstage (hc.seq hclean) hstageSpace
    (StageSpace.seq hc hclean hmassNoHalt hcleanSpace)
  have hsteps := StreamResources.eval_steps_eq 778 777 he hfull
  rw [hsteps]
  exact ⟨StructuredSpace.compiled_halt_stack_bound hfull 778 777 hfullSpace.bound⟩

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStagedSpace
end

theorem solution : type_of% @OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStagedSpace.command_halt_space_oai := @OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.HashMassStagedSpace.command_halt_space_oai
