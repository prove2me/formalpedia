  have e1 : T zs.length = (((s.upd 0 R0).upd tY (.int ((carN b cs 0).2 : ℤ) :: LY)).upd tG
        (ints (((carN b cs 0).1.map (fun d : ℕ => (d : ℤ))).reverse) ++ s.G tG)) := by
    have htk : cs.take zs.length = cs := List.take_of_length_le (by omega)
    simp only [T, List.drop_length, htk]; simp [gflat]
  rw [e0, e1] at h
  exact h

theorem c2_runs (b a0 : ℕ) (ha0 : 1 ≤ a0) (L : List ℕ) (hL : ∀ d ∈ L, d < 2 ^ b) (s : IState HS)
    (LY LR LG LP : List Item) (hY : s.G tY = .int (a0 : ℤ) :: LY)
    (hR : s.G tR = .int (2 ^ b) :: LR) (hG : s.G tG = ints (L.map (fun d : ℕ => (d : ℤ))) ++ LG)
    (hP : s.G NLogN.KFT.tP = .int 1 :: LP) :
    IRuns I iprog (rpt tA tC tD L.length c2B) s
      (((s.upd tY (.int (hor b a0 L : ℤ) :: LY)).upd tG LG).upd NLogN.KFT.tP
        (.int ((2 : ℤ) ^ (b * L.length)) :: LP))
      (L.length * (catCost b + shlCost b + 64) + 60 + cRpt L.length) := by
  let T : ℕ → IState HS := fun k =>
    ((s.upd tY (.int (hor b a0 (L.take k) : ℤ) :: LY)).upd tG
      (ints ((L.drop k).map (fun d : ℕ => (d : ℤ))) ++ LG)).upd NLogN.KFT.tP
      (.int ((2 : ℤ) ^ (b * k)) :: LP)
  have h := rpt_runs (I := I) (iprog := iprog) (A := tA) (C := tC) (D := tD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    c2B (catCost b + shlCost b)
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      set a := hor b a0 (L.take k)
      have ha : 1 ≤ a := hor_pos b a0 ha0 _
      set s0 := cf3 (T k) tA tC tD LA LC LD
      have H1 := IRuns.cat (I := I) (iprog := iprog) (s := s0) (i := tY) (j := tR) (k := tG)
        (a := (a : ℤ)) (b := L[k]) (m := b) (Li := LY) (Lj := LR)
        (Lk := ints ((L.drop (k + 1)).map (fun d : ℕ => (d : ℤ))) ++ LG) (by decide) (by decide)
        (by decide) (by omega) (hL _ (List.getElem_mem hk)) (by simp +decide [s0, T, cf3] <;> rfl)
        (by simp +decide [s0, T, cf3, hR])
        (by
          have hg : ints ((L.drop k).map (fun d : ℕ => (d : ℤ))) ++ LG =
              .int (L[k] : ℤ) :: (ints ((L.drop (k + 1)).map (fun d : ℕ => (d : ℤ))) ++ LG) := by
            rw [hd]; rfl
          simp +decide only [s0, T, cf3, IState.upd_G, if_true, if_false, hg])
      rw [sg_nat', Int.natAbs_natCast] at H1
      set s1 := (s0.upd tY (.int ((a * 2 ^ b + L[k] : ℕ) : ℤ) :: LY)).upd tG
        (ints ((L.drop (k + 1)).map (fun d : ℕ => (d : ℤ))) ++ LG)
      have H2 := IRuns.shl (I := I) (iprog := iprog) (s := s1) (i := NLogN.KFT.tP) (j := tR)
        (a := (2 : ℤ) ^ (b * k)) (m := b) (Li := LP) (Lj := LR) (by decide)
        (by simp +decide [s1, s0, T, cf3]) (by simp +decide [s1, s0, T, cf3, hR])
      refine (H1.seq H2).mono' ?_ le_rfl
      have e1 : hor b a0 (L.take (k + 1)) = a * 2 ^ b + L[k] := hor_take_succ b a0 L k hk
      have e2 : (2 : ℤ) ^ (b * k) * 2 ^ b = 2 ^ (b * (k + 1)) := by rw [← pow_add]; ring_nf
      simp only [s1, s0, T, cf3, e1, e2]
      clear H1 H2 e1 e2 hd
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> subst_vars <;> simp_all +decide [ints_append])
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, Nat.mul_zero, pow_zero]
    rw [← hG, ← hP]; simp [hor]; rw [← hY]; simp
  have e1 : T L.length = (((s.upd tY (.int (hor b a0 L : ℤ) :: LY)).upd tG LG).upd NLogN.KFT.tP
        (.int ((2 : ℤ) ^ (b * L.length)) :: LP)) := by
    simp only [T, List.drop_length, List.take_length]; simp
  rw [e0, e1] at h
  exact h

end NLogN.KFT

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
set_option maxHeartbeats 1000000
theorem solution (b B : ℕ) (hb : 1 ≤ b) (zs : List NLogN.KFB.GI) (hre : ∀ z ∈ zs, 0 ≤ z.1)
    (hB : NLogN.KFB.GB B zs) (s : NLogN.IState NLogN.HS) (R0 L1 L2 : List NLogN.Item) (h0 : s.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0)
    (hB2 : s.G NLogN.KFM.uB2 = .int ((2 : ℤ) ^ b) :: L1) (hM : s.G NLogN.KFM.uM = .int (zs.length : ℤ) :: L2) :
    NLogN.IRuns I iprog NLogN.KFM.carIU s (s.upd 0 (.int (NLogN.KFT.carOut b zs : ℤ) :: R0)) (NLogN.KFM.cCarU b B zs.length) := by
  set cs := NLogN.KFT.reN zs
  have hcs : cs.length = zs.length := by simp [cs, NLogN.KFT.reN]
  set ds := (NLogN.KFT.carN b cs 0).1
  set yf := (NLogN.KFT.carN b cs 0).2
  have hcB : ∀ c ∈ cs, c < 2 ^ B := by
    intro c hc
    simp only [cs, NLogN.KFT.reN, List.mem_map] at hc
    obtain ⟨z, hz, rfl⟩ := hc
    have h1 := NLogN.zsz_le_iff.1 (hB z hz).1
    have h3 := hre z hz
    omega
  have hyf : yf < 2 ^ B := NLogN.KFT.carN_carry_lt b B hb cs 0 (by positivity) hcB
  have hdl : ds.length = zs.length := by rw [NLogN.KFT.length_carN, hcs]
  have h1 := NLogN.IRuns.dup (I := I) (iprog := iprog) (s := s) (i := NLogN.KFM.uB2) (j := NLogN.KFT.tR) (a := (2 : ℤ) ^ b)
    (L := L1) (by decide) hB2
  set s1 := s.upd NLogN.KFT.tR (.int (2 ^ b) :: s.G NLogN.KFT.tR)
  have h2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := s1) NLogN.KFT.tY 0
  set s2 := s1.upd NLogN.KFT.tY (.int 0 :: s1.G NLogN.KFT.tY)
  have h3 := NLogN.KFT.c1_runs (I := I) (iprog := iprog) b B hb zs hre hB s2 R0 (s.G NLogN.KFT.tY) (s.G NLogN.KFT.tR) (s2.G NLogN.KFT.tG)
    (by simp +decide [s2, s1, h0]) (by simp +decide [s2, s1]) (by simp +decide [s2, s1])
  have h3 := NLogN.KFM.rptX_of_rpt (by decide) (show s2.G NLogN.KFM.uM = .int (zs.length : ℤ) :: L2 by
    simp +decide [s2, s1, hM]) h3
  set s3 := ((s2.upd 0 R0).upd NLogN.KFT.tY (.int (yf : ℤ) :: s.G NLogN.KFT.tY)).upd NLogN.KFT.tG
    (NLogN.ints ((ds.map (fun d : ℕ => (d : ℤ))).reverse) ++ s2.G NLogN.KFT.tG)
  have h4 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := s3) NLogN.KFT.tP 1
  set s4 := s3.upd NLogN.KFT.tP (.int 1 :: s3.G NLogN.KFT.tP)
  have h5 := NLogN.IRuns.add (I := I) (iprog := iprog) (s := s4) (i := NLogN.KFT.tY) (j := NLogN.KFT.tP) (k := NLogN.KFT.tY)
    (a := (yf : ℤ)) (b := 1) (Li := s.G NLogN.KFT.tY) (Lj := s3.G NLogN.KFT.tP) (by decide)
    (by simp +decide [s4, s3]) (by simp +decide [s4])
  set s5 := ((s4.upd NLogN.KFT.tY (s.G NLogN.KFT.tY)).upd NLogN.KFT.tP (s3.G NLogN.KFT.tP)).upd NLogN.KFT.tY
    (.int ((yf : ℤ) + 1) :: ((s4.upd NLogN.KFT.tY (s.G NLogN.KFT.tY)).upd NLogN.KFT.tP (s3.G NLogN.KFT.tP)).G NLogN.KFT.tY)
  have h6 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := s5) NLogN.KFT.tP 1
  set s6 := s5.upd NLogN.KFT.tP (.int 1 :: s5.G NLogN.KFT.tP)
  have h7 := NLogN.KFT.c2_runs (I := I) (iprog := iprog) b (yf + 1) (by omega) ds.reverse
    (fun d hd => NLogN.KFT.carN_digit_lt b cs 0 d (List.mem_reverse.1 hd)) s6 (s.G NLogN.KFT.tY) (s.G NLogN.KFT.tR) (s.G NLogN.KFT.tG)
    (s.G NLogN.KFT.tP) (by simp +decide [s6, s5, s4, s3, s2, s1]) (by simp +decide [s6, s5, s4, s3, s2, s1])
    (by simp +decide [s6, s5, s4, s3, s2, s1, List.map_reverse])
    (by simp +decide [s6, s5, s4, s3, s2, s1])
  rw [List.length_reverse, NLogN.KFT.hor_rev, hdl] at h7
  have h7 := NLogN.KFM.rptX_of_rpt (by decide) (show s6.G NLogN.KFM.uM = .int (zs.length : ℤ) :: L2 by
    simp +decide [s6, s5, s4, s3, s2, s1, hM]) h7
  set V := (yf + 1) * 2 ^ (b * zs.length) + NLogN.KFT.valN b ds
  set s7 := ((s6.upd NLogN.KFT.tY (.int (V : ℤ) :: s.G NLogN.KFT.tY)).upd NLogN.KFT.tG (s.G NLogN.KFT.tG)).upd NLogN.KFT.tP
    (.int ((2 : ℤ) ^ (b * zs.length)) :: s.G NLogN.KFT.tP)
  have h8 := NLogN.IRuns.neg (I := I) (iprog := iprog) (s := s7) (i := NLogN.KFT.tP)
    (a := (2 : ℤ) ^ (b * zs.length)) (L := s.G NLogN.KFT.tP) (by simp [s7])
  set s8 := s7.upd NLogN.KFT.tP (.int (-(2 : ℤ) ^ (b * zs.length)) :: s.G NLogN.KFT.tP)
  have h9 := NLogN.IRuns.add (I := I) (iprog := iprog) (s := s8) (i := NLogN.KFT.tY) (j := NLogN.KFT.tP) (k := 0)
    (a := (V : ℤ)) (b := -(2 : ℤ) ^ (b * zs.length)) (Li := s.G NLogN.KFT.tY) (Lj := s.G NLogN.KFT.tP) (by decide)
    (by simp +decide [s8, s7]) (by simp [s8])
  set s9 := ((s8.upd NLogN.KFT.tY (s.G NLogN.KFT.tY)).upd NLogN.KFT.tP (s.G NLogN.KFT.tP)).upd 0
    (.int ((V : ℤ) + -(2 : ℤ) ^ (b * zs.length)) :: ((s8.upd NLogN.KFT.tY (s.G NLogN.KFT.tY)).upd NLogN.KFT.tP (s.G NLogN.KFT.tP)).G 0)
  have h10 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := s9) (i := NLogN.KFT.tR) (a := (2 : ℤ) ^ b)
    (L := s.G NLogN.KFT.tR) (by simp +decide [s9, s8, s7, s6, s5, s4, s3, s2, s1])
  have hval : (V : ℤ) + -(2 : ℤ) ^ (b * zs.length) = (NLogN.KFT.carOut b zs : ℤ) := by
    have := NLogN.KFT.carN_val b cs 0
    rw [zero_add, hcs] at this
    simp only [NLogN.KFT.carOut, V]
    rw [show NLogN.KFT.reN zs = cs from rfl, this]
    push_cast; ring
  refine (h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq (h8.seq (h9.seq
    h10))))))))).mono' ?_ ?_
  · simp only [s9, s8, s7, s6, s5, s4, s3, s2, s1]
    rw [hval]
    clear h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 hval hB2 hM
    apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;>
      split_ifs <;> subst_vars <;> simp_all +decide [NLogN.ints_append]
  · have z1 : NLogN.zsz ((2 : ℤ) ^ b) = b + 1 := NLogN.zsz_two_pow b
    have zy : NLogN.zsz (yf : ℤ) ≤ B := NLogN.zsz_le_iff.2 (by simpa using hyf)
    have a1 := NLogN.addIntCost_le (NLogN.zsz (yf : ℤ) + NLogN.zsz (1 : ℤ))
    have zV : NLogN.zsz (V : ℤ) ≤ b * zs.length + B + 1 := by
      apply NLogN.zsz_le_iff.2
      have hv : NLogN.KFT.valN b ds < 2 ^ (b * zs.length) := by
        rw [← hdl]; exact NLogN.KFT.valN_lt b ds (NLogN.KFT.carN_digit_lt b cs 0)
      rw [Int.natAbs_natCast]
      have h2 : (yf + 2) * 2 ^ (b * zs.length) ≤ 2 ^ (B + 1) * 2 ^ (b * zs.length) :=
        Nat.mul_le_mul_right _ (by rw [pow_succ]; omega)
      calc V < (yf + 1) * 2 ^ (b * zs.length) + 2 ^ (b * zs.length) := Nat.add_lt_add_left hv _
        _ = (yf + 2) * 2 ^ (b * zs.length) := by ring
        _ ≤ 2 ^ (B + 1) * 2 ^ (b * zs.length) := h2
        _ = 2 ^ (b * zs.length + B + 1) := by rw [← pow_add]; ring_nf
    have zP : NLogN.zsz (-(2 : ℤ) ^ (b * zs.length)) = b * zs.length + 1 := by
      rw [NLogN.zsz_neg, NLogN.zsz_two_pow]
    have a2 := NLogN.addIntCost_le (NLogN.zsz (V : ℤ) + NLogN.zsz (-(2 : ℤ) ^ (b * zs.length)))
    simp only [z1, NLogN.zsz_zero, NLogN.zsz_one, NLogN.KFM.cCarU, NLogN.KFT.cCar, NLogN.KFM.cCnt] at *
    nlinarith
end
