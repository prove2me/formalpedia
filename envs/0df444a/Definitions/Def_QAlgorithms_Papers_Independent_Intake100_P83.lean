import Mathlib
import Definitions.Def_QAlgorithms_Defs_Gates
import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P21

/-!
# Theory of quantum circuits with Abelian symmetries

Source: I. Marvian, arXiv:2302.12466v3. All page numbers below are PDF pages.
A finite nonempty alphabet is the chosen orthonormal on-site basis; its cardinality is d.
For alphabet Bool the register is definitionally the accepted QAlgorithms.Qubits register.
The phase functions specify the actual diagonal on-site representation; system actions are
its tensor powers. No closure is taken in the finite-product synthesis definitions.
-/

noncomputable section

open scoped BigOperators ComplexConjugate Matrix Kronecker Manifold ContDiff

attribute [local instance] Classical.propDecidable

open QAlgorithms.Papers.Independent.Information100.P21 (Op)

namespace QAlgorithms.Papers.Independent.Intake100.P83

abbrev Words (A : Type*) (n : ℕ) := Fin n → A

variable {A G : Type*} [Fintype A] [DecidableEq A]

/-- PDF p.6: the diagonal entries are unit-modulus characters of the same group. -/
def IsOnsite [Monoid G] (chi : A → G → ℂ) : Prop :=
  ∀ a, chi a 1 = 1 ∧ (∀ g h, chi a (g * h) = chi a g * chi a h) ∧
    ∀ g, ‖chi a g‖ = 1

/-- PDF pp.4,6: the character of an actual product basis vector, including the empty product. -/
def productCharacter (chi : A → G → ℂ) {n : ℕ} (r : Words A n) : G → ℂ :=
  fun g => ∏ j, chi (r j) g

/-- PDF p.4: the actual system representation u(g) tensor n in the chosen product basis. -/
def productSymmetryMatrix (chi : A → G → ℂ) (n : ℕ) (g : G) : Op (Words A n) :=
  Matrix.diagonal fun r => productCharacter chi r g

/-- PDF p.20: only characters actually occurring in this tensor power are counted. -/
def charges (chi : A → G → ℂ) (n : ℕ) : Finset (G → ℂ) := by
  classical
  exact Finset.univ.image (fun r : Words A n => productCharacter chi r)

/-- PDF p.20: the number of distinct occurring characters, not the number of basis strings. -/
def chargeCount (chi : A → G → ℂ) (n : ℕ) : ℕ := (charges chi n).card

/-- PDF p.4: embedding on any ordered list of distinct named sites, with identity outside it. -/
def embedOnSites {l n : ℕ} (f : Fin l ↪ Fin n) (B : Op (Words A l)) : Op (Words A n) := by
  classical
  exact fun r s =>
    if ∀ j, j ∉ Set.range f → r j = s j then B (r ∘ f) (s ∘ f) else 0

/-- PDF p.4: acts on at most k sites; zero-site scalar operators are allowed. -/
def IsSupportedOnAtMost {n : ℕ} (k : ℕ) (B : Op (Words A n)) : Prop :=
  ∃ l, l ≤ k ∧ ∃ f : Fin l ↪ Fin n, ∃ C : Op (Words A l), B = embedOnSites f C

/-- PDF p.4: symmetry means commutation with the specified tensor-power action at every g. -/
def CommutesWithSymmetry (chi : A → G → ℂ) {n : ℕ} (B : Op (Words A n)) : Prop :=
  ∀ g, B * productSymmetryMatrix chi n g = productSymmetryMatrix chi n g * B

/-- PDF p.4: exact finite products in temporal order; the empty word gives identity. -/
def finiteGateProducts {n : ℕ} (S : Set (Op (Words A n))) : Set (Op (Words A n)) :=
  {B | ∃ L : List (Op (Words A n)), (∀ C ∈ L, C ∈ S) ∧ L.reverse.prod = B}

/-- PDF p.4: the actual group generated by individually invariant local unitary gates. -/
def symmetricLocalGroup (chi : A → G → ℂ) (n k : ℕ) : Set (Op (Words A n)) :=
  finiteGateProducts {B | B ∈ Matrix.unitaryGroup (Words A n) ℂ ∧ IsSupportedOnAtMost k B ∧ CommutesWithSymmetry chi B}

/-- PDF pp.5,19: the derived subgroup, generated by actual multiplicative commutators. -/
def derived {n : ℕ} (V : Set (Op (Words A n))) : Set (Op (Words A n)) :=
  finiteGateProducts {C | ∃ U ∈ V, ∃ W ∈ V, C = U * W * U.conjTranspose * W.conjTranspose}

/-- PDF p.6 Eq.(6): the full complex operator commutant. -/
def symmetricCircuitCommutant {n : ℕ} (V : Set (Op (Words A n))) : Submodule ℂ (Op (Words A n)) where
  carrier := {B | ∀ U ∈ V, B * U = U * B}
  zero_mem' := by simp
  add_mem' := by
    intro B C hB hC U hU
    simp only [Matrix.add_mul, Matrix.mul_add, hB U hU, hC U hU]
  smul_mem' := by
    intro z B hB U hU
    simp only [Matrix.smul_mul, Matrix.mul_smul, hB U hU]

/-- PDF pp.5,6: block-diagonality for a relation on the physical product basis. -/
def blockPreservingUnitaries {n : ℕ} (R : Words A n → Words A n → Prop) : Set (Op (Words A n)) :=
  {U | U ∈ Matrix.unitaryGroup (Words A n) ℂ ∧ ∀ r s, ¬ R r s → U r s = 0}

/-- PDF pp.5,6: determinant one independently on every whole physical block.
Representatives may repeat a block; each determinant is taken on its full support. -/
def blockSpecial {n : ℕ} (R : Words A n → Words A n → Prop) : Set (Op (Words A n)) := by
  classical
  exact {U | U ∈ blockPreservingUnitaries R ∧ ∀ r,
    Matrix.det (U.submatrix (fun s : {s // R r s} => s.val)
      (fun s : {s // R r s} => s.val)) = 1}

/-- PDF p.6: equal charge means equality of complete character functions on all G. -/
def sameCharge (chi : A → G → ℂ) (n : ℕ) (r s : Words A n) : Prop :=
  productCharacter chi r = productCharacter chi s

/-- PDF p.5 Eq.(5): every independent charge-block special unitary is realizable. -/
def SemiUniversal (chi : A → G → ℂ) (n k : ℕ) : Prop :=
  blockSpecial (sameCharge chi n) ⊆ symmetricLocalGroup chi n k

/-- PDF p.6 Eq.(6), including the fixed second equality with the representation span. -/
def NoExtra (chi : A → G → ℂ) (n k : ℕ) : Prop :=
  symmetricCircuitCommutant (symmetricLocalGroup chi n k) = symmetricCircuitCommutant (symmetricLocalGroup chi n n) ∧
  symmetricCircuitCommutant (symmetricLocalGroup chi n n) = Submodule.span ℂ (Set.range (productSymmetryMatrix chi n))

/-- PDF p.6 Eq.(7): dimension of the complex commutant. -/
def CommDimension (chi : A → G → ℂ) (n k : ℕ) : Prop :=
  Module.finrank ℂ (symmetricCircuitCommutant (symmetricLocalGroup chi n k)) = chargeCount chi n

/-- PDF pp.7,12: a finite path with both endpoints, allowing a one-vertex path. -/
def basisPath {n : ℕ} (k : ℕ) (C : Words A n → Prop) (r s : Words A n) : Prop :=
  ∃ m : ℕ, ∃ v : Fin (m + 1) → Words A n,
    v 0 = r ∧ v (Fin.last m) = s ∧ (∀ j, C (v j)) ∧
    ∀ j : Fin m, hammingDist (v j.castSucc) (v j.succ) ≤ k

/-- PDF p.7 Theorem 2 prime, condition 3. -/
def TransitiveCharges (chi : A → G → ℂ) (n k : ℕ) : Prop :=
  ∀ r s : Words A n, sameCharge chi n r s →
    basisPath k (fun t => sameCharge chi n r t) r s

/-- PDF p.12 Eq.(28): canonical joint-eigenspace relation of the actual commutant.
This is defined from the generated group, not from the desired basis paths. -/
def component (chi : A → G → ℂ) (n k : ℕ) (r s : Words A n) : Prop :=
  ∀ B ∈ symmetricCircuitCommutant (symmetricLocalGroup chi n k), B r r = B s s

/-- PDF p.12: the full physical span of one commutant-defined basis block. -/
def componentSpace (chi : A → G → ℂ) (n k : ℕ) (r : Words A n) :
    Submodule ℂ (EuclideanSpace ℂ (Words A n)) :=
  Submodule.span ℂ {v | ∃ s, component chi n k r s ∧ v = QAlgorithms.ket s}

/-- PDF p.12: invariance under every actually generated unitary. -/
def InvariantSpace {n : ℕ} (V : Set (Op (Words A n)))
    (S : Submodule ℂ (EuclideanSpace ℂ (Words A n))) : Prop :=
  ∀ U ∈ V, ∀ v ∈ S, QAlgorithms.act U v ∈ S

/-- PDF pp.6,12: completeness, orthogonality, charge refinement and actual irreducibility. -/
def ComponentDecomposition (chi : A → G → ℂ) (n k : ℕ) : Prop :=
  Equivalence (component chi n k) ∧
  (⨆ r, componentSpace chi n k r) = ⊤ ∧
  (∀ r s, ¬ component chi n k r s →
    ∀ v ∈ componentSpace chi n k r, ∀ w ∈ componentSpace chi n k s,
      inner ℂ v w = 0) ∧
  (∀ r s, component chi n k r s → sameCharge chi n r s) ∧
  ∀ r, componentSpace chi n k r ≠ ⊥ ∧
    InvariantSpace (symmetricLocalGroup chi n k) (componentSpace chi n k r) ∧
    ∀ S : Submodule ℂ (EuclideanSpace ℂ (Words A n)),
      S ≤ componentSpace chi n k r → InvariantSpace (symmetricLocalGroup chi n k) S →
        S = ⊥ ∨ S = componentSpace chi n k r

/-- PDF p.7 Eq.(13): the least positive reservoir length attaining the n-site charge count.
For n positive the defining set contains n; no default infimum is used in a theorem. -/
def reservoirLength (chi : A → G → ℂ) (n : ℕ) : ℕ :=
  sInf {l : ℕ | 0 < l ∧ chargeCount chi l = chargeCount chi n}

/-- PDF p.7: left regular action, |h> maps to |g h>. -/
def leftRegularPermutationMatrix [Group G] [DecidableEq G] (g : G) : Matrix G G ℂ :=
  fun h j => if h = g * j then 1 else 0

/-- PDF p.7: the chosen diagonal representation is unitarily equivalent to the regular one. -/
def IsRegularOnsiteRepresentation [Group G] [Fintype G] [DecidableEq G] (chi : A → G → ℂ) : Prop :=
  ∃ T : Matrix A G ℂ, T * T.conjTranspose = 1 ∧ T.conjTranspose * T = 1 ∧
    ∀ g, Matrix.diagonal (fun a => chi a g) * T = T * leftRegularPermutationMatrix g

/-- PDF pp.7,18: the actual trace character of one qudit. -/
def traceCharacter (chi : A → G → ℂ) : G → ℂ := fun g => ∑ a, chi a g

/-- PDF pp.19-20: real span of the complete functions r^(n-k) f_mu on all G. -/
def localChargeSpan (chi : A → G → ℂ) (n k : ℕ) : Submodule ℝ (G → ℂ) :=
  Submodule.span ℝ {f | ∃ c ∈ charges chi k,
    f = fun g => traceCharacter chi g ^ (n - k) * c g}

/-- PDF p.19: the actual Lie algebra, characterized by one-parameter subgroups.
Its real linear span is used, never a freely supplied Lie-algebra dimension. -/
def lieSpace {n : ℕ} (V : Set (Op (Words A n))) : Submodule ℝ (Op (Words A n)) :=
  Submodule.span ℝ {B | B.conjTranspose = -B ∧
    ∀ t : ℝ, NormedSpace.exp (t • B) ∈ V}

/-- PDF p.19: real Lie dimension of the actual generated subgroup. -/
def groupDimension {n : ℕ} (V : Set (Op (Words A n))) : ℕ := Module.finrank ℝ (lieSpace V)

/-- PDF p.18: a compact finite-dimensional real Lie group, with its actual topology. -/
def CompactLie (G : Type*) [Group G] [TopologicalSpace G] : Prop :=
  CompactSpace G ∧ T2Space G ∧
  ∃ m : ℕ, ∃ atlas : ChartedSpace (EuclideanSpace ℝ (Fin m)) G,
    letI := atlas
    IsManifold (𝓘(ℝ, EuclideanSpace ℝ (Fin m))) ∞ G ∧
      LieGroup (𝓘(ℝ, EuclideanSpace ℝ (Fin m))) ∞ G

/-- PDF pp.5,8: the specified Z_p qubit representation, on its actual residues.
Only the values are needed to define commutation; no abstract charge labels are supplied. -/
def cyclicPhases (p : ℕ) : Bool → ZMod p → ℂ :=
  fun b a => if b then Complex.exp (Complex.I * (2 * Real.pi * (a.val : ℝ) / p)) else 1

/-- PDF p.7: diag(1,z) for z on the unit circle, equivalent for invariance to z rotations. -/
def excitationPhases : Bool → Circle → ℂ := fun b z => if b then (z : ℂ) else 1

/-- PDF p.8: total Z_p charge is excitation number modulo p. -/
def residueCharge (p : ℕ) {n : ℕ} (r : Words Bool n) : ZMod p :=
  (QAlgorithms.hammingWeight r : ZMod p)

/-- PDF p.13: the dyad |r><s| on the complete physical Hilbert space. -/
def basisMatrixUnit {n : ℕ} (r s : Words A n) : Op (Words A n) := by
  classical
  exact fun a b => if a = r ∧ b = s then 1 else 0

/-- PDF p.13: the two-level X operator, zero on every other basis vector. -/
def twoX {n : ℕ} (r s : Words A n) : Op (Words A n) := basisMatrixUnit r s + basisMatrixUnit s r

/-- PDF p.13: the paper's Y has +i on |r><s|, hence is minus the usual ordered Pauli Y. -/
def twoY {n : ℕ} (r s : Words A n) : Op (Words A n) := Complex.I • (basisMatrixUnit r s - basisMatrixUnit s r)

/-- PDF p.13: Z = (i/2)[X,Y] = |r><r| - |s><s|. -/
def twoZ {n : ℕ} (r s : Words A n) : Op (Words A n) := basisMatrixUnit r r - basisMatrixUnit s s

/-- PDF pp.8,13: the source's positive-sign exponential exp(i theta H). -/
def positiveImaginaryEvolution {n : ℕ} (H : Op (Words A n)) (theta : ℝ) : Op (Words A n) :=
  NormedSpace.exp ((Complex.I * (theta : ℂ)) • H)

/-- PDF p.8: a redistribution dyad on at most k qudits, with its actual local basis labels. -/
structure RedistributionTransition (A : Type*) (k : ℕ) where
  arity : ℕ
  bound : arity ≤ k
  left : Words A arity
  right : Words A arity

/-- PDF p.8 Eq.(18): allowed embeddings of the Hermitian partial swaps, not permutation swaps. -/
def transitionOps {k : ℕ} (R : Set (RedistributionTransition A k)) (n : ℕ) : Set (Op (Words A n)) :=
  {B | ∃ t ∈ R, ∃ f : Fin t.arity ↪ Fin n, B = embedOnSites f (twoX t.left t.right)}

/-- PDF p.8: R is invariant and acts transitively at the stated k-site scale. -/
def Redistributes (chi : A → G → ℂ) (k : ℕ) (R : Set (RedistributionTransition A k)) : Prop :=
  (∀ t ∈ R, CommutesWithSymmetry chi (twoX t.left t.right)) ∧
  ∀ r s : Words A k, sameCharge chi k r s →
    ∃ L : List (Op (Words A k)), (∀ B ∈ L, B ∈ transitionOps R k) ∧
      QAlgorithms.act L.reverse.prod (QAlgorithms.ket r) = QAlgorithms.ket s

/-- PDF pp.8,14: all named-site two-qudit controlled phases from Eq.(37). -/
def czFamily (A : Type*) [Fintype A] [DecidableEq A] (n : ℕ) : Set (Op (Words A n)) :=
  {B | ∃ f : Fin 2 ↪ Fin n, ∃ r : Words A 2,
    B = embedOnSites f (1 - (2 : ℂ) • basisMatrixUnit r r)}

/-- PDF p.8: the fixed pi/2 phase on each on-site basis vector, on every site. -/
def phaseFamily (A : Type*) [Fintype A] [DecidableEq A] (n : ℕ) : Set (Op (Words A n)) :=
  {B | ∃ f : Fin 1 ↪ Fin n, ∃ a : A,
    B = embedOnSites f (positiveImaginaryEvolution (basisMatrixUnit (fun _ => a) (fun _ => a)) (Real.pi / 2))}

/-- PDF p.8 Corollary 5: exactly the three stated gate families. -/
def synthesisFamily {k : ℕ} (R : Set (RedistributionTransition A k)) (n : ℕ) : Set (Op (Words A n)) :=
  phaseFamily A n ∪ czFamily A n ∪
    {B | ∃ t ∈ R, ∃ f : Fin t.arity ↪ Fin n, ∃ theta ∈ Set.Ico (0 : ℝ) (2 * Real.pi),
      B = embedOnSites f (positiveImaginaryEvolution (twoX t.left t.right) theta)}

/-- PDF p.9: a one-qubit matrix expressed on the one-site register, without changing bit order. -/
def liftOneQubitMatrix (B : Matrix Bool Bool ℂ) : Op (Words Bool 1) := fun r s => B (r 0) (s 0)

/-- PDF p.9: a two-qubit matrix on the first and second named local sites. -/
def twoSite (B : Matrix (Bool × Bool) (Bool × Bool) ℂ) : Op (Words Bool 2) :=
  fun r s => B (r 0, r 1) (s 0, s 1)

/-- PDF pp.8-9: S on every named site, reusing the accepted phaseS matrix. -/
def sFamily (n : ℕ) : Set (Op (Words Bool n)) :=
  {B | ∃ f : Fin 1 ↪ Fin n, B = embedOnSites f (liftOneQubitMatrix QAlgorithms.phaseS)}

/-- PDF p.9: the CZ gate on each pair of distinct sites. -/
def standardCZFamily (n : ℕ) : Set (Op (Words Bool n)) :=
  {B | ∃ f : Fin 2 ↪ Fin n, B = embedOnSites f
    (1 - (2 : ℂ) • basisMatrixUnit (fun _ => true) (fun _ => true))}

/-- PDF p.9: continuous rotations of H on every embedding of its local sites. -/
def rotationFamily {l : ℕ} (H : Op (Words Bool l)) (n : ℕ) : Set (Op (Words Bool n)) :=
  {B | ∃ f : Fin l ↪ Fin n, ∃ theta ∈ Set.Ico (0 : ℝ) (2 * Real.pi),
    B = embedOnSites f (positiveImaginaryEvolution H theta)}

/-- PDF p.9 Eq.(20): the full XX+YY generator, retaining the source's angular convention. -/
def exchangeHamiltonian : Op (Words Bool 2) :=
  twoSite (QAlgorithms.pauliX ⊗ₖ QAlgorithms.pauliX + QAlgorithms.pauliY ⊗ₖ QAlgorithms.pauliY)

/-- PDF p.9: the explicit U(1) synthesis family, including all four gates of Eq.(19). -/
def excitationFamily (n : ℕ) : Set (Op (Words Bool n)) :=
  sFamily n ∪ czFamily Bool n ∪ rotationFamily exchangeHamiltonian n

/-- PDF p.9: add the simultaneous flip of p excitations, on any p named sites. -/
def cyclicSynthesisGates (p n : ℕ) : Set (Op (Words Bool n)) :=
  excitationFamily n ∪ rotationFamily (twoX (fun _ : Fin p => false) (fun _ => true)) n

/-- PDF p.9 Corollary 6: XX rotations, S, and all four controlled phases of Eq.(19). -/
def parityFamily (n : ℕ) : Set (Op (Words Bool n)) :=
  sFamily n ∪ czFamily Bool n ∪
    rotationFamily (twoSite (QAlgorithms.pauliX ⊗ₖ QAlgorithms.pauliX)) n

/-- PDF p.9: an arbitrary normalized on-site state supported in one actually occurring charge. -/
def DefiniteCharge (chi : A → G → ℂ) (a : EuclideanSpace ℂ A) : Prop :=
  ∃ j : A, ∀ i, a i ≠ 0 → chi i = chi j

/-- PDF pp.9-10: system tensor ancilla, the ancilla is the final wire. -/
def appendAncilla {n : ℕ} (v : EuclideanSpace ℂ (Words A n)) (a : EuclideanSpace ℂ A) :
    EuclideanSpace ℂ (Words A (n + 1)) :=
  WithLp.toLp 2 (fun r => v (fun j => r j.castSucc) * a (r (Fin.last n)))

/-- PDF pp.9-10: exact returned-ancilla implementation, uniformly for every system vector. -/
def ImplementsWithAncilla (chi : A → G → ℂ) (n k : ℕ)
    (a : EuclideanSpace ℂ A) (V : Op (Words A n)) : Prop :=
  ∃ W ∈ symmetricLocalGroup chi (n + 1) k, ∀ v : EuclideanSpace ℂ (Words A n),
    QAlgorithms.act W (appendAncilla v a) = appendAncilla (QAlgorithms.act V v) a

/-- PDF p.20: divide by an actually occurring on-site character; invariant operators are unchanged. -/
def divideByOnsiteCharacter (chi : A → G → ℂ) (a : A) : A → G → ℂ :=
  fun b g => chi b g / chi a g

/-- PDF p.20: pointwise products of two finite sets of complete characters. -/
def characterProducts (S T : Finset (G → ℂ)) : Finset (G → ℂ) := by
  classical
  exact (S.product T).image (fun p => fun g => p.1 g * p.2 g)

/-! Sanity examples pin non-tautological boundaries and the finite-product convention.
They are definition checks, not proofs of the paper's targets. -/

example {n : ℕ} (S : Set (Op (Words A n))) : (1 : Op (Words A n)) ∈ finiteGateProducts S := by
  exact ⟨[], by simp, by simp⟩

example (chi : A → G → ℂ) (r : Words A 0) (g : G) : productCharacter chi r g = 1 := by
  simp [productCharacter]

example {n : ℕ} (r : Words A n) : hammingDist r r = 0 := by
  exact hammingDist_self r

example {n : ℕ} (k : ℕ) (r : Words A n) : basisPath k (fun _ => True) r r := by
  refine ⟨0, fun _ => r, rfl, rfl, ?_, ?_⟩
  · intro j; trivial
  · intro j; exact Fin.elim0 j

example {n : ℕ} (r s : Words A n) : basisMatrixUnit r s r s = 1 := by
  simp [basisMatrixUnit]

example [Group G] [DecidableEq G] (g h : G) : leftRegularPermutationMatrix g (g * h) h = 1 := by
  simp [leftRegularPermutationMatrix]

example : liftOneQubitMatrix QAlgorithms.phaseS (fun _ => true) (fun _ => true) = Complex.I := by
  simp [liftOneQubitMatrix, QAlgorithms.phaseS]

/-- PDF p.9 Eq.(22): tensor-product Pauli Z, with its standard computational-basis sign. -/
def parityZ (n : ℕ) : Op (Words Bool n) :=
  Matrix.diagonal fun r => (-1 : ℂ) ^ QAlgorithms.hammingWeight r

/-- PDF p.9 Eq.(23): determinant on the entire even or odd physical sector. -/
def parityDet {n : ℕ} (V : Op (Words Bool n)) (b : Bool) : ℂ := by
  classical
  let support := {r : Words Bool n // QAlgorithms.hammingWeight r % 2 = if b then 1 else 0}
  exact Matrix.det (V.submatrix (fun r : support => r.val) (fun r : support => r.val))

/-- PDF pp.4,11: exact control by finite concatenations of local symmetric Hamiltonian pulses. -/
def controlGroup (chi : A → G → ℂ) (n k : ℕ) : Set (Op (Words A n)) :=
  finiteGateProducts {U | ∃ H : Op (Words A n), H.IsHermitian ∧ IsSupportedOnAtMost k H ∧ CommutesWithSymmetry chi H ∧
    ∃ theta : ℝ, U = positiveImaginaryEvolution H theta}

end QAlgorithms.Papers.Independent.Intake100.P83


