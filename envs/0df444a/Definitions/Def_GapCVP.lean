      flatAdjacentRecordConfiguration 0 input [] [] [] := by
  simp [actualFlatAdjacentRecordSwapMachine,
    Turing.initList, flatAdjacentRecordConfiguration]
  congr 1
  funext stack
  fin_cases stack <;> simp
