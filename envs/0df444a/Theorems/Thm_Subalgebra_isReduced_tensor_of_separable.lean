-- title:
--   Reducedness of k ⊗_Λ A from separable reduction
-- statement:
--   Let $\Lambda$ be a principal ideal domain and $p \in \Lambda$ irreducible, let $K$ be a field which is a $\Lambda$-algebra, and let $R \subseteq A$ be $\Lambda$-subalgebras of $K$ together with a $\Lambda$-algebra isomorphism $\Lambda[X] \cong R$, such that every element of $A$ is integral over $R$ as an element of $K$, $A$ is a Noetherian ring and $A$ is integrally closed. Let $O$ be a discrete valuation domain equipped with an $R$-algebra structure and a map to $K$ compatible with $R \to K$, with $O \to K$ injective, such that the image $\varpi$ of $p$ in $O$ is irreducible and such that every $x \in O$ satisfies $s x = r$ in $O$ for some $r \in R$ and some $s \in R$ outside the ideal generated by the image of $p$ in $R$ (so $O$ lies in the localisation of $R$ away from $p$). Let $\alpha \in K$ be integral over $O$ such that $s\alpha \in A$ for some such $s$, such that the reduction of $\operatorname{minpoly}_O(\alpha)$ modulo $(\varpi)$ is separable, and such that for every $x \in K$ one has $\varpi^n x \in O[\alpha]$ for some $n \in \mathbb{N}$. Finally let $F_0$ be a field which is a $\Lambda$-algebra with $\Lambda \to F_0$ surjective of kernel $(p)$, and let $k$ be a field which is an $F_0$-algebra and a $\Lambda$-algebra compatibly. Then the ring $k \otimes_\Lambda A$ is reduced.
--
--   This is the geometric (separable, rather than merely squarefree) form of a reducedness criterion for the fibre at $p$ of a normal $\Lambda[X]$-algebra $A$, obtained from Dedekind's criterion at the Gauss valuation $O$: the special fibre embeds into $O[\alpha]/(\varpi)$, and base change to an arbitrary field $k$ over $F_0 = \Lambda/(p)$ preserves reducedness because the relevant residue algebra is a domain. It is applied to the finite and infinite charts of the Igusa scheme, in [`ModularCurve.IgusaScheme.isReduced_chartAlgFin_tensor`](thm.html#ModularCurve.IgusaScheme.isReduced_chartAlgFin_tensor) and [`ModularCurve.IgusaScheme.isReduced_chartAlgInf_tensor`](thm.html#ModularCurve.IgusaScheme.isReduced_chartAlgInf_tensor).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Subalgebra_isReduced_tensor_of_separable.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open Polynomial
open scoped TensorProduct

universe u

theorem Subalgebra.isReduced_tensor_of_separable
    {Λ K O F₀ : Type u} [CommRing Λ] [IsDomain Λ] [IsPrincipalIdealRing Λ] {p : Λ} (hp : Irreducible p)
    [Field K] [Algebra Λ K] (R A : Subalgebra Λ K) (e : Λ[X] ≃ₐ[Λ] R) (hRA : R ≤ A)
    (hint : ∀ a : A, IsIntegral R (a : K)) [IsNoetherianRing A] (hIC : IsIntegrallyClosed A)
    [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [Algebra R O] [Algebra O K] [IsScalarTower R O K] [FaithfulSMul O K]
    (hpO : Irreducible (algebraMap R O (algebraMap Λ R p)))
    (hO : ∀ x : O, ∃ s ∉ Ideal.span {algebraMap Λ R p}, ∃ r : R,
      algebraMap R O r = algebraMap R O s * x)
    {α : K} (hα : IsIntegral O α)
    (hαA : ∃ s ∉ Ideal.span {algebraMap Λ R p}, (s : K) * α ∈ A)
    (hsep : ((minpoly O α).map (Ideal.Quotient.mk
      (Ideal.span {algebraMap R O (algebraMap Λ R p)}))).Separable)
    (hgen : ∀ x : K, ∃ n : ℕ,
      algebraMap O K (algebraMap R O (algebraMap Λ R p)) ^ n * x ∈ Algebra.adjoin O {α})
    [Field F₀] [Algebra Λ F₀] (hs : Function.Surjective (algebraMap Λ F₀))
    (hker : RingHom.ker (algebraMap Λ F₀) = Ideal.span {p})
    (k : Type u) [Field k] [Algebra Λ k] [Algebra F₀ k] [IsScalarTower Λ F₀ k] :
    IsReduced (k ⊗[Λ] A) := by sorry
