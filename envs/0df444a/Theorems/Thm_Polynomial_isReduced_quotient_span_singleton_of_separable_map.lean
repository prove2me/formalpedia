open Polynomial

theorem Polynomial.isReduced_quotient_span_singleton_of_separable_map
    {D : Type*} [CommRing D] [IsDomain D] {g : D[X]} (hg : g.Monic)
    (hsep : (g.map (algebraMap D (FractionRing D))).Separable) :
    IsReduced (D[X] ⧸ Ideal.span {g}) := by sorry
