open IsDedekindDomain NumberField NumberField.Idele MeasureTheory
open scoped NNReal ENNReal

attribute [local instance] ideleBorel borelSpace_ideleBorel

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
variable [∀ v : HeightOneSpectrum (𝓞 ℚ), MeasurableSpace (v.adicCompletion ℚ)ˣ]
  [MeasurableSpace (InfiniteAdeleRing ℚ)ˣ]
variable (μ : ∀ v : HeightOneSpectrum (𝓞 ℚ), Measure (v.adicCompletion ℚ)ˣ) (μArch : Measure (InfiniteAdeleRing ℚ)ˣ)

private theorem torusMeasure_nnreal_smul_arch [SFinite μArch] (r : ℝ≥0) :
    torusMeasure T μ (r • μArch) = r • torusMeasure T μ μArch := by
  unfold torusMeasure
  rw [← Measure.coe_nnreal_smul, Measure.prod_smul_right, Measure.coe_nnreal_smul]

private theorem sPartMeasure_eq_map_torusMeasure_nnreal_smul [μArch.IsHaarMeasure] {r : ℝ≥0}
    (h : sPartMeasure ℚ T = r • Measure.map (embHom T) (torusMeasure T μ μArch)) :
    sPartMeasure ℚ T = Measure.map (embHom T) (torusMeasure T μ (r • μArch)) := by
  haveI := UnitsBorel.sigmaFinite_of_isHaarMeasure_units_infiniteAdeleRing μArch
  rw [torusMeasure_nnreal_smul_arch T μ μArch r, Measure.map_smul]
  exact h

end LanglandsTunnell.CubicInduction.TPart
