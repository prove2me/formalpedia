theorem span_stable :
    ∀ τ ∈ rationalHeckeAlgebra 2 J, ∀ v ∈ Submodule.span ℚ_[2] ((ι J) '' (lam I E : Set T)),
      (τ : Module.End ℚ_[2] V) v ∈ Submodule.span ℚ_[2] ((ι J) '' (lam I E : Set T)) := by
  intro τ hτ
  refine Algebra.adjoin_induction (hx := hτ) ?_ ?_ ?_ ?_
  · rintro _ ⟨t, rfl⟩ v hv
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
    · rintro _ ⟨s, hs, rfl⟩
      exact Submodule.subset_span ⟨_, tateHeckeRep_mem_lam I E hE t hs, (rationalHeckeRep_tmul _ _ _ _ _).symm⟩
    · simp
    · intro v w _ _ hv hw; rw [map_add]; exact add_mem hv hw
    · intro a v _ hv; rw [map_smul]; exact Submodule.smul_mem _ a hv
  · intro a v hv
    rw [Module.algebraMap_end_apply]; exact Submodule.smul_mem _ a hv
  · intro α β _ _ hα hβ v hv; rw [LinearMap.add_apply]; exact add_mem (hα v hv) (hβ v hv)
  · intro α β _ _ hα hβ v hv; rw [Module.End.mul_apply]; exact hα _ (hβ v hv)

noncomputable def N : Submodule ↥(rationalHeckeAlgebra 2 J) V where
  carrier := Submodule.span ℚ_[2] ((ι J) '' (lam I E : Set T))
  add_mem' := add_mem
  zero_mem' := zero_mem _
  smul_mem' τ v hv := span_stable I E hE τ τ.2 v hv

theorem mem_N_iff (v : V) : v ∈ N I E hE ↔ v ∈ Submodule.span ℚ_[2] ((ι J) '' (lam I E : Set T)) := Iff.rfl

theorem N_eq_span : N I E hE = Submodule.span ↥(rationalHeckeAlgebra 2 J) ((ι J) '' (lam I E : Set T)) := by
  apply le_antisymm
  · intro v hv
    rw [mem_N_iff] at hv
    refine Submodule.span_induction (fun v hv => Submodule.subset_span hv) (zero_mem _)
      (fun _ _ _ _ h h' => add_mem h h') (fun a v _ h => ?_) hv
    rw [← algebraMap_smul (A := ↥(rationalHeckeAlgebra 2 J))]
    exact Submodule.smul_mem _ _ h
  · exact Submodule.span_le.mpr fun v hv => Submodule.subset_span hv

theorem N_isotropic (Bf : T →ₗ[ℤ_[2]] T →ₗ[ℤ_[2]] ℤ_[2]) (hISO : ∀ s ∈ lam I E, ∀ s' ∈ lam I E, Bf s s' = 0) :
    ∀ v ∈ N I E hE, ∀ w ∈ N I E hE, BQ J Bf v w = 0 := by
  intro v hv w hw
  rw [mem_N_iff] at hv hw
  refine Submodule.span_induction ?_ (by simp) (fun v v' _ _ h h' => by rw [map_add, LinearMap.add_apply, h, h', add_zero])
    (fun a v _ h => by rw [map_smul, LinearMap.smul_apply, h, smul_zero]) hv
  rintro _ ⟨s, hs, rfl⟩
  refine Submodule.span_induction ?_ (by simp) (fun w w' _ _ h h' => by rw [map_add, h, h', add_zero])
    (fun a w _ h => by rw [map_smul, h, smul_zero]) hw
  rintro _ ⟨s', hs', rfl⟩
  show BQ J Bf ((1 : ℚ_[2]) ⊗ₜ s) ((1 : ℚ_[2]) ⊗ₜ s') = 0
  rw [BQ_tmul, hISO s hs s' hs', zero_smul]

theorem baseChange_smul_end (a : ℤ_[2]) (f : Module.End ℤ_[2] T) :
