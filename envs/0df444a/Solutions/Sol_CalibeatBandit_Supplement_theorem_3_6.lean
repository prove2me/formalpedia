namespace CalibeatBandit

private theorem sum_mulVec_stochastic {K : ℕ} {M : Matrix (Fin K) (Fin K) ℝ}
    (hM : IsColStochastic M) (x : Fin K → ℝ) :
    ∑ i, (M *ᵥ x) i = ∑ i, x i :=
  Matrix.sum_mulVec_of_mem_colStochastic <|
    Matrix.mem_colStochastic_iff_sum.mpr ⟨fun i j => (hM j).1 i, fun j => (hM j).2⟩

/-- The affine fixed point used by the algorithm is a probability vector when
the weight on swap regret is strictly less than one. -/
theorem fixedPointSol_spec {K : ℕ} (lam : ℝ) (hlam : 0 ≤ lam) (hlt : lam < 1)
    (MSR MRec : Matrix (Fin K) (Fin K) ℝ) (hSR : IsColStochastic MSR)
    (hRec : IsColStochastic MRec) (J : Fin K) :
    IsProbVec (fixedPointSol lam MSR MRec J) ∧
      (1 - lam • MSR) *ᵥ fixedPointSol lam MSR MRec J =
        (1 - lam) • (MRec *ᵥ Pi.single J 1) := by
  let A : Matrix (Fin K) (Fin K) ℝ := 1 - lam • MSR
  have affine (x b : Fin K → ℝ) (heq : A *ᵥ x = b) (i : Fin K) :
      x i = lam * (MSR *ᵥ x) i + b i := by
    have hi := congrFun heq i
    simp only [A, sub_mulVec, one_mulVec, smul_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] at hi
    linarith
  have neg_contraction (x b : Fin K → ℝ) (heq : A *ᵥ x = b) (hb : ∀ i, 0 ≤ b i) :
      ∀ i, 0 ≤ x i := by
    let n : Fin K → ℝ := fun i => max (-x i) 0
    have hn (i : Fin K) : 0 ≤ n i := le_max_right _ _
    have hMn (i : Fin K) : 0 ≤ (MSR *ᵥ n) i := by
      change 0 ≤ ∑ j, MSR i j * n j
      exact Finset.sum_nonneg fun j _ => mul_nonneg ((hSR j).1 i) (hn j)
    have hdom (i : Fin K) : n i ≤ lam * (MSR *ᵥ n) i := by
      apply max_le
      · have hsum : -(MSR *ᵥ x) i ≤ (MSR *ᵥ n) i := by
          simp only [mulVec, dotProduct, ← Finset.sum_neg_distrib, ← mul_neg]
          exact Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_left
            (le_max_left (-x j) 0) ((hSR j).1 i)
        linarith [affine x b heq i, hb i, mul_le_mul_of_nonneg_left hsum hlam]
      · exact mul_nonneg hlam (hMn i)
    have htotal : ∑ i, n i ≤ lam * ∑ i, n i := by
      simpa only [← Finset.mul_sum, sum_mulVec_stochastic hSR n] using
        (Finset.sum_le_sum (s := Finset.univ) fun i _ => hdom i)
    have hzero : ∑ i, n i = 0 := by
      by_contra! h
      have hpos : 0 < ∑ i, n i := lt_of_le_of_ne (Finset.sum_nonneg fun i _ => hn i) (Ne.symm h)
      exact (not_lt_of_ge htotal) (mul_lt_of_lt_one_left hpos hlt)
    intro i
    have hi := Finset.single_le_sum (fun j _ => hn j) (Finset.mem_univ i)
    rw [hzero] at hi
    linarith [le_trans (le_max_left (-x i) 0) hi]
  have hA : IsUnit A := by
    apply Matrix.mulVec_injective_iff_isUnit.mp
    intro x y hxy
    have hzero : A *ᵥ (x - y) = 0 := by rw [mulVec_sub, hxy, sub_self]
    have hzero' : A *ᵥ (y - x) = 0 := by rw [mulVec_sub, hxy, sub_self]
    ext i
    have h₁ := neg_contraction (x - y) 0 hzero (fun _ => le_rfl) i
    have h₂ := neg_contraction (y - x) 0 hzero' (fun _ => le_rfl) i
    exact le_antisymm (sub_nonneg.mp h₂) (sub_nonneg.mp h₁)
  let x := fixedPointSol lam MSR MRec J
  let b := (1 - lam) • (MRec *ᵥ Pi.single J (1 : ℝ))
  have heq : A *ᵥ x = b := by
    unfold x fixedPointSol
    change A *ᵥ ((1 - lam) • (A⁻¹ *ᵥ (MRec *ᵥ Pi.single J 1))) = b
    rw [mulVec_smul, mulVec_mulVec, Matrix.mul_nonsing_inv _ ((Matrix.isUnit_iff_isUnit_det A).mp hA),
      one_mulVec]
  have hb : ∀ i, 0 ≤ b i := by
    intro i
    simp only [b, mulVec_single_one, Pi.smul_apply, smul_eq_mul]
    exact mul_nonneg (sub_nonneg.mpr hlt.le) ((hRec J).1 i)
  refine ⟨⟨neg_contraction x b heq hb, ?_⟩, heq⟩
  have hsum := congrArg (fun q : Fin K → ℝ => ∑ i, q i) heq
  simp only [A, sub_mulVec, one_mulVec, smul_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    b, Finset.sum_sub_distrib, ← Finset.mul_sum, sum_mulVec_stochastic hSR x, mulVec_single_one] at hsum
  change (∑ i, x i) - lam * ∑ i, x i = (1 - lam) * ∑ i, MRec i J at hsum
  rw [(hRec J).2] at hsum
  apply (mul_right_inj' (sub_pos.mpr hlt).ne').mp
  linarith

/-- Equation (3.1) has a solution throughout the closed range of mixing weights.
At weight one, take a limit of solutions with weights strictly below one. -/
theorem eq_3_1_solvable {K : ℕ} (lam : ℝ) (hlam0 : 0 ≤ lam) (hlam1 : lam ≤ 1)
    (MSR MRec : Matrix (Fin K) (Fin K) ℝ) (hSR : IsColStochastic MSR)
    (hRec : IsColStochastic MRec) (J : Fin K) :
    ∃ p : Fin K → ℝ, IsProbVec p ∧
      (1 - lam • MSR) *ᵥ p = (1 - lam) • (MRec *ᵥ Pi.single J 1) := by
  rcases lt_or_eq_of_le hlam1 with hlt | rfl
  · exact ⟨_, fixedPointSol_spec lam hlam0 hlt MSR MRec hSR hRec J⟩
  let a (n : ℕ) : ℝ := 1 - 1 / ((n : ℝ) + 1)
  let p (n : ℕ) := fixedPointSol (a n) MSR MRec J
  have ha₀ (n : ℕ) : 0 ≤ a n := by
    apply sub_nonneg.mpr
    exact (div_le_iff₀ (by positivity)).mpr (by linarith [Nat.cast_nonneg (α := ℝ) n])
  have ha₁ (n : ℕ) : a n < 1 := sub_lt_self _ (by positivity)
  have ha : Tendsto a atTop (𝓝 1) := by
    simpa only [sub_zero, a] using
      (tendsto_const_nhds (x := (1 : ℝ))).sub
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
  have hp (n : ℕ) := fixedPointSol_spec (a n) (ha₀ n) (ha₁ n) MSR MRec hSR hRec J
  obtain ⟨q, hq, φ, hφ, hlim⟩ := (isCompact_stdSimplex ℝ (Fin K)).tendsto_subseq
    (x := p) (fun n => (hp n).1)
  refine ⟨q, hq, ?_⟩
  ext i
  have hq_i := tendsto_pi_nhds.mp hlim i
  have hM_i : Tendsto (fun n => (MSR *ᵥ p (φ n)) i) atTop (𝓝 ((MSR *ᵥ q) i)) := by
    apply (Continuous.tendsto _ q).comp hlim
    change Continuous (fun v : Fin K → ℝ => ∑ j, MSR i j * v j)
    fun_prop
  have hleft := hq_i.sub ((ha.comp hφ.tendsto_atTop).mul hM_i)
  have hright := ((tendsto_const_nhds (x := (1 : ℝ))).sub (ha.comp hφ.tendsto_atTop)).mul
    (tendsto_const_nhds (x := (MRec *ᵥ Pi.single J (1 : ℝ)) i))
  have hstep (n : ℕ) : p (φ n) i - a (φ n) * (MSR *ᵥ p (φ n)) i =
      (1 - a (φ n)) * (MRec *ᵥ Pi.single J (1 : ℝ)) i := by
    have h := congrFun (hp (φ n)).2 i
    simpa only [sub_mulVec, one_mulVec, smul_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] using h
  have hfinal := tendsto_nhds_unique hleft (hright.congr (fun n => (hstep n).symm))
  simpa only [sub_mulVec, one_mulVec, smul_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul] using hfinal

end CalibeatBandit

end

section

set_option autoImplicit false
set_option maxHeartbeats 150000

open Matrix MeasureTheory
open scoped BigOperators

namespace CalibeatBandit

private theorem hedge_prob {K : ℕ} (j : Fin K) (η : ℝ) (g : Fin K → ℝ) :
    IsProbVec (FewExperts.hedgeWeights η g) := by
  have hpos : 0 < ∑ i, Real.exp (η * g i) :=
    (Real.exp_pos _).trans_le (Finset.single_le_sum (fun i _ => Real.exp_nonneg (η * g i)) (Finset.mem_univ j))
  constructor
  · intro i
    exact div_nonneg (Real.exp_nonneg _) hpos.le
  · simp only [FewExperts.hedgeWeights, ← Finset.sum_div, div_self hpos.ne']

theorem LearnerState.lam_mem {K : ℕ} (s : LearnerState K) (η : ℝ) :
    s.lam η ∈ Set.Ioo (0 : ℝ) 1 := by
  have hmix := hedge_prob (0 : Fin 2) η ![s.cumHSR, s.cumHRec]
  have hpos (i : Fin 2) : 0 < FewExperts.hedgeWeights η ![s.cumHSR, s.cumHRec] i := by
    unfold FewExperts.hedgeWeights
    apply div_pos (Real.exp_pos _)
    exact (Real.exp_pos _).trans_le
      (Finset.single_le_sum (fun k _ => Real.exp_nonneg _) (Finset.mem_univ i))
  have hsum := hmix.2
  rw [Fin.sum_univ_two] at hsum
  have hlt : s.lam η < 1 := by
    unfold LearnerState.lam
    linarith [hpos 1]
  exact ⟨hpos 0, hlt⟩

theorem LearnerState.matSR_stochastic {K : ℕ} (s : LearnerState K) (η : ℝ) (J : Fin K) :
    IsColStochastic (s.matSR η) :=
  fun i => hedge_prob J η (s.cumSR i)

theorem LearnerState.matRec_stochastic {K : ℕ} (s : LearnerState K) (η : ℝ) (J : Fin K) :
    IsColStochastic (s.matRec η) :=
  fun i => hedge_prob J η (s.cumRec i)

theorem LearnerState.roundX_spec {K : ℕ} (s : LearnerState K) (η : ℝ) (J : Fin K) :
    IsProbVec (s.roundX η J) ∧
      (1 - s.lam η • s.matSR η) *ᵥ s.roundX η J =
        (1 - s.lam η) • (s.matRec η *ᵥ Pi.single J 1) :=
  fixedPointSol_spec _ (s.lam_mem η).1.le (s.lam_mem η).2 _ _
    (s.matSR_stochastic η J) (s.matRec_stochastic η J) J

theorem explore_prob {K : ℕ} (hK : 0 < K) {μ : ℝ} (hμ₀ : 0 ≤ μ) (hμ₁ : μ ≤ 1)
    {x : Fin K → ℝ} (hx : IsProbVec x) : IsProbVec (explore μ x) := by
  have hk : (K : ℝ) ≠ 0 := by exact_mod_cast hK.ne'
  constructor
  · intro i
    exact add_nonneg (mul_nonneg (sub_nonneg.mpr hμ₁) (hx.1 i)) (by positivity)
  · simp only [explore, Finset.sum_add_distrib, ← Finset.mul_sum, hx.2, mul_one,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    field_simp
    ring

local instance matrixMeasurableSpace (K : ℕ) : MeasurableSpace (Matrix (Fin K) (Fin K) ℝ) :=
  inferInstanceAs (MeasurableSpace (Fin K → Fin K → ℝ))

local instance matrixBorelSpace (K : ℕ) : BorelSpace (Matrix (Fin K) (Fin K) ℝ) :=
  inferInstanceAs (BorelSpace (Fin K → Fin K → ℝ))

section Measurability

variable {Ω : Type*} [MeasurableSpace Ω] {K : ℕ}

theorem measurable_select {α : Type*} [Fintype α] [MeasurableSpace α]
    [MeasurableSingletonClass α] {a : Ω → α} (ha : Measurable a)
    {f : α → Ω → ℝ} (hf : ∀ i, Measurable (f i)) :
    Measurable (fun ω => f (a ω) ω) := by
  classical
  have heq : (fun ω => f (a ω) ω) =
      fun ω => ∑ i, if a ω = i then f i ω else 0 := by
    funext ω
    simp
  rw [heq]
  exact Finset.measurable_sum _ fun i _ => Measurable.ite (ha (measurableSet_singleton i)) (hf i) measurable_const

@[fun_prop] theorem measurable_hedge {g : Ω → Fin K → ℝ} (hg : Measurable g)
    (η : ℝ) (j : Fin K) : Measurable fun ω => FewExperts.hedgeWeights η (g ω) j := by
  unfold FewExperts.hedgeWeights
  exact (Real.continuous_exp.measurable.comp ((measurable_pi_iff.mp hg j).const_mul η)).div
    (Finset.measurable_sum _ fun i _ =>
      Real.continuous_exp.measurable.comp ((measurable_pi_iff.mp hg i).const_mul η))

theorem measurable_fixedPointSol {lam : Ω → ℝ}
    {M N : Ω → Matrix (Fin K) (Fin K) ℝ} (hlam : Measurable lam)
    (hM : Measurable M) (hN : Measurable N) {J : Ω → Fin K} (hJ : Measurable J) :
    Measurable fun ω => fixedPointSol (lam ω) (M ω) (N ω) (J ω) := by
  let A : Ω → Matrix (Fin K) (Fin K) ℝ := fun ω => 1 - lam ω • M ω
  have hA : Measurable A := measurable_pi_iff.mpr fun i => measurable_pi_iff.mpr fun j => by
    change Measurable fun ω => (1 : Matrix (Fin K) (Fin K) ℝ) i j - lam ω * M ω i j
    exact measurable_const.sub (hlam.mul (measurable_pi_iff.mp (measurable_pi_iff.mp hM i) j))
  have hdet : Measurable fun ω => (A ω).det :=
    (continuous_id.matrix_det : Continuous fun a : Matrix (Fin K) (Fin K) ℝ => a.det).measurable.comp hA
  have hadj : Measurable fun ω => (A ω).adjugate :=
    (continuous_id.matrix_adjugate : Continuous fun a : Matrix (Fin K) (Fin K) ℝ => a.adjugate).measurable.comp hA
  have hcol (i : Fin K) : Measurable fun ω => N ω i (J ω) :=
    measurable_select hJ fun j => measurable_pi_iff.mp (measurable_pi_iff.mp hN i) j
  refine measurable_pi_iff.mpr fun i => ?_
  change Measurable fun ω => ((1 - lam ω) • ((A ω)⁻¹ *ᵥ (N ω *ᵥ Pi.single (J ω) 1))) i
  simp only [mulVec_single_one, Matrix.inv_def, Ring.inverse_eq_inv, Pi.smul_apply,
    smul_eq_mul, mulVec, dotProduct, col_apply, Matrix.smul_apply]
  exact (measurable_const.sub hlam).mul
    (Finset.measurable_sum _ fun j _ =>
      (hdet.inv.mul (measurable_pi_iff.mp (measurable_pi_iff.mp hadj i) j)).mul (hcol j))

private theorem measurable_alg_history (η μ : ℝ) (J I : ℕ → Ω → Fin K) (r : ℕ → Ω → ℝ)
    (t : ℕ) (hJ : ∀ s < t, Measurable (J s)) (hI : ∀ s < t, Measurable (I s))
    (hr : ∀ s < t, Measurable (r s)) :
    let S := fun ω => algState η μ (fun s => J s ω) (fun s => I s ω) (fun s => r s ω) t
    (∀ i j, Measurable fun ω => (S ω).cumSR i j) ∧
    (∀ i j, Measurable fun ω => (S ω).cumRec i j) ∧
    (Measurable fun ω => (S ω).cumHSR) ∧ (Measurable fun ω => (S ω).cumHRec) := by
  induction t with
  | zero =>
    exact ⟨fun _ _ => measurable_const, fun _ _ => measurable_const,
      measurable_const, measurable_const⟩
  | succ t ih =>
    let S := fun ω => algState η μ (fun s => J s ω) (fun s => I s ω) (fun s => r s ω) t
    obtain ⟨hsr, hrec, hHSR, hHRec⟩ := ih (fun s hs => hJ s (by omega))
      (fun s hs => hI s (by omega)) (fun s hs => hr s (by omega))
    have hmSR : Measurable fun ω => (S ω).matSR η := measurable_pi_iff.mpr fun j =>
      measurable_pi_iff.mpr fun i => measurable_hedge (measurable_pi_iff.mpr (hsr i)) η j
    have hmRec : Measurable fun ω => (S ω).matRec η := measurable_pi_iff.mpr fun j =>
      measurable_pi_iff.mpr fun i => measurable_hedge (measurable_pi_iff.mpr (hrec i)) η j
    have hmix : Measurable fun ω => (S ω).lam η :=
      measurable_hedge (measurable_pi_iff.mpr (Fin.forall_fin_two.mpr ⟨hHSR, hHRec⟩)) η 0
    have hj := hJ t (Nat.lt_succ_self _)
    have hi := hI t (Nat.lt_succ_self _)
    have ht := hr t (Nat.lt_succ_self _)
    let x := fun ω => (S ω).roundX η (J t ω)
    have hx := measurable_pi_iff.mp (measurable_fixedPointSol hmix hmSR hmRec hj)
    have hp (j : Fin K) : Measurable fun ω => explore μ (x ω) j :=
      ((hx j).const_mul (1 - μ)).add measurable_const
    let v := fun ω => estimate η (explore μ (x ω)) (I t ω) (r t ω)
    have hv (j : Fin K) : Measurable fun ω => v ω j :=
      (Measurable.ite (hi (measurableSet_singleton j)) (ht.div (hp j)) measurable_const).add
        (measurable_const.div (hp j))
    have hzSR (i : Fin K) : Measurable fun ω =>
        Real.log (∑ j, (S ω).matSR η j i * Real.exp (η * x ω i * v ω j)) :=
      Real.measurable_log.comp (Finset.measurable_sum _ fun j _ =>
        (measurable_pi_iff.mp (measurable_pi_iff.mp hmSR j) i).mul
          (Real.continuous_exp.measurable.comp (((hx i).const_mul η).mul (hv j))))
    have hzRec (i : Fin K) : Measurable fun ω =>
        Real.log (∑ j, (S ω).matRec η j i * Real.exp (η * v ω j)) :=
      Real.measurable_log.comp (Finset.measurable_sum _ fun j _ =>
        (measurable_pi_iff.mp (measurable_pi_iff.mp hmRec j) i).mul
          (Real.continuous_exp.measurable.comp ((hv j).const_mul η)))
    exact ⟨fun i j => (hsr i j).add ((hx i).mul (hv j)),
      fun i j => (hrec i j).add (Measurable.ite (hj (measurableSet_singleton i)) (hv j) measurable_const),
      hHSR.add ((Finset.measurable_sum _ fun i _ => hzSR i).const_mul _),
      hHRec.add ((measurable_select hj hzRec).const_mul _)⟩

private theorem measurable_algX_history (η μ : ℝ) (J I : ℕ → Ω → Fin K) (r : ℕ → Ω → ℝ)
    (t : ℕ) (hJ : ∀ s < t, Measurable (J s)) (hI : ∀ s < t, Measurable (I s))
    (hr : ∀ s < t, Measurable (r s)) (hcur : Measurable (J t)) :
    Measurable fun ω => algX η μ (fun s => J s ω) (fun s => I s ω) (fun s => r s ω) t := by
  let S := fun ω => algState η μ (fun s => J s ω) (fun s => I s ω) (fun s => r s ω) t
  obtain ⟨hsr, hrec, hHSR, hHRec⟩ := measurable_alg_history η μ J I r t hJ hI hr
  have hSR : Measurable (fun ω => (S ω).matSR η) :=
    measurable_pi_iff.mpr fun j => measurable_pi_iff.mpr fun i =>
      measurable_hedge (measurable_pi_iff.mpr (hsr i)) η j
  have hRec : Measurable (fun ω => (S ω).matRec η) :=
    measurable_pi_iff.mpr fun j => measurable_pi_iff.mpr fun i =>
      measurable_hedge (measurable_pi_iff.mpr (hrec i)) η j
  have hmix : Measurable (fun ω => (S ω).lam η) :=
    measurable_hedge (measurable_pi_iff.mpr (Fin.forall_fin_two.mpr ⟨hHSR, hHRec⟩)) η 0
  exact measurable_fixedPointSol hmix hSR hRec hcur

end Measurability

theorem estimate_scaled_mem {K : ℕ} {η μ : ℝ} (hK : 0 < K)
    (hη : 0 < η) (hμ : μ ≤ 1 / 2) (hKη : 4 * K * η ≤ μ)
    (x : Fin K → ℝ) (hx : IsProbVec x) (I j : Fin K) (obs : ℝ)
    (hobs : obs ∈ Set.Icc (0 : ℝ) 1) :
    0 ≤ η * estimate η (explore μ x) I obs j ∧
      η * estimate η (explore μ x) I obs j ≤ 1 := by
  let p := explore μ x j
  let d := (Real.exp 1 - 2) * η
  have hk : 0 < (K : ℝ) := by exact_mod_cast hK
  have hk₁ : 1 ≤ (K : ℝ) := by exact_mod_cast hK
  have hη₈ : η ≤ 1 / 8 := by nlinarith [mul_nonneg (sub_nonneg.mpr hk₁) hη.le]
  have hp : 4 * η ≤ p := by
    change 4 * η ≤ (1 - μ) * x j + μ / K
    have hle := (le_div_iff₀ hk).mpr (show 4 * η * K ≤ μ by linarith only [hKη])
    exact hle.trans (le_add_of_nonneg_left (mul_nonneg (by linarith) (hx.1 j)))
  have hp₀ : 0 < p := lt_of_lt_of_le (by positivity) hp
  have hd₀ : 0 ≤ d := mul_nonneg (sub_nonneg.mpr Real.exp_one_gt_two.le) hη.le
  have hd₁ : d ≤ η := by
    dsimp [d]
    nlinarith [mul_nonneg (show 0 ≤ 3 - Real.exp 1 by linarith [Real.exp_one_lt_three]) hη.le]
  let r := if I = j then obs else 0
  have hr : r ∈ Set.Icc (0 : ℝ) 1 := by
    dsimp [r]
    split
    · exact hobs
    · exact ⟨le_rfl, zero_le_one⟩
  have hv : estimate η (explore μ x) I obs j = (r + d) / p := by
    change (if I = j then obs / p else 0) + d / p = _
    dsimp [r]
    split <;> simp [add_div]
  rw [hv]
  refine ⟨mul_nonneg hη.le (div_nonneg (add_nonneg hr.1 hd₀) hp₀.le), ?_⟩
  rw [← mul_div_assoc]
  apply (div_le_iff₀ hp₀).mpr
  nlinarith [mul_nonneg hη.le (show 0 ≤ 4 - (r + d) by linarith [hr.2])]


namespace ProtocolRun

variable {K T : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} {policy : Policy K}

theorem info_le_info (run : ProtocolRun K T P policy) {a b : ℕ} (hab : a ≤ b) (hb : b ≤ T) :
    run.info a ≤ run.info b := by
  induction hab with
  | refl => exact le_rfl
  | step _ ih => exact (ih (by omega)).trans (run.info_mono _ (by omega))

theorem preDraw_le_succ (run : ProtocolRun K T P policy) {t : ℕ} (ht : t < T) :
    run.preDraw t ≤ run.info (t + 1) :=
  sup_le (run.info_mono t ht) (run.J_measurable t ht).comap_le

theorem preDraw_le_ambient (run : ProtocolRun K T P policy) {t : ℕ} (ht : t < T) :
    run.preDraw t ≤ mΩ :=
  (run.preDraw_le_succ ht).trans (run.info_le _ (Nat.succ_le_of_lt ht))

theorem algX_prob (run : ProtocolRun K T P policy) (η μ : ℝ) (t : ℕ) (ω : Ω) :
    IsProbVec (run.algX η μ t ω) :=
  ((CalibeatBandit.algState η μ (fun s => run.J s ω) (fun s => run.I s ω)
    (fun s => run.obs s ω) t).roundX_spec η (run.J t ω)).1

theorem algV_scaled_mem (run : ProtocolRun K T P policy) {η μ : ℝ} (hK : 0 < K)
    (hη : 0 < η) (hμ : μ ≤ 1 / 2) (hKη : 4 * K * η ≤ μ) {t : ℕ} (ht : t < T)
    (ω : Ω) (j : Fin K) :
    0 ≤ η * run.algV η μ t ω j ∧ η * run.algV η μ t ω j ≤ 1 :=
  estimate_scaled_mem hK hη hμ hKη (run.algX η μ t ω) (run.algX_prob η μ t ω)
    (run.I t ω) j (run.obs t ω) (run.y_mem t ht ω (run.I t ω))

theorem algX_measurable (run : ProtocolRun K T P policy) (η μ : ℝ) {t : ℕ} (ht : t < T) :
    Measurable[run.preDraw t] (run.algX η μ t) := by
  have hle (s : ℕ) (hs : s < t) : run.info (s + 1) ≤ run.preDraw t :=
    (run.info_le_info (show s + 1 ≤ t by omega) ht.le).trans le_sup_left
  have hJ (s : ℕ) (hs : s < t) : Measurable[run.preDraw t] (run.J s) :=
    (run.J_measurable s (by omega)).mono (hle s hs) le_rfl
  have hI (s : ℕ) (hs : s < t) : Measurable[run.preDraw t] (run.I s) :=
    (run.I_measurable s (by omega)).mono (hle s hs) le_rfl
  have hr (s : ℕ) (hs : s < t) : Measurable[run.preDraw t] (run.obs s) := by
    unfold ProtocolRun.obs
    refine @measurable_select Ω (run.preDraw t) (Fin K) _ _ _ _ (hI s hs) (fun j ω => run.y s ω j) ?_
    intro j
    exact (measurable_pi_apply j).comp ((run.y_measurable s (by omega)).mono
      ((run.info_mono s (by omega)).trans (hle s hs)) le_rfl)
  exact @measurable_algX_history Ω (run.preDraw t) K η μ run.J run.I run.obs t hJ hI hr
    (measurable_iff_comap_le.mpr le_sup_right)

theorem algV_measurable (run : ProtocolRun K T P policy) (η μ : ℝ) {t : ℕ}
    (ht : t < T) (j : Fin K) :
    Measurable[run.info (t + 1)] (fun ω => run.algV η μ t ω j) := by
  have hx := (measurable_pi_apply j).comp
    ((run.algX_measurable η μ ht).mono (run.preDraw_le_succ ht) le_rfl)
  have hp : Measurable[run.info (t + 1)] (fun ω => run.algP η μ t ω j) :=
    (hx.const_mul (1 - μ)).add measurable_const
  have hi := run.I_measurable t ht
  have hr : Measurable[run.info (t + 1)] (run.obs t) := by
    unfold ProtocolRun.obs
    refine @measurable_select Ω (run.info (t + 1)) (Fin K) _ _ _ _ hi
      (fun j ω => run.y t ω j) fun k => ?_
    exact (measurable_pi_apply k).comp ((run.y_measurable t ht).mono (run.info_mono t ht) le_rfl)
  exact (Measurable.ite (hi (measurableSet_singleton j)) (hr.div hp) measurable_const).add
    (measurable_const.div hp)

end ProtocolRun

end CalibeatBandit

end

section

set_option autoImplicit false

open Filter MeasureTheory Set InformationTheory
open scoped Interval ENNReal

namespace CalibeatBandit

def bonusTransform (η z : ℝ) : ℝ := z + η * z * (1 - z)

theorem bonusTransform_deriv (η z : ℝ) :
    HasDerivAt (bonusTransform η) (1 + η * (1 - 2 * z)) z := by
  unfold bonusTransform
  have h := (hasDerivAt_id z).add
    (((hasDerivAt_id z).const_mul η).mul ((hasDerivAt_const z (1 : ℝ)).sub (hasDerivAt_id z)))
  change HasDerivAt (fun x : ℝ => x + η * x * (1 - x)) _ z at h
  convert h using 1
  simp only [Pi.sub_apply, id_eq]
  ring

theorem bonusTransform_deriv_pos {η z : ℝ} (hη₀ : 0 ≤ η) (hη₁ : η < 1)
    (hz : z ∈ Icc (0 : ℝ) 1) : 0 < 1 + η * (1 - 2 * z) := by
  nlinarith [mul_nonneg hη₀ (sub_nonneg.mpr hz.2)]

theorem bonusTransform_strictMonoOn {η : ℝ} (hη₀ : 0 ≤ η) (hη₁ : η < 1) :
    StrictMonoOn (bonusTransform η) (Icc (0 : ℝ) 1) := by
  intro x hx y hy hxy
  have h : 0 < 1 + η * (1 - x - y) := by
    nlinarith [mul_nonneg hη₀ (sub_nonneg.mpr hx.2), mul_nonneg hη₀ (sub_nonneg.mpr hy.2)]
  calc
    bonusTransform η x < bonusTransform η x + (y - x) * (1 + η * (1 - x - y)) :=
      lt_add_of_pos_right _ (mul_pos (sub_pos.mpr hxy) h)
    _ = bonusTransform η y := by unfold bonusTransform; ring

/-- The integral inequality after the change of variables in Appendix D.2.
The derivative is positive throughout the integration interval. -/
theorem bonus_log_jacobian_integral_le {η : ℝ} (hη₀ : 0 ≤ η) (hη₁ : η < 1) :
    (∫ z in (0 : ℝ)..1, (1 + η * (1 - 2 * z)) * Real.log (1 + η * (1 - 2 * z)))
      ≤ η ^ 2 / 3 := by
  let J (z : ℝ) := 1 + η * (1 - 2 * z)
  let F (z : ℝ) := J z * Real.log (J z)
  let G (z : ℝ) := (η + η ^ 2) + (-(2 * η) - 4 * η ^ 2) * z + (4 * η ^ 2) * z ^ 2
  have hJ : Continuous J := by unfold J; fun_prop
  have hF : ContinuousOn F (Icc (0 : ℝ) 1) := by
    exact hJ.continuousOn.mul (hJ.continuousOn.log fun z hz => (bonusTransform_deriv_pos hη₀ hη₁ hz).ne')
  have hG : Continuous G := by unfold G; fun_prop
  have hle (z : ℝ) (hz : z ∈ Icc (0 : ℝ) 1) : F z ≤ G z := by
    have hpos : 0 < J z := bonusTransform_deriv_pos hη₀ hη₁ hz
    have hl := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hpos) hpos.le
    calc
      F z ≤ J z * (J z - 1) := hl
      _ = G z := by unfold J G; ring
  have hbound : (∫ z in (0 : ℝ)..1, F z) ≤ ∫ z in (0 : ℝ)..1, G z := by
    apply intervalIntegral.integral_mono_on (by norm_num)
    · apply ContinuousOn.intervalIntegrable
      simpa [uIcc_of_le (show (0 : ℝ) ≤ 1 by norm_num)] using hF
    · exact hG.intervalIntegrable _ _
    · exact hle
  have hg : (∫ z in (0 : ℝ)..1, G z) = η ^ 2 / 3 := by
    have ha : IntervalIntegrable (fun _ : ℝ => η + η ^ 2) volume 0 1 := by
      exact continuous_const.intervalIntegrable _ _
    have hb : IntervalIntegrable (fun z : ℝ => (-(2 * η) - 4 * η ^ 2) * z) volume 0 1 := by
      exact (continuous_const.mul continuous_id).intervalIntegrable _ _
    have hc : IntervalIntegrable (fun z : ℝ => (4 * η ^ 2) * z ^ 2) volume 0 1 := by
      exact (continuous_const.mul (continuous_id.pow 2)).intervalIntegrable _ _
    unfold G
    rw [intervalIntegral.integral_add (ha.add hb) hc, intervalIntegral.integral_add ha hb,
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul, integral_id,
      integral_pow, intervalIntegral.integral_const]
    norm_num
    ring
  exact hbound.trans_eq hg

/-- Lemma 4.7. The uniform law on the unit interval has divergence at most
η²/3 relative to its pushforward under the bonus transform. -/
theorem lemma_4_7 {η : ℝ} (hη₀ : 0 ≤ η) (hη₁ : η < 1) :
    let Q := volume.restrict (Icc (0 : ℝ) 1)
    klDiv Q (Q.map (bonusTransform η)) ≤ ENNReal.ofReal (η ^ 2 / 3) := by
  intro Q
  let J (z : ℝ) := 1 + η * (1 - 2 * z)
  let g (z : ℝ) := ENNReal.ofReal (J z)
  let h := bonusTransform η
  let Q' := Q.withDensity g
  have hmJ : Continuous J := by unfold J; fun_prop
  have hmg : Measurable g := hmJ.measurable.ennreal_ofReal
  have hmh : Continuous h := by unfold h bonusTransform; fun_prop
  have hmono : StrictMonoOn h (Icc (0 : ℝ) 1) := bonusTransform_strictMonoOn hη₀ hη₁
  have hpos (x : ℝ) (hx : x ∈ Icc (0 : ℝ) 1) : 0 < J x :=
    bonusTransform_deriv_pos hη₀ hη₁ hx
  have himage : h '' Icc (0 : ℝ) 1 = Icc (0 : ℝ) 1 := by
    rw [hmh.continuousOn.image_Icc_of_monotoneOn (show (0 : ℝ) ≤ 1 by norm_num)
      (StrictMonoOn.monotoneOn hmono)]
    simp [h, bonusTransform]
  have hmap : Q'.map h = Q := by
    ext s hs
    rw [Measure.map_apply hmh.measurable hs, withDensity_apply _ (hmh.measurable hs)]
    have hchange := lintegral_image_eq_lintegral_abs_deriv_mul
      (f := h) (f' := J) measurableSet_Icc
      (fun x _ => (bonusTransform_deriv η x).hasDerivWithinAt) hmono.injOn
      (s.indicator fun _ => (1 : ℝ≥0∞))
    rw [himage, lintegral_indicator hs] at hchange
    simp only [lintegral_const, one_mul, Measure.restrict_apply_univ] at hchange
    change _ = (volume.restrict (Icc (0 : ℝ) 1)) s
    rw [hchange, ← lintegral_indicator (hmh.measurable hs)]
    apply lintegral_congr_ae
    filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Icc] with x hx
    by_cases hx' : h x ∈ s <;>
      simp [g, hx', abs_of_pos (hpos x hx)]
  have hac : Q' ≪ Q := withDensity_absolutelyContinuous _ _
  have hll : llr Q' Q =ᵐ[Q] fun z => Real.log (J z) := by
    filter_upwards [Measure.rnDeriv_withDensity Q hmg,
      ae_restrict_mem (μ := volume) measurableSet_Icc] with z hz hmem
    change Real.log ((Q'.rnDeriv Q z).toReal) = Real.log (J z)
    change Q'.rnDeriv Q z = g z at hz
    rw [hz, ENNReal.toReal_ofReal (hpos z hmem).le]
  have hlog : ContinuousOn (fun z => Real.log (J z)) (Icc (0 : ℝ) 1) :=
    hmJ.continuousOn.log fun z hz => (hpos z hz).ne'
  have hprod : Integrable (fun z => (g z).toReal • Real.log (J z)) Q := by
    have hc := hmJ.continuousOn.mul hlog
    apply (hc.integrableOn_compact isCompact_Icc).congr
    filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Icc] with z hz
    simp [g, ENNReal.toReal_ofReal (hpos z hz).le, smul_eq_mul]
  have hgfinite : ∀ᵐ z ∂Q, g z < ⊤ := ae_of_all _ fun _ => ENNReal.ofReal_lt_top
  have hli' : Integrable (fun z => Real.log (J z)) Q' :=
    (integrable_withDensity_iff_integrable_smul' hmg hgfinite).mpr hprod
  have hll' : llr Q' Q =ᵐ[Q'] fun z => Real.log (J z) := hll.filter_mono hac.ae_le
  have hli : Integrable (llr Q' Q) Q' := hli'.congr hll'.symm
  have hmass : Q' univ = Q univ := by
    rw [← hmap, Measure.map_apply hmh.measurable MeasurableSet.univ, preimage_univ]
  let : IsFiniteMeasure Q' := ⟨hmass ▸ measure_lt_top Q univ⟩
  have hi : (∫ z, llr Q' Q z ∂Q') ≤ η ^ 2 / 3 := by
    rw [integral_congr_ae hll',
      integral_withDensity_eq_integral_toReal_smul hmg hgfinite]
    have he : (∫ z, (g z).toReal • Real.log (J z) ∂Q) =
        ∫ z in (0 : ℝ)..1, J z * Real.log (J z) := by
      rw [intervalIntegral.integral_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Icc] with z hz
      simp [g, ENNReal.toReal_ofReal (hpos z hz).le, smul_eq_mul]
    rw [he]
    exact bonus_log_jacobian_integral_le hη₀ hη₁
  calc
    klDiv Q (Q.map h) ≤ klDiv Q' Q := hmap ▸ klDiv_map_le Q' Q hmh.measurable
    _ ≤ _ := by
      rw [klDiv_of_ac_of_integrable hac hli, show Q.real univ = Q'.real univ by
        simp only [measureReal_def, hmass], add_sub_cancel_right]
      exact ENNReal.ofReal_le_ofReal hi

end CalibeatBandit

end

section

set_option autoImplicit false

namespace CalibeatBandit

open MeasureTheory InformationTheory ProbabilityTheory Set
open scoped ENNReal

/-- Binary relative entropy, written using the continuous extension of
`x log x` at zero. The second parameter is in the open unit interval. -/
noncomputable def binaryEntropy (p q : ℝ) : ℝ :=
  p * Real.log p + (1 - p) * Real.log (1 - p)
    - p * Real.log q - (1 - p) * Real.log (1 - q)

/-- The binary form of Pinsker's inequality, including endpoint values of p. -/
theorem binaryEntropy_ge {p q : ℝ} (hp : p ∈ Icc 0 1) (hq : q ∈ Ioo 0 1) :
    2 * (p - q) ^ 2 ≤ binaryEntropy p q := by
  let f (x : ℝ) := binaryEntropy x q - 2 * (x - q) ^ 2
  let f' (x : ℝ) := Real.log x - Real.log (1 - x) - Real.log q + Real.log (1 - q) - 4 * (x - q)
  let f'' (x : ℝ) := x⁻¹ + (1 - x)⁻¹ - 4
  have ha : Continuous (fun x : ℝ => 1 - x) := continuous_const.sub continuous_id
  have hf : Continuous f :=
    (((Real.continuous_mul_log.add (Real.continuous_mul_log.comp ha)).sub (continuous_id.mul_const _)).sub
      (ha.mul_const _)).sub (((continuous_id.sub continuous_const).pow 2).const_mul 2)
  have hd (x : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) : HasDerivAt f (f' x) x := by
    have h1 := Real.hasDerivAt_mul_log hx.1.ne'
    have h2 := (Real.hasDerivAt_mul_log (sub_pos.mpr hx.2).ne').comp x
      ((hasDerivAt_const x (1 : ℝ)).sub (hasDerivAt_id x))
    have h3 := (hasDerivAt_id x).mul_const (Real.log q)
    have h4 := ((hasDerivAt_const x (1 : ℝ)).sub (hasDerivAt_id x)).mul_const (Real.log (1 - q))
    have h5 := (((hasDerivAt_id x).sub_const q).pow 2).const_mul 2
    convert (((h1.add h2).sub h3).sub h4).sub h5 using 1 <;>
      first | rfl | (dsimp [f']; norm_num; ring)
  have hdd (x : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) : HasDerivAt f' (f'' x) x := by
    have h1 := Real.hasDerivAt_log hx.1.ne'
    have h2 := (Real.hasDerivAt_log (sub_pos.mpr hx.2).ne').comp x
      ((hasDerivAt_const x (1 : ℝ)).sub (hasDerivAt_id x))
    have h3 := ((hasDerivAt_id x).sub_const q).const_mul 4
    convert (((h1.sub h2).sub_const (Real.log q)).add_const (Real.log (1 - q))).sub h3 using 1 <;>
      first | rfl | (dsimp [f'']; norm_num)
  have hpos (x : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) : 0 ≤ f'' x := by
    have h1 : 0 < x := hx.1
    have h2 : 0 < 1 - x := sub_pos.mpr hx.2
    dsimp [f'']
    apply (le_of_mul_le_mul_right _ (mul_pos h1 h2))
    field_simp [h1.ne', h2.ne']
    nlinarith [sq_nonneg (2 * x - 1)]
  have hc : ConvexOn ℝ (Icc 0 1) f := by
    apply convexOn_of_hasDerivWithinAt2_nonneg (f' := f') (f'' := f'') (convex_Icc _ _) hf.continuousOn
    · rw [interior_Icc]
      exact fun x hx => (hd x hx).hasDerivWithinAt
    · rw [interior_Icc]
      exact fun x hx => (hdd x hx).hasDerivWithinAt
    · rw [interior_Icc]
      exact hpos
  have hq' : q ∈ Icc 0 1 := ⟨hq.1.le, hq.2.le⟩
  have hz : f q = 0 := by dsimp [f, binaryEntropy]; ring
  have hdq : HasDerivAt f 0 q := by
    convert hd q hq using 1
    dsimp [f']
    ring
  apply sub_nonneg.mp
  change 0 ≤ f p
  rcases lt_trichotomy p q with h | rfl | h
  · have hs := hc.slope_le_of_hasDerivAt hp hq' h hdq
    rw [slope_def_field, hz] at hs
    exact sub_nonneg.mp (by simpa using (div_le_iff₀ (sub_pos.mpr h)).mp hs)
  · exact hz.ge
  · have hs := hc.le_slope_of_hasDerivAt hq' hp h hdq
    rw [slope_def_field, hz, sub_zero] at hs
    exact by simpa using (le_div_iff₀ (sub_pos.mpr h)).mp hs

private theorem mul_log_div_eq (p : ℝ) {q : ℝ} (hq : 0 < q) :
    p * Real.log (p / q) = p * Real.log p - p * Real.log q := by
  by_cases h : p = 0
  · simp [h]
  · rw [Real.log_div h hq.ne', mul_sub]

theorem toReal_klDiv_bool (μ ν : Measure Bool) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hac : μ ≪ ν) (hq : ν.real {true} ∈ Ioo 0 1) :
    (klDiv μ ν).toReal = binaryEntropy (μ.real {true}) (ν.real {true}) := by
  have hcomp : ({true} : Set Bool)ᶜ = {false} := by ext b; cases b <;> simp
  have hfalse (ρ : Measure Bool) [IsProbabilityMeasure ρ] :
      ρ.real {false} = 1 - ρ.real {true} := by
    rw [← hcomp, measureReal_compl (measurableSet_singleton true), probReal_univ]
  have hν (b : Bool) : 0 < ν.real {b} := by
    cases b
    · rw [hfalse]
      exact sub_pos.mpr hq.2
    · exact hq.1
  have hrn (b : Bool) : (μ.rnDeriv ν b).toReal = μ.real {b} / ν.real {b} := by
    have h := Measure.setIntegral_toReal_rnDeriv hac {b}
    rw [integral_singleton, smul_eq_mul] at h
    apply (eq_div_iff (hν b).ne').mpr
    simpa only [mul_comm] using h
  have hsets : ({true} : Set Bool) ∪ {false} = univ := by ext b; cases b <;> simp
  have hInt : Integrable (llr μ ν) μ := by
    rw [← integrableOn_univ, ← hsets, integrableOn_union]
    exact ⟨integrableOn_singleton, integrableOn_singleton⟩
  rw [toReal_klDiv_of_measure_eq hac ((measure_univ : μ univ = 1).trans (measure_univ : ν univ = 1).symm), integral_fintype hInt, Fintype.univ_bool]
  simp only [Finset.sum_insert, Finset.mem_singleton, Bool.true_eq_false, not_false_eq_true,
    Finset.sum_singleton, smul_eq_mul, llr, hrn]
  rw [mul_log_div_eq _ (hν true), mul_log_div_eq _ (hν false), hfalse μ, hfalse ν]
  unfold binaryEntropy
  ring

/-- For any measurable event, twice the squared difference of its
probabilities is at most the relative entropy of the two laws. -/
theorem event_difference_sq_le_klDiv {Ω : Type*} [MeasurableSpace Ω]
    (μ ν : Measure Ω) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {s : Set Ω} (hs : MeasurableSet s) :
    ENNReal.ofReal (2 * (μ.real s - ν.real s) ^ 2) ≤ klDiv μ ν := by
  classical
  by_cases htop : klDiv μ ν = ⊤
  · simp [htop]
  have hac := (klDiv_ne_top_iff.mp htop).1
  let p := μ.real s
  let q := ν.real s
  have hp : p ∈ Icc 0 1 :=
    ⟨measureReal_nonneg, (measureReal_mono (subset_univ s)).trans_eq probReal_univ⟩
  have hq : q ∈ Icc 0 1 :=
    ⟨measureReal_nonneg, (measureReal_mono (subset_univ s)).trans_eq probReal_univ⟩
  have hzero (h : q = 0) : p = q := by
    rw [h]
    exact (measureReal_eq_zero_iff (measure_ne_top _ _)).mpr (hac ((measureReal_eq_zero_iff (measure_ne_top _ _)).mp h))
  have hone (h : q = 1) : p = q := by
    have hν : ν.real sᶜ = 0 := by rw [measureReal_compl hs, probReal_univ]; exact sub_eq_zero.mpr h.symm
    have hμ : μ.real sᶜ = 0 := (measureReal_eq_zero_iff (measure_ne_top _ _)).mpr (hac ((measureReal_eq_zero_iff (measure_ne_top _ _)).mp hν))
    rw [measureReal_compl hs, probReal_univ] at hμ
    exact (sub_eq_zero.mp hμ).symm.trans h.symm
  change ENNReal.ofReal (2 * (p - q) ^ 2) ≤ _
  by_cases hqi : q ∈ Ioo 0 1
  swap
  · have he : p = q := by
      rcases lt_or_eq_of_le hq.1 with h₀ | h₀
      · exact hone (le_antisymm hq.2 (le_of_not_gt (fun h => hqi ⟨h₀, h⟩)))
      · exact hzero h₀.symm
    simp [he]
  let b (x : Ω) := if x ∈ s then true else false
  have hbm : Measurable b := Measurable.ite hs measurable_const measurable_const
  have _ : IsProbabilityMeasure (μ.map b) := Measure.isProbabilityMeasure_map hbm.aemeasurable
  have _ : IsProbabilityMeasure (ν.map b) := Measure.isProbabilityMeasure_map hbm.aemeasurable
  have hb : b ⁻¹' ({true} : Set Bool) = s := by ext x; simp [b]
  have hmap (ρ : Measure Ω) : (ρ.map b).real {true} = ρ.real s := by
    rw [measureReal_def, Measure.map_apply hbm (measurableSet_singleton true), hb, measureReal_def]
  have hle := klDiv_map_le μ ν hbm
  have hfin : klDiv (μ.map b) (ν.map b) ≠ ⊤ := ne_of_lt (hle.trans_lt (lt_top_iff_ne_top.mpr htop))
  have hbin := toReal_klDiv_bool (μ.map b) (ν.map b) (hac.map hbm)
    (by rwa [hmap])
  rw [hmap, hmap] at hbin
  exact ((ENNReal.ofReal_le_ofReal (binaryEntropy_ge hp hqi)).trans_eq
    (by rw [← hbin, ENNReal.ofReal_toReal hfin])).trans hle

/-- Appending an observation adds relative entropy only on the histories
where the learner queries the auxiliary action whose response law changed. -/
theorem klDiv_compProd_changed_on {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ ν : Measure α) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    {s : Set α} (hs : MeasurableSet s) [DecidablePred (· ∈ s)]
    (Q Q' : Measure β) [IsProbabilityMeasure Q] [IsProbabilityMeasure Q']
    (hac : Q ≪ Q') (other : Kernel α β) [IsMarkovKernel other] :
    klDiv (μ ⊗ₘ Kernel.piecewise hs (Kernel.const α Q) other)
        (ν ⊗ₘ Kernel.piecewise hs (Kernel.const α Q') other) =
      klDiv μ ν + klDiv Q Q' * μ s := by
  let κ := Kernel.piecewise hs (Kernel.const α Q) other
  let κ' := Kernel.piecewise hs (Kernel.const α Q') other
  let d (p : α × β) := if p.1 ∈ s then Q.rnDeriv Q' p.2 else 1
  have hm : Measurable d := Measurable.ite (measurable_fst hs)
    ((Measure.measurable_rnDeriv Q Q').comp measurable_snd) measurable_const
  have hDensity : (μ ⊗ₘ κ').withDensity d = μ ⊗ₘ κ := by
    ext z hz
    rw [withDensity_apply _ hz, ← lintegral_indicator hz, Measure.lintegral_compProd (hm.indicator hz),
      Measure.compProd_apply hz]
    apply lintegral_congr
    intro a
    have hz' : MeasurableSet (Prod.mk a ⁻¹' z) := measurable_prodMk_left hz
    have he : (fun b => z.indicator d (a, b)) =
        (Prod.mk a ⁻¹' z).indicator (fun b => d (a, b)) := rfl
    rw [he, lintegral_indicator hz']
    by_cases ha : a ∈ s
    · simpa [d, κ, κ', Kernel.piecewise_apply, ha] using
        Measure.setLIntegral_rnDeriv hac (Prod.mk a ⁻¹' z)
    · simp [d, κ, κ', Kernel.piecewise_apply, ha]
  have hJoint : μ ⊗ₘ κ ≪ μ ⊗ₘ κ' := by
    rw [← hDensity]
    exact withDensity_absolutelyContinuous _ _
  have hrn : (μ ⊗ₘ κ).rnDeriv (μ ⊗ₘ κ') =ᵐ[μ ⊗ₘ κ'] d := by
    rw [← hDensity]
    exact Measure.rnDeriv_withDensity _ hm
  have hKL : klDiv (μ ⊗ₘ κ) (μ ⊗ₘ κ') = klDiv Q Q' * μ s := by
    rw [klDiv_eq_lintegral_klFun_of_ac hJoint]
    have he : (∫⁻ x, ENNReal.ofReal (klFun ((μ ⊗ₘ κ).rnDeriv (μ ⊗ₘ κ') x).toReal) ∂(μ ⊗ₘ κ')) =
        ∫⁻ x, ENNReal.ofReal (klFun (d x).toReal) ∂(μ ⊗ₘ κ') := by
      apply lintegral_congr_ae
      filter_upwards [hrn] with x hx
      rw [hx]
    rw [he, Measure.lintegral_compProd (by fun_prop : Measurable (fun x => ENNReal.ofReal (klFun (d x).toReal)))]
    rw [← lintegral_indicator_const hs, klDiv_eq_lintegral_klFun_of_ac hac]
    apply lintegral_congr
    intro a
    by_cases ha : a ∈ s
    · simp [d, κ', Kernel.piecewise_apply, ha]
    · simp [d, κ', Kernel.piecewise_apply, ha, klFun]
  rw [show klDiv (μ ⊗ₘ κ) (ν ⊗ₘ κ') =
    klDiv μ ν + klDiv (μ ⊗ₘ κ) (μ ⊗ₘ κ') from klDiv_compProd_eq_add μ ν κ κ', hKL]

/-- Compare the expected numbers of plays of one action in two worlds.
Each event records whether the learner played that action in one round. -/
theorem expected_hits_le_of_klDiv {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    (μ ν : Measure Ω) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (s : ι → Set Ω) (hs : ∀ i, MeasurableSet (s i))
    {D : ℝ} (hD : 0 ≤ D) (hkl : klDiv μ ν ≤ ENNReal.ofReal D) :
    (∑ i, ν.real (s i)) ≤ (∑ i, μ.real (s i)) + Fintype.card ι * Real.sqrt (D / 2) := by
  have hstep (i : ι) : ν.real (s i) ≤ μ.real (s i) + Real.sqrt (D / 2) := by
    have h := (event_difference_sq_le_klDiv μ ν (hs i)).trans hkl
    have hsq := (ENNReal.ofReal_le_ofReal_iff hD).mp h
    have hsqrt : ν.real (s i) - μ.real (s i) ≤ Real.sqrt (D / 2) :=
      Real.le_sqrt_of_sq_le (by nlinarith only [hsq])
    linarith only [hsqrt]
  simpa [Finset.sum_add_distrib] using Finset.sum_le_sum (s := (Finset.univ : Finset ι))
    (fun i _ => hstep i)

/-- The one-period count transfer in Lemma 4.8. Once the history divergence has
been bounded by the baseline count, this is the required comparison of play counts. -/
theorem expected_auxiliary_hits_le {Ω : Type*} [MeasurableSpace Ω] {R : ℕ}
    (μ ν : Measure Ω) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (s : Fin R → Set Ω) (hs : ∀ i, MeasurableSet (s i))
    {η : ℝ} (hη : 0 ≤ η)
    (hkl : klDiv μ ν ≤ ENNReal.ofReal (η ^ 2 / 3 * ∑ i, μ.real (s i))) :
    let baseline := ∑ i, μ.real (s i)
    (∑ i, ν.real (s i)) ≤ baseline + η * R * Real.sqrt (baseline / 6) := by
  intro baseline
  have hbase : 0 ≤ baseline := Finset.sum_nonneg fun _ _ => measureReal_nonneg
  have hD : 0 ≤ η ^ 2 / 3 * baseline := by positivity
  have h := expected_hits_le_of_klDiv μ ν s hs hD hkl
  rw [show η ^ 2 / 3 * baseline / 2 = η ^ 2 * (baseline / 6) by ring,
    Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hη, Fintype.card_fin] at h
  linarith only [h, show (R : ℝ) * (η * Real.sqrt (baseline / 6)) =
    η * R * Real.sqrt (baseline / 6) by ring]

end CalibeatBandit

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

/-- When a single action is optimal in every round, the optimal
postprocessing sends every reference action to that action. -/
theorem rewardLoss_eq_sum_of_pointwise_optimal {K T : ℕ}
    (y : ℕ → Fin K → ℝ) (J I : ℕ → Fin K) (a : Fin K)
    (h : ∀ t < T, ∀ i, y t i ≤ y t a) :
    rewardLoss T y J I = ∑ t ∈ Finset.range T, (y t a - y t (I t)) := by
  classical
  unfold rewardLoss
  apply le_antisymm
  · apply Finset.sup'_le
    intro f _
    exact Finset.sum_le_sum fun t ht => sub_le_sub_right (h t (Finset.mem_range.mp ht) (f (J t))) _
  · exact Finset.le_sup' (fun f : Fin K → Fin K =>
      ∑ t ∈ Finset.range T, (y t (f (J t)) - y t (I t)))
      (Finset.mem_univ (fun _ : Fin K => a))

/-- In the favorable environment of Theorem 3.6 the recommendation always
plays the pointwise optimal action. Both learner losses equal the same
payoff gap, and the recommendation has zero swap regret at every prefix. -/
theorem favorable_environment_regret {T : ℕ} (y : ℕ → Fin 2 → ℝ) (I : ℕ → Fin 2)
    (h : ∀ t < T, y t 1 ≤ y t 0) :
    (∀ s ≤ T, swapRegret s y (fun _ => 0) = 0) ∧
    swapRegret T y I = ∑ t ∈ Finset.range T, (if I t = 1 then y t 0 - y t 1 else 0) ∧
    rewardLoss T y (fun _ => 0) I = swapRegret T y I := by
  have hbest : ∀ t < T, ∀ i : Fin 2, y t i ≤ y t 0 := by
    intro t ht i
    fin_cases i
    · exact le_rfl
    · exact h t ht
  have hswap (s : ℕ) (hs : s ≤ T) (J : ℕ → Fin 2) :
      swapRegret s y J = ∑ t ∈ Finset.range s, (y t 0 - y t (J t)) :=
    rewardLoss_eq_sum_of_pointwise_optimal y J J 0 fun t ht => hbest t (ht.trans_le hs)
  refine ⟨fun s hs => by simp [hswap s hs], ?_, ?_⟩
  · rw [hswap T le_rfl]
    apply Finset.sum_congr rfl
    intro t _
    generalize hI : I t = i
    fin_cases i <;> simp
  · rw [rewardLoss_eq_sum_of_pointwise_optimal y (fun _ => 0) I 0 hbest,
      hswap T le_rfl I]

/-- The comparison between the two transcript laws forces a minimum
probability of playing action two in the favorable environment. -/
theorem favorable_play_rate {x μ ν : ℝ} (hx : 1 ≤ x) (hμ : 0 ≤ μ) (hν : 3 / 4 ≤ ν)
    (hchange : ν ≤ μ + 4 * Real.sqrt 6 * x * Real.sqrt μ) :
    1 / (174 * x ^ 2) ≤ μ := by
  have hx0 : 0 < x := lt_of_lt_of_le zero_lt_one hx
  have hx2 : 0 < x ^ 2 := pow_pos hx0 _
  have hx2one : 1 ≤ x ^ 2 := one_le_pow₀ hx
  by_contra! hm
  have hprod : μ * (174 * x ^ 2) < 1 := (lt_div_iff₀ (by positivity)).mp hm
  have hmconst : μ < 1 / 174 := by
    have ht : μ * 174 ≤ μ * (174 * x ^ 2) := by
      have ht' : (174 : ℝ) ≤ 174 * x ^ 2 := by linarith
      exact mul_le_mul_of_nonneg_left ht' hμ
    linarith
  let a := 4 * Real.sqrt 6 * x * Real.sqrt μ
  have ha : 0 ≤ a := by dsimp [a]; positivity
  have ha2 : a ^ 2 = 96 * x ^ 2 * μ := by
    dsimp [a]
    simp only [mul_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 6), Real.sq_sqrt hμ]
    ring
  have hab : a < 93 / 125 := by
    by_contra! hh
    have hh2 : (93 / 125 : ℝ) ^ 2 ≤ a ^ 2 :=
      pow_le_pow_left₀ (by norm_num) hh 2
    nlinarith only [ha2, hh2, hprod]
  change ν ≤ μ + a at hchange
  linarith

/-- Substitute the gap used in Appendix C.5 into the play-rate lower bound. -/
theorem worst_case_cost_rate {R T μ : ℝ} (hR : 0 ≤ R) (hT : 0 < T)
    (h : 1 / (174 * (R / Real.sqrt T + 1) ^ 2) ≤ μ) :
    T / (44 * (R + Real.sqrt T)) ≤ μ * (4 * (R / T + 1 / Real.sqrt T)) * T := by
  let d := R + Real.sqrt T
  have hs : 0 < Real.sqrt T := Real.sqrt_pos.2 hT
  have hss : Real.sqrt T ^ 2 = T := Real.sq_sqrt hT.le
  have hd : 0 < d := add_pos_of_nonneg_of_pos hR hs
  have hratio : R / Real.sqrt T + 1 = d / Real.sqrt T := by
    dsimp [d]
    rw [add_div, div_self hs.ne']
  rw [hratio, div_pow, hss, ← mul_div_assoc, one_div_div] at h
  have hgain : μ * (4 * (R / T + 1 / Real.sqrt T)) * T = μ * (4 * d) := by
    have hts : T / Real.sqrt T = Real.sqrt T := by
      apply (div_eq_iff hs.ne').2
      nlinarith [hss]
    dsimp [d]
    calc
      _ = μ * (4 * (R + T / Real.sqrt T)) := by
        field_simp [hT.ne', hs.ne']
      _ = _ := by rw [hts]
  rw [hgain]
  have hscale := mul_le_mul_of_nonneg_right h (show 0 ≤ 4 * d by positivity)
  refine le_trans ?_ hscale
  have heq : T / (174 * d ^ 2) * (4 * d) = (4 * T) / (174 * d) := by
    field_simp [hd.ne']
  rw [heq]
  have eq : (4 * T) / (174 * d) = T / ((174 / 4) * d) := by
    field_simp [hd.ne']
  rw [eq]
  exact div_le_div_of_nonneg_left hT.le (by positivity) (by linarith [hd])

/-- The Bernoulli feedback on the second action contributes at most
`12 δ²` relative entropy each time that action is played. -/
theorem twoArm_binaryEntropy_le {δ : ℝ} (hδ : 0 ≤ δ) (hδ₁ : δ ≤ 1 / 4) :
    binaryEntropy (1 / 2 - δ) (1 / 2 + δ) ≤ 12 * δ ^ 2 := by
  have hp : 0 < 1 / 2 - δ := by linarith
  have hq : 0 < 1 / 2 + δ := by linarith
  have hminus : 0 < 1 - 2 * δ := by linarith
  have hplus : 0 < 1 + 2 * δ := by linarith
  have hlogplus : Real.log (1 + 2 * δ) ≤ 2 * δ := by
    linarith [Real.log_le_sub_one_of_pos hplus]
  have hlogminus : -Real.log (1 - 2 * δ) ≤ 4 * δ := by
    have h := Real.log_le_sub_one_of_pos (inv_pos.mpr hminus)
    rw [Real.log_inv] at h
    refine h.trans ?_
    rw [sub_le_iff_le_add, inv_eq_one_div, div_le_iff₀ hminus]
    nlinarith [mul_nonneg hδ (sub_nonneg.mpr hδ₁)]
  have hlogs : Real.log (1 / 2 + δ) - Real.log (1 / 2 - δ) ≤ 6 * δ := by
    have ha := Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hq.ne'
    have hb := Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hp.ne'
    rw [show 2 * (1 / 2 + δ) = 1 + 2 * δ by ring] at ha
    rw [show 2 * (1 / 2 - δ) = 1 - 2 * δ by ring] at hb
    linarith
  unfold binaryEntropy
  rw [show 1 - (1 / 2 - δ) = 1 / 2 + δ by ring, show 1 - (1 / 2 + δ) = 1 / 2 - δ by ring]
  calc
    _ = 2 * δ * (Real.log (1 / 2 + δ) - Real.log (1 / 2 - δ)) := by ring
    _ ≤ 2 * δ * (6 * δ) := mul_le_mul_of_nonneg_left hlogs (by positivity)
    _ = _ := by ring

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

open MeasureTheory ProbabilityTheory InformationTheory Set
open scoped ENNReal Function

universe u

/-- The independent seed used for both randomization and constructing rewards. -/
noncomputable def twoArmUniform : Measure ℝ := volume.restrict (Ico 0 1)

instance : IsProbabilityMeasure twoArmUniform := ⟨by simp [twoArmUniform, Real.volume_Ico]⟩

theorem twoArmUniform_real_lt {p : ℝ} (hp : p ∈ Icc (0 : ℝ) 1) :
    twoArmUniform.real (Iio p) = p := by
  rw [measureReal_def, twoArmUniform, Measure.restrict_apply measurableSet_Iio]
  have he : Iio p ∩ Ico (0 : ℝ) 1 = Ico 0 p := by
    ext z
    simp only [mem_inter_iff, mem_Iio, mem_Ico]
    exact ⟨fun h => ⟨h.2.1, h.1⟩, fun h => ⟨h.2, h.1, h.2.trans_le hp.2⟩⟩
  rw [he, Real.volume_Ico, sub_zero, ENNReal.toReal_ofReal hp.1]

abbrev TwoArmAction := Fin 2
abbrev TwoArmObservation := TwoArmAction × Bool
abbrev TwoArmTrace (t : ℕ) := TrialTape.{u} TwoArmObservation t

theorem measurable_twoArm_select {Ω β : Type*} [MeasurableSpace Ω] [MeasurableSpace β]
    {a : Ω → TwoArmAction} (ha : Measurable a) {f : TwoArmAction → Ω → β}
    (hf : ∀ i, Measurable (f i)) : Measurable (fun x => f (a x) x) := by
  have he : (fun x => f (a x) x) = fun x => if a x = 0 then f 0 x else f 1 x := by
    funext x
    generalize a x = i
    fin_cases i <;> simp
  rw [he]
  exact Measurable.ite (ha (measurableSet_singleton 0)) (hf 0) (hf 1)

def bitReward (b : Bool) : ℝ := if b then 1 else 0

@[simp] theorem bitReward_false : bitReward false = 0 := rfl
@[simp] theorem bitReward_true : bitReward true = 1 := rfl

theorem bitReward_mem (b : Bool) : bitReward b ∈ Icc (0 : ℝ) 1 := by cases b <;> norm_num

/-- Both environments use the same fair coin for action zero. The probability
of reward one for action one is `p`. Sharing the same draw ensures pointwise
optimality of action zero whenever `p ≤ 1/2`. -/
noncomputable def twoArmBit (p x : ℝ) (i : TwoArmAction) : Bool :=
  decide (x < if i = 0 then 1 / 2 else p)

theorem measurable_twoArmBit (p : ℝ) (i : TwoArmAction) : Measurable (fun x => twoArmBit p x i) := by
  unfold twoArmBit
  have hm : Measurable (fun x : ℝ => if x < (if i = 0 then (1 : ℝ) / 2 else p) then true else false) :=
    Measurable.ite measurableSet_Iio measurable_const measurable_const
  convert hm using 1
  funext x
  split <;> simp_all

noncomputable def twoArmReward (p x : ℝ) (i : TwoArmAction) : ℝ := bitReward (twoArmBit p x i)

theorem twoArmReward_mem (p x : ℝ) (i : TwoArmAction) :
    twoArmReward p x i ∈ Icc (0 : ℝ) 1 := bitReward_mem _

theorem twoArmReward_optimal {p : ℝ} (hp : p ≤ 1 / 2) (x : ℝ) :
    twoArmReward p x 1 ≤ twoArmReward p x 0 := by
  have hne : ((1 : TwoArmAction) = 0) = False := by decide
  by_cases h : x < p
  · have hx : x < 1 / 2 := h.trans_le hp
    change bitReward (decide (x < p)) ≤ bitReward (decide (x < 1 / 2))
    simp only [h, hx, decide_true, le_rfl]
  · change bitReward (twoArmBit p x 1) ≤ _
    simp only [twoArmBit, hne, if_false, h, decide_false, bitReward_false]
    exact (twoArmReward_mem _ _ _).1

def twoArmMixedRecommendation : TwoArmAction → ℝ := Pi.single 0 1

def historyPolicy (A : QPolicy 2) (t : ℕ) (h : TwoArmTrace.{u} t) : TwoArmAction → ℝ :=
  A t (fun _ => twoArmMixedRecommendation) (fun _ => 0)
    (fun i => (TrialTape.read i h).1) (fun i => bitReward (TrialTape.read i h).2)

abbrev ProbabilityPolicy (A : QPolicy 2) :=
  ∀ t q J I r, IsProbVec (A t q J I r)

theorem historyPolicy_prob {A : QPolicy 2} (hA : ProbabilityPolicy A) (t : ℕ)
    (h : TwoArmTrace.{u} t) : IsProbVec (historyPolicy A t h) :=
  hA t _ _ _ _

theorem twoArm_prob_zero_mem {p : TwoArmAction → ℝ} (hp : IsProbVec p) :
    p 0 ∈ Icc (0 : ℝ) 1 := by
  have hs := hp.2
  rw [Fin.sum_univ_two] at hs
  exact ⟨hp.1 0, by linarith [hp.1 1]⟩

noncomputable def drawTwoArm (p : TwoArmAction → ℝ) (x : ℝ) : TwoArmAction :=
  if x < p 0 then 0 else 1

theorem measurable_drawTwoArm (p : TwoArmAction → ℝ) : Measurable (drawTwoArm p) :=
  Measurable.ite measurableSet_Iio measurable_const measurable_const

theorem drawTwoArm_real {p : TwoArmAction → ℝ} (hp : IsProbVec p) (i : TwoArmAction) :
    twoArmUniform.real (drawTwoArm p ⁻¹' {i}) = p i := by
  have hs := hp.2
  rw [Fin.sum_univ_two] at hs
  fin_cases i
  · have he : drawTwoArm p ⁻¹' {(0 : TwoArmAction)} = Iio (p 0) := by
      ext x
      by_cases h : x < p 0 <;> simp [drawTwoArm, h]
    change twoArmUniform.real (drawTwoArm p ⁻¹' {(0 : TwoArmAction)}) = p 0
    rw [he, twoArmUniform_real_lt (twoArm_prob_zero_mem hp)]
  · have he : drawTwoArm p ⁻¹' {(1 : TwoArmAction)} = (Iio (p 0))ᶜ := by
      ext x
      by_cases h : x < p 0
      · simp [drawTwoArm, h, not_le.mpr h]
      · simp [drawTwoArm, h, not_lt.mp h]
    change twoArmUniform.real (drawTwoArm p ⁻¹' {(1 : TwoArmAction)}) = p 1
    rw [he, measureReal_compl measurableSet_Iio, probReal_univ, twoArmUniform_real_lt (twoArm_prob_zero_mem hp)]
    linarith

noncomputable def pickTwoArm (A : QPolicy 2) (t : ℕ) (h : TwoArmTrace.{u} t) (x : ℝ) : TwoArmAction :=
  drawTwoArm (historyPolicy A t h) x

theorem measurable_pickTwoArm (A : QPolicy 2) (t : ℕ) :
    Measurable (fun p : TwoArmTrace.{u} t × ℝ => pickTwoArm A t p.1 p.2) := by
  unfold pickTwoArm drawTwoArm
  have hp : Measurable (fun h : TwoArmTrace.{u} t => historyPolicy A t h 0) := measurable_of_countable _
  exact Measurable.ite (measurableSet_lt measurable_snd (hp.comp measurable_fst))
    measurable_const measurable_const

abbrev TwoArmRaw (t : ℕ) := TrialTape.{u} (ℝ × ℝ) t
abbrev TwoArmSeed (t : ℕ) := TrialTape.{u} ℝ t

noncomputable def twoArmTrace (A : QPolicy 2) (p : ℝ) :
    (t : ℕ) → TwoArmRaw.{u} t → TwoArmTrace.{u} t
  | 0, _ => ULift.up ()
  | t + 1, x =>
    let h := twoArmTrace A p t x.1
    let i := pickTwoArm A t h x.2.1
    (h, i, twoArmBit p x.2.2 i)

theorem measurable_twoArmTrace (A : QPolicy 2) (p : ℝ) (t : ℕ) :
    Measurable (twoArmTrace.{u} A p t) := by
  induction t with
  | zero => exact measurable_const
  | succ t ih =>
    let h := fun x : TwoArmRaw.{u} (t+1) => twoArmTrace A p t x.1
    have hm : Measurable h := ih.comp measurable_fst
    let a := fun x : TwoArmRaw.{u} (t+1) => pickTwoArm A t (h x) x.2.1
    have ha : Measurable a :=
      (measurable_pickTwoArm A t).comp (hm.prodMk (measurable_fst.comp measurable_snd))
    let b := fun x : TwoArmRaw.{u} (t+1) => twoArmBit p x.2.2 (a x)
    have hb : Measurable b := measurable_twoArm_select
      (f := fun i x => twoArmBit p x.2.2 i) ha
      (fun i => (measurable_twoArmBit p i).comp (measurable_snd.comp measurable_snd))
    exact hm.prodMk (ha.prodMk hb)

theorem take_twoArmTrace (A : QPolicy 2) (p : ℝ) {m n : ℕ} (h : m ≤ n)
    (x : TwoArmRaw.{u} n) :
    TrialTape.take h (twoArmTrace A p n x) = twoArmTrace A p m (TrialTape.take h x) := by
  induction h with
  | refl => simp
  | step h ih =>
    rw [TrialTape.take_succ (α := TwoArmObservation) h, TrialTape.take_succ (α := ℝ × ℝ) h]
    exact ih x.1

theorem read_twoArmTrace (A : QPolicy 2) (p : ℝ) {T : ℕ}
    (x : TwoArmRaw.{u} T) (t : Fin T) :
    TrialTape.read t (twoArmTrace A p T x) =
      let a := pickTwoArm A t (twoArmTrace A p t (TrialTape.take t.isLt.le x))
        (TrialTape.read t x).1
      (a, twoArmBit p (TrialTape.read t x).2 a) := by
  unfold TrialTape.read
  rw [take_twoArmTrace]
  have he := congrFun
    (TrialTape.take_comp (α := ℝ × ℝ) (Nat.le_succ (t : ℕ)) (Nat.succ_le_of_lt t.isLt)) x
  rw [TrialTape.take_succ (le_refl (t : ℕ)), TrialTape.take_refl, Function.id_comp] at he
  simp only [Function.comp_apply] at he
  simp only [twoArmTrace, he]

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

open MeasureTheory Set ProbabilityTheory
open scoped ENNReal Function

universe u

theorem take_zip {α β : Type} {n m : ℕ} (h : n ≤ m)
    (a : TrialTape.{u} α m) (b : TrialTape.{u} β m) :
    TrialTape.take h (TrialTape.zip m (a,b)) =
      TrialTape.zip n (TrialTape.take h a, TrialTape.take h b) := by
  induction h with
  | refl => simp
  | step h ih =>
    rw [TrialTape.take_succ (α := α × β) h, TrialTape.take_succ (α := α) h,
      TrialTape.take_succ (α := β) h]
    exact ih a.1 b.1

/-- The action in round `t` on a tape of joint primitive draws. -/
noncomputable def playedOnTape (A : QPolicy 2) (p : ℝ) {T : ℕ} (t : ℕ) (x : TwoArmRaw.{u} T) :
    TwoArmAction :=
  if ht : t < T then (TrialTape.read ⟨t,ht⟩ (twoArmTrace A p T x)).1 else 0

/-- The reward from an oblivious environment tape. Values past the horizon
are immaterial and have been set to zero. -/
noncomputable def rewardOnTape (p : ℝ) {T : ℕ} (t : ℕ) (x : TwoArmSeed.{u} T) (i : TwoArmAction) : ℝ :=
  if ht : t < T then twoArmReward p (TrialTape.read ⟨t,ht⟩ x) i else 0

theorem playedOnTape_eq (A : QPolicy 2) (p : ℝ) {T t : ℕ} (ht : t < T) (x : TwoArmRaw.{u} T) :
    playedOnTape A p t x =
      pickTwoArm A t (twoArmTrace A p t (TrialTape.take ht.le x))
        (TrialTape.read ⟨t,ht⟩ x).1 := by
  unfold playedOnTape
  rw [dif_pos ht, read_twoArmTrace]

theorem measurable_playedOnTape (A : QPolicy 2) (p : ℝ) {T : ℕ} (t : ℕ) :
    Measurable (playedOnTape.{u} A p (T := T) t) := by
  unfold playedOnTape
  split
  · exact measurable_fst.comp ((TrialTape.measurable_read _).comp (measurable_twoArmTrace A p T))
  · exact measurable_const

/-- Conditional play in round `t` is precisely the policy's distribution,
even when the learner reads the current and past recommendations. -/
theorem fixed_play_law (A : QPolicy 2) (hA : ProbabilityPolicy A) (p : ℝ)
    {T t : ℕ} (ht : t < T) (e : TwoArmSeed.{u} T) (i : TwoArmAction) :
    let P := TrialTape.law twoArmUniform T
    let I (t : ℕ) (w : TwoArmSeed.{u} T) := playedOnTape A p t (TrialTape.zip T (w,e))
    P[((I t ⁻¹' {i}).indicator (fun _ => (1 : ℝ))) |
      TrialTape.filtration (α := ℝ) T t] =ᵐ[P]
      fun w => A t (fun _ => twoArmMixedRecommendation) (fun _ => 0)
        (fun s => I s w) (fun s => rewardOnTape p s e (I s w)) i := by
  intro P I
  letI : IsProbabilityMeasure (TrialTape.law.{u} twoArmUniform (t+1)) :=
    TrialTape.probabilityLaw twoArmUniform (t+1)
  let hHist (w : TwoArmSeed.{u} t) : TwoArmTrace.{u} t :=
    twoArmTrace A p t (TrialTape.zip t (w, TrialTape.take ht.le e))
  have mhHist : Measurable hHist :=
    (measurable_twoArmTrace A p t).comp
      ((TrialTape.measurePreserving_zip twoArmUniform twoArmUniform t).measurable.comp
        (measurable_id.prodMk measurable_const))
  let action (w : TwoArmSeed.{u} (t+1)) := pickTwoArm A t (hHist w.1) w.2
  have mAction : Measurable action :=
    (measurable_pickTwoArm A t).comp ((mhHist.comp measurable_fst).prodMk measurable_snd)
  let f (w : TwoArmSeed.{u} (t+1)) : ℝ :=
    (action ⁻¹' {i}).indicator (fun _ => 1) w
  have mf : Measurable f := measurable_const.indicator (mAction (measurableSet_singleton i))
  have intF : Integrable f (TrialTape.law twoArmUniform (t+1)) :=
    (integrable_const 1).indicator (mAction (measurableSet_singleton i))
  let pre : TwoArmSeed.{u} T → TwoArmSeed.{u} (t+1) := TrialTape.take (Nat.succ_le_of_lt ht)
  have hF : ((I t ⁻¹' {i}).indicator (fun _ => (1 : ℝ))) = f ∘ pre := by
    funext w
    have he : I t w = action (pre w) := by
      change playedOnTape A p t (TrialTape.zip T (w,e)) = _
      rw [playedOnTape_eq A p ht, take_zip, TrialTape.read_zip]
      change pickTwoArm _ _ (hHist (TrialTape.take ht.le w)) (pre w).2 =
        pickTwoArm _ _ (hHist (pre w).1) (pre w).2
      rw [← TrialTape.take_comp (Nat.le_succ t) (Nat.succ_le_of_lt ht)]
      simp [TrialTape.take_succ (le_refl t), Function.comp_apply, pre]
    simp only [f, he, Function.comp_apply, Set.indicator, mem_preimage, mem_singleton_iff]
  rw [hF]
  refine (TrialTape.condExp_step twoArmUniform ht f mf intF).trans ?_
  exact ae_of_all _ fun w => by
    change (∫ b, f ((pre w).1, b) ∂twoArmUniform) = _
    let h := hHist (pre w).1
    have hf : (fun b : ℝ => f ((pre w).1,b)) =
        (drawTwoArm (historyPolicy A t h) ⁻¹' {i}).indicator (fun _ => (1 : ℝ)) := rfl
    rw [hf, integral_indicator_const 1 ((measurable_drawTwoArm _)
      (measurableSet_singleton _)), smul_eq_mul, mul_one, drawTwoArm_real (historyPolicy_prob hA t h)]
    have hpref : (pre w).1 = TrialTape.take ht.le w := by
      rw [← TrialTape.take_comp (Nat.le_succ t) (Nat.succ_le_of_lt ht)]
      simp [TrialTape.take_succ (le_refl t), Function.comp_apply, pre]
    have htrace : h = TrialTape.take ht.le (twoArmTrace A p T (TrialTape.zip T (w,e))) := by
      dsimp only [h,hHist]
      rw [hpref, take_twoArmTrace, take_zip]
    have hi (s : Fin t) :
        (TrialTape.read s h).1 = I s w := by
      rw [htrace, TrialTape.read_take]
      simp [I, playedOnTape, s.isLt.trans ht, Fin.castLE]
    have hy (s : Fin t) :
        bitReward (TrialTape.read s h).2 = rewardOnTape p s e (I s w) := by
      rw [htrace, TrialTape.read_take]
      change bitReward (TrialTape.read (Fin.castLE ht.le s)
        (twoArmTrace A p T (TrialTape.zip T (w,e)))).2 = _
      rw [read_twoArmTrace, TrialTape.read_zip]
      have he := playedOnTape_eq A p (s.isLt.trans ht) (TrialTape.zip T (w,e))
      dsimp only [I]
      rw [he]
      simp [twoArmReward, rewardOnTape, s.isLt.trans ht, TrialTape.read_zip, Fin.castLE]
    simp only [historyPolicy, hi, hy]

noncomputable def twoArmFixedRun (A : QPolicy 2) (hA : ProbabilityPolicy A) (p : ℝ)
    {T : ℕ} (e : TwoArmSeed.{u} T) :
    QProtocolRun 2 T (TrialTape.law twoArmUniform T) A where
  info := TrialTape.filtration (α := ℝ) T
  q := fun _ _ => twoArmMixedRecommendation
  y := fun t _ => rewardOnTape p t e
  J := fun _ _ => 0
  I := fun t w => playedOnTape A p t (TrialTape.zip T (w,e))
  info_le := fun t _ => (TrialTape.filtration (α := ℝ) T).le t
  info_mono := fun _ _ => (TrialTape.filtration (α := ℝ) T).mono (Nat.le_succ _)
  q_measurable := fun _ _ => measurable_const
  y_measurable := fun _ _ => measurable_const
  J_measurable := fun _ _ => measurable_const
  I_measurable := by
    intro t ht
    let hVec (w : TwoArmSeed.{u} (t+1)) : TwoArmAction :=
      playedOnTape A p t (TrialTape.zip (t+1) (w, TrialTape.take (Nat.succ_le_of_lt ht) e))
    have hm : Measurable hVec :=
      (measurable_playedOnTape A p t).comp
        ((TrialTape.measurePreserving_zip twoArmUniform twoArmUniform (t+1)).measurable.comp
          (measurable_id.prodMk measurable_const))
    convert TrialTape.measurable_step ht hVec hm using 1
    funext ω
    dsimp only [hVec, Function.comp_apply]
    unfold playedOnTape
    have he := take_twoArmTrace A p (Nat.succ_le_of_lt ht) (TrialTape.zip T (ω,e))
    rw [take_zip] at he
    simp only [dif_pos ht, dif_pos (Nat.lt_succ_self t)]
    rw [← he, TrialTape.read_take]
    rfl
  q_nonneg := by
    intro t ht ω i
    simp only [twoArmMixedRecommendation, Pi.single_apply]
    split <;> norm_num
  q_sum := by
    intro t ht ω
    simp [twoArmMixedRecommendation]
  y_mem := by
    intro t ht ω i
    simpa [rewardOnTape, ht] using twoArmReward_mem p (TrialTape.read ⟨t,ht⟩ e) i
  J_law := by
    intro t ht j
    by_cases h : (0 : TwoArmAction) = j
    · subst j
      simp only [preimage_const_of_mem (mem_singleton _), indicator_univ]
      rw [condExp_const ((TrialTape.filtration (α := ℝ) T).le t)]
      simp [twoArmMixedRecommendation]
    · have he : (fun _ : TwoArmSeed.{u} T => (0 : TwoArmAction)) ⁻¹' {j} = ∅ :=
        preimage_const_of_notMem (by simpa using h)
      simp [he, twoArmMixedRecommendation, Pi.single_apply, h, Ne.symm h]
  I_law := by
    intro t ht i
    rw [MeasurableSpace.comap_const, sup_bot_eq]
    have h := fixed_play_law A hA p ht e i
    simpa [playedOnTape, rewardOnTape] using h

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

open MeasureTheory ProbabilityTheory InformationTheory Set
open scoped ENNReal Function

universe u

noncomputable def twoArmBitLaw (p : ℝ) : Measure Bool :=
  twoArmUniform.map (fun x => twoArmBit p x 1)

instance twoArmBitLaw_prob (p : ℝ) : IsProbabilityMeasure (twoArmBitLaw p) :=
  Measure.isProbabilityMeasure_map (measurable_twoArmBit p 1).aemeasurable

theorem twoArmBitLaw_true {p : ℝ} (hp : p ∈ Icc (0 : ℝ) 1) :
    (twoArmBitLaw p).real {true} = p := by
  unfold twoArmBitLaw
  have he : (fun x => twoArmBit p x 1) ⁻¹' {true} = Iio p := by
    ext x
    simp [twoArmBit]
  rw [measureReal_def, Measure.map_apply (measurable_twoArmBit p 1) (measurableSet_singleton _),
    he, ← measureReal_def]
  exact twoArmUniform_real_lt hp

theorem twoArmBitLaw_false {p : ℝ} (hp : p ∈ Icc (0 : ℝ) 1) :
    (twoArmBitLaw p).real {false} = 1 - p := by
  have he : ({true} : Set Bool)ᶜ = {false} := by ext b; cases b <;> simp
  rw [← he, measureReal_compl (measurableSet_singleton true), probReal_univ, twoArmBitLaw_true hp]

private theorem twoArmBitLaw_ac (p : ℝ) {q : ℝ} (hq : q ∈ Ioo (0 : ℝ) 1) :
    twoArmBitLaw p ≪ twoArmBitLaw q := by
  refine Measure.AbsolutelyContinuous.mk ?_
  intro s hs hzero
  have hpos (b : Bool) : 0 < (twoArmBitLaw q).real {b} := by
    have hq' : q ∈ Icc (0 : ℝ) 1 := ⟨hq.1.le,hq.2.le⟩
    cases b
    · rw [twoArmBitLaw_false hq']; exact sub_pos.mpr hq.2
    · rw [twoArmBitLaw_true hq']; exact hq.1
  have hs0 : s = ∅ := by
    by_contra hne
    obtain ⟨b,hb⟩ := Set.nonempty_iff_ne_empty.mpr hne
    have hh := measure_mono (singleton_subset_iff.mpr hb) (μ := twoArmBitLaw q)
    rw [hzero, nonpos_iff_eq_zero] at hh
    have hp := hpos b
    rw [measureReal_def, hh, ENNReal.toReal_zero] at hp
    exact (lt_irrefl _ hp)
  simp [hs0]

theorem twoArmBitLaw_divergence {d : ℝ} (hd : 0 ≤ d) (hd' : d ≤ 1/4) :
    klDiv (twoArmBitLaw (1/2 - d)) (twoArmBitLaw (1/2 + d)) ≤ ENNReal.ofReal (12 * d^2) := by
  let μ := twoArmBitLaw (1/2 - d)
  let ν := twoArmBitLaw (1/2 + d)
  have hp : (1/2 - d : ℝ) ∈ Icc 0 1 := ⟨by linarith, by linarith⟩
  have hq : (1/2 + d : ℝ) ∈ Ioo 0 1 := ⟨by linarith, by linarith⟩
  have hac : μ ≪ ν := twoArmBitLaw_ac _ hq
  have hInt : Integrable (llr μ ν) μ := by
    apply Integrable.of_bound (measurable_of_countable (llr μ ν)).aestronglyMeasurable
      (max ‖llr μ ν false‖ ‖llr μ ν true‖)
    exact ae_of_all _ fun b => by cases b; exacts [le_max_left _ _, le_max_right _ _]
  have hfin := (klDiv_ne_top_iff.mpr ⟨hac,hInt⟩)
  have hEq := toReal_klDiv_bool μ ν hac (by
    change (twoArmBitLaw _).real {true} ∈ _
    rwa [twoArmBitLaw_true ⟨hq.1.le,hq.2.le⟩])
  rw [show μ.real {true} = _ from twoArmBitLaw_true hp,
      show ν.real {true} = _ from twoArmBitLaw_true ⟨hq.1.le,hq.2.le⟩] at hEq
  change klDiv μ ν ≤ _
  rw [← ENNReal.ofReal_toReal hfin, hEq]
  exact ENNReal.ofReal_le_ofReal (twoArm_binaryEntropy_le hd hd')

noncomputable def twoArmActionKernel (A : QPolicy 2) (t : ℕ) :
    Kernel (TwoArmTrace.{u} t) TwoArmAction :=
  ⟨fun h => twoArmUniform.map (fun x => pickTwoArm A t h x), measurable_of_countable _⟩

instance twoArmActionKernel_markov (A : QPolicy 2) (t : ℕ) :
    IsMarkovKernel (twoArmActionKernel.{u} A t) :=
  ⟨fun h => Measure.isProbabilityMeasure_map (measurable_drawTwoArm (historyPolicy A t h)).aemeasurable⟩

def twoArmSecondEvent (t : ℕ) : Set (TwoArmTrace.{u} t × TwoArmAction) := Prod.snd ⁻¹' {1}

theorem measurableSet_twoArmSecondEvent (t : ℕ) : MeasurableSet (twoArmSecondEvent.{u} t) :=
  measurable_snd (measurableSet_singleton _)

noncomputable def twoArmBitKernel (p : ℝ) (t : ℕ) :
    Kernel (TwoArmTrace.{u} t × TwoArmAction) Bool := by
  classical
  exact Kernel.piecewise (measurableSet_twoArmSecondEvent t)
    (Kernel.const _ (twoArmBitLaw p)) (Kernel.const _ (twoArmBitLaw (1/2)))

instance twoArmBitKernel_markov (p : ℝ) (t : ℕ) :
    IsMarkovKernel (twoArmBitKernel.{u} p t) := by
  classical
  unfold twoArmBitKernel
  infer_instance

theorem twoArmBitKernel_eq_map (p : ℝ) (t : ℕ) (h : TwoArmTrace.{u} t × TwoArmAction) :
    twoArmBitKernel p t h = twoArmUniform.map (fun x => twoArmBit p x h.2) := by
  classical
  rcases h with ⟨h,i⟩
  fin_cases i <;>
    simp [twoArmBitKernel, Kernel.piecewise_apply, twoArmSecondEvent, twoArmBitLaw, twoArmBit]

noncomputable def twoArmJointLaw (T : ℕ) : Measure (TwoArmRaw.{u} T) :=
  TrialTape.law (twoArmUniform.prod twoArmUniform) T

instance twoArmJointLaw_prob (T : ℕ) : IsProbabilityMeasure (twoArmJointLaw.{u} T) :=
  inferInstanceAs (IsProbabilityMeasure (TrialTape.law _ T))

noncomputable def twoArmTraceLaw (A : QPolicy 2) (p : ℝ) (t : ℕ) : Measure (TwoArmTrace.{u} t) :=
  (twoArmJointLaw t).map (twoArmTrace A p t)

instance twoArmTraceLaw_prob (A : QPolicy 2) (p : ℝ) (t : ℕ) :
    IsProbabilityMeasure (twoArmTraceLaw.{u} A p t) :=
  Measure.isProbabilityMeasure_map (measurable_twoArmTrace A p t).aemeasurable

theorem twoArmTraceLaw_take (A : QPolicy 2) (p : ℝ) {m n : ℕ} (h : m ≤ n) :
    (twoArmTraceLaw.{u} A p n).map (TrialTape.take h) = twoArmTraceLaw A p m := by
  unfold twoArmTraceLaw twoArmJointLaw
  rw [Measure.map_map (TrialTape.measurable_take h) (measurable_twoArmTrace A p n)]
  have he : TrialTape.take h ∘ twoArmTrace A p n = twoArmTrace A p m ∘ TrialTape.take h :=
    funext (take_twoArmTrace A p h)
  rw [he, ← Measure.map_map (measurable_twoArmTrace A p m) (TrialTape.measurable_take h),
    TrialTape.take_law]

theorem twoArmTraceLaw_succ (A : QPolicy 2) (p : ℝ) (t : ℕ) :
    twoArmTraceLaw.{u} A p (t+1) =
      ((twoArmTraceLaw A p t ⊗ₘ twoArmActionKernel A t) ⊗ₘ twoArmBitKernel p t).map
        MeasurableEquiv.prodAssoc := by
  let μ := twoArmJointLaw.{u} t
  let U := twoArmUniform
  let g (z : TwoArmRaw.{u} t × ℝ) : TwoArmTrace.{u} t × TwoArmAction :=
    (twoArmTrace A p t z.1, pickTwoArm A t (twoArmTrace A p t z.1) z.2)
  have hm : Measurable g := by
    have ha := (measurable_twoArmTrace A p t).comp
      (measurable_fst : Measurable (Prod.fst : TwoArmRaw.{u} t × ℝ → TwoArmRaw.{u} t))
    exact ha.prodMk ((measurable_pickTwoArm A t).comp (ha.prodMk measurable_snd))
  have hg : (μ.prod U).map g = twoArmTraceLaw A p t ⊗ₘ twoArmActionKernel A t :=
    TrialTape.map_product_append μ U (twoArmTrace A p t) (measurable_twoArmTrace A p t)
      (fun p => pickTwoArm A t p.1 p.2) (measurable_pickTwoArm A t)
      (twoArmActionKernel A t) (fun _ => rfl)
  have hb : ((μ.prod U).prod U).map
      (fun z => (g z.1, twoArmBit p z.2 (g z.1).2)) =
      ((μ.prod U).map g) ⊗ₘ twoArmBitKernel p t :=
    TrialTape.map_product_append (μ.prod U) U g hm
      (fun z => twoArmBit p z.2 z.1.2) (measurable_twoArm_select
        (f := fun i z => twoArmBit p z.2 i)
        (measurable_snd.comp measurable_fst)
        (fun i => (measurable_twoArmBit p i).comp measurable_snd))
      (twoArmBitKernel p t) (twoArmBitKernel_eq_map p t)
  rw [hg] at hb
  have hobs : Measurable (fun z : (TwoArmRaw.{u} t × ℝ) × ℝ =>
      (g z.1, twoArmBit p z.2 (g z.1).2)) :=
    (hm.comp measurable_fst).prodMk (measurable_twoArm_select
      (f := fun i z => twoArmBit p z.2 i)
      (measurable_snd.comp (hm.comp measurable_fst))
      (fun i => (measurable_twoArmBit p i).comp measurable_snd))
  rw [← hb, Measure.map_map MeasurableEquiv.prodAssoc.measurable hobs]
  have hz : twoArmJointLaw.{u} (t+1) =
      ((μ.prod U).prod U).map MeasurableEquiv.prodAssoc :=
    (Measure.prodAssoc_prod (μ := μ) (ν := U) (τ := U)).symm
  change (twoArmJointLaw (t+1)).map (twoArmTrace A p (t+1)) = _
  rw [hz, Measure.map_map (measurable_twoArmTrace A p (t+1)) MeasurableEquiv.prodAssoc.measurable]
  rfl

def twoArmHit {T : ℕ} (i : Fin T) : Set (TwoArmTrace.{u} T) :=
  {h | (TrialTape.read i h).1 = 1}

theorem measurableSet_twoArmHit {T : ℕ} (i : Fin T) :
    MeasurableSet (twoArmHit.{u} i) :=
  (measurable_fst.comp (TrialTape.measurable_read _)) (measurableSet_singleton _)

theorem twoArmHit_traceLaw_take (A : QPolicy 2) (p : ℝ) {m n : ℕ}
    (h : m ≤ n) (i : Fin m) :
    twoArmTraceLaw.{u} A p n (twoArmHit (Fin.castLE h i)) =
      twoArmTraceLaw.{u} A p m (twoArmHit i) := by
  have hset : TrialTape.take h ⁻¹' twoArmHit.{u} i = twoArmHit (Fin.castLE h i) := by
    ext x
    simp only [mem_preimage, twoArmHit, mem_setOf_eq, TrialTape.read_take]
  rw [← hset, ← Measure.map_apply (TrialTape.measurable_take h) (measurableSet_twoArmHit _),
    twoArmTraceLaw_take]

theorem twoArmHit_traceLaw_last (A : QPolicy 2) (p : ℝ) (t : ℕ) :
    twoArmTraceLaw.{u} A p (t+1) (twoArmHit (Fin.last t)) =
      (twoArmTraceLaw.{u} A p t ⊗ₘ twoArmActionKernel A t) (twoArmSecondEvent t) := by
  rw [twoArmTraceLaw_succ, Measure.map_apply MeasurableEquiv.prodAssoc.measurable
    (measurableSet_twoArmHit _)]
  have hset : (MeasurableEquiv.prodAssoc : ((TwoArmTrace.{u} t × TwoArmAction) × Bool) ≃ᵐ
      TwoArmTrace.{u} (t+1)) ⁻¹' twoArmHit (Fin.last t) =
      Prod.fst ⁻¹' twoArmSecondEvent t := by
    ext z
    simp only [mem_preimage, twoArmHit, twoArmSecondEvent, mem_ofPred_eq, TrialTape.read_last,
      mem_singleton_iff]
    rfl
  rw [hset, ← Measure.map_apply measurable_fst (measurableSet_twoArmSecondEvent _),
    ← Measure.fst, Measure.fst_compProd]

theorem twoArmTraceLaw_kl (A : QPolicy 2) {d : ℝ} (hd : 0 ≤ d) (hd' : d ≤ 1/4)
    (T : ℕ) :
    klDiv (twoArmTraceLaw.{u} A (1/2-d) T) (twoArmTraceLaw.{u} A (1/2+d) T)
      ≤ ENNReal.ofReal (12*d^2) *
          ∑ i : Fin T, twoArmTraceLaw.{u} A (1/2-d) T (twoArmHit i) := by
  classical
  let G (t : ℕ) := twoArmTraceLaw.{u} A (1/2-d) t
  let B (t : ℕ) := twoArmTraceLaw.{u} A (1/2+d) t
  let k := ENNReal.ofReal (12*d^2)
  change klDiv (G T) (B T) ≤ _
  induction T with
  | zero =>
    letI : IsProbabilityMeasure (B 0) := twoArmTraceLaw_prob A _ _
    have he : G 0 = B 0 := rfl
    rw [he, klDiv_self]
    exact zero_le
  | succ t ih =>
    have hG := twoArmTraceLaw_succ.{u} A (1/2-d) t
    have hB := twoArmTraceLaw_succ.{u} A (1/2+d) t
    change G (t+1) = _ at hG
    change B (t+1) = _ at hB
    conv_lhs => rw [hG,hB]
    refine (klDiv_map_le _ _ MeasurableEquiv.prodAssoc.measurable).trans ?_
    let G' := G t ⊗ₘ twoArmActionKernel A t
    let B' := B t ⊗ₘ twoArmActionKernel A t
    letI : IsProbabilityMeasure (G t) := twoArmTraceLaw_prob A _ _
    letI : IsProbabilityMeasure (B t) := twoArmTraceLaw_prob A _ _
    letI : IsProbabilityMeasure G' := by dsimp [G']; infer_instance
    letI : IsProbabilityMeasure B' := by dsimp [B']; infer_instance
    have hchain := klDiv_compProd_changed_on G' B' (measurableSet_twoArmSecondEvent t)
      (twoArmBitLaw (1/2-d)) (twoArmBitLaw (1/2+d))
      (twoArmBitLaw_ac _ (by constructor <;> linarith : (1/2+d : ℝ) ∈ Ioo 0 1))
      (Kernel.const _ (twoArmBitLaw (1/2)))
    change klDiv (G' ⊗ₘ twoArmBitKernel _ _) (B' ⊗ₘ twoArmBitKernel _ _) ≤ _
    rw [show klDiv (G' ⊗ₘ twoArmBitKernel _ _) (B' ⊗ₘ twoArmBitKernel _ _) =
        klDiv G' B' + klDiv (twoArmBitLaw (1/2-d)) (twoArmBitLaw (1/2+d)) * G' (twoArmSecondEvent t) from hchain]
    have hleft : klDiv G' B' = klDiv (G t) (B t) := klDiv_compProd_left _ _ _
    rw [hleft]
    change klDiv (G t) (B t) + _ ≤ k * ∑ i : Fin (t+1), G (t+1) (twoArmHit i)
    rw [Fin.sum_univ_castSucc, mul_add]
    have hprev (i : Fin t) : G (t+1) (twoArmHit i.castSucc) = G t (twoArmHit i) :=
      twoArmHit_traceLaw_take A _ (Nat.le_succ t) i
    simp only [hprev]
    rw [show G (t+1) (twoArmHit (Fin.last t)) = G' (twoArmSecondEvent t)
      from twoArmHit_traceLaw_last A _ t]
    exact add_le_add ih (mul_le_mul_left (twoArmBitLaw_divergence hd hd') _)

/-- Expected number of plays of action one. -/
noncomputable def twoArmCount (A : QPolicy 2) (p : ℝ) (T : ℕ) : ℝ :=
  ∑ t : Fin T, (twoArmTraceLaw.{u} A p T).real (twoArmHit t)

theorem twoArmCount_nonneg (A : QPolicy 2) (p : ℝ) (T : ℕ) :
    0 ≤ twoArmCount.{u} A p T :=
  Finset.sum_nonneg fun _ _ => measureReal_nonneg

theorem twoArmCount_comparison (A : QPolicy 2) {d : ℝ} (hd : 0 ≤ d) (hd' : d ≤ 1/4)
    (T : ℕ) :
    twoArmCount.{u} A (1/2+d) T ≤ twoArmCount.{u} A (1/2-d) T +
      T * Real.sqrt (6 * d^2 * twoArmCount.{u} A (1/2-d) T) := by
  let G := twoArmTraceLaw.{u} A (1/2-d) T
  let B := twoArmTraceLaw.{u} A (1/2+d) T
  let g := twoArmCount.{u} A (1/2-d) T
  have hg : 0 ≤ g := twoArmCount_nonneg A _ _
  have hD : 0 ≤ 12 * d^2 * g := by positivity
  have hKL : klDiv G B ≤ ENNReal.ofReal (12*d^2*g) := by
    rw [ENNReal.ofReal_mul (by positivity : 0 ≤ 12*d^2)]
    unfold g twoArmCount
    rw [ENNReal.ofReal_sum_of_nonneg (fun _ _ => measureReal_nonneg)]
    simp_rw [measureReal_def, ENNReal.ofReal_toReal (measure_ne_top _ _)]
    exact twoArmTraceLaw_kl A hd hd' T
  have h := expected_hits_le_of_klDiv G B (fun i : Fin T => twoArmHit i)
    (fun _ => measurableSet_twoArmHit _) hD hKL
  rw [Fintype.card_fin, show 12*d^2*g/2 = 6*d^2*g by ring] at h
  exact h

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

namespace CalibeatBandit

open MeasureTheory

/-- The part of a bandit interaction needed to analyze a single draw per round.
The recommendation may have any label type and is included in the pre-draw
information. -/
structure DrawRun (K T : ℕ) {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) where
  info : ℕ → MeasurableSpace Ω
  preDraw : ℕ → MeasurableSpace Ω
  y : ℕ → Ω → Fin K → ℝ
  I : ℕ → Ω → Fin K
  played : ℕ → Ω → Fin K → ℝ
  info_le : ∀ t ≤ T, info t ≤ mΩ
  info_le_preDraw : ∀ t < T, info t ≤ preDraw t
  preDraw_le_succ : ∀ t < T, preDraw t ≤ info (t + 1)
  y_measurable : ∀ t < T, Measurable[preDraw t] (y t)
  I_measurable : ∀ t < T, Measurable[info (t + 1)] (I t)
  y_mem : ∀ t < T, ∀ ω i, y t ω i ∈ Set.Icc (0 : ℝ) 1
  I_law : ∀ t < T, ∀ i : Fin K,
    condExp (preDraw t) P ((I t ⁻¹' {i}).indicator (fun _ => (1 : ℝ))) =ᵐ[P]
      fun ω => played t ω i

namespace DrawRun

variable {K T : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}

def obs (run : DrawRun K T P) (t : ℕ) (ω : Ω) : ℝ :=
  run.y t ω (run.I t ω)

theorem info_le_info (run : DrawRun K T P) {a b : ℕ} (hab : a ≤ b) (hb : b ≤ T) :
    run.info a ≤ run.info b := by
  induction hab with
  | refl => exact le_rfl
  | step _ ih =>
    exact (ih (by omega)).trans ((run.info_le_preDraw _ (by omega)).trans (run.preDraw_le_succ _ (by omega)))

theorem preDraw_le_ambient (run : DrawRun K T P) {t : ℕ} (ht : t < T) :
    run.preDraw t ≤ mΩ :=
  (run.preDraw_le_succ t ht).trans (run.info_le _ (Nat.succ_le_of_lt ht))

theorem obs_measurable (run : DrawRun K T P) {t : ℕ} (ht : t < T) :
    Measurable[run.info (t + 1)] (run.obs t) :=
  @measurable_select Ω (run.info (t + 1)) (Fin K) _ _ _ _ (run.I_measurable t ht)
    (fun j ω => run.y t ω j) fun j => (measurable_pi_apply j).comp
      ((run.y_measurable t ht).mono (run.preDraw_le_succ t ht) le_rfl)

end DrawRun

def ProtocolRun.toDrawRun {K T : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} {policy : Policy K} (run : ProtocolRun K T P policy) : DrawRun K T P where
  info := run.info
  preDraw := run.preDraw
  y := run.y
  I := run.I
  played := run.played
  info_le := run.info_le
  info_le_preDraw := fun _ _ => le_sup_left
  preDraw_le_succ := fun _ ht => run.preDraw_le_succ ht
  y_measurable := fun t ht => (run.y_measurable t ht).mono le_sup_left le_rfl
  I_measurable := run.I_measurable
  y_mem := run.y_mem
  I_law := run.I_law

end CalibeatBandit

end

section

set_option autoImplicit false

open Filter MeasureTheory
open scoped BigOperators

namespace CalibeatBandit

theorem integrable_of_abs_bound {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P] {f : Ω → ℝ} (hm : Measurable f) {B : ℝ}
    (hb : ∀ ω, |f ω| ≤ B) : Integrable f P :=
  (integrable_const B).mono' hm.aestronglyMeasurable
    (ae_of_all _ fun ω => by simpa only [Real.norm_eq_abs] using hb ω)

theorem integral_exp_sum_le_one {T : ℕ} {Ω : Type*}
    [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (info preDraw : ℕ → MeasurableSpace Ω)
    (hinfo : ∀ a b, a ≤ b → b ≤ T → info a ≤ info b)
    (hinfo_le : ∀ n ≤ T, info n ≤ mΩ)
    (hpre : ∀ n < T, preDraw n ≤ mΩ)
    (hprev : ∀ n < T, info n ≤ preDraw n)
    (d : ℕ → Ω → ℝ) {B : ℝ}
    (hm : ∀ t < T, Measurable[info (t + 1)] (d t))
    (hb : ∀ t < T, ∀ ω, |d t ω| ≤ B)
    (hc : ∀ t < T, condExp (preDraw t) P (fun ω => Real.exp (d t ω)) ≤ᵐ[P] fun _ => 1) :
    ∫ ω, Real.exp (∑ t ∈ Finset.range T, d t ω) ∂P ≤ 1 := by
  let F (n : ℕ) (ω : Ω) := Real.exp (∑ t ∈ Finset.range n, d t ω)
  have hF (n : ℕ) (hn : n ≤ T) : Measurable[info n] (F n) := by
    refine Real.continuous_exp.measurable.comp (Finset.measurable_sum _ fun t ht => ?_)
    have hs := Nat.succ_le_of_lt (Finset.mem_range.mp ht)
    exact (hm t (lt_of_lt_of_le (Finset.mem_range.mp ht) hn)).mono
      (hinfo _ _ hs hn) le_rfl
  have hi (n : ℕ) (hn : n ≤ T) : Integrable (F n) P := by
    apply integrable_of_abs_bound ((hF n hn).mono (hinfo_le n hn) le_rfl)
    intro ω
    rw [show F n ω = Real.exp (∑ t ∈ Finset.range n, d t ω) from rfl,
      abs_of_pos (Real.exp_pos _)]
    apply Real.exp_le_exp.mpr
    calc
      _ ≤ ∑ _ ∈ Finset.range n, B := Finset.sum_le_sum fun t ht =>
        (le_abs_self _).trans (hb t ((Finset.mem_range.mp ht).trans_le hn) ω)
      _ = (n : ℝ) * B := by simp
  have step (n : ℕ) (hn : n < T) : (∫ ω, F (n + 1) ω ∂P) ≤ ∫ ω, F n ω ∂P := by
    let G : Ω → ℝ := fun ω => Real.exp (d n ω)
    have hG : Integrable G P := by
      refine integrable_of_abs_bound (B := Real.exp B) (Real.continuous_exp.measurable.comp
        ((hm n hn).mono (hinfo_le _ (Nat.succ_le_of_lt hn)) le_rfl)) ?_
      intro ω
      change |Real.exp (d n ω)| ≤ Real.exp B
      rw [abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.mpr ((le_abs_self _).trans (hb n hn ω))
    have heq : F (n + 1) = F n * G := by
      funext ω
      simp [F, G, Finset.sum_range_succ, Real.exp_add]
    have hprod : Integrable (F n * G) P := heq ▸ hi (n + 1) (Nat.succ_le_of_lt hn)
    have hpull := condExp_mul_of_stronglyMeasurable_left
      ((hF n hn.le).mono (hprev n hn) le_rfl).stronglyMeasurable
      hprod hG
    rw [heq, ← integral_condExp (m := preDraw n) (hpre n hn)]
    apply integral_mono_ae integrable_condExp (hi n hn.le)
    filter_upwards [hpull, hc n hn] with ω hw hcω
    rw [hw]
    exact mul_le_of_le_one_right (Real.exp_nonneg _) hcω
  have hbound (n : ℕ) (hn : n ≤ T) : (∫ ω, F n ω ∂P) ≤ 1 := by
    induction n with
    | zero => simp [F]
    | succ n ih =>
      have hh : n < T := Nat.lt_of_succ_le hn
      exact (step n hh).trans (ih hh.le)
  exact hbound T le_rfl

theorem DrawRun.integral_exp_sum_le_one {K T : ℕ} {Ω : Type*}
    [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (run : DrawRun K T P) (d : ℕ → Ω → ℝ) {B : ℝ}
    (hm : ∀ t < T, Measurable[run.info (t + 1)] (d t))
    (hb : ∀ t < T, ∀ ω, |d t ω| ≤ B)
    (hc : ∀ t < T, condExp (run.preDraw t) P (fun ω => Real.exp (d t ω)) ≤ᵐ[P] fun _ => 1) :
    ∫ ω, Real.exp (∑ t ∈ Finset.range T, d t ω) ∂P ≤ 1 :=
  CalibeatBandit.integral_exp_sum_le_one P run.info run.preDraw
    (fun _ _ h => run.info_le_info h) run.info_le
    (fun _ ht => run.preDraw_le_ambient ht) run.info_le_preDraw d hm hb hc

theorem integrable_finset_max {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    {P : Measure Ω} [IsFiniteMeasure P] (hne : (Finset.univ : Finset ι).Nonempty)
    (F : ι → Ω → ℝ) {B : ℝ} (hm : ∀ i, Measurable (F i)) (hb : ∀ i ω, |F i ω| ≤ B) :
    Integrable (fun ω => Finset.univ.sup' hne (fun i => F i ω)) P := by
  let _ : Nonempty ι := hne.to_subtype.map Subtype.val
  apply integrable_of_abs_bound
  · simp_rw [Finset.sup'_univ_eq_ciSup]
    exact Measurable.iSup hm
  · intro ω
    obtain ⟨i, _, hi⟩ := Finset.exists_mem_eq_sup' hne (fun i => F i ω)
    exact hi.symm ▸ hb i ω

/-- A finite maximum is bounded in expectation by the logarithm of the number
of competitors whenever each competitor has an exponential moment at most one. -/
theorem integral_max_le_log_card {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    (P : Measure Ω) [IsProbabilityMeasure P] (hne : (Finset.univ : Finset ι).Nonempty)
    (F : ι → Ω → ℝ) {η B : ℝ} (hη : 0 < η)
    (hm : ∀ i, Measurable (F i)) (hb : ∀ i ω, |F i ω| ≤ B)
    (he : ∀ i, ∫ ω, Real.exp (η * F i ω) ∂P ≤ 1) :
    ∫ ω, Finset.univ.sup' hne (fun i => F i ω) ∂P ≤ Real.log (Fintype.card ι) / η := by
  classical
  let M (ω : Ω) := Finset.univ.sup' hne (fun i => F i ω)
  let Z (ω : Ω) := ∑ i, Real.exp (η * F i ω)
  let N : ℝ := Fintype.card ι
  let H (ω : Ω) := Real.log N + (Z ω / N - 1)
  let _ : Nonempty ι := hne.to_subtype.map Subtype.val
  have hN : 0 < N := by
    dsimp [N]
    exact_mod_cast Fintype.card_pos (α := ι)
  have hM : Integrable M P := integrable_finset_max hne F hm hb
  have hei (i : ι) : Integrable (fun ω => Real.exp (η * F i ω)) P := by
    refine integrable_of_abs_bound (B := Real.exp (η * B))
      (Real.continuous_exp.measurable.comp ((hm i).const_mul η)) ?_
    intro ω
    rw [abs_of_pos (Real.exp_pos _)]
    exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left ((le_abs_self _).trans (hb i ω)) hη.le)
  have hZ : Integrable Z P := integrable_finsetSum _ fun i _ => hei i
  have hZi : (∫ ω, Z ω ∂P) ≤ N := by
    rw [show (∫ ω, Z ω ∂P) = ∑ i, ∫ ω, Real.exp (η * F i ω) ∂P from
      integral_finsetSum _ (fun i _ => hei i)]
    calc
      _ ≤ ∑ _ : ι, (1 : ℝ) := Finset.sum_le_sum fun i _ => he i
      _ = N := by simp [N]
  have hH : Integrable H P := (integrable_const _).add ((hZ.div_const N).sub (integrable_const _))
  have hpoint (ω : Ω) : η * M ω ≤ H ω := by
    obtain ⟨i, _, hi⟩ := Finset.exists_mem_eq_sup' hne (fun i => F i ω)
    have hle : Real.exp (η * M ω) ≤ Z ω := by
      change Real.exp (η * Finset.univ.sup' hne (fun i => F i ω)) ≤ Z ω
      rw [hi]
      exact Finset.single_le_sum (fun j _ => Real.exp_nonneg (η * F j ω)) (Finset.mem_univ i)
    have hz : 0 < Z ω := (Real.exp_pos _).trans_le hle
    have hl := Real.log_le_log (Real.exp_pos _) hle
    rw [Real.log_exp] at hl
    have hh := Real.log_le_sub_one_of_pos (div_pos hz hN)
    rw [Real.log_div hz.ne' hN.ne'] at hh
    dsimp [H]
    linarith only [hl, hh]
  have hHi : (∫ ω, H ω ∂P) ≤ Real.log N := by
    let W : Ω → ℝ := fun ω => Z ω / N
    change (∫ ω, Real.log N + (W ω - 1) ∂P) ≤ _
    have hW : Integrable W P := hZ.div_const N
    have hdiff : Integrable (fun ω => W ω - 1) P := hW.sub (integrable_const _)
    rw [integral_add (integrable_const _) hdiff, integral_sub hW (integrable_const _)]
    dsimp only [W]
    rw [integral_div]
    simp only [integral_const, Measure.real, measure_univ, ENNReal.toReal_one, smul_eq_mul, one_mul]
    linarith only [(div_le_one hN).mpr hZi]
  have hi := (integral_mono (hM.const_mul η) hH hpoint).trans hHi
  have heq : (∫ ω, η * M ω ∂P) = η * ∫ ω, M ω ∂P := integral_const_mul η M
  rw [heq] at hi
  exact (le_div_iff₀ hη).mpr (by simpa only [mul_comm] using hi)

end CalibeatBandit

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal Function

universe u

noncomputable def twoArmMean (p : ℝ) (i : TwoArmAction) : ℝ := if i = 0 then 1/2 else p

private theorem measurable_twoArmReward (p : ℝ) (i : TwoArmAction) :
    Measurable (fun z => twoArmReward p z i) :=
  (measurable_of_countable bitReward).comp (measurable_twoArmBit p i)

private theorem integrable_twoArmReward (p : ℝ) (i : TwoArmAction) :
    Integrable (fun z => twoArmReward p z i) twoArmUniform := by
  apply Integrable.of_bound (measurable_twoArmReward p i).aestronglyMeasurable 1
  exact ae_of_all _ fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (twoArmReward_mem p z i).1]
    exact (twoArmReward_mem p z i).2

private theorem integral_twoArmReward {p : ℝ} (hp : p ∈ Icc (0 : ℝ) 1) (i : TwoArmAction) :
    ∫ x, twoArmReward p x i ∂twoArmUniform = twoArmMean p i := by
  have hm : twoArmMean p i ∈ Icc (0 : ℝ) 1 := by
    unfold twoArmMean
    split
    · norm_num
    · exact hp
  have he : (fun x => twoArmReward p x i) =
      (Iio (twoArmMean p i)).indicator (fun _ => (1 : ℝ)) := by
    funext x
    change bitReward (decide (x < twoArmMean p i)) = _
    by_cases hx : x < twoArmMean p i <;>
      simp [hx, Set.indicator]
  rw [he, integral_indicator_const 1 measurableSet_Iio, smul_eq_mul, mul_one,
    twoArmUniform_real_lt hm]

/-- The reward at a round on the joint tape, using its environment coordinate. -/
noncomputable def jointReward (p : ℝ) {T : ℕ} (x : TwoArmRaw.{u} T) (t : ℕ) (i : TwoArmAction) : ℝ :=
  if ht : t < T then twoArmReward p (TrialTape.read ⟨t,ht⟩ x).2 i else 0

theorem jointReward_mem (p : ℝ) {T : ℕ} (x : TwoArmRaw.{u} T) (t : ℕ) (i : TwoArmAction) :
    jointReward p x t i ∈ Icc (0 : ℝ) 1 := by
  unfold jointReward
  split
  · exact twoArmReward_mem _ _ _
  · norm_num

theorem measurable_jointReward (p : ℝ) {T : ℕ} (t : ℕ) (i : TwoArmAction) :
    Measurable fun x : TwoArmRaw.{u} T => jointReward p x t i := by
  unfold jointReward
  split
  · exact (measurable_twoArmReward p i).comp (measurable_snd.comp (TrialTape.measurable_read _))
  · exact measurable_const

@[simp] theorem jointReward_zip (p : ℝ) {T : ℕ} (seed env : TwoArmSeed.{u} T)
    (t : ℕ) (i : TwoArmAction) :
    jointReward p (TrialTape.zip T (seed,env)) t i = rewardOnTape p t env i := by
  unfold jointReward rewardOnTape
  split
  · simp [TrialTape.read_zip, *]
  · simp_all

theorem jointReward_optimal {p : ℝ} (hp : p ≤ 1/2) {T : ℕ}
    (x : TwoArmRaw.{u} T) {t : ℕ} (ht : t < T) :
    jointReward p x t 1 ≤ jointReward p x t 0 := by
  unfold jointReward
  simp only [dif_pos ht]
  exact twoArmReward_optimal hp _

private theorem integrable_swapRegret_of_bounded {X : Type*} [MeasurableSpace X] (P : Measure X)
    [IsFiniteMeasure P] {N T : ℕ} (y : X → ℕ → Fin N → ℝ) (I : X → ℕ → Fin N)
    (hy : ∀ t < T, ∀ i x, y x t i ∈ Icc 0 1)
    (hym : ∀ t < T, ∀ i, Measurable fun x => y x t i)
    (hIm : ∀ t < T, Measurable fun x => I x t) :
    Integrable (fun x => swapRegret T (y x) (I x)) P := by
  classical
  unfold swapRegret
  apply integrable_finset_max ⟨id, Finset.mem_univ _⟩ _ (B := T)
  · intro f
    exact Finset.measurable_sum _ fun t ht =>
      (measurable_select (hIm t (Finset.mem_range.mp ht)) (fun j => hym t (Finset.mem_range.mp ht) (f j))).sub
        (measurable_select (hIm t (Finset.mem_range.mp ht)) (hym t (Finset.mem_range.mp ht)))
  · intro f x
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc
      _ ≤ ∑ _ ∈ Finset.range T, (1 : ℝ) := Finset.sum_le_sum fun t ht => by
        have h₁ := hy t (Finset.mem_range.mp ht) (f (I x t)) x
        have h₂ := hy t (Finset.mem_range.mp ht) (I x t) x
        exact abs_le.mpr ⟨by linarith only [h₁.1, h₂.2], by linarith only [h₁.2, h₂.1]⟩
      _ = _ := by simp

theorem integrable_jointRegret (A : QPolicy 2) (p : ℝ) (T : ℕ) :
    Integrable (fun x : TwoArmRaw.{u} T =>
      swapRegret T (jointReward p x) (fun t => playedOnTape A p t x)) (twoArmJointLaw T) :=
  integrable_swapRegret_of_bounded (twoArmJointLaw T) (jointReward p)
    (fun x t => playedOnTape A p t x)
    (fun t _ i x => jointReward_mem p x t i)
    (fun t _ i => measurable_jointReward p t i)
    (fun t _ => measurable_playedOnTape A p t)

private theorem integrable_payoffGap {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsFiniteMeasure P] {a b : Ω → ℝ} (ma : Measurable a) (mb : Measurable b)
    (ha : ∀ x, a x ∈ Icc (0 : ℝ) 1) (hb : ∀ x, b x ∈ Icc (0 : ℝ) 1)
    (s : Set Ω) (ms : MeasurableSet s) :
    Integrable (s.indicator (fun x => a x - b x)) P := by
  apply Integrable.indicator ?_ ms
  apply Integrable.of_bound (ma.sub mb).aestronglyMeasurable 1
  exact ae_of_all _ fun x => by
    rw [Real.norm_eq_abs]
    change |a x - b x| ≤ 1
    exact abs_le.mpr ⟨by linarith [(ha x).1,(hb x).2], by linarith [(ha x).2,(hb x).1]⟩

private theorem integrable_jointGap (A : QPolicy 2) (p : ℝ) {T : ℕ} (t : ℕ)
    (i j k : TwoArmAction) :
    Integrable (fun x : TwoArmRaw.{u} T =>
      if playedOnTape A p t x = i then jointReward p x t j - jointReward p x t k else 0)
      (twoArmJointLaw T) := by
  classical
  have he : (fun x : TwoArmRaw.{u} T =>
      if playedOnTape A p t x = i then jointReward p x t j - jointReward p x t k else 0) =
      (playedOnTape A p t ⁻¹' {i}).indicator (fun x => jointReward p x t j - jointReward p x t k) := by
    funext x
    simp [Set.indicator]
  rw [he]
  exact integrable_payoffGap _ (measurable_jointReward p t j) (measurable_jointReward p t k)
    (fun x => jointReward_mem p x t j) (fun x => jointReward_mem p x t k)
    _ (measurable_playedOnTape A p t (measurableSet_singleton _))

/-- The reward draw is independent of the action in the same round. -/
theorem integral_jointGap (A : QPolicy 2) {p : ℝ} (hp : p ∈ Icc (0 : ℝ) 1)
    {T : ℕ} (t : Fin T) (i j k : TwoArmAction) :
    (∫ x : TwoArmRaw.{u} T, if playedOnTape A p t x = i then
        jointReward p x t j - jointReward p x t k else 0 ∂twoArmJointLaw T) =
      (twoArmMean p j - twoArmMean p k) *
        (twoArmJointLaw.{u} T).real (playedOnTape A p t ⁻¹' {i}) := by
  classical
  let U := twoArmUniform
  let Δ := twoArmMean p j - twoArmMean p k
  let n := (t : ℕ)
  letI : IsProbabilityMeasure (twoArmJointLaw.{u} (n+1)) := twoArmJointLaw_prob (n+1)
  let pre : TwoArmRaw.{u} T → TwoArmRaw.{u} (n+1) := TrialTape.take (Nat.succ_le_of_lt t.isLt)
  let act (z : TwoArmRaw.{u} (n+1)) := playedOnTape A p n z
  let B : Set (TwoArmRaw.{u} (n+1)) := act ⁻¹' {i}
  let f (z : TwoArmRaw.{u} (n+1)) :=
    B.indicator (fun v => twoArmReward p v.2.2 j - twoArmReward p v.2.2 k) z
  let g (z : TwoArmRaw.{u} (n+1)) := B.indicator (fun _ => (1 : ℝ)) z
  have hmB : MeasurableSet B := measurable_playedOnTape A p n (measurableSet_singleton _)
  have mf : Measurable f :=
    (((measurable_twoArmReward p j).sub (measurable_twoArmReward p k)).comp
      (measurable_snd.comp measurable_snd)).indicator hmB
  have mg : Measurable g := measurable_const.indicator hmB
  have intf : Integrable f (twoArmJointLaw (n+1)) :=
    integrable_payoffGap _ ((measurable_twoArmReward p j).comp (measurable_snd.comp measurable_snd))
      ((measurable_twoArmReward p k).comp (measurable_snd.comp measurable_snd))
      (fun x => twoArmReward_mem p x.2.2 j) (fun x => twoArmReward_mem p x.2.2 k) B hmB
  have intg : Integrable g (twoArmJointLaw (n+1)) := (integrable_const _).indicator hmB
  have hact (x : TwoArmRaw.{u} T) : playedOnTape A p n x = act (pre x) := by
    unfold act playedOnTape
    rw [dif_pos t.isLt, dif_pos (Nat.lt_succ_self _), ← take_twoArmTrace, TrialTape.read_take]
    rfl
  have hF : (fun x : TwoArmRaw.{u} T =>
      if playedOnTape A p t x = i then jointReward p x t j - jointReward p x t k else 0) = f ∘ pre := by
    funext x
    change (if playedOnTape A p n x = i then jointReward p x n j - jointReward p x n k
      else 0) = f (pre x)
    have hry (a : TwoArmAction) : jointReward p x n a = twoArmReward p (pre x).2.2 a :=
      dif_pos t.isLt
    simp only [hact x, hry, f, B, Set.indicator, mem_preimage, mem_singleton_iff]
  have hG : (playedOnTape.{u} A p (T := T) t ⁻¹' {i}).indicator (fun _ => (1 : ℝ)) = g ∘ pre := by
    funext x
    change ((playedOnTape A p n ⁻¹' {i}).indicator (fun _ => (1 : ℝ))) x = g (pre x)
    simp only [g, B, Set.indicator, mem_preimage, mem_singleton_iff, hact x]
  have hMap : (twoArmJointLaw.{u} T).map pre = twoArmJointLaw (n+1) :=
    TrialTape.take_law (U.prod U) _
  have hMeasure :=
    integral_indicator_const (μ := twoArmJointLaw.{u} T) (1 : ℝ)
      (measurable_playedOnTape A p t (measurableSet_singleton i))
  rw [smul_eq_mul, mul_one] at hMeasure
  change (∫ x, _ ∂twoArmJointLaw T) = Δ * _
  rw [hF, ← hMeasure, hG]
  have mapInt (r : TwoArmRaw.{u} (n+1) → ℝ) (mr : Measurable r) :
      (∫ x, (r ∘ pre) x ∂twoArmJointLaw T) = ∫ y, r y ∂twoArmJointLaw (n+1) := by
    change (∫ x, r (pre x) ∂twoArmJointLaw T) = _
    rw [← hMap, integral_map (TrialTape.measurable_take _).aemeasurable mr.aestronglyMeasurable]
  rw [mapInt f mf, mapInt g mg]
  change Integrable f ((twoArmJointLaw n).prod (U.prod U)) at intf
  change Integrable g ((twoArmJointLaw n).prod (U.prod U)) at intg
  change (∫ x, f x ∂(twoArmJointLaw n).prod (U.prod U)) =
    Δ * (∫ x, g x ∂(twoArmJointLaw n).prod (U.prod U))
  rw [integral_prod _ intf, integral_prod _ intg, ← integral_const_mul]
  apply integral_congr_ae
  exact ae_of_all _ fun h => by
    let e (x : ℝ) : ℝ := if pickTwoArm A n (twoArmTrace A p n h) x = i then 1 else 0
    have hE (z : ℝ × ℝ) : f (h,z) = e z.1 *
        (twoArmReward p z.2 j - twoArmReward p z.2 k) := by
      have ha : act (h,z) = pickTwoArm A n (twoArmTrace A p n h) z.1 := by
        unfold act playedOnTape
        rw [dif_pos (Nat.lt_succ_self _)]
        change (TrialTape.read (Fin.last n) (twoArmTrace A p (n+1) (h,z))).1 = _
        rw [TrialTape.read_last]
        rfl
      by_cases hh : pickTwoArm A n (twoArmTrace A p n h) z.1 = i <;>
        simp [f, e, B, Set.indicator, ha, hh]
    have hI (z : ℝ × ℝ) : g (h,z) = e z.1 * 1 := by
      have ha : act (h,z) = pickTwoArm A n (twoArmTrace A p n h) z.1 := by
        unfold act playedOnTape
        rw [dif_pos (Nat.lt_succ_self _)]
        change (TrialTape.read (Fin.last n) (twoArmTrace A p (n+1) (h,z))).1 = _
        rw [TrialTape.read_last]
        rfl
      by_cases hh : pickTwoArm A n (twoArmTrace A p n h) z.1 = i <;>
        simp [g, e, B, Set.indicator, ha, hh]
    simp_rw [hE,hI]
    rw [integral_prod_mul (μ := U) (ν := U) e (fun x => twoArmReward p x j - twoArmReward p x k),
      integral_prod_mul (μ := U) (ν := U) e (fun _ => (1 : ℝ))]
    change (∫ x, e x ∂U) * (∫ x, twoArmReward p x j - twoArmReward p x k ∂twoArmUniform) =
      Δ * ((∫ x, e x ∂U) * (∫ _ : ℝ, (1 : ℝ) ∂twoArmUniform))
    rw [
      integral_sub (integrable_twoArmReward p j) (integrable_twoArmReward p k),
      integral_twoArmReward hp, integral_twoArmReward hp]
    simp [Δ, mul_comm]

theorem measure_play_one (A : QPolicy 2) (p : ℝ) {T : ℕ} (t : Fin T) :
    (twoArmJointLaw.{u} T).real (playedOnTape A p (t : ℕ) ⁻¹' {1}) =
      (twoArmTraceLaw.{u} A p T).real (twoArmHit t) := by
  have he : playedOnTape A p (t : ℕ) ⁻¹' {(1 : TwoArmAction)} =
      twoArmTrace A p T ⁻¹' twoArmHit t := by
    ext x
    simp [playedOnTape, t.isLt, twoArmHit]
  rw [he, measureReal_def, measureReal_def, twoArmTraceLaw,
    Measure.map_apply (measurable_twoArmTrace A p T) (measurableSet_twoArmHit _)]

theorem measure_play_zero (A : QPolicy 2) (p : ℝ) {T : ℕ} (t : Fin T) :
    (twoArmJointLaw.{u} T).real (playedOnTape A p (t : ℕ) ⁻¹' {0}) =
      1 - (twoArmTraceLaw.{u} A p T).real (twoArmHit t) := by
  have he : playedOnTape.{u} A p (T := T) (t : ℕ) ⁻¹' {(0 : TwoArmAction)} =
      (playedOnTape.{u} A p (T := T) (t : ℕ) ⁻¹' {1})ᶜ := by
    ext x
    simp only [mem_preimage, mem_singleton_iff, mem_compl_iff]
    generalize playedOnTape A p (t : ℕ) x = a
    fin_cases a <;> decide
  rw [he, measureReal_compl (measurable_playedOnTape A p (t : ℕ) (measurableSet_singleton _)),
    probReal_univ, measure_play_one]

theorem goodWorld_regret (A : QPolicy 2) {d : ℝ} (hd : 0 ≤ d) (hd' : d ≤ 1/4)
    (T : ℕ) :
    (∫ x : TwoArmRaw.{u} T, swapRegret T (jointReward (1/2-d) x)
        (fun t => playedOnTape A (1/2-d) t x) ∂twoArmJointLaw T) =
      d * twoArmCount.{u} A (1/2-d) T := by
  let p := (1/2-d : ℝ)
  have hp : p ∈ Icc (0 : ℝ) 1 := by dsimp [p]; constructor <;> linarith
  have h' : p ≤ 1/2 := by dsimp [p]; linarith
  let f (t : ℕ) (x : TwoArmRaw.{u} T) :=
    if playedOnTape A p t x = 1 then jointReward p x t 0 - jointReward p x t 1 else 0
  have he (x : TwoArmRaw.{u} T) :
      swapRegret T (jointReward p x) (fun t => playedOnTape A p t x) = ∑ t : Fin T, f t x := by
    rw [Fin.sum_univ_eq_sum_range (fun t => f t x)]
    exact (favorable_environment_regret (jointReward p x) (fun t => playedOnTape A p t x)
      (fun t h => jointReward_optimal h' x h)).2.1
  change (∫ x, swapRegret T (jointReward p x) (fun t => playedOnTape A p t x) ∂twoArmJointLaw T) =
    d * twoArmCount.{u} A p T
  simp_rw [he]
  rw [integral_finsetSum (Finset.univ : Finset (Fin T))
    (fun t _ => integrable_jointGap A p (T := T) (t : ℕ) 1 0 1)]
  have hm : twoArmMean p 0 - twoArmMean p 1 = d := by norm_num [twoArmMean, p]
  rw [twoArmCount, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  simpa only [hm, measure_play_one] using integral_jointGap.{u} A hp t 1 0 1

theorem badWorld_regret (A : QPolicy 2) {d : ℝ} (hd : 0 ≤ d) (hd' : d ≤ 1/4)
    (T : ℕ) :
    d * ((T : ℝ) - twoArmCount.{u} A (1/2+d) T) ≤
      ∫ x : TwoArmRaw.{u} T, swapRegret T (jointReward (1/2+d) x)
        (fun t => playedOnTape A (1/2+d) t x) ∂twoArmJointLaw T := by
  let p := (1/2+d : ℝ)
  have hp : p ∈ Icc (0 : ℝ) 1 := by dsimp [p]; constructor <;> linarith
  let f (t : ℕ) (x : TwoArmRaw.{u} T) :=
    if playedOnTape A p t x = 0 then jointReward p x t 1 - jointReward p x t 0 else 0
  have hpoint (x : TwoArmRaw.{u} T) :
      (∑ t : Fin T, f t x) ≤ swapRegret T (jointReward p x) (fun t => playedOnTape A p t x) := by
    have he : (∑ t : Fin T, f t x) =
        ∑ t ∈ Finset.range T, (jointReward p x t 1 -
          jointReward p x t (playedOnTape A p t x)) := by
      rw [Fin.sum_univ_eq_sum_range (fun t => f t x)]
      apply Finset.sum_congr rfl
      intro t _
      dsimp only [f]
      generalize playedOnTape A p t x = a
      fin_cases a <;> simp
    rw [he]
    unfold swapRegret
    exact Finset.le_sup' (fun σ : TwoArmAction → TwoArmAction =>
      ∑ t ∈ Finset.range T, (jointReward p x t (σ (playedOnTape A p t x)) -
          jointReward p x t (playedOnTape A p t x))) (Finset.mem_univ (fun _ => 1))
  have hInt (t : Fin T) : Integrable (f t) (twoArmJointLaw T) := integrable_jointGap A p t 0 1 0
  calc
    _ = ∫ x, ∑ t : Fin T, f t x ∂twoArmJointLaw T := by
      rw [integral_finsetSum _ (fun t _ => hInt t)]
      simp_rw [f, integral_jointGap A hp, measure_play_zero,
        show twoArmMean p 1 - twoArmMean p 0 = d by norm_num [twoArmMean, p] <;> ring]
      rw [← Finset.mul_sum, Finset.sum_sub_distrib]
      simp [twoArmCount, p]
    _ ≤ _ := integral_mono (integrable_finsetSum _ (fun t _ => hInt t))
      (integrable_jointRegret A p T) hpoint

/-- The randomized-environment regret is the average of protocol-valid
regrets for fixed reward tapes. -/
theorem average_fixed_regret (A : QPolicy 2) (hA : ProbabilityPolicy A)
    (p : ℝ) (T : ℕ) :
    let P := TrialTape.law.{u} twoArmUniform T
    let F (e : TwoArmSeed.{u} T) (w : TwoArmSeed.{u} T) :=
      let run := twoArmFixedRun A hA p e
      swapRegret T (fun t => run.y t w) (fun t => run.I t w)
    Integrable (fun e => ∫ w, F e w ∂P) P ∧
      (∫ e, ∫ w, F e w ∂P ∂P) =
        ∫ x : TwoArmRaw.{u} T, swapRegret T (jointReward p x)
          (fun t => playedOnTape A p t x) ∂twoArmJointLaw T := by
  intro P F
  let g (x : TwoArmRaw.{u} T) :=
    swapRegret T (jointReward p x) (fun t => playedOnTape A p t x)
  have hg : Integrable g (twoArmJointLaw T) := integrable_jointRegret A p T
  have hzip := TrialTape.measurePreserving_zip.{u} twoArmUniform twoArmUniform T
  change MeasurePreserving (TrialTape.zip T) (P.prod P) (twoArmJointLaw T) at hzip
  have hgMap : Integrable g ((P.prod P).map (TrialTape.zip T)) := hzip.map_eq ▸ hg
  have hInt : Integrable (g ∘ TrialTape.zip T) (P.prod P) :=
    hgMap.comp_measurable hzip.measurable
  have hF (x : TwoArmSeed.{u} T × TwoArmSeed.{u} T) :
      (g ∘ TrialTape.zip T) x = F x.2 x.1 := by
    dsimp only [g, F, Function.comp_apply, twoArmFixedRun]
    congr 1
    funext t i
    exact jointReward_zip p x.1 x.2 t i
  have hmean := (integral_prod_symm (g ∘ TrialTape.zip T) hInt)
  change (∫ z, g (TrialTape.zip T z) ∂P.prod P) = _ at hmean
  rw [← integral_map hzip.aemeasurable hgMap.aestronglyMeasurable, hzip.map_eq] at hmean
  constructor
  · have hSwap (e w : TwoArmSeed.{u} T) :
        ((g ∘ TrialTape.zip T) ∘ Prod.swap) (e,w) = F e w := hF (w,e)
    simpa only [hSwap] using hInt.swap.integral_prod_left
  · simpa only [hF] using hmean.symm

theorem exists_fixed_regret_ge (A : QPolicy 2) (hA : ProbabilityPolicy A) (p : ℝ)
    (T : ℕ) {b : ℝ}
    (hb : b ≤ ∫ x : TwoArmRaw.{u} T, swapRegret T (jointReward p x)
      (fun t => playedOnTape A p t x) ∂twoArmJointLaw T) :
    ∃ e : TwoArmSeed.{u} T,
      let run := twoArmFixedRun A hA p e
      b ≤ ∫ w, swapRegret T (fun t => run.y t w) (fun t => run.I t w)
        ∂TrialTape.law twoArmUniform T := by
  let P := TrialTape.law.{u} twoArmUniform T
  let F (e : TwoArmSeed.{u} T) :=
    let run := twoArmFixedRun A hA p e
    ∫ w, swapRegret T (fun t => run.y t w) (fun t => run.I t w) ∂P
  obtain ⟨hInt,hAvg⟩ := average_fixed_regret.{u} A hA p T
  change Integrable F P at hInt
  change (∫ e, F e ∂P) = _ at hAvg
  have hAvg' : b ≤ ∫ e, F e ∂P := hAvg.symm ▸ hb
  change ∃ e, b ≤ F e
  by_contra! h
  have hpos (e : TwoArmSeed.{u} T) : 0 < b - F e := sub_pos.mpr (h e)
  have hsupport : Function.support (fun e => b - F e) = univ := by
    ext e
    simp [Function.mem_support, (hpos e).ne']
  have h := (integral_pos_iff_support_of_nonneg (fun e => (hpos e).le)
    ((integrable_const b).sub hInt)).mpr (by rw [hsupport, measure_univ]; exact zero_lt_one)
  rw [integral_sub (integrable_const b) hInt] at h
  rw [integral_const, probReal_univ, one_smul] at h
  linarith

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

open Filter Asymptotics

namespace CalibeatBandit.Supplement

theorem worstCaseCost_eventually {R : ℕ → ℝ}
    (hR : R =o[atTop] (fun T : ℕ => (T : ℝ))) (hR₀ : ∀ T, 0 ≤ R T) :
    ∀ᶠ T : ℕ in atTop, 0 < T ∧ 4 * (R T / T + 1 / Real.sqrt T) ≤ 1 / 4 := by
  filter_upwards [hR.def (show (0 : ℝ) < 1 / 32 by norm_num),
    eventually_ge_atTop (1024 : ℕ)] with T h ht
  have hp : 0 < T := by omega
  have hp' : (0 : ℝ) < T := by exact_mod_cast hp
  have hT' : (1024 : ℝ) ≤ T := by exact_mod_cast ht
  simp only [Real.norm_eq_abs, abs_of_nonneg (hR₀ T), abs_of_nonneg hp'.le] at h
  have hr : R T / T ≤ 1 / 32 := (div_le_iff₀ hp').mpr h
  have hs : 32 ≤ Real.sqrt T := (Real.le_sqrt (by norm_num) (by positivity)).mpr (by linarith)
  have hs0 := Real.sqrt_pos.2 hp'
  have hi : 1 / Real.sqrt T ≤ (1 / 32 : ℝ) := by
    apply (div_le_iff₀ hs0).mpr
    linarith
  exact ⟨hp, by linarith⟩

theorem worstCaseCost_from_counts {R T g b : ℝ} (hR : 0 ≤ R) (hT : 0 < T)
    (hg : 0 ≤ g) (_hb : 0 ≤ b)
    (hbudget : (4 * (R / T + 1 / Real.sqrt T)) * (T - b) ≤ R)
    (hcomparison : b ≤ g + T * Real.sqrt (6 * (4 * (R / T + 1 / Real.sqrt T)) ^ 2 * g)) :
    T / (44 * (R + Real.sqrt T)) ≤ (4 * (R / T + 1 / Real.sqrt T)) * g := by
  let δ : ℝ := 4 * (R / T + 1 / Real.sqrt T)
  let S := Real.sqrt T
  let x : ℝ := R / S + 1
  have hs : 0 < S := Real.sqrt_pos.2 hT
  have hS : S ^ 2 = T := Real.sq_sqrt hT.le
  have hx : 1 ≤ x := by dsimp [x]; linarith [div_nonneg hR hs.le]
  have hδ : 0 < δ := by
    dsimp [δ]
    exact mul_pos (by norm_num) (add_pos_of_nonneg_of_pos (div_nonneg hR hT.le)
      (one_div_pos.mpr hs))
  have he : δ * S = 4 * x := by
    dsimp only [δ, x]
    change (4 * (R / T + 1 / S)) * S = _
    rw [← hS]
    field_simp [hs.ne']
    <;> ring
  have hdT : δ * T = 4 * (R + S) := by
    rw [← hS, pow_two, ← mul_assoc, he]
    dsimp [x]
    field_simp [hs.ne']
    <;> ring
  have hν : 3 / 4 ≤ b / T := by
    have hD : δ * (T / 4) = R + S := by rw [← mul_div_assoc, hdT]; ring
    have hbt : δ * (T - b) ≤ δ * (T / 4) := hbudget.trans (by rw [hD]; linarith)
    have hb' := le_of_mul_le_mul_left hbt hδ
    apply (le_div_iff₀ hT).2
    linarith
  have hroot : Real.sqrt (6 * δ ^ 2 * g) = 4 * Real.sqrt 6 * x * Real.sqrt (g / T) := by
    rw [show 6 * δ ^ 2 * g = 6 * (δ ^ 2 * g) by ring, Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 6),
      Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hδ.le, Real.sqrt_div hg]
    change Real.sqrt 6 * (δ * Real.sqrt g) = 4 * Real.sqrt 6 * x * (Real.sqrt g / S)
    rw [← mul_div_assoc]
    apply (eq_div_iff hs.ne').2
    calc
      _ = Real.sqrt 6 * (δ * S) * Real.sqrt g := by ring
      _ = _ := by rw [he]; ring
  have hchange : b / T ≤ g / T + 4 * Real.sqrt 6 * x * Real.sqrt (g / T) := by
    apply (div_le_iff₀ hT).2
    change b ≤ g + T * Real.sqrt (6 * δ ^ 2 * g) at hcomparison
    rw [hroot] at hcomparison
    rw [add_mul, div_mul_cancel₀ _ hT.ne']
    simpa only [mul_comm T] using hcomparison
  have hbnd := favorable_play_rate hx (div_nonneg hg hT.le) hν hchange
  have h := worst_case_cost_rate hR hT hbnd
  refine h.trans_eq ?_
  change (g / T) * δ * T = δ * g
  rw [mul_right_comm, div_mul_cancel₀ _ hT.ne', mul_comm]

end CalibeatBandit.Supplement

end

section

set_option autoImplicit false

namespace CalibeatBandit.Supplement

open MeasureTheory Filter Asymptotics Set

universe u

private def emptyEnvironment : (T : ℕ) → TwoArmSeed.{u} T
  | 0 => ULift.up ()
  | t + 1 => (emptyEnvironment t, 0)

private theorem swapRegret_nonneg_for_identity {K : ℕ} (T : ℕ) (y : ℕ → Fin K → ℝ)
    (I : ℕ → Fin K) : 0 ≤ swapRegret T y I := by
  unfold swapRegret
  have h := Finset.le_sup' (fun f : Fin K → Fin K =>
    ∑ t ∈ Finset.range T, (y t (f (I t)) - y t (I t))) (Finset.mem_univ id)
  simpa using h

/-- Theorem 3.6: the cost of a worst-case guarantee. -/
theorem theorem_3_6 (A : ℕ → QPolicy 2)
    (hA : ∀ T t q J I r, IsProbVec (A T t q J I r))
    (R : ℕ → ℝ) (hR : R =o[atTop] (fun T : ℕ => (T : ℝ)))
    (hworst : ∀ (T : ℕ) {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
      (run : QProtocolRun 2 T P (A T)),
      ∫ ω, swapRegret T (fun t => run.y t ω) (fun t => run.I t ω) ∂P ≤ R T) :
    ∀ᶠ T : ℕ in atTop, ∃ ys : ℕ → Fin 2 → ℝ, ∃ (Ω : Type u) (_ : MeasurableSpace Ω)
      (P : Measure Ω), IsProbabilityMeasure P ∧ ∃ run : QProtocolRun 2 T P (A T),
        (∀ t < T, ∀ ω, run.y t ω = ys t) ∧
        (∀ t < T, ∀ ω, run.q t ω = Pi.single 0 1) ∧
        (∀ s ≤ T, ∀ ω, swapRegret s (fun t => run.y t ω) (fun t => run.J t ω) = 0) ∧
        (T : ℝ) / (44 * (R T + Real.sqrt T))
          ≤ ∫ ω, swapRegret T (fun t => run.y t ω) (fun t => run.I t ω) ∂P ∧
        (T : ℝ) / (44 * (R T + Real.sqrt T))
          ≤ ∫ ω, rewardLoss T (fun t => run.y t ω) (fun t => run.J t ω)
              (fun t => run.I t ω) ∂P := by
  have hR₀ (T : ℕ) : 0 ≤ R T := by
    let P := TrialTape.law.{u} twoArmUniform T
    let run := twoArmFixedRun (A T) (hA T) (1/2) (emptyEnvironment.{u} T)
    have h := hworst T P run
    exact le_trans (integral_nonneg (fun x => swapRegret_nonneg_for_identity T _ _)) h
  filter_upwards [worstCaseCost_eventually hR hR₀] with T ⟨hT,hδ⟩
  let d := 4 * (R T / (T : ℝ) + 1 / Real.sqrt (T : ℝ))
  have hd : 0 ≤ d := by
    dsimp [d]
    have hRpos := hR₀ T
    positivity
  have hδ' : d ≤ 1/4 := hδ
  let P := TrialTape.law.{u} twoArmUniform T
  let G := twoArmCount.{u} (A T) (1/2 - d) T
  let B := twoArmCount.{u} (A T) (1/2 + d) T
  let F (e : TwoArmSeed.{u} T) :=
    let run := twoArmFixedRun (A T) (hA T) (1/2 + d) e
    ∫ w, swapRegret T (fun t => run.y t w) (fun t => run.I t w) ∂P
  obtain ⟨hInt,hAvg⟩ := average_fixed_regret.{u} (A T) (hA T) (1/2+d) T
  change Integrable F P at hInt
  change (∫ e, F e ∂P) = _ at hAvg
  have hb : ∫ e, F e ∂P ≤ R T := by
    have h := integral_mono hInt (integrable_const (R T) (μ := P)) fun e =>
      hworst T P (twoArmFixedRun (A T) (hA T) (1/2 + d) e)
    simpa using h
  have hbudget : d * ((T : ℝ) - B) ≤ R T :=
    (badWorld_regret.{u} (A T) hd hδ' T).trans (hAvg ▸ hb)
  have hKL : B ≤ G + (T : ℝ) * Real.sqrt (6 * d^2 * G) :=
    twoArmCount_comparison.{u} (A T) hd hδ' T
  have hG : (T : ℝ) / (44 * (R T + Real.sqrt T)) ≤ d * G :=
    worstCaseCost_from_counts (hR₀ T) (by exact_mod_cast hT)
      (twoArmCount_nonneg.{u} (A T) _ _) (twoArmCount_nonneg.{u} (A T) _ _) hbudget hKL
  rw [← goodWorld_regret.{u} (A T) hd hδ' T] at hG
  obtain ⟨e,he⟩ := exists_fixed_regret_ge.{u} (A T) (hA T) (1/2-d) T hG
  let run := twoArmFixedRun (A T) (hA T) (1/2-d) e
  have hPath (ω : TwoArmSeed.{u} T) :=
    favorable_environment_regret (fun t => run.y t ω) (fun t => run.I t ω) (by
      intro t ht
      change rewardOnTape (1/2-d) t e 1 ≤ rewardOnTape (1/2-d) t e 0
      rw [rewardOnTape, rewardOnTape, dif_pos ht, dif_pos ht]
      exact twoArmReward_optimal (p := 1/2-d) (by linarith) _)
  refine ⟨fun t => rewardOnTape (1/2-d) t e, TwoArmSeed.{u} T, inferInstance, P,
    inferInstance, run, ?_, ?_, ?_, he, ?_⟩
  · intros
    rfl
  · intros
    rfl
  · intro s hs ω
    exact (hPath ω).1 s hs
  · have heq : (fun ω => rewardLoss T (fun t => run.y t ω) (fun t => run.J t ω)
          (fun t => run.I t ω)) =
        fun ω => swapRegret T (fun t => run.y t ω) (fun t => run.I t ω) := by
      funext ω
      exact (hPath ω).2.2
    rw [heq]
    exact he

end CalibeatBandit.Supplement

end

