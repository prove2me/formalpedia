theorem dbl_sp (s0 : IState HS) (F : Fin HS → List ℤ) {Y : Fin HS} (hY5 : Y.val < 56) {g : ℤ}
    {l : List ℤ} (hF : F Y = g :: l) {A : ℕ} (hg : |g + g| ≤ 2 ^ A) (hg' : |g| ≤ 2 ^ A)
