theorem NLogN.KFM.gmulPU_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ : ℕ) (s : IState HS) (zs ts : List GI) (R0 RW LR : List Item) (hlen : ts.length = zs.length)
    (h0 : s.G 0 = ints (gflat zs) ++ R0) (hW : s.G pW = ints (gflat ts) ++ RW)
    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hz : NLogN.KFB.GB w zs) (ht : NLogN.KFB.GB w ts) (LX LX2 : List Item)
    (hX : s.G nX = .int (zs.length : ℤ) :: LX) (hX2 : s.G nX2 = .int ((2 * zs.length : ℕ) : ℤ) :: LX2) :
    IRuns I iprog (gmulPU pM) s
      ((s.upd 0 (ints (gflat (List.zipWith (gmulT Δ) zs ts)) ++ R0)).upd pW RW)
      (cGmul zs.length w Δ φ + 2 * (dupCost (zsz ((2 * zs.length : ℕ) : ℤ)) + 17)) := by sorry
