theorem QFS.shrink_eq_iInter_shift (S : Set E) {ℓ : ℝ} (hℓ : 0 ≤ ℓ) :
    shrink S ℓ = ⋂ ξ ∈ closedBall (0 : E) ℓ, shift S ξ := by sorry
