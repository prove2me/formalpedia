open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable (M : ℝ)
theorem solution {x : Pt 4} (hr : x 1 ≠ 0) (hne : x 1 ≠ M / 2) (hne' : x 1 ≠ -(M / 2)) :
    jacIso M x * jacIsoInv M x = 1 := by
  have h : 1 - M ^ 2 / (4 * x 1 ^ 2) ≠ 0 := by
    have h1 : 2 * x 1 - M ≠ 0 := fun h0 => hne (by linarith)
    have h2 : 2 * x 1 + M ≠ 0 := fun h0 => hne' (by linarith)
    have e : 1 - M ^ 2 / (4 * x 1 ^ 2) = (2 * x 1 - M) * (2 * x 1 + M) / (4 * x 1 ^ 2) := by
      field_simp; ring
    rw [e]; exact div_ne_zero (mul_ne_zero h1 h2) (by positivity)
  have h' : 4 * x 1 ^ 2 - M ^ 2 ≠ 0 := by
    rw [show 4 * x 1 ^ 2 - M ^ 2 = (2 * x 1 - M) * (2 * x 1 + M) by ring]
    exact mul_ne_zero (fun h0 => hne (by linarith)) (fun h0 => hne' (by linarith))
  ext i j
  fin_cases i <;> fin_cases j <;> simp [jacIso, jacIsoInv, Matrix.mul_apply, Fin.sum_univ_four,
    Matrix.one_apply] <;> field_simp
