@[simp] theorem St.pop_stk (σ : St S) (i j : Fin S) :
    (σ.pop i).stk j = if j = i then (σ.stk i).tail else σ.stk j := by
  simp [St.pop, Function.update_apply]

theorem St.top_eq (σ : St S) (i : Fin S) : σ.top i = (σ.stk i).head? := rfl

