    centerALowerYBox.Contains (Y (lower E8TAxisProd0522PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0522PaddedInputs.centerAInput.alpha = ((3957182113162240766624229437560720104187234175 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
