-- title:
--   §1, pp. 224–225, and (1), (4), §3 — Poisson process at rate λ(t), U, V, Y, Z, R, Yₙ, LAA, Λ, V̄ and the history σ-fields
-- statement:
--   The objects of Wolff's *Poisson Arrivals See Time Averages* (1982).
--
--   Let $(\Omega,\mathcal F,P)$ be a measure space. A counting process $A=\{A(t)\}$ with values in $\{0,1,2,\dots\}$ is a **Poisson process with intensity** $\lambda(\cdot)$ if
--
--   1. $A(0)=0$, and every sample path $t\mapsto A(t,\omega)$ is non-decreasing and right-continuous;
--   2. each $A(t)$ is a random variable;
--   3. $\lambda$ is integrable on every interval $[0,t]$, and $\int_s^t\lambda(u)\,du\ge0$ for $0\le s\le t$;
--   4. for $0\le s\le t$ the increment $A(t)-A(s)$ is Poisson distributed with mean $\int_s^t\lambda(u)\,du$;
--   5. for every $0\le t_0<t_1<\dots<t_k$ the increments $A(t_1)-A(t_0),\dots,A(t_k)-A(t_{k-1})$ are mutually independent.
--
--   A **Poisson process at rate** $\lambda$ is the case of a constant intensity $\lambda$. $A(t)$ counts the arrivals in $(0,t]$, and $T_k=\inf\{s\ge0: A(s)\ge k\}$ is the $k$-th arrival epoch.
--
--   Given a process $N$ with values in a measurable space and a set $B$ of values, the paper defines
--
--   $$U(t)=\mathbf 1\{N(t)\in B\},\qquad V(t)=t^{-1}\int_0^tU(s)\,ds,\qquad Y(t)=\int_0^tU(s)\,dA(s),\qquad Z(t)=Y(t)/A(t).$$
--
--   $V(t)$ is the fraction of time in $[0,t]$ that $N$ is in $B$, $Y(t)=\sum_{k=1}^{A(t)}U(T_k)$ is the number of arrivals who find $N$ in $B$, and $Z(t)$ is the fraction of arrivals who find $N$ in $B$. The file further defines
--
--   1. $R(t)=Y(t)-\lambda tV(t)$, display (4);
--   2. the grid approximation (1), $Y_n(t)=\sum_{k=0}^{n-1}U(kt/n)\,[A((k+1)t/n)-A(kt/n)]$;
--   3. **path regularity**: w.p. 1 the paths of $U$ are left continuous at every $t>0$ and have a right-hand limit at every $t\ge0$;
--   4. **joint measurability** of $(\omega,t)\mapsto U(t,\omega)$ on $\Omega\times[0,\infty)$;
--   5. the **Lack of Anticipation Assumption (LAA)**: for each $t\ge0$, the σ-fields generated by $\{A(t+u)-A(t),u\ge0\}$ and by $\{U(s),0\le s\le t\}$ are independent;
--   6. for §3, $\Lambda(t)=\int_0^t\lambda(s)\,ds$ and the arrival rate weighted time average $\bar V(t)=\Lambda(t)^{-1}\int_0^tU(s)\lambda(s)\,ds$;
--   7. $\mathcal F_t$, the σ-field generated by $\{A(s),U(s);0\le s\le t\}$, and the σ-field generated by $\{R(s),0\le s\le t\}$.
--   8. **lack of anticipation with respect to the joint history**: for each $t\ge0$, $\{A(t+u)-A(t),u\ge0\}$ is independent of $\mathcal F_t$. This is the independence used in the proof of (6); it implies LAA.
--
--   These are the objects of every statement of the mission.
--
--   **Formalization Note** Time is real and only nonnegative times are used; monotone paths with $A(0)=0$ vanish for $t<0$. Every Poisson path (not only almost every one) is taken monotone and right-continuous, the usual choice of version. $V$, $Y$, $Z$, $R$, $Y_n$, $\bar V$, LAA and the σ-fields are defined for an arbitrary real process $U$, so statements can also be made for processes other than indicators. $Y(t)$ is encoded as $\sum_{k=1}^{A(t)}U(T_k)$, which is the Lebesgue–Stieltjes integral $\int_{(0,t]}U\,dA$ counting multiple jumps with multiplicity; the paper's "arrivals in $[0,t]$" are the arrivals in $(0,t]$ because $A(0)=0$. Division by zero is $0$ in Lean: $Z(t)=0$ when $A(t)=0$, $V(0)=0$, and $\bar V(t)=0$ when $\Lambda(t)=0$; limits as $t\to\infty$ do not see these values.
-- source:
--   Wolff, Poisson Arrivals See Time Averages, Oper. Res. 30 (1982), DOI 10.1287/opre.30.2.223, pp. 224–226 (§1, display (1), display (4)), p. 228 (§3: Λ(t), V̄(t))

import Mathlib

open MeasureTheory ProbabilityTheory Filter Topology

namespace WolffPASTA.Main

/-- A Poisson counting process `A` with intensity function `rate` on `(Ω, ℱ, P)`
(Wolff 1982, §1 p. 224 for constant rate; §3 p. 228 for a time-varying rate `λ(t)`).

* `A 0 = 0`; every path `t ↦ A t ω` is non-decreasing and right-continuous;
* each `A t` is measurable;
* `rate` is integrable on every interval `[0, t]`, and its integral `Λ` over `[s, t] ⊆ [0, ∞)` is
  nonnegative;
* for `0 ≤ s ≤ t` the increment `A t - A s` is Poisson with mean `∫ₛᵗ rate`;
* for every finite strictly increasing sequence of times `0 ≤ t₀ < t₁ < … < t_k` the increments
  `A t_{i+1} - A t_i` are mutually independent.

`A t ω` is the number of arrivals in `(0, t]`. -/
structure IsPoissonProcessWithIntensity {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (A : ℝ → Ω → ℕ) (rate : ℝ → ℝ) : Prop where
  zero : ∀ ω, A 0 ω = 0
  mono : ∀ ω, Monotone (fun t => A t ω)
  rightCont : ∀ ω t, ContinuousWithinAt (fun s => (A s ω : ℝ)) (Set.Ici t) t
  meas : ∀ t, Measurable (A t)
  rate_intervalIntegrable : ∀ t, 0 ≤ t → IntervalIntegrable rate volume 0 t
  mean_nonneg : ∀ s t, 0 ≤ s → s ≤ t → 0 ≤ ∫ u in s..t, rate u
  law : ∀ s t, 0 ≤ s → s ≤ t →
    P.map (fun ω => A t ω - A s ω) = poissonMeasure (Real.toNNReal (∫ u in s..t, rate u))
  indep : ∀ (k : ℕ) (t : Fin (k + 1) → ℝ), 0 ≤ t 0 → StrictMono t →
    iIndepFun (fun (i : Fin k) (ω : Ω) => A (t i.succ) ω - A (t i.castSucc) ω) P

/-- A Poisson process at constant rate `lam` (Wolff 1982, §1, p. 224). -/
def IsPoissonProcess {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (A : ℝ → Ω → ℕ)
    (lam : ℝ) : Prop :=
  IsPoissonProcessWithIntensity P A (fun _ => lam)

variable {Ω : Type*} {S : Type*}

/-- `U(t) = 1` if `N(t) ∈ B`, `= 0` otherwise (p. 225). -/
noncomputable def U (N : ℝ → Ω → S) (B : Set S) : ℝ → Ω → ℝ :=
  fun t ω => B.indicator (fun _ => (1 : ℝ)) (N t ω)

/-- `V(t) = t⁻¹ ∫₀ᵗ U(s) ds`, the fraction of time in `[0, t]` spent in `B` (p. 225).
Stated for an arbitrary real process `U`. -/
noncomputable def V (U : ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  t⁻¹ * ∫ s in (0 : ℝ)..t, U s ω

/-- The `k`-th arrival epoch of the counting process `A`: `inf {s ≥ 0 : A(s) ≥ k}`. -/
noncomputable def T (A : ℝ → Ω → ℕ) (k : ℕ) (ω : Ω) : ℝ :=
  sInf {s : ℝ | 0 ≤ s ∧ k ≤ A s ω}

/-- `Y(t) = ∫₀ᵗ U(s) dA(s)` (p. 225): the sum of `U` over the arrival epochs in `(0, t]`,
counted with multiplicity, i.e. `∑_{k = 1}^{A(t)} U(T_k)`. -/
noncomputable def Y (U : ℝ → Ω → ℝ) (A : ℝ → Ω → ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  ∑ k ∈ Finset.Icc 1 (A t ω), U (T A k ω) ω

/-- `Z(t) = Y(t) / A(t)` (p. 225); equal to `0` when `A(t) = 0`. -/
noncomputable def Z (U : ℝ → Ω → ℝ) (A : ℝ → Ω → ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  Y U A t ω / (A t ω : ℝ)

/-- `R(t) = Y(t) - λ t V(t)`, display (4), p. 226. -/
noncomputable def R (U : ℝ → Ω → ℝ) (A : ℝ → Ω → ℕ) (lam : ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  Y U A t ω - lam * t * V U t ω

/-- The grid approximation (1), p. 225:
`Yₙ(t) = ∑_{k=0}^{n-1} U(kt/n) [A((k+1)t/n) - A(kt/n)]`. -/
noncomputable def Yn (U : ℝ → Ω → ℝ) (A : ℝ → Ω → ℕ) (n : ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  ∑ k ∈ Finset.range n,
    U (k * t / n) ω * ((A ((k + 1) * t / n) ω : ℝ) - (A (k * t / n) ω : ℝ))

/-- The sample paths of `U` are left continuous and have right-hand limits, w.p. 1 (p. 225). -/
def PathRegular [MeasurableSpace Ω] (P : Measure Ω) (U : ℝ → Ω → ℝ) : Prop :=
  ∀ᵐ ω ∂P, (∀ t, 0 < t → ContinuousWithinAt (fun s => U s ω) (Set.Iio t) t) ∧
    (∀ t, 0 ≤ t → ∃ c, Tendsto (fun s => U s ω) (𝓝[>] t) (𝓝 c))

/-- `U` is a jointly measurable function of `(ω, t) ∈ Ω × [0, ∞)` (p. 225). -/
def JointlyMeasurable [MeasurableSpace Ω] (U : ℝ → Ω → ℝ) : Prop :=
  Measurable (fun p : Ω × Set.Ici (0 : ℝ) => U p.2 p.1)

/-- Lack of Anticipation Assumption (p. 225): for each `t ≥ 0`, the future increments
`{A(t + u) - A(t), u ≥ 0}` and the past `{U(s), 0 ≤ s ≤ t}` are independent. -/
def LAA [MeasurableSpace Ω] (P : Measure Ω) (A : ℝ → Ω → ℕ) (U : ℝ → Ω → ℝ) : Prop :=
  ∀ t, 0 ≤ t →
    Indep (⨆ u ∈ Set.Ici (0 : ℝ),
        MeasurableSpace.comap (fun ω => A (t + u) ω - A t ω) inferInstance)
      (⨆ s ∈ Set.Icc (0 : ℝ) t, MeasurableSpace.comap (U s) inferInstance) P

/-- `Λ(t) = ∫₀ᵗ λ(s) ds` (§3, p. 228). -/
noncomputable def Lambda (rate : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..t, rate s

/-- The arrival rate weighted time average `V̄(t) = Λ(t)⁻¹ ∫₀ᵗ U(s) λ(s) ds` (§3, p. 228). -/
noncomputable def Vbar (U : ℝ → Ω → ℝ) (rate : ℝ → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  (Lambda rate t)⁻¹ * ∫ s in (0 : ℝ)..t, U s ω * rate s

/-- `ℱₜ`, the σ-field generated by `{A(s), U(s); 0 ≤ s ≤ t}` (p. 226). -/
@[reducible] def Fhist (A : ℝ → Ω → ℕ) (U : ℝ → Ω → ℝ) (t : ℝ) : MeasurableSpace Ω :=
  ⨆ s ∈ Set.Icc (0 : ℝ) t,
    (MeasurableSpace.comap (A s) inferInstance ⊔ MeasurableSpace.comap (U s) inferInstance)

/-- The σ-field generated by `{R(s), 0 ≤ s ≤ t}` (p. 226, (5)). -/
@[reducible] def Rhist (R : ℝ → Ω → ℝ) (t : ℝ) : MeasurableSpace Ω :=
  ⨆ s ∈ Set.Icc (0 : ℝ) t, MeasurableSpace.comap (R s) inferInstance

/-- Lack of anticipation with respect to the joint history `ℱₜ = σ{A(s), U(s); 0 ≤ s ≤ t}`:
for each `t ≥ 0`, the future increments `{A(t + u) - A(t), u ≥ 0}` are independent of `ℱₜ`.
This is the independence the proof of (6), p. 226–227, uses ("from LAA and the
independent-increments property … for any set in `ℱₜ`"). It implies `LAA` as printed on p. 225,
which alone does not give (6) or LEMMA 1. -/
def LAAJoint [MeasurableSpace Ω] (P : Measure Ω) (A : ℝ → Ω → ℕ) (U : ℝ → Ω → ℝ) : Prop :=
  ∀ t, 0 ≤ t →
    Indep (⨆ u ∈ Set.Ici (0 : ℝ),
        MeasurableSpace.comap (fun ω => A (t + u) ω - A t ω) inferInstance)
      (Fhist A U t) P

end WolffPASTA.Main


