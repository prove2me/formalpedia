-- Source module: Solutions.J6AILTab8
/-!
# A lines, table set-up, part 8: the parameter phase (run)

**`Rn.phase`**: from the registers of `parA` the phase pushes the `kerRegs` values onto
`45` and `|T|` onto `42` and leaves the loop registers `LV` with `10 = nc`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

def pwP (x rc : Fin HS) : RS := .rep cLC (.reg rc) (PJ.asgs [(x, ePw x)])
/-- One step of the `clog` loop: `if 26 < 24 then (22, 26) := (22 + 1, 2 · 26)`. -/
def eClC : E := .sel (.sub (.r 26) (.r 24)) (.add (.r 22) (.k 1)) (.r 22)
def eClY : E := .sel (.sub (.r 26) (.r 24)) (.mul (.k 2) (.r 26)) (.r 26)
def clgP : RS := .rep cLC (.reg 24) (PJ.asgs [(22, eClC), (26, eClY)])
def eBeta : E := .dv (.r 5) (.mul (.k 2) (.r 6))

/-- The `kerRegs` values `ρ 8, …, ρ 0` pushed on `45` (so `45 = [ρ 0, …, ρ 8]`, the input of
`distAll`), and `|T|` on `42`. -/
def pushD (pkA pkC : ℕ) : List (Fin HS × E) :=
  [(45, .mul (.k 2) (.mul (.mul (.mul (.r 1) (.mul (.r 10) (.k 8))) (.r 2)) (.r 11))),
   (45, .mul (.k 2) (.r 11)), (45, .mul (.r 10) (.k 8)), (45, .r 1), (45, .r 2),
   (45, .mul (.r 1) (.mul (.r 10) (.k 8))), (45, .r 12),
   (45, .add (.mul (.k pkA) (.r 5)) (.k ((pkC + 1 : ℕ) : ℤ))), (45, .add (.r 5) (.k 2)),
   (42, .mul (.mul (.r 10) (.k 8)) (.add (.add (.mul (.k 4) (.r 9)) (.mul (.k 4) (.r 8))) (.k 18)))]

/-- The powers of two. -/
def phaseP : RS :=
  .seq (pwP 5 1) (.seq (PJ.asgs [(6, eBeta)]) (.seq (pwP 12 23) (.seq (pwP 20 21)
    (.seq (PJ.asgs [(21, .k 1)]) (pwP 21 22)))))

/-- The `aHdr2` constants: `23 := b · r`, `22 := ⌈log₂ r⌉` (`r = 4W + 4H` on `24`). -/
def phaseK : RS :=
  .seq (PJ.asgs [(23, .mul (.r 22) (.r 24))]) (.seq (PJ.asgs [(22, .k 0), (26, .k 1)]) clgP)

/-- **The parameter phase.** -/
def phase (pkA pkC bA bC : ℕ) : RS :=
  .seq (pushTo (pushD pkA pkC)) (.seq (PJ.asgs (asgA pkA pkC bA bC)) (.seq phaseP phaseK))

def cPhaseP (W p pk b : ℕ) : ℕ :=
  cLoop W (2 * p) (cA W [(5, ePw 5)]) +
    (cA W [(6, eBeta)] + (cLoop W (J6A.QA p) (cA W [(12, ePw 12)]) +
    (cLoop W pk (cA W [(20, ePw 20)]) + (cA W [(21, .k 1)] +
    cLoop W b (cA W [(21, ePw 21)])))))

def cPhaseK (W r : ℕ) : ℕ :=
  cA W [(23, .mul (.r 22) (.r 24))] + (cA W [(22, .k 0), (26, .k 1)] +
    cLoop W r (cA W [(22, eClC), (26, eClY)]))

/-- The cost of the phase. -/
def cPhase (W p α pkA pkC bA bC : ℕ) : ℕ :=
  cPushTo W (pushD pkA pkC) + (cA W (asgA pkA pkC bA bC) +
    (cPhaseP W p (pkA * p + pkC) (bA * p + bC) +
      cPhaseK W (4 * J6A.WA p α (HAx p α) + 4 * HAx p α)))

/-! ## The pushes and the first assignments -/

/-- The registers after the first assignments. -/
structure V1 (p s t α pkA pkC bA bC : ℕ) (v : Vr) : Prop where
  a1 : v 1 = ((2 * p : ℕ) : ℤ)
  a2 : v 2 = ((p / 2 : ℕ) : ℤ)
  a3 : v 3 = s
  a4 : v 4 = t
  a5 : v 5 = 1
  a6 : v 6 = α
  a7 : v 7 = ((t ^ 3 * α ^ 2 : ℕ) : ℤ)
  a8 : v 8 = HAx p α
  a9 : v 9 = J6A.WA p α (HAx p α)
  a10 : v 10 = ncA p t α
  a11 : v 11 = ((t ^ 2 * α ^ 2 : ℕ) : ℤ)
  a12 : v 12 = 1
  a20 : v 20 = 1
  a21 : v 21 = ((pkA * p + pkC : ℕ) : ℤ)
  a22 : v 22 = ((bA * p + bC : ℕ) : ℤ)
  a23 : v 23 = ((J6A.QA p : ℕ) : ℤ)
  a24 : v 24 = ((4 * J6A.WA p α (HAx p α) + 4 * HAx p α : ℕ) : ℤ)
  a25 : v 25 = ((2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) : ℕ) : ℤ)

/-! ## The powers of two -/

/-- The registers after the powers of two. -/
structure V2 (p s t α pk b : ℕ) (v : Vr) : Prop where
  a1 : v 1 = ((2 * p : ℕ) : ℤ)
  a2 : v 2 = ((p / 2 : ℕ) : ℤ)
  a3 : v 3 = s
  a4 : v 4 = t
  a5 : v 5 = 2 ^ (2 * p)
  a6 : v 6 = betaT (2 * p) α
  a7 : v 7 = ((t ^ 3 * α ^ 2 : ℕ) : ℤ)
  a8 : v 8 = HAx p α
  a9 : v 9 = J6A.WA p α (HAx p α)
  a10 : v 10 = ncA p t α
  a11 : v 11 = ((t ^ 2 * α ^ 2 : ℕ) : ℤ)
  a12 : v 12 = 2 ^ J6A.QA p
  a20 : v 20 = 2 ^ pk
  a21 : v 21 = 2 ^ b
  a22 : v 22 = (b : ℤ)
  a24 : v 24 = ((4 * J6A.WA p α (HAx p α) + 4 * HAx p α : ℕ) : ℤ)
  a25 : v 25 = ((2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) : ℕ) : ℤ)

/-! ## The `aHdr2` constants -/

