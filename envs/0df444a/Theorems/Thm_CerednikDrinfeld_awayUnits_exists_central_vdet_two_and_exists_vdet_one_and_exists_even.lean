    (∃ Γt' : Subgroup (ℍ[ℚ, a₁, b₁])ˣ, ∀ x : (ℍ[ℚ, a₁, b₁])ˣ, x ∈ Γt' ↔ x ∈ Γt ∧ Even (Multiplicative.toAdd (vdet ((Units.map (ι₀ : ℍ[ℚ, a₁, b₁] →* Matrix (Fin 2) (Fin 2) K₀)) x)))) := by sorry
