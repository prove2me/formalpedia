    rw [hcardI, h𝔓x_rank, hR, Matrix.natCard_GL_fin_two_zmod_eq, Matrix.natCard_GL_fin_two_zmod_eq]

    have hqodd : Odd q := hqprime.eq_two_or_odd'.resolve_left (by omega)
    have h2 : 2 ∣ (∏ p ∈ M'.primeFactors, p ^ (M'.factorization p - 1) * (p + 1)) * (q * (q ^ 2 - 1)) * (ℓ * (ℓ ^ 2 - 1)) := by
      have : Even (q ^ 2 - 1) := Nat.Odd.sub_odd (hqodd.pow) odd_one
