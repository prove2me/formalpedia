theorem NLogN.KFD.bodyF_run {N : ℕ} [NeZero N] (hN : 1 < N) (P L' : ℕ) (A B Cs : Shape)
    (hpos : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a)
    (tpl : IMat m → List (TStep m)) (Pr : IMat m → Prop) (hfr : FramesOK Pr C.gates C.Min C.Mout)
    (hT : ∀ X, Pr X → AModel.edgeSteps C N X = (tpl X).map (TStep.eval N))
    (Bb : ℕ) (hTOK : ∀ X, Pr X → ∀ T, TStep.sh T ∈ tpl X → TOK T N Bb)
    (hV : zsz ((vol (P :: W * L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb) (hSB : SubBnd N Bb)
    (G0 : Fin HS → List Item) (hG : LevG G0 m W N P L' A B Cs)
    (j0 : Fin Pp) (child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2)) (cC : ℕ)
    (hsw : ∀ X, Pr X → ∀ a b, TStep.sw a b ∈ tpl X → ∀ (t : IState HS) (R : List Item)
      (ys : List (ZMod 2)), NLogN.KIL.Inv G0 t → ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      IRuns I iprog (NLogN.KIL.swC m j0 (a : ℕ) (b : ℕ)) (t.upd 0 (ints (enc2 ys) ++ R))
