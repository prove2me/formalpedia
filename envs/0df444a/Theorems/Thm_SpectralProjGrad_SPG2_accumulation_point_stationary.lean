-- title:
--   Theorem 2.1: accumulation points of SPG2 are constrained stationary points
-- statement:
--   Let $\Omega\subseteq\mathbb R^n$ be closed and convex, let $f$ have continuous partial derivatives on an open set $U\supseteq\Omega$, with gradient $g=\nabla f$, and let $P$ be the orthogonal projection onto $\Omega$. Fix parameters $M\ge1$, $0<\alpha_{\min}<\alpha_{\max}$, $\gamma\in(0,1)$ and $0<\sigma_1<\sigma_2<1$, and let $(x_k,\alpha_k)_{k\ge0}$ be an infinite run of Algorithm SPG2: $x_0\in\Omega$, $\alpha_0\in[\alpha_{\min},\alpha_{\max}]$, Step 1 never stops, each $x_{k+1}=x_k+\lambda_k d_k$ is produced by the nonmonotone backtracking (3) with safeguards (2), and each $\alpha_{k+1}$ by the spectral rule of Step 3.
--
--   Then every accumulation point $\bar x$ of $(x_k)$ is a constrained stationary point:
--
--   $$
--   \langle g(\bar x),\,x-\bar x\rangle\ge0\qquad\text{for all } x\in\Omega .
--   $$
--
--   This is the global convergence theorem for the nonmonotone spectral projected gradient method SPG2: it holds for every admissible choice of the parameters and of the backtracking reductions, and it does not assume convexity of $f$ or boundedness of the level set.
--
--   **Formalization Note** "Accumulation point" is `MapClusterPt x̄ atTop x` (a cluster point of the sequence), not convergence. The run predicate `IsSPG2Run` covers every sequence the algorithm can generate when Step 1 never fires; a finite run ends at a stationary point by Step 1 and Lemma 2.1 (ii).
-- source:
--   Birgin, Martínez & Raydan, Nonmonotone Spectral Projected Gradient Methods on Convex Sets, authors' updated version (July 2004) of SIAM J. Optim. 10(4) (2000), https://www.ime.unicamp.br/~martinez/bmr.pdf, p. 5, Theorem 2.1 (second clause) and the displayed stationarity condition before it

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_SpectralProjGrad_Shared_IsConstrainedStationary
import Definitions.Def_SpectralProjGrad_SPG2_IsSPG2Run

namespace SpectralProjGrad.SPG2

/-- Theorem 2.1, second clause: every accumulation point `x̄` of the sequence `{x_k}` generated by
Algorithm SPG2 (when Step 1 never stops) is a constrained stationary point:
`⟨g(x̄), x - x̄⟩ ≥ 0` for all `x ∈ Ω`. -/
theorem accumulation_point_stationary {n : ℕ}
    {Ω U : Set (EuclideanSpace ℝ (Fin n))} {f : EuclideanSpace ℝ (Fin n) → ℝ}
    {P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)}
    {M : ℕ} {αmin αmax γ σ₁ σ₂ : ℝ}
    (hΩ_closed : IsClosed Ω) (hΩ_convex : Convex ℝ Ω)
    (hU_open : IsOpen U) (hΩU : Ω ⊆ U) (hf : ContDiffOn ℝ 1 f U)
    (hP : SpectralProjGrad.Shared.IsProjOnto Ω P)
    (hM : 1 ≤ M) (hαmin : 0 < αmin) (hαmin_lt : αmin < αmax)
    (hγ : γ ∈ Set.Ioo 0 1) (hσ₁ : 0 < σ₁) (hσ₁₂ : σ₁ < σ₂) (hσ₂ : σ₂ < 1)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {α : ℕ → ℝ}
    (hrun : IsSPG2Run Ω f P M αmin αmax γ σ₁ σ₂ x α)
    (xbar : EuclideanSpace ℝ (Fin n)) (hxbar : MapClusterPt xbar Filter.atTop x) :
    SpectralProjGrad.Shared.IsConstrainedStationary Ω f xbar := by sorry

end SpectralProjGrad.SPG2
