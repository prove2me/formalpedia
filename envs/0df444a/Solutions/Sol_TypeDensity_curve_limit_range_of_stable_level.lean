open TypeDensity

theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hreg : TypeDensity.RegularParameterPair R t x) (hregSwap : TypeDensity.RegularParameterPair R x t)
    (hregF : ∀ j : ℕ, Function.Injective (fun c : TypeDensity.BlowupOverlap R t x ⧸
      (Ideal.span {TypeDensity.overlapException R t x})^j =>
      Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j)
      ((algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j)) * c))
    (f : R)
    (hf : ∀ j : ℕ, TypeDensity.surfaceToCechInput R t x j f =
      (TypeDensity.cechInputLattice R t x j).mkQ (TypeDensity.gluedFunctionPair R t x G j))
    [IsAdicComplete (Ideal.span {t,x}) R] (J : ℕ) (hJ : d - 1 ≤ J)
    (σ : R →ₗ[R] TypeDensity.CurveOrderLimit R t x beta G)
    (hσ : ∀ r : R, ∃ p : TypeDensity.curveThreads R t x beta G, σ r = TypeDensity.curveLimitMk R t x beta G p ∧ ∀ j : ℕ,
      p.val j = TypeDensity.surfaceToChartPair R t x r)
    (p : TypeDensity.curveThreads R t x beta G)
    (hp : ∃ r : R, p.val J - TypeDensity.surfaceToChartPair R t x r ∈ TypeDensity.curveIdealLattice R t x beta G J) :
    TypeDensity.curveLimitMk R t x beta G p ∈ LinearMap.range σ := by
  -- Approximate `p` at every level, correct the approximants into an adically Cauchy sequence
  -- of surface functions, and take its limit.
  choose r hr using TypeDensity.exists_surface_approx_of_stable_level G hreg hregSwap hregF hJ p hp
  have hker : ∀ (j : ℕ) (a : R), TypeDensity.surfaceToChartPair R t x a ∈ TypeDensity.curveIdealLattice R t x beta G j ↔
      a ∈ Ideal.span {f} ⊔ (Ideal.span {t,x})^j := fun j a ↦
    TypeDensity.surface_to_curve_quotient_kernel R t x beta d G hreg hregSwap j (hregF j) f hf a
  have hdiff : ∀ j, r (j+1) - r j ∈ Ideal.span {f} ⊔ (Ideal.span {t,x})^j := fun j ↦ by
    rw [← hker]
    convert sub_mem (sub_mem (hr j) (TypeDensity.thread_sub_succ_mem G p j))
      ((TypeDensity.curve_lattices_antitone R t x beta d G j).1 (hr (j+1))) using 1
    rw [map_sub]; abel
  choose y hy z hz hyz using fun j ↦ Submodule.mem_sup.mp (hdiff j)
  set r' : ℕ → R := fun j ↦ r j - ∑ i ∈ Finset.range j, y i with hr'
  have hcauchy : ∀ m n, m ≤ n → r' m - r' n ∈ (Ideal.span {t,x})^m := by
    intro m n hmn
    induction n, hmn using Nat.le_induction with
    | base => simp
    | succ n hn ih =>
      have h2 : r' n - r' (n+1) = -z n := by
        simp only [hr', Finset.sum_range_succ]; linear_combination hyz n
      simpa only [← h2, sub_add_sub_cancel] using
        add_mem ih (neg_mem (Ideal.pow_le_pow_right hn (hz n)))
  obtain ⟨Lim, hLim⟩ := IsPrecomplete.prec (I := Ideal.span {t,x}) (M := R) inferInstance
    (f := r') fun {m n} hmn ↦ by
      rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
      exact hcauchy m n hmn
  have hLim' : ∀ j, p.val j - TypeDensity.surfaceToChartPair R t x Lim ∈ TypeDensity.curveIdealLattice R t x beta G j :=
    fun j ↦ by
      have h := hLim j
      rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at h
      have h1 := (hker j (Lim - r j)).2 <| by
        convert sub_mem
          (Ideal.mem_sup_left (neg_mem (sum_mem fun i (_ : i ∈ Finset.range j) ↦ hy i)))
          (Ideal.mem_sup_right h) using 1
        simp only [hr']; abel
      convert sub_mem (hr j) h1 using 1
      rw [map_sub]; abel
  obtain ⟨q, hq1, hq2⟩ := hσ Lim
  refine ⟨Lim, hq1.trans ((Submodule.Quotient.eq _).2 (Submodule.mem_pi.2 fun j _ ↦ ?_))⟩
  change q.val j - p.val j ∈ TypeDensity.curveIdealLattice R t x beta G j
  rw [hq2 j, ← neg_sub]
  exact neg_mem (hLim' j)
