    CerednikDrinfeld.QM.FakeEllipticCurve.smoothOfRelativeDimension_two k E
  haveI hcpt : CompactSpace E.A := by
    constructor
    have hU : (Set.univ : Set E.A) = ⋃ i, (𝒦.U i : Set E.A) := by
