namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-- `k := i + j` on integer items (popping both). Scratch stacks `t1`, `t2`. -/
def addInt (q i j k t1 t2 : Fin S) : Stmt S P :=
  caseTop i fun oi => caseTop j fun oj =>
    .seq (.pop i) (.seq (.pop j)
      (if decide (oi = some hdNeg) = decide (oj = some hdNeg) then
        addMag q i j k t1 t2 (if oi = some hdNeg then hdNeg else hdPos)
      else if oi = some hdNeg then subMag q i j k t1 t2 hdNeg hdPos
      else subMag q i j k t1 t2 hdPos hdNeg))

def addIntCost (L : ℕ) : ℕ := addMagCost L + subMagCost L + 36

