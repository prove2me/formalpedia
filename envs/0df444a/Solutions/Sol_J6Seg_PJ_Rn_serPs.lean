-- Source module: Solutions.J6SegILPreJD7
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D7: the serialization stage `serP`

**`Rn.serPs`**: `serP` pushes `(serL …).reverse` onto `41`, sets `22` to the number of border
rows and `23` to the number of pushed entries; registers outside `1–8, 22, 23, 29` and all
stacks but `41` are unchanged.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

section outer
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

theorem recL_length_le (kk m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) :
    ∀ k, ((List.range k).flatMap (recP kk m mw cB L Mf)).length ≤ k * (2 * m + 5)
  | 0 => by simp
  | n + 1 => by
    have ih := recL_length_le kk m mw cB L Mf n
    have h1 := recP_length kk m mw cB L Mf n
    have h2 := czP_length_le m mw cB L Mf n
    have h3 : wbN m mw L n ≤ m := (wbN_le m mw L n).trans (by omega)
    rw [List.range_succ, List.flatMap_append, List.length_append]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    nlinarith

theorem rowL_length_le (Q m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) :
    ∀ k, ((List.range k).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).length ≤
      k * (m + 1)
  | 0 => by simp
  | n + 1 => by
    have ih := rowL_length_le Q m mw cB L Mf n
    have h1 := rowP_length Q m mw cB L Mf (m - 1 - n)
    have h2 := cwN_le m mw cB L (m - 1 - n)
    rw [List.range_succ, List.flatMap_append, List.length_append]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    have : m - 1 - n ≤ m := by omega
    nlinarith

/-- **The serialization stage**, in terms of `serL`. -/
theorem Rn.serPs_sol_aux {v : Vr} {c : Cs} (hF : Fx Q kk m mw cB v) (hS : StS m L Mf c)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W v) (hc50 : c 50 = []) (hc51 : c 51 = [])
    (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) :
    Rn serP v c (fun v' =>
      (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)), v' i = v i) ∧
      v' 22 = (flN cB L m : ℤ) ∧ v' 23 = ((serL Q kk m mw cB L Mf).length : ℤ) ∧ BV W v')
      (update c 41 ((serL Q kk m mw cB L Mf).reverse ++ c 41)) (cSer W m) := by
  have h2W := hB.two
  have hok : OkL W (m * m + m) serI (v, c) := by
    simp (disch := decide) only [serI, OkL, runL, Ins.run, Ins.ok, E.den]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    done
  have H0 := Rn.insL hB.2.1 serI hv hok
  have hc0 : (runL serI (v, c)).2 = c := by simp only [serI, runL, Ins.run]
  rw [hc0] at H0
  refine Rn.seq H0 (fun v1 hv1 => ?_)
  obtain ⟨e1, b1⟩ := hv1
  subst e1
  have f1 : ∀ i ∉ ([22, 23] : List (Fin HS)), (runL serI (v, c)).1 i = v i := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    simp only [serI, runL, Ins.run, update_apply, hi.1, hi.2, if_false]
  have a22 : (runL serI (v, c)).1 22 = 0 := by
    simp (disch := decide) only [serI, runL, Ins.run, E.den, update_of_ne, update_self]
  have a23 : (runL serI (v, c)).1 23 = 0 := by
    simp (disch := decide) only [serI, runL, Ins.run, E.den, update_of_ne, update_self]
  have F1 : Fx Q kk m mw cB (runL serI (v, c)).1 := hF.frm f1 (by decide)
  have hlB := recL_length_le kk m mw cB L Mf m
  have hlF := rowL_length_le Q m mw cB L Mf m
  have H1 := Rn.bLoop (kk := kk) F1 hS hB hLm b1 a22 a23 hc50 hc51 hW8
  refine Rn.seq H1 (fun v2 hv2 => ?_)
  obtain ⟨b22, b23, bf, bb⟩ := hv2
  set D2 := update c 41 (((List.range m).flatMap (recP kk m mw cB L Mf)).reverse ++ c 41) with hD2
  have F2 : Fx Q kk m mw cB v2 := F1.frm bf (by decide)
  have H2 := Rn.fLoop (Q := Q) (D := D2) F2 (hS.upd (j := 41) (by decide) _) hB hLm bb b23
    (by rw [hD2, update_of_ne (by decide)]; exact hc50)
    (by rw [hD2, update_of_ne (by decide)]; exact hc51) (by nlinarith) hW8
  have hst : update D2 41 (((List.range m).flatMap
      (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).reverse ++ D2 41) =
      update c 41 ((serL Q kk m mw cB L Mf).reverse ++ c 41) := by
    simp only [hD2, update_idem, update_self, serL, List.reverse_append, List.append_assoc]
  refine (H2.mono (fun v' hv' => ?_) le_rfl).congr hst
  obtain ⟨g23, gf, gb⟩ := hv'
  refine ⟨frm_trans (C := [1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29])
    (frm_trans (C := [1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29]) f1 bf (by decide) (by decide)) gf
    (by decide) (by decide), ?_, ?_, gb⟩
  · rw [gf 22 (by decide), b22]
  · rw [g23]; simp [serL]

end outer

end J6Seg.PJ

