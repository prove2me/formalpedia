section
-- Source module: Solutions.J6SegVal2
/-!
# B-line value bounds 2: the chunk kernel, crude entrywise bound

With all stage-table entries `≤ 2^(P+a)` in modulus (at indices `< 2^ℓ`) and an input of
length `≤ 2^ℓ` with entries `≤ 2^e`, every output entry of the block solve `blkL` and of the
chunk kernel `chunkL` is `≤ 2^(e + 7a + 2ℓ)` (five diagonal stages, two Toeplitz stages of
length `≤ 2^ℓ`; each rounding `rs P` of a value `≤ 2^(P+f)` is `≤ 2^f`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.Val

/-- Entries of modulus `≤ 2^e`. -/
def IB (e : ℕ) (x : List ℤ) : Prop := ∀ a ∈ x, |a| ≤ 2 ^ e

/-- A table bounded by `A` at the indices `< N` (as `getD`). -/
def TB (A : ℤ) (N : ℕ) (c : List ℤ) : Prop := ∀ i < N, |c.getD i 0| ≤ A

/-! ## The line's chunk kernel -/

/-- The stage tables of `T` bounded by `A` at indices `< λ`. -/
def TabB (A : ℤ) (lam : ℕ) (T : Tables) : Prop :=
  ∀ u < lam, |T.di u| ≤ A ∧ |T.gi u| ≤ A ∧ |T.gam u| ≤ A ∧ |T.dd u| ≤ A ∧
    ∀ c, |T.am c u| ≤ A ∧ |T.ap c u| ≤ A

end J6Seg.Val

end

section
-- Source module: Solutions.J6SegVal5
/-!
# B-line value bounds 5: `ValNeed6` from the chunk-table bound and the `J`-kernel facts

* `ValCond6 ap`: linear lower bounds on the plan constants.
* `JNeed6 P` (B4, per axis of the round-six regime): the `J` kernel's output bound on any row with
  `Bnd Bv` parts, `JPre` of any such row for every `Xb ≥ max Bv Q + size(2w+1) + 4`,
  `Bc ≥ size(G + 2w + 3s² + 2ws + 10s)`, `k ≥ 2Xb + 2Q + Bc + 6`, and `w ≤ s`.
* **`valNeed6_of`**: `ChunkTabBnd6 P → JNeed6 P → ∀ ap, ValCond6 ap → ValNeed6 P ap`.

Exponents (with `Q = segPF p d s`, `a = R + 2`, `ℓ = log₂ λ`; `7a ≤ Q + 13`, `ℓ < Q`):
`S ≤ 2^(Q+1)`, `Y, Jg ≤ 2^eY` with `eY = Q + 1 + 7a + 2ℓ ≤ 4Q + 12`,
`W, Wp ≤ 2^(eY + 1 + 2Q + 4) ≤ 2^(6Q+17)`, `Y₂ ≤ 2^(9Q+28)`;
`J` output on a `JPre` row `≤ 2^(Xb + 2Q + 4)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

/-- **The plan conditions** (lower bounds only). -/
def ValCond6 (ap : AxPlan6) : Prop :=
  9 ≤ ap.pl.wA ∧ 29 ≤ ap.pl.wC ∧ ap.xbA + 2 ≤ ap.pl.wA ∧ ap.xbC + 5 ≤ ap.pl.wC ∧
  6 ≤ ap.xA ∧ 17 ≤ ap.xC ∧ 5 ≤ ap.xbA ∧ 17 ≤ ap.xbC ∧ 1 ≤ ap.bcA ∧ 4 ≤ ap.bcC ∧
  2 * ap.xbA + ap.bcA + 2 ≤ ap.pl.kA ∧ 2 * ap.xbC + ap.bcC + 6 ≤ ap.pl.kC

/-- The `J`-kernel facts of axis `k` (B4). -/
def JAx6 (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) : Prop :=
  let Q := axQ6 P n src k; let w := axw6 P n; let G := axG6 P n src k; let s := axs6 src k
  let jk := jKer Q (axR6 P n) s (axt6 P n k) (axl6 P n) w (axα6 P n) w G
  axw6 P n ≤ axs6 src k ∧
  (∀ (Bv : ℕ) (x : List GI), x.length = G → NLogN.Bnd Bv (x.map Prod.fst) →
    NLogN.Bnd Bv (x.map Prod.snd) → ∀ y ∈ liftG jk x,
      |y.1| ≤ 11 * (2 * w + 1) * (2 * w + 1) * 2 ^ (max Bv Q) ∧
      |y.2| ≤ 11 * (2 * w + 1) * (2 * w + 1) * 2 ^ (max Bv Q)) ∧
  (∀ (Bv Xb Bc kk : ℕ), max Bv Q + Nat.size (2 * w + 1) + 4 ≤ Xb →
    Nat.size (G + 2 * w + 3 * s ^ 2 + 2 * w * s + 10 * s) ≤ Bc → 2 * Xb + 2 * Q + Bc + 6 ≤ kk →
    ∀ x : List GI, x.length = G → NLogN.Bnd Bv (x.map Prod.fst) → NLogN.Bnd Bv (x.map Prod.snd) →
    JK.JPre Q kk w G Xb Bc (JK.jFs Q (axR6 P n) s (axt6 P n k) (axl6 P n) w (axα6 P n))
      (JK.jBs Q (axR6 P n) s (axt6 P n k) (axl6 P n) w (axα6 P n))
      (JK.jCc Q (axR6 P n) s (axt6 P n k) (axl6 P n) w (axα6 P n) w) x)

/-- **`JNeed6 P`**: the `J`-kernel facts on every axis of the round-six regime. -/
def JNeed6 (P : Prm) : Prop :=
  ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D, JAx6 P n src k

/-! ## Arithmetic helpers -/

end J6Seg.Val
end

end

section
-- Source module: Solutions.J6SegJPre1
/-!
# `J` kernel precondition (JPre), part 1: the regime and the capacitance of a line

`SegReg P R s t λ w α` bundles the hypotheses of `segInvFullS_err` (with `Bu = 1/2`, as used by
`B0seg`): `0 < s ≤ t`, `2 ≤ α`, `3 ≤ xθ`, `1 ≤ λ`, `w ≤ s`, `D_{λ-1} ≤ 2^R`,
`1000 · fullG λ w s t α (1/2) ≤ 2^P`.

`segReg_cap`: in this regime the capacitance `capI P (TT P R s t α) (BB s t λ w)` on the line
`LJ s t λ w` has row sums `|C/2^P - I| ≤ η ≤ 1/4`, vanishes off the pattern
`bandS (λ+w) (s-λ-w)`, and `(|LJ|+1)²/2^P ≤ 1/8` (so also `η + |LJ|²/2^P ≤ 1/2`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-- The regime of the segmented inverse on one axis. -/
structure SegReg (P R s t lam w α : ℕ) : Prop where
  hs : 0 < s
  hst : s ≤ t
  hα : 2 ≤ α
  hx : 3 ≤ xθ s t α
  hl : 1 ≤ lam
  hw : w ≤ s
  hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R
  hP : 1000 * fullG lam w s t α (1 / 2) ≤ 2 ^ P

end J6Seg

end

section
-- Source module: Solutions.J6SegILPreJM1
/-!
# B-line IL, `J` pre-table (B5-J), math part 1: the elimination in index form and its bounds

* `aseq_rows`: under the near-identity hypotheses of `pivPos_of` (same induction), every
  trailing block of the pattern elimination `Aseq` stays within `1/2` of the identity in row sums;
  hence (`aseq_entry`, `aseq_piv`) its entries are `≤ (3/2) 2^P` and its pivots `≥ 2^P/2`;
* `Mseq`: the elimination on line indices that only updates the trailing block (`q < i, k`);
  `Mseq_eq`: on the trailing block it is `Aseq` (`Aseq_last`: one more pivot is one more
  `stepA`); `Mseq_frz`: entry `(i, k)` is frozen from step `min i k` on. So the final matrix
  holds `Aseq (min i k) (L i) (L k)` at `(i, k)`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section idx
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ)

/-- The line entry. -/
def Lg (i : ℕ) : ℕ := L.getD i 0

/-- One pivot on line indices, trailing block only. -/
def stepI (q : ℕ) (M : ℕ → ℕ → ℤ) : ℕ → ℕ → ℤ := fun i k =>
  if q < i ∧ q < k ∧ S (Lg L i) (Lg L q) ∧ S (Lg L q) (Lg L k) then
    M i k - fmul P (fdiv P (M i q) (M q q)) (M q k) else M i k

/-- The elimination on line indices. -/
def Mseq : ℕ → ℕ → ℕ → ℤ
  | 0 => fun i k => A (Lg L i) (Lg L k)
  | q + 1 => stepI P S L q (Mseq q)

end idx

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre2
/-!
# `J` kernel precondition (JPre), part 2: entries and pivots of the elimination

`ElimOK P S L A η` bundles the hypotheses of `aseq_rows`/`geSolveS_eq` (near-identity rows with
`η + |L|²/2^P ≤ 1/2`, zero pattern, `PatOK`). Under it, on every trailing block `L.drop r`:

* `aseq_dev`: `|A_r(i,k)/2^P - δ_ik| ≤ 1/2`;
* `aseq_abs_le` / `aseq_int_le`: `|A_r(i,k)| ≤ (3/2) 2^P ≤ 2^{P+1}`; `aseq_zsz`: `zsz ≤ P + 1`;
* `aseq_off`: off the diagonal `|A_r(i,k)| ≤ 2^P/2`;
* `aseq_piv` / `aseq_piv_int`: the pivot `A_r(i,i) ≥ 2^P/2` (`≥ 2^{P-1}` in `ℤ`);
* `aseq_offsum`: the off-diagonal part of pivot row `r` sums to `≤ 2^P/2`;
* `fco_abs_le`: the forward multipliers satisfy `|F| ≤ 2^P + 1`.

`segReg_elim`: the capacitance of a line in the regime `SegReg` satisfies `ElimOK` on
`LJ` with the pattern `bandS (λ+w) (s-λ-w)`; `segReg_aseq` collects the bounds there.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-- The hypotheses of the pattern elimination. -/
structure ElimOK (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ)
    (η : ℝ) : Prop where
  nd : L.Nodup
  η0 : 0 ≤ η
  ηs : η + (L.length : ℝ) ^ 2 / 2 ^ P ≤ 1 / 2
  row : ∀ i ∈ L, ∑ k ∈ L.toFinset, |(A i k : ℝ) / 2 ^ P - kd i k| ≤ η
  zero : ∀ i ∈ L, ∀ k ∈ L, ¬ S i k → A i k = 0
  pat : PatOK S L

/-! ## The line in the regime -/

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre4
/-!
# `J` kernel precondition (JPre), part 4: the intermediates of the kernel in closed form

For the streams `fsOf`/`bsOf` of a sorted line `L` (pattern `bandS mw c`, border `c ≤ ·`) and an
input `v` (`|L| ≤ |v|`), with the right-hand side `bv L v` (`bv (L_r) = v_r`):

* `fA_eq`: the forward accumulator after `r` rows is `accF r = [bt_{r-1}, …, bt_0]`;
* `bwdS_eq`: the backward state after `j` records is `(accZ (m-j), accB (m-j))` (the solution
  values `z_{m-j}, …, z_{m-1}` and their border part);
* the shapes of the streams (`fsOf_getElem_length`, `bsOf_getElem`, `WbOf_le`,
  `czOf_length`, `flOf_01`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK

/-- The right-hand side carried by a gathered row: `bv L v (L_r) = v_r`. -/
def bv (L : List ℕ) (v : List ℤ) : ℕ → ℤ := fun i => v.getD (L.idxOf i) 0

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre6
/-!
# `J` kernel precondition (JPre), part 6: the explicit parameters and the table length

* `Xb0 P w Bv = max Bv P + size (2w+1) + 4`: the a-priori bit bound of every stream entry and
  intermediate of the `J` kernel on an input with `Bnd Bv`;
* `Bc0 s K G = size (G + 2K + 3s² + 2Ks + 10s)`: the counter bound;
* `jBody_len`: `|jBody| ≤ 3m² + 2Km + 7m` for streams of `m` rows with the line shapes;
* `zsz_of_abs`, `abs_of_bnd`: between `zsz` bounds and real bounds;
* `xb0_ge`: `2^{Xb0} ≥ 16 (2w+2) 2^{max Bv P}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL Function

/-- The bit bound of the `J` kernel intermediates. -/
def Xb0 (P w Bv : ℕ) : ℕ := max Bv P + Nat.size (2 * w + 1) + 4

/-- The counter bound of the `J` kernel. -/
def Bc0 (s K G : ℕ) : ℕ := Nat.size (G + 2 * K + 3 * s ^ 2 + 2 * K * s + 10 * s)

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre8
/-!
# `J` kernel precondition (JPre), part 8: the output bound of the `J` kernel

`jKer_out_bnd`: in the regime `SegReg`, with `|LJ| ≤ G`, for every row part `v` of length `G`
with `Bnd Bv v`, every entry of `jKer P R s t λ w α K G v` is bounded by
`jWb P w K Bv = 11 (2K+1)(2w+1) 2^{max Bv P}` (the window coefficients are `≤ (2w+1)(2^P+1)`,
the capacitance solution `≤ 4·2^{Bv} + 2^P`). `jKerG_out_bnd`: the same for both parts of a
`GI` row through `liftG`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL NLogN.KFB Function

/-- The output bound of the `J` kernel. -/
def jWb (P w K Bv : ℕ) : ℤ := 11 * (2 * K + 1) * (2 * w + 1) * 2 ^ (max Bv P)

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegAxChunk
/-!
# B-line axis: the chunk kernel's output bound (`ChunkOut6`)

* `AB_chunkB`, `AB_chunkG2`: all-blocks growth (`chunkOK`) bounds the chunk output;
* `Xs_le_pow`: `Xs K X i ≤ 2^((a+1) i) X` for `0 ≤ K ≤ 2^a`;
* `ChunkPlan6 ap`: linear lower bounds on `pkA, pkC, wA, wC` (value-only plan conditions);
* **`chunkOutAt_of`**: `TabAt → ChunkPlan6 ap → ChunkOutAt` (one axis);
* **`chunkOut6_of`**: `ChunkTabBnd6 P → ChunkPlan6 ap → ChunkOut6 P ap` (whole regime).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.AxCh
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg J6Seg.KR J6Seg.Ax

/-- **Value-only plan conditions for the chunk kernel.** -/
def ChunkPlan6 (ap : AxPlan6) : Prop :=
  ap.xA + 8 ≤ ap.pl.pkA ∧ ap.xC + 27 ≤ ap.pl.pkC ∧ ap.pl.pkA ≤ ap.pl.wA ∧ ap.pl.pkC + 1 ≤ ap.pl.wC

/-- **The chunk output bound over the round-six regime** (Track D's hypothesis form). -/
def ChunkOut6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D, ChunkOutAt P ap n src k

end J6Seg.AxCh

namespace J6Seg.AxCh
open IntMul.Kappa.R6 J6Seg

end J6Seg.AxCh
end

end

section
-- Source module: Solutions.J6SegILSweep2
/-!
# B-line IL, B6 §2: reading the line descriptor

`hdrA σ dS` (on `dS = descLine6 = p :: α :: h :: d :: (bits ++ svals)`): pop `p, α, h, d` into
`σ 0..3`, move the `d` bits onto `σ 12` while counting the ones in `σ 4`, move them on to `σ 13`
(in order), then `σ 5 := T = 2^{h d + #ones}`, `σ 6 := 1` (`pre`), `σ 8 := 0` (`k`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- One bit: copy it onto `σ 12`, add it to `σ 4`, pop it. -/
def bitB (σ : Fin 19 → Fin HS) (dS : Fin HS) : RS :=
  .seq (.push (σ 12) (.reg dS)) (.seq (.asg (σ 4) (.add (.reg (σ 4)) (.reg dS))) (.pop dS))

/-- Read one header value into `σ i`. -/
def rdS (σ : Fin 19 → Fin HS) (dS : Fin HS) (i : Fin 19) : RS :=
  .seq (.push (σ i) (.reg dS)) (.pop dS)

/-- The header pass. -/
def hdrA (σ : Fin 19 → Fin HS) (dS : Fin HS) : RS :=
  .seq (rdS σ dS 0) (.seq (rdS σ dS 1) (.seq (rdS σ dS 2) (.seq (rdS σ dS 3)
  (.seq (.push (σ 4) (.lit 0)) (.seq (.rep (σ 16) (.reg (σ 3)) (bitB σ dS))
  (.seq (mvK (σ 12) (σ 13) (σ 18) (.reg (σ 3)))
  (.seq (.push (σ 5) (.pow2 (.add (.mul (.reg (σ 2)) (.reg (σ 3))) (.reg (σ 4)))))
  (.seq (.push (σ 6) (.lit 1)) (.push (σ 8) (.lit 0))))))))))

section hdr
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
include hW

/-- The register contents after the header pass. -/
def vH (p α h d c : ℕ) (bs : List ℤ) : Fin 19 → List ℤ :=
  update (update (update (update (update (update (update (update (update (fun _ : Fin 19 => ([] : List ℤ))
    0 [(p : ℤ)]) 1 [(α : ℤ)]) 2 [(h : ℤ)]) 3 [(d : ℤ)]) 4 [(c : ℤ)]) 13 bs)
    5 [(2 : ℤ) ^ (h * d + c)]) 6 [1]) 8 [0]

/-- The cost of the header pass. -/
def cHdr (B d : ℕ) : ℕ := 2 * 10 ^ 8 * (B + 2) ^ 2 + 100000 * (B + 2) * (d + 2)

end hdr

end J6Seg

end

section
-- Source module: Solutions.J6SegILSweep3
/-!
# B-line IL, B6 §3: pushing / dropping a descriptor by `dup` / `drop`, one axis step

* `dupsI rs dA`: `dup r dA` for `r ∈ rs` in order (`dups_run`: pushes the values, the last on
  top); `dropsI dA n`: `n` drops (`drops_run`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- `dup r dA` for each `r` in order. -/
def dupsI {Pp : ℕ} (dA : Fin HS) : List (Fin HS) → IStmt HS Pp
  | [] => .skip
  | r :: rs => .seq (.op (.dup r dA)) (dupsI dA rs)

/-- `n` drops of `dA`. -/
def dropsI {Pp : ℕ} (dA : Fin HS) : ℕ → IStmt HS Pp
  | 0 => .skip
  | n + 1 => .seq (.op (.drop dA)) (dropsI dA n)

end J6Seg

end

section
-- Source module: Solutions.J6SegILSweep4
/-!
# B-line IL, B6 §4: one axis step

At axis `k` the registers hold (`vK`): `σ 0..3 = p, α, h, d`, `σ 4 = #ones`, `σ 5 = T`,
`σ 6 = pre_k`, `σ 8 = k`, `σ 13 = bits_{≥k}`, `σ 14 = bits_{<k}` (reversed), `σ 15 = s_{<k}`
(reversed); `dS = s_{≥k}`.

`axP1`: `σ 9 := b_k`, `σ 10 := s_k` (both also saved on `σ 14`, `σ 15`), `σ 11 := t_k = 2^h (1 +
b_k)`, `σ 7 := post_k = T / (pre_k t_k)`; then `descAx6` is pushed on `dA` by `dup`, `eX` is
called, the descriptor dropped; `axP2`: pop `σ 9, 10, 7`, `σ 6 := pre_k t_k`, pop `σ 11`,
`σ 8 := k + 1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- Before the call. -/
def axP1 (σ : Fin 19 → Fin HS) (dS : Fin HS) : RS :=
  .seq (.push (σ 9) (.reg (σ 13))) (.seq (.pop (σ 13)) (.seq (.push (σ 14) (.reg (σ 9)))
  (.seq (.push (σ 10) (.reg dS)) (.seq (.pop dS) (.seq (.push (σ 15) (.reg (σ 10)))
  (.seq (.push (σ 11) (.mul (.pow2 (.reg (σ 2))) (.add (.lit 1) (.reg (σ 9)))))
  (.push (σ 7) (.quo (.reg (σ 5)) (.mul (.reg (σ 6)) (.reg (σ 11)))))))))))

/-- The descriptor sources (pushed in this order, so `k` ends on top). -/
def axRegs (σ : Fin 19 → Fin HS) : List (Fin HS) :=
  [σ 3, σ 1, σ 0, σ 11, σ 10, σ 7, σ 6, σ 8]

/-- After the call. -/
def axP2 (σ : Fin 19 → Fin HS) : RS :=
  .seq (.pop (σ 9)) (.seq (.pop (σ 10)) (.seq (.pop (σ 7))
  (.seq (.asg (σ 6) (.mul (.reg (σ 6)) (.reg (σ 11)))) (.seq (.pop (σ 11))
  (.asg (σ 8) (.add (.reg (σ 8)) (.lit 1)))))))

/-- One axis. -/
def axB {Pp : ℕ} (σ : Fin 19 → Fin HS) (dS dA : Fin HS) (eX : Fin Pp) : IStmt HS Pp :=
  .seq (axP1 σ dS).code (.seq (dupsI dA (axRegs σ)) (.seq (.call eX)
    (.seq (dropsI dA 8) (axP2 σ).code)))

section vals
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ)

/-- The bits. -/
def bsW : List ℤ := KFM.bitsZ (D + 1) (bL6 P n)
/-- The source lengths. -/
def svW : List ℤ := (List.range (D + 1)).map fun j => (src j : ℤ)
/-- `T`. -/
def TW : ℕ := (List.ofFn (tD6 P n D)).prod

/-- The registers at axis `k`. -/
def vK (k : ℕ) : Fin 19 → List ℤ :=
  update (update (update (update (update (vH (pP6 P n) (αN6 P n) (hN6 P n) (D + 1)
    (cntB P n (D + 1)) (bsW P n D)) 13 ((bsW P n D).drop k)) 14 ((bsW P n D).take k).reverse)
    15 ((svW src D).take k).reverse) 6 [(preT P n D k : ℤ)]) 8 [(k : ℤ)]

end vals

end J6Seg

end

end

section
-- Source module: Solutions.J6SegILSweep6
/-!
# B-line IL, B6 §6: `axP1` and `axP2` on the sweep state
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- The size bounds of the sweep. -/
structure SwB (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D B : ℕ) : Prop where
  two : 2 ≤ B
  hB : hN6 P n * (D + 1) + (D + 1) + 1 ≤ B
  T : zsz (TW P n D : ℤ) ≤ B
  p : zsz (pP6 P n : ℤ) ≤ B
  α : zsz (αN6 P n : ℤ) ≤ B
  s : ∀ k ≤ D, zsz (src k : ℤ) ≤ B

/-- The registers after `axP1`. -/
def wK (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (c17 : List ℤ) : Fin 19 → List ℤ :=
  update (update (update (update (update (update (update (update (vK P n src D k) 17 c17)
    9 [(bsW P n D)[k]!]) 13 ((bsW P n D).drop (k + 1)))
    14 ((bsW P n D)[k]! :: ((bsW P n D).take k).reverse)) 10 [(src k : ℤ)])
    15 ((src k : ℤ) :: ((svW src D).take k).reverse)) 11 [(tF6 P n k : ℤ)])
    7 [(postT P n D k : ℤ)]

/-- The cost of `axP1`. -/
def cP1 (B : ℕ) : ℕ := 2 * 10 ^ 8 * (B + 2) ^ 2

theorem T_eq (P : Prm) (n D : ℕ) :
    ((2 : ℤ) ^ (hN6 P n * (D + 1) + cntB P n (D + 1))) = (TW P n D : ℤ) := by
  unfold TW; rw [total_eq]; push_cast; ring

end J6Seg

end

end

