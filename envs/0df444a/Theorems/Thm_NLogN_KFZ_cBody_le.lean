variable {p h D σ B Bd b len P N : ℕ} {sv t : Fin (D + 1) → ℕ}

theorem NLogN.KFZ.cBody_le (hP : dlV p h (D + 1) + 3 ≤ P) (hB : B ≤ P) (hBd : Bd ≤ P) (hb : b ≤ P)
    (hlen : len ≤ P) (hst : ∀ i, sv i ≤ t i) (ht2 : ∀ i, 2 ≤ t i) (hT : ∀ i, t i ≤ 2 ^ (h + 1))
    (hprod : ∏ i, t i = 2 ^ ((D + 1) * h + σ))
    (hM : (∏ i : Fin D, t i.castSucc) * 2 ^ (h + 1) = 2 ^ ((D + 1) * h + σ))
    (hdr : (D + 1) * 2 ^ (h + 1) ≤ 2 ^ ((D + 1) * h + σ)) :
    NLogN.KFZ.cBody B Bd b len p h D σ sv t ≤
      10 ^ 30 * ((2 ^ ((D + 1) * h + σ) + 1) * (FM P + P + 1) + (P + 31) ^ 6) := by sorry
