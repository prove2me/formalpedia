-- title:
--   Proof of Theorem 4.4 — $\|y^k - y^\star\| \le \|y^{k-1} - y^\star + \delta_k(\mathcal F(X^k) - \mathcal F(X^\star))\|$
-- statement:
--   Let $\tau>0$, let $f_1,\dots,f_m$ be convex functions on $\mathbb R^{n_1\times n_2}$ with $\mathcal F = (f_1,\dots,f_m)$, let $(X^k, y^k)$ be generated by iteration (3.5) from $y^0 = 0$ with step sizes $\delta_k>0$ ($k\ge 1$), and let $(X^\star, y^\star)$ be a primal-dual optimal pair for (3.4). Then for every $k\ge 1$,
--   $$\|y^k - y^\star\| \le \|\,y^{k-1} - y^\star + \delta_k(\mathcal F(X^k) - \mathcal F(X^\star))\,\|,$$
--   where $\|\cdot\|$ is the Euclidean norm on $\mathbb R^m$.
--
--   It combines Lemma 4.3 ($y^\star$ is a fixed point of the projected dual step) with the fact that the projection onto the nonnegative orthant is a contraction.
--
--   **Formalization Note** The paper's step $k$ is the Lean index `k + 1`. The positivity $\delta_k>0$ is the paper's standing step-size assumption $\inf_k\delta_k>0$; it is needed to apply Lemma 4.3.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1969, proof of Theorem 4.4, display following (4.5)

import Mathlib
import Definitions.Def_CaiCandesShen_GeneralConvex_Problem

namespace CaiCandesShen.GeneralConvex

/-- Proof of Theorem 4.4, p. 1969 (display after (4.5)): along a run of (3.5) with positive step
sizes and for a primal-dual optimal pair `(X⋆, y⋆)` of (3.4), for every `k ≥ 1`,
`‖y^k - y⋆‖ ≤ ‖y^{k−1} - y⋆ + δ_k (𝓕(X^k) - 𝓕(X⋆))‖`. Paper index `k` is `k + 1` here. -/
theorem projection_contraction {n₁ n₂ m : ℕ} (τ : ℝ) (hτ : 0 < τ)
    (f : Fin m → Mat n₁ n₂ → ℝ) (hconv : ∀ i, ConvexOn ℝ Set.univ (f i))
    (δ : ℕ → ℝ) (hδ : ∀ k : ℕ, 1 ≤ k → 0 < δ k)
    (X : ℕ → Mat n₁ n₂) (y : ℕ → Fin m → ℝ) (hseq : IsGeneralSVTSeq τ f δ X y)
    (Xs : Mat n₁ n₂) (ys : Fin m → ℝ) (hopt : IsPrimalDualOptimal τ f Xs ys) :
    ∀ k : ℕ, eucNorm (y (k + 1) - ys) ≤ eucNorm (y k - ys +
      δ (k + 1) • (constraintMap f (X (k + 1)) - constraintMap f Xs)) := by sorry

end CaiCandesShen.GeneralConvex
