-- title:
--   Ordinary natural filtration embeds into its right-continuous refinement
-- statement:
--   At time t, the raw natural sigma-field generated by the process history is contained in its right-continuous enlargement, which is the intersection of raw natural fields at all strictly later times. This follows from the proved monotonicity of the raw natural filtration. It is necessary for proving that Brownian values are adapted to the right-natural filtration.
-- source:
--   Kyprianou (2006) Chapter 1 Theorem 1.13; right-continuous augmentation of the Brownian natural filtration.

import Mathlib
import Definitions.Def_Kyprianou_Ch01_McKeanRightContinuousFiltration
import Theorems.Thm_Kyprianou_Ch01_naturalSigma_monotone
open MeasureTheory ProbabilityTheory Kyprianou.Ch01 Set Filter
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch01.naturalSigma_le_naturalSigmaRight
    {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) :
    naturalSigma X t ≤ naturalSigmaRight X t := by sorry
