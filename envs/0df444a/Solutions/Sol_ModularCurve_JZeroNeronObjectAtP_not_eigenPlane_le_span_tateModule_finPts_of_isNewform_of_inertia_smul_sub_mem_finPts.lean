      Ideal.span {((lam ^ (n' + 1) : ℕ) : O'')} := by
    have h1 : (algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2 ∈
        Ideal.span {((lam ^ (n' + 1) : ℕ) : O'')} := by
      have hfac : (algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2 =
