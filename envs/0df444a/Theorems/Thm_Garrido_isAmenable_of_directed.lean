-- title:
--   Proposition 2.2(3) — a directed union of amenable groups is amenable
-- statement:
--   Let $G$ be a group and $H : \iota \to \{\text{subgroups of } G\}$ a family of
--   subgroups that is **directed** (for any $i, j$ there is $k$ with $H_i \le H_k$ and
--   $H_j \le H_k$) and whose supremum is all of $G$. If every $H_i$ is amenable then $G$ is
--   amenable.
--
--   The index type $\iota$ is arbitrary and is **not** assumed nonempty: when $\iota$ is empty the
--   supremum hypothesis reads $\bot = \top$, which forces $G$ to be trivial, and the conclusion
--   still holds — the hypothesis is satisfiable rather than vacuous.
--
--   The exhaustion hypothesis is written as the supremum of the subgroups being $\top$. That
--   supremum is the subgroup *generated by* $\bigcup_i H_i$, which in general is larger than the
--   union — but for a **directed** family the union is already a subgroup, so the two coincide and
--   the hypothesis says exactly what the source's "direct union" says. Concretely, with $\iota$
--   nonempty and the family directed, the subgroup generated by $\bigcup_i H_i$ is $G$ if and
--   only if $\bigcup_i H_i = G$. Directedness is
--   what makes the phrasing faithful, so it cannot be dropped.
-- source:
--   A. Garrido, "An introduction to amenable groups", lecture notes, Oxford Advanced Class in Algebra, Michaelmas 2013 (PDF, Feb 2015), p. 6, Proposition 2.2(3); https://web.archive.org/web/20260805000803/https://www.math.uni-duesseldorf.de/~garrido/amenable.pdf

import Mathlib
import Definitions.Def_Garrido_Amenability

namespace Garrido

theorem isAmenable_of_directed {G : Type*} [Group G] {ι : Type*}
    (H : ι → Subgroup G) (hdir : Directed (· ≤ ·) H) (hsup : ⨆ i, H i = ⊤)
    (hamen : ∀ i, IsAmenable (H i)) :
    IsAmenable G := by
  sorry

end Garrido
