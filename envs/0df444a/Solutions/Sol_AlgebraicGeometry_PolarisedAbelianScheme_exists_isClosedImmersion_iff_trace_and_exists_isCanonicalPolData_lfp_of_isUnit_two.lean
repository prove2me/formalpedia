theorem locIsoOnBase_congr {S : Type} [CommRing S] {Y : Scheme.{0}} (g : Y ⟶ Spec (CommRingCat.of S))
    {M M' N N' : Y.Modules} (h : LocIsoOnBase g M M') (eM : M ≅ N) (eM' : M' ≅ N') : LocIsoOnBase g N N' := by
  intro s
  obtain ⟨U, hs, ⟨e⟩⟩ := h s
  exact ⟨U, hs, ⟨((Scheme.Modules.pullback (g ⁻¹ᵁ U).ι).mapIso eM).symm ≪≫ e ≪≫
    (Scheme.Modules.pullback (g ⁻¹ᵁ U).ι).mapIso eM'⟩⟩

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {d m : ℕ} {R : Type} [CommRing R] (X : PolarisedAbelianScheme 2 d m R)
  (star : ↥Λ → ↥Λ)

def POL {S : Type} [CommRing S] {A' : Scheme.{0}} (f' : A' ⟶ Spec (CommRingCat.of S)) (L' : RelativeGroupLaw S f')
    (act : ↥Λ → (A' ⟶ A')) (act_over : ∀ x : ↥Λ, act x ≫ f' = f') (g : A' ⟶ X.A) : Prop :=
  ∃ polE : A'.Modules, CerednikDrinfeld.QM.IsCanonicalPolData f' L' act act_over star polE ∧
    LocIsoOnBase f' ((Scheme.Modules.pullback g).obj X.pol) (polE ⊗ polE ⊗ polE)

variable {X}

theorem pol_of_isGroupPullback {S S' : Type} [CommRing S] [CommRing S'] (ψ : S →+* S')
    {A₁ A₂ : Scheme.{0}} {f₁ : A₁ ⟶ Spec (CommRingCat.of S)} {f₂ : A₂ ⟶ Spec (CommRingCat.of S')}
    (L₁ : RelativeGroupLaw S f₁) (L₂ : RelativeGroupLaw S' f₂) (h : A₂ ⟶ A₁) (hh : IsGroupPullback ψ L₁ L₂ h)
    (act₁ : ↥Λ → (A₁ ⟶ A₁)) (act_over₁ : ∀ x : ↥Λ, act₁ x ≫ f₁ = f₁)
    (act₂ : ↥Λ → (A₂ ⟶ A₂)) (act_over₂ : ∀ x : ↥Λ, act₂ x ≫ f₂ = f₂)
    (hact : ∀ x : ↥Λ, act₂ x ≫ h = h ≫ act₁ x)
    (g₁ : A₁ ⟶ X.A) (g₂ : A₂ ⟶ X.A) (hg : h ≫ g₁ = g₂)
    (hP : POL X star f₁ L₁ act₁ act_over₁ g₁) : POL X star f₂ L₂ act₂ act_over₂ g₂ := by
  obtain ⟨hP0, hm⟩ := hh
  obtain ⟨polE, hcan, hloc⟩ := hP
  refine ⟨(Scheme.Modules.pullback h).obj polE, ?_, ?_⟩
  · exact CerednikDrinfeld.QM.IsCanonicalPolData.pullback_of_isPullback ψ L₁ L₂ act₁ act_over₁ act₂ act_over₂ star h hP0
      (fun t' x y => hm t' x y) hact polE hcan
  · have T := AlgebraicGeometry.Polarisation.LocIsoOnBase.pullback_of_isPullback ψ hP0 hloc
    refine locIsoOnBase_congr f₂ T ?_ ?_
    · exact (Scheme.Modules.pullbackComp h g₁).app X.pol ≪≫ (Scheme.Modules.pullbackCongr hg).app X.pol
    · exact Scheme.Modules.pullbackTensorObjIso h polE (polE ⊗ polE) ≪≫
        whiskerLeftIso _ (Scheme.Modules.pullbackTensorObjIso h polE polE)

theorem Spec_map_ofHom_id' (S : Type) [CommRing S] : Spec.map (CommRingCat.ofHom (RingHom.id S)) = 𝟙 _ := by
  rw [show CommRingCat.ofHom (RingHom.id S) = 𝟙 (CommRingCat.of S) from rfl, Spec.map_id]

theorem mul_val_congr' {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (e : t₁ = t₂) (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f)
    (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) : (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst e
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

theorem isGroupPullback_inv {S : Type} [CommRing S] {A₁ A₂ : Scheme.{0}} {f₁ : A₁ ⟶ Spec (CommRingCat.of S)}
    {f₂ : A₂ ⟶ Spec (CommRingCat.of S)} (L₁ : RelativeGroupLaw S f₁) (L₂ : RelativeGroupLaw S f₂) (e : A₂ ≅ A₁)
    (hh : IsGroupPullback (RingHom.id S) L₁ L₂ e.hom) : IsGroupPullback (RingHom.id S) L₂ L₁ e.inv := by
  obtain ⟨hP, hm⟩ := hh
  have hS : Spec.map (CommRingCat.ofHom (RingHom.id S)) = 𝟙 _ := Spec_map_ofHom_id' S
  have hw : e.hom ≫ f₁ = f₂ := by have := hP.w; rw [hS, Category.comp_id] at this; exact this
  have hw' : e.inv ≫ f₂ = f₁ := by rw [← hw, e.inv_hom_id_assoc]
  haveI : IsIso (Spec.map (CommRingCat.ofHom (RingHom.id S))) := by rw [hS]; infer_instance
  have hP' : IsPullback e.inv f₁ f₂ (Spec.map (CommRingCat.ofHom (RingHom.id S))) :=
    IsPullback.of_horiz_isIso ⟨by rw [hw', hS, Category.comp_id]⟩
  refine ⟨hP', fun t P Q => ?_⟩

  have hbase : (t ≫ Spec.map (CommRingCat.ofHom (RingHom.id S))) ≫ Spec.map (CommRingCat.ofHom (RingHom.id S)) = t := by
    rw [hS, Category.comp_id, Category.comp_id]
  let P' : SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom (RingHom.id S))) f₂ :=
    ⟨P.1 ≫ e.inv, by rw [Category.assoc, hP'.w, ← Category.assoc, P.2]⟩
  let Q' : SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom (RingHom.id S))) f₂ :=
    ⟨Q.1 ≫ e.inv, by rw [Category.assoc, hP'.w, ← Category.assoc, Q.2]⟩
  have k := hm _ P' Q'
  have k2 : (L₁.mul ((t ≫ Spec.map (CommRingCat.ofHom (RingHom.id S))) ≫ Spec.map (CommRingCat.ofHom (RingHom.id S)))
      ⟨P'.1 ≫ e.hom, by rw [Category.assoc, hP.w, ← Category.assoc, P'.2]⟩
      ⟨Q'.1 ≫ e.hom, by rw [Category.assoc, hP.w, ← Category.assoc, Q'.2]⟩).1 = (L₁.mul t P Q).1 :=
    mul_val_congr' L₁ hbase _ _ _ _ (by simp [P']) (by simp [Q'])
  rw [k2] at k

  show (L₁.mul t P Q).1 ≫ e.inv = (L₂.mul _ P' Q').1
  rw [← k, Category.assoc, e.hom_inv_id, Category.comp_id]

section LocIso

variable {S : Type} [CommRing S] {Y : Scheme.{0}} (q : Y ⟶ Spec (CommRingCat.of S))

def restrictIso {W V : Y.Opens} (hle : V ≤ W) {M M' : Y.Modules}
    (e : (Scheme.Modules.pullback W.ι).obj M ≅ (Scheme.Modules.pullback W.ι).obj M') :
    (Scheme.Modules.pullback V.ι).obj M ≅ (Scheme.Modules.pullback V.ι).obj M' :=
  (Scheme.Modules.pullbackCongr (Y.homOfLE_ι hle).symm).app M ≪≫
    ((Scheme.Modules.pullbackComp (Y.homOfLE hle) W.ι).app M).symm ≪≫
    (Scheme.Modules.pullback (Y.homOfLE hle)).mapIso e ≪≫
    (Scheme.Modules.pullbackComp (Y.homOfLE hle) W.ι).app M' ≪≫
    (Scheme.Modules.pullbackCongr (Y.homOfLE_ι hle)).app M'

theorem preimage_mono {U V : (Spec (CommRingCat.of S)).Opens} (h : U ≤ V) : q ⁻¹ᵁ U ≤ q ⁻¹ᵁ V :=
  fun _ hx => h hx

theorem locIsoOnBase_trans {M M' M'' : Y.Modules} (h₁ : LocIsoOnBase q M M') (h₂ : LocIsoOnBase q M' M'') :
    LocIsoOnBase q M M'' := by
  intro s
  obtain ⟨U₁, hs₁, ⟨e₁⟩⟩ := h₁ s
  obtain ⟨U₂, hs₂, ⟨e₂⟩⟩ := h₂ s
  refine ⟨U₁ ⊓ U₂, ⟨hs₁, hs₂⟩, ⟨restrictIso (preimage_mono q inf_le_left) e₁ ≪≫ restrictIso (preimage_mono q inf_le_right) e₂⟩⟩

theorem locIsoOnBase_symm {M M' : Y.Modules} (h : LocIsoOnBase q M M') : LocIsoOnBase q M' M := by
  intro s
  obtain ⟨U, hs, ⟨e⟩⟩ := h s
  exact ⟨U, hs, ⟨e.symm⟩⟩

theorem locIsoOnBase_tensor {M M' N N' : Y.Modules} (h : LocIsoOnBase q M N) (h' : LocIsoOnBase q M' N') :
    LocIsoOnBase q (M ⊗ M') (N ⊗ N') := by
  intro s
  obtain ⟨U₁, hs₁, ⟨e₁⟩⟩ := h s
  obtain ⟨U₂, hs₂, ⟨e₂⟩⟩ := h' s
  refine ⟨U₁ ⊓ U₂, ⟨hs₁, hs₂⟩, ⟨?_⟩⟩
  exact Scheme.Modules.pullbackTensorObjIso _ M M' ≪≫
    (restrictIso (preimage_mono q inf_le_left) e₁ ⊗ᵢ restrictIso (preimage_mono q inf_le_right) e₂) ≪≫
    (Scheme.Modules.pullbackTensorObjIso _ N N').symm

end LocIso
