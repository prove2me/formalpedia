-- Source module: Solutions.R6CxNetSim
/-!
# Chunk programs with phase frames (the physical simulation, any wire type)

A **chunk** at label `V` first moves some wires to `V` (each move `U → V` is one merged frame
change `edgeStepsM`, needing `EdgeOK V U`), then applies elementary scalar gates
`z_dst += c · z_src` (pointwise on the addresses) whose two wires are at `V`.

* `Inv lab Λ F`: the physical state `F` is the logical state `Λ` in the frames `Φ_{q_{lab w}}`.
* `chunk_sim` / `prog_sim`: a valid chunk (program) maps `Inv lab Λ F` to
  `Inv lab' (runOps ops Λ) (den · F)`.
* `prog_widths`: the child widths are the residual dimensions `Fd V U` of the moves.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift NetComplexP8 NetComplexLabels

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {R : Type} [Fintype R] [DecidableEq R]

lemma wireOp_mulVec (w0 : R) (A : Op (Fin m × κ)) (F : R × Addr m κ → ℂ) (w : R) :
    (fun x => (wireOp w0 A *ᵥ F) (w, x)) = if w = w0 then A *ᵥ fun x => F (w, x) else fun x => F (w, x) := by
  funext x
  rw [wireOp, blockOp_mulVec]
  split_ifs with h
  · rfl
  · simp

lemma PhiK_comp (U V : Lab m) (g : Addr m κ → ℂ) :
    PhiK (qL V - qL U) *ᵥ (PhiK (qL U) *ᵥ g) = (PhiK (qL V) : Op (Fin m × κ)) *ᵥ g := by
  rw [Matrix.mulVec_mulVec, ← PhiK_add, sub_add_cancel]

/-- One move. -/
theorem move_sim (w0 : R) (U V : Lab m) (hE : EdgeOK V U) (lab : R → Lab m) (hl : lab w0 = U)
    (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ) (hI : Inv lab Λ F) :
    Inv (Function.update lab w0 V) Λ (denListH (chEx (κ := κ)) (edgeStepsM w0 V U) *ᵥ F) := by
  intro w
  rw [edgeStepsM_den w0 hE, wireOp_mulVec]
  by_cases h : w = w0
  · subst h
    rw [if_pos rfl, hI w, Function.update_self, ← hl, PhiK_comp]
  · rw [if_neg h, hI w, Function.update_of_ne h]

lemma denListH_flatMap' {ι : Type*} (ch : Finset (Fin m) → Op (Fin m × κ)) (F : ι → List (HStep R m))
    (i : ι) (l : List ι) :
    denListH ch ((i :: l).flatMap F) = denListH ch (l.flatMap F) * denListH ch (F i) := by
  rw [List.flatMap_cons, denListH_append]

theorem mv_sim (V : Lab m) :
    ∀ (mv : List (R × Lab m)) (lab : R → Lab m), MvValid V mv lab →
      ∀ (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ), Inv lab Λ F →
        Inv (mvLab V mv lab) Λ (denListH (chEx (κ := κ)) (mvSteps V mv) *ᵥ F) := by
  intro mv
  induction mv with
  | nil => intro lab _ Λ F hI; simpa [mvSteps, mvLab] using hI
  | cons p mv ih =>
    intro lab hv Λ F hI
    obtain ⟨h1, h2, h3⟩ := hv
    rw [mvSteps, denListH_flatMap', ← mvSteps, ← Matrix.mulVec_mulVec]
    exact ih _ h3 Λ _ (move_sim p.1 p.2 V h2 lab h1 Λ F hI)

lemma gate_mulVecH (G : Matrix R R ℂ) (F : R × Addr m κ → ℂ) (p : R × Addr m κ) :
    ((HStep.gate G : HStep R m).den (chEx (κ := κ)) *ᵥ F) p = ∑ w', G p.1 w' * F (w', p.2) := by
  simp only [mulVec, dotProduct, HStep.den, RStep.den]
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun w' _ => ?_
  rw [Finset.sum_eq_single p.2]
  · simp
  · intro b _ hb; simp [Ne.symm hb]
  · simp

lemma opMat_row (o : GOp R) (g : R → ℂ) (w : R) :
    ∑ b, o.mat w b * g b = g w + (if w = o.dst then o.c * g o.src else 0) := by
  simp only [GOp.mat, Matrix.add_apply, Matrix.one_apply, add_mul, Finset.sum_add_distrib,
    ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  congr 1
  by_cases h : w = o.dst
  · subst h
    rw [if_pos rfl, Finset.sum_eq_single o.src]
    · simp [Matrix.single_apply]
    · intro b _ hb; simp [Matrix.single_apply, Ne.symm hb]
    · simp
  · rw [if_neg h, Finset.sum_eq_zero]
    intro b _
    simp [Matrix.single_apply, Ne.symm h]

lemma opMat_mulVec (o : GOp R) (F : R × Addr m κ → ℂ) (w : R) :
    (fun x => ((HStep.gate o.mat : HStep R m).den (chEx (κ := κ)) *ᵥ F) (w, x)) =
      if w = o.dst then (fun x => F (w, x) + o.c * F (o.src, x)) else fun x => F (w, x) := by
  funext x
  rw [gate_mulVecH, opMat_row o (fun b => F (b, x)) w]
  split_ifs <;> simp

/-- One logical gate preserves the invariant when both wires are at the same label. -/
theorem op_sim (o : GOp R) (lab : R → Lab m) (hd : lab o.dst = lab o.src)
    (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ) (hI : Inv lab Λ F) :
    Inv lab (runOp Λ o) ((HStep.gate o.mat : HStep R m).den (chEx (κ := κ)) *ᵥ F) := by
  intro w
  rw [opMat_mulVec]
  by_cases h : w = o.dst
  · subst h
    rw [if_pos rfl, runOp, Function.update_self, Matrix.mulVec_add, Matrix.mulVec_smul]
    have e1 := congrFun (hI o.dst)
    have e2 := congrFun (hI o.src)
    funext x
    have e1x : F (o.dst, x) = (PhiK (qL (lab o.dst)) *ᵥ Λ o.dst) x := e1 x
    have e2x : F (o.src, x) = (PhiK (qL (lab o.src)) *ᵥ Λ o.src) x := e2 x
    rw [e1x, e2x, hd]
    rfl
  · rw [if_neg h, runOp, Function.update_of_ne h, hI w]

theorem ops_sim (V : Lab m) :
    ∀ (ops : List (GOp R)) (lab : R → Lab m), (∀ o ∈ ops, lab o.dst = V ∧ lab o.src = V) →
      ∀ (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ), Inv lab Λ F →
        Inv lab (runOps ops Λ) (denListH (chEx (κ := κ)) (ops.map fun o => HStep.gate o.mat) *ᵥ F) := by
  intro ops
  induction ops with
  | nil => intro lab _ Λ F hI; simpa [runOps] using hI
  | cons o ops ih =>
    intro lab hops Λ F hI
    rw [List.map_cons, denListH_cons, ← Matrix.mulVec_mulVec]
    have ho := hops o List.mem_cons_self
    have := op_sim o lab (ho.1.trans ho.2.symm) Λ F hI
    have h2 := ih lab (fun o' h' => hops o' (List.mem_cons_of_mem _ h')) _ _ this
    simpa [runOps] using h2

/-- **One chunk.** -/
theorem chunk_sim (C : GChunk R m) (lab : R → Lab m) (hC : C.Valid lab)
    (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ) (hI : Inv lab Λ F) :
    Inv (mvLab C.V C.mv lab) (runOps C.ops Λ) (denListH (chEx (κ := κ)) C.steps *ᵥ F) := by
  rw [GChunk.steps, denListH_append, ← Matrix.mulVec_mulVec]
  exact ops_sim C.V C.ops _ hC.2 Λ _ (mv_sim C.V C.mv lab hC.1 Λ F hI)

/-! ## Programs -/

lemma runOps_append {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt] (a b : List (GOp R)) (Λ : R → Vt) :
    runOps (a ++ b) Λ = runOps b (runOps a Λ) := by
  simp [runOps, List.foldl_append]

/-- **Programs.** -/
theorem prog_sim :
    ∀ (cs : List (GChunk R m)) (lab : R → Lab m), ProgValid cs lab →
      ∀ (Λ : R → Addr m κ → ℂ) (F : R × Addr m κ → ℂ), Inv lab Λ F →
        Inv (progLab cs lab) (runOps (progOps cs) Λ) (denListH (chEx (κ := κ)) (progSteps cs) *ᵥ F) := by
  intro cs
  induction cs with
  | nil => intro lab _ Λ F hI; simpa [progLab, progOps, progSteps, runOps] using hI
  | cons C cs ih =>
    intro lab hv Λ F hI
    rw [progSteps, denListH_flatMap', ← progSteps, ← Matrix.mulVec_mulVec, progOps, List.flatMap_cons,
      runOps_append, ← progOps]
    exact ih _ hv.2 _ _ (chunk_sim C lab hv.1 Λ F hI)

lemma progValid_append :
    ∀ (a b : List (GChunk R m)) (lab : R → Lab m),
      ProgValid (a ++ b) lab ↔ ProgValid a lab ∧ ProgValid b (progLab a lab) := by
  intro a
  induction a with
  | nil => intro b lab; simp [ProgValid, progLab]
  | cons C a ih =>
    intro b lab
    simp only [List.cons_append, ProgValid, progLab, ih]
    tauto

lemma progLab_append (a b : List (GChunk R m)) (lab : R → Lab m) :
    progLab (a ++ b) lab = progLab b (progLab a lab) := by
  induction a generalizing lab with
  | nil => rfl
  | cons C a ih => simp [progLab, ih]

lemma progOps_append (a b : List (GChunk R m)) : progOps (a ++ b) = progOps a ++ progOps b := by
  simp [progOps]

/-! ## Child widths -/

end IntMul.Kappa.R6.Cx

