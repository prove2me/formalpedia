theorem checked_blocks (p : Nat -> Bool) (width count : Nat) (hw : 0 < width)
    (h : forall b : Fin count, (List.range width).all (fun k => p (b.val * width + k)) = true) :
    forall q, q < count * width -> p q = true := by
  intro q hq
  have hd : q / width < count := (Nat.div_lt_iff_lt_mul hw).mpr hq
  have hm : q % width < width := Nat.mod_lt _ hw
  have hb := List.all_eq_true.mp (h (Fin.mk (q / width) hd)) (q % width) (List.mem_range.mpr hm)
  have he : q / width * width + q % width = q := by simpa only [Nat.mul_comm] using Nat.div_add_mod q width
  simpa only [he] using hb
end HardyCapset20261020.Cert.UploadArithmetic

