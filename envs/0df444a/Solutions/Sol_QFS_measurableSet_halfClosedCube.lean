variable {d : ℕ}

lemma solution (h : ℝ) (u : EuclideanSpace ℝ (Fin d)) :
    MeasurableSet (QFS.halfClosedCube h u) := by
  rw [QFS.halfClosedCube_eq_preimage]
  exact (PiLp.volume_preserving_ofLp (Fin d)).measurable
    (MeasurableSet.univ_pi (fun _ => measurableSet_Ico))
