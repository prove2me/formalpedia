  ∀ (ι : ℂ ≃+* ℂ_[2]) (W : WeierstrassCurve ℂ_[2]), Unif 2 (cmL a₀ b₀ dK ha hdK lam hlam) ι W → IntCurve W → ‖W.a₁‖ = 1 →
  ∀ (κx : Type) [Fintype κx] (r : κx → ℂ_[2]) (t : κx → n → ℂ) (N : ℕ), (∀ k, ‖r k‖ ≤ 1) → 0 < N → ¬ 2 ∣ N →
