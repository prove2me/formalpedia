    obtain ⟨hz₂', hxa, hslope_a⟩ := hatt₂ s
    obtain ⟨hzb, hxb, hslope_b⟩ := hatt₁ s
    obtain ⟨-, hprod⟩ :=
      AlgebraicCurve.Annulus.sum_eq_ord_add_ord_and_prod_valuation_evalAt_zpow_eq_of_regularProlongation
        (An s) (hmod0 s) Rpd.R₂ s.1.2 hz₂' hxa hslope_a Rpd.R₁ s.1.1 hzb hxb hslope_b (hwide s)
        (c₂ • f₀) hcf0 hc₂mem hc₂res c₂ hc₂0 hhb hresb' (nfold n (Es s)) hDhsupp hDh
    rw [prod_nfold, hres_eq, hk s] at hprod
