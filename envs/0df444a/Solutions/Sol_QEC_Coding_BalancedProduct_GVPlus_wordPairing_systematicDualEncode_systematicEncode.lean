namespace QEC.Coding.BalancedProduct.GVPlus
theorem _root_.solution {k r : Nat}
    (A : Matrix (Fin k) (Fin r) (ZMod 2))
    (y : Fin r → ZMod 2) (m : Fin k → ZMod 2) :
    wordPairing (systematicDualEncode A y) (systematicEncode A m) = 0 := by
  classical
  simp only [wordPairing_apply, dotProduct, Fintype.sum_sum_type,
    systematicDualEncode, systematicEncode]
  have hleft : (∑ i, -Matrix.mulVec A y i * m i) =
      -(∑ i, m i * Matrix.mulVec A y i) := by
    calc
      _ = ∑ i, -(m i * Matrix.mulVec A y i) := by
        apply Finset.sum_congr rfl
        intro i _
        ring
      _ = _ := by
        simp
  rw [hleft]
  have hcontract :
      (∑ i, m i * Matrix.mulVec A y i) =
        ∑ j, y j * Matrix.vecMul m A j := by
    calc
      _ = dotProduct m (Matrix.mulVec A y) := rfl
      _ = dotProduct (Matrix.vecMul m A) y :=
        Matrix.dotProduct_mulVec m A y
      _ = _ := by simp [dotProduct, mul_comm]
  rw [hcontract]
  exact neg_add_cancel _
end QEC.Coding.BalancedProduct.GVPlus
