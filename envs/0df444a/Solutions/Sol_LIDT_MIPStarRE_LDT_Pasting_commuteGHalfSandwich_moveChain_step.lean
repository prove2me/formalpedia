variable {ι : Type*} [Fintype ι] [DecidableEq ι]


/-! ## Move chain: recursive family, step lemma, and aggregate

The recursive `moveChainFamily` indexed over `Fin (r+1)`, with the step lemma
`moveChain_step` and the aggregate lemma `move_chain` that composes the
`r` self-consistency edges.
-/

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (ψbi : _root_.LIDT.MIPStarRE.LDT.QuantumState (ι × ι))
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    (zeta : _root_.LIDT.MIPStarRE.LDT.Error)
    (hsc : _root_.LIDT.MIPStarRE.LDT.SDDRel ψbi
      (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion params))
      (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyLeftFamily params family)
      (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyRightFamily params family)
      (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta)) :
    ∀ r (i : Fin r),
      _root_.LIDT.MIPStarRE.LDT.SDDOpRel ψbi
        (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Pasting.MoveQ params r))
        ((_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily params family r) i.castSucc)
        ((_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily params family r) i.succ)
        (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta)
  | 0, i => Fin.elim0 i
  | r + 1, i => by
      by_cases hi : i.1 < r
      · have hsmall :=
          solution params ψbi family zeta hsc r ⟨i.1, hi⟩
        let j : Fin r := ⟨i.1, hi⟩
        have hsrc : i.1 < r + 1 := Nat.lt_trans hi (Nat.lt_succ_self r)
        have hj_cast : j.castSucc = i := by
          ext
          rfl
        have hj_succ :
            j.succ = (⟨i.1 + 1, Nat.succ_lt_succ hi⟩ : Fin (r + 1)) := by
          ext
          rfl
        simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily, hi,
          hsrc, Nat.succ_lt_succ hi, hj_cast, hj_succ] using
          _root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainLift params ψbi family r
            ((_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily params family r) j.castSucc)
            ((_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily params family r) j.succ)
            (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta)
            hsmall
      · have hilast : i.1 = r := by omega
        have hi_last : i = Fin.last r := Fin.ext hilast
        cases hi_last
        have hlast := _root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainLift_moveFamily_last params ψbi family zeta
            r hsc
        have hlastIndex : (⟨r, Nat.lt_succ_self r⟩ : Fin (r + 1)) = Fin.last r := by
          ext
          rfl
        simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily, hlastIndex] using
          (_root_.LIDT.MIPStarRE.LDT.CommutativityPoints.sddOpRel_congr_outcome ψbi
            (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion params × _root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion params ×
                _root_.LIDT.MIPStarRE.LDT.PointTuple params (r + 1)))
            (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainLiftFamily params family r
              (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveFamily params family r))
            (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveFamily params family (r + 1))
            (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainLiftFamily params family r
              (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily params family r (Fin.last r)))
            (_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveFamily params family (r + 1))
            (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta)
            (fun q ogs => by
              simp [_root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainLiftFamily,
                _root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich_moveChainFamily_last params family r
                  (q.2.1, q.2.2 0, _root_.LIDT.MIPStarRE.LDT.Pasting.pointTupleTail q.2.2)
                  (ogs.2.1, ogs.2.2 0, _root_.LIDT.MIPStarRE.LDT.Pasting.gHatTupleOutcomeTail ogs.2.2)])
            (fun _ _ => rfl)
            hlast)
