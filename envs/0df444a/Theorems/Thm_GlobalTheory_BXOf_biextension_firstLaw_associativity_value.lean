theorem GlobalTheory.BXOf.biextension_firstLaw_associativity_value (hJ : Good P z J) (x x' x'' y : T ⟶ G) :
    val β.law1 (lift (x * x') (lift x'' y)).left z J * val β.law1 (lift x (lift x' y)).left z J =
      val β.law1 (lift x (lift (x' * x'') y)).left z J * val β.law1 (lift x' (lift x'' y)).left z J := by sorry
