-- Source module: Solutions.J6SegVal5
/-!
# B-line value bounds 5: `ValNeed6` from the chunk-table bound and the `J`-kernel facts

* `ValCond6 ap`: linear lower bounds on the plan constants.
* `JNeed6 P` (B4, per axis of the round-six regime): the `J` kernel's output bound on any row with
  `Bnd Bv` parts, `JPre` of any such row for every `Xb ≥ max Bv Q + size(2w+1) + 4`,
  `Bc ≥ size(G + 2w + 3s² + 2ws + 10s)`, `k ≥ 2Xb + 2Q + Bc + 6`, and `w ≤ s`.
* **`valNeed6_of`**: `ChunkTabBnd6 P → JNeed6 P → ∀ ap, ValCond6 ap → ValNeed6 P ap`.

Exponents (with `Q = segPF p d s`, `a = R + 2`, `ℓ = log₂ λ`; `7a ≤ Q + 13`, `ℓ < Q`):
`S ≤ 2^(Q+1)`, `Y, Jg ≤ 2^eY` with `eY = Q + 1 + 7a + 2ℓ ≤ 4Q + 12`,
`W, Wp ≤ 2^(eY + 1 + 2Q + 4) ≤ 2^(6Q+17)`, `Y₂ ≤ 2^(9Q+28)`;
`J` output on a `JPre` row `≤ 2^(Xb + 2Q + 4)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

/-! ## Arithmetic helpers -/

theorem out_le {w Bv Q : ℕ} (hBv : Q ≤ Bv) (hw : Nat.size (2 * w + 1) ≤ Q) :
    (11 * (2 * w + 1) * (2 * w + 1) * 2 ^ (max Bv Q) : ℤ) ≤ 2 ^ (Bv + 2 * Q + 4) := by
  rw [max_eq_left hBv]
  have h1 : 2 * w + 1 < 2 ^ Q :=
    (Nat.lt_size_self _).trans_le (Nat.pow_le_pow_right (by norm_num) hw)
  have h1' : ((2 * w + 1 : ℕ) : ℤ) ≤ 2 ^ Q := by exact_mod_cast h1.le
  push_cast at h1'
  have e : (2 : ℤ) ^ (Bv + 2 * Q + 4) = 16 * 2 ^ Q * 2 ^ Q * 2 ^ Bv := by ring
  rw [e]
  have h0 : (0 : ℤ) ≤ 2 * w + 1 := by positivity
  have hB : (0 : ℤ) < 2 ^ Bv := by positivity
  have h2 : (11 : ℤ) * (2 * w + 1) * (2 * w + 1) ≤ 16 * 2 ^ Q * 2 ^ Q := by nlinarith
  exact mul_le_mul_of_nonneg_right h2 hB.le

theorem bnd_parts {e : ℕ} {x : List GI} (h : ∀ z ∈ x, PB (2 ^ e) z) :
    NLogN.Bnd (e + 1) (x.map Prod.fst) ∧ NLogN.Bnd (e + 1) (x.map Prod.snd) := by
  constructor
  · intro a ha
    obtain ⟨z, hz, rfl⟩ := List.mem_map.1 ha
    exact zsz_of_abs (h z hz).1
  · intro a ha
    obtain ⟨z, hz, rfl⟩ := List.mem_map.1 ha
    exact zsz_of_abs (h z hz).2

theorem PB_pow_mono {e e' : ℕ} (h : e ≤ e') {X : List GI} (hX : ∀ z ∈ X, PB (2 ^ e) z) :
    ∀ z ∈ X, PB (2 ^ e') z :=
  fun z hz => PB_mono (pow_le_pow_right₀ (by norm_num) h) (hX z hz)

theorem lineAt_PB {B : ℤ} (hB : 0 ≤ B) {G post : ℕ} {X : List GI} (hX : ∀ z ∈ X, PB B z)
    (b c : ℕ) : ∀ z ∈ lineAt G post X b c, PB B z := by
  intro z hz
  unfold lineAt at hz
  obtain ⟨i, -, rfl⟩ := List.mem_map.1 hz
  exact getD_pr (PB_default hB) hX _

theorem length_lineAt' {α : Type*} [Inhabited α] (G post : ℕ) (X : List α) (b c : ℕ) :
    (lineAt G post X b c).length = G := by simp [lineAt]

end J6Seg.Val
end

