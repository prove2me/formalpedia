theorem solution
    {N d : ℕ} (k₀ : Type) [Field k₀] [IsAlgClosed k₀] (hN : (N : k₀) ≠ 0) (hdN : Nat.Coprime d N)
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsOrder Λ)
    (A₀ : FakeEllipticCurve Λ N k₀)
    (φ ψ : A₀.A ⟶ A₀.A) (hφ : φ ≫ A₀.f = A₀.f) (hψ : ψ ≫ A₀.f = A₀.f)
    (hpair : FakeEllipticCurve.IsIsogenyPair d A₀ A₀ φ ψ)
    (hlev : FakeEllipticCurve.PreservesLevel A₀ A₀ φ hφ) :
    FakeEllipticCurve.PreservesLevel A₀ A₀ ψ hψ := by
  classical
  obtain ⟨hφ', hψ', hφmul, hψmul, -, -, hdeg⟩ := hpair
  have hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := intCast_mem_of_one_mem hΛ.one_mem
  have hdΛ : ((d : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    have h := hΛℤ d
    rwa [Int.cast_natCast] at h
  obtain ⟨hφψ, hψφ⟩ := hdeg hdΛ

  have hψφ_pt : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (P : SchemeHomOver t A₀.f),
      mapPt ψ hψ (mapPt φ hφ P) = nsmulPt A₀.L t d P :=
    fun t P => mapPt_mapPt_eq_nsmulPt_of_comp_eq_act A₀ hΛℤ φ hφ ψ hψ d hdΛ hφψ t P
  have hφψ_pt : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k₀)) (Q : SchemeHomOver t A₀.f),
      mapPt φ hφ (mapPt ψ hψ Q) = nsmulPt A₀.L t d Q :=
    fun t Q => mapPt_mapPt_eq_nsmulPt_of_comp_eq_act A₀ hΛℤ ψ hψ φ hφ d hdΛ hψφ t Q
  intro T₁ t₁ Q₁ hQ₁
  by_cases hN1 : N = 1
  ·
    subst hN1
    letI := A₀.L.pointGroup t₁
    have hQ1 : Q₁ = A₀.L.one t₁ := by
      have h := A₀.lev_torsion t₁ Q₁ hQ₁
      rw [nsmulPt_eq_pow, pow_one] at h
      exact h
    rw [hQ1, mapPt_one A₀ ψ hψ hψmul]
    exact A₀.lev_one t₁

  have hd0 : 0 < d := Nat.pos_of_ne_zero (by rintro rfl; exact hN1 ((Nat.coprime_zero_left _).1 hdN))

  obtain ⟨hfinφ, -, -, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.isFinite_flat_surjective_of_mapPt_mapPt_eq_nsmulPt
    A₀ A₀ φ hφ hφmul ψ hψ d hd0 hψφ_pt hφψ_pt
  haveI := hfinφ
  haveI : IsClosedImmersion A₀.lev := A₀.lev_closed

  let j : A₀.C ⟶ A₀.A := A₀.lev ≫ φ
  haveI : IsFinite j := inferInstance
  haveI : Mono j := by
    refine ⟨fun {Z} g₁ g₂ hg => ?_⟩
    rw [← cancel_mono A₀.lev]
    let t : Z ⟶ Spec (CommRingCat.of k₀) := (g₁ ≫ A₀.lev) ≫ A₀.f
    have hg' : (g₁ ≫ A₀.lev) ≫ φ = (g₂ ≫ A₀.lev) ≫ φ := by simpa only [Category.assoc] using hg
    have hg₂ : (g₂ ≫ A₀.lev) ≫ A₀.f = t := by
      show (g₂ ≫ A₀.lev) ≫ A₀.f = (g₁ ≫ A₀.lev) ≫ A₀.f
      rw [← hφ, ← Category.assoc, ← hg', Category.assoc]
    let P : SchemeHomOver t A₀.f := ⟨g₁ ≫ A₀.lev, rfl⟩
    let Q : SchemeHomOver t A₀.f := ⟨g₂ ≫ A₀.lev, hg₂⟩
    have hPC : FactorsThrough A₀.lev P := ⟨g₁, rfl⟩
    have hQC : FactorsThrough A₀.lev Q := ⟨g₂, rfl⟩
    letI := A₀.L.pointGroup t
    let F : SchemeHomOver t A₀.f →* SchemeHomOver t A₀.f :=
      { toFun := mapPt φ hφ, map_one' := mapPt_one A₀ φ hφ hφmul t, map_mul' := fun X Y => hφmul t X Y }
    have hPQ : F P = F Q := Subtype.ext hg'
    have h1 : F (P * Q⁻¹) = 1 := by rw [map_mul, map_inv, hPQ, mul_inv_cancel]
    have hCPQ : FactorsThrough A₀.lev (P * Q⁻¹) := by
      have hQinv : FactorsThrough A₀.lev Q⁻¹ := (A₀.lev_sub t Q Q hQC hQC).2
      exact (A₀.lev_sub t P Q⁻¹ hPC hQinv).1

    have hXd : (P * Q⁻¹) ^ d = 1 := by
      rw [← nsmulPt_eq_pow, ← hψφ_pt t (P * Q⁻¹)]
      have h1' : mapPt φ hφ (P * Q⁻¹) = A₀.L.one t := h1
      rw [h1', mapPt_one A₀ ψ hψ hψmul]
      rfl
