/-- Locating the `k`-th instruction of a chunk inside a bigger program. -/
theorem program_getElem? (pre code post : Program) (k : ℕ) (hk : k < code.length) :
    (pre ++ code ++ post)[pre.length + k]? = code[k]? := by
  rw [List.append_assoc, List.getElem?_append_right (by omega : pre.length ≤ pre.length + k)]
  rw [show pre.length + k - pre.length = k from by omega]
  exact List.getElem?_append_left hk

/-- A chunk spliced in at address `pre.length` is `At` that address. -/
theorem At.of_program_append {P : Program} {pre code post : Program} {a : ℕ}
    (hP : P = pre ++ code ++ post) (hbase : pre.length = a) : At P a code := by
  intro r hr
  rw [hP]
  rw [show a + r = pre.length + r from by omega]
  exact program_getElem? pre code post r hr

end ProgramAt

