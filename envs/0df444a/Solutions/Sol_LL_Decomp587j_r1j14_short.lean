lemma r1j14_tail_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} (hφ : ((368 * StepPhi : ℕ) : ℝ) / D_out ≤ φ) :
    buchstabIntegral ω 1 (fun j => (r1j14_lo j : ℝ)) (fun j => (r1j14_hi j : ℝ)) φ ≤
      ((9167311 / 1000000000) : ℝ) := by
  have hDout_pos : (0 : ℝ) < D_out := by unfold D_out; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hφ2 : 2 ≤ φ := by
    have : (2 : ℝ) ≤ ((368 * StepPhi : ℕ) : ℝ) / D_out := by unfold StepPhi D_out; norm_num
    linarith
  rw [buchstabIntegral_r1j14_eq_iterated hω hφ2]
  have hint_all := outer_integrableOn hω hφ2
  have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_out := by unfold A0_num D_out; norm_num
  have htail_gap : (B0_num : ℝ) / D_out + ((334 * 1656 : ℕ) : ℝ) / D_in ≤ ((368 * StepPhi : ℕ) : ℝ) / D_out := by
    unfold B0_num D_out D_in StepPhi; norm_num
  have hpt : ∀ x0 ∈ Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out),
      (1 / x0) * F_fn ω (φ - x0) ≤ ((F_tail_val : ℝ) / S_scale) * (1 / x0) := by
    intro x0 hx0
