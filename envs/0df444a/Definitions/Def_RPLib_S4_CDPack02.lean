-- ===== S4.Def_RP_PerfectCx_Free =====
section

/-!
# S4-PD (5), E2(a) algebra: a freeness criterion over `O/λⁿ`

`Λ` is a local ring whose maximal ideal is generated by `ϖ`, with `ϖⁿ = 0` (e.g. `ZMod (lⁿ)` with `ϖ = l`, or
`O/λⁿ` with a uniformiser `ϖ`; review END-2, decision R19).

* `exists_eq_mul_of_not_isUnit`, `isUnit_sub_mul`: non-units are multiples of `ϖ`, a unit minus a multiple of `ϖ`
  is a unit;
* `free_of_torsion`: a finite `Λ`-module `E` in which `ϖᵐ • z = 0` (`m < n`) forces `z ∈ ϖ • E` is free (a minimal
  generating family is a basis: a relation with a unit coefficient would shorten it, and the hypothesis pushes
  every relation one power of `ϖ` deeper).
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace PerfectCx

open IsLocalRing

variable {Λ : Type} [CommRing Λ] [IsLocalRing Λ] {ϖ : Λ} (hϖ : maximalIdeal Λ = Ideal.span {ϖ})
include hϖ

theorem exists_eq_mul_of_not_isUnit {x : Λ} (hx : ¬ IsUnit x) : ∃ y, x = ϖ * y := by
  have h : x ∈ maximalIdeal Λ := (mem_maximalIdeal x).2 (mem_nonunits_iff.2 hx)
  rw [hϖ, Ideal.mem_span_singleton'] at h
  obtain ⟨y, hy⟩ := h
  exact ⟨y, by rw [← hy, mul_comm]⟩

theorem isUnit_sub_mul {u : Λ} (hu : IsUnit u) (t : Λ) : IsUnit (u - ϖ * t) := by
  by_contra h
  obtain ⟨y, hy⟩ := exists_eq_mul_of_not_isUnit hϖ h
  have hm : u ∈ maximalIdeal Λ := by
    rw [hϖ, Ideal.mem_span_singleton']
    exact ⟨t + y, by linear_combination (-1 : Λ) * hy⟩
  exact mem_nonunits_iff.1 ((mem_maximalIdeal u).1 hm) hu

/-- **Freeness criterion.** A finite `Λ`-module in which `ϖᵐ`-torsion (`m < n`) is divisible by `ϖ` is free. -/
theorem free_of_torsion {n : ℕ} (hn : ϖ ^ n = 0) {E : Type} [AddCommGroup E] [Module Λ E] [Module.Finite Λ E]
    (H : ∀ m < n, ∀ z : E, ϖ ^ m • z = 0 → ∃ w, z = ϖ • w) : Module.Free Λ E := by
  classical
  have hex : ∃ r, ∃ e : Fin r → E, Submodule.span Λ (Set.range e) = ⊤ := Module.Finite.exists_fin
  obtain ⟨r, ⟨e, he⟩, hmin⟩ : ∃ r, (∃ e : Fin r → E, Submodule.span Λ (Set.range e) = ⊤) ∧
      ∀ r' < r, ¬ ∃ e : Fin r' → E, Submodule.span Λ (Set.range e) = ⊤ :=
    ⟨Nat.find hex, Nat.find_spec hex, fun r' h => Nat.find_min hex h⟩
  -- a relation never has a unit coefficient (minimality)
  have hunit : ∀ c : Fin r → Λ, ∑ i, c i • e i = 0 → ∀ i, ¬ IsUnit (c i) := by
    intro c hc i hi
    obtain ⟨f, hf⟩ : ∃ f : Fin (Fintype.card {j : Fin r // j ≠ i}) → E,
        f = fun k => e ((Fintype.equivFin {j : Fin r // j ≠ i}).symm k) := ⟨_, rfl⟩
    have hmem : ∀ j, j ≠ i → e j ∈ Submodule.span Λ (Set.range f) := by
      intro j hj
      apply Submodule.subset_span
      exact ⟨Fintype.equivFin {j : Fin r // j ≠ i} ⟨j, hj⟩, by rw [hf]; simp⟩
    have hsum := Finset.add_sum_erase Finset.univ (fun j => c j • e j) (Finset.mem_univ i)
    rw [hc] at hsum
    have hrest : ∑ j ∈ Finset.univ.erase i, c j • e j ∈ Submodule.span Λ (Set.range f) :=
      Submodule.sum_mem _ fun j hj => Submodule.smul_mem _ _ (hmem j (Finset.ne_of_mem_erase hj))
    have hci : c i • e i ∈ Submodule.span Λ (Set.range f) := by
      rw [eq_neg_of_add_eq_zero_left hsum]
      exact Submodule.neg_mem _ hrest
    have hei : e i ∈ Submodule.span Λ (Set.range f) := by
      obtain ⟨u, hu⟩ := hi
      have h1 : e i = (↑u⁻¹ : Λ) • (c i • e i) := by rw [smul_smul, ← hu, Units.inv_mul, one_smul]
      rw [h1]
      exact Submodule.smul_mem _ _ hci
    have hlt : Fintype.card {j : Fin r // j ≠ i} < r := by
      simpa using Fintype.card_subtype_lt (p := fun j : Fin r => j ≠ i) (x := i) (by simp)
    apply hmin _ hlt
    refine ⟨f, eq_top_iff.2 ?_⟩
    rw [← he, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    by_cases hj : j = i
    · subst hj
      exact hei
    · exact hmem j hj
  have hli : LinearIndependent Λ e := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have key : ∀ m ≤ n, ∃ d : Fin r → Λ, ∀ i, c i = ϖ ^ m * d i := by
      intro m
      induction m with
      | zero => exact fun _ => ⟨c, fun i => by simp⟩
      | succ m ih =>
        intro hm
        obtain ⟨d, hd⟩ := ih (by omega)
        have hz : ϖ ^ m • ∑ i, d i • e i = 0 := by
          rw [Finset.smul_sum, ← hc]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [smul_smul, hd i]
        obtain ⟨w, hw⟩ := H m (by omega) _ hz
        have hw' : w ∈ Submodule.span Λ (Set.range e) := by
          rw [he]
          exact Submodule.mem_top
        obtain ⟨ν, hν⟩ := (Submodule.mem_span_range_iff_exists_fun Λ).1 hw'
        have hrel : ∑ i, (d i - ϖ * ν i) • e i = 0 := by
          have h1 : ∑ i, (d i - ϖ * ν i) • e i = ∑ i, d i • e i - ϖ • ∑ i, ν i • e i := by
            rw [Finset.smul_sum, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [sub_smul, mul_smul]
          rw [h1, hν, ← hw, sub_self]
        refine ⟨fun i => Classical.choose (exists_eq_mul_of_not_isUnit hϖ (hunit _ hrel i)) + ν i,
          fun i => ?_⟩
        have hy := Classical.choose_spec (exists_eq_mul_of_not_isUnit hϖ (hunit _ hrel i))
        rw [hd i]
        linear_combination ϖ ^ m * hy
    intro i
    obtain ⟨d, hd⟩ := key n le_rfl
    rw [hd i, hn, zero_mul]
  exact Module.Free.of_basis (Module.Basis.mk hli he.ge)

end PerfectCx
end RamanujanPetersson

end

-- ===== S3.SB_Frob =====
section

/-!
# Stepanov-Bombieri for a function field over `F_q` (untwisted case)

The abstract core `twisted_stepanov` (SB_Core) applied to the concrete Riemann-Roch data `ffData Fq F`
with `τ = id`: a place `P` of degree dividing `m` satisfies `f ^ (q ^ m) ≡ f` for every `P`-integral
`f` (the residue field has `q ^ deg P` elements), so with a degree-one place `P0`, `q ^ m = Q0 ^ 2`
and `(g + 1) ^ 2 < Q0`:
`N_m ≤ q ^ m + (2 g + 1) q ^ (m / 2)`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open WithZero IsDedekindDomain Polynomial

namespace RamanujanPetersson.ZetaSB

open RR

/-! ### Residue fields: `a ^ (q ^ m) ≡ a` at places of degree dividing `m` -/

section Generic

variable (Fq : Type*) [Field Fq] [Fintype Fq]
variable {S : Type*} [CommRing S] [IsDedekindDomain S] [Algebra Fq S] [Places.FiniteQuot S]
variable {K : Type*} [Field K] [Algebra S K] [IsFractionRing S K]

theorem pow_card_pow_sub_mem (P : HeightOneSpectrum S) {m : ℕ} (hm : Places.deg Fq P ∣ m) (a : S) :
    a ^ (Fintype.card Fq ^ m) - a ∈ P.asIdeal := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow, sub_eq_zero]
  have := P.isMaximal
  let _ : Field (S ⧸ P.asIdeal) := Ideal.Quotient.field _
  let _ : Fintype (S ⧸ P.asIdeal) := Fintype.ofFinite _
  obtain ⟨j, rfl⟩ := hm
  have hc : Fintype.card (S ⧸ P.asIdeal) = Fintype.card Fq ^ Places.deg Fq P := by
    rw [← Nat.card_eq_fintype_card]; exact Places.card_residue_eq Fq P
  rw [pow_mul, ← hc]
  exact Places.pow_card_pow_eq _ _

/-- For `P`-integral `f` and `deg P ∣ m`: `v_P (f - f ^ (q ^ m)) < 1`. -/
theorem valuation_sub_pow_lt (P : HeightOneSpectrum S) {m : ℕ} (hm : Places.deg Fq P ∣ m)
    (p k : ℕ) [Fact p.Prime] [CharP K p] (hQ : Fintype.card Fq ^ m = p ^ k) (f : K)
    (hf : P.valuation K f ≤ 1) :
    P.valuation K (f - f ^ (Fintype.card Fq ^ m)) < 1 := by
  obtain ⟨a, ha⟩ := P.exists_valuation_sub_lt_of_integer hf (1 : (ℤᵐ⁰)ˣ)
  set e := f - algebraMap S K a with he_def
  have he : P.valuation K e < 1 := by
    rw [he_def, Valuation.map_sub_swap]; simpa using ha
  have hfe : f = algebraMap S K a + e := by rw [he_def]; ring
  have hfrob : ∀ x y : K, (x + y) ^ (Fintype.card Fq ^ m) =
      x ^ (Fintype.card Fq ^ m) + y ^ (Fintype.card Fq ^ m) := by
    intro x y; rw [hQ]; exact add_pow_char_pow x y p k
  have hQne : Fintype.card Fq ^ m ≠ 0 := pow_ne_zero _ Fintype.card_ne_zero
  have h1 : P.valuation K (algebraMap S K (a - a ^ (Fintype.card Fq ^ m))) < 1 := by
    rw [HeightOneSpectrum.valuation_lt_one_iff_mem, ← neg_sub, neg_mem_iff]
    exact pow_card_pow_sub_mem Fq P hm a
  have h2 : P.valuation K (e - e ^ (Fintype.card Fq ^ m)) < 1 := by
    refine Valuation.map_sub_lt _ he ?_
    rw [map_pow]; exact pow_lt_one₀ zero_le he hQne
  have hsplit : f - f ^ (Fintype.card Fq ^ m) =
      algebraMap S K (a - a ^ (Fintype.card Fq ^ m)) + (e - e ^ (Fintype.card Fq ^ m)) := by
    conv_lhs => rw [hfe, hfrob]
    rw [map_sub, map_pow]; ring
  rw [hsplit]; exact Valuation.map_add_lt _ h1 h2

end Generic

/-! ### Function fields -/

section FF

variable {Fq : Type*} [Field Fq] [Fintype Fq] [DecidableEq (RatFunc Fq)]
variable {F : Type*} [Field F] [Algebra Fq F] [Algebra Fq[X] F] [Algebra (RatFunc Fq) F]
  [IsScalarTower Fq[X] (RatFunc Fq) F] [IsScalarTower Fq Fq[X] F] [FunctionField Fq F]
  [Algebra.IsSeparable (RatFunc Fq) F]

/-- The Frobenius bridge: at a place of degree dividing `m`, `f ^ (q ^ m) ≡ f` for `P`-integral `f`. -/
theorem ffv_sub_pow_lt (P : Places.Place Fq F) {m : ℕ} (hm : P.deg ∣ m) (p k : ℕ) [Fact p.Prime]
    [CharP F p] (hQ : Fintype.card Fq ^ m = p ^ k) (f : F) (hf : ffv Fq F P f ≤ 1) :
    ffv Fq F P (f - f ^ (Fintype.card Fq ^ m)) < 1 := by
  rcases P with P | P
  · exact valuation_sub_pow_lt Fq P hm p k hQ f hf
  · exact valuation_sub_pow_lt Fq P hm p k hQ f hf

/-- **Stepanov-Bombieri upper bound.** If `F` has a place of degree one, `q ^ m = Q0 ^ 2` and
`(g + 1) ^ 2 < Q0`, then `N_m ≤ q ^ m + (2 g + 1) Q0`. -/
theorem numPoints_le_of_sq {P0 : Places.Place Fq F} (hP0 : P0.deg = 1) {m Q0 : ℕ} (hm : m ≠ 0)
    (hQ : Fintype.card Fq ^ m = Q0 ^ 2) (hg : (genusF Fq F + 1) ^ 2 < Q0) :
    Places.numPoints Fq F m ≤ Q0 ^ 2 + (2 * genusF Fq F + 1) * Q0 := by
  classical
  obtain ⟨p, hchar, n, hp, hcard⟩ := FiniteField.card' Fq
  have := hchar
  have : Fact p.Prime := ⟨hp⟩
  have : CharP F p := charP_of_injective_algebraMap (algebraMap Fq F).injective p
  have hQp : Fintype.card Fq ^ m = p ^ ((n : ℕ) * m) := by rw [hcard, ← pow_mul]
  obtain ⟨k, -, hk0⟩ : ∃ k ≤ (n : ℕ) * m, Q0 = p ^ k :=
    (Nat.dvd_prime_pow hp).mp ⟨Q0, by rw [← hQp, hQ, sq]⟩
  have hell : (ffData Fq F).ell 0 = 1 := ellF_zero_of_deg_one hP0
  have hP0T : P0 ∈ (Places.finite_place_deg_dvd Fq F hm).toFinset := by
    simp [hP0]
  have hmain := twisted_stepanov ffData_axioms p k Q0 hk0 (RingHom.id F) (Equiv.refl _)
    (fun _ _ => rfl) (fun _ => rfl) P0 (by rw [hell]; exact hP0) (Q0 + 2 * genusF Fq F)
    (by rw [hell, one_mul, one_mul]) (by rw [hell]; simpa using hg)
    (Places.finite_place_deg_dvd Fq F hm).toFinset (by
      intro P hP _ f hf
      have hdvd : P.deg ∣ m := by simpa using hP
      rw [RingHom.id_apply, ffData_v, ← hQ]
      exact ffv_sub_pow_lt P hdvd p _ hQp f hf)
  rw [hell] at hmain
  rw [Places.numPoints, dif_neg hm, ← Finset.add_sum_erase _ _ hP0T, hP0]
  set s := ∑ P ∈ ((Places.finite_place_deg_dvd Fq F hm).toFinset).erase P0, P.deg
  have hQ0pos : 0 < Q0 := hk0 ▸ pow_pos hp.pos k
  have hs : s ≤ (Q0 - 1) + Q0 * (Q0 + 2 * genusF Fq F) := by
    refine Nat.le_of_mul_le_mul_left ?_ hQ0pos
    calc Q0 * s ≤ 1 * (Q0 * (Q0 - 1) + Q0 ^ 2 * (Q0 + 2 * genusF Fq F)) := by
          simpa using hmain
      _ = Q0 * ((Q0 - 1) + Q0 * (Q0 + 2 * genusF Fq F)) := by ring
  have hX : Q0 ^ 2 + (2 * genusF Fq F + 1) * Q0 = Q0 * (Q0 + 2 * genusF Fq F) + Q0 := by ring
  rw [hX]
  generalize Q0 * (Q0 + 2 * genusF Fq F) = X at hs ⊢
  omega

end FF

end RamanujanPetersson.ZetaSB

end

-- ===== S3.StepanovBombieri =====
section

/-!
# S3-ZetaSB umbrella: Stepanov-Bombieri

* `SB_Core` (abstract twisted Stepanov core), `SB_Frob` (`numPoints_le_of_sq`: the untwisted Bombieri bound with a
  rational place), `SB_Transport`, `SB_Count`, `SB_GalA`..`SB_GalC` (Galois-twist lower bound `lower_bound_core`),
  `SB_ClosA`/`SB_ClosB` (Galois closure with a place of degree `ℓ(0)`), `SB_Upper` (`upper_bound_core`),
  `HasseWeil_A` (`two_sided`: `N_m = q ^ m + O(q ^ (m/2))` along a progression).
* `bombieri_N1` (unit goal (b)): if `q` is a square and `q > (g + 1) ^ 4` then `N_1 ≤ q + 1 + (2g + 1) √q`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Polynomial

namespace RamanujanPetersson.ZetaSB

open RR

section Bombieri

variable {Fq : Type*} [Field Fq] [Fintype Fq] [DecidableEq (RatFunc Fq)]
variable {F : Type*} [Field F] [Algebra Fq F] [Algebra Fq[X] F] [Algebra (RatFunc Fq) F]
  [IsScalarTower Fq[X] (RatFunc Fq) F] [IsScalarTower Fq Fq[X] F] [FunctionField Fq F]
  [Algebra.IsSeparable (RatFunc Fq) F]

/-- **Bombieri** (unit goal (b)): for `q` a square with `q > (g + 1) ^ 4`, `N_1 ≤ q + 1 + (2g + 1) √q`. (With no
place of degree one, `N_1 = 0`; otherwise `numPoints_le_of_sq` at `m = 1`.) -/
theorem bombieri_N1 (hsq : IsSquare (Fintype.card Fq)) (hgq : (genusF Fq F + 1) ^ 4 < Fintype.card Fq) :
    (Places.numPoints Fq F 1 : ℝ) ≤
      Fintype.card Fq + 1 + (2 * (genusF Fq F : ℝ) + 1) * Real.sqrt (Fintype.card Fq) := by
  classical
  obtain ⟨Q0, hQ0⟩ := hsq
  have hQ : Fintype.card Fq ^ 1 = Q0 ^ 2 := by rw [pow_one, hQ0, sq]
  have hg : (genusF Fq F + 1) ^ 2 < Q0 := by
    by_contra h
    rw [not_lt] at h
    have h4 : Q0 * Q0 ≤ (genusF Fq F + 1) ^ 4 :=
      calc Q0 * Q0 = Q0 ^ 2 := (sq Q0).symm
        _ ≤ ((genusF Fq F + 1) ^ 2) ^ 2 := Nat.pow_le_pow_left h 2
        _ = (genusF Fq F + 1) ^ 4 := by ring
    rw [hQ0] at hgq
    exact absurd hgq (not_lt.mpr h4)
  have hsqrt : Real.sqrt (Fintype.card Fq) = Q0 := by
    rw [hQ0]; push_cast; exact Real.sqrt_mul_self (Nat.cast_nonneg _)
  have hc : (Fintype.card Fq : ℝ) = (Q0 : ℝ) ^ 2 := by rw [hQ0]; push_cast; ring
  rw [hsqrt]
  by_cases h1 : ∃ P0 : Places.Place Fq F, P0.deg = 1
  · obtain ⟨P0, hP0⟩ := h1
    have h' : (Places.numPoints Fq F 1 : ℝ) ≤ (Q0 : ℝ) ^ 2 + (2 * (genusF Fq F : ℝ) + 1) * Q0 := by
      exact_mod_cast numPoints_le_of_sq hP0 one_ne_zero hQ hg
    rw [hc]; linarith
  · simp only [not_exists] at h1
    have h0 : Places.numPoints Fq F 1 = 0 := by
      unfold Places.numPoints
      rw [dif_neg one_ne_zero]
      refine Finset.sum_eq_zero fun P hP => ?_
      have hP' : P.deg ∣ 1 := by simpa using hP
      exact absurd (Nat.dvd_one.mp hP') (h1 P)
    rw [h0, Nat.cast_zero]
    positivity

end Bombieri

end RamanujanPetersson.ZetaSB

end

-- ===== S3.Zeta =====
section

/-!
# S3-ZetaSB umbrella: zeta function and the Hasse-Weil bound for curves over `Fq`

Namespace `RamanujanPetersson.ZetaSB`. For a function field `F / Fq` (instance list of `Places`) with full constant
field `Places.constField Fq F = ⊥`, `q = Fintype.card Fq`, `g = genusF Fq F`, `N_m = Places.numPoints Fq F m`:
* `Zeta_A`: effective divisors of degree `n` (`numEff`), Newton identity `n A_n = Σ N_m A_{n-m}`;
* `Zeta_B`: `δ = delta Fq F`, divisor classes, `(q - 1) A_n = h (q ^ (n+1-g) - 1)` for `δ ∣ n ≥ 2g - 1`, recurrence;
* `Zeta_C`: `(1 - t)(1 - q t) Z(t)` is a polynomial in `t ^ δ`; `numPoints_powerSum`;
* `HasseWeil_B`: `delta_eq_one`, `zeta_shape` (`N_m = 1 + q ^ m - Σ_i α_i ^ m`, at most `2g` numbers `α_i`, each
  `|α_i| ≤ √q`) and `hasse_weil` (`|N_m - q ^ m - 1| ≤ 2 g √q ^ m` for all `m ≥ 1`);
* `StepanovBombieri`: `bombieri_N1` and the Stepanov-Bombieri / Galois-twist chain.
-/

end

-- ===== S4.Def_RP_CdOne_KumOrb =====
section

/-!
# S4-PD (3)(iii)(K), part O: Galois orbits of primes and valuations mod `n`

`R → B` with a finite group `G` acting on the Dedekind domain `B` with invariants `R` (`Algebra.IsInvariant`),
`F = Frac B` with a compatible `G`-action.
* `smul_eq_pullH`: `w' = g • w` as ideals ⇒ `w' = pullH g⁻¹ w`;
* `dvd_sub_of_under_eq`: if `g • b / b` has `n`-divisible valuations for every `g`, then two primes of `B` over the
  same prime of `R` give congruent valuations of `b` mod `n` (transitivity of `G` on the fibre).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IsDedekindDomain
open scoped Pointwise

variable {R B : Type*} [CommRing R] [CommRing B] [IsDedekindDomain B] [Algebra R B]
  {G : Type*} [Group G] [MulSemiringAction G B]

/-- `w' = g • w` as ideals means `w' = pullH g⁻¹ w`. -/
theorem smul_eq_pullH (g : G) (w w' : HeightOneSpectrum B) (h : w'.asIdeal = g • w.asIdeal) :
    w' = PicDescent.pullH (MulSemiringAction.toRingEquiv G B g⁻¹) w := by
  ext1
  rw [h, Ideal.pointwise_smul_def, PicDescent.pullH_asIdeal]
  have h1 : MulSemiringAction.toRingHom G B g =
      ((MulSemiringAction.toRingEquiv G B g : B ≃+* B) : B →+* B) := rfl
  rw [h1, Ideal.map_comap_of_equiv]
  rfl

variable [Finite G] [SMulCommClass G R B] [Algebra.IsInvariant R B G]
  {F : Type*} [Field F] [Algebra B F] [IsFractionRing B F] [MulSemiringAction G F]

/-- **Valuations are constant mod `n` on a fibre** when every `g • b / b` has `n`-divisible valuations. -/
theorem dvd_sub_of_under_eq (hcomp : ∀ (g : G) (x : B), algebraMap B F (g • x) = g • algebraMap B F x)
    (n : ℤ) (b : F)
    (hb : ∀ (g : G) (w : HeightOneSpectrum B),
      n ∣ WithZero.log (w.valuation F (g • b)) - WithZero.log (w.valuation F b))
    (w w' : HeightOneSpectrum B) (h : w.asIdeal.under R = w'.asIdeal.under R) :
    n ∣ WithZero.log (w.valuation F b) - WithZero.log (w'.valuation F b) := by
  have := w.isPrime
  have := w'.isPrime
  obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq R B G w.asIdeal w'.asIdeal h
  have hw' := smul_eq_pullH g w w' hg
  have hv : w'.valuation F b = w.valuation F (g⁻¹ • b) := by
    rw [hw']
    exact PicDescent.valuation_pullH (MulSemiringAction.toRingEquiv G B g⁻¹)
      (MulSemiringAction.toRingEquiv G F g⁻¹) (fun x => hcomp g⁻¹ x) w b
  rw [hv]
  have h2 := dvd_neg.2 (hb g⁻¹ w)
  rwa [neg_sub] at h2

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_CdOne_KumVal =====
section

/-!
# S4-PD (3)(iii)(K), part V: primes and valuations along finite levels `M ≤ L` of `K̄ / K`

`B_M = integralClosure A M` for an intermediate field `M` of `K̄ / K`.
* `underI h w`: the prime of `B_M` under a prime `w` of `B_L` (`h : M ≤ L`), `mem_underI`, `underI_trans`;
* `val_underI`: for `L ∈ unramSet A K` (unramified over `A`), `v_{under w}(x) = v_w(x)` for `x ∈ M`;
* `log_val_mul`, `finite_log_val_ne_zero`: additivity and finite support of `w ↦ log v_w(x)`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IsDedekindDomain RamanujanPetersson.Kummer

noncomputable section

section Gen

variable {B F : Type*} [CommRing B] [IsDedekindDomain B] [Field F] [Algebra B F] [IsFractionRing B F]

theorem log_val_mul (w : HeightOneSpectrum B) {x y : F} (hx : x ≠ 0) (hy : y ≠ 0) :
    WithZero.log (w.valuation F (x * y)) = WithZero.log (w.valuation F x) + WithZero.log (w.valuation F y) := by
  rw [map_mul, WithZero.log_mul ((Valuation.ne_zero_iff _).2 hx) ((Valuation.ne_zero_iff _).2 hy)]

/-- `w ↦ log v_w(x)` has finite support. -/
theorem finite_log_val_ne_zero (x : F) :
    {w : HeightOneSpectrum B | WithZero.log (w.valuation F x) ≠ 0}.Finite := by
  obtain ⟨n, d, hd, rfl⟩ := IsFractionRing.div_surjective (A := B) x
  have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
  by_cases hn : n = 0
  · subst hn
    simp
  refine ((Ideal.finite_factors (I := Ideal.span {n}) (by simpa using hn)).union
    (Ideal.finite_factors (I := Ideal.span {d}) (by simpa using hd0))).subset ?_
  intro w hw
  by_contra hc
  simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, Ideal.dvd_span_singleton] at hc
  apply hw
  rw [map_div₀, HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.valuation_of_algebraMap,
    HeightOneSpectrum.intValuation_eq_one_iff.2 hc.1, HeightOneSpectrum.intValuation_eq_one_iff.2 hc.2,
    div_one, WithZero.log_one]

end Gen

variable {K : Type} [Field K] (A : Type) [CommRing A] [IsDedekindDomain A] [Algebra A K] [IsFractionRing A K]

/-- The prime of `B_M` under a prime of `B_L`, for `M ≤ L`. -/
def underI {M L : IntermediateField K (AlgebraicClosure K)} (h : M ≤ L)
    [IsDedekindDomain (integralClosure A M)] [IsDedekindDomain (integralClosure A L)]
    (w : HeightOneSpectrum (integralClosure A L)) : HeightOneSpectrum (integralClosure A M) where
  asIdeal := w.asIdeal.comap (incl A K h)
  isPrime := by
    have := w.isPrime
    exact Ideal.IsPrime.comap _
  ne_bot := by
    intro h0
    apply (w.under A).ne_bot
    change Ideal.comap (algebraMap A (integralClosure A L)) w.asIdeal = ⊥
    have hc : algebraMap A (integralClosure A L) =
        ((incl A K h : integralClosure A M →+* integralClosure A L)).comp (algebraMap A (integralClosure A M)) :=
      RingHom.ext fun a => ((incl A K h).commutes a).symm
    have h0' : Ideal.comap ((incl A K h : integralClosure A M →+* integralClosure A L)) w.asIdeal = ⊥ := h0
    rw [hc, ← Ideal.comap_comap, h0']
    exact Ideal.comap_bot_of_injective _ (algebraMap_integralClosure_injective A M)

variable {M M' L : IntermediateField K (AlgebraicClosure K)}

theorem mem_underI (h : M ≤ L) [IsDedekindDomain (integralClosure A M)] [IsDedekindDomain (integralClosure A L)]
    (w : HeightOneSpectrum (integralClosure A L)) (x : integralClosure A M) :
    x ∈ (underI A h w).asIdeal ↔ incl A K h x ∈ w.asIdeal := Iff.rfl

theorem underI_trans (h₁ : M ≤ M') (h₂ : M' ≤ L) [IsDedekindDomain (integralClosure A M)]
    [IsDedekindDomain (integralClosure A M')] [IsDedekindDomain (integralClosure A L)]
    (w : HeightOneSpectrum (integralClosure A L)) :
    underI A h₁ (underI A h₂ w) = underI A (h₁.trans h₂) w := by
  ext1
  ext x
  exact Iff.rfl

/-- **Valuations along an unramified top level**: `v_{under w}(x) = v_w(x)` for `x ∈ M ≤ L ∈ unramSet`. -/
theorem val_underI (h : M ≤ L) (hL : L ∈ unramSet A K)
    (hperf : ∀ (p : Ideal A) [p.IsMaximal], PerfectField p.ResidueField)
    [IsDedekindDomain (integralClosure A M)] [IsFractionRing (integralClosure A M) M]
    [IsDedekindDomain (integralClosure A L)] [IsFractionRing (integralClosure A L) L]
    (w : HeightOneSpectrum (integralClosure A L)) (x : M) :
    (underI A h w).valuation M x = w.valuation L (IntermediateField.inclusion h x) := by
  letI : Algebra (integralClosure A M) (integralClosure A L) := (incl A K h).toRingHom.toAlgebra
  letI : SMul (integralClosure A M) (integralClosure A L) := Algebra.toSMul
  letI : Algebra M L := (IntermediateField.inclusion h).toRingHom.toAlgebra
  letI : Algebra (integralClosure A M) L :=
    ((algebraMap M L).comp (algebraMap (integralClosure A M) M)).toAlgebra
  have : @IsScalarTower (integralClosure A M) M L Algebra.toSMul Algebra.toSMul Algebra.toSMul :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have : @IsScalarTower (integralClosure A M) (integralClosure A L) L Algebra.toSMul Algebra.toSMul
      Algebra.toSMul := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have : IsScalarTower A (integralClosure A M) (integralClosure A L) :=
    IsScalarTower.of_algebraMap_eq (fun _ => Subtype.ext (Subtype.ext rfl))
  have : Module.IsTorsionFree (integralClosure A M) (integralClosure A L) :=
    Module.isTorsionFree_iff_algebraMap_injective.2 fun x y hxy =>
      Subtype.ext (Subtype.ext (congrArg (fun z : integralClosure A L => ((z : L) : AlgebraicClosure K)) hxy))
  have : Algebra.IsIntegral (integralClosure A M) (integralClosure A L) :=
    ⟨fun x => (Algebra.IsIntegral.isIntegral (R := A) x).tower_top⟩
  have he : w.asIdeal.ramificationIdx (integralClosure A M) = 1 := by
    have h1 := ramificationIdx_eq_one A hL hperf w.asIdeal w.ne_bot
    rw [Ideal.ramificationIdx_tower (R := A) (w.under (integralClosure A M)).asIdeal w.asIdeal] at h1
    exact Nat.dvd_one.1 ⟨_, h1.symm.trans (mul_comm _ _)⟩
  have he' : (w.under (integralClosure A M)).asIdeal.ramificationIdx' w.asIdeal = 1 := by
    rw [Ideal.ramificationIdx'_eq_ramificationIdx _ _ (w.under (integralClosure A M)).ne_bot]
    exact he
  have hval := HeightOneSpectrum.valuation_liesOver L (w.under (integralClosure A M)) w x
  rw [he', pow_one] at hval
  have hu : underI A h w = w.under (integralClosure A M) := by
    ext1
    rfl
  rw [hu]
  exact hval

end

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_CdOne_KumGrp =====
section

/-!
# S4-PD (3)(iii)(K), part G: the decomposition group of a finite level

For a normal finite level `ML ≤ K_U` and an intermediate field `E` of `K_U / E₀`:
* `resML`: restriction `π₁(U) → Gal(ML/K)`, `resML_apply`; `toPi1`: `Gal(K_U/E₀) → π₁(U)`;
* `Hgrp`: the image of `Gal(K_U/E)` in `Gal(ML/K)`; `exists_of_mem_Hgrp`, `Hgrp_fix` (it fixes `ML ∩ E`) and
  `mem_of_Hgrp_fix` (its fixed elements lie in `E`, by infinite Galois theory).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IntermediateField RamanujanPetersson.Kummer RamanujanPetersson.CurveCoh

noncomputable section

variable {K : Type} [Field K] (A : Type) [CommRing A] [Algebra A K]

/-- Restriction of `π₁(U)` to a normal finite level `ML ≤ K_U`. -/
def resML {ML : IntermediateField K (AlgebraicClosure K)} (hLU : ML ≤ maxUnram A K) [Normal K ML] :
    Pi1 A K →* (ML ≃ₐ[K] ML) :=
  letI : Algebra ML (maxUnram A K) := (IntermediateField.inclusion hLU).toAlgebra
  haveI : IsScalarTower K ML (maxUnram A K) := IsScalarTower.of_algHom (IntermediateField.inclusion hLU)
  AlgEquiv.restrictNormalHom ML

theorem resML_apply {ML : IntermediateField K (AlgebraicClosure K)} (hLU : ML ≤ maxUnram A K) [Normal K ML]
    (σ : Pi1 A K) (y : ML) : ((resML A hLU σ y : ML) : AlgebraicClosure K) =
      ((σ (IntermediateField.inclusion hLU y) : maxUnram A K) : AlgebraicClosure K) := by
  letI : Algebra ML (maxUnram A K) := (IntermediateField.inclusion hLU).toAlgebra
  haveI : IsScalarTower K ML (maxUnram A K) := IsScalarTower.of_algHom (IntermediateField.inclusion hLU)
  exact congrArg Subtype.val (AlgEquiv.restrictNormal_commutes σ ML y)

/-- `Gal(K_U/E₀) → π₁(U)` (forget `E₀`-linearity). -/
def toPi1 (E₀ : IntermediateField K (maxUnram A K)) : (maxUnram A K ≃ₐ[E₀] maxUnram A K) →* Pi1 A K where
  toFun ρ := ρ.restrictScalars K
  map_one' := rfl
  map_mul' _ _ := rfl

variable (E₀ : IntermediateField K (maxUnram A K)) (E : IntermediateField E₀ (maxUnram A K))
  {ML : IntermediateField K (AlgebraicClosure K)} (hLU : ML ≤ maxUnram A K) [Normal K ML]

/-- The image of `Gal(K_U/E)` in `Gal(ML/K)`. -/
def Hgrp : Subgroup (ML ≃ₐ[K] ML) := (E.fixingSubgroup.map (toPi1 A E₀)).map (resML A hLU)

theorem exists_of_mem_Hgrp {τ : ML ≃ₐ[K] ML} (hτ : τ ∈ Hgrp A E₀ E hLU) :
    ∃ ρ ∈ E.fixingSubgroup, ∀ y : ML, ((τ y : ML) : AlgebraicClosure K) =
      ((ρ (IntermediateField.inclusion hLU y) : maxUnram A K) : AlgebraicClosure K) := by
  obtain ⟨σ, ⟨ρ, hρ, rfl⟩, rfl⟩ := hτ
  exact ⟨ρ, hρ, fun y => resML_apply A hLU _ y⟩

/-- `Hgrp` fixes `ML ∩ E`. -/
theorem Hgrp_fix {τ : ML ≃ₐ[K] ML} (hτ : τ ∈ Hgrp A E₀ E hLU) {x : ML}
    (hx : ∃ e : E, ((e : maxUnram A K) : AlgebraicClosure K) = x) : τ x = x := by
  obtain ⟨ρ, hρ, hτρ⟩ := exists_of_mem_Hgrp A E₀ E hLU hτ
  obtain ⟨e, he⟩ := hx
  have hxe : IntermediateField.inclusion hLU x = (e : maxUnram A K) := Subtype.ext he.symm
  apply Subtype.ext
  rw [hτρ, hxe, (mem_fixingSubgroup_iff _ _).1 hρ e e.2, he]

/-- The elements of `ML` fixed by `Hgrp` lie in `E` (infinite Galois theory for `K_U / E₀`). -/
theorem mem_of_Hgrp_fix [IsGalois E₀ (maxUnram A K)] {x : ML} (hx : ∀ τ ∈ Hgrp A E₀ E hLU, τ x = x) :
    ∃ e : E, ((e : maxUnram A K) : AlgebraicClosure K) = x := by
  have hmem : IntermediateField.inclusion hLU x ∈ E := by
    rw [← InfiniteGalois.fixedField_fixingSubgroup E, mem_fixedField_iff]
    intro ρ hρ
    have h1 := hx (resML A hLU (toPi1 A E₀ ρ)) ⟨toPi1 A E₀ ρ, ⟨ρ, hρ, rfl⟩, rfl⟩
    apply Subtype.ext
    have h2 := resML_apply A hLU (toPi1 A E₀ ρ) x
    rw [h1] at h2
    exact h2.symm
  exact ⟨⟨_, hmem⟩, rfl⟩

end

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_CdOne_KumDesc =====
section

/-!
# S4-PD (3)(iii)(K), part D: valuations of a Kummer element are constant mod `n` on `Hgrp`-orbits

`ME ≤ ML` finite levels of `K_U` with `ME = ML ∩ E`; `Hgrp` acts on `B_ML` with invariants `B_ME`
(`Algebra.IsInvariant`, from `mem_of_Hgrp_fix`), so `dvd_sub_of_under_eq` applies:
* `orbit_dvd`: if `τ b / b` has `n`-divisible valuations for every `τ ∈ Hgrp`, then `v_w(b) ≡ v_{w'}(b) mod n`
  whenever `w, w'` lie over the same prime of `B_ME`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IntermediateField IsDedekindDomain RamanujanPetersson.Kummer RamanujanPetersson.CurveCoh

noncomputable section

variable {K : Type} [Field K] (A : Type) [CommRing A] [IsDedekindDomain A] [Algebra A K] [IsFractionRing A K]
  (E₀ : IntermediateField K (maxUnram A K)) (E : IntermediateField E₀ (maxUnram A K))
  {ML ME : IntermediateField K (AlgebraicClosure K)} (hLU : ML ≤ maxUnram A K) [Normal K ML] [FiniteDimensional K ML]

set_option synthInstance.maxHeartbeats 400000 in
theorem orbit_dvd [IsGalois E₀ (maxUnram A K)] (hle : ME ≤ ML)
    (hME : ∀ x : ML, (x : AlgebraicClosure K) ∈ ME ↔ ∃ e : E, ((e : maxUnram A K) : AlgebraicClosure K) = x)
    [IsDedekindDomain (integralClosure A ME)] [IsFractionRing (integralClosure A ME) ME]
    [IsDedekindDomain (integralClosure A ML)] [IsFractionRing (integralClosure A ML) ML]
    (n : ℤ) (b : ML)
    (hb : ∀ τ ∈ Hgrp A E₀ E hLU, ∀ w : HeightOneSpectrum (integralClosure A ML),
      n ∣ WithZero.log (w.valuation ML (τ b)) - WithZero.log (w.valuation ML b))
    (w w' : HeightOneSpectrum (integralClosure A ML)) (h : underI A hle w = underI A hle w') :
    n ∣ WithZero.log (w.valuation ML b) - WithZero.log (w'.valuation ML b) := by
  let H := Hgrp A E₀ E hLU
  letI : MulSemiringAction H ML := MulSemiringAction.compHom ML H.subtype
  haveI : SMulCommClass H A ML := ⟨fun g a x => map_smul ((g : ML ≃ₐ[K] ML).restrictScalars A) a x⟩
  letI : MulSemiringAction H (integralClosure A ML) := inferInstance
  letI : Algebra (integralClosure A ME) (integralClosure A ML) := (incl A K hle).toRingHom.toAlgebra
  letI : SMul (integralClosure A ME) (integralClosure A ML) := Algebra.toSMul
  haveI : SMulCommClass H (integralClosure A ME) (integralClosure A ML) := ⟨fun g e x => by
    apply Subtype.ext
    change (g : ML ≃ₐ[K] ML) (((incl A K hle e : integralClosure A ML) : ML) * (x : ML)) =
      ((incl A K hle e : integralClosure A ML) : ML) * (g : ML ≃ₐ[K] ML) (x : ML)
    rw [map_mul, Hgrp_fix A E₀ E hLU g.2 ((hME _).1 ((e : ME)).2)]⟩
  haveI : Algebra.IsInvariant (integralClosure A ME) (integralClosure A ML) H := ⟨fun x hx => by
    have hfix : ∀ τ ∈ H, τ (x : ML) = (x : ML) := fun τ hτ => congrArg Subtype.val (hx ⟨τ, hτ⟩)
    have hmem : ((x : ML) : AlgebraicClosure K) ∈ ME := (hME _).2 (mem_of_Hgrp_fix A E₀ E hLU hfix)
    have hint : IsIntegral A (⟨(x : ML), hmem⟩ : ME) := by
      have h1 : IsIntegral A (x : ML) := x.2
      exact (isIntegral_algHom_iff ((IntermediateField.inclusion hle).restrictScalars A)
        (IntermediateField.inclusion hle).injective).1 h1
    exact ⟨⟨⟨(x : ML), hmem⟩, hint⟩, Subtype.ext rfl⟩⟩
  exact dvd_sub_of_under_eq (R := integralClosure A ME) (G := H) (fun _ _ => rfl) n b
    (fun g w => hb g.1 g.2 w) w w' (congrArg HeightOneSpectrum.asIdeal h)

end

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_CdOne_KumLev =====
section

/-!
# S4-PD (3)(iii)(K), part L: level lemmas for the Kummer-closure descent

* `exists_underI_eq`: every prime of `B_M` lies under a prime of `B_L` (`M ≤ L`);
* `hgrp_dvd`: for a Kummer element `b` of a Galois extension `L/E` inside `K_U` (every `σ b / b` an `l`-th power in
  `L`, stated as `σ b = c ^ l * b`) and a finite unramified level `ML ∋ b`, every `τ ∈ Hgrp` changes the valuations of `b` by multiples of `l`;
* `constLevel_le_map`: the constant level `K(𝔽_{p^m})` lies in every `E ⊇ E₀ = constFieldU`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IntermediateField IsDedekindDomain RamanujanPetersson.Kummer RamanujanPetersson.CurveCoh

noncomputable section

variable {K : Type} [Field K] (A : Type) [CommRing A] [IsDedekindDomain A] [Algebra A K] [IsFractionRing A K]

/-- Every prime of `B_M` lies under a prime of `B_L`. -/
theorem exists_underI_eq {M L : IntermediateField K (AlgebraicClosure K)} (h : M ≤ L)
    [IsDedekindDomain (integralClosure A M)] [IsDedekindDomain (integralClosure A L)]
    (P : HeightOneSpectrum (integralClosure A M)) : ∃ w, underI A h w = P := by
  letI : Algebra (integralClosure A M) (integralClosure A L) := (incl A K h).toRingHom.toAlgebra
  letI : SMul (integralClosure A M) (integralClosure A L) := Algebra.toSMul
  have : IsScalarTower A (integralClosure A M) (integralClosure A L) :=
    IsScalarTower.of_algebraMap_eq (fun _ => Subtype.ext (Subtype.ext rfl))
  have : Module.IsTorsionFree (integralClosure A M) (integralClosure A L) :=
    Module.isTorsionFree_iff_algebraMap_injective.2 fun x y hxy =>
      Subtype.ext (Subtype.ext (congrArg (fun z : integralClosure A L => ((z : L) : AlgebraicClosure K)) hxy))
  have : Algebra.IsIntegral (integralClosure A M) (integralClosure A L) :=
    ⟨fun x => (Algebra.IsIntegral.isIntegral (R := A) x).tower_top⟩
  obtain ⟨w, hw⟩ := PicDescent.exists_under_eq (A := integralClosure A M) (B := integralClosure A L) P
  refine ⟨w, ?_⟩
  rw [← hw]
  ext1
  rfl

set_option synthInstance.maxHeartbeats 400000 in
/-- `τ ∈ Hgrp` moves the valuations of a Kummer element `b` by multiples of `l`. -/
theorem hgrp_dvd (hperf : ∀ (p : Ideal A) [p.IsMaximal], PerfectField p.ResidueField)
    (E₀ : IntermediateField K (maxUnram A K)) (E : IntermediateField E₀ (maxUnram A K))
    (L : IntermediateField E (maxUnram A K)) [Normal E L] (l : ℕ)
    {ML : IntermediateField K (AlgebraicClosure K)} (hLU : ML ≤ maxUnram A K) [Normal K ML]
    (hML : ML ∈ unramSet A K)
    [IsDedekindDomain (integralClosure A ML)] [IsFractionRing (integralClosure A ML) ML]
    (b : L) (hb0 : b ≠ 0) (hb : ∀ σ : L ≃ₐ[E] L, ∃ c : L, σ b = c ^ l * b)
    (bL : ML) (hbL : (bL : AlgebraicClosure K) = ((b : maxUnram A K) : AlgebraicClosure K))
    {τ : ML ≃ₐ[K] ML} (hτ : τ ∈ Hgrp A E₀ E hLU) (w : HeightOneSpectrum (integralClosure A ML)) :
    (l : ℤ) ∣ WithZero.log (w.valuation ML (τ bL)) - WithZero.log (w.valuation ML bL) := by
  obtain ⟨ρ, hρ, hτρ⟩ := exists_of_mem_Hgrp A E₀ E hLU hτ
  let σ : L ≃ₐ[E] L := (E.fixingSubgroupEquiv ⟨ρ, hρ⟩).restrictNormal L
  obtain ⟨c, hc'⟩ := hb σ
  have hβ0 : (bL : AlgebraicClosure K) ≠ 0 := by
    rw [hbL]
    simpa using hb0
  have hbL0 : bL ≠ 0 := by
    intro h
    apply hβ0
    rw [h, ZeroMemClass.coe_zero]
  have hτ0 : τ bL ≠ 0 := (map_ne_zero τ).2 hbL0
  have hx : IntermediateField.inclusion hLU bL = (b : maxUnram A K) := Subtype.ext hbL
  have h3 : ((σ b : L) : maxUnram A K) = ρ (b : maxUnram A K) :=
    AlgEquiv.restrictNormal_apply L _ b
  have hτb : ((τ bL : ML) : AlgebraicClosure K) =
      ((c : maxUnram A K) : AlgebraicClosure K) ^ l * (bL : AlgebraicClosure K) := by
    rw [hτρ, hx, ← h3, hc', hbL]
    simp only [IntermediateField.coe_mul, IntermediateField.coe_pow]
  obtain ⟨q, hq⟩ : ∃ q : ML, q = τ bL / bL := ⟨_, rfl⟩
  have hq0 : q ≠ 0 := by
    rw [hq]
    exact div_ne_zero hτ0 hbL0
  have hα : ((c : maxUnram A K) : AlgebraicClosure K) ^ l = (q : AlgebraicClosure K) := by
    rw [hq, IntermediateField.coe_div, hτb, mul_div_cancel_right₀ _ hβ0]
  have hdiv := dvd_log_valuation_of_mem_maxUnram A hML hperf (c : maxUnram A K).2 hα w
  have hτq : τ bL = q * bL := by rw [hq, div_mul_cancel₀ _ hbL0]
  rw [hτq, log_val_mul w hq0 hbL0, add_sub_cancel_right]
  exact hdiv

/-- `x ^ k = x` gives `x ^ (k ^ j) = x`. -/
theorem pow_pow_eq_self {F : Type*} [Monoid F] {y : F} {k : ℕ} (hy : y ^ k = y) (j : ℕ) : y ^ (k ^ j) = y := by
  induction j with
  | zero => simp
  | succ j ih => rw [pow_succ, pow_mul, ih, hy]

variable {p : ℕ} [Fact p.Prime] [CharP K p]

/-- `𝔽_{p^m} ⊆ E₀ = constFieldU`, so the constant level `K(𝔽_{p^m})` lies in every `E ⊇ E₀`. -/
theorem constLevel_le_map {e m : ℕ} (hm : 0 < m)
    (E : IntermediateField (constFieldU A K (p ^ e)) (maxUnram A K)) :
    constLevel K p m ≤ (E.restrictScalars K).map (maxUnram A K).val := by
  have hCU : constLevel K p m ≤ maxUnram A K := by
    rw [maxUnram_eq_sSup]
    exact le_sSup (constLevel_mem_unramSet A (p := p) hm)
  rw [constLevel, IntermediateField.adjoin_le_iff]
  intro x hx
  have hxC : x ∈ constLevel K p m := IntermediateField.subset_adjoin K _ hx
  have hxx : x ^ (p ^ m) = x := by
    rw [Polynomial.mem_rootSet] at hx
    have h2 := hx.2
    simp only [map_sub, map_pow, Polynomial.aeval_X] at h2
    exact sub_eq_zero.1 h2
  have hy : IsConst (p ^ e) (⟨x, hCU hxC⟩ : maxUnram A K) := ⟨m, hm, by
    apply Subtype.ext
    rw [SubmonoidClass.coe_pow, show (p ^ e) ^ m = (p ^ m) ^ e by rw [← pow_mul, ← pow_mul, mul_comm]]
    exact pow_pow_eq_self hxx e⟩
  have hyE₀ : (⟨x, hCU hxC⟩ : maxUnram A K) ∈ constFieldU A K (p ^ e) := IntermediateField.subset_adjoin K _ hy
  have hyE : (⟨x, hCU hxC⟩ : maxUnram A K) ∈ E := E.algebraMap_mem (⟨_, hyE₀⟩ : constFieldU A K (p ^ e))
  rw [IntermediateField.coe_map]
  exact ⟨_, hyE, rfl⟩

end

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_CdOne_Emb =====
section

/-!
# S4-PD (3b): the central embedding problem with kernel `μ_l`

Let `E` be a C1 field containing a primitive `l`-th root of unity `ζ`, and `L/E` a finite Galois `l`-extension.
For a 2-cocycle `f : Gal(L/E)² → ZMod l` (trivial action), `Br(L/E) = 0` (`br_eq_zero`) gives `β : Gal(L/E) → Lˣ`
with `dβ = ζ^f`, and Hilbert 90 gives `b ∈ Lˣ` with `σ b / b = β(σ)^l` (`exists_kummer_data`). For any extension
`Ω ⊇ L` of `E` containing an `l`-th root `y` of `a·b` (`a ∈ Eˣ` free, used later to remove ramification), the
inflation of `f` to `Gal(Ω/E)` is the coboundary of `γ(σ) = log_ζ (β(σ|L) y / σ y)` (`emb_coboundary`), and `γ(σ)`
only depends on `σ|L` and `σ y`. `emb_solve` packages both steps.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open groupCohomology IntermediateField RamanujanPetersson.Tsen

theorem pow_val_add {M : Type*} [Monoid M] {z : M} {l : ℕ} [NeZero l] (hz : z ^ l = 1) (a b : ZMod l) :
    z ^ (a + b).val = z ^ a.val * z ^ b.val := by
  rw [ZMod.val_add, ← pow_add]
  conv_rhs => rw [← Nat.mod_add_div (a.val + b.val) l, pow_add, pow_mul, hz, one_pow, mul_one]

theorem cg_key {G : Type*} [CommGroup G] (P Q R S U Y W : G) (hW : W = P * S / U) :
    U * (R * Y / S) = P / Q * R * (Q * Y / W) := by
  subst hW
  apply Additive.ofMul.injective
  simp only [ofMul_mul, ofMul_div]
  abel

theorem cg_pow {G : Type*} [CommGroup G] (X A B S : G) (hS : S = A * (X * B)) :
    X * (A * B) / S = 1 := by
  subst hS
  apply Additive.ofMul.injective
  simp only [ofMul_mul, ofMul_div, ofMul_one]
  abel

section Kummer

variable {E : Type*} [Field E]

/-- The image of a nonzero `ζ : E` in `Lˣ`. -/
noncomputable def unitOf (L : Type*) [Field L] [Algebra E L] (ζ : E) (h : ζ ≠ 0) : Lˣ :=
  Units.mk0 (algebraMap E L ζ) ((map_ne_zero _).mpr h)

variable {L : Type*} [Field L] [Algebra E L]

theorem unitOf_val (ζ : E) (h : ζ ≠ 0) : ((unitOf L ζ h : Lˣ) : L) = algebraMap E L ζ := rfl

theorem smul_unitOf (σ : Gal(L/E)) (ζ : E) (h : ζ ≠ 0) : σ • unitOf L ζ h = unitOf L ζ h :=
  Units.ext (σ.commutes ζ)

/-- Step (i): `Br(L/E) = 0` and Hilbert 90 produce the Kummer data `(β, b)`. -/
theorem exists_kummer_data [FiniteDimensional E L] [IsGalois E L] (hE : IsC1 E) (l : ℕ) [Fact l.Prime]
    (hG : IsPGroup l Gal(L/E)) {ζ : E} (hζ : IsPrimitiveRoot ζ l) (hζ0 : ζ ≠ 0)
    (f : Gal(L/E) × Gal(L/E) → ZMod l) (hf : ∀ g h j, f (g * h, j) + f (g, h) = f (h, j) + f (g, h * j)) :
    ∃ (β : Gal(L/E) → Lˣ) (b : Lˣ),
      (∀ σ τ, σ • β τ / β (σ * τ) * β σ = unitOf L ζ hζ0 ^ (f (σ, τ)).val) ∧
        ∀ σ, σ • b / b = β σ ^ l := by
  have : NeZero l := ⟨(Fact.out : l.Prime).ne_zero⟩
  have hz : unitOf L ζ hζ0 ^ l = 1 := Units.ext (by
    rw [Units.val_pow_eq_pow_val, unitOf_val, ← map_pow, hζ.pow_eq_one, map_one, Units.val_one])
  have hc : IsMulCocycle₂ (fun q : Gal(L/E) × Gal(L/E) => unitOf L ζ hζ0 ^ (f q).val) := by
    intro g h j
    simp only
    rw [smul_pow', smul_unitOf, ← pow_val_add hz, ← pow_val_add hz, hf]
  obtain ⟨β, hβ⟩ := br_eq_zero hE l L hG _ hc
  have hφ : IsMulCocycle₁ (fun σ : Gal(L/E) => β σ ^ l) := by
    intro g h
    have h1 : (g • β h / β (g * h) * β g) ^ l = 1 := by
      rw [hβ g h, ← pow_mul, mul_comm, pow_mul, hz, one_pow]
    rw [mul_pow, div_pow, ← smul_pow', div_mul_eq_mul_div, div_eq_one] at h1
    exact h1.symm
  obtain ⟨b, hb⟩ := isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units _ hφ
  exact ⟨β, b, hβ, hb⟩

end Kummer

section Emb

variable {E Ω : Type*} [Field E] [Field Ω] [Algebra E Ω]

set_option synthInstance.maxHeartbeats 400000 in
/-- Step (ii): an `l`-th root `y` of `a·b` in `Ω` kills the inflation of `f`. -/
theorem emb_coboundary (L : IntermediateField E Ω) [Normal E L] {l : ℕ} [Fact l.Prime] {ζ : E}
    (hζ : IsPrimitiveRoot ζ l) (hζ0 : ζ ≠ 0) (f : Gal(L/E) × Gal(L/E) → ZMod l)
    (β : Gal(L/E) → Lˣ) (b : Lˣ)
    (hβ : ∀ σ τ, σ • β τ / β (σ * τ) * β σ = unitOf L ζ hζ0 ^ (f (σ, τ)).val)
    (hb : ∀ σ, σ • b / b = β σ ^ l) (a : E) (ha : a ≠ 0) (y : Ω)
    (hy : y ^ l = algebraMap E Ω a * ((b : L) : Ω)) :
    ∃ γ : Gal(Ω/E) → ZMod l,
      (∀ σ τ, f (AlgEquiv.restrictNormalHom (K₁ := Ω) L σ, AlgEquiv.restrictNormalHom (K₁ := Ω) L τ) =
        γ τ - γ (σ * τ) + γ σ) ∧
      ∀ σ τ, AlgEquiv.restrictNormalHom (K₁ := Ω) L σ = AlgEquiv.restrictNormalHom (K₁ := Ω) L τ →
        σ y = τ y → γ σ = γ τ := by
  classical
  have : NeZero l := ⟨(Fact.out : l.Prime).ne_zero⟩
  set ρ : Gal(Ω/E) →* Gal(L/E) := AlgEquiv.restrictNormalHom (K₁ := Ω) L
  set φ : Lˣ →* Ωˣ := Units.map (algebraMap L Ω : L →+* Ω).toMonoidHom
  have hφ : ∀ w : Lˣ, ((φ w : Ωˣ) : Ω) = ((w : L) : Ω) := fun w => rfl
  have hφσ : ∀ (σ : Gal(Ω/E)) (w : Lˣ), φ (ρ σ • w) = σ • φ w := fun σ w =>
    Units.ext (AlgEquiv.restrictNormal_commutes σ L (w : L))
  obtain ⟨zU, hzUdef⟩ : ∃ zU : Ωˣ, zU = φ (unitOf L ζ hζ0) := ⟨_, rfl⟩
  have hzU : ((zU : Ωˣ) : Ω) = algebraMap E Ω ζ := by
    rw [hzUdef, hφ, unitOf_val]; rfl
  have hprim : IsPrimitiveRoot zU l := by
    rw [← IsPrimitiveRoot.coe_units_iff, hzU]
    exact hζ.map_of_injective (algebraMap E Ω).injective
  have hzfix : ∀ σ : Gal(Ω/E), σ • zU = zU := fun σ =>
    Units.ext (show σ ((zU : Ωˣ) : Ω) = (zU : Ω) by rw [hzU]; exact σ.commutes ζ)
  -- discrete logarithm on `μ_l ⊆ Ωˣ`
  let lg : Ωˣ → ZMod l := fun x =>
    if h : ∃ i < l, ((zU : Ωˣ) : Ω) ^ i = (x : Ω) then ((Classical.choose h : ℕ) : ZMod l) else 0
  have hlg : ∀ x : Ωˣ, x ^ l = 1 → zU ^ (lg x).val = x := by
    intro x hx
    have hx' : (x : Ω) ^ l = 1 := by rw [← Units.val_pow_eq_pow_val, hx, Units.val_one]
    have h := ((IsPrimitiveRoot.coe_units_iff).mpr hprim).eq_pow_of_pow_eq_one hx'
    have hlx : lg x = ((Classical.choose h : ℕ) : ZMod l) := dif_pos h
    apply Units.ext
    rw [hlx, Units.val_pow_eq_pow_val, ZMod.val_natCast_of_lt (Classical.choose_spec h).1]
    exact (Classical.choose_spec h).2
  have hy0 : y ≠ 0 := by
    intro h0
    have h1 : algebraMap E Ω a * ((b : L) : Ω) = 0 := by
      rw [← hy, h0, zero_pow (Fact.out : l.Prime).ne_zero]
    rcases mul_eq_zero.mp h1 with h | h
    · exact ha ((map_eq_zero _).mp h)
    · exact b.ne_zero (Subtype.ext h)
  set Y : Ωˣ := Units.mk0 y hy0
  have ha0 : algebraMap E Ω a ≠ 0 := (map_ne_zero _).mpr ha
  set aU : Ωˣ := Units.mk0 _ ha0
  have hafix : ∀ σ : Gal(Ω/E), σ • aU = aU := fun σ => Units.ext (σ.commutes a)
  have hY : Y ^ l = aU * φ b := Units.ext (by
    rw [Units.val_pow_eq_pow_val, Units.val_mul, hφ]; exact hy)
  -- `u σ = β(σ|L) y / σ y`
  set u : Gal(Ω/E) → Ωˣ := fun σ => φ (β (ρ σ)) * Y / σ • Y with hu_def
  have hu : ∀ σ, u σ ^ l = 1 := by
    intro σ
    have hb' : ρ σ • b = β (ρ σ) ^ l * b := by rw [← hb]; exact (div_mul_cancel _ _).symm
    have hσY : (σ • Y) ^ l = aU * (φ (β (ρ σ)) ^ l * φ b) := by
      rw [← smul_pow', hY, smul_mul', hafix, ← hφσ, hb', map_mul, map_pow]
    rw [hu_def]
    dsimp only
    rw [div_pow, mul_pow, hY, hσY]
    exact cg_pow _ _ _ _ rfl
  set γ : Gal(Ω/E) → ZMod l := fun σ => lg (u σ) with hγ_def
  have hγ : ∀ σ, zU ^ (γ σ).val = u σ := fun σ => hlg _ (hu σ)
  refine ⟨γ, fun σ τ => ?_, fun σ τ hρ hy' => ?_⟩
  · -- the multiplicative identity `u τ * u σ = ζ^f * u (σ τ)`
    have hfixu : σ • u τ = u τ := by rw [← hγ τ, smul_pow', hzfix]
    have hW : (σ * τ) • Y = σ • φ (β (ρ τ)) * σ • Y / u τ := by
      conv_rhs => rw [← hfixu]
      rw [hu_def]
      dsimp only
      rw [smul_div', smul_mul', mul_smul]
      exact (div_div_cancel _ _).symm
    have hc : σ • φ (β (ρ τ)) / φ (β (ρ (σ * τ))) * φ (β (ρ σ)) = zU ^ (f (ρ σ, ρ τ)).val := by
      have h1 := congrArg φ (hβ (ρ σ) (ρ τ))
      rw [map_mul, map_div, hφσ, ← map_mul ρ, map_pow, ← hzUdef] at h1
      exact h1
    have key : u τ * u σ = zU ^ (f (ρ σ, ρ τ)).val * u (σ * τ) := by
      rw [← hc]
      exact cg_key _ _ _ _ _ _ _ hW
    have hD : zU ^ (γ τ - γ (σ * τ) + γ σ).val * u (σ * τ) = zU ^ (f (ρ σ, ρ τ)).val * u (σ * τ) := by
      rw [← key, ← hγ (σ * τ), ← pow_val_add hprim.pow_eq_one, ← hγ τ, ← hγ σ, ← pow_val_add hprim.pow_eq_one]
      rw [show γ τ - γ (σ * τ) + γ σ + γ (σ * τ) = γ τ + γ σ by abel]
    have hD' := mul_right_cancel hD
    exact (ZMod.val_injective _ (hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) hD')).symm
  · have hYe : σ • Y = τ • Y := Units.ext hy'
    rw [hγ_def, hu_def]
    dsimp only
    rw [hρ, hYe]

end Emb

end RamanujanPetersson.CdOne

end

-- ===== S4.Def_RP_Cone_LocKum =====
section

/-!
# S4-PD (4), E4L part 1: local Kummer theory at a finite level, for subgroups of an inertia group

Let `Q` be a prime of the pro-chart, `M ≤ K_U` a finite level with the prime `v = Q ∩ B_M` (`B_M = integralClosure R0 M`),
and `Γ' ≤ I(Q)` a subgroup fixing `M` pointwise (e.g. `Γ' = I(Q) ⊓ H` for the open subgroup `H` fixing a cover level).

* `fix_of_val_dvd_lev`: `γ ^ N = a ∈ M` with `N ∣ v(a)` ⇒ every `σ ∈ I(Q)` fixing `M` fixes `γ` (local Kummer lemma at `M`).
* `kchar_eq_of_val_lev`: Kummer characters on `Γ'` of radicals `α, β` with `α ^ N, β ^ N ∈ M` agree as soon as
  `v(α ^ N) ≡ v(β ^ N) mod N`.
* `exists_ne_eq_of_family_le` (T3 for `Γ'`): among `N + 1` locally constant characters `Γ' → ℤ/N` two coincide, so
  `#Hom_cont(Γ', ℤ/N) ≤ N`; with an onto character `exists_eq_mul_of_surj` makes `Hom_cont(Γ', ℤ/N)` cyclic.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace TameInertia

open CurveCoh IsDedekindDomain Kummer

noncomputable section

variable {A K : Type} [CommRing A] [Field K] [Algebra A K]
  {R0 : Type} [CommRing R0] [IsDedekindDomain R0] [Algebra R0 K] [IsFractionRing R0 K]

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 800000 in
/-- Local Kummer lemma at a finite level `M`: if `γ ^ N = a ∈ M` and `N ∣ v(a)` at `v = Q ∩ B_M`, every inertia
element fixing `M` fixes `γ`. -/
theorem fix_of_val_dvd_lev {Q : Ideal (proChart A K R0)} [Q.IsPrime] {N : ℕ} (hN : IsUnit (N : R0))
    {M : IntermediateField K (AlgebraicClosure K)} (hMU : M ≤ maxUnram A K)
    [IsDedekindDomain (integralClosure R0 M)] [IsFractionRing (integralClosure R0 M) M]
    (v : HeightOneSpectrum (integralClosure R0 M)) (hv : v.asIdeal = Q.comap (inclU R0 hMU))
    {σ : Pi1 A K} (hσ : σ ∈ Q.inertia (Pi1 A K))
    (hσM : ∀ x : maxUnram A K, (x : AlgebraicClosure K) ∈ M → σ x = x)
    {γ : maxUnram A K} {a : M} (ha0 : a ≠ 0) (hγ : γ ^ N = IntermediateField.inclusion hMU a)
    (hdvd : (N : ℤ) ∣ WithZero.log (v.valuation M a)) : σ γ = γ := by
  obtain ⟨c, b, s', hc0, hb, hs', hcbs⟩ := exists_pow_mul_of_dvd v ha0 hdvd
  have hNp : IsUnit (N : proChart A K R0) := by
    simpa using hN.map (algebraMap R0 (proChart A K R0))
  have hγ' : γ ^ N * ((inclU R0 hMU s' : proChart A K R0) : maxUnram A K) =
      (IntermediateField.inclusion hMU c) ^ N * ((inclU R0 hMU b : proChart A K R0) : maxUnram A K) := by
    have h1 := congrArg (IntermediateField.inclusion hMU) hcbs
    simp only [map_mul, map_pow] at h1
    have e2 : ∀ y : integralClosure R0 M, IntermediateField.inclusion hMU (algebraMap _ M y) =
        ((inclU R0 hMU y : proChart A K R0) : maxUnram A K) := fun y => rfl
    rw [e2, e2] at h1
    rw [hγ]
    exact h1
  have hbQ : inclU R0 hMU b ∉ Q := fun h => hb (by rw [hv]; exact h)
  have hsQ : inclU R0 hMU s' ∉ Q := fun h => hs' (by rw [hv]; exact h)
  exact fix_of_inertia_local A K R0 hNp hσ ((map_ne_zero (IntermediateField.inclusion hMU)).2 hc0) hbQ hsQ
    (hσM _ c.2) (hσM _ (b : M).2) (hσM _ (s' : M).2) hγ'

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 800000 in
/-- Kummer characters on `Γ' ≤ I(Q)` (fixing the level `M`) of radicals with `N`-th powers in `M` are determined by
the valuations of the radicands mod `N`. -/
theorem kchar_eq_of_val_lev {Q : Ideal (proChart A K R0)} [Q.IsPrime] {N : ℕ} [NeZero N] (hN : IsUnit (N : R0))
    {ζ : maxUnram A K} (hζ : IsPrimitiveRoot ζ N) {Γ' : Subgroup (Pi1 A K)} (hΓ' : Γ' ≤ Q.inertia (Pi1 A K))
    {M : IntermediateField K (AlgebraicClosure K)} (hMU : M ≤ maxUnram A K)
    [IsDedekindDomain (integralClosure R0 M)] [IsFractionRing (integralClosure R0 M) M]
    (v : HeightOneSpectrum (integralClosure R0 M)) (hv : v.asIdeal = Q.comap (inclU R0 hMU))
    (hΓM : ∀ σ ∈ Γ', ∀ x : maxUnram A K, (x : AlgebraicClosure K) ∈ M → σ x = x)
    {α β : (maxUnram A K)ˣ} (hα : α ∈ rad Γ' N) (hβ : β ∈ rad Γ' N) {a b : M} (ha0 : a ≠ 0) (hb0 : b ≠ 0)
    (ha : (α : maxUnram A K) ^ N = IntermediateField.inclusion hMU a)
    (hb : (β : maxUnram A K) ^ N = IntermediateField.inclusion hMU b)
    (hab : ((WithZero.log (v.valuation M a) : ℤ) : ZMod N) = ((WithZero.log (v.valuation M b) : ℤ) : ZMod N)) :
    kchar hζ (Γ := Γ') α = kchar hζ (Γ := Γ') β := by
  funext σ
  have hdvd : (N : ℤ) ∣ WithZero.log (v.valuation M (a / b)) := by
    rw [map_div₀, WithZero.log_div ((Valuation.ne_zero_iff _).2 ha0) ((Valuation.ne_zero_iff _).2 hb0)]
    exact (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ N).1 hab.symm
  have hγ : ((α : maxUnram A K) / (β : maxUnram A K)) ^ N = IntermediateField.inclusion hMU (a / b) := by
    rw [div_pow, ha, hb, map_div₀]
  have hfix := fix_of_val_dvd_lev hN hMU v hv (hΓ' σ.2) (hΓM σ σ.2) (div_ne_zero ha0 hb0) hγ hdvd
  have hi := kchar_spec hζ hα σ
  have hj := kchar_spec hζ hβ σ
  have hα0 : ((α : (maxUnram A K)ˣ) : maxUnram A K) ≠ 0 := α.ne_zero
  have hβ0 : ((β : (maxUnram A K)ˣ) : maxUnram A K) ≠ 0 := β.ne_zero
  have hb0' := epow_ne_zero hζ (kchar hζ (Γ := Γ') β σ)
  rw [map_div₀, hi, hj, div_eq_div_iff (mul_ne_zero hb0' hβ0) hβ0] at hfix
  apply epow_injective hζ
  have h5 : (epow ζ (kchar hζ (Γ := Γ') α σ) - epow ζ (kchar hζ (Γ := Γ') β σ)) *
      (((α : (maxUnram A K)ˣ) : maxUnram A K) * ((β : (maxUnram A K)ˣ) : maxUnram A K)) = 0 := by
    linear_combination hfix
  rcases mul_eq_zero.1 h5 with h | h
  · exact sub_eq_zero.1 h
  · exact absurd h (mul_ne_zero hα0 hβ0)

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 1600000 in
/-- T3 for a subgroup `Γ' ≤ I(Q)`: among `N + 1` locally constant characters `Γ' → ℤ/N` two coincide. -/
theorem exists_ne_eq_of_family_le {Q : Ideal (proChart A K R0)} (hQ : IsBdryPrime A K R0 Q) {N : ℕ} [NeZero N]
    (hN : IsUnit (N : R0)) {ζ : maxUnram A K} (hζ : IsPrimitiveRoot ζ N) {Γ' : Subgroup (Pi1 A K)}
    (hΓ' : Γ' ≤ Q.inertia (Pi1 A K)) (hζΓ : ∀ σ ∈ Γ', σ ζ = ζ)
    (χ : Fin (N + 1) → Γ' → ZMod N) (hχc : ∀ i, IsLocallyConstant (χ i))
    (hχ : ∀ i σ τ, χ i (σ * τ) = χ i σ + χ i τ) : ∃ i j, i ≠ j ∧ χ i = χ j := by
  classical
  haveI := hQ.1
  choose α hαr hαχ using fun i => exists_kchar_eq hζ hζΓ (χ i) (hχc i) (hχ i)
  obtain ⟨s, hs⟩ : ∃ s : Finset (AlgebraicClosure K), s = Finset.univ.image
      (fun i => ((((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N : maxUnram A K) : AlgebraicClosure K)) := ⟨_, rfl⟩
  have hsmem : ∀ i, ((((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N : maxUnram A K) : AlgebraicClosure K) ∈
      (s : Set (AlgebraicClosure K)) := fun i => by
    rw [hs, Finset.coe_image]
    exact ⟨i, by simp, rfl⟩
  obtain ⟨L, hL, hML⟩ := exists_unramSet_of_finite A K s (by
    intro x hx
    rw [hs, Finset.mem_image] at hx
    obtain ⟨i, -, rfl⟩ := hx
    exact SetLike.coe_mem _)
  obtain ⟨M, hMdef⟩ : ∃ M : IntermediateField K (AlgebraicClosure K),
      M = IntermediateField.adjoin K (s : Set (AlgebraicClosure K)) := ⟨_, rfl⟩
  rw [← hMdef] at hML
  haveI : FiniteDimensional K L := hL.1
  haveI : IsGalois K L := hL.2.1
  have hLU : L ≤ maxUnram A K := by
    rw [maxUnram_eq_sSup]
    exact le_sSup hL
  have hMU : M ≤ maxUnram A K := hML.trans hLU
  haveI : FiniteDimensional K M := FiniteDimensional.of_injective
    (IntermediateField.inclusion hML).toLinearMap (IntermediateField.inclusion hML).injective
  haveI : Algebra.IsSeparable K M :=
    Algebra.IsSeparable.of_algHom (F := K) (E' := L) (IntermediateField.inclusion hML)
  haveI : IsFractionRing (integralClosure R0 M) M :=
    integralClosure.isFractionRing_of_finite_extension (A := R0) K M
  haveI : IsDedekindDomain (integralClosure R0 M) := integralClosure.isDedekindDomain (A := R0) (K := K) (L := M)
  -- `M` is fixed by `Γ'`
  have hfixM : ∀ σ ∈ Γ', ∀ x : maxUnram A K, (x : AlgebraicClosure K) ∈ M → σ x = x := by
    intro σ hσ x hx
    rw [hMdef] at hx
    refine fixed_of_mem_adjoin (Γ := Γ') ?_ hx σ hσ
    intro y hy
    rw [hs, Finset.coe_image] at hy
    obtain ⟨i, -, rfl⟩ := hy
    exact ⟨_, rfl, fun τ hτ => hαr i τ hτ⟩
  obtain ⟨P, hPdef⟩ : ∃ P : Ideal (integralClosure R0 M), P = Q.comap (inclU R0 hMU) := ⟨_, rfl⟩
  have hPp : P.IsPrime := by rw [hPdef]; exact Ideal.IsPrime.comap _
  have hP0 : P ≠ ⊥ := by
    haveI : Nontrivial R0 := (algebraMap R0 K).domain_nontrivial
    obtain ⟨x, hxQ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ.2
    have h1 : Q.comap (algebraMap R0 (proChart A K R0)) ≠ ⊥ :=
      Ideal.comap_ne_bot_of_integral_mem hx0 hxQ (Algebra.IsIntegral.isIntegral x)
    obtain ⟨r, hrQ, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h1
    refine (Submodule.ne_bot_iff _).2 ⟨algebraMap R0 (integralClosure R0 M) r, ?_, ?_⟩
    · rw [hPdef, Ideal.mem_comap, AlgHom.commutes]
      exact hrQ
    · intro h
      have h3 : algebraMap R0 M r = 0 := by
        rw [IsScalarTower.algebraMap_apply R0 (integralClosure R0 M) M, h, map_zero]
      rw [IsScalarTower.algebraMap_apply R0 K M] at h3
      have h4 : algebraMap R0 K r = 0 := (map_eq_zero_iff _ (algebraMap K M).injective).1 h3
      exact hr0 (IsFractionRing.injective R0 K (h4.trans (map_zero _).symm))
  let v : HeightOneSpectrum (integralClosure R0 M) := ⟨P, hPp, hP0⟩
  let aM : Fin (N + 1) → M := fun i =>
    ⟨((((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N : maxUnram A K) : AlgebraicClosure K), by
      rw [hMdef]; exact IntermediateField.subset_adjoin K _ (hsmem i)⟩
  have haM0 : ∀ i, aM i ≠ 0 := by
    intro i h
    have h1 : ((((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N : maxUnram A K) : AlgebraicClosure K) = 0 :=
      congrArg Subtype.val h
    have h2 : (((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N : maxUnram A K) = 0 := Subtype.ext h1
    exact pow_ne_zero _ (α i).ne_zero h2
  have haM : ∀ i, ((α i : (maxUnram A K)ˣ) : maxUnram A K) ^ N = IntermediateField.inclusion hMU (aM i) :=
    fun i => Subtype.ext rfl
  obtain ⟨i, j, hij, hfij⟩ := Fintype.exists_ne_map_eq_of_card_lt
    (fun i => ((WithZero.log (v.valuation M (aM i)) : ℤ) : ZMod N)) (by rw [ZMod.card, Fintype.card_fin]; omega)
  refine ⟨i, j, hij, ?_⟩
  funext σ
  rw [← hαχ i σ, ← hαχ j σ]
  exact congrFun (kchar_eq_of_val_lev hN hζ hΓ' hMU v hPdef hfixM (hαr i) (hαr j) (haM0 i) (haM0 j)
    (haM i) (haM j) hfij) σ

end

