theorem OAI.Cotype.exists_chebyshevExpansion (Q : ℝ[X]) (d : ℕ) (hdeg : Q.degree ≤ d) :
    ∃ c : Fin (d+1) → ℝ, chebyshevExpansion c = Q := by sorry
