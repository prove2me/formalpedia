section
-- Source module: Solutions.J6SegPreUB1
/-!
# B5 chunk side, part 14 (memory-light): the non-store costs are polynomial

Replaces `J6SegILPreJC14`. Same definitions and statements:
`restC pl W d NF Q kJ λ B n` (parameter phase, `cPre`, `cMid`, `cA3`, init / fini, distribution,
tear-down) is `≤ K (W + d + NF + Q + kJ + λ + B + n + 1)^e` (`restC_pb`), and
`cECn + 2 ≤ cCS2 + restC`, `cTear + 2 ≤ restC` (`cECn_split`, `cTear_le`).

The proof never unfolds concrete expression sizes: `cT e W`, `cA W l`, `cLoop`, `cRd`,
`costL` get generic `PB` composition lemmas (sizes of fixed expressions are constants).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem leafV {m : ℕ} (i : Fin m) : ∀ v ∈ (Set.univ : Set (Fin m → ℕ)), v i ≤ sumV v :=
  fun v _ => Finset.single_le_sum (f := v) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)

namespace UB
variable {α : Type*} {S : Set α} {sz : α → ℕ}

theorem cost_pb {W N : α → ℕ} (hW : PB S sz W) (hN : PB S sz N) :
    ∀ i : Ins, NoEn i → PB S sz (fun a => Ins.cost (W a) (N a) i)
  | .a _ e, _ => by simp only [Ins.cost]; exact cT_pb _ hW
  | .rd _ e _, _ => by
    simp only [Ins.cost]
    exact PB.add (cT_pb _ hW) (cRd_pb hN (PB.add hW (PB.const 1)))
  | .pu _ e, _ => by simp only [Ins.cost]; exact cT_pb _ hW
  | .po _, _ => by simp only [Ins.cost]; (with_reducible repeat (first | exact J6Seg.PJ.PB.const _ | assumption | refine J6Seg.PJ.PB.add ?_ ?_ | refine J6Seg.PJ.PB.mul ?_ ?_ | refine J6Seg.PJ.PB.pow ?_ _ | refine J6Seg.PJ.PB.sub ?_ | refine J6Seg.PJ.PB.div ?_ | refine J6Seg.PJ.PB.sqrt ?_))
  | .en .., h => absurd h id

theorem costL_pb {W N : α → ℕ} (hW : PB S sz W) (hN : PB S sz N) :
    ∀ l : List Ins, (∀ i ∈ l, NoEn i) → PB S sz (fun a => costL (W a) (N a) l)
  | [], _ => by simp only [costL]; exact PB.const _
  | i :: l, h => by
    simp only [costL]
    exact PB.add (cost_pb hW hN i (h i (by simp))) (costL_pb hW hN l (fun j hj => h j (by simp [hj])))

end UB

open UB in
theorem cCPre_pb {α : Type*} {S : Set α} {sz : α → ℕ} (pkA pkC bA bC : ℕ) {W lam : α → ℕ}
    (hW : PB S sz W) (hl : PB S sz lam) :
    PB S sz (fun a => cCPre pkA pkC bA bC (W a) 0 (lam a)) := by
  unfold cCPre
  refine PB.add (costL_pb hW (PB.const 0) _ ?_) (PB.add (cLoop_pb hW hl (cA_pb hW _))
    (costL_pb hW (PB.const 0) _ ?_))
  · intro i hi; simp only [cPre1, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with h | h | h | h | h | h | h | h <;> subst h <;> trivial
  · intro i hi; simp only [cPre2, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with h | h <;> subst h <;> trivial

theorem restC_pb (pl : Plan6) : PB Set.univ sumV
    (fun v : Fin 8 → ℕ => restC pl (v 0) (v 1) (v 2) (v 3) (v 4) (v 5) (v 6) (v 7)) := by
  have h : ∀ i : Fin 8, PB Set.univ sumV (fun v : Fin 8 → ℕ => v i) := fun i => PB.var (leafV i)
  have hmid : PB Set.univ sumV (fun v : Fin 8 → ℕ => costL (v 0) 0 cMid) := by
    refine UB.costL_pb (h 0) (PB.const 0) _ ?_
    intro i hi; simp only [cMid, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with h | h | h | h | h | h | h | h | h <;> subst h <;> trivial
  have ha3 : PB Set.univ sumV (fun v : Fin 8 → ℕ => costL (v 0) 0 cA3) := by
    refine UB.costL_pb (h 0) (PB.const 0) _ ?_
    intro i hi; simp only [cA3, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with h | h | h | h | h <;> subst h <;> trivial
  have hdist : PB Set.univ sumV (fun v : Fin 8 → ℕ => cDistAll (v 6) (v 7)) := by
    have h6 := h 6; have h7 := h 7
    unfold cDistAll cMv cDist; (with_reducible repeat (first | exact J6Seg.PJ.PB.const _ | assumption | refine J6Seg.PJ.PB.add ?_ ?_ | refine J6Seg.PJ.PB.mul ?_ ?_ | refine J6Seg.PJ.PB.pow ?_ _ | refine J6Seg.PJ.PB.sub ?_ | refine J6Seg.PJ.PB.div ?_ | refine J6Seg.PJ.PB.sqrt ?_))
  have htear : PB Set.univ sumV (fun v : Fin 8 → ℕ => cTear (v 6) (v 7)) := by
    have h6 := h 6; have h7 := h 7
    unfold cTear; (with_reducible repeat (first | exact J6Seg.PJ.PB.const _ | assumption | refine J6Seg.PJ.PB.add ?_ ?_ | refine J6Seg.PJ.PB.mul ?_ ?_ | refine J6Seg.PJ.PB.pow ?_ _ | refine J6Seg.PJ.PB.sub ?_ | refine J6Seg.PJ.PB.div ?_ | refine J6Seg.PJ.PB.sqrt ?_))
  have hpar := cPar_pb pl.kA pl.kC pl.wA pl.wC (h 0) (h 1) (h 2) (h 3) (h 4)
  have hpre := cCPre_pb pl.pkA pl.pkC pl.bA pl.bC (h 0) (h 5)
  have hW := h 0
  unfold restC
  refine PB.add (PB.add (PB.add (PB.add (PB.add (PB.add (PB.add (PB.add ?_ hpar) hpre) hmid) ha3)
    ?_) hdist) htear) (PB.const _)
  · exact PB.const _
  · (with_reducible repeat (first | exact J6Seg.PJ.PB.const _ | assumption | refine J6Seg.PJ.PB.add ?_ ?_ | refine J6Seg.PJ.PB.mul ?_ ?_ | refine J6Seg.PJ.PB.pow ?_ _ | refine J6Seg.PJ.PB.sub ?_ | refine J6Seg.PJ.PB.div ?_ | refine J6Seg.PJ.PB.sqrt ?_))

theorem cECn_split (pl : Plan6) (W d NF Q lam R M nc B n : ℕ) :
    cECn pl W d NF Q lam R M nc B n + 2 ≤
      PreT.cCS2 Q R W lam M nc + restC pl W d NF Q (pl.kA * Q + pl.kC) lam B n := by
  simp only [cECn, cCcore, restC]; omega

theorem cTear_le (pl : Plan6) (W d NF Q kJ lam B n : ℕ) :
    cTear B n + 2 ≤ restC pl W d NF Q kJ lam B n := by
  simp only [restC]; omega

end J6Seg.PJ

end

