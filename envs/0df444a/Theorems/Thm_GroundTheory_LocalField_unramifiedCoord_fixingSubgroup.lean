theorem GroundTheory.LocalField.unramifiedCoord_fixingSubgroup (σ : L.fixingSubgroup) (n : ℕ+) :
    unramifiedCoord K (σ : Ω ≃ₐ[K] Ω) n =
      (residueDegree K L : ZMod n) * unramifiedCoord L (fixingSubgroupEquiv L σ) n := by sorry
