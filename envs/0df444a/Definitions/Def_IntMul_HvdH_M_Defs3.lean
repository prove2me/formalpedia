section
-- Source module: NLogN.HFW2
/-!
# Fermat-ring convolution machine, part 2: multi-axis transforms as levels

`mdif F axes` (and `mdit`) are recursive over the axes; the machine applies one *level* per
axis to the whole array: the array is cut into `pre` blocks of size `2^j · B` and `colMap` is
applied to every block.  `descs axes pre` lists the levels `(pre, j, E, B)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

/-- One level `(pre, j, E, B)`: `pre` blocks, `2^j` rows of `B` columns, root exponent `E`. -/
abbrev Desc := ℕ × ℕ × ℕ × ℕ

def descs : List (ℕ × ℕ) → ℕ → List Desc
  | [], _ => []
  | (j, E) :: rest, pre => (pre, j, E, Ref.blockSize rest) :: descs rest (pre * 2 ^ j)

/-- Apply `g E j` to the columns of every block of a level. -/
def lvl (g : ℕ → ℕ → List ℤ → List ℤ) (d : Desc) (A : List ℤ) : List ℤ :=
  (Ref.chunkL (2 ^ d.2.1 * d.2.2.2) A).flatMap (Ref.colMap d.2.1 d.2.2.2 (g d.2.2.1 d.2.1))

def lvls (g : ℕ → ℕ → List ℤ → List ℤ) (ds : List Desc) (A : List ℤ) : List ℤ :=
  ds.foldl (fun A d => lvl g d A) A

