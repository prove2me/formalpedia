-- Source module: Solutions.R6BitNBTch
/-!
# Round six, bit network: touched-wire counts of the stage words

`touchCnt W1F`, `touchCnt W2F < 2³²` (no overflow of the packed rank counts), structurally:
every op is a map of `mk`, a touch list has twice the gates, record ops are bounded by the
kernel-checked gate count `recs_gates` (`< 2²⁴`).
-/

set_option maxRecDepth 10000

namespace IntMul.Kappa.R6.Bit.NB

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

theorem touchCnt_app (A B : List LInstr) : touchCnt (A ++ B) = touchCnt A + touchCnt B := by
  rw [touchCnt_eq, touchCnt_eq, touchCnt_eq, List.map_append, List.sum_append]

theorem touchCnt_revI (X : List LInstr) : touchCnt (revI X) = touchCnt X := by
  rw [touchCnt_eq, touchCnt_eq, revI, List.map_map,
    show ((fun i : LInstr => i.2.1.length) ∘ fun i : LInstr => (i.1, i.2.1, i.2.2.reverse)) =
      fun i => i.2.1.length from rfl, List.map_reverse, List.sum_reverse]

theorem touch_len (el : List (ℕ × ℕ)) : (touch el).length = 2 * el.length := by
  induction el with
  | nil => rfl
  | cons p el ih =>
    simp only [touch, List.flatMap_cons, List.length_append, List.length_cons, List.length_nil] at ih ⊢
    omega

theorem touchCnt_mk {α : Type*} (l : List α) (c : α → ℕ) (el : α → List (ℕ × ℕ)) :
    touchCnt (l.map fun x => mk (c x) (el x)) = (l.map fun x => 2 * (el x).length).sum := by
  rw [touchCnt_eq, List.map_map]
  congr 1
  refine List.map_congr_left fun x _ => ?_
  show (touch (el x)).length = _
  rw [touch_len]

theorem touchCnt_le {α : Type*} (l : List α) (c : α → ℕ) (el : α → List (ℕ × ℕ)) (k : ℕ)
    (h : ∀ x ∈ l, (el x).length ≤ k) :
    touchCnt (l.map fun x => mk (c x) (el x)) ≤ l.length * (2 * k) := by
  rw [touchCnt_mk]
  induction l with
  | nil => simp
  | cons x l ih =>
    have h1 := ih (fun y hy => h y (List.mem_cons_of_mem _ hy))
    have h2 := h x List.mem_cons_self
    rw [List.map_cons, List.sum_cons, List.length_cons]
    nlinarith

theorem sum_flatMap_nat {α β : Type*} (l : List α) (g : α → List β) (F : β → ℕ) :
    ((l.flatMap g).map F).sum = (l.map fun x => ((g x).map F).sum).sum := by
  induction l with
  | nil => rfl
  | cons x l ih => rw [List.flatMap_cons, List.map_append, List.sum_append, ih, List.map_cons, List.sum_cons]

theorem foldl_add_eq {α : Type*} (l : List α) (g : α → ℕ) :
    l.foldl (fun a r => Nat.add a (g r)) 0 = (l.map g).sum := by
  have : ∀ a, l.foldl (fun a r => Nat.add a (g r)) a = a + (l.map g).sum := by
    induction l with
    | nil => intro a; simp
    | cons x l ih => intro a; rw [List.foldl_cons, ih]; simp [Nat.add_eq]; ring
  rw [this, zero_add]

/-- Total gates of the records. -/
theorem RG_lt : (recs.map fun r => (recEl r).length).sum < 16777216 := by
  have h := recs_gates
  rw [Nat.blt_eq, foldl_add_eq] at h
  exact h

theorem tc_mixF (c : ℕ → ℕ) : touchCnt (mixF c) < 33554432 := by
  unfold mixF
  rw [touchCnt_mk]
  have : (recs.map fun r => 2 * (recEl r).length).sum = 2 * (recs.map fun r => (recEl r).length).sum := by
    rw [List.sum_map_mul_left]
  rw [this]
  have := RG_lt
  omega

theorem tc_mixI (c : ℕ → ℕ) : touchCnt (mixI c) < 33554432 := by
  unfold mixI
  rw [touchCnt_mk]
  have : (recs.reverse.map fun r => 2 * (recEl r).reverse.length).sum =
      2 * (recs.map fun r => (recEl r).length).sum := by
    rw [List.map_reverse, List.sum_reverse, ← List.sum_map_mul_left]
    simp only [List.length_reverse]
  rw [this]
  have := RG_lt
  omega

theorem tc_mixFB (a b : ℕ) (c : ℕ → ℕ) : touchCnt (mixFB a b c) < 33554432 := by
  unfold mixFB
  rw [touchCnt_mk]
  have h1 : ((blkRecs a b).map fun r => 2 * (recEl r).length).sum =
      2 * ((blkRecs a b).map fun r => (recEl r).length).sum := by
    rw [List.sum_map_mul_left]
  have h2 : ((blkRecs a b).map fun r => (recEl r).length).sum ≤ (recs.map fun r => (recEl r).length).sum := by
    unfold blkRecs recs
    rw [sum_flatMap_nat, sum_flatMap_nat]
    exact List.Sublist.sum_le_sum (((List.take_sublist _ _).trans (List.drop_sublist _ _)).map _)
      (fun _ _ => Nat.zero_le _)
  rw [h1]
  have := RG_lt
  omega

theorem tc_scat (rd c : ℕ → ℕ) : touchCnt (scat rd c) ≤ 1771 * 6 := by
  unfold scat
  have := touchCnt_le (List.range NV) c (scatEl rd) 3 (fun T _ => by simp [scatEl, tri3])
  rw [List.length_range] at this
  simpa [NV] using this

theorem tc_injo (c : ℕ → ℕ) : touchCnt (injo c) ≤ 1771 * 6 := by
  unfold injo
  have := touchCnt_le (List.range NV) c (fun T => tri3.map fun k => (wY T, wS (injS T k))) 3
    (fun T _ => by simp [tri3])
  rw [List.length_range] at this
  simpa [NV] using this

theorem tc_copyo (c : ℕ → ℕ) : touchCnt (copyo c) ≤ 1771 * 2 := by
  unfold copyo
  have := touchCnt_le (List.range NV) c (fun t => [(wS (srcS t), wX t)]) 1 (fun T _ => by simp)
  rw [List.length_range] at this
  simpa [NV] using this

theorem tc_tcopy : touchCnt tcopy ≤ 23 * 2 := by
  unfold tcopy
  have := touchCnt_le (List.range 23) (fun c => cND (retN c)) (fun c => [(wT c, wS (retS c))]) 1
    (fun T _ => by simp)
  rw [List.length_range] at this
  simpa using this

theorem tc_sweep (a b f : ℕ) : touchCnt (sweepR a b f) ≤ b - a := by
  unfold sweepR
  rw [touchCnt_eq, List.map_map]
  have : ∀ x ∈ List.range' a (b - a), ((fun i : LInstr => i.2.1.length) ∘ fun q => ((f, [wS q], []) : LInstr)) x = 1 :=
    fun _ _ => rfl
  rw [List.map_congr_left this, List.map_const', List.sum_replicate, List.length_range', smul_eq_mul, mul_one]

theorem touchW1 : touchCnt W1F < 2 ^ 32 := by
  rw [show (2 : ℕ) ^ 32 = 4294967296 from rfl]
  have h0 := tc_mixF (fun _ => cLOW)
  have h1 := tc_scat rdS (fun _ => cLOW)
  have h2 := tc_injo (fun _ => cLOW)
  have h3 := tc_mixI (fun _ => cLOW)
  have h4 := tc_mixI (fun _ => cHIGH)
  have s0 : touchCnt (segW1 0) < 67108864 := by
    show touchCnt (copyo (fun t => cND (t + 1)) ++ mixFB 0 12 cND) < _
    rw [touchCnt_app]; have := tc_copyo (fun t => cND (t + 1)); have := tc_mixFB 0 12 cND; omega
  have s1 := tc_mixFB 12 24 cND
  have s2 := tc_mixFB 24 48 cND
  have s3 := tc_mixFB 48 72 cND
  have s4 := tc_mixFB 72 96 cND
  have s5 := tc_mixFB 96 120 cND
  have s6 := tc_mixFB 120 143 cND
  have s7 : touchCnt (segW1 7) < 1048576 := by
    show touchCnt ((tcopy ++ scat wT fun _ => cLOW) ++ injo cPT) < _
    rw [touchCnt_app, touchCnt_app]
    have := tc_tcopy; have := tc_scat wT (fun _ => cLOW); have := tc_injo cPT; omega
  have s8 : touchCnt (segW1 8) ≤ 20000 - 0 := tc_sweep 0 20000 cHIGH
  have s9 : touchCnt (segW1 9) ≤ NR - 20000 := tc_sweep 20000 NR cHIGH
  have s10 : touchCnt (segW1 10) ≤ 1771 * 2 := tc_copyo _
  have e1 : segW1 1 = mixFB 12 24 cND := rfl
  have e2 : segW1 2 = mixFB 24 48 cND := rfl
  have e3 : segW1 3 = mixFB 48 72 cND := rfl
  have e4 : segW1 4 = mixFB 72 96 cND := rfl
  have e5 : segW1 5 = mixFB 96 120 cND := rfl
  have e6 : segW1 6 = mixFB 120 143 cND := rfl
  simp only [W1F, touchCnt_app]
  rw [e1, e2, e3, e4, e5, e6]
  simp only [NR] at s9
  omega

theorem touchW2 : touchCnt W2F < 2 ^ 32 := by
  rw [show (2 : ℕ) ^ 32 = 4294967296 from rfl]
  have h0 := tc_mixF (fun _ => cLOW)
  have h1 := tc_scat rdS (fun _ => cLOW)
  have h2 := tc_injo (fun _ => cLOW)
  have h3 := tc_mixI (fun _ => cLOW)
  have h4 := tc_mixI (fun _ => cHIGH)
  have h5 := tc_copyo (fun _ => cHIGH)
  have s0 : touchCnt (segW2 0) < 1048576 := by
    show touchCnt (revI (injo cPT) ++ (tcopy ++ revI (scat wT fun _ => cLOW))) < _
    rw [touchCnt_app, touchCnt_app, touchCnt_revI, touchCnt_revI]
    have := tc_tcopy; have := tc_scat wT (fun _ => cLOW); have := tc_injo cPT; omega
  have s1 : touchCnt (segW2 1) < 33554432 := by
    show touchCnt (revI (mixFB 120 143 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s2 : touchCnt (segW2 2) < 33554432 := by
    show touchCnt (revI (mixFB 96 120 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s3 : touchCnt (segW2 3) < 33554432 := by
    show touchCnt (revI (mixFB 72 96 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s4 : touchCnt (segW2 4) < 33554432 := by
    show touchCnt (revI (mixFB 48 72 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s5 : touchCnt (segW2 5) < 33554432 := by
    show touchCnt (revI (mixFB 24 48 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s6 : touchCnt (segW2 6) < 33554432 := by
    show touchCnt (revI (mixFB 12 24 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s7 : touchCnt (segW2 7) < 33554432 := by
    show touchCnt (revI (mixFB 0 12 cND)) < _; rw [touchCnt_revI]; exact tc_mixFB _ _ _
  have s8 : touchCnt (segW2 8) < 1048576 := by
    show touchCnt (revI (copyo fun t => cND (t + 1)) ++ sweepR 0 20000 cLOW) < _
    rw [touchCnt_app, touchCnt_revI]
    have := tc_copyo (fun t => cND (t + 1)); have := tc_sweep 0 20000 cLOW; omega
  have s9 : touchCnt (segW2 9) ≤ NR - 20000 := tc_sweep 20000 NR cLOW
  simp only [W2F, touchCnt_app, touchCnt_revI]
  simp only [NR] at s9
  omega

end IntMul.Kappa.R6.Bit.NB

