theorem CF_u : CF dA f u a1 a2 a3 cn d cU = u := by simp (config := {decide := true}) [CF]
theorem CF_a1 : CF dA f u a1 a2 a3 cn d cA1 = a1 := by simp (config := {decide := true}) [CF]
theorem CF_a2 : CF dA f u a1 a2 a3 cn d cA2 = a2 := by simp (config := {decide := true}) [CF]
theorem CF_a3 : CF dA f u a1 a2 a3 cn d cA3 = a3 := by simp (config := {decide := true}) [CF]
theorem CF_cn : CF dA f u a1 a2 a3 cn d cN = cn := by simp (config := {decide := true}) [CF]
theorem CF_d : CF dA f u a1 a2 a3 cn d dA = d := by
  simp [CF, h.ne (j := cU) (by decide), h.ne (j := cA1) (by decide), h.ne (j := cA2) (by decide),
    h.ne (j := cA3) (by decide), h.ne (j := cN) (by decide)]

theorem CFu_u (v : List ℤ) : update (CF dA f u a1 a2 a3 cn d) cU v = CF dA f v a1 a2 a3 cn d := by
  funext i; by_cases e : i = cU
  · subst e; simp (config := {decide := true}) [CF]
  · simp [CF, update_of_ne e, e]
theorem CFu_a1 (v : List ℤ) : update (CF dA f u a1 a2 a3 cn d) cA1 v = CF dA f u v a2 a3 cn d := by
