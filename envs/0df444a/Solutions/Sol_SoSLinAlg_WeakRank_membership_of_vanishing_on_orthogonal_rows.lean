section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf
variable {n r : ℕ} (I J : Finset (Fin n))
alias mu_disj := SoSLinAlg.WeakRank.Dev.Leaf.PartT.mu_disj

/-- Column `|I| + q(j)`. -/
def dcol (hIJ : I.card + J.card ≤ r) (j : J) : Fin r :=
  ⟨I.card + pos J j.1, by have := pos_lt j.2; omega⟩

/-- `M j j' = y_{j, |I| + q(j')}`. -/
def Dmat (hIJ : I.card + J.card ≤ r) : Matrix J J (Poly n r) :=
  Matrix.of fun j j' => y j.1 (dcol I J hIJ j')

/-- The multiplier. -/
def D (hIJ : I.card + J.card ≤ r) : Poly n r := (Dmat I J hIJ).det

end SoSLinAlg.WeakRank.Dev.Leaf
end
