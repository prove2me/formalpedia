theorem range_comp_subset_of_locus {X K B T : Scheme.{u}} (q : X ⟶ B) (k : X ⟶ K)
    (S : Set ↥X) (U : Set ↥K)
    (h : ∀ b : ↥B, b ∈ (q.base '' (S \ k.base ⁻¹' U))ᶜ) (z : T ⟶ X)
    (hz : Set.range z.base ⊆ S) : Set.range (z ≫ k).base ⊆ U := by
  rintro _ ⟨τ, rfl⟩
  by_contra hτ
  exact (Set.mem_compl_iff _ _).mp (h (q.base (z.base τ))) ⟨z.base τ, ⟨hz ⟨τ, rfl⟩, hτ⟩, rfl⟩

theorem locus_of_range_comp_subset {X K B W : Scheme.{u}} (q : X ⟶ B) (k : X ⟶ K)
    (S : Set ↥X) (U : Set ↥K) (i : W ⟶ X) (hi : Set.range i.base = S)
    (h : Set.range (i ≫ k).base ⊆ U) (b : ↥B) : b ∈ (q.base '' (S \ k.base ⁻¹' U))ᶜ := by
  rw [Set.mem_compl_iff]
  rintro ⟨w, ⟨hwS, hwU⟩, _⟩
  rw [← hi] at hwS
  obtain ⟨w', rfl⟩ := hwS
  exact hwU (h ⟨w', rfl⟩)

end Loci
