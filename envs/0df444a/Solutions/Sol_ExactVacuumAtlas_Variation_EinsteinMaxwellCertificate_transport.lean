variable {n : ℕ}
theorem solution {U V : Set (Pt 4)} {Φ : Pt 4 → Pt 4}
    {J K : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ} {gV giV : Metric 4} {FV : TwoForm 4} {g gi : Metric 4}
    {F : TwoForm 4} (hc : CoordChange U V Φ J K) (hne : U.Nonempty)
    (hcert : EinsteinMaxwellCertificate gV giV FV V)
    (hg : ∀ y ∈ U, metricMatrix g y = (J y)ᵀ * metricMatrix gV (Φ y) * J y)
    (hgi : ∀ y ∈ U, metricMatrix gi y = K y * metricMatrix giV (Φ y) * (K y)ᵀ)
    (hF : ∀ y ∈ U, metricMatrix F y = (J y)ᵀ * metricMatrix FV (Φ y) * J y) :
    EinsteinMaxwellCertificate g gi F U := by
  have hm : MetricData gV giV V := ⟨hcert.isOpen, hcert.symm, hcert.inv, hcert.smooth, hcert.smooth_inv⟩
  have hmd := MetricData.transport hc hm hg hgi
  have hFe : ∀ y ∈ U, ∀ i j, F i j y = ∑ p, ∑ q, J y p i * J y q j * FV p q (Φ y) := by
    intro y hy i j
    have := congrFun (congrFun (hF y hy) i) j
    simp only [metricMatrix, Matrix.of_apply] at this
    rw [this, congr_entry]
    rfl
  refine
    { isOpen := hc.isOpen
      nonempty := hne
      symm := hmd.symm
      inv := hmd.inv
      smooth := hmd.smooth
      smooth_inv := hmd.smooth_inv
      smooth_F := ?_
      antisymm := ?_
      lorentz := ?_
      einstein := ?_
      maxwell := ?_
      closed := ?_ }
  · intro i j
    have hJs := hc.smoothOn_jac
    have hs : ContDiffOn ℝ ∞ (fun y => ∑ p, ∑ q, J y p i * J y q j * FV p q (Φ y)) U :=
      ContDiffOn.sum fun p _ => ContDiffOn.sum fun q _ =>
        ((hJs p i).mul (hJs q j)).mul ((hcert.smooth_F p q).comp hc.smooth hc.mapsTo)
    exact hs.congr fun y hy => hFe y hy i j
  · intro y hy i j
    rw [hFe y hy i j, hFe y hy j i, Finset.sum_comm, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [hcert.antisymm _ (hc.mapsTo hy) p q]
    ring
  · intro y hy
    rw [hg y hy]
    exact isLorentzian_pullback (hc.mul_inv y hy) (hcert.lorentz _ (hc.mapsTo hy))
  · intro y hy i j
    have := congrFun (congrFun (einsteinMaxwell_transform hc hm hg hgi hF hy) i) j
    rw [Matrix.of_apply] at this
    rw [this, congr_entry]
    simp [hcert.einstein _ (hc.mapsTo hy)]
  · intro y hy b
    rw [maxwellDiv_transform hc hm hcert.smooth_F hg hgi hF hy b]
    simp [hcert.maxwell _ (hc.mapsTo hy)]
  · intro y hy i j k
    rw [faradayCyclic_transform hc hcert.smooth_F hcert.antisymm hF hy i j k]
    simp [hcert.closed _ (hc.mapsTo hy)]
