-- title:
--   (4.17), p. 2727 — under a deviation with 𝔼∫|β¹|² ≤ A, the other states stay within c_A N^{−2/(d+4)} of the decoupled copies
-- statement:
--   This is the deviation estimate (4.17) in the proof of Theorem 4.2 of Carmona and Delarue.
--
--   Throughout, assumptions (A.1)–(A.7) are in force with constants $\lambda, c_L > 0$. Let $(X_t, Y_t, Z_t)_{0\le t\le T}$ be a solution of the McKean–Vlasov FBSDE (3.1) on a probability space $(\Omega_0, \mathbb P_0)$ carrying an $m$-dimensional Brownian motion, let $\mu_t = \mathbb P_{X_t}$ be its flow of marginal laws, and let $u : [0,T]\times\mathbb R^d \to \mathbb R^d$ be the associated FBSDE value function: for some $c \ge 0$, $|u(t,x)| \le c(1+|x|)$ and $|u(t,x)-u(t,x')| \le c|x-x'|$ for all $t \in [0,T]$, $x, x'$ (this is (3.3)), and $\mathbb P_0$-a.s., $Y_t = u(t, X_t)$ for all $t \in [0,T]$. Let $J$ be the optimal cost of the limiting mean-field problem (4.1),
--   $$J = \mathbb E\Big[g(X_T,\mu_T) + \int_0^T f\big(t, X_t, \mu_t, \hat\alpha(t, X_t, \mu_t, Y_t)\big)\,dt\Big].$$
--   On a probability space $(\Omega, \mathbb P)$ fix a sequence $(W^i)_{i\ge1}$ of independent $m$-dimensional Brownian motions. For $N \ge 1$, $(X^1,\dots,X^N)$ denotes a solution of the particle system (4.2),
--   $$dX^i_t = b\big(t, X^i_t, \bar\mu^N_t, \hat\alpha(t, X^i_t, \mu_t, u(t, X^i_t))\big)dt + \sigma\,dW^i_t,\quad X^i_0 = x_0,\quad \bar\mu^N_t = \frac1N\sum_{j=1}^N \delta_{X^j_t},$$
--   and $\bar\alpha^{N,i}_t = \hat\alpha(t, X^i_t, \mu_t, u(t, X^i_t))$ are the strategies (4.3). For a strategy profile $(\beta^1,\dots,\beta^N)$, $U^i$ are the states (4.5), $dU^i_t = b(t, U^i_t, \bar\nu^N_t, \beta^i_t)dt + \sigma dW^i_t$, $U^i_0 = x_0$, $\bar\nu^N_t = \frac1N\sum_j\delta_{U^j_t}$, and $\bar J^{N,i}(\beta^1,\dots,\beta^N) = \mathbb E[g(U^i_T, \bar\nu^N_T) + \int_0^T f(t, U^i_t, \bar\nu^N_t, \beta^i_t)dt]$ is the cost (4.6) to player $i$. Strategies are progressively measurable for the filtration generated by $(W^1,\dots,W^N)$.
--
--   Let player $1$ deviate: for a strategy $\beta^1$, progressively measurable for the filtration of $(W^1,\dots,W^N)$ with $\mathbb E\int_0^T|\beta^1_t|^2dt<\infty$, let $(U^1,\dots,U^N)$ solve (4.5) for the profile $(\beta^1,\bar\alpha^{N,2},\dots,\bar\alpha^{N,N})$, the other players keeping the processes $\bar\alpha^{N,j}$ computed from (4.2). Let $\bar X^i$ be the decoupled copies (as in (4.11)).
--
--   **Statement.** For every $A>0$ there is a constant $c_A$ such that for every $N\ge1$ and all such $\beta^1$, $(X^i)$, $(\bar X^i)$, $(U^i)$:
--   $$\mathbb E\int_0^T|\beta^1_t|^2dt\le A\implies\max_{2\le i\le N}\sup_{0\le t\le T}\mathbb E\big[|U^i_t-\bar X^i_t|^2\big]\le c_A\,N^{-2/(d+4)}.$$
--
--   A single deviating player with bounded energy moves the other players' states by at most $O(N^{-1/(d+4)})$ in $L^2$ from independent copies of the mean-field state.
--
--   **Formalization Note** The model, (A.1)–(A.7), $\hat\alpha$ and (3.1) are those of `ProbMFG.Nash.Model` and `ProbMFG.Nash.MFGSolution`; the game objects are those of `ProbMFG.Nash.Game`. Players are indexed by `Fin N`, so the paper's player $1$ is index $0$ and "$2 \le i \le N$" is "$i \ne 0$". The mean-field solution and the game live on two probability spaces; only $\mu$, $J$ and $u$ pass from the first to the second (the paper's "for convenience, we fix a sequence … of independent Brownian motions"). Beyond the page, the hypotheses include: $u$ jointly measurable in $(t,x)$ (the value function $u^\mu$ of Lemma 3.5 is measurable), and Borel measurability of $f$ and $g$ on $[0,T]\times\mathbb R^d\times\mathcal P_2\times\mathbb R^k$ and $\mathbb R^d\times\mathcal P_2$ (part of `Assumptions`), so that the expected costs are expectations of measurable integrands. Solutions of the SDEs are Itô processes in Peng's sense with almost surely continuous paths on $[0,T]$. All norms are Euclidean. Expectations of nonnegative quantities are lower Lebesgue integrals in $[0,\infty]$; costs are real expectations. $c_A$ is chosen after $A$ and before $N$. The deviating player is index $0$; "$2\le i\le N$" is "$i\ne0$".
-- source:
--   Carmona and Delarue, Probabilistic analysis of mean-field games, SIAM J. Control Optim. 51 (2013), p. 2727, (4.17)

import Mathlib
import Definitions.Def_ProbMFG_Nash_Game

open MeasureTheory
open scoped NNReal ENNReal

namespace ProbMFG.Nash

/-- (4.17), p. 2727: if player 1 (index 0) deviates with `𝔼∫₀ᵀ|β|² ≤ A`, then `max_{i ≥ 2} sup_t 𝔼|U^i_t − X̄^i_t|² ≤ c_A N^{-2/(d+4)}`. -/
theorem eq_4_17 {d m k : ℕ} (M : Model d m k) (lam cL : ℝ) (hA : Assumptions M lam cL)
    {Ω₀ : Type*} [MeasurableSpace Ω₀] (P₀ : Measure Ω₀) [IsProbabilityMeasure P₀]
    (W₀ : ℝ≥0 → Ω₀ → Fin m → ℝ) (hW₀ : Peng1990.SMP.IsStdBrownian P₀ W₀)
    (X Y : ℝ≥0 → Ω₀ → EuclideanSpace ℝ (Fin d))
    (Z : Fin m → ℝ≥0 → Ω₀ → EuclideanSpace ℝ (Fin d))
    (hXYZ : SolvesMKV M P₀ hW₀ X Y Z)
    (u : ℝ≥0 → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (hu : ∃ c ≥ (0 : ℝ), ∀ t ≤ M.T, ∀ x x' : EuclideanSpace ℝ (Fin d),
      ‖u t x‖ ≤ c * (1 + ‖x‖) ∧ ‖u t x - u t x'‖ ≤ c * ‖x - x'‖)
    (hu_meas : Measurable (fun p : ℝ≥0 × EuclideanSpace ℝ (Fin d) => u p.1 p.2))
    (hYu : ∀ᵐ ω ∂P₀, ∀ t ≤ M.T, Y t ω = u t (X t ω))
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ) (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i))
    (hind : ProbabilityTheory.iIndepFun (fun i ω t => Ws i t ω) P) :
    ∀ A : ℝ, 0 < A → ∃ cA : ℝ, ∀ (N : ℕ) (hN : 0 < N) (Xs Xbar Us : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) (β : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k)),
      IsParticleSystem M P hWs (lawFlow P₀ X) u N Xs → IsDecoupled M P hWs (lawFlow P₀ X) u N Xbar →
      Peng1990.SMP.L2F (playerFiltration P hWs N) P M.T β →
      IsGameState M P hWs N (Function.update (alphaBar M (lawFlow P₀ X) u Xs) ⟨0, hN⟩ β) Us →
      sqInt P M.T β ≤ ENNReal.ofReal A →
      ∀ i : Fin N, i ≠ ⟨0, hN⟩ → ∀ t ≤ M.T,
        ∫⁻ ω, ‖Us i t ω - Xbar i t ω‖ₑ ^ 2 ∂P ≤ ENNReal.ofReal (cA * (N : ℝ) ^ (-(2 : ℝ) / ((d : ℝ) + 4))) := by sorry

end ProbMFG.Nash
