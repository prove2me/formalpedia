-- Source module: Solutions.J6SegAKCost4
/-!
# `A`-axis costs 4: the numeric side conditions `AKCond` of the `A` kernel v2

For `p ≥ 64` (eventually true) and an `A` axis with the facts `AxANum`, **`akCond_at`** gives
`AKCond` at

* `B = 20p + 60`, `BH = Bk = b + 2`, `Lmax = 17 + 2W + (2W + 2H) + 2H` (the row length),
* `φ₁ = mulSup (2B)`, `φ₂ = mulSup (2 (b · 2n + 2))` with `n = 2W + 2H`,
* `Ka = Kr = Kc = (8p + 35) 2^{2p}` (`J6AILTab12`), `X₀ = 2^{p+2}`.

The exponential facts come from `2^16 p^4 ≤ 2^p` (`pow4_big`, `p ≥ 64`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.AC
open IntMul NLogN IntMul.Kappa.R6 J6Seg J6Seg.KR J6Seg.KR.AK J6Seg.Ax

theorem step4 {q : ℕ} (hq : 16 ≤ q) : (q + 1) ^ 4 ≤ 2 * q ^ 4 := by
  have h1 : 16 * q ^ 3 ≤ q ^ 4 := by
    calc 16 * q ^ 3 ≤ q * q ^ 3 := Nat.mul_le_mul_right _ hq
      _ = q ^ 4 := by ring
  have h2 : 16 * q ^ 2 ≤ q ^ 3 := by
    calc 16 * q ^ 2 ≤ q * q ^ 2 := Nat.mul_le_mul_right _ hq
      _ = q ^ 3 := by ring
  have h3 : 16 * q ≤ q ^ 2 := by
    calc 16 * q ≤ q * q := Nat.mul_le_mul_right _ hq
      _ = q ^ 2 := by ring
  nlinarith

theorem pow4_big {p : ℕ} (hp : 64 ≤ p) : 2 ^ 16 * p ^ 4 ≤ 2 ^ p := by
  induction p, hp using Nat.le_induction with
  | base => norm_num
  | succ q hq ih =>
    have := step4 (q := q) (by omega)
    calc 2 ^ 16 * (q + 1) ^ 4 ≤ 2 ^ 16 * (2 * q ^ 4) := Nat.mul_le_mul_left _ this
      _ = 2 * (2 ^ 16 * q ^ 4) := by ring
      _ ≤ 2 * 2 ^ q := Nat.mul_le_mul_left _ ih
      _ = 2 ^ (q + 1) := by ring

theorem zle {a W B : ℕ} (h : a < 2 ^ W) (hW : W ≤ B) : zsz (a : ℤ) ≤ B :=
  (zsz_le_of_lt (by simpa using h)).trans hW

theorem zabs {a : ℤ} {W : ℕ} (h : |a| ≤ 2 ^ W) : zsz a ≤ W + 1 := by
  apply zsz_le_of_lt
  have h1 : ((a.natAbs : ℕ) : ℤ) ≤ 2 ^ W := by rw [Int.natCast_natAbs]; exact h
  have h2 : a.natAbs ≤ 2 ^ W := by exact_mod_cast h1
  have h3 : 2 ^ W < 2 ^ (W + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

theorem tabsT_len (f : ℕ → List ℤ) (L : ℕ) (hf : ∀ q, (f q).length = L) :
    ∀ N, (tabsT f N).length = N * (L + 1)
  | 0 => by simp [tabsT]
  | N + 1 => by
    have ih := tabsT_len f L hf N
    simp only [tabsT, List.range_succ, List.flatMap_append, List.length_append] at ih ⊢
    rw [ih]; simp [segT, hf]; ring

/-! ## The big-number inequalities -/

/-- `2^Q (8p+35) 2^{2p} ≤ 2^{8p+16}`. -/
theorem ea_nat {p : ℕ} (hp : 64 ≤ p) :
    2 ^ J6A.QA p * ((8 * p + 35) * 2 ^ (2 * p)) ≤ 2 ^ (8 * p + 16) := by
  set q := p / 2 with hq
  have hq1 : 2 * q ≤ p := by omega
  have hq2 : p ≤ 2 * q + 1 := by omega
  have hQ : J6A.QA p + q = 6 * p := by unfold J6A.QA; omega
  have hu : 8 * p + 35 ≤ 2 ^ q := by
    have h6 : q - 6 < 2 ^ (q - 6) := Nat.lt_two_pow_self
    have e : 2 ^ q = 64 * 2 ^ (q - 6) := by
      rw [show (64 : ℕ) = 2 ^ 6 by norm_num, ← pow_add]; congr 1; omega
    rw [e]; omega
  calc 2 ^ J6A.QA p * ((8 * p + 35) * 2 ^ (2 * p)) ≤ 2 ^ J6A.QA p * (2 ^ q * 2 ^ (2 * p)) := by
        gcongr
    _ = 2 ^ (J6A.QA p + q + 2 * p) := by ring
    _ = 2 ^ (8 * p) := by rw [hQ]; ring
    _ ≤ 2 ^ (8 * p + 16) := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem e3_gen {A X n F : ℕ} (hA : 1 ≤ A) (hX : 1 ≤ X) (hn : 1 ≤ n)
    (h : 4 * n * A ^ 3 * X ≤ F) : A * (n * A * (A * X + 1) + 1) + 1 ≤ F := by
  have h1 : n * A ^ 2 ≤ n * A ^ 3 * X := by
    calc n * A ^ 2 = n * A ^ 2 * 1 * 1 := by ring
      _ ≤ n * A ^ 2 * A * X := by gcongr
      _ = n * A ^ 3 * X := by ring
  have h2 : A ≤ n * A ^ 3 * X := by
    calc A = 1 * A * 1 * 1 * 1 := by ring
      _ ≤ n * A * A * A * X := by gcongr
      _ = n * A ^ 3 * X := by ring
  have h3 : 1 ≤ n * A ^ 3 * X := hA.trans h2
  have e : A * (n * A * (A * X + 1) + 1) + 1 = n * A ^ 3 * X + n * A ^ 2 + A + 1 := by ring
  rw [e]; nlinarith

/-- The kernel bounds `e₂`, `e₃` with `A = (8p+35) 2^{2p}`, `X = 2^{p+2}`, `n ≤ 10p`. -/
theorem e3_nat {p n : ℕ} (hp : 64 ≤ p) (hn1 : 1 ≤ n) (hn : n ≤ 10 * p) :
    (8 * p + 35) * 2 ^ (2 * p) * (n * ((8 * p + 35) * 2 ^ (2 * p)) *
      ((8 * p + 35) * 2 ^ (2 * p) * 2 ^ (p + 2) + 1) + 1) + 1 ≤ 2 ^ (8 * p + 16) := by
  set u := 8 * p + 35 with hu
  have hu9 : u ≤ 9 * p := by omega
  have h4 := pow4_big hp
  apply e3_gen (Nat.mul_pos (by omega) (by positivity)) Nat.one_le_two_pow hn1
  have e : 4 * n * (u * 2 ^ (2 * p)) ^ 3 * 2 ^ (p + 2) = (16 * n * u ^ 3) * 2 ^ (7 * p) := by
    ring
  rw [e]
  have hc : 16 * n * u ^ 3 ≤ 2 ^ (p + 1) := by
    calc 16 * n * u ^ 3 ≤ 16 * (10 * p) * (9 * p) ^ 3 := by gcongr
      _ = 116640 * p ^ 4 := by ring
      _ ≤ 131072 * p ^ 4 := Nat.mul_le_mul_right _ (by norm_num)
      _ = 2 * (2 ^ 16 * p ^ 4) := by ring
      _ ≤ 2 * 2 ^ p := by gcongr
      _ = 2 ^ (p + 1) := by ring
  calc 16 * n * u ^ 3 * 2 ^ (7 * p) ≤ 2 ^ (p + 1) * 2 ^ (7 * p) := by gcongr
    _ = 2 ^ (8 * p + 1) := by ring
    _ ≤ 2 ^ (8 * p + 16) := Nat.pow_le_pow_right (by norm_num) (by omega)

theorem e2_le_e3 {A X n : ℕ} (hA : 1 ≤ A) :
    n * A * (A * X + 1) + 1 ≤ A * (n * A * (A * X + 1) + 1) + 1 := by
  have := Nat.le_mul_of_pos_left (n * A * (A * X + 1) + 1) hA
  omega

/-! ## The side conditions -/

theorem aTabG_length (p s t α H pk b q : ℕ) :
    (aTabG p s t α H pk b q).length =
      17 + 2 * J6A.WA p α H + (2 * J6A.WA p α H + 2 * H) + 2 * H := by
  simp only [aTabG, aKTab2, aHdr2, List.length_append, List.length_cons, List.length_nil,
    J6A.aTabA, J6A.rTabA, J6A.cTabA, List.length_map, List.length_range]
  ring

/-- **`AKCond` of one `A` axis.** -/
theorem akCond_at_sol_aux (P : Prm) {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (h : AxANum P n src D k)
    (hp64 : 64 ≤ pP6 P n) :
    let p := pP6 P n; let s := src k; let t := tF6 P n k; let α := αN6 P n; let H := HA6 P n
    let pk := pkA6 8 16 p; let b := bA6 17 40 p; let w := p + 2
    let f := Nat.log 2 (IntMul.HvdH.sWidth p α) + 3
    let pre := preT P n D k; let post := postT P n D k
    let WA := J6A.WA p α H
    AKCond p s t α H pk b w f pre post (mulSup (2 * (20 * p + 60)))
      (mulSup (2 * (b * (2 * (2 * WA + 2 * H)) + 2))) (20 * p + 60) (b + 2) (b + 2)
      (17 + 2 * WA + (2 * WA + 2 * H) + 2 * H) (aK0 p) (aK0 p) (aK0 p) (2 ^ (p + 2)) := by
  intro p s t α H pk b w f pre post WA
  have g := h.num
  have hT : pre * t * post = TP6 P n := g.tot
  have hpre : 1 ≤ pre := g.pre1
  have hpost : 1 ≤ post := g.post1
  have hsz := g.sizeT
  have htM : t = t / (16 * H) * 8 * (2 * H) := h.tM
  have hM0 : 0 < t / (16 * H) := h.M0
  have hH1 : 1 ≤ H := h.H1
  have hHp : H ≤ p := h.Hp
  have hWw : 2 * WA ≤ 8 * H := h.Ww
  have hf8 : 2 ^ f = 8 * H := h.f8
  set M := t / (16 * H) with hM
  set T := TP6 P n with hTd
  have hT2 : 2 * T < 2 ^ p := (Nat.lt_size_self _).trans_le (Nat.pow_le_pow_right (by norm_num) hsz)
  have hR : pre * (M * 8) * post * (2 * H) = T := by rw [← hT, htM]; ring
  have hpb : pk = 8 * p + 16 := rfl
  have hbb : b = 17 * p + 40 := rfl
  have hpp : p < 2 ^ p := Nat.lt_two_pow_self
  have h4 : 65536 * p ^ 4 ≤ 2 ^ p := by have := pow4_big hp64; norm_num at this; exact this
  have hsq : 360 * p ^ 2 < 2 ^ (p + 1) := by
    have : p ^ 2 ≤ p ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    have : 1 ≤ p ^ 4 := Nat.one_le_pow _ _ (by omega)
    rw [pow_succ 2 p]; omega
  have hp2 : p ≤ p ^ 2 := by
    calc p = p ^ 1 := (pow_one p).symm
      _ ≤ p ^ 2 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have zs : ∀ a : ℕ, a ≤ 360 * p ^ 2 → ∀ B, p + 1 ≤ B → zsz (a : ℤ) ≤ B :=
    fun a ha B hB => zle (by omega) hB
  have hn2 : 2 * WA + 2 * H ≤ 10 * p := by omega
  have hMp : 0 < M * 8 := by omega
  have hR1 : 1 ≤ M * 8 * post * (2 * H) := Nat.mul_pos (Nat.mul_pos hMp hpost) (by omega)
  have hpreT : pre ≤ T := by
    calc pre = pre * 1 := by ring
      _ ≤ pre * (M * 8 * post * (2 * H)) := by gcongr
      _ = T := by rw [← hR]; ring
  have hpostT : post ≤ T := by
    have : 1 ≤ pre * (M * 8) * (2 * H) := Nat.mul_pos (Nat.mul_pos hpre hMp) (by omega)
    calc post = 1 * post := by ring
      _ ≤ pre * (M * 8) * (2 * H) * post := by gcongr
      _ = T := by rw [← hR]; ring
  have hAT : pre * (M * 8) ≤ T := by
    have : 1 ≤ post * (2 * H) := Nat.mul_pos hpost (by omega)
    calc pre * (M * 8) = pre * (M * 8) * 1 := by ring
      _ ≤ pre * (M * 8) * (post * (2 * H)) := by gcongr
      _ = T := by rw [← hR]; ring
  have hncT : M * 8 ≤ T := by
    have : 1 ≤ pre := hpre
    calc M * 8 = 1 * (M * 8) := by ring
      _ ≤ pre * (M * 8) := by gcongr
      _ ≤ T := hAT
  -- the kernel bounds
  have hK0 : aK0 p = (((8 * p + 35) * 2 ^ (2 * p) : ℕ) : ℤ) := by unfold aK0; push_cast; ring
  have hX0 : (2 : ℤ) ^ (p + 2) = ((2 ^ (p + 2) : ℕ) : ℤ) := by push_cast; ring
  have hea : (2 : ℤ) ^ J6A.QA p * aK0 p ≤ 2 ^ pk := by
    rw [hK0, hpb]; exact_mod_cast ea_nat hp64
  have hE3 := e3_nat (p := p) hp64 (n := 2 * WA + 2 * H) (by omega) hn2
  have hE2 := hE3.trans' (e2_le_e3 (A := (8 * p + 35) * 2 ^ (2 * p)) (X := 2 ^ (p + 2))
    (n := 2 * WA + 2 * H) (Nat.mul_pos (by omega) (by positivity)))
  have hE1 : (8 * p + 35) * 2 ^ (2 * p) * 2 ^ (p + 2) + 1 ≤ 2 ^ (8 * p + 16) := by
    refine le_trans ?_ hE2
    have : 1 ≤ (2 * WA + 2 * H) * ((8 * p + 35) * 2 ^ (2 * p)) :=
      Nat.mul_pos (by omega) (Nat.mul_pos (by omega) (by positivity))
    have := Nat.le_mul_of_pos_left ((8 * p + 35) * 2 ^ (2 * p) * 2 ^ (p + 2) + 1) this
    linarith
  have hK0n : (0 : ℤ) ≤ aK0 p := by unfold aK0; positivity
  have hpk2 : (2 : ℤ) ^ pk = ((2 ^ (8 * p + 16) : ℕ) : ℤ) := by rw [hpb]; push_cast; rfl
  have hQ1 : (1 : ℤ) ≤ 2 ^ J6A.QA p := one_le_pow₀ (by norm_num)
  -- the header
  have hQp : J6A.QA p ≤ 6 * p := by unfold J6A.QA; omega
  have hjA : jA (2 * WA) (2 * H) ≤ 2 * (2 * WA + 2 * H) := by
    unfold jA; exact Nat.clog_le_of_le_pow (Nat.lt_two_pow_self).le
  have hbn : b * (2 * (2 * WA + 2 * H)) ≤ 360 * p ^ 2 := by
    have : b ≤ 18 * p := by omega
    calc b * (2 * (2 * WA + 2 * H)) ≤ 18 * p * (20 * p) := Nat.mul_le_mul this (by omega)
      _ = 360 * p ^ 2 := by ring
  have hBH : ∀ v ∈ aHdr2 (2 * WA) (2 * H) (8 * H) (J6A.QA p) pk b, zsz v ≤ b + 2 := by
    intro v hv
    simp only [aHdr2, List.mem_cons, List.not_mem_nil, or_false] at hv
    rcases hv with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · rw [zsz_two_pow]; omega
    · rw [zsz_two_pow]; omega
    · rw [zsz_two_pow]; omega
    · exact zs _ (by omega) _ (by omega)
    · exact zs _ (by omega) _ (by omega)
    · rw [zsz_two_pow]; omega
    · exact zs _ hbn _ (by omega)
    · rw [zsz_one]; omega
  have hpkz : ∀ a : ℤ, |a| ≤ 2 ^ J6A.QA p * aK0 p → zsz a ≤ b + 2 := by
    intro a ha
    have : |a| ≤ 2 ^ pk := ha.trans hea
    have := zabs this
    omega
  refine
    { Φ1 := fun x y hx hy => mulCostH_le_mulSup (by omega)
      Φ2 := fun x y hx hy => by
        have hx' : zsz x ≤ b * (2 * (2 * WA + 2 * H)) + 2 := hx
        have hy' : zsz y ≤ b * (2 * (2 * WA + 2 * H)) + 2 := hy
        exact mulCostH_le_mulSup (by omega)
      b1 := by omega
      n1 := by omega
      big := ?_
      w2 := hWw
      bk := by omega
      rl := fun q => by simp [J6A.rTabA]
      Ka0 := hK0n
      Kr0 := hK0n
      Kc0 := hK0n
      X00 := by positivity
      ta := fun q x hx => J6Seg.ATab.aTabA_bnd p s t α H q x hx
      tr := fun q x hx => J6Seg.ATab.rTabA_bnd p s t α H q x hx
      tc := fun q x hx => (J6Seg.ATab.cTabA_bnd p s t α H q x hx).trans
        (le_mul_of_one_le_left hK0n hQ1)
      ea := hea
      er := hea
      ec := hea
      e0 := ?_
      e1 := ?_
      e2 := ?_
      e3 := ?_
      Bz := by omega
      Bb := by omega
      PB := by omega
      Bc := zs _ (by omega) _ (by omega)
      BH' := hBH
      kB := by omega
      zw := zs _ (by omega) _ (by omega)
      zw' := zs _ (by omega) _ (by omega)
      zf := ?_
      zA := by
        show zsz ((pre * (M * 8) : ℕ) : ℤ) ≤ b + 2
        exact zle (W := p) (by omega) (by omega)
      zp := zle (W := p) (by omega) (by omega)
      zpre := zle (W := p) (by omega) (by omega)
      znc := by
        show zsz ((M * 8 : ℕ) : ℤ) ≤ b + 2
        exact zle (W := p) (by omega) (by omega)
      zm := ?_
      zN := ?_
      zT := ?_
      zL := zs _ (by omega) _ (by omega)
      w'B := by omega
      TBk := ?_
      TL := fun q hq => (aTabG_length p s t α H pk b q).le
      AB := ?_ }
  · -- big
    have e : 2 ^ (b - 1) = 2 ^ (p + 7) * 2 ^ (2 * pk) := by
      rw [← pow_add]; congr 1; omega
    rw [e]
    have : 4 * (2 * WA + 2 * H) < 2 ^ (p + 7) := by
      have : (2 : ℕ) ^ (p + 7) = 128 * 2 ^ p := by ring
      omega
    have h2 : 0 < 2 ^ (2 * pk) := by positivity
    calc 2 * (2 * (2 * WA + 2 * H)) * 2 ^ (2 * pk) = 4 * (2 * WA + 2 * H) * 2 ^ (2 * pk) := by ring
      _ < 2 ^ (p + 7) * 2 ^ (2 * pk) := Nat.mul_lt_mul_of_pos_right this h2
  · -- e0
    rw [hpb]; exact_mod_cast Nat.pow_le_pow_right (by norm_num) (by omega)
  · rw [hK0, hX0, hpk2]
    have := Nat.cast_le (α := ℤ) |>.2 hE1
    simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_one] using this
  · rw [hK0, hX0, hpk2]
    have := Nat.cast_le (α := ℤ) |>.2 hE2
    simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_one] using this
  · rw [hK0, hX0, hpk2]
    have := Nat.cast_le (α := ℤ) |>.2 hE3
    simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_one] using this
  · -- zf
    have : f < 2 ^ f := Nat.lt_two_pow_self
    exact zs _ (by omega) _ (by omega)
  · -- zm
    exact zs _ (by omega) _ (by omega)
  · -- zN
    show zsz ((2 * (pre * (M * 8) * post * 2 ^ f) : ℕ) : ℤ) ≤ b + 2
    have e : 2 * (pre * (M * 8) * post * 2 ^ f) = 8 * T := by
      rw [hf8, ← hR]; ring
    rw [e]
    have e2 : (2 : ℕ) ^ (p + 2) = 4 * 2 ^ p := by ring
    exact zle (W := p + 2) (by rw [e2]; omega) (by omega)
  · -- zT
    show zsz (((tabsT (aTabG p s t α H pk b) (M * 8)).length : ℕ) : ℤ) ≤ b + 2
    rw [tabsT_len _ _ (aTabG_length p s t α H pk b)]
    have hL : 17 + 2 * WA + (2 * WA + 2 * H) + 2 * H + 1 ≤ 38 * p := by omega
    have h38 : 38 * p < 2 ^ (p + 6) := by
      have : (2 : ℕ) ^ (p + 6) = 64 * 2 ^ p := by ring
      omega
    have : M * 8 * (17 + 2 * WA + (2 * WA + 2 * H) + 2 * H + 1) < 2 ^ (2 * p + 6) := by
      have e : (2 : ℕ) ^ (2 * p + 6) = 2 ^ p * 2 ^ (p + 6) := by ring
      rw [e]
      have hT' : T < 2 ^ p := by omega
      calc M * 8 * (17 + 2 * WA + (2 * WA + 2 * H) + 2 * H + 1) ≤ T * (38 * p) :=
            Nat.mul_le_mul hncT hL
        _ ≤ T * 2 ^ (p + 6) := Nat.mul_le_mul_left _ h38.le
        _ < 2 ^ p * 2 ^ (p + 6) := Nat.mul_lt_mul_of_pos_right hT' (by positivity)
    exact zle this (by omega)
  · -- TBk
    intro q hq a ha
    simp only [aTabG, aKTab2, List.mem_append] at ha
    rcases ha with ha | ha | ha | ha
    · exact hBH a ha
    · exact hpkz a (J6Seg.ATab.aTabA_bnd p s t α H q a ha)
    · exact hpkz a (J6Seg.ATab.rTabA_bnd p s t α H q a ha)
    · exact hpkz a ((J6Seg.ATab.cTabA_bnd p s t α H q a ha).trans
        (le_mul_of_one_le_left hK0n hQ1))
  · -- AB
    intro x hx z hz
    obtain ⟨h1, h2⟩ := hx z hz
    have c : ∀ a : ℤ, zsz a ≤ p + 2 → |a| ≤ 2 ^ (p + 2) := by
      intro a ha
      have h3 : a.natAbs < 2 ^ (p + 2) := zsz_le_iff.1 ha
      have h4 : ((a.natAbs : ℕ) : ℤ) ≤ ((2 ^ (p + 2) : ℕ) : ℤ) := by exact_mod_cast h3.le
      rw [Int.natCast_natAbs] at h4; push_cast at h4; exact h4
    exact ⟨c _ h1, c _ h2⟩

end J6Seg.AC

