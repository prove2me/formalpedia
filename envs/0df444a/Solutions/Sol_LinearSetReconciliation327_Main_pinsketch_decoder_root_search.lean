theorem rootSearchProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L Q0 Q1 B src : ℕ) (σ : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootSearchProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : 128 ≤ Q1) (hB : 128 ≤ B)
    (hQ0word : Q0 + t * cap ≤ 2 ^ E.W) (hQ1word : Q1 + t * cap ≤ 2 ^ E.W) (hBword : B + t ≤ 2 ^ E.W)
    (hQ0sep : QueueWorkspaceSeparated R U D C TB ZB cap Q0 t)
    (hQ1sep : QueueWorkspaceSeparated R U D C TB ZB cap Q1 t)
    (hdisj : Q0 + t * cap ≤ Q1 ∨ Q1 + t * cap ≤ Q0)
    (hQ0out : Q0 + t * cap ≤ B ∨ B + t ≤ Q0) (hQ1out : Q1 + t * cap ≤ B ∨ B + t ≤ Q1)
    (hmeta : (112 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W)
    (hsrc : 128 ≤ src) (hSword : src + cap ≤ 2 ^ E.W) (hSrcQ0 : src + cap ≤ Q0 ∨ Q0 + t * cap ≤ src)
    (hσ : σ ≠ 0) (hdeg : σ.natDegree ≤ t)
    (hc : RootConstants b R U D C TB ZB cap L m) (hσStored : PolynomialStored b m src cap σ)
    (hm75 : m 75 = src) (hm83 : m 83 = Q0) (hm107 : m 107 = Q1) (hm85 : m 85 = B) :
    Sem P E pc (pc + 4047) (boundaryState pc m)
      (fun k z => k ≤ ((rootNodeBudget cap L w + 83) * t + 193) * w +
          (17 * cap + 233) * t + 29 * cap + 407 ∧ ∃ m',
        z = boundaryState (pc + 4047) m' ∧ m' 100 = rootPositionFlag N ι (rootsByBasis b σ) ∧
        m' 101 = (rootsByBasis b σ).length ∧ m' 85 = B ∧
        OutputStored m' B (rootPositionList N ι (rootsByBasis b σ)) ∧
        (rootsByBasis b σ).length ≤ t ∧
        MemoryFrame (rootSearchWritable R U D C TB cap Q0 Q1 B t) m m') := by
  have hcapPos : 1 ≤ cap := by omega
  have htcap : t < cap := by omega
  have hm : cap ≤ t * cap := by simpa only [Nat.one_mul] using Nat.mul_le_mul_right cap ht
  have hQ1fit : Q1 < 2 ^ E.W := by omega
  have hkeepPos : ∀ f ∈ keepFactor σ, 0 < f.natDegree := by
    intro f hf
    obtain ⟨rfl, hne⟩ := (mem_keepFactor f σ).mp hf
    omega
  have hkeepMass : frontierMass (keepFactor σ) ≤ t := by rw [frontierMass_keep]; exact hdeg
  obtain ⟨hSeedAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hFactorAt, hOutputAt⟩ := At.seqStmt hRestAt
  have hSeed := rootSeedProcedure_spec b P E pc Q0 Q1 src cap t σ m hSeedAt (by omega) (by omega) ht hcapPos
    hQ0 hQ1fit hsrc hQ0word hSword hSrcQ0 (by omega) hσStored hm75 hm83 hm107 hc.capacity
  obtain ⟨_, k1, z1, hRun1, hPc1, hCost1, m1, hz1, hQueue1, h831, h841, h891, hf01raw⟩ := hSeed
  have hf01 : MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) m m1 :=
    hf01raw.mono (root_seed_writable_le_basis R U D C TB cap Q0 Q1 t)
  have hc1 := hc.of_basis_frame hl hQ0 hQ1 hQ0sep.QZ hQ1sep.QZ hf01
  have hSeedExact : Sem P E pc (pc + 317) (boundaryState pc m)
      (fun k z => k ≤ 29 * cap + 275 ∧ z = boundaryState (pc + 317) m1) :=
    ⟨rfl, k1, z1, hRun1, hPc1, hCost1, hz1⟩
  have hFactor := rootFactorProcedure_spec b ι t N P E (pc + 317) R U D C TB ZB cap L Q0 Q1 (keepFactor σ) m1 hFactorAt
    hw hW hdet ht hL hcap hl hwords hQ0 hQ1 hQ0word hQ1word hQ0sep hQ1sep hdisj hmeta hkeepPos hkeepMass hc1 hQueue1 h831 h841 h891
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, m2, hz2, BQ, QB, fs, horder, hv2, hpos2, hmass2, hforest, hf12⟩ := hFactor
  have hf02 := MemoryFrame.trans hf01 hf12
  have hgeometry : 128 ≤ BQ ∧ BQ + t * cap ≤ 2 ^ E.W ∧ (BQ + t * cap ≤ B ∨ B + t ≤ BQ) := by
    rcases horder with horder | horder
    · simpa only [horder.1] using And.intro hQ0 (And.intro hQ0word hQ0out)
    · simpa only [horder.1] using And.intro hQ1 (And.intro hQ1word hQ1out)
  have hm285 : m2 85 = B :=
    (hf02 85 (hl.basis_meta_readonly hQ0 hQ1 85 (by norm_num)
      (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta]))).trans hm85
  have hOutput := rootOutputProcedure_spec b ι t N P E (pc + 3697) BQ cap B t fs m2 hOutputAt hw hW hdet (by omega) hN
    (by omega) htcap hgeometry.1 hgeometry.2.1 hB hBword hgeometry.2.2 hpos2 hmass2 hv2.queue hv2.oldBase hm285
    hv2.constants.dimension hv2.constants.capacity hv2.count
  have hFactorExact : Sem P E (pc + 317) (pc + 3697) (boundaryState (pc + 317) m1)
      (fun k z => k ≤ ((rootNodeBudget cap L w + 83) * t + 193) * w + 46 ∧ z = boundaryState (pc + 3697) m2) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hForest : rootForest w [] fs = rootsByBasis b σ := by
    rw [hforest, rootForest_keep]
    rfl
  have hlen := frontier_length_le_mass fs hpos2
  have hlenBound : fs.length ≤ t := le_trans hlen hmass2
  have hCostBound := Nat.mul_le_mul_left (17 * cap + 233) hlenBound
  have hFull := Sem.seq_bound hSeedExact (fun z _ hz => by
    subst z
    exact Sem.seq_bound hFactorExact (fun z _ hz => by subst z; exact hOutput))
  refine Sem.mono hFull ?_
  intro k z hQ
  obtain ⟨hk, m3, hz3, hv3, hf23⟩ := hQ
  refine ⟨by omega, m3, hz3, ?_, ?_, hv3.outputBase, ?_, le_trans (rootsByBasis_sound b σ hσ).2.2 hdeg, ?_⟩
  · simpa only [hForest] using hv3.flag
  · simpa only [hForest] using hv3.count
  · simpa only [hForest] using hv3.output
  · exact MemoryFrame.trans (hf02.mono (fun _ ha => Or.inl ha)) (hf23.mono (fun _ ha => Or.inr ha))

theorem decoderRows_root (t : ℕ) :
    RootWorkspace (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderRowBase t 5) (decoderCapacity t) := by
  have hc := decoderCapacity_pos t
  constructor
  · constructor <;> dsimp [decoderRowBase, decoderSavedBase] <;> omega
  all_goals dsimp [decoderRowBase, decoderSavedBase] <;> omega

theorem decoderRows_root_words (E : RAMEnv) (t : ℕ) (hword : decoderAllocEnd t ≤ 2 ^ E.W) :
    RootWords E (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderRowBase t 5) (decoderCapacity t) :=
  ⟨decoderRow_word E t 0 (by norm_num) hword, decoderRow_word E t 6 (by norm_num) hword,
   decoderRow_word E t 1 (by norm_num) hword, decoderRow_word E t 7 (by norm_num) hword,
   decoderRow_word E t 4 (by norm_num) hword, decoderRow_word E t 5 (by norm_num) hword⟩

theorem decoderQueue0_root_separated (t : ℕ) :
    QueueWorkspaceSeparated (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderRowBase t 5) (decoderCapacity t) (decoderQueue0 t) t :=
  ⟨Or.inr (decoderRow_end_le_queue t 0 (by norm_num)), Or.inr (decoderRow_end_le_queue t 6 (by norm_num)),
   Or.inr (decoderRow_end_le_queue t 1 (by norm_num)), Or.inr (decoderRow_end_le_queue t 7 (by norm_num)),
   Or.inr (decoderRow_end_le_queue t 4 (by norm_num)), Or.inr (decoderRow_end_le_queue t 5 (by norm_num))⟩

theorem decoderQueue1_root_separated (t : ℕ) :
    QueueWorkspaceSeparated (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderRowBase t 5) (decoderCapacity t) (decoderQueue1 t) t := by
  have hQ : decoderQueue0 t ≤ decoderQueue1 t := by unfold decoderQueue1; omega
  have hr (k : ℕ) (hk : k < 8) : decoderRowBase t k + decoderCapacity t ≤ decoderQueue1 t :=
    le_trans (decoderRow_end_le_queue t k hk) hQ
  exact ⟨Or.inr (hr 0 (by norm_num)), Or.inr (hr 6 (by norm_num)), Or.inr (hr 1 (by norm_num)),
    Or.inr (hr 7 (by norm_num)), Or.inr (hr 4 (by norm_num)), Or.inr (hr 5 (by norm_num))⟩

theorem rootSearch_saved_readonly (t j : ℕ) (hj : j < 2 * t) :
    ¬ rootSearchWritable (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderCapacity t) (decoderQueue0 t) (decoderQueue1 t) (decoderOutputBase t) t (decoderSavedBase t + j) := by
  dsimp [rootSearchWritable, rootBasisWritable, rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta,
    rootComputeWritable, rootEmissionWritable, rootEmissionMeta, decoderRowBase, decoderSavedBase, decoderQueue0, decoderQueue1, decoderOutputBase]
  omega

theorem rootSearch_preserved_meta {t : ℕ} {m m' : ℕ → ℕ}
    (hf : MemoryFrame (rootSearchWritable (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
      (decoderRowBase t 4) (decoderCapacity t) (decoderQueue0 t) (decoderQueue1 t) (decoderOutputBase t) t) m m')
    (slot : ℕ) (hs : slot < 128) (hBasis : ¬ rootBasisMeta slot) (hEmission : ¬ rootEmissionMeta slot) : m' slot = m slot := by
  apply hf
  intro ha
  rcases ha with hb | he
  · exact (decoderRows_root t).basis_meta_readonly (decoderRow_low t 8)
      (by have hq := decoderRow_low t 8; unfold decoderQueue1 decoderQueue0; omega) slot hs hBasis hb
  · exact emission_meta_readonly (decoderOutputBase t) t slot (by
      have hq := decoderRow_low t 8
      unfold decoderOutputBase decoderQueue1 decoderQueue0
      omega) hs hEmission he

