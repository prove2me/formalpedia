    exact R4
  · have : (F + e - F + 2) * (NLogN.KFN.levA W 0).length ≤ (e + 2) * W := Nat.mul_le_mul (by omega) hlev
    exact B4.mono (by omega)
  · have F2 : NLogN.IRuns I iprog (code x) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs1 ++ l)))
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs2 ++ l))) (cost x) := by
