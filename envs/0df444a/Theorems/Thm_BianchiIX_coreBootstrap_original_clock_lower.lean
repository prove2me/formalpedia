open BianchiIX

theorem BianchiIX.coreBootstrap_original_clock_lower {k m u v w : ℝ} (hk : 6 ≤ k)
    (hr : 99 / 100 * k ≤ coreRadius m v ∧ coreRadius m v ≤ 101 / 100 * k)
    (hv : 0 ≤ v) (hu : 0 ≤ u ∧ u ≤ (1 / 10000) / k)
    (hw : 0 ≤ w ∧ w ≤ (1 / 10000) / k) :
    1 / k ≤ (6 / projectiveDenom m u v w) * coreRadius m v * coreClockFactor (coreRadius m v) u w := by sorry
