        (profile 1).2 2 ⟨0, shapeEquiv s⟩ w else 0
    split_ifs with hc
    · exact (mme_released_global_profile_word_row 1 2 s w).symm
    · simp
  have hi (j : Fin 9) (w : Word) : (x (Sum.inr j) w : ℝ) =
      ∑ c : Shape, if ¬ yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, c⟩ ∧ c.val 2 = j then
