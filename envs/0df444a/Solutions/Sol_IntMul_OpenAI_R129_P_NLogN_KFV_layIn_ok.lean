theorem applyN_append (o1 o2 : List LOp) (a : List ℕ) :
    applyN (o1 ++ o2) a = applyN o2 (applyN o1 a) := by
  unfold applyN; rw [List.foldl_append]

theorem applyN_bm (A B X E : List ℕ) :
    applyN (bmOps A.length B.length X.length) (A ++ (B ++ (X ++ E))) = A ++ (X ++ (B ++ E)) := by
  unfold applyN bmOps
  rw [List.foldl_map]
  have e : ∀ t, (LOp.mv (A.length + t) (A.length + t + B.length)).idx =
      rotIdx (A.length + t) B.length 1 := fun t => by
    simp only [LOp.idx, Nat.add_sub_cancel_left]
  simp only [e]
  rw [rot_as_moves A.length B.length X.length _ (by simp; omega), permIdx_rot]

theorem applyN_gen : ∀ (xs : List (List ℕ × List ℕ × List ℕ)) (Ta Ra E : List ℕ),
    applyN (genOps Ta.length Ra.length xs) (Ta ++ (Ra ++ (xs.flatMap trip ++ E))) =
      Ta ++ (xs.flatMap tOf ++ (Ra ++ (xs.flatMap uvOf ++ E)))
  | [], Ta, Ra, E => by simp [genOps, applyN]
  | (U, T, V) :: xs, Ta, Ra, E => by
    simp only [genOps, applyN_append]
    have h1 : Ta ++ (Ra ++ (((U, T, V) :: xs).flatMap trip ++ E)) =
        Ta ++ ((Ra ++ U) ++ (T ++ (V ++ (xs.flatMap trip ++ E)))) := by
      simp [trip, List.append_assoc]
    rw [h1, show Ra.length + U.length = (Ra ++ U).length by simp, applyN_bm]
    have h2 : Ta ++ (T ++ ((Ra ++ U) ++ (V ++ (xs.flatMap trip ++ E)))) =
        (Ta ++ T) ++ ((Ra ++ U ++ V) ++ (xs.flatMap trip ++ E)) := by simp
    rw [h2, show Ta.length + T.length = (Ta ++ T).length by simp,
      show (Ra ++ U).length + V.length = (Ra ++ U ++ V).length by simp; omega, applyN_gen xs]
    simp [tOf, uvOf, List.append_assoc]

section Paper

variable (D ℓ K : ℕ) (long : Fin D → Bool)

theorem range_add_rev_map (f : ℕ → ℕ) (b Q : ℕ) :
    (List.range (b + Q)).reverse.map f =
      (List.range Q).reverse.map (fun t => f (b + t)) ++ (List.range b).reverse.map f := by
  rw [List.range_add, List.reverse_append, List.map_append, ← List.map_reverse, List.map_map]
  rfl

theorem axis_split (hK : 0 < K) (hℓ : 1 ≤ ℓ) (i : Fin D) :
    (List.range (Synth.al D ℓ long i)).reverse.map (nm D i) =
      topS D ℓ long i ++ (restA D ℓ K i ++ loS D ℓ K 0 i) := by
  have hq : ℓ - 1 = bb ℓ K + Synth.qq ℓ K * K := by
    unfold bb Synth.qq; rw [Nat.mul_comm]; exact (Nat.mod_add_div _ _).symm
  have e1 : (List.range (ℓ - 1)).reverse.map (nm D i) = restA D ℓ K i ++ loS D ℓ K 0 i := by
    rw [hq, range_add_rev_map]; simp [restA, loS]
  unfold Synth.al topS
  by_cases hl : long i
  · simp only [hl, if_true]
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
    simp only [Nat.add_sub_cancel] at e1 ⊢
    rw [List.range_succ, List.reverse_append, List.map_append, e1]
    simp
  · simp only [hl, Bool.false_eq_true, if_false, List.nil_append]
    exact e1

