  intro hcon
  have hseam := D.placeOfPoint_geomMorph Q
  rw [hcon, Point.zero_def, placeOfPoint_zero] at hseam
  have hxmem : polyToFunctionField W X
      ∈ ((placeOfPoint Q).restrictAlong D.ι D.hι).toValuationSubring :=
