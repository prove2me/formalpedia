lemma selectedDyadicCutoff_active {ι : Type*} [Fintype ι] {Q : Set (ι→ℕ)} {x : ι→ℝ}
    (h : selectedDyadicCutoff Q x≠0) : ∃k∈Q,0<dyadicMultiFactor k x := by
