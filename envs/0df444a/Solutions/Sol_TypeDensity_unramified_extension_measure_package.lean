  obtain ⟨d, l, hdvr, hmax, -, hcomp, hfin, hcard⟩ := TypeDensity.unramified_is_dvr O Φ hΦ
  obtain ⟨h1, h2, h3, h4, h5, -⟩ := TypeDensity.power_coordinates_transport O Φ hΦ.1 hτ hmeas
  have hadic := TypeDensity.power_coordinates_isAdic O Φ hΦ.1 hτ htop
  have hdeg : 0 < Φ.natDegree := by
    have := (TypeDensity.unramified_free_module O Φ hΦ.1).2.2
    have hf : Module.finrank O (AdjoinRoot Φ) ≠ 0 := by
      have : Nontrivial (AdjoinRoot Φ) := d.toNontrivial
      have := (TypeDensity.unramified_free_module O Φ hΦ.1).1
      have := (TypeDensity.unramified_free_module O Φ hΦ.1).2.1
      exact Module.finrank_pos.ne'
    omega
  have hinj : Function.Injective (algebraMap O (AdjoinRoot Φ)) := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    have hm : ∀ L : ℕ, c ∈ (IsLocalRing.maximalIdeal O)^L := fun L =>
      (TypeDensity.base_ideal_pure O Φ hΦ.1 hdeg L c).1 (by rw [hc]; exact Ideal.zero_mem _)
