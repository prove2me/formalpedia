        rw [h6]
        exact R.toAddSubgroup.add_mem hmem (R.toAddSubgroup.sub_mem (hBR b hb) (hBR b' hb'))
      obtain ⟨x, _, hx⟩ := D.repsA.2 ρ' (hAL ρ' hρ')
      have e1 := hx ρ ⟨hρ, h5⟩
      have e2 := hx ρ' ⟨hρ', by rw [sub_self]; exact R.toAddSubgroup.zero_mem⟩
