-- title:
--   Eq. (58) — $E\{\|x_{k+1}-x^*\|^2\mid\mathcal F_k\}\le\|x_k-x^*\|^2-\frac{2\alpha_k}{m}(F(x_k)-F^*)+5\alpha_k^2c^2$
-- statement:
--   Consider problem (5)–(6): $X\subseteq\mathbb R^n$ nonempty closed convex, $f_i,h_i:\mathbb R^n\to\mathbb R$ convex, $F=\sum_{i=1}^m(f_i+h_i)$. Let $x_k$ be generated by one of the randomized incremental methods (42), (43), (44) with positive stepsizes $\alpha_k$ from a starting point $x_0\in\mathbb R^n$, where the component $\omega_k$ used at iteration $k$ is uniformly distributed over $\{1,\dots,m\}$ and independent of the past history $\mathcal F_k=\{x_k,z_{k-1},x_{k-1},\dots,z_0,x_0\}$ (Assumption 3(a)/4(a)), and let Assumption 3(b) (for (42), (43)) or Assumption 4(b) (for (44)) hold with the constant $c$.
--
--   Then for every optimal solution $x^*\in X^*$ and every $k\ge0$, almost surely,
--   $$E\{\|x_{k+1}-x^*\|^2\mid\mathcal F_k\}\le\|x_k-x^*\|^2-\frac{2\alpha_k}{m}\bigl(F(x_k)-F^*\bigr)+\beta\alpha_k^2c^2,\qquad\beta=5.$$
--
--   This is the conditional descent inequality (58) of the proof of Proposition 9, i.e. Eq. (50) of the proof of Proposition 7 with the constant stepsize $\alpha$ replaced by $\alpha_k$ and $y$ by $x^*$. It is the input to the supermartingale convergence theorem (Proposition 2).
--
--   **Formalization Note** The statement is for all $k$, as in the paper, including $k=0$ with a starting point $x_0\notin X$. Since $x^*\in X^*$, $F^*=F(x^*)$ is finite and is written as $F(x^*)$. The conditional expectation is with respect to the $\sigma$-algebra generated by $x_0,\dots,x_k$ and $z_0,\dots,z_{k-1}$. The setting hypotheses (the would-be step at $k$ is $\mathcal F_k$-measurable, the iterates are measurable, $x_0$ is a fixed vector) are those of the definition file; components are indexed $0,\dots,m-1$.
-- source:
--   Bertsekas, Incremental Proximal Methods for Large Scale Convex Optimization, LIDS-P-2847 (rev. March 2011), p. 21, §4.2, proof of Prop. 9, Eq. (58) (cf. Eq. (50), p. 17, β = 5)

import Mathlib
import Definitions.Def_IncProx_Randomized_Basic

namespace IncProx.Randomized

open Filter Topology MeasureTheory

/-- Eq. (58) (proof of Proposition 9, p. 21; cf. (50), p. 17, β = 5): for every optimal x* ∈ X*
and every k ≥ 0, E{‖x_{k+1} − x*‖² | F_k} ≤ ‖x_k − x*‖² − (2α_k/m)(F(x_k) − F*) + 5α_k²c². -/
theorem eq58 {Ω : Type*} [MeasurableSpace Ω] {n m : ℕ} [NeZero m]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (P : Problem n m) (hP : P.Standing) (A : Alg)
    (α : ℕ → ℝ) (hαpos : ∀ k, 0 < α k) (ω : ℕ → Ω → Fin m) (x : ℕ → Ω → Vec n)
    (zc gFc gHc xc : ℕ → Fin m → Ω → Vec n) (x₀ : Vec n) (c : ℝ)
    (hR : RandHyp μ P A α ω x zc gFc gHc xc x₀ c)
    (xs : Vec n) (hxs : xs ∈ P.Xstar) (k : ℕ) :
    μ[fun s => ‖x (k + 1) s - xs‖ ^ 2 | hist x (zOf ω zc) k] ≤ᵐ[μ]
      fun s => ‖x k s - xs‖ ^ 2 - 2 * α k / m * (P.F (x k s) - P.F xs) + 5 * α k ^ 2 * c ^ 2 := by sorry

end IncProx.Randomized
