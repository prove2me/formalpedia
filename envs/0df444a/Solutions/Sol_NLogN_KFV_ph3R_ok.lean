namespace NLogN.KFV

open Synth AModel AModelL12

theorem runArrR_append {α : Type*} (n : ℕ) (d : α) (a b : List LOp) (xs : List α) :
    runArrR n d (a ++ b) xs = runArrR n d a (runArrR n d b xs) := by
  simp [runArrR, List.reverse_append, List.foldl_append]

theorem iterL_succ' {α : Type*} (F : ℕ → α → α) :
    ∀ (N : ℕ) (x : α), NLogN.KFV.iterL F (N + 1) x = NLogN.KFV.iterL (fun k => F (k + 1)) N (F 0 x)
  | 0, x => rfl
  | N + 1, x => by
    show F (N + 1) (NLogN.KFV.iterL F (N + 1) x) = F (N + 1) (NLogN.KFV.iterL (fun k => F (k + 1)) N (F 0 x))
    rw [iterL_succ' F N x]

/-- **A `flatMap` schedule backwards is a loop over the reversed index.** -/
theorem runArrR_flatMap_range {α : Type*} (n : ℕ) (d : α) (g : ℕ → List LOp) :
    ∀ (N : ℕ) (xs : List α), runArrR n d ((List.range N).flatMap g) xs =
      NLogN.KFV.iterL (fun k => runArrR n d (g (N - 1 - k))) N xs
  | 0, xs => rfl
  | N + 1, xs => by
    rw [List.range_succ, List.flatMap_append, runArrR_append, runArrR_flatMap_range n d g N,
      iterL_succ']
    have e1 : (fun k => runArrR n d (g (N + 1 - 1 - (k + 1)))) =
        fun k => runArrR (α := α) n d (g (N - 1 - k)) := by
      funext k; rw [show N + 1 - 1 - (k + 1) = N - 1 - k by omega]
    rw [e1, show N + 1 - 1 - 0 = N by omega]
    simp

end NLogN.KFV

end

