/-! ### Answers of an inadmissible form -/

theorem MIPStarRE.QPBT.honestPairMeasurement_effect_eq_zero (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (z : _root_.MIPStarRE.QPBT.PauliSpace P) {a : _root_.MIPStarRE.QPBT.PauliAnswer P}
    (ha : _root_.MIPStarRE.QPBT.validPauliAnswer .pair a = false) :
    (_root_.MIPStarRE.QPBT.honestPairMeasurement P z).effect a = 0 := by sorry
