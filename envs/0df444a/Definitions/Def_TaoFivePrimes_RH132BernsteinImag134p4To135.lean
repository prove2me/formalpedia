noncomputable def chooseFast (n k : ℕ) : ℕ :=
  if k≤n then n.factorial/(k.factorial*(n-k).factorial) else 0
noncomputable def transform (n : ℕ) (a : Fin (n+1) → ℚ) (i : Fin (n+1)) : ℚ :=
  ∑ j : Fin (n+1), a j*(chooseFast i j:ℚ)/chooseFast n j

