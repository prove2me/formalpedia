      have hNgt : 1 < Nat.card ↥N := by
        have : Nontrivial ↥N := (Subgroup.nontrivial_iff_ne_bot N).mpr hNne
        exact Finite.one_lt_card_iff_nontrivial.mpr this
      have hlt : Nat.card (G ⧸ N) < n := by
        rw [← hn, hGcard]
        exact (Nat.lt_mul_iff_one_lt_right Nat.card_pos).mpr hNgt
