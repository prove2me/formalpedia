theorem TranslationCollisionSwitching.high_good_plan_card_bound (start : OrientedEdge G) (k : ℕ)
    (hd : 3 ≤ d)
    (hhigh : 1048576 * d ^ 2 * Fintype.card V ≤ k ^ 2)
    (hkn : k < Fintype.card V) :
    Nat.card (GoodOmega d G hG start k) * k ^ 2 ≤
      1024 * d ^ 2 * Fintype.card V * Nat.card (RotationSystem d V) := by sorry
