theorem solution (mu beta : ℝ) :
    VacuumCertificate (gEF5 mu beta) (giEF5 mu beta) domU5 ↔ beta = 0 := by
  constructor
  · intro h
    have h33 := h.ricci_flat samplePtEF5 samplePtEF5_mem 3 3
    rw [ricci_33 mu beta samplePtEF5_mem] at h33
    simp only [samplePtEF5, show (1 : Fin 5).val = 1 from rfl,
