-- Source module: Solutions.KFY1Pad
/-!
# KFY 1: the padded line passes (math side)

The machine keeps the array in the padded box `∏ t_i` on every axis (so that the axis rotations of
`TransNeed` always see the shapes `shPad h bs`). Axis by axis it applies

* **`A`**: a `t_i`-line `X` (only its first `s_i` entries are read) ↦ `sapL p s_i t_i α X`
  (`t_i` outputs);
* **`B₀`**: a `t_i`-line `X` ↦ `(B̃₀ X)_{0..s_i-1}` followed by `t_i − s_i` zeros (`b0Pad`).

As list pipelines these are `tensorGo (mapsA …)` and `tensorGo (mapsB …)` on the dims
`List.ofFn t`. This file proves that they meet the representation and error clauses of
`KFM.LineNeed`:

* **`passA`**: `RepPad zs u`, `‖u‖ ≤ 1/2` ↦ `RepFull L (wOf L)`, `GB (p+2) L` and
  `‖wOf L − tensCLM (kerA M.A) u‖ ≤ εA 2^{−p}` (base `tensor_fp`).
* **`passB`**: `RepFull ys y`, `‖y‖ ≤ 1` ↦ `RepPad L (vOf L)`, `GB (p+2) L` and
  `‖vOf L − tensCLM (kerB M.B) y‖ ≤ εB 2^{−p}`. The padded entries are exactly zero because
  `B̃₀ 0 = 0` (`B0P_zero`) and the slice maps are local (`sliceCompZ_local`).
* `discL_stepA/B`: every axis step keeps the entries in the disc `‖·‖ ≤ 2^p`, so all
  intermediate arrays are `GB (p+2)` (what the rotations and nlogn's slice programs need).
* `getD_listOf'`, `rmPos_digL`, `listOf_self`: `listOf` vs the digits `digL` of `KFMBridge`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM IntMul.OpenAI.RT Complex
open KFB (GI gflat)

/-! ## Row-major digits and `listOf` -/

/-! ## Box points as natural-number index functions -/

variable {d : ℕ}

/-- Coordinates of a box point, extended by `0` beyond `d`. -/
def extF (j : Fin d → ℕ) : ℕ → ℕ := fun i => if h : i < d then j ⟨i, h⟩ else 0

/-- The input of a pass as a box function. -/
def gIn (dims : List ℕ) (zs : List GI) : (Fin d → ℕ) → GI :=
  fun j => zs.getD (rmPos dims (extF j)) 0

/-! ## Discs and bit bounds -/

/-- Every entry in the disc of radius `2^p`. -/
def DiscL (p : ℕ) (L : List GI) : Prop := ∀ z ∈ L, ‖gC z‖ ≤ 2 ^ p

/-! ## The line maps -/

/-- The padded `B̃₀` line map: `B̃₀` on `[0, s)`, zero on `[s, t)`. -/
def PB (p s t α : ℕ) (U : ℕ → ℤ × ℤ) (l : ℕ) : ℤ × ℤ := if l < s then B0P p s t α U l else (0, 0)

/-- The padded `B̃₀` list map. -/
def b0Pad (p s t α : ℕ) (X : List GI) : List GI :=
  (List.range s).map (B0P p s t α fun j => X.getD j (0, 0)) ++ List.replicate (t - s) (0, 0)

/-! ## Locality of slice maps -/

section padded

variable (p α : ℕ) (s t : Fin d → ℕ)

/-- The padded `B̃₀` maps of the axes. -/
def PBf : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ) := fun i => PB p (s i) (t i) α

/-- The plain `B̃₀` maps of the axes. -/
def B0f : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ) := fun i => B0P p (s i) (t i) α

end padded

/-! ## The `A` pass -/

section passA

variable (p α : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]

/-- The `A` maps for `tensorGo` (axis `i` of the padded box, all `t_i` long). -/
def mapsA : List (ℕ × (List GI → List GI)) :=
  (List.range d).map fun i => ((List.ofFn t).getD i 1,
    sapL p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α)

/-- The `B₀` maps for `tensorGo` (padded back to `t_i`). -/
def mapsB : List (ℕ × (List GI → List GI)) :=
  (List.range d).map fun i => ((List.ofFn t).getD i 1,
    b0Pad p ((List.ofFn s).getD i 1) ((List.ofFn t).getD i 1) α)

/-- The output of the `A` pass as a function on the `t`-box (scale `2^{-p}`). -/
noncomputable def wOf (L : List GI) : ((i : Fin d) → ZMod (t i)) → ℂ :=
  fun pt => gC (L.getD (rmPos (List.ofFn t) (extF fun i => (pt i).val)) 0) / 2 ^ p

/-- The output of the `B₀` pass as a function on the `s`-box (scale `2^{-p}`). -/
noncomputable def vOf (L : List GI) : ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun pt => gC (L.getD (rmPos (List.ofFn t) (extF fun i => (pt i).val)) 0) / 2 ^ p

/-! ## The `B₀` pass -/

/-! ## Each axis step keeps the disc -/

end passA

end NLogN.KFY

end

