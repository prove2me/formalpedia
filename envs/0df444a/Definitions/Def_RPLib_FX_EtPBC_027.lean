variable {K : Type} [Field K] [IsAlgClosed K] (c : A1 K ⟶ P1 K) [IsOpenImmersion c] (a : K)
  {B : CommRingCat.{0}} (φ : CommRingCat.of K[X] ⟶ B) [Etale (Spec.map φ ≫ c)]

theorem d₀_hom (hP : (Ideal.span {φ.hom (X - C a)}).IsPrime) : (chEt c φ).hom (d₀ c a φ hP) = zc c a :=
  chEt_hom_eq_of_mem c φ a _ (Ideal.mem_span_singleton_self _)

/-- Every fibre point of `D` at `z` lies over `d₀`. -/
theorem fpt_eq_d₀ [IsDedekindDomain B] (ht : φ.hom (X - C a) ≠ 0)
    (hP : (Ideal.span {φ.hom (X - C a)}).IsPrime) (n : (geomPtAt (zc c a)).point.fiber.obj (chEt c φ)) :
    fpt (zc c a) n = d₀ c a φ hP := by
  refine PrimeSpectrum.ext ?_
  refine ((d₀_max a φ ht hP).eq_of_le (fpt (zc c a) n).isPrime.ne_top ?_).symm
  exact (Ideal.span_le).mpr (Set.singleton_subset_iff.mpr (fpt_mem_t c φ n))

