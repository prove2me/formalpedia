    have := pow_big (B - 1) (by omega)
    have e : R ^ 2 = 102400 * (4 * (B - 1) + 26) ^ 2 := by
      simp only [R]; rw [show 4 * B + 22 = 4 * (B - 1) + 26 by omega]; ring
    omega
  have hc4 : b ≤ (c ^ 2) ^ 2 := by
    have h1 := le_ceilSqrt_sq b
    have h2 := le_ceilSqrt_sq (ceilSqrt b)
    exact h1.trans (Nat.pow_le_pow_left h2 2)
  have hRc : R ≤ c ^ 2 := (Nat.pow_le_pow_iff_left (by norm_num)).1 (hR.trans hc4)
  -- `K (J - 1) c² ≤ 4p`
  set J := Jm q
  have hJ1 : (J - 1) * α ^ 2 ≤ 4 * K * p := by
    simp only [J, Jm, qK, Nat.add_sub_cancel]; exact Nat.div_mul_le_self _ _
  have hαc : K * c ≤ α := by rw [qα]; exact Nat.mul_le_mul_left _ (by omega)
  have hKJ : K * (J - 1) * c ^ 2 ≤ 4 * p := by
    have h1 : K * (K * (J - 1) * c ^ 2) ≤ K * (4 * p) := by
      calc K * (K * (J - 1) * c ^ 2) = (J - 1) * (K * c) ^ 2 := by ring
        _ ≤ (J - 1) * α ^ 2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hαc 2)
        _ ≤ 4 * K * p := hJ1
        _ = K * (4 * p) := by ring
    exact Nat.le_of_mul_le_mul_left h1 (by omega)
  have hmain : K * (J - 1) * (4 * B + 22) * 320 ≤ 20 * b := by
    calc K * (J - 1) * (4 * B + 22) * 320 = K * (J - 1) * R := by simp only [R]; ring
      _ ≤ K * (J - 1) * c ^ 2 := Nat.mul_le_mul_left _ hRc
      _ ≤ 4 * p := hKJ
      _ ≤ 4 * (5 * b) := Nat.mul_le_mul_left 4 hp5
      _ = 20 * b := by ring
  have hsplit : K * J * (4 * B + 22) = K * (J - 1) * (4 * B + 22) + K * (4 * B + 22) := by
    have : J = (J - 1) + 1 := by simp only [J, Jm, Nat.add_sub_cancel]
    conv_lhs => rw [this]
    ring
  have hKB : K * (9 * B + 44) ≤ B * (9 * B + 44) := Nat.mul_le_mul_right _ (by omega)
  have hBb : 16 * (21 + B * (9 * B + 44)) ≤ b := by
    have : 16 * (21 + B * (9 * B + 44)) ≤ R ^ 2 := by simp only [R]; nlinarith
    omega
  unfold Xq
  rw [qK, hsplit]
  have e : 2 * K * (B + 6) + K * (3 * B + 10) + K * (4 * B + 22) = K * (9 * B + 44) := by ring
  omega

end NLogN.BD

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.BD
open IntMul.HvdH IntMul.HvdH.Ref NLogN.Asym
theorem solution (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    Nat.size (NLogN.BD.Bq (mkParams K N)) ≤ (mkParams K N).p + (mkParams K N).p / 8 := by
  have h1 := NLogN.BD.Bq_le_pow K N hK hN
  have h2 := NLogN.BD.Xq_small K N hK hN
  apply Nat.size_le.2
  calc NLogN.BD.Bq (mkParams K N) < 2 ^ ((mkParams K N).p + NLogN.BD.Xq (mkParams K N) (Nat.size (mkParams K N).b) + 1) :=
        lt_of_le_of_lt h1 (Nat.pow_lt_pow_right (by norm_num) (by omega))
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)
end
