theorem no_efx_owner (owner : Fin 8 → Fin 3) :
    ∃ i j : Fin 3, ∃ g : Fin 8, owner g = j ∧
      valueN i (bundle owner i) < valueN i ((bundle owner j).erase g) := by
  have h : owner = ![owner 0, owner 1, owner 2, owner 3,
      owner 4, owner 5, owner 6, owner 7] := by
    funext g
    fin_cases g <;> rfl
  have hv := violation_digits (owner 0) (owner 1) (owner 2)
    (owner 3) (owner 4) (owner 5) (owner 6) (owner 7)
  rw [← h] at hv
  exact hv

end S02EFX

-- Component: P002
set_option autoImplicit false

/-- Three agents have explicit nonnegative weighted-coverage valuations on eight
 goods, and every complete allocation violates an EFX comparison. -/
theorem solution :
    ∃ w : Fin 3 → Finset (Fin 8) → ℝ,
      (∀ i, EFXCounterex.Submodular.IsWeightedCoverage (w i)) ∧
      ∀ X : Fin 3 → Finset (Fin 8), EFXCounterex.Submodular.IsAllocation X →
        ¬ LittleCharity.EFX.IsEFX w X := by
  refine ⟨S02EFX.valueR, S02EFX.weighted_coverage, ?_⟩
  intro X hX hEFX
  obtain ⟨owner, rfl⟩ := S02EFX.exists_owner X hX
  obtain ⟨i, j, g, hg, hlt⟩ := S02EFX.no_efx_owner owner
  have hle := hEFX i j g ((S02EFX.mem_bundle owner j g).mpr hg)
  have hltR : S02EFX.valueR i (S02EFX.bundle owner i) <
      S02EFX.valueR i ((S02EFX.bundle owner j).erase g) := by
    exact Nat.cast_lt.mpr hlt
  exact (not_lt_of_ge hle) hltR

#print axioms solution
