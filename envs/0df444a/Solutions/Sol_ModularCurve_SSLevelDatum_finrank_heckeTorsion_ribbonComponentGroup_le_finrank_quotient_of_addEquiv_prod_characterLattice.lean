private theorem _root_.RibetAssembly69.InstAdj.eqvAdj (ℓ : Nat.Primes) (hℓs : ℓ ≠ ⟨s, hs⟩) (i : Fin 2) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) :
    jointDelta X.degeneracyData i ((adjE M s q' A X ℓ).mulVecLin x) =
      (adjV M s q' A X ℓ).mulVecLin (jointDelta X.degeneracyData i x) := by
  by_cases hb : ℓ ∈ badPrimes M s q'
  · rcases mem_badPrimes_cases M s q' hs ℓ hb with h | h | h
    · exact eqvAdj_of_dvd M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ h i x
    · have hℓ : ℓ = ⟨q', Fact.out⟩ := Subtype.ext h
      subst hℓ
      obtain ⟨σ, τ, hE, hV, h3⟩ := exists_perm_char M s q' hs hq5 hsq' hq'M hsM A X hPD
      refine jointDelta_intertwine_of_mul_eq X.degeneracyData i ?_ x
