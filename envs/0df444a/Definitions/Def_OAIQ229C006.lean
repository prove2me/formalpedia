namespace NuclearUltrapower

section Algebra
variable {Γ A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- sum of squared unitary displacements. -/
def laplacian (S : Finset Γ) (u : Γ → A) : A :=
  ∑ s ∈ S, star (u s - 1) * (u s - 1)

end Algebra

end NuclearUltrapower
