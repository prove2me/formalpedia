noncomputable def hR (d : ℕ) : ℝ := (hp d : ℝ) / (hd d : ℝ)

noncomputable def Cr : ℝ := 2013448663125 / 10 ^ 12

theorem extend_eq : extend hR Cr 32 = hR := by
  funext d
  unfold extend
  split_ifs with h
  · rfl
  · have h1 : 1 ≤ d := by omega
    simp only [hR, hp, hd, if_neg h, Cn, Cr]
    push_cast [Nat.cast_sub h1]
    have : (d : ℝ) - 1 ≠ 0 := by
      have : (1 : ℝ) < d := by exact_mod_cast (show 1 < d by omega)
      linarith
    have : (d : ℝ) ≠ 0 := by positivity
    field_simp
    norm_num

theorem expU (d : ℕ) (h1 : 1 ≤ d) (h2 : d ≤ 512) :
    Real.exp (-hR d) * Dn ≤ u d ∧ u d ≤ Dn := by
  have hm := mem_of_all checkU_ok (i := d - 1) (a := (d, u d)) (by
    apply zip_some
    · rw [List.getElem?_range' (by omega)]; congr 1; omega
    · rw [List.getElem?_drop, show 1 + (d - 1) = d by omega]
      exact getD_some (by rw [uT_len]; omega))
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hm
  exact ⟨expOK_sound hm.1, hm.2⟩

noncomputable def ur (d : ℕ) : ℝ := (u d : ℝ) / Dn

theorem Dn_pos : (0 : ℝ) < Dn := by unfold Dn; positivity

theorem exp_le_ur (d : ℕ) (h1 : 1 ≤ d) (h2 : d ≤ 512) : Real.exp (-hR d) ≤ ur d := by
  unfold ur; rw [le_div_iff₀ Dn_pos]; exact (expU d h1 h2).1

theorem ur_nonneg (d : ℕ) : 0 ≤ ur d := by unfold ur; have := Dn_pos; positivity

theorem Hsum_succ (h : ℕ → ℝ) (d : ℕ) :
    Hsum h (d + 1) = Hsum h d + (((d + 1 : ℕ) : ℝ) + 1) * h (d + 1) := by
  unfold Hsum
  rw [Finset.sum_Icc_succ_top (by omega)]

theorem Hsum_zero (h : ℕ → ℝ) : Hsum h 0 = 0 := by simp [Hsum]

theorem expEH : ∀ d, d ≤ 512 → Real.exp (-Hsum hR d) * Dn ≤ eh d := by
  intro d
  induction d with
  | zero =>
    intro _
    rw [Hsum_zero, neg_zero, Real.exp_zero, one_mul]
    unfold eh; rw [eh0]
  | succ d ih =>
    intro hd512
    have hm := mem_of_all checkEH_ok (i := d) (a := (d, eh d, eh (d + 1))) (by
      apply zip_some
      · rw [List.getElem?_range' (by omega)]; congr 1; omega
      · apply zip_some
        · exact getD_some (by rw [ehT_len]; omega)
        · rw [List.getElem?_drop, show 1 + d = d + 1 by omega]
          exact getD_some (by rw [ehT_len]; omega))
    have he := expOK_sound hm
    have ey : (((d + 2) * hp (d + 1) : ℕ) : ℝ) / (hd (d + 1) : ℝ) =
        (((d + 1 : ℕ) : ℝ) + 1) * hR (d + 1) := by
      unfold hR; push_cast; ring
    rw [ey] at he
    rw [Hsum_succ, neg_add, Real.exp_add]
    have ih' := ih (by omega)
    calc Real.exp (-Hsum hR d) * Real.exp (-((((d + 1 : ℕ) : ℝ) + 1) * hR (d + 1))) * Dn
        = Real.exp (-((((d + 1 : ℕ) : ℝ) + 1) * hR (d + 1))) * (Real.exp (-Hsum hR d) * Dn) := by
          ring
      _ ≤ Real.exp (-((((d + 1 : ℕ) : ℝ) + 1) * hR (d + 1))) * eh d :=
          mul_le_mul_of_nonneg_left ih' (Real.exp_pos _).le
      _ ≤ eh (d + 1) := he

noncomputable def ehr (d : ℕ) : ℝ := (eh d : ℝ) / Dn
noncomputable def ear (d : ℕ) : ℝ := (ea d : ℝ) / Dn

theorem exp_le_ehr (d : ℕ) (h : d ≤ 512) : Real.exp (-Hsum hR d) ≤ ehr d := by
  unfold ehr; rw [le_div_iff₀ Dn_pos]; exact expEH d h

