      intro j
      simp only [hSt, IState.upd_G]
      by_cases j1 : j = mOc
      · subst j1; simp [Ne.symm hdO]
      by_cases j2 : j = dst
      · subst j2
        simp only [if_pos rfl, if_neg hdO]
        rw [pushL_succ v d k hk, ints_cons, show d - k - 1 = d - k - 1 from rfl]
        rfl
      · simp [j1, j2])
