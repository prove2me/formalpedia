variable {E : Type} [Field E] [StarRing E]

theorem PIW.AdelClassFin.hform_single_left {n : Type} [Fintype n] [DecidableEq n] (J : Matrix n n E) (i : n) (y : n → E) :
    hform (starRingEnd E) J (Pi.single i 1) y = (J *ᵥ y) i := by sorry
