theorem mul_sOf_lt {n j : ℕ} (hj : j < mOf n) : j * sOf n < n := by
  have hs := sOf_pos n
  unfold mOf at hj
  have h1 : (j + 1) * sOf n ≤ n + sOf n - 1 := by
    have := (Nat.le_div_iff_mul_le hs).1 (show j + 1 ≤ (n + sOf n - 1) / sOf n by omega)
