theorem solution (s : TypeDensity.State) (hs : s.Valid) (P : TypeDensity.TangentPattern s.degree)
    (hP : TypeDensity.Allowed s P) (hself : ¬ TypeDensity.SelfPattern s P) (z : ℕ × TypeDensity.State) (hz : z ∈ TypeDensity.children s P) :
    z.2.rank < s.rank := by
  have hv := TypeDensity.children_valid s hs P hP z hz
  rcases Nat.lt_or_eq_of_le (TypeDensity.child_degree_le s hs P hP z hz) with hlt | heq
  · exact TypeDensity.rank_lt_of_degree_lt s z.2 hv hlt
  obtain ⟨hch, hz1⟩ := TypeDensity.equal_degree_child_is_unique s hs P hP z hz heq
  have hw : s.weight < z.2.weight → z.2.rank < s.rank :=
    TypeDensity.rank_lt_of_weight_gt s z.2 hs hv heq
  cases s with
  | single a c =>
    obtain ⟨ha, hc⟩ := hs
    simp only [TypeDensity.children, TypeDensity.otherChildren, List.mem_append, List.mem_flatMap,
      List.mem_replicate] at hz
    rcases hz with hz | ⟨ij, -, -, rfl⟩
    · split_ifs at hz
      · simp at hz
      · obtain rfl := List.mem_singleton.1 hz
        exact hw (by simp [TypeDensity.State.weight]; omega)
    · refine absurd ⟨a, c, rfl, ?_⟩ hself
      have hj : ij.2.val + 1 = c :=
        Nat.eq_of_mul_eq_mul_left ha (by simpa [TypeDensity.State.degree] using heq)
      rw [hch]
      simp only at hz1
      rw [hz1, hj]
  | crossing a b c h =>
    obtain ⟨ha, hb, hc, hh⟩ := hs
    simp only [TypeDensity.children, TypeDensity.otherChildren, List.mem_append, List.mem_flatMap,
      List.mem_replicate] at hz
    rcases hz with (hz | hz) | ⟨ij, -, -, rfl⟩
    pick_goal 3
    · simp only [TypeDensity.State.rank, TypeDensity.State.weight, TypeDensity.State.tag] at heq ⊢
      rw [heq]
      omega
    all_goals
      split_ifs at hz
      · simp at hz
      · obtain rfl := List.mem_singleton.1 hz
        exact hw (by simp [TypeDensity.State.weight]; omega)
