    clear * - c4 c5 c6 c9 c14 c15 c16 c17 zun z2 z1 zu1 hc
    generalize ⌈NLogN.KFUU.cSwV K w u (AModel.vol (NLogN.KFUU.shP u bs) * cr)⌉₊ = q
    generalize NLogN.KFUU.cU Z = C at *
    have hA : (bs.length / 2 + 1) * (q + 32 * C + 3000) ≤ (bs.length + 1) * (q + 33 * C) :=
      Nat.mul_le_mul (by omega) (by omega)
    have hB : (bs.length + 1) * (2 * C + 200 * Z + 9000) ≤ (bs.length + 1) * (3 * C) :=
      Nat.mul_le_mul_left _ (by omega)
    have hC : (bs.length + 1) * (200 * (u + 1) + 3000) ≤ (bs.length + 1) * C :=
      Nat.mul_le_mul_left _ (by omega)
    have hE : (bs.length + 1) * (q + 33 * C) + (bs.length + 1) * (3 * C) + (bs.length + 1) * C ≤
        (bs.length + 1) * (q + 40 * C) := by ring_nf; omega
    have hz : 2 * NLogN.zsz (2 : ℤ) + 2 ≤ 6 := by omega
    generalize (bs.length + 1) * (2 * C + 200 * Z + 9000) = A1 at hB ⊢
    generalize (bs.length + 1) * (200 * (u + 1) + 3000) = A2 at hC ⊢
    generalize (bs.length / 2 + 1) * (q + 32 * C + 3000) = A4 at hA ⊢
    generalize (bs.length + 1) * (q + 33 * C) = D1 at hA hE
    generalize (bs.length + 1) * (3 * C) = B1 at hB hE
    generalize (bs.length + 1) * C = C1 at hC hE
    generalize (bs.length + 1) * (q + 40 * C) = E at hE ⊢
    generalize u * bs.length = UB at zun ⊢
