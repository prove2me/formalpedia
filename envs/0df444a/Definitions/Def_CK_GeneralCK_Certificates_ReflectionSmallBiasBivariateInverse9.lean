  have h1 := ((lossPower1_approximates hk hklog).scale (9 : ℚ)).addAppend h2
  have h0 := ((lossPower0_approximates hk hklog).scale (1 : ℚ)).addAppend h1
  have hraw := h0.replacePolynomial (inverseSum9_eval k)
  have ht : Approximates 24 k (fun z => eval k seed9 (lossFunction k z,0)) inverseSum9 := by
    convert hraw using 1
    funext z
    norm_num [seed9,eval,evalTerm]
    <;> ring
  have hu := (loss_approximates hk hklog).comp_finite (Approximates.const 24 k 0)
