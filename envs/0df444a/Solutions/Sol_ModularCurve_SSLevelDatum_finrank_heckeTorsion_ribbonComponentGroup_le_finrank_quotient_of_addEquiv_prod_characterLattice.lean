        hE, hV]
      exact intertwine_transpose_of_perm _ σ τ (h3 i)
    · exact absurd (Subtype.ext h) hℓs
  · obtain ⟨n₁, hn₁, n₂, hn₂, padj, hpadj, -, -, h3, -⟩ :=
      SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X
    refine jointDelta_intertwine_of_mul_eq X.degeneracyData i ?_ x
    rw [adjE_off M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hb, adjV_off M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hb]
