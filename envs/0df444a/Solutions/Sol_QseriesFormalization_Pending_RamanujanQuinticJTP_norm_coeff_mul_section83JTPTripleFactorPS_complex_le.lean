theorem solution
    (P : ℂ⟦X⟧) (B : ℝ) (hB : 0 ≤ B)
    (hP : ∀ k : ℕ, ‖P.coeff k‖ ≤ B) (z : ℂ)
    (hz : ‖z‖ ≤ 1) (hzinv : ‖z⁻¹‖ ≤ 1) (k N : ℕ) :
    ‖(P * section83JTPTripleFactorPS z N).coeff k‖ ≤ 8 * B := by
  have hP1 : ∀ k : ℕ, ‖(P * constQFactorPS 1 N).coeff k‖ ≤ 2 * B :=
