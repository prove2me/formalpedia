theorem KrohnRhodes.closure_monoid_gen {M Q : Type} [Monoid M] (act : M →* Function.End Q)
    (A : Set M) (hA : Submonoid.closure A = ⊤) :
    Submonoid.closure ((⇑act) '' A ∪ Set.range (constEnd : Q → Function.End Q)) =
      closureMonoid act := by sorry
