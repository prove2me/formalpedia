    (ints ((Bl.take k).map (encRes P r)).reverse ++ s.G EO)

/-- Cost of encoding `N` blocks of `r` entries. -/
def encCost (N r P Q W : ℕ) : ℕ :=
  N * (2000000 * (r + 1) * (Q + 3) + 1000000 * (r * P + 1) + 8000 * (W + 2) + 30) +
    N * (14000 * (W + 2) + 30) + 8000 * (W + 2) + 64

