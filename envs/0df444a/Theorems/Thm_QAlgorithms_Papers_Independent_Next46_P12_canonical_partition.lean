-- title:
--   Introduction (1), made precise by Proposition 1.6: canonical partition and GT basis
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. For every $n\ge0$, the constructed elements are nonzero primitive idempotents in $A_n$, are pairwise orthogonal, and satisfy
--
--   $$\sum_{T\in\operatorname{Tab}(n)}\epsilon_T=1,\qquad X_n=\bigoplus_{T\in\operatorname{Tab}(n)}k\epsilon_T.$$
--
--   This gives a canonical partition of unity and a basis of the Gelfand–Tsetlin algebra.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 5, Introduction (1), made precise by Proposition 1.6: canonical partition and GT basis

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 1.6 (Introduction (1)), source PDF pp. 1, 4–5.
Primitivity is in A_n, and the same constructed elements form a basis of X_n. -/
theorem canonical_partition (D : Tower k AA) (n : ℕ) :
    (∀ t : TowerPath D n, PrimitiveIdempotent (pathIdempotent D t)) ∧
    (∀ s t : TowerPath D n, s ≠ t → pathIdempotent D s * pathIdempotent D t = 0) ∧
    (∑ t : TowerPath D n, pathIdempotent D t) = 1 ∧
    LinearIndependent k (fun t : TowerPath D n => pathIdempotent D t) ∧
    Submodule.span k (Set.range (fun t : TowerPath D n => pathIdempotent D t)) =
      (towerGTAlgebra D n).toSubmodule := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
