  simp [twZ]

theorem tw_eq (r N : ℕ) (hr : 0 < r) (sv : ℕ → ℕ) (zs : List GI) (hzs : zs.length = N * r) :
    unpPre (2 * r) (4 * r) (AModel.pull [N, 2 * r, 2] [N, 2 * r, 2] (KIL.rotAddr (2 * r) sv) 0
      (dblPre (2 * r) (gflat zs) N)) N = gflat (twZ r N sv zs) := by
  have hG : (gflat zs).length = N * (2 * r) := by rw [length_gflat, hzs]; ring
  rw [dblPre_eq (2 * r) N (gflat zs) hG, flatMap_rangeMap]
  have hY : (AModel.pull [N, 2 * r, 2] [N, 2 * r, 2] (KIL.rotAddr (2 * r) sv) (0 : ℤ)
      ((List.range (N * (2 * (2 * r)))).map fun t =>
        if t % (2 * (2 * r)) < 2 * r then (gflat zs).getD (t / (2 * (2 * r)) * (2 * r) +
          t % (2 * (2 * r))) 0
        else -(gflat zs).getD (t / (2 * (2 * r)) * (2 * r) + (t % (2 * (2 * r)) - 2 * r)) 0)).length
      = N * (4 * r) := by
    rw [length_pull]; simp only [vol, List.prod_cons, List.prod_nil]; ring
  rw [unpPre_eq (2 * r) (4 * r) N (by omega) _ hY, flatMap_rangeMap]
  conv_rhs => rw [gflat_eq, length_twZ, show N * r * 2 = N * (2 * r) by ring]
  apply List.map_congr_left
  intro t ht
  simp only [List.mem_range] at ht
  have h2r : 0 < 2 * r := by omega
  set j := t / (2 * r)
  set u := t % (2 * r)
  have hu : u < 2 * r := Nat.mod_lt _ h2r
  have hj : j < N := (Nat.div_lt_iff_lt_mul h2r).2 ht
  have ht' : t = j * (2 * r) + u := by simp only [j, u]; rw [Nat.div_add_mod' t (2 * r)]
  -- the pull
  have hidx : j * (4 * r) + u < vol [N, 2 * r, 2] := by
    simp [vol]; nlinarith
  simp only [AModel.pull]
  rw [getD_rangeMap _ _ _ hidx]
  have hd : decode [N, 2 * r, 2] (j * (4 * r) + u) = [j, u / 2, u % 2] := by
    have e1 := divmod_aux (q := j) (b := 4 * r) (show u < 4 * r by omega)
    simp only [decode, vol, List.prod_cons, List.prod_nil, mul_one]
    rw [show 2 * r * 2 = 4 * r by ring, e1.1, e1.2, Nat.mod_eq_of_lt hj,
      Nat.mod_eq_of_lt (show u / 2 < 2 * r by omega)]
    simp
  rw [hd]
  set i := (u / 2 + 2 * r - sv j) % (2 * r)
  have hi : i < 2 * r := Nat.mod_lt _ h2r
  have hra : KIL.rotAddr (2 * r) sv [j, u / 2, u % 2] = [j, i, u % 2] := rfl
  rw [hra]
  have he : encode [N, 2 * r, 2] [j, i, u % 2] = j * (2 * (2 * r)) + (2 * i + u % 2) := by
    simp [encode, vol]; ring
  have hlt : j * (2 * (2 * r)) + (2 * i + u % 2) < N * (2 * (2 * r)) := by
    have h := Nat.mul_le_mul_right (2 * (2 * r)) (show j + 1 ≤ N by omega)
    rw [Nat.add_mul] at h; omega
  rw [he, getD_rangeMap _ _ _ hlt]
  have e2 := divmod_aux (q := j) (b := 2 * (2 * r)) (show 2 * i + u % 2 < 2 * (2 * r) by omega)
  rw [e2.1, e2.2]
  -- the right side
  have hm : j * (2 * r) = 2 * (j * r) := by ring
  have hk : t / 2 = j * r + u / 2 := by omega
  have hc : t % 2 = u % 2 := by omega
  rw [hk, hc]
  have hJ : j * r + r ≤ N * r := by
    have h := Nat.mul_le_mul_right r (show j + 1 ≤ N by omega)
    rw [Nat.add_mul, one_mul] at h; exact h
  have hzl : j * r + u / 2 < N * r := by omega
  rw [List.getD_eq_getElem (twZ r N sv zs) _ (by rw [length_twZ]; exact hzl)]
  simp only [twZ, List.getElem_map, List.getElem_range]
  have e3 := divmod_aux (q := j) (b := r) (show u / 2 < r by omega)
  rw [e3.1, e3.2]
  unfold dblGI
  rw [← show i = (u / 2 + 2 * r - sv j) % (2 * r) from rfl]
  have hgl : ∀ a, a < N * r → (gflat zs).getD (2 * a + u % 2) 0 = gc (zs.getD a 0) (u % 2) := by
    intro a ha
    rw [gflat_eq, getD_rangeMap _ _ _ (by rw [hzs]; omega)]
    rw [show (2 * a + u % 2) / 2 = a by omega, show (2 * a + u % 2) % 2 = u % 2 by omega]
  by_cases hir : i < r
  · rw [if_pos (by omega), if_pos hir,
      show j * (2 * r) + (2 * i + u % 2) = 2 * (j * r + i) + u % 2 by ring, hgl _ (by omega)]
  · rw [if_neg (by omega), if_neg hir,
      show j * (2 * r) + (2 * i + u % 2 - 2 * r) = 2 * (j * r + (i - r)) + u % 2 by
        rw [show 2 * i + u % 2 - 2 * r = 2 * (i - r) + u % 2 by omega]; ring,
      hgl _ (by omega), gc_neg]

theorem rotC_spec (N Q w : ℕ) (sv : ℕ → ℕ) (hsv : ∀ p, sv p ≤ Q) (xs : List ℤ)
    (hlen : xs.length = N * Q * 2) (hb : Bnd w xs) (t : IState HS) (R L14 : List Item)
    (h0 : t.G 0 = ints xs ++ R)
    (h14 : t.G 14 = ints ((List.range N).map fun p => (sv p : ℤ)) ++ L14) :
    IRuns I iprog (rotC N Q) t
      ((t.upd 0 (ints (AModel.pull [N, Q, 2] [N, Q, 2] (KIL.rotAddr Q sv) 0 xs) ++ R)).upd 14 L14)
      (cRotC N Q w) := by
  have h2 := IRuns.const (I := I) (iprog := iprog) (s := t) 1 (N : ℤ)
  set t2 := t.upd 1 (.int (N : ℤ) :: t.G 1)
  have h3 := IRuns.const (I := I) (iprog := iprog) (s := t2) 2 (Q : ℤ)
  set t3 := t2.upd 2 (.int (Q : ℤ) :: t2.G 2)
  have h4 := IRuns.const (I := I) (iprog := iprog) (s := t3) 4 ((2 : ℕ) : ℤ)
  set t4 := t3.upd 4 (.int ((2 : ℕ) : ℤ) :: t3.G 4)
  have h5 := rotF_spec (I := I) (iprog := iprog) t4 xs sv N Q 2 w R (t.G 1) (t.G 2)
    (t.G 4) L14 hsv hlen hb
    (by simp +decide [t4, t3, t2, h0]) (by simp +decide [t4, t3, t2])
    (by simp +decide [t4, t3, t2]) (by simp +decide [t4, t3, t2])
    (by simp +decide [t4, t3, t2, h14])
  set out := AModel.pull [N, Q, 2] [N, Q, 2] (KIL.rotAddr Q sv) 0 xs
  set t5 := (t4.upd 0 (ints out ++ R)).upd 14 L14
  have h6 := IRuns.drop (I := I) (iprog := iprog) (s := t5) (i := 1) (a := (N : ℤ))
    (L := t.G 1) (by simp +decide [t5, t4, t3, t2])
  have h7 := IRuns.drop (I := I) (iprog := iprog) (s := t5.upd 1 (t.G 1)) (i := 2) (a := (Q : ℤ))
    (L := t.G 2) (by simp +decide [t5, t4, t3, t2])
  have h8 := IRuns.drop (I := I) (iprog := iprog) (s := (t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 4)
    (a := ((2 : ℕ) : ℤ)) (L := t.G 4) (by simp +decide [t5, t4, t3, t2])
  refine (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq h8)))))).mono' ?_ ?_
  · simp only [t5, t4, t3, t2]
    clear h2 h3 h4 h5 h6 h7 h8
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> subst_vars <;> simp_all +decide
  · unfold cRotC; push_cast; omega

theorem twC_spec (N r w : ℕ) (hr : 0 < r) (sv : ℕ → ℕ) (hsv : ∀ p, sv p ≤ 2 * r)
    (zs : List GI) (hzs : zs.length = N * r) (hb : NLogN.KFB.GB w zs) (t : IState HS) (R L14 : List Item)
    (h0 : t.G 0 = ints (gflat zs) ++ R)
    (h14 : t.G 14 = ints ((List.range N).map fun p => (sv p : ℤ)) ++ L14) :
    IRuns I iprog (NLogN.KFV.twC N r) t
      ((t.upd 0 (ints (gflat (twZ r N sv zs)) ++ R)).upd 14 L14) (NLogN.KFV.cTw N r w) := by
  have hG : (gflat zs).length = N * (2 * r) := by rw [length_gflat, hzs]; ring
  have H1 := dblI_spec (I := I) (iprog := iprog) N (2 * r) w (gflat zs) hG hb.bnd t R h0
  set D := dblPre (2 * r) (gflat zs) N
  have hD : D.length = N * (2 * r) * 2 := by
    rw [length_dblPre (by omega)]; ring
  have hDb : Bnd w D := bnd_dblPre hb.bnd N
  have H2 := rotC_spec (I := I) (iprog := iprog) N (2 * r) w sv hsv D hD hDb
    (t.upd 0 (ints D ++ R)) R L14 (by simp) (by simp [h14])
  set Y := AModel.pull [N, 2 * r, 2] [N, 2 * r, 2] (KIL.rotAddr (2 * r) sv) 0 D
  have hY : Y.length = N * (4 * r) := by rw [length_pull]; simp only [vol, List.prod_cons, List.prod_nil]; ring
  have H3 := unpadI_spec (I := I) (iprog := iprog) N (2 * r) (4 * r) w (by omega) Y hY
    (bnd_pull _ _ _ hDb) (((t.upd 0 (ints D ++ R)).upd 0 (ints Y ++ R)).upd 14 L14) R (by simp)
  rw [tw_eq r N hr sv zs hzs] at H3
  refine (H1.seq (H2.seq H3)).mono' ?_ (by unfold NLogN.KFV.cTw; omega)
  apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
    split_ifs <;> subst_vars <;> simp_all +decide

end NLogN.KFV

