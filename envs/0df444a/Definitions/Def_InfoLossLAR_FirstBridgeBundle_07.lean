/-- The literal rank-one transformation of a real LWE block after writing
its response as `A * secret + x`, with the auxiliary vector fixed. -/
def rankOneMatrix {F : Type*} [CommRing F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (matrix : Matrix (Fin d) (Fin N) F)
    (input : Fin d → F) : Matrix (Fin d) (Fin N) F :=
  -matrix + vecMulVec (matrix.mulVec secret + input) auxiliary

/-- The transformed secret product identifies both alignment branches. -/
theorem rankOneMatrix_mulVec {F : Type*} [CommRing F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (matrix : Matrix (Fin d) (Fin N) F)
    (input : Fin d → F) :
    (_root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary matrix input).mulVec secret =
      (auxiliary ⬝ᵥ secret - 1) • matrix.mulVec secret +
        (auxiliary ⬝ᵥ secret) • input := by
  ext i
  simp only [_root_.InfoLossLAR.WorstCase.rankOneMatrix, Matrix.add_mulVec, Matrix.neg_mulVec,
    Matrix.vecMulVec_mulVec, Pi.add_apply, Pi.neg_apply, Pi.smul_apply,
    smul_eq_mul, op_smul_eq_mul]
  ring

/-- On alignment, the transformed matrix encodes exactly the selected input. -/
theorem rankOneMatrix_aligned {F : Type*} [CommRing F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (halign : auxiliary ⬝ᵥ secret = 1)
    (matrix : Matrix (Fin d) (Fin N) F) (input : Fin d → F) :
    (_root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary matrix input).mulVec secret = input := by
  rw [_root_.InfoLossLAR.WorstCase.rankOneMatrix_mulVec, halign]
  simp

/-- Keeping the discarded secret product makes the aligned transformation
an involution on the full matrix/input pair. -/
theorem rankOneMatrix_aligned_involutive {F : Type*} [CommRing F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (halign : auxiliary ⬝ᵥ secret = 1) :
    Function.Involutive (fun pair : Matrix (Fin d) (Fin N) F × (Fin d → F) =>
      (_root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary pair.1 pair.2, pair.1.mulVec secret)) := by
  rintro ⟨matrix, input⟩
  apply Prod.ext
  · dsimp only
    change -_root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary matrix input +
      vecMulVec ((_root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary matrix input).mulVec secret + matrix.mulVec secret) auxiliary = matrix
    rw [_root_.InfoLossLAR.WorstCase.rankOneMatrix_aligned secret auxiliary halign]
    unfold _root_.InfoLossLAR.WorstCase.rankOneMatrix
    ext i j
    simp only [Matrix.add_apply, Matrix.neg_apply, Matrix.vecMulVec_apply, Pi.add_apply]
    ring
  · exact _root_.InfoLossLAR.WorstCase.rankOneMatrix_aligned secret auxiliary halign matrix input

/-- Exact finite equivalence used to preserve the complete joint law. -/
def rankOneAlignedEquiv {F : Type*} [CommRing F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (halign : auxiliary ⬝ᵥ secret = 1) :
    (Matrix (Fin d) (Fin N) F × (Fin d → F)) ≃
      (Matrix (Fin d) (Fin N) F × (Fin d → F)) :=
  Function.Involutive.toPerm _ (_root_.InfoLossLAR.WorstCase.rankOneMatrix_aligned_involutive secret auxiliary halign)

/-- In the complementary branch, the matrix transformation is injective for
every fixed selected input, so no independence is inferred from marginals. -/
theorem rankOneMatrix_injective {F : Type*} [Field F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (hmiss : auxiliary ⬝ᵥ secret ≠ 1)
    (input : Fin d → F) : Function.Injective
      (fun matrix : Matrix (Fin d) (Fin N) F => _root_.InfoLossLAR.WorstCase.rankOneMatrix secret auxiliary matrix input) := by
  intro first second h
  have hp := congrArg (fun matrix : Matrix (Fin d) (Fin N) F => matrix.mulVec secret) h
  rw [_root_.InfoLossLAR.WorstCase.rankOneMatrix_mulVec, _root_.InfoLossLAR.WorstCase.rankOneMatrix_mulVec] at hp
  have hproducts : first.mulVec secret = second.mulVec secret := by
    have hscaled := add_right_cancel hp
    exact (smul_right_injective _ (sub_ne_zero.mpr hmiss)) hscaled
  change -first + vecMulVec (first.mulVec secret + input) auxiliary =
    -second + vecMulVec (second.mulVec secret + input) auxiliary at h
  rw [hproducts] at h
  exact neg_injective (add_right_cancel h)

/-- Each nonaligned conditional matrix map is a genuine finite bijection. -/
noncomputable def rankOneUnalignedEquiv {F : Type*} [Field F] [Fintype F] {d N : ℕ}
    (secret auxiliary : Fin N → F) (hmiss : auxiliary ⬝ᵥ secret ≠ 1)
    (input : Fin d → F) : Matrix (Fin d) (Fin N) F ≃ Matrix (Fin d) (Fin N) F :=
  Equiv.ofBijective _ ((Finite.injective_iff_bijective).mp
    (_root_.InfoLossLAR.WorstCase.rankOneMatrix_injective secret auxiliary hmiss input))











end InfoLossLAR.WorstCase

