section

variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalRing K] [LocallyCompactSpace K] [MeasurableSpace K]
  [BorelSpace K] (μ : Measure K) [μ.IsAddHaarMeasure] [μ.Regular]

private theorem measure_smul_set (u : Kˣ) (s : Set K) : μ (u • s) = (modulus (u : K) : ℝ≥0∞) * μ s := by
  rw [← distribHaarChar_mul μ u s, modulus_coe_units]

private theorem measure_preimage_mul_left (u : Kˣ) (s : Set K) :
    μ ((fun x : K => (u : K) * x) ⁻¹' s) = (modulus ((u⁻¹ : Kˣ) : K) : ℝ≥0∞) * μ s := by
  rw [preimage_mul_left_eq, measure_smul_set]

private theorem map_mul_left_eq_smul (u : Kˣ) :
    μ.map (fun x : K => (u : K) * x) = (modulus ((u⁻¹ : Kˣ) : K) : ℝ≥0∞) • μ := by
  ext s hs
  rw [Measure.map_apply (measurable_mul_left u) hs, measure_preimage_mul_left, Measure.smul_apply,
    smul_eq_mul]

private theorem map_mul_left_eq_self_of_modulus_eq_one {u : Kˣ} (hu : modulus (u : K) = 1) :
    μ.map (fun x : K => (u : K) * x) = μ := by
  have h : modulus ((u⁻¹ : Kˣ) : K) = 1 := by
    have := modulus_mul ((u⁻¹ : Kˣ) : K) (u : K)
    rw [Units.inv_mul, modulus_one, hu, mul_one] at this
    exact this.symm
  rw [map_mul_left_eq_smul, h, ENNReal.coe_one, one_smul]

private theorem integral_comp_mul_left_of_modulus_eq_one {u : Kˣ} (hu : modulus (u : K) = 1) (f : K → ℂ) :
    ∫ x, f ((u : K) * x) ∂μ = ∫ x, f x ∂μ := by
  have h := (mulLeftEquiv u).measurableEmbedding.integral_map (μ := μ) f
  rw [coe_mulLeftEquiv, map_mul_left_eq_self_of_modulus_eq_one μ hu] at h
  exact h.symm

private theorem integrable_comp_mul_left_iff_of_modulus_eq_one {u : Kˣ} (hu : modulus (u : K) = 1)
    (f : K → ℂ) : Integrable (fun x => f ((u : K) * x)) μ ↔ Integrable f μ := by
  have h := (mulLeftEquiv u).measurableEmbedding.integrable_map_iff (μ := μ) (g := f)
  rw [coe_mulLeftEquiv, map_mul_left_eq_self_of_modulus_eq_one μ hu] at h
  exact h.symm

private theorem mulMeasure_preimage_mul_left (hcont : Continuous fun x : K => modulus x) (g : Kˣ)
    {s : Set K} (hs : MeasurableSet s) (hs0 : s ⊆ ({0}ᶜ : Set K)) :
    mulMeasure μ ((fun x : K => (g : K) * x) ⁻¹' s) = mulMeasure μ s := by
  have hpre0 : (fun x : K => (g : K) * x) ⁻¹' s ⊆ ({0}ᶜ : Set K) := by
    intro x hx hx0
    apply hs0 hx
    simp [Set.mem_singleton_iff.mp hx0]
  rw [mulMeasure_apply_of_subset μ hs hs0,
    mulMeasure_apply_of_subset μ ((measurable_mul_left g) hs) hpre0]

  have hdens : ∀ x : K, dens x = (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * dens ((g : K) * x) := by
    intro x
    unfold dens
    rw [modulus_mul, ENNReal.coe_mul, ENNReal.mul_inv (Or.inr ENNReal.coe_ne_top) (Or.inl ENNReal.coe_ne_top)]
    have h1 : (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * (modulus (g : K) : ℝ≥0∞)⁻¹ = 1 := by
      rw [← ENNReal.mul_inv (Or.inr ENNReal.coe_ne_top) (Or.inl ENNReal.coe_ne_top), ← ENNReal.coe_mul,
        ← modulus_mul, Units.inv_mul, modulus_one, ENNReal.coe_one, inv_one]
    calc (modulus x : ℝ≥0∞)⁻¹
        = ((modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * (modulus (g : K) : ℝ≥0∞)⁻¹) * (modulus x : ℝ≥0∞)⁻¹ := by
          rw [h1, one_mul]
      _ = (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * ((modulus (g : K) : ℝ≥0∞)⁻¹ * (modulus x : ℝ≥0∞)⁻¹) := by
          rw [mul_assoc]
  have hmap := setLIntegral_map (μ := μ) hs (measurable_dens hcont) (measurable_mul_left g)
  rw [map_mul_left_eq_smul μ g, Measure.restrict_smul, lintegral_smul_measure, smul_eq_mul] at hmap

  calc ∫⁻ x in (fun x : K => (g : K) * x) ⁻¹' s, dens x ∂μ
      = ∫⁻ x in (fun x : K => (g : K) * x) ⁻¹' s,
          (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * dens ((g : K) * x) ∂μ := by
        refine lintegral_congr fun x => ?_
        exact hdens x
    _ = (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ *
          ∫⁻ x in (fun x : K => (g : K) * x) ⁻¹' s, dens ((g : K) * x) ∂μ := lintegral_const_mul _
            ((measurable_dens hcont).comp (measurable_mul_left g))
    _ = (modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞)⁻¹ * ((modulus ((g⁻¹ : Kˣ) : K) : ℝ≥0∞) * ∫⁻ x in s, dens x ∂μ) := by
        rw [← hmap]
    _ = ∫⁻ x in s, dens x ∂μ := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel (by exact_mod_cast modulus_ne_zero (g⁻¹ : Kˣ).ne_zero)
          ENNReal.coe_ne_top, one_mul]

end
