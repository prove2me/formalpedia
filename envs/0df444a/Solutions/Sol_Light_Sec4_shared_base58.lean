theorem glue_index {I O : Type*} {inner : I → α} {outer : O → α} {innerIndex : α → I}
    {outerIndex : α → O} (hI : ∀ s, IsInner s → inner (innerIndex s) = s)
    (hO : ∀ s, ¬ IsInner s → outer (outerIndex s) = s) {u : Fin L → α}
    (hu : (univ.filter fun ℓ => IsInner (u ℓ)) = Q) :
