namespace Integration9_9.TM2StockLists
open Turing Function Polynomial
open OAI.MetricKMedian.Binary

/-- Change only the extensional function in an actual stock machine certificate. -/
def congrProgram {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    {f : α → β} (P : TM2ComputableInPolyTime ea eb f) (g : α → β)
    (h : ∀ a,f a=g a) : TM2ComputableInPolyTime ea eb g :=
  { P with outputsFun := fun a => by rw [←h a]; exact P.outputsFun a }

/-- Native preparation for a context-preserving opaque stock call. -/
noncomputable def foldPrepare {α β : Type} (ea : α → List Bool) (eb : β → List Bool) (a0 : α) :
    PolyProgram (ListFold.enc ea eb)
      (encodePair (encodePair eb ea) (ListFold.enc ea eb))
      (fun s : List α × β => ((s.2,s.1.head?.getD a0),s)) := by
  let px := PolyProgram.fst (encodeList ea) eb
  let py := PolyProgram.snd (encodeList ea) eb
  let hd := px.comp (PolyProgram.listHead ea a0)
  exact ((py.fanout hd).fanout (PolyProgram.identity (ListFold.enc ea eb))).congr _ (fun _ => rfl)

/-- The actual native caller ignores the extra result on the empty-list branch. -/
noncomputable def foldPost {α β : Type} (ea : α → List Bool) (eb : β → List Bool) (a0 : α) :
    PolyProgram (encodePair eb (ListFold.enc ea eb)) (encodeLoop (ListFold.enc ea eb) eb)
      (fun s : β × (List α × β) =>
        if s.2.1.isEmpty then .inl s.2.2 else .inr (s.2.1.tail,s.1)) := by
  let state := PolyProgram.snd eb (ListFold.enc ea eb)
  let source := state.comp (PolyProgram.fst (encodeList ea) eb)
  let old := state.comp (PolyProgram.snd (encodeList ea) eb)
  let fresh := PolyProgram.fst eb (ListFold.enc ea eb)
  let tail := source.comp (PolyProgram.listTail ea a0)
  let recur := (tail.fanout fresh).comp (PolyProgram.injectRight (ListFold.enc ea eb) eb)
  let done := old.comp (PolyProgram.injectLeft (ListFold.enc ea eb) eb)
  exact (PolyProgram.ite (source.comp (PolyProgram.listIsEmpty ea)) recur done).congr _ (fun _ => rfl)

/-- One actual list-fold step, retaining the original arbitrary internal alphabets
of the supplied stock operation and framing its context on separate Bool stacks. -/
theorem fold_body {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    (a0 : α) {op : β × α → β} (P : TM2ComputableInPolyTime (encodePair eb ea) eb op) :
    Nonempty (TM2ComputableInPolyTime (ListFold.enc ea eb) (encodeLoop (ListFold.enc ea eb) eb)
      (ListFold.body a0 op)) := by
  obtain ⟨threaded⟩ := _root_.Integration9_9.TM2StockThread.thread_polynomial (ListFold.enc ea eb) P
  obtain ⟨first⟩ := _root_.Integration9_9.TM2Composition.comp (_root_.Integration9_9.TM2StockLists.foldPrepare ea eb a0).stock threaded
  obtain ⟨whole⟩ := _root_.Integration9_9.TM2Composition.comp first (_root_.Integration9_9.TM2StockLists.foldPost ea eb a0).stock
  exact ⟨_root_.Integration9_9.TM2StockLists.congrProgram whole _ (fun _ => rfl)⟩

/-- A genuine stock TM2 fold under a polynomial bound on each prefix accumulator. -/
theorem listFold {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    {op : β × α → β} (P : TM2ComputableInPolyTime (encodePair eb ea) eb op)
    (a0 : α) (B : Polynomial ℕ)
    (hB : ∀ (as : List α) (b : β) pre suf,as=pre++suf →
      (eb (pre.foldl (fun b a => op (b,a)) b)).length ≤
        B.eval (encodePair (encodeList ea) eb (as,b)).length) :
    Nonempty (TM2ComputableInPolyTime (encodePair (encodeList ea) eb) eb
      (fun x => x.1.foldl (fun b a => op (b,a)) x.2)) := by
  obtain ⟨step⟩ := _root_.Integration9_9.TM2StockLists.fold_body a0 P
  exact _root_.Integration9_9.TM2StockLoop.loop_polynomial step (ListFold.result op) (X+1) (2*X+1+B) (fun s => by
    refine ⟨s.1.length+1,?_,?_⟩
    · have h := EncodedList.length_le ea s.1
      simp only [eval_add,eval_X,eval_one,ListFold.enc,encodePair_length]
      omega
    · apply ListFold.run
      intro pre suf he
      have hh := hB s.1 s.2 pre suf he
      have hx : (encodeList ea suf).length ≤ (encodeList ea s.1).length := by
        rw [he,EncodedList.append,List.length_append]
        omega
      simp only [ListFold.enc,encodePair_length] at hh ⊢
      simp only [eval_add,eval_mul,eval_ofNat,eval_X,eval_one]
      omega)


/-- Mapping an arbitrary original stock TM2 subroutine over an encoded list.
The driver reuses its finite control and preserves its internal alphabet types. -/
theorem listMap {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    {f : α → β} (P : TM2ComputableInPolyTime ea eb f) (a0 : α) :
    Nonempty (TM2ComputableInPolyTime (encodeList ea) (encodeList eb) (List.map f)) := by
  obtain ⟨threaded⟩ := _root_.Integration9_9.TM2StockThread.thread_polynomial (encodeList eb) P
  obtain ⟨first⟩ := _root_.Integration9_9.TM2Composition.comp (PolyProgram.exchange (encodeList eb) ea).stock threaded
  obtain ⟨step0⟩ := _root_.Integration9_9.TM2Composition.comp first (PolyProgram.listCons eb).stock
  let step := _root_.Integration9_9.TM2StockLists.congrProgram step0 (fun x : List β × α => f x.2::x.1) (fun _ => rfl)
  obtain ⟨fold⟩ := _root_.Integration9_9.TM2StockLists.listFold step a0 (X*(2*_root_.Integration9_9.TM2StockLoop.sizeBound P+1)+X) (by
    intro as bs pre suf he
    simp only [ListAlgorithms.pushMap,EncodedList.append,List.length_append,EncodedList.reverse_length]
    let L := (encodePair (encodeList ea) (encodeList eb) (as,bs)).length
    have hpre : (encodeList ea pre).length ≤ (encodeList ea as).length := by
      rw [he,EncodedList.append,List.length_append]; omega
    have hlen : pre.length ≤ L := by
      have hp := EncodedList.length_le ea pre
      simp only [L,encodePair_length]; omega
    have hbs : (encodeList eb bs).length ≤ L := by simp only [L,encodePair_length]; omega
    have hh := EncodedList.length_bound eb (pre.map f) ((_root_.Integration9_9.TM2StockLoop.sizeBound P).eval L) (by
      intro b hb
      obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hb
      apply (_root_.Integration9_9.TM2StockLoop.length_bound P a).trans
      apply polynomial_eval_mono
      have hmem := EncodedList.member_length ea pre a ha
      simp only [L,encodePair_length]; omega)
    simp only [List.length_map] at hh
    simp only [eval_add,eval_mul,eval_X,eval_ofNat,eval_one]
    change _ ≤ L*(2*(_root_.Integration9_9.TM2StockLoop.sizeBound P).eval L+1)+L
    nlinarith)
  let start := (PolyProgram.identity (encodeList ea)).fanout
    (PolyProgram.constant (encodeList ea) (encodeList eb) [])
  obtain ⟨first⟩ := _root_.Integration9_9.TM2Composition.comp start.stock fold
  obtain ⟨whole⟩ := _root_.Integration9_9.TM2Composition.comp first (PolyProgram.listReverse eb (f a0)).stock
  exact ⟨_root_.Integration9_9.TM2StockLists.congrProgram whole _ (fun as => by
    simp only [Function.comp_apply,id_eq,ListFold.result,ListAlgorithms.pushMap,List.append_nil,List.reverse_reverse])⟩

end Integration9_9.TM2StockLists

