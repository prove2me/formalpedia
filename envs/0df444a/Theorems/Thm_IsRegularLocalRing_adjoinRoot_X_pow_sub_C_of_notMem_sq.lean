-- title:
--   Adjoining an n-th root of a regular parameter preserves regularity
-- statement:
--   Let $R$ be a commutative ring which is a regular local ring, and let $t \in R$ lie in the maximal ideal $\mathfrak m$ of $R$ but not in $\mathfrak m^2$; let $n$ be a natural number with $n > 0$. Write $R' = R[X]/(X^n - C(t))$ for the quotient of the polynomial ring by the principal ideal generated by $X^n - t$, with $\theta$ the canonical image of $X$ in $R'$ and $R \to R'$ the canonical ring map. The conclusion is a conjunction of four assertions: $R'$ is again a regular local ring; the ring Krull dimension of $R'$ equals that of $R$ (as elements of the extended natural numbers with $-\infty$); every maximal ideal $N$ of $R'$ equals the join of the ideal generated by $\theta$ with the image ideal of $\mathfrak m$ under $R \to R'$ (so in particular the maximal ideal is unique and is described explicitly); and $\theta$ is a regular element of $R'$, i.e. multiplication by $\theta$ on $R'$ is injective.
--
--   This is the standard statement that a Kummer covering $R[T]/(T^n - t)$ of a regular local ring along a regular parameter $t$ is again regular local, of the same dimension, with maximal ideal $(\theta, \mathfrak m)$ and $\theta$ a non-zero-divisor. It is used in the analysis of ramified extensions of regular local rings, and is cited in the constructions of explicit presentations of such extensions by $X^n - t$, in base-change statements about units and powers, and in the identification of adic completions of rings with prescribed inertia.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsRegularLocalRing_adjoinRoot_X_pow_sub_C_of_notMem_sq.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open IsLocalRing Polynomial

theorem IsRegularLocalRing.adjoinRoot_X_pow_sub_C_of_notMem_sq
    {R : Type*} [CommRing R] [IsRegularLocalRing R] {t : R}
    (ht : t ∈ maximalIdeal R) (ht2 : t ∉ maximalIdeal R ^ 2) {n : ℕ} (hn : 0 < n) :
    IsRegularLocalRing (AdjoinRoot (X ^ n - C t : R[X])) ∧
    ringKrullDim (AdjoinRoot (X ^ n - C t : R[X])) = ringKrullDim R ∧
    (∀ N : Ideal (AdjoinRoot (X ^ n - C t : R[X])), N.IsMaximal →
      N = Ideal.span {AdjoinRoot.root (X ^ n - C t : R[X])} ⊔
        (maximalIdeal R).map (AdjoinRoot.of (X ^ n - C t : R[X]))) ∧
    IsSMulRegular (AdjoinRoot (X ^ n - C t : R[X])) (AdjoinRoot.root (X ^ n - C t : R[X])) := by sorry
