  have hzc : ((z : ℕ) : ZMod p) = ((-AB.getD (a * n + b) 0 : ℤ) : ZMod p) := cast_resid hp _
  have hzd : ((z : ℕ) : ZMod p) = ((z / k * k : ℕ) : ZMod p) + ((z % k : ℕ) : ZMod p) := by
    rw [← Nat.cast_add, Nat.div_add_mod']
