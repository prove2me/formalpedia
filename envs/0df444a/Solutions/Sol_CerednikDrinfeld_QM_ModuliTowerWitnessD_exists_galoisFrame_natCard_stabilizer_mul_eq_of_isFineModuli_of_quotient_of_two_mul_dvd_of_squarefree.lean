theorem mapPt_mapPt {R : Type u} [CommRing R] {A A' A'' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    {f' : A' ⟶ Spec (CommRingCat.of R)} {f'' : A'' ⟶ Spec (CommRingCat.of R)}
    (φ : A ⟶ A') (hφ : φ ≫ f' = f) (ψ : A' ⟶ A'') (hψ : ψ ≫ f'' = f') {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)}
    (P : SchemeHomOver t f) (hc : (φ ≫ ψ) ≫ f'' = f) :
    mapPt ψ hψ (mapPt φ hφ P) = mapPt (φ ≫ ψ) hc P :=
  Subtype.ext (Category.assoc _ _ _)

theorem mapPt_congr {R : Type u} [CommRing R] {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    {f' : A' ⟶ Spec (CommRingCat.of R)} {φ ψ : A ⟶ A'} (h : φ = ψ) (hφ : φ ≫ f' = f) (hψ : ψ ≫ f' = f)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    mapPt φ hφ P = mapPt ψ hψ P := by
  subst h; rfl

theorem mapPt_id' {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (h : 𝟙 A ≫ f = f) {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    mapPt (𝟙 A) h P = P :=
  Subtype.ext (Category.comp_id _)

theorem mapPt_injective {R : Type u} [CommRing R] {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    {f' : A' ⟶ Spec (CommRingCat.of R)} (φ : A ⟶ A') [Mono φ] (hφ : φ ≫ f' = f)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} :
    Function.Injective (mapPt φ hφ (T := T) (t := t)) := by
  intro P Q h
  apply Subtype.ext
  rw [← cancel_mono φ]
  exact congrArg Subtype.val h

theorem mapPt_inv {R : Type u} [CommRing R] {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    {f' : A' ⟶ Spec (CommRingCat.of R)} (L : GoodReductionJacobian.RelativeGroupLaw R f) (L' : GoodReductionJacobian.RelativeGroupLaw R f')
    (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f) :
    mapPt φ hφ (L.inv t P) = L'.inv t (mapPt φ hφ P) := by
  letI := L'.pointGroup t
  have hone : mapPt φ hφ (L.one t) = L'.one t := by
    have h : L'.mul t (mapPt φ hφ (L.one t)) (mapPt φ hφ (L.one t)) = L'.mul t (mapPt φ hφ (L.one t)) (L'.one t) := by
      rw [← hmul, L.one_mul, L'.mul_one]
    exact mul_left_cancel (G := SchemeHomOver t f') h
  have h : L'.mul t (mapPt φ hφ (L.inv t P)) (mapPt φ hφ P) = L'.one t := by
    rw [← hmul, L.inv_mul_cancel, hone]
  exact eq_inv_of_mul_eq_one_left (G := SchemeHomOver t f') h

theorem rigid_of_iso {S : Type u} [CommRing S] {E E' : FakeEllipticCurve Λ N S} (hiso : FakeEllipticCurve.Iso E E')
    (hrig : ∀ (e : E'.A ≅ E'.A) (he : e.hom ≫ E'.f = E'.f),
      (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E'.f),
          mapPt e.hom he (E'.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q)) →
      (∀ x : ↥Λ, E'.act x ≫ e.hom = e.hom ≫ E'.act x) →
      e.hom = 𝟙 E'.A ∨
        ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E'.f),
          mapPt e.hom he P = E'.L.inv t P) :
    ∀ (e : E.A ≅ E.A) (he : e.hom ≫ E.f = E.f),
      (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f),
          mapPt e.hom he (E.L.mul t P Q) = E.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q)) →
      (∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E.act x) →
      e.hom = 𝟙 E.A ∨
        ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
          mapPt e.hom he P = E.L.inv t P := by
  obtain ⟨φ, hφ, hφmul, hφlin, -⟩ := hiso
  intro e he hemul helin
  have hφinv : φ.inv ≫ E.f = E'.f := by rw [← hφ, Iso.inv_hom_id_assoc]

  have hφinvmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P' Q' : SchemeHomOver t E'.f),
      mapPt φ.inv hφinv (E'.L.mul t P' Q') = E.L.mul t (mapPt φ.inv hφinv P') (mapPt φ.inv hφinv Q') := by
    intro T t P' Q'
    have hP : P' = mapPt φ.hom hφ (mapPt φ.inv hφinv P') :=
      Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.inv_hom_id, Category.comp_id])
    have hQ : Q' = mapPt φ.hom hφ (mapPt φ.inv hφinv Q') :=
      Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.inv_hom_id, Category.comp_id])
    conv_lhs => rw [hP, hQ, ← hφmul]
    exact Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.hom_inv_id, Category.comp_id])

  let e' : E'.A ≅ E'.A := φ.symm ≪≫ e ≪≫ φ
  have he'hom : e'.hom = φ.inv ≫ e.hom ≫ φ.hom := by simp [e']
  have he' : e'.hom ≫ E'.f = E'.f := by
    rw [he'hom, Category.assoc, Category.assoc, hφ, he, hφinv]
  have hmap : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P' : SchemeHomOver t E'.f),
      mapPt e'.hom he' P' = mapPt φ.hom hφ (mapPt e.hom he (mapPt φ.inv hφinv P')) := by
    intro T t P'
    apply Subtype.ext
    simp only [mapPt_coe, he'hom, Category.assoc]
  have he'mul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E'.f),
      mapPt e'.hom he' (E'.L.mul t P Q) = E'.L.mul t (mapPt e'.hom he' P) (mapPt e'.hom he' Q) := by
    intro T t P Q
    rw [hmap, hmap, hmap, hφinvmul, hemul, hφmul]
  have he'lin : ∀ x : ↥Λ, E'.act x ≫ e'.hom = e'.hom ≫ E'.act x := by
    intro x
    have h1 : E'.act x ≫ φ.inv = φ.inv ≫ E.act x := by
      rw [← cancel_mono φ.hom]
      simp only [Category.assoc, hφlin x, Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
    rw [he'hom]
    calc E'.act x ≫ φ.inv ≫ e.hom ≫ φ.hom = (E'.act x ≫ φ.inv) ≫ e.hom ≫ φ.hom := by simp only [Category.assoc]
      _ = (φ.inv ≫ E.act x) ≫ e.hom ≫ φ.hom := by rw [h1]
      _ = φ.inv ≫ (E.act x ≫ e.hom) ≫ φ.hom := by simp only [Category.assoc]
      _ = φ.inv ≫ (e.hom ≫ E.act x) ≫ φ.hom := by rw [helin x]
      _ = φ.inv ≫ e.hom ≫ (E.act x ≫ φ.hom) := by simp only [Category.assoc]
      _ = φ.inv ≫ e.hom ≫ (φ.hom ≫ E'.act x) := by rw [hφlin x]
      _ = (φ.inv ≫ e.hom ≫ φ.hom) ≫ E'.act x := by simp only [Category.assoc]
  rcases hrig e' he' he'mul he'lin with h1 | h2
  · left
    have : e.hom = φ.hom ≫ e'.hom ≫ φ.inv := by
      rw [he'hom]; simp
    rw [this, h1, Category.id_comp, Iso.hom_inv_id]
  · right
    intro T t P
    apply mapPt_injective φ.hom hφ
    have h3 := h2 t (mapPt φ.hom hφ P)
    rw [hmap, mapPt_mapPt φ.hom hφ φ.inv hφinv P (by rw [Iso.hom_inv_id, Category.id_comp]),
      mapPt_congr φ.hom_inv_id _ (by rw [Category.id_comp]) P, mapPt_id'] at h3
    rw [h3, mapPt_inv E.L E'.L φ.hom hφ hφmul]

