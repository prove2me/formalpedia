-- title:
--   Extract a finite weighted power certificate
-- statement:
--   If coordinate powers lie in the ideal generated by the cutoff components of all bounded-weight elements of `I^s`, finitely many such elements suffice for all coordinates while preserving their membership and support bounds.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.finite_weighted_power_certificate_of_span_all_bounded
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (s : Nat) (D : Real)
    (hspan : ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
      MvPolynomial.X i ^ e ∈
        Ideal.span (Set.range (fun f :
          {p : MvPolynomial (Fin d) Complex //
            p ∈ I ^ s ∧
            ∀ a ∈ p.support,
              ∑ k, (w k : Real) * (a k : Real) ≤ D} =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : Real)) D f.1))) :
    ∃ n : Nat, ∃ f : Fin n → MvPolynomial (Fin d) Complex,
      (∀ j, f j ∈ I ^ s) ∧
      (∀ j, ∀ a ∈ (f j).support,
        ∑ k, (w k : Real) * (a k : Real) ≤ D) ∧
      ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
        MvPolynomial.X i ^ e ∈
          Ideal.span (Set.range (fun j =>
            MvPolynomial.weightedHomogeneousComponent
              (fun k => (w k : Real)) D (f j))) := by sorry
