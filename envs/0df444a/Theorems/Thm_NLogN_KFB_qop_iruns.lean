theorem NLogN.KFB.qop_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (w B1 G : ℕ) (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hlen : G * (2 * B1 * Ms.length) ≤ zs.length)
    (h0 : f 0 = gflat zs ++ l) (hS : Scr f) (hc : Cnt s f B1) (hA : f qA = []) (hG : f cG = [])
    {LG LN : List Item} (hrG : (encK s f).G rG = .int (G : ℤ) :: LG)
    (hrN : (encK s f).G rN = .int ((2 * (G * (2 * B1 * Ms.length)) : ℕ) : ℤ) :: LN)
    (hb : NLogN.KFB.GB w zs) :
    IRuns I iprog (fcode (qop Ms)) (encK s f)
      (encK s (Function.update f 0
        (gflat (qopL Ms B1 G zs ++ zs.drop (G * (2 * B1 * Ms.length))) ++ l)))
      (cQop w B1 Ms.length G) := by sorry
