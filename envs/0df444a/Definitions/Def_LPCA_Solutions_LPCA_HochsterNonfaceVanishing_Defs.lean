set_option autoImplicit false

namespace LPCA

open CategoryTheory CategoryTheory.Limits

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]

theorem localizationCriterion_negativeSupport_subset
    (K : Complex V) (F : Finset V) (a : V → ℤ)
    (h : LocalizationCriterion K F a) : negativeSupport a ⊆ F := by
  intro j hj
  have hneg : a j < 0 := (Finset.mem_filter.mp hj).2
  by_contra hjF
  exact (not_lt_of_ge (h.1 j hjF)) hneg

theorem localizationCriterion_iff_support
    (K : Complex V) (F : Finset V) (a : V → ℤ) :
    LocalizationCriterion K F a ↔
      negativeSupport a ⊆ F ∧ positiveSupport a ∪ F ∈ K.faces := by
  constructor
  · intro h
    exact ⟨localizationCriterion_negativeSupport_subset K F a h, h.2⟩
  · rintro ⟨hsub, hface⟩
    refine ⟨?_, hface⟩
    intro j hjF
    by_contra hnonneg
    have hneg : a j < 0 := lt_of_not_ge hnonneg
    exact hjF (hsub (by simp only [negativeSupport, Finset.mem_filter,
      Finset.mem_univ, true_and]; exact hneg))





