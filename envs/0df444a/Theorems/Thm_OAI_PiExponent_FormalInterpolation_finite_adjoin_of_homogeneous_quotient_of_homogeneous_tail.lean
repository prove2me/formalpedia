-- title:
--   Finite generation from eventual homogeneous ideal membership
-- statement:
--   If all sufficiently high weighted-homogeneous polynomials lie in the ideal generated by a positive-degree homogeneous family, then the polynomial ring is finite as a module over the algebra generated by that family.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_homogeneous_quotient_of_homogeneous_tail
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : ℝ))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (B : ℚ)
    (hB : ∀ (t : ℚ) (f : MvPolynomial (Fin d) ℂ),
      B < t → MvPolynomial.IsWeightedHomogeneous w f t → f ∈ Ideal.span (Set.range p)) :
    Module.Finite (Algebra.adjoin ℂ (Set.range p)) (MvPolynomial (Fin d) ℂ) := by sorry
