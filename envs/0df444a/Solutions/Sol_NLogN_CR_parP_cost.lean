    parEx K N ≤ K * (mkParams K N).e ∧ K * (mkParams K N).e ≤ parEx K N + K - 1 := by
  rw [par_e]
  constructor
  · have := Nat.lt_div_mul_add (a := parEx K N + K - 1) (b := K) (by omega)
    rw [mul_comm]
    have h2 : (parEx K N + K - 1) / K * K + K > parEx K N + K - 1 := by
      have := Nat.lt_div_mul_add (a := parEx K N + K - 1) (b := K) (by omega); omega
    omega
  · rw [mul_comm]; exact Nat.div_mul_le_self _ _

theorem par_dh_lt (K N : ℕ) (hK : 1 ≤ K) : (mkParams K N).dh < K := by
  rw [par_dh]; have := par_Ke K N hK; omega

theorem par_logT (K N : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) : (mkParams K N).logT = parEx K N := by
  set q := mkParams K N with hq
  have he := par_e_pos K N hK hN
  have hdh := par_dh_lt K N hK
  have hKe := par_Ke K N hK
  unfold Params.logT
  have : (List.range q.K).map q.te = List.replicate q.dh (q.e - 1) ++ List.replicate (q.K - q.dh) q.e := by
    apply List.ext_getElem
    · simp [par_K] at hdh ⊢; rw [hq, par_K]; omega
    · intro i h1 h2
      simp only [List.getElem_map, List.getElem_range]
      rcases lt_or_ge i q.dh with hi | hi
      · rw [List.getElem_append_left (by simpa using hi), List.getElem_replicate, te_lt q i hi]
      · rw [List.getElem_append_right (by simpa using hi), List.getElem_replicate, NLogN.CR.te_ge q i hi]
  rw [this, List.sum_append, List.sum_replicate, List.sum_replicate, smul_eq_mul, smul_eq_mul]
  rw [hq, par_K] at *
  have hdh' : (mkParams K N).dh = K * (mkParams K N).e - parEx K N := par_dh K N
  rw [hdh']
  have e1 : (K * (mkParams K N).e - parEx K N) * ((mkParams K N).e - 1) +
      (K - (K * (mkParams K N).e - parEx K N)) * (mkParams K N).e + (K * (mkParams K N).e - parEx K N) =
      K * (mkParams K N).e := by
    generalize (mkParams K N).e = e at *
    obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
    simp only [Nat.add_sub_cancel]
    have hd : K * (e' + 1) - parEx K N ≤ K := by omega
    generalize K * (e' + 1) - parEx K N = d at *
    obtain ⟨c, rfl⟩ : ∃ c, K = d + c := ⟨K - d, by omega⟩
    simp only [Nat.add_sub_cancel_left]
    ring
  omega

theorem par_logOuter (K N : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) :
    (mkParams K N).logOuter = parEx K N - (mkParams K N).e := by
  set q := mkParams K N with hq
  have hdh := par_dh_lt K N hK
  have hT := par_logT K N hK hN
  rw [← hq] at hT hdh
  unfold Params.logOuter
  unfold Params.logT at hT
  have hK' : q.K = (q.K - 1) + 1 := by rw [hq, par_K]; omega
  rw [hK', List.range_succ, List.map_append, List.sum_append] at hT
  simp only [List.map_singleton, List.sum_singleton] at hT
  rw [NLogN.CR.te_ge q _ (by rw [hq, par_K] at *; omega)] at hT
  omega

theorem par_T (K N : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) :
    (mkParams K N).tdims.prod = 2 ^ parEx K N := by
  rw [T_eq, par_logT K N hK hN]

end NLogN.CR

