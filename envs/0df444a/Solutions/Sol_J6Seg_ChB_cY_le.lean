    exact_mod_cast mulSup_le_fmB' _
  have hLn1 := lgn_ge n
  set Ln := Real.log (IntMul.lg n) + 1 with hLn
  set L3 := Real.log (((Wt ap + 1) * pP6 P n ^ 3 : ℕ) : ℝ) + 1 with hL3d
  have hL31 : 1 ≤ L3 := by
    have : (1 : ℝ) ≤ (((Wt ap + 1) * pP6 P n ^ 3 : ℕ) : ℝ) := by exact_mod_cast hp31
    have := Real.log_nonneg this; linarith
  set p := pP6 P n with hpd
  have hpR : (1 : ℝ) ≤ p := by exact_mod_cast hp1
  have hW0 : (0 : ℝ) ≤ Wt ap := Nat.cast_nonneg _
  have hCf : (0 : ℝ) ≤ (NLogN.KFZ.Cfm : ℝ) := Nat.cast_nonneg _
  have hx0 : (0 : ℝ) ≤ (P.x : ℝ) := Nat.cast_nonneg _
  have hK3 : 0 ≤ K3 P ap := by unfold K3; linarith
  have hC1 : 0 ≤ C1 P ap := by
    unfold C1; exact mul_nonneg (mul_nonneg hCf (by linarith)) (sq_nonneg _)
  have hWp : (0 : ℝ) ≤ (Wt ap : ℝ) * p := mul_nonneg hW0 (by linarith)
  have hL30 : (0 : ℝ) ≤ L3 := by linarith
  have nZl : (0 : ℝ) ≤ (cZl P n src k ap : ℝ) + 2 := by
    have := Nat.cast_nonneg (α := ℝ) (cZl P n src k ap); linarith
  have nz4 : (0 : ℝ) ≤ (zsz (((cZl P n src k ap + 2) ^ 4 : ℕ) : ℤ) : ℝ) + 1 := by
    have := Nat.cast_nonneg (α := ℝ) (zsz (((cZl P n src k ap + 2) ^ 4 : ℕ) : ℤ)); linarith
  have nJ : (0 : ℝ) ≤ (cJ P n : ℝ) + 1 := by
    have := Nat.cast_nonneg (α := ℝ) (cJ P n); linarith
  have nZ : (0 : ℝ) ≤ (cZ P n src k ap : ℝ) + 5 := by
    have := Nat.cast_nonneg (α := ℝ) (cZ P n src k ap); linarith
