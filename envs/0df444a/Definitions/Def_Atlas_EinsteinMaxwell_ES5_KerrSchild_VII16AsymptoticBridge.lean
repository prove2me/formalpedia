/-! ## The glued germ: polynomial on the left, the actual germ on the right -/

/-- Glue: Taylor polynomial below `0`, the actual germ above. Written as polynomial plus a
flat correction so that the flat-extension theory applies unchanged. -/
noncomputable def glue (L : ℕ → ℝ) (n : ℕ) (g : ℝ → ℝ) : ℝ → ℝ :=
  fun x => taylorPoly L n x + flatExt (fun y => g y - taylorPoly L n y) x

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII16

