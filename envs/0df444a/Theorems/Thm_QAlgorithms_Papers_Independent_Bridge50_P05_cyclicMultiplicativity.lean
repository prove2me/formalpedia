variable {d : ℕ} [NeZero d]

/-- Section 2, PDF pp.9--10: for maximal cyclic twirls the ordering of
|a+b| and |b| is unnecessary. The proof's changed basis is not asserted to be
the original coordinates of G-perp. -/
theorem cyclicMultiplicativity (z : WeylLabel d)
    (hcard : (AddSubgroup.zmultiples z : Set (WeylLabel d)).ncard = d) (a b : ℂ)
    (hb : ‖b‖ ≤ 1) (hab : ‖a + b‖ ≤ 1) :
    nu 2 (twoMap (AddSubgroup.zmultiples z) a b) = saturationValue (twoSymbol (AddSubgroup.zmultiples z) a b) ∧
    UniversalMultiplicative 2 (twoMap (AddSubgroup.zmultiples z) a b) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

end
