lemma root_le_iff (N m x : ℕ) (hm : 1 ≤ m) :
    (x : ℝ) ≤ (N : ℝ) ^ ((1 : ℝ) / m) ↔ x ^ m ≤ N := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  rw [one_div, Real.le_rpow_inv_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hm',
    Real.rpow_natCast]
  exact_mod_cast Iff.rfl

theorem floor_root_eq (N m x : ℕ) (hm : 1 ≤ m) (h1 : x ^ m ≤ N) (h2 : N < (x + 1) ^ m) :
    ⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊ = x := by
  rw [Nat.floor_eq_iff (by positivity)]
  refine ⟨(root_le_iff N m x hm).2 h1, ?_⟩
  by_contra h
  push Not at h
  have := (root_le_iff N m (x + 1) hm).1 (by exact_mod_cast h)
  omega

