theorem scaledCoeffs_diag_toNat (b : Matrix Int n m) (hquot : StepWitness b)
    (i : Nat) (hi : i < n) :
    (GramSchmidt.entry (scaledCoeffs b) ⟨i, hi⟩ ⟨i, hi⟩).toNat =
      gramDet b (i + 1) (Nat.succ_le_of_lt hi) := by sorry
