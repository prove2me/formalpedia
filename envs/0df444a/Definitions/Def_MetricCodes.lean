  rw [Finset.sum_eq_single (gramPivot hn z)]
  · simp [MvPolynomial.X, MvPolynomial.monomial_mul,
      MvPolynomial.coeff_monomial,
      gramPivotExponent, gramSummandExponent]
  · intro k _ hk
    simp only [MvPolynomial.X, MvPolynomial.monomial_mul,
      MvPolynomial.coeff_monomial, ite_eq_right_iff, one_ne_zero,
      imp_false]
    simpa [gramSummandExponent, gramPivotExponent] using
      (show gramSummandExponent z k ≠ gramPivotExponent hn z from
