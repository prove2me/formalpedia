theorem solution (hγκ : ∀ m, γ (κ m) = m) (hκγ : ∀ m, κ (γ m) = m)
    (hκ : ∀ m < M, κ m < M) (hγ : ∀ m < M, γ m < M) {A : ℕ} (hA : M ≤ 2 ^ A)
    (recs : ℕ → List ℤ) : NLogN.KFL.rsort A (NLogN.KFL.ent0 κ M recs) = NLogN.KFL.ent1 κ γ M recs := by
  have hinj : Function.Injective κ := fun a b h => by rw [← hγκ a, h, hγκ b]
  have hinjγ : Function.Injective γ := fun a b h => by rw [← hκγ a, h, hκγ b]
  apply NLogN.KFL.rsort_eq (A := A)
  · intro e he
    simp only [NLogN.KFL.ent0, List.mem_map] at he
    obtain ⟨m, hm, rfl⟩ := he
    have := hκ m (NLogN.KFL.mem_mvL.1 hm).1
    omega
  · simp only [NLogN.KFL.ent0, List.map_map]
    exact (NLogN.KFL.nodup_mvL).map hinj
  · -- ent1 = ent0 reindexed by `γ`
    have e : NLogN.KFL.ent1 κ γ M recs = ((NLogN.KFL.mvL κ M).map γ).map fun m => (κ m, (recs m).reverse) := by
      simp only [NLogN.KFL.ent1, List.map_map, Function.comp_def, hκγ]
    rw [e, NLogN.KFL.ent0]
    refine List.Perm.map _ ?_
    rw [List.perm_ext_iff_of_nodup (NLogN.KFL.nodup_mvL.map hinjγ) NLogN.KFL.nodup_mvL]
    intro x
    simp only [List.mem_map, NLogN.KFL.mem_mvL]
    constructor
    · rintro ⟨d, ⟨hd, hκd⟩, rfl⟩
      refine ⟨hγ d hd, fun h => hκd ?_⟩
      rw [hκγ] at h
      have := congrArg κ h; rw [hκγ] at this; exact this
    · rintro ⟨hx, hκx⟩
      refine ⟨κ x, ⟨hκ x hx, fun h => hκx (hinj h)⟩, hγκ x⟩
  · simp only [NLogN.KFL.ent1, List.pairwise_map]
    have : (List.range M).reverse.Pairwise (fun a b => b < a) := by
      rw [List.pairwise_reverse]; exact List.pairwise_lt_range
    exact this.filter _
