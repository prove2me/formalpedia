  have h2 := hc ζ hζp
  rw [h1] at h2

  have h3 : ζ ^ ((PadicInt.toZMod (a p σ)).val % p) = ζ ^ (c % p) := by
    rw [← pow_eq_pow_of_mod_eq p hζp (Nat.mod_mod _ p).symm, h2,
      pow_eq_pow_of_mod_eq p hζp (Nat.mod_mod _ p).symm]
  have h4 : (PadicInt.toZMod (a p σ)).val % p = c % p :=
    hζ.pow_inj (Nat.mod_lt _ hp) (Nat.mod_lt _ hp) h3
  rw [← ZMod.natCast_zmod_val (PadicInt.toZMod (a p σ)), ZMod.natCast_eq_natCast_iff', h4]

