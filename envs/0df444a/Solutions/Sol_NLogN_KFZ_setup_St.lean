    (hc : F0 NLogN.KFZ.cS = (K : ℤ) :: (p : ℤ) :: (α : ℤ) :: (h : ℤ) :: (d : ℤ) :: (NLogN.KFZ.zl bs ++ NLogN.KFZ.zl ss ++ R))
    (h0 : ∀ j ∈ setupRegs, F0 j = []) (B : ℕ) (hB : NLogN.KFZ.eS h bs d + h + 6 ≤ B)
    (hdB : d + 2 ≤ B) (hK : zsz (K : ℤ) ≤ B) (hp : zsz (p : ℤ) ≤ B) (hα : zsz (α : ℤ) ≤ B) :
