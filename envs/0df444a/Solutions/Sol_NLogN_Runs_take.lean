-- Source module: NLogN.Take
/-!
# Lockstep transfer: `take`

While the top of `b` is a bit, pop it and push it on `e`; at the same time, if the top of `a` is a
bit, move it to `d`.  So `|Bw|` bits are taken from `a`, where `Bw` is the bit word on `b`.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem takeδ_length (q a b d e : Fin S) (os) : (takeδ q a b d e os).length ≤ 4 := by
  unfold takeδ; split
  · rename_i ta sb
    split_ifs
    · rcases ta with _ | sa
      · simp
      · simp only; split_ifs <;> simp
    · simp
  · simp

theorem Runs.take_sol_aux {q a b d e : Fin S} (hqa : q ≠ a) (hqb : q ≠ b) (hqd : q ≠ d) (hqe : q ≠ e)
    (hab : a ≠ b) (had : a ≠ d) (hae : a ≠ e) (hbd : b ≠ d) (hbe : b ≠ e) (hde : d ≠ e)
    (σ : St S) (A Bw : List Bool) (ra rb : List Sym)
    (hA : σ.stk a = A.map codeBit ++ ra) (hB : σ.stk b = Bw.map codeBit ++ rb)
    (hra : bitOf ra.head? = none) (hrb : bitOf rb.head? = none) :
    Runs I prog (NLogN.take q a b d e : Stmt S P) σ
      ((((σ.set a ((A.drop Bw.length).map codeBit ++ ra)).set b rb).set d
        (((A.take Bw.length).map codeBit).reverse ++ σ.stk d)).set e
        ((Bw.map codeBit).reverse ++ σ.stk e)) (takeCost Bw.length) := by
  have hqa' := Ne.symm hqa; have hqb' := Ne.symm hqb; have hqd' := Ne.symm hqd
  have hqe' := Ne.symm hqe; have hab' := Ne.symm hab; have had' := Ne.symm had
  have hae' := Ne.symm hae; have hbd' := Ne.symm hbd; have hbe' := Ne.symm hbe
  have hde' := Ne.symm hde
  let G : ℕ → St S := fun k =>
    (((σ.set a ((A.drop k).map codeBit ++ ra)).set b ((Bw.drop k).map codeBit ++ rb)).set d
      (((A.take k).map codeBit).reverse ++ σ.stk d)).set e
      (((Bw.take k).map codeBit).reverse ++ σ.stk e)
  let F : ℕ → St S := fun k =>
    if k ≤ Bw.length then (G k).push q 0 else (G Bw.length).push q hlt
  have hG : ∀ k, (G k).stk q = σ.stk q := by
    intro k; simp [G, hqa, hqb, hqd, hqe]
  have h := Runs.machine_of (I := I) (prog := prog) (w := [a, b]) (q0 := 0) 4
    (takeδ_length q a b d e) σ F (Bw.length + 1)
    (by
      simp only [F, zero_le, if_true]
      congr 1
      rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
      simp only [G, St.set_stk, List.drop_zero, List.take_zero, List.map_nil, List.reverse_nil,
        List.nil_append]
      split_ifs <;> simp_all)
    (by
      intro k hk
      have hk' : k ≤ Bw.length := by omega
      simp only [mstep, St.tops, List.map_cons, List.map_nil, F, if_pos hk', St.top_eq]
      by_cases hkl : k < Bw.length
      · have hd : Bw.drop k = Bw[k] :: Bw.drop (k + 1) := List.drop_eq_getElem_cons hkl
        have hbtop : ((G k).push q 0).stk b = codeBit Bw[k] :: (Bw.drop (k + 1)).map codeBit ++ rb := by
          simp only [G, St.push_stk, St.set_stk, hqb', hbd, hbe, hab', if_true, if_false]; rw [hd]; rfl
        have hqtop : ((G k).push q 0).stk q = 0 :: σ.stk q := by simp [hG]
        rw [hbtop, hqtop, if_pos (show k + 1 ≤ Bw.length by omega)]
        by_cases hka : k < A.length
        · have hda : A.drop k = A[k] :: A.drop (k + 1) := List.drop_eq_getElem_cons hka
          have hatop : ((G k).push q 0).stk a = codeBit A[k] :: (A.drop (k + 1)).map codeBit ++ ra := by
            simp only [G, St.push_stk, St.set_stk, hqa', hab, had, hae, if_true, if_false]; rw [hda]; rfl
          rw [hatop]
          simp only [List.head?_cons, takeδ, bitOf_codeBit, Option.isSome_some, if_true,
            List.cons_append, List.nil_append, runOps, Op.run]
          rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
          simp only [St.push_stk, St.pop_stk, G, St.set_stk]
          rw [hda, hd]
          simp only [List.take_add_one, List.getElem?_eq_getElem hka,
            List.getElem?_eq_getElem hkl, Option.toList_some]
          clear hatop hbtop hd hda
          split_ifs <;> simp_all <;> simp [List.take_add_one, hka, hkl]
        · have hatop : ((G k).push q 0).stk a = ra := by
            simp only [G, St.push_stk, St.set_stk, hqa', hab, had, hae, if_true, if_false]
            rw [List.drop_eq_nil_of_le (by omega)]; rfl
          rw [hatop]
          have e1 : takeδ q a b d e [some 0, ra.head?, some (codeBit Bw[k])] =
              [.pop b, .push e (codeBit Bw[k])] := by
            rcases hr : ra.head? with _ | sa
            · simp [takeδ, bitOf_codeBit]
            · rw [hr] at hra; simp [takeδ, bitOf_codeBit, hra]
          simp only [List.cons_append, List.head?_cons]
          rw [e1]
          simp only [runOps, Op.run]
          rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
          simp only [St.push_stk, St.pop_stk, hbtop]
          simp only [G, St.set_stk]
          rw [List.take_of_length_le (show A.length ≤ k + 1 by omega),
            List.take_of_length_le (show A.length ≤ k by omega),
            List.drop_eq_nil_of_le (show A.length ≤ k + 1 by omega),
            List.drop_eq_nil_of_le (show A.length ≤ k by omega)]
          rw [hd]
          simp only [List.take_add_one, List.getElem?_eq_getElem hkl, Option.toList_some]
          clear hatop hbtop hd e1
          split_ifs <;> simp_all <;> simp [List.take_add_one, hkl]
      · have hkl : k = Bw.length := by omega
        subst hkl
        have hbtop : ((G Bw.length).push q 0).stk b = rb := by simp [G, hqb', hbd, hbe]
        have hqtop : ((G Bw.length).push q 0).stk q = 0 :: σ.stk q := by simp [hG]
        rw [hbtop, hqtop, if_neg (show ¬ Bw.length + 1 ≤ Bw.length by omega)]
        have e1 : ∀ ta, takeδ q a b d e [some 0, ta, rb.head?] = [.pop q, .push q hlt] := by
          intro ta
          rcases hr : rb.head? with _ | sb
          · rfl
          · rw [hr] at hrb; simp [takeδ, hrb]
        rw [List.head?_cons, e1]
        simp only [runOps, Op.run]
        rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
        simp only [St.push_stk, St.pop_stk]
        split_ifs <;> simp_all)
    (by
      intro k hk
      simp only [F, if_pos (show k ≤ Bw.length by omega), St.top_eq, St.push_stk, if_true,
        List.head?_cons]
      simp [hlt])
    (by simp [F, St.top_eq])
  have e : (F (Bw.length + 1)).pop q =
      ((((σ.set a ((A.drop Bw.length).map codeBit ++ ra)).set b rb).set d
        (((A.take Bw.length).map codeBit).reverse ++ σ.stk d)).set e
        ((Bw.map codeBit).reverse ++ σ.stk e)) := by
    simp only [F, if_neg (show ¬ Bw.length + 1 ≤ Bw.length by omega)]
    rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
    simp only [St.push_stk, St.pop_stk, St.set_stk, G, List.drop_length, List.take_length,
      List.map_nil, List.nil_append]
    split_ifs <;> simp_all
  rw [e] at h
  exact h.mono (by simp [takeCost])

end NLogN

end

theorem solution : type_of% @NLogN.Runs.take_sol_aux := @NLogN.Runs.take_sol_aux
