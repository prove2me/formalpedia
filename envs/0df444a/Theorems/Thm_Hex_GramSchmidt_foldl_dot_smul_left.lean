theorem foldl_dot_smul_left
    (xs : List (Fin m)) (s : Rat) (a c : Vector Rat m) (acc : Rat) :
    xs.foldl (fun acc i => acc + (s • a)[i] * c[i]) (s * acc) =
      s * xs.foldl (fun acc i => acc + a[i] * c[i]) acc := by sorry
