theorem ModularCurve.ssPlaces_finite (q N : ℕ) [NeZero N] (K : Type*) [Field K] [DecidableEq K]
    [Fact q.Prime] [IsAlgClosed K] [CharP K q] :
    (ModularCurve.ssPlaces q N K).Finite := by sorry
