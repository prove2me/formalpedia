-- title:
--   The generalized switch under MaxWeight: capacity region, facets, heavy-traffic family, steady state
-- statement:
--   This module fixes the model of the paper.
--
--   A **generalized switch** has $n$ queues, a finite set $\mathcal M$ of channel states with probability mass function $\psi$, and for each $m\in\mathcal M$ a finite nonempty set $\mathcal S^{(m)}\subset\mathbb R^n_+$ of feasible service rate vectors, closed under the coordinate projections $x\mapsto x-x_ie^{(i)}$. Its **capacity region** is the Minkowski sum
--
--   $$
--   \mathcal C=\sum_{m\in\mathcal M}\psi_m\,\mathrm{ConvexHull}\bigl(\mathcal S^{(m)}\bigr).
--   $$
--
--   A **description** of $\mathcal C$ is a finite family $(c^{(\ell)},b^{(\ell)})_{\ell\in[L]}$ with $c^{(\ell)}\ge0$, $\|c^{(\ell)}\|=1$, $b^{(\ell)}>0$ and $\mathcal C=\{x\in\mathbb R^n_+:\langle c^{(\ell)},x\rangle\le b^{(\ell)},\ \ell\in[L]\}$. It defines the facets $\mathcal F^{(\ell)}=\{x\in\mathcal C:\langle c^{(\ell)},x\rangle=b^{(\ell)}\}$, the numbers $b^{(m,\ell)}=\max_{x\in\mathcal S^{(m)}}\langle c^{(\ell)},x\rangle$, and the covariance matrix $\Sigma_B$ of $(b^{(M,\ell)})_\ell$ for $M\sim\psi$. For a point $\nu$, the set $P=\{\ell:\nu\in\mathcal F^{(\ell)}\}$ determines the cone $\mathcal K$ and the subspace $\mathcal H$ generated by $\{c^{(\ell)}:\ell\in P\}$. A subset $\tilde P\subseteq P$ with $\{c^{(\ell)}\}_{\ell\in\tilde P}$ independent and spanning $\mathcal H$ gives the matrix $C=[c^{(\ell)}]_{\ell\in\tilde P}$ and the projection matrix $H=C(C^TC)^{-1}C^T$.
--
--   One time slot proceeds as on p.5: given the queue vector $q$, the channel state $m\sim\psi$ is observed; MaxWeight selects $s\in\arg\max_{x\in\mathcal S^{(m)}}\langle q,x\rangle$; arrivals $a$ occur, and jobs are served. The unused service is $u_i=\max(s_i-q_i-a_i,0)$, and the next queue vector is $q^+=q+a-s+u$.
--
--   A **regime** is the heavy-traffic family of pp.6–7: a point $\nu$ on the boundary of $\mathcal C$ with positive coordinates, and for each $\epsilon\in(0,1)$ an arrival law with mean $(1-\epsilon)\nu$ and entries bounded by one constant $A_{\max}$, a MaxWeight tie-breaking law, and a probability mass function on queue vectors fixed by the one-step kernel, the steady state. The joint steady-state law of $(\bar q,\bar M,\bar s,\bar a)$ gives $\mathcal T_2=\mathbb E[\|\bar a_{\parallel\mathcal H}-\bar s_{\parallel\mathcal H}\|^2]$, $\mathcal T_3=\mathbb E[\|\bar u_{\parallel\mathcal H}\|^2]$ and $\mathcal T_4=2\mathbb E[\langle\bar q^+_{\parallel\mathcal H},\bar u_{\parallel\mathcal H}\rangle]$ of p.25, and the probability $\pi^{(m,\ell)}$ of Lemma 3.
--
--   All the statements of this mission are about these objects.
--
--   **Formalization Note** Vectors are `Fin n → ℝ`, and `expect` is a series under a `PMF`. Because the default norm on `Fin n → ℝ` is the sup norm, `euclNorm` and `distTo` are written out; $\|q_{\perp\mathcal K}\|$ is the Euclidean distance `distTo` from $q$ to $\mathcal K$. The positivity of $\nu$ is a correction of the paper, explained in Theorem 1. Since $x_{\parallel\mathcal H}=Hx$ and $H=H^T=H^2$, the quantities $\mathcal T_i$ are written with $H$; the identities are proved in `Solutions/verification/GenSwitchHT_ProjH.lean`.
-- source:
--   Hurtado-Lange–Maguluri, Heavy-traffic Analysis of Queueing Systems with no Complete Resource Pooling, arXiv:1904.10096v4, §1.1, p.4; §2, eqs. (2)–(9), pp.4–7; p.25 (T₁–T₄)

import Mathlib

open scoped BigOperators Matrix Topology

namespace GenSwitchHT

noncomputable section

variable {n : ℕ} {M : Type*} [Fintype M] {L : ℕ}

/-! ### Expectations and Euclidean quantities -/

/-- The expectation `E[f]` of a real function under a `PMF`.

**Formalization Note.** It is the series `∑' x, P(x) f(x)`, which Lean sets to `0` when it is not
summable. Every series whose summability is not automatic comes with `HasExpect` in the statements
of this mission. -/
def expect {α : Type*} (p : PMF α) (f : α → ℝ) : ℝ :=
  ∑' x, (p x).toReal * f x

/-- `f` has a finite expectation under `p`. A real series is summable iff it is absolutely
summable, so this is integrability. -/
def HasExpect {α : Type*} (p : PMF α) (f : α → ℝ) : Prop :=
  Summable fun x => (p x).toReal * f x

/-- The Euclidean norm `‖x‖ = √⟨x, x⟩` of arXiv:1904.10096v4, §1.1, p.4.

**Formalization Note.** Mathlib's default norm on `Fin n → ℝ` is the sup norm, so the Euclidean
norm is written out. -/
def euclNorm (x : Fin n → ℝ) : ℝ :=
  Real.sqrt (x ⬝ᵥ x)

/-- The Euclidean distance from `x` to the set `A`. For a closed convex `A` it is the norm
`‖x - proj_A x‖` of the component of `x` orthogonal to `A`.

**Formalization Note.** A real `sInf` is `0` on an empty set. It is only used on the sets `cone`
and `hSub` below, which contain `0`, and the values are bounded below by `0`. -/
def distTo (A : Set (Fin n → ℝ)) (x : Fin n → ℝ) : ℝ :=
  sInf ((fun y => euclNorm (x - y)) '' A)

/-- The `k`-step law `step^k(x)` of the time-homogeneous Markov chain with one-step kernel `step`,
started at `x`. -/
def iterateKernel {X : Type*} (step : X → PMF X) : ℕ → X → PMF X
  | 0, x => PMF.pure x
  | k + 1, x => (iterateKernel step k x).bind step

/-! ### The generalized switch (§2, pp.4–6) -/

/-- The generalized switch of Hurtado-Lange–Maguluri, Heavy-traffic Analysis of Queueing Systems
with no Complete Resource Pooling, arXiv:1904.10096v4, §2, pp.4–5: `n` queues, the finite set `M`
of channel states with probability mass function `ψ`, and for each `m` the finite nonempty set
`S m` of feasible service rate vectors.

**Formalization Note.** Vectors are `Fin n → ℝ` with `⬝ᵥ` as `⟨·,·⟩`. Service vectors are real and
nonnegative (the ad hoc network of the paper has `(2/3, 2/3)`). `S_proj` is the paper's
`x - x_i e^(i) ∈ S^(m)`, written `Function.update x i 0`. -/
structure Switch (n : ℕ) (M : Type*) [Fintype M] where
  /-- The law `ψ` of the channel state. -/
  ψ : PMF M
  /-- The sets `S^(m)` of feasible service rate vectors. -/
  S : M → Finset (Fin n → ℝ)
  S_nonempty : ∀ m, (S m).Nonempty
  S_nonneg : ∀ m, ∀ x ∈ S m, ∀ i, 0 ≤ x i
  S_proj : ∀ m, ∀ x ∈ S m, ∀ i, Function.update x i 0 ∈ S m

/-- The capacity region, eq. (5), p.5: `C = ∑_{m ∈ M} ψ_m ConvexHull(S^(m))`, as a Minkowski sum. -/
def Switch.capacityRegion (G : Switch n M) : Set (Fin n → ℝ) :=
  {x | ∃ y : M → (Fin n → ℝ), (∀ m, y m ∈ convexHull ℝ (G.S m : Set (Fin n → ℝ))) ∧
    x = ∑ m, (G.ψ m).toReal • y m}

/-- The polyhedral description (7) of the capacity region, with the normalization of p.6:
`c^(ℓ) ≥ 0`, `‖c^(ℓ)‖ = 1`, `b^(ℓ) > 0`.

**Formalization Note.** The paper takes `L` minimal; this structure does not ask for it. -/
structure Description (G : Switch n M) (L : ℕ) where
  /-- The normals `c^(ℓ)`. -/
  c : Fin L → Fin n → ℝ
  /-- The offsets `b^(ℓ)`. -/
  b : Fin L → ℝ
  c_nonneg : ∀ ℓ i, 0 ≤ c ℓ i
  c_norm : ∀ ℓ, c ℓ ⬝ᵥ c ℓ = 1
  b_pos : ∀ ℓ, 0 < b ℓ
  capacity_eq : G.capacityRegion = {x | (∀ i, 0 ≤ x i) ∧ ∀ ℓ, c ℓ ⬝ᵥ x ≤ b ℓ}

namespace Description

variable {G : Switch n M} (D : Description G L)

/-- The facet `F^(ℓ) = {x ∈ C : ⟨c^(ℓ), x⟩ = b^(ℓ)}`, p.6. -/
def facet (ℓ : Fin L) : Set (Fin n → ℝ) :=
  {x | x ∈ G.capacityRegion ∧ D.c ℓ ⬝ᵥ x = D.b ℓ}

/-- `b^(m,ℓ) = max_{x ∈ S^(m)} ⟨c^(ℓ), x⟩`, eq. (8), p.6. -/
def bm (m : M) (ℓ : Fin L) : ℝ :=
  (G.S m).sup' (G.S_nonempty m) fun x => D.c ℓ ⬝ᵥ x

/-- The covariance matrix `Σ_B` of the vector `B = (b^(M,1), …, b^(M,L))`, p.6. -/
def covB : Matrix (Fin L) (Fin L) ℝ :=
  Matrix.of fun ℓ₁ ℓ₂ =>
    expect G.ψ (fun m => D.bm m ℓ₁ * D.bm m ℓ₂) -
      expect G.ψ (fun m => D.bm m ℓ₁) * expect G.ψ (fun m => D.bm m ℓ₂)

open Classical in
/-- The set `P = {ℓ : ν ∈ F^(ℓ)}` of the facets through `ν`, p.6. -/
def activeSet (ν : Fin n → ℝ) : Finset (Fin L) :=
  Finset.univ.filter fun ℓ => ν ∈ D.facet ℓ

/-- The cone `K` generated by `{c^(ℓ) : ℓ ∈ P}`, eq. (9), p.7. -/
def cone (ν : Fin n → ℝ) : Set (Fin n → ℝ) :=
  {x | (∀ i, 0 ≤ x i) ∧
    ∃ ξ : Fin L → ℝ, (∀ ℓ ∈ D.activeSet ν, 0 ≤ ξ ℓ) ∧ x = ∑ ℓ ∈ D.activeSet ν, ξ ℓ • D.c ℓ}

/-- The subspace `H` generated by `{c^(ℓ) : ℓ ∈ P}`, p.7. -/
def hSub (ν : Fin n → ℝ) : Submodule ℝ (Fin n → ℝ) :=
  Submodule.span ℝ (D.c '' (D.activeSet ν : Set (Fin L)))

end Description

/-- A subset `P̃ ⊆ P` such that `{c^(ℓ) : ℓ ∈ P̃}` is linearly independent and spans the subspace
`H`, p.7. The second condition is the paper's "the column space of the matrix `C` is exactly the
subspace `H`". -/
structure ActiveBasis {G : Switch n M} (D : Description G L) (ν : Fin n → ℝ) where
  /-- The index set `P̃`. -/
  Pt : Finset (Fin L)
  Pt_subset : Pt ⊆ D.activeSet ν
  Pt_indep : LinearIndependent ℝ (fun ℓ : Pt => D.c ℓ)
  Pt_span : Submodule.span ℝ (D.c '' (Pt : Set (Fin L))) = D.hSub ν

namespace ActiveBasis

variable {G : Switch n M} {D : Description G L} {ν : Fin n → ℝ} (B : ActiveBasis D ν)

/-- The matrix `C = [c^(ℓ)]_{ℓ ∈ P̃}`, with the vectors as columns, p.7. -/
def Cmat : Matrix (Fin n) B.Pt ℝ :=
  Matrix.of fun i ℓ => D.c ℓ i

/-- The matrix `(CᵀC)⁻¹`. The inverse is Mathlib's `nonsing_inv`, which is a junk value on a
singular matrix; `Pt_indep` excludes that. -/
def gramInv : Matrix B.Pt B.Pt ℝ :=
  (B.Cmatᵀ * B.Cmat)⁻¹

/-- The projection matrix `H = C(CᵀC)⁻¹Cᵀ` onto the subspace `H`, Theorem 1, p.9. -/
def projH : Matrix (Fin n) (Fin n) ℝ :=
  B.Cmat * B.gramInv * B.Cmatᵀ

/-- `Σ_B` restricted to `P̃ × P̃`, the block that enters the Hadamard product with `(CᵀC)⁻¹`. -/
def covBPt : Matrix B.Pt B.Pt ℝ :=
  D.covB.submatrix (fun ℓ => (ℓ : Fin L)) (fun ℓ => (ℓ : Fin L))

/-- The service term `1ᵀ((CᵀC)⁻¹ ∘ Σ_B)1` of (10) and (11), p.9. -/
def serviceTerm : ℝ :=
  (1 : B.Pt → ℝ) ⬝ᵥ ((B.gramInv ⊙ B.covBPt) *ᵥ (1 : B.Pt → ℝ))

/-- The arrival term `1ᵀ(H ∘ Sa)1` of (10) and (11), p.9, for a matrix `Sa`. -/
def arrivalTerm (Sa : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  (1 : Fin n → ℝ) ⬝ᵥ ((B.projH ⊙ Sa) *ᵥ (1 : Fin n → ℝ))

end ActiveBasis

/-! ### One time slot under MaxWeight (pp.5, 7) -/

/-- The covariance matrix of an arrival vector with law `p`, p.4. -/
def covArrival (p : PMF (Fin n → ℕ)) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i j =>
    expect p (fun a => (a i : ℝ) * (a j : ℝ)) -
      expect p (fun a => (a i : ℝ)) * expect p (fun a => (a j : ℝ))

/-- The variables of one time slot: the queue vector `q` at the beginning of the slot, the channel
state `m`, the potential service `s` and the arrivals `a`. All of `q̄, M̄, s̄, ā, ū, (q̄)⁺` of p.7
are functions of this tuple. -/
structure Slot (n : ℕ) (M : Type*) where
  /-- Queue lengths at the beginning of the slot. -/
  q : Fin n → ℝ
  /-- Channel state. -/
  m : M
  /-- Potential service. -/
  s : Fin n → ℝ
  /-- Arrivals. The paper's arrivals are numbers of jobs. -/
  a : Fin n → ℕ

namespace Slot

variable (ω : Slot n M)

/-- The arrival vector as a real vector. -/
def arr : Fin n → ℝ := fun i => (ω.a i : ℝ)

/-- The unused service: `u_i = s_i - min(s_i, q_i + a_i)`, the potential service minus the jobs
actually processed, since arrivals occur before service (p.5). -/
def u : Fin n → ℝ := fun i => max (ω.s i - ω.q i - ω.arr i) 0

/-- The queue vector after the slot, eq. (2), p.5: `q⁺ = q + a - s + u`. -/
def qPlus : Fin n → ℝ := ω.q + ω.arr - ω.s + ω.u

end Slot

/-- The law of a time slot whose queue vector has law `ρ`, in the order of events of p.5: the
channel state is observed, a schedule is selected, then arrivals occur. The channel state has
law `G.ψ` whatever the queues are; given `(q, m)` the schedule has law `τ q m`; the arrivals have
law `α`, independently of everything else. -/
def slotLaw (G : Switch n M) (α : PMF (Fin n → ℕ)) (τ : (Fin n → ℝ) → M → PMF (Fin n → ℝ))
    (ρ : PMF (Fin n → ℝ)) : PMF (Slot n M) :=
  ρ.bind fun q => G.ψ.bind fun m => (τ q m).bind fun s => α.bind fun a => PMF.pure ⟨q, m, s, a⟩

/-- The one-step kernel of the queue vector. -/
def stepLaw (G : Switch n M) (α : PMF (Fin n → ℕ)) (τ : (Fin n → ℝ) → M → PMF (Fin n → ℝ))
    (q : Fin n → ℝ) : PMF (Fin n → ℝ) :=
  (slotLaw G α τ (PMF.pure q)).map Slot.qPlus

/-- `x` is a MaxWeight schedule for queue vector `q` in channel state `m`, eq. (4), p.5:
`x ∈ argmax_{y ∈ S^(m)} ⟨q, y⟩`. -/
def IsMaxWeight (G : Switch n M) (q : Fin n → ℝ) (m : M) (x : Fin n → ℝ) : Prop :=
  x ∈ G.S m ∧ ∀ y ∈ G.S m, q ⬝ᵥ y ≤ q ⬝ᵥ x

/-- The heavy-traffic family of §2, pp.6–7: a point `ν` on the boundary of `C`, and for each
`ε ∈ (0, 1)` a system with mean arrival rate `(1 - ε)ν` operating under MaxWeight, with a steady
state.

**Formalization Note.**
1. `ν_pos` is a correction. The paper fixes any `ν` on the boundary, and Theorem 1 is false as
printed when `ν` has a zero coordinate; the paper's own sentence on p.6, that `λ^(ε)` belongs to the
interior of `C`, is equivalent to `ν > 0`.
2. `α`, `τ`, `stat` have domain `ℝ` and are constrained on `(0, 1)` only.
3. `Amax` is one constant for all `ε` (p.7). The coordinates of `a` may be dependent.
4. `τ` is an arbitrary law on the arg max, which covers random tie-breaking.
5. `stat` is any `PMF` fixed by the one-step kernel, which covers the limit in distribution of
p.7. The paper's chain lives on a countable state space, so a `PMF` is the right object. -/
structure Regime {G : Switch n M} (D : Description G L) where
  /-- The heavy-traffic point `ν`. -/
  ν : Fin n → ℝ
  ν_frontier : ν ∈ frontier G.capacityRegion
  ν_pos : ∀ i, 0 < ν i
  /-- The law of the arrival vector in system `ε`. -/
  α : ℝ → PMF (Fin n → ℕ)
  /-- The uniform bound on the arrivals. -/
  Amax : ℕ
  α_mean : ∀ ε ∈ Set.Ioo (0 : ℝ) 1, ∀ i, expect (α ε) (fun a => (a i : ℝ)) = (1 - ε) * ν i
  α_bound : ∀ ε ∈ Set.Ioo (0 : ℝ) 1, ∀ a ∈ (α ε).support, ∀ i, a i ≤ Amax
  /-- The law of the schedule given the queues and the channel state in system `ε`. -/
  τ : ℝ → (Fin n → ℝ) → M → PMF (Fin n → ℝ)
  τ_maxWeight : ∀ ε ∈ Set.Ioo (0 : ℝ) 1, ∀ q m, ∀ x ∈ (τ ε q m).support, IsMaxWeight G q m x
  /-- The steady-state law of the queue vector in system `ε`. -/
  stat : ℝ → PMF (Fin n → ℝ)
  stat_fixed : ∀ ε ∈ Set.Ioo (0 : ℝ) 1, (stat ε).bind (stepLaw G (α ε) (τ ε)) = stat ε

namespace Regime

variable {G : Switch n M} {D : Description G L} (R : Regime D)

/-- The joint steady-state law of `(q̄, M̄, s̄, ā)`, p.7. -/
def steady (ε : ℝ) : PMF (Slot n M) :=
  slotLaw G (R.α ε) (R.τ ε) (R.stat ε)

/-- `E[⟨q̄^(ε), w⟩]`, the quantity of Theorem 1. -/
def meanQ (w : Fin n → ℝ) (ε : ℝ) : ℝ :=
  expect (R.stat ε) fun q => q ⬝ᵥ w

/-- `π^(m,ℓ) = P[⟨c^(ℓ), s̄⟩ = b^(m,ℓ) | M̄ = m]`, Lemma 3, p.24, in system `ε`. The conditional
probability is the ratio of the two probabilities; it is meaningful for `ψ_m ≠ 0`. -/
def hitProb (ε : ℝ) (m : M) (ℓ : Fin L) : ℝ :=
  expect (R.steady ε) (Set.indicator {ω | ω.m = m ∧ D.c ℓ ⬝ᵥ ω.s = D.bm m ℓ} 1) / (G.ψ m).toReal

/-- `T₂ = E[‖ā_∥H - s̄_∥H‖²]`, p.25.

**Formalization Note.** `x_∥H = Hx` and `H = Hᵀ = H²`, so `‖x_∥H‖² = xᵀHx`, the form used here. -/
def T2 (B : ActiveBasis D R.ν) (ε : ℝ) : ℝ :=
  expect (R.steady ε) fun ω => (ω.arr - ω.s) ⬝ᵥ (B.projH *ᵥ (ω.arr - ω.s))

/-- `T₃ = E[‖ū_∥H‖²]`, p.25, written `E[ūᵀHū]`. -/
def T3 (B : ActiveBasis D R.ν) (ε : ℝ) : ℝ :=
  expect (R.steady ε) fun ω => ω.u ⬝ᵥ (B.projH *ᵥ ω.u)

/-- `T₄ = 2E[⟨(q̄⁺)_∥H, ū_∥H⟩]`, p.25, written `2E[(q̄⁺)ᵀHū]`. -/
def T4 (B : ActiveBasis D R.ν) (ε : ℝ) : ℝ :=
  2 * expect (R.steady ε) fun ω => ω.qPlus ⬝ᵥ (B.projH *ᵥ ω.u)

end Regime

end

end GenSwitchHT


