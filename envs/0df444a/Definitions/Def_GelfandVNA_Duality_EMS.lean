--   Pavlov, Gelfand-type duality for commutative von Neumann algebras, arXiv:2005.05284v3, pp. 29–42, Definitions 4.4, 4.6, 4.13, 4.28, 4.38, 4.48, 4.57, 4.59, 5.2, 5.8, Lemma 4.25, Proposition 4.65

import Mathlib
import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P20

namespace GelfandVNA.Duality

open CategoryTheory QAlgorithms.Papers.Independent.Support21.P20

universe u

/-! ### Set algebra for enhanced measurable spaces -/

lemma negligible_mono {X : Type u} (E : Enhanced X) {a b : Set X} (hab : a ⊆ b)
    (hb : b ∈ E.negligible) : a ∈ E.negligible :=
  E.sigmaIdeal.2.1 a b hab hb

lemma iUnion_two {X : Type u} (a b : Set X) :
    (⋃ i : ℕ, if i = 0 then a else b) = a ∪ b := by
  ext x
  simp only [Set.mem_iUnion, Set.mem_union]
  constructor
  · rintro ⟨i, hi⟩
    split_ifs at hi
    · exact Or.inl hi
    · exact Or.inr hi
  · rintro (h | h)
    · exact ⟨0, by simpa using h⟩
    · exact ⟨1, by simpa using h⟩

lemma negligible_union {X : Type u} (E : Enhanced X) {a b : Set X} (ha : a ∈ E.negligible)
    (hb : b ∈ E.negligible) : a ∪ b ∈ E.negligible := by
  have h := E.sigmaIdeal.2.2 (fun i : ℕ => if i = 0 then a else b)
    (fun i => by show (if i = 0 then a else b) ∈ _; split_ifs <;> assumption)
  rwa [iUnion_two] at h

lemma partialPreimage_comp {X Y Z : Type u} (g : Y → Option Z) (f : X → Option Y) (s : Set Z) :
    partialPreimage (partialCompose g f) s = partialPreimage f (partialPreimage g s) := by
  ext x
  simp only [partialPreimage, partialCompose, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨z, hz, h⟩
    rcases hfx : f x with _ | y
    · rw [hfx] at h; cases h
    · rw [hfx] at h
      exact ⟨y, ⟨z, hz, h⟩, rfl⟩
  · rintro ⟨y, ⟨z, hz, hy⟩, hfx⟩
    exact ⟨z, hz, by rw [hfx]; exact hy⟩

lemma partialPreimage_symmDiff {X Y : Type u} (f : X → Option Y) (a b : Set Y) :
    (partialPreimage f a \ partialPreimage f b) ∪ (partialPreimage f b \ partialPreimage f a) =
      partialPreimage f ((a \ b) ∪ (b \ a)) := by
  ext x
  simp only [partialPreimage, Set.mem_union, Set.mem_sdiff, Set.mem_ofPred_eq]
  constructor
  · rintro (⟨⟨y, hy, h⟩, hn⟩ | ⟨⟨y, hy, h⟩, hn⟩)
    · exact ⟨y, Or.inl ⟨hy, fun hb => hn ⟨y, hb, h⟩⟩, h⟩
    · exact ⟨y, Or.inr ⟨hy, fun hb => hn ⟨y, hb, h⟩⟩, h⟩
  · rintro ⟨y, (⟨hy, hn⟩ | ⟨hy, hn⟩), h⟩
    · refine Or.inl ⟨⟨y, hy, h⟩, ?_⟩
      rintro ⟨y', hy', h'⟩
      rw [h] at h'
      cases h'
      exact hn hy'
    · refine Or.inr ⟨⟨y, hy, h⟩, ?_⟩
      rintro ⟨y', hy', h'⟩
      rw [h] at h'
      cases h'
      exact hn hy'

lemma partialPreimage_id {X : Type u} (s : Set X) :
    partialPreimage (fun x : X => some x) s = s := by
  ext x
  simp [partialPreimage]

lemma partialDomain_comp_compl {X Y Z : Type u} (g : Y → Option Z) (f : X → Option Y) :
    (partialDomain (partialCompose g f))ᶜ ⊆
      (partialDomain f)ᶜ ∪ partialPreimage f (partialDomain g)ᶜ := by
  intro x hx
  simp only [partialDomain, partialCompose, partialPreimage, Set.mem_compl_iff, Set.mem_ofPred_eq,
    Set.mem_union, not_exists] at hx ⊢
  rcases hfx : f x with _ | y
  · exact Or.inl (fun y h => by cases h)
  · refine Or.inr ⟨y, fun z hz => ?_, rfl⟩
    have := hx z
    rw [hfx] at this
    exact this hz

/-- The identity premap (Definition 4.6, Proposition 4.7, p. 29). -/
def idPremap {X : Type u} (E : Enhanced X) : Premap E E :=
  ⟨fun x => some x, by
    refine ⟨?_, fun s hs => ?_, fun s hs => ?_⟩
    · have : (partialDomain (fun x : X => some x))ᶜ = ∅ := by
        ext x; simp [partialDomain]
      rw [this]
      exact E.sigmaIdeal.1
    · rwa [partialPreimage_id]
    · rwa [partialPreimage_id]⟩

/-- Composition of premaps (Proposition 4.7, p. 29): first `f`, then `g`. -/
def compPremap {X Y Z : Type u} {E : Enhanced X} {F : Enhanced Y} {G : Enhanced Z}
    (f : Premap E F) (g : Premap F G) : Premap E G :=
  ⟨partialCompose g.1 f.1, by
    refine ⟨?_, fun s hs => ?_, fun s hs => ?_⟩
    · refine negligible_mono E (partialDomain_comp_compl g.1 f.1) (negligible_union E f.2.1 ?_)
      exact f.2.2.2 _ g.2.1
    · rw [partialPreimage_comp]
      exact f.2.2.1 _ (g.2.2.1 _ hs)
    · rw [partialPreimage_comp]
      exact f.2.2.2 _ (g.2.2.2 _ hs)⟩

/-! ### The category EMS (Definition 4.13) -/

/-- An object of `EMS`: an enhanced measurable space `(X, M, N)` (Definition 4.4, p. 29). -/
structure EMS : Type (u + 1) where
  /-- The underlying set. -/
  X : Type u
  /-- The σ-algebra `M` and the σ-ideal `N` of negligible sets. -/
  E : Enhanced X

/-- Bundle an enhanced measurable space as an object of `EMS`. -/
def EMS.of (X : Type u) (E : Enhanced X) : EMS.{u} := ⟨X, E⟩

/-- Definition 4.13, pp. 30–31: `EMS` is the quotient of `PreEMS` by weak equality almost
everywhere: morphisms are premaps modulo `f ≈ f'` iff `f* m ⊕ f'* m ∈ N_X` for all `m ∈ M_Y`. -/
instance : Category.{u} EMS.{u} where
  Hom A B := Quot (weakHomRelation A.E B.E)
  id A := Quot.mk _ (idPremap A.E)
  comp {A B C} f g := Quot.lift₂ (fun f g => Quot.mk _ (compPremap f g))
    (fun f g₁ g₂ h => Quot.sound (by
      intro s hs
      simp only [compPremap]
      rw [partialPreimage_comp, partialPreimage_comp, partialPreimage_symmDiff]
      exact f.2.2.2 _ (h s hs)))
    (fun f₁ f₂ g h => Quot.sound (by
      intro s hs
      simp only [compPremap]
      rw [partialPreimage_comp, partialPreimage_comp]
      exact h _ (g.2.2.1 s hs)))
    f g
  id_comp f := by
    induction f using Quot.ind
    rfl
  comp_id f := by
    induction f using Quot.ind with
    | mk f =>
      change Quot.mk _ (compPremap f (idPremap _)) = Quot.mk _ f
      congr 1
      apply Subtype.ext
      funext x
      simp [compPremap, idPremap, partialCompose]
  assoc f g h := by
    induction f using Quot.ind
    induction g using Quot.ind
    induction h using Quot.ind
    rename_i f g h
    change Quot.mk _ (compPremap (compPremap f g) h) = Quot.mk _ (compPremap f (compPremap g h))
    congr 1
    apply Subtype.ext
    funext x
    simp only [compPremap, partialCompose]
    rw [Option.bind_assoc]
    rfl

/-! ### Measures, σ-finiteness, coproducts, strict localizability -/

/-- Definition 4.28, p. 32: a (complex, possibly infinite) measure on `(X, M, N)` is a map
`μ : M' → ℂ` on an ideal `M' ⊂ M` containing `N`, vanishing on `N`, such that for every countable
disjoint family `(m_i)` in `M'` for which `Σ μ(m'_i)` converges absolutely for every family
`m'_i ⊂ m_i` in `M'`, the union lies in `M'` and `μ(⋃ m_i) = Σ μ(m_i)`. Countable families are
indexed by `ℕ` (finite ones are padded with `∅`); values of `μ` outside `M'` are irrelevant.

The first countable-additivity clause records that every restriction `μ|m`, `m ∈ M'`, is a finite
measure on the induced space `(m, M_m, N_m)` in the sense of Remark 4.29, p. 33: a disjoint countable
family in `M'` whose union lies in `M'` has an absolutely convergent sum equal to `μ` of the union.
The page's saturation clause alone constrains `μ` only on families with absolutely convergent
sub-sums, so without this clause a merely finitely additive `μ` would qualify. -/
def IsEMeasure {X : Type u} (E : Enhanced X) (M' : Set (Set X)) (μ : Set X → ℂ) : Prop :=
  M' ⊆ E.measurable ∧ E.negligible ⊆ M' ∧
  (∀ a ∈ M', ∀ b ∈ M', a ∪ b ∈ M') ∧
  (∀ a ∈ M', ∀ b ∈ E.measurable, b ⊆ a → b ∈ M') ∧
  (∀ n ∈ E.negligible, μ n = 0) ∧
  (∀ m : ℕ → Set X, (∀ i, m i ∈ M') → Pairwise (Function.onFun Disjoint m) → (⋃ i, m i) ∈ M' →
    Summable (fun i => ‖μ (m i)‖) ∧ HasSum (fun i => μ (m i)) (μ (⋃ i, m i))) ∧
  ∀ m : ℕ → Set X, (∀ i, m i ∈ M') → Pairwise (Function.onFun Disjoint m) →
    (∀ m' : ℕ → Set X, (∀ i, m' i ∈ M' ∧ m' i ⊆ m i) → Summable (fun i => ‖μ (m' i)‖)) →
    (⋃ i, m i) ∈ M' ∧ HasSum (fun i => μ (m i)) (μ (⋃ i, m i))

/-- Definition 4.28, p. 33: `μ` is faithful if `μ|m = 0` implies `m ∈ N` for every `m ∈ M'`. -/
def IsFaithfulEMeasure {X : Type u} (E : Enhanced X) (M' : Set (Set X)) (μ : Set X → ℂ) :
    Prop :=
  ∀ m ∈ M', (∀ m' ∈ M', m' ⊆ m → μ m' = 0) → m ∈ E.negligible

/-- Definition 4.28, p. 33: `μ` is semifinite if every `m ∈ M \ N` contains some `m' ∈ M' \ N`. -/
def IsSemifiniteEMeasure {X : Type u} (E : Enhanced X) (M' : Set (Set X)) : Prop :=
  ∀ m ∈ E.measurable, m ∉ E.negligible → ∃ m' ∈ M', m' ∉ E.negligible ∧ m' ⊆ m

/-- Definition 4.38, p. 34: `(X, M, N)` is σ-finite if it admits a faithful finite measure
(a measure with `M' = M`; by Remark 4.29 a countably additive map `M → ℂ`, with absolutely
convergent sums, that vanishes on `N`). -/
def IsSigmaFiniteE {X : Type u} (E : Enhanced X) : Prop :=
  ∃ μ : Set X → ℂ, IsEMeasure E E.measurable μ ∧ IsFaithfulEMeasure E E.measurable μ

/-- Lemma 4.25, p. 32: the coproduct `∐ (X_i, M_i, N_i)` in `PreEMS`: a subset `m` of `Σ i, X_i`
is measurable (negligible) iff `m ∩ X_i ∈ M_i` (`∈ N_i`) for every `i`. -/
def coprodEnhanced {I : Type u} {Y : I → Type u} (F : ∀ i, Enhanced (Y i)) :
    Enhanced (Σ i, Y i) where
  measurable := {m | ∀ i, Sigma.mk i ⁻¹' m ∈ (F i).measurable}
  negligible := {n | ∀ i, Sigma.mk i ⁻¹' n ∈ (F i).negligible}
  sigmaAlgebra := by
    refine ⟨fun i => ?_, fun a ha i => ?_, fun a ha i => ?_⟩
    · simpa using (F i).sigmaAlgebra.1
    · rw [Set.preimage_compl]
      exact (F i).sigmaAlgebra.2.1 _ (ha i)
    · rw [Set.preimage_iUnion]
      exact (F i).sigmaAlgebra.2.2 _ (fun j => ha j i)
  sigmaIdeal := by
    refine ⟨fun i => ?_, fun a b hab hb i => ?_, fun a ha i => ?_⟩
    · simpa using (F i).sigmaIdeal.1
    · exact (F i).sigmaIdeal.2.1 _ _ (Set.preimage_mono hab) (hb i)
    · rw [Set.preimage_iUnion]
      exact (F i).sigmaIdeal.2.2 _ (fun j => ha j i)
  negligibleMeasurable := fun n hn i => (F i).negligibleMeasurable (hn i)

/-- Definition 4.48, p. 35: `(X, M, N)` is strictly localizable if it is isomorphic in `PreEMS` to
the coproduct of a small family of σ-finite enhanced measurable spaces: there are premaps `f`, `g`
whose two composites are the identity premaps. -/
def IsStrictlyLocalizable {X : Type u} (E : Enhanced X) : Prop :=
  ∃ (I : Type u) (Y : I → Type u) (F : ∀ i, Enhanced (Y i)), (∀ i, IsSigmaFiniteE (F i)) ∧
    ∃ (f : Premap E (coprodEnhanced F)) (g : Premap (coprodEnhanced F) E),
      partialCompose g.1 f.1 = (fun x => some x) ∧ partialCompose f.1 g.1 = (fun y => some y)

/-- The objects of `CSLEMS` (Definition 4.59, p. 37): compact (Definition 4.57) and strictly
localizable (Definition 4.48) enhanced measurable spaces. -/
def IsCSL : ObjectProperty EMS.{u} :=
  fun A => IsCompactEnhancedOn A.E Set.univ ∧ IsStrictlyLocalizable A.E

/-- Definition 4.59, p. 37: `CSLEMS` is the full subcategory of `EMS` on the compact strictly
localizable enhanced measurable spaces. -/
abbrev CSLEMS : Type (u + 1) := IsCSL.{u}.FullSubcategory

/-- Proposition 4.65, p. 39: `m ∈ M'` is a measurable image of the premap
`f : (X, M, N) → (X', M', N')` if `f* (X' \ m) ∈ N` and every `m' ∈ M'` with `m' ⊂ m` and
`f* m' ∈ N` lies in `N'`. -/
def IsMeasurableImage {X Y : Type u} (E : Enhanced X) (F : Enhanced Y) (f : Premap E F)
    (m : Set Y) : Prop :=
  m ∈ F.measurable ∧ partialPreimage f.1 mᶜ ∈ E.negligible ∧
    ∀ m' ∈ F.measurable, m' ⊆ m → partialPreimage f.1 m' ∈ E.negligible → m' ∈ F.negligible

/-! ### The Boolean algebra `M/N` and the pull-back (Definitions 5.8–5.10) -/

/-- Equality modulo negligible sets on `M`: `m ~ m'` iff `m ⊕ m' ∈ N`. -/
def nullSetoid {X : Type u} (E : Enhanced X) : Setoid {m : Set X // m ∈ E.measurable} where
  r a b := (a.1 \ b.1) ∪ (b.1 \ a.1) ∈ E.negligible
  iseqv := by
    refine ⟨fun a => ?_, fun h => ?_, fun h₁ h₂ => ?_⟩
    · simpa using E.sigmaIdeal.1
    · rwa [Set.union_comm]
    · refine negligible_mono E ?_ (negligible_union E h₁ h₂)
      intro x hx
      simp only [Set.mem_union, Set.mem_sdiff] at hx ⊢
      tauto

/-- Definition 5.8, p. 41: the quotient `M/N` of measurable sets modulo negligible sets. -/
def MmodN {X : Type u} (E : Enhanced X) : Type u := Quotient (nullSetoid E)

/-- The class `[m] ∈ M/N` of a measurable set. -/
def MmodN.mk {X : Type u} {E : Enhanced X} (m : Set X) (hm : m ∈ E.measurable) : MmodN E :=
  Quotient.mk (nullSetoid E) ⟨m, hm⟩

/-- The order of `M/N`: `[m] ≤ [m']` iff `m \ m' ∈ N`. -/
instance {X : Type u} (E : Enhanced X) : PartialOrder (MmodN E) where
  le := Quotient.lift₂ (fun a b => a.1 \ b.1 ∈ E.negligible) (by
    intro a b a' b' ha hb
    apply propext
    constructor
    · intro h
      refine negligible_mono E ?_ (negligible_union E (negligible_union E ha h) hb)
      intro x hx
      simp only [Set.mem_union, Set.mem_sdiff] at hx ⊢
      tauto
    · intro h
      refine negligible_mono E ?_ (negligible_union E (negligible_union E ha h) hb)
      intro x hx
      simp only [Set.mem_union, Set.mem_sdiff] at hx ⊢
      tauto)
  le_refl a := by
    induction a using Quotient.ind
    simpa using E.sigmaIdeal.1
  le_trans a b c := by
    induction a using Quotient.ind
    induction b using Quotient.ind
    induction c using Quotient.ind
    intro h₁ h₂
    refine negligible_mono E ?_ (negligible_union E h₁ h₂)
    intro x hx
    simp only [Set.mem_union, Set.mem_sdiff] at hx ⊢
    tauto
  le_antisymm a b := by
    induction a using Quotient.ind
    induction b using Quotient.ind
    intro h₁ h₂
    exact Quotient.sound (negligible_union E h₁ h₂)

/-- Definition 5.8, p. 41: a premap `f : (X, M, N) → (Y, M', N')` induces `f* : M'/N' → M/N`,
`[m] ↦ [f* m]`. -/
def pullPremap {X Y : Type u} {E : Enhanced X} {F : Enhanced Y} (f : Premap E F) :
    MmodN F → MmodN E :=
  Quotient.map (fun m => ⟨partialPreimage f.1 m.1, f.2.2.1 _ m.2⟩) (by
    intro a b h
    change (_ \ _) ∪ (_ \ _) ∈ E.negligible
    rw [partialPreimage_symmDiff]
    exact f.2.2.2 _ h)

/-- Definition 5.8, p. 41: the map `M'/N' → M/N` induced by a morphism of `EMS` (weakly equal
premaps induce the same map). -/
def pullHom {A B : EMS.{u}} (f : A ⟶ B) : MmodN B.E → MmodN A.E :=
  Quot.lift (fun g : Premap A.E B.E => pullPremap g) (by
    intro g g' h
    funext q
    induction q using Quotient.ind with
    | _ m => exact Quotient.sound (h m.1 m.2)) f

/-! ### The functor TM on objects (Definition 5.2) and the Stone spectrum -/

lemma isMeagre_symmDiff_iff {S : Type u} [TopologicalSpace S] (s t : Set S) :
    IsMeagre (symmDiff s t) ↔ s =ᶠ[residual S] t := by
  rw [IsMeagre, Filter.eventuallyEq_set]
  have : (symmDiff s t)ᶜ = {x | x ∈ s ↔ x ∈ t} := by
    ext x
    simp only [Set.mem_compl_iff, Set.mem_symmDiff, Set.mem_ofPred_eq]
    tauto
  rw [this]
  rfl

lemma baire_iff {S : Type u} [TopologicalSpace S] (s : Set S) :
    (∃ v, IsOpen v ∧ IsMeagre (symmDiff s v)) ↔ BaireMeasurableSet s := by
  rw [BaireMeasurableSet.iff_residualEq_isOpen]
  simp only [isMeagre_symmDiff_iff]

/-- Definition 5.2, p. 40: `TM(S) = (S, M, N)` with `N` the meager subsets of `S` and `M` the
subsets with the property of Baire, i.e. the symmetric differences `u ⊕ n` of an open set `u` and
a meager set `n`. -/
def TM (S : Type u) [TopologicalSpace S] : Enhanced S where
  measurable := {s | ∃ v, IsOpen v ∧ IsMeagre (symmDiff s v)}
  negligible := {s | IsMeagre s}
  sigmaAlgebra := by
    refine ⟨?_, fun a ha => ?_, fun a ha => ?_⟩
    · exact (baire_iff _).2 (IsOpen.baireMeasurableSet isOpen_empty)
    · exact (baire_iff _).2 (((baire_iff _).1 ha).compl)
    · exact (baire_iff _).2 (BaireMeasurableSet.iUnion fun i => (baire_iff _).1 (ha i))
  sigmaIdeal := by
    refine ⟨IsMeagre.empty, fun a b hab hb => IsMeagre.mono hab hb, fun a ha => ?_⟩
    exact isMeagre_iUnion ha
  negligibleMeasurable := fun n hn => ⟨∅, isOpen_empty, by rwa [show symmDiff n ∅ = n from symmDiff_bot n]⟩

/-- The Stone spectrum of a Boolean algebra `B` (Remark 2.32, Definition 2.9): the space of
Boolean homomorphisms `B → Z/2`, i.e. the points of the locale `Ideal(B)`. -/
def stoneSpectrum (B : Type u) [BooleanAlgebra B] : Type u := BoundedLatticeHom B Bool

/-- The topology of `Sp(Ideal(B))`: the opens are the images `{p | ∃ b ∈ I, p b = 1}` of the
ideals `I`, i.e. the topology generated by the basic sets `{p | p b = 1}`. -/
instance (B : Type u) [BooleanAlgebra B] : TopologicalSpace (stoneSpectrum B) :=
  TopologicalSpace.generateFrom
    {U | ∃ b : B, U = {p : stoneSpectrum B | (show BoundedLatticeHom B Bool from p) b = true}}

end GelfandVNA.Duality


