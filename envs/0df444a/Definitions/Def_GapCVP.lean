      2 ^ Nat.clog 2 target := by
  rw [nextPowerStep_iterate]
  have hclog : Nat.clog 2 target ≤ target :=
    (Nat.clog_le_iff_le_pow
      (by norm_num : 1 < (2 : ℕ))).mpr (nat_le_two_pow target)
  rw [Nat.min_eq_right hclog]
