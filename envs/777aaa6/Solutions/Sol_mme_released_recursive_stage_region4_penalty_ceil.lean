        ((n3 4 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by
    intro r
    have hcast : (fun c ↦ ((m3 4 r c : ℕ) : ℝ) / ((n3 4 r : ℕ) : ℝ)) =
