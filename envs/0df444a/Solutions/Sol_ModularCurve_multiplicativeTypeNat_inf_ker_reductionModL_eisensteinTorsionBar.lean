attribute [local instance] ModularCurve.heckeModuleBar

theorem isPrimitiveRoot_neg_one : IsPrimitiveRoot (-1 : AlgebraicClosure ℚ) 2 := by
  constructor
  · rw [neg_one_sq]
  · intro l hl
    rcases Nat.even_or_odd l with he | ho
    · obtain ⟨k, hk⟩ := he
      exact ⟨k, by omega⟩
    · rw [ho.neg_one_pow] at hl
      exact absurd hl (by norm_num)

theorem apply_neg_one (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    σ (-1 : AlgebraicClosure ℚ) = -1 := by
  rw [map_neg, map_one]

theorem neg_one_pow_two_pow {m' : ℕ} : (-1 : AlgebraicClosure ℚ) ^ (2 ^ (m' + 1)) = 1 := by
  rw [show (2 : ℕ) ^ (m' + 1) = 2 * 2 ^ m' from by rw [pow_succ, Nat.mul_comm], pow_mul,
    neg_one_sq, one_pow]

theorem smul_sub_nsmul_mem_map {p : ℕ} {M : Type*} [AddCommGroup M]
    (f : M →+ JZero p) (φσ : M → M)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hφ : ∀ w : M, f (φσ w) = σ • f w)
    (A : AddSubgroup M) (a : ℕ) (x : M) (h : φσ x - a • x ∈ A) :
    σ • f x - a • f x ∈ A.map f := by
  refine AddSubgroup.mem_map.mpr ⟨φσ x - a • x, h, ?_⟩
  rw [map_sub, map_nsmul, hφ]

theorem smul_sub_mem_map {p : ℕ} {M : Type*} [AddCommGroup M]
    (f : M →+ JZero p) (φσ : M → M)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hφ : ∀ w : M, f (φσ w) = σ • f w)
    (A : AddSubgroup M) (x : M) (h : φσ x - x ∈ A) :
    σ • f x - f x ∈ A.map f := by
  refine AddSubgroup.mem_map.mpr ⟨φσ x - x, h, ?_⟩
  rw [map_sub, hφ]

variable {p : ℕ} [Fact p.Prime]

section Transport

variable {m : ℕ}

abbrev TT (p : ℕ) [Fact p.Prime] (m : ℕ) : Submodule HeckeAlg (JZero p) :=
  Submodule.torsionBySet HeckeAlg (JZero p)
    (↑((eisensteinMaximalIdeal p 2) ^ m) : Set HeckeAlg)

abbrev ι (p : ℕ) [Fact p.Prime] (m : ℕ) : ↥(TT p m) →+ JZero p :=
  (TT p m).subtype.toAddMonoidHom

theorem ι_injective : Function.Injective (ι p m) :=
  fun _ _ h => Subtype.ext h

theorem chain_step_stab {M : Type*} [AddCommGroup M] {Φ : OpenAction M}
    (c : AdmissibleChain 2 Φ) :
    ∀ i : Fin (c.n + 1), ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
      ∀ x ∈ c.step i, Φ.φ σ x ∈ c.step i := by
  intro i
  induction i using Fin.induction with
  | zero =>
    intro σ x hx
    rw [c.hbot] at hx ⊢
    rw [AddSubgroup.mem_bot] at hx
    rw [hx, map_zero]
    exact AddSubgroup.mem_bot.mpr rfl
  | succ j _ =>
    intro σ x hx
    have hact := c.hact j
    rcases htag : c.tag j with _ | _
    ·
      rw [htag, if_neg (by decide : ¬ (false = true))] at hact
      have h1 := hact σ (-1) isPrimitiveRoot_neg_one 1 (by rw [pow_one]; exact apply_neg_one σ) x hx
      rw [one_smul] at h1
      simpa using add_mem (c.hmono j h1) hx
    ·
      rw [htag, if_pos rfl] at hact
      have h1 := hact σ x hx
      simpa using add_mem (c.hmono j h1) hx

theorem card_quotient_map_of_injective {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    (f : G →+ H) (hf : Function.Injective f) (A B : AddSubgroup G) :
    Nat.card (↥(B.map f) ⧸ (A.map f).addSubgroupOf (B.map f))
      = Nat.card (↥B ⧸ A.addSubgroupOf B) := by
  let e1 : ↥B ≃+ ↥(B.map f) := AddSubgroup.equivMapOfInjective _ _ hf
  have hcoe1 : ∀ w : ↥B, ((e1 w : ↥(B.map f)) : H) = f (w : G) := fun _ => rfl
  have he : (A.addSubgroupOf B).map e1.toAddMonoidHom = (A.map f).addSubgroupOf (B.map f) := by
    ext z
    simp only [AddSubgroup.mem_map, AddSubgroup.mem_addSubgroupOf, AddEquiv.coe_toAddMonoidHom]
    constructor
    · rintro ⟨w, hw, rfl⟩
      rw [hcoe1]
      exact AddSubgroup.mem_map.mpr ⟨(w : G), hw, rfl⟩
    · intro hz
      obtain ⟨a, ha, haz⟩ := AddSubgroup.mem_map.mp hz
      obtain ⟨b, hb, hbz⟩ := AddSubgroup.mem_map.mp z.2
      have hab : a = b := hf (by rw [haz, hbz])
      subst hab
      refine ⟨⟨a, hb⟩, ha, ?_⟩
      apply Subtype.ext
      rw [hcoe1, hbz]
  exact (Nat.card_congr (QuotientAddGroup.congr _ _ e1 he).toEquiv).symm

theorem exists_ambient_chain (p : ℕ) [Fact p.Prime] (m' : ℕ)
    (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ)
    (hn : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ (m' + 1)) = 1 → σ ζ = ζ ^ n σ) :
    ∃ (r : ℕ) (step : Fin (r + 1) → AddSubgroup (JZero p)),
      step 0 = ⊥ ∧
      step (Fin.last r) = eisensteinTorsionBar p 2 (m' + 1) ∧
      (∀ i : Fin r, step i.castSucc ≤ step i.succ) ∧
      (∀ i : Fin (r + 1), ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
        ∀ x ∈ step i, σ • x ∈ step i) ∧
      (∀ i : Fin r,
        Nat.card (↥(step i.succ) ⧸ (step i.castSucc).addSubgroupOf (step i.succ)) = 2) ∧
      (∀ i : Fin r,
        (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ x ∈ step i.succ,
          σ • x - x ∈ step i.castSucc) ∨
        (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ x ∈ step i.succ,
          σ • x - n σ • x ∈ step i.castSucc)) := by
  obtain ⟨Φ, hΦ, ⟨c⟩⟩ :=
    ModularCurve.eisensteinPrimaryTorsion_isMazurAdmissible_heckeModuleBar p
      (ModularCurve.heckeOperatorsCommuteBar p) 2 Nat.prime_two (m' + 1)
  refine ⟨c.n, fun i => (c.step i).map (ι p (m' + 1)), ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    show (c.step 0).map (ι p (m' + 1)) = ⊥
    rw [c.hbot]
    exact AddSubgroup.map_bot _
  ·
    show (c.step (Fin.last c.n)).map (ι p (m' + 1)) = eisensteinTorsionBar p 2 (m' + 1)
    rw [c.htop]
    ext y
    simp only [AddSubgroup.mem_map, AddSubgroup.mem_top, true_and]
    constructor
    · rintro ⟨x, rfl⟩
      exact x.2
    · intro hy
      exact ⟨⟨y, hy⟩, rfl⟩
  ·
    intro i
    exact AddSubgroup.map_mono (c.hmono i)
  ·
    intro i σ y hy
    obtain ⟨x, hx, rfl⟩ := AddSubgroup.mem_map.mp hy
    exact AddSubgroup.mem_map.mpr ⟨Φ.φ σ x, chain_step_stab c i σ x hx, hΦ σ x⟩
  ·
    intro i
    exact (card_quotient_map_of_injective (ι p (m' + 1)) ι_injective
      (c.step i.castSucc) (c.step i.succ)).trans (c.hcard i)
  ·
    intro i
    rcases htag : c.tag i with _ | _
    ·
      right
      intro σ y hy
      obtain ⟨x, hx, rfl⟩ := AddSubgroup.mem_map.mp hy
      have hact := c.hact i
      rw [htag, if_neg (by decide : ¬ (false = true))] at hact
      have hζ : σ (-1 : AlgebraicClosure ℚ) = (-1) ^ n σ := hn σ (-1) neg_one_pow_two_pow
      have h1 := hact σ (-1) isPrimitiveRoot_neg_one (n σ) hζ x hx
      exact smul_sub_nsmul_mem_map (ι p (m' + 1)) (Φ.φ σ) σ (hΦ σ) (c.step i.castSucc) (n σ) x h1
    ·
      left
      intro σ y hy
      obtain ⟨x, hx, rfl⟩ := AddSubgroup.mem_map.mp hy
      have hact := c.hact i
      rw [htag, if_pos rfl] at hact
      have h1 := hact σ x hx
      exact smul_sub_mem_map (ι p (m' + 1)) (Φ.φ σ) σ (hΦ σ) (c.step i.castSucc) x h1

end Transport

theorem multiplicativeTypeNat_m_zero
    (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ)
    (B : ValuationSubring (AlgebraicClosure ℚ)) :
    MultiplicativeTypeNat (B.inertiaSubgroupIn ℚ) n
      (eisensteinTorsionBar p 2 0 ⊓ (reductionModL B p).ker) := by
  intro σ _ x hx
  have hx0 : x = 0 := by
    have hmem : x ∈ eisensteinTorsionBar p 2 0 := (AddSubgroup.mem_inf.mp hx).1
    have h1 : (1 : HeckeAlg) ∈ (↑((eisensteinMaximalIdeal p 2) ^ 0) : Set HeckeAlg) := by
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    have := (Submodule.mem_torsionBySet_iff _ _).mp hmem ⟨1, h1⟩
    rwa [one_smul] at this
  rw [hx0, smul_zero, smul_zero]

