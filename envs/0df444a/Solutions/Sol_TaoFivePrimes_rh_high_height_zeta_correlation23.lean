  change (decide (finalOutput.length=1025 ∧ expected.length=1025) && (finalOutput.zip expected).all (fun p => decide (p.1=p.2)))=true at h
  simp only [Bool.and_eq_true,decide_eq_true_eq] at h
  exact eq_of_zip_check _ _ (by omega) h.2
