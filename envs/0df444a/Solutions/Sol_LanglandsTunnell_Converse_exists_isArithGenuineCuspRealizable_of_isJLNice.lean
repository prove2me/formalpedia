private theorem eventually_isIntegral_compAt (g : AdelicGL2 (𝓞 K) K) :
    ∀ᶠ w : HeightOneSpectrum (𝓞 K) in Filter.cofinite,
      LocalWhittaker.IsIntegral Valued.v (compAt w g) ∧ LocalWhittaker.IsIntegral Valued.v (compAt w g)⁻¹ := by
