theorem child24_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu109.lin : ℝ) ≤ (S : ℝ) * logProd gu109.lo) :
    (gu112.lfin : ℝ) ≤ (S : ℝ) * logProd gu112.top ∧
      (∀ x : ℝ, (gu109.lo : ℝ) < x → x ≤ (gu112.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u109 hγ hstate
  have s1 := sol_u110 hγ (by simpa [gu109, gu110] using s0.1)
  have s2 := sol_u111 hγ (by simpa [gu110, gu111] using s1.1)
  have s3 := sol_u112 hγ (by simpa [gu111, gu112] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu109.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu110.lo : ℝ) < x := by
        have hb : (gu109.top : ℝ) = (gu110.lo : ℝ) := by simp [gu109, gu110]
        linarith
    by_cases h1 : x ≤ (gu110.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu111.lo : ℝ) < x := by
          have hb : (gu110.top : ℝ) = (gu111.lo : ℝ) := by simp [gu110, gu111]
          linarith
      by_cases h2 : x ≤ (gu111.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu112.lo : ℝ) < x := by
            have hb : (gu111.top : ℝ) = (gu112.lo : ℝ) := by simp [gu111, gu112]
            linarith
        exact s3.2 x hx3 htop

