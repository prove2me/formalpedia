variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.prepStep_runs (s : IState NS) (n M Q e : ℕ) (y c : ℤ) (LX LW LC LM LQ LN LF : List Item)
    (hM : M ≤ n) (he : e ≤ n) (hQ : Q ≤ n) (hc : zsz c ≤ n)
    (hX : s.G XA = .int y :: LX) (hW : s.G W = .int (2 ^ e) :: LW) (hC : s.G CC = .int c :: LC)
    (hRM : s.G RMs = .int (2 ^ M) :: LM) (hRQ : s.G RQ = .int (2 ^ Q) :: LQ)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog prepStep s
      ((((s.upd XA (.int (sg y (y.natAbs / 2 ^ M)) :: LX)).upd QS
        (.int ((sg y (y.natAbs % 2 ^ M) * 2 ^ e) % (2 ^ n + 1)) :: s.G QS)).upd W
          (.int (2 ^ (e + Q)) :: LW)).upd CC (.int (c + -1) :: LC))
      (30000 * (n + 3)) := by sorry
