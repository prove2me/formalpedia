-- title:
--   Farkas' lemma, cone form: membership in the cone generated by $A_1,\dots,A_n$
-- statement:
--   **(Corollary 4.3)** Let $A_1, \dots, A_n$ and $b$ be given vectors and suppose that any vector $p$ that satisfies $p'A_i \ge 0$, $i = 1, \dots, n$, must also satisfy $p'b \ge 0$.
--
--   Then, $b$ can be expressed as a nonnegative linear combination of the vectors $A_1, \dots, A_n$.
-- source:
--   Bertsimas & Tsitsiklis, Introduction to Linear Optimization, Athena Scientific, 1997, Corollary 4.3, p. 166

import Mathlib.Data.Matrix.Mul
import Mathlib.Data.Real.Basic


open Matrix

/-- **Bertsimas & Tsitsiklis, Corollary 4.3 (p. 166).** If every `p` with `p'Aᵢ ≥ 0` for all
`i` also has `p'b ≥ 0`, then `b` is a nonnegative linear combination of
the `Aᵢ`. -/

theorem LinearOptimization.farkas_cone_corollary {m n : ℕ} (A : Fin n → (Fin m → ℝ))
    (b : Fin m → ℝ)
    (h : ∀ p : Fin m → ℝ, (∀ i, 0 ≤ p ⬝ᵥ A i) → 0 ≤ p ⬝ᵥ b) :
    ∃ lam : Fin n → ℝ, (∀ i, 0 ≤ lam i) ∧ b = ∑ i, lam i • A i := by
  sorry
