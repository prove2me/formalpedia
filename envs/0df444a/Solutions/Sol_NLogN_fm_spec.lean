      omega
    -- segment E: child parameters
    set s2 := (s1.upd DL (.int (h : ℤ) :: .int (2 ^ (j + 1)) :: LL)).upd NLogN.DE
      (.int (2 ^ (2 * E)) :: .int (2 ^ E) :: LE) with hs2
    have hE : IRuns I iprog difSegE s1 s2 (2000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      have e : (2 : ℤ) ^ E * 2 ^ E = 2 ^ (2 * E) := by ring
      simp +decide [difSegE, IStmt.run, IOp.run, s1, hL, hDE, e]
      refine ⟨by simp only [hs2, hs1]; clear * - hL hDE; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := dupCost_le (zsz (h : ℤ)); have := dupCost_le (zsz ((2 : ℤ) ^ E))
      have := shlCost_le E; have := moveIntCost_le (zsz ((2 : ℤ) ^ (2 * E)))
      simp only [NLogN.zsz_two_pow] at *
      have := hzh
      omega
    -- first recursive call (top half)
    have hc1 := ih s2 top (ints bot ++ R) (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF
      (2 * E) (by rw [htopl, hh]) (by right; rw [← hh]; linarith) hctop
      (by simp +decide [s2, s1, hX, hBlh, ints_append])
      (by simp +decide [s2, e3]) (by simp +decide [s2])
      (by simp +decide [s2, s1, hN]) (by simp +decide [s2, s1, hF])
    set s3 := s2.upd DX (ints dt ++ (ints bot ++ R)) with hs3
    have hB' := mvH_runs (I := I) (iprog := iprog) (X := DX) (Y := U) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s3 dt (ints bot ++ R) (s.G HH)
      (n + 1) (by simp [s3]) (by simp +decide [s3, s2, s1, hdtl]) (canon_bnd hcdt)
    set s4 := (s3.upd DX (ints bot ++ R)).upd U ((ints dt).reverse ++ s3.G U) with hs4
    -- second recursive call (bottom half)
    have hc2 := ih s4 bot R (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF
      (2 * E) (by rw [hbotl, hh]) (by right; rw [← hh]; linarith) hcbot
      (by simp +decide [s4])
      (by simp +decide [s4, s3, s2, e3]) (by simp +decide [s4, s3, s2])
      (by simp +decide [s4, s3, s2, s1, hN]) (by simp +decide [s4, s3, s2, s1, hF])
    set s5 := s4.upd DX (ints db ++ R) with hs5
    -- segment F: drop the child parameters
