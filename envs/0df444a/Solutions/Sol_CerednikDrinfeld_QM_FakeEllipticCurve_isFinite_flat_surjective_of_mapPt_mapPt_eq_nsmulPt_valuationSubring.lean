open scoped Quaternion

variable {R : Type u} [CommRing R] {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}

theorem topologicalKrullDim_fibreScheme (𝒜 : FakeEllipticCurve Λ N R)
    (s : (Spec (CommRingCat.of R) : Scheme.{u})) :
    topologicalKrullDim ↥(fibreScheme 𝒜.f s) = 2 := by
  rw [← 𝒜.dim_fibre s]
  exact IsHomeomorph.topologicalKrullDim_eq _ (𝒜.f.fiberHomeo s).isHomeomorph

theorem isFinite_flat_surjective_pullback_snd_fiberι (𝒜 𝒟 : FakeEllipticCurve Λ N R)
    (Φ : 𝒜.A ⟶ 𝒟.A) (hΦ : Φ ≫ 𝒟.f = 𝒜.f)
    (Ψ : 𝒟.A ⟶ 𝒜.A) (hΨ : Ψ ≫ 𝒜.f = 𝒟.f) (n : ℕ) (hn : 0 < n)
    (hΨΦ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t 𝒜.f),
      mapPt Ψ hΨ (mapPt Φ hΦ P) = nsmulPt 𝒜.L t n P)
    (s : (Spec (CommRingCat.of R) : Scheme.{u})) :
    IsFinite (pullback.snd Φ (𝒟.f.fiberι s)) ∧ Flat (pullback.snd Φ (𝒟.f.fiberι s)) ∧
      Surjective (pullback.snd Φ (𝒟.f.fiberι s)) := by
  have hA := abelianSchemePropertyBundle_fibreStr 𝒜.bundle s
  have hD := abelianSchemePropertyBundle_fibreStr 𝒟.bundle s
  haveI : IsIntegral (fibreScheme 𝒜.f s) := hA.isIntegral_of_field
  haveI : IsIntegral (fibreScheme 𝒟.f s) := hD.isIntegral_of_field
  haveI : IsProper (fibreStr 𝒜.f s) := hA.proper
  haveI : IsProper (fibreStr 𝒟.f s) := hD.proper
  haveI : IsSeparated (fibreStr 𝒟.f s) := inferInstance
  haveI : SmoothOfRelativeDimension 2 (fibreStr 𝒜.f s) :=
    smoothOfRelativeDimension_of_topologicalKrullDim_eq _ hA 2 (topologicalKrullDim_fibreScheme 𝒜 s)
  haveI : SmoothOfRelativeDimension 2 (fibreStr 𝒟.f s) :=
    smoothOfRelativeDimension_of_topologicalKrullDim_eq _ hD 2 (topologicalKrullDim_fibreScheme 𝒟 s)

  have hcomp : fibreHom Φ hΦ s ≫ fibreHom Ψ hΨ s = (𝒜.L.fibre s).schemeNsmul n :=
    comp_eq_schemeNsmul (𝒜.L.fibre s) (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s)
      (fibreHom Ψ hΨ s) (fibreHom_over Ψ hΨ s) n
      (fun t' x => mapPt_fibreHom_mapPt_fibreHom_eq_nsmulPt Φ hΦ s 𝒜.L Ψ hΨ n hΨΦ t' x)
  have hLQF : LocallyQuasiFinite ((𝒜.L.fibre s).schemeNsmul n) :=
    locallyQuasiFinite_schemeNsmul_of_field (𝒜.L.fibre s) hA
      (fun t' x y => by rw [fibre_mul, fibre_mul, RelativeGroupLaw.IsCommutative.mul_comm 𝒜.comm]) n hn
  rw [← hcomp] at hLQF
  haveI := hLQF
  haveI : LocallyQuasiFinite (fibreHom Φ hΦ s) := .of_comp _ (fibreHom Ψ hΨ s)
  obtain ⟨h1, h2, h3⟩ := AlgebraicGeometry.isFinite_and_flat_and_surjective_of_locallyQuasiFinite_of_smoothOfRelativeDimension (fibreStr 𝒜.f s) (fibreStr 𝒟.f s) 2 (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s)
  exact ⟨(fibreHom_iff_pullback_snd_fiberι Φ hΦ s @IsFinite).mp h1,
    (fibreHom_iff_pullback_snd_fiberι Φ hΦ s @Flat).mp h2,
    (fibreHom_iff_pullback_snd_fiberι Φ hΦ s @Surjective).mp h3⟩

