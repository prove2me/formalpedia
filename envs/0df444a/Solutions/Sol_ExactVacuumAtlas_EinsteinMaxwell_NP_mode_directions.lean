/-! # Single-mode frame derivatives and III's `j = 0` operators (ATLAS-V-01)

For real `ω`, `m` (`om`, `mm`; III's local real mode parameters — no integrality of `m`, no complex frequency) and an
**arbitrary** function `u : ℝ² → ℂ` of `(r, θ)` (III's coordinates, index `0 = r`, `1 = θ`), the four-dimensional
mode field is `modeField om mm u (t,r,θ,φ) = P(t,φ) u(r,θ)` with `P = exp(−iωt + imφ)` (`phaseP`; the phase
convention of Hintz arXiv:2609.33661v1 and of III). Derivatives are the complex-valued **real** slice derivatives
`cpdC` (`Atlas.EinsteinMaxwell.NP.Basic`); the frame acts by `cdir` (complex-linear combination of real partials).

Bridge to III's existing two-dimensional derivative `Hintz2026.cpd` (not a copy): `cpdC_mode_r`, `cpdC_mode_th`
(`∂_r`, `∂_θ` of the mode field are `P` times III's `cpd 0`, `cpd 1` of `u` at `toRT x = (r, θ)`), together with
`∂_t ↦ −iω`, `∂_φ ↦ im`. With `K = −(r²+a²)ω + am`, `Q̂ = −aω sinθ + m/sinθ`:

    l(P u)  = P (∂_r u + iK/Δ u)                       = P · Dop    p 0 ω m u     (every x)
    n(P u)  = P (−Δ/(2Σ)) (∂_r u − iK/Δ u)             = P (−Δ/(2Σ)) · DopDag p 0 ω m u   (Δ ≠ 0)
    m(P u)  = P/(√2 q) (∂_θ u − Q̂ u)                    = P/(√2 ρ̄) · LopDag p 0 ω m u  (every x)
    m̄(P u)  = P/(√2 q̄) (∂_θ u + Q̂ u)                    = P/(√2 ρ̄*) · Lop  p 0 ω m u   (every x)

where `Dop`, `DopDag`, `Lop`, `LopDag` are III's original definitions (`Atlas/Perturbations/Hintz2026/System1Defs.lean`)
at `j = 0`, imported unchanged. The general-parameter forms `dir_*_mode` hold for every real `M a Q` (`a = 0`, `Q = 0`
allowed); III's `SubextremalKN p` enters only in the `*_eq_Dop…` bridges. The identities need no regularity of `u`
(both sides use the same `deriv` semantics); for `u` `C^∞` (order `∞`) on III's `U p`, the mode field is `C^∞` on
`domKN` and every `cpdC` is a genuine derivative (`hasDerivAt_modeField`). `P ≠ 0`, so each frame derivative vanishes iff
the corresponding III operator does (`dir_*_eq_zero_iff`; no division by `ω` or `m`, `ω = 0`, `m = 0` included).
Only `j = 0` is claimed: the `j`-dependent connection terms of III's system (1) are not derived here (V-02/V-03). -/

open Real
open scoped ComplexConjugate ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del domReg domKN domReg_D)

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

/-! ### Definitions -/

/-! ### Coordinate bookkeeping -/

section Coord
variable (om mm : ℝ) (x : Pt 4) (s : ℝ)

theorem toRT_zero : toRT x 0 = x 1 := rfl

theorem toRT_one : toRT x 1 = x 2 := rfl

theorem toRT_update_r : toRT (Function.update x 1 s) = Function.update (toRT x) 0 s := by
  funext k; fin_cases k <;> simp [toRT]

theorem toRT_update_th : toRT (Function.update x 2 s) = Function.update (toRT x) 1 s := by
  funext k; fin_cases k <;> simp [toRT]

theorem phaseP_update_r : phaseP om mm (Function.update x 1 s) = phaseP om mm x := by
  simp [phaseP]

theorem phaseP_update_th : phaseP om mm (Function.update x 2 s) = phaseP om mm x := by
  simp [phaseP]

end Coord

/-! ### The four coordinate derivatives of a mode field (arbitrary `u`) -/

section Partials
variable (om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4)

/-- `∂_r` of the mode field is `P` times **III's** `cpd 0 u` at `(r, θ)`. -/
theorem cpdC_mode_r : cpdC 1 (modeField om mm u) x = phaseP om mm x * Hintz2026.cpd 0 u (toRT x) := by
  unfold cpdC Hintz2026.cpd
  have e : (fun s : ℝ => modeField om mm u (Function.update x 1 s)) =
      fun s : ℝ => phaseP om mm x * u (Function.update (toRT x) 0 s) := by
    funext s; simp only [modeField, phaseP_update_r, toRT_update_r]
  rw [e, deriv_const_mul_field]
  rfl

/-- `∂_θ` of the mode field is `P` times **III's** `cpd 1 u` at `(r, θ)`. -/
theorem cpdC_mode_th : cpdC 2 (modeField om mm u) x = phaseP om mm x * Hintz2026.cpd 1 u (toRT x) := by
  unfold cpdC Hintz2026.cpd
  have e : (fun s : ℝ => modeField om mm u (Function.update x 2 s)) =
      fun s : ℝ => phaseP om mm x * u (Function.update (toRT x) 1 s) := by
    funext s; simp only [modeField, phaseP_update_th, toRT_update_th]
  rw [e, deriv_const_mul_field]
  rfl

end Partials

/-! ### The four frame directions on a mode field (every real `M a Q`) -/

section Directions
variable (M a Q om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4)

theorem dir_l_mode : cdir (knL M a Q x) (modeField om mm u) x =
    phaseP om mm x * (Hintz2026.cpd 0 u (toRT x) +
      Complex.I * (((-(x 1 ^ 2 + a ^ 2) * om + a * mm) / Del M a Q (x 1) : ℝ) : ℂ) * u (toRT x)) := by
  simp only [cdir, Fin.sum_univ_four, cpdC_mode_t, cpdC_mode_r, cpdC_mode_th, cpdC_mode_phi, modeField]
  simp [knL]
  ring

theorem dir_n_mode (hD : Del M a Q (x 1) ≠ 0) : cdir (knN M a Q x) (modeField om mm u) x =
    phaseP om mm x * (-((Del M a Q (x 1) / (2 * Sig a (x 1) (x 2)) : ℝ) : ℂ)) * (Hintz2026.cpd 0 u (toRT x) -
      Complex.I * (((-(x 1 ^ 2 + a ^ 2) * om + a * mm) / Del M a Q (x 1) : ℝ) : ℂ) * u (toRT x)) := by
  have hDc : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hD
  simp only [cdir, Fin.sum_univ_four, cpdC_mode_t, cpdC_mode_r, cpdC_mode_th, cpdC_mode_phi, modeField]
  simp [knN]
  field_simp
  ring

theorem dir_m_mode : cdir (knM a x) (modeField om mm u) x =
    phaseP om mm x / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) * (Hintz2026.cpd 1 u (toRT x) -
      ((-a * om * sin (x 2) + mm / sin (x 2) : ℝ) : ℂ) * u (toRT x)) := by
  simp only [cdir, Fin.sum_univ_four, cpdC_mode_t, cpdC_mode_r, cpdC_mode_th, cpdC_mode_phi, modeField]
  simp [knM]
  ring_nf
  simp only [Complex.I_sq]
  ring

theorem dir_mbar_mode : cdir (knMbar a x) (modeField om mm u) x =
    phaseP om mm x / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x) * (Hintz2026.cpd 1 u (toRT x) +
      ((-a * om * sin (x 2) + mm / sin (x 2) : ℝ) : ℂ) * u (toRT x)) := by
  simp only [cdir, Fin.sum_univ_four, cpdC_mode_t, cpdC_mode_r, cpdC_mode_th, cpdC_mode_phi, modeField]
  simp [knMbar]
  ring_nf
  simp only [Complex.I_sq]
  ring

end Directions

/-! ### Identification with III's objects (`p : Hintz2026.SubextremalKN`) -/

section III
variable (p : Hintz2026.SubextremalKN)

theorem del_III (r : ℝ) : Hintz2026.Del p r = Del p.M p.a p.Q r := rfl

theorem rhoBar_III (x : Pt 4) : Hintz2026.rhoBar p (toRT x) = qK p.a x := rfl

theorem rhoBarStar_III (x : Pt 4) : Hintz2026.rhoBarStar p (toRT x) = qbarK p.a x := rfl

theorem kfreq_III (om mm r : ℝ) : Hintz2026.Kfreq p om mm r = -(r ^ 2 + p.a ^ 2) * om + p.a * mm := rfl

theorem qhat_III (om mm θ : ℝ) : Hintz2026.Qhat p om mm θ = -p.a * om * sin θ + mm / sin θ := rfl

theorem domKN_subset_domReg_III : domKN p.M p.a p.Q ⊆ domReg p.M p.a p.Q :=
  KN.domKN_subset_domReg p.hM

end III

/-! ### The four directions are III's `j = 0` operators -/

section Bridge
variable (p : Hintz2026.SubextremalKN) (om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4)

/-- `l(P u) = P · 𝒟₀ u` (III's `Dop p 0`), every `x`. -/
theorem dir_l_eq_Dop : cdir (knL p.M p.a p.Q x) (modeField om mm u) x =
    phaseP om mm x * Hintz2026.Dop p 0 om mm u (toRT x) := by
  rw [dir_l_mode]
  simp only [Hintz2026.Dop, kfreq_III, del_III, toRT_zero]
  push_cast; ring

/-- `n(P u) = P (−Δ/(2Σ)) · 𝒟₀† u` (III's `DopDag p 0`), wherever `Δ ≠ 0`. -/
theorem dir_n_eq_DopDag (hD : Del p.M p.a p.Q (x 1) ≠ 0) : cdir (knN p.M p.a p.Q x) (modeField om mm u) x =
    phaseP om mm x * (-((Del p.M p.a p.Q (x 1) / (2 * Sig p.a (x 1) (x 2)) : ℝ) : ℂ)) *
      Hintz2026.DopDag p 0 om mm u (toRT x) := by
  rw [dir_n_mode _ _ _ _ _ _ _ hD]
  simp only [Hintz2026.DopDag, kfreq_III, del_III, toRT_zero]
  push_cast; ring

/-- `m(P u) = P/(√2 ρ̄) · ℒ₀† u` (III's `LopDag p 0`), every `x`. -/
theorem dir_m_eq_LopDag : cdir (knM p.a x) (modeField om mm u) x =
    phaseP om mm x / (((Real.sqrt 2 : ℝ) : ℂ) * Hintz2026.rhoBar p (toRT x)) *
      Hintz2026.LopDag p 0 om mm u (toRT x) := by
  rw [dir_m_mode, rhoBar_III]
  simp only [Hintz2026.LopDag, qhat_III, toRT_one]
  push_cast; ring

/-- `m̄(P u) = P/(√2 ρ̄*) · ℒ₀ u` (III's `Lop p 0`), every `x`. -/
theorem dir_mbar_eq_Lop : cdir (knMbar p.a x) (modeField om mm u) x =
    phaseP om mm x / (((Real.sqrt 2 : ℝ) : ℂ) * Hintz2026.rhoBarStar p (toRT x)) *
      Hintz2026.Lop p 0 om mm u (toRT x) := by
  rw [dir_mbar_mode, rhoBarStar_III]
  simp only [Hintz2026.Lop, qhat_III, toRT_one]
  push_cast; ring

/-! The mode factor and the frame prefactors never vanish on the exterior, so each frame derivative vanishes iff the
III operator does (`ω = 0`, `m = 0` included; nothing is divided by `ω` or `m`). -/

end Bridge

