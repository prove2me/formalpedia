lemma addr_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.addr Λ a = vmap Λ s.vec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

