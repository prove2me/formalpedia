-- title:
--   Corollary 1.7: block sums, prefix absorption and uniqueness
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. If $\bar T$ is the prefix obtained by deleting the last edge, then
--
--   $$\sum_{T\mapsto\lambda}\epsilon_T=\epsilon(\lambda),\qquad \epsilon_{\bar T}\epsilon_T=\epsilon_T.$$
--
--   The second formula uses the inclusion from the preceding level. If a family $g_T\in A_n$, chosen simultaneously for all levels $n$, is idempotent and pairwise orthogonal within each level and satisfies these same two formulas with $g$ in place of $\epsilon_T$, then $g_T=\epsilon_T$ for every path at every level.
--
--   The central block sums and prefix absorption determine the canonical partition across the whole tower.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 5, Corollary 1.7: block sums, prefix absorption and uniqueness

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Corollary 1.7, source PDF pp. 5–6. Prefix absorption bars the FIRST path;
orthogonality is within each level, and uniqueness is simultaneous over all levels. -/
theorem canonical_block_prefix_unique (D : Tower k AA) :
    (∀ n (lam : (D.split n).Label),
      (∑ t : TowerPathsTo D n lam, pathIdempotent D t.val) = centralIdempotent (D.split n) lam) ∧
    (∀ n (t : TowerPath D (n + 1)),
      D.inc n (n + 1) (by omega) (pathIdempotent D (towerPrefix D t n (by omega))) *
        pathIdempotent D t = pathIdempotent D t) ∧
    (∀ g : (n : ℕ) → TowerPath D n → AA n,
      (∀ n (t : TowerPath D n), g n t * g n t = g n t) →
      (∀ n (s t : TowerPath D n), s ≠ t → g n s * g n t = 0) →
      (∀ n (lam : (D.split n).Label), (∑ t : TowerPathsTo D n lam, g n t.val) =
        centralIdempotent (D.split n) lam) →
      (∀ n (t : TowerPath D (n + 1)),
        D.inc n (n + 1) (by omega) (g n (towerPrefix D t n (by omega))) * g (n + 1) t = g (n + 1) t) →
      ∀ n t, g n t = pathIdempotent D t) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
