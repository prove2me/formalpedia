open NLogN
open NLogN.KFR
theorem solution {K ρ f L Y X : ℕ} (hK : 1 ≤ K) (hρ : ρ < K) (hL : f * K ≤ L)
    (hY : Y < 2 ^ L) (hX : X < 2 ^ L) :
    ((Y ^^^ (X &&& NLogN.KFH.selMask K ρ f) : ℕ) : ℤ) - Y =
      ∑ u ∈ Finset.range f, (NLogN.KFR.bitZ (Y ^^^ X) (ρ + u * K) - NLogN.KFR.bitZ Y (ρ + u * K)) * 2 ^ (ρ + u * K) := by
  set M := NLogN.KFH.selMask K ρ f
  have hV : Y ^^^ (X &&& M) < 2 ^ L :=
    Nat.xor_lt_two_pow hY (by rw [Nat.land_comm]; exact Nat.and_lt_two_pow _ hX)
  rw [NLogN.KFR.bitsum L _ hV, NLogN.KFR.bitsum L Y hY, ← Finset.sum_sub_distrib]
  have hterm : ∀ l ∈ Finset.range L, NLogN.KFR.bitZ (Y ^^^ (X &&& M)) l * 2 ^ l - NLogN.KFR.bitZ Y l * 2 ^ l =
      if M.testBit l then (NLogN.KFR.bitZ (Y ^^^ X) l - NLogN.KFR.bitZ Y l) * 2 ^ l else 0 := by
    intro l _
    unfold NLogN.KFR.bitZ
    rw [Nat.testBit_xor, Nat.testBit_land, Nat.testBit_xor]
    cases Y.testBit l <;> cases X.testBit l <;> cases M.testBit l <;> simp
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_filter]
  have hset : (Finset.range L).filter (fun l => M.testBit l = true) =
      (Finset.range f).image (fun u => ρ + u * K) := by
    ext l
    simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_image, M, NLogN.KFR.testBit_selMask hK,
      decide_eq_true_eq]
    constructor
    · rintro ⟨_, u, hu, rfl⟩; exact ⟨u, hu, rfl⟩
    · rintro ⟨u, hu, rfl⟩
      refine ⟨?_, u, hu, rfl⟩
      have : (u + 1) * K ≤ f * K := Nat.mul_le_mul_right _ hu
      rw [Nat.succ_mul] at this
      omega
  rw [hset, Finset.sum_image]
  intro a _ b _ e
  have : a * K = b * K := by simpa using e
  exact Nat.eq_of_mul_eq_mul_right (by omega) this
