/-- the factor pools of the primality test -/
def F2 : ℕ := Nat.factorial 2
def F10 : ℕ := Nat.factorial 10
def F100 : ℕ := Nat.factorial 100
def F : ℕ := Nat.factorial 10000

theorem F2_eq : F2 = Nat.factorial 2 := rfl
theorem F10_eq : F10 = Nat.factorial 10 := rfl
theorem F100_eq : F100 = Nat.factorial 100 := rfl
