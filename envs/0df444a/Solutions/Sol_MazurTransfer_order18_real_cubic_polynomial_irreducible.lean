/-!
# The real-cubic elliptic quotient of the `X₁(18)` sextic

This file records an explicit elliptic quotient of the standard genus-two
model for `X₁(18)`.  Its coefficient field is the totally real cubic field
generated by a root `tau` of

`T³ - 3T - 1`.

Only the algebraic point map is proved here.  In particular, this file makes
no assertion about the Mordell--Weil rank or the rational points of the
elliptic curve.
-/

open Polynomial WeierstrassCurve
open scoped WeierstrassCurve.Affine

namespace MazurTorsion.XOneEighteenRealCubicQuotient

noncomputable section

/-! ## The cubic coefficient field -/

/-- An integral model of the real cubic polynomial. -/
private def cubicPolynomialInt : Polynomial ℤ :=
  X ^ 3 - 3 * X - 1

private theorem cubicPolynomialInt_monic : cubicPolynomialInt.Monic := by
  simp only [cubicPolynomialInt]
  monicity <;> norm_num

private theorem cubicPolynomialInt_mod_two :
    cubicPolynomialInt.map (Int.castRingHom (ZMod 2)) =
      (X ^ 3 + X + 1 : Polynomial (ZMod 2)) := by
  have hthree : (3 : ZMod 2) = 1 := by decide
  have hnegOne : (-1 : ZMod 2) = 1 := by decide
  ext n
  simp [cubicPolynomialInt, coeff_X_pow, coeff_X, coeff_one]
  split_ifs <;> try omega
  all_goals try rw [hthree]
  all_goals simp only [sub_zero, zero_sub, add_zero, zero_add]
  all_goals rw [hnegOne]

private theorem cubicPolynomial_mod_two_irreducible :
    Irreducible (X ^ 3 + X + 1 : Polynomial (ZMod 2)) := by
  have hdegree : (X ^ 3 + X + 1 : Polynomial (ZMod 2)).natDegree = 3 := by
    compute_degree
    decide
  refine Polynomial.irreducible_of_degree_le_three_of_not_isRoot
    (p := (X ^ 3 + X + 1 : Polynomial (ZMod 2))) ?_ ?_
  · rw [hdegree]
    norm_num
  · intro z
    unfold Polynomial.IsRoot
    rw [eval_add, eval_add, eval_pow, eval_X, eval_one]
    fin_cases z
    · change ¬ ((0 : ZMod 2) ^ 3 + 0 + 1 = 0)
      decide
    · change ¬ ((1 : ZMod 2) ^ 3 + 1 + 1 = 0)
      decide

private theorem cubicPolynomialInt_irreducible :
    Irreducible cubicPolynomialInt := by
  apply cubicPolynomialInt_monic.irreducible_of_irreducible_map
    (Int.castRingHom (ZMod 2))
  simpa only [cubicPolynomialInt_mod_two] using
    cubicPolynomial_mod_two_irreducible



private theorem cubicPolynomial_eq_map_int :
    cubicPolynomialInt.map (algebraMap ℤ ℚ) = cubicPolynomial := by
  norm_num [cubicPolynomialInt, cubicPolynomial]

/-- The polynomial `T³ - 3T - 1` is irreducible over `ℚ`. -/
theorem cubicPolynomial_irreducible : Irreducible cubicPolynomial := by
  rw [← cubicPolynomial_eq_map_int]
  exact
    (cubicPolynomialInt_monic.irreducible_iff_irreducible_map_fraction_map
      (K := ℚ)).mp cubicPolynomialInt_irreducible







































