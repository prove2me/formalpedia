namespace P2mKcNoethFlatBase

theorem powers_le (n : ℕ) (hn : n ≠ 0) :
    Submonoid.powers ((n : ℕ) : ℤ) ≤ nonZeroDivisors ℤ :=
  powers_le_nonZeroDivisors_of_noZeroDivisors (by exact_mod_cast hn)

theorem isDomain (n : ℕ) (hn : n ≠ 0) : IsDomain (Localization.Away ((n : ℕ) : ℤ)) :=
  IsLocalization.isDomain_of_le_nonZeroDivisors (M := Submonoid.powers ((n : ℕ) : ℤ)) _ (powers_le n hn)

theorem algebraMap_injective (n : ℕ) (hn : n ≠ 0) :
    Function.Injective (algebraMap ℤ (Localization.Away ((n : ℕ) : ℤ))) :=
  IsLocalization.injective (M := Submonoid.powers ((n : ℕ) : ℤ)) _ (powers_le n hn)

private theorem _root_.P2mKcNoethFlatBase.isNoetherianRing (n : ℕ) : IsNoetherianRing (Localization.Away ((n : ℕ) : ℤ)) :=
  IsLocalization.isNoetherianRing (Submonoid.powers ((n : ℕ) : ℤ)) _ inferInstance

p2m_export "P2mKcNoethFlatBase" "isNoetherianRing"
private theorem _root_.P2mKcNoethFlatBase.isDedekindDomain (n : ℕ) (hn : n ≠ 0) : IsDedekindDomain (Localization.Away ((n : ℕ) : ℤ)) := by
  haveI := isDomain n hn
  exact IsLocalization.isDedekindDomain ℤ (M := Submonoid.powers ((n : ℕ) : ℤ)) (powers_le n hn) _

p2m_export "P2mKcNoethFlatBase" "isDedekindDomain"
theorem isUnit_natCast (n : ℕ) : IsUnit ((n : ℕ) : Localization.Away ((n : ℕ) : ℤ)) := by
  have h := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away ((n : ℕ) : ℤ)) ((n : ℕ) : ℤ)
  simpa using h

theorem isUnit_cast (𝒪 : Type) [CommRing 𝒪] (n : ℕ) (hn : IsUnit ((n : ℕ) : 𝒪))
    (y : Submonoid.powers ((n : ℕ) : ℤ)) : IsUnit (Int.castRingHom 𝒪 (y : ℤ)) := by
  obtain ⟨m, hm⟩ := y.2
  rw [← hm, map_pow]
  refine IsUnit.pow m ?_
  simpa using hn

private noncomputable def _root_.P2mKcNoethFlatBase.lift (𝒪 : Type) [CommRing 𝒪] (n : ℕ) (hn : IsUnit ((n : ℕ) : 𝒪)) :
    Localization.Away ((n : ℕ) : ℤ) →+* 𝒪 :=
  IsLocalization.lift (M := Submonoid.powers ((n : ℕ) : ℤ)) (isUnit_cast 𝒪 n hn)

p2m_export "P2mKcNoethFlatBase" "lift"
theorem lift_injective (𝒪 : Type) [CommRing 𝒪] [CharZero 𝒪] (n : ℕ) (hn0 : n ≠ 0)
    (hn : IsUnit ((n : ℕ) : 𝒪)) : Function.Injective (lift 𝒪 n hn) := by
  unfold lift
  rw [IsLocalization.lift_injective_iff]
  intro x y
  rw [(algebraMap_injective n hn0).eq_iff]
  simp only [eq_intCast, Int.cast_inj]

theorem flat_lift (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (n : ℕ) (hn0 : n ≠ 0)
    (hn : IsUnit ((n : ℕ) : 𝒪)) : (lift 𝒪 n hn).Flat := by
  letI : Algebra (Localization.Away ((n : ℕ) : ℤ)) 𝒪 := (lift 𝒪 n hn).toAlgebra
  haveI := isDomain n hn0
  haveI := isDedekindDomain n hn0
  haveI : Module.IsTorsionFree (Localization.Away ((n : ℕ) : ℤ)) 𝒪 := by
    rw [Module.isTorsionFree_iff_algebraMap_injective]
    exact lift_injective 𝒪 n hn0 hn
  show Module.Flat (Localization.Away ((n : ℕ) : ℤ)) 𝒪
  infer_instance

end P2mKcNoethFlatBase

theorem solution
