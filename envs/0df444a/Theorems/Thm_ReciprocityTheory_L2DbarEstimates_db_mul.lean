theorem ReciprocityTheory.L2DbarEstimates.db_mul {M : Type*} [TopologicalSpace M] (n : ℕ) (z : M → V n) (f g : M → ℂ) (hf : Ck n z 1 f) (hg : Ck n z 1 g) (j : Fin n) (x : M) :
    db n z j (fun y => f y * g y) x = db n z j f x * g x + f x * db n z j g x := by sorry
