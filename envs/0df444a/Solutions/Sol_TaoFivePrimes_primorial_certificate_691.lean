/-! ### Telescoping the prime products -/

theorem primesLE_insert_next (q q' : ℕ) (h1 : q < q') (h2 : q'.Prime)
    (h3 : ∀ m, q < m → m < q' → ¬ m.Prime) :
    Nat.primesLE q' = insert q' (Nat.primesLE q) := by
  ext m
  rw [Finset.mem_insert, Nat.mem_primesLE, Nat.mem_primesLE]
  constructor
  · rintro ⟨hle, hmp⟩
    rcases lt_or_eq_of_le hle with h | h
    · rcases lt_trichotomy m q with h' | h' | h'
      · exact Or.inr ⟨le_of_lt h', hmp⟩
      · exact Or.inr ⟨le_of_eq h', hmp⟩
      · exact absurd hmp (h3 m h' h)
    · exact Or.inl h
  · rintro (rfl | ⟨hle, hmp⟩)
    · exact ⟨le_refl _, h2⟩
    · exact ⟨le_trans hle (le_of_lt h1), hmp⟩

theorem rs_pnum_step_gen {b : ℕ} (s : Finset ℕ) (a : ℕ) (hmem : a ∉ s)
    (hbase : ∏ p ∈ s, (p : ℕ) = b) :
    ∏ p ∈ insert a s, (p : ℕ) = a * b := by
  rw [Finset.prod_insert hmem, hbase]

theorem rs_pden_step_gen {b : ℕ} (s : Finset ℕ) (a : ℕ) (hmem : a ∉ s)
    (hbase : ∏ p ∈ s, ((p : ℕ) - 1) = b) :
    ∏ p ∈ insert a s, ((p : ℕ) - 1) = (a - 1) * b := by
  rw [Finset.prod_insert hmem, hbase]

theorem rs_pnum_0 : ∏ p ∈ Nat.primesLE 283, (p : ℕ) = rsPnum 0 := by decide
theorem rs_pden_0 : ∏ p ∈ Nat.primesLE 283, ((p : ℕ) - 1) = rsPden 0 := by decide

theorem rs_step_1 : Nat.primesLE 293 = insert 293 (Nat.primesLE 283) :=
  primesLE_insert_next 283 293 (by norm_num) (by norm_num)
    (by intro m hm1 hm2; interval_cases m <;> norm_num)
theorem rs_pnum_1 : ∏ p ∈ Nat.primesLE 293, (p : ℕ) = rsPnum 1 := by
  rw [rs_step_1]
  exact rs_pnum_step_gen (Nat.primesLE 283) 293
    (fun h => absurd ((Nat.mem_primesLE.mp h).1) (by omega)) rs_pnum_0
theorem rs_pden_1 : ∏ p ∈ Nat.primesLE 293, ((p : ℕ) - 1) = rsPden 1 := by
  rw [rs_step_1]
  exact rs_pden_step_gen (Nat.primesLE 283) 293
    (fun h => absurd ((Nat.mem_primesLE.mp h).1) (by omega)) rs_pden_0

