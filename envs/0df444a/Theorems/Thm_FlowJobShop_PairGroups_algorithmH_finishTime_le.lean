-- title:
--   Proof of Lemma 11 — $\mathrm{FT}(S)\le\sum_g f(R(g))\le\lceil m/2\rceil\max_g f(R(g))$
-- statement:
--   Let $F$ be a flow shop with $m$ processors and $n$ jobs, and for every group $g=1,\dots,\lceil m/2\rceil$ let $R(g)$ be a feasible schedule of the flow shop $F_g$ on the processors $P_{2g-1},P_{2g}$, with finish time $f(R(g))$. Let $S$ be the schedule generated by algorithm H from these group schedules. Then
--   $$\mathrm{FT}(S)\le\sum_{g=1}^{\lceil m/2\rceil} f(R(g))\le \Big\lceil \frac m2\Big\rceil\,\max\Big(0,\ \max_g f(R(g))\Big).$$
--
--   This is the upper bound on the heuristic's finish time used in the proof of Lemma 11.
--
--   **Formalization Note** $\lceil m/2\rceil$ is written `(m + 1) / 2` in $\mathbb N$, which equals $\lceil m/2\rceil$ for every $m\ge 0$, and is cast to $\mathbb R$. The maximum has baseline $0$, as in the lower bound.
-- source:
--   Gonzalez, Sahni, Flowshop and Jobshop Schedules: Complexity and Approximation, Operations Research 26(1) (1978), p. 49, §2, proof of Lemma 11

import Mathlib
import Definitions.Def_FlowJobShop_PairGroups_FlowShop
import Definitions.Def_FlowJobShop_PairGroups_AlgorithmH

namespace FlowJobShop.PairGroups

open FlowShop

/-- Proof of Lemma 11 (p. 49): the schedule generated by algorithm H from feasible group
schedules `R g` satisfies `FT(S) ≤ Σ_g f(R(g)) ≤ ⌈m/2⌉ · max_g f(R(g))`, where `⌈m/2⌉` is
`(m + 1) / 2` in `ℕ`. -/
theorem algorithmH_finishTime_le {m n : ℕ} (F : FlowShop m n)
    (R : (g : Fin ((m + 1) / 2)) → Fin (groupSize m g) → Fin n → ℝ)
    (hR : ∀ g, (F.group g).IsFeasible (R g)) :
    F.finishTime (F.algorithmH R) ≤ ∑ g, (F.group g).finishTime (R g) ∧
    ∑ g, (F.group g).finishTime (R g) ≤
      (((m + 1) / 2 : ℕ) : ℝ) * (Finset.univ : Finset (Fin ((m + 1) / 2))).fold max 0
        (fun g => (F.group g).finishTime (R g)) := by sorry

end FlowJobShop.PairGroups
