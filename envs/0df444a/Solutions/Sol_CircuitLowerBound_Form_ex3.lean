open CircuitLowerBound
open ENP Groundwork
open CircuitLowerBound.Form
namespace CircuitLowerBound.Form
theorem _root_.solution (a : ℕ → Bool) (l1 l2 l3 : ℕ × Bool) : (∃ l ∈ [l1, l2, l3], a l.1 = l.2) ↔ a l1.1 = l1.2 ∨ a l2.1 = l2.2 ∨ a l3.1 = l3.2 := by
  constructor
  · rintro ⟨l, hl, h⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hl
    rcases hl with rfl | rfl | rfl <;> tauto
  · rintro (h | h | h)
    exacts [⟨l1, by simp, h⟩, ⟨l2, by simp, h⟩, ⟨l3, by simp, h⟩]
end CircuitLowerBound.Form
