variable {G : Type*} [Group G]

private def rTrans (k : G) : (G → ℂ) →ₗ[ℂ] (G → ℂ) where
  toFun ψ := fun x => ψ (x * k)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[scoped simp] private theorem rTrans_apply (k : G) (ψ : G → ℂ) (x : G) : rTrans k ψ x = ψ (x * k) := rfl

private theorem rTrans_one_apply (ψ : G → ℂ) : rTrans (1 : G) ψ = ψ := by
  funext x
  rw [rTrans_apply, mul_one]

private theorem rTrans_mul (k k' : G) : rTrans (k * k') = rTrans k ∘ₗ rTrans k' := by
  apply LinearMap.ext
  intro ψ
  funext x
  simp [mul_assoc]

variable (K : Subgroup G) (φ : G → ℂ)

private abbrev V : Submodule ℂ (G → ℂ) :=
  Submodule.span ℂ (Set.range fun k : K => rTrans (k : G) φ)

private theorem self_mem_V : φ ∈ V K φ :=
  Submodule.subset_span ⟨1, by simp [rTrans_one_apply]⟩

private theorem rTrans_mem_V {k : G} (hk : k ∈ K) {ψ : G → ℂ} (hψ : ψ ∈ V K φ) : rTrans k ψ ∈ V K φ := by
  induction hψ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k', rfl⟩ := hx
    rw [← LinearMap.comp_apply, ← rTrans_mul]
    exact Submodule.subset_span ⟨⟨k * k', K.mul_mem hk k'.2⟩, rfl⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx => rw [map_smul]; exact Submodule.smul_mem _ a hx

private theorem finiteDimensional_V
    (hfin : ∃ s : Finset (G → ℂ), ∀ k ∈ K, (fun x => φ (x * k)) ∈ Submodule.span ℂ (s : Set (G → ℂ))) :
    FiniteDimensional ℂ (V K φ) := by
  obtain ⟨s, hs⟩ := hfin
  haveI : FiniteDimensional ℂ (Submodule.span ℂ (s : Set (G → ℂ))) :=
    FiniteDimensional.span_of_finite ℂ s.finite_toSet
  refine Submodule.finiteDimensional_of_le (S₂ := Submodule.span ℂ (s : Set (G → ℂ))) ?_
  rw [Submodule.span_le]
  rintro _ ⟨k, rfl⟩
  exact hs k k.2

private def T (k : K) : V K φ →ₗ[ℂ] V K φ :=
  (rTrans (k : G)).restrict fun _ hψ => rTrans_mem_V K φ k.2 hψ

@[scoped simp] private theorem T_apply_coe (k : K) (v : V K φ) : ((T K φ k v : V K φ) : G → ℂ) = rTrans (k : G) v := rfl

private theorem T_one : T K φ 1 = LinearMap.id := by
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  simp [rTrans_one_apply]

private theorem T_mul (k k' : K) : T K φ (k * k') = T K φ k ∘ₗ T K φ k' := by
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  simp only [T_apply_coe, LinearMap.comp_apply, Subgroup.coe_mul, rTrans_mul]

private def φV : V K φ := ⟨φ, self_mem_V K φ⟩

@[scoped simp] private theorem coe_φV : ((φV K φ : V K φ) : G → ℂ) = φ := rfl

private def tv (k : K) : V K φ := ⟨rTrans (k : G) φ, Submodule.subset_span ⟨k, rfl⟩⟩

@[scoped simp] private theorem coe_tv (k : K) : ((tv K φ k : V K φ) : G → ℂ) = rTrans (k : G) φ := rfl

private theorem range_tv :
    Set.range (tv K φ) = ((↑) : V K φ → (G → ℂ)) ⁻¹' Set.range (fun k : K => rTrans (k : G) φ) := by
  ext v
  constructor
  · rintro ⟨k, rfl⟩
    exact ⟨k, rfl⟩
  · rintro ⟨k, hk⟩
    exact ⟨k, Subtype.ext hk⟩

private theorem span_tv : Submodule.span ℂ (Set.range (tv K φ)) = ⊤ := by
  rw [range_tv]
  exact Submodule.span_span_coe_preimage

private theorem exists_basis_of_translates [FiniteDimensional ℂ (V K φ)] :
    ∃ (n : ℕ) (kv : Fin n → K) (b : Module.Basis (Fin n) ℂ (V K φ)), ∀ i, b i = tv K φ (kv i) := by
  obtain ⟨B, hBsub, hBspan, hBli⟩ := exists_linearIndependent ℂ (Set.range (tv K φ))
  rw [span_tv] at hBspan
  have hBfin : B.Finite := hBli.set_finite_of_isNoetherian
  haveI : Finite B := hBfin.to_subtype
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin B
  let v : Fin n → V K φ := fun i => ((e.symm i : B) : V K φ)
  have hli : LinearIndependent ℂ v := hBli.comp _ e.symm.injective
  have hrange : Set.range v = B := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (e.symm i).2
    · intro hx
      exact ⟨e ⟨x, hx⟩, by simp [v]⟩
  have hsp : ⊤ ≤ Submodule.span ℂ (Set.range v) := by
    rw [hrange, hBspan]
  refine ⟨n, fun i => (hBsub (e.symm i).2).choose, Module.Basis.mk hli hsp, fun i => ?_⟩
  rw [Module.Basis.mk_apply]
  exact ((hBsub (e.symm i).2).choose_spec).symm

end Algebra
