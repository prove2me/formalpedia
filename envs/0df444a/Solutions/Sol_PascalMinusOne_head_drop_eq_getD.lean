theorem _root_.solution (L : List ℕ) (i : ℕ) :
    (L.drop i).head! = L.getD i 0 := by
  induction i generalizing L with
  | zero =>
      cases L <;> rfl
  | succ i ih =>
      cases L with
      | nil => simp
      | cons d D => simpa using ih (L := D)
end PascalMinusOne
