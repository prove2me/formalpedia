  generalize F (trOf g n) = c at h0 h1 h2 ⊢
  simp only [trOf]
  refine Prod.ext (gc_sc_self hg.s0 h0 _) (Prod.ext ?_ ?_)
  · simp only; rw [gc1_sc0 hg, gc_sc_self hg.s1 h1]
  · simp only; rw [gc2_sc0 hg, gc2_sc1 hg, gc_sc_self hg.s2 h2]

