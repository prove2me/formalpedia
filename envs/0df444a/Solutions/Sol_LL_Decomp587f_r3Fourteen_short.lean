inductive SegTree where
  | L (v : Nat)
  | N (m : Nat) (l r : SegTree)

def SegTree.top : SegTree → Nat
  | .L v => v
  | .N m _ _ => m

def SegTree.isValid : Nat → SegTree → Bool
  | 0, .L _ => true
  | d + 1, .N m l r =>
      l.isValid d && r.isValid d && decide (l.top ≤ m) && decide (r.top ≤ m)
  | _, _ => false

def SegTree.get : Nat → SegTree → Nat → Nat
  | 0, .L v, _ => v
  | d + 1, .N _ l r, k =>
      let half := 2 ^ d
      if k < half then l.get d k else r.get d (k - half)
  | _, _, _ => 0

def SegTree.rangeMax (half : Nat) : SegTree → Nat → Nat → Nat
  | .L v, _, _ => v
  | .N m l r, lo, hi =>
      if lo == 0 && hi + 1 >= 2 * half then m
      else if hi < half then l.rangeMax (half / 2) lo hi
      else if half <= lo then r.rangeMax (half / 2) (lo - half) (hi - half)
      else max (l.rangeMax (half / 2) lo (half - 1)) (r.rangeMax (half / 2) 0 (hi - half))

