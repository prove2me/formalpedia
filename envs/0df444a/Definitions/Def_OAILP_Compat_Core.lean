-- Definitions bundle OAILP_Compat_Core
-- Generated by skeleton subtraction from P2MCompat/Core.lean of the Lean 4.33.1 / Mathlib 0df444a
-- backport of OpenAI's formalization (github.com/openai/math, commit 3344da59991ed94f9ba711217b29c1d760badfa6),
-- Apache-2.0. Declarations and proofs are OpenAI's (Hex libraries: Lean FRO, Apache-2.0).


/-!
# Compatibility shims: Lean core 4.34 → 4.33

Lean v4.34 renamed the core lemmas `if_pos`, `if_neg`, `dif_pos`, `dif_neg` to
`ite_eq_left`, `ite_eq_right`, `dite_eq_left`, `dite_eq_right` (statements unchanged).
OpenAI's development (written against Lean v4.34.1) uses the new names; Lean v4.33.1
only has the old ones. These four theorems restate the v4.34 lemmas verbatim, proved by
the v4.33 originals.
-/

universe u

theorem ite_eq_left {c : Prop} {h : Decidable c} (hc : c) {α : Sort u} {t e : α} :
    (ite c t e) = t :=
  if_pos hc

theorem ite_eq_right {c : Prop} {h : Decidable c} (hnc : ¬c) {α : Sort u} {t e : α} :
    (ite c t e) = e :=
  if_neg hnc

theorem dite_eq_left {c : Prop} {h : Decidable c} (hc : c) {α : Sort u} {t : c → α}
    {e : ¬ c → α} : (dite c t e) = t hc :=
  dif_pos hc

theorem dite_eq_right {c : Prop} {h : Decidable c} (hnc : ¬c) {α : Sort u} {t : c → α}
    {e : ¬ c → α} : (dite c t e) = e hnc :=
  dif_neg hnc


