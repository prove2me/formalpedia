    have : 1 ≤ 2 ^ p := Nat.one_le_two_pow
    have : 32 * c.Wr * 2 ^ p ≤ 32 * c.Wr * (2 ^ p * 2 ^ p) := Nat.mul_le_mul_left _ (by nlinarith)
