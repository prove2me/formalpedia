section Chain

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem frOK_chainFr (hL : LevRH c σ K t S0 r H E e B) (hE1 : 1 ≤ E) (M : ℕ)
    (hM : E + e + K + 1 ≤ M) : FrOK σ M 12 chainFr := by
  have hnat : ∀ i ∈ [vk, vE, vK], ∃ n : ℕ, σ i = some (n : ℤ) := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · exact ⟨_, hL.hk⟩
    · exact ⟨_, hL.hE⟩
    · exact ⟨_, hL.hK⟩
  intro x hx
  simp only [chainFr, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl
  all_goals refine ⟨by simp only [] <;> decide, regsLt_of_all (by simp [NE.regs] <;> decide),
    by simp [NE.size], natR_of _ hnat (by simp [NE.regs]), ?_⟩
  all_goals simp only [NE.OK, NE.val, vOf_eq hL.hk, vOf_eq hL.hE, vOf_eq hL.hK]
  · omega
  · refine ⟨by omega, ⟨by omega, by omega, by omega⟩, ?_⟩
    split_ifs with h
    · exact ⟨by omega, by omega, by omega⟩
    · omega
  · omega

theorem frV_kerFr (σ : Fin HS → Option ℤ) : frV σ kerFr = kerVL := by
  simp only [frV, kerFr, kerVL, List.map_cons, List.map_nil, NE.val]

theorem frOK_kerFr (σ : Fin HS → Option ℤ) : FrOK σ 1 1 kerFr := by
  intro x hx
  simp only [kerFr, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl
  all_goals exact ⟨by simp only [] <;> decide, fun i hi => by simp [NE.regs] at hi,
    by simp [NE.size], fun i hi => by simp [NE.regs] at hi, by simp [NE.OK]⟩

/-- **The kernel frame is a frozen level-`0` frame.** -/
theorem levR_ker (hL : LevRH c σ K t S0 r H E e B) :
    LevR (σPush σ (frV σ kerFr)) K t S0 r H 0 e B := by
  rw [frV_kerFr]
