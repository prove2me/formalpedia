-- Buffer and update interface from Solutions.ExteriorNumericMemory

set_option autoImplicit false
namespace NearlyOptimalPPR.Computation
open SparseQueue
noncomputable section

def exteriorNumericPayload {n : ℕ} (g : InputGraph n) (logical : RecursiveState n) (ell : ℕ)
    (α : ℝ) (t : ℕ) (v : Fin n) (δ : ℝ) (I : ℤ → ℤ) (R : ℤ → ℝ) : (ℤ → ℤ) × (ℤ → ℝ) :=
  levelPayloadFold (storedNeighborMemoryUpdate g v logical ell ((1-α)*δ)) 0 (g.neighbors v).length
    (I,levelRealMemoryFold (exteriorSelfBudgetMemoryUpdate I (16*(ell+3)) v.val t (LocalPush.deg g.graph v*δ)
      ((1-α)*LocalPush.deg g.graph v*δ)) 0 (logical.top+1)
      (Function.update R (vertexRecordAddress (16*(ell+3)) v.val 0) (R (vertexRecordAddress (16*(ell+3)) v.val 0)+δ)))

end
end NearlyOptimalPPR.Computation

-- Buffer and update interface from Solutions.ExteriorActivationExecution

set_option autoImplicit false
set_option maxRecDepth 10000
open scoped ENNReal
namespace NearlyOptimalPPR.Computation
open SparseQueue
noncomputable section

def exteriorActivationIntegerMemory {n : ℕ} (g : InputGraph n) (source : Fin n) (rootActive : Finset (Fin n))
    (boundary level top width : ℕ) (free : ℤ) (I : ℤ → ℤ) : ℤ → ℤ :=
  let base := frameListInsertMemory (activationBoundaryMemory g source rootActive boundary level I)
    free source.val level 1 3 2 width 2 ((g.neighbors source).length : ℤ)
  if level < top then clearLevelVertexFlagsMemory base width source.val (16*(level+1)+16) [2,3,4,5,6] else base

def exteriorActivationRealMemory (R : ℤ → ℝ) (source level top width : ℕ) (half : ℝ) (opened : Bool) : ℤ → ℝ :=
  let base := activationScalarsMemory R width source level half opened
  if level < top then freshVertexRealMemory base width source (16*(level+1)) else base

end
end NearlyOptimalPPR.Computation


