variable (g gi : Metric 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (x : Pt 4)

noncomputable def npKappaB : ℂ := omL g gi E Θ 0 0 3 x
noncomputable def npSigmaB : ℂ := omL g gi E Θ 0 3 3 x
noncomputable def npRhoB : ℂ := omL g gi E Θ 0 2 3 x
noncomputable def npTauB : ℂ := omL g gi E Θ 0 1 3 x
noncomputable def npNuB : ℂ := -omL g gi E Θ 1 1 2 x
noncomputable def npLambdaB : ℂ := -omL g gi E Θ 1 2 2 x
noncomputable def npMuB : ℂ := -omL g gi E Θ 1 3 2 x
noncomputable def npPiB : ℂ := -omL g gi E Θ 1 0 2 x
noncomputable def npEpsB : ℂ := (-omL g gi E Θ 1 0 0 x + omL g gi E Θ 2 0 3 x) / 2
noncomputable def npBetaB : ℂ := (-omL g gi E Θ 1 3 0 x + omL g gi E Θ 2 3 3 x) / 2
noncomputable def npGammaB : ℂ := (-omL g gi E Θ 1 1 0 x + omL g gi E Θ 2 1 3 x) / 2
noncomputable def npAlphaB : ℂ := (-omL g gi E Θ 1 2 0 x + omL g gi E Θ 2 2 3 x) / 2

end bar

