variable {ι : Type} [Fintype ι] [DecidableEq ι] {n : ℕ}

theorem Formalism.L2.SG.Pf.ColDictValCPf.uniq_iter (lam : ι → DomWeight n) (Q : MvPolynomial (ι × Fin n × Fin n) ℂ)
    (hQ : Q ∈ CSpanV lam)
    (hk : ∀ (τ : ι) (a b : Fin n), a < b → ∀ k, 1 ≤ k → bigDiv τ a b k Q = 0) (s : Finset ι) :
    ∀ x : ι × Fin n × Fin n → ℂ, eval x Q =
      (∏ τ ∈ s, eval (fun p => x (τ, p)) (extremal ℂ n (lam τ))) *
        eval (fun v => if v.1 ∈ s then idPoint ℂ n n v.2 else x v) Q := by sorry
