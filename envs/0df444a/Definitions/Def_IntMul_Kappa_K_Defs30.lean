-- Source module: Solutions.KFV29LayIL
/-!
# KFV §32: the layout primitives as fixed IL code

* `mvB eA eF eC`: the single move `mv c (c+δ)` on the stored records (`c, δ` and the exponent of
  the trailing block computed by `eA, eF, eC` at run time): KFUU's `mvBU` (KFC `bwdF`) with
  `qX, qB, qZ ← 2^c, 2^δ, 2^{e+ℓ+1}`. **`mvB_run`**.
* `mvF eA eG eC`: the inverse move, KFUU's `mvFU` (KFC `fwdF`). **`mvF_run`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Single moves -/

/-- The three block sizes. -/
def mvPush (eA eF eC : Ex HS) : RS :=
  .seq (.push qX (.pow2 eA)) (.seq (.push NLogN.KFV.qB (.pow2 eF)) (.push qZ (.pow2 eC)))

def mvPop : RS := .seq (.pop qZ) (.seq (.pop NLogN.KFV.qB) (.pop qX))

/-- The move `mv c (c+δ)` (`bwdF`). -/
def mvB (eA eF eC : Ex HS) : IStmt HS Pp :=
  .seq (fcode (mvPush eA eF eC)) (.seq KFUU.mvBU (fcode mvPop))

/-- The inverse move (`fwdF`). -/
def mvF (eA eG eC : Ex HS) : IStmt HS Pp :=
  .seq (fcode (mvPush eA eG eC)) (.seq KFUU.mvFU (fcode mvPop))

/-- Register overhead of a move. -/
def cMvR (eA eF eC : Ex HS) (B : ℕ) : ℕ :=
  ((eA.size + 2) + (eF.size + 2) + (eC.size + 2)) * 10 ^ 7 * (B + 2) ^ 2 + 3 * (2 * B + 2)

/-- Cost of a move. -/
def cMvB (eA eF eC : Ex HS) (c δ E W B : ℕ) : ℕ :=
  cMvR eA eF eC B + cBwdF (2 ^ c) 2 (2 ^ δ) (2 ^ E) W + KFUU.cK3 (2 ^ c) (2 ^ δ) (2 ^ E)

/-- Cost of an inverse move. -/
def cMvF (eA eF eC : Ex HS) (c δ E W B : ℕ) : ℕ :=
  cMvR eA eF eC B + cFwdF (2 ^ c) 2 (2 ^ δ) (2 ^ E) W + KFUU.cK3 (2 ^ c) (2 ^ δ) (2 ^ E)

/-- Expressions not reading the move registers. -/
def MvSafe (e : Ex HS) : Prop := e.Clean ∧ ∀ x ∈ e.regs, x ≠ qX ∧ x ≠ NLogN.KFV.qB ∧ x ≠ qZ ∧ x ≠ 0

/-- The frame after the three pushes. -/
def mvFr (v : List ℤ) (a b c : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (o0 v) qX [((2 ^ a : ℕ) : ℤ)])
    NLogN.KFV.qB [((2 ^ b : ℕ) : ℤ)]) qZ [((2 ^ c : ℕ) : ℤ)]

/-- The stored array after a move with address map `σ`. -/
def zMv (n r : ℕ) (σ : ℕ → ℕ) (zs : List GI) : List GI :=
  pull (binSh n ++ [r]) (binSh n ++ [r]) (extA n (permIdx σ)) 0 zs

end NLogN.KFV

end

