-- Source module: Solutions.KFX2Rot
/-!
# KFX §2: register-driven table rotations (the lines (22) and the last bit)

* `pushSt_G_mem`, `pushOK_of`: pushed parameter lists built from `KFL.ESp` facts.
* `tabRot_runs`: a generic `withPushI pl (fcode U ; rotF)` where `U` pushes the rotation table.
* `tabGenU sgn b`: `KFL.tabGen` with the literals `P, Q, d0, d1, 2^ρ, f-1, 2^K` read from the
  registers `1, 2, 3, 5, 6, 7, 8` (`tabGenU_sub`: the literal instance is `RS.sub`).
* **`rotU_geo`**: one line `rixT g (rot2 Q (amt K ρ f l))` with parameters from expressions.
* `xorGenU`, **`xorU_geo`**: the last-bit step `rixT g (XLc K ρ f)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW AModel Butterfly

/-! ## Pushed parameter lists -/

/-! ## A table generator followed by `rotF` -/

/-! ## The uniform table generator of a line -/

/-- `((p / d) % Q) / 2^ρ` with `d, Q, 2^ρ` from the registers `rd, 2, 6`. -/
def uEU (rd : Fin HS) : Ex HS :=
  .ndiv (.nmod (.ndiv (.add (.reg KFL.rP) (.lit (-1))) (.reg rd)) (.reg 2)) (.reg 6)

/-- `(sgn · rA) mod Q` with `Q` from register `2`. -/
def amtEU (sgn : ℤ) : Ex HS := .nmod (.add (.mul (.lit sgn) (.reg NLogN.KFL.rA)) (.reg 2)) (.reg 2)

def segBodyU (T : Ex HS) : RS :=
  .seq (.asg NLogN.KFL.rA (.add (.reg NLogN.KFL.rA) (.mul (.reg NLogN.KFL.rW) T)))
    (.seq (.asg NLogN.KFL.rU (.quo (.reg NLogN.KFL.rU) (.reg 8)))
    (.seq (.asg KFL.rV (.quo (.reg KFL.rV) (.reg 8)))
      (.asg NLogN.KFL.rW (.mul (.reg NLogN.KFL.rW) (.reg 8)))))

def segLoopU (T : Ex HS) : RS := .rep rC (.reg 7) (segBodyU T)

def tabBodyU (sgn b : ℤ) : RS :=
  .seq (.push NLogN.KFL.rU (uEU 3)) (.seq (.push KFL.rV (uEU 5)) (.seq (.push NLogN.KFL.rW (.reg 6))
  (.seq (.push NLogN.KFL.rA (.lit 0)) (.seq (segLoopU (offE b))
  (.seq (.push 14 (amtEU sgn)) (.seq (.pop NLogN.KFL.rA) (.seq (.pop NLogN.KFL.rW)
  (.seq (.pop KFL.rV) (.seq (.pop NLogN.KFL.rU) (.asg KFL.rP (.add (.reg KFL.rP) (.lit (-1)))))))))))))

/-- **The uniform table generator.** -/
def tabGenU (sgn b : ℤ) : RS :=
  .seq (.push KFL.rP (.reg 1)) (.seq (.rep rq (.reg 1) (tabBodyU sgn b)) (.pop KFL.rP))

/-- The register assignment of `tabGenU`. -/
def σT (P Q d0 d1 r2 fm k2 : ℤ) : Fin HS → Option ℤ := fun i =>
  if i = 1 then some P else if i = 2 then some Q else if i = 3 then some d0 else
  if i = 5 then some d1 else if i = 6 then some r2 else if i = 7 then some fm else
  if i = 8 then some k2 else none

/-! ## One line, register-driven -/

/-- The parameter list of a line: `P, Q, B` for `rotF` on `1, 2, 4`, and `d0, d1, 2^ρ, f-1, 2^K`
for the table on `3, 5, 6, 7, 8`. -/
def rotPl (eP eQ eB ed0 ed1 er ef eK : Ex HS) : List (Fin HS × Ex HS) :=
  [(1, eP), (2, eQ), (4, eB), (3, ed0), (5, ed1), (6, er), (7, ef), (8, eK)]

/-- **One line with register parameters.** -/
def rotU {Pp : ℕ} (sgn b : ℤ) (eP eQ eB ed0 ed1 er ef eK : Ex HS) : IStmt HS Pp :=
  withPushI (rotPl eP eQ eB ed0 ed1 er ef eK) (.seq (fcode (tabGenU sgn b)) KFC.rotF)

/-- The expressions of a parameter list read none of the low stacks `1 … 12`. -/
def NoLow (e : Ex HS) : Prop := ∀ r ∈ e.regs, 13 ≤ r.val

/-- The cost of one register-driven line. -/
def cRotU (K f : ℕ) (b : ℤ) (P Q B w Bb : ℕ) : ℕ :=
  400 * cTabGen K f b P Bb + KFC.cRotF P Q B w + 10 ^ 10 * (Bb + 2) ^ 2

/-! ## The last-bit step, register-driven -/

/-- `(((p / d) % Q) / 2^j) % 2` with `d, Q, 2^j` from the registers `3, 5, 6`. -/
def bEU : Ex HS :=
  .nmod (.ndiv (.nmod (.ndiv (.add (.reg KFL.rP) (.lit (-1))) (.reg 3)) (.reg 5)) (.reg 6)) (.lit 2)

def xorBodyU : RS := .seq (.push 14 bEU) (.asg KFL.rP (.add (.reg KFL.rP) (.lit (-1))))

/-- **The uniform bit table.** -/
def xorGenU : RS := .seq (.push KFL.rP (.reg 1)) (.seq (.rep rq (.reg 1) xorBodyU) (.pop KFL.rP))

/-- The register assignment of `xorGenU`. -/
def σX (P d Q r2 : ℤ) : Fin HS → Option ℤ := fun i =>
  if i = 1 then some P else if i = 3 then some d else if i = 5 then some Q else
  if i = 6 then some r2 else none

/-- The parameter list of the last-bit step: `P, 2, B` for `rotF`, `d, Q, 2^j` for the table. -/
def xorPl (eP eB ed eQ ej : Ex HS) : List (Fin HS × Ex HS) :=
  [(1, eP), (2, .lit 2), (4, eB), (3, ed), (5, eQ), (6, ej)]

/-- **The last-bit step with register parameters.** -/
def xorU {Pp : ℕ} (eP eB ed eQ ej : Ex HS) : IStmt HS Pp :=
  withPushI (xorPl eP eB ed eQ ej) (.seq (fcode xorGenU) KFC.rotF)

def cXorU (P B w Bb : ℕ) : ℕ := 400 * cXorGen P Bb + KFC.cRotF P 2 B w + 10 ^ 10 * (Bb + 2) ^ 2

end NLogN.KFX

end

