/-- The original stock loop machine realizes every proved bounded execution
of the actual stock step program. Both iteration and encoded state bounds
are charged to the resulting real TM2 running time. -/
theorem run_bounded {α β : Type} {ea : α → List Bool} {eb : β → List Bool}
    {f : α → β ⊕ α} (callee : TM2ComputableInPolyTime ea (OAI.MetricKMedian.Binary.encodeLoop ea eb) f)
    {size rounds : ℕ} {start : α} {result : β}
    (h : OAI.MetricKMedian.Binary.BoundedRun ea f size rounds start result) :
    Nonempty (EvalsToInTime (TM2.step (_root_.Integration9_9.TM2StockLoop.program callee.tm callee.inputAlphabet callee.outputAlphabet))
      (_root_.Integration9_9.TM2StockLoop.callCfg callee.tm (_root_.Integration9_9.TM2StockThread.nativeInput callee.tm ((ea start).map callee.inputAlphabet.symm)))
      (some (_root_.Integration9_9.TM2StockLoop.terminalCfg callee.tm (eb result))) (rounds*_root_.Integration9_9.TM2StockLoop.passTime callee size)) := by
  induction h with
  | @stop a b ha hf =>
    have hc : TM2OutputsInTime callee.tm ((ea a).map callee.inputAlphabet.symm)
        (some (callee.outputAlphabet.symm false::(eb b).map callee.outputAlphabet.symm))
        (callee.time.eval (ea a).length) := by
      simpa only [hf,OAI.MetricKMedian.Binary.encodeLoop,List.map_cons,Equiv.invFun_as_coe] using callee.outputsFun a
    obtain ⟨hr⟩ := _root_.Integration9_9.TM2StockLoop.stop_round callee.tm callee.inputAlphabet callee.outputAlphabet _ _ _ hc
    simp only [List.map_map,Function.comp_def,Equiv.apply_symm_apply,List.map_id_fun',id_eq,List.length_map] at hr
    have ht := OAI.MetricKMedian.Binary.polynomial_eval_mono callee.time ha
    have hl := (_root_.Integration9_9.TM2StockLoop.length_bound callee a).trans (OAI.MetricKMedian.Binary.polynomial_eval_mono (_root_.Integration9_9.TM2StockLoop.sizeBound callee) ha)
    simp only [hf,OAI.MetricKMedian.Binary.encodeLoop,List.length_cons] at hl
    have hb : callee.time.eval (ea a).length+2*(eb b).length+3 ≤ 1*_root_.Integration9_9.TM2StockLoop.passTime callee size := by
      simp only [one_mul,_root_.Integration9_9.TM2StockLoop.passTime]
      omega
    exact ⟨⟨hr.toEvalsTo,hr.steps_le_m.trans hb⟩⟩
  | @step a a' b n ha hf h ih =>
    have hc : TM2OutputsInTime callee.tm ((ea a).map callee.inputAlphabet.symm)
        (some (callee.outputAlphabet.symm true::(ea a').map callee.outputAlphabet.symm))
        (callee.time.eval (ea a).length) := by
      simpa only [hf,OAI.MetricKMedian.Binary.encodeLoop,List.map_cons,Equiv.invFun_as_coe] using callee.outputsFun a
    obtain ⟨hr⟩ := _root_.Integration9_9.TM2StockLoop.next_round callee.tm callee.inputAlphabet callee.outputAlphabet _ _ _ hc
    simp only [List.map_map,Function.comp_def,Equiv.apply_symm_apply,List.map_id_fun',id_eq,List.length_map] at hr
    obtain ⟨hi⟩ := ih
    have ht := OAI.MetricKMedian.Binary.polynomial_eval_mono callee.time ha
    have hl := (_root_.Integration9_9.TM2StockLoop.length_bound callee a).trans (OAI.MetricKMedian.Binary.polynomial_eval_mono (_root_.Integration9_9.TM2StockLoop.sizeBound callee) ha)
    simp only [hf,OAI.MetricKMedian.Binary.encodeLoop,List.length_cons] at hl
    have hb : callee.time.eval (ea a).length+2*(ea a').length+3 ≤ _root_.Integration9_9.TM2StockLoop.passTime callee size := by
      simp only [_root_.Integration9_9.TM2StockLoop.passTime]
      omega
    have hall := EvalsToInTime.trans _ _ _ _ _ _ hr hi
    have hbound : hall.steps ≤ (n+1)*_root_.Integration9_9.TM2StockLoop.passTime callee size := by
      have hh := hall.steps_le_m
      rw [Nat.add_mul,one_mul]
