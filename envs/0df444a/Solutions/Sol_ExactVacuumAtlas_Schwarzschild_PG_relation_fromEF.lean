open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.PG
set_option maxHeartbeats 4000000
variable (M ε : ℝ)
theorem solution (hM : 0 ≤ M) (hε : ε ^ 2 = 1) :
    CoordRelation (gEF M ε) (gPG M ε) domEF domEF (pgFromEF M ε) (pgToEF M ε) (jacInv M ε) where
  left_inv y _ := pgToEF_pgFromEF M ε y
  right_inv x _ := pgFromEF_pgToEF M ε x
  bijOn := bijOn_pgFromEF M ε
  smooth := contDiffOn_pgFromEF M ε hM
  smooth_inv := contDiffOn_pgToEF M ε hM
  jacobian _ hy k i := hasDerivAt_pd_pgFromEF M ε hM hy k i
  pullback _ hy := pullback_inv M ε hM hε hy
