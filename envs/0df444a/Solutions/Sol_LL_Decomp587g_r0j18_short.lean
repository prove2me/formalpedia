  have hterm : ∀ i ∈ Finset.range Ns,
      ∫ s in (((2 * A_num + i * hs : ℕ) : ℝ) / D_den)..(((2 * A_num + (i + 1) * hs : ℕ) : ℝ) / D_den),
        W_real s * H_real (φ - s) ≤
      ((W_cert.getD i 0 * (H_cert.drop (d * mult)).getD i 0 : ℕ) : ℝ) / ((S_sc : ℝ) * S_sc) := by
    intro i hi
    rw [Finset.mem_range] at hi
    set sl := 2 * A_num + i * hs
    set sr := sl + hs
    have hsr_eq : 2 * A_num + (i + 1) * hs = sr := by simp only [sr, sl]; ring
    rw [hsr_eq]
    set j := Ns - 1 + p * mult - i
    have hj_lt : j < Ns + (nSlices - 1) * mult := by
      have : p * mult ≤ (nSlices - 1) * mult := Nat.mul_le_mul_right mult (by omega)
      omega
    set t_lo := phi0 + j * hs - 2 * B_num
    set t_hi := t_lo + (mult + 1) * hs
    have ht_lo_eq : t_lo + sr = phi0 + p * step := by
      have h1 : 2 * B_num = 2 * A_num + Ns * hs := by omega
      have h2 : j * hs + (i + 1) * hs = Ns * hs + p * step := by
        have hsum : j + (i + 1) = Ns + p * mult := by omega
        calc j * hs + (i + 1) * hs
            = (j + (i + 1)) * hs := by ring
          _ = (Ns + p * mult) * hs := by rw [hsum]
          _ = Ns * hs + p * step := by simp only [step]; ring
      have hsr2 : sr = 2 * A_num + (i + 1) * hs := by simp only [sr, sl]; ring
      omega
