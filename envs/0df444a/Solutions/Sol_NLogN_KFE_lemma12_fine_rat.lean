namespace Layout

lemma actIdx_some {k : ℕ} {i : Fin n} (h : Λ.actIdx k = some i) : (Λ.pos i : ℕ) = k := by
  have := List.find?_some h
  simpa using this

lemma actIdx_pos (i : Fin n) : Λ.actIdx (Λ.pos i) = some i := by
  cases h : Λ.actIdx (Λ.pos i) with
  | none =>
    unfold actIdx at h
    rw [List.find?_eq_none] at h
    exact absurd (by simp) (h i (List.mem_finRange i))
  | some r => rw [Λ.mono.injective (Fin.ext (Λ.actIdx_some h))]

lemma actIdx_none {k : ℕ} (h : Λ.actIdx k = none) (i : Fin n) : (Λ.pos i : ℕ) ≠ k := by
  rintro rfl; rw [Λ.actIdx_pos] at h; cases h

end Layout

@[simp] lemma length_setAct (a : List ℕ) (v : Fin n → ZMod Q) :
    (setAct Λ a v).length = a.length := by simp [setAct]

lemma getElem_setAct (a : List ℕ) (v : Fin n → ZMod Q) (k : ℕ)
    (hk : k < (setAct Λ a v).length) :
    (setAct Λ a v)[k] = match Λ.actIdx k with
      | some i => (v i).val
      | none => a[k]'(by simpa using hk) := by
  simp [setAct]
  try (first | rfl | (split <;> rfl))

lemma getElem_setAct_pos (a : List ℕ) (v : Fin n → ZMod Q) (i : Fin n)
    (hk : (Λ.pos i : ℕ) < (setAct Λ a v).length) :
    (setAct Λ a v)[(Λ.pos i : ℕ)] = (v i).val := by
  rw [getElem_setAct, Λ.actIdx_pos]

lemma setAct_setAct (a : List ℕ) (v w : Fin n → ZMod Q) :
    setAct Λ (setAct Λ a v) w = setAct Λ a w := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  simp only [getElem_setAct]
  cases Λ.actIdx k <;> rfl

lemma Valid.digit_lt {a : List ℕ} (ha : AModel.Valid sh a) (i : Fin n) :
    a.getD (Λ.pos i) 0 < Q := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  have h2 : (Λ.pos i : ℕ) < sh.length := (Λ.pos i).2
  have h1 : (Λ.pos i : ℕ) < a.length := by omega
  have := hlt _ h1 h2
  have hs := Λ.size i
  simp only [List.get_eq_getElem] at hs
  rw [List.getD_eq_getElem _ _ h1]; simpa [hs] using this

lemma valid_setAct [NeZero Q] {a : List ℕ} (ha : AModel.Valid sh a) (v : Fin n → ZMod Q) :
    AModel.Valid sh (setAct Λ a v) := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  refine (valid_iff _ _).2 ⟨by simp [hl], fun k h₁ h₂ => ?_⟩
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none => exact hlt _ _ _
  | some i =>
    have hk := Λ.actIdx_some h
    subst hk
    have := Λ.size i
    simp only [List.get_eq_getElem] at this
    simp only [this]
    exact ZMod.val_lt _

lemma act_setAct [NeZero Q] {a : List ℕ} (ha : AModel.Valid sh a) (v : Fin n → ZMod Q) :
    act Λ (setAct Λ a v) = v := by
  funext i
  have h1 : (Λ.pos i : ℕ) < (setAct Λ a v).length := by simp [ha.length_eq]
  rw [act, List.getD_eq_getElem _ _ h1, getElem_setAct_pos, ZMod.natCast_zmod_val]

lemma setAct_act {a : List ℕ} (ha : AModel.Valid sh a) : setAct Λ a (act Λ a) = a := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none => rfl
  | some i =>
    have hk := Λ.actIdx_some h
    have hd := ha.digit_lt Λ i
    simp only [act, ZMod.val_natCast, Nat.mod_eq_of_lt hd]
    rw [List.getD_eq_getElem _ _ (by omega)]
    simp [hk]

lemma valid_vmap [NeZero Q] (F : (Fin n → ZMod Q) → (Fin n → ZMod Q)) {a : List ℕ}
    (ha : AModel.Valid sh a) : AModel.Valid sh (vmap Λ F a) := valid_setAct Λ ha _

lemma vmap_vmap [NeZero Q] (F G : (Fin n → ZMod Q) → (Fin n → ZMod Q)) {a : List ℕ}
    (ha : AModel.Valid sh a) : vmap Λ G (vmap Λ F a) = vmap Λ (G ∘ F) a := by
  simp only [vmap, act_setAct Λ ha, setAct_setAct, Function.comp_apply]

lemma vmap_id {a : List ℕ} (ha : AModel.Valid sh a) : vmap Λ id a = a := setAct_act Λ ha

lemma amap_eq_vmap (L : Matrix (Fin n) (Fin n) (ZMod Q)) : amap Λ L = vmap Λ (L *ᵥ ·) := rfl

lemma valid_amap [NeZero Q] (L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : AModel.Valid sh a) : AModel.Valid sh (amap Λ L a) := valid_setAct Λ ha _

lemma amap_mul [NeZero Q] (M L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : AModel.Valid sh a) : amap Λ M (amap Λ L a) = amap Λ (M * L) a := by
  rw [amap_eq_vmap, amap_eq_vmap, vmap_vmap Λ _ _ ha, amap_eq_vmap]
  congr 1; funext x; simp [Matrix.mulVec_mulVec]

lemma amap_one {a : List ℕ} (ha : AModel.Valid sh a) : amap Λ 1 a = a := by
  rw [amap_eq_vmap]; convert vmap_id Λ ha using 2; funext x; simp

section Shift

lemma sum_update_of_eq_zero (i : Fin n) (c x : Fin n → ZMod Q) (y : ZMod Q) (hc : c i = 0) :
    ∑ j, c j * Function.update x i y j = ∑ j, c j * x j := by
  refine Finset.sum_congr rfl fun j _ => ?_
  by_cases hj : j = i
  · subst hj; simp [hc]
  · simp [Function.update_of_ne hj]

lemma shiftInvVec_shiftVec {i : Fin n} {u : ZMod Q} {c : Fin n → ZMod Q} (hu : IsUnit u)
    (hc : ∀ j, i ≤ j → c j = 0) (x : Fin n → ZMod Q) :
    shiftInvVec i u c (shiftVec i u c x) = x := by
  unfold shiftInvVec shiftVec
  rw [sum_update_of_eq_zero _ _ _ _ (hc i le_rfl), Function.update_self, add_sub_cancel_right,
    ← mul_assoc, ZMod.inv_mul_of_unit _ hu, one_mul, Function.update_idem,
    Function.update_eq_self]

lemma shiftVec_shiftInvVec {i : Fin n} {u : ZMod Q} {c : Fin n → ZMod Q} (hu : IsUnit u)
    (hc : ∀ j, i ≤ j → c j = 0) (y : Fin n → ZMod Q) :
    shiftVec i u c (shiftInvVec i u c y) = y := by
  unfold shiftInvVec shiftVec
  rw [sum_update_of_eq_zero _ _ _ _ (hc i le_rfl), Function.update_self,
    ← mul_assoc, ZMod.mul_inv_of_unit _ hu, one_mul, sub_add_cancel, Function.update_idem,
    Function.update_eq_self]

end Shift

