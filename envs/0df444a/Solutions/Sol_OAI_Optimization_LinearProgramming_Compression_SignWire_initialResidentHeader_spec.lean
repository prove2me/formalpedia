  let env := inputs m
  have prep := CursorBind.run bindings m hm
  have high (i : ℕ) (hi : 6 ≤ i) : u.index i=m.index i := prep.index_frame (R:=6) (by decide) hi
  have read (i : Fin 6) : u.index i=env i := by
