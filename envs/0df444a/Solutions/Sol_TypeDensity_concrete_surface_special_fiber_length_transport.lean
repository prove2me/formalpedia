    change Ideal.Quotient.mk _ (φ x) = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
    change e (Ideal.Quotient.mk I f) ∣ e (Ideal.Quotient.mk I x) ↔ _
