  unfold cRest cPro cGlob cLs cIt
  have hk := kap_le hp
  have hU := cU_le Z
  have hCU : 1 ≤ CU := by unfold CU; omega
  have hY1 : (Z + 1) ^ 2 ≤ CU * (Z + 1) ^ 2 := Nat.le_mul_of_pos_left _ hCU
  generalize CU * (Z + 1) ^ 2 = Y at hU hT hY1
  generalize cU Z = U at hU ⊢
  -- `T`-bounded quantities
  have hT' : (d + 2) * (U + 5 * Z + 10 ^ 4) ≤ T :=
    le_trans (Nat.mul_le_mul_left _ (by omega)) hT
  have hZ2 : (Z + 2) ^ 2 ≤ Y + 5 * Z + 10 ^ 4 := by nlinarith
  have a1 : (d + 1) * (Z + 2) ^ 2 ≤ T :=
    le_trans (Nat.mul_le_mul (by omega) hZ2) hT
  have a3 : (d + 1) * (Z + 1 + 2) ≤ T := by
    have : (d + 1) * (Z + 1 + 2) ≤ (d + 2) * (U + 5 * Z + 10 ^ 4) :=
      Nat.mul_le_mul (by omega) (by omega)
    omega
  -- `X = (d+1) T p`
  have hdp : 1 ≤ (d + 1) * p := Nat.mul_pos (by omega) (by omega)
  have hTX : T ≤ (d + 1) * T * p :=
    calc T = T * 1 := (mul_one T).symm
      _ ≤ T * ((d + 1) * p) := Nat.mul_le_mul_left _ hdp
      _ = (d + 1) * T * p := by ring
  have hdTX : (d + 1) * T ≤ (d + 1) * T * p := Nat.le_mul_of_pos_right _ (by omega)
  have c4 : (d + 1) * (2 * T * (3 * p + 3)) ≤ 12 * ((d + 1) * T * p) := by
    have e : (d + 1) * (2 * T * (3 * p + 3)) = 6 * ((d + 1) * T * p) + 6 * ((d + 1) * T) := by ring
    omega
  -- the kap part
