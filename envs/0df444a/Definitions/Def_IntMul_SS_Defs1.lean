-- Source module: NLogNP.Take
/-!
# Lockstep transfer: `take`

While the top of `b` is a bit, pop it and push it on `e`; at the same time, if the top of `a` is a
bit, move it to `d`.  So `|Bw|` bits are taken from `a`, where `Bw` is the bit word on `b`.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def takeδ (q a b d e : Fin S) : List (Option Sym) → List (Op S)
  | [_, ta, some sb] =>
    if (bitOf (some sb)).isSome then
      (match ta with
        | some sa => if (bitOf (some sa)).isSome then [.pop a, .push d sa] else []
        | none => []) ++ [.pop b, .push e sb]
    else [.pop q, .push q hlt]
  | _ => [.pop q, .push q hlt]

def take (q a b d e : Fin S) : Stmt S P := machine q [a, b] 0 (takeδ q a b d e)

def takeCost (m : ℕ) : ℕ := (m + 1) * 57 + 3

end NLogN

end

