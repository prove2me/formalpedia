import Definitions.Def_IntMul_Kappa_R6_Defs3

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Seg
open Finset
variable (P : ℕ)

theorem J6Seg.geSolve_resid : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (η Z : ℝ),
    L.Nodup → 0 ≤ η → η + (L.length : ℝ) ^ 2 / 2 ^ P ≤ 1 / 2 →
    (∀ i ∈ L, ∑ k ∈ L.toFinset, |(A i k : ℝ) / 2 ^ P - kd i k| ≤ η) →
    (∀ k ∈ L, |(geSolve P L A b k : ℝ) / 2 ^ P| ≤ Z) →
    ∀ i ∈ L, |∑ k ∈ L.toFinset, (A i k : ℝ) / 2 ^ P * ((geSolve P L A b k : ℝ) / 2 ^ P) -
      (b i : ℝ) / 2 ^ P| ≤ (Z + 1) * ((L.length : ℝ) + 1) ^ 2 / 2 ^ P := by sorry
