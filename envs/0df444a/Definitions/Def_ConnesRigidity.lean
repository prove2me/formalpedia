local instance shalomTorusCircleMeasurable : MeasurableSpace Circle := borel Circle
local instance shalomTorusCircleBorel : BorelSpace Circle := ⟨rfl⟩
abbrev ShalomTorus := Circle × Circle
def torusShearTpos : ShalomTorus ≃ₜ ShalomTorus where
  toFun p := (p.1, p.2 / p.1)
  invFun p := (p.1, p.2 * p.1)
  left_inv := by
    rintro ⟨z, w⟩
    simp
  right_inv := by
    rintro ⟨z, w⟩
    simp
  continuous_toFun := continuous_fst.prodMk (by
    change Continuous (fun p : Circle × Circle => p.2 * p.1⁻¹)
    fun_prop)
  continuous_invFun := continuous_fst.prodMk (continuous_snd.mul continuous_fst)
def torusShearSpos : ShalomTorus ≃ₜ ShalomTorus where
  toFun p := (p.1 / p.2, p.2)
  invFun p := (p.1 * p.2, p.2)
  left_inv := by
    rintro ⟨z, w⟩
    simp
  right_inv := by
    rintro ⟨z, w⟩
    simp
  continuous_toFun := by
    change Continuous (fun p : Circle × Circle => (p.1 * p.2⁻¹, p.2))
    fun_prop
  continuous_invFun := (continuous_fst.mul continuous_snd).prodMk continuous_snd
def torusShearTneg : ShalomTorus ≃ₜ ShalomTorus :=
  torusShearTpos.symm
def torusShearSneg : ShalomTorus ≃ₜ ShalomTorus :=
  torusShearSpos.symm
@[simp] theorem torusShearTpos_apply (z w : Circle) :
    torusShearTpos (z, w) = (z, w / z) := rfl
@[simp] theorem torusShearSpos_apply (z w : Circle) :
    torusShearSpos (z, w) = (z / w, w) := rfl
@[simp] theorem torusShearTneg_apply (z w : Circle) :
    torusShearTneg (z, w) = (z, w * z) := rfl
@[simp] theorem torusShearSneg_apply (z w : Circle) :
    torusShearSneg (z, w) = (z * w, w) := rfl
@[simp] theorem torusShearTpos_symm :
    torusShearTpos.symm = torusShearTneg := rfl
@[simp] theorem torusShearSpos_symm :
    torusShearSpos.symm = torusShearSneg := rfl
@[simp] theorem torusShearTneg_symm :
    torusShearTneg.symm = torusShearTpos := by
  rfl
@[simp] theorem torusShearSneg_symm :
    torusShearSneg.symm = torusShearSpos := by
  rfl
