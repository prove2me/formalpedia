open ErschlerZheng
theorem solution
    {G : Type*} [Group G] (μ : G → ℝ) (hμ : IsNondegenerate μ) :
    HasNontrivialPoissonBoundary μ ↔
      ∃ f : G → ℝ, (∃ C, ∀ x, |f x| ≤ C) ∧ IsHarmonic μ f ∧ ∃ x y, f x ≠ f y := by
  have htop := NewWalksDev.mem_closure_support_of_isNondegenerate μ hμ
  constructor
  · rintro ⟨f, hb, hh, x, -, y, -, hxy⟩
    exact ⟨f, hb, hh, x, y, hxy⟩
  · rintro ⟨f, hb, hh, x, y, hxy⟩
    exact ⟨f, hb, hh, x, htop x, y, htop y, hxy⟩
end
