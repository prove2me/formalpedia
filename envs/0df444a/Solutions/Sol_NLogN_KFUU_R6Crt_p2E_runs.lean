/-! ## The layout conversion -/

theorem rIdx_half_lt {n N : ℕ} (hn : n ≤ N) : ∀ i < N, rIdx n (n / 2) i < N := by
  intro i hi; unfold rIdx; split_ifs <;> omega

theorem rIdx_half_inv {n : ℕ} (i : ℕ) : rIdx n (n / 2) (rIdx n (n / 2) i) = i := by
  unfold rIdx; split_ifs <;> omega

theorem pop_rv_half {n N : ℕ} (hn : n ≤ N) : POp (rv n (n / 2)) (rIdx n (n / 2)) N where
  eq b _ := rfl
  lt := rIdx_half_lt hn
  surj j hj := ⟨rIdx n (n / 2) j, rIdx_half_lt hn j hj, rIdx_half_inv j⟩

theorem rv_rv_half {n : ℕ} {l : List ℕ} (hn : n ≤ l.length) : rv n (n / 2) (rv n (n / 2) l) = l := by
  rw [rv_half (by simp; omega), rv_half hn]
  have h1 : ((l.take n).reverse ++ l.drop n).take n = (l.take n).reverse := by
    rw [List.take_append_of_le_length (by simp; omega), List.take_of_length_le (by simp)]
  have h2 : ((l.take n).reverse ++ l.drop n).drop n = l.drop n := by
    rw [List.drop_append_of_le_length (by simp; omega), List.drop_of_length_le (by simp)]
    simp
  rw [h1, h2, List.reverse_reverse, List.take_append_drop]

/-- **The layout of the reversed data.** -/
theorem word_Dl (u cz : ℕ) (bs : List Bool) (hu : 1 ≤ u) (hcz : 1 ≤ cz) (xs0 : List ℤ) :
    pull (SH bs.length (2 ^ u) (ctB u cz bs ++ [cz])) (SH bs.length (2 ^ u) (ctB u cz bs ++ [cz]))
        (word (2 ^ u) bs.length) 0
        (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
          (lay1 (bgB bs) bs.length 0) xs0 0) =
      Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (((lay1 (bgB bs) bs.length 0).take bs.length).reverse ++
          (lay1 (bgB bs) bs.length 0).drop bs.length) xs0 0 := by
  set n := bs.length with hn
  set lay0 := lay1 (bgB bs) n 0 with hlay0
  set mz := mzB u n cz
  have hr : n ≤ lay0.length := len_lay0 bs
  have hQ2 : 2 ≤ 2 ^ u := by
    have : 2 ^ 1 ≤ 2 ^ u := Nat.pow_le_pow_right (by norm_num) hu
    simpa using this
  have hsh : lay0.map (asz mz) = SH n (2 ^ u) (ctB u cz bs ++ [cz]) := by
    rw [hlay0, shape_lay0]; rfl
