import Definitions.Def_IntMul_Kappa_R6_Defs66

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Seg J6Seg.JK
open IntMul NLogN NLogN.KIL Function Finset
variable {P : ℕ} {F : Fin HS → List ℤ} {X : Fin HS} {cs acc R T0 : List ℤ} {S0 : ℤ} {Ls : List ℤ}

theorem J6Seg.JK.dotP_spec {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M Xb Φm) (hX : XOK X)
    (s : IState HS) {lp lp1 Lc : List ℤ} (hPX : F PX = []) (hrP : F rP = 2 ^ P :: lp)
    (hrP1 : F rP1 = 2 ^ (P + 1) :: lp1) (hCD : F CD = []) (hTMP : F TMP = [])
    (hT : F dTJ = cs ++ R) (hTT : F J6Seg.JK.TT = T0) (hXa : F X = acc) (hS : F SUM = S0 :: Ls)
    (hCNT : F CNT = (cs.length : ℤ) :: Lc)
    (hca : cs.length ≤ acc.length) (hcB : Bnd Xb cs) (haB : Bnd Xb acc)
    (hXB : 2 * Xb + 3 ≤ Bx) (hPB : P + 3 ≤ Bx) (hcl : zsz (cs.length : ℤ) ≤ Bc) (hBc : Bc ≤ Bx)
    (hSk : ∀ k ≤ cs.length, zsz (S0 + dotF P (cs.take k) acc) ≤ Bx) :
    MSp M (dotP X) (encK s F)
      (encK s (update (update (update F dTJ R) J6Seg.JK.TT (cs.reverse ++ T0)) SUM
        ((S0 + dotF P cs acc) :: Ls)))
      ((cs.length + 1) * uC Φm Bx Bc) := by sorry
