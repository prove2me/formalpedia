namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

/-- The original homogeneous restriction between uniformly named terms. -/
noncomputable def cechNativeTermRestrictionHom (rank : V ↪ ℕ) {K L : Complex V}
    (h : K.faces ⊆ L.faces) (T : Finset V) (p : ℕ) (a : V → ℤ) :
    cechNativeTermFamily k L T p a ⟶ cechNativeTermFamily k K T p a :=
  (localizedCechRestriction k rank h T a).f p

theorem cechNativeAmbientDegreeLegHom_restriction (rank : V ↪ ℕ) {K L : Complex V}
    (h : K.faces ⊆ L.faces) (T : Finset V) (p : ℕ) (a : V → ℤ) :
    cechNativeAmbientDegreeLegHom k L T p a ≫
        (ModuleCat.restrictScalars (MvPolynomial.C : k →+* MvPolynomial V k)).map
          (ModuleCat.ofHom (ambientCechTermRestriction k h T p)) =
      cechNativeTermRestrictionHom k rank h T p a ≫ cechNativeAmbientDegreeLegHom k K T p a := by
  rw [cechNativeAmbientDegreeLegHom_eq_actual, cechNativeAmbientDegreeLegHom_eq_actual]
  exact congrArg (fun f => f.f p) (localizedCechDegreeInclusion_restriction k rank h T a)

/-- Original quotient restriction in the explicit field views. Only the
identity scalar-view comparisons are used in this expression. -/
noncomputable def cechNativeAmbientFieldRestrictionHom {K L : Complex V}
    (h : K.faces ⊆ L.faces) (T : Finset V) (p : ℕ) :
    cechNativeAmbientFieldTerm k L T p ⟶ cechNativeAmbientFieldTerm k K T p :=
  (ambientCechTermFieldIso k L T p).inv ≫
    (ModuleCat.restrictScalars (MvPolynomial.C : k →+* MvPolynomial V k)).map
      (ModuleCat.ofHom (ambientCechTermRestriction k h T p)) ≫
        (ambientCechTermFieldIso k K T p).hom

theorem cechNativeAmbientFieldIso_restriction {K L : Complex V}
    (h : K.faces ⊆ L.faces) (T : Finset V) (p : ℕ) :
    (ModuleCat.restrictScalars (MvPolynomial.C : k →+* MvPolynomial V k)).map
        (ModuleCat.ofHom (ambientCechTermRestriction k h T p)) ≫ (ambientCechTermFieldIso k K T p).hom =
      (ambientCechTermFieldIso k L T p).hom ≫ cechNativeAmbientFieldRestrictionHom k h T p := by
  simp only [cechNativeAmbientFieldRestrictionHom, Iso.hom_inv_id_assoc]

theorem cechNativeTermForgetHom_restriction (rank : V ↪ ℕ) {K L : Complex V}
    (h : K.faces ⊆ L.faces) (T : Finset V) (p : ℕ) (a : V → ℤ) :
    cechNativeTermForgetHom k L T p a ≫ cechNativeAmbientFieldRestrictionHom k h T p =
      cechNativeTermRestrictionHom k rank h T p a ≫ cechNativeTermForgetHom k K T p a := by
  rw [← cechNativeAmbientDegreeLegHom_field, ← cechNativeAmbientDegreeLegHom_field]
  simp only [Category.assoc]
  rw [← cechNativeAmbientFieldIso_restriction, ← Category.assoc,
    cechNativeAmbientDegreeLegHom_restriction, Category.assoc]

theorem coordinateFixedSupportCechComplexIso_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (U A : Finset V)
    (a : V → ℤ) (ha : ∀ v ∈ U, 0 ≤ a v) (hA : coordinatePositivePart U a = A) :
    localizedCechRestriction k rank h (coordinateCechSupport U) a ≫
        (coordinateFixedSupportComplementCechComplexIso k rank K U A a ha hA).hom =
      (coordinateFixedSupportComplementCechComplexIso k rank L U A a ha hA).hom ≫
        localizedCechRestriction k ((coordinateComplementEmbedding U).trans rank)
          (coordinateComplementComplex_faces_mono h U A) Finset.univ (a ∘ coordinateComplementEmbedding U) := by
  subst A
  exact coordinateComplementCechComplexIso_restriction k rank h U a ha

theorem coordinateFixedExponentCechComplexIso_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (U : Finset V)
    (c : {v : V // v ∈ U} → ℕ) (b : {v : V // v ∉ U} → ℤ) :
    localizedCechRestriction k rank h (coordinateCechSupport U)
        (extendCoordinateDegree U (fun v => (c v : ℤ)) b) ≫
        (coordinateFixedExponentCechComplexIso k rank K U c b).hom =
      (coordinateFixedExponentCechComplexIso k rank L U c b).hom ≫
        localizedCechRestriction k ((coordinateComplementEmbedding U).trans rank)
          (coordinateComplementComplex_faces_mono h U (coordinateExponentSupport U c)) Finset.univ b := by
  have hs := coordinateFixedSupportCechComplexIso_restriction k rank h U
    (coordinateExponentSupport U c) (extendCoordinateDegree U (fun v => (c v : ℤ)) b)
    (extendCoordinateDegree_nonnegative U c b) (coordinatePositivePart_extend U c b)
  have ht := localizedCechRestriction_degree_cast k ((coordinateComplementEmbedding U).trans rank)
    (coordinateComplementComplex_faces_mono h U (coordinateExponentSupport U c)) Finset.univ
    (extendCoordinateDegree_complement U (fun v => (c v : ℤ)) b)
  simp only [coordinateFixedExponentCechComplexIso, Iso.trans_hom, Category.assoc]
  rw [reassoc_of% hs, ht]

attribute [local irreducible] coordinateFixedExponentCechComplexIso

theorem coordinateFixedExponentTermIso_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (U : Finset V)
    (c : {v : V // v ∈ U} → ℕ) (b : {v : V // v ∉ U} → ℤ) (p : ℕ) :
    cechNativeTermRestrictionHom k rank h (coordinateCechSupport U) p
        (extendCoordinateDegree U (fun v => (c v : ℤ)) b) ≫
        (coordinateFixedExponentTermIso k rank K U c b p).hom =
      (coordinateFixedExponentTermIso k rank L U c b p).hom ≫
        cechNativeTermRestrictionHom k ((coordinateComplementEmbedding U).trans rank)
          (coordinateComplementComplex_faces_mono h U (coordinateExponentSupport U c)) Finset.univ p b := by
  exact congrArg (fun f => f.f p) (coordinateFixedExponentCechComplexIso_restriction k rank h U c b)

end LPCA


