theorem pre_mono (Dl : List ℕ) {j k : ℕ} (h : j ≤ k) : NLogN.Rsp.pre Dl j ≤ NLogN.Rsp.pre Dl k := by
  unfold NLogN.Rsp.pre
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [List.take_add, List.sum_append]; omega

theorem kSt_G_other (u : IState HS) (R : ℤ) (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA LCC : List Item) (k : ℕ) (x : Fin HS) (h1 : x ≠ NLogN.Rsp.BX) (h2 : x ≠ BY) (h3 : x ≠ BCC)
    (h4 : x ≠ NLogN.Rsp.BW) (h5 : x ≠ BWT) (h6 : x ≠ BD) (h7 : x ≠ BDT) (h8 : x ≠ BA) (h9 : x ≠ BAT) :
    (kSt u R Xi Dl Wi acc RX RW RD RA LCC k).G x = u.G x := by
  simp only [kSt, IState.upd_G, if_neg h1, if_neg h2, if_neg h3, if_neg h4, if_neg h5, if_neg h6,
    if_neg h7, if_neg h8, if_neg h9]

theorem withCtr_G_ne' (i : Fin HS) (s t : IState HS) (N k : ℕ) (x : Fin HS) (hx : x ≠ i) :
    (withCtr i s N k t).G x = t.G x := by simp [withCtr, hx]

set_option maxHeartbeats 4000000 in
theorem k_run (u : IState HS) (R : ℤ) (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA LCC LR : List Item) (n : ℕ)
    (hWl : Wi.length = n) (hDl : Dl.length = n) (hal : acc.length = n)
    (hX : NLogN.Rsp.pre Dl n < Xi.length) (huR : u.G BR = .int R :: LR) (S0 : IState HS) (N0 k : ℕ)
    (hk : k < n) :
    (mvK NLogN.Rsp.BX BY BCM (.reg BD)).ok (withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k)) ∧
    kBody.run (withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k)) =
      withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC (k + 1)) := by
  generalize ht : withCtr BCK S0 N0 k (kSt u R Xi Dl Wi acc RX RW RD RA LCC k) = t
  have tG : ∀ x, x ≠ BCK → t.G x = (kSt u R Xi Dl Wi acc RX RW RD RA LCC k).G x := fun x hx => by
    rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
  have hkD : k < Dl.length := by omega
  have hkW : k < Wi.length := by omega
  have hka : k < acc.length := by omega
  obtain ⟨a, ha⟩ : ∃ a, NLogN.Rsp.pre Dl k = a := ⟨_, rfl⟩
  obtain ⟨d, hd⟩ : ∃ d, Dl[k] = d := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w, Wi[k] = w := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c, acc[k] = c := ⟨_, rfl⟩
  have hpre : NLogN.Rsp.pre Dl (k + 1) = a + d := by rw [pre_succ Dl k hkD, ha, hd]
  have hle : NLogN.Rsp.pre Dl (k + 1) ≤ NLogN.Rsp.pre Dl n := pre_mono Dl (by omega)
  obtain ⟨x0, hx0⟩ : ∃ x0, Xi[a + d]'(by omega) = x0 := ⟨_, rfl⟩
  have hXd : Xi.drop a = (Xi.drop a).take d ++ Xi.drop (a + d) := by
    rw [← List.drop_drop, List.take_append_drop]
  have hlen : ((Xi.drop a).take d).length = d := by simp; omega
  have hDk : (Dl.map (Nat.cast : ℕ → ℤ)).drop k = (d : ℤ) :: (Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1) := by
    rw [List.drop_eq_getElem_cons (by simpa using hkD)]; simp [hd]
  have hWk : Wi.drop k = w :: Wi.drop (k + 1) := by rw [List.drop_eq_getElem_cons hkW, hw]
  have hAk : acc.drop k = c :: acc.drop (k + 1) := by rw [List.drop_eq_getElem_cons hka, hc]
  have hXk : Xi.drop (a + d) = x0 :: Xi.drop (a + d + 1) := by
    rw [List.drop_eq_getElem_cons (by omega), hx0]
  have tX : t.G NLogN.Rsp.BX = ints ((Xi.drop a).take d) ++ (ints (Xi.drop (a + d)) ++ RX) := by
    rw [tG NLogN.Rsp.BX (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [ha]; conv_lhs => rw [hXd]
    rw [ints_append, List.append_assoc]
  have tD : t.G BD = .int (d : ℤ) :: (ints ((Dl.map (Nat.cast : ℕ → ℤ)).drop (k + 1)) ++ RD) := by
    rw [tG BD (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hDk]; rfl
  have hm := mvK_spec (X := NLogN.Rsp.BX) (Y := BY) (C := BCM) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BD) (RS.clean_of_lt (by decide)) t
    ((Xi.drop a).take d) _ tX (IState.isInt_of tD) (by rw [hlen]; simp [Ex.eval, IState.top, tD])
  refine ⟨hm.1, ?_⟩
  have tW : t.G NLogN.Rsp.BW = .int w :: (ints (Wi.drop (k + 1)) ++ RW) := by
    rw [tG NLogN.Rsp.BW (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hWk]; rfl
  have tA : t.G BA = .int c :: (ints (acc.drop (k + 1)) ++ RA) := by
    rw [tG BA (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
    rw [hAk]; rfl
  have tC : t.G BCC = .int (a : ℤ) :: LCC := by
    rw [tG BCC (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true}) [ha]
  have tR : t.G BR = .int R :: LR := by
    rw [tG BR (by decide), kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide), huR]
  have hout : (bandRound R Xi Dl Wi acc).take (k + 1) = (bandRound R Xi Dl Wi acc).take k ++
      [c + (w * x0).tdiv R] := by
    rw [← List.take_concat_get' _ k (by rw [bandRound_length]; omega)]
    congr 2
    simp only [bandRound, List.getElem_map, List.getElem_range]
    rw [List.getD_eq_getElem _ _ hka, List.getD_eq_getElem _ _ hkW, hpre,
      List.getD_eq_getElem _ _ (by omega), hc, hw, hx0]
  have hXt : (Xi.take (a + d)).reverse =
      ((Xi.drop a).take d).reverse ++ (Xi.take a).reverse := by
    rw [List.take_add, List.reverse_append]
  have hDt : (Dl.map (Nat.cast : ℕ → ℤ)).take (k + 1) =
      (Dl.map (Nat.cast : ℕ → ℤ)).take k ++ [(d : ℤ)] := by
    rw [← List.take_concat_get' _ k (by simpa using hkD)]; simp [hd]
  have hWt : Wi.take (k + 1) = Wi.take k ++ [w] := by rw [← List.take_concat_get' _ k hkW, hw]
  have hAt : acc.drop (k + 1) = acc.drop (k + 1) := rfl
  simp only [kBody, RM.run, hm.2]
  apply RS.run_ext _ (by rw [← ht]; simp [withCtr, kSt]) (by rw [← ht]; simp [withCtr, kSt])
  intro x
  simp only [seqL, RS.run_seq, RS.run_push_G, RS.run_pop_G, RS.run_asg_G, RM.run_mul_G,
    IState.upd_G, Ex.eval]
  have tY : t.G BY = ints (Xi.take a).reverse ++ u.G BY := by
    rw [tG BY (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true}) [ha]
  have tWT : t.G BWT = ints (Wi.take k).reverse ++ u.G BWT := by
    rw [tG BWT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  have tDT : t.G BDT = ints ((Dl.map (Nat.cast : ℕ → ℤ)).take k).reverse ++ u.G BDT := by
    rw [tG BDT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  have tAT : t.G BAT = ints ((bandRound R Xi Dl Wi acc).take k).reverse ++ u.G BAT := by
    rw [tG BAT (by decide)]; simp only [kSt, IState.upd_G]; simp (config := {decide := true})
  by_cases x1 : x = NLogN.Rsp.BX
  · subst x1; simp (config := {decide := true}) [withCtr, kSt, hpre, hXk, ← ha]
  by_cases x2 : x = BY
  · subst x2; simp (config := {decide := true}) [withCtr, kSt, hpre, tY, hXt, ints_append, ints_reverse]
  by_cases x3 : x = BCC
  · subst x3; simp (config := {decide := true}) [withCtr, kSt, hpre, tC, IState.top, tD]
  by_cases x4 : x = NLogN.Rsp.BW
  · subst x4; simp (config := {decide := true}) [withCtr, kSt, tW]
  by_cases x5 : x = BWT
  · subst x5; simp (config := {decide := true}) [withCtr, kSt, tWT, IState.top, tW, hWt, ints_append, ints_reverse]
  by_cases x6 : x = BD
  · subst x6; simp (config := {decide := true}) [withCtr, kSt, tD]
  by_cases x7 : x = BDT
  · subst x7; simp (config := {decide := true}) [withCtr, kSt, tDT, IState.top, tD, hDt, ints_append, ints_reverse]
  by_cases x8 : x = BA
  · subst x8; simp (config := {decide := true}) [withCtr, kSt, tA]
  by_cases x9 : x = BAT
  · subst x9; simp (config := {decide := true}) [withCtr, kSt, tAT, IState.top, tA, tR, tW, hout,
      ints_append, ints_reverse, tX, hXk]
  by_cases x10 : x = BP
  · subst x10; simp (config := {decide := true}) [withCtr, kSt, tG]
  by_cases x11 : x = BCK
  · subst x11; simp (config := {decide := true}) [withCtr, kSt]; rw [← ht]; simp [withCtr]
  simp only [if_neg x1, if_neg x2, if_neg x3, if_neg x4, if_neg x5, if_neg x6, if_neg x7, if_neg x8,
    if_neg x9, if_neg x10, if_neg x11, withCtr_G_ne' _ _ _ _ _ _ x11]
  rw [tG x x11, kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ x1 x2 x3 x4 x5 x6 x7 x8 x9,
    kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ x1 x2 x3 x4 x5 x6 x7 x8 x9]

theorem inner_states (u : IState HS) (R : ℤ) (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA LCC LR LN : List Item) (n : ℕ)
    (hWl : Wi.length = n) (hDl : Dl.length = n) (hal : acc.length = n)
    (hX : NLogN.Rsp.pre Dl n < Xi.length) (huR : u.G BR = .int R :: LR) (huN : u.G BN = .int n :: LN)
    (h0 : kSt u R Xi Dl Wi acc RX RW RD RA LCC 0 = u) :
    RM.RepStates BCK (.reg BN) kBody u (kSt u R Xi Dl Wi acc RX RW RD RA LCC) where
  nonneg := by simp [Ex.eval, IState.top, huN]
  hw := by decide
  h0 := h0
  hG := fun k => kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
  step := fun k hk => by
    have e : ((Ex.reg BN).eval u).toNat = n := by simp [Ex.eval, IState.top, huN]
    rw [e] at hk ⊢
    exact (k_run u R Xi Dl Wi acc RX RW RD RA LCC LR n hWl hDl hal hX huR u n k hk).2

theorem kSt_zero (u0 : IState HS) (R : ℤ) (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA : List Item)
    (hX : u0.G NLogN.Rsp.BX = ints Xi ++ RX) (hW : u0.G NLogN.Rsp.BW = ints Wi ++ RW)
    (hD : u0.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : u0.G BA = ints acc ++ RA) :
    kSt ((push BCC (.lit 0)).run u0) R Xi Dl Wi acc RX RW RD RA (u0.G BCC) 0 =
      (push BCC (.lit 0)).run u0 := by
  apply IState.ext' _ (by simp [kSt]) (by simp [kSt])
  intro x
  simp only [kSt, IState.upd_G, RS.run_push_G]
  split_ifs <;> subst_vars <;> simp_all (config := {decide := true}) [NLogN.Rsp.pre, Ex.eval]

set_option maxHeartbeats 4000000 in
theorem round_run (u0 : IState HS) (R : ℤ) (Xi : List ℤ) (Dl : List ℕ) (Wi acc : List ℤ)
    (RX RW RD RA LR LN : List Item) (n : ℕ)
    (hWl : Wi.length = n) (hDl : Dl.length = n) (hal : acc.length = n)
    (hXl : NLogN.Rsp.pre Dl n < Xi.length) (hR : u0.G BR = .int R :: LR) (hN : u0.G BN = .int n :: LN)
    (hX : u0.G NLogN.Rsp.BX = ints Xi ++ RX) (hW : u0.G NLogN.Rsp.BW = ints Wi ++ RW)
    (hD : u0.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD) (hA : u0.G BA = ints acc ++ RA) :
    NLogN.Rsp.roundBody.run u0 = (((u0.upd NLogN.Rsp.BX (ints (Xi.drop 1) ++ RX)).upd NLogN.Rsp.BW RW).upd BWT
      (ints Wi.reverse ++ u0.G BWT)).upd BA (ints (bandRound R Xi Dl Wi acc) ++ RA) := by
  set u := (push BCC (.lit 0)).run u0 with hu
  have uR : u.G BR = .int R :: LR := by simp (config := {decide := true}) [hu, hR]
  have uN : u.G BN = .int n :: LN := by simp (config := {decide := true}) [hu, hN]
  have H := NLogN.Rsp.inner_states u R Xi Dl Wi acc RX RW RD RA (u0.G BCC) LR LN n hWl hDl hal hXl uR uN
    (kSt_zero u0 R Xi Dl Wi acc RX RW RD RA hX hW hD hA)
  have e : ((Ex.reg BN).eval u).toNat = n := by simp [Ex.eval, IState.top, uN]
  have hrun := H.run
  rw [e] at hrun
  simp only [NLogN.Rsp.roundBody, RM.run, RM.run_rs] at hrun ⊢
  rw [← hu, hrun]
  set v := kSt u R Xi Dl Wi acc RX RW RD RA (u0.G BCC) n with hv
  have hout : (bandRound R Xi Dl Wi acc).take n = bandRound R Xi Dl Wi acc := by
    rw [List.take_of_length_le (by rw [bandRound_length]; omega)]
  have vY : v.G BY = ints (Xi.take (NLogN.Rsp.pre Dl n)).reverse ++ u0.G BY := by
    simp (config := {decide := true}) [hv, kSt, hu]
  have vC : v.G BCC = .int (NLogN.Rsp.pre Dl n : ℤ) :: u0.G BCC := by
    simp (config := {decide := true}) [hv, kSt, hu]
  have h1 := mvK_spec (X := BY) (Y := NLogN.Rsp.BX) (C := BCK) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BCC) (RS.clean_of_lt (by decide)) v
    (Xi.take (NLogN.Rsp.pre Dl n)).reverse _ vY (IState.isInt_of vC)
    (by simp [Ex.eval, IState.top, vC]; omega)
  simp only [seqL, RS.run_seq]
  rw [h1.2]
  set v1 := (v.upd BY (u0.G BY)).upd NLogN.Rsp.BX ((ints (Xi.take (NLogN.Rsp.pre Dl n)).reverse).reverse ++ v.G NLogN.Rsp.BX) with hv1
  have v1X : v1.G NLogN.Rsp.BX = ints Xi ++ RX := by
    simp (config := {decide := true}) [hv1, hv, kSt, ← ints_reverse]
    rw [← List.append_assoc, ← ints_append, List.take_append_drop]
  have hXc : Xi = Xi.take 1 ++ Xi.drop 1 := (List.take_append_drop 1 Xi).symm
  obtain ⟨x0, Xr, hXr⟩ : ∃ x0 Xr, Xi = x0 :: Xr := by
    cases Xi with
    | nil => simp at hXl
    | cons x0 Xr => exact ⟨x0, Xr, rfl⟩
  set v2 := (pop NLogN.Rsp.BX).run ((pop BCC).run v1) with hv2
  have v2AT : v2.G BAT = ints (bandRound R Xi Dl Wi acc).reverse ++ u0.G BAT := by
    simp (config := {decide := true}) [hv2, hv1, hv, kSt, hu, hout]
  have h2 := mvK_spec (X := BAT) (Y := BA) (C := BCK) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BN) (RS.clean_of_lt (by decide)) v2
    (bandRound R Xi Dl Wi acc).reverse _ v2AT
    (IState.isInt_of (L := LN) (a := n) (by simp (config := {decide := true}) [hv2, hv1, hv, kSt, hu, hN]))
    (by simp (config := {decide := true}) [Ex.eval, IState.top, hv2, hv1, hv, kSt, hu, hN,
      bandRound_length, hal])
  rw [h2.2]
  set v3 := (v2.upd BAT (u0.G BAT)).upd BA ((ints (bandRound R Xi Dl Wi acc).reverse).reverse ++ v2.G BA) with hv3
  have hDn : (Dl.map (Nat.cast : ℕ → ℤ)).take n = Dl.map (Nat.cast : ℕ → ℤ) :=
    List.take_of_length_le (by simp [hDl])
  have v3DT : v3.G BDT = ints (Dl.map (Nat.cast : ℕ → ℤ)).reverse ++ u0.G BDT := by
    simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hDn]
  have h3 := mvK_spec (X := BDT) (Y := BD) (C := BCK) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg BN) (RS.clean_of_lt (by decide)) v3
    (Dl.map (Nat.cast : ℕ → ℤ)).reverse _ v3DT
    (IState.isInt_of (L := LN) (a := n) (by simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hN]))
    (by simp (config := {decide := true}) [Ex.eval, IState.top, hv3, hv2, hv1, hv, kSt, hu, hN, hDl])
  rw [h3.2]
  apply IState.ext' _ (by simp [hv3, hv2, hv1, hv, kSt, hu]) (by simp [hv3, hv2, hv1, hv, kSt, hu])
  intro x
  have hWn : Wi.take n = Wi := List.take_of_length_le (by omega)
  have hWd : Wi.drop n = [] := List.drop_of_length_le (by omega)
  have hAd : acc.drop n = [] := List.drop_of_length_le (by omega)
  have hDd : (Dl.map (Nat.cast : ℕ → ℤ)).drop n = [] := List.drop_of_length_le (by simp [hDl])
  by_cases x1 : x = NLogN.Rsp.BX
  · subst x1; simp (config := {decide := true}) [hv3, hv2, v1X, hXr]
  by_cases x2 : x = BY
  · subst x2; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu]
  by_cases x3 : x = BCC
  · subst x3; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu]
  by_cases x4 : x = NLogN.Rsp.BW
  · subst x4; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hWd]
  by_cases x5 : x = BWT
  · subst x5; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hWn]
  by_cases x6 : x = BD
  · subst x6; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hDd, hD, ← ints_reverse]
  by_cases x7 : x = BDT
  · subst x7; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu]
  by_cases x8 : x = BA
  · subst x8; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu, hAd, ← ints_reverse]
  by_cases x9 : x = BAT
  · subst x9; simp (config := {decide := true}) [hv3, hv2, hv1, hv, kSt, hu]
  have e1 : v.G x = u0.G x := by
    rw [hv, kSt_G_other _ _ _ _ _ _ _ _ _ _ _ _ _ x1 x2 x3 x4 x5 x6 x7 x8 x9, hu,
      RS.run_push_G, if_neg x3]
  simp only [hv3, hv2, hv1, IState.upd_G, RS.run_pop_G, if_neg x1, if_neg x2, if_neg x3, if_neg x4,
    if_neg x5, if_neg x6, if_neg x7, if_neg x8, if_neg x9, e1]

end NLogN.Rsp

