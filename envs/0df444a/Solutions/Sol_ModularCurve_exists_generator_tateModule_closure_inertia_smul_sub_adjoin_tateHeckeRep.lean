  intro τ hτ
  have h2 : algebraMap ℤ_[2] ℚ_[2] 2 = ((2 : ℕ) : ℚ_[2]) := by rw [map_ofNat]; norm_num
  refine Algebra.adjoin_induction (hx := hτ) ?_ ?_ ?_ ?_
  · rintro _ ⟨t, rfl⟩
    exact ⟨0, tateHeckeRep 2 J t, Algebra.subset_adjoin ⟨t, rfl⟩, by rw [pow_zero, one_smul]; rfl⟩
  · intro q
    obtain ⟨e, a, ha⟩ := PadicInt.exists_pow_mul_eq_coe 2 q
    refine ⟨e, algebraMap ℤ_[2] _ a, Subalgebra.algebraMap_mem _ a, ?_⟩
    rw [h2, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one, smul_smul, ha, baseChange_smul_end,
      baseChange_one_end]
    rfl
  · rintro α β - - ⟨e, a, ha, hα⟩ ⟨e', a', ha', hβ⟩
    refine ⟨e + e', ((2 : ℤ_[2]) ^ e') • a + ((2 : ℤ_[2]) ^ e) • a',
      add_mem (Subalgebra.smul_mem _ ha _) (Subalgebra.smul_mem _ ha' _), ?_⟩
    rw [smul_add, pow_add, mul_comm, mul_smul, hα, mul_comm, mul_smul, hβ, LinearMap.baseChange_add,
      baseChange_smul_end, baseChange_smul_end, map_pow, map_pow]
  · rintro α β - - ⟨e, a, ha, hα⟩ ⟨e', a', ha', hβ⟩
    refine ⟨e + e', a * a', mul_mem ha ha', ?_⟩
    rw [baseChange_mul_end, ← hα, ← hβ, pow_add, smul_mul_smul_comm]

