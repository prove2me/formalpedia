set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open Synth AModel AModelL12

/-- The schedule run backwards. -/
def runArrR {α : Type*} (n : ℕ) (d : α) (ops : List LOp) (xs : List α) : List α :=
  ops.reverse.foldl (fun acc o => pull (binSh n) (binSh n) (permIdx o.idx) d acc) xs

end NLogN.KFV

end

section
-- Source module: Solutions.KFV38LayOut1
/-!
# KFV §41: phase 1 of the layout, backwards, as a fixed IL loop

Iteration `j < D` (`k = D-1-j`): the registers `gI = k+1`, `gRk = rank(k+1)` are
first decremented (`gI ← gI - 1`, `gRk ← gRk - flag`), then the inverse move `mvF` puts the bit at
position `rank` back to `rank + flag·k(ℓ-1)`. **`ph1R_ok`**: the loop computes
`runArrR n 0 (ops1 …)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The code -/

def dn1 : RS := .seq (.asg NLogN.KFV.gI (.add (.reg NLogN.KFV.gI) (.lit (-1)))) (.asg gRk (.add (.reg gRk) (.neg eFl)))

def body1R : IStmt HS Pp := .seq (fcode dn1) (NLogN.KFV.mvF eA1 eF1 (eCm eA1 eF1))

def ph1R : IStmt HS Pp :=
  .seq (fcode (.seq (.push NLogN.KFV.gI (.reg NLogN.KFV.gD)) (.push gRk (.reg gNL))))
    (.seq (KFT.rptX NLogN.KFV.gD fA NLogN.KFV.fC fD body1R) (fcode (.seq (.pop gRk) (.pop NLogN.KFV.gI))))

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- Cost of the backward iteration `j`. -/
noncomputable def cBody1R (n W B : ℕ) (j : ℕ) : ℕ :=
