    (htwo : (g : ZMod n) ^ ((n - 1) / 2) ≠ 1)
    (hprime : (g : ZMod n) ^ ((n - 1) / p) ≠ 1) :
    n.Prime := by
  apply lucas_primality n (g : ZMod n) hfull
