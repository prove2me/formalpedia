theorem Wikipedia.SzemeredisTheorem.biUnion_cfzCanonicalCarryCell_eq_natBox
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    {k N : ℕ} [NeZero N]
    (forms : κ → CFZFormIndex k) :
    (cfzCanonicalCarryVectorChoices κ k).biUnion
        (cfzCanonicalCarryCell (N := N) forms) =
      natBox (fun _ : CFZVariable k => N) := by sorry
