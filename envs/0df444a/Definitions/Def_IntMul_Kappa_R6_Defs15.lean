-- Source module: Solutions.R6MQ
/-!
# Round-six machine: the run-time parameters of one size

`Q6` bundles the parameter record `P`, the input size `n` and the source list `src` (chosen by
the setup). All parameters of the machine are functions of `Q : Q6` (`Q.b = b'`, `Q.p = 6b'`,
`Q.L`, `Q.d`, `Q.ℓ`, `Q.h = ℓ − 1`, `Q.α`, `Q.K`, `Q.r`, the boxes `Q.sB D`, `Q.tB D`, `S`, `M`,
the error allowance `Q.er = errW6` and the source-transform error `Q.Es`).

`QOk Q` collects the numerical facts the assembly uses (proved for large `n` in `R6MFacts`).

* `prod_tB`, `tB_last`, `tBox_eq6`, `crtOK6`: the boxes.
* `regIdx6`, `BaseOK6.of_agree`, `BaseOK6.upd`: the register file is kept by writes elsewhere.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IntMul.OpenAI.RT AModel

noncomputable section

/-- The run-time data of one size. -/
structure Q6 where
  P : Prm
  n : ℕ
  src : ℕ → ℕ

namespace Q6

variable (Q : Q6)

abbrev b : ℕ := b'P6 Q.P Q.n
abbrev p : ℕ := pP6 Q.P Q.n
abbrev L : ℕ := LP6 Q.P Q.n
abbrev T : ℕ := TP6 Q.P Q.n
abbrev d : ℕ := dP6 Q.P Q.n
abbrev ℓ : ℕ := ℓP6 Q.P Q.n
abbrev h : ℕ := hN6 Q.P Q.n
abbrev α : ℕ := αN6 Q.P Q.n
abbrev K : ℕ := KP6 Q.P Q.n

abbrev bL : ℕ → Bool := bL6 Q.P Q.n

abbrev S : ℕ := S6 Q.P Q.n Q.src
abbrev M : ℕ := M6 Q.P Q.n
/-- The digit scale `e = p − b − 2`. -/
abbrev e : ℕ := Q.p - Q.b - 2
/-- `γ = 2 d α²`. -/
abbrev γ : ℕ := 2 * Q.d * Q.α ^ 2
/-- The error allowance of every interface. -/
abbrev er : ℝ := errW6 Q.P Q.n
/-- The error constant of one source transform `2^γ (εA + (Er + 22) + εB)`. -/
abbrev Es : ℝ := (2 : ℝ) ^ Q.γ * (Q.er + (Q.er + 22) + Q.er)

end Q6

/-- **The numerical facts** the assembly uses about one size. -/
structure QOk (Q : Q6) : Prop where
  src : SrcOK6 Q.P Q.n Q.src
  hb : 64 ≤ Q.b
  hd1 : 1 ≤ Q.d
  hℓ2 : 2 ≤ Q.ℓ
  hn3 : 3 ≤ Q.n
  hLb : Q.L + 2 ≤ Q.b
  hlt : ∀ j < Q.d, Q.src j < tF6 Q.P Q.n j
  hMS : 2 * Q.M ≤ Q.S
  hεA : Q.er * hp Q.p ≤ 1 / 10
  hEs : Q.Es * hp Q.p ≤ 1 / 100
  hB2 : 2 * (2 : ℝ) ^ (2 * Q.b + 4) * (Q.S : ℝ) ^ 2 * (3 * Q.Es + 2) * hp Q.p < 1
  hγ : Q.γ + 4 ≤ Q.b
  hdb : Q.d + 4 ≤ Q.b
  hKb : Q.K ≤ Q.b
  hb6 : Q.b ^ 6 ≤ Q.T

namespace QOk

variable {Q : Q6} (hQ : QOk Q)
include hQ

end QOk

/-! ## The register file -/

end

end IntMul.Kappa.R6

end

