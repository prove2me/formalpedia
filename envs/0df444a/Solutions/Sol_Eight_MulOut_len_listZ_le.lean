open Eight
open Groundwork PaddedDescent.F Finset Polynomial
namespace Eight
namespace MulOut
theorem _root_.solution (b : ℕ) : ∀ l : List ℤ, (∀ z ∈ l, len z ≤ b) → len l ≤ l.length * (b + 2) + 2
  | [], _ => by simp [len_nil]
  | z :: l, h => by
    have h1 := solution b l fun w hw => h w (List.mem_cons_of_mem _ hw)
    have h2 := h z List.mem_cons_self
    rw [len_cons, List.length_cons, Nat.succ_mul]
    omega
end MulOut
end Eight
