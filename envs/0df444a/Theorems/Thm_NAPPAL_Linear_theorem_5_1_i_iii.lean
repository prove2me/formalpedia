-- title:
--   Theorem 5.1(i)–(iii), p. 19 — under VP-EB the iterates stay near w̄, have finite length and converge to the stationary point w̄
-- statement:
--   Let Assumptions 1 and 2 hold, let $\delta_k$ be set by rule (8), and let $w^k=(u^k,v^k,p^k)$ be generated by NAPP-AL (the assumptions of Theorem 4.1). Let $\bar w$ be an accumulation point of $\{w^k\}$ such that $\Lambda^k\to\Lambda^*=\mathcal L_\gamma(\bar w)$, and assume VP-EB holds at $\bar w$ with constants $\kappa_1>0$, $\eta>0$, $\nu>0$. Then:
--   1. there is $k_0$ such that $\|w^k-\bar w\|<\eta$ and $\mathcal L_\gamma(w^k)<\Lambda^*+\nu$ for all $k\ge k_0$;
--   2. the iterates have finite length:
--   $$\sum_{k=0}^\infty\|w^k-w^{k+1}\|<+\infty;$$
--   3. $w^k\to\bar w$, and $\bar w$ is a stationary point of (P), i.e. $0\in\partial\mathcal L_\gamma(\bar w)$.
--
--   These are the first three conclusions of the linear-convergence theorem; the rate statements of Theorem 5.1(iv) rest on them.
--
--   **Formalization Note.** "$\mathcal L_\gamma(\bar w)=\Lambda^*$", where $\Lambda^*=\lim\Lambda^k$ (Theorem 4.1(i)), is encoded as the hypothesis $\Lambda^k\to\mathcal L_\gamma(\bar w)$; Theorem 4.1 makes it automatic, but the page prints it. Norms of triples are Euclidean (`wdist`); the ball is open and the level condition strict. Finite length is `Summable` of the nonnegative distances. VP-EB does not presuppose convergence (Definition 5.1 does; Theorem 5.1 proves it).
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 19, Theorem 5.1(i)–(iii)

import Mathlib
import Definitions.Def_NAPPAL_KL_Setting

namespace NAPPAL.Linear


theorem theorem_5_1_i_iii {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ) (LK : ℝ)
    (K : NAPPAL.KL.E n → ℝ) (β γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : NAPPAL.KL.RunHyp P LG LH L0 LOmj LK K β γ σ δ ε u v p)
    (wbar : NAPPAL.KL.W n d m) (hcl : MapClusterPt wbar Filter.atTop (NAPPAL.KL.wseq u v p))
    (hΛ : Filter.Tendsto (NAPPAL.KL.Lam P LG LH L0 γ u v p) Filter.atTop (nhds (NAPPAL.KL.augLag P γ wbar)))
    (κ1 η ν : ℝ) (hvp : NAPPAL.KL.VPEB P γ (NAPPAL.KL.wseq u v p) wbar κ1 η ν) :
    (∃ k0 : ℕ, ∀ k ≥ k0,
        NAPPAL.KL.wdist (NAPPAL.KL.wseq u v p k) wbar < η ∧ NAPPAL.KL.augLag P γ (NAPPAL.KL.wseq u v p k) < NAPPAL.KL.augLag P γ wbar + ν) ∧
    Summable (fun k => NAPPAL.KL.wdist (NAPPAL.KL.wseq u v p k) (NAPPAL.KL.wseq u v p (k + 1))) ∧
    (Filter.Tendsto (NAPPAL.KL.wseq u v p) Filter.atTop (nhds wbar) ∧ NAPPAL.KL.IsStationary P γ wbar) := by sorry

end NAPPAL.Linear
