    have hc' : φ' (chih.rangeRestrict (CuspForm.heckeAlgebra.T hℓ hℓM' hℓS')) =
        (χ (ZMod.unitOfCoprime ℓ hℓm) : K) *
          ((algebraMap O' K).comp iota) (chig.rangeRestrict (CuspForm.heckeAlgebra.T hℓ hℓM hℓS)) := by
      rw [hc, ← mul_assoc, ← Units.val_mul, hχ2, Units.val_one, one_mul]
    rw [RingHom.comp_apply, hres ℓ hℓ hℓM' hℓS₁ hℓS', hc', RingHom.comp_apply, RingHom.comp_apply]
  obtain ⟨iota₁, hiota₁⟩ := CuspForm.PSQ.exists_iota_of_generators_mem_range hinjK hM'S₁ chih₁ ψ
    (fun ℓ hℓ hℓM' hℓS₁ => by
      rw [hψT ℓ hℓ hℓM' hℓS₁]
      exact Subring.mul_mem _ (hχval _) ⟨_, rfl⟩)

