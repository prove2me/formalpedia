      have hav := le_of_OK a hok.1
      refine ⟨⟨oa, ob⟩, ⟨ba, bb, ?_⟩, ?_⟩
      · simp only [Ex.eval, ea, eb]
        rw [show (a.val v : ℤ) + -(b.val v : ℤ) = ((a.val v - b.val v : ℕ) : ℤ) by
          push_cast [Nat.cast_sub hle]; ring]
