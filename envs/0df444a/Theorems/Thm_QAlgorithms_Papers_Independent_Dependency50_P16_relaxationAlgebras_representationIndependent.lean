-- title:
--   Lemma C.6: Representation independence of relaxation algebras
-- statement:
--   Let two general CP-generator representations $(K,V_1,\ldots,V_r)$ and $(K',W_1,\ldots,W_s)$ define the same linear map on $M_n(\mathbb C)$, $n\ge2$. Then
--
--   $$\operatorname{alg}_{\mathbb C}(I,V_1,\ldots,V_r)=\operatorname{alg}_{\mathbb C}(I,W_1,\ldots,W_s),$$
--
--   and their extended algebras, additionally generated by $K$ and $K'$ respectively, are equal. This is representation independence for both unital associative algebras, without trace preservation.
-- source:
--   Reachability, Coolability, and Stabilizability of Open Markovian Quantum Systems with Fast Unitary Control, arXiv:2308.00561v1, PDF p. 31, Lemma C.6: Representation independence of relaxation algebras

import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P16

noncomputable section

open scoped BigOperators Matrix ComplexConjugate ENNReal NNReal Matrix.Norms.L2Operator

open MeasureTheory Filter

attribute [local instance] Classical.propDecidable Classical.decEq

attribute [local instance 100] LieRing.ofAssociativeRing

namespace QAlgorithms.Papers.Independent.Dependency50.P16

local notation "Mat" => fun n : ℕ => Matrix (Fin n) (Fin n) ℂ

local notation "Vec" => fun n : ℕ => Fin n → ℝ

local notation "Hilbert" => fun n : ℕ => EuclideanSpace ℂ (Fin n)

local notation "Operator" => fun n : ℕ => Module.End ℂ (Mat n)

/-- arXiv:2308.00561v1, PDF p.31, Lemma C.6: Representation independence of relaxation algebras. Identity is included by Algebra.adjoin. Equality of actual generators replaces any appeal to the erroneous unrestricted coisometry clause of C.3. -/
theorem relaxationAlgebras_representationIndependent {n r s : ℕ} (hn : 2 ≤ n)
    (K Knew : Mat n) (V : Fin r → Mat n) (W : Fin s → Mat n)
    (h : cpGenerator K V = cpGenerator Knew W) :
    relaxationAlgebra V = relaxationAlgebra W ∧ extendedAlgebra K V = extendedAlgebra Knew W := by sorry

end QAlgorithms.Papers.Independent.Dependency50.P16

