theorem skS_upd_other (G : Fin HS → List ℤ) (C CU OP ARG ACC : List ℤ) {j : Fin HS}
    (h1 : j ≠ rC) (h2 : j ≠ rCU) (h3 : j ≠ rOP) (h4 : j ≠ rARG) (h5 : j ≠ rACC) (w : List ℤ) :
    update (skS G C CU OP ARG ACC) j w = skS (update G j w) C CU OP ARG ACC := by
  funext x; simp only [skS, update_apply]; split_ifs <;> simp_all

section pass
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

/-- Moving the collected output onto stack `0`. -/
theorem outLoop_runs_sol_aux (s : IState HS) (G : Fin HS → List ℤ) (hA : G lA = []) (hC : G lC = [])
    (hD : G lD = []) (C CU OP ARG : List ℤ) (o : List ℤ) {LT : List ℤ}
    (hT : G rTOT = (o.length : ℤ) :: LT) {Bo : ℕ} (hBo : ∀ y ∈ o, zsz y ≤ Bo) :
    IRuns I iprog (rptX rTOT lA lC lD (.op (.mv rACC 0)))
      (encK s (skS G C CU OP ARG o.reverse))
      (encK s (skS (update G 0 (o ++ G 0)) C CU OP ARG []))
      ((o.length + 1) * (2 * moveCost Bo + 19 + 3000)) := by
  have h0 : ∀ v : List ℤ, ∀ k, (update G 0 v) k = G k ∨ k = 0 := by
    intro v k; by_cases hk : k = 0
    · right; exact hk
    · left; simp [hk]
  have Hl := rptXU_runs (I := I) (iprog := iprog) (X := rTOT) (by decide) o.length
    (fun k => encK s (skS (update G 0 (o.drop (o.length - k) ++ G 0)) C CU OP ARG
      (o.take (o.length - k)).reverse))
    (fun k => by simp (config := { decide := true }) [update_apply, hA])
    (fun k => by simp (config := { decide := true }) [update_apply, hC])
    (fun k => by simp (config := { decide := true }) [update_apply, hD])
    (.op (.mv rACC 0)) (2 * moveCost Bo + 19) ?_ (ints LT ++ s.G rTOT) ?_
  · simpa using Hl
  · intro k hk LA LC LD
    have cA : ∀ v : List ℤ, ∀ A, skS (update G 0 v) C CU OP ARG A lA = [] := by
      intro v A; rw [skS_lA, update_of_ne (by decide)]; exact hA
    have cC : ∀ v : List ℤ, ∀ A, skS (update G 0 v) C CU OP ARG A lC = [] := by
      intro v A; rw [skS_lC, update_of_ne (by decide)]; exact hC
    have cD : ∀ v : List ℤ, ∀ A, skS (update G 0 v) C CU OP ARG A lD = [] := by
      intro v A; rw [skS_lD, update_of_ne (by decide)]; exact hD
    rw [cf3_encK s _ (cA _ _) (cC _ _) (cD _ _), cf3_encK s _ (cA _ _) (cC _ _) (cD _ _)]
    obtain ⟨j, hj⟩ : ∃ j, o.length - k = j + 1 := ⟨o.length - k - 1, by omega⟩
    have hjl : j < o.length := by omega
    have e1 : o.length - (k + 1) = j := by omega
    have e : o.drop j = o[j] :: o.drop (j + 1) := List.drop_eq_getElem_cons hjl
    have et : o.take (j + 1) = o.take j ++ [o[j]] := List.take_succ_eq_append_getElem hjl
    simp only [hj, e1, e, et, List.reverse_append, List.reverse_cons, List.reverse_nil,
      List.nil_append, List.singleton_append]
    have h := mvM (I := I) (iprog := iprog) (cf3 s lA lC lD LA LC LD)
      (skS (update G 0 (o.drop (j + 1) ++ G 0)) C CU OP ARG (o[j] :: (o.take j).reverse))
      (i := rACC) (j := 0) (by decide) (skS_ACC _ _ _ _ _ _)
    rw [skS_upd_ACC, skS_upd_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
      (by decide), skS_ne _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      update_self, update_idem] at h
    refine h.mono' (by rw [List.cons_append]) ?_
    have := moveCost_mono (hBo _ (List.getElem_mem hjl))
    omega
  · simp (config := { decide := true }) [ints, update_apply, hT]

end pass

