section ExpR

private def expR (t : ℝ) : ℝˣ := Units.mk0 (Real.exp t) (Real.exp_ne_zero t)

@[scoped simp] private theorem coe_expR (t : ℝ) : (expR t : ℝ) = Real.exp t := rfl

private theorem expR_zero : expR 0 = 1 := Units.ext (by simp)

private theorem expR_add (s t : ℝ) : expR (s + t) = expR s * expR t := Units.ext (by simp [Real.exp_add])

private theorem expR_neg (t : ℝ) : expR (-t) = (expR t)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← expR_add, neg_add_cancel, expR_zero]

private theorem continuous_expR : Continuous expR :=
  Units.continuous_iff.2 ⟨Real.continuous_exp,
    (Real.continuous_exp.comp continuous_neg).congr fun t => Real.exp_neg t⟩

end ExpR
