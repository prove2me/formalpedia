theorem Formalism.L2.Th1.C.JetSubstitutionLemmas.jet_sub {l linv : PowerSeries K} (h : IsLogPair l linv) (f g : PowerSeries K) (i : ℕ) :
    jet l (f - g) i = jet l f i - jet l g i := by sorry
