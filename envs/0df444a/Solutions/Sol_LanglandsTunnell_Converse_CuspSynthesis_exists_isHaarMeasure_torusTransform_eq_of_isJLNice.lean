p2m_open "LanglandsTunnell.Converse.Ideles P2MW.S_LanglandsTunnell_Converse_CuspSynthesis_exists_isHaarMeasure_torusTransform_eq_of_isJLNice.LanglandsTunnell.Converse.Ideles"

variable {K : Type} [Field K] [NumberField K]

private def d017 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ where
  toFun z := ∏ v : ↥S, epsS v.1 (unitAt v.1 z)
  map_one' := Finset.prod_eq_one fun v _ => by rw [unitAt_one, map_one]
  map_mul' a b := by
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun v _ => by rw [unitAt_mul, map_mul]

private theorem t0248 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) (z : (AdeleRing (𝓞 K) K)ˣ) :
    d017 S epsS z = ∏ v : ↥S, epsS v.1 (unitAt v.1 z) := rfl

private theorem t0249 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) (z : (AdeleRing (𝓞 K) K)ˣ) :
    ((d017 S epsS z : ℂˣ) : ℂ) = ∏ v : ↥S, ((epsS v.1 (unitAt v.1 z) : ℂˣ) : ℂ) := by
  rw [t0248, Units.coe_prod]

private theorem t0250 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) (β : Kˣ) :
    ((d017 S epsS (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β) : ℂˣ) : ℂ) =
      ∏ v : ↥S, ((epsS v.1 (localOf K v.1 β) : ℂˣ) : ℂ) := by
  rw [t0249]
  exact Finset.prod_congr rfl fun v _ => by rw [t0225]

private theorem t0251 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) {z : (AdeleRing (𝓞 K) K)ˣ}
    (hz : ∀ v ∈ S, ((z : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1) : d017 S epsS z = 1 := by
  rw [t0248]
  refine Finset.prod_eq_one fun v _ => ?_
  have h1 : unitAt v.1 z = 1 := Units.ext (hz v.1 v.2)
  rw [h1, map_one]

private theorem t0252 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) {v : HeightOneSpectrum (𝓞 K)}
    (hv : v ∈ S) (t : (v.adicCompletion K)ˣ) : d017 S epsS (d004 v t) = epsS v t := by
  rw [t0248, Finset.prod_eq_single ⟨v, hv⟩]
  · have h1 : unitAt v (d004 v t) = t := Units.ext (t0034 v t)
    show epsS v (unitAt v (d004 v t)) = epsS v t
    rw [h1]
  · intro w _ hw
    have hwv : w.1 ≠ v := fun h => hw (Subtype.ext h)
    have h1 : unitAt w.1 (d004 v t) = 1 := Units.ext (t0035 v t hwv)
    rw [h1, map_one]
  · intro h; exact absurd (Finset.mem_univ _) h

private theorem t0253 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) {v : HeightOneSpectrum (𝓞 K)}
    (hv : v ∉ S) (t : (v.adicCompletion K)ˣ) : d017 S epsS (d004 v t) = 1 :=
  t0251 S epsS fun _ hw => t0035 v t fun h => hv (h ▸ hw)

private theorem t0254 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) :
    (∀ v ∈ S, ∀ u : (v.adicCompletion K)ˣ, Valued.v (u : v.adicCompletion K) = 1 →
        localChar χ v u * epsS v u = 1) ∨
      ∃ v ∈ S, ∃ u : (v.adicCompletion K)ˣ, Valued.v (u : v.adicCompletion K) = 1 ∧
        χ (d004 v u) * d017 S epsS (d004 v u) ≠ 1 := by
  by_cases h : ∀ v ∈ S, ∀ u : (v.adicCompletion K)ˣ, Valued.v (u : v.adicCompletion K) = 1 →
      localChar χ v u * epsS v u = 1
  · exact Or.inl h
  · refine Or.inr ?_
    by_contra hcon
    refine h fun v hv u hu => ?_
    by_contra hne
    refine hcon ⟨v, hv, u, hu, ?_⟩
    rw [t0252 S epsS hv, ← t0030]
    exact hne

variable (K) in

private def d018 (S : Finset (HeightOneSpectrum (𝓞 K))) (z : (AdeleRing (𝓞 K) K)ˣ) :
    (AdeleRing (𝓞 K) K)ˣ :=
  ∏ v : ↥S, d004 v.1 (unitAt v.1 z)

variable (K) in

private def stripS (S : Finset (HeightOneSpectrum (𝓞 K))) (z : (AdeleRing (𝓞 K) K)ˣ) :
    (AdeleRing (𝓞 K) K)ˣ :=
  z * (d018 K S z)⁻¹

private theorem t0255 (S : Finset (HeightOneSpectrum (𝓞 K))) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (z : (AdeleRing (𝓞 K) K)ˣ) : χ (d018 K S z) = ∏ v : ↥S, localChar χ v.1 (unitAt v.1 z) := by
  rw [d018, map_prod]
  exact Finset.prod_congr rfl fun v _ => (t0030 χ v.1 (unitAt v.1 z)).symm

private theorem t0256 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hχ : IsIdeleClassChar (𝓞 K) K χ) (α : Kˣ) :
    (∏ v : ↥S, localChar χ v.1 (localOf K v.1 α)) =
      (χ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) α)))⁻¹ := by
  have h1 : χ (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) α) = 1 := hχ α
  rw [stripS, map_mul, map_inv, h1, one_mul, inv_inv, t0255]
  exact Finset.prod_congr rfl fun v _ => by rw [t0225]

private theorem t0257 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hχ : IsIdeleClassChar (𝓞 K) K χ) (α : Kˣ) :
    (∏ v : ↥S, ((localChar χ v.1 (localOf K v.1 α) : ℂˣ) : ℂ)) =
      ((χ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) α)) : ℂˣ)
        : ℂ)⁻¹ := by
  rw [← Units.coe_prod, t0256 S hχ α, Units.val_inv_eq_inv_val]

end SOrderCharacters
