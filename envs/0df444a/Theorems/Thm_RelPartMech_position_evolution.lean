-- title:
--   Hamilton's equation for position: $m g_{\alpha\beta}\, d_s x^\beta = \Pi_\alpha$
-- statement:
--   Let $H=\frac1{2m}\Pi_\alpha g^{\alpha\beta}\Pi_\beta$ with $\Pi_\alpha=p_\alpha-eA_\alpha(x)$, a smooth metric $g$ and smooth potential $A$, and mass $m\neq0$. Then the evolution of the position along the affine parameter $s$ generated by $H$ is
--
--   $$
--   d_s x^\alpha = \{x^\alpha,H\} = \frac1m\, g^{\alpha\beta}\Pi_\beta ,
--   $$
--
--   equivalently $m\,g_{\alpha\beta}\,d_s x^\beta = \Pi_\alpha$: the metric is the linear relation between kinetic momentum and velocity.
-- source:
--   G. Carcassi, C. A. Aidala, "Relativity and Particle Mechanics" (note, uploaded PDF), p. 4, eq. (9), first two lines

import Mathlib
import Definitions.Def_RelPartMech_coordinates

open scoped ContDiff

namespace RelPartMech

theorem position_evolution {n : ℕ} (g : MetricField n) (hg : IsSmoothMetric g)
    (A : CovectorField n) (hA : ∀ α, ContDiff ℝ ∞ (A α)) (e m : ℝ) (hm : m ≠ 0)
    (α : Fin n) (x p : Coord n) :
    poisson (posFn α) (hamiltonian g A e m) x p =
      (1 / m) * ∑ β, ginv g x α β * kineticMomentum A e β x p := by sorry

end RelPartMech
