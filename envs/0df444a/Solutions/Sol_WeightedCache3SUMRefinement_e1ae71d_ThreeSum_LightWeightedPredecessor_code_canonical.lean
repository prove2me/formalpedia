namespace WeightedCache3SUMRefinement_e1ae71d.ThreeSum.LightWeightedPredecessor
theorem _root_.solution {N : ℕ} (w : TritWord N) (i : Fin N) (hi : 0<(w i).val) :
    code N (low i) (high i) (address w)=address (predecessor w i) := by
  have hd := digit_eq w i
  have h2 := (w i).isLt
  unfold code digit
  rw [hd]
  by_cases h1 : (w i).val=1
  · rw [if_pos h1,zeroCode_eq_update]
    apply congrArg address
    funext j
    unfold predecessor
    simp only [Function.update_apply]
    split_ifs
    · apply Fin.ext
      simp [predDigit,h1]
    · rfl
  · have htwo : (w i).val=2 := by omega
    rw [if_neg h1,oneCode_eq_update_of_pos w i hi]
    apply congrArg address
    funext j
    unfold predecessor
    simp only [Function.update_apply]
    split_ifs
    · apply Fin.ext
      simp [predDigit,htwo]
    · rfl
end WeightedCache3SUMRefinement_e1ae71d.ThreeSum.LightWeightedPredecessor
