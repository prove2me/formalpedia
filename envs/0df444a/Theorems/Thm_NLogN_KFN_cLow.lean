variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

theorem NLogN.KFN.cLow (hGc : GClass J A) (hrow : RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hsW : W ≤ s) (hm : 1 ≤ m) (hr : 1 ≤ r) (hΨm : Monotone Ψ)
    (hZΨ : ∀ v, Z + 2 ≤ Ψ v) (k D' : ℕ) (hD' : D' < m ^ (k + 1)) (pos : Fin D' → ℕ)
    (hinj : Function.Injective pos) (t S0 B : ℕ) (hpos : ∀ i, pos i < t) (haff : AffK K t pos)
    (hS : 1 ≤ S0)
    (hB : 1 ≤ B) (hdvd : W ^ k ∣ B) (hZ : zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z) :
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      SImplI Isym iprog r (fun i => 2 ^ pos i * S0) (B * 2 ^ t * S0) (Butterfly.tens Cm : Butterfly.Op (Fin D'))
        code e dw cost ∧
      e ≤ (k + 1) * m * Eb J.net.length s k ∧ dw ≤ (k + 1) * m * DWb J.net.length s W A k ∧
      ∀ w, (cost w : ℝ) ≤ ((((k + 1) * m : ℕ) : ℝ) * cb J.net.length s W A m CR τ k + 1) *
        ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        (Xf r Ψ (w + (k + 1) * m * DWb J.net.length s W A k + Whb J.net.length s W A k) : ℝ) := by sorry
