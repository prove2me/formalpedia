    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | mark =>
    rename_i i
    have := IOp.Step.mark (I := I) (s := IState.embed f s t) (i := f i)
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
