open Module IsDiscreteValuationRing
open GlobalTheory
variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {M : Type*} [AddCommGroup M] [Module R M]

theorem GlobalTheory.length_quotient_range_ne_top_iff [Module.Free R M] [Module.Finite R M]
    {f : M →ₗ[R] M} :
    Module.length R (M ⧸ LinearMap.range f) ≠ ⊤ ↔ LinearMap.det f ≠ 0 := by sorry
