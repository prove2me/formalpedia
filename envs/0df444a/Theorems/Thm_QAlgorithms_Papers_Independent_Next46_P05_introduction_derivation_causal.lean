-- title:
--   Introduction-derivation-causal: abelian extreme spans and the causal Lie subalgebra
-- statement:
--   All Lie algebras below are real and finite-dimensional, with their usual Hausdorff vector-space topology; brackets of subspaces denote real linear spans. Let $W$ be pointed, generating, invariant, closed and convex. Let $\tau$ be an involutive Lie automorphism with $\tau W=-W$. Let $D$ be a real linear derivation commuting with $\tau$ and satisfying $\exp(tD)W\subseteq W$ for every real $t$. Set $C_\pm=(\pm W)\cap\{x:\tau x=-x,Dx=\pm x\}$ and $\mathfrak g_\pm=\operatorname{span}_{\mathbb R}C_\pm$. Then both $\mathfrak g_\pm$ are abelian and
--
--   $$\mathfrak g(W,\tau,D)=\mathfrak g_-\oplus[\mathfrak g_-,\mathfrak g_+]\oplus\mathfrak g_+$$
--
--   is a Lie subalgebra, equal to the Lie algebra generated by the two cones. The displayed sum is internally independent; $D$ need not be an inner derivation. This is a structural statement used in the paper's classification of causal subalgebras.
-- source:
--   Classification of 3-graded causal subalgebras of real simple Lie algebras, arXiv:2001.03125v2, PDF p. 1, Introduction-derivation-causal

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P05

namespace QAlgorithms.Papers.Independent.Next46.P05

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Frontier30.P26
  (bracketSpan innerWord Invariant ClosedCone GeneratingInvariantCone CompactlyEmbedded)

open scoped BigOperators

attribute [local instance] Classical.propDecidable Classical.decEq

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Next46.P05.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Next46.P05.lieNormedSpace

section LieStatements

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- The unnumbered derivation assertion accompanying (1), PDF p. 1.
D is an actual derivation, commutes with tau, and exp(RD) preserves W. -/
theorem introduction_derivation_causal (W : Set G) (hw : GeneratingInvariantCone W)
    (tau : G ≃ₗ⁅ℝ⁆ G) (ht : Function.Involutive tau)
    (hr : tau '' W = Neg.neg '' W) (D : G →ₗ[ℝ] G)
    (hd : ∀ x y, D ⁅x, y⁆ = ⁅D x, y⁆ + ⁅x, D y⁆)
    (hc : ∀ x, D (tau x) = tau (D x))
    (he : ∀ t : ℝ, expEnd (t • D) '' W ⊆ W) :
    let M := Submodule.span ℝ (derivationSlice W tau D (-1))
    let P := Submodule.span ℝ (derivationSlice W tau D 1)
    (∀ x ∈ M, ∀ y ∈ M, ⁅x, y⁆ = 0) ∧
    (∀ x ∈ P, ∀ y ∈ P, ⁅x, y⁆ = 0) ∧
    ∃ S : LieSubalgebra ℝ G, DirectThree S.toSubmodule M (bracketSpan M P) P ∧
      S = LieSubalgebra.lieSpan ℝ G
        (derivationSlice W tau D (-1) ∪ derivationSlice W tau D 1) := by sorry

end LieStatements

end

end QAlgorithms.Papers.Independent.Next46.P05
