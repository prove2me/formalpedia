-- Source module: Solutions.KFMSetC
/-!
# KFM SetC: the cost of the parameter pushes

* `pushSeq`, **`pushSeq_cost`**: a chain of pushes costs `Σ (size+1) · 10^7 (B+2)^2 + 1` when every
  expression is `B`-bounded at its state (`PBnd`).
* **`parQ_cost`**: `parQ` costs `O(b^2)`.
* **`parS_cost`**: `parS` costs `O(d · b^2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue RS

/-! ## Chains of pushes -/

/-- A chain of pushes. -/
def pushSeq : List (Fin HS × Ex HS) → RS
  | [] => .skip
  | [(r, e)] => .push r e
  | (r, e) :: l => .seq (.push r e) (pushSeq l)

/-- Every expression is `B`-bounded at its state. -/
def PBnd (B : ℕ) : List (Fin HS × Ex HS) → IState HS → Prop
  | [], _ => True
  | (r, e) :: l, t => e.Bnd t B ∧ PBnd B l (t.upd r (.int (e.eval t) :: t.G r))

/-! ## `parQ` -/

/-- The pushes of `parQ`. -/
def Lq : List (Fin HS × Ex HS) :=
  [(NLogN.KFM.rT, .pow2 (.reg NLogN.KFM.zL)), (rT2, .pow2 (.add (.reg NLogN.KFM.zL) (.lit 1))),
   (NLogN.KFM.rM, .ndiv (.add (.reg NLogN.KFM.zN) (.add (.reg NLogN.KFM.zB) (.lit (-1)))) (.reg NLogN.KFM.zB)),
   (rP2, .pow2 (.mul (.lit 6) (.reg NLogN.KFM.zB))),
   (rG, .pow2 (.mul (.mul (.lit 2) (.reg zD)) (.mul (.reg zAl) (.reg zAl)))),
   (rE2, .pow2 (.add (.mul (.lit 5) (.reg NLogN.KFM.zB)) (.lit (-2)))),
   (rB2, .pow2 (.reg NLogN.KFM.zB)),
   (rZ, .mul (.lit 2) (.add (.reg NLogN.KFM.rS) (.neg (.reg NLogN.KFM.rM)))),
   (NLogN.KFM.rH, .pow2 (.add (.mul (.lit 6) (.reg NLogN.KFM.zB)) (.lit (-1)))),
   (rF, .pow2 (.add (.mul (.lit 2) (.reg NLogN.KFM.zB)) (.lit 4))),
   (rPw, .add (.mul (.lit 6) (.reg NLogN.KFM.zB)) (.lit 2)),
   (rOne, .lit 1)]

/-! ## `parS` -/

/-! ## The whole setup -/

end NLogN.KFM

