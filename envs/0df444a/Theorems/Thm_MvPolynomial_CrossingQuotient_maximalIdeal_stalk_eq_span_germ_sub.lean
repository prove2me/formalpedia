-- title:
--   Stalk maximal ideal at a crossing section point is principal
-- statement:
--   Let $W$ be a commutative ring that is an integral domain, and let $t,x',y'\in W$ satisfy $x'y'=t$ and $x'\neq 0$. Put $Q=\mathrm{CrossingQuotient}\,W\,t$, the quotient of the polynomial ring $W[X_0,X_1]$ (i.e. `MvPolynomial (Fin 2) W`) by the principal ideal generated by $X_0X_1-t$, and let $M=\operatorname{Spec} Q$ as a scheme, with $\varphi\colon Q\to\Gamma(M,\top)$ the inverse of the canonical isomorphism `Scheme.ΓSpecIso` identifying $Q$ with the global sections of $M$. Let $L\colon Q\to W$ be the ring homomorphism underlying the $W$-algebra map $\mathrm{CrossingQuotient.lift}\,x'\,y'$, available because $x'y'$ equals the image of $t$ under the identity structure map of $W$; thus $L$ is induced by evaluating $X_0\mapsto x'$, $X_1\mapsto y'$. Then, for any proof that the kernel $\ker L$ is a prime ideal of $Q$, writing $m\in M$ for the corresponding point of $\operatorname{Spec} Q$, the maximal ideal of the local ring $\mathcal{O}_{M,m}$ (the stalk of the structure sheaf of $M$ at $m$) is the ideal generated by the single element obtained as the germ at $m$ of the global section $\varphi\bigl(\mathrm{CrossingQuotient.U}\,t-x'\bigr)$, where $x'$ is read in $Q$ via the structure map $W\to Q$ and `CrossingQuotient.U t` is the distinguished element of $Q$ attached to $t$.
--
--   This is the elementary local computation on the affine crossing model $\operatorname{Spec} W[u,v]/(uv-t)$ showing that at the point cut out by the section $(u,v)=(x',y')$, with $x'$ invertible in the local ring, the maximal ideal is principal with generator $u-x'$, so that this function is a local parameter there. It is used in the construction of charts on integral models of modular curves, being cited in the comparison of pullbacks along such models with ideal modules for $X_1$-type and Deligne–Rapoport-type models at a prime.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPolynomial_CrossingQuotient_maximalIdeal_stalk_eq_span_germ_sub.lean

import Mathlib
import Definitions.Def_MvPolynomial_CrossingResolutionScheme

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open CategoryTheory AlgebraicGeometry MvPolynomial

theorem MvPolynomial.CrossingQuotient.maximalIdeal_stalk_eq_span_germ_sub
    (W : Type u) [CommRing W] [IsDomain W] (t x' y' : W) (hxy : x' * y' = t) (hx : x' ≠ 0) :
    letI Q := CrossingQuotient W t
    letI M : Scheme.{u} := Spec (CommRingCat.of Q)
    letI φ : Q →+* Γ(M, ⊤) := (Scheme.ΓSpecIso (CommRingCat.of Q)).inv.hom
    letI L : Q →+* W := (CrossingQuotient.lift (t := t) x' y' (by rw [Algebra.algebraMap_self, RingHom.id_apply, hxy])).toRingHom
    ∀ (hprime : (RingHom.ker L).IsPrime),
    letI m : M := (⟨RingHom.ker L, hprime⟩ : PrimeSpectrum Q)
    IsLocalRing.maximalIdeal (M.presheaf.stalk m) =
      Ideal.span {M.presheaf.germ ⊤ m trivial (φ (CrossingQuotient.U t - algebraMap W Q x'))} := by sorry
