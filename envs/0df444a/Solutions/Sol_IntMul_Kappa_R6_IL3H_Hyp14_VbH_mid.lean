/-- The real hypothesis (3) in `ℕ` form (with `lamp ≤ 1`). -/
theorem h3N : K0c c * D * (zsz (p : ℤ) + 1) ≤ K * D := by
  have hD : (1 : ℝ) ≤ D := by exact_mod_cast h.D1
