    1 ≤ p.T ∧ p.L < p.T ∧ 2 ^ p.L ≤ p.T ∧ p.K ≤ p.T ∧ p.N0 ≤ p.T ∧ p.D ≤ p.T ∧ p.K0 ≤ p.K
      ∧ p.KK ≤ p.K ∧ 0 < p.K0 ∧ 0 < p.N0 ∧ p.Lo = p.L - p.m :=
  ⟨p.one_le_T, p.L_lt_T, p.two_pow_le_T, p.K_le_T, p.N0_le_T, p.D_le_T hmL, p.K0_le_K, p.KK_le_K,
