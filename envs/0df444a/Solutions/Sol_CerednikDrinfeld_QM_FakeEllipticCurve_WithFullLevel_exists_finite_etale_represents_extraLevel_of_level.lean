      refine CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_of_exists_comp_eq_comp_of_isPullbackVia E' ψ E₂ kA hkA t _ ?_
      obtain ⟨P₀, hP₀⟩ := h1
      exact ⟨P₀, by rw [hP₀]; simp only [KerOps.toPt_coe, Category.assoc, hkNι]⟩
