        (((((((s3'.upd NLogN.V (s.G NLogN.V)).upd DX R).upd P1
          ((ints (bflyT (2 ^ n + 1) lo hi)).reverse ++ s3'.G P1)).upd P2
          ((ints (bflyB (2 ^ n + 1) E 0 lo hi)).reverse ++ s3'.G P2)).upd NLogN.W
