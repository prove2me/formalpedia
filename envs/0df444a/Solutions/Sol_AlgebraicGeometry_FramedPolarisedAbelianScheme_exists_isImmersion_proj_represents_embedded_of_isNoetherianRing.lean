theorem range_comap_subset_preimage_iff {R R' R'' : Type} [CommRing R] [CommRing R'] [CommRing R'']
    (ψ : R →+* R') (χ : R' →+* R'') (U : Set ↥(Spec (CommRingCat.of R))) :
