-- Source module: Solutions.KFV2Tw
/-!
# KFV §3: the twiddle pass `J_E` (per-record negacyclic rotation by a table)

Records of `r` Gaussian coefficients (`2r` integers) on stack `0`, a table of rotation amounts
`s_j < 2r` (one per record) on stack `14`.

`twC N r = dblI N (2r); rotC N (2r); unpadI N (2r) (4r)`:
double every record to `[z, -z]`, rotate each doubled record (shape `[N, 2r, 2]`) by its table
entry with KFC `rotF` (the table is consumed), keep the first half.

* `twZ r N sv zs`: the result on Gaussian lists; **`twC_spec`** (IL run, cost
  `≤ 10^4 (w+1)(12 N r + 2N + 2) + 70·kap w·4Nr + O(log)`), **`twZ_rep`**: if `zs` represents
  `xs` (`RecRep r F`) then `twZ … zs` represents `twLc r sh Ex xs` when `s_j = sOf r (Ex j)`
  (`J_E` in coefficients, `KFV1Coef`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFV

open IntMul KFC KFT KFU KFB KFH AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## 1. Index arithmetic and closed forms -/

/-- A component of a Gaussian integer. -/
def gc (z : GI) (c : ℕ) : ℤ := if c = 0 then z.1 else z.2

/-! ## 2. The Gaussian result -/

/-- Entry `i < 2r` of the doubled record `j`: `[z, -z]`. -/
def dblGI (zs : List GI) (r j i : ℕ) : GI :=
  if i < r then zs.getD (j * r + i) 0 else -zs.getD (j * r + (i - r)) 0

/-- The twiddled array: record `j` rotated negacyclically by `sv j`. -/
def twZ (r N : ℕ) (sv : ℕ → ℕ) (zs : List GI) : List GI :=
  (List.range (N * r)).map fun k => dblGI zs r (k / r) ((k % r + 2 * r - sv (k / r)) % (2 * r))

/-! ## 3. Records -/

/-! ## 4. The program -/

/-- `rotF` on `[N, Q, 2]` with pushed parameters (the table on stack `14` is consumed). -/
def rotC (N Q : ℕ) : IStmt HS Pp :=
  .seq (.op (.const 1 N)) (.seq (.op (.const 2 Q)) (.seq (.op (.const 4 2))
    (.seq rotF (.seq (.op (.drop 1)) (.seq (.op (.drop 2)) (.op (.drop 4)))))))

def cRotC (N Q w : ℕ) : ℕ :=
  cRotF N Q 2 w + 3 * (zsz (N : ℤ) + zsz (Q : ℤ) + zsz (2 : ℤ)) + 12

/-- **The twiddle pass.** -/
def twC (N r : ℕ) : IStmt HS Pp :=
  .seq (dblI N (2 * r)) (.seq (rotC N (2 * r)) (unpadI N (2 * r) (4 * r)))

def cTw (N r w : ℕ) : ℕ := cDblI N (2 * r) w + cRotC N (2 * r) w + cUnpadI N (2 * r) (4 * r) w

end NLogN.KFV

end

