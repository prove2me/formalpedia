namespace ExactVacuumAtlas

variable {m : ℕ} {U V : Set (Pt (m + 1))} {Φ : Pt (m + 1) → Pt (m + 1)}
  {J K : Pt (m + 1) → Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ} {g gi h hi : Metric (m + 1)}

/-- Uniqueness of the inverse: two left inverses of `G` coincide. -/
theorem left_inverse_unique {G X Y : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ} (hX : X * G = 1)
    (hY : Y * G = 1) : X = Y := by
  have hGY : G * Y = 1 := mul_eq_one_comm.mp hY
  calc X = X * (G * Y) := by rw [hGY, Matrix.mul_one]
    _ = Y := by rw [← Matrix.mul_assoc, hX, Matrix.one_mul]

end ExactVacuumAtlas

