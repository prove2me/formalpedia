    have hfne : levelAutBar q M' ζ γ Jf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) ≠ 0 := by
      intro h0; apply hT0; rw [hTmap, h0]; rfl
    have hinvIg : (levelAutBar q M' ζ γ Jf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ))⁻¹ ∈
        OIg (lineInfty q) := by
      rw [hIg_inf]
      refine ⟨1, T, hTres, ?_⟩
      have hci : (((levelAutBar q M' ζ γ Jf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ))⁻¹ :
          ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)) = (coeffMap A.subtype T)⁻¹ := by
        simp [← hTmap]
      rw [hci, map_one, inv_mul_cancel₀ hT0]

    have hπf0 : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π ≠ 0 := by
      intro h0
      have : (π : AlgebraicClosure ℚ) = 0 := (map_eq_zero_iff _ (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).injective).mp h0
      apply hϖb0; apply Subtype.ext; apply Subtype.ext; exact this
    have hπinv : (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π)⁻¹ ∈ OIg (lineInfty q) := by
      have hb0 : levelAutBar q M' ζ γ ((b₁ : ↥F₀) : ↥(fieldBar q M')) ≠ 0 := by
        intro h0; apply hfne; rw [hτJc, h0, zero_mul]
      have heq : (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π)⁻¹ =
          levelAutBar q M' ζ γ ((b₁ : ↥F₀) : ↥(fieldBar q M')) *
            (levelAutBar q M' ζ γ Jf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ))⁻¹ := by
        rw [hτJc, mul_inv, ← mul_assoc, mul_inv_cancel₀ hb0, one_mul]
      rw [heq]; exact (OIg (lineInfty q)).mul_mem _ _ hτb₁ hinvIg
    obtain ⟨x, y, hy, hxy⟩ := (hIg_inf _).mp hπinv
    apply hy
    have hπC : (((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π) : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)) =
        HahnSeries.C π := by
      show HahnSeries.ofPowerSeries ℤ (AlgebraicClosure ℚ) (algebraMap (AlgebraicClosure ℚ) (PowerSeries (AlgebraicClosure ℚ)) π) = _
      rw [← PowerSeries.C_eq_algebraMap, HahnSeries.ofPowerSeries_C]
    have hπ0 : (π : AlgebraicClosure ℚ) ≠ 0 := fun h0 => hπf0 (by rw [h0, map_zero])

    have hyx : coeffMap A.subtype y = HahnSeries.C π * coeffMap A.subtype x := by
      have h1 : (((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π)⁻¹ : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)) =
          HahnSeries.C π⁻¹ := by simp [hπC]
      rw [h1] at hxy
      have h2 := congrArg (fun z => HahnSeries.C π * z) hxy
