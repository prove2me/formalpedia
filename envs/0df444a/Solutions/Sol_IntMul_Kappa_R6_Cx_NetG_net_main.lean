section
-- Source module: Solutions.R6CxNetGlobL
/-!
# The global chunk program and its labels

`CH = S1 ++ E4s ++ S2 ++ KK`:
* `S1`: stage-one invocations `G1 b` (`b < v`);
* `E4s`: for every `b`, the scratch outputs `A1(b, ·)` moved `𝔽₂^24 ⊗ t_b → ⊤` (E4, width 552);
* `S2`: stage-two invocations `G2 a`;
* `KK`: per `(a, b)` the sign corrections `τ += X` (at `⊤`), `Y += τ` (at `⟨u_{ab}⟩^⊥`, moving `τ`
  by E5, width 1), `X ← -X` (at `⊤`).

`progValid_CH`: the program is valid from the initial labels `g0`; `gF_*`: the final labels.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

attribute [local irreducible] G1 G2 cs1 cs2

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

/-! ## Numeric role codes -/

lemma pair_inj {a b a' b' B : ℕ} (hB : 0 < B) (hb : b < B) (hb' : b' < B) (h : a * B + b = a' * B + b') :
    a = a' ∧ b = b' := by
  obtain ⟨q1, q2⟩ := dmU (n := a * B + b) (q := a) (r := b) hB (by ring) hb
  obtain ⟨q1', q2'⟩ := dmU (n := a * B + b) (q := a') (r := b') hB (by rw [h]; ring) hb'
  exact ⟨q1.symm.trans q1', q2.symm.trans q2'⟩

lemma rc_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : rc (Xr a b) = a * NV + b :=
  rc_rW (by simp only [xI, Wn, NV] at *; nlinarith)
lemma rc_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : rc (Yr a b) = NN + a * NV + b :=
  rc_rW (by simp only [yI, Wn, NN, NV] at *; nlinarith)
lemma rc_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : rc (A1r b q) = 2 * NN + b * NR + q :=
  rc_rW (by simp only [a1I, Wn, NN, NV, NR] at *; nlinarith)
lemma rc_A2 {a q : ℕ} (ha : a < NV) (hq : q < NR) : rc (A2r a q) = 2 * NN + NV * NR + a * NR + q :=
  rc_rW (by simp only [a2I, Wn, NN, NV, NR] at *; nlinarith)
lemma rc_τ {a b : ℕ} (ha : a < NV) (hb : b < NV) : rc (τr a b) = Wn + (48 * NV + a * NV + b) :=
  rc_rT (by simp only [τI, Tn, NV] at *; nlinarith)

lemma rc_ι1_lt {b w : ℕ} (hb : b < NV) (hw : w < NL) : rc (ι1 b w) < Wn + 24 * NV := by
  rw [rc_ι1 hb hw]
  rcases f1_cases hb hw with ⟨h1, e⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, e, hk⟩ <;> rw [e] <;>
    simp only [NV, NR, NN, Wn] at * <;> nlinarith

lemma rc_ι2_lt {a w : ℕ} (ha : a < NV) (hw : w < NL) : rc (ι2 a w) < Wn + 48 * NV := by
  rw [rc_ι2 ha hw]
  rcases f2_cases ha hw with ⟨h1, e⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, e, hk⟩ <;> rw [e] <;>
    simp only [NV, NR, NN, Wn] at * <;> nlinarith

/-- Stage-one roles are in region one. -/
lemma R1_ι1 {b w : ℕ} (hb : b < NV) (hw : w < NL) :
    rc (ι1 b w) < 2 * NN + NV * NR ∨ (Wn ≤ rc (ι1 b w) ∧ rc (ι1 b w) < Wn + 24 * NV) := by
  rw [rc_ι1 hb hw]
  rcases f1_cases hb hw with ⟨h1, e⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, e, hk⟩ <;> rw [e] <;>
    simp only [NV, NR, NN, Wn] at * <;>
    first | (left; nlinarith) | (right; constructor <;> nlinarith)

/-- Stage-two scratch roles are in region two. -/
lemma R2_ι2 {a w : ℕ} (ha : a < NV) (hw : w < NL) (h2 : 2 * NV ≤ w) :
    ¬ (rc (ι2 a w) < 2 * NN + NV * NR ∨ (Wn ≤ rc (ι2 a w) ∧ rc (ι2 a w) < Wn + 24 * NV)) ∧
    ((2 * NN + NV * NR ≤ rc (ι2 a w) ∧ rc (ι2 a w) < Wn) ∨
      (Wn + 24 * NV ≤ rc (ι2 a w) ∧ rc (ι2 a w) < Wn + 48 * NV)) := by
  rw [rc_ι2 ha hw]
  rcases f2_cases ha hw with ⟨h1, e⟩ | ⟨h1, h2', e, hk⟩ | ⟨h1, h2', e, hk⟩ | ⟨h1, e, hk⟩
  · exfalso; simp only [NV] at *; omega
  · exfalso; simp only [NV] at *; omega
  · rw [e]; simp only [NV, NR, NN, Wn] at *
    refine ⟨fun h => ?_, Or.inl ⟨by nlinarith, by nlinarith⟩⟩
    rcases h with h | h <;> nlinarith
  · rw [e]; simp only [NV, NR, NN, Wn] at *
    refine ⟨fun h => ?_, Or.inr ⟨by nlinarith, by nlinarith⟩⟩
    rcases h with h | h <;> nlinarith

/-! ## Initial labels -/

lemma g0_ι1 {b w : ℕ} (hb : b < NV) (hw : w < NL) : g0 (ι1 b w) = labV1 dat b (init1 dat w) := by
  unfold g0
  rw [if_pos (R1_ι1 hb hw), rc_ι1 hb hw, d1_f1 hb hw]

lemma g0_ι2 {a w : ℕ} (ha : a < NV) (hw : w < NL) (h2 : 2 * NV ≤ w) :
    g0 (ι2 a w) = lab2 dat a w (init2 dat w) := by
  obtain ⟨n1, n2⟩ := R2_ι2 ha hw h2
  unfold g0
  rw [if_neg n1, if_pos n2, rc_ι2 ha hw, d2_f2 ha hw]

lemma g0_τ {a b : ℕ} (ha : a < NV) (hb : b < NV) : g0 (τr a b) = ⊤ := by
  unfold g0
  rw [rc_τ ha hb, if_neg (by simp only [NV, NR, NN, Wn] at *; omega),
    if_neg (by simp only [NV, NR, NN, Wn] at *; omega)]

/-! ## Distinctness -/

lemma ι1_ne_τ {b w a c : ℕ} (hb : b < NV) (hw : w < NL) (ha : a < NV) (hc : c < NV) :
    ι1 b w ≠ τr a c := fun e => by
  have h1 := rc_ι1_lt hb hw; rw [e, rc_τ ha hc] at h1; omega

lemma ι2_ne_τ {b w a c : ℕ} (hb : b < NV) (hw : w < NL) (ha : a < NV) (hc : c < NV) :
    ι2 b w ≠ τr a c := fun e => by
  have h1 := rc_ι2_lt hb hw; rw [e, rc_τ ha hc] at h1; omega

lemma ι1_ne_ι2 {b w a w' : ℕ} (hb : b < NV) (hw : w < NL) (ha : a < NV) (hw' : w' < NL) (h2 : 2 * NV ≤ w') :
    ι1 b w ≠ ι2 a w' := fun e => by
  have h1 := R1_ι1 hb hw
  have h2 := (R2_ι2 ha hw' h2).1
  rw [e] at h1; exact h2 h1

lemma A1_ne_ι2 {b q a w : ℕ} (hb : b < NV) (hq : q < NR) (ha : a < NV) (hw : w < NL) :
    A1r b q ≠ ι2 a w := fun e => by
  have h1 := congrArg rc e
  rw [rc_A1 hb hq, rc_ι2 ha hw] at h1
  rcases f2_cases ha hw with ⟨h3, e'⟩ | ⟨h3, h4, e', hk⟩ | ⟨h3, h4, e', hk⟩ | ⟨h3, e', hk⟩ <;>
    rw [e'] at h1 <;> simp only [NV, NR, NN, Wn] at * <;> nlinarith

lemma Y_ne_A1 {a c b q : ℕ} (ha : a < NV) (hc : c < NV) (hb : b < NV) (hq : q < NR) : Yr a c ≠ A1r b q :=
  fun e => by
    have h1 := congrArg rc e
    rw [rc_Y ha hc, rc_A1 hb hq] at h1
    simp only [NV, NR, NN] at *; nlinarith

lemma X_ne_A1 {a c b q : ℕ} (ha : a < NV) (hc : c < NV) (hb : b < NV) (hq : q < NR) : Xr a c ≠ A1r b q :=
  fun e => by
    have h1 := congrArg rc e
    rw [rc_X ha hc, rc_A1 hb hq] at h1
    simp only [NV, NR, NN] at *; nlinarith

lemma τ_ne_A1 {a c b q : ℕ} (ha : a < NV) (hc : c < NV) (hb : b < NV) (hq : q < NR) : τr a c ≠ A1r b q :=
  fun e => by
    have h1 := congrArg rc e
    rw [rc_τ ha hc, rc_A1 hb hq] at h1
    simp only [NV, NR, NN, Wn] at *; nlinarith

lemma A1_inj {b q b' q' : ℕ} (hb : b < NV) (hq : q < NR) (hb' : b' < NV) (hq' : q' < NR)
    (e : A1r b q = A1r b' q') : b = b' ∧ q = q' := by
  have h1 := congrArg rc e
  rw [rc_A1 hb hq, rc_A1 hb' hq'] at h1
  exact pair_inj (by norm_num [NR]) hq hq' (by omega)

lemma τ_inj {a b a' b' : ℕ} (ha : a < NV) (hb : b < NV) (ha' : a' < NV) (hb' : b' < NV)
    (e : τr a b = τr a' b') : a = a' ∧ b = b' := by
  have h1 := congrArg rc e
  rw [rc_τ ha hb, rc_τ ha' hb'] at h1
  exact pair_inj (by norm_num [NV]) hb hb' (by omega)

lemma X_ne_τ {a b a' b' : ℕ} : Xr a b ≠ τr a' b' := rW_ne_rT
lemma Y_ne_τ {a b a' b' : ℕ} : Yr a b ≠ τr a' b' := rW_ne_rT

/-! ## Kernel-checked boundary codes -/

lemma init1_eq {w : ℕ} (hw : w < NL) : gget S1_0 w = init1 dat w := by
  rw [← ggR_eq]; exact Nat.eq_of_beq_eq_true (allN_spec _ NL chkI1 w hw)
lemma init2_eq {w : ℕ} (hw : w < NL) : gget S2_0 w = init2 dat w := by
  rw [← ggR_eq]; exact Nat.eq_of_beq_eq_true (allN_spec _ NL chkI2 w hw)
lemma fin1_eq {w : ℕ} (hw : w < 2 * NV + NR) : gget S1_14 w = fin1 w := by
  rw [← ggR_eq]; exact Nat.eq_of_beq_eq_true (allN_spec _ _ chkF1 w hw)
lemma fin2_eq {w : ℕ} (hw : w < 2 * NV + NR) : gget S2_14 w = fin2 w := by
  rw [← ggR_eq]; exact Nat.eq_of_beq_eq_true (allN_spec _ _ chkF2 w hw)

lemma lc_mod {t : ℕ} (ht : t < NV) : dat.lc t % 4 = 1 := by
  have h := allN_spec _ NV chkTV t ht
  simp only [Bool.and_eq_true] at h
  have h2 := h.2
  unfold lineOK at h2
  simp only [Bool.and_eq_true, Nat.beq_eq] at h2
  exact h2.1.1.1.1.1.1.1

/-! ## Moves to distinct roles -/

section Mv

variable {R : Type} [DecidableEq R] {m : ℕ}

theorem mv_distinct (V : Lab m) :
    ∀ (mv : List (R × Lab m)) (g : R → Lab m), (mv.map Prod.fst).Nodup →
      (∀ p ∈ mv, g p.1 = p.2 ∧ EdgeOK V p.2) →
      MvValid V mv g ∧ ∀ r, mvLab V mv g r = if r ∈ mv.map Prod.fst then V else g r
  | [], g, _, _ => ⟨trivial, fun r => by simp [mvLab]⟩
  | p :: mv, g, hn, h => by
    rw [List.map_cons, List.nodup_cons] at hn
    have hp := h p List.mem_cons_self
    have ih := mv_distinct V mv (Function.update g p.1 V) hn.2 (fun q hq => by
      have hne : q.1 ≠ p.1 := fun e => hn.1 (e ▸ List.mem_map_of_mem hq)
      rw [Function.update_of_ne hne]; exact h q (List.mem_cons_of_mem _ hq))
    refine ⟨⟨hp.1, hp.2, ih.1⟩, fun r => ?_⟩
    show mvLab V mv (Function.update g p.1 V) r = _
    rw [ih.2 r, List.map_cons]
    by_cases h1 : r ∈ mv.map Prod.fst
    · rw [if_pos h1, if_pos (List.mem_cons_of_mem _ h1)]
    · rw [if_neg h1]
      by_cases h2 : r = p.1
      · subst h2; rw [Function.update_self, if_pos List.mem_cons_self]
      · rw [Function.update_of_ne h2, if_neg]
        rw [List.mem_cons]; tauto

end Mv

/-! ## The program -/

lemma mem_E4mv {b : ℕ} {x : Rl × Lab 576} : x ∈ E4mv b ↔ ∃ q < NR, (A1r b q, lift1 (tb dat b) ⊤) = x := by
  unfold E4mv; simp only [List.mem_map, List.mem_range]

lemma E4mv_fst {b : ℕ} {r : Rl} : r ∈ (E4mv b).map Prod.fst ↔ ∃ q < NR, A1r b q = r := by
  unfold E4mv; simp only [List.map_map, List.mem_map, List.mem_range, Function.comp_def]

attribute [local irreducible] E4mv

lemma E4c_mv (b : ℕ) : (E4c b).mv = E4mv b := rfl

lemma PL_nodup : PL.Nodup := List.Nodup.product (List.nodup_range) (List.nodup_range)
lemma mem_PL {p : ℕ × ℕ} : p ∈ PL ↔ p.1 < NV ∧ p.2 < NV := by
  rw [PL]; simp only [List.product, List.mem_flatMap, List.mem_map, List.mem_range]
  constructor
  · rintro ⟨a, ha, b, hb, rfl⟩; exact ⟨ha, hb⟩
  · intro h; exact ⟨p.1, h.1, p.2, h.2, rfl⟩

attribute [local irreducible] S1 E4s S2 KK PL

lemma progLab_nil' (g : Rl → Lab 576) : progLab ([] : List (GChunk Rl 576)) g = g := rfl

lemma range_succ_flatMap {α : Type*} (F : ℕ → List α) (k : ℕ) :
    (List.range (k + 1)).flatMap F = (List.range k).flatMap F ++ F k := by
  rw [List.range_succ, List.flatMap_append, List.flatMap_singleton]

lemma range_succ_map {α : Type*} (F : ℕ → α) (k : ℕ) :
    (List.range (k + 1)).map F = (List.range k).map F ++ [F k] := by
  rw [List.range_succ, List.map_append, List.map_singleton]

/-! ## Stage one -/

lemma P1_zero : P1 0 g0 :=
  ⟨fun b hb w hw => by rw [g0_ι1 hb hw, if_neg (Nat.not_lt_zero b), init1_eq hw], fun _ _ => rfl⟩

lemma P1_step {k : ℕ} (hk : k < NV) {g : Rl → Lab 576} (h : P1 k g) :
    ProgValid (G1 k) g ∧ P1 (k + 1) (progLab (G1 k) g) := by
  obtain ⟨v, c, u⟩ := inv1 hk g (fun w hw => by rw [h.1 k hk w hw, if_neg (lt_irrefl k)])
  refine ⟨v, fun b hb w hw => ?_, fun r hr => ?_⟩
  · by_cases hbk : b = k
    · subst hbk; rw [c w hw, if_pos (Nat.lt_succ_self b)]
    · rw [u _ (fun w' hw' e => hbk (ι1_eq hk hb hw' hw e).1.symm), h.1 b hb w hw]
      by_cases hlt : b < k
      · rw [if_pos hlt, if_pos (by omega)]
      · rw [if_neg hlt, if_neg (by omega)]
  · rw [u r (fun w' hw' => hr k hk w' hw'), h.2 r hr]

theorem S1_upto : ∀ k ≤ NV, ProgValid ((List.range k).flatMap G1) g0 ∧
    P1 k (progLab ((List.range k).flatMap G1) g0)
  | 0, _ => by rw [List.range_zero, List.flatMap_nil, progLab_nil']; exact ⟨trivial, P1_zero⟩
  | k + 1, hk => by
    obtain ⟨v, p⟩ := S1_upto k (by omega)
    obtain ⟨v', p'⟩ := P1_step (by omega) p
    rw [range_succ_flatMap, progValid_append, progLab_append]
    exact ⟨⟨v, v'⟩, p'⟩

lemma S1_valid : ProgValid S1 g0 := by unfold S1; exact (S1_upto NV le_rfl).1
lemma gS1_P1 : P1 NV gS1 := by unfold gS1 S1; exact (S1_upto NV le_rfl).2

lemma blt_f {a b : ℕ} (h : b ≤ a) : Nat.blt a b = false :=
  Bool.eq_false_iff.2 (fun e => by rw [Nat.blt_eq] at e; omega)
lemma blt_t {a b : ℕ} (h : a < b) : Nat.blt a b = true := by rw [Nat.blt_eq]; exact h

lemma fin1_A {q : ℕ} (hq : q < NR) : fin1 (aw q) = TOPC := by
  unfold fin1
  rw [aw_eq, blt_f (by omega), blt_f (by omega), cond_false, cond_false]

lemma fin1_X {t : ℕ} (ht : t < NV) : fin1 (xw t) = TOPC := by
  unfold fin1
  rw [xw, blt_t ht, cond_true]

lemma fin1_Y {S : ℕ} (hS : S < NV) : fin1 (yw S) = perpC (dat.tv S) := by
  unfold fin1
  rw [yw_eq, blt_f (by omega), blt_t (by omega), cond_false, cond_true, Nat.add_sub_cancel_left]

lemma gS1_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : gS1 (A1r b q) = lift1 (tb dat b) ⊤ := by
  rw [← ι1_a hq, gS1_P1.1 b hb (aw q) (by simp only [aw_eq, NL, NV, NR] at *; omega), if_pos hb,
    fin1_eq (by rw [aw_eq]; omega), fin1_A hq, labV1, dec_TOPC]

/-! ## E4 -/

lemma lift1_tb_ne {b : ℕ} (hb : b < NV) : EdgeOK (⊤ : Lab 576) (lift1 (tb dat b) ⊤) := by
  obtain ⟨p, hp⟩ := tb_zero triOK hb
  exact Or.inl (up_E4 (tb_unit triOK hb) hp)

lemma E4c_nodup (b : ℕ) (hb : b < NV) : ((E4c b).mv.map Prod.fst).Nodup := by
  show ((E4mv b).map Prod.fst).Nodup
  unfold E4mv
  simp only [List.map_map]
  refine List.Nodup.map_on (fun x hx y hy e => (A1_inj hb (List.mem_range.1 hx) hb (List.mem_range.1 hy) e).2)
    List.nodup_range

lemma Q4_step {k : ℕ} (hk : k < NV) {g : Rl → Lab 576} (h : Q4 k g) :
    ProgValid [E4c k] g ∧ Q4 (k + 1) (progLab [E4c k] g) := by
  have hmv := mv_distinct (⊤ : Lab 576) (E4c k).mv g (E4c_nodup k hk) (fun p hp => by
    obtain ⟨q, hq, rfl⟩ := mem_E4mv.1 hp
    refine ⟨?_, lift1_tb_ne hk⟩
    rw [h.1 k hk q hq, if_neg (lt_irrefl k), gS1_A1 hk hq])
  have hlab : progLab [E4c k] g = mvLab ⊤ (E4c k).mv g := rfl
  rw [E4c_mv] at hmv hlab
  refine ⟨⟨⟨hmv.1, fun o ho => by simp [E4c] at ho⟩, trivial⟩, fun b hb q hq => ?_, fun r hr => ?_⟩
  · rw [hlab, hmv.2]
    by_cases hbk : b = k
    · subst hbk
      rw [if_pos (E4mv_fst.2 ⟨q, hq, rfl⟩), if_pos (Nat.lt_succ_self b)]
    · rw [if_neg (fun hm => by
        obtain ⟨q', hq', e⟩ := E4mv_fst.1 hm
        exact hbk (A1_inj hk hq' hb hq e).1.symm), h.1 b hb q hq]
      by_cases hlt : b < k
      · rw [if_pos hlt, if_pos (by omega)]
      · rw [if_neg hlt, if_neg (by omega)]
  · rw [hlab, hmv.2, if_neg (fun hm => by
      obtain ⟨q', hq', e⟩ := E4mv_fst.1 hm
      exact hr k (Nat.lt_succ_self k) q' hq' e), h.2 r (fun b hb q hq => hr b (by omega) q hq)]

theorem E4_upto : ∀ k ≤ NV, ProgValid ((List.range k).map E4c) gS1 ∧
    Q4 k (progLab ((List.range k).map E4c) gS1)
  | 0, _ => by
    rw [List.range_zero, List.map_nil, progLab_nil']
    refine ⟨trivial, fun b _ q _ => ?_, fun _ _ => rfl⟩
    rw [if_neg (Nat.not_lt_zero b)]
  | k + 1, hk => by
    obtain ⟨v, p⟩ := E4_upto k (by omega)
    obtain ⟨v', p'⟩ := Q4_step (by omega) p
    rw [range_succ_map, progValid_append, progLab_append]
    exact ⟨⟨v, v'⟩, p'⟩

lemma E4_valid : ProgValid E4s gS1 := by unfold E4s; exact (E4_upto NV le_rfl).1
lemma gE_Q4 : Q4 NV gE := by unfold gE E4s; exact (E4_upto NV le_rfl).2

lemma gE_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : gE (A1r b q) = ⊤ := by
  rw [gE_Q4.1 b hb q hq, if_pos hb]

lemma gE_ι2 {a w : ℕ} (ha : a < NV) (hw : w < NL) : gE (ι2 a w) = lab2 dat a w (init2 dat w) := by
  rw [gE_Q4.2 _ (fun b hb q hq e => A1_ne_ι2 hb hq ha hw e)]
  by_cases h1 : w < NV
  · rw [ι2, if_pos h1, show Yr a w = ι1 w (yw a) from (ι1_y ha).symm,
      gS1_P1.1 w h1 (yw a) (by simp only [yw_eq, NL, NV] at *; omega), if_pos h1,
      fin1_eq (by rw [yw_eq]; omega), fin1_Y ha]
    unfold init2
    rw [blt_t h1, cond_true, lab2, if_pos (by norm_num), extLab, if_neg (by norm_num),
      if_pos (by norm_num), labV1]
  · by_cases h2 : w < 2 * NV
    · have hS : w - NV < NV := by omega
      rw [ι2, if_neg h1, if_pos h2, show Xr a (w - NV) = ι1 (w - NV) (xw a) from (ι1_x ha).symm,
        gS1_P1.1 (w - NV) hS (xw a) (by simp only [xw, NL, NV] at *; omega), if_pos hS,
        fin1_eq (by rw [xw]; omega), fin1_X ha]
      unfold init2
      rw [blt_f (by omega), blt_t h2, cond_false, cond_true, lab2, if_pos (by norm_num), extLab,
        if_neg (by norm_num), if_neg (by norm_num), labV1]
    · rw [gS1_P1.2 _ (fun b hb w' hw' => ι1_ne_ι2 hb hw' ha hw (by omega)), g0_ι2 ha hw (by omega)]

/-! ## Stage two -/

lemma P2_zero : P2 0 gE :=
  ⟨fun a ha w hw => by rw [gE_ι2 ha hw, if_neg (Nat.not_lt_zero a), init2_eq hw], fun _ _ => rfl⟩

lemma P2_step {k : ℕ} (hk : k < NV) {g : Rl → Lab 576} (h : P2 k g) :
    ProgValid (G2 k) g ∧ P2 (k + 1) (progLab (G2 k) g) := by
  obtain ⟨v, c, u⟩ := inv2 hk g (fun w hw => by rw [h.1 k hk w hw, if_neg (lt_irrefl k)])
  refine ⟨v, fun a ha w hw => ?_, fun r hr => ?_⟩
  · by_cases hak : a = k
    · subst hak; rw [c w hw, if_pos (Nat.lt_succ_self a)]
    · rw [u _ (fun w' hw' e => hak (ι2_eq hk ha hw' hw e).1.symm), h.1 a ha w hw]
      by_cases hlt : a < k
      · rw [if_pos hlt, if_pos (by omega)]
      · rw [if_neg hlt, if_neg (by omega)]
  · rw [u r (fun w' hw' => hr k hk w' hw'), h.2 r hr]

theorem S2_upto : ∀ k ≤ NV, ProgValid ((List.range k).flatMap G2) gE ∧
    P2 k (progLab ((List.range k).flatMap G2) gE)
  | 0, _ => by rw [List.range_zero, List.flatMap_nil, progLab_nil']; exact ⟨trivial, P2_zero⟩
  | k + 1, hk => by
    obtain ⟨v, p⟩ := S2_upto k (by omega)
    obtain ⟨v', p'⟩ := P2_step (by omega) p
    rw [range_succ_flatMap, progValid_append, progLab_append]
    exact ⟨⟨v, v'⟩, p'⟩

lemma S2_valid : ProgValid S2 gE := by unfold S2; exact (S2_upto NV le_rfl).1
lemma gS2_P2 : P2 NV gS2 := by unfold gS2 S2; exact (S2_upto NV le_rfl).2

lemma fin2_X {t : ℕ} (ht : t < NV) : fin2 (xw t) = dat.lc t := by
  unfold fin2; rw [xw, blt_t ht, cond_true]
lemma fin2_ge {w : ℕ} (hw : NV ≤ w) : fin2 w = 0 := by
  unfold fin2; rw [blt_f hw, cond_false]

lemma lab2_zero {a w : ℕ} (ha : a < NV) : lab2 dat a w 0 = ⊤ := by
  rw [lab2, if_neg (by norm_num), labV2, dec_zero, lift2_bot (tb_unit triOK ha)]

lemma gS2_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : gS2 (Xr a b) = ⊤ := by
  rw [← ι2_y hb, gS2_P2.1 a ha (yw b) (by simp only [yw_eq, NL, NV] at *; omega), if_pos ha,
    fin2_eq (by rw [yw_eq]; omega), fin2_ge (by rw [yw_eq]; omega), lab2_zero ha]

lemma gS2_A2 {a q : ℕ} (ha : a < NV) (hq : q < NR) : gS2 (A2r a q) = ⊤ := by
  rw [← ι2_a hq, gS2_P2.1 a ha (aw q) (by simp only [aw_eq, NL, NV, NR] at *; omega), if_pos ha,
    fin2_eq (by rw [aw_eq]; omega), fin2_ge (by rw [aw_eq]; omega), lab2_zero ha]

lemma gS2_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : gS2 (Yr a b) = Up a b := by
  rw [← ι2_x hb, gS2_P2.1 a ha (xw b) (by simp only [xw, NL, NV] at *; omega), if_pos ha,
    fin2_eq (by rw [xw]; omega), fin2_X hb, lab2, if_neg (by rw [lc_mod hb]; norm_num), labV2,
    triOK.line b hb, Up, Uv, ← lift2_line (tb_unit triOK ha) (tb_unit triOK hb)]
  simp only [tb]

lemma gS2_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : gS2 (A1r b q) = ⊤ := by
  rw [gS2_P2.2 _ (fun a ha w hw e => A1_ne_ι2 hb hq ha hw e.symm), gE_A1 hb hq]

lemma gS2_τ {a b : ℕ} (ha : a < NV) (hb : b < NV) : gS2 (τr a b) = ⊤ := by
  rw [gS2_P2.2 _ (fun a' ha' w hw => ι2_ne_τ ha' hw ha hb),
    gE_Q4.2 _ (fun b' hb' q hq e => τ_ne_A1 ha hb hb' hq e.symm),
    gS1_P1.2 _ (fun b' hb' w hw => ι1_ne_τ hb' hw ha hb), g0_τ ha hb]

/-! ## Corrections -/

lemma Uv_unit {a b : ℕ} (ha : a < NV) (hb : b < NV) : Uv a b ⬝ᵥ Uv a b = 1 := by
  rw [Uv, tens_dot, tb_unit triOK ha, tb_unit triOK hb, mul_one]

theorem K_valid {a b : ℕ} (ha : a < NV) (hb : b < NV) (g : Rl → Lab 576) (hτ : g (τr a b) = ⊤)
    (hX : g (Xr a b) = ⊤) (hY : g (Yr a b) = Up a b) :
    ProgValid (K (a, b)) g ∧ progLab (K (a, b)) g = Function.update g (τr a b) (Up a b) := by
  have hτX : Xr a b ≠ τr a b := X_ne_τ
  have hτY : Yr a b ≠ τr a b := Y_ne_τ
  refine ⟨⟨⟨trivial, fun o ho => ?_⟩, ⟨⟨hτ, Or.inr (up_E5 (Uv_unit ha hb)), trivial⟩, fun o ho => ?_⟩,
    ⟨trivial, fun o ho => ?_⟩, trivial⟩, rfl⟩
  · simp only [C1, List.mem_singleton] at ho; subst ho
    exact ⟨hτ, hX⟩
  · simp only [C2, List.mem_singleton] at ho; subst ho
    show Function.update g (τr a b) (Up a b) (Yr a b) = Up a b ∧
      Function.update g (τr a b) (Up a b) (τr a b) = Up a b
    rw [Function.update_of_ne hτY, Function.update_self]
    exact ⟨hY, rfl⟩
  · simp only [C3, List.mem_singleton] at ho; subst ho
    show Function.update g (τr a b) (Up a b) (Xr a b) = ⊤ ∧ Function.update g (τr a b) (Up a b) (Xr a b) = ⊤
    rw [Function.update_of_ne hτX]
    exact ⟨hX, hX⟩

theorem KK_valid : ∀ (P : List (ℕ × ℕ)), P.Nodup → (∀ p ∈ P, p.1 < NV ∧ p.2 < NV) →
    ∀ g : Rl → Lab 576, (∀ p ∈ P, g (τr p.1 p.2) = ⊤ ∧ g (Xr p.1 p.2) = ⊤ ∧ g (Yr p.1 p.2) = Up p.1 p.2) →
      ProgValid (P.flatMap K) g ∧ ∀ r, (∀ p ∈ P, τr p.1 p.2 ≠ r) → progLab (P.flatMap K) g r = g r
  | [], _, _, g, _ => by rw [List.flatMap_nil, progLab_nil']; exact ⟨trivial, fun _ _ => rfl⟩
  | p :: P, hn, hP, g, h => by
    rw [List.nodup_cons] at hn
    obtain ⟨ha, hb⟩ := hP p List.mem_cons_self
    obtain ⟨h1, h2, h3⟩ := h p List.mem_cons_self
    obtain ⟨kv, kl⟩ := K_valid ha hb g h1 h2 h3
    have ih := KK_valid P hn.2 (fun q hq => hP q (List.mem_cons_of_mem _ hq))
      (progLab (K p) g) (fun q hq => by
        obtain ⟨ha', hb'⟩ := hP q (List.mem_cons_of_mem _ hq)
        have hne : τr q.1 q.2 ≠ τr p.1 p.2 := fun e => by
          obtain ⟨e1, e2⟩ := τ_inj ha' hb' ha hb e
          exact hn.1 (by rw [show p = q from Prod.ext e1.symm e2.symm]; exact hq)
        obtain ⟨k1, k2, k3⟩ := h q (List.mem_cons_of_mem _ hq)
        rw [show p = (p.1, p.2) from rfl, kl, Function.update_of_ne hne, Function.update_of_ne X_ne_τ,
          Function.update_of_ne Y_ne_τ]
        exact ⟨k1, k2, k3⟩)
    rw [List.flatMap_cons, progValid_append, progLab_append]
    refine ⟨⟨kv, ih.1⟩, fun r hr => ?_⟩
    rw [ih.2 r (fun q hq => hr q (List.mem_cons_of_mem _ hq)), show p = (p.1, p.2) from rfl, kl,
      Function.update_of_ne (Ne.symm (hr p List.mem_cons_self))]

theorem CH_valid : ProgValid CH g0 ∧ ∀ r, (∀ p ∈ PL, τr p.1 p.2 ≠ r) → gF r = gS2 r := by
  have hK := KK_valid PL PL_nodup (fun p hp => mem_PL.1 hp) gS2 (fun p hp => by
    obtain ⟨ha, hb⟩ := mem_PL.1 hp
    exact ⟨gS2_τ ha hb, gS2_X ha hb, gS2_Y ha hb⟩)
  have e : progLab CH g0 = progLab (PL.flatMap K) gS2 := by
    rw [CH, progLab_append, progLab_append, progLab_append, KK]; rfl
  refine ⟨?_, fun r hr => ?_⟩
  · rw [CH, progValid_append, progValid_append, progValid_append]
    have hgE : progLab (S1 ++ E4s) g0 = gE := by rw [progLab_append]; rfl
    have hgS2 : progLab S2 gE = gS2 := rfl
    refine ⟨⟨⟨S1_valid, E4_valid⟩, ?_⟩, ?_⟩
    · first | exact S2_valid | (rw [hgE]; exact S2_valid)
    · first | (rw [progLab_append, hgE, hgS2, KK]; exact hK.1) | (rw [hgE, hgS2, KK]; exact hK.1)
  · rw [gF, e]; exact hK.2 r hr

lemma τ_notin {r : Rl} (h : ∀ a < NV, ∀ b < NV, τr a b ≠ r) : ∀ p ∈ PL, τr p.1 p.2 ≠ r :=
  fun p hp => h p.1 (mem_PL.1 hp).1 p.2 (mem_PL.1 hp).2

theorem gF_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : gF (Xr a b) = ⊤ := by
  rw [CH_valid.2 _ (τ_notin fun _ _ _ _ e => X_ne_τ e.symm), gS2_X ha hb]
theorem gF_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : gF (Yr a b) = Up a b := by
  rw [CH_valid.2 _ (τ_notin fun _ _ _ _ e => Y_ne_τ e.symm), gS2_Y ha hb]
theorem gF_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : gF (A1r b q) = ⊤ := by
  rw [CH_valid.2 _ (τ_notin fun a ha c hc => τ_ne_A1 ha hc hb hq), gS2_A1 hb hq]
theorem gF_A2 {a q : ℕ} (ha : a < NV) (hq : q < NR) : gF (A2r a q) = ⊤ := by
  rw [CH_valid.2 _ (τ_notin (r := A2r a q) fun _ _ _ _ e => rW_ne_rT e.symm), gS2_A2 ha hq]

/-! ## Initial labels of the data roles -/

lemma lift1_line (t s : V24) : lift1 t (lineM s) = lineM (NetT.tens s t) := by
  rw [lift1, lineM, lineM, Submodule.map_span, Set.image_singleton]
  rfl

theorem g0_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : g0 (Xr a b) = lineM (Uv a b) := by
  rw [← ι1_x ha, g0_ι1 hb (by simp only [xw, NL, NV] at *; omega)]
  unfold init1
  rw [xw, blt_t ha, cond_true, labV1, triOK.line a ha, lift1_line, Uv]
  simp only [tb]

lemma lift1_bot (t : V24) : lift1 t ⊥ = ⊥ := Submodule.map_bot _

theorem g0_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : g0 (Yr a b) = ⊥ := by
  rw [← ι1_y ha, g0_ι1 hb (by simp only [yw_eq, NL, NV] at *; omega)]
  unfold init1
  rw [yw_eq, blt_f (by omega), blt_t (by omega), cond_false, cond_true,
    labV1, dec_zero, lift1_bot]

theorem g0_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : g0 (A1r b q) = ⊥ := by
  rw [← ι1_a hq, g0_ι1 hb (by simp only [aw_eq, NL, NV, NR] at *; omega)]
  unfold init1
  rw [aw_eq, blt_f (by omega), blt_t (by omega), cond_false, cond_true,
    labV1, dec_zero, lift1_bot]

theorem g0_A2 {a q : ℕ} (ha : a < NV) (hq : q < NR) : g0 (A2r a q) = ⊥ := by
  rw [← ι2_a hq, g0_ι2 ha (by simp only [aw_eq, NL, NV, NR] at *; omega) (by rw [aw_eq]; omega)]
  unfold init2
  rw [aw_eq, blt_f (by omega), blt_f (by omega), blt_t (by omega), cond_false, cond_false,
    cond_true, lab2, if_pos (by norm_num), extLab, if_pos (by norm_num)]

