-- title:
--   Lemma 6: the successive differences of the IALM sequence vanish
-- statement:
--   Suppose that Assumptions 1, 2 and 3 hold and that the parameters are chosen as in (64) and (65), and let $\{(w^k;u^k;z^k;v^k)\}_{k\in\mathbb N}$ be a sequence generated by IALM satisfying the stopping criteria (32); these are the premises of Lemma 4. Then
--   $$
--   \lim_{k\to\infty}\|w^{k+1}-w^k\|=0,\quad\lim_{k\to\infty}\|u^{k+1}-u^k\|=0,\quad\lim_{k\to\infty}\|z^{k+1}-z^k\|=0,\quad\lim_{k\to\infty}\|v^{k+1}-v^k\|=0.
--   $$
--
--   The vanishing of the steps is the hypothesis that upgrades convergence along subsequences to convergence of the whole sequence.
--
--   Differences from the source:
--   - generalization: a sequence generated by IALM, whose primal step is computed by 0/1-BALM (Algorithm 2) → every sequence satisfying (32a), (32b), (33) and vᵏ⁺¹ = wᵏ⁺¹ with positive tolerances; reason: every 0/1-BALM sequence satisfies these relations, and the proof in the paper uses only these relations
--   - generalization: Assumption 2 with γ := √θ_min(AAᵀ) > 0 → any γ > 0 with γ‖z‖ ≤ ‖Aᵀz‖ for every z; reason: the paper’s γ satisfies this inequality, so the printed statement is the instance γ = √θ_min(AAᵀ), and the proof uses Assumption 2 only through this inequality
--   - encoding: A ∈ ℝⁿˣᵖ and its transpose Aᵀ → a continuous linear map between Euclidean spaces and its adjoint; reason: the same objects in the standard bases
-- source:
--   Zhang & Xiu, Global Convergence of Inexact Augmented Lagrangian Method for Zero-One Composite Optimization, arXiv:2112.00440v1, Lemma 6, display (77), p.24

import Mathlib
import Definitions.Def_ZeroOneIALM_Assumptions
import Definitions.Def_ZeroOneIALM_Parameters
import Definitions.Def_ZeroOneIALM_Run

open Filter Topology

namespace ZeroOneIALM

/-- Lemma 6, Zhang & Xiu, arXiv:2112.00440v1, display (77), p.24: under the premises of Lemma 4,
that is, Assumptions 1, 2, 3, the parameter choices (64), (65) and an IALM sequence satisfying
(32), the successive differences of all four sequences tend to `0`. -/
theorem lemma_6 {p n : ℕ} {f : EuclideanSpace ℝ (Fin p) → ℝ}
    {A : EuclideanSpace ℝ (Fin p) →L[ℝ] EuclideanSpace ℝ (Fin n)}
    {b : EuclideanSpace ℝ (Fin n)} {lam μ ρ lf γ η : ℝ} {ε : ℕ → ℝ}
    {w : ℕ → EuclideanSpace ℝ (Fin p)} {u z : ℕ → EuclideanSpace ℝ (Fin n)}
    {v : ℕ → EuclideanSpace ℝ (Fin p)}
    (hlam : 0 < lam) (hμ : 0 < μ)
    (h1 : IsSmoothWith f lf) (h2 : IsRowRankConstant A γ) (h3 : IsBoundedBelow f)
    (hpar : IsParameterChoice μ lf γ ρ η ε)
    (hrun : IsIALMRun f A b lam μ ρ ε w u z v) :
    Tendsto (fun k => ‖w (k + 1) - w k‖) atTop (𝓝 0) ∧
      Tendsto (fun k => ‖u (k + 1) - u k‖) atTop (𝓝 0) ∧
      Tendsto (fun k => ‖z (k + 1) - z k‖) atTop (𝓝 0) ∧
      Tendsto (fun k => ‖v (k + 1) - v k‖) atTop (𝓝 0) := by sorry

end ZeroOneIALM
