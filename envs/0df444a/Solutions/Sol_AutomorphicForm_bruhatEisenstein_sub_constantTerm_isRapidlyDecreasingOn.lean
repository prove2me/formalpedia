section Continuity

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

private theorem continuous_botNormSqC_gOfC :
    Continuous fun x : AdelicGL2 (𝓞 F) F => botNormSqC (gOfC hw x) := by
  have h10 : Continuous fun x : AdelicGL2 (𝓞 F) F => (gOfC hw x) 1 0 :=
    (continuous_gOfC hw).matrix_elem 1 0
  have h11 : Continuous fun x : AdelicGL2 (𝓞 F) F => (gOfC hw x) 1 1 :=
    (continuous_gOfC hw).matrix_elem 1 1
  exact ((continuous_normSq.comp h10).add (continuous_normSq.comp h11) :)

private theorem continuous_radFloorC_gOfC :
    Continuous fun x : AdelicGL2 (𝓞 F) F => radFloorC (gOfC hw x) := by
  have hb := continuous_botNormSqC_gOfC hw
  have hA_pos : ∀ x : AdelicGL2 (𝓞 F) F, 0 < botNormSqC (gOfC hw x) := fun x =>
    botNormSqC_pos _ (gOfC_det_ne_zero hw x)
  have hdet : Continuous fun x : AdelicGL2 (𝓞 F) F => (gOfC hw x).det :=
    (continuous_gOfC hw).matrix_det
  have hcentre : Continuous fun x : AdelicGL2 (𝓞 F) F => lineCentre (gOfC hw x) := by
    have hnum : Continuous fun x : AdelicGL2 (𝓞 F) F =>
        -(starRingEnd ℂ ((gOfC hw x) 1 0) * (gOfC hw x) 0 0
          + starRingEnd ℂ ((gOfC hw x) 1 1) * (gOfC hw x) 0 1) :=
      (((Complex.continuous_conj.comp ((continuous_gOfC hw).matrix_elem 1 0)).mul
          ((continuous_gOfC hw).matrix_elem 0 0)).add
        ((Complex.continuous_conj.comp ((continuous_gOfC hw).matrix_elem 1 1)).mul
          ((continuous_gOfC hw).matrix_elem 0 1))).neg
    have hden : Continuous fun x : AdelicGL2 (𝓞 F) F =>
        ((botNormSqC (gOfC hw x) : ℝ) : ℂ) := Complex.continuous_ofReal.comp hb
    exact hnum.div hden fun x => by
      exact_mod_cast (hA_pos x).ne'
  have h1 : Continuous fun x : AdelicGL2 (𝓞 F) F =>
      normSq ((gOfC hw x).det) / botNormSqC (gOfC hw x)
        / (1 + 2 * normSq (lineCentre (gOfC hw x))) := by
    refine Continuous.div (Continuous.div (continuous_normSq.comp hdet) hb
      fun x => (hA_pos x).ne') ?_
      fun x => ne_of_gt (by linarith [normSq_nonneg (lineCentre (gOfC hw x))])
    exact (continuous_const.add (continuous_const.mul
      (continuous_normSq.comp hcentre)) :)
  exact h1.min (hb.div_const 2)

private theorem continuous_hatRatio_gOfC :
    Continuous fun x : AdelicGL2 (𝓞 F) F => hatRatio (gOfC hw x) := by
  unfold hatRatio
  refine continuous_const.max ?_
  refine (continuous_botNormSqC_gOfC hw).div (continuous_gOfC hw).matrix_det.norm fun x => ?_
  exact norm_ne_zero_iff.2 (gOfC_det_ne_zero hw x)

private theorem continuous_sqrt_div_sqrt_gOfC :
    Continuous fun x : AdelicGL2 (𝓞 F) F =>
      Real.sqrt (botNormSqC (gOfC hw x)) / Real.sqrt (radFloorC (gOfC hw x)) := by
  refine (Real.continuous_sqrt.comp (continuous_botNormSqC_gOfC hw)).div
    (Real.continuous_sqrt.comp (continuous_radFloorC_gOfC hw)) fun x => ?_
  exact (Real.sqrt_pos.2 (radFloorC_pos (gOfC_det_ne_zero hw x))).ne'

private theorem continuous_hatTower_gOfC (i : ℕ) :
    Continuous fun x : AdelicGL2 (𝓞 F) F => hatTower (gOfC hw x) i := by
  unfold hatTower invRadTower
  exact ((continuous_const.mul ((continuous_const.mul (continuous_hatRatio_gOfC hw)).pow i)).mul
    (continuous_const.add (continuous_const.mul (continuous_sqrt_div_sqrt_gOfC hw))) :)

private theorem continuous_hatD_gOfC (N : ℕ) :
    Continuous fun x : AdelicGL2 (𝓞 F) F => hatD (gOfC hw x) N := by
  unfold hatD
  exact (continuous_const.max (continuous_finsetSum _ fun i _ => continuous_hatTower_gOfC hw i) :)

private theorem continuous_sqrt_radFloorC_rpow_gOfC (β : ℝ) :
    Continuous fun x : AdelicGL2 (𝓞 F) F => Real.sqrt (radFloorC (gOfC hw x)) ^ β := by
  refine (Real.continuous_sqrt.comp (continuous_radFloorC_gOfC hw)).rpow_const fun x => Or.inl ?_
  exact (Real.sqrt_pos.2 (radFloorC_pos (gOfC_det_ne_zero hw x))).ne'

end Continuity
