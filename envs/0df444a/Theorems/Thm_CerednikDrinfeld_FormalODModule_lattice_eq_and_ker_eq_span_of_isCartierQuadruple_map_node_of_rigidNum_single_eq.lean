              (FullLattice.act g (stdFullLattice ℚ_[p]))
              (actBaseChange (locRing Ω x) g (stdFullLattice ℚ_[p])
                ((1 : locRing Ω x) ⊗ₜ[ℤ_[p]] stdBasisVec ℚ_[p] 0 + (0 : locRing Ω x) ⊗ₜ[ℤ_[p]] stdBasisVec ℚ_[p] 1)))} := by sorry
