-- title:
--   Proof of Theorem 4.2, case 1, pp. 10–11 — with unbounded ρ_k, ρ_k‖Π_𝒦°(G(x^k))‖² → 0
-- statement:
--   Let $(x^k,\hat\Lambda^k,\rho_k)_{k\in\mathbb N}$ be generated by Algorithm 1 for (NCP), let $\bar x$ be feasible, and let $\{x^{k_j}\}_{j\in\mathbb N}$ be a subsequence converging to $\bar x$. Suppose that $\{\rho_k\}$ is unbounded and that $\bar x$ satisfies the generalized Łojasiewicz inequality (28) for $\Psi(x)=\tfrac12\|\Pi_{\mathcal K^\circ}(G(x))\|^2$. Then
--   $$\rho_{k_j}\,\big\|\Pi_{\mathcal K^\circ}(G(x^{k_j}))\big\|^2\to0\qquad(j\to\infty).$$
--
--   This is the key estimate of the unbounded-penalty case of Theorem 4.2: it controls the complementarity term $\langle\Lambda^k,\Pi_{\mathcal K^\circ}(G(x^k))\rangle$ of CAKKT.
--
--   **Formalization Note** The page's "we can suppose that $\{x^k\}\to\bar x$" is the subsequence $k_j=\varphi(j)$ with $\varphi$ strictly increasing; the whole sequence is not assumed to converge.
-- source:
--   Andreani, Gómez, Haeser, Mito & Ramos, On Optimality Conditions for Nonlinear Conic Programming, author's manuscript (revised 2021-04-20; Math. Oper. Res. doi:10.1287/moor.2021.1203), proof of Theorem 4.2, case 1, pp. 10–11, "We start by showing that ρ_k‖Π_𝒦°(G(x^k))‖² → 0"

import Mathlib
import Definitions.Def_MoreauProx_Decomposition_Cones
import Definitions.Def_NCPSeqOpt_AugLag_Setting

namespace NCPSeqOpt.AugLag

open MoreauProx.Decomposition
open scoped InnerProductSpace
open Filter Topology

theorem proof_4_2_rho_infeas_tendsto_zero {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (G : EuclideanSpace ℝ (Fin n) → E) (hG : ContDiff ℝ 1 G)
    (K : Set E) (hK : IsClosedConvexCone K)
    (ε : ℕ → ℝ) (B : Set E) (τ σ ρ₀ : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n))
    (Λhat : ℕ → E) (ρ : ℕ → ℝ) (hrun : IsALRun f G K ε B τ σ ρ₀ x Λhat ρ)
    (xbar : EuclideanSpace ℝ (Fin n)) (hfeas : G xbar ∈ K)
    (φ : ℕ → ℕ) (hφ : StrictMono φ) (hx : Tendsto (x ∘ φ) atTop (𝓝 xbar))
    (hρ : ¬ BddAbove (Set.range ρ)) (hL : GenLojasiewicz (Psi K G) xbar) :
    Tendsto (fun j => ρ (φ j) * ‖proj (polarCone K) (G (x (φ j)))‖ ^ 2) atTop (𝓝 0) := by sorry

end NCPSeqOpt.AugLag
