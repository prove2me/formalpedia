variable {d : ℕ}

/-! ## Definition 2.5: cubes -/

lemma QFS.cube_subset_closedBall {h : ℝ} (u : EuclideanSpace ℝ (Fin d)) :
    cube h u ⊆ closedBall u (h / 2 * Real.sqrt d) := by sorry
