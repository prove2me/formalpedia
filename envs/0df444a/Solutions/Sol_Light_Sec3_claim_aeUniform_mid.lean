                                                                                                                                              (first
                                                                                                                                                | omega
                                                                                                                                                | ((ring_nf); (omega))))
                                                                                                                                          | omega
                                                                                                                                          |
                                                                                                                                            (simp [] <;>
                                                                                                                                                first
