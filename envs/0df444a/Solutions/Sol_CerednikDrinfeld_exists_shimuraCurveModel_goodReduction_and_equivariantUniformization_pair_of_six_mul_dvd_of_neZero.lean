section perPlace
open AlgebraicCurve CerednikDrinfeld.Mumford

theorem perPlace
    {r : ℕ} [Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime r)
    (S : Type) [Group S] (scalar : S →* ↥(A.decompositionSubgroup ℚ))
    (ι : ↥(A.decompositionSubgroup ℚ) →* S) (hι : ∀ τ, scalar (ι τ) = τ)
    (FC : Type) [Field FC] [Algebra A.valuation.Completion FC]
    (galFC : S →* SemilinearAut A.valuation.Completion FC)
    {E𝒞 V𝒞 : Type} [Fintype E𝒞] [DecidableEq E𝒞] [Fintype V𝒞] [DecidableEq V𝒞] (𝒞 : DegeneracyData E𝒞 V𝒞)
    (actZ : S →* (↥(ribbonKernel 𝒞) ≃ₗ[ℤ] ↥(ribbonKernel 𝒞)))
    (𝒰' : EquivariantUniformization r 𝒞 A hA (Pic0 A.valuation.Completion FC) S scalar actZ
      ((DistribMulAction.toAddAut' (SemilinearAut A.valuation.Completion FC) (Pic0 A.valuation.Completion FC)).comp galFC))

    (N : ℕ) {ad bd : ℚ} (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd])
    (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    (e : ↥(ribbonKernel 𝒞) ≃ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (hiso : ∀ x y : ↥(ribbonKernel 𝒞),
      ribbonGram (classSetDegeneracyData Rd nd) (e x) (e y) = ribbonGram 𝒞 x y)
    (eE : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → E𝒞)
    (he_apply : ∀ (x : ↥(ribbonKernel 𝒞)) (c : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd))),
      ((e x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) c =
        (x : E𝒞 → ℤ) (eE c))
    (shiftE : E𝒞 → E𝒞)
    (hshiftE : ∀ c, eE (classSetShift _ nd c) = shiftE (eE c))

    (χ : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
    (hχ_inertia : ∀ τ : ↥(A.decompositionSubgroup ℚ),
      (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ → χ τ = 1)
    (hχ_frob : ∀ φ : ↥(A.decompositionSubgroup ℚ),
      A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r → χ φ ≠ 1)
    (hactZ_even : ∀ τ : ↥(A.decompositionSubgroup ℚ), χ τ = 1 → actZ (ι τ) = 1)
    (hactZ_odd : ∀ τ : ↥(A.decompositionSubgroup ℚ), χ τ ≠ 1 → ∀ x : ↥(ribbonKernel 𝒞),
      ((actZ (ι τ) x : ↥(ribbonKernel 𝒞)) : E𝒞 → ℤ) = fun e' => - (x : E𝒞 → ℤ) (shiftE e'))

    [Fact (A.DecompositionIsometric ℚ)]

    (σ₀ : S) (hσ₀ : scalar σ₀ = 1)
    (hσ₀Z : ∀ x : ↥(ribbonKernel 𝒞),
      ((actZ σ₀ x : ↥(ribbonKernel 𝒞)) : E𝒞 → ℤ) = fun e' => - (x : E𝒞 → ℤ) (shiftE e'))

    {a b : ℚ} {R : Submodule ℤ ℍ[ℚ, a, b]} {ιR : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ}
    {𝒮 : ℕ → Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ}
    (M : ShimuraCurveModel R ιR 𝒮) (ε : Nat.Primes → ℤˣ)
    (ιT : M.J →+ Pic0 A.valuation.Completion FC)
    (hinj : Function.Injective ιT)
    (htors : ∀ t : Pic0 A.valuation.Completion FC, IsOfFinAddOrder t → t ∈ ιT.range)
    (hequiv : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (c : M.J),
      ιT (M.galJ (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) c) = galFC (ι τ) • ιT c)

    (hAdj : (pdTransport 𝒰'.P e hiso).HeckeAdjointable (classSetHeckeData N r Λd Rd nd))
    (hHecke : ∀ (ℓ : Nat.Primes) (u : (pdTransport 𝒰'.P e hiso).TorusPoints) (c : M.J),
      u ∈ (pdTransport 𝒰'.P e hiso).U → 𝒰'.eFull (torusPull 𝒰'.P e hiso u) = ιT c →
        𝒰'.eFull (torusPull 𝒰'.P e hiso
          ((pdTransport 𝒰'.P e hiso).precomp (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ) u)) =
          ιT (M.heckeJSigned ε (heckeGen ℓ) c)) :
    PerPlaceGoal r A hA N Λd Rd nd M ε := by
  classical

  have hact : ∀ (σ : S) (x : ↥(ribbonKernel 𝒞)), e (actZ σ x) = conjAct e actZ σ (e x) := by
    intro σ x; rw [conjAct_apply, LinearEquiv.symm_apply_apply]
  let 𝒰S := euTransport 𝒰' e hiso (conjAct e actZ) hact

  have hodd : ∀ σ : S, (∀ x : ↥(ribbonKernel 𝒞),
      ((actZ σ x : ↥(ribbonKernel 𝒞)) : E𝒞 → ℤ) = fun e' => - (x : E𝒞 → ℤ) (shiftE e')) →
      ∀ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
      ((conjAct e actZ σ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) :
        ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
        fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c) := by
    intro σ hσ x
    funext c
    rw [conjAct_apply, he_apply, hσ]
    show -((e.symm x : ↥(ribbonKernel 𝒞)) : E𝒞 → ℤ) (shiftE (eE c)) = _
    rw [← hshiftE, ← he_apply, LinearEquiv.apply_symm_apply]

  have hQ : ∀ x y x' y' : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
      ((x' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
        fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) →
      ((y' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
        fun c => - (y : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) →
        𝒰S.P.Q x' y' = 𝒰S.P.Q x y := by
