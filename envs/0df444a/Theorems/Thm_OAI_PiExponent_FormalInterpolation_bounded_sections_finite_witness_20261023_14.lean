-- title:
--   Pointwise bounded sections admit a finite witness
-- statement:
--   Reduce pointwise nonvanishing sections to a finite family preserving the property that their degree-`D` components have no common zero away from the origin. Form the ideal generated by all available components, use Noetherianity to choose finitely many generators, and collect the finitely many sections used for those generators. This removes finite-witness extraction from the parent while preserving the ordinary-power membership and support bound.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.bounded_sections_finite_witness_20261023_14
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (s D : Nat)
    (hpoint : ∀ (x : Fin d → Complex), (∃ i : Fin d, x i ≠ 0) →
      ∃ p : MvPolynomial (Fin d) Complex,
        p ∈ I ^ s ∧
        (∀ a ∈ p.support,
          ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real)) ∧
        MvPolynomial.eval x
          (MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) p) ≠ 0) :
    ∃ m : Nat, ∃ g : Fin m → MvPolynomial (Fin d) Complex,
      (∀ j, g j ∈ I ^ s) ∧
      (∀ j, ∀ a ∈ (g j).support,
        ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real)) ∧
      (∀ (x : Fin d → Complex),
        (∀ (j : Fin m), MvPolynomial.eval x
          (MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : ℚ)) (D : ℚ) (g j)) = 0) →
          ∀ (i : Fin d), x i = 0) := by sorry
