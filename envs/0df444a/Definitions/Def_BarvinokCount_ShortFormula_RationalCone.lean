-- title:
--   Rational cones by generators, simple and primitive generators, sup norm, lattice-point count, signed cone decompositions
-- statement:
--   This file fixes the basic vocabulary of Barvinok's paper for cones in $\mathbb{R}^d$ given by integral generators.
--
--   Points of $\mathbb{R}^d$ are functions $\{0,\dots,d-1\}\to\mathbb{R}$ and integral vectors are functions into $\mathbb{Z}$; an integral vector $z\in\mathbb{Z}^d$ is regarded as the point $\bar z\in\mathbb{R}^d$ with the same coordinates. The inner product $\langle c,x\rangle=\sum_l c_l x_l$ is the standard one.
--
--   1. **Rational cone** (Definition 2.3). For integral vectors $u_1,\dots,u_k\in\mathbb{Z}^d$,
--   $$\operatorname{co}\{u_1,\dots,u_k\}=\Bigl\{\sum_{i=1}^k \lambda_i u_i : \lambda_i\ge 0\Bigr\}\subseteq\mathbb{R}^d .$$
--   For $k=0$ this is $\{0\}$. The vectors $u_i$ are the *generators* of the cone.
--   2. **Simple generators** (Definition 2.3): $u_1,\dots,u_k$ are linearly independent over $\mathbb{R}$.
--   3. **Primitive generators** (Definition 3.1): $u_1,\dots,u_k$ are simple and form a basis of the lattice $\Lambda=\mathbb{Z}^d\cap\operatorname{Lin}\{u_1,\dots,u_k\}$, that is, every integral vector in the real linear span of the $u_i$ is an integer combination $\sum_i m_i u_i$, $m_i\in\mathbb{Z}$.
--   4. **Sup norm** (p. 772): $|u|=\max\{|u_l| : l=1,\dots,d\}$ for $u\in\mathbb{Z}^d$ (equal to $0$ when $d=0$).
--   5. **Lattice-point count**: $\#(S\cap\mathbb{Z}^d)$ for a set $S\subseteq\mathbb{R}^d$.
--   6. **Signed decomposition** (§5, p. 774). For a set $K\subseteq\mathbb{R}^d$, cones $K_i=\operatorname{co}(g_i)$ given by generator lists $g_i$ of possibly different lengths, and integers $\varepsilon_i$ ($i\in I$, $I$ finite), one writes $K=\sum_{i\in I}\varepsilon_i K_i$ if
--   $$\chi_K(x)=\sum_{i\in I}\varepsilon_i\,\chi_{K_i}(x)\quad\text{for all }x\in\mathbb{R}^d,$$
--   where $\chi_S$ is the characteristic function of $S$.
--
--   These are the objects in which all statements of the mission are phrased: Barvinok's algorithm writes the supporting cone of a simplex at each vertex as a signed combination of primitive cones.
--
--   **Formalization Note** A cone is always given by its generator list, because the index, the parallelepiped and the closed form of $\sigma$ depend on the generators and not only on the set. "Primitive" here is Barvinok's notion (a lattice basis of $\operatorname{Lin}K\cap\mathbb{Z}^d$), not "linearly independent generators", which the paper calls *simple*. The lattice-point count uses `Nat.card`, which is $0$ for an infinite set; it is only applied to bounded sets (simplices).
-- source:
--   Barvinok, A polynomial time algorithm for counting integral points in polyhedra when the dimension is fixed, Math. Oper. Res. 19 (1994), p. 770, notation and Definition 2.3; p. 772, Definition 3.1 and the norm |u|; p. 774, signed decompositions K = Σ ε_i K_i

import Mathlib

namespace BarvinokCount.ShortFormula

/-- The integral vector `z ∈ ℤ^d` viewed as a point of `ℝ^d`. -/
def castVec {d : ℕ} (z : Fin d → ℤ) : Fin d → ℝ := fun l => (z l : ℝ)

/-- The rational cone `co{u_1, …, u_k}` generated by the integral vectors `u_i`
(Barvinok 1994, Definition 2.3): all nonnegative real combinations of the generators.
For `k = 0` it is `{0}`. -/
def cone {d k : ℕ} (u : Fin k → Fin d → ℤ) : Set (Fin d → ℝ) :=
  {x | ∃ lam : Fin k → ℝ, (∀ i, 0 ≤ lam i) ∧ x = ∑ i, lam i • castVec (u i)}

/-- The generator list is *simple*: the generators are linearly independent over `ℝ`
(Definition 2.3). -/
def IsSimpleGens {d k : ℕ} (u : Fin k → Fin d → ℤ) : Prop :=
  LinearIndependent ℝ (fun i => castVec (u i))

/-- The generator list consists of *primitive generators* (Definition 3.1): it is simple and
it is a basis of the lattice `Λ = ℤ^d ∩ Lin{u_1, …, u_k}`, i.e. every integral vector in the
real linear span of the generators is an integer combination of them. -/
def IsPrimitiveGens {d k : ℕ} (u : Fin k → Fin d → ℤ) : Prop :=
  IsSimpleGens u ∧
    ∀ z : Fin d → ℤ, castVec z ∈ Submodule.span ℝ (Set.range fun i => castVec (u i)) →
      ∃ m : Fin k → ℤ, z = ∑ i, m i • u i

/-- The sup norm `|u| = max{|u_l| : l = 1, …, d}` of an integral vector (p. 772);
it is `0` for `d = 0`. -/
def supNorm {d : ℕ} (z : Fin d → ℤ) : ℕ :=
  Finset.univ.sup fun l => (z l).natAbs

/-- The number `#(S ∩ ℤ^d)` of integral points of a set `S ⊆ ℝ^d` (`Nat.card`, which is `0`
for an infinite set; it is only applied to bounded sets). -/
noncomputable def latticeCount {d : ℕ} (S : Set (Fin d → ℝ)) : ℕ :=
  Nat.card {z : Fin d → ℤ // castVec z ∈ S}

/-- The signed decomposition `K = ∑_{i ∈ I} ε_i · K_i` of §5 (p. 774): the characteristic
functions satisfy `χ_K(x) = ∑_i ε_i χ_{K_i}(x)` for **all** `x ∈ ℝ^d`. The cones `K_i` are
given by generator lists `g i` of possibly different lengths `m i`. -/
def IsSignedConeDecomp {d N : ℕ} (K : Set (Fin d → ℝ)) {m : Fin N → ℕ}
    (g : (i : Fin N) → Fin (m i) → Fin d → ℤ) (ε : Fin N → ℤ) : Prop :=
  ∀ x : Fin d → ℝ,
    K.indicator (fun _ => (1 : ℝ)) x = ∑ i, (ε i : ℝ) * (cone (g i)).indicator (fun _ => (1 : ℝ)) x

end BarvinokCount.ShortFormula


