end Defs

theorem shR_eq_app (d : ℕ) (f : ℕ → ℕ) : shR d f = (List.range d).map f ++ [f d] := by
  simp [shR]

theorem shK_eq_app (d : ℕ) (f : ℕ → ℕ) : shK d f = ((List.range d).map f).reverse ++ [f d] := by
  simp [shK, List.map_reverse]

theorem valid_revH_KR (d : ℕ) (f : ℕ → ℕ) {a : List ℕ} (ha : Valid (shK d f) a) :
    Valid (shR d f) (revH d a) := by
  rw [shK_eq_app] at ha
  have := valid_revH ha
  rwa [List.length_reverse, List.length_map, List.length_range, List.reverse_reverse,
    ← shR_eq_app] at this

theorem nodup_L (d : ℕ) : (List.range d ++ [d]).Nodup := by
  rw [← List.range_succ]; exact List.nodup_range

theorem mzP_L (d h : ℕ) (L : List ℕ) (hL : ∀ j ∈ L, j < d) : ∀ j ∈ L, mzP d h j = 2 ^ h := by
  intro j hj; simp [mzP, hL j hj]

theorem bgP_d (d : ℕ) (bL : ℕ → Bool) : bgP d bL d = false := by simp [bgP]

theorem take_app_full {S T : Shape} {n : ℕ} (hS : S.length = n) (hT : T.length = n) :
    T.take n ++ S.drop n = T := by
  rw [List.take_of_length_le (by omega), List.drop_of_length_le (by omega), List.append_nil]

end NLogN.KFU

end

