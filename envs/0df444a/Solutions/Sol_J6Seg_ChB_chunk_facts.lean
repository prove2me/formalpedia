      2 ^ axpk6 P n src k ap ∧
    axpk6 P n src k ap + 1 ≤ axwd6 P n src k ap := by
  obtain ⟨c1, c2, c3, c4⟩ := hc
  set Q := axQ6 P n src k with hQ
  set R := axR6 P n with hR
  have hl : Nat.log 2 (lamF (axd6 P n)) < Q := Val.log_lam_lt_Q _ _ _
  have h7 : 7 * (R + 2) ≤ Q + 13 := Val.sevenR_le_Q (axp6 P n) (axd6 P n) (axs6 src k)
  have hlam : axl6 P n + 1 ≤ 2 ^ Q := by
    have : axl6 P n < 2 ^ Q := by
      unfold axl6 lamP; exact Nat.pow_lt_pow_right (by norm_num) hl
    omega
  have hpk : axpk6 P n src k ap = ap.pl.pkA * Q + ap.pl.pkC := rfl
