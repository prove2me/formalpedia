section

noncomputable section

namespace CoarseAssembly.Rips

open Analytic DiscreteRoe

variable {Q : ℕ → Type} [∀ i, MetricSpace (Q i)] [∀ i, Fintype (Q i)]
  [∀ i, DecidableEq (Q i)] {r : ℝ}


def regularizedFamily (c : ∀ i, OAI.CoarseAssembly.Analytic.OddCycle C(OAI.CoarseAssembly.Rips.Point (Q i) r, ℂ))
    (χ : ∀ i, C(OAI.CoarseAssembly.Rips.Point (Q i) r, ℂ) →⋆ₐ[ℂ] ℂ) : OAI.CoarseAssembly.Rips.ControlledCycleFamily Q r := by
  classical
  have OAI.CoarseAssembly.Analytic.cutDown_selfAdjoint {A : Type} [inst_local_1 : CStarAlgebra A] (c : OAI.CoarseAssembly.Analytic.OddCycle A) : IsSelfAdjoint c.cutDown.operator  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      rw [((
      let local_proof {A : Type} [inst_local_1 : CStarAlgebra A] (c : OAI.CoarseAssembly.Analytic.OddCycle A) :
          c.cutDown.operator = OAI.CoarseAssembly.Analytic.symmetricCutDown (c.representation 1) c.operator :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            change c.operator + (OAI.CoarseAssembly.Analytic.symmetricCutDown (c.representation 1) c.operator - c.operator) = _
            abel
      local_proof) c)]
      exact (
      let local_proof {H : OAI.CoarseAssembly.Analytic.HilbertSpace} (P F : OAI.CoarseAssembly.Analytic.End H) (hP : IsSelfAdjoint P) :
          IsSelfAdjoint (OAI.CoarseAssembly.Analytic.symmetricCutDown P F) :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            change star ((1 / 2 : ℝ) • (P * F * P + star (P * F * P)) + (1 - P)) = _
            rw [star_add, star_smul, star_trivial, star_add, star_star, star_sub, star_one, hP.star_eq]
            rw [add_comm (star (P * F * P))]
            rfl
      local_proof) _ _ ((
      let local_proof {A : Type} [inst_local_1 : CStarAlgebra A] (c : OAI.CoarseAssembly.Analytic.OddCycle A) :
          IsSelfAdjoint (c.representation 1) :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            change star (c.representation 1) = c.representation 1
            rw [← map_star, star_one]
      local_proof) c)
  have OAI.CoarseAssembly.Analytic.cutDown_complement {A : Type} [inst_local_1 : CStarAlgebra A] (c : OAI.CoarseAssembly.Analytic.OddCycle A) :
      c.cutDown.operator * (1 - c.cutDown.representation 1) = 1 - c.cutDown.representation 1  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      change (c.operator + OAI.CoarseAssembly.Analytic.representedCorrection c) * (1 - c.representation 1) = 1 - c.representation 1
      have he : c.operator + OAI.CoarseAssembly.Analytic.representedCorrection c =
          OAI.CoarseAssembly.Analytic.symmetricCutDown (c.representation 1) c.operator := by unfold OAI.CoarseAssembly.Analytic.representedCorrection; abel
      rw [he]
      exact (
      let local_proof {H : OAI.CoarseAssembly.Analytic.HilbertSpace} (P F : OAI.CoarseAssembly.Analytic.End H) (hP : IsSelfAdjoint P)
          (hPP : P * P = P) : OAI.CoarseAssembly.Analytic.symmetricCutDown P F * (1 - P) = 1 - P :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            have hzero : ∀ T : OAI.CoarseAssembly.Analytic.End H, P * T * P * (1 - P) = 0 := by
              intro T
              rw [mul_sub, mul_one, mul_assoc (P * T) P P, hPP, sub_self]
            have hQ : (1 - P) * (1 - P) = 1 - P := by
              calc
