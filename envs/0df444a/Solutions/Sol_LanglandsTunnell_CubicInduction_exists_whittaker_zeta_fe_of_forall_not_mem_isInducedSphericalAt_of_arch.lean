variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) {Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ}
  {S : Finset (HeightOneSpectrum (𝓞 ℚ))}
  (hone : ∀ v, v ∉ S → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)

include hone in

private theorem continuous_adelicProduct (hWarch : Continuous Warch)
    (hinv : ∀ v : HeightOneSpectrum (𝓞 ℚ), ∃ U : Subgroup (LocalGL3 v),
      IsOpen (U : Set (LocalGL3 v)) ∧ IsRightInvariant U (Wloc v)) :
    Continuous (adelicProduct Warch Wloc) := by
  classical
  have hcont : ∀ v : HeightOneSpectrum (𝓞 ℚ), Continuous (Wloc v) := fun v => by
    obtain ⟨U, hU, hWU⟩ := hinv v
    exact continuous_of_isOpen_of_isRightInvariant hU hWU
  rw [continuous_iff_continuousAt]
  intro g₀
  set T : Finset (HeightOneSpectrum (𝓞 ℚ)) :=
    S ∪ (LocalFactorEmbedding.finite_setOf_not_mem_localMaximalCompact3 g₀).toFinset with hT
  have hST : S ⊆ T := Finset.subset_union_left
  have hg₀ : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g₀ ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
    intro v hv
    by_contra hbad
    exact hv (Finset.mem_union_right _
      ((LocalFactorEmbedding.finite_setOf_not_mem_localMaximalCompact3 g₀).mem_toFinset.2 hbad))
  have hF : Continuous fun g : AdelicGL 3 (𝓞 ℚ) ℚ =>
      Warch (archComponent3 (𝓞 ℚ) ℚ g) * ∏ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v g) :=
    (hWarch.comp continuous_archComponent3).mul
      (continuous_finsetProd T fun v _ => (hcont v).comp (continuous_componentAt3 v))
  refine hF.continuousAt.congr ?_
  have hmem : g₀ • integralSet ∈ nhds g₀ :=
    (isOpen_integralSet.smul g₀).mem_nhds ⟨1, one_mem_integralSet, mul_one g₀⟩
  filter_upwards [hmem] with g hg
  obtain ⟨h, hh, rfl⟩ := hg
  refine (adelicProduct_eq_prod Warch hone _ T hST fun v hv => ?_).symm
  show componentAt3 (𝓞 ℚ) ℚ v (g₀ * h) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v
  rw [map_mul]
  exact Subgroup.mul_mem _ (hg₀ v hv) (hh v)

end LocalFactorProduct
