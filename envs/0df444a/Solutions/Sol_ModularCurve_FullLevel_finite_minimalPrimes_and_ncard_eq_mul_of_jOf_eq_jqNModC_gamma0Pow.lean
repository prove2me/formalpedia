    exact ((Algebra.TensorProduct.tensorQuotientEquiv (R := ↥S) F P₀.B₀ F 𝔭x).toLinearEquiv.finrank_eq).symm

  have hcount : Fintype.card ((ZMod ℓ)ˣ × (ZMod q)ˣ) * Module.finrank F (R ⧸ 𝔓x) = Module.finrank F R := by
    have hqprime : q.Prime := Fact.out
