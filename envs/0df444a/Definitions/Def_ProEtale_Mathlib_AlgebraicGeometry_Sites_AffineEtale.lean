-- title:
--   The small affine étale site: covering sieves from étale coverings, its Zariski topology, and surjective maps as covers
-- statement:
--   Let $S$ be a scheme and $S_{\text{affét}}$ the small affine étale site: affine schemes étale over $S$, with the topology induced from the étale topology. Let $\iota : S_{\text{affét}} \to \mathrm{Sch}$ be the forgetful functor to schemes.
--
--   Definitions: the forgetful functor $\iota$; and the **Zariski topology** on $S_{\text{affét}}$, the Grothendieck topology generated by pulling back along $\iota$ the precoverage of Zariski coverings (jointly surjective families of open immersions).
--
--   Principal results:
--   1. If $R$ is a sieve on an object $X$ such that its image under $\iota$ is a covering sieve of $\iota(X)$ for the étale topology, then $R$ is a covering sieve of $X$ in the affine étale topology.
--   2. The Zariski topology on $S_{\text{affét}}$ is coarser than the affine étale topology.
--   3. For a morphism $f : X \to Y$ in $S_{\text{affét}}$ whose underlying map of topological spaces is surjective, the sieve generated by $f$ is a covering sieve of $Y$.
--
--   These are used when comparing sheaves on the affine étale and affine pro-étale sites.
--
--   **Formalization Note** Declarations in `AlgebraicGeometry.Scheme.AffineEtale`: `toScheme S` (defined as `AffineEtale.Spec _ ⋙ Etale.forget _ ⋙ Over.forget _`), `mem_topology_of_functorPushforward_mem`, `zariskiTopology S` (defined as `(Precoverage.comap (toScheme S) zariskiPrecoverage).toGrothendieck`), `zariskiTopology_le_topology` and `generate_singleton_mem_topology`. As the docstring notes, only one direction of the comparison in (1) is proved, because Mathlib defines the site via `restrictedTopology`.
-- source:
--   B. Bhatt, P. Scholze, The pro-étale topology for schemes, https://arxiv.org/abs/1309.1198 (v2, 17 Dec 2014). Lean source: idealson-nexources/proetale (fork of chrisflav/proetale by C. Merten, J. Jiang and contributors, Apache-2.0), commit 2983805, file Proetale/Mathlib/AlgebraicGeometry/Sites/AffineEtale.lean (declarations needed by the transplanted proofs, unused ones removed).

import Mathlib.AlgebraicGeometry.Sites.AffineEtale
import Mathlib.CategoryTheory.Sites.Sieves
import Definitions.Def_ProEtale_Mathlib_CategoryTheory_Sites_Sieves

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
set_option relaxedAutoImplicit false
universe u

open CategoryTheory Limits

namespace AlgebraicGeometry
namespace Scheme

namespace AffineEtale

variable (S : Scheme.{u})

noncomputable
abbrev toScheme : S.AffineEtale ⥤ Scheme :=
  AffineEtale.Spec _ ⋙ Etale.forget _ ⋙ Over.forget _

variable {S} in
/-- A sieve whose image in `Sch` is an étale covering is covering for the affine étale topology.
(With Mathlib's `restrictedTopology` definition of the small étale site, only this direction is
immediate; it is the only one used.) -/
lemma mem_topology_of_functorPushforward_mem {X : S.AffineEtale} (R : Sieve X)
    (h : Sieve.functorPushforward (toScheme S) R ∈ etaleTopology ((toScheme S).obj X)) :
    R ∈ topology S X := by
  rw [Sieve.functorPushforward_comp, Sieve.functorPushforward_comp] at h
  refine (Functor.functorPushforward_mem_iff (G := AffineEtale.Spec S) (J := topology S)
    (K := S.smallEtaleTopology)).1 ?_
  apply Functor.mem_restrictedTopology_of_functorPushforward_mem
  rw [GrothendieckTopology.mem_over_iff]
  exact h

-- TODO: When the Zariski topology on `CommRingCatᵒᵖ` lands, consider refactoring this.
noncomputable
def zariskiTopology : GrothendieckTopology S.AffineEtale :=
  (Precoverage.comap (toScheme S) zariskiPrecoverage).toGrothendieck

/-- The Zariski topology on the small affine étale site of `S` is coarser than the affine étale
topology, since a Zariski cover consists of open immersions, which are étale. -/
lemma zariskiTopology_le_topology : zariskiTopology S ≤ topology S := by
  rw [zariskiTopology, Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
  intro X R hR
  rw [Precoverage.mem_comap_iff] at hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  apply mem_topology_of_functorPushforward_mem
  rw [← Sieve.generate_map_eq_functorPushforward]
  -- Open immersions are étale, so a Zariski cover is an étale cover.
  have hle : @IsOpenImmersion ≤ @Etale := fun _ _ _ _ ↦ inferInstance
  exact Precoverage.generate_mem_toGrothendieck (precoverage_mono hle _ hR)

/-- A single surjective (étale) morphism is a cover in the small affine étale site. -/
lemma generate_singleton_mem_topology {X Y : S.AffineEtale} (f : X ⟶ Y)
    (hf : Function.Surjective ((toScheme S).map f).base) :
    Sieve.generate (Presieve.singleton f) ∈ topology S Y := by
  have het : Etale ((toScheme S).map f) := by
    refine MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) ((toScheme S).map f)
      ((AffineEtale.Spec S).obj Y).hom ((AffineEtale.Spec S).obj Y).prop ?_
    have w := MorphismProperty.Over.w ((AffineEtale.Spec S).map f)
    dsimp at w
    change Etale (Spec.map f.left.unop ≫ Y.hom)
    rw [w]
    exact X.prop
  have : Sieve.generate ((Presieve.singleton f).map (toScheme S)) ∈
      grothendieckTopology @Etale ((toScheme S).obj Y) := by
    refine Precoverage.generate_mem_toGrothendieck ?_
    rw [Presieve.map_singleton, singleton_mem_precoverage_iff]
    exact ⟨hf, het⟩
  apply mem_topology_of_functorPushforward_mem
  rwa [← Sieve.generate_map_eq_functorPushforward]

end AffineEtale

end Scheme
end AlgebraicGeometry


