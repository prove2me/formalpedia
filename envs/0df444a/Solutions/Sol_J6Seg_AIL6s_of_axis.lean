set_option maxHeartbeats 1000000 in
/-- **`AIL6s` from the per-axis `A` program and the `GB` invariant.** -/
theorem AIL6s_of_axis_sol_aux (P : Prm) (hP : P.Ok) (tab : Fin 1 → IStmt HS 1) (hX : AxisUA6 P tab)
    (hG : PipeGBA6 P) : AIL6s P tab := by
  obtain ⟨nU, U, eX, dA, CX, AX, nX, hdA, hCX, HX⟩ := hX
  obtain ⟨nG, HG⟩ := hG
  obtain ⟨nQ, hq⟩ := qok_of P hP
