    (top_encK g1PX) (isInt_encK (by rw [e1 _ (by decide), grP])) (top_encK (by rw [e1 _ (by decide), grP]))
    (isInt_encK (by rw [e1 _ (by decide), grP1])) (top_encK (by rw [e1 _ (by decide), grP1]))
    (by omega) hPB
  have hsum : dotF P (cs.take (k + 1)) acc = dotF P (cs.take k) acc + J6Seg.rs P (c * a) := by
    rw [dotF_take_succ P cs acc hk]
    simp only [J6Seg.fmul, List.getD_eq_getElem _ _ hk', hcv, hav]
