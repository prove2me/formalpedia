theorem one_le_W {W : ℕ} (h : 32 ≤ 2 ^ W) : |(1 : ℤ)| ≤ 2 ^ W := by
  simp; exact one_le_pow₀ (by norm_num)

theorem zero_le_W {W : ℕ} : |(0 : ℤ)| ≤ 2 ^ W := by simp

theorem nA2 : (2 : ℤ).natAbs = 2 := rfl

theorem nA1 : (1 : ℤ).natAbs = 1 := rfl
theorem nA0 : (0 : ℤ).natAbs = 0 := rfl

/-! ## The pushes and the first assignments -/

/-! ## The powers of two -/

/-! ## The `aHdr2` constants -/

theorem clog_le_self' (r : ℕ) : Nat.clog 2 r ≤ r :=
  Nat.clog_le_of_le_pow Nat.lt_two_pow_self.le

theorem pow_clog_le (r : ℕ) (hr : 2 ≤ r) : 2 ^ Nat.clog 2 r ≤ 2 * r := by
  have h1 := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (x := r) (by omega)
  have h2 := Nat.clog_pos (b := 2) (by norm_num) (n := r) (by omega)
  obtain ⟨c, hc⟩ : ∃ c, Nat.clog 2 r = c + 1 :=
    ⟨(Nat.clog 2 r).pred, (Nat.succ_pred_eq_of_pos h2).symm⟩
  simp only [hc, Nat.pred_eq_sub_one, Nat.add_sub_cancel] at h1
  rw [hc, pow_succ]; omega

theorem upd4 (u : Vr) (m y X Y : ℤ) :
    update (update (update (update u 22 m) 26 y) 22 X) 26 Y = update (update u 22 X) 26 Y := by
  rw [update_comm (show (26 : Fin HS) ≠ 22 by decide), update_idem, update_idem]

/-- One step of the `clog` loop. -/
theorem clg_step (u0 : Vr) (r k : ℕ) (h24 : u0 24 = r) :
    eClC.den (update (update u0 22 ((min k (Nat.clog 2 r) : ℕ) : ℤ)) 26
        ((2 ^ min k (Nat.clog 2 r) : ℕ) : ℤ)) = ((min (k + 1) (Nat.clog 2 r) : ℕ) : ℤ) ∧
    eClY.den (update (update (update u0 22 ((min k (Nat.clog 2 r) : ℕ) : ℤ)) 26
        ((2 ^ min k (Nat.clog 2 r) : ℕ) : ℤ)) 22 ((min (k + 1) (Nat.clog 2 r) : ℕ) : ℤ)) =
      ((2 ^ min (k + 1) (Nat.clog 2 r) : ℕ) : ℤ) := by
  have g24 : ∀ (x y z : ℤ), update (update (update u0 22 x) 26 y) 22 z 24 = r := fun x y z => by
    simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact h24
  have g24' : ∀ (x y : ℤ), update (update u0 22 x) 26 y 24 = r := fun x y => by
    simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact h24
  have g26 : ∀ (x y z : ℤ), update (update (update u0 22 x) 26 y) 22 z 26 = y := fun x y z => by
    rw [update_of_ne (by decide), update_self]
  have g22 : ∀ (x y : ℤ), update (update u0 22 x) 26 y 22 = x := fun x y => by
    rw [update_of_ne (by decide), update_self]
  by_cases hk : k < Nat.clog 2 r
  · have hp : 2 ^ k < r := Nat.pow_lt_of_lt_clog hk
    rw [Nat.min_eq_left hk.le, Nat.min_eq_left (by omega : k + 1 ≤ Nat.clog 2 r)]
    have hz : ((2 ^ k : ℕ) : ℤ) - (r : ℤ) < 0 := by
      have : ((2 ^ k : ℕ) : ℤ) < (r : ℤ) := by exact_mod_cast hp
      linarith
    refine ⟨?_, ?_⟩
    · simp only [eClC, E.den, update_self, g24', g22, if_pos hz]; push_cast; ring
    · simp only [eClY, E.den, g26, g24, if_pos hz]; push_cast; ring
  · push_neg at hk
    have hp : r ≤ 2 ^ Nat.clog 2 r := Nat.le_pow_clog (by norm_num) r
    rw [Nat.min_eq_right hk, Nat.min_eq_right (by omega : Nat.clog 2 r ≤ k + 1)]
    have hz : ¬ ((2 ^ Nat.clog 2 r : ℕ) : ℤ) - (r : ℤ) < 0 := by
      have : (r : ℤ) ≤ ((2 ^ Nat.clog 2 r : ℕ) : ℤ) := by exact_mod_cast hp
      linarith
    refine ⟨?_, ?_⟩
    · simp only [eClC, E.den, update_self, g24', g22, if_neg hz]
    · simp only [eClY, E.den, g26, g24, if_neg hz]

