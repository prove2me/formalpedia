include hys1 hys2 in
/-- **The abstract `LiftT` tail.** -/
theorem g_main [IsFinite π] (hρf : IsFinite ρ') (hρs : Function.Surjective ρ') (e' : Yx ⟶ pullback π ι)
    (y : Yx ⟶ YV) (e : pullback π ι ⟶ Yx) (he : e ≫ e' = 𝟙 _) (hsq : ys ≫ κ = e ≫ y)
    (tq : Tl ⟶ pullback π ι) (ψ' : pullback ρ' y ⟶ pullback tq e')
    (hψ' : ψ' ≫ pullback.snd tq e' = pullback.snd ρ' y) :
    ∃ (Φ : U' ⟶ P') (_ : IsFinite Φ) (h : U' ⟶ Y) (hh : h ≫ π = Φ ≫ f)
      (_ : Function.Surjective ⇑(pullback.lift Φ h hh.symm : U' ⟶ pullback f π))
