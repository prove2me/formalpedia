section Borel

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

private theorem borelSndUnit_eq_expR {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    borelSndUnit hg u = expR (Real.log (rad gm u)) :=
  Units.ext (by simp [Real.exp_log (rad_pos hg u)])

private theorem borelFstUnit_eq {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    borelFstUnit hg u = Units.mk0 (-gm.det) (neg_ne_zero.2 hg) * expR (-Real.log (rad gm u)) := by
  rw [expR_neg]
  apply Units.ext
  simp [Real.exp_log (rad_pos hg u), div_eq_mul_inv]

private theorem charFactor_eq (χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ) {gm : Matrix (Fin 2) (Fin 2) ℝ}
    (hg : gm.det ≠ 0) (u : ℝ) :
    ((χ₁ (realIdeleAt hw (borelFstUnit hg u)) : ℂˣ) : ℂ) * ((χ₂ (realIdeleAt hw (borelSndUnit hg u)) : ℂˣ) : ℂ)
      = ((χ₁ (realIdeleAt hw (Units.mk0 (-gm.det) (neg_ne_zero.2 hg))) : ℂˣ) : ℂ)
          * psiW hw χ₁ χ₂ (Real.log (rad gm u)) := by
  rw [borelFstUnit_eq, borelSndUnit_eq_expR hg, map_mul, map_mul, Units.val_mul, psiW, mul_assoc]

private def gOf (x : AdelicGL2 (𝓞 F) F) : Matrix (Fin 2) (Fin 2) ℝ :=
  ((toRealGL hw (archComponent F w (glArch (𝓞 F) F x)) : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ)

private theorem gOf_det_ne_zero (x : AdelicGL2 (𝓞 F) F) : (gOf hw x).det ≠ 0 := det_toRealGL_ne_zero hw _

private theorem continuous_toRealGL_archComponent :
    Continuous fun x : AdelicGL2 (𝓞 F) F => toRealGL hw (archComponent F w (glArch (𝓞 F) F x)) :=
  (continuous_toRealGL hw).comp ((continuous_archComponent F w).comp (continuous_glArch (𝓞 F) F))

private def detUnit (x : AdelicGL2 (𝓞 F) F) : ℝˣ := Units.mk0 (-(gOf hw x).det) (neg_ne_zero.2 (gOf_det_ne_zero hw x))

@[scoped simp] private theorem coe_detUnit (x : AdelicGL2 (𝓞 F) F) : (detUnit hw x : ℝ) = -(gOf hw x).det := rfl

end Borel
