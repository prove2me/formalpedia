import Theorems.Thm_ShorIrreducible_cutPeriod_pos
import Theorems.Thm_ShorIrreducible_natCast_mul_congr_of_modEq

/-! # The exact bond dimension of the comb at an arbitrary cut

`ShorCombState` shows that the periodic comb has Schmidt rank exactly `r` across
a cut whose block size `B` is coprime to `r`, and rank `1` when `r ∣ B`.  This
file proves the **sharp interpolating formula** covering every cut of a register
whose low half is at least as long as the period:

`schmidtRank (comb across the cut) = min C (r / gcd r B)`,

where `B` is the block size (the size of the low half), `C` the number of blocks
(the size of the high half) and `r` the order.  The arithmetic content is that
the high-half labels `c ↦ x₀ - B·c (mod r)` sweep out the cyclic subgroup
generated by `B` in `ℤ/r`, of index `gcd(r, B)`, and do so with period
`r / gcd(r, B)`.

Consequences:

* `schmidtRank_combCut_sharp` : the exact formula;
* `schmidtRank_combCut_eq_of_coprime` : the coprime case recovers rank `r`;
* `schmidtRank_combCut_of_dvd` : `r ∣ B` collapses the rank to `1`;
* `bondDim_combCut_sharp_ge` : the corresponding exact bond-dimension threshold.

The formula shows precisely where a tensor-train emulation could be cheap: only
when `gcd(r, B)` is large, i.e. when the block size already almost resolves the
period — which for a power-of-two register means `r` has a large power-of-two
part, the classically easy case.
-/

open Finset

open ShorIrreducible

open IITTensorNetwork


variable {B C r x0 : ℕ} [NeZero r] {amp : ℝ}




omit [NeZero r] in
/-- Conversely, multiplication by `B` is injective modulo the period. -/
lemma modEq_of_natCast_mul_eq (hr : 0 < r) {c c' : ℕ}
    (h : ((B * c : ℕ) : ZMod r) = ((B * c' : ℕ) : ZMod r)) : c ≡ c' [MOD cutPeriod r B] := by
  have h' : B * c ≡ B * c' [MOD r] := (ZMod.natCast_eq_natCast_iff _ _ _).mp h
  exact Nat.ModEq.cancel_left_div_gcd hr h'












open ShorIrreducible in
omit [NeZero r] in
theorem solution(hr : 0 < r) :
    ((Finset.range C).image (combLabel B r x0)).card = min C (cutPeriod r B) := by
  classical
  set s := cutPeriod r B with hs
  set D := min C s with hD
  have hspos : 0 < s := cutPeriod_pos hr
  have hcong : ∀ c c' : ℕ, c ≡ c' [MOD s] → combLabel B r x0 c = combLabel B r x0 c' := by
    intro c c' h
    rw [combLabel, combLabel, natCast_mul_congr_of_modEq h]
  have hrange : (Finset.range C).image (combLabel B r x0)
      = (Finset.range D).image (combLabel B r x0) := by
    apply Finset.Subset.antisymm
    · intro z hz
      obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hz
      rw [Finset.mem_range] at hc
      refine Finset.mem_image.mpr ⟨c % s, ?_, ?_⟩
      · rw [Finset.mem_range, hD, lt_min_iff]
        exact ⟨lt_of_le_of_lt (Nat.mod_le c s) hc, Nat.mod_lt _ hspos⟩
      · exact (hcong c (c % s) (Nat.ModEq.symm (Nat.mod_modEq c s))).symm
    · intro z hz
      obtain ⟨c, hc, rfl⟩ := Finset.mem_image.mp hz
      rw [Finset.mem_range] at hc
      exact Finset.mem_image.mpr ⟨c, Finset.mem_range.mpr (lt_of_lt_of_le hc (min_le_left _ _)), rfl⟩
  have hinj : Set.InjOn (combLabel B r x0) (Finset.range D) := by
    intro c hc c' hc' h
    rw [Finset.coe_range, Set.mem_Iio] at hc hc'
    have hcs : c < s := lt_of_lt_of_le hc (min_le_right _ _)
    have hcs' : c' < s := lt_of_lt_of_le hc' (min_le_right _ _)
    rw [combLabel, combLabel, sub_right_inj] at h
    have := modEq_of_natCast_mul_eq hr h
    rw [Nat.ModEq, Nat.mod_eq_of_lt hcs, Nat.mod_eq_of_lt hcs'] at this
    exact this
  rw [hrange, Finset.card_image_of_injOn hinj, Finset.card_range]
