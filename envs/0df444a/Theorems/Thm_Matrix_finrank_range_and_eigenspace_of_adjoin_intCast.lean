-- title:
--   Descent of idempotent-image and eigenspace ranks to a PID
-- statement:
--   Let $\iota$ be any index type, let $n,d$ be natural numbers and let $M \colon \iota \to M_n(\mathbb{Z})$ be a family of integer matrices; for a commutative ring $R$ write $A_R$ for the $R$-subalgebra `Algebra.adjoin` of $M_n(R)$ generated by the entrywise images of the $M_i$ under $\mathbb{Z} \to R$. Two hypotheses are imposed over $\mathbb{C}$: first, there exist vectors $v_1,\dots,v_d \in \mathbb{C}^n$ such that the map $(c_1,\dots,c_d) \mapsto \sum_k c_k v_k$ from $A_{\mathbb{C}}^{\,d}$ to $\mathbb{C}^n$, where $c_k v_k$ means the matrix $c_k$ applied to $v_k$ by `mulVec`, is bijective; second, for every $\mathbb{C}$-algebra homomorphism $\chi \colon A_{\mathbb{C}} \to \mathbb{C}$ the simultaneous eigenspace $\bigcap_{a \in A_{\mathbb{C}}} \ker(a - \chi(a))$ in $\mathbb{C}^n$ has $\mathbb{C}$-dimension $d$. Let $\mathcal{O}$ be a principal ideal domain of characteristic zero. The conclusion is the conjunction of: (1) for every idempotent matrix $\varepsilon \in A_{\mathcal{O}}$, the $\mathcal{O}$-rank of the image of $\varepsilon$ acting on $\mathcal{O}^n$ equals $d$ times the $\mathcal{O}$-rank of $\varepsilon A_{\mathcal{O}}$, the image of left multiplication by $\varepsilon$ on $A_{\mathcal{O}}$ viewed inside $M_n(\mathcal{O})$; and (2) for every $\mathcal{O}$-algebra homomorphism $\lambda \colon A_{\mathcal{O}} \to \mathcal{O}$, the simultaneous eigenspace $\bigcap_{a \in A_{\mathcal{O}}} \ker(a - \lambda(a))$ in $\mathcal{O}^n$ has $\mathcal{O}$-rank $d$.
--
--   This is a descent statement for a commutative algebra of matrices defined over $\mathbb{Z}$: multiplicity and freeness information available over $\mathbb{C}$ is transported to every characteristic-zero principal ideal domain, in the form of rank identities for images of idempotents and for simultaneous eigenspaces of $\mathcal{O}$-valued characters. It is used in the computation of the ranks of corner submodules of the relevant first cohomology group in the non-Eisenstein case.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Matrix_finrank_range_and_eigenspace_of_adjoin_intCast.lean

import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.Analysis.Complex.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

theorem Matrix.finrank_range_and_eigenspace_of_adjoin_intCast
    {ι : Type*} (n d : ℕ) (M : ι → Matrix (Fin n) (Fin n) ℤ)
    (hfree : ∃ v : Fin d → (Fin n → ℂ), Function.Bijective
      (fun c : Fin d → ↥(Algebra.adjoin ℂ (Set.range fun i => (M i).map (Int.cast : ℤ → ℂ))) =>
        ∑ k, ((c k : Matrix (Fin n) (Fin n) ℂ).mulVec (v k))))
    (hmult : ∀ χ : ↥(Algebra.adjoin ℂ (Set.range fun i => (M i).map (Int.cast : ℤ → ℂ))) →ₐ[ℂ] ℂ,
      Module.finrank ℂ ↥(⨅ a : ↥(Algebra.adjoin ℂ (Set.range fun i => (M i).map (Int.cast : ℤ → ℂ))),
        Module.End.eigenspace (Matrix.toLin' (a : Matrix (Fin n) (Fin n) ℂ)) (χ a)) = d)
    (𝒪 : Type*) [CommRing 𝒪] [IsDomain 𝒪] [IsPrincipalIdealRing 𝒪] [CharZero 𝒪] :
    (∀ ε ∈ Algebra.adjoin 𝒪 (Set.range fun i => (M i).map (Int.cast : ℤ → 𝒪)),
      IsIdempotentElem ε →
        Module.finrank 𝒪 ↥(LinearMap.range (Matrix.toLin' ε)) =
          d * Module.finrank 𝒪 ↥(LinearMap.range (LinearMap.mulLeft 𝒪 ε ∘ₗ
            (Algebra.adjoin 𝒪 (Set.range fun i => (M i).map (Int.cast : ℤ → 𝒪))).val.toLinearMap))) ∧
    ∀ lam : ↥(Algebra.adjoin 𝒪 (Set.range fun i => (M i).map (Int.cast : ℤ → 𝒪))) →ₐ[𝒪] 𝒪,
      Module.finrank 𝒪 ↥(⨅ a : ↥(Algebra.adjoin 𝒪 (Set.range fun i => (M i).map (Int.cast : ℤ → 𝒪))),
        Module.End.eigenspace (Matrix.toLin' (a : Matrix (Fin n) (Fin n) 𝒪)) (lam a)) = d := by sorry
