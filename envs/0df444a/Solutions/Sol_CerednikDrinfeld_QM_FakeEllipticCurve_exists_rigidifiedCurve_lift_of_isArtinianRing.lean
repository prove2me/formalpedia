theorem GPoint.pt_eq_of_mk_eq {𝒪 : Type} [CommRing 𝒪] {r : ℕ} [Fact r.Prime] {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
    {M : ModuliPackage.{0, 0} r Onr} {B : Type} [CommRing B] [Algebra 𝒪 B]
    {ψ : Onr →ₐ[𝒪] B} {n₁ n₂ : IsNilpotent ((r : ℕ) : B)}
    {p₁ : M.obj B (ψ : Onr →+* B) n₁} {p₂ : M.obj B (ψ : Onr →+* B) n₂}
    (h : (⟨ψ, n₁, p₁⟩ : ModuliPackage.GPoint 𝒪 M B) = ⟨ψ, n₂, p₂⟩) : p₁ = p₂ := by
  cases h
  rfl

theorem module_match
    {r N : ℕ} [Fact r.Prime]
    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪)
    (Onr : Type) [CommRing Onr] [Nontrivial Onr] [Algebra 𝒪 Onr] (Fr : Onr ≃ₐ[𝒪] Onr)
    (hOnr_closed : ∀ p : Polynomial Onr, p.Monic → 0 < p.natDegree → ∃ x : Onr, Polynomial.eval x p ∈ Ideal.span {algebraMap 𝒪 Onr π})
    (hFr : ∀ x : Onr, Fr x - x ^ r ∈ Ideal.span {algebraMap 𝒪 Onr π})
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b])
    (coord : ↥Λ → Zp2 r × Zp2 r)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2)
    (ι : Zp2 r →+* Onr)
    (Φ : FormalODModule r (Onr ⧸ pIdeal r Onr))
    (M : ModuliPackage.{0, 0} r Onr)
    (η : ∀ (B : Type) [CommRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B)),
      Rigidified r Φ B → M.obj B ψ hB)
    (hη1 : ∀ (B : Type) [CommRing B] [IsNoetherianRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B))
          (t t' : Rigidified r Φ B), t.IsAdmissible ι ψ → t'.IsAdmissible ι ψ →
          (η B ψ hB t = η B ψ hB t' ↔ t.IsIsomorphic t'))
    (hη2 : ∀ (B B' : Type) [CommRing B] [CommRing B'] [IsNoetherianRing B] [IsNoetherianRing B'] (ψ : Onr →+* B) (ψ' : Onr →+* B')
          (hB : IsNilpotent (r : B)) (hB' : IsNilpotent (r : B')) (f : B →+* B')
          (hf : f.comp ψ = ψ') (t : Rigidified r Φ B), t.IsAdmissible ι ψ →
          η B' ψ' hB' (t.map f) = M.map hB hB' f hf (η B ψ hB t))
    (κbr : (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) →+* (Onr ⧸ pIdeal r Onr))
    (β₀ : Series (Onr ⧸ pIdeal r Onr))
    (Ξ : ∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B),
        IsNilpotent (algebraMap 𝒪 B π) → FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ → ModuliPackage.GPoint 𝒪 M B)
    (hΞdef :
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) (hB : IsNilpotent (algebraMap 𝒪 B π))
          (hconn : ∀ e : B, IsIdempotentElem e → e = 0 ∨ e = 1)
          (hBr : IsNilpotent ((r : ℕ) : B))
          (x : FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ) (X : FormalODModule r B) (θ : RelativeGroupLaw.FormalCoordinates x.1.f 2),
          x.1.IsFormalModuleVia coord X θ →
          ∃ (j : ℕ) (t : Rigidified r Φ B), j ≤ 1 ∧ t.X = X ∧
            FakeEllipticCurve.Rigidification.IsRigTransport θ₀ κbr β₀ x.2 θ j t ∧
            t.IsAdmissible ι ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] B) : Onr →+* B) ∧
            Ξ B ψ hB x = ⟨frobTwist Onr Fr (-(j : ℤ)) ψ, hBr, η B ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] B) : Onr →+* B) hBr t⟩))

    (A : Type) [CommRing A] [IsNoetherianRing A] [Algebra 𝒪 A]
    (κ : Type) [Field κ] [Algebra 𝒪 κ] (hκ : IsNilpotent (algebraMap 𝒪 κ π))
    (qκ : A →ₐ[𝒪] κ) (ψ : Onr →ₐ[𝒪] A)

    (x₀ : FakeEllipticCurve.RigidifiedCurve r π A₀ κ (qκ.comp ψ)) (y : ModuliPackage.GPoint 𝒪 M A)
    (hleg : ∃ k : ℤ, y.ψ = frobTwist Onr Fr k ψ)
    (hΞ : Ξ κ (qκ.comp ψ) hκ x₀ = y.map qκ)
    (t : Rigidified r Φ A) (htadm : t.IsAdmissible ι (y.ψ : Onr →+* A)) (hηt : η A (y.ψ : Onr →+* A) y.nilp t = y.pt)

    (X₀κ : FormalODModule r κ) (θ₀κ : RelativeGroupLaw.FormalCoordinates x₀.1.f 2) (hx₀ : x₀.1.IsFormalModuleVia coord X₀κ θ₀κ) :
    ∃ (j₀ : ℕ) (t₀ : Rigidified r Φ κ), j₀ ≤ 1 ∧ t₀.X = X₀κ ∧
      FakeEllipticCurve.Rigidification.IsRigTransport θ₀ κbr β₀ x₀.2 θ₀κ j₀ t₀ ∧
      t₀.IsAdmissible ι ((frobTwist Onr Fr (-(j₀ : ℤ)) (qκ.comp ψ) : Onr →ₐ[𝒪] κ) : Onr →+* κ) ∧
      y.ψ = frobTwist Onr Fr (-(j₀ : ℤ)) ψ ∧
      t₀.IsIsomorphic (t.map (qκ : A →+* κ)) := by

  have hconnκ : ∀ e : κ, IsIdempotentElem e → e = 0 ∨ e = 1 := fun e he => IsIdempotentElem.iff_eq_zero_or_one.mp he
  have hκr : IsNilpotent ((r : ℕ) : κ) := (y.map qκ).nilp

  obtain ⟨j₀, t₀, hj₀, ht₀X, htr₀, hadm₀, hΞeq⟩ := hΞdef κ (qκ.comp ψ) hκ hconnκ hκr x₀ X₀κ θ₀κ hx₀
  have G : y.map qκ = ⟨frobTwist Onr Fr (-(j₀ : ℤ)) (qκ.comp ψ), hκr,
      η κ ((frobTwist Onr Fr (-(j₀ : ℤ)) (qκ.comp ψ) : Onr →ₐ[𝒪] κ) : Onr →+* κ) hκr t₀⟩ := hΞ.symm.trans hΞeq

  have hlegκ : (y.map qκ).ψ = frobTwist Onr Fr (-(j₀ : ℤ)) (qκ.comp ψ) := by
    have := congrArg ModuliPackage.GPoint.ψ G
    simpa using this
  obtain ⟨k, hk⟩ := hleg
  have hkj : (-(j₀ : ℤ)) = k :=
    ModuliPackage.GPoint.eq_of_eq_map_of_leg_eq_frobTwist π Onr Fr hOnr_closed hFr ψ qκ hκ y (y.map qκ) rfl
      k (-(j₀ : ℤ)) hk hlegκ
  have hyψ : y.ψ = frobTwist Onr Fr (-(j₀ : ℤ)) ψ := by rw [hk, ← hkj]

  have eψ : qκ.comp y.ψ = frobTwist Onr Fr (-(j₀ : ℤ)) (qκ.comp ψ) := by
    rw [hyψ]; rfl

  rw [← eψ] at G
  have Gpt : M.map y.nilp hκr (qκ : A →+* κ) rfl y.pt =
      η κ ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) hκr t₀ :=
    GPoint.pt_eq_of_mk_eq G

  have Hn := hη2 A κ (y.ψ : Onr →+* A) ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) y.nilp hκr (qκ : A →+* κ) rfl t htadm
  have key : η κ ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) hκr t₀ =
      η κ ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) hκr (t.map (qκ : A →+* κ)) := by
    rw [Hn, hηt]; exact Gpt.symm

  have hadm_t : (t.map (qκ : A →+* κ)).IsAdmissible ι ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) :=
    Rigidified.IsAdmissible.map_ringHom ι (y.ψ : Onr →+* A) (qκ : A →+* κ) t htadm
  have hadm₀' : t₀.IsAdmissible ι ((qκ.comp y.ψ : Onr →ₐ[𝒪] κ) : Onr →+* κ) := by
    rw [eψ]; exact hadm₀
  have hiso : t₀.IsIsomorphic (t.map (qκ : A →+* κ)) :=
    (hη1 κ _ hκr t₀ (t.map (qκ : A →+* κ)) hadm₀' hadm_t).mp key
  exact ⟨j₀, t₀, hj₀, ht₀X, htr₀, hadm₀, hyψ, hiso⟩

end M7pCC1

theorem solution
    {r rbar N : ℕ} [Fact r.Prime] [Fact rbar.Prime] [NeZero N] (hrr : rbar ≠ r) (hrN : ¬ r ∣ N)

    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (hdvr : IsDiscreteValuationRing 𝒪)
    (π : 𝒪) (hπ : Irreducible π) (hcomplete : IsAdicComplete (Ideal.span {π}) 𝒪)
    (hres : Nat.card (𝒪 ⧸ Ideal.span {π}) = r) (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    (K₀ : Type) [Field K₀] [CharZero K₀] [Algebra 𝒪 K₀] [IsFractionRing 𝒪 K₀]

    (Onr : Type) [CommRing Onr] [IsDomain Onr] [CharZero Onr] [Algebra 𝒪 Onr] (Fr : Onr ≃ₐ[𝒪] Onr)
    (hOnr_complete : IsAdicComplete (Ideal.span {algebraMap 𝒪 Onr π}) Onr)
    (hOnr_max : (Ideal.span {algebraMap 𝒪 Onr π}).IsMaximal)
    (hOnr_alg : ∀ x : Onr, ∃ p : Polynomial 𝒪, p.Monic ∧ Polynomial.aeval x p ∈ Ideal.span {algebraMap 𝒪 Onr π})
    (hOnr_closed : ∀ p : Polynomial Onr, p.Monic → 0 < p.natDegree → ∃ x : Onr, Polynomial.eval x p ∈ Ideal.span {algebraMap 𝒪 Onr π})
    (hFr : ∀ x : Onr, Fr x - x ^ r ∈ Ideal.span {algebraMap 𝒪 Onr π})

    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (X₀ : FormalODModule r (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (hX₀ : X₀.HasHeight 4)
    (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2) (hA₀ : A₀.IsFormalModuleVia coord X₀ θ₀)

    (ι : Zp2 r →+* Onr)
    (Φ : FormalODModule r (Onr ⧸ pIdeal r Onr))
    (hΦ : Φ.IsSpecial ((Ideal.Quotient.mk (pIdeal r Onr)).comp ι))
    (hΦ4 : Φ.HasHeight 4)
    (M : ModuliPackage.{0, 0} r Onr) (hM : M.IsZariskiSheaf)
    (η : ∀ (B : Type) [CommRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B)),
      Rigidified r Φ B → M.obj B ψ hB)
    (hη : (∀ (B : Type) [CommRing B] [IsNoetherianRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B))
          (t t' : Rigidified r Φ B), t.IsAdmissible ι ψ → t'.IsAdmissible ι ψ →
          (η B ψ hB t = η B ψ hB t' ↔ t.IsIsomorphic t')) ∧
      (∀ (B B' : Type) [CommRing B] [CommRing B'] [IsNoetherianRing B] [IsNoetherianRing B'] (ψ : Onr →+* B) (ψ' : Onr →+* B')
          (hB : IsNilpotent (r : B)) (hB' : IsNilpotent (r : B')) (f : B →+* B')
          (hf : f.comp ψ = ψ') (t : Rigidified r Φ B), t.IsAdmissible ι ψ →
          η B' ψ' hB' (t.map f) = M.map hB hB' f hf (η B ψ hB t)) ∧
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] (ψ : Onr →+* B) (hB : IsNilpotent (r : B)) (m : M.obj B ψ hB),
          ∃ (n : ℕ) (f : Fin n → B), Ideal.span (Set.range f) = ⊤ ∧
            ∀ (i : Fin n) (L : Type) [CommRing L] [IsNoetherianRing L] [Algebra B L] [IsLocalization.Away (f i) L]
              (hL : IsNilpotent (r : L)),
              ∃ t : Rigidified r Φ L, t.IsAdmissible ι ((algebraMap B L).comp ψ) ∧
                η L ((algebraMap B L).comp ψ) hL t =
                  M.map (ψ' := (algebraMap B L).comp ψ) hB hL (algebraMap B L) rfl m))
    (E₀ : Subring.centralizer (Set.range Φ.actEnd ∪ {Φ.varpiEnd}) →+* Matrix (Fin 2) (Fin 2) K₀)
    (hE₀ : Function.Injective E₀ ∧
      ∃ m : ℕ,
        (∀ A : Matrix (Fin 2) (Fin 2) 𝒪, ∃ e, E₀ e = (r : K₀) ^ m • A.map (algebraMap 𝒪 K₀)) ∧
        (∀ e, ∃ A : Matrix (Fin 2) (Fin 2) 𝒪, (r : K₀) ^ m • E₀ e = A.map (algebraMap 𝒪 K₀)))

    (κ : (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) →+* (Onr ⧸ pIdeal r Onr))
    (hκ : κ.comp (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 Onr π})) = Ideal.Quotient.mk (pIdeal r Onr))
    (n₀ : ℕ) (β₀ : Series (Onr ⧸ pIdeal r Onr)) (hβ₀ : FormalODModule.IsIsogenyOfHeight Φ (X₀.map κ) β₀ (4 * n₀))

    (Ξ : ∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B),
        IsNilpotent (algebraMap 𝒪 B π) → FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ → ModuliPackage.GPoint 𝒪 M B)

    (hΞleg :
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) (hB : IsNilpotent (algebraMap 𝒪 B π))
          (hconn : ∀ e : B, IsIdempotentElem e → e = 0 ∨ e = 1)
          (x : FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ), ∃ k : ℤ, (Ξ B ψ hB x).ψ = frobTwist Onr Fr k ψ))

    (hΞnat :
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (B' : Type) [CommRing B'] [IsNoetherianRing B'] [Algebra 𝒪 B']
          (φ : B →ₐ[𝒪] B') (ψ : Onr →ₐ[𝒪] B) (hB : IsNilpotent (algebraMap 𝒪 B π)) (hB' : IsNilpotent (algebraMap 𝒪 B' π))
          (x : FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ) (x' : FakeEllipticCurve.RigidifiedCurve r π A₀ B' (φ.comp ψ))
          (g : x'.1.A ⟶ x.1.A) (hg : FakeEllipticCurve.IsPullbackVia (φ : B →+* B') x.1 x'.1 g),
          FakeEllipticCurve.Rigidification.IsPullbackVia φ g hg x.2 x'.2 → Ξ B' (φ.comp ψ) hB' x' = (Ξ B ψ hB x).map φ))

    (hΞiso :
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) (hB : IsNilpotent (algebraMap 𝒪 B π))
          (x x' : FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ) (i : x.1.A ≅ x'.1.A) (hi : i.hom ≫ x'.1.f = x.1.f),
          FakeEllipticCurve.IsoVia x.1 x'.1 i hi →
          (∃ (ib : x.2.Eb.A ⟶ x'.2.Eb.A) (_ : ib ≫ x'.2.gb = x.2.gb ≫ i.hom) (_ : ib ≫ x'.2.Eb.f = x.2.Eb.f)
            (uA : x'.2.Ab.A ⟶ x.2.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) x.2.Ab x'.2.Ab uA) (_ : uA ≫ x.2.gA = x'.2.gA)
            (i₁ j₁ : ℕ),
            ib ≫ x'.2.φ ≫ uA ≫ x.2.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = x.2.φ ≫ x.2.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩) →
            Ξ B ψ hB x = Ξ B ψ hB x'))

    (hΞdef :
      (∀ (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) (hB : IsNilpotent (algebraMap 𝒪 B π))
          (hconn : ∀ e : B, IsIdempotentElem e → e = 0 ∨ e = 1)
          (hBr : IsNilpotent ((r : ℕ) : B))
          (x : FakeEllipticCurve.RigidifiedCurve r π A₀ B ψ) (X : FormalODModule r B) (θ : RelativeGroupLaw.FormalCoordinates x.1.f 2),
          x.1.IsFormalModuleVia coord X θ →
          ∃ (j : ℕ) (t : Rigidified r Φ B), j ≤ 1 ∧ t.X = X ∧
            FakeEllipticCurve.Rigidification.IsRigTransport θ₀ κ β₀ x.2 θ j t ∧
            t.IsAdmissible ι ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] B) : Onr →+* B) ∧
            Ξ B ψ hB x = ⟨frobTwist Onr Fr (-(j : ℤ)) ψ, hBr, η B ((frobTwist Onr Fr (-(j : ℤ)) ψ : Onr →ₐ[𝒪] B) : Onr →+* B) hBr t⟩))

    (A : Type) [CommRing A] [IsArtinianRing A] [IsLocalRing A] [Algebra 𝒪 A] (hA : IsNilpotent (algebraMap 𝒪 A π))
    (κ : Type) [Field κ] [IsAlgClosed κ] [Algebra 𝒪 κ] (hκ : IsNilpotent (algebraMap 𝒪 κ π))
    (qκ : A →ₐ[𝒪] κ) (hqκ : Function.Surjective qκ) (hker : RingHom.ker (qκ : A →+* κ) = IsLocalRing.maximalIdeal A)
    (ψ : Onr →ₐ[𝒪] A) :
    ∀ (x₀ : FakeEllipticCurve.RigidifiedCurve r π A₀ κ (qκ.comp ψ)) (y : ModuliPackage.GPoint 𝒪 M A),
      (∃ k : ℤ, y.ψ = frobTwist Onr Fr k ψ) →
      Ξ κ (qκ.comp ψ) hκ x₀ = y.map qκ →
      ∃ (x : FakeEllipticCurve.RigidifiedCurve r π A₀ A ψ) (g : x₀.1.A ⟶ x.1.A)
        (hg : FakeEllipticCurve.IsPullbackVia (qκ : A →+* κ) x.1 x₀.1 g)

        (ub : x₀.2.Eb.A ⟶ x.2.Eb.A)
        (_ : FakeEllipticCurve.IsPullbackVia
            (Ideal.quotientMap (Ideal.span {algebraMap 𝒪 κ π}) (qκ : A →+* κ)
              (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_comap.mpr
                (by rw [show (qκ : A →+* κ) (algebraMap 𝒪 A π) = algebraMap 𝒪 κ π from qκ.commutes π]
                    exact Ideal.subset_span rfl)))))
            x.2.Eb x₀.2.Eb ub)
        (_ : ub ≫ x.2.gb = x₀.2.gb ≫ g)
        (uA : x₀.2.Ab.A ⟶ x.2.Ab.A)
        (_ : FakeEllipticCurve.IsPullbackVia
            (Ideal.quotientMap (Ideal.span {algebraMap 𝒪 κ π}) (qκ : A →+* κ)
              (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.mem_comap.mpr
                (by rw [show (qκ : A →+* κ) (algebraMap 𝒪 A π) = algebraMap 𝒪 κ π from qκ.commutes π]
                    exact Ideal.subset_span rfl)))))
            x.2.Ab x₀.2.Ab uA)
        (_ : uA ≫ x.2.gA = x₀.2.gA)
        (i₁ j₁ : ℕ),
        ub ≫ x.2.φ ≫ x.2.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = x₀.2.φ ≫ uA ≫ x.2.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ∧
        Ξ A ψ hA x = y := by
  intro x₀ y hleg hΞ

  rename_i κbr hκbr _ _ _ _ _ _ _
  obtain ⟨hη1, hη2, hη3⟩ := id hη
  obtain ⟨yψ, ynilp, ypt⟩ := y

  have hAr : IsNilpotent ((r : ℕ) : A) := ynilp
  have hπκ : algebraMap 𝒪 κ π = 0 := hκ.eq_zero
  have hrκ : ((r : ℕ) : κ) = 0 := by
    have hr : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := hunr ▸ Ideal.subset_span rfl
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hr
    have := congrArg (algebraMap 𝒪 κ) hc
    rw [map_mul, hπκ, mul_zero, map_natCast] at this
    exact this.symm
  have hrκnil : IsNilpotent ((r : ℕ) : κ) := hrκ ▸ IsNilpotent.zero
  have hNκ : IsUnit ((N : ℕ) : κ) := by
    have hcop : IsCoprime ((r : ℕ) : κ) ((N : ℕ) : κ) :=
      Nat.Coprime.cast ((Nat.Prime.coprime_iff_not_dvd (Fact.out)).mpr hrN)
    rwa [hrκ, isCoprime_zero_left] at hcop
  have hNA : IsUnit ((N : ℕ) : A) := by
    by_contra h
    have hmem : ((N : ℕ) : A) ∈ RingHom.ker (qκ : A →+* κ) := by
      rw [hker]; exact (IsLocalRing.mem_maximalIdeal _).mpr h
    rw [RingHom.mem_ker, map_natCast] at hmem
    exact hNκ.ne_zero hmem
  have hNb : IsUnit ((N : ℕ) : A ⧸ Ideal.span {algebraMap 𝒪 A π}) := by
    simpa only [map_natCast] using hNA.map (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 A π}))
  have hconn : ∀ e : A, IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro e he
    have he' : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
    by_cases hu : IsUnit e
    · right
      exact (sub_eq_zero.mp (hu.mul_right_eq_zero.mp he')).symm
    · left
      have h1e : IsUnit (1 - e) := by
        by_contra h'
        have hm : e ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hu
        have hm' : 1 - e ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr h'
        have : (1 : A) ∈ IsLocalRing.maximalIdeal A := by simpa using Ideal.add_mem _ hm hm'
        exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr this)
      exact h1e.mul_left_eq_zero.mp he'
  have hκconn : ∀ e : κ, IsIdempotentElem e → e = 0 ∨ e = 1 := fun e he =>
    IsIdempotentElem.iff_eq_zero_or_one.mp he
  have h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ := by simpa using hΛℤ 1
  have hkerNil : IsNilpotent (RingHom.ker (qκ : A →+* κ)) := by
    rw [hker, ← IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    exact IsArtinianRing.isNilpotent_jacobson_bot
  letI instAκ : Algebra A κ := (qκ : A →+* κ).toAlgebra
  have halg : algebraMap A κ = (qκ : A →+* κ) := rfl
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv (k := κ) (IsLocalRing.ResidueField A)
      (((RingHom.quotientKerEquivOfSurjective hqκ).symm.trans (Ideal.quotEquivOfEq hker) : κ ≃+* A ⧸ IsLocalRing.maximalIdeal A))

  obtain ⟨t, htadm, hηt⟩ :=
    M7pB21.exists_rigidified_isAdmissible_eta_eq_of_isLocalRing ι M η hη3 A (yψ : Onr →+* A) ynilp ypt

  obtain ⟨X₀κ, θ₀κ, hx₀⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleVia_of_field coord hcoord κ hrκnil x₀.1

  obtain ⟨j₀, t₀, hj₀, ht₀X, htr₀, hadm₀, hyψ, hiso₀⟩ :=
    M7pCC1.module_match 𝒪 π Onr Fr hOnr_closed hFr Λ coord A₀ θ₀ ι Φ M η hη1 hη2 κbr β₀ Ξ hΞdef A κ hκ qκ ψ
      x₀ ⟨yψ, ynilp, ypt⟩ hleg hΞ t htadm hηt X₀κ θ₀κ hx₀
  replace hyψ : yψ = frobTwist Onr Fr (-(j₀ : ℤ)) ψ := hyψ
  obtain ⟨u₀, v₀, m₀, hu₀, hv₀, hvu₀, huv₀, hc₀⟩ := hiso₀

  let w : ((t.X).map (algebraMap A κ)).Hom X₀κ := ⟨v₀, by rw [halg, ← ht₀X]; exact hv₀⟩
  have hwI : w.IsIso := ⟨⟨u₀, by rw [halg, ← ht₀X]; exact hu₀⟩, FormalODModule.Hom.ext huv₀, FormalODModule.Hom.ext hvu₀⟩

  obtain ⟨E, g, θ, θt, hgE, hEX, hEθt, hθg, hθtw⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullbackVia_rigidified_of_hom_isIso coord hcoord h1 A κ
      (by rw [halg]; exact hqκ) (by rw [halg]; exact hkerNil) hAr hNA x₀.1 X₀κ θ₀κ hx₀ t.X w hwI
  have hgE' : FakeEllipticCurve.IsPullbackVia (qκ : A →+* κ) E x₀.1 g := halg ▸ hgE

  obtain ⟨ρ, ρ', hρρ', ib, hib₁, hib₂, uA', huA'₁, huA'₂, i₁, j₁, hrel⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isPullbackVia_corr_of_isNilpotent_ker_of_isNoetherianRing
