-- module Solutions.OAIQ085_DF.DirectedFeedback_Encoding_Bounds
attribute [-instance] _root_.OAI.DFVSGames.Foundations.PCP.InitialGraph.slotFintype _root_.OAI.DFVSGames.Gadget.OrientationVectors.nonzeroAction _root_.OAI.DirectedFeedback.Pivotal.labelOrderNonempty
