theorem exists_ideal_fg_of_isClosedImmersion {S : Type u} [CommRing S] {Z : Scheme.{u}}
    (j : Z ⟶ Spec (CommRingCat.of S)) [hj : IsClosedImmersion j] [hlfp : LocallyOfFinitePresentation j] :
    ∃ I : Ideal S, I.FG ∧ ∀ (B : Type u) [CommRing B] (φ : S →+* B),
      (∃ ψ' : Spec (CommRingCat.of B) ⟶ Z, ψ' ≫ j = Spec.map (CommRingCat.ofHom φ)) ↔ I.map φ = ⊥ := by
  obtain ⟨I, e, he⟩ := (IsClosedImmersion.Spec_iff (f := j)).mp hj
  refine ⟨I, ?_, fun B _ φ => ⟨?_, ?_⟩⟩
  ·
    have h1 : LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
      have : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) = e.inv ≫ j := by
        rw [he, e.inv_hom_id_assoc]
      rw [this]; infer_instance
    rw [LocallyOfFinitePresentation.SpecMap_iff, CommRingCat.hom_ofHom] at h1
    have h2 : Algebra.FinitePresentation S (S ⧸ I) := by
      rw [← RingHom.finitePresentation_algebraMap]; exact h1
    have h3 := Algebra.FinitePresentation.ker_fG_of_surjective (Ideal.Quotient.mkₐ S I) (Ideal.Quotient.mkₐ_surjective S I)
    have hk : RingHom.ker (Ideal.Quotient.mkₐ S I).toRingHom = I := Ideal.mk_ker
    rwa [hk] at h3
  · rintro ⟨ψ', hψ'⟩
    obtain ⟨χ, hχ⟩ := Spec.map_surjective (ψ' ≫ e.hom)
    have h1 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ χ) = Spec.map (CommRingCat.ofHom φ) := by
      rw [Spec.map_comp, hχ, Category.assoc, ← hψ', he]
    have h2 := Spec.map_injective h1
    rw [Ideal.map_eq_bot_iff_le_ker]
    intro x hx
    have h3 := congrArg (fun ξ => (CommRingCat.Hom.hom ξ) x) h2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h3
    rw [RingHom.mem_ker, ← h3, Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
  · intro hI
    rw [Ideal.map_eq_bot_iff_le_ker] at hI
    refine ⟨Spec.map (CommRingCat.ofHom (Ideal.Quotient.lift I φ fun x hx => hI hx)) ≫ e.inv, ?_⟩
    rw [he, Category.assoc, e.inv_hom_id_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2

