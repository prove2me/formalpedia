theorem le_oWordSum_of (n U s p : ℕ) {z : ℕ} (h : z ≤ 100 ∨ z ≤ 10 ^ oM s p * (7 ^ oL s p * 7 ^ oL s p)
    ∨ z ≤ 7 ^ (oL s p + 1) ∨ z ≤ 10 ^ (oL s p + 1) ∨ z ≤ 2 ^ oL s p
