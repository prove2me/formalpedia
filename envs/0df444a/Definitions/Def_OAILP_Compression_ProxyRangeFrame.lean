open OAI.Optimization.LinearProgramming.RAM OAI.Optimization.LinearProgramming.FieldTransfer

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

def leavesIndex (j : ℕ) : Instr → Prop
