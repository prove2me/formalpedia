/-- `L = ⌈c m⌉` for a rational `c = a/b`. -/
theorem levelsOf_div (a m : ℕ) {b : ℕ} (hb : 1 ≤ b) :
    levelsOf ((a : ℝ) / b) m = (a * m + b - 1) / b := by
  unfold levelsOf
  rw [← Nat.ceilDiv_eq_add_pred_div, ← Nat.ceil_div_eq_ceilDiv (a * m) hb]
