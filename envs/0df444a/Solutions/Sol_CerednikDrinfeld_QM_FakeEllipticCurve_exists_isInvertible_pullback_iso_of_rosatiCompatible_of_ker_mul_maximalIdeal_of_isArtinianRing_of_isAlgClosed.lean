theorem AlgebraicGeometry.Scheme.Modules.nonempty_iso_of_isEmpty (X : Scheme.{u}) [IsEmpty ↑X] (M N : X.Modules) :
    Nonempty (M ≅ N) := by
  have hsub : ∀ (P : X.Modules) (U : (TopologicalSpace.Opens ↑X)ᵒᵖ), Subsingleton ↑(P.val.obj U) := by
    intro P U
    have hU : U.unop = ⊥ := SetLike.ext' (Set.eq_empty_of_isEmpty _)
    have hterm := X.sheaf.isTerminalOfEqEmpty hU
    haveI : Subsingleton ↑(X.ringCatSheaf.val.obj U) := CommRingCat.subsingleton_of_isTerminal hterm
    exact Module.subsingleton ↑(X.ringCatSheaf.val.obj U) _
  refine ⟨⟨0, 0, ?_, ?_⟩⟩
  · apply SheafOfModules.hom_ext; apply PresheafOfModules.hom_ext; intro U
    ext x; exact (hsub M U).elim _ _
  · apply SheafOfModules.hom_ext; apply PresheafOfModules.hom_ext; intro U
    ext x; exact (hsub N U).elim _ _

theorem pvB_comp_addMor_eq_addMor_comp {R k : Type u} [CommRing R] [CommRing k] (ρ : R →+* k)
    {A Ak : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of R)) (L : RelativeGroupLaw R f)
    (fk : Ak ⟶ Spec (CommRingCat.of k)) (Lk : RelativeGroupLaw k fk)
    (ik : Ak ⟶ A) (hikw : ik ≫ f = fk ≫ Spec.map (CommRingCat.ofHom ρ))
    (hikL : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of k)) (P Q : SchemeHomOver t' fk),
      (Lk.mul t' P Q).1 ≫ ik =
        (L.mul (t' ≫ Spec.map (CommRingCat.ofHom ρ))
          ⟨P.1 ≫ ik, by rw [Category.assoc, hikw, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ ik, by rw [Category.assoc, hikw, ← Category.assoc, Q.2]⟩).1)
    (iXX : pullback fk fk ⟶ pullback f f)
    (hi₁ : iXX ≫ pullback.fst f f = pullback.fst fk fk ≫ ik)
    (hi₂ : iXX ≫ pullback.snd f f = pullback.snd fk fk ≫ ik) :
    iXX ≫ addMor f L = addMor fk Lk ≫ ik := by
  have hψ : iXX ≫ (pullback.fst f f ≫ f) = (pullback.fst fk fk ≫ fk) ≫ Spec.map (CommRingCat.ofHom ρ) := by
    rw [← Category.assoc, hi₁, Category.assoc, hikw, Category.assoc]
  have key := congrArg Subtype.val
    (L.mul_natural (pullback.fst f f ≫ f) _ iXX hψ ⟨pullback.fst f f, rfl⟩ ⟨pullback.snd f f, pullback.condition.symm⟩)
  rw [schemeHomOverComp_coe] at key
  unfold addMor
  rw [key, hikL]
  congr 2
  · exact Subtype.ext (by rw [schemeHomOverComp_coe, hi₁])
  · exact Subtype.ext (by rw [schemeHomOverComp_coe, hi₂])

theorem pvB_comp_lift_fst_snd_comp_eq {R k : Type u} [CommRing R] [CommRing k]
    {A Ak : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of R)) (fk : Ak ⟶ Spec (CommRingCat.of k))
    (ik : Ak ⟶ A) (a : A ⟶ A) (ha : a ≫ f = f) (ak : Ak ⟶ Ak) (hak : ak ≫ fk = fk) (hika : ak ≫ ik = ik ≫ a)
    (iXX : pullback fk fk ⟶ pullback f f)
    (hi₁ : iXX ≫ pullback.fst f f = pullback.fst fk fk ≫ ik)
    (hi₂ : iXX ≫ pullback.snd f f = pullback.snd fk fk ≫ ik) :
    iXX ≫ pullback.lift (pullback.fst f f) (pullback.snd f f ≫ a)
        (by rw [Category.assoc, ha]; exact pullback.condition) =
      pullback.lift (pullback.fst fk fk) (pullback.snd fk fk ≫ ak)
        (by rw [Category.assoc, hak]; exact pullback.condition) ≫ iXX := by
  apply pullback.hom_ext <;>
    simp only [Category.assoc, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc,
      pullback.lift_snd_assoc, hi₁, hi₂, reassoc_of% hi₂, hika]

theorem pvB_comp_lift_fst_comp_snd_eq {R k : Type u} [CommRing R] [CommRing k]
    {A Ak : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of R)) (fk : Ak ⟶ Spec (CommRingCat.of k))
    (ik : Ak ⟶ A) (a : A ⟶ A) (ha : a ≫ f = f) (ak : Ak ⟶ Ak) (hak : ak ≫ fk = fk) (hika : ak ≫ ik = ik ≫ a)
    (iXX : pullback fk fk ⟶ pullback f f)
    (hi₁ : iXX ≫ pullback.fst f f = pullback.fst fk fk ≫ ik)
    (hi₂ : iXX ≫ pullback.snd f f = pullback.snd fk fk ≫ ik) :
    iXX ≫ pullback.lift (pullback.fst f f ≫ a) (pullback.snd f f)
        (by rw [Category.assoc, ha]; exact pullback.condition) =
      pullback.lift (pullback.fst fk fk ≫ ak) (pullback.snd fk fk)
        (by rw [Category.assoc, hak]; exact pullback.condition) ≫ iXX := by
  apply pullback.hom_ext <;>
    simp only [Category.assoc, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc,
      pullback.lift_snd_assoc, hi₁, hi₂, reassoc_of% hi₁, hika]

