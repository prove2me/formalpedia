lemma loop_eval (i : Input) (hi : i.Valid) (p : Program) (B reserve N : ℕ) (hB : i.n ≤ B)
    (j : Fin (scaleCount i)) (g : Machine)
    (hnormal : ∀ z : Fin i.n, g.natMem z.val ≤ 1 ∧ (g.natMem z.val = 0 → 0 ≤ g.realMem z.val))
    (reports : List ℕ) (hencoded : ∀ address ∈ reports, ∃ logical, address = bankAddress B j.val logical)
    (a : AdapterState i) (xs : List (Fin i.n)) (s : Data) (offset : ℕ)
