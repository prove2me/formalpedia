theorem jointDelta_comp_atkinLehner (y : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) (i : Fin 2) :
    jointDelta X.degeneracyData i (y ∘ X.atkinLehnerPerm) = jointDelta X.degeneracyData (1 - i) y := by
  obtain ⟨h1, h2, h3, -⟩ :=
    SSLevelDatum.atkinLehnerPerm_swap_degeneracy_and_width_and_edgeHecke_adjoint M s q' hs hq5 hsq' hq'M hsM A X
  have hbij : Function.Bijective X.atkinLehnerPerm := Function.Involutive.bijective h3
  funext v
  fin_cases i
  · show (degeneracyMatrix X.degeneracyData.a).mulVec (y ∘ X.atkinLehnerPerm) v =
      (degeneracyMatrix X.degeneracyData.b).mulVec y v
    simp only [Matrix.mulVec, dotProduct, degeneracyMatrix, Matrix.of_apply, Function.comp]
    rw [← hbij.sum_comp (fun W => (if X.degeneracyData.a W = v then (1 : ℤ) else 0) * y (X.atkinLehnerPerm W))]
    refine Finset.sum_congr rfl fun W _ => ?_
    show (if X.fst (X.atkinLehnerPerm W) = v then (1 : ℤ) else 0) * y (X.atkinLehnerPerm (X.atkinLehnerPerm W)) =
      (if X.snd W = v then (1 : ℤ) else 0) * y W
    rw [h1 W, h3 W]
  · show (degeneracyMatrix X.degeneracyData.b).mulVec (y ∘ X.atkinLehnerPerm) v =
      (degeneracyMatrix X.degeneracyData.a).mulVec y v
    simp only [Matrix.mulVec, dotProduct, degeneracyMatrix, Matrix.of_apply, Function.comp]
    rw [← hbij.sum_comp (fun W => (if X.degeneracyData.b W = v then (1 : ℤ) else 0) * y (X.atkinLehnerPerm W))]
    refine Finset.sum_congr rfl fun W _ => ?_
    show (if X.snd (X.atkinLehnerPerm W) = v then (1 : ℤ) else 0) * y (X.atkinLehnerPerm (X.atkinLehnerPerm W)) =
      (if X.fst W = v then (1 : ℤ) else 0) * y W
    rw [h2 W, h3 W]

theorem adjE_s_mulVec (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) :
    (adjE M s q' A X ⟨s, hs⟩).mulVec x =
      ((X.edgeHecke ⟨s, hs⟩).mulVec (x ∘ X.atkinLehnerPerm)) ∘ X.atkinLehnerPerm := by
  have h3 := atkinLehnerPerm_involutive M s q' hs hq5 hsq' hq'M hsM A X hPD
  have hbij : Function.Bijective X.atkinLehnerPerm := Function.Involutive.bijective h3
  funext i
  simp only [Matrix.mulVec, dotProduct, Function.comp, adjE_s M s q' hs hq5 hsq' hq'M hsM A X hPD]
  rw [← hbij.sum_comp (fun j => X.edgeHecke ⟨s, hs⟩ (X.atkinLehnerPerm i) j * x (X.atkinLehnerPerm j))]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [h3 j]

private theorem _root_.RibetAssembly69.InstAdj.kerAdjE (ℓ : Nat.Primes) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) (hx : x ∈ ribbonKernel X.degeneracyData) :
    (adjE M s q' A X ℓ).mulVec x ∈ ribbonKernel X.degeneracyData := by
  rw [mem_ribbonKernel] at hx ⊢
  by_cases hℓs : ℓ = ⟨s, hs⟩
  · subst hℓs
    obtain ⟨n₁, hn₁, n₂, hn₂, padj, hpadj, -, -, -, h4, -⟩ :=
      SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X

    have hxπ : ∀ i, jointDelta X.degeneracyData i (x ∘ X.atkinLehnerPerm) = 0 := by
      intro i
      rw [jointDelta_comp_atkinLehner M s q' hs hq5 hsq' hq'M hsM A X hPD]
      exact hx _
    have hU : ∀ i, jointDelta X.degeneracyData i ((X.edgeHecke ⟨s, hs⟩).mulVec (x ∘ X.atkinLehnerPerm)) = 0 := by
      intro i
      rw [jointDelta_apply_eq_mulVec]
      refine h4 (x ∘ X.atkinLehnerPerm) (fun j => ?_) i
      rw [← jointDelta_apply_eq_mulVec]
      exact hxπ j
    intro i
    rw [adjE_s_mulVec M s q' hs hq5 hsq' hq'M hsM A X hPD, jointDelta_comp_atkinLehner M s q' hs hq5 hsq' hq'M hsM A X hPD]
    exact hU _
  · intro i
    have h := eqvAdj M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hℓs i x
    rw [Matrix.mulVecLin_apply, hx i, map_zero] at h
    exact h

