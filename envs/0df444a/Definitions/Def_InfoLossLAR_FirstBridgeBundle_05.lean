open Integration9_9.TM2PlatformSerialization

/-- Read one literal instruction description, preserving its unary wire codes. -/
def readCircuitInstruction (xs : Str) : Str × Str :=
  let tag := _root_.Integration9_9.TM2PlatformSerialization.readUnary xs
  let first := _root_.Integration9_9.TM2PlatformSerialization.readUnary tag.2
  if inputWidth xs = 4 then
    let second := _root_.Integration9_9.TM2PlatformSerialization.readUnary first.2
    (second.2, tag.1 ++ first.1 ++ second.1)
  else (first.2, tag.1 ++ first.1)





 theorem _root_.InfoLossLAR.WorstCase.inputWidth_encNat_append (n : ℕ) (xs : Str) :
    inputWidth (encNat n ++ xs) = n := by
  simpa only [encNat, List.append_assoc, List.singleton_append] using inputWidth_prefix n xs

/-- Parsing succeeds for every gate and every trailing suffix. -/
theorem readCircuitInstruction_append {n : ℕ} (g : Instr n) (xs : Str) :
