theorem lamF_le_NF (d s : ℕ) : lamF d ≤ NF d s := by
  unfold NF
  have hX : 0 < 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) := by positivity
  have hY : 0 < (2 * wF d + 1) * (s + 1) ^ 2 := by positivity
  have e : 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      = (1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1)) *
        ((2 * wF d + 1) * (s + 1) ^ 2) := by ring
  rw [e]
  calc lamF d ≤ lamF d + 1 := by omega
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) := Nat.le_mul_of_pos_left _ hX
    _ ≤ _ := Nat.le_mul_of_pos_right _ hY

