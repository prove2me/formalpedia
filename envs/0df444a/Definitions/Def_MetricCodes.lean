  split_ifs with h
  · subst h
    simp
  · simp [h]
theorem blockIsometry_rowVector
    {r n : ℕ}
    (U : SpherePacking.Euclidean n ≃ₗᵢ[ℝ]
      SpherePacking.Euclidean n)
