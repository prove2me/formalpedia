-- Source module: Solutions.J6LineTopA2
/-!
# `A` lines by an axis sweep, part 2: the axis steps compose to `tensorGo`

**`pipeA6_sweep`**: if every source length is positive and at most the padded length, the sweep
`pipeSweep (pipeA6 P n src D) (D + 1)` of the `A` axis steps is
`tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D))` on every `t`-box array
(`pipeSweep_eq` + `sweepL_tensorGo'`, locality of `chirpC` from `chirpA_congr`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- **The `A` axis steps compose to `tensorGo (mapsA6 …)`.** -/
theorem pipeA6_sweep (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D : ℕ)
    (hax : ∀ i < D + 1, 0 < src i ∧ src i ≤ tF6 P n i)
    (ys : List GI) (hys : ys.length = (List.ofFn (tD6 P n D)).prod) :
    pipeSweep (pipeA6 P n src D) (D + 1) ys =
      IntMul.HvdH.Ref.tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) ys := by
  set dims := List.ofFn (tD6 P n D) with hdims
  have hpos : ∀ u ∈ dims, 0 < u := by
    intro u hu
    rw [hdims, List.mem_ofFn] at hu
    obtain ⟨i, rfl⟩ := hu
    show 0 < tF6 P n i.val
    unfold tF6; split_ifs <;> positivity
  have hlenD : dims.length = D + 1 := by rw [hdims, List.length_ofFn]
  have hF : ∀ k < dims.length, ∀ X : List GI, X.length = dims.getD k 1 →
      (lineA6 P n src D k X).length = dims.getD k 1 := by
    intro k _ X _
    simp [lineA6, hdims]
  have e1 := pipeSweep_eq dims hpos (lineA6 P n src D) (pipeA6 P n src D) hF
    (fun k _ L _ => rfl) (D + 1) (by omega) ys hys
  rw [e1]
  have e2 := sweepL_tensorGo' (D + 1) dims hlenD hpos (lineA6 P n src D)
    (fun i => J6A.chirpC (pP6 P n) ((List.ofFn (sD6 src D)).getD i 1)
      ((List.ofFn (tD6 P n D)).getD i 1) (αN6 P n) (HA6 P n))
    (fun i _ => rfl)
    (fun i hi U U' h => by
      have es : (List.ofFn (sD6 src D)).getD i 1 = src i :=
        NLogN.KFY.ofFn_getD (sD6 src D) ⟨i, hi⟩ 1
      have et : (List.ofFn (tD6 P n D)).getD i 1 = tF6 P n i :=
        NLogN.KFY.ofFn_getD (tD6 P n D) ⟨i, hi⟩ 1
      obtain ⟨h0, hst⟩ := hax i hi
      rw [es]
      exact J6A.chirpA_congr _ _ _ _ _ _ _ U U' h0 (fun j hj => h j (by
        rw [hdims, et]; omega)))
    ys hys
  rw [e2]
  rfl

end J6Seg

end

end

