lemma balance_hasDerivWithinAt_zero {n d k : ℕ}
    {X : Vec d →L[ℝ] Vec n} {Y : Vec n} {v₀ : Vec k} {B₀ : Features d k}
    {γ : Trajectory d k} (hγ : IsFineTuningFlow X Y v₀ B₀ γ)
