open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
open NLogN.FW (Spec)

theorem recL_snd4 (s : List ℕ) : (CR.recL s 0).map snd4 = s.map (fun x : ℕ => (x : ℤ)) := by
  apply List.ext_getElem (by simp [CR.recL])
  intro i h1 h2
  simp only [List.length_map] at h2
  simp [CR.recL, CR.recI, snd4, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2]

end NLogN.ST

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false
open NLogN
open NLogN.ST
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
open NLogN.FW (Spec)
set_option maxHeartbeats 4000000
theorem solution (M : NLogN.MulSpec) (K : ℕ) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (hlen : s.length = K)
    (t : NLogN.IState NLogN.HS) (R40 L28 : List NLogN.Item) (h40 : t.G 40 = NLogN.ints (NLogN.CR.recL s 0).flatten ++ R40)
    (h28 : t.G 28 = .int (s.prod : ℤ) :: L28) (B : ℕ) (hB : 2 * s.prod + 4 * K + 1 < 2 ^ B) :
    NLogN.FW.Spec M (NLogN.ST.keyPh K) t (((t.upd 40 R40).upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)).upd 41
      (NLogN.ints (s.map (fun x : ℕ => (x : ℤ))).reverse ++ t.G 41)) (NLogN.ST.keyCost K s.prod B) := by
  set l := (NLogN.CR.recL s 0).flatten with hl
  have hll : l.length = 4 * K := by rw [hl, NLogN.CR.recL_flatten_length, hlen]
  have hlB : ∀ x ∈ l, NLogN.zsz x ≤ B := fun x hx => by
    have := NLogN.CR.recL_flat_bnd s hs 0 x hx
    exact NLogN.CR.zsz_le_of_bnd this.1 this.2 (by omega)
  have zK : NLogN.zsz ((4 * K : ℕ) : ℤ) ≤ B := NLogN.CR.natCast_lt_pow (by omega)
  have zK1 : NLogN.zsz (K : ℤ) ≤ B := NLogN.CR.natCast_lt_pow (by omega)
  have zS : NLogN.zsz (s.prod : ℤ) ≤ B := NLogN.CR.natCast_lt_pow (by omega)
  -- 1. records 40 → 4
  obtain ⟨r1, o1, c1⟩ := NLogN.GL.xferP_all M 40 4 (.lit ((4 * K : ℕ) : ℤ)) t l R40 B (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) h40
    (by simp [NLogN.Ex.eval, hll]) (by intro i hi; simp [NLogN.Ex.regs] at hi) trivial trivial
    (by simp only [NLogN.Ex.Bnd]; exact zK) hlB (fun t' _ => ⟨rfl, trivial, by simp only [NLogN.Ex.Bnd]; exact zK⟩)
  have S1 : NLogN.FW.Spec M (NLogN.GL.xferP 40 4 (.lit ((4 * K : ℕ) : ℤ))) t
      ((t.upd 40 R40).upd 4 (NLogN.ints l ++ t.G 4)) _ := ⟨o1, r1, c1⟩
  set t1 := (t.upd 40 R40).upd 4 (NLogN.ints l ++ t.G 4) with ht1
  -- 2. pushes
  set vs : List (Fin NLogN.HS × ℤ) := [(15, (s.prod : ℤ)), (16, (K : ℤ)), (17, ((4 * K : ℕ) : ℤ))] with hvs
  have hP : NLogN.EX.PushOK B t1 [(15, .reg 28), (16, .lit (K : ℤ)), (17, .lit ((4 * K : ℕ) : ℤ))] vs := by
    have g28 : t1.G 28 = .int (s.prod : ℤ) :: L28 := by simp (config := {decide := true}) [ht1, h28]
    simp only [NLogN.EX.PushOK, hvs, NLogN.Ex.ok, NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq g28, true_and, and_true]
    refine ⟨by decide, NLogN.FW.clean_reg (by decide), NLogN.IState.isInt_of g28, zS, by decide,
      by intro i hi; simp [NLogN.Ex.regs] at hi, zK1, by decide, by intro i hi; simp [NLogN.Ex.regs] at hi, zK⟩
  obtain ⟨r2, o2, c2⟩ := NLogN.EX.pushes_all B _ vs t1 hP
  have S2 : NLogN.FW.Spec M (.rs (NLogN.EX.pushes [(15, .reg 28), (16, .lit (K : ℤ)),
      (17, .lit ((4 * K : ℕ) : ℤ))])) t1 (NLogN.EX.pushV t1 vs) _ := ⟨o2, r2, c2⟩
  set t2 := NLogN.EX.pushV t1 vs with ht2
  -- 3. keyGen
  have g4 : t2.G 4 = NLogN.ints (NLogN.CR.recL s 0).flatten ++ t.G 4 := by
    simp (config := {decide := true}) [ht2, hvs, NLogN.EX.pushV, ht1, hl]
  have g15 : t2.G 15 = .int (s.prod : ℤ) :: t1.G 15 := by
    simp (config := {decide := true}) [ht2, hvs, NLogN.EX.pushV]
  have g16 : t2.G 16 = .int (s.length : ℤ) :: t1.G 16 := by
    simp (config := {decide := true}) [ht2, hvs, NLogN.EX.pushV, hlen]
  have g17 : t2.G 17 = .int ((4 * s.length : ℕ) : ℤ) :: t1.G 17 := by
    simp (config := {decide := true}) [ht2, hvs, NLogN.EX.pushV, hlen]
  obtain ⟨o3, r3⟩ := NLogN.CR.keyGen_spec t2 s hs _ _ _ _ g4 g15 g16 g17
  have c3 := NLogN.CR.keyGen_cost t2 s hs _ _ _ _ g4 g15 g16 g17 B (by rw [hlen]; exact hB)
  have S3 : NLogN.FW.Spec M (.rs NLogN.CR.keyGen) t2 (t2.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t2.G 3)) _ := ⟨o3, r3, c3⟩
  -- 4. pops
  have e3 : t2.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t2.G 3) = NLogN.EX.pushV (t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)) vs := by
    rw [ht2, NLogN.ST.pushV_upd _ _ vs t1 (by simp (config := {decide := true}) [hvs])]
    congr 2
  rw [e3] at S3
  have hr : ∀ x ∈ vs, x.1.val < 56 ∧ NLogN.zsz x.2 ≤ B := by
    intro x hx; simp only [hvs, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl <;> exact ⟨by simp only []; decide, by assumption⟩
  obtain ⟨o4, c4⟩ := NLogN.ST.pops_okc' B vs (t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)) hr
  have r4 := NLogN.ST.pops_pushV' vs (t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)) (fun x hx => (hr x hx).1)
  have S4 : NLogN.FW.Spec M (.rs (NLogN.EX.pops [15, 16, 17])) (NLogN.EX.pushV (t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)) vs)
      (t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3)) _ := ⟨o4, r4, c4⟩
  set t3 := t1.upd 3 (NLogN.natInts (NLogN.CR.keyL s) ++ t.G 3) with ht3
  -- 5. slLoop
  have g4' : t3.G NLogN.ST.sR = NLogN.ints (NLogN.CR.recL s 0).flatten ++ t.G 4 := by
    simp (config := {decide := true}) [ht3, ht1, hl]
  have S5 := NLogN.ST.slLoop_spec M K t3 (NLogN.CR.recL s 0) (by
      intro r hr; simp only [NLogN.CR.recL, List.mem_map] at hr
      obtain ⟨i, -, rfl⟩ := hr; exact ⟨_, _, _, _, rfl⟩) (by simp [NLogN.CR.recL, hlen]) (t.G 4) B
    (by
      intro r hr y hy
      exact hlB y (List.mem_flatten.2 ⟨r, hr, hy⟩)) zK1 g4'
  have A := S1.seq (S2.seq (S3.seq (S4.seq S5)))
  rw [NLogN.ST.recL_snd4] at A
  refine (A.congr ?_).mono ?_
  · apply NLogN.IState.ext' _ (by simp [ht3, ht1]) (by simp [ht3, ht1])
    intro j; fin_cases j <;> simp (config := {decide := true}) [ht3, ht1] <;> rfl
  · simp only [NLogN.ST.keyCost, NLogN.EX.pwt, NLogN.Ex.size, List.map, List.sum_cons, List.sum_nil, hvs,
      List.length_cons, List.length_nil, hll]
    nlinarith
end
