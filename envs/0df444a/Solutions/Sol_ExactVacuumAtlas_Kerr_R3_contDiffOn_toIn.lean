open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Kerr
open ExactVacuumAtlas
open ExactVacuumAtlas.Kerr
open ExactVacuumAtlas.Kerr.R3
set_option maxHeartbeats 4000000
variable (M a : ℝ) (H₁ H₂ : ℝ → ℝ)
variable (h₁ : ContDiffOn ℝ ∞ H₁ (radDom M a)) (h₂ : ContDiffOn ℝ ∞ H₂ (radDom M a))
include h₁ h₂
theorem solution : ContDiffOn ℝ ∞ (toIn H₁ H₂) (domBL M a) := by
  rw [contDiffOn_pi]; intro i
  have hp1 : ContDiffOn ℝ ∞ (fun x : Pt 4 => x 1) (domBL M a) := contDiffOn_pi.mp contDiffOn_id 1
  have hH₁ : ContDiffOn ℝ ∞ (fun x : Pt 4 => H₁ (x 1)) (domBL M a) :=
    h₁.comp hp1 (fun x hx => mem_radDom_of_mem M a hx)
  have hH₂ : ContDiffOn ℝ ∞ (fun x : Pt 4 => H₂ (x 1)) (domBL M a) :=
    h₂.comp hp1 (fun x hx => mem_radDom_of_mem M a hx)
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, toIn_0,
    toIn_1, toIn_2, toIn_3]
  · exact ((contDiffOn_pi.mp contDiffOn_id 0).add hp1).add hH₁
  · exact hp1
  · exact contDiffOn_pi.mp contDiffOn_id 2
  · exact (contDiffOn_pi.mp contDiffOn_id 3).neg.sub hH₂
