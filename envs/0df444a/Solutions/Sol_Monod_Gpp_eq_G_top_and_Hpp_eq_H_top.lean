/-!
# Monod's `G` and `H` are `G ⊤` and `H ⊤`

Every point of `P¹` is fixed by a hyperbolic element of `SL(2, ℝ)`, so `P ⊤ = univ`, and
"breakpoints in `P ⊤`" is the same as "breakpoints anywhere".
-/

open Filter Topology OnePoint Matrix

namespace Monod.Dev.Gpp

open Monod Monod.Dev.Alg

/-- The hyperbolic element `!![2, -3x/2; 0, 1/2]` of `SL(2, ℝ)`, fixing `x` and `∞`. -/
noncomputable def hypAt (x : ℝ) : SpecialLinearGroup (Fin 2) (⊤ : Subring ℝ) :=
  ⟨!![⟨2, trivial⟩, ⟨-(3 * x / 2), trivial⟩; 0, ⟨1 / 2, trivial⟩], by
    rw [Matrix.det_fin_two_of]
    apply Subtype.ext
    norm_num⟩

lemma ent_hypAt (x : ℝ) :
    ent (hypAt x) 0 0 = 2 ∧ ent (hypAt x) 0 1 = -(3 * x / 2) ∧ ent (hypAt x) 1 0 = 0 ∧
      ent (hypAt x) 1 1 = 1 / 2 := ⟨rfl, rfl, rfl, rfl⟩

lemma isHyperbolic_hypAt (x : ℝ) : IsHyperbolic (hypAt x) := by
  unfold IsHyperbolic
  rw [Matrix.trace_fin_two]
  show 2 < |(2 : ℝ) + 1 / 2|
  rw [abs_of_pos (by norm_num)]
  norm_num

lemma mob_hypAt_infty (x : ℝ) : mob (hypAt x) ∞ = ∞ := by
  obtain ⟨_, _, h10, _⟩ := ent_hypAt x
  rw [mob_infty, if_pos h10]

lemma mob_hypAt_self (x : ℝ) : mob (hypAt x) (x : OnePoint ℝ) = x := by
  obtain ⟨h00, h01, h10, h11⟩ := ent_hypAt x
  rw [mob_coe, h00, h01, h10, h11, if_neg (by norm_num)]
  congr 1
  field_simp
  ring

/-- Every point of `P¹` is the fixed point of a hyperbolic element of `SL(2, ℝ)`. -/
theorem P_top_eq_univ : P ⊤ = Set.univ := by
  refine Set.eq_univ_of_forall fun p => ?_
  cases p with
  | infty => exact ⟨hypAt 0, isHyperbolic_hypAt 0, mob_hypAt_infty 0⟩
  | coe x => exact ⟨hypAt x, isHyperbolic_hypAt x, mob_hypAt_self x⟩

/-- Monod's `G` is `G(ℝ)`. -/
theorem Gpp_eq_G_top : Gpp = G ⊤ := by
  rw [Monod.Dev.GMono.G_eq_closure_isPiecewiseProj]
  unfold Gpp IsPiecewiseProj
  rw [P_top_eq_univ]

/-- Monod's `H` is `H(ℝ)`. -/
theorem Hpp_eq_H_top : Hpp = H ⊤ := by
  unfold Hpp H
  rw [Gpp_eq_G_top]

end Monod.Dev.Gpp
end

open Monod in
theorem solution : Gpp = G ⊤ ∧ Hpp = H ⊤ :=
  ⟨Dev.Gpp.Gpp_eq_G_top, Dev.Gpp.Hpp_eq_H_top⟩
