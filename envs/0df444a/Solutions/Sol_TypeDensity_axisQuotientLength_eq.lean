theorem solution (k : Type) [Field k] {s t : Fin 2} (hst : s ≠ t)
    (F : TypeDensity.TwoSeries k)
    (d : ℕ) (hlow : ∀ j < d, MvPowerSeries.coeff (Finsupp.single t j) F = 0)
    (hd : MvPowerSeries.coeff (Finsupp.single t d) F ≠ 0) : TypeDensity.axisQuotientLength k s F = d := by
  set Xs : TypeDensity.TwoSeries k := MvPowerSeries.X s
  set Xt : TypeDensity.TwoSeries k := MvPowerSeries.X t
  let F0 : TypeDensity.TwoSeries k := fun m => if m s = 0 then MvPowerSeries.coeff m F else 0
