theorem ColimB18.main_at
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (m : ℕ) (hm : 3 ≤ m)
    (ι : Type) [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    (S : ι → Type) [∀ i, CommRing (S i)]
    (t : ∀ i j, i ≤ j → (S i →+* S j))
    (ht₁ : ∀ i (h : i ≤ i), t i i h = RingHom.id (S i))
    (ht₂ : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k), (t j k hjk).comp (t i j hij) = t i k (hij.trans hjk))
    (L : Type) [CommRing L] (c : ∀ i, S i →+* L)
    (hc : ∀ i j (h : i ≤ j), (c j).comp (t i j h) = c i)
    (hcsurj : ∀ x : L, ∃ (i : ι) (y : S i), c i y = x)
    (hcker : ∀ (i : ι) (y z : S i), c i y = c i z → ∃ (j : ι) (h : i ≤ j), t i j h y = t i j h z) :
    ∀ (i : ι), IsUnit ((m : ℕ) : S i) → ∀ (v w : FakeEllipticCurve.WithFullLevel Λ N m (S i)) (v' w' : FakeEllipticCurve.WithFullLevel Λ N m L),
        FakeEllipticCurve.WithFullLevel.IsPullback (c i) v v' → FakeEllipticCurve.WithFullLevel.IsPullback (c i) w w' →
        FakeEllipticCurve.WithFullLevel.Iso v' w' →
        ∃ (j : ι) (h : i ≤ j) (vj wj : FakeEllipticCurve.WithFullLevel Λ N m (S j)),
          FakeEllipticCurve.WithFullLevel.IsPullback (t i j h) v vj ∧ FakeEllipticCurve.WithFullLevel.IsPullback (t i j h) w wj ∧
          FakeEllipticCurve.WithFullLevel.Iso vj wj := by
  classical
  intro i hmi v w v' w' hv' hw' hiso
  obtain ⟨-, Kcomp, Kcancel, -, -, Kuniq, -, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.isPullback_refl_comp_cancel_iso_unique_nsmulPt Λ N m

  obtain ⟨Rv, hRvfg, -, vRv, gv, hgv, hvs⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_fg_subalgebra_isPullback_levelIff_of_isUnit_of_isIndefiniteRamifiedExactlyAt hB Λ hΛ N m (S i) v ∅ hmi
  obtain ⟨Rw, hRwfg, -, wRw, gw, hgw, hws⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_fg_subalgebra_isPullback_levelIff_of_isUnit_of_isIndefiniteRamifiedExactlyAt hB Λ hΛ N m (S i) w ∅ hmi
  have hvRv : FakeEllipticCurve.WithFullLevel.IsPullback Rv.val.toRingHom vRv v := isPullback_of_strong _ _ _ gv hgv hvs
  have hwRw : FakeEllipticCurve.WithFullLevel.IsPullback Rw.val.toRingHom wRw w := isPullback_of_strong _ _ _ gw hgw hws

  set R : Subalgebra ℤ (S i) := Rv ⊔ Rw with hRdef
  have hRfg : R.FG := hRvfg.sup hRwfg
  haveI hFT : Algebra.FiniteType ℤ ↥R := ⟨(Subalgebra.fg_top R).2 hRfg⟩
  haveI hFT' : @Algebra.FiniteType ℤ ↥R _ _ (Ring.toIntAlgebra ↥R) := by
    convert hFT using 1
    all_goals try exact Subsingleton.elim _ _
  haveI : IsNoetherianRing ↥R := Algebra.FiniteType.isNoetherianRing ℤ ↥R
  let inv : ↥Rv →+* ↥R := (Subalgebra.inclusion (le_sup_left : Rv ≤ R)).toRingHom
  let inw : ↥Rw →+* ↥R := (Subalgebra.inclusion (le_sup_right : Rw ≤ R)).toRingHom
  have hinv : R.val.toRingHom.comp inv = Rv.val.toRingHom := RingHom.ext (fun x => rfl)
  have hinw : R.val.toRingHom.comp inw = Rw.val.toRingHom := RingHom.ext (fun x => rfl)
  obtain ⟨vR, gvR, hgvR, hvRs⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff inv vRv
  obtain ⟨wR, gwR, hgwR, hwRs⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff inw wRw
  have hvR : FakeEllipticCurve.WithFullLevel.IsPullback R.val.toRingHom vR v :=
    Kcancel _ _ _ inv R.val.toRingHom vRv vR v (isPullback_of_strong _ _ _ gvR hgvR hvRs) (hinv ▸ hvRv)
  have hwR : FakeEllipticCurve.WithFullLevel.IsPullback R.val.toRingHom wR w :=
    Kcancel _ _ _ inw R.val.toRingHom wRw wR w (isPullback_of_strong _ _ _ gwR hgwR hwRs) (hinw ▸ hwRw)

  letI : Algebra ↥R L := ((c i).comp R.val.toRingHom).toAlgebra
  have halg : algebraMap ↥R L = (c i).comp R.val.toRingHom := rfl
  have hv'R : FakeEllipticCurve.WithFullLevel.IsPullback (algebraMap ↥R L) vR v' :=
    halg ▸ Kcomp _ _ _ R.val.toRingHom (c i) vR v v' hvR hv'
  have hw'R : FakeEllipticCurve.WithFullLevel.IsPullback (algebraMap ↥R L) wR w' :=
    halg ▸ Kcomp _ _ _ R.val.toRingHom (c i) wR w w' hwR hw'
  obtain ⟨T, hTfg, -, hT⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_fg_subalgebra_forall_iso_of_iso_of_isPullback
      hΛ vR wR v' w' hv'R hw'R hiso ∅

  have hT'fg : (T.restrictScalars ℤ).FG := by
    have h1 : (⊤ : Subalgebra ℤ ↥R).FG := (Subalgebra.fg_top R).2 hRfg
    have h2 : (⊤ : Subalgebra ↥R ↥T).FG := (Subalgebra.fg_top T).2 hTfg
    have h3 : (⊤ : Subalgebra ℤ ↥T).FG := Algebra.fg_trans' h1 h2
    have h4 : T.restrictScalars ℤ = (⊤ : Subalgebra ℤ ↥T).map (T.val.restrictScalars ℤ) := by
      ext x
      rw [Subalgebra.mem_restrictScalars, Subalgebra.mem_map]
      constructor
      · intro hx; exact ⟨⟨x, hx⟩, Algebra.mem_top, rfl⟩
      · rintro ⟨y, -, rfl⟩; exact y.2
    rw [h4]; exact h3.map _
  obtain ⟨hBr, -⟩ := Subalgebra.exists_ringHom_comp_eq_val_of_fg_of_directedSystem ι S t ht₁ ht₂ L c hc hcsurj hcker
    (T.restrictScalars ℤ) hT'fg
  obtain ⟨j, hij, ψ', hψ'⟩ := hBr i

  let eT : ↥T →+* ↥(T.restrictScalars ℤ) :=
    { toFun := fun x => ⟨x.1, x.2⟩, map_one' := rfl, map_mul' := fun _ _ => rfl, map_zero' := rfl, map_add' := fun _ _ => rfl }
  let ψ : ↥T →+* S j := ψ'.comp eT
  have hψ : (c j).comp ψ = T.val.toRingHom := by
    ext x
    have := congrArg (fun f : ↥(T.restrictScalars ℤ) →+* L => f (eT x)) hψ'
    exact this

  let ρ : ↥R →+* ↥T := algebraMap ↥R ↥T
  have hρ : T.val.toRingHom.comp ρ = (c i).comp R.val.toRingHom := RingHom.ext (fun x => rfl)
  have hagree : (c j).comp (ψ.comp ρ) = (c j).comp ((t i j hij).comp R.val.toRingHom) := by
    rw [← RingHom.comp_assoc, hψ, hρ, ← RingHom.comp_assoc, hc i j hij]
  obtain ⟨k, hjk, hpin⟩ :=
    RingHom.exists_comp_eq_comp_of_finiteType_of_directedSystem ι S t ht₁ ht₂ L c hc hcsurj hcker ↥R j
      (ψ.comp ρ) ((t i j hij).comp R.val.toRingHom) hagree

  set χ : ↥R →+* S k := (t j k hjk).comp (ψ.comp ρ) with hχdef
  have hχ' : χ = (t i k (hij.trans hjk)).comp R.val.toRingHom := by
    rw [hpin, ← RingHom.comp_assoc, ht₂ i j k hij hjk]
  obtain ⟨vk, gvk, hgvk, hvks⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff χ vR
  obtain ⟨wk, gwk, hgwk, hwks⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback_levelIff χ wR
  have hvk : FakeEllipticCurve.WithFullLevel.IsPullback χ vR vk := isPullback_of_strong _ _ _ gvk hgvk hvks
  have hwk : FakeEllipticCurve.WithFullLevel.IsPullback χ wR wk := isPullback_of_strong _ _ _ gwk hgwk hwks
