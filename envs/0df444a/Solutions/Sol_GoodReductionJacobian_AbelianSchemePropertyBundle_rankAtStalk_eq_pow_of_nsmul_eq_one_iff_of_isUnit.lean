variable {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}

theorem toBase_nsmul {S' : Type} [CommRing S'] (ι' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of S))
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (n : ℕ)
    (x : SchemeHomOver t' (RelativeGroupLaw.baseChangeStr ι' f)) :
    RelativeGroupLaw.baseChangePointToBase ι' ((L.baseChange ι').nsmul t' n x) =
      L.nsmul (t' ≫ ι') n (RelativeGroupLaw.baseChangePointToBase ι' x) := by
  induction n with
  | zero =>
      rw [RelativeGroupLaw.nsmul_zero, RelativeGroupLaw.nsmul_zero]
      exact RelativeGroupLaw.baseChangePointToBase_ofBase ι' _
  | succ k ih =>
      rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, ← ih]
      exact RelativeGroupLaw.baseChangePointToBase_ofBase ι' _

theorem toBase_one {S' : Type} [CommRing S'] (ι' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of S))
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) :
    RelativeGroupLaw.baseChangePointToBase ι' ((L.baseChange ι').one t') = L.one (t' ≫ ι') :=
  RelativeGroupLaw.baseChangePointToBase_ofBase ι' _

theorem natCard_torsionSubset_baseChange {S' : Type} [CommRing S'] (ι' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of S))
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (n : ℕ) :
    Nat.card ((L.baseChange ι').torsionSubset t' n) = Nat.card (L.torsionSubset (t' ≫ ι') n) := by
  apply Nat.card_congr
  refine
    { toFun := fun x => ⟨RelativeGroupLaw.baseChangePointToBase ι' x.1, ?_⟩
      invFun := fun y => ⟨RelativeGroupLaw.baseChangePointOfBase ι' y.1, ?_⟩
      left_inv := fun x => Subtype.ext (RelativeGroupLaw.baseChangePointOfBase_toBase ι' x.1)
      right_inv := fun y => Subtype.ext (RelativeGroupLaw.baseChangePointToBase_ofBase ι' y.1) }
  · have hx := x.2
    rw [RelativeGroupLaw.mem_torsionSubset, RelativeGroupLaw.isTorsionPoint_def] at hx ⊢
    rw [← toBase_nsmul, hx, toBase_one]
  · have hy := y.2
    rw [RelativeGroupLaw.mem_torsionSubset, RelativeGroupLaw.isTorsionPoint_def] at hy ⊢
    apply (RelativeGroupLaw.baseChangePointEquiv ι' t').injective
    change RelativeGroupLaw.baseChangePointToBase ι' _ = RelativeGroupLaw.baseChangePointToBase ι' _
    rw [toBase_nsmul, RelativeGroupLaw.baseChangePointToBase_ofBase, hy, toBase_one]

theorem natCard_torsionSubset_congr (L : RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)}
    (h : t₁ = t₂) (n : ℕ) : Nat.card (L.torsionSubset t₁ n) = Nat.card (L.torsionSubset t₂ n) := by
  subst h; rfl

theorem natCard_algHom_eq_natCard_torsionSubset (L : RelativeGroupLaw S f) (n : ℕ)
    (B : Type) [CommRing B] [Algebra S B]
    (ι : Spec (CommRingCat.of B) ⟶ A) (hι : ι ≫ f = Spec.map (CommRingCat.ofHom (algebraMap S B))) (hιc : IsClosedImmersion ι)
    (hpts : ∀ (T : Scheme.{0}) (t : T ⟶ Spec (CommRingCat.of S)) (y : SchemeHomOver t f),
      L.nsmul t n y = L.one t ↔ ∃ z : T ⟶ Spec (CommRingCat.of B), z ≫ ι = y.1)
    (k : Type) [CommRing k] [Algebra S k] :
    Nat.card (B →ₐ[S] k) = Nat.card (L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap S k))) n) := by
  classical
  haveI : Mono ι := inferInstance

  have hover : ∀ φ : B →ₐ[S] k, (Spec.map (CommRingCat.ofHom (φ : B →+* k)) ≫ ι) ≫ f = Spec.map (CommRingCat.ofHom (algebraMap S k)) := by
    intro φ
    rw [Category.assoc, hι, ← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
  let Φ : (B →ₐ[S] k) → L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap S k))) n := fun φ =>
    ⟨⟨Spec.map (CommRingCat.ofHom (φ : B →+* k)) ≫ ι, hover φ⟩,
      (RelativeGroupLaw.mem_torsionSubset _ _ _ _).2 ((hpts _ _ _).2 ⟨Spec.map (CommRingCat.ofHom (φ : B →+* k)), rfl⟩)⟩
  apply Nat.card_eq_of_bijective Φ
  constructor
  · intro φ ψ h
    have h1 : Spec.map (CommRingCat.ofHom (φ : B →+* k)) ≫ ι = Spec.map (CommRingCat.ofHom (ψ : B →+* k)) ≫ ι :=
      congrArg (fun q : L.torsionSubset _ n => q.1.1) h
    have h2 : Spec.map (CommRingCat.ofHom (φ : B →+* k)) = Spec.map (CommRingCat.ofHom (ψ : B →+* k)) := (cancel_mono ι).1 h1
    have h3 : CommRingCat.ofHom (φ : B →+* k) = CommRingCat.ofHom (ψ : B →+* k) :=
      Quiver.Hom.op_inj (Spec.fullyFaithful.map_injective h2)
    apply AlgHom.ext
    intro b
    exact congrArg (fun g : CommRingCat.of B ⟶ CommRingCat.of k => g.hom b) h3
  · intro y
    obtain ⟨z, hz⟩ := (hpts _ _ y.1).1 ((RelativeGroupLaw.mem_torsionSubset _ _ _ _).1 y.2)
    have hz' : Spec.map (Spec.preimage z) = z := Spec.map_preimage z

    have hcomp : CommRingCat.ofHom (algebraMap S B) ≫ Spec.preimage z = CommRingCat.ofHom (algebraMap S k) := by
      apply Quiver.Hom.op_inj
      apply Spec.fullyFaithful.map_injective
      change Spec.map (CommRingCat.ofHom (algebraMap S B) ≫ Spec.preimage z) = Spec.map (CommRingCat.ofHom (algebraMap S k))
      rw [Spec.map_comp, hz', ← hι, ← Category.assoc, hz]
      exact y.1.2
    let ψ : B →ₐ[S] k :=
      { (Spec.preimage z).hom with
        commutes' := fun s => by
          have := congrArg (fun g : CommRingCat.of S ⟶ CommRingCat.of k => g.hom s) hcomp
          simpa using this }
    refine ⟨ψ, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    change Spec.map (CommRingCat.ofHom (ψ : B →+* k)) ≫ ι = y.1.1
    have : CommRingCat.ofHom (ψ : B →+* k) = Spec.preimage z := rfl
    rw [this, hz', hz]

theorem rankAtStalk_eq_natCard_algHom (B : Type) [CommRing B] [Algebra S B] [Module.Finite S B] [Algebra.Etale S B]
    (p : PrimeSpectrum S) (k : Type) [Field k] [IsAlgClosed k] [Algebra S k]
    [Algebra p.asIdeal.ResidueField k] [IsScalarTower S p.asIdeal.ResidueField k] :
    Module.rankAtStalk (R := S) B p = Nat.card (B →ₐ[S] k) := by
  classical
  let κ := p.asIdeal.ResidueField

  let q : PrimeSpectrum k := ⟨⊥, Ideal.isPrime_bot⟩
  have hq : q.comap (algebraMap S k) = p := by
    ext x
    change algebraMap S k x ∈ (⊥ : Ideal k) ↔ x ∈ p.asIdeal
    rw [Ideal.mem_bot, IsScalarTower.algebraMap_apply S κ k, map_eq_zero, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]
  have h1 : Module.rankAtStalk (R := S) B p = Module.rankAtStalk (R := k) (k ⊗[S] B) q := by
    rw [Module.rankAtStalk_baseChange, hq]
  have h2 : Module.rankAtStalk (R := k) (k ⊗[S] B) q = Module.finrank k (k ⊗[S] B) := by
    rw [Module.rankAtStalk_eq_finrank_of_free]
    rfl

  obtain ⟨hfin, hbij⟩ := Algebra.Etale.finite_and_bijective_lift_pi_algHom_of_isAlgClosed κ (κ ⊗[S] B) k
  haveI := hfin
  haveI : Fintype (WithConv ((κ ⊗[S] B) →ₐ[κ] k)) := Fintype.ofFinite _
  let e₁ : k ⊗[κ] (κ ⊗[S] B) ≃ₗ[k] (WithConv ((κ ⊗[S] B) →ₐ[κ] k) → k) :=
    LinearEquiv.ofBijective (Algebra.TensorProduct.lift (Algebra.ofId k (WithConv ((κ ⊗[S] B) →ₐ[κ] k) → k))
      (Pi.algHom κ _ fun ν : WithConv ((κ ⊗[S] B) →ₐ[κ] k) => (WithConv.ofConv ν : (κ ⊗[S] B) →ₐ[κ] k))
      (fun _ _ => Commute.all _ _)).toLinearMap hbij
  let e₀ : k ⊗[κ] (κ ⊗[S] B) ≃ₗ[k] k ⊗[S] B := TensorProduct.AlgebraTensorModule.cancelBaseChange S κ k k B
  have h3 : Module.finrank k (k ⊗[S] B) = Nat.card (WithConv ((κ ⊗[S] B) →ₐ[κ] k)) := by
    rw [← e₀.finrank_eq, e₁.finrank_eq, Module.finrank_pi, Nat.card_eq_fintype_card]
  have h4 : Nat.card (WithConv ((κ ⊗[S] B) →ₐ[κ] k)) = Nat.card (B →ₐ[S] k) :=
    Nat.card_congr ((WithConv.equiv _).trans (AlgHom.liftEquiv S κ B k).symm)
  rw [h1, h2, h3, h4]

theorem main
    {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle S f)
