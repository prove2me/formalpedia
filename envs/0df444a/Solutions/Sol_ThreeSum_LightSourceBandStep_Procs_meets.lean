theorem solution : ∀ {lim : Light.Limits} {P : Light.Program} {d pMain : Nat} (C : ThreeSum.LightSourceBandStep.Procs P pMain)
  {μ : Nat → Int} {src n g p m base U D i : Nat} {shift : Int} (f : Nat → Int),
  @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt lim.space) lim.word →
    @LT.lt.{0} Nat instLTNat
        (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) d
          (@OfNat.ofNat.{0} Nat (nat_lit 3) (instOfNatNat (nat_lit 3))))
        lim.depth →
      @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) g →
        @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) p →
          @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) m →
            @LT.lt.{0} Nat instLTNat i (ThreeSum.BandPartition.size n g) →
              @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src n) base →
                @LE.le.{0} Nat instLENat
                    (ThreeSum.LightSourceResidues.space (ThreeSum.SourceBandLayout.work base n g m) p U D) lim.space →
                  @LE.le.{0} Int Int.instLEInt (@abs.{0} Int instLatticeInt Int.instAddGroup shift)
                      (@Nat.cast.{0} Int instNatCastInt D) →
                    @LE.le.{0} Int Int.instLEInt
                        (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LightSourceBandStep.word n g p m U D)) lim.word →
                      (∀ (j : Nat),
                          @LT.lt.{0} Nat instLTNat j n →
                            @Eq.{1} Int (μ (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src j))
                              (f j)) →
                        (∀ (j : Nat),
                            @LT.lt.{0} Nat instLTNat j n →
                              @LE.le.{0} Int Int.instLEInt (@abs.{0} Int instLatticeInt Int.instAddGroup (f j))
                                (@Nat.cast.{0} Int instNatCastInt U)) →
                          Light.Meets lim P pMain d
                            (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt src)
                              (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt n)
                                (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt g)
                                  (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt p)
                                    (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt m)
                                      (@List.cons.{0} Int shift
                                        (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt base)
                                          (@List.cons.{0} Int
                                            (@Nat.cast.{0} Int instNatCastInt (ThreeSum.SourceBandLayout.cap n g))
                                            (@List.cons.{0} Int
                                              (@Nat.cast.{0} Int instNatCastInt (ThreeSum.BandPartition.size n g))
                                              (@List.cons.{0} Int
                                                (@Nat.cast.{0} Int instNatCastInt
                                                  (ThreeSum.SourceBandLayout.data base n g))
                                                (@List.cons.{0} Int
                                                  (@Nat.cast.{0} Int instNatCastInt
                                                    (ThreeSum.SourceBandLayout.stride n g m))
                                                  (@List.cons.{0} Int
                                                    (@Nat.cast.{0} Int instNatCastInt
                                                      (ThreeSum.SourceBandLayout.work base n g m))
                                                    (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt i)
                                                      (@List.nil.{0} Int))))))))))))))
                            μ (ThreeSum.LightSourceBandStep.time n g p m U D) fun (x : Int) (ν : Nat → Int) =>
                            And (ThreeSum.SourceBandData.At ν f base n g p m shift i)
                              (Light.KeptBut μ ν (ThreeSum.SourceBandLayout.hist base n g m i)
                                (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) base
                                  (@HMul.hMul.{0, 0, 0} Nat Nat Nat (@instHMul.{0} Nat instMulNat)
                                    (@OfNat.ofNat.{0} Nat (nat_lit 6) (instOfNatNat (nat_lit 6))) i))
                                (@OfNat.ofNat.{0} Nat (nat_lit 6) (instOfNatNat (nat_lit 6)))) := by
  exact @ThreeSum.LightSourceBandStep.Procs.meets_sourceProof

