def CL : List (List ℕ × CW) := CL0 ++ CL1 ++ CL2 ++ CL3 ++ CL4 ++ CL5 ++ CL6 ++ CL7 ++ CL8 ++ CL9

theorem CL_ok : (CL.all fun x => cCheck x.1 x.2) = true := by decide +kernel

theorem CL_length : CL.length = 2458 := by decide +kernel

/-- Every archived `central` (S) leaf: its image lies in `1/10 ≤ a`. -/
theorem central_leaves : ∀ x ∈ CL, ∀ a b E : ℝ, CKLaneG3.InS (CKLaneG3.sBox x.1) a b E → 1 / 10 ≤ a :=
  cLeaves_of_list CL CL_ok

/-- Given the CentralSquare row, every archived `central` (S) leaf carries the canonical SS_Compact-row
obligation `CKLaneG3.SLeafOK` (via `CKLaneG3.sLeafOK_of_central`). Conditional on the row, by design. -/
theorem central_leavesOK (hcs : CKLaneG3.CentralSquareRow) :
    ∀ x ∈ CL, CKLaneG3.SLeafOK (CKLaneG3.sBox x.1) :=
  cLeavesOK_of_list CL CL_ok hcs

end CKLaneG1.SCentralLeaves

