theorem solution (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : 106 ≤ s.im) (hb : s.im ≤ 107) :
    (40:ℝ) ≤ (TaoFivePrimes_RHLocalRoundedPolynomial
      TaoFivePrimes_RH106To107RoundedCoefficients 40 (213/2) s).re :=
  Slice106.polynomial_positive s h0 h1 ha hb
