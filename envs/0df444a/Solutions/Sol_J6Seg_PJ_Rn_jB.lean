variable {v : Vr} {P : ℕ}

theorem den_mx0E (x : E) : (mx0E x).den v = ((x.den v).toNat : ℤ) := by
  simp only [mx0E, E.den]; split_ifs <;> omega

theorem den_bOfE {s t : ℕ} (h22 : v 22 = s) (h23 : v 23 = t) (l : E) :
    (bOfE l).den v = IntMul.HvdH.bOf s t (l.den v) := by
  simp only [bOfE, E.den, h22, h23, IntMul.HvdH.bOf]; ring_nf

theorem den_ltE (x y : E) : (ltE x y).den v = if x.den v < y.den v then 1 else 0 := by
  simp only [ltE, E.den]; split_ifs <;> omega

