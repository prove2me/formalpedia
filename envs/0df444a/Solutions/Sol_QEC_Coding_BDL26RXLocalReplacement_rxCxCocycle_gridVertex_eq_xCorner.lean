namespace QEC.Coding.BDL26RXLocalReplacement
theorem _root_.solution
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (i j : Fin (S.half + 1))
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, subdivisionGridVertex P x S face i j) =
      word (copy, Sum.inl (xStarFaceXVertex P x face)) := by
  have hvertical := rxCxCocycle_gridVertical_eq_zero
    P x S copy face i word hword j.1 (by omega)
  have hhorizontal := rxCxCocycle_gridHorizontal_eq_zero
    P x S copy face word hword i.1 (by omega)
  calc
    word (copy, subdivisionGridVertex P x S face i j) =
        word (copy, subdivisionGridVertex P x S face i 0) := by
      simpa using hvertical
    _ = word (copy, subdivisionGridVertex P x S face 0 0) := by
      simpa using hhorizontal
    _ = word (copy, Sum.inl (xStarFaceXVertex P x face)) := by
      simp [subdivisionGridVertex]
end QEC.Coding.BDL26RXLocalReplacement
