-- title:
--   Packed integer tables for the degree-251 cubic–quintic certificate
-- statement:
--   Each Hermite weight row and covariance-polynomial row at cutoff 251 has simple integer interval endpoints. Two nonnegative integers encode the positive and negative lower endpoints as base $2^{320}$ digits. The spacing allows exact recovery of the signed convolution from a single evaluation. A third encodes the widths, using base two for the weights and 256 for the polynomial powers. The published definitions reconstruct ordinary interval arrays and list the candidate signed convolution coefficients before rounding. These data support independent verification of both the recurrences and the endpoint comparisons.
-- source:
--   Degree-251 fixed-point Hermite certificate for the cubic–quintic scheme of Saha et al., arXiv:2608.11158v2, and Prove2Me fc28e7f8-2588-498a-8ea6-e8d0e220ae2b.

import Definitions.Def_GrothendieckLB_Supplement_cqNonlinearHeadCheck
import Mathlib.Tactic.Eval

namespace GrothendieckLB.Supplement.CQDegree251
open CQHeadArithmetic

/-- A polynomial row encoded by nonnegative magnitudes in two sign classes
and its outward interval widths. All fields contain ordinary natural numbers. -/
structure PackedRow where
  pos : ℕ
  neg : ℕ
  wid : ℕ
  deriving Inhabited, Lean.ToExpr

def radix : ℕ := 2^320

def digit (base word i : ℕ) := word / base^i % base

def low (alternating : Bool) (r : PackedRow) (i : ℕ) : ℤ :=
  (if alternating then (-1:ℤ)^i else 1) *
    ((digit radix r.pos i : ℤ) - digit radix r.neg i)

def cell (alternating : Bool) (sizeWidth : ℕ) (r : PackedRow) (i : ℕ) : Interval :=
  let a := low alternating r i
  ⟨a, a + (digit sizeWidth r.wid i : ℤ)⟩

private def pack (alternating : Bool) (sizeWidth : ℕ) (xs : Array Interval) : PackedRow := Id.run do
  let mut pos := 0
  let mut neg := 0
  let mut wid := 0
  for j in [:xs.size] do
    let i := xs.size-1-j
    let x := xs[i]!
    let v := if alternating && i%2=1 then -x.lo else x.lo
    pos := v.toNat + radix*pos
    neg := (-v).toNat + radix*neg
    wid := (x.hi-x.lo).toNat + sizeWidth*wid
  return ⟨pos,neg,wid⟩

private def initFast (N : Nat) (raw : Array MomentCombination) : Array MomentCombination := Id.run do
  let len := 3*N+1
  let mut fact := #[1]
  let mut dbl := #[1,1]
  for i in [:len] do
    fact := fact.push ((i+1)*fact[i]!)
    dbl := dbl.push ((i+2)*dbl[i]!)
  let mut ini := #[]
  for b in [:len] do
    let mut sum := zeroCombination
    if b%2=0 then
      for t in [:b/2+1] do
        let k := 2*t
        let d := b-k
        let mag : Nat := dbl[d-1]! * (fact[b]! / (fact[k]! * fact[d]!))
        let coeff : Int := if d%4 = 0 then mag else -(mag:Int)
        sum := addCombination sum (scaleCombination coeff raw[k]!)
    ini := ini.push sum
  return ini


private def weightCandidates (N : ℕ) : Array PackedRow :=
  let xs := initFast N (momentRows (3*N-5))
  (grid N xs N).weights.map (pack true 2)

set_option maxRecDepth 150000
set_option exponentiation.threshold 50000
set_option maxHeartbeats 300000000

/-- Candidate Hermite weight rows through degree 251. -/
noncomputable def wp : Array PackedRow := eval% (weightCandidates 251)

/-- Candidate rows for powers of the covariance polynomial through degree 251. -/
noncomputable def rp : Array PackedRow := eval% ((rhoPowers 251 251).map (pack false 256))

def wrow (p : PackedRow) (n : ℕ) := tab n (cell true 2 p)
def rrow (p : PackedRow) (n : ℕ) := tab n (cell false 256 p)

noncomputable def weights : Array (Array Interval) := tab 252 (fun a => wrow (entry default wp a) (252-a))
noncomputable def powers : Array (Array Interval) := tab 252 (fun a => rrow (entry default rp a) 252)

