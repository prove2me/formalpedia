private theorem _root_.AlgebraicCurve.RegularProlongation.pointwiseOn_semiSmul (hA : ∀ x : L, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hres : ∀ a : A, IsLocalRing.residue A ⟨SemilinearAut.baseAut g a, (hA a).mpr a.2⟩ = IsLocalRing.residue A a)
    {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} (h : R.PointwiseOn Q D) :
    R.PointwiseOn (R.semiResAut g hg hA hres • Q) (SemilinearAut.semiSmulDisc g D) := by
  intro P hP hPr f hf hreg
  set φ := R.semiResAut g hg hA hres with hφ
  have hf' : g⁻¹ • f ∈ R.integers := (R.inv_smul_mem_integers_iff g hg f).mpr hf
  have hPr' : (g⁻¹ • P).IsRational := (SemilinearAut.PlaceTransport.isRational_smul_iff g⁻¹ P).mpr hPr
  obtain ⟨hm₀, h₀, e₀⟩ := h _ hP hPr' (g⁻¹ • f) hf' (SemilinearAut.forall_mem_of_forall_mem_semiSmul g hreg)
  have hresid : φ (R.residue ⟨g⁻¹ • f, hf'⟩) = R.residue ⟨f, hf⟩ := R.semiResAut_residue_inv_smul g hg hA hres ⟨f, hf⟩
  have hm : (R.residue ⟨f, hf⟩ : Fbar) ∈ (φ • Q).toValuationSubring := by
    rw [← hresid]; exact (Place.Transport.mem_smul_iff' φ Q _).mpr hm₀
  have hev : P.evalAt f = SemilinearAut.baseAut g ((g⁻¹ • P).evalAt (g⁻¹ • f)) := by
    have e := SemilinearAut.PlaceTransport.evalAt_smul g (g⁻¹ • P) hPr' (g⁻¹ • f)
    rwa [smul_inv_smul, smul_inv_smul] at e
  have hxA : P.evalAt f ∈ A := by rw [hev]; exact (hA _).mpr h₀
  refine ⟨hm, hxA, ?_⟩
  have e₁ := congrArg (Place.smulResidueAlgEquiv φ Q) e₀
  rw [AlgEquiv.commutes] at e₁
  have hresA : IsLocalRing.residue A ⟨P.evalAt f, hxA⟩ =
      IsLocalRing.residue A ⟨(g⁻¹ • P).evalAt (g⁻¹ • f), h₀⟩ := by
    rw [← hres ⟨(g⁻¹ • P).evalAt (g⁻¹ • f), h₀⟩]
    congr 1
    exact Subtype.ext hev
  rw [hresA, e₁, ← Place.Transport.residue_smul φ Q hm₀ (by rw [hresid]; exact hm)]
  congr 1
  exact Subtype.ext hresid

