    fun t => if t = 0 then d else c0 (-(t + 1)).toNat, r, hr, ?_⟩
  have h0not : (0 : ℤ) ∉ (Finset.range N).image (fun j : ℕ => -((j : ℤ) + 1)) := by
    simp only [Finset.mem_image, Finset.mem_range]
