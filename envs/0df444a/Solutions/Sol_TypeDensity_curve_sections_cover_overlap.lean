/-- Every element of the overlap is, modulo the `n`-th power of the exceptional ideal, a
difference `a - β(b)` of functions on the two charts. -/
private theorem two_chart_additive_approximation (R : Type) [CommRing R] (t x : R)
    (hreg : RegularParameterPair R t x) (beta : (BlowupChart R x t) →+* (BlowupOverlap R t x))
    (hbase : ∀ r : R, beta (chartBase R x t r) =
      (algebraMap (BlowupChart R t x) (BlowupOverlap R t x)) (chartBase R t x r))
    (hslope : beta (chartSlope R x t) = IsLocalization.Away.invSelf (chartSlope R t x)) (n : ℕ)
    (w : (BlowupOverlap R t x)) :
    ∃ a : (BlowupChart R t x), ∃ b : (BlowupChart R x t),
      w - ((algebraMap (BlowupChart R t x) (BlowupOverlap R t x)) a - beta b) ∈
        (Ideal.span {(algebraMap (BlowupChart R t x) (BlowupOverlap R t x))
          (chartBase R t x t)})^n := by
  induction n with
  | zero => exact ⟨0, 0, by simp⟩
  | succ n ih =>
    obtain ⟨a, b, hab⟩ := ih
    obtain ⟨c, d, -, -, hcd⟩ := two_chart_layer_correction R t x hreg beta hbase
      hslope n 0 (Nat.zero_le _) _ hab
    refine ⟨a + c, b + d, ?_⟩
    simp only [pow_zero, one_mul] at hcd
    convert hcd using 1
    rw [map_add, map_add]; ring

end TypeDensity

open TypeDensity

theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hreg : TypeDensity.RegularParameterPair R t x) (j : ℕ) (c : TypeDensity.BlowupOverlap R t x) :
    ∃ p ∈ TypeDensity.curveSections R t x beta G j, TypeDensity.fullCechDifferential R t x beta 0 p -
      (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j) * c ∈
      (Ideal.span {TypeDensity.overlapException R t x})^j := by
  obtain ⟨a, b, hab⟩ := TypeDensity.two_chart_additive_approximation R t x hreg
    (beta.right : TypeDensity.BlowupChart R x t →+* TypeDensity.BlowupOverlap R t x) (TypeDensity.beta_right_chartBase beta)
    beta.slope j
    ((algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j) * c)
  have hdiff : TypeDensity.fullCechDifferential R t x beta 0 (a, b)
      = (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) a - beta.right b := by
    simp [TypeDensity.fullCechDifferential, TypeDensity.ringCechDifferential]
  have key : TypeDensity.fullCechDifferential R t x beta 0 (a, b)
      - (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j) * c
      ∈ (Ideal.span {TypeDensity.overlapException R t x})^j := by
    rw [hdiff]
    have := (Ideal.neg_mem_iff _).2 hab
    convert this using 1
    · rfl
    · change _ - beta.right b - _ = -(_ - (_ - beta.right b)); ring
  refine ⟨(a, b), ?_, key⟩
  change TypeDensity.fullCechDifferential R t x beta 0 (a, b) ∈ TypeDensity.overlapCurveIdeal R t x beta G j
  have : TypeDensity.fullCechDifferential R t x beta 0 (a, b)
      = (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j) * c
        + (TypeDensity.fullCechDifferential R t x beta 0 (a, b)
          - (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j) * c) := by ring
  rw [this]
  exact Ideal.add_mem _
    (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)))
    (Ideal.mem_sup_right key)
