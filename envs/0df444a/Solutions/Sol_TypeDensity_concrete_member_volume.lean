theorem solution (m : TypeDensity.ConcreteMember) :
    m.toMeasured.μ m.toMeasured.stateSet = TypeDensity.densityValue (TypeDensity.stateVolume m.s) m.toMeasured.q := by
  rw [← Set.univ_inter m.toMeasured.stateSet, ← (TypeDensity.concrete_member_measure_finite_support m).2]
  obtain ⟨O, htop, pi, hpi, u, a0, b0, ha, S, hS_pi, hS_t, hS_x, hS_a, hS_b, s, shape, atlas⟩ := m
  have hq : 2 ≤ Nat.card (ResidueField O) := Finite.one_lt_card_iff_nontrivial.2 inferInstance
  cases s with
  | single a c =>
    obtain ⟨rfl, rfl, hc⟩ := shape
    obtain ⟨e, he⟩ := TypeDensity.concrete_surface_special_fiber_equiv O pi hpi u a 0
    obtain ⟨A', hA'⟩ := TypeDensity.concrete_single_state_volume O pi hpi u a ha S hS_pi hS_t hS_a hS_b e he c
        hc htop
    obtain ⟨hp0, hpm⟩ := TypeDensity.surface_vertical_parameter O (TypeDensity.ConcreteSurface O pi u a 0) S
    rw [hS_pi] at hp0 hpm
    have := TypeDensity.division_coordinate_module_isAdicComplete O pi hpi u a 0 ha (a*c)
    refine (TypeDensity.stateMeasure_univ_of_atlas O _ htop S.pi pi hS_pi hpi hp0 hpm (a*c) _ atlas A'
      _ hA').trans ?_
    exact (TypeDensity.density_value_arith _ hq (.const 1) (.const 1) (by simp [TypeDensity.Expr.eval])
      (by simp [TypeDensity.Expr.eval]) c (TypeDensity.State.single 1 1) ⟨Nat.one_pos, Nat.one_pos⟩).2.2.1.symm
  | crossing a b c h =>
    obtain ⟨rfl, rfl, hb, hc, hh⟩ := shape
    obtain ⟨e, he⟩ := TypeDensity.concrete_surface_special_fiber_equiv O pi hpi u a b
    obtain ⟨A', hA'⟩ := TypeDensity.concrete_crossing_state_volume O pi hpi u a b ha hb S hS_pi hS_t hS_x hS_a
        hS_b e he c h hc hh htop
    obtain ⟨hp0, hpm⟩ := TypeDensity.surface_vertical_parameter O (TypeDensity.ConcreteSurface O pi u a b) S
    rw [hS_pi] at hp0 hpm
    have := TypeDensity.division_coordinate_module_isAdicComplete O pi hpi u a b ha (a*c+b*h)
    refine (TypeDensity.stateMeasure_univ_of_atlas O _ htop S.pi pi hS_pi hpi hp0 hpm (a*c+b*h) _
      atlas A' _ hA').trans ?_
    have hq1 : (1 : ℚ) ≤ (Nat.card (ResidueField O) : ℚ) := by exact_mod_cast (by omega)
    have hdv := TypeDensity.density_value_arith _ hq TypeDensity.eminusOne (.inv (.pow .var (c+h)))
      (by simp [TypeDensity.eminusOne, TypeDensity.Expr.sub, TypeDensity.Expr.neg, TypeDensity.Expr.eval]; linarith)
      (by simp only [TypeDensity.Expr.eval, TypeDensity.expression_pow_eval]; positivity) (c+h) (TypeDensity.State.single 1 1)
      ⟨Nat.one_pos, Nat.one_pos⟩
    have hem : TypeDensity.densityValue TypeDensity.eminusOne (Nat.card (ResidueField O)) =
        (Nat.card (ResidueField O) : ℝ≥0∞) - 1 := by
      simp only [TypeDensity.densityValue, TypeDensity.eminusOne, TypeDensity.Expr.sub, TypeDensity.Expr.neg, TypeDensity.Expr.eval]
      push_cast
      rw [show ((Nat.card (ResidueField O) : ℝ) + -1 * 1) =
        (Nat.card (ResidueField O) : ℝ) - 1 by ring,
        ENNReal.ofReal_sub _ zero_le_one, ENNReal.ofReal_natCast, ENNReal.ofReal_one]
    change _ = TypeDensity.densityValue (TypeDensity.stateVolume (.crossing a b c h)) (Nat.card (ResidueField O))
    rw [TypeDensity.stateVolume, hdv.1, hdv.2.2.1, hem]
