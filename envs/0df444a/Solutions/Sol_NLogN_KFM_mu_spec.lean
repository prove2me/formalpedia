open IntMul.OpenAI.Glue IntMul.OpenAI.RCost
theorem solution (P s : ℕ) (hs : 1 ≤ s) (hc : Nat.Coprime P s) :
    NLogN.KFM.muInv P s < s ∧ (NLogN.KFM.muInv P s * P) % s = 1 % s := by
  have hs0 : (0 : ℤ) < s := by exact_mod_cast hs
  have hnn : 0 ≤ Nat.gcdA P s % (s : ℤ) := Int.emod_nonneg _ hs0.ne'
  have hlt : Nat.gcdA P s % (s : ℤ) < s := Int.emod_lt_of_pos _ hs0
  have hcast : ((NLogN.KFM.muInv P s : ℕ) : ℤ) = Nat.gcdA P s % (s : ℤ) := by
    unfold NLogN.KFM.muInv; exact Int.toNat_of_nonneg hnn
  refine ⟨by omega, ?_⟩
  have hb := Nat.gcd_eq_gcd_ab P s
  rw [hc.gcd_eq_one] at hb
  have key : ((NLogN.KFM.muInv P s : ℤ) * P) % s = 1 % s := by
    rw [hcast, Int.mul_emod, Int.emod_emod_of_dvd _ (dvd_refl _), ← Int.mul_emod]
    have e : Nat.gcdA P s * (P : ℤ) = 1 - s * Nat.gcdB P s := by
      push_cast at hb; linarith
    rw [e]
    exact Int.emod_eq_emod_iff_emod_sub_eq_zero.2 (by
      rw [show 1 - (s : ℤ) * Nat.gcdB P s - 1 = (s : ℤ) * (-Nat.gcdB P s) by ring]
      exact Int.mul_emod_right _ _)
  exact_mod_cast key
end
