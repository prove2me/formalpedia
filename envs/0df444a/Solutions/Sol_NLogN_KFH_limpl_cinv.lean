  · exact (h z hz).2

theorem GB.sub {w : ℕ} {zs zs' : List GI} (h : NLogN.KFB.GB w zs) (hs : ∀ z ∈ zs', z ∈ zs) : NLogN.KFB.GB w zs' :=
