theorem solution {q i j t1 t2 t3 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqt1 : q ≠ t1)
    (hqt2 : q ≠ t2) (hqt3 : q ≠ t3) (hij : i ≠ j) (hit1 : i ≠ t1) (hit2 : i ≠ t2) (hit3 : i ≠ t3)
    (hjt1 : j ≠ t1) (hjt2 : j ≠ t2) (hjt3 : j ≠ t3) (ht12 : t1 ≠ t2) (ht13 : t1 ≠ t3)
    (ht23 : t2 ≠ t3) {stop : Sym} (hs0 : stop ≠ 0) (hs1 : stop ≠ 1) (σ : St S) (W : List Bool)
    (hk : ∀ k (hk : k < W.length), I.getD (σ.ip + k) codeEnd = codeBit W[k])
    (hstop : I.getD (σ.ip + W.length) codeEnd = stop)
    (ht1 : bitOf (σ.stk t1).head? = none) (ht2 : bitOf (σ.stk t2).head? = none)
    (ht3 : bitOf (σ.stk t3).head? = none) :
    Runs I prog (NLogN.readR q i j t1 t2 t3 stop : Stmt S P) σ
      (((σ.set i ((Item.int (val W : ℤ)).enc ++ σ.stk i)).set j
        ((Item.int ((2 : ℤ) ^ W.length)).enc ++ σ.stk j)).setIp (σ.ip + W.length + 1))
      (readRCost W.length) := by
  unfold NLogN.readR
  have h1 := Runs.readUntil (I := I) (prog := prog) hqt1 stop σ (W.map codeBit)
    (by intro h; obtain ⟨b, _, hb⟩ := List.mem_map.mp h; exact codeBit_ne_of hs0 hs1 b hb)
    (by intro k hk'; simp only [List.getElem_map]; exact hk k (by simpa using hk'))
    (by simpa using hstop)
  simp only [List.length_map] at h1
  set σ1 := (σ.set t1 ((W.map codeBit).reverse ++ σ.stk t1)).setIp (σ.ip + W.length + 1)
  have h2 := Runs.push (I := I) (prog := prog) σ1 j 1
  set σ2 := σ1.push j 1
  have h3 := Runs.zip (I := I) (prog := prog) (q := q) (a := t2) (b := t1) (d := j) (e := t3)
    hqt2 hqt1 hqj hqt3 (Ne.symm ht12) (Ne.symm hjt2) ht23 (Ne.symm hjt1) ht13 hjt3
    true fZero finNone (σ.stk t2) (σ.stk t1) ht2 ht1 0 (fun _ => le_rfl) σ2 [] W.reverse false
    (by simp [σ2, σ1, Ne.symm hjt2, ht12, Ne.symm ht12])
    (by simp [σ2, σ1, Ne.symm hjt1, List.map_reverse])
  rw [zipL_zero] at h3
  set σ3 := (((σ2.set t2 (σ.stk t2)).set t1 (σ.stk t1)).set j
    (pushAll (finNone (zipL fZero false [] W.reverse).2)
      (((List.replicate W.reverse.length false).map codeBit).reverse ++ σ2.stk j))).set t3
    (if true = true then (W.reverse.map codeBit).reverse ++ σ2.stk t3 else σ2.stk t3)
  have h4 := Runs.push (I := I) (prog := prog) σ3 j hdPos
  set σ4 := σ3.push j hdPos
  have h5 := Runs.trimTop (I := I) (prog := prog) (t := t3) σ4 W.reverse (σ.stk t3)
    (by simp [σ4, σ3, σ2, σ1, Ne.symm hjt3, Ne.symm ht13]) ht3
  set σ5 := σ4.set t3 (((trimL W.reverse).map codeBit).reverse ++ σ.stk t3)
  have h6 := Runs.moveBits (I := I) (prog := prog) hqt3 hqi (Ne.symm hit3) σ5
    (trimL W.reverse).reverse (σ.stk t3) (by simp [σ5, List.map_reverse]) ht3
  set σ6 := (σ5.set t3 (σ.stk t3)).set i
    (((trimL W.reverse).reverse.map codeBit).reverse ++ σ5.stk i)
  have h7 := Runs.push (I := I) (prog := prog) σ6 i hdPos
  refine Runs.mono' (Runs.seq h1 (Runs.seq h2 (Runs.seq h3 (Runs.seq h4 (Runs.seq h5
    (Runs.seq h6 h7)))))) ?_ ?_
  · clear h1 h2 h3 h4 h5 h6 h7
    have hv : trimL W.reverse = nbits (val W) := by rw [← nbits_wval, val_eq_wval]
    have hpos : hdOf (val W : ℤ) = hdPos := by unfold hdOf; rw [if_neg (by omega)]
    rw [St.ext_iff']; refine ⟨fun x => ?_, by simp [σ6, σ5, σ4, σ3, σ2, σ1], by
      simp [σ6, σ5, σ4, σ3, σ2, σ1]⟩
    by_cases hxi : x = i
    · subst hxi
      simp [σ6, σ5, σ4, σ3, σ2, σ1, hit1, hit2, hit3, hij, Item.enc, hv, hpos, zbits,
        List.map_reverse]
    by_cases hxj : x = j
    · subst hxj
      rw [St.setIp_stk, St.set_stk, if_pos rfl, ruler_enc]
      simp [σ6, σ5, σ4, σ3, σ2, σ1, hjt1, hjt2, hjt3, Ne.symm hij, finNone, pushAll,
        codeBit_false, codeBit_replicate]
    simp only [σ6, σ5, σ4, σ3, σ2, σ1, St.push_stk, St.set_stk, St.setIp_stk, hxj, hxi, if_false]
    split_ifs <;> simp_all
  · have := length_trimL_le W.reverse
    simp only [readRCost, moveCost, List.length_reverse, List.length_nil,
      max_eq_right (Nat.zero_le _)] at *
    nlinarith
