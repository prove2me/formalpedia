      (by rw [mul_left_comm]; exact Nat.mul_le_mul_left _ hT')
  -- the table
  have hQ : 2 * T / 2 ^ h * (d + 1) ≤ 2 * T :=
    le_trans (Nat.mul_le_mul_left _ hdh) (Nat.div_mul_le_self _ _)
  have hTab : (d / 2 + 1) * cTab d (2 * T / 2 ^ h) Z (Z + 1) ≤ 10 ^ 10 * (14 * ((d + 1) * T * p)) := by
    generalize 2 * T / 2 ^ h = Q at hQ ⊢
    generalize d / 2 + 1 = D at hD ⊢
    have c1 : D * ((d + 1) * (Z + 2) ^ 2) ≤ (d + 1) * T := Nat.mul_le_mul hD a1
    have c2 : D * (Q * (d + 1) * (Z + 1 + 2)) ≤ (d + 1) * (2 * T * (3 * p + 3)) :=
      Nat.mul_le_mul hD (Nat.mul_le_mul hQ (by omega))
    have c3 : D * ((d + 1) * (Z + 1 + 2)) ≤ (d + 1) * T := Nat.mul_le_mul hD a3
    unfold cTab
    have e : D * (10 ^ 10 * (d + 1) * ((Z + 2) ^ 2 + (Q + 1) * (Z + 1 + 2))) =
        10 ^ 10 * (D * ((d + 1) * (Z + 2) ^ 2) + D * (Q * (d + 1) * (Z + 1 + 2)) +
          D * ((d + 1) * (Z + 1 + 2))) := by ring
    rw [e]; apply Nat.mul_le_mul_left; omega
  -- assemble
  have eL : (d / 2 + 1) * (cTab d (2 * T / 2 ^ h) Z (Z + 1) + 68 * kap (p + 2) * (2 * T) + 8 * Z + 8 +
      5 * U + 3000) = (d / 2 + 1) * cTab d (2 * T / 2 ^ h) Z (Z + 1) +
      (d / 2 + 1) * (68 * kap (p + 2) * (2 * T)) + (d / 2 + 1) * (8 * Z + 8 + 5 * U + 3000) := by
