set_option autoImplicit false
suppress_compilation
variable {K : Type*} [Field K] {R : Subring K}
open BruhatTits
open Pointwise
open IsLocalRing
set_option synthInstance.maxHeartbeats 30000
namespace BruhatTits
theorem _root_.solution (g : GL (Fin 2) K) {l : List (BruhatTits.Lattice R)} (hl : l.IsSimpleChain) :
    (g • l).IsSimpleChain where
  ne_nil := by
    rw [List.smul_lattice_def]
    simpa using hl.ne_nil
  isStandardNeighbour := by
    rw [List.smul_lattice_def]
    apply List.chain'_map_of_chain' _ ?_ hl.isStandardNeighbour
    exact smul_isStandardNeighbour g
  no_backtrack := by
    rw [List.smul_lattice_def]
    repeat rw [← List.map_tail]
    rw [List.zipWith₃_map]
    simp_rw [smul_isSimilar_iff]
    exact hl.no_backtrack
end BruhatTits
