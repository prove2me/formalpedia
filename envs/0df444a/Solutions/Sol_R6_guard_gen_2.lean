-- Source module: Solutions.R6Guard
/-!
# Round six: the crude depth guard (PR15 REPORT part B, ARCH G1)

`A e` is the coefficient-dependency depth of a `C`-layer of width `e` (OpenAI §5.4).  At width
`e ≥ T` a node is a sequence of at most `s` child invocations, each of width `≤ (m-1)e/m`
(stated as `m * c ≤ (m-1) * e`), plus `E` arithmetic of its own:
`A e ≤ E + Σ_{c ∈ cs} A c`.  Below the threshold `T` the depth is at most `L`.

* `R6.guard_gen`: `A e ≤ (E+L) (2 s^{max 0 (m (log e - log T) + 1)} - 1)` (any `s ≥ 2`).
* `R6.crude_guard`: with `T = d^β`, `L = 8 d^β`, for `e ≤ d`:
  `A e ≤ 2 (E + 8 d^β) s^{1 + m (1-β) log d}`.
* `R6.crude_guard_single`: the same for the one-child form `A e ≤ E + s A ((m-1) e / m)`.
* `R6.crude_guard_pow`: `A e ≤ C₀ d^{β + m(1-β) log s}`, `C₀ = 2 s (E+8)`.
* `R6.crude_guard_C1`, `R6.crude_guard_nat`: `A e ≤ C₀ d^{C1}` for `C1 ≥ 2 + m log s`
  (natural-number form for a guard width `Δ = C₀ d^{C1}`).
* `R6.level_unroll`: the level-indexed form `D (k+1) ≤ E + s D k` (the shape of `KFN.Eb L s`):
  `D k ≤ (E + D 0) (2 s^k - 1)`.

`s ≥ 2` is needed (for `s = 1` the depth is `≈ k E`, not `O(E)`).
-/

namespace R6

open Real

/-- `log c ≤ log e - 1/m` for `0 < c` and `m c ≤ (m-1) e`. -/
lemma log_child_le {m c e : ℕ} (hm : 2 ≤ m) (hc : 0 < c) (hce : m * c ≤ (m - 1) * e) :
    Real.log c ≤ Real.log e - 1 / m := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hcast : (m : ℝ) * c ≤ ((m : ℝ) - 1) * e := by
    have : ((m * c : ℕ) : ℝ) ≤ (((m - 1) * e : ℕ) : ℝ) := by exact_mod_cast hce
    push_cast [Nat.cast_sub (by omega : 1 ≤ m)] at this
    linarith
  have hc0 : (0 : ℝ) < c := by exact_mod_cast hc
  have he0 : (0 : ℝ) < e := by
    by_contra h
    rw [not_lt] at h
    have h2m : (2:ℝ) ≤ m := by exact_mod_cast hm
    have : ((m : ℝ) - 1) * e ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (by linarith) h
    nlinarith
  have h2m : (2:ℝ) ≤ m := by exact_mod_cast hm
  have hr0 : (0 : ℝ) < ((m : ℝ) - 1) / m := div_pos (by linarith) hm0
  have h1 : (c : ℝ) ≤ ((m : ℝ) - 1) / m * e := by
    rw [div_mul_eq_mul_div, le_div_iff₀ hm0]; linarith
  have h2 := Real.log_le_log hc0 h1
  rw [Real.log_mul hr0.ne' he0.ne'] at h2
  have h3 := Real.log_le_sub_one_of_pos hr0
  have h4 : ((m : ℝ) - 1) / m - 1 = -(1 / m) := by field_simp; ring
  linarith

/-- **Generic crude guard.** -/
theorem guard_gen_sol_aux (E L T : ℝ) (s m : ℕ) (A : ℕ → ℝ) (hm : 2 ≤ m) (hs : 2 ≤ s) (hE : 0 ≤ E)
    (hL : 0 ≤ L) (hT : 0 < T)
    (hrec : ∀ e : ℕ, T ≤ e → ∃ cs : List ℕ, cs.length ≤ s ∧ (∀ c ∈ cs, m * c ≤ (m - 1) * e) ∧
      A e ≤ E + (cs.map A).sum)
    (hleaf : ∀ e : ℕ, (e : ℝ) < T → A e ≤ L) :
    ∀ e : ℕ, A e ≤ (E + L) * (2 * (s : ℝ) ^ (max 0 (m * (Real.log e - Real.log T) + 1)) - 1) := by
  have hs1 : (1 : ℝ) ≤ s := by exact_mod_cast (by omega : 1 ≤ s)
  have hs2 : (2 : ℝ) ≤ s := by exact_mod_cast hs
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  have hEL : 0 ≤ E + L := by linarith
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  by_cases he : (e : ℝ) < T
  · have h1 : (1 : ℝ) ≤ (s : ℝ) ^ (max 0 (m * (Real.log e - Real.log T) + 1)) :=
      Real.one_le_rpow hs1 (le_max_left _ _)
    have := hleaf e he
    nlinarith
  · rw [not_lt] at he
    obtain ⟨cs, hlen, hcs, hA⟩ := hrec e he
    set y := (m : ℝ) * (Real.log e - Real.log T) with hy
    have he0 : (0 : ℝ) < e := lt_of_lt_of_le hT he
    have hy0 : 0 ≤ y := by
      have := Real.log_le_log hT he
      have : 0 ≤ Real.log e - Real.log T := by linarith
      positivity
    set u := (s : ℝ) ^ y with hu
    have hu1 : 1 ≤ u := Real.one_le_rpow hs1 hy0
    have hchild : ∀ c ∈ cs, A c ≤ (E + L) * (2 * u - 1) := by
      intro c hc
      have hce := hcs c hc
      by_cases hcT : (c : ℝ) < T
      · have := hleaf c hcT
        nlinarith
      · rw [not_lt] at hcT
        have hc0 : 0 < c := by
          have : (0 : ℝ) < c := lt_of_lt_of_le hT hcT
          exact_mod_cast this
        have he1 : 1 ≤ e := by
          rcases Nat.eq_zero_or_pos e with h | h
          · subst h; simp at hce; omega
          · exact h
        have hclt : c < e := by
          have : m * c ≤ m * e - e := by rw [Nat.sub_mul, one_mul] at hce; exact hce
          have : m * c < m * e := by
            have : e ≤ m * e := Nat.le_mul_of_pos_left _ (by omega)
            omega
          exact Nat.lt_of_mul_lt_mul_left this
        have hih := ih c hclt
        have hlog := log_child_le hm hc0 hce
        have hfc : max 0 ((m : ℝ) * (Real.log c - Real.log T) + 1) ≤ y := by
          apply max_le hy0
          have : (m : ℝ) * (Real.log c - Real.log T) ≤ m * (Real.log e - 1 / m - Real.log T) :=
            mul_le_mul_of_nonneg_left (by linarith) hm0.le
          have h2 : (m : ℝ) * (Real.log e - 1 / m - Real.log T) = y - 1 := by
            rw [hy]; field_simp; ring
          linarith
        have hpow : (s : ℝ) ^ (max 0 ((m : ℝ) * (Real.log c - Real.log T) + 1)) ≤ u :=
          Real.rpow_le_rpow_of_exponent_le hs1 hfc
        calc A c ≤ _ := hih
          _ ≤ (E + L) * (2 * u - 1) := by gcongr
    have hsum : (cs.map A).sum ≤ s * ((E + L) * (2 * u - 1)) := by
      have h1 := List.sum_le_card_nsmul (cs.map A) ((E + L) * (2 * u - 1))
        (by intro x hx; obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hx; exact hchild c hc)
      rw [List.length_map, nsmul_eq_mul] at h1
      have hB : 0 ≤ (E + L) * (2 * u - 1) := by nlinarith
      have : (cs.length : ℝ) ≤ s := by exact_mod_cast hlen
      nlinarith
    have hmax : max 0 (y + 1) = y + 1 := max_eq_right (by linarith)
    rw [hmax, Real.rpow_add_one (by positivity : (s : ℝ) ≠ 0), ← hu]
    nlinarith

end R6

