  (D : L1aData E N)

theorem hNS : IsUnit ((N : ℕ) : S) := Fact.out

theorem isUnit_mapM {T : Type} [CommRing T] (φ : S →+* T) : IsUnit ((N * N₀ : ℕ) : T) := by
  have h := ((hNS (S := S) (N := N)).mul (Fact.out : IsUnit ((N₀ : ℕ) : S))).map φ
  rwa [← Nat.cast_mul, map_natCast] at h

theorem isUnit_map {T : Type} [CommRing T] (φ : S →+* T) : IsUnit ((N : ℕ) : T) := by
  have := (hNS (S := S) (N := N)).map φ
  rwa [map_natCast] at this

