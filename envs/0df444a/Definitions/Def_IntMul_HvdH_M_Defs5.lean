namespace NLogN

open IntMul RS IntMul.HvdH

/-- `2n + 10` with `n` on `16`. -/
def m10E : Ex HS := .add (.add (.reg 16) (.reg 16)) (.lit 10)

/-- `-(P j / k)` with `P` on `4`, `j` on `18`, `k` on `17`. -/
def xNegE : Ex HS := .neg (Ex.ediv (.mul (.reg 4) (.reg 18)) (.reg 17))

def expNegBody : RS :=
  NLogN.RS.seqL [push 3 m10E, piP, push 10 (.reg 16), push 11 m10E, push 12 xNegE, expNegFixP,
    push 19 (.reg 13), pop 13, pop 12, pop 11, pop 10, pop 4, pop 3]

def expNegP : RS :=
  NLogN.RS.ite (.add (.mul (.reg 17) (.reg 16)) (.neg (.reg 18))) (push 19 (.lit 0)) expNegBody

/-- The size parameter of `expNegBody`. -/
def expNegBB (n zX T zj zk : ℕ) : ℕ := expNegB n (2 * n + 10) zX T + zj + zk + 12 * n + 100

/-- Cost bound of `expNegP`, in terms of `n` and the bit sizes of `k`, `j`. -/
def expNegCost (n zk zj : ℕ) : ℕ := 10 ^ 35 * (n + zk + zj + 30) ^ 10

end NLogN

end

section
-- Source module: NLogN.HNumExpPos
/-!
# `expPos` as a register program

`expPosP`: inputs `n` on `16`, `k` on `17`, `j` on `18`, `σ` on `27`; `expPos n k j σ` pushed
on `19`. It uses (with pushes popped) registers `3 … 15` and the scratch registers of
`piP`/`log2P` (`0, 1, 2, 40 … 47`) and `expP` (`30 … 39`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-- `min 0 (P j / k - σ L)` with `P` on `14`, `j` on `18`, `k` on `17`, `σ` on `27`, `L` on `4`. -/
def xPosE : Ex HS :=
  .neg (Ex.max0 (.neg (.add (Ex.ediv (.mul (.reg 14) (.reg 18)) (.reg 17))
    (.neg (.mul (.reg 27) (.reg 4))))))

def expPosP : RS :=
  NLogN.RS.seqL [push 3 m10E, piP, push 14 (.reg 4), log2P, push 12 xPosE, pop 4, pop 14, pop 4,
    push 10 (.reg 16), push 11 m10E, expNegFixP,
    push 19 (.reg 13), pop 13, pop 12, pop 11, pop 10, pop 3]

/-- The size parameter of `expPosP`. -/
def expPosBB (n zX T zj zk zσ : ℕ) : ℕ :=
  expNegB n (2 * n + 10) zX T + 2 * zj + zk + 2 * zσ + 30 * n + 200

/-- Cost bound of `expPosP`, in terms of `n`, the bit sizes of `k`, `j`, and `σ`. -/
def expPosCost (n zk zj σ : ℕ) : ℕ := 10 ^ 35 * (n + zk + zj + σ + 30) ^ 10

end NLogN

end

section
-- Source module: NLogN.HNumTw
/-!
# `octExp` and `twiddle` as register programs

* `octExpP`: inputs `n` on `48`, `k` on `49`, `a` on `50`; pushes `(octExp n k a).1` on `51`
  and `(octExp n k a).2` on `52`. Uses (pushed and popped) registers `3 … 9` and the scratch
  registers of `piP` (`0, 1, 2, 40 … 47`) and `expP` (`30 … 39`).
* `twiddleP`: inputs `n` on `28`, `k` on `29`, `j` on `53`; pushes `(twiddle n k j).1` on `51`
  and `(twiddle n k j).2` on `52`. Uses in addition registers `10 … 14` and `48 … 50`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-- `n + 4` with `n` on `48`. -/
def n4E : Ex HS := .add (.reg 48) (.lit 4)

/-- `P a / (4 k)` with `P` on `4`, `a` on `50`, `k` on `49`. -/
def phiE : Ex HS := Ex.ediv (.mul (.reg 4) (.reg 50)) (.mul (.lit 4) (.reg 49))

/-- `(u + 2^3) / 2^4` with `u` on `r`. -/
def rnd4E (r : Fin HS) : Ex HS := Ex.fdiv (.add (.reg r) (.pow2 (.lit 3))) (.pow2 (.lit 4))

def octExpP : RS :=
  NLogN.RS.seqL [push 3 n4E, piP, push 5 n4E, push 6 (.lit 0), push 7 phiE, expP,
    push 51 (rnd4E 8), push 52 (rnd4E 9), pop 9, pop 8, pop 7, pop 6, pop 5, pop 4, pop 3]

/-- The size parameter of `octExpP`. -/
def octBB (n za zk : ℕ) : ℕ := expB (n + 4) (3 * (n + 4) + 14 + za) + 2 * za + 2 * zk + 20 * n + 100

/-- Cost bound of `octExpP`, in terms of `n` and the bit sizes of `a`, `k`. -/
def octExpCost (n za zk : ℕ) : ℕ := 10 ^ 20 * (n + za + zk + 30) ^ 5

end NLogN

end

section
-- Source module: NLogN.HNumTw2
/-!
# `twiddle` as a register program

`twiddleP`: inputs `n` on `28`, `k` on `29`, `j` on `53`; pushes `(twiddle n k j).1` on `51`
and `(twiddle n k j).2` on `52`. Uses (pushed and popped) registers `10 … 14`, `48 … 50` and
those of `octExpP` (`3 … 9`, `0, 1, 2, 30 … 47`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-- Multiplication by `i^t` for `t ∈ {0, 1, 2, 3}` (and `t ≥ 3` treated as `3`). -/
def rot4 (t : ℤ) (p : ℤ × ℤ) : ℤ × ℤ :=
  if t < 1 then p else if t < 2 then (-p.2, p.1) else if t < 3 then (-p.1, -p.2) else (p.2, -p.1)

/-! ## Top-based wrappers for `octExpP` -/

/-! ## The program -/

/-- `j mod k` with `j` on `53`, `k` on `29`. -/
def jkE : Ex HS := Ex.emod (.reg 53) (.reg 29)
/-- `q = 8 (j mod k) / k`. -/
def qE : Ex HS := Ex.ediv (.mul (.lit 8) jkE) (.reg 29)
/-- `r = 8 (j mod k) mod k`. -/
def rE : Ex HS := Ex.emod (.mul (.lit 8) jkE) (.reg 29)
/-- `q mod 2` with `q` on `10`. -/
def cE : Ex HS := Ex.emod (.reg 10) (.lit 2)
/-- `((q + 1) / 2) mod 4` with `q` on `10`. -/
def tE : Ex HS := Ex.emod (Ex.ediv (.add (.reg 10) (.lit 1)) (.lit 2)) (.lit 4)
/-- The octant argument: `r` if `c = 0`, else `k - r` (`r` on `11`, `c` on `12`). -/
def aE : Ex HS := .sel (.add (.reg 12) (.lit (-1))) (Ex.max0 (.reg 11))
  (Ex.max0 (.add (.reg 29) (.neg (.reg 11))))
/-- The imaginary part, conjugated if `c = 1` (`c` on `12`, value on `52`). -/
def yE : Ex HS := .sel (.add (.reg 12) (.lit (-1))) (.reg 52) (.neg (.reg 52))
/-- Real part of `i^t (x, y)` with `t` on `13`, `x` on `51`, `y` on `14`. -/
def reE : Ex HS := .sel (.add (.reg 13) (.lit (-1))) (.reg 51)
  (.sel (.add (.reg 13) (.lit (-2))) (.neg (.reg 14))
    (.sel (.add (.reg 13) (.lit (-3))) (.neg (.reg 51)) (.reg 14)))
/-- Imaginary part of `i^t (x, y)`. -/
def imE : Ex HS := .sel (.add (.reg 13) (.lit (-1))) (.reg 14)
  (.sel (.add (.reg 13) (.lit (-2))) (.reg 51)
    (.sel (.add (.reg 13) (.lit (-3))) (.neg (.reg 14)) (.neg (.reg 51))))

/-- Set-up: `q, r, c, t` on `10 … 13` and the arguments of `octExpP` on `48 … 50`. -/
def twA : RS :=
  NLogN.RS.seqL [push 10 qE, push 11 NLogN.rE, push 12 NLogN.cE, push 13 NLogN.tE, push 48 (.reg 28), push 49 (.reg 29),
    push 50 NLogN.aE]

/-- Conjugation/rotation of the result of `octExpP`, then clean-up. -/
def twB : RS :=
  NLogN.RS.seqL [push 14 yE, push 50 NLogN.reE, push 49 NLogN.imE, pop 51, pop 52,
    push 51 (.reg 50), push 52 (.reg 49), pop 49, pop 50,
    pop 14, pop 50, pop 49, pop 48, pop 13, pop 12, pop 11, pop 10]

def twiddleP : RS := NLogN.RS.seqL [twA, octExpP, twB]

/-! ## Cost -/

/-- The size parameter of `twiddleP`. -/
def twBB (n zj zk : ℕ) : ℕ :=
  2 * expB (n + 4) (3 * (n + 4) + 14 + zj + zk + 4) + 4 * zj + 4 * zk + 20 * n + 200

/-- The state after `twA`. -/
def twAState (n k j : ℕ) (s : IState HS) : IState HS :=
  ((((((s.upd 10 (.int (8 * ((j : ℤ) % k) / k) :: s.G 10)).upd 11 (.int (8 * ((j : ℤ) % k) % k) :: s.G 11)).upd 12
    (.int (8 * ((j : ℤ) % k) / k % 2) :: s.G 12)).upd 13 (.int ((8 * ((j : ℤ) % k) / k + 1) / 2 % 4) :: s.G 13)).upd 48
    (.int n :: s.G 48)).upd 49 (.int k :: s.G 49)).upd 50 (.int (((if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat) : ℕ) : ℤ) :: s.G 50)

/-- Cost bound of `twiddleP`, in terms of `n` and the bit sizes of `j`, `k`. -/
def twiddleCost (n zj zk : ℕ) : ℕ := 10 ^ 22 * (n + zj + zk + 30) ^ 5

end NLogN

end

section
-- Source module: NLogN.HNumScale
/-!
# `ceilSqrt`, `scaleZ` and `twD` as register programs

* `isqrtP`: inputs `v` on `41`, a bit bound `B` on `42` (`0 ≤ v < 4^B`); pushes `⌊√v⌋` on `43`.
  Binary search with the loop counter on `44`.
* `ceilSqrtP`: same inputs; pushes `ceilSqrt v` on `43`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-! ## Binary-search square root -/

/-- The value of the search variable after `k` of the `B` steps. -/
def isq (v : ℤ) (B : ℕ) : ℕ → ℤ
  | 0 => 0
  | k + 1 => if v - (isq v B k + 2 ^ (B - k - 1)) ^ 2 < 0 then isq v B k
      else isq v B k + 2 ^ (B - k - 1)

/-- `r + 2^(c-1)` with `r` on `43`, `c` on `44`. -/
def isqHE : Ex HS := .add (.reg 43) (.pow2 (.add (.reg 44) (.lit (-1))))
/-- One binary-search step. -/
def isqBE : Ex HS := .sel (.add (.reg 41) (.neg (.mul isqHE isqHE))) (.reg 43) isqHE

def isqrtP : RS := NLogN.RS.seq (push 43 (.lit 0)) (NLogN.RS.rep 44 (.reg 42) (asg 43 isqBE))

/-- The loop state after `k` steps. -/
def isqSt (s : IState HS) (v : ℤ) (B k : ℕ) : IState HS :=
  (s.upd 43 (.int (isq v B k) :: s.G 43)).upd 44 (.int ((B : ℤ) - k) :: s.G 44)

/-- Cost bound of `isqrtP`. -/
def isqrtCost (zv B : ℕ) : ℕ := 10 ^ 10 * (B + 1) * (zv + 2 * B + 12) ^ 2

/-- `r + 1` if `r² < v`, else `r` (`r` on `43`, `v` on `41`). -/
def csE : Ex HS := .sel (.add (.mul (.reg 43) (.reg 43)) (.neg (.reg 41))) (.add (.reg 43) (.lit 1))
  (.reg 43)

def ceilSqrtP : RS := NLogN.RS.seq isqrtP (asg 43 NLogN.csE)

/-- Cost bound of `ceilSqrtP`. -/
def ceilSqrtCost (zv B : ℕ) : ℕ := 10 ^ 11 * (B + 1) * (zv + 2 * B + 12) ^ 2

/-! ## `scaleZ` -/

/-- Truncated division `a.tdiv m`, valid for `m > 0`. -/
def tdivE (a m : Ex HS) : Ex HS := .sel a (.neg (Ex.fdiv (.neg a) m)) (Ex.fdiv a m)

/-- `2^k x` with `k` on `11`, `x` on `12`. -/
def w1E : Ex HS := .mul (.pow2 (.reg 11)) (.reg 12)
/-- `2^k y` with `k` on `11`, `y` on `13`. -/
def w2E : Ex HS := .mul (.pow2 (.reg 11)) (.reg 13)
/-- `w₁² + w₂²` with `w₁, w₂` on `17, 18`. -/
def vE : Ex HS := .add (.mul (.reg 17) (.reg 17)) (.mul (.reg 18) (.reg 18))
/-- `4^p - v` with `p` on `10`, `v` on `19`. -/
def scCondE : Ex HS := .add (.pow2 (.add (.reg 10) (.reg 10))) (.neg (.reg 19))
/-- The bit bound `k + B_z + 1` for the square root. -/
def scBE : Ex HS := .add (.add (.reg 11) (.reg 14)) (.lit 1)

def scaleThen : RS :=
  NLogN.RS.seqL [push 41 (.reg 19), push 42 scBE, ceilSqrtP,
    push 15 (tdivE (.mul (.reg 17) (.pow2 (.reg 10))) (.reg 43)),
    push 16 (tdivE (.mul (.reg 18) (.pow2 (.reg 10))) (.reg 43)), pop 43, pop 42, pop 41]

def scaleElse : RS := NLogN.RS.seqL [push 15 (.reg 17), push 16 (.reg 18)]

def scaleZP : RS :=
  NLogN.RS.seqL [push 17 w1E, push 18 w2E, push 19 vE, NLogN.RS.ite scCondE scaleThen scaleElse, pop 19, pop 18,
    pop 17]

/-- The state after the first three pushes of `scaleZP`. -/
def scSt (s : IState HS) (k : ℕ) (x y : ℤ) : IState HS :=
  ((s.upd 17 (.int (2 ^ k * x) :: s.G 17)).upd 18 (.int (2 ^ k * y) :: s.G 18)).upd 19
    (.int (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) :: s.G 19)

/-- The state of `scaleThen` after `ceilSqrtP`. -/
def scSt2 (s : IState HS) (k Bz : ℕ) (x y : ℤ) : IState HS :=
  (((NLogN.scSt s k x y).upd 41 (.int (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ::
    (NLogN.scSt s k x y).G 41)).upd 42 (.int ((k : ℤ) + Bz + 1) :: (NLogN.scSt s k x y).G 42)).upd 43
    (.int (ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat) ::
      (NLogN.scSt s k x y).G 43)

/-- Cost bound of `scaleZP`. -/
def scaleCost (p k Bz : ℕ) : ℕ := 10 ^ 14 * (p + k + Bz + 20) ^ 3

/-! ## `twD` -/

end NLogN

end

section
-- Source module: NLogN.HNumTwD
/-!
# `twD` as a register program

`twDP`: inputs `p` on `28`, `n` on `29`, `j` on `53`; pushes `(twD p n j).1` on `15` and
`(twD p n j).2` on `16`. It runs `twiddleP` and then `scaleZP` with `k = 0` and the bit bound
`twBz p` (an upper bound for the size of the twiddle factors). Uses (pushed and popped)
registers `10 … 14`, `17 … 19`, `41 … 44`, `51`, `52` and those of `twiddleP`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

/-- The bit bound used for the twiddle factors. -/
def twBz (p : ℕ) : ℕ := expB (p + 4) (3 * (p + 4) + 14) + 7

/-- `twBz p` with `p` on `28`. -/
def bzE : Ex HS := .add (.mul (.add (.add (.reg 28) (.reg 28)) (.lit 21))
  (.add (.mul (.lit 4) (.reg 28)) (.lit 41))) (.add (.add (.reg 28) (.reg 28)) (.lit 25))

def twDP : RS :=
  NLogN.RS.seqL [twiddleP, push 10 (.reg 28), push 11 (.lit 0), push 12 (.reg 51), push 13 (.reg 52),
    push 14 bzE, scaleZP, pop 14, pop 13, pop 12, pop 11, pop 10, pop 52, pop 51]

/-- The state after `twiddleP`. -/
def twT1 (p n j : ℕ) (s : IState HS) : IState HS :=
  (s.upd 51 (.int (twiddle p n j).1 :: s.G 51)).upd 52 (.int (twiddle p n j).2 :: s.G 52)

/-- The state before `scaleZP`. -/
def twT2 (p n j : ℕ) (s : IState HS) : IState HS :=
  (push 14 bzE).run ((push 13 (.reg 52)).run ((push 12 (.reg 51)).run ((push 11 (.lit 0)).run
    ((push 10 (.reg 28)).run (twT1 p n j s)))))

/-- Cost bound of `twDP`, in terms of `p` and the bit sizes of `n`, `j`. -/
def twDCost (p zn zj : ℕ) : ℕ := 10 ^ 25 * (p + zn + zj + 30) ^ 6

end NLogN

end

section
-- Source module: NLogN.HCrTw
/-!
# The twiddle program for the chirp table (namespace `NLogN.CR`)

`twR` instantiates the abstract hypothesis `TwSpec` of `chirpP_spec`/`chirpP_cost` with the
numerics program `twDP` (HNumTwD.lean): a wrapper copies `p` (`hPp`), `R` (`hM2`), `c` (`hC`)
onto `28, 29, 53`, runs `twDP` and restores; the whole is relocated by the swap `10 ↔ 54` so
that it does not write the loop counter `hQ = 10`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

/-- Copy `p, R, c` to the inputs of `twDP`, run it, restore. -/
def twW : RS :=
  seqL [push 28 (.reg hPp), push 29 (.reg hM2), push 53 (.reg hC), twDP, pop 53, pop 29, pop 28]

def twσ : Equiv.Perm (Fin HS) := Equiv.swap 10 54

/-- **The twiddle program** used for the chirp table. -/
def twR : RM := RM.ren twσ (.rs twW)

/-- The cost constant of `twR` for `p` on `hPp` and `R` on `hM2`. -/
def twCost (p R : ℕ) : ℕ :=
  9 * 10 ^ 7 * (zsz (p : ℤ) + zsz (R : ℤ) + 3) ^ 2 + twDCost p (zsz (R : ℤ)) (zsz (R : ℤ))

/-! ## The chirp table with the concrete twiddle program -/

end NLogN.CR

end

section
-- Source module: NLogN.HGl1
/-!
# Generic element-stream loops (Gaussian list primitives, part 1)

`RM.rep c n b` where the body `b` pops one element from each of the input stacks `A1`, `A2`
and pushes the (reversed) encodings of two results onto `B1`, `B2`.  After `N` rounds the
outputs are the reversed flattened encodings of the `zipWith` lists.  The wrappers `loop11`,
`loop21`, `loop12` are the one/two-input, one/two-output special cases.

Outputs are pushed in reversed item order, so `B = (enc out).reverse ++ old`; one `mvList` of
all items restores the natural order (`mvList_run` reverses).
-/

set_option linter.unusedSimpArgs false

namespace NLogN.GL

open IntMul NLogN

section Generic

variable {α1 α2 β1 β2 : Type*}

/-- The state after `k` rounds of the generic stream loop. -/
def lSt (A1 A2 B1 B2 : Fin HS) (e1 : α1 → List Item) (e2 : α2 → List Item)
    (d1 : β1 → List Item) (d2 : β2 → List Item) (f1 : α1 → α2 → β1) (f2 : α1 → α2 → β2)
    (s : IState HS) (L1 : List α1) (L2 : List α2) (R1 R2 : List Item) (k : ℕ) : IState HS :=
  (((s.upd A1 ((L1.drop k).flatMap e1 ++ R1)).upd A2 ((L2.drop k).flatMap e2 ++ R2)).upd B1
    (((List.zipWith f1 (L1.take k) (L2.take k)).flatMap d1).reverse ++ s.G B1)).upd B2
    (((List.zipWith f2 (L1.take k) (L2.take k)).flatMap d2).reverse ++ s.G B2)

/-- Body hypothesis of the generic loop. -/
def BodyOK (M : MulSpec) (b : RM) (A1 A2 B1 B2 c : Fin HS) (e1 : α1 → List Item)
    (e2 : α2 → List Item) (d1 : β1 → List Item) (d2 : β2 → List Item) (f1 : α1 → α2 → β1)
    (f2 : α1 → α2 → β2) (s : IState HS) (L1 : List α1) (L2 : List α2) (C : ℕ) : Prop :=
  ∀ x ∈ L1, ∀ y ∈ L2, ∀ (t : IState HS) (r1 r2 o1 o2 : List Item),
    (∀ j, j ∉ [A1, A2, B1, B2, c] → t.G j = s.G j) → t.G A1 = e1 x ++ r1 →
    t.G A2 = e2 y ++ r2 → t.G B1 = o1 ++ s.G B1 → t.G B2 = o2 ++ s.G B2 →
    b.run t = (((t.upd A1 r1).upd A2 r2).upd B1 ((d1 (f1 x y)).reverse ++ t.G B1)).upd B2
      ((d2 (f2 x y)).reverse ++ t.G B2) ∧ b.ok M t ∧ b.cost M t ≤ C

end Generic

/-! ## Special cases -/

section Wrappers

variable {α α2 β β2 : Type*}

end Wrappers

end NLogN.GL

end


