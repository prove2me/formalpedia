      rw [← Complex.exp_add, add_neg_cancel, Complex.exp_zero]
    have hrot : z₀ + (r : ℂ) * Complex.exp (θ * Complex.I) - lineCentre g
        = Complex.exp (θ * Complex.I) * ((r : ℂ) + lineW g z₀ θ) := by
      calc z₀ + (r : ℂ) * Complex.exp (θ * Complex.I) - lineCentre g
          = Complex.exp (θ * Complex.I) * (r : ℂ)
            + (Complex.exp (θ * Complex.I) * Complex.exp (-(θ * Complex.I)))
              * (z₀ - lineCentre g) := by rw [he]; ring
        _ = Complex.exp (θ * Complex.I)
              * ((r : ℂ) + Complex.exp (-(θ * Complex.I)) * (z₀ - lineCentre g)) := by ring
        _ = _ := by rw [lineW]
    have hexp1 : normSq (Complex.exp (θ * Complex.I)) = 1 := by
      rw [normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I, one_pow]
    have hns : normSq ((r : ℂ) + lineW g z₀ θ)
        = (r + (lineW g z₀ θ).re) ^ 2 + (lineW g z₀ θ).im ^ 2 := by
      rw [normSq_apply, add_re, add_im, ofReal_re, ofReal_im, zero_add]
      ring
    have hδsq : lineDelta g z₀ θ ^ 2
        = (lineW g z₀ θ).im ^ 2 + normSq g.det / botNormSqC g ^ 2 := by
      rw [lineDelta]
      exact Real.sq_sqrt (add_nonneg (sq_nonneg _) (div_nonneg (normSq_nonneg _) (sq_nonneg _)))
    rw [radC_sq_eq hg, hrot, normSq_mul, hexp1, one_mul, hns, mul_pow,
      Real.sq_sqrt hA.le, rad_sq, lineMat]
    simp only [Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.of_apply,
      mul_one, mul_zero, add_zero]
    rw [hδsq]
    field_simp [hA.ne']
    ring
  have h2 : 0 ≤ Real.sqrt (botNormSqC g) * rad (lineMat g z₀ θ) r :=
    mul_nonneg (Real.sqrt_nonneg _) (rad_pos (det_lineMat_ne_zero hg z₀ θ) r).le
  rw [← Real.sqrt_sq (radC_pos hg _).le, hsq, Real.sqrt_sq h2]

private theorem log_radC_line_eq (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    (fun r : ℝ => Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))
      = fun r : ℝ => Real.log (Real.sqrt (botNormSqC g))
          + Real.log (rad (lineMat g z₀ θ) r) := by
  funext r
  rw [radC_line_eq hg z₀ θ r,
    Real.log_mul (Real.sqrt_pos.mpr (botNormSqC_pos g hg)).ne'
      (rad_pos (det_lineMat_ne_zero hg z₀ θ) r).ne']

