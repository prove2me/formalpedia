section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Equations (6)–(7), PDF p. 7. The kernel, complementary ideal and g1 are constructed conclusions.
Orbit hulls on the factors use the factors' own inner automorphisms. -/
theorem faithful_directSum_reduction (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) :
    ∃ L0 L1 : LieIdeal ℝ P.L,
      (∀ l : P.L, l ∈ L0 ↔ ∀ v : P.V, ⁅(l : G), (v : G)⁆ = 0) ∧
      IsCompl L0.toSubmodule L1.toSubmodule ∧
      ∃ G0 G1 : LieIdeal ℝ G,
        G0.toSubmodule = L0.toSubmodule.map P.L.toSubmodule.subtype ∧
        G1.toSubmodule = (LieAlgebra.center ℝ G).toSubmodule ⊔ P.V ⊔
          L1.toSubmodule.map P.L.toSubmodule.subtype ∧
        IsCompl G0.toSubmodule G1.toSubmodule ∧ LieAlgebra.HasCentralRadical ℝ G0 ∧
        (∀ l : L1, (∀ v : P.V, ⁅((l : P.L) : G), (v : G)⁆ = 0) → l = 0) ∧
        (∀ x0 : G0, ∀ x1 : G1,
          orbitHull ((x1 : G) + (x0 : G)) =
            setSum ((Subtype.val : G1 → G) '' orbitHull x1)
              ((Subtype.val : G0 → G) '' orbitHull x0)) ∧
        (∀ x0 : G0, ∀ x1 : G1,
          Pointed (orbitHull ((x1 : G) + (x0 : G))) ↔
            Pointed (orbitHull x1) ∧ Pointed (orbitHull x0)) := by sorry

end Presentations

end

