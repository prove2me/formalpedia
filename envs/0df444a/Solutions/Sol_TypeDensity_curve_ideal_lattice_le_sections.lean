  have hbx : beta.right (TypeDensity.chartBase R x t x) = TypeDensity.overlapException R t x * TypeDensity.overlapSlope R t x := by
    have h1 : beta.right (TypeDensity.chartBase R x t x) = algebraMap R (TypeDensity.BlowupOverlap R t x) x :=
      beta.right.commutes x
    rw [h1, TypeDensity.overlapException, TypeDensity.overlapSlope, ← map_mul, hrel, IsScalarTower.algebraMap_apply R
      (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)]
    rfl
  have hR : Ideal.map beta.right.toRingHom (TypeDensity.rightCurveIdeal R t x beta G j) ≤ I := by
    rw [TypeDensity.rightCurveIdeal, Ideal.map_sup, Ideal.map_span, Set.image_singleton, TypeDensity.chartExceptional,
      Ideal.map_pow, Ideal.map_span, Set.image_singleton]
    refine sup_le ?_ ?_
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      have hu : IsUnit ((TypeDensity.overlapSlope R t x)^d) :=
        (IsLocalization.Away.algebraMap_isUnit (TypeDensity.chartSlope R t x)).pow d
      have h2 : (TypeDensity.overlapSlope R t x)^d * beta.right (G.right j) ∈ I := by
