    (∀ s ∈ SS, (∀ V : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H), Psp.reduceFst α hα V = s.1 → 0 ≤ V.ord f) →
      ∃ c : (ResidueField ↥A), s.1.HasValue (Rpd.R₁.residue ⟨f, h₁⟩ : (JHNeronObjectAtP.Fbar p M H hpM (ResidueField ↥A))) c ∧ s.2.HasValue (Rpd.R₂.residue ⟨f, h₂⟩ : (JHNeronObjectAtP.Fbar p M H hpM (ResidueField ↥A))) c)

