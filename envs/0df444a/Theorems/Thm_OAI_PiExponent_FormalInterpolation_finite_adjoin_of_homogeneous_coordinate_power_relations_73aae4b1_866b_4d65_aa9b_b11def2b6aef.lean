theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_homogeneous_coordinate_power_relations_73aae4b1_866b_4d65_aa9b_b11def2b6aef
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : ℝ))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (N : Nat) (hN : 0 < N)
    (hpow : ∀ i : Fin d,
