theorem Sp.iteT {e : Ex HS} {a b : RS} {s t : IState HS} {ca Bb : ℕ} (hc : e.Clean)
    (ho : e.ok s) (hl : e.Lin) (hB : e.Bnd s Bb) (hneg : e.eval s < 0) (ha : Sp a s t ca) :
    Sp (.ite e a b) s t ((e.size + 1) * 2000 * (Bb + 2) + (2 * Bb + 2) + 25 + ca) := by
  refine ⟨⟨hc, ho, by rw [if_pos hneg]; exact ha.1⟩, by simp [RS.run, hneg, ha.2.1], ?_⟩
  have h1 := pushCost_le_lin e s Bb hl hB
  have h2 := Ex.zsz_eval_le s Bb e hB
  simp only [RS.cost, if_pos hneg]
  have := ha.2.2
  omega

theorem Sp.iteF {e : Ex HS} {a b : RS} {s t : IState HS} {cb Bb : ℕ} (hc : e.Clean)
    (ho : e.ok s) (hl : e.Lin) (hB : e.Bnd s Bb) (hpos : ¬ e.eval s < 0) (hb : Sp b s t cb) :
    Sp (.ite e a b) s t ((e.size + 1) * 2000 * (Bb + 2) + (2 * Bb + 2) + 25 + cb) := by
  refine ⟨⟨hc, ho, by rw [if_neg hpos]; exact hb.1⟩, by simp [RS.run, hpos, hb.2.1], ?_⟩
  have h1 := pushCost_le_lin e s Bb hl hB
  have h2 := Ex.zsz_eval_le s Bb e hB
  simp only [RS.cost, if_neg hpos]
  have := hb.2.2
  omega

theorem sel_sp {r : Fin HS} (hr5 : r.val < 56) (br : ℕ → RS) {s t : IState HS} {v : ℕ}
    {L : List Item} (hrv : s.G r = .int v :: L) {Bb cv : ℕ} (hb : Sp (br v) s t cv)
    (hz : ∀ x : ℕ, x ≤ v + 1 → zsz (x : ℤ) ≤ Bb) :
    ∀ m k, k ≤ v → v < k + m → Sp (sel r br k m) s t (m * cSel Bb + cv)
  | 0, k, h1, h2 => absurd h2 (by omega)
  | 1, k, h1, h2 => by
    obtain rfl : k = v := by omega
    exact hb.mono (by omega)
  | m + 2, k, h1, h2 => by
    have hc : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).Clean :=
      clean_add (clean_reg hr5) (clean_lit _)
    have ho : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).ok s := ⟨IState.isInt_of hrv, trivial⟩
    have hev : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).eval s = (v : ℤ) - (k + 1) := by
      simp only [Ex.eval, IState.top_eq hrv]; ring
    have hB : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).Bnd s Bb := by
      refine ⟨?_, ?_, ?_⟩
      · simp only [Ex.Bnd, IState.top_eq hrv]; exact hz v (by omega)
      · simp only [Ex.Bnd, zsz_neg]; exact_mod_cast hz (k + 1) (by omega)
      · simp only [Ex.eval, IState.top_eq hrv]
        exact le_trans (zsz_mono (by omega)) (hz (v + 1) le_rfl)
    by_cases hkv : v = k
    · subst hkv
      exact (Sp.iteT hc ho ⟨trivial, trivial⟩ hB (by rw [hev]; omega) hb).mono
        (by simp only [cSel, Ex.size]; nlinarith)
    · have IH := sel_sp hr5 br hrv hb hz (m + 1) (k + 1) (by omega) (by omega)
      exact (Sp.iteF hc ho ⟨trivial, trivial⟩ hB (by rw [hev]; omega) IH).mono
        (by simp only [cSel, Ex.size]; nlinarith)

