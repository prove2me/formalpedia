open AlgebraicCurve

namespace NC

section Inv

variable {K : Type*} [Field K] [IsAlgClosed K] {F : Type*} [Field F] [Algebra K F] [IsCurveOver K F]

theorem valU_inv (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) : valU v g⁻¹ = (valU v g)⁻¹ := by
  apply valU_eq_of_hasValue v (inv_ne_zero hg) (by rw [v.ord_inv, h, neg_zero])
  rw [Units.val_inv_eq_inv_val]
  exact (hasValue_valU v hg h).inv (valU v g).ne_zero

end Inv

section Assembly

variable {K : Type*} [Field K] [IsAlgClosed K] {n m : ℕ} {Fbar : Fin n → Type*} [∀ i, Field (Fbar i)]
  [∀ i, Algebra K (Fbar i)] [∀ i, IsCurveOver K (Fbar i)] [∀ i, Algebra.EssFiniteType K (Fbar i)]
  (src tgt : Fin m → Fin n) (xs : ∀ e, Place K (Fbar (src e))) (xt : ∀ e, Place K (Fbar (tgt e)))

theorem ratio_inv {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g)
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) :
    ratio src tgt xs xt g⁻¹ = (ratio src tgt xs xt g)⁻¹ := by
  funext e
  simp only [ratio, Pi.inv_apply]
  rw [valU_inv (xs e) (h.1 _) (h.ord_src hE e), valU_inv (xt e) (h.1 _) (h.ord_tgt hE e), mul_inv]

noncomputable def toPi : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) →+ (∀ i, Pic0 K (Fbar i)) where
  toFun E := fun i => Pic0.mk ⟨(E : NodalData K Fbar) i, (E.2).1 i⟩
  map_zero' := by
    funext i
    rw [Pi.zero_apply, ← Pic0.mk_zero]
    exact congrArg Pic0.mk (Subtype.ext rfl)
  map_add' E E' := by
    funext i
    rw [Pi.add_apply, ← Pic0.mk_add]
    exact congrArg Pic0.mk (Subtype.ext rfl)

theorem toPi_apply (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)) (i : Fin n) :
    toPi src tgt xs xt E i = Pic0.mk ⟨(E : NodalData K Fbar) i, (E.2).1 i⟩ := rfl

theorem pic0_mk_eq_zero_iff {F : Type*} [Field F] [Algebra K F] (D : Divisor.degZero (K := K) (F := F)) :
    Pic0.mk D = 0 ↔ Divisor.IsPrincipal (D : Divisor K F) := by
  show (QuotientAddGroup.mk D : Pic0 K F) = 0 ↔ _
  rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf, Divisor.mem_principal]

theorem toPi_eq_zero_iff (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)) :
    toPi src tgt xs xt E = 0 ↔ ∀ i, Divisor.IsPrincipal ((E : NodalData K Fbar) i) := by
  constructor
  · intro h i
    have := congrFun h i
    rw [toPi_apply, Pi.zero_apply, pic0_mk_eq_zero_iff] at this
    exact this
  · intro h
    funext i
    rw [toPi_apply, Pi.zero_apply, pic0_mk_eq_zero_iff]
    exact h i

theorem toPi_eq_zero_of_isNodalPrincipal (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt))
    (h : NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt (E : NodalData K Fbar)) :
    toPi src tgt xs xt E = 0 := by
  obtain ⟨g, a, hg, hE, hv⟩ := h
  exact (toPi_eq_zero_iff src tgt xs xt E).mpr (fun i => ⟨g i, hg i, hE i⟩)

noncomputable def redHom : NodalPic0 K Fbar src tgt xs xt →+ (∀ i, Pic0 K (Fbar i)) :=
  QuotientAddGroup.lift _ (toPi src tgt xs xt) (fun E hE =>
    toPi_eq_zero_of_isNodalPrincipal src tgt xs xt E ((AddSubgroup.mem_addSubgroupOf).mp hE))

theorem redHom_mk (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)) :
    redHom src tgt xs xt (NodalPic0.mk src tgt xs xt E) = toPi src tgt xs xt E := rfl

noncomputable def rep (c : NodalPic0 K Fbar src tgt xs xt) :
    ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) :=
  (NodalPic0.mk_surjective src tgt xs xt c).choose

theorem mk_rep (c : NodalPic0 K Fbar src tgt xs xt) : NodalPic0.mk src tgt xs xt (rep src tgt xs xt c) = c :=
  (NodalPic0.mk_surjective src tgt xs xt c).choose_spec

theorem exists_pres_of_toPi_eq_zero (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt))
    (h : toPi src tgt xs xt E = 0) : ∃ g : ∀ i, Fbar i, Pres (E : NodalData K Fbar) g := by
  have hp := (toPi_eq_zero_iff src tgt xs xt E).mp h
  choose g hg0 hg using hp
  exact ⟨g, hg0, hg⟩

noncomputable def presOf (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt))
    (h : toPi src tgt xs xt E = 0) : ∀ i, Fbar i :=
  (exists_pres_of_toPi_eq_zero src tgt xs xt E h).choose

theorem pres_presOf (E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt))
    (h : toPi src tgt xs xt E = 0) : Pres (E : NodalData K Fbar) (presOf src tgt xs xt E h) :=
  (exists_pres_of_toPi_eq_zero src tgt xs xt E h).choose_spec

theorem toPi_rep_eq_zero (c : ↥(redHom src tgt xs xt).ker) :
    toPi src tgt xs xt (rep src tgt xs xt (c : NodalPic0 K Fbar src tgt xs xt)) = 0 := by
  rw [← redHom_mk, mk_rep]
  exact (AddMonoidHom.mem_ker).mp c.2

noncomputable def Psi (c : ↥(redHom src tgt xs xt).ker) : (Fin m → Kˣ) ⧸ (cobd K src tgt).range :=
  QuotientGroup.mk (ratio src tgt xs xt
    (presOf src tgt xs xt (rep src tgt xs xt (c : NodalPic0 K Fbar src tgt xs xt)) (toPi_rep_eq_zero src tgt xs xt c)))

theorem mk_ratio_eq_of_sub_isNodalPrincipal {E E' : NodalData K Fbar} {g g' : ∀ i, Fbar i}
    (h : Pres E g) (h' : Pres E' g')
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)
    (hE' : E' ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)
    (hNP : NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt (E - E')) :
    (QuotientGroup.mk (ratio src tgt xs xt g) : (Fin m → Kˣ) ⧸ (cobd K src tgt).range) =
      QuotientGroup.mk (ratio src tgt xs xt g') := by
  obtain ⟨g₀, hg₀, hr₀⟩ := exists_pres_ratio_eq_one hNP
  have hsub : E - E' ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt := sub_mem hE hE'
  have hpres : Pres (E - E') (g * g'⁻¹) := by rw [sub_eq_add_neg]; exact h.mul h'.inv
  obtain ⟨κ, hκ⟩ := ratio_eq_mul_cobd_of_pres hpres hg₀ hsub
  rw [hr₀, ratio_mul h h'.inv hE (neg_mem hE'), ratio_inv src tgt xs xt h' hE'] at hκ

  rw [QuotientGroup.eq]
  refine ⟨κ, ?_⟩
  rw [eq_inv_of_mul_eq_one_right hκ.symm, mul_inv_rev, inv_inv]
  exact mul_comm _ _

theorem rep_mem (c : NodalPic0 K Fbar src tgt xs xt) :
    ((rep src tgt xs xt c : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)) : NodalData K Fbar) ∈
      NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt :=
  (rep src tgt xs xt c).2

theorem Psi_pow_eq_one (N : ℕ) (c : ↥(redHom src tgt xs xt).ker)
    (hc : ((N : ℕ) : ℤ) • (c : NodalPic0 K Fbar src tgt xs xt) = 0) : Psi src tgt xs xt c ^ N = 1 := by
  set E := rep src tgt xs xt (c : NodalPic0 K Fbar src tgt xs xt) with hEdef
  have hpres := pres_presOf src tgt xs xt E (toPi_rep_eq_zero src tgt xs xt c)
  set g := presOf src tgt xs xt E (toPi_rep_eq_zero src tgt xs xt c) with hgdef

  have hNE : NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt
      ((((N : ℕ) : ℤ) • E : ↥(NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)) : NodalData K Fbar) := by
    rw [← NodalPic0.mk_eq_zero_iff, map_zsmul, hEdef, mk_rep, hc]
  have hNE' : NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt
      (((N : ℕ) : ℤ) • (E : NodalData K Fbar) - 0) := by
    rw [sub_zero]; exact hNE
  have key := mk_ratio_eq_of_sub_isNodalPrincipal src tgt xs xt (hpres.zsmul N)
    (⟨fun _ => one_ne_zero, fun i v => by simp⟩ : Pres (0 : NodalData K Fbar) 1)
    ((NodalData.admissible src tgt xs xt).zsmul_mem E.2 _) (zero_mem _) hNE'
  show (QuotientGroup.mk (ratio src tgt xs xt g) : (Fin m → Kˣ) ⧸ (cobd K src tgt).range) ^ N = 1
  rw [← QuotientGroup.mk_pow, ← ratio_pow hpres E.2 N, key]
  have h1 : ratio src tgt xs xt (1 : ∀ i, Fbar i) = 1 := by
    funext e
    simp only [ratio, Pi.one_apply]
    rw [valU_eq_of_hasValue (xs e) one_ne_zero (by simp) (a := 1) (by rw [Units.val_one]; exact (xs e).hasValue_one),
      valU_eq_of_hasValue (xt e) one_ne_zero (by simp) (a := 1) (by rw [Units.val_one]; exact (xt e).hasValue_one),
      mul_inv_cancel]
  rw [h1, QuotientGroup.mk_one]

theorem Psi_injective : Function.Injective (Psi src tgt xs xt) := by
  intro c c' hcc
  have hp := pres_presOf src tgt xs xt _ (toPi_rep_eq_zero src tgt xs xt c)
  have hp' := pres_presOf src tgt xs xt _ (toPi_rep_eq_zero src tgt xs xt c')
  set E := rep src tgt xs xt (c : NodalPic0 K Fbar src tgt xs xt) with hE
  set E' := rep src tgt xs xt (c' : NodalPic0 K Fbar src tgt xs xt) with hE'
  set g := presOf src tgt xs xt E (toPi_rep_eq_zero src tgt xs xt c)
  set g' := presOf src tgt xs xt E' (toPi_rep_eq_zero src tgt xs xt c')

  have hq : (ratio src tgt xs xt g)⁻¹ * ratio src tgt xs xt g' ∈ (cobd K src tgt).range := by
    rw [← QuotientGroup.eq]; exact hcc
  have hpres : Pres ((E' : NodalData K Fbar) - (E : NodalData K Fbar)) (g' * g⁻¹) := by
    rw [sub_eq_add_neg]; exact hp'.mul hp.inv
  have hmem : (E' : NodalData K Fbar) - (E : NodalData K Fbar) ∈
      NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt := sub_mem E'.2 E.2
  have hr : ratio src tgt xs xt (g' * g⁻¹) ∈ (cobd K src tgt).range := by
    rw [ratio_mul hp' hp.inv E'.2 (neg_mem E.2), ratio_inv src tgt xs xt hp E.2, mul_comm]; exact hq
  have hNP := isNodalPrincipal_of_ratio_mem_range hpres hmem hr

  have hmk : NodalPic0.mk src tgt xs xt (E' - E) = 0 := (NodalPic0.mk_eq_zero_iff src tgt xs xt _).mpr hNP
  rw [map_sub, sub_eq_zero, hE', hE, mk_rep, mk_rep] at hmk
  exact Subtype.ext hmk.symm

end Assembly

end NC

open NC in
theorem solution
    (K : Type*) [Field K] [IsAlgClosed K]
    (n m : ℕ) (Fbar : Fin n → Type*) [∀ i, Field (Fbar i)] [∀ i, Algebra K (Fbar i)]
    [∀ i, IsCurveOver K (Fbar i)] [∀ i, Algebra.EssFiniteType K (Fbar i)]
    (src tgt : Fin m → Fin n) (xs : ∀ e, Place K (Fbar (src e))) (xt : ∀ e, Place K (Fbar (tgt e)))
    (hκ : ∀ p : ℕ, p.Prime → CharP K p → ∀ a : K, ∃ n : ℕ, 0 < n ∧ a ^ (p ^ n) = a)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : K) ≠ 0) (k : ℕ) :
    Finite {c : NodalPic0 K Fbar src tgt xs xt // ((ℓ ^ k : ℕ) : ℤ) • c = 0} ∧
      Nat.card {c : NodalPic0 K Fbar src tgt xs xt // ((ℓ ^ k : ℕ) : ℤ) • c = 0} * ℓ ^ (k * n) ≤
        ℓ ^ (k * (2 * (∑ i, genusFF K (Fbar i)) + m +
          Nat.card (Quot fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j))) := by
  classical
  set N : ℕ := ℓ ^ k with hN
  have hN0 : 0 < N := pow_pos (Fact.out : ℓ.Prime).pos k
  have hNK : (N : K) ≠ 0 := by rw [hN, Nat.cast_pow]; exact pow_ne_zero _ hℓ
  set G := NodalPic0 K Fbar src tgt xs xt with hG
  set c := Nat.card (Quot fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j) with hc
  let φ : G →+ (∀ i, Pic0 K (Fbar i)) := redHom src tgt xs xt

  have hPi : Nat.card (tors (∀ i, Pic0 K (Fbar i)) N) = ℓ ^ (k * (2 * ∑ i, genusFF K (Fbar i))) := by
    rw [natCard_tors_pi]
    simp_rw [hN, natCard_tors_pic0 K _ hκ ℓ hℓ k]
    rw [Finset.prod_pow_eq_pow_sum]
    congr 1
    rw [Finset.mul_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by ring)
  haveI : Finite (tors (∀ i, Pic0 K (Fbar i)) N) :=
    Nat.finite_of_card_ne_zero (by rw [hPi]; exact pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero)

  obtain ⟨hHfin, hH⟩ := finite_and_natCard_mtors_quotient_cobd_mul_pow_le K src tgt N hN0 hNK
  haveI := hHfin
  let Ψ : tors (↥φ.ker) N → mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N := fun x =>
    ⟨Psi src tgt xs xt (x : ↥φ.ker), mem_mtors.mpr (Psi_pow_eq_one src tgt xs xt N (x : ↥φ.ker)
      (congrArg Subtype.val (mem_tors.mp x.2)))⟩
  have hΨ : Function.Injective Ψ := by
    intro x y h
    have : Psi src tgt xs xt (x : ↥φ.ker) = Psi src tgt xs xt (y : ↥φ.ker) := congrArg Subtype.val h
    exact Subtype.ext (Psi_injective src tgt xs xt this)
  haveI : Finite (tors (↥φ.ker) N) := Finite.of_injective Ψ hΨ
  have hker : Nat.card (tors (↥φ.ker) N) ≤ Nat.card (mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N) :=
    Nat.card_le_card_of_injective Ψ hΨ

  obtain ⟨hGfin, hGle⟩ := finite_and_natCard_tors_le_of_hom φ N

  have heq : Nat.card {c : G // ((N : ℕ) : ℤ) • c = 0} = Nat.card (tors G N) :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun c => Iff.rfl))
  refine ⟨Finite.of_equiv _ (Equiv.subtypeEquivRight (fun c => (Iff.rfl : c ∈ tors G N ↔ _))), ?_⟩
  rw [heq]
  have hR : ℓ ^ (k * (2 * (∑ i, genusFF K (Fbar i)) + m + c)) =
      ℓ ^ (k * (2 * ∑ i, genusFF K (Fbar i))) * (N ^ m * N ^ c) := by
    rw [hN, ← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
    congr 1
    ring
  rw [hR, show ℓ ^ (k * n) = N ^ n by rw [hN, pow_mul]]
  calc Nat.card (tors G N) * N ^ n
      ≤ Nat.card (tors (↥φ.ker) N) * Nat.card (tors (∀ i, Pic0 K (Fbar i)) N) * N ^ n :=
        Nat.mul_le_mul_right _ hGle
    _ ≤ Nat.card (mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N) * ℓ ^ (k * (2 * ∑ i, genusFF K (Fbar i))) * N ^ n := by
        rw [hPi]; exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hker)
    _ = ℓ ^ (k * (2 * ∑ i, genusFF K (Fbar i))) *
          (Nat.card (mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N) * N ^ n) := by ring
    _ ≤ ℓ ^ (k * (2 * ∑ i, genusFF K (Fbar i))) * (N ^ m * N ^ c) := Nat.mul_le_mul_left _ hH

end S_AlgebraicCurve_NodalPic0_natCard_torsion_mul_pow_le_pow_of_isAlgClosed
end P2MW
export P2MW.S_AlgebraicCurve_NodalPic0_natCard_torsion_mul_pow_le_pow_of_isAlgClosed (solution)
