open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08

/-! ## The transported anchor profiles -/

/-- `j² x Ū(x)` read back at `x = 1/R`. -/
noncomputable def Utilde (j : ℝ) (R : ℝ) : ℝ := j ^ 2 * ((1 / R) * Ubar (1 / R))

/-- `j² x Z̄(x)` read back at `x = 1/R`. -/
noncomputable def Ztilde (j : ℝ) (R : ℝ) : ℝ := j ^ 2 * ((1 / R) * Zbar (1 / R))

/-! ## Derivatives of the transported profiles -/

/-! ## The actual first-order coefficients and their derivatives -/

/-! ## The two real source dictionaries -/

/-- The task-book Maxwell cubic source, built from the actual anchor data. -/
noncomputable def S3 (j : ℝ) (R : ℝ) : ℝ :=
  (Utilde j R - 2 * Ztilde j R) * bstar 3 1 (3 / 2) j R / R
    - P R * deriv (Ztilde j) R * deriv (bstar 3 1 (3 / 2) j) R
    + 2 * (3 / 2) * Utilde j R * (j + 2 * (3 / 2) * bstar 3 1 (3 / 2) j R) / R ^ 3

/-- The task-book angular cubic source, built from the actual anchor data. -/
noncomputable def r3phys (j : ℝ) (R : ℝ) : ℝ :=
  R ^ 4 * (Utilde j R + Ztilde j R) * deriv (vstar 3 1 j) R

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII09


