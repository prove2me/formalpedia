set_option maxHeartbeats 4000000
variable (M : ℝ)
theorem solution (hM : 0 ≤ M) {x : Pt 4} (hρ : 0 < x 1) (hne : x 1 ≠ M / 2) :
    (jacIso M x)ᵀ * metricMatrix (gStd M) (toStd M x) * jacIso M x = metricMatrix (gIso M) x := by
  have h1 : 2 * x 1 - M ≠ 0 := fun h0 => hne (by linarith)
  have h2 : 2 * x 1 + M ≠ 0 := by positivity
  have hr : x 1 ≠ 0 := hρ.ne'
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_four, metricMatrix, Matrix.of_apply,
      gIso, gStd, jacIso, toStd] <;>
    (generalize x 1 = ρ at hr h1 h2 hρ ⊢
     have h1' : ρ * 2 - M ≠ 0 := by rwa [mul_comm]
     have h2' : ρ * 2 + M ≠ 0 := by rwa [mul_comm]
     have e4 : 4 * ρ ^ 2 - M ^ 2 = (2 * ρ - M) * (2 * ρ + M) := by ring
     have h4 : 4 * ρ ^ 2 - M ^ 2 ≠ 0 := by rw [e4]; exact mul_ne_zero h1 h2
     try simp only [one_sub_div_rad M ρ hr h2, two_mul_div_rad_sub_one M ρ hr h2, Af_eq M ρ hr h2,
       Bf_eq M ρ hr]
     try simp only [rad_eq M ρ hr]
     first | (field_simp; done) | (field_simp; ring1) | (field_simp; norm_num; done) | (field_simp; left; norm_num))
