theorem J6Seg.r6_passB (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
    ∀ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D), FitSpec6 P n src D M →
    ∀ (ys : List GI) (y : ((i : Fin (D + 1)) → ZMod (tD6 P n D i)) → ℂ),
      RepFull (pP6 P n) (tD6 P n D) ys y → ‖y‖ ≤ 1 →
      RepPad (pP6 P n) (sD6 src D) (tD6 P n D)
          (tensorGo (mapsLine6 P n src D) (List.ofFn (tD6 P n D)) ys)
          (vOf (pP6 P n) (sD6 src D) (tD6 P n D)
            (tensorGo (mapsLine6 P n src D) (List.ofFn (tD6 P n D)) ys)) ∧
        NLogN.KFB.GB (pP6 P n + 2) (tensorGo (mapsLine6 P n src D) (List.ofFn (tD6 P n D)) ys) ∧
        ‖vOf (pP6 P n) (sD6 src D) (tD6 P n D)
            (tensorGo (mapsLine6 P n src D) (List.ofFn (tD6 P n D)) ys) -
          tensCLM (kerB M.B) y‖ ≤ errW6 P n * hp (pP6 P n) := by sorry
