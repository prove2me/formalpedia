      _ ≤ Kc * ((IntMul.OpenAI.R129.dP n : ℝ) * ((2 * (IntMul.OpenAI.R129.dP n : ℝ)) * (4 * (IntMul.OpenAI.Glue.pP n : ℝ)) * (2 * ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℝ)) *
          ((IntMul.OpenAI.R129.ℓP n : ℝ) ^ IntMul.OpenAI.R129.τ + 1))) + Kc * ((Q2 : ℕ) : ℝ) := by
          rw [hQ]; gcongr
