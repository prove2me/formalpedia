theorem push_good {A : SArgs} (hA : A.Good) {s0 : IState HS} {B : ℕ} (hF : A.Fine s0 B)
    {σ : IState HS} (hσ : ∀ j, j ∉ stTg → σ.G j = s0.G j) {i : Fin HS} (hi : i ∈ stTg)
    (e : Ex HS) (he : e ∈ A.l) :
