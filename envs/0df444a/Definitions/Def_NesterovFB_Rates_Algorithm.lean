-- title:
--   Problem (1), algorithm (2), (5)–(7), p. 1–2 — Θ = Ψ + Φ, the accelerated forward-backward iteration, G_s, z_k and the energy E(k)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space with inner product $\langle\cdot,\cdot\rangle$ and norm $\|\cdot\|$. Let $\Psi:\mathcal H\to\mathbb R\cup\{+\infty\}$ and $\Phi:\mathcal H\to\mathbb R$, and consider problem (1),
--   $$\min\{\Psi(x)+\Phi(x) : x\in\mathcal H\}.$$
--   This file fixes the objects of the analysis of Attouch and Peypouquet.
--
--   1. **The objective.** $\Theta=\Psi+\Phi$, that is $\Theta(x)=\Psi(x)+\Phi(x)$, an extended real number (it is $+\infty$ where $\Psi$ is).
--   2. **Extrapolation.** For a parameter $\alpha$ and a sequence $(x_k)$, the extrapolated point is
--   $$y_k = x_k + \frac{k-1}{k+\alpha-1}\,(x_k - x_{k-1}).$$
--   3. **Algorithm (2).** Given a step size $s$ and a map $P$ standing for $\operatorname{prox}_{s\Psi}$, the sequence $(x_k)$ is *generated by algorithm (2)* when, for every $k\ge 1$,
--   $$x_{k+1} = P\big(y_k - s\nabla\Phi(y_k)\big).$$
--   4. **The operator $G_s$.** $G_s(y)=\frac1s\big(y-P(y-s\nabla\Phi(y))\big)$, so that (7) reads $x_{k+1}=y_k-sG_s(y_k)$.
--   5. **The auxiliary sequence (6).** $z_k = x_k + \frac{k-1}{\alpha-1}(x_k-x_{k-1})$.
--   6. **The energy (5).** For a point $x^*$,
--   $$\mathcal E(k)=\frac{2s}{\alpha-1}(k+\alpha-2)^2\big(\Theta(x_k)-\Theta(x^*)\big)+(\alpha-1)\|z_k-x^*\|^2 .$$
--
--   These are the objects in which the paper states its main results (the $o(k^{-2})$ rate of Theorem 1 and the weak convergence of Theorem 3) and the Lyapunov estimates behind them; $G_s$, $z_k$ and $\mathcal E$ appear in the intermediate estimates of the proofs, not in the statements of Theorems 1 and 3.
--
--   **Formalization Note.** $\Psi$, $\Theta$ and $\mathcal E$ take values in `EReal`; the real coefficients enter through the coercion $\mathbb R\to$ `EReal`, so, for $s>0$, $\alpha\ge 3$ and a point $x^*$ with $\Theta(x^*)$ finite (as for a minimizer), $\mathcal E(k)=+\infty$ exactly when $\Theta(x_k)=+\infty$. The divisions by $k+\alpha-1$, $\alpha-1$ and $s$ are well defined under the paper's standing assumptions $\alpha\ge3$, $s>0$, which the theorems carry as hypotheses (Lean would read a division by zero as $0$). The proximal map is not built in: theorems take $P$ together with the published predicate `IsProx s Ψ P` (from `ThreeOpSplitting.ConvexRates.Problem`), which for proper closed convex $\Psi$ and $s>0$ determines $P=\operatorname{prox}_{s\Psi}$. The run starts at $k=1$ with $x_0,x_1$ arbitrary: the coefficient $(k-1)/(k+\alpha-1)$ vanishes at $k=1$, so $x_0$ never matters, and the paper's own $k=0$ step would need an $x_{-1}$. Every sequence the paper generates satisfies this predicate. The index $k-1$ is natural-number subtraction and is only used for $k\ge1$ (at $k=0$ it multiplies $x_0-x_0=0$).
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 1, (1)-(2); p. 2, (5), (6), definition of G_s, (7)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem

namespace NesterovFB.Rates

/-- The objective Θ = Ψ + Φ of problem (1), valued in ℝ ∪ {±∞} (Ψ may take the value +∞). -/
noncomputable def theta {H : Type*} (Ψ : H → EReal) (Φ : H → ℝ) (x : H) : EReal :=
  Ψ x + (Φ x : EReal)

/-- The extrapolated point y_k = x_k + (k−1)/(k+α−1)·(x_k − x_{k−1}) of algorithm (2). -/
noncomputable def extrap {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (α : ℝ) (x : ℕ → H) (k : ℕ) : H :=
  x k + (((k : ℝ) - 1) / ((k : ℝ) + α - 1)) • (x k - x (k - 1))

/-- (x_k) is generated by algorithm (2) from k = 1 on, with `P` playing the role of prox_{sΨ}:
x_{k+1} = P(y_k − s∇Φ(y_k)) for every k ≥ 1. -/
def IsAccelFBRun {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → ℝ) (P : H → H) (α s : ℝ) (x : ℕ → H) : Prop :=
  ∀ k : ℕ, 1 ≤ k → x (k + 1) = P (extrap α x k - s • gradient Φ (extrap α x k))

/-- The operator G_s(y) = (1/s)(y − prox_{sΨ}(y − s∇Φ(y))), with `P` playing the role of
prox_{sΨ}. -/
noncomputable def gradMap {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] (Φ : H → ℝ) (P : H → H) (s : ℝ) (y : H) : H :=
  (1 / s) • (y - P (y - s • gradient Φ y))

/-- The auxiliary sequence z_k = x_k + (k−1)/(α−1)·(x_k − x_{k−1}) of (6). -/
noncomputable def zSeq {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (α : ℝ) (x : ℕ → H) (k : ℕ) : H :=
  x k + (((k : ℝ) - 1) / (α - 1)) • (x k - x (k - 1))

/-- The energy (5):
E(k) = 2s/(α−1)·(k+α−2)²·(Θ(x_k) − Θ(x*)) + (α−1)‖z_k − x*‖², valued in ℝ ∪ {±∞}. -/
noncomputable def energy {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (Ψ : H → EReal) (Φ : H → ℝ) (α s : ℝ) (x : ℕ → H) (xstar : H) (k : ℕ) : EReal :=
  ((2 * s / (α - 1) * ((k : ℝ) + α - 2) ^ 2 : ℝ) : EReal) * (theta Ψ Φ (x k) - theta Ψ Φ xstar)
    + (((α - 1) * ‖zSeq α x k - xstar‖ ^ 2 : ℝ) : EReal)

end NesterovFB.Rates


