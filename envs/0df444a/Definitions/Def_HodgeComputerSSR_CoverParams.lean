-- Branch roots at `U = ∞` (`t = 1/U`) in `LaurentSeries K5` for `W^2 + bW(t⁻¹)*W + cW(t⁻¹) = 0`!
def bInfPS : PowerSeries K5 :=
  PowerSeries.C (k5Params.Bv2 * k5Params.Av0_inv) +
  PowerSeries.C (k5Params.Bv1 * k5Params.Av0_inv) * PowerSeries.X +
  PowerSeries.C (k5Params.Bv0 * k5Params.Av0_inv) * PowerSeries.X ^ 2

def cInfPS : PowerSeries K5 :=
  PowerSeries.C (k5Params.Cv0 * k5Params.Av0_inv) * PowerSeries.X ^ 2

/-- Root `W1_inf = O(1)` at `t = 1/U` (`W1_inf = t⁻² * r_inf` where `r_inf = O(t^2)`). -/
def rInfPS : PowerSeries K5 := quadRootSeries bInfPS cInfPS

lemma bInfPS_coeff0 : PowerSeries.coeff 0 bInfPS = k5Params.Bv2 * k5Params.Av0_inv := by
  simp [bInfPS]

lemma bInfPS_coeff0_ne : PowerSeries.coeff 0 bInfPS ≠ 0 := by
  rw [bInfPS_coeff0]
  have hAi : k5Params.Av0_inv ≠ 0 := fun h => by
    have := k5Params_Av0_mul_inv; rw [h, mul_zero] at this; exact zero_ne_one this
  exact mul_ne_zero k5Params_Bv2_ne hAi

lemma rInfPS_coeff0 : PowerSeries.coeff 0 rInfPS = 0 := quadRootSeries_coeff_zero _ _
lemma rInfPS_coeff1 : PowerSeries.coeff 1 rInfPS = 0 := by
  rw [rInfPS, quadRootSeries_coeff_one]
  have hc1 : PowerSeries.coeff 1 cInfPS = 0 := by
    rw [cInfPS, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow]; simp
  rw [hc1]; simp

lemma rInfPS_eq_zero : rInfPS ^ 2 + bInfPS * rInfPS + cInfPS = 0 :=
  quadRootSeries_eq_zero bInfPS cInfPS bInfPS_coeff0_ne (by simp [cInfPS])

def W1_inf : LaurentSeries K5 :=
  HahnSeries.single (-2 : ℤ) (1 : K5) * ((rInfPS : PowerSeries K5) : LaurentSeries K5)

def W2_inf : LaurentSeries K5 :=
  -(evalInvT k5Params.bW) - W1_inf

lemma evalInvT_bW_eq :
    evalInvT k5Params.bW = HahnSeries.single (-2 : ℤ) (1 : K5) * ((bInfPS : PowerSeries K5) : LaurentSeries K5) := by
  simp only [CoverParams.bW, CoverParams.Bv, CoverParams.quadU, bInfPS, map_add, map_mul, map_pow,
    evalInvT_C, evalInvT_X, HahnSeries.ofPowerSeries_X, HahnSeries.ofPowerSeries_C,
    HahnSeries.single_pow]
  have h2m : (2 : ℕ) • (-1 : ℤ) = -2 := by decide
  have h2p : (2 : ℕ) • (1 : ℤ) = 2 := by decide
  simp only [one_pow, h2m, h2p]
  have hs0 : HahnSeries.single (-2 : ℤ) (1 : K5) * HahnSeries.single (2 : ℤ) (1 : K5) = 1 := by
    rw [HahnSeries.single_mul_single]; simp
  have hs1 : HahnSeries.single (-2 : ℤ) (1 : K5) * HahnSeries.single (1 : ℤ) (1 : K5) =
      HahnSeries.single (-1 : ℤ) (1 : K5) := by
    rw [HahnSeries.single_mul_single]; simp
  linear_combination
    -HahnSeries.C k5Params.Bv1 * HahnSeries.C k5Params.Av0_inv * hs1 -
     HahnSeries.C k5Params.Bv0 * HahnSeries.C k5Params.Av0_inv * hs0

lemma evalInvT_cW_eq :
    evalInvT k5Params.cW = HahnSeries.single (-4 : ℤ) (1 : K5) * ((cInfPS : PowerSeries K5) : LaurentSeries K5) := by
  simp only [CoverParams.cW, cInfPS, map_mul, map_pow, evalInvT_C, evalInvT_X,
    HahnSeries.ofPowerSeries_X, HahnSeries.ofPowerSeries_C, HahnSeries.single_pow]
  have h2m : (2 : ℕ) • (-1 : ℤ) = -2 := by decide
  have h2p : (2 : ℕ) • (1 : ℤ) = 2 := by decide
  simp only [one_pow, h2m, h2p]
  have hs : HahnSeries.single (-4 : ℤ) (1 : K5) * HahnSeries.single (2 : ℤ) (1 : K5) =
      HahnSeries.single (-2 : ℤ) (1 : K5) := by
    rw [HahnSeries.single_mul_single]; simp
  linear_combination -HahnSeries.C k5Params.Cv0 * HahnSeries.C k5Params.Av0_inv * hs

lemma W1_inf_eq : W1_inf ^ 2 + evalInvT k5Params.bW * W1_inf + evalInvT k5Params.cW = 0 := by
  rw [W1_inf, evalInvT_bW_eq, evalInvT_cW_eq]
  have h4 : HahnSeries.single (-2 : ℤ) (1 : K5) * HahnSeries.single (-2 : ℤ) (1 : K5) =
      HahnSeries.single (-4 : ℤ) (1 : K5) := by rw [HahnSeries.single_mul_single]; simp
  have h0 : (((rInfPS ^ 2 + bInfPS * rInfPS + cInfPS : PowerSeries K5) : LaurentSeries K5)) = 0 := by
    rw [rInfPS_eq_zero]; simp
  simp only [map_add, map_mul, map_pow] at h0
  calc _ = HahnSeries.single (-4 : ℤ) (1 : K5) *
          (((rInfPS : PowerSeries K5) : LaurentSeries K5) ^ 2 +
           ((bInfPS : PowerSeries K5) : LaurentSeries K5) * ((rInfPS : PowerSeries K5) : LaurentSeries K5) +
           ((cInfPS : PowerSeries K5) : LaurentSeries K5)) := by
        rw [← h4]; ring
    _ = 0 := by rw [h0, mul_zero]

lemma W1_W2_inf_sum : W1_inf + W2_inf = -evalInvT k5Params.bW := by rw [W2_inf]; ring
lemma W1_W2_inf_prod : W1_inf * W2_inf = evalInvT k5Params.cW := by
  rw [W2_inf]; linear_combination -W1_inf_eq
lemma W2_inf_eq : W2_inf ^ 2 + evalInvT k5Params.bW * W2_inf + evalInvT k5Params.cW = 0 := by
  rw [W2_inf]; linear_combination W1_inf_eq

lemma HasValGe_W1_inf : HasValGe 0 W1_inf := by
  rw [W1_inf]
  have hr : HasValGe ((2 : ℕ) : ℤ) ((rInfPS : PowerSeries K5) : LaurentSeries K5) :=
    HasValGe.of_powerSeries_ge (k := 2) (fun j hj => by
      rcases j with _ | _ | m
      · exact rInfPS_coeff0
      · exact rInfPS_coeff1
      · omega)
  exact ((HasValGe.single (-2 : ℤ) (1 : K5)).mul hr).mono (by omega)

lemma HasValGe_W2_inf : HasValGe (-2 : ℤ) W2_inf := by
  rw [W2_inf]
  have hb : HasValGe (-2 : ℤ) (evalInvT k5Params.bW) := by
    rw [evalInvT_bW_eq]
    exact ((HasValGe.single (-2 : ℤ) (1 : K5)).mul (HasValGe.of_powerSeries bInfPS)).mono (by omega)
  exact hb.neg.sub (HasValGe_W1_inf.mono (by omega))


lemma quadU_natDegree_le {R : Type*} [CommRing R] (a0 a1 a2 : R) :
    (CoverParams.quadU a0 a1 a2).natDegree ≤ 2 := by
  rw [CoverParams.quadU]
  have h1 : (C a1 * X : R[X]).natDegree ≤ 1 :=
    (Polynomial.natDegree_C_mul_le a1 X).trans Polynomial.natDegree_X_le
  have h2 : (C a2 * X ^ 2 : R[X]).natDegree ≤ 2 :=
    (Polynomial.natDegree_C_mul_le a2 (X ^ 2)).trans (Polynomial.natDegree_X_pow_le 2)
  exact (Polynomial.natDegree_add_le _ _).trans
    (max_le ((Polynomial.natDegree_add_le _ _).trans (max_le (by simp) (by omega))) h2)


-- Branch roots at `U = 0` (`t = U`) in `LaurentSeries K5` for `W^2 + bW(t)*W + cW(t) = 0`!
def b0PS : PowerSeries K5 :=
  PowerSeries.C (k5Params.Bv0 * k5Params.Av0_inv) +
  PowerSeries.C (k5Params.Bv1 * k5Params.Av0_inv) * PowerSeries.X +
  PowerSeries.C (k5Params.Bv2 * k5Params.Av0_inv) * PowerSeries.X ^ 2

def c0PS : PowerSeries K5 :=
  PowerSeries.C (k5Params.Cv0 * k5Params.Av0_inv) * PowerSeries.X ^ 2

def r0PS : PowerSeries K5 := quadRootSeries b0PS c0PS

lemma b0PS_coeff0 : PowerSeries.coeff 0 b0PS = k5Params.Bv0 * k5Params.Av0_inv := by
  simp [b0PS]

lemma b0PS_coeff0_ne : PowerSeries.coeff 0 b0PS ≠ 0 := by
  rw [b0PS_coeff0]
  have hAi : k5Params.Av0_inv ≠ 0 := fun h => by
    have := k5Params_Av0_mul_inv; rw [h, mul_zero] at this; exact zero_ne_one this
  exact mul_ne_zero k5Params_Bv0_ne hAi

lemma r0PS_coeff0 : PowerSeries.coeff 0 r0PS = 0 := quadRootSeries_coeff_zero _ _
lemma r0PS_coeff1 : PowerSeries.coeff 1 r0PS = 0 := by
  rw [r0PS, quadRootSeries_coeff_one]
  have hc1 : PowerSeries.coeff 1 c0PS = 0 := by
    rw [c0PS, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow]; simp
  rw [hc1]; simp

lemma r0PS_coeff2 : PowerSeries.coeff 2 r0PS = -(k5Params.Cv0 / k5Params.Bv0) := by
  rw [r0PS, quadRootSeries_coeff_two]
  have hq1 : quadRootCoeff b0PS c0PS 1 = 0 := by
    simpa [r0PS, quadRootSeries] using r0PS_coeff1
  have hc2 : PowerSeries.coeff 2 c0PS = k5Params.Cv0 * k5Params.Av0_inv := by
    rw [c0PS, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow]; simp
  rw [hq1, hc2, b0PS_coeff0]
  have hAi : k5Params.Av0_inv ≠ 0 := fun h => by
    have := k5Params_Av0_mul_inv; rw [h, mul_zero] at this; exact zero_ne_one this
  have hB0 := k5Params_Bv0_ne
  field_simp [hAi, hB0]; ring

lemma r0PS_eq_zero : r0PS ^ 2 + b0PS * r0PS + c0PS = 0 :=
  quadRootSeries_eq_zero b0PS c0PS b0PS_coeff0_ne (by simp [c0PS])

def W1_0 : LaurentSeries K5 := ((r0PS : PowerSeries K5) : LaurentSeries K5)
def W2_0 : LaurentSeries K5 := -(evalT k5Params.bW) - W1_0

lemma evalT_bW_eq : evalT k5Params.bW = ((b0PS : PowerSeries K5) : LaurentSeries K5) := by
  simp only [CoverParams.bW, CoverParams.Bv, CoverParams.quadU, b0PS, map_add, map_mul, map_pow,
    evalT_C, evalT_X, HahnSeries.ofPowerSeries_X, HahnSeries.ofPowerSeries_C]
  ring

lemma evalT_cW_eq : evalT k5Params.cW = ((c0PS : PowerSeries K5) : LaurentSeries K5) := by
  simp only [CoverParams.cW, c0PS, map_mul, map_pow, evalT_C, evalT_X,
    HahnSeries.ofPowerSeries_X, HahnSeries.ofPowerSeries_C]

lemma W1_0_eq : W1_0 ^ 2 + evalT k5Params.bW * W1_0 + evalT k5Params.cW = 0 := by
  rw [W1_0, evalT_bW_eq, evalT_cW_eq]
  have h0 : (((r0PS ^ 2 + b0PS * r0PS + c0PS : PowerSeries K5) : LaurentSeries K5)) = 0 := by
    rw [r0PS_eq_zero]; simp
  simpa only [map_add, map_mul, map_pow] using h0

lemma W1_W2_0_sum : W1_0 + W2_0 = -evalT k5Params.bW := by rw [W2_0]; ring
lemma W1_W2_0_prod : W1_0 * W2_0 = evalT k5Params.cW := by
  rw [W2_0]; linear_combination -W1_0_eq
lemma W2_0_eq : W2_0 ^ 2 + evalT k5Params.bW * W2_0 + evalT k5Params.cW = 0 := by
  rw [W2_0]; linear_combination W1_0_eq

lemma HasValGe_W1_0 : HasValGe 2 W1_0 := by
  rw [W1_0]
  exact HasValGe.of_powerSeries_ge (k := 2) (fun j hj => by
    rcases j with _ | _ | m
    · exact r0PS_coeff0
    · exact r0PS_coeff1
    · omega)

lemma W1_0_coeff2 : W1_0.coeff 2 = -(k5Params.Cv0 / k5Params.Bv0) := by
  change (HahnSeries.ofPowerSeries ℤ K5 r0PS).coeff (2 : ℕ) = _
  rw [HahnSeries.ofPowerSeries_apply_coeff, r0PS_coeff2]

lemma HasValGe_W2_0 : HasValGe 0 W2_0 :=
  (HasValGe.evalT k5Params.bW).neg.sub (HasValGe_W1_0.mono (by omega))

lemma W2_0_coeff0 : W2_0.coeff 0 = -(k5Params.Bv0 * k5Params.Av0_inv) := by
  rw [W2_0, HahnSeries.coeff_sub, HahnSeries.coeff_neg, HasValGe_W1_0 0 (by omega), sub_zero,
    evalT_bW_eq]
  change -(HahnSeries.ofPowerSeries ℤ K5 b0PS).coeff (0 : ℕ) = _
  rw [HahnSeries.ofPowerSeries_apply_coeff, b0PS_coeff0]


lemma syl5_elim_symm_aux {R : Type*} [CommRing R]
    (ca cb c0 q20 q11 q02 k2 c30 c21 c12 c03 k3 : R) :
    let Q5 := q20 * cb ^ 2 - q11 * ca * cb + q02 * ca ^ 2
    let Q7 := c30 * cb ^ 3 - c21 * ca * cb ^ 2 + c12 * ca ^ 2 * cb - c03 * ca ^ 3
    let d2_1 := (-q11 * cb + 2 * q02 * ca) * c0
    let d2_0 := q02 * c0 ^ 2 + cb ^ 2 * k2
    let d3_2 := (-c21 * cb ^ 2 + 2 * c12 * ca * cb - 3 * c03 * ca ^ 2) * c0
    let d3_1 := (c12 * cb - 3 * c03 * ca) * c0 ^ 2
    let d3_0 := -c03 * c0 ^ 3 + cb ^ 3 * k3
    let e2_1 := (-q11 * ca + 2 * q20 * cb) * c0
    let e2_0 := q20 * c0 ^ 2 + ca ^ 2 * k2
    let e3_3 := -c30 * cb ^ 3 + c21 * ca * cb ^ 2 - c12 * ca ^ 2 * cb + c03 * ca ^ 3
    let e3_2 := (-3 * c30 * cb ^ 2 + 2 * c21 * ca * cb - c12 * ca ^ 2) * c0
    let e3_1 := (-3 * c30 * cb + c21 * ca) * c0 ^ 2
    let e3_0 := -c30 * c0 ^ 3 + ca ^ 3 * k3
    cb ^ 6 * (ca ^ 6 * syl5 Q5 d2_1 d2_0 Q7 d3_2 d3_1 d3_0) =
      cb ^ 6 * (cb ^ 6 * syl5 Q5 e2_1 e2_0 e3_3 e3_2 e3_1 e3_0) := by
  intro Q5 Q7 d2_1 d2_0 d3_2 d3_1 d3_0 e2_1 e2_0 e3_3 e3_2 e3_1 e3_0
  have h1 : syl5 Q5 (ca * d2_1) (ca ^ 2 * d2_0) Q7 (ca * d3_2) (ca ^ 2 * d3_1) (ca ^ 3 * d3_0) =
      ca ^ 6 * syl5 Q5 d2_1 d2_0 Q7 d3_2 d3_1 d3_0 := by
    simp only [syl5]; ring
  have h2 := syl5_affine Q5 (ca * d2_1) (ca ^ 2 * d2_0) Q7 (ca * d3_2) (ca ^ 2 * d3_1) (ca ^ 3 * d3_0) (-cb) (-c0)
  have h3 := syl5_scale Q5 e2_1 e2_0 e3_3 e3_2 e3_1 e3_0 (cb ^ 2) (cb ^ 3)
  have ha1 : Q5 * (-cb) ^ 2 = cb ^ 2 * Q5 := by ring
  have ha2 : 2 * Q5 * (-cb) * (-c0) + ca * d2_1 * (-cb) = cb ^ 2 * e2_1 := by
    simp only [Q5, d2_1, e2_1]; ring
  have ha3 : Q5 * (-c0) ^ 2 + ca * d2_1 * (-c0) + ca ^ 2 * d2_0 = cb ^ 2 * e2_0 := by
    simp only [Q5, d2_1, d2_0, e2_0]; ring
  have hb1 : Q7 * (-cb) ^ 3 = cb ^ 3 * e3_3 := by
    simp only [Q7, e3_3]; ring
  have hb2 : 3 * Q7 * (-cb) ^ 2 * (-c0) + ca * d3_2 * (-cb) ^ 2 = cb ^ 3 * e3_2 := by
    simp only [Q7, d3_2, e3_2]; ring
  have hb3 : 3 * Q7 * (-cb) * (-c0) ^ 2 + 2 * (ca * d3_2) * (-cb) * (-c0) + ca ^ 2 * d3_1 * (-cb) = cb ^ 3 * e3_1 := by
    simp only [Q7, d3_2, d3_1, e3_1]; ring
  have hb4 : Q7 * (-c0) ^ 3 + ca * d3_2 * (-c0) ^ 2 + ca ^ 2 * d3_1 * (-c0) + ca ^ 3 * d3_0 = cb ^ 3 * e3_0 := by
    simp only [Q7, d3_2, d3_1, d3_0, e3_0]; ring
  rw [ha1, ha2, ha3, hb1, hb2, hb3, hb4, h3, h1] at h2
  linear_combination -h2

lemma evalInvT_injective {K : Type*} [Field K] : Function.Injective (evalInvT (K := K)) := by
  intro p q hpq
  ext k
  rw [← evalInvT_coeff_neg p k, ← evalInvT_coeff_neg q k, hpq]

/-- Norm symmetry `ca_h^12 * nm_z = cb_h^12 * nm_w` over `K5[X]`. -/

-- 1. Monic normalization of `cb_h` over `LocK5` and its 4 lifted coprimalities
lemma cb_h_evLoc : locParams.cb_h.map evLoc = C 82 * Poly1009.toPoly Poly1009.cb_h_m_list := by
  rw [CoverParams.map_cb_h, locParams_map_evLoc, ← Poly1009.toPoly_c_cb_h,
    Poly1009.toPoly_eq_of_peq Poly1009.check_cb_h_monic, Poly1009.toPoly_psmul]

lemma cb_h_lc_evLoc_ne : evLoc (locParams.cb_h.coeff 2) ≠ 0 := by
  rw [← Polynomial.coeff_map, cb_h_evLoc, Polynomial.coeff_C_mul,
    ← Poly1009.cb_h_m_list_monic.2, Poly1009.cb_h_m_list_monic.1.coeff_natDegree, mul_one]
  decide

def cb_h_m_loc : LocK5[X] := C (LocK5.invOfNe (locParams.cb_h.coeff 2) cb_h_lc_evLoc_ne) * locParams.cb_h
def cb_h_m_K5 : K5[X] := cb_h_m_loc.map LocK5.subtype

lemma cb_h_m_loc_spec :
    cb_h_m_loc.Monic ∧ cb_h_m_loc.natDegree = 2 ∧
    cb_h_m_loc.map evLoc = Poly1009.toPoly Poly1009.cb_h_m_list ∧
    locParams.cb_h = C (locParams.cb_h.coeff 2) * cb_h_m_loc := by
  have hdeg : locParams.cb_h.natDegree ≤ 2 := quadU_natDegree_le _ _ _
  have hev_d : evLoc (locParams.cb_h.coeff 2) = 82 := by
    rw [← Polynomial.coeff_map, cb_h_evLoc, Polynomial.coeff_C_mul,
      ← Poly1009.cb_h_m_list_monic.2, Poly1009.cb_h_m_list_monic.1.coeff_natDegree, mul_one]
  have hcd : cb_h_m_loc.coeff 2 = 1 := by
    rw [cb_h_m_loc, Polynomial.coeff_C_mul, LocK5.invOfNe_mul]
  have hnd : cb_h_m_loc.natDegree = 2 :=
    le_antisymm ((Polynomial.natDegree_C_mul_le _ _).trans hdeg)
      (Polynomial.le_natDegree_of_ne_zero (by rw [hcd]; exact one_ne_zero))
  refine ⟨by rw [Polynomial.Monic, Polynomial.leadingCoeff, hnd, hcd], hnd, ?_, ?_⟩
  · rw [cb_h_m_loc, Polynomial.map_mul, Polynomial.map_C, LocK5.evLoc_invOfNe, hev_d, cb_h_evLoc,
      ← mul_assoc, ← map_mul, inv_mul_cancel₀ (by decide : (82 : ZMod 1009) ≠ 0), map_one, one_mul]
  · rw [cb_h_m_loc, ← mul_assoc, ← map_mul, LocK5.mul_invOfNe, map_one, one_mul]

lemma cb_h_K5_eq_mul_monic :
    k5Params.cb_h = C ((locParams.cb_h.coeff 2 : LocK5) : K5) * cb_h_m_K5 := by
  have h := congrArg (Polynomial.map LocK5.subtype) cb_h_m_loc_spec.2.2.2
  simpa only [CoverParams.map_cb_h, k5Params, Polynomial.map_mul, Polynomial.map_C, cb_h_m_K5,
    Subring.coe_subtype] using h

lemma isCoprime_C_mul_left_iff {K : Type*} [Field K] {c : K} (hc : c ≠ 0) {p q : K[X]} :
    IsCoprime (C c * p) q ↔ IsCoprime p q :=
  ⟨fun ⟨u, v, h⟩ => ⟨u * C c, v, by linear_combination h⟩,
   fun ⟨u, v, h⟩ => ⟨u * C c⁻¹, v, by
     have hc1 : C c⁻¹ * C c = 1 := by rw [← map_mul, inv_mul_cancel₀ hc, map_one]
     linear_combination h + u * p * hc1⟩⟩

lemma isCoprime_C_mul_right_iff {K : Type*} [Field K] {c : K} (hc : c ≠ 0) {p q : K[X]} :
    IsCoprime p (C c * q) ↔ IsCoprime p q :=
  ⟨fun h => (isCoprime_C_mul_left_iff hc).mp h.symm |>.symm,
   fun h => (isCoprime_C_mul_left_iff hc).mpr h.symm |>.symm⟩

lemma isCoprime_cb_h_ca_h : IsCoprime k5Params.cb_h k5Params.ca_h := by
  rw [cb_h_K5_eq_mul_monic, isCoprime_C_mul_left_iff (LocK5.ne_zero_of_evLoc cb_h_lc_evLoc_ne)]
  have hcop : IsCoprime (cb_h_m_loc.map evLoc) (locParams.ca_h.map evLoc) := by
    rw [cb_h_m_loc_spec.2.2.1, CoverParams.map_ca_h, locParams_map_evLoc, ← Poly1009.toPoly_c_ca_h]
    exact Poly1009.isCoprime_of_checkBez Poly1009.check_bez_cbh_cah
  simpa only [cb_h_m_K5, CoverParams.map_ca_h, k5Params] using
    isCoprime_of_evLoc_monic cb_h_m_loc_spec.1 hcop

lemma isCoprime_cb_h_X : IsCoprime k5Params.cb_h (X : K5[X]) := by
  rw [cb_h_K5_eq_mul_monic, isCoprime_C_mul_left_iff (LocK5.ne_zero_of_evLoc cb_h_lc_evLoc_ne)]
  have hcop : IsCoprime (cb_h_m_loc.map evLoc) ((X : LocK5[X]).map evLoc) := by
    rw [cb_h_m_loc_spec.2.2.1, Polynomial.map_X]
    simpa [Poly1009.toPoly] using Poly1009.isCoprime_of_checkBez Poly1009.check_bez_cbh_X
  simpa only [cb_h_m_K5, Polynomial.map_X] using isCoprime_of_evLoc_monic cb_h_m_loc_spec.1 hcop

lemma isCoprime_cb_h_X_sub_1 : IsCoprime k5Params.cb_h (X - 1 : K5[X]) := by
  rw [cb_h_K5_eq_mul_monic, isCoprime_C_mul_left_iff (LocK5.ne_zero_of_evLoc cb_h_lc_evLoc_ne)]
  have hcop : IsCoprime (cb_h_m_loc.map evLoc) ((X - 1 : LocK5[X]).map evLoc) := by
    rw [cb_h_m_loc_spec.2.2.1, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_one]
    have hX1 : Poly1009.toPoly [-1, 1] = (X - 1 : (ZMod 1009)[X]) := by simp [Poly1009.toPoly]; ring
    rw [← hX1]
    exact Poly1009.isCoprime_of_checkBez Poly1009.check_bez_cbh_Xm1
  simpa only [cb_h_m_K5, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_one] using
    isCoprime_of_evLoc_monic cb_h_m_loc_spec.1 hcop

lemma isCoprime_cb_h_nm_WU : IsCoprime k5Params.cb_h k5Params.nm_WU := by
  rw [cb_h_K5_eq_mul_monic, isCoprime_C_mul_left_iff (LocK5.ne_zero_of_evLoc cb_h_lc_evLoc_ne)]
  have hcop : IsCoprime (cb_h_m_loc.map evLoc) (locParams.nm_WU.map evLoc) := by
    rw [cb_h_m_loc_spec.2.2.1, CoverParams.map_nm_WU, locParams_map_evLoc, ← Poly1009.toPoly_c_nm_WU]
    exact Poly1009.isCoprime_of_checkBez Poly1009.check_bez_cbh_nmWU
  simpa only [cb_h_m_K5, CoverParams.map_nm_WU, k5Params] using
    isCoprime_of_evLoc_monic cb_h_m_loc_spec.1 hcop

-- 2. Divisibility `(X^15 * cb_h_m_loc^12) ∣ locParams.nm_z` and monic degree-34 `P34_loc` / `P34_K5`!
def M39_loc : LocK5[X] := X ^ 15 * cb_h_m_loc ^ 12
def M39_K5 : K5[X] := M39_loc.map LocK5.subtype

lemma M39_loc_monic : M39_loc.Monic :=
  (Polynomial.monic_X_pow 15).mul (cb_h_m_loc_spec.1.pow 12)

lemma M39_loc_natDegree : M39_loc.natDegree = 39 := by
  rw [M39_loc, (Polynomial.monic_X_pow 15).natDegree_mul (cb_h_m_loc_spec.1.pow 12),
    Polynomial.natDegree_X_pow, cb_h_m_loc_spec.1.natDegree_pow, cb_h_m_loc_spec.2.1]


def Q34_loc : LocK5[X] := locParams.nm_z /ₘ M39_loc


lemma Q5_evLoc : locParams.Q5_z.map evLoc = C 909 * Poly1009.toPoly Poly1009.Q5_m_list := by
  rw [CoverParams.map_Q5_z, locParams_map_evLoc, ← Poly1009.toPoly_c_Q5,
    Poly1009.toPoly_eq_of_peq Poly1009.check_Q5_monic, Poly1009.toPoly_psmul]

lemma Q5_lc_evLoc_ne : evLoc (locParams.Q5_z.coeff 5) ≠ 0 := by
  rw [← Polynomial.coeff_map, Q5_evLoc, Polynomial.coeff_C_mul,
    ← Poly1009.Q5_m_list_monic.2, Poly1009.Q5_m_list_monic.1.coeff_natDegree, mul_one]
  decide

def Q5_m_loc : LocK5[X] := C (LocK5.invOfNe (locParams.Q5_z.coeff 5) Q5_lc_evLoc_ne) * locParams.Q5_z
def Q5_m_K5 : K5[X] := Q5_m_loc.map LocK5.subtype

/-- Closed-form 4×4 Sylvester determinant of `SheetCalculus.S_ab_mat`, matching
`CoverParams.detM_W` after homogenization. -/
lemma S_ab_mat_det {R : Type*} [CommRing R] (a0 a1 a2 b0 b1 b2 : R) :
    (Matrix.of ![![0, 0, a0, b0],
                 ![a0, b0, a1, b1],
                 ![a1, b1, a2, b2],
                 ![a2, b2, 0, 0]] : Matrix (Fin 4) (Fin 4) R).det =
      -((a2 * b0 - a0 * b2) ^ 2 - (a2 * b1 - a1 * b2) * (a1 * b0 - a0 * b1)) := by
  rw [Matrix.det_succ_column_zero]
  simp only [Fin.sum_univ_four, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Fin.isValue, Matrix.head_cons, Matrix.cons_val_three, Matrix.tail_cons,
    Fin.val_zero, Fin.val_one, Fin.val_two, show (3 : Fin 4).val = 3 from rfl,
    pow_zero, pow_one, pow_two, one_mul, neg_one_mul]
  have hsub1 : (Matrix.of ![![0, 0, a0, b0], ![a0, b0, a1, b1], ![a1, b1, a2, b2], ![a2, b2, 0, 0]] :
      Matrix (Fin 4) (Fin 4) R).submatrix (Fin.succAbove 1) Fin.succ =
      Matrix.of ![![0, a0, b0], ![b1, a2, b2], ![b2, 0, 0]] := by
    ext i j; fin_cases i <;> fin_cases j <;> rfl
  have hsub2 : (Matrix.of ![![0, 0, a0, b0], ![a0, b0, a1, b1], ![a1, b1, a2, b2], ![a2, b2, 0, 0]] :
      Matrix (Fin 4) (Fin 4) R).submatrix (Fin.succAbove 2) Fin.succ =
      Matrix.of ![![0, a0, b0], ![b0, a1, b1], ![b2, 0, 0]] := by
    ext i j; fin_cases i <;> fin_cases j <;> rfl
  have hsub3 : (Matrix.of ![![0, 0, a0, b0], ![a0, b0, a1, b1], ![a1, b1, a2, b2], ![a2, b2, 0, 0]] :
      Matrix (Fin 4) (Fin 4) R).submatrix (Fin.succAbove 3) Fin.succ =
      Matrix.of ![![0, a0, b0], ![b0, a1, b1], ![b1, a2, b2]] := by
    ext i j; fin_cases i <;> fin_cases j <;> rfl
  rw [hsub1, hsub2, hsub3]
  simp only [Matrix.det_fin_three, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
  ring


/-- Bundled algebraic degree, vanishing-order, and factorization properties of the cover resultant. -/
structure CoverFactorSpec : Prop where
  Q5_deg_le : k5Params.Q5_z.natDegree ≤ 5
  Q7_deg_le : k5Params.Q7_z.natDegree ≤ 7
  X15_dvd : (X : K5[X]) ^ 15 ∣ k5Params.nm_z
  elim_symm : k5Params.ca_h ^ 12 * k5Params.nm_z = k5Params.cb_h ^ 12 * k5Params.nm_w
  M39_dvd : M39_loc ∣ locParams.nm_z
  nm_z_eq_M39_Q34 : locParams.nm_z = M39_loc * Q34_loc
  Q34_evLoc : Q34_loc.map evLoc = C 946 * Poly1009.toPoly Poly1009.P34_m_list
  Q34_deg_le : Q34_loc.natDegree ≤ 34
  Q34_lc_ne : evLoc (Q34_loc.coeff 34) ≠ 0
  Q5_m_spec : Q5_m_loc.Monic ∧ Q5_m_loc.natDegree = 5 ∧
    Q5_m_loc.map evLoc = Poly1009.toPoly Poly1009.Q5_m_list ∧
    locParams.Q5_z = C (locParams.Q5_z.coeff 5) * Q5_m_loc
  Q5_K5_eq_mul : k5Params.Q5_z = C ((locParams.Q5_z.coeff 5 : LocK5) : K5) * Q5_m_K5
  Q5_K5_deg : k5Params.Q5_z.natDegree = 5

end SeriesAndVal
end SymmetricSexticResidual.CoverAlgebra


