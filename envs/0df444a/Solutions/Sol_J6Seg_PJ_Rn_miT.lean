    (h8 : u 8 = ∑ k ∈ range n, tsT Q T c (tU w n (a - c) uu) (tV w n (a - c) uu) k)
    (hca : c ≤ a) (hua : a - c < n) (huu : uu < n) (hnl : n ≤ lam) (hlN : lam ≤ N)
    (hGI : D SGI = ((List.range lam).map T.gi).reverse)
    (hDD : D SDD = ((List.range lam).map T.dd).reverse)
    (hDI : D SDI = ((List.range lam).map T.di).reverse)
    (bGI : ∀ i < lam, |T.gi i| ≤ 2 ^ W) (bDD : ∀ i < lam, |T.dd i| ≤ 2 ^ W)
    (bDI : ∀ i < lam, |T.di i| ≤ 2 ^ W)
    (bY : |fmul Q (fmul Q (T.gi (tU w n (a - c) uu)) (T.gi (tV w n (a - c) uu))) (fmul Q (u 8) 1)| ≤
      2 ^ W)
    (bM : |miV Q T B a uu| ≤ 2 ^ W) :
    Rn (progL PJ.miT) u D (fun v' => Fxk [4, 5, 8, 29] u v' ∧ BV W v')
      (update D SMI (miV Q T B a uu :: D SMI)) (costL W N PJ.miT) := by
