theorem oprod_nil (Δ : ℕ) (B : List GI) : oprod Δ [] B = [] := rfl

theorem oprod_cons (Δ : ℕ) (a : GI) (A B : List GI) :
    oprod Δ (a :: A) B = B.map (gmulT Δ a) ++ oprod Δ A B := by
  simp [oprod, List.flatMap_cons]

theorem length_oprod (Δ : ℕ) (A B : List GI) : (oprod Δ A B).length = A.length * B.length := by
  induction A with
  | nil => simp [oprod_nil]
  | cons a A ih => rw [oprod_cons, List.length_append, ih, List.length_map, List.length_cons]; ring

theorem NearU.bnd {Δ : ℕ} {e : ℝ} {z : GI} (h : NearU Δ e z) (he : e ≤ 1) : GBnd (Δ + 2) z :=
  let ⟨Z, hZ, hz⟩ := h; zsz_of_near Δ z Z hZ (hz.trans he)

theorem axTab_near (Δ s t : ℕ) (hst : s ≤ t) (ht : 0 < t)
    (hu : (4 * (t : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1) :
    ∀ x ∈ axTab Δ s t, NearU Δ (4 * (t : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ Δ) x := by
  intro x hx
  obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 hx
  rw [length_axTab] at hk
  refine ⟨_, ?_, axTab_err Δ s t hst ht hu k hk⟩
  exact norm_exp_phase (-(Real.pi * s * ((k : ℤ) : ℝ) ^ 2 / t)) _ (by push_cast; ring)

