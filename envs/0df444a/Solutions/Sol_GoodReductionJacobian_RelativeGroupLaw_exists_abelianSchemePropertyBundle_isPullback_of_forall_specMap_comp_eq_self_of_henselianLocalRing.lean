      (g : AK ⟶ 𝒜) (hg : IsPullback g gK f𝒜 (Spec.map (CommRingCat.ofHom (algebraMap R K)))),
      ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t' gK),
        (LAK.mul t' x y).1 ≫ g =
          (L𝒜.mul (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap R K)))
            ⟨x.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩
            ⟨y.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, y.2]⟩).1 := by
  classical
  have hι : specGenericFibreInclusion R K = Spec.map (CommRingCat.ofHom (algebraMap R K)) := rfl

  obtain ⟨B, g, LB, e, hN, hcomm, heiso, hemul⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_neronModelPropertyBundle_genericFibre_iso_of_abelianSchemePropertyBundle_of_henselianLocalRing
      (R := R) K LAK hAK
  haveI := heiso
  have hBK : AbelianSchemePropertyBundle K (pullback.snd g (specGenericFibreInclusion R K)) :=
    abelianSchemePropertyBundle_of_iso e.1 e.2 (LB.genericFibre K) hAK

  have h𝒜 : AbelianSchemePropertyBundle R g := by
    refine GoodReductionJacobian.RelativeGroupLaw.abelianSchemePropertyBundle_of_neronModelPropertyBundle_of_forall_specMap_comp_eq_self
      K LB hcomm hN hBK ℓ hℓ hℓu ?_
    intro A₁ hA₁ σ₁ hσ₁ v x₁ hx₁

    let θ : AlgebraicClosure K ≃ₐ[K] Ω := IsAlgClosure.equiv K (AlgebraicClosure K) Ω

    let A : ValuationSubring Ω := A₁.comap (θ.symm : Ω →ₐ[K] AlgebraicClosure K).toRingHom
    have hA : ∀ r : R, algebraMap K Ω (algebraMap R K r) ∈ A := by
      intro r
      change (θ.symm : Ω →ₐ[K] AlgebraicClosure K).toRingHom (algebraMap K Ω (algebraMap R K r)) ∈ A₁
      have h1 : (θ.symm : Ω →ₐ[K] AlgebraicClosure K).toRingHom (algebraMap K Ω (algebraMap R K r)) =
          algebraMap R (AlgebraicClosure K) r := by
        change θ.symm (algebraMap K Ω (algebraMap R K r)) = _
        rw [AlgEquiv.commutes, IsScalarTower.algebraMap_apply R K (AlgebraicClosure K)]
      rw [h1]
      exact hA₁ r
    let σ : Ω ≃ₐ[K] Ω := θ.symm.trans (σ₁.trans θ)
    have hσ : σ ∈ A.inertiaSubgroupIn K := mem_inertiaSubgroupIn_conj θ A₁ hσ₁

    let tK : Spec (CommRingCat.of (AlgebraicClosure K)) ⟶ Spec (CommRingCat.of K) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))
    let tΩ : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of K) := Spec.map (CommRingCat.ofHom (algebraMap K Ω))
    let ψ : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of (AlgebraicClosure K)) :=
