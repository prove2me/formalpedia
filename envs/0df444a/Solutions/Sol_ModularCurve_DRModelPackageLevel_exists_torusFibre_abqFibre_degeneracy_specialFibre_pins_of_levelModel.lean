      ¬ (y ∈ Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 0).base ∧
          y ∈ Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base) →
        (pullback.fst (toBase N₀ p) (Spec.map (CommRingCat.ofHom (algebraMap (R p) (ResidueField ↥A))))).base y ∈
          (𝔓.smoothLocus : Set (X N₀ p)) := by
    intro y hy
    by_cases hy0 : y ∈ Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 0).base
    · exact (ModularCurve.DRModelPackageLevel.mem_smoothLocus_and_mem_connectedComponentIn_of_mem_range_comp_zero N₀ p hpN₀ 𝔓
        (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) y hy0 (fun h1 => hy ⟨hy0, h1⟩)).1
    · have hy1 : y ∈ Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base :=
        (𝔓.comp_jointly_surjective (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) y).resolve_left hy0

      have hww : fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A)) ≫
          fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A)) = 𝟙 _ := by
        apply pullback.hom_ext
        · simp only [DRLevel.fibreMap, pullback.map, Category.assoc, pullback.lift_fst, pullback.lift_fst_assoc, Category.id_comp]
          rw [𝔓.w_invol, Category.comp_id]
        · simp only [DRLevel.fibreMap, pullback.map, Category.assoc, pullback.lift_snd, Category.id_comp, Category.comp_id]
      have hc0 := 𝔓.comp_w (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A))
      have hc1 : 𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1 ≫
          fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A)) =
            𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 0 := by
        rw [← hc0, Category.assoc, hww, Category.comp_id]
      obtain ⟨z, rfl⟩ := hy1

      have hy'0 : (fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base
          ((𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base z) ∈
            Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 0).base :=
        ⟨z, by rw [← Scheme.Hom.comp_apply, hc1]⟩
      have hy'1 : (fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base
          ((𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base z) ∉
            Set.range (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base := by
        rintro ⟨z', hz'⟩
        apply hy0
        refine ⟨z', ?_⟩
        calc (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 0).base z'
            = (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1 ≫
                fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base z' := by rw [hc1]
          _ = (fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base
                ((fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base
                  ((𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base z)) := by
                rw [Scheme.Hom.comp_apply, hz']
          _ = (fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A)) ≫
                fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A))).base
                  ((𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base z) := by
                rw [Scheme.Hom.comp_apply]
          _ = (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1).base z := by
                rw [hww]; rfl
      have hU := (ModularCurve.DRModelPackageLevel.mem_smoothLocus_and_mem_connectedComponentIn_of_mem_range_comp_zero N₀ p hpN₀
        𝔓 (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) _ hy'0 hy'1).1

      have hfst : fibreMap 𝔓.w.hom 𝔓.w_over (algebraMap (R p) (ResidueField ↥A)) ≫
          pullback.fst (toBase N₀ p) (Spec.map (CommRingCat.ofHom (algebraMap (R p) (ResidueField ↥A)))) =
            pullback.fst (toBase N₀ p) (Spec.map (CommRingCat.ofHom (algebraMap (R p) (ResidueField ↥A)))) ≫ 𝔓.w.hom := by
        simp only [DRLevel.fibreMap, pullback.map, pullback.lift_fst]
      rw [← Scheme.Hom.comp_apply, hfst, Scheme.Hom.comp_apply] at hU

      have hle : 𝔓.w.hom ⁻¹ᵁ 𝔓.smoothLocus ≤ 𝔓.smoothLocus := by
        apply 𝔓.smoothLocus_maximal
        have heq : (𝔓.w.hom ⁻¹ᵁ 𝔓.smoothLocus).ι ≫ toBase N₀ p = (𝔓.w.hom ∣_ 𝔓.smoothLocus) ≫ (𝔓.smoothLocus.ι ≫ toBase N₀ p) := by
          rw [← Category.assoc, morphismRestrict_ι, Category.assoc, 𝔓.w_over]
        rw [heq]
        infer_instance
      exact hle hU
  refine ⟨hpos, ?_, τ, abq, hDκ, hPκ, hD₀κ, hP₀κ, hε₁', abq, habq₀, habq₁, hci, hτmul, habqmul, hflat, hsurj, hker, ?_, hKR, ?ribet, ?_, ?_⟩
  ·
    have hfin := ModularCurve.ssPlaces_finite p N₀ (ResidueField ↥A)
    have hWeq : W = hfin.toFinset := by
      ext w; rw [hW, Set.Finite.mem_toFinset]
    have hc : Nat.card ↥(ssPlaces p N₀ (ResidueField ↥A)) = W.card := by
      rw [hWeq, Nat.card_coe_set_eq, Set.ncard_eq_toFinset_card _ hfin]
    omega
  ·
    exact ModularCurve.JZeroNeronObjectAtP.fibreMap_abq_schemeHomOverComp_eq_of_pullbackHom_pin N₀ p hpN₀ 𝔓 (ResidueField ↥A)
      D hD M.ε₀ M.D₀ M.rep hDκ hPκ hD₀κ hP₀κ hε₁' abq habq₀ habq₁
  case ribet =>

    obtain ⟨hfinφ, hflatφ, hlfpφ, hφover, hφrk⟩ := SBlock2PhiK.phiK_pack N₀ p hpN₀ 𝔓 (ResidueField ↥A)
      (algebraMap (R p) (ResidueField ↥A))
    haveI := hfinφ; haveI := hflatφ; haveI := hlfpφ
    obtain ⟨F, hF, -, -⟩ := ModularCurve.DRModelPackageLevel.exists_frobHom_classifies_normModule_baseChange N₀ p M.ε₀ M.D₀
      (ResidueField ↥A) hD₀κ (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1 ≫ fibreMap0 𝔓.π (algebraMap (R p) (ResidueField ↥A))) hφover hφrk
    exact ModularCurve.DRModelPackageLevel.symm_schemeHomOverComp_degeneracyHom_eq_add_frobeniusPushforwardModL_of_dictionary
      N₀ p hpN₀ 𝔓 hrk D hD M.ε₀ M.D₀ M.rep hrk_w δ hδ₀ hδ₁ (ResidueField ↥A) hDκ hPκ hD₀κ hP₀κ hε₁' abq habq₀ habq₁
      (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1 ≫ fibreMap0 𝔓.π (algebraMap (R p) (ResidueField ↥A))) rfl hφover hφrk F hF e he_add
      (fun b => ModularCurve.JZeroNeronObjectAtP.LevelModel.symm_fibreMap_frobeniusNormHom_eq_frobeniusPushforwardModL_symm
        N₀ p hpN₀ 𝔓 A hA M hΛ hD₀κ hP₀κ (𝔓.comp (ResidueField ↥A) (algebraMap (R p) (ResidueField ↥A)) 1 ≫ fibreMap0 𝔓.π (algebraMap (R p) (ResidueField ↥A))) rfl hφover hφrk F hF e he₁ b)
  ·
    intro x hx s hs sκ hsκ r hr
    exact ModularCurve.DRModelPackageLevel.ptsSp_symm_abq_reduction_eq_toPic0Pair_of_isGluedSpecialization N₀ p hpN₀ 𝔓 A hA
      M hΛ D hD hsep hsmooth hDκ hPκ hD₀κ hP₀κ hε₁' abq habq₀ habq₁ hDQ hPQ hsepQ ajQ hajQε hajQ kQ hkQ₁ hkQ₂ ajbar hajbar
      hajbar_over εbar hεbar hεbar_aj pts hpts_add hpts_galois hpts_aj data hKr hα hβ P W hW hguard0 hguard1 hE hred
      (Nat.card ↥(ssPlaces p N₀ (ResidueField ↥A)) - 1) τ hker sp hsp x hx s hs sκ hsκ r hr
  ·
    intro i T t a a' h
    have ha : a' = a := Subtype.ext (pullback.hom_ext h (a'.2.trans a.2.symm))
    subst ha
    rfl

