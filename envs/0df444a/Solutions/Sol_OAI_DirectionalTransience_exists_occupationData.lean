theorem fixed_lower_cutoff_escape {d : ℕ} (ν : Measure (Row d)) [IsProbabilityMeasure ν]
    (hue : UniformElliptic ν) (e f : Direction d) (hef : e.1 ≠ f.1)
    (htrans : DirectionallyTransient ν (realPosition (step e))) {b : ℝ} (hb : 0 < b) :
    ∃ C q : ℝ, 0 < C ∧ 0 < q ∧ ∃ K : ℕ, 0 < K ∧ (K:ℝ) ≤
      C*fluctuationScale (independentConditionedPairLaw ν (realPosition (step e)))
        (commonIncrementProcess (realPosition (step e)) f 0) b ∧
      ∀ x y : Lattice d, signedHeight e x=signedHeight e y →
        q ≤ (sharedConditionedPairLaw ν (realPosition (step e)) x y).real
          (layerPairTruthEvent (realPosition (step e)) (signedHeight e) x y
            (signedHeight e x+K) {uv | 2*b ≤ |signedCoordinate f uv.1-signedCoordinate f uv.2|}) := by
  let ℓ := realPosition (step e)
  let μ := independentConditionedPairLaw ν ℓ
  let S := commonIncrementProcess ℓ f 0
  have hp := ne_of_gt (noDrop_positive_of_directionallyTransient ν ℓ htrans)
  let : IsProbabilityMeasure μ := independentConditionedPairLaw_probability ν ℓ hp
  have hne := independent_commonWordIncrement_nonzero ν hue e f hef htrans
  have hnb : 0 < fluctuationScale μ S b := div_pos (sq_pos_of_pos hb)
    (truncatedVariance_pos μ S (measurable_commonIncrementProcess ℓ f 0) hne hb)
  obtain ⟨q₀,hq₀,hone⟩ := elliptic_raw_gap_growth ν hue e f hef
  have hqfin : q₀ ≠ ∞ := ne_top_of_le_ne_top (measure_ne_top _ _) (hone 0 0 rfl)
  obtain ⟨c,hc,htruth⟩ := sharedNoDropMass_uniform_positive ν hue ℓ (signed_direction_unit e) htrans
  have hcfin : c ≠ ∞ := ne_top_of_le_ne_top ENNReal.one_ne_top
    ((htruth 0 0).trans (sharedNoDropMass_le_one ν ℓ 0 0))
  obtain ⟨N,hN⟩ := exists_nat_gt (4*b)
  have hNpos : 0 < N := by
    have hh : (0:ℝ) < N := (by positivity : (0:ℝ) < 4*b).trans hN
    exact_mod_cast hh
  have hnr : (0:ℝ) < N := by exact_mod_cast hNpos
  let Q := c*q₀^N
  have hQ : 0 < Q := ENNReal.mul_pos hc.ne' (pow_ne_zero _ hq₀.ne')
  have hQfin : Q ≠ ∞ := ENNReal.mul_ne_top hcfin (ENNReal.pow_ne_top hqfin)
  refine ⟨(N:ℝ)/fluctuationScale μ S b,Q.toReal,div_pos hnr hnb,
    ENNReal.toReal_pos hQ.ne' hQfin,N,hNpos,?_,?_⟩
  · change (N:ℝ) ≤ (N:ℝ)/fluctuationScale μ S b*fluctuationScale μ S b
    rw [div_mul_cancel₀ _ hnb.ne']
  · intro x y hxy
    let : IsProbabilityMeasure (sharedConditionedPairLaw ν ℓ x y) :=
      sharedConditionedPairLaw_probability ν ℓ x y (ne_of_gt (hc.trans_le (htruth x y)))
    have hg := shared_layer_gap_iterate ν ℓ (signedHeight e) (signedHeight_projection e)
      (fun z => signedCoordinate f z) 1 (by norm_num) (1/2) q₀ c htruth hone N hNpos x y hxy
    simp only [mul_one] at hg
    have hsub : layerPairTruthEvent ℓ (signedHeight e) x y (signedHeight e x+N)
        {uv | |signedCoordinate f x-signedCoordinate f y|+(N:ℝ)*(1/2) <
          |signedCoordinate f uv.1-signedCoordinate f uv.2|} ⊆
        layerPairTruthEvent ℓ (signedHeight e) x y (signedHeight e x+N)
          {uv | 2*b ≤ |signedCoordinate f uv.1-signedCoordinate f uv.2|} := by
      apply layerPairTruthEvent_mono
      intro uv huv
      change 2*b ≤ |signedCoordinate f uv.1-signedCoordinate f uv.2|
      change |signedCoordinate f x-signedCoordinate f y|+(N:ℝ)*(1/2) <
        |signedCoordinate f uv.1-signedCoordinate f uv.2| at huv
      linarith [abs_nonneg (signedCoordinate f x-signedCoordinate f y)]
    have hraw := hg.trans (measure_mono hsub)
    have hcond := hraw.trans (shared_conditioned_event_ge_raw ν ℓ x y _
      (measurableSet_layerPairTruthEvent _ _ _ _ _ _) (layerPairTruthEvent_subset_noDrop _ _ _ _ _ _))
    exact ENNReal.toReal_mono (measure_ne_top _ _) hcond

end DirectionalTransience

