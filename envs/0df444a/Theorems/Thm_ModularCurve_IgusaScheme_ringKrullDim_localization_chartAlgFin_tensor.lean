    (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime]
    (k : Type) [Field k] [CharP k ℓ] [Algebra ↥(GaloisRep.ratLocalizedAt ℓ) k]
    (m : Ideal (k ⊗[↥(GaloisRep.ratLocalizedAt ℓ)] ↥(chartAlgFin N ℓ))) [m.IsMaximal] :
