variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution (Δ φ AX : ℕ) {d : ℕ} (s t : Fin d → ℕ) (ht : ∀ i, 2 ≤ t i)
    (hAX : ∀ i, NLogN.KFM.cAxU Δ (s i) (t i) φ ≤ AX) :
    NLogN.KFM.cChirpTabU Δ φ (NLogN.KFM.axL s t) (∏ i, t i) ≤
      d * (AX + 4000) + 10 ^ 11 * ((∏ i, t i) + 1) * (φ + Δ + 3) := by
  have hL : (NLogN.KFM.axL s t).length = d := by simp [NLogN.KFM.axL]
  have hP : ((NLogN.KFM.axL s t).map Prod.snd).prod = ∏ i, t i := by
    simp [NLogN.KFM.axL, List.map_ofFn, List.prod_ofFn]
  have h1 := NLogN.KFM.cChirpPU_le Δ φ AX (NLogN.KFM.axL s t)
    (fun p hp => by obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp; exact ht i)
    (fun p hp => by obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hp; exact hAX i)
  rw [hL, hP] at h1
  generalize ∏ i, t i = N at h1 ⊢
  have := NLogN.KFT.cRpt_le (2 * N); have := NLogN.KFM.cCnt_le (2 * N)
  have := NLogN.zsz_natCast_le_self' (2 * N)
  unfold NLogN.KFM.cChirpTabU
  nlinarith
end
