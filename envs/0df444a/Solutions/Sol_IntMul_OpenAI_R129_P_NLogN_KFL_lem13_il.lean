  generalize KFC.cRotF P Q S 1 = rf at hR
  generalize P * Q * S = V at hR
  have hc : 2 ≤ Bb + 2 := by omega
  generalize hcb : Bb + 2 = c at hseg hc ⊢
  have hcc : c ≤ c ^ 2 := by nlinarith
  have e1 : (f - 1) * (sg + 1100) ≤ f * (72 * 10 ^ 7 * c ^ 2 + 1100) :=
