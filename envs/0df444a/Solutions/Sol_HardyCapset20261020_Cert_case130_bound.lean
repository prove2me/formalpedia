private theorem cost_check : decide (cost certificate130 < certificate130.denominator * (deletedCount certificate130+1)) = true := by
  decide_cbv
theorem solution : CompletionBound (decode 1003) (0 : ZMod 3) := by
  have hs : certificate130.blockers.size = 6561 := by
    simp only [certificate130, binaryBlockers, Array.size_ofFn]
  have hb : CompletionBound (decode certificate130.normal) certificate130.level := by
    apply boolean_check_completion_bound
    unfold verifyB
    rw [hs, all_blocks, rows_check, covers_check, cost_check]
    decide_cbv
  exact hb
