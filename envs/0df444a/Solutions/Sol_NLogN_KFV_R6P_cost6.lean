theorem chase_arith {N B V cs a c t cu : ℕ}
    (hO : 10 ^ 12 * (B + 2) ^ 3 + 16 * cu ≤ V) (hN : N ≤ B)
    (ha : a ≤ 201 * 10 ^ 7 * (B + 2) ^ 2) (hc : c ≤ 201 * 10 ^ 7 * (B + 2) ^ 2)
    (hcs : cs ≤ 201 * 10 ^ 7 * (B + 2) ^ 2) (ht : t ≤ 200) :
    100 * (a + ((t + 1) * 2000 * (B + 2) + N * (cs + 8000 * (B + 2) + 30) + 32)) +
      (c + 2 * B + 27) + (2 * B + 2) + 201 * 10 ^ 7 * (B + 2) ^ 2 + 64 + 1 ≤ V := by
  have hT' : (t + 1) * 2000 * (B + 2) ≤ 201 * 2000 * (B + 2) := by
    apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; omega
  have hN2 : N ≤ B + 2 := Nat.le_add_right_of_le hN
  have hs2 : cs + 8000 * (B + 2) + 30 ≤ 201 * 10 ^ 7 * (B + 2) ^ 2 + 8000 * (B + 2) + 30 :=
    Nat.add_le_add_right (Nat.add_le_add_right hcs _) _
  have h1 := Nat.mul_le_mul hN2 hs2
  have e : (B + 2) * (201 * 10 ^ 7 * (B + 2) ^ 2 + 8000 * (B + 2) + 30) =
      201 * 10 ^ 7 * (B + 2) ^ 3 + 8000 * (B + 2) ^ 2 + 30 * (B + 2) := by ring
  rw [e] at h1
  have h3 := sq_le_cube B; have h4 := lin_le_cube B
  linarith

theorem chase_ovh_le {N n ℓ B : ℕ} (hO : OvOK n ℓ B) (hN : N ≤ B) :
    100 * cChase N B + cIteB eCnd.size B + (2 * B + 2) + 201 * 10 ^ 7 * (B + 2) ^ 2 + 64 + 1 ≤
      2 ^ (n + ℓ) := by
