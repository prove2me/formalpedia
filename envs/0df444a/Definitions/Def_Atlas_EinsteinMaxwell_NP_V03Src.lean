  {W : Set (ℝ × Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

/-- Shorthand for the frame projection `L_E(e_A, e_K)` of IV's linearised Einstein residual at KN (class B). -/
noncomputable abbrev LEfr (M a Q : ℝ) (h : Metric 4) (f : TwoForm 4) (A K : Fin 4) (y : Pt 4) : ℂ :=
  ccontr (linEinstein (gKN M a Q) (giKN M a Q) (faradayKN a Q) h f) y (fvec (knE M a Q) A y) (fvec (knE M a Q) K y)

