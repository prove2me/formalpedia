open ModularCurve ModularCurve.CharPModel AlgebraicCurve IsLocalRing

theorem ModularCurve.CharPModel.exists_fibreModel_cuspChart_integrallyClosed_of_prime
    (p : ℕ) [Fact p.Prime] (ℓ : ℕ) [Fact ℓ.Prime] (hℓp : ℓ ≠ p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ)
    [CharP (ResidueField ↥A) ℓ] :
    ∃ fm : FibreModel p A ℓ (ResidueField ↥A) (IsLocalRing.residue ↥A),
      fm.CuspChart ∧ IsIntegrallyClosed fm.BFin ∧ IsIntegrallyClosed fm.BInf := by sorry
