variable {E : Type} [Field E] [NumberField E] [IsCMField E] {r : ℕ} (X : Data E r)

theorem UnipMove.GraphH.sum_mul_ext (f : Fin r → ℂ) (d : Fin X.p0 → ℂ) :
    ∑ j, f j * ext X d j = ∑ b, f (Fin.castLE X.p0_le b) * d b := by sorry
