        ∃ φ : 𝒞.FSS s ≃ₐ[ResidueField A] 𝒞.FSS s, SemistableCovering.InducesOnChart (𝒞.CSS s) g φ.toRingEquiv ∧
          ∀ P ∈ (𝒞.CSS s).dom, (𝒞.CSS s).placeMap (g • P) = SemilinearAut.ofAlgAut φ • (𝒞.CSS s).placeMap P) ∧
