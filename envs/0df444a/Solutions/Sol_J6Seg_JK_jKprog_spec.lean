  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
  · simp +decide only [kS, hdrSt, update_apply, ↓reduceIte]
    exact hF0 _ (by decide) (by decide)

theorem partF_kS {F0 : Fin HS → List ℤ} (hF0 : ∀ j, j ≠ 0 → j ≠ dTJ → F0 j = [])
    (z0 re im v wr wi : List ℤ) :
    PartF P k K G fs.length (nBd bs) (jBody k fs bs cc).length
      (kS (jB (P := P) (k := k) (K := K) (G := G) (fs := fs) (bs := bs) (cc := cc) F0)
        z0 re im v [] [] wr wi) := by
  have e := fun j (hj : j ∈ [CNT, SUM, PX, CD, CR, CM, NUM, PV, IV, FL, NN, QQ, DD, Q0, TM2, ER,
