-- Source module: Solutions.R6BitNBObst
/-!
# Round six, bit side: the label route `prop11H_labels` admits **no saving**

`prop11H_labels` (R6BitProp11) derives `C.OK` from `EdgesOK`, `LabOK`, `ScalarOK`: every gate
touches wires with *equal* frame labels, and every role ends at label `swapMat`. This file proves
that these hypotheses force the total child width to be at least `W m`:

* the `H × D` block `hdB` of a frame matrix is subadditive in rank under products
  (`rank_hdB_mul_le`), vanishes on lower triangular Bruhat factors and on `1`, and has rank `m`
  on `swapMat`;
* an edge `E₁ σ E₂` therefore has `rank hdB ≤ #transpositions ≤ Σ run widths`
  (`rank_hdB_edgeMat_le`);
* along each role wire the labels go from `1` to `swapMat`, so each of the `W` (distinct, by
  `ScalarOK`) role wires carries edges of total width `≥ m` (`widths_sum_ge`).

Consequently `histMoment C.hist m τ ≥ W` for every `0 < τ ≤ 1` (`labels_no_saving`): the
hypotheses of `prop11H_labels` are **jointly inconsistent** (`prop11H_labels_vacuous`), and in
particular no network with the histogram `Jain.bitR6` (rank sum `W m − 1344189`) satisfies them
(`no_bitR6_labels`).

The real two-stage network escapes this because its data outputs are sums of terms at
*different* frames (`B = F x + E y`, fixed by the copy correction `T F = E`), which the
single-label invariant cannot express. See `R6BitNBFormal` for the replacement calculus.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

/-! ## Blocks of `2m × 2m` matrices -/

/-! ## Edges and label paths -/

/-! ## The bound -/

namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

/-- **Moment form.** Under the hypotheses of `prop11H_labels`, `histMoment C.hist m τ ≥ W` for
every `0 < τ ≤ 1`. -/
theorem labels_no_saving_sol_aux [Nontrivial R] (C : QHNet R W T m) (hm : 0 < m) {q : ℕ} (hq : q.Prime)
    (hruns : C.RunsOK) (hE : C.EdgesOK q) (hlab : C.LabOK q) (hsc : C.ScalarOK) {τ : ℝ}
    (_hτ0 : 0 < τ) (hτ1 : τ ≤ 1) : (W : ℝ) ≤ histMoment C.hist m τ := by
  have hsum := widths_sum_ge C hq hE hlab hsc
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  rw [histMoment, sum_hist C (fun w => ((w : ℝ) / m) ^ τ)]
  have hle : ∀ w ∈ C.widths, (w : ℝ) / m ≤ ((w : ℝ) / m) ^ τ := by
    intro w hw
    obtain ⟨e, he, ρ, hρ, rfl⟩ := mem_widths hw
    have h0 : (0 : ℝ) < ρ.2.2 := by exact_mod_cast (hruns e he ρ hρ).1
    have h1 : (ρ.2.2 : ℝ) < m := by exact_mod_cast (hruns e he ρ hρ).2.1
    have hx0 : 0 < (ρ.2.2 : ℝ) / m := div_pos h0 hmR
    have hx1 : (ρ.2.2 : ℝ) / m ≤ 1 := (div_le_one hmR).2 h1.le
    calc (ρ.2.2 : ℝ) / m = ((ρ.2.2 : ℝ) / m) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ ((ρ.2.2 : ℝ) / m) ^ τ := Real.rpow_le_rpow_of_exponent_ge hx0 hx1 hτ1
  have key : (C.widths.map fun w : ℕ => (w : ℝ) / m).sum ≤
      (C.widths.map fun w : ℕ => ((w : ℝ) / m) ^ τ).sum := List.sum_le_sum hle
  have e : ∀ l : List ℕ, (l.map fun w : ℕ => (w : ℝ) / m).sum = (l.sum : ℝ) / m := by
    intro l; induction l with
    | nil => simp
    | cons a l ih => simp [ih, add_div]
  rw [e] at key
  refine le_trans ?_ key
  rw [le_div_iff₀ hmR]
  exact_mod_cast hsum

end QHNet

end IntMul.Kappa.R6.Bit

end

