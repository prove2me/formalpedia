variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
  {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}

private theorem norm_inducedE_le (hdeg : Module.finrank ℚ K ≤ 3) (hμ : AutomorphicForm.IsUnitaryChar (𝓞 K) K μ)
    (v : HeightOneSpectrum (𝓞 ℚ)) :
    ‖inducedE1 ℚ (inducedCoeff K μ) v‖ ≤ 8 ∧ ‖inducedE2 ℚ (inducedCoeff K μ) v‖ ≤ 8 ∧
      ‖inducedE3 ℚ (inducedCoeff K μ) v‖ ≤ 8 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hcoeff : ∀ i : ℕ, ‖(inducedEulerPoly ℚ (inducedCoeff K μ) v).coeff i‖ ≤ 8 := by
    intro i
    rw [inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ (FibreDegree.primeFibre_finite K v)]
    refine (norm_coeff_prod_inducedFactor_le (inducedCoeff K μ) (fun 𝔓 _ => norm_inducedCoeff_le_one hμ 𝔓) i).trans ?_
    have hcard : (FibreDegree.primeFibre_finite K v).toFinset.card ≤ 3 := (card_toFinset_primeFibre_le K v).trans hdeg
    exact (pow_le_pow_right₀ one_le_two hcard).trans (by norm_num)
  refine ⟨?_, ?_, ?_⟩
  · rw [inducedE1, norm_neg]
    exact hcoeff 1
  · rw [inducedE2]
    exact hcoeff 2
  · rw [inducedE3, norm_neg]
    exact hcoeff 3

private theorem two_le_absNorm (v : HeightOneSpectrum (𝓞 ℚ)) : 2 ≤ Ideal.absNorm v.asIdeal := by
  have h0 : Ideal.absNorm v.asIdeal ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]
    exact v.ne_bot
  have h1 : Ideal.absNorm v.asIdeal ≠ 1 := by
    rw [Ne, Ideal.absNorm_eq_one_iff]
    exact v.isPrime.ne_top
  omega

private theorem norm_torusValue_le (hdeg : Module.finrank ℚ K ≤ 3) (hμ : AutomorphicForm.IsUnitaryChar (𝓞 K) K μ)
    {v : HeightOneSpectrum (𝓞 ℚ)} {W : LocalGL3 v → ℂ} (hsph : HasSphericalTorusValuesAt (inducedCoeff K μ) v W)
    (n : ℕ) : ‖torusValue W n‖ ≤ (2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (4 : ℝ)) ^ n := by
  obtain ⟨h₁, h₂, h₃⟩ := norm_inducedE_le hdeg hμ v
  have hN : (2 : ℝ) ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) := by exact_mod_cast two_le_absNorm v
  have hval := norm_sphericalTorusValue_le (by norm_num) h₁ h₂ h₃ n
  have hinv : ‖(cNormQ v)⁻¹‖ ≤ 1 := by
    rw [norm_inv, cNormQ, Complex.norm_natCast]
    exact inv_le_one_of_one_le₀ (by exact_mod_cast (one_le_two.trans (two_le_absNorm v)))
  have hbase : (3 * 8 : ℝ) ≤ 2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (4 : ℝ) := by
    rw [Real.rpow_ofNat]
    have h16 : (2 : ℝ) ^ 4 ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ 4 := pow_le_pow_left₀ (by norm_num) hN 4
    norm_num at h16 ⊢
    linarith
  rw [torusValue_natCast W n, hsph.1 n, norm_mul, norm_pow]
  refine (mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hinv n) hval (norm_nonneg _) (by positivity)).trans ?_
  rw [one_pow, one_mul]
  exact pow_le_pow_left₀ (by norm_num) hbase n

end
