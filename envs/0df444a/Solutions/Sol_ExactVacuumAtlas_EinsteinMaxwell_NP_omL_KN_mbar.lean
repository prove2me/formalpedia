theorem cL_rev {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {C A B : Fin 4} {x : Pt 4} {v : ℂ}
    (h : cL E Θ C A B x = v) : cL E Θ C B A x = -v := by
  rw [cL_antisymm, h]

theorem cL_diag (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (C A : Fin 4) (x : Pt 4) : cL E Θ C A A x = 0 := by
  have h := cL_antisymm E Θ C A A x
  linear_combination h / 2

theorem swap23_0 : swap23 0 = 0 := rfl
theorem swap23_1 : swap23 1 = 1 := rfl
theorem swap23_2 : swap23 2 = 3 := rfl

section tab

variable {M a Q : ℝ} {x : Pt 4}

theorem cL_KN_swapped (hx : x ∈ domReg M a Q) (C A B : Fin 4) :
    cL (knE M a Q) (knTh M a Q) (swap23 C) (swap23 A) (swap23 B) x = conj (cL (knE M a Q) (knTh M a Q) C A B x) :=
  cL_swap (nullFrameData_KN M a Q) (knE_swap M a Q) hx C A B

theorem cL_KN_301 (hx : x ∈ domReg M a Q) :
    cL (knE M a Q) (knTh M a Q) 3 0 1 x = I * ((a * Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x ^ 2)
      + I * ((a * Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * ((Sig a (x 1) (x 2) : ℝ) : ℂ)) := by
  have h := cL_KN_swapped hx 2 0 1
  rw [swap23_2, swap23_0, swap23_1, (cL_KN_01 hx).2.2] at h
  rw [h]
  simp [map_div₀, qK_conj]
  ring

