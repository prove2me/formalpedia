variable {K : Type} [Field K] [NumberField K]
variable {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}

attribute [local instance] NumberField.Idele.ideleBorel NumberField.Idele.borelSpace_ideleBorel

private theorem t0567 (dF : FinWhittakerDatum K S Pi)
    {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {ℓ : (AdeleRing (𝓞 K) K)ˣ}
    (harch : ∀ w : InfinitePlace K, ((ℓ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w = 1)
    (hS : ∀ v ∈ S, ((ℓ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1) (η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ)
    (a : (AdeleRing (𝓞 K) K)ˣ) :
    zetaIntegrand (fun g => cutS S (diagOne ℓ * g) * A (diagOne ℓ * g) * dF.Wf (diagOne ℓ * g)) η s a =
      zetaIntegrand (cutWf dF A ℓ) η s a := by
  unfold zetaIntegrand cutWf
  dsimp only
  have hcut : cutS S (diagOne ℓ * diagOne a) = cutS S (diagOne a) := by
    refine t0363 fun w hw => ?_
    have h1 : unitAt w ℓ = 1 := Units.ext (by rw [t0051, hS w hw]; rfl)
    rw [map_mul, t0099, h1, map_one, one_mul]
  have hA' : A (diagOne ℓ * diagOne a) = A (diagOne a) :=
    hA _ _ (by rw [map_mul, t0353 (funext harch), one_mul])
  rw [hcut, hA']

private theorem t0568 (a : (AdeleRing (𝓞 K) K)ˣ) :
    (a ∈ unitIdelesAt S ∧
        a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 K) K (↑S : Set (HeightOneSpectrum (𝓞 K)))) ↔
      a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 K) K
        (↑(∅ : Finset (HeightOneSpectrum (𝓞 K))) : Set (HeightOneSpectrum (𝓞 K))) := by
  rw [← t0417, t0389]
  change (∀ v ∈ S, _ ∧ _) ∧
      (∀ v : HeightOneSpectrum (𝓞 K), v ∉ (↑S : Set (HeightOneSpectrum (𝓞 K))) →
        ((a : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v ∈ v.adicCompletionIntegers K ∧
          ((a⁻¹ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v ∈ v.adicCompletionIntegers K) ↔
      ∀ v : HeightOneSpectrum (𝓞 K), v ∉ (↑(∅ : Finset (HeightOneSpectrum (𝓞 K))) : Set (HeightOneSpectrum (𝓞 K))) →
        ((a : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v ∈ v.adicCompletionIntegers K ∧
          ((a⁻¹ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v ∈ v.adicCompletionIntegers K
  simp only [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, Finset.mem_coe, Finset.coe_empty,
    Set.mem_empty_iff_false, not_false_eq_true, true_implies]
  constructor
  · rintro ⟨hin, hout⟩ v
    by_cases hv : v ∈ S
    · exact hin v hv
    · exact hout v hv
  · intro h
    exact ⟨fun v _ => h v, fun v _ => h v⟩

private theorem t0569 (a : (AdeleRing (𝓞 K) K)ˣ) :
    NumberField.Idele.partAt K S a ∈ unitIdelesAt S ↔ a ∈ unitIdelesAt S := by
  rw [t0137, t0137]
  refine forall_congr' fun v => ?_
  rw [t0051, t0051, NumberField.Idele.partAt_snd_of_mem K S a v.2]

private theorem t0570 :
    Measure.map (NumberField.Idele.partAt K ∅)
        ((NumberField.Idele.sPartMeasure K S).restrict ((unitIdelesAt S : Subgroup (AdeleRing (𝓞 K) K)ˣ) :
          Set (AdeleRing (𝓞 K) K)ˣ)) =
      NumberField.Idele.sPartMeasure K ∅ := by
  have hU := (t0138 (K := K) S).measurableSet
  unfold NumberField.Idele.sPartMeasure
  rw [Measure.restrict_map (NumberField.Idele.measurable_partAt K S) hU,
    Measure.map_map (NumberField.Idele.measurable_partAt K ∅) (NumberField.Idele.measurable_partAt K S),
    Measure.restrict_restrict ((NumberField.Idele.measurable_partAt K S) hU)]
  have hfun : NumberField.Idele.partAt K ∅ ∘ NumberField.Idele.partAt K S = NumberField.Idele.partAt K ∅ :=
    funext fun a => t0561 a
  have hset : NumberField.Idele.partAt K S ⁻¹' ((unitIdelesAt S : Subgroup (AdeleRing (𝓞 K) K)ˣ) :
        Set (AdeleRing (𝓞 K) K)ˣ) ∩
        (NumberField.AdeleRing.unitIdelesOutside (𝓞 K) K (↑S : Set (HeightOneSpectrum (𝓞 K))) :
          Set (AdeleRing (𝓞 K) K)ˣ) =
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 K) K
        (↑(∅ : Finset (HeightOneSpectrum (𝓞 K))) : Set (HeightOneSpectrum (𝓞 K))) : Set (AdeleRing (𝓞 K) K)ˣ) := by
    ext a
    rw [Set.mem_inter_iff, Set.mem_preimage, SetLike.mem_coe, SetLike.mem_coe, SetLike.mem_coe,
      t0569, t0568]
  rw [hfun, hset]

private theorem t0571 {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g)
    {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hη : d048 S η) (s : ℂ)
    (hG : AEStronglyMeasurable (zetaIntegrand A η s) (NumberField.Idele.sPartMeasure K ∅)) :
    ∫ a, zetaIntegrand (fun g => cutS S g * A g) η s a ∂(NumberField.Idele.sPartMeasure K S) =
      ∫ a, zetaIntegrand A η s a ∂(NumberField.Idele.sPartMeasure K ∅) := by
  have hrange := ae_map_mem_range (NumberField.Idele.partAt K S) (t0398 (S := S))
    ((NumberField.Idele.idelicHaar K).restrict
      (NumberField.AdeleRing.unitIdelesOutside (𝓞 K) K (↑S : Set (HeightOneSpectrum (𝓞 K)))))
  have hcongr : ∫ a, zetaIntegrand (fun g => cutS S g * A g) η s a ∂(NumberField.Idele.sPartMeasure K S) =
      ∫ a, ((unitIdelesAt S : Subgroup (AdeleRing (𝓞 K) K)ˣ) : Set (AdeleRing (𝓞 K) K)ˣ).indicator
        (fun a => zetaIntegrand A η s (NumberField.Idele.partAt K ∅ a)) a ∂(NumberField.Idele.sPartMeasure K S) := by
    refine integral_congr_ae ?_
    unfold NumberField.Idele.sPartMeasure
    filter_upwards [hrange] with a ha
    obtain ⟨b, rfl⟩ := ha
    rw [t0566 hA hη s b, Set.indicator_apply, SetLike.mem_coe]
    split_ifs
    · show _ = zetaIntegrand A η s (NumberField.Idele.partAt K ∅ (NumberField.Idele.partAt K S b))
      rw [t0561]
      rfl
    · rfl
  have hG' : AEStronglyMeasurable (zetaIntegrand A η s)
      (Measure.map (NumberField.Idele.partAt K ∅) ((NumberField.Idele.sPartMeasure K S).restrict
        ((unitIdelesAt S : Subgroup (AdeleRing (𝓞 K) K)ˣ) : Set (AdeleRing (𝓞 K) K)ˣ))) := by
    rw [t0570]
    exact hG
  rw [hcongr, integral_indicator (t0138 (K := K) S).measurableSet,
    ← t0570 (S := S),
    integral_map (NumberField.Idele.measurable_partAt K ∅).aemeasurable hG']

private theorem t0572 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {ℓ : (AdeleRing (𝓞 K) K)ˣ}
    (harch : ∀ w : InfinitePlace K, ((ℓ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w = 1)
    (hS : ∀ v ∈ S, ((ℓ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1) {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hη : d048 S η) (s : ℂ)
    (hG : AEStronglyMeasurable (zetaIntegrand A η s) (NumberField.Idele.sPartMeasure K ∅)) :
    ∫ a, zetaIntegrand (fun g => cutS S (diagOne ℓ * g) * A (diagOne ℓ * g) * dF.Wf (diagOne ℓ * g)) η s a
        ∂(NumberField.Idele.sPartMeasure K S) =
      dF.Wf (diagOne ℓ) * ∫ a, zetaIntegrand A η s a ∂(NumberField.Idele.sPartMeasure K ∅) := by
  rw [integral_congr_ae (Filter.Eventually.of_forall fun a =>
      t0567 dF hA harch hS η s a),
    t0399 dF A ℓ η s, t0571 hA hη s hG]

