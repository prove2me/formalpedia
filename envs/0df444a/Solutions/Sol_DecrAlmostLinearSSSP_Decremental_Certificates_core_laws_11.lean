section s369
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreGeometry
open Structured
lemma Image.write_deletion_cost (b : Core) (B : ℕ) (state : State b) (e : Fin b.input.k) (s : Data)
    (h : Image b B state s) :
    Image b B {state with active := state.active.erase e}
      {s with realMem := Function.update s.realMem (CoreMemory.field b B (.inl e) 2) (H b/Q b)} := by
  classical
  have hdiff (d : Edge b) (j : ℕ) (hj : j < 5) (hne : j ≠ 2) :
      CoreMemory.field b B d j ≠ CoreMemory.field b B (.inl e) 2 := by
    intro hh
    exact hne (CoreMemory.field_injective b B d (.inl e) j 2 hj (by omega) hh).2
  refine ⟨fun d => (Function.update_of_ne (hdiff d 0 (by omega) (by omega)) _ _).trans (h.cache d),
    fun d => (Function.update_of_ne (hdiff d 1 (by omega) (by omega)) _ _).trans (h.coefficient d),?_,
    fun d => (Function.update_of_ne (hdiff d 4 (by omega) (by omega)) _ _).trans (h.initial d),
    h.tail,h.head,h.returnFlag,
    fun v => (Function.update_of_ne (hdiff (.inr v) 3 (by omega) (by omega)) _ _).trans (h.samples v)⟩
  intro d
  cases d with
  | inl f =>
    by_cases hf : f = e
    · subst f
      change Function.update s.realMem _ (H b/Q b) _ = _
      rw [Function.update_self]
      simp [DecrAlmostLinearSSSP.Decremental.cost]
    · have haddr : CoreMemory.field b B (.inl f) 2 ≠ CoreMemory.field b B (.inl e) 2 := by
        intro hh
        have heq := (CoreMemory.field_injective b B (.inl f) (.inl e) 2 2 (by omega) (by omega) hh).1
        exact hf (Sum.inl.inj heq)
      change Function.update s.realMem _ _ _ = _
      rw [Function.update_of_ne haddr,h.cost (.inl f)]
      simp [DecrAlmostLinearSSSP.Decremental.cost,hf]
  | inr v =>
    have haddr : CoreMemory.field b B (.inr v) 2 ≠ CoreMemory.field b B (.inl e) 2 := by
      intro hh
      have heq := (CoreMemory.field_injective b B (.inr v) (.inl e) 2 2 (by omega) (by omega) hh).1
      cases heq
    change Function.update s.realMem _ _ _ = _
    rw [Function.update_of_ne haddr,h.cost (.inr v)]
    rfl
end DecrAlmostLinearSSSP.Decremental.CoreGeometry
