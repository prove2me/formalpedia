attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section LieGeometry

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 3.14, PDF pp. 11–12. All three tests and the conditional xk≠0 are retained. -/
theorem reductive_compact_pointed_criteria [LieAlgebra.HasCentralRadical ℝ G]
    (K P : LieIdeal ℝ G) (hk : MaximalCompactIdeal K) (hd : IsCompl K.toSubmodule P.toSubmodule)
    (xk xp : G) (hxk : xk ∈ K) (hxp : xp ∈ P) :
    (Pointed (orbitCone (xk + xp)) ↔ Pointed (orbitCone xp) ∧
      (AdNilpotent xp → xk ≠ 0 → xk ∉ bracketSpan K.toSubmodule K.toSubmodule)) ∧
    (Pointed (orbitCone (xk + xp)) ↔ Pointed (orbitHull (xk + xp)) ∧
      ((0 : G) ∈ orbitHull (xk + xp) → xk = 0 ∧ AdNilpotent xp)) := by sorry

end LieGeometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
