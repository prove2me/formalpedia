    gflat (pull (sh ++ [r]) (sh ++ [r]) (extA sh.length g) 0 zs) =
      pull (sh ++ [r, 2]) (sh ++ [r, 2]) (extA sh.length g) 0 (gflat zs) := by
  rw [KFS.gflat_eq_flatMap, KFS.pull_flatMap (sh ++ [r]) _ (fun a ha => valid_extA hg ha) _ 2
    (fun _ => rfl) 0 0 zs hzs, ← KFS.gflat_eq_flatMap]
  have e : sh ++ [r] ++ [2] = sh ++ [r, 2] := by simp
  rw [e]
  apply pull_congr
  intro a ha
  have hl := ha.length_eq
  simp only [List.length_append, List.length_cons, List.length_nil] at hl
  unfold extA
  rw [List.take_take, min_eq_left (by simp), List.length_append, List.length_singleton,
    List.append_assoc]
  congr 1
  rw [List.drop_take, show sh.length + 1 - sh.length = 1 by omega, ← List.drop_drop,
    List.take_append_drop]

end Rec

