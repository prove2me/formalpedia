private theorem map_upperUnipotent3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B) (x y z : A) :
    Matrix.GeneralLinearGroup.map f (upperUnipotent3 x y z) = upperUnipotent3 (f x) (f y) (f z) := by
  apply Units.ext
  show f.mapMatrix !![1, x, z; 0, 1, y; 0, 0, 1] = !![1, f x, f z; 0, 1, f y; 0, 0, 1]
  rw [RingHom.mapMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

private theorem componentAt3_upperUnipotent3 (v : HeightOneSpectrum (𝓞 ℚ)) (x y z : AdeleRing (𝓞 ℚ) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (upperUnipotent3 x y z) =
      upperUnipotent3 (adeleCoord v x) (adeleCoord v y) (adeleCoord v z) :=
  map_upperUnipotent3 ((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)) x y z

private theorem archComponent3_upperUnipotent3 (x y z : AdeleRing (𝓞 ℚ) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (upperUnipotent3 x y z) =
      upperUnipotent3 (adeleArchCoord x) (adeleArchCoord y) (adeleArchCoord z) :=
  map_upperUnipotent3 (AdelicLevel.adeleArch (𝓞 ℚ) ℚ) x y z

private theorem coe_upperUnipotent3_zero_one {A : Type} [CommRing A] (x y z : A) :
    ((upperUnipotent3 x y z : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) 0 1 = x := rfl

private theorem coe_upperUnipotent3_one_two {A : Type} [CommRing A] (x y z : A) :
    ((upperUnipotent3 x y z : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) 1 2 = y := rfl

private theorem adeleCoord_add_mem_of_upperUnipotent3_mem {v : HeightOneSpectrum (𝓞 ℚ)} {x y z : AdeleRing (𝓞 ℚ) ℚ}
    (h : componentAt3 (𝓞 ℚ) ℚ v (upperUnipotent3 x y z) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    adeleCoord v (x + y) ∈ v.adicCompletionIntegers ℚ := by
  rw [componentAt3_upperUnipotent3, mem_localMaximalCompact3_iff] at h
  have hx := h.1 0 1
  have hy := h.1 1 2
  rw [coe_upperUnipotent3_zero_one] at hx
  rw [coe_upperUnipotent3_one_two] at hy
  rw [map_add]
  exact add_mem ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hx)
    ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hy)

variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) {Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ}
  {S : Finset (HeightOneSpectrum (𝓞 ℚ))}
  (hone : ∀ v, v ∉ S → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)

include hone in

private theorem isGL3PsiWhittakerFn_adelicProduct (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (hψ : Continuous ψ)
    (harch : IsGL3PsiWhittakerFn
      (ψ.compAddMonoidHom (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ))) Warch)
    (hloc : ∀ v, IsGL3PsiWhittakerFn (psiLoc ψ v) (Wloc v)) :
    IsGL3PsiWhittakerFn ψ (adelicProduct Warch Wloc) := by
  classical
  intro x y z g
  obtain ⟨T₀, hT₀⟩ := exists_finset_apply_eq_mul_prod_psiLoc ψ hψ
  set n : AdelicGL 3 (𝓞 ℚ) ℚ := upperUnipotent3 x y z with hn
  set T : Finset (HeightOneSpectrum (𝓞 ℚ)) :=
    T₀ ∪ S ∪ (finite_setOf_not_mem_localMaximalCompact3 g).toFinset ∪
      (finite_setOf_not_mem_localMaximalCompact3 n).toFinset with hT
  have hT₀T : T₀ ⊆ T := fun v hv => by
    rw [hT]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hv))
  have hST : S ⊆ T := fun v hv => by
    rw [hT]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hv))
  have hgT : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    by_contra hbad
    rw [hT] at hv
    exact hv (Finset.mem_union_left _ (Finset.mem_union_right _
      ((finite_setOf_not_mem_localMaximalCompact3 g).mem_toFinset.2 hbad)))
  have hnT : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v n ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    by_contra hbad
    rw [hT] at hv
    exact hv (Finset.mem_union_right _ ((finite_setOf_not_mem_localMaximalCompact3 n).mem_toFinset.2 hbad))
  have hngT : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v (n * g) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    rw [map_mul]
    exact mul_mem (hnT v hv) (hgT v hv)
  have hint : ∀ v, v ∉ T → adeleCoord v (x + y) ∈ v.adicCompletionIntegers ℚ := fun v hv =>
    adeleCoord_add_mem_of_upperUnipotent3_mem (hnT v hv)
  have hψxy := hT₀ T hT₀T (x + y) hint
  rw [map_add adeleArchCoord x y] at hψxy
  have hfactors : ∀ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v (n * g)) =
      psiLoc ψ v (adeleCoord v x + adeleCoord v y) * Wloc v (componentAt3 (𝓞 ℚ) ℚ v g) := fun v _ => by
    simp only [map_mul, hn, componentAt3_upperUnipotent3]
    exact hloc v _ _ _ _
  have harch' : Warch (archComponent3 (𝓞 ℚ) ℚ (n * g)) =
      ψ (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ) (adeleArchCoord x + adeleArchCoord y)) *
        Warch (archComponent3 (𝓞 ℚ) ℚ g) := by
    simp only [map_mul, hn, archComponent3_upperUnipotent3]
    exact harch _ _ _ _
  have hcoord : (∏ v ∈ T, psiLoc ψ v (adeleCoord v (x + y))) =
      ∏ v ∈ T, psiLoc ψ v (adeleCoord v x + adeleCoord v y) :=
    Finset.prod_congr rfl fun v _ => by rw [map_add (adeleCoord v) x y]
  simp only [adelicProduct_eq_prod Warch hone (n * g) T hST hngT, adelicProduct_eq_prod Warch hone g T hST hgT,
    Finset.prod_congr rfl hfactors, harch']
  rw [Finset.prod_mul_distrib, hψxy, hcoord]
  ring

include hone in

private theorem adelicProduct_centralScalarGL_mul (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hω : Continuous ω)
    (N₀ : Finset (HeightOneSpectrum (𝓞 ℚ))) (hN₀ : ∀ v, v ∉ N₀ → TateGlobal.IsUnramifiedCharAt ω v)
    (ι : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hι : ∀ a : (InfiniteAdeleRing ℚ)ˣ,
      ((ι a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ) = ((a : InfiniteAdeleRing ℚ), 1))
    (harch : ∀ (a : (InfiniteAdeleRing ℚ)ˣ) (h : GL (Fin 3) (InfiniteAdeleRing ℚ)),
      Warch (Matrix.GeneralLinearGroup.scalar (Fin 3) a * h) = ((ω (ι a) : ℂˣ) : ℂ) * Warch h)
    (hloc : ∀ (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) (h : LocalGL3 v),
      Wloc v (Matrix.GeneralLinearGroup.scalar (Fin 3) t * h) = ((TateGlobal.localChar ω v t : ℂˣ) : ℂ) * Wloc v h)
    (z : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    adelicProduct Warch Wloc (centralScalarGL 3 (𝓞 ℚ) ℚ z * g) = ((ω z : ℂˣ) : ℂ) * adelicProduct Warch Wloc g := by
  classical
  set T : Finset (HeightOneSpectrum (𝓞 ℚ)) :=
    N₀ ∪ S ∪ (finite_setOf_not_mem_localMaximalCompact3 g).toFinset ∪
      (finite_setOf_not_mem_localMaximalCompact3 (centralScalarGL 3 (𝓞 ℚ) ℚ z)).toFinset with hT
  have hN₀T : ∀ v, v ∉ T → TateGlobal.IsUnramifiedCharAt ω v := fun v hv => by
    refine hN₀ v fun hvN => hv ?_
    rw [hT]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _ hvN))
  have hST : S ⊆ T := fun v hv => by
    rw [hT]
    exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _ hv))
  have hgT : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    by_contra hbad
    rw [hT] at hv
    exact hv (Finset.mem_union_left _ (Finset.mem_union_right _
      ((finite_setOf_not_mem_localMaximalCompact3 g).mem_toFinset.2 hbad)))
  have hzT : ∀ v, v ∉ T →
      componentAt3 (𝓞 ℚ) ℚ v (centralScalarGL 3 (𝓞 ℚ) ℚ z) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    by_contra hbad
    rw [hT] at hv
    exact hv (Finset.mem_union_right _
      ((finite_setOf_not_mem_localMaximalCompact3 (centralScalarGL 3 (𝓞 ℚ) ℚ z)).mem_toFinset.2 hbad))
  have hzu : ∀ v, v ∉ T → IsIntegralUnit v (unitsAt v z) := fun v hv => by
    have h := hzT v hv
    rw [componentAt3_centralScalarGL, glScalar_mem_localMaximalCompact3_iff] at h
    exact h
  have hzgT : ∀ v, v ∉ T →
      componentAt3 (𝓞 ℚ) ℚ v (centralScalarGL 3 (𝓞 ℚ) ℚ z * g) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := fun v hv => by
    rw [map_mul]
    exact mul_mem (hzT v hv) (hgT v hv)
  have hfactors : ∀ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v (centralScalarGL 3 (𝓞 ℚ) ℚ z * g)) =
      ((TateGlobal.localChar ω v (unitsAt v z) : ℂˣ) : ℂ) * Wloc v (componentAt3 (𝓞 ℚ) ℚ v g) := fun v _ => by
    simp only [map_mul, componentAt3_centralScalarGL]
    exact hloc v _ _
  have harch' : Warch (archComponent3 (𝓞 ℚ) ℚ (centralScalarGL 3 (𝓞 ℚ) ℚ z * g)) =
      ((ω (ι (unitsAtInfinity z)) : ℂˣ) : ℂ) * Warch (archComponent3 (𝓞 ℚ) ℚ g) := by
    simp only [map_mul, archComponent3_centralScalarGL]
    exact harch _ _
  have hωz := apply_eq_apply_unitsAtInfinity_mul_prod_localChar ω hω T hN₀T ι hι z hzu
  simp only [adelicProduct_eq_prod Warch hone _ T hST hzgT, adelicProduct_eq_prod Warch hone g T hST hgT,
    Finset.prod_congr rfl hfactors, harch']
  rw [Finset.prod_mul_distrib, hωz, Units.val_mul, Units.coe_prod]
  ring

end LanglandsTunnell.CubicInduction.ProductClauses
