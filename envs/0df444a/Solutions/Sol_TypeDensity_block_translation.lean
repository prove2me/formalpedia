theorem solution (O : Type) [CommRing O] [IsLocalRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) (r : ℕ) :
    Set.BijOn (TypeDensity.translateBlock O Φ r) (TypeDensity.blockCell O Φ r) (TypeDensity.zeroCell O Φ r) ∧
      (∀ (L : ℕ) (b b' : Fin r → AdjoinRoot Φ), (∀ j, b j - b' j ∈ (TypeDensity.baseIdeal O Φ) ^ L) ↔ ∀ j,
        TypeDensity.translateBlock O Φ r b j - TypeDensity.translateBlock O Φ r b' j ∈ (TypeDensity.baseIdeal O Φ) ^ L) := by
  set A := AdjoinRoot Φ
  have : Nontrivial (TypeDensity.residueExtension O Φ) := ⟨(TypeDensity.residue_extension_field O Φ hΦ).1.exists_pair_ne⟩
  have : Nontrivial A := (TypeDensity.baseReduce O Φ).domain_nontrivial
  set θ := AdjoinRoot.root Φ
  have R := fun (a : Fin r → A) => TypeDensity.monic_poly_reconstruct A r a
  -- translated polynomial
  have hT : ∀ b : Fin r → A, TypeDensity.monicPolyO (TypeDensity.translateBlock O Φ r b) = taylor θ (TypeDensity.monicPolyO b) := by
    intro b
    obtain ⟨h1, h2, -, -⟩ := R b
    exact (R b).2.2.2 _ (by rw [Monic, leadingCoeff_taylor]; exact h1)
        (by rw [natDegree_taylor, h2])
  -- coefficient congruence criterion
  have key : ∀ (J : Ideal A) (c c' : Fin r → A),
      (∀ j, c j - c' j ∈ J) ↔ TypeDensity.monicPolyO c - TypeDensity.monicPolyO c' ∈ J.map (C : A →+* A[X]) := by
    intro J c c'
    obtain ⟨m1, d1, e1, -⟩ := R c
    obtain ⟨m2, d2, e2, -⟩ := R c'
    rw [Ideal.mem_map_C_iff]
    constructor
    · intro h n
      rw [coeff_sub]
      by_cases hn : n < r
      · have := h ⟨n, hn⟩
        rwa [← e1 ⟨n, hn⟩, ← e2 ⟨n, hn⟩] at this
      · rw [TypeDensity.coeff_eq_of_monic_of_le m1 m2 d1 d2 (not_lt.mp hn), sub_self]; exact J.zero_mem
    · intro h j
      have := h j
      rwa [coeff_sub, e1, e2] at this
  have tmem : ∀ (J : Ideal A) (s : A) (f : A[X]), f ∈ J.map (C : A →+* A[X]) →
      taylor s f ∈ J.map (C : A →+* A[X]) := by
    intro J s f hf
    have : ((taylorAlgHom s : A[X] →ₐ[A] A[X]) : A[X] →+* A[X]).comp C = C := by
      ext x
      · simp [taylor_C]
      · simp
    have h2 := Ideal.mem_map_of_mem ((taylorAlgHom s : A[X] →ₐ[A] A[X]) : A[X] →+* A[X]) hf
    rw [Ideal.map_map, this] at h2
    simpa using h2
  have hinv : ∀ f : A[X], taylor (-θ) (taylor θ f) = f := by
    intro f; rw [taylor_taylor, neg_add_cancel, taylor_zero]
  have hinv' : ∀ f : A[X], taylor θ (taylor (-θ) f) = f := by
    intro f; rw [taylor_taylor, add_neg_cancel, taylor_zero]
  have hcf : TypeDensity.conjugateFactor O Φ 0 = X - C (TypeDensity.baseReduce O Φ θ) := by
    simp [TypeDensity.conjugateFactor, TypeDensity.rootBar, θ]
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · intro b hb
    change (TypeDensity.monicPolyO _).map _ = _
    change (TypeDensity.monicPolyO b).map _ = _ at hb
    rw [hT, map_taylor, hb, hcf, taylor_pow, sub_eq_add_neg, ← C_neg]
    simp [taylor_X, taylor_C]
  · intro b _ b' _ h
    have h1 : TypeDensity.monicPolyO b = TypeDensity.monicPolyO b' := by
      apply taylor_injective θ
      rw [← hT, ← hT, h]
    funext j
    rw [← (R b).2.2.1 j, ← (R b').2.2.1 j, h1]
  · intro c hc
    change (TypeDensity.monicPolyO c).map _ = _ at hc
    set F := taylor (-θ) (TypeDensity.monicPolyO c)
    obtain ⟨m1, d1, -, -⟩ := R c
    have hF := (R c).2.2.2 F (by rw [Monic, leadingCoeff_taylor]; exact m1)
      (by rw [natDegree_taylor, d1])
    have hF' : TypeDensity.monicPolyO (TypeDensity.coeffVec r F) = F := (R (TypeDensity.coeffVec r F)).2.2.2 F
      (by rw [Monic, leadingCoeff_taylor]; exact m1) (by rw [natDegree_taylor, d1])
    refine ⟨TypeDensity.coeffVec r F, ?_, ?_⟩
    · change (TypeDensity.monicPolyO _).map _ = _
      rw [hF', map_taylor, hc, hcf, taylor_pow, sub_eq_add_neg, ← C_neg]
      simp [taylor_X]
    · have := hT (TypeDensity.coeffVec r F)
      rw [hF', hinv'] at this
      funext j
      rw [← (R (TypeDensity.translateBlock O Φ r (TypeDensity.coeffVec r F))).2.2.1 j, this, (R c).2.2.1 j]
  · intro L b b'
    rw [key, key, hT, hT, ← map_sub]
    constructor
    · exact tmem _ θ _
    · intro h
      have := tmem _ (-θ) _ h
      rwa [hinv] at this
