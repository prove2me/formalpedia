theorem FunctorialResolution.Blowup.exists_local_lift_toSpec_of_isLocallyGeneratedByNonZeroDivisor {R : Type u} [CommRing R] (I : Ideal R)
    {W : Scheme.{u}} (g : W ⟶ Spec (CommRingCat.of R))
    (hcart : IsLocallyGeneratedByNonZeroDivisor ((specIdealSheaf I).comap g)) (w : ↥W) :
    ∃ (U : W.Opens) (_ : w ∈ U) (h : U.toScheme ⟶ affineBlowup I),
      h ≫ AffineBlowup.toSpec I = U.ι ≫ g := by sorry
