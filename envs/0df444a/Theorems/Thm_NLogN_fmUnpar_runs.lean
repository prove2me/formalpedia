variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.fmUnpar_runs (s : IState NS) (n k Q : ℕ) (LN LF LP L2 LH LE LQ : List Item)
    (hkn : k ≤ n) (hQ : Q ≤ n)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF)
    (hP : s.G PRM = .int n :: LP) (h2 : s.G W2 = .int (2 ^ (n - k)) :: L2)
    (hH : s.G HB = .int (2 ^ (n - 1)) :: LH) (hE : s.G NLogN.DE = .int (2 ^ (2 * Q)) :: LE)
    (hRQ : s.G RQ = .int (2 ^ Q) :: LQ) :
    IRuns I iprog fmUnpar s
      ((((((((s.upd RN LN).upd RF LF).upd PRM LP).upd W2 L2).upd HB LH).upd NLogN.DE LE).upd RQ LQ))
      (100 * (n + 3)) := by sorry
