-- Source module: NLogN.IEval
/-!
# A functional evaluator for item-language programs

`IOp.run` and `IStmt.run` compute the result state and cost of a program (with fuel for loops and
calls).  A successful evaluation gives an execution (`IStmt.run_exec`), so straight-line code can
be checked by `simp` evaluation instead of step-by-step reasoning.  Input and output operations
are not evaluated (`none`).
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

/-- The exponent of a ruler. -/
def rulerExp (r : ℤ) : Option ℕ :=
  if r = 2 ^ (Nat.log2 r.toNat) then some (Nat.log2 r.toNat) else none

def IOp.run (s : IState S) : IOp S → Option (IState S × ℕ)
  | .add i j k =>
    match s.G i, s.G j with
    | .int a :: Li, .int b :: Lj =>
      if i = j then none else
        some ((((s.upd i Li).upd j Lj).upd k (.int (a + b) :: ((s.upd i Li).upd j Lj).G k)),
          addIntCost (zsz a + zsz b))
    | _, _ => none
  | .neg i =>
    match s.G i with
    | .int a :: L => some (s.upd i (.int (-a) :: L), 20)
    | _ => none
  | .dup i j =>
    match s.G i with
    | .int a :: _ => if i = j then none else some (s.upd j (.int a :: s.G j), dupCost (zsz a) + 17)
    | _ => none
  | .drop i =>
    match s.G i with
    | .int a :: L => some (s.upd i L, 2 * zsz a + 2)
    | _ => none
  | .mv i j =>
    match s.G i with
    | .int a :: L =>
      if i = j then none else some ((s.upd i L).upd j (.int a :: s.G j), 2 * moveCost (zsz a) + 19)
    | _ => none
  | .const i c => some (s.upd i (.int c :: s.G i), zsz c + 2)
  | .mark i => some (s.upd i (.mark :: s.G i), 1)
  | .unmark i =>
    match s.G i with
    | .mark :: L => some (s.upd i L, 1)
    | _ => none
  | .shl i j =>
    match s.G i, s.G j with
    | .int a :: Li, .int r :: _ =>
      match rulerExp r with
      | some m => if i = j then none else some (s.upd i (.int (a * 2 ^ m) :: Li), shlCost m)
      | none => none
    | _, _ => none
  | .split i j k =>
    match s.G i, s.G j with
    | .int a :: Li, .int r :: _ =>
      match rulerExp r with
      | some m =>
        if i = j ∨ i = k ∨ j = k then none else
          some ((s.upd i (.int (sg a (a.natAbs / 2 ^ m)) :: Li)).upd k
            (.int (sg a (a.natAbs % 2 ^ m)) :: s.G k), splitCost m + 17)
      | none => none
    | _, _ => none
  | .cat i j k =>
    match s.G i, s.G j, s.G k with
    | .int a :: Li, .int r :: _, .int b :: Lk =>
      match rulerExp r with
      | some m =>
        if i = j ∨ i = k ∨ j = k ∨ a = 0 ∨ b < 0 ∨ 2 ^ m ≤ b then none else
          some ((s.upd i (.int (sg a (a.natAbs * 2 ^ m + b.toNat)) :: Li)).upd k Lk, catCost m)
      | none => none
    | _, _, _ => none
  | .read _ _ _ => none
  | .write _ _ => none

/-- Evaluation with fuel (each loop iteration and call uses one unit). -/
def IStmt.run (iprog : Fin P → IStmt S P) : ℕ → IStmt S P → IState S → Option (IState S × ℕ)
  | _, .skip, s => some (s, 1)
  | _, .op o, s => o.run s
  | n, .seq p q, s =>
    match IStmt.run iprog n p s with
    | some (s₁, c₁) =>
      match IStmt.run iprog n q s₁ with
      | some (s₂, c₂) => some (s₂, c₁ + c₂)
      | none => none
    | none => none
  | n, .ite i f p q, s =>
    if f (s.cl i) then (IStmt.run iprog n p s).map (fun r => (r.1, r.2 + 25))
    else (IStmt.run iprog n q s).map (fun r => (r.1, r.2 + 25))
  | 0, .loop _ _ _, _ => none
  | n + 1, .loop i f p, s =>
    if f (s.cl i) then
      match IStmt.run iprog (n + 1) p s with
      | some (s₁, c₁) =>
        match IStmt.run iprog n (.loop i f p) s₁ with
        | some (s₂, c₂) => some (s₂, c₁ + c₂ + 30)
        | none => none
      | none => none
    else some (s, 30)
  | 0, .call _, _ => none
  | n + 1, .call j, s => (IStmt.run iprog n (iprog j) s).map (fun r => (r.1, r.2 + 2))

end NLogN

end

section
-- Source module: NLogN.SSBase
/-!
# Schönhage–Strassen in the item language: stack layout and Fermat-ring arithmetic

The program uses `NS` item stacks with fixed roles, so that stack (in)equalities are decided by
`simp`.  The current ring `ℤ/(2^n+1)` is given by the ruler `2^n` on top of `RN` and the modulus
`2^n+1` on top of `RF`.
-/

namespace NLogN

open IntMul

abbrev NS : ℕ := 32

abbrev RN : Fin NS := 2
abbrev RF : Fin NS := 3
abbrev T1 : Fin NS := 4
abbrev T2 : Fin NS := 5
abbrev T3 : Fin NS := 6
abbrev T4 : Fin NS := 7

/-- `o` evaluates to the state `t` with cost at most `c`. -/
def runsTo {S : ℕ} (o : Option (IState S × ℕ)) (t : IState S) (c : ℕ) : Prop :=
  match o with
  | some r => r.1 = t ∧ r.2 ≤ c
  | none => False

@[simp] theorem cls_none' : cls none = .none := rfl
@[simp] theorem cls_mark' : cls (some .mark) = .mark := rfl

@[simp] theorem IState.cl_def {S : ℕ} (s : IState S) (i : Fin S) : s.cl i = cls (s.G i).head? := rfl

/-! ## Fermat reduction -/

variable {P : ℕ}

/-- Reduce the integer on top of `X` modulo `2^n+1` (needs `|z| < 2^(2n+1)`). -/
def fredA (X : Fin NS) : IStmt NS P :=
  .seq (.op (.split X RN T1)) (.seq (.op (.split X RN T2)) (.seq (.op (.neg T2))
    (.seq (.op (.add T1 T2 T1)) (.op (.add T1 X X)))))

def fadd (X : Fin NS) : IStmt NS P :=
  .ite X (fun c => c == .neg) (.seq (.op (.dup RF T1)) (.op (.add T1 X X))) .skip

def fsub (X : Fin NS) : IStmt NS P :=
  .seq (.op (.dup RF T1)) (.seq (.op (.neg T1)) (.seq (.op (.dup X T2)) (.seq (.op (.add T2 T1 T1))
    (.ite T1 (fun c => c != .neg) (.seq (.op (.drop X)) (.op (.mv T1 X))) (.op (.drop T1))))))

def fred (X : Fin NS) : IStmt NS P :=
  .seq (fredA X) (.seq (fadd X) (.seq (fadd X) (.seq (fsub X) (fsub X))))

end NLogN

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

end NLogN

end

section
-- Source module: NLogN.HExpr
/-!
# Expressions over register stacks

`Ex S` are integer expressions whose leaves read the top item of a register stack.  `Ex.code z e`
evaluates `e` onto the value stack `z.V`, using the scratch stacks of `z` and leaving every other
stack unchanged (`Ex.code_runs`).
-/

namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

/-- The integer on top of stack `i` (`0` if there is none). -/
def IState.top (s : IState S) (i : Fin S) : ℤ :=
  match s.G i with
  | .int a :: _ => a
  | _ => 0

/-- The top of stack `i` is an integer. -/
def IState.IsInt (s : IState S) (i : Fin S) : Prop := ∃ L, s.G i = .int (s.top i) :: L

/-- The scratch stacks used by expression code. -/
structure ExSt (S : ℕ) where
  V : Fin S
  A : Fin S
  B : Fin S
  C : Fin S
  D : Fin S
  E : Fin S
  F : Fin S
  G : Fin S

def ExSt.all (z : ExSt S) : List (Fin S) := [z.V, z.A, z.B, z.C, z.D, z.E, z.F, z.G]

inductive Ex (S : ℕ) where
  | reg (i : Fin S)
  | lit (c : ℤ)
  | add (a b : Ex S)
  | neg (a : Ex S)
  | mul (a b : Ex S)
  /-- `a * r` for a ruler `r = 2^m` -/
  | shl (a r : Ex S)
  /-- `a.tdiv r` for a ruler `r = 2^m` -/
  | quo (a r : Ex S)
  /-- `a.tmod r` for a ruler `r = 2^m` -/
  | rem (a r : Ex S)
  /-- `2^a` for `a ≥ 0` -/
  | pow2 (a : Ex S)
  /-- `if c < 0 then x else y` -/
  | sel (c x y : Ex S)
  /-- `a / b` for `a ≥ 0`, `b > 0` -/
  | ndiv (a b : Ex S)
  /-- `a % b` for `a ≥ 0`, `b > 0` -/
  | nmod (a b : Ex S)

namespace Ex

def regs : Ex S → List (Fin S)
  | reg i => [i]
  | lit _ => []
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => a.regs ++ b.regs
  | neg a | pow2 a => a.regs
  | sel c x y => c.regs ++ x.regs ++ y.regs

def eval (s : IState S) : Ex S → ℤ
  | reg i => s.top i
  | lit c => c
  | add a b => a.eval s + b.eval s
  | neg a => -a.eval s
  | mul a b => a.eval s * b.eval s
  | shl a r => a.eval s * r.eval s
  | quo a r => (a.eval s).tdiv (r.eval s)
  | rem a r => (a.eval s).tmod (r.eval s)
  | pow2 a => 2 ^ (a.eval s).toNat
  | sel c x y => if c.eval s < 0 then x.eval s else y.eval s
  | ndiv a b => a.eval s / b.eval s
  | nmod a b => a.eval s % b.eval s

/-- Side conditions: registers hold integers, rulers are powers of two, divisions are of
naturals by positive naturals. -/
def ok (s : IState S) : Ex S → Prop
  | reg i => s.IsInt i
  | lit _ => True
  | add a b | mul a b => a.ok s ∧ b.ok s
  | neg a => a.ok s
  | shl a r | quo a r | rem a r => a.ok s ∧ r.ok s ∧ ∃ m : ℕ, r.eval s = 2 ^ m
  | pow2 a => a.ok s ∧ 0 ≤ a.eval s
  | sel c x y => c.ok s ∧ (if c.eval s < 0 then x.ok s else y.ok s)
  | ndiv a b | nmod a b => a.ok s ∧ b.ok s ∧ 0 ≤ a.eval s ∧ 0 < b.eval s

end Ex

/-! ## Long division -/

/-- Cost bound of long division of `a ≥ 0` by `b > 0` with `zsz a, zsz b ≤ n`. -/
def ldivCost (n : ℕ) : ℕ := 1000000 * (n + 2) ^ 2

/-- Cost of `2^a` by repeated doubling. -/
def pow2Cost (a : ℕ) : ℕ := (a + 1) * (addIntCost (zsz (a : ℤ) + 1) + 300) + 300

namespace Ex

def cost (s : IState S) : Ex S → ℕ
  | reg i => dupCost (zsz (s.top i)) + 17
  | lit c => zsz c + 2
  | add a b => a.cost s + b.cost s + 2 * moveCost (zsz (b.eval s)) + 2 * moveCost (zsz (a.eval s)) +
      38 + addIntCost (zsz (b.eval s) + zsz (a.eval s))
  | neg a => a.cost s + 20
  | mul a b => a.cost s + b.cost s + smulCost (zsz (b.eval s) + zsz (a.eval s))
  | shl a r => a.cost s + r.cost s + 2 * moveCost (zsz (r.eval s)) + 19 +
      shlCost (zsz (r.eval s)) + 2 * zsz (r.eval s) + 2
  | quo a r | rem a r => a.cost s + r.cost s + 4 * moveCost (zsz (r.eval s)) +
      splitCost (zsz (r.eval s)) + 4 * zsz (a.eval s) + 4 * zsz (r.eval s) + 100 +
      2 * moveCost (zsz (a.eval s))
  | pow2 a => a.cost s + 2 * moveCost (zsz (a.eval s)) + pow2Cost (a.eval s).toNat +
      2 * zsz (a.eval s) + 100
  | sel c x y => c.cost s + 2 * moveCost (zsz (c.eval s)) + 19 + 25 + 2 * zsz (c.eval s) + 2 +
      (if c.eval s < 0 then x.cost s else y.cost s)
  | ndiv a b | nmod a b => a.cost s + b.cost s + 2 * ldivCost (zsz (a.eval s) + zsz (b.eval s))

end Ex

/-! ## Code -/

/-- `V : a :: L ↦ 2^a :: L` (for `a ≥ 0`), by doubling; uses `A, B, C`. -/
def pow2Code (z : ExSt S) : IStmt S P :=
  .seq (.op (.mv z.V z.C)) (.seq (.op (.const z.V 1)) (.seq (.op (.const z.A 2))
    (.seq (.loop z.C (fun c => c != .zero)
      (.seq (.op (.shl z.V z.A)) (.seq (.op (.const z.B (-1))) (.op (.add z.B z.C z.C)))))
      (.seq (.op (.drop z.A)) (.op (.drop z.C))))))

/-- `F := B - A`. -/
def ldFlag (z : ExSt S) : IStmt S P :=
  .seq (.op (.dup z.B z.F)) (.seq (.op (.dup z.A z.G)) (.seq (.op (.neg z.G))
    (.op (.add z.G z.F z.F))))

/-- Phase 1 body: `A := 2A`, `D := D + 1`. -/
def ldUp (z : ExSt S) : IStmt S P :=
  .seq (.op (.drop z.F)) (.seq (.op (.shl z.A z.E)) (.seq (.op (.const z.G 1))
    (.seq (.op (.add z.G z.D z.D)) (ldFlag z))))

/-- Phase 2 body: `A := A/2`, `C := 2C`, and if `B ≥ A` then `B := B - A`, `C := C + 1`;
`D := D - 1`. -/
def ldDown (z : ExSt S) : IStmt S P :=
  .seq (.op (.split z.A z.E z.G)) (.seq (.op (.drop z.G)) (.seq (.op (.shl z.C z.E))
    (.seq (ldFlag z) (.seq (.ite z.F (fun c => c == .neg) (.op (.drop z.F))
      (.seq (.op (.drop z.B)) (.seq (.op (.mv z.F z.B)) (.seq (.op (.const z.G 1))
        (.op (.add z.G z.C z.C))))))
      (.seq (.op (.const z.G (-1))) (.op (.add z.G z.D z.D)))))))

/-- `V : b :: a :: L ↦ (a / b) :: L` and `G : R ↦ (a % b) :: R`, for `a ≥ 0`, `b > 0`. -/
def ldivCode (z : ExSt S) : IStmt S P :=
  .seq (.seq (.op (.mv z.V z.A)) (.seq (.op (.mv z.V z.B)) (.seq (.op (.const z.C 0))
    (.seq (.op (.const z.D 0)) (.seq (.op (.const z.E 2)) (ldFlag z))))))
    (.seq (.loop z.F (fun c => c != .neg) (ldUp z))
      (.seq (.op (.drop z.F))
        (.seq (.loop z.D (fun c => c != .zero) (ldDown z))
          (.seq (.op (.drop z.E)) (.seq (.op (.drop z.D)) (.seq (.op (.drop z.A))
            (.seq (.op (.mv z.C z.V)) (.op (.mv z.B z.G)))))))))

namespace Ex

def code (z : ExSt S) : Ex S → IStmt S P
  | reg i => .op (.dup i z.V)
  | lit c => .op (.const z.V c)
  | add a b => .seq (a.code z) (.seq (b.code z) (.seq (.op (.mv z.V z.A))
      (.seq (.op (.mv z.V z.B)) (.op (.add z.A z.B z.V)))))
  | neg a => .seq (a.code z) (.op (.neg z.V))
  | mul a b => .seq (a.code z) (.seq (b.code z) (smul z.V z.A z.B z.C z.D z.E z.F))
  | shl a r => .seq (a.code z) (.seq (r.code z) (.seq (.op (.mv z.V z.A))
      (.seq (.op (.shl z.V z.A)) (.op (.drop z.A)))))
  | quo a r => .seq (a.code z) (.seq (r.code z) (.seq (.op (.mv z.V z.A))
      (.seq (.op (.split z.V z.A z.B)) (.seq (.op (.drop z.B)) (.op (.drop z.A))))))
  | rem a r => .seq (a.code z) (.seq (r.code z) (.seq (.op (.mv z.V z.A))
      (.seq (.op (.split z.V z.A z.B)) (.seq (.op (.drop z.V)) (.seq (.op (.mv z.B z.V))
        (.op (.drop z.A)))))))
  | pow2 a => .seq (a.code z) (pow2Code z)
  | sel c x y => .seq (c.code z) (.seq (.op (.mv z.V z.A))
      (.ite z.A (fun k => k == .neg) (.seq (.op (.drop z.A)) (x.code z))
        (.seq (.op (.drop z.A)) (y.code z))))
  | ndiv a b => .seq (a.code z) (.seq (b.code z) (.seq (ldivCode z) (.op (.drop z.G))))
  | nmod a b => .seq (a.code z) (.seq (b.code z) (.seq (ldivCode z)
      (.seq (.op (.drop z.V)) (.op (.mv z.G z.V)))))

end Ex

end NLogN

end

