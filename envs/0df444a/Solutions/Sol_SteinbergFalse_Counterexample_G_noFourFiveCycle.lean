theorem tbl_len : TBL.length = 166 := by decide +kernel
theorem tbl_ok : allOK 0 TBL = true := by decide +kernel

abbrev R (c : Fin 166) : List (ℕ × List ℕ) := TBL.getD c.val []

theorem row_ok (c : Fin 166) : rowOK c.val (R c) = true := by
  have := allOK_get 0 TBL tbl_ok c.val (by rw [tbl_len]; exact c.isLt)
  simpa using this

theorem F1 (c d : Fin 166) (h : G.Adj c d) : ∃ L, (d.val, L) ∈ R c := by
  have hr := row_ok c
  simp only [rowOK, Bool.and_eq_true] at hr
  have h1 : orF ((R c).map Prod.fst) = msk c.val := beqT hr.1.1.1
  have h2 : (orF ((R c).map Prod.fst)).testBit d.val = true := by rw [h1]; exact adj_msk h
  obtain ⟨q, hq, hqd⟩ := List.mem_map.1 (orF_mem h2)
  exact ⟨q.2, by rw [← hqd]; exact hq⟩

theorem F2 (c d e : Fin 166) (L : List ℕ) (hm : (d.val, L) ∈ R c) (h : G.Adj d e) : e.val ∈ L := by
  have hr := row_ok c
  simp only [rowOK, Bool.and_eq_true] at hr
  have h1 : orF L = msk d.val := beqT (List.all_eq_true.1 hr.1.1.2 _ hm)
  exact orF_mem (by rw [h1]; exact adj_msk h)

theorem F3 (c : Fin 166) {d1 d2 : ℕ} {L1 L2 : List ℕ} (m1 : (d1, L1) ∈ R c) (m2 : (d2, L2) ∈ R c)
    (hne : d1 ≠ d2) {x : ℕ} (h1 : (msk d1).testBit x = true) (h2 : (msk d2).testBit x = true) :
    x = c.val := by
  have hr := row_ok c
  simp only [rowOK, Bool.and_eq_true] at hr
  have h := List.all_eq_true.1 (List.all_eq_true.1 hr.1.2 _ m1) _ m2
  simp only [Bool.or_eq_true] at h
  rcases h with h | h
  · exact absurd (beqT h) hne
  · exact sub1_sound h (by simp only [Nat.testBit_land, h1, h2, Bool.and_self])

theorem F4 (c : Fin 166) {d b : ℕ} {Ld Lb : List ℕ} (hcd : c.val < d) (md : (d, Ld) ∈ R c)
    (mb : (b, Lb) ∈ R c) (hbd : b ≠ d) {e : ℕ} (he : e ∈ Ld) (hec : e ≠ c.val) (heb : e ≠ b)
    {x : ℕ} (h1 : (msk b).testBit x = true) (h2 : (msk e).testBit x = true) :
    x = c.val ∨ x = d := by
  have hr := row_ok c
  simp only [rowOK, Bool.and_eq_true] at hr
  have h := List.all_eq_true.1 hr.2 _ md
  simp only [Bool.or_eq_true] at h
  rcases h with h | h
  · have hb : Nat.blt c.val d = true := by simpa only [Nat.blt_eq] using hcd
    rw [hb] at h
    exact absurd h (by decide)
  have h' := List.all_eq_true.1 h _ mb
  simp only [Bool.or_eq_true] at h'
  rcases h' with h' | h'
  · exact absurd (beqT h') hbd
  have h'' := List.all_eq_true.1 h' e he
  simp only [Bool.or_eq_true] at h''
  rcases h'' with (h'' | h'') | h''
  · exact absurd (beqT h'') hec
  · exact absurd (beqT h'') heb
  · exact sub2_sound h'' (by simp only [Nat.testBit_land, h1, h2, Bool.and_self])

theorem no4 (a b c d : Fin 166) (hab : G.Adj a b) (hbc : G.Adj b c) (hcd : G.Adj c d)
    (hda : G.Adj d a) (hac : a ≠ c) (hbd : b ≠ d) : False := by
  obtain ⟨La, ma⟩ := F1 b a hab.symm
  obtain ⟨Lc, mc⟩ := F1 b c hbc
  have := F3 b ma mc (fun h => hac (Fin.ext h)) (adj_msk hda.symm) (adj_msk hcd)
  exact hbd (Fin.ext this).symm

theorem no5' (x0 x1 x2 x3 x4 : Fin 166) (h01 : G.Adj x0 x1) (h12 : G.Adj x1 x2)
    (h23 : G.Adj x2 x3) (h34 : G.Adj x3 x4) (h40 : G.Adj x4 x0) (n13 : x1 ≠ x3) (n24 : x2 ≠ x4)
    (n14 : x1 ≠ x4) (n02 : x0 ≠ x2) (n03 : x0 ≠ x3) (hlt : x2.val < x3.val) : False := by
  obtain ⟨L3, m3⟩ := F1 x2 x3 h23
  obtain ⟨L1, m1⟩ := F1 x2 x1 h12.symm
  have he := F2 x2 x3 x4 L3 m3 h34
  rcases F4 x2 hlt m3 m1 (fun h => n13 (Fin.ext h)) he (fun h => n24 (Fin.ext h).symm)
      (fun h => n14 (Fin.ext h).symm) (adj_msk h01.symm) (adj_msk h40) with h | h
  · exact n02 (Fin.ext h)
  · exact n03 (Fin.ext h)

theorem no5 (x0 x1 x2 x3 x4 : Fin 166) (h01 : G.Adj x0 x1) (h12 : G.Adj x1 x2)
    (h23 : G.Adj x2 x3) (h34 : G.Adj x3 x4) (h40 : G.Adj x4 x0) (n13 : x1 ≠ x3) (n24 : x2 ≠ x4)
    (n14 : x1 ≠ x4) (n02 : x0 ≠ x2) (n03 : x0 ≠ x3) : False := by
  rcases Nat.lt_or_gt_of_ne (fun h => G.ne_of_adj h23 (Fin.ext h)) with hlt | hlt
  · exact no5' x0 x1 x2 x3 x4 h01 h12 h23 h34 h40 n13 n24 n14 n02 n03 hlt
  · exact no5' x0 x4 x3 x2 x1 h40.symm h34.symm h23.symm h12.symm h01.symm n24.symm n13.symm
      n14.symm n03 n02 hlt

theorem cyc {v : Fin 166} (p : G.Walk v v) (hp : p.IsCycle) : p.length ≠ 4 ∧ p.length ≠ 5 := by
  have A : ∀ i, i < p.length → G.Adj (p.getVert i) (p.getVert (i + 1)) :=
    fun i hi => p.adj_getVert_succ hi
  have D : ∀ i j, 1 ≤ i → i ≤ p.length → 1 ≤ j → j ≤ p.length → i ≠ j →
      p.getVert i ≠ p.getVert j :=
    fun i j h1 h2 h3 h4 hne heq => hne (hp.getVert_injOn (show 1 ≤ i ∧ i ≤ p.length from ⟨h1, h2⟩)
      (show 1 ≤ j ∧ j ≤ p.length from ⟨h3, h4⟩) heq)
  have e0 : p.getVert 0 = p.getVert p.length := by rw [p.getVert_zero, p.getVert_length]
  refine ⟨fun h4 => ?_, fun h5 => ?_⟩
  · rw [h4] at e0
    refine no4 (p.getVert 4) (p.getVert 1) (p.getVert 2) (p.getVert 3) ?_ (A 1 (by omega))
      (A 2 (by omega)) (A 3 (by omega)) (D 4 2 (by omega) (by omega) (by omega) (by omega) (by omega))
      (D 1 3 (by omega) (by omega) (by omega) (by omega) (by omega))
    rw [← e0]; exact A 0 (by omega)
  · rw [h5] at e0
    refine no5 (p.getVert 5) (p.getVert 1) (p.getVert 2) (p.getVert 3) (p.getVert 4) ?_
      (A 1 (by omega)) (A 2 (by omega)) (A 3 (by omega)) (A 4 (by omega))
      (D 1 3 (by omega) (by omega) (by omega) (by omega) (by omega))
      (D 2 4 (by omega) (by omega) (by omega) (by omega) (by omega))
      (D 1 4 (by omega) (by omega) (by omega) (by omega) (by omega))
      (D 5 2 (by omega) (by omega) (by omega) (by omega) (by omega))
      (D 5 3 (by omega) (by omega) (by omega) (by omega) (by omega))
    rw [← e0]; exact A 0 (by omega)

end SteinbergAux

open SteinbergFalse.Counterexample in
theorem solution : NoFourFiveCycle G := by
  intro v p hp
  exact SteinbergAux.cyc p hp
