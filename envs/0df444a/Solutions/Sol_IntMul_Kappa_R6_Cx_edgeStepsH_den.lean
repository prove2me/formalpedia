section Edge

open NetComplexP8 NetComplexLabels

variable {h : ℕ} {R : Type} [Fintype R] [DecidableEq R]

theorem kerSpecH_of_edgeP {V U : Submodule (ZMod 2) (Vc h)} (hE : EdgeP V U) :
    ∃ L, KerSpecH V U L := by
  obtain ⟨-, B, hB, -, hcard, L, hLB, hpm, hPhi⟩ := hE
  refine ⟨L, ⟨fun p hp => ⟨hpm p hp, ?_⟩, ?_, hPhi⟩, B, hB, hLB⟩
  · have : p.2 ∈ B.toList := hLB ▸ List.mem_map_of_mem hp
    exact ne_zero_of_dot (hB.1 _ (Finset.mem_toList.1 this))
  · rw [← List.length_map (f := Prod.snd), hLB, Finset.length_toList, hcard]

lemma kersH_spec {V U : Submodule (ZMod 2) (Vc h)} (hE : EdgeP V U) : KerSpecH V U (kersH V U) := by
  have hh := kerSpecH_of_edgeP hE
  unfold kersH
  rw [dif_pos hh]
  exact Classical.choose_spec hh

/-- **Merged edge** (same denotation as `P8Lift.edgeSteps_den`). -/
theorem edgeStepsH_den_sol_aux (w : R) {V U : Submodule (ZMod 2) (Vc h)} (hE : EdgeP V U) :
    denListH (chEx (κ := κ)) (edgeStepsH w V U) = wireOp w (PhiK (qL V - qL U)) := by
  obtain ⟨hs, B, hB, hLB⟩ := kersH_spec hE
  rw [edgeStepsH, mergedChunk_den w _ (fun p hp => (hs.1 p hp).1)
    (lin_indep_of_orthonormal _ B hB hLB), PhiK, PhiMat_kernels _ _ hs.2.2]

end Edge

