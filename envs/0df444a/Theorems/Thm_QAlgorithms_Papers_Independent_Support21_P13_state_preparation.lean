-- title:
--   Exact preparation of every normalized ring-valued qubit state
-- statement:
--   Let $\psi\in\mathbb C^2$ have unit norm and both entries in $R=\mathbb Z[1/\sqrt2,i]$. With $|0\rangle=(1,0)^t$ and $H,T$ as in Theorem 1,
--
--   $$
--   \exists c\in\{H,T\}^{*}:\ M(c)|0\rangle=\psi.
--   $$
--
--   The vector equality is exact and includes its phase. This is the first-column preparation interface for exact unitary synthesis.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 4, Lemma 1: exact state preparation

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Lemma 1, PDF p.4; proof pp.6-7. Every state is normalized and preparation
from |0> is exact vector equality, including allowed basis-state phases. -/
theorem state_preparation (psi : EuclideanSpace ℂ Bool)
    (hstate : QAlgorithms.IsState psi) (hring : ∀ b, psi b ∈ synthesisRing) :
    ∃ c : List HTLetter, QAlgorithms.act (htWordMatrix c) (QAlgorithms.ket false) = psi := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
