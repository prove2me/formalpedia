-- title:
--   Proposition 8: if $\mathcal S \neq \emptyset$ the IFB iterates are bounded and $F_k(q)$ converges
-- statement:
--   Let $H$ be a real Hilbert space, let Hypothesis H hold, assume $\mathcal S = \operatorname{Argmin}\Theta \ne \emptyset$, and let $(u_k, y_k)$ be generated by (IFB). Then:
--
--   1. $(u_k)$ is bounded: there is $R$ with $\|u_k\| \le R$ for all $k$;
--   2. for each $q \in \mathcal S$ the limit $\lim_{k\to\infty} F_k(q)$ exists in $\mathbb R$.
--
--   These two facts, with Proposition 6, reduce weak convergence of $(u_k)$ to showing that it has at most one weak cluster point.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 10, Proposition 8

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_InertialFB_IFB_Algorithm
import Definitions.Def_InertialFB_IFB_Lyapunov

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- **Proposition 8** (Attouch–Peypouquet–Redont, p. 10). Under Hypothesis H and `S ≠ ∅`, every
sequence `(u_k)` generated by (IFB) is bounded, and `lim F_k(q)` exists for each `q ∈ S`. -/
theorem proposition8_bounded (Φ : H → EReal) (Ψ : H → ℝ) (L a b lam : ℝ)
    (hH : HypothesisH Φ Ψ L a b lam) (u y : ℕ → H) (hIFB : IsIFBSeq Φ Ψ a b lam u y)
    (hS : (argminSet Φ Ψ).Nonempty) :
    (∃ R : ℝ, ∀ k : ℕ, ‖u k‖ ≤ R) ∧
    ∀ q ∈ argminSet Φ Ψ, ∃ ℓ : ℝ, Tendsto (fun k => auxF a b lam u y k q) atTop (𝓝 ℓ) := by sorry

end InertialFB.IFB
