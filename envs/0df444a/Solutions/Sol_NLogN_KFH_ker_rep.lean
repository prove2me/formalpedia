      (Butterfly.selOp (Butterfly.layerSel P K D S ρ hρ) (Butterfly.tensF (Butterfly.kerAt i A)) xs) := by
  set T := NLogN.KFH.stT K D S ρ i with hTdef
  set G := NLogN.KFH.grpG P K ρ i
  have hG : G * (2 * T) = AModel.vol (Butterfly.layerShape P K D S) := NLogN.KFH.grpG_mul hρ i i.isLt
