-- title:
--   Theorem 4.1 setting — Assumptions 1–2, NAPP-AL, and step rule (8)
-- statement:
--   The standing hypotheses of Theorem 4.1 require problem (P) to satisfy Assumptions 1 and 2, a sequence $(u^k,v^k,p^k)$ generated by NAPP-AL (5)–(7), and the step bound $\delta_k$ set by (8). The shared definitions supply the problem, the algorithm, and its constants. This item bundles those conditions for the two results of this mission.
--
--   In particular, with $q^k=p^k+\gamma(\Theta(u^k)+Bv^k)$ and $L_\Omega=\sum_j L_{\Omega_j}$, the step rule is
--   $$\delta_k=\frac{\beta}{L_G+\|q^k\|L_\Omega+\gamma(L^0_\Theta)^2+\frac{14\gamma\|B\|^2(L^0_\Theta)^2}{\lambda_{\min}(B^\top B)}+\frac{14(L_G+\gamma\|B\|L^0_\Theta)^2}{\gamma\lambda_{\min}(B^\top B)}+1}.\tag{8}$$
--
--   **Formalization Note** `RunHyp` is the conjunction of the two standing assumptions, the NAPP-AL relation, and (8). The local file imports the previously shared definitions of these objects.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, pp. 8–9, 16: NAPP-AL (5)–(7), Assumption 2, (8), Theorem 4.1 standing hypotheses

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NAPPAL_KL_Setting
import Definitions.Def_NAPPAL_Rate_Setting

open Filter Topology
open scoped InnerProductSpace

namespace NAPPAL.Subreg

open NAPPAL.Rate (qseq)
open NAPPAL.KL (wseq)

variable {n d m : ℕ}

/-- The standing setting of Lemma 4.3 and Theorem 4.1: Assumptions 1 and 2 hold, `δ_k` is set as
in (8), and `{w^k}` is generated by NAPP-AL. -/
def RunHyp (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ) (LK : ℝ) (K : NAPPAL.KL.E n → ℝ)
    (β γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m) : Prop :=
  NAPPAL.KL.Assumption1 P LG LH L0 LOmj ∧ NAPPAL.KL.Assumption2 P K β LK γ LG LH ∧
  NAPPAL.KL.IsNAPPAL P K γ σ δ ε u v p ∧
  ∀ k : ℕ, δ k = NAPPAL.KL.delta8 P LG L0 (NAPPAL.KL.LOm LOmj) β γ (qseq P γ u v p k)

end NAPPAL.Subreg


