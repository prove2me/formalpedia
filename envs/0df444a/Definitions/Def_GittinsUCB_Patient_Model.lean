-- title:
--   Gaussian arm, posterior recursion, stopping-time value and fair-tax Gittins index
-- statement:
--   Let an unknown arm quality $\theta$ have prior law $N(\mu,\sigma^2)$ and let its rewards be $R_t=\theta+W_t$, with independent $W_t\sim N(0,\sigma_W^2)$. The posterior parameters $\mu_t,\sigma_t^2$ are given by the Gaussian recursion in equation (1), with corrected closed variance form $\sigma_t^2=(1/\sigma^2+t/\sigma_W^2)^{-1}$. A player paying tax $\lambda$ may retire at a reward-adapted time $\tau\ge1$. Define
--
--   $$
--   V^\lambda_\gamma(\mu,\sigma^2;\sigma_W^2)=\sup_\tau\mathbb E\!\left[\sum_{t=0}^{\tau}\gamma^t(\theta-\lambda)\right],\qquad
--   \lambda_\gamma(\mu,\sigma^2;\sigma_W^2)=\sup\{\lambda:V^\lambda_\gamma\ge0\}.
--   $$
--
--   The file also defines the standard normal density $\phi$, distribution function $\Phi$, generalized quantile $\Phi^{-1}$, and the exploration length $L_\gamma$ and auxiliary term $h(\gamma)$ of page 6. These objects make the index and the paper's intermediate estimates available to other formalizations.
--
--   **Formalization Note** The probability space stores $\theta$ and independent observation noises. Retirement times take values in $\mathbb N_\infty$, so never retiring is allowed; their decisions use only the filtration generated by rewards. The printed $\tau\ge1$ and sum through $\tau$ are retained. Variances at the Gaussian interface are nonnegative real numbers. The closed variance form in (1) uses $t/\sigma_W^2$ rather than the printed $1/(t\sigma_W^2)$.
-- source:
--   Russo, A Note on the Equivalence of Upper Confidence Bounds and Gittins Indices for Patient Agents, arXiv:1904.04732v1, p. 2, §2, equations (1)–(3); pp. 3 and 6, Φ, φ, Lγ and h(γ)

import Mathlib
open MeasureTheory ProbabilityTheory NNReal

namespace GittinsUCB.Patient

/-- A quality and an infinite sequence of independent observation noises. -/
abbrev Ω := ℝ × (ℕ → ℝ)

/-- Independent Gaussian prior and observation noise. -/
noncomputable def model (μ : ℝ) (σ2 σW2 : ℝ≥0) : Measure Ω :=
  (gaussianReal μ σ2).prod (Measure.infinitePi fun _ : ℕ => gaussianReal 0 σW2)

/-- The arm's latent quality. -/
def θ (ω : Ω) : ℝ := ω.1

/-- The reward observed at time `t`. -/
def R (t : ℕ) (ω : Ω) : ℝ := ω.1 + ω.2 t

/-- Information revealed through rewards `R₀, …, Rₜ`. -/
def rewardSigma (t : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (s : Fin (t + 1)) => R s ω) inferInstance

/-- Retirement is based on rewards observed so far and follows at least two plays. -/
def IsRetirementTime (τ : Ω → ℕ∞) : Prop :=
  (∀ t : ℕ, MeasurableSet[rewardSigma t] {ω | τ ω ≤ (t : ℕ∞)}) ∧
    ∀ ω, 1 ≤ τ ω

/-- Discounted reward through the last play at time `τ`, including that play. -/
noncomputable def stoppedReward (γ lam : ℝ) (X : ℕ → Ω → ℝ)
    (τ : Ω → ℕ∞) (ω : Ω) : ℝ :=
  ∑' t : ℕ, if (t : ℕ∞) ≤ τ ω then γ ^ t * (X t ω - lam) else 0

/-- The value of a Gaussian arm with tax `lam`, with retirement based only on rewards. -/
noncomputable def value (σW2 : ℝ≥0) (γ lam μ : ℝ) (σ2 : ℝ≥0) : ℝ :=
  ⨆ τ : {τ : Ω → ℕ∞ // IsRetirementTime τ},
    ∫ ω, stoppedReward γ lam (fun _ => θ) τ.1 ω ∂(model μ σ2 σW2)

/-- The largest tax for which participating has nonnegative value. -/
noncomputable def gittinsIndex (σW2 : ℝ≥0) (γ μ : ℝ) (σ2 : ℝ≥0) : ℝ :=
  sSup {lam : ℝ | 0 ≤ value σW2 γ lam μ σ2}

/-- Corrected closed form of posterior variance in (1). -/
noncomputable def postVar (σ2 σW2 : ℝ) (t : ℕ) : ℝ :=
  (1 / σ2 + (t : ℝ) / σW2)⁻¹

/-- The posterior mean after `t` observations, by recursion (1). -/
noncomputable def postMean (μ σ2 σW2 : ℝ) : ℕ → Ω → ℝ
  | 0, _ => μ
  | t + 1, ω =>
      (postMean μ σ2 σW2 t ω / postVar σ2 σW2 t + R t ω / σW2) /
        (1 / postVar σ2 σW2 t + 1 / σW2)

/-- Standard Gaussian density `φ`. -/
noncomputable def stdPdf (z : ℝ) : ℝ :=
  Real.exp (-(z ^ 2) / 2) / Real.sqrt (2 * Real.pi)

/-- Standard Gaussian cumulative distribution function `Φ`. -/
noncomputable def stdCdf (z : ℝ) : ℝ := cdf (gaussianReal 0 1) z

/-- The generalized inverse `Φ⁻¹`. -/
noncomputable def stdQuantile (γ : ℝ) : ℝ :=
  sInf {z : ℝ | γ ≤ stdCdf z}

/-- The exploration length `L_γ` on page 6. -/
noncomputable def explorationLength (σW2 γ : ℝ) : ℕ :=
  ⌈σW2 * Real.log (1 / (1 - γ)) ^ 2⌉₊

/-- The auxiliary term `h(γ)` on page 6, for unit prior variance. -/
noncomputable def hAux (σW2 γ : ℝ) : ℝ :=
  -Real.log (explorationLength σW2 γ : ℝ) +
    (explorationLength σW2 γ : ℝ) * Real.log γ +
    2 * Real.log (1 - postVar 1 σW2 (explorationLength σW2 γ)) +
    Real.log (Real.sqrt (2 * Real.pi))

end GittinsUCB.Patient


