theorem list_eq_range (xs : List ℤ) : xs = (List.range xs.length).map fun j => xs.getD j 0 := by
  apply List.ext_getElem (by simp)
  intro j h1 h2
  simp [List.getElem?_eq_getElem h1]

theorem outF_recOf' {xs : List ℤ} {P q M B : ℕ} (h : xs.length = P * M * q * B) :
    outF (recOf' xs q M B) P q M = xs := by
  conv_rhs => rw [list_eq_range xs, h, map_range4]
  rfl

theorem inp_recOf' (xs : List ℤ) (P q M B : ℕ) :
    inp (recOf' xs q M B) P q M = AModel.pull [P, M, q, B] [P, q, M, B] gS 0 xs := by
