theorem forall_foldr (P : ℕ → Prop) (c : ℕ) : ∀ (l : List ℕ), (∀ x ∈ l, P x) → P c →
    ∀ x ∈ l.foldr (fun a s => insert a s) ({c} : Finset ℕ), P x := by
  intro l
  induction l with
  | nil =>
    intro _ hc x hx
    rw [List.foldr_nil, Finset.mem_singleton] at hx
    exact hx ▸ hc
  | cons a l ih =>
    intro hl hc x hx
    rw [List.foldr_cons, Finset.mem_insert] at hx
    rcases hx with rfl | hx
    · exact hl _ List.mem_cons_self
    · exact ih (fun y hy => hl y (List.mem_cons_of_mem _ hy)) hc x hx

