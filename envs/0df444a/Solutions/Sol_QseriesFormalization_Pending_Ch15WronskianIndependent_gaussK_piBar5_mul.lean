theorem wronskianRSWeight_rot3_of_not_selector {a b : ℤ}
    (h : (3 * a - b) % 5 ≠ 2) :
    wronskianRSWeight (a + b) (-(a - b)) = 0 := by
  apply wronskianRSWeight_of_not_selector
  have hx : ((a + b) - 2 * (-(a - b))) % 5 = (3 * a - b) % 5 := by omega
  rw [hx]
  exact h

