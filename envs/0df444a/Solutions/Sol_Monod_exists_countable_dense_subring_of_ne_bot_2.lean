open Filter Topology Set Polynomial

theorem exists_countable_dense_subring_of_ne_bot' {A : Subring ℝ} (hA : A ≠ ⊥) :
    ∃ A' : Subring ℝ, A' ≤ A ∧ Countable A' ∧ Dense (A' : Set ℝ) := by
  obtain ⟨x, hxA, hxb⟩ : ∃ x ∈ A, x ∉ (⊥ : Subring ℝ) := by
    by_contra h
    push_neg at h
    exact hA (le_antisymm h bot_le)
  let φ : ℤ[X] →+* ℝ := eval₂RingHom (Int.castRingHom ℝ) x
  refine ⟨φ.range, ?_, ?_, ?_⟩
  · rintro _ ⟨p, rfl⟩
    induction p using Polynomial.induction_on with
    | C a => simp [φ, intCast_mem]
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n a _ =>
      simp only [φ, coe_eval₂RingHom, eval₂_mul, eval₂_X_pow]
      rw [eval₂_C, eq_intCast]
      exact mul_mem (intCast_mem _ _) (pow_mem hxA _)
  · have hc : Countable ℤ[X] := by
      have hinj : Function.Injective (fun p : ℤ[X] => p.toFinsupp.coeff) := by
        intro p q h
        apply Polynomial.toFinsupp_injective
        cases hp : p.toFinsupp
        cases hq : q.toFinsupp
        simp only [hp, hq] at h
        rw [h]
      exact hinj.countable
    have : Countable (Set.range φ) := Set.countable_range φ |>.to_subtype
    exact this
  · -- fractional part and its powers
    set y := x - ⌊x⌋ with hy
    have hyA : y ∈ φ.range := ⟨X - C ⌊x⌋, by
      show eval₂ (Int.castRingHom ℝ) x (X - C ⌊x⌋) = y
      rw [eval₂_sub, eval₂_X, eval₂_C, eq_intCast]⟩
    have hy0 : 0 < y := by
      rw [hy, sub_pos]
      refine lt_of_le_of_ne (Int.floor_le x) ?_
      intro h; apply hxb; rw [Subring.mem_bot]; exact ⟨_, h⟩
    have hy1 : y < 1 := by rw [hy]; linarith [Int.lt_floor_add_one x]
    have hdense := (φ.range.toAddSubgroup).dense_of_not_isolated_zero (fun ε hε => by
      have ht := tendsto_pow_atTop_nhds_zero_of_lt_one hy0.le hy1
      obtain ⟨k, hk⟩ := (ht.eventually (gt_mem_nhds hε)).exists
      exact ⟨y ^ k, pow_mem hyA k, pow_pos hy0 k, hk⟩)
    exact hdense

end Monod.Dev.Dyn
