    (by simp only [Geo.S0, Geo.S1]; ring) hv n

theorem gc0_sc1 (v n : ℕ) (hv : v < g.Q) : gc g.Q g.S0 (NLogN.KFL.sc g.Q g.S1 v n) = gc g.Q g.S0 n :=
  gc_sc_hi hg.s1 hg.n1 rfl hv n

