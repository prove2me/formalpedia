theorem Formalism.IndefR.Fin.Four.term_support_finite {Φ : W → ℂ} (h : IsSB L X Φ) :
    (Function.support fun q : QX L X × QY L Y =>
      if q.2.out ∈ Y then term ρ χ L X f₀ Φ q.1.out q.2.out else 0).Finite := by sorry
