theorem AlgEquiv.mod_four_eq_three_of_apply_eq_pow_of_pow_four
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (h3 : ∀ ζ : AlgebraicClosure ℚ, ζ ^ 4 = 1 → σ ζ = ζ ^ 3)
    (k : ℕ) (hk : 2 ≤ k) (m : ℕ) (hm : ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ k) = 1 → σ ζ = ζ ^ m) :
    m % 4 = 3 := by

  obtain ⟨i, hi⟩ : ∃ i : AlgebraicClosure ℚ, i ^ 2 = -1 := IsAlgClosed.exists_pow_nat_eq (-1) (by norm_num)
  have hi0 : i ≠ 0 := by rintro rfl; norm_num at hi
  have hi4 : i ^ 4 = 1 := by rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, hi]; norm_num
  have hne : (-1 : AlgebraicClosure ℚ) ≠ 1 := by norm_num
  have hprim : IsPrimitiveRoot i 4 := by
    refine IsPrimitiveRoot.mk_of_lt i (by norm_num) hi4 fun l hl1 hl4 => ?_
    interval_cases l
    · rw [pow_one]; intro h; rw [h, one_pow] at hi; exact hne hi.symm
    · rw [hi]; exact hne
    · rw [show (3 : ℕ) = 2 + 1 by norm_num, pow_add, hi, pow_one]
      intro h
      have h2 : i ^ 2 = 1 := by
        have : i = -1 := by
          calc i = -(-1 * i) := by ring
            _ = -1 := by rw [h]
        rw [this]; norm_num
      rw [hi] at h2; exact hne h2
  have hik : i ^ (2 ^ k) = 1 := by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
    rw [pow_add, pow_mul, show (2 : ℕ) ^ 2 = 4 by norm_num, hi4, one_pow]
  have h := (hm i hik).symm.trans (h3 i hi4)

  have key : ∀ a b : ℕ, a ≤ b → i ^ a = i ^ b → 4 ∣ b - a := by
    intro a b hab hab'
    obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hab
    rw [Nat.add_sub_cancel_left, ← hprim.pow_eq_one_iff_dvd]
    rw [pow_add] at hab'
    exact mul_left_cancel₀ (pow_ne_zero a hi0) (hab'.symm.trans (mul_one _).symm)
  rcases le_total m 3 with hle | hle
  · have := key m 3 hle h; omega
  · have := key 3 m hle h.symm; omega

