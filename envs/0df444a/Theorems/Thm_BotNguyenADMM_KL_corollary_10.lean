-- title:
--   Corollary 10 — |||D^{k+1}||| bounded by three x-increments and two telescoping A*-differences
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. Then the element $D^{k+1}\in\partial F_r(x^{k+1},z^{k+1},y^{k+1},x^k,y^k)$ of Lemma 9 satisfies, for every $k\ge2$,
--   $$\begin{aligned}|||D^{k+1}|||&\le C_{11}\big(\|x^{k+1}-x^k\|+\|x^k-x^{k-1}\|+\|x^{k-1}-x^{k-2}\|\big)\\&\quad+C_{12}\big(\|A^*(y^k-y^{k-1})\|-\|A^*(y^{k+1}-y^k)\|\big)+C_{13}\big(\|A^*(y^{k-1}-y^{k-2})\|-\|A^*(y^k-y^{k-1})\|\big),\end{aligned}$$
--   where $C_{11}=\max\{C_8+C_9\|A\|+C_3C_{10}+\frac{C_3C_9}{\rho r},\ C_4C_{10}+\frac{C_3C_9}{\rho r},\ \frac{C_4C_9}{\rho r}\}$, $C_{12}=(C_{10}+\frac{C_9}{\rho r})T_2$ and $C_{13}=\frac{C_9T_2}{\rho r}$.
--
--   It expresses the subgradient bound through $x$-increments only, up to telescoping terms, which is the form Lemma 3 needs in the proof of Theorem 14.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 18, Corollary 10, (62)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Corollary 10 (p. 18). Under Assumption 1, for a sequence generated by Algorithm 1 or
Algorithm 2, the element `Dᵏ⁺¹ ∈ ∂F_r(xᵏ⁺¹, zᵏ⁺¹, yᵏ⁺¹, xᵏ, yᵏ)` of Lemma 9 satisfies, for every
`k ≥ 2`, (62):
`|||Dᵏ⁺¹||| ≤ C₁₁(‖xᵏ⁺¹ − xᵏ‖ + ‖xᵏ − xᵏ⁻¹‖ + ‖xᵏ⁻¹ − xᵏ⁻²‖)
  + C₁₂(‖A*(yᵏ − yᵏ⁻¹)‖ − ‖A*(yᵏ⁺¹ − yᵏ)‖) + C₁₃(‖A*(yᵏ⁻¹ − yᵏ⁻²)‖ − ‖A*(yᵏ − yᵏ⁻¹)‖)`. -/
theorem corollary_10 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y) (k : ℕ) (hk : 2 ≤ k) :
    ‖DVec v P x z y k‖ ≤
      C11 v P * (‖x (k + 1) - x k‖ + ‖x k - x (k - 1)‖ + ‖x (k - 1) - x (k - 2)‖)
      + C12 P * (‖ContinuousLinearMap.adjoint P.A (y k - y (k - 1))‖
          - ‖ContinuousLinearMap.adjoint P.A (y (k + 1) - y k)‖)
      + C13 P * (‖ContinuousLinearMap.adjoint P.A (y (k - 1) - y (k - 2))‖
          - ‖ContinuousLinearMap.adjoint P.A (y k - y (k - 1))‖) := by sorry

end BotNguyenADMM.KL
