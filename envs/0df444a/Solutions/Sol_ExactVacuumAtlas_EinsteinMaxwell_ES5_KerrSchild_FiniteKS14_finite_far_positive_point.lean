/-! # VII-02 (F2a): elimination formula for the real geodesic defect `G = a' p'' - p' a''`

Off shell (only `PaperData`), with `F = f/N`:

  `G = q' F a' + q (F' a' - F a'') - w' (a')²`.

Knowing `q(r) = -Q` at the single point `r` is **not** enough to delete `q'` (see the controls in
`RadialControls.lean`). The on-shell formula below uses the conservation law on the open set `I`:
`q = -Q` on `I` gives `q' = 0` on `I` by transferring the derivative through the local equality
(`Filter.EventuallyEq.deriv_eq`); with `w' = -2(J + 2Qa) f m/N²` this yields

  `G = Q (F a'' - F' a') + 2 (J + 2Qa) (f m/N²) (a')²`.

The root `vii02_radial_conservation_defect` takes only `PaperData`, preconnectedness of `I`, a
base point and the candidate's own `EMCertificateD`; conservation, Eq. 24c and the `G` formula
are conclusions. -/

open scoped ContDiff Topology
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

/-- Off-shell identity for the real defect. -/
theorem G_offshell (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Gfun p a r = deriv (qFun f N w p a) r * Ffun f N r * deriv a r +
      qFun f N w p a r * (deriv (Ffun f N) r * deriv a r - Ffun f N r * deriv (deriv a) r) -
      deriv w r * deriv a r ^ 2 := by
  have hf := hP.nf r hr; have hN := hP.nN r hr
  rw [(hasDerivAt_qFun hP hr).deriv, (hasDerivAt_Ffun hP hr).deriv]
  simp only [Gfun, Ffun, qFun, eFun]
  field_simp
  ring

/-- Derivative transfer: a function equal to a constant on the open set `I` has zero
derivative at every point of `I`. -/
theorem deriv_eq_zero_of_eqOn_const {g : ℝ → ℝ} {c : ℝ} (hI : IsOpen I) (hr : r ∈ I)
    (h : ∀ s ∈ I, g s = c) : deriv g r = 0 := by
  have hg : g =ᶠ[𝓝 r] fun _ => c := Filter.mem_of_superset (hI.mem_nhds hr) fun s hs => h s hs
  rw [hg.deriv_eq, deriv_const]

/-- On-shell defect formula from the conservation law on `I` and the `w'` relation at `r`. -/
theorem G_onshell (hP : PaperData I f m N w p a) (hr : r ∈ I) {Q J : ℝ}
    (hq : ∀ s ∈ I, qFun f N w p a s = -Q)
    (hw : deriv w r = -2 * (J + 2 * Q * a r) * f r * m r / N r ^ 2) :
    Gfun p a r = Q * (Ffun f N r * deriv (deriv a) r - deriv (Ffun f N) r * deriv a r) +
      2 * (J + 2 * Q * a r) * f r * m r / N r ^ 2 * deriv a r ^ 2 := by
  rw [G_offshell hP hr, deriv_eq_zero_of_eqOn_const hP.isOpen hr hq, hq r hr, hw]
  ring

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
