theorem eq_zero_of_coprime (q : ℕ) (hq : Nat.Coprime q (eisensteinNumerator p)) (M : ℕ)
    {x : JZero p} (hx : x ∈ eisensteinTorsionBar p q M) : x = 0 := by
  letI := heckeModuleBar p
  obtain ⟨i, hi, hix⟩ := exists_mem_eisensteinIdeal_smul_eq_eisensteinNumerator_zsmul p
  have hi' : i ∈ eisensteinMaximalIdeal p q := eisensteinIdeal_le p q hi

  obtain ⟨u, v, huv⟩ := (Nat.Coprime.pow_left M hq).isCoprime
  have hqM : ((q ^ M : ℕ) : ℤ) • x = 0 := by
    rw [natCast_zsmul]
    exact nsmul_eq_zero_of_mem p q M hx

  set s : HeckeAlg := MvPolynomial.C v * i with hs
  have hsx : s • x = x := by
    have h1 : (u * ((q ^ M : ℕ) : ℤ) + v * (eisensteinNumerator p : ℤ)) • x = x := by
      rw [huv, one_zsmul]
    rw [add_zsmul, mul_zsmul, hqM, zsmul_zero, zero_add, mul_zsmul, ← hix x] at h1
    rw [hs, mul_smul, heckeModuleBar_C_smul]
    exact h1
  have hsmem : s ∈ eisensteinMaximalIdeal p q := Ideal.mul_mem_left _ _ hi'
  have hpow : ∀ j : ℕ, s ^ j • x = x := by
    intro j
    induction j with
    | zero => rw [pow_zero, one_smul]
    | succ j ih => rw [pow_succ, mul_smul, hsx, ih]
  have h := (mem_eisensteinTorsionBar_iff p q M x).1 hx _ (Ideal.pow_mem_pow hsmem M)
  rw [hpow M] at h
  exact h

end Vacuous

