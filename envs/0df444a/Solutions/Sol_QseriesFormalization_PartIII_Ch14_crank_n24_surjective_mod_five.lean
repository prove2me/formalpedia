theorem solution :
    ∀ r : ZMod 5, ∃ p : Nat.Partition 24, ((crank p : Int) : ZMod 5) = r := by
  intro r
  fin_cases r
  · exact ⟨partitionTwentyFourTwentyThreeOne,
      by rw [crank_partitionTwentyFourTwentyThreeOne]; rfl⟩
  · exact ⟨partitionTwentyFourTwentyOneThree,
