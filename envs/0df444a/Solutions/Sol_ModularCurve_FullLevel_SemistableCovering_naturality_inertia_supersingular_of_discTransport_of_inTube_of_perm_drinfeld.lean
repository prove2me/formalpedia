            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) = (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) := by
  apply Subtype.ext
  change coeffMap (τ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ) (coeffMap (algebraMap ℚ (AlgebraicClosure ℚ)) jq) =
    coeffMap (algebraMap ℚ (AlgebraicClosure ℚ)) jq
