open CirclePackingConstants in
theorem solution (n : ℕ → ℕ) (hn : ∀ i, n i ≤ 2) (hsum : ∑ i ∈ Finset.range 16, n i = 16) (hne : ∃ i < 16, n i ≠ 1)
    (hab : (n 0 = 1 ∧ n 1 = 2)) :
    ∃ e s tx ty, Sixteen.Matches Sixteen.sixteenLib n e s tx ty := by
  have h0 := hn 0
  have h1 := hn 1
  have h2 := hn 2
  obtain ⟨ha, hb⟩ := hab
  exact CPQ.piece_sound Sixteen.sixteenLib CPQ.covTabP12 CPQ.tabP12_ok CPQ.covTokP12 1 2 CPQ.pieceP12_ok (by omega) (by omega) n hn hsum hne ha hb
