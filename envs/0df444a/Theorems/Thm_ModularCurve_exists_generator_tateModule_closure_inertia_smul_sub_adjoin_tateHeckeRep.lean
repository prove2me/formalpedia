open ModularCurve

theorem ModularCurve.exists_generator_tateModule_closure_inertia_smul_sub_adjoin_tateHeckeRep
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∃ s₀ : TateModule 2 (JZero p),
      (∀ n : ℕ, (s₀ : ℕ → JZero p) n ∈ AddSubgroup.closure {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ, ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) ∧
      ∀ s : TateModule 2 (JZero p),
        (∀ n : ℕ, (s : ℕ → JZero p) n ∈ AddSubgroup.closure {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ, ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) →
        ∃ c : ℕ, ∃ α ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t),
          ((2 : ℤ_[2]) ^ c) • s = α s₀ := by sorry
