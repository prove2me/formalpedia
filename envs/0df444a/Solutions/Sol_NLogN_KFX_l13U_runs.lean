  have e2 : ((N - 1 : ℕ) : ℤ) / (d : ℤ) = (((N - 1) / d : ℕ) : ℤ) := by push_cast; rfl
  have e3 : (((N - 1) / d : ℕ) : ℤ) % (Q : ℤ) = (((N - 1) / d % Q : ℕ) : ℤ) := by push_cast; rfl
  have e4 : (((N - 1) / d % Q : ℕ) : ℤ) / 2 ^ ρ = (((N - 1) / d % Q / 2 ^ ρ : ℕ) : ℤ) := by
