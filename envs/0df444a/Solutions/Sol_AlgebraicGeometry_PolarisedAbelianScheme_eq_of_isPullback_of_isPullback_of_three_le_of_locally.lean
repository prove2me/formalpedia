    (h₂mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (x y : SchemeHomOver t' u'.f),
      (u'.L.mul t' x y).1 ≫ g₂ =
        (u.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
