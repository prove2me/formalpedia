theorem J6A.chirpC_fp (p s t α H : ℕ) [NeZero s] [NeZero t] (hst : s ≤ t) (hα : 2 ≤ α)
    (hαp : α ^ 2 ≤ p) (hH : 1 ≤ H) (hH2 : H ≤ 2 * sWidth p α) (hθ : 300 * (t - s) ≤ s)
    (hp : 3 ≤ p) (hWp : 12 * (H + sWidth p α + 3) ≤ 2 ^ (p / 2))
    (L : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ))
    (hL : ∀ U, InDisc p U → ∀ k : ZMod t,
      ‖gC (Sapprox p s t α U k.val) - 2 ^ p * L (fun j => gC (U j.val) / 2 ^ p) k‖
        ≤ 6 * sWidth p α + 4) :
    FPApprox p (chirpC p s t α H) (NLogN.KFM.liftL L) (12 * sWidth p α + 11) := by sorry
