private theorem sw5_heckeKernelMap_coe {E V : Type*} [Fintype E] [Fintype V] [DecidableEq V]
    {D : CerednikDrinfeld.DegeneracyData E V} (H : CerednikDrinfeld.HeckeData D) (ℓ : Nat.Primes)
    (x : ↥(CerednikDrinfeld.ribbonKernel D)) :
    ((CerednikDrinfeld.heckeKernelMap H ℓ x : ↥(CerednikDrinfeld.ribbonKernel D)) : E → ℤ) = (H.T ℓ).mulVec (x : E → ℤ) :=
  rfl

private theorem sw5_finite_sub {ι : Type*} [Fintype ι] (P : Submodule ℤ (ι → ℤ)) :
    @Module.Finite ℤ ↥P _ _ (AddCommGroup.toIntModule _) := by
  have h : Module.Finite ℤ ↥P := inferInstance
  convert h

private theorem sw5_finite_prod {ι : Type*} [Fintype ι] (P : Submodule ℤ (ι → ℤ)) :
    @Module.Finite ℤ (↥P × ↥P) _ _ (AddCommGroup.toIntModule _) := by
  have h : Module.Finite ℤ (↥P × ↥P) := inferInstance
  convert h

private theorem sw5_hca_coe {ι : Type*} [Fintype ι] (B : Matrix ι ι ℤ) {n : ℤ} (h : HeckeRowSums B.transpose n)
    (x : ↥(characterLattice ι)) : ((heckeCharacterAction B.transpose h x : ↥(characterLattice ι)) : ι → ℤ) = B.mulVec x := by
  rw [heckeCharacterAction_coe, jg2_hda_transpose]

private theorem sw5_exists_heckeCarriers
    {c : ℕ} [Fact c.Prime] {K : Type} [Field K] [CharP K c] [DecidableEq K]
    {M s : ℕ} [NeZero M] [NeZero s] (hs : s.Prime) [Fact s.Prime]
    [Fintype ↥(ssPlaces c (M * s) K)] [Fintype ↥(ssPlaces c M K)] [DecidableEq ↥(ssPlaces c (M * s) K)] [DecidableEq ↥(ssPlaces c M K)]
    (X : SSLevelDatum c K M s) (hlaws : X.HeckeLaws)
    (nV : Nat.Primes → ℤ) (hcolV : ∀ ℓ : Nat.Primes, HeckeRowSums (X.vertexHecke ℓ).transpose (nV ℓ)) :
    (∃ (Yo : Type) (_ : AddCommGroup Yo) (_ : Module HeckeAlg Yo) (_ : Module.Finite ℤ Yo)
        (eY : Yo ≃+ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)),
        ∀ (ℓ : Nat.Primes) (m : Yo),
          eY (heckeGen ℓ • m) = CerednikDrinfeld.heckeKernelMap X.heckeData ℓ (eY m)) ∧
    (∃ (Xo : Type) (_ : AddCommGroup Xo) (_ : Module HeckeAlg Xo) (_ : Module.Finite ℤ Xo)
        (eX : Xo ≃+ (↥(characterLattice ↥(ssPlaces c M K)) × ↥(characterLattice ↥(ssPlaces c M K)))),
