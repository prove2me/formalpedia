-- title:
--   $h_p(\omega^i,T)$ has $\mathbb{Z}_p$-coefficients
-- statement:
--   Let $p$ be a prime, $i$ an integer and $\gamma \in \mathrm{Gal}(\overline{\mathbb{Q}}/\mathbb{Q})$. Let $V_i$ be the $\omega^i$-eigenspace of $V = H_\infty \otimes_{\mathbb{Z}_p}\mathbb{Q}_p$, and let
--   $$h_p(\omega^i, T) = \det\big(T - (\gamma-1) \mid V_i\big) \in \mathbb{Q}_p[T].$$
--   Then all coefficients of $h_p(\omega^i, T)$ lie in $\mathbb{Z}_p$; that is, $h_p(\omega^i,T)$ is the image of a polynomial in $\mathbb{Z}_p[T]$.
--
--   This is needed for the source's statement to make sense: the main conjecture compares the ideal of $\mathbb{Z}_p[[T]]$ generated by $h_p(\omega^i, T)$ with the one generated by $G_p(\omega^{1-i}, T)$.
--
--   **Formalization Note** If $V_i$ were infinite-dimensional, `charPoly` would be $0$ by convention, and the statement holds trivially in that case.
-- source:
--   Wikipedia, "Main conjecture of Iwasawa theory", revision oldid=1367440598, https://en.wikipedia.org/w/index.php?title=Main_conjecture_of_Iwasawa_theory&oldid=1367440598, section "Statement" (the ideals of Z_p[[T]] generated by h_p(ω^i,T) and G_p(ω^{1−i},T))

import Definitions.Def_IwasawaMainConjecture_algebraic
import Definitions.Def_IwasawaMainConjecture_analytic

open scoped Polynomial

namespace IwasawaMainConjecture
theorem charPoly_integral (p : ℕ) [Fact p.Prime] (i : ℤ)
    (γ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    ∃ h : ℤ_[p][X], h.map (algebraMap ℤ_[p] ℚ_[p]) = charPoly p i γ := by sorry
end IwasawaMainConjecture
