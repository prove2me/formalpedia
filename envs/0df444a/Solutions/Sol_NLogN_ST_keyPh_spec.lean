  · rw [List.getD_eq_default _ _ hi, Nat.mod_one]

theorem crtKey_prod (s : List ℕ) : crtKey s s.prod = 0 := by
  unfold crtKey; rw [rmPos_congr s _ (fun _ => 0) (fun i _ => by simp only [resJ]; exact mod_prod i), rmPos_zero]

theorem recL_prod (s : List ℕ) : recL s s.prod = recL s 0 := by
  unfold recL; congr 1; funext i; simp only [recI, mod_prod, Nat.zero_mod]

theorem succ_mod_cases (k n : ℕ) (hn : 0 < n) :
    (k + 1) % n = if k % n + 1 < n then k % n + 1 else 0 := by
  have h1 := Nat.mod_add_div k n
  have h2 := Nat.mod_lt k hn
  split_ifs with h
  · rw [show k + 1 = (k % n + 1) + n * (k / n) by omega, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt h]
  · rw [show k + 1 = n * (k / n + 1) by rw [Nat.mul_add]; omega, Nat.mul_mod_right]

theorem recL_length (s : List ℕ) (k : ℕ) : (recL s k).length = s.length := by simp [recL]

theorem recL_drop (s : List ℕ) (k m : ℕ) (hm : m < s.length) :
    (recL s k).drop m = recI s k m :: (recL s k).drop (m + 1) := by
  rw [List.drop_eq_getElem_cons (by simpa [recL_length] using hm)]
  simp [recL]

theorem recL_take (s : List ℕ) (k m : ℕ) (hm : m < s.length) :
    ((recL s k).take (m + 1)).flatten.reverse =
      (recI s k m).reverse ++ ((recL s k).take m).flatten.reverse := by
  rw [List.take_add_one, List.getElem?_eq_getElem (by simpa [recL_length] using hm)]
  simp [recL]

theorem recL_flatten_length (s : List ℕ) (k : ℕ) : (recL s k).flatten.length = 4 * s.length := by
  simp [recL, recI, List.length_flatten, Function.comp_def, List.sum_replicate]; ring

theorem inner_step (t1 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ)
    (Rst RB0 LP : List Item) (N m : ℕ) (hm : m < s.length) :
    NLogN.CR.axBody.ok (withCtr kC2 t1 N m (innerSt t1 s k Rst RB0 LP m)) ∧
    NLogN.CR.axBody.run (withCtr kC2 t1 N m (innerSt t1 s k Rst RB0 LP m)) =
      withCtr kC2 t1 N m (innerSt t1 s k Rst RB0 LP (m + 1)) := by
  set u := withCtr kC2 t1 N m (innerSt t1 s k Rst RB0 LP m) with hu
  set sm := s.getD m 1 with hsm
  have hpos : 0 < sm := getD_pos hs m
  have hA : u.G kRA = .int ((k % sm : ℕ) : ℤ) :: .int (sm : ℤ) :: .int (wgt s m : ℤ) ::
      .int ((sm * wgt s m : ℕ) : ℤ) :: (ints ((recL s k).drop (m + 1)).flatten ++ Rst) := by
    simp only [hu, withCtr, innerSt, IState.upd_G]
    simp (config := {decide := true}) only [if_true, if_false]
    rw [recL_drop s k m hm, List.flatten_cons, ints_append]
    simp [recI, hsm]
  have hP : u.G kPS = .int (rmPos s (mixJ s k m) : ℤ) :: LP := by
    simp only [hu, withCtr, innerSt, IState.upd_G]
    simp (config := {decide := true})
  obtain ⟨hok, hrun⟩ := axBody_spec u _ _ _ _ _ _ _ hA hP
  refine ⟨hok, ?_⟩
  rw [hrun]
  have hr : (if ((k % sm : ℕ) : ℤ) + 1 < (sm : ℤ) then ((k % sm : ℕ) : ℤ) + 1 else 0) =
      (((k + 1) % sm : ℕ) : ℤ) := by
    rw [succ_mod_cases k sm hpos]
    split_ifs with h1 h2 h2 <;> push_cast at * <;> omega
  have hp : (if ((k % sm : ℕ) : ℤ) + 1 < (sm : ℤ) then (rmPos s (mixJ s k m) : ℤ) + (wgt s m : ℤ)
      else (rmPos s (mixJ s k m) : ℤ) + (wgt s m : ℤ) - ((sm * wgt s m : ℕ) : ℤ)) =
      (rmPos s (mixJ s k (m + 1)) : ℤ) := by
    rw [mixJ_succ, rmPos_update s _ m _ hm]
    have e : mixJ s k m m = k % sm := by simp [mixJ, hsm]
    rw [e, succ_mod_cases k sm hpos]
    have := Nat.mod_lt k hpos
    by_cases h1 : k % sm + 1 < sm
    · have h1' : ((k % sm : ℕ) : ℤ) + 1 < (sm : ℤ) := by exact_mod_cast h1
      rw [if_pos h1', if_pos h1]; push_cast; ring
    · have h1' : ¬ (((k % sm : ℕ) : ℤ) + 1 < (sm : ℤ)) := by exact_mod_cast h1
      rw [if_neg h1', if_neg h1]
      have e2 : ((k % sm : ℕ) : ℤ) = (sm : ℤ) - 1 := by omega
      rw [e2]; push_cast; ring
  have hB : (ints ((recL s (k + 1)).take (m + 1)).flatten.reverse ++ RB0) =
      .int ((sm * wgt s m : ℕ) : ℤ) :: .int (wgt s m : ℤ) :: .int (sm : ℤ) ::
        .int (((k + 1) % sm : ℕ) : ℤ) :: (ints ((recL s (k + 1)).take m).flatten.reverse ++ RB0) := by
    rw [recL_take s (k + 1) m hm]
    simp [recI, hsm, ints_append]
  rw [hr, hp]
  apply IState.ext' _ (by simp [hu, withCtr, innerSt]) (by simp [hu, withCtr, innerSt])
  intro x
  simp only [IState.upd_G, hu, withCtr, innerSt, hB]
  ((split_ifs <;> (try subst_vars) <;> simp_all +decide))

theorem inner_states (t1 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ)
    (Rst LK LP : List Item) (hK : t1.G kKR = .int s.length :: LK)
    (hA : t1.G kRA = ints (recL s k).flatten ++ Rst)
    (hP : t1.G kPS = .int (crtKey s k) :: LP) :
    RepStates kC2 (.reg kKR) NLogN.CR.axBody t1 (innerSt t1 s k Rst (t1.G kRB) LP) where
  nonneg := by simp [Ex.eval, IState.top_eq hK]
  hw := by decide
  h0 := by
    apply IState.ext' _ (by simp [innerSt]) (by simp [innerSt])
    intro x
    simp only [innerSt, IState.upd_G, List.drop_zero, List.take_zero, List.flatten_nil,
      List.reverse_nil, ints_nil, List.nil_append, rmPos_mixJ_zero]
    split_ifs with h1 h2 h3 <;> (try subst_vars) <;> simp_all
  hG := fun m => by simp (config := {decide := true}) [innerSt]
  step := fun m hm => by
    have hm' : m < s.length := by simpa [Ex.eval, IState.top_eq hK] using hm
    exact (inner_step t1 s hs k Rst _ _ _ m hm').2

theorem inner_run (t1 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ)
    (Rst LK LP : List Item) (hK : t1.G kKR = .int s.length :: LK)
    (hA : t1.G kRA = ints (recL s k).flatten ++ Rst)
    (hP : t1.G kPS = .int (crtKey s k) :: LP) :
    (rep kC2 (.reg kKR) NLogN.CR.axBody).ok t1 ∧
    (rep kC2 (.reg kKR) NLogN.CR.axBody).run t1 = innerSt t1 s k Rst (t1.G kRB) LP s.length := by
  have H := NLogN.CR.inner_states t1 s hs k Rst LK LP hK hA hP
  have e : (Ex.reg (S := HS) kKR).eval t1 = s.length := by simp [Ex.eval, IState.top_eq hK]
  refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of hK) ?_, ?_⟩
  · intro m hm
    rw [e, Int.toNat_natCast] at hm ⊢
    exact (inner_step t1 s hs k Rst _ _ _ m hm).1
  · rw [H.run, e, Int.toNat_natCast]

theorem keyPre_succ (s : List ℕ) (k : ℕ) :
    (keyPre s (k + 1)).reverse = (crtKey s k : ℤ) :: (keyPre s k).reverse := by
  simp [keyPre, List.range_succ]

theorem out_step (s0 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (Rst LP T0 LK L4 : List Item)
    (hK : s0.G kKR = .int s.length :: LK) (h4 : s0.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4)
    (N k : ℕ) :
    outBody.ok (withCtr kC1 s0 N k (keySt s0 s Rst LP T0 k)) ∧
    outBody.run (withCtr kC1 s0 N k (keySt s0 s Rst LP T0 k)) =
      withCtr kC1 s0 N k (keySt s0 s Rst LP T0 (k + 1)) := by
  set u := withCtr kC1 s0 N k (keySt s0 s Rst LP T0 k) with hu
  have uK : u.G kKR = .int s.length :: LK := by simp (config := {decide := true}) [hu, withCtr, keySt, hK]
  have uP : u.G kPS = .int (crtKey s k) :: LP := by simp (config := {decide := true}) [hu, withCtr, keySt]
  set t1 := (push kT (.reg kPS)).run u with ht1
  have t1K : t1.G kKR = .int s.length :: LK := by simp (config := {decide := true}) [ht1, uK]
  have t1A : t1.G kRA = ints (recL s k).flatten ++ Rst := by
    simp (config := {decide := true}) [ht1, hu, withCtr, keySt]
  have t1P : t1.G kPS = .int (crtKey s k) :: LP := by simp (config := {decide := true}) [ht1, uP]
  obtain ⟨iok, irun⟩ := inner_run t1 s hs k Rst LK LP t1K t1A t1P
  set t2 := innerSt t1 s k Rst (t1.G kRB) LP s.length with ht2
  have t2B : t2.G kRB = ints ((recL s (k + 1)).flatten.reverse) ++ t1.G kRB := by
    simp (config := {decide := true}) only [ht2, innerSt, IState.upd_G, if_true, if_false]
    rw [List.take_of_length_le (by simp [recL_length])]
  have t24 : t2.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4 := by
    simp (config := {decide := true}) [ht2, innerSt, ht1, hu, withCtr, keySt, h4]
  have hm := mvK_spec (X := kRB) (Y := kRA) (C := kC3) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg kK4) (clean_of_lt (by decide)) t2 _ _ t2B
    (IState.isInt_of t24) (by simp only [Ex.eval, IState.top_eq t24, List.length_reverse,
      recL_flatten_length])
  refine ⟨⟨⟨by decide, clean_of_lt (by decide), IState.isInt_of uP⟩, iok, ?_⟩, ?_⟩
  · rw [irun]; exact hm.1
  · simp only [outBody, run_seq]
    rw [← ht1, irun, hm.2]
    apply IState.ext' _ (by simp [ht2, innerSt, ht1, hu, withCtr, keySt])
      (by simp [ht2, innerSt, ht1, hu, withCtr, keySt])
    intro x
    have e1 : (ints (recL s (k + 1)).flatten.reverse).reverse = ints (recL s (k + 1)).flatten := by
      rw [ints_reverse, List.reverse_reverse]
    have e2 : t2.G kRA = Rst := by
      simp (config := {decide := true}) only [ht2, innerSt, IState.upd_G, if_true, if_false]
      rw [List.drop_of_length_le (by simp [recL_length])]; simp
    have e3 : ((Ex.reg kPS).eval u) = crtKey s k := by simp [Ex.eval, IState.top_eq uP]
    have G2 : ∀ x, t2.G x = if x = kPS then .int (crtKey s (k + 1)) :: LP else
        if x = kRB then ints ((recL s (k + 1)).flatten.reverse) ++ t1.G kRB else
        if x = kRA then Rst else t1.G x := by
      intro x; rw [← t2B, ← e2]
      simp only [ht2, innerSt, IState.upd_G, rmPos_mixJ_len]
      split_ifs <;> (try subst_vars) <;> simp_all +decide
    have G1 : ∀ x, t1.G x = if x = kT then .int (crtKey s k) :: u.G kT else u.G x := by
      intro x; simp only [ht1, run_push_G, e3]
    clear_value t2 t1 u
    simp only [IState.upd_G, e1, e2, G2, G1]
    subst hu
    simp only [withCtr]
    simp only [keySt]
    simp only [IState.upd_G]
    rw [keyPre_succ]
    clear * -
    ((split_ifs <;> (try subst_vars) <;> simp_all +decide))

theorem keyPre_prod (s : List ℕ) : keyPre s s.prod = (keyL s).map (Nat.cast : ℕ → ℤ) := by
  simp [keyPre, keyL]

theorem out_states (s0 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (Rst LS LK L4 : List Item)
    (t0 : IState HS) (ht0 : t0 = (push kPS (.lit 0)).run s0)
    (hA : s0.G kRA = ints (recL s 0).flatten ++ Rst) (hS : s0.G kSR = .int s.prod :: LS)
    (hK : s0.G kKR = .int s.length :: LK) (h4 : s0.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4) :
    RepStates kC1 (.reg kSR) outBody t0 (keySt t0 s Rst (s0.G kPS) (s0.G kT)) where
  nonneg := by
    have : t0.G kSR = .int s.prod :: LS := by subst ht0; simp (config := {decide := true}) [hS]
    simp only [Ex.eval, IState.top_eq this]; positivity
  hw := by decide
  h0 := by
    subst ht0
    apply IState.ext' _ (by simp [keySt]) (by simp [keySt])
    intro x
    simp only [keySt, IState.upd_G, crtKey_zero, keyPre, List.range_zero, List.map_nil,
      List.reverse_nil, ints_nil, List.nil_append, run_push_G, Ex.eval]
    split_ifs <;> (try subst_vars) <;> simp_all +decide
  hG := fun k => by simp (config := {decide := true}) [keySt]
  step := fun k _ => by
    have t0K : t0.G kKR = .int s.length :: LK := by subst ht0; simp (config := {decide := true}) [hK]
    have t04 : t0.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4 := by
      subst ht0; simp (config := {decide := true}) [h4]
    exact (out_step t0 s hs Rst _ _ LK L4 t0K t04 _ k).2

theorem keyGen_spec (s0 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (Rst LS LK L4 : List Item)
    (hA : s0.G kRA = ints (recL s 0).flatten ++ Rst) (hS : s0.G kSR = .int s.prod :: LS)
    (hK : s0.G kKR = .int s.length :: LK) (h4 : s0.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4) :
    keyGen.ok s0 ∧ keyGen.run s0 = s0.upd 3 (natInts (keyL s) ++ s0.G 3) := by
  set t0 := (push kPS (.lit 0)).run s0 with ht0
  have H := out_states s0 s hs Rst LS LK L4 t0 ht0 hA hS hK h4
  have t0S : t0.G kSR = .int s.prod :: LS := by simp (config := {decide := true}) [ht0, hS]
  have t0K : t0.G kKR = .int s.length :: LK := by simp (config := {decide := true}) [ht0, hK]
  have t04 : t0.G kK4 = .int ((4 * s.length : ℕ) : ℤ) :: L4 := by
    simp (config := {decide := true}) [ht0, h4]
  have e : (Ex.reg (S := HS) kSR).eval t0 = s.prod := by simp [Ex.eval, IState.top_eq t0S]
  have hloop : (rep kC1 (.reg kSR) outBody).run t0 = keySt t0 s Rst (s0.G kPS) (s0.G kT) s.prod := by
    rw [H.run, e, Int.toNat_natCast]
  set t1 := keySt t0 s Rst (s0.G kPS) (s0.G kT) s.prod with ht1
  have t1P : t1.G kPS = .int 0 :: s0.G kPS := by
    simp (config := {decide := true}) [ht1, keySt, crtKey_prod]
  set t2 := (pop kPS).run t1 with ht2
  have t2T : t2.G kT = ints ((keyPre s s.prod).reverse) ++ s0.G kT := by
    simp (config := {decide := true}) [ht2, ht1, keySt]
  have t2S : t2.G kSR = .int s.prod :: LS := by
    simp (config := {decide := true}) [ht2, ht1, keySt, t0S]
  have hm := mvK_spec (X := kT) (Y := 3) (C := kC3) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg kSR) (clean_of_lt (by decide)) t2 _ _ t2T
    (IState.isInt_of t2S) (by simp [Ex.eval, IState.top_eq t2S, keyPre])
  refine ⟨⟨⟨by decide, by decide, trivial⟩, ?_, ?_⟩, ?_⟩
  · refine H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of t0S) ?_
    intro k _
    exact (out_step t0 s hs Rst _ _ LK L4 t0K t04 _ k).1
  · rw [hloop]
    exact ⟨⟨by decide, IState.isInt_of t1P⟩, hm.1⟩
  · simp only [keyGen, run_seq]
    rw [hloop, show (pop kPS).run t1 = t2 from rfl, hm.2]
    apply IState.ext' _ (by simp [ht2, ht1, keySt, ht0]) (by simp [ht2, ht1, keySt, ht0])
    intro x
    have e1 : (ints (keyPre s s.prod).reverse).reverse = natInts (keyL s) := by
      rw [ints_reverse, List.reverse_reverse, keyPre_prod]; rfl
    have G2 : ∀ x, t2.G x = if x = kPS then s0.G kPS else t1.G x := by
      intro x; simp only [ht2, run_pop_G, t1P, List.tail_cons]
    have G1 : ∀ x, t1.G x = if x = kT then ints (keyPre s s.prod).reverse ++ s0.G kT else
        if x = kPS then .int 0 :: s0.G kPS else if x = kRA then s0.G kRA else t0.G x := by
      intro x; simp only [ht1, keySt, IState.upd_G, crtKey_prod, recL_prod, ← hA, Nat.cast_zero]
    have G0 : ∀ x, t0.G x = if x = kPS then .int 0 :: s0.G kPS else s0.G x := by
      intro x; simp [ht0, Ex.eval]
    clear_value t2 t1 t0
    simp only [IState.upd_G, e1, G2, G1, G0]
    clear * -
    ((split_ifs <;> (try subst_vars) <;> simp_all +decide))

end NLogN.CR

