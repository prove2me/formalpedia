    have he₀snd : e₀ ≫ pullback.snd π₀ (Spec.map (CommRingCat.ofHom j)) = π := he₀
    have hs₀Pt₀ : (𝔐.pointEquivPlace.symm P₀).1 ≫ e ≫ pullback.fst π (Spec.map (CommRingCat.ofHom O.subtype)) =
        Spec.map (CommRingCat.ofHom O.subtype) ≫ Pt₀.1 := by
