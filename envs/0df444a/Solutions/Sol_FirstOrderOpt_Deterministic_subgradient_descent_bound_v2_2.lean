import Mathlib

open scoped RealInnerProductSpace

/-- Theorem 3.1 (subgradient descent function-value bound), Lan p. 54. For the problem
`min_{x ∈ X} f(x)` of §3.1 with `X` closed convex and `f` convex and `M`-Lipschitz on `X`, let
`x t` be generated by the projected-subgradient update (3.1.3)/(3.1.4) with subgradients `g t` of
`f` at `x t` of dual norm at most `M` (the book's `‖f'(x)‖_* ≤ M`). Then for every `x' ∈ X` and
`s ≤ k`, `Σ_{t=s}^{k} γt[f(x t) - f x'] ≤ (1/2)(‖x' - x s‖² + M² Σ_{t=s}^{k} γt²)`.

Corrected version: the retired statement dropped the standing assumptions that `X` is closed and
convex and `f` convex, and bounded `f` by a Lipschitz condition only, leaving the subgradients used
by the method unbounded; the bound on the subgradients `‖g t‖ ≤ M` is what the book's (3.1.5) and
its proof use. -/
theorem solution {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (X : Set E) (hXconv : Convex ℝ X) (hXclosed : IsClosed X)
    (f : E → ℝ) (hfconv : ConvexOn ℝ X f) (M : ℝ) (hM : 0 < M)
    (hLip : ∀ x ∈ X, ∀ y ∈ X, |f x - f y| ≤ M * ‖x - y‖)
    (x g : ℕ → E) (γ : ℕ → ℝ)
    (hx : ∀ t, x t ∈ X) (hγ : ∀ t, 0 < γ t)
    (hsub : ∀ t, ∀ y ∈ X, f (x t) + ⟪g t, y - x t⟫ ≤ f y)
    (hgnorm : ∀ t, ‖g t‖ ≤ M)
    (hmin : ∀ t, ∀ y ∈ X, γ t * ⟪g t, x (t + 1)⟫ + (1 / 2) * ‖x (t + 1) - x t‖ ^ 2 ≤
      γ t * ⟪g t, y⟫ + (1 / 2) * ‖y - x t‖ ^ 2)
    (s k : ℕ) (hsk : s ≤ k) :
    ∀ x' ∈ X, ∑ t ∈ Finset.Icc s k, γ t * (f (x t) - f x') ≤
      (1 / 2) * (‖x' - x s‖ ^ 2 + M ^ 2 * ∑ t ∈ Finset.Icc s k, (γ t) ^ 2) := by
  intro x' hx'
  have expand : ∀ t (l : ℝ), γ t * ⟪g t, x (t+1) + l • (x' - x (t+1))⟫
      + (1/2) * ‖x (t+1) + l • (x' - x (t+1)) - x t‖ ^ 2
      = γ t * ⟪g t, x (t + 1)⟫ + (1 / 2) * ‖x (t + 1) - x t‖ ^ 2
        + l * (γ t * ⟪g t, x' - x (t+1)⟫ + ⟪x (t+1) - x t, x' - x (t+1)⟫)
        + l ^ 2 / 2 * ‖x' - x (t+1)‖ ^ 2 := by
    intro t l
    have h1 : x (t+1) + l • (x' - x (t+1)) - x t = (x (t+1) - x t) + l • (x' - x (t+1)) := by abel
    rw [h1, norm_add_sq_real, inner_add_right, real_inner_smul_right, real_inner_smul_right,
      norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    ring
  have key : ∀ t, γ t * (f (x t) - f x') ≤
      (1/2) * ‖x' - x t‖ ^ 2 - (1/2) * ‖x' - x (t+1)‖ ^ 2 + (1/2) * M ^ 2 * γ t ^ 2 := by
    intro t
    set A := γ t * ⟪g t, x' - x (t+1)⟫ + ⟪x (t+1) - x t, x' - x (t+1)⟫ with hA
    set D := ‖x' - x (t+1)‖ ^ 2 with hD
    have hD0 : 0 ≤ D := by positivity
    have hl : ∀ l : ℝ, 0 < l → l ≤ 1 → 0 ≤ A + l / 2 * D := by
      intro l hl0 hl1
      have hm := hmin t _ (hXconv.add_smul_sub_mem (hx (t+1)) hx' ⟨hl0.le, hl1⟩)
      rw [expand] at hm
      have e : l * (A + l / 2 * D) = l * A + l ^ 2 / 2 * D := by ring
      have h2 : 0 ≤ l * (A + l / 2 * D) := by rw [e, hA, hD]; linarith
      exact (mul_nonneg_iff_of_pos_left hl0).mp h2
    have hA0 : 0 ≤ A := by
      by_contra hneg
      push Not at hneg
      set l := min 1 (-A / (D + 1))
      have hlpos : 0 < l := lt_min one_pos (div_pos (by linarith) (by linarith))
      have hl2 : l * (D + 1) ≤ -A := (le_div_iff₀ (by linarith)).mp (min_le_right _ _)
      have := hl l hlpos (min_le_left _ _)
      nlinarith
    have h3 := expand t 1
    simp only [one_smul, one_mul, one_pow] at h3
    have hx1 : x (t+1) + (x' - x (t+1)) = x' := by abel
    rw [hx1] at h3
    have hm := hmin t x' hx'
    have hs := hsub t x' hx'
    have hcs : ⟪g t, x t - x (t+1)⟫ ≤ M * ‖x t - x (t+1)‖ :=
      (real_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right (hgnorm t) (norm_nonneg _))
    have e1 : ⟪g t, x' - x t⟫ = ⟪g t, x'⟫ - ⟪g t, x t⟫ := inner_sub_right _ _ _
    have e2 : ⟪g t, x t - x (t+1)⟫ = ⟪g t, x t⟫ - ⟪g t, x (t+1)⟫ := inner_sub_right _ _ _
    have e3 : ‖x t - x (t+1)‖ = ‖x (t+1) - x t‖ := norm_sub_rev _ _
    rw [e3] at hcs
    have hg := hγ t
    have : 0 ≤ (γ t * M - ‖x (t+1) - x t‖) ^ 2 := sq_nonneg _
    nlinarith [mul_le_mul_of_nonneg_left hcs hg.le]
  have main : ∀ k, s ≤ k → ∑ t ∈ Finset.Icc s k, γ t * (f (x t) - f x') ≤
      (1/2) * ‖x' - x s‖ ^ 2 - (1/2) * ‖x' - x (k+1)‖ ^ 2
        + (1/2) * M ^ 2 * ∑ t ∈ Finset.Icc s k, (γ t) ^ 2 := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base => simp; linarith [key s]
    | succ n hn ih =>
      rw [Finset.sum_Icc_succ_top (by omega), Finset.sum_Icc_succ_top (by omega)]
      linarith [key (n+1)]
  have := main k hsk
  nlinarith [sq_nonneg ‖x' - x (k+1)‖]
