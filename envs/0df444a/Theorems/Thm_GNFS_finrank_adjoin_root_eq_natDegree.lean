-- title:
--   $[\mathbb{Q}(\theta):\mathbb{Q}] = \deg f$ for irreducible $f$
-- statement:
--   Let $f \in \mathbb{Q}[x]$ be irreducible of degree $d$, and let $\theta \in \mathbb{C}$ satisfy $f(\theta) = 0$. Then the subfield $\mathbb{Q}(\theta) \subseteq \mathbb{C}$ generated by $\theta$ has dimension $d$ as a vector space over $\mathbb{Q}$:
--   $$[\mathbb{Q}(\theta):\mathbb{Q}] = d.$$
--
--   So every element of $\mathbb{Q}(\theta)$ is written uniquely as $\sum_{i<d} a_i\theta^i$ with $a_i \in \mathbb{Q}$, which is how GNFS represents number-field elements.
-- source:
--   Wikipedia, "General number field sieve" (revision oldid=1377718368, https://en.wikipedia.org/w/index.php?title=General_number_field_sieve&oldid=1377718368), section 'Number fields'

import Mathlib
import Definitions.Def_GNFS_defs
open Polynomial IntermediateField

namespace GNFS
theorem finrank_adjoin_root_eq_natDegree (f : ℚ[X]) (hf : Irreducible f) (θ : ℂ)
    (hθ : aeval θ f = 0) :
    Module.finrank ℚ ℚ⟮θ⟯ = f.natDegree := by sorry
end GNFS
