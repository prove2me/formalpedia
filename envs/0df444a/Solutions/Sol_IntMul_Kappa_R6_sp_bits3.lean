/-!
# Round-six setup, part 3: the candidate loop

Registers (all fixed): `36` the product `P`, `40` the window width `w`, `41` the left end `A`,
`42` the selected candidate, `44` the candidate `c`, `45` the residue `2P mod c`, `46` the sum,
counters `49` (candidates) and `50` (sum).

* `sumT_eq`: the inverse sum is `muInv Q c` if `Q` is coprime to `c`, else `0`.
* **`sp_cand`** (`candR`): the loop over `c = A + w, …, A + 1` leaves `pick A (2P) w` on `42`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

/-! ## Arithmetic -/

/-- `zsz` from an atom bound. -/
theorem zszA {z : ℤ} {Aa Bb : ℕ} (hAa : 2 ≤ Aa) (hB : Aa ^ 6 < 2 ^ Bb) (h : |z| ≤ (Aa : ℤ)) :
    zsz z ≤ Bb :=
  zsz_of_abs (k := 1) (by simpa using h)
    (lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by norm_num)) hB)

theorem bnd6 {st : IState HS} {e : Ex HS} {Aa Bb : ℕ} (hAa : 2 ≤ Aa) (hB : Aa ^ 6 < 2 ^ Bb)
    (h : exSm Aa st e) (hd : exDg e ≤ 6) : e.Bnd st Bb :=
  exSm_bnd Aa Bb st hAa e h (lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) hd) hB)

theorem absA {v : ℤ} {Aa : ℕ} (h0 : 0 ≤ v) (h1 : v ≤ Aa) : |v| ≤ (Aa : ℤ) := by
  rw [abs_of_nonneg h0]; exact h1

/-! ## The candidate loop -/

theorem isInt_ne {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} (h : f i ≠ []) :
    (encK s f).IsInt i := (isInt_encK_iff' s f i).2 (Or.inl h)

end IntMul.Kappa.R6

end

