  show φ a = algebraMap W F (e (φ.codRestrict ⊥ h a))
  rw [← hy, e.apply_symm_apply]
  exact (congrArg Subtype.val hy).symm.trans ((e.symm.commutes y ▸ rfl : ((e.symm y : (⊥ : Subalgebra W F)) : F) = _))
