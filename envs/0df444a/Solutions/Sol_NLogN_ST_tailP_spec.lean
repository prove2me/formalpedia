  | reg i, _, h => by
    simp only [NLogN.Ex.cost, size, NLogN.Ex.Bnd] at h ⊢; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | lit c, _, h => by
    simp only [NLogN.Ex.cost, size, NLogN.Ex.Bnd] at h ⊢; nlinarith
  | add a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [NLogN.Ex.cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | shl a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [NLogN.Ex.cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | quo a b, hl, h | rem a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2
    simp only [NLogN.Ex.cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | neg a, hl, h => by
    have ha := cost_le_lin s B a hl h
    simp only [NLogN.Ex.cost, size]; nlinarith
  | sel c x y, hl, h => by
    have hc := cost_le_lin s B c hl.1 h.1
    have zc := zsz_eval_le s B c h.1
    simp only [NLogN.Ex.cost, size]
