section Formal

variable {B : Type} [CommRing B]

theorem nilEval_zero_tuple {σ : Type} [Fintype σ] [DecidableEq σ] {B' : Type} [CommRing B'] [Algebra B B']
    (ν : ℕ) (φ : MvPowerSeries σ B) (hφ : MvPowerSeries.constantCoeff φ = 0) :
    MvFormalGroup.nilEval ν φ (0 : σ → B') = 0 := by
  have h := (MvFormalGroup.nilEval_subst_of_mem (⊥ : Ideal B') ν (by simp) (0 : σ → B') (fun _ => by simp)
    (fun _ : Fin 1 => φ) (fun _ => hφ) 0).1 0
  simpa using h

theorem nilMul_mem {g : ℕ} (F : MvFormalGroup g B) {B' : Type} [CommRing B'] [Algebra B B']
    (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥) (u v : Fin g → B') (hu : ∀ i, u i ∈ J) (hv : ∀ i, v i ∈ J)
    (i : Fin g) : F.nilMul ν u v i ∈ J := by
  classical
  have hs : ∀ j, Sum.elim u v j ∈ J := by rintro (j | j) <;> simp [hu, hv]
  exact (MvFormalGroup.nilEval_subst_of_mem J ν hJ (Sum.elim u v) hs F.toPowerSeries F.constantCoeff_eq_zero 0).1 i

theorem iterate_nilMul_mem {g : ℕ} (F : MvFormalGroup g B) {B' : Type} [CommRing B'] [Algebra B B']
    (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥) (s : Fin g → B') (hs : ∀ i, s i ∈ J) (m : ℕ) (i : Fin g) :
    ((fun t : Fin g → B' => F.nilMul ν t s)^[m] 0) i ∈ J := by
  induction m generalizing i with
  | zero => simp
  | succ m ih => rw [Function.iterate_succ_apply']; exact nilMul_mem F J ν hJ _ s ih hs i

theorem nilMul_zero_zero {g : ℕ} (F : MvFormalGroup g B) {B' : Type} [CommRing B'] [Algebra B B'] (ν : ℕ) :
    F.nilMul ν (0 : Fin g → B') 0 = 0 := by
  classical
  funext i
  have h0 : (Sum.elim (0 : Fin g → B') (0 : Fin g → B')) = 0 := by funext j; rcases j with j | j <;> rfl
  show MvFormalGroup.nilEval ν (F.toPowerSeries i) (Sum.elim 0 0) = 0
  rw [h0]
  exact nilEval_zero_tuple ν _ (F.constantCoeff_eq_zero i)

theorem hom_nilEval_nilMul {g g' : ℕ} {F : MvFormalGroup g B} {F' : MvFormalGroup g' B} (T : MvFormalGroup.Hom F F')
    {B' : Type} [CommRing B'] [Algebra B B'] (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥)
    (s t : Fin g → B') (hs : ∀ i, s i ∈ J) (ht : ∀ i, t i ∈ J) :
    (fun i => MvFormalGroup.nilEval ν (T.toPowerSeries i) (F.nilMul ν s t)) =
      F'.nilMul ν (fun j => MvFormalGroup.nilEval ν (T.toPowerSeries j) s)
        (fun j => MvFormalGroup.nilEval ν (T.toPowerSeries j) t) := by
  classical
  have hst : ∀ j, Sum.elim s t j ∈ J := by rintro (j | j) <;> simp [hs, ht]
  have hXl : ∀ l : Fin g, MvPowerSeries.constantCoeff (X (Sum.inl l) : MvPowerSeries (Fin g ⊕ Fin g) B) = 0 :=
    fun l => constantCoeff_X _
  have hXr : ∀ l : Fin g, MvPowerSeries.constantCoeff (X (Sum.inr l) : MvPowerSeries (Fin g ⊕ Fin g) B) = 0 :=
    fun l => constantCoeff_X _
  have hin : ∀ j, MvPowerSeries.constantCoeff (Sum.elim
      (fun j => subst (fun l => (X (Sum.inl l) : MvPowerSeries (Fin g ⊕ Fin g) B)) (T.toPowerSeries j))
      (fun j => subst (fun l => (X (Sum.inr l) : MvPowerSeries (Fin g ⊕ Fin g) B)) (T.toPowerSeries j)) j) = 0 := by
    rintro (j | j)
    · exact constantCoeff_subst_eq_zero (hasSubst_of_constantCoeff_zero hXl) hXl (T.constantCoeff_eq_zero j)
    · exact constantCoeff_subst_eq_zero (hasSubst_of_constantCoeff_zero hXr) hXr (T.constantCoeff_eq_zero j)
  funext i
  have key := congrArg (fun ψ => MvFormalGroup.nilEval ν ψ (Sum.elim s t)) (T.subst_eq i)
  beta_reduce at key
  rw [(MvFormalGroup.nilEval_subst_of_mem J ν hJ (Sum.elim s t) hst F.toPowerSeries F.constantCoeff_eq_zero
      (T.toPowerSeries i)).2,
    (MvFormalGroup.nilEval_subst_of_mem J ν hJ (Sum.elim s t) hst _ hin (F'.toPowerSeries i)).2] at key
  have hinner : (fun j => MvFormalGroup.nilEval ν (Sum.elim
      (fun j => subst (fun l => (X (Sum.inl l) : MvPowerSeries (Fin g ⊕ Fin g) B)) (T.toPowerSeries j))
      (fun j => subst (fun l => (X (Sum.inr l) : MvPowerSeries (Fin g ⊕ Fin g) B)) (T.toPowerSeries j)) j)
        (Sum.elim s t)) =
      Sum.elim (fun j => MvFormalGroup.nilEval ν (T.toPowerSeries j) s)
        (fun j => MvFormalGroup.nilEval ν (T.toPowerSeries j) t) := by
    funext j
    rcases j with j | j
    · show MvFormalGroup.nilEval ν (subst (fun l => (X (Sum.inl l) : MvPowerSeries (Fin g ⊕ Fin g) B))
          (T.toPowerSeries j)) (Sum.elim s t) = MvFormalGroup.nilEval ν (T.toPowerSeries j) s
      rw [(MvFormalGroup.nilEval_subst_of_mem J ν hJ (Sum.elim s t) hst _ hXl (T.toPowerSeries j)).2]
      congr 1
      funext l
      exact MvFormalGroup.nilEval_X_of_mem J ν hJ _ hst (Sum.inl l)
    · show MvFormalGroup.nilEval ν (subst (fun l => (X (Sum.inr l) : MvPowerSeries (Fin g ⊕ Fin g) B))
          (T.toPowerSeries j)) (Sum.elim s t) = MvFormalGroup.nilEval ν (T.toPowerSeries j) t
      rw [(MvFormalGroup.nilEval_subst_of_mem J ν hJ (Sum.elim s t) hst _ hXr (T.toPowerSeries j)).2]
      congr 1
      funext l
      exact MvFormalGroup.nilEval_X_of_mem J ν hJ _ hst (Sum.inr l)
  rw [hinner] at key
  exact key

theorem hom_nilEval_iterate {g g' : ℕ} {F : MvFormalGroup g B} {F' : MvFormalGroup g' B} (T : MvFormalGroup.Hom F F')
    {B' : Type} [CommRing B'] [Algebra B B'] (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥)
    (s : Fin g → B') (hs : ∀ i, s i ∈ J) (m : ℕ) :
    (fun i => MvFormalGroup.nilEval ν (T.toPowerSeries i) ((fun t : Fin g → B' => F.nilMul ν t s)^[m] 0)) =
      (fun t : Fin g' → B' => F'.nilMul ν t (fun j => MvFormalGroup.nilEval ν (T.toPowerSeries j) s))^[m] 0 := by
  induction m with
  | zero =>
    funext i
    simp only [Function.iterate_zero, id_eq]
    exact nilEval_zero_tuple ν _ (T.constantCoeff_eq_zero i)
  | succ m ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← ih]
    exact hom_nilEval_nilMul T J ν hJ _ s (iterate_nilMul_mem F J ν hJ s hs m) hs

variable {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of B)}

theorem theta_zero (L : RelativeGroupLaw B f) {g : ℕ} (F : MvFormalGroup g B)
    (θ : RelativeGroupLaw.FormalCoordinates f g) (hθ : L.IsFormalCoordinates F θ)
    (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥) :
    θ B' 0 = L.one (Scheme.specOver (𝒪 := B) B') := by
  obtain ⟨-, -, -, hhom⟩ := hθ.2 B' J ν hJ
  have h := hhom 0 0 (fun _ => by simp) (fun _ => by simp)
  rw [nilMul_zero_zero] at h
  have h' : L.mul _ (θ B' 0) (L.one _) = L.mul _ (θ B' 0) (θ B' 0) := by
    rw [L.mul_one]; exact h
  exact (mul_left_cancel L _ h').symm

theorem theta_iterate (L : RelativeGroupLaw B f) {g : ℕ} (F : MvFormalGroup g B)
    (θ : RelativeGroupLaw.FormalCoordinates f g) (hθ : L.IsFormalCoordinates F θ)
    (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (ν : ℕ) (hJ : J ^ (ν + 1) = ⊥)
    (s : Fin g → B') (hs : ∀ i, s i ∈ J) (m : ℕ) :
    θ B' ((fun t : Fin g → B' => F.nilMul ν t s)^[m] 0) = L.nsmul (Scheme.specOver (𝒪 := B) B') m (θ B' s) := by
  obtain ⟨-, -, -, hhom⟩ := hθ.2 B' J ν hJ
  induction m with
  | zero => rw [Function.iterate_zero, id_eq, RelativeGroupLaw.nsmul_zero]; exact theta_zero L F θ hθ B' J ν hJ
  | succ m ih =>
    rw [Function.iterate_succ_apply', RelativeGroupLaw.nsmul_succ,
      hhom _ s (iterate_nilMul_mem F J ν hJ s hs m) hs, ih]

end Formal

section Rigid

theorem hom_eq_of_comp_eq_of_isNilpotent_ker
    (B B₀ : Type) [CommRing B] [IsNoetherianRing B] [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of B)} {f' : A' ⟶ Spec (CommRingCat.of B)}
    (L : RelativeGroupLaw B f) (L' : RelativeGroupLaw B f')
    (hA : AbelianSchemePropertyBundle B f) (hA' : AbelianSchemePropertyBundle B f')
    {A₀ : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (g : A₀ ⟶ A)
    (hg : CategoryTheory.IsPullback g f₀ f (Spec.map (CommRingCat.ofHom (algebraMap B B₀))))
    (φ₁ φ₂ : A ⟶ A') (hg12 : g ≫ φ₁ = g ≫ φ₂)
    (hφ₁ : φ₁ ≫ f' = f) (hφ₂ : φ₂ ≫ f' = f)
    (hom₁ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      mapPt φ₁ hφ₁ (L.mul t P Q) = L'.mul t (mapPt φ₁ hφ₁ P) (mapPt φ₁ hφ₁ Q))
    (hom₂ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      mapPt φ₂ hφ₂ (L.mul t P Q) = L'.mul t (mapPt φ₂ hφ₂ P) (mapPt φ₂ hφ₂ Q)) :
    φ₁ = φ₂ := by
  refine GoodReductionJacobian.RelativeGroupLaw.eq_of_forall_comp_eq_of_isNilpotent_ker_of_isNoetherianRing
    (algebraMap B B₀) hπ hker L L' hA hA' φ₁ φ₂ hφ₁ hφ₂
    (fun t P Q => hom₁ t P Q) (fun t P Q => hom₂ t P Q) ?_
  intro T t P
  rw [← hg.lift_fst P.1 t P.2, Category.assoc, hg12, Category.assoc]

end Rigid

end GoodReductionJacobian.KBAux

theorem solution
    {q : ℕ} [Fact q.Prime]

    (B B₀ : Type) [CommRing B] [IsNoetherianRing B] [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (hq : IsNilpotent ((q : ℕ) : B))

    {A A' : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of B)) (f' : A' ⟶ Spec (CommRingCat.of B))
    (L : RelativeGroupLaw B f) (L' : RelativeGroupLaw B f') (hc : L.IsCommutative) (hc' : L'.IsCommutative)
    (hA : AbelianSchemePropertyBundle B f) (hA' : AbelianSchemePropertyBundle B f')

    (F F' : MvFormalGroup 2 B)
    (θ : RelativeGroupLaw.FormalCoordinates f 2) (θ' : RelativeGroupLaw.FormalCoordinates f' 2)
    (hθ : L.IsFormalCoordinates F θ) (hθ' : L'.IsFormalCoordinates F' θ')

    (hinf : ∀ (C : Type) [CommRing C] [Algebra B C] (m : ℕ) (P : SchemeHomOver (Scheme.specOver (𝒪 := B) C) f),
      nsmulPt L (Scheme.specOver (𝒪 := B) C) (q ^ m) P = L.one (Scheme.specOver (𝒪 := B) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ L.IsInfinitesimal J P)
    (hinf' : ∀ (C : Type) [CommRing C] [Algebra B C] (m : ℕ) (P : SchemeHomOver (Scheme.specOver (𝒪 := B) C) f'),
      nsmulPt L' (Scheme.specOver (𝒪 := B) C) (q ^ m) P = L'.one (Scheme.specOver (𝒪 := B) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ L'.IsInfinitesimal J P)

    {A₀ A₀' : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (f₀' : A₀' ⟶ Spec (CommRingCat.of B₀))
    (L₀ : RelativeGroupLaw B₀ f₀) (L₀' : RelativeGroupLaw B₀ f₀')
    (g : A₀ ⟶ A) (g' : A₀' ⟶ A')
    (hg : IsPullback g f₀ f (Spec.map (CommRingCat.ofHom (algebraMap B B₀))))
    (hg' : IsPullback g' f₀' f' (Spec.map (CommRingCat.ofHom (algebraMap B B₀))))
    (hgmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B₀)) (P Q : SchemeHomOver t f₀),
      (L₀.mul t P Q).1 ≫ g =
        (L.mul (t ≫ Spec.map (CommRingCat.ofHom (algebraMap B B₀)))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)
    (hg'mul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B₀)) (P Q : SchemeHomOver t f₀'),
      (L₀'.mul t P Q).1 ≫ g' =
        (L'.mul (t ≫ Spec.map (CommRingCat.ofHom (algebraMap B B₀)))
          ⟨P.1 ≫ g', by rw [Category.assoc, hg'.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g', by rw [Category.assoc, hg'.w, ← Category.assoc, Q.2]⟩).1)

    (φ₀ : A₀ ⟶ A₀') (hφ₀ : φ₀ ≫ f₀' = f₀)
    (φ₀_mul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B₀)) (P Q : SchemeHomOver t f₀),
      mapPt φ₀ hφ₀ (L₀.mul t P Q) = L₀'.mul t (mapPt φ₀ hφ₀ P) (mapPt φ₀ hφ₀ Q))

    (T : MvFormalGroup.Hom F F')
    (hTφ₀ : ∀ (B'' : Type) [CommRing B''] [Algebra B B''] [Algebra B₀ B''] [IsScalarTower B B₀ B'']
      (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ → ∀ (s : Fin 2 → B''), (∀ i, s i ∈ J) →
      ∀ p₀ : SchemeHomOver (Scheme.specOver (𝒪 := B₀) B'') f₀, p₀.1 ≫ g = (θ B'' s).1 →
        p₀.1 ≫ φ₀ ≫ g' = (θ' B'' (fun i => MvFormalGroup.nilEval n (T.toPowerSeries i) s)).1) :
    ∃! φ : A ⟶ A', g ≫ φ = φ₀ ≫ g' ∧
      ∃ hφ : φ ≫ f' = f,
        (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
          mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q)) ∧
        (∀ (B'' : Type) [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
          ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
            (θ B'' s).1 ≫ φ = (θ' B'' (fun i => MvFormalGroup.nilEval n (T.toPowerSeries i) s)).1) := by
  classical
  obtain ⟨μ₀, hμ₀⟩ := hker
  have hμ : RingHom.ker (algebraMap B B₀) ^ (μ₀ + 1) = ⊥ := by rw [pow_succ, hμ₀, zero_mul]; rfl
  obtain ⟨n, hn⟩ := hq

  obtain ⟨Ñ, hÑf, Ñmul, Ñred, Ñformal⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_hom_lift_nsmul_pow_of_isFormalCoordinates B B₀ hπ μ₀ hμ n hn f f' L L'
      hc hc' hA hA' F F' θ θ' hθ hθ' f₀ f₀' L₀ L₀' g g' hg hg' hgmul hg'mul φ₀ hφ₀ φ₀_mul T hTφ₀

  haveI hdim : SmoothOfRelativeDimension 2 f :=
    GoodReductionJacobian.RelativeGroupLaw.smoothOfRelativeDimension_of_isFormalCoordinates L hA F θ hθ
  have hNne : q ^ (n * μ₀) ≠ 0 := pow_ne_zero _ (Fact.out : q.Prime).ne_zero
  have hNpos : 0 < q ^ (n * μ₀) := pow_pos (Fact.out : q.Prime).pos _
  obtain ⟨hKfin, hKflat, hKlfp, hKrank, hNfin, hNflat, hNlfp, hNsurj⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.isFinite_flat_schemeKerStr_and_schemeNsmul_of_abelianSchemePropertyBundle
      L hc hA 2 (q ^ (n * μ₀)) hNne

  have hpN : L.schemeNsmul (q ^ (n * μ₀)) ≫ f = f := L.schemeNsmul_over _
  haveI : Flat (L.schemeNsmul (q ^ (n * μ₀))) := hNflat
  haveI : Surjective (L.schemeNsmul (q ^ (n * μ₀))) := hNsurj
  haveI : IsFinite (L.schemeNsmul (q ^ (n * μ₀))) := hNfin
  haveI : QuasiCompact (L.schemeNsmul (q ^ (n * μ₀))) := inferInstance
  have pN_pt : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P : SchemeHomOver t f),
      (⟨P.1 ≫ L.schemeNsmul (q ^ (n * μ₀)), by rw [Category.assoc, hpN]; exact P.2⟩ : SchemeHomOver t f) =
        L.nsmul t (q ^ (n * μ₀)) P := fun t P => KBAux.schemeNsmul_pt L _ t P _
  have pN_hom : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      (⟨(L.mul t P Q).1 ≫ L.schemeNsmul (q ^ (n * μ₀)), by rw [Category.assoc, hpN]; exact (L.mul t P Q).2⟩ :
          SchemeHomOver t f) =
        L.mul t ⟨P.1 ≫ L.schemeNsmul (q ^ (n * μ₀)), by rw [Category.assoc, hpN]; exact P.2⟩
          ⟨Q.1 ≫ L.schemeNsmul (q ^ (n * μ₀)), by rw [Category.assoc, hpN]; exact Q.2⟩ := by
    intro T t P Q
    rw [pN_pt t, pN_pt t P, pN_pt t Q]
    exact KBAux.nsmul_mul L hc t _ P Q

  obtain ⟨nN, hnN, -⟩ :=
    CerednikDrinfeld.QM.existsUnique_hom_isFormalCompletionAlong_of_isFormalCoordinates L L F F θ θ hθ hθ
      (L.schemeNsmul (q ^ (n * μ₀))) hpN
      (fun B' _ _ P Q => by
        rw [KBAux.mapPt_schemeNsmul, KBAux.mapPt_schemeNsmul, KBAux.mapPt_schemeNsmul]
        exact KBAux.nsmul_mul L hc _ _ P Q)
  have hnN_nsmul : ∀ (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (k : ℕ), J ^ (k + 1) = ⊥ →
      ∀ s : Fin 2 → B', (∀ i, s i ∈ J) →
        θ B' (fun i => MvFormalGroup.nilEval k (nN.toPowerSeries i) s) =
          L.nsmul (Scheme.specOver (𝒪 := B) B') (q ^ (n * μ₀)) (θ B' s) := by
    intro B' _ _ J k hJ s hs
    rw [hnN B' J k hJ s hs, KBAux.mapPt_schemeNsmul]
  have hnN_iter : ∀ (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (k : ℕ), J ^ (k + 1) = ⊥ →
      ∀ s : Fin 2 → B', (∀ i, s i ∈ J) →
        (fun i => MvFormalGroup.nilEval k (nN.toPowerSeries i) s) = (fun t : Fin 2 → B' => F.nilMul k t s)^[q ^ (n * μ₀)] 0 := by
    intro B' _ _ J k hJ s hs
    obtain ⟨-, hinj, -, -⟩ := hθ.2 B' J k hJ
    exact hinj _ _ (MvFormalGroup.nilEval_subst_of_mem J k hJ s hs nN.toPowerSeries nN.constantCoeff_eq_zero
        (nN.toPowerSeries 0)).1 (KBAux.iterate_nilMul_mem F J k hJ s hs _)
      (by rw [hnN_nsmul B' J k hJ s hs, KBAux.theta_iterate L F θ hθ B' J k hJ s hs])

  have hker_deg : FormalODModule.HasKernelOfDegree nN.toPowerSeries ((q ^ (n * μ₀)) ^ (2 * 2)) := by
    haveI := hKfin; haveI := hKflat; haveI := hKlfp
    exact CerednikDrinfeld.FormalODModule.hasKernelOfDegree_of_isFormalCoordinates_of_forall_isInfinitesimal L F θ hθ
      nN.toPowerSeries nN.constantCoeff_eq_zero (q ^ (n * μ₀)) hNpos
      (fun B' _ _ J k hJ s hs => hnN_nsmul B' J k hJ s hs) ((q ^ (n * μ₀)) ^ (2 * 2)) hKrank
      (fun B' _ _ P hP => hinf B' (n * μ₀) P (by rw [KBAux.nsmulPt_eq_nsmul]; exact hP))

  have hkill : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P : SchemeHomOver t f),
      L.nsmul t (q ^ (n * μ₀)) P = L.one t → mapPt Ñ hÑf P = L'.one t := by
    have affine_case : ∀ (C : Type) [CommRing C] [Algebra B C] (P : SchemeHomOver (Scheme.specOver (𝒪 := B) C) f),
        nsmulPt L (Scheme.specOver (𝒪 := B) C) (q ^ (n * μ₀)) P = L.one (Scheme.specOver (𝒪 := B) C) →
        mapPt Ñ hÑf P = L'.one (Scheme.specOver (𝒪 := B) C) := by
      intro C _ _ P hP
      obtain ⟨J, ⟨k, hk⟩, hPJ⟩ := hinf C (n * μ₀) P hP
      have hJ : J ^ (k + 1) = ⊥ := by rw [pow_succ, hk, zero_mul]; rfl
      obtain ⟨-, hinj, hsurj, -⟩ := hθ.2 C J k hJ
      obtain ⟨s, hs, rfl⟩ := hsurj P hPJ

      have h1 := Ñformal C J k hJ s hs
      have hTsJ : ∀ j, MvFormalGroup.nilEval k (T.toPowerSeries j) s ∈ J :=
        (MvFormalGroup.nilEval_subst_of_mem J k hJ s hs T.toPowerSeries T.constantCoeff_eq_zero (T.toPowerSeries 0)).1
      have hval : (fun i => MvFormalGroup.nilEval k
            (MvPowerSeries.subst T.toPowerSeries (F'.nthSeries (q ^ (n * μ₀)) i)) s) =
          fun i => MvFormalGroup.nilEval k (T.toPowerSeries i) ((fun t : Fin 2 → C => F.nilMul k t s)^[q ^ (n * μ₀)] 0) := by
        funext i
        rw [(MvFormalGroup.nilEval_subst_of_mem J k hJ s hs T.toPowerSeries T.constantCoeff_eq_zero
            (F'.nthSeries (q ^ (n * μ₀)) i)).2,
          MvFormalGroup.nilEval_nthSeries_eq_iterate_nilMul F' J k hJ _ hTsJ (q ^ (n * μ₀)) i,
          ← KBAux.hom_nilEval_iterate T J k hJ s hs (q ^ (n * μ₀))]

      have hw0 : (fun t : Fin 2 → C => F.nilMul k t s)^[q ^ (n * μ₀)] 0 = 0 :=
        hinj _ 0 (KBAux.iterate_nilMul_mem F J k hJ s hs _) (fun _ => by simp)
          (by rw [KBAux.theta_iterate L F θ hθ C J k hJ s hs, ← KBAux.nsmulPt_eq_nsmul, hP,
                KBAux.theta_zero L F θ hθ C J k hJ])
      have hT0 : (fun i => MvFormalGroup.nilEval k (T.toPowerSeries i)
          ((fun t : Fin 2 → C => F.nilMul k t s)^[q ^ (n * μ₀)] 0)) = 0 := by
        funext i; rw [hw0]; exact KBAux.nilEval_zero_tuple k _ (T.constantCoeff_eq_zero i)
      apply Subtype.ext
      rw [mapPt_coe, h1, hval, hT0, KBAux.theta_zero L' F' θ' hθ' C J k hJ]

    intro T t P hP
    apply Subtype.ext
    refine T.affineCover.hom_ext _ _ fun j => ?_
    let U := T.affineCover.X j
    let ι : U ⟶ T := T.affineCover.f j
    let R : CommRingCat := Γ(U, ⊤)
    let e : U ≅ Spec R := U.isoSpec
    let ρ : CommRingCat.of B ⟶ R := Spec.preimage (e.inv ≫ ι ≫ t)
    letI : Algebra B R := ρ.hom.toAlgebra
    have hspec : Scheme.specOver (𝒪 := B) (R : Type) = e.inv ≫ ι ≫ t := by
      show Spec.map (CommRingCat.ofHom (algebraMap B R)) = _
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    have hψ : (e.inv ≫ ι) ≫ t = Scheme.specOver (𝒪 := B) (R : Type) := by rw [hspec, Category.assoc]
    let Pj : SchemeHomOver (Scheme.specOver (𝒪 := B) (R : Type)) f := schemeHomOverComp (e.inv ≫ ι) hψ P
    have hPj : nsmulPt L (Scheme.specOver (𝒪 := B) (R : Type)) (q ^ (n * μ₀)) Pj = L.one _ := by
      rw [KBAux.nsmulPt_eq_nsmul]
      show L.nsmul _ (q ^ (n * μ₀)) (schemeHomOverComp (e.inv ≫ ι) hψ P) = L.one _
      rw [← L.nsmul_natural t _ (e.inv ≫ ι) hψ, hP, L.one_natural t _ (e.inv ≫ ι) hψ]
    have key := congrArg Subtype.val (affine_case R Pj hPj)
    rw [← L'.one_natural t _ (e.inv ≫ ι) hψ] at key
    simp only [Pj, mapPt_coe, schemeHomOverComp_coe, Category.assoc] at key
    rw [cancel_epi] at key
    simpa only [mapPt_coe] using key

