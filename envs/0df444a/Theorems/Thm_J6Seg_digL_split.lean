theorem J6Seg.digL_split : ∀ (i : ℕ) (dims : List ℕ), (∀ u ∈ dims, 0 < u) → i < dims.length →
    ∀ b a c, b < (dims.take i).prod → a < dims.getD i 1 → c < (dims.drop (i + 1)).prod →
    ∀ m, digL dims (b * (dims.getD i 1 * (dims.drop (i + 1)).prod) +
        a * (dims.drop (i + 1)).prod + c) m =
      if m < i then digL (dims.take i) b m else if m = i then a
      else digL (dims.drop (i + 1)) c (m - i - 1) := by sorry
