    mul_phase6 C t hR (val x) (val y) hx hy hA' h0 hW
  have hB2' : 2 * (2 : ℝ) ^ (2 * Q.b + 4) * (∏ i, (Q.sB D i : ℝ)) ^ 2 * (3 * Q.Es + 2) *
      hp Q.p < 1 := by
    have e : (∏ i, (Q.sB D i : ℝ)) = (Q.S : ℝ) := by rw [C.hS]; push_cast; rfl
    rw [e]; exact hQ.hB2
  obtain ⟨-, -, hcl⟩ := final_call3 Q.p Q.b (Q.sB D) (Q.tB D) (hQ.cop_st C.hD) Q.Es hQ.hEs hB2'
    (norm_dgt_le Q.b Q.M (val x) _) (norm_dgt_le Q.b Q.M (val y) _) eX eY eZ
  set t2 := ((t.upd ARGM []).upd pW []).upd 0 (ints (gflat zsZ)) with ht2
  have hR2 : Q.Base t2 :=
    BaseOK6.upd (BaseOK6.upd (BaseOK6.upd hR ARGM (by decide) _) pW (by decide) _) 0
      (by decide) _
  obtain ⟨s', c2, r2, hout2, k2⟩ := fin_phase6 C t2 hR2 (val x) (val y) hx hy zsZ Z
    (by simp [t2]) hZ gZ hcl (by simp [t2, hout])
  refine ⟨s', _, r0'.seq (r1.seq r2), hout2, ?_⟩
  push_cast
  linarith

end

