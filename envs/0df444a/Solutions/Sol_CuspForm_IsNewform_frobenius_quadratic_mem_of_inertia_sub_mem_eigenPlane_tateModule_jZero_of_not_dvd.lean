  intro _inst _hsmul ρM _hρ _hcont TM _hT W _hrank hW _hHecke _htrace _hTlam A hA L hLI σ hσ w hw
  letI : Module HeckeAlg (JZero M) := ModularCurve.heckeModuleBar M

