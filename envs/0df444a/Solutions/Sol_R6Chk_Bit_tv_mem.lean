/-! ## Bit helpers -/

theorem mem_F {m : ℕ} {p : Fin 23} : p ∈ F m ↔ m.testBit p = true := by simp [F]

/-! ## Table facts -/

/-! ## Mask semantics -/

/-! ## The rational span and the upper bound -/

theorem vM_bit {p : ℕ} : ∀ {L : List (ℕ × ℕ × ℕ)}, (vM L).testBit p = true ↔ ∃ e ∈ L, (cm e).testBit p = true
  | [] => by simp [vM]
  | e :: L => by
    rw [vM, Nat.testBit_lor, Bool.or_eq_true, vM_bit]
    simp

theorem sumOn_tv (m i : ℕ) : sumOn m (tvQ i) = ((F m ∩ F (tri i)).card : ℚ) := by
  simp only [sumOn, tvQ]
  rw [Finset.sum_boole]
  congr 2
  ext p; simp [F]

theorem F_cm (e : ℕ × ℕ × ℕ) : F (cm e) = F e.1 ∪ F e.2.1 := by
  ext p; simp [F, cm]

theorem F_bit {c : ℕ} (hc : c < 23) : F (2 ^ c) = {⟨c, hc⟩} := by
  ext p; simp only [F, Finset.mem_filter, Finset.mem_univ, true_and, Nat.testBit_two_pow,
    decide_eq_true_eq, Finset.mem_singleton]
  exact ⟨fun h => Fin.ext h.symm, fun h => by rw [h]⟩

theorem F_and (a b : ℕ) : F (a &&& b) = F a ∩ F b := by
  ext p; simp [F, Nat.testBit_and]

theorem F_zero : F 0 = ∅ := by ext p; simp [F]

theorem disj_F {a b : ℕ} (h : a &&& b = 0) : Disjoint (F a) (F b) := by
  rw [Finset.disjoint_iff_inter_eq_empty, ← F_and, h, F_zero]

/-- **Generators lie in `Wp`.** -/
theorem tv_mem_sol_aux {c Q : ℕ} (hc : c < 23) {L : List (ℕ × ℕ × ℕ)} (hpw : L.Pairwise DisjC)
    (hcf : ∀ e ∈ L, CompFacts c Q e) {i : ℕ} (hi : i < 1771) (hci : (tri i).testBit c = true)
    {e : ℕ × ℕ × ℕ} (he : e ∈ L) (ha : CompAllows c e i) : tvQ i ∈ Wp c L := by
  set c' : Fin 23 := ⟨c, hc⟩
  set T := F (tri i)
  have hT : T.card = 3 := (tri_spec hi).2
  have hcT : c' ∈ T := mem_F.2 hci
  have hcv : ∀ e' ∈ L, c' ∉ F (cm e') := by
    intro e' he' h
    rw [F_cm, Finset.mem_union, mem_F, mem_F] at h
    have := hcf e' he'
    rcases h with h | h
    · rw [this.cX] at h; exact Bool.false_ne_true h
    · rw [this.cY] at h; exact Bool.false_ne_true h
  -- the triple without its centre lies in the component `e`
  have hsub : ∀ p ∈ T, p ≠ c' → p ∈ F (cm e) := by
    intro p hp hpc
    rw [F_cm, Finset.mem_union, mem_F, mem_F]
    have hp' := mem_F.1 hp
    have hpc' : (p : ℕ) ≠ c := fun h => hpc (Fin.ext h)
    unfold CompAllows at ha
    split_ifs at ha with hy
    · exact Or.inl ((ha p p.2 hp').resolve_right hpc')
    · rcases ha.2.2 p p.2 hp' with h | h | h
      · exact Or.inl h
      · exact Or.inr h
      · exact absurd h hpc'
  have hdis : ∀ e' ∈ L, e' ≠ e → Disjoint (F (cm e')) (F (cm e)) := by
    intro e' he' hne
    exact disj_F (hpw.forall he' he hne)
  have hTc : (T.erase c').card = 2 := by rw [Finset.card_erase_of_mem hcT, hT]
  refine ⟨?_, ?_, ?_⟩
  · intro p hpv hpc
    simp only [tvQ]
    rw [if_neg]
    intro ht
    have := hsub p (mem_F.2 ht) (fun h => hpc (by rw [h]))
    have hv : (vM L).testBit p = true := vM_bit.2 ⟨e, he, mem_F.1 this⟩
    rw [hpv] at hv; exact Bool.false_ne_true hv
  · intro e' he' hy'
    rw [sumOn_tv, sumOn_tv]
    by_cases hee : e' = e
    · subst hee
      unfold CompAllows at ha
      rw [if_neg hy'] at ha
      obtain ⟨⟨px, hpx, hx1, hx2⟩, ⟨py, hpy, hy1, hy2⟩, -⟩ := ha
      have hXY := disj_F (hcf e' he').XY
      -- `T \ {c'}` is the disjoint union of its parts in `X` and `Y`
      have hsplit : T.erase c' = (F e'.1 ∩ T) ∪ (F e'.2.1 ∩ T) := by
        ext p
        simp only [Finset.mem_erase, Finset.mem_union, Finset.mem_inter]
        constructor
        · rintro ⟨hpc, hp⟩
          have := hsub p hp hpc
          rw [F_cm, Finset.mem_union] at this
          tauto
        · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)
          · refine ⟨fun h => hcv e' he' ?_, h2⟩
            rw [← h, F_cm]; exact Finset.mem_union_left _ h1
          · refine ⟨fun h => hcv e' he' ?_, h2⟩
            rw [← h, F_cm]; exact Finset.mem_union_right _ h1
      have hcard := Finset.card_union_of_disjoint (s := F e'.1 ∩ T) (t := F e'.2.1 ∩ T)
        (Finset.disjoint_of_subset_left Finset.inter_subset_left
          (Finset.disjoint_of_subset_right Finset.inter_subset_left hXY))
      rw [← hsplit, hTc] at hcard
      have h1 : 0 < (F e'.1 ∩ T).card :=
        Finset.card_pos.2 ⟨⟨px, hpx⟩, Finset.mem_inter.2 ⟨mem_F.2 hx1, mem_F.2 hx2⟩⟩
      have h2 : 0 < (F e'.2.1 ∩ T).card :=
        Finset.card_pos.2 ⟨⟨py, hpy⟩, Finset.mem_inter.2 ⟨mem_F.2 hy1, mem_F.2 hy2⟩⟩
      have : (F e'.1 ∩ T).card = (F e'.2.1 ∩ T).card := by omega
      rw [this]
    · have z : ∀ m, F m ⊆ F (cm e') → (F m ∩ T).card = 0 := by
        intro m hm
        rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
        intro p hp
        rw [Finset.mem_inter] at hp
        by_cases hpc : p = c'
        · exact hcv e' he' (hpc ▸ hm hp.1)
        · exact Finset.disjoint_left.1 (hdis e' he' hee) (hm hp.1) (hsub p hp.2 hpc)
      rw [z _ (by rw [F_cm]; exact Finset.subset_union_left),
        z _ (by rw [F_cm]; exact Finset.subset_union_right)]
  · rw [sumOn_tv, sumOn_tv, F_bit hc]
    have h1 : F (vM L) ∩ T = T.erase c' := by
      ext p
      simp only [Finset.mem_inter, Finset.mem_erase, mem_F]
      constructor
      · rintro ⟨hv, hp⟩
        refine ⟨fun h => ?_, hp⟩
        obtain ⟨e', he', h'⟩ := vM_bit.1 hv
        exact hcv e' he' (h ▸ mem_F.2 h')
      · rintro ⟨hpc, hp⟩
        exact ⟨vM_bit.2 ⟨e, he, mem_F.1 (hsub p hp hpc)⟩, hp⟩
    have h2 : ({c'} : Finset (Fin 23)) ∩ T = {c'} := by
      rw [Finset.inter_eq_left, Finset.singleton_subset_iff]; exact hcT
    rw [h1, h2, hTc, Finset.card_singleton]
    norm_num

