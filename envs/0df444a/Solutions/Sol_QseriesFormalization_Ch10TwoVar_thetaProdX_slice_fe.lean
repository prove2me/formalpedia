        = (6 * Tn n2 + 3 * Tn n1) + (6 * m + 3) := by
      rw [Tn_add_one, Tn_add_two]; rw [← hxd]; ring
    have hsign : ((-1 : ℚ)) ^ ((n2 + 1) + (n1 + 2)) = - (-1) ^ (n2 + n1) := by
      rw [show (n2 + 1) + (n1 + 2) = (n2 + n1) + 3 by ring,
