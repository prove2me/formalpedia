          linear_combination β * hsum - hβeq
        rw [← this]
        exact hβunit.mul (RingHom.isUnit_map (algebraMap O' O'') hα₀unit)
      exact (IsLocalRing.mem_maximalIdeal _).mp hlamO'' hlamunit
    intro v
    rw [← hβα]
    exact hβv v

