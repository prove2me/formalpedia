theorem dyadicQuery_value {p : ℕ} (a b : Fin p → ℤ) (v : Fin p → ℝ) (k : ℕ) (n : ℤ) :
    formValue (dyadicQuery a b k n) v = (2 : ℝ) ^ k * formValue a v - n * formValue b v := by
