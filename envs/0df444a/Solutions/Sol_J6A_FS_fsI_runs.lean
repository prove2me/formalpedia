section dupdrop
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem IRuns.dupK (s : IState HS) {G : Fin HS → List ℤ} {i j : Fin HS} (hij : i ≠ j) {a : ℤ}
    {l : List ℤ} (hi : G i = a :: l) :
    IRuns I iprog (.op (.dup i j)) (encK s G) (encK s (update G j (a :: G j)))
      (dupCost (zsz a) + 17) := by
  have h := IRuns.dup (I := I) (iprog := iprog) (s := encK s G) (i := i) (j := j) hij
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [← encK_upd]; simp [ints]

theorem IRuns.dropK (s : IState HS) {G : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (hi : G i = a :: l) :
    IRuns I iprog (.op (.drop i)) (encK s G) (encK s (update G i l)) (2 * zsz a + 2) := by
  have h := IRuns.drop (I := I) (iprog := iprog) (s := encK s G) (i := i)
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [← encK_upd]

end dupdrop

