/-! ## Formal execution -/

section FormalRun

variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {U : Type*}
  (N : ℕ)

/-- **Label-consistent segments.** If the gates of `prog` touch equal labels (from `L`), formal
values `L_w · φ_w` evolve as `L'_w · ψ_w`, with `L'` the tracked labels and `ψ` the module-valued
scalar circuit applied to `φ`. -/
theorem formal_labels_sol_aux : ∀ (prog : List (Instr Wr R m)) (L : Wr → FMat m N) (φ : Wr → FV R U m N),
    LabGates N prog L →
      prog.foldl (fStep N) (fun w => lmulF (L w) (φ w)) =
        fun w => lmulF (prog.foldl (labStepH N) L w) (prog.foldl scalarStepM φ w) := by
  intro prog
  induction prog with
  | nil => intro L φ _; rfl
  | cons i l ih =>
    intro L φ hlab
    simp only [List.foldl_cons]
    rw [← ih _ _ hlab.2]
    congr 1
    funext w
    cases i with
    | gate g S =>
      have hS := hlab.1
      simp only [fStep, scalarStepM, labStepH, gateVecM]
      split_ifs with hw
      · rw [map_sum]
        refine Finset.sum_congr rfl fun w' hw' => ?_
        rw [map_smul, hS w hw w' hw']
      · rfl
    | edge w0 e =>
      simp only [fStep, scalarStepM, labStepH]
      by_cases h : w = w0
      · subst h; simp [lmulF_mul]
      · rw [Function.update_of_ne h, Function.update_of_ne h]

end FormalRun

