    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    obtain ⟨i6, i7, i8, i29⟩ := hi
    simp only [czI, runL, Ins.run, update_apply, i6, i7, i8, i29, if_false]

/-- **Border push.** -/
theorem Rn.czTs (hF : Fx Q kk m mw cB u) (hB : BdS W m L Mf) (hv : BV W u) {r q n : ℕ}
