-- title:
--   (17) — ratio inequality of e-PSG for every Young parameter ω > 0
-- statement:
--   Let $S\subseteq\mathbb R^N$ be closed and convex, suppose Assumptions 1 and 2 hold, let $\delta,\zeta>0$, and let $(x_n)$ be generated by Algorithm 1 with step sizes $\tau_n$ and extrapolation weights $\kappa_n,\mu_n$. Then for every $\omega>0$ and every $n\in\mathbb N$,
--   $$\frac{f(x_n)}{g(x_n)}+\frac1{2g(x_{n+1})}\Big(\ell\kappa_n^2+\frac{\omega\mu_n}{\tau_n}\Big)\|x_n-x_{n-1}\|^2\ \ge\ \frac{f(x_{n+1})}{g(x_{n+1})}+\frac1{2g(x_{n+1})}\Big(\frac{1-\sqrt\beta\,\zeta}{\tau_n}-\frac{\mu_n}{\omega\tau_n}\Big)\|x_{n+1}-x_n\|^2.$$
--
--   The two regimes of Theorem 4.5(i), with and without the boundedness condition (BC), are obtained from this inequality by specific choices of $\omega$ and by bounding $g(x_{n+1})$.
--
--   **Formalization Note** The ratios are real numbers `(f x).toReal / g x`; all iterates lie in $S\cap\operatorname{dom} f$. $x_{-1}=x_0$.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 11, inequality (17) in the proof of Theorem 4.5

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Subseq_Basic
import Definitions.Def_FracPSG_Subseq_EPSG

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Subseq

open NonconvexSplitting.Shared

/-- Inequality (17) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 11, proof of Theorem 4.5): for every run of
Algorithm 1 under Assumptions 1 and 2, every `ω > 0` and every `n`,
`f(xₙ)/g(xₙ) + (1/(2g(xₙ₊₁)))(ℓκₙ² + ωμₙ/τₙ)‖xₙ − xₙ₋₁‖² ≥
 f(xₙ₊₁)/g(xₙ₊₁) + (1/(2g(xₙ₊₁)))((1 − √β ζ)/τₙ − μₙ/(ωτₙ))‖xₙ₊₁ − xₙ‖²`. -/
theorem eq_17
    {N : ℕ} {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {g : EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ μbar κbar : ℝ}
    {x gs : ℕ → EuclideanSpace ℝ (Fin N)} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : Assumption1 S fs fn ℓ) (hA2 : Assumption2 S g β)
    (hδ : 0 < δ) (hζ : 0 < ζ)
    (hrun : IsEPSGRun S fs fn g ℓ β δ ζ μbar κbar x gs τ κ μ)
    (ω : ℝ) (hω : 0 < ω) (n : ℕ) :
    ratio (objF fs fn) g (x (n + 1)) +
        1 / (2 * g (x (n + 1))) * ((1 - Real.sqrt β * ζ) / τ n - μ n / (ω * τ n)) *
          ‖x (n + 1) - x n‖ ^ 2 ≤
      ratio (objF fs fn) g (x n) +
        1 / (2 * g (x (n + 1))) * (ℓ * κ n ^ 2 + ω * μ n / τ n) * ‖x n - xPrev x n‖ ^ 2 := by sorry

end FracPSG.Subseq
