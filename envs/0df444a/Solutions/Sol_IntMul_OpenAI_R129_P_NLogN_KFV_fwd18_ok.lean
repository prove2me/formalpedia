  simp only [bitU, jU, Ex.Bnd, Ex.eval, hj, hjj, hk, Int.toNat_natCast]
  refine ⟨⟨⟨NLogN.KFV.zB (by omega), NLogN.KFV.zB (by simp; omega), NLogN.KFV.zB (by simp; omega)⟩,
    ⟨NLogN.KFV.zB (by simpa using hkk), by omega⟩, ?_⟩, NLogN.KFV.zB (by simp; omega), ?_⟩
  · rw [hdiv]
    exact NLogN.KFV.zB (by simp only [Int.natAbs_natCast]; exact (Nat.div_le_self _ _).trans (by omega))
  · rw [hbit]
    exact NLogN.KFV.zB (by simp only [Int.natAbs_natCast]; have := bt_le k j; omega)

end Eval

theorem tv_eq_sum (T : List (ℕ × ℕ × ℕ)) (j : ℕ) : tv T j = (T.map (tmv j)).sum := rfl

theorem inSt_tbJ (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (Q j k : ℕ) (x : Fin HS)
    (h : x ∉ [tbC, tbK, tbL, tbC2, tbK2, tbL2, tbA]) : inSt g T Q j k x = g x := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at h
  obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := h
  simp [inSt, Function.update_apply, h1, h2, h3, h4, h5, h6, h7]

set_option maxHeartbeats 1000000 in
theorem inB_fsp (s : IState HS) (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) {Q j k U : ℕ}
    (hk : k < T.length) {LQ LJ : List Item}
    (hsQ : (NLogN.KIL.encK s g).G tbQ = .int (Q : ℤ) :: LQ) (hsJ : (NLogN.KIL.encK s g).G tbJ = .int ((j : ℤ) + 1) :: LJ)
    (hgT : g tbT = []) (hQ : 0 < Q) (hjU : j + 1 ≤ U) (h2U : 2 ≤ U) (hQU : Q ≤ U)
    (hT : ∀ t ∈ T, t.1 + Q ≤ U ∧ 2 ^ t.2.1 ≤ U ∧ 2 ^ t.2.2 ≤ U) :
    FSp inB (NLogN.KIL.encK s (inSt g T Q j k)) (NLogN.KIL.encK s (inSt g T Q j (k + 1))) (cInB (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  set t := T[k]
  obtain ⟨ht1, ht2, ht3⟩ := hT t (List.getElem_mem hk)
  have hd : T.drop k = t :: T.drop (k + 1) := List.drop_eq_getElem_cons hk
  have htk : T.take (k + 1) = T.take k ++ [t] := List.take_succ_eq_append_getElem hk
  set acc := ((T.take k).map (tmv j)).sum % Q with hacc
  have haccQ : acc < Q := Nat.mod_lt _ hQ
  set g0 := inSt g T Q j k
  have e0J : (NLogN.KIL.encK s g0).G tbJ = .int ((j : ℤ) + 1) :: LJ := by
    rw [encK_G] at hsJ ⊢; rw [show g0 tbJ = g tbJ from inSt_tbJ g T Q j k tbJ (by decide)]; exact hsJ
  have e0Q : (NLogN.KIL.encK s g0).G tbQ = .int (Q : ℤ) :: LQ := by
    rw [encK_G] at hsQ ⊢; rw [show g0 tbQ = g tbQ from inSt_tbJ g T Q j k tbQ (by decide)]; exact hsQ
  have g0C : g0 tbC = (t.1 : ℤ) :: (T.drop (k + 1)).map fun t => (t.1 : ℤ) := by
    simp +decide [g0, inSt, hd]
  have g0K : g0 tbK = (t.2.1 : ℤ) :: (T.drop (k + 1)).map fun t => (t.2.1 : ℤ) := by
    simp +decide [g0, inSt, hd]
  have g0L : g0 tbL = (t.2.2 : ℤ) :: (T.drop (k + 1)).map fun t => (t.2.2 : ℤ) := by
    simp +decide [g0, inSt, hd]
  have g0A : g0 tbA = [(acc : ℤ)] := by simp +decide [g0, inSt, acc]
  have g0T : g0 tbT = [] := by rw [show g0 tbT = g tbT from inSt_tbJ g T Q j k tbT (by decide)]; exact hgT
  have tJ := IState.top_eq e0J
  have tC : (NLogN.KIL.encK s g0).top tbC = (t.1 : ℤ) := top_encK g0C
  have tK : (NLogN.KIL.encK s g0).top tbK = (t.2.1 : ℤ) := top_encK g0K
  have tL : (NLogN.KIL.encK s g0).top tbL = (t.2.2 : ℤ) := top_encK g0L
  have zU : ∀ x : ℕ, x ≤ U → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zB (by simpa using hx)
  have hb1 := bt_le t.2.1 j
  have hb2 := bt_le t.2.2 j
  have hm1 : t.1 * NLogN.KFV.bt t.2.1 j ≤ t.1 := by nlinarith
  have hm2 : tmv j t ≤ t.1 := by unfold tmv; nlinarith
  -- 1. the term
  have S1 := Sp.pushQ s g0 (i := tbT) (e := trmU) (B := B) (by decide) (clean_lo (by decide))
    ⟨⟨isInt_encK g0C, bitU_ok tbK tJ (IState.isInt_of e0J) tK (isInt_encK g0K)⟩,
      bitU_ok tbL tJ (IState.isInt_of e0J) tL (isInt_encK g0L)⟩
    ⟨⟨by simp only [Ex.Bnd, tC]; exact zU _ (by omega),
        bitU_bnd tbK tJ tK hjU h2U ht2, by
          simp only [Ex.eval, tC, bitU_eval tbK tJ tK]
          exact NLogN.KFV.zB (by simp only [Int.natAbs_mul, Int.natAbs_natCast]; omega)⟩,
      bitU_bnd tbL tJ tL hjU h2U ht3, by
        simp only [trmU, Ex.eval, tC, bitU_eval tbK tJ tK, bitU_eval tbL tJ tL]
        exact NLogN.KFV.zB (by simp only [Int.natAbs_mul, Int.natAbs_natCast]; unfold tmv at hm2; omega)⟩
  have v1 : trmU.eval (NLogN.KIL.encK s g0) = (tmv j t : ℤ) := by
    simp only [trmU, Ex.eval, tC, bitU_eval tbK tJ tK, bitU_eval tbL tJ tL, tmv]; push_cast; ring
  rw [v1, g0T] at S1
  set g1 := Function.update g0 tbT [(tmv j t : ℤ)]
  have e1Q : (NLogN.KIL.encK s g1).G tbQ = .int (Q : ℤ) :: LQ := by
    rw [encK_G] at e0Q ⊢; rw [show g1 tbQ = g0 tbQ by simp +decide [g1]]; exact e0Q
  have t1A : (NLogN.KIL.encK s g1).top tbA = (acc : ℤ) := top_encK (l := []) (by simp +decide [g1, g0A])
  have t1T : (NLogN.KIL.encK s g1).top tbT = (tmv j t : ℤ) := top_encK (l := []) (by simp [g1])
  have t1Q := IState.top_eq e1Q
  -- 2. the new accumulator
  have hnew : ((acc : ℤ) + (tmv j t : ℤ)) % (Q : ℤ) = (((T.take (k + 1)).map (tmv j)).sum % Q : ℕ) := by
    rw [htk, List.map_append, List.sum_append]; simp only [List.map_cons, List.map_nil,
      List.sum_cons, List.sum_nil, add_zero]
    rw [hacc]; push_cast
    rw [Int.emod_add_emod]
  have S2 := Sp.pushQ s g1 (i := tbT) (e := accU) (B := B) (by decide) (clean_lo (by decide))
    ⟨⟨isInt_encK (l := []) (a := (acc : ℤ)) (by simp +decide [g1, g0A]),
      isInt_encK (l := []) (a := (tmv j t : ℤ)) (by simp [g1])⟩, IState.isInt_of e1Q,
      by simp only [Ex.eval, t1A, t1T]; positivity, by simp only [Ex.eval, t1Q]; exact_mod_cast hQ⟩
    ⟨⟨by simp only [Ex.Bnd, t1A]; exact zU _ (by omega), by simp only [Ex.Bnd, t1T]; exact zU _ (by omega),
        by simp only [Ex.eval, t1A, t1T]; exact NLogN.KFV.zB (by push_cast; omega)⟩,
      by simp only [Ex.Bnd, t1Q]; exact zU _ hQU, by
        simp only [Ex.eval, t1A, t1T, t1Q]
        have hQ' : (0 : ℤ) < Q := by exact_mod_cast hQ
        have h0 := Int.emod_nonneg ((acc : ℤ) + (tmv j t : ℤ)) hQ'.ne'
        have h1 := Int.emod_lt_of_pos ((acc : ℤ) + (tmv j t : ℤ)) hQ'
        exact NLogN.KFV.zB (by omega)⟩
  have v2 : accU.eval (NLogN.KIL.encK s g1) = (((T.take (k + 1)).map (tmv j)).sum % Q : ℕ) := by
    simp only [accU, Ex.eval, t1A, t1T, t1Q]; exact hnew
  rw [v2] at S2
  set nacc : ℤ := ((((T.take (k + 1)).map (tmv j)).sum % Q : ℕ) : ℤ)
  set g2 := Function.update g1 tbT (nacc :: g1 tbT)
  have g2T : g2 tbT = [nacc, (tmv j t : ℤ)] := by simp [g2, g1]
  -- 3. the assignment and the pops
  have S3 := Sp.asg s g2 (i := tbA) (e := .reg tbT) (a := (acc : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [g2, g1, g0A]) (zU _ (by omega)) (clean_reg (by decide))
    (isInt_encK g2T) trivial (by simp only [Ex.Bnd]; rw [top_encK g2T]; exact NLogN.KFV.zB (by
      simp only [nacc, Int.natAbs_natCast]; have := Nat.mod_lt (((T.take (k + 1)).map (tmv j)).sum) hQ; omega))
  rw [show Ex.eval (NLogN.KIL.encK s g2) (.reg tbT) = nacc by simp only [Ex.eval]; rw [top_encK g2T]] at S3
  set g3 := Function.update g2 tbA [nacc]
  have S4 := Sp.pop (s := s) (f := g3) (i := tbT) (a := nacc) (l := [(tmv j t : ℤ)]) (B := B)
    (by decide) (by simp +decide [g3, g2T]) (NLogN.KFV.zB (by
      simp only [nacc, Int.natAbs_natCast]; have := Nat.mod_lt (((T.take (k + 1)).map (tmv j)).sum) hQ; omega))
  set g4 := Function.update g3 tbT [(tmv j t : ℤ)]
  have S5 := Sp.pop (s := s) (f := g4) (i := tbT) (a := (tmv j t : ℤ)) (l := []) (B := B)
    (by decide) (by simp [g4]) (zU _ (by omega))
  set g5 := Function.update g4 tbT []
  -- 4. moving the term aside
  have g5C : g5 tbC = (t.1 : ℤ) :: (T.drop (k + 1)).map fun t => (t.1 : ℤ) := by
    simp +decide [g5, g4, g3, g2, g1, g0C]
  have S6 := Sp.push s g5 (i := tbC2) (e := .reg tbC) (B := B) (by decide) (clean_reg (by decide))
    (isInt_encK g5C) trivial (by simp only [Ex.Bnd]; rw [top_encK g5C]; exact zU _ (by omega))
  rw [show Ex.eval (NLogN.KIL.encK s g5) (.reg tbC) = (t.1 : ℤ) by simp only [Ex.eval]; rw [top_encK g5C]] at S6
  set g6 := Function.update g5 tbC2 ((t.1 : ℤ) :: g5 tbC2)
  have S7 := Sp.pop (s := s) (f := g6) (i := tbC) (a := (t.1 : ℤ))
    (l := (T.drop (k + 1)).map fun t => (t.1 : ℤ)) (B := B) (by decide)
    (by simp +decide [g6, g5C]) (zU _ (by omega))
  set g7 := Function.update g6 tbC ((T.drop (k + 1)).map fun t => (t.1 : ℤ))
  have g7K : g7 tbK = (t.2.1 : ℤ) :: (T.drop (k + 1)).map fun t => (t.2.1 : ℤ) := by
    simp +decide [g7, g6, g5, g4, g3, g2, g1, g0K]
  have hk1 : t.2.1 ≤ U := le_trans (Nat.lt_two_pow_self).le ht2
  have hk2 : t.2.2 ≤ U := le_trans (Nat.lt_two_pow_self).le ht3
  have S8 := Sp.push s g7 (i := tbK2) (e := .reg tbK) (B := B) (by decide) (clean_reg (by decide))
    (isInt_encK g7K) trivial (by simp only [Ex.Bnd]; rw [top_encK g7K]; exact zU _ hk1)
  rw [show Ex.eval (NLogN.KIL.encK s g7) (.reg tbK) = (t.2.1 : ℤ) by simp only [Ex.eval]; rw [top_encK g7K]] at S8
  set g8 := Function.update g7 tbK2 ((t.2.1 : ℤ) :: g7 tbK2)
  have S9 := Sp.pop (s := s) (f := g8) (i := tbK) (a := (t.2.1 : ℤ))
    (l := (T.drop (k + 1)).map fun t => (t.2.1 : ℤ)) (B := B) (by decide)
    (by simp +decide [g8, g7K]) (zU _ hk1)
  set g9 := Function.update g8 tbK ((T.drop (k + 1)).map fun t => (t.2.1 : ℤ))
  have g9L : g9 tbL = (t.2.2 : ℤ) :: (T.drop (k + 1)).map fun t => (t.2.2 : ℤ) := by
    simp +decide [g9, g8, g7, g6, g5, g4, g3, g2, g1, g0L]
  have S10 := Sp.push s g9 (i := tbL2) (e := .reg tbL) (B := B) (by decide) (clean_reg (by decide))
    (isInt_encK g9L) trivial (by simp only [Ex.Bnd]; rw [top_encK g9L]; exact zU _ hk2)
  rw [show Ex.eval (NLogN.KIL.encK s g9) (.reg tbL) = (t.2.2 : ℤ) by simp only [Ex.eval]; rw [top_encK g9L]] at S10
  set g10 := Function.update g9 tbL2 ((t.2.2 : ℤ) :: g9 tbL2)
  have S11 := Sp.pop (s := s) (f := g10) (i := tbL) (a := (t.2.2 : ℤ))
    (l := (T.drop (k + 1)).map fun t => (t.2.2 : ℤ)) (B := B) (by decide)
    (by simp +decide [g10, g9L]) (zU _ hk2)
  have S := FSp.of_norep (p := inB) rfl
    (S1.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (S7.seq (S8.seq (S9.seq (S10.seq S11))))))))))
  refine (S.congr ?_).mono ?_
  · congr 1
    funext x
    by_cases xC : x = tbC
    · subst xC; simp +decide [g10, g9, g8, g7, inSt]
    by_cases xK : x = tbK
    · subst xK; simp +decide [g10, g9, inSt]
    by_cases xL : x = tbL
    · subst xL; simp +decide [inSt]
    by_cases xC2 : x = tbC2
    · subst xC2; simp +decide [g10, g9, g8, g7, g6, g5, g4, g3, g2, g1, g0, inSt, htk]
    by_cases xK2 : x = tbK2
    · subst xK2; simp +decide [g10, g9, g8, g7, g6, g5, g4, g3, g2, g1, g0, inSt, htk]
    by_cases xL2 : x = tbL2
    · subst xL2; simp +decide [g10, g9, g8, g7, g6, g5, g4, g3, g2, g1, g0, inSt, htk]
    by_cases xA : x = tbA
    · subst xA; simp +decide [g10, g9, g8, g7, g6, g5, g4, g3, nacc, inSt]
    by_cases xT : x = tbT
    · subst xT
      simp +decide [g10, g9, g8, g7, g6, g5]
      exact (inSt_tbJ g T Q j (k + 1) tbT (by decide)).trans hgT
    simp only [g10, g9, g8, g7, g6, g5, g4, g3, g2, g1, g0, Function.update_apply, xC, xK, xL, xC2,
      xK2, xL2, xA, xT, if_false]
    rw [inSt_tbJ _ _ _ _ _ _ (by simp [xC, xK, xL, xC2, xK2, xL2, xA]),
      inSt_tbJ _ _ _ _ _ _ (by simp [xC, xK, xL, xC2, xK2, xL2, xA])]
  · have hB : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    simp only [cInB, Ex.size, trmU, accU, bitU, jU]
    omega

theorem inSt_upd (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (Q j k : ℕ) (x : Fin HS) (v : List ℤ)
    (h : x ∉ [tbC, tbK, tbL, tbC2, tbK2, tbL2, tbA]) :
    Function.update (inSt g T Q j k) x v = inSt (Function.update g x v) T Q j k := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at h
  obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ := h
  funext y
  simp only [inSt, Function.update_apply]
  split_ifs <;> subst_vars <;> simp_all

theorem ent_eq (a Q : ℕ) : ((Q : ℤ) + -((a % Q : ℕ) : ℤ)) % (Q : ℤ) = (-(a : ℤ)) % (Q : ℤ) := by
  rw [Int.natCast_mod, Int.add_comm, Int.add_emod_right]
  exact (Int.ModEq.neg (Int.mod_modEq _ _)).eq

set_option maxHeartbeats 2000000 in
theorem recB_fsp (s : IState HS) (h : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) {Q j U : ℕ}
    {LQ LM : List Item}
    (hsQ : (NLogN.KIL.encK s h).G tbQ = .int (Q : ℤ) :: LQ)
    (hsM : (NLogN.KIL.encK s h).G tbM = .int (T.length : ℤ) :: LM)
    (hC : h tbC = T.map fun t => (t.1 : ℤ)) (hK : h tbK = T.map fun t => (t.2.1 : ℤ))
    (hL : h tbL = T.map fun t => (t.2.2 : ℤ)) (hC2 : h tbC2 = []) (hK2 : h tbK2 = [])
    (hL2 : h tbL2 = []) (hA : h tbA = []) (hT0 : h tbT = []) (hI : h tbI = []) (hV : h tbV = [])
    (hJ : h tbJ = [(j : ℤ) + 1])
    (hQ : 0 < Q) (hjU : j + 1 ≤ U) (h2U : 2 ≤ U) (hQU : Q ≤ U) (hmU : T.length ≤ U)
    (hT : ∀ t ∈ T, t.1 + Q ≤ U ∧ 2 ^ t.2.1 ≤ U ∧ 2 ^ t.2.2 ≤ U) :
    FSp NLogN.KFV.recB (NLogN.KIL.encK s h)
      (NLogN.KIL.encK s (Function.update (Function.update h 14 (svv Q T j :: h 14)) tbJ [(j : ℤ)]))
      (cRecB T.length (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  set m := T.length
  have zU : ∀ x : ℕ, x ≤ U → zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zB (by simpa using hx)
  -- push the accumulator
  have P1 := Sp.push s h (i := tbA) (e := .lit 0) (B := B) (by decide) (clean_lit _) trivial trivial
    (by simp only [Ex.Bnd]; exact zU 0 (by omega))
  rw [show Ex.eval (NLogN.KIL.encK s h) (.lit 0) :: h tbA = [((0 : ℕ) : ℤ)] by simp [Ex.eval, hA]] at P1
  have e0 : Function.update h tbA [((0 : ℕ) : ℤ)] = inSt h T Q j 0 := by
    funext y
    simp only [inSt, List.drop_zero, List.take_zero, List.map_nil, List.reverse_nil, List.sum_nil,
      Nat.zero_mod, Function.update_apply]
    split_ifs <;> subst_vars <;> simp_all
  rw [e0] at P1
  -- the term loop
  have hsQ' : ∀ g : Fin HS → List ℤ, g tbQ = h tbQ → (NLogN.KIL.encK s g).G tbQ = .int (Q : ℤ) :: LQ := by
    intro g hg; rw [encK_G] at hsQ ⊢; rw [hg]; exact hsQ
  have hsM' : ∀ g : Fin HS → List ℤ, g tbM = h tbM → (NLogN.KIL.encK s g).G tbM = .int (m : ℤ) :: LM := by
    intro g hg; rw [encK_G] at hsM ⊢; rw [hg]; exact hsM
  have hM0 : (NLogN.KIL.encK s (inSt h T Q j 0)).G tbM = .int (m : ℤ) :: LM :=
    hsM' _ (inSt_tbJ _ _ _ _ _ _ (by decide))
  have L := FSp.rep (C := tbI) (n := .reg tbM) (b := inB) (s := s) (F := fun k => inSt h T Q j k)
    (N := m) (c := cInB B) (by decide)
    (fun k => by rw [inSt_tbJ _ _ _ _ _ _ (by decide)]; exact hI) (by decide)
    (clean_reg (by decide)) (IState.isInt_of hM0) (by simp only [Ex.eval]; rw [IState.top_eq hM0])
    (by
      intro k hk
      rw [inSt_upd _ _ _ _ _ _ _ (by decide), inSt_upd _ _ _ _ _ _ _ (by decide)]
      refine inB_fsp s _ T hk (LJ := s.G tbJ) (hsQ' _ (by simp +decide)) ?_ (by simp +decide [hT0])
        hQ hjU h2U hQU hT
      rw [encK_G]; simp +decide [hJ, ints])
  -- moving the terms back
  set g := inSt h T Q j m
  have gC : g tbC = [] := by simp +decide [g, inSt, m]
  have gC2 : g tbC2 = (T.map fun t => (t.1 : ℤ)).reverse := by simp +decide [g, inSt, m]
  have hB1 : Bnd B (T.map fun t => (t.1 : ℤ)).reverse := by
    intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨t, ht, rfl⟩ := hx
    exact zU _ (by have := (hT t ht).1; omega)
  have hB2 : Bnd B (T.map fun t => (t.2.1 : ℤ)).reverse := by
    intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨t, ht, rfl⟩ := hx
    exact zU _ (le_trans (Nat.lt_two_pow_self).le (hT t ht).2.1)
  have hB3 : Bnd B (T.map fun t => (t.2.2 : ℤ)).reverse := by
    intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨t, ht, rfl⟩ := hx
    exact zU _ (le_trans (Nat.lt_two_pow_self).le (hT t ht).2.2)
  have hMg : ∀ g' : Fin HS → List ℤ, g' tbM = h tbM → (Ex.reg tbM).eval (NLogN.KIL.encK s g') = (m : ℤ) := by
    intro g' hg'; simp only [Ex.eval]; rw [IState.top_eq (hsM' g' hg')]
  have hMB : ∀ g' : Fin HS → List ℤ, g' tbM = h tbM → (Ex.reg tbM).Bnd (NLogN.KIL.encK s g') B := by
