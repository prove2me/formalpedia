-- title:
--   Theorem 5.1(iv), p. 19 — under VP-EB the potential Λ^k converges Q-linearly to Λ^∗
-- statement:
--   Under the assumptions of Theorem 4.1 (Assumptions 1 and 2, rule (8), $\{w^k\}$ generated by NAPP-AL), let $\bar w$ be an accumulation point of $\{w^k\}$ with $\Lambda^k\to\Lambda^*=\mathcal L_\gamma(\bar w)$, and let VP-EB hold at $\bar w$ with constants $\kappa_1,\eta,\nu>0$. Then the potential $\Lambda^k$ of (18) converges to $\Lambda^*$ Q-linearly: there are $\alpha\in(0,1)$ and $k_0$ such that
--   $$\Lambda^{k+1}-\Lambda^*\le\alpha(\Lambda^k-\Lambda^*)\qquad\forall k\ge k_0.$$
--
--   This is the Q-linear rate of the potential; the R-linear rate of the iterates follows from it and the sufficient decrease of $\Lambda^k$.
--
--   **Formalization Note.** $\Lambda^0$ is junk in Lean ($k-1$ in $\mathbb N$); the statement is existential in $k_0$, which may be taken $\ge1$. The $k_0$ here is independent of the one in part (i). The interval $(0,1)$ for $\alpha$ is open on both sides, as printed.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 19, Theorem 5.1(iv)

import Mathlib
import Definitions.Def_NAPPAL_KL_Setting

namespace NAPPAL.Linear


theorem theorem_5_1_iv {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ) (LK : ℝ)
    (K : NAPPAL.KL.E n → ℝ) (β γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : NAPPAL.KL.RunHyp P LG LH L0 LOmj LK K β γ σ δ ε u v p)
    (wbar : NAPPAL.KL.W n d m) (hcl : MapClusterPt wbar Filter.atTop (NAPPAL.KL.wseq u v p))
    (hΛ : Filter.Tendsto (NAPPAL.KL.Lam P LG LH L0 γ u v p) Filter.atTop (nhds (NAPPAL.KL.augLag P γ wbar)))
    (κ1 η ν : ℝ) (hvp : NAPPAL.KL.VPEB P γ (NAPPAL.KL.wseq u v p) wbar κ1 η ν) :
    (∃ α : ℝ, 0 < α ∧ α < 1 ∧ ∃ k0 : ℕ, ∀ k ≥ k0,
        NAPPAL.KL.Lam P LG LH L0 γ u v p (k + 1) - NAPPAL.KL.augLag P γ wbar ≤
          α * (NAPPAL.KL.Lam P LG LH L0 γ u v p k - NAPPAL.KL.augLag P γ wbar)) := by sorry

end NAPPAL.Linear
