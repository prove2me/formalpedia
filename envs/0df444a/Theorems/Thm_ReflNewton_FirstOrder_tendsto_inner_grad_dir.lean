-- title:
--   Proof of Theorem 8, p. 208 — for constraint-compatible directions, g_kᵀs_k → 0
-- statement:
--   Under the compactness and smoothness assumption, let $\{x_k\}$ be generated by the interior-reflective algorithm of Fig. 9 with $0<\sigma_l<\sigma_u<1$ and $\rho>0$, and let the directions $\{s_k\}$ be constraint-compatible. Then
--   $$\lim_{k\to\infty} g_k^{T}s_k=0 .$$
--
--   This is the contradiction argument of the proof of Theorem 8: if $g_k^{T}s_k<-\chi$ along a subsequence, the stepsizes there tend to zero, so (3.5) must be satisfied for them, and Lemma 7 shows that the ratio $\phi_k(\alpha_k)$ of (3.6) tends to a value at least $1$, which (3.5) forbids. Combined with the consistency condition it gives $D_kg_k\to0$.
--
--   **Formalization Note** The page phrases the argument as a contradiction with the conclusion $D_k^2g_k\to0$ and uses consistency only to pass from $D_kg_k\not\to0$ to $g_k^{T}s_k\not\to0$; the statement is the part that does not depend on consistency.
-- source:
--   Coleman & Li, On the convergence of interior-reflective Newton methods for nonlinear minimization subject to bounds, Math. Programming 67 (1994), p. 208, proof of Theorem 8 (the contradiction argument)

import Mathlib
import Definitions.Def_LewisTorczon_BoundPS_Box
import Definitions.Def_ReflNewton_FirstOrder_Setting
open Filter Topology

namespace ReflNewton.FirstOrder

theorem tendsto_inner_grad_dir
    {n : ℕ} (l u : Fin n → EReal) (hl : ∀ i, l i ≠ ⊤) (hu : ∀ i, u i ≠ ⊥) (hlu : l ≤ u)
    (f : E n → ℝ) (D : Set (E n)) (hDo : IsOpen D)
    (hFD : LewisTorczon.BoundPS.box l u ⊆ D) (hf : ContDiffOn ℝ 2 f D)
    (σl σu ρ : ℝ) (hσl : 0 < σl) (hσlu : σl < σu) (hσu : σu < 1) (hρ : 0 < ρ)
    (x s : ℕ → E n) (α : ℕ → ℝ) (hrun : IsIRRun l u f σl σu ρ x s α)
    (hL : IsCompact (LewisTorczon.BoundPS.levelSet l u f (x 0)))
    (hcc : IsConstraintCompatible l u f x s) :
    Tendsto (fun k => inner ℝ (gradient f (x k)) (s k)) atTop (𝓝 0) := by sorry

end ReflNewton.FirstOrder
