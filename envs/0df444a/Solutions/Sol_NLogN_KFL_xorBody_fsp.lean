-- Source module: Solutions.KFLLoop
/-!
# KFL §3: the segment loop (register programs)

All per-record / per-block arithmetic of Lemma 13 is a loop over the `n` segments
`j_i = ρ + iK`: with `u, v` the two chunk values shifted by `2^ρ`, `w = 2^ρ`,

  `segBody K T : acc += w · T(u, v); u /= 2^K; v /= 2^K; w *= 2^K`

repeated `n` times (`segLoop`).  `segLoop_fsp` gives the closed form (for any expression `T` of
the two registers `rU, rV` with semantics `tf`) and the fine cost `O(n (|T| + 1) (Bb+2)^2)`.
Instances: the offset of a line (`offE`), the `T0` correction (`t0E`), the guard test (`grdE`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD

/-! ## Registers -/

theorem clean_all (e : Ex HS) (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean := fun i hi hz => by
  have := h i hi
  simp only [ExSt.all, zX, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact absurd this (by decide)

theorem zsz_le_of_abs {v : ℤ} {B : ℕ} (h : |v| < 2 ^ B) : zsz v ≤ B := by
  apply zsz_le_of_lt
  have : (v.natAbs : ℤ) < 2 ^ B := by rw [Int.natCast_natAbs]; exact h
  exact_mod_cast this

/-! ## The loop -/

theorem upd_ne {F : Fin HS → List ℤ} {i j : Fin HS} (h : j ≠ i) (x : List ℤ) :
    Function.update F i x j = F j := Function.update_of_ne h _ _
end NLogN.KFL

