-- title:
--   The Jordan–Chevalley–Dunford decomposition
-- statement:
--   **The Jordan–Chevalley–Dunford decomposition.** Let $V$ be a finite-dimensional vector space over a perfect field $K$ and $f$ an endomorphism of $V$. Then $f=n+s$ with $n$ nilpotent and $s$ semisimple, where both $n$ and $s$ are polynomials in $f$ (they lie in the subalgebra $K[f]$ generated by $f$). In particular $n$ and $s$ commute with each other and with everything that commutes with $f$.
--
--   Over an algebraically closed field this is the additive form of the Jordan normal form: $s$ is the diagonal part and $n$ the strictly upper-triangular part of the Jordan matrix. The decomposition is a basic tool in the structure theory of linear algebraic groups and Lie algebras, where it gives the abstract Jordan decomposition.
--
--   **Formalization note.** Mathlib's `Module.End.exists_isNilpotent_isSemisimple`. `Algebra.adjoin K {f}` is the subalgebra of `Module.End K V` generated by `f`, and `Module.End.IsSemisimple` means every invariant subspace has an invariant complement. Uniqueness of the decomposition is a separate Mathlib result, `Module.End.isNilpotent_isSemisimple_unique`, and is not part of this statement.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `Module.End.exists_isNilpotent_isSemisimple`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

theorem jordan_chevalley_dunford {K V : Type*} [Field K] [PerfectField K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (f : Module.End K V) :
    ∃ n ∈ Algebra.adjoin K {f}, ∃ s ∈ Algebra.adjoin K {f}, IsNilpotent n ∧ s.IsSemisimple ∧ f = n + s := by sorry

end FamousTheorems
