theorem NLogN.KIL.swC_runs {q m k P L' N : ℕ} {A B Cs : Shape} (a b : ℕ) (ha : a < m) (hb : m ≤ b)
    (hb' : b < m + m) (j0 : Fin Pp) (ch : List (ZMod 2) → List (ZMod 2)) (c0 : ℕ)
    (hrec : ∀ (t' : IState HS) (R' : List Item) (ys : List (ZMod 2)),
      DescIn t' q m k P L' (A ++ List.replicate a N)
        (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
        (List.replicate (m + m - 1 - b) N ++ Cs) →
      ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      IRuns I iprog (iprog j0) (t'.upd 0 (ints (enc2 ys) ++ R'))
        (t'.upd 0 (ints (enc2 (ch ys)) ++ R')) c0)
    (Bb : ℕ) (hN : 1 ≤ N) (hpos : ∀ x ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ x)
    (hV : zsz ((vol (P :: L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb) (hk : zsz (k : ℤ) ≤ Bb)
