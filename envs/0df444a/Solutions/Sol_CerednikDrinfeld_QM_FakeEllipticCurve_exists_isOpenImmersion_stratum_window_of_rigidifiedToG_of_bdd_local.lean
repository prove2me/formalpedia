noncomputable def pad (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) :
    FakeEllipticCurve.Rigidification r π A₀ ψ E where
  Eb := ρ.Eb
  gb := ρ.gb
  isPullback_Eb := ρ.isPullback_Eb
  Ab := ρ.Ab
  gA := ρ.gA
  isPullback_Ab := ρ.isPullback_Ab
  d := ρ.d + (i + j)
  φ := ρ.φ ≫ ρ.Ab.act (zΛ hΛℤ (r ^ i))
  φ' := ρ.Ab.act (zΛ hΛℤ (r ^ j)) ≫ ρ.φ'
  φ_over := by rw [Category.assoc, ρ.Ab.act_over, ρ.φ_over]
  isIsogenyPair := by
    have h := FakeEllipticCurve.IsIsogenyPair.comp hΛℤ ρ.isIsogenyPair (isIsogenyPair_act_zΛ hΛℤ ρ.Ab (r ^ i) (r ^ j))
    rwa [← pow_add, ← pow_add] at h
  preservesLevel := by
    intro T t P hP
    have h1 := ρ.Ab.lev_stable (zΛ hΛℤ (r ^ i)) t _ (ρ.preservesLevel t P hP)
    have : mapPt (ρ.φ ≫ ρ.Ab.act (zΛ hΛℤ (r ^ i))) (by rw [Category.assoc, ρ.Ab.act_over, ρ.φ_over]) P =
        pushPt (ρ.Ab.act (zΛ hΛℤ (r ^ i))) (ρ.Ab.act_over _) (mapPt ρ.φ ρ.φ_over P) :=
      Subtype.ext (by simp only [mapPt_coe, pushPt, Category.assoc])
    rw [this]; exact h1

@[scoped simp] theorem pad_d (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) : (pad hΛℤ ρ i j).d = ρ.d + (i + j) := rfl
@[scoped simp] theorem pad_φ (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) :
