/-! # The exact bond dimension of the comb at an arbitrary cut

`ShorCombState` shows that the periodic comb has Schmidt rank exactly `r` across
a cut whose block size `B` is coprime to `r`, and rank `1` when `r ∣ B`.  This
file proves the **sharp interpolating formula** covering every cut of a register
whose low half is at least as long as the period:

`schmidtRank (comb across the cut) = min C (r / gcd r B)`,

where `B` is the block size (the size of the low half), `C` the number of blocks
(the size of the high half) and `r` the order.  The arithmetic content is that
the high-half labels `c ↦ x₀ - B·c (mod r)` sweep out the cyclic subgroup
generated by `B` in `ℤ/r`, of index `gcd(r, B)`, and do so with period
`r / gcd(r, B)`.

Consequences:

* `schmidtRank_combCut_sharp` : the exact formula;
* `schmidtRank_combCut_eq_of_coprime` : the coprime case recovers rank `r`;
* `schmidtRank_combCut_of_dvd` : `r ∣ B` collapses the rank to `1`;
* `bondDim_combCut_sharp_ge` : the corresponding exact bond-dimension threshold.

The formula shows precisely where a tensor-train emulation could be cheap: only
when `gcd(r, B)` is large, i.e. when the block size already almost resolves the
period — which for a power-of-two register means `r` has a large power-of-two
part, the classically easy case.
-/

open Finset

open ShorIrreducible

open IITTensorNetwork


variable {B C r x0 : ℕ} [NeZero r] {amp : ℝ}






lemma combRight_eq_combLabel (B C r x0 : ℕ) (c : Fin C) :
    combRight B C r x0 c = combLabel B r x0 (c : ℕ) := by
  rw [combRight, combLabel]
  push_cast
  ring

lemma image_combRight_eq_range (B C r x0 : ℕ) :
    (univ : Finset (Fin C)).image (combRight B C r x0)
      = (Finset.range C).image (combLabel B r x0) := by
  classical
  ext z
  simp only [Finset.mem_image, Finset.mem_univ, true_and, Finset.mem_range]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨(c : ℕ), c.isLt, (combRight_eq_combLabel B C r x0 c).symm⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨⟨c, hc⟩, by rw [combRight_eq_combLabel]⟩









open ShorIrreducible in
theorem solution(hamp : amp ≠ 0) (hr : 0 < r) (hB : r ≤ B) :
    schmidtRank (combCutMatrix B C r x0 amp) = min C (cutPeriod r B) := by
  classical
  rw [combCutMatrix_eq_matchMatrix, schmidtRank_matchMatrix hamp, matchSet,
    image_combLeft_eq_univ hB, Finset.univ_inter, image_combRight_eq_range,
    card_image_combLabel hr]
