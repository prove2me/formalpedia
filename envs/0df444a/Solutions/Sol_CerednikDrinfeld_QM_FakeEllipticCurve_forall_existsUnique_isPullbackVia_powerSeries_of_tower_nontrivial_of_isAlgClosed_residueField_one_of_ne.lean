variable (E₀ : FakeEllipticCurve Λ 1 (ResidueField O))

structure Defm (B : Type) [CommRing B] (ρ : B →+* ResidueField O) : Type 1 where
  E : FakeEllipticCurve Λ 1 B
  g : E₀.A ⟶ E.A
  hg : FakeEllipticCurve.IsPullbackVia ρ E E₀ g

variable {E₀}

def Defm.Rel {B : Type} [CommRing B] {ρ : B →+* ResidueField O} (x y : Defm E₀ B ρ) : Prop :=
  ∃ h : x.E.A ⟶ y.E.A, FakeEllipticCurve.IsPullbackVia (RingHom.id B) y.E x.E h ∧ x.g ≫ h = y.g

theorem isPullbackVia_id {B : Type} [CommRing B] (E : FakeEllipticCurve Λ 1 B) :
    FakeEllipticCurve.IsPullbackVia (RingHom.id B) E E (𝟙 E.A) := by
  have hS : Spec.map (CommRingCat.ofHom (RingHom.id B)) = 𝟙 _ := by rw [CommRingCat.ofHom_id, Spec.map_id]
  haveI : IsIso (Spec.map (CommRingCat.ofHom (RingHom.id B))) := by rw [hS]; infer_instance
  have sq : IsPullback (𝟙 E.A) E.f E.f (Spec.map (CommRingCat.ofHom (RingHom.id B))) :=
    IsPullback.of_horiz_isIso ⟨by rw [hS, Category.id_comp, Category.comp_id]⟩
  refine ⟨sq, ?_, ?_, ?_⟩
  · intro T t' P Q
    rw [Category.comp_id]
    exact CompareAwayAuxP20.mul_val_congr E.L (by rw [hS, Category.comp_id]) P Q _ _
      (Category.comp_id _).symm (Category.comp_id _).symm
  · intro x; rw [Category.comp_id, Category.id_comp]
  · intro T t' P hP
    obtain ⟨P₀, h⟩ := hP
    exact ⟨P₀, by rw [Category.comp_id]; exact h⟩

theorem isPullbackVia_id_symm {B : Type} [CommRing B] (E E' : FakeEllipticCurve Λ 1 B) (h : E.A ⟶ E'.A)
    (hh : FakeEllipticCurve.IsPullbackVia (RingHom.id B) E' E h) :
    ∃ h' : E'.A ⟶ E.A, FakeEllipticCurve.IsPullbackVia (RingHom.id B) E E' h' ∧ h ≫ h' = 𝟙 _ ∧ h' ≫ h = 𝟙 _ := by
  obtain ⟨sq, hmul, hact, hlev⟩ := hh
  have hS : Spec.map (CommRingCat.ofHom (RingHom.id B)) = 𝟙 _ := by rw [CommRingCat.ofHom_id, Spec.map_id]
  haveI : IsIso (Spec.map (CommRingCat.ofHom (RingHom.id B))) := by rw [hS]; infer_instance
  haveI : IsIso h := sq.isIso_fst_of_isIso
  refine ⟨inv h, ?_, IsIso.hom_inv_id h, IsIso.inv_hom_id h⟩
  have hw : inv h ≫ E.f = E'.f ≫ Spec.map (CommRingCat.ofHom (RingHom.id B)) := by
    rw [IsIso.inv_comp_eq, ← Category.assoc, sq.w, hS, Category.comp_id, Category.comp_id]
  have sq' : IsPullback (inv h) E'.f E.f (Spec.map (CommRingCat.ofHom (RingHom.id B))) :=
    IsPullback.of_horiz_isIso ⟨hw⟩

  have hmul' : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t' E'.f),
      (E'.L.mul t' P Q).1 ≫ inv h =
        (E.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (RingHom.id B)))
          ⟨P.1 ≫ inv h, by rw [Category.assoc, hw, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ inv h, by rw [Category.assoc, hw, ← Category.assoc, Q.2]⟩).1 := by
    intro T t' P Q
    rw [IsIso.comp_inv_eq]
    have key := hmul (t' ≫ Spec.map (CommRingCat.ofHom (RingHom.id B)))
      ⟨P.1 ≫ inv h, by rw [Category.assoc, hw, ← Category.assoc, P.2]⟩
      ⟨Q.1 ≫ inv h, by rw [Category.assoc, hw, ← Category.assoc, Q.2]⟩
    rw [key]
    symm
    apply CompareAwayAuxP20.mul_val_congr
    · rw [hS, Category.comp_id, Category.comp_id]
    · simp
    · simp
  refine ⟨sq', hmul', ?_, ?_⟩
  · intro x
    rw [IsIso.comp_inv_eq, Category.assoc, IsIso.eq_inv_comp, hact]
  · intro T t' P hP

    have hP1 : P = E'.L.one t' :=
      (CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_iff_eq_one_of_level_one E' t' P).mp hP
    subst hP1
    obtain ⟨P₀, hP₀⟩ := E.lev_one (t' ≫ Spec.map (CommRingCat.ofHom (RingHom.id B)))
    exact ⟨P₀, by rw [hP₀, CompareAwayAuxP20.one_comp_of_mul (RingHom.id B) E E' (inv h) hw hmul' t']⟩

theorem Defm.Rel.refl {B : Type} [CommRing B] {ρ : B →+* ResidueField O} (x : Defm E₀ B ρ) : Defm.Rel x x :=
  ⟨𝟙 _, isPullbackVia_id x.E, Category.comp_id _⟩

theorem Defm.Rel.symm {B : Type} [CommRing B] {ρ : B →+* ResidueField O} {x y : Defm E₀ B ρ} (r : Defm.Rel x y) :
    Defm.Rel y x := by
  obtain ⟨h, hh, hg⟩ := r
  obtain ⟨h', hh', h1, h2⟩ := isPullbackVia_id_symm x.E y.E h hh
  exact ⟨h', hh', by rw [← hg, Category.assoc, h1, Category.comp_id]⟩

theorem Defm.Rel.trans {B : Type} [CommRing B] {ρ : B →+* ResidueField O} {x y z : Defm E₀ B ρ} (r : Defm.Rel x y)
    (s : Defm.Rel y z) : Defm.Rel x z := by
  obtain ⟨h, hh, hg⟩ := r
  obtain ⟨h', hh', hg'⟩ := s
  refine ⟨h ≫ h', ?_, by rw [← Category.assoc, hg, hg']⟩
  have := FakeEllipticCurve.IsPullbackVia.comp (RingHom.id B) (RingHom.id B) z.E y.E x.E h' h hh' hh
  simpa using this

scoped instance Defm.setoid (B : Type) [CommRing B] (ρ : B →+* ResidueField O) : Setoid (Defm E₀ B ρ) where
  r := Defm.Rel
  iseqv := ⟨Defm.Rel.refl, Defm.Rel.symm, Defm.Rel.trans⟩

