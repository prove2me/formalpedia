    rw [KFV.co_procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR, hgm]
  have hAl := e18_procQ_len C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR hfl
  have hBl := e18_procQ_len C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR hgl
  have hZ : List.zipWith (KFV.ppq (2 ^ ℓ) p) (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf))
      (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xg)) =
      (ofA (QQ y C p (GlueProp18.PP y C (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR))
        (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR))))).map C.co := by
    rw [hA, hB]; exact e18_zip C p hAl hBl
  have hW : KFV.procQIc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ (List.zipWith (KFV.ppq (2 ^ ℓ) p)
      (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf)) (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xg))) =
      (procQI y (paperLayout D ℓ K long hK hℓ) C p ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ (ofA (QQ y C p (GlueProp18.PP y C
        (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR))
        (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR)))))).map C.co := by
    rw [hZ, KFV.co_procQI]
  have hpipe : KFV.pipe18c D ℓ K long hK hℓ p xf xg =
      (pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (tgtL D ℓ K long) (initL D ℓ long)) (0 : Fin (2 ^ ℓ) → ℂ)) (((procQI y (paperLayout D ℓ K long hK hℓ) C p ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ (ofA (QQ y C p (GlueProp18.PP y C
        (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR))
        (toA C (vol (binSh (tgtL D ℓ K long).length)) (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ gR)))))).map C.co).map
          fun v => (Mv (al D ℓ long) : ℂ) • v) := by
    show (pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (tgtL D ℓ K long) (initL D ℓ long)) (0 : Fin (2 ^ ℓ) → ℂ)) ((KFV.procQIc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ (List.zipWith (KFV.ppq (2 ^ ℓ) p)
      (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf)) (KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xg)))).map
        fun v => (Mv (al D ℓ long) : ℂ) • v) = _
    rw [hW]
  -- the exact side in coordinates
  have hfn : ∀ (l : List (Fin (2 ^ ℓ) → ℂ)) (lR : List R), lR = ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) l).map lift →
      ∀ k ∈ box (al D ℓ long), C.co (fn (paperLayout D ℓ K long hK hℓ) lR k) = l.getD (e18rho D ℓ long k) 0 := by
    intro l lR hl k hk
    subst hl
    show C.co ((((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) l).map lift).getD (encode (binSh (tgtL D ℓ K long).length) (addrS D (tgtL D ℓ K long) k)) 0) = _
    rw [hcg]
    exact e18_lin D ℓ K long hK hℓ _ _ hk
  have hR1 : ∀ j (hj : j < ((KFV.ts18 D ℓ long)).prod), (mrL (2 ^ ℓ) (KFV.ts18 D ℓ long) xf xg).getD j 0 =
      C.co (Mr (2 ^ ℓ) (al D ℓ long) (fn (paperLayout D ℓ K long hK hℓ) fR) (fn (paperLayout D ℓ K long hK hℓ) gR) (e18sig D ℓ long j)) := by
    intro j hj
