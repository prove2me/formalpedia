def K0 : ℕ := 8 * fmA + 10 ^ 7 + 10 ^ 5

/-- The constant of `cU`. -/
def CU : ℕ := 10 ^ 4 + 5120 * NLogN.KFUU.K0

/-! ## The sizes -/

/-! ## The ℕ part -/

/-- The `ℕ` cost pieces: setup (`B`), passes (`Z`), table (`Br`, `Bb`) and the `ℕ` part of a
reversal. -/
def natCost (w d VT VS PM B Z Br Bb : ℕ) : ℕ :=
  3 * 10 ^ 10 * (d + 2) * (B + 2) ^ 2 + 3 * ((d + 2) * (2000 * cScan VT w + 25 * cU Z)) +
    (d + 1) * (cStepU d PM VS w Br Bb + 3000) +
    ((d + 1) * (1 + 2 * KFU.cMv VT w + 160 * cU Z) + 30 * cU Z) + 2

/-- The constant `C₁`. -/
def C1 : ℕ := 10 ^ 16 * NLogN.KFUU.CU

