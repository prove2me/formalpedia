private theorem finite_row_size : certificate028.rows.size = 542 := by
  rw [evaluation_rows]
  rfl
private theorem finite_pool_size : certificate028.pool.size = 600 := by
  rw [evaluation_pool]
  rfl
private theorem rows_check : certificate028.rows.toList.all (rowB certificate028) = true := by
  apply List.all_eq_true.mpr
  intro row hrow
  obtain ⟨j, hj, he⟩ := Array.mem_iff_getElem.mp (Array.mem_toList_iff.mp hrow)
  have hj' : j < 542 := by simpa only [finite_row_size] using hj
  have h := (Bool.and_eq_true_iff.mp (finite_checks j (by omega))).1
  rw [if_pos hj, getElem!_pos certificate028.rows j hj, he] at h
  exact h
private theorem covers_check : (List.range certificate028.pool.size).all (localCoverB certificate028) = true := by
  apply List.all_eq_true.mpr
  intro j hj
  have hj' := List.mem_range.mp hj
  have hj'' : j < 600 := by simpa only [finite_pool_size] using hj'
  have h := (Bool.and_eq_true_iff.mp (finite_checks j (by omega))).2
  simpa only [if_pos hj'] using h

private theorem evaluated_cost : cost certificate028 = 192667005 := by
  rw [cost_fold, evaluation_rows]
  rfl
private theorem evaluated_deleted : deletedCount certificate028 = 192 := by
  decide_cbv
private theorem cost_check : decide (cost certificate028 < certificate028.denominator * (deletedCount certificate028+1)) = true := by
  rw [evaluated_cost, evaluated_deleted, evaluation_denominator]
  decide_cbv
theorem solution : CompletionBound (decode 99) (0 : ZMod 3) := by
  have hs : certificate028.blockers.size = 6561 := by
    simp only [certificate028, binaryBlockers, Array.size_ofFn]
  have hb : CompletionBound (decode certificate028.normal) certificate028.level := by
    apply boolean_check_completion_bound
    unfold verifyB
    rw [hs, all_blocks, rows_check, covers_check, cost_check]
    decide_cbv
  exact hb
