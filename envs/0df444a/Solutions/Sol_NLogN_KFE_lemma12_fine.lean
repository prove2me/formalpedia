    rw [Module.End.mul_eq_comp, ← Matrix.toLin'_mul, hP]
  have := ((LinearMap.isProj_range_iff_isIdempotentElem _).2 hf).trace
  rw [Matrix.trace_toLin'_eq] at this
  rw [this]
  rfl

