/-- `Ā_ℓ(u) ⊆ B̄_{(ℓ/2)√d}(u)`. -/
lemma solution {h : ℝ} (_hh : 0 ≤ h) (u : EuclideanSpace ℝ (Fin d)) :
    QFS.closedCube h u ⊆ closedBall u (h / 2 * Real.sqrt d) := by
  intro x hx
  rw [Metric.mem_closedBall, dist_eq_norm]
  calc ‖x - u‖ ≤ Real.sqrt d * QFS.infNorm (x - u) := QFS.norm_le_sqrt_dim_mul_infNorm _
    _ ≤ Real.sqrt d * (h / 2) := mul_le_mul_of_nonneg_left hx (Real.sqrt_nonneg _)
    _ = h / 2 * Real.sqrt d := by ring
