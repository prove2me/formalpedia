variable {P : Scheme.{u}} {T : P.Etale} (ξ : T.left) (W : P.Etale)

theorem κp_ψn : κp ξ W ≫ ψn ξ W = (pullback.snd (f0 T ξ) W.hom).toNormalization := by
  have : Etale W.hom := W.prop
  rw [← cancel_mono ((f0 T ξ).normalizationPullback W.hom)]
  simp only [ψn, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  refine pullback.hom_ext ?_ ?_
  · simp [κp]
