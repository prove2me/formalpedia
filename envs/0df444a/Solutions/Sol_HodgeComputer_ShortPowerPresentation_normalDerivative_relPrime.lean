    Polynomial.map_pow, Polynomial.map_ofNat, Polynomial.map_C, Polynomial.map_X]
  all_goals simp only [linePoly, div_eq_mul_inv, map_mul, map_ofNat, one_mul]
  all_goals norm_num only [map_one, inv_one, mul_one, one_mul]
  all_goals ring

private lemma line_relPrime : IsRelPrime linePoly linePoly.derivative := by
  apply IsCoprime.isRelPrime
  refine ⟨(Polynomial.C (-33905388841450 / 558600112705686327 : ℂ) * Polynomial.X ^ 4 + Polynomial.C (-55859333401593673700 / 460036798619106091659831 : ℂ) * Polynomial.X ^ 2 + Polynomial.C (823543 / 823553 : ℂ)), (Polynomial.C (16952694420725 / 1675800338117058981 : ℂ) * Polynomial.X ^ 5 + Polynomial.C (33908477127700 / 1675495167381104931 : ℂ) * Polynomial.X ^ 3 + Polynomial.C (-460031205836283609256561 / 2760220791714636549958986 : ℂ) * Polynomial.X ^ 1), ?_⟩
  apply Polynomial.funext
  intro x
  norm_num [linePoly, Polynomial.derivative_add, Polynomial.derivative_C_mul_X_pow,
    Polynomial.derivative_C, Polynomial.eval_add, Polynomial.eval_mul,
    Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C]
  all_goals ring

theorem solution : IsRelPrime F (NormalChart.normal F) := by
  apply HodgeComputer.Algebra.normalDerivative_relPrime_of_specialization 5 6 F (823553 / 823543 : ℂ)
    (fun i : Fin 5 => if i = 2 then 1 else 0) F_homogeneous (by norm_num) top_coeff
  change IsRelPrime ((split F).map specialize) (Polynomial.derivative ((split F).map specialize))
  rw [specialize_F]
  exact line_relPrime

