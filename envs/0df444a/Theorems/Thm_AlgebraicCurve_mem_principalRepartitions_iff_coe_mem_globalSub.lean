namespace AlgebraicCurve

theorem mem_principalRepartitions_iff_coe_mem_globalSub {K F : Type*} [Field K] [Field F] [Algebra K F] {α : ↥(repartitions K F)} :
    α ∈ principalRepartitions K F ↔ (α : Place K F → F) ∈ globalSub K F := by sorry
