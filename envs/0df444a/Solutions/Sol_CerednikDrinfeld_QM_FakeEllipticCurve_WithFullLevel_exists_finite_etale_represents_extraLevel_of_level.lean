theorem exists_UC : ∃ UC : (E'.L.schemeKer (N * N₀)).Opens, IsClosed (UC : Set ↥(E'.L.schemeKer (N * N₀))) ∧
    ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f),
      CerednikDrinfeld.QM.FactorsThrough E'.lev P ↔
        ∃ κ : TT ⟶ E'.L.schemeKer (N * N₀), κ ≫ KerOps.ι E'.L (N * N₀) = P.1 ∧
          Set.range κ.base ⊆ (UC : Set ↥(E'.L.schemeKer (N * N₀))) := by
  haveI := etale_kerM (N := N) E' hM
  haveI := E'.lev_closed
  haveI := E'.lev_flat
  haveI := E'.lev_finitePresentation
