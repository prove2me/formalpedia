-- title:
--   Path space $\mathcal C$, $\mathcal P_\psi(\mathcal C)$ with $\tau_\psi$, $\mathcal P(A)$, the base space $(\xi, W)$ with its augmented filtration, admissible controls (§3.1)
-- statement:
--   This definition file sets up the probabilistic objects of the weak formulation of mean field games of Carmona and Lacker (§3.1).
--
--   1. **Path space.** $\mathcal C = C([0,T];\mathbb R^d)$ with the sup norm $\|x\| = \sup_{s\in[0,T]}|x(s)|$ and its Borel $\sigma$-field. The canonical filtration $(\mathcal F^{\mathcal C}_t)$ is generated by the coordinates $x \mapsto x(s)$, $s \le t \wedge T$; a map $(t,x)\mapsto\varphi(t,x)$ is *progressively measurable* when it is progressive for this filtration.
--   2. **Measures with a $\psi$-moment.** For a function $\psi : \mathcal C \to \mathbb R$,
--   $$\mathcal P_\psi(\mathcal C) = \Big\{\mu \in \mathcal P(\mathcal C) : \int \psi\, d\mu < \infty\Big\},$$
--   and for $\varphi$, $B_\varphi(\mathcal C)$ is the set of measurable $f : \mathcal C\to\mathbb R$ with $|f| \le c\,\varphi$ for some constant $c$. The topology $\tau_\psi(\mathcal C)$ on $\mathcal P_\psi(\mathcal C)$ is the weakest topology making $\mu \mapsto \int f\,d\mu$ continuous for every $f \in B_\psi(\mathcal C)$. Two measures are *equivalent*, $\mu\sim\mu'$, when each is absolutely continuous with respect to the other.
--   3. **Controls.** For a set $A$ in a normed space, $\mathcal P(A)$ is the set of Borel probability measures on $A$ with the topology of weak convergence.
--   4. **Base space.** A probability space $(\Omega, P)$ carrying an $\mathbb R^d$-valued initial state $\xi$ and a standard $d$-dimensional Brownian motion $W$ independent of $\xi$. The filtration $\mathbb F = (\mathcal F_t)$ is the completion of $\sigma((\xi, W_s) : 0 \le s \le t)$ by $P$-null sets. The admissible controls $\mathbb A$ are the $\mathbb F$-progressively measurable processes with values in $A$.
--
--   These objects are the common ground of every statement about the mean field game: the state process lives on the base space, measure arguments range over $\mathcal P_\psi(\mathcal C)$, and controls are elements of $\mathbb A$.
--
--   **Formalization Note.** The paper works on the canonical space $\Omega = \mathbb R^d \times \mathcal C$ with $P = \lambda_0 \otimes$ Wiener measure; the base space here is any probability space carrying such a pair $(\xi, W)$, of which the canonical space is an instance. Completion by null sets adjoins the $\sigma$-field generated by the measurable $P$-null sets. $\mathcal P_\psi(\mathcal C)$ is a structure (a probability measure together with the finiteness of $\int\psi\,d\mu$, computed as a lower Lebesgue integral), so that its only topology is $\tau_\psi$. States are vectors in $\mathbb R^d$ with the sup norm; time is $\mathbb R_{\ge 0}$, of which only $[0,T]$ matters.
-- source:
--   Carmona, Lacker, A probabilistic weak formulation of mean field games and applications, arXiv:1307.1152v2 (2014), §3.1, pp. 8–9

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_WeakMFG_Existence_Model

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace WeakMFG.Uniqueness

instance (d : ℕ) (T : ℝ≥0) : BorelSpace (WeakMFG.Existence.Path d T) := ⟨rfl⟩

/-- The time `min t T ∈ [0, T]`, used to stop the coordinate process at the horizon. -/
def clampTime (T : ℝ≥0) (t : ℝ≥0) : Set.Icc (0 : ℝ) T :=
  ⟨((min t T : ℝ≥0) : ℝ), ⟨(min t T).2, by exact_mod_cast min_le_right t T⟩⟩

/-- The canonical filtration of `𝒞`: `pathFilt t = σ(x ↦ x(s) : s ≤ min t T)`, the natural
filtration of the coordinate process stopped at `T` (p. 8). A map `(t, x) ↦ φ(t, x)` on
`[0, T] × 𝒞` is *progressively measurable* when it is `IsStronglyProgressive pathFilt`. -/
noncomputable def pathFilt (d : ℕ) (T : ℝ≥0) : Filtration ℝ≥0 (borel (WeakMFG.Existence.Path d T)) :=
  Filtration.natural (fun (t : ℝ≥0) (x : WeakMFG.Existence.Path d T) => x (clampTime T t))
    (fun t => (continuous_eval_const (clampTime T t)).stronglyMeasurable)

/-- `P_ψ(𝒞) = {μ ∈ P(𝒞) : ∫ ψ dμ < ∞}` (p. 8): a Borel probability measure on `𝒞` that
integrates `ψ`.
**Formalization Note.** A structure (not a subtype of `ProbabilityMeasure`), so that the only
topology on it is `τ_ψ` below; the integral is the lower Lebesgue integral of `ψ` in `ℝ≥0∞`. -/
structure Ppsi {d : ℕ} {T : ℝ≥0} (ψ : WeakMFG.Existence.Path d T → ℝ) where
  /-- The underlying measure. -/
  toMeasure : Measure (WeakMFG.Existence.Path d T)
  isProb : IsProbabilityMeasure toMeasure
  integrable_psi : ∫⁻ x, ENNReal.ofReal (ψ x) ∂toMeasure < ⊤

/-- The topology on `P_ψ(𝒞)` induced by `B_φ(𝒞)`: the weakest topology making
`μ ↦ ∫ f dμ` continuous for each `f ∈ B_φ(𝒞)` (p. 8). `τ_ψ(𝒞)` is `tauTop ψ ψ`; the
restriction of `τ_1(𝒞)` to `P_ψ(𝒞)` is `tauTop ψ 1`. -/
@[instance_reducible] noncomputable def tauTop {d : ℕ} {T : ℝ≥0} (ψ φ : WeakMFG.Existence.Path d T → ℝ) : TopologicalSpace (Ppsi ψ) :=
  TopologicalSpace.induced (fun (μ : Ppsi ψ) (f : WeakMFG.Existence.Bpsi φ) => ∫ x, f.1 x ∂μ.toMeasure)
    Pi.topologicalSpace

/-- Unless otherwise stated, `P_ψ(𝒞)` carries `τ_ψ(𝒞)` (p. 8). -/
noncomputable instance {d : ℕ} {T : ℝ≥0} (ψ : WeakMFG.Existence.Path d T → ℝ) : TopologicalSpace (Ppsi ψ) := tauTop ψ ψ

/-- Equivalence `μ ∼ μ'` of two elements of `P_ψ(𝒞)`: mutual absolute continuity (p. 8). -/
def IsEquiv {d : ℕ} {T : ℝ≥0} {ψ : WeakMFG.Existence.Path d T → ℝ} (μ μ' : Ppsi ψ) : Prop :=
  μ.toMeasure ≪ μ'.toMeasure ∧ μ'.toMeasure ≪ μ.toMeasure

/-- `P(A)`: the Borel probability measures on the control set `A`, with the topology of weak
convergence (p. 9). Its σ-field, wherever measurability of a map into `P(A)` is asked for, is
`borel (PA A)` ("P(A) is endowed with the weak topology and its corresponding Borel σ-field",
p. 9). -/
abbrev PA {EA : Type*} [MeasurableSpace EA] (A : Set EA) : Type _ := ProbabilityMeasure A

/-- The base space (p. 8, Formalization Note D1): a probability space `(Ω, P)` carrying an
initial state `ξ` and a standard `d`-dimensional Brownian motion `W`, independent of each
other. The initial law is `λ₀ = P ∘ ξ⁻¹`.
**Formalization Note.** The paper works on the canonical space `Ω = ℝ^d × 𝒞` with
`P = λ₀ ⊗ Wiener measure`; this structure allows any probability space carrying such a pair, of
which the canonical space is an instance. -/
structure Base (d : ℕ) (Ω : Type*) [MeasurableSpace Ω] where
  /-- The probability measure. -/
  P : Measure Ω
  isProb : IsProbabilityMeasure P
  /-- The initial state. -/
  ξ : Ω → Fin d → ℝ
  meas_ξ : Measurable ξ
  /-- The driving Brownian motion. -/
  W : ℝ≥0 → Ω → Fin d → ℝ
  brownian : Peng1990.SMP.IsStdBrownian P W
  indep : IndepFun ξ (fun ω t => W t ω) P

namespace Base

variable {d : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The filtration `𝔽 = (𝓕_t)`: `𝓕_t` is the completion of `σ((ξ, W_s) : 0 ≤ s ≤ t)` by
`P`-null sets (p. 8). -/
noncomputable def filt (B : Base d Ω) : Filtration ℝ≥0 mΩ where
  seq t := MeasurableSpace.comap B.ξ inferInstance ⊔
    Peng1990.SMP.brownianFiltration B.brownian t ⊔ WeakMFG.Existence.nullSigma B.P
  mono' _ _ h := sup_le_sup_right (sup_le_sup_left
    ((Peng1990.SMP.brownianFiltration B.brownian).mono h) _) _
  le' t := sup_le (sup_le B.meas_ξ.comap_le ((Peng1990.SMP.brownianFiltration B.brownian).le t))
    (MeasurableSpace.generateFrom_le fun _ hs => hs.1)

/-- The admissible controls `𝔸` (S.1), p. 9: progressively measurable (for `𝔽`) processes with
values in the control set `A`. -/
def IsAdmissible {EA : Type*} [NormedAddCommGroup EA] (B : Base d Ω) (A : Set EA)
    (α : ℝ≥0 → Ω → EA) : Prop :=
  IsStronglyProgressive B.filt α ∧ ∀ t ω, α t ω ∈ A

end Base

end WeakMFG.Uniqueness


