    (try with_unfolding_none refine Light.Ends.skip ?_)
  refine ⟨rfl,?_,?_⟩
  · intro t ht
    have ht' : t<4 := by simpa only [row,List.length_cons,List.length_nil] using ht
    interval_cases t <;> simp [row]
  · intro a ha
    dsimp only
    repeat rw [Function.update_of_ne (by omega)]

