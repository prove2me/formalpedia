-- title:
--   Algorithm 1 — the squared smoothing Newton method: $\mathcal E$, $\hat{\mathcal E}$, $\psi$, $\zeta$, $\eta$, $\mathcal N$ and the runs
-- statement:
--   This module defines the smoothed system and Algorithm 1 (pp.12–14).
--
--   1. **Smoothed KKT map** ((18)–(19), p.12). For constants $\kappa_p,\kappa_c>0$,
--   $$\mathcal E(\epsilon,X,y,Z)=\big(\mathcal AX+\kappa_p|\epsilon|y-b;\ -\mathcal A^*y-Z+C;\ (1+\kappa_c|\epsilon|)X-\Phi(\epsilon,X-Z)\big),\qquad \hat{\mathcal E}=(\epsilon;\mathcal E).$$
--   2. **Merit and control functions** ((21)–(23)). $\psi=\|\hat{\mathcal E}\|^2$, $\zeta=r\min\{1,\|\hat{\mathcal E}\|^{1+\tau}\}$, $\eta=\min\{1,\hat r\|\hat{\mathcal E}\|^\tau\}$, and $\mathcal N=\{(\epsilon,X,y,Z):\epsilon\ge\zeta(\epsilon,X,y,Z)\hat\epsilon\}$ (p.14).
--   3. **Parameters** (Algorithm 1, line 1). $\hat\epsilon>0$, $r\in(0,1)$, $\hat r>0$, $\hat\eta\in(0,1)$ with $\delta:=\sqrt2\max\{r\hat\epsilon,\hat\eta\}<1$, $\rho\in(0,1)$, $\sigma\in(0,1/2)$, $\tau\in(0,1]$, and $\kappa_p,\kappa_c>0$.
--   4. **One iteration** (lines 3–9). If $\hat{\mathcal E}(w)\neq0$: choose any direction $\Delta$ with $\Delta\epsilon=-\epsilon+\zeta(w)\hat\epsilon$ and
--   $$\|\mathcal E(w)+\mathcal E'(w)\Delta\|\le\min\{\eta(w)\|\mathcal E(w)+\mathcal E'_\epsilon(w)\Delta\epsilon\|,\ \hat\eta\|\hat{\mathcal E}(w)\|\},\qquad(25)$$
--   let $\ell$ be the smallest nonnegative integer with $\psi(w+\rho^\ell\Delta)\le[1-2\sigma(1-\delta)\rho^\ell]\psi(w)$, and move to $w+\rho^\ell\Delta$.
--   5. **Runs.** An infinite sequence generated by Algorithm 1 starts at $(\hat\epsilon,X^0,y^0,Z^0)$ and consists of such iterations.
--
--   These are the objects of Theorems 2 and 3.
--
--   **Formalization Note** Norms are Euclidean on $\mathbb R\times\mathbb R^m\times\mathbb S^n\times\mathbb S^n$ (`WithLp 2` products). $\mathcal E'$ is the Fréchet derivative and $\mathcal E'_\epsilon\Delta\epsilon=\mathcal E'(w)(\Delta\epsilon,0,0,0)$; $\mathcal E$ is continuously differentiable where $\epsilon\neq0$. A run requires $\hat{\mathcal E}(w^k)\neq0$ at every $k$ (the algorithm never stops).
-- source:
--   Liang, Sun & Toh, A Squared Smoothing Newton Method for Semidefinite Programming, arXiv:2303.05825v4, (18), (19), (21)–(23), p.12; Algorithm 1, p.13; ℰ′, ℰ′_ε and 𝒩, p.14

import Mathlib
import Definitions.Def_HuberSNSDP_Setting

open scoped RealInnerProductSpace Topology
open Filter

namespace HuberSNSDP

/-! # The smoothed system `ℰ̂ = 0`, the merit function, and Algorithm 1

Liang, Sun & Toh, *A Squared Smoothing Newton Method for Semidefinite Programming*,
arXiv:2303.05825v4: `ℰ` (18), `ℰ̂` (19), `ψ` (21), `ζ` (22), `η` (23) (p.12); Algorithm 1 (p.13);
`ℰ′`, `ℰ̂′`, `ℰ′_ε` and the set `𝒩` (p.14).

**Formalization Note.**
* The iterates live in `ℝ × 𝕏 = WithLp 2 (ℝ × (Sⁿ × ℝᵐ × Sⁿ))`, and `ℰ̂` in
  `WithLp 2 (ℝ × ℝᵐ × Sⁿ × Sⁿ)`: all norms are Euclidean, so
  `ψ = ‖ℰ̂‖² = ε² + ‖𝒜X + κp|ε|y − b‖² + ‖−𝒜*y − Z + C‖_F² + ‖(1 + κc|ε|)X − Φ(ε, X − Z)‖_F²`.
* `ℰ′(w)` is `fderiv ℝ ℰ w`, and `ℰ′_ε(w)Δε` is `fderiv ℝ ℰ w (Δε, 0, 0, 0)`. `ℰ` is
  continuously differentiable wherever `ε ≠ 0` (p.12), which is where the algorithm evaluates it.
* Algorithm 1 is the relation `Step`: from an iterate `w` with `ℰ̂(w) ≠ 0` (the "else" branch),
  for **any** direction `Δ` meeting `Δε = −ε + ζ(w)ε̂` and the inexactness test (25), the next
  iterate is `w + ρ^ℓ Δ` with `ℓ` the **smallest** nonnegative integer passing the Armijo test of
  line 8. A run (`IsRun`) is an infinite sequence of such steps from `(ε⁰, X⁰, y⁰, Z⁰) = (ε̂, x⁰)`,
  i.e. "the infinite sequence generated by Algorithm 1". -/

noncomputable section

open SunNLSDP.Equiv

variable {n m : ℕ}

namespace SDPData

variable (D : SDPData n m)

/-- `ℰ(ε, X, y, Z) = (𝒜X + κp|ε|y − b; −𝒜*y − Z + C; (1 + κc|ε|)X − Φ(ε, X − Z))` (18), p.12. -/
def Emap (kp kc : ℝ) (w : ISpace n m) : ESpace n m :=
  ePt (D.opA (XOf w) + (kp * |epsOf w|) • yOf w - D.b) (-D.opAadj (yOf w) - ZOf w + D.C)
    ((1 + kc * |epsOf w|) • XOf w - Phi (epsOf w) (XOf w - ZOf w))

/-- `ℰ̂(ε, X, y, Z) = (ε; ℰ(ε, X, y, Z))` (19), p.12. -/
def Ehat (kp kc : ℝ) (w : ISpace n m) : EhatSpace n m :=
  WithLp.toLp 2 (epsOf w, D.Emap kp kc w)

end SDPData

/-- The input of Algorithm 1 (p.13) together with the constants `κp, κc > 0` of (18):
`ε̂ ∈ (0, ∞)`, `r ∈ (0, 1)`, `r̂ ∈ (0, ∞)`, `η̂ ∈ (0, 1)` with `δ := √2 max{rε̂, η̂} < 1`,
`ρ ∈ (0, 1)`, `σ ∈ (0, 1/2)`, `τ ∈ (0, 1]`. -/
structure Params where
  /-- `ε̂`, also the initial smoothing parameter `ε⁰` -/
  epsHat : ℝ
  /-- `r` in `ζ` (22) -/
  r : ℝ
  /-- `r̂` in `η` (23) -/
  rHat : ℝ
  /-- `η̂` in (25) -/
  etaHat : ℝ
  /-- the backtracking factor `ρ` -/
  rho : ℝ
  /-- the Armijo constant `σ` -/
  sigma : ℝ
  /-- the exponent `τ` in (22)–(23) -/
  tau : ℝ
  /-- `κp` in (18) -/
  kp : ℝ
  /-- `κc` in (18) -/
  kc : ℝ
  epsHat_pos : 0 < epsHat
  r_pos : 0 < r
  r_lt_one : r < 1
  rHat_pos : 0 < rHat
  etaHat_pos : 0 < etaHat
  etaHat_lt_one : etaHat < 1
  delta_lt_one : Real.sqrt 2 * max (r * epsHat) etaHat < 1
  rho_pos : 0 < rho
  rho_lt_one : rho < 1
  sigma_pos : 0 < sigma
  sigma_lt_half : sigma < 1 / 2
  tau_pos : 0 < tau
  tau_le_one : tau ≤ 1
  kp_pos : 0 < kp
  kc_pos : 0 < kc

namespace Params

/-- `δ := √2 max{rε̂, η̂}` (Algorithm 1, line 1). -/
def delta (θ : Params) : ℝ := Real.sqrt 2 * max (θ.r * θ.epsHat) θ.etaHat

end Params

variable (D : SDPData n m) (θ : Params)

/-- The merit function `ψ(ε, X, y, Z) := ‖ℰ̂(ε, X, y, Z)‖²` (21), p.12. -/
def psi (w : ISpace n m) : ℝ := ‖D.Ehat θ.kp θ.kc w‖ ^ 2

/-- `ζ(ε, X, y, Z) = r min{1, ‖ℰ̂(ε, X, y, Z)‖^{1+τ}}` (22), p.12. -/
def zeta (w : ISpace n m) : ℝ := θ.r * min 1 (‖D.Ehat θ.kp θ.kc w‖ ^ (1 + θ.tau))

/-- `η(ε, X, y, Z) = min{1, r̂‖ℰ̂(ε, X, y, Z)‖^τ}` (23), p.12. -/
def eta (w : ISpace n m) : ℝ := min 1 (θ.rHat * ‖D.Ehat θ.kp θ.kc w‖ ^ θ.tau)

/-- `𝒩 := {(ε, X, y, Z) : ε ≥ ζ(ε, X, y, Z)ε̂}` (p.14). -/
def NSet : Set (ISpace n m) := {w | zeta D θ w * θ.epsHat ≤ epsOf w}

/-- The direction `(Δε, 0, 0, 0)`, at which `ℰ′` gives `ℰ′_ε Δε`. -/
def epsDir (t : ℝ) : ISpace n m := wPt t 0

/-- Algorithm 1, line 7: `Δ = (Δε; ΔX; Δy; ΔZ)` is an admissible inexact Newton direction at `w`
when `Δε = −ε + ζ(w)ε̂` and (25) holds:
`‖ℛ‖ ≤ min{η(w)‖ℰ(w) + ℰ′_ε(w)Δε‖, η̂‖ℰ̂(w)‖}`, `ℛ := ℰ(w) + ℰ′(w)Δ`. -/
def Admissible (w Δ : ISpace n m) : Prop :=
  epsOf Δ = -epsOf w + zeta D θ w * θ.epsHat ∧
    ‖D.Emap θ.kp θ.kc w + fderiv ℝ (D.Emap θ.kp θ.kc) w Δ‖ ≤
      min (eta D θ w * ‖D.Emap θ.kp θ.kc w + fderiv ℝ (D.Emap θ.kp θ.kc) w (epsDir (epsOf Δ))‖)
        (θ.etaHat * ‖D.Ehat θ.kp θ.kc w‖)

/-- The Armijo test of Algorithm 1, line 8, for the step `ρ^ℓ`:
`ψ(w + ρ^ℓΔ) ≤ [1 − 2σ(1 − δ)ρ^ℓ] ψ(w)`. -/
def Armijo (w Δ : ISpace n m) (ℓ : ℕ) : Prop :=
  psi D θ (w + θ.rho ^ ℓ • Δ) ≤ (1 - 2 * θ.sigma * (1 - θ.delta) * θ.rho ^ ℓ) * psi D θ w

/-- One iteration of Algorithm 1 (lines 3–9) from `w` to `w'`: `ℰ̂(w) ≠ 0`, and for some admissible
direction `Δ` and the smallest `ℓ ∈ ℕ` passing the Armijo test, `w' = w + ρ^ℓ Δ`. -/
def Step (w w' : ISpace n m) : Prop :=
  D.Ehat θ.kp θ.kc w ≠ 0 ∧ ∃ Δ, Admissible D θ w Δ ∧ ∃ ℓ : ℕ, Armijo D θ w Δ ℓ ∧
    (∀ ℓ' < ℓ, ¬ Armijo D θ w Δ ℓ') ∧ w' = w + θ.rho ^ ℓ • Δ

/-- The starting point `(ε⁰, X⁰, y⁰, Z⁰) = (ε̂, X⁰, y⁰, Z⁰)` (line 1). -/
def start (x0 : XSpace n m) : ISpace n m := wPt θ.epsHat x0

/-- An infinite sequence generated by Algorithm 1 from `x⁰ = (X⁰, y⁰, Z⁰)`: it starts at
`(ε̂, x⁰)` and every consecutive pair is an iteration `Step` (in particular `ℰ̂(wᵏ) ≠ 0` for all `k`,
the algorithm never stops). -/
def IsRun (x0 : XSpace n m) (w : ℕ → ISpace n m) : Prop :=
  w 0 = start θ x0 ∧ ∀ k, Step D θ (w k) (w (k + 1))

end

end HuberSNSDP


