  rcases mem_ctlOf hc with rfl | rfl | ⟨l, hl, rfl⟩ <;>
    simp only [J6Seg.dropC, List.mem_cons, List.not_mem_nil, or_false] at hy <;>
    rcases hy with rfl | rfl
  · rw [zsz_neg, zsz_one]; exact hZ
  · rw [zsz_zero]; omega
  · rw [zsz_zero]; omega
  · rw [zsz_zero]; omega
  · rw [zsz_one]; exact hZ
  · exact ha l hl

