namespace LCA

/-- If `‖j • t‖ ≤ 1/4` for `j = 1, …, M` then `‖t‖ ≤ 1/(4M)`. -/
lemma circle_small (t : UnitAddCircle) (M : ℕ) (hM : 0 < M)
    (h : ∀ j : ℕ, 1 ≤ j → j ≤ M → ‖j • t‖ ≤ 1 / 4) : ‖t‖ ≤ 1 / (4 * M) := by
  obtain ⟨u, hu, rfl⟩ : ∃ u : ℝ, |u| ≤ 1 / 2 ∧ (u : UnitAddCircle) = t := by
    refine ⟨(AddCircle.equivIoc 1 (-1 / 2) t : ℝ), ?_, ?_⟩
    · have h1 := (AddCircle.equivIoc 1 (-1 / 2) t).2
      rw [abs_le]; constructor
      · linarith [h1.1]
      · linarith [h1.2]
    · exact (AddCircle.equivIoc 1 (-1 / 2)).symm_apply_apply t
  have hn : ∀ x : ℝ, |x| ≤ 1 / 2 → ‖(x : UnitAddCircle)‖ = |x| := fun x hx =>
    (AddCircle.norm_coe_eq_abs_iff (p := 1) one_ne_zero).2 (by simpa using hx)
  rw [hn u hu]
  have hMpos : (0 : ℝ) < M := by exact_mod_cast hM
  by_contra hcon
  push Not at hcon
  have hupos : 0 < |u| := lt_of_le_of_lt (by positivity) hcon
  by_cases hq : |u| ≤ 1 / 4
  · set j := ⌊1 / (4 * |u|)⌋₊ + 1 with hjdef
    have hj1 : (1 / (4 * |u|) : ℝ) < j := by
      have := Nat.lt_floor_add_one (1 / (4 * |u|)); push_cast [hjdef]; linarith
    have hj2 : (j : ℝ) ≤ 1 / (4 * |u|) + 1 := by
      have := Nat.floor_le (show (0 : ℝ) ≤ 1 / (4 * |u|) by positivity); push_cast [hjdef]; linarith
    have hjM : j ≤ M := by
      have h1 : (1 / (4 * |u|) : ℝ) < M := by
        rw [div_lt_iff₀ (by positivity)]
        rw [div_lt_iff₀ (by positivity)] at hcon
        nlinarith
      have : ⌊1 / (4 * |u|)⌋₊ < M := Nat.floor_lt' (by omega) |>.2 h1
      omega
    have hA : 1 / 4 < (j : ℝ) * |u| := by
      have := mul_lt_mul_of_pos_right hj1 hupos
      have e : 1 / (4 * |u|) * |u| = 1 / 4 := by field_simp
      linarith
    have hB : (j : ℝ) * |u| ≤ 1 / 2 := by
      have := mul_le_mul_of_nonneg_right hj2 hupos.le
      have e : (1 / (4 * |u|) + 1) * |u| = 1 / 4 + |u| := by field_simp
      linarith
    have hj := h j (by omega) hjM
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul, hn _ (by rw [abs_mul, Nat.abs_cast]; linarith),
      abs_mul, Nat.abs_cast] at hj
    linarith
  · have h1 := h 1 le_rfl (by omega)
    rw [one_smul, hn u hu] at h1
    linarith

/-- Continuous characters of `ℝ`. -/
lemma charR (g : ℝ → UnitAddCircle) (hg : ∀ s t, g (s + t) = g s + g t) (hgc : Continuous g) :
    ∃ c : ℝ, ∀ t, g t = ((c * t : ℝ) : UnitAddCircle) := by
  let q : Multiplicative ℝ →* Multiplicative UnitAddCircle :=
    AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' _)
  have hq : ∀ x, q x = Multiplicative.ofAdd ((Multiplicative.toAdd x : ℝ) : UnitAddCircle) :=
    fun _ => rfl
  have hqc : Continuous q :=
    continuous_ofAdd.comp (QuotientAddGroup.continuous_mk.comp continuous_toAdd)
  have hqo : IsOpenMap q :=
    isOpenMap_ofAdd'.comp (QuotientAddGroup.isOpenMap_coe.comp isOpenMap_toAdd')
  have hloc : ∃ N ∈ 𝓝 (1 : Multiplicative ℝ), ∀ x ∈ N, ∀ y ∈ N, q x = q y → x = y := by
    refine ⟨Multiplicative.toAdd ⁻¹' Metric.ball 0 (1 / 4),
      continuous_toAdd.continuousAt.preimage_mem_nhds (Metric.ball_mem_nhds _ (by norm_num)), ?_⟩
    intro x hx y hy hxy
    rw [hq, hq] at hxy
    have h1 : ((Multiplicative.toAdd x : ℝ) : UnitAddCircle) = (Multiplicative.toAdd y : ℝ) :=
      Multiplicative.ofAdd.injective hxy
    obtain ⟨n, hn⟩ := (QuotientAddGroup.eq).1 h1
    simp only [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, mem_preimage] at hx hy
    have hn' : (n : ℝ) = -Multiplicative.toAdd x + Multiplicative.toAdd y := by
      simpa using hn
    have : |(n : ℝ)| < 1 := by
      rw [hn']
      have h2 := abs_add_le (-Multiplicative.toAdd x) (Multiplicative.toAdd y)
      rw [abs_neg] at h2
      linarith
    have hn0 : n = 0 := by
      have h : |n| < 1 := by exact_mod_cast this
      rw [abs_lt] at h
      omega
    rw [hn0, Int.cast_zero] at hn'
    have : Multiplicative.toAdd x = Multiplicative.toAdd y := by linarith
    exact Multiplicative.toAdd.injective this
  have hopen : ∀ N ∈ 𝓝 (1 : Multiplicative ℝ), ∃ V ∈ 𝓝 (1 : Multiplicative UnitAddCircle),
      ∀ y ∈ V, y ∈ q.range → ∃ x ∈ N, q x = y := by
    intro N hN
    refine ⟨q '' N, ?_, fun y hy _ => hy⟩
    have := hqo.image_mem_nhds hN
    rwa [map_one] at this
  obtain ⟨G', hG'c, hG'hom, hG'q⟩ := lift_one_param q hqc hloc hopen
    (fun t => Multiplicative.ofAdd (g t)) (fun s t => by rw [hg, ofAdd_add])
    (continuous_ofAdd.comp hgc) (fun t => by
      obtain ⟨x, hx⟩ := QuotientAddGroup.mk_surjective (g t)
      exact ⟨Multiplicative.ofAdd x, by rw [hq, toAdd_ofAdd, hx]⟩)
  have hG'0 : G' 0 = 1 := by
    have h := hG'hom 0 0
    rw [add_zero] at h
    have := congrArg (fun z => z * (G' 0)⁻¹) h
    simpa using this.symm
  let f : ℝ →+ ℝ :=
    { toFun := fun t => Multiplicative.toAdd (G' t)
      map_zero' := by rw [hG'0]; rfl
      map_add' := fun s t => by rw [hG'hom, toAdd_mul] }
  have hfc : Continuous f := continuous_toAdd.comp hG'c
  refine ⟨f 1, fun t => ?_⟩
  have h1 : f t = t * f 1 := by
    have := map_real_smul f hfc t 1
    simpa using this
  have h2 := hG'q t
  rw [hq] at h2
  have h3 : ((Multiplicative.toAdd (G' t) : ℝ) : UnitAddCircle) = g t :=
    Multiplicative.ofAdd.injective h2
  rw [← h3]
  show ((f t : ℝ) : UnitAddCircle) = _
  rw [h1, mul_comm]

/-- Continuous characters of `𝕋`. -/
lemma charT (η : UnitAddCircle → UnitAddCircle) (hη : ∀ s t, η (s + t) = η s + η t)
    (hηc : Continuous η) : ∃ l : ℤ, ∀ θ, η θ = l • θ := by
  obtain ⟨c, hc⟩ := charR (fun t => η (t : UnitAddCircle))
    (fun s t => by rw [AddCircle.coe_add, hη]) (hηc.comp QuotientAddGroup.continuous_mk)
  have h0 : η 0 = 0 := by
    have := hη 0 0; rw [add_zero] at this
    have := congrArg (fun z => z - η 0) this; simpa using this.symm
  have h1 : ((c : ℝ) : UnitAddCircle) = 0 := by
    have := hc 1
    rw [mul_one, AddCircle.coe_period] at this
    rw [← this, h0]
  obtain ⟨l, hl⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 h1
  refine ⟨l, fun θ => ?_⟩
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective θ
  show η (t : UnitAddCircle) = l • (t : UnitAddCircle)
  rw [hc t, ← hl, zsmul_one, ← AddCircle.coe_zsmul, zsmul_eq_mul]

/-- The basic character of `ZMod d`. -/
noncomputable def zchar (d : ℕ) (b : ZMod d) : UnitAddCircle := (((b.val : ℝ) / d : ℝ) : UnitAddCircle)

lemma zchar_add (d : ℕ) [NeZero d] (a b : ZMod d) : zchar d (a + b) = zchar d a + zchar d b := by
  unfold zchar
  have hd : (0 : ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne d)
  have h := ZMod.val_add a b
  have hdiv := Nat.mod_add_div (a.val + b.val) d
  set q := (a.val + b.val) / d
  have e : (((a + b).val : ℝ) / d) = (a.val : ℝ) / d + (b.val : ℝ) / d - q := by
    rw [h]
    have : (((a.val + b.val) % d : ℕ) : ℝ) = (a.val : ℝ) + b.val - d * q := by
      have := congrArg (fun z : ℕ => (z : ℝ)) hdiv
      push_cast at this
      linarith
    rw [this]
    field_simp
  rw [e, AddCircle.coe_sub, AddCircle.coe_add]
  have hq : ((q : ℝ) : UnitAddCircle) = 0 :=
    (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).2 ⟨q, by simp⟩
  rw [hq, sub_zero]

/-- Characters of `ZMod d`. -/
lemma charZMod (d : ℕ) [NeZero d] (ζ : ZMod d → UnitAddCircle)
    (hζ : ∀ a b, ζ (a + b) = ζ a + ζ b) : ∃ j : ℤ, ∀ b, ζ b = j • zchar d b := by
  have hd : (0 : ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne d)
  have hnat : ∀ (k : ℕ) (b : ZMod d), ζ ((k : ZMod d) * b) = k • ζ b := by
    intro k b
    induction k with
    | zero =>
      simp only [Nat.cast_zero, zero_mul, zero_smul]
      have := hζ 0 0; rw [add_zero] at this
      have := congrArg (fun z => z - ζ 0) this; simpa using this.symm
    | succ k ih => rw [Nat.cast_succ, add_mul, one_mul, hζ, ih, succ_nsmul]
  obtain ⟨u, hu⟩ := QuotientAddGroup.mk_surjective (ζ 1)
  have hdu : ((d * u : ℝ) : UnitAddCircle) = 0 := by
    have := hnat d 1
    rw [ZMod.natCast_self, zero_mul] at this
    rw [← nsmul_eq_mul, AddCircle.coe_nsmul]
    change d • ((u : ℝ) : UnitAddCircle) = 0
    have hu' : ((u : ℝ) : UnitAddCircle) = ζ 1 := hu
    rw [hu', ← this]
    have h0 := hζ 0 0; rw [add_zero] at h0
    have := congrArg (fun z => z - ζ 0) h0; simpa using this.symm
  obtain ⟨j, hj⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 hdu
  rw [zsmul_one] at hj
  refine ⟨j, fun b => ?_⟩
  have hb : b = (b.val : ZMod d) * 1 := by rw [mul_one, ZMod.natCast_zmod_val]
  rw [hb, hnat, mul_one, ZMod.natCast_zmod_val]
  unfold zchar
  have hu' : ((u : ℝ) : UnitAddCircle) = ζ 1 := hu
  rw [← hu', ← AddCircle.coe_nsmul, ← AddCircle.coe_zsmul]
  congr 1
  rw [nsmul_eq_mul, zsmul_eq_mul]
  have : u = j / d := by rw [hj]; field_simp
  rw [this]
  ring

end LCA

end AnnihA_sec

section AnnihB_sec

open Set Filter Topology

namespace LCA

/-- The identification `𝕋 ≃ₜ Circle`. -/
noncomputable def ecirc : UnitAddCircle ≃ₜ Circle := AddCircle.homeomorphCircle one_ne_zero

lemma ecirc_apply (t : UnitAddCircle) : ecirc t = AddCircle.toCircle t :=
  AddCircle.homeomorphCircle_apply _ t

lemma ecirc_add (s t : UnitAddCircle) : ecirc (s + t) = ecirc s * ecirc t := by
  rw [ecirc_apply, ecirc_apply, ecirc_apply, AddCircle.toCircle_add]

lemma ecirc_zero : ecirc 0 = 1 := by
  rw [ecirc_apply]
  simpa using (AddCircle.toCircle_nsmul (0 : UnitAddCircle) 0)

lemma ecirc_symm_mul (a b : Circle) : ecirc.symm (a * b) = ecirc.symm a + ecirc.symm b := by
  apply ecirc.injective
  rw [ecirc_add, ecirc.apply_symm_apply, ecirc.apply_symm_apply, ecirc.apply_symm_apply]

lemma ecirc_symm_one : ecirc.symm 1 = 0 := by
  apply ecirc.injective; rw [ecirc.apply_symm_apply, ecirc_zero]

lemma ecirc_symm_pow (a : Circle) (j : ℕ) : ecirc.symm (a ^ j) = j • ecirc.symm a := by
  induction j with
  | zero => simp [ecirc_symm_one]
  | succ j ih => rw [pow_succ, ecirc_symm_mul, ih, succ_nsmul]

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Additive version of a character. -/
noncomputable def ca (χ : G →ₜ* Circle) (g : G) : UnitAddCircle := ecirc.symm (χ g)

lemma ca_mul (χ : G →ₜ* Circle) (g h : G) : ca χ (g * h) = ca χ g + ca χ h := by
  unfold ca; rw [map_mul, ecirc_symm_mul]

lemma ca_hmul (χ ψ : G →ₜ* Circle) (g : G) : ca (χ * ψ) g = ca χ g + ca ψ g := by
  unfold ca; rw [ContinuousMonoidHom.mul_apply, ecirc_symm_mul]

lemma ca_one (g : G) : ca (1 : G →ₜ* Circle) g = 0 := by
  show ecirc.symm (1 : Circle) = 0
  exact ecirc_symm_one

lemma ca_inv (χ : G →ₜ* Circle) (g : G) : ca χ⁻¹ g = - ca χ g := by
  have h := ca_hmul χ⁻¹ χ g
  rw [inv_mul_cancel, ca_one] at h
  rw [eq_neg_iff_add_eq_zero]
  exact h.symm

lemma ca_zpow (χ : G →ₜ* Circle) (n : ℤ) (g : G) : ca (χ ^ n) g = n • ca χ g := by
  induction n using Int.induction_on with
  | zero => simp [ca_one]
  | succ k ih => rw [zpow_add_one, ca_hmul, ih, add_smul, one_smul]
  | pred k ih => rw [zpow_sub_one, ca_hmul, ca_inv, ih, sub_smul, one_smul, sub_eq_add_neg]

lemma ca_eq_one {χ : G →ₜ* Circle} {g : G} (h : ca χ g = 0) : χ g = 1 := by
  have := congrArg ecirc h
  unfold ca at this
  rwa [ecirc.apply_symm_apply, ecirc_zero] at this

lemma ca_ext {χ ψ : G →ₜ* Circle} (h : ∀ g, ca χ g = ca ψ g) : χ = ψ := by
  ext g
  have := congrArg ecirc (h g)
  unfold ca at this
  rw [ecirc.apply_symm_apply, ecirc.apply_symm_apply] at this
  rw [this]

/-- Build a character from an additive continuous homomorphism into `𝕋`. -/
noncomputable def mkChar (f : G → UnitAddCircle) (hf : ∀ g h, f (g * h) = f g + f h)
    (hfc : Continuous f) : G →ₜ* Circle where
  toFun g := ecirc (f g)
  map_one' := by
    have h := hf 1 1
    rw [one_mul] at h
    have : f 1 = 0 := by
      have := congrArg (fun z => z - f 1) h; simpa using this.symm
    rw [this, ecirc_zero]
  map_mul' g h := by rw [hf, ecirc_add]
  continuous_toFun := ecirc.continuous.comp hfc

lemma ca_mkChar (f : G → UnitAddCircle) (hf : ∀ g h, f (g * h) = f g + f h)
    (hfc : Continuous f) (g : G) : ca (mkChar f hf hfc) g = f g := by
  show ecirc.symm (ecirc (f g)) = f g
  exact ecirc.symm_apply_apply _

/-- **Extension of characters** from an open subgroup (the circle is divisible). -/
lemma exists_ext (Γ : Subgroup G) (hΓ : IsOpen (Γ : Set G)) (φ : Γ → UnitAddCircle)
    (hφ : ∀ a b, φ (a * b) = φ a + φ b) (hφc : Continuous φ) :
    ∃ χ : G →ₜ* Circle, ∀ γ : Γ, ca χ γ = φ γ := by
  let f : Additive Γ →+ Additive G := MonoidHom.toAdditive Γ.subtype
  have hf : Function.Injective f := Subtype.val_injective
  let g : Additive Γ →+ UnitAddCircle :=
    { toFun := fun x => φ (Additive.toMul x)
      map_zero' := by
        have h := hφ 1 1; rw [one_mul] at h
        show φ 1 = 0
        have := congrArg (fun z => z - φ 1) h; simpa using this.symm
      map_add' := fun x y => hφ _ _ }
  obtain ⟨h, hh⟩ := Module.Baer.extension_property_addMonoidHom
    (Module.Baer.of_divisible (A := UnitAddCircle)) f hf g
  let F : G → UnitAddCircle := fun x => h (Additive.ofMul x)
  have hFmul : ∀ x y, F (x * y) = F x + F y := fun x y => by
    show h (Additive.ofMul (x * y)) = _
    rw [ofMul_mul, map_add]
  have hFΓ : ∀ γ : Γ, F γ = φ γ := fun γ => by
    have := congrArg (fun F => F (Additive.ofMul γ)) hh
    exact this
  let Fm : G →* Multiplicative UnitAddCircle :=
    { toFun := fun x => Multiplicative.ofAdd (F x)
      map_one' := by
        have h1 := hFmul 1 1; rw [one_mul] at h1
        have : F 1 = 0 := by
          have := congrArg (fun z => z - F 1) h1; simpa using this.symm
        rw [this]; rfl
      map_mul' := fun x y => by rw [hFmul]; rfl }
  have hFmc : Continuous Fm := by
    apply continuous_of_continuousAt_one Fm
    have hcomp : Continuous (fun γ : Γ => Fm γ) := by
      have : (fun γ : Γ => Fm γ) = fun γ => Multiplicative.ofAdd (φ γ) :=
        funext fun γ => by show Multiplicative.ofAdd (F γ) = _; rw [hFΓ]
      rw [this]
      exact continuous_ofAdd.comp hφc
    have hon : ContinuousOn Fm Γ := by
      rw [continuousOn_iff_continuous_domRestrict]
      exact hcomp
    exact hon.continuousAt (hΓ.mem_nhds Γ.one_mem)
  have hFc : Continuous F := continuous_toAdd.comp hFmc
  exact ⟨mkChar F hFmul hFc, fun γ => by rw [ca_mkChar, hFΓ]⟩

/-- The small closed arc. -/
def arcW : Set Circle := ecirc '' Metric.closedBall 0 (1 / 4)

/-- Characters small on a compact neighbourhood of `1` form a compact set. -/
lemma isCompact_small_chars (C₀ : Set G) (hC₀c : IsCompact C₀) (hC₀ : C₀ ∈ 𝓝 (1 : G)) :
    IsCompact {χ : G →ₜ* Circle | MapsTo χ C₀ arcW} := by
  have hWc : IsCompact arcW := (isCompact_closedBall _ _).image ecirc.continuous
  let S1 : Set (G →* Circle) := {f | MapsTo f C₀ arcW}
  have h : EquicontinuousAt (fun f : S1 => (f : G → Circle)) 1 := by
    refine Metric.equicontinuousAt_iff_right.2 ?_
    intro ε hε
    obtain ⟨δ, hδ, hδε⟩ := Metric.continuousAt_iff.1 ecirc.continuous.continuousAt ε hε
    let M : ℕ := ⌈1 / (4 * δ)⌉₊ + 1
    have hM : 0 < M := Nat.succ_pos _
    have hMδ : 1 / (4 * (M : ℝ)) < δ := by
      have h1 : 1 / (4 * δ) < (M : ℝ) := by
        have := Nat.le_ceil (1 / (4 * δ)); push_cast [M]; linarith
      rw [div_lt_iff₀ (by positivity)]
      rw [div_lt_iff₀ (by positivity)] at h1
      nlinarith
    have hev : ∀ᶠ x in 𝓝 (1 : G), ∀ j ∈ Finset.Icc 1 M, x ^ j ∈ C₀ :=
      (Finset.Icc 1 M).eventually_all.2 fun j _ =>
        (continuous_pow j).continuousAt.preimage_mem_nhds (by simpa using hC₀)
    filter_upwards [hev] with x hx
    rintro ⟨f, hf⟩
    simp only
    set t := ecirc.symm (f x)
    have hjt : ∀ j : ℕ, 1 ≤ j → j ≤ M → ‖j • t‖ ≤ 1 / 4 := by
      intro j hj1 hjM
      have hmem := hf (hx j (Finset.mem_Icc.2 ⟨hj1, hjM⟩))
      obtain ⟨u, hu, hue⟩ := hmem
      have : ecirc.symm (f (x ^ j)) = j • t := by rw [map_pow, ecirc_symm_pow]
      rw [← this, ← hue, ecirc.symm_apply_apply]
      simpa using hu
    have hsmall : ‖t‖ < δ := lt_of_le_of_lt (circle_small t M hM hjt) hMδ
    have := hδε (x := t) (by rw [dist_zero_right]; exact hsmall)
    rw [ecirc.apply_symm_apply, ecirc_zero] at this
    rw [map_one]
    rwa [dist_comm]
  replace h := equicontinuous_of_equicontinuousAt_one _ h
  let S2 : Set (G →ₜ* Circle) := {f | MapsTo f C₀ arcW}
  let S3 : Set C(G, Circle) := (↑) '' S2
  let S4 : Set (G → Circle) := (↑) '' S3
  have hS4 : S4 = (↑) '' S1 := by
    ext
    constructor
    · rintro ⟨-, ⟨f, hf, rfl⟩, rfl⟩
      exact ⟨f, hf, rfl⟩
    · rintro ⟨f, hf, rfl⟩
      exact ⟨⟨f, h.continuous ⟨f, hf⟩⟩, ⟨⟨f, h.continuous ⟨f, hf⟩⟩, hf, rfl⟩, rfl⟩
  replace h : Equicontinuous ((↑) : S3 → G → Circle) := by
    have e1 : range ((↑) : S3 → G → Circle) =
        range (fun f : S1 => ((f : G →* Circle) : G → Circle)) := by
      rw [← image_eq_range, ← image_eq_range]; exact hS4
    rw [equicontinuous_iff_range] at h ⊢
    rw [e1]; exact h
  replace hS4 : S4 = Set.pi C₀ (fun _ ↦ arcW) ∩ Set.range ((↑) : (G →* Circle) → (G → Circle)) := by
    simp_rw [hS4, Set.ext_iff, Set.mem_image, S1, Set.mem_ofPred_eq]
    exact fun f ↦ ⟨fun ⟨g, hg, hf⟩ ↦ hf ▸ ⟨hg, g, rfl⟩, fun ⟨hg, g, hf⟩ ↦ ⟨g, hf ▸ hg, hf⟩⟩
  replace hS4 : IsClosed S4 :=
    hS4.symm ▸ (isClosed_set_pi (fun _ _ ↦ hWc.isClosed)).inter (MonoidHom.isClosed_range_coe G Circle)
  exact (ContinuousMonoidHom.isInducing_toContinuousMap G Circle).isCompact_iff.mpr
      (ArzelaAscoli.isCompact_of_equicontinuous S3 hS4.isCompact h)

end LCA

end AnnihB_sec

section AnnihC_sec

open Set Filter Topology

namespace LCA

section

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]

lemma ca_prod {ι : Type*} (s : Finset ι) (f : ι → G →ₜ* Circle) (g : G) :
    ca (∏ i ∈ s, f i) g = ∑ i ∈ s, ca (f i) g := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [ca_one]
  | insert a s ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, ca_hmul, ih]

lemma ca_one' (χ : G →ₜ* Circle) : ca χ 1 = 0 := by
  unfold ca; rw [map_one, ecirc_symm_one]

lemma ca_ginv (χ : G →ₜ* Circle) (g : G) : ca χ g⁻¹ = - ca χ g := by
  have h := ca_mul χ g⁻¹ g
  rw [inv_mul_cancel, ca_one'] at h
  rw [eq_neg_iff_add_eq_zero]; exact h.symm

end

lemma coe_sum_circle {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    (((∑ i ∈ s, f i : ℝ)) : UnitAddCircle) = ∑ i ∈ s, ((f i : ℝ) : UnitAddCircle) :=
  map_sum (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ))) f s

lemma cont_single {ι : Type*} [DecidableEq ι] {M : Type*} [TopologicalSpace M] [Zero M] (i : ι) :
    Continuous (fun t : M => (Pi.single i t : ι → M)) := continuous_pi fun j => by
  by_cases h : j = i
  · subst h; simp only [Pi.single_eq_same]; exact continuous_id'
  · simpa [Pi.single_apply, h] using continuous_const

lemma zchar_zero (d : ℕ) : zchar d 0 = 0 := by simp [zchar]

theorem annih_main (G : Type*) [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [T2Space G] [LocallyCompactSpace G]
    (k Γ : Subgroup G) (hΓ : IsOpen (Γ : Set G)) (hkΓ : k ≤ Γ)
    {m n r s : ℕ} {d : Fin s → ℕ} (π : Γ →* Multiplicative (ElemG m n r s d))
    (hd : ∀ i, d i ≠ 0) (hπc : Continuous π) (hπo : IsOpenMap π) (hπs : Function.Surjective π)
    (hπk : ∀ x : Γ, π x = 1 ↔ (x : G) ∈ k) :
    ∃ A : Subgroup (G →ₜ* Circle), (A : Set (G →ₜ* Circle)) = {χ | ∀ x ∈ k, χ x = 1} ∧
      ∃ U : Set (G →ₜ* Circle), IsCompact U ∧ U ⊆ A ∧
        (∃ V ∈ 𝓝 (1 : G →ₜ* Circle), V ∩ A ⊆ U) ∧ Subgroup.closure U = A := by
  classical
  -- the annihilator
  let A : Subgroup (G →ₜ* Circle) :=
    { carrier := {χ | ∀ x ∈ k, ca χ x = 0}
      mul_mem' := fun {a b} ha hb x hx => by rw [ca_hmul, ha x hx, hb x hx, add_zero]
      one_mem' := fun x _ => ca_one x
      inv_mem' := fun {a} ha x hx => by rw [ca_inv, ha x hx, neg_zero] }
  have hAset : (A : Set (G →ₜ* Circle)) = {χ | ∀ x ∈ k, χ x = 1} := by
    ext χ
    constructor
    · intro h x hx; exact ca_eq_one (h x hx)
    · intro h x hx
      show ecirc.symm (χ x) = 0
      rw [h x hx, ecirc_symm_one]
  have hAcl : IsClosed (A : Set (G →ₜ* Circle)) := by
    rw [hAset]
    have : {χ : G →ₜ* Circle | ∀ x ∈ k, χ x = 1} = ⋂ x ∈ k, {χ | χ x = 1} := by
      ext; simp
    rw [this]
    exact isClosed_biInter fun x _ => isClosed_eq
      (continuous_eval_const x) continuous_const
  let ecoord : Γ → ElemG m n r s d := fun γ => Multiplicative.toAdd (π γ)
  have hecoord_mul : ∀ a b : Γ, ecoord (a * b) = ecoord a + ecoord b := fun a b => by
    simp only [ecoord, map_mul, toAdd_mul]
  have hecoord_c : Continuous ecoord := continuous_toAdd.comp hπc
  have hmemA : ∀ (χ : G →ₜ* Circle) (Φ : ElemG m n r s d → UnitAddCircle), Φ 0 = 0 →
      (∀ γ : Γ, ca χ γ = Φ (ecoord γ)) → χ ∈ A := by
    intro χ Φ h0 h x hx
    have := h ⟨x, hkΓ hx⟩
    simp only [ecoord] at this
    rw [(hπk ⟨x, hkΓ hx⟩).2 hx, toAdd_one, h0] at this
    exact this
  -- the compact neighbourhood `C₀`
  obtain ⟨K₁, hK₁c, hK₁⟩ := exists_compact_mem_nhds (1 : G)
  let Bset : Set (Multiplicative (ElemG m n r s d)) := Multiplicative.toAdd ⁻¹'
    (Metric.closedBall 0 1 ×ˢ (univ ×ˢ ({0} ×ˢ {0})))
  have hBcl : IsClosed Bset :=
    (Metric.isClosed_closedBall.prod (isClosed_univ.prod
      (isClosed_singleton.prod isClosed_singleton))).preimage continuous_toAdd
  have hB1 : Bset ∈ 𝓝 (1 : Multiplicative (ElemG m n r s d)) := by
    apply continuous_toAdd.continuousAt.preimage_mem_nhds
    rw [toAdd_one]
    exact prod_mem_nhds (Metric.closedBall_mem_nhds _ one_pos) (prod_mem_nhds univ_mem
      (prod_mem_nhds ((isOpen_discrete _).mem_nhds (mem_singleton _))
        ((isOpen_discrete _).mem_nhds (mem_singleton _))))
  have hΓcl : IsClosed (Γ : Set G) := Subgroup.isClosed_of_isOpen Γ hΓ
  let C₀ : Set G := K₁ ∩ Subtype.val '' (π ⁻¹' Bset)
  have hC₀c : IsCompact C₀ := hK₁c.inter_right
    (hΓcl.isClosedEmbedding_subtypeVal.isClosedMap _ (hBcl.preimage hπc))
  have hC₀ : C₀ ∈ 𝓝 (1 : G) := by
    refine inter_mem hK₁ ?_
    have := hΓ.isOpenMap_subtype_val.image_mem_nhds
      (hπc.continuousAt.preimage_mem_nhds (by rw [map_one]; exact hB1))
    exact this
  have hC₀Γ : ∀ g ∈ C₀, ∃ γ : Γ, (γ : G) = g ∧ ‖(ecoord γ).1‖ ≤ 1 ∧
      (ecoord γ).2.2.1 = 0 ∧ (ecoord γ).2.2.2 = 0 := by
    rintro g ⟨-, γ, hγ, rfl⟩
    obtain ⟨h1, -, h3, h4⟩ := hγ
    exact ⟨γ, rfl, by simpa using h1, h3, h4⟩
  -- generators
  have hθ : ∀ i : Fin n, ∃ χ : G →ₜ* Circle, ∀ γ : Γ, ca χ γ = (ecoord γ).2.1 i := fun i =>
    exists_ext Γ hΓ (fun γ => (ecoord γ).2.1 i) (fun a b => by rw [hecoord_mul]; rfl)
      ((continuous_apply i).comp (continuous_fst.comp (continuous_snd.comp hecoord_c)))
  choose εc hεc using hθ
  have hδ : ∀ i : Fin s, ∃ χ : G →ₜ* Circle, ∀ γ : Γ,
      ca χ γ = zchar (d i) ((ecoord γ).2.2.2 i) := fun i => by
    haveI : NeZero (d i) := ⟨hd i⟩
    exact exists_ext Γ hΓ (fun γ => zchar (d i) ((ecoord γ).2.2.2 i))
      (fun a b => by rw [hecoord_mul]; exact zchar_add _ _ _)
      ((continuous_of_discreteTopology (f := zchar (d i))).comp ((continuous_apply i).comp
        (continuous_snd.comp (continuous_snd.comp (continuous_snd.comp hecoord_c)))))
  choose δc hδc using hδ
  have hεA : ∀ i, εc i ∈ A := fun i => hmemA _ (fun e => e.2.1 i) rfl (hεc i)
  have hδA : ∀ i, δc i ∈ A := fun i =>
    hmemA _ (fun e => zchar (d i) (e.2.2.2 i)) (zchar_zero _) (hδc i)
  let U₀ : Set (G →ₜ* Circle) := {χ | MapsTo χ C₀ arcW} ∩ A
  let U : Set (G →ₜ* Circle) := U₀ ∪ range εc ∪ range δc
  have hU₀c : IsCompact U₀ := (isCompact_small_chars C₀ hC₀c hC₀).inter_right hAcl
  have hUc : IsCompact U :=
    (hU₀c.union (finite_range εc).isCompact).union (finite_range δc).isCompact
  have hUA : U ⊆ A := by
    rintro χ ((⟨-, h⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
    exacts [h, hεA i, hδA i]
  have hW0 : ∀ χ : G →ₜ* Circle, (∀ g ∈ C₀, ‖ca χ g‖ ≤ 1 / 4) → MapsTo χ C₀ arcW := by
    intro χ h g hg
    refine ⟨ca χ g, by rw [mem_closedBall_zero_iff]; exact h g hg, ?_⟩
    unfold ca; exact ecirc.apply_symm_apply _
  refine ⟨A, hAset, U, hUc, hUA, ?_, ?_⟩
  · let arcO : Set Circle := ecirc '' Metric.ball 0 (1 / 4)
    have hO : IsOpen arcO := ecirc.isOpenMap _ Metric.isOpen_ball
    refine ⟨{χ | MapsTo χ C₀ arcO}, ?_, ?_⟩
    · apply IsOpen.mem_nhds
      · exact isOpen_induced (ContinuousMap.isOpen_setOfPred_mapsTo hC₀c hO)
      · intro g _; exact ⟨0, Metric.mem_ball_self (by norm_num), ecirc_zero⟩
    · rintro χ ⟨hχV, hχA⟩
      refine Or.inl (Or.inl ⟨fun g hg => ?_, hχA⟩)
      obtain ⟨t, ht, he⟩ := hχV hg
      exact ⟨t, Metric.ball_subset_closedBall ht, he⟩
  refine le_antisymm ((Subgroup.closure_le _).2 hUA) fun χ hχ => ?_
  -- the character of `E` induced by `χ`
  have hwell : ∀ γ₁ γ₂ : Γ, π γ₁ = π γ₂ → ca χ γ₁ = ca χ γ₂ := by
    intro γ₁ γ₂ h
    have hk : ((γ₁⁻¹ * γ₂ : Γ) : G) ∈ k := (hπk _).1 (by rw [map_mul, map_inv, h, inv_mul_cancel])
    have h0 := hχ _ hk
    rw [Subgroup.coe_mul, Subgroup.coe_inv, ca_mul, ca_ginv] at h0
    rw [← sub_eq_zero, ← neg_eq_zero, ← h0]; abel
  let sec := Function.surjInv hπs
  have hsec : ∀ y, π (sec y) = y := Function.surjInv_eq hπs
  let ψ : ElemG m n r s d →+ UnitAddCircle :=
    { toFun := fun e => ca χ (sec (Multiplicative.ofAdd e))
      map_zero' := by
        show ca χ (sec 1) = 0
        rw [hwell (sec 1) 1 (by rw [hsec, map_one])]
        exact ca_one' χ
      map_add' := fun e₁ e₂ => by
        show ca χ (sec (Multiplicative.ofAdd (e₁ + e₂))) = _
        rw [hwell _ (sec (Multiplicative.ofAdd e₁) * sec (Multiplicative.ofAdd e₂))
          (by rw [hsec, map_mul, hsec, hsec, ofAdd_add])]
        exact ca_mul χ _ _ }
  have hψπ : ∀ γ : Γ, ψ (ecoord γ) = ca χ γ := fun γ =>
    hwell _ _ (by rw [hsec]; rfl)
  have hψc : Continuous ψ := by
    rw [continuous_def]
    intro W hW
    have e : ψ ⁻¹' W = Multiplicative.toAdd '' (π '' ((fun γ : Γ => ca χ γ) ⁻¹' W)) := by
      ext e
      constructor
      · intro he
        refine ⟨π (sec (Multiplicative.ofAdd e)), ⟨sec (Multiplicative.ofAdd e), he, rfl⟩, ?_⟩
        rw [hsec]; rfl
      · rintro ⟨_, ⟨γ, hγ, rfl⟩, rfl⟩
        show ψ (ecoord γ) ∈ W
        rw [hψπ]; exact hγ
    rw [e]
    exact isOpenMap_toAdd' _ (hπo _ (hW.preimage
      (ecirc.symm.continuous.comp (χ.continuous.comp continuous_subtype_val))))
  -- classification of the components
  have hR : ∀ i : Fin m, ∃ c : ℝ, ∀ t,
      ψ (Pi.single i t, 0, 0, 0) = ((c * t : ℝ) : UnitAddCircle) := fun i =>
    charR _ (fun a b => by
      rw [← map_add]; congr 1; simp [Pi.single_add])
      (hψc.comp (show Continuous (fun t : ℝ => ((Pi.single i t, 0, 0, 0) : ElemG m n r s d)) from
        (cont_single i).prodMk continuous_const))
  choose c hc using hR
  have hT : ∀ i : Fin n, ∃ l : ℤ, ∀ θ,
      ψ (0, Pi.single i θ, 0, 0) = l • θ := fun i =>
    charT _ (fun a b => by
      rw [← map_add]; congr 1; simp [Pi.single_add])
      (hψc.comp (show Continuous (fun t : UnitAddCircle =>
        ((0, Pi.single i t, 0, 0) : ElemG m n r s d)) from
        continuous_const.prodMk ((cont_single i).prodMk continuous_const)))
  choose l hl using hT
  have hF : ∀ i : Fin s, ∃ j : ℤ, ∀ b, ψ (0, 0, 0, Pi.single i b) = j • zchar (d i) b := by
    intro i
    haveI : NeZero (d i) := ⟨hd i⟩
    exact charZMod (d i) _ (fun a b => by rw [← map_add]; congr 1; simp [Pi.single_add])
  choose j hj using hF
  have hdec : ∀ e : ElemG m n r s d, e.2.2.1 = 0 → e.2.2.2 = 0 →
      ψ e = ∑ i, ((c i * e.1 i : ℝ) : UnitAddCircle) + ∑ i, l i • e.2.1 i := by
    rintro ⟨x, θ, a, b⟩ ha hb
    simp only at ha hb
    subst ha hb
    have e : ((x, θ, 0, 0) : ElemG m n r s d) =
        ∑ i, ((Pi.single i (x i), 0, 0, 0) : ElemG m n r s d) +
          ∑ i, ((0, Pi.single i (θ i), 0, 0) : ElemG m n r s d) := by
      refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
      · simp [Prod.fst_sum, Prod.snd_sum, Finset.univ_sum_single]
      · simp [Prod.fst_sum, Prod.snd_sum, Finset.univ_sum_single]
      · simp [Prod.fst_sum, Prod.snd_sum]
      · simp [Prod.fst_sum, Prod.snd_sum]
    conv_lhs => rw [e]
    rw [map_add, map_sum, map_sum]
    simp only [hc, hl]
  -- the small generator `ρ`
  set S := ∑ i, |c i| with hSdef
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun i _ => abs_nonneg _
  let N : ℕ := ⌈4 * S⌉₊ + 1
  have hNpos : (0 : ℝ) < N := by positivity
  have hN : 4 * S < N := by
    have := Nat.le_ceil (4 * S); push_cast [N]; linarith
  let fρ : ElemG m n r s d → UnitAddCircle := fun e => (((∑ i, c i * e.1 i) / N : ℝ) : UnitAddCircle)
  have hfρ_add : ∀ e₁ e₂, fρ (e₁ + e₂) = fρ e₁ + fρ e₂ := fun e₁ e₂ => by
    simp only [fρ, Prod.fst_add, Pi.add_apply, mul_add, Finset.sum_add_distrib, add_div,
      AddCircle.coe_add]
  obtain ⟨ρ, hρ⟩ := exists_ext Γ hΓ (fun γ => fρ (ecoord γ))
    (fun a b => by rw [hecoord_mul, hfρ_add])
    (QuotientAddGroup.continuous_mk.comp ((continuous_finsetSum _ fun i _ =>
      continuous_const.mul ((continuous_apply i).comp (continuous_fst.comp hecoord_c))).div_const _))
  have hρA : ρ ∈ A := hmemA ρ fρ (by simp [fρ]) hρ
  have hρU₀ : ρ ∈ U₀ := by
    refine ⟨hW0 ρ fun g hg => ?_, hρA⟩
    obtain ⟨γ, rfl, hx1, -, -⟩ := hC₀Γ g hg
    rw [hρ]
    refine (QuotientAddGroup.norm_mk_le_norm).trans ?_
    rw [Real.norm_eq_abs, abs_div, abs_of_pos hNpos, div_le_iff₀ hNpos]
    have h1 : |∑ i, c i * (ecoord γ).1 i| ≤ S := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
      rw [abs_mul]
      have : |(ecoord γ).1 i| ≤ 1 := by
        have := norm_le_pi_norm (ecoord γ).1 i
        rw [Real.norm_eq_abs] at this
        linarith
      nlinarith [abs_nonneg (c i)]
    linarith
  -- the product of generators
  let P : G →ₜ* Circle := (∏ i, εc i ^ l i) * (∏ i, δc i ^ j i) * ρ ^ (N : ℤ)
  have hPA : P ∈ A := A.mul_mem (A.mul_mem (Subgroup.prod_mem _ fun i _ => A.zpow_mem (hεA i) _)
    (Subgroup.prod_mem _ fun i _ => A.zpow_mem (hδA i) _)) (A.zpow_mem hρA _)
  have hPU : P ∈ Subgroup.closure U := by
    refine Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.prod_mem _ fun i _ =>
      Subgroup.zpow_mem _ (Subgroup.subset_closure ?_) _) (Subgroup.prod_mem _ fun i _ =>
      Subgroup.zpow_mem _ (Subgroup.subset_closure ?_) _))
      (Subgroup.zpow_mem _ (Subgroup.subset_closure ?_) _)
    · exact Or.inl (Or.inr ⟨i, rfl⟩)
    · exact Or.inr ⟨i, rfl⟩
    · exact Or.inl (Or.inl hρU₀)
  have hχ₂ : χ * P⁻¹ ∈ U₀ := by
    refine ⟨hW0 _ fun g hg => ?_, A.mul_mem hχ (A.inv_mem hPA)⟩
    obtain ⟨γ, rfl, -, ha0, hb0⟩ := hC₀Γ g hg
    have h1 : ca χ γ = (((∑ i, c i * (ecoord γ).1 i : ℝ)) : UnitAddCircle) +
        ∑ i, l i • (ecoord γ).2.1 i := by
      rw [← hψπ γ, hdec _ ha0 hb0, coe_sum_circle]
    have h2 : ca P γ = ∑ i, l i • (ecoord γ).2.1 i +
        (((∑ i, c i * (ecoord γ).1 i : ℝ)) : UnitAddCircle) := by
      simp only [P, ca_hmul, ca_prod, ca_zpow, hεc, hδc, hρ, hb0, Pi.zero_apply, zchar_zero,
        smul_zero, Finset.sum_const_zero, add_zero, fρ]
      congr 1
      rw [← AddCircle.coe_zsmul, zsmul_eq_mul]
      congr 1
      push_cast
      field_simp
    have : ca (χ * P⁻¹) γ = 0 := by
      rw [ca_hmul, ca_inv, h1, h2]; abel
    rw [this, norm_zero]; norm_num
  have : χ = (χ * P⁻¹) * P := by rw [inv_mul_cancel_right]
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl (Or.inl hχ₂))) hPU

end LCA

end AnnihC_sec

open MasulloGRH Topology in
theorem solution
    (G : Type*) [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
    [LocallyCompactSpace G] [SecondCountableTopology G]
    (k Γ : Subgroup G) (hk : IsCompact (k : Set G)) (hΓ : IsOpen (Γ : Set G)) (hkΓ : k ≤ Γ)
    {m n r s : ℕ} {d : Fin s → ℕ} (π : ↥Γ →* Multiplicative (ElemGroup m n r s d))
    (hπ : IsElemPresentation Γ k π) :
    ∃ A : Subgroup (PontryaginDual G), (A : Set (PontryaginDual G)) = annihilator k ∧
      IsCompactlyGeneratedSubgroup A := by
  obtain ⟨hd, hπc, hπo, hπs, hπk⟩ := hπ
  obtain ⟨A, hA, U, hUc, hUA, hV, hcl⟩ := LCA.annih_main G k Γ hΓ hkΓ π hd hπc hπo hπs hπk
  exact ⟨A, hA, U, hUc, hUA, hV, hcl⟩
