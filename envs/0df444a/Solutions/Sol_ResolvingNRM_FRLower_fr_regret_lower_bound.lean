lemma fin1_eq_zero (l : Fin 1) : l = 0 := Subsingleton.elim _ _

lemma fin2_eq_or (j : Fin 2) : j = 0 ∨ j = 1 := by
  fin_cases j <;> simp

abbrev tcInst (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) : Instance 2 1 :=
  twoClass r₁ r₂ (le_of_lt hr₂) (le_of_lt hr)

theorem selector_values
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (sel : (Fin 1 → ℝ) → Fin 2 → ℝ)
    (hsel : IsDLPSelector (tcInst r₁ r₂ hr₂ hr) sel)
    (b : Fin 1 → ℝ) (hb : 0 ≤ b 0) :
    sel b 0 = min (b 0) 1 ∧ sel b 1 = min (max (b 0 - 1) 0) 1 := by
  have hb' : 0 ≤ b := by
    intro i
    rw [fin1_eq_zero i]
    exact hb
  have hs := hsel b hb'
  exact ResolvingNRM.FRLower.lp_solution r₁ r₂ hr₂ hr b hb (sel b)
    ⟨hs.1.1, hs.1.2.1, hs.1.2.2, hs.2⟩

noncomputable def canonicalProb (rem cap : ℕ) : Fin 2 → ℝ :=
  let b : ℝ := (cap : ℝ) / (rem : ℝ)
  ![min b 1, min (max (b - 1) 0) 1]

def ValidProb (p : Fin 2 → ℝ) : Prop :=
  ∀ j, 0 ≤ p j ∧ p j ≤ 1

lemma validProb_canonicalProb (rem cap : ℕ) : ValidProb (canonicalProb rem cap) := by
  intro j
  have hb : 0 ≤ (cap : ℝ) / (rem : ℝ) := by positivity
  rcases fin2_eq_or j with rfl | rfl
  · simp [canonicalProb, hb]
  · simp [canonicalProb]

lemma sel_div_lam_eq_canonicalProb
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (sel : (Fin 1 → ℝ) → Fin 2 → ℝ)
    (hsel : IsDLPSelector (tcInst r₁ r₂ hr₂ hr) sel)
    (rem cap : ℕ) :
    (fun j => sel (fun _ => (cap : ℝ) / (rem : ℝ)) j / (tcInst r₁ r₂ hr₂ hr).lam j) =
      canonicalProb rem cap := by
  have hb : 0 ≤ ((fun _ : Fin 1 => (cap : ℝ) / (rem : ℝ)) 0) := by positivity
  have hval := selector_values r₁ r₂ hr₂ hr sel hsel (fun _ => (cap : ℝ) / (rem : ℝ)) hb
  ext j
  rcases fin2_eq_or j with rfl | rfl
  · simpa [tcInst, twoClass, canonicalProb] using hval.1
  · simpa [tcInst, twoClass, canonicalProb] using hval.2

lemma totalRate_tcInst (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) :
    totalRate (tcInst r₁ r₂ hr₂ hr) = 2 := by
