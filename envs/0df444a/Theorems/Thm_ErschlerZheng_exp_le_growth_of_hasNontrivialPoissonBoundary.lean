-- title:
--   Lemma 2.1 — a measure of finite entropy with non-trivial Poisson boundary gives v(nφ(ϱ_n)) ⩾ exp(cn) for all large n
-- statement:
--   Let $\Gamma$ be a group generated by a finite set $S$, with word length $|g| = l_S(g)$ (`wordLength`), and let $\mu$ be a probability on $\Gamma$ (`IsProbability`) of finite entropy (`HasFiniteEntropy`) whose Poisson boundary is non-trivial (`HasNontrivialPoissonBoundary`). Let
--   $$\varrho_n = \inf\{r > 0 : \mu(\{g : |g| \ge r\}) < 1/n\}, \qquad \phi(r) = \sum_{g : |g| \le r} |g|\,\mu(g)$$
--   (the hypotheses `hϱ` and `hφ` name these two functions). Then there is $c > 0$ such that, for all sufficiently large $n$,
--   $$v_{\Gamma,S}(n\,\phi(\varrho_n)) \ge e^{cn},$$
--   where $v_{\Gamma,S}$ at a real radius is the number of elements of word length at most that radius (`growth`). No symmetry or non-degeneracy of $\mu$ is assumed.
--
--   Erschler and Zheng, p. 10, Lemma 2.1: “Let $\Gamma$ be a finitely generated group and $|\cdot| = l_S$ a word distance on $\Gamma$. Suppose $\Gamma$ admits a probability measure $\mu$ of finite entropy such that the Poisson boundary $(\Gamma, \mu)$ is nontrivial. Let $\varrho_n = \inf\{r > 0 : \mu(\{g : |g| \geqslant r\}) < 1/n\}$ and $\phi(r) = \sum_{g : |g| \leqslant r} |g|\mu(g)$. Then there exists a constant $c = c(\Gamma, \mu) > 0$ such that $v_{\Gamma,S}(R_n) \geqslant \exp(cn)$ where $R_n = n\phi(\varrho_n)$.”
--
--   The printed statement gives no range for $n$, and the paper has no convention that $n$ is large. The statement asserts the bound for all sufficiently large $n$, which is what the proof concludes (“We obtain that for all $n$ sufficiently large, $v_{\Gamma,S}(R_n) \geqslant |V_n'| \geqslant \frac{1}{16}e^{\frac12 n\mathbf h}$”, p. 11). “Sufficiently large” cannot be dropped: the statement is false at $n = 1$ ([`ErschlerZheng.lazy_hasNontrivialPoissonBoundary_and_not_exists_forall_exp_le_growth`](https://prove2.me/theorems/61866593-535c-4b01-ac59-ea4c861a7223)).
-- source:
--   Erschler, A. and Zheng, T., Growth of periodic Grigorchuk groups, Invent. Math. 219 (2020) 1069–1155, https://doi.org/10.1007/s00222-019-00922-0 (arXiv:1802.09077v2, whose page numbers are used), p. 10, Lemma 2.1

import Mathlib
import Definitions.Def_ErschlerZheng_Walks

namespace ErschlerZheng

theorem exp_le_growth_of_hasNontrivialPoissonBoundary {Γ : Type*} [Group Γ] (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) (μ : Γ → ℝ) (hμ : IsProbability μ)
    (hH : HasFiniteEntropy μ) (hP : HasNontrivialPoissonBoundary μ)
    (ϱ : ℕ → ℝ)
    (hϱ : ∀ n : ℕ, ϱ n =
      sInf {r : ℝ | 0 < r ∧ mass μ {g | r ≤ (wordLength (S : Set Γ) g : ℝ)} < 1 / n})
    (φ : ℝ → ℝ)
    (hφ : ∀ r : ℝ, φ r = ∑' g : ball (S : Set Γ) r, (wordLength (S : Set Γ) g : ℝ) * μ g) :
    ∃ c > 0, ∀ᶠ n : ℕ in Filter.atTop,
      Real.exp (c * n) ≤ growth (S : Set Γ) (n * φ (ϱ n)) := by
  sorry

end ErschlerZheng
