-- title:
--   Uniqueness of Spec K-points above a point with prime residue field
-- statement:
--   Let $X$ be a scheme, $x$ a point of $X$, and $q$ a prime number. Suppose given a ring homomorphism $\pi : \mathbb{Z}/q \to \kappa(x)$ into the residue field of $X$ at $x$ which is surjective as a map of sets, so that $\kappa(x)$ is generated by, indeed equal to, the image of the prime field $\mathbb{Z}/q$. Let $K$ be a field and let $f, g : \operatorname{Spec} K \to X$ be two morphisms of schemes whose underlying continuous maps send the closed point of $\operatorname{Spec} K$ (the maximal ideal of the local ring $K$) to $x$: $f(\mathrm{pt}) = x$ and $g(\mathrm{pt}) = x$. The conclusion is that $f = g$ as morphisms of schemes. No compatibility is assumed between the characteristic of $K$ and $q$; when $\operatorname{char} K \neq q$ no such morphism exists and the assertion is vacuous.
--
--   This is the standard description of morphisms from the spectrum of a field, specialised to the case where the target point has residue field a prime field, so that the residue field embedding carries no information and the point alone determines the morphism. It is used in the construction of points on modular curves, to pin down the $\kappa$-point of a geometric special fibre lying over the special point of a cusp section.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicGeometry_Scheme_hom_ext_of_field_of_apply_eq_of_surjective_zmod_residueField.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open CategoryTheory AlgebraicGeometry

theorem AlgebraicGeometry.Scheme.hom_ext_of_field_of_apply_eq_of_surjective_zmod_residueField
    {X : Scheme.{u}} (x : X) (q : ℕ) [Fact q.Prime]
    (π : ZMod q →+* X.residueField x) (hπ : Function.Surjective π)
    {K : Type u} [Field K] (f g : Spec (CommRingCat.of K) ⟶ X)
    (hf : f.base (IsLocalRing.closedPoint K) = x) (hg : g.base (IsLocalRing.closedPoint K) = x) :
    f = g := by sorry
