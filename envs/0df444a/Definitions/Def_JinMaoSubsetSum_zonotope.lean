-- title:
--   Zonotopes $Z(X)$, $Z_0(X)$, erosion $A\ominus B$, generated lattices $L(X)$ and convex bodies
-- statement:
--   Work in $\mathbb R^d$ with inner product $\langle u,x\rangle=\sum_ju_jx_j$. For a multiset $X=(x_i)_{i=1}^{|X|}$ of vectors, the **zonotope** and the **centered zonotope** are the Minkowski sums of segments
--   $$
--   Z(X)=\sum_{i=1}^{|X|}[0,x_i]=\Bigl\{\sum_i\varepsilon_ix_i:0\le\varepsilon_i\le 1\Bigr\},\qquad Z_0(X)=\sum_{i=1}^{|X|}[-x_i/2,\,x_i/2].
--   $$
--   The **erosion** (Minkowski difference) of $A$ by $B$ is $A\ominus B=\{x:x+B\subseteq A\}$. For $S\subseteq\mathbb R^d$, $L(S)=\{\sum_{i=1}^mn_ix_i:m\ge0,\ x_i\in S,\ n_i\in\mathbb Z\}$ is the additive group generated by $S$; a **lattice** is a discrete additive subgroup, and its **rank** is the dimension of its linear span. $\operatorname{conv}(\pm S)$ is the convex hull of $S\cup(-S)$. A **convex body** is a compact convex set with nonempty interior, a **polytope** is the convex hull of finitely many points, and $K$ is **origin-symmetric** if $-K=K$.
--
--   These are the geometric objects of §3.3 used by Lemmas 3.5, 9.2, 9.3, 4.3, 4.4 and Theorem 10.1.
--
--   **Formalization Note** $\mathbb R^d$ is `Fin d → ℝ`. The zonotopes are Minkowski sums over the multiset (each element counted with multiplicity). `toR` casts integer vectors to real ones, `linOf c` is the linear map $x\mapsto\sum_jc_jx_j$ with integer coefficients $c$ (`linZ c` its value on integer vectors), and `projFirst n` is the orthogonal projection onto $\operatorname{span}\{e_1,\dots,e_n\}$.
-- source:
--   Jin, Mao, Subset Sum in Almost-Linear Time, arXiv:2610.20742v1 (sha256 8b604948862d9188e922b8abf95831fde3a3699e26d39177d20a1460e31a926a), §3.3, p.16 (PDF p.18)

import Mathlib

set_option autoImplicit false

namespace JinMaoSubsetSum

open scoped Pointwise

/-!
# Zonotopes, erosion, generated lattices and basic convex geometry

Jin, Mao, *Subset Sum in Almost-Linear Time*, arXiv:2610.20742v1, §3.3, p.16: "A convex body in
ℝ^d is a compact convex set in ℝ^d with nonempty interior. [...] Denote the Minkowski difference
(or erosion) by A ⊖ B = {x : x + B ⊆ A}. [...] The zonotope generated by a multiset
X = (x_i)_{i=1}^{|X|} is Z(X) = Σ_{i=1}^{|X|} [0, x_i] = {Σ_{i=1}^{|X|} ε_i x_i : 0 ≤ ε_i ≤ 1}.
Similarly, define the centered zonotope by Z_0(X) = Σ_{i=1}^{|X|} [−x_i/2, x_i/2]. [...] For
arbitrary X ⊆ ℝ^d, denote L(X) = {Σ_{i=1}^m n_i x_i : m ≥ 0, x_i ∈ X, n_i ∈ ℤ}."

**Formalization Note.**
* `ℝ^d` is `Fin d → ℝ` (Lebesgue measure `volume` is the Euclidean volume; topology, convexity
  and compactness are those of `ℝ^d`). `⟨u, x⟩ = Σ_j u_j x_j`.
* A multiset of vectors is a `Multiset`; the zonotope is the Minkowski sum of the segments
  `[0, x]` over the multiset, each element counted with its multiplicity (so `Z(X)` and `Z_0(X)`
  are exactly the paper's sums over `i = 1, …, |X|`).
* `latticeGen S` is `L(S)`, the additive subgroup generated by `S`; `rankOf Γ` is the dimension of
  the real span of `Γ` (the rank of a lattice). A lattice is a discrete additive subgroup;
  statements assume `DiscreteTopology Γ` where the paper says "lattice".
* `symmHull S = conv(±S) = conv(S ∪ −S)`.
* `toR` casts an integer vector to a real vector; `linOf c` is the linear map `x ↦ Σ_j c_j x_j`
  with integer coefficients `c`; `projFirst n` is the orthogonal projection of `ℝ^d` onto
  `span{e_1, …, e_n}` (coordinates `≥ n`, 0-based, are set to `0`).
-/

/-- The real vector with the coordinates of an integer vector. -/
def toR {d : ℕ} (v : Fin d → ℤ) : Fin d → ℝ := fun j => (v j : ℝ)

/-- The zonotope `Z(X) = Σ_{x ∈ X} [0, x]` (Minkowski sum over the multiset). -/
def zonotope {d : ℕ} (X : Multiset (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  (X.map (fun x => segment ℝ (0 : Fin d → ℝ) x)).sum

/-- The centered zonotope `Z_0(X) = Σ_{x ∈ X} [−x/2, x/2]`. -/
def zonotope0 {d : ℕ} (X : Multiset (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  (X.map (fun x => segment ℝ (-((1 / 2 : ℝ) • x)) ((1 / 2 : ℝ) • x))).sum

/-- The erosion (Minkowski difference) `A ⊖ B = {x : x + B ⊆ A}`. -/
def erosion {d : ℕ} (A B : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  {x | ∀ b ∈ B, x + b ∈ A}

/-- `L(S)`: all integer combinations of elements of `S`. -/
def latticeGen {d : ℕ} (S : Set (Fin d → ℝ)) : AddSubgroup (Fin d → ℝ) :=
  AddSubgroup.closure S

/-- The rank of a lattice `Γ`: the dimension of its real span. -/
noncomputable def rankOf {d : ℕ} (Γ : AddSubgroup (Fin d → ℝ)) : ℕ :=
  Module.finrank ℝ (Submodule.span ℝ (Γ : Set (Fin d → ℝ)))

/-- `conv(±S) = conv(S ∪ −S)`. -/
def symmHull {d : ℕ} (S : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  convexHull ℝ (S ∪ -S)

/-- `K` is origin-symmetric: `x ∈ K → −x ∈ K`. -/
def IsOriginSymm {d : ℕ} (K : Set (Fin d → ℝ)) : Prop :=
  ∀ x ∈ K, -x ∈ K

/-- A convex body: a compact convex set with nonempty interior. -/
def IsConvexBody {d : ℕ} (K : Set (Fin d → ℝ)) : Prop :=
  IsCompact K ∧ Convex ℝ K ∧ (interior K).Nonempty

/-- A (convex) polytope: the convex hull of finitely many points. -/
def IsPolytope {d : ℕ} (K : Set (Fin d → ℝ)) : Prop :=
  ∃ S : Finset (Fin d → ℝ), K = convexHull ℝ (S : Set (Fin d → ℝ))

/-- The linear map `x ↦ Σ_j c_j x_j` with integer coefficients. -/
noncomputable def linOf {d : ℕ} (c : Fin d → ℤ) : (Fin d → ℝ) →ₗ[ℝ] ℝ :=
  ∑ j, (c j : ℝ) • (LinearMap.proj j : (Fin d → ℝ) →ₗ[ℝ] ℝ)

/-- The value `Σ_j c_j v_j` of the integer linear map `c` at an integer vector `v`. -/
def linZ {d : ℕ} (c : Fin d → ℤ) (v : Fin d → ℤ) : ℤ := ∑ j, c j * v j

/-- The orthogonal projection onto `span{e_1, …, e_n}`: coordinates `j ≥ n` (0-based) set to `0`. -/
def projFirst {d : ℕ} (n : ℕ) (x : Fin d → ℝ) : Fin d → ℝ :=
  fun j => if j.val < n then x j else 0

end JinMaoSubsetSum


