    · show (k : F) ∈ ((idealUnit F 𝔫 h𝔫 : FractionalIdeal (𝓞 F)⁰ F) : Set F)
      rw [idealUnit, Units.val_mk0, SetLike.mem_coe, FractionalIdeal.mem_coeIdeal]
      exact ⟨k, hk, rfl⟩
    · rw [mixedEmbedding_eq_algebraMap_comp]

variable {𝔫 h𝔫}

private def mkAdele (y : InfiniteAdeleRing F) (u : FiniteAdeleRing (𝓞 F) F) : AdeleRing (𝓞 F) F :=
  show InfiniteAdeleRing F × FiniteAdeleRing (𝓞 F) F from (y, u)

private theorem mkAdele_add (y y' : InfiniteAdeleRing F) (u u' : FiniteAdeleRing (𝓞 F) F) :
    mkAdele F y u + mkAdele F y' u' = mkAdele F (y + y') (u + u') := rfl

private theorem mkAdele_fst_snd (t : AdeleRing (𝓞 F) F) : mkAdele F t.1 t.2 = t := rfl

private theorem fst_mkAdele (y : InfiniteAdeleRing F) (u : FiniteAdeleRing (𝓞 F) F) : (mkAdele F y u).1 = y := rfl

private theorem algebraMap_eq_mkAdele (k : F) :
    algebraMap F (AdeleRing (𝓞 F) F) k = mkAdele F (algebraMap F (InfiniteAdeleRing F) k) (algebraMap F (FiniteAdeleRing (𝓞 F) F) k) :=
  rfl

variable {F}

private def archRestrict (h : AdeleRing (𝓞 F) F → ℂ) : InfiniteAdeleRing F → ℂ := fun y => h (mkAdele F y 0)

private theorem continuous_archRestrict {h : AdeleRing (𝓞 F) F → ℂ} (hc : Continuous h) : Continuous (archRestrict h) :=
  hc.comp (show Continuous fun y : InfiniteAdeleRing F => ((y, (0 : FiniteAdeleRing (𝓞 F) F)) : InfiniteAdeleRing F × _)
    from Continuous.prodMk continuous_id continuous_const)

private theorem isKerPeriodic_archRestrict {h : AdeleRing (𝓞 F) F → ℂ}
    (hF : ∀ (k : F) (t : AdeleRing (𝓞 F) F), h (algebraMap F (AdeleRing (𝓞 F) F) k + t) = h t)
    (hU : ∀ n ∈ 𝔫, ∀ o ∈ integralFiniteAdeles (𝓞 F) F, ∀ t : AdeleRing (𝓞 F) F,
      h (t + mkAdele F 0 (algebraMap F (FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) = h t) :
    IsKerPeriodic (adelicTorusMap F 𝔫 h𝔫) (archRestrict h) := by
  intro v hv y
  obtain ⟨k, hk, rfl⟩ := (adelicTorusMap_eq_zero_iff F 𝔫 h𝔫 v).mp hv

  have hsplit : mkAdele F (y + algebraMap F (InfiniteAdeleRing F) (k : F)) 0
      = algebraMap F (AdeleRing (𝓞 F) F) (k : F)
        + (mkAdele F y 0 + mkAdele F 0 (algebraMap F (FiniteAdeleRing (𝓞 F) F) ((k : 𝓞 F) : F) * (-1))) := by
    rw [algebraMap_eq_mkAdele, mkAdele_add, mkAdele_add, add_zero, zero_add, mul_neg_one, add_neg_cancel, add_comm y]
  show h (mkAdele F (y + algebraMap F (InfiniteAdeleRing F) (k : F)) 0) = h (mkAdele F y 0)
  have hneg : (-1 : FiniteAdeleRing (𝓞 F) F) ∈ integralFiniteAdeles (𝓞 F) F := fun v => neg_mem (one_mem _)
  rw [hsplit, hF, hU k hk (-1) hneg]

