    refine ⟨O.comap φ.toRingHom, Subring.ext fun f => ?_⟩
    simp only [SemistableModel.localRing, RingHom.mem_range, RingHom.coe_comp, Function.comp_apply,
      RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    change φ f ∈ O ↔ _
    rw [← ValuationSubring.mem_toSubring, hO, RingHom.mem_range]
    constructor
    · rintro ⟨z, hz⟩; exact ⟨z, by rw [hz, RingEquiv.symm_apply_apply]⟩
    · rintro ⟨z, hz⟩; exact ⟨z, by rw [← hz, RingEquiv.apply_symm_apply]⟩
  have htr₀ : ∀ (x₀ : X₀) (g : X₀.functionField),
      φ₀.symm g ∈ SemistableModel.localRing X₀ φ₀ x₀ ↔ g ∈ (algebraMap (X₀.presheaf.stalk x₀) X₀.functionField).range := by
    intro x₀ g
    simp only [SemistableModel.localRing, RingHom.mem_range, RingHom.coe_comp, Function.comp_apply,
      RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
    constructor
    · rintro ⟨z, hz⟩; exact ⟨z, φ₀.symm.injective hz⟩
    · rintro ⟨z, hz⟩; exact ⟨z, by rw [hz]⟩

  have hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀ := by
    refine (hF₀ _).mpr (fun n => ?_)
    show (coeffEmb (AlgebraicClosure ℚ) jq).coeff n ∈ K₀
    rw [coeffEmb_coeff, eq_ratCast]
    exact SubfieldClass.ratCast_mem K₀ (jq.coeff n)

  have htransport : ∀ (x : X) (f : ↥F₀), f ∈ SemistableModel.localRing X₀ φ₀ (pr.base x) →
      (f : ↥(fieldBar q M')) ∈ SemistableModel.localRing X φ x := by
    intro x f hf
    obtain ⟨z, hz⟩ := hf

    have hz' : (f : ↥(fieldBar q M')) = j₀ (algebraMap (X₀.presheaf.stalk (pr.base x)) X₀.functionField z) := by
      rw [← hz]; rfl
    have key : φ (f : ↥(fieldBar q M')) = algebraMap (X.presheaf.stalk x) X.functionField ((pr.stalkMap x).hom z) := by
      rw [hz', hφj]
      change (pr.stalkMap (genericPoint X)).hom ((X₀.presheaf.stalkSpecializes (specializes_of_eq hgenpt)).hom
          ((X₀.presheaf.stalkSpecializes (genericPoint_specializes (pr.base x))).hom z)) =
        (X.presheaf.stalkSpecializes (genericPoint_specializes x)).hom ((pr.stalkMap x).hom z)
      have hc := congrArg (fun ψ => ψ.hom z)
        (TopCat.Presheaf.stalkSpecializes_comp X₀.presheaf (specializes_of_eq hgenpt) (genericPoint_specializes (pr.base x)))
      simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at hc
      rw [hc]
      exact Scheme.Hom.stalkSpecializes_stalkMap_apply pr (genericPoint X) x (genericPoint_specializes x) z
    refine ⟨(pr.stalkMap x).hom z, ?_⟩
    show φ.symm (algebraMap (X.presheaf.stalk x) X.functionField ((pr.stalkMap x).hom z)) = (f : ↥(fieldBar q M'))
    rw [← key, RingEquiv.symm_apply_apply]
  refine ⟨X, toBase, iIntX, iPropX, iFlatX, iLfpX, φ, hφM, hN,
    ⟨K₀, hK₀alg, A₀, instCR, instDom, instDVR, instHens, ι, instLoc, ϖ₀, X₀, toBase₀, iInt₀, iProp₀, iFlat₀, iLfp₀,
      Iso.refl _, F₀, hF₀alg, φ₀, hπK₀, hϖ₀, hιinj, hιK₀, hres, by simp [X, toBase], hgenpt, hφ₀, hsmooth_iff, hNODE₀⟩,
    gen, nd, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hgen_inj
  · exact hnd_inj
  ·
    intro ℓ
    symm
    refine AlgebraicGeometry.toSubring_eq_localRing_of_forall_mem_iff_of_pullback A hrk hAne A₀ ι X₀ toBase₀ X toBase φ hφM
      (Iso.refl _) (by simp [X, toBase]) hgenpt j₀ hφj ?halgF (gen (Sum.inl ℓ)) ?hη ?hfib ?hV (OIg ℓ) ?hOA ?hOtr
    · exact halgF
    · exact hgen_sp _
    · exact fun x hx hpx => hsp_inj x _ hx (hgen_sp _) hpx
    · exact hV _
    · exact fun a => M1Glue.algebraMap_mem_igusaRing q M' A ζ OIg hIg_inf hIg ℓ a
    · intro g
      rw [hgen (Sum.inl ℓ), ← htr₀, hIgF₀ ℓ (φ₀.symm g)]
      rfl
  ·
    intro s
    symm
    refine AlgebraicGeometry.toSubring_eq_localRing_of_forall_mem_iff_of_pullback A hrk hAne A₀ ι X₀ toBase₀ X toBase φ hφM
      (Iso.refl _) (by simp [X, toBase]) hgenpt j₀ hφj ?halgF' (gen (Sum.inr s)) ?hη' ?hfib' ?hV' (OSS s) (fun a => (hSS_A s a).mpr a.2) ?hOtr'
    · exact halgF
    · exact hgen_sp _
    · exact fun x hx hpx => hsp_inj x _ hx (hgen_sp _) hpx
    · exact hV _
    · intro g
      rw [hgen (Sum.inr s), ← htr₀, hSSF₀ s (φ₀.symm g)]
      rfl
  · exact hgen_sp
  · intro x hx
    constructor
    · rintro ⟨i, rfl⟩
      obtain ⟨y₀, hy₀, hne₀⟩ := (hgen₀_iff (gen₀ i) (hgen₀_cl i)).mp ⟨i, rfl⟩
      obtain ⟨y, hy⟩ := hsp_surj y₀ (hsp₀ _ _ (hgen₀_cl i) hy₀)
      have hysp : toBase.base y = closedPoint ↥A := (hsp_iff y).mpr (by rw [hy]; exact hsp₀ _ _ (hgen₀_cl i) hy₀)
      refine ⟨y, (hspec_iff (gen i) y (hgen_sp i) hysp).mpr (by rw [hgen, hy]; exact hy₀), fun h => hne₀ ?_⟩
      rw [← hy, ← hgen i, h]
    · rintro ⟨y, hxy, hne⟩
      have hysp := hspA _ _ hx hxy
      have h0 : pr.base x ⤳ pr.base y := (hspec_iff x y hx hysp).mp hxy
      have hne0 : pr.base y ≠ pr.base x := fun h => hne (hsp_inj y x hysp hx h)
      obtain ⟨i, hi⟩ := (hgen₀_iff (pr.base x) ((hsp_iff x).mp hx)).mpr ⟨pr.base y, h0, hne0⟩
      exact ⟨i, hsp_inj x (gen i) hx (hgen_sp i) (by rw [hgen]; exact hi)⟩
  · intro e y hy
    have hysp := hspA _ _ (hnd_sp e) hy
    have h0 := ((hspec_iff (nd e) y (hnd_sp e) hysp).mp hy)
    rw [hnd] at h0
    have hpy : pr.base y = pr.base (nd e) := by rw [hnd]; exact hnd₀_closed e _ h0
    exact hsp_inj y (nd e) hysp (hnd_sp e) hpy
  · intro e i
    rw [hspec_iff (gen i) (nd e) (hgen_sp i) (hnd_sp e), hgen, hnd]
    exact hgen₀_nd₀ e i
  · exact fun e h => hnd₀_nsm e (by rw [← hnd e]; exact (hsmooth_iff (nd e)).mp h)
  · intro x hxnd
    by_cases hx : toBase.base x = closedPoint ↥A
    · have h0 : ∀ e, pr.base x ≠ nd₀ e := fun e h => hxnd e (hsp_inj x (nd e) hx (hnd_sp e) (by rw [hnd]; exact h))
      exact (hsmooth_iff x).mpr (hsm₀ _ h0)
    · refine (hsmooth_iff x).mpr (hG₀ _ ?_)
