  haveI := isIntegral_along φ hφ
  haveI : CharZero F := charZero_of_injective_algebraMap (algebraMap Qb F).injective
  haveI : CharZero F' := charZero_of_injective_algebraMap (algebraMap Qb F').injective
  show Algebra.IsSeparable _ _
  exact Algebra.IsAlgebraic.isSeparable_of_perfectField

