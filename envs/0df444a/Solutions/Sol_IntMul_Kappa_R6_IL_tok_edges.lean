-- Source module: Solutions.R6ILTok
/-!
# Round six, item language: the shift templates are admissible for large primes

`tok_edges`: for a prime `q` above the template constant `qBound C` and `f ≥ 1`, if the edges
are `EdgeOK` at `q ^ f`, then every shift template of every edge satisfies `TOK` at `q ^ f`, and
all matrix denominators are coprime to `q ^ f`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 AModelFac Finset

noncomputable section

variable {W T m : ℕ}

lemma qbE_le_qBound (C : Bit.QHNet (ZMod 2) W T m) {e : Bit.Edge m} (he : e ∈ C.edges) :
    qbE e.E₁ + qbE e.E₂ ≤ qBound C :=
  List.le_sum_of_mem (List.mem_map_of_mem he)

lemma qsB_le_qbE (E : Bit.QMat2 m) (i : Fin (m + m)) : qsB (rowQ E i) ≤ qbE E :=
  Finset.single_le_sum (f := fun i => qsB (rowQ E i)) (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)

lemma den_le_qsB (E : Bit.QMat2 m) (i j : Fin (m + m)) : (E i j).den ≤ qsB (rowQ E i) := by
  simp only [rowQ, qsB]
  have := Finset.single_le_sum (f := fun j : Fin (m + m) =>
    2 * ((E i j).num.natAbs + 1) * ((E i j).den + 1)) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
  have h2 : (E i j).den + 1 ≤ 2 * ((E i j).num.natAbs + 1) * ((E i j).den + 1) :=
    Nat.le_mul_of_pos_left _ (by positivity)
  omega

lemma num_le_qsB (E : Bit.QMat2 m) (i : Fin (m + m)) : (E i i).num.natAbs ≤ qsB (rowQ E i) := by
  simp only [rowQ, qsB]; omega

lemma ne_zero_of_unit {N : ℕ} (hN : 1 < N) {u : ℚ} (h : IsUnit (redQ N u)) : u ≠ 0 := by
  rintro rfl
  rw [redQ_zero] at h
  have : Fact (1 < N) := ⟨hN⟩
  exact not_isUnit_zero h

lemma coprime_pow_of_lt {q f d : ℕ} (hq : q.Prime) (hd : 0 < d) (hlt : d < q) :
    Nat.Coprime d (q ^ f) :=
  Nat.Coprime.pow_right _ (coprime_of_lt hq hd hlt)

/-- **The templates of the network are admissible at `q ^ f`.** -/
theorem tok_edges_sol_aux (C : Bit.QHNet (ZMod 2) W T m) {q f Bb : ℕ} (hq : q.Prime)
    (hqB : qBound C < q) (hf : 1 ≤ f) (hOK : C.EdgesOK (q ^ f))
    (hBb : zsz ((((q ^ f + 1) ^ 3 : ℕ)) : ℤ) ≤ Bb) :
    (∀ e ∈ C.edges, ∀ T' ∈ tplE e.E₁ ++ tplE e.E₂, TOK T' (q ^ f) Bb) ∧
    (∀ e ∈ C.edges, ∀ i j, Nat.Coprime (e.E₁ i j).den (q ^ f) ∧
      Nat.Coprime (e.E₂ i j).den (q ^ f)) := by
  have hqf : q ≤ q ^ f := by
    calc q = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ f := Nat.pow_le_pow_right hq.pos hf
  have hN1 : 1 < q ^ f := lt_of_lt_of_le hq.one_lt hqf
  -- one matrix
  have key : ∀ (E : Bit.QMat2 m), qbE E < q → (∀ i, IsUnit (redQ (q ^ f) (E i i))) →
      (∀ T' ∈ tplE E, TOK T' (q ^ f) Bb) ∧ (∀ i j, Nat.Coprime (E i j).den (q ^ f)) := by
    intro E hE hU
    have hcop : ∀ i j, Nat.Coprime (E i j).den (q ^ f) := fun i j =>
      coprime_pow_of_lt hq (Rat.den_pos _)
        (lt_of_le_of_lt (le_trans (den_le_qsB E i j) (qsB_le_qbE E i)) hE)
    refine ⟨fun T' hT => ?_, hcop⟩
    simp only [tplE, List.mem_map, List.mem_reverse, List.mem_finRange, true_and] at hT
    obtain ⟨i, rfl⟩ := hT
    have hlt : qsB (rowQ E i) < q := lt_of_le_of_lt (qsB_le_qbE E i) hE
    have hu : E i i ≠ 0 := ne_zero_of_unit hN1 (hU i)
    have hn0 : 0 < (E i i).num.natAbs := Int.natAbs_pos.2 (Rat.num_ne_zero.2 hu)
    have hg : (rowQ E i).Good (q ^ f) :=
      ⟨hu, hcop i i, coprime_pow_of_lt hq hn0 (lt_of_le_of_lt (num_le_qsB E i) hlt),
        fun j _ => hcop i j⟩
    refine tok_of_good hq hf (rowQ E i) hg hlt (le_trans (zsz_nat_le ?_) hBb) _ rfl
    calc qsB (rowQ E i) * (q ^ f + 1) ^ 2 ≤ (q ^ f + 1) * (q ^ f + 1) ^ 2 :=
          Nat.mul_le_mul_right _ (by omega)
      _ = (q ^ f + 1) ^ 3 := by ring
  constructor
  · intro e he T' hT
    have hb := qbE_le_qBound C he
    obtain ⟨_, _, h3, h4⟩ := hOK e he
    rcases List.mem_append.1 hT with h | h
    · exact (key e.E₁ (by omega) h3).1 T' h
    · exact (key e.E₂ (by omega) h4).1 T' h
  · intro e he i j
    have hb := qbE_le_qBound C he
    obtain ⟨_, _, h3, h4⟩ := hOK e he
    exact ⟨(key e.E₁ (by omega) h3).2 i j, (key e.E₂ (by omega) h4).2 i j⟩

end

end IntMul.Kappa.R6.IL

