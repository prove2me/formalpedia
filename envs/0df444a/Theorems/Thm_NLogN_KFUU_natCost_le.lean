theorem NLogN.KFUU.natCost_le (w h d VT VS PM : ℕ) (hd : 2 ^ (d + 1) ≤ VT) (hST : VS ≤ VT) (hS2 : 2 ≤ VS)
    (hP1 : 1 ≤ PM) (hPS : PM ≤ VS) (hd0 : d = 0 → PM = 1) :
    natCost w d VT VS PM (w + h + 3 * d + zsz (VS : ℤ) + 3) (zsz (VT : ℤ) + w + h + 3)
        (zsz ((2 * VS : ℕ) : ℤ) + d) (zsz ((2 * VS : ℕ) : ℤ)) ≤
      C1 * ((d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2 +
        d * cRb d w VS PM (zsz ((2 * VS : ℕ) : ℤ))) := by sorry
