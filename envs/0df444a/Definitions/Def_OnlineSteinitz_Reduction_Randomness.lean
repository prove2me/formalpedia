-- title:
--   Independent tapes, augmentation and terminal subgaussian scale
-- statement:
--   Give each internal node its own private tape with an arbitrary probability law and take their product law, independent of a fixed input stream. Conditioning at node $u$ uses the sigma-algebra generated by the complete tapes of its strict ancestors.
--
--   In dimension $d$, feed the Euclidean signer the augmented vector $z_i=(x_i,1)/\sqrt2\in\mathbb R^{d+1}$. A signer in dimension $D$ has terminal scale $\Sigma\ge0$ for capacity $m$ if every fixed unit-ball stream and every direction $\theta\in\mathbb R^D$ satisfy
--   $$\mathbb E\exp\left\langle\theta,\sum_{i=1}^{m}\varepsilon_i z_i\right\rangle
--   \le\exp\left(\frac{\Sigma^2}{2}\|\theta\|_2^2\right).$$
--   This defines only a terminal guarantee, not simultaneous signed-prefix control. The Euclidean execution applies Algorithm 1 to these signers with the augmented local history. The two exponential observables are $\exp(\lambda\langle z,Y_u\rangle/2)$ and $\exp(\lambda q_u)$.
--
--   **Formalization Note** The finite product is indexed by the interval grid; unused coordinates have no effect. Vector domains are continuous Euclidean spaces. Sign measurability and finitely many possible sign sequences make fixed-input exponential integrals meaningful; no finite support assumption is imposed on vectors or tapes. Scale is $\Sigma$, so the variance factors in all exponents are $\Sigma^2$.
-- source:
--   Russo–Wei, The Online Steinitz Problem, STOC 2027 submission #22 (2026 preprint), https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/22.pdf, SHA-256 32ff14f15a94c95630765c77f4fa5a429fb294bcf03a9055ed67c60658769366, Algorithm 1, p.5; (2.2), p.6; ancestor conditioning, p.7; (2.7)–(2.8) and augmented-stream calculation, pp.8–9

import Definitions.Def_OnlineSteinitz_Reduction_Analysis

open MeasureTheory
open scoped BigOperators

namespace OnlineSteinitz.Reduction

/-! Independent complete private tapes, §2.1 p.5 and §2.3 p.7.
The unused coordinates of the grid are harmless independent dummy tapes.
Each coordinate may have a different probability law. -/
noncomputable def tapeLaw {T : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (μ : Node T → Measure Ω) : Measure (Node T → Ω) := Measure.pi μ

@[instance_reducible] def ancestorSigma {T : ℕ} {Ω : Type*} [MeasurableSpace Ω] (u : Node T) :
    MeasurableSpace (Node T → Ω) :=
  MeasurableSpace.comap
    (fun ω : Node T → Ω => fun v : {v // v ∈ ancestors u} => ω v.val) inferInstance

abbrev Vec (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-! Augmentation (x,1)/√2, Algorithm 1 p.5 and Lemma 2.3 p.9. -/
noncomputable def augment {d : ℕ} (x : Vec d) : Vec (d + 1) :=
  WithLp.toLp 2 (fun i : Fin (d + 1) =>
    if h : i.val < d then x ⟨i.val, h⟩ / Real.sqrt 2 else 1 / Real.sqrt 2)

noncomputable def augmentedRule {d : ℕ} {Ω : Type*}
    (r : Signer (Vec (d + 1)) Ω) : Signer (Vec d) Ω :=
  fun ω h x => r ω (h.map (fun e => (augment e.1, e.2))) (augment x)

/-! Only terminal MGF (2.2), p.6, for deterministic streams of the
specified capacity. MeasurableSigner supplies measurability. Integrability
follows from finitely many possible sign sequences, not from an added premise. -/
noncomputable def HasScale {D : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (m : ℕ) (r : Signer (Vec D) Ω) (sigma : ℝ) : Prop :=
  0 ≤ sigma ∧ ∀ x : Fin m → Vec D, (∀ i, ‖x i‖ ≤ 1) → ∀ θ : Vec D,
    (∫ ω, Real.exp (inner ℝ θ (signedVector (signHistory r ω (List.ofFn x)))) ∂μ) ≤
      Real.exp (sigma ^ 2 / 2 * ‖θ‖ ^ 2)

noncomputable def euclideanRun {T d : ℕ} {Ω : Type*}
    (r : Node T → Signer (Vec (d + 1)) Ω) (v : Fin T → Vec d)
    (ω : Node T → Ω) : Run T (Vec d) :=
  execute (fun u => augmentedRule (r u)) ω (List.ofFn v)

noncomputable def directionExp {T d : ℕ} {Ω : Type*}
    (r : Node T → Signer (Vec (d + 1)) Ω) (v : Fin T → Vec d)
    (u : Node T) (z : Vec d) (lam : ℝ) (ω : Node T → Ω) : ℝ :=
  Real.exp (lam * inner ℝ z (centeredSum ((euclideanRun r v ω).localHistory u)) / 2)

noncomputable def countExp {T d : ℕ} {Ω : Type*}
    (r : Node T → Signer (Vec (d + 1)) Ω) (v : Fin T → Vec d)
    (u : Node T) (lam : ℝ) (ω : Node T → Ω) : ℝ :=
  Real.exp (lam * signedCount (proposedHistory ((euclideanRun r v ω).localHistory u)))

end OnlineSteinitz.Reduction


