-- title:
--   Independent blocks and their projection
-- statement:
--   For independent blocks with common dimensions, each with its own seed and prescribed root value, `forestInput` is the generated input on (block, address). `forestProj` is the same object as a projection in the sense of §3: the free leaf of a block maps to the block's free variable, and every other leaf maps to the constant the seed gives it, which does not depend on the root value.
-- source:
--   Mantri, Classical Verification of Quantum Computation Beyond the Polynomial Hierarchy, arXiv:2610.37635 (PDF sha256 d1fab777…1d0b33), §4.2, p. 17 (PDF p. 19); §6.2, p. 26 (PDF p. 28)

import Mathlib
import Definitions.Def_MantriCVQ_Seed

open QAlgorithms.Complexity

namespace MantriCVQ

/-- The input `X` generated by independent blocks indexed by `ι`, each with the dimensions `ms`, from
the seeds `s` and the prescribed root values `v` (Mantri, arXiv:2610.37635 (PDF sha256
d1fab777…1d0b33), §4.2, p. 17 (PDF p. 19); §6.2, p. 26 (PDF p. 28)). A leaf of the forest is a block
and an address inside it. -/
def forestInput (C : (m : ℕ) → Bits m → Bits m → Bool) {ι : Type} (ms : List ℕ)
    (s : ι → Seed ms) (v : ι → Bool) : ι × Addr ms → Bool :=
  fun p => gen C ms (s p.1) (v p.1) p.2

/-- The projection `ρ` of the blocks as a substitution (§3, p. 13; Claim 4.1(d), p. 17): the free leaf
of a block is mapped to the block's free variable, and every other leaf to the constant that the seed
gives it. That constant does not depend on the root value. -/
def forestProj (C : (m : ℕ) → Bits m → Bits m → Bool) {ι : Type} (ms : List ℕ)
    (s : ι → Seed ms) : ι × Addr ms → Bool ⊕ ι :=
  fun p => if p.2 = freeLeaf ms (s p.1) then .inr p.1 else .inl (gen C ms (s p.1) false p.2)

end MantriCVQ


