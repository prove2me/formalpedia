theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {q : ℕ} [Fact q.Prime]
    (coord : ↥Λ → Zp2 q × Zp2 q) (hcoord : IsOrderCoord Λ q coord)
    (h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ)

    (B B₀ : Type) [CommRing B] [IsNoetherianRing B] [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (hq : IsNilpotent ((q : ℕ) : B))
    (E E' : FakeEllipticCurve Λ N B) (X X' : FormalODModule q B)
    (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (θ' : RelativeGroupLaw.FormalCoordinates E'.f 2)
    (hE : E.IsFormalModuleVia coord X θ) (hE' : E'.IsFormalModuleVia coord X' θ')
    (E₀ E₀' : FakeEllipticCurve Λ N B₀) (g : E₀.A ⟶ E.A) (g' : E₀'.A ⟶ E'.A)
    (hg : FakeEllipticCurve.IsPullbackVia (algebraMap B B₀) E E₀ g) (hg' : FakeEllipticCurve.IsPullbackVia (algebraMap B B₀) E' E₀' g')

    (φ₀ : E₀.A ⟶ E₀'.A) (hφ₀ : φ₀ ≫ E₀'.f = E₀.f)
    (φ₀_mul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B₀)) (P Q : SchemeHomOver t E₀.f),
      mapPt φ₀ hφ₀ (E₀.L.mul t P Q) = E₀'.L.mul t (mapPt φ₀ hφ₀ P) (mapPt φ₀ hφ₀ Q))
    (φ₀_act : ∀ x : ↥Λ, E₀.act x ≫ φ₀ = φ₀ ≫ E₀'.act x)

    (T : FormalODModule.Hom X X')
    (hTφ₀ : ∀ (B'' : Type) [CommRing B''] [Algebra B B''] [Algebra B₀ B''] [IsScalarTower B B₀ B'']
      (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ → ∀ (s : Fin 2 → B''), (∀ i, s i ∈ J) →
      ∀ p₀ : SchemeHomOver (Scheme.specOver (𝒪 := B₀) B'') E₀.f, p₀.1 ≫ g = (θ B'' s).1 →
        p₀.1 ≫ φ₀ ≫ g' = (θ' B'' (fun i => MvFormalGroup.nilEval n (T.toSeries i) s)).1) :
    ∃! φ : E.A ⟶ E'.A, g ≫ φ = φ₀ ≫ g' ∧
      ∃ hφ : φ ≫ E'.f = E.f,
        (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t E.f),
          mapPt φ hφ (E.L.mul t P Q) = E'.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q)) ∧
        (∀ x : ↥Λ, E.act x ≫ φ = φ ≫ E'.act x) ∧
        (∀ (B'' : Type) [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
          ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
            (θ B'' s).1 ≫ φ = (θ' B'' (fun i => MvFormalGroup.nilEval n (T.toSeries i) s)).1) := by
  classical
  have hq' := hq
  obtain ⟨μ₀, hμ₀⟩ := hker
  have hμ : RingHom.ker (algebraMap B B₀) ^ (μ₀ + 1) = ⊥ := by
    rw [pow_succ, hμ₀, zero_mul]; rfl
  obtain ⟨n, hn⟩ := hq'

  obtain ⟨Ñ, hÑf, Ñmul, Ñact, Ñred, Ñformal⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_hom_lift_nsmul_pow coord hcoord B B₀ hπ μ₀ hμ n hn
      E E' X X' θ θ' hE hE' E₀ E₀' g g' hg hg' φ₀ hφ₀ φ₀_mul φ₀_act T hTφ₀

  have hX4 : X.HasHeight 4 :=
    CerednikDrinfeld.QM.FakeEllipticCurve.hasHeight_four_of_isFormalModuleVia_of_one_mem coord hcoord h1 B hq E X θ hE
  have hkill : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P : SchemeHomOver t E.f),
      E.L.nsmul t (q ^ (n * μ₀)) P = E.L.one t → mapPt Ñ hÑf P = E'.L.one t := by

    have affine_case : ∀ (C : Type) [CommRing C] [Algebra B C] (P : SchemeHomOver (Scheme.specOver (𝒪 := B) C) E.f),
        nsmulPt E.L (Scheme.specOver (𝒪 := B) C) (q ^ (n * μ₀)) P = E.L.one (Scheme.specOver (𝒪 := B) C) →
        mapPt Ñ hÑf P = E'.L.one (Scheme.specOver (𝒪 := B) C) := by
      intro C _ _ P hP
      obtain ⟨J, ⟨k, hk⟩, hPJ⟩ :=
        CerednikDrinfeld.QM.FakeEllipticCurve.exists_isNilpotent_isInfinitesimal_of_nsmulPt_pow_eq_one_of_one_mem coord hcoord h1 B hq
          E X θ hE C (n * μ₀) P hP
      have hJ : J ^ (k + 1) = ⊥ := by rw [pow_succ, hk, zero_mul]; rfl
      obtain ⟨-, hinj, hsurj, -⟩ := hE.1.2 C J k hJ
      obtain ⟨s, hs, rfl⟩ := hsurj P hPJ

      have h1 := Ñformal C J k hJ s hs
      have hcomm : (X'.act (((q : ℕ) : Zp2 q) ^ (n * μ₀))).comp T.toSeries =
          T.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ (n * μ₀))) := (T.isODHom.2.1 _).symm
      rw [hcomm] at h1

      set u : Fin 2 → C := fun j => MvFormalGroup.nilEval k (X.act (((q : ℕ) : Zp2 q) ^ (n * μ₀)) j) s with hu_def
      have hq0 : ∀ j, MvPowerSeries.constantCoeff (X.act (((q : ℕ) : Zp2 q) ^ (n * μ₀)) j) = 0 := (X.isLawHom_act _).1
      have huJ : ∀ j, u j ∈ J := (MvFormalGroup.nilEval_subst_of_mem J k hJ s hs _ hq0 (T.toSeries 0)).1
      have hTu : ∀ i, MvFormalGroup.nilEval k ((T.toSeries.comp (X.act (((q : ℕ) : Zp2 q) ^ (n * μ₀)))) i) s =
          MvFormalGroup.nilEval k (T.toSeries i) u := fun i =>
        (MvFormalGroup.nilEval_subst_of_mem J k hJ s hs _ hq0 (T.toSeries i)).2

      have hu_iter : u = (fun t : Fin 2 → C => X.F.nilMul k t s)^[q ^ (n * μ₀)] 0 := by
