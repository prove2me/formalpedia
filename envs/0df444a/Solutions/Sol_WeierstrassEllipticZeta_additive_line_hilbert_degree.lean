  have hδ : ∀ i, δ i ≤ 1 := by
    intro i
    fin_cases i <;> simp [δ, boundaryLineDegrees] <;> split_ifs <;> omega
  have hv : ∀ j, (v j).natDegree ≤ δ j.1 := by
    intro ⟨i, j⟩
    fin_cases i
    · fin_cases j
      · simp [v, boundaryLinePolynomials, extensionProductVariableEquiv]
      · by_cases ha : a = 0
        · simp [v, δ, boundaryLinePolynomials, boundaryLineDegrees, extensionProductVariableEquiv, ha]
        · simp [v, δ, boundaryLinePolynomials, boundaryLineDegrees, extensionProductVariableEquiv,
            ha, Polynomial.natDegree_C_mul ha]
    · fin_cases j
      all_goals try simp [v, boundaryLinePolynomials, extensionProductVariableEquiv]
      by_cases hb : b = 0
      · simp [δ, boundaryLineDegrees, hb]
      · simp [δ, boundaryLineDegrees, hb, Polynomial.natDegree_C_mul hb]
  have hU : ∀ i, extensionProductAmbient.IsHomogeneous (U i)
      (fun j => if j = i then 1 else 0) := by
    intro i
    fin_cases i
    · exact extensionProductAmbient.isHomogeneous_X ⟨0, 0⟩
    · exact extensionProductAmbient.isHomogeneous_X ⟨1, 2⟩
  have hV : ∀ i, extensionProductAmbient.IsHomogeneous (V i)
      (fun j => if j = i then 1 else 0) := by
    intro i
    fin_cases i
    · by_cases ha : a = 0
      · simpa [V, ha] using hU 0
      · simpa [V, ha] using (extensionProductAmbient.isHomogeneous_X ⟨0, 1⟩).C_mul
          extensionProductAmbient a⁻¹
    · by_cases hb : b = 0
      · simpa [V, hb] using hU 1
      · simpa [V, hb] using ((extensionProductAmbient.isHomogeneous_X ⟨1, 4⟩).sub
          extensionProductAmbient ((extensionProductAmbient.isHomogeneous_X ⟨1, 2⟩).C_mul
            extensionProductAmbient ρ)).C_mul extensionProductAmbient b⁻¹
  have hUeval : ∀ i, aeval v (U i) = 1 := by
    intro i
    fin_cases i <;> simp [U, v, boundaryLinePolynomials, extensionProductVariableEquiv]
  have hVeval : ∀ i, aeval v (V i) = Polynomial.X ^ δ i := by
    intro i
    fin_cases i
    · by_cases ha : a = 0
      · simp [V, δ, boundaryLineDegrees, ha, hUeval]
      · simp [V, v, δ, boundaryLineDegrees, boundaryLinePolynomials,
          extensionProductVariableEquiv, ha, ← mul_assoc, ← Polynomial.C_mul]
    · by_cases hb : b = 0
      · simp [V, δ, boundaryLineDegrees, hb, hUeval]
      · simp [V, v, δ, boundaryLineDegrees, boundaryLinePolynomials,
          extensionProductVariableEquiv, hb, ← mul_assoc, ← Polynomial.C_mul]
  have h := MultiProjectiveSpace.binary_linear_parametrization_hilbertPolynomial
    ![1, 4] p v hrep δ hδ hv U V hU hV hUeval hVeval
  convert h using 1
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;> simp [δ, boundaryLineDegrees, ha, hb]

/-- A nonconstant line has degree m, n, or m+n according to its nonconstant
projections; this is Philippon's actual factorial-normalized degree value. -/
theorem boundary_line_degreeValue (a b ρ : ℂ) (hne : a ≠ 0 ∨ b ≠ 0)
    (p : ℂ → extensionProductAmbient.Point)
    (hp : ∀ t, (∃ h : ![1, a * t] ≠ (0 : Fin 2 → ℂ),
        Projectivization.mk ℂ ![1, a * t] h = p t 0) ∧
      (∃ h : ![0, 0, 1, 0, ρ + b * t] ≠ (0 : Fin 5 → ℂ),
        Projectivization.mk ℂ ![0, 0, 1, 0, ρ + b * t] h = p t 1)) (D : Fin 2 → ℕ) :
    Hilbert.degreeValue ℂ 2 ![1, 4]
      (extensionProductAmbient.vanishingIdeal (Set.range p)) D =
        (if a = 0 then 0 else (D 0 : ℚ)) + (if b = 0 then 0 else (D 1 : ℚ)) := by
  let R : MvPolynomial (Fin 2) ℚ := (if a = 0 then 0 else X 0) + (if b = 0 then 0 else X 1)
  have hR : R.IsHomogeneous 1 := by
    dsimp [R]
    apply MvPolynomial.IsHomogeneous.add <;>
      split_ifs <;> first | exact MvPolynomial.isHomogeneous_zero (Fin 2) ℚ _ | exact MvPolynomial.isHomogeneous_X ℚ _
  have hRne : R ≠ 0 := by
    intro hz
    have h := congrArg (MvPolynomial.eval (fun _ => (1 : ℚ))) hz
    rcases hne with ha | hb
    · by_cases hb : b = 0 <;> simp [R, ha, hb] at h
    · by_cases ha : a = 0 <;> simp [R, ha, hb] at h
  rw [Hilbert.degreeValue, Hilbert.degreeForm_of_hilbertPolynomial_linear _ R hR hRne
    (boundary_line_hilbertPolynomial a b ρ p hp)]
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;> simp [R, ha, hb]

end WeierstrassEllipticZeta
end

set_option backward.isDefEq.respectTransparency false
open PhilipponMultiplicity MvPolynomial
theorem solution (a b ρ : ℂ) (hne : a ≠ 0 ∨ b ≠ 0)
    (p : ℂ → (@MultiProjectiveSpace.mk ℂ 2 (by decide) ![1, 4]).Point)
    (hp : ∀ t, (∃ h : ![1, a * t] ≠ (0 : Fin 2 → ℂ),
        Projectivization.mk ℂ ![1, a * t] h = p t (0 : Fin 2)) ∧
      (∃ h : ![0, 0, 1, 0, ρ + b * t] ≠ (0 : Fin 5 → ℂ),
        Projectivization.mk ℂ ![0, 0, 1, 0, ρ + b * t] h = p t (1 : Fin 2))) (D : Fin 2 → ℕ) :
    Hilbert.degreeValue ℂ 2 ![1, 4]
      ((@MultiProjectiveSpace.mk ℂ 2 (by decide) ![1, 4]).vanishingIdeal (Set.range p)) D =
        (if a = 0 then 0 else (D 0 : ℚ)) + (if b = 0 then 0 else (D 1 : ℚ)) := by
  exact WeierstrassEllipticZeta.boundary_line_degreeValue a b ρ hne p hp D
