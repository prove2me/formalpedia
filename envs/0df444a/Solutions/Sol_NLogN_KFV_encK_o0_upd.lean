theorem encK_o0 (s : IState HS) (fG : Fin HS → List ℤ) (v : List ℤ) :
    NLogN.KIL.encK (NLogN.KIL.encK s fG) (o0 v) = NLogN.KIL.encK s (Function.update fG 0 (v ++ fG 0)) := by
  rw [encK_encK]
  congr 1
  funext j
  by_cases h : j = 0
  · subst h; simp
  · simp [o0_ne v h, h]

