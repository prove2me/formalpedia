theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hreg : TypeDensity.RegularParameterPair R t x) (hregSwap : TypeDensity.RegularParameterPair R x t) (f : R)
    (hf : ∀ j : ℕ, TypeDensity.surfaceToCechInput R t x j f = (TypeDensity.cechInputLattice R t x j).mkQ
    (TypeDensity.gluedFunctionPair R t x G j)) :
    ∃ c : Fin (d+1) → R, f = ∑ i : Fin (d+1), c i * t^(d - i.val) * x^i.val ∧ G.left 1 - ∑ i : Fin
      (d+1), algebraMap R (TypeDensity.BlowupChart R t x) (c i) * (TypeDensity.chartSlope R t x)^i.val ∈ TypeDensity.chartExceptional R
      t x ∧ G.right 1 - ∑ i : Fin (d+1), algebraMap R (TypeDensity.BlowupChart R x t) (c i) *
      (TypeDensity.chartSlope R x t)^(d - i.val) ∈ TypeDensity.chartExceptional R x t := by
  obtain ⟨c, hc⟩ := TypeDensity.monomial_span_pow R t x d f
    (TypeDensity.glued_function_order R t x beta d G hreg f hf)
  refine ⟨c, hc, ?_, ?_⟩
  · have hA : ∀ r : R, algebraMap R (TypeDensity.BlowupChart R t x) r = TypeDensity.chartBase R t x r := fun _ => rfl
    have hrel := TypeDensity.blowup_chart_relation R t x
    have hmap : algebraMap R (TypeDensity.BlowupChart R t x) f = (TypeDensity.chartBase R t x t)^d *
        ∑ i : Fin (d+1), algebraMap R (TypeDensity.BlowupChart R t x) (c i) * (TypeDensity.chartSlope R t x)^i.val := by
      rw [hc, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      have hi : i.val + (d - i.val) = d := by omega
      simp only [map_mul, map_pow, hA, ← hrel]
      rw [show (TypeDensity.chartBase R t x t)^d = (TypeDensity.chartBase R t x t)^i.val * (TypeDensity.chartBase R t x t)^(d - i.val)
          from by rw [← pow_add, hi]]
      ring
    have h := TypeDensity.glued_function_left_chart R t x beta d G f hf (d+1)
    rw [hmap] at h
    exact TypeDensity.sub_mem_span_of_pow_mul_sub_mem _ (TypeDensity.blowup_exceptional_parameter_regular R t x hreg)
      G.left G.left_compat d _ h
  · have hA : ∀ r : R, algebraMap R (TypeDensity.BlowupChart R x t) r = TypeDensity.chartBase R x t r := fun _ => rfl
    have hrel := TypeDensity.blowup_chart_relation R x t
    have hmap : algebraMap R (TypeDensity.BlowupChart R x t) f = (TypeDensity.chartBase R x t x)^d *
        ∑ i : Fin (d+1), algebraMap R (TypeDensity.BlowupChart R x t) (c i) *
            (TypeDensity.chartSlope R x t)^(d - i.val) := by
      rw [hc, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      have hi : (d - i.val) + i.val = d := by omega
      simp only [map_mul, map_pow, hA, ← hrel]
      rw [show (TypeDensity.chartBase R x t x)^d = (TypeDensity.chartBase R x t x)^(d - i.val) * (TypeDensity.chartBase R x t x)^i.val
          from by rw [← pow_add, hi]]
      ring
    have h := TypeDensity.glued_function_right_chart R t x beta d G f hf (d+1)
    rw [hmap] at h
    exact TypeDensity.sub_mem_span_of_pow_mul_sub_mem _ (TypeDensity.blowup_exceptional_parameter_regular R x t hregSwap)
      G.right G.right_compat d _ h
