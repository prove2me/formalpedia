    have hum : Sp.toCornerRing i u • m = ϖ • (⟨Sp.e i • w₀, hew₀⟩ : ↥(cornerSubmodule (M := H1 (N * r) H₀ 𝒪) (Sp.e i))) := by
      apply Subtype.ext
      rw [Submodule.coe_smul_of_tower]
