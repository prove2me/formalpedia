/-! ## Arithmetic facts for the `B̃` tables -/

/-- Size conditions of the `B̃` table builders. -/
structure TabHypB (p s t α Bq : ℕ) : Prop where
  h24 : (α ^ 2 + s + t + 2 * HvdH.eWidth p α + 2) ^ 24 < 2 ^ Bq
  hEq : (4 * p + 35) * 2 ^ (2 * p) < 2 ^ Bq

