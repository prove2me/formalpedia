  obtain ⟨hpart, -⟩ := TypeDensity.fixed_tangent_cell_chart_partition m.O m.R m.S m.s m.s.degree
    (m.atlas.chart i).b (m.atlas.chart i).f hf hinj (m.toMeasured.cellDegree c) Mlev hM c.2.1 reps
    hreps
  have hstate : ∀ z₀, TypeDensity.coordinateIdeal m.S.pi (m.atlas.chart i).f (m.atlas.chart i).b z₀ ∈
      TypeDensity.surfaceStateSet m.O m.R m.S m.s := fun z₀ ↦ by
    change Ideal.span {_ + TypeDensity.coordinateLift _ _} ∈ _
    rw [TypeDensity.coordinateLift_smul_eq_mul]
    exact TypeDensity.surface_state_vertical_perturbation m.O m.R m.S m.s (m.atlas.chart i).f _ hf
  rw [Finset.filter_congr fun z₀ _ ↦ ⟨fun h ↦ h.2, fun h ↦ ⟨hstate z₀, h⟩⟩]
  have h2 := congrArg
    (fun T ↦ TypeDensity.coordinateIdeal m.S.pi (m.atlas.chart i).f (m.atlas.chart i).b ⁻¹' T) hpart
  simp only [Set.preimage_inter_range] at h2
  refine h2.trans ?_
  simp only [Set.preimage_iUnion₂, Set.preimage_image_eq _ hinj]
