private theorem _root_.AlgebraicCurve.ComponentChart.degreeOn_comap {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} (h : R.DegreeOn Q D) :
    (C.comapRP σ).DegreeOn Q (RegularProlongation.smulDisc σ⁻¹ D) := by
  classical
  intro f hf D' hD hD0
  have hmemD : ∀ P, P ∈ RegularProlongation.smulDisc σ⁻¹ D ↔ σ • P ∈ D := fun P => by
    rw [RegularProlongation.mem_smulDisc_iff, inv_inv]
  let f' : R.integers := ⟨σ f, (C.mem_comapRP_integers_iff R hint σ f).mp f.2⟩
  have hresq : (C.comapRP σ).residue f = R.residue f' := C.comapRP_residue_eq R hint hres σ f f.2
  have hf' : R.residue f' ≠ 0 := fun h0 => hf (by rw [hresq, h0])
  have key := h f' hf' (σ • D') (fun P hP => ?_) (fun P hP => ?_)
  · rw [hresq, ← key, Divisor.smul_def, Finsupp.sum_mapDomain_index_inj (MulAction.injective (β := Place L F) σ)]
  · have hPσ : σ • (σ⁻¹ • P) ∈ D := by rw [smul_inv_smul]; exact hP
    rw [Divisor.smul_apply, hD (σ⁻¹ • P) ((hmemD _).mpr hPσ), ← Place.ord_smul σ (σ⁻¹ • P), smul_inv_smul]
  · rw [Divisor.smul_apply]
    refine hD0 _ (fun h' => hP ?_)
    have := (hmemD _).mp h'
    rwa [smul_inv_smul] at this

