    have hDseg : NLogN.IRuns I iprog NLogN.difSegD s3 s4 _ :=
      NLogN.IRuns.seq_assoc (NLogN.IRuns.seq_assoc (NLogN.IRuns.seq (NLogN.IRuns.seq hD1 hD2) hD3))
    have hMain := NLogN.IRuns.seq hA' (NLogN.IRuns.seq hB (NLogN.IRuns.seq hC (NLogN.IRuns.seq hDseg (NLogN.IRuns.seq hE
