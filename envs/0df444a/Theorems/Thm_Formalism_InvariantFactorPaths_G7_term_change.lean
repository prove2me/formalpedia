theorem Formalism.InvariantFactorPaths.G7.term_change {K ι : Type} [Field K] {pp : K} (hpp : pp ≠ 0) (hh Y : MvPowerSeries ι K)
    (U : ℕ → MvPowerSeries ι K) (i : ℕ) :
    MvPowerSeries.C ((pp ^ i)⁻¹) * (hh ^ i * U i) =
      ∑ b ∈ range (i + 1), MvPowerSeries.C ((pp ^ b)⁻¹) *
        ((hh + MvPowerSeries.C pp * Y) ^ b * chT Y U b (i - b)) := by sorry
