theorem ell_ge {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) : 2 ≤ ell (IntMul.OpenAI.Glue.LP n) (D + 1) := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, hr64, -⟩ := setup_facts hn
  have hr : IntMul.OpenAI.R129.rP n = 2 ^ ell (IntMul.OpenAI.Glue.LP n) (D + 1) := by unfold IntMul.OpenAI.R129.rP ℓP; rw [hD]
  by_contra h
  push Not at h
  have : 2 ^ ell (IntMul.OpenAI.Glue.LP n) (D + 1) ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
  omega

theorem tBD_eq {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) (i : Fin (D + 1)) :
    tBD n D i = 2 ^ axExp (IntMul.OpenAI.Glue.LP n) (D + 1) i := by
  have hdp : dpN n = mcnt (IntMul.OpenAI.Glue.LP n) (D + 1) := by unfold dpN; rw [hD]
  have hr : IntMul.OpenAI.R129.rP n = 2 ^ ell (IntMul.OpenAI.Glue.LP n) (D + 1) := by unfold IntMul.OpenAI.R129.rP ℓP; rw [hD]
  have hl := ell_ge hn hD
  unfold tBD axExp
  rw [hdp, hr]
  by_cases h : mcnt (IntMul.OpenAI.Glue.LP n) (D + 1) ≤ i.val
  · rw [if_pos h, if_neg (by omega)]
  · obtain ⟨m, hm⟩ : ∃ m, ell (IntMul.OpenAI.Glue.LP n) (D + 1) = m + 1 := ⟨ell (IntMul.OpenAI.Glue.LP n) (D + 1) - 1, by omega⟩
    rw [if_neg h, if_pos (by omega), hm, pow_succ, Nat.mul_div_cancel _ (by norm_num)]
    simp

theorem tBD_pow {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) (i : Fin (D + 1)) :
    ∃ e, 1 ≤ e ∧ tBD n D i = 2 ^ e := by
  refine ⟨axExp (IntMul.OpenAI.Glue.LP n) (D + 1) i, ?_, tBD_eq hn hD i⟩
  have := ell_ge hn hD
  rcases axExp_cases (IntMul.OpenAI.Glue.LP n) (D + 1) i with h | h <;> omega

theorem win {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) (i : Fin (D + 1)) :
    (4 * IntMul.OpenAI.R129.dP n - 2) * tBD n D i < 4 * IntMul.OpenAI.R129.dP n * sBD n D i ∧
      4 * IntMul.OpenAI.R129.dP n * sBD n D i ≤ (4 * IntMul.OpenAI.R129.dP n - 1) * tBD n D i ∧ Odd (sBD n D i) := by
  have hdp : dpN n ≤ IntMul.OpenAI.R129.dP n := (mcnt_lt _ _ (by omega)).le
  obtain ⟨hodd, -, hw⟩ := srcS_ok_n hn (dpN n) hdp
  have h1 := hw ⟨i.val, by omega⟩
  have h2 := hodd ⟨i.val, by omega⟩
  have ht : tBD n D i = if i.val < dpN n then IntMul.OpenAI.R129.rP n / 2 else IntMul.OpenAI.R129.rP n := by
    unfold tBD; split_ifs <;> first | rfl | omega
  rw [ht]
  exact ⟨h1.1, h1.2, h2⟩

