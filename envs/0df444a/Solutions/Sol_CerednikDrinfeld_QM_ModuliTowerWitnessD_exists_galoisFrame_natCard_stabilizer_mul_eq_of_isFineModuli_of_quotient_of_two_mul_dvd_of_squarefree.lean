theorem GCAux.phi_zero_eq_germ_pullback_of_quotient_presentation_D
    {N q q' D : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime]
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b])
    (Fbar : Type) [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
    [IsCurveOver (AlgebraicClosure ℚ) Fbar] [Algebra.EssFiniteType (AlgebraicClosure ℚ) Fbar]
    (X : Scheme.{0}) (πX : X ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
    (sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
    (pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))),
      FakeEllipticCurve Λ N S → SchemeHomOver s πX)
    (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) Fbar)
    (e𝔐 : 𝔐.C ⟶ CategoryTheory.Limits.pullback πX sbar) [CategoryTheory.IsIso e𝔐]
    (he𝔐 : e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar = 𝔐.toBase)
    (𝕋 : HeckeTower.TowerData q q' Fbar) (ℓ : HeckeTower.AwayPrime q q')
    (Y : Scheme.{0}) (πY : Y ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) [IsIntegral Y] [IsSeparated πY]
    (ptT : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S → SchemeHomOver s πY)
    (hY : IsCoarseModuliT Λ N (ℓ.1 : ℕ) Y πY ptT)
    (d₀ : Y ⟶ X)
    (hd₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (u : FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S), (ptT S s u).1 ≫ d₀ = (pt S (s ≫ sbar) u.1).1)
    (𝔐ℓ : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) (𝕋.F ℓ)) (eℓ : 𝔐ℓ.C ⟶ Y) [IsIso eℓ] (heℓ : eℓ ≫ πY = 𝔐ℓ.toBase)
    (hcompat₀ : ∀ R : Place (AlgebraicClosure ℚ) (𝕋.F ℓ),
      (𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ ≫ d₀ = (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar)

    (Xq : Scheme.{0}) (πXq : Xq ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
    (ptq : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve Λ N S → SchemeHomOver s πXq)
    (gX : Xq ⟶ CategoryTheory.Limits.pullback πX sbar) (hgXiso : IsIso gX)
    (hgXπ : gX ≫ CategoryTheory.Limits.pullback.snd πX sbar = πXq)
    (hgXpt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (E' : FakeEllipticCurve Λ N S), (ptq S s E').1 ≫ gX ≫ CategoryTheory.Limits.pullback.fst πX sbar = (pt S (s ≫ sbar) E').1)
    (XH : Scheme.{0}) (πXH : XH ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (dH : XH ⟶ Xq) [IsFinite dH]
    (hdHπ : dH ≫ πXq = πXH)
    (U : XH.Opens) (hUclosed : IsClosed (U : Set XH))
    (ptU : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S → SchemeHomOver s (U.ι ≫ πXH))
    (hU : IsCoarseModuliT Λ N (ℓ.1 : ℕ) (U : Scheme.{0}) (U.ι ≫ πXH) ptU)
    (hUd : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (v : FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S), (ptU S s v).1 ≫ U.ι ≫ dH = (ptq S s v.1).1)
    (hsurjU : Function.Surjective (U.ι ≫ dH).base)
    (gU : (U : Scheme.{0}) ⟶ Y) (hgUiso : IsIso gU) (hgUπ : gU ≫ πY = U.ι ≫ πXH)
    (hgUpt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (u : FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S), (ptT S s u).1 = (ptU S s u).1 ≫ gU) :
    ∃ d : 𝔐ℓ.C ⟶ 𝔐.C,
      d = eℓ ≫ inv gU ≫ U.ι ≫ dH ≫ gX ≫ inv e𝔐 ∧
      d ≫ 𝔐.toBase = 𝔐ℓ.toBase ∧ IsFinite d ∧ Function.Surjective d.base ∧
      (∀ R : Place (AlgebraicClosure ℚ) (𝕋.F ℓ),
        (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d = (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1) ∧
      ∀ (V : 𝔐.C.Opens) [Nonempty (V : Scheme.{0})] [Nonempty ((d ⁻¹ᵁ V : 𝔐ℓ.C.Opens) : Scheme.{0})] (t : Γ(𝔐.C, V)),
        𝕋.φ (ℓ, 0) (𝔐.ffEquiv.symm (𝔐.C.germToFunctionField V t)) =
          𝔐ℓ.ffEquiv.symm (𝔐ℓ.C.germToFunctionField (d ⁻¹ᵁ V) ((d.app V).hom t)) := by
  classical
  haveI := hgUiso
  haveI := hgXiso

  obtain ⟨π, hπbase, hπfin, hπflat, hπlfp, -, -, hπcl, -⟩ :=
    𝔐.exists_finite_flat_hom_of_algHom 𝔐ℓ (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)) (𝕋.finite (ℓ, 0))

  obtain ⟨d, hd⟩ : ∃ d : 𝔐ℓ.C ⟶ 𝔐.C, d = eℓ ≫ inv gU ≫ U.ι ≫ dH ≫ gX ≫ inv e𝔐 := ⟨_, rfl⟩
  have hinv𝔐 : inv e𝔐 ≫ 𝔐.toBase = CategoryTheory.Limits.pullback.snd πX sbar := by
    rw [← he𝔐, IsIso.inv_hom_id_assoc]
  have hinvgU : inv gU ≫ U.ι ≫ πXH = πY := by
    rw [← hgUπ, IsIso.inv_hom_id_assoc]

  have hd_base : d ≫ 𝔐.toBase = 𝔐ℓ.toBase := by
    rw [hd]; simp only [Category.assoc]
    rw [hinv𝔐, hgXπ, hdHπ, hinvgU, heℓ]

  have hUι : IsClosedImmersion U.ι :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.Opens.range_ι]; exact hUclosed)
  have hfin : IsFinite d := by rw [hd]; infer_instance

  have hsurj : Function.Surjective d.base := by
    have h1 : Surjective (U.ι ≫ dH) := ⟨hsurjU⟩
    have h2 : Surjective ((eℓ ≫ inv gU) ≫ (U.ι ≫ dH) ≫ (gX ≫ inv e𝔐)) := inferInstance
    have he : (eℓ ≫ inv gU) ≫ (U.ι ≫ dH) ≫ (gX ≫ inv e𝔐) = d := by rw [hd]; simp only [Category.assoc]
    rw [← he]; exact h2.surj

  have hcompat : ∀ R : Place (AlgebraicClosure ℚ) (𝕋.F ℓ),
      (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d =
        (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 := by
    intro R
    have hy : ((𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ) ≫ πY = 𝟙 _ := by rw [Category.assoc, heℓ, (𝔐ℓ.pointEquivPlace.symm R).2]
    obtain ⟨u, hu⟩ := hY.ptT_surjective (AlgebraicClosure ℚ) (𝟙 _) ⟨(𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ, hy⟩
    have hu1 : (ptT (AlgebraicClosure ℚ) (𝟙 _) u).1 = (𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ := congrArg Subtype.val hu
    have step1 : (𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ ≫ inv gU = (ptU (AlgebraicClosure ℚ) (𝟙 _) u).1 := by
      rw [← Category.assoc, ← hu1, hgUpt (AlgebraicClosure ℚ) (𝟙 _) u, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id]
    have step2 : (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar =
        (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar := by
      have : (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar =
          ((((𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ ≫ inv gU) ≫ U.ι ≫ dH) ≫ gX) ≫ CategoryTheory.Limits.pullback.fst πX sbar := by
        rw [hd]; simp only [Category.assoc, IsIso.inv_hom_id_assoc]
      rw [this, step1, hUd (AlgebraicClosure ℚ) (𝟙 _) u, Category.assoc,
        hgXpt (AlgebraicClosure ℚ) (𝟙 _) u.1, ← hd₀ (AlgebraicClosure ℚ) (𝟙 _) u, hu1, Category.assoc,
        hcompat₀ R]
    have step3 : (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar =
        (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar := by
      rw [he𝔐, (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).2, hd_base, (𝔐ℓ.pointEquivPlace.symm R).2]
    have key : (𝔐ℓ.pointEquivPlace.symm R).1 ≫ d ≫ e𝔐 = (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 ≫ e𝔐 := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · simpa only [Category.assoc] using step2
      · simpa only [Category.assoc] using step3
    rw [← Category.assoc] at key
    exact (cancel_mono e𝔐).1 key

  have hπd : π = d := by
    refine AlgebraicGeometry.ext_of_forall_comp_eq_of_isAlgClosed 𝔐ℓ.toBase 𝔐.toBase hπbase hd_base ?_
    intro x hx
    have hxπ : (x ≫ π) ≫ 𝔐.toBase = 𝟙 _ := by rw [Category.assoc, hπbase, hx]
    have key : 𝔐.pointEquivPlace ⟨x ≫ π, hxπ⟩ =
        (𝔐ℓ.pointEquivPlace ⟨x, hx⟩).restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)) := by
      rw [CurveModel.pointEquivPlace_apply, CurveModel.pointEquivPlace_apply]
      obtain ⟨h, hh⟩ := hπcl (pointEquivClosedPoint 𝔐ℓ.toBase ⟨x, hx⟩)
      convert hh using 2 <;> first | rfl | exact Subsingleton.elim _ _
    have e1 : x ≫ d = (𝔐.pointEquivPlace.symm
        ((𝔐ℓ.pointEquivPlace ⟨x, hx⟩).restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 := by
      have := hcompat (𝔐ℓ.pointEquivPlace ⟨x, hx⟩)
      rwa [Equiv.symm_apply_apply] at this
    have e2 : x ≫ π = (𝔐.pointEquivPlace.symm
        ((𝔐ℓ.pointEquivPlace ⟨x, hx⟩).restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 := by
      rw [← key, Equiv.symm_apply_apply]
    rw [e1, e2]
  rw [hπd] at hπflat hπlfp

  refine ⟨d, hd, hd_base, hfin, hsurj, hcompat, ?_⟩
  intro V _ hne t
  obtain ⟨z⟩ := id hne
  have hp : d.base z.1 ∈ V := z.2
  letI : Algebra Fbar (𝕋.F ℓ) := algebraAlong (𝕋.φ (ℓ, 0))
  haveI := isScalarTower_along (𝕋.φ (ℓ, 0))
  haveI := isIntegral_along (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0))
  have H := AlgebraicCurve.CurveModel.ffEquiv_symm_stalkMap_eq_algebraMap 𝔐 𝔐ℓ d hd_base ?_ z.1
    (𝔐.C.presheaf.germ V (d.base z.1) hp t)
  · rw [Scheme.Hom.germ_stalkMap_apply] at H
    rw [germToFunctionField_eq_algebraMap_germ V (d.base z.1) hp t,
      germToFunctionField_eq_algebraMap_germ (d ⁻¹ᵁ V) z.1 hp]
    exact H.symm
  · intro y x hyx
    have h1 := hcompat (𝔐ℓ.pointEquivPlace y)
    rw [Equiv.symm_apply_apply, hyx] at h1
    have h2 : x = 𝔐.pointEquivPlace.symm
        ((𝔐ℓ.pointEquivPlace y).restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0))) := Subtype.ext h1
    rw [h2, Equiv.apply_symm_apply]
    rfl

theorem solution
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime]
    (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q) (hNsq : Squarefree N)
    (D : ℕ) (hD : 2 * N * q * q' ∣ D)

    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)

    (Fbar : Type) [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
    [IsCurveOver (AlgebraicClosure ℚ) Fbar] [Algebra.EssFiniteType (AlgebraicClosure ℚ) Fbar]
    (X : Scheme.{0}) (πX : X ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
    (sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
    (pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))),
      FakeEllipticCurve Λ N S → SchemeHomOver s πX)
    (pt_iso : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
      (E E' : FakeEllipticCurve Λ N S), FakeEllipticCurve.Iso E E' → pt S s E = pt S s E')
    (pt_pullback : ∀ (S S' : Type) [CommRing S] [CommRing S'] (φ : S →+* S')
      (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
      (s' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ)))),
      Spec.map (CommRingCat.ofHom φ) ≫ s = s' → ∀ (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N S'),
      FakeEllipticCurve.IsPullback φ E E' → (pt S' s' E').1 = Spec.map (CommRingCat.ofHom φ) ≫ (pt S s E).1)
    (pt_surjective : ∀ (k : Type) [Field k] [IsAlgClosed k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
      (x : SchemeHomOver s πX), ∃ E : FakeEllipticCurve Λ N k, pt k s E = x)
    (pt_injective : ∀ (k : Type) [Field k] [IsAlgClosed k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
      (E E' : FakeEllipticCurve Λ N k), pt k s E = pt k s E' → FakeEllipticCurve.Iso E E')

    (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) Fbar)
    (e𝔐 : 𝔐.C ⟶ CategoryTheory.Limits.pullback πX sbar) [CategoryTheory.IsIso e𝔐]
    (he𝔐 : e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar = 𝔐.toBase)
    (gal : ((AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ)) →* SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (𝕋 : HeckeTower.TowerData q q' Fbar)
    (galT : ∀ ℓ : HeckeTower.AwayPrime q q', ((AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ)) →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (WT : ∀ ℓ : HeckeTower.AwayPrime q q', Fin 2 → SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    (tw : ModuliTowerWitnessD Λ N q q' D Fbar X πX sbar pt 𝔐 e𝔐 gal 𝕋 galT W WT)
    (ℓ : HeckeTower.AwayPrime q q')

    (Y : Scheme.{0}) (πY : Y ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) [IsIntegral Y] [IsSeparated πY]
    (hYsm : SmoothOfRelativeDimension 1 πY)
    (ptT : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S → SchemeHomOver s πY)
    (hY : IsCoarseModuliT Λ N (ℓ.1 : ℕ) Y πY ptT)
    (d₀ : Y ⟶ X)
    (hd₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (u : FakeEllipticCurve.WithExtraLevel Λ N (ℓ.1 : ℕ) S), (ptT S s u).1 ≫ d₀ = (pt S (s ≫ sbar) u.1).1)
    (𝔐ℓ : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) (𝕋.F ℓ)) (eℓ : 𝔐ℓ.C ⟶ Y) [IsIso eℓ] (heℓ : eℓ ≫ πY = 𝔐ℓ.toBase)
    (hcompat₀ : ∀ R : Place (AlgebraicClosure ℚ) (𝕋.F ℓ),
      (𝔐ℓ.pointEquivPlace.symm R).1 ≫ eℓ ≫ d₀ = (𝔐.pointEquivPlace.symm (R.restrictAlong (𝕋.φ (ℓ, 0)) (𝕋.integral (ℓ, 0)))).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar)

