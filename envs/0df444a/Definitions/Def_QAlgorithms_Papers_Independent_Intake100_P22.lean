/-!
Bravyi, Lagrangian representation for fermionic linear optics,
arXiv:quant-ph/0404180v2. All page references are PDF pages.
The accepted CAR representation, ordered monomials, generic matrix alias and
Mathlib Kronecker product are reused. The accepted CAR module's
Wick-defined Gaussian-state predicate is deliberately not used. Grassmann
polynomials below are finite coefficient tables, with explicit graded signs.
Distinct fermionic concepts use explicit names where unrelated pinned papers
have the same short names. See ASSESSMENT.json and MODERATION_NOTES.md.
Theorem 2 includes the zero-prefactor correction discussed in HARD.md.
Compilation and independent moderation are pending the batch handoff.
-/

noncomputable section

open scoped BigOperators Matrix ComplexConjugate ComplexOrder

namespace QAlgorithms.Papers.Independent.Intake100.P22

open QAlgorithms.Papers.Independent.Advance50.P19
  (CARSystem Major monomial wick totalFermionParity)

open QAlgorithms.Papers.Independent.Information100.P21 (Op)

attribute [local instance] Classical.propDecidable Classical.decEq

/-- PDF p.3: coefficients of ordered square-free Grassmann monomials. -/
abbrev Grass (d : ℕ) := Finset (Fin d) → ℂ

/-- PDF p.3: the scalar unit of the Grassmann algebra. -/
def grassOne (d : ℕ) : Grass d := fun S => if S = ∅ then 1 else 0

/-- PDF p.3: variable with zero-based index a; zero outside the specified algebra. -/
def grassVar (d a : ℕ) : Grass d :=
  fun S => if ∃ i : Fin d, i.val = a ∧ S = {i} then 1 else 0

/-- PDF p.3, Eq.(6): exterior multiplication, with one minus sign per crossing.
Intersecting supports contribute zero. -/
def grassMul {d : ℕ} (f g : Grass d) : Grass d := fun S =>
  ∑ A : Finset (Fin d), ∑ B : Finset (Fin d),
    if Disjoint A B ∧ A ∪ B = S then
      (-1 : ℂ) ^ ((A.product B).filter (fun p => p.2 < p.1)).card * f A * g B
    else 0

/-- PDF p.3: ordered products; the empty product is the scalar unit. -/
def grassProd {d : ℕ} : List (Grass d) → Grass d
  | [] => grassOne d
  | f :: fs => grassMul f (grassProd fs)

/-- PDF pp.3-4: powers used in the finite nilpotent Taylor series. -/
def grassPow {d : ℕ} (f : Grass d) : ℕ → Grass d
  | 0 => grassOne d
  | k + 1 => grassMul f (grassPow f k)

/-- PDF p.4: finite exponential, used only on forms with zero constant term. -/
def grassExp {d : ℕ} (q : Grass d) : Grass d :=
  ∑ k ∈ Finset.range (d + 1), ((k.factorial : ℂ)⁻¹) • grassPow q k

/-- PDF pp.3-4, Eqs.(9),(16): substitute linear Grassmann forms into a symbol. -/
def grassSubst {d e : ℕ} (f : Grass d) (v : Fin d → Grass e) : Grass e :=
  ∑ S : Finset (Fin d), f S • grassProd ((S.sort (fun a b => a ≤ b)).map v)

/-- PDF p.3: a consecutive variable block. All uses have block < blocks. -/
def blockVars (m blocks block : ℕ) : Fin m → Grass (blocks * m) :=
  fun a => grassVar (blocks * m) (block * m + a.val)

/-- PDF p.3: left Berezin integration of the variables after a retained prefix.
The sign comes from moving the left derivatives past the retained monomial.
Every application below integrates an even number of variables. -/
def grassIntegrate {d : ℕ} (keep : ℕ) (f : Grass d) : Grass keep := fun S =>
  if keep ≤ d then
    (-1 : ℂ) ^ ((d - keep) * S.card) *
      f (Finset.univ.filter (fun a : Fin d =>
        keep ≤ a.val ∨ ∃ b ∈ S, b.val = a.val))
  else 0

/-- PDF p.3: quadratic form without an implicit factor of one half. -/
def grassQuadratic {d e : ℕ} (M : Matrix (Fin d) (Fin d) ℂ)
    (v : Fin d → Grass e) : Grass e :=
  ∑ a, ∑ b, M a b • grassMul (v a) (v b)

/-- PDF p.4: ordered Majorana basis element associated to a support. -/
def basisOp {n : ℕ} (s : CARSystem n) (S : Finset (Major n)) : Op (Qubits n) :=
  monomial s (S.sort (fun a b => a ≤ b))

/-- PDF pp.2,4: the linear symbol map, via the trace-dual ordered CAR basis.
It is not an algebra homomorphism. -/
def majoranaSymbol {n : ℕ} (s : CARSystem n) (X : Op (Qubits n)) : Grass (2 * n) :=
  fun S => (2 : ℂ) ^ (-(n : ℤ)) * ((basisOp s S)ᴴ * X).trace

/-- PDF p.4, Definition 1: positive trace-one Gaussian density with real skew
matrix and no linear Grassmann terms. -/
def StateWith {n : ℕ} (s : CARSystem n) (rho : Op (Qubits n))
    (M : Matrix (Major n) (Major n) ℝ) : Prop :=
  IsDensityMatrix rho ∧ M.transpose = -M ∧
    majoranaSymbol s rho = ((2 : ℂ) ^ n)⁻¹ •
      grassExp ((Complex.I / 2) • grassQuadratic (M.map Complex.ofReal)
        (fun a => grassVar (2 * n) a.val))

/-- PDF p.4, Definition 1, including mixed and rank-deficient densities. -/
def FermionicGaussianState {n : ℕ} (s : CARSystem n) (rho : Op (Qubits n)) : Prop :=
  ∃ M, StateWith s rho M

/-- PDF pp.4-5: normalized complex correlation matrix of a regular operator.
It is used only with nonzero trace; states have trace one. -/
def regularCorrelation {n : ℕ} (s : CARSystem n) (X : Op (Qubits n)) :
    Matrix (Major n) (Major n) ℂ := fun a b =>
  (Complex.I / (2 * X.trace)) *
    (X * (s.majorana a * s.majorana b - s.majorana b * s.majorana a)).trace

/-- PDF p.5, Eq.(22): regular Gaussian operator with its complex skew matrix. -/
def RegularWith {n : ℕ} (s : CARSystem n) (X : Op (Qubits n))
    (M : Matrix (Major n) (Major n) ℂ) : Prop :=
  X.trace ≠ 0 ∧ M.transpose = -M ∧
    majoranaSymbol s X = (X.trace / (2 : ℂ) ^ n) •
      grassExp ((Complex.I / 2) • grassQuadratic M (fun a => grassVar (2 * n) a.val))

/-- PDF p.5, Definition 2: closure in the finite-dimensional operator topology
of the nonzero-trace Gaussian operators. In particular zero is admitted. -/
def GaussianOperator {n : ℕ} (s : CARSystem n) (X : Op (Qubits n)) : Prop :=
  X ∈ closure {Y : Op (Qubits n) | ∃ M, RegularWith s Y M}

/-- PDF pp.2,8: parity sector, defined on the full ordered CAR expansion. -/
def InSector {n : ℕ} (s : CARSystem n) (parity : ℕ) (X : Op (Qubits n)) : Prop :=
  ∀ S, S.card % 2 ≠ parity → majoranaSymbol s X S = 0

/-- PDF p.8, Definition 4: both even and odd sectors are preserved. -/
def ParityPreserving {n : ℕ} (s : CARSystem n) (E : Superop (Qubits n) (Qubits n)) : Prop :=
  ∀ p ∈ ({0, 1} : Finset ℕ), ∀ X, InSector s p X → InSector s p (E X)

/-- PDF p.7: complex linearity on every operator. -/
def ComplexLinear {I : Type*} (E : Matrix I I ℂ → Matrix I I ℂ) : Prop :=
  ∀ X Y (a b : ℂ), E (a • X + b • Y) = a • E X + b • E Y

/-- PDF p.7, Eq.(38): independent kernel parameters; Gaussianity alone
imposes neither positivity nor trace preservation. -/
structure GrassmannKernel (n : ℕ) where
  A : Matrix (Major n) (Major n) ℂ
  B : Matrix (Major n) (Major n) ℂ
  D : Matrix (Major n) (Major n) ℂ
  C : ℂ
  skewA : A.transpose = -A
  skewD : D.transpose = -D

/-- PDF p.7, Eq.(38): action in arbitrary anticommuting variable blocks. -/
def kernelAction {n e : ℕ} (K : GrassmannKernel n) (theta eta : Major n → Grass e) : Grass e :=
  (Complex.I / 2) • grassQuadratic K.A theta +
    Complex.I • (∑ a, ∑ b, K.B a b • grassMul (theta a) (eta b)) +
    (Complex.I / 2) • grassQuadratic K.D eta

/-- PDF pp.7-8, Eq.(37): actual finite Berezin-kernel evaluation on any symbol.
The variable order is theta, eta, mu; Deta Dmu integrates mu first. -/
def kernelEval {n : ℕ} (K : GrassmannKernel n) (f : Grass (2 * n)) : Grass (2 * n) :=
  K.C • grassIntegrate (2 * n)
    (grassMul
      (grassExp (kernelAction K (blockVars (2 * n) 3 0) (blockVars (2 * n) 3 1) +
        Complex.I • (∑ a : Major n,
          grassMul (blockVars (2 * n) 3 1 a) (blockVars (2 * n) 3 2 a))))
      (grassSubst f (blockVars (2 * n) 3 2)))

/-- PDF p.7, Definition 3: equality on all operators, including odd inputs. -/
def HasGrassmannKernel {n : ℕ} (s : CARSystem n) (E : Superop (Qubits n) (Qubits n))
    (K : GrassmannKernel n) : Prop :=
  ComplexLinear E ∧ ∀ X, majoranaSymbol s (E X) = kernelEval K (majoranaSymbol s X)

/-- PDF p.7, Definition 3, as an existential integral representation. -/
def GaussianMap {n : ℕ} (s : CARSystem n) (E : Superop (Qubits n) (Qubits n)) : Prop :=
  ∃ K, HasGrassmannKernel s E K

/-- PDF p.9: TP is trace equality on all operators. -/
def FullTracePreserving {n : ℕ} (E : Superop (Qubits n) (Qubits n)) : Prop :=
  ∀ X, (E X).trace = X.trace

/-- PDF p.9: bistochastic means TP and unital, without a CP requirement. -/
def Bistochastic {n : ℕ} (E : Superop (Qubits n) (Qubits n)) : Prop :=
  FullTracePreserving E ∧ E 1 = 1

/-- PDF p.9: ordinary extension E tensor Id, in first-factor block coordinates. -/
def ordinaryExtension {n : ℕ} (E : Superop (Qubits n) (Qubits n)) :
    Superop (Qubits n × Qubits n) (Qubits n × Qubits n) :=
  fun Z p q => E (fun x y => Z (x, p.2) (y, q.2)) p.1 q.1

/-- PDF p.9: positivity, without normalization or a trace bound. -/
def PositiveMap {I : Type*} [Fintype I]
    (E : Matrix I I ℂ → Matrix I I ℂ) : Prop :=
  ∀ X, X.PosSemidef → (E X).PosSemidef

/-- PDF p.9: complete positivity, tested on an equal-dimensional reference. -/
def LinearCompletelyPositive {n : ℕ} (E : Superop (Qubits n) (Qubits n)) : Prop :=
  ComplexLinear E ∧ PositiveMap (ordinaryExtension E)

/-- PDF p.2, Eq.(4): the source's quadratic Hamiltonian. -/
def quadraticHamiltonian {n : ℕ} (s : CARSystem n)
    (H : Matrix (Major n) (Major n) ℝ) : Op (Qubits n) :=
  (Complex.I / 4) • ∑ a, ∑ b, (H a b : ℂ) • (s.majorana a * s.majorana b)

/-- PDF p.2: exactly exp(i H), with no additional scalar phase parameter. -/
def canonicalFLO {n : ℕ} (s : CARSystem n)
    (H : Matrix (Major n) (Major n) ℝ) : Op (Qubits n) :=
  NormedSpace.exp (Complex.I • quadraticHamiltonian s H)

/-- PDF p.2: the canonical group generated by the stated real skew Hamiltonians. -/
def IsCanonicalFLO {n : ℕ} (s : CARSystem n) (V : Op (Qubits n)) : Prop :=
  ∃ H : Matrix (Major n) (Major n) ℝ, H.transpose = -H ∧ V = canonicalFLO s H

/-- PDF p.2: rotations are real special orthogonal matrices. -/
def Rotation {n : ℕ} (R : Matrix (Major n) (Major n) ℝ) : Prop :=
  R * R.transpose = 1 ∧ R.det = 1

/-- PDF p.4, Eq.(19): the full product density, including its normalization. -/
def productState {n : ℕ} (s : CARSystem n) (lambda : Fin n → ℝ) : Op (Qubits n) :=
  ((2 : ℂ) ^ n)⁻¹ • (List.ofFn (fun j : Fin n =>
    (1 : Op (Qubits n)) + (Complex.I * (lambda j : ℂ)) •
      (s.majorana ⟨2 * j.val, by omega⟩ *
        s.majorana ⟨2 * j.val + 1, by omega⟩))).prod

/-- PDF p.3: Pfaffian by the standard first-row pairing recursion. This reuses
only the accepted algebraic recursion, not its Gaussian-state predicate. -/
def pfaffian {d : ℕ} (M : Matrix (Fin d) (Fin d) ℂ) : ℂ :=
  wick (fun a b => M a b) d (List.finRange d)

/-- PDF pp.4,11: projector onto a specified occupation-number outcome.
false denotes empty and true occupied. -/
def modeProjector {n : ℕ} (s : CARSystem n) (j : Fin n) (outcome : Bool) : Op (Qubits n) :=
  (1 / 2 : ℂ) • ((1 : Op (Qubits n)) +
    (if outcome then -Complex.I else Complex.I) •
      (s.majorana ⟨2 * j.val, by omega⟩ *
        s.majorana ⟨2 * j.val + 1, by omega⟩))

/-- PDF pp.4-5,12: K supported only on the first mode, in zero-based indices. -/
def firstK (n : ℕ) : Matrix (Major n) (Major n) ℂ :=
  fun a b => if a.val = 0 ∧ b.val = 1 then 1
    else if a.val = 1 ∧ b.val = 0 then -1 else 0

/-- PDF p.5, Eq.(24): Lambda in the ordinary two-copy algebra. -/
def lambdaOp {n : ℕ} (s : CARSystem n) :
    Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ :=
  ∑ a, Matrix.kronecker (s.majorana a) (s.majorana a)

/-- PDF p.11: projector action as a quadratic form on theta and eta.
Its signs specify both outcomes and its missing two cross terms. -/
def floMeasurementAction {n e : ℕ} (j : Fin n) (outcome : Bool)
    (theta eta : Major n → Grass e) : Grass e :=
  let a : Major n := ⟨2 * j.val, by omega⟩
  let b : Major n := ⟨2 * j.val + 1, by omega⟩
  (if outcome then -Complex.I else Complex.I) •
    (grassMul (theta a) (theta b) - grassMul (eta a) (eta b)) +
    Complex.I • (∑ c : Major n, if c = a ∨ c = b then 0 else grassMul (theta c) (eta c))

/-- PDF p.11, Eq.(51): finite evaluation of the measurement action. -/
def measurementEval {n : ℕ} (j : Fin n) (outcome : Bool)
    (f : Grass (2 * n)) : Grass (2 * n) :=
  (1 / 2 : ℂ) • grassIntegrate (2 * n)
    (grassMul
      (grassExp (floMeasurementAction j outcome
        (blockVars (2 * n) 3 0) (blockVars (2 * n) 3 1) +
        Complex.I • (∑ a : Major n,
          grassMul (blockVars (2 * n) 3 1 a) (blockVars (2 * n) 3 2 a))))
      (grassSubst f (blockVars (2 * n) 3 2)))

/-- PDF p.8: A=D=0 and arbitrary B, with prefactor one. -/
def homogeneousKernel {n : ℕ} (B : Matrix (Major n) (Major n) ℂ) : GrassmannKernel n :=
  ⟨0, B, 0, 1, by simp, by simp⟩

/-- PDF pp.5,11: normalized state of a nonzero outcome; theorems guard its trace. -/
def normalizeComplexTrace {n : ℕ} (X : Op (Qubits n)) : Op (Qubits n) := X.trace⁻¹ • X

/-- PDF p.5, Eq.(26): singular Gaussian symbol, with an even ordered prefix. -/
def singularForm {n : ℕ} (k : ℕ) (C : ℂ)
    (T M : Matrix (Major n) (Major n) ℂ) : Grass (2 * n) :=
  let mu := fun a : Major n => ∑ b : Major n, T a b • grassVar (2 * n) b.val
  C • grassMul
    (grassProd (((List.finRange (2 * n)).filter (fun a => a.val < 2 * k)).map mu))
    (grassExp ((Complex.I / 2) • (∑ a : Major n, ∑ b : Major n,
      if 2 * k ≤ a.val ∧ 2 * k ≤ b.val then M a b • grassMul (mu a) (mu b) else 0)))

/-- PDF p.9, Theorem 2: the complete skew block, with theta before eta. -/
def kernelBlock {n : ℕ} (K : GrassmannKernel n) :
    Matrix (Major n ⊕ Major n) (Major n ⊕ Major n) ℂ :=
  Matrix.fromBlocks K.A K.B (-K.B.transpose) K.D

/-- PDF p.9: entrywise reality and contraction in PSD matrix order. -/
def RealContraction {I : Type*} [Fintype I] [DecidableEq I]
    (M : Matrix I I ℂ) : Prop :=
  (∀ a b, (M a b).im = 0) ∧ (1 - M.transpose * M).PosSemidef

/-- PDF p.3: empty product fixes the scalar normalization. -/
example : grassProd ([] : List (Grass 0)) = grassOne 0 := rfl

/-- PDF p.3: the full Berezin integral picks the ordered top coefficient. -/
example {d : ℕ} (f : Grass d) : grassIntegrate 0 f ∅ = f Finset.univ := by
  simp [grassIntegrate]

/-- PDF p.3: the empty Pfaffian is one. -/
example : pfaffian (0 : Matrix (Fin 0) (Fin 0) ℂ) = 1 := rfl

/-- PDF p.8: the identity kernel has scalar prefactor one. -/
example (n : ℕ) : (homogeneousKernel (1 : Matrix (Major n) (Major n) ℂ)).C = 1 := rfl

/-- PDF p.2, Eq.(5): the source's V c V-dagger convention. -/
def ImplementsRotation {n : ℕ} (s : CARSystem n) (V : Op (Qubits n))
    (R : Matrix (Major n) (Major n) ℝ) : Prop :=
  ∀ a, V * s.majorana a * Vᴴ = ∑ b, (R a b : ℂ) • s.majorana b

/-- PDF pp.9-10, Eq.(48): first CAR-half embedding, with parity on the second
ordinary tensor factor. This fixes the graded signs on odd operators. -/
def firstEmbedding {n : ℕ} (s : CARSystem n) (X : Op (Qubits n)) :
    Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ :=
  ∑ A : Finset (Major n), majoranaSymbol s X A •
    Matrix.kronecker (basisOp s A) (totalFermionParity s ^ A.card)

/-- PDF p.9: ordered basis of two disjoint CAR halves. -/
def doubleBasis {n : ℕ} (s : CARSystem n) (A B : Finset (Major n)) :
    Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ :=
  Matrix.kronecker (basisOp s A) (totalFermionParity s ^ A.card * basisOp s B)

/-- PDF pp.9-10: expansion coefficient in the full two-half CAR basis. -/
def doubleCoefficient {n : ℕ} (s : CARSystem n)
    (Z : Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ)
    (A B : Finset (Major n)) : ℂ :=
  ((2 : ℂ) ^ (2 * n))⁻¹ * ((doubleBasis s A B)ᴴ * Z).trace

/-- PDF p.9, Definition 5: E tensor_f Id, extended linearly on every monomial.
No equality with the ordinary extension is assumed. -/
def fermionicExtension {n : ℕ} (s : CARSystem n)
    (E : Superop (Qubits n) (Qubits n)) :
    Superop (Qubits n × Qubits n) (Qubits n × Qubits n) := fun Z =>
  ∑ A : Finset (Major n), ∑ B : Finset (Major n),
    doubleCoefficient s Z A B •
      (firstEmbedding s (E (basisOp s A)) * Matrix.kronecker 1 (basisOp s B))

/-- PDF p.10, Definition 6: the fixed pure fermionic maximally entangled density. -/
def dualReference {n : ℕ} (s : CARSystem n) :
    Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ :=
  ((2 : ℂ) ^ (2 * n))⁻¹ •
    (List.ofFn (fun a : Major n =>
      (1 : Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ) +
        Complex.I • (Matrix.kronecker (s.majorana a) (totalFermionParity s) *
          Matrix.kronecker 1 (s.majorana a)))).prod

/-- PDF p.10: the unnormalized dual operator, for the fixed CAR identification. -/
def fermionicDual {n : ℕ} (s : CARSystem n) (E : Superop (Qubits n) (Qubits n)) :
    Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ :=
  fermionicExtension s E (dualReference s)

/-- PDF p.10: theta then eta in a single anticommuting algebra; this is distinct
from the ordinary tensor product of Grassmann algebras in Section V. -/
def doubleSymbol {n : ℕ} (s : CARSystem n)
    (Z : Matrix (Qubits n × Qubits n) (Qubits n × Qubits n) ℂ) :
    Grass (2 * (2 * n)) := fun S =>
  doubleCoefficient s Z
    (Finset.univ.filter (fun a : Major n => ∃ i ∈ S, i.val = a.val))
    (Finset.univ.filter (fun a : Major n => ∃ i ∈ S, i.val = 2 * n + a.val))

/-- PDF pp.10-11: full diagonal map, specified on every ordered monomial. -/
def diagonalMap {n : ℕ} (s : CARSystem n) (b : Major n → ℝ) :
    Superop (Qubits n) (Qubits n) := fun X =>
  ∑ A : Finset (Major n), (majoranaSymbol s X A * ∏ a ∈ A, (b a : ℂ)) • basisOp s A

/-- PDF p.11: one elementary map rescales exactly the monomials containing a. -/
def elementaryMap {n : ℕ} (s : CARSystem n) (a : Major n) (b : ℝ) :
    Superop (Qubits n) (Qubits n) :=
  diagonalMap s (fun c => if c = a then b else 1)

/-- PDF p.11: compose all elementary maps in increasing index order. -/
def elementaryComposition {n : ℕ} (s : CARSystem n) (b : Major n → ℝ) :
    Superop (Qubits n) (Qubits n) :=
  (List.ofFn (fun a : Major n => elementaryMap s a (b a))).foldr
    (fun E F => E ∘ F) id

/-- PDF pp.2,11-12: finite adaptive FLO program. At a measurement the two
continuations may differ. A unitary input supplies its rotation exp(H), so the
classical recurrence below uses only finite Grassmann arithmetic on given data. -/
inductive FLOProgram (n : ℕ) where
  | stop : FLOProgram n
  | unitary (H R : Matrix (Major n) (Major n) ℝ)
      (skew : H.transpose = -H) (rotation : Rotation R)
      (generates : NormedSpace.exp H = R) (next : FLOProgram n) : FLOProgram n
  | measure (j : Fin n) (zero one : FLOProgram n) : FLOProgram n

/-- PDF pp.1,12: a record at every stage and every outcome branch. -/
inductive RunTree (A : Type*) where
  | stop (value : A) : RunTree A
  | unitary (value : A) (next : RunTree A) : RunTree A
  | measure (value : A) (zero one : RunTree A) : RunTree A

/-- Apply a representation to every recorded state, preserving branch labels. -/
def treeMap {A B : Type*} (f : A → B) : RunTree A → RunTree B
  | .stop v => .stop (f v)
  | .unitary v t => .unitary (f v) (treeMap f t)
  | .measure v t u => .measure (f v) (treeMap f t) (treeMap f u)

/-- All records, including intermediate states and impossible branches. -/
def treeValues {A : Type*} : RunTree A → List A
  | .stop v => [v]
  | .unitary v t => v :: treeValues t
  | .measure v t u => v :: (treeValues t ++ treeValues u)

/-- Terminal records, ordered with the empty outcome before the occupied one. -/
def treeLeaves {A : Type*} : RunTree A → List A
  | .stop v => [v]
  | .unitary _ t => treeLeaves t
  | .measure _ t u => treeLeaves t ++ treeLeaves u

/-- PDF pp.2,11-12: exact quantum semantics with unnormalized branch densities.
Their traces are path probabilities, so zero branches require no normalization. -/
def quantumRun {n : ℕ} (s : CARSystem n) : FLOProgram n → Op (Qubits n) → RunTree (Op (Qubits n))
  | .stop, X => .stop X
  | .unitary H _ _ _ _ next, X =>
      .unitary X (quantumRun s next (conjSuperop (canonicalFLO s H) X))
  | .measure j zero one, X => .measure X
      (quantumRun s zero (conjSuperop (modeProjector s j false) X))
      (quantumRun s one (conjSuperop (modeProjector s j true) X))

/-- PDF pp.11-12: fixed finite classical recurrence of Gaussian integrals,
computed from the initial covariance symbol. It never calls quantumRun. -/
def symbolicRun {n : ℕ} : FLOProgram n → Grass (2 * n) → RunTree (Grass (2 * n))
  | .stop, f => .stop f
  | .unitary _ R _ _ _ next, f => .unitary f
      (symbolicRun next (kernelEval (homogeneousKernel (R.transpose.map Complex.ofReal)) f))
  | .measure j zero one, f => .measure f
      (symbolicRun zero (measurementEval j false f))
      (symbolicRun one (measurementEval j true f))

/-- PDF pp.2,4: reconstruct an operator from its ordered CAR coefficients. -/
def operatorFromSymbol {n : ℕ} (s : CARSystem n) (f : Grass (2 * n)) : Op (Qubits n) :=
  ∑ A : Finset (Major n), f A • basisOp s A

/-- PDF p.4: recover the normalized complex covariance from a nonzero scalar
symbol coefficient. Theorems use this only on positive-probability branches. -/
def symbolCorrelation {n : ℕ} (f : Grass (2 * n)) :
    Matrix (Major n) (Major n) ℂ := fun a b =>
  if a = b then 0 else
    (if a < b then -Complex.I else Complex.I) * f {a, b} / f ∅

/-- PDF p.12: path probability recovered from the constant Grassmann coefficient. -/
def symbolWeight {n : ℕ} (f : Grass (2 * n)) : ℝ :=
  ((2 : ℂ) ^ n * f ∅).re

/-- Empty adaptive program records exactly its input. -/
example {n : ℕ} (s : CARSystem n) (X : Op (Qubits n)) :
    quantumRun s .stop X = .stop X := rfl

/-- The symbolic simulation has the same empty-program convention. -/
example {n : ℕ} (f : Grass (2 * n)) : symbolicRun .stop f = .stop f := rfl

/-- Ordinary and fermionic tensor products have separate definitions even at
this elementary ordinary-block sanity check. -/
example {n : ℕ} (X Y : Op (Qubits n)) (p q : Qubits n × Qubits n) :
    Matrix.kronecker X Y p q = X p.1 q.1 * Y p.2 q.2 := rfl

/-- PDF pp.11-12: the subnormalized empty-first-mode output symbol. -/
def firstOutcomeSymbol {n : ℕ} (p : ℂ)
    (L : Matrix (Major n) (Major n) ℂ) : Grass (2 * n) :=
  (p / (2 : ℂ) ^ n) • grassExp
    (Complex.I • grassMul (grassVar (2 * n) 0) (grassVar (2 * n) 1) +
      (Complex.I / 2) • (∑ a : Major n, ∑ b : Major n,
        if 2 ≤ a.val ∧ 2 ≤ b.val then
          L a b • grassMul (grassVar (2 * n) a.val) (grassVar (2 * n) b.val)
        else 0))

end QAlgorithms.Papers.Independent.Intake100.P22


