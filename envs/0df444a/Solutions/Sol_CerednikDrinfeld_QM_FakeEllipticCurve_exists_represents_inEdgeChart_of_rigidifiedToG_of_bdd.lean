theorem spec_hom_ext_of_forall_connected_corner (T : Type) [CommRing T] [IsNoetherianRing T] {Y : Scheme.{0}}
    (f g : Spec (CommRingCat.of T) ⟶ Y)
    (h : ∀ e : T, IsIdempotentElem e → (∀ x : Localization.Away e, IsIdempotentElem x → x = 0 ∨ x = 1) →
      Spec.map (CommRingCat.ofHom (algebraMap T (Localization.Away e))) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap T (Localization.Away e))) ≫ g) :
    f = g := by
  classical
  let ι : Type := {e : T // IsIdempotentElem e ∧ ∀ x : Localization.Away e, IsIdempotentElem x → x = 0 ∨ x = 1}
  let s : ι → (CommRingCat.of T) := fun i => i.1
  have hs : Ideal.span (Set.range s) = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal _ hne
    haveI : 𝔪.IsPrime := h𝔪.isPrime
    obtain ⟨e, he, hem, hconn⟩ :=
      IsNoetherianRing.exists_isIdempotentElem_notMem_and_forall_isIdempotentElem_away_eq_zero_or_eq_one T 𝔪
    exact hem (hle (Ideal.subset_span ⟨⟨e, he, hconn⟩, rfl⟩))
  exact (Scheme.affineOpenCoverOfSpanRangeEqTop s hs).openCover.hom_ext f g (fun i => h i.1 i.2.1 i.2.2)

