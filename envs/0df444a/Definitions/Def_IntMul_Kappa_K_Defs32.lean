  2 * ((((Nat.log (100 ^ 3) D + 1) * 100 ^ 3 : ℕ) : ℝ) * clF Kc K D + 1) +
    1000000 * (((Nat.log (100 ^ 3) D * 71 : ℕ) : ℝ) + 2)

