-- Source module: Solutions.R6ChkBitBase
/-!
# Bit round six (h = 23): support trees and triple tables

* `BT`: a binary tree of numbers; `btGet t d i` follows the low `d` bits of `i` (most significant
  first). Node supports (bitmasks over the 1771 triples of `Fin 23`) are stored 16 per leaf in
  1792-bit fields (`R6BitDataSup*`), read by `fieldOf`.
* `TRIPL`: row `i` (32-bit field) is the bitmask of the `i`-th triple (lexicographic order);
  `STARL`: field `c` (1792 bits) is `star c`, the set of triples containing `c`;
  `UMT0..3`: field `b` of `UMTj` is the set of triples meeting the 6-bit chunk `b` of points
  `6j, …, 6j+5` (so `um P` = triples meeting `P` is four lookups).
* Table facts are proved by one kernel evaluation each (`star_spec`, `umt_spec`).
-/

namespace R6Chk.Bit

open R6Chk

/-- Bit `i` of `x`, by kernel-accelerated operations. -/
def tb (x i : ℕ) : Bool := Nat.beq (Nat.land (Nat.shiftRight x i) 1) 1

/-- Field `i` of width `w`. -/
def fieldOf (X w i : ℕ) : ℕ := Nat.land (Nat.shiftRight X (Nat.mul w i)) (Nat.sub (Nat.shiftLeft 1 w) 1)

def TRIPL : ℕ := 
def STARL : ℕ := 
def UMT0 : ℕ := 
def UMT1 : ℕ := 
def UMT2 : ℕ := 
def UMT3 : ℕ := 

/-- The bitmask (over `Fin 23`) of triple `i`. -/
def tri (i : ℕ) : ℕ := fieldOf TRIPL 32 i

/-- Triples containing point `c`. -/
def star (c : ℕ) : ℕ := fieldOf STARL 1792 c

/-- `∀ i < n, p i`, as a kernel loop. -/
def allN (n : ℕ) (p : ℕ → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun i ih => p i && ih) n

/-- Table check: `UMTj` is built bit by bit: field `0` is empty and field `2^t + r` (`r < 2^t`) is
field `r` together with `star (6j + t)`. -/
def umtOK (U j : ℕ) : Bool :=
  Nat.beq (fieldOf U 1792 0) 0 &&
    allN 6 (fun t => allN (2 ^ t) (fun r =>
      Nat.beq (fieldOf U 1792 (Nat.add (Nat.shiftLeft 1 t) r))
        (Nat.lor (fieldOf U 1792 r) (star (Nat.add (Nat.mul 6 j) t)))))

end R6Chk.Bit

end

section
-- Source module: Solutions.R6ChkBitDag
/-!
# Bit round six (h = 23): DAG well-formedness and output supports (kernel checkers)

For a support function `sg : ℕ → ℕ` (node ↦ bitmask over the 1771 triples; in use
`sg = supG`, a lookup in the support tree):

* `gchunkChk sg x`: every gate record `(k, a, b)` of the chunk has disjoint operand supports
  whose union is the support of `k` (`gchunk_sound`);
* `ochunkChk sg x`: every output record `(c, t₁, t₂, n)` has
  `sg n = star c \ (star t₁ ∪ star t₂)` (triples through `c` meeting `{c,t₁,t₂}` only in `c`);
* `rchunkChk sg x`: every retained record `(c, n)` has `sg n = star c`;
* `leafChk sg`: `sg 0 = 0` and `sg (i+1) = 2^i` (input triple `i`).

These are the data facts behind `JLV = I` over `ZMod 2` (the scalar word) and behind label
nesting (supports grow along every slot chain since `sg a, sg b ⊆ sg k`).
-/

namespace R6Chk.Bit

open R6Chk

/-! ## Gates -/

/-- `cnt` gate records `(k, a, b)` (16-bit fields). -/
def gatesChk (sg : ℕ → ℕ) (cnt : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih s =>
      let k := Nat.land s 65535
      let a := Nat.land (Nat.shiftRight s 16) 65535
      let b := Nat.land (Nat.shiftRight s 32) 65535
      let sa := sg a
      let sb := sg b
      Nat.beq (Nat.land sa sb) 0 && Nat.beq (Nat.lor sa sb) (sg k) && ih (Nat.shiftRight s 48)) cnt

/-- Decoded gate records. -/
def gatesDec (cnt : ℕ) : ℕ → List (ℕ × ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => (Nat.land s 65535, Nat.land (Nat.shiftRight s 16) 65535,
      Nat.land (Nat.shiftRight s 32) 65535) :: ih (Nat.shiftRight s 48)) cnt

def gchunkChk (sg : ℕ → ℕ) (x : ℕ) : Bool := gatesChk sg (Nat.land x 65535) (Nat.shiftRight x 16)
def gchunkDec (x : ℕ) : List (ℕ × ℕ × ℕ) := gatesDec (Nat.land x 65535) (Nat.shiftRight x 16)

/-- A gate is well formed: disjoint operands, union = result. -/
def GateOK (sg : ℕ → ℕ) (g : ℕ × ℕ × ℕ) : Prop :=
  sg g.2.1 &&& sg g.2.2 = 0 ∧ sg g.2.1 ||| sg g.2.2 = sg g.1

/-! ## Outputs and retained totals -/

/-- `star c \ (star t₁ ∪ star t₂)`. -/
def exclT (c t1 t2 : ℕ) : ℕ := Nat.xor (star c) (Nat.land (star c) (Nat.lor (star t1) (star t2)))

def outsChk (sg : ℕ → ℕ) (cnt : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih s =>
      Nat.beq (sg (Nat.land (Nat.shiftRight s 24) 65535))
        (exclT (Nat.land s 255) (Nat.land (Nat.shiftRight s 8) 255) (Nat.land (Nat.shiftRight s 16) 255))
        && ih (Nat.shiftRight s 40)) cnt

def outsDec (cnt : ℕ) : ℕ → List (ℕ × ℕ × ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ × ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => (Nat.land s 255, Nat.land (Nat.shiftRight s 8) 255, Nat.land (Nat.shiftRight s 16) 255,
      Nat.land (Nat.shiftRight s 24) 65535) :: ih (Nat.shiftRight s 40)) cnt

def ochunkChk (sg : ℕ → ℕ) (x : ℕ) : Bool := outsChk sg (Nat.land x 65535) (Nat.shiftRight x 16)
def ochunkDec (x : ℕ) : List (ℕ × ℕ × ℕ × ℕ) := outsDec (Nat.land x 65535) (Nat.shiftRight x 16)

def retsChk (sg : ℕ → ℕ) (cnt : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih s => Nat.beq (sg (Nat.land (Nat.shiftRight s 8) 65535)) (star (Nat.land s 255))
        && ih (Nat.shiftRight s 24)) cnt

def retsDec (cnt : ℕ) : ℕ → List (ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => (Nat.land s 255, Nat.land (Nat.shiftRight s 8) 65535) :: ih (Nat.shiftRight s 24)) cnt

def rchunkChk (sg : ℕ → ℕ) (x : ℕ) : Bool := retsChk sg (Nat.land x 65535) (Nat.shiftRight x 16)
def rchunkDec (x : ℕ) : List (ℕ × ℕ) := retsDec (Nat.land x 65535) (Nat.shiftRight x 16)

/-! ## Leaves -/

def leafChk (sg : ℕ → ℕ) : Bool :=
  Nat.beq (sg 0) 0 && allN 1771 (fun i => Nat.beq (sg (Nat.add i 1)) (Nat.shiftLeft 1 i))

end R6Chk.Bit

end

section
-- Source module: Solutions.R6ChkCx
/-!
# Reflective checker for nested nondegenerate `F₂` label pairs (complex round six)

Data: a list of **groups**. A group is one natural number read as 32-bit fields (LSB first):
`kV, cnt, B (kV rows), H (n-kV), D (kV), E (n-kV)`, then `cnt` entries `kU, U (kU), EU (kU),
R (kV-kU)`. Rows are vectors of `F₂^n` (`n ≤ 24`).

* `grpChk n bad G : Bool` — two packed products for the label `V = span B`
  (`H·[B;E]ᵀ = [0 | I]`, `D·[H;B]ᵀ = [0 | I]`) and two per entry
  (`U·[H;EU]ᵀ = [0 | I]`, `R·[H;U;R]ᵀ = [0 | 0 | I]`), plus row range checks.
* `grpChk_sound`: if `grpChk n (BADf n) G = true` then `V` is nondegenerate of dimension `kV`,
  and for every entry `(U, kU)`, `PairOK n U kU V kV`: `span U ≤ span V`, `dim span U = kU`,
  `span U` nondegenerate, and `span U = span V` or some `w ∈ span V` has `w·w = 1`, `w ⊥ U`
  (i.e. `NetComplexP8.Up (span U) (span V)` with `Fd = kV - kU`; see `R6ChkCxBridge`).
-/

namespace R6Chk

open Matrix Module

/-! ## Stream decoding -/

/-- The low 32-bit field. -/
def f32 (s : ℕ) : ℕ := Nat.land s 4294967295
/-- Drop one field. -/
def nx (s : ℕ) : ℕ := Nat.shiftRight s 32
/-- The low `k` fields. -/
def tk (s k : ℕ) : ℕ := Nat.land s (Nat.sub (Nat.shiftLeft 1 (Nat.mul 32 k)) 1)
/-- Drop `k` fields. -/
def dr (s k : ℕ) : ℕ := Nat.shiftRight s (Nat.mul 32 k)
/-- Concatenate `X` (`a` rows) and `Y`. -/
def cat (X a Y : ℕ) : ℕ := Nat.add X (Nat.shiftLeft Y (Nat.mul 32 a))
/-- All rows below `2^n` (with `bad = BADf n`). -/
def okR (bad X : ℕ) : Bool := Nat.beq (Nat.land X bad) 0

/-! ## The checker -/

/-- One entry: `U·[H;EU]ᵀ = [0|I]` and `R·[H;U;R]ᵀ = [0|0|I]`. -/
def entChk (bad kV nH H s : ℕ) : Bool :=
  let kU := f32 s
  let s1 := nx s
  let U := tk s1 kU
  let s2 := dr s1 kU
  let EU := tk s2 kU
  let s3 := dr s2 kU
  let kR := Nat.sub kV kU
  let R := tk s3 kR
  Nat.ble kU kV && okR bad U && okR bad EU && okR bad R &&
    Nat.beq (dotsF U (cat H nH EU)) (tgtF nH kU) &&
    Nat.beq (dotsF R (cat (cat H nH U) (Nat.add nH kU) R)) (tgtF (Nat.add nH kU) kR)

/-- Skip one entry. -/
def entNext (kV s : ℕ) : ℕ := dr (nx s) (Nat.add (f32 s) kV)

/-- `cnt` entries. -/
def entsChk (bad kV nH H : ℕ) (cnt : ℕ) : ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun _ ih s => entChk bad kV nH H s && ih (entNext kV s)) cnt

/-- A group, after decoding. -/
def grpBody (n bad kV cnt B H D E s5 : ℕ) : Bool :=
  let nH := Nat.sub n kV
  Nat.ble kV n && okR bad B && okR bad H && okR bad D && okR bad E &&
    Nat.beq (dotsF H (cat B kV E)) (tgtF kV nH) &&
    Nat.beq (dotsF D (cat H nH B)) (tgtF nH kV) &&
    entsChk bad kV nH H cnt s5

/-- A group. -/
def grpChk (n bad G : ℕ) : Bool :=
  let kV := f32 G
  let s0 := nx G
  let cnt := f32 s0
  let s1 := nx s0
  let nH := Nat.sub n kV
  let B := tk s1 kV
  let s2 := dr s1 kV
  let H := tk s2 nH
  let s3 := dr s2 nH
  let D := tk s3 kV
  let s4 := dr s3 kV
  let E := tk s4 nH
  let s5 := dr s4 nH
  grpBody n bad kV cnt B H D E s5

/-- `List.all`, as a plain `List.rec` (cheap kernel unfolding). -/
def allL {α : Type} (p : α → Bool) (l : List α) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun a _ ih => p a && ih) l

/-! ## Semantics -/

/-- Span of the first `k` rows of `X` in `F₂^n`. -/
def spanP (n X k : ℕ) : Submodule (ZMod 2) (Fin n → ZMod 2) := spanF (fun i : Fin k => vr n X i)

/-- What an edge `U → V` needs (`NetComplexP8.Up`, with dimensions). -/
def PairOK (n U kU V kV : ℕ) : Prop :=
  spanP n U kU ≤ spanP n V kV ∧ finrank (ZMod 2) (spanP n U kU) = kU ∧
    finrank (ZMod 2) (spanP n V kV) = kV ∧ NondegF (spanP n U kU) ∧ NondegF (spanP n V kV) ∧
    (spanP n U kU = spanP n V kV ∨
      ∃ w ∈ spanP n V kV, w ⬝ᵥ w = 1 ∧ ∀ z ∈ spanP n U kU, z ⬝ᵥ w = 0)

/-- The label of a group: `(B, kV)`. -/
def grpV (n G : ℕ) : ℕ × ℕ := (tk (nx (nx G)) (f32 G), f32 G)

/-- The entries `(U, kU)` of a stream. -/
def entsDec (kV : ℕ) (cnt : ℕ) : ℕ → List (ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => (tk (nx s) (f32 s), f32 s) :: ih (entNext kV s)) cnt

/-- The entries of a group. -/
def grpEnts (n G : ℕ) : List (ℕ × ℕ) :=
  entsDec (f32 G) (f32 (nx G))
    (dr (dr (dr (dr (nx (nx G)) (f32 G)) (Nat.sub n (f32 G))) (f32 G)) (Nat.sub n (f32 G)))

/-! ## Soundness -/

end R6Chk

end


