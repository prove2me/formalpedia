  set Y : ℝ := (w : ℝ) * (D : ℝ) ^ (0.44274 : ℝ) * Real.log D
  have hDγ : 0 < (D : ℝ) ^ (0.07618 : ℝ) := Real.rpow_pos_of_pos (by linarith) _
  have hDq : 0 ≤ (D : ℝ) ^ (0.44274 : ℝ) := (Real.rpow_pos_of_pos (by linarith) _).le
  have hX0 : 0 ≤ X := by positivity
  have hY0 : 0 ≤ Y := by positivity
