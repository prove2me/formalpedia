open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

theorem differentiableAt_joint {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {p : ℝ × Pt n} (hp : p ∈ W) : DifferentiableAt ℝ φ p :=
  (hφ.contDiffAt (hW.mem_nhds hp)).differentiableAt (by simp)

/-- Coordinate slice of a jointly differentiable map. -/
theorem hasDerivAt_slice_joint {φ : ℝ × Pt n → ℝ} {p : ℝ × Pt n} (hd : DifferentiableAt ℝ φ p)
    (i : Fin n) :
    HasDerivAt (fun u : ℝ => φ (p.1, Function.update p.2 i u))
      (fderiv ℝ φ p ((0 : ℝ), (Pi.single i 1 : Pt n))) (p.2 i) := by
  have h1 : HasDerivAt (fun u : ℝ => (p.1, Function.update p.2 i u))
      ((0 : ℝ), (Pi.single i 1 : Pt n)) (p.2 i) :=
    (hasDerivAt_const _ p.1).prodMk (hasDerivAt_update p.2 i (p.2 i))
  have h2 : HasFDerivAt φ (fderiv ℝ φ p) (p.1, Function.update p.2 i (p.2 i)) := by
    rw [Function.update_eq_self]; exact hd.hasFDerivAt
  exact h2.comp_hasDerivAt (p.2 i) h1

/-- Parameter slice of a jointly differentiable map. -/
theorem hasDerivAt_param_joint {φ : ℝ × Pt n → ℝ} {p : ℝ × Pt n} (hd : DifferentiableAt ℝ φ p) :
    HasDerivAt (fun ε : ℝ => φ (ε, p.2)) (fderiv ℝ φ p ((1 : ℝ), (0 : Pt n))) p.1 := by
  have h1 : HasDerivAt (fun ε : ℝ => (ε, p.2)) ((1 : ℝ), (0 : Pt n)) p.1 :=
    (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
  have h2 : HasFDerivAt φ (fderiv ℝ φ p) (p.1, p.2) := hd.hasFDerivAt
  exact h2.comp_hasDerivAt p.1 h1

/-- On `W`, `pd i (φ(ε, ·)) y = Dφ(ε, y)(0, eᵢ)`. -/
theorem pd_eq_fderiv_joint {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {ε : ℝ} {y : Pt n} (hy : (ε, y) ∈ W) (i : Fin n) :
    pd i (fun z => φ (ε, z)) y = fderiv ℝ φ (ε, y) ((0 : ℝ), (Pi.single i 1 : Pt n)) :=
  pd_eq_of_hasDerivAt (hasDerivAt_slice_joint (p := (ε, y)) (differentiableAt_joint hW hφ hy) i)

/-- The open parameter slice `{y | (ε₀, y) ∈ W}`. -/
theorem isOpen_slice {W : Set (ℝ × Pt n)} (hW : IsOpen W) (ε₀ : ℝ) :
    IsOpen {y : Pt n | (ε₀, y) ∈ W} :=
  hW.preimage (continuous_const.prodMk continuous_id)

