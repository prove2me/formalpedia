-- title:
--   The Weibull generating function (10) and its inverse (11)
-- statement:
--   For parameters $k>0$ and $\theta>\max\{k,1\}$, the Weibull divergences are generated by
--   $$
--   H(y)=\begin{cases}\frac k\theta\big((y+1)^{\theta/k}-1\big)&y\ge0\\ y&y<0,\end{cases}\tag{10}
--   $$
--   and the inverse is
--   $$
--   H^{-1}(x)=\begin{cases}\big(\frac\theta kx+1\big)^{k/\theta}-1&x\ge0\\ x&x<0.\end{cases}\tag{11}
--   $$
--
--   These are the new divergences of §3.1, tailored so that $H(\varphi(x))$ grows like $x^\theta$.
--
--   **Formalization Note** The parameter conditions are hypotheses of the theorems. Real powers are taken only of numbers $\ge1$.
-- source:
--   Kruse, Schneider & Schweizer, SSRN 3680475 (Aug 25, 2020), displays (10), (11), §3.1, p.12

import Mathlib

namespace FDivToolkit

open Classical in
/-- The Weibull generating function of display (10), Kruse, Schneider & Schweizer, SSRN 3680475
(Aug 25, 2020), §3.1, p.12:
`H(y) = (k/θ)((y + 1)^{θ/k} − 1)` for `y ≥ 0` and `H(y) = y` for `y < 0`.

**Formalization Note.** `Real.rpow` is applied only to `y + 1 ≥ 1`. The paper's parameters are
`k > 0` and `θ > max{k, 1}`; they are hypotheses wherever `weibullH` is used. -/
noncomputable def weibullH (k θ y : ℝ) : ℝ :=
  if 0 ≤ y then k / θ * ((y + 1) ^ (θ / k) - 1) else y

open Classical in
/-- The inverse of the Weibull generating function, display (11), Kruse, Schneider & Schweizer,
SSRN 3680475 (Aug 25, 2020), §3.1, p.12:
`H⁻¹(x) = ((θ/k)x + 1)^{k/θ} − 1` for `x ≥ 0` and `H⁻¹(x) = x` for `x < 0`. -/
noncomputable def weibullHinv (k θ x : ℝ) : ℝ :=
  if 0 ≤ x then (θ / k * x + 1) ^ (k / θ) - 1 else x

end FDivToolkit


