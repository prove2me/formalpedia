/-! ### Linearity of the weights -/

variable [IsTotallyComplex F]

/-! ### Linearity of the classes, of the resolvent part and of `θ` -/

/-! ### Functionals -/

/-! ### A bound for the cut-off part on compact sets -/

/-- `h_s` is bounded on `{‖s‖ ≤ M} × K`, `K` compact (so integrals of `h_s` against compactly
supported densities are entire in `s`, and `(s − s₀) ∫ h_s φ → 0`). -/
theorem exists_norm_hpart_le_oai (h𝔪 : 𝔪 ≠ ⊥) (Ψ : TSection ι 𝔪) (M : ℝ) {K : Set (X F)}
    (hK : IsCompact K) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ s : ℂ, ‖s‖ ≤ M → ∀ Q ∈ K, ‖hpart Ψ s Q‖ ≤ C := by
  obtain ⟨Bd, hB0, hB⟩ := exists_wt_bound h𝔪 Ψ M
  obtain ⟨u, hu, hle⟩ := PairClass.exists_summable_majorant (RO.SOf 𝔪) hK
    (σ₁ := 3) (σ₂ := 3) (by norm_num) le_rfl
  set H : ℝ := max 1 (∑' p, u p) with hHdef
  have hH1 : (1 : ℝ) ≤ H := le_max_left _ _
  have hH : ∀ Q ∈ K, ∀ p : PairClass (RO.SOf 𝔪), p.ht Q ≤ H := by
    intro Q hQ p
    by_cases h1 : p.ht Q ≤ 1
    · exact h1.trans hH1
    · push Not at h1
      have h3 : p.ht Q ≤ p.ht Q ^ (3 : ℝ) := by
        have := Real.rpow_le_rpow_of_exponent_le h1.le (show (1 : ℝ) ≤ 3 by norm_num)
        simpa using this
      have hnn : ∀ p' : PairClass (RO.SOf 𝔪), 0 ≤ u p' := fun p' =>
        (Real.rpow_nonneg (p'.ht_pos Q).le _).trans (hle Q hQ 3 ⟨le_rfl, le_rfl⟩ p')
      exact (h3.trans (hle Q hQ 3 ⟨le_rfl, le_rfl⟩ p)).trans
        ((hu.le_tsum p fun j _ => hnn j).trans (le_max_right _ _))
  refine ⟨Bd * H ^ |M|, by positivity, fun s hs Q hQ => ?_⟩
  obtain ⟨p₁, h⟩ := pe_single (RO.SOf 𝔪) Q
  have hp := p₁.ht_pos Q
  rw [hpart_eq_pe h𝔪, h _ _ (vanishLow_gS s), norm_mul, gS_log s hp, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (rho_nonneg _),
    Complex.norm_cpow_eq_rpow_re_of_pos hp]
  refine mul_le_mul (hB s hs p₁) ?_
    (mul_nonneg (rho_nonneg _) (Real.rpow_nonneg hp.le _)) hB0
  by_cases h2 : p₁.ht Q ≤ 2
  · rw [rho_zero h2, zero_mul]
    positivity
  · push Not at h2
    have h1 : 1 ≤ p₁.ht Q := by linarith
    have hre : s.re ≤ |M| :=
      (le_abs_self _).trans ((Complex.abs_re_le_norm s).trans (hs.trans (le_abs_self M)))
    calc rho (p₁.ht Q) * p₁.ht Q ^ s.re ≤ 1 * p₁.ht Q ^ s.re :=
          mul_le_mul_of_nonneg_right (rho_le_one _) (Real.rpow_nonneg hp.le _)
      _ = p₁.ht Q ^ s.re := one_mul _
      _ ≤ p₁.ht Q ^ |M| := Real.rpow_le_rpow_of_exponent_le h1 hre
      _ ≤ H ^ |M| := Real.rpow_le_rpow hp.le (hH Q hQ p₁) (abs_nonneg M)

end

end ArtinKP.C5
