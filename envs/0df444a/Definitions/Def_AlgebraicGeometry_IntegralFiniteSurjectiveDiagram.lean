section Algebra

variable (R A : Type u) [CommRing R] [CommRing A] [Algebra R A]

private abbrev stage (s : Finset A) := Algebra.adjoin R (s : Set A)

/-- The rings generated by finite subsets of an algebra form a directed
diagram with inclusion as transition maps. -/
def finiteSubalgebraDiagram : Finset A ⥤ CommRingCat.{u} where
  obj s := CommRingCat.of (stage R A s)
  map h := CommRingCat.ofHom (Subalgebra.inclusion
    (Algebra.adjoin_mono (Finset.coe_subset.mpr (leOfHom h)))).toRingHom
  map_id s := by ext x; rfl
  map_comp f g := by ext x; rfl

def finiteSubalgebraCocone : Cocone (finiteSubalgebraDiagram R A) where
  pt := CommRingCat.of A
  ι.app s := CommRingCat.ofHom (stage R A s).val.toRingHom
  ι.naturality _ _ f := by ext x; rfl

def structureMaps : (Functor.const (Finset A)).obj (CommRingCat.of R) ⟶
    finiteSubalgebraDiagram R A where
  app s := CommRingCat.ofHom (algebraMap R (stage R A s))
  naturality _ _ f := by ext x; rfl

def finiteSubalgebraIsColimit : IsColimit (finiteSubalgebraCocone R A) := by
  classical
  let F := finiteSubalgebraDiagram R A
  let forgetRing := forget CommRingCat.{u}
  have : ReflectsColimit F forgetRing := reflectsColimit_of_reflectsIsomorphisms F forgetRing
  apply isColimitOfReflects forgetRing
  apply Types.FilteredColimit.isColimitOf
  · intro a
    let s : Finset A := {a}
    refine ⟨s, ⟨a, Algebra.subset_adjoin ?_⟩, rfl⟩
    simp [s]
  · intro s t a b h
    let v := s ∪ t
    have hs : s ≤ v := Finset.subset_union_left
    have ht : t ≤ v := Finset.subset_union_right
    refine ⟨v, homOfLE hs, homOfLE ht, ?_⟩
    exact Subtype.ext h

end Algebra

/-- Every finitely generated subalgebra of an integral algebra gives a
finite surjective stage when the full morphism on spectra is surjective. -/
theorem finite_surjective_of_fg_subalgebra
    {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] [Algebra.IsIntegral R A]
    (hs : Surjective (Spec.map (CommRingCat.ofHom (algebraMap R A))))
    (C : Subalgebra R A) (hFG : C.FG) :
    IsFinite (Spec.map (CommRingCat.ofHom (algebraMap R C))) ∧
      Surjective (Spec.map (CommRingCat.ofHom (algebraMap R C))) := by
  let q := Spec.map (CommRingCat.ofHom (algebraMap R C))
  have : Algebra.IsIntegral R C := Algebra.IsIntegral.of_injective C.val Subtype.val_injective
  have : Algebra.FiniteType R C := C.fg_iff_finiteType.mp hFG
  have : Module.Finite R C := Algebra.IsIntegral.finite
  have hFin : IsFinite q := (IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap R C))).mpr
    (RingHom.finite_algebraMap.mpr inferInstance)
  let r := Spec.map (CommRingCat.ofHom C.val.toRingHom)
  have hr : r ≫ q = Spec.map (CommRingCat.ofHom (algebraMap R A)) := by
    change Spec.map (CommRingCat.ofHom C.val.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap R C)) = _
    rw [← Spec.map_comp]
    congr 1
  have hSurj : Surjective q := by
    constructor
    intro y
    obtain ⟨x, hx⟩ := hs.surj y
    exact ⟨r x, (congrArg (fun m : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of R) => m x) hr).trans hx⟩
  exact ⟨hFin, hSurj⟩

end PhilipponEtaleRefinementAffine

end

