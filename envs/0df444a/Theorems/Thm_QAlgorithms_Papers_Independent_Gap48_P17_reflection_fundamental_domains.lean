-- title:
--   Introduction: reflection fundamental domains
-- statement:
--   Put $G=\{(n,s)\in\mathbb Z^2:n+s\text{ is even}\}=\{(p+q,p-q):p,q\in\mathbb Z\}$. Let $\Gamma$ be generated by $n\mapsto-4-n$, $n\mapsto4-n$, $s\mapsto-2-s$, and $s\mapsto6-s$, and enlarge it by $n\mapsto-n$ to obtain $\widetilde\Gamma$. With the source's closed boundary convention,
--   $$F=\{(n,s)\in G:-2\le n\le2,\ -2\le s-1\le2\}$$
--   has twelve points and contains exactly one representative of each $\Gamma$-orbit. The enlarged group has the seven representatives
--   $$\widetilde F=\{(0,0),(0,2),(1,-1),(1,1),(1,3),(2,0),(2,2)\}.$$
--   Equivalently, in nonnegative signature coordinates a domain is
--   $$\widetilde D=\{(2,0),(1,1),(3,0),(2,1),(1,2),(3,1),(2,2)\}.$$
--   Each seven-point set contains exactly one representative of every enlarged orbit, using $(p,q)\mapsto(p+q,p-q)$ for the latter. These coordinates describe lattice orbits and do not assert negative-dimensional spaces.
-- source:
--   Classification of $N$-(super)-extended Poincaré algebras and bilinear invariants of the spinor representation of $Spin(p,q)$, arXiv:math/9511215v1, PDF p. 4, Introduction: reflection fundamental domains

import Definitions.Def_QAlgorithms_Papers_Independent_Gap48_P17

namespace QAlgorithms.Papers.Independent.Gap48.P17

open scoped BigOperators Matrix.Norms.Elementwise

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Introduction, PDF pp. 4--5: both reflection domains and the seven nonnegative
signature representatives. Closed boundary conventions match the source. -/
theorem reflection_fundamental_domains :
    (∀ z : ℤ × ℤ,
      (∃ p q : ℤ, z = (p + q, p - q)) ↔ Even (z.1 + z.2)) ∧
    (∀ z : ℤ × ℤ, z ∈ reflectionDomain ↔
      -2 ≤ z.1 ∧ z.1 ≤ 2 ∧ -2 ≤ z.2 - 1 ∧ z.2 - 1 ≤ 2 ∧ Even (z.1 + z.2)) ∧
    reflectionDomain.card = 12 ∧ enlargedDomain.card = 7 ∧ signatureDomain.card = 7 ∧
    (∀ z : ℤ × ℤ, Even (z.1 + z.2) →
      ∃! w : ℤ × ℤ, w ∈ reflectionDomain ∧ gammaOrbit z w) ∧
    (∀ z : ℤ × ℤ, Even (z.1 + z.2) →
      ∃! w : ℤ × ℤ, w ∈ enlargedDomain ∧ gammaTildeOrbit z w) ∧
    (∀ z : ℤ × ℤ, Even (z.1 + z.2) →
      ∃! w : ℤ × ℤ, w ∈ signatureDomain ∧ 0 ≤ w.1 ∧ 0 ≤ w.2 ∧
        gammaTildeOrbit z (w.1 + w.2, w.1 - w.2)) := by sorry

end QAlgorithms.Papers.Independent.Gap48.P17
