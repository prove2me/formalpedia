-- Source module: Solutions.KFY17Par
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.OpenAI.Glue NLogN.GL NLogN.AX NLogN.Rsp

noncomputable section

theorem lq_spec (n : ℕ) : 4 * pP n + 35 < 2 ^ lqN n := Nat.lt_pow_succ_log_self (by norm_num) _

theorem zN {x k : ℕ} (h : x < 2 ^ k) : zsz (x : ℤ) ≤ k := zsz_le_of_lt (by simpa using h)

theorem p2le {a b : ℕ} (h : a ≤ b) : 2 ^ a ≤ 2 ^ b := Nat.pow_le_pow_right (by norm_num) h

theorem lt_mul2 {x y a b : ℕ} (hx : x < 2 ^ a) (hy : y < 2 ^ b) : x * y < 2 ^ (a + b) := by
  rw [pow_add]
  calc x * y ≤ x * 2 ^ b := Nat.mul_le_mul_left _ hy.le
    _ < 2 ^ a * 2 ^ b := Nat.mul_lt_mul_of_pos_right hx (by positivity)

theorem pw1 (a : ℕ) : 2 ^ (a + 1) = 2 * 2 ^ a := by rw [pow_succ]; ring

theorem pw2 (a : ℕ) : 2 ^ (a + 2) = 4 * 2 ^ a := by rw [pow_add]; ring

theorem le_mul2 {x y a b : ℕ} (hx : x ≤ 2 ^ a) (hy : y ≤ 2 ^ b) : x * y ≤ 2 ^ (a + b) := by
  rw [pow_add]; exact Nat.mul_le_mul hx hy

theorem tN_le_r {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) : tN n k ≤ 2 ^ ℓP n := by
  unfold tN; exact p2le (by have := bN_le n k; have := ell_ge2 hn; omega)

theorem tN_ge2 {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) : 2 ≤ tN n k := by
  unfold tN
  have : 2 ^ 1 ≤ 2 ^ (ℓP n - 1 + bN n k) := p2le (by have := ell_ge2 hn; omega)
  simpa using this

theorem mN_mul {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) : NLogN.KFY.mN n k * tN n k = 2 ^ IntMul.OpenAI.Glue.LP n := by
  have hx : ℓP n - 1 + bN n k ≤ IntMul.OpenAI.Glue.LP n := by
    have := bN_le n k; have := ell_ge2 hn
    have hl := (KFM.setup_facts hn).2.2.2.2.2.2.1
    omega
  unfold NLogN.KFY.mN tN
  rw [← pow_add, Nat.sub_add_cancel hx]

theorem axF {n : ℕ} (h : NF n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) : AxF n k := by
  obtain ⟨hs2, hodd, hw⟩ := h.win k hk
  have hd2 := h.d2
  set s := KFM.srcN n k with hsd
  set t := tN n k with htd
  have ht2 := tN_ge2 h.hn k
  have hst : s < t := by
    by_contra hc; push Not at hc
    have : 4 * IntMul.OpenAI.Glue.dP n * t ≤ (4 * IntMul.OpenAI.Glue.dP n - 1) * t := le_trans (Nat.mul_le_mul_left _ hc) hw
    have h4 : (4 * IntMul.OpenAI.Glue.dP n - 1) * t < 4 * IntMul.OpenAI.Glue.dP n * t := Nat.mul_lt_mul_of_pos_right (by omega) (by omega)
    omega
  have hsw : s ≤ 4 * IntMul.OpenAI.Glue.dP n * (t - s) := by
    have e : 4 * IntMul.OpenAI.Glue.dP n * (t - s) = 4 * IntMul.OpenAI.Glue.dP n * t - 4 * IntMul.OpenAI.Glue.dP n * s := Nat.mul_sub _ _ _
    have e2 : (4 * IntMul.OpenAI.Glue.dP n - 1) * t = 4 * IntMul.OpenAI.Glue.dP n * t - t := by rw [Nat.sub_mul, one_mul]
    have : t ≤ 4 * IntMul.OpenAI.Glue.dP n * t := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hα2 := h.α2
  have hD : 0 < αP n ^ 2 * (t - s) := Nat.mul_pos (by positivity) (by omega)
  refine ⟨by omega, hst, ?_, hsw, tN_le_r h.hn k, ht2, ?_⟩
  · unfold tN
    exact Nat.Coprime.pow_right _ (Nat.coprime_two_right.2 hodd)
  · unfold HvdH.jIter JbN
    try rw [← hsd]
    try rw [← htd]
    set D := αP n ^ 2 * (t - s) with hDd
    have h1 : (pP n * s + D - 1) / D ≤ pP n * s / D + 1 := by
      exact le_trans (Nat.div_le_div_right (by omega : pP n * s + D - 1 ≤ pP n * s + D))
        (le_of_eq (Nat.add_div_right _ hD))
    have h2 : pP n * s / D ≤ 4 * IntMul.OpenAI.Glue.dP n * pP n / αP n ^ 2 := by
      have hle : pP n * s ≤ 4 * IntMul.OpenAI.Glue.dP n * pP n * (t - s) := by
        calc pP n * s ≤ pP n * (4 * IntMul.OpenAI.Glue.dP n * (t - s)) := Nat.mul_le_mul_left _ hsw
          _ = 4 * IntMul.OpenAI.Glue.dP n * pP n * (t - s) := by ring
      calc pP n * s / D ≤ 4 * IntMul.OpenAI.Glue.dP n * pP n * (t - s) / D := Nat.div_le_div_right hle
        _ = 4 * IntMul.OpenAI.Glue.dP n * pP n / αP n ^ 2 := by
          rw [hDd, Nat.mul_div_mul_right _ _ (by omega : 0 < t - s)]
    omega

theorem αle {n : ℕ} (h : NF n) : αP n ≤ pP n := by
  have := h.αp; have := h.α2; nlinarith

theorem wB2 {n : ℕ} (h : NF n) : 2 * HvdH.sWidth (pP n) (αP n) + 2 ≤ 2 ^ (2 * lqN n) := by
  have hW := KFQ.sWidth_le (pP n) (αP n) (αle h)
  have hq := lq_spec n
  have : (4 * pP n + 35) * (4 * pP n + 35) < 2 ^ lqN n * 2 ^ lqN n :=
    Nat.mul_lt_mul'' hq hq
  rw [← pow_add, show lqN n + lqN n = 2 * lqN n by ring] at this
  nlinarith

theorem eB2 {n : ℕ} (h : NF n) : 2 * HvdH.eWidth (pP n) (αP n) + 2 ≤ 2 ^ lqN n := by
  have hE := KFQ.eWidth_le (pP n) (αP n) (αle h)
  have hq := lq_spec n
  omega

theorem pq {n : ℕ} : pP n < 2 ^ lqN n := by have := lq_spec n; omega

theorem hWN (n : ℕ) : (4 * pP n + 35) * 2 ^ (2 * pP n) < 2 ^ mmN n :=
  calc (4 * pP n + 35) * 2 ^ (2 * pP n) < 2 ^ lqN n * 2 ^ (2 * pP n) :=
        Nat.mul_lt_mul_of_pos_right (lq_spec n) (by positivity)
    _ = 2 ^ (lqN n + 2 * pP n) := by rw [pow_add]
    _ ≤ 2 ^ mmN n := p2le (by unfold mmN; omega)

theorem sapHypN {n : ℕ} (h : NF n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) :
    SapHyp (pP n) (KFM.srcN n k) (tN n k) (αP n) (pP n + 2) (BoN n) (mmN n) (BaccN n) (QN n) := by
  have F := NLogN.KFY.axF h k hk
  have hW := wB2 h
  have hq := lq_spec n
  have hr := F.tr
  set W := HvdH.sWidth (pP n) (αP n)
  refine ⟨F.s0, F.st.le, by unfold mmN; omega, ?_, ?_, by unfold BaccN; omega, ?_,
    by unfold BaccN; omega, ?_, ?_, ?_, by unfold QN; omega, ?_⟩
  · exact hWN n
  · calc (2 * W + 2) * 2 ^ (2 * mmN n) ≤ 2 ^ (2 * lqN n + 2 * mmN n) := le_mul2 hW le_rfl
      _ ≤ 2 ^ BaccN n := p2le (by unfold BaccN; omega)
  · apply NLogN.KFY.zN
    calc KFM.srcN n k + (2 * W + 1) < 2 ^ ℓP n + 2 ^ (2 * lqN n) := by have := F.st; omega
      _ ≤ 2 ^ (ℓP n + 2 * lqN n) + 2 ^ (ℓP n + 2 * lqN n) :=
          Nat.add_le_add (p2le (by omega)) (p2le (by omega))
      _ = 2 ^ (ℓP n + 2 * lqN n + 1) := by rw [pow_succ]; ring
      _ ≤ 2 ^ BaccN n := p2le (by unfold BaccN; omega)
  · apply NLogN.KFY.zN
    calc tN n k * (2 * W + 1) < 2 ^ (ℓP n + 1 + 2 * lqN n) :=
          lt_mul2 (lt_of_le_of_lt hr (Nat.pow_lt_pow_right (by norm_num) (by omega))) (by omega)
      _ ≤ 2 ^ BaccN n := p2le (by unfold BaccN; omega)
  · apply NLogN.KFY.zN
    exact lt_of_le_of_lt hr (Nat.pow_lt_pow_right (by norm_num) (by unfold BaccN; omega))
  · unfold BD.cS1
    calc (2 * W + 1) * (4 * pP n + 35) * 2 ^ (pP n + 2) ≤
        2 ^ (2 * lqN n + lqN n + (pP n + 2)) := le_mul2 (le_mul2 (by omega) hq.le) le_rfl
      _ ≤ 2 ^ BoN n := p2le (by unfold BoN; omega)
  · apply NLogN.KFY.zN
    calc 2 * tN n k ≤ 2 * 2 ^ ℓP n := by omega
      _ < 2 ^ (ℓP n + 2) := by rw [pw2]; have := Nat.one_le_two_pow (n := ℓP n); omega
      _ ≤ 2 ^ QN n := p2le (by unfold QN; omega)

theorem tabHypN {n : ℕ} (h : NF n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) :
    TabHyp (pP n) (KFM.srcN n k) (tN n k) (αP n) (BqN n) := by
  have F := NLogN.KFY.axF h k hk
  have hW := wB2 h
  have hq := lq_spec n
  have hr := F.tr
  set W := HvdH.sWidth (pP n) (αP n)
  refine ⟨?_, ?_, ?_⟩
  · have hX : KFM.srcN n k + tN n k + 2 * W + 2 ≤ 2 ^ (ℓP n + 2 * lqN n + 2) := by
      have h1 : 2 ^ ℓP n ≤ 2 ^ (ℓP n + 2 * lqN n) := p2le (by omega)
      have h2 : 2 ^ (2 * lqN n) ≤ 2 ^ (ℓP n + 2 * lqN n) := p2le (by omega)
      have h3 := pw2 (ℓP n + 2 * lqN n)
      have := F.st
      omega
    have h4 : (KFM.srcN n k + tN n k + 2 * W + 2) ^ 4 ≤ 2 ^ (4 * (ℓP n + 2 * lqN n + 2)) := by
      rw [pow_mul']; exact Nat.pow_le_pow_left hX 4
    calc 4 * (KFM.srcN n k + tN n k + 2 * W + 2) ^ 4 ≤ 4 * 2 ^ (4 * (ℓP n + 2 * lqN n + 2)) :=
          Nat.mul_le_mul_left _ h4
      _ = 2 ^ (4 * (ℓP n + 2 * lqN n + 2) + 2) := (pw2 _).symm
      _ < 2 ^ BqN n := Nat.pow_lt_pow_right (by norm_num) (by unfold BqN; omega)
  · calc (4 * pP n + 35) * 2 ^ (2 * pP n) < 2 ^ lqN n * 2 ^ (2 * pP n) :=
          Nat.mul_lt_mul_of_pos_right hq (by positivity)
      _ = 2 ^ (lqN n + 2 * pP n) := by rw [pow_add]
      _ ≤ 2 ^ BqN n := p2le (by unfold BqN; omega)
  · have ha : αP n ^ 2 < 2 ^ lqN n := lt_of_le_of_lt h.αp pq
    have ht : tN n k ^ 2 ≤ 2 ^ (2 * ℓP n) := by rw [pow_mul']; exact Nat.pow_le_pow_left hr 2
