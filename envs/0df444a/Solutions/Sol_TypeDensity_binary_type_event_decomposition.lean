theorem solution (O : Type) [CommRing O] [IsDomain O] (σ : TypeDensity.FactorType) :
    (∀ n : ℕ, TypeDensity.binaryTypeEvent O n σ ∩ {a | a (Fin.last n) ≠ 0} = TypeDensity.affineTypeEvent O n σ ∩
      {a | primitive O a}) ∧ (TypeDensity.binaryTypeEvent O 0 σ ∩ {a | a (Fin.last 0) = 0} = ∅) ∧ ∀ m : ℕ,
      TypeDensity.binaryTypeEvent O (m+1) σ ∩ {a | a (Fin.last (m+1)) = 0} = {a | a (Fin.last (m+1)) = 0} ∩
      Fin.init ⁻¹' (if (1,1) ∈ σ then TypeDensity.affineTypeEvent O m (σ.erase (1,1)) ∩ {b | primitive O b}
      else ∅) := by
  refine ⟨?_, ?_, ?_⟩
  · intro n; ext a
    simp only [TypeDensity.binaryTypeEvent, TypeDensity.affineTypeEvent, TypeDensity.HasBinaryTypeF, Set.mem_inter_iff,
        Set.mem_ofPred_eq]
    constructor
    · rintro ⟨⟨hp, -, -, -, τ, hτ, hσ⟩, ha⟩
      obtain ⟨hd, hl⟩ := TypeDensity.affinePolynomial_natDegree_eq O a ha
      rw [hd, Nat.sub_self, Multiset.replicate_zero, add_zero] at hσ
      subst hσ; rw [hl] at hτ; exact ⟨⟨ha, hτ⟩, hp⟩
    · rintro ⟨⟨ha, hτ⟩, hp⟩
      obtain ⟨hd, hl⟩ := TypeDensity.affinePolynomial_natDegree_eq O a ha
      refine ⟨⟨hp, ?_, by omega, by omega, σ, by rwa [hl], by simp [hd]⟩, ha⟩
      intro h0; rw [h0, natDegree_zero] at hd; subst hd
      rw [h0] at hl; simp at hl
      exact ha ((map_eq_zero_iff _ (IsFractionRing.injective O (TypeDensity.BaseField O))).mp hl.symm)
  · ext a
    simp only [TypeDensity.binaryTypeEvent, TypeDensity.primitive, Set.mem_inter_iff, Set.mem_ofPred_eq,
        Set.mem_empty_iff_false, iff_false]
    rintro ⟨⟨⟨i, hi⟩, -⟩, h0⟩
    obtain rfl : i = Fin.last 0 := Subsingleton.elim (α := Fin 1) _ _
    rw [h0] at hi; exact not_isUnit_zero hi
  · intro m; ext a
    simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_preimage]
    have hprim : ∀ a : Fin (m+2) → O, a (Fin.last (m+1)) = 0 →
        (TypeDensity.primitive O a ↔ TypeDensity.primitive O (Fin.init a)) := by
      refine fun a h0 ↦ ⟨fun ⟨i, hi⟩ ↦ ?_, fun ⟨j, hj⟩ ↦ ⟨Fin.castSucc j, hj⟩⟩
      induction i using Fin.lastCases with
      | last => rw [h0] at hi; exact absurd hi not_isUnit_zero
      | cast j => exact ⟨j, hi⟩
    have hdeg : ∀ b : Fin (m+1) → O, TypeDensity.affinePolynomial O b ≠ 0 →
        (TypeDensity.affinePolynomial O b).natDegree = m → b (Fin.last m) ≠ 0 := fun b hne hd hb ↦ by
      refine hne (leadingCoeff_eq_zero.1 ?_)
      rw [leadingCoeff, hd, TypeDensity.affinePolynomial_coeff, dif_pos (by omega)]
      exact (congrArg _ hb).trans (map_zero _)
    constructor
    · rintro ⟨⟨hp, hne, -, hle, τ, hτ, hσ⟩, h0⟩
      rw [TypeDensity.affinePolynomial_eq_init O a h0] at hne hle hτ hσ
      have hd : (TypeDensity.affinePolynomial O (Fin.init a)).natDegree = m := by
        have := TypeDensity.affinePolynomial_natDegree_le O (Fin.init a); omega
      have hb := hdeg _ hne hd
      obtain ⟨-, hl⟩ := TypeDensity.affinePolynomial_natDegree_eq O _ hb
      rw [hd, show m + 1 - m = 1 by omega, Multiset.replicate_one] at hσ
      have hmem : ((1:ℕ),(1:ℕ)) ∈ σ := by rw [hσ]; simp
      have her : σ.erase (1,1) = τ := by rw [hσ, add_comm, Multiset.singleton_add,
          Multiset.erase_cons_head]
      refine ⟨h0, ?_⟩
      rw [if_pos hmem]
      refine ⟨⟨hb, ?_⟩, (hprim a h0).mp hp⟩
      rw [her, ← hl]; exact hτ
    · rintro ⟨h0, hs⟩
      split_ifs at hs with hmem
      · obtain ⟨⟨hb, hτ⟩, hp⟩ := hs
        obtain ⟨hd, hl⟩ := TypeDensity.affinePolynomial_natDegree_eq O _ hb
        refine ⟨⟨(hprim a h0).mpr hp, ?_⟩, h0⟩
        unfold TypeDensity.HasBinaryTypeF
        rw [TypeDensity.affinePolynomial_eq_init O a h0]; intro F; simp only [F]
        rw [hd, show m + 1 - m = 1 by omega, Multiset.replicate_one, hl]
        refine ⟨?_, by omega, le_refl _, σ.erase (1,1), hτ, ?_⟩
        · intro hz; rw [hz, leadingCoeff_zero] at hl
          exact hb ((map_eq_zero_iff _ (IsFractionRing.injective O (TypeDensity.BaseField O))).mp hl.symm)
        · rw [add_comm, Multiset.singleton_add, Multiset.cons_erase hmem]
      · exact hs.elim
