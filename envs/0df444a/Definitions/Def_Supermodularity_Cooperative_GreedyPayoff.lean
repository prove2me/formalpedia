-- title:
--   Section 5.1 - the greedy algorithm's payoff vector y^pi
-- statement:
--   For a permutation $\sigma$ of the players and a characteristic function $f$, `GreedyPayoff σ f`
--   is the payoff vector $y^\pi$ generated by the greedy algorithm (p. 210): the player placed at
--   position $j$ by $\sigma$ receives the marginal value of joining the coalition of players placed
--   before it,
--   $$y^\pi_{\pi(j)} = f(S_\pi(j)) - f(S_\pi(j-1)), \qquad j = 1,\dots,n.$$
--   In `GreedyPayoff σ f i`, the position `j` of a player `i` is read off as `σ.symm i` (`0`-indexed);
--   the marginal value uses `InitialCoalition σ (σ.symm i + 1)` and `InitialCoalition σ (σ.symm i)`,
--   which under the `0`-to-`1` indexing shift of `InitialCoalition` computes exactly $f(S_\pi(j)) -
--   f(S_\pi(j-1))$ for the book's `1`-indexed $j = \sigma^{-1}(i) + 1$.
-- source:
--   Topkis, Supermodularity and Complementarity, Princeton University Press, 2011, p. 210, Section 5.1

import Mathlib
import Definitions.Def_Supermodularity_Cooperative_InitialCoalition

namespace Supermodularity.Cooperative

/-- `GreedyPayoff σ f` is the payoff vector `yπ` generated by the greedy algorithm
for the permutation `σ` (Topkis p. 210): the player `σ j` placed at position `j`
(`0`-indexed) receives the marginal value `f (InitialCoalition σ (j+1)) -
f (InitialCoalition σ j)` of joining the coalition of players placed before it. -/
def GreedyPayoff {n : ℕ} (σ : Equiv.Perm (Fin n)) (f : Finset (Fin n) → ℝ) :
    Fin n → ℝ :=
  fun i => f (InitialCoalition σ ((σ.symm i : ℕ) + 1)) -
    f (InitialCoalition σ (σ.symm i : ℕ))

end Supermodularity.Cooperative


