variable {K}

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in
private theorem isArchCompAt_mul {μ ν : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {w : InfinitePlace K} {u u' : ℂ}
    {a a' : ℤ} (hμ : IsArchCompAt K μ w u a) (hν : IsArchCompAt K ν w u' a') :
    IsArchCompAt K (μ * ν) w (u + u') (a + a') := by
  intro x
  have hx : ((‖(x : w.Completion)‖ : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (norm_ne_zero_iff.mpr x.ne_zero)
  have hy : (extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ)) ≠ 0 :=
    div_ne_zero ((map_ne_zero _).mpr x.ne_zero) hx
  have h : archLocalChar (μ * ν) w x = archLocalChar μ w x * archLocalChar ν w x := rfl
  rw [h, Units.val_mul, hμ x, hν x, mul_add, Complex.cpow_add _ _ hx, zpow_add₀ hy]
  ring

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem isArchCompAt_mul_comp_idelicNorm_of_isReal (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (w : InfinitePlace K) (hw : w.IsReal) (u t : ℂ) (a e : ℤ)
    (hμ : IsArchCompAt K μ w u a) (hχ : IsArchCompAt ℚ χ (w.comap (algebraMap ℚ K)) t e) :
    IsArchCompAt K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) w (u + t) (a + e) :=
  isArchCompAt_mul hμ ((isArchCompAt_comp_idelicNorm_genuineBaseChange ℚ K χ w t).1 hw e hχ)

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem isArchCompAt_mul_comp_idelicNorm_of_isComplex (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (w : InfinitePlace K) (hw : w.IsComplex) (u t : ℂ) (k e : ℤ)
    (hμ : IsArchCompAt K μ w u k) (hχ : IsArchCompAt ℚ χ (w.comap (algebraMap ℚ K)) t e) :
    IsArchCompAt K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) w (u + t) k := by
  have h := isArchCompAt_mul hμ
    ((isArchCompAt_comp_idelicNorm_genuineBaseChange ℚ K χ w t).2.1 hw
      (by rw [Subsingleton.elim (w.comap (algebraMap ℚ K)) Rat.infinitePlace]; exact Rat.isReal_infinitePlace) e hχ)
  simpa using h

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem isArchCompAt_of_even_sub (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (w : InfinitePlace K) (u : ℂ)
    (a b : ℤ)
    (hsq : ∀ x : (w.Completion)ˣ,
      (extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ)) ^ (2 : ℤ) = 1)
    (hab : ∃ m : ℤ, b = a + 2 * m) (hμ : IsArchCompAt K μ w u a) : IsArchCompAt K μ w u b := by
  obtain ⟨m, rfl⟩ := hab
  intro x
  have hy : (extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ)) ≠ 0 := by
    intro h0
    have := hsq x
    rw [h0, zero_zpow _ (by norm_num)] at this
    exact zero_ne_one this
  rw [hμ x, zpow_add₀ hy, zpow_mul, hsq x, one_zpow, mul_one]

end

