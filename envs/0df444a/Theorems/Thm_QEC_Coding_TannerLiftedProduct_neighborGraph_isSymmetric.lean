import Definitions.Def_QEC_Coding_ExpanderCodes_TannerLabelledEdges
import Definitions.Def_QEC_Coding_ExpanderCodes_SmallSetExpansionSquare
import Definitions.Def_QEC_Coding_ExpanderCodes_TannerGraphExpansion
set_option autoImplicit false
open QEC QEC.Coding QEC.Coding.TannerLiftedProduct
universe v
variable {G W : Type v}
variable [Group G] [Fintype G] [DecidableEq G]
variable [Fintype W] [DecidableEq W]

theorem QEC.Coding.TannerLiftedProduct.neighborGraph_isSymmetric
    {X A : Type*} [Fintype A] [DecidableEq X]
    (neighbor : X → A → X)
    (hInvolution : ∀ x a, neighbor (neighbor x a) a = x) :
    SmallSetExpansion.IsSymmetric
      (fun x y => (Finset.univ.filter fun a => neighbor x a = y).card) := by sorry
