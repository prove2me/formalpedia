-- Source module: Solutions.KFY10Iter
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFY

open _root_.IntMul _root_.IntMul.HvdH _root_.IntMul.HvdH.Ref _root_.NLogN.KFM _root_.IntMul.OpenAI.Glue _root_.IntMul.OpenAI.RP
open _root_.NLogN.KFB (GI gflat)

theorem rotate_head_cons (dims : List ℕ) (k : ℕ) (hk : k < dims.length) :
    dims.rotate k = dims[k] :: (dims.rotate k).tail := by
  have hl : (dims.rotate k).length = dims.length := List.length_rotate _ _
  have h0 : 0 < (dims.rotate k).length := by omega
  have e : (dims.rotate k)[0] = dims[k] := by
    rw [List.getElem_rotate]; congr 1; simp [Nat.mod_eq_of_lt hk]
  rw [← e]
  exact (List.cons_head_tail (List.ne_nil_of_length_pos h0)).symm.trans
    (by rw [List.head_eq_getElem])

theorem rotate_succ_eq (dims : List ℕ) (k : ℕ) (hk : k < dims.length) :
    (dims.rotate k).tail ++ [dims[k]] = dims.rotate (k + 1) := by
  conv_rhs => rw [← List.rotate_rotate, rotate_head_cons dims k hk]
  rw [List.rotate_cons_succ, List.rotate_zero]

theorem mapsL_drop (dims : List ℕ) (fs : ℕ → List GI → List GI) (k : ℕ) (hk : k < dims.length) :
    (mapsL dims fs).drop k = (dims[k], fs k) :: (mapsL dims fs).drop (k + 1) := by
  have hl : k < (mapsL dims fs).length := by simp [mapsL, hk]
  rw [List.drop_eq_getElem_cons hl]
  congr 1
  simp [mapsL, List.getD_eq_getElem _ _ hk, List.getElem?_eq_getElem hk]

theorem tensorGo_iter_k (dims : List ℕ) (fs : ℕ → List GI → List GI) (L : List GI) :
    ∀ k ≤ dims.length, tensorGo ((mapsL dims fs).drop k) (dims.rotate k) (NLogN.KFY.iterL dims fs k L) =
      tensorGo (mapsL dims fs) dims L
  | 0, _ => by simp [NLogN.KFY.iterL]
  | k + 1, hk => by
    have hk' : k < dims.length := by omega
    rw [← tensorGo_iter_k dims fs L k hk'.le, mapsL_drop dims fs k hk',
      rotate_head_cons dims k hk']
    simp only [tensorGo]
    rw [rotate_succ_eq dims k hk']
    congr 1
    simp only [NLogN.KFY.iterL, stepL]
    rw [rotate_head_cons dims k hk']
    simp

/-- **`tensorGo` is the iteration of the steps.** -/
theorem tensorGo_iterL (dims : List ℕ) (fs : ℕ → List GI → List GI) (L : List GI) :
    tensorGo (mapsL dims fs) dims L = NLogN.KFY.iterL dims fs dims.length L := by
  have h := tensorGo_iter_k dims fs L dims.length le_rfl
  have hd : (mapsL dims fs).drop dims.length = [] := List.drop_eq_nil_of_le (by simp [mapsL])
  rw [hd] at h
  rw [← h]
  rfl

end NLogN.KFY

end

