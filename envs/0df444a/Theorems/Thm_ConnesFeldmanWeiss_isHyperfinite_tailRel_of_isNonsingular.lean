-- title:
--   Corollary 13 (Vershik) — the tail relation of a non-singular endomorphism with countable fibres is hyperfinite
-- statement:
--   Let $X$ be a standard Borel space, $\mu$ a $\sigma$-finite measure on $X$, and $T : X \to X$ non-singular (`IsNonsingular`: measurable, and $\mu(T^{-1}A) = 0$ exactly when $\mu(A) = 0$) with $T^{-1}\{x\}$ countable for $\mu$-almost every $x$. Then the tail relation, $x \sim y$ exactly when $T^n x = T^m y$ for some $n, m \in \mathbb N$, is hyperfinite (`IsHyperfinite`): off some $\mu$-null Borel set, it is a discrete measured equivalence relation and an increasing union of type I relations. “Non-singular” has its usual meaning; how far “up to a null set” reaches is set out with the definition of hyperfinite in the definitions bundle.
-- source:
--   Connes, A., Feldman, J., Weiss, B., An amenable equivalence relation is generated by a single transformation, Ergodic Theory Dynam. Systems 1 (1981) 431–450, https://doi.org/10.1017/S014338570000136X, p. 445, Corollary 13

import Mathlib
import Definitions.Def_ConnesFeldmanWeiss

namespace ConnesFeldmanWeiss

theorem isHyperfinite_tailRel_of_isNonsingular {X : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] (μ : MeasureTheory.Measure X) [MeasureTheory.SigmaFinite μ]
    (T : X → X) (hT : IsNonsingular μ T) (hcount : ∀ᵐ x ∂μ, (T ⁻¹' {x}).Countable) :
    IsHyperfinite μ {p : X × X | ∃ n m : ℕ, T^[n] p.1 = T^[m] p.2} := by
  sorry

end ConnesFeldmanWeiss
