theorem NLogN.FW.spec_mv (M : MulSpec) (i j c r : Fin HS) (s : IState HS) (l : List ℤ)
    (Ri Lr : List Item) (hij : i ≠ j) (hci : c ≠ i) (hcj : c ≠ j) (hi : s.G i = ints l ++ Ri)
    (hr : s.G r = .int (l.length : ℤ) :: Lr)
    (hi55 : i.val < 55) (hj55 : j.val < 55) (hc55 : c.val < 55) (hr55 : r.val < 55)
    (B : ℕ) (hlB : zsz (l.length : ℤ) ≤ B) (hB : ∀ x ∈ l, zsz x ≤ B) :
    Spec M (RM.rs (mvList i j c (.reg r))) s ((s.upd i Ri).upd j (ints l.reverse ++ s.G j))
      (l.length * (14000 * (B + 2) + 30) + 4000 * (B + 2) + 32) := by sorry
