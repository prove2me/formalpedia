open RepellingPairs.Dev.Farkas in
/-- **§3, Farkas alternative (corrected: `load F′ ≤ load F`).** Edge lengths as in Theorem 1 exist if and only
if there is no pair of nonnegative real flows, `F` on the designated paths and `F′` on arbitrary paths,
with `load F′ ≤ load F` on every edge and `∑ F D < ∑ F′ D`. Chen, Pylyavskyy, Tan, arXiv:2607.02883 (version
of October 23, 2026), §3, pp.7–8.

**Formalization Note.** The page prints Property 2 as "greater than"; Farkas' lemma gives only `≥`. `F′` is
finitely supported, a finite multigraph having finitely many paths. -/
theorem chk_farkas_alternative {V : Type u} {E : Type v} {k : ℕ} [Fintype V] [Fintype E] [DecidableEq E]
    (G : OSInstance V E k) (D : Fin k → Fin k → ℝ) (hD : IsMetric D) (hK : IsKalmanson D)
    (P : PathStructure G) :
    (∃ ℓ : E → ℝ, (∀ e, 0 ≤ ℓ e) ∧ ∀ i j,
        (P.path i j).1.len ℓ = D i j ∧
        ∀ Q : G.graph.Path (G.term i) (G.term j), (P.path i j).1.len ℓ ≤ Q.1.len ℓ) ↔
    ¬ ∃ (F : Fin k → Fin k → ℝ) (F' : TerminalPath G →₀ ℝ),
        (∀ i j, 0 ≤ F i j) ∧ (∀ q, 0 ≤ F' q) ∧
        (∀ e, realPathLoad F' e ≤ realLoad P F e) ∧
        realCost D F < realPathCost D F' := by
  constructor
  · rintro ⟨ℓ, hℓ, hlen⟩ ⟨F, F', hF, hF', hload, hcost⟩
    have hq : ∀ q : TerminalPath G, D q.src q.tgt ≤ q.path.1.len ℓ := fun q => by
      rw [← (hlen q.src q.tgt).1]
      exact (hlen q.src q.tgt).2 q.path
    have h1 : realPathCost D F' ≤ F'.sum fun q w => w * q.path.1.len ℓ := by
      unfold realPathCost Finsupp.sum
      exact Finset.sum_le_sum fun q _ => mul_le_mul_of_nonneg_left (hq q) (hF' q)
    have h2 : (F'.sum fun q w => w * q.path.1.len ℓ) = ∑ e, ℓ e * realPathLoad F' e := by
      unfold realPathLoad Finsupp.sum
      simp only [len_eq_sum, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun e _ => Finset.sum_congr rfl fun q _ => ?_
      ring
    have h3 : ∑ e, ℓ e * realPathLoad F' e ≤ ∑ e, ℓ e * realLoad P F e :=
      Finset.sum_le_sum fun e _ => mul_le_mul_of_nonneg_left (hload e) (hℓ e)
    have h4 : ∑ e, ℓ e * realLoad P F e = realCost D F := by
      unfold realLoad realCost
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← (hlen i j).1, len_eq_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun e _ => ?_
      ring
    linarith
  · intro hno
    classical
    haveI : Finite (TerminalPath G) := finite_terminalPath G
    haveI : Fintype (TerminalPath G) := Fintype.ofFinite _
    let A : TerminalPath G ⊕ (Fin k × Fin k) → E → ℝ :=
      Sum.elim (fun q e => (q.path.1.edges.count e : ℝ))
        (fun p e => -((P.path p.1 p.2).1.edges.count e : ℝ))
    let b : TerminalPath G ⊕ (Fin k × Fin k) → ℝ :=
      Sum.elim (fun q => D q.src q.tgt) (fun p => - D p.1 p.2)
    rcases RepellingPairs.Dev.FarkasLP.farkas A b with ⟨x, hx, hxb⟩ | ⟨y, hy, hyA, hyb⟩
    · have hlo : ∀ q : TerminalPath G, D q.src q.tgt ≤ q.path.1.len x := fun q => by
        have := hxb (Sum.inl q)
        simp only [b, A, Sum.elim_inl] at this
        rw [len_eq_sum]
        refine this.trans (le_of_eq (Finset.sum_congr rfl fun e _ => mul_comm _ _))
      have hhi : ∀ i j, (P.path i j).1.len x ≤ D i j := fun i j => by
        have := hxb (Sum.inr (i, j))
        simp only [b, A, Sum.elim_inr, Finset.sum_neg_distrib, neg_mul, neg_le_neg_iff] at this
        rw [len_eq_sum]
        refine le_trans (le_of_eq (Finset.sum_congr rfl fun e _ => mul_comm _ _)) ?_
        simpa [mul_comm] using this
      have hP : ∀ i j, D i j ≤ (P.path i j).1.len x := fun i j =>
        hlo ⟨i, j, P.path i j⟩
      refine ⟨x, hx, fun i j => ⟨le_antisymm (hhi i j) (hP i j), fun Q => ?_⟩⟩
      exact (hhi i j).trans (hlo ⟨i, j, Q⟩)
    · exfalso
      refine hno ⟨fun i j => y (Sum.inr (i, j)), Finsupp.equivFunOnFinite.symm
        (fun q => y (Sum.inl q)), fun i j => hy _, fun q => hy _, ?_, ?_⟩
      · intro e
        have := hyA e
        simp only [A, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, mul_neg,
          Finset.sum_neg_distrib, Fintype.sum_prod_type] at this
        unfold realPathLoad realLoad
        rw [Finsupp.sum_fintype _ _ (fun q => by simp)]
        simp only [Finsupp.coe_equivFunOnFinite_symm]
        linarith
      · have := hyb
        simp only [b, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, mul_neg,
          Finset.sum_neg_distrib, Fintype.sum_prod_type] at this
        unfold realPathCost realCost
        rw [Finsupp.sum_fintype _ _ (fun q => by simp)]
        simp only [Finsupp.coe_equivFunOnFinite_symm]
        linarith

end RepellingPairs
