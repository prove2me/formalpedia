  refine ⟨⟨NLogN.CR.max0_ok _ _ ⟨⟨trivial, isInt_of' hx⟩, trivial⟩, ⟨trivial, isInt_of' hq⟩, ?_, ?_⟩, ?_⟩
  · rw [NLogN.CR.max0_eval]; omega
  · simp only [Ex.eval, tq]; push_cast; positivity
  · simp only [NLogN.CR.mE, Ex.eval]
    rw [NLogN.CR.max0_eval]
    simp only [Ex.eval, tx, tq]
    have e1 : max (((4 * K - 1 : ℕ) : ℤ) * (X : ℤ) + -(4 * K : ℤ)) 0 = (((4 * K - 1) * X - 4 * K : ℕ) : ℤ) := by
