    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hH 0 (Nat.zero_le N)) (norm_nonneg _)
  have hN : ‖h N * e N‖ ≤ H * ‖e N‖ := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hH N le_rfl) (norm_nonneg _)
  have hstep : ∀ j ∈ Finset.range N,
      ‖h (j + 1) * e (j + 1) - h j * e j‖ ≤
        H * ‖e (j + 1) - e j‖ +
          ‖h (j + 1) - h j‖ * ‖e j‖ := by
    intro j hj
    have hjN : j + 1 ≤ N := by
      simpa [Finset.mem_range] using (Nat.succ_le_iff.mpr (Finset.mem_range.mp hj))
    calc
      ‖h (j + 1) * e (j + 1) - h j * e j‖ =
