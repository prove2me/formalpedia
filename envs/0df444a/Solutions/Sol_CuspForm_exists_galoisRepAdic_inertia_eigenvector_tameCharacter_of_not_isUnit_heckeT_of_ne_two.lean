private theorem exists_exponent {p : ℕ} (hp : p.Prime) :
    ∃ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (ζ : AlgebraicClosure ℚ),
        ζ ^ p = 1 → σ ζ = ζ ^ n σ := by
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot hp
  haveI : NeZero p := ⟨hp.ne_zero⟩
  refine ⟨fun σ => ((hζ.autToPow ℚ σ : (ZMod p)ˣ) : ZMod p).val, fun σ ξ hξ => ?_⟩
  show σ ξ = ξ ^ ((hζ.autToPow ℚ σ : (ZMod p)ˣ) : ZMod p).val
  obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one hξ
  rw [map_pow, ← hζ.autToPow_spec ℚ σ, ← pow_mul, ← pow_mul, mul_comm]

