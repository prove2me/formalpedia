private theorem apply_eq_one_of_mem_localMaximalCompact3 {v : HeightOneSpectrum (𝓞 ℚ)} (W : LocalGL3 v → ℂ)
    (hWK : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 W)) (hW1 : dualWhittakerFn3 W 1 = 1)
    {k : LocalGL3 v} (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) : W k = 1 := by
  have hq : transposeInv3 (longWeyl3⁻¹ * k) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
    DualProduct.transposeInv3_mem_localMaximalCompact3
      (mul_mem (inv_mem (DualProduct.longWeyl3_mem_localMaximalCompact3 v)) hk)
  calc W k = dualWhittakerFn3 W (1 * transposeInv3 (longWeyl3⁻¹ * k)) := by
        rw [one_mul, dualWhittakerFn3_apply, ZetaCompactSupport.transposeInv3_transposeInv3, mul_inv_cancel_left]
    _ = dualWhittakerFn3 W 1 := hWK 1 _ hq
    _ = 1 := hW1

private theorem eq_adelicProduct (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ)
    (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)
    (hfac : ∀ (g : AdelicGL 3 (𝓞 ℚ) ℚ) (T : Finset (HeightOneSpectrum (𝓞 ℚ))), S ⊆ T →
      (∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) →
      W g = Warch (archComponent3 (𝓞 ℚ) ℚ g) * ∏ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v g))
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hnorm : ∀ v ∉ T, ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1) :
    W = LocalFactorProduct.adelicProduct Warch Wloc := by
  classical
  funext p
  obtain ⟨M, hM⟩ := Ideal.exists_maximal (𝓞 ℚ)
  obtain ⟨T', hT'₁, -, hT'⟩ := LocalFactorProduct.exists_finset_integral (S ∪ T)
    ⟨M, hM.isPrime, Ring.ne_bot_of_isMaximal_of_not_isField hM (RingOfIntegers.not_isField ℚ)⟩ p
  rw [hfac p T' (Finset.subset_union_left.trans hT'₁) hT',
    LocalFactorProduct.adelicProduct_eq_prod Warch hnorm p T' (Finset.subset_union_right.trans hT'₁) hT']

private theorem xLineAt_partAt_of_mem (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    {v : HeightOneSpectrum (𝓞 ℚ)} (hv : v ∈ T) :
    LineIntegral.xLineAt Wloc (Idele.partAt ℚ T a) g v = LineIntegral.xLineAt Wloc a g v := by
  have h : CharacterComponents.unitsAt v (Idele.partAt ℚ T a) = CharacterComponents.unitsAt v a :=
    Units.ext (by
      rw [CharacterComponents.unitsAt_val, CharacterComponents.unitsAt_val, Idele.partAt_snd_of_mem ℚ T a hv])
  funext y
  simp only [LineIntegral.xLineAt, h]

