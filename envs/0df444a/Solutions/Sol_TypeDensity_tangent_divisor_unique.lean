theorem solution (O R : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R] (S : TypeDensity.SurfaceData O R)
    (hreg : TypeDensity.RegularParameterPair R S.t S.x) (J : Ideal R) (d d' : ℕ)
    (Dv Dv' : TypeDensity.ExceptionalDivisor (IsLocalRing.ResidueField R)) (h : TypeDensity.HasTangentDivisor O R S J d Dv)
