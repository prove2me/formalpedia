/-!
# Proper base change for the projective line, library file 157

Declarations of the formalization of proper base change for the étale cohomology of the projective
line over a base (geometric stalks of the higher direct images of P¹_S → S are the étale cohomology of
the geometric fibres), re-hosted declaration by declaration from the library modules below. Each module
contributes the declarations assigned to this file, copied verbatim with the module's own `namespace` /
`open` / `variable` lines, inside its own `section` ... `end`:

* `S4.Def_RP_EtPBC_A_O2Km8`: S4-EtPBC-A, O2 M6 (O2Km8): `H¹` is generated by Kummer classes of the pieces
-/

set_option autoImplicit false

set_option linter.defProp false

-- ===== S4.Def_RP_EtPBC_A_O2Km8 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Km8): `H¹` is generated by Kummer classes of the pieces

* `kumD hζ hζΓ hdN hα hg : ChL A K Λ`: the Kummer character `kumChi_d α g` (`d ∣ N`, `α` a `d`-th radical,
  `d • g = 0`), `kumD_apply`;
* **`h1_mem_of_kum`**: an additive subgroup `S ≤ H¹(X, Λ)` containing every Kummer class
  `kapS p (kumD α g)` (`α ^ d = u ∈ Frac(Γ ⧸ p)`) of every piece `p` is everything
  (`h1_exists_kappa` + `exists_kum_dec`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtCompact.Pur RamanujanPetersson.EtPi1 RamanujanPetersson.Kummer
  RamanujanPetersson.EtCompact.GalTrE

section KumD

end KumD

section Dec

end Dec

section Red

variable {X : Scheme.{0}} [IsAffine X] [IsNoetherianRing Γ(X, ⊤)]
  (h : ∀ (m : Ideal Γ(X, ⊤)) [m.IsMaximal], IsDomain (Localization.AtPrime m))
  [∀ p : minimalPrimes Γ(X, ⊤), IsDedekindDomain (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))]
  [Fintype (minimalPrimes Γ(X, ⊤))] [DecidableEq (minimalPrimes Γ(X, ⊤))] (Λ : Type) [CommRing Λ]
  {N : ℕ} [NeZero N] (hΛ : ∀ x : Λ, N • x = 0)
  {ζ : ∀ p : minimalPrimes Γ(X, ⊤),
    maxUnram (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))) (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))))}
  (hζ : ∀ p, IsPrimitiveRoot (ζ p) N)
  (hζΓ : ∀ p : minimalPrimes Γ(X, ⊤), ∀ σ ∈ (⊤ : Subgroup (Pi1 (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))
    (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))))), σ (ζ p) = ζ p)

include hΛ in
/-- **`H¹(X, Λ)` is generated by the Kummer classes of the pieces `Spec (Γ ⧸ p)`.** -/
def h1_mem_of_kum (S : AddSubgroup (H Λ (unitSh Λ X) 1))
    (hS : ∀ (p : minimalPrimes Γ(X, ⊤)) (d : ℕ) [NeZero d] (hdN : d ∣ N)
      (α : (maxUnram (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))) (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))))ˣ)
      (hα : α ∈ rad (⊤ : Subgroup (Pi1 (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))
        (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))))) d)
      (u : FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))))
      (_ : (α : maxUnram (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))) (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))))) ^ d =
        algebraMap (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))))
          (maxUnram (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))) (FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))))) u)
      (g : Λ) (hg : d • g = 0),
      kapS h Λ p (kumD (hζ p) (hζΓ p) hdN hα hg) ∈ S)
    (c : H Λ (unitSh Λ X) 1) : c ∈ S := by
  obtain ⟨χ, rfl⟩ := h1_exists_kappa h Λ c
  refine AddSubgroup.sum_mem _ fun p _ => ?_
  exact chl_mem_of_kum (hζ p) (hζΓ p) hΛ (S.comap (kapS h Λ p)) (hS p) (χ p)

end Red

end RamanujanPetersson.EtPBC.EtKum

