-- Source module: NLogN.Prims
namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem length_nbits_le {n m : ℕ} (h : n < 2 ^ m) : (nbits n).length ≤ m := by
  have := nbits_drop n m
  rw [Nat.div_eq_of_lt h, nbits_zero, List.drop_eq_nil_iff] at this
  exact this

end NLogN

