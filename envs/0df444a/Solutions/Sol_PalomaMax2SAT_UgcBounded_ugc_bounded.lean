import Mathlib
import Definitions.Def_PalomaMax2SAT_UgcBounded_Defs

section Inline_CutTransfer
/-!
# MAX-CUT as MAX 2-SAT

For a graph with edge list `left, right : Fin m → Fin n`, the formula `F_G` has, for every
edge `e`, the clauses `(x_l ∨ x_r)` and `(¬x_l ∨ ¬x_r)`. An assignment is a set `S` of
true variables. This module proves that the number of satisfied clauses is
`m + cut(S)` (Proposition `prop:cut2sat` of the paper) and the arithmetic of the ratio
transfer from `F_G` and from `T_H` to the cut.

The conflict-graph identity `α(H) = m + maxcut(G)` (Proposition `prop:cutconflict`) is
proved in `ConflictGraph`.
-/

namespace PalomaMax2SAT.CutTransfer

theorem edgeValue_eq {n m : ℕ} (G : EdgeGraph n m) (S : Finset (Fin n)) (e : Fin m) :
    edgeValue G S e = 1 +
      (if (G.left e ∈ S ∧ G.right e ∉ S) ∨ (G.left e ∉ S ∧ G.right e ∈ S)
        then 1 else 0) := by
  unfold edgeValue
  by_cases ha : G.left e ∈ S <;> by_cases hb : G.right e ∈ S <;> simp [ha, hb]

/-- Proposition `prop:cut2sat`: the assignment `S` satisfies exactly `m + cut(S)`
clauses of `F_G`. -/
theorem value_eq_edges_add_cut {n m : ℕ} (G : EdgeGraph n m) (S : Finset (Fin n)) :
    ∑ e : Fin m, edgeValue G S e = m + cutCount G S := by
  unfold cutCount
  rw [Finset.card_filter, Finset.sum_congr rfl (fun e _ => edgeValue_eq G S e),
    Finset.sum_add_distrib]
  simp

end PalomaMax2SAT.CutTransfer

end Inline_CutTransfer

section Inline_ConflictGraph
/-!
# The conflict graph of `F_G` (Proposition `prop:cutconflict`)

The formula `F_G` has, for every edge `e` with endpoints `left e`, `right e`, the clauses
`(x_{left e} ∨ x_{right e})` and `(¬x_{left e} ∨ ¬x_{right e})`. Its literal occurrences are the
triples `(e, s, b)` of `Occ m`: the edge `e`, the sign `s` of the clause (`true` for the positive
clause) and the endpoint `b` (`true` for `left`). Two occurrences are adjacent in the conflict
graph when they are distinct and either lie in the same clause or belong to the same variable
with opposite signs.

This module proves `α(H) = m + maxcut(G)` for every graph `G`: independent sets of the conflict
graph have at most `m + cut(S)` elements for a suitable `S`, and every `S` yields an independent
set with exactly `m + cut(S)` elements. Regularity and the degree count are in
`PalomaMax2SAT.ConflictDegree`.
-/

namespace PalomaMax2SAT.ConflictGraph

open PalomaMax2SAT.CutTransfer

variable {n m : ℕ}

/-! ### From a cut to an independent set -/

theorem card_selSet (G : EdgeGraph n m) (S : Finset (Fin n)) :
    (selSet G S).card = ∑ e : Fin m, edgeValue G S e := by
  unfold selSet
  rw [Finset.card_filter]
  simp only [Fintype.sum_prod_type, Fintype.sum_bool]
  refine Finset.sum_congr rfl fun e _ => ?_
  unfold edgeValue
  by_cases hl : G.left e ∈ S <;> by_cases hr : G.right e ∈ S <;> simp [selB, hl, hr]

theorem var_mem_of_selB_pos (G : EdgeGraph n m) (S : Finset (Fin n)) (e : Fin m) (b : Bool)
    (h : selB G S e true b = true) : var G (e, true, b) ∈ S := by
  cases b <;> simp [selB, var, ov] at h ⊢ <;> tauto

theorem var_notMem_of_selB_neg (G : EdgeGraph n m) (S : Finset (Fin n)) (e : Fin m) (b : Bool)
    (h : selB G S e false b = true) : var G (e, false, b) ∉ S := by
  cases b <;> simp [selB, var, ov] at h ⊢ <;> tauto

theorem selSet_independent (G : EdgeGraph n m) (S : Finset (Fin n)) : Ind G (selSet G S) := by
  intro p hp q hq hadj
  obtain ⟨e, s, b⟩ := p
  obtain ⟨e', s', b'⟩ := q
  simp only [selSet, Finset.mem_filter, Finset.mem_univ, true_and] at hp hq
  unfold Adj at hadj
  rcases hadj with ⟨hne, h | h⟩
  · obtain ⟨h1, h2⟩ := h
    simp only at h1 h2
    subst h1
    subst h2
    cases s <;> cases b <;> cases b' <;> simp_all [selB]
  · obtain ⟨h1, h2⟩ := h
    simp only at h2
    cases s <;> cases s'
    · exact h2 rfl
    · have hp' := var_notMem_of_selB_neg G S e b hp
      have hq' := var_mem_of_selB_pos G S e' b' hq
      exact hp' (by rw [h1]; exact hq')
    · have hp' := var_mem_of_selB_pos G S e b hp
      have hq' := var_notMem_of_selB_neg G S e' b' hq
      exact hq' (by rw [← h1]; exact hp')
    · exact h2 rfl

/-! ### From an independent set to a cut -/

theorem mem_cutOf_of_pos (G : EdgeGraph n m) (I : Finset (Occ m)) (e : Fin m) (b : Bool)
    (h : (e, true, b) ∈ I) : var G (e, true, b) ∈ cutOf G I := by
  simp only [cutOf, Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨(e, true, b), h, rfl, rfl⟩

theorem notMem_cutOf_of_neg (G : EdgeGraph n m) (I : Finset (Occ m)) (hI : Ind G I)
    (e : Fin m) (b : Bool) (h : (e, false, b) ∈ I) : var G (e, false, b) ∉ cutOf G I := by
  intro hv
  simp only [cutOf, Finset.mem_filter, Finset.mem_univ, true_and] at hv
  obtain ⟨⟨e', s', b'⟩, hp, hvar, hs⟩ := hv
  simp only at hs
  subst hs
  apply hI (e', true, b') hp (e, false, b) h
  unfold Adj
  refine ⟨?_, Or.inr ⟨hvar, ?_⟩⟩
  · intro hEq
    have h3 := congrArg (fun x : Occ m => x.2.1) hEq
    simp at h3
  · simp

/-- Per-edge bound: the number of chosen occurrences of an edge is at most the number of clauses
of that edge satisfied by `cutOf G I`. -/
theorem edge_bound (G : EdgeGraph n m) (I : Finset (Occ m)) (hI : Ind G I) (e : Fin m) :
    ((if (e, true, true) ∈ I then 1 else 0) + (if (e, true, false) ∈ I then 1 else 0)) +
      ((if (e, false, true) ∈ I then 1 else 0) + (if (e, false, false) ∈ I then 1 else 0))
      ≤ edgeValue G (cutOf G I) e := by
  have hpp : (e, true, true) ∈ I → (e, true, false) ∈ I → False := by
    intro h1 h2
    apply hI _ h1 _ h2
    unfold Adj
    refine ⟨?_, Or.inl ⟨rfl, rfl⟩⟩
    intro hEq
    have h3 := congrArg (fun x : Occ m => x.2.2) hEq
    simp at h3
  have hnn : (e, false, true) ∈ I → (e, false, false) ∈ I → False := by
    intro h1 h2
    apply hI _ h1 _ h2
    unfold Adj
    refine ⟨?_, Or.inl ⟨rfl, rfl⟩⟩
    intro hEq
    have h3 := congrArg (fun x : Occ m => x.2.2) hEq
    simp at h3
  have hl1 : (e, true, true) ∈ I → G.left e ∈ cutOf G I := fun h => mem_cutOf_of_pos G I e true h
  have hr1 : (e, true, false) ∈ I → G.right e ∈ cutOf G I :=
    fun h => mem_cutOf_of_pos G I e false h
  have hl0 : (e, false, true) ∈ I → G.left e ∉ cutOf G I :=
    fun h => notMem_cutOf_of_neg G I hI e true h
  have hr0 : (e, false, false) ∈ I → G.right e ∉ cutOf G I :=
    fun h => notMem_cutOf_of_neg G I hI e false h
  unfold edgeValue
  by_cases a1 : (e, true, true) ∈ I <;> by_cases a2 : (e, true, false) ∈ I <;>
    by_cases a3 : (e, false, true) ∈ I <;> by_cases a4 : (e, false, false) ∈ I <;>
    simp_all

theorem card_le_edgeValues (G : EdgeGraph n m) (I : Finset (Occ m)) (hI : Ind G I) :
    I.card ≤ ∑ e : Fin m, edgeValue G (cutOf G I) e := by
  have hc : I.card = ∑ p : Occ m, if p ∈ I then 1 else 0 := by
    rw [← Finset.card_filter]; congr 1; ext p; simp
  rw [hc]
  simp only [Fintype.sum_prod_type, Fintype.sum_bool]
  exact Finset.sum_le_sum fun e _ => edge_bound G I hI e

/-! ### The identity `α(H) = m + maxcut(G)` -/

/-- Proposition `prop:cutconflict`: the independence number of the conflict graph of `F_G` is
`m + maxcut(G)`. -/
theorem alpha_eq (G : EdgeGraph n m) {mc : ℕ} (h : IsMaxCut G mc) : IsIndNumber G (m + mc) := by
  constructor
  · intro I hI
    have h1 := card_le_edgeValues G I hI
    rw [value_eq_edges_add_cut] at h1
    have h2 := h.1 (cutOf G I)
    omega
  · obtain ⟨S, hS⟩ := h.2
    refine ⟨selSet G S, selSet_independent G S, ?_⟩
    rw [card_selSet, value_eq_edges_add_cut, hS]

end PalomaMax2SAT.ConflictGraph

end Inline_ConflictGraph

section Inline_ConflictDegree
/-!
# Degrees of the conflict graph of `F_G`

For the conflict graph `H(G)` on the literal occurrences `Occ m` of `F_G` this module proves:

* `occurrences_eq`: the variable `x_v` occurs in exactly `2 deg(v)` clauses (Proposition
  `prop:cut2sat`, item 2);
* `card_nbrs`: the occurrence `(e, s, b)` has `1 + deg(var)` neighbours, so `H(G)` is
  `(d + 1)`-regular when `G` is `d`-regular (Proposition `prop:cutconflict`);
* `card_occ`: `H(G)` has `4 m` vertices.

Here `deg(v) = occ G v` is the number of edge endpoints equal to `v`.
-/

namespace PalomaMax2SAT.ConflictDegree

open PalomaMax2SAT.CutTransfer PalomaMax2SAT.ConflictGraph

variable {n m : ℕ}

theorem card_slots (G : EdgeGraph n m) (v : Fin n) : (slots G v).card = occ G v := by
  unfold slots occ
  rw [Finset.card_filter]
  simp only [Fintype.sum_prod_type, Fintype.sum_bool, ov]
  refine Finset.sum_congr rfl fun e _ => ?_
  by_cases h1 : G.left e = v <;> by_cases h2 : G.right e = v <;> simp [h1, h2]

theorem mem_adj_iff (G : EdgeGraph n m) (e e' : Fin m) (s s' b b' : Bool) :
    Adj G (e, s, b) (e', s', b') ↔
      (e', s', b') = (e, s, !b) ∨ (ov G e' b' = ov G e b ∧ s' = !s) := by
  unfold Adj
  cases s <;> cases s' <;> cases b <;> cases b' <;> simp [var, ov, eq_comm]

theorem nbrs_eq (G : EdgeGraph n m) (e : Fin m) (s b : Bool) :
    nbrs G (e, s, b) =
      {(e, s, !b)} ∪ ((slots G (ov G e b)).image fun x => (x.1, !s, x.2)) := by
  ext ⟨e', s', b'⟩
  simp only [nbrs, Finset.mem_filter, Finset.mem_univ, true_and, mem_adj_iff,
    Finset.mem_union, Finset.mem_singleton, Finset.mem_image, slots, Prod.exists]
  constructor
  · rintro (h | ⟨h1, h2⟩)
    · exact Or.inl h
    · exact Or.inr ⟨e', b', h1, by rw [h2]⟩
  · rintro (h | ⟨a, c, h1, h2⟩)
    · exact Or.inl h
    · simp only [Prod.mk.injEq] at h2
      obtain ⟨h3, h4, h5⟩ := h2
      subst h3
      subst h5
      exact Or.inr ⟨h1, h4.symm⟩

theorem card_nbrs (G : EdgeGraph n m) (e : Fin m) (s b : Bool) :
    (nbrs G (e, s, b)).card = 1 + occ G (ov G e b) := by
  have hd : Disjoint ({(e, s, !b)} : Finset (Occ m))
      ((slots G (ov G e b)).image fun x => (x.1, !s, x.2)) := by
    rw [Finset.disjoint_singleton_left]
    intro hmem
    obtain ⟨x, _, hx⟩ := Finset.mem_image.mp hmem
    have h3 := congrArg (fun q : Occ m => q.2.1) hx
    cases s <;> simp at h3
  have hinj : Function.Injective fun x : Fin m × Bool => ((x.1, !s, x.2) : Occ m) := by
    intro x y h
    exact Prod.ext (congrArg (fun q : Occ m => q.1) h) (congrArg (fun q : Occ m => q.2.2) h)
  have h := Finset.card_union_add_card_inter ({(e, s, !b)} : Finset (Occ m))
    ((slots G (ov G e b)).image fun x => (x.1, !s, x.2))
  rw [Finset.disjoint_iff_inter_eq_empty.mp hd, Finset.card_empty, Finset.card_singleton,
    Finset.card_image_of_injective _ hinj, card_slots] at h
  rw [nbrs_eq]
  omega

/-- The conflict graph has `4 m` vertices. -/
theorem card_occ (m : ℕ) : Fintype.card (Occ m) = 4 * m := by
  simp [Occ, Fintype.card_prod]
  ring

/-- The variable `x_v` occurs in exactly `2 deg(v)` clauses. -/
theorem occurrences_eq (G : EdgeGraph n m) (v : Fin n) :
    (Finset.univ.filter fun p : Occ m => var G p = v).card = 2 * occ G v := by
  rw [Finset.card_filter]
  simp only [Fintype.sum_prod_type, Fintype.sum_bool, var, ov]
  unfold occ
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun e _ => ?_
  by_cases h1 : G.left e = v <;> by_cases h2 : G.right e = v <;> simp [h1, h2]

end PalomaMax2SAT.ConflictDegree

end Inline_ConflictDegree

section Inline_BoundedLemmas
/-!
# Counting lemmas for the conflict graph of a bounded-degree graph

Degree sums, the edge-count lower bound `|E(H(G))| ≥ 4 m`, the maximum-degree bound
`Dmax + 1`, and the division-free ratio arithmetic used by `PalomaMax2SAT.UgcBounded.ugc_bounded`.
-/

namespace PalomaMax2SAT.BoundedLemmas

/-- The degrees of the vertices of `G` add up to `2 m`. -/
theorem sum_occ {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) :
    ∑ v, PalomaMax2SAT.ConflictDegree.occ G v = 2 * m := by
  unfold PalomaMax2SAT.ConflictDegree.occ
  rw [Finset.sum_comm]
  have h : ∀ e : Fin m, ∑ v : Fin n,
      ((if G.left e = v then 1 else 0) + (if G.right e = v then 1 else 0)) = 2 := by
    intro e
    rw [Finset.sum_add_distrib]
    simp
  rw [Finset.sum_congr rfl (fun e _ => h e), Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul]
  ring

/-- The degree sum of the conflict graph: `Σ_p deg(p) = 4 m + 2 Σ_v deg(v)²`. -/
theorem sum_nbrs {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) :
    ∑ p : PalomaMax2SAT.ConflictGraph.Occ m, (PalomaMax2SAT.ConflictDegree.nbrs G p).card =
      4 * m + 2 * ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ^ 2 := by
  have h1 : ∀ p : PalomaMax2SAT.ConflictGraph.Occ m,
      (PalomaMax2SAT.ConflictDegree.nbrs G p).card =
        1 + PalomaMax2SAT.ConflictDegree.occ G (PalomaMax2SAT.ConflictGraph.var G p) := by
    rintro ⟨e, s, b⟩
    exact PalomaMax2SAT.ConflictDegree.card_nbrs G e s b
  rw [Finset.sum_congr rfl (fun p _ => h1 p), Finset.sum_add_distrib, Finset.sum_const,
    Finset.card_univ, PalomaMax2SAT.ConflictDegree.card_occ, smul_eq_mul, mul_one]
  have h2 : ∑ p : PalomaMax2SAT.ConflictGraph.Occ m,
      PalomaMax2SAT.ConflictDegree.occ G (PalomaMax2SAT.ConflictGraph.var G p) =
        ∑ v, 2 * PalomaMax2SAT.ConflictDegree.occ G v *
          PalomaMax2SAT.ConflictDegree.occ G v := by
    have hf := Finset.sum_fiberwise_of_maps_to
      (s := (Finset.univ : Finset (PalomaMax2SAT.ConflictGraph.Occ m)))
      (t := (Finset.univ : Finset (Fin n))) (g := PalomaMax2SAT.ConflictGraph.var G)
      (fun p _ => Finset.mem_univ _)
      (fun p => PalomaMax2SAT.ConflictDegree.occ G (PalomaMax2SAT.ConflictGraph.var G p))
    rw [← hf]
    refine Finset.sum_congr rfl fun v _ => ?_
    have hv : ∀ p ∈ Finset.univ.filter
        (fun p : PalomaMax2SAT.ConflictGraph.Occ m =>
          PalomaMax2SAT.ConflictGraph.var G p = v),
        PalomaMax2SAT.ConflictDegree.occ G (PalomaMax2SAT.ConflictGraph.var G p) =
          PalomaMax2SAT.ConflictDegree.occ G v := by
      intro p hp
      rw [(Finset.mem_filter.mp hp).2]
    rw [Finset.sum_congr rfl hv, Finset.sum_const, smul_eq_mul,
      PalomaMax2SAT.ConflictDegree.occurrences_eq]
  have h3 : ∑ v, 2 * PalomaMax2SAT.ConflictDegree.occ G v *
      PalomaMax2SAT.ConflictDegree.occ G v =
        2 * ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ^ 2 := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun v _ => ?_
    ring
  rw [h2, h3]

/-- The conflict graph has at least `4 m` edges: if `2 M = Σ_p deg(p)` then `4 m ≤ M`. -/
theorem edges_ge {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) (M : ℕ)
    (hM : 2 * M = ∑ p : PalomaMax2SAT.ConflictGraph.Occ m,
      (PalomaMax2SAT.ConflictDegree.nbrs G p).card) :
    2 * M = 4 * m + 2 * ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ^ 2 ∧ 4 * m ≤ M := by
  have h1 := sum_nbrs G
  have h2 := sum_occ G
  have h3 : ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ≤
      ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ^ 2 := by
    apply Finset.sum_le_sum
    intro v _
    calc PalomaMax2SAT.ConflictDegree.occ G v
        ≤ PalomaMax2SAT.ConflictDegree.occ G v * PalomaMax2SAT.ConflictDegree.occ G v :=
          Nat.le_mul_self _
      _ = PalomaMax2SAT.ConflictDegree.occ G v ^ 2 := (sq _).symm
  constructor
  · omega
  · omega

/-- With `N = 4 m`, `4 m ≤ M`, `α ≤ 2 m` and `18785 α ≤ 20000 s`, the value `B + s` with
`B = N + 3 M` satisfies `9932 (B + α) ≤ 10000 (B + s)` and `83 (B + α) ≤ 84 (B + s)`. -/
theorem ratio_nonregular (m M alpha s : ℕ) (hM : 4 * m ≤ M) (ha : alpha ≤ 2 * m)
    (hs : 18785 * alpha ≤ 20000 * s) :
    9932 * ((4 * m + 3 * M) + alpha) ≤ 10000 * ((4 * m + 3 * M) + s) ∧
      83 * ((4 * m + 3 * M) + alpha) ≤ 84 * ((4 * m + 3 * M) + s) := by
  constructor <;> omega

/-- A graph of maximum degree at most `Dmax` has a conflict graph of maximum degree at most
`Dmax + 1`. -/
theorem nbrs_le {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) (Dmax : ℕ)
    (hD : ∀ v, PalomaMax2SAT.ConflictDegree.occ G v ≤ Dmax)
    (p : PalomaMax2SAT.ConflictGraph.Occ m) :
    (PalomaMax2SAT.ConflictDegree.nbrs G p).card ≤ Dmax + 1 := by
  obtain ⟨e, s, b⟩ := p
  rw [PalomaMax2SAT.ConflictDegree.card_nbrs]
  have := hD (PalomaMax2SAT.ConflictGraph.ov G e b)
  omega

end PalomaMax2SAT.BoundedLemmas

end Inline_BoundedLemmas

section Inline_GeneralDegreeFormula
/-!
# The formula `T_H` for a per-vertex degree function

For a finite simple graph `H` with degrees `d_v` and a port labelling, the formula `T_H` has
`d_v + 1` Boolean clones `(v, 0), …, (v, d_v)` per vertex `v`: the clone `(v, 0)` occurs in the
unit clause `(¬ (v,0))`, the clone `(v, p+1)` occurs in the edge clause of the edge at port `p`
of `v`, and the `d_v + 1` cyclic implications `(¬ (v,i) ∨ (v,i+1))` (indices modulo `d_v + 1`)
enforce consistency. This module proves, for every degree function:

* `Σ_v d_v = 2 m`, hence `Σ_v (d_v + 1) + m = n + 3 m`;
* the number of satisfied clauses equals `U(z) + (m - F(z)) + (Σ_v (d_v + 1) - T(z))`;
* the optimum equals `B + α` with `B = Σ_v (d_v + 1) + m` (`optimum_identity`);
* the lift of an independent set `I` has value `B + |I|` (`lift_satCount`).

The vertex `v` has the port set `Fin (d_v)`; the port structure is a bijection between the
`2 m` edge ends and the ports.
-/

namespace PalomaMax2SAT.GeneralDegreeFormula

theorem GPortGraph.leftClone_lt {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (e : Fin m) : G.leftClone e < deg (G.left e) + 1 := by
  unfold GPortGraph.leftClone GPortGraph.left
  have h := (G.leftPt e).2.isLt
  omega

theorem GPortGraph.rightClone_lt {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (e : Fin m) : G.rightClone e < deg (G.right e) + 1 := by
  unfold GPortGraph.rightClone GPortGraph.right
  have h := (G.rightPt e).2.isLt
  omega

/-- Every edge has two ends and every vertex has `deg v` ports: `Σ_v d_v = 2 m`. -/
theorem sum_deg_eq {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) :
    ∑ v, deg v = 2 * m := by
  have h := Fintype.card_of_bijective G.ports_bijective
  simp only [Fintype.card_sum, Fintype.card_fin, Fintype.card_sigma] at h
  omega

/-- `Σ_v (d_v + 1) + m = n + 3 m`. -/
theorem constant_eq {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) :
    ∑ v, (deg v + 1) + m = n + 3 * m := by
  have h1 : ∑ v : Fin n, (deg v + 1) = ∑ v, deg v + n := by
    rw [Finset.sum_add_distrib]
    simp
  have h2 := sum_deg_eq G
  omega

/-! ### Assignments and the score -/

theorem mem_selectedVertices {n : ℕ} (z : Fin n → ℕ → Bool) (v : Fin n) :
    v ∈ selectedVertices z ↔ z v 0 = false := by
  unfold selectedVertices
  rw [Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩

theorem mem_transVertices {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n) :
    v ∈ transVertices deg z ↔ 0 < transCount deg z v := by
  unfold transVertices
  rw [Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩

theorem transCount_pos {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n) (i : ℕ)
    (hi : i ∈ Finset.range (deg v + 1)) (h : transAt deg z v i) : 0 < transCount deg z v := by
  unfold transCount
  calc 0 < (fun i => if transAt deg z v i then 1 else 0) i := by
        show 0 < (if transAt deg z v i then 1 else 0 : ℕ)
        rw [if_pos h]
        exact Nat.one_pos
    _ ≤ ∑ i ∈ Finset.range (deg v + 1), if transAt deg z v i then 1 else 0 :=
      Finset.single_le_sum (f := fun i => if transAt deg z v i then 1 else 0)
        (fun _ _ => Nat.zero_le _) hi

theorem cons_split {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n) :
    (∑ i ∈ Finset.range (deg v + 1), if ¬ transAt deg z v i then 1 else 0) +
      transCount deg z v = deg v + 1 := by
  unfold transCount
  rw [← Finset.sum_add_distrib]
  have h : ∀ i ∈ Finset.range (deg v + 1),
      ((if ¬ transAt deg z v i then 1 else 0) + (if transAt deg z v i then 1 else 0) : ℕ) =
        1 := by
    intro i _
    by_cases hi : transAt deg z v i <;> simp [hi]
  rw [Finset.sum_congr rfl h]
  simp

/-- With no transition at `v` and `z v 0 = false`, every clone of `v` is false: a true clone
would propagate around the cycle of implications to clone `0`. -/
theorem no_transition_all_false {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n)
    (hzero : z v 0 = false) (hnone : ∀ i, i < deg v + 1 → ¬ transAt deg z v i) :
    ∀ i, i < deg v + 1 → z v i = false := by
  have fwd : ∀ k i, i + k = deg v → z v i = true → z v (deg v) = true := by
    intro k
    induction k with
    | zero =>
      intro i hi h
      have hv : i = deg v := by omega
      rw [← hv]
      exact h
    | succ k ih =>
      intro i hi h
      have hne : i ≠ deg v := by omega
      have hc : cyc (deg v) i = i + 1 := by
        unfold cyc
        exact if_neg hne
      have h1 : z v (i + 1) = true := by
        cases hz : z v (i + 1) with
        | true => rfl
        | false =>
          exact absurd (⟨h, by rw [hc]; exact hz⟩ : transAt deg z v i) (hnone i (by omega))
      exact ih (i + 1) (by omega) h1
  have hlast : z v (deg v) = false := by
    cases hz : z v (deg v) with
    | false => rfl
    | true =>
      have hc : cyc (deg v) (deg v) = 0 := by
        unfold cyc
        exact if_pos rfl
      exact absurd (⟨hz, by rw [hc]; exact hzero⟩ : transAt deg z v (deg v))
        (hnone (deg v) (by omega))
  intro i hi
  cases hz : z v i with
  | false => rfl
  | true =>
    have := fwd (deg v - i) i (by omega) hz
    rw [hlast] at this
    exact absurd this (by simp)

theorem repairedSet_independent {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : Independent G (repairedSet G z) := by
  intro e he
  rcases he with ⟨hl, hr⟩
  have hlc : G.left e ∈ cleanVertices deg z := (Finset.mem_sdiff.mp hl).1
  have hrc : G.right e ∈ cleanVertices deg z := (Finset.mem_sdiff.mp hr).1
  have hdel : G.left e ∈ deletionSet G z := by
    apply Finset.mem_image.mpr
    exact ⟨e, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hlc, hrc⟩, rfl⟩
  exact (Finset.mem_sdiff.mp hl).2 hdel

theorem clean_all_false {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n)
    (hv : v ∈ cleanVertices deg z) : ∀ i, i < deg v + 1 → z v i = false := by
  have h0 := (Finset.mem_sdiff.mp hv).1
  have hT := (Finset.mem_sdiff.mp hv).2
  exact no_transition_all_false deg z v ((mem_selectedVertices z v).mp h0)
    (fun i hi h => hT ((mem_transVertices deg z v).mpr
      (transCount_pos deg z v i (Finset.mem_range.mpr hi) h)))

theorem internalEdges_subset_falseEdges {n m : ℕ} {deg : Fin n → ℕ}
    (G : GPortGraph n m deg) (z : Fin n → ℕ → Bool) :
    (Finset.univ.filter fun e =>
      G.left e ∈ cleanVertices deg z ∧ G.right e ∈ cleanVertices deg z) ⊆
        falseEdges G z := by
  intro e he
  rcases Finset.mem_filter.mp he with ⟨_, hl, hr⟩
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
    clean_all_false deg z (G.left e) hl _ (G.leftClone_lt e),
    clean_all_false deg z (G.right e) hr _ (G.rightClone_lt e)⟩

theorem score_le {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) :
    score G z ≤ ∑ v, (deg v + 1) + m + (repairedSet G z).card := by
  have htrans : (transVertices deg z).card ≤ ∑ v, transCount deg z v := by
    unfold transVertices
    rw [Finset.card_filter]
    apply Finset.sum_le_sum
    intro v _
    by_cases h : 0 < transCount deg z v
    · rw [if_pos h]
      exact h
    · rw [if_neg h]
      exact Nat.zero_le _
  have hTle : ∑ v, transCount deg z v ≤ ∑ v, (deg v + 1) := by
    apply Finset.sum_le_sum
    intro v _
    have := cons_split deg z v
    omega
  have hclean : (selectedVertices z).card ≤
      (cleanVertices deg z).card + (transVertices deg z).card := by
    unfold cleanVertices
    rw [← Finset.card_sdiff_add_card_inter (selectedVertices z) (transVertices deg z)]
    exact Nat.add_le_add_left (Finset.card_le_card Finset.inter_subset_right) _
  have hdel : (deletionSet G z).card ≤ (falseEdges G z).card := by
    calc
      (deletionSet G z).card ≤
          (Finset.univ.filter fun e =>
            G.left e ∈ cleanVertices deg z ∧ G.right e ∈ cleanVertices deg z).card :=
        Finset.card_image_le
      _ ≤ (falseEdges G z).card :=
        Finset.card_le_card (internalEdges_subset_falseEdges G z)
  have hfalseBound : (falseEdges G z).card ≤ m := by
    simpa using Finset.card_le_univ (falseEdges G z)
  have hrepair : (cleanVertices deg z).card ≤
      (repairedSet G z).card + (deletionSet G z).card := by
    unfold repairedSet
    rw [← Finset.card_sdiff_add_card_inter (cleanVertices deg z) (deletionSet G z)]
    exact Nat.add_le_add_left (Finset.card_le_card Finset.inter_subset_right) _
  unfold score
  omega

theorem score_assignmentOfIndependent {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (I : Finset (Fin n)) (hI : Independent G I) :
    score G (assignmentOfIndependent I) = ∑ v, (deg v + 1) + m + I.card := by
  have hselected : selectedVertices (assignmentOfIndependent I) = I := by
    ext v
    rw [mem_selectedVertices]
    simp [assignmentOfIndependent]
  have hT : ∑ v, transCount deg (assignmentOfIndependent I) v = 0 := by
    apply Finset.sum_eq_zero
    intro v _
    unfold transCount
    apply Finset.sum_eq_zero
    intro i _
    by_cases hv : v ∈ I <;> simp [transAt, assignmentOfIndependent, hv]
  have hfalse : falseEdges G (assignmentOfIndependent I) = ∅ := by
    unfold falseEdges
    rw [Finset.filter_eq_empty_iff]
    intro e _ h
    apply hI e
    constructor
    · by_contra hl
      have h1 := h.1
      simp [assignmentOfIndependent, hl] at h1
    · by_contra hr
      have h2 := h.2
      simp [assignmentOfIndependent, hr] at h2
  unfold score
  rw [hselected, hT, hfalse]
  simp only [Finset.card_empty, Nat.sub_zero]
  omega

theorem optimum_bound {n m alpha : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (halpha : IsIndependenceNumber G alpha) :
    (∀ z : Fin n → ℕ → Bool, score G z ≤ ∑ v, (deg v + 1) + m + alpha) ∧
      ∃ z : Fin n → ℕ → Bool, score G z = ∑ v, (deg v + 1) + m + alpha := by
  constructor
  · intro z
    calc
      score G z ≤ ∑ v, (deg v + 1) + m + (repairedSet G z).card := score_le G z
      _ ≤ ∑ v, (deg v + 1) + m + alpha :=
        Nat.add_le_add_left (halpha.1 _ (repairedSet_independent G z)) _
  · obtain ⟨I, hI, hcard⟩ := halpha.2
    exact ⟨assignmentOfIndependent I, by
      rw [score_assignmentOfIndependent G I hI, hcard]⟩

/-! ### The formula as an explicit list of clauses -/

theorem card_filter_sum_proof {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (P : α ⊕ β ⊕ γ → Prop) [DecidablePred P] :
    (Finset.univ.filter P).card =
      (Finset.univ.filter fun a => P (Sum.inl a)).card +
        (Finset.univ.filter fun b => P (Sum.inr (Sum.inl b))).card +
          (Finset.univ.filter fun c => P (Sum.inr (Sum.inr c))).card := by
  simp only [Finset.card_filter, Fintype.sum_sum_type]
  ring

theorem consClause_satisfied {n : ℕ} {deg : Fin n → ℕ} (z : Fin n → ℕ → Bool)
    (p : Σ v : Fin n, Fin (deg v + 1)) :
    Clause.satisfied z (consClause p) = true ↔ ¬ transAt deg z p.1 (p.2 : ℕ) := by
  cases ha : z p.1 (p.2 : ℕ) <;> cases hb : z p.1 (cyc (deg p.1) (p.2 : ℕ)) <;>
    simp [transAt, consClause, Clause.satisfied, Lit.eval, ha, hb]

theorem satCount_eq_score {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : satCount G z = score G z := by
  have h := card_filter_sum_proof
    (fun c : ClauseIdx m deg => Clause.satisfied z (clauseOf G c) = true)
  have hU : (Finset.univ.filter fun v : Fin n =>
      Clause.satisfied z (clauseOf G (Sum.inl v)) = true).card =
        (selectedVertices z).card := by
    apply congrArg Finset.card
    ext v
    cases ha : z v 0 <;> simp [selectedVertices, clauseOf, unitClause,
      Clause.satisfied, Lit.eval, ha]
  have hE : (Finset.univ.filter fun e : Fin m =>
      Clause.satisfied z (clauseOf G (Sum.inr (Sum.inl e))) = true).card =
        m - (falseEdges G z).card := by
    have hset : (Finset.univ.filter fun e : Fin m =>
        Clause.satisfied z (clauseOf G (Sum.inr (Sum.inl e))) = true) =
          (falseEdges G z)ᶜ := by
      ext e
      cases ha : z (G.left e) (G.leftClone e) <;>
        cases hb : z (G.right e) (G.rightClone e) <;>
          simp [falseEdges, clauseOf, edgeClause, Clause.satisfied, Lit.eval, ha, hb]
    rw [hset, Finset.card_compl]
    simp
  have hC : (Finset.univ.filter fun p : Σ v : Fin n, Fin (deg v + 1) =>
      Clause.satisfied z (clauseOf G (Sum.inr (Sum.inr p))) = true).card =
        ∑ v, ∑ i ∈ Finset.range (deg v + 1), if ¬ transAt deg z v i then 1 else 0 := by
    rw [Finset.card_filter, ← Finset.univ_sigma_univ, Finset.sum_sigma]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [Finset.sum_range]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact if_congr (consClause_satisfied (deg := deg) z ⟨v, i⟩) rfl rfl
  have hsplit : ∑ v, (∑ i ∈ Finset.range (deg v + 1), if ¬ transAt deg z v i then 1 else 0) +
      ∑ v, transCount deg z v = ∑ v, (deg v + 1) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun v _ => cons_split deg z v
  unfold satCount score
  rw [h, hU, hE, hC]
  omega

theorem optimum_identity {n m alpha : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (halpha : IsIndependenceNumber G alpha) :
    IsGreatest (Set.range (satCount G)) (∑ v, (deg v + 1) + m + alpha) := by
  obtain ⟨hle, z, hz⟩ := optimum_bound G halpha
  refine ⟨⟨z, ?_⟩, ?_⟩
  · rw [satCount_eq_score]
    exact hz
  · rintro _ ⟨w, rfl⟩
    rw [satCount_eq_score]
    exact hle w

theorem lift_satCount {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (I : Finset (Fin n)) (hI : Independent G I) :
    satCount G (assignmentOfIndependent I) = ∑ v, (deg v + 1) + m + I.card := by
  rw [satCount_eq_score]
  exact score_assignmentOfIndependent G I hI

end PalomaMax2SAT.GeneralDegreeFormula

end Inline_GeneralDegreeFormula

section Inline_PaperArithmetic
/-!
# Numerical statements of the paper

Division-free or rational arithmetic behind the statements of `paper.tex` that are not part of
another module: the comparison of `83/84` with the Unique Games thresholds (Theorem
`thm:ugc-class`), the two-branch arithmetic of Theorem `thm:ratio`, the numerical constants of
Theorem `thm:cutclass` and Proposition `prop:bounded-cut`, and the tables.
The Goemans--Williamson, Berman--Fujito and Trevisan guarantees enter only as hypotheses.
-/

namespace PalomaMax2SAT.PaperArithmetic

/-- Theorem `thm:ugc-class`: `83/84 > 0.94615981 > 0.94016567`. -/
theorem ugc_thresholds :
    (94016567 : ℚ) / 100000000 < 94615981 / 100000000 ∧
      (94615981 : ℚ) / 100000000 < 83 / 84 := by
  constructor <;> norm_num

end PalomaMax2SAT.PaperArithmetic

end Inline_PaperArithmetic


theorem solution :
    (((94016567 : ℚ) / 100000000 < 94615981 / 100000000 ∧
        (94615981 : ℚ) / 100000000 < 83 / 84) ∧
      (83 : ℚ) / 84 < 9932 / 10000) ∧
    (∀ {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) (S : Finset (Fin n)),
      PalomaMax2SAT.ConflictGraph.Ind G (PalomaMax2SAT.ConflictGraph.selSet G S) ∧
        (PalomaMax2SAT.ConflictGraph.selSet G S).card =
          m + PalomaMax2SAT.CutTransfer.cutCount G S) ∧
    (∀ {n m mc : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m),
      PalomaMax2SAT.ConflictGraph.IsMaxCut G mc →
        PalomaMax2SAT.ConflictGraph.IsIndNumber G (m + mc)) ∧
    (∀ {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) (Dmax : ℕ),
      (∀ v, PalomaMax2SAT.ConflictDegree.occ G v ≤ Dmax) →
        ∀ p : PalomaMax2SAT.ConflictGraph.Occ m,
          (PalomaMax2SAT.ConflictDegree.nbrs G p).card ≤ Dmax + 1) ∧
    (∀ {n m : ℕ} (G : PalomaMax2SAT.CutTransfer.EdgeGraph n m) (M : ℕ),
      2 * M = ∑ p : PalomaMax2SAT.ConflictGraph.Occ m,
          (PalomaMax2SAT.ConflictDegree.nbrs G p).card →
        2 * M = 4 * m + 2 * ∑ v, PalomaMax2SAT.ConflictDegree.occ G v ^ 2 ∧ 4 * m ≤ M) ∧
    (∀ m M alpha s : ℕ, 4 * m ≤ M → alpha ≤ 2 * m → 18785 * alpha ≤ 20000 * s →
      9932 * ((4 * m + 3 * M) + alpha) ≤ 10000 * ((4 * m + 3 * M) + s) ∧
        83 * ((4 * m + 3 * M) + alpha) ≤ 84 * ((4 * m + 3 * M) + s)) ∧
    (∀ {n m : ℕ} {deg : Fin n → ℕ}
      (G : PalomaMax2SAT.GeneralDegreeFormula.GPortGraph n m deg),
      ∑ v, deg v = 2 * m ∧ ∑ v, (deg v + 1) + m = n + 3 * m) ∧
    (∀ {n m alpha : ℕ} {deg : Fin n → ℕ}
      (G : PalomaMax2SAT.GeneralDegreeFormula.GPortGraph n m deg),
      PalomaMax2SAT.GeneralDegreeFormula.IsIndependenceNumber G alpha →
        IsGreatest (Set.range (PalomaMax2SAT.GeneralDegreeFormula.satCount G))
          (∑ v, (deg v + 1) + m + alpha)) ∧
    ∀ {n m alpha : ℕ} {deg : Fin n → ℕ}
      (G : PalomaMax2SAT.GeneralDegreeFormula.GPortGraph n m deg)
      (_ : PalomaMax2SAT.GeneralDegreeFormula.IsIndependenceNumber G alpha)
      (I : Finset (Fin n)) (_ : PalomaMax2SAT.GeneralDegreeFormula.Independent G I)
      (_ : 8 * alpha ≤ ∑ v, (deg v + 1) + m) (_ : 18785 * alpha ≤ 20000 * I.card),
      PalomaMax2SAT.GeneralDegreeFormula.satCount G
          (PalomaMax2SAT.GeneralDegreeFormula.assignmentOfIndependent I) =
        ∑ v, (deg v + 1) + m + I.card ∧
      9932 * (∑ v, (deg v + 1) + m + alpha) ≤
        10000 * PalomaMax2SAT.GeneralDegreeFormula.satCount G
          (PalomaMax2SAT.GeneralDegreeFormula.assignmentOfIndependent I) ∧
      83 * (∑ v, (deg v + 1) + m + alpha) ≤
        84 * PalomaMax2SAT.GeneralDegreeFormula.satCount G
          (PalomaMax2SAT.GeneralDegreeFormula.assignmentOfIndependent I) :=
  ⟨⟨PalomaMax2SAT.PaperArithmetic.ugc_thresholds, by norm_num⟩,
    fun G S =>
      ⟨PalomaMax2SAT.ConflictGraph.selSet_independent G S, by
        rw [PalomaMax2SAT.ConflictGraph.card_selSet,
          PalomaMax2SAT.CutTransfer.value_eq_edges_add_cut]⟩,
    fun G h => PalomaMax2SAT.ConflictGraph.alpha_eq G h,
    fun G Dmax hD p => PalomaMax2SAT.BoundedLemmas.nbrs_le G Dmax hD p,
    fun G M hM => PalomaMax2SAT.BoundedLemmas.edges_ge G M hM,
    fun m M alpha s hM ha hs => PalomaMax2SAT.BoundedLemmas.ratio_nonregular m M alpha s hM ha hs,
    fun G => ⟨PalomaMax2SAT.GeneralDegreeFormula.sum_deg_eq G,
      PalomaMax2SAT.GeneralDegreeFormula.constant_eq G⟩,
    fun G halpha => PalomaMax2SAT.GeneralDegreeFormula.optimum_identity G halpha,
    fun G halpha I hI hB hs => by
      have hlift := PalomaMax2SAT.GeneralDegreeFormula.lift_satCount G I hI
      refine ⟨hlift, ?_, ?_⟩ <;> rw [hlift] <;> omega⟩
