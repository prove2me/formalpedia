    rw [hs2]; simp (config := {decide := true}) [NLogN.Rsp.jSt]
  have g2L' : (s2.upd NLogN.Rsp.CU RU).G NLogN.Rsp.JL = .int ((2 * s : ℕ) : ℤ) :: LL := by
