  have hxsq : x⁻¹ ^ 2 = (x ^ 2)⁻¹ := by rw [inv_pow]
  calc (Real.sin (π * x) / π) ^ 2 * x⁻¹ ^ 2
      ≤ 1 * x⁻¹ ^ 2 := by
        apply mul_le_mul_of_nonneg_right hsin (by positivity)
    _ = (x ^ 2)⁻¹ := by rw [one_mul, hxsq]
