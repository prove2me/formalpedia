private theorem lowerUnipotent21_mem_localMaximalCompact3 (v : HeightOneSpectrum (𝓞 ℚ)) {y : v.adicCompletion ℚ}
    (hy : Valued.v y ≤ 1) : lowerUnipotent21 y ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩ <;> fin_cases i <;> fin_cases j <;> simp [lowerUnipotent21, hy]

variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)
  (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)

private def xLine (x : AdeleRing (𝓞 ℚ) ℚ) : ℂ :=
  dualWhittakerFn3 (adelicProduct Warch Wloc)
    (iotaGL (diagUnitGL2 a) * lowerUnipotent21 x * (weylPrime3 * transposeInv3 g))

private def xLineArch (z : InfiniteAdeleRing ℚ) : ℂ :=
  dualWhittakerFn3 Warch
    (iotaGL (diagUnitGL2 (unitsAtInfinity a)) * lowerUnipotent21 z *
      (weylPrime3 * transposeInv3 (archComponent3 (𝓞 ℚ) ℚ g)))

private def xLineAt (v : HeightOneSpectrum (𝓞 ℚ)) (y : v.adicCompletion ℚ) : ℂ :=
  dualWhittakerFn3 (Wloc v)
    (iotaGL (diagUnitGL2 (unitsAt v a)) * lowerUnipotent21 y *
      (weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g)))

private theorem xLine_eq (x : AdeleRing (𝓞 ℚ) ℚ) :
    xLine Warch Wloc a g x =
      xLineArch Warch a g x.1 * ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), xLineAt Wloc a g v (x.2 v) := by
  have hA : archComponent3 (𝓞 ℚ) ℚ weylPrime3 * archComponent3 (𝓞 ℚ) ℚ (transposeInv3 g) =
      weylPrime3 * transposeInv3 (archComponent3 (𝓞 ℚ) ℚ g) := by
    rw [← map_mul, archComponent3_weylPrime3_mul_transposeInv3]
  have hV : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      componentAt3 (𝓞 ℚ) ℚ v weylPrime3 * componentAt3 (𝓞 ℚ) ℚ v (transposeInv3 g) =
        weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g) := fun v => by
    rw [← map_mul, componentAt3_weylPrime3_mul_transposeInv3]
  simp only [xLine, xLineArch, xLineAt, dualWhittakerFn3_adelicProduct_apply, map_mul,
    archComponent3_iotaGL_diagUnitGL2, componentAt3_iotaGL_diagUnitGL2, archComponent3_lowerUnipotent21,
    componentAt3_lowerUnipotent21,
    hA, hV]

variable {a g} (S : Finset (HeightOneSpectrum (𝓞 ℚ)))

private theorem xLineAt_eq_one
    (hU : ∀ v ∉ S, IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (h1 : ∀ v ∉ S, dualWhittakerFn3 (Wloc v) 1 = 1) (ha : ∀ v ∉ S, IsIntegralUnit v (unitsAt v a))
    (hg : ∀ v ∉ S, componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    ∀ v ∉ S, ∀ y : v.adicCompletion ℚ, y ∈ v.adicCompletionIntegers ℚ → xLineAt Wloc a g v y = 1 := by
  intro v hv y hy
  have hk : iotaGL (diagUnitGL2 (unitsAt v a)) * lowerUnipotent21 y *
      (weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g)) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
    mul_mem (mul_mem (iotaGL_diagUnitGL2_mem_localMaximalCompact3 v (ha v hv))
        (lowerUnipotent21_mem_localMaximalCompact3 v ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp hy)))
      (weylPrime3_mul_transposeInv3_mem_localMaximalCompact3 (hg v hv))
  have h := hU v hv 1 _ hk
  rw [one_mul] at h
  rw [xLineAt, h, h1 v hv]

private theorem xLineAt_eq_zero {ψ : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ}
    (hW : ∀ v ∉ S, IsGL3PsiWhittakerFn (ψ v) (dualWhittakerFn3 (Wloc v)))
    (hU : ∀ v ∉ S, IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (hψ : ∀ v ∉ S, ∀ y₀ : v.adicCompletion ℚ, y₀ ∉ v.adicCompletionIntegers ℚ →
      ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψ v y ≠ 1)
    (hg : ∀ v ∉ S, componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    ∀ v ∉ S, ∀ y₀ : v.adicCompletion ℚ, y₀ ∉ v.adicCompletionIntegers ℚ → xLineAt Wloc a g v y₀ = 0 := by
  intro v hv y₀ hy₀
  have hne : y₀ ≠ 0 := fun h => hy₀ (by rw [h]; exact zero_mem _)
  obtain ⟨y, hyv, hy⟩ := hψ v hv y₀ hy₀
  have hyv' : Valued.v (y * (((Units.mk0 y₀ hne)⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) ≤ 1 := by
    rwa [Units.val_inv_eq_inv_val, Units.val_mk0]
  have h := apply_iotaGL_diagUnitGL2_mul_lowerUnipotent21_mul_eq_zero (hW v hv) (hU v hv) (unitsAt v a)
    (Units.mk0 y₀ hne) hyv' hy (weylPrime3_mul_transposeInv3_mem_localMaximalCompact3 (hg v hv))
  rw [Units.val_mk0] at h
  exact h

