variable (F : Type) [Field F] [NumberField F]

private theorem isAdmissibleTwist_mul {μ ν : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} (hμ : IsAdmissibleTwist F μ)
    (hν : IsAdmissibleTwist F ν) : IsAdmissibleTwist F (μ * ν) := by
  obtain ⟨hμ1, hμc, hμu⟩ := hμ
  obtain ⟨hν1, hνc, hνu⟩ := hν
  refine ⟨fun u => ?_, ?_, fun x => ?_⟩
  · rw [MonoidHom.mul_apply, hμ1 u, hν1 u, one_mul]
  · show Continuous fun x => μ x * ν x
    exact hμc.mul hνc
  · rw [MonoidHom.mul_apply, Units.val_mul, norm_mul, hμu x, hνu x, one_mul]

private theorem isAdmissibleTwist_inv {μ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} (hμ : IsAdmissibleTwist F μ) :
    IsAdmissibleTwist F μ⁻¹ := by
  obtain ⟨hμ1, hμc, hμu⟩ := hμ
  refine ⟨fun u => ?_, ?_, fun x => ?_⟩
  · rw [MonoidHom.inv_apply, hμ1 u, inv_one]
  · show Continuous fun x => (μ x)⁻¹
    exact hμc.inv
  · rw [MonoidHom.inv_apply, Units.val_inv_eq_inv_val, norm_inv, hμu x, inv_one]

end

variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem isAdmissibleTwist_comp_idelicNorm {χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ} (hχ : IsAdmissibleTwist ℚ χ)
    (hprin : ∀ u : Kˣ, ∃ q : ℚˣ,
      (genuineBaseChange ℚ K).idelicNorm (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) u) =
        Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)) q)
    (hcont : Continuous (genuineBaseChange ℚ K).idelicNorm) :
    IsAdmissibleTwist K (χ.comp (genuineBaseChange ℚ K).idelicNorm) := by
  obtain ⟨hχ1, hχc, hχu⟩ := hχ
  refine ⟨fun u => ?_, ?_, fun x => ?_⟩
  · obtain ⟨q, hq⟩ := hprin u
    rw [MonoidHom.comp_apply, hq, hχ1 q]
  · rw [MonoidHom.coe_comp]
    exact hχc.comp hcont
  · rw [MonoidHom.comp_apply, hχu]

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem isAdmissibleTwist_mul_comp_idelicNorm {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    {χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ} (hμ : IsAdmissibleTwist K μ) (hχ : IsAdmissibleTwist ℚ χ)
    (hprin : ∀ u : Kˣ, ∃ q : ℚˣ,
      (genuineBaseChange ℚ K).idelicNorm (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) u) =
        Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)) q)
    (hcont : Continuous (genuineBaseChange ℚ K).idelicNorm) :
    IsAdmissibleTwist K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) :=
  isAdmissibleTwist_mul K hμ (isAdmissibleTwist_comp_idelicNorm K hχ hprin hcont)

