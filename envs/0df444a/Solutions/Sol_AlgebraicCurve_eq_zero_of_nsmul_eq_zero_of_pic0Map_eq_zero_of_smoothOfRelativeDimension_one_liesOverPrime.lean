      refine ⟨DP, by rw [hDP, Equiv.apply_symm_apply], ?_⟩
      show ptsk (r (Pic0.mk DP)) = redk (ext (ptsQ (Pic0.mk DP)))

      let wP : SchemeHomOver sO f := ⟨PtP.1 ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) ≫ aj.1, by
        rw [Category.assoc, Category.assoc, Category.assoc, aj.2, hcond₀, ← Category.assoc (e₀),
