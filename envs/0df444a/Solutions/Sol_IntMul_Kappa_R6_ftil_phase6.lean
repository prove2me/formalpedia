    ∃ (ys : List GI) (c : ℕ),
      IRuns Isym iprog (callW (cpyD zCh (bX dS) 2 5) (bX dS) (bY dS) dS (g eC)) t
        (t.upd 0 (ints (gflat ys) ++ R0)) c ∧
