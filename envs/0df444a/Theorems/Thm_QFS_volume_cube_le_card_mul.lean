section Favoured

variable {Γ : Configuration (EuclideanSpace ℝ (Fin d))} {θ : ℝ}

theorem QFS.volume_cube_le_card_mul (F : RefFamily Γ θ) {h : ℝ}
    {u v : EuclideanSpace ℝ (Fin d)} (hv : IsFavoured F h u v) :
    volume (cube h u) ≤ F.axes.card * volume (cubeCone Γ (F.cone v) h u) := by sorry
