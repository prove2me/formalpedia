/-! ## The equal-volume shell peeling of a ball -/


lemma shellRadius_nonneg {R : ℝ} (hR : 0 ≤ R) (d N k : ℕ) : 0 ≤ shellRadius R d N k :=
  mul_nonneg hR (Real.rpow_nonneg (le_max_left _ _) _)


@[simp] lemma shellRadius_zero {R : ℝ} (d N : ℕ) :
    shellRadius R d N 0 = R := by
  simp [shellRadius]

lemma shellRadius_last {R : ℝ} (d N : ℕ) (hN : 0 < N) (hd : 0 < d) :
    shellRadius R d N N = 0 := by
  have hNR : (0 : ℝ) < N := by exact_mod_cast hN
  have hd' : ((d : ℝ)⁻¹) ≠ 0 := by
    have : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  simp [shellRadius, div_self hNR.ne', Real.zero_rpow hd']









/-! ## Rigidity of ball peelings -/







open Catalog.Geometry.Peel in
theorem solution(d N : ℕ) (hd : 0 < d) (hN : 0 < N) {R : ℝ} (hR : 0 < R)
    {c : ℝ} (hc : c < 1) :
    ∃ r : ℕ → ℝ, Antitone r ∧ (∀ k, 0 ≤ r k) ∧ r 0 = R ∧ r N = 0 ∧
      ∀ k < N, ¬ (ballVol d (r k) - ballVol d (r (k + 1)) ≤ c * (ballVol d R / N)) := by
  refine ⟨shellRadius R d N, shellRadius_anti hR.le d N, shellRadius_nonneg hR.le d N,
    shellRadius_zero d N, shellRadius_last d N hN hd, ?_⟩
  intro k hk hcon
  have hgap : ballVol d (shellRadius R d N k) - ballVol d (shellRadius R d N (k + 1))
      = ballVol d R / N := by
    rw [← shellPeel_size d N k hd hR.le, ← shellPeel_size d N (k + 1) hd hR.le]
    exact shellPeel_gap d N k hN hk
  rw [hgap] at hcon
  have hvolpos : 0 < ballVol d R := by
    rw [ballVol_eq d hd hR.le]
    have := ballVol_one_pos d
    positivity
  have hNR : (0 : ℝ) < N := by exact_mod_cast hN
  have : 0 < ballVol d R / N := div_pos hvolpos hNR
  nlinarith
