theorem main [Module.Finite ℤ_[2] T] [IsReduced ↥(rationalHeckeAlgebra 2 J)]
    (b : Module.Basis (Fin 2) ↥(rationalHeckeAlgebra 2 J) V)
    (cyc : ℕ → G → ℕ → Prop)
    (C : AddSubgroup J)
    (hC : ∀ (k : ℕ) (n : G → ℕ), (∀ σ, cyc k σ (n σ)) → ∀ σ ∈ I, ∀ c ∈ C, 2 ^ k • c = 0 → σ • c = n σ • c)
    (hDC : ∀ σ ∈ I, ∀ M : ℕ, ∀ x ∈ E M, σ • x - x ∈ C)
    (hexp : ∀ k, ∃ n : G → ℕ, ∀ σ, cyc k σ (n σ))
    {σ₀ : G} (hσ₀ : σ₀ ∈ I) (h3 : ∀ k, 2 ≤ k → ∀ m, cyc k σ₀ m → m % 4 = 3)
    (Bf : T →ₗ[ℤ_[2]] T →ₗ[ℤ_[2]] ℤ_[2])
    (hBl : ∀ x, (∀ y, Bf x y = 0) → x = 0)
    (hBt : ∀ (t : HeckeAlg) (x y : T), Bf (tateHeckeRep 2 J t x) y = Bf x (tateHeckeRep 2 J t y))
    (hGal : ∀ (σ : G) (k nk : ℕ), cyc k σ nk → ∀ x y : T,
