  | skip, s, j, _ => rfl
  | asg i e, s, j, h | push i e, s, j, h | pop i, s, j, h => by
    simp only [NLogN.RS.writes, List.mem_singleton] at h; simp [NLogN.RS.run, IState.upd_G, h]
  | seq a b, s, j, h => by
