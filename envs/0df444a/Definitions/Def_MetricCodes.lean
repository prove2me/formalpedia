      (∏ q ∈ Finset.range (2 * r + 2 - (r + j + 2)),
        (n + z + (r : ℝ) - 1 - ((r + j + 2 + q : ℕ) : ℝ)))) =
      ((∏ q ∈ Finset.range (r - j),
          (z + (r : ℝ) - (q : ℝ))) *
        (∏ q ∈ Finset.range (r - j),
          (n + z - (r : ℝ) - 2 + (q : ℝ)))) *
      ((∏ q ∈ Finset.range (2 * j + 2),
          (n + z + (j : ℝ) - 1 - (q : ℝ))) -
        (∏ q ∈ Finset.range (2 * j + 2),
          (z + (j : ℝ) - (q : ℝ)))) := by
