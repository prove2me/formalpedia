/-! # Partial derivatives: locality, genuine-derivative and smoothness lemmas

Reusable facts about `pd`, `christoffel`, `ricci`:
* locality: they only depend on the fields on an open neighbourhood (`*_congr_of_eqOn`);
* no junk values: on an open set where the fields are `C^∞`, every slice used by `pd` is
  differentiable and `pd` is its true derivative (`hasDerivAt_pd`);
* smoothness propagates: `pd` and `christoffel` of `C^∞` fields are `C^∞` (`contDiffOn_*`).
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

/-- `pd` is local: functions that agree on an open set have the same `pd` there. -/
theorem pd_congr_of_eqOn {f h : Pt n → ℝ} {V : Set (Pt n)} (hV : IsOpen V) {x : Pt n}
    (hx : x ∈ V) (hfh : Set.EqOn f h V) (i : Fin n) : pd i f x = pd i h x := by
  unfold pd
  apply Filter.EventuallyEq.deriv_eq
  filter_upwards [eventually_update_mem hV hx i] with u hu
  exact hfh hu

theorem christoffel_congr_of_eqOn {g g' ginv ginv' : Metric n} {V : Set (Pt n)} (hV : IsOpen V)
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V) (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V)
    (a b c : Fin n) : Set.EqOn (christoffel g ginv a b c) (christoffel g' ginv' a b c) V := by
  intro x hx
  unfold christoffel
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hgi a k hx, pd_congr_of_eqOn hV hx (hg k b) c, pd_congr_of_eqOn hV hx (hg k c) b,
    pd_congr_of_eqOn hV hx (hg b c) k]

theorem ricci_congr_of_eqOn {Γ Γ' : Fin n → Fin n → Fin n → Pt n → ℝ} {V : Set (Pt n)}
    (hV : IsOpen V) (hΓ : ∀ a b c, Set.EqOn (Γ a b c) (Γ' a b c) V) {x : Pt n} (hx : x ∈ V)
    (b d : Fin n) : ricci Γ b d x = ricci Γ' b d x := by
  unfold ricci
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [pd_congr_of_eqOn hV hx (hΓ i b d) i, pd_congr_of_eqOn hV hx (hΓ i b i) d]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hΓ i i j hx, hΓ j b d hx, hΓ i d j hx, hΓ j b i hx]

/-- The coordinate Ricci tensor only depends on `g` and `ginv` near the point. -/
theorem ricciOf_congr_of_eqOn {g g' ginv ginv' : Metric n} {V : Set (Pt n)} (hV : IsOpen V)
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V) (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V)
    {x : Pt n} (hx : x ∈ V) (b d : Fin n) : ricciOf g ginv b d x = ricciOf g' ginv' b d x :=
  ricci_congr_of_eqOn hV (christoffel_congr_of_eqOn hV hg hgi) hx b d

end ExactVacuumAtlas

