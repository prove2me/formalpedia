-- title:
--   §II–III, pp. 4–8 — stationary points of (2), Assumption 1 (A1)–(A4), SUM runs (3) and the level set 𝒳⁰
-- statement:
--   This module fixes the objects of the single-block analysis of Razaviyayn, Hong and Luo (§III). Throughout, $\mathcal X\subseteq\mathbb R^m$ is the feasible set of the problem
--   $$
--   \min_{x}\ f(x)\quad\text{s.t.}\quad x\in\mathcal X, \tag{2}
--   $$
--   and $f:\mathbb R^m\to\mathbb R$; on the page $\mathcal X$ is closed and convex and $\operatorname{dom} f=\mathcal X$. The directional derivative of a function $h$ at $x$ in direction $d$ is the extended-real lower limit
--   $$
--   h'(x;d)=\liminf_{\lambda\downarrow 0}\frac{h(x+\lambda d)-h(x)}{\lambda}.
--   $$
--
--   1. **Stationary point.** A point $z$ is a stationary point of (2) if $z\in\mathcal X$ and $f'(z;d)\ge 0$ for every $d$ with $z+d\in\mathcal X$. The set of stationary points is denoted $\mathcal X^*$.
--   2. **Assumption 1.** An approximation function $u:\mathbb R^m\times\mathbb R^m\to\mathbb R$ satisfies
--      - (A1) $u(y,y)=f(y)$ for all $y\in\mathcal X$;
--      - (A2) $u(x,y)\ge f(x)$ for all $x,y\in\mathcal X$;
--      - (A3) $u'(x,y;d)\big|_{x=y}=f'(y;d)$ for all $y\in\mathcal X$ and all $d$ with $y+d\in\mathcal X$, where $u'(x,y;d)$ is the directional derivative of $x\mapsto u(x,y)$;
--      - (A4) $u$ is continuous on $\mathcal X\times\mathcal X$.
--   3. **SUM run.** A sequence $x^0,x^1,x^2,\dots$ is generated by the Successive Upper-bound Minimization (SUM) algorithm if $x^0\in\mathcal X$ and, for every $r\ge 0$,
--      $$
--      x^{r+1}\in\arg\min_{x\in\mathcal X} u(x,x^r),
--      $$
--      that is, $x^{r+1}\in\mathcal X$ and $u(x^{r+1},x^r)\le u(y,x^r)$ for all $y\in\mathcal X$. The minimiser is an arbitrary element of the argmin; its existence is not assumed.
--   4. **Level set.** $\mathcal X^0=\{x\in\mathcal X\mid f(x)\le f(x^0)\}$.
--
--   These objects are shared by Theorem 1, its proof steps (10)–(11) and the first-order condition at a limit point, Corollary 1 and Proposition 1.
--
--   **Formalization Note** The space is `EuclideanSpace ℝ (Fin m)`, so the distance is the 2-norm distance of p. 4. The directional derivative is the published `TsengBCD.Stationary.dirDeriv`, a liminf in `EReal`, so it may be $\pm\infty$ and is never a junk real value. The page's $f:\mathcal X\to\mathbb R$ with $\operatorname{dom} f=\mathcal X$ is encoded as a real function on all of $\mathbb R^m$; only feasible directions are tested, and on a convex $\mathcal X$ the difference quotients for such directions only use values of $f$ on $\mathcal X$. The level set is intersected with $\mathcal X$, which is what $\{x\mid f(x)\le f(x^0)\}$ means when $\operatorname{dom} f=\mathcal X$. The page states (A4) as "continuous in $(x,y)$" without a domain; it is read on $\mathcal X\times\mathcal X$, the only place $u$ is evaluated. (A3) is required only at points $y\in\mathcal X$, where the page defines $u$ and $f$.
-- source:
--   Razaviyayn, Hong & Luo, arXiv:1209.2385v1, pp. 4–8, §II (directional derivative, stationary points), §III (2), (3), Fig. 1, Assumption 1 (A1)–(A4), Corollary 1 (level set 𝒳⁰)

import Mathlib
import Definitions.Def_TsengBCD_Stationary_Setting

namespace BSUMConv.SUM

open TsengBCD.Stationary

/-- Stationary point of problem (2), §II, p. 4 (Razaviyayn, Hong & Luo, arXiv:1209.2385v1):
`z ∈ 𝒳` and `f′(z; d) ≥ 0` for every `d` with `z + d ∈ 𝒳`, where
`f′(z; d) = liminf_{λ ↓ 0} (f(z + λd) − f(z))/λ` is the extended-real lower directional derivative
`TsengBCD.Stationary.dirDeriv`. The paper takes `f : 𝒳 → ℝ` ("dom f = 𝒳", p. 5); here `f` is a real
function on all of `ℝ^m` and only feasible directions are tested, so only values of `f` on `𝒳` matter
when `𝒳` is convex. -/
def IsStationaryOn {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (z : EuclideanSpace ℝ (Fin m)) : Prop :=
  z ∈ Xset ∧ ∀ d : EuclideanSpace ℝ (Fin m), z + d ∈ Xset →
    0 ≤ dirDeriv (fun x => (f x : EReal)) z d

/-- `𝒳*`, the set of stationary points of problem (2) (§II, p. 4). -/
def stationarySet {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ) : Set (EuclideanSpace ℝ (Fin m)) :=
  {z | IsStationaryOn Xset f z}

/-- (A1), p. 6: `u(y, y) = f(y)` for all `y ∈ 𝒳`. -/
def AssumptionA1 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ)
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ) : Prop :=
  ∀ y ∈ Xset, u y y = f y

/-- (A2), p. 6: `u(x, y) ≥ f(x)` for all `x, y ∈ 𝒳`. -/
def AssumptionA2 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ)
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ) : Prop :=
  ∀ x ∈ Xset, ∀ y ∈ Xset, f x ≤ u x y

/-- (A3), p. 6: `u′(x, y; d)|_{x = y} = f′(y; d)` for all `d` with `y + d ∈ 𝒳`, the directional
derivative of `u` being taken in its first argument only. Stated for `y ∈ 𝒳`, the only points at which
`u` and `f` are defined on the page. -/
def AssumptionA3 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ)
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ) : Prop :=
  ∀ y ∈ Xset, ∀ d : EuclideanSpace ℝ (Fin m), y + d ∈ Xset →
    dirDeriv (fun x => (u x y : EReal)) y d = dirDeriv (fun x => (f x : EReal)) y d

/-- (A4), p. 6: `u(x, y)` is continuous in `(x, y)`, read on `𝒳 × 𝒳`, the domain on which `u` is used. -/
def AssumptionA4 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ) : Prop :=
  ContinuousOn (Function.uncurry u) (Xset ×ˢ Xset)

/-- Assumption 1, p. 6: (A1)–(A4). -/
def Assumption1 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ)
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ) : Prop :=
  AssumptionA1 Xset f u ∧ AssumptionA2 Xset f u ∧ AssumptionA3 Xset f u ∧ AssumptionA4 Xset u

/-- A run of the SUM algorithm (3), Fig. 1, p. 5: `x⁰ ∈ 𝒳`, and for every `r` the iterate `x^{r+1}`
is an (arbitrary) element of `argmin_{x ∈ 𝒳} u(x, x^r)`. Existence of a minimiser is not assumed. -/
def IsSUMRun {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin m)) : Prop :=
  x 0 ∈ Xset ∧ ∀ r : ℕ, x (r + 1) ∈ Xset ∧ ∀ y ∈ Xset, u (x (r + 1)) (x r) ≤ u y (x r)

/-- The level set `𝒳⁰ = {x | f(x) ≤ f(x⁰)}` of Corollary 1, p. 8. Since the page assumes
`dom f = 𝒳` (p. 5), the level set lies in `𝒳`. -/
def levelSet0 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (x0 : EuclideanSpace ℝ (Fin m)) :
    Set (EuclideanSpace ℝ (Fin m)) :=
  {x | x ∈ Xset ∧ f x ≤ f x0}

end BSUMConv.SUM


