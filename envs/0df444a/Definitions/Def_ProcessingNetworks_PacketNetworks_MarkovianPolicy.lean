-- title:
--   Admissible and stable Markovian control policies (Definition 12.3)
-- statement:
--   **Section 12.1, primitives.** `PacketPrimitives` collects the model's stochastic primitives and
--   the control: the per-timeslot external arrival vectors $E(\tau) - E(\tau-1)$ (`Eincr τ`, so that
--   $E(\tau) = \sum_{\ell\le\tau}$ `Eincr ℓ` is the cumulative arrival process `Ecum`), the
--   randomization variables $U(\tau)$, and the Markovian policy function $f$ of (12.8),
--   $s(\tau) = f(Z(\tau-1), U(\tau))$. `PrimitiveAssumptions P lam` records the chapter's standing
--   assumptions: the class-level external arrival counts in successive timeslots form mutually
--   independent i.i.d. sequences with means $\lambda_1,\dots,\lambda_I$ (the arrival vectors are
--   i.i.d. and the class components of one of them are mutually independent), the mild assumption
--   (12.1) $P\{E(1)=0\}>0$, the $U(\tau)$ are i.i.d. uniform on $(0,1)$ and independent of the
--   arrival process, and $f$ is measurable in its randomization argument.
--
--   **Packet count process.** `policyState dat P z τ ω` is $Z(\tau)$ from $Z(0)=z$ under the
--   recursion (12.7)–(12.8), $Z(\tau) = Z(\tau-1) + [E(\tau)-E(\tau-1)] - R\,f(Z(\tau-1),U(\tau))$;
--   `policySched` is the schedule $s(\tau)$ so employed. `IsPolicyChain dat P jump` says `jump` is
--   the one-step transition kernel of this DTMC: from state $z$ the chain moves to $y$ with
--   probability $\int_0^1 P\{E(1) = y - z + R f(z,u)\}\,du$.
--
--   **Definition 12.3.** A Markovian control policy $f:\mathbb Z^I_+\times[0,1]\to S$ is
--   **admissible** if $Bf(z,u)\le z$ for all $z\in\mathbb Z^I_+$ and $u\in(0,1)$. An admissible
--   policy is **stable** if the associated Markov chain $Z$ is irreducible and positive recurrent.
--
--   **Formalization note.** The chain of Definition 12.3 is the DTMC generated by $f$ from the
--   arrival process and $U$, so `IsStableMarkovianPolicy` ties `jump` to $f$ and the primitives
--   through `IsPolicyChain` rather than taking an unrelated kernel; and $f$ takes its values in the
--   schedule set $S$, as the book's $f:\mathbb Z^I_+\times[0,1]\to S$ says. Both matter for
--   Theorem 12.8, which is false for a policy free to use schedules outside $S$ or for a kernel
--   unrelated to the network. Counts are integer valued; under an admissible policy they stay
--   nonnegative, and `Int.toNat` returns them to $\mathbb Z^I_+$ when fed to $f$.
-- source:
--   Dai & Harrison, Processing Networks: Fluid Models and Stability, pre-publication draft 2020-4-2, p. 228, Definition 12.3

import Mathlib
import Definitions.Def_ProcessingNetworks_PacketNetworks_PacketNetworkModel
import Definitions.Def_ProcessingNetworks_PacketNetworks_AmbientChain

namespace ProcessingNetworks.PacketNetworks

open MeasureTheory ProbabilityTheory
open scoped ENNReal

/-- The primitive stochastic elements of the slotted-time model together with the control
policy (Section 12.1): `Eincr τ ω i` is the number of class-`i` packets arriving from outside
during timeslot `τ ≥ 1` (so the cumulative arrival process is `E(τ) = ∑_{ℓ ≤ τ} Eincr ℓ`), `U τ ω`
is the randomization variable `U(τ)` of timeslot `τ ≥ 1` in (12.8), and `f` is the Markovian
policy function of (12.8), `s(τ) = f(Z(τ−1), U(τ))`. Index `0` of `Eincr` and `U` is unused. -/
structure PacketPrimitives (I J : ℕ) (Ω : Type*) where
  f : (Fin I → ℕ) → ℝ → (Fin J → ℕ)
  Eincr : ℕ → Ω → Fin I → ℕ
  U : ℕ → Ω → ℝ

/-- The standing stochastic assumptions of Section 12.1 on the primitives, for the arrival rate
vector `lam`: the per-timeslot arrival vectors `Eincr 1, Eincr 2, …` are i.i.d., the class
components of one of them are mutually independent (so the class-level arrival sequences are
mutually independent i.i.d. sequences), class `i` arrivals have mean `λᵢ`, the mild assumption
(12.1) `P{E(1) = 0} > 0` holds, the randomization variables `U(1), U(2), …` are i.i.d. uniform on
`(0,1)` and independent of the arrival process, and the policy function is measurable in its
randomization argument (so that `Z` is a Markov chain with the kernel `IsPolicyChain` states). -/
structure PrimitiveAssumptions {I J : ℕ} {Ω : Type*} [MeasureSpace Ω]
    (P : PacketPrimitives I J Ω) (lam : Fin I → ℝ) : Prop where
  arrivals_indep : iIndepFun (fun τ : ℕ => P.Eincr (τ + 1)) ℙ
  arrivals_ident : ∀ τ : ℕ, IdentDistrib (P.Eincr (τ + 1)) (P.Eincr 1) ℙ ℙ
  classes_indep : iIndepFun (fun (i : Fin I) (ω : Ω) => P.Eincr 1 ω i) ℙ
  arrival_mean : ∀ i, ℙ[fun ω => (P.Eincr 1 ω i : ℝ)] = lam i
  arrival_zero : 0 < ℙ {ω | P.Eincr 1 ω = 0}
  uniform : ∀ τ : ℕ, Measure.map (P.U (τ + 1)) ℙ = volume.restrict (Set.Ioo (0 : ℝ) 1)
  uniform_indep : iIndepFun (fun τ : ℕ => P.U (τ + 1)) ℙ
  arrivals_uniform_indep :
    Indep (⨆ τ : ℕ, MeasurableSpace.comap (P.Eincr (τ + 1)) inferInstance)
      (⨆ τ : ℕ, MeasurableSpace.comap (P.U (τ + 1)) inferInstance) ℙ
  policy_measurable : ∀ z, Measurable (P.f z)

/-- The cumulative external arrival process `E(τ) = ∑_{ℓ=1}^{τ} Eincr ℓ` (Section 12.1; `E(0) = 0`). -/
def Ecum {I J : ℕ} {Ω : Type*} (P : PacketPrimitives I J Ω) (τ : ℕ) (ω : Ω) : Fin I → ℕ :=
  fun i => ∑ ℓ ∈ Finset.Icc 1 τ, P.Eincr ℓ ω i

/-- The class-level packet count process `Zᶻ(τ)` under the Markovian policy `f` from initial
counts `z`, defined by the recursion (12.7)–(12.8): `Z(0) = z` and
`Z(τ) = Z(τ−1) + [E(τ) − E(τ−1)] − R f(Z(τ−1), U(τ))`. The counts are integer valued; under an
admissible policy they stay nonnegative, and `Int.toNat` feeds them back to `f`. -/
def policyState {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J) (P : PacketPrimitives I J Ω)
    (z : Fin I → ℕ) : ℕ → Ω → Fin I → ℤ
  | 0, _ => fun i => (z i : ℤ)
  | τ + 1, ω =>
      nextState dat (policyState dat P z τ ω) (P.Eincr (τ + 1) ω)
        (P.f (fun i => (policyState dat P z τ ω i).toNat) (P.U (τ + 1) ω))

/-- The schedule `s(τ) = f(Z(τ−1), U(τ))` employed in timeslot `τ ≥ 1` (Eq. 12.8) under policy
`f` from initial counts `z`. -/
def policySched {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J) (P : PacketPrimitives I J Ω)
    (z : Fin I → ℕ) (τ : ℕ) (ω : Ω) : Fin J → ℕ :=
  P.f (fun i => (policyState dat P z (τ - 1) ω i).toNat) (P.U τ ω)

/-- `jump` is the one-step transition kernel of the DTMC `Z` under policy `f` (Section 12.1,
"Under such a Markovian control policy `f`, … `Z` is a discrete-time Markov chain"): from state
`z`, the randomization variable `U(τ)` is uniform on `(0,1)` and the arrival vector of the timeslot
is an independent copy of `E(1)`, so the probability of moving to `y` is
`∫₀¹ P{E(1) = y − z + R f(z,u)} du`. -/
def IsPolicyChain {I J : ℕ} {Ω : Type*} [MeasureSpace Ω] (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (jump : (Fin I → ℕ) → PMF (Fin I → ℕ)) : Prop :=
  ∀ z y : Fin I → ℕ, jump z y =
    ∫⁻ u in Set.Ioo (0 : ℝ) 1, ∑' e : Fin I → ℕ,
      (if (fun i => (y i : ℤ)) = nextState dat (fun i => (z i : ℤ)) e (P.f z u) then
        ℙ {ω | P.Eincr 1 ω = e} else 0)

/-- Definition 12.3, first sentence, Dai & Harrison p. 228 (PDF p. 244): a Markovian control
policy `f : Z^I_+ × [0,1] → S` (Eq. 12.8; `f` takes its values in the schedule set `S`) is
admissible if it never schedules more departures from a buffer than the buffer holds,
`B f(z,u) ≤ z` (the packet availability constraint (12.3)), for every state `z ∈ Z^I_+` and every
`u ∈ (0,1)`. -/
def IsAdmissibleMarkovianPolicy {I J : ℕ} (dat : PacketNetworkData I J) (S : Finset (Fin J → ℕ))
    (f : (Fin I → ℕ) → ℝ → (Fin J → ℕ)) : Prop :=
  ∀ z : Fin I → ℕ, ∀ uu : ℝ, 0 < uu → uu < 1 →
    f z uu ∈ S ∧ ∀ i, (B dat).mulVec (fun j => (f z uu j : ℝ)) i ≤ z i

/-- Definition 12.3, second sentence: an admissible Markovian policy `f` is stable if the
associated Markov chain `Z` — the DTMC generated by (12.7)–(12.8) from the primitives `P`, whose
one-step kernel is `jump` — is irreducible and positive recurrent. -/
def IsStableMarkovianPolicy {I J : ℕ} {Ω : Type*} [MeasureSpace Ω] (dat : PacketNetworkData I J)
    (S : Finset (Fin J → ℕ)) (P : PacketPrimitives I J Ω)
    (jump : (Fin I → ℕ) → PMF (Fin I → ℕ)) : Prop :=
  IsAdmissibleMarkovianPolicy dat S P.f ∧ IsPolicyChain dat P jump ∧
    Irreducible jump ∧ PositiveRecurrent jump

end ProcessingNetworks.PacketNetworks


