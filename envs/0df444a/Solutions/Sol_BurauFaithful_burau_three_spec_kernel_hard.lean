/-
`BurauFaithful.burau_three_spec_kernel_hard`, reduced to the statement about the *reduced* Burau
representation at `t = -1`.

The child `BurauFaithful.spec_reduced_kernel_le` says that the kernel of the `t = -1`
specialization `redHom3` of the reduced 2-dimensional Burau representation is generated by
`Δ⁴ = (σ₀σ₁)⁶`. What is proved here is the passage from the unreduced 3×3 specialization of the
node's statement to `redHom3`: at `t = -1` the unreduced representation is conjugate over `ℤ`
(by the matrix `C = !![1,-1,1; 1,-1,0; 1,0,-1]`, of determinant `1`) to the direct sum of the
trivial representation and the reduced one,

  `C⁻¹ · ρ₃(σᵢ)|_{t=-1} · C = 1 ⊕ redHom3(σᵢ)`   (`i = 0, 1`),

which is the content of the Proved platform theorem `BurauFaithful.burau_three_spec_reduction`
(recomputed here for the two generators, so that this file is self-contained). Hence for every `β`
the 3×3 specialized matrix is `1` only if `redHom3 β = 1`.
-/
import Definitions.Def_BurauFaithful_UnreducedBurau
import Theorems.Thm_BurauFaithful_spec_reduced_kernel_le

set_option autoImplicit false

open Matrix BraidsLinksMCG

namespace BurauLink

abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) ℤ
abbrev GL3 := Matrix.GeneralLinearGroup (Fin 3) ℤ
abbrev M3 := Matrix (Fin 3) (Fin 3) ℤ

/-- The specialization `ℤ[t,t⁻¹] → ℤ`, `t ↦ -1`. -/
noncomputable def specM1 : (LaurentPolynomial ℤ) →+* ℤ :=
  LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ)

/-- The `t = -1` specialization of the unreduced Burau representation, as a homomorphism into
`GL₃(ℤ)`. -/
noncomputable def specRep : PresentedGroup (braidRels 3) →* GL3 :=
  (Matrix.GeneralLinearGroup.map specM1).comp (BurauFaithful.burauRep 3)

/-- The conjugating matrix of `BurauFaithful.burau_three_spec_reduction`. -/
def C3 : M3 := !![1, -1, 1; 1, -1, 0; 1, 0, -1]

/-- Its inverse over `ℤ` (the determinant is `1` at `t = -1`). -/
def C3inv : M3 := !![1, -1, 1; 1, -2, 1; 1, -1, 0]

lemma C3_mul_C3inv : C3 * C3inv = 1 := by decide

lemma C3inv_mul_C3 : C3inv * C3 = 1 := by decide

/-- `C3` as an element of `GL₃(ℤ)`. -/
def P3 : GL3 := ⟨C3, C3inv, C3_mul_C3inv, C3inv_mul_C3⟩

/-- The conjugate of the specialized unreduced representation by `C3`. -/
noncomputable def Conj : PresentedGroup (braidRels 3) →* GL3 where
  toFun β := P3⁻¹ * specRep β * P3
  map_one' := by simp
  map_mul' := by
    intro x y
    simp only [map_mul]
    group

/-- The block-diagonal embedding `SL(2,ℤ) → M₃(ℤ)`, `M ↦ diag(1, M)`. -/
def blk (M : SL2) : M3 :=
  !![1, 0, 0; 0, M 0 0, M 0 1; 0, M 1 0, M 1 1]

lemma blk_one : blk 1 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk]

lemma blk_mul (M N : SL2) : blk (M * N) = blk M * blk N := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [blk, Matrix.mul_apply, Fin.sum_univ_three, Fin.sum_univ_two]

/-- The block-diagonal embedding composed with the reduced specialization. -/
def blkUnit (M : SL2) : GL3 :=
  ⟨blk M, blk M⁻¹, by rw [← blk_mul, mul_inv_cancel, blk_one],
    by rw [← blk_mul, inv_mul_cancel, blk_one]⟩

/-- The block-diagonal embedding as a monoid homomorphism into `GL₃(ℤ)`. -/
def blkHom : SL2 →* GL3 where
  toFun := blkUnit
  map_one' := by
    apply Units.ext
    simp [blkUnit, blk_one]
  map_mul' := by
    intro M N
    apply Units.ext
    simp [blkUnit, blk_mul]

/-- The block-diagonal embedding composed with the reduced specialization. -/
noncomputable def blkRep : PresentedGroup (braidRels 3) →* GL3 :=
  blkHom.comp BurauFaithful.redHom3

lemma blkRep_entry (β : PresentedGroup (braidRels 3)) :
    (↑(blkRep β) : M3) = blk (BurauFaithful.redHom3 β) := rfl

/-- The specialization of the unreduced Burau matrices of the generators, in the shape used by
`BurauFaithful.burau_three_spec_reduction`. -/
lemma specRep_of_eq_map (i : Fin (3 - 1)) :
    (specRep (PresentedGroup.of i) : M3) = Matrix.map (BurauFaithful.burauMatrix i) specM1 := by
  show (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (PresentedGroup.of i)) : M3) = _
  have hg : (BurauFaithful.burauRep 3 (PresentedGroup.of i)).1 = BurauFaithful.burauMatrix i :=
    congrArg Units.val (PresentedGroup.toGroup.of (h := BurauFaithful.burauGen_relations 3) (x := i))
  ext a b
  rw [Matrix.GeneralLinearGroup.map_apply, hg]
  rfl

lemma specRep_zero :
    (specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) : M3) = !![2, -1, 0; 1, 0, 0; 0, 0, 1] := by
  have h := specRep_of_eq_map (⟨0, by decide⟩ : Fin 2)
  have hmat : (Matrix.map (BurauFaithful.burauMatrix (0 : Fin 2)) specM1 : M3) =
      !![2, -1, 0; 1, 0, 0; 0, 0, 1] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [BurauFaithful.burauMatrix_apply, specM1, LaurentPolynomial.eval₂_T, Matrix.map_apply] <;>
      norm_num
  exact h.trans hmat

lemma specRep_one :
    (specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) : M3) = !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
  have h := specRep_of_eq_map (⟨1, by decide⟩ : Fin 2)
  have hmat : (Matrix.map (BurauFaithful.burauMatrix (1 : Fin 2)) specM1 : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [BurauFaithful.burauMatrix_apply, specM1, LaurentPolynomial.eval₂_T, Matrix.map_apply] <;>
      norm_num
  exact h.trans hmat

/-- The value of `blkRep` on the two generators. -/
lemma blkRep_of_zero :
    (↑(blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2))) : M3) =
      !![1, 0, 0; 0, 1, -1; 0, 0, 1] := by
  show blk (BurauFaithful.redHom3 (PresentedGroup.of (⟨0, by decide⟩ : Fin 2))) = _
  rw [show BurauFaithful.redHom3 (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) =
      BurauFaithful.redGen ⟨0, by decide⟩ from
    PresentedGroup.toGroup.of (h := BurauFaithful.redGen_braid)]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk, BurauFaithful.redGen]

lemma blkRep_of_one :
    (↑(blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2))) : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
  show blk (BurauFaithful.redHom3 (PresentedGroup.of (⟨1, by decide⟩ : Fin 2))) = _
  rw [show BurauFaithful.redHom3 (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) =
      BurauFaithful.redGen ⟨1, by decide⟩ from
    PresentedGroup.toGroup.of (h := BurauFaithful.redGen_braid)]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk, BurauFaithful.redGen]

/-- The two homomorphisms agree on the first generator: `C⁻¹ · ρ₃(σ₀)|_{t=-1} · C = 1 ⊕ A`.
This is the first half of `BurauFaithful.burau_three_spec_reduction`, checked by computation. -/
lemma conj_of_zero :
    Conj (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) =
      blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) := by
  apply Units.ext
  show (↑(P3⁻¹ * specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) * P3) : M3) =
    ↑(blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)))
  rw [blkRep_of_zero]
  simp only [Units.val_mul, P3, Units.val_mk, Inv.inv, C3inv, C3]
  rw [show (specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) : M3) =
      !![2, -1, 0; 1, 0, 0; 0, 0, 1] from specRep_zero]
  decide

/-- The two homomorphisms agree on the second generator: `C⁻¹ · ρ₃(σ₁)|_{t=-1} · C = 1 ⊕ B`. -/
lemma conj_of_one :
    Conj (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) =
      blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) := by
  apply Units.ext
  show (↑(P3⁻¹ * specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) * P3) : M3) =
    ↑(blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)))
  rw [blkRep_of_one]
  simp only [Units.val_mul, P3, Units.val_mk, Inv.inv, C3inv, C3]
  rw [show (specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] from specRep_one]
  decide

lemma Conj_eq_blkRep : Conj = blkRep := by
  refine PresentedGroup.ext (φ := Conj) (ψ := blkRep) ?_
  intro i
  fin_cases i
  · exact conj_of_zero
  · exact conj_of_one

/-- The link: the `t = -1` specialization of the unreduced representation dies only if the
specialization of the reduced representation dies. -/
theorem link (β : BraidsLinksMCG.ArtinBraidGroup 3)
    (h : Matrix.GeneralLinearGroup.map (LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ))
        (BurauFaithful.burauRep 3 β) = 1) :
    BurauFaithful.redHom3 β = 1 := by
  have hspec : specRep β = 1 := h
  have hConj : Conj β = 1 := by
    show P3⁻¹ * specRep β * P3 = 1
    rw [show specRep β = 1 from hspec]
    simp
  have hblkRep : blkRep β = 1 := by
    rw [← Conj_eq_blkRep]
    exact hConj
  have hmat : blk (BurauFaithful.redHom3 β) = 1 := by
    rw [← blkRep_entry β, hblkRep]
    simp
  have e00 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 0 0 = 1 := by
    have := congrArg (fun X : M3 => X 1 1) hmat
    simpa [blk] using this
  have e01 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 0 1 = 0 := by
    have := congrArg (fun X : M3 => X 1 2) hmat
    simpa [blk] using this
  have e10 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 := by
    have := congrArg (fun X : M3 => X 2 1) hmat
    simpa [blk] using this
  have e11 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = 1 := by
    have := congrArg (fun X : M3 => X 2 2) hmat
    simpa [blk] using this
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [e00, e01, e10, e11]

end BurauLink

theorem solution (β : BraidsLinksMCG.ArtinBraidGroup 3) :
    Matrix.GeneralLinearGroup.map (LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ))
        (BurauFaithful.burauRep 3 β) = 1 →
      ∃ k : ℤ, β = (BraidsLinksMCG.sigma ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma ⟨1, by decide⟩) ^ (6 * k) := by
  intro h
  exact BurauFaithful.spec_reduced_kernel_le β (BurauLink.link β h)
