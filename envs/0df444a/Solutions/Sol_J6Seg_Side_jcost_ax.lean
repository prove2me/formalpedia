-- Source module: Solutions.J6SegJCost4
/-!
# J cost 4: the `J` pass as a natural-number polynomial

* `kerC_le1`: `kerC Ckn B m post Lj 1 Tot pre N ≤ pre·post·Ckn + 10^5 (B+2)(pre·post·(m+1) +
  pre (Lj + Tot + 2) + N + 2)`;
* `jcost_arith`: the generic arithmetic;
* **`jcost_ax`**: on an axis, for every `u` and `B`,
  `d · kerC (jC … u + 2) B (2^fJ) post |TJ6| 1 |TJ| pre NJ ≤ T (4·10^5 (w+1) u + 4·10^10 (B+2)(w+1))`;
* `jBody_ax`: `|jBody| ≤ 1460 w m + 24 m + G + 3w + 13`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

open Finset

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

theorem kerC_le1 (Ckn B m post Lj Tot pre N : ℕ) :
    kerC Ckn B m post Lj 1 Tot pre N ≤ pre * post * Ckn +
      100000 * (B + 2) * (pre * post * (m + 1) + pre * (Lj + Tot + 2) + N + 2) := by
  unfold kerC cIL cIb cQb cTab cRows
  ring_nf
  omega

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxJ P n src D k)
include h

theorem jCc_len : (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
    (axw6 P n) (axα6 P n) (axw6 P n)).length =
      (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length := by
  simp [JK.jCc]

theorem jCc_row : ∀ r < (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
    (axw6 P n) (axα6 P n) (axw6 P n)).length,
    ((JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axw6 P n) (axα6 P n) (axw6 P n)).getD r []).length = 2 * axw6 P n + 1 := by
  intro r hr
  rw [List.getD_eq_getElem _ _ hr]
  simp [JK.jCc, ccL]

/-- The part cost on an axis. -/
theorem partC_ax (kk u : ℕ) :
    JK.partC kk (axw6 P n) (axG6 P n src k)
        (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n) (axw6 P n)) u ≤
      (4 * (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length *
          (182 * axw6 P n + 182 * axw6 P n) +
        2 * (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length * (2 * axw6 P n + 1) +
        22 * (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length + axG6 P n src k +
        3 * axw6 P n + 13) * u :=
  JK.partC_le (182 * axw6 P n) (182 * axw6 P n) (LJ_sorted (s := axs6 src k) (t := axt6 P n k)
    (lam := axl6 P n) (w := axw6 P n)) _ kk (axw6 P n) _ u _ _ (jCc_len h) (jCc_row h)
    (win_ax h) (bd_ax h)

theorem jcost_ax_sol_aux (u B : ℕ) :
    dP6 P n * kerC (JK.jC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
        (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n) (axw6 P n)) u + 2)
      B (2 ^ axfJ6 P n src k) (axpost6 P n D k) (axTJ6 P n src k ap).length 1
      (tabsT (fun _ => axTJ6 P n src k ap) 1).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * 1 * axpost6 P n D k * 2 ^ axfJ6 P n src k)) ≤
    TP6 P n * (400000 * (axw6 P n + 1) * u + 40000000000 * (B + 2) * (axw6 P n + 1)) := by
  have hpart := partC_ax h (axkJ6 P n src k ap) u
  have hpart1 := partC_ax h (axkJ6 P n src k ap) 1
  have hTJ : (axTJ6 P n src k ap).length = 8 + (JK.jBody (axkJ6 P n src k ap)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n))).length := by
    show (JK.jTab _ _ _ _ _ _ _).length = _
    simp only [JK.jTab, JK.jHdr, List.length_append, List.length_cons, List.length_nil]
    rfl
  have hTot : (tabsT (fun _ => axTJ6 P n src k ap) 1).length = (axTJ6 P n src k ap).length + 1 := by
    simp [tabsT, segT]
  have hfs := JK.jFs_length (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
    (axw6 P n) (axα6 P n)
  unfold JK.partC at hpart1
  simp only [mul_one] at hpart1
  have hjC : JK.jC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n)) u =
      2 * JK.partC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
        (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n))
        (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
          (axα6 P n) (axw6 P n)) u +
      (3 * axG6 P n src k + 4 * (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length +
        40) * u := by
    unfold JK.jC; rw [hfs]
  have hK := kerC_le1 (JK.jC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n)) u + 2)
    B (2 ^ axfJ6 P n src k) (axpost6 P n D k) (axTJ6 P n src k ap).length
    (tabsT (fun _ => axTJ6 P n src k ap) 1).length (axpre6 P n D k)
    (2 * (axpre6 P n D k * 1 * axpost6 P n D k * 2 ^ axfJ6 P n src k))
  -- the axis facts
  have hGJ : axG6 P n src k = 2 ^ axfJ6 P n src k := h.base.GJ
  have hmG : (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length ≤ axG6 P n src k :=
    Nat.le_pow_clog (by norm_num) _
  have hGm : axG6 P n src k ≤ 2 * (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length + 1 :=
    Val.pow_clog_le _
  have hVJ := h.base.VJ
  have htot := h.base.tot
  have hpost := h.base.post1
  have hpre := h.base.pre1
  have hd1 := h.base.d1
  have hdt : dP6 P n ≤ axt6 P n k := by have := h.t8; nlinarith
  -- generalize
  generalize JK.jC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n)) u = Ck at hjC hK ⊢
  generalize (tabsT (fun _ => axTJ6 P n src k ap) 1).length = Tot at hTot hK ⊢
  generalize (axTJ6 P n src k ap).length = Lj at hTJ hTot hK ⊢
  generalize 2 ^ axfJ6 P n src k = G' at hGJ hK ⊢
  generalize JK.partC (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n)) u = pc at hpart hjC
  generalize (JK.jBody (axkJ6 P n src k ap)
      (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n))
      (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
        (axα6 P n) (axw6 P n))).length = J at hpart1 hTJ
  subst hGJ
  generalize (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length = m at *
  generalize axG6 P n src k = G at *
  generalize axw6 P n = w at *
  generalize axpre6 P n D k = pre at *
  generalize axpost6 P n D k = post at *
  generalize axt6 P n k = t at *
  generalize dP6 P n = d at *
  generalize TP6 P n = T at *
  -- coefficient facts
  have ewm : 4 * m * (182 * w + 182 * w) = 1456 * (w * m) := by ring
  have ewm2 : 2 * m * (2 * w + 1) = 4 * (w * m) + 2 * m := by ring
  have e31 : 3100 * (w + 1) * (m + 1) = 3100 * (w * m) + 3100 * w + 3100 * m + 3100 := by ring
  have e30 : 3000 * (w + 1) * (m + 1) = 3000 * (w * m) + 3000 * w + 3000 * m + 3000 := by ring
  rw [ewm, ewm2] at hpart hpart1
  have hJ : J ≤ 1460 * (w * m) + 24 * m + G + 3 * w + 13 := by omega
  have hc0 : 2 * (1456 * (w * m) + (4 * (w * m) + 2 * m) + 22 * m + G + 3 * w + 13) +
      (3 * G + 4 * m + 40) ≤ 3100 * (w + 1) * (m + 1) := by rw [e31]; omega
  have hC : Ck + 2 ≤ 3100 * (w + 1) * (m + 1) * u + 2 := by
    have := Nat.mul_le_mul_right u hc0
    rw [Nat.add_mul, Nat.mul_assoc 2] at this
    omega
  have hL : Lj + Tot + 2 ≤ 3000 * (w + 1) * (m + 1) := by rw [e30]; omega
  have h2 : d * (pre * post) ≤ T := by
    rw [← htot]
    calc d * (pre * post) = pre * d * post := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hdt)
  have h1 : d * (pre * post * (m + 1)) ≤ 100 * T := by
    have : d * (pre * post * m) ≤ d * (pre * G * post) := by
      have : pre * post * m ≤ pre * G * post := by
        calc pre * post * m = pre * m * post := by ring
          _ ≤ pre * G * post := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hmG)
      exact Nat.mul_le_mul_left _ this
    have e : d * (pre * post * (m + 1)) = d * (pre * post * m) + d * (pre * post) := by ring
    omega
  have h3 : d * (2 * (pre * 1 * post * G)) ≤ 198 * T := by
    have e : d * (2 * (pre * 1 * post * G)) = 2 * (d * (pre * G * post)) := by ring
    omega
  have h4 : d ≤ T := by
    have : 1 ≤ pre * post := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
    have : d ≤ d * (pre * post) := Nat.le_mul_of_pos_right _ this
    omega
  exact jcost_arith hK hC hL (by omega) h1 h2 h3 h4 hpost (by omega)

end ax

end J6Seg.Side
end

