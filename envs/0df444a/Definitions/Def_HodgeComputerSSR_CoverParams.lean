  let p := params1009
  pquad (-625 * p.inv81 * p.S + 250 * p.inv27 * p.Q)
        (143 * p.inv81 * p.S - 92 * p.inv27 * p.Q)
        (-4 * p.inv81 * p.S + 4 * p.inv27 * p.Q)
def c_q11 : Poly1009 :=
  let p := params1009
  pquad (500 * p.inv27 * p.S - 50 * p.inv3 * p.Q)
        (-184 * p.inv27 * p.S + 104 * p.inv9 * p.Q)
        (8 * p.inv27 * p.S - 8 * p.inv9 * p.Q)
def c_q02 : Poly1009 :=
  let p := params1009
  pquad (-25 * p.inv3 * p.S)
        (52 * p.inv9 * p.S - 22 * p.inv3 * p.Q + 5 * p.inv7)
        (-4 * p.inv9 * p.S + 4 * p.inv3 * p.Q)
def c_c30 : Poly1009 :=
  let p := params1009
  pquad (-625 * p.inv243) (143 * p.inv243) (-4 * p.inv243)
def c_c21 : Poly1009 :=
  let p := params1009
  pquad (250 * p.inv27) (-92 * p.inv27) (4 * p.inv27)
def c_c12 : Poly1009 :=
  let p := params1009
  pquad (-25 * p.inv3) (52 * p.inv9) (-4 * p.inv9)
def c_c03 : Poly1009 :=
  let p := params1009
  pquad 0 (-22 * p.inv9) (4 * p.inv9)

def c_Q5 : Poly1009 :=
  padd (psub (pmul c_q20 (pmul c_cb_h c_cb_h)) (pmul (pmul c_q11 c_ca_h) c_cb_h))
       (pmul c_q02 (pmul c_ca_h c_ca_h))
def c_Q7 : Poly1009 :=
  psub (padd (psub (pmul c_c30 (ppow c_cb_h 3))
                   (pmul (pmul c_c21 c_ca_h) (pmul c_cb_h c_cb_h)))
             (pmul (pmul c_c12 (pmul c_ca_h c_ca_h)) c_cb_h))
       (pmul c_c03 (ppow c_ca_h 3))

-- Computable Pair1009 operations (both exact and reduced modulo P34_m_list!)
abbrev Pair1009 := Poly1009 × Poly1009

def pairToAlg (x : Pair1009) : PairAlg (ZMod 1009)[X] := ⟨toPoly x.1, toPoly x.2⟩

def qadd (x y : Pair1009) : Pair1009 := (pnorm (padd x.1 y.1), pnorm (padd x.2 y.2))
def qsub (x y : Pair1009) : Pair1009 := (pnorm (psub x.1 y.1), pnorm (psub x.2 y.2))
def qsc (s : Poly1009) (x : Pair1009) : Pair1009 := (pnorm (pmul s x.1), pnorm (pmul s x.2))
def qmul (x y : Pair1009) : Pair1009 :=
  (pnorm (psub (pmul x.1 y.1) (pmul (pmul x.2 y.2) c_cW)),
   pnorm (psub (padd (pmul x.1 y.2) (pmul x.2 y.1)) (pmul (pmul x.2 y.2) c_bW)))
def qnm (x : Pair1009) : Poly1009 :=
  pnorm (padd (psub (pmul x.1 x.1) (pmul (pmul x.1 x.2) c_bW)) (pmul (pmul x.2 x.2) c_cW))

def c_toUW (v0 v1 v2 : ZMod 1009) : Pair1009 :=
  (pnorm (psub [0, 0, v0] (psmul v2 c_cW)), pnorm (psub [0, v1] (psmul v2 c_bW)))

def c_W : Pair1009 := ([], [1])
def c_c0W : Pair1009 := c_toUW params1009.c0_V0 params1009.c0_V1 params1009.c0_V2
def c_k2W : Pair1009 := c_toUW params1009.k2_V0 params1009.k2_V1 params1009.k2_V2
def c_k3W : Pair1009 := c_toUW params1009.k3_V0 params1009.k3_V1 params1009.k3_V2

def c_d2_2 : Pair1009 := (c_Q5, [])
def c_d2_1 : Pair1009 := qsc (padd (pmul (pneg c_q11) c_cb_h) (pmul (psmul 2 c_q02) c_ca_h)) c_c0W
def c_d2_0 : Pair1009 :=
  qadd (qsc c_q02 (qmul c_c0W c_c0W)) (qsc (pmul c_cb_h c_cb_h) (qmul c_W c_k2W))

def c_d3_3 : Pair1009 := (c_Q7, [])
def c_d3_2 : Pair1009 :=
  qsc (psub (padd (pmul (pneg c_c21) (pmul c_cb_h c_cb_h))
                  (pmul (pmul (psmul 2 c_c12) c_ca_h) c_cb_h))
            (pmul (psmul 3 c_c03) (pmul c_ca_h c_ca_h))) c_c0W
def c_d3_1 : Pair1009 :=
  qsc (psub (pmul c_c12 c_cb_h) (pmul (psmul 3 c_c03) c_ca_h)) (qmul c_c0W c_c0W)
def c_d3_0 : Pair1009 :=
  qadd (qsc (pneg c_c03) (qmul c_c0W (qmul c_c0W c_c0W)))
       (qsc (ppow c_cb_h 3) (qmul (qmul c_W c_W) c_k3W))

def c_syl5 (q2 q1 q0 e3 e2 e1 e0 : Pair1009) : Pair1009 :=
  let q0_2 := qmul q0 q0; let q0_3 := qmul q0_2 q0
  let q1_2 := qmul q1 q1; let q1_3 := qmul q1_2 q1
  let q2_2 := qmul q2 q2; let q2_3 := qmul q2_2 q2
  let e3_2 := qmul e3 e3; let e2_2 := qmul e2 e2; let e1_2 := qmul e1 e1; let e0_2 := qmul e0 e0
  qadd (qsub (qsub (qadd (qadd (qsub (qadd (qsub (qsub (qadd (qadd (qsub (qmul q0_3 e3_2)
    (qmul (qmul q1 q0_2) (qmul e3 e2)))
    (qmul (qmul q2 q0_2) e2_2))
    (qmul (qmul q1_2 q0) (qmul e3 e1)))
    (qsc [2] (qmul (qmul q2 q0_2) (qmul e3 e1))))
    (qmul (qmul q2 (qmul q1 q0)) (qmul e2 e1)))
    (qmul (qmul q2_2 q0) e1_2))
    (qmul q1_3 (qmul e3 e0)))
    (qsc [3] (qmul (qmul q2 (qmul q1 q0)) (qmul e3 e0))))
    (qmul (qmul q2 q1_2) (qmul e2 e0)))
    (qsc [2] (qmul (qmul q2_2 q0) (qmul e2 e0))))
    (qmul (qmul q2_2 q1) (qmul e1 e0)))
    (qmul q2_3 e0_2)

def c_res_z : Pair1009 := c_syl5 c_d2_2 c_d2_1 c_d2_0 c_d3_3 c_d3_2 c_d3_1 c_d3_0
def c_nm_z : Poly1009 := qnm c_res_z

def c_d1_z : Pair1009 :=
  let t2 := qsub (qmul c_d2_2 c_d3_2) (qmul c_d2_1 c_d3_3)
  let t1 := qsub (qmul c_d2_2 c_d3_1) (qmul c_d2_0 c_d3_3)
  qsub (qmul c_d2_2 t1) (qmul c_d2_1 t2)

def c_d0_z : Pair1009 :=
  let t2 := qsub (qmul c_d2_2 c_d3_2) (qmul c_d2_1 c_d3_3)
  let t0 := qmul c_d2_2 c_d3_0
  qsub (qmul c_d2_2 t0) (qmul c_d2_0 t2)

def c_disc_E2z : Pair1009 := qsub (qmul c_d2_1 c_d2_1) (qsc [4] (qmul c_d2_2 c_d2_0))
def c_nm_WU : Poly1009 := qnm ([0, -1], [1])
def c_disc_E0 : Poly1009 := pnorm (psub (pmul c_bW c_bW) (psmul 4 c_cW))

-- Monic target polynomials mod 1009
def P34_m_list : Poly1009 :=
  [745, 807, 732, 895, 108, 665, 1003, 555, 76, 377, 615, 830, 831, 781, 375, 826, 807,
   198, 296, 197, 795, 577, 164, 348, 1004, 476, 342, 940, 899, 230, 643, 462, 819, 365, 1]
def Q5_m_list : Poly1009 := [224, 221, 555, 104, 434, 1]
def cb_h_m_list : Poly1009 := [815, 245, 1]

-- Modulo-P34 Pair1009 arithmetic (using `a.length` as fuel keeps `mP34` opaque to symbolic `whnf`!)
def mP34 (a : Poly1009) : Poly1009 := pmodRec a.length P34_m_list 34 a
def qmodP (x : Pair1009) : Pair1009 := (mP34 x.1, mP34 x.2)
def qaddP (x y : Pair1009) : Pair1009 := qmodP (qadd x y)
def qsubP (x y : Pair1009) : Pair1009 := qmodP (qsub x y)
def qscP (s : Poly1009) (x : Pair1009) : Pair1009 := qmodP (qsc (mP34 s) x)
def qmulP (x y : Pair1009) : Pair1009 := qmodP (qmul x y)

def c_dH_dS_homP (s q : Pair1009) : Pair1009 :=
  let p := params1009
  let s_3q := qsubP s (qscP [3] q)
  let t1 := qscP [0, 0, -4 * p.inv81] (qmulP s_3q s_3q)
  let s2 := qmulP s s; let sq := qmulP s q; let q2 := qmulP q q
  let mid := qaddP (qsubP (qscP [143 * p.inv81] s2) (qscP [184 * p.inv27] sq)) (qscP [52 * p.inv9] q2)
  let t2 := qscP [0, 1] mid
  let f1 := qsubP (qscP [5] s) (qscP [9] q)
  let f2 := qsubP (qscP [15] s) (qscP [9] q)
  let t3 := qscP [-25 * p.inv243] (qmulP f1 f2)
  qaddP (qaddP t1 t2) t3

def c_dH_dQ_homP (s q v0 : Pair1009) : Pair1009 :=
  let p := params1009
  let s_3q := qsubP s (qscP [3] q)
  let t1 := qscP [0, 0, 4 * p.inv27] (qmulP s_3q s_3q)
  let s2 := qmulP s s; let sq := qmulP s q; let q2 := qmulP q q
  let qv := qmulP q v0; let v2 := qmulP v0 v0
  let mid := qaddP (qaddP (qsubP (qaddP (qscP [-92 * p.inv27] s2) (qscP [104 * p.inv9] sq))
    (qscP [22 * p.inv3] q2)) (qscP [10 * p.inv7] qv)) (qscP [10 * p.inv7] v2)
  let t2 := qscP [0, 1] mid
  let f1 := qsubP (qscP [5] s) (qscP [9] q)
  let t3 := qscP [50 * p.inv27] (qmulP s f1)
  qaddP (qaddP t1 t2) t3

def c_detM_WP : Pair1009 :=
  let p := params1009
  let A := qmodP (qsc (pneg c_cb_h) c_d0_z)
  let B := qmodP (qsub (qsc c_ca_h c_d0_z) (qmul c_c0W c_d1_z))
  let Cc := qmodP (qmul c_W (qsc c_cb_h c_d1_z))
  let xS := qsubP (qscP [p.S] Cc) (qscP [p.T] A)
  let xQ := qsubP (qscP [p.Q] Cc) (qscP [p.T] B)
  let a2 := c_dH_dS_homP A B
  let a0 := c_dH_dS_homP xS xQ
  let a1 := qsubP (qsubP (c_dH_dS_homP (qaddP A xS) (qaddP B xQ)) a2) a0
  let b2 := c_dH_dQ_homP A B ([], [])
  let b0 := c_dH_dQ_homP xS xQ Cc
  let b1 := qaddP (qsubP (qsubP (c_dH_dQ_homP (qaddP A xS) (qaddP B xQ) ([], [])) b2)
    (c_dH_dQ_homP xS xQ ([], []))) (qscP [0, 10 * p.inv7] (qmulP B Cc))
  let d20 := qsubP (qmulP a2 b0) (qmulP a0 b2)
  let d21 := qsubP (qmulP a2 b1) (qmulP a1 b2)
  let d10 := qsubP (qmulP a1 b0) (qmulP a0 b1)
  qsubP (qmulP d20 d20) (qmulP d21 d10)

def c_nm_detMP : Poly1009 := mP34 (qnm c_detM_WP)

