              (((pb_n - (A0_num + i * h0) - 2 * (A1_num + j * h1) - (A2_num + k * h2)) * 128) / (A1_num + j * h1)) : ℝ) *
            (wInv (A2_num + k * h2) (A2_num + k * h2 + h2) : ℝ))) /
