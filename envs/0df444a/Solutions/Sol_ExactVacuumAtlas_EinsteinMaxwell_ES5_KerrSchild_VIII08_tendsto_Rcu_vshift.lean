theorem betaratio_zero_eq (j : ℝ) (q : ℝ → ℝ) : betaratio j q 0 = sigmaB j q := by
  unfold betaratio
  rw [if_pos rfl]

theorem betaratio_of_ne {j : ℝ} {q : ℝ → ℝ} {t : ℝ} (ht : t ≠ 0) :
    betaratio j q t = (1 / t) * bfun j q (1 / t) := by
  unfold betaratio
  rw [if_neg ht]

theorem tendsto_betaratio_zero {j : ℝ} {q : ℝ → ℝ} (hq : ContinuousOn q UG) :
    Tendsto (betaratio j q) (𝓝[>] (0:ℝ)) (𝓝 (sigmaB j q)) := by
  have hinv : Tendsto (fun t : ℝ => (1:ℝ) / t) (𝓝[>] (0:ℝ)) atTop := by
    simpa [one_div] using tendsto_inv_nhdsGT_zero (𝕜 := ℝ)
  have hR := (tendsto_Rbfun (j := j) hq).comp hinv
  refine hR.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with t ht
  exact (betaratio_of_ne (ne_of_gt ht)).symm

theorem continuousAt_betaratio_pos {j : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG) {x : ℝ}
    (hx0 : 0 < x) (hx1 : x ≤ 1 / 4) : ContinuousAt (betaratio j q) x := by
  have hx3 : (3:ℝ) < 1 / x := by
    rw [lt_div_iff₀ hx0]
    nlinarith
  have hbf : ContinuousAt (bfun j q) (1 / x) :=
    (contDiffOn_two_bfun (j := j) hqc).continuousOn.continuousAt (isOpen_Ioi.mem_nhds hx3)
  have hinv : ContinuousAt (fun t : ℝ => (1:ℝ) / t) x :=
    ContinuousAt.div continuousAt_const continuousAt_id (ne_of_gt hx0)
  refine (hinv.mul (hbf.comp hinv)).congr ?_
  filter_upwards [isOpen_Ioi.mem_nhds hx0] with t ht
  exact (betaratio_of_ne (ne_of_gt ht)).symm

theorem continuousOn_betaratio {j : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG) :
    ContinuousOn (betaratio j q) (Icc (0:ℝ) (1 / 4)) := by
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h0 | h0
  · rw [← h0]
    have hset : Icc (0:ℝ) (1 / 4) = insert 0 (Ioc (0:ℝ) (1 / 4)) := by
