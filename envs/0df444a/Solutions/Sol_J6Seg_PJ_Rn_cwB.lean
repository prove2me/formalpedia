/-!
# B5 `J` side, part K2: the `TsumI` inner loop

Stacks: `SAP = 38`, `SAM = 39` (the block's `a⁺`, `a⁻` lists, reversed), `SGM = 36` (`Γ`,
reversed, length `λ`). Body `PJ.tsB` (step `k` on `4`): read `a⁺_{k-tU}`, `a⁻_{k-tV}`, `Γ_k` and
add the `TsumI` summand to `8` (`Rn.tsB`); the loop `PJ.tsL = forL 51 2 4 PJ.tsB` sums it over
`k < n` (`Rn.tsL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem rev_getD (f : ℕ → ℤ) {n i : ℕ} (hi : i < n) :
    (((List.range n).map f).reverse).getD (n - 1 - i) 0 = f i := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_reverse]
  simp only [List.getElem_map, List.getElem_range, List.length_map, List.length_range]
  congr 1; omega

theorem rev_mem_bnd {f : ℕ → ℤ} {n : ℕ} {V : ℤ} (h : ∀ i < n, |f i| ≤ V) :
    ∀ x ∈ ((List.range n).map f).reverse, |x| ≤ V := by
  intro x hx
  simp only [List.mem_reverse, List.mem_map, List.mem_range] at hx
  obtain ⟨i, hi, rfl⟩ := hx
  exact h i hi

end J6Seg.PJ

end

