-- title:
--   Coordinate-power ideals have no coefficients in the lower box
-- statement:
--   A multivariate power series in the ideal generated by the powers $X_k^{degree(k)+1}$ has zero coefficient at every exponent whose coordinates satisfy $e_k\le degree(k)$.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_LogarithmicJetIdeals_PlainJet
import Definitions.Def_OAI_PiExponent_LogarithmicJetIdeals_RectangularJetIdeal
import Mathlib.RingTheory.Ideal.Operations

open OAI.PiExponent.AdmissibleFormalInterpolation

theorem OAI.PiExponent.LogarithmicJetIdeals.coeff_zero_of_mem_coordinate_power_ideal
    {m : Nat} (degree : Fin (m + 1) -> Nat)
    (S : MvPowerSeries (Fin (m + 1)) Complex)
    (h : S ∈ Ideal.span (Set.range (fun k : Fin (m + 1) =>
      (MvPowerSeries.X k : MvPowerSeries (Fin (m + 1)) Complex) ^ (degree k + 1))))
    (e : Fin (m + 1) -> Nat)
    (he : (k : Fin (m + 1)) -> e k <= degree k) :
    MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm e) S = 0 := by sorry
