open ModularCurve

theorem ModularCurve.exists_natCard_eisensteinPrimaryTorsionBar_eq_pow (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime]
    (m : ℕ) : ∃ n : ℕ, Nat.card ↥(eisensteinPrimaryTorsionBar p q m) = q ^ n := by sorry
