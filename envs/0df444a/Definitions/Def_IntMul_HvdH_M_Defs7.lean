-- Source module: NLogN.HAx7
/-!
# One resampling axis, part 7: derived scalars and table removal for the `B̃` axis
-/

set_option linter.unusedSimpArgs false

namespace NLogN.AX

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp

/-- `e = ((2e+1) - 1) / 2`. -/
def eE : Ex HS := .quo (.add (.reg bNR) (.lit (-1))) (.lit 2)
/-- `s²`. -/
def s2E : Ex HS := .mul (.reg bS) (.reg bS)
/-- `2α² - 2`. -/
def gE : Ex HS := .add (.add (.reg bI) (.reg bI)) (.lit (-2))

/-- Push the derived scalars `e`, `s²`, `2α²-2` on `xE`, `xK`, `xG`. -/
def tmpP : RS := .seq (.push xE eE) (.seq (.push xK s2E) (.push xG gE))
/-- Pop them again. -/
def tmpQ : RS := .seq (.pop xG) (.seq (.pop xK) (.pop xE))

/-- The state after `tmpP`. -/
def tmpSt (e s α : ℕ) (st : IState HS) : IState HS :=
  ((st.upd xE (.int (e : ℤ) :: st.G xE)).upd xK (.int ((s ^ 2 : ℕ) : ℤ) :: st.G xK)).upd xG
    (.int ((2 * α ^ 2 - 2 : ℕ) : ℤ) :: st.G xG)

