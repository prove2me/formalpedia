theorem inv_mem_of_isUnit {F : Type} [Field F] (S : ValuationSubring F) (t : ↥S) (ht : IsUnit t) :
    ((t : F))⁻¹ ∈ S := by
  obtain ⟨u, hu⟩ := ht
  have hmul : (t : F) * (((u⁻¹ : (↥S)ˣ) : ↥S) : F) = 1 := by
    have h := congrArg (fun z : ↥S => (z : F)) u.mul_inv
    simp only [hu] at h
    exact h
  by_cases ht0 : (t : F) = 0
  · rw [ht0, zero_mul] at hmul; exact absurd hmul zero_ne_one
  rw [inv_eq_of_mul_eq_one_right hmul]
  exact Subtype.mem _

theorem coeff_mul_mem_of_forall_coeff_mem {A : Type} [CommRing A] (I : Ideal A) (u d : PowerSeries A)
    (hd : ∀ n, PowerSeries.coeff n d ∈ I) (n : ℕ) : PowerSeries.coeff n (u * d) ∈ I := by
  rw [PowerSeries.coeff_mul]
  exact Ideal.sum_mem _ fun ij _ => Ideal.mul_mem_left _ _ (hd _)

theorem coeff_mul_of_forall_lt_eq_zero {A : Type} [CommRing A] (u d : PowerSeries A) (n₀ : ℕ)
    (hd : ∀ k, k < n₀ → PowerSeries.coeff k d = 0) :
    PowerSeries.coeff n₀ (u * d) = PowerSeries.coeff 0 u * PowerSeries.coeff n₀ d := by
  rw [PowerSeries.coeff_mul, Finset.sum_eq_single (0, n₀)]
  · rintro ⟨i, k⟩ hik hne
    have hsum : i + k = n₀ := Finset.HasAntidiagonal.mem_antidiagonal.mp hik
    rcases Nat.eq_zero_or_pos i with h0 | hpos
    · subst h0
      exfalso
      apply hne
      rw [zero_add] at hsum
      rw [hsum]
    · rw [hd k (by omega), mul_zero]
  · intro h
    exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.mpr (by simp)) h

theorem exists_eq_C_mul_of_forall_coeff_mem_span {A : Type} [CommRing A] (ϖ : A) (d : PowerSeries A)
    (hd : ∀ n, PowerSeries.coeff n d ∈ Ideal.span {ϖ}) : ∃ d' : PowerSeries A, d = PowerSeries.C ϖ * d' := by
  classical
  choose a ha using fun n => Ideal.mem_span_singleton'.mp (hd n)
  refine ⟨PowerSeries.mk a, ?_⟩
  ext n
  rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_mk, mul_comm, ha n]

