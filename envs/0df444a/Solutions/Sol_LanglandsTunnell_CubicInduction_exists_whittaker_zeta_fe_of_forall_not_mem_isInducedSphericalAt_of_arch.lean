include hone in

private theorem isCosetEigenfunction_map
    {v : HeightOneSpectrum (𝓞 ℚ)} {U : Subgroup (LocalGL3 v)} {t : LocalGL3 v} {lam : ℂ}
    (h : IsCosetEigenfunction U t (Wloc v) lam) :
    IsCosetEigenfunction (U.map (localToAdelic3 v)) (localToAdelic3 v t) (adelicProduct Warch Wloc) lam := by
  intro ι _ reps hsys g
  obtain ⟨lifts, hlift, hsys'⟩ :=
    exists_isHeckeCosetSystem_of_map (LocalFactorEmbedding.localToAdelic3_injective v) hsys
  obtain ⟨c, hg, hc⟩ := exists_forall_adelicProduct_mul_localToAdelic3_eq_and Warch hone v g
  have hloc := h ι lifts hsys' (componentAt3 (𝓞 ℚ) ℚ v g)
  simp only [cosetSum] at hloc ⊢
  rw [hg, ← mul_assoc, mul_comm lam c, mul_assoc, ← hloc, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← hlift i, hc]

