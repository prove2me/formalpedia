-- title:
--   Thompson's group $V$ on the circle, and the presented group $V_1$
-- statement:
--   Cannon–Floyd–Parry §6 (pp. 240–247): Thompson's group $V$ and the presented group $V_1$.
--
--   **The circle.** $S^1$ is `UnitAddCircle`, the reals modulo $1$; $[x]$ is the image of $x \in \mathbb{R}$.
--
--   **IsThompsonV, V.** A permutation $f$ of $S^1$ satisfies `IsThompsonV f` when it maps images of dyadic rationals to images of dyadic rationals, and for some finite set $B$ of dyadic rationals, on every half-open interval $[x, y)$ whose interior meets no point $b + k$ ($b \in B$, $k \in \mathbb{Z}$), $f[z] = [2^n z + c]$ for some integer $n$ and real $c$. `V` is the subgroup of permutations of $S^1$ generated by these maps: the source's group of right-continuous bijections of $S^1$ (p. 240).
--
--   **mapPi0.** The source's $\pi_0$ (p. 240): $[x] \mapsto [x/2 + 1/2]$, $[2x - 1]$, $[x]$ for $x$ in $[0,\tfrac12)$, $[\tfrac12,\tfrac34)$, $[\tfrac34,1)$. It exchanges $[0,\tfrac12)$ and $[\tfrac12,\tfrac34)$.
--
--   **The words.** In the free group on four symbols $A$, $B$, $C$, $\pi_0$ (`FormalV`): $X_0 = A$, $X_n = A^{-(n-1)}BA^{n-1}$; $C_0 = 1$, $C_n = A^{-(n-1)}CB^{n-1}$ ($n \ge 1$); $\pi_1 = C_2^{-1}\pi_0C_2$ and $\pi_n = A^{-(n-1)}\pi_1A^{n-1}$ ($n \ge 1$) (`wordX`, `wordC`, `wordPi`, p. 241).
--
--   **V1.** `V1` is the presented group on the four symbols with the fourteen relators of p. 242, the commutators written out as $xyx^{-1}y^{-1}$. `XV1`, `CV1`, `piV1` are the words read in $V_1$; `PiSub n` is $\Pi(n) = \langle \pi_0, \dots, \pi_{n-1}\rangle$, `PiUnion` is $\Pi = \bigcup_n \Pi(n)$, and `IsPositiveV1` means lying in the submonoid generated by the $X_i$ (p. 247).
--
--   **symV, XV, CV, piV.** `symV` sends $A$, $B$, $C$, $\pi_0$ to $T$'s maps $A$, $B$, $C$ and to `mapPi0`; `XV`, `CV`, `piV` are the same words read as maps of $S^1$ (p. 241).
--
--   **combPt, combInt.** `combPt j` is $1 - 2^{-j}$; `combInt m j` is the half-open interval $[1 - 2^{-j}, 1 - 2^{-(j+1)})$ for $j \ne m$ and $[1 - 2^{-m}, 1)$ for $j = m$: the intervals of p. 241 that the $\pi_i$ and $C_n$ permute.
--
--   **Formalization Note.** Products of permutations compose right to left, $(fg)(t) = f(g(t))$, the source's convention. "Linear" in the source is read modulo $1$, so a piece may wrap past $[0]$ (a rotation lies in $V$); half-open pieces make every element right-continuous. The words are defined once and read both in $V_1$ and in $V$.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathématique (2) 42 (1996) 215–256, https://doi.org/10.5169/seals-87877, section 6, pp. 240–247, the group V and π₀ (p. 240), the words Xₙ, Cₙ, πₙ (p. 241), the presentation V₁ (p. 242), Π(n), Π and positive elements (p. 247)

import Definitions.Def_CannonFloydParry
import Definitions.Def_CannonFloydParry_T
import Mathlib

/-!
# Cannon–Floyd–Parry §6: Thompson's group `V`

Cannon, Floyd, Parry, *Introductory notes on Richard Thompson's groups*, L'Enseignement Math.
(2) 42 (1996), §6, pp. 240–247.  `V` is a group of permutations of the circle `UnitAddCircle`
(the reals modulo `1`); `V₁` is the presented group of p. 242.  The words `Xₙ`, `Cₙ`, `πₙ` are
defined once, in the free group on the four symbols, and read both in `V₁` and in `V`.
-/

namespace CannonFloydParry

/-! ### The group `V` (p. 240) -/

/-- The condition, on a permutation `f` of the circle `ℝ/ℤ`, that defines Thompson's group `V`
(p. 240): `f` maps dyadic rationals to dyadic rationals (modulo `1`), and for some finite set `B`
of dyadic breakpoints, on every half-open interval `[x, y)` whose interior avoids the integer
translates of `B`, `f` is `z ↦ 2ⁿ z + c` modulo `1`. -/
def IsThompsonV (f : Equiv.Perm UnitAddCircle) : Prop :=
  (∀ x : ℝ, IsDyadic x → ∃ y : ℝ, IsDyadic y ∧ f (x : UnitAddCircle) = (y : UnitAddCircle)) ∧
    ∃ B : Finset ℝ, (∀ b ∈ B, IsDyadic b) ∧
      ∀ x y : ℝ, x < y → (∀ t ∈ Set.Ioo x y, ∀ b ∈ B, ∀ k : ℤ, t ≠ b + k) →
        ∃ (n : ℤ) (c : ℝ), ∀ z ∈ Set.Ico x y,
          f (z : UnitAddCircle) = ((2 ^ n * z + c : ℝ) : UnitAddCircle)

/-- Thompson's group `V`: the subgroup of permutations of the circle generated by the maps
satisfying `IsThompsonV`. -/
def V : Subgroup (Equiv.Perm UnitAddCircle) := Subgroup.closure {f | IsThompsonV f}

/-- The function `π₀` of p. 240 on `[0,1)`: `x/2 + 1/2` on `[0,1/2)`, `2x - 1` on `[1/2,3/4)`,
`x` on `[3/4,1)`. -/
noncomputable def piFun (x : ℝ) : ℝ :=
  if x < 1 / 2 then x / 2 + 1 / 2 else if x < 3 / 4 then 2 * x - 1 else x

lemma piFun_mem {x : ℝ} (hx : x ∈ Set.Ico (0 : ℝ) (0 + 1)) : piFun x ∈ Set.Ico (0 : ℝ) (0 + 1) := by
  obtain ⟨h0, h1⟩ := hx
  unfold piFun; split_ifs <;> constructor <;> linarith

lemma piFun_piFun {x : ℝ} (hx : x ∈ Set.Ico (0 : ℝ) (0 + 1)) : piFun (piFun x) = x := by
  obtain ⟨h0, h1⟩ := hx
  unfold piFun
  split_ifs <;> first | (exfalso; linarith) | ring

/-- `piFun` as a permutation of `[0,1)`; it is its own inverse. -/
noncomputable def piIco : Equiv.Perm (Set.Ico (0 : ℝ) (0 + 1)) where
  toFun x := ⟨piFun x, piFun_mem x.2⟩
  invFun x := ⟨piFun x, piFun_mem x.2⟩
  left_inv x := Subtype.ext (piFun_piFun x.2)
  right_inv x := Subtype.ext (piFun_piFun x.2)

/-- The element `π₀` of `V` (p. 240), as a permutation of the circle. -/
noncomputable def mapPi0 : Equiv.Perm UnitAddCircle :=
  (AddCircle.equivIco (1 : ℝ) 0).trans (piIco.trans (AddCircle.equivIco (1 : ℝ) 0).symm)

/-! ### The words `Xₙ`, `Cₙ`, `πₙ` -/

/-- The four formal symbols `A`, `B`, `C`, `π₀` of the presentation of `V₁`. -/
inductive FormalV
  | A
  | B
  | C
  | P
  deriving DecidableEq

/-- `X₀ = A` and `Xₙ = A^{-(n-1)} B A^{n-1}` (`n ≥ 1`), as words (p. 241). -/
def wordX : ℕ → FreeGroup FormalV
  | 0 => FreeGroup.of FormalV.A
  | n + 1 => (FreeGroup.of FormalV.A ^ n)⁻¹ * FreeGroup.of FormalV.B * FreeGroup.of FormalV.A ^ n

/-- `C₀ = 1` and `Cₙ = A^{-(n-1)} C B^{n-1}` (`n ≥ 1`), as words (p. 241). -/
def wordC : ℕ → FreeGroup FormalV
  | 0 => 1
  | n + 1 => (FreeGroup.of FormalV.A ^ n)⁻¹ * FreeGroup.of FormalV.C * FreeGroup.of FormalV.B ^ n

/-- `π₀`, `π₁ = C₂⁻¹ π₀ C₂` and `πₙ = A^{-(n-1)} π₁ A^{n-1}` (`n ≥ 2`), as words (p. 241). -/
def wordPi : ℕ → FreeGroup FormalV
  | 0 => FreeGroup.of FormalV.P
  | n + 1 => (FreeGroup.of FormalV.A ^ n)⁻¹ * ((wordC 2)⁻¹ * FreeGroup.of FormalV.P * wordC 2)
      * FreeGroup.of FormalV.A ^ n

/-! ### The presented group `V₁` (p. 242) -/

/-- The fourteen relators of `V₁` (p. 242), with `[x, y] = x y x⁻¹ y⁻¹`. -/
def relsV1 : Set (FreeGroup FormalV) :=
  let a := FreeGroup.of FormalV.A
  let b := FreeGroup.of FormalV.B
  { (a * b⁻¹) * wordX 2 * (a * b⁻¹)⁻¹ * (wordX 2)⁻¹,
    (a * b⁻¹) * wordX 3 * (a * b⁻¹)⁻¹ * (wordX 3)⁻¹,
    b * wordC 2 * (wordC 1)⁻¹,
    b * wordC 3 * (wordC 2 * wordX 2)⁻¹,
    wordC 2 ^ 2 * (wordC 1 * a)⁻¹,
    wordC 1 ^ 3,
    wordPi 1 ^ 2,
    wordPi 3 * wordPi 1 * (wordPi 1 * wordPi 3)⁻¹,
    (wordPi 2 * wordPi 1) ^ 3,
    wordPi 1 * wordX 3 * (wordX 3 * wordPi 1)⁻¹,
    b * wordPi 2 * wordPi 1 * (wordPi 1 * wordX 2)⁻¹,
    b * wordPi 3 * (wordPi 2 * b)⁻¹,
    wordC 3 * wordPi 2 * (wordPi 1 * wordC 3)⁻¹,
    (wordPi 1 * wordC 2) ^ 3 }

/-- `V₁ = ⟨A, B, C, π₀ : relsV1⟩` (p. 242). -/
abbrev V1 := PresentedGroup relsV1

/-- `Xₙ` in `V₁`. -/
def XV1 (n : ℕ) : V1 := PresentedGroup.mk relsV1 (wordX n)

/-- `Cₙ` in `V₁`. -/
def CV1 (n : ℕ) : V1 := PresentedGroup.mk relsV1 (wordC n)

/-- `πₙ` in `V₁`. -/
def piV1 (n : ℕ) : V1 := PresentedGroup.mk relsV1 (wordPi n)

/-- `Π(n)`, the subgroup of `V₁` generated by `π₀, …, π_{n-1}` (p. 247). -/
def PiSub (n : ℕ) : Subgroup V1 := Subgroup.closure (piV1 '' Set.Iio n)

/-- `Π = ⋃ₙ Π(n)` (p. 247). -/
def PiUnion : Set V1 := ⋃ n, (PiSub n : Set V1)

/-! ### The finitary symmetric group `Σ` (p. 247) -/

/-- `Σ`, the group of permutations of `ℕ` with finite support (p. 247). -/
def SigmaPerm : Subgroup (Equiv.Perm ℕ) where
  carrier := {σ | {x | σ x ≠ x}.Finite}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    refine (ha.union hb).subset fun x hx => ?_
    by_contra h
    simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at h
    simp [Equiv.Perm.mul_apply, h.2, h.1] at hx
  inv_mem' := by
    intro a ha
    refine ha.subset fun x hx => ?_
    intro h
    exact hx (by rw [Equiv.Perm.inv_eq_iff_eq]; exact h.symm)

/-- `sᵢ`, the transposition of `i` and `i + 1`, as an element of `Σ` (p. 247). -/
def sigmaGen (i : ℕ) : SigmaPerm :=
  ⟨Equiv.swap i (i + 1), (Set.finite_Icc i (i + 1)).subset fun x hx => by
    simp only [Set.mem_setOf_eq] at hx
    simp only [Set.mem_Icc]
    by_contra h
    exact hx (Equiv.swap_apply_of_ne_of_ne (by omega) (by omega))⟩

/-- The relators of the presentation of `Σ` on p. 247: `sᵢ²`, `(sᵢsᵢ₊₁)³`, and `(sᵢsⱼ)²` for
`j ≥ i + 2`. -/
def relsSigma : Set (FreeGroup ℕ) :=
  Set.range (fun i => FreeGroup.of i ^ 2) ∪
    Set.range (fun i => (FreeGroup.of i * FreeGroup.of (i + 1)) ^ 3) ∪
    {r | ∃ i j, i + 2 ≤ j ∧ r = (FreeGroup.of i * FreeGroup.of j) ^ 2}

/-- The group presented on p. 247 by generators `s₀, s₁, …` and the relators `relsSigma`. -/
abbrev SigmaPres := PresentedGroup relsSigma

/-- The **positive** elements of `V₁` (p. 247): products of nonnegative powers of the `Xᵢ`. -/
def IsPositiveV1 (g : V1) : Prop := g ∈ Submonoid.closure (Set.range XV1)

/-! ### The same words as maps of the circle (p. 241) -/

/-- The intended images of the four symbols: the maps `A`, `B`, `C` of `T` and `π₀`. -/
noncomputable def symV : FormalV → Equiv.Perm UnitAddCircle
  | FormalV.A => toCircle mapA
  | FormalV.B => toCircle mapB
  | FormalV.C => mapC
  | FormalV.P => mapPi0

/-- `Xₙ` as a map of the circle. -/
noncomputable def XV (n : ℕ) : Equiv.Perm UnitAddCircle := FreeGroup.lift symV (wordX n)

/-- `Cₙ` as a map of the circle. -/
noncomputable def CV (n : ℕ) : Equiv.Perm UnitAddCircle := FreeGroup.lift symV (wordC n)

/-- `πₙ` as a map of the circle. -/
noncomputable def piV (n : ℕ) : Equiv.Perm UnitAddCircle := FreeGroup.lift symV (wordPi n)

/-- The point `1 - 2⁻ʲ` (`0`, `1/2`, `3/4`, …): the intervals `[1 - 2⁻ʲ, 1 - 2⁻⁽ʲ⁺¹⁾)` are the
intervals of p. 241 that the `πᵢ` and `Cₙ` permute. -/
noncomputable def combPt (j : ℕ) : ℝ := 1 - (2 : ℝ)⁻¹ ^ j

/-- The comb intervals of p. 241, half-open: `[1 - 2⁻ʲ, 1 - 2⁻⁽ʲ⁺¹⁾)` for `j < m`, and the last
one, `[1 - 2⁻ᵐ, 1)`, for `j = m`. -/
noncomputable def combInt (m j : ℕ) : Set ℝ :=
  Set.Ico (combPt j) (if j = m then 1 else combPt (j + 1))

end CannonFloydParry


