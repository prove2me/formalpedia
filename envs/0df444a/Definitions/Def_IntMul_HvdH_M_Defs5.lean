namespace NLogN

open IntMul

namespace Ex

/-- `a / b` (floor) for `b > 0`. -/
def fdiv (a b : Ex HS) : Ex HS :=
  .sel a (.neg (.ndiv (.add (.neg a) (.add b (.lit (-1)))) b)) (.ndiv a b)

end Ex

