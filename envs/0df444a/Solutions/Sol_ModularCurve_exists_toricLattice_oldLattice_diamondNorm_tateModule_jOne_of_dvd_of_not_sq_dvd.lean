    have := congrArg (fun u : (ZMod (M / p))ˣ => (u : ZMod (M / p))) hh
    simpa [ZMod.unitsMap_def] using this
  refine ⟨((h : (ZMod M)ˣ) : ZMod M).val, ⟨?_, ZMod.natCast_zmod_val _⟩, ?_⟩
  · rw [Finset.mem_filter, Finset.mem_range]
