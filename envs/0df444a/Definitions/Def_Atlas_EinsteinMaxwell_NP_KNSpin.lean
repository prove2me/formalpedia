/-! ### Lowered frame covectors -/

/-- `e_C♭_μ = Σ_ν g_{μν} e_C^ν`. -/
noncomputable def knCov (M a Q : ℝ) (C μ : Fin 4) (x : Pt 4) : ℂ :=
  ∑ ν, (gKN M a Q μ ν x : ℂ) * knE M a Q C ν x

