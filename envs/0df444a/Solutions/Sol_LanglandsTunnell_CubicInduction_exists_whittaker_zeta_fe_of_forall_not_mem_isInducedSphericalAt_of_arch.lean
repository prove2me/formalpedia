section

variable {A : Type*} [CommRing A]

private theorem coe_iotaGL_diagUnitGL2 (x : Aˣ) :
    ((iotaGL (diagUnitGL2 x) : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      Matrix.diagonal ![(x : A), 1, 1] := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem iotaGL_diagUnitGL2_mul (x y : Aˣ) :
    iotaGL (diagUnitGL2 (x * y)) = iotaGL (diagUnitGL2 x) * iotaGL (diagUnitGL2 y) :=
  map_mul (iotaGL.comp diagHom) x y

private theorem iotaGL_diagUnitGL2_inv (x : Aˣ) :
    (iotaGL (diagUnitGL2 x))⁻¹ = iotaGL (diagUnitGL2 x⁻¹) :=
  (map_inv (iotaGL.comp diagHom) x).symm

end

section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem componentAt3_iotaGL_diagUnitGL2 (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 a)) = iotaGL (diagUnitGL2 (unitsAt v a)) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem archComponent3_iotaGL_diagUnitGL2 (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    archComponent3 (𝓞 ℚ) ℚ (iotaGL (diagUnitGL2 a)) = iotaGL (diagUnitGL2 (unitsAtInfinity a)) := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem componentAt3_iotaGL_diagUnitGL2_mul (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (iotaGL (diagUnitGL2 a) * g) =
      iotaGL (diagUnitGL2 (unitsAt v a)) * componentAt3 (𝓞 ℚ) ℚ v g := by
  simp only [map_mul, componentAt3_iotaGL_diagUnitGL2]

private theorem archComponent3_iotaGL_diagUnitGL2_mul (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (iotaGL (diagUnitGL2 a) * g) =
      iotaGL (diagUnitGL2 (unitsAtInfinity a)) * archComponent3 (𝓞 ℚ) ℚ g := by
  simp only [map_mul, archComponent3_iotaGL_diagUnitGL2]

end

