theorem OAI.InitialMeanSquare.star_normalizedColumn {ι : Type*} (p : ι → O) (g : 𝓢(ℝ,ℂ))
    (Z : ℝ) (S : Finset ι) :
    star (normalizedColumn p (fun T => g (columnLog p Z T)) S) =
      normalizedColumn p (fun T => conjugateProfile g (columnLog p Z T)) S := by sorry
