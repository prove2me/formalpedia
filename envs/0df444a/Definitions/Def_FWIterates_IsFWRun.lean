-- name    : FWIterates_IsFWRun
-- status  : Definition
-- author  : @iris
-- created : 2026-10-31T11:23:25.269986+00:00
-- url     : https://prove2.me/theorems/c40f28e6-2a84-45f0-a8d2-b132e94e0810
-- title:
--   Algorithm 2, Remark 2.2(i) and step-size rules (i), (i'), (ii), (iii), p.3 — sequences generated by the Frank-Wolfe algorithm
-- statement:
--   Given a constraint set $\mathcal C$, an objective $f$ and a start point $x_0$, a sequence $(x_t)_{t\in\mathbb N}$ is **generated by the Frank-Wolfe algorithm** (Algorithm 2 and Remark 2.2(i)) if $x_0\in\mathcal C$ and for every $t\in\mathbb N$ there exist
--   $$
--   v_t\in\operatorname*{arg\,min}_{v\in\mathcal C}\langle v,\nabla f(x_t)\rangle\qquad\text{and}\qquad\gamma_t\in[0,1]
--   $$
--   such that $x_{t+1}=(1-\gamma_t)x_t+\gamma_t v_t$, where $\gamma_t$ follows the chosen step-size strategy:
--
--   1. (i) open loop: $\gamma_t=\dfrac1{t+1}$;
--   2. (i') open loop: $\gamma_t=\dfrac2{t+2}$;
--   3. (ii) closed loop: $\gamma_t=\min\Big\{\dfrac{\langle x_t-v_t,\nabla f(x_t)\rangle}{L\|x_t-v_t\|^2},1\Big\}$;
--   4. (iii) line search: $\gamma_t\in\operatorname*{arg\,min}_{\gamma\in[0,1]}f(x_t+\gamma(v_t-x_t))$.
--
--   The oracle output $v_t$ may be any minimizer of the linear subproblem at each step, so a statement about "any sequence generated" covers every oracle selection and every admissible step.
--
--   **Formalization Note** A step-size rule is a predicate on $(t,x_t,v_t,\gamma_t)$ (`openLoop`, `openLoop'`, `closedLoop f L`, `lineSearch f`). In rule (ii), when $x_t=v_t$ Lean evaluates $0/0$ to $0$, so $\gamma_t=0$; every step gives $x_{t+1}=x_t$ in that case, so no sequence changes.
-- source:
--   Bolte, Combettes & Pauwels, The Iterates of the Frank-Wolfe Algorithm May Not Converge, arXiv:2202.08711v1, Algorithm 2 and Remark 2.2(i), p.3; step-size strategies (i), (i'), (ii), (iii), p.3

import Mathlib

open scoped RealInnerProductSpace

namespace FWIterates

/-- A step-size rule: the predicate `rule t xₜ vₜ γₜ` says that `γₜ` is an admissible step size at
iteration `t`, given the current iterate `xₜ` and the oracle output `vₜ`. -/
abbrev StepRule (n : ℕ) : Type := ℕ → EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) → ℝ → Prop

/-- Step-size rule **(i)** (arXiv:2202.08711v1, §2.2, p.3), open loop: `γₜ = 1/(t + 1)`. -/
def openLoop (n : ℕ) : StepRule n := fun t _ _ γ => γ = 1 / ((t : ℝ) + 1)

/-- Step-size rule **(i')** (arXiv:2202.08711v1, §2.2, p.3), open loop: `γₜ = 2/(t + 2)`. -/
def openLoop' (n : ℕ) : StepRule n := fun t _ _ γ => γ = 2 / ((t : ℝ) + 2)

/-- Step-size rule **(ii)** (arXiv:2202.08711v1, §2.2, p.3), closed loop:
`γₜ = min {⟨xₜ − vₜ, ∇f(xₜ)⟩ / (L‖xₜ − vₜ‖²), 1}`.

**Formalization Note** When `xₜ = vₜ` the quotient is `0/0`, which Lean evaluates to `0`, so
`γₜ = 0`; every `γₜ` gives the same next iterate `xₜ₊₁ = xₜ` in that case, so no run changes. -/
def closedLoop {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (L : ℝ) : StepRule n :=
  fun _ x v γ => γ = min (⟪x - v, gradient f x⟫ / (L * ‖x - v‖ ^ 2)) 1

/-- Step-size rule **(iii)** (arXiv:2202.08711v1, §2.2, p.3), line search:
`γₜ ∈ argmin_{γ ∈ [0,1]} f(xₜ + γ(vₜ − xₜ))`. Membership `γₜ ∈ [0, 1]` is part of `IsFWRun`. -/
def lineSearch {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) : StepRule n :=
  fun _ x v γ => ∀ γ' ∈ Set.Icc (0 : ℝ) 1, f (x + γ • (v - x)) ≤ f (x + γ' • (v - x))

/-- **A sequence generated by the Frank-Wolfe algorithm** (arXiv:2202.08711v1, Algorithm 2 and
Remark 2.2(i), p.3) for the constraint set `C`, objective `f`, step-size rule `rule` and start point
`x₀`: `x 0 = x₀ ∈ C`, and for every `t` there exist `vₜ ∈ argmin_{v ∈ C} ⟨v, ∇f(xₜ)⟩` and
`γₜ ∈ [0, 1]` obeying the rule with `xₜ₊₁ = (1 − γₜ)xₜ + γₜvₜ`.

**Formalization Note** Following Remark 2.2(i), the oracle output `vₜ` may be *any* minimizer of
the linear subproblem at every step (every oracle selection is allowed) and `γₜ` any value the rule
admits; a statement "every sequence generated … satisfies P" quantifies over all of them. -/
def IsFWRun {n : ℕ} (C : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (rule : StepRule n) (x₀ : EuclideanSpace ℝ (Fin n)) (x : ℕ → EuclideanSpace ℝ (Fin n)) : Prop :=
  x 0 = x₀ ∧ x₀ ∈ C ∧
    ∀ t : ℕ, ∃ v ∈ C, (∀ w ∈ C, ⟪v, gradient f (x t)⟫ ≤ ⟪w, gradient f (x t)⟫) ∧
      ∃ γ ∈ Set.Icc (0 : ℝ) 1, rule t (x t) v γ ∧ x (t + 1) = (1 - γ) • x t + γ • v

end FWIterates


