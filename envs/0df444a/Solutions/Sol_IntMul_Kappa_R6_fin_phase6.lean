-- Source module: Solutions.R6MPh
/-!
# Round-six machine: the interface calls

The frozen `KFMBig2` / `KFMBig3` at the round-six parameters. Every interface call is
`callW (cpyD Z X k c) X Y dS e`: the builder copies the stored descriptor (`zLn`, `zCh`, `zPh`,
length `k d + c`) onto the builder stack `X = bX dS`. The interfaces run in their own tables
`kTableP tab ext` and are relabelled into the merged table (`callW_I`).

* `lineG6`, `chirpG6`, `phiG6`: the per-size guarantees (bodies of `LineNeed6`, the chirp, and
  `CrtNeed6`).
* **`lineA_phase6`**, **`lineB_phase6`**, **`chirp_phase6`**, **`phi_phase6`**.
* **`phiF_rep6`**: the digits after `Φ` (frozen `phiF_rep`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

/-! ## The builder of a call -/

theorem cpy_call {Z : Fin HS} (hZ : Z = zPh ∨ Z = zCh ∨ Z = zLn) (dS : Fin HS) (t : IState HS)
    (desc : List ℤ) (hZt : ∃ L, t.G Z = ints desc ++ L) (dv : ℕ) (hD : KFM.Hold t zDd dv)
    (k c : ℕ) (hlen : desc.length = k * dv + c) (B : ℕ) (hB : ∀ x ∈ desc, zsz x ≤ B)
    (hB1 : k * dv + c < 2 ^ B) (hB2 : dv < 2 ^ B) :
    (cpyD Z (bX dS) k c).ok (t.upd (bX dS) (.mark :: t.G (bX dS))) ∧
      (cpyD Z (bX dS) k c).run (t.upd (bX dS) (.mark :: t.G (bX dS))) =
        (t.upd (bX dS) (.mark :: t.G (bX dS))).upd (bX dS) (ints desc ++ .mark :: t.G (bX dS)) ∧
      (cpyD Z (bX dS) k c).cost (t.upd (bX dS) (.mark :: t.G (bX dS))) ≤ kCpy k desc.length B := by
  have hX : bX dS = 36 ∨ bX dS = 37 := by unfold bX; split_ifs <;> simp
  obtain ⟨L, hL⟩ := hZt
  have hZX : Z ≠ bX dS := by rcases hZ with rfl | rfl | rfl <;> rcases hX with e | e <;> rw [e] <;> decide
  set u := t.upd (bX dS) (.mark :: t.G (bX dS)) with hu
  have huZ : u.G Z = ints desc ++ L := by rw [hu, IState.upd_G, if_neg hZX, hL]
  have huD : KFM.Hold u zDd dv := hD.upd _ (by rcases hX with e | e <;> rw [e] <;> decide) _
  have H := cpyD_run hZX (by rcases hZ with rfl | rfl | rfl <;> decide)
    (by rcases hX with e | e <;> rw [e] <;> decide)
    (by rcases hZ with rfl | rfl | rfl <;> decide) (by rcases hZ with rfl | rfl | rfl <;> decide)
    (by rcases hX with e | e <;> rw [e] <;> decide) (by rcases hX with e | e <;> rw [e] <;> decide)
    (by rcases hX with e | e <;> rw [e] <;> decide) (by rcases hZ with rfl | rfl | rfl <;> decide)
    u desc L huZ k c dv B huD hlen hB1 hB2 hB
  refine ⟨H.1, ?_, H.2.2⟩
  rw [H.2.1]
  congr 1
  simp [hu]

theorem len_descPhi (w h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) :
    (descPhi w h d bL sF μ).length = 3 * d + 3 := by
  simp [descPhi, bitsZ]; omega

/-! ## The guarantees per size -/

/-! ## The phases -/

section Phases

variable {P E : ℕ} {Isym : List Sym} {iprog : Fin P → IStmt HS P} {tab : Fin 1 → IStmt HS 1}
  {ext : Fin E → IStmt HS (7 + E)} {g : Fin (7 + E) → Fin P}
  (hprog : ∀ j, iprog (g j) = (IL.kTableP tab ext j).ren id g)
  {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)

theorem small_len (hQ : QOk Q) {k c Bd : ℕ} (hk : k ≤ 3) (hc : c ≤ 5) :
    k * Q.d + c < 2 ^ (Bd + Q.b) ∧ Q.d < 2 ^ (Bd + Q.b) := by
  have hdb : Q.d + 4 ≤ Q.b := hQ.hdb
  have hb : 64 ≤ Q.b := hQ.hb
  have h2 : 4 * Q.b < 2 ^ Q.b := by
    have e : 2 ^ Q.b = 2 ^ (Q.b - 3) * 8 := by
      rw [show (8 : ℕ) = 2 ^ 3 by norm_num, ← pow_add]; congr 1; omega
    have := Nat.lt_two_pow_self (n := Q.b - 3)
    omega
  have h3 : 2 ^ Q.b ≤ 2 ^ (Bd + Q.b) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have : k * Q.d ≤ 3 * Q.d := Nat.mul_le_mul_right _ hk
  constructor <;> omega

theorem cpy_cost_le {k c Bd : ℕ} (desc : List ℤ) (hl : desc.length = k * Q.d + c) (cb : ℕ)
    (hcb : cb ≤ kCpy k desc.length (Bd + Q.b)) (cI : ℕ) (C₀ : ℝ) (A : ℕ)
    (hI : (cI : ℝ) ≤ C₀ * cU6 Q.P Q.n A) :
    (cCallW cb desc.length Bd cI : ℝ) ≤ kCall6 Q k c Bd C₀ A := by
  rw [hl] at hcb
  have hcb' : (cb : ℝ) ≤ (kCpy k (k * Q.d + c) (Bd + Q.b) : ℝ) := by exact_mod_cast hcb
  unfold cCallW kCall6
  rw [hl]
  push_cast
  nlinarith

include hprog hQ in
/-- **The `Φ` (forward) and `Φ⁻¹` calls.** -/
theorem phi_phase6 {eF eB : Fin (7 + E)} {dS : Fin HS} {C₀ : ℝ} {A : ℕ} (hd0 : dS ≠ 0)
    (hP : phiG6 Isym (IL.kTableP tab ext) eF eB dS C₀ A Q)
    (Bd : ℕ) (hBd : ∀ x ∈ Q.dPh, zsz x ≤ Bd)
    (t : IState HS) (hR : Q.Base t) (xs : List ℤ) (R0 : List Item)
    (h0 : t.G 0 = ints xs ++ R0) (hxw : Bnd (Q.p + 2) xs) :
    (xs.length = vol (KFU.shK Q.d (KFU.sP Q.d Q.src)) →
      ∃ c : ℕ, IRuns Isym iprog (callW (cpyD zPh (bX dS) 3 3) (bX dS) (bY dS) dS (g eF)) t
        (t.upd 0 (ints (KFU.PhiD Q.h Q.d Q.bL Q.src Q.mu xs) ++ R0)) c ∧
        (c : ℝ) ≤ kCall6 Q 3 3 Bd C₀ A) ∧
    (xs.length = vol (KFU.shR Q.d (KFU.tP Q.d Q.h Q.bL)) →
      ∃ c : ℕ, IRuns Isym iprog (callW (cpyD zPh (bX dS) 3 3) (bX dS) (bY dS) dS (g eB)) t
        (t.upd 0 (ints (KFU.PhiInvD Q.h Q.d Q.bL Q.src Q.mu xs) ++ R0)) c ∧
        (c : ℝ) ≤ kCall6 Q 3 3 Bd C₀ A) := by
  have hl : Q.dPh.length = 3 * Q.d + 3 := len_descPhi _ _ _ _ _ _
  obtain ⟨hs1, hs2⟩ := small_len hQ (k := 3) (c := 3) (Bd := Bd) (by norm_num) (by norm_num)
  obtain ⟨hok, hrun, hc⟩ := cpy_call (Or.inl rfl) dS t Q.dPh hR.hPh Q.d hR.hD 3 3 hl
    (Bd + Q.b) (fun x hx => (hBd x hx).trans (by omega)) hs1 hs2
  obtain ⟨hF, hB⟩ := hP (wS t dS R0) (wF xs Q.dPh dS) [] wF_nil (wF_dS hd0)
  refine ⟨fun hlx => ?_, fun hlx => ?_⟩
  · obtain ⟨c, hrun', hcst⟩ := hF xs (by rw [wF_zero, List.append_nil]) hlx hxw
    exact ⟨_, callW_I hprog _ hd0 eF t _ _ _ R0 h0 Bd hBd hok hrun hrun',
      cpy_cost_le Q.dPh hl _ hc c C₀ A hcst⟩
  · obtain ⟨c, hrun', hcst⟩ := hB xs (by rw [wF_zero, List.append_nil]) hlx hxw
    exact ⟨_, callW_I hprog _ hd0 eB t _ _ _ R0 h0 Bd hBd hok hrun hrun',
      cpy_cost_le Q.dPh hl _ hc c C₀ A hcst⟩

end Phases

/-! ## The digits after `Φ` -/

theorem hsw_of6 {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1) :
    ∀ j < D + 1, Q.src j ≤ KFU.tP (D + 1) Q.h Q.bL j := by
  intro j hj
  have h1 := (hQ.sB_lt hD ⟨j, hj⟩).le
  have e := congrFun (hQ.tBox_eq6 hD) ⟨j, hj⟩
  simp only [tBox] at e
  rw [e]; exact h1

end

