    fun x => (congrArg (fun ψ : H →ₐ[GaloisRep.ratLocalizedAt p] H => ψ (q x)) hTc).trans (hpt x)
  refine (TorsionTowerHeads.exists_bialgHom_surjective_of_tower I.L p I.H₁ I.e₁ I.he₁_mul
    I.he₁_nat I.H₂ I.e₂ I.he₂_mul I.he₂_nat).elim fun q₀ hq₀' => ?_
