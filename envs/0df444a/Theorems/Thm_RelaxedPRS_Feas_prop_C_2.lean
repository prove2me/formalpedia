-- title:
--   Proposition C.2, p. 36 — for λ_k ∈ (0, 1], ‖z^j − x‖² is nonincreasing for every x ∈ C_f ∩ C_g
-- statement:
--   Let $C_f,C_g$ be closed convex subsets of a real Hilbert space $\mathcal H$ with $C_f\cap C_g\neq\emptyset$. Let $(z^k)_{k\ge0}$ be generated by iteration (5.1) with step sizes $\gamma_{f,k},\gamma_{g,k}>0$ and relaxation parameters $\lambda_k\in(0,1]$. Then for every $x\in C_f\cap C_g$ the sequence
--   $$
--   \big(\|z^j-x\|^2\big)_{j\ge0}
--   $$
--   is nonincreasing.
--
--   This Fejér monotonicity of the iterates with respect to $C_f\cap C_g$ is what turns the distance contraction (5.3) into convergence of the iterates to a single point.
-- source:
--   Davis & Yin, Faster convergence rates of relaxed Peaceman-Rachford and ADMM under regularity assumptions, arXiv:1407.5210v3, p. 36, Proposition C.2

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_RandomGradFree_Nonsmooth_IsMetricProjection
import Definitions.Def_RelaxedPRS_Feas_Setting
open ThreeOpSplitting.ConvexRates RandomGradFree.Nonsmooth Filter Topology

namespace RelaxedPRS.Feas

/-- Proposition C.2, p. 36: if `(z^k)` is generated by (5.1) with `λ_k ∈ (0, 1]`, then
`(‖z^j − x‖²)_{j ≥ 0}` is nonincreasing for every `x ∈ C_f ∩ C_g`. -/
theorem prop_C_2 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Cf Cg : Set H) (hCfc : IsClosed Cf) (hCfv : Convex ℝ Cf) (hCgc : IsClosed Cg)
    (hCgv : Convex ℝ Cg) (hne : (Cf ∩ Cg).Nonempty)
    (γf γg lam : ℕ → ℝ) (hγf : ∀ k, 0 < γf k) (hγg : ∀ k, 0 < γg k)
    (hlam : ∀ k, 0 < lam k ∧ lam k ≤ 1)
    (Pf Pg : ℕ → H → H) (hPf : ∀ k, IsProx (γf k) (dsq Cf) (Pf k))
    (hPg : ∀ k, IsProx (γg k) (dsq Cg) (Pg k))
    (z : ℕ → H) (hz : IsFeasRun Pf Pg lam z) :
    ∀ x ∈ Cf ∩ Cg, Antitone (fun j => ‖z j - x‖ ^ 2) := by sorry

end RelaxedPRS.Feas
