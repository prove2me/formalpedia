/-!
# B-line IL, pre-tables (B5), part 1: magnitude bounds for register expressions

`mg V e`: a crude magnitude bound of the expression `e` when every register `i` it reads holds a
value of absolute value `≤ V i`. It dominates every subterm, so `mg V e < 2^B` gives `e.Bnd s B`
(`bnd_of_mg`): the cost bounds of all pushes/assignments of the pre-table programs reduce to one
numeric inequality per expression.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL

theorem zsz_of_le {z : ℤ} {M B : ℕ} (h : |z| ≤ M) (hM : M < 2 ^ B) : zsz z ≤ B :=
  zsz_le_of_abs (lt_of_le_of_lt h (by exact_mod_cast hM))

/-- **Bounds from magnitudes.** -/
theorem bnd_of_mg_sol_aux (s : IState HS) (V : Fin HS → ℕ) (B : ℕ) :
    ∀ e : Ex HS, (∀ i ∈ e.regs, |s.top i| ≤ V i) → mg V e < 2 ^ B → e.Bnd s B
  | .reg i, h, hm => by
    simp only [Ex.Bnd]; exact zsz_of_le (h i (by simp [Ex.regs])) hm
  | .lit c, _, hm => by
    simp only [Ex.Bnd]; exact zsz_of_le (le_of_eq (Int.abs_eq_natAbs c)) hm
  | .add a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega),
      zsz_of_le (eval_le_mg s V (.add a b) h) (by simp only [mg]; omega)⟩
  | .neg a, h, hm => by
    simp only [Ex.Bnd]
    exact bnd_of_mg_sol_aux s V B a (fun i hi => h i (by simpa only [Ex.regs] using hi)) hm
  | .mul a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega),
      zsz_of_le (eval_le_mg s V (.mul a b) h) (by simp only [mg]; omega)⟩
  | .shl a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega),
      zsz_of_le (eval_le_mg s V (.shl a b) h) (by simp only [mg]; omega)⟩
  | .quo a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega)⟩
  | .rem a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega)⟩
  | .pow2 a, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simpa only [Ex.regs] using hi)
    simp only [mg] at hm
    have h1 : mg V a < B := by
      by_contra hc; push Not at hc
      have : 2 ^ B ≤ 2 ^ mg V a := Nat.pow_le_pow_right (by norm_num) hc
      omega
    have h2 : 2 ^ mg V a < 2 ^ B := by omega
    have hlt : mg V a < 2 ^ mg V a := Nat.lt_two_pow_self
    refine ⟨bnd_of_mg_sol_aux s V B a ha (by omega), ?_⟩
    have := eval_le_mg s V a ha
    have : ((a.eval s).toNat : ℤ) ≤ mg V a := by have := le_abs_self (a.eval s); omega
    omega
  | .sel c x y, h, hm => by
    have hc : ∀ i ∈ c.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hx : ∀ i ∈ x.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hy : ∀ i ∈ y.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    refine ⟨bnd_of_mg_sol_aux s V B c hc (by omega), ?_⟩
    split_ifs
    · exact bnd_of_mg_sol_aux s V B x hx (by omega)
    · exact bnd_of_mg_sol_aux s V B y hy (by omega)
  | .ndiv a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega),
      zsz_of_le (eval_le_mg s V (.ndiv a b) h) (by simp only [mg]; omega)⟩
  | .nmod a b, h, hm => by
    have ha : ∀ i ∈ a.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    have hb : ∀ i ∈ b.regs, |s.top i| ≤ V i := fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto)
    simp only [mg] at hm
    exact ⟨bnd_of_mg_sol_aux s V B a ha (by omega), bnd_of_mg_sol_aux s V B b hb (by omega),
      zsz_of_le (eval_le_mg s V (.nmod a b) h) (by simp only [mg]; omega)⟩

