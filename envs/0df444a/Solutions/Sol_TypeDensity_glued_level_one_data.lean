    congr 1
    unfold TypeDensity.leftLevelKernel TypeDensity.finiteSupportLevelKernel
    exact Ideal.map_map _ _
  -- `P = ∏ g Q ^ Dv Q` is monic of degree `deg Dv - Dv ∞`
