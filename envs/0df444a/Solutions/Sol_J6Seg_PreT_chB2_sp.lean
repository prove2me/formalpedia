* **`chunkK_rowBody6`**: if procedure `e` is `chunkI pM`, it is a `RowBody6` row kernel for the
  line's chunk kernel `liftG (chunkK P R s t λ α q)` with the tables
  `tabK P pk b λ diL giL gamL ddL (descsOf … q)` (= `chunkTab6` at the round-six parameters).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

section desc
variable {s t lam : ℕ}

theorem blFrom_bnd (hl : 1 ≤ lam) (c : ℕ) : ∀ (f st : ℕ), c * lam ≤ st →
    (∀ b ∈ blFrom s t lam (min s (c * lam + lam)) f st, 1 ≤ b.2 ∧ b.2 ≤ lam) ∧
    ((blFrom s t lam (min s (c * lam + lam)) f st).map Prod.snd).sum + st ≤
      max st (c * lam + lam)
  | 0, st, _ => by simp [blFrom]
  | f + 1, st, hst => by
    unfold blFrom
    split_ifs with h
    · have he := en_le_chunk (s := s) (t := t) hl hst (lt_of_lt_of_le h (min_le_right _ _))
      obtain ⟨ih1, ih2⟩ := blFrom_bnd hl c f (st + 1 + enF s t lam st) (by omega)
      refine ⟨fun b hb => ?_, ?_⟩
      · rcases List.mem_cons.1 hb with rfl | hb
        · simp only; omega
        · exact ih1 b hb
      · simp only [List.map_cons, List.sum_cons]
        have : max (st + 1 + enF s t lam st) (c * lam + lam) = c * lam + lam := by omega
        rw [this] at ih2
        omega
    · simp

theorem sumN_map (l : List (ℕ × ℕ)) (F G : ℕ → ℕ → ℤ) :
    sumN (l.map fun b => (b.2, (List.range b.2).map (F b.1), (List.range b.2).map (G b.1))) =
      (l.map Prod.snd).sum := by
  induction l with
  | nil => rfl
  | cons b l ih => simp only [List.map_cons, sumN, List.sum_cons]; rw [ih]

theorem sumN_descsOf (hl : 1 ≤ lam) (T : Tables) (c : ℕ) : sumN (descsOf s t lam T c) ≤ lam := by
  unfold descsOf chunkBl
  rw [sumN_map]
  have := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).2
  omega

theorem descsOf_ok (hl : 1 ≤ lam) (T : Tables) (c : ℕ) :
    ∀ d ∈ descsOf s t lam T c, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
      (∀ v ∈ d.2.1, ∃ h < d.1, ∃ c', v = T.am c' h) ∧ (∀ v ∈ d.2.2, ∃ h < d.1, ∃ c', v = T.ap c' h) := by
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  obtain ⟨h1, h2⟩ := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).1 b hb
  refine ⟨h1, by simp, by simp, h2, ?_, ?_⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩

end desc

end J6Seg.KR

end

section
-- Source module: Solutions.J6SegILPre5
/-!
# B-line IL, pre-tables (B5), part 5: the fixed-point expressions

Register conventions (all in `rg`): `20 = P`, `21 = R`, `22 = s`, `23 = t`, `24 = λ`, `25 = α`,
`9 = 2^P`, `10 = 2^{P+1}`; `1 = c` (block start), `2 = n` (block length); work `4 = Γ`, `5 = ±1`,
`11 = X`, `12 = U` (loop index).

* `fmE x y` evaluates to `fmul P x y`, `fdE x y` to `fdiv P x y`;
* `jDE` (`α²(t-s)U²`), `jQE` (`2α²t(U+1)`), `jME`/`jPE` (`α²(t ∓ 2β_c)⁺U`) the exponent arguments
  of the tables of `mkTables` (`J6SegTab`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## Evaluation -/

theorem ev_reg {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (Ex.reg j).eval (encK s (RF v c)) = v j := top_RF h

theorem mx0_eval (t : IState HS) (x : Ex HS) : (mx0 x).eval t = max (x.eval t) 0 := by
  simp only [mx0, Ex.eval]; split_ifs with h
  · rw [max_eq_right h.le]
  · rw [max_eq_left (by omega)]

section ev
variable {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {P : ℕ}

theorem fdE_eval (h9 : v 9 = 2 ^ P) (x y : Ex HS) :
    (fdE x y).eval (encK s (RF v c)) =
      J6Seg.fdiv P (x.eval (encK s (RF v c))) (y.eval (encK s (RF v c))) := by
  simp only [fdE, NLogN.Ex.ediv_eval, Ex.eval, top_RF (show (9 : Fin HS) ∈ rg by decide), h9,
    J6Seg.fdiv, J6Seg.rq]

theorem jDE_eval {sN tN aN u : ℕ} (h22 : v 22 = sN) (h23 : v 23 = tN) (h25 : v 25 = aN)
    (h12 : v 12 = u) : jDE.eval (encK s (RF v c)) = ((aN ^ 2 * (tN - sN) * u ^ 2 : ℕ) : ℤ) := by
  simp only [jDE, Ex.eval, mx0_eval, top_RF (show (22 : Fin HS) ∈ rg by decide),
    top_RF (show (23 : Fin HS) ∈ rg by decide), top_RF (show (25 : Fin HS) ∈ rg by decide),
    top_RF (show (12 : Fin HS) ∈ rg by decide), h22, h23, h25, h12]
  rcases le_total sN tN with h | h
  · rw [max_eq_left (by omega)]; push_cast [Nat.cast_sub h]; ring
  · rw [max_eq_right (by omega), Nat.sub_eq_zero_of_le h]; simp

end ev

/-! ## Side conditions -/

/-- `ok` on the register file for expressions reading `rg` only. -/
theorem ok_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} (he : InRg e)
    (hs : Safe e = true) : e.ok (encK s (RF v c)) := by
  -- only the registers of `e` matter
  have : ∀ e : Ex HS, InRg e → Safe e = true → e.ok (encK s (RF v c)) := by
    intro e
    induction e with
    | reg j => intro h _; exact isInt_RF (h j (by simp [Ex.regs]))
    | lit _ => intro _ _; trivial
    | add a b iha ihb | mul a b iha ihb =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      exact ⟨iha (fun i hi => h i (by simp [Ex.regs, hi])) hs.1,
        ihb (fun i hi => h i (by simp [Ex.regs, hi])) hs.2⟩
    | neg a ih => intro h hs; exact ih (fun i hi => h i (by simpa [Ex.regs] using hi)) hs
    | sel c x y ihc ihx ihy =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      refine ⟨ihc (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.1, ?_⟩
      split_ifs
      · exact ihx (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.2
      · exact ihy (fun i hi => h i (by simp [Ex.regs, hi])) hs.2
    | _ => intro _ hs; simp [Safe] at hs
  exact this e he hs

theorem ok_ediv {t : IState HS} {a b : Ex HS} (ha : a.ok t) (hb : b.ok t) :
    (NLogN.Ex.ediv a b).ok t := NLogN.Ex.ediv_ok ha hb

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre6
/-!
# B-line IL, pre-tables (B5), part 6: the call loop

`cLoop O cl` = `U := 0; repeat N = v 24 times { cl; push X on O; U := U + 1 }` where the call `cl`
sets `X = v 11 := f U`. `cLoop_sp`: it pushes `f 0, …, f (N-1)` onto `O` (so `O` gains `rv f N`);
the registers end as `wS v f N` (only `11, 12` change).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem wS_12 (v : Fin HS → ℤ) (f : ℕ → ℤ) : ∀ k, wS v f k 12 = k
  | 0 => by simp [wS]
  | k + 1 => by simp [wS]

theorem wS_oth (v : Fin HS → ℤ) (f : ℕ → ℤ) {j : Fin HS} (h11 : j ≠ 11) (h12 : j ≠ 12) :
    ∀ k, wS v f k j = v j
  | 0 => by simp [wS, h12]
  | k + 1 => by simp [wS, h11, h12, wS_oth v f h11 h12 k]

theorem VB_upd {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) (j : Fin HS) {a : ℤ} (ha : |a| ≤ 2 ^ A) :
    VB (Function.update v j a) A := by
  intro i hi
  by_cases e : i = j
  · subst e; simpa using ha
  · rw [Function.update_of_ne e]; exact h i hi

theorem wS_VB {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) (f : ℕ → ℤ) {N : ℕ} (hN : N ≤ 2 ^ A)
    (hf : ∀ k < N, |f k| ≤ 2 ^ A) : ∀ k ≤ N, VB (wS v f k) A
  | 0, _ => VB_upd h 12 (by simp)
  | k + 1, hk => VB_upd (VB_upd (wS_VB h f hN hf k (by omega)) 11 (hf k (by omega))) 12
      (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast (show k + 1 ≤ 2 ^ A by omega))

theorem zsz_of_VB {a : ℤ} {A : ℕ} (h : |a| ≤ 2 ^ A) : zsz a ≤ BW A :=
  zsz_of_le (M := 2 ^ A) h (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))

theorem mgB {A : ℕ} (hA : 2 ≤ A) {e : Ex HS} (hp : Poly e = true) (hd : dg e ≤ 40) :
    mg (fun _ => 2 ^ A) e < 2 ^ BW A := mg_lt (fun _ => le_rfl) hA hp hd

theorem vb_regs {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) {e : Ex HS} (he : InRg e) :
    ∀ j ∈ e.regs, |v j| ≤ (fun _ => 2 ^ A) j := fun j hj => h j (he j hj)

theorem inRg_reg {j : Fin HS} (h : j ∈ rg) : InRg (.reg j) := by
  intro i hi; simp [Ex.regs] at hi; subst hi; exact h

theorem cLoop_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS} (hO : O ∉ rg)
    (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {cl : RS} (hw : Cu ∉ cl.writes)
    {A N : ℕ} (hA : 2 ≤ A) (hv : VB v A) (h24 : v 24 = N) (hN : N ≤ 2 ^ A) (f : ℕ → ℤ)
    (W W' : ℕ → Fin HS → ℤ) (hW0 : W 0 = Function.update v 12 0)
    (hWs : ∀ k, W (k + 1) = Function.update (W' k) 12 (k + 1))
    (hW11 : ∀ k < N, W' k 11 = f k) (hW12 : ∀ k < N, W' k 12 = k)
    (hWV : ∀ k < N, VB (W' k) A) {Cc : ℕ}
    (hcl : ∀ k < N, ∀ cc : Fin HS → List ℤ,
      Sp cl (encK s (RF (W k) cc)) (encK s (RF (W' k) cc)) Cc) :
    Sp (cLoop O cl) (encK s (RF v c)) (encK s (RF (W N) (Function.update c O (rv f N ++ c O))))
      (cE (.lit 0) (BW A) + (2 * 2000 * (BW A + 2) + N * (Cc + cE (.reg 11) (BW A) +
        cE (.add (.reg 12) (.lit 1)) (BW A) + 8000 * (BW A + 2) + 30) + 32)) :=
  cLoopR_sp (by decide) (by decide) s v c hO hO5 hOC hc hw hA hv h24 hN f W W' hW0 hWs hW11 hW12
    hWV hcl

/-- The call loop with a call changing only `11` (`W = wS v f`). -/
theorem cLoop_sp1 (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {cl : RS}
    (hw : Cu ∉ cl.writes) {A N : ℕ} (hA : 2 ≤ A) (hv : VB v A) (h24 : v 24 = N)
    (hN : N ≤ 2 ^ A) (f : ℕ → ℤ) (hf : ∀ k < N, |f k| ≤ 2 ^ A) {Cc : ℕ}
    (hcl : ∀ k < N, ∀ (w : Fin HS → ℤ) (cc : Fin HS → List ℤ), VB w A → w 12 = k →
      (∀ j, j ≠ 11 → j ≠ 12 → w j = v j) →
      Sp cl (encK s (RF w cc)) (encK s (RF (Function.update w 11 (f k)) cc)) Cc) :
    Sp (cLoop O cl) (encK s (RF v c)) (encK s (RF (wS v f N) (Function.update c O (rv f N ++ c O))))
      (cE (.lit 0) (BW A) + (2 * 2000 * (BW A + 2) + N * (Cc + cE (.reg 11) (BW A) +
        cE (.add (.reg 12) (.lit 1)) (BW A) + 8000 * (BW A + 2) + 30) + 32)) :=
  cLoop_sp s v c hO hO5 hOC hc hw hA hv h24 hN f (wS v f)
    (fun k => Function.update (wS v f k) 11 (f k)) rfl (fun k => by simp [wS])
    (fun k _ => by simp) (fun k _ => by simp [Function.update_of_ne (show (12 : Fin HS) ≠ 11 by decide), wS_12])
    (fun k hk => VB_upd (wS_VB hv f hN hf k hk.le) 11 (hf k hk))
    (fun k hk cc => hcl k hk (wS v f k) cc (wS_VB hv f hN hf k hk.le) (wS_12 v f k)
      (fun j h1 h2 => wS_oth v f h1 h2 k))

end J6Seg.PreT

end

