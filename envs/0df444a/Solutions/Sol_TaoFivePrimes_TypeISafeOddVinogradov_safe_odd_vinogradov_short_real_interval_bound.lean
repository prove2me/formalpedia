theorem safe_perturbed_rational_grid_block_bound
    (a q : ℕ) (hq : 2 ≤ q) (haq : Nat.Coprime a q)
    (beta phi A B : ℝ)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (∑ j ∈ Finset.range q,
      safeCappedCosecant A B
        (Real.pi * perturbedPhase a q beta phi j)) ≤
      2 * A + (2 / Real.pi) * B * (q : ℝ) *
        Real.log (4 * (q : ℝ)) := by
  obtain ⟨e, rank, hes, hecard, hinj, hrange, hsep⟩ :=
    perturbed_grid_sine_rank_certificate a q hq haq beta phi hbeta
  exact safe_block_bound_of_rank_certificate q hq A B hA hB
    (Finset.range q) e rank
    (fun j ↦ Real.pi * perturbedPhase a q beta phi j)
    hes hecard hrange hinj hsep
theorem safe_perturbed_rational_grid_range_bound
    (a q L : ℕ) (hq : 2 ≤ q) (haq : Nat.Coprime a q)
    (beta phi A B : ℝ)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (∑ j ∈ Finset.range L,
      safeCappedCosecant A B
        (Real.pi * perturbedPhase a q beta phi j)) ≤
      (((L - 1) / q + 1 : ℕ) : ℝ) *
        (2 * A + (2 / Real.pi) * B * (q : ℝ) *
          Real.log (4 * (q : ℝ))) := by
  let f : ℕ → ℝ := fun j ↦
    safeCappedCosecant A B (Real.pi * perturbedPhase a q beta phi j)
  let C : ℝ := 2 * A + (2 / Real.pi) * B * (q : ℝ) *
    Real.log (4 * (q : ℝ))
  apply sum_range_le_blocks q L (by omega) f C
  · intro j
    exact safeCappedCosecant_nonneg hA hB
  · intro start
    have hb := safe_perturbed_rational_grid_block_bound a q hq haq beta
      (phi + ((a : ℝ) / (q : ℝ) + beta) * (start : ℝ))
      A B hbeta hA hB
    dsimp [f, C]
    convert hb using 1
    apply Finset.sum_congr rfl
    intro t ht
    rw [perturbedPhase_add]
theorem safe_odd_progression_vinogradov_range_bound
    (a q m0 L : ℕ) (hq : 2 ≤ q) (haq : Nat.Coprime a q)
    (alpha beta theta A B : ℝ)
    (halpha : 2 * alpha = (a : ℝ) / (q : ℝ) + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2)
    (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (∑ j ∈ Finset.range L,
      safeCappedCosecant A B
        (Real.pi * alpha * (2 * ((m0 + j : ℕ) : ℝ) + 1) + theta)) ≤
      (((L - 1) / q + 1 : ℕ) : ℝ) *
        (2 * A + (2 / Real.pi) * B * (q : ℝ) *
          Real.log (4 * (q : ℝ))) := by
  have hb := safe_perturbed_rational_grid_range_bound a q L hq haq beta
