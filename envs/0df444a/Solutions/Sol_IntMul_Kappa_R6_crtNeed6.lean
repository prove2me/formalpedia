  have hh1 : 1 ≤ h := by omega
  have hdhℓ : d * h = d * ℓ - d := by rw [hhN, Nat.mul_sub_one]
  have hdh' : h ≤ d * h := Nat.le_mul_of_pos_left _ (by omega)
  have hhL : h ≤ L := by omega
  have hdL : d ≤ L := by
    have : d * 2 ≤ d * ℓ := Nat.mul_le_mul_left _ hl2
    omega
  have hp6 : 6 ≤ p := by omega
  -- the table
  set ext := mExt4 ext₁ KFUU.ext0 KFUU.ext0 KFUU.ext0 own with hext
  set eSw := g4₁ E₁ 0 0 0 2 entry with heSw
  have hM : MulOK Isym (IL.kTableP tab ext) (KFM.pMul _) MS := IL.kTableP_mulOK tab ext
  have hK : SwOKτ P.τ Isym (IL.kTableP tab ext) eSw sdS K := by
    intro u w' sh p' q hu hpos hpq hq gp gq s' f' zs l' hf' hfd' h0' hlen' hgb'
    obtain ⟨c, H', hc⟩ := hS Isym u w' sh p' q hu hpos hpq hq gp gq s' f' zs l' hf' hfd' h0' hlen' hgb'
    exact ⟨c, KFM.IRuns.relabel (mTab4_g1 tab ext₁ KFUU.ext0 KFUU.ext0 KFUU.ext0 own) H', by
      unfold cSwNτ; exact hc⟩
  obtain ⟨hDsc, hDd⟩ := dscOf_spec sdS
  have hown0 : IL.kTableP tab ext (gO4 E₁ 0 0 0 2 0) = phiFE (KFM.pMul _) eSw sdS (dscOf sdS) := by
    show mTab4 tab ext₁ KFUU.ext0 KFUU.ext0 KFUU.ext0 own (gO4 E₁ 0 0 0 2 0) = _
    rw [mTab4_own]; rfl
  have hown1 : IL.kTableP tab ext (gO4 E₁ 0 0 0 2 1) = phiBE (KFM.pMul _) eSw sdS (dscOf sdS) := by
    show mTab4 tab ext₁ KFUU.ext0 KFUU.ext0 KFUU.ext0 own (gO4 E₁ 0 0 0 2 1) = _
    rw [mTab4_own]; rfl
  -- the sizes
  set VT := vol (shR d (tP d h bL)) with hVT
  set VS := vol (shR d (sP d src)) with hVS
  set PM := vol ((List.range (d - 1)).map src) with hPM
  have hST : VS ≤ VT := VS_le_VT d h bL src hst
  have hsizeT : Nat.size (2 * T) ≤ L + 2 := by
    rw [hTL, ← pow_succ', Nat.size_pow]
    try omega
  have hsizeVS : Nat.size VS ≤ L + 2 := le_trans (Nat.size_le_size (by omega)) hsizeT
  -- `PM · 2^h ≤ 2T`
  have hPMs : PM * src (d - 1) * 2 = VS := by
    rw [hVS, VS_eq]
    have : Pv src d = Pv src (d - 1) * src (d - 1) := by
      rw [show d = (d - 1) + 1 by omega, Pv_succ]; rfl
    rw [this]; rfl
  have hPMh : PM * 2 ^ h ≤ 2 * T := by
    have h1 := hs2 (d - 1) (by omega)
    have h2 : PM * 2 ^ h ≤ PM * (2 * src (d - 1)) := Nat.mul_le_mul_left _ h1
    have e : PM * (2 * src (d - 1)) = PM * src (d - 1) * 2 := by ring
    omega
  -- the bounds of `phiFE_runs`
  have zw : zsz (w : ℤ) ≤ w := zsz_le_self w
  have zd : zsz (d : ℤ) ≤ d := zsz_le_self d
  have z3 : zsz ((3 + 3 * d : ℕ) : ℤ) ≤ 3 + 3 * d := zsz_le_self _
  have z2h : zsz ((2 ^ h * 2 : ℕ) : ℤ) ≤ h + 2 := zsz_le_of_lt (by
    simp only [Int.natAbs_natCast]; rw [pow_add]; have := Nat.one_le_two_pow (n := h); omega)
  have zh : zsz ((2 ^ h : ℕ) : ℤ) ≤ h + 1 := zsz_le_of_lt (by
    simp only [Int.natAbs_natCast]; rw [pow_succ]; have := Nat.one_le_two_pow (n := h); omega)
  have zSS : zsz (VS : ℤ) ≤ zsz ((2 * VS : ℕ) : ℤ) := zsz_natCast_le' (by omega)
  have zVT : zsz (VT : ℤ) ≤ L + 2 := le_trans (zsz_le_size' VT) (by rw [hVT2]; exact hsizeT)
  have zBb : zsz ((2 * VS : ℕ) : ℤ) ≤ L + 3 := by
    refine le_trans (zsz_le_size' _) ?_
    have : Nat.size (2 * VS) ≤ Nat.size (2 * (2 * T)) := Nat.size_le_size (by omega)
    have e : Nat.size (2 * (2 * T)) ≤ L + 3 := by
      rw [hTL, ← pow_succ', ← pow_succ', Nat.size_pow]
      try omega
    omega
  have hZ : zsz (VT : ℤ) + w + h + 3 ≤ 3 * p := by omega
  -- the cost chain, for either direction
  have hT0 := T0_le w d h VT VS PM (zsz ((2 * VS : ℕ) : ℤ)) p T hVT2 rfl hp6 hST
    (by omega) (by omega) hPMh hdh hpT
  have hNat := natCost_le w h d VT VS PM (VT_ge d h bL hh1) hST
    (by have := Pv_pos src hs d le_rfl; rw [hVS, VS_eq]; omega)
    (PM_le d src hs).1 (PM_le d src hs).2 (by intro h0; omega)
  have hTb' : (d + 2) * (CU * (zsz (VT : ℤ) + w + h + 3 + 1) ^ 2 + 5 * (zsz (VT : ℤ) + w + h + 3) +
      10 ^ 4) ≤ T := by
    refine le_trans (Nat.mul_le_mul_left _ ?_) hTbig
    have a1 : CU * (zsz (VT : ℤ) + w + h + 3 + 1) ^ 2 ≤ CU * (3 * p + 1) ^ 2 :=
      Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) 2)
    have a2 : 5 * (zsz (VT : ℤ) + w + h + 3) ≤ 15 * p := by omega
    exact Nat.add_le_add_right (Nat.add_le_add a1 a2) _
  have hRest := rest_le h d w (zsz (VT : ℤ) + w + h + 3) VT p T hVT2 rfl hp6 hZ hdh hTb'
  have hsw : ∀ bs : List Bool, bs.length = d → vol (shP h bs) * 2 = VT →
      cSwNτ P.τ K w (h * (d / 2))
        [1, (2 ^ h) ^ (d / 2), (2 ^ h) ^ (d - 2 * (d / 2)), (2 ^ h) ^ (d / 2), vol (ctB h 2 bs) * 1] ≤
      K * (4 * (T : ℝ) * p * ((ℓ : ℝ) * ((d : ℝ) * Real.log p) ^ P.τ) +
        96 * (T : ℝ) * p) := by
    intro bs hbs hV2
    have hvc := vol_ctB h 2 bs (by norm_num)
    rw [hbs] at hvc
    have hvol : vol [1, (2 ^ h) ^ (d / 2), (2 ^ h) ^ (d - 2 * (d / 2)), (2 ^ h) ^ (d / 2),
        vol (ctB h 2 bs) * 1] = T := by
      simp only [vol_cons, vol_nil, mul_one, one_mul]
      have e : (2 ^ h) ^ (d / 2) * ((2 ^ h) ^ (d - 2 * (d / 2)) * ((2 ^ h) ^ (d / 2) *
          vol (ctB h 2 bs))) = (2 ^ h) ^ d * vol (ctB h 2 bs) := by
        rw [← mul_assoc, ← mul_assoc, ← pow_add, ← pow_add]; congr 2; omega
      rw [e, hvc]
      have : vol (shP h bs) * 2 = 2 * T := by rw [hV2, hVT2]
      omega
    refine swapE_le P.τ K hK0 hP.tau_pos.le hP.tau_le w (h * (d / 2)) _ p T ℓ d rfl hvol
      rfl hp6 ?_ (by omega) ?_ hpT
    · have hhl : h ≤ ℓ := by omega
      exact Nat.mul_le_mul hhl (Nat.div_le_self _ _)
    · have hsz : Nat.size T ≤ L + 1 := by
        rw [hTL, Nat.size_pow]
        try omega
      have e1 : h * (d / 2) ≤ d * h := by
        rw [mul_comm d]; exact Nat.mul_le_mul_left _ (Nat.div_le_self _ _)
      omega
  have hx0 : ∀ bs : List Bool, 0 ≤ cSwNτ P.τ K w (h * (d / 2))
      [1, (2 ^ h) ^ (d / 2), (2 ^ h) ^ (d - 2 * (d / 2)), (2 ^ h) ^ (d / 2), vol (ctB h 2 bs) * 1] := by
    intro bs; exact cSwNτ_nonneg P.τ K hK0 _ _ _
  have hfd' : f NLogN.KFUU.dP = KFM.descPhi w h d bL src μ := by rw [hfd]; rfl
  constructor
  · intro xs h0 hlen hb
    have R := phiFE_runs (τ := P.τ) hM hK hdS hDsc hDd w h d bL src μ hh1 hd2 hs hst hμ s f l hf
      hfd' xs h0 hlen hb
      (w + h + 3 * d + zsz (VS : ℤ) + 3) (zsz (VT : ℤ) + w + h + 3)
      (zsz ((2 * VS : ℕ) : ℤ) + d) (zsz ((2 * VS : ℕ) : ℤ)) (by omega) (by omega) (by omega)
      (by omega) (by show zsz ((VS : ℕ) : ℤ) ≤ _; omega) (by omega)
      (by show zsz ((VT : ℕ) : ℤ) ≤ _; omega) (by omega) (by omega)
      (by show zsz ((VS : ℕ) : ℤ) ≤ _; omega) (by omega) zSS
    refine ⟨_, IRuns.call (by rw [hown0]; exact R), ?_⟩
    have hc := cFwdE_nat P.τ K w h d bL src (w + h + 3 * d + zsz (VS : ℤ) + 3)
      (zsz (VT : ℤ) + w + h + 3) (zsz ((2 * VS : ℕ) : ℤ) + d) (zsz ((2 * VS : ℕ) : ℤ))
      (vol_shP_rev_two d h bL)
    rw [cP2E_split] at hc
    refine crt_absorb P n hp6 K hK0 C1 _ _ _ _ (hx0 _) ?_ hT0 hRest
      (hsw _ (by rw [List.length_reverse, length_bsL]) (vol_shP_rev_two d h bL))
    rw [← hVT, ← hVS, ← hPM] at hc
    generalize C1 = c1 at hNat ⊢
    omega
  · intro ys h0 hlen hb
    have R := phiBE_runs (τ := P.τ) hM hK hdS hDsc hDd w h d bL src μ hh1 hd2 hs hst hμ s f l hf
      hfd' ys h0 hlen hb
      (w + h + 3 * d + zsz (VS : ℤ) + 3) (zsz (VT : ℤ) + w + h + 3)
      (zsz ((2 * VS : ℕ) : ℤ) + d) (zsz ((2 * VS : ℕ) : ℤ)) (by omega) (by omega) (by omega)
      (by omega) (by show zsz ((VS : ℕ) : ℤ) ≤ _; omega) (by omega)
      (by show zsz ((VT : ℕ) : ℤ) ≤ _; omega) (by omega) (by omega)
      (by show zsz ((VS : ℕ) : ℤ) ≤ _; omega) (by omega) zSS
    refine ⟨_, IRuns.call (by rw [hown1]; exact R), ?_⟩
    have hc := cBwdE_nat P.τ K w h d bL src (w + h + 3 * d + zsz (VS : ℤ) + 3)
      (zsz (VT : ℤ) + w + h + 3) (zsz ((2 * VS : ℕ) : ℤ) + d) (zsz ((2 * VS : ℕ) : ℤ))
      (vol_shP_two d h bL)
    rw [cP2E_split] at hc
    refine crt_absorb P n hp6 K hK0 C1 _ _ _ _ (hx0 _) ?_ hT0 hRest
      (hsw _ (length_bsL d bL) (vol_shP_two d h bL))
    rw [← hVT, ← hVS, ← hPM] at hc
    generalize C1 = c1 at hNat ⊢
    omega

end

