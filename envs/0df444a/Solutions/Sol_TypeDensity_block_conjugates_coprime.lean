  rw [TypeDensity.map_frobeniusIter_baseReduce O Φ hΦ r i _ hb, TypeDensity.map_frobeniusIter_baseReduce O Φ hΦ r j _ hb]
  exact ((TypeDensity.conjugate_roots_distinct O Φ hΦ).2.2.2.2.2 i j hij).pow
