-- title:
--   Lemma 5.4 — the subgroup of $T_1$ generated by $A$ and $B$ is isomorphic to $F$
-- statement:
--   The subgroup of $T_1$ generated by the symbols $A$ and $B$ is isomorphic to Thompson's group $F$, by an isomorphism sending $A$ to $F$'s generator $A$ and $B$ to $B$.
--
--   **Formalization Note.** The source states only "isomorphic"; its proof, and every later use (the elements $X_n$ on p. 236, the map $\alpha$ in the proof of Theorem 5.8), rely on the isomorphism matching generators, so that is stated. The membership proofs of $A$, $B$ in the subgroup are universally quantified, so the conditions are not vacuous.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathématique (2) 42 (1996) 215–256, https://doi.org/10.5169/seals-87877, section 5, p. 236, Lemma 5.4

import Mathlib
import Definitions.Def_CannonFloydParry
import Definitions.Def_CannonFloydParry_T

namespace CannonFloydParry

theorem exists_mulEquiv_closure_A_B_F :
    ∃ e : Subgroup.closure
        {(PresentedGroup.of FormalABC.A : T1), PresentedGroup.of FormalABC.B} ≃* F,
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.A, h⟩ : F) : UI ≃o UI) = mapA) ∧
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.B, h⟩ : F) : UI ≃o UI) = mapB) := by
  sorry

end CannonFloydParry
