theorem NLogN.Rsp.j_step_run (p s t α : ℕ) (hs : 0 < s) (u : List (ℤ × ℤ)) (hu : u.length = s)
    (s1 : IState HS) (RU RA LS LL : List Item) (hE : EParams s1 p s t α)
    (hL : s1.G JL = .int ((2 * s : ℕ) : ℤ) :: LL) (S0 : IState HS) (N j : ℕ) :
    jBody.run (withCtr JC S0 N j (jSt s1 p s t α u RU RA LS j)) =
      withCtr JC S0 N j (jSt s1 p s t α u RU RA LS (j + 1)) := by sorry
