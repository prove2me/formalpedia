section s385
set_option autoImplicit false
open Filter
open scoped Topology
namespace DecrAlmostLinearSSSP.Decremental
lemma cutLogHeight_ge_two (m : ℕ) : 2 ≤ cutLogHeight m := by
  have hp := Exact.height_spec (max 2 m)
  change max 2 m < 2^cutLogHeight m at hp
  by_contra hh
  have hl : cutLogHeight m ≤ 1 := by omega
  have hpow := Nat.pow_le_pow_right (by norm_num : 0 < 2) hl
  norm_num at hpow
  have hm : 2 ≤ max 2 m := le_max_left _ _
  omega
lemma cutLogHeight_log_lower (m : ℕ) :
    (cutLogHeight m : ℝ)*Real.log 2 ≤ 2*Real.log (max 2 m : ℕ) := by
  have ht := cutLogHeight_ge_two m
  have hmin := Exact.height_minimal (max 2 m) (cutLogHeight m-1) (by change cutLogHeight m-1 < cutLogHeight m;omega)
  have hpow : (2 : ℝ)^(cutLogHeight m-1) ≤ (max 2 m : ℕ) := by exact_mod_cast hmin
  have hl := Real.log_le_log (pow_pos (by norm_num : (0 : ℝ) < 2) _) hpow
  rw [Real.log_pow] at hl
  have ht' : (cutLogHeight m : ℝ) ≤ 2*((cutLogHeight m-1 : ℕ) : ℝ) := by
    exact_mod_cast (show cutLogHeight m ≤ 2*(cutLogHeight m-1) by omega)
  have hh := mul_le_mul_of_nonneg_right ht' (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  linarith only [hl,hh]
lemma cutLogHeight_log_upper (m : ℕ) : Real.log (max 2 m : ℕ) ≤ (cutLogHeight m : ℝ) := by
  have hp := Exact.height_spec (max 2 m)
  have hp' : (max 2 m : ℕ) ≤ (2 : ℝ)^cutLogHeight m := by exact_mod_cast hp.le
  have hm : (0 : ℝ) < (max 2 m : ℕ) := by exact_mod_cast (show 0 < max 2 m by omega)
  have hl := Real.log_le_log hm hp'
  rw [Real.log_pow] at hl
  have hlog : Real.log 2 ≤ 1 := by
    have hh := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh
    exact hh
  have hh := mul_le_mul_of_nonneg_left hlog (Nat.cast_nonneg (cutLogHeight m) : (0 : ℝ) ≤ cutLogHeight m)
  linarith only [hl,hh]
lemma cutRoot_ge_two (m : ℕ) : 2 ≤ cutRoot m := by
  have ht := cutLogHeight_ge_two m
  have hh : 1 ≤ Nat.nthRoot 12 (cutLogHeight m) := (Nat.le_nthRoot_iff (by norm_num : (12 : ℕ) ≠ 0)).mpr (by simp;omega)
  dsimp [cutRoot]
  omega
lemma cutRoot_power_lower (m : ℕ) : cutLogHeight m < (cutRoot m)^12 :=
  Nat.lt_pow_nthRoot_add_one (by norm_num) _
lemma cutRoot_power_upper (m : ℕ) : (cutRoot m : ℝ)^12 ≤ 4096*(cutLogHeight m : ℝ) := by
  have hroot := cutRoot_ge_two m
  have hf : (Nat.nthRoot 12 (cutLogHeight m))^12 ≤ cutLogHeight m :=
    Nat.pow_nthRoot_le_iff.mpr (Or.inl (by norm_num))
  have hf' : ((Nat.nthRoot 12 (cutLogHeight m) : ℕ) : ℝ)^12 ≤ (cutLogHeight m : ℝ) := by exact_mod_cast hf
  have hr : (cutRoot m : ℝ) ≤ 2*(Nat.nthRoot 12 (cutLogHeight m) : ℝ) := by
    dsimp [cutRoot] at hroot ⊢
    norm_cast
    omega
  calc
    _ ≤ (2*(Nat.nthRoot 12 (cutLogHeight m) : ℝ))^12 := pow_le_pow_left₀ (Nat.cast_nonneg _) hr _
    _ = 4096*((Nat.nthRoot 12 (cutLogHeight m) : ℕ) : ℝ)^12 := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hf' (by norm_num)
lemma cutRoot_log_power_bound (m : ℕ) :
    (cutRoot m : ℝ)^12*Real.log 2 ≤ 8192*Real.log (max 2 m : ℕ) := by
  have h1 := mul_le_mul_of_nonneg_right (cutRoot_power_upper m) (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  have h2 := cutLogHeight_log_lower m
  nlinarith only [h1,h2]
end DecrAlmostLinearSSSP.Decremental
end s385
section s386
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma heightStart_eval (s : Data) : Eval heightStart s 3 (heightStarted s) := eval_sequence_atoms heightStartAtoms s
lemma heightBody_eval (s : Data) : Eval heightBody s 2 (heightAdvanced s) := eval_sequence_atoms heightBodyAtoms s
lemma heightStarted_rep (s : Data) (m : ℕ) (hsize : s.natReg 64 = m) (hunit : s.natReg 26 = 1) :
    HeightRep m (heightStarted s) ∧ (heightStarted s).natReg 404 = 0 := by
  simp only [heightStarted,heightStartAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  refine ⟨?_,True.intro⟩
  constructor <;> simp [hsize,hunit]
lemma heightAdvanced_fields (s : Data) (hunit : s.natReg 26 = 1) :
    (heightAdvanced s).natReg 402 = 2*s.natReg 402 ∧
    (heightAdvanced s).natReg 404 = s.natReg 404+1 ∧
    (heightAdvanced s).natReg 406 = s.natReg 406 ∧
    (heightAdvanced s).natReg 64 = s.natReg 64 ∧
    (heightAdvanced s).natReg 26 = 1 := by
  simp only [heightAdvanced,heightBodyAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  simp [hunit,two_mul]
lemma heightRep_test (m : ℕ) (hm : 2 ≤ m) (s : Data) (h : HeightRep m s)
    (htest : (Test.natLess 402 406).holds s) : s.natReg 404 < cutLogHeight m := by
  change s.natReg 402 < s.natReg 406 at htest
  rw [h.power,h.limit] at htest
  by_contra hh
  have heq : s.natReg 404 = cutLogHeight m := by have hc := h.counter;omega
  have hp := Exact.height_spec m
  have ht : cutLogHeight m = Exact.height m := by simp only [cutLogHeight,max_eq_right hm]
  rw [heq,ht] at htest
  omega
lemma heightAdvanced_rep (m : ℕ) (hm : 2 ≤ m) (s : Data) (h : HeightRep m s)
    (htest : (Test.natLess 402 406).holds s) : HeightRep m (heightAdvanced s) := by
  obtain ⟨hpow,hcount,hlim,hsize,hunit⟩ := heightAdvanced_fields s h.unit
  refine ⟨by rw [hcount];exact heightRep_test m hm s h htest,?_,hlim.trans h.limit,hsize.trans h.size,hunit⟩
  rw [hpow,hcount,h.power,pow_succ]
  omega
lemma heightLoop_eval (m : ℕ) (hm : 2 ≤ m) (s : Data) (h : HeightRep m s) (hzero : s.natReg 404 = 0) :
    ∃ t cost, Eval heightLoop s cost t ∧ HeightRep m t ∧ t.natReg 404 = cutLogHeight m ∧
      cost ≤ 4*cutLogHeight m+2 := by
  have hbody : ∀ s, HeightRep m s → (Test.natLess 402 406).holds s →
      ∃ t cost, Eval heightBody s cost t ∧ HeightRep m t ∧
        cutLogHeight m-t.natReg 404 < cutLogHeight m-s.natReg 404 ∧ cost ≤ 2 := by
    intro s hs htest
    have ht := heightRep_test m hm s hs htest
    have hc := (heightAdvanced_fields s hs.unit).2.1
    exact ⟨heightAdvanced s,2,heightBody_eval s,heightAdvanced_rep m hm s hs htest,by rw [hc];omega,le_rfl⟩
  obtain ⟨t,cost,he,ht,hcost⟩ := loop_bounded (.natLess 402 406) heightBody (HeightRep m)
    (fun s => cutLogHeight m-s.natReg 404) 2 hbody s h
  have hstop := eval_loop_stops (.natLess 402 406) heightBody cost s t he
  have hp : m < 2^t.natReg 404 := by
    change ¬t.natReg 402 < t.natReg 406 at hstop
    rw [ht.power,ht.limit] at hstop
    omega
  have hlo : cutLogHeight m ≤ t.natReg 404 := by
    simp only [cutLogHeight,max_eq_right hm]
    exact Exact.height_le hp
  have heq := le_antisymm ht.counter hlo
  refine ⟨t,cost,he,ht,heq,?_⟩
  simpa only [hzero,Nat.sub_zero] using hcost
end DecrAlmostLinearSSSP.Decremental.CutQualityNative
end s386
section s387
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma rootBody_eval (s : Data) : Eval rootBody s 6 (rootAdvanced s) :=
  Eval.seq (eval_nadd s 408 408 26) (rootPower_eval _)
lemma rootRep_test_iff (t : ℕ) (s : Data) (h : RootRep t s) :
    (Test.realLess 418 420).holds s ↔ s.natReg 408 < Nat.nthRoot 12 t+1 := by
  change s.realReg 418 < s.realReg 420 ↔ _
  rw [h.power,h.limit]
  have hcast : (s.natReg 408 : ℝ)^12 < (t+1 : ℕ) ↔ (s.natReg 408)^12 < t+1 := by norm_cast
  rw [hcast,Nat.lt_succ_iff]
  exact (Nat.le_nthRoot_iff (by norm_num : (12 : ℕ) ≠ 0)).symm.trans Nat.lt_succ_iff.symm
lemma rootAdvanced_fields (s : Data) (hunit : s.natReg 26 = 1) :
    (rootAdvanced s).natReg 408 = s.natReg 408+1 ∧ (rootAdvanced s).natReg 26 = 1 ∧
      (rootAdvanced s).realReg 418 = ((rootAdvanced s).natReg 408 : ℝ)^12 ∧
      (rootAdvanced s).realReg 420 = s.realReg 420 := by
  have hframe : RealFrame rootPower 420 := rootPower_real_frame 420 (by decide)
  have hh := (rootPower_eval {s with natReg := Function.update s.natReg 408 (s.natReg 408+s.natReg 26)}).real_frame hframe
  have hn := powered_nat {s with natReg := Function.update s.natReg 408 (s.natReg 408+s.natReg 26)}
  refine ⟨?_,?_,?_,hh⟩
  · change (powered _).natReg 408 = _
    rw [hn]
    simp only [Function.update_self,hunit]
  · change (powered _).natReg 26 = _
    rw [hn]
    simpa only [Function.update_of_ne (by decide : (26 : ℕ) ≠ 408)] using hunit
  · simpa only [rootAdvanced,powered_nat] using powered_result {s with natReg := Function.update s.natReg 408 (s.natReg 408+s.natReg 26)}
lemma rootAdvanced_rep (t : ℕ) (s : Data) (h : RootRep t s)
    (htest : (Test.realLess 418 420).holds s) : RootRep t (rootAdvanced s) := by
  have hlt := (rootRep_test_iff t s h).mp htest
  obtain ⟨hc,hu,hp,hl⟩ := rootAdvanced_fields s h.unit
  exact ⟨by rw [hc];omega,by rw [hc];omega,hp,hl.trans h.limit,hu⟩
lemma rootLoop_eval (t : ℕ) (s : Data) (h : RootRep t s) :
    ∃ u cost, Eval rootLoop s cost u ∧ RootRep t u ∧ u.natReg 408 = Nat.nthRoot 12 t+1 ∧
      cost ≤ 8*(Nat.nthRoot 12 t+1-s.natReg 408)+2 := by
  have hbody : ∀ s, RootRep t s → (Test.realLess 418 420).holds s →
      ∃ u cost, Eval rootBody s cost u ∧ RootRep t u ∧
        Nat.nthRoot 12 t+1-u.natReg 408 < Nat.nthRoot 12 t+1-s.natReg 408 ∧ cost ≤ 6 := by
    intro s hs htest
    have hlt := (rootRep_test_iff t s hs).mp htest
    have hc := (rootAdvanced_fields s hs.unit).1
    exact ⟨rootAdvanced s,6,rootBody_eval s,rootAdvanced_rep t s hs htest,by rw [hc];omega,le_rfl⟩
  obtain ⟨u,cost,he,hu,hcost⟩ := loop_bounded (.realLess 418 420) rootBody (RootRep t)
    (fun s => Nat.nthRoot 12 t+1-s.natReg 408) 6 hbody s h
  have hstop := eval_loop_stops (.realLess 418 420) rootBody cost s u he
  have hnot : ¬u.natReg 408 < Nat.nthRoot 12 t+1 := fun hh => hstop ((rootRep_test_iff t u hu).mpr hh)
  exact ⟨u,cost,he,hu,le_antisymm hu.counter (not_lt.mp hnot),hcost⟩
end DecrAlmostLinearSSSP.Decremental.CutQualityNative
end s387
section s388
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma rootStart_eval (s : Data) : Eval rootStart s 8 (rootStarted s) :=
  Eval.seq (eval_sequence_atoms rootStartAtoms s) (rootPower_eval _)
lemma rootPrefix_fields (s : Data) :
    (rootPrefixData s).natReg 408 = 1 ∧ (rootPrefixData s).natReg 26 = s.natReg 26 ∧
    (rootPrefixData s).realReg 420 = ((s.natReg 404+s.natReg 26 : ℕ) : ℝ) := by
  simp only [rootPrefixData,rootStartAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
