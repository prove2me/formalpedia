-- title:
--   Exact single-qubit H/T synthesis characterization
-- statement:
--   Let $R=\mathbb Z[1/\sqrt2,i]$ and let $U$ be a complex $2\times2$ unitary matrix. Let $H=(1/\sqrt2)\begin{pmatrix}1&1\\1&-1\end{pmatrix}$ and $T=\operatorname{diag}(1,e^{i\pi/4})$. A chronological word $c$ is a finite list of these gates, with matrix $M(c)$ obtained by applying its first letter first. Then
--
--   $$
--   (\forall a,b,\ U_{ab}\in R)\quad\Longleftrightarrow\quad\exists c,\ M(c)=U.
--   $$
--
--   There is one qubit and no ancillary qubit. Equality includes absolute global phase. This characterizes exactly which single-qubit unitaries admit exact synthesis.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 2, Theorem 1 (abstract seed): exact single-qubit synthesis characterization

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Theorem 1, PDF p.2 (abstract seed p.1). Exact U(2), without ancillary qubits
and including absolute global phase. Both inclusions are asserted. -/
theorem exact_synthesis_iff (U : Matrix Bool Bool ℂ)
    (hU : U ∈ Matrix.unitaryGroup Bool ℂ) :
    EntriesInRing U ↔ ∃ c : List HTLetter, htWordMatrix c = U := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
