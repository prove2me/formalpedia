set_option backward.isDefEq.respectTransparency false

namespace LPCA

open CategoryTheory TensorProduct

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k] (U : Finset V)
variable (A : (V → ℤ) → ModuleCat.{u} k)
variable (hzero : ∀ a, ¬ (∀ v ∈ U, 0 ≤ a v) → Subsingleton (A a))
variable (B : Finset V → ModuleCat.{u} k)
variable (E : ∀ c : {v : V // v ∈ U} → ℕ,
  DirectSum ({v : V // v ∉ U} → ℤ)
    (fun b => A (extendCoordinateDegree U (fun v => (c v : ℤ)) b)) ≃ₗ[k]
      B (coordinateExponentSupport U c))
variable (P : ModuleCat.{u} k) (F : DirectSum (V → ℤ) (fun a => A a) ≃ₗ[k] P)

noncomputable def coordinateGenericTensorTerm : ModuleCat.{u} k :=
  ModuleCat.of k (DirectSum (Set.Iic U) (fun s => B s.1 ⊗[k] coordinateMonomialSpace k U s.1))

noncomputable def coordinateGenericCopiesEquiv :
    DirectSum (Set.Iic U) (fun s =>
      DirectSum {c : {v : V // v ∈ U} → ℕ // coordinateExponentSupport U c = s.1}
        (fun _ => B s.1)) ≃ₗ[k] coordinateGenericTensorTerm k U B := by
  classical
  exact DirectSum.congrLinearEquiv (fun s : Set.Iic U =>
    copiesTensorCoordinateEquiv k k (B s.1) U s.1)

theorem coordinateGenericCopiesEquiv_lof (s : Set.Iic U)
    (c : {c : {v : V // v ∈ U} → ℕ // coordinateExponentSupport U c = s.1}) (x : B s.1) :
    coordinateGenericCopiesEquiv k U B
      (DirectSum.lof k (Set.Iic U) (fun s =>
        DirectSum {c : {v : V // v ∈ U} → ℕ // coordinateExponentSupport U c = s.1}
          (fun _ => B s.1)) s (DirectSum.lof k _ (fun _ => B s.1) c x)) =
      DirectSum.lof k (Set.Iic U) (fun s => B s.1 ⊗[k] coordinateMonomialSpace k U s.1) s
        (x ⊗ₜ[k] coordinateMonomialBasis k U s.1 c) := by
  classical
  change (DirectSum.congrLinearEquiv (fun s : Set.Iic U => copiesTensorCoordinateEquiv k k (B s.1) U s.1)) _ = _
  rw [directSumCongrEquiv_lof]
  exact congrArg (DirectSum.lof k (Set.Iic U) (fun s => B s.1 ⊗[k] coordinateMonomialSpace k U s.1) s)
    (copiesTensorCoordinateEquiv_lof k k (B s.1) U s.1 c x)

noncomputable def coordinateGenericTensorAssembly : P ≃ₗ[k] coordinateGenericTensorTerm k U B :=
  nativeWholeChartEquiv k A P F (coordinateGenericTensorTerm k U B)
    ((coordinateDegreeAssemblyEquiv k U A hzero (fun c => B (coordinateExponentSupport U c)) E).trans
      ((coordinateSupportRegroupEquiv k U B).trans (coordinateGenericCopiesEquiv k U B)))

theorem coordinateGenericTensorAssembly_leg (c : {v : V // v ∈ U} → ℕ)
    (b : {v : V // v ∉ U} → ℤ) (x : A (extendCoordinateDegree U (fun v => (c v : ℤ)) b)) :
    coordinateGenericTensorAssembly k U A hzero B E P F
      (directSumChartLeg k A P F (extendCoordinateDegree U (fun v => (c v : ℤ)) b) x) =
      DirectSum.lof k (Set.Iic U) (fun s => B s.1 ⊗[k] coordinateMonomialSpace k U s.1)
        ⟨coordinateExponentSupport U c, coordinateExponentSupport_subset U c⟩
        (E c (DirectSum.lof k ({v : V // v ∉ U} → ℤ)
          (fun b => A (extendCoordinateDegree U (fun v => (c v : ℤ)) b)) b x) ⊗ₜ[k]
          coordinateMonomialBasis k U (coordinateExponentSupport U c) ⟨c, rfl⟩) := by
  classical
  unfold coordinateGenericTensorAssembly
  rw [nativeWholeChartEquiv_leg]
  simp only [LinearEquiv.trans_apply]
  rw [coordinateDegreeAssemblyEquiv_lof, coordinateSupportRegroupEquiv_lof,
    coordinateGenericCopiesEquiv_lof]

end LPCA


