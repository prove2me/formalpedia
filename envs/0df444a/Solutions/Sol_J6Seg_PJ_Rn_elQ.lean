theorem Fr.upd {v u : Vr} (h : Fr v u) {i : Fin HS} (hi : i ∈ scR) (a : ℤ) :
    Fr v (update u i a) := fun j hj => by
  rw [update_of_ne (by rintro rfl; exact hj hi)]; exact h j hj

theorem headD_mem {l : List ℤ} (h : l ≠ []) : l.headD 0 ∈ l := by
  cases l with
  | nil => exact absurd rfl h
  | cons a l => simp

section pivot
variable {Q W B m mw cB q : ℕ} {L : List ℕ} {A : ℕ → ℕ → ℤ}

/-- **One pivot**, on any stacks `D` with the matrix on `14`, the lines on `30`, `16, 51` empty. -/
theorem Rn.elQ_sol_aux {v w : Vr} {D : Cs} (hq : q < m) (hW1 : 1 ≤ W) (hmW : m * m + m ≤ 2 ^ W)
    (hw : BV W w) (hF : Fr v w) (h1 : w 1 = q) (h9 : v 9 = 2 ^ Q) (h10 : v 10 = 2 ^ (Q + 1))
    (h28 : v 28 = m) (h11 : v 11 = mw) (h12 : v 12 = cB)
    (hL : D 30 = L.map (fun j : ℕ => (j : ℤ))) (hLm : L.length = m)
    (hM : D 14 = matL (Mseq Q (bandS mw cB) L A q) m) (h16 : D 16 = []) (h51 : D 51 = [])
    (hB : ∀ q ≤ m, ∀ i < m, ∀ k < m, |Mseq Q (bandS mw cB) L A q i k| ≤ 2 ^ B) (hBW : B ≤ W)
    (hLb : ∀ j ∈ L, j ≤ 2 ^ W) :
    Rn elQ w D (fun w' => Fr v w' ∧ w' 1 = q ∧ BV W w')
      (update D 14 (matL (Mseq Q (bandS mw cB) L A (q + 1)) m)) (cQ W m) := by
  set S := bandS mw cB
  set F := Mseq Q S L A q with hFdef
  set g : ℕ → ℤ := fun x => stepI Q S L q F (x / m) (x % m) with hg
  set pre : ℕ → List ℤ := fun k => ((List.range k).map g).reverse with hpre
  have hm : 0 < m := by omega
  have hBW' : (2 : ℤ) ^ B ≤ 2 ^ W := pow_le_pow_right₀ (by norm_num) hBW
  have hmm : m * m < 2 ^ W := by nlinarith
  have hFb : ∀ y ∈ matL F m, |y| ≤ 2 ^ W :=
    matL_mem_bnd (fun i hi k hk => (hB q hq.le i hi k hk).trans hBW')
  have hGb : ∀ x < m * m, |g x| ≤ 2 ^ W := fun x hx =>
    (hB (q + 1) hq (x / m) (Nat.div_lt_of_lt_mul hx) (x % m) (Nat.mod_lt _ hm)).trans hBW'
  -- registers
  have r9 : w 9 = 2 ^ Q := by rw [hF 9 (by decide), h9]
  have r10 : w 10 = 2 ^ (Q + 1) := by rw [hF 10 (by decide), h10]
  have r11 : w 11 = mw := by rw [hF 11 (by decide), h11]
  have r12 : w 12 = cB := by rw [hF 12 (by decide), h12]
  have r28 : w 28 = m := by rw [hF 28 (by decide), h28]
  -- step 1: `3 := m²`
  have hs1 := Rn.asgE (c := D) (i := 3) (e := sqE) (by decide) rfl (by simp [sqE, E.lb]; exact Nat.one_le_two_pow) hw
  refine Rn.seq hs1 (fun w1 e1 => ?_)
  have hd1 : sqE.den w = ((m * m : ℕ) : ℤ) := by simp [sqE, E.den, r28]
  rw [hd1] at e1; subst e1
  have hb1 : BV W (update w 3 ((m * m : ℕ) : ℤ)) := BV_upd hw (by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast hmm.le)
  -- step 2: the elimination loop
  set In : ℕ → Vr → Prop := fun _ u => Fr v u ∧ u 1 = q ∧ u 3 = ((m * m : ℕ) : ℤ) with hIn
  have hD0 : update D 16 (pre 0) = D := by
    rw [show pre 0 = D 16 by simp [hpre, h16]]; exact update_eq_self _ _
  have hs2 := Rn.forL (C := 51) (rN := 3) (ix := 2) (b := progL elB) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m * m) (W := W) (Iv := In)
    (cf := fun k => update D 16 (pre k)) (cb := costL W (m * m + m) elB)
    (fun k => by simp [h51]) hmm
    (fun k hk u ⟨hFu, hu1, hu3⟩ hu2 hbu => by
      set c' := update (update D 16 (pre k)) 51 [((m * m : ℕ) : ℤ) - k]
      have c14 : c' 14 = matL F m := by simp [c', hM]
      have c30 : c' 30 = L.map (fun j : ℕ => (j : ℤ)) := by simp [c', hL]
      have c16 : c' 16 = pre k := by simp [c']
      have u9 : u 9 = 2 ^ Q := by rw [hFu 9 (by decide), h9]
      have u10 : u 10 = 2 ^ (Q + 1) := by rw [hFu 10 (by decide), h10]
      have u11 : u 11 = mw := by rw [hFu 11 (by decide), h11]
      have u12 : u 12 = cB := by rw [hFu 12 (by decide), h12]
      have u28 : u 28 = m := by rw [hFu 28 (by decide), h28]
      have hok := elB_ok (v := u) (c := c') (F := F) (L := L) (N := m * m + m) hW1 u9 u10 u11 u12
        u28 hu1 hu2 c14 c30 hLm hq hk le_rfl hFb hLb
      have hrun := elB_run (v := u) (c := c') (F := F) (L := L) u9 u10 u11 u12 u28 hu1 hu2 c14 c30
        hq hk
      have hR := Rn.insL hmW elB hbu hok
      rw [hrun] at hR
      have fr := elB_fr (u, c')
      have hst : update c' 16 (stepI Q (bandS mw cB) L q F (k / m) (k % m) :: c' 16) =
          update (update D 16 (pre (k + 1))) 51 [((m * m : ℕ) : ℤ) - k] := by
        rw [c16, show stepI Q (bandS mw cB) L q F (k / m) (k % m) :: pre k = pre (k + 1) by
          simp [hpre, hg, List.range_succ]; try rfl]
        funext j; simp only [c', update_apply]; split_ifs <;> simp_all
      refine (hR.mono (fun v' h => ?_) le_rfl).congr hst
      · obtain ⟨e, hb⟩ := h
        subst e
        have f1 : (runL elB (u, c')).1 1 = q := by rw [fr 1 (by decide)]; exact hu1
        have f3 : (runL elB (u, c')).1 3 = ((m * m : ℕ) : ℤ) := by rw [fr 3 (by decide)]; exact hu3
        refine ⟨⟨Fr.upd (fun j hj => ?_) (by decide) _, by simp [f1], by simp [f3]⟩,
          by rw [fr 2 (by decide)]; exact hu2, hb⟩
        rw [fr j (fun h => hj (by simp only [scR, List.mem_cons] at h ⊢; tauto))]; exact hFu j hj)
    hb1 (by simp) ⟨Fr.upd (Fr.upd hF (by decide) _) (by decide) _, by simp [h1], by simp⟩
  beta_reduce at hs2
  rw [hD0] at hs2
  refine Rn.seq hs2 (fun w2 ⟨⟨hF2, h21, h23⟩, h22, hb2⟩ => ?_)
  -- step 3: pop the old matrix
  set D2 := update D 16 (pre (m * m)) with hD2
  have hP0 : update D2 14 ((matL F m).drop 0) = D2 := by
    rw [List.drop_zero, show matL F m = D2 14 by simp [hD2, hM]]; exact update_eq_self _ _
  have hs3 := Rn.forL (C := 51) (rN := 3) (ix := 2) (b := progL poB) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m * m) (W := W) (Iv := In)
    (cf := fun k => update D2 14 ((matL F m).drop k)) (cb := costL W (m * m + m) poB)
    (fun k => by simp [hD2, h51]) hmm
    (fun k hk u ⟨hFu, hu1, hu3⟩ hu2 hbu => by
      set c' := update (update D2 14 ((matL F m).drop k)) 51 [((m * m : ℕ) : ℤ) - k]
      have c14 : c' 14 = (matL F m).drop k := by simp [c']
      have hne : (matL F m).drop k ≠ [] := by
        intro h; have := congrArg List.length h; simp at this; omega
      have hok : OkL W (m * m + m) poB (u, c') := by
        simp only [poB, OkL, Ins.ok, c14]
        exact ⟨⟨by decide, by decide, hne, hFb _ (List.mem_of_mem_drop (headD_mem hne))⟩, trivial⟩
      have hR := Rn.insL hmW poB hbu hok
      simp only [poB, runL, Ins.run, c14] at hR
      have hst : update c' 14 ((matL F m).drop k).tail =
          update (update D2 14 ((matL F m).drop (k + 1))) 51 [((m * m : ℕ) : ℤ) - k] := by
        rw [List.tail_drop]
        funext j; simp only [c', update_apply]; split_ifs <;> simp_all
      refine (hR.mono (fun v' h => ?_) le_rfl).congr hst
      obtain ⟨e, hb⟩ := h
      subst e
      exact ⟨⟨Fr.upd hFu (by decide) _, by simp [hu1], by simp [hu3]⟩, hu2, hb⟩)
    hb2 (by rw [h23]) ⟨Fr.upd hF2 (by decide) _, by simp [h21], by simp [h23]⟩
  beta_reduce at hs3
  rw [hP0] at hs3
  refine Rn.seq hs3 (fun w3 ⟨⟨hF3, h31, h33⟩, h32, hb3⟩ => ?_)
  -- step 4: move the new matrix back
  have hlen : (pre (m * m)).length = m * m := by simp [hpre]
  have hs4 := Rn.mv (v := w3) (c := update D2 14 ((matL F m).drop (m * m))) (X := 16) (Y := 14)
    (C := 48) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (r := 3) (by decide) (L := pre (m * m)) (l := []) (by simp [hD2])
    (by rw [hlen, h33]) (B := W + 1)
    (by rw [hlen]; simp only [Int.natAbs_natCast]
        exact lt_of_lt_of_le hmm (Nat.pow_le_pow_right (by norm_num) (by omega)))
    (fun y hy => by
      simp only [hpre, List.mem_reverse, List.mem_map, List.mem_range] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      exact lt_of_le_of_lt (hGb x hx) lt_succ_pow)
  have e1 : (pre (m * m)).reverse = matL (Mseq Q S L A (q + 1)) m := by
    simp only [hpre, List.reverse_reverse]; rfl
  have hst : update (update (update D2 14 ((matL F m).drop (m * m))) 16 [])
      14 ((pre (m * m)).reverse ++ (update D2 14 ((matL F m).drop (m * m))) 14) =
      update D 14 (matL (Mseq Q S L A (q + 1)) m) := by
    rw [e1]
    funext j; simp only [hD2, update_apply]; split_ifs <;> simp_all
  refine (hs4.mono (fun v' e => ?_) (by simp only [hlen, cMvE]; omega)).congr hst
