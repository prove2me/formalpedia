namespace GeneralCK.Certificates.E8TAxisZero0053EndpointWitnesses

open Set DyadicInterval E8TAxisStableInterval E8TAxisStableScalar
open E8TAxisFirstCellInverseCoverage E8TAxisZero0053Geometry

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

def precision : ℕ := 160
def endpointLogTwo : DyadicInterval precision := ⟨1013035739299659071135698605846798551586536899314, 1013035739299659071135698605846798551586536901381⟩
def fastLogWitness : FastLogBoxWitness := ⟨0, 1024, 0, 1024⟩

theorem endpointLogTwo_checked :
    logBoxCheck (ofInt precision 2) endpointLogTwo fastLogWitness = true := by decide +kernel

def centerBLowerAlpha : DyadicInterval precision := ⟨2198078974265077670796151698551412219080296043584, 2198078974265077670796151698551412219080296043584⟩
def centerBLowerExp : DyadicInterval precision := ⟨72186018221563420262904968289895657326346199142, 72186018221563420262904968289895657326346330215⟩
def centerBLowerLog : DyadicInterval precision := ⟨70459932166004994217086871073398753830531781466, 70459932166004994217086871073398753830531908425⟩
def centerBLowerYBox : DyadicInterval precision := ⟨8945760178250123580892367130754323595625180713345, 8945760178250123580892367130754323595625191401760⟩
def centerBLowerInput : Inputs precision :=
  ⟨centerBLowerAlpha, centerBLowerExp, centerBLowerLog, endpointLogTwo⟩
def centerBLowerExpWitness : ExpWitness precision :=
  ⟨72186018221563420262904968289895657326346199142, scale precision, 72186018221563420262904968289895657326346330215, scale precision,
    0, 1024, 0, 1024, ⟨-4396157948530155341592303397102824438160593415662, -4396157948530155341592303397102824438160593413504⟩, ⟨-4396157948530155341592303397102824438160590761902, -4396157948530155341592303397102824438160590759750⟩⟩

theorem centerBLower_primitive_checks :
    expBoxCheck ((ofInt precision (-2)).mul centerBLowerAlpha) centerBLowerExp centerBLowerExpWitness = true ∧
    logBoxCheck ((ofInt precision 1).add centerBLowerExp) centerBLowerLog fastLogWitness = true := by decide +kernel

theorem centerBLower_denominators : DenominatorsPositive centerBLowerInput := by
  unfold DenominatorsPositive
  decide +kernel

theorem centerBLower_yBox_eq : (yBox centerBLowerInput).d0 = centerBLowerYBox := by decide +kernel

theorem centerBLower_contains :
    centerBLowerYBox.Contains (Y (lower E8TAxisZero0053PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0053PaddedInputs.centerBInput.alpha = ((2198078974265077670796151698551412219080296043584 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
  have ha : centerBLowerInput.alpha.Contains (lower E8TAxisZero0053PaddedInputs.centerBInput.alpha) := by
    rw [e]; exact point_contains precision 2198078974265077670796151698551412219080296043584
  have h := checked_yBox_d0_contains (i := centerBLowerInput) (we := centerBLowerExpWitness)
    (wl := fastLogWitness) (wL := fastLogWitness)
    centerBLower_primitive_checks.1 centerBLower_primitive_checks.2 endpointLogTwo_checked
    centerBLower_denominators ha
  rw [centerBLower_yBox_eq] at h
  exact h

def centerBUpperAlpha : DyadicInterval precision := ⟨2198078974265077670796151698551412219080329598017, 2198078974265077670796151698551412219080329598017⟩
