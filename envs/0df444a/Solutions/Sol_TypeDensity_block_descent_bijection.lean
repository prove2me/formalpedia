  have hright : ∀ b ∈ TypeDensity.blockCell O Φ r, TypeDensity.selectBlock O Φ r (TypeDensity.descendBlock O Φ r b) = b := by
    intro b hb
    obtain ⟨hcell, hF⟩ := TypeDensity.descend_block_mem_cell O Φ hΦ r b hb
    obtain ⟨B, hBm, hBd, hBr, hBp, huniq, hs, -⟩ := TypeDensity.selectBlock_spec O Φ hΦ r hδ _ hcell
    have hb' := TypeDensity.monic_poly_reconstruct (AdjoinRoot Φ) r b
    have heq : TypeDensity.monicPolyO b = B ⟨0, hδ⟩ := by
      refine huniq _ hb'.1 hb'.2.1 hb ?_
      rw [hF, TypeDensity.conjugateProduct]
      have : TypeDensity.monicPolyO b =
          (TypeDensity.monicPolyO b).map (TypeDensity.frobeniusIter O Φ ((⟨0, hδ⟩ : Fin _) : ℕ)).toRingHom :=
        Polynomial.map_id.symm
      conv_lhs => rw [this]
      exact Finset.dvd_prod_of_mem _ (Finset.mem_univ _)
    rw [hs, ← heq]
    exact funext hb'.2.2.1
  refine ⟨⟨fun a ha => ?_, fun a ha a' ha' h => ?_, fun b hb => ?_⟩, hleft, hright, fun a ha => ?_⟩
