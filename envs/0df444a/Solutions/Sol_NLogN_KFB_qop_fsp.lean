  | [], _ => rfl
  | (c, r) :: l, h => by
    simp only [lcE, Ex.eval, List.map_cons, List.sum_cons]
    rw [tmE_eval (h (c, r) List.mem_cons_self), lcE_eval s l fun t ht => h t (List.mem_cons_of_mem _ ht)]

