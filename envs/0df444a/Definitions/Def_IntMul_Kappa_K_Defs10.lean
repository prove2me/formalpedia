-- Source module: Solutions.KIL6Den
/-!
# KIL6: Lemma 12 as a uniform IL program — the list denotations

The IL program of KIL6 realises the Lemma 12 interchange with the following data flow (array
model, `AModelL12`):

1. **binary padding** `binShape … (2^u) → binShape … (q^e)`: two one-field paddings
   (`padL`, `embed_binShape`);
2. **high swaps**: `r = min ρ e` single-digit interchanges (`highSwaps`);
3. if `n = e - r > 0`, the **middle part** `l12mid`: the row field is the prefix
   `Pre ++ [q]^r` (volume `vol Pre · q^r`), padded to `padRows W Kp (q^r)` rows (`padL`); the
   Prop. 11 oracle runs on the pieces (`runPieces … pieceLevels`), with the gap
   `G ++ [q]^r` (the already interchanged high digits of the second chunk belong to the gap);
   the padding is scanned away (`unpadL`);
4. **binary extraction** (two `unpadL`).

Compared with `AModelL12.l12q` this variant needs no joining rotation: the interchanged high
digits `d⁺` simply stay inside the gap.  `l12v_correct` proves that it is the interchange
`swapPos` of the two `[2^u]` fields, from the same oracle specification `OracleSpec`.

The list functions `padL` / `unpadL` are the one-field embeddings / extractions in the chunk
form the IL loops produce (`embed_eq_padL`, `extract_eq_unpadL`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open AModel AModelL12

section Chunks

variable {α : Type*}

end Chunks

/-! ## One-field padding and extraction in chunk form -/

section Pad

variable {α : Type*}

/-- Pad the field `F ↦ F'` of `[X, F, Y]` (row-major): every block of `F · Y` entries is followed
by `(F' - F) · Y` default entries. -/
def padL (X F F' Y : ℕ) (d : α) (xs : List α) : List α :=
  (List.range X).flatMap fun x =>
    (xs.drop (x * (F * Y))).take (F * Y) ++ List.replicate ((F' - F) * Y) d

/-- Extract the field `F` from `[X, F', Y]`: keep the first `F · Y` entries of every block of
`F' · Y`. -/
def unpadL (X F F' Y : ℕ) (ys : List α) : List α :=
  (List.range X).flatMap fun x => (ys.drop (x * (F' * Y))).take (F * Y)

/-! ## Composing embeddings and extractions -/

end Pad

/-! ## The binary and row paddings in chunk form -/

section Shapes

variable {α : Type*}

end Shapes

/-! ## The variant procedure and its correctness -/

section Variant

variable {α : Type*}

/-- The middle part: rows `Pre ++ [q]^r` (volume `vol Pre · q^r`), padded to
`padRows W Kp (q^r)`; gap `G ++ [q]^r`; the Prop. 11 oracle on the pieces of the remaining
`n` digits. -/
noncomputable def l12mid (child : Oracle α) (W m q Kp r : ℕ) (Pre G Suf : Shape) (n : ℕ) (d : α)
    (ys : List α) : List α :=
  extract (rowShape (AModel.vol Pre) (q ^ r) (G ++ List.replicate r q) Suf q n)
    (rowShape (AModel.vol Pre) (padRows W Kp (q ^ r)) (G ++ List.replicate r q) Suf q n) d
    (runPieces (pieceStep child (AModel.vol Pre) (padRows W Kp (q ^ r)) (G ++ List.replicate r q) Suf q m n)
      (fun j => m ^ j) 0 (pieceLevels m n)
      (AModelL12.embed (rowShape (AModel.vol Pre) (q ^ r) (G ++ List.replicate r q) Suf q n)
        (rowShape (AModel.vol Pre) (padRows W Kp (q ^ r)) (G ++ List.replicate r q) Suf q n) d ys))

/-- **The Lemma 12 procedure realised by the KIL6 program**: binary padding, `min ρ e` high
digit swaps, the middle part (if digits remain), binary extraction. -/
noncomputable def l12v (child : Oracle α) (W m q Kp ρ e u : ℕ) (Pre G Suf : Shape) (d : α)
    (xs : List α) : List α :=
  extract (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d
    (if e - min ρ e = 0 then
      highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) (min ρ e) d
        (AModelL12.embed (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d xs)
    else l12mid child W m q Kp (min ρ e) Pre G Suf (e - min ρ e) d
      (highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) (min ρ e) d
        (AModelL12.embed (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d xs)))

end Variant

