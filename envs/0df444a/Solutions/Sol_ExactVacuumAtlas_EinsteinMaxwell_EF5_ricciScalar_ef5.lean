  have hr := domU5_r hx; have hu := domU5_u_pos hx; have h1u := domU5_1mu_pos hx
  have h01 : giEF5 mu beta 0 1 x = 1 := giEF5_01_eq_one mu beta x
  have h10 : giEF5 mu beta 1 0 x = 1 := giEF5_10_eq_one mu beta x
  have h22 : giEF5 mu beta 2 2 x = 4 * x 2 * (1 - x 2) / x 1 ^ 2 := giEF5_22_eq_val mu beta x
  have h33 : giEF5 mu beta 3 3 x = 1 / (x 1 ^ 2 * x 2) := giEF5_33_eq_val mu beta x
  have h44 : giEF5 mu beta 4 4 x = 1 / (x 1 ^ 2 * (1 - x 2)) := giEF5_44_eq_val mu beta x
  -- zero entries
  have h00 : giEF5 mu beta 0 0 x = 0 := giEF5_00_eq_zero mu beta x
  have h11 : giEF5 mu beta 1 1 x = 1 - mu / x 1 ^ 2 + beta / x 1 ^ 4 := giEF5_11_eq_f mu beta x
  have h02 : giEF5 mu beta 0 2 x = 0 := giEF5_02_eq_zero mu beta x
  have h03 : giEF5 mu beta 0 3 x = 0 := giEF5_03_eq_zero mu beta x
  have h04 : giEF5 mu beta 0 4 x = 0 := giEF5_04_eq_zero mu beta x
  have h12 : giEF5 mu beta 1 2 x = 0 := giEF5_12_eq_zero mu beta x
  have h13 : giEF5 mu beta 1 3 x = 0 := giEF5_13_eq_zero mu beta x
  have h14 : giEF5 mu beta 1 4 x = 0 := giEF5_14_eq_zero mu beta x
  have h20 : giEF5 mu beta 2 0 x = 0 := giEF5_20_eq_zero mu beta x
  have h21 : giEF5 mu beta 2 1 x = 0 := giEF5_21_eq_zero mu beta x
  have h23 : giEF5 mu beta 2 3 x = 0 := giEF5_23_eq_zero mu beta x
  have h24 : giEF5 mu beta 2 4 x = 0 := giEF5_24_eq_zero mu beta x
  have h30 : giEF5 mu beta 3 0 x = 0 := giEF5_30_eq_zero mu beta x
