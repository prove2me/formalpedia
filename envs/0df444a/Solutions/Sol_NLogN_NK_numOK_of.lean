    have : K * Nat.size (BD.cS1 p α) < 2 ^ (B + (B + 1)) :=
      lt_pow_mul (show K ≤ 2 ^ B by omega) (show Nat.size (BD.cS1 p α) < 2 ^ (B + 1) by
        rw [pow_succ]; omega)
    exact this.le.trans (pB _ (by omega))
  have hJE : Jm * (2 * B + 12) < 2 ^ (3 * B + 6) := by
    have := lt_pow_mul hB2 hJm
    rw [show B + (2 * B + 6) = 3 * B + 6 by ring] at this
    rw [mul_comm]; exact this
  have t2 : K * Nat.size (BD.cB1 p α Jm) ≤ Y := by
    have h3 : 3 * B + 12 < 2 ^ (3 * B + 6) := by
      have : 2 ^ B ≤ 2 ^ (3 * B + 6) := Nat.pow_le_pow_right (by norm_num) (by omega)
      omega
    have : K * Nat.size (BD.cB1 p α Jm) < 2 ^ (B + (3 * B + 7)) :=
      lt_pow_mul (show K ≤ 2 ^ B by omega) (show Nat.size (BD.cB1 p α Jm) < 2 ^ (3 * B + 7) by
        rw [pow_succ]; omega)
    exact this.le.trans (pB _ (by omega))
  have t3 : Jm * Nat.size (BD.cE1 p α) ≤ Y := by
    have : Jm * Nat.size (BD.cE1 p α) ≤ Jm * (2 * B + 12) := Nat.mul_le_mul_left _ sE
    exact this.trans (hJE.le.trans (pB _ (by omega)))
  have t4 : Nat.size (Jm + 1) ≤ Y := by
    have : Nat.size (Jm + 1) ≤ 2 * B + 7 := Nat.size_le.2 (by rw [pow_succ]; omega)
    have : 2 * B + 7 < 2 ^ (2 * B + 7) := Nat.lt_two_pow_self
    have := pB (2 * B + 7) (by omega)
    omega
  have hpY : 16 * b ≤ Y := by
    have : 16 * 2 ^ B = 2 ^ (B + 4) := by rw [pow_add]; ring
    have := pB (B + 4) (by omega)
    omega
  have t5 : Nat.size (BD.Bq q + BD.BC q) ≤ q.P + 1 := by
    apply Nat.size_le.2; rw [pow_succ]; omega
  have t6 : Nat.size (4 * p + 35) ≤ B + 6 := Nat.size_le.2 e1
  have hmm : mmK K N ≤ 16 * Y := by
    rw [emm]
    omega
  have h16 : 16 * Y = 2 ^ (4 * B + 14) := by rw [hY, show 4 * B + 14 = 4 * B + 10 + 4 by ring, pow_add]; ring
  have : 2 ^ (4 * B + 14) < 2 ^ (b - 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

end NLogN.NK

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.NK
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.ST
theorem solution (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) : NLogN.ST.NumOK K N := by
  have h := NLogN.NK.kf K N hK hN
  exact ⟨fun k hk => NLogN.NK.sax K N h k hk, fun k hk => NLogN.NK.bax K N h k hk, fun a _ => NLogN.NK.inU_of K N h a,
    fun a _ b _ => NLogN.NK.inW_of K N h a b, NLogN.NK.smallF_of K N h, NLogN.NK.smallM_of K N h⟩
end
