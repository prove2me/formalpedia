  have zkEk' : zsz ((k : ℤ) * ((8 * ((j : ℤ) % k)) / k)) ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zC1' : zsz ((8 * ((j : ℤ) % k) / k % 2) + -1) ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
