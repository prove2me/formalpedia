-- Source module: Solutions.KFMBaseEap
open Complex

namespace IntMul.HvdH.EPf
open IntMul.HvdH

/-- The exact weight `e_j = e^{-π (j - sk/t)² / α²}`. -/
lemma hasSum_geom_int {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    HasSum (fun n : ℤ => r ^ n.natAbs) ((1 + r) / (1 - r)) := by
