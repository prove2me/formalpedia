theorem ModularCurve.UVCrossingModel.minimalPrimes_span_U_mul_V {W : Type*} [CommRing W] (π : W) [IsDomain (W ⧸ Ideal.span {π})] : (Ideal.span {U π * V π}).minimalPrimes = {Ideal.span {U π}, Ideal.span {V π}} := by sorry
