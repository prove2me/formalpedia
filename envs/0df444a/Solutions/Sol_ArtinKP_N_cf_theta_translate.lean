variable [IsTotallyComplex F]

/-- **Automorphy by reindexing `p ↦ pγ`**, raw form:
`∑_p ψ(p) I_p(γQ)^s = ∑_p ψ(pγ⁻¹) I_p(Q)^s`.  No convergence hypothesis. -/
theorem eisRaw_smul (h𝔪 : 𝔪 ≠ ⊥) {ψ : Row 𝔪 → ℂ} {s : ℂ} (hψ : IsHom ψ s)
    (γ : SL(2, SInt 𝔪)) (Q : X F) :
    eisRaw ψ s (toF 𝔪 γ • Q) = eisRaw (fun p => ψ (p.act γ⁻¹)) s Q := by
  unfold eisRaw
  rw [← (RowClass.actEquiv γ).tsum_eq
    (fun q : RowClass 𝔪 => term (fun p => ψ (p.act γ⁻¹)) s Q q.out)]
  refine tsum_congr fun q => ?_
  have e : RowClass.actEquiv γ q = RowClass.mk (q.out.act γ) := by
    rw [RowClass.actEquiv_apply, ← RowClass.act_mk, RowClass.mk_out]
  rw [e, term_out_mk h𝔪 (hψ.act γ⁻¹), term_toF_smul]

/-- **Automorphy**: `E_Ψ(γ • Q, s) = E_{γ⁻¹·Ψ}(Q, s)` for `γ ∈ SL₂(R)`; `γ·Ψ = translate γ Ψ` is
`(γ·Ψ)_s(p) = Ψ_s(pγ)`.  (Note the inverse: with `I_p(γQ) = I_{pγ}(Q)` the substitution is
`p' = pγ`, so `Ψ` is evaluated at `p'γ⁻¹`.) -/
theorem eis_smul (Pk : CubicPkg F) (hG : Good 𝔪) {z6 : 𝓞 F} (hz6 : IsPrimitiveRoot z6 6)
    (γ : SL(2, SInt 𝔪)) (Ψ : TSection ι 𝔪) (s : ℂ) (Q : X F) :
    eis Ψ s (toF 𝔪 γ • Q) = eis (TSection.translate Pk hG hz6 γ⁻¹ Ψ) s Q :=
  eisRaw_smul hG.ne_bot (Ψ.isHom s) γ Q

/-- Automorphy, the other way round: `E_{γ·Ψ}(Q, s) = E_Ψ(γ⁻¹ • Q, s)`. -/
theorem eis_translate (Pk : CubicPkg F) (hG : Good 𝔪) {z6 : 𝓞 F} (hz6 : IsPrimitiveRoot z6 6)
    (γ : SL(2, SInt 𝔪)) (Ψ : TSection ι 𝔪) (s : ℂ) (Q : X F) :
    eis (TSection.translate Pk hG hz6 γ Ψ) s Q = eis Ψ s (toF 𝔪 γ⁻¹ • Q) := by
  rw [eis_smul Pk hG hz6, inv_inv]

end auto

