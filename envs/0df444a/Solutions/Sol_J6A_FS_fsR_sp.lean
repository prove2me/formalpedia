-- Source module: Solutions.J6AIL13
/-!
# A lines, IL side 13: the fine-descriptor set-ups

For a fine descriptor `descFine w f a y` with `w = p + 2`, `f` a literal and `a`, `y` expressions in
the registers of `parAX X`:

* `fsR X ea ey fl Q`: enter the register file, `parAX X`, push `w, f, a, y` on four temporaries
  `Q 0 … Q 3` (outside `rg`, away from `dF`), leave the register file;
* `fsUp`: then copy `y, a, f, w` onto `dF` and drop the temporaries; `fsDn`: drop four from `dF`.

**`fsUp_runs`** / **`fsDn_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.FS

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function J6A.PA IntMul.Kappa.R6

theorem zszW1 {a : ℤ} {W : ℕ} (h : |a| ≤ 2 ^ W) : zsz a ≤ W + 1 :=
  zsz_of_le (M := 2 ^ W) (by exact_mod_cast h) (by
    have := Nat.pow_lt_pow_right (a := 2) (by norm_num) (Nat.lt_succ_self W); exact this)

theorem Q_val (dF : Fin HS) (i : Fin 4) : (Q dF i).val = qb dF + i.val := rfl

theorem Q_facts (dF : Fin HS) (i : Fin 4) :
    Q dF i ∉ rg ∧ (Q dF i).val < 56 ∧ Q dF i ≠ dF ∧ (Q dF i).val ≠ 0 ∧ (Q dF i).val ≠ 53 ∧
    (Q dF i).val ≠ 30 ∧ (Q dF i).val ≠ 31 ∧ Q dF i ≠ sTmp ∧ Q dF i ≠ cRdC ∧ Q dF i ≠ cL := by
  have hi := i.isLt
  have hv := Q_val dF i
  have nrg : ∀ j : Fin HS, (16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35) → j ∉ rg := by
    intro j hj hm
    have : ∀ j ∈ rg, ¬ ((16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35)) := by decide
    exact this j hm hj
  have vne : ∀ (j : Fin HS) (n : ℕ), j.val = n → (qb dF + i.val ≠ n) → Q dF i ≠ j :=
    fun j n hj hn e => hn (by rw [← hv, e, hj])
  have e15 : (sTmp : Fin HS).val = 15 := rfl
  have e47 : (cRdC : Fin HS).val = 47 := rfl
  have e13 : (cL : Fin HS).val = 13 := rfl
  rcases qb_cases dF with h | h
  · refine ⟨nrg _ (Or.inr (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩
  · refine ⟨nrg _ (Or.inl (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩

theorem Q_inj (dF : Fin HS) {i j : Fin 4} (h : Q dF i = Q dF j) : i = j := by
  rw [Fin.ext_iff, Q_val, Q_val] at h; exact Fin.ext (by omega)

