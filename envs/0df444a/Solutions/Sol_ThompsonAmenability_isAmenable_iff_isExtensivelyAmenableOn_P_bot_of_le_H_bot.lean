section
open Filter Topology OnePoint Matrix

set_option linter.unusedSimpArgs false

namespace Monod.Dev.Alg

variable {A : Subring ℝ}

/-- The real entries of an element of `SL(2, A)`. -/
def ent (g : SpecialLinearGroup (Fin 2) A) (i j : Fin 2) : ℝ :=
  ((g : Matrix (Fin 2) (Fin 2) A) i j : ℝ)

lemma ent_det (g : SpecialLinearGroup (Fin 2) A) :
    ent g 0 0 * ent g 1 1 - ent g 0 1 * ent g 1 0 = 1 := by
  have h := g.2
  rw [Matrix.det_fin_two] at h
  have := congrArg (fun t : A => (t : ℝ)) h
  simpa [ent] using this

lemma mob_infty (g : SpecialLinearGroup (Fin 2) A) :
    mob g ∞ = if ent g 1 0 = 0 then ∞ else ((ent g 0 0 / ent g 1 0 : ℝ) : OnePoint ℝ) := by
  unfold mob; rw [OnePoint.smul_infty_eq_ite]; rfl

lemma mob_coe (g : SpecialLinearGroup (Fin 2) A) (x : ℝ) :
    mob g (x : OnePoint ℝ) = if ent g 1 0 * x + ent g 1 1 = 0 then ∞ else
      (((ent g 0 0 * x + ent g 0 1) / (ent g 1 0 * x + ent g 1 1) : ℝ) : OnePoint ℝ) := by
  unfold mob; rw [OnePoint.smul_some_eq_ite]; rfl

lemma mob_mul (g h : SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (g * h) x = mob g (mob h x) := by
  unfold mob; rw [map_mul, mul_smul]

lemma mob_one (x : OnePoint ℝ) : mob (1 : SpecialLinearGroup (Fin 2) A) x = x := by
  unfold mob; rw [map_one, one_smul]

lemma mob_inv_mob (g : SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g⁻¹ (mob g x) = x := by
  rw [← mob_mul, inv_mul_cancel, mob_one]

lemma mob_mob_inv (g : SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g (mob g⁻¹ x) = x := by
  rw [← mob_mul, mul_inv_cancel, mob_one]

/-! ### Continuity of a Möbius map -/

/-- The explicit Möbius formula. -/
noncomputable def mobF (a b c d : ℝ) (p : OnePoint ℝ) : OnePoint ℝ :=
  p.elim (if c = 0 then ∞ else ((a / c : ℝ) : OnePoint ℝ))
    (fun x => if c * x + d = 0 then ∞ else (((a * x + b) / (c * x + d) : ℝ) : OnePoint ℝ))

@[simp] lemma mobF_infty (a b c d : ℝ) :
    mobF a b c d ∞ = if c = 0 then ∞ else ((a / c : ℝ) : OnePoint ℝ) := rfl

@[simp] lemma mobF_coe (a b c d x : ℝ) :
    mobF a b c d (x : OnePoint ℝ) =
      if c * x + d = 0 then ∞ else (((a * x + b) / (c * x + d) : ℝ) : OnePoint ℝ) := rfl

end Monod.Dev.Alg
end

section
open Filter Topology OnePoint Matrix

set_option linter.unusedSimpArgs false

namespace Monod.Dev.Alg

variable {A : Subring ℝ}

/-! ### A Möbius map is determined by its values on an infinite set -/

lemma mob_eq_self_of_three (k : SpecialLinearGroup (Fin 2) A) {x₁ x₂ x₃ : ℝ}
    (h12 : x₁ ≠ x₂) (h13 : x₁ ≠ x₃) (h23 : x₂ ≠ x₃)
    (h₁ : mob k x₁ = x₁) (h₂ : mob k x₂ = x₂) (h₃ : mob k x₃ = x₃) :
    ∀ p, mob k p = p := by
  have key : ∀ x : ℝ, mob k x = x →
      ent k 0 0 * x + ent k 0 1 = x * (ent k 1 0 * x + ent k 1 1) := by
    intro x hx
    rw [mob_coe] at hx
    split_ifs at hx with hden
    · exact absurd hx (OnePoint.infty_ne_coe x)
    · have := OnePoint.coe_injective hx
      rw [div_eq_iff hden] at this
      linarith
  have e1 := key _ h₁
  have e2 := key _ h₂
  have e3 := key _ h₃
  have hdet := ent_det k
  set a := ent k 0 0
  set b := ent k 0 1
  set c := ent k 1 0
  set d := ent k 1 1
  have f12 : (x₁ - x₂) * (c * (x₁ + x₂) + (d - a)) = 0 := by linear_combination e2 - e1
  have f13 : (x₁ - x₃) * (c * (x₁ + x₃) + (d - a)) = 0 := by linear_combination e3 - e1
  have g12 : c * (x₁ + x₂) + (d - a) = 0 :=
    (mul_eq_zero.1 f12).resolve_left (sub_ne_zero.2 h12)
  have g13 : c * (x₁ + x₃) + (d - a) = 0 :=
    (mul_eq_zero.1 f13).resolve_left (sub_ne_zero.2 h13)
  have hc : c = 0 := by
    have : c * (x₂ - x₃) = 0 := by linear_combination g12 - g13
    exact (mul_eq_zero.1 this).resolve_right (sub_ne_zero.2 h23)
  have hda : d = a := by rw [hc] at g12; linarith
  have hb : b = 0 := by rw [hc, hda] at e1; linarith
  have ha : a ≠ 0 := by
    intro h0; rw [hc, hb, h0] at hdet; norm_num at hdet
  intro p
  cases p with
  | infty => rw [mob_infty]; simp [c, hc]
  | coe x =>
    rw [mob_coe]
    have : c * x + d ≠ 0 := by rw [hc, hda]; simpa using ha
    rw [if_neg this]
    congr 1
    show (a * x + b) / (c * x + d) = x
    rw [div_eq_iff this, hc, hda, hb]; ring

lemma mob_eq_of_three (g g' : SpecialLinearGroup (Fin 2) A) {x₁ x₂ x₃ : ℝ}
    (h12 : x₁ ≠ x₂) (h13 : x₁ ≠ x₃) (h23 : x₂ ≠ x₃)
    (h₁ : mob g x₁ = mob g' x₁) (h₂ : mob g x₂ = mob g' x₂) (h₃ : mob g x₃ = mob g' x₃) :
    mob g = mob g' := by
  have hk : ∀ x : ℝ, mob g x = mob g' x → mob (g'⁻¹ * g) x = x := by
    intro x hx; rw [mob_mul, hx, mob_inv_mob]
  have := mob_eq_self_of_three (g'⁻¹ * g) h12 h13 h23 (hk _ h₁) (hk _ h₂) (hk _ h₃)
  funext p
  have h := this p
  rw [mob_mul] at h
  calc mob g p = mob g' (mob g'⁻¹ (mob g p)) := (mob_mob_inv _ _).symm
    _ = mob g' p := by rw [h]

lemma mob_eq_of_infinite (g g' : SpecialLinearGroup (Fin 2) A) {S : Set ℝ} (hS : S.Infinite)
    (h : ∀ x ∈ S, mob g x = mob g' x) : mob g = mob g' := by
  obtain ⟨x₁, hx₁, x₂, hx₂, h12⟩ := hS.nontrivial
  obtain ⟨x₃, hx₃, h3⟩ := (hS.sdiff (Set.toFinite {x₁, x₂})).nonempty
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at h3
  exact mob_eq_of_three g g' h12 (Ne.symm h3.1) (Ne.symm h3.2) (h _ hx₁) (h _ hx₂) (h _ hx₃)

lemma infinite_of_eventually {l : Filter ℝ} [l.NeBot] (hl : l ≤ cofinite) {P : ℝ → Prop}
    (h : ∀ᶠ x in l, P x) : {x | P x}.Infinite :=
  Filter.frequently_cofinite_iff_infinite.1 (h.frequently.filter_mono hl)

lemma mob_eq_of_eventually (g g' : SpecialLinearGroup (Fin 2) A) {l : Filter ℝ} [l.NeBot]
    (hl : l ≤ cofinite) (h : ∀ᶠ x : ℝ in l, mob g x = mob g' x) : mob g = mob g' :=
  mob_eq_of_infinite g g' (infinite_of_eventually hl h) (fun _ hx => hx)

lemma nhdsNE_le_cofinite (x : ℝ) : 𝓝[≠] x ≤ cofinite := by
  rw [Filter.le_cofinite_iff_compl_singleton_mem]
  intro y
  by_cases hy : y = x
  · subst hy; exact self_mem_nhdsWithin
  · exact nhdsWithin_le_nhds (isOpen_compl_singleton.mem_nhds (Ne.symm hy))

/-! ### Germs on intervals -/

end Monod.Dev.Alg
end

section
/-!
# Möbius maps of `SL(2, ℤ)`: multipliers, germ uniqueness, `P_ℤ` is irrational

`mu k t = c t + d` (bottom row of `k` applied to `(t, 1)`): the derivative of `mob k` at `t`
is `(mu k t)⁻²`, and `mu (g h) t = mu g (h t) * mu h t`. Two Möbius maps agreeing along a
one-sided filter agree everywhere, and then their matrices agree up to a sign. A fixed point of
a hyperbolic element of `SL(2, ℤ)` is irrational, and an element fixing an irrational point with
multiplier `± 1` is `± 1`.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

variable {A : Subring ℝ}

/-- `SL(2, ℤ)`, as `SL(2, ⊥)` for the subring `⊥ = ℤ` of `ℝ`. -/
abbrev SLZ := Matrix.SpecialLinearGroup (Fin 2) (⊥ : Subring ℝ)

lemma ent_int (k : SLZ) (i j : Fin 2) : ∃ n : ℤ, ent k i j = n := by
  obtain ⟨n, hn⟩ := Subring.mem_bot.1 (k i j).2
  exact ⟨n, hn.symm⟩

lemma ent_mul (g h : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) :
    ent (g * h) i j = ent g i 0 * ent h 0 j + ent g i 1 * ent h 1 j := by
  simp only [ent, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
  push_cast
  rfl

lemma ent_one (i j : Fin 2) :
    ent (1 : Matrix.SpecialLinearGroup (Fin 2) A) i j = if i = j then 1 else 0 := by
  simp only [ent, Matrix.SpecialLinearGroup.coe_one, Matrix.one_apply]
  split_ifs <;> simp

/-- The multiplier `c t + d`; the derivative of `mob k` at `t` is `(mu k t)⁻²`. -/
noncomputable def mu (k : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) : ℝ :=
  ent k 1 0 * t + ent k 1 1

/-- The real value `(a t + b) / (c t + d)`. -/
noncomputable def val (k : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) : ℝ :=
  (ent k 0 0 * t + ent k 0 1) / mu k t

lemma mob_coe_of_mu_ne {k : Matrix.SpecialLinearGroup (Fin 2) A} {t : ℝ} (h : mu k t ≠ 0) :
    mob k (t : OnePoint ℝ) = (val k t : OnePoint ℝ) := by
  rw [mob_coe, if_neg (show ent k 1 0 * t + ent k 1 1 ≠ 0 from h)]; rfl

lemma mu_ne_of_mob_ne {k : Matrix.SpecialLinearGroup (Fin 2) A} {t : ℝ}
    (h : mob k (t : OnePoint ℝ) ≠ ∞) : mu k t ≠ 0 := by
  intro h0
  apply h
  rw [mob_coe, if_pos (show ent k 1 0 * t + ent k 1 1 = 0 from h0)]

lemma mu_ne_of_mob_eq {k : Matrix.SpecialLinearGroup (Fin 2) A} {t s : ℝ}
    (h : mob k (t : OnePoint ℝ) = s) : mu k t ≠ 0 :=
  mu_ne_of_mob_ne (by rw [h]; exact coe_ne_infty s)

lemma val_eq_of_mob_eq {k : Matrix.SpecialLinearGroup (Fin 2) A} {t s : ℝ}
    (h : mob k (t : OnePoint ℝ) = s) : val k t = s := by
  rw [mob_coe_of_mu_ne (mu_ne_of_mob_eq h)] at h
  exact coe_injective h

/-- The chain rule for multipliers. -/
lemma mu_mul (g h : Matrix.SpecialLinearGroup (Fin 2) A) {t : ℝ} (ht : mu h t ≠ 0) :
    mu (g * h) t = mu g (val h t) * mu h t := by
  have ht' : ent h 1 0 * t + ent h 1 1 ≠ 0 := ht
  simp only [mu, val, ent_mul]
  field_simp
  ring

lemma mu_one (t : ℝ) : mu (1 : Matrix.SpecialLinearGroup (Fin 2) A) t = 1 := by
  simp [mu, ent_one]

/-! ### Germ uniqueness -/

/-- An element acting trivially is `± 1`. -/
lemma ent_of_mob_eq_id (k : Matrix.SpecialLinearGroup (Fin 2) A) (h : ∀ p, mob k p = p) :
    ent k 1 0 = 0 ∧ ent k 0 1 = 0 ∧ ent k 1 1 = ent k 0 0 ∧ ent k 0 0 * ent k 0 0 = 1 := by
  have f0 := fixed_eq k (h ((0 : ℝ) : OnePoint ℝ))
  have f1 := fixed_eq k (h ((1 : ℝ) : OnePoint ℝ))
  have f2 := fixed_eq k (h ((-1 : ℝ) : OnePoint ℝ))
  have hdet := det_ent k
  have hb : ent k 0 1 = 0 := by linarith
  have hc : ent k 1 0 = 0 := by linarith
  have hd : ent k 1 1 = ent k 0 0 := by linarith
  refine ⟨hc, hb, hd, ?_⟩
  rw [hb, hd] at hdet
  linarith

/-- Two matrices with the same Möbius map agree up to a sign. -/
lemma ent_eq_of_mob_eq (g g' : Matrix.SpecialLinearGroup (Fin 2) A) (h : mob g = mob g') :
    ∃ a : ℝ, a * a = 1 ∧ ∀ i j, ent g i j = a * ent g' i j := by
  have hk : ∀ p, mob (g'⁻¹ * g) p = p := fun p => by
    rw [mob_mul, h, mob_inv_mob]
  obtain ⟨hc, hb, hd, ha⟩ := ent_of_mob_eq_id _ hk
  refine ⟨ent (g'⁻¹ * g) 0 0, ha, fun i j => ?_⟩
  have e : g = g' * (g'⁻¹ * g) := by group
  conv_lhs => rw [e]
  rw [ent_mul]
  fin_cases j <;> simp [hb, hc, hd] <;> ring

lemma mu_sq_eq_of_mob_eq {g g' : Matrix.SpecialLinearGroup (Fin 2) A} (h : mob g = mob g')
    (t : ℝ) : mu g t ^ 2 = mu g' t ^ 2 := by
  obtain ⟨a, ha, he⟩ := ent_eq_of_mob_eq g g' h
  simp only [mu, he]
  have : (a * ent g' 1 0 * t + a * ent g' 1 1) ^ 2 =
      (a * a) * (ent g' 1 0 * t + ent g' 1 1) ^ 2 := by ring
  rw [this, ha, one_mul]

lemma nhdsGT_le_cofinite (t : ℝ) : 𝓝[>] t ≤ cofinite :=
  le_trans (nhdsWithin_mono t (fun y (hy : t < y) => ne_of_gt hy)) (Monod.Dev.Alg.nhdsNE_le_cofinite t)

lemma nhdsLT_le_cofinite (t : ℝ) : 𝓝[<] t ≤ cofinite :=
  le_trans (nhdsWithin_mono t (fun y (hy : y < t) => ne_of_lt hy)) (Monod.Dev.Alg.nhdsNE_le_cofinite t)

lemma mob_eq_of_RF {f : OnePoint ℝ → OnePoint ℝ} {x : OnePoint ℝ}
    {g g' : Matrix.SpecialLinearGroup (Fin 2) A} (h1 : f =ᶠ[RF x] mob g)
    (h2 : f =ᶠ[RF x] mob g') : mob g = mob g' := by
  have h := h1.symm.trans h2
  cases x with
  | infty =>
    rw [RF_infty] at h
    exact Monod.Dev.Alg.mob_eq_of_eventually g g' atBot_le_cofinite (eventually_map.1 h)
  | coe t =>
    rw [RF_coe] at h
    exact Monod.Dev.Alg.mob_eq_of_eventually g g' (nhdsGT_le_cofinite t) (eventually_map.1 h)

lemma mob_eq_of_LF {f : OnePoint ℝ → OnePoint ℝ} {x : OnePoint ℝ}
    {g g' : Matrix.SpecialLinearGroup (Fin 2) A} (h1 : f =ᶠ[LF x] mob g)
    (h2 : f =ᶠ[LF x] mob g') : mob g = mob g' := by
  have h := h1.symm.trans h2
  cases x with
  | infty =>
    rw [LF_infty] at h
    exact Monod.Dev.Alg.mob_eq_of_eventually g g' atTop_le_cofinite (eventually_map.1 h)
  | coe t =>
    rw [LF_coe] at h
    exact Monod.Dev.Alg.mob_eq_of_eventually g g' (nhdsLT_le_cofinite t) (eventually_map.1 h)

/-- `P_A` is invariant under `SL(2, A)` (as `Monod.Dev.Alg.mob_mem_P`, reproved here so that this
file does not import `AlgG`, which imports a published stub). -/
lemma mob_mem_P' {p : OnePoint ℝ} (hp : p ∈ P A) (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    mob g p ∈ P A := by
  obtain ⟨h, hh, hfix⟩ := hp
  refine ⟨g * h * g⁻¹, ?_, ?_⟩
  · unfold IsHyperbolic at *
    have e1 : (g * h * g⁻¹).val = g.val * h.val * (g⁻¹).val := rfl
    have e2 : (g⁻¹).val * g.val = 1 := congrArg Subtype.val (inv_mul_cancel g)
    have : Matrix.trace (g * h * g⁻¹).val = Matrix.trace h.val := by
      rw [e1, Matrix.trace_mul_comm, ← Matrix.mul_assoc, e2, Matrix.one_mul]
    rw [this]; exact hh
  · rw [mob_mul, mob_mul, mob_inv_mob, hfix]

/-! ### Arithmetic of fixed points -/

/-- A fixed point of a hyperbolic element of `SL(2, ℤ)` is irrational. -/
lemma irrational_of_mem_P {b : ℝ} (hb : (b : OnePoint ℝ) ∈ P (⊥ : Subring ℝ)) : Irrational b := by
  obtain ⟨h, hyp, hfix⟩ := hb
  unfold IsHyperbolic at hyp
  rw [trace_ent] at hyp
  have fe := fixed_eq h hfix
  have hdet := det_ent h
  obtain ⟨a, ha⟩ := ent_int h 0 0
  obtain ⟨β, hβ⟩ := ent_int h 0 1
  obtain ⟨c, hc⟩ := ent_int h 1 0
  obtain ⟨d, hd⟩ := ent_int h 1 1
  rw [ha, hβ, hc, hd] at fe hdet
  rw [ha, hd] at hyp
  have hdetZ : a * d - β * c = 1 := by exact_mod_cast hdet
  have hyp' : 2 < |a + d| := by exact_mod_cast hyp
  -- `c ≠ 0`, else `a d = 1` forces `|a + d| = 2`
  have hc0 : c ≠ 0 := by
    rintro rfl
    have had : a * d = 1 := by linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one' had with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> norm_num at hyp'
  -- `r = 2 c b + d - a` satisfies `r² = (a + d)² - 4`
  set r : ℝ := 2 * c * b + d - a with hr
  have hr2 : r ^ 2 = (((a + d) ^ 2 - 4 : ℤ) : ℝ) := by
    push_cast
    have hdetR : (a : ℝ) * d - β * c = 1 := by exact_mod_cast hdetZ
    rw [hr]
    linear_combination (-4 * (c : ℝ)) * fe - 4 * hdetR
  intro ⟨q, hq⟩
  -- `r` is rational
  have hrq : r = ((2 * c * q + d - a : ℚ) : ℝ) := by rw [hr, ← hq]; push_cast; ring
  by_cases hint : ∃ s : ℤ, r = s
  · obtain ⟨s, hs⟩ := hint
    rw [hs] at hr2
    have hsZ : s ^ 2 = (a + d) ^ 2 - 4 := by exact_mod_cast hr2
    have hu : 0 ≤ |s| := abs_nonneg s
    have huv : |s| ^ 2 = |a + d| ^ 2 - 4 := by rw [sq_abs, sq_abs]; exact hsZ
    have hlt : |s| < |a + d| := by
      by_contra hcon
      rw [not_lt] at hcon
      nlinarith
    have h1 : |s| + 1 ≤ |a + d| := hlt
    nlinarith
  · exact (irrational_nrt_of_notint_nrt 2 _ hr2 hint (by norm_num)) ⟨_, hrq.symm⟩

/-- An element of `SL(2, ℤ)` fixing an irrational point with multiplier `± 1` acts trivially. -/
lemma mob_eq_id_of_mu_sq {k : SLZ} {b : ℝ} (hb : Irrational b) (hfix : mob k (b : OnePoint ℝ) = b)
    (hmu : mu k b ^ 2 = 1) : ∀ p, mob k p = p := by
  have fe := fixed_eq k hfix
  have hdet := det_ent k
  obtain ⟨a, ha⟩ := ent_int k 0 0
  obtain ⟨β, hβ⟩ := ent_int k 0 1
  obtain ⟨c, hc⟩ := ent_int k 1 0
  obtain ⟨d, hd⟩ := ent_int k 1 1
  have hε : mu k b = 1 ∨ mu k b = -1 := mul_self_eq_one_iff.1 (by rw [← sq]; exact hmu)
  have hc0 : c = 0 := by
    by_contra hc0
    have hcR : (c : ℝ) ≠ 0 := by exact_mod_cast hc0
    apply hb
    obtain ⟨e, he, he1⟩ : ∃ e : ℤ, mu k b = e ∧ True := by
      rcases hε with h | h
      · exact ⟨1, by rw [h]; norm_num, trivial⟩
      · exact ⟨-1, by rw [h]; norm_num, trivial⟩
    refine ⟨((e - d : ℤ) : ℚ) / c, ?_⟩
    have : (c : ℝ) * b + d = e := by rw [← he, mu, hc, hd]
    push_cast
    field_simp
    linarith
  have hcR : ent k 1 0 = 0 := by rw [hc, hc0]; simp
  have hmud : mu k b = ent k 1 1 := by rw [mu, hcR, zero_mul, zero_add]
  have hd1 : ent k 1 1 * ent k 1 1 = 1 := by rw [← hmud, ← sq]; exact hmu
  have had : ent k 0 0 * ent k 1 1 = 1 := by rw [hcR] at hdet; linarith
  have hda : ent k 0 0 = ent k 1 1 := by
    have : ent k 0 0 = ent k 0 0 * (ent k 1 1 * ent k 1 1) := by rw [hd1, mul_one]
    rw [this, ← mul_assoc, had, one_mul]
  have hb0 : ent k 0 1 = 0 := by
    rw [hcR, zero_mul, zero_add, hda] at fe
    linarith [mul_comm b (ent k 1 1)]
  have hd0 : ent k 1 1 ≠ 0 := by intro h0; rw [h0] at hd1; simp at hd1
  intro p
  cases p with
  | infty => rw [mob_infty, if_pos hcR]
  | coe t =>
    rw [mob_coe, hcR, zero_mul, zero_add, if_neg hd0, hb0, add_zero, hda]
    congr 1
    field_simp

end FAmenHZ
end

section
/-!
# The action of the homeomorphisms of `P¹` on `P¹`

The instance is the definitions bundle's `HomeomorphAction.applyMulAction` (`f • x = f x`);
subgroups such as `Monod.H ⊥` act through `Subgroup`'s induced action.
-/

namespace FAmenHZ

end FAmenHZ
end

section
/-!
# The jump function of `H(ℤ)`: germs, logarithmic derivatives, translation germ

For `f ∈ H(ℤ)` and a real `t`, the one-sided germs of `f` at `t` are Möbius maps `mob γ₋`,
`mob γ₊`, and `log f'₊(t) - log f'₋(t) = log (mu γ₋ t)² - log (mu γ₊ t)²` (`jumpFun`, real
valued: the lamps are `(ℝ, +)`). At `∞` we record instead the translation amount `tau f` of the
germ of `f` at `+∞` (an element of `SL(2, ℤ)` fixing `∞` acts as `x ↦ x + n`). Since `∞` is fixed
by `H(ℤ)`, `g ↦ jumpFun g` is a cocycle: `jumpFun (g h) x = jumpFun g (h x) + jumpFun h x`.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

/-- `H(ℤ)`. -/
abbrev HZ := H (⊥ : Subring ℝ)

lemma H_smul (g : H (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    g • x = (g : OnePoint ℝ ≃ₜ OnePoint ℝ) x := rfl

/-! ### Basic facts on `H(ℤ)` -/

lemma exists_real_of_fix {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∞ = ∞) (t : ℝ) :
    ∃ s : ℝ, f t = s := by
  have : f t ≠ ∞ := by
    intro h
    rw [← hf] at h
    exact coe_ne_infty t (f.injective h)
  exact OnePoint.ne_infty_iff_exists.1 this |>.imp fun s hs => hs.symm

/-- `H(ℤ)` preserves `P_ℤ`. -/
lemma smul_mem_P (g : HZ) {p : OnePoint ℝ} (hp : p ∈ P (⊥ : Subring ℝ)) :
    g • p ∈ P (⊥ : Subring ℝ) := by
  obtain ⟨γ, hγ⟩ := orbit_of_mem_G g.2.1 p
  rw [H_smul, hγ]
  exact mob_mem_P' hp γ

lemma smul_infty (g : HZ) : g • (∞ : OnePoint ℝ) = ∞ := g.2.2

/-! ### Chosen germs -/

/-- A Möbius matrix agreeing with `f` just right of `x` (`1` if there is none). -/
noncomputable def rg (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (x : OnePoint ℝ) : SLZ :=
  open Classical in
  if h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF x] mob g then h.choose else 1

/-- A Möbius matrix agreeing with `f` just left of `x` (`1` if there is none). -/
noncomputable def lg (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (x : OnePoint ℝ) : SLZ :=
  open Classical in
  if h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob g then h.choose else 1

lemma rg_spec {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF x] mob (rg f x) := by
  have h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF x] mob g := germR_of_mem_G hf x
  rw [rg, dif_pos h]
  exact h.choose_spec

lemma lg_spec {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob (lg f x) := by
  have h : ∃ g : SLZ, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob g := germL_of_mem_G hf x
  rw [lg, dif_pos h]
  exact h.choose_spec

/-- Germs along `RF` compose. -/
lemma germ_mul_RF {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} {x y : OnePoint ℝ} {g₁ g₂ : SLZ}
    (hxy : f₂ x = y) (h₂ : (f₂ : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF x] mob g₂)
    (h₁ : (f₁ : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF y] mob g₁) :
    ((f₁ * f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF x] mob (g₁ * g₂) := by
  subst hxy
  have hx : f₂ x = mob g₂ x := germ_value RF_le_nhds f₂.continuous h₂
  have ht : Tendsto f₂ (RF x) (RF (f₂ x)) := by
    rw [hx]; exact (tendsto_RF g₂ x).congr' h₂.symm
  filter_upwards [ht.eventually h₁, h₂] with y hy1 hy2
  rw [Homeomorph.mul_apply, mob_mul, hy1, hy2]

/-- Germs along `LF` compose. -/
lemma germ_mul_LF {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} {x y : OnePoint ℝ} {g₁ g₂ : SLZ}
    (hxy : f₂ x = y) (h₂ : (f₂ : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob g₂)
    (h₁ : (f₁ : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF y] mob g₁) :
    ((f₁ * f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF x] mob (g₁ * g₂) := by
  subst hxy
  have hx : f₂ x = mob g₂ x := germ_value LF_le_nhds f₂.continuous h₂
  have ht : Tendsto f₂ (LF x) (LF (f₂ x)) := by
    rw [hx]; exact (tendsto_LF g₂ x).congr' h₂.symm
  filter_upwards [ht.eventually h₁, h₂] with y hy1 hy2
  rw [Homeomorph.mul_apply, mob_mul, hy1, hy2]

/-! ### Logarithmic derivatives -/

/-- `- log` of the right derivative of `f` at `t`: `log (mu γ₊ t)²`. -/
noncomputable def rlog (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (t : ℝ) : ℝ := Real.log (mu (rg f t) t ^ 2)

/-- `- log` of the left derivative of `f` at `t`: `log (mu γ₋ t)²`. -/
noncomputable def llog (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (t : ℝ) : ℝ := Real.log (mu (lg f t) t ^ 2)

lemma rlog_eq {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) {t : ℝ} {g : SLZ}
    (h : (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF t] mob g) : rlog f t = Real.log (mu g t ^ 2) := by
  rw [rlog, mu_sq_eq_of_mob_eq (mob_eq_of_RF (rg_spec hf t) h)]

lemma llog_eq {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) {t : ℝ} {g : SLZ}
    (h : (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF t] mob g) : llog f t = Real.log (mu g t ^ 2) := by
  rw [llog, mu_sq_eq_of_mob_eq (mob_eq_of_LF (lg_spec hf t) h)]

lemma rlog_mul {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} (h₁ : f₁ ∈ H (⊥ : Subring ℝ))
    (h₂ : f₂ ∈ H (⊥ : Subring ℝ)) {t s : ℝ} (hs : f₂ t = s) :
    rlog (f₁ * f₂) t = rlog f₁ s + rlog f₂ t := by
  have e₂ := rg_spec h₂.1 (t : OnePoint ℝ)
  have e₁ := rg_spec h₁.1 (s : OnePoint ℝ)
  have e := germ_mul_RF hs e₂ e₁
  have hm : mob (rg f₂ t) (t : OnePoint ℝ) = s := by
    rw [← hs]; exact (germ_value RF_le_nhds f₂.continuous e₂).symm
  obtain ⟨u, hu⟩ := exists_real_of_fix h₁.2 s
  have hm₁ : mob (rg f₁ s) (s : OnePoint ℝ) = u := by
    rw [← hu]; exact (germ_value RF_le_nhds f₁.continuous (rg_spec h₁.1 (s : OnePoint ℝ))).symm
  have hmu₂ := mu_ne_of_mob_eq hm
  have hmu₁ := mu_ne_of_mob_eq hm₁
  rw [rlog_eq (mul_mem h₁ h₂).1 e, mu_mul _ _ hmu₂, val_eq_of_mob_eq hm, mul_pow,
    Real.log_mul (pow_ne_zero 2 hmu₁) (pow_ne_zero 2 hmu₂)]
  rfl

lemma llog_mul {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} (h₁ : f₁ ∈ H (⊥ : Subring ℝ))
    (h₂ : f₂ ∈ H (⊥ : Subring ℝ)) {t s : ℝ} (hs : f₂ t = s) :
    llog (f₁ * f₂) t = llog f₁ s + llog f₂ t := by
  have e₂ := lg_spec h₂.1 (t : OnePoint ℝ)
  have e₁ := lg_spec h₁.1 (s : OnePoint ℝ)
  have e := germ_mul_LF hs e₂ e₁
  have hm : mob (lg f₂ t) (t : OnePoint ℝ) = s := by
    rw [← hs]; exact (germ_value LF_le_nhds f₂.continuous e₂).symm
  obtain ⟨u, hu⟩ := exists_real_of_fix h₁.2 s
  have hm₁ : mob (lg f₁ s) (s : OnePoint ℝ) = u := by
    rw [← hu]; exact (germ_value LF_le_nhds f₁.continuous (lg_spec h₁.1 (s : OnePoint ℝ))).symm
  have hmu₂ := mu_ne_of_mob_eq hm
  have hmu₁ := mu_ne_of_mob_eq hm₁
  rw [llog_eq (mul_mem h₁ h₂).1 e, mu_mul _ _ hmu₂, val_eq_of_mob_eq hm, mul_pow,
    Real.log_mul (pow_ne_zero 2 hmu₁) (pow_ne_zero 2 hmu₂)]
  rfl

/-! ### The translation germ at `+∞` -/

/-- `b d` for `!![a, b; 0, d]`: the translation amount of an element of `SL(2, ℤ)` fixing `∞`. -/
noncomputable def trans (k : SLZ) : ℝ := ent k 0 1 * ent k 1 1

/-- The translation amount of the germ of `f` at `+∞`. -/
noncomputable def tau (f : OnePoint ℝ ≃ₜ OnePoint ℝ) : ℝ := trans (lg f ∞)

lemma trans_eq_of_mob_eq {k k' : SLZ} (h : mob k = mob k') : trans k = trans k' := by
  obtain ⟨a, ha, he⟩ := ent_eq_of_mob_eq k k' h
  simp only [trans, he]
  linear_combination (ent k' 0 1 * ent k' 1 1) * ha

lemma upper_of_fix {k : SLZ} (h : mob k ∞ = ∞) :
    ent k 1 0 = 0 ∧ ent k 0 0 = ent k 1 1 ∧ ent k 1 1 * ent k 1 1 = 1 := by
  have hc : ent k 1 0 = 0 := by
    by_contra hc
    rw [mob_infty, if_neg hc] at h
    exact coe_ne_infty _ h
  have hdet := det_ent k
  rw [hc, mul_zero, sub_zero] at hdet
  obtain ⟨a, ha⟩ := ent_int k 0 0
  obtain ⟨d, hd⟩ := ent_int k 1 1
  rw [ha, hd] at hdet ⊢
  have hadZ : a * d = 1 := by exact_mod_cast hdet
  rcases Int.eq_one_or_neg_one_of_mul_eq_one' hadZ with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    norm_num [hc]

lemma trans_mul {k₁ k₂ : SLZ} (h₁ : mob k₁ ∞ = ∞) (h₂ : mob k₂ ∞ = ∞) :
    trans (k₁ * k₂) = trans k₁ + trans k₂ := by
  obtain ⟨c₁, a₁, d₁⟩ := upper_of_fix h₁
  obtain ⟨c₂, a₂, d₂⟩ := upper_of_fix h₂
  simp only [trans, ent_mul, c₁]
  rw [a₁]
  linear_combination (ent k₂ 0 1 * ent k₂ 1 1) * d₁ + ent k₁ 0 1 * ent k₁ 1 1 * d₂

lemma lg_fix {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ)) : mob (lg f ∞) ∞ = ∞ := by
  rw [← germ_value LF_le_nhds f.continuous (lg_spec hf.1 ∞)]
  exact hf.2

lemma tau_mul {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} (h₁ : f₁ ∈ H (⊥ : Subring ℝ))
    (h₂ : f₂ ∈ H (⊥ : Subring ℝ)) : tau (f₁ * f₂) = tau f₁ + tau f₂ := by
  have e₂ := lg_spec h₂.1 ∞
  have e₁ := lg_spec h₁.1 ∞
  have e := germ_mul_LF h₂.2 e₂ e₁
  rw [tau, trans_eq_of_mob_eq (mob_eq_of_LF (lg_spec (mul_mem h₁ h₂).1 ∞) e),
    trans_mul (lg_fix h₁) (lg_fix h₂)]
  rfl

/-- If the translation germ vanishes, `f` is the identity near `+∞`. -/
lemma eventually_eq_of_tau {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ))
    (h : tau f = 0) : ∀ᶠ y : ℝ in atTop, f (y : OnePoint ℝ) = y := by
  obtain ⟨c, a, d⟩ := upper_of_fix (lg_fix hf)
  have hd0 : ent (lg f ∞) 1 1 ≠ 0 := by intro h0; rw [h0] at d; simp at d
  have hb : ent (lg f ∞) 0 1 = 0 := by
    rw [tau, trans] at h
    exact (mul_eq_zero.1 h).resolve_right hd0
  have e := lg_spec hf.1 ∞
  rw [LF_infty] at e
  filter_upwards [eventually_map.1 e] with y hy
  rw [hy, mob_coe, c, zero_mul, zero_add, if_neg hd0, hb, add_zero, a]
  congr 1
  field_simp

/-! ### The jump function and the cocycle identity -/

/-- The jump of `log f'` at a real point; the translation germ at `∞`. -/
noncomputable def jumpFun (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (x : OnePoint ℝ) : ℝ :=
  x.elim (tau f) (fun t => llog f t - rlog f t)

lemma jumpFun_infty (f : OnePoint ℝ ≃ₜ OnePoint ℝ) : jumpFun f ∞ = tau f := rfl

lemma jumpFun_coe (f : OnePoint ℝ ≃ₜ OnePoint ℝ) (t : ℝ) :
    jumpFun f t = llog f t - rlog f t := rfl

lemma jumpFun_mul {f₁ f₂ : OnePoint ℝ ≃ₜ OnePoint ℝ} (h₁ : f₁ ∈ H (⊥ : Subring ℝ))
    (h₂ : f₂ ∈ H (⊥ : Subring ℝ)) (x : OnePoint ℝ) :
    jumpFun (f₁ * f₂) x = jumpFun f₁ (f₂ x) + jumpFun f₂ x := by
  cases x with
  | infty =>
    rw [h₂.2, jumpFun_infty, jumpFun_infty, jumpFun_infty, tau_mul h₁ h₂]
  | coe t =>
    obtain ⟨s, hs⟩ := exists_real_of_fix h₂.2 t
    rw [hs, jumpFun_coe, jumpFun_coe, jumpFun_coe, rlog_mul h₁ h₂ hs, llog_mul h₁ h₂ hs]
    ring

/-- Away from the breakpoints the jump vanishes. -/
lemma jumpFun_eq_zero_of_nhds {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G (⊥ : Subring ℝ)) {t : ℝ}
    {g : SLZ} (h : ∀ᶠ y in 𝓝 (t : OnePoint ℝ), f y = mob g y) : jumpFun f t = 0 := by
  rw [jumpFun_coe, rlog_eq hf (h.filter_mono (RF_le_nhds _)),
    llog_eq hf (h.filter_mono (LF_le_nhds _)), sub_self]

end FAmenHZ
end

section
/-!
# The jumps of an element of `H(ℤ)` are finitely supported in `{∞} ∪ P_ℤ`

The breakpoints lie in `P_ℤ` by the published `Monod.mem_G_iff_isPiecewiseProj`; away from
them both one-sided germs agree and the jump vanishes.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

lemma pw_of_mem_H {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ)) :
    IsPiecewiseProj (⊥ : Subring ℝ) f :=
  -- the published Monod milestone (a real edge); `Monod.Dev.Alg.mem_G_iff_isPiecewiseProj_direct`
  -- is the same fact proved from scratch
  ((Monod.mem_G_iff_isPiecewiseProj _ f).1 hf.1).2

lemma support_jumpFun_subset {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ)) :
    ∃ B : Finset (OnePoint ℝ), (↑B : Set (OnePoint ℝ)) ⊆ P (⊥ : Subring ℝ) ∧
      Function.support (jumpFun f) ⊆ insert ∞ (↑B : Set (OnePoint ℝ)) := by
  obtain ⟨B, hBP, hloc⟩ := pw_of_mem_H hf
  refine ⟨B, hBP, fun x hx => ?_⟩
  by_contra hxB
  rw [Set.mem_insert_iff, not_or] at hxB
  obtain ⟨t, rfl⟩ := OnePoint.ne_infty_iff_exists.1 hxB.1
  obtain ⟨g, hg⟩ := hloc _ hxB.2
  exact hx (jumpFun_eq_zero_of_nhds hf.1 hg)

lemma finite_support_jumpFun {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H (⊥ : Subring ℝ)) :
    (Function.support (jumpFun f)).Finite := by
  obtain ⟨B, -, hB⟩ := support_jumpFun_subset hf
  exact ((B.finite_toSet).insert ∞).subset hB

end FAmenHZ
end

section
/-!
# The jump cocycle of `H(ℤ)` and freeness of its affine action

`c g = g · jump g ∈ P¹ →₀ ℝ` (jumps of `log g'` at the breakpoints, which lie in `P_ℤ`, and the
translation germ at `∞`): `c (g h) = c g + g · c h`, supports in `P_ℤ ∪ {∞}`, and
`c g + g · φ = φ` forces `g = 1`.
-/

open OnePoint Filter Topology Set

namespace FAmenHZ

open Monod Monod.Dev.Dyn

/-- The jumps of `g`, as a finitely supported function. -/
noncomputable def jump (g : HZ) : OnePoint ℝ →₀ ℝ :=
  Finsupp.ofSupportFinite (jumpFun (g : OnePoint ℝ ≃ₜ OnePoint ℝ)) (finite_support_jumpFun g.2)

lemma jump_apply (g : HZ) (x : OnePoint ℝ) : jump g x = jumpFun (g : OnePoint ℝ ≃ₜ OnePoint ℝ) x :=
  rfl

/-- The cocycle `c g = g · jump g`, i.e. `c g x = jump g (g⁻¹ x)`. -/
noncomputable def cocycle (g : HZ) : OnePoint ℝ →₀ ℝ :=
  Finsupp.mapDomain (fun x => g • x) (jump g)

lemma mapDomain_smul_apply (g : HZ) (φ : OnePoint ℝ →₀ ℝ) (z : OnePoint ℝ) :
    Finsupp.mapDomain (fun x => g • x) φ (g • z) = φ z :=
  Finsupp.mapDomain_apply (MulAction.injective g) φ z

lemma cocycle_smul (g : HZ) (z : OnePoint ℝ) :
    cocycle g (g • z) = jumpFun (g : OnePoint ℝ ≃ₜ OnePoint ℝ) z :=
  mapDomain_smul_apply g _ z

theorem cocycle_mul (g h : HZ) :
    cocycle (g * h) = cocycle g + Finsupp.mapDomain (fun x => g • x) (cocycle h) := by
  ext y
  obtain ⟨z, rfl⟩ : ∃ z, (g * h) • z = y := ⟨(g * h)⁻¹ • y, smul_inv_smul _ _⟩
  rw [Finsupp.add_apply, cocycle_smul, mul_smul, cocycle_smul, mapDomain_smul_apply,
    cocycle_smul]
  exact jumpFun_mul g.2 h.2 z

theorem cocycle_support (g : HZ) :
    (↑(cocycle g).support : Set (OnePoint ℝ)) ⊆ insert ∞ (P (⊥ : Subring ℝ)) := by
  classical
  intro y hy
  have hy' := Finsupp.mapDomain_support (f := fun x => g • x) (s := jump g) hy
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.1 hy'
  obtain ⟨B, hBP, hB⟩ := support_jumpFun_subset g.2
  have hz' : z ∈ Function.support (jumpFun (g : OnePoint ℝ ≃ₜ OnePoint ℝ)) := by
    rw [Function.mem_support, ← jump_apply]
    exact Finsupp.mem_support_iff.1 hz
  rcases hB hz' with rfl | hzB
  · exact Or.inl (smul_infty g)
  · exact Or.inr (smul_mem_P g (hBP hzB))

/-- At a fixed point of `g`, a fixed configuration forces the jump to vanish. -/
lemma jumpFun_eq_zero_of_fixed {g : HZ} {φ : OnePoint ℝ →₀ ℝ}
    (h : cocycle g + Finsupp.mapDomain (fun x => g • x) φ = φ) {z : OnePoint ℝ}
    (hz : g • z = z) : jumpFun (g : OnePoint ℝ ≃ₜ OnePoint ℝ) z = 0 := by
  have := congrArg (fun ψ : OnePoint ℝ →₀ ℝ => ψ (g • z)) h
  simp only [Finsupp.add_apply, cocycle_smul, mapDomain_smul_apply] at this
  rw [hz] at this
  linarith

/-- **Freeness** of the affine action. -/
theorem cocycle_free (g : HZ) (φ : OnePoint ℝ →₀ ℝ)
    (h : cocycle g + Finsupp.mapDomain (fun x => g • x) φ = φ) : g = 1 := by
  set f : OnePoint ℝ ≃ₜ OnePoint ℝ := (g : OnePoint ℝ ≃ₜ OnePoint ℝ) with hfdef
  have hfH : f ∈ H (⊥ : Subring ℝ) := g.2
  -- the translation germ vanishes, so `f` is the identity near `+∞`
  have htau : tau f = 0 := jumpFun_eq_zero_of_fixed h (smul_infty g)
  obtain ⟨M, hM⟩ := eventually_atTop.1 (eventually_eq_of_tau hfH htau)
  by_contra hne
  have hex : ∃ t : ℝ, f t ≠ t := by
    by_contra hall
    simp only [not_exists, not_not] at hall
    apply hne
    apply Subtype.ext
    ext x
    cases x with
    | infty => exact hfH.2
    | coe t => exact hall t
  set S : Set ℝ := {y : ℝ | f y ≠ y} with hSdef
  obtain ⟨t₀, ht₀⟩ := hex
  have hSne : S.Nonempty := ⟨t₀, ht₀⟩
  have hbdd : BddAbove S := ⟨M, fun y hy => by
    by_contra hyM
    exact hy (hM y (le_of_lt (not_le.1 hyM)))⟩
  set b := sSup S with hb
  -- `b` is fixed
  have hSopen : IsOpen S :=
    (isOpen_ne_fun f.continuous continuous_id).preimage continuous_coe
  have hfb : f b = b := by
    by_contra hfb
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hSopen b hfb
    have hmem : b + ε / 2 ∈ S := hball (by
      rw [Metric.mem_ball, Real.dist_eq, abs_lt]; constructor <;> linarith)
    have := le_csSup hbdd hmem
    linarith
  -- right of `b`, `f` is the identity
  have hright : ∀ y : ℝ, b < y → f y = y := by
    intro y hy
    by_contra hfy
    have := le_csSup hbdd hfy
    linarith
  have hRF : (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[RF b] mob (1 : SLZ) := by
    rw [RF_coe]
    refine eventually_map.2 ?_
    filter_upwards [self_mem_nhdsWithin] with y hy
    rw [hright y hy, mob_one]
  -- the left germ `γ` at `b`
  set γ := lg f b with hγ
  have hLF : (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[LF b] mob γ := lg_spec hfH.1 b
  have hγb : mob γ (b : OnePoint ℝ) = b := by
    rw [← germ_value LF_le_nhds f.continuous hLF, hfb]
  -- the jump at `b` vanishes, so `(mu γ b)² = 1`
  have hj : jumpFun f b = 0 := jumpFun_eq_zero_of_fixed h hfb
  rw [jumpFun_coe, rlog_eq hfH.1 hRF, mu_one, one_pow, Real.log_one, sub_zero, llog] at hj
  have hmu0 : mu γ b ≠ 0 := mu_ne_of_mob_eq hγb
  have hmu : mu γ b ^ 2 = 1 := by
    rcases Real.log_eq_zero.1 hj with h0 | h1 | h1
    · exact absurd h0 (pow_ne_zero 2 hmu0)
    · exact h1
    · nlinarith [sq_nonneg (mu γ b)]
  -- hence `γ` acts trivially: either `b` is not a breakpoint, or `b ∈ P_ℤ` is irrational
  have hγid : ∀ p, mob γ p = p := by
    obtain ⟨B, hBP, hloc⟩ := pw_of_mem_H hfH
    by_cases hbB : (b : OnePoint ℝ) ∈ B
    · exact mob_eq_id_of_mu_sq (irrational_of_mem_P (hBP hbB)) hγb hmu
    · obtain ⟨g', hg'⟩ := hloc _ hbB
      have e1 : mob g' = mob (1 : SLZ) := mob_eq_of_RF (hg'.filter_mono (RF_le_nhds _)) hRF
      have e2 : mob g' = mob γ := mob_eq_of_LF (hg'.filter_mono (LF_le_nhds _)) hLF
      intro p
      rw [← e2, e1, mob_one]
  -- so `f` is the identity just left of `b`, contradicting `b = sup S`
  have hleft : ∀ᶠ y : ℝ in 𝓝[<] b, f (y : OnePoint ℝ) = y := by
    rw [LF_coe] at hLF
    filter_upwards [eventually_map.1 hLF] with y hy
    rw [hy, hγid]
  obtain ⟨l, hl, hsub⟩ := mem_nhdsLT_iff_exists_Ioo_subset.1 hleft
  obtain ⟨s, hsS, hls⟩ := exists_lt_of_lt_csSup hSne hl
  have hsb : s ≤ b := le_csSup hbdd hsS
  have hsb' : s ≠ b := by
    rintro rfl
    exact hsS hfb
  exact hsS (hsub ⟨hls, lt_of_le_of_ne hsb hsb'⟩)

end FAmenHZ
end

section
/-!
# Changing the set of an extensively amenable action

* Adjoining a `G`-fixed point `p` to `Y` keeps extensive amenability (push the mean along
  `E ↦ insert p E`).
* Extensive amenability on `Y` gives it on any `G`-invariant `Z ⊆ Y` (push the mean along
  `E ↦ E ∩ Z`).
-/

open scoped ENNReal Pointwise

namespace FAmenHZ

section Insert

variable {G X : Type*} [Group G] [MulAction G X]

lemma fam_mono' {α : Type*} {m : Set α → ℝ≥0∞} (hm : Garrido.IsFinitelyAdditiveMeasure m)
    {s t : Set α} (hst : s ⊆ t) : m s ≤ m t := by
  have := hm.2 s (t \ s) disjoint_sdiff_self_right
  rw [Set.union_sdiff_cancel hst] at this
  rw [this]
  exact le_self_add

/-- Adjoining a `G`-fixed point `p` to `Y` keeps extensive amenability: push the mean forward
along `E ↦ insert p E`. -/
theorem isExtensivelyAmenableOn_insert [DecidableEq X] (Y : Set X) (p : X)
    (hp : ∀ g : G, g • p = p) (h : ThompsonAmenability.IsExtensivelyAmenableOn G X Y) :
    ThompsonAmenability.IsExtensivelyAmenableOn G X (insert p Y) := by
  obtain ⟨m, hm, hY, h1, hinv, hcone⟩ := h
  have hle : ∀ S, m S ≤ 1 := fun S => h1 ▸ fam_mono' hm (Set.subset_univ S)
  let act : G → Finset X → Finset X := fun g E => E.map (MulAction.toPerm g).toEmbedding
  have mem_act : ∀ g E x, x ∈ act g E ↔ g⁻¹ • x ∈ E := by
    intro g E x
    simp only [act, Finset.mem_map, Equiv.toEmbedding_apply, MulAction.toPerm_apply]
    constructor
    · rintro ⟨a, ha, rfl⟩; simpa using ha
    · intro hx; exact ⟨g⁻¹ • x, hx, by simp⟩
  have act_inv : ∀ g E, act g⁻¹ (act g E) = E := by
    intro g E; ext x; simp [mem_act]
  have act_inv' : ∀ g E, act g (act g⁻¹ E) = E := by
    intro g E; ext x; simp [mem_act]
  have act_insert : ∀ g E, act g (insert p E) = insert p (act g E) := by
    intro g E; ext x
    rw [mem_act, Finset.mem_insert, Finset.mem_insert, mem_act]
    constructor
    · rintro (h | h)
      · left; rw [← smul_inv_smul g x, h, hp]
      · right; exact h
    · rintro (h | h)
      · left; rw [h, hp]
      · right; exact h
  refine ⟨fun S => m {E | insert p E ∈ S}, ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · simpa using hm.1
  · intro s t hst
    have : {E : Finset X | insert p E ∈ s ∪ t} = {E | insert p E ∈ s} ∪ {E | insert p E ∈ t} := by
      ext E; simp
    simp only
    rw [this]
    exact hm.2 _ _ (Set.disjoint_left.2 fun E hs ht => Set.disjoint_left.1 hst hs ht)
  · refine le_antisymm (hle _) ?_
    rw [← hY]
    refine fam_mono' hm fun E hE => ?_
    simp only [Set.mem_ofPred_eq, Finset.coe_insert] at hE ⊢
    exact Set.insert_subset_insert hE
  · simpa using h1
  · intro g S
    simp only
    have : {E : Finset X | insert p E ∈ (fun E => E.map (MulAction.toPerm g).toEmbedding) '' S} =
        (fun E => E.map (MulAction.toPerm g).toEmbedding) '' {E | insert p E ∈ S} := by
      ext E
      simp only [Set.mem_ofPred_eq, Set.mem_image]
      constructor
      · rintro ⟨F, hF, hFE⟩
        refine ⟨act g⁻¹ E, ?_, act_inv' g E⟩
        have : F = act g⁻¹ (insert p E) := by
          rw [← hFE]; exact (act_inv g F).symm
        rw [this, act_insert] at hF
        exact hF
      · rintro ⟨F, hF, rfl⟩
        exact ⟨insert p F, hF, act_insert g F⟩
    rw [this]
    exact hinv g _
  · intro E₀ hE₀
    refine le_antisymm (hle _) ?_
    have hE₀' : (↑(E₀.erase p) : Set X) ⊆ Y := by
      intro x hx
      rw [Finset.coe_erase] at hx
      rcases hE₀ hx.1 with h | h
      · exact absurd h hx.2
      · exact h
    rw [← hcone _ hE₀']
    refine fam_mono' hm fun E hE => ?_
    simp only [Set.mem_ofPred_eq] at hE ⊢
    intro x hx
    by_cases hxp : x = p
    · rw [hxp]; exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem (hE (Finset.mem_erase.2 ⟨hxp, hx⟩))

end Insert

end FAmenHZ
end

section
/-! # Amenable groups act extensively amenably

For a group `G` acting on `X` and a `G`-invariant set `Y ⊆ X`, amenability of `G` gives an
invariant mean on the finite subsets of `X` witnessing `IsExtensivelyAmenableOn G X Y`.

Construction: `ν` is the invariant finitely additive probability on `G`; `U` is an ultrafilter
on `Finset X` containing `{E | E ⊆ Y}` and every cone `{E | E₀ ⊆ E}` with `E₀ ⊆ Y` finite; and
`m S = ν {g | g • E ∈ S for U-almost every E}`. -/

namespace ThompsonAmenability.Dev.Chornyi

open scoped Pointwise

variable {G X : Type*} [Group G] [MulAction G X]

/-- The action of `g` on finite subsets of `X`, exactly as `IsExtensivelyAmenableOn` writes it. -/
def act (g : G) (E : Finset X) : Finset X := E.map (MulAction.toPerm g).toEmbedding

lemma mem_act {g : G} {E : Finset X} {x : X} : x ∈ act g E ↔ g⁻¹ • x ∈ E := by
  unfold act
  rw [Finset.mem_map]
  constructor
  · rintro ⟨a, ha, rfl⟩
    simpa using ha
  · intro h
    exact ⟨g⁻¹ • x, h, by simp⟩

lemma act_mul (g h : G) (E : Finset X) : act (g * h) E = act g (act h E) := by
  ext x
  simp only [mem_act, mul_inv_rev, mul_smul]

lemma act_one (E : Finset X) : act (1 : G) E = E := by
  ext x
  simp only [mem_act, inv_one, one_smul]

/-- An ultrafilter on the finite subsets of `X` concentrated on the finite subsets of `Y` and
containing every cone over a finite subset of `Y`. -/
lemma exists_ultrafilter (Y : Set X) : ∃ U : Ultrafilter (Finset X),
    {E : Finset X | (E : Set X) ⊆ Y} ∈ U ∧
      ∀ E₀ : Finset X, (E₀ : Set X) ⊆ Y → {E : Finset X | E₀ ⊆ E} ∈ U := by
  classical
  let f : Finset Y → Finset X := fun s => s.map (Function.Embedding.subtype (· ∈ Y))
  let V : Ultrafilter (Finset Y) := Ultrafilter.of Filter.atTop
  refine ⟨V.map f, ?_, ?_⟩
  · rw [Ultrafilter.mem_map]
    have : f ⁻¹' {E : Finset X | (E : Set X) ⊆ Y} = Set.univ := by
      ext s
      simp only [Set.mem_preimage, Set.mem_ofPred_eq, Set.mem_univ, iff_true, f]
      intro x hx
      rw [Finset.mem_coe, Finset.mem_map] at hx
      obtain ⟨a, -, rfl⟩ := hx
      exact a.2
    rw [this]
    exact Filter.univ_mem
  · intro E₀ hE₀
    rw [Ultrafilter.mem_map]
    apply Ultrafilter.of_le (Filter.atTop : Filter (Finset Y))
    rw [Filter.mem_atTop_sets]
    refine ⟨E₀.subtype (· ∈ Y), fun s hs => ?_⟩
    show E₀ ⊆ f s
    intro x hx
    have hxs : (⟨x, hE₀ hx⟩ : Y) ∈ s := hs (Finset.mem_subtype.2 hx)
    exact Finset.mem_map.2 ⟨_, hxs, rfl⟩

/-- The set of `g` such that `g • E ∈ S` for `U`-almost every finite set `E`. -/
def sat (U : Ultrafilter (Finset X)) (S : Set (Finset X)) : Set G :=
  {g | act g ⁻¹' S ∈ U}

lemma sat_empty (U : Ultrafilter (Finset X)) : sat (G := G) U ∅ = ∅ := by
  ext g
  simp only [sat, Set.preimage_empty, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
  exact U.empty_notMem

lemma sat_univ (U : Ultrafilter (Finset X)) : sat (G := G) U Set.univ = Set.univ := by
  ext g
  simp only [sat, Set.preimage_univ, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
  exact Filter.univ_mem

lemma sat_union (U : Ultrafilter (Finset X)) (S T : Set (Finset X)) :
    sat (G := G) U (S ∪ T) = sat U S ∪ sat U T := by
  ext g
  simp only [sat, Set.preimage_union, Set.mem_ofPred_eq, Set.mem_union]
  exact Ultrafilter.union_mem_iff

lemma sat_disjoint (U : Ultrafilter (Finset X)) {S T : Set (Finset X)} (hST : Disjoint S T) :
    Disjoint (sat (G := G) U S) (sat U T) := by
  refine Set.disjoint_left.2 fun g hS hT => ?_
  have h := Filter.inter_mem hS hT
  rw [← Set.preimage_inter, hST.inter_eq, Set.preimage_empty] at h
  exact U.empty_notMem h

lemma sat_image (U : Ultrafilter (Finset X)) (h : G) (S : Set (Finset X)) :
    sat (G := G) U (act h '' S) = h • sat (G := G) U S := by
  ext k
  rw [Set.mem_smul_set_iff_inv_smul_mem, smul_eq_mul]
  have : act k ⁻¹' (act h '' S) = act (h⁻¹ * k) ⁻¹' S := by
    ext E
    simp only [Set.mem_preimage, Set.mem_image]
    constructor
    · rintro ⟨F, hF, hFE⟩
      have : F = act (h⁻¹ * k) E := by
        rw [act_mul, ← hFE, ← act_mul, inv_mul_cancel, act_one]
      rwa [← this]
    · intro hE
      refine ⟨act (h⁻¹ * k) E, hE, ?_⟩
      rw [← act_mul, mul_inv_cancel_left]
  simp only [sat, Set.mem_ofPred_eq, this]

/-- **Amenable groups act extensively amenably** on every invariant subset. -/
theorem isExtensivelyAmenableOn_of_isAmenable (Y : Set X)
    (hY : ∀ (g : G) (x : X), x ∈ Y → g • x ∈ Y) (hG : Garrido.IsAmenable G) :
    IsExtensivelyAmenableOn G X Y := by
  obtain ⟨ν, ⟨hν0, hνadd⟩, hν1, hνinv⟩ := hG
  obtain ⟨U, hUY, hUcone⟩ := exists_ultrafilter Y
  refine ⟨fun S => ν (sat U S), ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · simp only [sat_empty, hν0]
  · intro S T hST
    simp only [sat_union, hνadd _ _ (sat_disjoint U hST)]
  · have : sat (G := G) U {E : Finset X | (E : Set X) ⊆ Y} = Set.univ := by
      refine Set.eq_univ_of_forall fun g => ?_
      refine Filter.mem_of_superset hUY fun E hE => ?_
      intro x hx
      have := hY g _ (hE (mem_act.1 hx))
      simpa using this
    simp only [this, hν1]
  · simp only [sat_univ, hν1]
  · intro g S
    exact (congrArg ν (sat_image U g S)).trans (hνinv g _)
  · intro E₀ hE₀
    have : sat (G := G) U {E : Finset X | E₀ ⊆ E} = Set.univ := by
      refine Set.eq_univ_of_forall fun g => ?_
      have hsub : ((act g⁻¹ E₀ : Finset X) : Set X) ⊆ Y := by
        intro y hy
        have := hY g⁻¹ _ (hE₀ (mem_act.1 hy))
        simpa using this
      refine Filter.mem_of_superset (hUcone _ hsub) fun E hE => ?_
      intro x hx
      apply mem_act.2
      apply hE
      apply mem_act.2
      simpa using hx
    simp only [this, hν1]

end ThompsonAmenability.Dev.Chornyi

end

section
/-!
# Every subgroup of `H(ℤ)`: amenable iff extensively amenable on `P_ℤ`

The analogue of JMMS Theorem 6.4 ("a subgroup `H₁` of `H` is amenable iff `H₁ ↷ ℝ` is
extensively amenable") with `ℝ` replaced by the breakpoint set `P_ℤ`, stated for any group `G`
with an injective homomorphism `φ : G → H(ℤ)` (acting on `P¹` through `φ`). With `G = F` and
Stankov's embedding this gives a criterion for Thompson's group `F` through its action on a
set of quadratic irrationals (`SubF.lean`).

The criterion step is taken from the prove2.me statement
`ThompsonAmenability.isAmenable_of_isExtensivelyAmenableOn_of_cocycle` (its stub), so the
published graph carries that edge; `Criterion.lean` proves it.
-/

open OnePoint

namespace FAmenHZ

open Monod

/-- The action of `G` on `P¹` through `φ : G →* H(ℤ)`. -/
@[reducible] noncomputable def actVia {G : Type*} [Group G] (φ : G →* HZ) :
    MulAction G (OnePoint ℝ) :=
  MulAction.compHom (OnePoint ℝ) φ

theorem isAmenable_iff_isExtensivelyAmenableOn_of_injective {G : Type*} [Group G]
    (φ : G →* HZ) (hφ : Function.Injective φ) :
    letI := actVia φ
    Garrido.IsAmenable G ↔
      ThompsonAmenability.IsExtensivelyAmenableOn G (OnePoint ℝ) (P (⊥ : Subring ℝ)) := by
  let _ := actVia φ
  have hsmul : ∀ (g : G) (x : OnePoint ℝ), g • x = φ g • x := fun _ _ => rfl
  constructor
  · intro hG
    exact ThompsonAmenability.Dev.Chornyi.isExtensivelyAmenableOn_of_isAmenable _
      (fun g x hx => by rw [hsmul]; exact smul_mem_P (φ g) hx) hG
  · intro hY
    classical
    have hY' := isExtensivelyAmenableOn_insert (G := G) (P (⊥ : Subring ℝ)) ∞
      (fun g => by rw [hsmul]; exact smul_infty (φ g)) hY
    refine ThompsonAmenability.isAmenable_of_isExtensivelyAmenableOn_of_cocycle (L := ℝ) _
      (fun g => cocycle (φ g))
      (fun g => cocycle_support (φ g)) (fun g h => ?_) (fun g ψ hg => ?_) hY'
    · show cocycle (φ (g * h)) = cocycle (φ g) + Finsupp.mapDomain (fun x => φ g • x) (cocycle (φ h))
      rw [map_mul]
      exact cocycle_mul (φ g) (φ h)
    · have := cocycle_free (φ g) ψ hg
      exact hφ (by rw [this, map_one])

/-- Every subgroup `K ≤ H(ℤ)`: `K` is amenable iff `K ↷ P_ℤ` is extensively amenable. -/
theorem isAmenable_iff_isExtensivelyAmenableOn_of_le (K : Subgroup (OnePoint ℝ ≃ₜ OnePoint ℝ))
    (hK : K ≤ H (⊥ : Subring ℝ)) :
    Garrido.IsAmenable K ↔
      ThompsonAmenability.IsExtensivelyAmenableOn K (OnePoint ℝ) (P (⊥ : Subring ℝ)) :=
  isAmenable_iff_isExtensivelyAmenableOn_of_injective (Subgroup.inclusion hK)
    (Subgroup.inclusion_injective hK)

end FAmenHZ
end

section
/-! `chk_isAmenable_iff_isExtensivelyAmenableOn_P_bot_of_le_H_bot`: the prove2.me statement `ThompsonAmenability.isAmenable_iff_isExtensivelyAmenableOn_P_bot_of_le_H_bot`, copied verbatim and renamed, proved by `FAmenHZ.isAmenable_iff_isExtensivelyAmenableOn_of_le`. -/

namespace ThompsonAmenability

end ThompsonAmenability
end

section
open ThompsonAmenability
theorem solution
    (K : Subgroup (OnePoint ℝ ≃ₜ OnePoint ℝ)) (hK : K ≤ Monod.H (⊥ : Subring ℝ)) :
    Garrido.IsAmenable K ↔ IsExtensivelyAmenableOn K (OnePoint ℝ) (Monod.P (⊥ : Subring ℝ)) := by
  exact FAmenHZ.isAmenable_iff_isExtensivelyAmenableOn_of_le K hK
end
