theorem span_algebraMap_eq_pIdeal {𝒪 : Type} [CommRing 𝒪] (π : 𝒪)
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π}) (S : Type) [CommRing S] [Algebra 𝒪 S] :
    Ideal.span {algebraMap 𝒪 S π} = pIdeal r S := by
  have h := congrArg (Ideal.map (algebraMap 𝒪 S)) hunr
  rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton, map_natCast] at h
  exact h.symm

theorem bijective_of_comp_mk {S : Type} [CommRing S] {I J : Ideal S} (hIJ : I = J)
    (κ : S ⧸ I →+* S ⧸ J) (hκ : κ.comp (Ideal.Quotient.mk I) = Ideal.Quotient.mk J) : Function.Bijective κ := by
  subst hIJ
  have hid : κ = RingHom.id _ := Ideal.Quotient.ringHom_ext hκ
  subst hid
  exact Function.bijective_id

theorem exists_map_eq_and_eq_comp_act_pow_of_map_eq {R R' : Type} [CommRing R] [CommRing R']
    (κ : R →+* R') (hκ : Function.Bijective κ)
    (Xb : FormalODModule r R) (σ : Series R) (σ₁' : Series R') (k : ℕ)
    (h : σ.map κ = σ₁'.comp ((Xb.map κ).act ((r : Zp2 r) ^ k))) :
    ∃ σ₁ : Series R, σ₁.map κ = σ₁' ∧ σ = σ₁.comp (Xb.act ((r : Zp2 r) ^ k)) ∧
      ((∀ i, MvPowerSeries.constantCoeff (σ₁' i) = 0) → ∀ i, MvPowerSeries.constantCoeff (σ₁ i) = 0) := by
  set e : R ≃+* R' := RingEquiv.ofBijective κ hκ with he
  have heκ : (e : R →+* R') = κ := rfl
  have hsymm : (e.symm : R' →+* R).comp κ = RingHom.id R := by
    ext x; simp [← heκ]
  have hsymm' : κ.comp (e.symm : R' →+* R) = RingHom.id R' := by
    ext x; simp [← heκ]
  refine ⟨σ₁'.map (e.symm : R' →+* R), ?_, ?_, ?_⟩
  · rw [Series.map_map, hsymm', Series.map_ringHom_id]
  · have h2 := congrArg (Series.map (e.symm : R' →+* R)) h
    rw [Series.map_map, hsymm, Series.map_ringHom_id, FormalODModule.map_act,
      Series.map_comp _ _ _ (fun i => by rw [← FormalODModule.map_act]; exact act_cc _ _ i),
      Series.map_map, hsymm, Series.map_ringHom_id] at h2
    exact h2
  · intro h0 i
    show MvPowerSeries.constantCoeff (MvPowerSeries.map (e.symm : R' →+* R) (σ₁' i)) = 0
    rw [MvPowerSeries.constantCoeff_map, h0, map_zero]

end pullback

