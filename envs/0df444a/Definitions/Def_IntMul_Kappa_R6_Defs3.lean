section
-- Source module: Solutions.J6SegGlob
/-!
# Segmented inverse (S2): the resampling system split into blocks, coupling and tail

For a valid block structure (`BlocksOK`: blocks are wrap-free runs `[st i, st i + len i)` that
partition `[0, s)`, coupling width `w ≤ s`):
* `MxG` (the block part of `N`, entries `δ_{ik} + e_{i,k-i}`) and `MiG` (its exact block inverse
  `D T⁻¹ D⁻¹` from the q-LU) satisfy `M M⁻¹ = I` (`hinvG`, via `eEx_recentre`, `MF_mul_MinvF`);
* row sums: `‖M - I‖, ‖Δ‖ ≤ 2^{-α²θ}` (`rowM`, `rowD`), hence `‖M⁻¹‖ ≤ 8/7` when `α²θ ≥ 3`;
* every coupling column lies in the capacitance set `Jlist` (`col_mem`);
* `nsplit`: `(N x)_i = (M x)_i + (Δ x)_i + drop`, `|drop| ≤ 4 e^{-πα² w(w+1)} ‖x‖`;
* `nearN`: `‖N d‖ ≤ ρ ⇒ ‖d‖ ≤ 8ρ/7` (`‖N - I‖ ≤ 1/8`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-- Validity of a block structure for the resampling system with lengths `s < t`. -/
structure BlocksOK (s t : ℕ) (B : Blocks) : Prop where
  hs : B.s = s
  cover : ∀ i < s, B.st i ≤ i ∧ i < B.st i + B.len i ∧ B.st i + B.len i ≤ s
  cons : ∀ i < s, ∀ k, B.st i ≤ k → k < B.st i + B.len i → B.st k = B.st i ∧ B.len k = B.len i
  wf : ∀ i < s, ∀ j : ℕ, j + 1 < B.len i →
    bOf s t ((B.st i : ℤ) + j + 1) = bOf s t ((B.st i : ℤ) + j) + (t - s)
  hw : B.w ≤ s

/-- The block of position `i`. -/
def blS (B : Blocks) (i : ℕ) : Finset ℕ := Ico (B.st i) (B.st i + B.len i)

/-- Block part of `N`. -/
noncomputable def MxG (s t α : ℕ) (i k : ℕ) : ℝ := kd i k + eEx s t α i ((k : ℤ) - i)

/-- Exact block inverse `D T^{(b)}⁻¹ D⁻¹` (recentred, `σ = t/s`, `b = bOf(st)/s`). -/
noncomputable def MiG (s t α : ℕ) (B : Blocks) (i k : ℕ) : ℝ :=
  MinvF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) (B.len i) (i - B.st i) (k - B.st i)

/-- Coupling coefficients. -/
noncomputable def cfG (s t α : ℕ) (i : ℕ) (h : ℤ) : ℝ := eEx s t α i h

/-- `N x` on positions. -/
noncomputable def NxR (s t α : ℕ) (x : ℕ → ℝ) (i : ℕ) : ℝ :=
  x i + ∑' h : ℤ, eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)

section glob
variable {s t α : ℕ} {B : Blocks}

end glob

end J6Seg

end

section
-- Source module: Solutions.J6SegStage
/-!
# Segmented inverse (S2): accuracy of the global stages

With `K = (λ+1)E + 1` (`λ` ≥ every block length, `E` the table accuracy in ulps) and `Dm` ≥ every
`D_u = e^{πα²θu²}` used:
* `applyMinv_err`: `|applyMinv V / 2^P - M⁻¹ (V/2^P)| ≤ 9 Dm K (B+1)/2^P` (`|V/2^P| ≤ B`);
* `coupleI_err`: `|coupleI z / 2^P - Δ (z/2^P)| ≤ (2w+1)(1/2 + E Z)/2^P` (`|z/2^P| ≤ Z` on `J`);
* `capI_row`, `capI_apply`: the computed capacitance `C = I + (M⁻¹Δ)|_J` has row deviation
  `≤ 1/7 + λ(2w+1)δ` and `|C z - (z + M⁻¹ Δ z)| ≤ λ(2w+1) δ Z` with `δ = 15 Dm K / 2^P`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-- The hypotheses on the tables shared by all stages. -/
structure TabOK (P s t α : ℕ) (B : Blocks) (T : Tables) (E Dm : ℝ) : Prop where
  blk : ∀ i < s, BlkTab P (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) T (B.st i) (B.len i) E
  cpl : ∀ i < s, ∀ h ∈ Hset B i, |(T.cpl i h : ℝ) - 2 ^ P * eEx s t α i h| ≤ E
  dm : ∀ i < s, ∀ u < B.len i, ddR (α : ℝ) ((t : ℝ) / s) u ≤ Dm

section stage
variable {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}

end stage

end J6Seg

end

section
-- Source module: Solutions.J6SegMain
/-!
# Segmented inverse (S2): the main error theorem (report L10)

`segInv_err`: for the resampling system `N = I + E` of lengths `s < t` with Gaussian parameter
`α ≥ 2` and `α²θ = α²(t-s)/s ≥ 3`, any valid block structure `B` (wrap-free runs of length
`≤ λ` partitioning `[0, s)`, coupling width `w ≤ s`), tables accurate to `E` ulps
(`TabOK`, `D_u ≤ Dm` on every block), a fixed-point input `U` (`|U/2^P| ≤ Bu`) approximating `v`
to `ε_in`, and the exact solution `w` of `N w = v`, the segmented inverse satisfies

`|segInv U i / 2^P - w_i| ≤ 60 G / 2^P + 12 e^{-πα² w(w+1)} (Bu+1) + (8/7) ε_in`

with `G = Dm ((λ+1)E+1) (Bu+1) (λ+1) (2w+1) (|J|+1)²` (`|J|` = number of near-boundary
positions), as soon as `1000 G ≤ 2^P`. In bits: precision
`P ≥ Q + log₂ Dm + 2 log₂(|J|+1) + log₂((λ+1)²(2w+1)) + log₂((λ+1)E+1) + log₂(Bu+1) + 16`
gives error `≤ 2^{-Q}` up to the truncation and input terms.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-- The precision budget `G = Dm K (Bu+1) (λ+1) (2w+1) (|J|+1)²`. -/
noncomputable def segG (B : Blocks) (lam : ℕ) (E Dm Bu : ℝ) : ℝ :=
  Dm * (((lam : ℝ) + 1) * E + 1) * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1) *
    (((Jlist B).length : ℝ) + 1) ^ 2

section budget
variable {Dm K β L Wd Q e : ℝ}

end budget

end J6Seg

end


