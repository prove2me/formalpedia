lemma killCompl_X_sum {ι σ : Type} [Fintype ι] (q : ι → σ) (hq : Function.Injective q) (v : σ) :
    killCompl (R := ℂ) hq (X v) = ∑ p,if q p = v then X p else 0 := by
  classical
  by_cases hv : ∃ p,q p = v
  · obtain ⟨p,rfl⟩ := hv
    have hx := killCompl_rename_app (R := ℂ) hq (X p)
    rw [rename_X] at hx
    rw [hx]
    simp [hq.eq_iff]
  · have hv' : v ∉ Set.range q := hv
    rw [killCompl,aeval_X,dif_neg hv']
    symm
    apply Finset.sum_eq_zero
    intro p _
    rw [if_neg (fun h => hv ⟨p,h⟩)]

lemma quadratic_coeff_ext {n : ℕ} {u v : CoeffVar (fun _ : Fin n => 2)}
    (hr : u.1 = v.1) (he : u.2.1 = v.2.1) : u = v := by
  cases u with | mk i a =>
    cases v with | mk j b =>
      dsimp only at hr he
      subst j
      exact congrArg (Sigma.mk i) (Subtype.ext he)

lemma partial_coeff {ι : Type} [Fintype ι] [DecidableEq ι] {n : ℕ}
    (e : ι ↪ Fin n) (f g : ι → ι)
    (q : ι → CoeffVar (fun _ : Fin n => 2)) (hq : Function.Injective q)
    (hr : ∀ p,(q p).1 = e p)
    (he : ∀ p,(q p).2.1 = Finsupp.single (e (f p)) 1 + Finsupp.single (e (g p)) 1)
    (v : CoeffVar (fun _ : Fin n => 2)) :
    (partialForm e f g v.1).coeff v.2.1 =
      C (if v.2.1 = Finsupp.single v.1 2 then (1 : ℂ) else 0) - killCompl hq (X v) := by
  classical
  have hterm (p : ι) :
      (C (if e p = v.1 then X p else 0) * X (e (f p)) * X (e (g p)) :
        MvPolynomial (Fin n) (MvPolynomial ι ℂ)) =
      monomial (q p).2.1 (if e p = v.1 then X p else 0) := by
    rw [he]
    simp only [X,C_mul_monomial,monomial_mul,mul_one]
  rw [partialForm,coeff_sub,coeff_sum,killCompl_X_sum q hq]
  congr 1
  · simp only [X_pow_eq_monomial,coeff_monomial,apply_ite,map_one,map_zero]
    split_ifs <;> simp_all
  · apply Finset.sum_congr rfl
    intro p _
    rw [hterm,coeff_monomial]
    by_cases hp : q p = v
    · have hr' : e p = v.1 := by rw [← hr,hp]
      simp [hp,hr']
    · have hbad : ¬ ((q p).2.1 = v.2.1 ∧ e p = v.1) := by
        rintro ⟨he',hr'⟩
        exact hp (quadratic_coeff_ext ((hr p).trans hr') he')
      split_ifs <;> simp_all

lemma partial_specialization {ι : Type} [Fintype ι] [DecidableEq ι] {n : ℕ}
    (𝓡 : ResultantSystem) (e : ι ↪ Fin n) (f g : ι → ι)
    (q : ι → CoeffVar (fun _ : Fin n => 2)) (hq : Function.Injective q)
    (hr : ∀ p,(q p).1 = e p)
    (he : ∀ p,(q p).2.1 = Finsupp.single (e (f p)) 1 + Finsupp.single (e (g p)) 1) :
    partialResultant 𝓡 e f g =
      killCompl hq (map (Int.castRingHom ℂ) (ResultantFlow.shiftedResultant 𝓡 n)) := by
  classical
  unfold partialResultant ResultantFlow.shiftedResultant
  have hmap (h : CoeffVar (fun _ : Fin n => 2) → MvPolynomial (CoeffVar (fun _ : Fin n => 2)) ℤ) :
      map (Int.castRingHom ℂ) (aeval h (𝓡.res (fun _ : Fin n => 2))) =
      aeval (fun v => map (Int.castRingHom ℂ) (h v))
        (map (Int.castRingHom ℂ) (𝓡.res (fun _ : Fin n => 2))) :=
    map_bind₁ (Int.castRingHom ℂ) h (𝓡.res (fun _ : Fin n => 2))
  rw [hmap,comp_aeval_apply]
  congr 2
  funext v
  rw [partial_coeff e f g q hq hr he v]
  simp [apply_ite]

lemma fullExponent_map {ι σ : Type} [Fintype ι] [DecidableEq ι] (q : ι → σ) :
    (fullExponent ι).mapDomain q = ∑ p,Finsupp.single (q p) 1 := by
  classical
  rw [Finsupp.mapDomain]
  rw [Finsupp.sum_fintype _ _ (by intros; simp)]
  simp only [fullExponent_apply]

theorem contribution_negative {m n : ℕ} [NeZero m]
    (𝓡 : ResultantSystem) (hn : 1 ≤ n)
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hμ : (ResultantFlow.shiftedResultant 𝓡 n).coeff μ ≠ 0)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν) :
    (ResultantFlow.shiftedResultant 𝓡 n).coeff μ < 0 := by
  classical
  have hb := ResultantFlow.shifted_balance 𝓡 hn μ hμ
  obtain ⟨q,hr,hq⟩ := one_coefficient_per_equation cls ν μ hb hm
  obtain ⟨f,g,he⟩ := contribution_pairs cls ν μ hb hm q hr hq
  obtain ⟨hbal,hconn⟩ := contribution_orientation cls ν μ hb hm q hr hq f g he
  have hinj : Function.Injective (fun p => (ν p).val) := by
    intro p r h
    have hh := congrArg cls h
    simpa only [(ν p).property,(ν r).property] using hh
  let e : (ZMod m × ZMod m) ↪ Fin n := ⟨fun p => (ν p).val,hinj⟩
  have hqi : Function.Injective q := by
    intro p r h
    apply hinj
    simpa only [hr] using congrArg (fun v : CoeffVar (fun _ : Fin n => 2) => v.1) h
  obtain ⟨c,hc,hc'⟩ := partial_negative_coefficient 𝓡 e f g hbal hconn
  rw [partial_specialization 𝓡 e f g q hqi hr he,coeff_killCompl,
    fullExponent_map,← hq,coeff_map] at hc'
  have hz : (ResultantFlow.shiftedResultant 𝓡 n).coeff μ = -(c : ℤ) := by
    simp only [Int.coe_castRingHom] at hc'
    exact_mod_cast hc'
  rw [hz]
  omega

end ContributionSigns

-- Helpers from Solutions/SymmetricShift.lean
set_option maxHeartbeats 400000
open MvPolynomial ResultantVNP Finset AssignmentContributions
open scoped Classical

namespace SymmetricShift

def tripleMap (n : ℕ) (t : Fin n × Fin n × Fin n) : Sym (Fin n) 3 :=
  t.1 ::ₛ t.2.1 ::ₛ t.2.2 ::ₛ Sym.nil

noncomputable def symForm (n : ℕ) (i : Fin n) :
    MvPolynomial (Fin n) (MvPolynomial (Sym (Fin n) 3) ℤ) :=
  ∑ j : Fin n, ∑ k : Fin n,C (X (tripleMap n (i,j,k))) * X j * X k

noncomputable def symCoeff (n : ℕ) (v : CoeffVar (fun _ : Fin n => 2)) :
    MvPolynomial (Sym (Fin n) 3) ℤ := (symForm n v.1).coeff v.2.1

lemma symForm_map (n : ℕ) (i : Fin n) :
    map (rename (tripleMap n)).toRingHom (tensorForm n i) = symForm n i := by
  simp [tensorForm,symForm,tripleMap,map_sum,map_mul]

lemma symDet_aeval (𝓡 : ResultantSystem) (n : ℕ) :
    symTensorDet 𝓡 n = aeval (symCoeff n) (𝓡.res (fun _ : Fin n => 2)) := by
  change rename (tripleMap n)
    (aeval (fun v : CoeffVar (fun _ : Fin n => 2) => (tensorForm n v.1).coeff v.2.1)
      (𝓡.res (fun _ : Fin n => 2))) = _
  rw [comp_aeval_apply]
  congr 2
  funext v
  change (rename (tripleMap n)) ((tensorForm n v.1).coeff v.2.1) = (symForm n v.1).coeff v.2.1
  have h := coeff_map (rename (tripleMap n)).toRingHom (tensorForm n v.1) v.2.1
  rw [symForm_map] at h
  exact h.symm

lemma symCoeff_formula (n : ℕ) (v : CoeffVar (fun _ : Fin n => 2)) :
    symCoeff n v = ∑ j : Fin n, ∑ k : Fin n,
      if Finsupp.single j 1 + Finsupp.single k 1 = v.2.1 then
        X (tripleMap n (v.1,j,k)) else 0 := by
  simp only [symCoeff,symForm,coeff_sum]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro k _
  rw [mul_assoc,coeff_C_mul]
  have hx : (X j * X k : MvPolynomial (Fin n) (MvPolynomial (Sym (Fin n) 3) ℤ)).coeff v.2.1 =
      if Finsupp.single j 1 + Finsupp.single k 1 = v.2.1 then 1 else 0 := by
    simp only [X,monomial_mul,one_mul,coeff_monomial]
  rw [hx]
  split_ifs <;> simp

noncomputable def multiplicity {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) : ℤ :=
  ∑ j : Fin n, ∑ k : Fin n,if Finsupp.single j 1 + Finsupp.single k 1 = v.2.1 then 1 else 0

lemma multiplicity_pos {n : ℕ} (v : CoeffVar (fun _ : Fin n => 2)) : 0 < multiplicity v := by
  obtain ⟨a,b,hab⟩ := quadratic_pair_exists v
  apply Finset.sum_pos'
  · intro j _
    apply Finset.sum_nonneg
    intro k _
    split_ifs <;> norm_num
  · refine ⟨a,Finset.mem_univ _,?_⟩
    apply Finset.sum_pos'
    · intro k _
      split_ifs <;> norm_num
    · exact ⟨b,Finset.mem_univ _,by rw [if_pos hab.symm]; norm_num⟩

lemma symCoeff_scaled (n : ℕ) (v : CoeffVar (fun _ : Fin n => 2)) :
    symCoeff n v = C (multiplicity v) * X (coefficientTriple v) := by
  rw [symCoeff_formula,multiplicity,map_sum,Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  rw [map_sum,Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro k _
  split_ifs with he
  · rw [coefficientTriple_pair v j k he.symm]
    simp [tripleMap]
  · simp

lemma triple_diagonal {n : ℕ} (i j k : Fin n) :
    (∃ a,tripleMap n (i,j,k) = Sym.replicate 3 a) ↔ j = i ∧ k = i := by
  constructor
  · rintro ⟨a,ha⟩
    have hall := Sym.eq_replicate_iff.mp ha
    have hi := hall i (by simp [tripleMap])
    have hj := hall j (by simp [tripleMap])
    have hk := hall k (by simp [tripleMap])
    exact ⟨hj.trans hi.symm,hk.trans hi.symm⟩
  · rintro ⟨rfl,rfl⟩
    exact ⟨_,rfl⟩

noncomputable def delta {n : ℕ} (T : Sym (Fin n) 3) : ℤ :=
  if ∃ i,T = Sym.replicate 3 i then 1 else 0

lemma symCoeff_delta (n : ℕ) (v : CoeffVar (fun _ : Fin n => 2)) :
    aeval (fun T => C (delta T)) (symCoeff n v) =
      (C (if v.2.1 = Finsupp.single v.1 2 then (1 : ℤ) else 0) : MvPolynomial (Sym (Fin n) 3) ℤ) := by
  rw [symCoeff_formula]
  conv_lhs => simp only [map_sum,apply_ite,aeval_X,map_zero,delta,triple_diagonal]
  have hterm (j k : Fin n) :
      (if Finsupp.single j 1 + Finsupp.single k 1 = v.2.1 then
        C (if j = v.1 ∧ k = v.1 then (1 : ℤ) else 0) else 0 : MvPolynomial (Sym (Fin n) 3) ℤ) =
      if j = v.1 then if k = v.1 then
        C (if v.2.1 = Finsupp.single v.1 2 then 1 else 0) else 0 else 0 := by
    by_cases hj : j = v.1 <;> by_cases hk : k = v.1
    · subst j; subst k
      simp [← Finsupp.single_add,eq_comm]
    · simp [hj,hk]
    · simp [hj,hk]
    · simp [hj,hk]
  calc
    _ = ∑ j : Fin n, ∑ k : Fin n,if j = v.1 then if k = v.1 then
        (C (if v.2.1 = Finsupp.single v.1 2 then (1 : ℤ) else 0) :
          MvPolynomial (Sym (Fin n) 3) ℤ) else 0 else 0 := by
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro k _
      simpa only [apply_ite,map_one,map_zero] using hterm j k
    _ = _ := by simp

lemma symCoeff_shift (n : ℕ) (v : CoeffVar (fun _ : Fin n => 2)) :
    aeval (fun T => C (delta T) - X T) (symCoeff n v) =
      C (if v.2.1 = Finsupp.single v.1 2 then (1 : ℤ) else 0) -
        C (multiplicity v) * X (coefficientTriple v) := by
  rw [← symCoeff_scaled,← symCoeff_delta]
  simp only [symCoeff_formula,map_sum,apply_ite,aeval_X,map_zero]
  simp only [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro k _
  split_ifs <;> simp

theorem shifted_symmetric_resultant (𝓡 : ResultantSystem) (n : ℕ) :
    aeval (fun T => C (delta T) - X T) (symTensorDet 𝓡 n) =
      aeval (fun v => C (multiplicity v) * X (coefficientTriple v))
        (ResultantFlow.shiftedResultant 𝓡 n) := by
  rw [symDet_aeval,ResultantFlow.shiftedResultant,comp_aeval_apply,comp_aeval_apply]
  congr 2
  funext v
  rw [symCoeff_shift]
  simp

end SymmetricShift

-- Helpers from Solutions/AffineCoefficient.lean
open MvPolynomial ResultantVNP Finset

namespace AffineCoefficient

noncomputable def affine {σ : Type} (δ : σ → ℤ) (v : σ) :
    Polynomial (MvPolynomial σ ℤ) :=
  Polynomial.C (C (δ v)) + Polynomial.X * Polynomial.C (X v)

theorem coefficient_homogeneous {σ : Type} (δ : σ → ℤ) (p : MvPolynomial σ ℤ) :
    ∀ s, ((aeval (affine δ) p).coeff s).IsHomogeneous s := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    intro s
    have hc : aeval (affine δ) (C a) = (Polynomial.C (C a) : Polynomial (MvPolynomial σ ℤ)) := by
      simp
    rw [hc]
    cases s with
    | zero => simpa using isHomogeneous_C σ a
    | succ s =>
      rw [Polynomial.coeff_C]
      simp only [Nat.succ_ne_zero, ite_false]
      exact isHomogeneous_zero σ ℤ (s + 1)
  | add p q hp hq =>
    intro s
    rw [map_add, Polynomial.coeff_add]
    exact (hp s).add (hq s)
  | mul_X p v hp =>
    intro s
    rw [map_mul, aeval_X]
    change ((aeval (affine δ) p * (Polynomial.C (C (δ v)) +
      Polynomial.X * Polynomial.C (X v))).coeff s).IsHomogeneous s
    rw [mul_add, Polynomial.coeff_add, ← mul_assoc, Polynomial.coeff_mul_C,
      Polynomial.coeff_mul_C]
    apply IsHomogeneous.add
    · simpa only [add_zero] using (hp s).mul (isHomogeneous_C σ (δ v))
    · cases s with
      | zero => simp only [Polynomial.coeff_mul_X_zero, zero_mul]; exact isHomogeneous_zero σ ℤ 0
      | succ s =>
        rw [Polynomial.coeff_mul_X]
        exact (hp s).mul (isHomogeneous_X ℤ v)

theorem coefficient_at_minus_one {σ : Type} (δ : σ → ℤ) (P : MvPolynomial σ ℤ)
    (μ : σ →₀ ℕ) (s : ℕ) (hs : μ.degree = s) :
    (aeval (fun v => C (δ v) - X v) P).coeff μ =
      ((aeval (affine δ) P).coeff s).coeff μ * (-1 : ℤ) ^ s := by
  classical
  let Q := aeval (affine δ) P
  have hQ (k : ℕ) : (Q.coeff k).IsHomogeneous k := coefficient_homogeneous δ P k
  have heval : Q.eval (-1) = aeval (fun v => C (δ v) - X v) P := by
    change ((Polynomial.aeval (-1 : MvPolynomial σ ℤ)).restrictScalars ℤ)
      (aeval (affine δ) P) = _
    rw [comp_aeval_apply]
    congr 2
    funext v
    simp [affine,sub_eq_add_neg]
  rw [← heval,Polynomial.eval_eq_sum,Polynomial.sum_def,coeff_sum]
  have hcoeff (k : ℕ) : (Q.coeff k * (-1 : MvPolynomial σ ℤ) ^ k).coeff μ =
      (Q.coeff k).coeff μ * (-1 : ℤ) ^ k := by
    rw [show (-1 : MvPolynomial σ ℤ) ^ k = C ((-1 : ℤ) ^ k) by simp]
    rw [mul_comm,coeff_C_mul,mul_comm]
  simp_rw [hcoeff]
  rw [Finset.sum_eq_single s]
  · intro k _ hk
    rw [(hQ k).coeff_eq_zero (by rw [hs]; exact Ne.symm hk),zero_mul]
  · intro h
    rw [Polynomial.notMem_support_iff.mp h,coeff_zero,zero_mul]

lemma assignment_degree {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) :
    (assignMonomial cls ν).degree = m ^ 2 := by
  classical
  rw [assignMonomial,map_sum]
  simp only [Finsupp.degree_single,Finset.sum_const,smul_eq_mul,mul_one,
    Finset.card_univ,Fintype.card_prod,ZMod.card]
  exact (pow_two m).symm

theorem assignment_characteristic_coefficient {m n : ℕ} [NeZero m]
    (𝓡 : ResultantSystem) (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) :
    (aeval (fun T : Sym (Fin n) 3 =>
      C (if ∃ i,T = Sym.replicate 3 i then (1 : ℤ) else 0) - X T) (symTensorDet 𝓡 n)).coeff
        (assignMonomial cls ν) =
      (charCoeff 𝓡 n (m ^ 2)).coeff (assignMonomial cls ν) * (-1 : ℤ) ^ (m ^ 2) := by
  classical
  have h := coefficient_at_minus_one (fun T : Sym (Fin n) 3 =>
    if ∃ i,T = Sym.replicate 3 i then (1 : ℤ) else 0) (symTensorDet 𝓡 n)
      (assignMonomial cls ν) (m ^ 2) (assignment_degree cls ν)
  have hchar : charCoeff 𝓡 n (m ^ 2) =
      (aeval (affine (fun T : Sym (Fin n) 3 =>
        if ∃ i,T = Sym.replicate 3 i then (1 : ℤ) else 0)) (symTensorDet 𝓡 n)).coeff (m ^ 2) := by
    unfold charCoeff
    congr 2
    congr 1
    funext T
    by_cases ht : ∃ i,T = Sym.replicate 3 i <;> simp [affine,ht]
  rw [hchar]
  exact h

end AffineCoefficient

-- Helpers from Solutions/AssignmentNonvanishing.lean
set_option maxHeartbeats 400000
open MvPolynomial ResultantVNP Finset AssignmentContributions GridOrientations
open BinomialResultants PartialBinomialResultants ContributionSigns SymmetricShift

namespace AssignmentNonvanishing

lemma grid_balanced {m : ℕ} [NeZero m] (v : ZMod m × ZMod m) :
    (Finset.univ.filter (fun u => gridRight u = v)).card +
      (Finset.univ.filter (fun u => gridDown u = v)).card = 2 := by
  classical
  have hr : (Finset.univ.filter (fun u => gridRight u = v)).card = 1 := by
    rw [Finset.card_eq_sum_ones,Finset.sum_filter]
    exact (Equiv.sum_comp ((Equiv.addRight (1 : ZMod m)).prodCongr (Equiv.refl (ZMod m)))
      (fun u => if u = v then (1 : ℕ) else 0)).trans (by simp)
  have hd : (Finset.univ.filter (fun u => gridDown u = v)).card = 1 := by
    rw [Finset.card_eq_sum_ones,Finset.sum_filter]
    exact (Equiv.sum_comp ((Equiv.refl (ZMod m)).prodCongr (Equiv.addRight (1 : ZMod m)))
      (fun u => if u = v then (1 : ℕ) else 0)).trans (by simp)
  omega

theorem anchor_contribution {m n : ℕ} [NeZero m]
    (𝓡 : ResultantSystem) (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) :
    ∃ μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ,
      μ ∈ (ResultantFlow.shiftedResultant 𝓡 n).support ∧
        μ.mapDomain coefficientTriple = assignMonomial cls ν := by
  classical
  have hinj : Function.Injective (fun p => (ν p).val) := by
    intro p r h
    have hh := congrArg cls h
    simpa only [(ν p).property,(ν r).property] using hh
  let e : (ZMod m × ZMod m) ↪ Fin n := ⟨fun p => (ν p).val,hinj⟩
  let q : ZMod m × ZMod m → CoeffVar (fun _ : Fin n => 2) := fun p =>
    ⟨e p,⟨Finsupp.single (e (gridRight p)) 1 + Finsupp.single (e (gridDown p)) 1,by
      simp only [Finsupp.add_apply,Finset.sum_add_distrib]
      simp⟩⟩
  have hr (p) : (q p).1 = e p := rfl
  have he (p) : (q p).2.1 = Finsupp.single (e (gridRight p)) 1 + Finsupp.single (e (gridDown p)) 1 := rfl
  have hqi : Function.Injective q := by
    intro p r h
    apply hinj
    exact congrArg (fun v : CoeffVar (fun _ : Fin n => 2) => v.1) h
  obtain ⟨c,hc,hc'⟩ := partial_negative_coefficient 𝓡 e gridRight gridDown grid_balanced
    (orientation_connected gridRight gridDown (fun p => ⟨p,rfl⟩))
  rw [partial_specialization 𝓡 e gridRight gridDown q hqi hr he,coeff_killCompl,
    fullExponent_map,coeff_map] at hc'
  let μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ := ∑ p,Finsupp.single (q p) 1
  have hcoef : (ResultantFlow.shiftedResultant 𝓡 n).coeff μ = -(c : ℤ) := by
    simp only [Int.coe_castRingHom] at hc'
    exact_mod_cast hc'
  refine ⟨μ,?_,?_⟩
  · rw [MvPolynomial.mem_support_iff,hcoef]
    omega
  · rw [show μ = ∑ p,Finsupp.single (q p) 1 from rfl,Finsupp.mapDomain_finsetSum,assignMonomial]
    apply Finset.sum_congr rfl
    intro p _
    rw [Finsupp.mapDomain_single,coefficientTriple_pair (q p) _ _ (he p)]
    rfl

theorem assignment_coefficient_nonzero {m n : ℕ} [NeZero m]
    (𝓡 : ResultantSystem) (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p}) :
    (charCoeff 𝓡 n (m ^ 2)).coeff (assignMonomial cls ν) ≠ 0 := by
  have hn : 1 ≤ n := by have := (ν (0,0)).val.isLt; omega
  have hneg : (aeval (fun T => C (delta T) - X T) (symTensorDet 𝓡 n)).coeff
      (assignMonomial cls ν) < 0 := by
    rw [shifted_symmetric_resultant]
    apply PositiveSpecialization.negative_coefficient coefficientTriple multiplicity multiplicity_pos
    · intro μ hμ hm
      exact contribution_negative 𝓡 hn cls ν μ (MvPolynomial.mem_support_iff.mp hμ) hm
    · exact anchor_contribution 𝓡 cls ν
  change (aeval (fun T : Sym (Fin n) 3 =>
    C (if ∃ i,T = Sym.replicate 3 i then (1 : ℤ) else 0) - X T) (symTensorDet 𝓡 n)).coeff
      (assignMonomial cls ν) < 0 at hneg
  rw [AffineCoefficient.assignment_characteristic_coefficient] at hneg
  intro hz
  rw [hz,zero_mul] at hneg
  exact (lt_irrefl 0) hneg

end AssignmentNonvanishing

-- Helpers from Solutions/AssignmentCoefficients.lean
namespace AssignmentCoefficients
open ResultantVNP

theorem choice_injective {m : ℕ} {ι : Type} (cls : ι → ZMod m × ZMod m)
    (ν : ∀ p,{a // cls a = p}) : Function.Injective (fun p => (ν p).val) := by
  intro p q h
  have hh := congrArg cls h
  simpa only [(ν p).property,(ν q).property] using hh

theorem monomial_transport {m n : ℕ} [NeZero m]
    (cls cls' : Fin n → ZMod m × ZMod m)
    (ν : ∀ p,{a // cls a = p}) (η : ∀ p,{a // cls' a = p})
    (π : Equiv.Perm (Fin n)) (hπ : ∀ p,π (ν p).val = (η p).val) :
    (assignMonomial cls ν).mapDomain (Sym.map π) = assignMonomial cls' η := by
  classical
  unfold assignMonomial
  rw [Finsupp.mapDomain_finset_sum]
  apply Finset.sum_congr rfl
  intro p _
  rw [Finsupp.mapDomain_single]
  congr 1
  simp only [assignTriple,Sym.map_cons,hπ,
    show Sym.map π (Sym.nil : Sym (Fin n) 0) = Sym.nil from Subsingleton.elim _ _]

theorem coefficient_eq (𝓡 : ResultantSystem) (m n : ℕ) [NeZero m]
    (cls cls' : Fin n → ZMod m × ZMod m)
    (ν : ∀ p,{a // cls a = p}) (η : ∀ p,{a // cls' a = p}) :
    (charCoeff 𝓡 n (m^2)).coeff (assignMonomial cls ν) =
      (charCoeff 𝓡 n (m^2)).coeff (assignMonomial cls' η) := by
  obtain ⟨π,hπ⟩ := Equiv.Perm.exists_extending_pair
    (fun p => (ν p).val) (fun p => (η p).val)
    (choice_injective cls ν) (choice_injective cls' η)
  have h := MvPolynomial.coeff_rename_mapDomain (Sym.map π)
    (Sym.map_injective π.injective 3) (charCoeff 𝓡 n (m^2)) (assignMonomial cls ν)
  rw [ResultantVNP.charCoeff_perm_invariant,monomial_transport cls cls' ν η π hπ] at h
  exact h.symm

theorem exists_common (𝓡 : ResultantSystem) (m n : ℕ) [NeZero m] :
    ∃ κ : ℤ, ∀ cls : Fin n → ZMod m × ZMod m,
      ∀ ν : (∀ p,{a // cls a = p}),
        (charCoeff 𝓡 n (m^2)).coeff (assignMonomial cls ν) = κ := by
  classical
  by_cases h : ∃ cls : Fin n → ZMod m × ZMod m, Nonempty (∀ p,{a // cls a = p})
  · obtain ⟨cls,⟨ν⟩⟩ := h
    refine ⟨(charCoeff 𝓡 n (m^2)).coeff (assignMonomial cls ν),?_⟩
    intro cls' η
    exact coefficient_eq 𝓡 m n cls' cls η ν
  · refine ⟨1,?_⟩
    intro cls ν
    exact (h ⟨cls,⟨ν⟩⟩).elim

end AssignmentCoefficients

theorem solution (𝓡 : ResultantVNP.ResultantSystem) (m : ℕ) [NeZero m] (hm : 3 ≤ m) (n : ℕ) :
    ∃ κ : ℤ, κ ≠ 0 ∧ ∀ cls : Fin n → ZMod m × ZMod m, Function.Surjective cls →
      ∀ ν : (∀ p : ZMod m × ZMod m, {α // cls α = p}),
        (ResultantVNP.charCoeff 𝓡 n (m ^ 2)).coeff (ResultantVNP.assignMonomial cls ν) = κ := by
  classical
  by_cases h : ∃ cls : Fin n → ZMod m × ZMod m, Nonempty (∀ p,{a // cls a = p})
  · obtain ⟨cls,⟨ν⟩⟩ := h
    refine ⟨(ResultantVNP.charCoeff 𝓡 n (m ^ 2)).coeff (ResultantVNP.assignMonomial cls ν),
      AssignmentNonvanishing.assignment_coefficient_nonzero 𝓡 cls ν,?_⟩
    intro cls' _ η
    exact AssignmentCoefficients.coefficient_eq 𝓡 m n cls' cls η ν
  · refine ⟨1,one_ne_zero,?_⟩
    intro cls _ ν
    exact (h ⟨cls,⟨ν⟩⟩).elim

#print axioms solution
