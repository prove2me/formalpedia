theorem contDiffOn_FfrF (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (A B : Fin 4) : ContDiffOn ℝ ∞ (FfrF F E A B) U := by
  have e : FfrF F E A B = fun z => ∑ μ, ∑ ν, (F μ ν z : ℂ) * E A μ z * E B ν z := by
    funext z; simp only [FfrF, ccontr, fvec]
  rw [e]
  exact ContDiffOn.sum fun μ _ => ContDiffOn.sum fun ν _ =>
    ((contDiffOn_ofReal (hFs μ ν)).mul (hF.smooth_E A μ)).mul (hF.smooth_E B ν)

/-! ### The 3-form `H = dF` in the frame -/

/-! ### The vector `J = ∇·F` in the frame -/

theorem raise2_frame (hN : NullFrameData g gi E Θ U) (F : TwoForm 4) {x : Pt 4} (hx : x ∈ U) (a b : Fin 4) :
    (raise2 gi F a b x : ℂ) = ∑ P, ∑ R, E P a x * E R b x * Fup F E P R x := by
  have hgi := hN.cmat_gi_eq hx
  have hgiT : (cmat gi x)ᵀ = frMat E x * etaNull * (frMat E x)ᵀ := by
    rw [hgi, Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, etaNull_transpose,
      Matrix.mul_assoc]
  have h1 : (raise2 gi F a b x : ℂ) = (cmat gi x * cmat F x * (cmat gi x)ᵀ) a b := by
    simp only [raise2, cmat, metricMatrix, Matrix.map_apply, Matrix.of_apply, Matrix.mul_apply,
      Matrix.transpose_apply]
    push_cast
    simp only [Fin.sum_univ_four]
    ring
  have h2 : cmat gi x * cmat F x * (cmat gi x)ᵀ
      = frMat E x * (etaNull * NullFrameData.FfrM F E x * etaNull) * (frMat E x)ᵀ := by
    rw [hgiT, hgi]; simp only [NullFrameData.FfrM, Matrix.mul_assoc]
  rw [h1, h2]
  simp only [Matrix.mul_apply, Matrix.transpose_apply, frMat, Matrix.of_apply, NullFrameData.FfrM_apply, Fup,
    Fin.sum_univ_four]
  rw [etaNull_symm 0 1, etaNull_symm 0 2, etaNull_symm 0 3, etaNull_symm 1 2, etaNull_symm 1 3,
    etaNull_symm 2 3]
  ring

theorem omega_trace (hF : FrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (P : Fin 4) :
    ∑ K, Omega g gi E Θ K x K P
      = ∑ ν, cpdC ν (E P ν) x + ∑ ν, ∑ l, (christoffel g gi ν ν l x : ℂ) * E P l x := by
  have c := hF.compl_apply hx
  simp only [Omega_apply, fdir, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  · rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [Finset.sum_comm]
    have h : ∀ μ, ∑ K, Θ K ν x * (E K μ x * cpdC μ (E P ν) x)
        = (1 : Matrix (Fin 4) (Fin 4) ℂ) μ ν * cpdC μ (E P ν) x := by
      intro μ; rw [← c μ ν, Finset.sum_mul]; exact Finset.sum_congr rfl fun K _ => by ring
    simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  · rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [Finset.sum_comm]
    have h : ∀ μ, ∑ K, ∑ l, Θ K ν x * ((christoffel g gi ν μ l x : ℂ) * E K μ x * E P l x)
        = (1 : Matrix (Fin 4) (Fin 4) ℂ) μ ν * ∑ l, (christoffel g gi ν μ l x : ℂ) * E P l x := by
      intro μ
      rw [← c μ ν, Finset.sum_mul]
      exact Finset.sum_congr rfl fun K _ => by rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by ring
    simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem omega_expand (hF : FrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (P R b : Fin 4) :
    ∑ K, Omega g gi E Θ P x K R * E K b x
      = fdir E P (E R b) x + ∑ μ, ∑ l, (christoffel g gi b μ l x : ℂ) * E P μ x * E R l x := by
  have h := hF.sum_coeff hx (fun ν => fdir E P (E R ν) x + ∑ μ, ∑ l, (christoffel g gi ν μ l x : ℂ) * E P μ x * E R l x) b
  rw [← h]
  exact Finset.sum_congr rfl fun K _ => by rw [Omega_apply]

theorem contDiffOn_Fup (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (P R : Fin 4) : ContDiffOn ℝ ∞ (Fup F E P R) U :=
  ContDiffOn.sum fun S _ => ContDiffOn.sum fun T _ => contDiffOn_const.mul (contDiffOn_FfrF hF hFs S T)

