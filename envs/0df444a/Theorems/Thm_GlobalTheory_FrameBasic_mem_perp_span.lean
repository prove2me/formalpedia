theorem GlobalTheory.FrameBasic.mem_perp_span (L : LocE F E) {n : ℕ} {H : Matrix (Fin n) (Fin n) E} (h : IsHerm L H)
    {ι : Type} (g : ι → Fin n → E) (x : Fin n → E) :
    x ∈ perp L H (Submodule.span E (Set.range g)) ↔ ∀ j, hf L H x (g j) = 0 := by sorry
