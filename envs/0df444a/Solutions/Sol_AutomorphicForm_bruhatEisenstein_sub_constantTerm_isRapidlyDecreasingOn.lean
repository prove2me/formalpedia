variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

private def psiWC (χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ) (t : ℝ) : ℂ :=
  ((χ₁ (complexIdeleAt hw (expCUnit (-t))) : ℂˣ) : ℂ)
    * ((χ₂ (complexIdeleAt hw (expCUnit t)) : ℂˣ) : ℂ)

variable {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}

private theorem isOneParamGroup_psiWC
    (hc₁ : Continuous fun r : ℂˣ => ((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℂˣ => ((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ)) :
    IsOneParamGroup (psiWC hw χ₁ χ₂) where
  map_zero := by simp [psiWC, expCUnit_zero]
  map_add s t := by
    simp only [psiWC, neg_add, expCUnit_add, map_mul, Units.val_mul]
    ring
  continuous := (hc₁.comp (continuous_expCUnit.comp continuous_neg)).mul
    (hc₂.comp continuous_expCUnit)

private theorem charFactor_eq_c (χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ) (hg : g.det ≠ 0) (z : ℂ) :
    ((χ₁ (complexIdeleAt hw (borelCFstUnit hg z)) : ℂˣ) : ℂ)
        * ((χ₂ (complexIdeleAt hw (borelCSndUnit hg z)) : ℂˣ) : ℂ)
      = ((χ₁ (complexIdeleAt hw (Units.mk0 (-g.det) (neg_ne_zero.2 hg))) : ℂˣ) : ℂ)
          * psiWC hw χ₁ χ₂ (Real.log (radC g z)) := by
  rw [borelCFstUnit_eq, borelCSndUnit_eq_expCUnit hg, map_mul, map_mul, Units.val_mul, psiWC,
    mul_assoc]

private theorem slice_eq_c {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) :
    φ (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = ((χ₁ (complexIdeleAt hw (detUnitC hw x)) : ℂˣ) : ℂ)
          * psiWC hw χ₁ χ₂
              (Real.log (radC (gOfC hw x) (ringEquivComplexOfIsComplex hw (a.1 w))))
          * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
              * kCW hw x (ringEquivComplexOfIsComplex hw (a.1 w))) := by
  rw [inducedSection_weyl_unipotent_c hw hφ x a, charFactor_eq_c hw χ₁ χ₂]
  rfl

private theorem ringEquivC_fst_translate (a : AdeleRing (𝓞 F) F) {θ : ℝ}
    {E : ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ t : ℝ, (E t).1 w = (ringEquivComplexOfIsComplex hw).symm
      ((t : ℂ) * Complex.exp (θ * Complex.I))) (t : ℝ) :
    ringEquivComplexOfIsComplex hw ((a + E t).1 w)
      = ringEquivComplexOfIsComplex hw (a.1 w) + t * Complex.exp (θ * Complex.I) := by
  show ringEquivComplexOfIsComplex hw (a.1 w + (E t).1 w) = _
  rw [hEw, map_add, RingEquiv.apply_symm_apply]

private theorem awayFrom_translate_c (a : AdeleRing (𝓞 F) F) {E : ℝ → AdeleRing (𝓞 F) F}
    (hEv : ∀ (t : ℝ) (v : InfinitePlace F), v ≠ w → (E t).1 v = 0)
    (hE2 : ∀ t : ℝ, (E t).2 = 0) (x : AdelicGL2 (𝓞 F) F) (t : ℝ) :
    awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E t) * x)
      = awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) :=
  awayFrom_weyl_unipotent_eq_of_agree F w
    (fun v hvw => show a.1 v + (E t).1 v = a.1 v by rw [hEv t v hvw, add_zero])
    (show a.2 + (E t).2 = a.2 by rw [hE2 t, add_zero]) x

private theorem slice_translate_eq_c {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ)
    (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) {θ : ℝ} {E : ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ t : ℝ, (E t).1 w = (ringEquivComplexOfIsComplex hw).symm
      ((t : ℂ) * Complex.exp (θ * Complex.I)))
    (hEv : ∀ (t : ℝ) (v : InfinitePlace F), v ≠ w → (E t).1 v = 0)
    (hE2 : ∀ t : ℝ, (E t).2 = 0) (t : ℝ) :
    φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E t) * x)
      = ((χ₁ (complexIdeleAt hw (detUnitC hw x)) : ℂˣ) : ℂ)
          * psiWC hw χ₁ χ₂ (Real.log (radC (gOfC hw x)
              (ringEquivComplexOfIsComplex hw (a.1 w) + t * Complex.exp (θ * Complex.I))))
          * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
              * kCW hw x (ringEquivComplexOfIsComplex hw (a.1 w)
                  + t * Complex.exp (θ * Complex.I))) := by
  rw [slice_eq_c hw hφ x (a + E t), ringEquivC_fst_translate hw a hEw t,
    awayFrom_translate_c a hEv hE2 x t]

end PsiC
