-- ===== S4.Def_RP_EtPBC_A_Z4Base =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 10 (G-e, part 2): the idempotent on `Y ×_V Spec R'`

* `isoSpec_inv_appTop'`, `eq_Spec_map` (a morphism `Spec R ⟶ V`, `V` affine, is `Spec` of its ring map).
* `pushout_inl_surj`, `pushout_inl_ker`: in a pushout of commutative rings along a surjection `g : A ↠ C`, the map
  `inl : B → P` is surjective with kernel `(ker g) B`.
* `hV V R' : Spec R' ⟶ V`, `hV_appTop`; `YV K gV π R' = Y ×_V Spec R'` with its `Γ(V)`-algebra structure `algYV`;
  `fR : R' →ₐ Γ(Y_{V'}, ⊤)`, `gS : secAlg →ₐ Γ(Y_{V'}, ⊤)`, **`PhiY = lift fR gS`**; `isClopen_PhiY`: for an
  idempotent `e'` of `R' ⊗ secAlg`, `D(PhiY e')` is clopen.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace
open RamanujanPetersson.EtCompact
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

theorem isoSpec_inv_appTop' (V : Scheme.{u}) [IsAffine V] :
    V.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(V, ⊤)).inv := by
  rw [← cancel_mono (Scheme.ΓSpecIso Γ(V, ⊤)).hom, Iso.inv_hom_id, ← Scheme.toSpecΓ_appTop,
    ← Scheme.isoSpec_hom, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]

/-- In a pushout of commutative rings along a surjection `g`, `ker inl = (ker g) B`. -/
theorem pushout_inl_ker {A B C P : CommRingCat.{u}} {f : A ⟶ B} {g : A ⟶ C} {inl : B ⟶ P} {inr : C ⟶ P}
    (h : IsPushout f g inl inr) (hg : Function.Surjective g.hom) :
    RingHom.ker inl.hom = (RingHom.ker g.hom).map f.hom := by
  apply le_antisymm
  · let I := (RingHom.ker g.hom).map f.hom
    let qB : B ⟶ CommRingCat.of (B ⧸ I) := CommRingCat.ofHom (Ideal.Quotient.mk I)
    let e := RingHom.quotientKerEquivOfSurjective hg
    let qA : A ⧸ RingHom.ker g.hom →+* B ⧸ I := Ideal.quotientMap I f.hom Ideal.le_comap_map
    let qC : C ⟶ CommRingCat.of (B ⧸ I) := CommRingCat.ofHom (qA.comp e.symm.toRingHom)
    have hw : f ≫ qB = g ≫ qC := by
      ext a
      have h2 : e.symm (g.hom a) = Ideal.Quotient.mk _ a := by
        rw [RingEquiv.symm_apply_eq]
        exact (RingHom.quotientKerEquivOfSurjective_apply_mk hg a).symm
      change Ideal.Quotient.mk I (f.hom a) = qA (e.symm (g.hom a))
      rw [h2, Ideal.quotientMap_mk]
    intro y hy
    have h1 := congrArg (fun φ => φ.hom y) (h.inl_desc qB qC hw)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.mem_ker.mp hy, map_zero] at h1
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have h1 := congrArg (fun φ => φ.hom a) h.w
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [h1, RingHom.mem_ker.mp ha, map_zero]

/-- `Spec R' ⟶ V` for a `Γ(V)`-algebra `R'` (`V` affine). -/
def hV (V : Scheme.{u}) [IsAffine V] (R' : Type u) [CommRing R'] [Algebra Γ(V, ⊤) R'] :
    Spec (CommRingCat.of R') ⟶ V :=
  Spec.map (CommRingCat.ofHom (algebraMap Γ(V, ⊤) R')) ≫ V.isoSpec.inv

section Base

end Base

end RamanujanPetersson.EtPBC.Z3

