-- title:
--   Curve bound gives finite colength for a bounded component ideal
-- statement:
--   For the parent’s finite-colength, positive-weight, nonnegative-slope, curve-bound, and positive-epsilon hypotheses, produce s > 0 and q > 0 with q + 1 < s(ρ + ε), such that the ideal generated by the degree-q components of elements of I^s supported in weight at most q has finite colength. This removes the curve-to-bounded-sections geometry from the parent; the available research route uses weighted compactification, ordinary blow-up, recovery of ordinary Rees powers, and eventual section generation. The claim remains the substantial unproved core. For d = 0 the coordinate conclusion downstream is vacuous; the numerical witnesses and finite-colength conclusion still need to hold.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.curve_bound_bounded_component_ideal_finite_colength_20261024
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (hfinite : Module.Finite Complex (MvPolynomial (Fin d) Complex ⧸ I))
    (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (rho : Rat) (hrho : 0 ≤ rho)
    (hcurve : WeightedIdealCurveBound I w rho)
    (eps : Real) (heps : 0 < eps) :
    ∃ s : Nat, 0 < s ∧ ∃ q : Rat, 0 < q ∧
      (q : Real) + 1 < (s : Real) * ((rho : Real) + eps) ∧
      Module.Finite Complex
        (MvPolynomial (Fin d) Complex ⧸ Ideal.span (Set.range (fun (p :
          {g : MvPolynomial (Fin d) Complex //
            g ∈ I ^ s ∧ ∀ a ∈ g.support,
              ∑ j, (w j : Real) * (a j : Real) ≤ (q : Real)}) =>
          MvPolynomial.weightedHomogeneousComponent
            (fun j => (w j : ℚ)) q p.1))) := by sorry
