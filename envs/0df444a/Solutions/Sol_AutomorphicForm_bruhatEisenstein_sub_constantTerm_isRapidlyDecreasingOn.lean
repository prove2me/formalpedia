p2m_open_scoped "Nat Filter.Nat"

private theorem hatTower_one (g : Matrix (Fin 2) (Fin 2) ℂ) :
    hatTower g 1 = hatRatio g * (1 + Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) := by
  simp [hatTower, invRadTower]

private theorem hatRatio_le_hatD (g : Matrix (Fin 2) (Fin 2) ℂ) {N : ℕ} (hN : 1 ≤ N) : hatRatio g ≤ hatD g N := by
  refine le_trans ?_ (hatTower_le_hatD g hN)
  rw [hatTower_one]
  have hq : 0 ≤ Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) := by positivity
  exact le_mul_of_one_le_right (hatRatio_nonneg g) (le_add_of_nonneg_right hq)

private theorem sqrt_div_sqrt_le_hatD (g : Matrix (Fin 2) (Fin 2) ℂ) {N : ℕ} (hN : 1 ≤ N) :
    Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) ≤ hatD g N := by
  refine le_trans ?_ (hatTower_le_hatD g hN)
  rw [hatTower_one]
  have h1 := one_le_hatRatio g
  have hq : 0 ≤ Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) := by positivity
  nlinarith

private theorem hatD_mono (g : Matrix (Fin 2) (Fin 2) ℂ) {N N' : ℕ} (h : N ≤ N') : hatD g N ≤ hatD g N' := by
  unfold hatD
  refine max_le_max le_rfl ?_
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_subset_range.2 (by omega : N + 1 ≤ N' + 1))
    fun i _ _ => hatTower_nonneg g i

private def muRatio (g : Matrix (Fin 2) (Fin 2) ℂ) : ℝ := 2 * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g))

private theorem muRatio_le_two_mul_hatD (g : Matrix (Fin 2) (Fin 2) ℂ) {N : ℕ} (hN : 1 ≤ N) :
    muRatio g ≤ 2 * hatD g N := by
  unfold muRatio
  exact mul_le_mul_of_nonneg_left (sqrt_div_sqrt_le_hatD g hN) zero_le_two

section Guards

variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private theorem normSq_entry_le_botNormSqC_11 (θ : ℝ) :
    Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 1)) ≤ Real.sqrt (botNormSqC g) := by
  apply Real.sqrt_le_sqrt
  have h1 : normSq (Complex.exp (θ * Complex.I)) = 1 := by
    rw [normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I, one_pow]
  rw [normSq_mul, h1, one_mul]
  unfold botNormSqC
  exact le_add_of_nonneg_left (normSq_nonneg _)

private theorem normSq_entry_le_botNormSqC_10 (θ : ℝ) :
    Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 0)) ≤ Real.sqrt (botNormSqC g) := by
  apply Real.sqrt_le_sqrt
  have h1 : normSq (Complex.exp (θ * Complex.I)) = 1 := by
    rw [normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I, one_pow]
  rw [normSq_mul, h1, one_mul]
  unfold botNormSqC
  exact le_add_of_nonneg_right (normSq_nonneg _)

private theorem sqrt_radFloorC_le_radC (hg : g.det ≠ 0) (z : ℂ) : Real.sqrt (radFloorC g) ≤ radC g z :=
  (le_mul_of_one_le_right (Real.sqrt_nonneg _) (le_max_left _ _)).trans (sqrt_radFloorC_mul_le_radC hg z)

private theorem radC_div_two_le_norm_botQ (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (hguard : 1 / 2 ≤ lineQSq g z₀ θ 0) :
    radC g z₀ / 2 ≤ ‖botQ g z₀‖ := by
  have hz : z₀ + ((0 : ℝ) : ℂ) * Complex.exp (θ * Complex.I) = z₀ := by simp
  have hr : 0 < radC g z₀ := radC_pos hg z₀
  have h := hguard
  rw [lineQSq, lineQhat, hz, normSq_div, Complex.normSq_ofReal, normSq_eq_norm_sq,
    le_div_iff₀ (mul_pos hr hr)] at h
  nlinarith [norm_nonneg (botQ g z₀), hr, h, mul_pos hr hr, mul_nonneg hr.le (norm_nonneg (botQ g z₀))]

private theorem radC_div_two_le_norm_botP (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ)
    (hguard : 1 / 2 ≤ normSq (linePhat g z₀ θ 0)) : radC g z₀ / 2 ≤ ‖botP g z₀‖ := by
  have hz : z₀ + ((0 : ℝ) : ℂ) * Complex.exp (θ * Complex.I) = z₀ := by simp
  have hr : 0 < radC g z₀ := radC_pos hg z₀
  have h := hguard
  rw [linePhat, hz, normSq_div, Complex.normSq_ofReal, normSq_eq_norm_sq,
    le_div_iff₀ (mul_pos hr hr)] at h
  nlinarith [norm_nonneg (botP g z₀), hr, h, mul_pos hr hr, mul_nonneg hr.le (norm_nonneg (botP g z₀))]

private theorem export_ratio_Q_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (hguard : 1 / 2 ≤ lineQSq g z₀ θ 0) :
    Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 1))
        / ‖botQ g z₀ + ((0 : ℝ) : ℂ) * (Complex.exp (θ * Complex.I) * g 1 1)‖ ≤ muRatio g := by
  have hden : ‖botQ g z₀ + ((0 : ℝ) : ℂ) * (Complex.exp (θ * Complex.I) * g 1 1)‖ = ‖botQ g z₀‖ := by simp
  rw [hden]
  have hr : 0 < radC g z₀ := radC_pos hg z₀
  have hQ := radC_div_two_le_norm_botQ hg z₀ θ hguard
  have hbpos : 0 < ‖botQ g z₀‖ := (half_pos hr).trans_le hQ
  have hsf : 0 < Real.sqrt (radFloorC g) := Real.sqrt_pos.2 (radFloorC_pos hg)
  have hfloor : Real.sqrt (radFloorC g) ≤ 2 * ‖botQ g z₀‖ := by
    linarith [sqrt_radFloorC_le_radC hg z₀, hQ]
  rw [div_le_iff₀ hbpos]
  unfold muRatio
  calc Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 1)) ≤ Real.sqrt (botNormSqC g) :=
        normSq_entry_le_botNormSqC_11 θ
    _ = Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) * Real.sqrt (radFloorC g) := by
        rw [div_mul_cancel₀ _ hsf.ne']
    _ ≤ Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) * (2 * ‖botQ g z₀‖) :=
        mul_le_mul_of_nonneg_left hfloor (by positivity)
    _ = 2 * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) * ‖botQ g z₀‖ := by ring

private theorem export_ratio_P_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (hguard : 1 / 2 ≤ normSq (linePhat g z₀ θ 0)) :
    Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 0))
        / ‖botP g z₀ + ((0 : ℝ) : ℂ) * (Complex.exp (θ * Complex.I) * g 1 0)‖ ≤ muRatio g := by
  have hden : ‖botP g z₀ + ((0 : ℝ) : ℂ) * (Complex.exp (θ * Complex.I) * g 1 0)‖ = ‖botP g z₀‖ := by simp
  rw [hden]
  have hr : 0 < radC g z₀ := radC_pos hg z₀
  have hP := radC_div_two_le_norm_botP hg z₀ θ hguard
  have hbpos : 0 < ‖botP g z₀‖ := (half_pos hr).trans_le hP
  have hsf : 0 < Real.sqrt (radFloorC g) := Real.sqrt_pos.2 (radFloorC_pos hg)
  have hfloor : Real.sqrt (radFloorC g) ≤ 2 * ‖botP g z₀‖ := by
    linarith [sqrt_radFloorC_le_radC hg z₀, hP]
  rw [div_le_iff₀ hbpos]
  unfold muRatio
  calc Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 0)) ≤ Real.sqrt (botNormSqC g) :=
        normSq_entry_le_botNormSqC_10 θ
    _ = Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) * Real.sqrt (radFloorC g) := by
        rw [div_mul_cancel₀ _ hsf.ne']
    _ ≤ Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g) * (2 * ‖botP g z₀‖) :=
        mul_le_mul_of_nonneg_left hfloor (by positivity)
    _ = 2 * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) * ‖botP g z₀‖ := by ring

end Guards
