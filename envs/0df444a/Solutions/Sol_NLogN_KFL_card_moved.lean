section Count

variable {K ρ f : ℕ} {g : Geo}

theorem nMv_card (κ : ℕ → ℕ) (M : ℕ) :
    nMv κ M = ((range M).filter fun m => κ m ≠ m).card := by
  induction M with
  | zero => simp [nMv]
  | succ M ih =>
    rw [nMv_succ, ih, Finset.range_add_one, Finset.filter_insert]
    split_ifs with h
    · rw [Finset.card_insert_of_notMem (by simp)]
    · rfl

/-- One digit of the record index: `#{m < M : digit(m) bad} · 2^K = 40 M`. -/
theorem count_dig (hK : 6 ≤ K) (hρK : ρ < K) (hQe : g.Q = 2 ^ (f * K)) {i : ℕ} (hi : i < f - 1)
    (S C : ℕ) (hS : 0 < S) (hM : g.recG.V = S * (g.Q * C)) :
    ((range g.recG.V).filter fun m =>
      ¬ (10 ≤ guardN K ρ (gc g.Q S m) i ∧ guardN K ρ (gc g.Q S m) i + 11 ≤ 2 ^ (K - 1))).card
      * 2 ^ K = 40 * g.recG.V := by
  set bad := (range g.Q).filter fun n =>
      ¬ (10 ≤ guardN K ρ n i ∧ guardN K ρ n i + 11 ≤ 2 ^ (K - 1))
  have hc := count_digit S g.Q C hS (by rw [hQe]; positivity) bad (filter_subset _ _)
  have e : ((range g.recG.V).filter fun m =>
      ¬ (10 ≤ guardN K ρ (gc g.Q S m) i ∧ guardN K ρ (gc g.Q S m) i + 11 ≤ 2 ^ (K - 1))) =
      (range (S * (g.Q * C))).filter fun n => (n / S) % g.Q ∈ bad := by
    rw [hM]; apply Finset.filter_congr; intro n _
    simp only [bad, Finset.mem_filter, Finset.mem_range, gc]
    exact ⟨fun h => ⟨Nat.mod_lt _ (by rw [hQe]; positivity), h⟩, fun h => h.2⟩
  have hb := count_bad_one (f := f) hK hρK i hi
  rw [← hQe] at hb
  rw [e, hc, hM]
  calc S * bad.card * C * 2 ^ K = S * C * (bad.card * 2 ^ K) := by ring
    _ = 40 * (S * (g.Q * C)) := by rw [hb]; ring

theorem guardOK_iff (t : ℕ) :
    GuardOK K ρ f (t : ℤ) ↔ ∀ i < f - 1, 10 ≤ guardN K ρ t i ∧ guardN K ρ t i + 11 ≤ 2 ^ (K - 1) := by
  unfold GuardOK
  refine forall_congr' fun i => imp_congr_right fun _ => ?_
  rw [guard_natCast]
  have : (1 : ℤ) ≤ 2 ^ (K - 1) := one_le_pow₀ (by norm_num)
  constructor
  · rintro ⟨h1, h2⟩; refine ⟨by exact_mod_cast h1, ?_⟩
    have : ((guardN K ρ t i + 11 : ℕ) : ℤ) ≤ ((2 ^ (K - 1) : ℕ) : ℤ) := by push_cast; omega
    exact_mod_cast this
  · rintro ⟨h1, h2⟩
    have h2' : ((guardN K ρ t i + 11 : ℕ) : ℤ) ≤ ((2 ^ (K - 1) : ℕ) : ℤ) := by exact_mod_cast h2
    push_cast at h2'
    exact ⟨by exact_mod_cast h1, by omega⟩

