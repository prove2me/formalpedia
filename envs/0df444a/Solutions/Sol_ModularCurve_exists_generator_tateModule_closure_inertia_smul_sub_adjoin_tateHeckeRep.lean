theorem AlgebraicClosure.exists_forall_apply_eq_pow_of_pow_eq_one (k : ℕ) :
    ∃ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ k) = 1 → σ ζ = ζ ^ n σ := by
  have h := fun σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ =>
    RingHom.exists_forall_pow_eq_one_apply_eq_pow (σ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ) (2 ^ k) (by positivity)
  choose n hn using h
  exact ⟨n, fun σ ζ hζ => hn σ ζ hζ⟩

