theorem coefChain_eq : ∀ t ρ, Dom t ρ →
    F_coef t ρ = HighU.actualDetGapCoefficient (1 / 2 - t) (1 / 2 - (1 - ρ) * t) := by
  intro t ρ hd
  have ht : t ≠ 0 := hd.1.ne'
  have hJ := jn_u_ne hd
  have hJw := jn_w_ne hd
  have hS := (entropySum_pos' hd).ne'
  have hjw := jn_add_dslope hd
  simp only [F_coef, F_mInner, F_m, F_mWzz, F_Wzz, F_zz, F_z, F_qonep, F_q, F_onep, F_one, F_dJSi, F_dJ, F_d, F_J, F_Si, F_S, F_W, F_qqdU, F_qq, F_qp2, F_mdd2, F_dd2, F_qhd, F_hd_, F_h, F_dU, F_U, F_U0, F_num0t, F_num0, F_mone, F_qA1, F_A1, F_j, F_tR, F_R, F_Jti, F_Jt, F_inner, F_mJwWZZ, F_JwWZZ, F_ZZ, F_Z, F_hmd, F_md, F_msumZSi, F_sumZSi, F_sumZ, F_qpJw, F_Jw, F_qJ, F_JwW, F_tJwNVJ, F_NVJ, F_NVt, F_NV, F_num0j, F_mhmdA1J, F_hmdA1J, F_hmdA1, F_tJw, F_mJwUsUs, F_JwUsUs, F_UsUs, F_Us, F_mWzZ, F_WzZ, F_Wz]
  rw [HighU.actualDetGapCoefficient, detGap_regular _ _ _ _ _ _ _ _ _ hJ hJw hS hjw]
  generalize Natural.jn (1 / 2 - t) = J at *
  generalize Natural.jn (1 / 2 - (1 - ρ) * t) = Jw at *
  generalize dslope Natural.jn (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = j at *
  generalize HighU.regularFsGap (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = R at *
  generalize HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = W at *
  generalize Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = S at *
  generalize Natural.qp (1 / 2 - t) = q at *
  push_cast
  field_simp
  ring

theorem m11Chain_eq : ∀ t ρ, Dom t ρ →
    F_m11 t ρ = Natural.m11 (1 / 2 - t) (1 / 2 - (1 - ρ) * t) := by
  intro t ρ hd
  have ht : t ≠ 0 := hd.1.ne'
  have hJ := jn_u_ne hd
  have hS := (entropySum_pos' hd).ne'
  have hne : (1 / 2 - (1 - ρ) * t) - (1 / 2 - t) ≠ 0 := sub_ne_zero.mpr (dom_u_lt_w hd).ne'
  have hFs : Natural.Fs (Natural.contact (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) =
      HighU.regularFsGap (1 / 2 - t) (1 / 2 - (1 - ρ) * t) * ((1 / 2 - (1 - ρ) * t) - (1 / 2 - t)) := by
    rw [regularFsGap_contact hd, div_mul_cancel₀ _ hne]
  have hWt : 2 * Natural.Fss (Natural.contact (1 / 2 - t) (1 / 2 - (1 - ρ) * t))
      (Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) =
      HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) := (regularWeight_contact hd).symm
  simp only [F_m11, F_au, F_Jti, F_Jt, F_J, F_auNt, F_auN, F_qT, F_JJw2dR, F_JJw, F_Jw, F_tdR, F_dR, F_d, F_R, F_q, F_dJh, F_Jhm1, F_mone, F_Jh, F_h, F_mWzuzu, F_Wzuzu, F_W, F_zuzu, F_zu, F_qdq, F_dqJSi, F_Si, F_S, F_dqJ, F_dq]
  unfold Natural.m11 Natural.au Natural.zu Natural.weight
  rw [hFs, hWt]
  generalize Natural.jn (1 / 2 - t) = J at *
  generalize Natural.jn (1 / 2 - (1 - ρ) * t) = Jw at *
  generalize HighU.regularFsGap (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = R at *
  generalize HighU.regularWeight (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = W at *
  generalize Natural.entropySum (1 / 2 - t) (1 / 2 - (1 - ρ) * t) = S at *
  generalize Natural.qp (1 / 2 - t) = q at *
  push_cast
  field_simp
  ring

theorem G_coefS : Good (fun t ρ => HighU.actualDetGapCoefficient (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) D_coef :=
  G_coef.congr coefChain_eq

theorem G_m11S : Good (fun t ρ => Natural.m11 (1 / 2 - t) (1 / 2 - (1 - ρ) * t)) D_m11 :=
  G_m11.congr m11Chain_eq

/-- coefficient positivity on the rectangle (kernel grid check, 4 x 8 boxes) -/
theorem coef_pos_region : ∀ t ρ, Dom t ρ → ((((7 / 50 : ℚ)) : ℚ) : ℝ) ≤ t → ((((-3 / 10 : ℚ)) : ℚ) : ℝ) ≤ ρ - 1 / 2 →
    0 < HighU.actualDetGapCoefficient (1 / 2 - t) (1 / 2 - (1 - ρ) * t) :=
  pos_of_TM_region G_coefS 5 (by decide +kernel) (by decide +kernel) (7 / 50 : ℚ) (-3 / 10 : ℚ) (by decide +kernel)
    (by decide +kernel) 4 8 (by decide +kernel) (by decide +kernel) (by decide +kernel)

/-- `m11` positivity on the rectangle (kernel grid check, 4 x 8 boxes) -/
theorem m11_pos_region : ∀ t ρ, Dom t ρ → ((((7 / 50 : ℚ)) : ℚ) : ℝ) ≤ t → ((((-3 / 10 : ℚ)) : ℚ) : ℝ) ≤ ρ - 1 / 2 →
    0 < Natural.m11 (1 / 2 - t) (1 / 2 - (1 - ρ) * t) :=
  pos_of_TM_region G_m11S 2 (by decide +kernel) (by decide +kernel) (7 / 50 : ℚ) (-3 / 10 : ℚ) (by decide +kernel)
    (by decide +kernel) 4 8 (by decide +kernel) (by decide +kernel) (by decide +kernel)

