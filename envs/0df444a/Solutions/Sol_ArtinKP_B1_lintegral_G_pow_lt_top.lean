namespace ArtinKP.B1

open ArtinKP.X

noncomputable section

variable {F : Type*} [Field F] [NumberField F] {S : Finset (FinitePlace F)}

/-! ### The action of `SL₂(R)` -/

lemma pairHt_actFF (q : F × F) (τ : SL(2, F)) (P : X F) :
    X.pairHt (actFF q τ).1 (actFF q τ).2 P = X.pairHt q.1 q.2 (τ • P) :=
  (X.pairHt_smul q.1 q.2 τ P).symm

lemma one_le_cS (τ : SL(2, F)) : 1 ≤ cS S τ := by
  unfold cS
  calc (1 : ℝ) = ∏ _v ∈ S, (1 : ℝ) := by simp
    _ ≤ _ := Finset.prod_le_prod (fun _ _ => zero_le_one) fun v _ => le_max_left _ _

lemma sNorm_actFF_le (q : F × F) (τ : SL(2, F)) :
    X.sNorm S (actFF q τ).1 (actFF q τ).2 ≤ cS S τ * X.sNorm S q.1 q.2 := by
  unfold X.sNorm cS
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_le_prod (fun v _ => le_max_of_le_left (apply_nonneg v _)) fun v _ => ?_
  set m := max 1 (max (max (v (τ 0 0)) (v (τ 0 1))) (max (v (τ 1 0)) (v (τ 1 1)))) with hm
  have hm0 : 0 ≤ m := le_trans zero_le_one (le_max_left _ _)
  have hx0 : 0 ≤ max (v q.1) (v q.2) := le_max_of_le_left (apply_nonneg v _)
  have key : ∀ a b : F, v a ≤ m → v b ≤ m → v (q.1 * a + q.2 * b) ≤ m * max (v q.1) (v q.2) := by
    intro a b ha hb
    refine (FinitePlace.add_le v _ _).trans (max_le ?_ ?_)
    · rw [map_mul, mul_comm]
      exact mul_le_mul ha (le_max_left _ _) (apply_nonneg v _) hm0
    · rw [map_mul, mul_comm]
      exact mul_le_mul hb (le_max_right _ _) (apply_nonneg v _) hm0
  have h00 : v (τ 0 0) ≤ m := le_max_of_le_right (le_max_of_le_left (le_max_left _ _))
  have h01 : v (τ 0 1) ≤ m := le_max_of_le_right (le_max_of_le_left (le_max_right _ _))
  have h10 : v (τ 1 0) ≤ m := le_max_of_le_right (le_max_of_le_right (le_max_left _ _))
  have h11 : v (τ 1 1) ≤ m := le_max_of_le_right (le_max_of_le_right (le_max_right _ _))
  exact max_le (key _ _ h00 h10) (key _ _ h01 h11)

namespace PairClass

variable [IsTotallyComplex F]

/-- `ht_{pτ}(P) ≤ c(τ⁻¹) · ht_p(τP)`. -/
theorem ht_actR_le (p : PairClass S) (τ : SL(2, F)) (hτ : IsSMat S τ) (P : X F) :
    (p.actR τ hτ).ht P ≤ cS S τ⁻¹ * p.ht (τ • P) := by
  induction p using Quotient.inductionOn with
  | _ q =>
    change X.sHt S (actFF (q.c, q.d) τ).1 (actFF (q.c, q.d) τ).2 P ≤ cS S τ⁻¹ * X.sHt S q.c q.d (τ • P)
    unfold X.sHt
    rw [pairHt_actFF]
    have hne' := (q.actR τ hτ).ne_zero
    change (actFF (q.c, q.d) τ).1 ≠ 0 ∨ (actFF (q.c, q.d) τ).2 ≠ 0 at hne'
    have hs1 := X.sNorm_pos S hne'
    have hs2 := X.sNorm_pos S q.ne_zero
    have hp := X.pairHt_pos q.ne_zero (τ • P)
    have h := sNorm_actFF_le (S := S) (actFF (q.c, q.d) τ) τ⁻¹
    rw [← actFF_mul, mul_inv_cancel, actFF_one] at h
    rw [← mul_div_assoc, div_le_div_iff₀ hs1 hs2]
    nlinarith [one_le_cS (S := S) τ⁻¹]

end PairClass

variable [IsTotallyComplex F]

/-! ### The series without one cusp -/

theorem Tcusp_act (σ : ℝ) (p₀ : PairClass S) (γ : SL(2, 𝓞 F)) (P : X F) :
    Tcusp S σ (p₀.act γ) P = Tcusp S σ p₀ (γ • P) := by
  unfold Tcusp
  refine ((neEquiv (PairClass.actEquiv γ) p₀).tsum_eq
    fun p => p.1.ht P ^ σ).symm.trans (tsum_congr fun p => ?_)
  change (p.1.act γ).ht P ^ σ = _
  rw [PairClass.ht_act]

theorem Tcusp_actR_le {σ : ℝ} (hσ : 2 < σ) (τ : SL(2, F)) (hτ : IsSMat S τ) (P : X F) :
    Tcusp S σ ((PairClass.inf S).actR τ hτ) P ≤ cS S τ⁻¹ ^ σ * Tinf S σ (τ • P) := by
  have e := (neEquiv (PairClass.actREquiv τ hτ) (PairClass.inf S)).tsum_eq
    fun p => p.1.ht P ^ σ
  unfold Tcusp Tinf
  rw [← tsum_mul_left]
  refine le_of_eq_of_le e.symm ?_
  have hc : 0 ≤ cS S τ⁻¹ := le_trans zero_le_one (one_le_cS _)
  have hs2 := (summable_Tinf S hσ (τ • P)).mul_left (cS S τ⁻¹ ^ σ)
  have hle : ∀ p : {p : PairClass S // p ≠ PairClass.inf S},
      ((neEquiv (PairClass.actREquiv τ hτ) (PairClass.inf S)) p).1.ht P ^ σ ≤
        cS S τ⁻¹ ^ σ * p.1.ht (τ • P) ^ σ := by
    intro p
    rw [← Real.mul_rpow hc (p.1.ht_pos _).le]
    exact Real.rpow_le_rpow (PairClass.ht_pos _ _).le (PairClass.ht_actR_le p.1 τ hτ P) (by linarith)
  exact (Summable.of_nonneg_of_le (fun p => Real.rpow_nonneg (PairClass.ht_pos _ _).le _) hle
    hs2).tsum_le_tsum hle hs2

/-- **Item 2 at every cusp, uniformly.** -/
theorem Tcusp_le (hO : FiniteCusps S) {σ : ℝ} (hσ : 2 < σ) :
    ∃ K C : ℝ, 0 < K ∧ 1 ≤ C ∧ ∀ (p₀ : PairClass S) (P : X F), ∃ h : ℝ, 0 < h ∧
      p₀.ht P ≤ C * h ∧ Tcusp S σ p₀ P ≤ K * (h ^ (2 - σ) + h ^ (-σ)) := by
  obtain ⟨n, τ, hτ, hcov⟩ := hO
  obtain ⟨K₀, hK₀, hT⟩ := Tinf_le S hσ
  set C : ℝ := 1 + ∑ i, cS S (τ i)⁻¹ with hC
  have hci : ∀ i, cS S (τ i)⁻¹ ≤ C := fun i => by
    have := Finset.single_le_sum (f := fun i => cS S (τ i)⁻¹)
      (fun i _ => le_trans zero_le_one (one_le_cS _)) (Finset.mem_univ i)
    linarith
  have hC1 : 1 ≤ C := by
    have : 0 ≤ ∑ i, cS S (τ i)⁻¹ := Finset.sum_nonneg fun i _ => le_trans zero_le_one (one_le_cS _)
    linarith
  refine ⟨C ^ σ * K₀, C, by positivity, hC1, fun p₀ P => ?_⟩
  obtain ⟨i, γ, hp⟩ := hcov p₀
  obtain ⟨Q, hQ⟩ : ∃ Q : X F, Q = γ • P := ⟨_, rfl⟩
  obtain ⟨Q₂, hQ₂⟩ : ∃ Q₂ : X F, Q₂ = τ i • Q := ⟨_, rfl⟩
  have e1 : p₀.ht P = ((PairClass.inf S).actR (τ i) (hτ i)).ht Q := by
    rw [hp, PairClass.ht_act, hQ]
  have e2 : Tcusp S σ p₀ P = Tcusp S σ ((PairClass.inf S).actR (τ i) (hτ i)) Q := by
    rw [hp, Tcusp_act, hQ]
  have a1 := PairClass.ht_actR_le (PairClass.inf S) (τ i) (hτ i) Q
  rw [PairClass.ht_inf, ← hQ₂] at a1
  have a2 := Tcusp_actR_le hσ (τ i) (hτ i) Q
  rw [← hQ₂] at a2
  have hc0 : 0 ≤ cS S (τ i)⁻¹ := le_trans zero_le_one (one_le_cS _)
  refine ⟨X.ht Q₂, X.ht_pos _, ?_, ?_⟩
  · rw [e1]
    exact a1.trans (mul_le_mul_of_nonneg_right (hci i) (X.ht_pos _).le)
  · rw [e2]
    refine a2.trans ?_
    have h1 := hT Q₂
    calc cS S (τ i)⁻¹ ^ σ * Tinf S σ Q₂
        ≤ C ^ σ * (K₀ * (X.ht Q₂ ^ (2 - σ) + X.ht Q₂ ^ (-σ))) :=
          mul_le_mul (Real.rpow_le_rpow hc0 (hci i) (by linarith)) h1 (Tinf_nonneg S σ _)
            (Real.rpow_nonneg (by linarith) _)
      _ = _ := by ring

/-! ### The function `G` -/

lemma summable_G {σ : ℝ} (hσ : 2 < σ) (P : X F) :
    Summable fun p : PairClass S => if p.ht P < 3 then p.ht P ^ σ else 0 :=
  Summable.of_nonneg_of_le
    (fun p => by split_ifs <;> [exact Real.rpow_nonneg (p.ht_pos P).le _; exact le_rfl])
    (fun p => by
      split_ifs
      · exact le_rfl
      · exact Real.rpow_nonneg (p.ht_pos P).le _) (PairClass.summable_ht_rpow S P hσ)

/-- `G ≤ 3^σ + ∑_{p ≠ p₀} ht_p^σ` for any class `p₀`. -/
lemma G_le_add_Tcusp {σ : ℝ} (hσ : 2 < σ) (p₀ : PairClass S) (P : X F) :
    G S σ P ≤ 3 ^ σ + Tcusp S σ p₀ P := by
  classical
  unfold G
  rw [(summable_G hσ P).tsum_eq_add_tsum_ite p₀]
  refine add_le_add ?_ ?_
  · split_ifs with h
    · exact Real.rpow_le_rpow (p₀.ht_pos P).le h.le (by linarith)
    · positivity
  · unfold Tcusp
    refine le_of_le_of_eq ?_ (tsum_subtype {p : PairClass S | p ≠ p₀} fun p => p.ht P ^ σ).symm
    have hs : Summable ({p : PairClass S | p ≠ p₀}.indicator fun p => p.ht P ^ σ) :=
      (PairClass.summable_ht_rpow S P hσ).indicator _
    refine Summable.tsum_le_tsum (fun p => ?_) ?_ hs
    · by_cases hp : p = p₀
      · simp [hp]
      · rw [if_neg hp, Set.indicator_of_mem (show p ∈ {p : PairClass S | p ≠ p₀} from hp)]
        split_ifs
        · exact le_rfl
        · exact Real.rpow_nonneg (p.ht_pos P).le _
    · refine Summable.of_nonneg_of_le (fun p => ?_) (fun p => ?_) (summable_G hσ P)
      · split_ifs <;> first | exact le_rfl | exact Real.rpow_nonneg (p.ht_pos P).le _
      · split_ifs <;> first | exact le_rfl | exact Real.rpow_nonneg (p.ht_pos P).le _

/-- **Proposition B: `G` is bounded on `X`** (`σ > 2`). -/
theorem G_le (hB : SBezout S) (hO : FiniteCusps S) {σ : ℝ} (hσ : 2 < σ) :
    ∃ K : ℝ, ∀ P : X F, G S σ P ≤ K := by
  obtain ⟨c₀, hc₀, htop⟩ := PairClass.exists_top hB
  obtain ⟨K, C, hK, hC, hT⟩ := Tcusp_le hO hσ
  refine ⟨3 ^ σ + K * ((c₀ / C) ^ (2 - σ) + (c₀ / C) ^ (-σ)), fun P => ?_⟩
  obtain ⟨p₀, hp₀, -⟩ := htop P
  obtain ⟨h, hh, hle, hbd⟩ := hT p₀ P
  refine (G_le_add_Tcusp hσ p₀ P).trans (add_le_add le_rfl (hbd.trans ?_))
  have hC0 : 0 < C := by linarith
  have hch : c₀ / C ≤ h := by rw [div_le_iff₀ hC0]; linarith [mul_comm C h]
  have h1 := Real.rpow_le_rpow_of_nonpos (div_pos hc₀ hC0) hch (by linarith : 2 - σ ≤ 0)
  have h2 := Real.rpow_le_rpow_of_nonpos (div_pos hc₀ hC0) hch (by linarith : -σ ≤ 0)
  exact mul_le_mul_of_nonneg_left (add_le_add h1 h2) hK.le

end

end ArtinKP.B1
end

