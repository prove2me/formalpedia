theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (𝓜 : A.Modules) (h𝓜 : Scheme.Modules.IsInvertible 𝓜) (hsym : IsSymmetric f L 𝓜) (hK : (kernelPts f L 𝓜).Finite)
    (hpos : ∃ m : ℕ, 0 < m ∧
      letI : Algebra k Γ(A, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ le_top).hom.toAlgebra
      letI : Module k Γ(𝓜.tensorPow m, ⊤) := Module.compHom _ (algebraMap k Γ(A, ⊤))
      0 < Module.finrank k Γ(𝓜.tensorPow m, ⊤))
    (n : ℕ) (hn : 0 < n) (𝓝 : A.Modules) (e : 𝓝 ≅ 𝓜.tensorPow n)
    (𝒰 : A.OrderedAffineCover) (i : ℕ) :
    Subsingleton ((OModulePresheaf.ofModules f 𝓝).HSucc 𝒰 i) := by
  classical
  obtain ⟨m, hm, hposm⟩ := hpos
  haveI : IsSeparated f := hA.proper.toIsSeparated

  haveI := hA.smooth
  obtain ⟨g, hg⟩ := GoodReductionJacobian.RelativeGroupLaw.exists_smoothOfRelativeDimension_of_smooth L
  haveI := hg
  have hinv : ∀ s : ℕ, Scheme.Modules.IsInvertible (𝓜.tensorPow s) := fun s =>
    AlgebraicGeometry.Scheme.Modules.IsInvertible.tensorPow_monoidalV2 h𝓜 s

  have hKm : (kernelPts f L (𝓜.tensorPow m)).Finite :=
    AlgebraicGeometry.Polarisation.finite_kernelPts_of_iso_tensorPow_of_finite_kernelPts
      k f L hc hA 𝓜 h𝓜 hK m hm (𝓜.tensorPow m) (Iso.refl _)

  have hfs : (𝓜.tensorPow (m * 3)).FiniteBySections f :=
    AlgebraicGeometry.Polarisation.finiteBySections_of_iso_tensorPow_three_of_finite_kernelPts_of_finrank_pos
      k f L hc hA (𝓜.tensorPow m) (hinv m) hKm hposm (𝓜.tensorPow (m * 3)) (tensorPowMulIso 𝓜 m 3)
  obtain ⟨N₀, 𝔓, hfin⟩ := hfs

  have hc0 : 0 < m * 3 := by omega
  choose t ht using fun r : ℕ =>
    AlgebraicGeometry.Scheme.Modules.exists_forall_subsingleton_HSucc_tensorObj_tensorPow_of_isFinite_toProj_monoidalV2
      k f (𝓜.tensorPow (m * 3)) (hinv (m * 3)) N₀ 𝔓 hfin (𝓜.tensorPow r) (hinv r)
  obtain ⟨T, hT⟩ : ∃ T : ℕ, ∀ e : ℕ, T ≤ e → ∀ (𝒲 : A.OrderedAffineCover) (j : ℕ),
      Subsingleton ((OModulePresheaf.ofModules f (𝓜.tensorPow e)).HSucc 𝒲 j) := by
    refine ⟨(Finset.range (m * 3)).sup fun r => r + (m * 3) * t r, fun e he 𝒲 j => ?_⟩

    set r := e % (m * 3) with hr
    set q := e / (m * 3) with hq
    have hrlt : r < m * 3 := Nat.mod_lt _ hc0
    have he' : r + (m * 3) * q = e := Nat.mod_add_div e (m * 3)
    have htr : r + (m * 3) * t r ≤ e :=
      le_trans (Finset.le_sup (f := fun r => r + (m * 3) * t r) (Finset.mem_range.2 hrlt)) he
    have hqt : t r ≤ q := by
      have : (m * 3) * t r ≤ (m * 3) * q := by omega
      exact Nat.le_of_mul_le_mul_left this hc0
    have hvan := ht r q hqt 𝒲 j
    obtain ⟨φ⟩ := (AlgebraicGeometry.OModulePresheaf.nonempty_cechEquiv_ofModules_of_iso f
      (tensorPowResidueIso 𝓜 r (m * 3) q) 𝒲).2.1 j
    rw [he'] at φ
    exact φ.symm.toEquiv.subsingleton

  obtain ⟨N, hNge, hNp⟩ := Nat.exists_infinite_primes (max T (ringChar k) + 1)
  have hNT : T ≤ N ^ 2 * n := by
    have h1 : T < N := by omega
    have h2 : N ≤ N ^ 2 := by nlinarith [hNp.one_lt.le]
    nlinarith
  have hNk : (N : k) ≠ 0 := by
    intro h0
    have hdvd : ringChar k ∣ N := (ringChar.spec k N).1 h0
    rcases (Nat.dvd_prime hNp).1 hdvd with h1 | h1
    · exact (CharP.ringChar_ne_one (R := k)) h1
    · omega
  have hN0 : 0 < N := hNp.pos
  obtain ⟨e₁⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_schemeNsmul_iso_tensorPow_sq_of_isSymmetric_monoidalV2 k f L hc hA 𝓜 h𝓜 hsym N
  obtain ⟨e₀⟩ := AlgebraicGeometry.Scheme.Modules.nonempty_pullback_tensorPow_iso_monoidalV2 (L.schemeNsmul N) 𝓜 n

  have ePB : (Scheme.Modules.pullback (L.schemeNsmul N)).obj (𝓜.tensorPow n) ≅ 𝓜.tensorPow (N ^ 2 * n) :=
    e₀ ≪≫ tensorPowMapIso e₁ n ≪≫ (tensorPowMulIso 𝓜 (N ^ 2) n).symm

  have hvann : Subsingleton ((OModulePresheaf.ofModules f (𝓜.tensorPow n)).HSucc 𝒰 i) :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.subsingleton_HSucc_of_subsingleton_HSucc_pullback_schemeNsmul
      k f L hc hA g N hNk (𝓜.tensorPow n) (hinv n) (𝓜.tensorPow (N ^ 2 * n)) ePB.symm 𝒰 𝒰 i (hT _ hNT 𝒰 i)

  obtain ⟨ψ⟩ := (AlgebraicGeometry.OModulePresheaf.nonempty_cechEquiv_ofModules_of_iso f e 𝒰).2.1 i
  exact ψ.toEquiv.subsingleton

