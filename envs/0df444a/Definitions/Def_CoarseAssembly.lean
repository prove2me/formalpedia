  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]


def transport (I : OAI.CoarseAssembly.Analytic.CompatibleIndexFamily C A) (f : OAI.CoarseAssembly.Analytic.CoarseningMorphism D C)
    (φ : A →⋆ₙₐ[ℂ] B) : OAI.CoarseAssembly.Analytic.CompatibleIndexFamily D B := by
  classical
  have OAI.CoarseAssembly.Analytic.pushforward_comp {X : Type _} {Y : Type _} {Z : Type _} [inst_local_3 : TopologicalSpace X] [inst_local_4 : TopologicalSpace Y] [inst_local_5 : TopologicalSpace Z] (f : CocompactMap X Y) (g : CocompactMap Y Z) :
      OAI.CoarseAssembly.Analytic.pushforward (g.comp f) = (OAI.CoarseAssembly.Analytic.pushforward g).comp (OAI.CoarseAssembly.Analytic.pushforward f)  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    open scoped ZeroAtInfty in
    by
      rw [OAI.CoarseAssembly.Analytic.pushforward, (
      let local_proof {X : Type _} {Y : Type _} {Z : Type _} [inst_local_3 : TopologicalSpace X] [inst_local_4 : TopologicalSpace Y] [inst_local_5 : TopologicalSpace Z] (f : CocompactMap X Y) (g : CocompactMap Y Z) :
          OAI.CoarseAssembly.Analytic.pullback (g.comp f) = (OAI.CoarseAssembly.Analytic.pullback f).comp (OAI.CoarseAssembly.Analytic.pullback g) :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          open scoped ZeroAtInfty in
          by
            ext a x
            rfl
      local_proof), (
      let local_proof {A : Type _} [inst_local_1 : NonUnitalCStarAlgebra A] {B : Type _} {C : Type _} [inst_local_4 : NonUnitalCStarAlgebra B] [inst_local_5 : NonUnitalCStarAlgebra C] (φ : B →⋆ₙₐ[ℂ] A) (ψ : C →⋆ₙₐ[ℂ] B) :
          OAI.CoarseAssembly.Analytic.precomp (φ.comp ψ) = (OAI.CoarseAssembly.Analytic.precomp ψ).comp (OAI.CoarseAssembly.Analytic.precomp φ) :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            apply QuotientAddGroup.addMonoidHom_ext
            apply FreeAbelianGroup.lift_ext
            intro c
            rfl
      local_proof)]
      rfl
  have OAI.CoarseAssembly.Analytic.CoarseningMorphism.pushforward_compatible {C : OAI.CoarseAssembly.Analytic.Coarsening} {D : OAI.CoarseAssembly.Analytic.Coarsening} (f : OAI.CoarseAssembly.Analytic.CoarseningMorphism C D) (r s : ℕ) (h : r ≤ s) :
      (OAI.CoarseAssembly.Analytic.pushforward (f.atScale s)).comp (C.map r s h) =
        (D.map r s h).comp (OAI.CoarseAssembly.Analytic.pushforward (f.atScale r))  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic OAI.CoarseAssembly.Analytic.CoarseningMorphism in
    by
      change (OAI.CoarseAssembly.Analytic.pushforward (f.atScale s)).comp (OAI.CoarseAssembly.Analytic.pushforward (C.inclusion r s h)) =
        (OAI.CoarseAssembly.Analytic.pushforward (D.inclusion r s h)).comp (OAI.CoarseAssembly.Analytic.pushforward (f.atScale r))
      rw [← OAI.CoarseAssembly.Analytic.pushforward_comp, ← OAI.CoarseAssembly.Analytic.pushforward_comp, f.compatible]
  exact {
    atScale r := (OAI.CoarseAssembly.OperatorKTheory.map φ).comp ((I.atScale r).comp (OAI.CoarseAssembly.Analytic.pushforward (f.atScale r)))
    compatible r s hrs a := by
      have hf := DFunLike.congr_fun ((OAI.CoarseAssembly.Analytic.CoarseningMorphism.pushforward_compatible f r s hrs)) a
      change OAI.CoarseAssembly.Analytic.pushforward (f.atScale s) (D.map r s hrs a) =
        C.map r s hrs (OAI.CoarseAssembly.Analytic.pushforward (f.atScale r) a) at hf
      change OAI.CoarseAssembly.OperatorKTheory.map φ (I.atScale s (OAI.CoarseAssembly.Analytic.pushforward (f.atScale s) (D.map r s hrs a))) = _
      rw [hf, I.compatible]
