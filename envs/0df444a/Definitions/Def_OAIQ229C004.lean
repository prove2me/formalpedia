-- module Solutions.Q229_CA.CoarseAssembly_Lattice
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-!
# The triangular-lattice discs

The vertex set, adjacency, radius and depth used in §3 of the coarse Novikov
manuscript. The three integer linear forms are precisely those in its hexagonal
radius `max {|a|, |b|, |a+b|}`. These definitions do not assert the unproved
identification of the filled geometric realization with a topological disc.
-/

namespace CoarseAssembly

instance instInhabitedDisc (j : ℕ) : Inhabited (Disc j) :=
  ⟨⟨(0, 0), by simp [latticeRadius]⟩⟩

end CoarseAssembly

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_Holonomy
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-!
# The group calculation for a charged closed walk

In §3, left Cayley moves commute with the right holonomy. Recording a step
as `(s,m)` means `z ↦ s * z * g^m`; a pure Cayley step has `m=0`, and a
pure base step has `s=1`. The accumulated endpoint formula and conjugacy
obstruction are expressed using an actual finite list of steps.
-/

namespace CoarseAssembly

variable {Q : Type*} [Group Q]

/-- Successively apply left Cayley moves and right integral holonomies. -/
def holonomyEndpoint (g : Q) : List (Q × ℤ) → Q → Q
  | [], z => z
  | s :: steps, z => holonomyEndpoint g steps (s.1 * z * g ^ s.2)

end CoarseAssembly

end OAI
end

