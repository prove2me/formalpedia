theorem OAI.SecondPassIntegration.secondSectorZ_residualColumnScale {ι : Type*} [DecidableEq ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (X X₀ : ℝ) (hX : 0 < X) (e r : O) (he : e ≠ 0) (hr : r ≠ 0)
    (x : SecondSupportData ι) :
    secondSectorZ p (residualColumnScale X e r) X₀ x =
      Real.log (elementNorm e * elementNorm r * primeProductNorm p x.overlap * X₀ / X) := by sorry
