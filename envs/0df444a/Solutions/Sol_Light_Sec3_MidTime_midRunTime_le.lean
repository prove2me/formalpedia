open ThreeSumApsp ThreeSumApsp.Spec

namespace HostData

variable (X : HostData) (D' : ℕ)

/-- The data stay valid for an inner dimension that is at least `q p`. -/
theorem Valid.withD {X : HostData} (hv : X.Valid) {D' : ℕ} (h : X.q * X.p ≤ D') :
    (X.withD D').Valid :=
  { n_pos := hv.n_pos, p_pos := hv.p_pos, q_pos := hv.q_pos, cap_pos := hv.cap_pos, qp_le := h,
    lenAB := hv.lenAB, lenBC := hv.lenBC, lenAC := hv.lenAC }

end HostData

/-- `⌈s/g⌉ ≤ s` for `g ≥ 1`. -/
theorem pieceSizeNat_le_sqrt {D g : ℕ} (hg : 1 ≤ g) : pieceSizeNat D g ≤ Nat.sqrt D :=
  (Nat.ceilDiv_le_iff hg).2 (Nat.le_mul_of_pos_right _ hg)

/-- The middle dimension is at most `D`. -/
theorem midDim_le {D g : ℕ} (hg : 1 ≤ g) : midDim D g ≤ D :=
  (Nat.mul_le_mul_right _ (pieceSizeNat_le_sqrt hg)).trans (Nat.sqrt_le D)

/-- The data with the middle dimension are valid. -/
theorem midHostData_valid {x : TriInst} {μ : ℕ → ℤ} {fr D g : ℕ} (hpre : x.Pre μ fr)
    (h : BigCase x.n D g) : (midHostData x D g).Valid :=
  (hostData_valid hpre h).withD (Nat.mul_le_mul_left _ (hostData_p_le x g h.sixteen_le))

variable {P₀ R : Program} {ν : Et17Nums} {pAEBrute pAELoop pScanPairsAE pCore pFill : ℕ}
  {Tn : List ℕ → ℕ} {need : List ℕ → Need} {Dfun Gfun tD tG wD wG : ℕ → ℕ}

/-- The time of the third part in a run, written for the data of the host of Theorem 17. -/
theorem aeRunTime_withD (Tn : List ℕ → ℕ) (X : HostData) (D' U : ℕ) :
    aeRunTime Tn (X.withD D') U = tDblTable (bitLen U) + 3 * tResidues (X.n * X.n) (bitLen U)
      + tClasses X.n X.p + tChunks X.p X.chunkCount + tAELoop Tn (X.withD D') + 80 := rfl

namespace MidTime

private theorem tWrites_mono {n D D' a b : ℕ} (hD : D' ≤ D) (h : a ≤ b) :
    tWrites n D' a ≤ tWrites n D b := by
  unfold tWrites tWriteX tWriteY
  gcongr

private theorem le_supTime (Tn : List ℕ → ℕ) (n D : ℕ) {w cap : ℕ} (h : w ≤ cap) :
    Tn [n, D, w] ≤ supTime Tn n D cap :=
  Finset.le_sup (f := fun w => Tn [n, D, w]) (Finset.mem_range.2 (by omega))

/-- The time of one instance is at most the worst case plus the time of its scans. -/
private theorem instance_le (Tn : List ℕ → ℕ) (n D D' execs : ℕ) {len q w cap : ℕ} (hD : D' ≤ D)
    (hlen : len ≤ q) (hw : w ≤ cap) :
    tWrites n D' len + Tn [n, D', w] + tScanPairsAE w len execs
      ≤ tWrites n D q + supTime Tn n D' cap + tAEAnswers cap + (tScanCall q + 20) * execs := by
  have hwrites := tWrites_mono (n := n) hD hlen
  have hsolver := le_supTime Tn n D' hw
  have hanswers : tAEAnswers w ≤ tAEAnswers cap := by
    unfold tAEAnswers
    gcongr
  have hscans : (tScanCall len + 20) * execs ≤ (tScanCall q + 20) * execs := by
    unfold tScanCall tScan
    gcongr
  unfold tScanPairsAE
  omega

private theorem sum_le_mul_add {m M A B E : ℕ} {f e : ℕ → ℕ} (hf : ∀ t < m, f t ≤ A + B * e t)
    (hm : m ≤ M) (he : ∑ t ∈ Finset.range m, e t ≤ E) :
    ∑ t ∈ Finset.range m, f t ≤ M * A + B * E :=
  calc ∑ t ∈ Finset.range m, f t ≤ ∑ t ∈ Finset.range m, (A + B * e t) :=
        Finset.sum_le_sum fun t ht => hf t (Finset.mem_range.1 ht)
    _ = m * A + B * ∑ t ∈ Finset.range m, e t := by
        rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul,
          Finset.mul_sum]
    _ ≤ M * A + B * E := Nat.add_le_add (Nat.mul_le_mul_right _ hm) (Nat.mul_le_mul_left _ he)

private theorem chunkCount_le_m {X : HostData} (hv : X.Valid) : X.chunkCount ≤ X.m := by
  have hn := hv.n_pos
  have hq := hv.q_pos
  have hpieces : 1 ≤ X.h := by
    rw [HostData.h, Nat.ceilDiv_eq_add_pred_div, Nat.le_div_iff_mul_le (by omega)]
    omega
  rw [HostData.m]
  exact Nat.le_mul_of_pos_left _ hpieces

variable {x : TriInst} {μ : ℕ → ℤ} {fr D g : ℕ}

private theorem sum_aeExecs_le_bound (hpre : x.Pre μ fr) (hbig : BigCase x.n D g) :
    ∑ t ∈ Finset.range (midHostData x D g).m, (midHostData x D g).aeExecs t
      ≤ falsePositiveBound x.n x.U D + x.n * x.n :=
  (HostData.sum_aeExecs_le (midHostData_valid hpre hbig)).trans
    (Nat.add_le_add_right (F_le_falsePositiveBound hpre hbig) _)

private theorem tAELoop_le (hpre : x.Pre μ fr) (hbig : BigCase x.n D g) (Tn : List ℕ → ℕ) :
    tAELoop Tn (midHostData x D g) ≤ midLoopBound Tn x.n x.U D g :=
  Nat.add_le_add_right (sum_le_mul_add
    (fun _ ht => instance_le Tn x.n D (midDim D g) _ (midDim_le hbig.one_le_g)
      (Nat.min_le_left _ _) ((hostData x D g).w_le_cap ht))
    (hostData_m_le hbig) (sum_aeExecs_le_bound hpre hbig)) 14

end MidTime

end Light.Sec3
end
end

section
open Light
open Light.Sec3
open ThreeSumApsp ThreeSumApsp.Spec
variable {P₀ R : Program} {ν : Et17Nums} {pAEBrute pAELoop pScanPairsAE pCore pFill : ℕ}
  {Tn : List ℕ → ℕ} {need : List ℕ → Need} {Dfun Gfun tD tG wD wG : ℕ → ℕ}
open Light.Sec3.MidTime
variable {x : TriInst} {μ : ℕ → ℤ} {fr D g : ℕ}
theorem solution (hpre : x.Pre μ fr) (hbig : BigCase x.n D g) (Tn : List ℕ → ℕ) :
    aeRunTime Tn (midHostData x D g) x.U
      ≤ tDblTable (bitLen x.U) + 3 * tResidues (x.n * x.n) (bitLen x.U)
        + tClasses x.n (Nat.sqrt D) + tChunks (Nat.sqrt D) (4 * x.n * g)
        + midLoopBound Tn x.n x.U D g + 80 := by
  have hprime : (hostData x D g).p ≤ Nat.sqrt D := hostData_p_le x g hbig.sixteen_le
  have hchunks : (hostData x D g).chunkCount ≤ 4 * x.n * g :=
    (chunkCount_le_m (hostData_valid hpre hbig)).trans (hostData_m_le hbig)
  have hloop := tAELoop_le hpre hbig Tn
  have hn : (hostData x D g).n = x.n := rfl
  unfold midHostData at hloop ⊢
  rw [aeRunTime_withD, hn]
  unfold tClasses tChunks
  omega
end
