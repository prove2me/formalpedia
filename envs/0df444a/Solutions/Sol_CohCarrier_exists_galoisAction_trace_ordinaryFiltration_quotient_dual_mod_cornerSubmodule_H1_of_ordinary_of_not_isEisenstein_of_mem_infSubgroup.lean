theorem Θ_op₁ (g : Gen M ↑S) : ∃ q : Sp.CornerRing i₀, ΘΘ (op₁ T p g) = Sp.toCornerRing i₀ (op g) + r • q := by
  have h : ∀ m, red r (lftV N (crdp (op₁ T p g)) m : 𝒪) = red r ((cT g m : ℤ) : 𝒪) := by
    intro m
    rw [red_lftV_crd T u r p huindp huspanp N hpN, op₁, crd_TC T u cT ℤ_[p] huindp huspanp hu_T, ψ_intCast, map_intCast]
  obtain ⟨q, hq⟩ := ϑ_elemA_congr hfaith op hop hgen T u bO hbO hk θbar Sp i₀ πk hπk hEis r huindO huspanO _ _ h
  refine ⟨q, ?_⟩
