variable {F : Type} [Field F] [NumberField F]

private theorem _root_.LanglandsTunnell.CubicInduction.TwistLegs.hasConductorExponentAt_zero_of_isUnramifiedCharAt {χ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {v : HeightOneSpectrum (𝓞 F)} (h : IsUnramifiedCharAt χ v) :
    HasConductorExponentAt F v (localChar χ v) 0 := by
  refine (hasConductorExponentAt_zero_iff F v).mpr fun u hu => h u ?_ ?_
  · exact (mem_adicCompletionIntegers _ _ _).mpr hu.le
  · exact (mem_adicCompletionIntegers _ _ _).mpr (by rw [Units.val_inv_eq_inv_val, map_inv₀, hu, inv_one])

p2m_export "LanglandsTunnell.CubicInduction.TwistLegs" "hasConductorExponentAt_zero_of_isUnramifiedCharAt"
private theorem _root_.LanglandsTunnell.CubicInduction.TwistLegs.isUnramifiedCharAt_of_hasConductorExponentAt_zero {χ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {v : HeightOneSpectrum (𝓞 F)} (h : HasConductorExponentAt F v (localChar χ v) 0) :
    IsUnramifiedCharAt χ v := by
  intro t ht ht'
  refine (hasConductorExponentAt_zero_iff F v).mp h t (le_antisymm ((mem_adicCompletionIntegers _ _ _).mp ht) ?_)
  have h1 : (Valued.v (t : v.adicCompletion F))⁻¹ ≤ 1 := by
    have := (mem_adicCompletionIntegers _ _ _).mp ht'
    rwa [Units.val_inv_eq_inv_val, map_inv₀] at this
  have h0 : Valued.v (t : v.adicCompletion F) ≠ 0 := (Valuation.ne_zero_iff _).mpr t.ne_zero
  exact (inv_le_one₀ (zero_lt_iff.mpr h0)).mp h1

p2m_export "LanglandsTunnell.CubicInduction.TwistLegs" "isUnramifiedCharAt_of_hasConductorExponentAt_zero"

private theorem apply_localUnit_eq_one {χ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {v : HeightOneSpectrum (𝓞 F)}
    (h : IsUnramifiedCharAt χ v) {t : (v.adicCompletion F)ˣ} (ht : Valued.v (t : v.adicCompletion F) = 1) :
    χ (Units.map (AdelicLevel.finIncl (𝓞 F) F) (AdelicLevel.localUnit (𝓞 F) F v t)) = 1 :=
  (hasConductorExponentAt_zero_iff F v).mp (hasConductorExponentAt_zero_of_isUnramifiedCharAt h) t ht

end

private theorem apply_idelicNorm_uniformizerIdele (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K))
    (hχ : IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ))) :
    χ ((genuineBaseChange ℚ K).idelicNorm (uniformizerIdele K 𝔓)) =
      χ (uniformizerIdele ℚ (𝔓.under (𝓞 ℚ))) ^ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  obtain ⟨t, ht, hN⟩ := M4aHerbrand.exists_idelicNorm_uniformizerIdele_eq_pow_inertiaDeg_mul_localUnit ℚ K 𝔓
  rw [hN, map_mul, map_pow, apply_localUnit_eq_one hχ ht, mul_one]

