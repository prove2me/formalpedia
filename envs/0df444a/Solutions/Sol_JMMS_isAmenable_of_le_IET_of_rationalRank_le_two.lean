/-- Amenability transfers along a group isomorphism. -/
theorem isAmenable_of_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (hG : Garrido.IsAmenable G) : Garrido.IsAmenable H := by
  obtain ⟨m, ⟨h0, hadd⟩, h1, hinv⟩ := hG
  refine ⟨fun s => m (e ⁻¹' s), ⟨by simpa using h0, ?_⟩, by simpa using h1, ?_⟩
  · intro s t hst
    show m (e ⁻¹' (s ∪ t)) = m (e ⁻¹' s) + m (e ⁻¹' t)
    rw [Set.preimage_union]
    exact hadd _ _ (hst.preimage _)
  · intro g s
    have : e ⁻¹' (g • s) = e.symm g • (e ⁻¹' s) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_smul_set_iff_inv_smul_mem, smul_eq_mul]
      simp [map_mul, map_inv]
    show m (e ⁻¹' (g • s)) = m (e ⁻¹' s)
    rw [this, hinv]

/-- Every element of `IET` has finitely many angles. -/
theorem angles_finite_of_mem_IET {g : Equiv.Perm UnitAddCircle} (hg : g ∈ IET) :
    (angles g).Finite := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hx.2.1
  | one => exact (Set.finite_singleton 0).subset (by rintro _ ⟨x, rfl⟩; simp)
  | mul g h _ _ hg hh =>
    refine (hg.add hh).subset ?_
    rintro _ ⟨x, rfl⟩
    refine ⟨g (h x) - h x, ⟨h x, rfl⟩, h x - x, ⟨x, rfl⟩, ?_⟩
    simp [Equiv.Perm.mul_apply]
  | inv g _ hg =>
    refine hg.neg.subset ?_
    rintro _ ⟨x, rfl⟩
    rw [Set.mem_neg]
    exact ⟨g⁻¹ x, by simp⟩

theorem rationalRank_mono {Λ M : AddSubgroup UnitAddCircle} (h : Λ ≤ M) :
    rationalRank Λ ≤ rationalRank M := by
  unfold rationalRank
  refine iSup₂_le fun d ⟨f, hf⟩ => le_iSup₂_of_le (f := fun (d : ℕ)
    (_ : ∃ f : (Fin d → ℤ) →+ M, Function.Injective f) => (d : ℕ∞)) d
    ⟨(AddSubgroup.inclusion h).comp f, ?_⟩ le_rfl
  exact (AddSubgroup.inclusion_injective h).comp hf

end IETP19

open IETP19 in
theorem chk_isAmenable_of_le_IET_of_rationalRank_le_two (G : Subgroup (Equiv.Perm UnitAddCircle))
    (hG : G ≤ IET) (hrk : rationalRank (angleGroup G) ≤ 2) : Garrido.IsAmenable ↥G := by
  classical
  refine Garrido.isAmenable_of_directed (fun s : Finset G => Subgroup.closure (s : Set G))
    ?_ ?_ ?_
  · intro s t
    exact ⟨s ∪ t, Subgroup.closure_mono (by simp), Subgroup.closure_mono (by simp)⟩
  · rw [eq_top_iff]
    intro g _
    exact Subgroup.mem_iSup_of_mem {g} (Subgroup.subset_closure (by simp))
  · intro s
    -- the angle group generated by the generators' angles
    set L : AddSubgroup UnitAddCircle :=
      AddSubgroup.closure (⋃ g ∈ s, angles (g : Equiv.Perm UnitAddCircle)) with hL
    have hLfg : L.FG := by
      refine ⟨(s.finite_toSet.biUnion fun g _ => angles_finite_of_mem_IET (hG g.2)).toFinset, ?_⟩
      simp [hL]
    have hLle : L ≤ angleGroup G := by
      rw [hL, AddSubgroup.closure_le]
      simp only [Set.iUnion_subset_iff]
      rintro g _ _ ⟨x, rfl⟩
      exact AddSubgroup.subset_closure ⟨g, g.2, x, rfl⟩
    have hamen : Garrido.IsAmenable ↥(IETOf L) :=
      isAmenable_IETOf_of_rationalRank_le_two L hLfg ((rationalRank_mono hLle).trans hrk)
    set K := (Subgroup.closure (s : Set G)).map G.subtype with hK
    have hKle : K ≤ IETOf L := by
      rw [hK, Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
      intro g hg
      refine ⟨hG g.2, ?_⟩
      intro x
      exact AddSubgroup.subset_closure (Set.mem_biUnion hg ⟨x, rfl⟩)
    have h1 : Garrido.IsAmenable ↥(K.subgroupOf (IETOf L)) := Garrido.isAmenable_subgroup hamen _
    have h2 : Garrido.IsAmenable ↥K :=
      isAmenable_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hKle) h1
    exact isAmenable_of_mulEquiv
      ((Subgroup.equivMapOfInjective _ G.subtype G.subtype_injective).symm) (by
        simpa [hK] using h2)

end JMMS
end

open IntervalExchange
open JMMS in
theorem solution (G : Subgroup (Equiv.Perm UnitAddCircle))
    (hG : G ≤ IET) (hrk : rationalRank (angleGroup G) ≤ 2) : Garrido.IsAmenable ↥G := by
  apply JMMS.chk_isAmenable_of_le_IET_of_rationalRank_le_two <;> assumption
