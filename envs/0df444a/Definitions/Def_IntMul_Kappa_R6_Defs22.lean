/-! ## The headers -/

/-- `F - 1`. -/
def gFm : Ex HS := eSub (pr 0) (.lit 1)

/-- **The compact header on the row background** (reads `G` from register `46`). -/
def hdrG : List (Fin HS × Ex HS) :=
  [(kRR, .pow2 (.reg 46)), (kN, gFm), (kQC, .pow2 (.mul gFm (.reg 46))),
   (kSX, .mul (.pow2 (eSRe (pr 8))) (pr 4)), (kSY, .mul (.pow2 (eSRe (pr 9))) (pr 4)),
   (kM, .mul (.mul (pr 5) (.pow2 (pr 3))) (pr 4)),
