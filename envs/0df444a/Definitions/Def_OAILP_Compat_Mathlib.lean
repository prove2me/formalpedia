-- Definitions bundle OAILP_Compat_Mathlib
-- Generated by skeleton subtraction from P2MCompat/Mathlib.lean of the Lean 4.33.1 / Mathlib 0df444a
-- backport of OpenAI's formalization (github.com/openai/math, commit 3344da59991ed94f9ba711217b29c1d760badfa6),
-- Apache-2.0. Declarations and proofs are OpenAI's (Hex libraries: Lean FRO, Apache-2.0).
import Batteries.Tactic.Alias
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.Order.BigOperators.Group.List
import Mathlib.Algebra.Order.BigOperators.GroupWithZero.Finset
import Mathlib.Data.List.Dedup

/-!
# Compatibility shims: Mathlib d13f23b → 0df444a

Lemma names that OpenAI's development (written against Mathlib d13f23b) uses but that
Mathlib 0df444a does not have yet. Each restates the newer Mathlib lemma under its new
name, proved by the 0df444a lemma it was renamed from.

(The newer Mathlib also renamed `Finset.prod_le_prod'` to `Finset.prod_le_prod`, reusing
the name of the lemma now called `Finset.prod_le_prod₀`; call sites of the new
`Finset.prod_le_prod` are rewritten to `Finset.prod_le_prod'` in the proofs instead.)
-/

namespace Finset

/-- Mathlib d13f23b's `Finset.prod_le_prod₀` (0df444a: `Finset.prod_le_prod`). -/
alias prod_le_prod₀ := prod_le_prod

/-- Mathlib d13f23b's `Finset.single_le_prod` (0df444a: `Finset.single_le_prod'`). -/
alias single_le_prod := single_le_prod'

end Finset

namespace List

/-- Mathlib d13f23b's `List.sum_le_length_nsmul` (0df444a: `List.sum_le_card_nsmul`). -/
alias sum_le_length_nsmul := sum_le_card_nsmul

/-- Mathlib d13f23b's `List.nodup_iff_length_dedup_eq`. -/
theorem nodup_iff_length_dedup_eq {α : Type*} [DecidableEq α] {l : List α} :
    l.Nodup ↔ l.dedup.length = l.length := by
  rw [← dedup_eq_self, l.dedup_sublist.length_eq]

end List


