/-! `toCircle` is an injective group homomorphism from the order isomorphisms of `[0,1]`. -/

namespace CannonFloydParry.S5

lemma icoPerm_mul (f g : UI ≃o UI) : icoPerm (f * g) = icoPerm f * icoPerm g := by
  ext x; rfl

lemma toCircle_mul (f g : UI ≃o UI) : toCircle (f * g) = toCircle f * toCircle g := by
  ext x
  simp only [toCircle, Equiv.Perm.coe_mul, Function.comp_apply, Equiv.trans_apply,
    Equiv.apply_symm_apply, icoPerm_mul]

lemma toCircle_one : toCircle 1 = 1 := by
  ext x
  simp only [toCircle, Equiv.trans_apply, Equiv.Perm.coe_one, id]
  have : icoPerm (1 : UI ≃o UI) = 1 := by ext y; rfl
  rw [this, Equiv.Perm.coe_one, id, Equiv.symm_apply_apply]

/-- `toCircle` as a group homomorphism. -/
noncomputable def toCircleHom : (UI ≃o UI) →* Equiv.Perm UnitAddCircle where
  toFun := toCircle
  map_one' := toCircle_one
  map_mul' := toCircle_mul

@[simp] lemma toCircleHom_apply (f : UI ≃o UI) : toCircleHom f = toCircle f := rfl

lemma icoPerm_apply_val (f : UI ≃o UI) (x : Set.Ico (0 : ℝ) (0 + 1)) :
    ((icoPerm f x : Set.Ico (0 : ℝ) (0 + 1)) : ℝ) = f ⟨x, x.2.1, by linarith [x.2.2]⟩ := rfl

lemma toCircle_injective : Function.Injective toCircle := by
  intro f g h
  have hico : icoPerm f = icoPerm g := by
    ext x
    have := congrArg (fun φ : Equiv.Perm UnitAddCircle =>
      AddCircle.equivIco (1 : ℝ) 0 (φ ((AddCircle.equivIco (1 : ℝ) 0).symm x))) h
    simpa [toCircle] using congrArg Subtype.val this
  ext z
  by_cases hz : (z : ℝ) < 1
  · have := congrArg (fun φ : Equiv.Perm (Set.Ico (0 : ℝ) (0 + 1)) =>
      ((φ ⟨z, z.2.1, by simpa using hz⟩ : Set.Ico (0 : ℝ) (0 + 1)) : ℝ)) hico
    simpa [icoPerm_apply_val] using this
  · have hz1 : z = ⟨1, one_mem_UI⟩ := Subtype.ext (le_antisymm z.2.2 (not_lt.1 hz))
    rw [hz1, orderIso_one, orderIso_one]

end CannonFloydParry.S5

/-! Lemma 5.4: the subgroup of `T₁` generated by `A`, `B` is isomorphic to `F`. -/

namespace CannonFloydParry.S5

local notation "a" => (PresentedGroup.of FormalABC.A : T1)
local notation "b" => (PresentedGroup.of FormalABC.B : T1)

theorem exists_mulEquiv_closure_A_B_F' :
    ∃ e : Subgroup.closure
        {(PresentedGroup.of FormalABC.A : T1), PresentedGroup.of FormalABC.B} ≃* F,
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.A, h⟩ : F) : UI ≃o UI) = mapA) ∧
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.B, h⟩ : F) : UI ≃o UI) = mapB) := by
  obtain ⟨e34, he34A, he34B⟩ := exists_mulEquiv_F1_F
  obtain ⟨φ, -, hφ⟩ := exists_surjective_T1_T
  let ψ : F →* T1 := fromF1.comp e34.symm.toMonoidHom
  have hcomp : T.subtype.comp (φ.comp fromF1) = toCircleHom.comp (F.subtype.comp e34.toMonoidHom) := by
    apply PresentedGroup.ext
    intro s
    cases s
    · simp [hφ, symT, he34A]
    · simp [hφ, symT, he34B]
  have key : ∀ x : F, ((φ (ψ x) : T) : Equiv.Perm UnitAddCircle) = toCircle (x : UI ≃o UI) := by
    intro x
    have := DFunLike.congr_fun hcomp (e34.symm x)
    simpa [ψ] using this
  have hinj : Function.Injective ψ := by
    intro x y hxy
    have := congrArg (fun t => ((φ t : T) : Equiv.Perm UnitAddCircle)) hxy
    simp only [key] at this
    exact Subtype.ext (toCircle_injective this)
  have hrange : ψ.range = Subgroup.closure {a, b} := by
    have h1 : ψ.range = fromF1.range := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.2 e34.symm.surjective, ← MonoidHom.range_eq_map]
    rw [h1, MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of, MonoidHom.map_closure]
    congr 1
    ext t
    constructor
    · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
      cases s <;> simp
    · rintro (rfl | rfl)
      · exact ⟨_, ⟨FormalAB.A, rfl⟩, fromF1_A⟩
      · exact ⟨_, ⟨FormalAB.B, rfl⟩, fromF1_B⟩
  let E : F ≃* Subgroup.closure {a, b} :=
    (MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr hrange)
  have hE : ∀ (s : FormalAB) (h), E (e34 (PresentedGroup.of s)) = ⟨fromF1 (PresentedGroup.of s), h⟩ := by
    intro s h
    apply Subtype.ext
    show ((MonoidHom.ofInjective hinj (e34 (PresentedGroup.of s)) : ψ.range) : T1) = _
    rw [MonoidHom.ofInjective_apply]
    simp [ψ]
  refine ⟨E.symm, fun h => ?_, fun h => ?_⟩
  · have h' : fromF1 (PresentedGroup.of FormalAB.A) ∈ Subgroup.closure {a, b} := by
      rw [fromF1_A]; exact h
    have h2 : E (e34 (PresentedGroup.of FormalAB.A)) = ⟨a, h⟩ :=
      (hE FormalAB.A h').trans (Subtype.ext fromF1_A)
    rw [← h2, MulEquiv.symm_apply_apply]
    exact he34A
  · have h' : fromF1 (PresentedGroup.of FormalAB.B) ∈ Subgroup.closure {a, b} := by
      rw [fromF1_B]; exact h
    have h2 : E (e34 (PresentedGroup.of FormalAB.B)) = ⟨b, h⟩ :=
      (hE FormalAB.B h').trans (Subtype.ext fromF1_B)
    rw [← h2, MulEquiv.symm_apply_apply]
    exact he34B

end CannonFloydParry.S5

open CannonFloydParry

theorem solution :
    ∃ e : Subgroup.closure
        {(PresentedGroup.of FormalABC.A : T1), PresentedGroup.of FormalABC.B} ≃* F,
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.A, h⟩ : F) : UI ≃o UI) = mapA) ∧
      (∀ h, ((e ⟨PresentedGroup.of FormalABC.B, h⟩ : F) : UI ≃o UI) = mapB) :=
  CannonFloydParry.S5.exists_mulEquiv_closure_A_B_F'
