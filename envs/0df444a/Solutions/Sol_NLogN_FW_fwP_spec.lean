    (bflyB F E j A B).length = A.length
  | _, [], [], _ => rfl
  | j, u :: A, v :: B, h => by
    simp only [bflyB, List.length_cons, add_left_inj] at h ⊢; exact length_bflyB F E (j + 1) A B h
