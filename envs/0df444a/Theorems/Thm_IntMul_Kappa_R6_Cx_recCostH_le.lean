theorem IntMul.Kappa.R6.Cx.recCostH_le (J : Prop8IfaceH W T m h) {Lloc : ℝ} (hL : 0 ≤ Lloc) {σ : ℝ}
    (hm : 2 ≤ m) (hσ0 : 0 < σ) (hσ1 : σ ≤ 1) (hw : ∀ p ∈ h, 0 < p.1 ∧ p.1 < m)
    (hmom : histMoment h m σ < W) :
    ∃ K : ℝ, ∀ (e : ℕ) (V : ℝ), 0 ≤ V → recCostH J Lloc e V ≤ K * V * (e : ℝ) ^ σ := by sorry
