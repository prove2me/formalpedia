/-- The six separations needed by the directed isomorphism theorem follow
from the two cross exclusions. No finiteness, generation or nonzero h is needed. -/
theorem p2m_local_abelianSixSeparations_of_double_ne
    (a d h : G) (hhalf : h + h = 0)
    (h2zero : d + d ≠ 0) (h2half : d + d ≠ h) :
    a ≠ a + d ∧ a ≠ (a + d) + h ∧
      a ≠ a - d ∧ a ≠ (a - d) + h ∧
      a + d ≠ a - d ∧ a + d ≠ (a - d) + h := by
  have hd0 : d ≠ 0 := by
    intro he
    apply h2zero
    simp [he]
  have hdh : d ≠ h := by
    intro he
    apply h2zero
    simpa only [he] using hhalf
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro he
    apply hd0
    calc
      d = (a + d) - a := by abel
      _ = 0 := by rw [← he]; simp
  · intro he
    apply hdh
    calc
      d = d + (h + h) := by simp [hhalf]
      _ = (((a + d) + h) - a) + h := by abel
      _ = h := by rw [← he]; simp
  · intro he
    apply hd0
    calc
      d = a - (a - d) := by abel
      _ = 0 := by rw [← he]; simp
  · intro he
    apply hdh
    calc
      d = (a - ((a - d) + h)) + h := by abel
      _ = h := by rw [← he]; simp
  · intro he
    apply h2zero
    calc
      d + d = (a + d) - (a - d) := by abel
      _ = 0 := by rw [he]; simp
  · intro he
    apply h2half
    calc
      d + d = ((a + d) - ((a - d) + h)) + h := by abel
      _ = h := by rw [he]; simp





























