  simp only [ht4, ht2, ht, NLogN.FW.mpSt, NLogN.withCtr]
  rw [NLogN.FW.take_succ_get Z k hk', List.reverse_append]
  simp only [List.reverse_singleton, NLogN.FW.gints_append, NLogN.gints_cons, NLogN.gints_nil]
  ((apply NLogN.IState.ext' <;> intros <;> simp (config := {decide := true}) only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.withCtr] <;> split_ifs <;> simp_all (config := {decide := true})))
