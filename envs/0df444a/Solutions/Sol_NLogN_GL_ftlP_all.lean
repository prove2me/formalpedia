    (hAl : A.length = T) (hN : s.G gPN = .int T :: LN)
    (hT : s.G gPT = .int (2 ^ (q.p + q.logT)) :: LT) (hPre : PreW U A)
    (hWl : (fermatW q U A).length = T) (hWb : GB Q (fermatW q U A)) (hUb : GB Q U)
    (hAb : GB Q A) (hk : q.p + q.logT + 1 ≤ Q) (hNQ : zsz ((2 * T : ℕ) : ℤ) ≤ Q) :
    (convP fw).run s = (s.upd gZA R1).upd gD (gints (convL q U A) ++ R) ∧
    (convP fw).ok M s ∧
