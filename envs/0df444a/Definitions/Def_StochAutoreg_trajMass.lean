-- title:
--   Trajectory probability $P_g^M(z\mid x)$
-- statement:
--   Given a generator $g$, a prompt $x\in\Sigma^\star$ and $M\in\mathbb N$, the $M$-step stochastic chain of thought $Z_1,\dots,Z_M$ is generated by $Z_1\sim g(x)$ and $Z_t\mid Z_1,\dots,Z_{t-1}\sim g(xZ_1\cdots Z_{t-1})$. Its probability at $z=(z_1,\dots,z_M)$ is
--
--   $$P_g^M(z\mid x)=\prod_{t=1}^M \mathrm{Bern}\bigl(p_g(xz_1\cdots z_{t-1})\bigr)(z_t).$$
--
--   **Formalization Note** The index is $0$-based: the paper's $Z_t$ is `z ⟨t-1, _⟩`. The state grows on the right, as `x ++ prefix`.
-- source:
--   Doron-Arad–Mehalel–Mossel, Stochastic Autoregressive Learning, arXiv:2608.07224, §1.1, p.2; §2, p.7

import Mathlib
import Definitions.Def_StochAutoreg_Generator
import Definitions.Def_StochAutoreg_bernMass

namespace StochAutoreg

/-- The probability `P_g^M(z | x)` that the `M`-step stochastic chain of thought of `g` from the prompt
`x` equals `z`: `Z₁ ∼ g(x)` and `Z_t | Z₁, …, Z_{t-1} ∼ g(x Z₁ ⋯ Z_{t-1})`.
Doron-Arad–Mehalel–Mossel, *Stochastic Autoregressive Learning*, arXiv:2608.07224, §1.1, p.2, and §2, p.7.

**Formalization Note.** `z : Fin M → Bool` is 0-based: the paper's `Z_t` is `z ⟨t-1, _⟩`. The state
grows on the right: `(List.ofFn z).take t` is the prefix of the first `t` generated tokens, and the
factor at `t : Fin M` is the law of the token generated from `x ++ prefix`. -/
noncomputable def trajMass (g : Generator) (M : ℕ) (x : List Bool) (z : Fin M → Bool) : ℝ :=
  ∏ t : Fin M, bernMass (g (x ++ (List.ofFn z).take t)) (z t)

end StochAutoreg


