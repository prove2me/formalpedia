section

variable (t : GL (Fin 3) ℚ) (v : HeightOneSpectrum (𝓞 ℚ))

private theorem isRightInvariant_transported
    {U : Subgroup (LocalGL3 v)} {W : LocalGL3 v → ℂ} (hW : IsRightInvariant U W) :
    IsRightInvariant U (transported t W) :=
  isRightInvariant_comp_mul_left hW (localTorus t v)

private theorem isCosetEigenfunction_transported
    {U : Subgroup (LocalGL3 v)} {gen : LocalGL3 v} {W : LocalGL3 v → ℂ} {lam : ℂ}
    (hW : IsCosetEigenfunction U gen W lam) : IsCosetEigenfunction U gen (transported t W) lam :=
  isCosetEigenfunction_comp_mul_left hW (localTorus t v)

private theorem centralGen_coe_eq_diagonal : (centralGen v : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
    Matrix.diagonal ![varpi v, varpi v, varpi v] := by
  simp [centralGen]

private theorem localTorus_mul_centralGen
    {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) :
    localTorus t v * centralGen v = centralGen v * localTorus t v := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, centralGen_coe_eq_diagonal, coe_localTorus t v ht, Matrix.diagonal_mul_diagonal,
    Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  fin_cases i <;> simp [mul_comm]

private theorem mul_self_eq_one_of_sq_eq_one
    {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (ha : a ^ 2 = 1) : t * t = 1 := by
  apply Units.ext
  rw [Units.val_mul, ht, Matrix.diagonal_mul_diagonal, Units.val_one]
  rw [← Matrix.diagonal_one]
  congr 1
  funext i
  fin_cases i <;> simp [← pow_two, ha]

private theorem localTorus_mul_self {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (ha : a ^ 2 = 1) : localTorus t v * localTorus t v = 1 := by
  rw [localTorus, ← map_mul, mul_self_eq_one_of_sq_eq_one t ht ha, map_one]

private theorem transported_apply_localTorus_mul
    {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (ha : a ^ 2 = 1) (W : LocalGL3 v → ℂ) (g : LocalGL3 v) : transported t W (localTorus t v * g) = W g := by
  rw [transported_apply, ← mul_assoc, localTorus_mul_self t v ht ha, one_mul]

private theorem transported_centralGen_mul
    {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    {W : LocalGL3 v → ℂ} {e : ℂ} (hW : ∀ g : LocalGL3 v, W (centralGen v * g) = e * W g) (g : LocalGL3 v) :
    transported t W (centralGen v * g) = e * transported t W g := by
  rw [transported_apply, transported_apply, ← mul_assoc, localTorus_mul_centralGen t v ht, mul_assoc, hW]

end
