namespace InfoLossLAR.WorstCase
open QAlgorithms.Complexity

/-- The exact padded input/zero-ancilla basis of one length-specific D circuit. -/
def familyInputBits (D : Family) (query : Str) (length : ℕ) : Bits (length+(D.anc length+1)) :=
  fun index => if index.val < length then (query[index.val]?).getD false else false



def indexedQueryBlocks (D : Family) (query : Str) (lengths : List ℕ) : List _root_.InfoLossLAR.WorstCase.QuantumBlock :=
  lengths.map (fun length => _root_.InfoLossLAR.WorstCase.familyBlock D length (fun index => (query[index.val]?).getD false))

/-- The true concatenated D input bits, expressed without finite-index casts. -/
def bundleNaturalBits (D : Family) (query : Str) : List ℕ → ℕ → Bool
  | [],_ => false
  | length::rest,index =>
    if index < length+(D.anc length+1) then
      if index < length then (query[index]?).getD false else false
    else bundleNaturalBits D query rest (index-(length+(D.anc length+1)))







/-- Value read at a D-loader destination, with false outside its finite list. -/
def sourceValueAt (sources : List (Bool × ℕ)) (state : ℕ → Bool) (index : ℕ) : Bool :=
  ((sources[index]?).map (fun source => _root_.InfoLossLAR.WorstCase.registerLoadValue source state)).getD false







def lengthDescriptions (D : Family) (lengths : List ℕ) : List (Str × Str) :=
  lengths.map (fun length => (unary length,encFamilyAt D length))





end InfoLossLAR.WorstCase

end

