    (r1 : (NLogN.KIL.encK s f).G NLogN.KIL.pX = .int (X : ℤ) :: L1) (r2 : (NLogN.KIL.encK s f).G NLogN.KIL.pB = .int ((F * Y : ℕ) : ℤ) :: L2)
    (r3 : (NLogN.KIL.encK s f).G NLogN.KIL.pZ = .int (((F' - F) * Y : ℕ) : ℤ) :: L3)
    (r4 : (NLogN.KIL.encK s f).G NLogN.KIL.pT = .int ((X * (F' * Y) : ℕ) : ℤ) :: L4) :
    NLogN.KFD.FSp NLogN.KIL.padP (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (NLogN.KIL.padL X F F' Y 0 xs ++ rest)))
      (NLogN.KFE.cPadF (X * (F' * Y)) Bb) := by
  set V := X * (F' * Y)
  set bl := NLogN.zsz ((F' * Y : ℕ) : ℤ)
  have hle : ∀ x : ℕ, x ≤ V → NLogN.zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (NLogN.KIL.zsz_nat_le hx) hV
  have hFY : F * Y ≤ F' * Y := Nat.mul_le_mul_right _ hF
  have hXV : X ≤ V := Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega))
  have hreg : ∀ k, ∀ r : Fin NLogN.HS, r ≠ 0 → r ≠ 15 → r ≠ 20 → r ≠ 21 →
      (NLogN.KIL.encK s (Function.update (NLogN.KIL.padF f X F F' Y xs rest k) 20 [(X : ℤ) - k])).G r = (NLogN.KIL.encK s f).G r := by
    intro k r a b c _
    simp [NLogN.KIL.padF, Function.update_apply, a, b, c]
  have F0 : NLogN.KIL.padF f X F F' Y xs rest 0 = f := by
    funext j
    simp only [NLogN.KIL.padF, Function.update_apply, Nat.zero_mul, List.drop_zero, NLogN.KIL.padL, List.range_zero,
      List.flatMap_nil, List.reverse_nil]
    split_ifs with h1 h2 <;> (try subst h1) <;> (try subst h2) <;> simp_all
  have H := NLogN.KFD.FSp.repReg (C := 20) (r := NLogN.KIL.pX) (s := s) (F := NLogN.KIL.padF f X F F' Y xs rest) (N := X)
    (Bb := Bb) (c := NLogN.KFD.cLp (F * Y) (250 * (1 + 2)) bl + NLogN.KFD.cLp ((F' - F) * Y) 8000 bl)
    (b := .seq (NLogN.mvK 0 15 21 (.reg NLogN.KIL.pB)) (NLogN.KIL.zeroKE 15 21 (.reg NLogN.KIL.pZ))) (by decide) (by decide)
    (fun k => by simp [NLogN.KIL.padF, Function.update_apply, h20])
    (by simp +decide [NLogN.RS.writes, NLogN.mvK, NLogN.KIL.zeroKE]) (L := L1)
    (by rw [F0]; exact r1) (hle _ hXV) ?_
  rotate_left
  · intro k hk
    set g := Function.update (NLogN.KIL.padF f X F F' Y xs rest k) 20 [(X : ℤ) - k]
    have hblk : xs.drop (k * (F * Y)) = (xs.drop (k * (F * Y))).take (F * Y) ++
        xs.drop ((k + 1) * (F * Y)) := by
      rw [Nat.succ_mul, ← List.drop_drop, List.take_append_drop]
    have hlenb : ((xs.drop (k * (F * Y))).take (F * Y)).length = F * Y :=
      NLogN.KIL.length_take_drop_blk (le_of_eq hxs.symm) hk
    have M := NLogN.KFD.FSp.mvR (X := 0) (Y := 15) (C := 21) (r := NLogN.KIL.pB) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) s g ((xs.drop (k * (F * Y))).take (F * Y))
      (xs.drop ((k + 1) * (F * Y)) ++ rest)
      (by simp only [g, NLogN.KIL.padF, Function.update_apply]; simp +decide; rw [← List.append_assoc, ← hblk])
      (Lr := L2) (by rw [hlenb, hreg k NLogN.KIL.pB (by decide) (by decide) (by decide) (by decide), r2]) 1 bl
      (fun a ha => hb a (List.mem_of_mem_drop (List.mem_of_mem_take ha)))
      (by rw [hlenb]; exact NLogN.KIL.zsz_nat_le hFY)
    rw [hlenb] at M
    set g1 := Function.update (Function.update g 0 (xs.drop ((k + 1) * (F * Y)) ++ rest)) 15
      (((xs.drop (k * (F * Y))).take (F * Y)).reverse ++ g 15)
    have Z := NLogN.KFE.FSp.zeroR (Y := 15) (C := 21) (r := NLogN.KIL.pZ) (by decide) (by decide) (by decide) (by decide)
      s g1 ((F' - F) * Y) (by simp +decide [g1, g, NLogN.KIL.padF, h21]) (Lr := L3)
      (by
        have : (NLogN.KIL.encK s g1).G NLogN.KIL.pZ = (NLogN.KIL.encK s f).G pZ := by
          simp +decide [g1, g, NLogN.KIL.padF, Function.update_apply]
        rw [this, r3]) bl
      (NLogN.KIL.zsz_nat_le (Nat.mul_le_mul_right _ (Nat.sub_le _ _)))
    refine (M.seq Z).congr ?_
    congr 1
    funext j
    simp only [g1, g, NLogN.KIL.padF, Function.update_apply]
    by_cases e15 : j = 15
    · subst e15; simp +decide [NLogN.KIL.padL_succ]
    by_cases e0 : j = 0
    · subst e0; simp +decide
    simp [e15, e0]
  · -- after the loop: move back
    have FX : NLogN.KIL.padF f X F F' Y xs rest X 15 = (NLogN.KIL.padL X F F' Y 0 xs).reverse := by simp [NLogN.KIL.padF]
    have hlp : (NLogN.KIL.padL X F F' Y 0 xs).length = V := NLogN.KIL.length_padL hF 0 (le_of_eq hxs.symm)
    have M := NLogN.KFD.FSp.mvR (X := 15) (Y := 0) (C := 21) (r := NLogN.KIL.pT) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) s (NLogN.KIL.padF f X F F' Y xs rest X)
      (NLogN.KIL.padL X F F' Y 0 xs).reverse [] (by rw [FX, List.append_nil]) (Lr := L4)
      (by
        rw [List.length_reverse, hlp]
        have : (NLogN.KIL.encK s (NLogN.KIL.padF f X F F' Y xs rest X)).G NLogN.KIL.pT = (NLogN.KIL.encK s f).G pT := by
          simp +decide [NLogN.KIL.padF, Function.update_apply]
        rw [this, r4])
      1 Bb (NLogN.KIL.bnd_reverse (NLogN.KIL.bnd_padL hb)) (by rw [List.length_reverse, hlp]; exact hle _ le_rfl)
    rw [F0] at H
    refine ((H.seq M).mono ?_).congr ?_
    · rw [List.length_reverse, hlp]
      have h1 : X * (F * Y) + X * ((F' - F) * Y) = V := by
        rw [← Nat.mul_add, ← Nat.add_mul, Nat.add_sub_cancel' hF]
      refine NLogN.KFE.cPadF_bound h1 hXV bl ?_ V le_rfl
      rw [← Nat.add_mul, Nat.add_sub_cancel' hF]; exact NLogN.KFE.zsz_le_self _
    · congr 1
      funext j
      simp only [NLogN.KIL.padF, Function.update_apply]
      have hd : xs.drop (X * (F * Y)) = [] := List.drop_eq_nil_of_le (by omega)
      by_cases e15 : j = 15
      · subst e15; simp +decide [h15]
      by_cases e0 : j = 0
      · subst e0; simp +decide [hd]
      simp [e15, e0]
end
