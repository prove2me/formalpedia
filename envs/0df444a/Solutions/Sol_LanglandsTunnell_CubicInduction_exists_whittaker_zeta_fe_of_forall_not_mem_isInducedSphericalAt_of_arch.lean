namespace ShellSum
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField MeasureTheory
open scoped NNReal

variable (v : HeightOneSpectrum (𝓞 ℚ))

private def shell (n : ℤ) : Set (v.adicCompletion ℚ)ˣ :=
  {t | Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n)}

variable {v}

private theorem mem_shell {n : ℤ} {t : (v.adicCompletion ℚ)ˣ} :
    t ∈ shell v n ↔ Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) :=
  Iff.rfl

private theorem mem_shell_zero
    {t : (v.adicCompletion ℚ)ˣ} : t ∈ shell v 0 ↔ Valued.v (t : v.adicCompletion ℚ) = 1 := by
  rw [mem_shell, neg_zero, WithZero.exp_zero]

variable (v)

private theorem shell_disjoint : Pairwise (Function.onFun Disjoint (shell v)) := by
  intro m n hmn
  show Disjoint (shell v m) (shell v n)
  rw [Set.disjoint_left]
  intro t hm hn
  rw [mem_shell] at hm hn
  exact hmn (neg_inj.mp (WithZero.exp_inj.mp (hm.symm.trans hn)))

private theorem iUnion_shell : ⋃ n : ℤ, shell v n = Set.univ := by
  refine Set.eq_univ_of_forall fun t => Set.mem_iUnion.mpr ⟨-WithZero.log (Valued.v (t : v.adicCompletion ℚ)), ?_⟩
  rw [mem_shell, neg_neg]
  exact (WithZero.exp_log ((Valuation.ne_zero_iff _).mpr t.ne_zero)).symm

section

variable {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} (μ : Measure (v.adicCompletion ℚ)ˣ)

private theorem shell_eq_preimage {ϖ : (v.adicCompletion ℚ)ˣ}
    (hϖ : Valued.v (ϖ : v.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) (n : ℤ) :
    shell v n = (fun t => ϖ ^ (-n) * t) ⁻¹' shell v 0 := by
  have hϖn : Valued.v ((ϖ ^ (-n) : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = WithZero.exp n := by
    rw [Units.val_zpow_eq_zpow_val, map_zpow₀, hϖ, ← WithZero.exp_zsmul]
    congr 1
    simp
  ext t
  simp only [Set.mem_preimage, mem_shell, Units.val_mul, map_mul, hϖn, neg_zero, WithZero.exp_zero]
  constructor
  · intro h
    rw [h, ← WithZero.exp_add]
    simp
  · intro h
    rw [eq_inv_of_mul_eq_one_right h, ← WithZero.exp_neg]

private theorem measure_shell_eq
    [MeasurableMul (v.adicCompletion ℚ)ˣ] [μ.IsMulLeftInvariant] {ϖ : (v.adicCompletion ℚ)ˣ}
    (hϖ : Valued.v (ϖ : v.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) (n : ℤ) : μ (shell v n) = μ (shell v 0) := by
  rw [shell_eq_preimage v hϖ n, measure_preimage_mul]

private theorem integral_mul_mul_modulus_cpow_eq_tsum (hmeas : ∀ n : ℤ, MeasurableSet (shell v n))
    (hμ : ∀ n : ℤ, μ (shell v n) = 1) (φ : (v.adicCompletion ℚ)ˣ → ℂ) (τ : ℤ → ℂ)
    (hφ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → φ t = τ n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ)
    (hint : Integrable (fun a : (v.adicCompletion ℚ)ˣ =>
      φ a * ((χv a : ℂˣ) : ℂ) * ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) μ) :
    ∫ a : (v.adicCompletion ℚ)ˣ,
        φ a * ((χv a : ℂˣ) : ℂ) * ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1) ∂μ =
      ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) := by
  rw [← setIntegral_univ, ← iUnion_shell v, integral_iUnion hmeas (shell_disjoint v) hint.integrableOn]
  refine tsum_congr fun n => ?_
  rw [setIntegral_congr_fun (hmeas n)
      (g := fun _ => τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1))
      fun t ht => ?_, setIntegral_const, measureReal_def, hμ n]
  · simp
  · rw [mem_shell] at ht
    simp only [hφ t n ht, hχ t n ht, hmod t n ht]

private theorem localZeta30_one_eq_tsum (hmeas : ∀ n : ℤ, MeasurableSet (shell v n)) (hμ : ∀ n : ℤ, μ (shell v n) = 1)
    (W : LocalGL3 v → ℂ) (τ : ℤ → ℂ)
    (hW : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      W (iotaGL (diagUnitGL2 t)) = τ n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ)
    (hint : Integrable (fun a : (v.adicCompletion ℚ)ˣ =>
      W (iotaGL (diagUnitGL2 a) * 1) * ((χv a : ℂˣ) : ℂ) *
        ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) μ) :
    localZeta30 v μ W χv s 1 =
      ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) := by
  unfold localZeta30
  exact integral_mul_mul_modulus_cpow_eq_tsum v μ hmeas hμ (fun a => W (iotaGL (diagUnitGL2 a) * 1)) τ
    (fun t n ht => by simp only [mul_one]; exact hW t n ht) χv u hχ hmod s hint

private theorem localZeta30_one_eq_tsum_of_isMulLeftInvariant
    [MeasurableMul (v.adicCompletion ℚ)ˣ] [μ.IsMulLeftInvariant]
    (hmeas : ∀ n : ℤ, MeasurableSet (shell v n))
    {ϖ : (v.adicCompletion ℚ)ˣ} (hϖ : Valued.v (ϖ : v.adicCompletion ℚ) = WithZero.exp (-1 : ℤ))
    (hμ0 : μ (shell v 0) = 1) (W : LocalGL3 v → ℂ) (τ : ℤ → ℂ)
    (hW : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      W (iotaGL (diagUnitGL2 t)) = τ n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ)
    (hint : Integrable (fun a : (v.adicCompletion ℚ)ˣ =>
      W (iotaGL (diagUnitGL2 a) * 1) * ((χv a : ℂˣ) : ℂ) *
        ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) μ) :
    localZeta30 v μ W χv s 1 =
      ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) :=
  localZeta30_one_eq_tsum v μ hmeas (fun n => (measure_shell_eq v μ hϖ n).trans hμ0) W τ hW χv u hχ hmod s hint

end
