-- Source module: Solutions.KFMBig0
/-!
# KFM Big0: the run-time parameters of `bigE`

From the registers of `setupSt` (and `n` on `zN`, `b` on `zB`) the RS programs below push the
parameters of the main computation, one on each of the stacks `6–19` (`KFMHT`):

| reg | value | | reg | value |
|---|---|---|---|---|
| `rS` | `S = ∏ s_i` | | `rB2` | `2^b` |
| `rT` | `T = 2^L` | | `rZ` | `2(S − M)` |
| `rT2` | `2T` | | `rH` | `2^{p−1}` |
| `rM` | `M = ⌈n/b⌉` | | `rF` | `2^{2b+4}` |
| `rP2` | `2^p` | | `rPw` | `p + 2` (the `Φ` bound `w`) |
| `rG` | `2^γ`, `γ = 2dα²` | | `rOne` | `1` |
| `rE2` | `2^{p−b−2}` | | | |

`S` is the product loop of KFMS7 (`prodLoop_run`) modulo `2^b`.
`2^{2n}` (`rO`) is made in IL from the input (`KFMBig1`).

* **`parS_run`**, **`parQ_run`**: run lemmas.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue RS

/-! ## RS chaining helpers -/

/-! ## The product `S` -/

/-! ## The other parameters -/

theorem QRegs.upd {t : IState HS} {n S : ℕ} (h : QRegs t n S) (j : Fin HS)
    (hj : j ≠ zL ∧ j ≠ zN ∧ j ≠ zB ∧ j ≠ zD ∧ j ≠ zAl ∧ j ≠ rS) (L : List Item) :
    QRegs (t.upd j L) n S :=
  ⟨h.hL.upd j hj.1 L, h.hN.upd j hj.2.1 L, h.hB.upd j hj.2.2.1 L, h.hD.upd j hj.2.2.2.1 L,
    h.hA.upd j hj.2.2.2.2.1 L, h.hS.upd j hj.2.2.2.2.2 L⟩

theorem Hold.top {t : IState HS} {r : Fin HS} {a : ℤ} (h : Hold t r a) : t.top r = a := by
  obtain ⟨L, hL⟩ := h; exact IState.top_eq hL

end NLogN.KFM

