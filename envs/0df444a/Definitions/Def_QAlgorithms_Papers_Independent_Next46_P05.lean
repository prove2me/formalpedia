section LieStatements

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

end LieStatements

section AdditionalDefinitions

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Fixed Lie algebra with the ambient bracket, notation p. 4. -/
def fixedLie (tau : G ≃ₗ⁅ℝ⁆ G) : LieSubalgebra ℝ G where
  carrier := {x | tau x = x}
  zero_mem' := by simp
  add_mem' := by intro x y hx hy; simp_all
  smul_mem' := by intro t x hx; simp_all
  lie_mem' := by intro x y hx hy; change tau ⁅x, y⁆ = ⁅x, y⁆; rw [tau.map_lie, hx, hy]

/-- H-element in the chosen Cartan decomposition, pp. 5, 8–9. -/
def CartanHElement (theta : G ≃ₗ⁅ℝ⁆ G) (H0 : G) : Prop :=
  theta H0 = H0 ∧ (∀ x ∈ autoSpace theta 1, ⁅H0, x⁆ = 0) ∧
    (LieAlgebra.ad ℝ G H0).IsSemisimple ∧
    complexSpectrum (LieAlgebra.ad ℝ G H0) = {0, Complex.I, -Complex.I}

/-- The smallest invariant proper cone containing the specified H-element, pp. 5–6.
The family is nonempty on H-elements in hermitian simple algebras. -/
def minimalConeAt (H0 : G) : Set G :=
  ⋂₀ {C : Set G | GeneratingInvariantCone C ∧ H0 ∈ C}

/-- Product, unit, and scalar product of Example 2.23, p. 12.
For eigenvalue d=2 the triple is (h,e,y); for d=1 it is (2h,e,y).
The Jordan operations are pinned to this chosen triple, rather than left unrelated. -/
def KKTModel (theta : G ≃ₗ⁅ℝ⁆ G) (h : G) (d : ℝ)
    (J : EuclideanJordan (adSpace h d)) : Prop :=
  ∃ y : G, theta h = -h ∧ theta (J.unit : G) = -y ∧ theta y = -(J.unit : G) ∧
    ⁅h, y⁆ = -d • y ∧ ⁅(J.unit : G), y⁆ = (2 / d : ℝ) • h ∧
    (∀ a b : adSpace h d,
      (J.product a b : G) = (1 / 2 : ℝ) • ⁅⁅(a : G), y⁆, (b : G)⁆) ∧
    ∀ a b : adSpace h d, J.scalar a b = -killingForm ℝ G (a : G) (theta (b : G))

/-- The complete full-rank tube-subalgebra properties of Corollary 3.20, p. 28. -/
def FullRankTube (tau theta : G ≃ₗ⁅ℝ⁆ G) (h : G) : Prop :=
  tau h = h ∧ theta h = -h ∧ Hyperbolic h ∧
    complexSpectrum (LieAlgebra.ad ℝ G h) ⊆ fiveSpectrum ∧
    HermitianSimple (G := tubeAlgebra h) ∧ RestrictedTubeType (G := tubeAlgebra h) ∧
    DirectThree (tubeAlgebra h).toSubmodule (adSpace h (-1))
      (bracketSpan (adSpace h (-1)) (adSpace h 1)) (adSpace h 1) ∧
    realRank (G := G) = realRank (G := tubeAlgebra h) ∧
    (RestrictedTubeType (G := G) → tubeAlgebra h = ⊤)

/-- The five-term diagonal grading; distinct real eigenvalues make the summands independent,
Lemma 3.24, p. 29. No nonzero half-eigenspace is silently required. -/
def FiveGrading (h : G) : Prop :=
  (adSpace h (-1) ⊔ adSpace h (-(1 / 2)) ⊔ adSpace h 0 ⊔
    adSpace h (1 / 2) ⊔ adSpace h 1) = ⊤

/-- The chosen normalized Cartan basis in Section 3.1, p. 19. -/
structure CayleyCoordinates (Wmin : Set G) (tau theta : G ≃ₗ⁅ℝ⁆ G) where
  rank : ℕ
  positive_rank : 0 < rank
  A : Submodule ℝ G
  basis : Module.Basis (Fin rank) ℝ A
  maximal : MaximalAbelianIn A (autoSpace theta (-1))
  roots : {a | RestrictedRoot A a} = rootsC basis
  fixed : ∀ x ∈ A, tau x = x
  sign_rule : ∀ x : G, tau x = gradingSign ((1 / 2 : ℝ) • ∑ i, (basis i : G)) x

/-- H=(1/2)sum H_i of Section 3.1, p. 19. -/
def coordinateH {Wmin : Set G} {tau theta : G ≃ₗ⁅ℝ⁆ G}
    (B : CayleyCoordinates Wmin tau theta) : G :=
  (1 / 2 : ℝ) • ∑ i, (B.basis i : G)

/-- The element with coefficients lambda_i, Proposition 3.5, p. 19. -/
def coefficientElement {Wmin : Set G} {tau theta : G ≃ₗ⁅ℝ⁆ G}
    (B : CayleyCoordinates Wmin tau theta) (lam : Fin B.rank → ℝ) : G :=
  ∑ i, lam i • (B.basis i : G)

/-- The specified coefficient cutoff, not a freely chosen h', Proposition 3.5, p. 19. -/
def cutElement {Wmin : Set G} {tau theta : G ≃ₗ⁅ℝ⁆ G}
    (B : CayleyCoordinates Wmin tau theta) (lam : Fin B.rank → ℝ) : G :=
  coefficientElement B (fun i => if lam i = (1 / 2 : ℝ) then (1 / 2 : ℝ) else 0)

/-- The actual chosen Jordan frame of Examples 2.27 and Remark 2.29, pp. 13–14, 19.
The multiplication-root relation fixes its normalization and identifies the frame with H_i.
The orientation is exactly the Wmin cap V = closed square cone convention of Section 3.1. -/
structure CayleyJordanFrame {Wmin : Set G} {tau theta : G ≃ₗ⁅ℝ⁆ G}
    (B : CayleyCoordinates Wmin tau theta) where
  J : EuclideanJordan (adSpace (coordinateH B) 1)
  constructed : KKTModel theta (coordinateH B) 1 J
  c : Fin B.rank → adSpace (coordinateH B) 1
  frame : JordanFrame J c
  normalized : ∀ i (v : adSpace (coordinateH B) 1),
    (J.product (c i) v : G) = (1 / 2 : ℝ) • ⁅(B.basis i : G), (v : G)⁆
  orientation : (Subtype.val : adSpace (coordinateH B) 1 → G) ⁻¹' Wmin = squares J

example (tau : G ≃ₗ⁅ℝ⁆ G) : (0 : G) ∈ fixedLie tau := by simp [fixedLie]

example (h : G) (x : G) (hx : ⁅h, x⁆ = x) : gradingSign h x = -x := by
  simp only [gradingSign, hx, two_smul]
  abel

end AdditionalDefinitions

