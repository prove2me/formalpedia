  GoodReductionJacobian.AbelianSchemePropertyBundle.baseChange_of_field u.bundle t

theorem g3_dim (s : ↥(Spec (CommRingCat.of K))) : topologicalKrullDim ↥((pullback.snd u.f t).base ⁻¹' {s}) = g := by
  rw [AlgebraicGeometry.topologicalKrullDim_preimage_eq_of_isPullback_of_smooth_of_isConnected u.f u.bundle.smooth t
    (pullback.snd u.f t) (pullback.fst u.f t) (IsPullback.of_hasPullback u.f t) s (u.bundle.connectedFibres _)]
  exact u.dim_fibre _

theorem g4_isInvertible : Scheme.Modules.IsInvertible ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol) :=
  Scheme.Modules.IsInvertible.pullback (pullback.fst u.f t) u.pol_isInvertible

theorem g6_nonempty_iso (hc' : L'.IsCommutative) (M : (pullback u.f t).Modules) (γ : RiemannForm.thetaGroup (pullback.snd u.f t) L' hc' M) :
    Nonempty ((Scheme.Modules.pullback (RiemannForm.translation (pullback.snd u.f t) L'
      (RelativeGroupLaw.AlgPoints.toPoint (Multiplicative.toAdd (RiemannForm.thetaGroup.pt (pullback.snd u.f t) L' hc' M γ))))).obj M ≅ M) :=
  K77G6.nonempty_iso_of_thetaGroup (pullback.snd u.f t) L' hc' γ

theorem g7_nsmul_iff (hc' : L'.IsCommutative) (m : ℕ) (P : L'.AlgPoints hc' K) :
    L'.nsmul (Spec.map (CommRingCat.ofHom (algebraMap K K))) m (RelativeGroupLaw.AlgPoints.toPoint P) = L'.one (Spec.map (CommRingCat.ofHom (algebraMap K K))) ↔ m • P = 0 := by
  rw [RelativeGroupLaw.AlgPoints.nsmul_eq_zero_iff, RelativeGroupLaw.isTorsionPoint_def]

include hL' in

theorem g8_bridge :
    (∀ y : SchemeHomOver t u.f, ∃ Q : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap K K))) (pullback.snd u.f t), Q.1 ≫ pullback.fst u.f t = y.1) ∧
    (∀ Q : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap K K))) (pullback.snd u.f t),
      Polarisation.MemKernel (pullback.snd u.f t) L' ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol) (Spec.map (CommRingCat.ofHom (algebraMap K K))) Q ↔
        Polarisation.MemKernel u.f u.L u.pol t ⟨Q.1 ≫ pullback.fst u.f t,
          by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2, RiemannForm.specMap_algebraMap_self, Category.id_comp]⟩) :=
  AlgebraicGeometry.Polarisation.exists_comp_fst_eq_and_memKernel_pullback_iff_memKernel_comp_fst u.f u.L u.pol u.pol_isInvertible
    t L' hL'

theorem g9_ext (Q Q' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap K K))) (pullback.snd u.f t)) (h : Q.1 ≫ pullback.fst u.f t = Q'.1 ≫ pullback.fst u.f t) :
    Q = Q' := by
  apply Subtype.ext
  apply pullback.hom_ext
  · exact h
  · rw [Q.2, Q'.2]

include hL' in

theorem g10_one_fst : (L'.one (Spec.map (CommRingCat.ofHom (algebraMap K K)))).1 ≫ pullback.fst u.f t = (u.L.one t).1 := by
  have hι : Spec.map (CommRingCat.ofHom (algebraMap K K)) ≫ t = t := by
    rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]

  have key := hL' _ (Spec.map (CommRingCat.ofHom (algebraMap K K))) (L'.one _) (L'.one _)
  rw [L'.mul_one] at key

  set z : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap K K)) ≫ t) u.f :=
    ⟨(L'.one (Spec.map (CommRingCat.ofHom (algebraMap K K)))).1 ≫ pullback.fst u.f t, by
      rw [Category.assoc, pullback.condition, ← Category.assoc, (L'.one _).2]⟩ with hz
  have hzz : u.L.mul _ z z = z := Subtype.ext key.symm
  have hz1 : z = u.L.one _ := by
    calc z = u.L.mul _ (u.L.mul _ (u.L.inv _ z) z) z := by rw [u.L.inv_mul_cancel, u.L.one_mul]
      _ = u.L.mul _ (u.L.inv _ z) (u.L.mul _ z z) := by rw [u.L.mul_assoc]
      _ = u.L.one _ := by rw [hzz, u.L.inv_mul_cancel]
  have h1 : z.1 = (u.L.one (Spec.map (CommRingCat.ofHom (algebraMap K K)) ≫ t)).1 := congrArg Subtype.val hz1
  rw [hz] at h1
  change (L'.one (Spec.map (CommRingCat.ofHom (algebraMap K K)))).1 ≫ pullback.fst u.f t = _ at h1
  rw [h1, ← u.L.one_natural t _ (𝟙 _) (by rw [Category.id_comp, hι]), GoodReductionJacobian.schemeHomOverComp_coe,
    Category.id_comp]

theorem g11_faithful (hd : IsUnit ((d : ℕ) : S)) (c : K)
    (h : ∀ s : Γ(((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol), ⊤), baseScalar u.f t c • s = s) : c = 1 := by
  have h0 : ∀ s : Γ(((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol), ⊤), baseScalar u.f t (c - 1) • s = 0 := by
    intro s
    rw [show baseScalar u.f t (c - 1) = baseScalar u.f t c - baseScalar u.f t 1 from map_sub (baseScalarHom u.f t) _ _,
      show baseScalar u.f t (1 : K) = 1 from map_one (baseScalarHom u.f t), sub_smul, one_smul, h, sub_self]
  exact sub_eq_zero.mp (AlgebraicGeometry.PolarisedAbelianScheme.eq_zero_of_forall_baseScalar_smul_eq_zero u t _ h0)

