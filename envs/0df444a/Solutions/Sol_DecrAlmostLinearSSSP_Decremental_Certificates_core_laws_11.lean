lemma header_eval (b : Core) (B N : ℕ) (K : ℝ) (state : State b) (e : Fin b.input.k) (g : Machine) (s : Data)
    (h : CoreHost.Image b B K state s) (hs : CoreSource.Image B (CoreMemory.sourceRecord b B) N g s)
    (hB : b.input.n ≤ B) (he : s.natReg 5 = e.val) :
