-- title:
--   Integrality over ℚ[j] of a Γ₀(ℓ)-invariant q-expansion
-- statement:
--   Let $\ell$ be a prime, let $f,g$ be formal Laurent series over $\mathbb Q$ (elements of `LaurentSeries ℚ`), and let $F\colon\mathfrak H\to\mathbb C$ be a function on the upper half-plane. Assume: (hF) for every $\tau\in\mathfrak H$ the family $m\mapsto f_m\,q_1(\tau)^m$, indexed by $m\in\mathbb Z$, where $f_m\in\mathbb Q\subseteq\mathbb C$ is the $m$-th coefficient of $f$ and $q_h(\tau)=$ `Function.Periodic.qParam h τ` $=e^{2\pi i\tau/h}$, is summable with sum $F(\tau)$; (hG) for every $\tau\in\mathfrak H$ the family $m\mapsto g_m\,q_\ell(\tau)^m$ is summable with sum $F(S\tau)$, where $S\in\mathrm{SL}_2(\mathbb Z)$ is `ModularGroup.S` acting by Möbius transformation; and (hinv) $F(\gamma\tau)=F(\tau)$ for every $\gamma$ in `CongruenceSubgroup.Gamma0 ℓ` and every $\tau\in\mathfrak H$. The conclusion is that $f$ is integral, in the sense of `IsIntegral`, over the $\mathbb Q$-subalgebra `Algebra.adjoin ℚ {ModularCurve.jq}` of $\mathbb Q((q))$ generated by [`ModularCurve.jq`](def/ModularCurve_X0.html#L157), the Laurent series $q^{-1}\cdot\jmath$ with $\jmath$ the image in $\mathbb Q[[q]]$ of the integral power series `jNum`; that is, $f$ satisfies a monic polynomial equation with coefficients polynomial in the $q$-expansion of $j$.
--
--   This is the integrality half of the $q$-expansion principle for $X_0(\ell)$: a Laurent series that is the $q$-expansion at $\infty$ of a $\Gamma_0(\ell)$-invariant function, with a meromorphic expansion of width $\ell$ at the cusp $0$, is integral over $\mathbb Q[j]$. It is used to place the $q$-expansions of modular units, and their inverses, in the function field of $X_0(\ell)$ over $\mathbb Q$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_isIntegral_adjoin_jq_of_hasSum_of_gamma0_invariant.lean

import Definitions.Def_ModularCurve_X0
import Mathlib.Analysis.Complex.UpperHalfPlane.Exp
import Mathlib.Analysis.Complex.UpperHalfPlane.MoebiusAction
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem ModularCurve.isIntegral_adjoin_jq_of_hasSum_of_gamma0_invariant (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (f g : LaurentSeries ℚ) (F : UpperHalfPlane → ℂ) (hF : ∀ τ : UpperHalfPlane, HasSum (fun m : ℤ => ((f.coeff m : ℚ) : ℂ) * Function.Periodic.qParam 1 (τ : ℂ) ^ m) (F τ)) (hG : ∀ τ : UpperHalfPlane, HasSum (fun m : ℤ => ((g.coeff m : ℚ) : ℂ) * Function.Periodic.qParam ℓ (τ : ℂ) ^ m) (F (ModularGroup.S • τ))) (hinv : ∀ γ ∈ CongruenceSubgroup.Gamma0 ℓ, ∀ τ : UpperHalfPlane, F (γ • τ) = F τ) : IsIntegral (Algebra.adjoin ℚ {ModularCurve.jq}) f := by sorry
