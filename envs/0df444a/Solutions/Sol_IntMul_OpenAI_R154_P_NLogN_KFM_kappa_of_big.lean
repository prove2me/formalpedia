theorem enc_head_tst (inp : ℕ → Γ L) (c : NLogN.Cfg S) (i : Fin S) :
    (NLogN.enc inp c).head (tst i) = (c.σ.stk i).length := by
  simp [NLogN.enc, tst]

theorem enc_read_tst (inp : ℕ → Γ L) (c : NLogN.Cfg S) (i : Fin S) :
    topOf ((NLogN.enc inp c).read (tst i)) = c.σ.top i := by
  simp only [Tapes.read, enc_cells_tst, enc_head_tst, topOf_read]; rfl

