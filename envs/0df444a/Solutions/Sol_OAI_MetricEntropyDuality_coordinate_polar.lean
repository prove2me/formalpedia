open OAI OAI.MetricEntropyDuality
universe uι uκ
open scoped BigOperators Pointwise
variable {ι : Type uι} {κ : Type uκ}
variable [Fintype ι] [Fintype κ]
lemma h51m_pair (e : ι ≃ κ) (x y : RealSpace ι) :
    pairing (coordinateEquiv e x) (coordinateEquiv e y) = pairing x y := by
  unfold pairing
  simp only [coordinateEquiv_apply]
  exact Equiv.sum_comp e.symm (fun i => x i * y i)

theorem solution (e : ι ≃ κ) (K : Set (RealSpace ι)) :
    coordinateEquiv e '' polar K = polar (coordinateEquiv e '' K) := by
  ext y
  rw [mem_coordinate_image_iff]
  simp only [polar, Set.mem_setOf_eq]
  constructor
  · intro h z hz
    obtain ⟨x, hx, rfl⟩ := hz
    have := h x hx
    rw [← h51m_pair e x ((coordinateEquiv e).symm y), ContinuousLinearEquiv.apply_symm_apply] at this
    exact this
  · intro h x hx
    have := h (coordinateEquiv e x) ⟨x, hx, rfl⟩
    rw [← h51m_pair e x ((coordinateEquiv e).symm y), ContinuousLinearEquiv.apply_symm_apply]
    exact this

