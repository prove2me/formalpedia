theorem ModularCurve.UVCrossingModel.exists_C_mul_of_chartHom_eq_zero {W : Type*} [CommRing W] {π : W} {f : PowerSeries W} (hf : chartHom π f = 0) : ∃ g : PowerSeries W, f = PowerSeries.C π * g := by sorry
