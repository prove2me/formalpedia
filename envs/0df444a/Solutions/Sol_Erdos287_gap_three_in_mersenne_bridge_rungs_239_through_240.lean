  have hz : z ^ 2 ^ e = -1 := by simpa [z, pow_mul] using hcast
  have hzne : z ≠ 0 := by
    intro h
    rw [h, zero_pow (by positivity)] at hz
    exact neg_ne_zero.mpr one_ne_zero hz.symm
  have hzfull : z ^ 2 ^ (e + 1) = 1 := by
    rw [pow_succ, pow_mul, hz]
