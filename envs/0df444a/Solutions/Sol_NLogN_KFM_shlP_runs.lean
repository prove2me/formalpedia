variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem shlB_runs (γ : ℕ) (s : IState HS) (LR : List Item) (hR : s.G pR = .int (2 ^ γ) :: LR)
    (st : IState HS) (x : ℤ) (L0 : List Item) (hF : Fixd s st) (h0 : st.G 0 = .int x :: L0) :
    IRuns I iprog shlB st ((st.upd 0 L0).upd pO (.int (x * 2 ^ γ) :: st.G pO))
      (110 * (zsz x + 1) + shlCost γ + 110 * (zsz x + γ + 2)) := by
  have hR' : st.G pR = .int (2 ^ γ) :: LR := by rw [hF pR (by decide) (by decide) (by decide)
    (by decide) (by decide), hR]
  have m1 := IRuns.mv (I := I) (iprog := iprog) (s := st) (i := 0) (j := pP1) (a := x) (L := L0)
    (by decide) h0
  have m2 := IRuns.shl (I := I) (iprog := iprog) (s := (st.upd 0 L0).upd pP1 (.int x :: st.G pP1))
    (i := pP1) (j := pR) (a := x) (m := γ) (Li := st.G pP1) (Lj := LR) (by decide) (by simp)
    (by simp +decide [hR'])
  have m3 := IRuns.mv (I := I) (iprog := iprog)
    (s := ((st.upd 0 L0).upd pP1 (.int x :: st.G pP1)).upd pP1 (.int (x * 2 ^ γ) :: st.G pP1))
    (i := pP1) (j := pO) (a := x * 2 ^ γ) (L := st.G pP1) (by decide) (by simp)
  refine (m1.seq (m2.seq m3)).mono' ?_ ?_
  · ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have c1 := moveIntCost_le (zsz x); have c2 := moveIntCost_le (zsz (x * 2 ^ γ))
    have c3 := zsz_mul_le x (2 ^ γ); have c4 := NLogN.zsz_two_pow γ
    omega

end NLogN.KFM

end

