  have hlim := tendsto_integral_sq_mul_div_cu (h := hfun j q r) (b := 1 / 4) (by norm_num) hc
  have hval : hfun j q r 0 / 3 = 2 * sigmaB j q - r 0 / 3 := by
    rw [hfun_zero]
