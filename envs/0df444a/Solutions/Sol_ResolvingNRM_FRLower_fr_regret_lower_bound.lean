open Matrix Finset ProbabilityTheory
open scoped NNReal

namespace ResolvingNRM.FRLower.ProofPlan

lemma hasSum_poissonPMFReal (lam : ℝ≥0) : HasSum (poissonPMFReal lam) 1 :=
  poissonPMFRealSum lam

lemma summable_poissonPMFReal (lam : ℝ≥0) : Summable (poissonPMFReal lam) :=
  (hasSum_poissonPMFReal lam).summable

noncomputable def markWeight (p : Fin 2 → ℝ) (N : ℕ)
    (cls : Fin N → Fin 2) (coin : Fin N → Bool) : ℝ :=
  ∏ i : Fin N, ((1 : ℝ) / 2) * (if coin i then p (cls i) else 1 - p (cls i))

noncomputable def stepExp (p : Fin 2 → ℝ) (F : Window → ℝ) : ℝ :=
  ∑' N : ℕ, poissonPMFReal 2 N *
    (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
      markWeight p N cls coin * F ⟨N, (cls, coin)⟩)

def StepAbsIntegrable (p : Fin 2 → ℝ) (F : Window → ℝ) : Prop :=
  Summable (fun N : ℕ =>
    poissonPMFReal 2 N *
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * |F ⟨N, (cls, coin)⟩|))

lemma windowValue_tcInst_eq_stepExp
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (p : Fin 2 → ℝ) (c : Fin 1 → ℝ) (W : (Fin 1 → ℝ) → ℝ) :
    windowValue (tcInst r₁ r₂ hr₂ hr) 1 p c W =
      stepExp p (fun w =>
        let outcome := runWindow (tcInst r₁ r₂ hr₂ hr) c (windowList w)
        outcome.1 + W outcome.2) := by
  unfold windowValue stepExp markWeight windowList
  rw [totalRate_tcInst]
  have h2 : ((2 : ℝ) * 1).toNNReal = (2 : ℝ≥0) := by
    ext; simp
  rw [h2]
  congr 1; ext N
  congr 1; refine Finset.sum_congr rfl fun cls _ => ?_
  refine Finset.sum_congr rfl fun coin _ => ?_
  congr 1
  refine Finset.prod_congr rfl fun i _ => ?_
  have hlam : (tcInst r₁ r₂ hr₂ hr).lam (cls i) = 1 := by
    rcases fin2_eq_or (cls i) with hci | hci <;> rw [hci] <;> simp [tcInst, twoClass]
  rw [hlam]

lemma markWeight_nonneg {p : Fin 2 → ℝ} (hp : ValidProb p) (N : ℕ)
    (cls : Fin N → Fin 2) (coin : Fin N → Bool) :
    0 ≤ markWeight p N cls coin := by
  unfold markWeight
  refine Finset.prod_nonneg fun i _ => ?_
  have hpi := hp (cls i)
  cases coin i <;> simp <;> linarith

lemma sum_coin_markWeight (p : Fin 2 → ℝ) (N : ℕ) (cls : Fin N → Fin 2) :
    (∑ coin : Fin N → Bool, markWeight p N cls coin) = ((1 : ℝ) / 2) ^ N := by
  unfold markWeight
  have hprod := (Fintype.prod_sum (fun (i : Fin N) (b : Bool) =>
    ((1 : ℝ) / 2) * (if b then p (cls i) else 1 - p (cls i)))).symm
  rw [hprod]
  have hterm : ∀ i : Fin N,
      (∑ b : Bool, ((1 : ℝ) / 2) * (if b then p (cls i) else 1 - p (cls i))) = (1 : ℝ) / 2 := by
    intro i
    simp; ring
  simp_rw [hterm]
  simp [Finset.prod_const]

lemma sum_cls_coin_markWeight (p : Fin 2 → ℝ) (N : ℕ) :
    (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool, markWeight p N cls coin) = 1 := by
  simp_rw [sum_coin_markWeight]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_pi, Fintype.card_fin,
    Finset.prod_const, nsmul_eq_mul]
  push_cast
  rw [← mul_pow]
  norm_num

lemma winEnabled_zero_eq_winOffered_of_markWeight_pos
    {p : Fin 2 → ℝ} (hp0 : p 0 = 1) {w : Window}
    (hw : 0 < markWeight p w.1 w.2.1 w.2.2) :
    winEnabled 0 w = winOffered 0 w := by
  rcases w with ⟨N, cls, coin⟩
  dsimp only at hw
  rw [winEnabled_eq_card_filter, winOffered_eq_card_filter]
  dsimp only
  congr 1
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, and_iff_left_iff_imp]
  intro hcls
  by_contra hcoin
  have hcf : coin i = false := Bool.eq_false_iff.mpr hcoin
  have hzero : markWeight p N cls coin = 0 := by
    unfold markWeight
    refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
    simp [hcf, hcls, hp0]
  linarith

/-! ### Poisson Moment `HasSum` Identities -/

lemma poissonPMFReal_mul_succ (lam : ℝ≥0) (k : ℕ) :
    poissonPMFReal lam (k + 1) * ((k + 1 : ℕ) : ℝ) =
      (lam : ℝ) * poissonPMFReal lam k := by
  simp only [poissonPMFReal, Nat.factorial_succ, Nat.cast_mul, pow_succ]
  have hk1 : ((k + 1 : ℕ) : ℝ) ≠ 0 := by positivity
  have hkf : (k.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero k)
  field_simp [hk1, hkf]

lemma poissonPMFReal_mul_succ_succ (lam : ℝ≥0) (k : ℕ) :
    poissonPMFReal lam (k + 2) * (((k + 2 : ℕ) : ℝ) * ((k + 1 : ℕ) : ℝ)) =
      (lam : ℝ) ^ 2 * poissonPMFReal lam k := by
  have h1 := poissonPMFReal_mul_succ lam (k + 1)
  have h2 := poissonPMFReal_mul_succ lam k
  calc
    poissonPMFReal lam (k + 2) * (((k + 2 : ℕ) : ℝ) * ((k + 1 : ℕ) : ℝ))
        = (poissonPMFReal lam (k + 2) * ((k + 2 : ℕ) : ℝ)) * ((k + 1 : ℕ) : ℝ) := by ring
    _ = ((lam : ℝ) * poissonPMFReal lam (k + 1)) * ((k + 1 : ℕ) : ℝ) := by rw [h1]
    _ = (lam : ℝ) * (poissonPMFReal lam (k + 1) * ((k + 1 : ℕ) : ℝ)) := by ring
    _ = (lam : ℝ) * ((lam : ℝ) * poissonPMFReal lam k) := by rw [h2]
    _ = (lam : ℝ) ^ 2 * poissonPMFReal lam k := by ring

lemma hasSum_poissonPMFReal_mul_nat (lam : ℝ≥0) :
    HasSum (fun k : ℕ => poissonPMFReal lam k * (k : ℝ)) (lam : ℝ) := by
  rw [← hasSum_nat_add_iff' 1]
  simp only [Finset.sum_range_one, Nat.cast_zero, mul_zero, sub_zero]
  have h := (hasSum_poissonPMFReal lam).mul_left (lam : ℝ)
  rw [mul_one] at h
  refine h.congr_fun fun k => poissonPMFReal_mul_succ lam k

lemma hasSum_poissonPMFReal_mul_falling2 (lam : ℝ≥0) :
    HasSum (fun k : ℕ => poissonPMFReal lam k * ((k : ℝ) * ((k : ℝ) - 1))) ((lam : ℝ) ^ 2) := by
  rw [← hasSum_nat_add_iff' 2]
  have hinit : (∑ i ∈ Finset.range 2, poissonPMFReal lam i * ((i : ℝ) * ((i : ℝ) - 1))) = 0 := by
    simp [Finset.sum_range_succ]
  rw [hinit, sub_zero]
  have h := (hasSum_poissonPMFReal lam).mul_left ((lam : ℝ) ^ 2)
  rw [mul_one] at h
  refine h.congr_fun fun k => ?_
  have hcast : ((k + 2 : ℕ) : ℝ) - 1 = ((k + 1 : ℕ) : ℝ) := by push_cast; ring
  rw [hcast, poissonPMFReal_mul_succ_succ]

lemma hasSum_poisson2_sq :
    HasSum (fun N : ℕ => poissonPMFReal 2 N * ((N : ℝ) ^ 2)) 6 := by
  have h1 := hasSum_poissonPMFReal_mul_nat 2
  have h2 := hasSum_poissonPMFReal_mul_falling2 2
  have hsum := h2.add h1
  convert hsum using 1
  · ext N; ring
  · norm_num

lemma hasSum_poisson2_one_add_sq :
    HasSum (fun N : ℕ => poissonPMFReal 2 N * (1 + (N : ℝ)) ^ 2) 11 := by
  have h0 := hasSum_poissonPMFReal 2
  have h1 := (hasSum_poissonPMFReal_mul_nat 2).mul_left 2
  have h2 := hasSum_poisson2_sq
  have hsum := (h0.add h1).add h2
  convert hsum using 1
  · ext N; ring
  · norm_num

lemma summable_poisson2_one_add_sq :
    Summable (fun N : ℕ => poissonPMFReal 2 N * (1 + (N : ℝ)) ^ 2) :=
  hasSum_poisson2_one_add_sq.summable

/-! ### `stepExp` Linearity, Monotonicity, and Envelope Summability -/

lemma StepAbsIntegrable.summable_outer {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F : Window → ℝ} (hF : StepAbsIntegrable p F) :
    Summable (fun N : ℕ => poissonPMFReal 2 N *
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * F ⟨N, (cls, coin)⟩)) := by
  refine hF.of_norm_bounded fun N => ?_
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg poissonPMFReal_nonneg]
  refine mul_le_mul_of_nonneg_left ?_ poissonPMFReal_nonneg
  calc
    |∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * F ⟨N, (cls, coin)⟩|
        ≤ ∑ cls : Fin N → Fin 2, |∑ coin : Fin N → Bool,
            markWeight p N cls coin * F ⟨N, (cls, coin)⟩| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
          |markWeight p N cls coin * F ⟨N, (cls, coin)⟩| := by
        refine Finset.sum_le_sum fun cls _ => Finset.abs_sum_le_sum_abs _ _
    _ = ∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
          markWeight p N cls coin * |F ⟨N, (cls, coin)⟩| := by
        refine Finset.sum_congr rfl fun cls _ => Finset.sum_congr rfl fun coin _ => ?_
        rw [abs_mul, abs_of_nonneg (markWeight_nonneg hp N cls coin)]

lemma stepAbsIntegrable_of_quad_bound {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F : Window → ℝ} (C : ℝ) (_hC : 0 ≤ C)
    (hF : ∀ w : Window, |F w| ≤ C * (1 + (w.1 : ℝ)) ^ 2) :
    StepAbsIntegrable p F := by
  unfold StepAbsIntegrable
  refine Summable.of_nonneg_of_le ?_ ?_ (summable_poisson2_one_add_sq.mul_left C)
  · intro N
    refine mul_nonneg poissonPMFReal_nonneg ?_
    refine Finset.sum_nonneg fun cls _ => Finset.sum_nonneg fun coin _ => ?_
    exact mul_nonneg (markWeight_nonneg hp N cls coin) (abs_nonneg _)
  · intro N
    have hinner :
        (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
          markWeight p N cls coin * |F ⟨N, (cls, coin)⟩|) ≤
          C * (1 + (N : ℝ)) ^ 2 := by
      calc
        (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
            markWeight p N cls coin * |F ⟨N, (cls, coin)⟩|)
            ≤ ∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
                markWeight p N cls coin * (C * (1 + (N : ℝ)) ^ 2) := by
              refine Finset.sum_le_sum fun cls _ => Finset.sum_le_sum fun coin _ => ?_
              exact mul_le_mul_of_nonneg_left (hF ⟨N, (cls, coin)⟩)
                (markWeight_nonneg hp N cls coin)
        _ = (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool, markWeight p N cls coin) *
              (C * (1 + (N : ℝ)) ^ 2) := by
              simp_rw [← Finset.sum_mul]
        _ = C * (1 + (N : ℝ)) ^ 2 := by rw [sum_cls_coin_markWeight, one_mul]
    calc
      poissonPMFReal 2 N *
          (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
            markWeight p N cls coin * |F ⟨N, (cls, coin)⟩|)
          ≤ poissonPMFReal 2 N * (C * (1 + (N : ℝ)) ^ 2) :=
        mul_le_mul_of_nonneg_left hinner poissonPMFReal_nonneg
      _ = C * (poissonPMFReal 2 N * (1 + (N : ℝ)) ^ 2) := by ring

lemma stepAbsIntegrable_of_bdd {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F : Window → ℝ} (B : ℝ) (hB : 0 ≤ B) (hF : ∀ w : Window, |F w| ≤ B) :
    StepAbsIntegrable p F := by
  refine stepAbsIntegrable_of_quad_bound hp B hB fun w => ?_
  have h1 : (1 : ℝ) ≤ (1 + (w.1 : ℝ)) ^ 2 := by nlinarith [(Nat.cast_nonneg w.1 : (0 : ℝ) ≤ w.1)]
  nlinarith [hF w]

lemma stepAbsIntegrable_const {p : Fin 2 → ℝ} (hp : ValidProb p) (c : ℝ) :
    StepAbsIntegrable p (fun _ => c) :=
  stepAbsIntegrable_of_bdd hp |c| (abs_nonneg c) (fun _ => le_rfl)

lemma stepExp_const {p : Fin 2 → ℝ} (c : ℝ) :
    stepExp p (fun _ => c) = c := by
  unfold stepExp
  have h1 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool, markWeight p N cls coin * c) = c := by
    intro N
    simp_rw [← Finset.sum_mul, sum_cls_coin_markWeight, one_mul]
  simp_rw [h1]
  have hs := (hasSum_poissonPMFReal 2).mul_right c
  rw [one_mul] at hs
  exact hs.tsum_eq

lemma stepAbsIntegrable_add {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hF : StepAbsIntegrable p F) (hG : StepAbsIntegrable p G) :
    StepAbsIntegrable p (fun w => F w + G w) := by
  unfold StepAbsIntegrable
  refine Summable.of_nonneg_of_le ?_ ?_ (hF.add hG)
  · intro N
    refine mul_nonneg poissonPMFReal_nonneg ?_
    exact Finset.sum_nonneg fun cls _ => Finset.sum_nonneg fun coin _ =>
      mul_nonneg (markWeight_nonneg hp N cls coin) (abs_nonneg _)
  · intro N
    rw [← mul_add, ← Finset.sum_add_distrib]
    refine mul_le_mul_of_nonneg_left ?_ poissonPMFReal_nonneg
    refine Finset.sum_le_sum fun cls _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun coin _ => ?_
    rw [← mul_add]
    exact mul_le_mul_of_nonneg_left (abs_add_le _ _) (markWeight_nonneg hp N cls coin)

lemma stepAbsIntegrable_mul_left {p : Fin 2 → ℝ} (_hp : ValidProb p)
    (c : ℝ) {F : Window → ℝ} (hF : StepAbsIntegrable p F) :
    StepAbsIntegrable p (fun w => c * F w) := by
  unfold StepAbsIntegrable
  have h := hF.mul_left |c|
  refine h.congr fun N => ?_
  simp_rw [abs_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun cls _ =>
    Finset.sum_congr rfl fun coin _ => by ring

lemma stepAbsIntegrable_sub {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hF : StepAbsIntegrable p F) (hG : StepAbsIntegrable p G) :
    StepAbsIntegrable p (fun w => F w - G w) := by
  have hG' := stepAbsIntegrable_mul_left hp (-1) hG
  have heq : (fun w => F w - G w) = (fun w => F w + (-1) * G w) := by ext w; ring
  rw [heq]
  exact stepAbsIntegrable_add hp hF hG'

lemma stepAbsIntegrable_of_le {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hG : StepAbsIntegrable p G)
    (hFG : ∀ w, 0 < markWeight p w.1 w.2.1 w.2.2 → |F w| ≤ |G w|) :
    StepAbsIntegrable p F := by
  unfold StepAbsIntegrable
  refine Summable.of_nonneg_of_le ?_ ?_ hG
  · intro N
    refine mul_nonneg poissonPMFReal_nonneg ?_
    exact Finset.sum_nonneg fun cls _ => Finset.sum_nonneg fun coin _ =>
      mul_nonneg (markWeight_nonneg hp N cls coin) (abs_nonneg _)
  · intro N
    refine mul_le_mul_of_nonneg_left ?_ poissonPMFReal_nonneg
    refine Finset.sum_le_sum fun cls _ => Finset.sum_le_sum fun coin _ => ?_
    have hmw := markWeight_nonneg hp N cls coin
    rcases eq_or_lt_of_le hmw with h0 | hpos
    · simp [← h0]
    · exact mul_le_mul_of_nonneg_left (hFG ⟨N, (cls, coin)⟩ hpos) (le_of_lt hpos)

lemma stepExp_add {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hF : StepAbsIntegrable p F) (hG : StepAbsIntegrable p G) :
    stepExp p (fun w => F w + G w) = stepExp p F + stepExp p G := by
  unfold stepExp
  rw [← (hF.summable_outer hp).tsum_add (hG.summable_outer hp)]
  congr 1; ext N
  rw [← mul_add, ← Finset.sum_add_distrib]
  congr 1; refine Finset.sum_congr rfl fun cls _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun coin _ => by ring

lemma stepExp_mul_left (p : Fin 2 → ℝ) (c : ℝ) (F : Window → ℝ) :
    stepExp p (fun w => c * F w) = c * stepExp p F := by
  unfold stepExp
  rw [← tsum_mul_left]
  congr 1; ext N
  simp_rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun cls _ =>
    Finset.sum_congr rfl fun coin _ => by ring

lemma stepExp_sub {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hF : StepAbsIntegrable p F) (hG : StepAbsIntegrable p G) :
    stepExp p (fun w => F w - G w) = stepExp p F - stepExp p G := by
  have hG' := stepAbsIntegrable_mul_left hp (-1) hG
  have heq : (fun w => F w - G w) = (fun w => F w + (-1) * G w) := by ext w; ring
  rw [heq, stepExp_add hp hF hG', stepExp_mul_left]
  ring

lemma stepExp_nonneg_of_support {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F : Window → ℝ} (hF : ∀ w, 0 < markWeight p w.1 w.2.1 w.2.2 → 0 ≤ F w) :
    0 ≤ stepExp p F := by
  unfold stepExp
  refine tsum_nonneg fun N => mul_nonneg poissonPMFReal_nonneg ?_
  refine Finset.sum_nonneg fun cls _ => Finset.sum_nonneg fun coin _ => ?_
  have hmw := markWeight_nonneg hp N cls coin
  rcases eq_or_lt_of_le hmw with h0 | hpos
  · simp [← h0]
  · exact mul_nonneg (le_of_lt hpos) (hF ⟨N, (cls, coin)⟩ hpos)

lemma stepExp_mono_of_support {p : Fin 2 → ℝ} (hp : ValidProb p)
    {F G : Window → ℝ} (hF : StepAbsIntegrable p F) (hG : StepAbsIntegrable p G)
    (hFG : ∀ w, 0 < markWeight p w.1 w.2.1 w.2.2 → F w ≤ G w) :
    stepExp p F ≤ stepExp p G := by
  rw [← sub_nonneg, ← stepExp_sub hp hG hF]
  refine stepExp_nonneg_of_support hp fun w hw => ?_
  linarith [hFG w hw]

/-! ### Generic Finite Product Bernoulli Moment Lemma & Window Moments -/

private def finConsEquiv (α : Type*) (N : ℕ) : (α × (Fin N → α)) ≃ (Fin (N + 1) → α) where
  toFun p := Fin.cons p.1 p.2
  invFun f := (f 0, Fin.tail f)
  left_inv := fun ⟨_, _⟩ => by simp
  right_inv f := Fin.cons_self_tail f

private def pairFnEquiv (N : ℕ) :
    ((Fin N → Fin 2) × (Fin N → Bool)) ≃ (Fin N → Fin 2 × Bool) where
  toFun p i := (p.1 i, p.2 i)
  invFun f := (fun i => (f i).1, fun i => (f i).2)
  left_inv := fun ⟨_, _⟩ => rfl
  right_inv _ := rfl

lemma prod_bernoulli_moments
    (θ : Fin 2 × Bool → ℝ) (hθ : ∑ x : Fin 2 × Bool, θ x = 1)
    (ind : Fin 2 × Bool → ℝ) (hind_sq : ∀ x, ind x * ind x = ind x)
    (N : ℕ) :
    let q := ∑ x : Fin 2 × Bool, θ x * ind x
    let W := fun f : Fin N → Fin 2 × Bool => ∏ i : Fin N, θ (f i)
    let C := fun f : Fin N → Fin 2 × Bool => ∑ i : Fin N, ind (f i)
    (∑ f : Fin N → Fin 2 × Bool, W f) = 1 ∧
      (∑ f : Fin N → Fin 2 × Bool, W f * C f) = (N : ℝ) * q ∧
      (∑ f : Fin N → Fin 2 × Bool, W f * (C f) ^ 2) =
        (N : ℝ) * q + (N : ℝ) * ((N : ℝ) - 1) * q ^ 2 := by
  induction N with
  | zero =>
    simp
  | succ N ih =>
    rcases ih with ⟨ih0, ih1, ih2⟩
    dsimp only at ih0 ih1 ih2 ⊢
    set q := ∑ x : Fin 2 × Bool, θ x * ind x with hq_def
    set W : (Fin N → Fin 2 × Bool) → ℝ := fun f => ∏ i : Fin N, θ (f i) with hW_def
    set C : (Fin N → Fin 2 × Bool) → ℝ := fun f => ∑ i : Fin N, ind (f i) with hC_def
    change (∑ f, W f) = 1 at ih0
    change (∑ f, W f * C f) = (N : ℝ) * q at ih1
    change (∑ f, W f * (C f) ^ 2) = (N : ℝ) * q + (N : ℝ) * ((N : ℝ) - 1) * q ^ 2 at ih2
    have hsum0 :
        (∑ f : Fin (N + 1) → Fin 2 × Bool, ∏ i : Fin (N + 1), θ (f i)) = 1 := by
      rw [← (finConsEquiv (Fin 2 × Bool) N).sum_comp]
      rw [Fintype.sum_prod_type]
      simp only [finConsEquiv, Equiv.coe_fn_mk, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]
      change ∑ x : Fin 2 × Bool, ∑ g : Fin N → Fin 2 × Bool, θ x * W g = 1
      simp_rw [← Finset.mul_sum, ih0, mul_one]
      exact hθ
    have hsum1 :
        (∑ f : Fin (N + 1) → Fin 2 × Bool,
          (∏ i : Fin (N + 1), θ (f i)) * (∑ i : Fin (N + 1), ind (f i))) =
          ((N + 1 : ℕ) : ℝ) * q := by
      rw [← (finConsEquiv (Fin 2 × Bool) N).sum_comp]
      rw [Fintype.sum_prod_type]
      simp only [finConsEquiv, Equiv.coe_fn_mk, Fin.prod_univ_succ, Fin.sum_univ_succ,
        Fin.cons_zero, Fin.cons_succ]
      change ∑ x : Fin 2 × Bool, ∑ g : Fin N → Fin 2 × Bool, (θ x * W g) * (ind x + C g) = _
      have hexp : ∀ (x : Fin 2 × Bool) (g : Fin N → Fin 2 × Bool),
          (θ x * W g) * (ind x + C g) = (θ x * ind x) * W g + θ x * (W g * C g) := by
        intros; ring
      simp_rw [hexp, Finset.sum_add_distrib, ← Finset.mul_sum, ih0, ih1,
        ← Finset.sum_mul]
      change q * 1 + (∑ x : Fin 2 × Bool, θ x) * ((N : ℝ) * q) = _
      rw [hθ]
      push_cast; ring
    have hsum2 :
        (∑ f : Fin (N + 1) → Fin 2 × Bool,
          (∏ i : Fin (N + 1), θ (f i)) * (∑ i : Fin (N + 1), ind (f i)) ^ 2) =
          ((N + 1 : ℕ) : ℝ) * q + ((N + 1 : ℕ) : ℝ) * (((N + 1 : ℕ) : ℝ) - 1) * q ^ 2 := by
      rw [← (finConsEquiv (Fin 2 × Bool) N).sum_comp]
      rw [Fintype.sum_prod_type]
      simp only [finConsEquiv, Equiv.coe_fn_mk, Fin.prod_univ_succ, Fin.sum_univ_succ,
        Fin.cons_zero, Fin.cons_succ]
      change ∑ x : Fin 2 × Bool, ∑ g : Fin N → Fin 2 × Bool, (θ x * W g) * (ind x + C g) ^ 2 = _
      have hexp' : ∀ (x : Fin 2 × Bool) (g : Fin N → Fin 2 × Bool),
          (θ x * W g) * (ind x + C g) ^ 2 =
            (θ x * ind x) * W g + (2 * (θ x * ind x)) * (W g * C g) + θ x * (W g * (C g) ^ 2) := by
        intro x g
        have hsq := hind_sq x
        calc
          (θ x * W g) * (ind x + C g) ^ 2
              = θ x * W g * (ind x * ind x + 2 * ind x * C g + (C g) ^ 2) := by ring
          _ = θ x * W g * (ind x + 2 * ind x * C g + (C g) ^ 2) := by rw [hsq]
          _ = (θ x * ind x) * W g + (2 * (θ x * ind x)) * (W g * C g) +
                θ x * (W g * (C g) ^ 2) := by ring
      simp_rw [hexp', Finset.sum_add_distrib, ← Finset.mul_sum, ih0, ih1, ih2]
      have hmid : ∀ x : Fin 2 × Bool,
          2 * (θ x * ind x) * ((N : ℝ) * q) = (θ x * ind x) * (2 * (N : ℝ) * q) := fun _ => by ring
      simp_rw [hmid, ← Finset.sum_mul]
      change q * 1 + q * (2 * (N : ℝ) * q) +
        (∑ x : Fin 2 × Bool, θ x) * ((N : ℝ) * q + (N : ℝ) * ((N : ℝ) - 1) * q ^ 2) = _
      rw [hθ]
      push_cast; ring
    exact ⟨hsum0, hsum1, hsum2⟩

private noncomputable def atomWeight (p : Fin 2 → ℝ) (x : Fin 2 × Bool) : ℝ :=
  ((1 : ℝ) / 2) * (if x.2 then p x.1 else 1 - p x.1)

private lemma sum_atomWeight (p : Fin 2 → ℝ) :
    (∑ x : Fin 2 × Bool, atomWeight p x) = 1 := by
  simp [atomWeight, Fintype.sum_prod_type, Fin.sum_univ_two]
  ring

private lemma markWeight_eq_prod_atomWeight (p : Fin 2 → ℝ) (N : ℕ)
    (cls : Fin N → Fin 2) (coin : Fin N → Bool) :
    markWeight p N cls coin = ∏ i : Fin N, atomWeight p ((pairFnEquiv N (cls, coin)) i) := rfl

lemma stepExp_enabled_low_moments {p : Fin 2 → ℝ} (hp : ValidProb p) :
    StepAbsIntegrable p (fun w => p 1 - (winEnabled 1 w : ℝ)) ∧
      StepAbsIntegrable p (fun w => (p 1 - (winEnabled 1 w : ℝ)) ^ 2) ∧
      stepExp p (fun w => p 1 - (winEnabled 1 w : ℝ)) = 0 ∧
      stepExp p (fun w => (p 1 - (winEnabled 1 w : ℝ)) ^ 2) = p 1 := by
  have hp1 := hp 1
  have hbound1 : ∀ w : Window, |p 1 - (winEnabled 1 w : ℝ)| ≤ 1 * (1 + (w.1 : ℝ)) ^ 2 := by
    intro w
    have hle : winEnabled 1 w ≤ w.1 := by
      have := winOffered_add w
      have := winEnabled_le_winOffered 1 w
      omega
    have hleR : (winEnabled 1 w : ℝ) ≤ (w.1 : ℝ) := by exact_mod_cast hle
    have hnn : (0 : ℝ) ≤ (winEnabled 1 w : ℝ) := by positivity
    rw [abs_le]
    constructor <;> nlinarith
  have hbound2 : ∀ w : Window, |(p 1 - (winEnabled 1 w : ℝ)) ^ 2| ≤ 1 * (1 + (w.1 : ℝ)) ^ 2 := by
    intro w
    have hle : winEnabled 1 w ≤ w.1 := by
      have := winOffered_add w
      have := winEnabled_le_winOffered 1 w
      omega
    have hleR : (winEnabled 1 w : ℝ) ≤ (w.1 : ℝ) := by exact_mod_cast hle
    have hnn : (0 : ℝ) ≤ (winEnabled 1 w : ℝ) := by positivity
    rw [abs_of_nonneg (sq_nonneg _), one_mul]
    nlinarith
  have hint1 := stepAbsIntegrable_of_quad_bound hp 1 zero_le_one hbound1
  have hint2 := stepAbsIntegrable_of_quad_bound hp 1 zero_le_one hbound2
  set ind : Fin 2 × Bool → ℝ := fun x => if x.1 = 1 ∧ x.2 = true then 1 else 0
  have hind_sq : ∀ x, ind x * ind x = ind x := by
    intro x; simp only [ind]; split_ifs <;> norm_num
  have hq : (∑ x : Fin 2 × Bool, atomWeight p x * ind x) = p 1 / 2 := by
    simp [atomWeight, ind, Fintype.sum_prod_type]
    ring
  have hwin : ∀ (N : ℕ) (cls : Fin N → Fin 2) (coin : Fin N → Bool),
      (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ) =
        ∑ i : Fin N, ind (pairFnEquiv N (cls, coin) i) := by
    intro N cls coin
    rw [winEnabled_eq_card_filter]
    dsimp only [ind, pairFnEquiv, Equiv.coe_fn_mk]
    rw [Finset.sum_boole]
  have hm_all := fun N => prod_bernoulli_moments (atomWeight p) (sum_atomWeight p) ind hind_sq N
  have hpair1 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ)) =
        (N : ℝ) * (p 1 / 2) := by
    intro N
    rw [← Fintype.sum_prod_type']
    simp_rw [markWeight_eq_prod_atomWeight, hwin, Prod.mk.eta]
    rw [(pairFnEquiv N).sum_comp (fun f => (∏ i, atomWeight p (f i)) * ∑ i, ind (f i))]
    simpa [hq] using (hm_all N).2.1
  have hpair2 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ) ^ 2) =
        (N : ℝ) * (p 1 / 2) + (N : ℝ) * ((N : ℝ) - 1) * (p 1 / 2) ^ 2 := by
    intro N
    rw [← Fintype.sum_prod_type']
    simp_rw [markWeight_eq_prod_atomWeight, hwin, Prod.mk.eta]
    rw [(pairFnEquiv N).sum_comp (fun f => (∏ i, atomWeight p (f i)) * (∑ i, ind (f i)) ^ 2)]
    simpa [hq] using (hm_all N).2.2
  have hinner1 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (p 1 - (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ))) =
        p 1 - (N : ℝ) * (p 1 / 2) := by
    intro N
    simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, sum_cls_coin_markWeight,
      one_mul, hpair1]
  have hinner2 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (p 1 - (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ)) ^ 2) =
        (p 1) ^ 2 + (1 - 2 * p 1) * ((N : ℝ) * (p 1 / 2)) +
          ((N : ℝ) * ((N : ℝ) - 1) * (p 1 / 2) ^ 2) := by
    intro N
    have hexp : ∀ (cls : Fin N → Fin 2) (coin : Fin N → Bool),
        markWeight p N cls coin * (p 1 - (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ)) ^ 2 =
          markWeight p N cls coin * (p 1) ^ 2 -
            2 * p 1 * (markWeight p N cls coin * (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ)) +
            markWeight p N cls coin * (winEnabled 1 ⟨N, (cls, coin)⟩ : ℝ) ^ 2 := by
      intros; ring
    simp_rw [hexp, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul,
      ← Finset.mul_sum, sum_cls_coin_markWeight, one_mul, hpair1, hpair2]
    ring
  refine ⟨hint1, hint2, ?_, ?_⟩
  · unfold stepExp
    simp_rw [hinner1]
    have hs := ((hasSum_poissonPMFReal 2).mul_right (p 1)).sub
      ((hasSum_poissonPMFReal_mul_nat 2).mul_right (p 1 / 2))
    exact (hs.congr_fun fun N => by ring).tsum_eq.trans (by norm_num; ring)
  · unfold stepExp
    simp_rw [hinner2]
    have hs0 := (hasSum_poissonPMFReal 2).mul_right ((p 1) ^ 2)
    have hs1 := (hasSum_poissonPMFReal_mul_nat 2).mul_right ((1 - 2 * p 1) * (p 1 / 2))
    have hs2 := (hasSum_poissonPMFReal_mul_falling2 2).mul_right ((p 1 / 2) ^ 2)
    have hs := (hs0.add hs1).add hs2
    exact (hs.congr_fun fun N => by ring).tsum_eq.trans (by norm_num; ring)

lemma stepExp_offered_high_moments {p : Fin 2 → ℝ} (hp : ValidProb p) :
    StepAbsIntegrable p (fun w => (winOffered 0 w : ℝ) - 1) ∧
      StepAbsIntegrable p (fun w => ((winOffered 0 w : ℝ) - 1) ^ 2) ∧
      stepExp p (fun w => (winOffered 0 w : ℝ) - 1) = 0 ∧
      stepExp p (fun w => ((winOffered 0 w : ℝ) - 1) ^ 2) = 1 := by
  have hbound1 : ∀ w : Window, |(winOffered 0 w : ℝ) - 1| ≤ 1 * (1 + (w.1 : ℝ)) ^ 2 := by
    intro w
    have hle : winOffered 0 w ≤ w.1 := by have := winOffered_add w; omega
    have hleR : (winOffered 0 w : ℝ) ≤ (w.1 : ℝ) := by exact_mod_cast hle
    have hnn : (0 : ℝ) ≤ (winOffered 0 w : ℝ) := by positivity
    rw [abs_le]; constructor <;> nlinarith
  have hbound2 : ∀ w : Window, |((winOffered 0 w : ℝ) - 1) ^ 2| ≤ 1 * (1 + (w.1 : ℝ)) ^ 2 := by
    intro w
    have hle : winOffered 0 w ≤ w.1 := by have := winOffered_add w; omega
    have hleR : (winOffered 0 w : ℝ) ≤ (w.1 : ℝ) := by exact_mod_cast hle
    have hnn : (0 : ℝ) ≤ (winOffered 0 w : ℝ) := by positivity
    rw [abs_of_nonneg (sq_nonneg _), one_mul]
    nlinarith
  have hint1 := stepAbsIntegrable_of_quad_bound hp 1 zero_le_one hbound1
  have hint2 := stepAbsIntegrable_of_quad_bound hp 1 zero_le_one hbound2
  set ind : Fin 2 × Bool → ℝ := fun x => if x.1 = 0 then 1 else 0
  have hind_sq : ∀ x, ind x * ind x = ind x := by
    intro x; simp only [ind]; split_ifs <;> norm_num
  have hq : (∑ x : Fin 2 × Bool, atomWeight p x * ind x) = 1 / 2 := by
    simp [atomWeight, ind, Fintype.sum_prod_type]
    ring
  have hwin : ∀ (N : ℕ) (cls : Fin N → Fin 2) (coin : Fin N → Bool),
      (winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) =
        ∑ i : Fin N, ind (pairFnEquiv N (cls, coin) i) := by
    intro N cls coin
    rw [winOffered_eq_card_filter]
    dsimp only [ind, pairFnEquiv, Equiv.coe_fn_mk]
    rw [Finset.sum_boole]
  have hm_all := fun N => prod_bernoulli_moments (atomWeight p) (sum_atomWeight p) ind hind_sq N
  have hpair1 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (winOffered 0 ⟨N, (cls, coin)⟩ : ℝ)) =
        (N : ℝ) * (1 / 2) := by
    intro N
    rw [← Fintype.sum_prod_type']
    simp_rw [markWeight_eq_prod_atomWeight, hwin, Prod.mk.eta]
    rw [(pairFnEquiv N).sum_comp (fun f => (∏ i, atomWeight p (f i)) * ∑ i, ind (f i))]
    simpa [hq] using (hm_all N).2.1
  have hpair2 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * (winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) ^ 2) =
        (N : ℝ) * (1 / 2) + (N : ℝ) * ((N : ℝ) - 1) * (1 / 2) ^ 2 := by
    intro N
    rw [← Fintype.sum_prod_type']
    simp_rw [markWeight_eq_prod_atomWeight, hwin, Prod.mk.eta]
    rw [(pairFnEquiv N).sum_comp (fun f => (∏ i, atomWeight p (f i)) * (∑ i, ind (f i)) ^ 2)]
    simpa [hq] using (hm_all N).2.2
  have hinner1 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * ((winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) - 1)) =
        (N : ℝ) * (1 / 2) - 1 := by
    intro N
    simp_rw [mul_sub, mul_one, Finset.sum_sub_distrib, sum_cls_coin_markWeight, hpair1]
  have hinner2 : ∀ N : ℕ,
      (∑ cls : Fin N → Fin 2, ∑ coin : Fin N → Bool,
        markWeight p N cls coin * ((winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) - 1) ^ 2) =
        1 - (N : ℝ) * (1 / 2) + (N : ℝ) * ((N : ℝ) - 1) * (1 / 4) := by
    intro N
    have hexp : ∀ (cls : Fin N → Fin 2) (coin : Fin N → Bool),
        markWeight p N cls coin * ((winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) - 1) ^ 2 =
          markWeight p N cls coin -
            2 * (markWeight p N cls coin * (winOffered 0 ⟨N, (cls, coin)⟩ : ℝ)) +
            markWeight p N cls coin * (winOffered 0 ⟨N, (cls, coin)⟩ : ℝ) ^ 2 := by
      intros; ring
    simp_rw [hexp, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
      sum_cls_coin_markWeight, hpair1, hpair2]
