theorem Law4.exists_smul_eq_qmPeriodLattice_translate_of_isUnitOf
    {a b : ℚ} (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ)
    (Λ R J' : Submodule ℤ ℍ[ℚ, a, b])
    (hΛmul : ∀ ⦃y z : ℍ[ℚ, a, b]⦄, y ∈ Λ → z ∈ Λ → y * z ∈ Λ) (hRΛ : R ≤ Λ)
    (hJ'R : ∀ x ∈ Λ, x ∈ R ↔ ∀ y ∈ J', y * x ∈ J')
    (t₀ t u₁ : ℍ[ℚ, a, b]) (hu₁ : IsUnitOf R u₁)
    (g₁ : GL (Fin 2) ℝ) (hg₁ : (g₁ : Matrix (Fin 2) (Fin 2) ℝ) = ι u₁) (hdet : 0 < g₁.det.val)
    (hΛtu : ∀ x : ℍ[ℚ, a, b], (∃ m ∈ Λ, m * (t₀ * u₁) = x) ↔ ∃ m ∈ Λ, m * t = x)
    (L LC LK : Submodule ℤ (Fin 2 → ℂ)) (τ₁ : UpperHalfPlane) (c₁ : ℂ) (hc₁ : c₁ ≠ 0) (ℓ : ℕ) (hℓ0 : ((ℓ : ℕ) : ℂ) ≠ 0)
    (hL : c₁ • L = qmPeriodLattice ι Λ τ₁) (hC : c₁ • LC = qmPeriodLattice ι J' τ₁)
    (hK : ∀ v : Fin 2 → ℂ, v ∈ (c₁ * (ℓ : ℂ)) • LK ↔ ∃ y ∈ Λ, qmPeriodMap ι τ₁ (y * t) = v) :
    ∃ (τ : UpperHalfPlane) (c : ℂ), c ≠ 0 ∧ c • L = qmPeriodLattice ι Λ τ ∧ c • LC = qmPeriodLattice ι J' τ ∧
      ∀ v : Fin 2 → ℂ, v ∈ (c * (ℓ : ℂ)) • LK ↔ ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = v := by
  obtain ⟨h1, -, h3⟩ :=
    QuaternionAlgebra.denom_smul_qmPeriodMap_smul_eq_and_denom_smul_qmPeriodLattice_smul_eq ι Λ u₁ g₁ hg₁ hdet τ₁
  obtain ⟨-, h2J, -⟩ :=
    QuaternionAlgebra.denom_smul_qmPeriodMap_smul_eq_and_denom_smul_qmPeriodLattice_smul_eq ι J' u₁ g₁ hg₁ hdet τ₁
  set d : ℂ := UpperHalfPlane.denom g₁ τ₁ with hd_def
  have hd : d ≠ 0 := UpperHalfPlane.denom_ne_zero g₁ τ₁

  obtain ⟨hu₁R, v₁, hv₁R, huv, hvu⟩ := hu₁
  have hu₁Λ : IsUnitOf Λ u₁ := ⟨hRΛ hu₁R, v₁, hRΛ hv₁R, huv, hvu⟩
  have hJu : ∀ y ∈ J', y * u₁ ∈ J' := (hJ'R u₁ (hRΛ hu₁R)).1 hu₁R
  have hJv : ∀ y ∈ J', y * v₁ ∈ J' := (hJ'R v₁ (hRΛ hv₁R)).1 hv₁R

  have hΛeq : d • qmPeriodLattice ι Λ (g₁ • τ₁) = qmPeriodLattice ι Λ τ₁ := h3 hΛmul hu₁Λ
  have hJeq : d • qmPeriodLattice ι J' (g₁ • τ₁) = qmPeriodLattice ι J' τ₁ := by
    ext v
    rw [h2J, mem_qmPeriodLattice_iff]
    constructor
    · rintro ⟨y, hy, rfl⟩; exact ⟨y * u₁, hJu y hy, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y * v₁, hJv y hy, by rw [mul_assoc, hvu, mul_one]⟩
  refine ⟨g₁ • τ₁, d⁻¹ * c₁, mul_ne_zero (inv_ne_zero hd) hc₁, ?_, ?_, ?_⟩
  · rw [mul_smul, hL, ← hΛeq, smul_smul, inv_mul_cancel₀ hd, one_smul]
  · rw [mul_smul, hC, ← hJeq, smul_smul, inv_mul_cancel₀ hd, one_smul]
  · intro v
    rw [mul_assoc, mul_smul, Submodule.mem_smul_pointwise_iff_exists]
    constructor
    · rintro ⟨w, hw, rfl⟩
      obtain ⟨y, hy, hyw⟩ := (hK w).1 hw
      obtain ⟨m, hm, hmt⟩ := (hΛtu (y * t)).2 ⟨y, hy, rfl⟩
      refine ⟨m, hm, ?_⟩
      have h := h1 (m * t₀)
      rw [mul_assoc, hmt, hyw] at h

      rw [← h, smul_smul, inv_mul_cancel₀ hd, one_smul]
    · rintro ⟨m, hm, hmv⟩
      refine ⟨d • v, ?_, by rw [smul_smul, inv_mul_cancel₀ hd, one_smul]⟩
      obtain ⟨y, hy, hyt⟩ := (hΛtu (m * (t₀ * u₁))).1 ⟨m, hm, rfl⟩
      refine (hK (d • v)).2 ⟨y, hy, ?_⟩
      rw [hyt, ← mul_assoc, ← h1 (m * t₀), hmv]

theorem Law4.nrd_mul' {a b : ℚ} (x y : ℍ[ℚ, a, b]) : nrd (x * y) = nrd x * nrd y := by
  obtain ⟨x₀, x₁, x₂, x₃⟩ := x
  obtain ⟨y₀, y₁, y₂, y₃⟩ := y
  simp only [nrd, QuaternionAlgebra.mk_mul_mk]
  ring

theorem Law4.exists_translate_to_standard_line
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (hN : Squarefree N) (R : Submodule ℤ ℍ[ℚ, a, b]) (hR : IsEichlerOrder R N) (hRΛ : R ≤ Λ)
    (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ) (hι : Function.Injective ι)
    (J' : Submodule ℤ ℍ[ℚ, a, b])
    (hJ' : Λ ≤ J' ∧ (∀ x ∈ Λ, ∀ y ∈ J', x * y ∈ J') ∧ (∀ y ∈ J', ((N : ℤ) • y) ∈ Λ) ∧
      Λ.toAddSubgroup.relIndex J'.toAddSubgroup = N ^ 2 ∧ (∀ x ∈ Λ, x ∈ R ↔ ∀ y ∈ J', y * x ∈ J'))
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓq : ℓ ≠ q) (hℓq' : ℓ ≠ q')
    (t₀ : ℍ[ℚ, a, b]) (ht₀ : t₀ ∈ R) (hnt₀ : nrd t₀ = (ℓ : ℚ))
    (hlt₀ : ∀ x : ℍ[ℚ, a, b], (∃ j ∈ J', ∃ m ∈ Λ, (ℓ : ℤ) • j + m * t₀ = x) ↔ ∃ j ∈ J', j * t₀ = x)
    (L LC M : Submodule ℤ (Fin 2 → ℂ)) (τ₁ : UpperHalfPlane) (c₁ : ℂ) (hc₁ : c₁ ≠ 0)
    (hL : c₁ • L = qmPeriodLattice ι Λ τ₁) (hC : c₁ • LC = qmPeriodLattice ι J' τ₁)
    (hM : M ≤ qmPeriodLattice ι Λ τ₁ ∧ (∀ v ∈ qmPeriodLattice ι Λ τ₁, (ℓ : ℤ) • v ∈ M) ∧
        (∀ y ∈ Λ, ∀ v ∈ M, ((ι y).map (algebraMap ℝ ℂ)).mulVec v ∈ M) ∧
        M.toAddSubgroup.relIndex (qmPeriodLattice ι Λ τ₁).toAddSubgroup = ℓ ^ 2 ∧
        (∀ v ∈ qmPeriodLattice ι J' τ₁, (ℓ : ℂ) • v ∈ M → v ∈ qmPeriodLattice ι Λ τ₁)) :
    ∃ (τ : UpperHalfPlane) (c : ℂ), c ≠ 0 ∧ c • L = qmPeriodLattice ι Λ τ ∧ c • LC = qmPeriodLattice ι J' τ ∧
      ∀ v : Fin 2 → ℂ, v ∈ (c * c₁⁻¹) • M ↔ ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = v := by
  obtain ⟨hi, -, hiii⟩ :=
    QuaternionAlgebra.IsEichlerOrder.forall_le_qmPeriodLattice_transversal_iff_exists_mem_nrd_eq
      hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι J' hJ' τ₁ ℓ hℓ hℓq hℓq'
  obtain ⟨t, htR, hnt, hMt, hlevτ⟩ := (hi M).1 hM

  have hlevL : ∀ v : Fin 2 → ℂ, (∃ w ∈ qmPeriodLattice ι J' τ₁, ∃ y ∈ Λ, (ℓ : ℂ) • w + qmPeriodMap ι τ₁ (y * t) = v) ↔
      ∃ y ∈ J', qmPeriodMap ι τ₁ (y * t) = v := by
    intro v
    rw [← hlevτ v]
    constructor
    · rintro ⟨w, hw, y, hy, rfl⟩
      exact ⟨w, hw, qmPeriodMap ι τ₁ (y * t), (hMt _).2 ⟨y, hy, rfl⟩, rfl⟩
    · rintro ⟨w, hw, m, hm, rfl⟩
      obtain ⟨y, hy, rfl⟩ := (hMt m).1 hm
      exact ⟨w, hw, y, hy, rfl⟩
  have hlevB := (QuaternionAlgebra.forall_qmPeriodLattice_levelIdentity_iff_forall_levelIdentity hB ι hι Λ J' t ℓ τ₁).1 hlevL

  obtain ⟨-, hDC⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_nrd_eq_levelIdentity_and_forall_exists_isUnitOf_nrd_eq_one_mul_mul_iff_of_levelIdentity
      hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ J' hJ' ℓ hℓ hℓq hℓq'
  obtain ⟨u₁, hu₁, hnu₁, hΛtu⟩ := hDC t₀ t ht₀ htR hnt₀ hnt hlt₀ hlevB

  obtain ⟨g₀, hg₀, hdet₀, -, -⟩ := hiii t₀ ht₀ hnt₀
  have ht₀u : t₀ * u₁ ∈ R := hR.isOrder.mul_mem ht₀ hu₁.1
  have hnt₀u : nrd (t₀ * u₁) = (ℓ : ℚ) := by rw [Law4.nrd_mul', hnt₀, hnu₁, mul_one]
  obtain ⟨g₂, hg₂, hdet₂, -, -⟩ := hiii (t₀ * u₁) ht₀u hnt₀u
  have hg₁ : ((g₀⁻¹ * g₂ : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι u₁ := by
    rw [Units.val_mul, hg₂, map_mul, ← hg₀, ← mul_assoc, Units.inv_mul, one_mul]
  have hdet₁ : 0 < (g₀⁻¹ * g₂).det.val := by
    rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val]
    exact mul_pos (inv_pos.2 hdet₀) hdet₂

  have hℓ0 : ((ℓ : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.2 hℓ.ne_zero
  have hcℓ : c₁ * (ℓ : ℂ) ≠ 0 := mul_ne_zero hc₁ hℓ0
  have hK : ∀ v : Fin 2 → ℂ, v ∈ (c₁ * (ℓ : ℂ)) • ((c₁ * (ℓ : ℂ))⁻¹ • M) ↔ ∃ y ∈ Λ, qmPeriodMap ι τ₁ (y * t) = v := by
    intro v
    rw [smul_smul, mul_inv_cancel₀ hcℓ, one_smul]
    exact hMt v
  obtain ⟨τ, c, hc, hL', hC', hK'⟩ :=
    Law4.exists_smul_eq_qmPeriodLattice_translate_of_isUnitOf ι Λ R J' hΛ.isOrder.mul_mem hRΛ hJ'.2.2.2.2 t₀ t u₁ hu₁
      (g₀⁻¹ * g₂) hg₁ hdet₁ hΛtu L LC ((c₁ * (ℓ : ℂ))⁻¹ • M) τ₁ c₁ hc₁ ℓ hℓ0 hL hC hK
  refine ⟨τ, c, hc, hL', hC', fun v => ?_⟩
  rw [← hK' v, smul_smul]
  congr! 2
  field_simp

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (ℓ : ℕ) (hℓ : ℓ.Prime)

    (hℓN : ℓ ∣ N)

    (hN : Squarefree N) (R : Submodule ℤ ℍ[ℚ, a, b]) (hR : IsEichlerOrder R N) (hRΛ : R ≤ Λ)
    (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ) (hι : Function.Injective ι)
    (𝒳 : Scheme.{0}) (f : 𝒳 ⟶ Spec (CommRingCat.of ℂ))
    (pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of ℂ)),
      FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s f)
    (h𝒳 : IsCoarseModuliT Λ N ℓ 𝒳 f pt)
    (hsep : IsSeparated f) (hqc : QuasiCompact f) (hlft : LocallyOfFiniteType f) (hsm : SmoothOfRelativeDimension 1 f) :
    IsIntegral 𝒳 := by
  classical

  have hℓq : ℓ ≠ q := fun h => hqN (h ▸ hℓN)
  have hℓq' : ℓ ≠ q' := fun h => hq'N (h ▸ hℓN)
  have hℓ0 : ((ℓ : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.2 hℓ.ne_zero

  obtain ⟨latt, e, hL1, hE1, hE2, hH1, hH2, hH3, hAN, hCOV⟩ :=
    CerednikDrinfeld.QM.exists_latticeMap_pointEquiv_hom_iff_smul_le_analytic hB Λ hΛ ι hι hqq' (N := N) hqN hq'N

  have hP2 := fun E : FakeEllipticCurve Λ N ℂ =>
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_submodule_forall_mem_iff_factorsThrough_lev_of_pointEquiv
      hB Λ hΛ ι hι hqq' hqN hq'N latt e hL1 hE1 hE2 E
  choose lattLev hLev using hP2

  obtain ⟨J', hJ'⟩ := QuaternionAlgebra.IsEichlerOrder.exists_levelModule hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι

  obtain ⟨⟨t₀, ht₀, hnt₀, hlt₀⟩, -⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_nrd_eq_levelIdentity_and_forall_exists_isUnitOf_nrd_eq_one_mul_mul_iff_of_levelIdentity
      hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ J' hJ' ℓ hℓ hℓq hℓq'

  have hstd : ∀ E : FakeEllipticCurve Λ N ℂ, ∃ (τ : UpperHalfPlane) (c : ℂ), c ≠ 0 ∧
      c • latt E = qmPeriodLattice ι Λ τ ∧ c • lattLev E = qmPeriodLattice ι J' τ := fun E =>
    QuaternionAlgebra.IsEichlerOrder.exists_smul_eq_qmPeriodLattice_pair_of_forall_mulVec_mem hqN hq'N hqq' hB Λ hΛ hN R
      hR hRΛ ι hι J' hJ' (latt E) (lattLev E) (hL1 E).1 (hL1 E).2 (hLev E).2.1 (hLev E).2.2.2.1 (hLev E).2.2.1
      (hLev E).2.2.2.2
  choose τs cs hcs hcsL hcsM using hstd

  have hLevUniq : ∀ J'' : Submodule ℤ ℍ[ℚ, a, b],
      (Λ ≤ J'' ∧ (∀ x ∈ Λ, ∀ y ∈ J'', x * y ∈ J'') ∧ (∀ y ∈ J'', ((N : ℤ) • y) ∈ Λ) ∧
        Λ.toAddSubgroup.relIndex J''.toAddSubgroup = N ^ 2 ∧ (∀ x ∈ Λ, x ∈ R ↔ ∀ y ∈ J'', y * x ∈ J'')) → J'' = J' :=
    fun J'' hJ'' => (QuaternionAlgebra.IsEichlerOrder.levelModule_unique hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι J' J'' hJ' hJ'').symm

  have hmemLev : ∀ (E : FakeEllipticCurve Λ N ℂ) (c : ℂ) (w : Fin 2 → ℂ),
      (∃ v : Fin 2 → ℂ, (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f,
          FactorsThrough E.lev P ∧ e E P = (v : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup)) ∧ c • v = w) ↔
        w ∈ c • lattLev E := by
    intro E c w
    rw [Submodule.mem_smul_pointwise_iff_exists]
    constructor
    · rintro ⟨v, hv, hcv⟩; exact ⟨v, ((hLev E).1 v).2 hv, hcv⟩
    · rintro ⟨v, hv, hcv⟩; exact ⟨v, ((hLev E).1 v).1 hv, hcv⟩

  have hFIB : ∀ (E : FakeEllipticCurve Λ N ℂ) (τ : UpperHalfPlane) (c : ℂ), c ≠ 0 →
      c • latt E = qmPeriodLattice ι Λ τ →
      ((∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f,
              FactorsThrough E.lev P ∧ e E P = (v : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam) →
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f,
              FactorsThrough E.lev P ∧ e E P = (v : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r))) ↔
        c • lattLev E = qmPeriodLattice ι J' τ) := by
    intro E τ c hc hcL
    have hLM : qmPeriodLattice ι Λ τ ≤ c • lattLev E := by
      rw [← hcL, Submodule.pointwise_smul_def, Submodule.pointwise_smul_def]
      exact Submodule.map_mono (hLev E).2.1
    have hMN : ∀ v ∈ c • lattLev E, ((N : ℤ) • v) ∈ qmPeriodLattice ι Λ τ := by
      intro v hv
      rw [Submodule.mem_smul_pointwise_iff_exists] at hv
      obtain ⟨w, hw, rfl⟩ := hv
      rw [smul_comm, ← hcL]
      exact Submodule.smul_mem_pointwise_smul _ c _ ((hLev E).2.2.2.1 w hw)
    have hMstab : ∀ x ∈ Λ, ∀ v ∈ c • lattLev E, ((ι x).map (algebraMap ℝ ℂ)).mulVec v ∈ c • lattLev E := by
      intro x hx v hv
      rw [Submodule.mem_smul_pointwise_iff_exists] at hv
      obtain ⟨w, hw, rfl⟩ := hv
      rw [Matrix.mulVec_smul]
      exact Submodule.smul_mem_pointwise_smul _ c _ ((hLev E).2.2.1 x hx w hw)
    have hidx : (qmPeriodLattice ι Λ τ).toAddSubgroup.relIndex (c • lattLev E).toAddSubgroup = N ^ 2 := by
      rw [← hcL, Law4.relIndex_smul hc]
      exact (hLev E).2.2.2.2
    have hbr := QuaternionAlgebra.IsEichlerOrder.forall_mem_imp_mem_iff_exists_levelModule_qmPeriodLattice_eq
      hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι τ (c • lattLev E) hLM hMN hMstab hidx
    simp only [hmemLev]
    rw [hbr]
    constructor
    · rintro ⟨J'', hJ'', hM⟩
      rwa [hLevUniq J'' hJ''] at hM
    · intro h
      exact ⟨J', hJ', h⟩

  have hK := fun u : FakeEllipticCurve.WithExtraLevel Λ N ℓ ℂ =>
    CerednikDrinfeld.QM.FakeEllipticCurve.ExtraLevel.exists_submodule_forall_mem_iff_factorsThrough_transversal_of_pointEquiv
      hB Λ hΛ ι latt e hL1 hE1 hE2 lattLev hLev ℓ hℓ u.1 u.2 (τs u.1) (cs u.1) (hcs u.1) (hcsL u.1)
  choose lattK hLKmem hLKle hLKadm1 hLKadm2 hLKadm3 hLKidx hLKtr using hK

  have hK2 := CerednikDrinfeld.QM.FakeEllipticCurve.WithExtraLevel.iso_iff_exists_smul_latt_eq_and_smul_lattLev_eq_and_smul_lattK_eq_of_pointEquiv
    hB Λ hΛ ι hι hqq' hqN hq'N latt e hL1 hE1 hE2 hH1 hH2 hH3 lattLev hLev ℓ lattK hLKmem

  have hmemK : ∀ (u : FakeEllipticCurve.WithExtraLevel Λ N ℓ ℂ) (τ : UpperHalfPlane) (c : ℂ),
      (∀ v : Fin 2 → ℂ,
          FactorsThrough u.2.levK ((e u.1).symm (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ↔
            ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c * (ℓ : ℂ)) • v) →
      ∀ v : Fin 2 → ℂ, v ∈ lattK u ↔ ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c * (ℓ : ℂ)) • v := by
    intro u τ c hKc v
    rw [hLKmem u v, hKc v]

  have hiso_stdT : ∀ (u u' : FakeEllipticCurve.WithExtraLevel Λ N ℓ ℂ) (τ : UpperHalfPlane) (c c' : ℂ), c ≠ 0 →
      c • latt u.1 = qmPeriodLattice ι Λ τ → (∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam) →
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r))) → (∀ v : Fin 2 → ℂ,
          FactorsThrough u.2.levK ((e u.1).symm (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ↔
            ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c * (ℓ : ℂ)) • v) → c' ≠ 0 →
      c' • latt u'.1 = qmPeriodLattice ι Λ τ → (∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u'.1.f,
              FactorsThrough u'.1.lev P ∧ e u'.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u'.1).toAddSubgroup)) ∧
            c' • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam) →
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u'.1.f,
              FactorsThrough u'.1.lev P ∧ e u'.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u'.1).toAddSubgroup)) ∧
            c' • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r))) → (∀ v : Fin 2 → ℂ,
          FactorsThrough u'.2.levK ((e u'.1).symm (v : (Fin 2 → ℂ) ⧸ (latt u'.1).toAddSubgroup)) ↔
            ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c' * (ℓ : ℂ)) • v) →
      FakeEllipticCurve.WithExtraLevel.Iso u u' := by
    intro u u' τ c c' hc hL hF hKc hc' hL' hF' hKc'
    have hM := (hFIB u.1 τ c hc hL).1 hF
    have hM' := (hFIB u'.1 τ c' hc' hL').1 hF'
    have hcc : c' * (ℓ : ℂ) * (c'⁻¹ * c) = c * (ℓ : ℂ) := by
      field_simp
    refine (hK2 u u').2 ⟨c'⁻¹ * c, mul_ne_zero (inv_ne_zero hc') hc, ?_, ?_, ?_⟩
    · rw [mul_smul, hL, ← hL', smul_smul, inv_mul_cancel₀ hc', one_smul]
    · rw [mul_smul, hM, ← hM', smul_smul, inv_mul_cancel₀ hc', one_smul]
    · ext w
      rw [Submodule.mem_smul_pointwise_iff_exists, hmemK u' τ c' hKc' w]
      constructor
      · rintro ⟨v, hv, rfl⟩
        rw [hmemK u τ c hKc v] at hv
        rwa [smul_smul, hcc]
      · intro hw
        refine ⟨(c'⁻¹ * c)⁻¹ • w, ?_, by rw [smul_smul, mul_inv_cancel₀ (mul_ne_zero (inv_ne_zero hc') hc), one_smul]⟩
        rw [hmemK u τ c hKc, smul_smul, ← hcc, mul_assoc, mul_inv_cancel₀ (mul_ne_zero (inv_ne_zero hc') hc), mul_one]
        exact hw

  have hq0 : q ≠ 0 := (Fact.out : q.Prime).ne_zero
  have hq0' : q' ≠ 0 := (Fact.out : q'.Prime).ne_zero
  have hN0 : N ≠ 0 := NeZero.ne N
  have hm3 : 3 ≤ 3 * ℓ := Nat.le_mul_of_pos_right 3 hℓ.pos
  have hℓm : ℓ ∣ 3 * ℓ := Dvd.intro_left 3 rfl
  have hNu : IsUnit ((N : ℕ) : ℂ) := isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 hN0)
  have hmu : IsUnit (((3 * ℓ : ℕ) : ℕ) : ℂ) :=
    isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 (Nat.mul_ne_zero (by norm_num) hℓ.ne_zero))
  have hqq'u : IsUnit ((q * q' : ℕ) : ℂ) := isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 (Nat.mul_ne_zero hq0 hq0'))
  obtain ⟨M, πM, ptF, hM, -, -, -, -, hsmM⟩ :=
    CerednikDrinfeld.QM.exists_isFineModuli_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N (3 * ℓ) hm3 ℂ hNu hmu
      (isUnit_iff_ne_zero.2 (by norm_num)) (isUnit_iff_ne_zero.2 (by norm_num))
  have hsm1 : SmoothOfRelativeDimension 1 πM := hsmM hqq'u
  have hprop : IsProper πM :=
    CerednikDrinfeld.QM.IsFineModuli.isProper_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N (3 * ℓ) hm3 ℂ hNu hmu
      (isUnit_iff_ne_zero.2 (by norm_num)) (isUnit_iff_ne_zero.2 (by norm_num)) hM

  have hchart := CerednikDrinfeld.QM.IsFineModuli.forall_exists_algebraicFamily_withExtraLevel_isPullback_smul_latt_eq_of_analytic
    hB Λ hΛ ι hι hqq' hqN hq'N hN R hR hRΛ J' hJ' ℓ hℓ hℓq hℓq' t₀ ht₀ hnt₀ hlt₀ latt e hL1 hE1 hE2 hH1 hH2 hH3 hAN hCOV
    (3 * ℓ) hm3 hℓm M πM ptF hM hsm1 hprop

  have hstdT : ∀ τ : UpperHalfPlane, ∃ (u : FakeEllipticCurve.WithExtraLevel Λ N ℓ ℂ) (c : ℂ), c ≠ 0 ∧
      c • latt u.1 = qmPeriodLattice ι Λ τ ∧ (∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam) →
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r))) ∧ (∀ v : Fin 2 → ℂ,
          FactorsThrough u.2.levK ((e u.1).symm (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ↔
            ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c * (ℓ : ℂ)) • v) := by
    intro τ
    obtain ⟨S, _, _, _, _, 𝒜, W, -, hτ, hW⟩ := hchart τ
    obtain ⟨E', -, -, c, hc, hL, hF, hKc⟩ := hW τ hτ
    exact ⟨E', c, hc, hL, hF, hKc⟩
  choose uτ cτ hcτ hLτ hFτ hKτ using hstdT

  let cl : UpperHalfPlane → ↥𝒳 := fun τ => (pt ℂ (𝟙 _) (uτ τ)).1 (IsLocalRing.closedPoint ℂ)

  have hsec : ∀ s : Spec (CommRingCat.of ℂ) ⟶ 𝒳, s ≫ f = 𝟙 _ → ∃ τ : UpperHalfPlane, (pt ℂ (𝟙 _) (uτ τ)).1 = s := by
    intro s hs
    obtain ⟨u, hu⟩ := h𝒳.ptT_surjective ℂ (𝟙 _) ⟨s, hs⟩

    have htr : ∀ v ∈ qmPeriodLattice ι J' (τs u.1), (ℓ : ℂ) • v ∈ (cs u.1 * ℓ) • lattK u →
        v ∈ qmPeriodLattice ι Λ (τs u.1) := by
      intro v hv hℓv
      rw [← hcsM u.1, Submodule.mem_smul_pointwise_iff_exists] at hv
      obtain ⟨w, hw, rfl⟩ := hv
      rw [← hcsL u.1]
      refine Submodule.smul_mem_pointwise_smul _ (cs u.1) _ (hLKtr u w hw ?_)
      rwa [smul_smul] at hℓv
    obtain ⟨τ, c, hc, hcL, hcC, hcK⟩ := Law4.exists_translate_to_standard_line hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι
      J' hJ' ℓ hℓ hℓq hℓq' t₀ ht₀ hnt₀ hlt₀ (latt u.1) (lattLev u.1) ((cs u.1 * ℓ) • lattK u) (τs u.1) (cs u.1)
      (hcs u.1) (hcsL u.1) (hcsM u.1) ⟨hLKadm1 u, hLKadm2 u, hLKadm3 u, hLKidx u, htr⟩

    have hF : (∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam) →
          (∃ v : Fin 2 → ℂ,
            (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) u.1.f,
              FactorsThrough u.1.lev P ∧ e u.1 P = (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ∧
            c • v = ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r))) := (hFIB u.1 τ c hc hcL).2 hcC
    have hcc : c * (cs u.1)⁻¹ * (cs u.1 * (ℓ : ℂ)) = c * (ℓ : ℂ) := by
      rw [mul_assoc, ← mul_assoc (cs u.1)⁻¹, inv_mul_cancel₀ (hcs u.1), one_mul]
    have hKc : (∀ v : Fin 2 → ℂ,
          FactorsThrough u.2.levK ((e u.1).symm (v : (Fin 2 → ℂ) ⧸ (latt u.1).toAddSubgroup)) ↔
            ∃ y ∈ Λ, qmPeriodMap ι τ (y * t₀) = (c * (ℓ : ℂ)) • v) := by
      intro v
      rw [← hLKmem u v, ← hcK, smul_smul, hcc, Submodule.mem_smul_pointwise_iff_exists]
      constructor
      · intro hv; exact ⟨v, hv, rfl⟩
      · rintro ⟨w, hw, hwv⟩
        rwa [smul_right_injective (Fin 2 → ℂ) (mul_ne_zero hc hℓ0) hwv] at hw
    refine ⟨τ, ?_⟩
    have hI : FakeEllipticCurve.WithExtraLevel.Iso (uτ τ) u :=
      hiso_stdT _ _ τ (cτ τ) c (hcτ τ) (hLτ τ) (hFτ τ) (hKτ τ) hc hcL hF hKc
    rw [h𝒳.ptT_iso ℂ (𝟙 _) _ _ hI, hu]

  have hloc : ∀ τ₀ : UpperHalfPlane, ∃ W ∈ 𝓝 τ₀, ∃ Z : Set ↥𝒳, _root_.IsConnected Z ∧ ∀ τ ∈ W, cl τ ∈ Z := by
    intro τ₀
    obtain ⟨S, _, _, _, _, 𝒜, W, hWo, hτ₀, hW⟩ := hchart τ₀
    let sS : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of ℂ) := Spec.map (CommRingCat.ofHom (algebraMap ℂ S))
    refine ⟨W, hWo.mem_nhds hτ₀, Set.range (pt S sS 𝒜).1, ?_, ?_⟩
    · exact isConnected_range (pt S sS 𝒜).1.continuous
    · intro τ hτ
      obtain ⟨E', σ, hpb, c', hc', hL', hF', hKc'⟩ := hW τ hτ
      have hI : FakeEllipticCurve.WithExtraLevel.Iso (uτ τ) E' :=
        hiso_stdT _ _ τ (cτ τ) c' (hcτ τ) (hLτ τ) (hFτ τ) (hKτ τ) hc' hL' hF' hKc'
      have hcomp : Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ sS = 𝟙 _ := by
        simp only [sS]
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap,
          CommRingCat.ofHom_id, Spec.map_id]
      have hpp := h𝒳.ptT_pullback S ℂ σ.toRingHom sS (𝟙 _) hcomp 𝒜 E' hpb
      show (pt ℂ (𝟙 _) (uτ τ)).1 (IsLocalRing.closedPoint ℂ) ∈ Set.range (pt S sS 𝒜).1
      rw [h𝒳.ptT_iso ℂ (𝟙 _) _ _ hI, hpp, Scheme.Hom.comp_apply]
      exact ⟨_, rfl⟩

  have hdense : ∀ U : Set ↥𝒳, IsOpen U → U.Nonempty → ∃ τ, cl τ ∈ U := by
    intro U hU hne
    haveI := hlft
    obtain ⟨x, hxU, s, hs, hsx⟩ :=
      (AlgebraicGeometry.dense_setOf_exists_section_of_isAlgClosed f).inter_open_nonempty U hU hne
    obtain ⟨τ, hτ⟩ := hsec s hs
    refine ⟨τ, ?_⟩
    show (pt ℂ (𝟙 _) (uτ τ)).1 (IsLocalRing.closedPoint ℂ) ∈ U
    rw [hτ, hsx]
    exact hxU

  haveI : PreconnectedSpace ↥𝒳 := Law4.preconnectedSpace_of_charts cl hdense hloc
  haveI : Nonempty ↥𝒳 := ⟨cl UpperHalfPlane.I⟩
  haveI := hsm
  haveI : Smooth f := SmoothOfRelativeDimension.smooth (n := 1) (f := f)
  exact AlgebraicGeometry.isIntegral_of_smooth_of_preconnectedSpace f

