variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalRing K] [MeasurableSpace K] [BorelSpace K]

private theorem measurable_mul_left (u : Kˣ) : Measurable fun x : K => (u : K) * x :=
  (continuous_const.mul continuous_id).measurable

private def mulLeftEquiv (u : Kˣ) : K ≃ᵐ K where
  toEquiv := Units.mulLeft u
  measurable_toFun := measurable_mul_left u
  measurable_invFun := measurable_mul_left u⁻¹

private theorem coe_mulLeftEquiv (u : Kˣ) : ⇑(mulLeftEquiv u) = fun x : K => (u : K) * x :=
  rfl

private theorem measurable_units_mul_left (g : Kˣ) : Measurable fun x : Kˣ => g * x := by
  rw [measurable_iff_comap_le]
  change (MeasurableSpace.comap Units.val ‹MeasurableSpace K›).comap (fun x : Kˣ => g * x) ≤
    MeasurableSpace.comap Units.val ‹MeasurableSpace K›
  rw [MeasurableSpace.comap_comp]
  have h : (Units.val ∘ fun x : Kˣ => g * x) = (fun x : K => (g : K) * x) ∘ Units.val := by
    funext x
    simp [Function.comp]
  rw [h, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono ((measurable_mul_left g).comap_le)

private def unitsMulLeftEquiv (g : Kˣ) : Kˣ ≃ᵐ Kˣ where
  toEquiv := Equiv.mulLeft g
  measurable_toFun := measurable_units_mul_left g
  measurable_invFun := measurable_units_mul_left g⁻¹

end
