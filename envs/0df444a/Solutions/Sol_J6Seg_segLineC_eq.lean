-- Source module: Solutions.J6SegLn6
/-!
# Segmented inverse (S2), machine side 6: the coupling as a cyclic window

On a sorted line `L = [j₀ < … < j_{m-1}]` of positions `< s` (the near-boundary positions), with
`z` vanishing off `L`, the coupling `W = U z` at `j_r` only reads `z` at the line indices
`q` within cyclic index distance `K ≥ w` of `r` (positions within cyclic distance `w`, and the
line is strictly increasing). With the cyclically extended list
`zext = (last K of zl) ++ zl ++ (first K of zl)`, `zl = [z_{j_0}, …, z_{j_{m-1}}]`:

* **`couple_window`**: `W_{j_r} = ∑_{i ≤ 2K} fmul (cc_r)_i zext_{r+i}` (`2K+1 ≤ m`, `2w < s`);
* **`couple_off`**: `W_i = 0` at positions that are not near a block boundary.
-/

open Finset

namespace J6Seg

section cpl
variable (P : ℕ) (T : Tables) (B : Blocks) (L : List ℕ) (K : ℕ)

variable {P T B L K}

lemma getD_drop' (l : List ℤ) (a i : ℕ) : (l.drop a).getD i 0 = l.getD (a + i) 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]

lemma getD_take' (l : List ℤ) (a i : ℕ) (h : i < a) : (l.take a).getD i 0 = l.getD i 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_take, if_pos h]

/-- **No coupling away from block boundaries.** -/
theorem couple_off (zf : ℕ → ℤ) {i : ℕ} (hi : nearB B i = false) : coupleI P T B zf i = 0 := by
  unfold coupleI
  refine Finset.sum_eq_zero (fun h hh => ?_)
  exfalso
  obtain ⟨a1, a2, a3, a4⟩ := mem_Hset hh
  unfold nearB at hi
  simp only [decide_eq_false_iff_not, not_or, not_lt] at hi
  apply a4
  constructor <;> omega

end cpl

end J6Seg

end

section
-- Source module: Solutions.J6SegLn7
/-!
# Segmented inverse (S2), machine side 7: the capacitance solve of one line as list kernels

For the pattern `S = bandS (λ+w) c` (`c = s - λ - w`, border `bd = (c ≤ ·)`) on the sorted
line `L = Jlist B`:

* `WbOf r` (backward band window): the number of later line positions within `λ + w` of `L_r`;
* `cfOf r` (forward window): all previous rows on border rows, else the number of previous line
  positions within `λ + w`;
* **`jsolve_eq`**: `bwdK (records) (fwdK (forward streams) [Y_{L_r}]_r [])` is the list of the
  solution `geSolveS … Y` at `L_0, …, L_{m-1}`, for every right-hand side `Y`.

All windows and streams depend only on `s, t, λ, w` and the tables (not on the data).
-/

open Finset

namespace J6Seg

section jsolve
variable (P : ℕ) (L : List ℕ) (mw c : ℕ) (A : ℕ → ℕ → ℤ)

variable {P L mw c A}

lemma getD_lt_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i < j) (hj : j < L.length) :
    L.getD i 0 < L.getD j 0 := by
  rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ hj]
  exact (List.pairwise_iff_getElem.1 hsort) i j (by omega) hj hij

lemma getD_le_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i ≤ j) (hj : j < L.length) :
    L.getD i 0 ≤ L.getD j 0 := by
  rcases Nat.lt_or_ge i j with h | h
  · exact (getD_lt_getD hsort h hj).le
  · rw [show i = j by omega]

theorem fwdSupp_of (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    FwdSupp (S := bandS mw c) (L := L) r (cfOf L mw c r) := by
  unfold cfOf
  split_ifs with hb
  · exact ⟨le_rfl, fun q hq => absurd hq (by omega)⟩
  · refine ⟨(card_filter_le _ _).trans (by simp), fun q hq hS => ?_⟩
    have hqr : L.getD q 0 < L.getD r 0 := getD_lt_getD hsort (by omega) hr
    have hband : L.getD r 0 ≤ L.getD q 0 + mw := by
      unfold bandS at hS; omega
    -- every row in `[q, r)` is in the window
    have hsub : Ico q r ⊆ (range r).filter (fun q' => L.getD r 0 ≤ L.getD q' 0 + mw) := by
      intro q' hq'
      rw [mem_Ico] at hq'
      rw [mem_filter, mem_range]
      refine ⟨hq'.2, ?_⟩
      have := getD_le_getD hsort hq'.1 (by omega)
      omega
    have := card_le_card hsub
    rw [Nat.card_Ico] at this
    omega

theorem bwin_of (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    ∀ q, r < q → q < L.length → ¬ (c ≤ L.getD q 0) → bandS mw c (L.getD r 0) (L.getD q 0) →
      q ≤ r + WbOf L mw r := by
  intro q hrq hq hb hS
  have hqr : L.getD r 0 < L.getD q 0 := getD_lt_getD hsort hrq hq
  have hband : L.getD q 0 ≤ L.getD r 0 + mw := by
    unfold bandS at hS; omega
  have hsub : Ioc r q ⊆ (Ioo r L.length).filter (fun q' => L.getD q' 0 ≤ L.getD r 0 + mw) := by
    intro q' hq'
    rw [mem_Ioc] at hq'
    rw [mem_filter, mem_Ioo]
    refine ⟨⟨hq'.1, by omega⟩, ?_⟩
    have := getD_le_getD hsort hq'.2 hq
    omega
  have := card_le_card hsub
  rw [Nat.card_Ioc] at this
  unfold WbOf
  omega

/-- **The capacitance solve of one line by the two list kernels.** -/
theorem jsolve_eq (hsort : L.Pairwise (· < ·)) (Y : ℕ → ℤ) :
    bwdK P (bsOf P L mw c A)
      (fwdK P (fsOf P L mw c A) ((List.range L.length).map fun r => Y (L.getD r 0)) []) [] [] =
      (List.range L.length).map fun r => geSolveS P (bandS mw c) L A Y (L.getD r 0) := by
  have hnd : L.Nodup := hsort.imp (fun h => ne_of_lt h)
  unfold fsOf
  rw [fwdK_eq (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y) (cfOf L mw c)
    (fun r hr => fwdSupp_of hsort hr)]
  rw [show ((List.range L.length).map (btV P (bandS mw c) L A Y)).reverse =
    (List.range L.length).reverse.map (btV P (bandS mw c) L A Y) by simp]
  unfold bsOf
  have := bwdK_eq (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y) hnd
    (fun r => cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw r) r)
    (fun r => czOf P (bandS mw c) L A (c ≤ ·) r)
    (fun r => Aseq P (bandS mw c) L A r (L.getD r 0) (L.getD r 0)) (flOf L (c ≤ ·))
    (fun r _ => rfl)
    (fun r hr => hsplit_of Y (WbOf L mw r) hsort r hr (bwin_of hsort hr))
  exact this

end jsolve

end J6Seg

end

section
-- Source module: Solutions.J6SegLn8
/-!
# Segmented inverse (S2), machine side 8: one real line of `segInvS` by list kernels

The real part of the segmented inverse on one line, as the machine computes it, on a padded
line `x` of `N = n_c λ` positions (`s ≤ N`):

1. `Y = applyL x`: the chunk kernel on each `λ`-chunk (`M⁻¹`);
2. the values of `Y` on the line `L = Jlist B`, the two capacitance kernels (`jsolve_eq`);
3. the coupling window kernel on the cyclic extension (`couple_window`), scattered back to the
   positions (zero off `L`);
4. `Y₂ = applyL` of the scattered coupling; the output is `Y - Y₂`.

**`segLineC_eq`**: entry `u < N` of the result is `segInvS … u` for `u < s` and `0` beyond.
-/

open Finset

namespace J6Seg

section agree
variable (P : ℕ)

lemma blkI_agree (T : Tables) (a n : ℕ) {z z' : ℕ → ℤ} (h : ∀ u < n, z u = z' u) :
    ∀ u < n, blkI P T a n z u = blkI P T a n z' u := by
  have hdg : ∀ (c : ℕ → ℤ) {x x' : ℕ → ℤ}, (∀ u < n, x u = x' u) →
      ∀ u < n, dgI P c x u = dgI P c x' u := fun c x x' hx u hu => by
    simp only [dgI, hx u hu]
  have hlw : ∀ (c : ℕ → ℤ) {x x' : ℕ → ℤ}, (∀ u < n, x u = x' u) →
      ∀ u < n, lwI P c x u = lwI P c x' u := fun c x x' hx u hu => by
    simp only [lwI]
    congr 1
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [Finset.mem_range] at hk
    rw [hx k (by omega)]
  have hup : ∀ (c : ℕ → ℤ) {x x' : ℕ → ℤ}, (∀ u < n, x u = x' u) →
      ∀ u < n, upI P n c x u = upI P n c x' u := fun c x x' hx u hu => by
    simp only [upI]
    congr 1
    refine Finset.sum_congr rfl (fun k hk => ?_)
    rw [Finset.mem_Ico] at hk
    rw [hx k hk.2]
  exact hdg _ (hdg _ (hup _ (hdg _ (hlw _ (hdg _ (hdg _ h))))))

theorem applyMinv_congr {s t : ℕ} {T : Tables} {B : Blocks} (hB : BlocksOK s t B)
    {X X' : ℕ → ℤ} (h : ∀ v < s, X v = X' v) : ∀ i < s, applyMinv P T B X i = applyMinv P T B X' i := by
  intro i hi
  obtain ⟨c1, c2, c3⟩ := hB.cover i hi
  unfold applyMinv
  exact blkI_agree P T _ _ (fun u hu => h _ (by omega)) _ (by omega)

end agree

section lens
variable (P : ℕ)

lemma length_blkL {di gi gam dd am ap y : List ℤ} (h1 : y.length ≤ di.length)
    (h2 : y.length ≤ gi.length) (h3 : y.length ≤ gam.length) (h4 : y.length ≤ dd.length) :
    (blkL P di gi gam dd am ap y).length = y.length := by
  simp only [blkL, dgL, upL, lwL, List.length_zipWith, List.length_reverse, List.length_map,
    length_convL]
  omega

lemma length_chunkL {di gi gam dd : List ℤ} {lam : ℕ} (h1 : di.length = lam) (h2 : gi.length = lam)
    (h3 : gam.length = lam) (h4 : dd.length = lam) :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (x : List ℤ), (∀ d ∈ ds, d.1 ≤ lam) →
      (chunkL P di gi gam dd ds x).length = x.length
  | [], x, _ => by simp [chunkL]
  | (n, am, ap) :: ds, x, hds => by
    simp only [chunkL, List.length_append]
    have hn := hds (n, am, ap) (List.mem_cons_self ..)
    rw [length_blkL P (by simp; omega) (by simp; omega) (by simp; omega) (by simp; omega),
      length_chunkL h1 h2 h3 h4 ds _ (fun d hd => hds d (List.mem_cons_of_mem _ hd))]
    simp only [List.length_take, List.length_drop]
    omega

lemma blFrom_snd (s t lam e : ℕ) : ∀ (f st : ℕ), ∀ b ∈ blFrom s t lam e f st,
    b.2 = 1 + enF s t lam b.1
  | 0, _, b, hb => by simp [blFrom] at hb
  | f + 1, st, b, hb => by
    simp only [blFrom] at hb
    split_ifs at hb with h
    · rcases List.mem_cons.1 hb with he | he
      · rw [he]
      · exact blFrom_snd s t lam e f _ b he
    · simp at hb

lemma length_chunkK {R s t lam α : ℕ} (hl : 1 ≤ lam) (c : ℕ) (x : List ℤ) :
    (chunkK P R s t lam α c x).length = x.length := by
  unfold chunkK
  refine length_chunkL P (lam := lam) (by simp [diL]) (by simp [giL]) (by simp [gamL]) (by simp [ddL]) _ _ ?_
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  rw [blFrom_snd s t lam _ _ _ b hb]
  have := en_le_lam (s := s) (t := t) hl b.1
  omega

end lens

section chunks

lemma chunksL_succ (f : ℕ → List ℤ → List ℤ) (lam nc : ℕ) (x : List ℤ) :
    chunksL f lam (nc + 1) x = chunksL f lam nc x ++ f nc ((x.drop (nc * lam)).take lam) := by
  simp [chunksL, List.range_succ, List.flatMap_append]

lemma length_chunksL {f : ℕ → List ℤ → List ℤ} {lam : ℕ}
    (hf : ∀ c y, y.length = lam → (f c y).length = lam) {x : List ℤ} :
    ∀ nc, nc * lam ≤ x.length → (chunksL f lam nc x).length = nc * lam
  | 0, _ => by simp [chunksL]
  | nc + 1, h => by
    rw [chunksL_succ, List.length_append, length_chunksL hf nc (by rw [Nat.succ_mul] at h; omega),
      hf _ _ (by simp only [List.length_take, List.length_drop]; rw [Nat.succ_mul] at h; omega),
      Nat.succ_mul]

lemma getD_chunksL {f : ℕ → List ℤ → List ℤ} {lam : ℕ}
    (hf : ∀ c y, y.length = lam → (f c y).length = lam) {x : List ℤ} :
    ∀ nc, nc * lam ≤ x.length → ∀ u < nc * lam, (chunksL f lam nc x).getD u 0 =
      (f (u / lam) ((x.drop (u / lam * lam)).take lam)).getD (u % lam) 0
  | 0, _, u, hu => by simp at hu
  | nc + 1, h, u, hu => by
    have h' : nc * lam ≤ x.length := by rw [Nat.succ_mul] at h; omega
    rw [chunksL_succ]
    rcases Nat.lt_or_ge u (nc * lam) with h1 | h1
    · rw [List.getD_append _ _ _ _ (by rw [length_chunksL hf nc h']; exact h1)]
      exact getD_chunksL hf nc h' u h1
    · rw [List.getD_append_right _ _ _ _ (by rw [length_chunksL hf nc h']; exact h1),
        length_chunksL hf nc h']
      have hl : 0 < lam := by
        rcases Nat.eq_zero_or_pos lam with h0 | h0
        · subst h0; simp at hu
        · exact h0
      have hdiv : u / lam = nc := Nat.div_eq_of_lt_le h1 (by rw [Nat.succ_mul] at hu ⊢; omega)
      have hmod : u % lam = u - nc * lam := by
        have := Nat.div_add_mod' u lam
        rw [hdiv] at this; omega
      rw [hdiv, hmod]

end chunks

section line
variable (P R s t lam w α : ℕ)

variable {P R s t lam w α}

theorem getD_applyL (hl : 1 ≤ lam) {nc : ℕ} {x : List ℤ} (hx : nc * lam ≤ x.length) {u : ℕ}
    (hu : u < nc * lam) :
    (applyL P R s t lam α nc x).getD u 0 =
      if u < s then applyMinv P (TT P R s t α) (BB s t lam w) (fun v => x.getD v 0) u else 0 := by
  unfold applyL
  rw [getD_chunksL (fun c y hy => by rw [length_chunkK P hl, hy]) nc hx u hu]
  have hc : u / lam * lam + lam ≤ nc * lam := by
    have := Nat.div_mul_le_self u lam
    have h2 : u / lam < nc := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hu)
    nlinarith
  have := chunkK_rep (P := P) (R := R) (s := s) (t := t) (lam := lam) (w := w) (α := α) hl (u / lam)
    ((x.drop (u / lam * lam)).take lam) (by simp only [List.length_take, List.length_drop]; omega)
    (fun v => x.getD v 0) (fun v hv => by
      rw [getD_take' _ _ _ hv, getD_drop']) (u % lam) (Nat.mod_lt _ (by omega))
  rw [this, Nat.div_add_mod' u lam]

end line

section segline
variable (P R s t lam w α K : ℕ)

variable {P R s t lam w α K}

lemma LJ_sorted : (LJ s t lam w).Pairwise (· < ·) := Jlist_pairwise _

lemma LJ_lt {x : ℕ} (hx : x ∈ LJ s t lam w) : x < s := by
  unfold LJ Jlist at hx
  rw [List.mem_filter, List.mem_range] at hx
  exact hx.1

lemma LJ_getD_lt {r : ℕ} (hr : r < (LJ s t lam w).length) : (LJ s t lam w).getD r 0 < s := by
  rw [List.getD_eq_getElem _ _ hr]; exact LJ_lt (List.getElem_mem _)

/-- **`segLineC` computes the sparse segmented inverse** (real part, one line). -/
theorem segLineC_eq_sol_aux (hl : 1 ≤ lam) (hs : 0 < s) (hws : 2 * w < s) (hwK : w ≤ K)
    (hKm : 2 * K + 1 ≤ (LJ s t lam w).length) {nc : ℕ} (hsN : s ≤ nc * lam) {x : List ℤ}
    (hx : nc * lam ≤ x.length) {u : ℕ} (hu : u < nc * lam) :
    (segLineC P R s t lam w α K nc x).getD u 0 =
      if u < s then segInvS P lam (TT P R s t α) (BB s t lam w) (fun v => x.getD v 0) u else 0 := by
  have hB : BlocksOK s t (BB s t lam w) := mkBlocks_ok hs w (by omega)
  -- 1. `Y`
  have hYl : ∀ v < nc * lam, (applyL P R s t lam α nc x).getD v 0 =
      if v < s then YsolL P R s t lam w α x v else 0 :=
    fun v hv => getD_applyL (w := w) hl hx hv
  -- 2. the capacitance solve
  have hbJ : ((List.range (LJ s t lam w).length).map fun r =>
      (applyL P R s t lam α nc x).getD ((LJ s t lam w).getD r 0) 0) =
      (List.range (LJ s t lam w).length).map fun r =>
        YsolL P R s t lam w α x ((LJ s t lam w).getD r 0) := by
    refine List.map_congr_left (fun r hr => ?_)
    rw [List.mem_range] at hr
    rw [hYl _ (by have := LJ_getD_lt hr; omega), if_pos (LJ_getD_lt hr)]
  have hzl : bwdK P (bsOf P (LJ s t lam w) (lam + w) (s - lam - w)
      (capI P (TT P R s t α) (BB s t lam w)))
      (fwdK P (fsOf P (LJ s t lam w) (lam + w) (s - lam - w) (capI P (TT P R s t α) (BB s t lam w)))
        ((List.range (LJ s t lam w).length).map fun r =>
          (applyL P R s t lam α nc x).getD ((LJ s t lam w).getD r 0) 0) []) [] [] =
      zlOf (LJ s t lam w) (zsolL P R s t lam w α x) := by
    rw [hbJ, jsolve_eq LJ_sorted]
    rfl
  -- 3. the coupling on the line
  have hWl : ∀ r < (LJ s t lam w).length, dotF P (ccL P R s t lam w α K r)
      ((zext K (zlOf (LJ s t lam w) (zsolL P R s t lam w α x))).drop r) =
      coupleI P (TT P R s t α) (BB s t lam w) (zsolL P R s t lam w α x) ((LJ s t lam w).getD r 0) := by
    intro r hr
    rw [couple_window (P := P) (T := TT P R s t α) (B := BB s t lam w) (L := LJ s t lam w) (K := K)
      LJ_sorted (fun y hy => LJ_lt hy) hwK hKm hws (zsolL P R s t lam w α x)
      (fun k hk => by unfold zsolL; exact geSolveS_off P _ _ _ _ k hk) hr]
    unfold dotF ccL
    simp only [List.length_map, List.length_range]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [Finset.mem_range] at hi
    rw [getD_range_map_any hi, getD_drop']
  -- 4. the scattered coupling agrees with `coupleI` below `s`
  have hWp : ∀ v < s, ((List.range (nc * lam)).map fun u => if u ∈ LJ s t lam w then
      ((List.range (LJ s t lam w).length).map fun r => dotF P (ccL P R s t lam w α K r)
        ((zext K (zlOf (LJ s t lam w) (zsolL P R s t lam w α x))).drop r)).getD
        ((LJ s t lam w).idxOf u) 0 else 0).getD v 0 =
      coupleI P (TT P R s t α) (BB s t lam w) (zsolL P R s t lam w α x) v := by
    intro v hv
    rw [getD_range_map_any (by omega)]
    split_ifs with hvL
    · have hi := List.idxOf_lt_length_of_mem hvL
      rw [getD_range_map_any hi, hWl _ hi, List.getD_eq_getElem _ _ hi, List.getElem_idxOf hi]
    · symm
      apply couple_off
      by_contra hn
      apply hvL
      simp only [Bool.not_eq_false] at hn
      unfold LJ Jlist
      rw [List.mem_filter, List.mem_range]
      exact ⟨hv, hn⟩
  -- assemble
  simp only [segLineC, hzl]
  rw [getD_range_map_any hu, hYl u hu, getD_applyL (w := w) hl (by simp) hu]
  split_ifs with hus
  · rw [applyMinv_congr P hB hWp u hus]
    rfl
  · simp

end segline

end J6Seg

end

theorem solution : type_of% @J6Seg.segLineC_eq_sol_aux := @J6Seg.segLineC_eq_sol_aux
