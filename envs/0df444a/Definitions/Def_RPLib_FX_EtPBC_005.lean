-- ===== S4.Def_RP_EtPBC_A_O2E7 =====
section

/-!
# S4-EtPBC-A, O2 C-plan S4d2: purity on `W₁ = Spec B_t` with the chart Kummer class

* `LA k a = k[X]_{X-a}` (Dedekind, fraction field `RatFunc k`); `zetaA`, `gamA` (`gamA ^ N = X - a`);
* `xiA a hN Λ hΛ c : H¹(Spec k[X]_{X-a}, Λ)`: the Kummer class of `(X - a)^{1/N}` with coefficient `c`;
* `Wa c a = Spec k[X]_{X-a}` over `P` (the punctured chart neighbourhood), `phiA`, `toWa c a φ : W1 c φ a ⟶ Wa c a`;
* **`purity_W1`**: every `κ ∈ H¹(Spec B_t, Λ)` is `res_{toD1} κ₀ + res_{toWa} (xiA c')`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.GalTrE RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.Kummer
  RamanujanPetersson.EtPi1 RamanujanPetersson.EtCompact.Pur RamanujanPetersson.EtPBC.EtDed

section LA

variable (k : Type) [Field k] (a : k)

/-- `k[X]_{X - a}`. -/
abbrev LA : Type := Localization.Away (X - C a : k[X])

theorem LA.powers_le : Submonoid.powers (X - C a : k[X]) ≤ nonZeroDivisors k[X] :=
  powers_le_nonZeroDivisors_of_noZeroDivisors (X_sub_C_ne_zero a)

instance LA.isDomain : IsDomain (LA k a) :=
  IsLocalization.isDomain_localization (LA.powers_le k a)

instance LA.isDedekindDomain : IsDedekindDomain (LA k a) :=
  IsLocalization.isDedekindDomain k[X] (LA.powers_le k a) (LA k a)

theorem LA.isUnit : IsUnit (algebraMap k[X] (RatFunc k) (X - C a)) :=
  isUnit_iff_ne_zero.2 ((map_ne_zero_iff _ (IsFractionRing.injective k[X] (RatFunc k))).2 (X_sub_C_ne_zero a))

instance LA.algebraRatFunc : Algebra (LA k a) (RatFunc k) :=
  (Localization.awayLift (algebraMap k[X] (RatFunc k)) (X - C a) (LA.isUnit k a)).toAlgebra

theorem LA.algebraMap_algebraMap (p : k[X]) :
    algebraMap (LA k a) (RatFunc k) (algebraMap k[X] (LA k a) p) = algebraMap k[X] (RatFunc k) p :=
  IsLocalization.Away.lift_eq (hg := LA.isUnit k a) (a := p)

instance LA.isScalarTower : IsScalarTower k[X] (LA k a) (RatFunc k) :=
  IsScalarTower.of_algebraMap_eq (fun p => (LA.algebraMap_algebraMap k a p).symm)

instance LA.isFractionRing : IsFractionRing (LA k a) (RatFunc k) :=
  IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers (X - C a : k[X])) (LA k a)
    (RatFunc k)

variable {k} [IsAlgClosed k] {N : ℕ} [NeZero N] (hN : (N : k) ≠ 0)

/-- A primitive `N`-th root of unity of `k`, in `k(X)`. -/
def zetaA : RatFunc k := algebraMap k (RatFunc k) (Classical.choose (exists_primitiveRoot_of_ne hN))

theorem zetaA_prim : IsPrimitiveRoot (zetaA hN) N :=
  (Classical.choose_spec (exists_primitiveRoot_of_ne hN)).map_of_injective (algebraMap k (RatFunc k)).injective

include hN in
theorem isUnit_natCast_poly : IsUnit (N : k[X]) := by
  have h := (isUnit_iff_ne_zero.2 hN).map (C : k →+* k[X])
  rwa [map_natCast] at h

end LA

section Obj

variable {k : Type} [Field k] {P : Scheme.{0}} (c : A1 k ⟶ P) [IsOpenImmersion c]

variable (a : k)

instance etale_Wa : Etale (Spec.map (CommRingCat.ofHom (algebraMap k[X] (LA k a))) ≫ c) := by
  haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap k[X] (LA k a)))) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).2
      (RingHom.etale_algebraMap.2 (Algebra.Etale.of_isLocalizationAway (X - C a)))
  infer_instance

/-- The punctured chart neighbourhood `Spec k[X]_{X - a}` over `P`. -/
abbrev Wa : P.Etale := chEt c (CommRingCat.ofHom (algebraMap k[X] (LA k a)))

variable {B : CommRingCat.{0}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)]

/-- `k[X]_{X-a} ⟶ B_t`. -/
def phiA : CommRingCat.of (LA k a) ⟶ CommRingCat.of (Localization.Away (φ.hom (X - C a))) :=
  CommRingCat.ofHom (Localization.awayMap φ.hom (X - C a))

theorem phiA_apply (x : k[X]) :
    (phiA a φ).hom (algebraMap k[X] (LA k a) x) = algebraMap B (Localization.Away (φ.hom (X - C a))) (φ.hom x) :=
  IsLocalization.map_eq (M := Submonoid.powers (X - C a)) (S := LA k a) (g := φ.hom)
    (T := Submonoid.powers (φ.hom (X - C a))) (Q := Localization.Away (φ.hom (X - C a)))
    (by rintro y ⟨n, rfl⟩; exact ⟨n, (map_pow φ.hom _ n).symm⟩) x

theorem phiA_ring : CommRingCat.ofHom (algebraMap k[X] (LA k a)) ≫ phiA a φ = φ ≫ locT φ a := by
  apply CommRingCat.hom_ext
  exact RingHom.ext fun x => phiA_apply a φ x

theorem spec_phiA_comp :
    Spec.map (φ ≫ locT φ a) ≫ c = Spec.map (phiA a φ) ≫ Spec.map (CommRingCat.ofHom (algebraMap k[X] (LA k a))) ≫ c := by
  rw [← phiA_ring a φ, Spec.map_comp, Category.assoc]

end Obj

