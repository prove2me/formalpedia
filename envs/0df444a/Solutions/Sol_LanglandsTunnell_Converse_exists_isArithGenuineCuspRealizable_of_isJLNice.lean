attribute [local instance] torusBorel borelSpace_torusBorel compactSpace_torusClass

set_option synthInstance.maxHeartbeats 1600000 in
private scoped instance torusClass_locallyCompactSpace (S : Finset (HeightOneSpectrum (𝓞 K))) :
    LocallyCompactSpace ↥(torusClass (K := K) S) :=
  inferInstance

private def torusClassHaar (S : Finset (HeightOneSpectrum (𝓞 K))) : Measure ↥(torusClass (K := K) S) :=
