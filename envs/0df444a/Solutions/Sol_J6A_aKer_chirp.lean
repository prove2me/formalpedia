-- Source module: Solutions.J6AIL1
/-!
# A lines, IL side 1: the per-block kernel as a list function

`aKerL w2 bk win Q aTab rTab cTab x` (row `x` of length `win`, the gathered window):

All three stages use the one rounding exponent `Q` (the IL kernel has one `rP` register); the
tables `aTab`, `rTab` are stored scaled by `2^Q`, so the first two stages are exact:

1. scale: `y = dgG Q aTab (x.take w2)` (`aTab_i = 2^Q a_i`: exact products `a_i x_i`);
2. correlate: `z = lwG Q (2n) rTab (padG n y)` with `n = w2 + bk` (`rTab_e = 2^Q r_e`: exact lower
   Toeplitz sums, one record product);
3. extract `z[w2 .. w2 + bk)` and rescale: `dgG Q cTab` (one rounding `rs Q` per entry);
4. pad with zeros to `win`.

* `aKerL_getD`: the entries of `aKerL` as fixed-point products of the explicit window sums.
* The tables of block `b` of an `A` line: `aTabA`, `rTabA`, `cTabA`.
* **`aKer_chirp`**: on the gathered window of block `b`, `aKerL` with these tables gives the
  `chirpC` outputs `k = b·bk + κ`, `κ < bk`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace J6A

open IntMul.HvdH J6Seg Finset

/-! ## The tables of an `A` line and the kernel on a gathered window -/

lemma kcB_block (H b κ : ℕ) (hH : 1 ≤ H) (hκ : κ < 2 * H) : kcB H (kkA H b + κ) = kcB H (kkA H b) := by
  unfold kcB kkA
  have h2 : 0 < 2 * H := by omega
  rw [Nat.add_comm (b * (2 * H)) κ, Nat.add_mul_div_right κ b h2, Nat.div_eq_of_lt hκ,
    Nat.mul_div_cancel b h2]
  ring

lemma kapB_block (H b κ : ℕ) (hH : 1 ≤ H) (hκ : κ < 2 * H) :
    kapB H (kkA H b + κ) = (κ : ℤ) - H := by
  unfold kapB
  rw [kcB_block H b κ hH hκ]
  unfold kcB kkA
  rw [Nat.mul_div_cancel _ (by omega)]
  push_cast; ring

lemma jcB_block (s t H b κ : ℕ) (hH : 1 ≤ H) (hκ : κ < 2 * H) :
    jcB s t H (kkA H b + κ) = jcB s t H (kkA H b) := by
  unfold jcB; rw [kcB_block H b κ hH hκ]

lemma aT_block (P s t α H b κ : ℕ) (hH : 1 ≤ H) (hκ : κ < 2 * H) (j : ℤ) :
    aT P s t α H (kkA H b + κ) j = aT P s t α H (kkA H b) j := by
  unfold aT aNum; rw [kcB_block H b κ hH hκ]

lemma gT_block (p s t α H b κ i : ℕ) (hH : 1 ≤ H) (hκ : κ < 2 * H) (hi : i < 2 * WA p α H) :
    gT (2 * p) s t α H (kkA H b + κ) (jcB s t H (kkA H b) - WA p α H + i) =
      rFA p s t α H b (2 * WA p α H + κ - i) := by
  unfold rFA gT gNum
  rw [kcB_block H b κ hH hκ, kapB_block H b κ hH hκ]
  congr 4
  push_cast [show i ≤ 2 * WA p α H + κ by omega]
  ring

/-- **The kernel on the gathered window computes `chirpC`.** -/
theorem aKer_chirp_sol_aux (p s t α H b win : ℕ) (hH : 1 ≤ H) (U : ℕ → ℤ × ℤ) (x : List (ℤ × ℤ))
    (hxl : 2 * WA p α H ≤ x.length)
    (hx : ∀ i < 2 * WA p α H, x.getD i (0, 0) =
      U ((jcB s t H (kkA H b) - WA p α H + i) % (s : ℤ)).toNat)
    {κ : ℕ} (hκ : κ < 2 * H) :
    (aKerL (2 * WA p α H) (2 * H) win (QA p) (aTabA p s t α H b)
        (rTabA p s t α H b) (cTabA p s t α H b) x).getD κ (0, 0) =
      chirpC p s t α H U (kkA H b + κ) := by
  rw [aKerL_getD _ _ _ _ _ _ _ _ hxl (by simp [aTabA]) (by simp [rTabA]) (by simp [cTabA])
    (aFA p s t α H b) (rFA p s t α H b)
    (fun i hi => by
      unfold aTabA
      rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range])
    (fun e he => by
      unfold rTabA
      rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range]) hκ]
  unfold chirpC chirpA
  simp only []
  have hc : (cTabA p s t α H b).getD κ 0 = cT (2 * p) (p / 2) s t α H (kkA H b + κ) := by
    unfold cTabA
    rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range]
  rw [hc, jcB_block s t H b κ hH hκ]
  have ha : ∀ i < 2 * WA p α H, aFA p s t α H b i =
      aT (2 * p) s t α H (kkA H b + κ) (jcB s t H (kkA H b) - WA p α H + i) := by
    intro i hi
    unfold aFA
    rw [aT_block _ s t α H b κ hH hκ]
  have k1 : kSum (2 * WA p α H) (aFA p s t α H b) (rFA p s t α H b)
      (fun i => (x.getD i (0, 0)).1) κ = ∑ i ∈ range (2 * WA p α H),
        (cTerm (2 * p) s t α H (kkA H b + κ) U (jcB s t H (kkA H b) - ↑(WA p α H) + ↑i)).1 := by
    unfold kSum
    apply sum_congr rfl
    intro i hi
    rw [mem_range] at hi
    simp only [cTerm]
    rw [hx i hi, ha i hi, ← gT_block p s t α H b κ i hH hκ hi]
    ring
  have k2 : kSum (2 * WA p α H) (aFA p s t α H b) (rFA p s t α H b)
      (fun i => (x.getD i (0, 0)).2) κ = ∑ i ∈ range (2 * WA p α H),
        (cTerm (2 * p) s t α H (kkA H b + κ) U (jcB s t H (kkA H b) - ↑(WA p α H) + ↑i)).2 := by
    unfold kSum
    apply sum_congr rfl
    intro i hi
    rw [mem_range] at hi
    simp only [cTerm]
    rw [hx i hi, ha i hi, ← gT_block p s t α H b κ i hH hκ hi]
    ring
  rw [k1, k2]
  rfl

end J6A

end

theorem solution : type_of% @J6A.aKer_chirp_sol_aux := @J6A.aKer_chirp_sol_aux
