open IntMul IntMul.Kappa IntMul.Kappa.R6 IntMul.Kappa.R6.Bit IntMul.Kappa.R6.Bit.NB
open Matrix Finset
open scoped Kronecker
variable {h : ℕ}

theorem IntMul.Kappa.R6.Bit.NB.aux_edge_of (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ) (hM : M * M = M)
    (htr : M.trace = ((h + 4) * (h + 3) : ℕ))
    (hlow : ∀ β γ : ℕ, β < γ → γ < h + 4 → cor M β (h + 3 + γ) = 0)
    (hdiag : ∀ β : ℕ, β < h + 4 → cor M β (h + 3 + β) ≠ 0) :
    ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e (qM M) ∧
      e.runs = [(0, (h + 4) * (h + 4) - (h + 4), h + 4),
        (h + 4, h + 4, (h + 4) * (h + 4) - 2 * (h + 4))] := by sorry
